ms2101	 إلا إليه ، سبع مرات ، إلا رفع عنه سبعون نوعا من البلاء ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19463 ) قال النبي :(@)(@@) | 30 ( ما من عبد تصيبه زمانة تمنعه مما يصل إليه الأصحاء بعد أن يكون مسددا إلا كانت كفارة لذنوبه ، وكان عمله يعد تفضلا ) )(@)(@@) الحسن بن سفيان عن عبد الله بن سبرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19464 ) قال النبي :(@)(@@) | 30 ( ما من عبد أنعم الله عليه بنعمة فأسبغها ، ثم جعل إليه شيئا من حوائج الناس فتبرأ فقد عرض تلك النعمة للزوال ) )(@)(@@) أبو نعيم عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19465 ) قال النبي :(@)(@@) | 30 ( ما من عبد ختم صحيفته عند مغيب الشمس بالإستغفار إلا محا ما دونها ) )(@)(@@) الديلمي عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19466 ) قال النبي :(@)(@@) | 30 ( ما من عبد تصدق بصدقة يبتغي بها وجه الله إلا قال الله يوم القيامة : عبدي رجوتني ولن أحقرك ، حرمت جسدك على النار ، وادخل من أي أبواب الجنة شئت ) )(@)(@@) ابن لال والديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19467 ) قال النبي :(@)(@@) | 30 ( ما من عبد يتطهر إلا كانت خطاياه أسرع انحدارا عنه من طهوره ) )(@)(@@) الديلمي عن عثمان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19468 ) قال النبي :(@)(@@) | 30 ( ما من عبد يخرج من بيته إلا كان بين حفافين من خلق الله كلهم باسط يده ، فاغر فاه يريد هلكته ، ولولا ما وكل الله به من الحفظة لأهلكوه ، وتقول الحفظة : إليكم حتى يأذن الله عز وجل فيه فيدرءون عنه ما لم يقدر عليه في اللوح المحفوظ ، ولا يدرءون عنه شيئا مما قدر عليه ، ولو تراءى PageV06P386 لابن آدم ما وكل به من الشياطين لتراءى له في السهل والجبل بمنزلة الذئاب على الجيفة ) )(@)(@@) الديلمي عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19469 ) قال النبي :(@)(@@) | 30 ( ما من عبد يدعو للمؤمنين والمؤمنات إلا رد الله عليه من كل مؤمن ومؤمنة مضى أو هو كائن إلى يوم القيامة بمثل دعائه ) )(@)(@@) ( عب ) عن معمر عن إبان عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19470 ) قال النبي :(@)(@@) | 30 ( ما من عبد 
ms2102	 إلا وله بيتان : بيت في الجنة ، وبيت في النار ، فأما المؤمن فيبنى بيته في الجنة ويهدم بيته في النار ، وأما الكافر فيهدم بيته في الجنة ويبنى بيته في النار ) )(@)(@@) الديلمي عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19471 ) قال النبي :(@)(@@) | 30 ( ما من عبد إلا وفي وجهه عينان يبصر بهما أمر الدنيا ، وعينان في قلبه يبصر بهما أمر الآخرة ، فإذا أراد الله بعبد خيرا فتح عينيه اللتين في قلبه فأبصر بهما ما وعده بالغيب ، فأمن بالغيب على المغيب ، وإذا أراد به غير ذالك تركه على ما فيه ، ثم قرأ : { أم على قلوب أقفالها } ) )(@)(@@) الديلمي عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19472 ) قال النبي :(@)(@@) | 30 ( ما من عبد مسلم يتصدق من كسب طيب ولا يقبل الله إلا الطيب إلا كان الله عز وجل يأخذها بيمينه فيربيها له كما يربي أحدكم فلوه ، أو قال فصيله ، حتى تبلغ الثمرة مثل أحد ) )(@)(@@) ( حب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19473 ) قال النبي :(@)(@@) | 30 ( ما من عبد مسلم يتوضأ فيغسل وجهه إلا تساقطت خطايا وجهه من أطراف لحيته ، فإذا غسل يديه تساقطت خطايا يديه من بين أظفاره ، فإذا مسح رأسه تساقطت خطايا رأسه من أطراف شعره ، فإذا غسل رجليه PageV06P387 تساقطت خطايا رجليه من باطنهما ، فإن أتى مسجد جماعة فصلى فيه فقد وقع أجره على الله ، وإن قام فصلى ركعتين كانت كفارة ) )(@)(@@) ( عب ) عن عمرو بن عبسة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19474 ) قال النبي :(@)(@@) | 30 ( ما من عبد قال : الحمد لله عدد ما خلق ، والحمد لله ملء ما خلق ، والحمد لله عدد ما في السماوات والأرض ، والحمد لله عدد ما أحصى كتابه ، والحمد لله عدد كل شيء ، وسبحان الله مثلهن إلا غفر الله له ذنوبه ولو كانت مثل زبد البحر ) )(@)(@@) ( حم ك ض ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19475 ) قال النبي :(@)(@@) | 30 ( ما من عبد يعلم منه الحرص على أداء الأمانة إلا أداها الله تعالى عنه ، فإن مات ولم يؤدها وقد علم الله منه الحرص على أدائها قيض 
ms2103	 الله له من يؤديها عنه بعد موته ) )(@)(@@) ابن النجار عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19476 ) قال النبي :(@)(@@) | 30 ( ما من عبد يصبح صائما إلا فتحت له أبواب السماء ، وسبحت أعضاؤه ، واستغفر له أهل السماء الدنيا إلى أن توارى بالحجاب ، فإن صلى ركعة أو ركعتين أضاءت له السماوات نورا ، وقالت أزواجه من الحور العين : اللهم اقبضه إلينا فقد اشتقنا إلى رؤيته ، وإن هلل أو سبح أو كبر تلقاه ألف ملك يكتبون ثوابها إلى أن توارى بالحجاب ) )(@)(@@) ( عد قط ) في الأفراد ( هب ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 19477 ) قال النبي :(@)(@@) | 30 ( ما من عبد مؤمن يتوب إلى الله عز وجل قبل الموت بشهر إلا قبل الله منه وأدنى من ذالك ، وقبل موته بيوم أو ساعة يعلم الله منه التوبة والإخلاص إلا قبل الله منه ) )(@)(@@) ( طب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19478 ) قال النبي :(@)(@@) | 30 ( ما من عبد يتوضأ فيحسن الوضوء ، فيغسل وجهه حتى يسيل الماء على ذقنه ، ثم يغسل ذراعيه حتى يسيل الماء على مرفقيه ، ثم يغسل قدميه حتى يسيل الماء على قدميه ، ثم يغسل عقبيه حتى يسيل الماء من قبل PageV06P388 عقبيه ، ثم يصلي فيحسن صلاته إلا غفر له ما سلف ) )(@)(@@) ( عب ) عن ثعلبة بن عمارة عن أبيه .(@)(@@)(@@)(@@) $ ( 19479 ) قال النبي :(@)(@@) | 30 ( ما من عبد يسترعي رعية إلا سئل يوم القيامة أقام فيهم أمر الله أم أضاعه ) )(@)(@@) أبو سعيد النقاش في القضاء عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19480 ) قال النبي :(@)(@@) | 30 ( ما من عبد يصلي أربع ركعات بعد الظهر فتمس وجهه النار أبدا إن شاء الله ) )(@)(@@) ( كر ) عن أم حبيبة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 19481 ) قال النبي :(@)(@@) | 30 ( ما من عبد ولا أمة إلا وله ثلاثة أخلاء : فخليل يقول أنا معك فخذ مني ما شئت ، فذاك ماله ، وخليل يقول : أنا معك فإذا أتيت باب الملك تركتك ، فذاك أهله وخدمه ، وخليل يقول : أنا معك حيث دخلت وحيث خرجت فذاك عمله ) )(@)(@@) ( طب ) عن النعمان بن بشير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19482 ) قال النبي 
ms2104	 :(@)(@@) | 30 ( ما من عبد ولا أمة يدع أن يمشي في حاجة أخيه المسلم إلا مشى مثلها في سخط الله ، ولا يدع أن ينفق نفقة في سبيل الله إلا أنفق أضعافا مضاعفة في سخط الله ، ولا يدع الحج لغرض من الدنيا إلا رأى المحلقين قبل أن يقضي تلك الحاجة ) )(@)(@@) ( طب ) عن أبي جحيفة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19483 ) قال النبي :(@)(@@) | 30 ( ما من عبد إلا وله ثلاثة أخلاء : فأما خليل فيقول : ما أنفقت فلك وما أمسكت فليس لك فذالك ماله ، وأما خليل فيقول : أنا معك فإذا أتيت باب الملك تركتك فذاك أهله ، وأما خليل فيقول : أنا معك حيث دخلت وحيث خرجت فيقول : إن كنت لأهون الثلاثة علي ) )(@)(@@) ( طس ك هب ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19484 ) قال النبي :(@)(@@) | 30 ( ما من عبد يسجد لله سجدة أو يركع إليه ركعة إلا حط الله عنه بها خطيئة ورفع له بها درجة ) )(@)(@@) ( هق ) عن أبي ذر رضي الله عنه .(@)(@@) PageV06P389(@)(@@)(@@)(@@) $ ( 19485 ) قال النبي :(@)(@@) | 30 ( ما من عبد يسجد لله سجدة إلا رفعه الله بها درجة وكتب له بها حسنة ) )(@)(@@) ( طس ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19486 ) قال النبي :(@)(@@) | 30 ( ما من عبد مسلم يموت يشهد له ثلاثة أبيات من جيرانه الأدنين بخير إلا قال الله عز وجل : قد قبلت شهادة عبادي على ما علموا وغفرت له ما لم أعلم ) )(@)(@@) ( حم ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19487 ) قال النبي :(@)(@@) | 30 ( ما من عبد ولا أمة يضن بنفقة ينفقها فيما يرضي الله تعالى إلا أنفق مثلها فيما يسخط الله ، وما من عبد يدع معونة أخيه المسلم والسعي معه في حاجته قضيت أو لم تقض إلا ابتلي بمعونة من يأثم فيه ولا يؤجر عليه ) )(@)(@@) الخرائطي في مكارم الأخلاق عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19488 ) قال النبي :(@)(@@) | 30 ( ما من عبد صلى صلاة الصبح ثم جلس يذكر الله عز وجل حتى تطلع الشمس إلا كان له حجابا من النار أو سترا ) )(@)(@@) ابن السني عن الحسن بن علي رضي 
ms2105	 الله عنه .(@)(@@)(@@)(@@) $ ( 19489 ) قال النبي :(@)(@@) | 30 ( ما من عبد مسلم ولا أمة مسلمة قرأ في يوم وليلة مائتي مرة { قل هو الله أحد } إلا غفر الله له خطاياه خمسين سنة ) )(@)(@@) ابن السني عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19490 ) قال النبي :(@)(@@) | 30 ( ما من عبد مسلم يأوي إلى فراشه فيقرأ سورة من كتاب الله عز وجل حين يأخذ مضجعه إلا وكل الله به ملكا لا يدع شيئا يقربه ويؤذيه حتى يهب متى هب ) )(@)(@@) ابن السني عن شداد بن أوس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19491 ) قال النبي :(@)(@@) | 30 ( ما من عبدين متحابين في الله ، فيستقبل أحدهما PageV06P390 صاحبه فيصافحه ويصليان على النبي إلا لم يتفرقا حتى يغفر لهما ذنوبهما ما تقدم منها وما تأخر ) )(@)(@@) ابن السني في عمل يوم وليلة وابن النجار عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19492 ) قال النبي :(@)(@@) | 30 ( ما من عمل أطيع الله تعالى فيه أعجل ثوابا من صلة الرحم ، وما من عمل عصي الله تعالى فيه أعجل بقربه من البغي واليمين الفاجرة تدع الديار بلاقع ) )(@)(@@) ( خط ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19493 ) قال النبي :(@)(@@) | 30 ( ما من عمل أزكى عند الله ولا أعظم أجرا من خير يعمله في عشر الأضحى ، قيل : ولا الجهاد في سبيل الله ؟ قال : ولا الجهاد في سبيل الله إلا رجل خرج بنفسه وماله فلم يرجع من ذالك بشيء ) )(@)(@@) ( هب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19494 ) قال النبي :(@)(@@) | 30 ( ما من عمل إلا وهو يختم عليه ، فإذا حيل بين العبد وبين العمل قالت الحفظة : ربنا عمل عبدك قبل أن يحال بينه وبين العمل وأنت أعلم به ) )(@)(@@) ( ك ) عن عقبة بن عامر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19495 ) قال النبي :(@)(@@) | 30 ( ما من عمل أحب إلى الله من عمل في العشر ، قيل : ولا الجهاد في سبيل الله ؟ قال : ولا الجهاد في سبيل الله إلا من خرج بنفسه وماله وجواده فلم يرجع من ذالك بشيء ) )(@)(@@) ( عق ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19496 ) قال النبي :(@)(@@) | 30 ( ما من عين 
ms2106	 فاضت من قراءة القرآن إلا قرب يوم القيامة ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19497 ) قال النبي :(@)(@@) | 30 ( ما من عين خرج منها مثل الذباب من الدموع من مخافة الله إلا أمنها الله يوم الفزع الأكبر ) )(@)(@@) ابن النجار عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19498 ) قال النبي :(@)(@@) | 30 ( ما من غريب يمرض فيومىء ببصره فلا يقع على PageV06P391 من يعرفه إلا كتب الله له بكل نفس يتنفس به سبعين ألف حسنة ويمحو عنه سبعين ألف سيئة ) )(@)(@@) الديلمي عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19499 ) قال النبي :(@)(@@) | 30 ( ما من قلب إلا وهو بين أصبعين من أصابع الرحمان ، إذا شاء أن يقيمه أقامه ، وإذا شاء أن يزيغه أزاغه ) )(@)(@@) ( كر ) و ابن النجار عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 19500 ) قال النبي :(@)(@@) | 30 ( ما من قوم سعوا إلى السلطان ليذلوه إلا أذلهم الله قبل يوم القيامة ) )(@)(@@) ( ز ) عن حذيفة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19501 ) قال النبي :(@)(@@) | 30 ( ما من قوم جلسوا مجلسا ثم قاموا منه لم يذكروا الله ولم يصلوا على النبي إلا كان ذالك المجلس عليهم ترة ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19502 ) قال النبي :(@)(@@) | 30 ( ما من قوم تغدو عليهم عشرون عنزا سودا شقرا فيخافون العالة ) )(@)(@@) ( خط ) عن ابن عباس رضي الله عنهما ( خط ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 19503 ) قال النبي :(@)(@@) | 30 ( ما من قوم اجتمعوا في مجلس فتفرقوا ولم يذكروا الله إلا كان ذالك المجلس حسرة عليهم يوم القيامة ) )(@)(@@) ( طب هب ) عن عبد الله بن مغفل رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19504 ) قال النبي :(@)(@@) | 30 ( ما من قوم جلسوا مجلسا لا يذكرون الله فيه إلا رأوه حسرة يوم القيامة ) )(@)(@@) ( حم ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19505 ) قال النبي :(@)(@@) | 30 ( ما من قوم يجتمعون على كتاب الله عز وجل يتعاطونه بينهم إلا كانوا أضيافا لله ، وإلا حفتهم الملائكة حتى يقوموا ويخوضوا في PageV06P392 حديث غيره ، وما من عبد يخرج في طلب علم مخافة أن يموت ، أو في انتساخه مخافة أن يدرس إلا كان 
ms2107	 كالغازي الرائح في سبيل الله عز وجل ومن يبطىء به عمله لا يسرع به نسبه ) )(@)(@@) ( طب ) عن أبي الردين رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19506 ) قال النبي :(@)(@@) | 30 ( ما من قوم جلسوا مجلسا لم يذكروا الله عز وجل فيه إلا كان عليهم ترة ، وما سلك رجل طريقا لم يذكر الله عز وجل فيه إلا كان عليه ترة ) )(@)(@@) ابن السني عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19507 ) قال النبي :(@)(@@) | 30 ( ما من قوم اجتمعوا يذكرون الله تعالى إلا ناداهم مناد من السماء : قوموا مغفورا لكم قد بدلت سيئاتكم حسنات ) )(@)(@@) ( هب ) عن عبد الله بن مغفل رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19508 ) قال النبي :(@)(@@) | 30 ( ما من قوم يعمل فيهم بالمعاصي يقدرون أن يغيروا ولا يغيروا إلا أوشك أن يعمهم الله منه بعقاب ) )(@)(@@) ( هق ) عن أبي بكر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19509 ) قال النبي :(@)(@@) | 30 ( ما من قوم اجتمعوا يذكرون الله عز وجل لا يريدون بذلك إلا وجه الله إلا ناداهم مناد من السماء : قوموا مغفورا لكم ، قد بدلت سيئاتكم حسنات ) )(@)(@@) ابن شاهين في الترغيب في الذكر عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19510 ) قال النبي :(@)(@@) | 30 ( ما من قوم أحب إلى الله تعالى من قوم حملوا القرآن وركبوا إلى التجارة التي ذكر الله تعال ، { تنجيكم من عذاب إليم } ، قرءوا القرآن ، وشهروا السيوف ، يسكنون بلدة يقال لها قزوين ، يأتون يوم القيامة وأرواحهم تقطر دما ، يحبهم الله ويحبونه ، تفتح لهم أبواب الجنة فيقال لهم : PageV06P393 ادخلوا من أيها شئتم ) )(@)(@@) الخليلي في فضائل قزوين ، وأبو زكريا يحيى بن عبد الوهاب بن منده في التاريخ والرافعي عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19511 ) قال النبي :(@)(@@) | 30 ( ما من قوم جلسوا مجلسا يذكرون الله إلا ناداهم مناد من السماء : قوموا فقد غفرت لكم وبدلت سيئاتكم حسنات ) )(@)(@@) العسكري في الصحابة وأبو موسى ا عن حنظلة العبشمي رضي الله عنه وضعف .(@)(@@)(@@)(@@) $ ( 19512 ) قال النبي :(@)(@@) | 30 ( ما من مائدة أعظم بركة من مائدة جلس عليها يتيم ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19513 ) قال النبي :(@)(@@) | 30 ( ما 
ms2108	 من مؤمن أدخل على مؤمن سرورا إلا خلق الله من ذالك السرور ملكا يعبد الله ويمجده ويوحده ، فإذا صار المؤمن في لحده أتاه السرور الذي أدخله عليه فيقول له : أما تعرفني ؟ فيقول : من أنت ؟ فيقول : أنا السرور الذي أدخلتني على فلان ، أنا اليوم أؤنس وحشتك ، وأثبتك بالقول الثابت ، وأشهد بك مشهد القيامة ، وأشفع لك من ربك ، وأريك منزلك من الجنة ) )(@)(@@) ابن أبي الدنيا في قضاء الحوائج عن جعفر بن محمد عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 19514 ) قال النبي :(@)(@@) | 30 ( ما من مؤمن يخرج من عينيه دمعة من خشية الله وإن كان مثل رأس الذباب فتصيب شيئا من حر وجهه إلا حرمه الله على النار ) )(@)(@@) ( هب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19515 ) قال النبي :(@)(@@) | 30 ( ما من مؤمن ولا مؤمنة ، ولا مسلم ولا مسلمة يمرض مرضا إلا حط الله عز وجل بها عنه من خطاياه ) )(@)(@@) ( ط حم خ ) في الأدب ( حب ض ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19516 ) قال النبي :(@)(@@) | 30 ( ما من مؤمن يتوضأ فيحسن وضوءه ثم يعمد إلى PageV06P394 المسجد إلا كتب الله له بكل خطوة يخطوها حسنة ، ومحا عنه سيئة ) )(@)(@@) عبد بن حميد عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19517 ) قال النبي :(@)(@@) | 30 ( ما من مؤمن يصيبه وصب ولا نصب ، ولا سقم ، ولا حزن ، ولا هم يهمه إلا كفر الله سيئاته ) )(@)(@@) ( ط ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19518 ) قال النبي :(@)(@@) | 30 ( ما من مؤمن يصيبه مرض إلا غفر الله له ما تقدم من ذنبه وكتب له أجر ما كان يعمل وهو صحيح ) )(@)(@@) ابن النجار عن أبي عبيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19519 ) قال النبي :(@)(@@) | 30 ( ما من مؤمن يصيبه صداع في رأسه ، أو شوكة تؤذيه فما سوى ذالك إلا رفعه الله بها درجة يوم القيامة وكفر عنه بها خطيئة ) )(@)(@@) ( حل كر ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19520 ) قال النبي :(@)(@@) | 30 ( ما من مريض لم يحضر أجله يعوذ بهاذه الكلمات إلا خفف الله عنه : بسم الله العظيم ، أسأل الله العظيم 
ms2109	 ، رب العرش العظيم أن يشفيه ، سبع مرات ) )(@)(@@) ابن النجار عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19521 ) قال النبي :(@)(@@) | 30 ( ما من محرم يضحى للشمس حتى تغرب إلا غربت بذنوبه حتى يصير كما ولدته أمه ) )(@)(@@) ( ه ) عن جابر ، ( ك ) في تاريخه عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19522 ) قال النبي :(@)(@@) | 30 ( ما من محرم يضحى للشمس حتى تغرب إلا غربت بذنوبه حتى يصير كيوم ولدته أمه ) )(@)(@@) ابن زنجويه عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19523 ) قال النبي :(@)(@@) | 30 ( ما من مسلم ابتلاه الله في جسده إلا كتب الله له ما كان يعمل في صحته ) )(@)(@@) ( خ ) في الأدب عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19524 ) قال النبي :(@)(@@) | 30 ( ما من مسلم يبتلى في جسده إلا قال الله عز وجل PageV06P395 لملائكته : اكتبوا لعبدي أفضل ما كان يعمل في صحته ) )(@)(@@) ابن النجار عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19525 ) قال النبي :(@)(@@) | 30 ( ما من مسلم يموت يشهد له أربعة أهل أبيات من جيرانه الأدنين أنهم لا يعلمون منه إلا خيرا إلا قال الله : قد قبلت علمكم فيه وغفرت له ما لا تعلمون ) )(@)(@@) ( حم ع حب ك حل هب ض ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19526 ) قال النبي :(@)(@@) | 30 ( ما من مسلم يموت فيشهد له رجلان من جيرانه الأدنين فيقولان : اللهم لا نعلم إلا خيرا إلا قال الله للملائكة : اشهدوا أني قد قبلت شهادتهما وغفرت له ما لا يعلمان ) )(@)(@@) ( خط ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19527 ) قال النبي :(@)(@@) | 30 ( ما من مسلم يصيبه أذى في جسده إلا كفر الله خطاياه ) )(@)(@@) ( طب كر ) عن معاوية رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19528 ) قال النبي :(@)(@@) | 30 ( ما من مسلم ولا مسلمة يصاب بمصيبة فيذكرها وإن قدم عهدها فيحدث لذالك استرجاعا إلا جدد الله له عند ذالك وأعطاه مثل أجرها يوم أصيب بها ) )(@)(@@) ( حم طس ) و ابن السني في عمل يوم وليلة عن فاطمة بنت الحسين عن أبيها ( عق ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 19529 ) قال النبي :(@)(@@) | 30 ( ما من مسلم ينفق من كل مال 
ms2110	 له زوجين في سبيل الله إلا استقبلته حجبة الجنة كلهم يدعوه إلى ما عنده ) )(@)(@@) ( حم ن ) و الدارمي وأبو عوانة ( حب ك طب هق ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19530 ) قال النبي :(@)(@@) | 30 ( ما من مسلم ينفق من ماله زوجين في سبيل الله عز وجل إلا دعته الجنة هلم هلم ) )(@)(@@) ( خط ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19531 ) قال النبي :(@)(@@) | 30 ( ما من مسلم يصلي علي صلاة إلا صلت عليه PageV06P396 الملائكة ما صلى علي ، فليقل العبد من ذالك أو ليكثر ) )(@)(@@) ( ه طب ) عن عامر بن ربيعة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19532 ) قال النبي :(@)(@@) | 30 ( ما من مسلم يشهر على أخيه السلاح إلا كانا على حرف جهنم ، فإن أغمدا عادا إلى الذي كانا عليه ، فإن قتل أحدهما صاحبه دخلاها جميعا ) )(@)(@@) ( كر ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19533 ) قال النبي :(@)(@@) | 30 ( ما من مسلم يقول إذا سمع النداء وكبر المنادي : يكبر ثم يشهد أن لا إلاه إلا الله وأن محمدا رسول الله فيشهد ، ثم يقول : اللهم أعط محمدا الوسيلة واجعل في الأعلين درجته ، وفي المصطفين محبته ، وفي المقربين داره ، إلا وجبت له شفاعتي يوم القيامة ) )(@)(@@) الطحاوي ( طب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19534 ) قال النبي :(@)(@@) | 30 ( ما من مسلم يعمر في الإسلام أربعين سنة إلا صرف الله عنه ثلاثة أنواع من البلاء : الجذام ، والجنون والبرص ، فإذا بلغ الخمسين يسر الله عليه الحساب ، فإذا بلغ الستين رزقه الله الإنابة إليه بما يحب ، فإذا بلغ السبعين أحبه الله وأحبه أهل السماء ، فإذا بلغ الثمانين قبل الله حسناته وتجاوز عن سيئاته ، فإذا بلغ التسعين غفر الله له ما تقدم من ذنبه وما تأخر وسمي أسير الله في الأرض ، وشفع في أهل بيته ) )(@)(@@) الحكيم ( ع ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19535 ) قال النبي :(@)(@@) | 30 ( ما من مسلم يمسح يده على رأس يتيم إلا كانت له بكل شعرة مرت يده عليها حسنة ، ورفعت له بها درجة ، وحطت عنه بها خطيئة ) )(@)(@@) ابن النجار عن عبد الله بن أبي 
ms2111	 أوفى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19536 ) قال النبي :(@)(@@) | 30 ( ما من مسلم يقف عشية عرفة بالموقف فيستقبل القبلة ثم يقول : لا إلاه إلا الله وحده لا شريك له ، له الملك وله الحمد وهو على PageV06P397 كل شيء قدير ، مائة مرة ، ثم يقرأ أم الكتاب مائة مرة ، ثم يقول : أشهد أن لا إلاه إلا الله وحده لا شريك له وأن محمدا عبده ورسوله ، مائة مرة ، ثم يسبح الله تعالى ، مائة مرة ، فيقول : سبحان الله ، والحمد لله ، ولا إلاه إلا الله والله أكبر ، ولا حول ولا قوة إلا بالله ، ثم يقرأ قل هو الله أحد مائة مرة ، ثم يقول : اللهم صل على محمد وعلى آل محمد ، كما صليت على إبراهيم وعلى آل إبراهيم إنك حميد مجيد ، وعلينا معهم ، مائة مرة ، إلا قال الله تعالى : يا ملائكتي ما جزاء عبدي هاذا : سبحني وهللني وكبرني وعظمني ومجدني ونسبني ، وعرفني وأثنى علي ، وصلى على نبيي اشهدوا يا ملائكتي أني قد غفرت له وشفعته في نفسه ، ولو شاء أن أشفعه في أهل الموقف لشفعته ) )(@)(@@) ( هب ) و ابن النجار والديلمي عن جابر ، قال أبو بكر بن مهران الحافظ : تفرد به عبد الرحمن بن محمد المحاربي عن محمد بن سرقة ، وقال ( هب ) : هذا غريب وليس في إسناده من ينسب إلى الوضع .(@)(@@)(@@)(@@) $ ( 19537 ) قال النبي :(@)(@@) | 30 ( ما من مسلم يلي عشرة فما فوق ذالك إلا أتى يوم القيامة مغلولة يده إلى عنقه ، فكه بره أو أوثقه إثمه ، أولها ملامة ، وأوسطها ندامة ، وآخرها عذاب يوم القيامة ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19538 ) قال النبي :(@)(@@) | 30 ( ما من مسلم يتوضأ فيغسل يديه ، ويمضمض فاه ، ويتوضأ كما أمر إلا حط الله عنه ما أصاب يومئذ ، ما نطق به فمه ، وما مس بيده ، وما مشى إليه حتى إن الخطايا تحادر من أطرافه ، ثم هو اذا مشى إلى المسجد فرجل تكتب حسنة ، وأخرى تمحو سيئة ) )(@)(@@) ( ط ض ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19539 ) قال النبي :(@)(@@) | 30 ( ما من مسلم تحضره صلاة مكتوبة 
ms2112	 ، فيقوم فيتوضأ فيحسن الوضوء ويصلي فيحسن الصلاة إلا غفر الله له بها ما كان بينها وبين الصلاة PageV06P398 التي كانت قبلها من ذنوبه ) )(@)(@@) ( حم ع طب ض ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19540 ) قال النبي :(@)(@@) | 30 ( ما من مسلم يسمع أذانا فقام إلى وضوئه إلا غفر له في أول قطرة تصيب كفه من ذالك الماء فبعدد ذالك القطر يغفر الله له ما سلف من ذنوبه ، فيقوم إلى صلاته وهي نافلة ) )(@)(@@) ( طب ض ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19541 ) قال النبي :(@)(@@) | 30 ( ما من مسلم يتوضأ فيضع وضوءه مواضعه إلا خرجت خطاياه من سمعه وبصره ويديه ورجليه ، وكانت صلاته له فضلا ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19542 ) قال النبي :(@)(@@) | 30 ( ما من مسلم يدعو الله عز وجل بدعوة فيها إثم ولا قطيعة رحم إلا أعطاه الله بها إحدى ثلاث : إما أن يعجل له دعوته ، وإما أن يدخرها له في الآخرة ، وإما أن يصرف عنه من السوء مثلها ، قالوا إذن نكثر ، قال : الله أكثر وأطيب ) )(@)(@@) ( ش حم ) و عبد بن حميد ( ع ك هب ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19543 ) قال النبي :(@)(@@) | 30 ( ما من مسلم ولا مسلمة يمرض إلا كفارة لذنوبه ) )(@)(@@) الشيرازي في الألقاب عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19544 ) قال النبي :(@)(@@) | 30 ( ما من مسلم قبض يتيمين مسلمين إلى طعامه وشرابه إلا دخل الجنة البتة إلا أن يعمل ذنبا لا يغفر ، ومن أخذت كريمتيه فصبر واحتسب لم يكن له عندي ثواب إلا الجنة ، قيل : وما كريمتاه ؟ قال : عيناه ، ومن عال ثلاث بنات فأنفق عليهن ورحمهن وأحسن أدبهن أدخله الله الجنة ، قيل : أو اثنتين ؟ قال : أو اثنتين ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19545 ) قال النبي :(@)(@@) | 30 ( ما من مسلم يرد عن عرض أخيه إلا كان حقا على PageV06P399 الله أن يرد عنه نار جهنم يوم القيامة ) )(@)(@@) ( طب ) و الخرائطي في مكارم الأخلاق عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19546 ) قال النبي :(@)(@@) | 30 ( ما من مسلم يدعو 
ms2113	 لأخيه بدعوة بظهر الغيب : اللهم أخي فلان فاغفر له ، إلا قالت الملائكة : آمين ولك بمثل ذالك ) )(@)(@@) ( طب ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19547 ) قال النبي :(@)(@@) | 30 ( ما من مسلم يكون له ثلاث بنات فينفق عليهن حتى يبن أو يمتن إلا كن له حجابا من النار ، قيل ؛ أو اثنتان ؟ قال : أو اثنتان ) )(@)(@@) الخرائطي في مكارم الأخلاق ( طب ) عن عوف بن مالك رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19548 ) قال النبي :(@)(@@) | 30 ( ما من مسلم يخرج من بيته يريد سفرا أو غيره ، فقال حين يخرج : بسم الله ، آمنت بالله ، اعتصمت بالله ، توكلت على الله ، لا حول ولا قوة إلا بالله إلا رزق خير ذالك المخرج ، وصرف عنه شر ذالك المخرج ) )(@)(@@) ( حم ) ابن صصرى في أماليه عن عثمان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19549 ) قال النبي :(@)(@@) | 30 ( ما من مسلم ولي من أمر المسلمين شيئا إلا بعث الله إليه ملكين يسددانه ما نوى الحق ، فإن نوى الجور على عمد وكلاه إلى نفسه ) )(@)(@@) ( طب ) عن واثلة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19550 ) قال النبي :(@)(@@) | 30 ( ما من مسلم يدان دينا يريد أداءه إلا أداه الله عنه في الدنيا ) )(@)(@@) ( طب ) عن ميمونة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 19551 ) قال النبي :(@)(@@) | 30 ( ما من مسلم يتوضأ فيسبغ الوضوء ثم يقوم في صلاته فيعلم ما يقول إلا انفتل وهو كيوم ولدته أمه من الخطايا ليس عليه ذنب ) )(@)(@@) PageV06P400 ( ك ) عن عقبة بن عامر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19552 ) قال النبي :(@)(@@) | 30 ( ما من مسلم يمضمض فاه إلا غفر الله له كل خطيئة أصابها بلسانه ذالك اليوم ، ولا يغسل يديه إلا غفر الله له ما قدمت يداه ذالك اليوم ، ولا يمسح برأسه إلا كان كيوم ولدته أمه ) )(@)(@@) ( طس ) عن أبي لبابة بن عبد المنذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19553 ) قال النبي :(@)(@@) | 30 ( ما من مسلم يتوضأ للصلاة فيمضمض فاه إلا خرج مع قطر الماء كل سيئة تكلم بها لسانه ، ولا يستنشق إلا خرج مع قطر الماء كل سيئة وجد ريحها بأنفه ، ولا يغسل وجهه إلا تناثر من عينيه مع 
ms2114	 قطر الماء كل سيئة نظر إليها بهما ، ولا يغسل شيئا من يديه إلا خرج مع قطر الماء كل سيئة بطش بهما ، ولا يغسل شيئا من رجليه إلا خرج مع قطر الماء كل سيئة مشى بهما إليها ، فإذا خرج إلى المسجد كتب له بكل خطوة خطاها حسنة ، ومحي بها عنه سيئة حتى يأتي مقامه ) )(@)(@@) ( طس ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19554 ) قال النبي :(@)(@@) | 30 ( ما من مسلم يصيبه وصب ولا نصب ولا أذى ولا حزن ولا سقم ولا هم يهمه إلا كفر الله عنه من سيئاته ) )(@)(@@) ( هناد ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19555 ) قال النبي :(@)(@@) | 30 ( ما من عبد يذنب ذنبا فيتوضأ ثم يصلي ركعتين أو أربعا مفروضة أو غير مفروضة ثم يستغفر الله إلا غفر الله له ) )(@)(@@) ( طس ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19556 ) قال النبي :(@)(@@) | 30 ( ما من مسلم يتوضأ فيسبغ الوضوء ، ثم يمشي إلى الصلاة جماعة إلا غفر الله له ذالك اليوم ما مشت رجلاه ، وقبضت عليه يداه ، واستمعت إليه أذناه ، ونظرت إليه عيناه ، ونطق به لسانه ، وحدثته به نفسه من السوء ) )(@)(@@) ابن زنجويه ( هب ) عن أبي أمامة رضي الله عنه .(@)(@@) PageV06P401(@)(@@)(@@)(@@) $ ( 19557 ) قال النبي :(@)(@@) | 30 ( ما من مسلم يصاب بشيء في جسده فيصبر إلا رفعه الله به درجة وحط عنه به خطيئة ) )(@)(@@) ابن جرير عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19558 ) قال النبي :(@)(@@) | 30 ( ما من مسلم يغرس غرسا ولا حرثا فيأكل منه إنسان ولا بهيمة ولا طير ولا شيء إلا كان له أجره ) )(@)(@@) البغوي عن أبي نجيح رضي الله عنه قال : وليس بالسلمي يشك في صحبته .(@)(@@)(@@)(@@) $ ( 19559 ) قال النبي :(@)(@@) | 30 ( ما من مسلم يتعار من جوف الليل فيقول : الله أكبر ، وسبحان الله ، ولا إلاه إلا الله وحده لا شريك له ، له الملك وله الحمد ، يحيي ويميت وهو على كل شيء قدير ، ولا حول ولا قوة إلا بالله ، أستغفر الله الغفور الرحيم إلا سلخه الله من ذنوبه كيوم ولدته أمه ) )(@)(@@) الخرائطي في مكارم الأخلاق عن 
ms2115	 عبادة بن الصامت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19560 ) قال النبي :(@)(@@) | 30 ( ما من مسلم ذكر ولا أنثى ينام إلا وعليه جرير معقود ، فإن استيقظ فذكر الله انحلت عقدة وإن هو توضأ ثم قام إلى الصلاة أصبح نشيطا قد أصاب خيرا وقد انحلت عقده كلها ، وإن أصبح ولم يذكر الله أصبح وعقده عليه وأصبح ثقيلا كسلانا لم يصب خيرا ) )(@)(@@) ( حب ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19561 ) قال النبي :(@)(@@) | 30 ( ما من مسلم يدخل عليه أخوه المسلم فيلقي له وسادة إكراما له وإعظاما له إلا غفر الله له ) )(@)(@@) ( طس ) عن سل مان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19562 ) قال النبي :(@)(@@) | 30 ( ما من مسلم توضأ فأحسن الوضوء ثم صلى صلاة يحفظها ويعقلها إلا دخل الجنة ) )(@)(@@) ( طب ) عن خريم بن فاتك رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19563 ) قال النبي :(@)(@@) | 30 ( ما من مسلم يغرس غرسا إلا كان له من الأجر بقدر PageV06P402 ما خرج من ثمرة ذالك الغرس ) )(@)(@@) ابن النجار عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19564 ) قال النبي :(@)(@@) | 30 ( ما من عبد مسلم يبتلى في جسده إلا قال الله لملائكته : اكتبوا لعبدي أفضل ما كان يعمل في صحته ) )(@)(@@) ابن النجار عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19565 ) قال النبي :(@)(@@) | 30 ( ما من مسلم يعود مسلما غدوة إلا صلى عليه سبعون ألف ملك حتى يمسي ، وإن عاده عشية إلا صلى عليه سبعون ألف ملك حتى يصبح ، وكان له خريف في الجنة ) )(@)(@@) ( ت ) حسن غريب و ابن جرير وصححه عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19566 ) قال النبي :(@)(@@) | 30 ( ما من مسلم يفعل خصلة من هاؤلاء يريد بها وجه الله إلا أخذت بيده يوم القيامة حتى تدخله الجنة ) )(@)(@@) ( حب ) و الروياني ( طب هب ض ) عن أبي ذر رضي الله عنه قال : قلت : يا رسول الله ماذا ينجي العبد من النار ؟ قال : الإيمان بالله ، قلت : إن مع الإيمان عملا ؟ قال : يرضخ مما رزقه الله ، قلت : أرأيت إن كان فقيرا لا يجد ما يرضخ به ، قال : يأمر بالمعروف وينهى عن المنكر ، قلت : أرأيت إن كان 
ms2116	 عييا لا يستطيع أن يصنع شيئا ، قال : يعين مغلوبا ، قلت : أرأيت إن كان ضعيفا لا يستطيع أن يعين مغلوبا ، قال : ما تريد أن تترك في صاحبك شيئا من الخير ، يمسك الأذى عن الناس ، قلت : يا رسول الله إذا فعل ذالك دخل الجنة ؟ قال : والذي نفسي بيده فذكره .(@)(@@)(@@)(@@) $ ( 19567 ) قال النبي :(@)(@@) | 30 ( ما من مسلمين التقيا فأخذ أحدهما بيد صاحبه إلا كان حقا على الله عز وجل أن يحضر دعاءهما ولا يفرق بين أيديهما حتى يغفر لهما ، وما من قوم اجتمعوا يذكرون الله عز وجل لا يريدون بذالك إلا وجهه إلا PageV06P403 ناداهم مناد من السماء أن قوموا مغفورا لكم ، قد بدلت سيئاتكم حسنات ) )(@)(@@) ( حم ع ض ) عن ميمون المري عن ميمون بن شياه عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19568 ) قال النبي :(@)(@@) | 30 ( ما من مسلمين إلا بينهما ستر ، فإذا قال أحدهما لصاحبه هجرا هتك بستر الله ، وإذا قال : يا كافر فقد كفر أحدهما ) )(@)(@@) الحكيم ( طب هب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19569 ) قال النبي :(@)(@@) | 30 ( ما من مسلمين يموت لهما ثلاثة من أولادهما لم يبلغوا الحنث إلا كانوا لهما حصنا حصينا من النار ، قالوا : يا رسول الله وإن كانا اثنين ؟ قال : وإن كانا اثنين ، قالوا : وإن كان واحدا ؟ قال : وإن كان واحدا ، ولاكن إنما ذالك عند الصدمة الأولى ) )(@)(@@) ( حم ع هب كر ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19570 ) قال النبي :(@)(@@) | 30 ( ما من امرأتين هلك بينهما ولدان ، أو ثلاثة ، فاحتسبا وصبرا فيريان النار أبدا ) )(@)(@@) ( حم حب ك ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19571 ) قال النبي :(@)(@@) | 30 ( ما من مسلمين يموت لهما ثلاثة لم يبلغوا الحنث إلا أدخلهم الله الجنة بفضل رحمته إياهم ، وما من مسلم أنفق زوجين في سبيل الله إلا ابتدرته حجته الجنة ) )(@)(@@) ( هب ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19572 ) قال النبي :(@)(@@) | 30 ( ما من مسلمين يموت لهما ثلاثة أطفال لم يبلغوا الحنث إلا جيء بهم يوم القيامة حتى يوقفوا على باب الجنة فيقال لهم : ادخلوا 
ms2117	 الجنة ، فيقولون : حتى يدخل آباؤنا ، فيقال لهم : ادخلوا أنتم وآباؤكم الجنة ) )(@)(@@) ابن سعد ( طب ) والحسن بن سفيان عن حبيبة بنت سهل رضي الله عنها .(@)(@@) PageV06P404(@)(@@)(@@)(@@) $ ( 19573 ) قال النبي :(@)(@@) | 30 ( ما من مسلمين يموت لهما أربعة أفراطا إلا أدخلهم الله الجنة بفضل رحمته إياهم ، قالوا : يا رسول الله وثلاثة ؟ قال : وثلاثة ، قالوا : واثنان ؟ قال : واثنان ، وإن من أمتي لمن يعظم للنار حتى يكون أحد زواياها ، وإن من أمتي من يدخل الجنة بشفاعته مثل مضر ) )(@)(@@) ( حم ) عن أبي بزرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19574 ) قال النبي :(@)(@@) | 30 ( ما من مسلمين يموت لهما ثلاثة أولاد لم يبلغوا الحنث إلا أدخلهما الله بفضل رحمته الجنة ويكونون على باب من أبواب الجنة ، فيقال لهم : ادخلوا الجنة ، فيقولون : حتى يدخل أبوانا ، فيقال لهم : ادخلوا الجنة أنتم وآباؤكم بفضل رحمة الله ) )(@)(@@) ( هب حم ن هق ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19575 ) قال النبي :(@)(@@) | 30 ( ما من مسلمين يموت بينهما اثنان من ولدهما إلا أدخلهما الله الجنة بفضل رحمته إياهما ) )(@)(@@) ( طب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19576 ) قال النبي :(@)(@@) | 30 ( ما من مسلمين يتوفى لهما ثلاثة أولاد لم يبلغوا الحنث إلا أدخل الله الجنة بفضل رحمته إياهم ، قالوا : واثنان ؟ قال : واثنان ، قالوا : وواحد ؟ قال : وواحد ، والذي نفسي بيده ، إن السقط ليجر أمه إلى الجنة بسرره إذا احتسبته ) )(@)(@@) ( حم ) و الحكيم ( طب ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19577 ) قال النبي :(@)(@@) | 30 ( ما من مصل إلا وملك عن يمينه وملك عن يساره ، فإن أتمها عرجا بها ، وإن لم يتمها ضربا بها وجهه ، وتقول له الصلاة : ضيعك الله كما ضيعتني ) )(@)(@@) ( قط ) في الأفراد و ابن شاهين عن عمر رضي الله عنه .(@)(@@) PageV06P405(@)(@@)(@@)(@@) $ ( 19578 ) قال النبي :(@)(@@) | 30 ( ما من مصل يصلي إلا حفت به الحور العين ، فإن انفتل ولم يسأل الله منهن شيئا إلا تفرقن عنه وهن متعجبات ) )(@)(@@) ابن شاهين عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19579 ) قال النبي :(@)(@@) | 30 ( ما من معمر يعمر في الإسلام أربعين سنة إلا صرف الله عنه ثلاثة أنواع 
ms2118	 من البلاء : الجنون ، والجذام ، والبرص ) )(@)(@@) ابن النجار عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19580 ) قال النبي :(@)(@@) | 30 ( ما من ملك يصل رحمه وذا قرابته ، ويعدل في رعيته إلا شد الله له ملكه ، وأجزل له ثوابه ، وأكرم مآبه ، وخفف حسابه ) )(@)(@@) أبو الحسن بن معروف ( خط كر ) والديلمي عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19581 ) قال النبي :(@)(@@) | 30 ( ما من مولى يأتي مولى له فيسأله من فضل ما عنده فيتجهمه إلا جعله الله شجاعا أقرع يوم القيامة ينهشه قبل القضاء ) )(@)(@@) ( حم طب هب بز ) عن حكيم بن معاوية عن أبيه .(@)(@@)(@@)(@@) $ ( 19582 ) قال النبي :(@)(@@) | 30 ( ما من مولود إلا وينثر عليه من تراب سرته ) )(@)(@@) أبو نصر حاجي بن الحسين في حزبه والرافعي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19583 ) قال النبي :(@)(@@) | 30 ( ما من مولود إلا وقد عصره الشيطان عصرة أو عصرتين إلا عيسى بن مريم ومريم ) )(@)(@@) ابن جرير عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19584 ) قال النبي :(@)(@@) | 30 ( ما من مولود إلا وفي سرته من تربته التي يولد منها ، فإذا رد إلى إلى أرذل عمره رد إلى تربته التي خلق منها حتى يدفن فيها ، وإني وأبو بكر وعمر خلقنا من تربة واحدة وفيها ندفن ) )(@)(@@) ( خط ) عن ابن مسعود رضي الله عنه وقال : غريب .(@)(@@) PageV06P406(@)(@@)(@@)(@@) $ ( 19585 ) قال النبي :(@)(@@) | 30 ( ما من مولود يولد إلا على الفطرة ، وأبواه يهودانه وينصرانه كما تنتج الإبل فهل تجدون فيها جدعاء حتى تكونوا أنتم تجدعونها ، قالوا : يا رسول الله أرأيت من يموت صغيرا ؟ قال : الله أعلم بما كانوا عاملين ) )(@)(@@) ( حم ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19586 ) قال النبي :(@)(@@) | 30 ( ما من ميت يموت إلا وهو يعرف غاسله ، ويناشد حامله إن كان بشر بروح وريحان وجنة نعيم ، وإن بشر بنزل من حميم وتصلية جحيم أن يحبسه ) )(@)(@@) الديلمي عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19587 ) قال النبي :(@)(@@) | 30 ( ما من ميت يموت فيقرأ عنده سورة ياس إلا هون الله عليه ) )(@)(@@) أبو نعيم عن أبي الدرداء وأبي ذر رضي الله عنهما معا .(@)(@@)(@@)(@@) $ ( 19588 
ms2119	 ) قال النبي :(@)(@@) | 30 ( ما من ميت يوضع على سريره فيخطى به ثلاث خطى إلا نادى بصوته يسمعه من شاء الله : يا إخوتاه ، ويا حملة نعشاه ، لا تغرنكم الدنيا كما غرتني ، ولا يلعبن بكم الزمان كما لعب بي ، أترك ما تركت لذريتي ولا يحملون عني خطيئتي ، وأنتم تشيعوني ثم تتركوني ، والجبار يخاصمني ) )(@)(@@) ابن أبي الدنيا والديلمي عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19589 ) قال النبي :(@)(@@) | 30 ( ما من نبت ينبت إلا ويحفه ملك موكل به حتى يحصده ، فأيما امرىء وطىء ذالك النبت يلعنه ذالك الملك ) )(@)(@@) الديلمي عن هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19590 ) قال النبي :(@)(@@) | 30 ( ما من نبي تقدر أمته على دفنه إلا دفنوه في الموضع الذي قبض فيه ) )(@)(@@) الرافعي من طريق الزبير بن بكار ، حدثني PageV06P407(@)(@@) | 40 ( يحيى بن محمد بن طلحة بن عبد الله بن عبد الرحم ن بن أبي بكر الصديق ) 40(@)(@@) يحيى بن محمد بن طلحة بن عبد الله بن عبد الرحمان بن أبي بكر الصديق ، حدثني عمي شعيب بن طلحة ، حدثني أبي ، سمعت أسماء بنت أبي بكر رضي الله عنها .(@)(@@)(@@)(@@) $ ( 19591 ) قال النبي :(@)(@@) | 30 ( ما من نبي إلا أعطي سبعة نقباء وزراء أنجباء رفقاء ، وأعطيت أنا أربعة عشر وزيرا نقيبا نجيبا ، سبعة من قريش : علي والحسن والحسين وحمزة وجعفر وأبو بكر وعمر ، وسبعة من المهاجرين : عبد الله بن مسعود وسلمان وأبو ذر وحذيفة وعمار والمقداد وبلال ) )(@)(@@) ( حم ) و تمام ( كر ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19592 ) قال النبي :(@)(@@) | 30 ( ما من نبي إلا وفي أمته معلم أو معلمان ، فإن يك في أمتي أحد فابن الخطاب ، إن الحق على لسان عمر وقلبه ) )(@)(@@) ابن سعد عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 19593 ) قال النبي :(@)(@@) | 30 ( ما من نبي إلا له نظير في أمتي : وأبو بكر نظير إبراهيم ، وعمر نظير موسى ، وعثمان نظير هاارون ، وعلي بن أبي طالب نظيري ، ومن سره أن ينظر إلى عيسى بن مريم فلينظر إلى أبي ذر الغفاري ) )(@)(@@) ( كر ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19594 ) قال النبي :(@)(@@) | 30 
ms2120	 ( ما من نبي إلا وله وزيران من أهل السماء ، ووزيران من أهل الأرض ، فأما وزيراي من أهل السماء : فجبريل وميكائيل ، وأما وزيراي من أهل الأرض : فأبو بكر وعمر ) )(@)(@@) حسن غريب عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19595 ) قال النبي :(@)(@@) | 30 ( ما من نبي إلا وقد أنذر قومه الدجال ، وإني أحذركم أمر الدجال ، إنه أعور وإن ربي ليس بأعور ، بين عينيه مكتوب كافر يقرأه الكاتب وغير الكاتب ، معه جنة ونار ، فناره جنة ، وجنته نار ) )(@)(@@) ( طب ) عن معاذ رضي الله عنه .(@)(@@) PageV06P408(@)(@@)(@@)(@@) $ ( 19596 ) قال النبي :(@)(@@) | 30 ( ما من نبي ولا وال إلا وله بطانتان : بطانة تأمره بالمعروف وتنهاه عن المنكر ، وبطانة لا تألوه خبالا ، ومن وقي شرهما فقد وقي ، وهو من التي تغلب عليه منهما ) )(@)(@@) ( حم هق ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19597 ) قال النبي :(@)(@@) | 30 ( ما من نبي إلا وقد رعى الغنم ) )(@)(@@) ( هناد ) عن عبيد بن عمير مرسلا .(@)(@@)(@@)(@@) $ ( 19598 ) قال النبي :(@)(@@) | 30 ( ما من نسمة يخلقها الله في بطن أمه إلا أنه شقي أو سعيد ) )(@)(@@) أبو نعيم عن ثابت بن الحارث الأنصاري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19599 ) قال النبي :(@)(@@) | 30 ( ما من نعمة وإن تقادم عهدها فيجددها العبد بالحمد إلا جدد الله له ثوابها ، وما من مصيبة وإن تقادم عهدها فيجددها العبد بالاسترجاع إلا جدد الله له ثوابها وأجرها ) )(@)(@@) الحكيم عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19600 ) قال النبي :(@)(@@) | 30 ( ما من نفس تموت ولها عند الله مثقال أنملة من خير إلا طين عليها طينا ) )(@)(@@) ( طب ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19601 ) قال النبي :(@)(@@) | 30 ( ما من نفس إلا ولها باب في السماء ينزل رزقه ومنه يصعد عمله ، فإذا أراد الله أن يرزقها فتح ذالك الباب فنزل إليها رزقها ، فإذا أغلق لم يستطع أحد فتحه حتى يفتحه الله إذا شاء ) )(@)(@@) أبو نعيم والديلمي عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19602 ) قال النبي :(@)(@@) | 30 ( ما من نفس تقتل ظلما إلا كان على ابن آدم كفلان من الوزر لأنه أول من سن القتل ) )(@)(@@) ( كر ) عن البراء 