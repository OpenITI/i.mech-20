ms41	 % 10(@)(@@) % كخلع الوشي منشرات ، % أرسلن من بحر ومن فلاة % PageV01P213 11(@)(@@) % مقصصات ومرجلات ، % كم رقدت من غير أمهات % 12(@)(@@) % في قلة الطود وفي الرماة ، % يحبلن بالأزواج والزوجات % 13(@)(@@) % و بانتشار الحب والملقات ، % وتارة يطرقن بالروعات % 14(@)(@@) % من ابن عرس عجل الوثبات % و هرة سريعة الجريات % 15(@)(@@) % طاغية جائعة البنات ، % ورب يوم ظلن خائفات % 16(@)(@@) % طائرة القلوب ضامرات % و القوس والبندق والرماة % 17(@)(@@) % وإن سقطن مترددات ، % فمسرعات غير لابثات % 18(@)(@@) % لبلغة ماسكة الحياة ، % خوف خيالات ومزريات % 19(@)(@@) % فلم تزل كذاك دائبات % طائرة القاوب ضامرات % 20(@)(@@) % حتى عرفن البرج بالآيات ، % تلوح للناظر من هيهات % PageV01P214 21(@)(@@) % كما يلوح النجم للهداة % . . . . . . . . . % PageV01P215 البحر : منسرح 1(@)(@@) % للمكتفي دولة مباركة ، % عاش بها الناس بعدما ماتوا % % 2(@)(@@) % يلوح من تحت تاجه قمر ، % وافى به للسعود ميقات % 3(@)(@@) % خليفة لا يخيب سائله ، % سرت به الأرض والسموات % 4(@)(@@) % ما ولدت هاشم له شبها ، % من أين ، من أين مثله ، هاتوا ! % PageV01P216 البحر : بسيط تام 1(@)(@@) % لي في التصابي واللهو حاجات ، % ليس لقلبي منهن إفلات % 2(@)(@@) % كم توبة قد فضضت خاتمها % % عني ، وللتائبين رجعات % 3(@)(@@) % فاشرب غداة النيروز صافية ، % أيامها في السرور ساعات % 4(@)(@@) % قد ظهر الجن بالنهار لنا % % منهم صنوف مرد عتيات % 5(@)(@@) % تميل في رقصهم قدودهم ، % كما تثنت في الريح سروات % 6(@)(@@) % وركب القبح فوق حسنهم ، % ففي سماجاتهم ملاحات % PageV01P217 البحر : وافر تام 1(@)(@@) % ألم ترني ربطت بشر أرض ، ألم ترني ربطت بشر أرض ، % فهل أنا واجد منها انفلاتا % % 2(@)(@@) % إذا ما المرء أصبح سائلوه ، % و قالواك كيف بت ، وكيف باتا % % 3(@)(@@) % يخليه المجاوز ، وهو دان ، % ويأتيه ، إذا ما اللص فاتا % % 4(@)(@@) % وتمطرنا لياليها بعوضا % يذب النوم عنا والسباتا % % 5(@)(@@) % وتلقانا الذئاب ، إذا غدونا ، % فتفري الجون وثبا والتفاتا % % 6(@)(@@) % وتسلك في شوارع خاليات ، % أحل الله فيهن الشتاتا % % 7(@)(@@) % و حيطان كشطرنج صفوف ، % فما تنفك تضرب شاه ماتا % % PageV01P218 البحر : سريع 1(@)(@@) % و بركة تزهو بنيلوفر ، % ألوانه بالحسن منعوته % % 2(@)(@@) % نهاره ينظر من مقلة % شاخصة الأجفان مبهوته % % 3(@)(@@) % كأنما كل قضيب له % يحمل في أعلاه 
ms42	 ياقوته % % PageV01P219 البحر : وافر تام 1(@)(@@) % كذا تبغي المحامد والمعالي ، % ألست تراهم تربا صموتا % % 2(@)(@@) % أبا حسن قراك الله حسنا ، % يعز على المكارم أن تموتا % % PageV01P220 البحر : مجتث 1(@)(@@) % يا دهر كم من جموع % صيرتهم أشتاتا % % 2(@)(@@) % و مات أيضا علي ، % و جاور الأمواتا % % 3(@)(@@) % هيهات أن يلد الده % ر مثله هيهاتا % % 4(@)(@@) % ما أحسن الصدق إلا % في قولنا عنه هاتا % % PageV01P221 البحر : طويل 1(@)(@@) % ظلمت ، إذا طالبت شيئا ، وقد فاتا ، % تقابل شيبا بالخضاب ، وهيهاتا % % 2(@)(@@) % وقالوا : امرؤ قد شاب وابيض رأسه ، % ولا بد يوما أن يقولوا : امرؤ ماتا % % PageV01P222 (@)(@@)(@@)(@@) | (@)(@@) البحر : كامل تام 1(@)(@@) % سار الرفيق لقصده وتلبثا ، % و شكان فما عذر الرفيق ، ولا رثى % % 2(@)(@@) % ورأى الطلول تطيق دفعا للأسى ، % و قضت عليه أن ينوح ويمكثا % % 3(@)(@@) % لم يبق فيها غير نؤي خامل ، % ومسحج رث القلادة أشعثا % % 4(@)(@@) % عفى وغيرها زمان غادر ، % متقلب في شرطه أن ينكثا % % 5(@)(@@) % من بعد عهدك أن ترى في ربعها % % رشأ كحيل المقلتين مرقشا % % 6(@)(@@) % يرنو بناظرة تذيب بلحظها % % مهج النفوس تقتلا وتأنثا % % 7(@)(@@) % أيام يلقي الزهر في لذاته % وسنا ، وتبعثني الحوادث مبعثا % % 8(@)(@@) % أوما عجبت لصاحب ، لي شره ، % لا يتقي أن يستشير ويبحثا % % 9(@)(@@) % أعيا التقاة ، فما تلين قناته ، % وعصت أفاعيه الرقاة النفثا % % 10(@)(@@) % ذهب القديم من المودة خالصا ، % و استبدل الإخوان ودا محدثا % % PageV01P223 11(@)(@@) % يعلو علي ، إذا وصلت حباله ، % فإذا قطعت الحبل منه تشبثا % % 12(@)(@@) % إن يحمل الأخبار ينقل نفسه ، % حتى يظل بسرها متحدثا % % 13(@)(@@) % متهكم بالسر ليس بعقله % رتق ، إذا غفل الرجال تنكثا % % 14(@)(@@) % عريان من حلل الجلالة والتقى ، % لم يحو من كرم الخلائف مورثا % % 15(@)(@@) % في مزحه جد يهيج لسمه % داء الصدور عليه حتى ينفثا % % 16(@)(@@) % هل كان إلا بعض ميل كتائب % أعيا علي تقصفا وتشعثا % % 17(@)(@@) % وجبت عليه كسرة ، أو رمية % أنفي بها عني الأقل الأخبثا % % 18(@)(@@) % ورجعت منتحل الكتابة لا ترى % % في الليل إلا ماضيا متعبثا % % PageV01P224 البحر : طويل 1(@)(@@) % أيا فتنة ما كنت منتظرا لها ، % أما لقتيل الهجر بالوصل من بعث % 2 
ms43	(@)(@@) % طلائع شوقي لا يقر قرارها ، % و مولاي قاس لا يرق ولا يرثي % % 3(@)(@@) % هلكت لأن دامت علي يمينه ، % فيا رب أدركني ووفقه للحنث % PageV01P225 البحر : بسيط تام 1(@)(@@) % و فتية لا يخوض الشك أنفسهم ، % مؤيدين لعزم غير منكوث % 2(@)(@@) % لما طفا النجم في بحر الدجى وصلوا % % حبل السرى بذميل غير تلبيث % 3(@)(@@) % حتى إذا هزم الإصباح ليلهم ، % بعسكر من جنود النور مبثوث % 4(@)(@@) % و صفق الديك من وجد ومن أسف ، % على الظلام ، وناداهم بتغويث % 5(@)(@@) % تميل من سكرات النوم قامته ، % كمثل ماش على دف بتحثيث % 6(@)(@@) % وفض خاتمه عن رأس مدخر % من الدنان قديم العهد موروث % 7(@)(@@) % تحيي زجاجته هذا وتقتل ذا ، % فالناس ما بين مقتول ومبعوث % 8(@)(@@) % أسترزق الله عطف الحب من رشإ % يشوب تذكير عينيه بتأنيث % 9(@)(@@) % وقد بدا الحب في دمعي وفي نظري ، % فلا تسل غير ما بي من أحاديث % PageV01P226 البحر : مجزوء الرمل 1(@)(@@) % لا يكن للكأس في % % كفك يوم الغيم لبث % 2(@)(@@) % أوما تعلم أن ال % % غيم ساق مستحث % PageV01P227 البحر : رمل تام 1(@)(@@) % قل لذات اللحظة المخنثه ، % ولئن أمست بلوني عبثه % % 2(@)(@@) % إنما مالي ما أنفقه ، % والذي أتركه للورثه % % PageV01P228 (@)(@@)(@@)(@@) | (@)(@@) البحر : طويل 1(@)(@@) % ألا ما لقلب لا تقضى حوائجه ، % ووجد أطار النوم بالليل لاعجه % % 2(@)(@@) % و داء ثوى بين الجوانح والحشا ، % فهيهات من إبرائه ما يوالجه % % 3(@)(@@) % ألا إن دون الصبر ذكر مفارق ، % سقى الله أياما تجلت هوادجه % 4(@)(@@) % غزال صفا ماء الشباب بخده ، % فضاقت عليه سوره ودمالجه % % 5(@)(@@) % ومنتصر بالغصن والحسن والنقا ، % و صدغ أديرت فوق ورد صوالجه % % 6(@)(@@) % تحكم فيه البين ، والدهر ينقضي ، % فلله رأي ما أضلت مناهجه % % 7(@)(@@) % و آخر حظي منه توديع ساعة ، % وقد مزج الإصباح بالليل مازجه % % 8(@)(@@) % وغرد حادي الركب وانشقت العصا ، % و صاحت بأخبار الفراق شواحجه % % 9(@)(@@) % فكم دمعة تعصي الجفون غزيرة ، % و كم نفس كالجمر تدمى مخارجه % % 10(@)(@@) % وآخر آثار المحبة ما ترى ، % طلول ، وربع قد تغير ناهجه % % PageV01P229 11(@)(@@) % أضر به صوب من المزن وابل ، % و كشف رياح ذاريارت دوارجه 
ms44	 % % 12(@)(@@) % ألا إن بعد النأي قربا وأوبة ، % وتحت غطاء الحزن والهم فارجه % % 13(@)(@@) % ويوم هجير لا يجير كناسه ، % من الحر ، وحشي المها ، وهو والجه % % 14(@)(@@) % يظل سراب البيد فيه ، كأنه % حواشي رداء نفضته نواسجه % % 15(@)(@@) % نضيت له وجهي وعزما مؤيدا ، % أرواحه حينا ، وحينا أوالجه % % 16(@)(@@) % كأني على حقبا تقدم قارحا % كمثل شهاب طار في الجو مارجه % % 17(@)(@@) % يسوق أسناها لواقح قربه ، % فألقين حملا أعجلته نواتجه % % 18(@)(@@) % رمين على أفخاذهن أجنة ، % كما أزلقت ولدان نسر جآدجه % % 19(@)(@@) % ويرفعن نقعا كالملاء مهلهلا ، % تموج على ظهر البلاد موائجه % % 20(@)(@@) % ويا رب مطروق قمرت غيوره ، % و طاوعت فيه حب نفس أعالجه % % PageV01P230 21(@)(@@) % فريدين لا نلقى بعلم ، كأننا % % نجيان من مكر خفي سوائجه % % 22(@)(@@) % إلى أن تولى النجم وانخرق الدجى % % كأن ضياء الفجر بالأفق باعجه % % 23(@)(@@) % وأبت ، وبي من ودها مضمراته ، % و داخله سر ، وللناس خارجه % % 24(@)(@@) % ويا رب يوم قد سبقت صباحه % % بموكب فتيان تسيل همالجه % % 25(@)(@@) % و إبريق شرب قد أجبت دعاته ، % كأن مدير الراح في الكأس دارجه % % 26(@)(@@) % وينقض بالأرواح روح مدامة ، % يكون بأفواه الندامى معارجه % % 27(@)(@@) % و قد عشت حتى ما لدى وجه منية % يعود إليها من فؤادي عالجه % % PageV01P231 البحر : مجزوء الوافر 1(@)(@@) % بخيل قد شقيت به ، % يكد الوعد باللجج % 2(@)(@@) % على بستان خديه ، % زرافين من السيج % PageV01P232 البحر : بسيط تام 1(@)(@@) % لا تتبع النفس شيئا فات مطلبه ، % واشرب ثلاثا تجد من همه فرجا % % 2(@)(@@) % وسائل لي عن العذال ، قلت له : % نجا فؤادي ، ولا تسأله كيف نجا % % PageV01P233 البحر : منسرح 1(@)(@@) % تقول لي ، والدموع واكفة ، % في خدها بالدماء تمتزج % 2(@)(@@) % حتى متى نلتقي على حذر ؟ % أما لنا من عذابنا فرج % PageV01P234 البحر : كامل تام 1(@)(@@) % ومحرق طاقين من سبج ، % في عاج وجه لاح كالسرج % 2(@)(@@) % أجسامنا بالسقم قد فنيت ، % فسلوا محاسنه عن المهج % PageV01P235 البحر : طويل 1(@)(@@) % رفعت يدي أستوهب الله صحة ، % لخير إمام سالك في التقى نهجا % % 2(@)(@@) % فقلت ، وقد طالت من الهم ليلتي ، % وإشفاق نفسي في الأماني قد لجا : % 3(@)(@@) % تغافل لنا يا 
ms45	 دهر عن نفس أحمد ، % فما بعده للملك حصن ، ولا ملجا % % 4(@)(@@) % ألا رب يوم قد سراه مجاهد ، % فأغرى مطايا الفرش واستمهد السرجا % % PageV01P236 البحر : طويل 1(@)(@@) % عجوز تصابى ، وهي بكر بزعمها ، % ومذ ألف عام قد وجى خدها الواجي % % 2(@)(@@) % ترى مشيها تحت القناع كأنه % ضفائر ليف في هدية حجاج % PageV01P237 البحر : خفيف تام 1(@)(@@) % و عروس زفت على بطن كف ، % في قميص منقش بزجاج % 2(@)(@@) % فهي بعد المزاج توريد خد ، % وهي مثل الياقوت قبل المزاج % PageV01P238 البحر : كامل تام 1(@)(@@) % حث الفراق بواكر الأحداج ، % و سجال يوم نأوا بكتم ساجي % % 2(@)(@@) % هل غير إمساك بأطراف المنى ، % فيها لطالب خلة ، أو راجي % % 3(@)(@@) % أو وقفة في محضر جرت به % % عصف الرياح الهوج ذيل عجاج % 4(@)(@@) % حملت كواهلها روايا مزنة ، % كالبحر ذي الآذي والأمواج % 5(@)(@@) % مفتوقة بالبرق يضحك أفقها ، % في ليلة بيضاء ذات دياجي % % 6(@)(@@) % فتحللت عقد السماء بوابل % زاهي المهاء محلل الأبراج % 7(@)(@@) % فلذاك أبلى الدهر منزلة الحمى ، % والدهر ذو غير ، ودو إزعاج % 8(@)(@@) % بل مهمة عافي المناهل قائم ، % قطعته بمواعس معاج % 9(@)(@@) % حنم على الفلوات يطوي بعدها % % بالنص ، والإرمال ، والإدلاج % 10(@)(@@) % ممتد أنبوب الجران كأنه ، % من تحت هامته ، نحيتة ساج % PageV01P239 11(@)(@@) % وإذا بدا تحت الرحال حسبته % % متسربلا ثوبا من الديباج % 12(@)(@@) % صدق السرى ، حتى تعرف واضح % كالقرن في خلل الظلام الداجي % % 13(@)(@@) % في ليلة أكل المحاق هلالها ، % حتى تبدى مثل وقف العاج % 14(@)(@@) % والصبح يتلو المشتري ، فكأنه % عريان يمشي في الدجى بسراج % 15(@)(@@) % حتى استغاث مع الشروق بمنهل ، % فيه دواح من قطا أفواج % 16(@)(@@) % وكأن رحلي فوق أحقب لاحب ، % لفح الهجير بمشعل أجاج % 17(@)(@@) % أكل الربيع ، ولم يدع من مائه ، % إلا بقية آسن وأجاج % 18(@)(@@) % كالبرق يلتم البلاد مجاهرا ، % بالشد بين مفاوز وفجاج % 19(@)(@@) % فترى السماء إذا غدت مملوءة % من نقعه ، والأرض ذات شحاج % 20(@)(@@) % و كان إذ ما رجعت نهقاته % % وصهيله درجا من الأدراج % PageV01P240 21(@)(@@) % و كأن آثار الكلوم بكفه ، % حلق الحديد سمرن فوق رتاج % 22(@)(@@) % يحدو لواقح لا تمل طرادها ، % في 
ms46	 كوكب من قيظه وهاج % 23(@)(@@) % يوردن عينا قد تفجر ماؤها ، % زوراء صافية كذوب زجاج % 24(@)(@@) % حتى إذا أخذت جوانب غمرها ، % و كرعن في خضراء ذات فجاج % 25(@)(@@) % قامت بمس السهم تمسح ريشه ، % لباتها ، ومنابض الأوداج % 26(@)(@@) % فتحت على طرف الهلال بأنفس % أنصافها صرف بغير مزاج % 27(@)(@@) % وإذا المنية أخرت أيامها ، % فالحي من كيد العداوة ناج % 28(@)(@@) % وبدت تطير بأرجل ممقورة % بالرعب ، تنتهب البلاد نواج % 29(@)(@@) % شدا يصيح الصخر من قرعاته ، % يسم البلاد بحافر رواج % 30(@)(@@) % يا من يدس لي العداوة صنعة ، % أسريت لي ، فاصبر على الإدلاج % PageV01P241 31(@)(@@) % فتح العدى باب المكيدة والأذى ، % فاعجب بهم ، والله منهم ناج % 32(@)(@@) % أنا كالمنية سقمها قدامها ، % طورا ، وطورا تبتدي ، فتفاجي % % PageV01P242 البحر : مجزوء الرجز 1(@)(@@) % كأنه لما غدا ، % والصبح لم ينبلج % 2(@)(@@) % قائد جيش جحفل ، % سار لقبض المهج % 3(@)(@@) % فجسمه من فضة ، % ودرعه من سبج % PageV01P243 البحر : سريع 1(@)(@@) % و ذات ناي مشرق وجهها ، % معشوقة الألحاظ والغنج % 2(@)(@@) % كأنما تلثم طفلا لها % % زنت به من ولد الزنج % PageV01P244 البحر : متقارب تام 1(@)(@@) % وسوداء ذات دلال غنج ، % لها في الفؤاد هوى يعتلج % % 2(@)(@@) % إذا أنت أبصرتها في النسا ، % ترى لعبة خرطت من سبج % % PageV01P245 البحر : وافر تام 1(@)(@@) % كأن البركة الغناء لما % % غدت بالماء مفعمة تموج % 2(@)(@@) % وقد لاح الدجى مرآة قين ، % قد انصقلت ومقبضها الخليج % PageV01P246 البحر : طويل 1(@)(@@) % ألا فاسقياني قهوة ذهبية ، % فقد ألبس الآفاق جنح الدجى دعج % % 2(@)(@@) % كأن الثريا ، والظلام يحفها ، % فصوص لجين قد أحاط به سبج % % PageV01P247 البحر : طويل 1(@)(@@) % كأن الثريا هودج فوق ناقة ، % يحث بها حاد إلى الغرب مزعج % 2(@)(@@) % و قد لمعت حتى كأن بريقها % % قوارير فيها زئبق يترجرج % PageV01P248(@)(@@)(@@)(@@) | البحر : وافر تام 1(@)(@@) % لمن دار ، وربع قد تعفى % % بنهر الكرخ مهجور النواحي % % 2(@)(@@) % إذا ما القطر حلاه تلاقت % على اطلاله هوج الرياح % 3(@)(@@) % محاه كل هطال ملح ، % بوبل مثل أفواه اللقاح % 4(@)(@@) % فبات بليل باكية ثكول ، % ضرير النجم ، متهم الصباح % 5(@)(@@) % وأسفر بعد ذلك عن سماء ، % كأن نجومها حدق الملاح % 6(@)(@@) % سقى أرضا 
ms47	 تحل بها سليمى ، % و لا سقى العواذل واللواحي % % 7(@)(@@) % مهفهفة لها نظر مريض ، % و أحشاء تضيع من الوشاح % 8(@)(@@) % وفتيان كهمك من أناس ، % خفاف في الهدو وفي الرواح % 9(@)(@@) % بعثتهم على سفر مهيب ، % فما ضربوا عليهم بالقداح % 10(@)(@@) % ولكن قربوا قلصا حثاثا ، % عواصف ، قد حنين من المراح % PageV01P249 11(@)(@@) % و كل مروع الحركات ناج ، % بأربعة تطير به نصاح % 12(@)(@@) % كأنا عند نهضته رفعنا % % خباء فوق أطراف الرماح % 13(@)(@@) % وقادوا كل سلهبة سبوح ، % كأن أديمها شرق براح % 14(@)(@@) % تخلف في وجوه الأرض رسما ، % كأفحوص القطا أو كالأداحي % % 15(@)(@@) % فكابدنا السرى ، حتى رأينا % % غراب الليل مقصوص الجناح % 16(@)(@@) % وقد لاحت لساريها الثريا ، % كأن نجومها نور الأقاح % 17(@)(@@) % وأعداء دلفت لهم بجمع % سريع الخطو في يوم الصياح % 18(@)(@@) % و كنا معشرا خلقوا كراما ، % نرى بذل النفوس من السماح % 19(@)(@@) % دعونا ظالمين ، فما ثكلنا ، % وجئنا ، فاقترعنا بالصفاح % 20(@)(@@) % وغاديناهم بالخيل شعثا ، % نثير النقع بالبلد المراح % % PageV01P250 21(@)(@@) % و بيض تأكل الأعمار أكلا ، % و تسقي الجانبين من الجماح % 22(@)(@@) % وفرسان يرون القتل غنما ، % فما لهم لديه من براح % 23(@)(@@) % رأونا آخذين بكل فج ، % بمشعلة توقد بالرماح % 24(@)(@@) % فعادوا بالغرارة أسلمتهم % % جرائرهم إلى الحين المتاح % 25(@)(@@) % قرينا بغيهم طعنا وجيعا ، % وضربا مثل أفواه اللقاح % 26(@)(@@) % نهني الرحل بالخيل المذاكي ، % وعزاب الفرائس بالنكاح % 27(@)(@@) % وى خى النار والنيران موتى % % مشهرة ، تبشر بالنجاح % 28(@)(@@) % ولا أخشى ، إذا أعطيت جهدي ، % و أحذر أن أكون من اشحاح % 29(@)(@@) % وأفردني من الإخوان علمي % % بهم ، فبقيت مهجور النواحي % % 30(@)(@@) % عمرت منازلي منهم زمانا ، % فما أدنى الفساد من الصلاح % PageV01P251 31(@)(@@) % إذا ما قل مالي قل مدحي ، % وإن أثريت عادوا في امتداحي % % 32(@)(@@) % و كم ذم لهم في جنب مدح ، % وجد بين أثناء المزاح % PageV01P252 البحر : طويل 1(@)(@@) % وآثار وصل في هواك حفظتها ، % تحيات ريحان وعضات تفاح % 2(@)(@@) % وكتب لطاف تربها المسك أدرجت % % على وصف أحزان وتعذيب أرواح % 3(@)(@@) % يخلن تعاويذا بجنبي ، كأنني % % أمس بخبل في مساي وإصباحي % % PageV01P253 البحر : بسيط تام 1(@)(@@) % ما زلت أطمع حتى قد 
ms48	 تبين لي % % جد من الخلف في ميعاد مزاح % 2(@)(@@) % ليلي ، كما شئت ، ليل لا انقضاء له ، % بخلت حتى على ليلي بإصباح % % PageV01P254 البحر : كامل تام 1(@)(@@) % يا شر ! هل للوعد من نجح ، % أم للذنوب لديك من صفح % 2(@)(@@) % ليست لها كبد ترق به ، % شهدت بذاك لطافة الكشح % 3(@)(@@) % هامت ركائبنا إليك ، فما % % يخبطن أهل النار والنبح % 4(@)(@@) % فكأن أيديهن لازمة ، % يفحصن ليلتهن عن صبح % PageV01P255 البحر : طويل 1(@)(@@) % ذعرت بقمري أغن ينوح ، % عشية رحنا والدموع سفوح % 2(@)(@@) % تفجع نحوي صوته ، % بدمعي ، وأنضاء المطي جنوح % PageV01P256 البحر : مديد تام 1(@)(@@) % عرف الدار ، فحيا وناحا ، % بعدما كان صحا واستراحا % % 2(@)(@@) % ظل يلحاه العذول ويأبى % % في عنان العذل إلا جماحا % % 3(@)(@@) % علموني كيف أسلو ، وإلا ، % فخذوا عن مقلتي الملاحا % % 4(@)(@@) % من رأى برقا يضيء التماحا ، % ثقب الليل سناه ، فلاحا % % 5(@)(@@) % فكأن البرق مصحف قار ، % فانطباقا مرة ، وانفتاحا % % 6(@)(@@) % في ركام ضاق بالماء ذرعا ، % حيثما مالت به الريح ساحا % % 7(@)(@@) % لم يزل يلمع بالليل حتى % % خلته نبه فيه صباحا % % 8(@)(@@) % وكأن الرعد فحل لقاح ، % كلما يعجبه البرق صاحا % % 9(@)(@@) % لم يدع أرضا من المحل إلا % جاد ، أو مد عليها جناحا % % 10(@)(@@) % و سقى أطلال هند ، فأضحت % % يمرح القطر عليها مراحا % % PageV01P257 11(@)(@@) % ديما في كل يوم ووبلا ، % واغتباقا للندى ، واصطباحا % % 12(@)(@@) % كل من ينأى من الناس عنها ، % فهو يرتاح إليها ارتياحا % % 13(@)(@@) % لا أرى مثلك ما عشت دارا ، % ربوة مخضرة ، أو بطاحا % % 14(@)(@@) % لو حللنا وسط جنة عدن ، % لاقترحناك عليها اقتراحا % % 15(@)(@@) % و إذا ما ذرت الشمس فيها ، % فتحت أعين روض ملاحا % % 16(@)(@@) % في ثرى كالمسك شيب براح ، % كلما أنبته القطر لاحا % % 17(@)(@@) % جمع الحق لنا في إمام ، % قتل البخل ، وأحيا السماحا % % 18(@)(@@) % ألف الهيجاء طفلا وكهلا ، % تحسب السيف عليه وشاحا % % 19(@)(@@) % و له من رأيه عزمات ، % وصل الله ضمنهن نجاحا % % 20(@)(@@) % يجعل الجيش إذا صار ذيلا ، % جرأة فيه ، وبأسا صراحا % % PageV01P258 21(@)(@@) % فرج الأعداء بالسلم منه ، % و هو في السلم يعد السلاحا % % 22(@)(@@) % فرقت أيديهم المال كرها ، % ولقد 
ms49	 كانوا عليها شحاحا % % 23(@)(@@) % خاط أفواههم ، وقديما % مزقوها ضحكا ومزاحا % % 24(@)(@@) % ووعوا شكري إليه ، وكانوا % % ملأوا دور الملوك نباحا % % 25(@)(@@) % أيقنوا منه بحرب عوان ، % ورجال يخضبون الرماحا % % 26(@)(@@) % و بخيل تأكل الأرض شدا ، % ملجمات يبتدرن الصياحا % % 27(@)(@@) % قاصدات كل شرق وغرب ، % ناطقات بالصهيل فصاحا % % 28(@)(@@) % حملت أسدا من الناس غلبا ، % و كباشا لا تمل النطاحا % % 29(@)(@@) % إن أغب عنك ، فما غاب شكر ، % دعوة جاهدة وامتداحا % % 30(@)(@@) % يا أمين الله أيدت ملكا ، % كان من قبلك نهبا مباحا % % PageV01P259 البحر : متقارب تام 1(@)(@@) % و أبقيت مني فتى مدنفا ، % لدمعته أبدا سافح % 2(@)(@@) % يعاني الطبيب إلى نفسه ، % و قال لمن عاد : يا صالح % PageV01P260 البحر : طويل 1(@)(@@) % تركت أخلاء كثيرا ذممتهم ، % و لكن خليلي لا أذم ابن صالح % 2(@)(@@) % شققت له صدري من السر إنه % % خزانة سر أعجزت كل فاتح % PageV01P261 البحر : متقارب تام 1(@)(@@) % لقد شد ملك بني هاشم ، % وأبدله بالفساد الصلاحا % % 2(@)(@@) % إمام أعاد الهدى عدله ، % ولاقى به المرتجون نجاحا % % 3(@)(@@) % تحور على الدهر أحكامه ، % ويأخذ ما شاء منه اقتراحا % % 4(@)(@@) % ورد عليا إلى قربه ، % كما رد باز إليه جناحا % % 5(@)(@@) % و ما زال يسهر من جده ، % ويتبعه الحزم ، حتى استراحا % % 6(@)(@@) % و يعفو ، ويصفح عن معشر ، % ويخضب من آخرين السلاحا % % 7(@)(@@) % ويجعل هامات أعدائه ، % قلانس يلبسهن الرماحا % % 8(@)(@@) % وكالليث شد على قرنه ، % وكالغيث جاد ، وكالبدر لاحا % % 9(@)(@@) % فرد على الملك أسلابه ، % وألبسه تاجه والوشاحا % % 10(@)(@@) % و أحسن في البذل والامتناع ، % وراش قداحا وعز اقتداحا % % PageV01P262 11(@)(@@) % وكم جاوز الحق في مشرف ، % فعد شحيحا ، وبارى الرياحا % % 12(@)(@@) % و قد طال شوقي إلى وجهه ، % وضاق بسري صبري ، فباحا % % 13(@)(@@) % وإني لمنتظر رأيه ، % كما انتظر العاشقون الصباحا % % PageV01P263 البحر : سريع 1(@)(@@) % إياك من ناس وأمثاله ، % فالعيش مع أمثاله يقبح % 2(@)(@@) % إذا تغنى رافعا صوته ، % حسبته سنورة تذبح % PageV01P264 البحر : سريع 1(@)(@@) % شربتها ، والديك لم ينتبه ، % سكران من نومته طافح % 2(@)(@@) % و لاحت الشعرى وجوزاؤها ، % كمثل زج جره رامح % PageV01P265 البحر : مجتث 1(@)(@@) % عودوا إلى الإصباح ، % لا ماء إلا براح % 2 
ms50	(@)(@@) % واعدوا إلى السكر عدوا ، % بالحث بالأقداح % 3(@)(@@) % ثم اسكتوا عن سوى الاس % % تحسان والأفراح % 4(@)(@@) % فإن خير هداها % % الأسماء للأرواح % PageV01P266 البحر : طويل 1(@)(@@) % لبسنا إلى الخمار ، والنجم غائر ، % غلالة ليل طرزت بصباح % 2(@)(@@) % وظلت تدير الراح أيدي جآذر ، % عتاق دنانير الوجوه ملاح % PageV01P267 البحر : بسيط تام 1(@)(@@) % طافت علينا بماء المزن والراح % معشوقة مزجت راحا بأرواح % 2(@)(@@) % مخلوقة بنعيم كلها بدع ، % كأن وجنتها باقات تفاح % PageV01P268 البحر : وافر تام 1(@)(@@) % خليلي اتزكا قول النصوح ، % وقوما ، فامزجا راحا بروح % 2(@)(@@) % فقد نشر الصباح رداء نور ، % وهبت بالندى أنفاس ريح % 3(@)(@@) % و حان ركوع أبريق لكاس ، % ونادى الديك حي على الصبوح % % 4(@)(@@) % وحن الناي من طرب وشوق ، % إلى وتر يجاوبه فصيح % 5(@)(@@) % هل الدنيا سوى هذا وهذا ، % و ساق لا يخالفنا مليح % PageV01P269 البحر : رجز تام 1(@)(@@) % و ليلة أحييتها بالراح ، % محسنة مسيئة الصباح % 2(@)(@@) % أهنت فيها سخط اللواحي ، % أكابر الأصوات بالأقداح % PageV01P270 البحر : وافر تام 1(@)(@@) % عناني صوت مسمعة وراح ، % فباكرني ، إذا بزغ الصباح % 2(@)(@@) % و معشوق الشمائل عسكري ، % له قتلى ، وليس له جراح % 3(@)(@@) % كأن الكأس في يده عروس ، % لها من لؤلؤ رطب وشاح % 4(@)(@@) % و قائلة : كتى يفنى هواه ؟ % فقلت لها : إذا فني الملاح % PageV01P271 البحر : مجزوء الرمل 1(@)(@@) % راح مطوي الحشا ، % غر حيا قد فرح % 2(@)(@@) % مغمدا في ليلة % لا ترى فيها صبح % 3(@)(@@) % يسم الأرض له % حافر مثل القدح % % 4(@)(@@) % تنفض الخيل به ، % و غذا عاصت سفح % % 5(@)(@@) % و تراه كلما % % عرفت منه طفح % 6(@)(@@) % ليس يدري موعدي ، % أي دار قد فتح % 7(@)(@@) % لك منه صارم ، % كلما خفت نصح % 8(@)(@@) % و لها سهم ، إذا % % قرح الصرح قدح % % 9(@)(@@) % و سنان كلما % % هز في الروع ذبح % 10(@)(@@) % فتراه كلما % % هز نابين كلح % PageV01P272 11(@)(@@) % ضاحكا من الأسى ، % باكيا من الفرح % % PageV01P273 البحر : رجز تام 1(@)(@@) % قد اغتدى في نفس الصباح ، % يقوم للصيد أخا ارتياح % 2(@)(@@) % معلق الألحاظ بالوشاح ، % يركض في الهواء بالجناح % 3(@)(@@) % كركض طرف السبق في المراح ، % ذي جلجل كالفرض في الصفاح % % 4(@)(@@) % يستن 
ms51	 في الغدران والضحضاح % . . . . . . . . . . . . . . . . % PageV01P274 البحر : خفيف تام 1(@)(@@) % و جنود رميتهم بحريق % يتلظى ، إذا أحس بريح % 2(@)(@@) % قرت العين ، إذ رأتهم سقوطا ، % كيسار من الصنيع المليح % 3(@)(@@) % طالما قد حموا علي دياري ، % ونفوني عن طيب ريح السطوح % % PageV01P275 البحر : وافر تام 1(@)(@@) % كأني حين ترتحل المطايا ، % على فيحاء ناشرة جناحا % % 2(@)(@@) % لبحر تقصر الألحاظ عنه ، % بعيد الماء يبلع الرواحا % % PageV01P276 البحر : وافر تام 1(@)(@@) % و موقرة بثقل الماء جاءت % % تهادى فوق أعناق الرياح % 2(@)(@@) % فجاءت ليلها سحا ووبلا ، % وهطلا مثل أفواه الجراح % 3(@)(@@) % كأن سماءها لما تجلت % % خلال نجومها عند الصباح % 4(@)(@@) % رياض بنفسج خضل نداه ، % تفتح بينه نور الأقاحي % % PageV01P277 البحر : خفيف تام 1(@)(@@) % بأبي ما يجن منك الضريح ، % طبت ذكرا وطاب جسم وريح % 2(@)(@@) % كنت ما كنت لي فمت برغمي ، % ليتني مت أنا ، وأنت صحيح % 3(@)(@@) % هجرت قبره ، فقامت مواثي % % ق العلى والنهى عليه تنوح % PageV01P278 البحر : طويل 1(@)(@@) % لقد صاح بالبين الحمام النوائح ، % وهاجت لك الشوق الحمول الروائح % 2(@)(@@) % حللنا الحمى حتى انمحت نبهة الندى ، % و سارت بأخبار المصيف البوارح % 3(@)(@@) % رمتني بلحظ فعله الموت ، واصل % إلى النفس لا تنأى عليه المطارح % 4(@)(@@) % كلحظة باز صائد ، قبل كفه ، % بمقلته ، والطير عنه بوارح % 5(@)(@@) % لنا وفرة ما وفرتها دماؤنا ، % ولا ذعرتها في الصباح الصوابح % 6(@)(@@) % تقسمهن الحرب إلا بقية ، % ترد علينا حين تخشى الجوائح % 7(@)(@@) % إذا غدرت ألبانها بضيوفنا ، % وفت للقرى جيرانها والصفايح % 8(@)(@@) % و قيدها بالنصل خرق ، كأنه % % إذ جد ، لولا ما جنى السيف ، مازح % 9(@)(@@) % كأن أكف القوم ، في جنباته ، % قطا لم ينفره عن الماء سارح % 10(@)(@@) % و قدم للأضياف فوهاء لم تزل % % تجاهر غيظا كلما راح رائح % PageV01P279 11(@)(@@) % كأن بنات الغلي في حجراتها % % إذا ما انجلت أفلاء خيل روائح % 12(@)(@@) % وكم حضر الهيجاء في ناصح الشظا % % تكامل في أسنانه ، فهو قارح % 13(@)(@@) % له عنق يغتال طول عنانه ، % و صدر ، إذا أعطيته الجري ، سابح % 14(@)(@@) % إذا مال في أعطافه قلت شارب % عناه بتصريف المدامة صابح % 15(@)(@@) % أبى الموت أن تخشى شريرة 
ms52	 حله ، % لعل الذي تخشى شريرة صالح % % 16(@)(@@) % فإن مت ، فانعيني إلى المجد والتقى ، % و لا تسكبي دمعا ، إذا قام نائح % 17(@)(@@) % وقولي : هوى عرش المكارم والعلى ، % و عطل ميزان من العلم راجح % 18(@)(@@) % فما يخلق الثوب الجديد ابتذاله ، % كما يخلق المرء العيون اللوامح % % PageV01P280 البحر : خفيف تام 1(@)(@@) % حلية الشيب في عذاري تلوح ، % وفؤادي في الغي بعد جموح % 2(@)(@@) % قبحت شية المشيب كما أ % % ن الخضاب الكميت أيضا قبيح % 3(@)(@@) % ذا شباب ملفق ليس يخفى ، % و مضى ذلك الشباب الصحيح % PageV01P281 البحر : خفيف تام 1(@)(@@) % فتنت قلبك العيون الملاح ، % واغتباق بقهوة واصطباح % 2(@)(@@) % و قدود كأنهن غصون ، % و خدود كأنها التفاح % 3(@)(@@) % أنت في الأربعين مثلك في العش % % رين ، قل لي متى يكون الفلاح ؟ % PageV01P282 البحر : بسيط تام 1(@)(@@) % بان الشباب ، وفيه اللهو والفرح ، % وأقبل الشيب فيه الهم والترح % 2(@)(@@) % فعد ذكر الصبا واهجر لذاذته ، % و اسوءتا من بياض فوقه قدح % PageV01P283(@)(@@)(@@)(@@) | (@)(@@) البحر : بسيط تام 1(@)(@@) % يا مدخل الصلع حماما يزيدهم % بطول مكثهم في جوفه وسخا % % 2(@)(@@) % حتى إذا عرقوا من حره شرعوا ، % و كلهم بخلوف منه قد لطخا % % PageV01P284 البحر : رجز تام 1(@)(@@) % تخالهم أسوار جيش أبلخا ، % أو معهم جود يزين وسخا % % 2(@)(@@) % تمت بهم حال لهم مثل الرخا ، % أخاف طير أرضه ودوخا % % 3(@)(@@) % يعجلها في مائها إن رسخا ، % حكم فيه منسرا مضمخا % % 4(@)(@@) % ومخلبا بدمها ملطخا ، % عوائذا من خطفه وصرخا % % 5(@)(@@) % كأنه لما قطعنا فرسخا ، % مصحف وراق أدق نسخا % % PageV01P285 (@)(@@)(@@)(@@) | (@)(@@) البحر : خفيف تام 1(@)(@@) % طار نومي ، وعاود القلب عيد ، % و ابى لي الرقاد حزن شديد % 2(@)(@@) % جل ما بي ، وقل صبري ، ففي قل % % بي جراح ، وحشو جفني السهود % 3(@)(@@) % سهر يفتق الجفون ، ونيرا % % ن تلظى ، قلبي لهن وقود % 4(@)(@@) % لامني صاحبي ، وقلبي عميد ، % أين مما يريده ما أريد % 5(@)(@@) % شيبتني ، وما يشيبني الس % ن ، هموم تترى ، ودهر مريد % 6(@)(@@) % فتراني مثل الصحيفة قد أخ % لصها عند صقلها ترديد % 7(@)(@@) % أين إخواني الألى كنت أصفي % % هم ودادى ، وكلهم لي ودود % 8(@)(@@) % شردتهم كف الحوادث والأي 
ms53	 % ام من بعد جمعهم تشريد % 9(@)(@@) % فلقد أصبحوا ، وأصبحت منهم % % كلحاء استل منه العود % 10(@)(@@) % هل لدنيا قد أقبلت نحونا ده % % را فصدت ، ليس منا صدود % PageV01P286 11(@)(@@) % من معاد أم لا معاد لدينا ، % فاسل عنها فكل شيء يبيد % 12(@)(@@) % ربما طاف بالمدام علينا % % عسكري كغصن بان يميد % 13(@)(@@) % أكرع الكرعة الروية في الكأ % % س ، وطرفي بطرفه معقود % 14(@)(@@) % أيها السائلي عن الحسب الأط % % يب ما فوقه لخلق مزيد % 15(@)(@@) % نحن آل الرسول ، والعترة الح % % ق وأهل القربى ، فماذا تريد % 16(@)(@@) % و لنا ما أضاء صبح عليه ، % وأتته آيات ليل سود % 17(@)(@@) % وملكنا رق الإمامة ميرا % % ثا ، فمن ذا عنا بفخر يحيد % 18(@)(@@) % و أبونا حامي النبي ، وقد أد % % بر من تعلمون ، وهو يذود % 19(@)(@@) % ذاك يوم استطار بالجمع ردع % في حنين ، وللوطيس وقود % 20(@)(@@) % كان فيهم منا المكاتم إيما % % نا ، وفرعون غافل والجنود % PageV01P287 21(@)(@@) % رسل القوم حين لدوا جميعا ، % غيره ، كيف فضل الملدود % PageV01P288 البحر : طويل 1(@)(@@) % سرى ليلة حتى أضاء عمودها ، % و اية سوق شوقها لا يعودها % % 2(@)(@@) % و سار مسير الشمس لم تبق بلدة % من الأرض إلا نحو أخرى يريدها % % 3(@)(@@) % و شيعه قلب جري جنانه ، % و نفس كأن الحادثات عبيدها % % 4(@)(@@) % خليلي ! هذي دار شرة ، فاسألا % % مغانيها ، لو كان ذاك يعيدها % % 5(@)(@@) % خلت وعفت إلا أثاف كأنها % % عوائد ذي سقم بطيء قعودها % % 6(@)(@@) % و حرب لو ان الله يرمي بجمرها % % شماريخ رضوى زلزلتها جنودها % % 7(@)(@@) % يسعرها أبطالها بصوارم ، % ويفلق بيضات الحديد حديدها % % 8(@)(@@) % ومصقولة الأطراف حمر كعوبها ، % سريع إلى نفس الكمي ورودها % % 9(@)(@@) % شهدت ، فأوطأت الخيول كأنها % % مفلقة الهامات ، حمر جلودها % % 10(@)(@@) % بعسكر أبطال تبيت كماته ، % وإن نزحت عنه ، قليلا هجودها % % PageV01P289 11(@)(@@) % وليل يود المصطلون بناره ، % لو انهم حتى الصباح وقودها % % 12(@)(@@) % يقيم ببيض المشرفيات والقنا % % وراثة مجد قد حمتها جدودها % % 13(@)(@@) % إذا لبسوا من ذا الحديد غلائلا ، % وهزوا رماح الخط حمرا عقودها % % 14(@)(@@) % هناك تلاقي الصبر ضنكا طريقه ، % و جند المنايا شارعات بنودها % % PageV01P290 البحر : مجزوء الرمل 1 
ms54	(@)(@@) % راح فراق ، أو غدا ، % لست بباق أبدا % % 2(@)(@@) % كم لك من أحبة % ماتوا فصاروا بددا % % 3(@)(@@) % لا تخدعن ، فإنما % % كوالد من ولدا % % 4(@)(@@) % من سار كل ساعة % أوشك به أن يردا % % 5(@)(@@) % يا باغي الشر لنا ! % أردد عن الظلم يدا % % 6(@)(@@) % لئن غلبنا عددا ، % لقد غلبنا عددا % % PageV01P291 البحر : منسرح 1(@)(@@) % وقد ألاقي بأس العداة على % % طرف بقضب كالنار تتقد % 2(@)(@@) % أو عاسل كالشجاع هاج لي النف % % س ، ودرع كأنها الزبد % 3(@)(@@) % و نبعة لا يفوت هاربها ، % وقارح بعد شدة يعد % 4(@)(@@) % تحثه نفسه إذا حثت الخي % % ل ، وطارت رجل به ويد % PageV01P292 البحر : مجزوء الرجز 1(@)(@@) % مل سقامي عوده ، % و خان دمعي مسعده % 2(@)(@@) % و ضاع من ليلي غده ، % طوبى لعين تجده % % 3(@)(@@) % غلت من الدهر يده ، % قتالة من تلده % % 4(@)(@@) % يفنى ، فيبقى أبده ، % و الموت ضار أسده % % 5(@)(@@) % يا من عناني حسده ، % يقيمه ، ويقعده % % 6(@)(@@) % فإنه في حلقه % طعم شجا يردده % % 7(@)(@@) % سهرت ليلا أرقده ، % حظ الحسود كمده % % 8(@)(@@) % قالوا : قليلا عدده ، % من غش قل ولده % % PageV01P293 البحر : كامل تام 1(@)(@@) % لما ظننت فراقهم لم أرقد ، % وهلكت إن صح التظنن أو قد % 2(@)(@@) % ما زلت أرعى كل نجم غاير ، % و كأن جنبي فوق جمر موقد % 3(@)(@@) % و رنا إلي الفرقدان كما رنت % زرقاء تنظر من نقاب أسود % 4(@)(@@) % والنسر قد بسط الجناح محوما ، % حتى القيامة طالبا لم يصطد % % 5(@)(@@) % و ترى الثريا في السماء كأنها % % بيض بأدحي يلوح بفدفد % 6(@)(@@) % سلقتهم زفرات قلب محرق ، % و سجال دمع بالدماء مورد % 7(@)(@@) % ما أسرع التفريق إن عزموا غدا ، % لا شك أن غدا قريب الموعد % 8(@)(@@) % وجرت لنا سنحا جآذر رملة ، % تتلو المها ، كاللؤلؤ المتبدد % % 9(@)(@@) % قد أطلعت إبر القرون كأنها % % أخذ المراود من سحيق الإثمد % 10(@)(@@) % رخصات أطراف تظل لواعبا ، % لا تهتدي طورا ، وطورا تهتدي % % PageV01P294 11(@)(@@) % أشباه آنسة الحديث خريدة ، % كالشمس لاقتها نجوم الأسعد % 12(@)(@@) % كم قد خلوت بها ، وثالثنا التقى ، % يحمي على العطشان برد المورد % 13(@)(@@) % يا آل عباس لعا من عثرة 
ms55	 ، % لا تركنن إلى الغواة الحسد % 14(@)(@@) % إياكم من بعدها إياكم ، % كونوا لها كأراقم في مرصد % 15(@)(@@) % وخذوا نصائح حارم متعصب % بالشيب ، مجتمع النهى ، متأسد % 16(@)(@@) % كالطود يعدي حلمة سفهاؤه ، % لا ينطقون سوى الجواب ، ويبتدي % % 17(@)(@@) % شدوا أكفكم على ميراثكم ، % فالحق أعطاكم خلافة أحمد % 18(@)(@@) % و متى يرمها الرائمون فبادروا % % هاماتهم حصدا بكل مهند % 19(@)(@@) % قودوا لهم قود الجياد شواذبا ، % لا يهتدون إلى الطريق الأبعد % 20(@)(@@) % من كل أحوى ، أو بهيم مصمت ، % ومشمر عن كل ساق ، أو يد % PageV01P295 21(@)(@@) % طورا مجاهرة ، وطورا غيلة ، % كم قاتل بغرار كيد مغمد % 22(@)(@@) % هذا هو النصح ، وربما % % محض النصيحة صاحب لم يجهد % PageV01P296 البحر : بسيط تام 1(@)(@@) % اشكو إلى الله أن الدمع قد نفدا ، % وأنني هالك من حبكم كمدا % % 2(@)(@@) % و أن عيني ، في ليل ، مسهدة ، % فلست أرقد فيه مثل من رقدا % % 3(@)(@@) % قالوا : الفراق غدا لا شك ، قلت لهم : % بل موت نفسي من قبل الفراق غدا % % 4(@)(@@) % إني إذا لصبور ، إن بقيت ، وقد % % قالوا : الرحيل ، وإن لم يرحلوا أبدا % PageV01P297 البحر : وافر تام 1(@)(@@) % أرد الطرف من حذري عليه ، % وأمنحه التجنب ، والصدودا % % 2(@)(@@) % و أرصد غفلة الرقباء عنه ، % لتسرق مقلتي نظرا جديدا % % PageV01P298 البحر : كامل تام 1(@)(@@) % يا صاحبي عصيت ذا فند ، % و أطعت كأس مدامتي بيدي % % 2(@)(@@) % و لقيت عيارا ، فجرحني ، % وقعت خناجره على كبدي % % 3(@)(@@) % و الله ما أدري أواحدة % صليت أم ثنتين في العدد % PageV01P299 البحر : مخلع البسيط 1(@)(@@) % مات وصال ، وعاش صد ، % وذل مولى ، وعز عبد % 2(@)(@@) % يا أحسن العالمين وجها ، % ما لك من أن تحب بد % 3(@)(@@) % ما العيش إلا كأس وساق ، % وكل ما بعد ذين فقد % PageV01P300 البحر : طويل 1(@)(@@) % كأن فؤادي في مخاليب طائر ، % غدا صبح يوم ثم بات على فقد % 2(@)(@@) % إذا ما أراد الصيد جلى لنهضة ، % وهز جناحيه كحاشيتي برد % 3(@)(@@) % فضم مخاليبا عليه كأنها % % شصوص حبال قد جمعن إلى عقد % % PageV01P301 البحر : طويل 1(@)(@@) % و غزلان إنس قد طرقت بسدفة ، % فلم تكتحل أجفانهم برقاد % 2(@)(@@) % يقلن لنا : يا ليت ذا 
ms56	 الليل سرمدا % علينا ، ولا نخشى عيون أعاد % 3(@)(@@) % فؤادي مشغوف ، وسيفي صارم ، % فهذا لإبعادي ، وذا لسعاد % PageV01P302 البحر : طويل 1(@)(@@) % أعلق قلبي بالأحاديث بعدكم ، % و أصرف لحظي عن محدثه عمدا % % 2(@)(@@) % وأسأله رد الأحاديث عله % سؤال ، وأخفي دمعة تفضح الوجدا % % PageV01P303 البحر : خفيف تام 1(@)(@@) % يا نسيم الرياح من بلدي ، % إن لم تفرج همي ، فلا ترد % 2(@)(@@) % أبيت ، والشوق في الفراش معي ، % يكحل عيني بمرود السهد % 3(@)(@@) % معترفا بالشوق مكتئبا ، % أشكو إلى الله لا إلى أحد % 4(@)(@@) % صبا يرى آخر الحياة ، ولا % % يطمع في راحة ة لا خلد % PageV01P304 البحر : منسرح 1(@)(@@) % أخطأت يا دهر في تفرقنا ، % ويحك تب بعدها ، ولا تعد % 2(@)(@@) % يا شر بالله أخري أجلي ، % لا تقتليني بالهم والكمد % 3(@)(@@) % ما لي أرى الليل لا صباح له ، % ما الهجر إلا ليل بغير غد % 4(@)(@@) % يا جامع الهجر والفراق ألا % % تجمع بين الفؤاد والجسد % PageV01P305 البحر : طويل 1(@)(@@) % ومن حسرة الدنيا هواك لباخل % بعيد من العتبى ضنين بموعد % 2(@)(@@) % يجيء مجيء الفيء ، كل عشية ، % ويرجع لا يعطي بقول ولا يد % PageV01P306 البحر : خفيف تام 1(@)(@@) % ليت يومي بنهر فروخ عادا ، % فلقد طاب لي ، وسر ، وزادا % % 2(@)(@@) % عفت الحادثات عنه ، وأعطت % % نا صنوف اللذات فيه القيادا % % 3(@)(@@) % و عدونا على الجياد ، وما حو % % بيت الخيل إذ تسمى جيادا % % 4(@)(@@) % معطيات رؤوسهن ، إذا شئ % ن ، وقوفا تخالها أوتادا % % 5(@)(@@) % وإذا حثها الركاب ، أو السو % % ط أطارت أرواحها الأجسادا % % 6(@)(@@) % ونخال الحصى ، إذا ما عدت ، نح % % لا أطيرت من تحتها أو جرادا % % 7(@)(@@) % مرحات يحملن فتيان لهو ، % لا يطيعون ، في الهوى ، فنادا % % 8(@)(@@) % حذقوا لذة الحياة ، وأغرى % % جودهم دهرهم فصار جوادا % % 9(@)(@@) % قل لشر : بالله يا هم نفسي % % زوديني ، قبل الحوادث ، زادا % % 10(@)(@@) % قد شكا الوعد منك حبسا طويلا ، % فاحللي عنه ، يا شرير ، الصفادا % % PageV01P307 11(@)(@@) % أنت لا تحسنين وعدك هذا ، % كل من شاء أخلف الميعادا % % 12(@)(@@) % ليس كل العشاق صبا ، ولكن % % ذا حسام يقطع الأكبادا % % 13(@)(@@) % رب يوم أحييته بزفير ، % وهموم تكوي الحشا والفؤادا % % 14(@)(@@) % بات 
ms57	 طرفي يشيع النجم فيه ، % كلما خلته يسير تمادى % % PageV01P308 البحر : سريع 1(@)(@@) % ما أقصر الليل على الراقد ، % و أهون السقم على العائد % 2(@)(@@) % يفديك ما أبقيت من مهجتي ، % لست لما أوليت بالجاحد % PageV01P309 البحر : بسيط تام 1(@)(@@) % ألا ترى يا صاح ما حل بي ، % من ظالم في حكمه معتد % 2(@)(@@) % يقول للقلب ، غذا ما خلا : % يا قلب قم ، واطلب ، ولا تقعد % 3(@)(@@) % كم من فسوق في كلام له ، % و غمزة مكتومة باليد % 4(@)(@@) % و لحظة أسرع من تهمة ، % تخيب من يسأل ، أو يبتدي % % 5(@)(@@) % يا موسم العشاق قل لي متى % % تخلو من الغائر والمنجد % 6(@)(@@) % يا مقمرا في الشعر الأسود ، % و ضاحكا ، أو حلت عن موعدي % % PageV01P310 البحر : منسرح 1(@)(@@) % جعلت عقلي لشهوتي عبدا ، % وصار غيي عند الهوى رشدا % % 2(@)(@@) % وصادني شادن كلفت به ، % فدته نفسي ، ومثله يفدى % % 3(@)(@@) % حين درى ما الهوى ، وأحسنت الأل % % حاظ منه الوعيد والوعدا % % 4(@)(@@) % غدرت شوقي إليه حين بدا ، % ولمت حبي إليه ، إذ صدا % % PageV01P311 البحر : بسيط تام 1(@)(@@) % لا تلق إلا بليل من تواصله ، % فالشمس نمامة ، والليل قواد % 2(@)(@@) % كم عاشق وظلام الليل يستره ، % لاقى أحبته ، والناس رقاد % PageV01P312 البحر : خفيف تام 1(@)(@@) % بأبي هل ملأت عينا بشيء ، % هو أسلاك ، يا حبيبي ، بعدي % % 2(@)(@@) % طعم كأسي مر ، إذا لم تزرني ، % وهو يحلو ، إذا رأيتك عندي % % PageV01P313 البحر : طويل 1(@)(@@) % و مستنصر يزهى بخضرة شارب ، % و فترة أجفان ، وخد مورد % 2(@)(@@) % كأن عذاريه على قمر على % % قضيب على دعص رطيب الثرى ندي % % 3(@)(@@) % تبسم ، إذ مازحته ، فكأنه % يكشف عن در حجاب زمرد % PageV01P314 البحر : كامل تام 1(@)(@@) % يا من يجود بموعد من حظه ، % ويصد ، حين أقول : أين الموعد ؟ % 2(@)(@@) % ويظل صباغ الحياء بخده ، % تعبا ، يعصفر تارة ويورد % 3(@)(@@) % ماذا يضرك لو رثيت لعاشق ، % قلق يقوم به هواك ويقعد % 4(@)(@@) % تجد العيون رقادها ، ورقاده ، % حتى الصباح ، مسرة لا توجد % 5(@)(@@) % وله ، إذا ما قصر الليل الكرى ، % ليل طويل العمر ليس له يد % PageV01P315 البحر : رمل تام 1(@)(@@) % كيف أمسيت من الهجر ، فإني % % منك 
ms58	 قد أمسيت في جهد جهيد % 2(@)(@@) % عد إلى الوصل ، فإني عائد ، % قد بدا لي قد بدا لي في الصعود % 3(@)(@@) % أهلكت ديني بدور طالعات % في دجى الشعر ، وورد في خدود % 4(@)(@@) % و ارتواء من مدام في شفاه ، % و اعتناق لغصون من قدود % PageV01P316 البحر : رمل تام 1(@)(@@) % قد حمى غصن النقا أسده ، % ريقه عذب ، ومن يرده % 2(@)(@@) % مشرب طابت مشارعه ، % جامدا في خمرة برده % 3(@)(@@) % هو سقمي حين أفقده ، % وشفاء السقم لو أجده % PageV01P317 البحر : متقارب تام 1(@)(@@) % شفاني الخيال ، بلا حمده ، % وأبدلني الوصل من صده % % 2(@)(@@) % و كم نومة لي قوادة ، % أتت بالحبيب على بعده % % PageV01P318 البحر : متقارب تام 1(@)(@@) % مضيت ، فكم دمعة لي علي % % ك تجري ، وكم نفس يصعد % 2(@)(@@) % وجئت ، فحبي ذاك الذي % % عهدت ، كما هو لا ينفد % 3(@)(@@) % فهل لك في أن تعيد الوصا % % ل ، فالعود أحمد ، يا أحمد % PageV01P319 البحر : سريع 1(@)(@@) % و فاحم مال على الخد ، % مثل العناقيد على الورد % 2(@)(@@) % وصولجان الصدغ مستمكن % للضرب من تفاحة الخد % PageV01P320 البحر : خفيف تام 1(@)(@@) % أيا حياتي طوبى لمن يردك ، % حماك عني العدا فما أجدك % % 2(@)(@@) % قدك غصن لا شك فيه ، كما % % وجهك شمس نهارها جسدك % % PageV01P321 البحر : رمل تام 1(@)(@@) % أين عنك الشمس ، يا ليل الصدود ، % عندي الصبر ، فقل : هل من مزيد % 2(@)(@@) % ويح من يهوى ، فقد عذبه ال % % له في الدنيا بتبعيد شديد % PageV01P322 البحر : بسيط تام 1(@)(@@) % يا أيها الراكب المستعجل الغادي ، % إقر السلام على يعقوب بالوادي % % 2(@)(@@) % وقل له الحقه قد خلفته دنفا ، % يمج آخر عهد بين عواد % 3(@)(@@) % يا حبذا الدهر ، إذ نسقى مسرته % % صرفا ، ونمزج إنجازا بميعاد % PageV01P323 البحر : - - 1(@)(@@) % لم تبلغني السعادة ، بعد ، % قبلة ، إنما وصالي وعد % 2(@)(@@) % مخلف يخطف القلوب بطرف % عازم ، ما له من الغدر بد % PageV01P324 البحر : خفيف تام 1(@)(@@) % أنا بين الهوى وبين التجني % % في شقاء ، وفي عذاب شديد % 2(@)(@@) % لست أدعو على عدوي إلا % بفراق ، من بعد ذا ، وصدود % % PageV01P325 البحر : خفيف تام 1(@)(@@) % ليت شعري ! أفي المنام أرى ذا ؛ % قمر زارني على غير 
ms59	 وعد % 2(@)(@@) % صار ترب الصراة مسكا ، وكافو % % را حصاها ، وماؤها ماء ورد % PageV01P326 البحر : بسيط تام 1(@)(@@) % رأيته يتمشى متعبا ضجرا ، % كمثل غصن نقا في الروض أملود % 2(@)(@@) % ليت الغبار الذي يؤذيه لي كحل ، % وليتني جاره في زحمة العيد % PageV01P327 البحر : طويل 1(@)(@@) % قليل ، على ظهر الفراش ، رقاده ، % إذا اكتحلت أجفاننا برقاد % 2(@)(@@) % و بيضاء من نعماك لما جحدتها ، % أبيت بحمراء القميص تنادي % % PageV01P328 البحر : كامل تام 1(@)(@@) % سهل المواهب لا تقاتل نفسه % % عن ماله حتى يقال جواد % 2(@)(@@) % لكنه سمح الضمائر سابق % بالزاد حين يعلل الأزواد % 3(@)(@@) % عذب الخلائق كلما جربته % % فيما تحب رأيته يزداد % PageV01P329 البحر : كامل تام 1(@)(@@) % عاد السرور إليك في الأعياد ، % و سعدت من دنياك بالإسعاد % 2(@)(@@) % و قضاء شكر ربما حملته % رفقا ، فقد أثقلته بأياد % 3(@)(@@) % قاد النفوسمهابة ومحبة ، % بدر بدا متعمما بسواد % 4(@)(@@) % ما إن أرى شبها له ، فيما أرى ، % أم الكرام قليلة الأولاد % PageV01P330 البحر : خفيف تام 1(@)(@@) % يا حادي الأظعان أين تريد ، % إني بمن تحدو به لكميد % 2(@)(@@) % قامت تودعني ، كغصن ناعم ، % ضربته كف الريح ، فهو يميد % 3(@)(@@) % فوضعت وجدي بالتنفس والبكا ، % ورأيت ماء المزن كيف يجود % 4(@)(@@) % بالمكتفي كفي الأنام همومهم ، % وغدا عليهم طالع مسعود % 5(@)(@@) % جاؤوك يحشرهم إليك محبة ، % طوعا ، وسيفك عنهم مغمود % 6(@)(@@) % ولطالما ظمئت إليك نفوسهم ، % و طريق بابك عنهم مسدود % 7(@)(@@) % فالآن أعتبهم بملكك دهرهم ، % و حلا ، ولان العيش ، وهو شدسد % 8(@)(@@) % يد حاتم كبنانه لشماله ، % ما حاتم مع مثله معدود % 9(@)(@@) % لو ظل يملك حاتما أعطاكه ، % هبة ، ولم ير أن ذلك جود % 10(@)(@@) % في كل كف منه خمسة أبحر ، % يسقي الحوائم ماؤها المورود % PageV01P331 11(@)(@@) % سرت بوطأته المنابر ، إذ علا % % درجاتها ، واخضر منها العود % 12(@)(@@) % فكأنه قمر سرى في ليلة ، % فظلامها عن نورها مردود % 13(@)(@@) % ماض على العزمات ينصر رأيه ، % من ربه التوفيق ، والتسديد % 14(@)(@@) % لما رأوا أسد الحروب ، وفوقهم % % شحجر القنا ، وثمارهن حديد % 15(@)(@@) % وقد انتضوا هندية مصقولة % بيضا ، وجوه الموت فيها سود % 16(@)(@@) % أخفوا ندامتهم ، وعجل حينهم % % ضرب وطعن 
ms60	 ليس عنه محيد % 17(@)(@@) % فاشدد يديك على عنان خلافة ، % لك إرثها ، وبقاؤها الممدود % PageV01P332 البحر : مجزوء الرمل 1(@)(@@) % لا ورمان النهود ، % فوق أغصان القدود % 2(@)(@@) % وعناقيد من الصد % % غ ، ورد من خدود % 3(@)(@@) % ووجوه من بدور % طالعات من سعود % 4(@)(@@) % ورسول جاء بالميعا % % د من بعد الوعيد % 5(@)(@@) % ونعيم في وصال ، % حل من طول الصدود % 6(@)(@@) % ما رأت عيني كظبي ، % زارني في يوم عيد % 7(@)(@@) % في قباء فاختي الل % ون من لبس جديد % 8(@)(@@) % كلما قاتل جن % % دي بسيف ، أو عمود % 9(@)(@@) % قاتل الناس بعيني % % ن ، وخدين وجيد % 10(@)(@@) % قد سقاني الراح من % % فيه على رغم الحسود % PageV01P333 11(@)(@@) % وتعانقنا ، كأني % % وهو في عقد شديد % 12(@)(@@) % نقرع الثغر بثغر % طيب عند الورود % 13(@)(@@) % مثل ما عاجل برد % قطر مزن بجمود % 14(@)(@@) % ومضى يخطر في المش % ي كجبار عنيد % 15(@)(@@) % سحرا من قبل أن % % ترجع أرواح الرقود % 16(@)(@@) % مرحبا بالملك ال % % قادم بالجد السعيد % 17(@)(@@) % عش ، ودم في ظل عز ، % خالد ، باق ، جديد % 18(@)(@@) % فلقد أصبح أعدا % % ؤك كالزرع الحصيد % 19(@)(@@) % ثم قد صاروا حديثا ، % مثل عاد في ثمود % 20(@)(@@) % جاءهم بحر حديد ، % تحت أظلال بنود % PageV01P334 21(@)(@@) % فيه عقبان خيول % فوقها أسد حديد % 22(@)(@@) % وردوا الحرب ، فمدوا % % كل خطي مديد % 23(@)(@@) % و حسام سره الح % % د إلى قطع الوريد % 24(@)(@@) % ما لهذا الفتح يا % % خير إمام من مزيد % 25(@)(@@) % فاحمد الله ، فإن ال % % حمد مفتاح المزيد % PageV01P335 البحر : مجزوء الكامل 1(@)(@@) % لله در معاشر % غلبوا العدو كما أراد % 2(@)(@@) % نصرتهم أيديهم ، % والمشرفيات الحداد % 3(@)(@@) % ما كان غير وعيدهم ، % فهزمته ركض الجواد % PageV01P336 البحر : مجزوء الرجز 1(@)(@@) % دعه وما قال ، فما % % يزرع يوما يحصده % 2(@)(@@) % غدا ترى فعلي به ، % إن شاء من لا يعبده % PageV01P337 البحر : مجزوء الكامل 1(@)(@@) % كم تائه بولاية ، % و بعذله يعدو البريد % 2(@)(@@) % سكر الولاية طيب ، % و خمارها صعب شديد % PageV01P338 البحر : مجتث 1(@)(@@) % يا من يبعد وعدي ، % أطلت مطلي وكدي % % 2(@)(@@) % خلقت ، لا شك عندي ، % من فضل طينة قرد % PageV01P339 البحر : سريع 1(@)(@@) % و 