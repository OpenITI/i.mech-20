ms401	 % % 2(@)(@@) % سأروي له من سيرة المدح سيرة % فما زلت أروي سيرة ابن هاشم % % PageV01P1813 البحر : - 1(@)(@@) % أياسيدي انني قد عييت % % عن أن أشابه أهل الكرم % % 2(@)(@@) % فأرسلته مثل نهد الشباب % % وودي لو كان مثل الهرم % % PageV01P1814 البحر : - 1(@)(@@) % تشبهت بالغدران والروض حولها % % فأصبحت ملهى الناظر المتوسم % % 2(@)(@@) % وأنبت بالتطعيم أشجار فضة % % ومن أحسن الأشجار كل مطعم % % PageV01P1815 البحر : - 1(@)(@@) % مولاي مااسم لنا حل دنف % % وما به لا أذى ولا سقم % % 2(@)(@@) % لسان قوم فان حذفت وان % % صحفت بعض الحروف فهو فم % % PageV01P1816 البحر : - 1(@)(@@) % نشرت لك الأعراب فيما طويته % % من الود يا أوفى الانام ذماما % % 2(@)(@@) % وأمسكت من ودي لعلياك عروة % وأهديت للطرف الكريم حزاما % % PageV01P1817 البحر : - 1(@)(@@) % جفاني الفلان لأن ظني % % بتلك الهدية أبغي مراما % % 2(@)(@@) % فمن أجلها كف رجع الكلام % % وكانت حزاما فأضحت لجاما % % PageV01P1818 البحر : - 1(@)(@@) % أمولاي شمس العلى قد ظهر % % ت لآل الفلان بمجد صميم % % 2(@)(@@) % وصفرت تصفير تحبيبهم % % فكنت شميسهم من قديم % % PageV01P1819 البحر : - 1(@)(@@) % أتاني بأمثال النجوم زواهرا % % ندى من علي ما نكرت سجومه % % 2(@)(@@) % فلله ما أندى بجود سماءه % % وأسعد في كل الأمور نجومه % % PageV01P1820 البحر : - 1(@)(@@) % شكرا لاحسانك البهي فما % % أبدعه في صنائع الكرم % % 2(@)(@@) % معناه معنى الشباب مقتبلا % وشكله المستطيل كالهرم % % PageV01P1821 البحر : - 1(@)(@@) % عجبت من الدنيا التي جل خطبها % % وحارت قلوب عندها وفهوم % % 2(@)(@@) % فيالتها اذ لا تدوم تطيب أو % % فيالتها اذ لاتطيب تدوم % % PageV01P1822 البحر : - 1(@)(@@) % أشبعت أكباد أولادي وأعينهم % % من الشوا ولقد كانوا ذوي قرم % % 2(@)(@@) % حتى لقد حسدوا جيران بابكم % وقيل بشراكم يا جيرة العلم % % PageV01P1823 البحر : - 1(@)(@@) % يا حاكمي الجامع مهلا فما % % نيأس من ألطاف رب رحيم % % 2(@)(@@) % بحوله نرفع أقداركم % % ذلك تقدير العزيز العليم % % PageV01P1824 البحر : - 1(@)(@@) % عج عن العجب فهذي جلق % % أصبحت منه على حال ذميم % % 2(@)(@@) % لم تزل بالعجب حتى ضربت % % نفسها منه بطاعون عظيم % % PageV01P1825 البحر : - 1(@)(@@) % تهن بشهرك الميمون واعلم % % بأن نصيب حالي فيه هم % % 2(@)(@@) % اذا قال الحلاوة قال عذرا % اليك فانني شهر أصم % PageV01P1826 البحر : - 1(@)(@@) % أحبتنا لا عين سلوان عنكم % % بأرض ولكن 
ms402	 كل واد جهنم % % 2(@)(@@) % ومافي شهور العام بعدكم هنا % % فذا صفر يدعى وهذا محرم % % 3(@)(@@) % فعودوا كما عاد الوزير لظاميء % دعا بره المعهود فانهل يسجم % % 4(@)(@@) % سلوني عن جود الوزيرين إن لي % % ثنا يبديء الذكر الجميل ويختم % 5(@)(@@) % فهذا وزير عظمته ممالك % وهذا شهير الفخر قد قيل أعظم % % 6(@)(@@) % رعيت ربيعي مصر والشام في حمى % % وزيرين كل في السيادة مسلم % % 7(@)(@@) % واذكرني القدر الشريف قمامة % فقلت ودعني بعد ذا أتقمم % % PageV01P1827 البحر : - 1(@)(@@) % تهن بالأعياد يا عيدها % % في أفق فضل ومقام كريم % % 2(@)(@@) % فطرا لمن والاك نحرا لمن % % عاداك ذا عدن وهذا جحيم % % 3(@)(@@) % أهدي لك المدح وأرجو به % % من قرب أولادي درا يتيم % % 4(@)(@@) % أيتمهم بعدي واني على % % بابك لاه في جنان النعيم % % 5(@)(@@) % يقول شعري كلما حفه % % نداك في أوقات حالي الرميم % % 6(@)(@@) % يا نجل محي الدين سبحان من % % أحيا بنعماك نباتي الهشيم % % 7(@)(@@) % لا سمع لللآثم في حبكم % % أعوذ بالله السميع العليم % % PageV01P1828 البحر : - 1(@)(@@) % قالوا وقد ملكت رقي غلام % % عاشق هذا ما عليه ملام % % 2(@)(@@) % يا غصن يا أهيف يا طفل يا % % قاتل هذا الشيخ يا والسلام % % 3(@)(@@) % يا جنة الخال على خده % % ما أنت الا شامة في الشآم % % 4(@)(@@) % وأنت مادح سعد التقى % % ما أنتما الا فريدا الأنام % % 5(@)(@@) % لشعر هذا فضل أيام ذا % % يقول يا بشراي هذا غلام % % 6(@)(@@) % لولاك سعد الدين لم يمح من % % ظلم ذوي الأقلام عنا ظلام % % 7(@)(@@) % لا زال مثل السرج في نصره % % وسعده في فم باغ لجام % % PageV01P1829 البحر : - 1(@)(@@) % من لي بها حسناء معرب حسنها % % زاه على الأعراب والأعجام % % 2(@)(@@) % من يافث في حسنها أو فرعها % % تلقاك في سام يصول وحام % % 3(@)(@@) % كسطور شمس الدين طي طروسه % % تسطو على الأعداء بالإعدام % % 4(@)(@@) % تجني على الألحاد أو تجني الهدى % % ثمرا على قضب من الأقلام % % 5(@)(@@) % ذو الملك في علم يسر وأسرة % % منقوشة بفوائد النظام % % 6(@)(@@) % قال الرجا سلم على أبوابه % % تسلم وعيشك من أذى الأيام % % 7(@)(@@) % فقضيت فرضا كالصلاة مسلما % ودخلت جنات 
ms403	 الهنا بسلام % % PageV01P1830 البحر : - 1(@)(@@) % كفى سرد المشيب علي لامه % % فردي نبل لحظك يا أمامه % % 2(@)(@@) % وكفي يا كريمة كيد حسن % % فلا كيد العذول ولا كرامه % % 3(@)(@@) % محى ظلم الهوى رشدي كما قد % % محى قاضي الورى ظلم الظلامه % % 4(@)(@@) % رفيع التاج أزهر خزرجي % % زكي الحلم مبرور الشهامه % % 5(@)(@@) % لئن سجعت بمدح لهاه خلق % لقد لبسوا بها سجع الحمامه % % 6(@)(@@) % مضى ابن دقيق عيد والعلايا % % ولكن جاءنا نجل الإمامه % % 7(@)(@@) % كحشو الخشكنان له صفات % % فما وصفي دقيقا أو علامه % % PageV01P1831 البحر : - 1(@)(@@) % حيتك غادية الحيا يا دار من % % أهوى وحوام عليك المرزم % % 2(@)(@@) % ما أنس اذ لحظ الاحبة ساحر % والحب في طلب الوصال معزم % % 3(@)(@@) % عيش يضييء كما أضاء بتاجه % % وجه القضايا فالمظالم تهزم % % 4(@)(@@) % أنحى بني العلياء في حالاتهم % % فالقدر يرفع والأوامر تجزم % % 5(@)(@@) % يا حاكما كم في العفاة لماله % % كيس يحل وكيس عدل يحزم % % 6(@)(@@) % للجامع المعمور خمسة أشهر % % مالي وصول في الجرائد يخزم % % 7(@)(@@) % فنظمتها وأخاف قولك مازحا % هذي القصيد لزوم مالا يلزم % % PageV01P1832 البحر : - 1(@)(@@) % بجفونها وبفرعها يا مغرم % % وافى بنصرتها السواد الأعظم % % 2(@)(@@) % حتى م تشكو كسرة من جفنها % % والى متى من فرعها تتظلم % % 3(@)(@@) % واجل المديح فذاك أفلح مجتلى % % مدح وان شئت العلوم فأعلم % % 4(@)(@@) % يا حاكم الحكام عرسي أزمعت % % في النصف أن تشكو وأن تتحكم % % 5(@)(@@) % قالت أما في نصف شعبان لنا % % شيء يذاق على مذاقته الفم % % 6(@)(@@) % فأجبتها روحي فلا نصف لكم % % إن لم يداركنا ولا لي درهم % % PageV01P1833 البحر : - 1(@)(@@) % لمولودكم يا آل يعقوب أنجم % % من اليمن لم تحتج لحدس منجم % % 2(@)(@@) % يسابقه قبل العقيقة مادح % بجوهرة من كل عقد منظم % % 3(@)(@@) % فهنئتم بدرا أنار وانما % % بخفي حنين عاد شانيكم العمي % % 4(@)(@@) % لعمري لقد ضاءت نجابة طفلكم % % فأكرم بكم أكرم بكم ثم أكرم % % 5(@)(@@) % تبارك من في آل يعقوب باركت % % ارادته ما بين آت وأقدم % % 6(@)(@@) % ففي أول إرث النبوة يوسف % % على آخر إرث الوزارة ينتمي % % 7(@)(@@) % تيممت أجوادا وفاضت بحوركم % % فلم يبق عندي رخصة في 
ms404	 التيمم % % PageV01P1834 البحر : - 1(@)(@@) % لقد عرفت تجنيها كما عرفت % % يد الجواد ابن قطب الدين بالكرم % % 2(@)(@@) % يا من تقلدت من احسانه مننا % أحيت رجائي كما يرجو ذوو نعم % % 3(@)(@@) % إن كان برك أضحى ملء كل يد % فأن شكرك أضحى ملء كل فم % % 4(@)(@@) % جادت أياديك حتى اشتط سائلنا % % فلم أياديك والسؤال لا تلم % % 5(@)(@@) % كذا تكون الكفاة السائدون فلا % % منع ولا جانب للحق مهتضم % % 6(@)(@@) % جند العساكر في جند يجهزه % % ونعم جند الدعا في حندس الظلم % % PageV01P1835 البحر : - 1(@)(@@) % سقت بجواري الدمع عني جواريا % على تركها مني السلام ورومها % % 2(@)(@@) % أو انس ان ينعم حشانا بقربها % % لقد شقيت من بعدها بكلومها % % 3(@)(@@) % وقد لقيت في الحب ما لقيت عدى % % لآلاء سيف الملك عاشت لشومها % % 4(@)(@@) % تشاريف سيف الملك شاقت لناظر % % فلله مرئي روضها وغيومها % % 5(@)(@@) % رأى الناصر السلطان علياك تجتلى % % فتحسن في زركاشها ورقومها % % 6(@)(@@) % فواصل نعماها بملك وواصلت % % يداك على العافين فيض سجومها % % 7(@)(@@) % فكم من عراة جوع يا أخا العطا % % تحانت على أكبادها وجسومها % % PageV01P1836 البحر : - 1(@)(@@) % يا فاتكا خده لي شامتا بدمي % % في ألف حل من الشكوى وفي حرم % % 2(@)(@@) % خصصت فيك بسهدي والدموع كما % % خص ابن جاديك بالتقوى وبالكرم % % 3(@)(@@) % وبالجميلين من خلق ومن خلق % وبالسيادة في عرب وفي عجم % % 4(@)(@@) % ويا أخا الفضل في الدارين يجمعها % % حمدا وأجرا ففزفي ذا وذا ودم % % 5(@)(@@) % يا ظاهر القول والافعال علمه % % بالخير من علم الإنسان بالقلم % % 6(@)(@@) % جاورت مدحك بالمدح احتوى علما % فحبذا أنتم يا جيرة العلم % % PageV01P1837 البحر : - 1(@)(@@) % بأبي حالية إذ وصلت % % ذكرها أعطف من مر النسيم % % 2(@)(@@) % إسمها مع فعلها مع وصفها % % لي ريحان وروح ونعيم % % 3(@)(@@) % مثل أقلام علاء الدين إذ % % قلدت من نفسها عقدا نظيم % % 4(@)(@@) % صاحب الأسرار في تدبيره % % للعلى سر من الله عظيم % % 5(@)(@@) % كرم يرجى وبأس يختشى % % وثنا يسري وإحسان يقيم % % 6(@)(@@) % سيدي أذكر أطفالي إذا % % قيل في الأغزال ذا در يتيم % % 7(@)(@@) % أنا في نعماك لكن مهجتي % % مثلهم في حال بعد في جحيم 
ms405	 % % PageV01P1838 البحر : - 1(@)(@@) % قلب بمصر وقالب بالشام % % من مبلغ قلبي ومصر سلامي % % 2(@)(@@) % أخفي بكمي الدموع تلونت % % فكأنها الأزهار في الأكمام % % 3(@)(@@) % شوقا أجدت عليه نثر مدامعي % % وعلى علا قاضي القضاة نظامي % % 4(@)(@@) % قاضي القضاة عليه يعقد خنصر % % ويضيء وجه العلم من إبهام % % 5(@)(@@) % يا وارث الأنصار عودة وفده % % نصرا على الأعداء والاعدام % % 6(@)(@@) % العيد قد حمل الهنا أعلامه % % فتهن يا علامة الأعلام % % 7(@)(@@) % وانحر بصحبته الضحايا والعدى % % فالكل معدود من الأنعام % % PageV01P1839 البحر : - 1(@)(@@) % بلغت في الحب سن الطاعن الهرم % % وما بلغت بسهدي مبلغ الحلم % % 2(@)(@@) % لا وصل سعدى ولا الطيف الملم فيا % % للقلب من ألم باق على ألم % % 3(@)(@@) % أصبحت في الحب فرد الانتساب وفي % % مدح الوزير فقل في المفرد العلم % % 4(@)(@@) % أزكى الأكارم في خبر وفي خبر % وأرأس القوم من عرب ومن عجم % % 5(@)(@@) % يا مذكري بكرام قد فقدتهم % فكان أكرم وجدان على عدم % % 6(@)(@@) % يا من يسائل عن مالي ويطلبني % % وكلها حيلة منه على الكرم % % 7(@)(@@) % جد لي بشيء يحاكيني فاني قد % % أصبحت لولاكم لحما على وضم % % PageV01P1840 البحر : - 1(@)(@@) % لمصر مفاخر تقديم تاج % % على مي الاشارة في الكرام % % 2(@)(@@) % حكاك اسما ومعنى وانتسابا % وعلامي أوفى من علامي % % 3(@)(@@) % و ما سماك هذا الإسم إلا % % ولي عارف سر الأسامي % % 4(@)(@@) % أبوك سقى الغمام أباك حتى % % دعيت اذا عليا في الغمام % % 5(@)(@@) % لقد ظهرت كرامة مارآه % % إمام عن إمام عن إمام % % 6(@)(@@) % و هذا أنت للمصرين تاج % فريد في فريد من نظام % % 7(@)(@@) % جعلت السبعة الأبيات ستا % تنادي كل يوم يا غلامي % % PageV01P1841 البحر : - 1(@)(@@) % مشاهد القدس حيى % % حماك صوب الغمامه % % 2(@)(@@) % حتى أراني من مص % % ر قد فتحت قمامه % % 3(@)(@@) % قامت قيامة قوم % % رأوا لقدري علامه % % 4(@)(@@) % و ظيفة قيل ماذي % % فقلت قول السلامه % % 5(@)(@@) % قيامة عند قوم % % وعند قوم قيامه % % PageV01P1842 البحر : - 1(@)(@@) % أفدي حبيبا ليس لي % % في حسنه الفتان لائم % % 2(@)(@@) % متنبها وكأنه % % لفتور ذاك اللخط نائم % % 3(@)(@@) % أشكو ذوائب شعره % % شكوى السليم إلى الأراقم % % 4(@)(@@) % سبحان مالىء خده 
ms406	 % % تبرا وصائغ فيه خاتم % % PageV01P1843 البحر : - 1(@)(@@) % نهنيك بل انا نهني مناصبا % لشمسك يمحو عدلها كل مظلم % % 2(@)(@@) % شكى حزنها قوم وفضلك منشد % اذا طلعت شمس النهار فسلم % % 3(@)(@@) % و ما هي الا طلعة قرشية % % سيشتد من أخبارها كل مسلم % % 4(@)(@@) % و أقسم لولا أنت تردع معشرا % تهون عليهم حالة المتألم % % 5(@)(@@) % لما نال كفي منهم نصف درهم % % بلى نال قلبي منهم نصف درهم % % PageV01P1844 البحر : - 1(@)(@@) % ياطرس قبل راحة شمسية % تزهو بها وبمدحها الأيام % % 2(@)(@@) % ذلت الصحابة والصحابة لم تزل % % بحرا لها متدفق وغمام % % 3(@)(@@) % و اعلم بأنك قد وصلت لمورد % % ما بعده للواردين أوام % % 4(@)(@@) % قد كللته شفاه لثم دائر % حتى كأن اللثم فيه لثام % % 5(@)(@@) % و اذكر ضرورة قائل في شعره % % قولا مضى عام عليه وعام % % 6(@)(@@) % عرج على حرم الجراية منشدا % يا دار ما صنعت بك الأيام % % 7(@)(@@) % ان لم تعجل غوث عائلتي بها % % فكأنها وكانهم أحلام % % PageV01P1845 البحر : - 1(@)(@@) % هنئتها خلعا مجددة على % % علياك بالإجلال والإعظام % % 2(@)(@@) % بيض تخبر أن عيشا أبيضا % منها وأخضر كالربيع النامي % % 3(@)(@@) % يتمسك الروض النضير بذيلها % % متأرجا والزهر بالأكمام % % 4(@)(@@) % و تقي طرحتها عليك فحبذا % % غيث خلال الروض تحت غمام % % PageV01P1846 البحر : - 1(@)(@@) % لنا ملك إن يممته ركابنا % % وإن نتيمم عاجلتنا المكارم % % 2(@)(@@) % أفاض العطايا في مقيم وراحل % كما هطلت في الجانبين الغمائم % % 3(@)(@@) % فسار إلى النعماء يدرك ما اشتهى % % وآخر يأتي رزقه وهو نائم % % PageV01P1847 البحر : - 1(@)(@@) % يا أيها الملك الذي كل الرجا % % والروع بين يراعه وحسامه % % 2(@)(@@) % هنئت شهرا مثل طرف ساكت % % يسعى به المخدوم نحو مرامه % % 3(@)(@@) % جمع الثريا والهلال وإنما % % وافى اليك بسرجه ولجامه % % PageV01P1848 البحر : - 1(@)(@@) % هنئت بالعيد السعيد ودمت ذا % % نعم لها في القاصدين غمائم % % 2(@)(@@) % لله ما أشهى بك الدنيا وما % % أزكى زمانا أنت فيه سالم % % 3(@)(@@) % ألشام منزلنا وأنت ملاذنا % % دار مباركة وعز دائم % % PageV01P1849 البحر : - 1(@)(@@) % شكرا لقاضي القضاة ما طلعت % % شمس ومدت سجوفها ظلم % % 2(@)(@@) % يبلغها شاكر الجميل كما % % تبلغنا في جنابه النعم % % 3(@)(@@) % لفظ وفضل كلاهما 
ms407	 ذهب % فكل أوقاته لنا كرم % % PageV01P1850 البحر : - 1(@)(@@) % لجأت إلى الباب الجمالي قاصدا % فقابل آمالي من السعد خادم % % 2(@)(@@) % و في العلمين الجائزين بخاطري % % أوامر للقصد الجميل تلازم % % 3(@)(@@) % فهذا بديوان الرسائل منتش % % وهذا بديوان المدائح ناظم % % PageV01P1851 البحر : - 1(@)(@@) % كم قائل إذ رآني % % مفكرا في ملمه % % 2(@)(@@) % تسير في أي واد % % فقلت والغيث يمه % % 3(@)(@@) % من المزيريب أسري % % أريد وادي فحمه % % PageV01P1852 البحر : - 1(@)(@@) % يا سيدي نفحات جو % % دك لا يطاق لها اكتتام % % 2(@)(@@) % لكن دراهم في يد % % ي بدت فقال لي الأنام % % 3(@)(@@) % ما هذه فأجبتهم % % صدقات سر والسلام % % PageV01P1853 البحر : - 1(@)(@@) % رأت بناتي حب جسمي الذي % % من طرزه عندي أذى مؤلم % % 2(@)(@@) % فقلت ما تطريز هذا الأذى % % فقلن هذا الحلط والبلغم % % 3(@)(@@) % يا رب رحماك فمنك الشفا % % من كل مايخفى وما يعلم % % PageV01P1854 البحر : - 1(@)(@@) % إلى مدح ابن فضل الله أفضت % % بي الأفكار واتسق النظام % % 2(@)(@@) % هي السحر الحلال له وأما % % على حساده فهي الحرام % % PageV01P1855 البحر : - 1(@)(@@) % لله ترخيم بجامع جلق % متجانس الترصيع والتعظيم % % 2(@)(@@) % نظمت يا كهف العفاة عقوده % % فغدا المكان به كمثل رقيم % % 3(@)(@@) % وازداد تحسينا يخالف قول من % % قد قال ان النقص في الترخيم % % PageV01P1856 البحر : - 1(@)(@@) % هنئت بالعيد السعيد وهنئت % % ببقائك الأعياد والأعوام % % 2(@)(@@) % عيد يعود حماك ألف مثله % % والبيض طوع يديك والأقلام % % 3(@)(@@) % فانعم به واسق الضحايا والعدى % % نحرا فان جميعهم أنعام % % PageV01P1857 البحر : - 1(@)(@@) % سيدي دعوة شاك % % من عيال جور حكم % % 2(@)(@@) % يطلبون اللحم في العي % % د وما يدرون همتي % % 3(@)(@@) % و أخاف العيد يأتي % % وأنا قطعة لحم % % PageV01P1858 البحر : - 1(@)(@@) % يا سيد الوزراء دعوة لائذ % % حاشاه في أيام جودك يحرم % % 2(@)(@@) % طلب الورى متأخر عن قبضهم % % فغدوت أنشد والمدامع تسجم % % 3(@)(@@) % وقف الأسى بي حيث أنت فليس لي % % متأخر عنه ولا متقدم % % PageV01P1859 البحر : - 1(@)(@@) % جمال دين الاله أنقذني % % من عثرتي وانتقى ثنا كلمي % % 2(@)(@@) % يسأل عزي ويقتضي طلبي % % وكل ذا حيلة على الكرم % % 3(@)(@@) % علمه الفضل في مناصبه % % من علم الكاتبين بالقلم % % PageV01P1860 البحر : - 1(@)(@@) % شكرا لنجم العلاء كم 
ms408	 منن % % قلدني عقدها وكم نعم % % 2(@)(@@) % قلت وقد نوعت يداه على % % حالي أنواعها من الكرم % % 3(@)(@@) % أفدي إماما حلت صنائعه % % بيتي وجيدي وشدتي وفمي % % PageV01P1861 البحر : - 1(@)(@@) % قالت أفي شعباننا مالنا % % نصف يحلينا كما تعلم % % 2(@)(@@) % قلت لها موسى وزير التقى % % يعلم أني رجل معدم % % 3(@)(@@) % إن لم يغثنا فاعلمي أنه % % والله لا نصف ولا درهم % % PageV01P1862 البحر : - 1(@)(@@) % يا سيدا لا زال ممتحنا % بحادثات الزمان من قدمه % % 2(@)(@@) % من سلم قد وقعت وقعة من % % زاد مقال الحاكمين في ألمه % % 3(@)(@@) % رأس ورجل والضلع فهو كما % % يقال من قرنه إلى قدمه % % PageV01P1863 البحر : - 1(@)(@@) % لا تقيسوا ابن سنانا في الندى % % ما ابن أيوب قياس منخرم % % 2(@)(@@) % فرق ما بينهما متضح % % أين من جود فتى جود هرم % % PageV01P1864 البحر : - 1(@)(@@) % أيا صاحب النعم الباهرات % % إليك بعثت مقالي النظيم % % 2(@)(@@) % وأهديت منه يتيم العقود % % وحاشاك تكسر قلب اليتيم % % PageV01P1865 البحر : - 1(@)(@@) % لي صديق يسوءني % % ما يقاسي من الألم % % 2(@)(@@) % كيف يخفي شجونه % % وهو نار على علم % PageV01P1866 البحر : - 1(@)(@@) % و أصهار سوء ذو الدراسة بينهم % % وذو الفقر مذموم فإياك عنهم % 2(@)(@@) % فان كنت تشكو الفقر فهي مصيبة % وان كنت تدري فالمصيبة أعظم % PageV01P1867 البحر : - 1(@)(@@) % يارب ضيفان قوم جلد هامته % % جلد على الطارق الطاري من الأدم % % 2(@)(@@) % اذا رأى الدلو فوق الرأس أنشده % % ضيف ألم برأسي غير محتشم % % PageV01P1868 البحر : - 1(@)(@@) % لقد رحمنا بقوم % % زهر الوجوه أئمه % % 2(@)(@@) % جماعة نسبة يا % % لها جماعة رحمه % % PageV01P1869 البحر : - 1(@)(@@) % شكى بفحمة شيخ % % ضعفا يحرك وهمه % % 2(@)(@@) % فقلت لا موت فيها % % ماذي حوائج فحمه % % PageV01P1870 البحر : - 1(@)(@@) % الله سخر لي وعائلتي % % من حف بي الإكرام والكرما % % 2(@)(@@) % حتى تلوت قبل رؤيتهم % % يا ليت قومي يعلمون بما % % PageV01P1871 البحر : - 1(@)(@@) % لم أدر في المداح أن قد أتى % % علاء دين الله نجل كريم % % 2(@)(@@) % حتى رأيت الوفد طافوا به % % وبشروه بغلام عليم % % PageV01P1872 البحر : - 1(@)(@@) % و غانية يوافقني اذا ما % % صبوت لها ذووا العقل السليم % % 2(@)(@@) % و اعذر ان بكيت على رياض % بكاء البحتري على نسيم % % PageV01P1873 البحر : - 1(@)(@@) % للصاحب 
ms409	 العلمي الذكر نورثا % أشهى وأشهر من نار على علم % % 2(@)(@@) % قالت تواقيعه أوقات جلسته % % سبحان من علم الانسان بالقلم % % PageV01P1874 البحر : - 1(@)(@@) % قالت جراية خبز لي سأنقلها % % في مصر من حرم واف إلى حرم % % 2(@)(@@) % هل يعلم اللحم أني بعد نقلته % % ما سرت من علم الا إلى علم % % PageV01P1875 البحر : - 1(@)(@@) % إن مت من جوع بمصر فحسرة % % إن مات أولادي بجوع الشام % % 2(@)(@@) % قل للوزيرين الرفيع سناهما % % لا ترحماني وارحما أيتامي % % PageV01P1876 البحر : - 1(@)(@@) % أعمال برك في حلي امتداحك يا % % علي سيارة بين الأقاليم % % 2(@)(@@) % في خنصر العد أو جيد الرجاء بها % % خير القلائد أو خير الخواتيم % % PageV01P1877 البحر : - 1(@)(@@) % اذا الله كافى منعما عن مقصر % فكافى شهاب الدين أحسن منعم % % 2(@)(@@) % فكم طوق سنجاب سجعت بمدحه % % فيا حسن طوق الساجع المترنم % % PageV01P1878 البحر : - 1(@)(@@) % ان أخرتني عن مديحك فترة % % فعلى رجائي فيك أن أتقدما % % 2(@)(@@) % أوقات سبقي أن أكون مصليا % فعلي أن أقضي صلاتي كلما % % PageV01P1879 البحر : - 1(@)(@@) % وأغيد ينهب أرواحنا % % ووجهه كالروض بسام % % 2(@)(@@) % تنم خداه بقتل الورى % % فخده ورد ونمام % % PageV01P1880 البحر : - 1(@)(@@) % عجبت لحاسد أضناه أمري % % وحملني لهذا الأمر همه % % 2(@)(@@) % كلانا فائض الأجفان مهما % % بكى حنقا بكيت عليه رحمه % % PageV01P1881 البحر : - 1(@)(@@) % قلم العذار بوجنتيك جرى % % وبسيف لحظك صان كل دم % % 2(@)(@@) % فاحكم على كل الأنام فقد % % أضبحت رب السيف والقلم % % PageV01P1882 البحر : - 1(@)(@@) % يا لحظة الفتاك رفقا بامرىء % يقضي عليه تيقظ ومنام % % 2(@)(@@) % فاذا تنبه رعته واذا غفا % % سلت عليه سيوفك الأحكام % % PageV01P1883 البحر : - 1(@)(@@) % تمتعت يا إيري بغانية لها % % أمام وخلف طيب ملتقاهما % % 2(@)(@@) % حللت بهذا حلة ثم حلة % % بهذا فطاب الواديان كلاهما % % PageV01P1884 البحر : - 1(@)(@@) % قالت البيض حين شبت تغزل % % وترحل عن ودنا بسلام % % 2(@)(@@) % ما رأينا المشيب الا كبلح % % أبيض بارد قليل المقام % % PageV01P1885 البحر : - 1(@)(@@) % كسوتني خضراء ما نالها % % من منعم غيري ولا سامها % % 2(@)(@@) % يقبل الروض لديها الثرى % % ويلثم الأزهار أكمامها % % PageV01P1886 البحر : - 1(@)(@@) % يا من بامداحه اشترينا % % أموال كفيه في الأنام % % 2(@)(@@) % هانت عليك اللهى فأضحت % % تباع في الناس بالكلام % % PageV01P1887 البحر 
ms410	 : - 1(@)(@@) % قفا زيد لقد جربت مني % % أنامل كالسياط ذوات حوم % % 2(@)(@@) % كأنك سيف زيد الخيل عندي % % أحادثه يصقل كل يوم % % PageV01P1888 البحر : - 1(@)(@@) % عمري لقد زهت الأمصار حين محى % % علي عنها ديلاجي الظلم والظلم % % 2(@)(@@) % اذا برى قلما قالت ممالكها % % يا باريء النسم احرس باري القلم % % PageV01P1889 البحر : - 1(@)(@@) % يا كريما قد طابق الإسم بالفع % % ل وأنسى في الفضل كل قديم % % 2(@)(@@) % لا تخف نبوة الحوادث فالل % % ه كريم يحب كل كريم % % PageV01P1890 البحر : - 1(@)(@@) % اذا نظرت كتابا % فاضت دموعي الهوامي % % 2(@)(@@) % نعم فما الكتب عندي % % إلا قبور الكرام % % PageV01P1891 البحر : - 1(@)(@@) % أمولاي لا زالت مساعيك للعلى % % وكفك للجدوى ورأيك للحزم % % 2(@)(@@) % مضى السلف الأزكى وأبقاك للندى % % فلله ما أبقى الولي من الوسم ي % % PageV01P1892 البحر : - 1(@)(@@) % يا سائلي عن رتبة الحلي في % % نظم القريض وراضيا بي أحكم % % 2(@)(@@) % للشعر حلبان وذلك راجح % % ولي الزمان به وهذا قيم % % PageV01P1893 البحر : - 1(@)(@@) % زادنا في صيامنا الشاهد المي % % ت حتى تغيظ الإسلام % % 2(@)(@@) % جرحوه فما تألم جرحا % ما لجرح بميت إيلام % % PageV01P1894 البحر : - 1(@)(@@) % لجود قاضي القضاة أشكو % % عجزي عن الحلو في صيامي % % 2(@)(@@) % فالقطر أرجو ولا عجيب % ألقطر يرجى من الغمام % % PageV01P1895 البحر : - 1(@)(@@) % أهان وزير الشام قصدي عندما % % طلبت من الميراث بعض الدراهم % % 2(@)(@@) % و قال اصرفوها لابن آدم كلها % % فأيقنت أني عنده غير آدمي % % PageV01P1896 البحر : - 1(@)(@@) % دعاني صديق لحمامه % % فأوقعني في العذاب الأليم % % 2(@)(@@) % كلام يزيد وماء يقل % % فبئس الصديق وبئس الحميم % % PageV01P1897 البحر : - 1(@)(@@) % لي قلم بين دجى خطه % % يبيت ذا رقص وذا زحمه % % 2(@)(@@) % يقول من يبصر أحواله % % هذا هو الراقص في الظلمه % % PageV01P1898 البحر : - 1(@)(@@) % لا تنكر المعشوق في خده % % دم الشهيد الصابر المغرم % % 2(@)(@@) % فالريح ريح المسك من خده % % كما ترى واللون لون الدم % % PageV01P1899 البحر : - 1(@)(@@) % أفدي الذي عدمت له عين فلم % % تسحر وعين سحرها لا يعدم % % 2(@)(@@) % أصف العيون من الظباء لأجله % % ولفرد عين ألف عين تكرم % % PageV01P1900 البحر : - 1(@)(@@) % فديناك يا ابن الواسطي ممجدا % بأقلامه أو جائدا بمكارمه % % 2(@)(@@) % فخاتم أهل الجود في بطن 
ms411	 كفه % % وياقوت أهل الخط في فص خاتمه % % PageV01P1901 البحر : - 1(@)(@@) % إن صار سفري كالسعيد الذي % % يسمى فمدحي كعبيد الرحيم % % 2(@)(@@) % ياسين من حول رجائي فقل % % سبحان من يحيي العظام الرميم % % PageV01P1902 البحر : - 1(@)(@@) % أهواه معسول الرضاب منعما % % ولقد يعذبني الهوى بمنعم % % 2(@)(@@) % يا قلب هذا شعره وجفونه % % صبرا على هذا السواد الأعظم % % PageV01P1903 البحر : - 1(@)(@@) % عيد تعودك بالهناء سعوده % % فتهنه في غبطة ودوام % % 2(@)(@@) % وانحر بصبحته الضحايا والعدى % % فالكل معدود من الأنعام % % PageV01P1904 البحر : - 1(@)(@@) % مولاي هنئت فردا في الشهور كما % % في الناس فردا دعاك العلم والكرم % % 2(@)(@@) % إصغى إلى مدح لي فيك سائرة % % وقد أسمعت كلماتي من به صمم % % PageV01P1905 البحر : - 1(@)(@@) % تنسك في شهر الصيام معذبي % % وفي جفنه سيف على الناس عازم % % 2(@)(@@) % فيا حربا من فاتر الطرف فاتك % % يفطر أكباد الورى وهو صائم % % PageV01P1906 البحر : - 1(@)(@@) % بأبي غزالا جال في وجناته % % ماء النعيم ولونه متعندم % % 2(@)(@@) % لاغرو أن أهوى بوجنته إلى % % زهر الشقيق فطالما حن لدم % % PageV01P1907 البحر : - 1(@)(@@) % بروحي مقلة لك في فؤادي % % وفي جسدي لها جرح وسقم % 2(@)(@@) % توفر لوعتي وتصيب قلبي % % فلي منها على الحالين سهم % % PageV01P1908 البحر : - 1(@)(@@) % سرو اللشآم وغرب الجفون % % تفطر منا بنار الهموم % % 2(@)(@@) % ففي الشرق أحبابنا كالبدور % % وفي الغرب أدمعنا كالنجوم % % PageV01P1909 البحر : - 1(@)(@@) % بروحي تياه يحلل أدمعي % % وكيف يحل الماء أكثره دم % % 2(@)(@@) % بكت مقلني العبرى وأسياف جفنه % % من التيه في أغمادها تتبسم % % PageV01P1910 البحر : - 1(@)(@@) % عذول لست أسمع منه عذلا % على غيداء مثل البدر تما % % 2(@)(@@) % له طرف ضرير عن سناها % % ولي أذن عن الفحشاء صما % % PageV01P1911 البحر : - 1(@)(@@) % آها لشمل وقد وهي سلكه % وكان ذا در بعبد الرحيم % % 2(@)(@@) % فليتني لاقيت منه الردى % % وعاش ذاك الدر درا يتيم % % PageV01P1912 البحر : - 1(@)(@@) % و قالع من جنتي خده % % نبتا به العشاق قد هاموا % % 2(@)(@@) % يقول محتجا إذا لمته % % لا يدخل الجنة نمام % % PageV01P1913 البحر : - 1(@)(@@) % محبوبتي دنيا جفت بعدما % % جادت وكانت نزهة الهائم % % 2(@)(@@) % كانت مع الإير زمان الصبا % % وهكذا الدنيا مع القائم % % PageV01P1914 البحر : - 1(@)(@@) % يا رب كأس صاغها لي شادن 
ms412	 % نعم الصياغة في الزمان المعلم % % 2(@)(@@) % فأخذتها كالتاج وهو مكلل % ورددتها مثل السوار بمعصم % % PageV01P1915 البحر : - 1(@)(@@) % خليلي ان العام عام مبارك % % فلا الفقر نخشاه ولا الفكر حائم % % 2(@)(@@) % اذا نقط الغيث استدارت وأخصبت % % فما هي في التحقيق الا دراهم % % PageV01P1916 البحر : - 1(@)(@@) % باع صديقي لجام بغلته % % ليشتري الخبز منه والأدما % % 2(@)(@@) % فآها عليه راحت وظيفته % % فهو على الحالين يأكل اللجما % % PageV01P1917 البحر : - 1(@)(@@) % لاح الإمام لطلاب اللهى علما % وماس بانا على أدراجه القلم % % 2(@)(@@) % فقل لمن سار للآمال يقصدها % % يا ساري القصد هذا البان والعلم % % PageV01P1918 البحر : - 1(@)(@@) % لئن جرحت خدي فلانة مقلتي % % لقد جرحاها بالدموع السواجم % % 2(@)(@@) % شكى خدها لحظي ولحظي خدها % % ولا ظالم الا ويبلى بظالم % % PageV01P1919 البحر : - 1(@)(@@) % عش يا محمد في الدارين متصلا % حمدا وأجرا وفز في ذا وذا ودم % % 2(@)(@@) % جاورت مدحك بالمدح احتوى علما % فحبذا أنتم يا جيرة العلم % % PageV01P1920 البحر : - 1(@)(@@) % هنئت قاعة أنعم وفضائل % مسعودة بك يا إمام متممه % % 2(@)(@@) % قد رخمت فسطت بعنق حسودها % % يا حبذا في الصيغتين مرخمه % % PageV01P1921 البحر : - 1(@)(@@) % قلت لإحسان وزير التقى % % في مطلب الميراث لي مغنم % % 2(@)(@@) % من بركة القطن لكتانها % % فقال هذا طلب ملجم % % PageV01P1922 البحر : - 1(@)(@@) % يا سيدي يا فلان الدين لا برحت % % سوائم القصد ترعى تجت ظلكم % 2(@)(@@) % كانت أياديكم قدما تواصلنا % % والآن أحوج ما كنا لوصلكم % % PageV01P1923 البحر : - 1(@)(@@) % قالت وإيري قد تراخى أما % % يطبخ في منزلنا لحم % % 2(@)(@@) % فقلت والمقصود قد بان لي % % كفي ولا لحم ولا عظم % % PageV01P1924 البحر : - 1(@)(@@) % شكرا لإيري الذي يبلغني % % ما أتمنى من ساعة الحلم % % 2(@)(@@) % قام دجى الليل طالبا غرضي % % ونمت عن حاجتي ولم ينم % % PageV01P1925 البحر : - 1(@)(@@) % يا إمام التقى كذا كل عيد % % تتلقى هنا وتمنح نعمى % % 2(@)(@@) % و نرى مجدك الحلي وجدوا % % ك فتملا العيون شحما ولحما % % PageV01P1926 البحر : - 1(@)(@@) % مذ أضامتني الليالي جفاني % % كرم الافتخار والإكرام % % 2(@)(@@) % فتذكرت قول أحمد قدما % لا افتخارا الا لمن لا يضام % % PageV01P1927 البحر : - 1(@)(@@) % قد سرت الأمة والدين اذ % % قالوا أتى السلطان نجل كريم % % 2(@)(@@) % فبشروها بمليك رضا 
ms413	 % وبشروه بغلام حليم % % PageV01P1928 البحر : - 1(@)(@@) % تؤخرني سادات دهري وقد دروا % % صفاتي وأنسابي التي هي أكرم % % 2(@)(@@) % كأنهم قد خالفوا قول أحمد % فما عندهم الا النسيب المقدم % % PageV01P1929 البحر : - 1(@)(@@) % يا سيدي أهلتني وأمرتني % % بلزوم بابك في كتاب أرقم % % 2(@)(@@) % فلزمت مع نسب الولاء فلا تقل % % هذا كتاب لزوم ما لا يلزم % % PageV01P1930 البحر : - 1(@)(@@) % قد أسرج الشيب في فودي وألجمني % % عما أعانيه من نقض وإبرام % % 2(@)(@@) % فما التغافل عن شأن الرحيل إلى % % دار البلى بعد إسراج وإلجام % % PageV01P1931 البحر : - 1(@)(@@) % بروحي من في وجنتيه إذا بدا % % محاسن تشقي ناظري وتنعم % % 2(@)(@@) % يحدث بالجفن الذي يجرح الحشا % % فأجفانه في الحالتين تكلم % % PageV01P1932 البحر : - 1(@)(@@) % يا سقيم الجفن أسقمني % % وحلا في حبه ألمي % % 2(@)(@@) % إن حكت عيناك لي جسدا % فلقد حاكت على السقم % % PageV01P1933 البحر : - 1(@)(@@) % يا ملكا لا يخيب زائره % % دعوة ضيف منقح النظم % % 2(@)(@@) % يبكي على رسمه ولا عجب % لشاعر إن بكى على رسم % % PageV01P1934 البحر : - 1(@)(@@) % و لم أنس في رسم الأحبة موقفا % أضفت به للجسم سقما إلى سقم % % 2(@)(@@) % و قد رفعت عيناي قصة دمعها % % فوقع فيها الوجد يجري على الرسم % % PageV01P1935 البحر : - 1(@)(@@) % سكندري قلت لما بدا % % في صحبه كالبدر في الأنجم % % 2(@)(@@) % يا مانع الثغر وحق الهوى % % إني لمشتاق إلى اللثم % % PageV01P1936 البحر : - 1(@)(@@) % ظفرت على رغم الرقيب بطيفها % % وقد طردت خلف الثريا النعائم % % 2(@)(@@) % فيا لرقيب ليس يرزق نظرة % % وآخر يأتي رزقه وهو نائم % % PageV01P1937 البحر : - 1(@)(@@) % وقفت على سفح الثنية باكيا % فكل مكان بالثنية عندم % 2(@)(@@) % و أدوعت قلبي في ثراها مقبلا % كأني لهاتيك الودائع أختم % % PageV01P1938 البحر : - 1(@)(@@) % سلت صوارمها من الأجفان % % فسطت على الآساد والغزلان % % 2(@)(@@) % وتبسمت عن لؤلوء متمنع % % حتى بكيت عليه بالعقيان % % 3(@)(@@) % غيداء أستجلي البدور لوجهها % % إذ ليس حظي منه غير عيان % % 4(@)(@@) % تركية للقان ينسب خدها % % واصبوني منه بأحمر قاني % % 5(@)(@@) % خد يريك تنعما وتلهبا % يا من رأى الجنات في النيران % % 6(@)(@@) % ومحاسن تزهو وتخلف عهدها % % وكذا يكون الروض ذا ألوان % % 7(@)(@@) % كالجنة الزهراء إلا أن لي % % من 
ms414	 أدمعي فيها حميما آن % % 8(@)(@@) % يحمي نعيم خدودها أن يحتنى % % أو ما سمعت شقائق النعمان % % 9(@)(@@) % ترنو لواحظها إلى عشاقها % % فتصول بالأسياف في الأجفان % % 10(@)(@@) % و يهز حلو قوامها مرج الصبا % % هز الكماة عوالي المران % % PageV01P1939 11(@)(@@) % ان صدها عني المشيب فطالما % % عطفت شمائبلها بما أرضاني % % 12(@)(@@) % و بلغت مالا سولته شبيبتي % % وفعلت ما لا ظنه شيطاني % % 13(@)(@@) % و جنيت من ثمر الذنوب تعمدا % % لما رأيت العفو حظ الجاني % % 14(@)(@@) % و حلبت هذا الدهر أشطر عيشه % % فوجدت زبدتها متاعا فاني % % 15(@)(@@) % و سبرت اخلاق الكرام فلم أجد % % في الفضل للملك المؤيد ثاني % % 16(@)(@@) % ملك ترنحت المنابر باسمه % % حتى ادكرن معاهد الأغصان % % 17(@)(@@) % بادي الوقار اذا احتبى وحبا الندى % % أبصرت سير السيل من نهلان % % 18(@)(@@) % قامت بسؤدده مآثر بيته % % وعلى العماد إقامة البنيان % % 19(@)(@@) % قسما بمن أعلى وأعلن مجده % % وأفاض أنعمه بكل مكان % % 20(@)(@@) % ما حاد عني الفقر حتى صحت في % % مدحي أنا بالله والسلطان % % PageV01P1940 21(@)(@@) % فوجدت للنعماء ملء مآربي % % ووجدت للأوصاف ملء لساني % % 22(@)(@@) % و مدحت من نشرت مدائح مجده % % ذكري فلو لم يعطني لكفاني % % 23(@)(@@) % ملكا أبر على الأولى متأخرا % عنهم كبسم الله في العنوان % % 24(@)(@@) % تعب الأنامل لا يغب نواله % % إن العلى والمجد للتعبان % % 25(@)(@@) % اعطى وقد منع الغمام وأرشدت % % أراؤه والنجم كالحيران % % 26(@)(@@) % و اعتادت الهيجاء منه غضنفرا % سار من اليزني في خفان % % 27(@)(@@) % تتالف العقبان فوق رماحه % % إلف الحمام على غصون البان % % 28(@)(@@) % و يصح علم الكيمياء وسيفه % % فترى اللجين يعود كالعقبان % % 29(@)(@@) % و يقول فيض فعاله ومقاله % % مرج النهى بحرين يلتقيان % % 30(@)(@@) % يا مشتري سلع الثناء بماله % % هنئت مرتبة على كيوان % % PageV01P1941 31(@)(@@) % صانت يداك عن الأنام وسائلي % % وثني حماك عن البلاد عناني % % 32(@)(@@) % فمحوت الا من ثناك خواطري % % ونفضت الا من نداك بناني % % 33(@)(@@) % وتركت مدح العالمين وذمهم % % وشغلت عن هذا الندى في شاني % % 34(@)(@@) % وأقمت متصل الرجاء بواحد % لم يختلف في الفضل منه اثنان % % 35(@)(@@) % متسلسل الكلمات في أوصافه % % متقيدا بصنائع الاحسان % % 36(@)(@@) % لا يعدم 
ms415	 الدهر الأخير بدائعا % تنهال بين سماحة وبيان % % 37(@)(@@) % أكتال بالمكيال فضل هباته % % وأبيحه الأمداح بالأوزان % % PageV01P1942 البحر : - 1(@)(@@) % ألا من لمسلوب الفؤاد رهينه % % معنى بمحجوب الوداد ضنينه % % 2(@)(@@) % أخو شجن يرعى النجوم كأنما % % تعلق أعلى هدبه بجبينه % % 3(@)(@@) % تجلده شك اذ لام لائم % ولكن فرط الوجد عقد يقينه % % 4(@)(@@) % وفي قلبه داء دفين من الأسى % % فلا غرو أن يبكي لأجل دفينه % % 5(@)(@@) % وظبي له في أسرة الترك نسبة % % وفي الهند معنى من مضاء جفونه % % 6(@)(@@) % من الطالبي كتم الغرام صبابة % % وأحسن بمكتوم الغرام مصونه % % 7(@)(@@) % كتمت الهوى في عشقه متفلسفا % فأصبح عشقي قائلا بكمونه % % 8(@)(@@) % وعاينت في خديه خط عذاره % % فأقسمت في صحف الجمال بنونه % % 9(@)(@@) % يحن لي قلبي فلله من رأى % % حمى يتبع الغادين رجع حنينه % % 10(@)(@@) % هو الحب يحلو فيه للمرء دمعه % % ويطربه في الليل صوت أنينه % % PageV01P1943 11(@)(@@) % برغمي طرف غاب عنه عزيزه % % فعوضه ماء البكا بمهينه % % 12(@)(@@) % روى عن معين الدمع طرفي فاسمعوا % % حديث جوى قلبي عن ابن معينه % % 13(@)(@@) % واني لجلد في ممارسة الهوى % % مدل بمهدي الولاء أمينه % % 14(@)(@@) % يقوم بنصري في الصبابة عون من % % أقام ابن أيوب عمادا لدينه % % 15(@)(@@) % مليك تولى الفضل بعد ضياعه % % وهذب هذا الدهر بعد خبونه % % 16(@)(@@) % ومد يمينا يعذر البحر والحيا % % اذا حلفا يوم الندى بيمينه % % 17(@)(@@) % أخو صدقات تقدر المدح قدره % % فما يشتري في المدح غير ثمينه % % 18(@)(@@) % اذا جلب الناس الثناء لبابه % % فما جلبوا الا لباب زبونه % % 19(@)(@@) % وما ذاك شحا بالثناء وانما % % سجية فياض الغمام هتونه % % 20(@)(@@) % شج بالعلى والعلم والبأس والندى % % فلله ما أحلى حديث شجونه % % PageV01P1944 21(@)(@@) % له منزل تهوى المقلصد نحوه % % هوي حمام الأيك نحو وكونه % % 22(@)(@@) % تدفق طوفان الندى بجنابه % % فأمست مطايا الوفد مثل سفينه % % 23(@)(@@) % اذا طلب الملك المؤيد معسر % رأى بشره في وجهه كضمينه % % 24(@)(@@) % عجبت لبشر ضامن الوجه اذ غدا % % يطالبه عافي الندى بديونه % % 25(@)(@@) % وأروع يهتز الزمان لأمره % % وما الطود أرسى جانبا من سكونه % % 26(@)(@@) % اذا حاول الفعل الجليل وجدته % % بلا 
ms416	 قده في المعضلات وسينه % % 27(@)(@@) % عزيمة من لا يصعب الجد في العلى % % عليه كأن الجد بعض مجونه % % 28(@)(@@) % كثير السرى ما بين مشتجر القنا % % فيالك ليثا سائرا في عرينه % % 29(@)(@@) % يلاقي العدى يوم الوغى متبسما % كأنك قد لاقيته بخدينه % % 30(@)(@@) % وتلهيه في الهيجاء رنة قوسه % اذا وتر ألهى امرأ برنينه % % PageV01P1945 31(@)(@@) % ولو شاء أغناه عن الجيش ذكره % % ورب حسام هازم بطنينه % % 32(@)(@@) % أيا ملكا أغنى عن الغيث جوده % % وأغنته حومات الوغى عن حصونه % % 33(@)(@@) % بك ارتد مشكو الزمان عن الأذى % % وأطلق أبناء المنى من سجونه % % 34(@)(@@) % وقد كان ذا همز يحاذر فانتهى % % إلى مده بعد الإباء ولينه % % 35(@)(@@) % وكم لك عندي من ندى يفضل الثنا % % ويحلف أن الشعر غير قرينه % % 36(@)(@@) % اذا قلت قد قابلته بقصيدة % % بدا غيره مستظهرا بكمينه % % 37(@)(@@) % فدونك مدحا من قريحة مادح % يقابل أبكار الصلاة بعونه % % 38(@)(@@) % رأى أنك البحر الذي طاب ورده % % فجاءك من نظم القريض بنونه % % PageV01P1946 البحر : - 1(@)(@@) % أخفي الأسى ولسان دمعي يعلن % وأرى الدمى ترنو الي فافتن % % 2(@)(@@) % وتظل تعدي الغانيات مدامعي % % فمدامعي كعهودها تتلون % % 3(@)(@@) % بأبي التي أسكنتها في خاطري % % وسرت فسار مع النزيل المسكن % % 4(@)(@@) % لمياء لي دين على ميعادها % % مع أن قلبي عندها مسترهن % % 5(@)(@@) % تبدي اللآلي منطقا وتبسما % فكأن فاها للآلي معدن % % 6(@)(@@) % ويلومني فيها خلي ما درى % % الشمس أم تلك المليحة أزين % % 7(@)(@@) % يا لائمي انظر حسن تلك وهذه % % وادفع ملامك بالتي هي أحسن % % 8(@)(@@) % كيف التصبر عن سعاد وحسنها % % كالفضل في الملك المؤيد بين % % 9(@)(@@) % ملك على عهد المعالي ثابت % % لكنه في فضله متفنن % % 10(@)(@@) % بينا يرى بحر العلوم اذا به % % بحر الندى فحديثه متشجن % % PageV01P1947 11(@)(@@) % ظعن الكرام الأولون وأقبلت % % أيامه فكأنهم لم يظعنوا % % 12(@)(@@) % لم يبق لولا جوده ومديحنا % % مال يكال ولا مقال يوزن % % 13(@)(@@) % من أين للآمال مثل مقامه % % ألروض أفيح والغمائم هتن % % 14(@)(@@) % نعم الملاذ لمن يلوذ بظله % % من شر ما يخشى وما يتحصن % % 15(@)(@@) % خذ عن عواليه أحاديث الوغى % % فحديثها عن راحتيه يعنعن 
ms417	 % % 16(@)(@@) % شرف القتيل بسيفه فقتيله % % في الجو ما بين الحواصل يدفن % % 17(@)(@@) % وتطابقت أفعاله لعفاته % % فالكيس تهزل والحقائب تسمن % % 18(@)(@@) % كرم كفيض السيل الا أنه % % لا مانع السقيا ولا متأسن % % 19(@)(@@) % وعلا يموت به الحسود تحسرا % فكأنه بثيابه متكفن % % 20(@)(@@) % ما ضر معشر حاسديه لو أنهم % % فطنوا لسر الله فيه وأذعنوا % % PageV01P1948 21(@)(@@) % ألله قدر في العزائم أنهم % % يتحارفون وأنه يتسلطن % % 22(@)(@@) % يا ابن الملوك اذا دعاهم مقتر % لانوا وان دعيت نزال اخشوشنوا % % 23(@)(@@) % تسب كصدر الرمح إلا أنه % % عند المحامد ليس فيه مطعن % % 24(@)(@@) % لله دهرك إنه الدهرالذي % % سيء الكفور به وسر المؤمن % % 25(@)(@@) % شيدت باسماعيل أركان العلى % % فاليه يلتجيء الرجاء ويركن % % 26(@)(@@) % ودعا ندى ابن علي كل مودة % حتى استوى الشعي والمتسنن % % 27(@)(@@) % فليعذر المداح فيه فانهم % % بالعجز عن أدنى المدى قد أيقنوا % % 28(@)(@@) % عنت القرائح عن بلوغ صفاته % % وتسترت خلف الشفاه الألسن % % PageV01P1949 البحر : - 1(@)(@@) % لا تسألوا في الحب عن شأني % % فقد كفى تعبير أجفاني % % 2(@)(@@) % هويت من طلعته روضة % % ففاضت العين بغدران % % 3(@)(@@) % غصن من البان اذا ماانثنى % % أبصرت فيه ألف بستان % % 4(@)(@@) % أشبهت في حبيه ورق الحمى % % فكلنا نبكي على البان % % 5(@)(@@) % بالروح أفدي وجنتي مالك % كأنه من حور رضوان % % 6(@)(@@) % فر عن الجنات من تيهه % % وعذب الصب بنيران % % 7(@)(@@) % ظبي إلى القاني له نسبة % واحربا من خده القاني % % 8(@)(@@) % تقول لي نشطة أعطافه % % ظل الذي بالرمح حاكاني % % 9(@)(@@) % حلوان من عطفي قد أينعا % % فكيف تحكيها بمران % % 10(@)(@@) % يا فارغ الفكرة من شقوتي % % يعينني من فيك أشقاني % % PageV01P1950 11(@)(@@) % لا وندى ابن الافضل المرتجي % % لا نكثت بيعة أشجاني % % 12(@)(@@) % ذاك الذي أنقذني جوده % % من مخلب الدهر فأحياني % % 13(@)(@@) % ولم يزل تنويه تنويله % % حتى حمى وجهي وأغناني % % 14(@)(@@) % قالت لآمالي يداه انفذي % % لا تنفذي إلا بسلطان % % 15(@)(@@) % أفضي لاسماعيل بيت العلى % % فشاد منه أي أركان % % 16(@)(@@) % مؤيد تفصح يوم الوغى % % في مدحه ألسن خرسان % % 17(@)(@@) % ذو راحة في البذل تعبانه % % وما العلى إلا لتعبان % % 18(@)(@@) % تجني على المال فتجني 
ms418	 الثنا % % يا حبذا المجنى واالجاني % % 19(@)(@@) % تجري على كفه نظم الرجا % % ما بين سيحان وجيحان % % 20(@)(@@) % أكرم به في الدهر من أوحد % لم يختلف في فضله اثنان % % PageV01P1951 21(@)(@@) % لو أن للبدر سنا مجده % % ما روع البدر بنقصان % % 22(@)(@@) % ولو دعاه حي عدوان ما % % رماهم الدهر بعدوان % % 23(@)(@@) % للدين والدنيا جمال به % % كأنه روح لجثمان % % 24(@)(@@) % يلقاك من علياه أو علمه % % بملء أبصار وأذهان % % 25(@)(@@) % باسط كفيه لطلابه % % فهو الورى وهي البسيطان % % 26(@)(@@) % له اذا حاولت نهب اللهى % % خزائن ليست بخزان % % 27(@)(@@) % للجود في أموالها مثلما % % في قصتي عبس وذبيان % % 28(@)(@@) % أصبحت من غلمان أبوابه % % والسعد من جملة غلماني % % 29(@)(@@) % أطوي على محض الولا مهجتي % % وأنشر المدح بتبيان % % 30(@)(@@) % فكل أمداحي في فضله % % أبيات سلمان وحسان % % PageV01P1952 31(@)(@@) % يا رب هبه عمر نوح فقد % % جاء من الجود بطوفان % % PageV01P1953 البحر : - 1(@)(@@) % اذا ظفرت يوما بقربكم المنا % % فلست أبالي من تباعد أو دنا % % 2(@)(@@) % ولعت بعشقي فيكم فتأكدت % % معانيه فاستولى فأصبح ديدنا % % 3(@)(@@) % ولما جنى طرفي رياض جمالكم % % جعلتم سهادي في عقوبة من جنى % % 4(@)(@@) % أجيراننا ان عفتم السفح منزلا % وأخليتموا من جانب الجزع موطنا % % 5(@)(@@) % فقد حزمتم دمعي عقيقا ومهجتي % % غضا وسكنتم من ضلوعي منحنى % % 6(@)(@@) % وأرسلتم طيف الخيال لمقلة % اذا ما أتاها استصحب السهد ضيفنا % % 7(@)(@@) % وكم فيكم يوم الوداع لشقوتي % % هلال سما غصن زها رشأ رنا % % 8(@)(@@) % اذا شمت تحت الجتاجبين جفونه % % أرى السحر منها قاب قوسين أو دنا % % 9(@)(@@) % أما والذي لو شاء قصر بينكم % % فلم يتعب الطيف المردد بيننا % % 10(@)(@@) % لقد خلقت للعشق فيكم جوانحي % % كما خلق الملك المؤيد للثنا % % PageV01P1954 11(@)(@@) % مليك له في العلم والجود همة % ترى المال في الإقتار والعيش في العنا % % 12(@)(@@) % بني رتبا قد أعرب المدح ذكرها % % فيا عجبا من معرب كيف يبتنى % % 13(@)(@@) % وأولى الندى حجتى اقتنى الحمد مخلصا % فأكرم بما أولى وأعظم بما اقتنى % % 14(@)(@@) % وجلى ثغور الأرض من قلح العدى % % ولم لا وقد جر الأراك من القنا % % 15(@)(@@) % يكاد يعد النبل في 
ms419	 حومة الوغى % % أقاحا وأطراف الأسنة سوسنا % % 16(@)(@@) % أخو فعلات تصرف الروع بائنا % إلى كلمات تنفث السحر بيننا % % 17(@)(@@) % لئن أجريت ذكرى المعادن انني % % أرى أرضه للعلم والجود معدنا % % 18(@)(@@) % خليلي هذا من حماة محله % % فعوجا على الأرض التي تنبت الهنا % % 19(@)(@@) % فلا جلق بالسهم تمنع قاصدا % ولا حلب الشهباء تلبس جوشنا % % 20(@)(@@) % غنيت بجدواه فأطربني السرى % % ولا عجب أن يطرب المرء بالغنا % % PageV01P1955 21(@)(@@) % ولا عيب فيه غير أني قصدته % % فأنستني الأيام أهلا وموطنا % % 22(@)(@@) % تعلمت أنواع الكلام برفده % % فأصبحت أعلا الناس شعرا وأحسنا % % 23(@)(@@) % اذا قيل من رب المكارم في الورى % % أقل هو أو رب القريض أقل أنا % % PageV01P1956 البحر : - 1(@)(@@) % ملي الحسن حالي الوجنتين % % متى يقضي وعود الوصل ديني % % 2(@)(@@) % أبثك إن عاذلي المعنى % % رآك بعين حب مثل عيني % % 3(@)(@@) % فحاكى قلبه قلبي خفوقا % وحكمت الهوى في الخافقين % % 4(@)(@@) % لمثل هواك تجنح كل نفس % وتسفح كل ناظرة بعين % % 5(@)(@@) % صددت فما الأسى عندي بقل % ولا دمعي بدون القلتين % % 6(@)(@@) % ولا جلد على انكار دهر % رمى قلبي الوحيد بفرقتين % % 7(@)(@@) % مضى المحبوب ثم مضى شبابي % % وأي العيش يصلح بعد ذين % % 8(@)(@@) % هما هجرا على رغمي فأرخ % % حديث تلهفي بالهجرتين % % 9(@)(@@) % بروحي عاطر الأنفاس ألمى % % رشيق القد ساجي المقلتين % % 10(@)(@@) % يهز مثقفا من معطفيه % % ومن جفنيه يجذب مرهفين % % PageV01P1957 11(@)(@@) % له خالان في دينار خد % تباع له القلوب بحبتين % % 12(@)(@@) % وحول نقا سوالفه عذار % كما شعرت نقوش في لجين % % 13(@)(@@) % أظل اذا نظرت لوجنتيه % % أنزه في النقا والرقمتين % % 14(@)(@@) % فيالله من غصن فريد % وفي خديه كلتا الجنتين % % 15(@)(@@) % أما وحباب مبسمه المفدى % % على معسول كأس المرشفين % % 16(@)(@@) % لقد عذبت موارده ولكن % % ندى المنصور أحلى الموردين % % 17(@)(@@) % ندى ملك له في الملك جد % % وجد فهو عدل الشاهدين % % 18(@)(@@) % يمد بساعدين إلى المعالي % % ويتعب في النوال براحتين % % 19(@)(@@) % كثير السعي في شرف ومجد % قليل الشكو من ضجر وأين % % 20(@)(@@) % كأن هواه في حب العطايا % % يطالبه بدين لا بدين % % PageV01P1958 21(@)(@@) % اذا ما أشرقت خداه بشرا % % فعوذها 
ms420	 برب المشرقين % % 22(@)(@@) % وإن حمل السلاح ليوم حرب % فقل في الليث ماضي الماضغين % % 23(@)(@@) % يهش السيف في يمناه عجبا % % ويبسم بالهنا سن الرديني % % 24(@)(@@) % ورب طلوب حلم قد دعاه % % فعاد بهين الأخلاق لين % % 25(@)(@@) % بأروع ناصري الذكر مافي % % رواية فضله مثقال رين % % 26(@)(@@) % يصيخ للفظ مادحه بأذن % وينعم من خزائنه بعين % % 27(@)(@@) % ويجمع بالثنا والأجر دنيا % % وآخره فيرضى الضرتين % % 28(@)(@@) % على حين الشبيبة في اقتبال % % وفرع الملك زاهي المعطفين % % 29(@)(@@) % يقل لذكره الاقبال قدما % وكيف يقاس ذو زين بشين % % 30(@)(@@) % فلا تتبع لتبع ذكر جور % % ودعنا من رعونة ذي رعين % % PageV01P1959 31(@)(@@) % أقام محمد للفضل شرعا % محاما كان من شك ومين % % 32(@)(@@) % ورادف حسن خلق حسن خلق % % فلم يقنع باحدى الحسنيين % % 33(@)(@@) % كذا فليبق في أفق المعالي % % ووالده بقاء الفرقدين % % 34(@)(@@) % أصوغ له مدائح لم يصغها % % على سيف العلى نجل الحسين % % 35(@)(@@) % وأطلق فيه ألفاظا تسامت % % على ألفاظ رهن المحسنين % % PageV01P1960 البحر : - 1(@)(@@) % بأبي مائسة يثني على % % قدها بان النقا اذ تنثني % % 2(@)(@@) % نطقت وابتسمت عن جوهر % % يا له في فمها من معدن % % 3(@)(@@) % فاسقني صرف الحميا أطلسا % % معها يوم اللقا لا مع دني % % 4(@)(@@) % درة أو زهوة أو زهرة % فاجتبي أو فاجتلي أو فاجتني % % 5(@)(@@) % وامتدح من آل شاد ملكا % طاهر السر كريم العلن % % 6(@)(@@) % أفضل المنعت والذات فقل % % وانظم الأبيات فيه وانثني % % 7(@)(@@) % وادع من يدع لقا أمداحنا % % وهو عنها بأياديه عني % % 8(@)(@@) % ملك لولا حماه الرحب ما % % جلب الشعر بأغلى ثمن % % 9(@)(@@) % تقتني الجوهر أملاك الردى % % وهو للألفاظ منا يقتني % % 10(@)(@@) % عاقني الفخر عن السعي فيا % % حسدي للطرس إذ يسبقني % % PageV01P1961 11(@)(@@) % قف بباب الملك الأفضل يا % % طرسي الماثل واشرح شجني % % 12(@)(@@) % سيدي بعد نداك المرتجى % % لا تسل عن حالي الممتحن % % 13(@)(@@) % أنا والجارية القفحاء في % % حال جوع مخرس للألسن % % 14(@)(@@) % قد عرانا من طوانا زمن % ما عهدنا مثله من زمن % % 15(@)(@@) % ولقد تشكو فما أفهمها % % ولقد أشكو فما تفهمني % % 16(@)(@@) % غير أني بالجوى أعرفها % % وهي أيضا بالجوى تعرفني % % 17 