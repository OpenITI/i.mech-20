ms143	(@)(@@) لا اعرف له رواية قال النسائي ليس بثقة(@)(@@)(@@)(@@) $ 2835 صالح بن عبيد أبو مصعب(@)(@@) عن وهب بن منبه مجهول(@)(@@)(@@)(@@) $ 2836 صالح بن عمرو عن ابان(@)(@@) قال الدارقطني منكر الحديث(@)(@@)(@@)(@@) $ 2837 صالح بن عمران أبو شعيب الدعاء صاحب أبي عبيد صويلح الحديث وليس بالقوي(@)(@@)(@@)(@@) $ 2838 صالح بن كندير مجهول(@)(@@)(@@)(@@) $ 2839 صالح بن كيسان امام رمي بالقدر ولم يصح عنه(@)(@@)(@@)(@@) $ 2840 د ت ق(@)(@@) صالح بن محمد بن زائدة أبو واقد PageV01P304 عن ابن المسيب صويلح(@)(@@) قال الدارقطني ضعيف وقال أبو أحمد ما ارى به بأسا وقال ابن معين ضعيف(@)(@@)(@@)(@@) $ 2841 صالح بن محمد الترمذي عن محمد بن مروان السدي(@)(@@) قال ابن حبان لا يحل كتب حديثه وكان جهميا(@)(@@)(@@)(@@) $ 2842 صالح بن مسلم عن أبي الزبير(@)(@@) ضعفه يحيى بن معين وابو حاتم روى عنه موسى بن سعيد ويونس المؤدب(@)(@@)(@@)(@@) $ 2843 صالح بن مقاتل عن أبيه(@)(@@) قال الدارقطني ليس بالقوي(@)(@@)(@@)(@@) $ 2844 صالح بن مهران مولى عمرو بن حريث عن أبي هريرة(@)(@@) تأخر روى عنه أبو بكر بن عياش ضعفه ابن معين(@)(@@)(@@)(@@) $ 2845 ت ق(@)(@@) صالح بن موسى الطلحي عن منصور ضعفوه(@)(@@)(@@)(@@) $ 2846 صالح بن ميسرة رأى انس بن مالك مجهول(@)(@@)(@@)(@@) $ 2847 د ت ق(@)(@@) صالح بن نبهان مولى التوأمة(@)(@@) تابعي صدوق لكنه عمر واختلط وثقه يحيى بن معين وقال أبو أحمد صالح الحديث وقال أبو حاتم ليس بقوي وقال أحمد ايضا من سمع منه قديما فسماعه حسن ومن سمع منه اخيرا كأنه يضعف سماعه وقال البخاري ابن أبي ذئب سمع منه اخيرا له عنه مناكير(@)(@@)(@@)(@@) $ 2848 صالح بن واقد الليثي(@)(@@) قال أبو حاتم ليس بالقوي وبيض له(@)(@@)(@@)(@@) $ 2849 صالح بن الوليد عن جدته وعنه التبوذكي مجهول(@)(@@)(@@)(@@) $ 2850 د س ق(@)(@@) صالح بن يحيى بن المقدام عن أبيه(@)(@@) قال البخاري فيه نظر PageV01P305(@)(@@)(@@)(@@) $ 2851 صالح العبدي عن ابن سيرين(@)(@@)(@@)(@@) $ 2852 وصالح السلمي عن أبي الشعثاء مجهولان(@)(@@)(@@)(@@) $ 2853 صامت بن المخيل اليشكري عن رؤبة بن العجاج مجهول(@)(@@)(@@)(@@) $ 2854 صباح بن سهل أبو سهل عن حصين ضعفوه(@)(@@)(@@)(@@) $ 2855 
ms144	 صباح بن عبد الله العبدي عن بعض التابعين يجهل(@)(@@)(@@)(@@) $ 2856 صباح بن مجالد شيخ لبقية مجهول وخبره باطل(@)(@@) ق(@)(@@)(@@)(@@) $ 2857 صباح بن محارب كوفي نزل الري صدوق(@)(@@) قال العقيلي يخالف في بعض حديثه واثنى عليه أبو زرعة وابو حاتم(@)(@@)(@@)(@@) $ 2858 ت(@)(@@) صباح بن محمد البجلي عن مرة الطيب(@)(@@) قال ابن حبان يروي الموضوعات قلت له حديثان عن مرة عن ابن مسعود قوله فرفعهما وهما منه وقد قال أحمد العجلي صباح بن محمد كوفي ثقة(@)(@@)(@@)(@@) $ 2859 صباح بن موسى(@)(@@) عن أبي داود السبيعي ليس بالمتين(@)(@@)(@@)(@@) $ 2860 عخ(@)(@@) صباح العبدي شيخ للتبوذكي هو ابن عبد الله مر وقد وثقه ابن معين(@)(@@)(@@)(@@) $ 2861 صباح بن يحيى عن الحارث بن حصيرة(@)(@@) قال البخاري فيه نظر(@)(@@)(@@)(@@) $ 2862 صبح بن بزيع عن الاوزاعي(@)(@@) قال أبو حاتم ليس بشيء(@)(@@)(@@)(@@) $ 2863 صبيح بن سعيد عن عثمان وعائشة(@)(@@) قال يحيى كذاب خبيث(@)(@@)(@@)(@@) $ 2864 الصبي بن الاشعث السلولي(@)(@@) عن عطية له مناكير ولم يترك PageV01P306(@)(@@)(@@)(@@) $ 2865 صخر بن عبد الله بن حرملة أبو حاجب عن الليث اتهم بالوضع(@)(@@)(@@)(@@) $ 2866 صخر بن أبي غليظ عن أبي سلمة بن عبد الرحمن(@)(@@) ضعفه أبو حاتم(@)(@@)(@@)(@@) $ 2867 صخر بن محمد المنقري الحاجبي المروزي عن مالك(@)(@@) قال ابن طاهر المقدسي كذاب(@)(@@)(@@)(@@) $ 2868 صدقة بن الحسين البغدادي الحنبلي الناسخ(@)(@@) متأخر رديء الإعتقاد(@)(@@)(@@)(@@) $ 2869 صدقة بن رستم الاسكاف عن المسيب بن رافع ثقة لينه ابن حبان(@)(@@)(@@)(@@) $ 2870 ت س ق(@)(@@) صدقة بن عبد الله السمين عن ابن المنكدر ضعفه أحمد والبخاري وغيرهما(@)(@@)(@@)(@@) $ 2871 فق(@)(@@) صدقة بن عمرو الغساني عن بعض التابعين مجهول(@)(@@)(@@)(@@) $ 2872 صدقة بن عمرو المكي عن عطاء مجهول فلعله الذي قبله(@)(@@)(@@)(@@) $ 2873 صدقة بن عيسى عن أنس(@)(@@) قال الدارقطني متروك نزل الكوفة كذا سماه عبيد الله بن موسى وسماه يونس المؤدب وأبو الوليد عيسى بن صدقة قال خ ضعيف PageV01P307(@)(@@)(@@)(@@) $ 2874 د ت(@)(@@) صدقة بن موسى الدقيقي عن ثابت(@)(@@) ضعفوه له عن مالك بن دينار عن عبدالله بن غالب عن أبي سعيد مرفوعا خصلتان لا يجتمعان في 
ms145	 مؤمن البخل وسوء الخلق خرجه ت(@)(@@)(@@)(@@) $ 2875 صدقة بن موسى بن تميم(@)(@@) عن أبيه عن حميد الطويل بخبر باطل(@)(@@)(@@)(@@) $ 2876 صدقة بن هرمز الرماني(@)(@@) عن عاصم بن بهدلة ضعفه ابن معين(@)(@@)(@@)(@@) $ 2877 صدقة بن يزيد(@)(@@) عن حماد بن أبي سليمان ضعفوه(@)(@@)(@@)(@@) $ 2878 صدقة بن يزيد الخراساني نزيل الشام عن العلاء بن عبد الرحمن وإبراهيم الصائغ وثقه أبو زرعة النصري وقال ابن معين صالح الحديث وقال ابن حبان لا يجوز الاشتغال بحديثه وقال ابن عدي هو إلى الضعف اقرب(@)(@@)(@@)(@@) $ 2879 صدقة الزماني شيخ لابي داود الطيالسي ضعفه ابن معين بصري(@)(@@)(@@)(@@) $ 2880 صديق بن موسى(@)(@@) روى عنه ابن جريج ليس بالحجة(@)(@@)(@@)(@@) $ 2881 د(@)(@@) صرد بن أبي المنازل عن بعض التابيعين(@)(@@) بصري لا يعرف(@)(@@)(@@)(@@) $ 2882 الصعب بن يزيد عن حماد بن زيد وغيره مجهول(@)(@@)(@@)(@@) $ 2883 الصعق بن حبيب وقيل الصقر عن أبي رجاء العطاردي(@)(@@) تكلم فيه ابن حبان(@)(@@)(@@)(@@) $ 2884 صعصعة بن صوحان(@)(@@) ذكره الجوزجاني في الضعفاء وعده في الخوارج ووثقه غيره سمع عثمان PageV01P308(@)(@@)(@@)(@@) $ 2885 صغدي بن سنان أبو معاوية(@)(@@) عن الجريري ضعفوه(@)(@@)(@@)(@@) $ 2886 صغدي بن عبد الله(@)(@@) عن قتادة له حديث ينكر(@)(@@)(@@)(@@) $ 2887 صفوان بن أبي الصهباء(@)(@@) عن بكير بن عتيق ضعفه ابن حبان(@)(@@)(@@)(@@) $ 2888 صفوان بن عمران الأصم(@)(@@) عن صحابي في طلاق المكره قال أبو حاتم ليس بقوي(@)(@@)(@@)(@@) $ 2889 صفوان بن قبيصة عن طارق بن شهاب مجهول(@)(@@)(@@)(@@) $ 2890 صفوان بن هبيرة البصري(@)(@@) روى عنه الحسن الحلواني لا يعرف قال العقيلي لا يتابع عليه(@)(@@)(@@)(@@) $ 2891 صقر بن عبد الرحمن عن ابن ادريس(@)(@@) قواه أبو حاتم وكذبه غير واحد(@)(@@)(@@)(@@) $ 2892 الصلت بن بهرام عن أبي وائل(@)(@@) قال ابن عيينة كان أصدق أهل الكوفة ووثقه غيره وأما أبو زرعة فتكلم فيه لمكان الارجاء(@)(@@)(@@)(@@) $ 2893 الصلت بن حجاج عن محمد بن جحادة(@)(@@) عامة حديثه منكر ذكره ابن عدي(@)(@@)(@@)(@@) $ 2894 ت ق(@)(@@) الصلت بن دينار أبو شعيب المجنون عن أبي عثمان PageV01P309 النهدي ضعفوه وبعضهم تركه وقال الدارقطني ليس بقوي(@)(@@)(@@)(@@) $ 2895 الصلت بن سالم عن زيد بن أسلم 
ms146	(@)(@@) قال أبو حاتم ليس بشيء(@)(@@)(@@)(@@) $ 2896 الصلت بن عبد الرحمن الأنصاري عنه ابن عجلان مجهول(@)(@@)(@@)(@@) $ 2897 الصلت بن قويد عن أبي هريرة(@)(@@) ذكره النسائي فساق له حديثه الذي في جزء ابن عرفة لا تقوم الساعة حتى لاتنطح ذات قرن جماء ثم قال النسائي لا أدري كيف هو حديثه منكر(@)(@@)(@@)(@@) $ 2898 صلة بن سليمان العطار عن ابن جريج تركوا حديثه(@)(@@)(@@)(@@) $ 2899 صهيب بن مهران(@)(@@)(@@)(@@) $ 2900 وصهيب عن الحسن مجهولان(@)(@@)(@@)(@@) $ 2901 س(@)(@@) صهيب المكي الحذاء(@)(@@) لا يعرف تفرد عنه عمرو ابن دينار وقد وثقه بعضهم(@)(@@)(@@)(@@) $ 2902 م د س(@)(@@) صهيب أبو الصهباء عن ابن عباس وعلي وثقه أبو زرعة وغيره واما النسائي فقال بصري ضعيف وقد خرج له في كتابه PageV01P310(@)(@@)(@@)(@@) | حرف الضاد(@)(@@)(@@)(@@) $ 2903 ضبارة بن مالك شيخ لبقية لا يعرف(@)(@@)(@@)(@@) $ 2904 الضحاك بن حجوة عن ابن عيينة(@)(@@) قال الدارقطني كان يضع الحديث(@)(@@)(@@)(@@) $ 2905 ن(@)(@@) الضحاك بن حمرة عن عمرو بن شعيب(@)(@@) قال النسائي وغيره ليس بثقة(@)(@@)(@@)(@@) $ 2906 الضحاك بن درهم بيض له ابن أبي حاتم(@)(@@) قال ابن معين ضعيف(@)(@@)(@@)(@@) $ 2907 الضحاك بن زيد الأهوازي عن اسماعيل بن أبي خالد(@)(@@) قال ابن حبان لا يحتج به(@)(@@)(@@)(@@) $ 2908 د ق(@)(@@) الضحاك بن شرحبيل عن زيد بن أسلم(@)(@@) ضعفه الإمام أحمد(@)(@@)(@@)(@@) $ 2909 الضحاك بن شرحبيل الغافقي مصري(@)(@@) عن أبي هريرة صدوق مقل(@)(@@)(@@)(@@) $ 2910 الضحاك بن عباد عن عكرمة وعنه يوسف السمتي لا شيء PageV01P311(@)(@@)(@@)(@@) $ 2911 م عه(@)(@@) الضحاك بن عثمان(@)(@@) قال يعقوب بن شيبة صدوق في حديثه ضعف لينه القطان(@)(@@)(@@)(@@) $ 2912 عه(@)(@@) الضحاك بن مزاحم البلخي المفسر(@)(@@) وثقه أحمد وابن معين وأبو زرعة وغيرهم وضعفه يحيى القطان وشعبة ايضا وهو قوي في التفسير(@)(@@)(@@)(@@) $ 2913 الضحاك بن مسافر شيخ(@)(@@) روى عنه الوليد الموقري لا يعرف(@)(@@)(@@)(@@) $ 2914 الضحاك بن نبراس عن ثابت(@)(@@) قال النسائي متروك وخرج له البخاري في الأدب وضعفه الدارقطني(@)(@@)(@@)(@@) $ 2915 الضحاك بن يسار بصري(@)(@@) ضعفه ابن معين وغيره وقواه أبو حاتم(@)(@@)(@@)(@@) $ 2916 الضحاك الضبي عن أبيه مجهول(@)(@@)(@@)(@@) $ 2917 ق(@)(@@) الضحاك المعافري عن سليمان بن موسى 
ms147	 لا يعرف(@)(@@)(@@)(@@) $ 2918 ضرار بن سهل(@)(@@) عن ابن عرفة بخبر موضوع فيه جهالة(@)(@@)(@@)(@@) $ 2919 ضرار بن صرد أبو نعيم الطحان عن إبراهيم بن سعد(@)(@@) قال البخاري متروك وقال ابن معين كذابان بالكوفة هذا وأبو نعيم النخعي(@)(@@)(@@)(@@) $ 2920 ضرار بن عمرو الملطي عن يزيد الرقاشي متروك الحديث PageV01P312(@)(@@)(@@)(@@) $ 2921 ضرار بن مسعود(@)(@@) جاء في سند مظلم بخبر كذب في فضل خوارزم(@)(@@)(@@)(@@) $ 2922 ضمام بن اسماعيل مصري صدوق لينه بعض الحفاظ(@)(@@)(@@)(@@) $ 2923 د(@)(@@) ضمضم بن زرعة عن شريح بن عبيد وثقه ابن معين وضعفه أبو حاتم PageV01P313(@)(@@)(@@)(@@) | حرف الطاء(@)(@@)(@@)(@@) $ 2924 طارق بن أبي الحسناء عن الحسن البصري وعنه الأعمش مجهول(@)(@@)(@@)(@@) $ 2925 د(@)(@@) طارق بن زياد قال ابن خراش مجهول(@)(@@)(@@)(@@) $ 2926 ع(@)(@@) طارق بن عبد الرحمن البجلي عن سعيد بن المسيب ثقة مشهور إلا أن أحمد بن حنبل قال ليس حديثه بذاك وقال القطان هو عندي كابراهيم بن مهاجر(@)(@@)(@@)(@@) $ 2927 طارق بن عبد الرحمن عن ميمونة وثق وقال النسائي ليس بالقوي(@)(@@)(@@)(@@) $ 2928 طارق بن عمار عن أبي الزناد تكلم فيه(@)(@@)(@@)(@@) $ 2929 طالب بن بشير المدني مجهول(@)(@@)(@@)(@@) $ 2930 طالب بن حبيب بن سهل واه ذكره ابن عدي في كتابه وقال ارجو أنه لا بأس به(@)(@@)(@@)(@@) $ 2931 طالوت بن طريف يروي عنه أبو مطيع البلخي الفقيه مجهول(@)(@@)(@@)(@@) $ 2932 طالوت بن عباد الصيرفي مشهور ما علمت أحدا ضعفه PageV01P314 قال أبو حاتم صدوق وأما ابن الجوزي فقال ضعفه علماء النقل(@)(@@)(@@)(@@) $ 2933 طاهر بن حماد بن عمرو بن النصيبي عن مالك وغيره واه منكر الحديث فمن بلاياه ثنا العمري عن نافع عن ابن عمر قال صليت خلف النبي صلى الله عليه وسلم وأبي بكر وعمر ف كلهم جهروا ببسم الله الرحمن الرحيم(@)(@@)(@@)(@@) $ 2934 طاهر بن خالد بن نزار الأيلي صدوق وله ما يستنكر وينفرد به(@)(@@)(@@)(@@) $ 2935 طاهر بن الفضل الحلبي عن سفيان بن عيينة اتهمه ابن حبان بالوضع(@)(@@)(@@)(@@) $ 2936 طريف بن زيد عن ابن جريج حراني خبره منكر وليس بالمعروف(@)(@@)(@@)(@@) $ 2937 طريف بن سلمان أبو عاتكة عن أنس قال أبو 
ms148	 حاتم ذاهب الحديث(@)(@@)(@@)(@@) $ 2938 ت ق(@)(@@) طريف بن شهاب وقيل ابن سفيان الأشل أبو سفيان عن أبي نضرة تركوه(@)(@@)(@@)(@@) $ 2939 طريف بن عبيد الله الموصلي كان بعد الثلاثمائة ضعفه الدارقطني(@)(@@)(@@)(@@) $ 2940 طريف بن عيسى الجزري متأخر ضعفه الدارقطني ايضا(@)(@@)(@@)(@@) $ 2941 طريف بن ناصح عن معاوية بن عمار بخبر منكر شيعي نكرة(@)(@@)(@@)(@@) $ 2942 طريف بن يزيد عن أبي موسى مجهول كشيخه أبي موسى(@)(@@)(@@)(@@) $ 2943 طريف الكوفي عن ابن عباس مجهول PageV01P315(@)(@@)(@@)(@@) $ 2944 طعمة بن عمرو الجعفري كوفي قال الدارقطني ليس بحجة له عن عمر بن بيان التغلبي قلت وثقه ابن معين ولحقه سعيد بن منصور(@)(@@)(@@)(@@) $ 2945 الطفيل بن عمرو التميمي عن صعصعة بن ناجية لا يعرف(@)(@@)(@@)(@@) $ 2946 الطفيل ابن عم شريك القاضي روى عنه ابن فضيل مجهول(@)(@@)(@@)(@@) $ 2947 الطفيل المؤذن روى عنه عون بن سلام مجهول ايضا(@)(@@)(@@)(@@) $ 2948 طلحة بن خير عن المطلب بن عبد الله مختلف في الاحتجاج به وهاه الجوزجاني(@)(@@)(@@)(@@) $ 2949 طلحة بن رافع روى عنه صالح بن كيسان مجهول(@)(@@)(@@)(@@) $ 2950 طلحة بن زيد عن الاعمش ضعفوه(@)(@@)(@@)(@@) $ 2951 ق(@)(@@) طلحة بن زيد الرقي عن هشام بن عروة والاوزاعي ضعفوه وقيل كان يكذب(@)(@@)(@@)(@@) $ 2952 طلحة بن سمرة يروي عنه عبد الحكم بن محمد(@)(@@)(@@)(@@) $ 2953 وطلحة بن صالح يروي عنه إبراهيم بن حمزة الزبيري(@)(@@)(@@)(@@) $ 2954 وطلحة بن عبد الله الكندي عن زاذان مجهولون(@)(@@)(@@)(@@) $ 2955 طلحة بن عبد الرحمن المؤدب عن قتادة قال ابن عدي له مناكير(@)(@@)(@@)(@@) $ 2956 طلحة بن أبي طلحة الجوباري الجرجاني عن يحيى بن يحيى قال الاسماعيلي كتبت عنه وانا صغير مغموز عليه(@)(@@)(@@)(@@) $ 2957 طلحة بن عمرو الحضري المكي عن عطاء قال احمد PageV01P316 لاشيء متروك الحديث وقال ابن معين والدارقطني وغير واحد ضعيف(@)(@@)(@@)(@@) $ 2958 طلحة بن كيسان مجهول(@)(@@)(@@)(@@) $ 2959 طلحة بن محمد الشاهد قال ابن أبي الفوارس كان يدعو إلى الاعتزال(@)(@@)(@@)(@@) $ 2960 م عه(@)(@@) طلحة بن نافع هو أبو سفيان عن جابر ثقة قال ابن عيينة انما هي صحيفة وقال أبو أحمد ما به بأس وقال ابن معين لا شيء 
ms149	 خ قرنه بآخر(@)(@@)(@@)(@@) $ 2961 م عه(@)(@@) طلحة بن يحيى بن طلحة بن عبيد الله وثقه ابن معين وقال أبو زرعة صالح الحديث وقال البخاري منكر الحديث له عن أبيه ومجاهد(@)(@@)(@@)(@@) $ 2962 خ م(@)(@@) طلحة بن يحيى بن النعمان بن أبي عياش عن التابعين قال أبو حاتم وغيره ليس بقوي ووثقه يحيى بن معين وقال أحمد ابن حنبل مقارب الحديث(@)(@@)(@@)(@@) $ 2963 طلحة بن يزيد عن جعفر بن أبي المغيرة(@)(@@)(@@)(@@) $ 2964 وطلحة عن أبي شهدة مجهولان(@)(@@)(@@)(@@) $ 2965 طلحة القناد الواسطي عن قال أبو داود ليس بالقوي PageV01P317(@)(@@)(@@)(@@) $ 2966 طلحة أبو اليسع عن ابن عباس لا يعرف قال بعضهم لا يتابع على حديثه في اكل اللحم باللبن(@)(@@)(@@)(@@) $ 2967 طلحة روى عنه الليث بن سعد لا يعرف(@)(@@)(@@)(@@) $ 2968 طلق بن حبيب العابد من جلة التابعين الا انه كان يرى الارجاء(@)(@@)(@@)(@@) $ 2969 طلق بن السمح المصري عن يحيى بن ايوب فيه ضعف(@)(@@)(@@)(@@) $ 2970 طلق بن معاوية عن سفيان الثوري مجهول فأما(@)(@@)(@@)(@@) $ 2971 طلق بن معاوية جد حفص بن غياث فثقة(@)(@@)(@@)(@@) $ 2972 طليق بن محمد عن عمران بن حصين منقطع وقال الدارقطني لا يحتج به(@)(@@)(@@)(@@) $ 2973 طود بن عبد الملك القيسي شيخ لابن المبارك مجهول(@)(@@)(@@)(@@) $ 2974 طيب بن زبان عن زياد بن سيار حكى عنه أبو زرعة ما يوهيه(@)(@@)(@@)(@@) $ 2975 طيب بن سلمان عن عمرة قال الدارقطني بصري ضعيف(@)(@@)(@@)(@@) $ 2976 الطيب بن محمد عن عطاء بن أبي رباح يمامي فيه جهالة وله ما ينكر PageV01P318(@)(@@)(@@)(@@) | حرف الظاء(@)(@@)(@@)(@@) $ 2977 ظبيان بن صبيح الضبي شيخ لمبارك بن فضالة لا يدرى من ذا(@)(@@)(@@)(@@) $ 2978 ظبيان بن محمد الحمصي عن أبيه قال ابن حبان لا يحل الاحتجاج به(@)(@@)(@@)(@@) $ 2979 ظليم بن حطيط عن الحسن بن علي الرقي بحديث منكر وشيخه لا يعرف PageV01P319(@)(@@)(@@)(@@) | حرف العين(@)(@@)(@@)(@@) $ 2980 ع(@)(@@) عاصم بن رجاء بن حيوة صويلح(@)(@@)(@@)(@@) $ 2981 عاصم بن سليمان الاحول تابعي ثقة قال القطان ليس بالحافظ وقال أبو أحمد الحاكم ليس بالحافظ عندهم(@)(@@)(@@)(@@) $ 2982 عاصم بن سليمان البصري الكوزي وكوز قبيلة عن هشام بن عروة 
ms150	 روى بسند الصحيحين الشرب على الريق يعقد الشحم كذبه غير واحد(@)(@@)(@@)(@@) $ 2983 عاصم بن شميخ عن أبي سعيد الخدري مجهول وقد وثق روى عنه اثنان(@)(@@)(@@)(@@) $ 2984 عه(@)(@@) عاصم بن ضمرة صاحب علي وثقه ابن المديني ويحيى وقال النسائي ليس به بأس وقال أحمد هو اعلى من الحارث واما ابن عدي فقال ينفرد عن علي بأحاديث والبلية منه(@)(@@)(@@)(@@) $ 2985 عاصم بن طلحة عن انس بن مالك قال أبو الفتح الازدي ضعيف مجهول PageV01P320(@)(@@)(@@)(@@) $ 2986 تق(@)(@@) عاصم بن عبد العزيز الاشجعي عن هشام بن عروة قال النسائي والدارقطني ليس بالقوي(@)(@@)(@@)(@@) $ 2987 دتق(@)(@@) عاصم بن عبيد الله بن عاصم بن عمر عن أبيه ضعفه مالك وابن معين(@)(@@)(@@)(@@) $ 2988 خ ت ق(@)(@@) عاصم بن علي بن عاصم الواسطي شيخ البخاري صدوق ضعفه ابن معين فقال لا شيء وذكر له ابن عدي أحاديث مناكير(@)(@@)(@@)(@@) $ 2989 ت ق(@)(@@) عاصم بن عمر عن حفص العمري اخو عبيد الله عن عبد الله بن دينار ضعفوه(@)(@@)(@@)(@@) $ 2990 ق(@)(@@) عاصم بن عمر عن عروة لا يعرف وكذا(@)(@@)(@@)(@@) $ 2991 ت س(@)(@@) عاصم بن عمرو عن علي(@)(@@)(@@)(@@) $ 2992 م عه(@)(@@) عاصم بن كليب الجرمي عن أبي بردة كان من الأولياء ثقة قال ابن المديني لا يحتج بما انفرد به وقال أبو حاتم صالح(@)(@@)(@@)(@@) $ 2993 عاصم بن مخلد عن أبي الاشعث الصنعاني لا يعرف تفرد قزعة بن سويد الباهلي وهو مضطرب الحديث عن عاصم بن مخلد عن أبي الأشعث عن شداد بن اوس رفعه من قرض بيت شعر بعد العشاء لم تقبل له صلاة تلك الليلة PageV01P321(@)(@@)(@@)(@@) $ 2994 عاصم بن مضرس عن سفيان الثوري قال أبو حاتم الرازي منكر الحديث وقال النسائي ليس بالحافظ وقال يحيى القطان ما وجدت رجلا اسمه عاصم الا وجدته رديء الحفظ(@)(@@)(@@)(@@) $ 2995 خ م مقرونا عه(@)(@@) عاصم بن أبي النجود الأسدي مولاهم القارىء قال س ليس بحافظ وقال الدارقطني في حفظه شيء(@)(@@)(@@)(@@) $ 2996 س(@)(@@) عاصم بن هلال البارقي عن ايوب ضعفه يحيى بن معين وقال يحيى بن سعيد القطان كل 
ms151	 من وجدت اسمه عاصما وجدته ردىء الحفظ وقال ابن علية من كان اسمه عاصما كان في حفظه شيء وقال أبو داود عاصم بن هلال ليس به بأس(@)(@@)(@@)(@@) $ 2997 عاصم أبو مالك العطار مجهول شيخ لزيد بن الحباب(@)(@@)(@@)(@@) $ 2998 عاصم الحداني شيخ لبقية لايعرف(@)(@@)(@@)(@@) $ 2999 عافية القاضي عن الاعمش وثقه النسائي وقال أبو داود يكتب حديثه وقال ابن معين ضعيف ووثقه مرة(@)(@@)(@@)(@@) $ 3000 عافية بن ايوب ثنا الليث بن سعد تكلم فيه(@)(@@)(@@)(@@) $ 3001 عامر بن خارجة عن جده سعد بن مالك قال البخاري في اسناده نظر(@)(@@)(@@)(@@) $ 3002 عامر بن خداش النيسابوري كان بعد المائتين صاحب مناكير PageV01P322(@)(@@)(@@)(@@) $ 3003 عامر بن سيار عن سوار بن مصعب مجهول(@)(@@)(@@)(@@) $ 3004 س(@)(@@) عامر بن شداد عن عمرو بن الحمق لا يعرف(@)(@@)(@@)(@@) $ 3005 عامر بن شعيب عن ابن عيينة قال الحاكم له موضوعات(@)(@@)(@@)(@@) $ 3006 د ت ق(@)(@@) عامر بن شقيق الاسدي عن أبي وائل ضعفه ابن معين وقواه غيره(@)(@@)(@@)(@@) $ 3007 ت(@)(@@) عامر بن صالح بن رستم عن يونس عبيد قال أبو حاتم وغيره ليس بالقوي(@)(@@)(@@)(@@) $ 3008 ت(@)(@@) عامر بن صالح بن عبد الله بن عروة بن الزبير لعل ما روى أحمد عن اضعف منه وقد قال فيه ثقة لم يكن يكذب وقال ابن معين كذاب وقال الدارقطني يترك(@)(@@)(@@)(@@) $ 3009 عامر بن عبد الله بن يساف عن يحيى بن أبي كثير له مناكير(@)(@@)(@@)(@@) $ 3010 عامر بن عبدة البجلي تابعي مجهول(@)(@@)(@@)(@@) $ 3011 عامر بن عمرو مؤذن مسجد ارسوف عن ثابت البناني لا يعرف(@)(@@)(@@)(@@) $ 3012 عامر بن عمرو عن أبي هريرة مجهول(@)(@@)(@@)(@@) $ 3013 عامر بن مصعب قال الدارقطني ليس بالقوي PageV01P323(@)(@@)(@@)(@@) $ 3014 عامر بن هني عن ابن الحنفية قال أبو حاتم ليس بالقوي(@)(@@)(@@)(@@) $ 3015 م عه(@)(@@) عامر الأحول عن أبي الصديق الناجي لينه أحمد وغيره ووثقه أبو حاتم ومسلم واسمه عامر بن عبد الواحد(@)(@@)(@@)(@@) $ 3016 ت(@)(@@) عامر العقيلي شيخ ليحيى بن أبي كثير لا يعرف عن أبيه عن أبي هريرة(@)(@@)(@@)(@@) $ 3017 عه(@)(@@) عامر أبو رملة شيخ لابن عون يجهل(@)(@@)(@@)(@@) $ 3018 عامر 
ms152	 شيخ لعمرو بن أبي ليلى مجهولان(@)(@@)(@@)(@@) $ 3019 عائذ بن أيوب عن إسماعيل بن أبي خالد لا يصح حديثه(@)(@@)(@@)(@@) $ 3020 س ق(@)(@@) عائذ بن حبيب عن هشام بن عروة له مناكير وهو شيعي جلد وثقه ابن معين(@)(@@)(@@)(@@) $ 3021 عائذ بن شريح عن أنس لم أر لهم فيه تضعيفا ولا توثيقا إلا قول أبي حاتم في حديثه ضعف قلت وما هو بحجة(@)(@@)(@@)(@@) $ 3022 عائذ بن نسير عن عطاء بن أبي رباح ضعفه ابن معين وغيره(@)(@@)(@@)(@@) $ 3023 عائذ عن عمر بن أبي سلمة عن أمه بخبر طويل في رؤية الجنة والنار منكر قال أحمد لا أعرف عائذا(@)(@@)(@@)(@@) $ 3024 ق(@)(@@) عائذ الله المجاشعي عن أبي داود الأعمى قال أبو حاتم منكر الحديث(@)(@@)(@@)(@@) $ 3025 عائش بن أنس البكري عن علي قال عبد الرحمن بن PageV01P324 خراش مجهول وعنه عطاء(@)(@@)(@@)(@@) $ 3026 عائشة بنت سعد عن الحسن البصري لا تعرف والراوي عنها متهم(@)(@@)(@@)(@@) $ 3027 عائشة بنت عجرد عن ابن عباس قال الدارقطني لا تقوم بها حجة(@)(@@)(@@)(@@) $ 3028 عباد بن أحمد العرزمي شيخ المقانعي قال الدارقطني متروك(@)(@@)(@@)(@@) $ 3029 ق(@)(@@) عباد بن آدم الهذلي عن شعبة لم يرو عنه غير ابنه محمد(@)(@@)(@@)(@@) $ 3030 عباد بن بشير عن انس وعنه داود بن ايوب القسملى بخبرين باطلين(@)(@@)(@@)(@@) $ 3031 عباد بن جويرية عن الاوزاعي قال أحمد بن حنبل كذاب(@)(@@)(@@)(@@) $ 3032 خ دس ق(@)(@@) عباد بن راشد عن الحسن صدوق قال النسائي ليس بالقوي(@)(@@)(@@)(@@) $ 3033 عباد بن أبي روق قال يحيى بن معين قد رأيته وليس بثقة(@)(@@)(@@)(@@) $ 3034 عباد بن سعيد بصري عن مبشر ليس بشيء(@)(@@)(@@)(@@) $ 3035 عباد بن شيبة الحبطي ويقال له عباد بن ثبيت عن سعيد بن انس يروي عنه عبد الله بن بكر السهمي ضعيف(@)(@@)(@@)(@@) $ 3036 عباد بن أبي صالح السمان اخو سهيل صدوق قال ابن المديني ليس بشيء PageV01P325(@)(@@)(@@)(@@) $ 3037 عباد بن صهيب البصري عن التابعين الصغار تركه غير واحد وبعضهم رماه بالكذب واما أبو داود فقال صدوق قدري(@)(@@) ع(@)(@@)(@@)(@@) $ 3038 عباد بن عباد المهلبي ثقة مشهور وقد قال أبو حاتم 
ms153	 لا يحتج به وذكره ابن سعد في الطبقات فقال لم يكن بالقوي(@)(@@)(@@)(@@) $ 3039 د(@)(@@) عباد بن عباد الارسوفي الزاهد عن ابن عون وثقه ابن معين وغيره واما ابن حبان فقال كان يأتي بالمناكير فاستحق الترك واما(@)(@@)(@@)(@@) $ 3040 عباد بن عباد بن علقمة المازني البصري الذي يروي عنه معتمر بن سليمان فقال ابن معين ثقة ثقة(@)(@@)(@@)(@@) $ 3041 عباد بن عبد الله الاسدي عن علي ضعفه علي بن المديني(@)(@@)(@@)(@@) $ 3042 عباد بن عبد الحميد عن سعيد بن جبير مجهول(@)(@@)(@@)(@@) $ 3043 عباد بن عبد الصمد أبو معمر عن انس قال أبو حاتم وغيره ضعيف جدا(@)(@@)(@@)(@@) $ 3044 عباد بن علي السيريني روى عن بكار السيريني ضعفه الازدي(@)(@@)(@@)(@@) $ 3045 عباد بن عمرو عن انس وعنه ابنه عبد المؤمن لا يحتج به(@)(@@)(@@)(@@) $ 3046 عباد بن العوام ثقة وجاء عن أحمد مضطرب الحديث(@)(@@)(@@)(@@) $ 3047 عباد بن قبيصة عن انس قال الازدي ضعيف PageV01P326(@)(@@)(@@)(@@) $ 3048 عباد بن كثير الكاهلي عن نافع متروك ولعله الرملي(@)(@@)(@@)(@@) $ 3049 ق(@)(@@) عباد بن كثير الرملى عن عبد الله بن دينار قال النسائي ليس بثقة(@)(@@)(@@)(@@) $ 3050 دق(@)(@@) عباد بن كثير الثقفي البصري العابد بمكة عن ثابت قال البخاري تركوه(@)(@@)(@@)(@@) $ 3051 عباد بن كسيب عن الطفيل بن عمرو قال البخاري لا يصح حديثه(@)(@@)(@@)(@@) $ 3052 ت س ق(@)(@@) عباد بن ليث عن بهز بن حكيم قال أحمد ليس بشيء وحسن الترمذي حديثه(@)(@@)(@@)(@@) $ 3053 عباد بن مسلم الفزاري يروي عنه أبو عاصم ضعف والصواب عبادة وانه ثقة(@)(@@)(@@)(@@) $ 3054 عه(@)(@@) عباد بن منصور الناجي بصري عن عكرمة ضعف وقال النسائي ليس بالقوي(@)(@@)(@@)(@@) $ 3055 س(@)(@@) عباد بن ميسرة المنقري عن الحسن ضعفه أحمد وابن معين(@)(@@)(@@)(@@) $ 3056 عباد بن أبي موسى عن سلم عن ميمونة قال البخاري اسناد مجهول(@)(@@)(@@)(@@) $ 3057 ت(@)(@@) عباد بن أبي يزيد عن علي بن أبي طالب لا يدرى من هو PageV01P327(@)(@@)(@@)(@@) $ 3058 خ ت ق(@)(@@) عباد بن يعقوب الرواجني شيعي غال روى عن شريك قوي الحديث قال الدارقطني شيعي صدوق(@)(@@)(@@)(@@) $ 3059 ق(@)(@@) عباد بن يوسف الحمصي كان بعد 
ms154	 المائتين ليس بالقوي(@)(@@)(@@)(@@) $ 3060 عباد الكليبي عن جعفر بن محمد عن آبائه بخبر كذب في فضل علي(@)(@@)(@@)(@@) $ 3061 عبادة أبو يحيى كان قتادة يرميه بالكذب(@)(@@)(@@)(@@) $ 3062 عبادة بن يحيى التوأم عن ابن أبي مليكة ضعفه يحيى ابن معين(@)(@@)(@@)(@@) $ 3063 عبادة عن أبي بردة ابن أبي موسى لا يدرى من هو(@)(@@)(@@)(@@) $ 3064 عبادة بالفتح بن زياد الاسدي عن قيس بن الربيع قال ابن عدي شيعي غال وقال غيره متهم في الحديث وقال أبو حاتم محله الصدق(@)(@@)(@@)(@@) $ 3065 العباس بن أحمد بن العباس شيخ قبل الستمائة تكلم فيه ليس بعمدة(@)(@@)(@@)(@@) $ 3066 عباس بن أحمد الواعظ عن داود بن علي الظاهري ليس بثقة وقد روى عن السري السقطي حديثا هو وضعه يا علي بحب أبي بكر وعمر تدخل الجنة(@)(@@)(@@)(@@) $ 3067 العباس بن بكار عن خاله أبي بكر الهذلي قال الدارقطني كذاب(@)(@@)(@@)(@@) $ 3068 العباس بن الحسن الجزري عن الاعرج PageV01P328(@)(@@)(@@)(@@) $ 3069 وعباس بن اخنس مجهولان(@)(@@)(@@)(@@) $ 3070 العباس بن الحسن البلخي عن اصرم بن حوشب قال ابن عدي في ترجمة اصرم يسرق الحديث(@)(@@)(@@)(@@) $ 3071 العباس بن الحسن الخضرمي بمعجمة مكسورة قال أبو عروبة الحراني لا شيء(@)(@@)(@@)(@@) $ 3072 عباس بن الحسن الحراني عن الزهري واه(@)(@@)(@@)(@@) $ 3073 خ(@)(@@) عباس بن حسين البصري عن مبشر بن اسماعيل مجهول قلت بل ثقة(@)(@@)(@@)(@@) $ 3074 العباس بن الخليل بن جابر الحمصي عن كثير بن عبيد قال أبو أحمد الحاكم فيه نظر(@)(@@)(@@)(@@) $ 3075 عباس بن الضحاك البلخي قبل الثلاثمائة قال ابن حبان دجال(@)(@@)(@@)(@@) $ 3076 العباس بن عبد الله بن عصام الفقيه عن عباس الدوري متهم بالكذب(@)(@@)(@@)(@@) $ 3077 العباس بن عبد الله النخشبي عن يحيى بن معين غمزه ابن يونس(@)(@@)(@@)(@@) $ 3078 العباس بن عتبة عن عطاء لا يصح حديثه(@)(@@)(@@)(@@) $ 3079 العباس بن عمر الكلوذاني عن أبي جعفر بن البختري قال الخطيب كذاب(@)(@@)(@@)(@@) $ 3080 ق(@)(@@) العباس بن الفضل الانصاري الموصلي المقرىء قال ابن معين ليس بثقة(@)(@@)(@@)(@@) $ 3081 العباس بن الفضل الازرق عن همام قال البخاري ذهب حديثه PageV01P329(@)(@@)(@@)(@@) $ 3082 العباس بن الفضل الأرسوفي روى عن محمد 
ms155	 بن عوف الحمصي حديثا ركب(@)(@@)(@@)(@@) $ 3083 العباس بن محمد أبو الفضل الرافقي متأخر قال يحيى الطحان تكلموا فيه(@)(@@)(@@)(@@) $ 3084 العباس بن محمد المرادي قال أبو حاتم روى أحاديث كذبا عن مالك(@)(@@)(@@)(@@) $ 3085 العباس بن محمد العدوي قال ابن حبان روى عن عمار بن هارون المستملي مالا أصل له(@)(@@)(@@)(@@) $ 3086 العباس بن الوليد بن بكار عن أبي بكر الهذلي وقد ينسب إلى جده مر(@)(@@)(@@)(@@) $ 3087 خ م(@)(@@) العباس بن الوليد النرسي ثقة تكلم فيه ابن المديني وقال أبو حاتم يكتب حديثه(@)(@@)(@@)(@@) $ 3088 عباءة بن كليب عن جويرية بن أسماء صدوق وله ماينكر(@)(@@)(@@)(@@) $ 3089 عباية بن ربعي عن علي وعنه موسى بن طريف وكلاهما من الغلاة(@)(@@)(@@)(@@) $ 3090 عبد الله بن أبان الثقفي عن سفيان الثوري مجهول منكر الحديث قاله ابن عدي(@)(@@)(@@)(@@) $ 3091 د ت(@)(@@) عبد الله بن إبراهيم بن أبي عمرو الغفاري شيخ ابن عرفة متهم بالوضع أما PageV01P330(@)(@@)(@@)(@@) $ 3092 عبد الله بن إبراهيم بن عمر بن كيسان الصنعاني معاصر الغفاري فصدوق يروي عن أبيه(@)(@@)(@@)(@@) $ 3093 عبد الله بن إبراهيم المؤدب عن سويد بن سعيد كذبه الدارقطني(@)(@@)(@@)(@@) $ 3094 عبد الله بن أحمد بن أفلح البكري القاص شيخ ليوسف القواسي متهم بالكذب(@)(@@)(@@)(@@) $ 3095 عبد الله بن أحمد بن راشد ابن أخت وليد الفقيه الظاهري ولي قضاء دمشق وغيرها روى عن ابن قتيبة العسقلاني وكان خليعا مرتشيا(@)(@@)(@@)(@@) $ 3096 عبد الله بن أحمد بن القاسم النهاوندي كتب عنه الحاكم ببغداد وقال ليس بثقة(@)(@@)(@@)(@@) $ 3097 عبد الله بن أحمد الدشتكي روى عنه علي بن محمد بن مهرويه حديثا مختلقا(@)(@@)(@@)(@@) $ 3098 عبد الله بن أحمد بن ربيعة بن زبر القاضي ضعف روى عن عباس الدوري وأبي داود السجزي قال الخطيب كان غير ثقة(@)(@@)(@@)(@@) $ 3099 عبد الله بن أحمد اليحصبي الدمشقي عن ابن جريج قال العقيلي لا يتابع على حديثه(@)(@@)(@@)(@@) $ 3100 عبد الله بن أحمد الفارسي عن النجاد قدري داعية ببغداد PageV01P331(@)(@@)(@@)(@@) $ 3101 عبد الله بن أذينه عن ثور بن يزيد قال ابن حبان لا يحتج به(@)(@@)(@@)(@@) $ 3102 عبد الله 
ms156	 بن أزهر هو المصري عن يزيد بن سعيد الاسكندراني قال أبو سعيد بن يونس تعرف وتنكر توفي بعد الثلاثمائة(@)(@@)(@@)(@@) $ 3103 عبد الله بن إسحاق الهاشمي روى عنه محمد بن يحيى القطعي تكلم فيه العقيلي(@)(@@)(@@)(@@) $ 3104 عبد الله بن إسحاق الخراساني مشهور صدوق وقال الدارقطني فيه لين(@)(@@)(@@)(@@) $ 3105 عبد الله بن إسماعيل بن عثمان بصري عن شعبة لينه أبو حاتم وعنه أبو كريب(@)(@@)(@@)(@@) $ 3106 عبد الله بن إسماعيل عن إسماعيل ابن أبي خالد مجهول(@)(@@)(@@)(@@) $ 3107 عبد الله بن أيوب بن أبي علاج الموصلي عن سفيان بن عيينة متهم(@)(@@)(@@)(@@) $ 3108 عبد الله بن أيوب القربي الضرير قال الدارقطني متروك(@)(@@)(@@)(@@) $ 3109 ت(@)(@@) عبد الله بن بارق هو عبد ربه قال أحمد ما به بأس ولينه يحيى(@)(@@)(@@)(@@) $ 3110 دس(@)(@@) عبد الله بن بديل بن ورقاء المكي فيه ضعف غمزه الدارقطني(@)(@@)(@@)(@@) $ 3111 د ت ق(@)(@@) عبد الله بن بحير الصنعاني القاص شيخ PageV01P332 عبد الرزاق وثقه ابن معين وقال ابن حبان لا يحتج به وليس هو ابن بحير بن ريسان فان بحير بن ريسان غزا المغرب زمن معاوية وسكن مصر وروى عن عبادة بن الصامت وعمر دهرا حتى لقيه ابن لهيعة وبكر بن مضر وقال ابن ما كولا في شيخ عبد الرزاق أنا أحسبه عبد الله بن عيسى بن بحير نسب إلى جده وكنيته أبو وائل قلت له مناكير(@)(@@)(@@)(@@) $ 3112 عبد الله بن بزيع عن حميد الطويل قال الدارقطني ليس بقوي(@)(@@)(@@)(@@) $ 3113 ت ق(@)(@@) عبد الله بن بسر الحبراني عن عبد الله بن بسر المازني ضعفوه(@)(@@)(@@)(@@) $ 3114 عبد الله بن بشر الرقي عن الأعمش فيه لين وقال أبو زرعة لا بأس به(@)(@@)(@@)(@@) $ 3115 عبد الله بن بكار عن أبيه عن جده قال العقيلي مجهول(@)(@@)(@@)(@@) $ 3116 ت(@)(@@) عبد الله بن أبي بكر بن زيد عن بعض التابعين مدني لا يعرف(@)(@@)(@@)(@@) $ 3117 ق س(@)(@@) عبد الله بن أبي بكر بن عبد الرحمن بن الحارث بن هشام قال البخاري لا يصح حديثه(@)(@@)(@@)(@@) $ 3118 عبد الله بن أبي بكر المقدمي 
ms157	 أخو محمد عن جعفر بن سليمان ضعفوه(@)(@@)(@@)(@@) $ 3119 عبد الله بن بكير الغنوي الكوفي عن ابن سوقه حديثه منكر وقبله بعضهم وقال أبو حاتم كان من عتق الشيعة(@)(@@)(@@)(@@) $ 3120 عبد الله بن ثابت يروي عن محمد بن حمير مجهول PageV01P333(@)(@@)(@@)(@@) $ 3121 عبد الله بن ثابت المروزي النحوي معاصر لمالك فيه جهالة(@)(@@)(@@)(@@) $ 3122 عبد الله بن جابر بن ربيعة يروي عنه أبو نعيم ضعفه ابن معين(@)(@@)(@@)(@@) $ 3123 عبد الله بن جبير الخزاعي تابعي مجهول(@)(@@)(@@)(@@) $ 3124 عبد الله بن جراد مجهول ولا يصح حديثه لأنه من رواية يعلى بن الأشدق عنه(@)(@@)(@@)(@@) $ 3125 عبد الله بن جرير عن ابن نمير قدري داعية(@)(@@)(@@)(@@) $ 3126 عبد الله بن جرير السعدي عن عبدالله بن نمير موضوع(@)(@@)(@@)(@@) $ 3127 ت ق(@)(@@) عبد الله بن جعفر بن نحيح والد علي بن المديني اتفقوا على ضعفه(@)(@@)(@@)(@@) $ 3128 م متابعه عه(@)(@@) عبد الله بن جعفر المخرمي المدني ثقة وهاه ابن حبان فقط وقال ابن معين صدوق وليس بثبت(@)(@@)(@@)(@@) $ 3129 عبد الله بن جعفر أخو إسماعيل مدني أيضا قال ابن معين ليس بشيء(@)(@@)(@@)(@@) $ 3130 عبد الله بن جعفر الثعلبي شيخ لابن المظفر متهم جاء بخبر من لم يقل علي خير البشر فقد كفر بسند ينفرد به(@)(@@)(@@)(@@) $ 3131 د(@)(@@) عبد الله بن أبي جعفر الرازي عن أبيه وغيره ليس بحجة(@)(@@)(@@)(@@) $ 3132 عبد الله بن الحارث الصنعاني عن عبد الرزاق كذاب(@)(@@)(@@)(@@) $ 3133 عبد الله بن حاضر بن عبدوس قال الدارقطني ليس بالقوي له عن الأنصاري وقيل اسم جده عبد القدوس PageV01P334(@)(@@)(@@)(@@) $ 3134 عبد الله بن الحسن بن غالب عن البغوي ليس بثقة(@)(@@)(@@)(@@) $ 3135 عه(@)(@@) عبد الله بن الحسين أبو حريز قاضي سجستان مختلف فيه قال أبو داود حديثه ليس بشيء(@)(@@)(@@)(@@) $ 3136 عبد الله بن الحسين بن جابر المصيصي قال ابن حبان كان يسرق الأخبار(@)(@@)(@@)(@@) $ 3137 ق(@)(@@) عبد الله بن الحسين بن عطاء بن يسار قال أبو زرعة ضعيف له عن سهيل(@)(@@)(@@)(@@) $ 3138 عبد الله بن الحسين بن عبد الله أبو القاسم أبو رواحة مكثر عن السلفي 
ms158	 وسماعه صحيح لكنه متهم في الشهادات(@)(@@)(@@)(@@) $ 3139 عبد الله بن الحسين أبو أحمد السامري المقريء واه لا يعتمد على قوله(@)(@@)(@@)(@@) $ 3140 عبد الله بن حشرج عن أبيه لا يعرف من هو(@)(@@)(@@)(@@) $ 3141 عبد الله بن حفص بن عمر عن أبيه عن جده قال ابن معين ليس بشيء(@)(@@)(@@)(@@) $ 3142 عبد الله بن حفص لا يعرف(@)(@@)(@@)(@@) $ 3143 عبد الله بن حفص الوكيل لقيه ابن عدي وقال كان يضع الحديث(@)(@@)(@@)(@@) $ 3144 عبد الله بن حكيم أبو بكر الداهري عن التابعين واه متهم بالوضع(@)(@@)(@@)(@@) $ 3145 عبد الله بن حكيم بن جبير الاسدي في زمن هشيم رافضي غال كأبيه PageV01P335(@)(@@)(@@)(@@) $ 3146 عبد الله بن حكيم الشامي عن محمد بن عمرو لا يعرف ذكره العقيلي(@)(@@)(@@)(@@) $ 3147 عبد الله بن حكيم بالتصغير الكناني عن بشر بن قدامة مجهول(@)(@@)(@@)(@@) $ 3148 عبد الله بن حيدر القزويني الفقيه له اربعون لقي زاهرا الشحامي اتهمه ابن الصلاح(@)(@@)(@@)(@@) $ 3149 عبد الله بن خالد بن سلمة المحزومي عن أبيه ضعفوه(@)(@@)(@@)(@@) $ 3150 ق(@)(@@) عبد الله بن خراش بن حوشب عن عمه العوام ضعفه الدارقطني(@)(@@)(@@)(@@) $ 3151 عبد الله بن خلج الصنعاني عن وهب ضعفه هشام بن يوسف(@)(@@)(@@)(@@) $ 3152 عبد الله بن خلف الطفاوي عن هشام بن حسان تكلم فيه العقيلي(@)(@@)(@@)(@@) $ 3153 عه(@)(@@) عبد الله بن الخليل الحضرمي عن زيد بن ارقم في القرعة قال البخاري لا يتابع عليه(@)(@@)(@@)(@@) $ 3154 عبد الله بن خيران البغدادي عن شعبة قال العقيلي لا يتابع على حديثه يعني من حيث السند وقبله غيره(@)(@@)(@@)(@@) $ 3155 ت(@)(@@) عبد الله بن داود الواسطي التمار عن حنظلة بن أبي سفيان ضعفوه PageV01P336(@)(@@)(@@)(@@) $ 3156 عبد الله بن داهر الرازي الاحمري عن أبيه رافضي ضعفوه(@)(@@)(@@)(@@) $ 3157 عبد الله بن دكين أبو عمر الكوفي معاصر لشعبة وثقه جماعة وضعفه أبو زرعة(@)(@@)(@@)(@@) $ 3158 ع(@)(@@) عبد الله بن دينار مولى ابن عمر ثقة ثبت تفرد بحديث الولاء عن ابن عمر قال العقيلي في رواية المشايخ عنه اضطراب ثم ساق له حديثين مضطربي الاسناد والاضطراب من غيره وأخطأ العقيلي في إيراده في 
ms159	 كتاب الضعفاء(@)(@@)(@@)(@@) $ 3159 ق(@)(@@) عبد الله بن دينار الشامي لا المدني عن عمر بن عبد العزيز فيه ضعف(@)(@@)(@@)(@@) $ 3160 عبد الله بن ذكوان عن ابن المنكدر في الاذان قال البخاري حديثه منكر(@)(@@)(@@)(@@) $ 3161 عبد الله بن ذكوان عن ابن عمر لا يعرف(@)(@@)(@@)(@@) $ 3162 ع(@)(@@) عبد الله بن ذكوان أبو الزناد امام ثبت تكلم فيه بعضهم بلا حجة(@)(@@)(@@)(@@) $ 3163 م د ت(@)(@@) عبد الله بن أبي صالح السمان هو عباد قال البخاري منكر الحديث(@)(@@)(@@)(@@) $ 3164 د ت ق(@)(@@) عبد الله بن راشد عن أبي سعيد قال الدارقطني ضعيف PageV01P337(@)(@@)(@@)(@@) $ 3165 عبد الله بن أبي راشد عن علي رضي الله عنه لا يعرف(@)(@@)(@@)(@@) $ 3166 عبد الله بن رافع بن خديج عن أبيه قال الدارقطني ليس بالقوي(@)(@@)(@@)(@@) $ 3167 عبد الله بن أبي رفاعة الاسكندراني عن الليث منكر الحديث(@)(@@)(@@)(@@) $ 3168 خ س(@)(@@) عبد الله بن رجاء الغداني صدوق قال أبو حاتم ثقة رضي وقال أبو حفص الفلاس كثير الغلط والتصحيف ليس بحجة(@)(@@)(@@)(@@) $ 3169 عبد الله بن رشيد عن مجاعة بن الزبير وعنه السري بن سهل ليس بقوي وفيه جهالة(@)(@@)(@@)(@@) $ 3170 عبد الله بن أبي الزغباء الحنفي عن عكرمة نكرة والخبر منكر(@)(@@)(@@)(@@) $ 3171 عبد الله بن رقيم قال ابن خراش لم يرو عنه إلاعبد الله ابن شريك(@)(@@)(@@)(@@) $ 3172 عبد الله بن أبي رومان المعافري عن ابن وهب ضعفه غير واحد وله حديث باطل(@)(@@)(@@)(@@) $ 3173 ق(@)(@@) عبد الله بن الزبير الباهلي عن ثابت حسن الحديث قال أبو حاتم مجهول(@)(@@)(@@)(@@) $ 3174 عبد الله بن الزبير والد أبي أحمد الزبيري ضعفه أبو نعيم PageV01P338(@)(@@)(@@)(@@) $ 3175 عبد الله بن زمل الجهني تابعي ارسل حديثا ولا يكاد يعرف له مناكير(@)(@@)(@@)(@@) $ 3176 ق(@)(@@) عبد الله بن زياد بن سليمان بن سمعان المدني الفقيه تركوه(@)(@@)(@@)(@@) $ 3177 عبد الله بن زياد بن سليم عن عكرمة لا يعرف(@)(@@)(@@)(@@) $ 3178 عبد الله بن زياد عن عكرمة بن عمار منكر الحديث(@)(@@)(@@)(@@) $ 3179 عبد الله بن زياد بن درهم عن عبد الملك بن سويد مجهول(@)(@@)(@@)(@@) $ 3180 ق(@)(@@) عبد الله 
ms160	 بن زياد عن أبي عبيدة لا يعرف من هو(@)(@@)(@@)(@@) $ 3181 ت س(@)(@@) عبد الله بن زيد بن اسلم عن أبيه ضعفه جماعة وقال أحمد ثقة(@)(@@)(@@)(@@) $ 3182 عبد الله بن أبي زينب عن أبي ادريس الخولاني مجهول(@)(@@)(@@)(@@) $ 3183 عبد الله بن السائب عن أبيه مجهول(@)(@@)(@@)(@@) $ 3184 عبد الله بن سبأ من غلاة الشيعة ضال مضل(@)(@@)(@@)(@@) $ 3185 عبد الله بن سخبرة عن أبيه لا يعرف(@)(@@)(@@)(@@) $ 3186 د ت(@)(@@) عبد الله بن سراقة عن أبي عبيدة بن الجراح لا يعرف(@)(@@)(@@)(@@) $ 3187 عبد الله بن السري المدائني بانطاكية عن أبي عمران الجوني ضعفوه PageV01P339(@)(@@)(@@)(@@) $ 3188 د(@)(@@) عبد الله بن سعد عن الصنابحي مجهول(@)(@@)(@@)(@@) $ 3189 عبد الله بن سعد الرقي عن هشام بن عمار كذاب(@)(@@)(@@)(@@) $ 3190 عبد الله بن أبي سعيد عن الحسن مجهول(@)(@@)(@@)(@@) $ 3191 ع(@)(@@) عبد الله بن سعيد بن أبي هند ثقة ضعفه أبو حاتم ووثقه أحمد وابن معين وقال القطان صالح تعرف وتنكر(@)(@@)(@@)(@@) $ 3192 عبد الله بن سعد الرقي القاضي قال الدارقطني كان يضع الحديث(@)(@@)(@@)(@@) $ 3193 عبد الله بن سعيد بن خازم عن بعض التابعين لا يعرف(@)(@@)(@@)(@@) $ 3194 ت ق(@)(@@) عبد الله بن سعيد بن أبي سعيد المقري عن أبيه تركوه(@)(@@)(@@)(@@) $ 3195 خ م(@)(@@) عبد الله بن سعيد أبو صفوان الاموي صدوق ضعفه ابن معين(@)(@@)(@@)(@@) $ 3196 س(@)(@@) عبد الله بن سفيان الثقفي عن أبيه وعنه يعلى بن عطاء وحده(@)(@@)(@@)(@@) $ 3197 عبد الله بن سفيان الخزاعي الواسطي عن يحيى بن سعيد الانصاري تكلم فيه العقيلي(@)(@@)(@@)(@@) $ 3198 عبد الله بن سفيان الصنعاني قال ابن معين كذاب(@)(@@)(@@)(@@) $ 3199 م عه(@)(@@) عبد الله بن سلمة عن علي صدوق قال ابو PageV01P340 حاتم والنسائي تعرف وتنكر وكذا قال قبلهما عمرو بن مرة(@)(@@)(@@)(@@) $ 3200 عبد الله بن سلمة البصري الافطس عن الاعمش تركوه(@)(@@)(@@)(@@) $ 3201 عبد الله بن سلمة بن اسلم عن عبد الرحمن بن المسور ابن مخرمة ضعفه الدارقطني(@)(@@)(@@)(@@) $ 3202 عبد الله بن سلمة عن الزهري قال أبو زرعة منكر الحديث(@)(@@)(@@)(@@) $ 3203 عبد الله بن سلم بصري عن ابن عون 