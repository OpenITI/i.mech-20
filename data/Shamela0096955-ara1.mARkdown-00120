ms104	 المسيب، كذلك.(@)(@@)(@@)(@@) || عبد الغفور(@)PageV01P254(@)(@@)(@@)(@@) $ 2585 - عبد الغفور، أبو الصباح الواسطي: عن أبي هاشم الرماني، قال ابن معين: ليس بشيء، وقال ابن حبان: كان ممن يضع الحديث.(@)(@@)(@@)(@@) || عبد القدوس(@)PageV01P254(@)(@@)(@@)(@@) $ 2586 - عبد القدوس بن حبيب، أبو سعيد الكلاعي: متروك، لقي التابعين.(@)(@@)(@@)(@@) || عبد الكبير(@)PageV01P255(@)(@@)(@@)(@@) $ 2587 - عبد الكبير بن محمد: عن سليمان الشاذكوني، ليس بثقة.(@)(@@)(@@)(@@) || عبد الكريم(@)PageV01P255(@)(@@)(@@)(@@) $ 2588 - عبد الكريم بن الجراح: عن يونس بن أبي إسحاق، مجهول. -ق-(@)(@@)(@@)(@@) $ 2589 - عبد الكريم بن روح: عن الثوري، مجهول.(@)(@@)(@@)(@@) $ 2590 - عبد الكريم بن عبد الله: عن القاسم بن محمد، مجهول.(@)(@@)(@@)(@@) $ 2591 - عبد الكريم بن عبد الكريم التاجر: قال أبو حاتم: حديثه يدل على الكذب.(@)(@@)(@@)(@@) $ 2592 - عبد الكريم، أبو معشر الطبري المقرئ: تكلم في سماعه عن أبي عبد الله بن نظيف.(@)(@@)(@@)(@@) $ 2593 - عبد الكريم بن كيسان: مجهول، وحديثه كذب.(@)(@@)(@@)(@@) $ 2594 - عبد الكريم بن مالك الجزري: ثقة متقن، توقف فيه ابن حبان. -ع-(@)(@@)(@@)(@@) $ 2595 - عبد الكريم بن أبي المخارق، وأبو أمية المؤدب: بصري، عن مجاهد وطبقته، كذبه أيوب السختياني، وضرب أحمد بن حنبل على حديثه، وقال: هو شبه المتروك وقال ابن معين: ليس بشيء، وقال النسائي والدارقطني: متروك. -ت، س، ق-(@)(@@)(@@)(@@) $ 2596 - عبد الكريم بن هارون: عن مالك: تركه الأزدي.(@)(@@)(@@)(@@) $ 2597 - عبد الكريم بن هلال: لا يعرف، ضعفه الأزدي.(@)(@@)(@@)(@@) $ 2598 - عبد الكريم الجزري: عن هشام بن عروة: مجهول.(@)(@@)(@@)(@@) $ 2599 - عبد الكريم الخزاز: عن جابر الجعفي، قال الأزدي: واه.(@)(@@)(@@)(@@) $ 2600 - عبد الكريم: شيخ للوليد بن صالح، قال أبو حاتم: كان يكذب.(@)(@@)(@@)(@@) || عبد المجيد(@)PageV01P256(@)(@@)(@@)(@@) $ 2601 - عبد المجيد بن عبد العزيز بن أبي رواد: وثقه ابن معين، وغيره، وقال أبو داود: ثقة داعية إلى الإرجاء، تركه ابن حبان. -م، عه-(@)(@@)(@@)(@@) || عبد الملك(@)PageV01P256(@)(@@)(@@)(@@) $ 2602 - عبد الملك بن إبراهيم، أبو مروان المدني: شيخ لا يعرف.(@)(@@)(@@)(@@) $ 2603 - عبد الملك بن أعين: عن أبي وائل، ثقة، قال أبو حاتم: صالح الحديث. -خ، عه-(@)(@@)(@@)(@@) $ 2604 - عبد الملك بن بديل: عن عبيد بن نجيح، قال الأزدي: متروك.(@)(@@)(@@)(@@) $ 2605 - عبد الملك بن أبي جمعة البصري: ضعفه النسائي وغيره.(@)(@@)(@@)(@@) $ 2606 - عبد الملك بن أبي 
ms105	 جميلة: عن أبي بكر بن بشير، مجهول.(@)(@@)(@@)(@@) $ 2607 - عبد الملك بن الحسين، أبو مالك النخعي: عن علي بن الأقمر، ضعفوه. -ق-(@)(@@)(@@)(@@) $ 2608 - عبد الملك بن حذيفة: مجهول.(@)(@@)(@@)(@@) $ 2609 - عبد الملك بن حصين بن الترجمان. أخو عبد العزيز: تركه أبو زرعة.(@)(@@)(@@)(@@) $ 2610 - عبد الملك بن خشك: عن حجر المدري، تكلم فيه ابن عدي.(@)(@@)(@@)(@@) $ 2611 - عبد الملك بن خلج الصنعاني: عن وهب، ضعفه غير واحد.(@)(@@)(@@)(@@) $ 2612 - عبد الملك بن الربيع بن سبرة: عن أبيه، ضعفه ابن معين وحده. -م، د، ت، ق-(@)(@@)(@@)(@@) $ 2613 - عبد الملك بن زياد النصيبي: قال الأزدي: كان غير ثقة.(@)(@@)(@@)(@@) $ 2614 - عبد الملك بن زكريا: تابعي، مجهول.(@)(@@)(@@)(@@) $ 2615 - عبد الملك بن زيد بن سعيد: شيخ ابن أبي فديك، ضعفوه. -د، س-(@)(@@)(@@)(@@) $ 2616 - عبد الملك بن سليمان: عن عيسى بن يونس، قال العقيلي: حديثه غير محفوظ.(@)(@@)(@@)(@@) $ 2617 - عبد الملك بن أبي سليمان: تكلم فيه شعبة لتفرده بحديث الشفعة، وقد وثقه أحمد والنسائي، والناس. -م، عه-(@)(@@)(@@)(@@) $ 2618 - عبد الملك بن الشعاع: مجهول.(@)(@@)(@@)(@@) $ 2619 - عبد الملك بن الطفيل الجزري: معاصر لخصيف، مجهول.(@)(@@)(@@)(@@) $ 2620 - عبد الملك بن عبد الله بن محمد بن سيرين: شيخ مجهول.(@)(@@)(@@)(@@) $ 2621 - عبد الملك بن عبد الله العائذي: قال أبو حاتم: ليس بالقوي. -د، س-(@)(@@)(@@)(@@) $ 2622 - عبد الملك بن عبد الرحمن الشامي: نزيل البصرة، كذبه الفلاس.(@)(@@)(@@)(@@) $ 2623 - عبد الملك بن عبد الرحمن: من ولد عتاب، عن ابن جريج، له حديث منكر.(@)(@@)(@@)(@@) $ 2624 - عبد الملك بن عبد العزيز: عن الأوزاعي، اتهمه ابن حبان. -د، س-(@)(@@)(@@)(@@) $ 2625 - عبد الملك بن عبد الملك: عن مصعب، عن القاسم، حديثه منكر.(@)(@@)(@@)(@@) $ 2626 - عبد الملك بن عبد ربه الطائي: عن خلف بن خليفة، حديثه منكر.(@)(@@)(@@)(@@) $ 2627 - عبد الملك بن عبيد: عن أنس، قال ابن المديني: مجهول. -س-(@)(@@)(@@)(@@) $ 2628 - عبد الملك بن عمير: قال أحمد: مضطرب الحديث، وقال ابن معين: مختلط، وقال أبو حاتم: ليس بحافظ، ووثقه جماعة. -ع-(@)(@@)(@@)(@@) $ 2629 - عبد الملك بن أبي عياش: عن عرزب، مجهول.(@)(@@)(@@)(@@) $ 2630 - عبد الملك بن علاق: عن أنس بن مالك، قال الترمذي: مجهو