ms181	 قال الترمذي: مجهول.(@)(@@)(@@)(@@) $ 4493 - هلال بن عبد الرحمن الحنفي: عن ابن المنكدر، منكر الحديث.(@)(@@)(@@)(@@) $ 4494 - هلال بن فياض اليشكري: هو شاذ بن فياض، كان البخاري يحط عليه، وقال ابن حبان: لا يشتغل برواياته. -د، س-(@)(@@)(@@)(@@) $ 4495 - هلال بن ميمون، ويقال ابن سويد، أبو ظلال القسملي: عن أنس، قال ابن عدي: عامة ما يرويه لا يتابع عليه. -ت-(@)(@@)(@@)(@@) $ 4496 - هلال بن يحيى الراوي: عن أبي عوانة، قال ابن حبان: لا يحتج به.(@)(@@)(@@)(@@) $ 4497 - هلال أبو الورد العتكي: مجهول.(@)(@@)(@@)(@@) || هياج(@)PageV01P422(@)(@@)(@@)(@@) $ 4498 - هياج بن بسطام الهروي: قال أبو داود: تركوا حديثه. -ق-(@)(@@)(@@)(@@) || الهيثم(@)PageV01P422(@)(@@)(@@)(@@) $ 4499 - الهيثم بن بدر: عن حرقوص، عن علي، لين، ولي خراج الري.(@)(@@)(@@)(@@) $ 4500 - الهيثم بن جماز الحنفي البكاء: تركه أحمد والنسائي.(@)(@@)(@@)(@@) $ 4501 - الهيثم بن جميل: ثقة، له مناكير. -ق-(@)(@@)(@@)(@@) $ 4502 - الهيثم بن حميد الدمشقي: قال أبو داود: قدري ثقة. -عه-(@)(@@)(@@)(@@) $ 4503 - الهيثم بن حسين: عن الثوري، لا يصح حديثه.(@)(@@)(@@)(@@) $ 4504 - الهيثم بن خالد: عن وكيع، لا يصح حديثه.(@)(@@)(@@)(@@) $ 4505 - الهيثم بن الربيع العقيلي: عن سماك بن عطية، غلط في حديث. -ت-(@)(@@)(@@)(@@) $ 4506 - الهيثم بن رزيق. وفي نسخة زريق، بتقديم الزاي: عن الحسن لا يصح حديثه.(@)(@@)(@@)(@@) $ 4507 - الهيثم بن سهل التستري: قال الدارقطني: ضعيف.(@)(@@)(@@)(@@) $ 4508 - الهيثم بن صالح: عن سلام أبي المنذر، لا يعرف.(@)(@@)(@@)(@@) $ 4509 - الهيثم بن عباد: عن أنس رضي الله عنه: مجهول.(@)(@@)(@@)(@@) $ 4510 - الهيثم بن عبد الغفار: عن همام، تركوه واتهم.(@)(@@)(@@)(@@) $ 4511 - الهيثم بن عدي الطائي: تركوه، وقال أبو داود: كذاب.(@)(@@)(@@)(@@) $ 4512 - الهيثم بن عقاب: عن محارب بن دثار: مجهول، وحديثه منكر.(@)(@@)(@@)(@@) $ 4513 - الهيثم بن عمر بن حفص: قال ابن حبان: لا يحتج به.(@)(@@)(@@)(@@) $ 4514 - الهيثم بن قيس: روى عنه قرة بن حبيب، حديثه منكر.(@)(@@)(@@)(@@) $ 4515 - الهيثم بن المغيرة السرخسي: حديثه مجهول.(@)(@@)(@@)(@@) $ 4516 - الهيثم بن اليمان: روى عنه محمد بن الحسن الزعفراني. ضعف.(@)(@@)(@@)(@@) || هيصم(@)PageV01P423(@)(@@)(@@)(@@) $ 4517 - هيصم بن شداخ: عن الأعمش، ليس بثقة.(@)(@@)(@@)(@@) | حرف الواو(@)PageV01P423(@)(@@)(@@)(@@) || الوازع(@)PageV01P423(@)(@@)(@@)(@@) $ 4518 - الوازع بن نافع الجزري: قال أحمد، ويحيى: ليس بثقة.(@)(@@)(@@)(@@) || واسط(@)PageV01P423(@)(@@)(@@)(@@) $ 4519 - واسط بن الحارث: عن نافع، مقل صاحب مناكير. 
ms182	(@)(@@)(@@)(@@) || واصل(@)PageV01P423(@)(@@)(@@)(@@) $ 4520 - واصل بن أبي جميل: عن مجاهد، قال ابن معين: لا شيء.(@)(@@)(@@)(@@) $ 4521 - واصل بن عبد الرحمن، أبو حرة الرقاشي: قال البخاري: يتكلمون في روايته عن الحسن. -م، س-(@)(@@)(@@)(@@) $ 4522 - واصل بن السائب: عن عطاء، قال النسائي وغيره: متروك.(@)(@@)(@@)(@@) || واضح(@)PageV01P424(@)(@@)(@@)(@@) $ 4523 - واضح البصري: عن الحسن: مجهول.(@)(@@)(@@)(@@) || واقد(@)PageV01P424(@)(@@)(@@)(@@) $ 4524 - واقد بن عبد الرحمن بن سعد بن معاذ: لا يعرف. -د-(@)(@@)(@@)(@@) $ 4525 - واقد، ويقال بالفاء بن سلامة: عن يزيد الرقاشي، ضعفوه.(@)(@@)(@@)(@@) || والان(@)PageV01P424(@)(@@)(@@)(@@) $ 4526 - والان، أبو عروة المرادي: مجهول.(@)(@@)(@@)(@@) || وائل(@)PageV01P424(@)(@@)(@@)(@@) $ 4527 - وائل بن علقمة: عن وائل بن حجر: مجهول.(@)(@@)(@@)(@@) || وثيمة(@)PageV01P424(@)(@@)(@@)(@@) $ 4528 - وثيمة بن موسى: عن سلمة الأبرش، قال ابن أبي حاتم: يحدث عن سلمة بأحاديث موضوعة.(@)(@@)(@@)(@@) || ورقاء(@)PageV01P424(@)(@@)(@@)(@@) $ 4529 - ورقاء بن عمر اليشكري: ثقة، لينه يحيى القطان. -ع-(@)(@@)(@@)(@@) || وزير(@)PageV01P424(@)(@@)(@@)(@@) $ 4530 - وزير بن صبيح الوزان: عن بعض التابعين: مجهول.(@)(@@)(@@)(@@) $ 4531 - وزير بن الجزري: شيخ لبقية، ضعفه أبو زرعة.(@)(@@)(@@)(@@) || وضاح(@)PageV01P425(@)(@@)(@@)(@@) $ 4532 - وضاح بن خيثمة: عن هشام بن عروة، لا يتابع على حديثه.(@)(@@)(@@)(@@) $ 4533 - وضاح بن عباد: عن عاصم الأحول، تكلم فيه أحمد بن المنادي.(@)(@@)(@@)(@@) $ 4534 - وضاح بن يحيى النهشلي: قال ابن حبان: لا يحتج به.(@)(@@)(@@)(@@) || الوضين(@)PageV01P425(@)(@@)(@@)(@@) $ 4535 - الوضين بن عطاء: قال أحمد: ما كان به بأس، ولينه غيره. -د، ق-(@)(@@)(@@)(@@) || وعلة(@)PageV01P425(@)(@@)(@@)(@@) $ 4536 - وعلة بن عبد الرحمن: عن بعض التابعين: مجهول، يمامي. -د-(@)(@@)(@@)(@@) || وقاء(@)PageV01P425(@)(@@)(@@)(@@) $ 4537 - وقاء بن إياس: قال ابن معين: ما كان بالذي يعتمد عليه. -س-(@)(@@)(@@)(@@) || وكيع(@)PageV01P425(@)(@@)(@@)(@@) $ 4538 - وكيع بن محرز: شيخ لروح بن عبد المؤمن، قال البخاري: عنده عجائب. -ق-(@)(@@)(@@)(@@) || الوليد(@)PageV01P425(@)(@@)(@@)(@@) $ 4539 - الوليد بن أبي ثور: ضعفه النسائي وغيره.(@)(@@)(@@)(@@) $ 4540 - الوليد بن جبلة: مجهول.(@)(@@)(@@)(@@) $ 4541 - الوليد بن جميل: روى عن القاسم أحاديث منكرة، قاله أبو حاتم. -ت، ق-(@)(@@)(@@)(@@) $ 4542 - الوليد بن جميع: هو الوليد بن عبد الله، عصري الأعمش. -ت، د، س، م-(@)(@@)(@@)(@@) $ 4543 - الوليد بن خالد: عن يوسف بن عطية، ضعفه الأزدي.(@)(@@)(@@)(@@) $ 4544 - الوليد بن دينار: عن الحسن، ضعفه يحيى بن معين.(@)(@@)(@@)(@@) $ 4545 - الوليد بن زياد: والوليد بن أبي زينب، والوليد بن سعيد، والوليد بن سفيان عن علي، والوليد بن سفيان تابعي: 
ms183	 مجهولون.(@)(@@)(@@)(@@) $ 4546 - الوليد بن سلمة الطبراني: عن عبيد الله بن عمر، قال دحيم: كذاب.(@)(@@)(@@)(@@) $ 4547 - الوليد بن شجاع، أبو همام: ثقة، قال أبو حاتم: لا يحتج به. -م، د، ت، ق-(@)(@@)(@@)(@@) $ 4548 - الوليد بن عباد: شيخ لإسماعيل بن عياش، لا يعرف.(@)(@@)(@@)(@@) $ 4549 - الوليد بن العباس بن مسافر: مصري، ضعفه الدارقطني.(@)(@@)(@@)(@@) $ 4550 - الوليد بن عبد الله بن أبي ثور: ضعفه أحمد، وجماعة. -د، ت، ق-(@)(@@)(@@)(@@) $ 4551 - الوليد بن عبد الرحمن: شيخ لمعتمر بن سليمان، قال ابن معين: ليس بشيء.(@)(@@)(@@)(@@) $ 4552 - الوليد بن عبدة: تابعي: مجهول.(@)(@@)(@@)(@@) $ 4553 - الوليد بن عبيد الله بن أبي رباح: عن عمه عطاء، ضعفه الدارقطني.(@)(@@)(@@)(@@) $ 4554 - الوليد بن عجلان: شيخ جون بن بشير: مجهول.(@)(@@)(@@)(@@) $ 4555 - الوليد بن عصام الزبيري: عن أبيه، متهم.(@)(@@)(@@)(@@) $ 4556 - الوليد بن عطاء: شيخ ابن جريج: مجهول. -م مقرونا-(@)(@@)(@@)(@@) $ 4557 - الوليد بن عقبة: عراقي، عن التابعين، لا يعرف. -ق-(@)(@@)(@@)(@@) $ 4558 - الوليد بن عمرو: عن عون بن أبي جحيفة، ضعفوه.(@)(@@)(@@)(@@) $ 4559 - الوليد بن عيسى، أبو وهب: عن الشعبي، ليس بثقة.(@)(@@)(@@)(@@) $ 4560 - الوليد بن الفضل: عن عبد الله بن إدريس: مجهول ساقط.(@)(@@)(@@)(@@) $ 4561 - الوليد بن القاسم بن الوليد الهمداني: قال ابن حبان: لا يحتج به. -ت، ق-(@)(@@)(@@)(@@) $ 4562 - الوليد بن كامل: شيخ لبقية، ضعفه الأزدي. -د-(@)(@@)(@@)(@@) $ 4563 - الوليد بن كثير المخزومي: ثقة قدري خارجي، أباضي. -ع-(@)(@@)(@@)(@@) $ 4564 - الوليد بن كريز: مجهول، له حديث منكر.(@)(@@)(@@)(@@) $ 4565 - الوليد بن محمد السلمي الحجام: عن شعبة، ضعفه الدارقطني.(@)(@@)(@@)(@@) $ 4566 - الوليد بن محمد الموقري: كذبه يحيى، وقال الدارقطني: ضعيف. -ت، ق-(@)(@@)(@@)(@@) $ 4567 - الوليد بن مروان: مجهول.(@)(@@)(@@)(@@) $ 4568 - الوليد بن مسلم: ثقة مدلس، لا سيما في شيوخ الأوزاعي. -ع-(@)(@@)(@@)(@@) $ 4569 - الوليد بن مسلمة الأزدي: عن عمر بن قيس، تركه الدارقطني.(@)(@@)(@@)(@@) $ 4570 - الوليد بن المغيرة: عن سعيد بن المسيب: مجهول.(@)(@@)(@@)(@@) $ 4571 - الوليد بن المهلب: عن النضر بن محرز: مجهول.(@)(@@)(@@)(@@) $ 4572 - الوليد بن موسى: عن الأوزاعي، دمشقي، ضعفه ابن حبان. -س-(@)(@@)(@@)(@@) $ 4573 - الوليد بن نافع: عن شعبة، لا يكاد يعرف.(@)(@@)(@@)(@@) $ 4574 - الوليد بن هشام بن الوليد: مجهول.(@)(@@)(@@)(@@) $ 4575 - الوليد بن الوليد الدمشقي: عن سعيد بن 
ms184	 بشير، قال الدارقطني: منكر الحديث.(@)(@@)(@@)(@@) $ 4576 - الوليد بن يزيد الهدادي: مكثر، من المجاهيل، وليس بالعمدة.(@)(@@)(@@)(@@) $ 4577 - الوليد الرماح: عن ابن العباس رضي الله عنهما: مجهول.(@)(@@)(@@)(@@) || وهب(@)PageV01P428(@)(@@)(@@)(@@) $ 4578 - وهب بن أبان: عن نافع: مجهول، أتى بحديث منكر لا يصح.(@)(@@)(@@)(@@) $ 4579 - وهب بن إسماعيل: شيخ لأحمد بن حنبل، توقف في أمره.(@)(@@)(@@)(@@) $ 4580 - وهب بن جابر الخيواني: تابعي: مجهول. -د، س-(@)(@@)(@@)(@@) $ 4581 - وهب بن حفص البجلي: عن أبي قتادة الحراني، قال أبو عروبة: يكذب.(@)(@@)(@@)(@@) $ 4582 - وهب بن حكيم: عن ابن سيرين: مجهول.(@)(@@)(@@)(@@) $ 4583 - وهب بن داود المخرمي: عن ابن علية، قال الخطيب: لم يكن ثقة.(@)(@@)(@@)(@@) $ 4584 - وهب بن راشد: عن مالك بن دينار، قال الدارقطني: متروك.(@)(@@)(@@)(@@) $ 4585 - وهب بن عمرو: مجهول.(@)(@@)(@@)(@@) $ 4586 - وهب بن منبه: ثقة، ضعفه الفلاس. -خ، م، د، ت، س، فق-(@)(@@)(@@)(@@) $ 4587 - وهب بن وهب، أبو البختري القاضي: قال أحمد وغيره: كذاب.(@)(@@)(@@)(@@) $ 4588 - وهب بن وهب: عن سعد بن أبي وقاص رضي الله عنه: مجهول.(@)(@@)(@@)(@@) || وهب الله(@)PageV01P429(@)(@@)(@@)(@@) $ 4589 - وهب الله بن راشد، أبو زرعة المصري: غمزه يحيى بن أبي مريم.(@)(@@)(@@)(@@) | حرف اللام(@)PageV01P429(@)(@@)(@@)(@@) || لاحق(@)PageV01P429(@)(@@)(@@)(@@) $ 4590 - لاحق بن الحسين المقدسي: قال الإدريسي: كذاب وضاع. -ق-(@)(@@)(@@)(@@) || لاهز(@)PageV01P430(@)(@@)(@@)(@@) $ 4591 - لاهز، أبو عمرو التيمي: عن معتمر بن سليمان، اتهمه ابن عدي.(@)(@@)(@@)(@@) | حرف الياء(@)PageV01P430(@)(@@)(@@)(@@) || ياسين(@)PageV01P430(@)(@@)(@@)(@@) $ 4592 - ياسين بن محمد: عن أبي حازم: مجهول.(@)(@@)(@@)(@@) $ 4593 - ياسين بن معاذ الزيات: عن الزهري، تركه النسائي والأزدي.(@)(@@)(@@)(@@) $ 4594 - ياسين العجلي: عن إبراهيم بن محمد بن الحنفية، قال البخاري: في حديثه نظر، قلت: هو الزيات.(@)(@@)(@@)(@@) || يحيى(@)PageV01P430(@)(@@)(@@)(@@) $ 4595 - يحيى بن إبراهيم السلمي: عن الثوري، واه.(@)(@@)(@@)(@@) $ 4596 - يحيى بن إبراهيم، أبو الحسين بن أبي زيد بن البيان المقرئ: ليس بثقة.(@)(@@)(@@)(@@) $ 4597 - يحيى بن أزهر: شيخ لابن وهب: مجهول.(@)(@@)(@@)(@@) $ 4598 - يحيى بن أبي إسحاق الهنائي: تابعي: مجهول. -ق-(@)(@@)(@@)(@@) $ 4599 - يحيى بن إسماعيل: عن إبراهيم بن سعد: مجهول.(@)(@@)(@@)(@@) $ 4600 - يحيى بن أكثم القاضي: صدوق، لينه الأزدي. -ت-(@)(@@)(@@)(@@) $ 4601 - يحيى بن أيوب الغافقي: ثقة، قال النسائي: ليس بذاك القوي، وقال أبو حاتم: لا يحتج به. -ع-(@)(@@)(@@)(@@) $ 4601 (1)(@)(@@)(@@)(@@) $ - يحيى بن أيوب البجلي:(@)(@@) عن 
ms185	 أبي زرعة، ضعفه ابن معين. -د، ت-(@)(@@)(@@)(@@) $ 4602 - يحيى بن أبي أنيسة: أخو زيد، قال أحمد وغيره: متروك. -ت-(@)(@@)(@@)(@@) $ 4603 - يحيى بن بريد بن أبي بردة: ضعفه أحمد وغير واحد.(@)(@@)(@@)(@@) $ 4604 - يحيى بن بسطام البصري: قال ابن حبان: لا تحل الرواية عنه.(@)(@@)(@@)(@@) $ 4605 - يحيى بن بشر الخراساني: عن عكرمة، قال الأزدي: ضعيف.(@)(@@)(@@)(@@) $ 4606 - يحيى بن بهماه. مولى عثمان: تابعي، قال أبو حاتم: مجهول.(@)(@@)(@@)(@@) $ 4607 - يحيى بن التوأم: عن ابن أبي مليكة، بصري، ضعفه ابن معين.(@)(@@)(@@)(@@) $ 4608 - يحيى بن ثعلبة، أبو المقوم: قال الدارقطني: ضعيف.(@)(@@)(@@)(@@) $ 4609 - يحيى بن الجزار: عن علي، ثقة، قال الحاكم: كان يغلو في التشيع. -م، عه-(@)(@@)(@@)(@@) $ 4610 - يحيى بن جرجة: روى عنه ابن جريج: مجهول.(@)(@@)(@@)(@@) $ 4611 - يحيى بن الحارث: عن أخيه زهدم، في قطع السدر، لا يصح.(@)(@@)(@@)(@@) $ 4612 - يحيى بن أبي الحجاج: عن عوف، قال ابن عدي: لا أرى بأحاديثه بأسا. -ت، س-(@)(@@)(@@)(@@) $ 4613 - يحيى بن حرب: عن سعيد المقبري: مجهول. -ق-(@)(@@)(@@)(@@) $ 4614 - يحيى بن حميد: عن قرة بن حيوئيل، قال البخاري: لا يتابع على حديثه.(@)(@@)(@@)(@@) $ 4615 - يحيى بن حميد الطويل: عن أبيه، قال ابن عدي: حديثه غير مستقيم.(@)(@@)(@@)(@@) $ 4616 - يحيى بن حمزة القاضي: قال ابن معين: صدقة أحب إلي منه، وقال أيضا: كان يرمى بالقدر، قلت: هو ثقة. -ع-(@)(@@)(@@)(@@) $ 4617 - يحيى بن حوشب: مجهول منكر الحديث، روى عنه مخلد بن مالك الحراني.(@)(@@)(@@)(@@) $ 4618 - يحيى بن أبي حية، أبو جناب الكلبي: قال ابن معين: صدوق يدلس، وقال النسائي والدارقطني: ضعيف. -د، ت، ق-(@)(@@)(@@)(@@) $ 4619 - يحيى بن خالد: شيخ لبقية: مجهول.(@)(@@)(@@)(@@) $ 4620 - يحيى بن أبي خالد: مجهول.(@)(@@)(@@)(@@) $ 4621 - يحيى بن خليف: عن سفيان الثوري، منكر الحديث، لا أعرفه.(@)(@@)(@@)(@@) $ 4622 - يحيى بن أبي الدنيا: عن ابن جريج، قال أبو حاتم: ضعيف الحديث.(@)(@@)(@@)(@@) $ 4623 - يحيى بن راشد البصري: عن خالد الحذاء، ضعفه النسائي. -ق-(@)(@@)(@@)(@@) $ 4624 - يحيى بن أبي روق: قال ابن معين: ليس بثقة.(@)(@@)(@@)(@@) $ 4625 - يحيى بن زيان: مجهول.(@)(@@)(@@)(@@) $ 4626 - يحيى بن زكريا بن أبي الحواجب: عن الأعمش، ضعفه الدارقطني.(@)(@@)(@@)(@@) $ 4627 - يحيى بن أبي زكريا الغساني: عن هشام 
ms186	 بن عروة، تكلم فيه ابن حبان.(@)(@@)(@@)(@@) $ 4628 - يحيى بن سابق: عن أبي حازم، ليس بشيء، يروي الموضوعات.(@)(@@)(@@)(@@) $ 4629 - يحيى بن سالم الكوفي: ضعفه الدارقطني.(@)(@@)(@@)(@@) $ 4630 - يحيى بن سعد السعدي: عن ابن جريج، وقيل: يحيى بن سعيد، قال ابن حبان: يروي المقلوبات والمكذوبات، لا يحتج به.(@)(@@)(@@)(@@) $ 4631 - يحيى بن سعيد التميمي المديني: قاضي شيراز، عن الزهري، تركوه.(@)(@@)(@@)(@@) $ 4632 - يحيى بن سعيد الحمصي العطار: قال ابن عدي: هو بين الضعف، وقال ابن حبان: يروي الموضوعات عن الأثبات.(@)(@@)(@@)(@@) $ 4633 - يحيى بن سعيد بن سالم القداح: صالح الحديث، له مناكير.(@)(@@)(@@)(@@) $ 4634 - يحيى بن سعيد: جماعة ثقات، كالأنصاري، والقطان.(@)(@@)(@@)(@@) $ 4635 - يحيى بن السكن: بعد المائتين، صويلح، ضعفه صالح جزرة. -ت-(@)(@@)(@@)(@@) $ 4636 - يحيى بن سلمة بن كهيل: عن أبيه، قال النسائي وغيره: متروك. -ت-(@)(@@)(@@)(@@) $ 4637 - يحيى بن سلام: بصري، حدث بإفريقية عن ابن أبي عروبة، ضعفه ابن عدي، ويحيى بن سلام عن مالك، ضعفه الدارقطني.(@)(@@)(@@)(@@) $ 4638 - يحيى بن سليمان القرشي: عن فضيل بن عياض، قال أبو نعيم الحافظ: فيه مقال.(@)(@@)(@@)(@@) $ 4639 - يحيى بن سليمان: عن الأوزاعي: مجهول.(@)(@@)(@@)(@@) $ 4640 - يحيى بن أبي سليمان المقبري: قال البخاري: منكر الحديث، أما يحيى بن سليمان الجعفي شيخ البخاري فثقة معروف، وكذا يحيى بن سليمان الجفري الإفريقي.(@)(@@)(@@)(@@) $ 4641 - يحيى بن سليم الطائفي: وثقه ابن معين، وقال النسائي: ليس بشيء. -ع-(@)(@@)(@@)(@@) $ 4642 - يحيى بن سليم، أبو ابن أبي سليم، أبو بلج الفزاري: قال البخاري: فيه نظر، وقال أحمد: روى حديثا منكرا، وقال الأزدي: غير ثقة. -عه-(@)(@@)(@@)(@@) $ 4643 - يحيى بن شبيب اليمامي: عن الثوري، قال ابن حبان: لا يحتج به بحال.(@)(@@)(@@)(@@) $ 4644 - يحيى بن أبي صالح: عن أبي هريرة رضي الله عنه: مجهول. -ت-(@)(@@)(@@)(@@) $ 4645 - يحيى بن صالح الأيلي: قال العقيلي: له مناكير، روى عنه يحيى بن بكير.(@)(@@)(@@)(@@) $ 4646 - يحيى بن صالح الوحاظي: ثقة، تكلم فيه لتجهمه. -خ، م، د، ت، ق-(@)(@@)(@@)(@@) $ 4647 - يحيى بن طلحة اليربوعي: عن شريك، قال النسائي: ليس بشيء. -ت-(@)(@@)(@@)(@@) $ 4648 - يحيى بن عباد: عن ابن جريج، متهم واه.(@)(@@)(@@)(@@) $ 4649 - يحيى بن عبد الله الأجلح الكندي، 
ms187	 أبو حجية: قال أبو حاتم: لا يحتج به. -عه-(@)(@@)(@@)(@@) $ 4650 - يحيى بن عبد الله الجابر: عن أبي ماجد، ضعفه النسائي. -د، ت، ق-(@)(@@)(@@)(@@) $ 4651 - يحيى بن عبد الله المرادي: مجهول، روى عنه معمر. -د-(@)(@@)(@@)(@@) $ 4652 - يحيى بن عبد الله: عن أبي الطفيل، أظنه الأجلح المذكور. -م-(@)(@@)(@@)(@@) $ 4653 - يحيى بن عبد الله بن مالك الداري: تابعي: مجهول. -س-(@)(@@)(@@)(@@) $ 4654 - يحيى بن عبد الله البابلتي: قال ابن عدي: الضعف على حديثه بين. -خ، ت-(@)(@@)(@@)(@@) $ 4655 - يحيى بن عبد الله بن بكير: ثقة، قال النسائي: ضعيف، وقال الدارقطني: ما عندي به بأس. -خ، م، ق-(@)(@@)(@@)(@@) $ 4656 - يحيى بن عبد الحميد الحماني الحافظ: وثقه ابن معين وغيره، وقال النسائي: ضعيف، وأما أحمد بن حنبل فقال: كان يكذب جهارا، ما زلنا نعرفه يسرق الأحاديث، وقال محمد بن عبد الله بن نمير: كذاب، وقال الجوزجاني: ترك حديثه، وأما ابن عدي فقال: صنف المسند ولم أر في مسنده ولا في أحاديثه أحاديث مناكير، وأرجو أنه لا بأس به، قلت: أما تشيعه فقل ما شئت، كان يكفر معاوية.(@)(@@)(@@)(@@) $ 4657 - يحيى بن عبد الرحمن بن أبي لبيبة: شيخ وكيع، قال ابن معين: ليس بشيء.(@)(@@)(@@)(@@) $ 4658 - يحيى بن عبد الرحمن: عن أبان بن أبي عياش، قال الأزدي: بصري متروك.(@)(@@)(@@)(@@) $ 4659 - يحيى بن عبد الواحد الثقفي: مجهول، قال الحاكم: كان يضع الحديث.(@)(@@)(@@)(@@) $ 4660 - يحيى بن عبيد الله بن موهب: عن أبيه، قال أحمد وغيره: ليس بثقة. -ت، ق-(@)(@@)(@@)(@@) $ 4661 - يحيى بن عثمان، أبو سهل: عن ابن أبي مليكة، تكلم فيه ابن حبان. -ق-(@)(@@)(@@)(@@) $ 4662 - يحيى بن عثمان الحربي: صالح الحديث، تفرد عن العقيلي بحديث.(@)(@@)(@@)(@@) $ 4663 - يحيى بن عثمان الحمصي: صدوق، من شيوخ الشبلي، لينه أبو عروبة.(@)(@@)(@@)(@@) $ 4664 - يحيى بن عطاء: قال أبو حاتم: مجهول.(@)(@@)(@@)(@@) $ 4665 - يحيى بن عفيف الكندي: عن أبيه، تابعي مجهول.(@)(@@)(@@)(@@) $ 4666 - يحيى بن عقبة بن أبي العيزار: قال أبو حاتم: كان يفتعل الحديث.(@)(@@)(@@)(@@) $ 4667 - يحيى بن عمران المدني: مجهول.(@)(@@)(@@)(@@) $ 4668 - يحيى بن عمرو بن مالك النكري: كان حماد بن زيد يكذبه. -ت-(@)(@@)(@@)(@@) $ 4669 - يحيى بن عنبسة القرشي: عن 
ms188	 حميد، قال ابن حبان: دجال يضع الحديث.(@)(@@)(@@)(@@) $ 4670 - يحيى بن العلاء البجلي الرازي: قال أحمد: كذاب، يضع الحديث. -د، ق-(@)(@@)(@@)(@@) $ 4671 - يحيى بن عيسى الرملي: صدوق يهم، ضعفه يحيى بن معين، وقال النسائي: ليس بالقوي. -م، د، ت، ق-(@)(@@)(@@)(@@) $ 4672 - يحيى بن غالب العبشمي: عن يحيى بن حمزة، لا يصح حديثه في النكاح.(@)(@@)(@@)(@@) $ 4673 - يحيى بن فلان الأنصاري: عن أبيه: مجهول.(@)(@@)(@@)(@@) $ 4674 - يحيى بن كثير البصري: عن أيوب، قال الدارقطني: متروك، أما يحيى بن كثير العنبري البصري، فثقة مشهور. -ق-(@)(@@)(@@)(@@) $ 4675 - يحيى بن كثير الكاهلي: معاصر للأعمش: مجهول. -د-(@)(@@)(@@)(@@) $ 4676 - يحيى بن مالك بن أنس: قال العقيلي: حدث بمناكير عن أبيه.(@)(@@)(@@)(@@) $ 4677 - يحيى بن المتوكل، أبو عقيل: عن بهية، ضعفه غير واحد.(@)(@@)(@@)(@@) $ 4678 - يحيى بن المثنى: عن نعيم في جمل تردى في بئر، لا يعرف.(@)(@@)(@@)(@@) $ 4679 - يحيى بن محمد بن قيس، أبو زكير: ثقة، قال ابن حبان: لا يحتج به. -م، متابعة، ت، س، ق-(@)(@@)(@@)(@@) $ 4680 - يحيى بن محمد بن عباد الشجري: عن ابن إسحاق، قال العقيلي: في أحاديثه مناكير وأغاليط. -ت-(@)(@@)(@@)(@@) $ 4681 - يحيى بن محمد الجاوي: عن الدراوردي، قال البخاري: يتكلمون فيه. -د، ت، س-(@)(@@)(@@)(@@) $ 4682 - يحيى بن محمد: عن عمه حرملة، قال ابن عدي: كتبت عنه وكان ضعيفا.(@)(@@)(@@)(@@) $ 4683 - يحيى بن مساور: عن جعفر الصادق، قال الأزدي: كذاب.(@)(@@)(@@)(@@) $ 4684 - يحيى بن مسلم البكاء: تابعي، مجمع على ضعفه. -ت، ق-(@)(@@)(@@)(@@) $ 4685 - يحيى بن مسلمة بن قعنب: أخو القعنبي، عن حماد بن زيد، قال العقيلي: حدث بمناكير.(@)(@@)(@@)(@@) $ 4686 - يحيى بن مسلم البصري: عن الحسن: مجهول لا يعرف، لعله البكاء.(@)(@@)(@@)(@@) $ 4687 - يحيى بن مسلم: عن أبي إدريس الخولاني، شامي مجهول.(@)(@@)(@@)(@@) $ 4688 - يحيى بن المنذر: عن إسرائيل، كوفي، قال العقيلي: في حديثه نظر.(@)(@@)(@@)(@@) $ 4689 - يحيى بن ميمون، أبو المعلى العطار: عن سعيد بن جبير، كذبه الفلاس. -س، ق-(@)(@@)(@@)(@@) $ 4690 - يحيى بن ميمون، أبو أيوب البصري التمار: عن ثابت، قال الدارقطني: متروك. -د-(@)(@@)(@@)(@@) $ 4691 - يحيى بن نصر بن حاجب: عن ورقاء وغيره، قال أبو زرعة: ليس بشيء.(@)(@@)(@@)(@@) $ 4692 - يحيى بن هاشم الغساني السمسار: 
ms189	 قال ابن عدي: كان يضع الحديث.(@)(@@)(@@)(@@) $ 4693 - يحيى بن واضح، أبو تميلة: وثقه ابن معين وجماعة، وقال أحمد: ليس به بأس إن شاء الله، وقال ابن الجوزي: أدخله البخاري في كتاب الضعفاء. قلت: وهذا غلط من ابن الجوزي.(@)(@@)(@@)(@@) $ 4694 - يحيى بن وهب الكلبي: قال أبو حاتم الرازي: مجهول.(@)(@@)(@@)(@@) $ 4695 - يحيى بن الوليد بن عبادة بن الصامت: لا يعرف.(@)(@@)(@@)(@@) $ 4696 - يحيى بن يحيى الغساني الواسطي. لا الدمشقي، ذاك ثقة، وهذا يقال له يحيى ابن أبي زكريا، له عن هشام بن عروة، قال ابن حبان: يروي المقلوبات عن الثقات، لا يحتج به.(@)(@@)(@@)(@@) $ 4697 - يحيى بن أبي يحيى: شيخ مجهول، روى عنه ورقاء بن عمر. -س-(@)(@@)(@@)(@@) $ 4698 - يحيى بن يزيد بن عبد الملك النوفلي: شيخ لدحيم، ضعفه ابن عدي.(@)(@@)(@@)(@@) $ 4699 - يحيى بن يزيد، أبو شيبة الرهاوي: عن يزيد بن أبي أنيسة، قال ابن حبان: يروي المقلوبات فبطل الاحتجاج به.(@)(@@)(@@)(@@) $ 4700 - يحيى بن يعقوب، أبو طالب القاص: خال القاضي أبي يوسف عن التابعين، قال البخاري: منكر الحديث.(@)(@@)(@@)(@@) $ 4701 - يحيى بن يعلى الأسلمي القطواني: ضعفه أبو حاتم وغيره.[ص: 440]أما يحيى بن يعلى التيمي، أبو المحياة فثقة،ويحيى بن يعلى المحاربي(@)(@@) ، صدوق.(@)(@@)(@@)(@@) $ 4702 - يحيى بن يمان العجلي: قال أحمد: ليس بحجة، وقال ابن معين: ليس بالقوي. -م، عه-(@)(@@)(@@)(@@) $ 4703 - يحيى الأسود: مجهول.(@)(@@)(@@)(@@) $ 4704 - يحيى البكاء هو ابن مسلم.:(@)(@@)(@@)(@@) $ 4705 - يحيى بن ولد يزيد بن أبي زياد: قال ابن معين: كذاب.(@)(@@)(@@)(@@) $ 4706 - يحيى: عن عمير، عن علي في الحدود: مجهول ولا يصح حديثه.(@)(@@)(@@)(@@) || يزيد(@)PageV01P440(@)(@@)(@@)(@@) $ 4707 - يزيد بن أبان الرقاشي العابد: قال النسائي وغيره: متروك. -ت، ق-(@)(@@)(@@)(@@) $ 4708 - يزيد بن أمية: عن رجل، عن البراء بن عازب: مجهول.(@)(@@)(@@)(@@) $ 4709 - يزيد بن بابنوس: عن عائشة رضي الله عنها: مجهول. -د، س-(@)(@@)(@@)(@@) $ 4710 - يزيد بن بزيع: عن عطاء، ضعفه الدارقطني وغيره.(@)(@@)(@@)(@@) $ 4711 - يزيد بن بشر: مجهول.(@)(@@)(@@)(@@) $ 4712 - يزيد بن بلال الفزاري: عن علي رضي الله عنه، حديثه منكر.(@)(@@)(@@)(@@) $ 4713 - يزيد بن بيان البصري: عن أبي الرجال، ضعفه الدارقطني.(@)(@@)(@@)(@@) $ 4714 - يزيد بن حجر: تفرد عنه إسماعيل 
ms190	 بن عياش، وجهل حاله.(@)(@@)(@@)(@@) $ 4715 - يزيد بن حريز: مجهول.(@)(@@)(@@)(@@) $ 4716 - يزيد بن حصين بن نمير: عن أبيه، لم يصح، قاله البخاري.(@)(@@)(@@)(@@) $ 4717 - يزيد بن خالد: شيخ لبقية: مجهول كغالب شيوخه وهم عوام.(@)(@@)(@@)(@@) $ 4718 - يزيد بن درهم، أبو العلاء: عن أنس، قال ابن معين: ليس بشيء.(@)(@@)(@@)(@@) $ 4719 - يزيد بن ربيعة الرحبي الدمشقي: عن أبي الأشعث، قال البخاري: أحاديثه مناكير، وقال النسائي: متروك.(@)(@@)(@@)(@@) $ 4720 - يزيد بن روح اللخمي. ويزيد بن زياد الحميري: مجهولان.(@)(@@)(@@)(@@) $ 4721 - يزيد بن زريع الرملي. لا البصري: عن عطاء الخراساني، ضعفه ابن معين.(@)(@@)(@@)(@@) $ 4722 - يزيد بن أبي زياد الكوفي: صدوق ساء حفظه، ضعفه ابن معين، وقال أحمد: ليس بذاك، وقال الجوزجاني: سمعتهم يضعفون حديثه. وقال آخر: ليس بالقوي، وخلط بعض الناس بينه وبين الذي قبله، فأما النسائي فقال: يزيد بن زياد(@)(@@) عن الزهري: متروك الحديث، ثم قال بعد أسطر: يزيد بن أبي زياد، كوفي ليس بالقوي. -م، مقرونا. عه-(@)(@@)(@@)(@@) $ 4723 - يزيد بن زياد: عن محمد بن كعب، عن معاوية، قال البخاري: لا يتابع عليه. -ت-(@)(@@)(@@)(@@) $ 4724 - يزيد بن زيد: شيخ لأبي إسحاق السبيعي، لا يعرف.(@)(@@)(@@)(@@) $ 4725 - يزيد بن سفيان، أبو المهزم: عن أبي هريرة رضي الله عنه، ضعفوه. -د، ت، ق-(@)(@@)(@@)(@@) $ 4726 - يزيد بن سفيان: عن سليمان التيمي، له نسخة منكرة، ضعف بها.(@)(@@)(@@)(@@) $ 4727 - يزيد بن أبي سلمة الأيلي: قال ابن معين: ضعيف.(@)(@@)(@@)(@@) $ 4728 - يزيد بن السمط: قال الحاكم: ضعيف. -ق-(@)(@@)(@@)(@@) $ 4729 - يزيد بن سنان الرهاوي، أبو فروة: ضعفه أحمد، وجماعة. -ت، ق-(@)(@@)(@@)(@@) $ 4730 - يزيد بن شداد. ويزيد بن صالح: مجهولان.(@)(@@)(@@)(@@) $ 4731 - يزيد بن عبد الله البغدادي: قال أبو حاتم: مجهول.(@)(@@)(@@)(@@) $ 4732 - يزيد بن عبد الله بن قسيط:(@)(@@) صدوق، قال أبو حاتم: ليس بقوي، وقال ابن عدي: هو صالح، وقال مالك وقد سئل عن حديث في الجراحات: تفرد به ابن قسيط تحدثنا به، قال: رجله ليس عندنا هناك. -ع-(@)(@@)(@@)(@@) $ 4733 - يزيد بن عبد الله: شيخ لمكحول، شامي، لا يعرف.(@)(@@)(@@)(@@) $ 4734 - يزيد بن عبد الله القرشي البصري: عن ابن جريج، مقل يغرب.(@)(@@)(@@)(@@) $ 4735 - يزيد بن عبد 
ms191	 الرحمن، أبو خالد الدالاني: قال أحمد: لا بأس به، وقال ابن حبان: فاحش الوهم لا يجوز الاحتجاج به. -عه-(@)(@@)(@@)(@@) $ 4736 - يزيد بن عبد الملك النوفلي: عن المصري، ضعفوه. -ق-(@)(@@)(@@)(@@) $ 4737 - يزيد بن عدي بن حاتم الطائي: عن أبيه في الصوم، لا يصح حديثه.(@)(@@)(@@)(@@) $ 4738 - يزيد بن عطاء: مولى أبي عوانة الوضاح، قال أحمد: حديثه مقارب. -د-(@)(@@)(@@)(@@) $ 4739 - يزيد بن عطارد: قال أحمد: لا يحتج به.(@)(@@)(@@)(@@) $ 4740 - يزيد بن عمر التميمي: شيخ جميع بن عمر، في صفة النبي - صلى الله عليه وآلهوسلم - لا يصح.(@)(@@)(@@)(@@) $ 4741 - يزيد بن عمر: عن مجالد: مجهول، وكذا يزيد بن عوف شيخ لبقية.(@)(@@)(@@)(@@) $ 4742 - يزيد بن عيسى البصري: عن حماد بن سلمة، قال ابن حبان: لا يحتج به.(@)(@@)(@@)(@@) $ 4743 - يزبد بن عياض بن جعدبة: عن الأعرج، قال النسائي: متروك. -ت، ق-(@)(@@)(@@)(@@) $ 4744 - يزيد بن فراس: عن أبان: مجهول، وكذا يزيد بن كعب العوذي.(@)(@@)(@@)(@@) $ 4745 - يزيد بن كيسان: عن أبي حازم الأشجعي، ثقة، قال أبو حاتم: لا يحتج به، وقال يحيى القطان: هو وسط صالح. -م، عه-(@)(@@)(@@)(@@) $ 4746 - يزيد بن محمد: عن عمر بن عبد العزيز، لا يعرف.(@)(@@)(@@)(@@) $ 4747 - يزيد بن مروان الخلال: قال يحيى بن معين: كذاب.(@)(@@)(@@)(@@) $ 4748 - يزيد بن معاوية، أبو شيبة: قال أبو حاتم: ليس بالقوي.(@)(@@)(@@)(@@) $ 4749 - يزيد بن مغلس الباهلي: عن مالك، قال ابن حبان: ليس بحجة.(@)(@@)(@@)(@@) $ 4750 - يزيد بن مهران الكوفي الخباز: ضعفه أبو داود.(@)(@@)(@@)(@@) $ 4751 - يزيد بن ميمون: مجهول، وكذا يزيد بن مسهر.(@)(@@)(@@)(@@) $ 4752 - يزيد بن يزيد: عن خولة في الظهار، قال البخاري: في حديثه نظر. -ت-(@)(@@)(@@)(@@) $ 4753 - يزيد بن يوسف الصنعاني: عن الأوزاعي، تركوه.(@)(@@)(@@)(@@) $ 4754 - يزيد بن يوسف: عن التابعين، مصري لا يعرف.(@)(@@)(@@)(@@) $ 4755 - يزيد، أبو خالد السراج: عن مكحول، قال أبو حاتم: منكر الحديث.(@)(@@)(@@)(@@) $ 4756 - يزيد، أبو سلمان. ويزيد أبو طلحة: مجهولان.(@)(@@)(@@)(@@) || يسار(@)PageV01P444(@)(@@)(@@)(@@) $ 4757 - يسار البناني: قال ابن معين: لا شيء.(@)(@@)(@@)(@@) || يسر(@)PageV01P444(@)(@@)(@@)(@@) $ 4758 - يسر بن عبد الله: عن أنس، ساقط عدم.(@)(@@)(@@)(@@) || اليسع(