ms501	 قتيل غير الأعين % % PageV01P1773 البحر : كامل تام 1(@)(@@) % قد قلت للرجل المقسم أمره % % فوض إليه تنم قرير العين % 2(@)(@@) % رد الأمور إلى العليم بغبها % % وتلق ما يعطيكه بيدين % 3(@)(@@) % الله أنظر لي من النفس التي % % تغوى وأرأف بي من الأبوين % % PageV01P1774 البحر : متقارب تام 1(@)(@@) % ضلالا لسائل هذي المغاني % % وغيا لطالب تلك الغواني % % 2(@)(@@) % وما أربي بسؤال الطلو % % ل إلا تذكر ماضي زماني % % 3(@)(@@) % خليلي إن جزتما ضارجا % فكرا المطي ، وردا المثاني % % 4(@)(@@) % وعوجا علي أحي الديار % فإن الديار لمن تعلمان % % 5(@)(@@) % سقاك ولو بظما مهجتي % % نجوم السماك ، أو المرزمان % 6(@)(@@) % ولا زال جوك في ناضر % % من النور يحمده الرائدان % % 7(@)(@@) % ليالي بين برود الشبا % % ب مني غصن رطيب المجاني % % 8(@)(@@) % وقد رجل البيض من لمثي % % بطفل الأنامل بض البنان % % 9(@)(@@) % أفالآن لما أضاء المشيب % % وأمسى الصبا ثانيا من عناني % % 10(@)(@@) % وقد صقل السيف بعد الصدا % % وبان لظى النار بعد الدخان % % PageV01P1775 11(@)(@@) % يرد الزمان علي الهوى % % ويطمع في هفوة من جناني % % 12(@)(@@) % فقل لليالي : ألا فاقصري % % كفاني ما عند قلبي كفاني % % 13(@)(@@) % فإن الموفق لي جنة % % أرد بها كل رام رماني % % 14(@)(@@) % أغر هجان ، وما المكرمات % بطوعى لغير الأغر الهجان % % 15(@)(@@) % أيا عمدة الملك لا استهدمت % % ذراه وأنت لها اليوم باني % % 16(@)(@@) % وكيف يني الملك عما تروم % وسعيك من دونه غيرواني % % 17(@)(@@) % شددت قواه إلى هضبة % % أواخيها كل عضب يماني % % 18(@)(@@) % مآثر ثبت أطنابها % % على النجم والقمر الأضحيان % % 19(@)(@@) % حدوت إلى فارس بالرماح % % بكر الردى يوم حرب عوان % % 20(@)(@@) % وجردا تفالت أرسانها % % ليوم النزال ويوم الرهان % PageV01P1776 21(@)(@@) % وأقبلتها كذئاب الغضى % % تعاسل في الفيلق الأرجوان % 22(@)(@@) % تلمظ ألسنة السمهر % ما بين آذانها للطعان % % 23(@)(@@) % بأيدي جريين لاكوا الحرو % % ب وارتضعوها ارتضاع اللبان % % 24(@)(@@) % بحيث ترى العزام الشجاع % % وتقنع بالذل أم الجبان % % 25(@)(@@) % على كل معط علي السيا % % ط لا يسترد بغير العنان % 26(@)(@@) % يكر إلى الطعن سامي اللبان % % ويثنى عن الطعن دامي البنان % % 27(@)(@@) % سرى يعجز النجم عن طرقه % % طويل إذا نام ليل 
ms502	 الهدان % % 28(@)(@@) % وعزم يشاور حد الحسام % % 29(@)(@@) % مواقف يذهل فيها الشجاع % فما الظن بالعاجز الهيبان % 30(@)(@@) % نشرت العدا بددا بعدما % % نظمت الممالك نظم الجمان % PageV01P1777 31(@)(@@) % وكم عصبة أوضعت في الضلال % تنقب عن يومها الأرونان % 32(@)(@@) % جذبت عن الغي أرسانها % % وقد شافهتها المنايا الدواني % % 33(@)(@@) % وأرسلتها بغرار الحسام % وخاطبتها بلسان السنان % 34(@)(@@) % فأعطتك آبي أعناقها % % تطيع المقاود بعد الحران % 35(@)(@@) % تشكى مورنها في يديك % % مس الخشاش وجذب العران % % 36(@)(@@) % فضائل ألفت أشتاتها % % ولم تك موجودة بالعيان % 37(@)(@@) % فما القلم اللدن في راحتيك % بأولى من الأسلات اللدان % 38(@)(@@) % نهنك نعماء سربلتها % % تقطع عنها العيون الرواني % % 39(@)(@@) % على لقب بينت صدقه % مناقبك الغر كل البيان % % 40(@)(@@) % والقاب قوم إذا برتها % % تباين ألفاظها والمعاني % % PageV01P1778 41(@)(@@) % فلا ارتجع العز معطيكه % ولا زلت من عشرة في أمان % 42(@)(@@) % ولازم ثوبيك صبغ العلى % % كما لزمت صبغة الزبرقان % 43(@)(@@) % فما دمت فالملك واري الزنا % % د ، صافي الموارد ، عالي المباني % % 44(@)(@@) % لقد نال من عزك الأبعدون % % وقرب من شأنه غير شاني % % 45(@)(@@) % فرشني أكن لك سهم النضال % واغصب علي يدي من براني % % 46(@)(@@) % وحك لي برد العلى ضافيا % أحك لك أمثاله من لساني % % 47(@)(@@) % إذا كنت عوني فمن ذا الذي % % يثبطني عن بلوغ الأماني % % 48(@)(@@) % وأنت الزمان ، وأنى يخي % % من كان مستشفعا بالزمان % PageV01P1779 البحر : طويل 1(@)(@@) % زمان الهوى ما أنت لي بزمان % ولا لك من قلبي أعز مكان % % 2(@)(@@) % ابعد القباب اللاء زلن عن الحمى % % أراعي الهوى في أربع ومغان % % 3(@)(@@) % وسيري أمام الحي والليل حابس % على الظعن من جدل لنا ومثاني % % 4(@)(@@) % وملتبس بالركب بادرت خلفه % % ألوح بالأردان وهو يراني % % 5(@)(@@) % وآخر هزتني إليه ارتياحة % ومن دونه ذو صفصف ورعان % 6(@)(@@) % تحملت سهما أولا من فراقه % % فلما رآني لا أخور رماني % % 7(@)(@@) % أقول له والدمع يأخذ ناظري % % بأبيض من ماء الشؤون ، وقاني : % 8(@)(@@) % أترضى عن الدنيا ومولاك ساخط % % وتمضي طليقا وابن عمك عاني ؟ % 9(@)(@@) % وفي ذلك الوادي الذي أنبت الهوى % % جنابان من نواره ، أرجان % 10(@)(@@) % وماء تشيه الريح 
ms503	 كل عشية % كما رقم البرد الصبيغ يماني % % PageV01P1780 11(@)(@@) % مررت بغزلان على جنباته % فأطلقن دمعي واختبلن جناني % % 12(@)(@@) % وعاجلني يوم الرفيقين في الهوى % % عشية مالي بالفراق يدان % % 13(@)(@@) % وكم غادر البين المفرق من فتى % % يمسح قلبا دائم الخفقان % % 14(@)(@@) % ومنتزع من بين جنبيه زفرة % تخلي دموع العين في الهملان % 15(@)(@@) % وما الحب إلا فرقة بعد ألفة % % وإلا حذار بعد طول أمان % % 16(@)(@@) % هو الشغل استولى على كل مهجة % وألقى ذراعيه بكل جنان % 17(@)(@@) % سلوت الهوى والشوق الا ذؤابة % % تراجع قلبي من نوى وتداني % % 18(@)(@@) % وصرت أرى أن الشجون علاقة % تليق بقلب العاجز المتواني % % 19(@)(@@) % فها أنا ذا لا أمتع العين بالكرى % % وتأمل قود النوم بعد حران % % 20(@)(@@) % تقلص عن مس النعاس جفونها % % كما قلصت للبارد الشفتان % PageV01P1781 21(@)(@@) % تجمجم للأطماع في كل ليلة % وتقلع عن قلبي بغير بيان % 22(@)(@@) % غرضت من العلياء وهي تطول بي % % كما غرض المقصوص بالطيران % 23(@)(@@) % ولو شئت جلى بي إلى غاية العلى % % جوادي ولكني أرد عناني % % 24(@)(@@) % ومولى دعا غيري إلى ما يريده % % ولو أنني ممن يجيب دعاني % % 25(@)(@@) % وحاول أمرا يصعب الريق دونه % % بناجد مزؤد الفؤاد جبان % % 26(@)(@@) % ينازعني الشحناء أني لقيته % ولو أنني يوما حذرت رقاني % % 27(@)(@@) % وعوراء لم أنصت إليها ولم أرد % جوابا لها ، والقول ليس بوان % 28(@)(@@) % ولكنني أغضيت عنها كأنما % % أقول بسمعي ، أو أعي بلساني % % 29(@)(@@) % أرى السرح أولى بي من الكور في الوغى % % وما ناقتي إلا فداء حصاني % % 30(@)(@@) % ولما تعاطينا النزال انبرى لنا % % ملب على أعواده بلبان % PageV01P1782 31(@)(@@) % فسدد رمحا لم يكن بمثقف % وجرد عضبا لم يكن بيماني % % 32(@)(@@) % حذار بني العنقاء من متطاول % إلى الحرب لا يخشى جناية جان % 33(@)(@@) % وداهية تصمي القلوب كأنما % % تمطر عن قوس من الشريان % % 34(@)(@@) % فهذا وعيد سطوتي من ورائه % وعنوان ناري إن يبين دخاني % % 35(@)(@@) % فلا يحسب الأعداء كيدي غنيمة % ولا أنني في الشر غير معان % % 36(@)(@@) % فإني بحمد الله أقوى على الأذى % % وأنمى على البغضاء والشنآن % 37(@)(@@) % وابيض من عليا معد كأنما 
ms504	 % % تلاقى على عرنينه القمران % % 38(@)(@@) % إذا رمت طعنا بالقريض حميته % وإن رمت طعنا بالرماح حماني % % 39(@)(@@) % يجود ، إذا ضن الجبان ، بنفسه % % ويمضي ، إذا ما زلت القدمان % 40(@)(@@) % بصير بتصريف الأعنة إن سرى % % ليوم نزال ، أو ليوم رهان % PageV01P1783 41(@)(@@) % ترامى به الأيام ، وهو مصمم % كما يرتمي بالماتح الرجوان % % 42(@)(@@) % إذا ما احتبى يوم الخصام كأنما % % يحدثنا عن يذبل وأبان % 43(@)(@@) % أبا أحمد ! أنت الشجاع ، وإنما % % تجر العوالي عرضة لطعان % 44(@)(@@) % ولما غوى الغاوون فيك وفرجت % % ضلوع على الغل القديم حواني % % 45(@)(@@) % نجوت عن الغماء ، وهي قريبة % نجاء الثريا من يد الدبران % 46(@)(@@) % وغيرك غض الذل من نجواته % وطامن للأيام شخص مهان % % 47(@)(@@) % وحال الأذى بين المراد وبينه % كما حيل بين العير والنزوان % 48(@)(@@) % وكان كفحل البيت يطمح رأسه % % فألقى على حكم الردى بجران % 49(@)(@@) % وآخر راخى من قواك ببدعة % % ستشرد في الدنيا بغير عنان % 50(@)(@@) % فأشهد أن ما عرقت فيه هاشم % % ولا عل يوما من لبان حصان % % PageV01P1784 51(@)(@@) % إذا المرء لم يحفظ ذماما لقومه % % فأحج به أن لا يفي بضمان % 52(@)(@@) % ونازعك العلياء من آل غالب % شعوب ، ومن أد ، ومن غطفان % 53(@)(@@) % فوارس يلقون الردى بنفوسهم % % سراعا ولا يدعون يال فلان % % 54(@)(@@) % ولو شئت لما طالعتك رماحهم % وأطرافها عوج إليك دواني % % 55(@)(@@) % هرقت دماء ما لها ، الدهر ، طالب % كما هرقت خرقاء قعب لبان % 56(@)(@@) % وحي بثثت الخيل بين بيوتهم % وكانوا على أمن من الحدثان % 57(@)(@@) % أقمتهم من روعة عن شوائهم % % يمشون بالأعراف كل بنان % 58(@)(@@) % أأغضي على ضيم ، وعزك ناصري % % وباعي طويل من وراء سناني ؟ % 59(@)(@@) % إذا فعداني الضيف في كل ليلة % وكبت بإعجاز البيوت جفاني % % 60(@)(@@) % وما ارتاع مطلوب يكون وراءه % % بأغلب من آل النبي هجان % PageV01P1785 61(@)(@@) % لك الخير لا أرضى بغيرك حاكما % علي ، ولا أعطي القياد زماني % % 62(@)(@@) % وإن أطلب الضخم اللغاديد غايتي % % فرب جماد عد في الحيوان % PageV01P1786 البحر : وافر تام 1(@)(@@) % أمن شوق تعانقني الأماني % % وعن ود يخادعني زماني % % 2(@)(@@) % وما أهوى مصافحة الغواني % % إذا اشتغلت بناني بالعنان 
ms505	 % 3(@)(@@) % عدمت الدهر كيف يصون وجها % يعرض للضراب وللطعان % 4(@)(@@) % وأسفع لثمته الشمس ندب % أبينا إن يلقب بالهجان % % 5(@)(@@) % وكم متضرم الوجنات حسنا % إذا جربته نابي الجنان % % 6(@)(@@) % تعرفني بأنفسها الليالي % % وآنف أن أعرفها مكاني % % 7(@)(@@) % أنا ابن مفرج الغمرات سودا % % تلاقى تحتها حلق البطان % % 8(@)(@@) % وجدي خابط البيداء حتى % % تبدى الماء من ثغب الرعان % 9(@)(@@) % قضى ، وجياده حول العوالي % % ووفد ضيوفه حول الجفان % % 10(@)(@@) % تكفنه ظبى البيض المواضي % % ويغسله دم السمر اللدان % PageV01P1787 11(@)(@@) % نشرت على الزمان وشاح عز % % ترنح دونه المقل الرواني % % 12(@)(@@) % خفيري في الظلام أقب نهد % % يساعدني على ذم الزمان % % 13(@)(@@) % جوادي ترعد الأبصار فيه % % إذا هزأت برجليه اليدان % 14(@)(@@) % كأني منه في جاري غدير % % ألاعب من عناني غصن بان % 15(@)(@@) % حيي الطرف إلا من مكر % يبين من خلائقه الحسان % 16(@)(@@) % إذا استطلعته من سجف بيت % % ظننت بأنه بعض الغواني % % 17(@)(@@) % سأطلع من ثنايا الدهر عزما % يسيل بهمة الحرب العوان % 18(@)(@@) % ولا أنسى المسير إلى المعالي % % ولو نسيته أخفاف الحواني % % 19(@)(@@) % وألطاف السحاب لكل دار % % صحبنا ربعها خضل المغاني % % 20(@)(@@) % وكنا لا يروعنا زمان % % بما يعدي البعاد على التداني % % PageV01P1788 21(@)(@@) % ونأنف أن تشبهنا الليالي % % بشمس أو سنا قمر هجان % % 22(@)(@@) % فها أنا والحبيب نود أنا % % تدانينا ونحن الفرقدان % % 23(@)(@@) % وليل أدهم قلق النواصي % % جعلت بياض غرته سناني % % 24(@)(@@) % وصبح تطلق الآجال فيه % % وناظر شمسه في النقع عاني % % 25(@)(@@) % عقدت ذوائب الأبطال منه % % بأطراف المثقفة الدواني % % 26(@)(@@) % وشعث فلهم طلب المعالي % % وفلوا كل منجرد حصان % % 27(@)(@@) % أقول لهم ثقوا بالله فيها % % ففضل يد المعين على المعان % 28(@)(@@) % ولا تتعرضوا بالعز ، إني % % رأيت العز خوار العنان % 29(@)(@@) % فما ركب العلى إلا علي % ومسح عطفها بعد الحران % 30(@)(@@) % سعى والشمس ترقى في أناة % % فجاز وسيرها في الجو وان % PageV01P1789 31(@)(@@) % رموا منك المدى ، والخيل شعث % بمصقول العوارض واللبان % % 32(@)(@@) % يد لم تخل من قصب العوالي % % تزعزعهن ، أو قصب الرهان % 33(@)(@@) % تركت لهم عيون الطعن تدمى % % بمنخرط من التأمور قان % % 34(@)(@@) % وقد 
ms506	 نصل الدجى عن صدر يوم % % من الخرصان مخضوب البنان % 35(@)(@@) % وأجساد تشاطرها المنايا % % نفوسا في ضراب أو طعان % 36(@)(@@) % هو الغمر الرداء لعزمتيه % بكل دفاع نائبة يدان % % 37(@)(@@) % وما نهض امرؤ بالحزم إلا % وصادف حلمه ملقى الجران % % 38(@)(@@) % يضم الخائف الظمآن منه % % حمى يفتر من برد الأماني % % 39(@)(@@) % وتضحك ناره وضحا ، إذا ما % % رغت نار القبائل بالدخان % 40(@)(@@) % ويوم مثل شدق الليث جهم % يفل عن الجدال ظبى اللسان % PageV01P1790 41(@)(@@) % سددت فروجه بالقول حتى % % مددت مشيعا باع البنان % % 42(@)(@@) % وغيرك من تروعه المعالي % % وتخدعه أغاني القيان % 43(@)(@@) % إذا ذكر الصوارم والعوالي % % تعوذ بالمثالث والمثاني % % 44(@)(@@) % وإن طلب الذحول تهضمته % % وباع دم الفوارس باللبان % 45(@)(@@) % أبا سعد دعاء لو تراخت % % أوائله لعاقبها لساني % % 46(@)(@@) % ظفرت بما اشتهيت من الليالي % % وأعطيت المراد من الأماني % % 47(@)(@@) % لكفك فوزة القدح المعلى % % ومنها صولة العضب اليماني % % 48(@)(@@) % ولما خرق الإظلام جبنا % خلعت عليه ثوب المهرجان % 49(@)(@@) % إذا طردت رماح اللهو فيه % أرقن على الكؤوس دم القنان % 50(@)(@@) % وشرب قد نحرت لهم عقارا % كحاشية الرداء الأرجواني % % PageV01P1791 51(@)(@@) % كأن الشمس مال بها غروب % فأهوت في حيازيم الدنان % 52(@)(@@) % فصل بدم العقار دم الأعادي % % وأصوات العوالي بالأغاني % % 53(@)(@@) % فيوم أنت غرته جواد % يبذ بشأوه طلق القران % 54(@)(@@) % جعلت هديتي فيه نظاما % % صقيلا مثل قادمة السنان % 55(@)(@@) % بلفظ فاسق اللحظات تنمى % % محاسنه إلى معنى حصان % % 56(@)(@@) % وصلت جواهر الألفاظ فيه % بأعراض المقاصد والمعاني % % 57(@)(@@) % فجاءت غضة الأطراف بكرا % تخير جيدها نظم الجمان % % 58(@)(@@) % كأن أبا عبادة شق فاها % % وقبل ثغرها الحسن بن هاني % % PageV01P1792 البحر : مجزوء الرمل 1(@)(@@) % اسقني فاليوم نشوان % % والربى صاد وريان % 2(@)(@@) % كفلت باللهو وافية % % لك نايات وعيدان % 3(@)(@@) % حاز وفد الريح ، فالتطمت % منه أوراق وأغصان % 4(@)(@@) % كل فرع مال جانبه % % فكأن الأصل سكران % 5(@)(@@) % وكأن الغصن مكتسيا % من رياض الطل عريان % % 6(@)(@@) % كلما قبلت زهرتها % % خلت أن القطر غيران % 7(@)(@@) % ومقيل بين أخبية % % قلته ، والحي قد بانوا % % 8(@)(@@) % في أصيحاب مفارشهم % ثم انقاء وكثبان % 9(@)(@@) % عسكرت فيها 
ms507	 السحاب كما % % حط بالبيداء ركبان % 10(@)(@@) % فارتشفنا ريق سارية % حيث كل الأرض غدران % PageV01P1793 11(@)(@@) % فاسقني فالوصل يألفني % % إن يوم البين قرحان % 12(@)(@@) % قهوة ما زال يقلق من % مجتناها المسك والبان % 13(@)(@@) % غير سمعي للملام ، إذا % % ضج ساجي الصوت مرنان % % 14(@)(@@) % رب بدر بت ألثمه % صاحيا ، والبدر نشوان % 15(@)(@@) % قدت خيل اللثم أصرفها % % حيث ذاك الخد ميدان % 16(@)(@@) % لي غدير من مقبله % % ومن الصدغين بستان % 17(@)(@@) % في قميص الليل عبقة من % % ظن أن الوصل كتمان % 18(@)(@@) % كيف لا تبلى غلائله % % وهو بدر ، وهي كتان % 19(@)(@@) % وندامي كالنجوم سطوا % % بالمنى والدهر جذلان % % 20(@)(@@) % كم تخلت من ضمائرهم % % ثم ، ألباب وأذهان % PageV01P1794 21(@)(@@) % خطروا والخمر تنفضهم % % وذيول القوم أردان % 22(@)(@@) % كل عقل ضاع من يقظ % % فهو في الكاسات حيران % % 23(@)(@@) % إنما ضلت عقولهم % حيث يعييهن وجدان % % 24(@)(@@) % فاختلس طعن الزمان بها % % إنما الأيام أقران % PageV01P1795 البحر : وافر تام 1(@)(@@) % حبيبي هل شهود الحب إلا % اشتياق أو نزاع أو حنين % % 2(@)(@@) % لقد آوى محلك من فؤادي % % مكان لو علمت به مكين % % 3(@)(@@) % إذا قدرت أني عنك سال % % فذاك اليوم أعشق ما أكون % 4(@)(@@) % فلا تخش القطيعة إن قلبي % % عليك اليوم مأمون أمين % % PageV01P1796 البحر : طويل 1(@)(@@) % جنى وتجنى والفؤاد يطيعه % % فيأمن أن يجنى عليه كما يجني % % 2(@)(@@) % إلى كم تسيء الظن بي متجرما % وأنسب سوء الظن منك إلى الضن % 3(@)(@@) % ووالله لا أحببت غيرك واحدا % ألية بر لا تخاف ، فنستثني % % 4(@)(@@) % فإن لم تكن عندي كسمعي وناظري % % فلا نظرت عيني ، ولا سمعت أذني % % 5(@)(@@) % وإنك أحلى في جفوني من الكرى % % وأعذب طعما في فؤادي من الأمن % PageV01P1797 البحر : كامل تام 1(@)(@@) % صبرا غريم الثار من عدنان % % حتى تقر البيض في الأجفان % 2(@)(@@) % أوما اتقيت ، وقد كفيت فوارسا % يتجاذبون عوالي المران % % 3(@)(@@) % من كل ميال العمامة ، كفه % يلوي الرداء على أغر هجان % % 4(@)(@@) % في كل يوم أو بكل مقامة % % يتذاكرون مقاتل الفرسان % 5(@)(@@) % إذ لا يضيفون المعائب بينهم % % وبيوتهم وقف على الضيفان % % 6(@)(@@) % الضامنين لطيرهم مهج العدا % % عن كل 
ms508	 ضرب صادق وطعان % % 7(@)(@@) % الراكبين الخيل تعرفها بهم % تحت العجاج إذا التقى الخيلان % 8(@)(@@) % قوم إذا هطلت سحاب أكفهم % هطل الحيا ، فتعانق القطران % 9(@)(@@) % وإذا حووا سبق القبائل خلقوا % % غرر السوابق بالنجيع القاني % % 10(@)(@@) % وإذا رأيتهم على سرواتها % % أبصرت عقبانا على عقبان % PageV01P1798 11(@)(@@) % أساد حرب لا ينهنهها الردى % % تحت الظبا وأسنة المران % % 12(@)(@@) % يطأون خد الترب وهو مضرج % % من طعنهم بدم القلوب الآني % % 13(@)(@@) % يا آل عدنان الذين تبوأوا % % في المجد كل ممنع الآركان % 14(@)(@@) % أيديكم أري العباد وشريها % % ومفاتح الأرزاق والحرمان % % 15(@)(@@) % وإليك عط بي الظلام عذافر % متجلبب بالنص والذملان % 16(@)(@@) % وإذا ترشفه السرى في جريه % لفظت يديه مكامن الغيطان % 17(@)(@@) % وكأن نورا منك عاق لحاظه % فأتاك لا يرنو إلى الغدران % 18(@)(@@) % كفاك في اللأواء ينقع فيهما % % ظمأ المطامع ، أو صدا الخرصان % 19(@)(@@) % في ضمر يخرجن من حلل الدجى % % كالغضف خارجة من الأرسان % 20(@)(@@) % قدم السرور بقدمة لك بشرت % % غرر العلى وعوالي التيجان % % PageV01P1799 21(@)(@@) % فلقت ظبى الأسياف منك بعرجة % فيكاد ينهضها من الأجفان % 22(@)(@@) % وأتى الزمان مهنئا يحدو به % % غل المشوق وغلة اللهفان % % 23(@)(@@) % قد كان هذا الدهر يلحظ جانبي % % عن طرف ليث ساغب ظمآن % 24(@)(@@) % فالآن حين قدمت عدن صروفه % يرمقنني بنواظر الغزلان % 25(@)(@@) % يا منتهي الآمال بل يا محتوي % % الآجال بل يا أشجع الشجعان % % 26(@)(@@) % يا أفضل الفضلاء بل يا أعلم ال % % العلماء بل يا أطعن الأقران % % 27(@)(@@) % يا قائد الجرد العتاق بهيبة % % تغنيه عن لجم وعن أرسان % % 28(@)(@@) % يا ضارب الهامات ، وهي نوافر % تشكو تفرقها إلى الأبدان % % 29(@)(@@) % يا طاعنا بالرمح يرعف زجه % % علقا ، بمجة عامل وسنان % 30(@)(@@) % هذي القوافي واثقات أنها % % من رحب جودك في أعز مكان % % PageV01P1800 31(@)(@@) % تاهت إليك على القريض فردها % % بنداك تائهة على الأزمان % PageV01P1801 البحر : بسيط تام 1(@)(@@) % ورب يوم صقيل الوجه تحسبه % مرصعا بجباه الخرد العين % % 2(@)(@@) % أتاك يقتاد عيدا في حقائبه % زاد السرور على الطير الميامين % % 3(@)(@@) % فالبس جلابيبه البيض التي شرفت % % واخرج عن الصوم من أثوابه الجون % 4(@)(@@) % إليك 
ms509	 يستن والأحشاء يتبعها % % عن غرب فكر بغرب الشوق مقرون % % 5(@)(@@) % جاءت تهنيك بالود الذي علقت % % منا الضمائر لا يوم الشعانين % % PageV01P1802 البحر : بسيط تام 1(@)(@@) % الليل ينصل بين الحوض والعطن % % والبرق يسدي برود العارض الهتن % 2(@)(@@) % والجفن يفتر عن طرف صحبت به % % إنسانه مثقل العطفين بالوسن % 3(@)(@@) % في ليلة أوعدت بالبين ، فاختلست % من العيون نقايا غبر الوسن % % 4(@)(@@) % حتى نظرت ، ولي عين مؤرقة % تقسم الدمع بين الربع والظعن % PageV01P1803 البحر : طويل 1(@)(@@) % قنا آل فهر لا قنا غطفان % حمت أهلها من طارق الحدثان % % 2(@)(@@) % بني عامر ! ما لي وللدهر بعدما % % يشتت بي عن صعدتي وحصاني % % 3(@)(@@) % وقد كنت لا أصغى إلى السلم ساعة % % وأتبع داعي الحرب أين دعاني % % 4(@)(@@) % دعوا صهوات الخيل تدمى وفرقوا % % رجالا عن البغضاء والشنان % % 5(@)(@@) % فكم صاحب تدمى علي بنانه % % ويظهر أن العز لثم بناني % % 6(@)(@@) % يضم حشى البغضاء عند تغيبي % % ويجلو جبين الود حين يراني % % 7(@)(@@) % مسحت بحلمي ضغنه عن جنانه % % فلما أبى مسحته بسناني % % 8(@)(@@) % سبقت برميي قلبه ، فأصبته % % ولو لم أصبه عاجلا لرماني % % PageV01P1804 البحر : كامل تام 1(@)(@@) % يا صاحب الجدث الذي نفثت به % فاسترجعته برغمنا الأزمان % 2(@)(@@) % نبكيك لو يثنى بأدمعنا الردى % % أو يرعوي لبكائنا الحدثان % % 3(@)(@@) % أنزلت أقرب منزل منا فلم % بعد المدى وتعذر اللقيان % 4(@)(@@) % لولا هجير الدمع ، بل هجر الكرى % % دفنتك في أحشائها الأجفان % % PageV01P1805 البحر : كامل تام 1(@)(@@) % بمجال عزمي يملأ الملوان % % وتضل فيه بوائق الأزمان % 2(@)(@@) % عزم رضيع لبان أطراف القنا % % في حيث يرضع من نجيع لبان % 3(@)(@@) % كم من حشى خطب شققت ضميره % وأرقت في دمه دم الأضغان % 4(@)(@@) % والليل منخرق القميص عن الضحى % % قد كدت أرقعه بنقع حصاني % % 5(@)(@@) % وكأن أنجمه وجوه خرائد % % سترت من القسطال بالأردان % 6(@)(@@) % وخرجت عن أعجازه من بعد ما % % جذب النعاس عمائم الركبان % % 7(@)(@@) % في مهمه صقل المحول متونه % لم يصد قط بوابل هتان % 8(@)(@@) % أرض حصان من ملامسة الحيا % % والأرض تحمد منه غير حصان % 9(@)(@@) % ثم ارتمت بالغيث فيه غمامة % % وسقت غليل الجدب 
ms510	 بالتهتان % 10(@)(@@) % فطوى الحيا برد النحول ونشرت % رمم الصعيد غدائر الأغصان % PageV01P1806 11(@)(@@) % وكأن أنفاس الصبا في حجرها % % يسفحن دمع المزن في الحجران % 12(@)(@@) % دمعا ، إذا ما فاض صور أعينا % حيث استقر به من الغدران % % 13(@)(@@) % وتريك من أوراقهن أهلة % % تحت الغزالة ، شرد الغزلان % 14(@)(@@) % ولكم عقدت عرى الخطاب بخطبة % % حلت بفيصلها عرى الحدثان % 15(@)(@@) % لي همة أقطعتها قصد القنا % % في قصد يومي معرك ورهان % 16(@)(@@) % لو حاربت أفق السماء لفرقت % بين الثريا فيه والدبران % 17(@)(@@) % عنوان بأسي أن يصول مهندي % % وردى عدوي أن يطول لساني % % 18(@)(@@) % لا تجمعني والزمان ، فإنه % عود يحك جرانه بجراني % % 19(@)(@@) % إني لألحظ ذا الأنام مجانبا % عن مقلة وحشية الإنسان % 20(@)(@@) % أسطو بجأش فتى يفرق سيفه % جيش الحمام إذا التقى الجمعان % % PageV01P1807 21(@)(@@) % من آل عدنان الذين كفاهم % % إن ابن موسى من بني عدنان % % 22(@)(@@) % النازلين ، إذا تقارعت القنا % % والبيض خارجة عن الأجفان % % 23(@)(@@) % يحشون أحشاء الوفاض إذا هم % % تزموا بفضل ذوائب الشجعان % 24(@)(@@) % لبسوا العمائم مذ رأوا أسيافهم % % أبدا تذل معاقد التيجان % % 25(@)(@@) % وإذا الحسين دعاهم بجيادهم % % حشدت إليه مصرة الآذان % 26(@)(@@) % متواترات في الطلوع مغيرة % % لفظ السواغب من نوى قران % 27(@)(@@) % ليث به سفك الطعان دم القنا % % بدماء أهل الشرك والطغيان % 28(@)(@@) % لما فزعن من التحطم في الطلى % % جعل القلوب تمائم الخرصان % % 29(@)(@@) % لولاه ما طبعت ظبا لتقارع % % أبدا ولا قطعت قنا لطعان % % 30(@)(@@) % لله يومك في غويث إنه % يوم به يشجى بنو غيلان % PageV01P1808 31(@)(@@) % بالحصن ، إذ دعت القنا خرصانها % % وتحصنت في أنفس الفرسان % 32(@)(@@) % غاضت مياه وجوههم خوف الردى % % فكأنها فاضت إلى الأجفان % % 33(@)(@@) % صبحتهم بيد تطوح بالظبى % % ويد تدق عوالي المران % % 34(@)(@@) % لدنا تهز طعينها فتخاله % % في الطعن وثابا إلى الأقران % 35(@)(@@) % قطعت أنفاس الحمام بجريها % % حتى كبا في الهام والأبدان % 36(@)(@@) % فكأنما الأرماح ضلت في الوغى % % حتى انثنت تستاف كل جنان % % 37(@)(@@) % والخيل تعثر بين أطراف القنا % % مصبوغة بدم القلوب الآني % % 38(@)(@@) % ستر السهام فروجها فكأنما % % درعت إليك مدارع الظلمان % 39(@)(@@) % لو 
ms511	 أن أنفاس الرياح تصاعدت % في نقعها طارت مع العقبان % 40(@)(@@) % خضت الظلام إليهم بسنابك % % خاضت قلوب مواقد النيران % % PageV01P1809 41(@)(@@) % وفريت وفرة ليلهم بصوارم % وصلت عرى الإصباح باللمعان % 42(@)(@@) % حسر الدجى فنصبت أعناق العدا % % قبلا لنيل رواكع الشريان % 43(@)(@@) % فتركتهم صرعى بكل مفازة % % وكأنما صعقوا على الأذقان % 44(@)(@@) % تخفى النسور بزفها أجسادهم % % عن ناظر الريبال والسرحان % % 45(@)(@@) % نبثت مناسرها الجراح ، كأنها % % بالنبث تسبر وقع كل سنان % % 46(@)(@@) % حتى رجعت بفتية قصفوا القنا % % ورموا بكل حنية مرنان % 47(@)(@@) % لو أمكنوا وصلوا بكل مثقف % يسم الطلى في الطعن كل بنان % % 48(@)(@@) % أسد برى الإسئاد نحض جيادهم % % بالكر والتضراب والتطعان % 49(@)(@@) % لو عقدت بعضا ببعض في السرى % % كانت له بدلا من الأرسان % % 50(@)(@@) % يهني بني عدنان وقعتك التي % % جذبت بضبع الدين والإيمان % % PageV01P1810 51(@)(@@) % لو لم تحل طلى الأعادي عقدوا % % بعرى القلوب سبائب الأحزان % % 52(@)(@@) % قدها فغرتها من الكلم الجنى % % وحجولها من صنعة ومعان % % 53(@)(@@) % هي نطفة رقرقتها من خاطري % % بيضاء تنقع غلة الظمآن % PageV01P1811 البحر : كامل تام 1(@)(@@) % لون الشبيبة أنصل الألوان % % والشيب جل عمائم الفتيان % 2(@)(@@) % نبت بأعلى الرأس يرعاه الردى % % رعي المطي منابت الغيطان % 3(@)(@@) % الشيب أحسن غير أن غضارة % % للمرء في ورق الشباب الآني % % 4(@)(@@) % وكذا بياض الناظرين وإنما % % بسوادها تتأمل العينان % 5(@)(@@) % لهفي على زمن مضى وكأنني % % من بعده كل على الأزمان % 6(@)(@@) % أفنيته طاغي العرام كأنما % % في أم رأسي نخوة السكران % 7(@)(@@) % يرجو الفتى خلس البقاء وإنما % % جارا حياة العمر مفترقان % 8(@)(@@) % متعرض إما للون حائل % % بين الذوائب ، أو لعمر فان % 9(@)(@@) % مالي وما للدهر قلقل صرفه % % عزمي وقطع بينه أقراني % % 10(@)(@@) % ورمى تشخصي حر كل مفازة % % لا يستقل بها مطي جبان % % PageV01P1812 11(@)(@@) % متغربا لا أستجير بمنزل % فإذا نزلت فعقلة الضيفان % % 12(@)(@@) % سيفي رفيقي في البلاد وهمتي % % متعللي وجوانحي خلاني % % 13(@)(@@) % يشكو الحبيب إلي شدة شوقه % % وأنا المشوق وما يبين جناني % % 14(@)(@@) % وإذا هممت بمن أحب أمالني % % حصر يعوق وعفة تنهاني % % 15(@)(@@) % لله ما أغضت عليه جوانحي % % والشوق تحت حجاب 
ms512	 قلبي عان % 16(@)(@@) % ما مر برق في فروج غمامة % إلا وأعدى القلب بالخفقان % 17(@)(@@) % وإذا تحركت الرياح تحركت % % بين الضلوع غوامض الأشجان % % 18(@)(@@) % أجممت لحظي عفة وسجية % إن لا أجم البيض في الأجفان % 19(@)(@@) % غيران دون العرض لا أسخو به % % والعرض خير عقيلة الإنسان % 20(@)(@@) % وأذود عن سمعي الملام كأنه % % عضو أخاف عليه حد سنان % % PageV01P1813 21(@)(@@) % لي يقظة الذئب الخبيث ، فإن جرى % % سفه ، فعندي نومة الظربان % 22(@)(@@) % حدث على الأحباب لا أشكو الذي % % ويسومني لقيا ذوي الشنآن % 23(@)(@@) % أشكو النوائب ، ثم أشكر فعلها % % لعظيم ما ألقى من الخلان % 24(@)(@@) % وإذا أمنت من الزمان فلا تكن % % إلا على حذر من الإخوان % 25(@)(@@) % كم من أخ تدعوه عند ملمة % فيكون أعظم من يد الحدثان % 26(@)(@@) % لولا يقين القلب أنك حبسه % % لعصى وهم عليك بالعدوان % % 27(@)(@@) % كم عممتني بالظلام مطية % بعد اعوجاج عمائم الركبان % 28(@)(@@) % والليل أعمى دون كل ثنية % % والدهر غير مغمض الأجفان % % 29(@)(@@) % وكأن أنجمه أسنة فيلق % % طلعت بها صم الكعوب دواني % % 30(@)(@@) % بطل يعمم بالحسام من الأذى % % إن السيوف عمائم الشجعان % PageV01P1814 31(@)(@@) % % بعض التوكل في الأمور توان % 32(@)(@@) % ميت يهون على الفوارس فقده % % من لا يرق عوالي المران % % 33(@)(@@) % ما ضاق هما كالشجاع ولا خلا % % بمسرة ، كالعاجز المتواني % % 34(@)(@@) % يا راكب الهوجاء تغترف الخطى % % طلق الظليم ، وغاية السرحان % 35(@)(@@) % أبلغ أمير المؤمنين رسالة % % روعاء نافرة عن الأقران % % 36(@)(@@) % أجزلت عارفتي وعودت العطا % % عقبي ، ووليت اليراع بناني % % 37(@)(@@) % ما ضرني أن لو بعدت عن الغنى % % أبدا وأني من لقائك دان % 38(@)(@@) % ويسرني أن لا يراني دائل % ومعظم يوما وأنت تراني % % 39(@)(@@) % ذكراك آخر ما يفارق خاطري % % ونداك أول وارد يلقاني % % 40(@)(@@) % وإذا حططت عليك أقسمت المنى % % أن لا أميل ذوائب الكيران % % PageV01P1815 41(@)(@@) % وتركت أيدي العيس غير مروعة % % من صفصف متعرض ورعان % 42(@)(@@) % وإذا الفتى بلغ المنى من دهره % عاف المسير ولذ بالأوطان % 43(@)(@@) % أنت المعين على مآرب جمة % وجماح حادثة وريب زمان % 44(@)(@@) % والمستجار إذا تصافحت القنا % % بصدورها والتفت الفئتان % % 45 
ms513	(@)(@@) % متيقظ لا القلب يفتر همه % يوما ولا الجفنان ينقعدان % % 46(@)(@@) % وكأنما صرف الزمان أعاره % عيني قطامي برأس قنان % 47(@)(@@) % لا يصحب الأيام إلا راغبا % في وصلتي ، أو سائلا عن شاني % % 48(@)(@@) % في كل يوم يستثير عجاجة % % هوجاء راغبة على القيعان % 49(@)(@@) % في فيلق تعمى الغزالة دونه % % وتكوس خابطة بغير طعان % % 50(@)(@@) % متضايق غصت به فيح الفلا % % ضيق القلائد في رقاب غوان % PageV01P1816 51(@)(@@) % وفوارسا يتسمعون إلى العلى % % نغمات كل حنية مرنان % 52(@)(@@) % مشقوا بأطراف القنا قمم العدا % % إن الرماح مخاصر الفرسان % % 53(@)(@@) % وإذا الغبار نهى العيون تدافعوا % % في الروع واتكلوا على الآذان % % 54(@)(@@) % أسد كأن على سنابك خيلهم % % يوم اللقاء مسفة العقبان % 55(@)(@@) % ترعى الجماجم والجميم إزاءها % % ودم الطلى بدلا من الغدران % 56(@)(@@) % لو شئت شتت الثريا شملها % % جزعا هم النسر بالطيران % % 57(@)(@@) % ليس الحمائم بالبطاح ، وحجرها % % بأعز مما نلته بأمان % % 58(@)(@@) % عجبا لنار جاورتك خديعة % % في أي ناحية وأي مغاني % % 59(@)(@@) % ما كان ذا إلا تخمط غارة % بدلت من هبواتها بدخان % 60(@)(@@) % ما ضر ليث الغاب نار أضرمت % في غابه ، ونجا بغير هوان % PageV01P1817 61(@)(@@) % ومتى تهضم ضيغم ، وتولعت % بحيا الغيوث أنامل النيران % 62(@)(@@) % % عمر الزمان ومن رماك رماني % % 63(@)(@@) % ماذا ، فليس بضائري أن لم أكن % لك جار بيت أو رضيع لبان % % 64(@)(@@) % ولأنت حسرة ذي الخمول ومادرى % % أن الثريا حسرة الدبران % % 65(@)(@@) % أنا حرب ضدك فارضني حربا له % % وارض السنان مصمما لطعان % 66(@)(@@) % وكفاك شكري إن برك ظاهر % % عندي وما يخفى على الأعيان % 67(@)(@@) % وإذا سكت ، فإن أنطق من فمي % % عني فم المعروف والإحسان % 68(@)(@@) % فاكفف سماحك واثن من غلوائه % % إن الغنى في بعض ما أعطاني % % 69(@)(@@) % فليشكرنك ما شكرتك غالب % وذوائب الآباء من عدنان % 70(@)(@@) % ما مات من كثر الثناء وراءه % إن المذمم ميت الحيوان % PageV01P1818 71(@)(@@) % هذا الإمام يذودني عن وجهه % % 72(@)(@@) % متكلفا اقتات بشر معاشر % % لهم إلي تشازر الغيران % 73(@)(@@) % تتناتج الأحقاد بين ضلوعهم % % ويزملون أجنة الأضغان % 74(@)(@@) % وأنا الفقير على غزارة جوده % % فإذا أراد بي الغنى أدناني 
ms514	 % % 75(@)(@@) % لم آل جهدا في الثناء وإنما % % غطى بعرض نداه طول لساني % % 76(@)(@@) % طمع المعادي أن يقربه ، ومن % صافى عدوا لي ، فقد عاداني % % 77(@)(@@) % طلب العلى وأبوه غير مهذب % % بين الورى والأم غير حصان % % 78(@)(@@) % ولأنت أولى إن ترب صنائعا % كثرت بهن مطامع وأماني % % 79(@)(@@) % وإذا بقيت فقد شفيت من العدا % % قلبي ، وأعطيت الأمان زماني % % PageV01P1819 البحر : كامل تام 1(@)(@@) % ونمى إلي من العجائب أنه % % لعبت بعقلك حيلة الخوان % 2(@)(@@) % وتملكتك خديعة من قولة % % غرارة الأقسام والأيمان % % 3(@)(@@) % حقا سمعت ، ورب عيني ناظر % يقظ تقوم مقامها الأذنان % 4(@)(@@) % أين الذي أضمرته من بغضه % وعقدته بالسر والإعلان % 5(@)(@@) % أم أين ذاك الرأي في إبعاده % حنقا وأين حمية الغضبان % 6(@)(@@) % سبحان خالق كل شيء معجب % % ما فيكم من كثرة الألوان % 7(@)(@@) % يوم لذا ، وغد لذاك ، وهذه % شيم مقطعة قوى الأقران % 8(@)(@@) % فالآن منك اليأس ينقع غلتي % % واليأس يقطع غلة الظمآن % 9(@)(@@) % فاذهب كما ذهب الغمام رجوته % % فطوى البروق ، وضن بالهتان % 10(@)(@@) % أو بعد أن أدمى مديحك خاطري % % بصقال لفظ ، أو طلاب معاني % % PageV01P1820 11(@)(@@) % لا بارك الرحمن في مال به % يعدى البعيد على القريب الداني % % 12(@)(@@) % لي مثل ملكك لو أطعت تقنعي % % وذوو العمائم من ذوي التيجان % % 13(@)(@@) % ولعل حالي إن يصير إلى على % فالدوح منبتها من القضبان % 14(@)(@@) % فاحذر عواقب ما جنيت فربما % % رمت الجناية عرض قلب الجاني % % 15(@)(@@) % أعطيتك الرأي الصريح ، وغيره % تنساب رغوته بغير بيان % % 16(@)(@@) % وعرضت نصحي ، والقبول إجازة % فإذا أبيت لويت عنك عناني % % 17(@)(@@) % ولقد يطول عليك أن أصغي إلى % % ذكراك أو يثني عليك لساني % % PageV01P1821 البحر : طويل 1(@)(@@) % أيا جبلي نجد أبينا سقيتما % % متى زالت الأظعان يا جبلان % % 2(@)(@@) % أناديكما شوقا وأعلم أنه % % وإن طال رجع القول ، لا تعيان % 3(@)(@@) % أقول ، وقد مد الظلام رواقه % % وألقى على هام الربى بجران % 4(@)(@@) % نشدتكما أن تضمراني ساعة % لعلي أرى النار التي تريان % 5(@)(@@) % وألقى ، على بعد من الدار ، نفحة % تذم على عيني من الهملان % 6(@)(@@) % قفا صاحبي ايوم أسأل ساعة % % ولا 
ms515	 ترجعا سمعي بغير بيان % % 7(@)(@@) % هل الربع بعد الظاعنين كعهده % % وهل راجع فيه علي زماني % % 8(@)(@@) % وهل مس ذاك الشيح عرنين ناشق % % وهل ذاق ماء باللوى شفتان % 9(@)(@@) % لقد غدر الأظعان يوم سويقة % ويدمى لذكر الغادرين بناني % % 10(@)(@@) % ولا عجب ، قلبي ، كما هن ، غادر % على أن أضلاعي عليه حواني % % PageV01P1822 11(@)(@@) % لك الله هل بعد الصدود تعطف % % وهل بعد ريعان البعاد تداني % % 12(@)(@@) % وما غرضي أني أسومك خطة % % كفاني قليل من رضاك كفاني % % 13(@)(@@) % وعاذلة قرط لأذني عذلها % % تلوم ، وما لي بالسلو يدان % 14(@)(@@) % أعاذلتي لو أن قلبك كان لي % % سلوت ولكن غير قلبك عاني % % 15(@)(@@) % ألا ليت لي من ماء يبرين شربة % ألذ لقلبي من غيرض لبان % % 16(@)(@@) % أداوي بها قلبا على النأي لم تدع % % به فتكات الشوق غير حنان % 17(@)(@@) % ولولا الجوى لم أبغ إلا مدامة % % بطعن القنا إبريقها الودجان % % 18(@)(@@) % إذا سكر العسال من قطراتها % % سقيت حمياها أغر يماني % % 19(@)(@@) % ولي أمل لا بد أحمل عبئه % على الجرد من خيفانة وحصان % 20(@)(@@) % وكل رعود الشفرتين ، كأنه % سنى البرق أما جد في اللمعان % PageV01P1823 21(@)(@@) % وأسمر هزهاز الكعوب ، كأنه % قرا الذئب مجبول على العسلان % 22(@)(@@) % فإن أنا لم أركب عظيما فلا مضى % % حسامي ولا روى الطعان سناني % % PageV01P1824 البحر : مجزوء الكامل 1(@)(@@) % الآن أعربت الظنون % % وعلا على الشك اليقين % % 2(@)(@@) % وارتاحت الآمال في % % أطرافها جذل ولين % 3(@)(@@) % في غمة كالليل شا % % ب لها الذوائب والقرون % 4(@)(@@) % واليوم بان لناظري % % ماأثمرت تلك الغصون % % 5(@)(@@) % وتمطت العشراء نا % % هضة وقد علم الجنين % % 6(@)(@@) % ألآن لما امتد بي % % طوبى وأصحب لي القرين % 7(@)(@@) % وعضضت من نابي على % % جذم ونجذني الشؤون % 8(@)(@@) % أغضي على خدع النوا % % طتها جبان ، أو ظنين % 9(@)(@@) % وعلى أمير المؤمني % % ن لموئلي جبل حصين % 10(@)(@@) % إنتاشني شلو النوا % % زل والنوائب لي شجون % % PageV01P1825 11(@)(@@) % وسطا بأيامي فقد % % جعلت عرائكها تلين % 12(@)(@@) % وأضاء لي زمني ، وأ % % يام الفتى بيض وجون % 13(@)(@@) % ملكا بني العباس ، فالرا % % مقامكم غبين % % 15(@)(@@) % ما فيكم إلا الد % د 
ms516	 على عظائمها مرون % 16(@)(@@) % حتى يزول فحولها % % منكم وقد دانوا ودينوا % % 17(@)(@@) % عكفوا على العلياء ما % % فيهم على مجد ضنين % % 18(@)(@@) % ينفون شائبها كما % % عكفت على البيض القيون % % 19(@)(@@) % لهم الجياد مغذة % ينتابها الحرب الزبون % % 20(@)(@@) % وقنيصها لهم قرى % وظهورها لهم حصون % 21(@)(@@) % معتادة شرب الدما % % ء ، وعندها الماء المعين % PageV01P1826 22(@)(@@) % غضبي إذا لم يلق أعي % % نها ضريب أو طعين % % 23(@)(@@) % يا من له الرأي الزني % % ق ومن له الحلم الرزين % % 24(@)(@@) % ومروح الإبل الطلا % % ح رمت بهن نوى شطون % 25(@)(@@) % من بعد ما خشعت غوا % % ربها وقد قلق الوضين % % 26(@)(@@) % لك ذروة البيت المع % والأباطح والحجون % % 27(@)(@@) % أترى أمين الله إلا % لا من له البلد الأمين % 28(@)(@@) % لله درك حيث لا % % تسطو الشمال ولا اليمين % 29(@)(@@) % والأمر أمرك لا فم % يوحي ولا قول يبين % % 30(@)(@@) % لما رأيتك في مقا % % م يستطار به الركين % % 31(@)(@@) % واليوم أبلج تستضي % % ء له ظهور أو بطون % % PageV01P1827 32(@)(@@) % ورأيت ليث الغاب معتر % % ضا له الدنيا عرين % % 33(@)(@@) % أقدمت إقدام الذي % % يدنو وشافعه مكين % % 34(@)(@@) % فلذاك ما ارتعد الجنا % % ن حيا ولا عرق الجبين % 35(@)(@@) % وسمت بفضلك غرة % تغضي لهيبتها الجفون % % 36(@)(@@) % وامتد من نور النب % ي عليك عنوان مبين % 37(@)(@@) % وجمال وجهك لي بنيل % % جميع ما أرجو ضمين % % 38(@)(@@) % فأفيضت الخلع السوا % % د علي ترشقها العيون % 39(@)(@@) % شرف خصصت به وقد % درجت بغصته القرون % 40(@)(@@) % وخرجت أسحبها ولي % % فوق العلى والنجم دون % % 41(@)(@@) % جذلا ، وللحساد من % أسف زفير أو أنين % % PageV01P1828 42(@)(@@) % وحملت من نعماك ما % % لا تحمل الأجد الأمون % % 43(@)(@@) % وكففتني عن معشر % خطط المنى فيهم حزون % % 44(@)(@@) % من كل جهم الصفح % % ن كأن وجنته وجين % 45(@)(@@) % هناك عيدك ، سعده % ما كان منه وما يكون % % 46(@)(@@) % والعيد أن تبقى لك العلي % % اء والحسب المصون % % 47(@)(@@) % عز بلا كدر من الدنيا % % يا ، وبعض العز هون % 48(@)(@@) % وأرى العلى جداء ، إ % % أنها لكم لبون % % 49(@)(@@) % حمدا لما تولي فإن ال % % د للنعماء دين % 50(@)(@@) % وبقيت طول 
ms517	 الدهر لا % % يجتاحك الأجل الخؤون % % 51(@)(@@) % وعلي منك ضافيا % % وعلى أعاديك المنون % PageV01P1829 البحر : طويل 1(@)(@@) % أ لا مخبر ، فيما يقول ، جلية % يزيل بها الشك المريب يقين % % 2(@)(@@) % أسائله عن غائب كيف حاله % ومن نزل الغبراء كيف يكون % 3(@)(@@) % وما كنت أخشى من زماني أنني % % أرق على ضرائه وألين % % 4(@)(@@) % إلى أن رماني بالتي لا شوى لها % % فأعقب من بعد الرنين أنين % 5(@)(@@) % معيني على الأيام فجعنني به % فما لي على أحداثهن معين % 6(@)(@@) % غلبن على علقي النفيس فحزنه % % وفارقني علق علي ثمين % 7(@)(@@) % سمحت به إذ لم أجد عنه مدفعا % وإني على عذري به لضنين % 8(@)(@@) % وإن أحق المجهشين لعبرة % % ووجد قرين بان عنه قرين % % 9(@)(@@) % وما تنفع المرء الشمال وحيدة % إذا فارقتها بالمنون يمين % 10(@)(@@) % تجرم عام لم أنل منك نظرة % % وحان ولم يقدر لقاؤك حين % % PageV01P1830 11(@)(@@) % وكيف وقد قطعن منك علائقي % % وسدت شعوب بيننا ومنون % 12(@)(@@) % أضب جديد الأرض دونك والتقت % عليك رجام كالغياطل جون % 13(@)(@@) % تجاور فيها هامدين تعطلوا % % ومن قبل دانوا في الزمان ودينوا % % 14(@)(@@) % مقيمين منها في بطون ضرائح % % حوامل لا يبدو لهن جنين % 15(@)(@@) % أمر بقبر قد طواك صعيده % % فأبلس حتى ما أكاد أبين % 16(@)(@@) % وتنفض بالوجد الأليم أضالع % وترفض بالدمع الغزيز شؤون % 17(@)(@@) % فالأيكن عقر فقد عقرت له % % خدود ، بأسراب الدموع عيون % 18(@)(@@) % ولا عجب أن تمطر العين فوقه % فإن سواد العين فيه دفين % PageV01P1831 البحر : منسرح 1(@)(@@) % توقعي أن يقال قد ظعنا % % ما أنت لي منزلا ولا سكنا % % 2(@)(@@) % يا دار قل الصديق فيك ، فما % % أحس ودا ، ولا أرى سكنا % % 3(@)(@@) % مالي مثل المذود عن أربي % % ولي عرام يجرني الرسنا % % 4(@)(@@) % ألين عن ذلة ، ومثلي من % ولى المقادير جانبا خشنا % % 5(@)(@@) % معطلا ، بعد طول ملبثه % منازلا قد عمرتها زمنا % % 6(@)(@@) % تلعب بي النائبات واغلة % كما تهز الزعازع الغصنا % % 7(@)(@@) % أيقظن مني مهندا ذكرا % إلى المعالي وسائقا أرنا % % 8(@)(@@) % كيف يهاب الحمام منصلت % % مذ خاف غدر الزمان ما أمنا % % 9(@)(@@) % لم يلبث الثوب من 
ms518	 توقعه % % الأمر إلا وظنه كفنا % % 10(@)(@@) % أعطشه الدهر من مطالبه % % فراح يستمطر القنا اللدنا % % PageV01P1832 11(@)(@@) % لي مهجة لا أرى لها عوضا % غير بلوغ العلى ولا ثمنا % % 12(@)(@@) % وكيف ترجو البقاء نفس فتى % % ودأبها أن تضعضع البدنا % % 13(@)(@@) % فيما مقامي على معطلة % رنق لي ماؤها وقد أجنا % % 14(@)(@@) % أكر طرفي فلا أرى أحدا % إلا مغيظا علي مضطغنا % % 15(@)(@@) % ينبض لي من لسانه أبدا % نصال ذم تمزق الجننا % % 16(@)(@@) % وكل مستنفر ترائبه % % تحمل ضبا علي قد كمنا % % 17(@)(@@) % إن مر بي لم أعج به بصرا % أو قال لي لم أمل له أذنا % % 18(@)(@@) % من معشر أظهروا الشجاعة في % % الشجاعة في البخ % % 19(@)(@@) % ل ، وعند المكارم الجبنا % % قد شغلوا بالمعايب الفطنا % % 20(@)(@@) % يستحقبون الملام إن ركبوا % % ويحملون الظنون والظننا % % PageV01P1833 21(@)(@@) % نحن أسود الوغى إذا قصفت الط % % ن قنا الخط في جوانبنا % % 22(@)(@@) % ملتف أعياصنا إلى مضر % أمر عيداننا لعاجمنا % % 23(@)(@@) % نجر ما شئت من لسان فتى % % إن هدرت ساعة شقاشقنا % % 24(@)(@@) % إن أبانا الذي سمعت به % % أسس في هضبة العلى وبنى % % 25(@)(@@) % ما ضرنا أننا بلا جدة % والبيت والركن والمقام لنا % % 26(@)(@@) % وهمة في العلاء لازمة % % تلزم صم الرماح أيدينا % % 27(@)(@@) % طلابنا المجد من ذوائبه % روحنا بعد أن أضربنا % % 28(@)(@@) % نأخذ من جمة العلى أبدا % ما أخذ الضرب من جماجمنا % % 29(@)(@@) % سوف ترى أن نيل آخرنا % % من العلى فوق نيل أولنا % % 30(@)(@@) % وأن ما بز من مقادمنا % % يخلفه الله في عقائلنا % % PageV01P1834 31(@)(@@) % ذلك ورد قذى لسابقنا % % والآن يجلى القذى للاحقنا % % 32(@)(@@) % دين على الله لا نماطله ال % % الشكر عليه ولا يماطلنا % % 33(@)(@@) % لأوقرن الركاب سائرة % عزما يكد الأبدان والبدنا % % 34(@)(@@) % حتى تهاوى من اللغوب وتستن % % تنجد بعد المناسم الثفنا % % 35(@)(@@) % حزا إلى المجد من أزمتها % % ليس كحز الأعاجز الظعنا % % 36(@)(@@) % لأبلغ العز أو يقال فتى % % جنت عليه يد الردى وجنى % % PageV01P1835 البحر : رجز تام 1(@)(@@) % ستعلمون ما يكون مني % % إن مد من ضبعي طول سني % % 2(@)(@@) % أأدع الدنيا ولم تدعني % % يلعب بي عناؤها المعني 
ms519	 % % 3(@)(@@) % ناطحة بالجم هام القرن % نطاح روق الجازي الأغن % 4(@)(@@) % وسعت أيامي ، ولم تسعني % % أفضل عنها وتضيق عني % % 5(@)(@@) % لم أنا مثل القاطن المبن % أسحب بردي ضرع وأفن % 6(@)(@@) % ولي مضاء قط لم يخني % % ضمير قلبي وضمير جفني % % 7(@)(@@) % أحصل من عزمي على التمني % % ليتني أفعل أو لواني % % 8(@)(@@) % راض بما يضوي الفتى ويضني % % أسس آبائي وسوف أبني % % 9(@)(@@) % قد عز أصلي ، ويعز غصني % % غنيت بالمجد ولم أستغن % 10(@)(@@) % إن الغنى مجلبة للضن % % وللقعود والرضا بالوهن % PageV01P1836 11(@)(@@) % الفقر ينئي والثراء يدني % % والحرص يشقي ، والقنوع يغني % % 12(@)(@@) % إن كنت غير قارح ، فإني % % أبذ جري القارح المسن % 13(@)(@@) % جننت بأسا ، والشجاع جني % % أثار طعن الدهر في مجني % % 14(@)(@@) % يشهد لي أن الزمان قرني % % سوف ترى غبارها كالدجن % 15(@)(@@) % قساطلا مثل غوادي المزن % % تجري بضرب صادق وطعن % 16(@)(@@) % جري عزالي المطر المستن % إن غبت يوما عنك فاطلبني % % 17(@)(@@) % بين المواضي والقنا تجدني % % أمام جيش كجنوب الرعن % 18(@)(@@) % جون الذرى أقود مرجحن % انفض عنه نقعه بردني % % 19(@)(@@) % لتعرفني ، ولتعرفني % % أيام أقني بالقنا ، وأغني % % 20(@)(@@) % أقر عين الفاقد المرن % عساي أنفي الضيم ، أو لعني % % PageV01P1837 21(@)(@@) % كم صبر خافي الشخص مستجن % منطمر من الأذى في سجن % 22(@)(@@) % مرتهن بهمة تعني % % يا ليتها بنهضة فدتني % % 23(@)(@@) % من قبل أن يغلق يوما رهني % % متى تراني والجواد خدني % % 24(@)(@@) % والنصل عيني والسنان أذني % % وأمي الدرع ولم تلدني % % 25(@)(@@) % أجر فضل ذيلها الرفن % ما احتبس الرزق فساء ظني % % 26(@)(@@) % ولا قرعت من قنوط سني % % يا أيها المغرور لا تهجني % % 27(@)(@@) % وعذ بإغضائي واستعذني % % واحذر عداء قاطع في ضمني % % 28(@)(@@) % ينطق عني بلسان ضغني % % نبهت يقظان قليل الأمن % 29(@)(@@) % مخرق الثوب بطعن اللدن % يا دهر سيفي معقلي وحصني % % 30(@)(@@) % والخوف يغري طلبي فخفني % % يا ليت مقدورك لم يؤمني % % PageV01P1838 31(@)(@@) % جنيت من قبل وسوف أجني % % أثني يدي والعزم أن أثني % % PageV01P1839 البحر : وافر تام 1(@)(@@) % حقيق أن تكاثرك التهاني % % بأيمن أول وأعز ثاني % % 2(@)(@@) % أرى بدرا أضاء بعقب شمس % مباركة الطلوع على القران 
ms520	 % 3(@)(@@) % وقال الناس من عجب وعجب : % تلاقى في السماء النيران % 4(@)(@@) % هو الذكر المرشح للمعالي % % وللبيض القواضب واللدان % 5(@)(@@) % ستنظره إذا اتسعت سنوه % % وأخرجه زمان عن زمان % % 6(@)(@@) % ربيبا للصوارم والعوالي % % وتربا للمفاوز والرعان % 7(@)(@@) % طليق الكف في يوم العطايا % % جري الرمح في يوم الطعان % % 8(@)(@@) % ربيط الجأش طلاع الثنايا % % إلى الغايات رواغ العنان % 9(@)(@@) % مقارعة الذوابل في الهوادي % % أخف عليه من نغم القيان % 10(@)(@@) % وأحسن عنده من كل ثغر % مضيء ، رونق العضب اليماني % % PageV01P1840 11(@)(@@) % تراه أين خيم في الليالي % % عزيز الجار مورود الجفان % % 12(@)(@@) % ينال المجد من عنق المذاكي % % ويجني العز من طرف السنان % % 13(@)(@@) % وليس جواده في النقع إلا % طليعة كل يوم أرونان % % 14(@)(@@) % يربى بين أحشاء المعالي % % ويودع بين أجفان الأماني % % 15(@)(@@) % وعاد حماك من ولع الغوادي % % عميم النبت مغمور المغاني % % 16(@)(@@) % يشيعني بوصفك كل نطق % ويعرفني بمدحك من رآني % % 17(@)(@@) % وليس الوصف إلا بالتناهي % % وليس القول إلا بالبيان % % PageV01P1841 البحر : طويل 1(@)(@@) % سقاها ، وإن لم يرو قلبي بيانها % % وهل تنطق العجماء أقوى معانها % % 2(@)(@@) % ضمان على قلبي الوفاء لأهلها % % وثم ظباء لا يصح ضمانها % % 3(@)(@@) % عرضن بما روى الغليل اعتراضها % % ولا قطع الجمع اللجوج اعتنانها % % 4(@)(@@) % وهل نافع أن يملأ العين حسنها % % إذاهي لم تحسن إلينا حسانها % % 5(@)(@@) % تذكرت أياما بذي الأثل بعدما % % تقضى أواني في الصبا وأوانها % % 6(@)(@@) % يطيب أنفاس الرياح ترابها % % ويخضل من دمع الغمائم بانها % % 7(@)(@@) % ولما عطفت الناظرين بلفتة % % إلى الدار خلى عبرة العين شانها % % 8(@)(@@) % ليالي تثنيني عواطف صبوتي % % إلى بدويات تثنى لدانها % % 9(@)(@@) % ولا لذة إلا الحديث كأنه % % لآل على جيداء واه جمانها % % 10(@)(@@) % عفاف كما شاء الإله يسرني % % وإن سيء منه بكرها وعرانها % % PageV01P1842 11(@)(@@) % أألآن لما اعتم بالشيب مفرقي % % وجلى الدجى عن لمتي لمعانها % % 12(@)(@@) % ونجذني صرف الزمان ووقرت % على الحلم نفسي وانقضى نزوانها % % 13(@)(@@) % تروم العدا أن تستلان حميتي % % وقبلهم أعدى علي حرانها % % 14(@)(@@) % أنا الرجل الألوى الذي تعرفونه % إذا نوب الأيام ألقي جرانها % % 15(@)(@@) % إذا كان غيري من 