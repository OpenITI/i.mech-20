ms786	 عمرت %~% محتاج به پاسبان مبینام(@)(@@) 172 بر ملکت مصر و قاهره هم %~% جز قهر تو قهرمان مبینام(@)(@@) 173 زین دزد صفیر زن که چرخ است %~% نقبیت به باغ جان مبینام(@)(@@) 174 بی‌مدحت تو به باغ دانش %~% یک مرغ صفیرخوان مبینام(@)(@@) 175 صدر تو که کعبه معالی است %~% جز قبله انس و جان مبینام(@)(@@) 176 تا دیده خصم را بدوزی %~% جز تیز تو در کمان مبینام PageV1P1352(@)(@@)(@@)(@@) || [genre: Tj](@)(@@) 1 آن نه روی است آنکه آشوب جهان است آنچنان %~% و آن نه زلف است آنکه دست آویز جان است آنچنان(@)(@@) 2 زلف او زنجیر گردون است و بیدادی کند %~% گرچه او از بهر انصاف جهان است آنچنان(@)(@@) 3 راست خواهی با من از هستی نشانی مانده نیست %~% در غم آن لب که هست و بی‌نشان است آنچنان(@)(@@) 4 گرنه رازم آفتاب است از چه پیدا شد چنین %~% ورنه وصلش کیمیا شد چون نهان است آنچنان(@)(@@) 5 جان بر او پاشم که تا جان با من است او بی‌من است %~% و این چنین بهتر زیم کالحق زیان است آنچنان(@)(@@) 6 گفتمش در صدر وصلم جای کن گفت ای سلیم %~% جسته‌ام جائی سزایت آستان است آنچنان(@)(@@) 7 بر در من بگذرد بیند مرا در خاک و خون %~% با رقیب از طنز گوید کاین فلان است آنچنان(@)(@@) 8 او کند دعوی که خون و مال خاقانی مراست %~% من کنم اقرار و گویم کانچنان است آنچنان(@)(@@) 9 عشق او را مرد صاحب درد باید شک مکن %~% کاندر این آخر زمان صدر زمان است آنچنان(@)(@@) 10 یارب اندر چشم خونریزش چه خواب است آن همه %~% در سر زلف دلاویزش چه تاب است آن همه(@)(@@) 11 در دو لعلش آب و اندر جزع نه آخر بگوی %~% کاین چه بی‌آبی است چندین و آن چه آب است آن همه(@)(@@) 12 خون خلقی ریخت وانگه سرخیی بر دامنش %~% آن رنگ پروز است آن خون ناب است آن همه(@)(@@) 13 چشم 
ms787	 مستش را کباب است آرزو زین روی را %~% قصد دلها می‌کند یعنی کباب است آن همه(@)(@@) 14 شحنه وصلش خراج از عالم جان برگرفت %~% جای دیگر شد که می‌داند خراب است آن همه(@)(@@) 15 گه بسوزد گه بسازد الغیاث ای قوم از آنک %~% خوی مردم نیست خوی آفتاب است آن همه(@)(@@) 16 تشنه وصلم مرا آن وعده‌های کژ که داد %~% کی کند سیری که می‌دانم سراب است آن همه(@)(@@) 17 کاشکی رنجه شدی باری بدیدی کز غمش %~% در دل تاریک خاقانی چه تاب است آن همه(@)(@@) 18 از حیاتش گر فروغی یا نسیمی مانده هست %~% از ثنای صاحب مالک رقاب است آن همه(@)(@@) 19 سرکشان از عشق تو در خاک و خون دامن کشند %~% من کیم در کوی عشقت کاین رقم بر من کشند(@)(@@) 20 گر به جان فرمان دهی فرمانت را گردن نهم %~% پیش تو گر تو توی گردن کشان گردن کشند(@)(@@) 21 غمزگانت قصد کین دارند وز من در غمت %~% سایه‌ای مانده است مگر این کین ز پیراهن کشند(@)(@@) 22 آه من چندان فروزان شد که کوران نیم شب %~% از فروغ سوز آهم رشته در سوزن کشند(@)(@@) 23 دیده من شد سپید از هجر و دل تاریک ماند %~% خانه‌ها تاری شود چون پرده بر روزن کشند(@)(@@) 24 با خسان درساختی تا بر در و در بزم تو %~% من غم هجران کشم و ایشان می روشن کشند(@)(@@) 25 نیکویی کن رسم بدعهدان رها کن کز جفا %~% درد زی عاشق دهند و صاف با دشمن کشند(@)(@@) 26 هر زمان در کوی تو خاقانی آسا عالمی %~% آستین بر جان فشانند و کفن در تن کشند(@)(@@) 27 وز پی آن تا ز دیو آزشان باشد امان %~% خط افسون مدیح صدر پیرامن کشند(@)(@@) 28 دیده خون افشان و لب آتش‌فشان است از غمت %~% والحق ار انصاف خواهی جان آن است از غمت(@)(@@) 29 تا غمت را بر دل من نامزد کرد آسمان %~% حصن 
ms788	 صبرم هر شبی بام آسمان است از غمت(@)(@@) 30 هر زمان گوئی ز عشق من به جان پرداختی %~% این سخن باشد مرا پروای جان است از غمت(@)(@@) 31 از گلستان رخت باری مرا گر هیچ نیست %~% مرغزار چشم من پر ارغوان است از غمت(@)(@@) 32 زعفران شادی فزاید وین بتر کاندوه من %~% دور از آن رخ زین رخ چون زعفران است از غمت(@)(@@) 33 محنت اندر سینه من ره ندانستی کنون %~% شاهراه سینه من ناردان است از غمت(@)(@@) 34 از لبت چون بوسه خواهم کز پی آن لب مرا %~% آنچه اندر کیسه باید بر رخان است از غمت(@)(@@) 35 آنکه از عشقت زر افشاند ندانم کیست آن %~% این که خاقانی است دانم جان فشان است از غمت(@)(@@) 36 هم نبخشودی دلت گر باخبر بودی از آنک %~% حال من در دست مجلس داستان است از غمت(@)(@@) 37 کلک او قصر مکارم می‌طرازد هر زمان %~% نام او چتر معالی می‌فرازد هر زمان(@)(@@) 38 گرچه در احکام دست اوراست من هم آگهم %~% کآسمان در پرده کارش می‌طرازد هر زمان(@)(@@) 39 چشم زخمی را که دید اقبال‌ها بیند چنانک %~% قدر او بر چشمه خورشید تازد هر زمان(@)(@@) 40 خاک بر سر می‌کند گردون ز دستش کو چرا %~% تخته خاک از سر کیوان نسازد هر زمان(@)(@@) 41 ز این خطر کو خاک را دادست خاک از کبریا %~% بر سه عنصر تا قیامت می‌بنازد هر زمان(@)(@@) 42 حرمت آن را که میل او به اصل از آهن است %~% نیست آتش را محل کهن گدازد هر زمان(@)(@@) 43 چون بنانش سوی کلک آید بدان ماند همی %~% کآفتاب چرخ سوی حوت یازد هر زمان(@)(@@) 44 زان نوازش‌ها کزو دارد دل مجروح من %~% جانم از مدحش نوائی می‌نوازد هر زمان(@)(@@) 45 تازه رویان آفرینم ز آفرین او چنانک %~% با رخ هر یک زمانه عشق بازد هر زمان(@)(@@) 46 حکم صد ساله توان دیدن ز یک تقویم او %~% طفل یک 
ms789	 روزه مجسطی گیرد از تعلیم او(@)(@@) 47 تا که مشرف اوست اجرام فلک را از فلک %~% آن دو پیر نحس رحلت کرده‌اند از بیم او(@)(@@) 48 همتی دارد چنان کافلاک با لوح و قلم %~% کمترین جزوی است اندر دفتر تعظیم او(@)(@@) 49 باز دیدم در همه علمی نظیرش نیست کس %~% در همه اقلیم‌ها نی در یکی اقلیم او(@)(@@) 50 کلکش از بهر شرف محکوم تیغ آمد بلی %~% مرتبت بفزود اسمعیل را تسلیم او(@)(@@) 51 مشتری دیده نه‌ای رویش نگر گوئی کسی %~% سیب را بشکافت سوی چرخ شد یک نیم او(@)(@@) 52 ظاهر است انسابش از کافی عمر درگیر و رو %~% می‌شمر تا قد سلف عثمان و ابراهیم او(@)(@@) 53 عیسوی دم باد و احمد دیم و چشم حادثات %~% در شکر خواب عروسان از دم از دیم او(@)(@@) 54 بر جناب او و بر اهل جهان فرخنده باد %~% رجعت نوروز و ترجیع من و تقویم او(@)(@@) 55 ترک‌تاز غمزه تو غارت از جان درگرفت %~% رای قربان کرد و اول زخم ز ایمان درگرفت(@)(@@) 56 روزگاری روزگار از فتنه‌ها آسوده بود %~% زلف شب رنگ تو آمد فتنه دوران درگرفت(@)(@@) 57 کار ما خود رفته بود از دست باز از عشق تو %~% دهر زخمه درفزود و چرخ دستان درگرفت(@)(@@) 58 خوی تو با ما چه روزی زندگانی کرده بود %~% کز پی خونریز ما را راه هجران درگرفت(@)(@@) 59 ماتم دل‌ها عروسی بود ما را پیش ازین %~% تا درآمد شحنه‌ای غم غارت جان درگرفت(@)(@@) 60 ناله‌ها کردم چنان کز چرخ بانگ آمد که بس %~% ای عفی‌الله در تو گوئی ذره‌ای ز آن درگرفت(@)(@@) 61 از دم سردم چراغ آسمان بتوان نشاند %~% وز تف آهم هزاران شمع بتوان درگرفت(@)(@@) 62 گفتی ای خاقانی از غرقاب غم چون می‌رهی %~% چون رهم کز پای من تا سر به طوفان درگرفت(@)(@@) 63 دل که از درگاه تو محروم شد محروم‌وار %~% رفت و راه آستان صدر ایران درگرفت(@)(@@) 64 
ms790	 خاک پایت دیده‌ها را روشنایی می‌دهد %~% هر سحر بوی تو با جان آشنایی می‌دهد(@)(@@) 65 کار جزع و لعل توست آزردن و بنواختن %~% هرکه را این بشکند آن مومیایی می‌دهد(@)(@@) 66 باز خون‌ها خورده‌ای کالوده می‌بینم لبت %~% من چه گویم خود لبت بر تو گوایی می‌دهد(@)(@@) 67 تیره شد کار من از غم هان و هان دریاب کار %~% تا چراغ عمر قدری روشنایی می‌دهد(@)(@@) 68 از پی دریوزه وصل آمدم در کوی تو %~% چون کنم چون بخت روزی از گدایی می‌دهد(@)(@@) 69 یک دمی تا می‌زیم در هجر و امید وصال %~% گه کلاهم می‌برد گه پادشاهی می‌دهد(@)(@@) 70 گر مرا محنت گیائی می‌دهد از باغ عشق %~% در شک افتم کن مرا دولت کیایی می‌دهد(@)(@@) 71 جان خاقانی به رشوت می‌دهم ایام را %~% گر مرا زین روز غم روزی رهایی می‌دهد(@)(@@) 72 غم چه باشد چون ضمیر وحی پرداز مرا %~% فر مدحش آیت معجز نمایی می‌دهی PageV1P1353(@)(@@)(@@)(@@) || [genre: Tj](@)(@@) 1 سر چو آه عاشقان برکرد صبح %~% عطر آتش زای برکرد صبح(@)(@@) 2 از شرار آه مشتاقان دل %~% آتش عنبرفشان برکرد صبح(@)(@@) 3 بر قواره ماه سحری کرد چرخ %~% تا سر از خواب گران برکرد صبح(@)(@@) 4 تا کند سیمین قواره در زمین %~% سر ز جیب آسمان برکرد صبح(@)(@@) 5 خواب چشم ساقیان بست آشکار %~% دود رنگین کز نهان برکرد صبح(@)(@@) 6 ز آتشی کافتاد از حراق شب %~% شمع در صحرای جان برکرد صبح(@)(@@) 7 چون قراسنقر گریزان شد به راه %~% آق سنقر دیدبان برکرد صبح(@)(@@) 8 چون به دست چپ طراز چرخ دید %~% نقش والفجرش برکرد صبح(@)(@@) 9 کشتی زر هم کنون آمد پدید %~% کانک آنک بادبان برکرد صبح(@)(@@) 10 جام را گنج فریدون خون بهاست %~% چون درفش کاویان برکرد صبح(@)(@@) 11 از پی نوروز تا در جل کشند %~% زین به گلگون جهان برکرد صبح(@)(@@) 12 گوئی اینک بر دژ زرین روس %~% رایت شاه اخستان برکرد صبح(@)(@@) 13 جام چون گل عطر 
