ms161	(@)(@@)(@@)(@@) | دختر حکیم گاو(@)(@@) (@@) 1604 تا حلقه به گوش لب چون نوش توام %~% ای رشک پری، عاجز مدهوش توام(@)(@@) (@@) چون حلقهآ زرین تو، پیچان بر خود %~% در حسرت آن گوش و بناگوش توام(@)(@@) قاضی ابوالماجد(@)(@@) (@@) 1605 دیوانهآ زنجیر سیه پوش توام %~% دلخستهآ نرگس جفا کوش توام(@)(@@) (@@) تو مردم چشم مردم و، چشم منی %~% من حلقه به گوش حلقهآ گوش توام(@)(@@)(@@)(@@) | شمس گنجه ای(@)(@@) ~~1606 دل، در خم زلف مشکبوش استادهست جان، رقص کنان بر سر کوش استادهست(@)(@@) (@@) با عنبر زلفش، غم دل خواهم گفت %~% هر چند، که حلقه اش به گوش استادهست PageV01P308(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0312.jpg)(@)(@)(@@)(@@)(@@) | اوله(@)(@@) ~~1607 از صد غم من، یکی به گوش تورسید وین واقعه، بی شکی به گوش تو رسید(@)(@@) (@@) زان زر، که من از چهره به نام توزدم %~% هم، عاقبت اندکی به گوش تو رسید(@)(@@) (@@) گر خصم زرت دهد، پی کشتن من 1608 ای مهر گسل، وفا فراموش مکن %~%(@)(@@) اوله %~% اوله %~% خون جگرم بی سببی نوش مکن %~% زنهار، که آن حدیث در گوش مکن(@)(@@) (@@) 16 از وصل توام، نصیب مهجوری بود هرصلح، که با عنبر زلفت کردم %~%(@)(@@) توفیر، زنزدیک توام دوری بود %~% مانند بناگوش تو، کافوری بود(@)(@@)(@@)(@@) | نمط هفتم(@)(@@) درتشبیهات خط(@)(@@)(@@)(@@) | جمال اشهری(@)(@@) (@@) 1610 بر شگر یار، از پر طوطسی اشسری %~% می یابم و، می نیابم از دل خبری(@)(@@) (@@) 1611 دارد زجهان فراغتی آن دلجوی با طوطی وشکرت ازین شیرینتر %~% وله(@)(@@) %~% در بر نگرفت، هیچ طوطی شکری %~% ای خط سر خویش گیر، از و دست بشوی!(@)(@@) (@@) کان دلبر جنگجوی را، با خوبی %~% صلحی است، چنانکه در نمی گنجد موی(@)(@@) (@@) 161 گردی، که زمشک برلب یارنشست %~% لغیره %~% زاغی است، که برخرمن گلزار نشست(@)(@@) (@@) نی نی غلطم، سخن خطا می گویم %~% طوطی است که برتنگ شکر بار نشست(@)(@@) ~~1612 پوشیده خوش است رویش، از روی زره در روی، سپر کشیده دیدی بسیار(@)(@@) %~% لغیره %~% امروز ببین، کشیده در روی زره %~% دلخواه سپر، به پیش دلجوی زره(@)(@@) (@@) 161 گفتم که : مگر لعل 
ms162	 لبت را دامن %~% الغیره %~% بگرفت سیاهی، که بگردد با من(@)(@@) (@@) گفتا: غلطی، آب حیات است لبم %~% تاریکی، از آن در آمدش پیرامن PageV01P309(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0313.jpg)(@)(@)(@@)(@@)(@@) | غیره(@)(@@) (@@) 1615 تا خط خوش و عارض تو گشت پدید %~% خطی زبنفشه، بر رخ لاله کشید(@)(@@) (@@) گو یند که: سبزه چشم روشن دارد %~% چشمت روشن، که بر گلت سبزه دمیذ!(@)(@@)(@@)(@@) | سیف تفلیسی(@)(@@) (@@) 1616 دردا، که غمت پردهآ رازم بدرید %~% عمرم شد و، دیدهآ منت سیر ندید(@)(@@) (@@) افسوس، کمه آفتاب نیکویی تو %~% در ابر شد و، صبح امیدم ندمید(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 1617 عشق رخ تو، مرا کنون گشت پدید %~% کان گرد سیه، به گرد آن مه بدمید(@)(@@) (@@) نتوانستم، رخ تو تا اکنون دید %~% بی ابر، در آفتاب نتوان نگرید(@)(@@)(@@)(@@) | اشرف غزنوی.(@)(@@) (@@) 1618 تا شاخ بنفشه، از گل یار آو یخت %~% در دامن دل، زعشق صد خار آو یخت(@)(@@) (@@) گر آن گل و آن بنفشه بینی، گویی %~% زاغی، پر خویشتن به منقار آو یخت(@)(@@)(@@)(@@) | اشهری(@)(@@) (@@) 1619 تا اطلس عارضت، زخط یافت علم %~% در دل، زغم عشق تو شد تازه الم(@)(@@) (@@) تا شد قلم قضا روان، در نامد %~% از خط تو خوبتر، قضا را به قلم(@)(@@)(@@)(@@) | بغیره(@)(@@) (@@) 1620 بس خون، که مرا در جگر آمد زلبت %~% تا تخم امیدم، به بر آمد زلبت(@)(@@) (@@) یک خط خوش، از زمانه بد آرزویم %~% آن آرزویم نیز، بر آمد زلبت(@)(@@)(@@)(@@) | الغیره(@)(@@) ~~1621 از خط تو، درخط نشوم ای دلبرلابل که زعشق تو، نهم برخط سر(@)(@@) (@@) دریای جمال بیحدت، موج بزد %~% زان رو، به در افکند به ساحل عنبر(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~1622 خطت، که سواد نقرهآ خام آورد طوطی است، که شکر تو در دام آورد(@)(@@) (@@) چون رسم بود، که شکر آرند زشام %~% لعل لبت، ازشکر چرا شام آورد؟(@)(@@)(@@)(@@) | علی بن الحسن(@)(@@) ~~1623 در عشق تو، ای سرشک من چون ژاله بی برگ گلت، چو بلبلم از ناله(@)(@@) ~~گر لاله ز سبزه روید، ای جان بهار پس سبزهآ تو چراست پر از لاله؟(@)(@)PageV01P310(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0314.jpg)(@)(@)(@@) (@@) 162 
ms163	 خطی است، که عارض توبمی پردازد %~% الغیره %~% یا بر سمنت، موی گذر می سازد(@)(@@) (@@) نه، بچهآ طوطی است، که بر خرمن گل %~% لغیره %~% پر می زند و، سوی شکر می یازد(@)(@@) (@@) 162 تا خط بدیع سبز رنگ آوردی %~% برنقطهآ مه، دایره تنگ آوردی(@)(@@) (@@) وم تو، چو بر دیار دل دست نیافت %~% الغیره %~% رفتی، مدد از لشکر زنگ آوردی(@)(@@) (@@) 1620 بس بوالعجبیها، که به کار آوردی %~% تا لاله به مشک، در حصار آوردی(@)(@@) (@@) بر گل، نه همی زحمت خار آوردی %~% بر لاله ستان، بنفشه زار آوردی(@)(@@)(@@)(@@) | عبدالله(@)(@@) (@@) 1621 جانا، ز دو رخ گل بدیع آوردی %~% و اندر مه دی، فصل ربیع آوردی(@)(@@) (@@) چون دانستی، که دل به گل می ندهم %~% رفتی و، بنفشه را شفیع آوردی(@)(@@) مظفر معروف (تبریزی؟)(@)(@@) (@@) 1628 گیرم، که خط غالیه گون آوردی %~% بر لالهآ رخ، بنفشه چون آوردی؟(@)(@@) (@@) گل در چمن، از خار برون می آید %~% تو از گل خود، خار برون آوردی(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 1629 ناگاه، خطی چو پر زاغ آوردی %~% تا بر دل من، ز درد داغ آوردی(@)(@@) (@@) آرند چراغ در شب، ای جان وجهان %~% شب را، تو چگونه در چراغ آوردی؟(@)(@@)(@@)(@@) | نجیب گنجه ای(@)(@@) ~~1630 جانا، بر نور شمع دود آوردی یعنی که خط توخوش نبود، آوردی(@)(@@) (@@) گر دود دل من است، دیرت بگرفت %~% وله %~% ور خط به خون من، چه زود آوردی!(@)(@@) (@@) 163 خطی، که تو بر ماه سما آوردی %~% گویی که به خون دل ما آوردی(@)(@@) (@@) مشک ختنی، بر خط تو سر بنهد %~% با آنکه توآن خط، زخطا آوردی!(@)(@@)(@@)(@@) | عزیز شفروه(@)(@@) ~~1632 زلف تو، سوی رخ تو گر می آید هندوست، به دزدی شکر می آید PageV01P311(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0315.jpg)(@)(@)(@@)(@@)(@@) | الغیره(@)(@@) ~~1233 مشکی، که زکافور تو بر می آید ابری است، که بر گرد قمر می آید(@)(@@) (@@) پروانهآ عارض چو شمع تو، منم %~% خط تو، به فرمان که بر می آید؟(@)(@@)(@@)(@@) | جمال شروانی(@)(@@) (@@) 1634 در روی تسو از کسجا نظر می آید %~% از مشک خطت 
ms164	 بوی جگر می آید(@)(@@) (@@) مویت، که زشرم بر نیاوردی سر 1635 چون روی تو، بیگناه بر می آید %~%(@)(@@) وله %~% خط تو چرا سیاه بر می آید؟ %~% امروز، تو را به روی بر می آید(@)(@@) (@@) گر ماه به شب برآید، آن نیست عجب %~% این طرفه، شبت زماه بر می آید!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1636 ای قد تو همچو سرو و عرعر رسته %~% خطت، چو بنفشه بر گل تر رسته(@)(@@) (@@) جز بر زنخ خوشت، کسی در عالم %~% بر نقرهآ خام دید، عنبر رسته؟(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1637 خطت، زکمین راه رخت می گیرد %~% ناگاه، کمرگاه رخت می گیرد(@)(@@) (@@) بر بام لبت، به بوسه طشتی بزنیم %~% کز سایهآ خط، ماه رخت می گیرد(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 1638 زلف خوش تو، اگرچه انگشت وش است %~% بر سینه فکنده، همچوبر پشت خوش است(@)(@@) (@@) درخط مشوارتورا خط آمد، کان خط %~% اوله %~% انگشت نمای است، نه انگشت کش است(@)(@@) ~~1639 شکل دو لب [لعل]تو، ای دردانه میم است و، در و دو سین به سی دندانه(@)(@@) (@@) وان خط، که کشید گرد لعل توفلک %~% اوله %~% حرزی است، زبهر دل صد دیوانه(@)(@@) (@@) 1640 زان خط چومشک و، زان دو چشم آهو %~% دل فاش شد، از بس که کشیدهست آه او(@)(@@) (@@) گر آهو مشک دارد، آن نیست عجب %~% این طرفه، که مشک تر ندارد آهو!ا(@)(@@)(@@)(@@) | عزیز شروانی(@)(@@) (@@) 1641 با روی تو، هر که خوش برآید چوخطت %~% انگشت نمای کشور آید، چوخطت(@)(@@) ~~و آنکس کنه چوازلف] بر خطت سرننهد از دولت خود، به رو درآید چوخطت PageV01P312(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0316.jpg)(@)(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~1642 ای خطظ تو دور ماه را اندازه وزخظ خوش تو، در جهان آوازه(@)(@@) ~~منشی قدر، بسی قلم زد تا کرد منشور جمالت، به خط توتازه(@)(@@)(@@)(@@) | اشمس شجاسی(@)(@@) (@@) 16،3 ای خط تو چون روز بدآموز دلم %~% زین خطا به خط سیه کن روز دلم(@)(@@) (@@) فرآینهآ رخت، زخط در غلطم %~% وله %~% کان عکس دوزلف توست، یا سوز دلم!(@)(@@) ~~16،5 خطت، که دلم زو همه با خون افتاد شرحش بشنو 
ms165	 زمن، که تا چون افتاد(@)(@@) (@@) هجران تو، آتشی به جانم در زد %~% دودش، زدو عارض تو بیرون افتاد(@)(@@) (@@) 1645 من در عجبم، زان خط مهر افزایش %~% سنایی %~% چون مورچه ای، که گیل بود مأوایش(@)(@@) (@@) من غرق در آبم و، دلم می سوزد %~% او بر سر آتش و، نسوزد پایش!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1646 گفتم که مگر تویی فسون دل من %~% چون خط بدمد، شوی زبون دل من(@)(@@) (@@) در خاطر من نبود جانا، که خطت %~% خطی دگر آورد، به خون دل من!(@)(@@)(@@)(@@) | جمال عبد الرزاق(@)(@@) ~~1647 زان نقطهآ مشکین، که تو بر رخ زدهایعقل همه عشاق، به شه رخ زدهای(@)(@@) ~~طغرای شهنشاه جهان، منسوخ است زان، خط سیه بر رخ فرخ زدهای(@)(@@)(@@)(@@) | رضیه گنجه ای(@)(@@) ~~1648 آن زلف نگر، سر به سمن آوردهبر گرد سمن، مشک ختن آورده(@)(@@) (@@) گویند: خطی است آنکه گرد رخ اوست %~% خطی است، ولی به خون من آورده!(@)(@@)(@@)(@@) | جمال عبدالرزاق(@)(@@) ~~1645 ترکی، که مرا شاد کند خندهآ او دارد به غمم، زلف سرافکندهآ او(@)(@@) (@@) از من بستد خطی، به آزادی خویش %~% و آورد خطی، که من شدم بندة اوا PageV01P313(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0317.jpg)(@)(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1650 گفتم: چو خطت به رنگ موی تو شود %~% او، آفت آن روی نکوی تو شود(@)(@@) (@@) بر خاطرم از خط تو، این خود نگذشت %~% کو، هم مدد جمال روی توشود(@)(@@)(@@)(@@) | کمال اسماعیل(@)(@@) (@@) 1651 زلفش قلم و، مشک نکو دارد خط %~% برگرد رخش زمشک بنگارد خط(@)(@@) (@@) ببرید سرش را و، قلم را لابد %~% تا سر بنبرند، نکو نارد خط(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1652 مشک تو، نقاب ارغوان می گردد %~% سوسن به بنفشه در، نهان می گردد(@)(@@) (@@) هر چند که درحسن، جهانی است رخت %~% دریاب، که احوال جهان می گردد!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 1653 آن تنگ دهان، که قوت جان می گردد %~% از دیدهآ بیننده نهان می گردد(@)(@@) (@@) گنجی است نهان، که کس بدو راه نبرد %~% جز خط، که به پیرامن آن می گردد(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1654 لعل تو، کزو شکر شدهست اندر خط 
ms166	 %~% دانی، که چرا دست زده ست اندر خط؟(@)(@@) (@@) از زلف تودیده، مار پیچان بر خود %~% حالی، به فسونگری نشست اندر خط(@)(@@)(@@)(@@) | وله(@)(@@) ~~1655 نقاش، که آن صورت زیبا بنگاشت یارب، چه به قد آن قد و بالا بنگاشت:(@)(@@) (@@) وز خط خوشت نیز چه گویم؟ انصاف %~% نتوان به قلم، چنان خطی را بنگاشت!(@)(@@) (@@) 1256 روزی، لبم از رخ توبوسی بربود %~% اوله %~% از ساده دلی، رخ تو بر وی بخشود(@)(@@) (@@) آشفتگی زلف تو، دانم زان است %~% در خط شدن لب تو، از بهر چه بود؟(@)(@)PageV01P314(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0318.jpg)(@)(@)(@@) (@@) 1657 در چنگ غمت، گرنه زبون آمدمی %~% وله %~% کی چون سر زلف تو، نگون آمد می(@)(@@) ~~گر عارض تو، مرا به خود ره دادی چون خط تو، از پوست برون آمدمی(@)(@@)(@@)(@@) | معزی(@)(@@) (@@) 1658 شب را، سر زلف تو سیاهی بدهد %~% امروز، دل از هر که بخواهی بدهد(@)(@@) (@@) این دعوی را، اگر تو انکار کنی %~% ظهیر %~% در روی تو، خط تو گواهی بدهد(@)(@@) (@@) گویی که فلک نبشت بر عارض او 1650 یارم، چو کنون رنج مرا یاد کند %~%(@)(@@) کاین است، سزای آنکه بیداد کند! %~% برگ گل خود، تبه به شمشاد کند(@)(@@)(@@)(@@) | اوله(@)(@@) ~~ی سبزهآ تر دمیده در سایهآ زلف 166 در پردهآ خوشدلی، کسی را راهی است(@)(@@) %~% کورا، سر و کار با چوتو دلخواهی است %~% انصاف بده، که خوش تماشا گاهی است!(@)(@@)(@@)(@@) | فاضلهآ سمرقندیه(@)(@@) (@@) 166 چشم تو، که ابروی کمانکش دارد %~% در هر مژهای، هزار ترکش دارد(@)(@@) (@@) زنهار، مفرمای براتم به خطش %~% بر عارضش افکن، که خطی خوش دارد(@)(@@)(@@)(@@) | سوزنی(@)(@@) (@@) 166تا عارض خوبت، زخط آثار گرفت %~% بر سنبل تر، نسترنش بار گرفت(@)(@@) (@@) هر برگ گل لعل تو، گویی. که مگر %~% طوطی، شکر اندر سر منقار گرفت(@)(@@)(@@)(@@) | سلیمانشاه(@)(@@) (@@) 166 بر برگ گلت، مورچه ره خواهد کرد %~% وزلاله، بنفشه تکیه گه خواهد کرد(@)(@@) (@@) جانا، ز سیه گری بدان جای رسید %~% خط تو، که ماه را سیه خواهد کرد(@)(@@)(@@)(@@) | شمس هروی(@)(@@) (@@) 166 خط تو، که ره جست زهر در 
