ms761	 هاذين المسجدين كما تأرز الحية في جحرها ) )(@)(@@) ( حم ض ) عن ابن سعد بن أبي وقاص رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6982 ) قال النبي :(@)(@@) | 30 ( إن الأيمان منفقة للسلعة ممحقة للمال ) )(@)(@@) ( عب ) عن سعيد بن المسيب ( حم ) عن أبي هريرة و ( ن ) عن أبي قتادة مرسلا .(@)(@@)(@@)(@@) $ ( 6983 ) قال النبي :(@)(@@) | 30 ( إن البخيل من نكرت عنده فلم يصل علي ) )(@)(@@) ( حب عد هب ) عن الحسين رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6984 ) قال النبي :(@)(@@) | 30 ( إن البر ما استقر في الصدر واطمأن إليه القلب ، والشك ما لم يستقر في الصدر ولم يطمئن إليه القلب ، فدع ما يريبك إلى ما لا يريبك وإن أفتاك المفتون ) )(@)(@@) ابن عساكر عن واثلة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6985 ) قال النبي :(@)(@@) | 30 ( إن البلاء موكل بالقول ، ما قال عبد لشيء والله لا أفعله أبدا إلا ترك الشيطان كل عمل وولع منه بذالك حتى يؤثمه ) )(@)(@@) الخطيب عن أبي الدرداء رضي الله عنه .(@)(@@) PageV03P013(@)(@@)(@@)(@@) $ ( 6986 ) قال النبي :(@)(@@) | 30 ( إن البيع يحضره اللغو والحلف فشوبوه بالصدقة ) )(@)(@@) ( عب ) عن قيس بن عروة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6987 ) قال النبي :(@)(@@) | 30 ( إن التجار هم الفجار ، قيل : يا رسول الله ، أوليس قد أحل الله البيع ؟ قال : بلى ولاكنهم يحدثون فيكذبون ، ويحلفون فيأثمون ) )(@)(@@) ( حم ) و ابن جرير ( ك طب هب ) عن عبد الرحمن بن شبل ( طب ) عن معاوية رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6988 ) قال النبي :(@)(@@) | 30 ( إن التراب لها طهور ) )(@)(@@) البغوي وضعفه عن عائشة رضي الله عنها أنها سألت النبي عن صلاة الرجل في النعلين وهو يطا بهما في الآثار قال : فذكره .(@)(@@)(@@)(@@) $ ( 6989 ) قال النبي :(@)(@@) | 30 ( إن الجنة عرضت علي فلم أر مثل ما فيها ، وإنها مرت بي خصلة من عنب فأعجبتني فأهويت إليها لآخذها فسبقتني ، ولو أخذتها لغرستها بين ظهرانيكم حتى تأكلوا من فاكهة الجنة ، واعلموا أن الكمأة دواء العين وأن العجوة من فاكهة الجنة ، وإنا هاذه الحبة السوداء التي تكون في الملح اعلموا أنها دواء من كل داء إلا الموت ) )(@)(@@) ( حم واللفظ له ع ص ) عن عبد الله بن بريدة عن أبيه .(@)(@@)(@@)(@@) $ ( 6990 
ms762	 ) قال النبي :(@)(@@) | 30 ( إن الجنة لتزين من الحول إلى الحول لشهر رمضان ، وإن الحور لتزين من الحول إلى الحول لصوام رمضان ، فإذا دخل رمضان قالت الجنة : اللهم اجعل لي في هاذا الشهر من عبادك ، أهلا ويقلن الحور أهلا : اللهم اجعل لنا عبادك أزواجا في هاذا الشهر ، فمن لم يقذف فيه مسلما ببهتان ، ولم يشرب فيه مسكرا كفر الله عنه ذنوبه ، ومن قذف فيه مسلما أو شرب فيه مسكرا أحبط الله عمله لسنته ، فاتقوا شهر رمضان فإنه شهر الله ، جعله الله لكم PageV03P014 أحد عشر شهرا تأكلون فيها وترون فيها وتشربون وتلذذون ، وجعل لنفسه شهرا فاتقوا شهر رمضان فإنه شهر الله ) )(@)(@@) ( هب كر ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6991 ) قال النبي :(@)(@@) | 30 ( إن الجنة تزين من الحول إلى الحول لشهر رمضان ، من صان نفسه ودينه في شهر رمضان زوجه الله من الحور العين ، وأعطاه قصرا من قصور الجنة ، ومن عمل سيئة أو رمى مؤمنا ببهتان ، أو شرب مسكرا في شهر رمضان أحبط الله عمله سنة ، فاتقوا شهر رمضان لأنه شهر الله جعل الله لكم أحد عشر شهرا تأكلون فيها وتروون ، وشهر رمضان شهر الله فاحفظوا فيه أنفسكم ) )(@)(@@) ابن صصرى في أماليه عن أبي أمامة وواثلة وعبد الله بن بسر معا رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 6992 ) قال النبي :(@)(@@) | 30 ( إن الجود لمن شيمة أهل ذالك البيت ) )(@)(@@) أبو بكر في الغيلانيات وابن عساكر عن جابر بن عبد الله أن رسول الله بعث بعثا عليهم قيس بن سعد بن عبادة فجهدوا فنحر لهم قيس تسع ركائب ، فلما قدموا ذكروا ذالك لرسول الله فقال فذكره ابن عساكر عن جابر بن سمرة رضي الله عنه أيضا .(@)(@@)(@@)(@@) $ ( 6993 ) قال النبي :(@)(@@) | 30 ( إن الحج والعمرة فريضتان لا يضرك بأيهما بدأت ) )(@)(@@) ( ك ) عن زيد بن ثابت رضي الله عنه وصحح وقفه .(@)(@@)(@@)(@@) $ ( 6994 ) قال النبي :(@)(@@) | 30 ( إن الحجر ليزن سببع خليفات يرمى به في جهنم فيهوي فيها سبعين خريفا ما يبلغ قعرها ، ويؤتى بالغلول فيلقى معه ثم يكلف صاحبه أن يأتي 
ms763	 به ) )(@)(@@) ( ن طب هب ) عن سل يمان بن أبي بريدة عن أبيه .(@)(@@)(@@)(@@) $ ( 6995 ) قال النبي :(@)(@@) | 30 ( إن الحسن والحسين سيدا شباب أهل الجنة ) )(@)(@@) ( حم ) عن حذيفة ، ابن عساكر عن علي بن أبي عزرة في مسنده وابن منده وابن قانع وأبو نعيم وابن عساكر عن جهم رضي الله عنه .(@)(@@) PageV03P015(@)(@@)(@@)(@@) $ ( 6996 ) قال النبي :(@)(@@) | 30 ( إن الحمد لله نحمده ونستعينه ونستغفره ونعوذ بالله من شرور أنفسنا وسيئات أعمالنا ، من يهد الله فلا مضل له ، ومن يضلل فلا هادي له ، وأشهد أن لا إلاه إلا الله وحده لا شريك له وأشهد أن محمدا عبده ورسوله ) )(@)(@@) ( حم واللفظ له م ه طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6997 ) قال النبي :(@)(@@) | 30 ( إن الحمد لله نحمده ونستعينه ونستغفره ونعوذ بالله من شرور أنفسنا ومن سيئات أعمالنا من يهد الله فلا مضل له ومن يضلل فلا هادي له ، وأشهد أن لا إلاه إلا الله وأشهد أن محمدا عبده ورسوله ، يا أيها الذين آمنوا اتقوا الله حق تقاته ولا تموتن إلا وأنتم مسلمون واتقوا الله الذي تساءلون به والأرحام إن الله كان عليكم رقيبا ، يا أيها الذين آمنوا اتقوا الله حق تقاته ولا تموتن إلا وأنتم مسلمون ، يا أيها الذين آمنوا اتقوا الله وقولوا قولا سديدا يصلح لكم أعمالكم ويغفر لكم ذنوبكم ومن يطع الله ورسوله فقد فاز فوزا عظيما ) )(@)(@@) ( حم د ت ) حسن ( ن ه ) و ابن السني في عمل يوم وليلة ( ك هق ) عن ابن مسعود قال : علمنا رسول الله خطبة الحاجة فذكره .(@)(@@)(@@)(@@) $ ( 6998 ) قال النبي :(@)(@@) | 30 ( إن الحمى كور من كور جهنم من ابتلي بشيء منها كانت حظه من النار ) )(@)(@@) ( ع ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6999 ) قال النبي :(@)(@@) | 30 ( إن الحمى رائد الموت وهي سجن المؤمن وهي قطعة من النار ، ففتروها عنكم بالماء البارد ) )(@)(@@) ( هناد ) عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 7000 ) قال النبي :(@)(@@) | 30 ( إن الحلال بين وإن الحرام بين ، وإن بين ذالك أمورا مشتبهات وسأضرب لكم في ذالك مثلا : إن الله تعالى حمى حمى 
ms764	 ، وإن حمى الله ما حرم ، وإنه من يرعى حول الحمى يوشك أن يخالطه الريبة ، وإنه من يخالط الريبة PageV03P016 يوشك أن يجسر ) )(@)(@@) ( طب ) عن النعمان بن بشير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7001 ) قال النبي :(@)(@@) | 30 ( إن الحياء من الإيمان ، وإن الإيمان في الجنة ، ولو كان الحياء رجلا لكان رجلا صالحا ) )(@)(@@) ( الخرائطي في مكارم الأخلاق ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 7002 ) قال النبي :(@)(@@) | 30 ( إن الحياء لا يأتي إلا بخير ) )(@)(@@) الحسن بن سفيان وأبو نعيم عن يسير بن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7003 ) قال النبي :(@)(@@) | 30 ( إن الحياء والعفاف والعي : عي اللسان لا عي القلب والعقل من الإيمان ، وإنهن يزدن في الآخرة وينقصن من الدنيا ، ولما يزدن في الآخرة أكثر مما ينقصن من الدنيا ، وإن الشح والفحح والبذاء من النفاق ، وإنهن ينقصن من الآخرة ويزدن في الدنيا ، ولما ينقصن من الآخرة أكثر مما يزدن في الدنيا ) )(@)(@@) يعقب بن سفيان ( طب حل هق ) والخطيب وابن عساكر من طريق أياس بن معاوية بن قرة المزني عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 7004 ) قال النبي :(@)(@@) | 30 ( إن الخبائث جعلت في بيت فاغلق عليها وجعل مفتاحها الخمر فمن شرب الخمر وقع بالخبائث ) )(@)(@@) ( عب ) عن معمر عن أبان رفع الحديث .(@)(@@)(@@)(@@) $ ( 7005 ) قال النبي :(@)(@@) | 30 ( إن الخلق السيء يفسد العمل كما يفسد الخل العسل ) )(@)(@@) العسكري في الأمثال عن علي رضي الله عنه ورجاله ثقات .(@)(@@)(@@)(@@) $ ( 7006 ) قال النبي :(@)(@@) | 30 ( إن الدجال خارج وإنه أعور ، عين الشمال ، عليها ظفرة غليظة ، وإنه يبرىء الأكمة والأبرص ويحيي الموتى ويقول للناس : أنا ربكم ، فمن قال : أنت ربي فقد فتن ، ومن قال : ربي الله حتى يموت فقد عصم PageV03P017 من فتنته ولا فتنة بعده عليه ولا عذاب ، فلبث في الأرض ما شاء الله ثم يجيء عيسى بن مريم عليهما السلام من قبل المغرب مصدقا بمحمد وعلى ملته فيقتل الدجال ، ثم إنما هو قيام الساعة ) )(@)(@@) ( حم طب ) و الروياني ( ض ) عن سمرة بن جندب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7007 ) قال النبي :(@)(@@) | 30 ( إن الدجال أعور عين الشمال ، بين جبينه مكتوب 
ms765	 كافر ، وعلى عينه ظفرة غليظة ) )(@)(@@) نعيم بن حماد في الفتن عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7008 ) قال النبي :(@)(@@) | 30 ( إن الدجال يبلغ كل منهل إلا أربعة مساجد : مسجد الحرام ومسجد المدينة ، ومسجد طور سيناء ، ومسجد الأقصى ) )(@)(@@) نعيم عن رجل .(@)(@@)(@@)(@@) $ ( 7009 ) قال النبي :(@)(@@) | 30 ( إن الدعاء ينفع مما نزل ومما لم ينزل ، فعليكم عباد الله بالدعاء ) )(@)(@@) ( ت ) واللفظ له عن نافع عن ابن عمر ( حم ) عن معاذ بن جبل رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 7010 ) قال النبي :(@)(@@) | 30 ( إن الدنيا حلوة خضرة ، فمن أصاب منها شيئا من حله فذاك الذي يبارك له فيه ، وكم من متخوض في مال الله ومال رسوله له النار يوم القيامة ) )(@)(@@) ( طب ) عن عمرة بنت الحارث بن أبي ضرار و ( حم ) عن خولة بنت قيس الأنصارية رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7011 ) قال النبي :(@)(@@) | 30 ( إن الدنيا حلوة خضرة وإن الله مستخلفكم فيها فناظر كيف تعملون ، فاتقوا الدنيا واتقوا النساء ، فأول فتنة بني إسرائيل كانت في النساء ) )(@)(@@) ( م ) واللفظ له ( حم ت ه ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7012 ) قال النبي :(@)(@@) | 30 ( إن الدنيا ستفتح عليكم ، فياليت أمتي لا يلبسون الحرير ) )(@)(@@) ( قط ) في الأفراد عن حذيفة رضي الله عنه .(@)(@@) PageV03P018(@)(@@)(@@)(@@) $ ( 7013 ) قال النبي :(@)(@@) | 30 ( إن الدنيا حضرة حلوة ، وإن الله تعالى مستخلفكم فيها فينظر كيف تعملون ، فاتقوا الدنيا واتقوا النساء ، ألا إن لكل غادر لواء يوم القيامة بقدر غدرتت ينصب عند إسته يجزى به ) )(@)(@@) ( حم ) واللفظ له ( ه ) عن أبي سعيد ( طب ) عن أبي بكرة رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7014 ) قال النبي :(@)(@@) | 30 ( إن الدين النصيحة ، إن الدين النصيحة ، إن الدين النصيحة ، قالوا : لمن يا رسول الله ؟ قال : لله ولكتابه ولرسوله ولأئمة المسلمين وعامتهم ) )(@)(@@) ( م د ن حم ) و أبو عوانة وابن خزيمة ( حب ) والبغوي والباوردي وابن قانع ( هب ) وأبو نعيم عن تميم الداري ( ن ت ) حسن ( ن قط ) في الأفراد عن أبي هريرة ( حم طب ) عن ابن عباس ( ابن عساكر ) عن ثوبان رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 7015 ) قال النبي :(@)(@@) | 30 ( إن الربا 
ms766	 وإن كثر فإن عاقبته تصير إلى قل ) )(@)(@@) ( حم ه طب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7016 ) قال النبي :(@)(@@) | 30 ( إن الربا سبعون حوبا ، أدناها مثل ما يقع الرجل على أمه ، وأربى الربا استطالة المرء في عرض أخيه ) )(@)(@@) ( هب ه ) وضعفه عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7017 ) قال النبي :(@)(@@) | 30 ( إن الرب لينظر إلى عباده كل يوم ثلاثمائة وستين مرة يبدي ويعيد ذالك ، وذالك من حبه لخلقه ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7018 ) قال النبي :(@)(@@) | 30 ( إن الرجل ليشفع للرجلين والثلاثة ، والرجل للرجل ) )(@)(@@) ( حم ت ) عن أبي سعيد وابن خزيمة عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7019 ) قال النبي :(@)(@@) | 30 ( إن الرجل ليعمل بعمل أهل الجنة وإنه لمن أهل النار ، وإن الرجل ليعمل بعمل أهل النار وإنه من أهل الجنة ، تدركه الشقوة أو PageV03P019 السعادة عند خروج نفسه فيختتم له بها ) )(@)(@@) ( طب ) عن ثوبان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7020 ) قال النبي :(@)(@@) | 30 ( إن الرجل ليدفع عن باب الجنة أن ينظر إليها بملء محجمة من دم يريقه من مسلم بغير حق ) )(@)(@@) ابن مندة ( طب ) وابن عساكر عن بريدة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7021 ) قال النبي :(@)(@@) | 30 ( إن الرجل من أهل الجنة ليشرف على أهل الجنة كأنه كوكب دري ، وإن أبا بكر وعمر لمنهم ) )(@)(@@) و ابن عساكر عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7022 ) قال النبي :(@)(@@) | 30 ( إن الرجل من أهل عليين ليشرف على أهل الجنة فتضيء الجنة لوجهه كأنها كوكب دري ، وإن أبا بكر وعمر لمنهم وأنعما ) )(@)(@@) ( كر ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7023 ) قال النبي :(@)(@@) | 30 ( إن الرجل لا يزال في صحة رأيه ما نصح لمستشيره ، فإذا غش سلبه الله صحة رأيه ) )(@)(@@) ابن عساكر عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7024 ) قال النبي :(@)(@@) | 30 ( إن الرجل لا يكون مؤمنا حتى يكون قلبه مع لسانه سواء ، أو يكون لسانه مع قلبه سواء ، ولا يخالف قوله عمله ، ويأمن جاره بوائقه ) )(@)(@@) ابن لال في مكارم الأخلاق وابن عساكر عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7025 
ms767	 ) قال النبي :(@)(@@) | 30 ( إن الرجل منكم ليأتيني فيسألني فاعطيه فينطلق وما يحمل في حضنه إلا النار ) )(@)(@@) عبد بن حميد والشاشي والحسن بن سفيان ( حب ض ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7026 ) قال النبي :(@)(@@) | 30 ( إن الرجل من أمتي ليدخل الجنة فيشفع لأكثر من مضر ، وإن الرجل من أمتي ليعظم للنار حتى يكون أحد زواياها ، وما من مسلمين يقدمان أربعة من ولدهما إلا أدخلهما الله الجنة بفضل رحمته ، قالوا : أو ثلاثة ؟ قال : أو ثلاثة ، قالوا : أو اثنين ؟ قال : أو اثنين ) )(@)(@@) ( طب ) عن الحارث بن أقيس PageV03P020 رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7027 ) قال النبي :(@)(@@) | 30 ( إن الرجل من أهل الجنة يشرف على أهل النار فيناديه رجل من أهل النار يا فلان أما تعرفني ؟ فيقول : لا والله ما أعرفك ، من أنت ويحك ؟ قال : أنا الذي مررت بي في الدنيا فاستسقيتني شربة ماء فسقيتك فاشفع لي بها عند ربك ، فيدخل ذالك الرجل على الله في زورة فيقول : يا رب إني أشرفت على أهل النار فقام رجل من أهل النار فناداني يا فلان أما تعرفني ؟ فقلت له : لا والله ما أعرفك ومن أنت ؟ قال : أنا الذي مررت بي في الدنيا فاستسقيتني فسقيتك فاشفع لي بها عند ربك ، يا رب فشفعني فيه فيشفعه الله فيه ، ويخرجه من النار ) )(@)(@@) ( ع ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7028 ) قال النبي :(@)(@@) | 30 ( إن الرجل لينطلق إلى المسجد فيصلي وصلاته لا تعدل جناح بعوضة وإن الرجل ليأتي المسجد فيصلي وصلاته تعدل جبل أحد إذا كان أحسنهما عقلا ، قيل : وكيف يكون أحسنهما عقلا ؟ قال : أوزعهما عن محارم الله وأحرصهما على أسباب الخير وإن كان دونه في العمل والتطوع ) )(@)(@@) الحكيم عن أبي حميد الساعدي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7029 ) قال النبي :(@)(@@) | 30 ( إن الرجل يقوم ويصلي ويحج ويعتمر ، فإذا كان يوم القيامة أعطي بقدر عقله ) )(@)(@@) الخطيب وضعفه عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7030 ) قال النبي :(@)(@@) | 30 ( إن الرجل ليعمل كذا وكذا من الخير وإنه لمنافق ، يلعن الأئمة ويطعن عليهم ) )(@)(@@) ( طب ) عن أبي مصبح الحمصي عن 
ms768	 نفر من الصحابة منهم شداد بن أوس وثوبان رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7031 ) قال النبي :(@)(@@) | 30 ( إن الرجل ليقوم في الصلاة فيدعو الدعوة فيغفر له PageV03P021 ولمن وراءه من الناس ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7032 ) قال النبي :(@)(@@) | 30 ( إن الرجل ليأتيني فيسألني فاعطيه ، ثم يسألني فاعطيه ، ثم يسألني فاعطيه ، ويجعل في ثوبه نارا ، ثم ينقلب إلى أهله بنار ) )(@)(@@) ( حم ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7033 ) قال النبي :(@)(@@) | 30 ( إن الرجل في الجنة ليتكيء سبعين سنة قبل أن يتحول ، ثم تأتيه امرأته فتضرب على منكبيه فينظر وجهه في خدها أصفى من المرآة ، وإن أدنى لؤلؤة عليها تضيء ما بين المشرق والمغرب ، فتسلم عليه قال : فيرد السلام ، ويسألها من أنت ؟ فتقول : أنا من المزيد ، وإنه ليكون عليها سبعون ثوبا أدناها مثل النعمان من طوبى فينفذها بصره حتى يرى مخ ساقها من وراء ذالك ، وإن عليها من التيجان وإن أدنى لؤلؤة منها لتضيء ما بين المشرق والمغرب ) )(@)(@@) ( حم ) واللفظ له ( ع حب ض ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7034 ) قال النبي :(@)(@@) | 30 ( إن الرجل ليتكلم بالكلمة من سخط الله لا يرى بها بأسا فيهوي بها في نار جهنم سبعين خريفا ) )(@)(@@) ( ت حم ن ه حب ك ض ) و ابن مطيع والباوردي وابن قانع عن بلال بن الحارث المزني ، حسن غريب ( خ حم ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7035 ) قال النبي :(@)(@@) | 30 ( إن الرجل إذا خرج يعود أخا له مؤمنا خاض في الرحمة إلى حقويه ، فإذا جلس عند المريض فاستوى جالسا غمرته الرحمة ) )(@)(@@) ( طب واللفظ عن أبي أمامة ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7036 ) قال النبي :(@)(@@) | 30 ( إن الرجل ليتكلم بالكلمة يضحك بها جلساءه يهوي PageV03P022 بها أبعد من الثريا ) )(@)(@@) ( ت حل ) عن أبي هريرة رضي الله عنه و ( ت ) عن بهز بن حكيم عن أبيه عن جده و ( حم ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7037 ) قال النبي :(@)(@@) | 30 ( إن الرجل ليتكلم بالكلمة ما يدري ما بلغت من رضوان 
ms769	 الله فيوجب الله له بها الجنة إلى يوم القيامة ، وإن الرجل ليتكلم بالكلمة ما يدري ما بلغت من سخط الله فيوجب الله له بها النار إلى يوم القيامة ) )(@)(@@) ( حل ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7038 ) قال النبي :(@)(@@) | 30 ( إن العبد ليشرف على حاجة من حاجات الدنيا فيذكره الله تعالى من فوق سبع سماوات فيقول : يا ملائكتي إن عبدي هاذا قد أشرف على حاجة من حوائج الدنيا فإن فتحتها له فتحت له بابا إلى النار ، ولاكن أزودها عنه ، فيصبح العبد عاضا أنامله يقول : من سعى بي ؟ من دهاني ؟ وما هي إلا رحمة رحمه الله بها ) )(@)(@@) عن ابن عباس رفعه ( حل ) عن ابن مسعود رضي الله عنهما موقوفا .(@)(@@)(@@)(@@) $ ( 7039 ) قال النبي :(@)(@@) | 30 ( إن الرجل ليدرك بالحلم درجة الصائم القائم ، وإنه ليكتب جبارا وما يملك إلا أهل بيته ) )(@)(@@) ( حل ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7040 ) قال النبي :(@)(@@) | 30 ( إن الرجل إذا سقى امرأته الماء أجر ) )(@)(@@) ( حم طب ) عن العرباض رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7041 ) قال النبي :(@)(@@) | 30 ( إن الرجل ليتكلم بالكلمة يضحك بها من حوله فيخوض بها أبعد من عكاظ وما يشعر ) )(@)(@@) ابن صصرى في أماليه عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7042 ) قال النبي :(@)(@@) | 30 ( إن الرجل ليسأل حتى يخلق وجهه ، فيلقى الله يوم يلقاه وليس له وجه ) )(@)(@@) ابن صصرى عن ابن عمر رضي الله عنهما .(@)(@@) PageV03P023(@)(@@)(@@)(@@) $ ( 7043 ) قال النبي :(@)(@@) | 30 ( إن الرجل ليعمل بعمل أهل الجنة وإنه لمكتوب في الكتاب من أهل النار ، فإذا كان قبل موته تحول فعمل بعمل أهل النار فمات فدخل النار ، وإن الرجل ليعمل بعمل أهل النار وإنه لمكتوب في الكتاب من أهل الجنة ، فإذا كان قبل موته تحول فعمل أهل الجنة فمات فدخلها ) )(@)(@@) ( حم ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 7044 ) قال النبي :(@)(@@) | 30 ( إن الرجل لتكون له الدرجة عند الله عز وجل فما يبلغها بعمله حتى يبتلى ببلاء في جسده فيبلغها بذالك البلاء ) )(@)(@@) ( هناد ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7045 ) قال النبي :(@)(@@) | 30 ( إن الرجل ليضع 
ms770	 طعامه فما يرفع حتى يغفر له ، يقول بسم الله إذا وضع طعامه ، وإذا فرغ قال : الحمد لله كثيرا ) )(@)(@@) ابن السني عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7046 ) قال النبي :(@)(@@) | 30 ( إن الرجل ليعمل عملا سرا فيكتبه الله عنده سرا ، فلا يزال به الشيطان حتى يتكلم به فيمحى من السر ويكتب علانية ، فإن عاد فتكلم الثانية محي من السر والعلانية وكتب رياء ) )(@)(@@) الديلمي عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7047 ) قال النبي :(@)(@@) | 30 ( إن الرجل ليجر إلى النار فتنزوي النار ويقبض بعضها إلى بعض فيقول لها الرحمان : ما لك ؟ فتقول : إنه كان يستجير مني ، فيقول الله تبارك وتعالى أرسلوا عبدي ) )(@)(@@) الديلمي عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7048 ) قال النبي :(@)(@@) | 30 ( إن الرجل ليفتض في الغداة سبعين عذراء ثم ينشئهن الله أبكارا ) )(@)(@@) الديلمي عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7049 ) قال النبي :(@)(@@) | 30 ( إن الرجل إذا كان يغتاب الرجل في الدنيا ، أتي به PageV03P024 يوم القيامة ميتا ، فيقول له : كما أكلت لحمه حيا فكله ميتا ، فإنه ليأكله وينضح ويكلح ) )(@)(@@) الخرائطي في مساوىء الأخلاق عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 7050 قال النبي :(@)(@@) | 30 ( إن الرجل يصيب من الربا أعظم عند الله في الخطيئة من ست وثلاثين زنية يزنيها الرجل ، وإن أربى الربا الإستطالة في عرض الرجل المسلم )(@)(@@) ) ( هب ) وضعفه عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ 7051 قال النبي :(@)(@@) | 30 ( إن الرجل إذا أدب الأمة فأحسن أدبها ثم أعتقها فتزوجها كان له أجران اثنان ، وإن من أهل الكتاب إذا آمن بكتابه ثم آمن بكتابنا فله أجران اثنان ، وإن الرجل إذا أدى حق الله وحق سيده كان له أجران اثنان )(@)(@@) ) ( عب ) عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ 7052 قال النبي :(@)(@@) | 30 ( إن الرحم شجنة آخذة بحجزة الرحمان تناشده حقها فيقول : أما ترضين أن أصل من وصلك وأقطع من قطعك ، ومن وصلك فقد وصلني ، ومن قطعك فقد قطعني )(@)(@@) ) ابن عساكر عن أم سلمة رضي الله عنها .(@)(@@)(@@)(@@) $ 7053 قال النبي :(@)(@@) | 30 ( إن الرحم لتعلق بالعرش يوم القيامة 
ms771	 فتقول : يا رب اقطع من قطعني ، وصل من وصلني )(@)(@@) ) ابن النجار عن أبي هدبة عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ 7054 قال النبي :(@)(@@) | 30 ( إن الرحم شجنة من الرحمان فإذا كان يوم القيامة تقول : أي رب إني ظلمت ، يا رب إني أسيء إلي ، يا رب أني قطعت فيجيبها ربها ، ألا ترضين أن أقطع من قطعك وأصل من وصلك )(@)(@@) ) ( حب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 7055 قال النبي :(@)(@@) | 30 ( إن الرزق ليطلب العبد كما يطلبه أجله )(@)(@@) ) ( حل ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ 7056 قال النبي :(@)(@@) | 30 ( إن الرفق يمن ، وإن الخرق شؤم وإن الله تعالى إذا PageV03P025 أراد بأهل خيرا أدخل عليهم باب الرفق وإن الرفق لم يكن في شيء إلا زانه ، وإن الخرق لم يكن في شيء إلا شانه )(@)(@@) ) الخرائطي في مكارم الأخلاق عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ 7057 قال النبي :(@)(@@) | 30 ( إن الركن والمقام من ياقوت الجنة ، ولولا ما مسهما من خطايا بني آدم لأضاءا ما بين المشرق والمغرب ، وما مسهما من ذي عاهة ولا سقيم إلا شفي )(@)(@@) ) ( هب هق ) عن ابن عمرو رضي الله عنهما .(@)(@@)(@@)(@@) $ 7058 قال النبي :(@)(@@) | 30 ( إن الروح إذا خرج تبعه البصر أما رأيتم إلى شخوص عينيه )(@)(@@) ) ابن سعد والحكيم عن أبي قلابة ( حم ه ) عن شداد بن أوس رضي الله عنهما .(@)(@@)(@@)(@@) $ 7059 قال النبي :(@)(@@) | 30 ( إن الروح إذا عرج به يشخص البصر )(@)(@@) ) الحكيم عن قبيصة بن ذؤيب مرسلا .(@)(@@)(@@)(@@) $ 7060 قال النبي :(@)(@@) | 30 ( إن الروح الأمين نفث في روعي أنها لا تموت نفس حتى تستوفي رزقها فأجملوا في الطلب )(@)(@@) ) العسكري في الأمثال عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ 7061 قال النبي :(@)(@@) | 30 ( إن الزمان قد استدار كهيئة يوم خلق الله السماوات والأرض : السنة اثنا عشر شهرا ، منها أربعة حرم ، ثلاثة متواليات : ذو القعدة ، وذو الحجة ، والمحرم ورجب الذي بين جمادى وشعبان ، أي شهر هاذا : قلنا : الله ورسوله أعلم ، قال : أليس ذا الحجة ؟ قلنا : بلى ، قال : أي بلد هاذا ؟ قلنا : الله ورسوله أعلم ، قال : أليس البلدة 
ms772	 الحرام ؟ قلنا : بلى ، قال : فأي يوم هذا ؟ قلنا : الله ورسوله أعلم ، قال : أليس يوم النحر ؟ قلنا : بلى ، قال : فإن دماءكم وأموالكم وأعراضكم عليكم حرام كحرمة يومكم هاذا ، في بلدكم هاذا ، في شهركم هاذا ، وستلقون ربكم فيسألكم عن أعمالكم ، ألا فلا ترجعوا بعدي ضلالا يضرب PageV03P026 بعضكم رقاب بعض ، ألا ليبلغ الشاهد الغائب ، فلعل بعض من يبلغه يكون أوعى له من بعض من سمعه ، ألا هل بلغت ؟ ألا هل بلغت )(@)(@@) ) ( خ م حم د ) عن أبي بكرة عن أبيه رضي الله عنهما .(@)(@@)(@@)(@@) $ 7062 قال النبي :(@)(@@) | 30 ( إن السالم من سلم الناس من لسانه ويده )(@)(@@) ) ( حم طب ) عن سهل بن معاذ عن أبيه .(@)(@@)(@@)(@@) $ 7063 قال النبي :(@)(@@) | 30 ( إن السامع المطيع لا حجة عليه ، وإن السامع العاصي لا حجة له )(@)(@@) ) ( حم طب كر ) عن معاوية رضي الله عنه .(@)(@@)(@@)(@@) $ 7064 قال النبي :(@)(@@) | 30 ( إن السلام اسم من أسماء الله وضعه في الأرض فافشوه فيكم ، فإن الرجل إذا سلم على القوم فردوا عليه كان له عليهم فضل درجة لأنه ذكرهم فإن لم يردوا عليه رد عليه من هو خير منهم وأطيب )(@)(@@) ) ( طب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ 7065 قال النبي :(@)(@@) | 30 ( إن الشديد ليس الذي يغلب الناس ، ولاكن الشديد من غلب نفسه )(@)(@@) ) ابن النجار عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 7066 قال النبي :(@)(@@) | 30 ( إن الشمس والقمر لا يخسفان لموت أحد ولا لحياته ، ولاكنهما آيتان من آيات الله فإذا رأيتموهما فصلوا )(@)(@@) ) ( حم ه ) عن عائشة و ( طب ) عن عقبة بن عامر و ( حم ) عن محمود بن لبيد ( حب ) عن ابن عمر رضي الله عنهم .(@)(@@)(@@)(@@) $ 7067 قال النبي :(@)(@@) | 30 ( إن الشمس والقمر لا ينكسفان لموت أحد ولا لحياته ، فإذا رأيتم شيئا من ذالك فصلوا حتى ينجلي أو يحدث الله أمرا )(@)(@@) ) ( حب ن ) عن أبي بكرة رضي الله عنه .(@)(@@) PageV03P027(@)(@@)(@@)(@@) $ 7068 قال النبي :(@)(@@) | 30 ( إن الشمس والقمر آيتان من آيات الله ، فإذا رأيتم ذالك فافزعوا إلى الصلاة )(@)(@@) ) عن بلال رضي الله عنه .(@)(@@)(@@)(@@) $ 7069 قال النبي :(@)(@@) | 30 ( إن الشمس 
ms773	 والقمر آيتان من آيات الله لا ينكسفان لموت أحد من الناس ، فإذا كان ذالك فصلوا حتى تنجلي )(@)(@@) ) ( ش ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 7070 قال النبي :(@)(@@) | 30 ( إن الشمس والقمر آيتان من آيات الله لا ينكسفان لموت أحد ولا لحياته ، فإذا رأيتم ذالك فافزعوا إلى الصلاة )(@)(@@) ) ( طب ) عن عقبة بن عامر ( حم ) ن محمود بن لبيد رضي الله عنهما .(@)(@@)(@@)(@@) $ 7071 قال النبي :(@)(@@) | 30 ( إن الشمس والقمر لا ينكسفان لموت أحد ولا لحياته ، ولاكنهما آيتان من آيات الله يخوف الله بهما عباده ، فإذا رأيتم ذالك فصلوا كأحدث صلاة مكتوبة صليتموها )(@)(@@) ) زر بن حبيش عن بلال ( حم ن ك ) عن قبيصة بن مخارق الهلالي رضي الله عنهما .(@)(@@)(@@)(@@) $ 7072 قال النبي :(@)(@@) | 30 ( إن الشمس والقمر آيتان من آيات الله ، ولا ينخسفان لموت أحد ولا لحياته ، فإذا رأيتم ذالك فادعوا الله وكبروا ، وصلوا وتصدقوا ، يا أمة محمد ، والله ما من أحد أغير من الله أن يزني عبده أو تزني أمته ، يا أمة محمد والله لو تعلمون ما أعلم لضحكتم قليلا ولبكيتم كثيرا ، اللهم هل بلغت )(@)(@@) ) مالك ( حم خ م د ن ) وابن جرير عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ 7073 قال النبي :(@)(@@) | 30 ( إن الشمس والقمر آيتان من آيات الله ، لا يخسفان لموت أحد ولا لحياته ، فإذا رأيتم ذالك فاذكروا الله ، إني رأيت الجنة فتناولت عنقودا ، ولو أصبته لأكلتم منه ما بقيت الدنيا ، أريت النار فلم أر منظرا كاليوم قط PageV03P028 أفظع ، ورأيت أكثر أهلها من النساء يكفرن ، قيل : أيكفرن بالله ؟ قال : يكفرن العشير ويكفرن الإحسان ، لو أحسنت إلى إحداهن الدهر كله ثم رأت منك شيئا قالت : ما رأيت منك خيرا قط )(@)(@@) ) ( حم خ م ن حب ) وعطاء بن يسار عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ 7074 قال النبي :(@)(@@) | 30 ( إن الشمس والقمر آيتان من آيات الله لا يخسفان لموت أحد ولا لحياته ، فإذا رأيتموهما فصلوا حتى يفرج الله عنكم ، رأيت في مقامي هاذا كل شيء وعدتم ، حتى لقد رأيتني أريد أن آخذ قطفا من 
ms774	 الجنة حين رأيتموني جعلت أقدم ، ولقد رأيت جهنم يحطم بعضها بعضا حين رأيتموني تأخرت ، ورأيت فيها عمرو بن لحي وهو الذي سيب السوائب )(@)(@@) ) ( م ن ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ 7075 قال النبي :(@)(@@) | 30 ( إن الشمس تطلع بين قرني شيطان )(@)(@@) ) ( حم ) وأبو نعيم عن محمد بن يعلى بن أمية عن أبيه .(@)(@@)(@@)(@@) $ 7076 قال النبي :(@)(@@) | 30 ( إن الشمس والقمر آيتان من آيات الله عز وجل ، فإذا رأيتم كسوف أحدهما فاسعوا إلى ذكر الله ، والذي نفس محمد بيده ، لقد أدنيت الجنة مني حتى لو بسطت يدي لتعاطيت من قطوفها ، ولقد أدنيت النار مني حتى جعلت أتقيها خشية أن تغشاكم ، حتى رأيت فيها امرأة من حمير سوداء طويلة تعذب في هرة ربطتها فلم تدعها تأكل من خشاش الأرض ، ولا هي أطعمتها ، ولا هي سقتها حتى ماتت ، فلقد رأيتها تنهشها إذا أقبلت وإذا ولت ، وحتى رأيت فيها صاحب السبتيين أخا بني الدعدع يدفع بعصا ذات شعبتين في النار وحتى رأيت فيها صاحب المحجن الذي كان يسرق الحاج بمحجنه ، فإذا علموا به قال : لست أنا أسرقكم إنما تعلق بمحجني متكئا على محجنه في النار يقول : أنا سارق المحجن )(@)(@@) PageV03P029 ) ( حم م ن ) وابن جرير عن ابن عمرو رضي الله عنهما .(@)(@@)(@@)(@@) $ 7077 قال النبي :(@)(@@) | 30 ( إن الشمس والقمر لا ينخسفان لموت أحد ولا لحياته ، ولاكنهما خلقان من خلق الله ، وإنه يحدث في خلقه ما شاء ، وإن الله عز وجل إذا تجلى لشيء من خلقه تخشع له ، فأيهما انخسف فصلوا حتى ينجلي أو يحدث الله أمرا )(@)(@@) ) ( ن ك ) عن النعمان بن بشير رضي الله عنهما .(@)(@@)(@@)(@@) $ 7078 قال النبي :(@)(@@) | 30 ( إن الشمس والقمر لا ينخسفان لموت أحد منكم ولا لشيء تحدثونه ، ولاكن ذالكم من آيات الله يعتبر بها عباده ، ويشكر من يخافه ومن يذكره ، فإذا رأيتم بعض آيات الله فافزعوا إلى الله فاذكروه واخشوه ، ما رأيتم من شيء في الدنيا له لون ، ولا نيئتم به في الجنة ولا في النار لقد صور لي في قبل هاذا الجدار منذ صليت 
ms775	 لكم صلاتي هاذه فنظرت إليه مصورا في جدار هاذا المسجد )(@)(@@) ) ( طب ) عن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ 7079 قال النبي :(@)(@@) | 30 ( إن الشمس لتدنو حتى يبلغ العرق نصف الأذن ، فبينما هم كذالك استغاثوا بآدم فيقول : لست صاحب ذالك ، ثم بموسى فيقول كذالك ، ثم بمحمد بين الخلق فيمشي حتى يأخذ بخلقة الجنة ، فيومئذ يبعثه الله مقاما محمودا )(@)(@@) ) ابن جرير عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ 7080 قال النبي :(@)(@@) | 30 ( إن الشهر لا يكمل ثلاثين ليلة )(@)(@@) ) ( طب ) عن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ 7081 قال النبي :(@)(@@) | 30 ( إن الشيطان كان يلقي علي شرر النار ليفتنني عن الصلاة فتناولته ، فلو أخذته ما انفلت مني حتى يناط إلى سارية من سواري المسجد ، ينظر إليه ولدان أهل المدينة )(@)(@@) ) عبد الرزاق ( حم طب ) والباوردي ( ض ) عن جابر بن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ 7082 قال النبي :(@)(@@) | 30 ( إن الشيطان أراد أن يمر بين يدي فخنقته حتى وجدت PageV03P030 برد لسانه على يدي ، وايم الله لولا ما سبق إليه أخي سليمان لارتبط إلى سارية من سواري المسجد حتى يطيف به ولدان أهل المدينة )(@)(@@) ) ( قط طب هق ) عن جابر بن سمرة رضي الله عنه . ( حم ) عن أبي سعيد الخدري و ( ن ) عن أبي الدرداء رضي الله عنهما .(@)(@@)(@@)(@@) $ 7083 قال النبي :(@)(@@) | 30 ( إن الشيطان قد أيس أن يعبد في جزيرة العرب )(@)(@@) ) ( م ت حم ) عن جابر و ( حم ) عن أبي هريرة ( طب ض ) عن عبادة بن الصامت رضي الله عنهم .(@)(@@)(@@)(@@) $ 7084 قال النبي :(@)(@@) | 30 ( إن الشيطان يأتي أحدم وهو في صلاته حتى يفتح مقعدته فيخيل إليه أنه أحدث ولم يحدث ، فإذا وجد أحدكم وهو في صلاته حتى يفتح مقعدته فيخيل إليه أنه أحدث ولم يحدث ، فإذا وجد أحدكم ذالك فلا ينصرف حتى يسمع صوت ذالك بأذنه ، أو يجد ريح ذالك بأنفه )(@)(@@) ) ( خ م ن حم ه ) عن عباد بن أبي تميم عن عمه عبد الله بن زيد و ( حم ) عن أبي هريرة ( طب ) عن ابن عباس رضي الله عنهم .(@)(@@)(@@)(@@) $ 7085 قال النبي :(@)(@@) | 30 
ms776	 ( إن الشيطان قد يئس أن يعبد بأرضكم ، ولاكن رضي أن يطاع فيما سوى ذالك مما تخافون من أعمالكم فاحذروا ، إني قد تركت فيكم ما إن اعتصمتم به فلن تضلوا أبدا : كتاب الله وسنة نبيه ، إن كل مسلم أخو المسلم ، المسلمون إخوة ، ولا يحل لامرىء من مال أخيه إلا ما أعطاه عن طيب نفس ، ولا تظلموا ولا ترجعوا بعدي كفارا يضرب بعضكم رقاب بعض )(@)(@@) ) ( ك ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ 7086 قال النبي :(@)(@@) | 30 ( إن الشيطان يأتي أحدكم فينقر عند عجانه ، فلا يخرجن حتى يسمع صوتا ، أو يجدع ريحا ، أو يفعل ذالك متعمدا )(@)(@@) ) ( هق ) عن ابن عباس رضي الله عنهما .(@)(@@) PageV03P031(@)(@@)(@@)(@@) $ 7087 قال النبي :(@)(@@) | 30 ( إن الشيطان قال : لن ينجو مني الغني من إحدى ثلاث : إما أن أزين ماله في عينيه فيمنعه من حقه ، وإما أن أسهل سبله فينفقه في غير حقه ، وإما أن أحببه إليه فيكسبه بغير حقه )(@)(@@) ) ابن المبارك عن أبي سلمة بن عبد الرحمن بن عوف مرسلا .(@)(@@)(@@)(@@) $ 7088 قال النبي :(@)(@@) | 30 ( إن الشيطان يجري من ابن آدم مجرى الدم في العرق )(@)(@@) ) ( خ م د حم ) عن علي بن حسين و ( د حم ) عن أنس و ( حم ) عن جابر ومحمد بن عثمان الإذرعي في كتاب الوسوسة عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 7089 قال النبي :(@)(@@) | 30 ( إن الشيطان يفرق من عمر بن الخطاب )(@)(@@) ) ( حم ) عن عبد الله بن بريدة عن أبيه ( ك ) عن عائشة رضي الله عنهما .(@)(@@)(@@)(@@) $ 7090 قال النبي :(@)(@@) | 30 ( إن الشيطان قد أيس أن يعبد في جزيرة العرب ، ولاكن خفت أن يضل من يبقى منهم بالنجوم )(@)(@@) ) ( طب ) عن العباس بن عبد المطلب رضي الله عنه .(@)(@@)(@@)(@@) $ 7091 قال النبي :(@)(@@) | 30 ( إن الشيطان قد أيس أن تعبد الأصنام في جزيرة العرب )(@)(@@) ) ( طب ) عن عبادة بن الصامت وأبي الددراء رضي الله عنهما .(@)(@@)(@@)(@@) $ 7092 قال النبي :(@)(@@) | 30 ( إن الشيطان قد أيس أن يعبد بأرضكم هاذه ، ولاكن رضي منكم بما تحقرون )(@)(@@) ) ( حم حل ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 7093 قال النبي 
ms777	 :(@)(@@) | 30 ( إن الشيطان قد أيس أن يعبد بأرضي هاذه ولاكن قد رضي بالمحقرات من أعمالكم )(@)(@@) ) ( طب ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ 7094 قال النبي :(@)(@@) | 30 ( إن الشيطان لا يستطيع أن يتشبه بي ، فمن رآني في PageV03P032 النوم فقد رآني )(@)(@@) ) ( ش ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ 7095 قال النبي :(@)(@@) | 30 ( إن الصائم إذا أكل عنهده صلت عليه الملائكة حتى يفرغوا )(@)(@@) ) ( حب ) عن أم عمارة بنت كعب رضي الله عنها(@)(@@)(@@)(@@) $ ( 7096 ) قال النبي & : إن الصائم إذا لم يدع قول الزور والعمل به والجهل فليس لله حاجة في أن يدع طعامه وشرابه ' ( حب د ) عن أبي هريرة و ( ت ه ) عن أم عمارة رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7097 ) قال النبي & : إن الصحة والفراغ نعمتان من نعم الله تعالى مغبون فيهما كثير من الناس ' ( حم خ ت ه ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7098 ) قال النبي & : إن الصدقة صداع في الرأس وحريق في البطن ' ( ش حم ) والباوردي ( طب ) عن حبان بن بج الصدائي رضي الله عنه .(@)(@@)(@@)(@@) $ 7099 قال النبي :(@)(@@) | 30 ( إن الصدقة لا تحل لغني ولا لذي مرة سوي إلا لذي فقر مدقع أو غرم مقطع ، ومن سأل الناس ليثري به ماله كان خموشا في وجهه يوم القيامة ورضفا يأكله من جهنم ، فمن شاء فليقل ، ومن شاء فليستكثر )(@)(@@) ) البغوي والباوردي وابن قانع ( طب ) عن حبشي بن جنادة رضي الله عنه .(@)(@@)(@@)(@@) $ 7100 قال النبي :(@)(@@) | 30 ( إن الصدقة لا تحل لنا )(@)(@@) ) الشيرازي في الألقاب عن عبد الله بن عيسى بن عبد الرحمن بن أبي ليلى عن أبيه عن جده عن أبي ليلى رضي الله عنه .(@)(@@)(@@)(@@) $ 7101 قال النبي :(@)(@@) | 30 ( إن الصدقة لا تحل لي ولا لأهل بيتي ، وإن مولى القوم من أنفسهم )(@)(@@) ) ( طب ) عن مولى رسول الله يقال له طهمان أو ذكوان رضي الله عنه .(@)(@@) PageV03P033(@)(@@)(@@)(@@) $ 7102 قال النبي :(@)(@@) | 30 ( إن الصدقة لا تحل لي ولا لأهل بيتي ، لعن الله من ادعى إلى غير أبيه ، واعن الله من تولى غير مواليه ، الولد لصاحب الفراش وللعاهر الحجر ، إن 
ms778	 الله قد أعطى كل ذي حق حقه ، ليس لوارث وصية )(@)(@@) ) ( طب ) عن البراء وزيد بن أرقم ( حم ) عن عمرو بن خارجة رضي الله عنه .(@)(@@)(@@)(@@) $ 7103 قال النبي :(@)(@@) | 30 ( إن الصدقة لا تحل لمحمد ولا لآل محمد )(@)(@@) ) الخطيب عن بهز بن حكيم عن أبيه عن جده .(@)(@@)(@@)(@@) $ 7104 قال النبي :(@)(@@) | 30 ( إن الصدقة على ذي قرابة تضاعف مرتين في الأجر )(@)(@@) ) ( طب ) عن زينب امرأة عبد الله رضي الله عنه .(@)(@@)(@@)(@@) $ 7105 قال النبي :(@)(@@) | 30 ( إن الصراط بين أظهر جهنم دحض مزلقة والأنبياء يقولون رب سلم والناس عليه كالبرق وكطرفة العين وكأجاويد الخيل والركاب وشدا على الأقدام ، فناج مسلم ، ومخدوش مرسل ومطروح فيها ولها سبعة أبواب لكل باب منهم جزء مقسوم )(@)(@@) ) الرامهرمزي في الأمثال عن أبي هريرة رضي الله عنه . وأخرجه ( خ م ) مطولا عن أبي سعيد الخدري رضي الله عنه .(@)(@@)(@@)(@@) $ 7106 قال النبي :(@)(@@) | 30 ( إن الصيام ليس من الأكل والشرب فقط ، إنما الصيام من اللغو والرفث ، فإن سابك أحد أو جهل عليك فقل : إني صائم )(@)(@@) ) ( حب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 7107 قال النبي :(@)(@@) | 30 ( إن الصلاة لا يصلح فيها شيء من كلام الناس ، إنما هو تسبيح وتكبير وتهليل وقراءة القرآن )(@)(@@) ) عبد الرزاق عن زيد بن أسلم مرسلا .(@)(@@)(@@)(@@) $ 7108 قال النبي :(@)(@@) | 30 ( إن الطاعون رحمة ربكم ، ودعوة نبيكم ، وموت الصالحين قبلكم ، وهو شهادة )(@)(@@) ) الشيرازي في الألقاب عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ 7109 قال النبي :(@)(@@) | 30 ( إن الصف الأول لعلى مثل صف الملائكة ولو تعلمون لابتدرتموه )(@)(@@) ) ( ش ) عن أبي رضي الله عنه .(@)(@@) PageV03P034(@)(@@)(@@)(@@) $ 7110 قال النبي :(@)(@@) | 30 ( إن الظروف لا تحل شيئا ولا تحرمه ، وكل مسكر حرام ، وليس أن تجلسوا فتشربوا حتى إذا ثملت العروق تفاخرتم ، فوثب الرجل على ابن عمه فضربه بالسيف ، فتركه أعج )(@)(@@) ) ( ع ) والبغوي ( حب ) وابن السني وأبو نعيم معا في الطب عن الأشج البصري ( حم ) عن بريدة رضي الله عنه .(@)(@@)(@@)(@@) $ 7111 قال النبي :(@)(@@) | 30 ( إن العامل على الصدقة بالحق كالغازي في سبيل الله حتى يرجع إلى بيته )(@)(@@) ) ( طب ) عن رافع 
ms779	 بن خديج رضي الله عنه .(@)(@@)(@@)(@@) $ 7112 قال النبي :(@)(@@) | 30 ( إن العباس مني وأنا منه )(@)(@@) ) ابن سعد عن ابن عباس ( ط حمم د ) وابن منيع والروياني وهناد بن السري في الزهد وابن خزيمة وأبو عوانة وابن مندة في كتاب الإيمان ( ك هب ) وصححه ( ض ) عن البراء ، قال أبو عوانة : هاذا حديث اختلف أهل العلم في صحته ، وقال ابن منده : إسناده متصل مشهور وهو ثابت على رسم الجماعة .(@)(@@)(@@)(@@) $ 7113 قال النبي :(@)(@@) | 30 ( إن العبد إذا بلغ أربعين سنة وهو العمر أمنه الله من الخصال الثلاث : من الجنون والجذام والبرص ، فإذا بلغ خمسين سنة وهو الدهر خفف الله عنه الحساب ، فإذا بلغ ستين سنة وهو في إدبار من قوته رزقه الله الإنابة إليه فيما يحب ، فإذا بلغ سبعين سنة وهو الحقب أحبه أهل السماء ، فإذا بلغ ثمانين سنة وهو الهرم كتب الله حسناته وتجاوز عن سيئاته ، فإذا بلغ تسعين وهو الفناء وقد ذهب العقل غفر الله ما تقدم من ذنبه وما تأخر ، وشفع في أهل بيته وسماه أهل السماء أسير الله ، فإذا بلغ مائة سنة سمي حبيس الله في الأرض وحق على الله أن لا يعذب حبيسه في الأرض )(@)(@@) ) الحكيم عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 7114 قال النبي :(@)(@@) | 30 ( إن العبد ليقول : يا رب اغفر لي وقد أذنب ، فتقول الملائكة : يا رب إنه ليس ذالك بأهل قال الله تبارك وتعالى : لاكني أهل بأن أغفر له )(@)(@@) ) الحكيم عن أنس رضي الله عنه .(@)(@@) PageV03P035(@)(@@)(@@)(@@) $ 7115 قال النبي :(@)(@@) | 30 ( إن العبد ليلتمس مرضاة الله فلا يزال كذالك فيقول الله عز وجل : يا جبريل إن عبدي فلانا يلتمس أن يرضيني ، ألا وإن رحمتي عليه ، فيقول جبريل : رحمة الله على فلان ، ويقولها حملة العرش ويقولها من حولهم حتى يقولها أهل السماوات السبع ، ثم يهبط إلى الأرض )(@)(@@) ) ( حم طس ض ) عن ثوبان رضي الله عنه .(@)(@@)(@@)(@@) $ 7116 قال النبي :(@)(@@) | 30 ( إن البد لا يزال من الله والله منه ما لم يخدم فإذا خدم وجب عليه الحساب )(@)(@@) ) ( ص هق ) وابن عساكر 
ms780	 عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ 7117 قال النبي :(@)(@@) | 30 ( إن العبد ليعمل عمل أهل الجنة فيما يرى الناس وإنه لمن أهل النار ، وإنه ليعمل عمل أهل النار فيما يرى الناس وإنه لمن أهل الجنة ، وإنما الأعمال بالخواتيم ، وفي لفظ : بخواتيمها )(@)(@@) ) ( حم خ طب حب قط ) في الأفراد عن سهل بن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ 7118 قال النبي :(@)(@@) | 30 ( إن العبد المسلم إذا توضأ فأتم وضوءه ثم دخل في صلاته فأتم صلاته خرج من صلاته كما يخرج من بطن أمه من الذنوب )(@)(@@) ) ابن عسكر عن عثمان رضي الله عنه .(@)(@@)(@@)(@@) $ 7119 قال النبي :(@)(@@) | 30 ( إن العبد تقبض روحه في منامه فلا يدري أترد إليه أم لا ؟ فيكون قد قضى وتره خير له ، ومن صام ثلاثا من الشهر فقد صام الدهر لأن الحسنة بعشر أمثالها ، ويصبح العبد وعلى كل سلامى منه زكاة ، قيل : يا رسول الله وما السلامى ؟ قال : رأس كل عظم من جسده ، فإذا صلى ركعتين بأربع سجدات فقد أدى ما على جسده من زكاة )(@)(@@) ) ابن عساكر عن أبي الدرداء قال : أمرني رسول الله أن لا أنام إلا على وتر ، وأمرني بصيام ثلاثة أيام من الشهر ، وأمرني بأربع سجدات بعد ارتفاع الشمس للضحى ثم فسرهن لي قال : فكره .(@)(@@)(@@)(@@) $ ( 7120 ) قال النبي :(@)(@@) | 30 ( إن العبد إذا توضأ فغسل يديه خرت خطاياه من PageV03P036 يديه ، فإذا مضمض واستنثر خرجت خطاياه من ذراعيه ورأسه ، فإذا غسل رجليه خرت خطاياه من رجليه ، فإذا قام إلى الصلاة وكان هواه وقلبه ووجهه أو كله إلى الله انصرف كما ولدته أمه )(@)(@@) ) ( ه طب ك ) عن عمرو بن عبسة رضي الله عنه .(@)(@@)(@@)(@@) $ 7121 قال النبي :(@)(@@) | 30 ( إن العبد ليعالج كرب الموت وسكرات الموت ، وإن مفاصله ليسلم بعضها على بعض تقول عليك السلام تفارقني ، وأفارقك إلى يوم القيامة )(@)(@@) ) القشيري في الرسالة عن إبراهيم بن هدية عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ 7122 قال النبي :(@)(@@) | 30 ( إن العبد المؤمن إذا قام في الصلاة وضعت ذنوبه على رأسه فتفرق عنه كما تفرق عذوق النخلة 