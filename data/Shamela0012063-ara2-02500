ms2483	 " بن أوس الخزاعي.(@)(@@)(@@)(@@) | 3472 - (@)(@@) " عبد الله " بن بارق وهو عبدويه.(@)(@@)(@@)(@@) | 3473 - (@)(@@) " عبد الله " بن بديل بن وقار الخزاعي المكي.(@)(@@)(@@)(@@) | 3474 - (@)(@@) " عبد الله " بن بحير3 بن ريسان المرادي أبو وائل الصنعاني القاص.(@)(@@)(@@)(@@) | 3475 - (@)(@@) " عبد الله " بن بريدة بن الحصيب الأسلمي أبو سهل قاضي مرو عن أبيه وعنه ابناه سهل وصخر.(@)(@@)(@@)(@@) | 3476 - (@)(@@) " عبد الله " بن بسر السكسكي الحبراني4 أبو سعيد الحمصي سكن البصرة.(@)(@@)(@@)(@@) | 3477 - (@)(@@) " عبد الله " بن بسر بن التيهان5 اليربوعي مولاهم الرقي الكوفي قاضي الرقة. PageV07P258(@)(@@)(@@)(@@) | 3478 - (@)(@@) " عبد الله " بن بشر الخثعمي أبو عمير1 الكاتب الكوفي.(@)(@@)(@@)(@@) | 3479 - (@)(@@) " عبد الله " بن أبي بصيرة2 العبدي الكوفي.(@)(@@)(@@)(@@) | 3480 - (@)(@@) " عبد الله " بن أبي بكر بن زيد بن المهاجر المدني.(@)(@@)(@@)(@@) | 3481 - (@)(@@) " عبد الله " بن أبي بكر بن عبد الرحمن بن الحارث بن هشام المخزومي المدني عن أبيه وعنه الزهري.(@)(@@)(@@)(@@) | 3482 - (@)(@@) " عبد الله " بن أبي بلال الخزاعي الشامي عنه خالد بن معدان.(@)(@@)(@@)(@@) | 3483 - (@)(@@) " عبد الله " بن ثابت المروزي أبو جعفر النحوي.(@)(@@)(@@)(@@) | 3484 - (@)(@@) " عبد الله " بن ثعلبة الحضرمي المصري عنه عبد الرحمن بن شريح.(@)(@@)(@@)(@@) | 3485 - (@)(@@) " عبد الله " بن جرهد الأسلمي ويقال: ابن مسلم بن جرهد عن أبيه.(@)(@@)(@@)(@@) | 3486 - (@)(@@) " عبد الله " بن أبي الجعد الأشجعي عن ثوبان.(@)(@@)(@@)(@@) | 3487 - (@)(@@) " عبد الله " بن جعفر بن نجيح السعدي مولاهم أبو جعفر المدني والد علي بن المديني نزيل البصرة عنه ابنه علي بن المديني.(@)(@@)(@@)(@@) | 3488 - (@)(@@) " عبد الله " بن جعفر بن غيلان الأموي مولاهم الرقي أبو عبد الرحمن القرشي.(@)(@@)(@@)(@@) | 3489 - (@)(@@) " عبد الله " بن جعفر بن عبد الرحمن بن المسور بن مخرمة المخرمي3 أبو محمد المدني عن عمة أبيه أم بكر.(@)(@@)(@@)(@@) | 3490 - (@)(@@) " عبد الله " بن أبي جعفر الرازي عن أبيه وعنه ابنه محمد.(@)(@@)(@@)(@@) | 3491 - (@)(@@) " عبد الله " بن الجهم الرازي أبو عبد الرحمن.(@)(@@)(@@)(@@) | 3492 - (@)(@@) " عبد الله " بن حاجب بن عامر بن المنتفق بن أخي لقيط بن عامر العقيلي PageV07P259(@)(@@) بالضم عن عمه لقيط وعنه ابنه الأسود.(@)(@@)(@@)(@@) | 3493 - (@)(@@) " عبد الله " بن الحارث الأزدي أو الكندي المصري عنه حرملة بن عمران.(@)(@@)(@@)(@@) | 3494 - (@)(@@) " عبد الله " بن حبيب بن أبي ثابت الأسدي 
ms2484	 الكوفي وثق وقال أبو حاتم: لا يحتج به عن أبيه وسعيد بن جبير وطاوس.(@)(@@)(@@)(@@) | 3495 - (@)(@@) " عبد الله " بن الحسين الأزدي البصري أبو حريز1 قاضي سجستان.(@)(@@)(@@)(@@) | 3496 - (@)(@@) " عبد الله " بن الحسين بن عطاء بن يسار الهلالي المدني مولى ميمونة زوج النبي صلى الله عليه وآله وسلم.(@)(@@)(@@)(@@) | 3497 - (@)(@@) " عبد الله " بن خالد بن سعيد بن أبي مريم المدني أبو شاكر التيمي مولاهم عن أبيه وعنه يحيى بن محمد الجاري.(@)(@@)(@@)(@@) | 3498 - (@)(@@) " عبد الله " بن خباب2 بن الأرت المدني حليف بني زهرة عن أبيه.(@)(@@)(@@)(@@) | 3499 - (@)(@@) " عبد الله " بن خراش3 بن حوشب الشيباني أبو جعفر الكوفي عن عمه العوام بن حوشب.(@)(@@)(@@)(@@) | 3500 - (@)(@@) " عبد الله " بن خليفة الهمداني الكوفي عن عمر وجابر وعنه أبو إسحاق لا يكاد يعرف وثقه بن حبان وروى عنه أيضا يونس بن أبي إسحاق.(@)(@@)(@@)(@@) | 3501 - (@)(@@) " عبد الله " بن الخليل أو بن أبي الخليل الحضرمي أبو الخليل الكوفي عن علي.(@)(@@)(@@)(@@) | 3502 - (@)(@@) " عبد الله " بن داود الواسطي أبو محمد التمار عن ابن جريج والليث.(@)(@@)(@@)(@@) | 3503 - (@)(@@) " عبد الله " بن دكين الكوفي أبو عمر4 الكوفي نزيل بغداد عن جعفر بن محمد الصادق وعنه يزيد بن هارون قال ابن معين ليس بشيء. PageV07P260(@)(@@)(@@)(@@) | 3504 - (@)(@@) " عبد الله " بن دينار العدوي مولاهم أبو عبد الرحمن المدني مولى بن عمر مجمع على ثقته.(@)(@@)(@@)(@@) | 3505 - (@)(@@) " عبد الله " بن دينار البهراني1 الأسدي أبو محمد الحمصي الشامي.(@)(@@)(@@)(@@) | 3506 - (@)(@@) " عبد الله " بن ذكوان الأموي مولاهم الإمام القرشي أبو عبد الرحمن المدني المعروف بابي الزناد كان أحد الأئمة عن أنس وابن عمر رضى الله عنهما.(@)(@@)(@@)(@@) | 3507 - (@)(@@) " عبد الله " بن أبي صالح ذكوان السمان2 المدني عن أبيه.(@)(@@)(@@)(@@) | 3508 - (@)(@@) " عبد الله " بن راشد الحميري أبو الضحاك الزوفي3 المصري.(@)(@@)(@@)(@@) | 3509 - (@)(@@) " عبد الله " بن رجاء البصري أبو عمران نزيل مكة المكي عنه أحمد وإسحاق.(@)(@@)(@@)(@@) | 3510 - (@)(@@) " عبد الله " بن رجاء بن عمر الغداني4 أبو عمرو والبصري عن عكرمة بن عمار.(@)(@@)(@@)(@@) | 3511 - (@)(@@) " عبد الله " بن رجاء بن صبح الحمصي الشامي