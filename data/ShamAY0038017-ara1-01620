ms1601	 بن طلحة بن عبيد الله التيمي القرشي(@)(@@) يروي عن أجداده، روى عنه ابنه عبد الله بن محمد.(@)(@@)(@@)(@@) ||| AUTO محمد بن نعيم(@)(@@) مولى آل عمر بن الخطاب، يروي عن محمد بن عمر بن علي، روى عنه أبو عقيل.(@)(@@)(@@)(@@) ||| AUTO أبو سفيان المعمري، اسمه محمد بن حميد الحميري(@)(@@) يروي عن معمر ومالك، روى عنه العراقيون شريح بن يونس وغيره، مات يوم الأربعاء لسبع بقين من شعبان سنة اثنتين ومائتين، وإنما قيل له: المعمري، لأنه رحل إلى معمر.(@)PageV01P002(@)(@@) [ج 5: ص 417](@)(@@)(@@)(@@) ||| AUTO محمد بن الصامت(@)(@@) كوفي، يروي عن عبد الله بن عمر بن علي، روى عنه سيف بن عمر الأموي.(@)(@@)(@@)(@@) ||| AUTO محمد بن يحيى بن قيس الماربي، أبو عمرو(@)(@@) يروي عن أبيه، روى عنه قتيبة بن سعيد.(@)(@@)(@@)(@@) ||| AUTO محمد بن يزيد بن صيفي بن صهيب بن سنان الخير الجدعاني(@)(@@) من أهل المدينة، يروي عن أجداده، روى عنه ابنه يوسف بن محمد.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO محمد بن يعقوب بن المغيرة بن الأخنس الثقفي(@)(@@) كان ممن يخشى الله ويتقيه، يروي عن عبد الله بن عكرمة بن عبد الرحمن، روى عنه يعقوب بن محمد الزهري.(@)(@@)(@@)(@@) ||| AUTO محمد بن يزيد الحارثي(@)(@@) يروي عن مجمع بن عتاب الشقري، روى عنه زيد بن حباب.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الله البصري(@)(@@) يروي عن أيوب بن أبي تميمة السختياني، روى عنه محمد بن يزيد بن سنان.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الرحمن بن عمرو الأوزاعي(@)(@@) يروي عن أبيه، روى عنه بقية بن الوليد.(@)(@@) (662) -[5: 417] حدثني محمد بن المعافى العابد، وعمر بن محمد، قالا: ثنا عمرو بن عثمان، ثنا بقية، عن ابن الأوزاعي، عن أبيه، في الطير الميتة يوجد في جوفها الحيتان، قال: لا بأس بأكلها، وفي البعير يأكل القمح فيموت فيخرج القمح من جوفه، قال: يغسل ويؤكل(@)(@@) (663) -[5: 417] حدثنا مكحول، ثنا يزيد بن عبد الصمد، ثنا أبو مسهر، حدثني محمد بن الأوزاعي، قال: قال لي أبي: يا بني لو قبلنا من الناس كل ما يعرضون علينا لأوشك أن نهون عليهم.(@)(@@) محمد بن يعقوب(@)(@@) شيخ، يروي عن 
ms1602	 يحيى بن أبي كثير، روى عنه عنبسة بن عبد الواحد.(@)PageV01P002(@)(@@) [ج 5: ص 418](@)(@@)(@@)(@@) ||| AUTO محمد بن أبي عبيدة بن معن بن عبد الرحمن بن عبد الله بن مسعود الهذلي(@)(@@) من أهل الكوفة، يروي عن وكيع وأبيه، روى عنه ابن أبي شيبة وأهل العراق، مات سنة خمس ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن زياد بن مروان اليشكري(@)(@@) صاحب سنة وفضل، من أهل نجار، يروي عن عثمان بن عبد الرحمن الوقاصي، عن الزهري بنسخة، روى عنه جعفر بن داود الربعي النجاري، وليس هذا بمحمد بن زياد اليشكري الجزري ذاك واه.(@)(@@)(@@)(@@) ||| AUTO محمد بن عمر بن كيسان بن أبي يزيد الصنعاني(@)(@@) يروي عن أبيه، روى عنه عبد الله بن إبراهيم بن عمر بن كيسان.(@)(@@)(@@)(@@) ||| AUTO محمد بن يزيد العطار(@)(@@) من أهل الكوفة، يروي عن شيخ عن أبيه عن علي أنه توضأ فنزع خاتمه، روى عنه وكيع بن الجراح.(@)(@@)(@@)(@@) ||| AUTO محمد بن يزيد الكلابي(@)(@@) وقد قيل كلاعي، من أهل واسط، كنيته أبو سعيد، يروي عن العوام بن حوشب وسفيان بن حسين، مات سنة تسعين ومائة وقد قيل: سنة تسع وثمانين ومائة، روى عنه أحمد بن حنبل وأهل العراق.(@)(@@)(@@)(@@) ||| AUTO محمد بن خثيم بن عراك بن مالك الغفاري(@)(@@) يروي عن أبيه عن جده عن أبي هريرة، روى عنه خالد بن مخلد القطواني.(@)(@@)(@@)(@@) ||| AUTO محمد بن أبي مروان(@)(@@) يروي عن أبيه عن سالم، روى عنه يعقوب بن محمد الزهري.(@)(@@)(@@)(@@) ||| AUTO محمد بن أبي بكر المقرئ(@)(@@) من أهل الكوفة، يروي عن صدقة بن أبي PageV01P002 [ج 5: ص 419] عمران.(@)(@@) (664) -[5: 419] ثنا إبراهيم بن نصر العنبري بكمشاكث، ثنا عبد الله بن عبد الرحمن السمرقندي، ثنا محمد بن أبي بكر، ثنا صدقة بن أبي عمران، عن علقمة بن مرثد، عن زاذان أبي عمر، عن البراء، قال: سمعت رسول الله صلى الله عليه وسلم يقول: حسنوا القرآن بأصواتكم فإن الصوت الحسن يزيد القرآن حسنا(@)(@@)(@@)(@@) ||| AUTO محمد بن إسماعيل الضبي(@)(@@) ختن أبي المعلى العطار، من أهل البصرة، يروي عن أبي المعلى العطار عن سعيد بن جبير، روى 
ms1603	 عنه علي بن حميد الباهلي.(@)(@@)(@@)(@@) ||| AUTO محمد بن سليم البلخي(@)(@@) الذي يقال له: الخراساني جليس ابن عيينة، أصله من مصر، يروي عن الضحاك بن مزاحم، روى عنه قتيبة بن سعيد.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الرحمن بن يحنس(@)(@@) يروي عن أبي سفيان الأخنسي، روى عنه ابن أبي فديك.(@)(@@)(@@)(@@) ||| AUTO محمد بن ميمون(@)(@@) يروي عن بلال مؤذن مسجد دمشق، روى عنه ضمرة بن ربيعة.(@)(@@)(@@)(@@) ||| AUTO محمد بن حنظلة بن محمد بن عباد بن جعفر المخزومي القرشي(@)(@@) يروي عن معروف بن مشكان، روى عنه إبراهيم بن محمد الشافعي.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الملك، أبو إسماعيل الواسطي(@)(@@) يروي عن الحسن بن عبيد الله ويحيى بن أبي كثير، روى عنه بقية بن وهب بن بقية، يعتبر حديثه إذا بين السماع في خبره في روايته، فإنه كان مدلسا يخطئ.(@)(@@)(@@)(@@) ||| AUTO محمد بن إسحاق العدني(@)(@@) يروي عن سعيد بن زياد عن جابر بن زيد، روى عنه أبو عاصم النبيل.(@)PageV01P002(@)(@@) [ج 5: ص 420](@)(@@)(@@)(@@) ||| AUTO محمد بن أبي بكر(@)(@@) يروي عن أيوب السختياني، روى عنه البصريون.(@)(@@)(@@)(@@) ||| AUTO محمد بن ميمون السمان(@)(@@) يروي عن أمه ميمونة بنت أم سرحان، روى عنه مسلم بن إبراهيم الأموي.(@)(@@)(@@)(@@) ||| AUTO محمد بن حمزة الأسدي(@)(@@) من أهل الكوفة، يروي عن جعفر بن برقان، روى عنه سعيد بن يحيى الأموي.(@)(@@)(@@)(@@) ||| AUTO محمد بن حرب الأبرش، أبو عبد الله الخولاني الحمصي(@)(@@) مولى لقريش، يروي عن الزبيدي ومالك، روى عنه عمرو بن عثمان وأهل الشام، مات سنة اثنتين وتسعين ومائة، وكان البحيري يحكي عن عمرو بن عثمان أنه مات سنة أربع وتسعين ومائة.(@)(@@)(@@)(@@) ||| AUTO محمد بن جعفر غندر(@)(@@) صاحب الكرابيس، كنيته أبو عبد الله الهذلي صاحب الطيالسة، من أهل البصرة، يروي عن شعبة ومعمر، روى عنه أحمد بن محمد بن حنبل ويحيى وأهل العراق، وكان من خيار عباد الله ومن أصحهم كتابا على غفلة فيه، مات في ذي القعدة يوم الجمعة سنة ثلاث وتسعين ومائة في النصف منه، وكان ابن امرأة شعبة، وقيل: إنه سمع حميد الطويل، وكان مولى 
ms1604	 هذيل.(@)(@@)(@@)(@@) ||| AUTO محمد بن شعيب بن شابور القرشي(@)(@@) مولى بني أمية، من أهل الشام، يروي عن الأوزاعي وعثمان بن أبي العاتكة، روى عنه هشام بن عمار وأهل الشام، PageV01P002 [ج 5: ص 421] ولد سنة ست عشرة ومائة، ومات سنة مائتين، وقد قيل: سنة ثمان وتسعين ومائة.(@)(@@)(@@)(@@) ||| AUTO محمد بن عقبة الشيباني(@)(@@) أخو الوليد بن عقبة، يروي عن أبي إسحاق الفزاري، كنيته أبو عبد الله عن عمران القصير، روى عنه قتيبة بن سعيد.(@)(@@)(@@)(@@) ||| AUTO محمد بن عثمان البصري(@)(@@) يروي عن سليمان بن موسى، روى عنه ابن عياش.(@)(@@)(@@)(@@) ||| AUTO محمد بن سهل الأسدي(@)(@@) يروي عن ورقاء بن عمر، روى عنه الكسائي صاحب القراءات.(@)(@@)(@@)(@@) ||| AUTO محمد بن أبي شبابة(@)(@@) من أهل البصرة، يروي عن عباس بن الأشعث عن الحسن، روى عنه محمد بن عقبة.(@)(@@)(@@)(@@) ||| AUTO محمد بن عمرو بن مقسم الصنعاني(@)(@@) يروي عن عطاء بن مسلم وأهل اليمن، روى عنه أهل بلده والغرباء.(@)(@@) (665) -[5: 421] حدثنا أبو خليفة، ثنا علي بن المديني، ثنا محمد بن عمرو بن مقسم، قال: سمعت عطاء بن مسلم، يقول: سمعت وهب بن منبه، يقول: إن الله كلم موسى في ألف مقام، وكان إذا كلمه رئي النور على وجه موسى ثلاثة أيام، قال: فلم يمس موسى امرأة بعدما كلمه ربه.(@)(@@)(@@)(@@) ||| AUTO محمد بن سلمة الحراني(@)(@@) يروي عن هشام بن حسان، روى عنه أهل الجزيرة، مات سنة ثنتين وتسعين ومائة.(@)PageV01P002(@)(@@) [ج 5: ص 422](@)(@@)(@@)(@@) ||| AUTO محمد بن أبي أكيزة، أبو أيوب(@)(@@) من أهل البصرة، يروي عن أيوب السختياني وأشعث الحداني، روى عنه بشر بن الحكم.(@)(@@)(@@)(@@) ||| AUTO محمد بن منيب، أبو الحسن(@)(@@) يروي عن السري بن يحيى، روى عنه أحمد بن سعيد الدارمي.(@)(@@)(@@)(@@) ||| AUTO محمد بن شرحبيل بن جعشم اليماني(@)(@@) يروي عن ابن جريج، روى عنه رجاء بن مرجى المروزي وأهل اليمن، مستقيم الحديث.(@)(@@)(@@)(@@) ||| AUTO محمد بن سليمان الأصبهاني(@)(@@) شيخ، من أهل الكوفة، يروي عن سهيل بن أبي صالح، روى عنه فروة بن أبي المغراء الكندي، يخالف ويخطئ.(@)(@@)(@@)(@@) ||| AUTO محمد بن العلاء الصهيبي(@)(@@) يروي عن جعفر بن 
ms1605	 محمد، روى عنه عبد الله بن الحارث المخزومي.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الله الأعشى القارئ(@)(@@) من أهل المدينة، يروي عن عبد الرحمن بن محمد، روى عنه إبراهيم بن حمزة الزبيري.(@)(@@)(@@)(@@) ||| AUTO محمد بن ميمون بن عجلان الربعي التميمي(@)(@@) من أهل البصرة، يروي عن أبيه، روى عنه محمد بن عقبة السدوسي.(@)(@@)(@@)(@@) ||| AUTO محمد بن صالح بن عمر بن نافع، أبو عبد الله(@)(@@) مولى آل جعونة، حليف آل العباس بن عبد المطلب لقبه مكيس، يروي عن أبيه، روى عنه بشر بن عنبس بن مرحوم العطار.(@)(@@)(@@)(@@) ||| AUTO محمد بن موسى بن أبي عبد الله(@)(@@) مولى الفطريين، من أهل PageV01P002 [ج 5: ص 423] المدينة، وقد قيل مخزومي، يروي عن سعد بن إسحاق، روى عنه الدراوردي وعبد الرحمن بن مهدي.(@)(@@)(@@)(@@) ||| AUTO محمد بن سليمان العيذي(@)(@@) يروي عن هارون بن سعد الأعور، روى عنه إسحاق بن منصور السلولي.(@)(@@)(@@)(@@) ||| AUTO محمد بن أبي بكر، أبو غاضرة(@)(@@) يروي عن غضبان بن حنظلة، روى عنه موسى بن إسماعيل التبوذكي.(@)(@@)(@@)(@@) ||| AUTO محمد بن طلحة بن عبد الرحمن بن طلحة بن عبيد الله بن عثمان بن عمرو بن كعب بن سعد بن تيم بن مرة، أبو عبد الله التيمي القرشي، الذي يقال له: ابن الطويل(@)(@@) من أهل المدينة، يروي عن أبي سهل بن مالك، روى عنه ابن أبي أويس، ربما أخطأ.(@)(@@)(@@)(@@) ||| AUTO محمد بن عباس بن عثمان بن شافع الشافعي(@)(@@) يروي عن أبيه والحجازيين المقاطيع، روى عنه ابنه إبراهيم بن محمد الشافعي، وهو عم الشافعي.(@)(@@)(@@)(@@) ||| AUTO محمد بن مخلد الحضرمي(@)(@@) يروي عن محمد بن عبد الرحمن بن الفارة، روى عنه حيوة بن شريح.(@)(@@)(@@)(@@) ||| AUTO محمد بن عيينة، أبو عبد الرحمن الفزاري(@)(@@) ختن أبي إسحاق الفزاري، يروي عن أبي إسحاق الفزاري، روى عنه أبو عبيد القاسم بن سلام ومحمد بن إسماعيل البخاري.(@)(@@) (666) -[5: 423] حدثنا مكحول، ثنا يوسف بن سعد بن مسلم، عن محمد بن عيينة، قال: حضرت ابن المبارك جاء إلى أبي إسحاق الفزاري فسلم عليه فأجلسه معه على الوسادة ساعة، ثم صعد الفزاري منزله 
ms1606	 ثم نزل، فما كان إلا ساعة حتى نزلت الجارية بقصعة من عصيدة فوضعها بينه وبين ابن المبارك، قال: فقال الفزاري: كل يا أبا عبد الرحمن، قال: يا أبا إسحاق أنا صائم، فقال له الفزاري: جاء إبراهيم بن أدهم فجلس مجلسك هذا وصنعت به كما صنعت بك فأكل، فلما أن فرغنا، قال: يا أبا إسحاق أما إني كنت صائما ولكن أحببت أن أشترك فأكل، قال: فمد ابن المبارك يده فأكل.(@)PageV01P002(@)(@@) [ج 5: ص 424](@)(@@)(@@)(@@) ||| AUTO محمد بن مسلمة بن هشام بن إسماعيل، أبو هشام المخزومي(@)(@@) من أهل المدينة، يروي عن مالك بن أنس، روى عنه هارون بن عبد الله الحمال والناس، وكان ممن يتفقه على مذهب مالك ويتفرع على أصوله ممن صنف وجمع.(@)(@@)(@@)(@@) ||| AUTO محمد بن حبيب بن أبي حبيب(@)(@@) يروي عن أبيه، روى عنه ابنه عبد الرحمن من قبل خالد بن عبد الله الجعد بن درهم.(@)(@@)(@@)(@@) ||| AUTO محمد بن عاصم الحذاء(@)(@@) من أهل البصرة، يروي عن الحوشب عن الحسن، روى عنه أبو داود الطيالسي.(@)(@@)(@@)(@@) ||| AUTO محمد بن صالح البطيخي، أبو إسماعيل(@)(@@) من أهل واسط، سكن بغداد، يروي عن عبد الرحمن بن إسحاق عن الزهري، روى عنه أهل العراق.(@)(@@)(@@)(@@) ||| AUTO محمد بن خالد بن عثمة(@)(@@) من أهل البصرة، يروي عن مالك والناس، روى عنه بندار وأهل البصرة، يغرب.(@)(@@)(@@)(@@) ||| AUTO محمد بن مسلم بن أبي الوضاح(@)(@@) يروي عن زكريا بن أبي زائدة، روى عنه منصور بن أبي مزاحم، مستقيم الحديث.(@)(@@)(@@)(@@) ||| AUTO محمد بن مطير(@)(@@) يروي عن أبيه، روت عنه ابنته أمة الرحمن بنت محمد بن مطير.(@)(@@)(@@)(@@) ||| AUTO محمد بن أبي شملة(@)(@@) يروي عن المنكدر بن محمد بن المنكدر، روى عنه يعقوب بن محمد الزهري.(@)(@@)(@@)(@@) ||| AUTO محمد بن جعفر المدائني، أبو جعفر(@)(@@) يروي عن ورقاء بن عمر، روى عنه ابنه جعفر بن محمد، مات سنة ست ومائتين.(@)PageV01P002(@)(@@) [ج 5: ص 425](@)(@@)(@@)(@@) ||| AUTO محمد بن عبد المجيد المدني(@)(@@) يروي عن حمزة بن محمد بن حمزة الأسلمي عن أبيه، روى الأويسي عن عبد الله بن محمد عنه.(@)(@@)(@@)(@@) ||| AUTO محمد 
ms1607	 بن المغيرة، أبو علي القرشي(@)(@@) بياع السابري، مولى آل عثمان بن عفان، من أهل البصرة، يروي عن الحوشب عن الحسن، روى عنه موسى بن إسماعيل.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الملك بن عبد العزيز بن جريج(@)(@@) مولى قريش، عداده في أهل الحجاز، يروي عن أبيه، روى عنه روح بن عبادة.(@)(@@)(@@)(@@) ||| AUTO محمد بن الحارث، أبو عبد الله الحارثي(@)(@@) من أهل البصرة، يروي عن عبد الرحمن بن أبي الزناد وأهل الحجاز، روى عنه زيد بن الحباب.(@)(@@)(@@)(@@) ||| AUTO محمد بن سويد(@)(@@) شيخ.(@)(@@) (667) -[5: 425] يروي، عن حوشب، عن الحسن، قال: طيب الرجال ماله ريح وليس له لون، وطيب النساء ماله لون وليس له ريح، حدثناه محمد بن إسحاق الثقفي، ثنا قتيبة بن سعيد، ثنا محمد بن سويد(@)(@@)(@@)(@@) ||| AUTO محمد بن الحسن(@)(@@) شيخ، يروي عن محمد بن إسحاق، روى عنه أبو أويس المدني، لست أدري من أي بلد هو.(@)(@@)(@@)(@@) ||| AUTO محمد بن يوسف الفريابي، أبو عبد الله(@)(@@) سكن قيسارية بالشام، يروي عن الأوزاعي والثوري، روى عنه عبد الله بن عبد الرحمن ومحمد بن PageV01P002 [ج 5: ص 426] إسماعيل البخاري، مات سنة ثنتي عشرة ومائتين، وكان مولده سنة ست وعشرين ومائة، وكان من خيار عباد الله.(@)(@@)(@@)(@@) ||| AUTO محمد بن ثور اليماني(@)(@@) يروي عن معمر وكان صواما قواما، روى عنه محمد بن عبيد بن حساب، مات سنة تسعين ومائة أو قبلها أو بعد بقليل.(@)(@@)(@@)(@@) ||| AUTO محمد بن حبان الأنماطي(@)(@@) كوفي، شيخ.(@)(@@) (668) -[5: 426] يروي عن عبد الله بن نافع، عن ابن عمر، قال: سئل ابن عمر عن الصلاة في السفر، فقال: ركعتين، من خالف السنة فقد كفر، حدثناه ابن زهير، ثنا الحسن بن عرفة، ثنا محمد بن فضل، عن محمد بن حبان، عن عبيد الله بن عمر وهو الذي روى عن ابن شبرمة(@)(@@)(@@)(@@) ||| AUTO أبو أحمد الزبيري، اسمه: محمد بن عبد الله بن الزبير الأسدي(@)(@@) من أهل الكوفة، يروي عن الثوري وإسرائيل، روى عنه أحمد بن حنبل وأهل العراق، مات سنة ثلاث ومائتين بالأهواز.(@)(@@)(@@)(@@) ||| AUTO أبو وهب، اسمه: محمد بن مزاحم المروزي 
ms1608	(@)(@@) مولى بني عامر أخو سهل بن مزاحم، يروي عن ابن المبارك وزفر بن الهذيل، روى عنه إسحاق بن إبراهيم الحنظلي وأهل بلده، مات سنة تسع ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن محرز الضبي(@)(@@) يروي عن عبد الله بن الحسن العنبري، روى عنه حامد بن عمر البكراوي.(@)(@@)(@@)(@@) ||| AUTO محمد بن إبراهيم بن خبيب بن سليمان بن سمرة بن جندب الفزاري(@)(@@) يروي عن جعفر بن سعد بن سمرة، عن خبيب بن سليمان بن سمرة، عن أبيه، عن سمرة الكتاب الطويل، روى عنه مروان بن جعفر، لا يعتبر بما انفرد به من الإسناد.(@)(@@)(@@)(@@) ||| AUTO محمد بن خالد المخزومي(@)(@@) يروي عن الثوري، روى عنه يعقوب بن حميد بن كاسب، ربما رفع وأسند.(@)PageV01P002(@)(@@) [ج 5: ص 427](@)(@@)(@@)(@@) ||| AUTO محمد بن الضحاك بن عثمان الحزامي(@)(@@) من أهل المدينة، يروي عن أبيه ومالك، روى عنه إبراهيم بن المنذر الحزامي وأهل المدينة.(@)(@@)(@@)(@@) ||| AUTO محمد بن معن بن محمد بن معن بن نضلة الغفاري(@)(@@) من أهل المدينة، كنيته أبو يونس، يروي عن جده محمد بن معن، روى عنه علي بن المديني، مات وهو ابن بضع وستين سنة وموته قريب من موت ابن عيينة.(@)(@@)(@@)(@@) ||| AUTO محمد بن عثمان بن عطاء الخراساني(@)(@@) (669) -[5: 427] يروي عن أبيه، قال: سمعت أبي، عن جدي، عن أبي هريرة، قال: قال رسول الله صلى الله عليه وسلم: الكفر قبل المشرق. حدثنا محمد بن الحسن بن قتيبة، ثنا صفوان بن صالح الثقفي، ثنا محمد بن عثمان بن عطاء(@)(@@)(@@)(@@) ||| AUTO محمد بن المعمر بن سليمان التيمي(@)(@@) يروي عن أبيه.(@)(@@) (670) -[5: 427] حدثنا محمد بن المنذر، ثنا أبو الدرداء عبد العزيز بن منيب، ثنا إسماعيل بن مسلمة بن ضب أبو بسر محمد بن المعمر بن سليمان، قال: قلت لأبي من فقيه العرب؟ قال: سفيان الثوري، فلما مات، قلت: من فقيه العرب يا أبة؟ قال: عبد الله بن المبارك.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الوهاب بن عبد المجيد الثقفي(@)(@@) من أهل البصرة، يروي عن ابن عون وأبيه، روى عنه الشاذكوني وغيره.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الواحد بن أبي 
ms1609	 حزم القطعي(@)(@@) ابن أخي حزم، من أهل البصرة، يروي عن عمرو بن عامر عن قتادة، روى عنه عبيد الله بن عمر القواريري.(@)(@@)(@@)(@@) ||| AUTO أبو لبيد السرخسي، اسمه: محمد بن عتاب(@)(@@) يروي عن مالك بن أنس ومهدي بن ميمون، روى عنه أهل بلده، قتله الترك بشومان مجاهدا، سنة تسع ومائة وهو ابن ثمان وأربعين سنة، وكان من الحفاظ المتقنين ممن أظهر السنة في بلده ودعاهم إليها دهرا، إلا أن المنية فاجأته فلم يظهر له كثير علم.(@)(@@) (671) -[5: 427] سمعت محمد بن عبد الرحمن الدغولي، يقول: سمعت محمد بن داود بن دينار، يقول: سمعت أبا قدامة عبيد الله بن سعد، يقول: تعلمت السنة من أبي لبيد، مات بعد المائتين.(@)PageV01P002(@)(@@) [ج 5: ص 428](@)(@@)(@@)(@@) ||| AUTO محمد بن بلال الكندي، أبو عبد الله(@)(@@) من أهل البصرة، يروي عن همام، روى عنه محمد بن إسماعيل البخاري والبصريون.(@)(@@)(@@)(@@) ||| AUTO محمد بن بكار بن هلال العاملي(@)(@@) قاضي دمشق، يروي عن سعيد بن بشير، روى عنه ابنه هارون بن محمد بن بكار، مات منصرفا من الحج سنة ست عشرة ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن سابق، أبو جعفر البغدادي(@)(@@) مولى بني تميم، أصله من فارس، سكن الكوفة، ثم انتقل إلى بغداد، يروي عن عيسى بن دينار وأهل العراق، روى عنه العراقيون، مات سنة أربع عشرة ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن جهضم، أبو عبد الله الثقفي(@)(@@) يروي عن إسماعيل بن جعفر، روى عنه العباس بن عبد العظيم العنبري.(@)(@@)(@@)(@@) ||| AUTO محمد بن يزيد بن خنيس المخزومي، أبو عبد الله المكي(@)(@@) يروي عن الثوري ووهيب بن الورد، روى عنه قتيبة بن سعيد والناس وكان من خيار الناس، ربما أخطأ، يجب أن يعتبر حديثه إذا بين السماع في خبره ولم يرو عنه إلا ثقة، فأما عبد الله بن مسيب فعنده عنه عجائب كثيرة لا اعتبار بها، مات بعد المائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن معبد(@)(@@) شيخ، يروي عن عمر بن عبد العزيز، روى عنه نوح بن قيس الطاحي.(@)PageV01P002(@)(@@) [ج 5: ص 429](@)(@@)(@@)(@@) ||| AUTO محمد بن إسماعيل السكوني(@)(@@) يروي عن فطر بن خليفة والكوفيين، 
ms1610	 روى عنه محمد بن يحيى الذهلي.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد العزيز التيمي، أبو سعيد الكوفي(@)(@@) يروي عن المغيرة بن مقسم، روى عنه أحمد بن يونس.(@)(@@)(@@)(@@) ||| AUTO محمد بن يعقوب(@)(@@) يروي عن يحيى بن أبي كثير، روى عنه عنبسة بن عبد الواحد.(@)(@@)(@@)(@@) ||| AUTO محمد بن سعيد بن سابق الرازي، أبو سعيد(@)(@@) يروي عن عمرو بن أبي قيس عن سماك، روى عنه محمد بن مسلم بن وارة وأهل بلده.(@)(@@)(@@)(@@) ||| AUTO محمد بن حفص بن عائشة التيمي(@)(@@) يروي عن عمه عبيد الله بن عمر بن موسى القرشي، روى عنه ابنه عبيد الله.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الكبير بن شعيب بن الحبحاب المعولي الأزدي، أبو عبد الله(@)(@@) يروي عن عمه عبد السلام بن شعيب، روى عنه ابنه عبد القدوس بن محمد، مات سنة ست ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن حبيب بن سليمان، أبو عبد الله المكي(@)(@@) يروي عن مالك بن أنس، روى عنه عبد بن حميد، مات سنة عشر ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن إبراهيم بن المطلب بن السائب بن أبي وداعة السهمي(@)(@@) خال إبراهيم بن المنذر الخزاعي، يروي عن أبيه عن جده، روى عنه إبراهيم بن المنذر الحزامي.(@)(@@)(@@)(@@) ||| AUTO محمد بن عمرو بن أبي رزين(@)(@@) يروي عن عمران بن حدير، روى عنه PageV01P002 [ج 5: ص 430] الحكم بن المبارك الخاشتي، إن لم يكن وهما، لأني خائف أنه عمرو بن محمد بن أبي رزين فوهم الحكم فيه.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الله بن عبد الرحمن بن القاسم بن محمد بن أبي بكر الصديق(@)(@@) من أهل المدينة، يروي عن أبيه، روى عنه إبراهيم بن المنذر الحزامي وأهل الحجاز، مستقيم الحديث.(@)(@@)(@@)(@@) ||| AUTO محمد بن سعيد الأصبهاني، أبو جعفر الكوفي، الذي يقال له: حمدان(@)(@@) يروي عن ابن المبارك وشريك، روى عنه ابن أبي شيبة وأهل العراق، مات سنة عشرين ومائتين أو قبلها أو بعدها بقليل.(@)(@@)(@@)(@@) ||| AUTO محمد بن الحسن السلولي(@)(@@) كوفي، يروي عن صالح بن أبي الأسود، روى عنه الكوفيون.(@)(@@)(@@)(@@) ||| AUTO محمد بن زياد(@)(@@) مولى أم مكتوم، من أهل المدينة، يروي 
ms1611	 عن سهل بن أبي صالح، روى عنه أبو سعيد مولى بني هاشم.(@)(@@)(@@)(@@) ||| AUTO محمد بن حميد البكري، أبو عبد الرحمن(@)(@@) من أهل الكوفة، يروي عن فطر بن خليفة، روى عنه يعقوب بن سفيان.(@)(@@)(@@)(@@) ||| AUTO محمد بن الطفيل النخعي(@)(@@) من أهل الكوفة، يروي عن شريك وعبد السلام بن حرب، روى عنه الكوفيون.(@)(@@)(@@)(@@) ||| AUTO محمد بن سلام بن عبد الله بن عقيل بن خالد الأيلي(@)(@@) يروي عن يونس بن يزيد الأيلي، روى عنه أبو بكر محمد بن يزيد الأسلمي المستملي الطرطوسي.(@)(@@)(@@)(@@) ||| AUTO محمد بن سعيد الخزاعي، أبو بكر(@)(@@) يروي عن زياد بن الربيع ويحيى بن واضح، روى عنه أهل الري.(@)PageV01P002(@)(@@) [ج 5: ص 431](@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الملك، أبو جابر الأزدي(@)(@@) من أهل البصرة، أصله من واسط، يروي عن ابن عون وهشام بن حسان، سكن مكة، روى عنه أبو حاتم السجستاني وأهل العراق، مات سنة إحدى عشرة ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن الجنيد، أبو عبد الله الكوفي(@)(@@) يروي عن وكيع بن الجراح وعبد الله بن عبد الملك، روى عنه الكوفيون.(@)(@@)(@@)(@@) ||| AUTO محمد بن المهلب الكوفي(@)(@@) يروي عن منصور بن أبي الأسود وأهل العراق، روى عنه العباس بن إسماعيل العريق.(@)(@@)(@@)(@@) ||| AUTO محمد بن موسى بن أعين الجزري، كنيته أبو يحيى(@)(@@) يروي عن أبيه، روى عنه محمد بن يحيى بن كثير الحراني وأهل بلده، مات سنة ثلاث وعشرين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن عيسى بن الطباع، أبو جعفر(@)(@@) أخو إسحاق بن عيسى، من أهل بغداد، سكن الثغر بطرسوس، يروي عن هشيم، روى عنه جعفر بن محمد الأذني وأهل الثغر، وكان من أعلم الناس بحديث هشيم، كان يحيى وعبد الرحمن يسألانه عن حديث هشيم، مات سنة أربع وعشرين ومائتين بالثغر، وكان أصغر سنا من أخيه إسحاق بن عيسى.(@)(@@)(@@)(@@) ||| AUTO محمد بن عميرة النخعي(@)(@@) من أهل الكوفة، يروي عن شريك، روى عنه يحيى بن سليمان الجعفي.(@)(@@)(@@)(@@) ||| AUTO محمد بن أعين، أبو الوزير(@)(@@) من أهل مرو، وصى ابن المبارك، يروي عن ابن المبارك، روى عنه المراوزة الحكايات.(@)(@@) (672) -[5: 431] سمعت بدر بن 
ms1612	 الحسين، يقول: سمعت أحمد بن سعيد الدارمي، يقول: سمعت محمد بن أعين، يقول: مررت بالنضر بن محمد PageV01P002 [ج 5: ص 432] فسمعته، يقول: من زعم أن هذه الآية مخلوقة {إنني أنا الله لا إله إلا أنا فاعبدني} فهو كافر، فأتيت ابن المبارك، فقلت: يا أبا عبد الرحمن! أما تسمع إلى ما يقول أبو محمد؟ فأخبرته، فقال: وهل تجد منه بدا، من قال إنه مخلوق فهو كافر.(@)(@@)(@@)(@@) ||| AUTO محمد بن مروان العجلي(@)(@@) (673) -[5: 432] يروي عن عمارة بن أبي حفصة، قال: دخلت على عمر بن عبد العزيز في مرضه وعليه قميص قد اتسخ وتخرق جيبه، فدخل عليه مسلمة بن عبد الملك، فقال لأخته فاطمة بنت عبد الملك وهى امرأة عمر بن عبد العزيز: ناوليني قميصا سوى هذا حتى نلبسه أمير المؤمنين فإن الناس يدخلون عليه، فقالت: دعنا عنك يا مسلمة فما أصبح ولا أمسى لأمير المؤمنين ثوب غير الذي ترى عليه. حدثنا ابن قتيبة، ثنا ابن أبي السري، ثنا محمد بن مروان العجلي، ثنا عمارة بن أبي حفصة(@)(@@)(@@)(@@) ||| AUTO محمد بن أبي عبيدة بن مجاعة بن الزبير العتكي(@)(@@) من أهل الأهواز، يروي عن أبيه، روى عنه عبد الله بن محمد بن أبي سلام البزار وأهل الأهواز.(@)(@@)(@@)(@@) ||| AUTO محمد بن خالد الوهبي الكندي(@)(@@) من أهل حمص، أخو أحمد بن خالد، يروي عن محمد بن عمرو بن علقمة، روى عنه يحيى بن صالح الوحاظي وإسحاق بن إبراهيم الحنظلي، مات قبل التسعين والمائة.(@)(@@)(@@)(@@) ||| AUTO محمد بن عروة الرواسي(@)(@@) كوفي، يروي عن عبد الرحمن بن حميد، روى عنه عبد الله بن المبارك.(@)(@@)(@@)(@@) ||| AUTO محمد بن إسماعيل بن عبد الرحمن الجعفي(@)(@@) كوفي، يروي عن أبيه، روى عنه علي بن الحسن الحضرمي.(@)(@@)(@@)(@@) ||| AUTO محمد بن عمرو بن أبي حفص العطار(@)(@@) كوفي، يروي عن أبان بن تغلب، روى عنه الكوفيون.(@)(@@)(@@)(@@) ||| AUTO محمد بن خالد بن يزيد اللؤلؤي العتكي، أبو عبد الله البصري(@)(@@) يروي عن أبيه، روى عنه أهل البصرة.(@)PageV01P002(@)(@@) [ج 5: ص 433](@)(@@)(@@)(@@) ||| AUTO محمد بن عمرو بن إبراهيم القرشي من آل جبير بن 
ms1613	 مطعم(@)(@@) يروي عن أم عثمان بنت سعيد، روى عنه البخاري محمد بن إسماعيل.(@)(@@)(@@)(@@) ||| AUTO محمد بن صدقة، أبو عبد الله الفدكي(@)(@@) وفدك بالقرب من المدينة، يروي عن مالك بن أنس، روى عنه إبراهيم بن المنذر الحزامي، يعتبر حديثه إذا بين السماع في روايته فإنه كان يسمع من قوم ضعفاء عن مالك ثم يدلس عنهم.(@)(@@)(@@)(@@) ||| AUTO محمد بن صبيح البغدادي(@)(@@) يروي عن خطاب بن القاسم، روى عنه أحمد بن حنبل.(@)(@@)(@@)(@@) ||| AUTO محمد بن خالد بن عثمة(@)(@@) مولى محمد بن سليمان الهاشمي وعثمة أمه، يروي عن مالك بن أنس وموسى بن يعقوب الزمعي، روى عنه أبو موسى محمد بن المثنى وأهل العراق، ربما أخطأ.(@)(@@)(@@)(@@) ||| AUTO محمد بن سكين، أبو جعفر الكوفي(@)(@@) مولى بني سعد، كان مؤذنا في بني ضبة، يروي عن وكيع وعبد الله بن بكير الغنوي، روى عنه أهل العراق.(@)(@@)(@@)(@@) ||| AUTO محمد بن الحسين البخاري(@)(@@) يروي عن وكيع والغنجار، روى عنه ابناه إبراهيم وعمر، يعتبر حديثه إذا بين السماع في روايته.(@)(@@)(@@)(@@) ||| AUTO محمد بن عباد بن زكريا بن أبي زائدة(@)(@@) يروي عن ابن أبي زائدة ويحيى بن زكريا والكوفيين، روى عنه أبو كريب.(@)(@@)(@@)(@@) ||| AUTO محمد بن سعد السبحي(@)(@@) يروي عن ابن لهيعة.(@)(@@) (674) -[5: 433] حدثني أسامة بن زيد، عن عطاء بن أبي رباح، قال: كنا نقدم أبا الزبير على جار بن عبد الله لأنه كان أحفظنا، يعني أنه كان يثبت بعضهم بعضا، قال محمد بن سعد: فذكرته لوكيع فاستحسن ذلك حدثنا ابن قتيبة، ثنا صفوان بن صالح، ثنا محمد بن سعد السبحي، ثنا ابن لهيعة.(@)PageV01P002(@)(@@) [ج 5: ص 434](@)(@@)(@@)(@@) ||| AUTO محمد بن مسروق الكندي(@)(@@) من أهل الكوفة، كان على قضاء مصر، يروي عن أبيه والكوفيين، روى عنه سعيد بن أبي مريم.(@)(@@)(@@)(@@) ||| AUTO محمد بن أسعد، أبو سعيد الثعلبي(@)(@@) يروي عن شريك وأبي إسحاق الفزاري، روى عنه أبو موسى الزمن، عداده في أهل الكوفة، يقال له أيضا: محمد بن سعيد.(@)(@@)(@@)(@@) ||| AUTO أبو سفيان المعمري، اسمه محمد بن حميد(@)(@@) عن معمر ومالك، روى عنه شريح بن يونس 
ms1614	 وأهل العراق.(@)(@@)(@@)(@@) ||| AUTO محمد بن عرعرة بن البرند القرشي السامي(@)(@@) من أهل البصرة، يروي عن شعبة، روى عنه ابنه إبراهيم بن محمد بن عرعرة وأهل العراق، مات في شوال بالبصرة سنة ثلاث عشرة ومائتين وله خمس وسبعون سنة، كنيته أبو عمرو.(@)(@@)(@@)(@@) ||| AUTO محمد بن الحسن بن آتش(@)(@@) من أهل اليمن، يروي عن النعمان بن الزبير، روى عنه محمد بن رافع.(@)(@@)(@@)(@@) ||| AUTO محمد بن معاذ بن عبد الحميد الدمشقي(@)(@@) يروي عن سعيد بن عبد العزيز، روى عنه أهل بلده، مات في النصف من شعبان سنة خمس عشرة ومائتين.(@)PageV01P002(@)(@@) [ج 5: ص 435](@)(@@)(@@)(@@) ||| AUTO محمد بن سليمان بن عطاء بن أبي داود الحراني(@)(@@) يروي عن: أبيه ومالك وسعيد بن بشير، روى عنه سليمان بن شعيب وأهل الجزيرة، مات سنة ثلاث عشرة ومائتين، ولقبه بومة، يعتبر حديثه من غير روايته عن أبيه.(@)(@@)(@@)(@@) ||| AUTO محمد بن حميد بن أبي الأسود(@)(@@) من أهل البصرة، يروي عن ابن عون، روى عنه أبو بكر بن أبي الأسود.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الله بن إدريس بن يزيد الأودي(@)(@@) يروي عن أبيه، روى عنه العراقيون.(@)(@@) (675) -[5: 435] سمعت محمد بن إسحاق الثقفي، يقول: سمعت حجاج الشاعر، يقول: كان محمد بن عبد الله بن إدريس كتب رقعة وعلقها من عنقه عاهد الله محمد ألا يرى منكرا إلا غيره.(@)(@@)(@@)(@@) ||| AUTO محمد بن عيينة(@)(@@) شيخ، يروي عن ابن المبارك، روى عنه عبد الله بن عبد الله بن عبد الرحمن السمرقندي بأكثر عنه.(@)(@@)(@@)(@@) ||| AUTO محمد بن كثير المصيصي، كنيته أبو يوسف(@)(@@) أصله من اليمن، انتقل إلى المصيصة وسكنها، يروي عن الأوزاعي، روى عنه أهل الثغر والغرباء، يخطئ ويغرب، مات بالمصيصة.(@)(@@)(@@)(@@) ||| AUTO محمد بن عامر الطائي العابد(@)(@@) يروي عن العراقيين.(@)(@@) (676) -[5: 435] حدثني عبد الكبير بن عمر الخطابي بالبصرة، ثنا علي بن حرب الموصلي، ثنا محمد بن عامر الطائي، قال: رأيت كأني واقف على درج مسجد دمشق في جماعة من الناس، فخرج شيخ ملبب شيخا يقول: أيها الناس إن هذا غير دين محمد صلى الله عليه وسلم فقلت لرجل إلى 
ms1615	 جنبي: من هذان الشيخان؟ قال: هذا أبو بكر ملبب أبا حنيفة.(@)(@@)(@@)(@@) ||| AUTO محمد بن إسحاق المروزي أبو زهير(@)(@@) سكن العراق، يروي عن وكيع والأشجعي، روى عنه أبو بكر الأعين وأهل العراق.(@)PageV01P002(@)(@@) [ج 5: ص 436](@)(@@)(@@)(@@) ||| AUTO محمد بن المبارك الصوري(@)(@@) من أهل الشام، يروي عن ابن المبارك، روى عنه محمد بن عوف وأهل الشام، كان مولده سنة ثلاث وخمسين ومائة، ومات سنة خمس عشرة ومائتين، وصلى عليه أبو مسهر، وكان من العباد.(@)(@@)(@@)(@@) ||| AUTO محمد بن عقبة الشيباني(@)(@@) من أهل البصرة، يروي عن ابن عدي والبصريين، روى عنه محمد بن إسماعيل البخاري، مات سنة خمس عشرة ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن عمر بن عبد الله بن الرومي(@)(@@) من أهل البصرة، كنيته أبو عبد الله، يروي عن شعبة وزهير بن معاوية، روى عنه أبو موسى الزمن وأهل العراق، وهو مولى لآل رباح بن عبيدة.(@)(@@)(@@)(@@) ||| AUTO محمد بن حفص بن عمرو بن موسى(@)(@@) من أهل البصرة، يروي عن عمه عبيد الله بن عمرو بن موسى عن ربيعة بن أبي عبد الرحمن، روى عنه ابنه عبيد الله بن محمد بن حفص بن عائشة العبسي.(@)(@@)(@@)(@@) ||| AUTO محمد بن النصر الحارثي(@)(@@) من عباد أهل الكوفة وقرائهم والحافظين ألسنتهم في أحوالهم وأوقاتهم، ما له حديث مسند يرجع إليه، إنما له الحكايات في الرقائق، وكان صديقا للثوري وفضيل بن عياض، روى عنه أهلها.(@)(@@)(@@)(@@) ||| AUTO محمد بن زيد بن أبي أسامة الرقي(@)(@@) يروي عن ابن عيينة وأبيه، روى عنه أحمد بن العلاء الباهلي وأهل بلده، ربما خالف، واسم أبي أسامة علي بن زيد بن الأصم ابن أخي زيد بن الأصم، ويقال: محمد بن زيد بن علي بن زيد بن دينار، مولى النخع، كنيته أبو جعفر، مات آخر ليلة من شهر رجب سنة أربع وثلاثين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الله البينوني، أبو عبد الله(@)(@@) شيخ، كان ببغداد، يروي عن ابن المبارك بن فضالة، روى عنه الحسن بن الصباح.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الرحمن بن أبي الموالي(@)(@@) مولى علي بن أبي طالب، يروي 
ms1616	 عن PageV01P002 [ج 5: ص 437] أبيه، روى عنه عبد العزيز بن عبد الله الأويسي.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الرحمن السهمي الباهلي(@)(@@) من أهل البصرة، يروي عن حصين بن نمير، روى عنه نصر بن علي الجهضمي، مات سنة سبع وثمانين ومائة.(@)(@@)(@@)(@@) ||| AUTO محمد بن حمزة الرقي(@)(@@) يروي عن الخليل بن مرة، روى عنه سعيد بن يحيى بن سعيد الأموي، يعتبر حديثه إذا روى عنه غير الخليل بن مرة لأنه ضعيف.(@)(@@)(@@)(@@) ||| AUTO محمد بن حيان، أبو الأحوص البغوي(@)(@@) سكن ببغداد، يروي عن مالك وهشيم، روى عنه أحمد بن منيع والعراقيون، مات سنة سبع وعشرين ومائتين.(@)(@@) (677) -[5: 437] سمعت محمد بن إسحاق الثقفي، يقول: سمعت عبد الله بن أحمد بن حنبل، يقول: حدثني أبو الفضل الخراساني وهو حاتم بن الليث، ثنا محمد بن حيان، قال: سأل رجل هشيما عن مسألة فأجاب فيها، فقال الرجل: إن أبا حنيفة ومحمد بن الحسن وأصحابه، يقول: كذا وكذا، فقال هشيم يا عبد الله إن العلم لا يؤخذ من السفل.(@)(@@)(@@)(@@) ||| AUTO محمد بن أمية، أبو أحمد الساوي(@)(@@) من أهل ساوة، مولى عقبة بن أبي معيط، يروي عن وكيع وغنجار، روى عنه الحسن بن عيسى البسطامي وأهل بلده.(@)(@@)(@@)(@@) ||| AUTO محمد بن عمر أبي الوزير(@)(@@) مولى بني هاشم، من أهل البصرة، كنيته أبو مطرف وهو أخو إبراهيم بن أبي الوزير، يروي عن شريك والبصريين، روى عنه أهل بلده.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الله الرقاشي، كنيته أبو عبد الله(@)(@@) من أهل البصرة، يروي عن المعتمر بن سليمان ويزيد بن زريع، روى عنه ابنه أبو قلابة عبد الملك بن محمد، مات قبل سنة عشرين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن يحيى بن حمزة الحضرمي(@)(@@) من أهل دمشق، يروي عن أبيه، PageV01P002 [ج 5: ص 438] روى عنه أهل الشام، ثقة في نفسه، يتقى حديثه ما روى عنه أحمد بن محمد بن يحيى بن حمزة وأخوه عبيد فإنهما كانا يدخلان عليه كل شيء.(@)(@@)(@@)(@@) ||| AUTO محمد بن يوسف الأصبهاني(@)(@@) من عباد أهل البصرة وقرائها، سكن البصرة يروي الرقائق وي روى عنه في الورع 
ms1617	 الحكايات الكثيرة، روى عنه عبيد بن حناد الحلبي وأهل البصرة، ما له كثير حديث يرجع إليه.(@)(@@)(@@)(@@) ||| AUTO أبو غسان الكناني، اسمه محمد بن يحيى بن علي بن عبد الحميد بن عبيد بن غسان بن يسار(@)(@@) من أهل المدينة، يروي عن الدراوردي، روى عنه محمد بن يحيى الذهلي وعمر بن شبة، ربما خالف.(@)(@@)(@@)(@@) ||| AUTO محمد بن يزيد بن سنان الرهاوي(@)(@@) من أهل الجزيرة، كنيته أبو عبد الله، يروي عن أبيه، روى عنه ابنه أبو فروة يزيد بن محمد وأهل بلده، كان مولده سنة ثنتين وثلاثين ومائة، ومات سنة عشرين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن أبي نعيم الواسطي(@)(@@) يروي عن هشيم وشريك، روى عنه أحمد بن سنان القطان، مات سنة ثلاث وعشرين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن عمر بن مطرف بن أبي الوزير(@)(@@) من أهل البصرة، يروي عن يحيى بن العلاء وشعيب بن خالد، روى عنه أبو موسى الزمن.(@)(@@)(@@)(@@) ||| AUTO محمد بن سلام البيكندي، أبو عبد الله(@)(@@) مولى بني سليم، يروي عن ابن عيينة وأبي الأحوص، وكان يتفقه، روى عنه محمد بن إسماعيل ومحمد بن إبراهيم PageV01P002 [ج 5: ص 439] البكري بتستر، مات يوم الأحد لسبع مضين من صفر سنة خمس وعشرين ومائتين، وقد قيل: إنه مولى بني جمح.(@)(@@)(@@)(@@) ||| AUTO محمد بن عائذ المكتب، كنيته أبو أحمد(@)(@@) من أهل دمشق، يروي عن الهيثم بن حميد والشاميين، روى عنه أبو زرعة الرازي وأهل الشام، كان مولده سنة خمسين ومائة، ومات سنة أربع وثلاثين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن سليمان بن معاذ التيمي(@)(@@) يروي عن مالك، روى عنه العباس بن عبد العظيم وأهل البصرة، ربما أخطأ وأغرب.(@)(@@)(@@)(@@) ||| AUTO محمد بن عكاشة بن صالح العتكي، أبو صالح الأزدي(@)(@@) من أهل بست، سمع سفيان بن عيينة وغيره، ولي القضاء ببست ثلاثين سنة، ومات قبل المائتين، وكان يأخذ رزقه في كل شهر ثلاثة آلاف درهم، وهو أقدم شيخ كان عندنا ببست من المحدثين، وهو ابن أبيه، روى عنه داود بن عبدة الأغر.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الله بن أبي الحواري الدمشقي(@)(@@) يروي 
ms1618	 عن الفضيل بن عياض، روى عنه أخوه أحمد بن أبي الحواري.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الرحمن بن شروس(@)(@@) من أهل صنعاء، يروي عن مالك بن أنس، روى عنه أهل اليمن.(@)(@@) (678) -[5: 439] حدثني محمد بن المنذر بن سعيد، ثنا عبد الله بن يوسف الصنعاني، قال: سمعت محمد بن عبد الرحمن بن شروس، يقول: كنا يوما بباب مالك بن أنس فإذا غلام قد خرج، وقال: أين صاحب العسل؟ قل له: يدخل، قال: فقام رجل فدخل من بين الناس.(@)(@@)(@@)(@@) ||| AUTO محمد بن شهاب، أبو جعفر(@)(@@) شيخ، يروي عن مسلم بن خالد الزنجي ومروان بن معاوية، مستقيم الحديث، روى عنه موهب بن يزيد بن خالد بن موهب الرملي.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الله الغنوي، أبو نصر(@)(@@) صاحب الجرير، جار عثمان بن PageV01P002 [ج 5: ص 440] الهيثم، من أهل البصرة، يروي عن سعيد بن أبي عروبة، روى عنه يعقوب بن سفيان الفارسي.(@)(@@)(@@)(@@) ||| AUTO محمد بن فضيل بن عياض بن مسعود اليربوعي التميمي، أبو بكر(@)(@@) يروي عن أبيه، روى عنه لام البخاري وهو إبراهيم بن الأشعث.(@)(@@)(@@)(@@) ||| AUTO محمد بن مخلد الحضرمي(@)(@@) من أهل البصرة، يروي عن إسماعيل بن جعفر، روى عنه أهل بلده، مات سنة عشرين ومائتين، وهو الذي يروي عن عبد العزيز بن معاوية العيني.(@)(@@)(@@)(@@) ||| AUTO محمد بن عثمان التنوخي، أبو الجماهر(@)(@@) يعرف به وهو لقب، كنيته أبو عبد الرحمن، من أهل دمشق، يروي عن الهيثم بن حميد وسعيد بن بشير، كان مولده سنة أربعين ومائة، ومات سنة أربع وعشرين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن مسروق الكندي(@)(@@) قاضي مصر، يروي عن جرير بن حازم والليث بن سعد، روى عنه سعيد بن كثير بن عفير، وقد قيل محمد بن مسرور، يخط.(@)(@@)(@@)(@@) ||| AUTO محمد بن الصلت، أبو جعفر الأسدي(@)(@@) من أهل الكوفة، يروي عن ابن المبارك والكوفيين، روى عنه ابن أبي شيبة وأهل بلده.(@)(@@)(@@)(@@) ||| AUTO محمد بن سعيد بن زياد جار عثمان بن الهيثم(@)(@@) من أهل البصرة، يروي عن صالح بن يحيى، روى عنه يعقوب بن سفيان.(@)(@@)(@@)(@@) ||| AUTO محمد بن كثير 
ms1619	 العبدي، أبو عبد الله(@)(@@) من أهل البصرة، PageV01P002 [ج 5: ص 441] يروي عن الثوري وإسرائيل، حدثنا عنه الفضل بن حباب، مات سنة ثلاث وعشرين ومائتين يوم الثاني عشر من جمادى الأولى، وكان تقيا فاضلا يخضب، وكان له يوم مات تسعون سنة.(@)(@@)(@@)(@@) ||| AUTO محمد بن شريك بن عبد الله(@)(@@) من أهل الكوفة، يروي عن أبيه، روى عنه أبو نعيم الزينبي، من أهل بغداد.(@)(@@)(@@)(@@) ||| AUTO محمد بن المكي(@)(@@) أصله من بلخ، يروي عن ابن المبارك، روى عنه يعقوب بن سفيان الفارسي، مستقيم الأمر في الحديث.(@)(@@)(@@)(@@) ||| AUTO محمد بن الحسن الأسدي باليل(@)(@@) يروي عن سفيان الثوري، روى عنه ابنه محمد بن محمد وأهل الكوفة، يغرب.(@)(@@)(@@)(@@) ||| AUTO محمد بن إسماعيل الفارسي(@)(@@) يروي عن سفيان الثوري، روى عنه محمد بن يحيى الذهلي، يغرب.(@)(@@)(@@)(@@) ||| AUTO محمد بن يعلى الهروي(@)(@@) سكن بغداد، يروي عن داود بن عبد الرحمن العطار، روى عنه محمد بن إسحاق الصغاني، يخطئ.(@)(@@)(@@)(@@) ||| AUTO محمد بن يزيد الحزامي(@)(@@) من أهل الكوفة، يروي عن رشد بن سعد، روى عنه أبو كريب محمد بن العلاء، وقد كتب عنه يعقوب بن سفيان.(@)(@@)(@@)(@@) ||| AUTO محمد بن الصباح الدولابي، أبو جعفر البغدادي(@)(@@) يروي عن إسماعيل بن زكريا وشريك، حدثنا عنه أبو يعلى، مات سنة تسع وعشرين ومائتين لأربع عشرة خلت من المحرم، وكان مولده بالري بقرية يقال لها: دولاب.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الله، أبو عبيد الله الخزاعي(@)(@@) من أهل PageV01P002 [ج 5: ص 442] البصرة، يروي عن حماد بن سلمة والبصريين، حدثنا عنه أبو خليفة، مات سنة ثلاث وعشرين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن معاوية السمرقندي(@)(@@) خال عبد الله بن عبد الرحمن أخو أحمد بن معاوية، يروي عن يحيى القطان، روى عنه ابن قهزاد وعبد الله بن عبد الرحمن.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الرحمن بن أبي الحكم الحكمي الأزدي(@)(@@) من أهل المدينة، كان يسكن في بني أمية بن يزيد، يروي عن طلحة بن يحيى، روى عنه يعقوب بن سفيان الفارسي.(@)(@@)(@@)(@@) ||| AUTO محمد بن سنان العوقي الباهلي(@)(@@) من أهل البصرة وعوقة موضع بها، يروي عن 
ms1620	 همام بن منبه وموسى بن علي بن رباح، روى عنه أهل العراق، مات سنة ثنتين أو ثلاث وعشرين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمد بن زرعة بن روح الرعيني(@)(@@) من أهل الشام، يروي عن بقية والوليد بن مسلم، روى عنه أبو زرعة الدمشقي وأهل بلده، مات سنة ست عشرة ومائتين، وكان ثقة متقنا يحفظ.(@)(@@)(@@)(@@) ||| AUTO محمد بن عمران بن عبد الرحمن بن الحارث الهذلي(@)(@@) من أهل مكة، يروي عن أبيه عن مجاهد، روى عنه يعقوب بن سفيان.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد الحميد بن سالم العطار(@)(@@) من أهل الكوفة، يروي عن سيف بن عميرة وأبي نعيم، روى عنه عبيد بن كثير وأهل بلده.(@)(@@)(@@)(@@) ||| AUTO أبو ثابت المدني، اسمه محمد بن عبيد الله بن محمد بن زيد بن أبي زيد PageV01P002 [ج 5: ص 443](@)(@@) مولى آل عثمان بن عفان، يروي عن مالك وابن أبي حازم، روى عنه أبو زرعة ومحمد بن إبراهيم البكري.(@)(@@)(@@)(@@) ||| AUTO محمد بن هشام الحراني(@)(@@) يروي عن عيسى بن يونس، روى عنه ابنه عبد الحميد بن محمد بن هشام إمام مسجد حران.(@)(@@)(@@)(@@) ||| AUTO محمد بن محبوب، أبو عبد الله البصري(@)(@@) يروي عن حماد بن سلمة وأبي عوانة، روى عنه محمد بن إسماعيل.(@)(@@)(@@)(@@) ||| AUTO محمد بن سفيان بن وردان الأسدي(@)(@@) من أهل الكوفة، يروي عن شريك، روى عنه أبو زرعة الرازي، يخطئ ويهم.(@)(@@)(@@)(@@) ||| AUTO محمد بن جعفر المدائني الثقفي(@)(@@) يروي عن ورقاء بن عمر، روى عنه ابنه جعفر بن محمد.(@)(@@)(@@)(@@) ||| AUTO محمد بن عبد العزيز الرملي، أبو عبد الله(@)(@@) أصله من واسط، سكن الرملة، يروي عن شعيب بن إسحاق ومروان بن معاوية، روى عنه علي بن داود القنطري وأهل الشام، ربما خالف.(@)(@@)(@@)(@@) ||| AUTO أبو همام الدلال، اسمه محمد بن مجيب(@)(@@) صاحب الرقيق، من أهل البصرة، يروي عن الثوري وإبراهيم بن طهمان، حدثنا عنه أبو خليفة.(@)(@@)(@@)(@@) ||| AUTO محمد بن مقاتل المروزي، أبو الحسن الكسائي(@)(@@) يروي عن PageV01P002 [ج 5: ص 444] ابن المبارك، حدثنا عنه محمد بن عبد الرحمن الشامي، مات في آخر سنة ست وعشرين ومائتين، وكان متقنا. 