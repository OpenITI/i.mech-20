(@@)(@@) $ الحسينى : محمد الملحوس.(@)(@)(@@)(@@)(@@) $ الحسينى : محمد بن موسى(@)(@)(@@) .(@)(@)(@@)(@@)(@@) $ الحسينى : مساعد...(@)(@)(@@)(@@)(@@) $ الحسينى : مهنا الموسوى.(@)(@)(@@)(@@)(@@) $ الحسينى : نظام الدين تركه.(@)(@)(@@)(@@)(@@) $ الحسينى : نظام الدين...(@)(@)(@@)(@@)(@@) $ الحسينى : هاشم الكاظمى(@)(@)(@@) .(@)(@)(@@)(@@)(@@) $ الحلبى:(@)(@)(@@) الحسن بن محمد بن على العراقى.(@)(@)PageV06P053(@)(@)(@@)(@@)(@@) $ الحلى: احمد...(@)(@)(@@)(@@)(@@) $ الحلى : الحسن بن سليمان.(@)(@)(@@)(@@)(@@) $ الحلى : الحسن بن محمد بن راشد.(@)(@)(@@)(@@)(@@) $ الحلى : الحسن بن محمد المهلبى.(@)(@)(@@)(@@)(@@) $ الحلى : عبد السميع الأسدى.(@)(@)(@@)(@@)(@@) $ الحلى : عبد الله السيورى(@)(@)(@@) .(@)(@)(@@)(@@)(@@) $ الحلى : على بن فضل.(@)(@)(@@)(@@)(@@) $ الحلى : محمد الانصارى.(@)(@)(@@)(@@)(@@) $ الحلى : محمد...(@)(@)(@@)(@@)(@@) $ الحلى : مقداد بن عبد الله.(@)(@)(@@)(@@)(@@) $ حمزة بن محسن الحسينى عز الدين.(@)(@)(@@) كان من تلاميذ الفاضل المقداد وقد حكى عن خطه شيخه المذكور كيفية شهادة الشيخ الشهيد فى 786 وقد حكاها عنه فى «اجازات البحار» . ويأتى على بن شواء تلميذ الفاضل المقداد الذى كتب قصة شهادة الشهيد عن خط شيخه المذكور فى 839-الحقائق الراهنة ص 207 ومر فى ص 30 الحسن بن حمزة.(@)(@)(@@)(@@)(@@) $ ابن حمزة:(@)(@)(@@) الحسن الحسينى الموسوى.(@)(@)(@@)(@@)(@@) $ الحموئى:(@)(@)(@@) اسحاق... 
ms935	(@)(@)(@@)(@@)(@@) $ الحموئى :(@)(@)(@@) محمد بن اسحاق.(@)(@)(@@)(@@)(@@) $ الحمويانى:(@)(@)(@@) الحسين بن محمد بن الحسن.(@)(@)PageV06P054(@)(@)(@@)(@@)(@@) || «خ»(@)(@)(@@)(@@)(@@) $ الخازن:(@)(@)(@@) على...(@)(@)(@@)(@@)(@@) $ الخجندى:(@)(@)(@@) كمال الدين.(@)(@)(@@)(@@)(@@) $ خضر الحبله رودى(@)(@)(@@) نجم الدين بن شمس الدين محمد بن على الرازى ثم النجفى. قرء المعقول بشيراز على السيد شمس الدين محمد بن المير سيد شريف الجرجانى (م 838 وتوفى والده الجرجانى 816) ثم ذهب إلى الحلة وفيها ألف بعض تصانيفه، ثم جاور النجف وكان من علماء عصر الأمير تيمور. وأول تصانيفه «كاشف الحقائق» فى شرح «الدرة» الكبرى لأستاذه المذكور-ذ 8 قم 322 و13 قم 873 ألفه عام 823 كتبه فى حياة أستاذه ثم كتب الأستاذ «الغرة» الصغرى أيضا فى المنطق، فشرحه أيضا فى حياته وسماه «جامع الدقايق فى شرح غرة المنطق» -ذ 5 قم 205 حكى فى «رياض العلماء» أنه رآهما بخط الكفعمى الذى كتبه عام 857 وصرح فى آخره أن له كتاب القوانين-ذ 17: 199 قال فى «رياض العلماء» : وكأنه فى المنطق. وله «حقايق الفرقان فى خلاصة الاصول والميزان» نص عليه فى كتابه المذكور. وله «التحقيق المبين» (ذ 3 قم 1799) ألفه 828 وبعده كتب «جامع الاصول فى شرح رسالة الفصول» فى الحائر 834-ذ 5: 41 و51. وله أيضا «جامع الدرر فى شرح الباب الحادى عشر» ومختصره الموسوم «مفتاح الغرر» ألفه فى الغرى عام 836. وله «تحفة المتقين فى أصول الدين» وكتب فى 839 «التوضيح الأنور لدفع شبهة الأعور» ذكرنا كلها فى الذريعة وعينت ما رأيت منها. ومنها قطعة من اول «جامع الدقايق» صرح فيه بأنه(@)(@)PageV06P055(@) كتب أولا «كاشف الحقايق» فى شرح الدرة معرب «الكبرى» ثم ألف أستاذه «الغرة» معرب «الصغرى» فشرحه أيضا بهذا الشرح وهو شرح مزج. والنسخة بخط يوسف بن محمد بن ابراهيم بن يوسف الميسى العاملى فى مجموعة دونها لنفسه، فرغ من بعضها 852 ومن بعضها 848 وهى موجودة فى مكتبة الشيخ على كاشف الغطاء فى النجف وفيها «جامع الأصول» المذكور.(@)(@)(@@)(@@)(@@) $ الخراسانى:(@)(@)(@@) هاشم الكاظمى.(@)(@)(@@)(@@)(@@) $ آل خرسان:(@)(@)(@@) محمد الاخرس.(@)(@)(@@)(@@)(@@) $ الخزاعى:(@)(@)(@@) عبد المطلب...(@)(@)(@@)(@@)(@@) $ ابن خزعل:(@)(@)(@@) محمد بن على...(@)(@)(@@)(@@)(@@) $ الخطى:(@)(@)(@@) ابو الحسن...(@)(@)(@@