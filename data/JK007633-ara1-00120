ms101	 غمكم أنا سقمكم % % أنا سمكم في السر والإعلان % % 629(@)(@@) % أذهبتم نور القرآن وحسنه % % من كل قلب وإله لهفان % % 630(@)(@@) % فوحق جبار على العرش استوى % % من غير تمثيل كقول الجاني % % PageV01P305 631(@)(@@) % ووحق من ختم الرسالة والهدى % % بمحمد فزها به الحرمان % % 632(@)(@@) % لأقطعن بمعولي أعرضكم % % ما دام يصحب مهجتي جثماني % % 633(@)(@@) % ولأهجونكم واثلب حزبكم % % حتى تغيب جثتي أكفاني % % 634(@)(@@) % ولأهتكن بمنطقي أستاركم % % حتى أبلغ قاصيا أو داني % % 635(@)(@@) % ولأهجون صغيركم وكبيركم % % غيظا لمن قد سبني وهجاني % % 636(@)(@@) % ولأنزلن بكم اليم صواعقي % % ولتحرقن كبودكم نيراني % % 637(@)(@@) % ولأقطعن بسيف حقي زوركم % % وليخمدن شواظكم طوفاني % % 638(@)(@@) % ولأقصدن الله في خذلانكم % % وليمنعن جميعكم خذلاني % % 639(@)(@@) % ولأحملن على عتاة طغاتكم % % حمل الأسود على قطيع الضان % % 640(@)(@@) % ولأرمينكم بصخر محانقي % % حتى يهد عتوكم سلطاني % % PageV01P306 641(@)(@@) % ولأكتبن إلى البلاد بسبكم % % فيسير سير البزل بالركبان % % 642(@)(@@) % ولأدحضن بحجتي شبهاتكم % % حتى يغطي جهلكم عرفاني % % 643(@)(@@) % ولأغضبن لقول ربي فيكم % % غضب النمور وجملة العقبان % % 644(@)(@@) % ولأضربنكم بصارم مقولي % % ضربا يزعزع أنفس الشجعان % % 645(@)(@@) % ولأسطعن من الفضول أنوفكم % % سعطا يعطس منه كل جبان % % 646(@)(@@) % إني بحمد الله عند قتالكم % % لمحكم في الحرب ثبت جنان % % 647(@)(@@) % وإذا ضربت فلا تخيب مضاربي % % وإذا طعنت فلا يروغ طعاني % % 648(@)(@@) % وإذا حملت على الكتيبة منكم % % مزقتها بلوامع البرهان % % 649(@)(@@) % الشرع والقرآن أكبر عدتي % % فهما لقطع حجاجكم سيفان % % 650(@)(@@) % ثقلا على أبدانكم ورؤسكم % % فهما لكسر رؤوسكم حجران % % PageV01P307 651(@)(@@) % إن أنتم سالمتم سولمتم % % وسلمتم من حيرة الخذلان % % 652(@)(@@) % ولئن أبيتم واعتديتم في الهوى % % فنضالكم في ذمتي وضماني % % 653(@)(@@) % يا أشعرية يا أسافلة الورى % % يا عمي يا صم بلا آذان % % 654(@)(@@) % إني لأبغضنكم وابغض حزبكم % % بغضا أقل قليله أضناني % % 655(@)(@@) % لو كنت أعمى المقلتين لسرني % % كيلا يرى إنسانكم إنساني % % 656(@)(@@) % تغلي قلوبكم على بحرها % % حنقا وغيظا أيما غليان % % 657(@)(@@) % موتوا بغيظكم وموتوا حسرة % % واسا علي وعض كل بنان % % 658(@)(@@) % قد عشت مسرورا ومت مخفرا % % ولقيت ربي سرني ورعاني % % 659(@)(@@) % وأباحني جنات عدن آمنا % % ومن الجحيم بفضله عافاني % % 660(@)(@@) % ولقيت أحمد 
ms102	 في الجنان وصحبه % % والكل عند لقائهم أدناني % % PageV01P308 661(@)(@@) % لم ادخر عملا لربي صالحا % % لكن باسخاطي لكم أرضاني % % 662(@)(@@) % أنا تمرة الأحباب حنظلة العدا % % أنا غصة في حلق من عاداني % % 663(@)(@@) % وأنا المحب لأهل سنة أحمد % % وأنا الأديب الشاعر القحطاني % % 664(@)(@@) % سل عن بني قحطان كيف فعالهم % % يوم الهياج إذا التقى الزحفان % % 665(@)(@@) % سل كيف نثرهم الكلام ونظمهم % % وهما لهم سيفان مسلولان % % 666(@)(@@) % نصروا بألسنة حداد سلق % % مثل الأسنة شرعت لطعان % % 667(@)(@@) % سل عنهم عند الجدال إذا التقى % % منهم ومن أضدادهم خصمان % % 668(@)(@@) % نحن الملوك بنو الملوك وراثة % % أسد الهياج وأبحر الإحسان % % 669(@)(@@) % لا قومنا بخلا ولا باذلة % % عند الحروب ولا النسا بزوان % % 670(@)(@@) % يا أشعرية يا جميع من ادعى % % بدعا وأهواء بلا برهان % % PageV01P309 671(@)(@@) % جاءتكم سنية مأمونة % % من شاعر ذرب اللسان معان % % 672(@)(@@) % خرز القوافي بالمدائح والهجا % % فكأن جملتها لدي عواني % % 673(@)(@@) % يهوى فصيح القول من لهواته % % كالصخر يهبط من ذرى كهلان % % 674(@)(@@) % إني قصدت جميعكم بقصيدة % % هتكت ستوركم على البلدان % % 675(@)(@@) % هي للجهالة درة عمرية % % تركت رؤوسكم بلا آذان % % 676(@)(@@) % هي للمنجم والطبيب منية % % فكلاهما ملقان مختلفان % % 677(@)(@@) % هي في رؤوس المارقين شقيقة % % ضربت لفرط صداعها الصدغان % % 678(@)(@@) % هي في قلوب الأشعرية كلهم % % صاب وفي الأجساد كالسعدان % % 679(@)(@@) % لكن لأهل الحق شهدا صافيا % % أو تمر يثرب ذلك الصيحاني % % 680(@)(@@) % وأنا الذي حبرتها وجعلتها % % منظومة كقلائد المرجان % % PageV01P310 681(@)(@@) % ونصرت أهل الحق مبلغ طاقتي % % وصفعت كل مخالف صفعان % % 682(@)(@@) % مع أنها جمعت علوما جمة % % مما يضيق لشرحها ديواني % % 683(@)(@@) % أبياتا مثل الحدائق تجتني % % سمعا وليس يملهن الجاني % % 684(@)(@@) % وكأن رسم سطورها في طرسها % % وشى ينمقه أكف غواني % % 685(@)(@@) % والله أسأله قبول قصيدتي % % مني وأشكره لما أولاني % % 686(@)(@@) % صلى الإله على النبي محمد % % ما ناح قمري على الأغصاني % % 687(@)(@@) % وعلى جميع بناته ونسائه % % وعلى جميع الصحب والإخوان % % 688(@)(@@) % بالله قولوا كلما أنشدتم % % رحم الإله صداك يا قحطاني % % PageV01P311 البحر : مجزوء الرجز 1(@)(@@) % يا مولعا بالغضب والهجر والتجنب % % وهجرك قد برح بي في جده 
ms103	 واللعب % % 2(@)(@@) % إن دموعي غمر وليس عندي غمر % % فقلت ياذا الغمر أقصر عن التعتب % % 3(@)(@@) % بالفتح ماء كثرا والكسر حقد سترا % % والضم شخص مادري شيئا ولم يجرب % % 4(@)(@@) % بدا فحيا بالسلام رمى عذو لي بالسلام % % أشار نحوي بالسلام بكفه المختضب % % 5(@)(@@) % بالفتح لفظ المبتدى والكسر صخر الجلمد % % والضم عرق في اليد قد جاء في قول النبي % % 6(@)(@@) % تيم قلبي بالكلام وفي الحشا منه كلام % % فصرت في أرض كلام لكي أنال مطلبي % % 7(@)(@@) % بالفتح قول يفهم والكسر جرح مؤلم % % والضم أرض تبرم لشدة التصلب % % 8(@)(@@) % ثبت بأرض حرة معروفة بالحرة % % فقلت يا ابن الحرة ارث لما قد حل بي % % 9(@)(@@) % بالفتح للحجارة والكسر للحوارة % % والضم للمختارة من النسا في الحجب % % 10(@)(@@) % جد فالأديم حلم وما بقى لي حلم % % وما هناني حلم مذ غبت يا معذبي % % PageV01P312 11(@)(@@) % بالفتح جلد نقبا والكسر عفو الأدبا % % والضم في النوم هبا حلم كثير الكذب % % 12(@)(@@) % حمدت يوم السبت إذ جاء محذى السبت % % على نبات السبت في المهمه المستصعب % % 13(@)(@@) % بالفتح يوم وإذا كسرته فهو الحذا % % والضم نبت وغذا إذا نشا في الربرب % % 14(@)(@@) % خدد في يوم سهام قلبي بأمثال السهام % % كالشمس ترمي بالسهام بضوها واللهب % % 15(@)(@@) % بالفتح حر قويا والكسر سهم رميا % % والضم نور ضيا للشمس عند المغرب % % 16(@)(@@) % دعوت ربي دعوه لما أتى بالدعوه % % فقلت عندي دعوه إن زرتني في رجب % % 17(@)(@@) % بالفتح لله دعا والكسر في الأصل ادعا % % والضم شيء صنعا للأكل عند الطرب % % 18(@)(@@) % دلفت نحو الشرب فلم أدر عن شرب % % فانقلبوا بالشرب ولم يخافوا غضبي % % 19(@)(@@) % بالفتح جمع الأشربة والكسر ماء شربه % % والضم ماء العنبه عند حضور العنب % % 20(@)(@@) % رام سلوك الخرق مع الطريق الخرق % % إن بيان الخرق عند ركوب السبب % % PageV01P313 21(@)(@@) % بالفتح أرض واسعة والكسر كف هامعه % % والضم شخص ما معه شيء من التهذب % % 22(@)(@@) % زاد كثيرا في اللحا من بعد تقشير اللحا % % لما رأى شيب اللحى صرم حبل النسب % % 23(@)(@@) % بالفتح قول العذل والكسر لحى الرجل % % والضم شعرات تلى لحى 
ms104	 الفتى والأشيب % % 24(@)(@@) % سار مجدا في الملا وأبحر الشوق ملا % % ولبسه لين الملا فقلت يا للعجب % % 25(@)(@@) % بالفتح جمع البشر والكسر ماء الأبحر % % والضم ثوب العبقري مرصع بالذهب % % 26(@)(@@) % شاكلني بالشكل تيمنى بالشكل % % وغلني بالشكل في حبه واحز بي % % 27(@)(@@) % بالفتح مثل المثل والكسر حسن الدل % % والضم قيد البغل خوف من التوثب % % 28(@)(@@) % صاحبني في صرة في ليلة ذي صرة % % وما بقي في صرتي خردلة من ذهب % % 29(@)(@@) % بالفتح جمع الوفد وللكسر كثرت البرد % % والضم صر النقد في ثوبه بالهدب % % 30(@)(@@) % ضمنته نبت الكلابا بالحفظ مني والكلا % % فشج قلبي والكلا عمدا ولم يراقب % % PageV01P314 31(@)(@@) % بالفتح نبت للكلا والكسر حفظ للولا % % والضم جمع للكلا من كل حي ذي أب % % 32(@)(@@) % طارحني بالقسط ولم يرن بالقسط % % في فيه عرق القسط والعنبر المطيب % % 33(@)(@@) % بالفتح جور في القضاء والكسر عدل يرتضى % % والضم عود قبضا رخاوة للعصب % % 34(@)(@@) % ظبى ذكي العرف وأخذ بالعرف % % وآمر بالعرف سام رفيع الرتب % % 35(@)(@@) % بالفتح عرف طيب والكسى صبر يندب % % والضم قول يجب عند ارتكاب الريب % % 36(@)(@@) % عال رفيع الجسد أفعاله بالجد % % لقيته بالجد كالمعطل المخرب % % 37(@)(@@) % بفتحها أبو الأب والكسو ضد اللعب % % والضم بعض القلب كان لبعض العرب % % 38(@)(@@) % غني وغنته الجوار بالقرب مني الجوار % % فاستمعوا صوت الجوار انثنوا بالطرب % % 39(@)(@@) % بالفتح جمع جاريه والكسر جار داريه % % والضم صوت الداعيه بويلها والحرب % % 40(@)(@@) % قام قلبي أمه عند زوال الأمه % % فاستمعوا يا أمة بحقكم ما حل بي % % PageV01P315 41(@)(@@) % بالفتح شج الراس والكسر ضد الباس % % والضم جمع الناس من عجم أو عرب % % 42(@)(@@) % قولوا لأطيار الحمام يبيكينني حتى الحمام % % أما ترى يا ابن الحمام ما في الهوى من طرب % % 43(@)(@@) % بالفتح طير يهدر والكسر موت يقدر % % والضم شخص يذكر بالإسم لا باللقب % % 44(@)(@@) % كأنما بي لمه قد شاب شعر اللمة % % وما بقي لي لمه ولا لقا من نصب % % 45(@)(@@) % بالفتح خوف الباس والكسر شعر الراس % % والضم جمع الناس ما بين شيخ وصبي % % 46(@)(@@) % لما أصاب مسكي فاح عبير المسك % % فكان 
ms105	 منه مسكي وراحتي من تعب % % 47(@)(@@) % بالفتح ظهر الجلد والكسر طيب الهند % % والضم ما لا يبدي من راحة المستوهب % % 48(@)(@@) % ملت دموعي حجري وقل فيه حجري % % لو كنت كابن حجر لضاق فيه أدبي % % 49(@)(@@) % بالتج حجر الرجل والكسر جمع العقل % % والضم اسم النقل لرجل منتسب % % 50(@)(@@) % ناول برد السقط من فيه عين السقط % % فلاح رمى السقط وميضه كالشهب % % PageV01P316 51(@)(@@) % بالفتح ثلج وبرد والكسر نار من زند % % والسقط بالضم الولد قبل تمام الأرب % % 52(@)(@@) % وجدته كالقمه في جبل ذي قمه % % مطرح كالقمه فقلت هذا مطلبي % % 53(@)(@@) % بالفتح أخذ الناس والكسر أعلى الراس % % والضم للإنكاس من المكان الخرب % % 54(@)(@@) % هذي علامات الرفاق فانظرا إلى أهل الرقاق % % هل ينطقوا قبل الرفاق بالصدق أم بالكذب % % 55(@)(@@) % بالفتح رجل متصل والكسر خبز قد أكل % % وللضم أرض تنفصل على أمان النصب % % 56(@)(@@) % لا تركنن للصل ولا تثق بالصل % % واحذر طعام الصل وانهض نهوض المجدب % % 57(@)(@@) % صوت الحديد صرصرا وحيه ان كسر % % والماء إن تغير بضمها لم يشرب % % 58(@)(@@) % يسفر عن عين الطلا وجنة تحكى الطلا % % وجيده من الطلا غيدا ولم تحتجب % % 59(@)(@@) % بالفتح أولاد الظبا والكسر خمر شربا % % والضم جيد ضربا بحسنه جيد الظبي % % 60(@)(@@) % أتيته وهو لقى فبش بي عند اللقا % % وقال اطعمني لقى فذاك أقصى أدب % % PageV01P317 61(@)(@@) % بالفتح كنس المنزل والكسر للحرب قلى % % والضم ماء العسل عقدته باللهب % % 62(@)(@@) % دياره قد عمرت ونفسه قد عمرت % % وأرسنه قد عمرت من بعد رسم خرب % % 63(@)(@@) % بالفتح فيه سكنا وكسرها نال القنا % % والضم مهما أمعنا في حرثه المجرب % % 64(@)(@@) % صاحبني وهو رشا كصحبة الدلو الرشا % % حاشا من أخذ الرسا في الحكم أو من ريب % % 65(@)(@@) % بالفتح للغزال والكسر للحبال % % والضم يذل المال للحاكم المستكلب % % 66(@)(@@) % الريق منه كزجاج ولحظه يحكي الزجاج % % والقلب مني كزجاج وآد سريع العطب % % 67(@)(@@) % بالفتح للقرنفل والكسر زج الأسل % % والضم ذات الشغل من الزجاج الحلب % % 68(@)(@@) % للذع ألف منه ولا احتمال منه % % من كان فيه منه فليسترح بالهرب % % 69(@)(@@) % بفتحها للحية وكسرها للهبة 
ms106	 % % وضمنها للقوة وهو دليل الغلب % % 70(@)(@@) % ورث ضعفا في القرا كثرة معاني القرا % % وذاك في غير القرى فكيف عند العرب % % PageV01P318 71(@)(@@) % بالفتح ظهر الوهدى والكسر طعم الوفد % % والضم جمع البلد كمكة ويثرب % % 72(@)(@@) % من لي برشف الظلم أو اصطياد الظلم % % ما عنده من ظلم ولا مقال الكذب % % 73(@)(@@) % بالفتح ما الأسنان وللنعام الثاني % % والظلم للإنسان مجلبة للغضب % % 74(@)(@@) % فالقطر جود كفه والقطر سيل حتفه % % والقطر ماء أنفه وخده من ذهب % % 75(@)(@@) % بالفتح غيث سكبا والكسر صفر ذوبا % % والضم عود جلبا من عدن في المركب % % 76(@)(@@) % لما رايت دله وهجره ومطله % % رثيت من حبي له مثلثا لقطرب % % 77(@)(@@) % وابن زريق نظما شرحا لما تقدما % % فربما ترحما عليه أهل الأدب % % 78(@)(@@) % أديت فيه واجبي في خدمة المخالبي % % أحمد ذي المواهب وذا النجاد الطيب % % 79(@)(@@) % من جاءه وأمله ينال منه أمله % % يا سعد من قد وصله من أهل علم الأدب % % 80(@)(@@) % أما يبحث بحثه أو اختراع أحدثه % % في شرح ذي المثلثة بنظمه المهذب % % PageV01P319 81(@)(@@) % مصليا مسلما على النبي كلما % % رقرق برق أوهما بالودق مزن السحب % % PageV01P320 البحر : رمل تام 1(@)(@@) % اعتزل ذكر الأغاني والغزل % % وقل الفصل وجانب من هزل % % 2(@)(@@) % ودع الذكر لأيام الصبا % % فلأيام الصبا نجم أفل % % 3(@)(@@) % إن أهنا عيشة قضيتها % % ذهبت لذاتها والإثم حل % % 4(@)(@@) % واترك الغادة لا تحفل بها % % تمس في عز وترفع وتجل % % 5(@)(@@) % وإله عن آلة لهو اطربت % % وعن الأمرد مرتج الكفل % % 6(@)(@@) % أن تبدى تنكسف شمس الضحى % % وإذا ماماس يزرى بالأسل % % 7(@)(@@) % زاد إن قسناه بالبدر سنا % % أو عدلناه بغصن فاعتدل % % 8(@)(@@) % وافتكر في منتهى حسن الذي % % أنت تهواه تجد أمر جلل % % 9(@)(@@) % اهجر الخمر أن كنت فتى % % كيف يسعى في جنون من عقل % % 10(@)(@@) % واتقي الله فتقوى الله ما % % جاورت قلب امرىء إلا وصل % % PageV01P321 11(@)(@@) % ليس من يقطع طرقا بطلا % % إنما من يتقي الله البطل % % 12(@)(@@) % صدق الشرع ولا تركن إلى % % رجل يرصد بالليل زحل % % 13(@)(@@) % حارت الأفكار في قدرة من % % قد هدانا سبلنا عز وجل 
ms107	 % % 14(@)(@@) % كتب الموت على الخلق فكم % % فل من جمع وأفنى من دول % % 15(@)(@@) % أين عاد أين فرعون ومن % % رفع الأهرام من يسمع يخل % % 16(@)(@@) % أين من شادوا وسادوا وبنوا % % هلك الكل فلم تغن القلل % % 17(@)(@@) % أين أرباب الجحى أهل النهى % % أين أهل العلم والقوم والأول % % 18(@)(@@) % سيعيد الله كلا منهم % % وسيجزى فاعلا ما قد فعل % % 19(@)(@@) % أطلب العلم ولا تكسل فما % % أبعد الخير على أهل الكسل % % 20(@)(@@) % واحتفل للفقه في الدين ولا % % تشتغل عنه بمال وخول % % PageV01P322 21(@)(@@) % واهجر النوم وحصله فمن % % يعرف المطلوب يحتقر ما بذل % % 22(@)(@@) % لا تقل قد ذهبت أربابه % % كل من سار على الدرب وصل % % 23(@)(@@) % في ازدياد العلم إرغام العدى % % وجمال العلم اصلاح العمل % % 24(@)(@@) % جمل المنطق بالنحو فمن % % يحرم الأعراب بالنطق اختبل % % 25(@)(@@) % انظم الشعر ولازم مذهبي % % فاطرح الرفد في الدنيا أقل % % 26(@)(@@) % وهو عنوان على الفضل وما % % أحسن الشعر إذا لم يبتذل % % 27(@)(@@) % مات أهل الفضل لم يبق سوى % % مقرف أو من على الأصل اتكل % % 28(@)(@@) % أنا لا أختار تقبيل يد % % قطعها أجمل من تلك القبل % % 29(@)(@@) % إن جزتني عن مديحي صرت في % % رقها أولا فيكفيني الخجل % % 30(@)(@@) % اعذب الألفاظ قولي لك خذ % % وامر اللفظ نطقي بلعل % % PageV01P323 31(@)(@@) % ملك كسرى تغن عنه كسرة % % وعن البحر اجتزاء بالوشل % % 32(@)(@@) % اعتبر نحن قسمنا بينهم % % تلقه حقا وبالحق نزل % % 33(@)(@@) % ليس ما يحوي الفتى من عزمه % % لا ولا ما فات يوما بالكسل % % 34(@)(@@) % اطرح الدنيا فمن عاداتها % % تخفض العالي وتعلي من سفل % % 35(@)(@@) % عيشة الزاهد في تحصيلها % % عيشة الجاهل بل هذا أذل % % 36(@)(@@) % كم جهول وهو مثر مكثر % % وعليم مات منها بالعلل % % 37(@)(@@) % كم شجاع لم ينل منها المنى % % وجبان نال غايات الأمل % % 38(@)(@@) % فاترك الحيلة فيها واتئذ % % إنما الحيلة في ترك الحيل % % 39(@)(@@) % أي كف لم تفد مما تفد % % فرماه الله منه بالشلل % % 40(@)(@@) % لا تقل أصلي وفصلي أبدا % % إنما أصل الفتى ما قد حصل % % PageV01P324 41(@)(@@) % قد يسود المرء من غير أب % % وبحسن السبك قد ينفي 
ms108	 الزغل % % 42(@)(@@) % وكذا الورد من الشوك وما % % يطلع النرجس إلا من بصل % % 43(@)(@@) % مع أني أحمد الله على % % نسبي إذ بأبي بكر اتصل % % 44(@)(@@) % قيمة الإنسان ما يحسنه % % أكثر الإنسان منه أو أقل % % 45(@)(@@) % وادرع جدا وكدا واجتنب % % صحبة الحمقى وأرباب الخلل % % 46(@)(@@) % بين تبذير وبخل رتبة % % وكلا هذين إن دام قتل % % 47(@)(@@) % لا تخض في سب سادات مضوا % % أنهم ليسوا بأهل للزلل % % 48(@)(@@) % وتغافل عن أمور أنه % % لم يفز بالحمد إلا من غفل % % 49(@)(@@) % ليس يخلو المرء من ضد وإن % % حاول العزلة في رأس جبل % % 50(@)(@@) % مل عن النمام واهجره فما % % بلغ المكروه إلا من نقل % % PageV01P325 51(@)(@@) % دار جار السوء إن جار وإن % % لم تجد صبرا فما أحلى النقل % % 52(@)(@@) % جانب السلطان واحذر بطشه % % لا تخاصم من إذا قال فعل % % 53(@)(@@) % لاتل الحكم وإن هم سألوا % % رغبة فيك وخالف من عذل % % 54(@)(@@) % إن نصف للناس أعداء لمن % % ولى الأحكام هذا إن عدل % % 55(@)(@@) % فهو المحبوس عن لذاته % % وكلا كفيه في الحشر تغل % % 56(@)(@@) % ان للنقص والاستثقال في % % لفظة القاضي لوعظا ومثل % % 57(@)(@@) % لا تساوي لذة الحكم بما % % ذاقه الشخص إذا الشخص نعزل % % 58(@)(@@) % فالولايات وإن طابت لمن % % ذاقها فالسم في ذاك العسل % % 59(@)(@@) % نصب المنصب أو هي جسدي % % وعناني عن مداراة السفل % % 60(@)(@@) % قصر الآمال في الدنيا تفز % % فدليل العقل تقصير الأمل % % PageV01P326 61(@)(@@) % إن من يطلبه الموت على % % غرة منه جدير بالوجل % % 62(@)(@@) % غب وزر غبا تزد حبا فمن % % أكثر الترداد أضناه الملل % % 63(@)(@@) % خذ بحد السيف واترك غمده % % واعتبر فضل الفتى دون الحلل % % 64(@)(@@) % لا يضر الفصل إقلال كما % % لا يضر الشمس إطباق الطفل % % 65(@)(@@) % حبك الأوطان عجز ظاهر % % فاغترب تلق عن الأهل بدل % % 66(@)(@@) % فبمكث الماء يبقى آسنا % % وسرى البدر به البدر اكتمل % % 67(@)(@@) % عد عن أسهم لفظي واستتر % % لا يصيبنك سهم من ثعل % % 68(@)(@@) % لا يغرنك لين من فتى % % إن للحيات لينا يعتزل % % 69(@)(@@) % أنا مثل الماء سهل سائغ % % ومتى سخن آذى وقتل % % 70(@)(@@) % أنا كالخيزران 
ms109	 صعب كسره % % وهو لين كيفما شئت انفتل % % PageV01P327 71(@)(@@) % غير أني في زمان من يكن % % فيه ذا مال هو المولى الأجل % % 72(@)(@@) % واجب عند الورى إكرامه % % وقليل المال فيهم يستقل % % 73(@)(@@) % كل أهل العصر غمر وأنا % % منهم فاتر تفاصيل الجمل % % 74(@)(@@) % وصلاة وسلام أبدا % % للنبي المصطفى خير الدول % % 75(@)(@@) % وعلى الآل الكرام السعدا % % وعلى الأصحاب والقوم الأول % % 76(@)(@@) % ما نوى الركب بعشاق إلى % % أيمن الخي وما غنى رمل % % PageV01P328 البحر : وافر تام 1(@)(@@) % بني نجد إلى العلياء سيروا % % فقد آن التقدم والسرور % % 2(@)(@@) % فما حاز الفضائل ذو هوينا % % وكم قد نالها الجلد الصبور % % 3(@)(@@) % فهيا يا بنات المجد هيا % % فيوم العز ليس له نظير % % 4(@)(@@) % إلا فتشجموا طرق المعالي % % ففي عقبي السرى سر كبير % % 5(@)(@@) % إليكم يا بني الاحرار ألقت % % مسامعها الخليقة فاستنيروا % % 6(@)(@@) % بنور العلم فهو لكم دليل % % وفضل العلم يعرفه الخبير % % 7(@)(@@) % فنعم الجند للإسلام أنتم % % ونعم الركن إن حزبت أمور % % 8(@)(@@) % أباة ما يقر الظلم فيكم % % حماة ما ينههكم فتور % % 9(@)(@@) % بني قومي لكم سلف كرام % % لهم في كل مكرمة ظهور % % 10(@)(@@) % إذا حمى الوطيس تجد أسودا % % يذل قبيلها منها الزئير % % PageV01P329 11(@)(@@) % وإن طلب القضاء تجد رجالا % % هم العلماء والنيل البحور % % 12(@)(@@) % إذا حكموا تجد حكما رشيدا % % عليه من الحق المبين بها ونور % % 13(@)(@@) % وفينا من ليوث الله ملك % % همام لا يلين ولا يخور % % 14(@)(@@) % مجد في سبيل الله يحمى % % حماه كأنه أسد هصور % % 15(@)(@@) % نمته إلى العلاء جدود صدق % % غطاريف حجاجحة صقور % % 16(@)(@@) % يحبون الهدى وبه تواصوا % % به أوصى صغيرهم الكبير % % 17(@)(@@) % وأني لو أجدت النظم فيه % % وجاء كأنه الدر النثير % % 18(@)(@@) % فقبيلي لن يحوز له خصالا % % ومثلي في محامده يحور % % 19(@)(@@) % وأيضا فهو عن مدحي غني % % شموس من فضائله تنير % % 20(@)(@@) % ولكن ما بقيت بقدر وسعى % % إلى مجد الأوائل استثير % % PageV01P330 21(@)(@@) % وإن كنت الحقير وكان قبلي % % ضعيف السبك حاويه القصور % % 22(@)(@@) % فما شرط النصحية يا صاحبي % % زهير والفرزدق أو جرير % % PageV01P331 البحر : بسيط تام 1(@)(@@) % الله أعظم مما 
ms110	 جال في الفكر % % وحكمه في البرايا حكم مقتدر % % 2(@)(@@) % مولى عظيم حكيم واحد صمد % % حي قديم مريد فاطر الفطر % % 3(@)(@@) % يا رب يا سامع الأصوات صل على % % رسولك المجتبى من أطهر البشر % % 4(@)(@@) % محمد المصطفى الهادي البشير هدى % % كل الخلائق بالآيات والسور % % 5(@)(@@) % وآله والصحاب الكائنين به % % كأنجم حوله من يسمو على القمر % % 6(@)(@@) % أشكو إليك أمورا أنت تعلمها % % فتور عزمي وما فرطت في عمري % % 7(@)(@@) % وفرط ميلي إلى الدنيا وقد حسرت % % عن ساعد الغدر في الآصال والبكر % % 8(@)(@@) % يا ربنا جد بتوفيق ومغفرة % % وحسن عاقبة في الورد والصدر % % 9(@)(@@) % قد اصبح الخلق في خوف وفي ذعر % % وزور لهو وهم في أعظم الخطر % % 10(@)(@@) % واللقيامة أشراط وقد ظهرت % % بعض العلامات والباقي على الأثر % % PageV01P332 11(@)(@@) % قل الوفاء فلا عهد ولا ذمم % % واستحكم الجهل في البادين والحضر % % 12(@)(@@) % باعوا لأديانهم بالبخس من سحت % % وأظهروا الفسق بالعدوان والأشر % % 13(@)(@@) % وجاهروا بالمعاصي وارتضوا بدعا % % عمت فصاحها يمشي بلا حذر % % 14(@)(@@) % وطالب الحق بين الناس مستتر % % وصاحب الإفك فيهم غير مستتر % % 15(@)(@@) % والوزن بالويل والأهواء معتبر % % والوزن بالحق فيهم غير معتبر % % 16(@)(@@) % وقد بدا النقص في الإسلام مشتهرا % % وبدلت صفوة الخيرات بالكدر % % 17(@)(@@) % وسوف يخرج دجال الضلالة في % % هرج وقحط كما قد جاء في الخبر % % 18(@)(@@) % ويدعى أنه رب العباد وهل % % تخفى صفات كذوب ظاهر العور % % 19(@)(@@) % فناره حنة طوبى لداخلها % % وزور جنته نار من السعر % % 20(@)(@@) % شهر وعشر ليال طوال مدته % % لكنها عجب في الطول والقصر % % PageV01P333 21(@)(@@) % فيبعث الله عيسى ناصرا حكما % % عدلا ويعضده بالنصر والظفر % % 22(@)(@@) % فيتبع الكاذب الباغي ويقتله % % ويمحق الله أهل البغي والضرر % % 23(@)(@@) % وقام عيسى يقيم الحق متبعا % % شريعة المصطفى المختار من مضر % % 24(@)(@@) % في أربعين من الأعوام مخصبة % % فيكسب المال فيها كل مفتقر % % 25(@)(@@) % وجيش يأجوج مم مأجوج قد خرجوا % % والبغي عم يسيل غير منهمر % % 26(@)(@@) % حتى إذا أنقذ الله القضاء دعا % % عيسى فأفناهم المولى على قدر % % 27(@)(@@) % وعباد للناس عبد الخير مكتملا % % حتى يتم لعيسى آخر العمر % % 28 
ms111	(@)(@@) % والشمس حين ترى في الغرب طالعة % % طلوعها آية من أعظم الكبر % % 29(@)(@@) % فعند ذلك لا إيمان يقبل من % % أهل الجحود ولا عذر لمعتذر % % 30(@)(@@) % ودابة في وجوه المؤمنين لها % % وسم من النور والكفار بالقبر % % PageV01P334 31(@)(@@) % والخلف هل فتنة الدجال قبلهما % % أو بعد قد ورد القولان في الخبر % % 32(@)(@@) % وكم خراب وكم خسف وزلزلة % % وفيح نار وآيات من الندر % % 33(@)(@@) % ونفخة تذهب الأرواح شدتها % % إلا الذين عنوا في سورة الزمر % % 34(@)(@@) % وأربعون من الأعوام قد حسبت % % نفخا تبث به الأرواح في الصور % % 35(@)(@@) % قاموا حفاة عراة مثل ما خلقوا % % من هول ما عاينوا سكرى بلا سكر % % 36(@)(@@) % قوم مشاة وركبان على نجب % % عليهموا حلل أبهى من الزهر % % 37(@)(@@) % ويسحب الظالمون الكافرون على % % وجوههم وتحيط النار بالشرر % % 38(@)(@@) % والشمس قد أدنيت والناس في عرق % % وفي زحام وفي كرب وفي حصر % % 39(@)(@@) % والأرض قد بدلت بيضاء ليس لها % % خفض ولا ملجأ يبدو لمستتر % % 40(@)(@@) % طال الوقوف فجاءوا آدما ورجوا % % شفاعة من أبيهم أول البشر % % PageV01P335 41(@)(@@) % فرد ذاك إلى نوح فردهم % % إلى الخليل فأيدي وصف مفتقر % % 42(@)(@@) % إلى الكليم إلى عيسى فزدهم % % إلى الحبيب فلباها بلا حصر % % 43(@)(@@) % فيسأل المصطفى فصل القضاء لهم % % ليستريحوا من الأهوال والخطر % % 44(@)(@@) % تطوي السموات والأملاك هابطة % % حول العباد لهول معضل عسر % % 45(@)(@@) % والشمس قد كورت والكتب قد نشرت % % والأنجم انكدرت ناهيك عن كدر % % 46(@)(@@) % وقد تجلى إله العرش مقتدا % % سبحانه جل عن كيف وعن فكر % % 47(@)(@@) % فيأخذ الحق للمظلوم منتصفا % % من ظالم جار في العدوان والبطر % % 48(@)(@@) % والرزن بالقسط والأعمال قد ظهرت % % ووزنها عبرة تبدو لمعتبر % % 49(@)(@@) % وكل من عبد الأوثان يتبعها % % بإذن ربي وصار الكل في سقر % % 50(@)(@@) % والمسلمون إلى الميزان قد قسموا % % ثلاثة فأسمعوا تسقيم مختصر % % PageV01P336 51(@)(@@) % فسابق رجحت ميزان طاعته % % له الخلود بلا خوف ولا ذعر % % 52(@)(@@) % ومذنب كثرت آثامه فله % % شفع بأوزاره أو عفو مفتقر % % 53(@)(@@) % وواحد قد تساوت حالتاه % % له حبس وبين البشر والحصر % % 54(@)(@@) % ويكرم الله مثواه بجنته % % بجود فضل عميم غير 
ms112	 منحصر % % 55(@)(@@) % وفي الطريق صراط مدفوق لظى % % كحد سيف سطا في دقة الشعر % % 56(@)(@@) % الناس في ورده شتى فمستبق % % كالبرق والطير أو كالخيل في النظر % % 57(@)(@@) % ساعي وماش ومخدش ومعتلق % % ناج وكم ساقط في النار منتثر % % 58(@)(@@) % للمؤمن وروده بعده صدر % % والكافرون لهم ورود بلا صدر % % 59(@)(@@) % فشفع المصطفى والأنبياء ومن % % يختاره الملك الرحمن في زمر % % 60(@)(@@) % في كل عاص له نفس مقصرة % % وقلبه عن سوى الرب العظيم برى % % PageV01P337 61(@)(@@) % فأول الشعفا حقا وأخرهم % % محمد ذو البهاء الطيب العطر % % 62(@)(@@) % مقامه ذروة الكرسي ثم له % % عقد اللواء بعز غير منحصر % % 63(@)(@@) % والحوض يشرب منه المؤمنون غدا % % كالارى يجري على الياقوت والدر % % 64(@)(@@) % ويخلق أقواما قد احترفوا % % كانوا أولى العزة الشنعاء والنجر % % 65(@)(@@) % والنار مثوى لأهل الكفر كلهم % % طياقيا سبعة مسودة الحفر % % 66(@)(@@) % جهنم ولظى والحطم بينهم % % ثم السعير كما الأهوال في سقر % % 67(@)(@@) % وتحت ذلك جحيم ثم هاوية % % يهوي بها أبدا سحقا لمحتقر % % 68(@)(@@) % في كل باب عقوبات مضاعفة % % وكل واحدة تسطو على النفر % % 69(@)(@@) % فيها غلاظ شداد من ملائكة % % قلوبهم شدة أقوى من الحجر % % 70(@)(@@) % لهم مقامع للتعذيب مرصدة % % وكل كسر لديهم غير منجبر % % PageV01P338 71(@)(@@) % سوداء مظلمة شعثاء موحشة % % دهماء مخرفة لواحة البشر % % 72(@)(@@) % فيها الجحيم مذيب الوجوه مع % % الأمعاء مر شدة الإحراق والشرر % % 73(@)(@@) % فيها الغساق الشديد البرة يقطعهم % % إذا استغاثوا بحر ثم مستعر % % 74(@)(@@) % فيها السلاسل والأغلال تجمعهم % % مع الشياطين قسرا جمع منقهر % % 75(@)(@@) % فيها العقارب والحياة قد جعلت % % جلودهم كالبغال الدهم والحمر % % 76(@)(@@) % والجموع والعطش المضني ولا نفس % % فيها ولا جلد فيها لمصطبر % % 77(@)(@@) % لها إذا ما علت فور يقلبهم % % ما بين مرتفع منها ومنحدر % % 78(@)(@@) % جمع النواصي مع الإقدام صيرهم % % كالقوس محنية من شدة الوتر % % 79(@)(@@) % لهم طعام من الزقوم يعلق في % % حلوقهم شوكة كالصاب والصبر % % 80(@)(@@) % يا ولهم عضت النيران أعظمهم % % بالموت شهوتهم من شدة الضجر % % PageV01P339 81(@)(@@) % ضجوه وصاحوا أزمانا ليس ينفعهم % % دعا داع ولا تسليم مصطبر % % 82(@)(@@) % وكل يوم لهم في طول مدتهم 
ms113	 % % نزع شديد من التعذيب والسعر % % 83(@)(@@) % كم بين دار هوان لا انقضاء لها % % ودار أمن وخلد دائم الدهر % % 84(@)(@@) % دار الذين اتقوا مولاهم وسعوا % % قصدا لنيل رضاه سعى مؤتمر % % 85(@)(@@) % وآمنوا واستقاموا مثل ما أمروا % % واستغرقوا وقتهم في الصوم والسهر % % 86(@)(@@) % وجاهدوا وانتهوا عما يباعدهم % % عن بابه واستلانوا كل ذي وعر % % 87(@)(@@) % جنات عدن لهم ما يشتهون بها % % في مقعدين الصدق الروض والزهر % % 88(@)(@@) % بناؤها فضة قد زانها ذهب % % وعينها المسك والحصبا من الدرر % % 89(@)(@@) % أوراقها ذهب منها الغصون دنت % % بكل نوع من الريحان والثمر % % 90(@)(@@) % أوراقها حلل شفافه خلقت % % واللؤلؤ الرطب والمرجان في الشجر % % PageV01P340 91(@)(@@) % دار النعيم وجنات الخلود لهم % % دار السلام مأمونة الغير % % 92(@)(@@) % وجنة الخلد والمأوى وكم جمعت % % جنات عدن لهم من مونق نصر % % 93(@)(@@) % طباقها درجات عدها مائة % % كل اثنتين كبعد الأرض والقمر % % 94(@)(@@) % أعلى منازلها الفردوس عاليها % % عرش الإله فسل واطمع ولا تذر % % 95(@)(@@) % أنهارها عسل مافيه شائبة % % وخالص اللبن الجاري بلا كدر % % 96(@)(@@) % وأطيب الخمر والماء الذي سلت % % من الصداع ونطق اللهو والسكر % % 97(@)(@@) % والكل تحت جبال المسك منبعها % % يجرونه كيف شاؤوا غير محتجر % % 98(@)(@@) % فيها نواهد أبكار مزينة % % يبرزن من حلل في الحسن والخفر % % 99(@)(@@) % نساؤها المؤمنات الصابرات على % % حفظ العهود مع الإملاق والضرر % % 100(@)(@@) % كأنهم بدور في غصون نقا % % على كثيب بدت في ظلمة السحر % % PageV01P341 101(@)(@@) % كل امرىء منهم يعطى قوى مائة % % في الأكل والشرب والأفضا بلا خور % % 102(@)(@@) % طعامهم رشح مسك كلما عرقوا % % عادت بطونهم في هضم منصمر % % 103(@)(@@) % لا جوع لا برد لا هم ولا نصب % % بل عيشهم عن جميع النائبات عرى % % 104(@)(@@) % فيها الوصائف والغلمان تخدمهم % % كلؤلؤ في كمال الحسن منتثر % % 105(@)(@@) % فيها الغناء والجواري الغانيات لهم % % يا حسن الذكر للمولى مع السمر % % 106(@)(@@) % لباسهم سندس حلاتهم ذهب % % ولؤلؤ ونعيم غير منحصر % % 107(@)(@@) % والذكر كالنفس الجاري بلا تعب % % ونزهوا عن كلام اللغو والهذر % % 108(@)(@@) % وأكلها دائم لاشيء منقطع % % كرر أحاديثها باطيب الخبر % % 109(@)(@@) % فيها من الخير ما لم يجر 
ms114	 في خلد % % ولم يكن مدركا للسمع والبصر % % 110(@)(@@) % فيها رضا الملك المولى بلا غضب % % سبحانه ولهم نفع بلا غير % % PageV01P342 111(@)(@@) % لهم من الله لا نظير له شيء % % سماع تسليمه والفوز بالنظر % % 112(@)(@@) % بغير كيف ولا حد ولا مثل % % حقا كما جاء في القرآن والخبر % % 113(@)(@@) % وهي الريادة والحسنى التي وردت % % وأعظم الموعد المذكور في الزبر % % 114(@)(@@) % لله قوم أطاعوه وما قصدوا % % سواه إذا نظروا الأكوان بالعبر % % 115(@)(@@) % وكابدوا الشوق والأنكاد قوتهم % % ولازموا الجد والأذكار في البكر % % 116(@)(@@) % يا مالك الملك جد لي بالرضا كرما % % فأنت لي محسن في سائر العمر % % 117(@)(@@) % يا رب صل على الهادي البشير لنا % % وآله وانتصر يا خير منتصر % % 118(@)(@@) % ما هب نشر صبا واهتز نبت ربا % % وفاح طيب شذا في نسمة السحر % % 119(@)(@@) % أبياتها تسع عشر بعدها مائة % % كلامها وعظها أبهى من الدرر % % PageV01P343 البحر : بسيط تام 1(@)(@@) % العز والمجد في الهندية القضب % % لا في الرسائل والتنميق للخطب % % 2(@)(@@) % نقضي المواضي فيمضها حكمها أمما % % إن خالج الشك رأى الحاذق الأرب % % 3(@)(@@) % وليس يبنى العلا إلا ندى ووغى % % هما المعارج للأسنى من الرتب % % 4(@)(@@) % ومشمعل أخو عزم يشيعه % % قلب صروم إذا ما هم لم يهب % % 5(@)(@@) % لله طلاب أوتار أعدلها % % سيرا حثيثا بعزم غير مؤتشب % % 6(@)(@@) % ذاك الإمام الذي كادت عزائمه % % تسمو به فوق هام النسر والقطب % % 7(@)(@@) % عبد العزيز الذي ذلت لسطوته % % شوس الجبابر من عجم ومن عرب % % 8(@)(@@) % ليث الليوث أخو الهيجاء معرها % % السيد المنجب ابن السادة والنجب % % 9(@)(@@) % قوم هم زينة الدنيا وبهجتها % % وهم لها عمد ممدودة الطنب % % 10(@)(@@) % لكن شمس ملوك الأرض قاطبة % % عبد العزيز بلامين ولا كذب % % PageV01P344 11(@)(@@) % قاد المكانب يكسو الجو عثيرها % % سماء مرتكم من نقع مرتكب % % 12(@)(@@) % حتى إذا وردت ماء الصراة وقد % % صارت لواحق أقرب من السغب % % 13(@)(@@) % قال النزال لنا في الحرب شنشة % % تمشي إليها ولو جثيا على الركب % % 14(@)(@@) % فسار من نفسه في جحفل حرد % % وسار من جيشه من عسكر لجب % % 15(@)(@@) % حتى تسور حيطانا وأبنية % % لولا 
ms115	 القضاء لما ادركن بالسبب % % 16(@)(@@) % لكنها عزمة من فاتك بطل % % حمى بها حوزة الإسلام والحسب % % 17(@)(@@) % فبيت القول صرعى خمر نومهم % % وآخرين سكارى بابنة العنب % % 18(@)(@@) % في ليلة شاب قبل الصبح مفرقها % % لو كان تعقل لم تملك من الرعب % % 19(@)(@@) % القحتها في هزبع الليل فامتخضت % % قبل الصباح فألقت بيضة الحقب % % 20(@)(@@) % كانوا يصدونها نحسا مذممة % % والله قدرها مزاجة الكرب % % PageV01P345 21(@)(@@) % صب الإله عليهم سوط منتقم % % من كف محتسب لله مرتقب % % 22(@)(@@) % في أول الليل في لهو وفي لعب % % وآخر الليل في ويل وفي حرب % % 23(@)(@@) % الله أكبر هذا الفتح قد فتحت % % به من الله أبواب بلا حجب % % 24(@)(@@) % فتح تورج هذا الكون نفحته % % ويلبس الأرض زي المارح الطرب % % 25(@)(@@) % فتح به أضحت الإحساء طاهرة % % من رجسها وهي فيما مركا لجنب % % 26(@)(@@) % شكرا بني هجر للمقرني فقد % % من قبله كنتم في هوة العطب % % 27(@)(@@) % قد كنتم قبله نهبا بمضيعة % % ما بين مفترس منكم ومستلب % % 28(@)(@@) % روم تحكم فيكم رأى ذي سفه % % إحكام معتقد التثليث والصلب % % 29(@)(@@) % وللأعاريب من أموالكم عبث % % يمرونكم مرى ذات الصفر في الحلب % % 30(@)(@@) % وقبلكم حين نجد واستطير به % % فماذه بشفار البيض واليلب % % PageV01P346 31(@)(@@) % شوارد قبيتها صدق عزمته % % فظللن يرفسن بعد ألوخذ والخبب % % 32(@)(@@) % ملك يؤود الرواسي حمل همته % % لو كان يمكن أرقنه إلى الشهب % % 33(@)(@@) % ويركب الخطب لا يدري نواجذه % % تفتر عن ظفر من ذاك أو شجب % % 34(@)(@@) % إذا الملوك استلانوا الفرش وأتكئوا % % على الأرائك بين الخرد العرب % % 35(@)(@@) % ففي المواضي وفي السمر اللدان وفرال % % جرد الجياد له شغل عن الطرب % % 36(@)(@@) % يا أيها الملك الميمون طائره % % اسمع هديت مقال الناصح الحدب % % 37(@)(@@) % اجعل مشيرك في أمر تحاوله % % مهذب الرأي ذا علم وذا أدب % % 38(@)(@@) % وقدم الشرع ثم السيف أنهما % % قوام ذا الخلق في بدء وفي عقب % % 39(@)(@@) % هما الدواء لأقوام إذا صعرت % % خدودهم واستحقوا صولة الغضب % % 40(@)(@@) % واستعمل العفو عمن لا نصير له % % إلا الإله فذاك العز فاحتسب % % PageV01P347 41(@)(@@) % واعقد مع الله عزما للجهاد فقد % % أوتيت 
ms116	 نصر عزيزا فاستقم وثب % % 42(@)(@@) % وأكرم العلماء العاملين وكن % % بهم رحيما تجده خير منقلب % % 43(@)(@@) % واحذر أناسا أصاروا العلم مدرجة % % لما يرجون من جاه ومن نشب % % 44(@)(@@) % هذا وفي علمك المكنون جوهره % % ما كان يغنيك عن تذكير محتسب % % 45(@)(@@) % وخذ شوارد أبيات مثقفة % % كأنها درر فصلن بالذهب % % 46(@)(@@) % زهت بمدحك حتى قال سامها % % الله أكبر كل الحسن في العرب % % 47(@)(@@) % ثم الصلاة وتسليم الإله على % % من خصه الله بالأسنى من الكتب % % 48(@)(@@) % المصطفى من أروم طاب عنصرها % % محمد الطاهر بن الطاهر النسب % % 49(@)(@@) % والآل والصحب ما ناحت مطوقة % % وما حدا الرعد بالهامر من السحب % % PageV01P348 البحر : طويل 1(@)(@@) % شموس من التحقيق في طالع السعد % % تجلت فاحلت ظلمة الهزل والجد % % 2(@)(@@) % قواطع من آي الكتاب كأنها % % بأعناق أهل الزيغ مرهفة الحد % % 3(@)(@@) % إذا ماتلاها منصف ومحقق % % يقول هي الحق المبين بلا جحد % % 4(@)(@@) % ويصدف عنها مبطل متعسف % % يقلد آراء الرجال بلا نقد % % 5(@)(@@) % يجر أقاويل الرسول وفعله % % إلى رأيه الغاوي ومذهبه المردي % % 6(@)(@@) % كفانا هم من لم يزل متجردا % % لنصر الهدى والدين أكرم به مهدى % % 7(@)(@@) % سليمان من سارت فضائل مجده % % مسير مهب الريح في الفور والنجد % % 8(@)(@@) % وما قاله الصغار أيه جهلة % % وعنوان بطلان العقيدة والقصد % % 9(@)(@@) % ولو كان ذا عقل لأصبح سائلا % % أولي العلم والتحقيق من كل مستهدى % % 10(@)(@@) % فقال بعلم إذ تفوه قائلا % % وإلا رأى الإمساك خيرا فلم يبد % % PageV01P349 11(@)(@@) % لعمرك ما التقوى بلبس عمامة % % ولا تركها فاسلك سبيل أولي الرشد % % 12(@)(@@) % ولكن يجوف المرء والله مضفة % % عليها مدار الحل في الدين والعقد % % 13(@)(@@) % فكن واقفا عند المحارم زاجرا % % عن البغي نفسا تستبيك لما يردى % % 14(@)(@@) % وخذيمنة واسلك سبيل الأولى مضوا % % من الرسل والآل الكرام أولى المجد % % 15(@)(@@) % وإياك والإقدام بالقول حاكما % % بحل وتحريم بلا حجة تجدي % % 16(@)(@@) % فتصبح في بير الضلالة هائما % % وتصدف يوم الحشر عن جنة الخلد % % 17(@)(@@) % ونهيك أن تقرأ رسائل عالم % % لديكم فخذلان لكم واضح مردي % % 18(@)(@@) % أليس بها آيات حق قواطعا % % تدل على الأمر 
ms117	 المراد من العبد % % 19(@)(@@) % وأقوال خير المرسلين وصحبه % % وأهل النهى والعلم من كل مستهدى % % 20(@)(@@) % فمن كان يوما نابذا مثل هذه % % يقول بأقوال الملاحدة اللد % % PageV01P350 21(@)(@@) % فما بعدها إلا الضلالة والمعى % % وما بعدها إلا العلوم التي تردى % % 22(@)(@@) % ودونك مني إن قبلت نصيحة % % وما كل منصوح يوفق للرشد % % 23(@)(@@) % تمسك بما في محكم النص ظاهرا % % وبالسنة القراء عن الصادق المهدي % % 24(@)(@@) % وطالع تصانيف الإمام محمد % % وأبنائه أهل الدراية والنقد % % 25(@)(@@) % فإن بها ما يطفىء الغلة التي % % بها من أوار الجهل وقد على قد % % 26(@)(@@) % هم قدوة من ذا الزمان وحجة % % وميزان عدل لا يميل عن القصد % % 27(@)(@@) % وقل لابن فهد أن رويدك إنما % % تسير على نهج من الجهل ممتد % % 28(@)(@@) % سيندم مما قال يوم معادنا % % إذا انكشف المستور من موقف الحشد % % 29(@)(@@) % وما كان ذا علم وحلم ولا حجى % % ولكنه بالإفك يلجم أو يبدي % % 30(@)(@@) % فلا تكثرث من عصبة قد توازروا % % على عيب أهل الفضل والمدح للضد % % PageV01P351 31(@)(@@) % ومالوا مع النفس المظلة والهوى % % لنيل حظوظ من ثناء ومن رفد % % 32(@)(@@) % وكيما يقول الجاهلون بحالهم % % بهم ولهم فرق وذا القصد لا يجدي % % 33(@)(@@) % فسل ربك التثبيت واسأله عصمة % % تقيك الردى حتى توسد في اللحد % % 34(@)(@@) % ولولا الذي قد قاله الجد قبلنا % % لكلنا له بالصاع كيلا بلا عد % % 35(@)(@@) % ودونكها مني عجالة راكب % % تراوح ما بين الزميل إلى الوخد % % 36(@)(@@) % وصل إلهي ماهمي الودق أوشد % % على الأيك نواح العشيات والبرد % % 37(@)(@@) % على المصطفى الهادي الأمين وآله % % وأصحابه أهل الحفيظة والجد % % PageV01P352 البحر : طويل 1(@)(@@) % ابى الله إلا أن تكون لك العقبى % % ستملك شرق الأرض بالله والغرباء % % 2(@)(@@) % أراد بك الأعداء ما الله دافع % % كفا كهم لما رضيت به ربا % % 3(@)(@@) % هم يدلوا نعماك كفرا وبوءوا % % نفوسهم دار البوار فما أغبى % % 4(@)(@@) % بغاث تصدت للصقور سفاهة % % فأضحت جزافا من مخالبها نهبا % % 5(@)(@@) % أرادوا شقاق المسلمين شقاوة % % فصب الشقاء ربي على أهله صبا % % 6(@)(@@) % هم أضرموا نارا فكانوا وقودها % % وهم جردوا سيفا فكانوا به خدبا 
ms118	 % % 7(@)(@@) % دعاهم إلى الأمر الرشيد أمامهم % % وقال هلموا للكتاب وللعتبى % % 8(@)(@@) % وما كان بالنزق العجول وإنما % % يديرهم تدبير من طب من حبا % % 9(@)(@@) % فلما أبو إلا الشقاق وأصبحوا % % على شيعة الإسلام من زعمهم البا % % 10(@)(@@) % أتاهم سليل الغاب يصرف نابه % % زماجرة قبل اللقاء ترعب القلبا % % PageV01P353 11(@)(@@) % له همم لا تنتهي دون قصده % % ولو كان ما يبقيه في نفسه صعبا % % 12(@)(@@) % بجيش يسوق الطير والوحش زجره % % فلم تر وكرا عامرا لا ولا سربا % % 13(@)(@@) % وجرد عليها كل أغلب باسل % % إذا ما دعى من معرك للقنا لبا % % 14(@)(@@) % فعاد غبار الجو بالنقع قاتما % % تظن اشتغال البيض في ليلة شهبا % % 15(@)(@@) % وأضحوا هدايا للسباع تنوشهم % % تنويهم يوما وتعتادهم غبا % % 16(@)(@@) % وراحت لطير الجو عيشى ونقرى % % ونادي وحوشا في مكانها سغبا % % 17(@)(@@) % ولو لم يكفكف خيله عن شريدهم % % لما آب منهم مخبر خب أودبا % % 18(@)(@@) % فقل للبغاة المستحلين جهرة % % دماء بني الإسلام تبا لكم تبا % % 19(@)(@@) % نبذتم كتاب الله حين دعيتم % % إليه وقلتم بالكتابين لانعبا % % 20(@)(@@) % وقلدتم أشقاكم أمر دينكم % % فأصبحتم عن شرعة المصطفى نكبا % % PageV01P354 21(@)(@@) % نعم ثبت الله الذين تبؤوا % % من الدين والإيمان منزله رحبا % % 22(@)(@@) % هم حفظوا العهد الذي خنتم به % % فكانوا لأهل الدين مذهاجر واصبحا % % 23(@)(@@) % وهم صدقوا الله العهود وآمنوا % % أمامهم صدقا فلالا ولا كذبا % % 24(@)(@@) % إمام الهدى إن العدو إذا رأى % % له فرصة في الدهر ينزو لها وثبا % % 25(@)(@@) % ومن ألجأته للصداقة علة % % يكن سلمه من بعد علتها حربا % % 26(@)(@@) % فعاقب وعاتب كل شخص بذنبه % % فلولا العقوبات استخف الورى الذنبا % % 27(@)(@@) % وقد رتب الله الحدود لتنتهي % % مخافتها عما به يغضب الربا % % 28(@)(@@) % إذا أنت جازيت المسيء بفعله % % فلا حرج فيما أتيت ولا ذنبا % % 29(@)(@@) % فمن سل سيف البغي فاجعله نسكه % % ومن شب نارا فارمه وسط ماشبا % % 30(@)(@@) % بذا يستقيم الأمر شرعا وحكمة % % وينزجر الباغي إذا هم أوهبا % % PageV01P355 31(@)(@@) % ومن تاب فهم فاعف عنه تفضلا % % فحسبهم ما قد لقو منكم حسبا % % 32(@)(@@) % فقد حمدوا في بعض ما قد مضى لهم 
ms119	 % % فإن رجعوا فالعود للذنب قد جبا % % 33(@)(@@) % فرب كبير الذنب من جنب عفوكم % % صغير ولكن إن هم طلبوا العتبى % % 34(@)(@@) % ومثلك لم تقرع لتنبيهه العصا % % عرفت نصيح القلب منهم ومن حبا % % 35(@)(@@) % وأذكى صلاة مع سلام على الذي % % نرى مسؤوله منا المودة من القربى % % PageV01P356 البحر : بسيط تام 1(@)(@@) % تلألأت بك للإسلام أنوار % % كما جرت بك للإسعاد أقدار % % 2(@)(@@) % إن الذي قدر الأشياء بحكمته % % لما يريد من الخيرات يختار % % 3(@)(@@) % والعبد إن صلحت لله نيته % % لابد يبد ولها في الكون آثار % % 4(@)(@@) % سر بديع أراد الله يظهره % % لما أتيت وكم في الغيب أسرار % % 5(@)(@@) % وحكمة بك رب العرش أظهرها % % كالنور وأراه فبل القدح أحجار % % 6(@)(@@) % تألفت بك أهوار مغرقة % % تأججت بينهم من قبلك النار % % 7(@)(@@) % فأصبحوا بعد توفيق الإله لهم % % بعد الشقاء والجفاء في الدين أخيار % % 8(@)(@@) % قل للذين بلغظ الرشد قد نبزوا % % الإسم إن لم يطابق فعله عار % % 9(@)(@@) % أرداكم أظنكم بالله من سفه % % أن ليس يوجد للإسلام أنصار % % 10(@)(@@) % رأيتم طاعة الأتراك واجبة % % لأنهم عندكم للبيت عمار % % PageV01P357 11(@)(@@) % كأنكم لم تروا ما براءة أم % % زاغت بصائركم عنها وأبصار % % 12(@)(@@) % كذلك الشرك والكفر العظيم لهم % % فيه وفي الشر إقبال وإدبار % % 13(@)(@@) % وعندهم أن أحكام الكتاب بها % % على الخليقة أجحاف وأضرار % % 14(@)(@@) % فخالفوها بأوضاع ملفقة % % وهم بأوضاعهم لاشك كفار % % 15(@)(@@) % فليت شعري إذا جهل بحالهم % % أم اتباع الهوى والفى خمار % % 16(@)(@@) % لما عوت أكلب الأتراك بينكم % % رقصتم حين % % 17(@)(@@) % هلا اتبعتم إماما جل مقصده % % للمسلمين وللإسلام إظهار % % 18(@)(@@) % عبد العزيز الذي اشتاقت لرؤيته % % وعهده في فسيح الأرض أمصار % % 19(@)(@@) % فرع الأثمة من بعد الرسول وهم % % لدائل من قديم الدهر أقمار % % 20(@)(@@) % كنا نمر على الأموات تغبطهم % % من قبله إذ تولى الأمر أشرار % % PageV01P358 21(@)(@@) % فالآن طابت به الأيام إذ أخذت % % به لأهل الهدى والدين أوتار % % 22(@)(@@) % إني أقول وخير القول أصدقه % % إن كان ينفعكم ندر وأندار % % 23(@)(@@) % لا تحسبوها أحاديثا مزخرفة % % يلهو بها وسط نادي الحي سمار % % 24(@)(@@) % لتقرعن قريبا من ذي 
ms120	 ندم % % غداة يسلمكم للحين غرار % % 25(@)(@@) % إذا أتتكم حماة الدين يقدمهم % % ليث هزبر له ناب وأظفار % % 26(@)(@@) % شثن البرائن لا تعدو فرائسه % % صيد الملوك وإلا تخرب الدار % % 27(@)(@@) % من الأولى اتخذوا الماذي لباسم % % إذا تشاجر لدن السمر خطار % % 28(@)(@@) % الجابرين صدوع المعتقين وما % % عنهم مجير لدى بغي ولا جار % % 29(@)(@@) % كم قد أعاد وأبدى نصحكم شفقا % % لو كان منكم لكم بالرشد إمار % % 30(@)(@@) % وأجهل الناس من لم يدر قيمته % % أو عزه إن خلا الميدان إحضار % % PageV01P359 31(@)(@@) % ومن بنى في جيل السيل منزله % % لابد يأتيه يوما منه دمار % % 32(@)(@@) % لكنه غركم من ليس يسعدكم % % عبيد سوء وأعراب وصغار % % 33(@)(@@) % إن الحصون إلى البلوى ستسلمكم % % كما جرى للذي أعلى سنمار % % 34(@)(@@) % لكم رأى حصركم من قعر داركم % % فيه احتقار لكم أيضا وإصغار % % 35(@)(@@) % فأضرم النار جهرا من جوانبكم % % حامي الحقائق للهيجاء مسعار % % 36(@)(@@) % ابن الإمام الذي قد كان أرصده % % لكم أبوه شهابا فيه إعصار % % 37(@)(@@) % والشبل لا غرو أن تعدو مسالكه % % مسالك الليث لم يمتد مضمار % % 38(@)(@@) % تركتم صورة جذماء ليس لها % % كف لبطش ولا رجل إذا ساروا % % 39(@)(@@) % إن لم تنيبوا إلى الإسلام فانتظروا % % يوما عليكم له ذكر وأخبار % % 40(@)(@@) % هذا مقال امرىء يهدي نصيحته % % والنصح فيه لأهل اللب تذكار % % PageV01P360 41(@)(@@) % ثم الصلاة على الهادي وشيعته % % وصخبه ما شدا في الأيك أطيار % % PageV01P361 البحر : بسيط تام 1(@)(@@) % أهكذا البدر تخفي نوره الحفر % % ويفقد العلم لا عين ولا أثر % % 2(@)(@@) % خبت مصابيح كنا نستضىء بها % % وطوحت للمغيب الأنجم الزهر % % 3(@)(@@) % واستحكمت غربة الإسلام وانكسفت % % شمس العلوم التي يهدي بها البشر % % 4(@)(@@) % تخرم الصالحون المقتدى بهم % % وقام منهم مقام المبتدأ الخبر % % 5(@)(@@) % فلست تسمع إلا كان ثم مضى % % ويلحق الفارط الباقي كما غبروا % % 6(@)(@@) % والناس في سكرة من خمر جهلهم % % والصحو في عسكر الأموات لو شعروا % % 7(@)(@@) % نلهو بزخرف هذا العيش من سفه % % لهو المنبت عودا ما له ثمر % % 8(@)(@@) % وتستحث منايانا رواحلنا % % لموقف ما لنا عن موته صدر % % 9(@)(@@) % ألا إلى موقف ثيروا 