ms348	 الح % % 66(@)(@@) % ظ حداء أبن قفرة بقعود % يا لك أبنا ووالدين وجدي % 67(@)(@@) % ن يرون الجبال في أخدود % لحقوا بالكواكب الزهروالعي % 68(@)(@@) % يوق نائي المنال من هبود % خير جرثومة وأنضر فرع % 69(@)(@@) % بين هذي وذاك أنجب عود % ذلك العود قاسم كرم العو % % 70(@)(@@) % د ومرسى العروق غير الصلود % فهو يهتز فوق منصشه المم % PageV01P1279 71(@)(@@) % هد في ظل فرعه اليمئود % ولهذا المولود تال من الحر % 72(@)(@@) % ةإن الركوع فحوى السجود % وكأن قد أتى الحسين بشيرا % 73(@)(@@) % باتصال الفتوح بعد السدود % فاستتمت يد من الله بيضا % % 74(@)(@@) % ء لبيضاء من يديه رفود % وغدا الصقر ناهجا بجناحي % 75(@)(@@) % ن إلى كل مرقب ذي كؤود % بل غدا السيف بين حديه عضبا % 76(@)(@@) % غير ذي نبوة ولا محدود % بل غدا الطود بين ركنين منه % 77(@)(@@) % مشرفا ركنه منيف الريود % بل بدا البدر بين سعدين لا % % 78(@)(@@) % يجهل عند الذكي والمبلود % لا عقمتم يا آل وهب فما الدن % 79(@)(@@) % يا لقوم أمثالكم بولود % كلكم ماجد ولم ير فيكم % % 80(@)(@@) % ماجد قط ذو أب ممجود % أنصل ينتضين من أنضل بي % % PageV01P1280 81(@)(@@) % ض كأمثالهن لا من غمود % وبدور طوالع من بدور % 82(@)(@@) % وشموس لا من دياجير سود % تنجلي أنجما وتعلو بدورا % 83(@)(@@) % في نظام متابع مسرود % مات أسلافكم فأنشرتموهم % 84(@)(@@) % فهم في القلوب لا في اللحود % لا يحلون من خواطر نفس % 85(@)(@@) % مع إحسانهم محلة مودي % % لا يقيسن قائس بكم قو % % 86(@)(@@) % ما فليس المعدوم كالموجود % نزل الناس بالتهائم كرها % 87(@)(@@) % ونزلتم برغمهم في النجود % كم مذود بكيدهم عن حبا المل % 88(@)(@@) % ك وما معتفيكم بمذود % يفخر الجند بالمناقبوالأع % 89(@)(@@) % مال أعمالكم فخار عنود % مثل ما تفخر اليهود بموسى % % 90(@)(@@) % وهو للمسمين دون اليهود % وكأين لحيلة ولرأي % PageV01P1281 91(@)(@@) % محصد من محين محصود % ولقد قلت قول صدق سيشفي % % 92(@)(@@) % صدقه كل مدنف معمود % أرقد الساهرين أن بني وه % 93(@)(@@) % ب عن النائبات غير رقود % واستهب الرقود للشكر فالأم % 94(@)(@@) % ة من ذي تهجد أو هجود % عضد فعمة لمعتضد بال 
ms349	 % 95(@)(@@) % له بالنصح منهم معضود % حرست دولة الكرام بني وه % 96(@)(@@) % ب غياث اللهيف والمنجود % دولة عاد نرجس الروض فيها % % 97(@)(@@) % من عيون وورده من خدود % أصلحت كل فاسد متماد % 98(@)(@@) % بجنود الدهاء لا بالجنود % فتحت للأمير فتحا مبينا % 99(@)(@@) % كل باب في ملكه مسدود % أيهذا الأميرألبسك الله % % 100(@)(@@) % بقاء الموجود لا المفقود % أنت بحر وآل وهب مدود % PageV01P1282 101(@)(@@) % عمر البحر ممتعا بالمدود % أبدوا الملكفهو ملك خلود % 102(@)(@@) % لا كعهد الكفور ملك بيود % وجدير بذاك ما استعمل الرأ % % 103(@)(@@) % ي ويمن الجدود ذات الصعود % ما بناء بناته آل وهب % 104(@)(@@) % بوضيع الذرا ولا مهدود % آل وهب قوم لهم عفة المغ % 105(@)(@@) % مد أظفاره ونفع الصيود % أرغبتهم عن القنا قصبات % 106(@)(@@) % مغنيات عن كل جيش مقود % لا تراها تعيث عيث الذئاب الط % 107(@)(@@) % لس لكن تصيد صيد الفهود % حين لا تجتبى وظيفة بيت ال % % 108(@)(@@) % مال من مرهق ولا مضهود % صححواوالمصصح الآمن القل % % 109(@)(@@) % ب خلاف المبهرج المزؤود % فلأقلامهم صرير مهيب % 110(@)(@@) % يزدرى عنده زئير الأسود % والقراطيس خافقات بأيدي % % PageV01P1283 111(@)(@@) % هم كمرهوب خافقات البنود % وهم راكبو النمارق أمضى % % 112(@)(@@) % من كماة على خناذيذ قود % من أناس قعودهم كقيام ال % % 113(@)(@@) % ناس لكنهم قليلو القعود % لا الذكاء استعار شر ولا الأح % % 114(@)(@@) % لام فيهم من فترة وخمود % دينهم أن يمس لين بلين % % 115(@)(@@) % ويصك الجلمود بالجلمود % منهم الغيث والصواعق في النا % % 116(@)(@@) % س وفي كل محلة جارود % فلهم تارة عدات بروق % 117(@)(@@) % ولهم تارة وعيد رعود % ولقد يوعدون ثم يذوبو % % 118(@)(@@) % ن سماحا إلى أوان الجمود % كم وعيد لهم تبلج عن صق % % 119(@)(@@) % ح ومنح تبلج الموعود % ووعيد لهم تكشف عن بط % % 120(@)(@@) % ش أبى حده اعتداء الحدود % برزوا في العلا ونام رجال % PageV01P1284 121(@)(@@) % برزوا في الكرى على عبود % إن يفوزوا يسبق كل مجار % 122(@)(@@) % بجدود سعيدة وجدود % فلقد بذهم أخوهم بشأو % 123(@)(@@) % تحسب الريح عنده في القيود % مدره الملك أمتعت قدماه % % 124(@)(@@) % بالمقام الموطأ الممهود % مهرب النفس مطلب العنس ملقى % % 125 
ms350	(@)(@@) % كل رحل محط كل قتود % ذو الأيدي على الجميع اللواتي % % 126(@)(@@) % شملت كل سيد ومسود % من أياديه قاسم حسب من عد % 127(@)(@@) % بذاك المعدود من معدود % أخدم الملك مرهفا في مضاء الس % % 128(@)(@@) % يف صلتا وقده المقدود % غرض العين غير منصرف عن % % 129(@)(@@) % ه إلى غيره ولا مصدود % وطر النفس غير مبترك في % % 130(@)(@@) % ه بذم له ولا مزهود % فاصطفاه أميره وجرى من % PageV01P1285 131(@)(@@) % ه وفاقا مجرى الزلال البرود % وحبانا به غياثا فأحيى % % 132(@)(@@) % برفود موصولة برفود % سائلي عن أبي الحسين بدا الصب % % 133(@)(@@) % ح فأغنى عن جذوة في وقود % نور عين سرور نفس وقانا % % 134(@)(@@) % ربنا فقده ولو بفقود % صفيت نفسه وظرف وعاها % % 135(@)(@@) % فهو صاف كالسلسل المورود % وألذ الشراب ماكان منه % % 136(@)(@@) % صافي العين صافي الناجود % لا ترى القاسم المؤمل إلا % % 137(@)(@@) % باكر الرفد شاكر المرفود % منشد المدح تحت أفياء عرف % 138(@)(@@) % ناشد طالبيه لا منشود % مستمدا من فعله كل قول % 139(@)(@@) % قيل فيه فما له من نفود % ومن السيف ماؤه ومن الطاه يمن الله طلعة المولود % % 140(@)(@@) % وحبا أهله بطول السعود % % فهم الضامنون حين توالى % % PageV01P1286 141(@)(@@) % منسيات العهود حفظ العهود % % والألى إن رعوا حلوبة مجد % 142(@)(@@) % لأولي الأمر لم تكن بجدود % % فليقل قائل لذي الصدر المي % 143(@)(@@) % مون منهم في أمره والورود % % أمتع الله ذو المواهب بالمو % 144(@)(@@) % هوب غير المخسس المنكود % بدر طلق وشمس دجن من الأم % % 145(@)(@@) % لاك جاءا بكوكب مسعود % وافد زار مستماحي وفود % % 146(@)(@@) % ومرتجى منه مستماح وفود % سله الله للخطوب من الغي % % 147(@)(@@) % ب كسل المهند المغمود % فيه عرف وفيه نكر معدا % % 148(@)(@@) % ن لأهل النهى وأهل المرود % وكمين الحريق في العود مخفى % 149(@)(@@) % وحقين الرحيق في العنقود % نجلته بيضاء من ملكات الر % 150(@)(@@) % وم تدعى لقيصر معبود % ليلة الأربعاء وهو من الأي % PageV01P1287 151(@)(@@) % ام يوم ما شئت من محمود % مأنحسا على ثمود وعاد % 152(@)(@@) % وسعودا لصالح ولهود % فالذي فيه إن نظرنا من الشر % 153(@)(@@) % لعاد بكفرها وعود % ولنا خيره وذروة منجا 
ms351	 % % 154(@)(@@) % ه لأنا أضداد أهل العنود % وهو يوم المظفرين بني العب % 155(@)(@@) % اس سقيا لظله الممدود % يوم صدق بنت يد الله فيه % % 156(@)(@@) % ملكهم فوق رأسه الموطود % وطلوع المولود فيه بشير % 157(@)(@@) % بسرور لأهله مولود % عاقد أمرهم بأمر بني العب % 158(@)(@@) % اس عقدا من محكمات العقود % مفصح فأله يخبر عن أز % 159(@)(@@) % ر بأزر من شكله مشدود % آل وهب فوزا لكم بسليما % % 160(@)(@@) % ن وكبتا للحاسد المفئود % قد بدا في فراسة الفارس الطا % % PageV01P1288 161(@)(@@) % لع يمن دعواه ذات شهود % وكذا أنتم لكم أمرات % 162(@)(@@) % يتكلمن عنكم في المهود % طلعت منه غرة كسنا الفج % 163(@)(@@) % روسيما كالمخلص المنقود % ثم سماه باسمه سيد السا % % 164(@)(@@) % دات غير المدافع المجحود % وقضى الله أن يكون سميا % 165(@)(@@) % وكنيا لجده المجدود % لسليمانوهو في آل وهب % 166(@)(@@) % كسليمان في بني داود % وقع أسم من السلامة والسل % 167(@)(@@) % م عليه وقوع لا مقصود % بل حدته إليه حادية الح % % 168(@)(@@) % ظ حداء أبن قفرة بقعود % يا لك أبنا ووالدين وجدي % 169(@)(@@) % ن يرون الجبال في أخدود % لحقوا بالكواكب الزهروالعي % 170(@)(@@) % يوق نائي المنال من هبود % خير جرثومة وأنضر فرع % PageV01P1289 171(@)(@@) % بين هذي وذاك أنجب عود % ذلك العود قاسم كرم العو % % 172(@)(@@) % د ومرسى العروق غير الصلود % فهو يهتز فوق منصشه المم % 173(@)(@@) % هد في ظل فرعه اليمئود % ولهذا المولود تال من الحر % 174(@)(@@) % ةإن الركوع فحوى السجود % وكأن قد أتى الحسين بشيرا % 175(@)(@@) % باتصال الفتوح بعد السدود % فاستتمت يد من الله بيضا % % 176(@)(@@) % ء لبيضاء من يديه رفود % وغدا الصقر ناهجا بجناحي % 177(@)(@@) % ن إلى كل مرقب ذي كؤود % بل غدا السيف بين حديه عضبا % 178(@)(@@) % غير ذي نبوة ولا محدود % بل غدا الطود بين ركنين منه % 179(@)(@@) % مشرفا ركنه منيف الريود % بل بدا البدر بين سعدين لا % % 180(@)(@@) % يجهل عند الذكي والمبلود % لا عقمتم يا آل وهب فما الدن % PageV01P1290 181(@)(@@) % يا لقوم أمثالكم بولود % كلكم ماجد ولم ير فيكم % % 182(@)(@@) % ماجد قط ذو أب ممجود % أنصل ينتضين 
ms352	 من أنضل بي % % 183(@)(@@) % ض كأمثالهن لا من غمود % وبدور طوالع من بدور % 184(@)(@@) % وشموس لا من دياجير سود % تنجلي أنجما وتعلو بدورا % 185(@)(@@) % في نظام متابع مسرود % مات أسلافكم فأنشرتموهم % 186(@)(@@) % فهم في القلوب لا في اللحود % لا يحلون من خواطر نفس % 187(@)(@@) % مع إحسانهم محلة مودي % % لا يقيسن قائس بكم قو % % 188(@)(@@) % ما فليس المعدوم كالموجود % نزل الناس بالتهائم كرها % 189(@)(@@) % ونزلتم برغمهم في النجود % كم مذود بكيدهم عن حبا المل % 190(@)(@@) % ك وما معتفيكم بمذود % يفخر الجند بالمناقبوالأع % PageV01P1291 191(@)(@@) % مال أعمالكم فخار عنود % مثل ما تفخر اليهود بموسى % % 192(@)(@@) % وهو للمسمين دون اليهود % وكأين لحيلة ولرأي % 193(@)(@@) % محصد من محين محصود % ولقد قلت قول صدق سيشفي % % 194(@)(@@) % صدقه كل مدنف معمود % أرقد الساهرين أن بني وه % 195(@)(@@) % ب عن النائبات غير رقود % واستهب الرقود للشكر فالأم % 196(@)(@@) % ة من ذي تهجد أو هجود % عضد فعمة لمعتضد بال % 197(@)(@@) % له بالنصح منهم معضود % حرست دولة الكرام بني وه % 198(@)(@@) % ب غياث اللهيف والمنجود % دولة عاد نرجس الروض فيها % % 199(@)(@@) % من عيون وورده من خدود % أصلحت كل فاسد متماد % 200(@)(@@) % بجنود الدهاء لا بالجنود % فتحت للأمير فتحا مبينا % PageV01P1292 201(@)(@@) % كل باب في ملكه مسدود % أيهذا الأميرألبسك الله % % 202(@)(@@) % بقاء الموجود لا المفقود % أنت بحر وآل وهب مدود % 203(@)(@@) % عمر البحر ممتعا بالمدود % أبدوا الملكفهو ملك خلود % 204(@)(@@) % لا كعهد الكفور ملك بيود % وجدير بذاك ما استعمل الرأ % % 205(@)(@@) % ي ويمن الجدود ذات الصعود % ما بناء بناته آل وهب % 206(@)(@@) % بوضيع الذرا ولا مهدود % آل وهب قوم لهم عفة المغ % 207(@)(@@) % مد أظفاره ونفع الصيود % أرغبتهم عن القنا قصبات % 208(@)(@@) % مغنيات عن كل جيش مقود % لا تراها تعيث عيث الذئاب الط % 209(@)(@@) % لس لكن تصيد صيد الفهود % حين لا تجتبى وظيفة بيت ال % % 210(@)(@@) % مال من مرهق ولا مضهود % صححواوالمصصح الآمن القل % % PageV01P1293 211(@)(@@) % ب خلاف المبهرج المزؤود % فلأقلامهم صرير مهيب % 212(@)(@@) % يزدرى عنده زئير الأسود % والقراطيس خافقات بأيدي % % 213(@)(@@) % هم 
ms353	 كمرهوب خافقات البنود % وهم راكبو النمارق أمضى % % 214(@)(@@) % من كماة على خناذيذ قود % من أناس قعودهم كقيام ال % % 215(@)(@@) % ناس لكنهم قليلو القعود % لا الذكاء استعار شر ولا الأح % % 216(@)(@@) % لام فيهم من فترة وخمود % دينهم أن يمس لين بلين % % 217(@)(@@) % ويصك الجلمود بالجلمود % منهم الغيث والصواعق في النا % % 218(@)(@@) % س وفي كل محلة جارود % فلهم تارة عدات بروق % 219(@)(@@) % ولهم تارة وعيد رعود % ولقد يوعدون ثم يذوبو % % 220(@)(@@) % ن سماحا إلى أوان الجمود % كم وعيد لهم تبلج عن صق % % PageV01P1294 221(@)(@@) % ح ومنح تبلج الموعود % ووعيد لهم تكشف عن بط % % 222(@)(@@) % ش أبى حده اعتداء الحدود % برزوا في العلا ونام رجال % 223(@)(@@) % برزوا في الكرى على عبود % إن يفوزوا يسبق كل مجار % 224(@)(@@) % بجدود سعيدة وجدود % فلقد بذهم أخوهم بشأو % 225(@)(@@) % تحسب الريح عنده في القيود % مدره الملك أمتعت قدماه % % 226(@)(@@) % بالمقام الموطأ الممهود % مهرب النفس مطلب العنس ملقى % % 227(@)(@@) % كل رحل محط كل قتود % ذو الأيدي على الجميع اللواتي % % 228(@)(@@) % شملت كل سيد ومسود % من أياديه قاسم حسب من عد % 229(@)(@@) % بذاك المعدود من معدود % أخدم الملك مرهفا في مضاء الس % % 230(@)(@@) % يف صلتا وقده المقدود % غرض العين غير منصرف عن % % PageV01P1295 231(@)(@@) % ه إلى غيره ولا مصدود % وطر النفس غير مبترك في % % 232(@)(@@) % ه بذم له ولا مزهود % فاصطفاه أميره وجرى من % 233(@)(@@) % ه وفاقا مجرى الزلال البرود % وحبانا به غياثا فأحيى % % 234(@)(@@) % برفود موصولة برفود % سائلي عن أبي الحسين بدا الصب % % 235(@)(@@) % ح فأغنى عن جذوة في وقود % نور عين سرور نفس وقانا % % 236(@)(@@) % ربنا فقده ولو بفقود % صفيت نفسه وظرف وعاها % % 237(@)(@@) % فهو صاف كالسلسل المورود % وألذ الشراب ماكان منه % % 238(@)(@@) % صافي العين صافي الناجود % لا ترى القاسم المؤمل إلا % % 239(@)(@@) % باكر الرفد شاكر المرفود % منشد المدح تحت أفياء عرف % 240(@)(@@) % ناشد طالبيه لا منشود % مستمدا من فعله كل قول % PageV01P1296 241(@)(@@) % قيل فيه فما له من نفود % ومن السيف ماؤه ومن الطا % % 242(@)(@@) % ووس ذي الوشي وشي 
ms354	 تلك البرود % سيد بره كمحتوم أمر ال % % 243(@)(@@) % له يأتيك غير ما مردود % تحسب العين بشره في نداه % % 244(@)(@@) % لمع برق في عارض منضود % ليس ينفك داعيا لحقوق % 245(@)(@@) % تعتريه وناسيا لحقود % % كم رأينا لجود كفيه مصفو % % 246(@)(@@) % دا طليقا من حلية المصفود % ما غليل لم يسقه بمساعي % % 247(@)(@@) % ه وجدوى يديه بالمبرود % صرفتني عن ماله بدأة المس % 248(@)(@@) % رف صرف الكريم لا المطرود % % أجزل البدء لي فأغنى عن العو % % 249(@)(@@) % د فما بي إلا اختلال الورود % فقر عيني إلى محاسن ذاك ال % % 250(@)(@@) % وجه فقر لا ينطوي في الجحود % وابتهاجي به ابتهاجيبالضو % % PageV01P1297 251(@)(@@) % ء وروح النسيم بعد الركود % وحنيني إلى مجالسه الزه % % 252(@)(@@) % ر حنيني إلى الصبا المعهود % واغتباطي به اغتباطي بالبر % 253(@)(@@) % ء وعطف الحبيب بعد الصدود % غير آت وإن غنيتمجودا % 254(@)(@@) % منه بالمعجزات شكوى المجود % غتني سيبه فجاء مجيء القط % % 255(@)(@@) % ر والسيلمقبلا من صعود % لست أشكوه غير أن لهاه % 256(@)(@@) % كلفتني إحصاء رمل زرود % واستكدت حسير شكري % % 257(@)(@@) % فشكري يستغيث استغاثة المجهود % حاشا لله ليس مني شيء % 258(@)(@@) % في ذاره العفي بالمكدود % أنا من قاسم أروح وأغدو % % 259(@)(@@) % بمراد من الرجاء مرود % في نسيم من السعادة مطلو % % 260(@)(@@) % ل كأنفاس ذات عطرين رود % عزبت عنه سيئاتي وإحسا % % PageV01P1298 261(@)(@@) % ني منه بمنظر مرصود % رد كالبكرة المطيرة دهرا % 262(@)(@@) % كان لي كالظهيرة الصيخود % فكأني لديه من جنة الفردو % % 263(@)(@@) % س في ظل سدرها المخضود % وله بعد نعمة الرفد نعمى % % 264(@)(@@) % فوق نعمى الرقاد بعد السهود % راضني ظرفه ويقظ مني % % 265(@)(@@) % علمه فادكرت بعد سمود % وغدت شيمتي أرق من الكأ % % 266(@)(@@) % س وكانت أجفى من الراقود % غير نكر حلوله من عيون % % 267(@)(@@) % وقلوب محلة المودود % هل ترى مثل وجهه في وجوه الن % % 268(@)(@@) % ناس حسنا أو قده في القدود % أو ترى مثل فضله في صنوف ال % % 269(@)(@@) % فضل مذ حاز حالة الملدود % أكبر الحسن قاسما إذ رآه % % 270(@)(@@) % بدره فوق غصنه الأملود % وغدا المجد عبده إذ رآه % % PageV01P1299 271(@)(@@) % نشرته 
ms355	 يداه من ملحود % يا أبا الحسنيينفوزة علم % 272(@)(@@) % لك نقلتها وسبقة جود % زادك الله فوق صالح ما أع % % 273(@)(@@) % طاك شكرا وغبطة في خلود نم يمن الله طلعة المولود % % وحبا أهله بطول السعود % % 274(@)(@@) % فهم الضامنون حين توالى % % منسيات العهود حفظ العهود % % 275(@)(@@) % والألى إن رعوا حلوبة مجد % لأولي الأمر لم تكن بجدود % % 276(@)(@@) % فليقل قائل لذي الصدر المي % مون منهم في أمره والورود % % 277(@)(@@) % أمتع الله ذو المواهب بالمو % هوب غير المخسس المنكود % 278(@)(@@) % بدر طلق وشمس دجن من الأم % % لاك جاءا بكوكب مسعود % 279(@)(@@) % وافد زار مستماحي وفود % % ومرتجى منه مستماح وفود % 280(@)(@@) % سله الله للخطوب من الغي % % ب كسل المهند المغمود % PageV01P1300 281(@)(@@) % فيه عرف وفيه نكر معدا % % ن لأهل النهى وأهل المرود % 282(@)(@@) % وكمين الحريق في العود مخفى % وحقين الرحيق في العنقود % 283(@)(@@) % نجلته بيضاء من ملكات الر % وم تدعى لقيصر معبود % 284(@)(@@) % ليلة الأربعاء وهو من الأي % ام يوم ما شئت من محمود % 285(@)(@@) % مأنحسا على ثمود وعاد % وسعودا لصالح ولهود % 286(@)(@@) % فالذي فيه إن نظرنا من الشر % لعاد بكفرها وعود % 287(@)(@@) % ولنا خيره وذروة منجا % % ه لأنا أضداد أهل العنود % 288(@)(@@) % وهو يوم المظفرين بني العب % اس سقيا لظله الممدود % 289(@)(@@) % يوم صدق بنت يد الله فيه % % ملكهم فوق رأسه الموطود % 290(@)(@@) % وطلوع المولود فيه بشير % بسرور لأهله مولود % PageV01P1301 291(@)(@@) % عاقد أمرهم بأمر بني العب % اس عقدا من محكمات العقود % 292(@)(@@) % مفصح فأله يخبر عن أز % ر بأزر من شكله مشدود % 293(@)(@@) % آل وهب فوزا لكم بسليما % % ن وكبتا للحاسد المفئود % 294(@)(@@) % قد بدا في فراسة الفارس الطا % % لع يمن دعواه ذات شهود % 295(@)(@@) % وكذا أنتم لكم أمرات % يتكلمن عنكم في المهود % 296(@)(@@) % طلعت منه غرة كسنا الفج % روسيما كالمخلص المنقود % 297(@)(@@) % ثم سماه باسمه سيد السا % % دات غير المدافع المجحود % 298(@)(@@) % وقضى الله أن يكون سميا % وكنيا لجده المجدود % 299(@)(@@) % لسليمانوهو في آل وهب % كسليمان في بني داود % 300(@)(@@) % وقع أسم من السلامة والسل 
ms356	 % م عليه وقوع لا مقصود % PageV01P1302 301(@)(@@) % بل حدته إليه حادية الح % % ظ حداء أبن قفرة بقعود % 302(@)(@@) % يا لك أبنا ووالدين وجدي % ن يرون الجبال في أخدود % 303(@)(@@) % لحقوا بالكواكب الزهروالعي % يوق نائي المنال من هبود % 304(@)(@@) % خير جرثومة وأنضر فرع % بين هذي وذاك أنجب عود % 305(@)(@@) % ذلك العود قاسم كرم العو % % د ومرسى العروق غير الصلود % 306(@)(@@) % فهو يهتز فوق منصشه المم % هد في ظل فرعه اليمئود % 307(@)(@@) % ولهذا المولود تال من الحر % ةإن الركوع فحوى السجود % 308(@)(@@) % وكأن قد أتى الحسين بشيرا % باتصال الفتوح بعد السدود % 309(@)(@@) % فاستتمت يد من الله بيضا % % ء لبيضاء من يديه رفود % 310(@)(@@) % وغدا الصقر ناهجا بجناحي % ن إلى كل مرقب ذي كؤود % PageV01P1303 311(@)(@@) % بل غدا السيف بين حديه عضبا % غير ذي نبوة ولا محدود % 312(@)(@@) % بل غدا الطود بين ركنين منه % مشرفا ركنه منيف الريود % 313(@)(@@) % بل بدا البدر بين سعدين لا % % يجهل عند الذكي والمبلود % 314(@)(@@) % لا عقمتم يا آل وهب فما الدن % يا لقوم أمثالكم بولود % 315(@)(@@) % كلكم ماجد ولم ير فيكم % % ماجد قط ذو أب ممجود % 316(@)(@@) % أنصل ينتضين من أنضل بي % % ض كأمثالهن لا من غمود % 317(@)(@@) % وبدور طوالع من بدور % وشموس لا من دياجير سود % 318(@)(@@) % تنجلي أنجما وتعلو بدورا % في نظام متابع مسرود % 319(@)(@@) % مات أسلافكم فأنشرتموهم % فهم في القلوب لا في اللحود % 320(@)(@@) % لا يحلون من خواطر نفس % مع إحسانهم محلة مودي % % PageV01P1304 321(@)(@@) % لا يقيسن قائس بكم قو % % ما فليس المعدوم كالموجود % 322(@)(@@) % نزل الناس بالتهائم كرها % ونزلتم برغمهم في النجود % 323(@)(@@) % كم مذود بكيدهم عن حبا المل % ك وما معتفيكم بمذود % 324(@)(@@) % يفخر الجند بالمناقبوالأع % مال أعمالكم فخار عنود % 325(@)(@@) % مثل ما تفخر اليهود بموسى % % وهو للمسمين دون اليهود % 326(@)(@@) % وكأين لحيلة ولرأي % محصد من محين محصود % 327(@)(@@) % ولقد قلت قول صدق سيشفي % % صدقه كل مدنف معمود % 328(@)(@@) % أرقد الساهرين أن بني وه % ب عن النائبات غير رقود % 329(@)(@@) % واستهب الرقود للشكر فالأم % ة 
ms357	 من ذي تهجد أو هجود % 330(@)(@@) % عضد فعمة لمعتضد بال % له بالنصح منهم معضود % PageV01P1305 331(@)(@@) % حرست دولة الكرام بني وه % ب غياث اللهيف والمنجود % 332(@)(@@) % دولة عاد نرجس الروض فيها % % من عيون وورده من خدود % 333(@)(@@) % أصلحت كل فاسد متماد % بجنود الدهاء لا بالجنود % 334(@)(@@) % فتحت للأمير فتحا مبينا % كل باب في ملكه مسدود % 335(@)(@@) % أيهذا الأميرألبسك الله % % بقاء الموجود لا المفقود % 336(@)(@@) % أنت بحر وآل وهب مدود % عمر البحر ممتعا بالمدود % 337(@)(@@) % أبدوا الملكفهو ملك خلود % لا كعهد الكفور ملك بيود % 338(@)(@@) % وجدير بذاك ما استعمل الرأ % % ي ويمن الجدود ذات الصعود % 339(@)(@@) % ما بناء بناته آل وهب % بوضيع الذرا ولا مهدود % 340(@)(@@) % آل وهب قوم لهم عفة المغ % مد أظفاره ونفع الصيود % PageV01P1306 341(@)(@@) % أرغبتهم عن القنا قصبات % مغنيات عن كل جيش مقود % 342(@)(@@) % لا تراها تعيث عيث الذئاب الط % لس لكن تصيد صيد الفهود % 343(@)(@@) % حين لا تجتبى وظيفة بيت ال % % مال من مرهق ولا مضهود % 344(@)(@@) % صححواوالمصصح الآمن القل % % ب خلاف المبهرج المزؤود % 345(@)(@@) % فلأقلامهم صرير مهيب % يزدرى عنده زئير الأسود % 346(@)(@@) % والقراطيس خافقات بأيدي % % هم كمرهوب خافقات البنود % 347(@)(@@) % وهم راكبو النمارق أمضى % % من كماة على خناذيذ قود % 348(@)(@@) % من أناس قعودهم كقيام ال % % ناس لكنهم قليلو القعود % 349(@)(@@) % لا الذكاء استعار شر ولا الأح % % لام فيهم من فترة وخمود % 350(@)(@@) % دينهم أن يمس لين بلين % % ويصك الجلمود بالجلمود % PageV01P1307 351(@)(@@) % منهم الغيث والصواعق في النا % % س وفي كل محلة جارود % 352(@)(@@) % فلهم تارة عدات بروق % ولهم تارة وعيد رعود % 353(@)(@@) % ولقد يوعدون ثم يذوبو % % ن سماحا إلى أوان الجمود % 354(@)(@@) % كم وعيد لهم تبلج عن صق % % ح ومنح تبلج الموعود % 355(@)(@@) % ووعيد لهم تكشف عن بط % % ش أبى حده اعتداء الحدود % 356(@)(@@) % برزوا في العلا ونام رجال % برزوا في الكرى على عبود % 357(@)(@@) % إن يفوزوا يسبق كل مجار % بجدود سعيدة وجدود % 358(@)(@@) % فلقد بذهم أخوهم بشأو % تحسب الريح عنده في القيود % 359(@)(@@) % مدره الملك أمتعت قدماه 
ms358	 % % بالمقام الموطأ الممهود % 360(@)(@@) % مهرب النفس مطلب العنس ملقى % % كل رحل محط كل قتود % PageV01P1308 361(@)(@@) % ذو الأيدي على الجميع اللواتي % % شملت كل سيد ومسود % 362(@)(@@) % من أياديه قاسم حسب من عد % بذاك المعدود من معدود % 363(@)(@@) % أخدم الملك مرهفا في مضاء الس % % يف صلتا وقده المقدود % 364(@)(@@) % غرض العين غير منصرف عن % % ه إلى غيره ولا مصدود % 365(@)(@@) % وطر النفس غير مبترك في % % ه بذم له ولا مزهود % 366(@)(@@) % فاصطفاه أميره وجرى من % ه وفاقا مجرى الزلال البرود % 367(@)(@@) % وحبانا به غياثا فأحيى % % برفود موصولة برفود % 368(@)(@@) % سائلي عن أبي الحسين بدا الصب % % ح فأغنى عن جذوة في وقود % 369(@)(@@) % نور عين سرور نفس وقانا % % ربنا فقده ولو بفقود % 370(@)(@@) % صفيت نفسه وظرف وعاها % % فهو صاف كالسلسل المورود % PageV01P1309 371(@)(@@) % وألذ الشراب ماكان منه % % صافي العين صافي الناجود % 372(@)(@@) % لا ترى القاسم المؤمل إلا % % باكر الرفد شاكر المرفود % 373(@)(@@) % منشد المدح تحت أفياء عرف % ناشد طالبيه لا منشود % 374(@)(@@) % مستمدا من فعله كل قول % قيل فيه فما له من نفود % 375(@)(@@) % ومن السيف ماؤه ومن الطا % % ووس ذي الوشي وشي تلك البرود % 376(@)(@@) % سيد بره كمحتوم أمر ال % % له يأتيك غير ما مردود % 377(@)(@@) % تحسب العين بشره في نداه % % لمع برق في عارض منضود % 378(@)(@@) % ليس ينفك داعيا لحقوق % تعتريه وناسيا لحقود % % 379(@)(@@) % كم رأينا لجود كفيه مصفو % % دا طليقا من حلية المصفود % 380(@)(@@) % ما غليل لم يسقه بمساعي % % ه وجدوى يديه بالمبرود % PageV01P1310 381(@)(@@) % صرفتني عن ماله بدأة المس % رف صرف الكريم لا المطرود % % 382(@)(@@) % أجزل البدء لي فأغنى عن العو % % د فما بي إلا اختلال الورود % 383(@)(@@) % فقر عيني إلى محاسن ذاك ال % % وجه فقر لا ينطوي في الجحود % 384(@)(@@) % وابتهاجي به ابتهاجيبالضو % % ء وروح النسيم بعد الركود % 385(@)(@@) % وحنيني إلى مجالسه الزه % % ر حنيني إلى الصبا المعهود % 386(@)(@@) % واغتباطي به اغتباطي بالبر % ء وعطف الحبيب بعد الصدود % 387(@)(@@) % غير آت وإن غنيتمجودا % منه بالمعجزات شكوى المجود % 388(@)(@@) % غتني سيبه 
ms359	 فجاء مجيء القط % % ر والسيلمقبلا من صعود % 389(@)(@@) % لست أشكوه غير أن لهاه % كلفتني إحصاء رمل زرود % 390(@)(@@) % واستكدت حسير شكري % % فشكري يستغيث استغاثة المجهود % PageV01P1311 391(@)(@@) % حاشا لله ليس مني شيء % في ذاره العفي بالمكدود % 392(@)(@@) % أنا من قاسم أروح وأغدو % % بمراد من الرجاء مرود % 393(@)(@@) % في نسيم من السعادة مطلو % % ل كأنفاس ذات عطرين رود % 394(@)(@@) % عزبت عنه سيئاتي وإحسا % % ني منه بمنظر مرصود % 395(@)(@@) % رد كالبكرة المطيرة دهرا % كان لي كالظهيرة الصيخود % 396(@)(@@) % فكأني لديه من جنة الفردو % % س في ظل سدرها المخضود % 397(@)(@@) % وله بعد نعمة الرفد نعمى % % فوق نعمى الرقاد بعد السهود % 398(@)(@@) % راضني ظرفه ويقظ مني % % علمه فادكرت بعد سمود % 399(@)(@@) % وغدت شيمتي أرق من الكأ % % س وكانت أجفى من الراقود % 400(@)(@@) % غير نكر حلوله من عيون % % وقلوب محلة المودود % PageV01P1312 401(@)(@@) % هل ترى مثل وجهه في وجوه الن % % ناس حسنا أو قده في القدود % 402(@)(@@) % أو ترى مثل فضله في صنوف ال % % فضل مذ حاز حالة الملدود % 403(@)(@@) % أكبر الحسن قاسما إذ رآه % % بدره فوق غصنه الأملود % 404(@)(@@) % وغدا المجد عبده إذ رآه % % نشرته يداه من ملحود % 405(@)(@@) % يا أبا الحسنيينفوزة علم % لك نقلتها وسبقة جود % 406(@)(@@) % زادك الله فوق صالح ما أع % % طاك شكرا وغبطة في خلود % 407(@)(@@) % ه وأراك ابنك السعيد كثيرا % ببنيه في المحفل المشهود % 408(@)(@@) % في حياة من الوزير الذي أض % % حى به الملك مستقل العمود % 409(@)(@@) % والذي استدرك السياسة بالحز % % م وأحيا التدبير بعد الهمود % 410(@)(@@) % مسدت حبلنا يداه جزى الخي % ر يديه عن حبلنا الممسود % PageV01P1313 411(@)(@@) % لا كمن كان علمه واقلب ال % % علم يريه الذبيح كالمفصود % 412(@)(@@) % وتراه من الفروسة يعلو % % خيله بالسروج قبل اللبود % 413(@)(@@) % فهنيئا وزيرنا لرعايا % % أمرعت بعد قاعها المجرود % 414(@)(@@) % وهنيئا لك العطاء وما أر % % دف من رغم شانىء وحسود % 415(@)(@@) % يا معيري ثوب الحياة بل الكا % % سي بالطول حلة المحسود % 416(@)(@@) % بك صار السني حظي وقدما % كان حظي كأكلة المعمود % 417(@)(@@) % بك صار المزور 
ms360	 رحلي وقد كا % % ن بحال المريض غير المعود % 418(@)(@@) % ويمينا بكل شأو بطين % من مساعيك لي وشوط طرود % 419(@)(@@) % لقد اخترت ذا وفاء ألوفا % يضحك الدهر عن ثناء شرود % 420(@)(@@) % لم يكن بالكنود فيما نثا عن % % ك ولا كنت في الجدا بكنود % PageV01P1314 421(@)(@@) % ولعمريلأمجدنك من مد % % ح بأسمائك العلى معقود % 422(@)(@@) % لك بحر يمد بحري فيجري % % غير ما منزف ولا مثمود % 423(@)(@@) % هاكها كاعبا تخونها الإع % % جال تكميل حسنها بالنهود % 424(@)(@@) % لم يضرها أن لم يقلها النواس % % ي ولا شيخ بحتر بن عتود % 425(@)(@@) % وشهودي بما نحلتك شتى % % من حسود ومن ودود حشود % PageV01P1315 البحر : - 1(@)(@@) % بكاؤكما يشفي وإن كان لا يجدي % % فجودا فقد أودى نظيركما عندي % % 2(@)(@@) % بني الذي أهدته كفاي للثرى % % فيا عزة المهدى ويا حسرة المهدي % % 3(@)(@@) % ألا قاتل الله المنايا ورميها % % من القوم حبات القلوب على عمد % 4(@)(@@) % توخى حمام الموت أوسط صبيتي % % فلله كيف اختار واسطة العقد % 5(@)(@@) % على حين شمت الخير من لمحاته % وآنست من أفعاله آية الرشد % 6(@)(@@) % طواه الردى عني فأضحى مزاره % بعيدا على قرب قريبا على بعد % 7(@)(@@) % لقد أنجزت فيه المنايا وعيدها % % وأخلفت الآمال ماكان من وعد % 8(@)(@@) % لقد قل بين المهد واللحد لبثه % فلم ينس عهد المهد إذ ضم في اللحد % 9(@)(@@) % تنغص قبل الري ماء حياته % وفجع منه بالعذوبة والبرد % 10(@)(@@) % ألح عليه النزف حتى أحاله % إلى صفرة الجادي عن حمرة الورد % PageV01P1316 11(@)(@@) % وظل على الأيدي تساقط نفسه % % ويذوي كما يذوي القضيب من الرند % 12(@)(@@) % فيالك من نفس تساقط أنفسا % تساقط در من نظام بلا عقد % 13(@)(@@) % عجبت لقلبي كيف لم ينفطر له % ولو أنه أقسى من الحجر الصلد % 14(@)(@@) % بودي أني كنت قدمت قبله % وأن المنايا دونه صمدت صمدي % % 15(@)(@@) % ولكن ربي شاء غير مشيئتي % % وللرب إمضاء المشيئة لا العبد % 16(@)(@@) % وما سرني أن بعته بثوابه % % ولو أنه التخليد في جنة الخلد % 17(@)(@@) % ولا بعته طوعا ولكن غصبته % % وليس على ظلم الحوداث من معدي % % 18(@)(@@) % وإني وإن متعت 