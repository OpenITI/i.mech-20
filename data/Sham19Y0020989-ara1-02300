ms2295	 الشيخ شمس الدين محمد بن أحمد بن عبد الرحمن الدمشقى. تقدم.(@)(@)(@@)(@@)(@@) ||| AUTO 3141 ابن خليل، جماعة(@)(@)(@@) :(@)(@@) منهم: إمام المقام وخطيب المسجد الحرام الوالد سليمان بن خليل بن إبراهيم بن يحيى ابن سليمان بن فارس بن أبى عبد الله الكنانى العسقلانى المكى.(@)(@@) وقريبه: العلم أحمد بن عبد الله بن خليل، أبو محمد.(@)(@@) وأخوه: البهاء عبد الله بن محمد بن عبد الله بن خليل.(@)(@)(@@)(@@)(@@) ||| AUTO 3142 ابن ديلم الشيبى، جماعة(@)(@)(@@) (1):(@)(@@) منهم: المجد أحمد بن ديلم بن محمد الحجبى. تقدم.(@)(@)(@@)(@@)(@@) ||| AUTO 3143 ابن راشد(@)(@)(@@) :(@)(@@) أحد تجار مكة، هو أحمد بن سليمان بن راشد السالمى.(@)(@@) ويعرف بذلك أيضا أبوه سليمان، وابنه سليمان بن أحمد بن سليمان. تقدموا.(@)(@)(@@)(@@)(@@) ||| AUTO 3144 ابن زبرق(@)(@)(@@) :(@)(@@) هو محمد بن يعقوب بن إسماعيل الشيبانى. تقدم.(@)(@)PageV06P342(@)(@)(@@)(@@)(@@) ||| AUTO 3145 ابن الزنجانى (1)، جماعة(@)(@)(@@) :(@)(@@) منهم: الأديب على بن الحسن بن على التميمى.(@)(@@) وابن أخيه المحدث الأديب نجم الدين سليمان بن عبد الله بن الحسين (2).(@)(@)(@@)(@@)(@@) ||| AUTO 3146 ابن زنبور المكى(@)(@)(@@) :(@)(@@) هو محمد بن جعفر. تقدم.(@)(@)(@@)(@@)(@@) ||| AUTO 3147 ابن أبى برة المقرئ المكى(@)(@)(@@) :(@)(@@) هو أحمد بن محمد بن عبد الله بن البزى. تقدم.(@)(@)(@@)(@@)(@@) ||| AUTO 3148 ابن الزين(@)(@)(@@) :(@)(@@) جماعة من أولاد الزين القسطلانى، وأولاد أولاده، وكلهم معروفون بأسمائهم فى الغالب. تقدموا.(@)(@@) وممن يعرف بابن الزين، ولكن غير هذا: الزين عبد الله بن الزين أحمد بن محمد الطبرى (1). تقدم.(@)(@)(@@)(@@)(@@) ||| AUTO 3149 ابن سالم الحضرمى(@)(@)(@@) :(@)(@@) هو محمد بن سالم بن على المكى (1). تقدم.(@)(@)PageV06P343(@)(@)(@@)(@@)(@@) ||| AUTO 3150 ابن سالم المؤذن(@)(@)(@@) :(@)(@@) هو أحمد بن سالم بن ياقوت.(@)(@@) ويعرف بابن سالم أيضا: ابناه محمد وعبد العزيز. تقدموا.(@)(@)(@@)(@@)(@@) ||| AUTO 3151 ابن سالم الزبيدى(@)(@)(@@) :(@)(@@) هو القاضى سراج الدين عبد اللطيف بن محمد.(@)(@@) ويعرف بذلك أولاده: محمد، وعلى، وعمر، تقدموا.(@)(@)(@@)(@@)(@@) ||| AUTO 3152 ابن سبعين الصوفى(@)(@)(@@) :(@)(@@) نزيل مكة، هو عبد الحق بن