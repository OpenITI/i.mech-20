ms1445	 السندي.(@)(@@) الروضة: ح 568.(@)(@@) * وروى عن محمد بن أبي حمزة، وروى عنه صالح بن السندي.(@)(@@) الكافي: ج 3، ك 1، ب 22، ح 8.(@)(@@) والتهذيب: ج 1، ح 256.(@)(@@) * وروى عن محمد بن مسلم، وروى عنه محمد بن الحسين.(@)(@@) التهذيب: ج 3، ح 863.(@)(@@) * وروى عن معاوية بن عمار، وروى عنه محمد بن خالد البرقي.(@)(@@) التهذيب: ج 3، ح 585.(@)(@@) * وروى عن معلى أبي عثمان.(@)(@@) الفقيه: ج 4، ح 235، 251:(@)(@@) * وروى عن معلى بن عثمان. PageV05P392(@)(@@) التهذيب: ج 10، ح 755 (الاستبصار:(@)(@@) ج 4، ح 1033 وفيه معلى بن أبي عثمان).(@)(@@) * وروى عن المفضل بن عمر، وروى عنه صالح بن السندي.(@)(@@) الكافي: ج 2، ك 1، ب 99، ح 23.(@)(@@) * وروى عن موسى بن بكر، وروى عنه صالح بن السندي.(@)(@@) الكافي: ج 5، ك 2، ب 127، ح 6 و ج 6، ك 8، ب 37، ح 40. والتهذيب: ج 7، ح 864 (الاستبصار: ج 3، ح 460).(@)(@@) * وروى عن موسى بن بكر الواسطي، وروى عنه أبو عبد الله البرقي.(@)(@@) التهذيب: ج 5، ح 1536 (الاستبصار:(@)(@@) ج 2، ح 1171).(@)(@@) وروى عنه البرقي.(@)(@@) الكافي: ج 4، ك 3، ب 40، ح 6.(@)(@@) * وروى عن منصور بن حازم، وروى عنه صالح بن السندي.(@)(@@) الكافي: ج 2، ك 4، ب 7، ح 10.(@)(@@) * وروى عن نعمان الرازي، وروى عنه محمد بن الحسين.(@)(@@) التهذيب: ج 2، ح 220. (الاستبصار:(@)(@@) ج 1، ح 1144) و 1107 (الاستبصار:(@)(@@) ج 1، ح 1122).(@)(@@) * وروى عن هارون بن خارجة، وروى عنه صالح بن السندي.(@)(@@) الكافي: ج 1، ك 4، ب 64، ح 5.(@)(@@) * وروى عن هشام بن سالم.(@)(@@) الفقيه: ج 4، ح 379.(@)(@@) وروى عنه محمد بن الحسين.(@)(@@) التهذيب: ج 2، ح 1595، و ج 3، ح 487 و 844، و ج 8، ح 591 (الاستبصار:(@)(@@) ج 3، ح 1319)، و ج 10، ح 992.(@)(@@) * وروى عن الهيثم بن عروة التميمي، وروى عنه محمد بن الحسين.(@)(@@) التهذيب: ج 5، ح 1172 (الاستبصار:(@)(@@) ج 2، ح 670).(@)(@@) وروى عنه محمد بن الحسين بن أبي الخطاب.(@)(@@) التهذيب: ج 5، ح 410.(@)(@@) * وروى عن يحيى بن أبي العلى، وروى عنه صالح بن السندي.(@)(@@) الكافي: ج 3، ك 3، ب 65، ح 2.(@)(@@) وروى عنه محمد بن إسماعيل بن بزيع.(@)(@@) الكافي: ج 6، ك 2، ب 2، ح 5.(@)(@@) * وروى عن يحيى بن معمر العطار، وروى عنه إبراهيم بن هاشم، وصالح PageV05P393(@)(@@) ابن السندي.(@)(@@) ا