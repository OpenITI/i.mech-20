ms2361	 فليقل ، ومن شاء فليكثر ) )(@)(@@) ( حب ) و ابن شاهين وتمام ( ض ) عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22024 ) قال النبي :(@)(@@) | 30 ( من سألكم بالله فأعطوه ، وإن شئتم فدعوه ) )(@)(@@) الحكيم عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22025 ) قال النبي :(@)(@@) | 30 ( من سئل عن علم نافع فكتمه ، جاء يوم القيامة ملجما بلجام من نار ) )(@)(@@) ( طب ) و الخطيب وابن عساكر عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22026 ) قال النبي :(@)(@@) | 30 ( من سب أحدا من أصحابي فعليه لعنة الله ) )(@)(@@) ( ش ) PageV07P220 عن عطاء مرسلا ، ابن النجار عن عطية عن أبي سعيد الشيرازي في الألقاب عن عطاء مرسلا .(@)(@@)(@@)(@@) $ ( 22027 ) قال النبي :(@)(@@) | 30 ( من ساق الهدي تطوعا فعطب فلا يأكل منه ، فإنه إن أكل منه كان عليه بدله ، ولاكن لينحرها ثم ليغمس نعلها في دمها ثم ليضرب بها جنبيها ، وإن كان هديا واجبا فليأكل إن شاء ، فإنه لا بد من قضائه ) )(@)(@@) ( هق ) عن أبي قتادة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22028 ) قال النبي :(@)(@@) | 30 ( من سب أحدا من أصحابي لعنت فاجلدوه ) )(@)(@@) أبو سعد السمان في كتاب الموافقة بين أهل البيت والصحابة عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22029 ) قال النبي :(@)(@@) | 30 ( من سب نبيا فاقتلوه ، ومن سب أصحابي فاضربوه ) )(@)(@@) ابن النجار عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22030 ) قال النبي :(@)(@@) | 30 ( من سبح الله عز وجل تسبيحة أو حمده تحميدة ، أو هلله تهليلة ، أو كبره تكبيرة غرس له بها شجرة في الجنة في أصلها ياقوت أحمر مكللة بالدر ، طلعها كثدي الأبكار ، أحلى من العسل ، وألين من الزبد ) )(@)(@@) ( طب ) عن سل مان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22031 ) قال النبي :(@)(@@) | 30 ( من سبح عند غروب الشمس سبعين تسبيحة غفر له سائر عمله ) )(@)(@@) الديلمي عن بهز عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 22032 ) قال النبي :(@)(@@) | 30 ( من سبق العاطس بالحمد لله وقاه الله وجع الخاصرة ولم ير في فيه مكروها حتى يخرج من الدنيا ) )(@)(@@) تمام وابن عساكر عن ابن عباس رضي الله عنهما وفيه نقية وعنعن .(@)(@@)(@@)(@@) $ ( 22033 ) قال النبي :(@)(@@) | 30 ( من سبق إلى الصلاة مخافة أن يسبقه أوجب الله له 
ms2362	 الجنة ، ومن تركها مأثرة عليها لم يدركها بعمل إلى الحول ) )(@)(@@) ( حل ) عن أبي الدرداء PageV07P221 رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22034 ) قال النبي :(@)(@@) | 30 ( من زنى خرج من الإيمان ، ومن شرب الخمر خرج من الإيمان ، ومن انتهب نهبة يتشرفها الناس خرج من الإيمان ) )(@)(@@) ابن قانع عن شريك رضي الله عنه غير منسوب .(@)(@@)(@@)(@@) $ ( 22035 ) قال النبي :(@)(@@) | 30 ( من زهد في الدنيا علمه الله بلا تعلم ، وهداه بلا هداية ، وجعله بصيرا ، وكشف عنه العمى ) )(@)(@@) ( حل ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22036 ) قال النبي :(@)(@@) | 30 ( من زوج ابنته أو واحدة من أهله ممن يشرب الخمر فكأنما قادها إلى النار ) )(@)(@@) الديلمي عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22037 ) قال النبي :(@)(@@) | 30 ( من زوج بنتا توجه الله يوم القيامة تاج الملك ) )(@)(@@) ابن شاهين عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 22038 ) قال النبي :(@)(@@) | 30 ( من ساء خلقه من الرقيق والدواب والصبيان فاقرءوا في أذنيه : { أفغير الله تبغون . . . } الآية ) )(@)(@@) ابن عساكر عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22039 ) قال النبي :(@)(@@) | 30 ( من ساء خلقه من إنسان أو دابة فأذنوا في أذنيه ) )(@)(@@) الديلمي عن الحسين بن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22040 ) قال النبي :(@)(@@) | 30 ( من ساءته خطيئته غفر له وإن لم يستغفر ) )(@)(@@) الديلمي عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22041 ) قال النبي :(@)(@@) | 30 ( من ساءته سيئته فهو مؤمن ) )(@)(@@) ( طس ) عن علي رضي الله عنه .(@)(@@) PageV07P222(@)(@@)(@@)(@@) $ ( 22042 ) قال النبي :(@)(@@) | 30 ( من ساءته سيئته ، وسرته حسنته فهو مؤمن ) )(@)(@@) ( طب كر ) عن أبي أمامة ، تمام عن أبي أمامة وعمر ، ( ع ) وأبو سعد السمان في مشيخته عن عمر رضي الله عنه وصحح .(@)(@@)(@@)(@@) $ ( 22043 ) قال النبي :(@)(@@) | 30 ( من ساءته سيئته ، وسرته حسنته فهي أمارة المؤمن ) )(@)(@@) ( خ ) في التاريخ عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22044 ) قال النبي :(@)(@@) | 30 ( من سافر من دار إقامة يوم الجمعة ، دعت عليه الملائكة ، لا يصحب في سفره ، ولا يعان على حاجته ) )(@)(@@) ابن النجار عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22045 ) قال النبي :(@)(@@) | 30 ( من ستر على مؤمن عورة فكأنما أحيا موءودة من قبرها ) )(@)(@@) ابن مردويه 
ms2363	 ( هب ) والخرائطي في مكارم الأخلاق ، وابن النجار عن جابر ، ( طس ) عن سلمة بن مخلد ، ( حم هق ) عن عقبة بن عامر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22046 ) قال النبي :(@)(@@) | 30 ( من ستر أخاه المسلم بما يرضيه أرضاه الله تعالى في الدنيا والآخرة ) )(@)(@@) ابن النجار عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22047 ) قال النبي :(@)(@@) | 30 ( من ستر مسلما ستره الله في الدنيا والآخرة ، ومن فك عن مكروب فك الله عنه كربة من كرب يوم القيامة ، ومن كان في حاجة أخيه كان الله في حاجته ) )(@)(@@) ( عب حم ) و ابن أبي الدنيا في قضاء الحوائج ، وأبو نعيم والخطيب عن سلمة بن مخلد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22048 ) قال النبي :(@)(@@) | 30 ( من ستر مسلما ستره الله يوم القيامة ) )(@)(@@) الخرائطي في مكارم الأخلاق عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22049 ) قال النبي :(@)(@@) | 30 ( من ستر على مؤمن حزنه فكأنما أحيا موءودة من PageV07P223 قبرها ) )(@)(@@) الخرائطي عن عقبة بن عامر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22050 ) قال النبي :(@)(@@) | 30 ( من ستر أخاه في فاحشة رآها عليه ستره الله في الدنيا والآخرة ) )(@)(@@) ( عب ) عن عقبة بن عامر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22051 ) قال النبي :(@)(@@) | 30 ( من ستر مؤمنا في الدنيا على عورة ستره الله يوم القيامة ) )(@)(@@) ( عب ) عن عقبة بن عامر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22052 ) قال النبي :(@)(@@) | 30 ( من ستر على مؤمن فاحشة فكأنما أحيا موءودة ) )(@)(@@) ( هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22053 ) قال النبي :(@)(@@) | 30 ( من ستر مسلما ستره الله في الدنيا والآخرة ) )(@)(@@) أبو نعيم عن ثابت بن مخلد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22054 ) قال النبي :(@)(@@) | 30 ( من سجد لله سجدة كتب الله له بها حسنة وحط عنه بها خطيئة ، ورفع له بها درجة ) )(@)(@@) ( حم ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22055 ) قال النبي :(@)(@@) | 30 ( من سجد لله سجدة ، رفعه الله بها درجة ، وحط عنه بها خطيئة ) )(@)(@@) ( طب ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22056 ) قال النبي :(@)(@@) | 30 ( من سجد لله سجدة فقد برىء من الكبر ) )(@)(@@) الديلمي عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22057 
ms2364	 ) قال النبي :(@)(@@) | 30 ( من سحب ثيابه لم ينظر الله إليه يوم القيامة ) )(@)(@@) ابن عساكر عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22058 ) قال النبي :(@)(@@) | 30 ( من سد فرجة في صف رفعه الله بها درجة ، وبنى PageV07P224 له بيتا في الجنة ) )(@)(@@) ( ش ) عن عروة بن الزبير مرسلا ، ( طس ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 22059 ) قال النبي :(@)(@@) | 30 ( من سد فرجة في صف غفر له ) )(@)(@@) البزار عن أبي جحيفة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22060 ) قال النبي :(@)(@@) | 30 ( من سرق من الأرض شبرا طوقه الله من سبع أرضين ) )(@)(@@) ( عب ) عن سعيد بن زيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22061 ) قال النبي :(@)(@@) | 30 ( من سرق شبرا من الأرض أو غله جاء يوم القيامة يحمله على عنقه إلى أسفل الأرضين ) )(@)(@@) ابن جرير والبغوي ( طب ) وأبو نعيم ( كر ) عن يعلى بن مرة الثقفي ، وأبو نعيم عن أبي ثابت أيمن بن يعلى الثقفي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22062 ) قال النبي :(@)(@@) | 30 ( من سرق متاعا فاقطعوا يده ، ثم إن سرق قاقطعوا رجله ، ثم إن سرق فاقطعوا يده ، فإن سرق فاقطعوا رجله ، فإن سرق فاقطعوا عنقه ) )(@)(@@) ( حل ) وضعفه ، و أبو القاسم بن بشران في أماليه ، وابن النجار عن عبد الله بن بدر الجني رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22063 ) قال النبي :(@)(@@) | 30 ( من سر مسلما بعدي فقد سرني في قبري ، ومن سرني في قبري سره الله تعالى يوم القيامة ) )(@)(@@) أبو الحسن بن سمعون في أماليه ، وابن النجار عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22064 ) قال النبي :(@)(@@) | 30 ( من سره أن لا يجد الشيطان عنده طعاما ولا مقيلا ولا مبيتا فليسلم إذا دخل بيته ، وليسم على طعامه ) )(@)(@@) ( طب ) عن سل مان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22065 ) قال النبي :(@)(@@) | 30 ( من سره أن يزحزح عن النار وأن يدخل الجنة ، PageV07P225 فلتأته منيته وهو يشهد أن لا إلاه إلا الله وأن محمدا رسول الله ، ويأتي إلى الناس ما يحب أن يؤتى إليه ) )(@)(@@) ( طب حل ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22066 ) قال النبي :(@)(@@) | 30 ( من سره أن يعلم ما له عند الله 
ms2365	 ، فليعلم ما لله عنده ) )(@)(@@) ( حل ) عن أبي هريرة ، ( حل ) عن سمرة رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22067 ) قال النبي :(@)(@@) | 30 ( من سره أن يستظل من نار جهنم ، فلينظر غريما ، أو يدع لمعسر ) )(@)(@@) ( طب ) عن أبي اليسر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22068 ) قال النبي :(@)(@@) | 30 ( من سره أن يلقى الله عز وجل غدا مسلما ، فليحافظ على الصلوات الخمس حيث ينادى بهن ) )(@)(@@) ( طس ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22069 ) قال النبي :(@)(@@) | 30 ( من سره أن يقرأ القرآن غضا كما أنزل فليقرأه على قراءة ابن أم عبد ) )(@)(@@) ( حم ) و البزار ( طب ع حب ض ) عن أبي بكر وعمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22070 ) قال النبي :(@)(@@) | 30 ( من سره أن ينجيه الله من كربات يوم القيامة فليوسع على معسر أو يدع له ) )(@)(@@) ( عب ) عن يحيى بن أبي كثير مرسلا .(@)(@@)(@@)(@@) $ ( 22071 ) قال النبي :(@)(@@) | 30 ( من سره أن يفرج الله كربته وأن يعطيه مسألته ، وأن يظله في ظل عرشه يوم القيمة فلينظر معسرا أو ليضع له ) )(@)(@@) ( عب ) عن أبي اليسر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22072 ) قال النبي :(@)(@@) | 30 ( من سره أن يستخم له بنو آدم قياما دخل النار ) )(@)(@@) ابن جرير عن معاوية رضي الله عنه وقال الاستخمام : الوقوب .(@)(@@) PageV07P226(@)(@@)(@@)(@@) $ ( 22073 ) قال النبي :(@)(@@) | 30 ( من سره إذا رأته الرجال مقبلا أن يمثل له الرجال قياما فليتبوأ بيتا في النار ) )(@)(@@) ( طب ) و ابن جرير ، ( كر ) عن معاوية رضي الله عنه ، ولفظ ( كر ) : بنى الله له بيتا في النار .(@)(@@)(@@)(@@) $ ( 22074 ) قال النبي :(@)(@@) | 30 ( من سره أن تنفس كربته ، وأن تستجاب دعوته ، فلييسر على معسر ، أو ليضع له ، فإن الله تعالى يحب إغاثة اللهفان ) )(@)(@@) ابن أبي الدنيا في قضاء الحوائج عن عباد بن أبي عبيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22075 ) قال النبي :(@)(@@) | 30 ( من سره أن ينظر إلى أحمق مطاع ، فلينظر إلى هاذا يعني عيينة بن حصن ) )(@)(@@) ( طب ) عن أبي بكرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22076 ) قال النبي :(@)(@@) | 30 ( من سره أن ينظر إلى رجل من أهل النار فلينظر إلى هاذا ) )(@)(@@) ( ك ) عن أبي هريرة أن رسول 
ms2366	 الله قال لأعرابي : هل أخذتك أم ملدم قط ؟ قال : وما أم ملدم ؟ قال : حر بين الجلد واللحم ، قال : ما وجدت هاذا قط ، قال : فهل أخذك الصداع ؟ قال : وما الصداع ؟ قال : عرق يضرب على الإنسان في رأسه ، قال : ما وجدت هاذا قط ، قال : فذكره .(@)(@@)(@@)(@@) $ ( 22077 ) قال النبي :(@)(@@) | 30 ( من سره أن ينظر إلى من صور الله الكتاب في قلبه فلينظر إلى أبي هند ، أنكحوا أبا هند وانكحوا إليه ) )(@)(@@) ( عد ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 22078 ) قال النبي :(@)(@@) | 30 ( من سره أن يذهب كثيرا من وحر الصدر فليصم شهر الصبر وثلاثة أيام من كل شهر ) )(@)(@@) ( حم ) عن أعرابي .(@)(@@)(@@)(@@) $ ( 22079 ) قال النبي :(@)(@@) | 30 ( من سره أن ينظر إلى الدنيا بحذافيرها ، فلينظر إلى هاذه المزبلة ، لو أن الدنيا تعدل عند الله جناح ذبابة ما أعطى كافرا منها شيئا ) )(@)(@@) ابن المبارك عن الحسن مرسلا .(@)(@@) PageV07P227(@)(@@)(@@)(@@) $ ( 22080 ) قال النبي :(@)(@@) | 30 ( من سره أن يقرأ القرآن رطبا كما أنزل فليقرأ على قراءة ابن أم عبد ) )(@)(@@) ابن السني في عمل يوم وليلة عن عمر ، ( ش ) عن القاسم بن عبد الرحمان عن أبيه مرسلا .(@)(@@)(@@)(@@) $ ( 22081 ) قال النبي :(@)(@@) | 30 ( من سره أن يحب الله ورسوله أو يحبه الله ورسوله فليصدق في حديثه إذا حدث ، وليؤد أمانته إذا ائتمن ، وليحسن جوار من جاوره ) )(@)(@@) ( هب ) عن عبد الرحمان بن أبي قراد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22082 ) قال النبي :(@)(@@) | 30 ( من سره أن يعلم أنه يحب الله ورسوله فليقرأ في المصحف ) )(@)(@@) ( هب ) وضعفه عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22083 ) قال النبي :(@)(@@) | 30 ( من سره أن يزحزج عن النار ويدخل الجنة ، فلتأته منيته وهو يشهد أن لا إلاه إلا الله وأن محمدا رسول الله ، وليأت الناس بما يحب أن يؤتى إليه ) )(@)(@@) الخرائطي في مكارم الأخلاق عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22084 ) قال النبي :(@)(@@) | 30 ( من سره أن يقيه الله من فور جهنم يوم القيامة ويجعله في ظله ، فلا يكن على المؤمنين غليظا وليكن بهم رحيما ) )(@)(@@) الحسن بن سفيان وابن لال في مكارم الأخلاق ، وأبو 
ms2367	 الشيخ في الثواب ، والطيبي في الترغيب ، ( حل هب ) عن أبي بكر رضي الله عنه وهو ضعيف .(@)(@@)(@@)(@@) $ ( 22085 ) قال النبي :(@)(@@) | 30 ( من سره أن ينجيه الله من كرب يوم القيامة فلينفس على معسر ، أو يضع عنه ) )(@)(@@) ( م ) عن عبد الله بن أبي قتادة عن أبيه .(@)(@@)(@@)(@@) $ ( 22086 ) قال النبي :(@)(@@) | 30 ( من سره أن يأمن من غم يوم القيامة فلينظر معسرا ، أو ليضع عنه ) )(@)(@@) ( طب ) عن أنس عن أبي قتادة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22087 ) قال النبي :(@)(@@) | 30 ( من سره أن يبسط له في رزقه ، وأن ينسأ له في أثره فليصل رحمه ) )(@)(@@) ( خ م د ) عن أنس ، ( حم خ ) عن أبي هريرة رضي الله عنه .(@)(@@) PageV07P228(@)(@@)(@@)(@@) $ ( 22088 ) قال النبي :(@)(@@) | 30 ( من سره أن تطول أيام حياته ويزاد في رزقه فليصل رحمه ) )(@)(@@) ابن جرير ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22089 ) قال النبي :(@)(@@) | 30 ( من سره النسأ في الأجل والزيادة في الرزق فليصل رحمه ) )(@)(@@) ( حم ض ) عن ثوبان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22090 ) قال النبي :(@)(@@) | 30 ( من سره أن يمد الله له في عمره ، ويوسع له في رزقه ، ويدفع عنه ميتة السوء ، فليتق الله وليصل رحمه ) )(@)(@@) ( عم ) و ابن جرير وصححه والخرائطي في مكارم الأخلاق ، ( طس ك ) وابن النجار عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22091 ) قال النبي :(@)(@@) | 30 ( من سره أن ينظر إلى من نور الله قلبه ، فلينظر إلى الحارث بن مالك ) )(@)(@@) ابن منده ( طب ) عن الحارث بن مالك الأنصاري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22092 ) قال النبي :(@)(@@) | 30 ( من سره أن يحيى حياتي ويموت مماتي ، ويسكن جنة عدن غرسها ربي ، فليوال عليا من بعدي ، وليوال وليه ، وليقتد بأهل بيتي من بعدي فإنهم عترتي خلقوا من طينتي ، ورزقوا فهمي وعلمي ، فويل للمكذبين بفضلهم من أمتي ، القاطعين فيهم صلتي ، لا أنالهم الله شفاعتي ) )(@)(@@) ( حل ) و الرافعي عن ابن عباس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22093 ) قال النبي :(@)(@@) | 30 ( من سره أن يفتح الله له بابا من أبواب الجنة فليشهد بابا من أبواب العجم ، سكانه رهبان بالليل ، ليوث بالنهار ) )(@)(@@) الكيساني والخليلي بن 
ms2368	 عبد الجبار معا في فضائل قزوين ، والرافعي عن ابن عباس ، وفيه ميسرة بن عبد ربه ، قال الرافعي : أساءوا القول فيه .(@)(@@) PageV07P229(@)(@@)(@@)(@@) $ ( 22094 ) قال النبي :(@)(@@) | 30 ( من سره أن يحرم الله وجهه وبدنه على النار فليمت بقزوين ) )(@)(@@) أبو بكر محمد بن عمر الحجال في أماليه والخليل بن عبد الجبار في فضائل قزوين ، والرافعي والديلمي عن ابن عباس رضي الله عنهما ، قال الرافعي : كأن المعنى فليقم بها مرابطا إلى أن يموت .(@)(@@)(@@)(@@) $ ( 22095 ) قال النبي :(@)(@@) | 30 ( من سره أن يختم له بالشهادة والسعادة فليشهد باب قزوين ) )(@)(@@) الحسن بن أحمد العطار والرافعي عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22096 ) قال النبي :(@)(@@) | 30 ( من سره أن ينظر إلى رجل سبقه بعض أعضائه إلى الجنة فلينظر إلى زيد بن صوحان ) )(@)(@@) ( ع عد ) و الخطيب وابن عساكر عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22097 ) قال النبي :(@)(@@) | 30 ( من سره أن ينظر إلى رجل يمشي على ظهر الأرض وقد قضى نحبه فلينظر إلى طلحة ) )(@)(@@) ( ع حل ) و ابن عساكر عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 22098 ) قال النبي :(@)(@@) | 30 ( من سره أن ينظر إلى شبه عيسى بن مريم خلقا وخلقا فلينظر إلى أبي ذر ) )(@)(@@) ( طب ) عن ابن مسعود رضي الله عنه وضعف .(@)(@@)(@@)(@@) $ ( 22099 ) قال النبي :(@)(@@) | 30 ( من سره أن يسقيه الله عز وجل الخمر في الآخرة فليتركها في الدنيا ، ومن سره أن يكسوه الله الحرير في الآخرة فليتركه في الدنيا ، أنهار الجنة تفجر من تحت تلال المسك ، ولو كان أدنى أهل الجنة حلية عدلت بحلية أهل الدنيا جميعا لكان ما يحليه الله عز وجل به في الآخرة أفضل من حلية أهل الدنيا جميعا ) )(@)(@@) ( هق ) في البعث ( كر ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22100 ) قال النبي :(@)(@@) | 30 ( من سره أن يكتال بالمكيال الأوفى يوم القيامة PageV07P230 فليقل عند انصرافه من الصلاة : { سبحان ربك رب العزة عما يصفون } . . . إلى آخر السورة ) )(@)(@@) الديلمي عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22101 ) قال النبي :(@)(@@) | 30 ( من سره أن ينظر إلى عتيق من النار فلينظر إلى هاذا يعني 
ms2369	 أبا بكر ) )(@)(@@) ابن سعد ( ك ) وتعقب عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 22102 ) قال النبي :(@)(@@) | 30 ( من سره أن ينام على الفطرة التي فطر الله الناس عليها فليقل إذا أوى إلى فراشه : اللهم ربي ومليكي وإلاهي لا إلاه إلا أنت ، اللهم إني أسلمت نفسي إليك ، ووجهت وجهي إليك ، وفوضت أمري إليك ، رغبة ورهبة إليك ، لا ملجأ ولا منجا منك إلا إليك ، آمنت بكتابك الذي أنزلت ، ونبيك الذي أرسلت ) )(@)(@@) الخرائطي في مكارم الأخلاق عن البراء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22103 ) قال النبي :(@)(@@) | 30 ( من سره أن يلقى الله عز وجل غدا راضيا فليكثر الصلاة علي ) )(@)(@@) الديلمي عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 22104 ) قال النبي :(@)(@@) | 30 ( من سره أن يجد حلاوة الإيمان فليلبس الصوف تذللا لربه عز وجل ) )(@)(@@) الديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22105 ) قال النبي :(@)(@@) | 30 ( من سره أن يرتع في رياض الجنة فليقرأ الحواميم ) )(@)(@@) أبو نعيم عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22106 ) قال النبي :(@)(@@) | 30 ( من سره أن يسكن بحبوحة الجنة فليلزم الجماعة ، فإن الشيطان مع الواحد وهو من الاثنين أبعد ) )(@)(@@) الديلمي عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22107 ) قال النبي :(@)(@@) | 30 ( من سره أن يصلي في روضة من رياض الجنة PageV07P231 فليصل بين قبري ومنبري ) )(@)(@@) الديلمي عن عبيد الله بن لبيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22108 ) قال النبي :(@)(@@) | 30 ( من سعى بأخيه إلى سلطان أحبط الله عمله كله ، وإن وصل إليه مكروه وأذى جعله الله تعالى مع هامان في درجته في النار ) )(@)(@@) أبو نعيم عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22109 ) قال النبي :(@)(@@) | 30 ( من سقى أخاه قدحا من ماء وهو عطشان كان كعتق رقبة ) )(@)(@@) الديلمي عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 22110 ) قال النبي :(@)(@@) | 30 ( من سقى ولده شربة ماء في صغره ، سقاه الله سبعين شربة من ماء الكوثر يوم القيامة ) )(@)(@@) أبو نعيم عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22111 ) قال النبي :(@)(@@) | 30 ( من سقى عطشانا فأرواه فتح الله عليه بابا من الجنة فقيل له : ادخل منه ، ومن أطعم جائعا 
ms2370	 فأشبعه وسقى عطشانا فأرواه فتحت له أبواب الجنة كلها وقيل له : ادخل من أيها شئت ) )(@)(@@) ( طب ) عن ابن جنيدة الفهري عن أبيه عن جده وضعف .(@)(@@)(@@)(@@) $ ( 22112 ) قال النبي :(@)(@@) | 30 ( من سكن المسجد فقد ضمن الله تعالى له الروح والرحمة والجواز على الصراط ) )(@)(@@) ( طب ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22113 ) قال النبي :(@)(@@) | 30 ( من سل سخيمته على طريق عامر من طريق المسلمين ، فعليه لعنة الله والملائكة والناس أجمعين ) )(@)(@@) ( طس ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22114 ) قال النبي :(@)(@@) | 30 ( من سلم على عشرين رجلا من المسلمين في يوم ، جماعة أو فرادى ثم مات في يومه ذالك وجبت له الجنة وفي ليلته مثل ذالك ) )(@)(@@) PageV07P232 ( طب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22115 ) قال النبي :(@)(@@) | 30 ( من سلم على عشرة من المسلمين فكأنما أعتق رقبة ، ومن مات في يومه أوجب الجنة ) )(@)(@@) ابن جرير عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22116 ) قال النبي :(@)(@@) | 30 ( من سمع النداء فارغا صحيحا فلم يجب فلا صلاة له ) )(@)(@@) ( ك هق ) عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22117 ) قال النبي :(@)(@@) | 30 ( من سمع الأذان فقال : اللهم رب هاذه الدعوة التامة والصلاة القائمة ، آت محمدا الوسيلة والفضيلة ، وابعثه المقام المحمود الذي وعدته حلت له شفاعتي يوم القيامة ) )(@)(@@) أبو الشيخ في الأذان عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22118 ) قال النبي :(@)(@@) | 30 ( من سمع النداء فقال : أشهد أن لا إلاه إلا الله وحده لا شريك له وأن محمدا عبده ورسوله ، اللهم صل عليه وبلغه درجة المسلمين عندك ، واجعلنا في شفاعته يوم القيامة وجبت له الشفاعة ) )(@)(@@) ( طب ) أبو الشيخ في الأذان عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22119 ) قال النبي :(@)(@@) | 30 ( من سمع من رجل حديثا لا يشتهي أن يحدث به عنه فهي أمانة وإن لم يستكتمه ) )(@)(@@) ( حم ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22120 ) قال النبي :(@)(@@) | 30 ( من سمع بي من يهودي أو نصراني ثم لم يتبعني فهو في النار ) )(@)(@@) ( قط ) في الأفراد عن ابن مسعود رضي الله 
ms2371	 عنه .(@)(@@)(@@)(@@) $ ( 22121 ) قال النبي :(@)(@@) | 30 ( من سمع بي من أمتي أو يهودي أو نصراني فلم يؤمن بي لم يدخل الجنة ) )(@)(@@) ( حم ) و ابن جرير ( طب ) عن أبي موسى ا رضي الله عنه .(@)(@@) PageV07P233(@)(@@)(@@)(@@) $ ( 22122 ) قال النبي :(@)(@@) | 30 ( من سمع النداء فلم يجب من غير ضر ولا عذر فلا صلاة له ) )(@)(@@) ( طب ) عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22123 ) قال النبي :(@)(@@) | 30 ( من سمع خيرا فأفشاه كان كمن عمل به ، ومن سمع شرا فأفشاه كان كمن عمل به ) )(@)(@@) الرافعي عن أبي هريرة وابن عباس رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 22124 ) قال النبي :(@)(@@) | 30 ( من سمع الفلاح فلم يجبه فلا هو معنا ولا هو وحده ) )(@)(@@) ( حل ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22125 ) قال النبي :(@)(@@) | 30 ( من سمع النداء يوم الجمعة ولم يأتها ، ثم سمع النداء ثم لم يأتها ثلاثا طبع على قلبه فجعل قلب منافق ) )(@)(@@) ( طب سب ) عن ابن أبي أوفى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22126 ) قال النبي :(@)(@@) | 30 ( من سمع بموت مسلم فدعا له بخير ، كتب الله تعالى له أجر من عاده وشيعه ميتا ) )(@)(@@) ( قط ) في الأفراد ، و ابن النجار عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22127 ) قال النبي :(@)(@@) | 30 ( من سمع النداء فلم يجب ثلاثا ، كتب من المنافقين ) )(@)(@@) البغوي عن أبي زرارة الأنصاري وقال : لا أدري له صحبة أم لا ؟ .(@)(@@)(@@)(@@) $ ( 22128 ) قال النبي :(@)(@@) | 30 ( من سمع الناس بعلمه سمع الله به سامع خلقه وحقره وصغره ) )(@)(@@) ابن المبارك ( حم ) وهناد ( طب حل ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22129 ) قال النبي :(@)(@@) | 30 ( من سمع المؤذن يؤذن فقال كما يقول ، ثم يقول : PageV07P234 رضيت بالله ربا ، وبالإسلام دينا ، وبمحمد نبيا ، وبالقرآن إماما ، وبالكعبة قبلة ، أشهد أن لا إلاه إلا الله وحده لا شريك له ، وأشهد أن محمدا عبده ورسوله ، اللهم اكتب شهادتي هاذه في عليين ، وأشهد عليها ملائكتك المقربين ، وأنبياءك المرسلين ، وعبادك الصالحين ، واختم عليها بآمين ، واجعلها لي عندك عهدا توفينيه يوم القيامة ، إنك لا تخلف الميعاد ، بدرت إليه بطاقة من تحت العرش فيها 
ms2372	 أمانه من النار ) )(@)(@@) ( سق ) في الدعوات ، و ابن صصرى في أماليه عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22130 ) قال النبي :(@)(@@) | 30 ( من سن خيرا فاستن به ، كان له أجره كاملا ، ومن أجور من استن به ، ولا ينقص من أجورهم شيء ، ومن استن شرا فاستن به كان عليه وزره كاملا ، ومن أوزار الذي استن به لا ينقص من أوزارهم شيء ) )(@)(@@) ( حم ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22131 ) قال النبي :(@)(@@) | 30 ( من سن في الإسلام خيرا فاستن به كان له أجره ومثل أجور من تبعه من غير أن ينقص من أجورهم شيء ، ومن سن شيئا فاستن به كان عليه وزره ومثل أوزار من تبعه من غير أن ينقص من أوزارهم شيء ) )(@)(@@) ( حم بز طس ك ض ) عن أبي عبيدة بن حذيفة عن أبيه .(@)(@@)(@@)(@@) $ ( 22132 ) قال النبي :(@)(@@) | 30 ( من سن سنة هدى فاتبع عليها ، كان له أجرها وأجر من عمل بها من غير أن ينقص من أجورهم شيء ، ومن سن سنة ضلالة فاتبع عليها كان عليه مثل أوزارهم من غير أن ينقص من أوزارهم شيء ) )(@)(@@) السجزي في الإبانة عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22133 ) قال النبي :(@)(@@) | 30 ( من سن سنة حسنة فله أجرها ما عمل بها في حياته PageV07P235 وبعد مماته حتى تترك ، ومن سن سنة سيئة فعليه أثمها حتى تترك ، ومن مات مرابطا في سبيل الله جرى له أجر المرابط حتى يبعث يوم القيامة ) )(@)(@@) ( طب ) و السجزي في الإبانة عن واثلة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22134 ) قال النبي :(@)(@@) | 30 ( من سود اسمه مع إمام جائر حشر معه يوم القيامة ) )(@)(@@) الخطيب في المتفق والمفترق عن مجاهد مرسلا سنده ضعيف .(@)(@@)(@@)(@@) $ ( 22135 ) قال النبي :(@)(@@) | 30 ( من شاء فليصل في رحله ) )(@)(@@) ( ت ) حسن صحيح عن جابر رضي الله عنه قال : كنا مع النبي في سفر فأصابنا مطر فقال : فذكره .(@)(@@)(@@)(@@) $ ( 22136 ) قال النبي :(@)(@@) | 30 ( من شاء فليصل في نعليه ، ومن شاء فليخلعهما ) )(@)(@@) عبد الرزاق عن الحكم بن عيينة مرسلا .(@)(@@)(@@)(@@) $ ( 22137 ) قال النبي :(@)(@@) | 30 ( من شاب شيبة في 
ms2373	 سبيل الله كانت له نورا يوم القيامة ، قيل : فإن رجالا ينتفون الشيب ، قال : من شاء فلينتف نوره ) )(@)(@@) ( طب ) عن فضالة بن عبيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22138 ) قال النبي :(@)(@@) | 30 ( من شاب شيبة في الإسلام كتب له بها حسنة ، ومحيت عنه بها خطيئة ) )(@)(@@) مقاتل بن سليمان في كتاب العجائب عن عمرو بن شعيب عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 22139 ) قال النبي :(@)(@@) | 30 ( من شاب شيبة في الإسلام كتب له بها حسنة ، ومحيت عنه بها خطيئة ، وتباعدت عنه جهنم مسيرة خمسمائة عام ) )(@)(@@) ابن عساكر عن إبان عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22140 ) قال النبي :(@)(@@) | 30 ( من شاب في الإسلام شيبة كانت له حسنة ، ومن شاب في الإسلام شيبة كانت له نورا يوم القيامة ) )(@)(@@) ابن عساكر عن جابر رضي الله عنه .(@)(@@) PageV07P236(@)(@@)(@@)(@@) $ ( 22141 ) قال النبي :(@)(@@) | 30 ( من شاب شيبة في سبيل الله كانت له نورا يوم القيامة ، ومن رمى بسهم في سبيل الله بلغ العدو أو لم يبلغ كان له كعتق رقبة ، ومن أعتق رقبة مؤمنة كانت فداءه من النار ) )(@)(@@) عبد الرزاق ( حم ن هق ) عن عمرو بن عبسة ( طب ) عن أبي أمامة رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22142 ) قال النبي :(@)(@@) | 30 ( من شاب شيبة في الإسلام كانت له نورا يوم القيامة ، ومن رمى بسهم في سبيل الله رفع الله له بها درجة ) )(@)(@@) ( طب ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22143 ) قال النبي :(@)(@@) | 30 ( من شاب شيبة في الإسلام كانت له نورا يوم القيامة ، ومن رمى بسهم في سبيل الله كان كعتق رقبة ) )(@)(@@) ( هق ) عن كعب بن مرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22144 ) قال النبي :(@)(@@) | 30 ( من شاب شيبة في الإسلام كانت له نورا يضيء ما بين السماء والأرض إلى يوم القيامة لا يطفأ حتى يلقاها يوم القيامة وتزمه كما تزم الناقة زمامها حتى تدخله الجنة ) )(@)(@@) أبو الشيخ عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22145 ) قال النبي :(@)(@@) | 30 ( من شان على مسلم كلمة ليشينه بها بغير حق ، شانه الله بها في النار يوم القيامة ) )(@)(@@) ( ك ) عن أبي ذر رضي 
ms2374	 الله عنه .(@)(@@)(@@)(@@) $ ( 22146 ) قال النبي :(@)(@@) | 30 ( من شتم أو ضرب ثم صبر زاده الله بذالك عزا ، فاعفوا يعف الله عنكم ) )(@)(@@) ابن النجار عن عمرو بن شعيب عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 22147 ) قال النبي :(@)(@@) | 30 ( من شرب شربة من ماء فتجرعه في ثلاث جرع ، يسمي الله تعالى في أوله ، ويحمده في آخره ، لم يزل الماء يسبح في بطنه حتى PageV07P237 يخرج ) )(@)(@@) الحافظ أبو زكريا يحيى بن عبد الوهاب ، ابن منده في الطبقات ، والرافعي في تاريخه عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 22148 ) قال النبي :(@)(@@) | 30 ( من شرب خمرا مسكر مستحلا له بعد تحريمه لم يتب ولم ينزع فليس مني ولا أنا منه يوم القيامة ) )(@)(@@) ابن عساكر عن معاوية رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22149 ) قال النبي :(@)(@@) | 30 ( من شرب في إناء ذهب أو فضة أو إناء فيه شيء من ذالك إنما يجرجر في بطنه من نار جهنم ) )(@)(@@) ( هق ) في المعرفة ، و الخطيب وابن عساكر عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22150 ) قال النبي :(@)(@@) | 30 ( من شرب الخمر لم يقبل الله له صلاة أربعين ليلة ، فإن تاب تاب الله عليه ، فإن عاد كان مثل ذالك ، فإن عاد كان حقا على الله أن يسقيه من طينة الخبال ، قالوا : يا رسول الله وما طينة الخبال ؟ قال : عصارة أهل النار ) )(@)(@@) ( حم ) عن أبي ذر ( طب ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22151 ) قال النبي :(@)(@@) | 30 ( من شرب الخمر فسكر ، لم يقبل له صلاة أربعين يوما ، فإن مات فإلى النار ، فإن تاب قبل الله منه ، فإن شرب الثانية فكذالك ، فإن شرب الثالثة فكذالك ، فإن شرب الرابعة كان حقا على الله أن يسقيه من ردغة الخبال ، قيل : يا رسول الله وما ردغة الخبال ؟ قال : عصارة أهل النار ) )(@)(@@) ( ع طب ) عن عياض بن غنم رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22152 ) قال النبي :(@)(@@) | 30 ( من شرب الخمر بعد أن حرمها الله تعالى على لساني ، فليس له أن يزوج إذا خطب ، ولا يشفع إذا شفع ، ولا يصدق إذا حدث ، ولا يؤتمن على أمانة ، فإن اؤتمن أمانة فأكلها فليس 
ms2375	 لصاحبها اين يأجره ولا يحلف PageV07P238 عليه ) )(@)(@@) ابن النجار عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22153 ) قال النبي :(@)(@@) | 30 ( من شرب الخمر لم يرض الله عنه أربعين يوما ، فإن مات مات كافرا ، وإن تاب تاب الله عليه ، وإن عاد كان حقا على الله تعالى أن يسقيه من طينة الخبال : صديد أهل النار ) )(@)(@@) ( حم طب ) عن أسماء بنت يزيد رضي الله عنها .(@)(@@)(@@)(@@) $ ( 22154 ) قال النبي :(@)(@@) | 30 ( من شرب الخمر أتى عطشان يوم القيامة ، ألا وكل مسكر خمر ، وإياكم والغبيراء ) )(@)(@@) ( حم ) عن قيس بن سعد وابن عمر رضي الله عنهما معا .(@)(@@)(@@)(@@) $ ( 22155 ) قال النبي :(@)(@@) | 30 ( من شرب المسكر لم تجز شهادته ) )(@)(@@) الديلمي عن أبي برزة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22156 ) قال النبي :(@)(@@) | 30 ( من شرب الخمر فاجلدوه ، ومن عاد فاجلدوه ، فإن عاد فاجلدوه ، فإن عاد فاقتلوه ) )(@)(@@) ( حب ض ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22157 ) قال النبي :(@)(@@) | 30 ( من شرب الخمر في الدنيا ولم يتب لم يشربها في الآخرة وإن أدخل الجنة ) )(@)(@@) ( هب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22158 ) قال النبي :(@)(@@) | 30 ( من شرب الخمر مرة لم تقبل توبته أربعين صباحا ، فإن تاب تاب الله عليه ، فإن عاد لم تقبل توبته أربعين صباحا ، فإن تاب تاب الله عليه ، فإن عاد كان حقا على الله أن يسقيه من ردغة الخبال يوم القيامة ) )(@)(@@) ( هب ) عن ابن عمرو رضي الله عنه .(@)(@@) PageV07P239(@)(@@)(@@)(@@) $ ( 22159 ) قال النبي :(@)(@@) | 30 ( من شرب الخمر في الدنيا ثم مات وهو يشربها لم يتب منها ، حرمها الله عليه في الآخرة ) )(@)(@@) ( عب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22160 ) قال النبي :(@)(@@) | 30 ( من شرب الخمر صباحا كان كالمشرك بالله حتى يمسي ، وكذالك إن شربها ليلا كان كالمشرك بالله حتى يصبح ، ومن شربها حتى يسكر لم تقبل له صلاة أربعين صباحا ، ومن مات وفي عروقه منها شيء مات ميتة جاهلية ) )(@)(@@) ( ت ) عن المنكدر مرسلا .(@)(@@)(@@)(@@) $ ( 22161 ) قال النبي :(@)(@@) | 30 ( من شرب الخمر في الدنيا لم يشرب منها في الآخرة إلا أن يتوب ) )(@)(@@) ( كر ) عن ابن عمر رضي الله 
ms2376	 عنهما .(@)(@@)(@@)(@@) $ ( 22162 ) قال النبي :(@)(@@) | 30 ( من شرب منكم النبيذ فليشربه زبيبا فردا ، أو تمرا فردا ، أو بسرا فردا ) )(@)(@@) ( ع ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22163 ) قال النبي :(@)(@@) | 30 ( من شرب شرابا يذهب بعقله فقد أتى بابا من أبواب الكبائر ) )(@)(@@) ابن أبي الدنيا ، ( هب ) وابن النجار عن ابن عباس رضي الله عنهما ، ( طب ) عنه موقوفا .(@)(@@)(@@)(@@) $ ( 22164 ) قال النبي :(@)(@@) | 30 ( من شرب نبيذا فاقشعر منه مفرق رأسه ، فالحسوة منه حرام ) )(@)(@@) ( الخطيب ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 22165 ) قال النبي :(@)(@@) | 30 ( من شرب حسوة من خمر لم يقبل الله منه ثلاثة أيام صرفا ولا عدلا ، ومن شرب كأسا لم يقبل الله منه أربعين صباحا ، والمدمن الخمر حق على الله أن يسقيه من نهر الخبال ، قيل : يا رسول الله وما نهر الخبال ؟ قال : صديد أهل النار ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22166 ) قال النبي :(@)(@@) | 30 ( من شرب الخمر كان نجسا أربعين يوما ، فإن تاب منها تاب الله عليه ، وإن عاد عاد نجسا ، وإن تاب تاب الله عليه ، فإن عاد عاد PageV07P240 نجسا أربعين يوما ، فإن تاب منها تاب الله عليه ، فإن رجع كان حقا على الله أن يسقيه من ردغة الخبال ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22167 ) قال النبي :(@)(@@) | 30 ( من شرب الخمر فسكر لم تقبل له صلاة أربعين يوما ، ثم أن شربها حتى يسكر لم تقبل له صلاة أربعين يوما ، ثم أن شربها فكذالك ، ثم إن شربها الرابعة فسكر منها كان حقا على الله أن يسقيه من عين الخبال ، قيل : وما الخبال ؟ قال : صديد أهل النار ) )(@)(@@) ( ك ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22168 ) قال النبي :(@)(@@) | 30 ( من شارك في دم حرام بشطر كلمة ، جاء يوم القيامة مكتوب بين عينيه : آيس من رحمة الله ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22169 ) قال النبي :(@)(@@) | 30 ( من شرط لأخيه شرطا لا يريد أن يفي له به ، فهو كالمدلي جاره إلى خير منعه ) )(@)(@@) ( حم ) و أبو نعيم عن حذيفة رضي الله 
ms2377	 عنه .(@)(@@)(@@)(@@) $ ( 22170 ) قال النبي :(@)(@@) | 30 ( من شفع شفاعة يدفع بها مغرما ، أو يحيي بها مغنما ، ثبت الله تعالى قدميه حين تدحض الأقدام ) )(@)(@@) ( عق ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22171 ) قال النبي :(@)(@@) | 30 ( من شق عصا المسلمين والمسلمون في إسلام دابح فقد خلع ربقة الإسلام من عنقه ) )(@)(@@) الرامهرمزي في الأمثال ، ( طب ) والخطيب في المتفق والمفترق عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22172 ) قال النبي :(@)(@@) | 30 ( من شهد أن لا إلاه إلا الله وأني رسول الله ، فذكر PageV07P241 بها لسانه ، واطمأن بها قلبه ، لم تطعمه النار ) )(@)(@@) سمويه وابن مردويه ( طب ) والخطيب في المتفق والمفترق عن أبي قتادة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22173 ) قال النبي :(@)(@@) | 30 ( من شهد العشاء في جماعة ، كان له قيام ليلة ) )(@)(@@) ( هب ) عن عثمان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22174 ) قال النبي :(@)(@@) | 30 ( من شهد صلاة الصبح محتسبا فكأنما قام الليل ، ومن شهد صلاة العشاء فكأنما قام نصف الليل ) )(@)(@@) ( عب ) عن عثمان رضي الله عنه ، ( مالك ) عنه موقوفا .(@)(@@)(@@)(@@) $ ( 22175 ) قال النبي :(@)(@@) | 30 ( من شهد أن لا إلاه إلا الله مخلصا من قلبه دخل الجنة ) )(@)(@@) ( حب ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22176 ) قال النبي :(@)(@@) | 30 ( من شهد أن لا إلاه إلا الله وأني رسول الله فلن تطعمه النار ) )(@)(@@) ( حم ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22177 ) قال النبي :(@)(@@) | 30 ( من شهد أن لا إلاه إلا الله مخلصا بها ، يموت على ذالك ، حرمه الله عز وجل على النار ) )(@)(@@) ( قط ) في الأفراد عن النضر بن أنس عن أبيه ، قال النضر : أمرنا أبي أن نكتب هاذا الحديث ، ولم يأمرنا أن نكتب حديثا غيره .(@)(@@)(@@)(@@) $ ( 22178 ) قال النبي :(@)(@@) | 30 ( من شهد أن لا إلاه إلا الله ، وحافظ على صلاة الفجر ، ولم يتند بدم حرام دخل الجنة ) )(@)(@@) ( ض ) عن حذيفة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22179 ) قال النبي :(@)(@@) | 30 ( من شهد أن لا إلاه إلا الله دخل الجنة ) )(@)(@@) ( ن طس ) عن ابن عمر وعن عمر ، تمام عن جابر عن عمر رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 22180 ) قال النبي :(@)(@@) | 30 ( من شهد أن لا إلاه إلا 
ms2378	 الله فهو له نجاة ) )(@)(@@) ( ع ) و ابن منيع ، ابن عمر عن عمر عن أبي بكر رضي الله عنهم .(@)(@@) PageV07P242(@)(@@)(@@)(@@) $ ( 22181 ) قال النبي :(@)(@@) | 30 ( من شهد أن لا إلاه إلا الله وأن محمدا عبده ورسوله مخلصا دخل الجنة ) )(@)(@@) ( طس ) عن أبي الدرداء والباوردي وابن منده عن ابن وائل الجذامي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22182 ) قال النبي :(@)(@@) | 30 ( من شهد أن لا إلاه إلا الله وأني رسول الله مخلصا بهما دخل الجنة ، وصلى وصام ، وأقام الزكاة ، وحج البيت حرمه الله على النار ) )(@)(@@) ( طس ) عن أنس رضي الله عنه ( طس ) عن عتبان بن مالك بلفظ : حرم الله وجهه على النار .(@)(@@)(@@)(@@) $ ( 22183 ) قال النبي :(@)(@@) | 30 ( من شهد أن لا إلاه إلا الله مخلصا من قلبه وأن محمدا عبده ورسوله دخل الجنة ولم تمسه النار ) )(@)(@@) ( طب ) و الخلعي ، ( هب ) عن معاذ بن جبل ، ابن خزيمة عن عبد الله بن سلام رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22184 ) قال النبي :(@)(@@) | 30 ( من شهد أمرا فكرهه كان كمن غاب عنه ، ومن غاب عن أمر فرضي به كان كمن شهده ) )(@)(@@) ( ك ) عن السيد الحسين رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22185 ) قال النبي :(@)(@@) | 30 ( من شهد جنازة ومشى أمامها ، وحمل بأربع زوايا السرير ، وجلس حتى تدفن ، له قيراطان من أجر ، أخفها في ميزانه يوم القيامة أثقل من جبل أحد ) )(@)(@@) ( عد ) و ابن عساكر عن واثلة رضي الله عنه ، ومعروف ليس بالقوي .(@)(@@)(@@)(@@) $ ( 22186 ) قال النبي :(@)(@@) | 30 ( من شهد صلاتنا هاذه ووقف معنا حتى تدفع ، وقد وقف بعرفة قبل ذالك ليلا أو نهارا فقد تم حجه ، وقضى تفثه ) )(@)(@@) ( ت ) حسن صحيح عن عروة بن مضرس الطائي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22187 ) قال النبي :(@)(@@) | 30 ( من شهد له خزيمة أو شهد عليه فحسبه ) )(@)(@@) ( ع طب ) و الباوردي ( ك هق ) وابن عساكر ( ض ) عن خزيمة بن ثابت عن أبيه .(@)(@@) PageV07P243(@)(@@)(@@)(@@) $ ( 22188 ) قال النبي :(@)(@@) | 30 ( من شهد فاتحة الكتاب حين تستفتح ، كان كمن شهد فتحا في سبيل الله ، ومن شهد خاتمته حين يختم كان كمن شهد الغنائم حين تقسم ) )(@)(@@) محمد بن نصر وابن 
ms2379	 الضريس عن أبي قلابة مرسلا .(@)(@@)(@@)(@@) $ ( 22189 ) قال النبي :(@)(@@) | 30 ( من شهد على مسلم شهادة ليس لها بأهل فليتبوأ مقعده من النار ) )(@)(@@) ( حم ) و ابن أبي الدنيا في ذم الغيبة عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22190 ) قال النبي :(@)(@@) | 30 ( من شهد إملاك امرىء مسلم فكأنما صام يوما في سبيل الله عز وجل ، واليوم سبعمائة ، ومن شهد ختان امرىء مسلم فكأنما صام يوما في سبيل الله ، واليوم سبعمائة ، ومن شهد جنازة امرىء مسلم فكاينما صام يوما في سبيل الله ، واليوم سبعمائة ، ومن عاد مريضا فكأنما صام يوما في سبيل الله ، اليوم سبعمائة ، ومن اغتسل يوم الجمعة فكأنما صام يوما في سبيل الله ، واليوم سبعمائة ) )(@)(@@) الأزدي في الضعفاء وضعفه وأبو البركات ابن السقطي في معجمه وأبو الشيخ وابن النجار عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22191 ) قال النبي :(@)(@@) | 30 ( من شهد أن لا إلاه إلا الله وأن محمدا عبده ورسوله ، وآمن بالبعث والحساب ، دخل الجنة ) )(@)(@@) ابن صصرى في أماليه عن راعي النبي .(@)(@@)(@@)(@@) $ ( 22192 ) قال النبي :(@)(@@) | 30 ( من شهد أن لا إلاه إلا الله وأن محمدا رسول الله ، وأقام الصلاة ، وصام رمضان ، كان حقا على الله أن يغفر له ، إن هاجر أو قعد حيث ولدته أمه ، قيل : يا رسول الله ألا أخرج فأؤذن الناس ؟ قال : لا ، ذر PageV07P244 الناس يعملون ، فإن الجنة مائة درجة ، بين كل درجتين فيهما مثل ما بين السماء والأرض ، وأعلى درجة منها الفردوس ، وعليها يكون العرش ، وهي أوسط شيء من الجنة ، ومنها تفجر أنهار الجنة ، وإذا سألتم الله فاسألوه الفردوس ) )(@)(@@) ( طب ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22193 ) قال النبي :(@)(@@) | 30 ( من شهد فتح القرآن فكأنما شهد فتوح المسلمين حين يفتح ، ومن شهد ختم القرآن فكأنما شهد الغنائم حين تقسم ) )(@)(@@) أبو الشيخ والديلمي من طريقين عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22194 ) قال النبي :(@)(@@) | 30 ( من شهد الصلوات الخمس أربعين ليلة في جماعة يدرك التكبيرة الأولى وجبت له الجنة ) )(@)(@@) ( عب ) عن أبي العالية مرسلا .(@)(@@)(@@)(@@) $ ( 22195 ) قال النبي :(@)(@@) | 30 ( من شهد أن 
