ms5741	 ) . ( أبو عبيد ) . )(@)(@@)(@@)(@@) $ ( 9264 ) عن أبي الدرداء رضي الله عنه قال : ' أهدي لرسول الله & كبشان أملحان جذعان فضحى بهما ' ( ع ، كر ) .(@)(@@)(@@)(@@) $ 9265 عن أبي الدرداء رضي الله عنه :(@)(@@) | 30 ( أن عمر رضي الله عنه أتي بسارقة سوداء فقال لها : أسرقت ؟ قولي : لا ، قالوا : أتلقنها ؟ قال : جئتما بإنسان لا يدري ما PageV17P089 يراد به من الخير أم الشر لتقر حتى أقطعها ) . ( ابن خسرو ) . )(@)(@@)(@@)(@@) $ 9266 عن أبي الدرداء رضي الله عنه قال :(@)(@@) | 30 ( أوصاني خليلي أبو القاسم قال : ( أنفق من طول علاى أهلك ولا ترع عصاك عنهم ، أخفهم لله تعالاى ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 9267 عن الوضين بن عطاء ، عن يزيد بن مرثد ، عن أبي الدرداء ، وعن أبي ذر رضي الله عنهم ، عن النبي :(@)(@@) | 30 ( أن داود عليه السلام قال : إلاهي ما حق عبادك عليك إذا هم زاروك في بيتك ، فإن لكل زائر علاى المزور حقا ؟ فقال : يا داود إن لهم علي أن أعافيهم في دنياهم ، وأغفر لهم إذا لقيتهم ) . ( كر ، البغوي ) . )(@)(@@)(@@)(@@) $ 9268 عن أبي الدرداء رضي الله عنه قال :(@)(@@) | 30 ( اذكروا الله في أسفاركم عند كل حجيرة وشجيرة ، لعلها أن تأتي يوم القيامة فتشهد لكم ) . ( ابن شاهين في الترغيب في الذكر ) . )(@)(@@)(@@)(@@) $ 9269 عن معر الضبي قال :(@)(@@) | 30 ( لما قدم عبد الله بن عامر الشام أتاه من شاء الله أن يأتيه من أصحاب النبي وغيرهم إلا أبا الدرداء رضي الله عنه ، فإنه لم يأته ، فقال : لا أراى أبا الدرداء أتاني فيمن أتاى ، فلآتينه ولأقضين من حقه ، فأتاه فسلم عليه وقال له : أتاني أصحابك ولم تأتني ، فأجبت أن آتيك وأقضي من حقك ، فقال له أبو الدرداء : ما كنت قط أصغر في عين الله ولا في عيني منك اليوم ، إن رسول الله أمرنا أن نتغير عليكم إذا تغيرتم ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9270 عن أبي الدرداء رضي الله عنه قال :(@)(@@) | 30 ( لا إيمان لمن لا صلاة له ، ولا صلاة لمن لا وضوء له ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 9271 عن أبي الدرداء رضي الله عنه قال :(@)(@@) | 30 ( خرج علينا رسول الله PageV17P090 متوشحا في ثوب 
ms5742	 واحد ، في رأسه أثر الغسل ، فصلى فقلت : يا رسول الله أفيه وفيه ؟ قال : ( نعم ) ، يعني الجنابة والصلاة ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9272 عن إسحاق بن الحارث ، مولاى بني هبار قال :(@)(@@) | 30 ( رأيت أبا الدرداء رضي الله عنه يخضب بالصفرة ، ورأيت عليه قلنسوة مضربة صغيرة ، ورأيت عليه قلنسوة مضربة صغيرة ، ورأيت عليه عمامة قد ألقاها علاى كتفيه ، وفي لفظ : قد أرخاى بها بين كتفيه ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9273 عن جبير بن نفير :(@)(@@) | 30 ( أن عمر بن الخطاب رضي الله عنه كتب إلاى عمير بن سعد : إنه من قبلك عن الركعتين بعد العصر ، فقال أبو الدرداء رضي الله عنه : أما أنا فما كنت لأدعهما ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 9274 عن أبي الدرداء رضي الله عنه قال :(@)(@@) | 30 ( أقرأ في الركعتين الأوليين من الظهر والعصر والعشاء الآخرة في كل ركعة بأم القرآن وسورة ، وفي الركعة الآخرة من المغرب بأم القرآن ) . ( عب ) . )(@)(@@)(@@)(@@) $ 9275 عن أبي الدرداء رضي الله عنه :(@)(@@) | 30 ( أنه سجد مع رسول الله اثنتي عشرة سجدة ، منهن التي في النجم ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9276 عن أبي الدرداء رضي الله عنه قال :(@)(@@) | 30 ( أيها الناس إياكم والالتفات في الصلاة ، فإنه لا صلاة للملتفت ، وإن غلبتم علاى تطوع فلا تغلبوا علاى المكتوبة ) . ( ش ) . )(@)(@@)(@@)(@@) $ 9277 عن أبي الدرداء رضي الله عنه :(@)(@@) | 30 ( أنه مر برجل لا يتم ركوعا ولا سجودا فقال : شيء خير من لا شيء ) . ( عب ) . )(@)(@@)(@@)(@@) $ 9278 عن أبي الدرداء رضي الله عنه :(@)(@@) | 30 ( أنه قال لرجل : مررت بين يدي PageV17P091 صلاة أخيك ، وهدمت من عملك بنيان سنة أو سنتين ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9279 عن أبي الدرداء رضي الله عنه قال :(@)(@@) | 30 ( ليعقبن الله المشائين إلاى المساجد في الظلم نورا تاما يوم القيامة ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9280 عن أم الدرداء قالت :(@)(@@) | 30 ( دخلت علاى أبي الدرداء رضي الله عنه وهو غضبان ، فقلت له : ما أغضبك ؟ فقال : والله ما أعرف منهم من أمر محمد شيئا غير أنهم يصلون جميعا ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9281 عن أبي الدرداء رضي الله عنه قال :(@)(@@) | 30 ( سئل رسول الله أفي كل صلاة قراءة ؟ فقال : ( نعم ) ، فقال 
ms5743	 رجل من الأنصار : وجبت ، فقال لي رسول الله وكنت أقرب القوم إليه : ( ما أراى الامام إذا أم القوم إلا قد كفاهم ) . ( ق في القراءة وقال : هاذا خطأ ، والمحفوظ الأول ) . )(@)(@@)(@@)(@@) $ 9282 عن أبي الدرداء رضي الله عنه :(@)(@@) | 30 ( أن رجلا قال : يا رسول الله في كل صلاة قراءة ؟ قال : ( نعم ) ، فقال رجل : وجبت ، فقال أبو الدرداء : ما أراى الامام إذا أم القوم إلا قد كفاهم ) . ( ق في القراءة ) . )(@)(@@)(@@)(@@) $ 9283 عن أبي الدرداء رضي الله عنه قال :(@)(@@) | 30 ( استقاء رسول الله فأفطر ، وأتي بماء فتوضأ ) . ( ش ، عب صحيح ) . )(@)(@@)(@@)(@@) $ 9284 عن معاوية بن قرة قال :(@)(@@) | 30 ( كان لأبي الدرداء رضي الله عنه جمل يقال له : دمون ، فكانوا إذا استعاروه منه قال : لا تحملوا عليه إلا كذا وكذا ، فإنه لا يطيق أكثر من ذالك ، فلما حضرته الوفاة قال : يا دمون لا تخاصمني غدا عند ربي ، فإني لم أكن أحمل عليك إلا ما تطيق ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9285 عن أبي الدرداء رضي الله عنه :(@)(@@) | 30 ( أنه سئل عن مس الذكر فقال : إنما PageV17P092 هو بضعة منك ) . ( ص ) . )(@)(@@)(@@)(@@) $ 9286 عن أبي الدرداء رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : ( يا أبا الدرداء إذا آذاك البراغيث ، فخذ قدحا من ماء واقرأ عليه سبع مرات ) : { وما لنا أن لا نتوكل علاى الله } الآية ، فإن كنتم آمنتم بالله فكفوا شركم وأذاكم عنا ، ثم ترش حول فراشك ، فإنك تبيت الليلة آمنا من شره ) . ( الديلمي ) . )(@)(@@)(@@)(@@) $ 9287 عن أبي الدرداء رضي الله عنه قال :(@)(@@) | 30 ( قال لي رسول الله : ( يا عويمر ، يا أبا الدرداء كيف بك إذا قيل لك يوم القيامة : أعلمت أم جهلت ؟ فإن قلت : علمت ، قيل لك : فماذا عملت فيما تعلمت ، وإن قلت : جهلت ، قيل لك : فماذا عذرك فيما جهلت ، ألا تعلمت ؟ ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9288 عن أبي الدرداء رضي الله عنه قال :(@)(@@) | 30 ( يوشك العلم أن يرفع ، ورفعه أن يذهب بجملته ) . ( كر ) . )(@)(@@)(@@)(@@) $ ( 9289 ) عن أبي الدرداء رضي الله عنه قال : ' لا يفقه الرجل كل الفقه حتى يمقت الناس في جنب الله ثم يرجع 
ms5744	 إلى نفسه فيكون لها أشد مقتا ' . ( كر ) .(@)(@@)(@@)(@@) $ 9290 عن أبي الدرداء رضي الله عنه قال :(@)(@@) | 30 ( لا تكون عالما حتى تكون متعلما ، ولا تكون بالعلم عالما حتى تكون به عاملا ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9291 عن أبي الدرداء رضي الله عنه :(@)(@@) | 30 ( أنه كان إذا حدث بالحديث عن رسول الله قال : اللهم إن لا هاكذا فشكله ) . ( ع ، والروياني ، كر ) . )(@)(@@) PageV17P093(@)(@@)(@@)(@@) $ 9292 عن أبي الدرداء رضي الله عنه قال :(@)(@@) | 30 ( ليخرجنكم الروم من الشام كفرا كفرا حتى يوردوكم البلقاء ، كذالك الدنيا تتبدد وتفنى ، والآخرة تدوم وتبقاى ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9293 عن أبي الدرداء رضي الله عنه قال :(@)(@@) | 30 ( حبذا موتا علاى الإسلام قبل الفتن ) . ( نعيم بن حماد في الفتن ) . )(@)(@@)(@@)(@@) $ 9294 عن أبي الدرداء رضي الله عنه قال :(@)(@@) | 30 ( سترون أمورا تنكرونها فعليكم بالصبر ، ولا تغيروا ولا تقولوا : نغير حتى يكون الله تعالاى هو المغير ) . ( نعيم ) . )(@)(@@)(@@)(@@) $ 9295 عن أبي الدرداء رضي الله عنه قال :(@)(@@) | 30 ( إذا زخرفتم مساجدكم وحليتم مصاحفكم فعليكم الدبار ) . ( ابن أبي الدنيا في المصاحف ) . )(@)(@@)(@@)(@@) $ 9296 عن أبي الدرداء رضي الله عنه قال :(@)(@@) | 30 ( إذا قتل الخليفة الشاب من بني أمية بين الشام والعراق مظلوما ، لم تزل طاعة مستخف بها ودم مسفوك علاى وجه الأرض بغير حق يعني : الوليد بن يزيد ) . ( نعيم بن حماد في الفتن ) . )(@)(@@)(@@)(@@) $ 9297 عن أبي الدرداء رضي الله عنه قال : قال رسول الله :(@)(@@) | 30 ( ليكفرن أقوام بعد إيمانهم ) ، فبلغ ذالك أبا الدرداء ، فأتاه فقال : يا رسول الله بلغني أنك قلت : ليكفرن أقوام بعد إيمانهم ، قال : ( نعم ، ولست منهم ) . ( كر ، وابن النجار ) . )(@)(@@)(@@)(@@) $ 9298 عن أبي الدرداء رضي الله عنه قال :(@)(@@) | 30 ( رأى النبي رجلا يمشي أمام أبي بكر رضي الله عنه فقال : أتمشي أمام من هو خير منك ، إن أبا بكر خير مما طلعت عليه الشمس وغربت ) . ( كر ، سنده حسن ) . )(@)(@@) PageV17P094(@)(@@)(@@)(@@) $ 9299 عن أبي الدرداء رضي الله عنه قال :(@)(@@) | 30 ( سمعت رسول الله يقول : ( من فلق فيه إلاى أذني ) ، ورآني وأنا أمشي بين يدي أبي بكر وعمر رضي الله عنهما فدعاني وقال لي : ( يا 
ms5745	 أبا الدرداء أتمشي بين يدي من هو خير منك ) ؟ فقلت : ومن هو يا رسول الله ؟ فقال : ( أبو بكر وعمر ، ما طلعت الشمس ولا غربت علاى أحد بعد النبيين والمرسلين خير من أبي بكر وعمر ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9300 عن أبي عبيد الله الأشعري قال :(@)(@@) | 30 ( سمعت أبا الدرداء رضي الله عنه يقول : قلت : يا رسول الله بلغني أنك قلت : سيكفر قوم بعد إيمانهم ؟ قال : ( أجل ، ولست منهم ) ؛ قال : فتوفي أبو الدرداء قبل قتل عثمان رضي الله عنه ) . ( أبو نعيم في المعرفة ) . )(@)(@@)(@@)(@@) $ 9301 عن أبي الدرداء رضي الله عنه قال :(@)(@@) | 30 ( لا مدينة بعد عثمان ولا رخاء بعد معاوية ، وقال النبي : ( إن الله وعدني إسلام أبي الدرداء ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9302 عن أبي الدرداء رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : ( أنا وفي لفظ : إني فرطكم علاى الحوض ، أنظر من يرد علي منكم ، فلا ألفين ما نوزعت في أحدكم فأقول : هاذا مني وفي لفظ : من أمتي ، وفي لفظ : من أصحابي فيقال : إنك لا تدري ما أحدث بعدك ) ، فقلت : يا رسول الله ادع الله أن لا يجعلني منهم ، قال : ( إنك لست منهم ، فتوفي أبو الدرداء قبل أن يقتل عثمان وقبل أن تقع الفتن ) . ( يعقوب بن سفيان ، كر ) . )(@)(@@)(@@)(@@) $ 9303 عن أبي الدرداء رضي الله عنه قال :(@)(@@) | 30 ( أتيت رسول الله فقلت : يا رسول الله بلغني أنك قلت : ليكفرن أقوام بعد إيمانهم ؟ قال : ( نعم ، ولست منهم ) ؛ فتوفي أبو الدرداء قبل أن يقتل عثمان ) . ( يعقوب بن سفيان ، ق في الدلائل ، كر وابن النجار ) . )(@)(@@) PageV17P095(@)(@@)(@@)(@@) $ 9304 عن أبي الدرداء رضي الله عنه :(@)(@@) | 30 ( أن النبي قال لما اهتز الجبل : ( اهدأ حراء فما عليك إلا نبي ، أو صديق أبو بكر أو الفاروق عمر ، أو التقي عثمان ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9305 عن أبي الدرداء رضي الله عنه :(@)(@@) | 30 ( أنه ذكر أبا ذر فقال : إن رسول الله كان يأتمنه حين لا يأتمن أحدا ، ويسر إليه حين لا يسر إلاى أحد ) . ( ابن جرير ) .(@)(@@)(@@)(@@) $ 30(@)(@@)(@@)(@@) $ 9305 عن أبي الدرداء رضي الله عنه :(@)(@@) | 30 ( أنه ذكر أبا ذر 
ms5746	 فقال : إن رسول الله كان يأتمنه حين لا يأتمن أحدا ، ويسر إليه حين لا يسر إلاى أحد ) . ( ابن جرير ) .(@)(@@)(@@)(@@) $ 30(@)(@@)(@@)(@@) $ 9306 عن جويرية قال بعضه عن نافع وبعضه عن رجل من ولد أبي الدرداء قال :(@)(@@) | 30 ( استأذن أبو الدرداء عمر رضي الله عنهما في أن يأتي الشام ، فقال : لا آذن لك إلا أن تعمل ، قال : فإني لا أعمل ، قال : فإني لا آذن لك ، قال : فأنطلق فأعلم الناس سنة نبيهم وأصلي بهم ، فأذن له ، فخرج عمر رضي الله عنه إلاى الشام ، فلما كان قريبا منهم أقام حتى أمساى ، فلما جنه الليل قال : يا يرفأ انطلق إلاى يزيد بن أبي سفيان أبصره ، عنده سمار ومصباح ، مفترشا ديباجا وحريرا من فيء المسلمين ؟ فتسلم عليه فيرد عليك السلام ، وتستأذن فلا يأذن لك حتى يعلم من أنت ، فانطلقنا حتى انتهينا إلاى بابه ، فقال : السلام عليكم ، فقال : وعليكم السلام ، قال : أدخل ؟ قال : ومن أنت ؟ قال يرفأ : هاذا من يسوءك ، هاذا أمير المؤمنين ففتح الباب ، فإذا سمار ومصباح ، وإذا هو مفترش ديباجا وحريرا ، فقال : يا يرفأ الباب الباب ثم وضع الدرة بين أذنيه ضربا ، وكور المتاع فوضعه وسط البيت ، ثم قال للقوم : لا يبرح منكم أحد حتى أرجع إليكم ، ثم خرجا من عنده ، ثم قال : يا يرفأ إنطلق بنا إلاى عمرو بن العاص أبصره عنده سمار ومصباح ؟ مفترش ديباجا من فيء المسلمين ؟ فتسلم عليه فيرد عليك ، وتستأذن عليه فلا يأذن لك حتى يعلم من أنت ، PageV17P096 فانتهينا إلاى بابه ، فقال عمر : السلام عليكم ، قال : وعليكم السلام ، قال : أدخل قال : ومن أنت ؟ قال يرفأ : هاذا من يسوءك ، هاذا أمير المؤمنين ففتح الباب ، فإذا سمار ومصباح ، وإذا هو مفترش ديباجا وحريرا فقال : يا يرفأ الباب الباب ثم وضع الدرة بين أذنيه ضربا ، ثم كور المتاع فوضعه في وسط البيت ، ثم قال للقوم : لا تبرحن حتى أعود إليكم ، فخرجا من عنده ، فقال : يا يرفأ انطلق بنا إلاى أبي موساى أبصره عنده سمار ومصباح ، مفترشا صوفا من مال فيء المسلمين ، فتستأذن عليه 
ms5747	 فلا يأذن لك حتى يعلم من أنت ، فانطلقنا إليه وعنده سمار ومصباح مفترشا صوفا ، فوضع الدرة بين أذنيه ضربا وقال : أنت أيضا يا أبا موساى فقال : يا أمير المؤمنين هاذا وقد رأيت ما صنع أصحابي ، أما والله لقد أصبت مثل ما أصابوا ، قال : فما هاذا ؟ قال : زعم أهل البلد أنه لا يصلح إلا هاذا ؛ فكور المتاع فوضعه في وسط البيت ، وقال للقوم : لا يخرجن منكم أحد حتى أعود إليكم ، فلما خرجنا من عنده قال : يا يرفأ انطلق بنا إلاى أخي لنبصرنه ليس عنده سمار ولا مصباح وليس لبابه غلق ، مفترشا بطحاء ، متوسدا بردعة ، عليه كساء رقيق قد أذاقه البرد ، فتسلم عليه فيرد عليك السلام ، وتستأذن فيأذن لك من قبل أن يعلم من أنت ، فانطلقنا حتى إذا قمنا علاى بابه قال : السلام عليكم ، قال : وعليك السلام ، قال : أأدخل ؟ قال : ادخل ، فدفع الباب فإذا ليس له غلق ، فدخلنا إلاى بيت مظلم ، فجعل عمر يلمس حتى وقع عليه ، فجس وساده فإذا بردعة ، وجس فراشه فإذا بطحاء ، وجس دثاره فإذا كساء رقيق ، فقال أبو الدرداء رضي الله عنه : من هاذا ؟ أمير المؤمنين ؟ قال : نعم ، قال : أما والله لقد استبطأتك منذ العام ، قال عمر : رحمك الله ، ألم أوسع عليك ؟ ألم أفعل بك ؟ فقال له أبو الدرداء : أتذكر حديثا حدثناه رسول الله يا عمر ؟ قال : أي حديث ؟ قال : ( ليكن بلاغ أحدكم من الدنيا كزاد الراكب ) ؟ قال : PageV17P097 نعم قال : فماذا فعلنا بعده يا عمر ؟ قال : ما زالا يتجاوبان بالبكاء حتى أصبحا ) . ( اليشكري في اليشكريات ، كر ) . )(@)(@@)(@@)(@@) $ 9307 عن حوشب الفزاري :(@)(@@) | 30 ( أنه سمع أبا الدرداء رضي الله عنه علاى المنبر يخطب ويقول : إني لخائف يوم ينادي ربي عز وجل فيقول : يا عويمر فأقول : لبيك ، فيقول : كيف عملت فيما علمت ؟ فتأتي كل آية في كتاب الله : زاجرة وآمرة ، فتسألني فريضتها ، فتشهد علي الآمرة أني لم أفعل ، وتشهد علي الزاجرة أني لم أنته ، أفأترك ؟ ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9308 عن أبي الدرداء رضي الله عنه قال :(@)(@@) | 30 ( أتيت النبي فإذا جماعة من العرب 
ms5748	 يتفاخرون ، فأذن لي رسول الله فدخلت ، فقال لي : ( يا أبا الدرداء ما هاذا اللجب الذي أسمع ) ؟ قلت : هاذه العرب تفتخر بفناء رسول الله ، فقال : ( يا أبا الدرداء إذا فاخرت ففاخر بقريش ، وإذا كاثرت فكاثر بتميم ، وإذا حاربت فحارب بقيس ، ألا وإن وجوهها كنانة ، ولسانها أسد ، وفرسانها قيس ، يا أبا الدرداء إن لله فرسانا في سمائه يقاتل بهم أعداءه وهم الملائكة ، وفرسانا في أرضه وهم قيس يقاتل بهم أعداءه ، يا أبا الدرداء إن آخر من يقاتل عن الدين حين لا يبقاى إلا ذكره ، ومن القرآن إلا رسمه لرجل من قريش ) قلت : يا رسول الله ممن هو من قريش ؟ قال : ( من سليم ) . ( كر وقال غريب جدا ، ش ) . )(@)(@@)(@@)(@@) $ 9309 عن أبي الدرداء رضي الله عنه :(@)(@@) | 30 ( أن النبي قال : ( إنكم ستجندون أجنادا : جندا بالشام ، وجندا باليمن ، وجندا بالعراق ، وجندا بمصر ) ، قالوا : فخر لنا يا رسول الله قال : ( عليكم بالشام ) ، قالوا : إنا أصحاب ماشية وعهود ولا نطيق الشام ، قال : ( فمن أباى ) وفي لفظ : فمن لم يطق الشام فليلحق بيمنه ، وليسق PageV17P098 بغدره ، فإن الله تعالاى قد تكفل لي بالشام وأهله ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9310 عن أبي الدرداء رضي الله عنه قال :(@)(@@) | 30 ( الشام عقر دار الاسلام ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9311 عن أم الدرداء :(@)(@@) | 30 ( أن أبا الدرداء رضي الله عنه كان إذا رأى الميت قد مات علاى حالة صالحة قال : هنيئا لك ، ليتني مثلك ، فقالت أم الدرداء له : لم تقول ذالك ؟ فقال : هل تعلمين أن الرجل يصبح مؤمنا ويمسي منافقا ؟ قالت : وكيف ؟ قال : يسلب إيمانه ولا يشعر ولأنا بهاذا الموت أغبط مني بهاذا البقاء من الصلاة والصيام ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9312 عن أبي الدرداء رضي الله عنه قال :(@)(@@) | 30 ( كفاى بالموت واعظا ، وكفاى بالدهر مفرقا ، اليوم في الدور وغدا في القبور ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9313 عن أبي الدرداء رضي الله عنه أنه مر بين القبور فقال :(@)(@@) | 30 ( بيوت ما أسكن ظواهرك ، وفي داخلك الدواهي ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9314 عن أبي الدرداء رضي الله عنه قال :(@)(@@) | 30 ( لن تزالوا بخير ما أحببتم خياركم ، وما قيل فيكم 
ms5749	 الحق فعرفتموه ، فإن عارف الحق كفاعله ) . ( هب ، كر ) . )(@)(@@)(@@)(@@) $ 9315 عن محمد بن واسع قال :(@)(@@) | 30 ( كتب أبو الدرداء رضي الله عنه إلاى سلمان : أما بعد يا أخي اغتنم صحتك وفراغك من قبل أن ينزل بك من البلاء ما لا يستطيع أحد من الناس رده ، يا أخي اغتنم دعوة المؤمن المبتلاى ، ويا أخي ليكن المسجد بيتك ، فإني سمعت رسول الله يقول : ( المسجد بيت كل تقي ، وقد ضمن الله عز وجل لمن كانت المساجد بيوتهم بالروح والراحة والجواز علاى الصراط إلاى رضوان الرب ، ويا أخي أدن اليتيم منك ، وامسح رأسه ، والطف به ، PageV17P099 وأطعمه من طعامك ، فإني سمعت رسول الله يقول وجاءه الرجل يشكو إليه قسوة قلبه قال : ( أدن اليتيم منك ، والطف به ، وامسح برأسه وأطعمه من طعامك ، فإن ذالك يلين قلبك ، وتدرك حاجتك ) ، ويا أخي إياك أن تجمع من الدنيا ما لا تؤدي شكره فإني سمعت رسول ؤلله يقول : ( يؤتاى بصاحب المال الذي أطاع الله فيه ، وماله بين يديه ، كلما انكفأ به الصراط ، قال له ماله : امض قد أديت حق الله فيه ؛ ثم يجاء بصاحب المال الذي لم يطع الله فيه ، وماله بين كتفيه ، كلما انكفأ به الصراط ، قال له ماله : ويلك ألا أديت حق الله في فما يزال كذالك حتى يدعو بالويل والثبور ) ؛ ويا أخي إني أنبئت أنك ابتعت خادما ، وإني سمعت رسول الله يقول : ( العبد من الله تعالاى وهو منه ما لم يخدم ، فإذا وقع عليه الحساب ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9316 عن أبي الدرداء رضي الله عنه قال :(@)(@@) | 30 ( إن أخوف ما أخاف إذا وقفت علاى الحساب أن يقال لي : قد علمت ، فماذا عملت فيما علمت ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9317 عن أبي الدرداء رضي الله عنه قال :(@)(@@) | 30 ( ويل للذي لا يعلم مرة وويل للذي يعلم ولا يعمل سبع مرات ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9318 عن حبان بن أبي جبلة : أن أبا ذر وأبا الدرداء رضي الله عنه قالا :(@)(@@) | 30 ( تلدون للموت ، وتعمرون للخراب ، وتحرصون علاى ما يفنى ، وتذرون ما يبقى ، ألا حبذا المكروهات الثلاث : الموت ، والمرض 
ms5750	 ، والفقر ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9319 عن أبي الدرداء رضي الله عنه قال :(@)(@@) | 30 ( لا تزال نفس أحدكم شابة في حب الشيء ولو التقت ترقوتاه من الكبر ، إلا الذين امتحن الله قلوبهم للآخرة وقليل ما هم ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9320 عن أبي الدرداء رضي الله عنه :(@)(@@) | 30 ( لا خير في الحياة إلا لأحد رجلين : PageV17P100 منصت واع ، أو متكلم عالم ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9321 عن أبي الدرداء رضي الله عنه أنه كتب إلاى مسلمة بن مخلد :(@)(@@) | 30 ( أما بعد فإن العبد إذا عمل بطاعة الله أحبه الله ، فإذا أحبه الله حببه إلاى خلقه ، وإذا عمل بمعصية الله أبغضه الله ، وإذا أبغضه الله بغضه إلاى خلقه ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9322 عن أبي الدرداء رضي الله عنه قال :(@)(@@) | 30 ( أوصاني خليلي بثلاث لا أدعهن لشيء : أوصاني بصيام ثلاثة أيام من كل شهر ، ولا أنام إلا علاى وتر ، وتسبيحة الضحاى في الحضر والسفر ) . ( ابن زنجويه ، كر ) . )(@)(@@)(@@)(@@) $ 9323 عن أبي الدرداء رضي الله عنه قال :(@)(@@) | 30 ( قال موساى بن عمران عليه السلام : يا رب من يسكن غدا في حظيرتك ويستظل بظل عرشك يوم لا ظل إلا ظلك ؟ فقال : يا موساى أولائك الذين لا تنظر أعينهم في الزناى ، ولا يبتغون في أموالهم الربا ، ولا يأخذون علاى أحكامهم الرشاى ، طوباى لهم وحسن مآب ) . ( هب ) . )(@)(@@)(@@)(@@) $ 9324 عن أبي الدرداء رضي الله عنه قال :(@)(@@) | 30 ( لا إسلام إلا بطاعة ، ولا خير إلا في جماعة ، والنصح لله تعالاى وللخليفة وللمؤمنين عامة ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9325 عن أبي الدرداء رضي الله عنه قال :(@)(@@) | 30 ( إعمل لله كأنك تراه ، واعدد نفسك مع الموتاى ، وإياك ودعوة المظلوم ، فإنهن يصعدن إلاى الله كأنهن شرارات من نار ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9326 عن أبي سلمة بن عبد الرحمان قال :(@)(@@) | 30 ( جلس رسول الله ذات يوم ، فأخذ عودا يابسا ، فحط ورقه ثم قال : إن قول : ( لا إلاه إلا الله ، والله أكبر ، والحمد لله ، وسبحان الله ، تحط الخطايا ، كما تحط ورق هاذه الشجرة ، خذهن يا PageV17P101 أبا الدرداء قبل أن يحال بينك وبينهن ، فإنهن الباقيات الصالحات وهن من كنوز الجنة ) ، قال أبو 
ms5751	 سلمة : فكان أبو الدرداء إذا ذكر هاذا الحديث قال : لأهللن الله ، ولأكبرن الله ، ولأسبحن الله حتى إذا رآني جاهل حسب أني مجنون ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9327 عن أبي الدرداء رضي الله عنه قال :(@)(@@) | 30 ( بئس العون علاى الدين : قلب نخيب ، وبطن رغيب ، ونعظ شديد ) . ( كر ، ص ) . )(@)(@@)(@@)(@@) $ 9328 عن أبي الدرداء رضي الله عنه قال :(@)(@@) | 30 ( إنما العلم بالتعلم ، والحلم بالتحلم ، ومن يتخير الخير يعطه ، ومن يتق الشر يوقه ، وثلاثة لا ينالون الدرجات العلاى : من تكهن ، أو استقسم ، أو رجع من سفر من طيرة ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9329 عن أبي الدرداء رضي الله عنه قال :(@)(@@) | 30 ( كفاى بك ظالما أن لا تزال مخاصما ، وكفاى بك آثما أن لا تزال مخالفا ، وكفاى بك كاذبا أن لا تزال محدثا في غير ذات الله عز وجل ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9330 عن أبي الدرداء رضي الله عنه قدل :(@)(@@) | 30 ( من كثر كلامه كثر كذبه ، ومن كثر حلفه كثر إثمه ، ومن كثرت خصومته لم يسلم دينه ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9331 عن أبي الدرداء رضي الله عنه قال :(@)(@@) | 30 ( أقبلت مع رسول الله يوما حتى وقف علاى أصحاب اللحم فقال : ( لا تخلطوا ميتا بمذبوح ، والناس قريب عهد بجاهلية ؛ سبعا احفظوهن مني : لا تحتكروا ، ولا تناجشوا ، ولا تلقوا الركبان ، ولا يبيع حاضر لباد ، ولا يبيع رجل علاى بيع أخيه حتى يذر ، ولا يخطب علاى خطبة أخيه ، ولا تسأل المرأة طلاق أختها لتكفيء إناءها ولتنكح فإن لها ما كتب الله تعالاى لها ) . ( كر ، والراوي عن أبي الدرداء لم يسم ، وسائر رجاله ثقات ) . )(@)(@@) PageV17P102(@)(@@)(@@)(@@) $ 9332 عن أبي الدرداء رضي الله عنه قال :(@)(@@) | 30 ( تعلموا العلم قبل أن يرفع ، فإن ذهاب العلم ذهاب العلماء ، لولا ثلاث خصال لصلح أمر الناس : شح مطاع ، وهوى متبع ، وإعجاب المرء بنفسه ؛ من رزق قلبا شاكرا ، ولسانا ذاكرا ، وزوجة مؤمنة ، فنعم الخير أتاه ، ولن يترك من الخير شيئا من يكثر الدعاء عند الرخاء فيستجاب له عند البلاء ، ومن يكثر قرع الباب يفتح له ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9333 عن أبي الدرداء رضي الله عنه قال :(@)(@@) | 30 ( الصحة غناء 
ms5752	 الجسد ) ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9334 عن غضيف بن الحارث قال :(@)(@@) | 30 ( قال أبو الدرداء وذكرت له أبا ذر رضي الله عنه : والله إن كان رسول الله لمدنيه دوننا إذا حضر ، ويتفقده إذا غاب ، ولقد علمت أنه قال : ما تحمل الغبراء ، ولا تظل الخضراء أصدق لهجة من أبي ذر ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 9335 عن أبي الدرداء رضي الله عنه قال :(@)(@@) | 30 ( تضيفهم ضيف ، فأبطأ أبو الدرداء حتى نام الضيف طاويا ، ونام الصبية جياعا ، فجاء والمرأة غضبى تلظى فقالت : لقد شققت علينا منذ الليلة قال : أنا ؟ قالت : نعم ، أبطأت علينا حتى بات ضيفنا طاويا ، وبات صبياننا جياعا ، فغضب فقال : لا جرم والله لا أطعمه الليلة والطعام موضوع بين يديه ، فقالت : أنا والله لا أطعمه حتى تطعمه فاستيقظ الضيف وقال : ما بالكما ؟ فقال : ألا تراى إليها تجنى علي الذنوب إني احتبست في كذا وكذا ، فقال الضيف : أنا والله لا أطعمه حتى تطعماه قال : فلما رأيت الطعام موضوعا ، ورأيت الضيف جائعا ، والصبية جياعا ، قدمت يا رسول الله يدي فأكلت ، وقدموا أيديهم ، فبروا والله يا رسول الله وفجرت قال : بل أنت كنت خيرهم وأبرهم ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9336 عن أبي الدرداء رضي الله عنه قال :(@)(@@) | 30 ( كان رسول الله إذا كان ليلة PageV17P103 ريح شديدة كان مفزعه إلاى المسجد حتى يسكن الريح ، وإذا حدث في السماء حدث من كسوف شمس أو قمر ، كان مفزعه إلاى المصلى حتى ينجلي ) . ( ابن أبي الدنيا ، كر ، وسنده حسن ) . )(@)(@@)(@@)(@@) $ 9337 عن سعيد بن جبير عن أبي الدرداء رضي الله عنه قال :(@)(@@) | 30 ( قام رسول الله فخطب خطبة خفيفة ، فلما فرغ من خطبته قال أبو بكر رضي الله عنه : يا عمر قم فاخطب ، فقام عمر رضي الله عنه فخطب وقصر دون النبي ودون أبي بكر ، فلما فرغ من خطبته قال : يا فلان قم فاخطب فاستوف القول ، قال رسول الله : ( اجلس أو اسكت ) ، شك أبو شهاب قال : العسعس من الشيطان ، والبيان من السحر ثم قال : يا ابن أم عبد قم فاخطب ، فقام ابن أم عبد رضي الله عنه 
ms5753	 فحمد الله تعالاى وأثنى عليه ثم قال : يا أيها الناس إن الله تعالاى ربنا ، والقرآن إمامنا ، وإن البيت قبلتنا ، وإن هاذا نبينا ثم أومأ بيده إلاى النبي فقال رسول الله : أصاب ابن أم عبد وصدق مرتين ، رضيت ما رضي الله تعالاى به لي ولأمتي وابن أم عبد ، وكرهت ما كره الله تعالاى به لي ولأمتي وابن أم عبد ) . ( كر وقال : سعيد بن جبير لم يدرك أبا الدرداء رضي الله عنه ) . )(@)(@@)(@@)(@@) $ 9338 عن أبي الدرداء رضي الله عنه قال :(@)(@@) | 30 ( لاءن يمل أحدكم وضعا حتى ينقطع خيرا له من أن يمل متعيرا ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 9339 عن أبي الدرداء رضي الله عنه قال :(@)(@@) | 30 ( تذاكرنا زيادة العمر عند رسول الله قال : ( ولن يؤخر الله نفسا إذا جاء أجلها ) ولاكن زيادة العمر ، ذرية صالحة يرزقها الله تعالاى العبد ، يدعون له بعد موته فيلحقه دعاؤهم في قبره ، فتلك الزيادة في العمر ) . ( ابن النجار ) . )(@)(@@) PageV17P104(@)(@@)(@@)(@@) $ 9340 عن أبي الدرداء رضي الله عنه قال :(@)(@@) | 30 ( اعبد الله كأنك تراه حتى تلقاه ، وعد نفسك من أصحاب الأجداث ، واتق دعوة المظلوم ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9341 عن أبي الدرداء رضي الله عنه قال :(@)(@@) | 30 ( استعيذوا بالله تعالاى من خشوع النفاق ، قيل : وما خشوع النفاق ؟ قال : أن يراى الجسد خاشعا ، والقلب ليس بخاشع ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9342 عن أبي الدرداء رضي الله عنه قال :(@)(@@) | 30 ( لو نسيت آية لم أجد أحدا يذكرنيها إلا رجلا ببرك الغماد رحلت إليه ) . )(@)(@@)(@@)(@@) $ 9343 عن سالم عن أبي الدرداء رضي الله عنه قال :(@)(@@) | 30 ( سلوني فوالذي نفسي بيده ، لئن فقدتموني لتفقدون رجلا عظيما وفي لفظ : زملا عظيما من أمة محمد ) . ( الروياني ، كر ) . )(@)(@@)(@@)(@@) $ 9344 عن أنس رضي الله عنه قال :(@)(@@) | 30 ( آخاى رسول الله بين أصحابه : آخاى بين سلمان وأبي الدرداء ، وآخاى بين عوف بن مالك والصعب بن جثامة رضي الله عنهم ) . ( ع ، كر ) . )(@)(@@)(@@)(@@) |||| ( مسند 7 أبي السائب خباب رضي الله عنه )(@)(@@)(@@)(@@) $ 9345 عن السائب بن خباب رضي الله عنه قال : $ 30 ( سمعت النبي يقول في مسيره إلاى خيبر لعامر بن 
ms5754	 الأكوع : ( خذ لنا من هناتك ) ، فنزل يرتجز لرسول الله ) . ( طب ، ص ) . وإن الأبيات التي ارتجزها هي :(@)(@@) PageV17P105(@)(@@) والله لولا الله ما اهتدينا %~% ولا تصدقنا ولا صلينا(@)(@@) إنا إذا قوم بغوا علينا %~% وإن أرادوا فتنة أبينا(@)(@@) فأنزلن سكينة علينا %~% وثبت الأقدام إن لاقينا(@)(@@) هذا ما ذكره ابن كثير في البداية والنهاية : ) $(@)(@@)(@@)(@@) $ 9346 عن عبد الله بن السائب قال :(@)(@@) | 30 ( سمعت رسول الله يقول بين الركن والحجر : ( ربنا آتنا في الدنيا حسنة وفي الآخرة حسنة وقنا عذاب النار ) . ( ش ، د ، ن ، ك ، حم ) . )(@)(@@)(@@)(@@) $ 9347 عن السائب خباب رضي الله عنه قال :(@)(@@) | 30 ( سمعت أذناي هاتان ، وأبصرت عيناي هاتان رسول الله وهو آخذ بكفيه جميعا حسنا أو حسينا ، وقدماه علاى قدمي رسول الله وهو يقول : ( حزقة حزقة ، إرق عين بقه ) فيرقاى الغلام حتى يضع قدميه علاى صدر رسول الله ، ثم قال له : ( افتح فاك ) ، ثم قبله ، ثم قال : ( اللهم أحبه فإني أحبه ) . ( طب ، عن أبي هريرة رضي الله عنه ) . )(@)(@@)(@@)(@@) $ 9348 عن حكيم بن حزام رضي الله عنه قال :(@)(@@) | 30 ( سمعنا صوتا من السماء وقع إلاى الأرض كأنه صوت حصاة في طست ، ورماى رسول الله يوم حنين بتلك الحصاة فانهزمنا ) . ( طب ) . )(@)(@@)(@@)(@@) $ 9349 عن خريم بن أوس رضي الله عنه :(@)(@@) | 30 ( سمعت النبي يقول : ( هاذه الحيرة البيضاء قد رفعت لي ، وهاذه الشيماء بنت نفيلة الأزدية علاى بغلة شهباء معتجرة بخمار أسود ) ، فقلت : يا رسول الله وإن نحن دخلنا الحيرة ووجدتها علاى هاذه الصفة فهي لي ؟ قال : هي لك ، ثم ارتد العرب فلم يرتد أحد من طيىء ، وكنا نقاتل قيسا علاى الاسلام وفيهم عيينة بن حصن وكنا نقاتل بني أسد وفيهم طلحة بن خويلد الفقعسي ، ثم سار خالد إلاى مسيلمة فسرنا معه ، فلما فرغنا من مسيلمة PageV17P106 وأصحابه أقبلنا إلاى ناحية البقرة فلقينا هرمز بكاظمة في جمع عظيم ، فبرز له خالد بن الوليد ، ودعا إلاى البراز ، فبرز له هرمز ، فقتله خالد رضي الله عنه وكتب بذالك إلاى أبي بكر رضي الله عنه فنفله سلبه ، ثم سرنا علاى طريق 
ms5755	 الطف ، حتى دخلنا الحيرة ، فكان أول من تلقانا فيها شيماء بنت نفيلة الأزدية علاى بغلة لها شهباء بخمار أسود ، كما قال رسول الله ، فتعلقت بها وقلت : هاذه وهبها لي رسول الله فدعاني خالد عليها البينة ، فأتيته بها ، فسلمها إلي ) . ( طب ، عن خريم بن أوس ) . )(@)(@@)(@@)(@@) $ 9350 عن السائب بن خباب رضي الله عنه قال :(@)(@@) | 30 ( سمعت النبي يقول لعثمان بن طلحة حين دفع إليه مفتاح الكعبة : ها ، ثم غيبه ، قال : فلذالك تغيب المفتاح ) . ( طب ) . )(@)(@@)(@@)(@@) $ 9351 عن عبد الله بن السائب بن خباب عن أبيه عن جده قال :(@)(@@) | 30 ( رأيت النبي يأكل ثريدا متكئا علاى سرير ثم يشرب من فخارة ) . ( أبو نعيم وقال : هو وهم ، والصواب : ابن عبد الله بن السائب عن أبيه عن جده ) . )(@)(@@)(@@)(@@) $ 9352 عن أبي السائب خباب رضي الله عنه قال :(@)(@@) | 30 ( سمعت النبي يقول عند فراغه من طعامه : اللهم لك الحمد ، أطعمت وأسقيت ، وأشبعت وأرويت ، لك الحمد غير مكفور ولا مودع ولا مستغنى عنك ربنا ) . ( طب ، عن الحارث بن الحارث العامدي ) . )(@)(@@)(@@)(@@) $ 9353 عن أبي السائب خباب رضي الله عنه قال :(@)(@@) | 30 ( سمعت رسول الله وهو واقف بعرفة في حجة الوداع ، وأتاى أعرابي فأخذ بطرف ردائه وسأله إياه فأعطاه ، فذهب به ، فعند ذالك حرمت المسألة ، قال رسول الله : ( لا تحل الصدقة لغني ولا لذي مرة سوي إلا في فقر مدقع ، أو غرم مقطع ) ، وقال : ( من PageV17P107 سأل الناس ليثري ماله كان خموشا في وجهه ورضفا يأكله من جهنم ، فمن شاء فليقل ، ومن شاء فليكثر ) . ( طب ، عن حبشي ابن جنادة ) . )(@)(@@)(@@)(@@) $ 9354 عن أبي السائب خباب رضي الله عنه قال :(@)(@@) | 30 ( سمعت النبي يقول في تلبيته : لبيك بحجة وعمرة معا ) . ( طب ، عن أبي طلحة ) . )(@)(@@)(@@)(@@) |||| ( مسند 8 أبي الطفيل رضي الله عنه(@)(@@)(@@)(@@) $ 9355 عن أبي الطفيل رضي الله عنه قال :(@)(@@) | 30 ( كنت في الجيش الذي بعثهم علي بن أبي طالب رضي الله عنه إلى بني ناجية ، فانتهينا إليهم فوجدناهم علاى ثلاث فرق ، فقال الأمير لفرقة منهم : ما أنتم ؟ قالوا : نحن قوم كنا نصاراى 
ms5756	 فأسلمنا ، فثبتنا علاى إسلامنا ، وقال للثانية : ما أنتم ؟ قالوا نحن قوم كنا نصاراى فثبتنا علاى نصرانيتنا ، وقال للثالثة : ما أنتم ؟ قالوا : نحن قوم كنا نصاراى فأسلمنا ، فرجعنا إلاى نصرانيتنا ، فلم نرد دينا أفضل من ديننا ، فقال لهم : أسلموا ، فأبوا ، فقال لأصحابه : إذا مسحت رأسي ثلاث مرات فشدوا عليهم ، ففعلوا ، فقتلوا المقاتلة ، وسبوا الذرية ، فجيء بالذراري إلاى علي رضي الله عنه وجاء مسقلة بن هبيرة فاشتراهم بمائتي ألف ، فجاء بمائة ألف إلاى علي فأباى علي أن يقبل ، فانطلق مسقلة بدراهمه ، وعمد مسقلة إليهم فأعتقهم ، ولحق بمعاوية ، فقيل لعلي : ألا تأخذ الذرية فقال : لا ، فلم يعرض لهم ) . ( ق ) . )(@)(@@)(@@)(@@) $ 9356 عن أبي الطفيل رضي الله عنه :(@)(@@) | 30 ( أن أبا بكر رضي الله عنه سئل عن ميتة البحر ؟ فقال : هو الطهور ماؤه ، الحل ميتته ) . ( قط في العلل وصححه أبو الشيخ وابن مردويه ق ) . )(@)(@@)(@@)(@@) $ 9357 عن أبي الطفيل رضي الله عنه :(@)(@@) | 30 ( أن ابن الكواء سأل عليا رضي الله PageV17P108 عنه : من الذين بدلوا نعمة الله كفرا ؟ قال : هم الفجار من قريش ، كفيتهم يوم بدر ، قال : فمن الذين ضل سعيهم في الحياة الدنيا ؟ قال : منهم أهل حروراء ) . ( عب الفريابي ، ن ، وابن جرير وابن أبي حاتم وابن مردويه ، ك ، ق في الدلائل ) . )(@)(@@)(@@)(@@) $ 9358 عن أبي الطفيل رضي الله عنه قال :(@)(@@) | 30 ( رأيت النبي وأنا غلام شاب يطوف بالبيت علاى راحلته يستلم الحجر بمحجنه ) . ( حم ، ع ، عن ابن سعد ) . )(@)(@@)(@@)(@@) $ 9359 عن قتادة عن أبي الطفيل رضي الله عنه قال :(@)(@@) | 30 ( سألت النبي عن حديث وهو يطوف بالكعبة ، فقال : إن لكل مقام مقالا ، إن هاذا ليس موضع مقال ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9360 عن أبي الطفيل رضي الله عنه :(@)(@@) | 30 ( أن ابن الكواء سأل علي بن أبي طالب رضي الله عنه عن ذي القرنين : أنبيا كان أم ملكا ؟ قال : لم يكن نبيا ولا ملكا ، ولاكن كان عبدا صالحا ، أحب الله فأحبه ، ونصح لله فنصحه ، بعثه الله إلاى قومه فضربوه علاى قرنه الآخر ، فمات ، فأحياه الله لجهادهم ، ثم بعثه إلاى قومه فضربوه علاى 
ms5757	 قرنه الآخر ، فمات ، فأحياه الله لجهادهم ، فلذالك سمي ذا القرنين ، وإن فيكم مثله ) . ( ابن عبد الحكم في فتوح مصر وابن أبي عاصم في السنة ، وابن الأنباري في المصاحف ، وابن مردويه ، وابن المنذر وابن أبي عاصم ) . )(@)(@@)(@@)(@@) $ 9361 عن أبي الطفيل رضي الله عنه :(@)(@@) | 30 ( أن رسول الله قرأ : ( فمن اتبع الهداى ) . ( خط في المتفق والمفترق ) . )(@)(@@)(@@)(@@) $ 9362 عن أبي الطفيل رضي الله عنه قال :(@)(@@) | 30 ( لكل مقام مقال ، ولكل زمان رجال ) . ( عد ، كر ) . )(@)(@@) PageV17P109(@)(@@)(@@)(@@) $ 9363 عن أبي الطفيل عامر بن واثلة رضي الله عنه قال :(@)(@@) | 30 ( شهدت علي بن أبي طالب رضي الله عنه يخطب ، فقال في خطبته : سلوني ، فوالله لا تسألوني عن شيء يكون إلاى يوم القيامة إلا حدثتكم به ، سلوني عن كتاب الله ، فوالله ما من آية إلا أنا أعلم : أبليل نزلت أم بنهار ، أم في سهل نزلت أم في جبل ؟ فقام إليه ابن الكواء فقال : يا أمير المؤمنين ما الذاريات ذروا ؟ فقال له : ويلك سل تفقها ، ولا تسأل تعنتا ، والذاريات ذروا : الرياح ، فالحاملات وقرا : السحاب ، فالجاريات يسرا : السفن ، فالمقسمات أمرا : الملائكة ، فقال : فما السواد الذي في القمر ؟ فقال : أعماى يسأل عن عمياء ، قال الله تعالاى : { وجعلنا الليل والنهار آيتين فمحونا آية الليل وجعلنا آية النهار مبصرة } فمحو آية الليل السواد الذي في القمر ، قال : فما كان ذو القرنين : أنبيا أم ملكا ؟ فقال : لم يكن واحدا منهما ، كان عبد الله أحب الله فأحبه الله ، وناصح الله فنصحه الله ، بعثه الله إلاى قومه يدعوهم إلاى الهداى فضربوه علاى قرنه الأيمن ، ثم مكث ما شاء الله ، ثم بعثه الله إلاى قومه يدعوهم إلاى الهدى فضربوه علاى قرنه الأيسر ، ولم يكن له قرنان كقرني الثور ، قال : فما هاذه القوس ؟ قال : هي علامة كانت بين نوح وبين ربه ، وهي أمان من الغرق ، قال : فما البيت المعمور ؟ قال : البيت فوق سبع سماوات تحت العرش ، يقال له : الصراح ، يدخله كل يوم سبعون ألف ملك ، ثم لا يعودون إليه إلاى يوم القيامة ، قال : فمن الذين بدلوا نعمة الله 
ms5758	 كفرا ؟ قال : هم الأفجران من قريش قد كفيتموهم يوم بدر ، قال : فمن الذين ضل سعيهم في الحياة الدنيا وهم يحسبون أنهم يحسنون صنعا ؟ قال : قد كان أهل حروراء منهم ) . ( ابن الأنباري في المصاحف وابن عبد البر في العلم ) . )(@)(@@)(@@)(@@) $ 9364 عن أبي الطفيل عامر بن واثلة عن حذيفة بن أسيد الغفاري رضي الله PageV17P110 عنه قال :(@)(@@) | 30 ( لما صدر رسول الله من حجة الوداع نهاى أصحابه عن شجرات بالبطحاء متقاربات أن ينزلوا تحتهن ، ثم بعث إليهن فقم ما تحتهن من الشوك ، وشذبن عن رؤس القوم ، ثم عمد إليهن فصلى تحتهن ، ثم قام فقال : ( أيها الناس إنه قد نبأني اللطيف الخبير أنه لم يعمر نبي إلا مثل نصف عمر النبي الذي من قبله ، وإني لأظن أني موشك أن أدعاى فأجيب ، وأني مسؤول وأنكم مسؤولون ، فماذا أنتم قائلون ) ؟ قالوا : نشهد أنك قد بلغت ونصحت ، فجزاك الله خيرا قال : ( ألستم تشهدون أن لا إلاه إلا الله وأن محمدا عبده ورسوله ، وأن جنته حق وناره حق ، وأن الموت حق ، وأن الساعة آتية لا ريب فيها وأن الله يبعث من في القبور ) ، قالوا : نشهد بذالك ، قال : ( اللهم اشهد ) ، ثم قال : ( أيها الناس إن الله مولاي وأنا مولى المؤمنين ، وأنا أولاى بالمؤمنين من أنفسهم ، فمن كنت مولاه فعلي مولاه ، اللهم وال من والاه وعاد من عاداه ) ، ثم قال : ( أيها الناس إني فرطكم وأنتم واردون علاى الحوض ، حوض عرضه ما بين بصراى وصنعاء ، فيه عدد النجوم قدحان من فضة ، وإني سائلكم حين تردون علي عن الثقلين فانظروا كيف تخلفوني فيهما : الثقل الأكبر ، كتاب الله سبب طرفه بيد الله وطرف بأيديكم ، فتمسكوا به لا تضلوا ولا تبدلوا ، وعترتي أهل بيتي ، وإنه قد نبأني اللطيف الخبير أنهما لن يفترقا حتى يردا علي الحوض ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 9365 عن أبي الطفيل رضي الله عنه قال :(@)(@@) | 30 ( دخلت مع علي والحسن والحسين وابن الحنفية رضي الله عنهم الكعبة فلم يصلوا فيها ) . )(@)(@@)(@@)(@@) $ 9366 عن أبي الطفيل رضي الله عنه :(@)(@@) | 30 ( أن أمرأة أصابها جوع فأتت 
ms5759	 راعيا ، فسألته الطعام ، فأباى عليها حتى تعطيه نفسها ، قالت : فحثا لي ثلاث حثيات من تمر PageV17P111 ثم أصابني ، وذكرت أنها كانت أجهدت من الجوع ، فأخبرت عمر رضي الله عنه فكبر وقال : مهر مهر ، كل حفنة مهر ودرأ عنها الحد ) . ( عب ) . )(@)(@@)(@@)(@@) $ 9367 عن أبي الطفيل رضي الله عنه قال :(@)(@@) | 30 ( جاءت فاطمة إلاى أبي بكر الصديق رضي الله عنه فقالت : يا خليفة رسول الله أنت ورثت رسول الله أم أهله ؟ قال : لا بل أهله ، قالت : فما بال الخمس ؟ فقال : إني سمعت رسول الله يقول : ( إذا أطعم الله نبيا طعمة ، ثم قبضه ، كانت للذي يلي بعده ، فلما وليت رأيت أن أرده علاى المسلمين ، قالت : فأنت وما سمعت من رسول الله أعلم ، ثم رجعت ) . ( حم ، م ، د ، وابن جرير ، هق ) . )(@)(@@)(@@)(@@) $ 9368 عن أبي الطفيل رضي الله عنه قال :(@)(@@) | 30 ( سمعت عليا رضي الله عنه يقول : لا أغسل رأسي بغسل حتى آتي البصرة فأحرقها ، ثم أسوق الناس بعصاي إلاى مصر ، فأتيت أبا مسعود فأخبرته ، فقال : إن عليا يورد الأمور مواردها ، ولا يحسنون يصدرونها ، علي لا يغسل رأسه بغسل ، ولا يأتي البصرة ولا يحرقها ، ولا يسوق الناس بعصاه إلاى مصر ، علي رجل أصلع رأسه مثل الطست ، إنما حوله زغيبات ) . ( خط ) . )(@)(@@)(@@)(@@) $ 9369 عن أبي الطفيل رضي الله عنه قال :(@)(@@) | 30 ( انطلق النبي في نفر منهم عبد الله بن مسعود فأتاى دارا ) . ( خ في تاريخه ، كر ) . )(@)(@@)(@@)(@@) $ 9370 عن أبي الطفيل رضي الله عنه :(@)(@@) | 30 ( دخلت يوما علاى رسول الله وعندهم قدر تفور لحما ، فأعجبتني شحمة فأخذتها فازدردتها ، فاشتكيت عليها سنة ، ثم إني ذكرتها لرسول الله فقال : ( إنه كان فيها نفس سبعة أناس ) ، ثم مسح بطني ، فألقيتها خضراء ، فوالذي بعثه بالحق ما اشتكيت بطني حتى الساعة ) . ( طب ، عن رافع بن خديج ) . )(@)(@@) PageV17P112(@)(@@)(@@)(@@) $ 9371 عن أبي الطفيل رضي الله عنه :(@)(@@) | 30 ( أن رجلا ولد له علاى عهد النبي غلام ، فدعا له وأخذ ببشرة جبهته فقال بها هاكذا وغمز جبهته ودعا له بالبركة ، قال : فنبتت شعرة في جبهته كأنها هلبة فرس ، فشب 
ms5760	 الغلام ، فلما كان زمن الخوارج أحبهم ، فسقطت الشعرة عن جبهته ، فأخذه أبوه فقيده مخافة أن يلحق بهم ، قال : فدخلنا عليه فوعظناه وقلنا له فيما نقول : ألم تر أن بركة دعوة النبي قد وقعت من جبهتك ، فما زلنا به حتى رجع عن رأيهم ، قال : فرد الله إليه الشعرة بعد في جبهته وتاب وأصلح ) . ( ش ) . )(@)(@@)(@@)(@@) $ 9372 عن أبي الطفيل رضي الله عنه قال :(@)(@@) | 30 ( لما بني البيت كان الناس ينقلون الحجارة والنبي ينقل معهم ، فأخذ الثوب فوضعه علاى عاتقه ، فنودي : لا تكشف عورتك ، فألقاى الحجر ولبس ثوبه ) . ( عب ) . )(@)(@@)(@@)(@@) $ 9373 عن أبي الطفيل رضي الله عنه قال :(@)(@@) | 30 ( كنت غلاما أحمل عضو البعير ، ورأيت رسول الله يقسم لحما بالجعرانة ، فأقبلت امرأة بدوية ، فلما دنت من النبي بسط لها رداءه فجلست عليه ، فسألت : من هاذه ؟ فقالوا : أمه التي أرضعته ) . ( ع ، كر ) . )(@)(@@)(@@)(@@) $ 9374 عن مهدي بن عمران الحنفي قال :(@)(@@) | 30 ( سمعت أبا الطفيل رضي الله عنه يقول : كنت يوم بدر غلاما قد شددت علي الازار ، وأنقل اللحم من الجبل إلاى السهل ) . ( يعقوب بن سفيان ، كر وقال : هاذا أيضا وهم ) . )(@)(@@)(@@)(@@) $ 9375 عن أبي الطفيل رضي الله عنه قال :(@)(@@) | 30 ( رأيت النبي وأنا غلام فهي إزار ) . ( خ في تاريخه ، كر ) . )(@)(@@)(@@)(@@) $ ( 9376 ) عن أبي الطفيل ، عن رجل من أصحاب النبي & قال : ' يخرج الدجال على حمار ، رجس على رجس ' . ( ش ) . PageV17P113(@)(@@)(@@)(@@) $ 9377 أنبأنا عمرو بن عاصم ، حدثنا حماد بن سلمة ، عن علي بن زيد ، عن أبي الطفيل رضي الله عنه قال :(@)(@@) | 30 ( كنت أطلب النبي فيمن يطلبه ليلة الغار ، فقمت علاى باب الغار وما أدري فيه أحد أم لا ) . ( كر ، قال ابن سعد : هاذا الحديث غلط ، أبو الطفيل لم يولد تلك الليلة ، وينبغي أن يكون حدث بالحديث عن غيره ، فأوهم الذي حمله عنه ) . )(@)(@@)(@@)(@@) $ 9378 عن عبد الله بن الوليد بن جميع ، عن ابن الطفيل رضي الله عنه قال :(@)(@@) | 30 ( أدركت من حياة رسول الله ثماني سنين ولدت عام أحد ) . ( البغوي وابن منده ( كر ) . )(@)(@@)(@@)(@@) |||| ( 9 أبي العالية رضي الله عنه )(@)(@@)(@@)(@@) $ 9379 