ms1281	 أنك صنوه من آدم % % وشريكه في صورة الإنسان % % 4(@)(@@) % وعساه أيضا من أبيك لأمه % % فيها تصيب فياشل الشبان % % PageV01P4857 البحر : - 1(@)(@@) % قالوا هجاك أبو حفص فقلت لهم % % أخي وخلي وندماني وصفعاني % % 2(@)(@@) % عرضي له الدهر يهجوني وأصفعه % وإن أبى زدته أعراض إخواني % % PageV01P4858 البحر : - 1(@)(@@) % للحريثي نكهة % تترك البيت منتنا % % 2(@)(@@) % تصرع الفارس الشجا % % ع إذا كر أو ونى % % 3(@)(@@) % إنما تحسن في كني % % ف إذا كان عندنا % % PageV01P4859 البحر : - 1(@)(@@) % إبليس إن كنت من المنظرين % وكنت لا تهلك في الهالكين % 2(@)(@@) % هذا أبو حسان سيف الردى % % كلمه إن كنت من الصادقين % % 3(@)(@@) % غير أن بردها يطيب وما أن % % فيك طيب بك فيك داء دفين % 3(@)(@@) % لك في هنك خصلتان من الجن % نة برد كبردهاوصحون % % 3(@)(@@) % لا ترومي بنيكك ذلك شيء % لم يكن مثله وليس يكون % 3(@)(@@) % ليس لي دين يونس فأرجي % % نجوة بعد أن تفيء النون % % 3(@)(@@) % أنا من أفحل البرية إلا % % أنني عنك مخفر عنين % % 3(@)(@@) % خفيف قل لمن عنك أخرتها المنون % ليس يجري في بحركم لي سفين % 3(@)(@@) % ويشفي غليل استه بالمني % ورب شفاء بماء مهين % % 3(@)(@@) % يقلقل أحشاءه باركا % بعرد طويل غليظ متين % % PageV01P4860 3(@)(@@) % وشيخ يبيت غلام له % % ينعمه بنعيم مهين % 3(@)(@@) % والله لو راجعته لفظة % ما رمت أو يقطع منك الوتين % % PageV01P4861 البحر : - 1(@)(@@) % مهما يكن للقيان زينا % فصبوة عودة القيان % 2(@)(@@) % تبكي لوقت انصراف بيض % يحسن في الضرب والأغاني % % 3(@)(@@) % فإن تغنت لنا وددنا % % لو هي قامت عن المكان % 4(@)(@@) % قلت لها والكلام شيء % يبدو لمستخرج المعاني % % 5(@)(@@) % ليست من النار فيك شيء % لكن من الخلد خلتان % % PageV01P4862 البحر : - 1(@)(@@) % أنتما عندي يا بني رمضان % يشهد الرحمن ذاكم أحمقان % 2(@)(@@) % يابني القرفة والتربذ والجن % د بيد ستر والشب اليماني % % PageV01P4863 البحر : - 1(@)(@@) % رأيت الناس أكرمهم عليه % ذوو الأجسام والصور الحسان % 2(@)(@@) % يروعهم الطرير إذا رأوه % كأنهم نساؤهم الزواني % % PageV01P4864 البحر : - 1(@)(@@) % كفي ملامك قد ملكت عناني % % وحفظت فيك نصيحة الندمان % 2(@)(@@) % أأغيب عنك فتنعمين برقدة % لا خير بعدك في حبيب ثاني 
ms1282	 % % 3(@)(@@) % هلا وفيت بما وعدت كما وفى % % لك من وطئت به على الإحسان % % 4(@)(@@) % إن كان صافح للكرى لي ناظرا % طيف فلا عمرت به أجفاني % % 5(@)(@@) % حسبي من العيش الذي خولته % % في ظل وصلكم وطيب زماني % % 6(@)(@@) % شربي الكؤوس على منادمة الصبى % % وغناء من إن شئته غناني % % 7(@)(@@) % لمن الديار ببرقة الروحان إذ % لا نبيع زماننا بزمان % % PageV01P4865 البحر : - 1(@)(@@) % قل يا أبا حسن لا زلت في منن % يا ماليء القلب والأذنين إحسانا % % 2(@)(@@) % تدير صوتا لنا ما زال مقترحا % أبقى بقلبي أطرابا وأشجانا % % 3(@)(@@) % يا حبذا جبل الريان من جبل % وحبذا ساكن الريان من كانا % % 4(@)(@@) % ولن تراني إلا حاملا قدحا % وشاربا وعليه منه سكرانا % % PageV01P4866 البحر : - 1(@)(@@) % شمس مكونة في خلق جارية % باتت تدير بعيد الدنح قربانا % % 2(@)(@@) % أبصرتها بين أتراب هززن على % % عقد الزنابير بالكثبان أغصانا % % 3(@)(@@) % يحملن وهي تهادى بينهم حذرا % للعين من فاخر الياقوت صلبانا % % 4(@)(@@) % لو يستطعن من الإشفاق إذ برزت % للمشي أوطأتها منهن أجفانا % % 5(@)(@@) % كيف الطريق إلى الطير المشوم وقد % % أذاقنا تعبا منه وعنانا % % 6(@)(@@) % فقلت لا علم لي فاستضحكت شجنا % وضمن القلب منها في أشجانا % % 7(@)(@@) % فيا لهن بدورا لا شبيه لها % % وأوجها أشرقت حسنا وألوانا % % 8(@)(@@) % ويا لها نظرة نلت النعيم بها % % والحب فالتذت العينان من كانا % % PageV01P4867 البحر : - 1(@)(@@) % لم يبق لي صبر ولكنما % % أبقى بقلبي البين أشجانا % % 2(@)(@@) % أبدلتني بعدا بقرب الذي % % قد كان من حزني سلوانا % % 3(@)(@@) % وكان لي أنسا لدى وحشتي % % وكان لي روحا وريحانا % % 4(@)(@@) % يا بدر ما أسرع ما رابني % % في وصلك الدهر وما خانا % % 5(@)(@@) % غبت فغاب النوم عن ناظري % % وسامني طيفك هجرانا % % 6(@)(@@) % كانت بك الدنيا لنا جنة % فنغصت لذة دنيانا % % PageV01P4868 البحر : - 1(@)(@@) % مسقم عن سقم جفن % ضاحك عن حب مزن % 2(@)(@@) % مطلع من جيبه شم % سا بدت في يوم دجن % % 3(@)(@@) % لائث مئزره فو % ق كثيب تحت غصن % % 4(@)(@@) % رشأ قد جاوز الحس % ن به حد التمني % % 5(@)(@@) % آدمي غير أن ال % خلق في 
ms1283	 صورة جني % % 6(@)(@@) % مؤنسي في كل حال % مسعدي في كل فن % 7(@)(@@) % ملكت كفاي منه % % مثل ما ملك مني % % 8(@)(@@) % لست عنه صابرا يو % % ما ولا يصبر عني % % PageV01P4869 البحر : - 1(@)(@@) % ولما رأيت البين قد جد جده % % وقد قرنت للبين عشر سفائن % 2(@)(@@) % أماطت رداء الخز عن حر وجهها % % ولم تخش من داياتها والحواضن % PageV01P4870 البحر : - 1(@)(@@) % م ولع الزمان بأن يحرك ساكنا % وبأن يثير من الأوابد كامنا % % 2(@)(@@) % وهم الأحبة من أقام ترحلوا % % عنه فكلهم يودع ظاعنا % % 3(@)(@@) % أضحى الزمان مدائنا لك فيهم % ولعل رشدا إن قضيت مدائناص ولع الزمان بأن يحرك ساكنا % 4(@)(@@) % وبأن يثير من الأوابد كامنا % % وهم الأحبة من أقام ترحلوا % % 5(@)(@@) % عنه فكلهم يودع ظاعنا % % أضحى الزمان مدائنا لك فيهم % 6(@)(@@) % ولعل رشدا إن قضيت مدائنا % % فأرى الليالي ما نقضن معاهدا % 7(@)(@@) % فيما أتين ولا هجمن مآمنا % % رحلن إلفك عن مساكن قلعة % 8(@)(@@) % كانت لقوم آخرين مساكنا % % فاقن الحياء أبا الحسين فلم يكن % % 9(@)(@@) % شيء فري لم تخله كائنا % % كان الذي قد كنت توقن أنه % % 10(@)(@@) % سيكون فاجزع واقنا لا واهنا % % هون عليك المقطعات ولا تكن % % PageV01P4871 11(@)(@@) % بنصيحة من مخلص متهاونا % % إن الحوادث قد عدون فواجعا % 12(@)(@@) % فاشدد إزارك لا يكن فواتنا % % لا تنكرن من المصائب منا أتى % % 13(@)(@@) % حتى كأنك كنت منها آمنا % % أنكره إنكار امرىء عرف الردى % % 14(@)(@@) % ورأى النفوس بأن يمتن رهائنا % % إني نكرت على الليالي أن أتت % 15(@)(@@) % ما قد أتته لم يكن ظنائنا % % هل كنت غرا بالنوائب قبلها % % 16(@)(@@) % أم خلتهن لما تحب ضوامنا % % بل كنت فيما قد لقيت مفكرا % % 17(@)(@@) % حتى كأنك كنت ثم معاينا % % فعلام تنفر نفرة وحشية % 18(@)(@@) % وتعد دهرك غائلا لك خائنا % % ماخان دهر مؤذن بصروفه % 19(@)(@@) % ما انفك يرسل بالمواعظ آذنا % % طامن حشاك أخا البقاء لدائه % 20(@)(@@) % فلتزجرن أشائما وأيامنا % % داء البقاء الرفء إما عاجلا % PageV01P4872 21(@)(@@) % لا زلت توفاه وإما آينا % % من عاش أثكله الزمان خليله % 22(@)(@@) % وسقاه بعد الصفو رنقا آجنا % % وكذا شرب العيش فيه تلون 
ms1284	 % 23(@)(@@) % بيناه عذب إذ تحول آسنا % % والمرء ماعدت الحوادث نفسه % 24(@)(@@) % يلقي الزمان محاربا ومهادنا % % دار الزمان بليله ونهاره % 25(@)(@@) % فأدار أرحاء المنون طواحنا % % فتأمل الدنيا ولاتعجب لها % % 26(@)(@@) % واعجب لمن أضحى إليها راكنا % % قضى أبو العباس خلك نحبه % 27(@)(@@) % فجعلت نحبك دمعك المتهاتنا % % وودت أنك منه أول لاحق % % 28(@)(@@) % أوكنت مضمونا إليه مقارنا % % لكن أبى ذاك الإله فلا ترد % 29(@)(@@) % مالم يرد لقضائه وارض العزاء مخادنا % % لاتسجنن الهم عندك إنه % % 30(@)(@@) % مازال مسجونا يعذب ساجنا % % واصبر كما أمر المليك فإنما % % PageV01P4873 31(@)(@@) % يهدي المدين إذا أطاع الدائنا % % والله يمنحك الخلود مجاورا % 32(@)(@@) % أخيك في جناته ومساكنا % % من بعد أن تحيا حياة ممتع % % 33(@)(@@) % لا كالمشيع علو بين ظعائنا % % مامات خلك يوم زار ضريحه % % 34(@)(@@) % بل يوم زار قوابلا وحواضنا % % بل منذ أودع من أبيه وأمه % 35(@)(@@) % مستودعيه فكن لذلك فاطنا % % بل قد يمت دون الألى فوق الثرى % % 36(@)(@@) % نطق البيان مكاتبا وملاسنا % % مازال خلك ميتا ولميت % 37(@)(@@) % في الميتين مصاهرا ومخاتنا % % مات الخلائق مذ نعاهم ربهم % % 38(@)(@@) % بل مذ رأت عين قرينا بائنا % % أفللتقدم والتأخر يمتري % % 39(@)(@@) % عينيك أسراب الدموع هواتنا % % ساق الخليل إلى الخليل فناؤه % % 40(@)(@@) % ليكون مدفونا له أو دافنا % % ولربما اختطفا جميعا خطفة % PageV01P4874 41(@)(@@) % والدهر أخطف ماتراه محاجنا % % ولما جلوت صفاح قلبك واعظا % % 42(@)(@@) % إني رأيت عليه رينا رائنا % % لكنه التذكير يهديه الفتى % % 43(@)(@@) % لأخيه حين يرى أساه راحنا % % ولئن عبأت لك الأسى لعلى امرئ % 44(@)(@@) % أمسى الحزين عليه لا المتحازنا % % ولئن أمرتك بالتجلد ظاهرا % 45(@)(@@) % لقد امتلأت عليه شجوا باطنا % % ولقد أقول غداة قام نعيه % % 46(@)(@@) % هيجت لي شجنا لعمرك شاجنا % % صفن الجواد وقد يطول جراؤه % % 47(@)(@@) % ولتسمعن بكل جار صافنا % % وطوى العتيق جناحه في وكنه % % 48(@)(@@) % وقصار ذي الطيران يلقى واكنا % % والحي يرتع ثم يسرع برهة % 49(@)(@@) % فإذا قضى أربيه أمسى عاطنا % % مات الذي نال العلا متناولا % % 50(@)(@@) % من بعد مانال العلا متطامنا % % مات الذي كان النصيح مساترا % PageV01P4875 51(@)(@@) % مات الذي كان النصير معالنا % % مات 
ms1285	 الذي فتح الفتوح ملاينا % 52(@)(@@) % لاعاجزا عن فتحهن مخاشنان ولع الزمان بأن يحرك ساكنا % وبأن يثير من الأوابد كامنا % % 53(@)(@@) % وهم الأحبة من أقام ترحلوا % % عنه فكلهم يودع ظاعنا % % 54(@)(@@) % أضحى الزمان مدائنا لك فيهم % ولعل رشدا إن قضيت مدائنا % % 55(@)(@@) % فأرى الليالي ما نقضن معاهدا % فيما أتين ولا هجمن مآمنا % % 56(@)(@@) % رحلن إلفك عن مساكن قلعة % كانت لقوم آخرين مساكنا % % 57(@)(@@) % فاقن الحياء أبا الحسين فلم يكن % % شيء فري لم تخله كائنا % % 58(@)(@@) % كان الذي قد كنت توقن أنه % % سيكون فاجزع واقنا لا واهنا % % 59(@)(@@) % هون عليك المقطعات ولا تكن % % بنصيحة من مخلص متهاونا % % 60(@)(@@) % إن الحوادث قد عدون فواجعا % فاشدد إزارك لا يكن فواتنا % % PageV01P4876 61(@)(@@) % لا تنكرن من المصائب منا أتى % % حتى كأنك كنت منها آمنا % % 62(@)(@@) % أنكره إنكار امرىء عرف الردى % % ورأى النفوس بأن يمتن رهائنا % % 63(@)(@@) % إني نكرت على الليالي أن أتت % ما قد أتته لم يكن ظنائنا % % 64(@)(@@) % هل كنت غرا بالنوائب قبلها % % أم خلتهن لما تحب ضوامنا % % 65(@)(@@) % بل كنت فيما قد لقيت مفكرا % % حتى كأنك كنت ثم معاينا % % 66(@)(@@) % فعلام تنفر نفرة وحشية % وتعد دهرك غائلا لك خائنا % % 67(@)(@@) % ماخان دهر مؤذن بصروفه % ما انفك يرسل بالمواعظ آذنا % % 68(@)(@@) % طامن حشاك أخا البقاء لدائه % فلتزجرن أشائما وأيامنا % % 69(@)(@@) % داء البقاء الرفء إما عاجلا % لا زلت توفاه وإما آينا % % 70(@)(@@) % من عاش أثكله الزمان خليله % وسقاه بعد الصفو رنقا آجنا % % PageV01P4877 71(@)(@@) % وكذا شرب العيش فيه تلون % بيناه عذب إذ تحول آسنا % % 72(@)(@@) % والمرء ماعدت الحوادث نفسه % يلقي الزمان محاربا ومهادنا % % 73(@)(@@) % دار الزمان بليله ونهاره % فأدار أرحاء المنون طواحنا % % 74(@)(@@) % فتأمل الدنيا ولاتعجب لها % % واعجب لمن أضحى إليها راكنا % % 75(@)(@@) % قضى أبو العباس خلك نحبه % فجعلت نحبك دمعك المتهاتنا % % 76(@)(@@) % وودت أنك منه أول لاحق % % أوكنت مضمونا إليه مقارنا % % 77(@)(@@) % لكن أبى ذاك الإله فلا ترد % مالم يرد لقضائه وارض العزاء مخادنا % % 78(@)(@@) % لاتسجنن الهم عندك إنه % % مازال مسجونا يعذب ساجنا % % 79(@)(@@) % واصبر كما 
ms1286	 أمر المليك فإنما % % يهدي المدين إذا أطاع الدائنا % % 80(@)(@@) % والله يمنحك الخلود مجاورا % أخيك في جناته ومساكنا % % PageV01P4878 81(@)(@@) % من بعد أن تحيا حياة ممتع % % لا كالمشيع علو بين ظعائنا % % 82(@)(@@) % مامات خلك يوم زار ضريحه % % بل يوم زار قوابلا وحواضنا % % 83(@)(@@) % بل منذ أودع من أبيه وأمه % مستودعيه فكن لذلك فاطنا % % 84(@)(@@) % بل قد يمت دون الألى فوق الثرى % % نطق البيان مكاتبا وملاسنا % % 85(@)(@@) % مازال خلك ميتا ولميت % في الميتين مصاهرا ومخاتنا % % 86(@)(@@) % مات الخلائق مذ نعاهم ربهم % % بل مذ رأت عين قرينا بائنا % % 87(@)(@@) % أفللتقدم والتأخر يمتري % % عينيك أسراب الدموع هواتنا % % 88(@)(@@) % ساق الخليل إلى الخليل فناؤه % % ليكون مدفونا له أو دافنا % % 89(@)(@@) % ولربما اختطفا جميعا خطفة % والدهر أخطف ماتراه محاجنا % % 90(@)(@@) % ولما جلوت صفاح قلبك واعظا % % إني رأيت عليه رينا رائنا % % PageV01P4879 91(@)(@@) % لكنه التذكير يهديه الفتى % % لأخيه حين يرى أساه راحنا % % 92(@)(@@) % ولئن عبأت لك الأسى لعلى امرئ % أمسى الحزين عليه لا المتحازنا % % 93(@)(@@) % ولئن أمرتك بالتجلد ظاهرا % لقد امتلأت عليه شجوا باطنا % % 94(@)(@@) % ولقد أقول غداة قام نعيه % % هيجت لي شجنا لعمرك شاجنا % % 95(@)(@@) % صفن الجواد وقد يطول جراؤه % % ولتسمعن بكل جار صافنا % % 96(@)(@@) % وطوى العتيق جناحه في وكنه % % وقصار ذي الطيران يلقى واكنا % % 97(@)(@@) % والحي يرتع ثم يسرع برهة % فإذا قضى أربيه أمسى عاطنا % % 98(@)(@@) % مات الذي نال العلا متناولا % % من بعد مانال العلا متطامنا % % 99(@)(@@) % مات الذي كان النصيح مساترا % مات الذي كان النصير معالنا % % 100(@)(@@) % مات الذي فتح الفتوح ملاينا % لاعاجزا عن فتحهن مخاشنا % % PageV01P4880 101(@)(@@) % مات الذي أحيا النفوس بيمنه % % وأمات منها للملوك ضغائنا % % 102(@)(@@) % مات الذي صان الدماء ولم يزل % عن كل إثم للأئمة صائنا % % 103(@)(@@) % مات الذي أغناه لطف حويله % عن أن يهز صوارما وموارنا % % 104(@)(@@) % مات الذي رأب الثأي متعاليا ولع الزمان بأن يحرك ساكنا % وبأن يثير من الأوابد كامنا % % 105(@)(@@) % وهم الأحبة من أقام ترحلوا % % عنه فكلهم يودع ظاعنا % % 106(@)(@@) % أضحى الزمان مدائنا لك فيهم % ولعل رشدا إن قضيت مدائنا 
ms1287	 % % 107(@)(@@) % فأرى الليالي ما نقضن معاهدا % فيما أتين ولا هجمن مآمنا % % 108(@)(@@) % رحلن إلفك عن مساكن قلعة % كانت لقوم آخرين مساكنا % % 109(@)(@@) % فاقن الحياء أبا الحسين فلم يكن % % شيء فري لم تخله كائنا % % 110(@)(@@) % كان الذي قد كنت توقن أنه % % سيكون فاجزع واقنا لا واهنا % % PageV01P4881 111(@)(@@) % هون عليك المقطعات ولا تكن % % بنصيحة من مخلص متهاونا % % 112(@)(@@) % إن الحوادث قد عدون فواجعا % فاشدد إزارك لا يكن فواتنا % % 113(@)(@@) % لا تنكرن من المصائب منا أتى % % حتى كأنك كنت منها آمنا % % 114(@)(@@) % أنكره إنكار امرىء عرف الردى % % ورأى النفوس بأن يمتن رهائنا % % 115(@)(@@) % إني نكرت على الليالي أن أتت % ما قد أتته لم يكن ظنائنا % % 116(@)(@@) % هل كنت غرا بالنوائب قبلها % % أم خلتهن لما تحب ضوامنا % % 117(@)(@@) % بل كنت فيما قد لقيت مفكرا % % حتى كأنك كنت ثم معاينا % % 118(@)(@@) % فعلام تنفر نفرة وحشية % وتعد دهرك غائلا لك خائنا % % 119(@)(@@) % ماخان دهر مؤذن بصروفه % ما انفك يرسل بالمواعظ آذنا % % 120(@)(@@) % طامن حشاك أخا البقاء لدائه % فلتزجرن أشائما وأيامنا % % PageV01P4882 121(@)(@@) % داء البقاء الرفء إما عاجلا % لا زلت توفاه وإما آينا % % 122(@)(@@) % من عاش أثكله الزمان خليله % وسقاه بعد الصفو رنقا آجنا % % 123(@)(@@) % وكذا شرب العيش فيه تلون % بيناه عذب إذ تحول آسنا % % 124(@)(@@) % والمرء ماعدت الحوادث نفسه % يلقي الزمان محاربا ومهادنا % % 125(@)(@@) % دار الزمان بليله ونهاره % فأدار أرحاء المنون طواحنا % % 126(@)(@@) % فتأمل الدنيا ولاتعجب لها % % واعجب لمن أضحى إليها راكنا % % 127(@)(@@) % قضى أبو العباس خلك نحبه % فجعلت نحبك دمعك المتهاتنا % % 128(@)(@@) % وودت أنك منه أول لاحق % % أوكنت مضمونا إليه مقارنا % % 129(@)(@@) % لكن أبى ذاك الإله فلا ترد % مالم يرد لقضائه وارض العزاء مخادنا % % 130(@)(@@) % لاتسجنن الهم عندك إنه % % مازال مسجونا يعذب ساجنا % % PageV01P4883 131(@)(@@) % واصبر كما أمر المليك فإنما % % يهدي المدين إذا أطاع الدائنا % % 132(@)(@@) % والله يمنحك الخلود مجاورا % أخيك في جناته ومساكنا % % 133(@)(@@) % من بعد أن تحيا حياة ممتع % % لا كالمشيع علو بين ظعائنا % % 134(@)(@@) % مامات خلك يوم زار ضريحه % % بل يوم زار قوابلا وحواضنا 
