ms2145	 (الاستبصار:(@)(@@) ج 1، ح 1687، وفيه الحسين بن سعيد، عن حماد بن عيسى، وهو من باب اختلاف الطريق)، والتهذيب: ج 4، ح 1012.(@)(@@) وروى عنه علي بن مهزيار.(@)(@@) الكافي: ج 3، ك 4، ب 84، ح 23.(@)(@@) والتهذيب: ج 2، ح 1388.(@)(@@) * وروى عن منهال، وروى عنه محمد ابن جمهور.(@)(@@) الكافي: ج 1، ك 4، ب 60، ذيل ح 2.(@)(@@) * وروى عن ناجية.(@)(@@) الفقيه: ج 1، ح 557.(@)(@@) * وروى عن يحيى بن عمرو بن كليع، وروى عنه إبراهيم بن هاشم.(@)(@@) الكافي: ج 4، ك 3، ب 28، ح 5.(@)(@@) * وروى عن الحلبي، وروى عنه ابن أبي عمير.(@)(@@) الكافي: ج 3، ك 4، ب 13، ح 2.(@)(@@) والتهذيب: ج 5، ح 903.(@)(@@) * وروى عن القداح، وروى عنه إبراهيم بن هاشم.(@)(@@) الكافي: ج 1، ك 2، ب 4، ح 1.(@)(@@) * وروى عن المسمعي، وروى عنه عبد الرحمان بن أبي نجران. الفقيه، المشيخة: في طريقه إلى المعلى بن خنيس.(@)(@@) * وروى عن بعض أصحابنا عن أبي عبد الله عليه السلام، وروى عنه إبراهيم بن هاشم.(@)(@@) الكافي: ج 3، ك 1، ب 40، ح 2.(@)(@@) والتهذيب: ج 1، ح 599 (الاستبصار:(@)(@@) ج 1، ح 588).(@)(@@) * وروى عنه فضيل بن عبد ربه.(@)(@@) التهذيب: ج 7، ح 1107 (الاستبصار:(@)(@@) ج 3، ح 523، وفيه فضل بدل فضيل).(@)(@@) * وروى عن بعض أصحابه عن أبي عبد الله عليه السلام، وروى عنه إبراهيم بن هاشم.(@)(@@) الكافي: ج 3، ك 4، ب 17، ح 5.(@)(@@) والتهذيب: ج 2، ح 1330.(@)(@@) * وروى عن بعض أصحابه عن أحدهما عليهما السلام، وروى عنه علي ابن مهزيار.(@)(@@) التهذيب: ج 1، ح 238 (الاستبصار:(@)(@@) ج 1، ح 178).(@)(@@) * وروى عن بعض أصحابنا عن العبد الصالح عليه السلام، وروى عنه إبراهيم بن هاشم.(@)(@@) الكافي: ج 1، ك 4، ب 129، ح 4. PageV07P446(@)(@@) * وروى عن بعض أصحابنا عن أبي الحسن الأول عليه السلام، وروى عنه إبراهيم بن هاشم.(@)(@@) الكافي: ج 7، ك 2، ب 65، ح 3.(@)(@@) * وروى عن بعض أصحابنا عن أبي الحسن الأول العبد الصالح عليه السلام، وروى عنه الحسن بن راشد.(@)(@@) التهذيب: ج 4، ح 366 (الاستبصار:(@)(@@) ج 2، ح 185).(@)(@@) * وروى عن بعض أصحابنا عن أبي حمزة الثمالي، وروى عنه الحسين بن سعيد.(@)(@@) التهذيب: ج 2، ح 1415.(@)(@@) * وروى مرسلا، وروى عنه يونس.(@)(@@) التهذيب: ج 1، ح 620.(@)(@@) * وروى مرفوعا عن أمير المؤمنين عليه السلام، وروى عنه محمد 
ms2146	 بن خالد.(@)(@@) الكافي: ج 2، ك 2، ب 59، ح 2.(@)(@@) * وروى مضمرة.(@)(@@) الفقيه: ج 3، ح 1552.(@)(@@) * وروى عمن أخبره عن العبد الصالح عليه السلام، وروى عنه إبراهيم بن هاشم.(@)(@@) الكافي: ج 4، ك 3، ب 125، ح 3.(@)(@@) * وروى عمن أخبره عن حريز.(@)(@@) الفقه: ج 3، ح 173.(@)(@@) * وروى عمن ذكره عن أبي عبد الله عليه السلام، وروى عنه ابن أبي عمير.(@)(@@) الكافي: ج 4، ك 3، ب 138، ح 5.(@)(@@) وروى عنه إبراهيم بن هاشم.(@)(@@) الفقيه، المشيخة: في طريقه إلى ما كان فيه من وصية علي عليه السلام لابنه محمد بن الحنفية.(@)(@@) * وروى هو أو ابن أبي عمير عن ابن أذينة، وروى عنه إبراهيم بن هاشم.(@)(@@) الكافي: ج 6، ك 1، ب 7، ح 2. والتهذيب:(@)(@@) ج 8، ح 113.(@)(@@) حمدان بن سليمان * روى عن الحسن بن علي بن الوليد، وروى عنه محمد بن يحيى.(@)(@@) الكافي: ج 4، ك 3، ب 141، ح 6.(@)(@@) * وروى عن الحسن بن محمد بن سلام، وروى عنه محمد بن يحيى.(@)(@@) الكافي: ج 4، ك 3، ب 212، ح 21.(@)(@@) * وروى عن عبد السلام بن صالح الهروي، وروى عنه علي بن محمد بن قتيبة.(@)(@@) الفقيه: ج 3، ح 1128. والتهذيب: ج 4، PageV07P447(@)(@@) ح 605 (الاستبصار: ج 2، ح 316).(@)(@@) * وروى عن عبد الله بن محمد اليماني، وروى عنه محمد بن يحيى.(@)(@@) الكافي: ج 1، ك 4، ب 108، ح 81 و 82، والكافي: ج 4، ك 3، ب 232، ح 3.(@)(@@) * وروى عن علي بن الحسن، وروى عنه محمد بن يحيى.(@)(@@) الكافي: ج 6، ك 7، ب 32، ح 2.(@)(@@) التهذيب: ج 9، ح 552.(@)(@@) * وروى عن محمد بن الحسين، وروى عنه علي بن محمد بن قتيبة. الفقيه، المشيخة: في طريقه إلى عثمان بن زياد.(@)(@@) حمدان القلانسي * روى عن إسحاق بن بنان، وروى عنه الحسين بن محمد.(@)(@@) الكافي: ج 5، ك 3، ب 68، ح 11، والكافي: ج 6، ك 2، ب 57، ح 13.(@)(@@) والتهذيب: ج 7، ح 1713 (الاستبصار:(@)(@@) ج 3، ح 901)، والتهذيب: ج 8، ح 15 (الاستبصار: ج 3، ح 921).(@)(@@) * وروى عن أيوب بن نوح، وروى عنه الحسين بن محمد.(@)(@@) الكافي: ج 6، ك 2، ب 29، ح 1.(@)(@@) * وروى عن علي بن راشد، وروى عنه الحسين بن محمد.(@)(@@) الكافي: ج 6، ك 2، ب 29، ح 1.(@)(@@) * وروى عن علي بن محمد الحضيني، وروى عنه محمد بن 
ms2147	 يحيى.(@)(@@) الكافي: ج 4، ك 3، ب 234، ح 3.(@)(@@) والتهذيب: ج 6، ح 172.(@)(@@) * وروى عن محمد بن الوليد، وروى عنه أحمد بن محمد الكوفي.(@)(@@) الكافي: ج 2، ك 2، ب 49، ح 17، والكافي: ج 5، ك 1، ب 13، ح 3.(@)(@@) * وروى عن معاوية بن حكيم، وروى عنه الحسين بن محمد.(@)(@@) الكافي: ج 6، ك 2، ب 29، ح 1.(@)(@@) * وروى عن العمري، وروى عنه علي بن محمد.(@)(@@) الكافي: ج 1، ك 4، ب 75، ح 4، وب 76، ح 4.(@)(@@) حمران * روى عن أبي جعفر عليه السلام.(@)(@@) الفقيه: ج 2، ح 455، 1051، والفقيه:(@)(@@) ج 4، ح 306. PageV07P448(@)(@@) * وروى عنه أبو أسامة.(@)(@@) الكافي: ج 2، ك 1، ب 106، ح 17.(@)(@@) * وروى عنه أبو أيوب.(@)(@@) الكافي: ج 7، ك 4، ب 23، ح 3.(@)(@@) والتهذيب: ج 10، ح 930.(@)(@@) وروى عنه أبو جميلة.(@)(@@) الكافي: ج 7، ك 1، ب 13، ح 15.(@)(@@) والفقيه: ج 4، ح 545. والتهذيب: ج 9، ح 788، 867.(@)(@@) وروى عنه أبو خالد.(@)(@@) التهذيب: ج 2، ح 199 (الاستبصار:(@)(@@) ج 1، ح 1120).(@)(@@) وروى عنه أبو خالد القماط.(@)(@@) الكافي: ج 2، ك 1، ب 53، ح 6، والكافي:(@)(@@) ج 7، ك 4، ب 1، ح 1.(@)(@@) وروى عنه أبو ولاد.(@)(@@) الكافي: ج 6، ك 2، ب 73، ح 1. والفقيه:(@)(@@) ج 3، ح 1657.(@)(@@) وروى عنه أبو ولاد الحناط.(@)(@@) التهذيب: ج 5، ح 1291.(@)(@@) وروى عنه ابن أذينة.(@)(@@) التهذيب: ج 5، ح 703 (الاستبصار:(@)(@@) ج 2، ح 948)، والتهذيب: ج 9، ح 304 (الاستبصار: ج 4، ح 335).(@)(@@) وروى عنه الحجر.(@)(@@) الكافي: ج 1، ك 4، ب 38، ح 7.(@)(@@) وروى عنه حريز.(@)(@@) الكافي: ج 5، ك 2، ب 137، ح 4.(@)(@@) وروى عنه حمزة ابنه.(@)(@@) الكافي: ج 2، ك 1، ب 196، ح 1.(@)(@@) وروى عنه حمزة بن حمران.(@)(@@) الكافي: ج 2، ك 1، ب 95، ح 3.(@)(@@) والتهذيب: ج 10، ح 132.(@)(@@) وروى عنه داود الابزاري أبو اليسع.(@)(@@) الكافي: ج 2، ك 1، ب 187، ح 5.(@)(@@) وروى عنه زرارة.(@)(@@) الكافي: ج 1، ك 3، ب 24، ح 4، والكافي:(@)(@@) ج 2، ك 1، ب 3، ح 1، وب 195، ح 2، والكافي: ج 4، ك 1، ب 25، ح 2، ك 2، ب 69، ح 6، وك 3، ب 173، ح 3، والكافي: ج 5، ك 3، ب 114، ح 9.(@)(@@) والفقيه: ج 2، ح 1435. والتهذيب: ج 9، ح 287 (الاستبصار: ج 4، ح 319).(@)(@@) وروى عنه عبد الرحمان.(@)(@@) الكافي: ج 4، ك 3، ب 86، ح 6.(@)(@@) وروى عنه عبد الله بن 