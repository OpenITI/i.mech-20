ms2941	 ه‍. تاريخ بغداد ٤: ٣٦، تهذيب التهذيب ٩: ٤١ - ٤٧، دائرة المعارف الاسلامية ٣: ٤١٩. الأعلام للزركلي.(@)(@@) (٢) عبد الله بن محمد بن عبد الله بن جعفر المسندي البخاري الحافظ، وسمي بالسندي لاعتنائه بالأحاديث المسندة وإعراضه عن الأحاديث المرسلة وهو أستاذ البخاري، ما سنة ٢٢٦ ه‍، له ترجمة في تذكرة الحفاظ ٢: ٤٩٢، تهذيب التهذيب التهذيب ٦: ٩.(@)(١) عبيد الله بن عبد الكريم بن يزيد الرازي القرشي، علم حافظ ناقد، ثبت، له التصانيف العديدة، مات سنة ٢٦٤ ه‍، تاريخ بغداد ١٠: ٣٢، تهذيب التهذيب ٧: ٢٨ - ٣٠. الأعلام للزركلي.(@)(@@) (٢) ابن خراش هو أحمد ب الحسن بن خراش البغدادي، ذكره ابن حبان في الثقات. مات سند ٢٤٣، تهذيب التهذيب ١: ٢١.(@)(١) هو فضالة الصائغ: الفضل بن العباس أبو بكر المروزي المعروف بفضلك - أحد الأئمة الحفاظ مات سنة ٢٧٠ تاريخ بغداد ١٢: ٣٦٧، انظر تهذيب التهذيب ٧: ٢٨ - ٣٠ ترجمة أبي زرعة الرازي.(@)(@@) (٢) الريع بن سليمان بن عبد الجبار بن كامل المرادي مولاهم أبو محمد المصري المؤذن، صاحب الشافعي ورواية كتبه. تهذيب التهذيب ٣: ٢١٣ - ٢١٤.(@)(@@) (٤) آدم بن أبي إياس، واسم أبي اياس ناهية، وقال محمد بن إسماعيل البخاري هو آدم بن عبد الرحمن، ويكنى أبا الحسن، نشأ ببغداد، واستوطن عقلان، كان أحد العباد الصالحين، روى عنه الأئمة الاعلام مات سنة ٢٢٠ وهو حافظ ثقة. تاريخ بغداد، وتهذيب التهذيب ١: ١٧١ - ١٧١.(@)(@@) (٥) ثابت بن محمد الزاهد، أبو محمد الشيباني، ذكره ابن حبان في الثقات مات سنة ٢١٥ ه‍. تهذيب التهذيب ٢: ١٣ - ١٤، ميزان الاعتدال ١: ٣٦٦.(@)(١) محمد بن المنهال التميمي أبو جعفر الضرير الحافظ الثقة مات سنة ٢٣١، تهذيب التهذيب ٩: ٤١٩ - ٤٢٠.(@)(@@) (٢) محمد بن مسلم بن عثمان بن عبد الله الرازي، ابن وارة - حافظ ثقة مات سنة ٢٧٠، تهذيب التهذيب ٩: ٣٩٩ - ٤٠٠، وتاريخ بغداد ٣: ٢٥٦.(@)(@@) (٣) أبو كريب. هو محمد بن العلاء بن كريب الكوفي الهمداني ذكره ابن حبان في الثقات مات سنة ٢٤٨ ه‍، تهذيب التهذيب ٩: ٣٤٢ - ٣٤٣. وقد تقدمت ترجمته (٤) محمد بن عوف بن سفيان الطائي الحمصي محدث الشام ذكره ابن حبان في الثقات مات سنة ٢٧٢ ه‍، تهذيب التهذيب ٩: ٣٤٠ - ٣١، تذكرة الحفاظ.(@)(@@) (٥) أحمد بن عمير بن جوصاء الحافظ أبو الحسن، قال الطبراني هو من 
ms2942	 ثقات المسلمين، وقال ابن عساكر: كان شيخ الشام في وقته، مات سنة ٣٢٠، لسان الميزان ١: ٢٣٩، وميزان الاعتدال ١: ١٢٥.(@)(١) يزيد بن محمد بن عبد الصمد بن عبد الله الهاشمي، مولاهم الدمشقي. حافظ ثقة مات سنة ٢٧٧ ه‍ تهذيب التهذيب ١١: ٣١٣.(@)(@@) (٢) أبو زرعة هو عبد الرحمن بن عمرو بن عبد الله بن صفوا النصري، محدث الشام في وقته، حافظ ثقة مات سنة ٢٨١ ه‍، شذرات الذهب ٢: ١٧٧، وتهذيب التهذيب ٦: ٢١٥، وتذكرة الحفاظ ٢: ٦٢٤.(@)(@@) (٣) محمد بن يحيى بن محمد بن كثير الكلبي، أبو عبد الله الحراني، لقبه لؤلؤ، الحافظ، ذكره ابن حبان في الثقات، ومات سنة ٢٦٧ بحران، تهذيب التهذيب ٩: ٤٥٩ - ٤٦٠.(@)(@@) (٤) إبراهيم بن سعيد الجوهري أبو إسحاق، الطبري، البغدادي، أحد الحفاظ سنة ٢٤٩، تاريخ بغداد ٦: ٤٢. تذكرة الحفاظ ٢: ٦٢٨.(@)(١) عبيد العجل: هو الحسين بن محمد بن حاتم البغدادي أبو علي ويقال له العجل وعبيد، كان تلميذا ليحيى بن معين، مات سنة ٢٩٤ ه‍، تاريخ بغداد ٨: ٩٣، النجوم الزاهرة ٣: ١٦١. شذرات الذهب ٢: ٢١٦.(@)(@@) (٢) صالح بن محمد بن عمرو بن حبيب أبو علي البغدادي الملقب بجزرة، امام حافظ ثقة توفي سنة ٢٩٣. تهذيب ابن عساكر ٦: ٣٨١، تاريخ بغداد ٩: ٣٢٢. الأعلام للزركلي.(@)(@@) (٣) نصرك: هو الحافظ نصر بن أحمد بن نصر الكندي البغدادي، صاحب المسند المعروف بنصرك، مات سنة ٢٩٣، تاريخ بغداد ١٣: ٢٩٣. تذكرة الحفاظ ٢: ٦٧٦.(@)(@@) (٤) عبد الله بن أحمد بن محمد بن حنبل الشيباني البغدادي أبو عبد الرحمن وفي (م) عبد الله، حافظ ثقة له مصنفات، الزوائد على كتاب الزهد لأبيه، وزوائد المسند، زاد على مسند أبيه عشرة آلاف حديث، مات سنة ٢٩٠ ه‍.(@)(@@) الطبقات لأبي أبي يعلي ٤: ١٨٩ تهذيب التهذيب ٥: ١٢٤ - 125، شذرات الذهب 2: 203، الأعلام للزركلي.(@)(١) موسى بن هارون بن عبد الله بن مروان أبو عمران البغدادي البزار، محدث العراق، حافظ ثقة مات سنة ٢٩٠ ه‍. تاريخ بغداد ١٣: ٥٠، تذكرة الحفاظ ٢: ٦٦٩.(@)(@@) (٢) مشكدانة هو عبد الله بن محمد بن عمر بن أبان الجعفي، مشكدانة لقبه - تقدمت ترجمته.(@)(@@) مؤلفات مات سنة ٣٠٦. تاريخ بغداد ٩: ٣٧٨، شذرات الذهب ٢: ٢٤٩ تقدمت ترجمته.(@)(@@) (٤) النسائي: هو الامام الحافظ أبو عبد الرحمن، أحمد بن شعيب بن علي بن سنان النسائي، له السنن الكبرى، وغيره 
ms2943	 من المصنفات مات سنة ٣٠٣، وأصله من بلدة نسا بخراسان، وفيات الأعيان ١: ٢١، البداية والنهاية ١١: ١٢٣، طبقات الشافعية 2: 83، شذارت الذهب 2: 239. الأعلام للزركلي.(@)(١) عبد الله بن محمد بن سيار الفرهياني، ويقال الفرهاذاني حافظ ثقة مات سنة نيف وثلاثمائة، تذكرة الحفاظ ٢: ٧١٦.(@)(@@) (٢) حرملة بن يحيى التجيبي، قال أبو حاتم لا يحتج به، وقال الفرهاذاني: ضعيف. المغني في الضعفاء ١: ١٥٣.(@)(@@) (٣) أبو عروبة. هو الحسين بن محمد بن مودود السلمي الحراني، له مصنفات، مات سنة ٣١٨. تذكرة الحفاظ ٢: ٧٧٤.(@)(@@) (٤) عليك: هو علي بن بشير بن مهران، حافظ متقن مات سنة ٢٩٧، ميزان الاعتدال ٢: ١٣١، نزهة الألباب ٦٧.(@)(@@) (٥) الهيثم الدوري، هو الهيثم بن خلق أبو محمد الدوري حافظ ثقة مات سنة ٣٠٧، تذكرة الحفاظ ٢: ٧٦٥.(@)(@@) لسان الميزان ٦: ٢٠٦.(@)(١) القاسم بن محمد بن أبي بكر الصديق رضي الله عنه أبو محمد المدني تابعي عالم فقيه ثقة ورع، كثير الحديث، مات سنة ١٠١ ه‍، أخرج حديثه الستة: طبقات ابن سعد ٥: ١٣٩، تذكرة الحفاظ ١: ٩٦، تهذيب التهذيب ٨: ٣٢٩ - ٣٠١.(@)(@@) (٢) سالم بن عبد الله بن عمر بن الخطاب رضي الله عنهم الامام الفقيه، ومن أفضل أهل زمانه، وأحد الفقهاء السبعة قال الإمام أحمد وابن راهويه: أصح الأسانيد: الزهري عن سالم عن أبيه، كان يشبه أباه في السمت والهدى. مات سنة ١٠٦ ه‍. الثقات ٣: ٩١، تذكرة الحفاظ ١: ٨٨، تهذيب التهذيب ٣: ٣٧٨ - ٣٧٩ / (٣) أبو التياح هو يزيد بن حميد البصري، تابعي، حافظ، ثقة، مأمون، أخرج حديثه الستة مات سنة ١٢٨ ه‍.(@)(@@) الثقات ٣: ٢٩٠، تهذيب التهذيب ١١: ٢٨٠ - ٢٨١.(@)(@@) (٤) أبو قلابة عبد الله بن زيد الجرمي، أحد الأئمة الاعلام، بصري، كثير الحديث مات سنة ١٠٤ ه‍، أو بعدها.(@)(@@) تذكرة الحفاظ ١: ٩٤، تهذيب التهذيب ٥: ١٩٧ - ١٩٩.(@)(@@) (٥) أبو الجوزاء أوس بن عبد الله الربعي البصري. تابعي ثقة، اخرج حديثه الستة، مات سنة ٨٣ ه‍. تهذيب التهذيب ١: ٣٣٥ - ٣٣٦.(@)(@@) (٦) محمد بن راشد المكحولي الخزاعي الدمشقي أبو عبد الله. روى عن مكحول وجماعة، وثقه أحمد وابن معين والنسائي مات قبل سنة ١٧٠ ه‍. ميزان الاعتدال ٣: ٥٤٣، تهذيب التهذيب ٩: ١٤٠ - 141.(@)(١) المغيرة بن مقسم الضبي مولاهم أبو هشام الكوفي، ثقة أخرج حديثه الستة، مات سنة ١٣٣ ه‍ أو بعدها، تهذيب التهذيب ١٠: ٢٤١ - 242، شذرات 
ms2944	 الذهب 1، 191.(@)(@@) (2) جمعا - انظر لسان العرب مادة عنق.(@)(١) رواه الطبراني، والبزار. قال الهيثمي: وفيه هارون بن هارون وهو ضعيف، مجمع الزوائد ٧: ٣٠٧، 1: 141.(@)(@@) (2) محرز بن هارون القرشي التيمي المدني ويقال (محرر) برائين ضعيف. المغني في الضعفاء 2: 544.(@)(@@) (3) عبد الله بن زياد بن سليمان بن سمعان، متروك، المغني في الضعفاء 1: 339.(@)(١) أبو البختري هو سعيد بن فيروز بن أبي عمران تابعي جليل وثقه أبو زرعة، وابن معين، لسان الميزان ٧: ٤٥٢.(@)(1) أبو عاصم الضحاك بن مخلد بن الضحاك الشيباني، البصري، النبيل، الحافظ، الثبت، تقدمت ترجمته.(@)(١) أبو سعيد الأشج هو عبد الله بن سعيد الكندي، تهذيب التهذيب ١٢: ١١٩.(@)(@@) (٢) ابن يمان هو: يحيى بن يمان العجلي أبو زكريا الكوفي، تهذيب التهذيب ١١: ٢٦٧ - ٢٦٨.(@)(@@) (٣) مؤمل بن إهاب بن عبد العزيز بن فضل الربعي ثقة، تهذيب التهذيب ١٠: ٣٤٠ - ٣٤١.(@)(@@) (٤) رواه البزار وفيه خالد بن عمرو القرشي. قال الهيثمي: كذبه يحيى بن معين وأحمد بن حنبل ونسبه إلى الوضع.(@)(@@) مجمع الزوائد: العلم ١: ١٤٠، وانظر التمهيد ١: ٥٨ - ٥٩، وميزان الاعتدال ١: ٦٣٥.(@)(١) مروان ابن معاوية الفزاري ثقة عالم صاحب حديث لكن يروي عمن دب ودرج. قال ابن المديني: ثقة فيما يري عن المعروفين. ميزان الاعتدال ٤: ٩٣.(@)(١) مسلمة بن علي الخشني، واه، متروك، سكن مصر ومات بها قبل سنة ١٩٠ ه‍، ميزان الاعتدال ٤: ١٠٩.(@)(@@) وتهذيب التهذيب ١٠: ١٣٢ - ١٣، والمغني ٢: ٦٥٧.(@)(١) محمد بن غالب تمتام، حافظ مكثر، ذكره ابن حبان في الثقات، لسان الميزان ٥: ٣٣٧.(@)(@@) (٢) بهز بن أسد العمي أبو الأسود البصري ثقة ثبت مات سنة ٢٠٠ ه‍. تهذيب التهذيب ١: ٤٣٦ - ٤٣١.(@)(@@) (٣) خليد (بالتصغير) بن دعلج السدوسي أبو حليس ويقال أبو عبيد ضعيف متروك ذكره ابن البرقي والعقيلي في الضعفاء، وقال النفيلي مات سنة ١٦٦ ه‍، تهذيب التهذيب ٣: ١٣٦ - 137، والمغني في الضعفاء 1: 213.(@)(@@) (4) انظر الفتح الكبير للسيوطي 1: 425، وفيض القدير 2: 545.(@)(١) انظر الجامع الكبير ٢: ١٨، رواه مسلم في صحيحه.(@)(@@) (٢) مقدمة صحيح مسلم ١: ١٤.(@)(١) أبو أسامة بن زيد القرشي، أبو أسامة الكوفي ذكره ابن حبان في الثقات. تهذيب التهذيب ٣: ٤ - 3.(@)(١) عيسى الغنجار: هو عيسى بن موسى التيمي ويقال التميمي مولاهم، أبو أحمد لا بخاري الأزرق المع