ms81	 وسلم PageV01P437(@)(@@) | - * حرف الطاء المهملة(@)(@@) - *(@)(@@) | يبدأ برقم 1821 وينتهي برقم 1864(@)(@@) PageV01P439(@)(@@) | - * حرف الطاء(@)(@@) - *(@)(@@) 1821 طابع(@)(@@) هو العباس بن ميمون عن أبي الزناد(@)(@@) 1822 طالب الحق(@)(@@) هو عبد الله بن يحي الخارجي(@)(@@) 1823 طابخة بن إلياس بن مضر اسمه(@)(@@) عامر جاهلي(@)(@@) 1824 طارمة(@)(@@) هو علي بن القاسم كان من أصحاب المعتصم(@)(@@) 1825 طارة المقرىء صاحب قالون هو عبد الله بن عيسى بن عبد الله ابن شعيب المدني أبو محمد(@)(@@) 1826 طاقات(@)(@@) هو محمد بن عبيد المروزي PageV01P441(@)(@@) 1827 الطاهر لقب جماعة(@)(@@) منهم أبو أحمد والد الشريفين الرضي والمرتضي الشاعرين المشهورين(@)(@@) 1828 وأحمد بن علي بن المعمر النقيب(@)(@@) 1829 طاوس صاحب ابن عباس يقال لقبه واسمه ذكوان PageV01P442(@)(@@) 1830 الطائع الخليفة العباسي اسمه عبد الكريم(@)(@@) 1831 طباطبا(@)(@@) هو إبراهيم بن سماعيل بن الحسن العلوي قالوا كان يلثغ بالقاف فيجعلها طاء فقال لغلامه ناولني ثوبا ألبسه فقال آتيك بدراعة قال لا طباطبا يريد قباقبا(@)(@@) 1832 طبخة(@)(@@) إسماعيل بن عيسى القناديلي عن جرير بن حازم(@)(@@) 1833 الطبراخ PageV01P443(@)(@@) هو عبد الله والد علي بن أبي هاشم شيخ البخاري(@)(@@) 1834 الطحان(@)(@@) هو خالد بن عبد الله الواسطي(@)(@@) 1835 طرخان اثنان(@)(@@) علي بن فارس من الرواة عن ابن صاعد(@)(@@) 1836 وعبد الملك بن محمد من أصحاب عبد الرزاق(@)(@@) 1837 طرغانة اسمه يونس(@)(@@) 1838 طرفة بفتحات ابن العبد الشاعر اسمه(@)(@@) عمرو جاهلي(@)(@@) 1839 الطرماح بتشديد الميم اثنان(@)(@@) أحدهما حكيم بن عدي له خب ر مع معاوية PageV01P444(@)(@@) 1840 والآخر(@)(@@) الشاعر المشهور لم يذكر الشيرازي اسمه وذكره في الألقاب(@)(@@) 1841 طريف(@)(@@) هو مسلم بن جعفر بن محمد شامي(@)(@@) 1842 طريق غريب اسمه(@)(@@) إبراهيم بن أحمد بن يعقوب المروزي الكسائي(@)(@@) 1843 طست(@)(@@) هو الفضل بن زياد ويقال له الفضل بن صالح وهو من أصحاب أحمد ويلقب أيضا التور بالمثناة وقد تقدم(@)(@@) 1844 طغان(@)(@@) هو أحمد بن علي بن حمزة ذكره ابن نقطة(@)(@@) 1845 طغك(@)(@@) هو علي بن عبد الله الفرغاني نزيل مصر شيخ للطبراني PageV01P445(@)(@@) 1846 طغيل(@)(@@) هو معمر بن سليمان الرقي يروي عن ابن 
ms82	 أبي مرة(@)(@@) 1847 الطفيل بن سخبرة يقال(@)(@@) اسمه عيسى(@)(@@) 1848 طلمطاق(@)(@@) هو بكر بن محمد بن موسى الخياط PageV01P446(@)(@@) 1849 طقطمش(@)(@@) من ألقاب ملوك الترك(@)(@@) 1850 الطليق(@)(@@) اسم لكل من كان بمكة يوم الفتح ومن عليه النبي صلى الله عليه وسلم لقوله صلى الله عليه وسلم لهم أنتم الطلقاء(@)(@@) 1851 ولقب بها مروان بن عبد الرحمن بن مروان بن عبد الرحمن الناصر الأندلسي الشاعر وكان مفلقا حتى قال ابن حزم هو لبني أمية كعبد الله بن المعتز لبني العباس(@)(@@) 1852 طنجة(@)(@@) هو إسماعيل بن عيسى القناديلي(@)(@@) 1853 طنجير(@)(@@) هو أحمد بن العباس الشيباني PageV01P447(@)(@@) 1854 طويس المغني الذي يضرب به المثل في الشؤم قيل اسمه طاوس(@)(@@) 1855 طورط(@)(@@) لقب حمران بن أبان مولى عثمان وكان يهوديا فأسلم وسباه PageV01P448 المسيب بن نجبة من عين التمر وأمير الجيش خالد فاشتراه عثمان وكان يكتب له ثم غضب عليه فأخرجه إلى البصرة وهو من رجال الصحيحين(@)(@@) 1856 الطويل لقب جماعة(@)(@@) منهم عبد الرحمن جد محمد بن طلحة(@)(@@) 1857 وعبد الرحمن الدمشقي(@)(@@) 1858 وبكر البصري(@)(@@) 1859 وحمدي صاحب أنس PageV01P449(@)(@@) 1860 وعبد الجبار بن أحمد بن عمر بن الحسن الطرسوسي أبو القاسم المري نزيل مصر(@)(@@) 1861 الطيار(@)(@@) هو جعفر بن أبي طالب ابن عم النبي صلى الله عليه وسلم(@)(@@) 1862 الطيارة(@)(@@) هو محمد بن رزقون القيرواني من أصحاب سحنون PageV01P450(@)(@@) 1863 الطيب(@)(@@) هو مرة بن شراحيل مخضرم(@)(@@) 1864 طيرة(@)(@@) هو عمار بن علي بن إبراهيم من شيوخ الدارقطني PageV01P451(@)(@@) | - * حرف الظاء المعجمة(@)(@@) - *(@)(@@) | يبدأ برقم 1865 وينتهي برقم 1873(@)(@@) PageV01P543(@)(@@) | - * حرف الظاء المعجمة(@)(@@) - *(@)(@@) 1865 الظافر(@)(@@) من خلفاء مصر اسمه عيسى ولقب به بعض ملوك بني أيوب(@)(@@) 1866 ظاهر(@)(@@) هو عبد الصمد بن أحمد بن محمد المساميري من شيوخ ابن عساكر حدث عن طراد الزينبي(@)(@@) 1867 الظاهر(@)(@@) لقب جماعة من الخلفاء والملوك أول من لقب به الظاهر غازي بن الناصر صلاح الدين ابن أيوب(@)(@@) 1868 ثم الظاهر محمد بن الناصر أحمد العباسي PageV01P454(@)(@@) 1869 وأخوهم سلطان العصر الملك الظاهر جقمق فاق ملوك عصره بالعلم 
ms83	 والدين والعفة والجود أمتع الله المسلمين ببقائه(@)(@@) 1870 ظل الشيطان(@)(@@) هو محمد بن سعد بن أبي وقاص كان قصيرا جدا ولم يذكر الشيرازي في الألقاب غيره(@)(@@) 1871 الظريف(@)(@@) هو عبد الله بن أحمد الأصبهاني شيخ للبرقاني قال كان معمرا ومات سنة أربع وسبعين وثلاثمائة PageV01P455(@)(@@) 1872 ظلم طاق(@)(@@) اسمه بكر بن محمد بن موسى الخياط أبو زكريا عن أبي يحي بن أبي مرة(@)(@@) 1873 الظهير جماعة(@)(@@) منهم أبو علي الحسن بن الخطير النعماني مات بمصر سنة ثمان وتسعين وخمسمائة(@)(@@) ولقب بظهير الدين جماعة PageV01P456 كمال أسامة محمد أبو زيد نزهة الألباب في الألقاب أحمد بن علي العسقلاني صلى الله عليه وسلم صلى الله عليه وسلم 2 PageV02P001 | 2 | PageV02P001(@)(@@) | - * حرف العين المهملة(@)(@@) - *(@)(@@) | يبدأ برقم 1874 وينتهي برقم 2053(@)(@@) PageV02P007(@)(@@) | - * حرف العين(@)(@@) - *(@)(@@) 1874 عابد الشط(@)(@@) هو أبوالطيب المظفر بن سهل الخليلي حدث بمكة عن إسحاق بن أيوب الواسطي وعن مالك(@)(@@) 1875 العادل(@)(@@) لقب جماعة من الملوك منهم محمود بن زنكي صاحب الشام(@)(@@) 1876 عارق الشاعر الطائي اسمه(@)(@@) قيس بن جروة جاهلي(@)(@@) 1877 عارم(@)(@@) هو محمد بن الفضل السدوسي شيخ البخاري PageV02P009(@)(@@) 1878 عاشق الكلاب(@)(@@) إبراهيم بن عبد الحميد بن علي البزار ذكره ابن الطحان في ذيل تاريخ مصر(@)(@@) 1879 عائد الكلب(@)(@@) هو عبد الله بن مصعب بن ثابت بن عبد الله بن الزبير قيل له ذلك لقوله ويمرض كلبكم فأعود(@)(@@) 1880 عباد جماعة(@)(@@) منهم عبد الله بن محمد مولى بني هاشم(@)(@@) 1881 وعبد الله بن علي PageV02P010(@)(@@) 1882 وعبد الله بن أبي صالح السمان(@)(@@) 1883 وعبد الرحمن بن إسحاق(@)(@@) 1884 وعبد الله بن عبيد الله بن أبي رافع(@)(@@) ويقال لهذا الأخير عبادل بالتخفيف وزيادة لام(@)(@@) 1885 عباسوية(@)(@@) هو العباس بن يزيد البحراني(@)(@@) 1886 عباسة(@)(@@) هو العباس بن محمد بن أبي منصور الطوسي(@)(@@) 1887 عبانج(@)(@@) عبد الله بن سعيد بن جعفر البخاري PageV02P011(@)(@@) سمع محمد بن الصلت(@)(@@) 1888 وآخر اسمه(@)(@@) محمد بن سعيد المؤذن(@)(@@) 1889 العبد اثنان(@)(@@) أحدهما خالد بن عبد الرحمن(@)(@@) 1890 والآخر(@)(@@) عبد العزيز بن صهيب(@)(@@) 1891 عبد 
ms84	 بغير إضافة ابن وهب البلخي هو عبد الله شيخ لأبي حامد البزار(@)(@@) 1892 عبد بن حميد الكسي اسمه PageV02P012(@)(@@) عبد الحميد جزم بذلك أبو القاسم بن منده وغير واحد(@)(@@) 1893 عبد بزبور(@)(@@) هو عبد الله بن محمد الترمذي ابن أخت صالح بن محمد يروي عن مكي بن إبراهيم(@)(@@) 1894 عبد ذليل(@)(@@) هو إبراهيم بن محمد بن عمرويه المرزوي(@)(@@) 1895 عبدك(@)(@@) هو عبد الكريم الجرجاني(@)(@@) 1896 عبدان لقب جماعة PageV02P013(@)(@@) منهم عبد الله بن عثمان شيخ البخاري(@)(@@) 1897 وعبد الله بن أحمد بن موسى العسكري الأهوازي(@)(@@) 1998 وعبد الله بن محمد بن يزيد العسكري(@)(@@) 1899 وعبد الله بن يوسف بن خالد السلمي(@)(@@) 1900 وعبد الله بن خالد القرقساني أبو عثمان البجلي عن مالك ابن مغول(@)(@@) 1901 وعبد الله بن عبدان بن محمد بن عبدان أبو الفضل الهمذاني(@)(@@) 1902 وعبد الله بن محمد بن عيسى المروزي PageV02P014(@)(@@) 1903 وعبد الله بن يزيد بن يعقوب الدقيقي(@)(@@) 1904 عبدة بن سليمان قيل اسمه(@)(@@) عبد الرحمن وبه جزم ابن منده(@)(@@) 1905 عبدويه جماعة(@)(@@) منهم عبد الملك بن سفيان المسمعي وزعم ابن الفرضي أنه عدويه بغير موحدة(@)(@@) 1906 وعبد الله بن غالب المروزي عن يونس بن يزيد(@)(@@) 1907 وعبد الله بن هاشم القواس الهمداني(@)(@@) 1908 وأيوب بن إبراهيم الثقفي أبو يحي(@)(@@) 1909 وعبد الله بن محمد الهروي الراوساني عن محمد بن عمرويه(@)(@@) 1910 وعمرو بن سعيد الحمال عن الحسين بن حفص وعنه أبو محمد ابن فارس(@)(@@) 1911 ومنصور بن عبد الحميد المروزي(@)(@@) 1912 وعبد الرحمن بن عبد الله الجزري PageV02P015(@)(@@) 1913 عبود(@)(@@) هو أحمد بن عبد الواحد الدمشقي(@)(@@) 1914 عبويه(@)(@@) هو عبيد الله بن الفضل بن شقيق السدوسي عن الأصمعي(@)(@@) 1915 عبيد بالتصغير جماعة(@)(@@) منهم الحسين بن محمد بن حاتم الحافظ وهو الذي يقال له العجل وربما جمع لقباه فقيل عبيد العجل(@)(@@) 1916 ومنهم عبد العزيز بن الوليد بن سليمان بن أبي السائب وهو الذي يقال له عبيد بن أبي السائب يذكر بلقبه وينسب إلى جده الأعلى(@)(@@) 1917 وعبيد الله 
ms85	 بن عبيدة البصري التمار عن معتمر بن سليمان PageV02P016(@)(@@) 1918 وعبد الله بن محمد بن إبراهيم الكشوري شيخ للطبراني(@)(@@) 1919 وعبيد الله بن حفص بن عمر البصري شيخ لأبي عروية(@)(@@) 1920 وعبد الله بن صالح بن جرير شيخ لابن جوصا(@)(@@) 1921 وعبد الله بن إسماعيل الهباري شيخ خ(@)(@@) 1922 ومحمد بن محمد بن موسى البزار لقبه عبيد ويقال له(@)(@@) عبيد بن رجال وهو من شيوخ الطبراني ورجال لقب أبيه كما تقدم(@)(@@) 1923 وعبد الله بن عمر بن أحمد بن محمد بن جعفر أبو القاسم الفقسي(@)(@@) 1924 عبيد عتبة(@)(@@) هو عبيد بن صالح بن مسلم المصري PageV02P017(@)(@@) 1925 عبدون(@)(@@) هو عبد الله بن خالد القرقساني(@)(@@) 1926 عبدوس جماعة(@)(@@) منهم عبد الله بن هلال القطان(@)(@@) 1927 وعبد الصمد بن سليمان بن أبي مطر العتكي أبو بكر البلخي(@)(@@) 1928 وعبد الله بن بشر بن شعيب الرازي الطيالسي سمع أبا يوسف القاضي(@)(@@) 1929 وعبد الرحمن بن أحمد بن عباد بن سعيد السراج الهمذاني أبو محمد عن حميد بن الربيع PageV02P018(@)(@@) 1930 وعبد الله بن محمد بن مالك بن هانىء أبو محمد النيسابوري عن قتيبة(@)(@@) 1931 وعبد الرحمن بن موسى الحضرمي عن ابن فضيل(@)(@@) 1932 وعبد الله بن محمد بن حاضر الرازي(@)(@@) 1933 وعبد الله بن روح المدائني(@)(@@) 1934 وعبد الله بن أحمد بن حفص الحيري وولده إبراهيم(@)(@@) 1935 وعبد الوهاب بن إسحاق السراج الهمداني(@)(@@) 1936 وعبد الله بن محمد البندار عن منصور بن عمار(@)(@@) 1937 عبدويه هنا PageV02P019(@)(@@) 1938 العتاب(@)(@@) اسمه سحمه بن نعيم بن الأخنس النبهاني(@)(@@) 1939 عتاهية بن أبي العتاهية هو(@)(@@) محمد بن إسماعيل الشاعر(@)(@@) 1940 عتبة الزاهد المصري اسمه(@)(@@) محمد بن عبد الله كان في وسط المائة الرابعة PageV02P020(@)(@@) 1941 عتريس(@)(@@) وضبطه الشيرازي بفتح أوله وثانيه وتشديد الراء وبعدها السين بغير ياء هو(@)(@@) عبد الله بن حسان العنبري(@)(@@) 1942 عتلة بفتح المهملة والمثناة هو عتبة بن عبد السلمى الصحابي قال ان النبي صلى الله عليه وسلم غير اسمه(@)(@@) 1943 عتيق(@)(@@) هو أبو بكر الصديق PageV02P021(@)(@@) 1944 العتيق 
ms86	(@)(@@) هو إبراهيم بن محمد بن مروان شيخ ابن صاعد(@)(@@) 1945 عثيم بالتصغير(@)(@@) ذكرت عائشة أن النبي صلى الله عليه وسلم خاطب بها عثمان في مرض موته أخرجه أحمد(@)(@@) 1946 عثيم آخر هو(@)(@@) عثمان البغدادي النحوي(@)(@@) 1947 العجاج(@)(@@) الشاعر التميمي المشهور صاحب الرجز اسمه عبد الله بن رؤبة وكنيته أبو الشعثاء PageV02P022(@)(@@) 1948 عجرد(@)(@@) هو حماد بن عبيد بن يونس الشاعر المشهور كان في زمن المهدي وشهرته حماد عجرد هكذا بالإضافة(@)(@@) 1949 عجرة بضم أوله مرداس بن أبي عامر السلمي ذكره المرزبان(@)(@@) 1950 العجل(@)(@@) هو حسين تقدم في عبيد(@)(@@) 1951 والعجل أيضا(@)(@@) لقب محمد بن مروان العقيلي(@)(@@) 1952 ولقب سليمان بن عبد الرحمن بن سليمان اللخمي القرطبي المقرىء ذكره الداني(@)(@@) 1953 عجوة(@)(@@) هو الحسن بن يونس أو ابن يوسف المصري PageV02P023(@)(@@) 1954 عجيل(@)(@@) بالتصغير هو أحمد بن عبد العزيز الكوفي الأطروش يكنى أبا عبد الله وكان مولده بالموصل(@)(@@) 1955 عدوية تقدم في عبدويه(@)(@@) 1956 عرابي(@)(@@) بفتح أوله وبموحدة بلفظ النسب هو محمد بن الحسين بن المبارك سمع يونس بن محمد المؤدب(@)(@@) 1957 العديا(@)(@@) هو محمد بن هلال بن الحصيب اللغوي روى عنه ابن الرقي(@)(@@) 1958 العرق(@)(@@) هو الحسن بن عبد الجبار(@)(@@) 1959 العرنجج PageV02P024(@)(@@) هو حمير بن سبأ جد القبيلة(@)(@@) 1960 العروس(@)(@@) هو حمزة بن مالك بن الهيثم من الأمراء في زمن الرشيد مات سنة إحدى وثمانين ومائة(@)(@@) 1961 عروس الزهاد هو(@)(@@) محمد بن يوسف الأصبهاني(@)(@@) 1962 عروس القراء هو(@)(@@) أبو عبد الله محمد بن يوسف بن معدان بن سليم عن الأعمش(@)(@@) 1963 العرس بفتح أوله اسمه(@)(@@) حسن بن علي بن كنيف المؤذن(@)(@@) 1964 العرية(@)(@@) هو محمد بن أبي الفوارس البغدادي PageV02P025(@)(@@) 1965 العريبة هو(@)(@@) محمد الحمامي جد محمد بن أحمد بن محمد النحوي ذكره ابن نقطة(@)(@@) 1966 العريف(@)(@@) أبو بكر محمد بن علي بن يحيى النحوي(@)(@@) 1967 عزير هو(@)(@@) أحمد بن عبيد الله المعروف بحمار العزير الذي تقدم(@)(@@) 1968 عز الدولة بن بويه(@)(@@) اسمه بختيار(@)(@@) 1969 عز الملك هو(@)(@@) أبو عبد الله محمد بن 
ms87	 عبد الله المسبحي المؤرخ صاحب تاريخ PageV02P026 مصر ويقال له أيضا المختار(@)(@@) 1970 عزيز الدولة صاحب حلب اسمه فاتك(@)(@@) 1971 العزيز لقب جماعة من الملوك(@)(@@) أولهم صاحب مصر وهو نزار بن المعز معد الفاطمي(@)(@@) 1972 عزون(@)(@@) هو عبد العزيز بن محمد بن الفضل الهمداني شيخ الاسماعيلي(@)(@@) 1973 عزوز آخره زاي صاحب تونس في عصرنا الملك المنصور عبد العزيز ابن أبي فارس(@)(@@) 1974 عصا(@)(@@) هو يحيى بن محمد بن سابق المصيصي كان يقال له عصا ابن ادريس لطول ملازمته لعبد الله بن إدريس الكوفي المحدث المشهور PageV02P027(@)(@@) 1975 عصفور الجنة(@)(@@) هو موسى بن قيس الحضرمي عن سلمة بن كهيل(@)(@@) 1976 عصفور الشوك(@)(@@) هو محمد بن دادو الظاهري(@)(@@) 1977 عصفور(@)(@@) هو محمد بن علي بن غنيمة الحريمي البغدادي ذكره ابن النجار(@)(@@) 1978 وفي عصرنا علاء الدين المكتب اشتهر بهذا اللقب وكان ابن فضل الله قرره في توقيع الدست فقالوا ضاع عصفور في الدست(@)(@@) 1979 عصيدة(@)(@@) محمد بن معاوية الزيادي PageV02P028(@)(@@) 1980 عضد الدولة(@)(@@) لقب جماعة من الملوك أولهم فناخسرو أبو شجاع ممدوح المتنبي(@)(@@) 1981 عضب الدولة(@)(@@) من أمراء دمشق اسمه أبق(@)(@@) 1982 عضرس بوزن جعفر هو(@)(@@) العباس بن عبد الله بن محمد العباس الكاتب الحلبي ويسمى سعيدا مات بعد الستمائة(@)(@@) 1983 عطاء لقب لمسدد بن عقاب شيخ يروي عن الأعمش(@)(@@) 1984 عطار المطلقات اثنان(@)(@@) هما عبيد بن إسحاق بن المبارك بن خلف أحد الضعفاء(@)(@@) 1985 والآخر محمد بن عبيد بن عتبة يروي عنه الأصم(@)(@@) 1986 عطار(@)(@@) هو أبو بكر عبد الرحمن بن محمد البهنسي مات سنة ثلاث عشرة وثلاثمائة PageV02P029(@)(@@) 1987 العطار عبد الله بن همام السلولي الشاعر قال المرزباني لقبوه العطار لحسن شعره(@)(@@) 1988 العطرق بتشديد الراء المازني اسمه جرير كان من عمال الحكم بن أيوب الثقفي(@)(@@) 1989 عفيف المسألة(@)(@@) هو مالك بن سنان الخدري والد أبي سعيد الصحابي المشهور قال الجهيمي قيل له ذلك لأنه طوى ثلاثا ولم يسأل(@)(@@) 1990 عفيف بالتشديد بن معدي كرب بن معاوية الكندي عم الأشعث ابن قيس بن معدي 
ms88	 كرب له صحبة قال الطبري كان اسمه شرحبيل(@)(@@) 1991 عقدة(@)(@@) هو محمد بن سعيد الكوفي والد أبي العباس أحمد بن عقدة الحافظ PageV02P030(@)(@@) 1992 عقرب أحد الشعراء المجيدين بالأندلس في أواخر المائة السابعة اسمه محمد بن علي بن محمد بن عبد الملك الأبي(@)(@@) 1993 عقيصا(@)(@@) اسمه دينار يكنى أبا سعيد تابعي(@)(@@) 1994 عكة العسل(@)(@@) هو سعيد بن العاص بن سعيد بن العاص ابن أمية ذكره الزبير(@)(@@) 1995 العكوك(@)(@@) الشاعر اسمه علي بن جبلة بن مسلم في زمن المأمون PageV02P031(@)(@@) 1996 علم الدين كثير جدا(@)(@@) 1997 علم المهتدين(@)(@@) هو الرشيد أحمد بن الزبير الأسواني لقب بذلك لما أرسله الخليفة الفاطمي إلى اليمن بدعوة الفاطميين وكان لونه أسود فكتب بعض أهل اليمن إلى الخلفية(@)(@@) ( بعثت لنا علم المهتدين % ولكنه علم أسود )(@)(@@) قال ابن خلكان فكان ذلك فألا اتفق من هذا الشاعر فما كان بعد قليل حتى دخلت الاعلام السود العباسية من جهة صلاح الدين وملكوا اليمن وأزالوا تلك الدولة(@)(@@) 1998 علم الفضل(@)(@@) اسمه المبارك بن سلامة الكرخي من شعراء الخريدة للعماد الكاتب PageV02P032(@)(@@) 1999 علان لقب جماعة(@)(@@) منهم علي بن عبد الصمد الطيالسي يقال له علان ماغمه(@)(@@) 2000 وعلي بن عبد الله بن موسى القراطيسي عن يزيد بن هارون(@)(@@) 2001 وعلي بن عبد الرحمن بن المغيرة عن سعيد بن أبي مريم(@)(@@) 2002 وعلي بن إبراهيم بن عبد الله الكرجي المعروف بالبلدي(@)(@@) 2003 وعلي بن إبراهيم البغدادي عن يعقوب بن صالح(@)(@@) 2004 وعلي بن محمد بن مهرويه شيخ لإبراهيم ابن أبي بكر PageV02P033 الخباز روى عن عباس الدوري(@)(@@) 2005 وعلي بن الحسن الطيالسي الواعظ عن عباس الدوري(@)(@@) 2006 وعلي بن أحمد بن سليمان المصري البزار شيخ ابن السكن(@)(@@) 2007 وعلي بن الحسين المصري النحوي(@)(@@) 2008 وعلي بن عبدك عن عبد الكريم بن الهيثم(@)(@@) 2009 علوس(@)(@@) هو علي بن أحمد بن مكي الحلاوي أبو الحسن الهمداني عن عبد الرحمن بن حمدان الحلاب(@)(@@) 2010 علون(@)(@@) علي بن حمزة الأنطاكي PageV02P034(@)(@@) 2011 علوان(@)(@@) علي بن إبراهيم المروزي سمع هوذة بن خليفة 
ms89	(@)(@@) 2012 علويه جماعة(@)(@@) منهم الحسن بن علي القطان روى عنه العقيلي وابن ماسي(@)(@@) 2013 وعلي بن حبيب البلخي الفقيه معمر عاش مائة وخمس عشرة سنة(@)(@@) 2014 وعيسى بن عبد الله الطيالسي ذكره ابن حبان(@)(@@) 2015 وعلي بن الحسين بن الفرج البلخي الخلمي سمع ابن عيينة(@)(@@) 2016 وعلي بن عبد الله بن سيف المغني في زمن المأمون مشهور(@)(@@) 2017 وعلي بن إسماعيل بن الحكم البزار البغدادي(@)(@@) 2018 عليك جماعة PageV02P035 منهم علي بن سعيد بن بشير الرازي القاضي(@)(@@) 2019 وعلي بن المظفر البغدادي(@)(@@) 2020 وعلي بن الحسن بن مخلد البخاري أحد الزهاد السيازي بفتح PageV02P036 المهملة بعدها تحتانية خفيفة وبعد الألف زاي كان يقال له عليك الطويل(@)(@@) 2021 عليلة(@)(@@) هو الربيع بن بدر(@)(@@) 2022 علي بالتصغير يقال إنه لقب علي بن رباح وإنه كان يغضب منه(@)(@@) 2023 عمامة(@)(@@) والد ذؤيب بن عمامة اسمه عمرو(@)(@@) 2024 عمامة الشيطان(@)(@@) هو عمران بن عبد العزيز الزهري أبو ثابت(@)(@@) 2025 عمان(@)(@@) علي بن أحمد بن سهل العطار الشاهد الهمداني(@)(@@) 2026 عم العشيرة(@)(@@) هو الفضل بن صالح شيخ الإسماعيلي PageV02P037(@)(@@) 2027 عمر انجه(@)(@@) هو عمران بن زيد بن أشرف الهمداني البخاري يكنى أبا عامر من شيوخ سفيان الثوري روى عن محمد بن سيرين(@)(@@) 2028 عميد الملك الكندري أبو نصر منصور بن محمد وزير طغرلبك السلجوقي(@)(@@) 2029 عميد الجيوش وزير بغداد اسمه محمد PageV02P038(@)(@@) 2030 العميد(@)(@@) لقب جماعة من الوزراء والحسن بن صالح بن علي بن صالح المصري مات سنة أربع وثلاثين وأربعمائة(@)(@@) 2031 عمومه(@)(@@) 3032 عناب(@)(@@) لقب سمحة بن نعيم الشاعر(@)(@@) 2033 عنبر(@)(@@) هو محمد بن خليفة العاقولي أبو جعفر روى عن مسلم بن إبراهيم(@)(@@) 2034 عنس(@)(@@) جد القبيلة هو زيد بن مالك بن أدد بن يشجب PageV02P039(@)(@@) 2035 العنقاء بن عمرو يقال اسمه عبيد(@)(@@) 2036 عنق الفضة(@)(@@) هو محمد بن عيسى الهنتاني الأمير علي رأس الستمائة(@)(@@) 2037 عنكب(@)(@@) هو عبد الله بن محمد بن أحمد الحميري روى عن السرى بن يحيى(@)(@@) 2038 العواد(@)(@@) هو محمد بن عبد الرحمن بن عثمان 
ms90	 الخولاني الزاهد القرطبي مات بعسقلان(@)(@@) 2039 عون(@)(@@) هو الحسين بن محمد الهمداني الشاعر عن زاهر السرخسي(@)(@@) 2040 عون الدين بن هبيرة الوزير اسمه يحيى(@)(@@) 2041 عويرق(@)(@@) هو عويمر بن رواحة PageV02P040(@)(@@) 2042 عويس(@)(@@) هو عيسى بن سالم الشاشي من شيوخ أبي القاسم البغوي وقيل لقبه أبو عويس وسيأتي(@)(@@) 2043 وفي المتأخرين عيسى بن حجاج السعدي الشاعر سمعنا منه(@)(@@) 2044 عويش(@)(@@) قال ابن منده دعا النبي صلى الله عليه وسلم عائشة أم المؤمنين فصغر اسمها قلت وسمعناه في الجزء السابع والعشرين من البشرانيات(@)(@@) 2045 عويمر(@)(@@) أبو الدرداء قيل اسمه عامر كذا ذكره أبو القاسم بن منده في الألقاب وحكاه الفلاس(@)(@@) 2046 عويف القوافي PageV02P041(@)(@@) هو معاوية بن حصن الفرازي(@)(@@) 2047 عوين(@)(@@) هو عون بن عمرو القيسي أبو عمرو العباد أخو رياح عن أنس(@)(@@) 2048 العيار الدمشقي والد سلمة اسمه(@)(@@) أحمد بن حصن بن عبد الرحمن الفزاري ذكره ابن منده PageV02P042(@)(@@) 2049 عيشون اثنان(@)(@@) أحدهما عبد الحميد بن أحمد بن عيسى شيخ لعبد الغني الأزدي(@)(@@) 2050 والآخر اسمه محمد بن سعيد الحراني مولى بني أمية وهو والد عبد الله بن عيشون شيخ أبي عوانة الإسفراييني(@)(@@) 2051 عين الشاة(@)(@@) هو أحمد بن إبراهيم الموصلي روى عن أحمد بن إسحاق الخشاب وعنه نصر العطار الطوسي(@)(@@) 2052 عيينة بالتصغير بن حصن بن حذيفة بن بدر الفزاري اسمه حذيفة فيما قال ابن قتيبة PageV02P043(@)(@@) 2053 عين القضاة الهمداني اسمه(@)(@@) عبد الله بن محمد بن الحسن الميانجي أبو المعالي بن أبي بكر وكان شافعيا هو وأبوه قتل في أول المائة السادسة PageV02P044(@)(@@) | - * حرف الغين المعجمة(@)(@@) - *(@)(@@) | يبدأ برقم 2054 وينتهي برقم 2113(@)(@@) PageV02P045(@)(@@) | - * حرف الغين المعمجمة(@)(@@) - *(@)(@@) 2054 الغالب بالله(@)(@@) هو إسماعيل بن الأحمر صاحب الأندلس(@)(@@) 2055 الغاوي الصقلي(@)(@@) هو حبيش بن راد من شعراء الخريدة في المائة الخامسة(@)(@@) 2056 غباب بموحدتين الأولى خفيفة(@)(@@) هو ثعلبة بن الحارث بن تيم الله جاهلي(@)(@@) 2057 غثكل(@)(@@) بمعجمة ثم مثلثة بوزن جعفر الفرغاني اسمه بركة بن نشيط كان من الحفاظ يروي عن الحسن بن عرفة وغيره(@)(@@) 2058 وسعيد 
ms91	 بن عد الله يعرف بغثكل أيضا روى عنه أحمد بن مروان الدينوري PageV02P047(@)(@@) 2059 غدر(@)(@@) بضم أوله وفتح المهملة ثم راء قالها النبي صلى الله عليه وسلم للنعمان بن بشير ولعبد الله بن بسر من حديث كل منهما(@)(@@) 2060 غراب البين(@)(@@) هو إبراهيم بن عوفي أمير اليمامة أيام بني مروان(@)(@@) 2061 غراب اثنان(@)(@@) هما محمد بن سالم شيخ لعبدان سمع من الأصمعي(@)(@@) 2062 وعبد العزيز والد علي(@)(@@) 2063 الغريض المغني المشهور في دولة بني أمية اسمه عبد الملك ويكنى أبا زياد PageV02P048(@)(@@) 2064 غرنوق(@)(@@) هو محمد بن يحيى بن صبيح(@)(@@) 2065 الغريب بالتثقيل(@)(@@) هو معاوية بن حذيفة بن بدر الفزاري(@)(@@) 2066 غريق الجحفة(@)(@@) هو حماد بن عيسى(@)(@@) 2067 غرير بالتصغير(@)(@@) هو عبد الرحمن بن المغيرة بن حميد بن عبد الرحمن بن عوف المدني وهو والد إسحاق بن غرير الذي كان مع المهدي(@)(@@) 2068 ومحمد بن غرير شيخ البخاري PageV02P049(@)(@@) 2069 غرير بوزن عظيم(@)(@@) هو عبد العزيز بن عبد الله يروي عن الأنباري ذكره عبد الغني ابن سعيد في المشتبه(@)(@@) 2070 الغزال بالتشديد واصل بن عطاء رأس الاعتزال ويقال إنه قيل له ذلك لأنه كان يجلس إلى النساء اللواتي يغزلن(@)(@@) 2071 ومحمد بن عبد الملك بن زنجويه(@)(@@) 2072 وبالتخفيف أبو بكر محمد بن علي بن موسى الشريشي المقرىء المعروف بالغزال مات سنة 658(@)(@@) 2073 غسان(@)(@@) هو محمد بن عبد الله بن محمد بن يوسف العبدي القارقي إمام PageV02P050 الجامع روى عنه أبو ظهير البلخي(@)(@@) 2074 غسال الأكسية(@)(@@) هو أبو عمرو تلميذ حاتم الأصم الزاهد(@)(@@) 2075 الغضيض بمعجمات(@)(@@) هو محمد بن يوسف البغدادي شيخ مطين(@)(@@) 2076 الغطريف الجمحي(@)(@@) هو أمية بن خلف ذكره الزبير بن بكار(@)(@@) 2077 الغلط(@)(@@) هو أبو القاسم أحمد بن جعفر بن أحمد المقري(@)(@@) 2078 غلام السجادة(@)(@@) هو إبراهيم بن حماد المقرىء أخذ عن الترمذي PageV02P051(@)(@@) 2079 غلام سجادة آخر اسمه جعفر(@)(@@) 2080 غلام خليل(@)(@@) هو أحمد بن محمد بن غالب البصري الزاهد وكان شديد الضعف في الحديث(@)(@@) 2081 غلام رجب(@)(@@) هو المظفر بن 
ms92	 نظيف سمع المحاملي(@)(@@) 2082 غلام طالوت(@)(@@) هو محمد بن علي البصري الصيرفي شيخ ابن حبان(@)(@@) 2083 غلام الفرس يأتي في الفاء(@)(@@) 2084 غلام ابن مجاهد PageV02P051(@)(@@) هو محمد بن غريب البزار(@)(@@) 2085 غلام المصري(@)(@@) هو علي بن أحمد بن فروخ البغدادي(@)(@@) 2086 غلام زحل(@)(@@) هو أبو القاسم قال ابن ماكولا كان حاذقا في التنجيم(@)(@@) 2087 غلام ثعلب(@)(@@) هو أبو عمر محمد بن عبد الواحد الغوي(@)(@@) 2088 غلام بن شنبوذ(@)(@@) هو أبو الفرج محمد بن أحمد بن الشنبوذي المقرىء PageV02P053(@)(@@) 2089 غلام السباك(@)(@@) هو أبو بكر أحمد بن عثمان بن الفضل الربعي المقرىء(@)(@@) 2090 غلام الرأس(@)(@@) هو أبو علي الحسن بن القاسم المقرىء المشهور(@)(@@) 2091 غلام كيني(@)(@@) هو يوسف بن المظفر بن فاخر(@)(@@) 2092 غلام البكري(@)(@@) هو الحكم بن محمد من شعراء القلائد والذخيرة(@)(@@) 2093 غلام التبريزي(@)(@@) هو حمار بكير PageV02P054(@)(@@) 2094 غلام ابن المني(@)(@@) هو إسماعيل بن علي بن الحسين الفقيه الأصولي مات سنة عشر وستمائة PageV02P055(@)(@@) 2095 غلام جالان(@)(@@) هو إبراهيم بن إسحاق البغدادي عن خلف بن هشام(@)(@@) 2096 الغميصاء(@)(@@) هي أم حرام بنت ملحان الصحابية(@)(@@) 2097 غنجار اثنان(@)(@@) أحدهما عيسى بن موسى التميمي البخاري يكنى أبا أحمد علق له البخاري PageV02P056(@)(@@) 2098 والثاني محمد بن أحمد البخاري صاحب تاريخ بخارى(@)(@@) 2099 غنيمة(@)(@@) هو عبد الرحمن بن جامع أبو الغنائم بن البناء الحنبلي(@)(@@) 2100 غنثر(@)(@@) قالها أبو بكر الصديق لابنه عبد الرحمن(@)(@@) 2101 غندر جماعة PageV02P057(@)(@@) أولهم محمد بن جعفر البصري صاحب شعبة لقبه بذلك ابن جريج لأنه لماحدث بالبصرة صار غندر يشغب عليه فقال له أنت غندر قاله ابن عائشة قال وأهل الحجاز يقولون للمشغب غندر وقال أبو عمر غلام ثعلب الغندر الصبيح(@)(@@) 2102 الثاني محمد بن جعفر بن دران أبو الطيب الوراق البغدادي نزيل مصر وحدث عن أبي يعلى(@)(@@) 2103 الثالث محمد بن جعفر بغدادي يروي عن المعمري وأظنه الذي مات بمرو واسم جده الحسين وقال أبو نعيم في تاريخ أصبهان حدثنا أبو بكر محمد بن جعفر بن الحسين بن الوراق غندر البغدادي 
ms93	 قدم علينا ثم خرج إلى خراسان فمات بها بعد الستين PageV02P058(@)(@@) 2104 الرابع محمد بن جعفر مولى فاتن المقتدري(@)(@@) 2105 الخامس محمد بن جعفر الوراق حدث عن ابن صاعد(@)(@@) 2106 السادس محمد بن جعفر بن العباس النجاري(@)(@@) 2107 السابع محمد بن المهلب الحراني ضعفه ابن عدي(@)(@@) 2108 الثامن محمد بن جعفر بن عبد الرحمن الرازي أبو الحسين نزيل طبرستان روى عن أبي حاتم الرازي(@)(@@) 2109 التاسع محمد بن يوسف بن بشر الهروي(@)(@@) 2110 العاشر أحمد بن محمد بن عيسى البلوي أبو بكر بن الميراثي من أهل قرطبة له رحلة ذكره ابن الفرضي وحدث عنه أبو العباس العذري(@)(@@) 2111 الحادي عشر أحمد بن آدم شيخ لأحمد بن محمد بن الحجاج ابن رشدين PageV02P059(@)(@@) 2112 غورك(@)(@@) هو أبان بن أبي الحصين(@)(@@) 2113 الغول(@)(@@) هو عبد العزيز بن يحيى المكي المتكلم صاحب كتاب الحيدة PageV02P060(@)(@@) | - * حرف الفاء(@)(@@) - *(@)(@@) | يبدأ برقم 2114 وينتهي برقم 2194(@)(@@) PageV02P061(@)(@@) | - * حرف الفاء(@)(@@) - *(@)(@@) 2114 الفاخر اسمه حاتم روى عن الثوري(@)(@@) 2115 فارس حليمة الحيرة(@)(@@) هو النعمان بن المنذر صاحب الحيرة(@)(@@) 2116 فارس البطحاء(@)(@@) هشام بن المغيرة بن عبد الله بن عمرو بن مخزوم جاهلي وهو والد أبي جهل(@)(@@) 2117 فارس الجوا(@)(@@) هو بشير بن عبد الله بن زيد الأنصاري الظفري والجوا فرس له PageV02P063(@)(@@) 2118 فارس العرقة(@)(@@) زهير بن مسعود بن سليمان بن ربيعة الضبي ذكره المرزباني في معجم الشعراء(@)(@@) 2119 فارس النعامة(@)(@@) هو الحارث بن عباد بن ضبيعة(@)(@@) 2120 الفاروق أمير المؤمنين عمر رضي الله عنه(@)(@@) 2121 الفاضل(@)(@@) عبد الرحيم بن علي البيساني صاحب الأنشا البارع لقب PageV02P064 القاضي الفاضل في الدولة الفاطمية وكان الخليفة هو الذي يأذن في التلقيب فالتمس المذكور أن يزاد في ألقابه الأجل فأجيب لذلك فصار يقال القاضي الأجل الفاضل ثم اختصروا الأجل(@)(@@) 2122 فاضل لقب إسماعيل بن محمد بن القاسم الأصبهاني(@)(@@) 2123 فاضلين(@)(@@) هو عمر بن علي بن أحمد البحيري بالمهملة يروي عن إسماعيل ابن الحسن الفرائضي(@)(@@) 2124 الفأفأ جماعة منهم(@)(@@) بشر بن أبي علي الحمال(@)(@@) 2125 وخالد بن سلمة 
ms94	 المخزومي يروي عن مجاهد(@)(@@) 2126 وأحمد بن محمد بن الحسن البغدادي(@)(@@) 2127 وعمر بن يزيد عن أبي إسحاق السبيعي(@)(@@) 2128 وأشرف بن هاشم متأخر مات سنة ستمائة PageV02P065(@)(@@) 2129 فافا اثنان(@)(@@) محمد بن زياد(@)(@@) 2130 وبشر بن أبي علي الحمال(@)(@@) 2131 فافاه(@)(@@) هو أبو معاوية الضرير محمد بن خازم(@)(@@) 2132 وإسماعيل بن مسلم السكوني يقال له أيضا فافاه(@)(@@) 2133 فايت هو محمد بن عبيدة البخاري عن المسندي PageV02P066(@)(@@) 2134 الفائز الخليفة(@)(@@) هو عيسى الفاطمي(@)(@@) 2135 فتيلة(@)(@@) هو بشر بن مبشر الواسطي عن الحكم بن فصيل(@)(@@) 2136 الفجاءة التميمي الذي حرق في زمن أبي بكر الصديق رضي الله عنه بالنار لكونه وجد ينكح في دبره اسمه بحير بن إياس(@)(@@) 2137 الفحل(@)(@@) هو تميم بن إسماعيل أمير دمشق(@)(@@) 2138 الفراء(@)(@@) لقب جماعة منهم(@)(@@) يحي بن زياد اللغوي الكوفي قالوا قيل له ذلك لأنه كان يفري الكلام فريا(@)(@@) 2139 وإبراهيم بن موسى الرازي شيخ البخاري وغيرهما(@)(@@) 2140 فرخوية اثنان(@)(@@) أحمد بن ثابت عن عبد الرزاق PageV02P067(@)(@@) 2141 وعبد الله بن سليمان الرازي(@)(@@) 2142 الفرخ(@)(@@) هو حفص بن عمر العدني(@)(@@) 2143 فرقس(@)(@@) هو جعفر المقرىء قرأ عليه عكرمة بن علان(@)(@@) 2144 فريخ(@)(@@) هو أزهر بن مروان(@)(@@) 2145 فريخ الصوفي(@)(@@) هو فرخ بن إبراهيم النصيبي شيخ لتمام الرازي(@)(@@) 2146 الفرزدق(@)(@@) الشاعر التميمي اسمه همام بن غالب(@)(@@) 2147 الفرد(@)(@@) هو حفص المتكلم PageV02P068(@)(@@) 2148 فروخ(@)(@@) قاله علي بن أبي طالب لأبي مسعود البدري(@)(@@) 2149 وهو لقب موسى بن محمد الرازي(@)(@@) 2150 فروجه هما(@)(@@) محمد بن أحمد بن الهيثم المصري(@)(@@) 2151 ومحمد بن صالح البصري(@)(@@) 2152 الفرس(@)(@@) لقب خلف بن إسحاق بن محمد بن إسحاق القيرواني من العلماء أصحاب الفنون ببلده مات سنة سبع وخمسين وثلاثمائة(@)(@@) 2153 ومحمد الداني يلقب الفرس وكان محمد بن الحسن بن سعيد الفضل الأندلسي المعروف بابن غلام الفرس كان جده سعيد مولى الداني المذكور فقيل له غلام الفرس PageV02P069(@)(@@) 2154 فرير بوزن عظيم بن عنين اسمه(@)(@@) عثمان وهو عم بحتر القبيلة المشهورة من طيء قال ابن الكلبي 
ms95	 لقب بذلك لحسن عينيه(@)(@@) 2155 الفزر(@)(@@) اسمه خالد تابعي يروي عن أنس(@)(@@) 2156 وهو لقب سعد بن زيد مناة بن تميم جد القبيلة المشهورة ذكره الزبير عن محمد بن سلام(@)(@@) 2157 فستقة(@)(@@) هو محمد بن علي بن الفضل المديني شيخ الطبراني وليس هو ولد علي بن المديني شيخ البخاري(@)(@@) 2158 الفصيح الشاعر محمد بن منير البغدادي مات سنة سبع وثلاثين وستمائة بدمشق PageV02P070(@)(@@) 2159 فضلك هو الفضل بن العباس الرازي(@)(@@) 2160 فضلان اثنان(@)(@@) هما الفصل بن محمد بن عقيل النيسابوري(@)(@@) 2161 والفضل بن مخلد المقري قرأ على الطيب بن إسماعيل بن حمدون(@)(@@) 2162 وفضل الكتاب(@)(@@) هو محمد بن عمر القاضي الشاعر كان بعد الستمائة(@)(@@) 2163 فطورا(@)(@@) هو محمد بن عمر الصيرفي كوفي PageV02P071(@)(@@) 2164 فطيس(@)(@@) هو محمد بن يحيى الأندلسي(@)(@@) 2165 فقاعة(@)(@@) هو محمد بن أحمد النحاس(@)(@@) 2166 فقحة العلم(@)(@@) جعفر بن بشير الكوفي روى عن علي بن موسى الرضا(@)(@@) 2167 الفقير(@)(@@) هو يزيد بن صهيب كان يشكو فقار ظهره(@)(@@) 2168 ولقب به(@)(@@) عبد الله بن مسلم الباهلي أخو قتيبة أمير خراسان(@)(@@) 2169 فقيقيعة(@)(@@) هو إسحاق بن إبراهيم بن نصر الجلاب PageV02P072(@)(@@) 2170 الفكيك بضم الفاء مصغرا شاعر اسمه(@)(@@) علي بن عبد العزيز الحلبي(@)(@@) 2171 الفلاس(@)(@@) هو عمرو بن علي الصيرفي قال ابن أبي خيثمة سمعته يقول روى عنى عفان حديثين فلم يقم خيره بشره قال حدثني أبو حفص الفلاس فعرفت بها ولم أكن فلاسا قط(@)(@@) 2172 فليح(@)(@@) هو عبد الملك بن سليمان من رجال الصحيح(@)(@@) 2173 فليت بن خليفة اسمه(@)(@@) أفلت(@)(@@) 2174 ومثله أبو بكر بن محمد بن عمرو عن الهيثم ابن خالد PageV02P073(@)(@@) 2175 الفند الزماني الفارس المشهور جاهلي اسمه(@)(@@) شهل بالشين المعجمة وليس في العرب من يقال له شهل بالمعجمة غيره وهو ابن شيبان بن ربيعة بن نزار(@)(@@) 2176 فندق(@)(@@) هو أبو الحسن ابن أبي القاسم البيهقي له تصانيف أدبية كان بعد الخمسمائة(@)(@@) 2177 فورجة(@)(@@) هو محمود بن عبد الكريم الأصبهاني(@)(@@) 2178 فورجة ويقال بموحدة أوله(@)(@@) سعيد بن يحيى الأصبهاني(@)(@@) 2179 
ms96	 فور(@)(@@) هو محمد بن الفضل روى عن غندر(@)(@@) 2180 فهد بن عوف اسمه زيد PageV02P074(@)(@@) 2181 فهير(@)(@@) هو يحيى بن زياد الرقي(@)(@@) 2182 ومثله فهر بن نصر أبو أحمد الرقي يلقب أيضا بالتصغير(@)(@@) 2183 فويري الطبيب اسمه إبراهيم(@)(@@) 2184 فوران(@)(@@) هو عبد الله بن محمد بن المهلب أبو جعفر يروي عن أبي معاوية وطبقته(@)(@@) 2185 فورك(@)(@@) إبراهيم بن ناصح الأصبهاني عن ابن عيينة(@)(@@) 2186 الفيحة(@)(@@) اسمه إبراهيم بن إسماعيل الحراني مات سنة اثنين وعشرين وستمائة وله شعر(@)(@@) 2187 فورويه(@)(@@) هو ناصح بن المعلى الأصبهاني PageV02P075(@)(@@) 2188 الفويره بكسر الراء تصغير فاره(@)(@@) هو عبد الرحمن بن عبد اللطيف بن وريدة مسند بغداد في عصره مات سنة سبع وتسعين وستمائة(@)(@@) 2189 فيل السنة(@)(@@) بيض له ابن منده(@)(@@) 2190 الفياض اثنان(@)(@@) طلحة بن عبيد الله الصحابي(@)(@@) 2191 وعيسى بن محمد بن القاسم ابن الحسن بن زيد بن الحسن بن علي بن أبي طالب(@)(@@) 2192 الفيل(@)(@@) هو عنبسة بن معدان النحوي قديم أخذ عن أبي الأسود الديلي PageV02P076(@)(@@) 2193 ولقب بها(@)(@@) أحمد بن محمد بن حميد البغدادي المقرىء(@)(@@) 2194 والفيل أيضا(@)(@@) لقب بعض الأمويين أنشد الجاحظ لبعض الشعراء(@)(@@) ( وجاءت قريش قريش البطاح % هي العصب الأول الراحلة )(@)(@@) ( يقودهم الفيل والزندبيل % وذو الضرس والشفة المائلة )(@)(@@) قال الفيل والزندبيل أبان والحكم ابنا عبد الملك بن بشر بن مروان بن الحكم(@)(@@) وذو الضرس والشفة المائلة هما خالد بن سلمة المخزومي وكان خطيب قريش في زمانه PageV02P077(@)(@@) | - * حرف القاف(@)(@@) - *(@)(@@) | يبدأ برقم 2195 وينتهي برقم 2320(@)(@@) PageV02P079(@)(@@) | - * حرف القاف(@)(@@) - *(@)(@@) 2195 القادر بالله(@)(@@) الخليفة العباسي هو أحمد بن إسحاق بن المقتدر(@)(@@) 2196 قاضي المصرين(@)(@@) هو شريح بن الحارث الكندي(@)(@@) 2197 قاتل الجوع(@)(@@) هو امرؤ القيس بن كعب(@)(@@) 2198 قارط(@)(@@) هو خالد روى عن وهب بن منبه PageV02P081(@)(@@) 2199 قاضي البقر(@)(@@) هو سعيد بن عبد الرحمن الشيباني كان شاعرا بمصر مات سنة ثلاثين وثلاثمائة(@)(@@) 2200 قاضي الجن(@)(@@) هو محمد بن عبد الله بن علاثة(@)(@@) 2201 وفي عصرنا شمس الدين بن البرددار الحلبي(@)(@@) 2202 القاضي هو أبو جعفر محمد 
ms97	 بن علي الزينبي الجعفري كان يلقب بذلك ولم يل القضاء قط ذكره عبد الغني بن سعيد في أخبار القاضي أبي الظاهر الذهلي وذكر له معه حكاية(@)(@@) 2203 قاضي الدجاج(@)(@@) أحمد بن عمر بن علي البغدادي أبو الحسين شيخ للخطيب PageV02P082(@)(@@) 2204 قاضي الطراف(@)(@@) اسمه عبد الله بن محمد البصري شاعر روى عنه أبو عبد الرحمن السلمي الصوفي(@)(@@) 2205 قاضي خان الحنفي صاحب الفتاوي اسمه(@)(@@) الحسن بن منصور بن محمود يكنى أبا المحاسن ويلقب فخر الدين كان في أواخر المائة السادسة(@)(@@) 2206 قارة(@)(@@) لقب بني الهون بن خزيمة بن مدركة(@)(@@) 2207 قاسان(@)(@@) هو عبد الله بن عبد العزيز البرذعي(@)(@@) 2208 قاسون هو القاسم بن محمد بن موسى الفقيه من طبقة أبي يعلى الموصلي PageV02P083(@)(@@) 2209 قالون(@)(@@) هو عيسى بن ميناء المدني المقرىء(@)(@@) 2210 القاهر العباسي الخليفة(@)(@@) هو أبو منصور بن المعتضد(@)(@@) 2211 القائم بأمر الله(@)(@@) هو عبد الله بن القادر العباسي(@)(@@) 2212 القائم الفاطمي(@)(@@) هو ابن المهدي ثاني خلفائهم بالمغرب(@)(@@) 2213 القباع(@)(@@) بضم أوله وتخفيف الموحدة هو الحارث بن عبد الله ابن أبي ربيعة المخزومي أمير العراق في عهد ابن الزبير(@)(@@) 2214 قباث PageV02P084(@)(@@) هو عمر بن حفص بن قباث بن حكيم الأسدي البلخي سمع إسحاق بن راهويه(@)(@@) 2215 قبة الديباج(@)(@@) لقب البيضاء بنت عبد المطلب عمة النبي صلى الله عليه وسلم ذكرها المبرد في الكامل وقيل لقب أختها برة وقيل لقب عمها خالد بن هاشم(@)(@@) 2216 قبيطة(@)(@@) هو الحسن بن سليمان الفزاري أحد الحفاظ(@)(@@) 2217 ومثله الحسين بن إبراهيم يروي عن عبد الله بن يوسف التنيسي(@)(@@) 2218 قتيبة بن سعيد يقال(@)(@@) اسمه يحيى وقتيبة لقب PageV02P085(@)(@@) 2219 القتال الشاعر(@)(@@) هو عبد الله وقيل عبيد بن المضرحي بن عامر الكلابي مخضرم(@)(@@) 2220 قتيل الهوى الشاعر(@)(@@) هو المؤمل بن جميل(@)(@@) 2221 قحف العلم(@)(@@) هو الحسن بن علي بن عمرو الزنجاني(@)(@@) 2222 قديدة هو(@)(@@) أبو الفتح موسى بن جعفر بن محمد البزار مات سنة خمس وتسعين ومائتين PageV02P086(@)(@@) 2223 قذار(@)(@@) هو أبو العباس محمد بن علي بن عبد 
ms98	 الله بن عبد الله بن الحسن ابن جعفر بن الحسن بن الحسن بن علي بن أبي طالب الحسيني العلوي لقب بذلك لنظافته من الأضداد(@)(@@) 2224 قديم(@)(@@) خاطب بها النبي صلى الله عليه وسلم المقدام بن معدي كرب(@)(@@) 2225 القراء بلفظ جمع قارىء(@)(@@) هو لقب عبد الله بن عبد الرحمن بن هارون الأصبهاني(@)(@@) 2226 قرابة بن شريك شيخ يروى عن سعيد بن سلام اسمه إبراهيم بن محمد الأصبهاني ذكره أبو نعيم PageV02P087(@)(@@) 2227 قراد(@)(@@) هو أبو نوح عبد الرحمن بن غزوان من شيوخ أحمد بن حنبل(@)(@@) 2228 ومثله موسى بن الحسين البغدادي(@)(@@) 2229 قرام(@)(@@) اسمه محمد(@)(@@) 2230 قربة أبو جعفر أحمد بن محمد الشاعر(@)(@@) 2231 قرد باسم الحيوان المعروف(@)(@@) لقب عمرو بن معاوية بن تميم بن سعد بن هذيل وهو الذي يضرب به المثل في الزنا فيقال أزني من قرد وله في الأمثال للزمخشري خبر أشرت إليه في تبصير المنتبه في تحرير المشتبه(@)(@@) 2232 قرطمة(@)(@@) هو أبو عبد الله محمد بن علي الحافظ(@)(@@) 2233 قرطم(@)(@@) هو جعفر بن أحمد العلوي المصري نزيل حلب قبل الستمائة PageV02P088(@)(@@) 2234 القرظ(@)(@@) هو سعد بن عائد المعروف المؤذن الصحابي(@)(@@) 2235 قرفة(@)(@@) هو العباس بن الفضل بن أبي روح الرازي(@)(@@) 2236 قرقرة جماعة(@)(@@) منهم أحمد بن يحي بن صفوان الأنطاكي(@)(@@) 2237 وعباس بن الفضل الراداني ويقال له قرقورة(@)(@@) 2238 قرقور بلا هاء اسمه(@)(@@) علي بن الحسن بن علي بن المثنى(@)(@@) 2238 قرمطة ويقال قرطمة(@)(@@) وراق سفيان بن وكيع اسمه محمد بن عبيد الله الوراق(@)(@@) 0000 قرير(@)(@@) بوزن عظيم بن عنين اسمه عثمان وهو عم بحتر القبيلة المشهورة من طي قال ابن الكلبي لقب بذلك لحسن عينيه PageV02P089(@)(@@) 2240 قرة بن عبد الرحمن يقال(@)(@@) اسمه يحي وقرة لقب(@)(@@) 2241 قريق اسمه(@)(@@) العباس بن إسماعيل الهاشمي(@)(@@) 2242 القزاز(@)(@@) هو إبراهيم بن بان الزاهد الأندلسي لقب بذلك(@)(@@) وأما من هي صناعته فكثير(@)(@@) 2243 قريش جد القبيلة اسمه(@)(@@) فهر بن مالك وقيل النضر بن كنانة ويقال غير ذلك والأول أشهر PageV02P090(@)(@@) 2244 القسط بضم 
ms99	 أوله(@)(@@) إسماعيل بن عبد الله بن قسطنطين المقرىء(@)(@@) 2245 القس هو(@)(@@) عبد الرحمن المدني صاحب سلامة القس(@)(@@) 2246 القسيس(@)(@@) هو أبو الربيع سليمان بن أبي داود الأفطس(@)(@@) 2247 قسي بن منبه(@)(@@) هو ثقيف جد القبيلة واسمه عمرو(@)(@@) 2248 قسيم الدولة هو زنكي(@)(@@) 2249 قشمرد PageV02P091(@)(@@) هو محمد بن عمرو بن النضر النيسابوري الحافظ ويقال له كشمرد بالكاف(@)(@@) 2250 القصار(@)(@@) هو إبراهيم بن عبد الله العبسي الكوفي خاتمة أصحاب وكيع بن الجراح(@)(@@) 2251 ولقب بها أيضا إبراهيم بن عبد الله بن إسحاق الأصبهاني شيخ الحاكم وقال كان يغسل الموتى احتسابا(@)(@@) 2252 وحكم الوادي المغني قيل له ذلك لأنه كان يقصر الشعر بالتلحين(@)(@@) 2253 وعلي بن عمرو العباسي الرازي(@)(@@) 2254 القصاب(@)(@@) محمد بن علي بن محمد الحافظ أبو أحمد الكوفي لقب بذلك لكثرة ما قتل من الكفار في الجهاد وكان شجاعا PageV02P092(@)(@@) 2255 القصير جماعة منهم(@)(@@) عمران بن مسلم البصري(@)(@@) 2256 وربيعة بن يزيد الدمشقي(@)(@@) 2257 والمثنى بن سعيد الضبعي(@)(@@) 2258 قصي جد هاشم بن عبد مناف ويقال(@)(@@) اسمه زيد(@)(@@) 2259 والمغيرة بن عبد الرحمن الحزامي لقبه قصي(@)(@@) 2260 قضي وقضيضي(@)(@@) لقب عمر بن عبد الرحمن بن أسد PageV02P093(@)(@@) 2261 قضيب البان(@)(@@) أحد من يعتقد اسمه(@)(@@) 2262 القطاس(@)(@@) هو سعيد بن زياد مصري مات سنة خمس وعشرين ومائتين(@)(@@) 2263 القطب(@)(@@) موسى بن هارون الشيباني بصري في أيام الرشيد(@)(@@) ومن يلقب قطب الدين كثير في المتأخرين(@)(@@) 2264 قطب السخاء(@)(@@) هو عبد الله بن جعفر بن أبي طالب قاله ابن حبان(@)(@@) 2265 قطامي(@)(@@) والدشرقي اسمه حصين(@)(@@) 2266 قطاة(@)(@@) اسمه محمد بن علي البغدادي(@)(@@) 2267 قطنة بنون اثنان(@)(@@) أحدهما ثابت بن كعب بن جابر بن كعب الخزاعي العتكي PageV02P094 الشاعر يقال له ثابت قطنة لقطنة كانت على عينه(@)(@@) 2268 والآخر(@)(@@) محمد بن القاسم بن سهل الصندوقي من شيوخ حمزة الكناني(@)(@@) 2269 قطينة بالتصغير(@)(@@) هو عبد الوهاب بن بزغش البغدادي بعد الستمائة(@)(@@) 2270 قطرب اللغوي(@)(@@) هو محمد بن المستنير البصري(@)(@@) 2271 القط(@)(@@) اسمه عبد الرحمن بن محمد الطبيب بعد الستمائة 
ms100	 وكان له شعر PageV02P095(@)(@@) 2272 قطوة(@)(@@) هو أبو نصر أحمد بن علي بن صالح بن مسلم مولى قريش(@)(@@) 2273 قطيط(@)(@@) هو محمد بن الحسين بن محمد الشيباني أبو الفتح يروي عن ابن شاهين(@)(@@) 2274 القعقاع اليشكري هو(@)(@@) عمرو بن النار(@)(@@) 2275 قعيس بالتصغير هو(@)(@@) إبراهيم بن إسماعيل المدني PageV02P096(@)(@@) 2276 قعيقيعة(@)(@@) اسمه إسحاق بن إبراهيم بن موسى بن نصير المصري الحلاب مات سنة ثمان وتسعين ومائتين ذكره ابن يونس(@)(@@) 2277 القفار السلمي(@)(@@) اسمه خالد بن عامر(@)(@@) 2278 قفيز(@)(@@) هو عبد الملك بن عبد الله بن عامر بن كريز(@)(@@) 2279 القفال(@)(@@) لقب يوسف بن علي القضاعي الآمدي كان يكثر حمل الأقفال فقيل له ذلك PageV02P097(@)(@@) 2280 القفل(@)(@@) هو علي بن الحسن بن إبراهيم الحلبي من شيوخ تمام الرازي(@)(@@) 2281 قلا بتخفيف اللام هو(@)(@@) محمد بن أحمد بن محمد الأصبهاني عن الحداد(@)(@@) 2282 قلانس(@)(@@) هو إبراهيم بن عبيد الله كان بعد الثلاثمائة بمصر(@)(@@) 2283 قلايا(@)(@@) هو أيوب بن صالح من الرواة عن مالك PageV02P098(@)(@@) 2284 القليقل(@)(@@) اسمه محمد بن إبراهيم الجذامي كان قاضي جيان مات بعد الأربعين وخمسمائة(@)(@@) 2285 قلب آخره موحدة(@)(@@) هو أيوب بن محمد الهاشمي(@)(@@) 2286 قلنسوة هو إبراهيم بن زيد المصري كان على رأس الثلاثمائة(@)(@@) 2287 قلوص(@)(@@) هو محمد بن أبي مالك الكاتب المعمر(@)(@@) 2288 القلوص(@)(@@) لقب محمد بن أبي مالك الفهري ذكره ابن الزبير في أواخر كتاب النسب وقال انه هو وقصي بن كلاب في التعدد إلى فهر بن مالك سواء PageV02P099(@)(@@) ومات محمد بن أبي مالك بعد أن مضى صدر من دولة بني العباس(@)(@@) 2289 قلوبا(@)(@@) هو أبو عبد الرحمن يروي عن شريك(@)(@@) 2290 القلاح(@)(@@) هو ربيعة بن العجم جاهلي(@)(@@) 2291 قمر(@)(@@) هو عبد الله بن شيبة بن عقبة الأزدي(@)(@@) 2292 قمر نجد(@)(@@) هو الزبرقان بن بدر الصحابي PageV02P100(@)(@@) 2293 قمر العراق(@)(@@) هو مسعود بن عمرو الأزدي(@)(@@) 2294 قمطر(@)(@@) هو محمد بن موسى بن حماد البربري(@)(@@) 2295 قمعة بن إلياس بن مضر اسمه(@)(@@) عمير(@)(@@) 2296 القمع(@)(@@) هو أبو بكر محمد بن إسحاق(@)(@@) 2297 