ms721	 وأعيا أن يبل سقيم % 35(@)(@@) % رأى بك ركن الدين بلجة شمسه % % غناء ويوم الناظرين مغيم % 36(@)(@@) % فأغمد قوما وانتضاك بصيرة % بما ينتضي من صارم ويشيم % 37(@)(@@) % وأعطاك ما لا يأتلي الظن يرتمي % % غلوا ولا مغلي الرجاء يسوم % 38(@)(@@) % كرائم من سر الملوك مصونة % لها منك كفء في الرجال كريم % 39(@)(@@) % فمحبوكة حبك السماء وسيعة % لها من أديم الباقيات أديم % 40(@)(@@) % تفرد منها كل لون بشعبة % من القلب تصبو نحوه وتهيم % PageV01P2262 41(@)(@@) % كأن أخاك الغيث ولي نسجها % % فزهرته وسم لها ورقوم % 42(@)(@@) % تكاثف جنباها فلو خف حملها % % من التبر خلناها عليك تقوم % 43(@)(@@) % ومترفة للريح رقة جسمها % % ومنشؤها بالقريتين جسيم % 44(@)(@@) % طغى طرفاها واستكان وسيطها % % خضوعا فمنها وابل وعميم % 45(@)(@@) % تضور من ثقل النضار كأنها % % بما سال في الخدين منه أميم % 46(@)(@@) % هي التاج لولا أن تسمى عمامة % مجازا ومسميها بذاك ظلوم % 47(@)(@@) % ومرصوعة بالدر في موضع الحبى % % لها السيف ضوء والنجاد قسيم % 48(@)(@@) % يروع العدا ما راق منها كأنها % % نجوم بها قلب العدو رجيم % 49(@)(@@) % تنطقتها حليا وقلدت فوقها % % صقيلا يريك البشر وهو شتيم % 50(@)(@@) % جرازا يصيح الموت من شفراته % % ويرجو قضاء الدين وهو غريم % PageV01P2263 51(@)(@@) % وهيف تطاريف الدماء خضابها % % وضافي كساها أعظم ولحوم % 52(@)(@@) % إذا فرجت بين الأصابع غادرت % جوانف لا يبنى لهن هديم % 53(@)(@@) % تناط بمثل الشمس لونا وصبغة % يقيك الردى منها أصك لحيم % 54(@)(@@) % وأم بنين استبطنتهم فصدرها % % غصيص بهم عند الحضان كظيم % 55(@)(@@) % يعقونها بالضغط وهي عليهم % عطوف بدرات الرضاع رءوم % 56(@)(@@) % تخال الأفاعي الرقش ما ضم منهم % حشاها وهم فيها أخ وحميم % 57(@)(@@) % فمن ذي لسان مفصح وهو أخرس % ومن بائح بالسر وهو كتوم % 58(@)(@@) % لها من سبيك التبر لون مورس % ووجه من العاج النصيع وسيم % 59(@)(@@) % تدين العطايا والمنايا بأمرها % % ويأمل مثر نفعها وعديم % 60(@)(@@) % وغضبان من جن المراح كأنه % % عصا النبع لولا رادف وحزيم % PageV01P2264 61(@)(@@) % له عنق في صفحة الجو شارف % وذيل على خد التراب عميم % 62(@)(@@) % تقابل في أطرافه العتق والتقى % % عليه 
ms722	 خؤل سبق وعموم % 63(@)(@@) % أغر تقول الفجر شق جبينه % ومن لونه ليل عليه بهيم % 64(@)(@@) % كأن الهلال بين جنبيه طالع % ورصع الحلى من جانبيه نجوم % 65(@)(@@) % ومجنونة تطوي الطريق كأنما % % تنفس منها في الحزام ظليم % 66(@)(@@) % هي البرق خطوا والكثيب وثارة % ولينا وأخت الريم أو هي ريم % 67(@)(@@) % إذا انتسبت لم يخزها مع خالها ال % % كريم أب في الشاحجات لئيم % 68(@)(@@) % ترى الموكب الجعجاع جل سميره % أحاديث ما يسرى بها ويقيم % 69(@)(@@) % لها منهم حظ اللسان إذا مشت % % مديحا وحظ العين حين تقوم % 70(@)(@@) % منائح كانت في السماء ذخيرة % لكم ومنى عهدى بهن قديم % PageV01P2265 71(@)(@@) % لقد طال سكر الدهر ثم صحا بها % % وسفه حتى اليوم وهو حليم % 72(@)(@@) % وفت بمواعيد السعادة فيكم % وقد مل ممطول وكل غريم % 73(@)(@@) % وبت بغيظ الحاسدين فمسمع % صليم وأنف في التراب رغيم % 74(@)(@@) % فلسنا نسوم الدهر فيها زيادة % سوى أنها تبقى لكم وتدوم % 75(@)(@@) % زجرت لكم طير الميامن قبلها % % وأعلمتكم أني بذاك عليم % 76(@)(@@) % وأني وراء الغيب تطلع فيكم % بصائر لي معروفة وعزيم % 77(@)(@@) % ومن آيتي في الشعر أن لاعيافتي % % تخيب ولا فالى الجري يخيم % 78(@)(@@) % فوفوه حق الشعر وارعوا ذمامه % % وصحبته إن اليسير ذميم % 79(@)(@@) % أنا المرء لم يخبث لكم قط سره % % ولم تسله عنكم رقى وتميم % 80(@)(@@) % على رعى واديكم يجر حباله % % ويشبعه غض لكم وهشيم % PageV01P2266 81(@)(@@) % فمالي وسمت اليوم بالشعر وحده % % وفي صفات غيره ووسوم % 82(@)(@@) % ألم أك أيام الهوى لي كله % % مقيما عليكم لا أكاد أريم % 83(@)(@@) % تجاذب أذيالي يد منكم يدا % ويعطفكم مجد علي وخيم % 84(@)(@@) % إذا قال قوم شاعر حسب غرتم % علي وقلتم شاعر ونديم % 85(@)(@@) % فها أنا ملقى في الرذايا كأنني % % جليب تنافاه الرعاة كليم % 86(@)(@@) % أرى ماء حوض كنت صفقت شربه % % أطرد عنه والغراب تعوم % 87(@)(@@) % أقول لنفسي كلما خفت يأسها % % رويدك تظمى الأرض ثم تسيم % 88(@)(@@) % وما الغيث إلا قطرة بعد قطرة % مرش ويتلوه أجش هزيم % 89(@)(@@) % لنا في كفالات الوزير غرائس % ستثمر خيرا والكريم كريم 
ms723	 % 90(@)(@@) % بلغت بك الآمال فابلغ بي التي % % تحسن وجه الدهر وهو شتيم % PageV01P2267 91(@)(@@) % وما بي إلا العز فاستبقني به % % وكالميت حر عاش وهو مضيم % 92(@)(@@) % ومن شرف الإعراق أن تبلغ المدى % % وأنت على حسن الحفاظ مقيم % PageV01P2268 البحر : - 1(@)(@@) % من موصل بالسؤال والقسم % إلي علما عن دارة العلم % 2(@)(@@) % أحدوثة تنسخ الغليل فيل % % تام من القلب غير ملتئم % 3(@)(@@) % هيهات نجد والمخبرون به % % قل عناء السؤال من أمم % 4(@)(@@) % ليس سوى نفحة الصبا لك أو % % لمحة برق بالغور مبتسم % 5(@)(@@) % وخادعات وهنا يصانعك ال % % ليل بها من كواذب الحلم % 6(@)(@@) % تطرق لقط القطاة خائفة % مكايد الراصدين في الطعم % 7(@)(@@) % نمت لها نومة المريب وأص % % حابي هجود من جانبي إضم % 8(@)(@@) % والليل تسرى نجومه الشهب في % % جحافل من خيوله الدهم % 9(@)(@@) % فزارنا قربت زيارته % % من آنس بالظلام محتشم % 10(@)(@@) % يعرف رحلى من الركاب برج % % عات التشكي وأنة السقم % % PageV01P2269 11(@)(@@) % ثم دنا جاذبا عطافي وال % % خوف يلوى منه فقال قم % 12(@)(@@) % قم لي فلولاك لم أجب خطرا % % قلت ولولا سراك لم أنم % 13(@)(@@) % أكرومة للدجى وهبت ذنو % % ب الصبح فيها لشافع الظلم % 14(@)(@@) % وعارض تصبح البلاد به % % في نعمة من مواهب الديم % 15(@)(@@) % عدل حتى تلاحق الحزن بال % % سهل وسوى الجفار بالأطم % 16(@)(@@) % راخى له المرزمان وانشالت ال % % عقرب عن كل هاجم عرم % 17(@)(@@) % يوغل في الأرض ماؤه مولدا % منها بطون الحوائل العقم % 18(@)(@@) % ترى القرارات منه رافلة % في أزر من عمائم الأكم % 19(@)(@@) % تقول عنه الرياض مفصحة % أحسن ما قال شاكر النعم % 20(@)(@@) % كأنما الله قبله قط ما % % قلد أرضا صنيعة لسمي % % PageV01P2270 21(@)(@@) % تعبث آثاره بمشعرة ال % % أعضاد قرع الجنوب واللمم % 22(@)(@@) % قد أكل الجدب أطيبيها فلم % % يبق سوى رسمها لمرتسم % 23(@)(@@) % بعيدة العهد بالعشيب من ال % % أرض ورقراق مائها الشبم % 24(@)(@@) % تنهض أشباحها النواحل في % % حاجاتنا بالجسائم العظم % 25(@)(@@) % تطلب من ذي الرياستين قرا الر % % كب ونار القرى على العلم % 26(@)(@@) % وعزة الجار في ربيعةوالد % % ار وأمن الحمام في الحرم % 27 
ms724	(@)(@@) % والقائل الفاعل الذي سيط جو % % د العرب منه بطيبة العجم % 28(@)(@@) % تزجرها باسمه الحداة فتن % % قاد بغير الخشاش والخطم % 29(@)(@@) % فخل عنها لسا ومضمضة % ثم استقم في السرى بها ورم % 30(@)(@@) % فاليوم ترعى وادي الغضا وغدا % ترعى بنعماه وادي الكرم % PageV01P2271 31(@)(@@) % يبلغن لا ضيق الخناق من ال % % عي ولا مسندا من السأم % 32(@)(@@) % ولا قصير الإزار إن جذب ال % % جدب بأذيال خائض القحم % 33(@)(@@) % أملس لا تعلق العيوب به % % معطر العرض أبيض الشيم % 34(@)(@@) % غضبان مما غار الأبي له % % وفي الرضا شهدة لملتقم % 35(@)(@@) % إما ترى ما لديه قسرا فخذ % % عنه وإما سألت فاحتكم % 36(@)(@@) % عسفا ولطفا ويجمع الماء وال % % نار غرار المهند الخذم % 37(@)(@@) % جاد فقال اللوام حسبك فاز % % داد فقالوا يا ليت لم نلم % 38(@)(@@) % وذوقوه العقبى فقال لها % % عدة صبري وجامع الرمم % 39(@)(@@) % أعجب من عامل الرزق عدو % قاسم الرزق غير متهم % 40(@)(@@) % لله والمجد والحفيظة وال % % عزائم العاليات والهمم % % PageV01P2272 41(@)(@@) % ما ضمنت منأبي المعاليحبى ال % % دست وأدت جوامع الكلم % % 42(@)(@@) % ورب عوصاء تعصب الفم بالر % يق وتهفو بالناطق الخصم % 43(@)(@@) % نافرة الجانبين مبهمة ال % % وجه على جامع ومنتظم % 44(@)(@@) % عزت على القائلين وهي له % % تذل بين اللسان والقلم % 45(@)(@@) % تفعل خرساء في صحائفها % % فعل زئير الآساد في الأجم % 46(@)(@@) % كأنه من ردى النفوس بها % % يكتبها في طروسها بدم % 47(@)(@@) % فضائل إرثها ومكسبها % % له بحق الحدثان والقدم % 48(@)(@@) % يابن المحامين عن حقائقهم % % في الصبح والمطعمين في العتم % 49(@)(@@) % والضاربين العدا بحدهم % والبالغين المدى بجدهم % 50(@)(@@) % مشى على الدهر ملككم يفعا % % وعانسا مشرفا على الهرم % PageV01P2273 51(@)(@@) % ورضتم أظهر الليالي المقا % % ديم وطلتم سوالف الأمم % 52(@)(@@) % قد أصلح الناس سعيكم لهم % وأفسد الناس لطفكم بهم % 53(@)(@@) % وقلبتكم أيدي الملوك فلم % % يغمز قناكم عار ولم يصم % 54(@)(@@) % واستصرخوكم مستضعفين على % % حرب فكنتم أنصار ملكهم % 55(@)(@@) % واستقدحوا رأيكم فأرشدهم % % والنصح حيران والصواب عمي % % 56(@)(@@) % فلا تزعزعكم الخطوب ولا % % تدخل عليكم صوارف النعم % 57(@)(@@) % ولا تزل منكم الأساور والت % % يجان فوق الأكف 
ms725	 والقمم % 58(@)(@@) % شريتكم بالورى فما قرع ال % % غبن بظفري سنى من الندم % 59(@)(@@) % وصرت منكم بحكم كل فتى % منكم لحق الوفاء ملتزم % 60(@)(@@) % دست رءوس العدا بمجدكم % وهان هاماتهم على قدمي % % PageV01P2274 61(@)(@@) % لففتموني بعيصكم فسرت % % عروق عبد الرحيم في رحمي % % 62(@)(@@) % لكن هنات تعرو فتلفت عن % % حقي وتقصى القريب من ذممي % % 63(@)(@@) % وشاغلات حوادث صرفت % وجوهكم عن حقوقي القدم % 64(@)(@@) % ألقاكم آنسا فيرجع بي % % إعراضكم في ثياب محتشم % 65(@)(@@) % ملالة والمزار غب وإق % % صاء بلا زلة ولا جرم % 66(@)(@@) % وجفوة لو شربتها في إنا % % ء الماء صديان ما شفى قرمي % % 67(@)(@@) % لم ترقها خدعتي بقولي ولا % % فعلي والسحر في يدي وفمي % % 68(@)(@@) % تشمت آمالى الصحائح في % % إشفاء حالي فيكم على السقم % 69(@)(@@) % ويعجب المجد من وجودكم % على الغنى قدرة ومن عدمي % % 70(@)(@@) % وما أقول البحار غاضت بأي % % ديكم وحالت طبائع الديم % PageV01P2275 71(@)(@@) % لكن عتابي على الحظوظ وشك % % واي إليكم تحيف القسم % 72(@)(@@) % وأنني في زمان عزكم % وهو زماني بحال مهتضم % 73(@)(@@) % كنت أظن الأيام إن خدمت % إقبالكم أن يكون من خدمي % % 74(@)(@@) % وأن نيرانكم إذا ارتفعت % أول ما يعتلقن في فحمي % % 75(@)(@@) % وأن تزول الدنيا وأنت على % % عهدك لي لم تزل ولم ترم % 76(@)(@@) % فلا يخب ذلك الرجاء ولا % % تهتك مصونات تلكم الحرم % 77(@)(@@) % ولي ديون أجلن عندك قد % % أكلن لحمي وقد شربن دمي % % 78(@)(@@) % فاقض فقد أمكنت وخفف بها % % ظهرك إن الديون في الذمم % 79(@)(@@) % واقصد بها غاية الجمال على ال % % عادة فيها لا غاية القيم % 80(@)(@@) % والبس من المهرجان ضافية % في العز أذيالها على القدم % PageV01P2276 81(@)(@@) % ينسجها السعد ما أطال وما % % أعرض في الأسديات واللحم % 82(@)(@@) % معقودة بالخلود طرتها % % فما تقول الدنيا لها انفصمي % % 83(@)(@@) % وقابل الصوم أبلج الوجه جذ % % لان وعيد مؤيدا وصم % PageV01P2277 البحر : - 1(@)(@@) % لمن دار على إضم % % كوحي الخط بالقلم % 2(@)(@@) % عفت إلا بما تملي % % من الزفرات والألم % 3(@)(@@) % وقفنا محدثين بها % % جوى أيامنا القدم % 4(@)(@@) % نشاكيها ونفضلها % % بفيض دموعنا السجم % 5(@)(@@) % وكل بالنحول على 
ms726	 ال % % شكاية غير متهم % 6(@)(@@) % فنحن ردائد البلوى % % نعم وطلائح السقم % 7(@)(@@) % سقاك على ادكار العه % % د غيث مواقر الديم % 8(@)(@@) % وزارك خير ما نسجت % على أرض أكف سمي % % 9(@)(@@) % فكم من عيشة صلحت % لنا بك ثم لم تدم % 10(@)(@@) % وليل تسلب الأسحا % % ر فيه مواهب العتم % PageV01P2278 11(@)(@@) % شكرنا فيه شكر الح % % ق منه كاذب الحلم % 12(@)(@@) % يغطينا الدجى ويبو % % ح ومض البارق الضرم % 13(@)(@@) % وهل تتموه الأقما % % ر إن غطين بالظلم % 14(@)(@@) % ويشرق في الصفاح اللث % % م إشفاقا من التهم % 15(@)(@@) % فنقضي في يد ويد % مآرب من فم وفم % 16(@)(@@) % فيا علم الحمى ذكرت % عهودك ظبية العلم % % 17(@)(@@) % وعادك من زمان ذما % % ك ناشر تربك الرمم % 18(@)(@@) % ويا ريح الصبا اقترحي % % على الأحشاء واحتكمي % % 19(@)(@@) % متى راوحتها خبرا % % على البيضات في الخيم % 20(@)(@@) % أراك نسمت تختبري % % ن ما عهدي وما ذممي % % PageV01P2279 21(@)(@@) % فهذي في يدي كبدي % % وذا في وجنتي دمي % % 22(@)(@@) % سلام كلما ذكرت % ليالينا بذي سلم % 23(@)(@@) % وحيا الله مختبطا % ونار الليل في الفحم % 24(@)(@@) % تجشم يركب الأسلا % % ت من كعب ومن جشم % 25(@)(@@) % سرى أنسا وفي الرقبا % % ء كل ألد محتشم % % 26(@)(@@) % خفيا أن يرى بالعي % % ن أو يقتص بالقدم % 27(@)(@@) % وأعجب كيف نمت له % % وليلى قبل لم أنم % 28(@)(@@) % إلى أن صاح بي وبه % % صديع الفجر قم وقم % 29(@)(@@) % ومر فليت مختلسي % % زيارته ومجترمي % % 30(@)(@@) % يعالج ود منتقل % ويأمل عفو منتقم % PageV01P2280 31(@)(@@) % وطرفا قد أصاب علا % % أبي الحسن العميد عمي % % 32(@)(@@) % أخى ودا وعرق الو % % د فوق وشائج الرحم % 33(@)(@@) % ومولى حاجتي يوم ان % % قطاع علائق الحرم % % 34(@)(@@) % ومنهض همتي ما قم % % ت أطلب عالي الهمم % 35(@)(@@) % وكان طفى الزمان به % % أوامي أو شفى قرمي % % 36(@)(@@) % وأوجده عل عدم % وأولده على عقم % 37(@)(@@) % أكيد به النوائب أو % % تكون بأمره خدمي % % 38(@)(@@) % وألبس منه ضافية % ذلاذلها على قدمي % % 39(@)(@@) % فسل علي جفوته % % مسل الصارم الخذم % 40(@)(@@) % ولونه علي مل % % ون الشعرات في اللمم % % PageV01P2281 41(@)(@@) % تناسى والمدى كثب 
ms727	 % وعهد الوصل من أمم % 42(@)(@@) % مؤاخذة بلا سبب % وإعراض بلا جرم % 43(@)(@@) % سوى أني كثرت فم % % ل والمملول للصرم % 44(@)(@@) % وعز بنفسه ذلي % % له بنوافذ الكلم % 45(@)(@@) % وخفضي في مدائحه % خزامة أنفي العرم % 46(@)(@@) % ولولا شيمة رفعت % % ه ما خودعت عن شيمي % % 47(@)(@@) % وغيرك صارما أعطي % % ه حبل أحذ منفصم % 48(@)(@@) % أكايله بصاع يدي % % ه من عوج ومن قيم % 49(@)(@@) % وأترك سنه وعدا % لأكل يديه بالندم % 50(@)(@@) % ولكن قطعى العضو ال % % أليم يزيد في ألمي % % PageV01P2282 51(@)(@@) % فؤادي فيك مبتذلي % % وطرف العين مهتضمي % % 52(@)(@@) % فما لي في قراعك غي % % ر أن ألقى يد السلم % 53(@)(@@) % وأنظر رجعة الإنصا % % ف منك وعطفة الكرم % 54(@)(@@) % وإني في رءوس عدا % % ك ولاج على القحم % 55(@)(@@) % وعلمك أن مثلي السي % % ف لم يغمد ولم يشم % 56(@)(@@) % ودونك في الخصام ألد % آخذ موضع الكظم % 57(@)(@@) % فخف عقبى الغبينة في % يوم تفاوت القيم % 58(@)(@@) % فمن لك بي إذا ما قا % % ل بأني السؤدد انهدم % 59(@)(@@) % ومن لك يوم يحمى العر % % ض مثل يدي ومثل فمي % % 60(@)(@@) % ومن ذا إن شردت يرد % ما أرسلت من خطمي % % PageV01P2283 61(@)(@@) % أرى أملي يشتت أو % % أراك تعود منتظمي % % 62(@)(@@) % فيا مبدي الوفاء أعد % % ويا معطي المنى أدم % 63(@)(@@) % ويا من قدم الحسنى % % هب الحدثان للقدم % 64(@)(@@) % وثقف ما حطمت فلا % % طعان لصدر منحطم % 65(@)(@@) % وكن لي مثل ما قد كن % % ت منتقذي ومعتصمي % % 66(@)(@@) % ووفر فضل مالك لي % % وجاهك مسنيا قسمي % % 67(@)(@@) % فلو عاد الزمان فتى % % وشب لكم على الهرم % 68(@)(@@) % لما أخلفتم مثلي % % ولا في سالف الأمم % 69(@)(@@) % عتبت وتحت حر العت % % ب قلب غير محتدم % 70(@)(@@) % وأضلاع تضم علي % % ك شوقا موضع الحزم % PageV01P2284 71(@)(@@) % ومثل الغيث عوتب أن % % أخل بصوبه الرهم % 72(@)(@@) % ولم يأسف على العليا % % ء مثل معود النعم % PageV01P2285 البحر : - 1(@)(@@) % عذيرك من حلمك المهتضم % وقد رفع الحي من ذي جشم % 2(@)(@@) % أناخوا المطي وماء العيو % % ن دمع وصاحوا بها وهو دم % 3(@)(@@) % نصلن مروقا مروق السها % % م أغراضهن 
ms728	 النوى والصرم % 4(@)(@@) % حوامل مثل كنوز النعا % % م تمشي بهن كنوز النعم % 5(@)(@@) % نواضع كن شموس النها % % ر تطلع منها بدور العتم % 6(@)(@@) % فمختمر ما عدا ليلتين % % ومسفر عشر خطاها فتم % 7(@)(@@) % عقائل ماخفن عيبا يلاق % بهن ولا ذقن عيشا يذم % 8(@)(@@) % حملن جسوما وصفن النع % % يم تحت وجوه شكرن النعم % 9(@)(@@) % وفي الركب من يك منها الجنون % وأخرى هي البرء وهي السقم % 10(@)(@@) % إلى أين يا سائق البكرتين % % عن الطلح من أجأ والسلم % PageV01P2286 11(@)(@@) % أأغنى ثرى منه شقت عصاك % % وأسبغ نبتا وأندى ديم % 12(@)(@@) % أسرك غيرك من يستراد % % جميم المراتع للمهتضم % 13(@)(@@) % وقد حلفت واليمين البلا % % ء ظبية لا بر منها القسم % 14(@)(@@) % لئن نسب الشعر بين الحمو % % ل باسمي ليحتبلن المسم % 15(@)(@@) % ألا هلوظل المنى بارد % وقد يرزق المرء مما حرم % % 16(@)(@@) % تعود ليال بذات النقا % % قدمن ولم ينسنيها القدم % 17(@)(@@) % وعيش بها نام عنه الزمان % وهب وعاد يرى في الحلم % 18(@)(@@) % لعلك يا دهر أن تستقي % % ل فرط لجاجك أو تحتشم % 19(@)(@@) % فيجمع هذا الفؤاد الشعاع % % ويبرد هذا الجوى المضطرم % 20(@)(@@) % وإلا بقرب عميد الكفا % % ة عذرك في كل ذنب عظم % PageV01P2287 21(@)(@@) % متى تدن دار به لا ألم % % ك في حادث بعدها أو ملم % 22(@)(@@) % رعى الله لي في سرار النوى % % هلالا بأكناف غمي أغتم % 23(@)(@@) % نفضت طريق النوى بعده % % فلم أحظ إلا بخبط الظلم % 24(@)(@@) % وداويت جهدي داء الحنين % % فما يستطب ولا ينحسم % 25(@)(@@) % وكيف استراحة جسم المقيم % % بدار بها قلبه لم يقم % 26(@)(@@) % وما الأرض نصرى غير العزي % % ز فيها ورزقي غير الأمم % % 27(@)(@@) % وما خلت أن بيوت النبي % % ط يحذر فيها ليوث الأجم % 28(@)(@@) % ولا أن تكون قرى بالدجيل % مراح العلا ومغيض الكرم % 29(@)(@@) % تغير بعدك خلق النسيم % % وغص السقاة الزلال الشبم % 30(@)(@@) % فلا مشهد للمعالي يزار % % ولا كعبة للندى تستلم % PageV01P2288 31(@)(@@) % كأنك سرت بفضل الرجال % % جميعا وبنت بمجد الأمم % 32(@)(@@) % لئن نفرتك قراف الأذى % % وأوحش سمعك لذع الكلم % 33(@)(@@) % ورابك من كالح قلبه 
ms729	 % % إليك فم ملق مبتسم % 34(@)(@@) % فما كنت إلا الحسام الجرا % % ز لو لم يخف حده لم يشم % 35(@)(@@) % وما دعدع الليث في غيله % سوى أن متى صافحوه لطم % 36(@)(@@) % ودون الذي خفت رأي ألد % وقلب أصم وأنف أشم % 37(@)(@@) % وعرض البلاد وطول النجاد % ونصر الحسام وسحر القلم % 38(@)(@@) % وأمر من الله في الذب عن % % ك لا يستطاع إذا ما حتم % 39(@)(@@) % وعقبى يسر بها من يسر % ويرغم من أسف من رغم % 40(@)(@@) % وكم قد هفا الدهر من قبلها % % وعاد وأقلع عما اجترم % PageV01P2289 41(@)(@@) % وجاءك يحمله الاعتذار % منيبا ويشفع فيه الندم % 42(@)(@@) % وضاقت ففرجها الصبر عنك % % وكانت أغم وكانت أطم % 43(@)(@@) % وعيفت طيري فبشرتكم % % بما أسلفته الأحاظي لكم % 44(@)(@@) % ستذكرزجرى فيها غدا % كذكرك بالأمس لي ما قدم % 45(@)(@@) % وتعلم أني من لا يقو % % ل في الشعر إلا بما قد علم % 46(@)(@@) % وتطلع لي من ثنايا اللقا % % ء لوث الغزالة رأس العلم % 47(@)(@@) % وخلفك سائق طول البقاء % وبين يديك ثبوت القدم % 48(@)(@@) % وقد فللت عنك حد العدو % عرى الصبر أو عاليات الهمم % 49(@)(@@) % ألست ابن أعلقهم بالحفاظ % % وأعبقهم بشروط النعم % 50(@)(@@) % وأنداهم صارما أو يدا % % تقحم أو بل ترب القحم % PageV01P2290 51(@)(@@) % وفى ما وفى بالمعالي أبوك % % وزدت فقمت بما لم يقم % 52(@)(@@) % بك التأم الشعب من بعده % % وأبرم سلكهم وانتظم % 53(@)(@@) % فلا عدموك حيا في الجدوب % % رخا في الكروب غنى في العدم % 54(@)(@@) % وحيتعلى البعد ذاك الجنا % % ب وتلك السجايا العذاب الفغم % 55(@)(@@) % صواعد عنى تهب الجنو % % ب منها بأضوع ما يشتمم % 56(@)(@@) % مطارب في كل سمع جرت % عليه أطايب في كل فم % 57(@)(@@) % تدر عليك مرابيعها % % فواقا فواقا درور الحلم % 58(@)(@@) % وأسمنها رعي وادي الوفا % % ء فيكم وورد حياض الديم % 59(@)(@@) % فلو أن داركم بالصعيد % % ودونكم ججبات الحرم % 60(@)(@@) % لخاضت إليكم بطون البطاح % % وداست رءوس الربى والأكم % PageV01P2291 61(@)(@@) % يطالعكم كل عيد أغر % وأعياد قوم سواكم بهم % 62(@)(@@) % إذا ما خلوتم أنستم بها % % وإن ضامها الدهر عاذت بكم % PageV01P2292 البحر : - 1(@)(@@) % لنا من 
ms730	 ليلنا بلوى الصريم % % قراع الهم أو عد النجوم % 2(@)(@@) % حبسنا العيش منه على بخيل % نؤمل عنده جدوى الكريم % 3(@)(@@) % فلم نقف السؤال على مجيب % ولم نشك الغرام إلى رحيم % 4(@)(@@) % سوى ذكرى نزت بجوى دفين % كما كر العداد على السليم % 5(@)(@@) % عطار في الثرى وطروس وحي % تحادثنا عن العهد القديم % 6(@)(@@) % سقاك وإن صممت فلم تفدنا % % سوى سفه المنازل بالحلوم % 7(@)(@@) % رقيق القطر حنان العشايا % % نتاج المنجبات من الغيوم % 8(@)(@@) % تعود مع الصباح له بدانا % % جسوم الناحلات من الرسوم % 9(@)(@@) % عصيت لوائحي وأطعت وجدي % % برملة والخيار إلى الملوم % 10(@)(@@) % فما العدوى على ولهي ودمعي % % وقد حكمت في قلبي خصومي % % PageV01P2293 11(@)(@@) % وأرسلت اللحاظ على يقين % بما تجنى العيون على الجسوم % 12(@)(@@) % فإن تك صاحبا وعزمت رشدا % % غدا وحملت شطرا من همومي % % 13(@)(@@) % فمل ميل الغميم وحي عنى % % مواسم للبطالة بالغميم % 14(@)(@@) % وقل لملاعب العلمينسيري % % مع الحي المقوض أو أقيمي % % 15(@)(@@) % إذا عرياللوى من شجو قلبي % % ومن طرف أصيب به سقيم % 16(@)(@@) % فلا ناحت بحاجر بنت غصن % % ولا نظرت برامة أم ريم % 17(@)(@@) % سقى الله العراق بما سقاني % % حلوبة لا السحاب ولا الكروم % 18(@)(@@) % وأنصف بين أيامي وبيني % % إذا المظلوم دين من الظلوم % 19(@)(@@) % أعاتبها وعنى صم سمع % لتنزع وهي توغل في صميمي % % 20(@)(@@) % فيوما في شبابي أو حميمي % % ويوما في صديقي أو نديمي % % PageV01P2294 21(@)(@@) % طوارق للبعاد فرت أديمي % % بحد شفارها فري الأديم % 22(@)(@@) % أعالجها بصبري وهو داء % كما تقع الكلوم على الكلوم % 23(@)(@@) % تكنفني الزمان يطيل ضغطي % % فما أنفك من جنب أليم % 24(@)(@@) % ويضعف منتي ويميت فضلي % % تطلبي الثراء من العديم % 25(@)(@@) % وكان يضئ لي أملي فأسري % % فقد أضللت في الأمل البهيم % 26(@)(@@) % كأني لم أنط بالمجد همي % % ولم أركب إلى العلياء عزيمي % % 27(@)(@@) % ولم أهتك دجنة كل خطب % بفجر من بني عبد الرحيم % 28(@)(@@) % يضيء لي المنى ويدل عيني % % على نهج العلاء المستقيم % 29(@)(@@) % فقام البعد بينهم وبيني % % بروعة مقعد منهم مقيم % 30(@)(@@) % وولوها الأعنة مطلقات % وبقوني أعض على الشكيم 
ms731	 % PageV01P2295 31(@)(@@) % فهل بلغتم أخبار قلبي % % على التصحيح في النقل السليم % 32(@)(@@) % وهل يدرون ما سهري ووجدي % % إذا سكنوا إلى الليل المنيم % 33(@)(@@) % وطوفي بالبلايا والرذايا ال % % معرة بعد بزلهم القروم % 34(@)(@@) % بلى عند الوزير بذاك علم % وأنباء تشق على الكريم % 35(@)(@@) % سيجمعها وإن طفت انتشارا % % عظيم لا يروع بالعظيم % 36(@)(@@) % وفي العهد في قرب وبعد % غني النفس من كرم وخيم % 37(@)(@@) % من البيت الذي بذؤا بتيه % % سما والمنبت الزاكي الأروم % 38(@)(@@) % وقوم تذهب الأحساب عرضا % % ومنصبهم على السنن القديم % 39(@)(@@) % يسود الناس شيبا أو كهولا % % وفيهم سؤدد الطفل الفطيم % 40(@)(@@) % دعوا بزل الرجال وهم جذاع % وتموا في المراسل والتميم % PageV01P2296 41(@)(@@) % وساسوا الدهر والسلطان عسفا % % ولينا بالحمية والحلوم % 42(@)(@@) % فما أشروا مع القدر الموالي % % ولا بطروا على الملك العقيم % 43(@)(@@) % مضوا سلف العلا وأذى الأعادي % % وأندية الندى وشجا الخصوم % 44(@)(@@) % وأطلعت السعود لهم هلالا % % جديد النور بان من النجوم % 45(@)(@@) % وفى لهم أبوسعد بسعي % مزيد الحضر طم على الرسيم % 46(@)(@@) % وصاغ بذكره تيجان فخر % على جبهاتهم بدل الوسوم % 47(@)(@@) % يموت الدهر من هرم وتفنى % % بنوه وهي باقية الرسوم % 48(@)(@@) % عدوك بعد بعدك مثل ملك % سحيل الحبل منقوض الجريم % 49(@)(@@) % تهافت شمله وهوى سقيطا % % تداعي الملك في العقد النظيم % 50(@)(@@) % عصى بك والدا حدبا فآل ال % % عقوق به إلى ذل اليتيم % PageV01P2297 51(@)(@@) % تعاوره الولاة فشذبوه % % بعسف الغمز أو عسف الغشوم % 52(@)(@@) % فدولته الشعاع بلا عميد % وأمته الضياع بلا زعيم % 53(@)(@@) % أحل حرامها فقد استبيحت % % وكانت من جوارك في حريم % 54(@)(@@) % توالغ في جوانبها ذئاب % منعت أنوفها قص الشميم % 55(@)(@@) % فها هي لا تظن بها شفاء % إذا الإبلال قدر في السقيم % 56(@)(@@) % بلى أرجو لها بك أو لأخرى % % علاج الداء أو سد الثلوم % 57(@)(@@) % إذا اضطروا وأجدب وادياهم % % إلى استمطار وابلك العميم % 58(@)(@@) % ديون لي على الأيام فيكم % % وغائبة تبشر بالقدوم % 59(@)(@@) % أطالبها وأعلم أن ستقضى % % وإن طالت مماطلة الغريم % 60(@)(@@) % بغاك لها وقد قرنت وأنت % وجر نهوضها طول الجثوم % PageV01P2298 61(@)(@@) % فإن الأمر 
ms732	 يبطئ ثم يأتي % % أحب من التسرع والهجوم % 62(@)(@@) % وبعد على النوى وعلى التداني % % فقد أشقيتني بعد النعيم % 63(@)(@@) % قود خلفتني من كف دهري % % بطول الصد في أسر لئيم % 64(@)(@@) % أروض الحمد في أيد جعاد % وأرعى جانب العيش الذميم % 65(@)(@@) % تصوح مرتعي وذوت عروقي % % بهجر سحابك الصخب الهزيم % 66(@)(@@) % ولم تك قط في سعة وضيق % لتغفلني وتشغل عن رسومي % % 67(@)(@@) % فما بالي جفيت أما حديثي % % يذكرك الحقوق أما قديمي % % 68(@)(@@) % ألست بصحبتي ووفاي أهلا % % بمنزلة المساهم والقسم % 69(@)(@@) % نظقت ولو أطقت لطال صمتي % % على ما اعتدت من خلقي وخيمي % % 70(@)(@@) % ولكني أطقت جنون دهر % ينقل شيمة الرجل الحليم % PageV01P2299 71(@)(@@) % بقيت لمدحكم فابقوا لرفدي % % على رعى المصوح والهشيم % 72(@)(@@) % فإني ما وجدتكم قليل % من العدم ارتياعي أو وجومي % % 73(@)(@@) % لكم في كل غاسقة وفجر % % حبائر من فمي رقش الوشوم % 74(@)(@@) % تكون عليكم درا نثيرا % % وحصنا من عدوكم الرجيم % 75(@)(@@) % بنيت لكم بها مجدا مضافا % % إلى مجد الخؤلة العموم % 76(@)(@@) % يزوركم بها النيروز يسري % % بطول اللبث فيها واللزوم % 77(@)(@@) % بواقي فيكم متداولات % بقاء الفخر في سلفى تميم % PageV01P2300 البحر : - 1(@)(@@) % أيوما مثل يوم الجز % % ع تنساه وإن قدما % % 2(@)(@@) % وتكفره وقدما كن % % ت ممن يشكر الحلما % % 3(@)(@@) % ملاعب صبوة وهوى % ودار سلامة وحمى % % 4(@)(@@) % رزقنا منه صيد العي % % ن والقناص قد حرما % % 5(@)(@@) % جآذر من ظباء الإن % % س كن دمى ولسن دمى % % 6(@)(@@) % قنصناهن دون منى % ولم نتحرج الحرما % % 7(@)(@@) % وفيهن المنى صفرا % % ء يفتل كشحها هضما % % 8(@)(@@) % تريك بحسن صبغتها % % سلامة لونها سقما % % 9(@)(@@) % تلفت عن وميض البر % % ق عارضة ومبتسما % % 10(@)(@@) % أصاب بها بصيرته % % غوي يعبد الصنما % % PageV01P2301 11(@)(@@) % رمتني يوم ذي الجمرا % % ت عن طرف رنا فرمى % % 12(@)(@@) % وكان لسهمها ما شا % % ء من قلبي وما احتكما % % 13(@)(@@) % نعمت بها على إضم % % ويشقى بعد من نعما % % 14(@)(@@) % يد للحج شل النف % % ر بسطتها وما علما % % 15(@)(@@) % شكرناها وإن بعث ال % % شفاء بها لنا سقما % % 16(@)(@@) % سل الوراد يمتاحو % % ن زمزم ماءها الشبما 
ms733	 % % 17(@)(@@) % من الماء الذي يردو % % ن يشفي أو يبل ظما % % 18(@)(@@) % ولم يرشف لنازله % % وراء المأزمين لمى % % 19(@)(@@) % سقى الله المحصب ما % % سقت أرضا نجوم سما % % 20(@)(@@) % فحيث جرت دماء البد % % ن قلبت الدموع دما % % PageV01P2302 21(@)(@@) % بعينك هن خيمات % وما بك أن ترى الخيما % % 22(@)(@@) % فيا زمنا بذاك العي % % ش مر أما تعود أما % % 23(@)(@@) % حلفت بها محبسة % تمج أنوفها الخزما % % 24(@)(@@) % بدائد أو تخال بها % % على أكم اللوى أكما % % 25(@)(@@) % ترى ألهوبها في السي % % ر شب على الغضا ضرما % % 26(@)(@@) % سواهم كن حمرا قب % % ل تحمل ضمرا سهما % % 27(@)(@@) % لأضحت في بني عبد ال % % رحيم مودتي رحما % % 28(@)(@@) % صحبتهم على خوف % فكانوا الأشهر الحرما % % 29(@)(@@) % وناطوني بأنفسهم % % فرحت بهن ملتحما % % 30(@)(@@) % وضموني وكنت مدع % % دع الجنبات مقتسما % % PageV01P2303 31(@)(@@) % شريتهم بأهل الأر % % ض مع تحقيقي القيما % % 32(@)(@@) % فلم أغبن ولم أقرع % بشوكة ناجذي ندما % % 33(@)(@@) % رجمت بنصل أيديهم % % صليد الدهر فانحطما % % 34(@)(@@) % وقمت بهم من الأيا % % م منتصرا ومنتقما % % 35(@)(@@) % ملوكا يحسبون الجو % % د مقدورا لهم حتما % % 36(@)(@@) % رضوا بوجود مجدهم % فلم يتسخطوا العدما % % 37(@)(@@) % كأنهم إذا افتقروا % % أبروا بيتهم قسما % % 38(@)(@@) % هم سنوا الحجا فالطو % % د لولاهم لما حلما % % 39(@)(@@) % وجادوا فاستمد الغي % % ث من أيديهم الكرما % % 40(@)(@@) % رمت فوق السماء بهم % % مسماع كلهن سما % % PageV01P2304 41(@)(@@) % فكانوا مزنها شيما % % وكانوا شهبها قسما % % 42(@)(@@) % بهم تم الكمال فتى % وشب وبعد ما احتلما % % 43(@)(@@) % تضاهوا فيه واشتبهوا % % نهى وتماثلوا همما % % 44(@)(@@) % تمام الرمح بالأنبو % % ب والأنبوب منتظما % % 45(@)(@@) % وأصبح من أبي حسن % طريق علائهم لقما % % 46(@)(@@) % هم الأعلام لكن شب % نارا تشرف العلما % % 47(@)(@@) % وفى عين الكفاة لهم % % بما أغنى وما عظما % % 48(@)(@@) % وقام بشرع سؤددهم % % فأضحى دينها قيما % % 49(@)(@@) % فتى شهد التفرس في % % نجابته بما علما % % 50(@)(@@) % وقدمه الوقار على ال % % كهول وبعد ما فطما % % PageV01P2305 51(@)(@@) % أنال فكان مقمورا % % وغار فكان محتشما % % 52(@)(@@) % قضى قاضي السحاب على الس % % حاب له إذا حكما % % 53(@)(@@) % فقال له معاني الجو % % د والأسماء بينكما 
ms734	 % % 54(@)(@@) % قضية صادع بالح % % ق ما حابى وما ظلما % % 55(@)(@@) % وذلل رأيه ما أع % % جز الرواض واللجما % % 56(@)(@@) % فما عناه من أمر % % رياضته وقد هرما % % 57(@)(@@) % محاسن عاد يعترف ال % % حسود بها وإن رغما % % 58(@)(@@) % وبارقة من الإقبا % % ل تلفح عارضا سجما % % 59(@)(@@) % بدت شررا وسوف تدب % حتى تملأ الفحما % % 60(@)(@@) % وإن قعد الزمان بها % % وفتر بعد ما احتدما % % PageV01P2306 61(@)(@@) % وقصر سعيه شيئا % % وكان مصمما قدما % % 62(@)(@@) % سيبعد خطوه فيها % % غداص ويوسع القدما % % 63(@)(@@) % ويرجع نادما يبني % % من العلياء ما انهدما % % 64(@)(@@) % ضمان لي على الأيا % % م فيك عقدته ذمما % % 65(@)(@@) % ووعد الدهر عندي في % % علاكم قلما انجذما % % 66(@)(@@) % فلا يقنك من وصل الس % عادة عاتب صرما % % 67(@)(@@) % وخذ للعز أهبة من % % توثب بعد ما جثما % % 68(@)(@@) % وثوب الليث أخدر % ثم هب مفارقا أجما % % 69(@)(@@) % وجدد لبسة النيرو % % ز ثوبا ينصف القدما % % 70(@)(@@) % شباب الدهر أو تلقا % % ه أشمط رأسه هرما % % PageV01P2307 71(@)(@@) % ووف الحمد كيلة قا % % سم لك خير ما قسما % % 72(@)(@@) % يزورك من مكامنه % % بما أخفى وما كتما % % 73(@)(@@) % بدائد تنظم الأسما % % ع مما تنثر الحكما % % 74(@)(@@) % تكون بذكرها سحرا % % وإن هي سميت كلما % % 75(@)(@@) % تسود الشعر أو تضحي % % لها ساداته خدما % % 76(@)(@@) % تؤمك لا تغبك نا % % ئيا ألفتك أو أمما % % 77(@)(@@) % لتعلم أنها ترعى ال % % أواصر منك والحرما % % 78(@)(@@) % وأن الخارص الواشي % % إليك بغدرها أثما % % 79(@)(@@) % تحرش ئم جربكم % % لينقل غير ما فهما % % 80(@)(@@) % فلما أن رآكم طل % % عة لقذافه رجما % % PageV01P2308 81(@)(@@) % ولا وأبي العلى إن كا % % ن ما سدى كما زعما % % PageV01P2309 البحر : - 1(@)(@@) % أجاذبها لو أمكنت من زمامها % % أريد وراء والهوى من أمامها % % 2(@)(@@) % وإن كان قلبي في الصبابة قلبها % % فشتان ما شكيتني من عرامها % % 3(@)(@@) % كلانا أخوه الوجد لكن غرامها % % طليق ونفسي في إسار غرامها % % 4(@)(@@) % فما الحرب إلا بين حلمي وخرقها % % وبين زفيري خائفا وبغامها % % 5(@)(@@) % يعز عليها نومها تحت كورها % % بما فات من أيامها في مسامها % % 6(@)(@@) % وأن تعلف الرطب الخليط ببابل % % مكان أراك 
ms735	 حاجر وبشامها % % 7(@)(@@) % بلاد تسيم الضيم فوق ترابها % % ضياعا وتسقي الذل تحت غمامها % % 8(@)(@@) % فليت بلادا شرها في قصورها % % فدا لبيوت خيرها في خيامها % % 9(@)(@@) % نعم هذه الزوراء أنضر شارة % بما ضمنت من روقها وزمامها % % 10(@)(@@) % ولكن ذناباها تطول رقابها % % وأرجلها مرفوعة فوق هامها % % PageV01P2310 11(@)(@@) % إذا سر نفسا يومها ساء شهرها % % فإنعامها مستطرح في انتقامها % % 12(@)(@@) % تمنيت رغما غيرها وهي التي % % فطيرة جلدي حشوها من رغامها % % 13(@)(@@) % وماذا على نفس جنى عام خصبها % % عليها الأذى أن تشتهي جذب عامها % % 14(@)(@@) % سلام عليها لا على جل أهلها % % لأخرى تراب العز بين سلامها % % 15(@)(@@) % ركبت لها عزمي وللنفس قعدة % تبلغها من همها واعتزامها % % 16(@)(@@) % ورفعت من خفض الكرى بابن حرة % تجود لصوني عينه بمنامها % % 17(@)(@@) % يصم سواه عن دعاء زميله % % إذا ما الثريا علقت في مصامها % % 18(@)(@@) % وقال اقض ما تقضي وفي الليل مهلة % فأسرار هذي العيس تحت ظلامها % % 19(@)(@@) % تياسر بنا واترك لقوم يمينهم % % وبعهم عراق الأرض غبنا بشامها % % 20(@)(@@) % فكم راحة بيضاء ثم وسحنة % ترى الرزق في صفاحها وابتسامها % % PageV01P2311 21(@)(@@) % وأندية حب العلا من عقودها % % وأيد كنوز المال تحت كمامها % % 22(@)(@@) % وقوم على تعظيم ملكك لوحمت % لدن خلقت لحومها بعظامها % % 23(@)(@@) % أثرها ورح فالنجح عند مسيرها % % مغربة والعجز عند مقامها % % 24(@)(@@) % ولكن ببغداد فما أنت صانع % وحظك منها شعبة من كرامها % % 25(@)(@@) % جبال بني عبد الرحيم وسحبها % % كعهدك في إرسائها وانسجامها % % 26(@)(@@) % قبيل بهم شدت عراك فلم تكن % % لتملك كف الدهر حل عصامها % % 27(@)(@@) % هم انتقذوك والليالي ضوارب % بكلكلها في ضغطها وزحامها % % 28(@)(@@) % وهم وجدوك جمرة فتضعفوا % % لها الريح حتى طبقت بضرامها % % 29(@)(@@) % بأوصافهم سميت واحد دهره % وما نلته من ضبطها ونظامها % % 30(@)(@@) % وكم كثروا من حاسديك وأشرجوا % % صدورا على شحنائها وسقامها % % PageV01P2312 31(@)(@@) % وعدوك نفسا منهم ما لهم بها % % مساهمة في حلها وحرامها % % 32(@)(@@) % وما أنت إن حمت نواك بتركهم % % سوى مهجة مأذونة بجمامها % % 33(@)(@@) % وهل عنزعيم الملك في الناس عائض % إذا كشفت مخبوءة عن خدامها % % 34(@)(@@) % سلالة مجد زاد 
ms736	 فيها قرانها % % كما الكرم معنى فضله في مدامها % % 35(@)(@@) % ترقت به هماته قبل سنه % % إلى ذروة خلوا له عن سنامها % % 36(@)(@@) % تظل العيون دونها مستريبة % بألحاظها إن رفعت في اقتحامها % % 37(@)(@@) % إذا قطرت بالراكبين فردفه % على سرجها وكفه في لجامها % % 38(@)(@@) % جرى لاحقا مجد العشيرة قادرا % % على سبقها لولا مكان احتشامها % % 39(@)(@@) % غلام ترى أشياخها وكهولها % % به فرقا مجموعة في غلامها % % 40(@)(@@) % إذا قال أرضاها وإن قام دونها % % إلى الخطب أغنى سوقها عن قيامها % % PageV01P2313 41(@)(@@) % وإن نقصت من جانب المجد شعبة % فشد عليها كان مولى تمامها % % 42(@)(@@) % وإن ضاق بين القرن والقرن مأزق % % ضراب الكماة فيه مثل لطامها % % 43(@)(@@) % فلم تك إلا هامة طاح بدرها % % وكف هوت جوزاؤها في قيامها % % 44(@)(@@) % نضت منه وسطى عقدها وتعززت % % بثالثها في سلكها ونظامها % % 45(@)(@@) % فتى لا يربي المال إلا لفقده % % ولا يكرم النعمى لغير اهتضامها % % 46(@)(@@) % ولا يحسب الأرزاق إلا ليومه % % إذا حسبت نفس اللئيم لعامها % % 47(@)(@@) % ولم أر منه قط أولد راحة % وأجدى على إقلاتها وعقامها % % 48(@)(@@) % يجود وفي أوشاله جل ماله % وتلحز أيد مالها في جمامها % % 49(@)(@@) % أبا حسن لبيك داعي مودة % سواك يناديها بصمي صمامها % % 50(@)(@@) % وخاطب أبكار وعون حميتها % % وخليت عنها سارحا في سوامها % % PageV01P2314 51(@)(@@) % وذببت عنها الناس ضنا بعذرها % % لمجدك حتى كنت فض ختامها % % 52(@)(@@) % لها مدد تزداد منه بنقصها % % وتنمي على توزيعها وانقسامها % % 53(@)(@@) % بقيت غريبا مثل عنقاء جوها % % لها ووحيدا مثل بدر تمامها % % 54(@)(@@) % يرجم في الظن هل أنا ربها % % أم انتشرت فحولها من رجامها % % 55(@)(@@) % وقد آمن الأعداء أنى نبيها % % وكم رسل آياتها في كلامها % % 56(@)(@@) % لعرضك منها نثرة سابغية % وأعراض قوم عرضة لسهامها % % 57(@)(@@) % جزاء بما راعيته من حقوقها % % وأوجبته من إلها وذمامها % % 58(@)(@@) % كما استصرخت كفيك والدهر فاغر % ليمضغها لا قانعا بعذامها % % 59(@)(@@) % ونادتك نفس والخناق مصمم % على جول طوقيها ومجرى حزامها % % 60(@)(@@) % فكنت مكان السيف نصرا وكالحيا % % أعاد رضاع الأرض بعد فطامها % % PageV01P2315 61(@)(@@) % عوايد من نعماك يرجع وصلها % % جديدا إذا ما خفت 
ms737	 وشك انصرامها % % 62(@)(@@) % إذا سألت حكمتها ونزلت بالس % ماح على سلطانها واحتكامها % % 63(@)(@@) % فإن أمسكت بقيا عليك وحشمة % تبرعت سعيا في زوال احتشامها % % 64(@)(@@) % فلا عدمتك فارجا لمضيقها % % وبابا إلى ما استصعبت من مرامها % % 65(@)(@@) % وجاءتك أيام التهاني بوفدها % % تخبر عن تخليدها ودوامها % % 66(@)(@@) % لأجيادها من حليها ما تعلقت % به حلقا أطواقها من حمامها % % 67(@)(@@) % فيأخذ يوم المهرجان اصطفاءه % % بحصته من فذها وتؤامها % % 68(@)(@@) % فللعيد من مرباعها وفضولها % % سهام الملوك حكمت في سهامها % % 69(@)(@@) % له قدم الإسلام والفوز في غد % بجنة عدن بردها وسلامها % % 70(@)(@@) % ففز بهما واشدد على العز فيهما % % عرى لا يرى خطب مكان انفصامها % % PageV01P2316 71(@)(@@) % أشم العلا ما لامس الأرض حافر % وما ثقلت بأحدها وشمامها % % 72(@)(@@) % وما أحرزت نفس تقاها شعارها % % لذخر غد من فطرها وصيامها % % PageV01P2317 البحر : - 1(@)(@@) % ردوا لها أيامها بالغميم % إن كان من بعد شقاء نعيم % 2(@)(@@) % وأفرجوا عن طرقات الحمى % % لها عن المعوج والمستقيم % 3(@)(@@) % تنفضها ثم قضى ما قضى ال % % وخد على أثباجها والرسيم % 4(@)(@@) % فثم أدراج مطافيلها % % ومنزل الأينق تحت القروم % 5(@)(@@) % وحيث جم الماء واستسمنت % % غوارب جم برعي الجميم % 6(@)(@@) % ردوا عن الأعناق أرسانها % % وكرموها عن عضاض الخطيم % 7(@)(@@) % ولا تدلوها فقدامها % % أدلة الشوق وهادى الشميم % 8(@)(@@) % وفوقها كل أخى صبوة % % إذا الصبا هبت غذاه النسيم % 9(@)(@@) % يرى بنجد وبسكانه % % ثروة ذي العدم وبرء السقيم % 10(@)(@@) % قلوبهم رق لأهل الحمى % % حيث النواصي حرة والجسوم % % PageV01P2318 11(@)(@@) % وكم بنجد لك من قاتل % لم يتحرج من مقام الأثيم % 12(@)(@@) % وجارح تكلم ألحاظه % وهي إذا شاء دواء الكلوم % 13(@)(@@) % وموقف بالنعف تهفو به % % سفاهة الحب بلب الحليم % 14(@)(@@) % وأم خشف لو أحست هوى % عن ريمها لم تتعطف لريم % 15(@)(@@) % وكاتم يغرى بأسراره % % في هدب الأجفان دمع نموم % 16(@)(@@) % قضية يكذب أشهادها % % ويقبل الحاكم دعوى الغريم % 17(@)(@@) % تجتمع الأضداد حينا ولا % % يجتمع الشاكي بها والرحيم % 18(@)(@@) % حلفت بالأدم براها السرى % % بري المدى إلا الذما والأديم % 19(@)(@@) % طلائح يأخذ مجهودها % % رعي الموامي واحتساء السموم % 20(@)(@@) % كل سنام 
ms738	 حالق حته الس % % ير وجنب بالحوايا جليم % PageV01P2319 21(@)(@@) % تحطمها بغية إنجازها % % ميعاد شعث وعدوها الحطيم % % 22(@)(@@) % لولا ابن أيوبوآباؤه % % ما نهضت محصنة عن كريم % 23(@)(@@) % قوم إذا ما احتجزوا بالحبى % % قالوا فكانوا شرقا للخصوم % 24(@)(@@) % أو عد مجد الناس أطرافه % وجنبه عدوهم في الصميم % 25(@)(@@) % أو ركبوا الخيل إلى مأزق % تبدلوا الهام بفوس الشكيم % 26(@)(@@) % بيض المجاني نور أوضاحهم % % يشدخ في وجه الزمان البهيم % 27(@)(@@) % إن كوثروا سدوا مسد الحصا % % أو فوخروا أغنوا غناء النجوم % 28(@)(@@) % أو قطرت في المحل أيديهم % بانت بها آثار بخل الغيوم % 29(@)(@@) % عندك منهم بأبي طالب % ما وصف الحادث فضل القديم % 30(@)(@@) % قامت بآثارهم عينه % وزاد والخمرة بنت الكروم % PageV01P2320 31(@)(@@) % والمجد لا يحرز إلا إذا % % رافد عز النفس طيب الأروم % 32(@)(@@) % إلى عميد الرؤساء انبرت % % تحت بني الحاج بنات العزيم % 33(@)(@@) % يطلبن حر الوجه حلو القرى % % عشيرة الواحد مال العديم % 34(@)(@@) % أروع لا ترهقه خطة % يعثر بالمقعد فيها المقيم % 35(@)(@@) % ولا ترى همته في العلا % % تحط فيها نازلات الهموم % 36(@)(@@) % تنتظم الحزم سياساته % % نظم كعوب الرمح إلا الوصوم % 37(@)(@@) % ذب عن الدين بآرائه % % فالدين من تدبيره في حريم % 38(@)(@@) % وجاهدت عن خلفاء الهدى % % خالصة منه بقلب سليم % 39(@)(@@) % هم نصبوه دون أيامهم % % فانحل عنها كل خطب جسيم % 40(@)(@@) % ذخيرة منه تواصوا بها % % خلفها ظاعنهم للمقيم % PageV01P2321 41(@)(@@) % وزارة موروثها تالد % والبدر للشمس وزير قديم % 42(@)(@@) % مجلسه منها لآبائه % % سيفا فسيفا ينتضي أو يشيم % 43(@)(@@) % أعشب قوم بولاياتهم % % والنصح يرضيه برعى الهشيم % 44(@)(@@) % يخصه الكامل من فضله % % وماله مشترك للعموم % 45(@)(@@) % ما عابه عصيان لوامه % % والعيب في الجود على من يلوم % 46(@)(@@) % يا من قصرت العمر في ظله % % ورفده أرتع أو أستنيم % 47(@)(@@) % ورضت صرف الدهر أو لان لي % % فلم أبل يجمح بي أو يقوم % 48(@)(@@) % بحر أماني على مائه % % يفهق ريا والأماني تحوم % 49(@)(@@) % وعروة في الود ممسودة % تحت يدي والود حبل رميم % 50(@)(@@) % تلون الناس بألوانهم % % على والتاث الصديق الحميم % PageV01P2322 51(@)(@@) % وكدرت تلك الركايا على 
ms739	 % % دلوى فما أشرب غير الوخيم % 52(@)(@@) % وأنت والسلطان ما نلته % % موطأ الظهر سليس الحزيم % 53(@)(@@) % وإن يكن صد يسوء الهوى % % أو جفوة تهتك ستر الكتوم % 54(@)(@@) % أو يقذ وقت ثم يجلى القذى % % فالجو لا يمطر حتى يغيم % 55(@)(@@) % فابق أزرك الباقيات التي % % تدرج الأرض وليست تريم % 56(@)(@@) % ما وسمت عرضا على أنه % % حل وإلا جملته الوسوم % 57(@)(@@) % رسومها خالدة عندكم % % ليس كما ينهج بالى الرسوم % 58(@)(@@) % تحمل منها كل ريحانة % % صبيحة النيروز يوم القدوم % 59(@)(@@) % كأنها تحفة طيف الكرى % % بالحب أو نخبة كأس النديم % 60(@)(@@) % واجتلها والود إن أمهرت % أنفس ما تمنح أو ما تروم % PageV01P2323 61(@)(@@) % ودم وما أعطيت من نعمة % لا أسأل الله سوى أن تدوم % PageV01P2324 البحر : - 1(@)(@@) % عمى صباحا بعدنا واسلمي % % يا دار صفراء على الأنعم % 2(@)(@@) % واحتلبي المزن أفاويقها % % بين سماكيها إلى المرزم % 3(@)(@@) % مرضعة تفطم أولادها % % من الثرى الجم ولم تفطم % 4(@)(@@) % حتى ترى واسم روض الحمى % % عليك خصبا أثر الميسم % 5(@)(@@) % وتخطري من خلل الزهر في ال % % مفوف الموشي والمعلم % 6(@)(@@) % ومليت أرضك ما تحمل ال % % ريح إليها من هدايا السمي % % 7(@)(@@) % دعاء من أقنعه البين بع % % د العين بالآثار والمعلم % 8(@)(@@) % بكى النوى أمس فلم يدخر % دمعا يفيض اليوم في الأرسم % 9(@)(@@) % خان بكاء العين أجفانه % % فناح والنوح بكاء الفم % 10(@)(@@) % تكلمي إن كنت قوالة % هيهات أو فاستمعي وافهمي % % PageV01P2325 11(@)(@@) % ومن بليات الهوى أنني % % أستفصح الأخبار من معجم % 12(@)(@@) % أهلك لا أهلك إلا الشجا % % في الصدر لم يلفظ ولم يكظم % 13(@)(@@) % بأي عيش حادث بدلوا % % من عيشنا في ظلك الأقدم % 14(@)(@@) % وأي أرض حملت أرضهم % % فلم تمد خسفا ولم تظلم % 15(@)(@@) % كم خفروا ذمة مستسلم % واحتقروا قتل امرئ مسلم % 16(@)(@@) % وأجرمت عين فساقوا الضنا % % إلى فؤاد ليس بالمجرم % 17(@)(@@) % وليلة بت سهادي بها % % لديك أحلى من كرى النوم % 18(@)(@@) % معتصما من حر وجدي ببر % % د الحلي في جيد وفي معصم % 19(@)(@@) % ندمان غضبان يريني الرضا % % ومانع في صورة المنعم % 20(@)(@@) % تلين تحت الدل أعطافه 
ms740	 % % وهو إذا استعطف لم يرحم % PageV01P2326 21(@)(@@) % أمزج كأسي معه بالبكا % % منه ولا أشرب إلا دمي % % 22(@)(@@) % فكيف يشفيني جنى ريقه % % ووعده الإبدال بي مسقمي % % 23(@)(@@) % الله لي من زمن مائل % علي جورا كيف قلت احكم % 24(@)(@@) % وصاحب لو نقل الأرض ما % % رأى عقالا لي في المغنم % 25(@)(@@) % يقسم بالوافي وبالبخس في ال % % ناس وعندي خيبة المقسم % 26(@)(@@) % ولو رعى الحق وإنصافه % % ما فاز بالقدح سوى أسهمي % % 27(@)(@@) % للدهر عندي ولأبنائه % % بعد اجتماعي وثبة الأرقم % 28(@)(@@) % ووقفة لا يبلغ الجرح ما % % يبلغ مفضى قولها المؤلم % 29(@)(@@) % تغادر الغدر قتيلا على % % غرب حسام الكلم المخذم % 30(@)(@@) % وتصبح الأعراض من بعدها % % مفضوحة في موسم موسم % PageV01P2327 31(@)(@@) % لكن بيتا من بيوت العلا % % بعد مشيد المجد لم يهدم % 32(@)(@@) % تضمني حوطة أبنائه % % ضم وفاض النبل للأسهم % 33(@)(@@) % كأن أيديهم على خلتي % % عصائب الجبر على الأعظم % 34(@)(@@) % بيت بنى أيوب أركانه ال % % عليا بناء الموثق المحكم % 35(@)(@@) % وتم من أبنائه بعده % % بالمسند الضابط والمدعم % 36(@)(@@) % رحل إليهم كل خراجة % من مخرم غفل إلى مخرم % 37(@)(@@) % تدوس باليمنى شمالا كما % % قارن زند القادح الأجذم % 38(@)(@@) % لا يخلق الليل لألحاظها % % وحشة عين العاكر المعتم % 39(@)(@@) % إذا احتذت أرجلها بالحصا % % خدمها الإسآد بالعندم % 40(@)(@@) % إلى عميد الرؤساء انبرت % تلاحك الغارب بالمنسم % PageV01P2328 41(@)(@@) % إلى فتى يسفر عن بشره ال % % أبيض وجه الزمن الأقتم % 42(@)(@@) % أبلج يستعدى بإقباله % % على هجوم القدر الأشأم % 43(@)(@@) % وتفتح الصفقة في كفه % % رتاج باب الأمل المبهم % 44(@)(@@) % يفقره الجود وفيه الغنى % % والجود قدما ثروة المعدم % 45(@)(@@) % وينزل العسر بمستصغر % لديه والشكر بمستعظم % 46(@)(@@) % يمد كفا في الندى سبطة % % بعضة النادم لم تكلم % 47(@)(@@) % لو قرنت بالبحر لم تحتشم % أو مسحت بالنجم لم يظلم % 48(@)(@@) % للرشف واللثم مكان بها % % ينبو عن الدينار والدرهم % 49(@)(@@) % أرضى الإمامين وفاء له % % وذمة بالغدر لم تذمم % 50(@)(@@) % وذب عن ملكهما صارم % من رأيه بالعجز لم يثلم % PageV01P2329 51(@)(@@) % آزره أو عز مستبصرا % % في الحق لم يرتب ولم يوهم % 52(@)(@@) % تعصمه العفة والعز 