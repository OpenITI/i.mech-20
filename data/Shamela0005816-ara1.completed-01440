ms1421	 وكيع بن الجراح ثنا عنه بن خزيمة(@)(@@)(@@)(@@) $ 12758 - جعفر بن محمد بن الحجاج القطان من أهل الكوفة يروي عن أبي نعيم وكان راويا لمحمد بن أبي أسامة الحلبي ثنا عنه محمد بن المنذر بن سعيد(@)(@@)(@@)(@@) $ 12759 - جعفر بن محمد بن سعيد الحلبي من أهل الكوفة يروي عن أبي نعيم روى عنه أهل العراق(@)(@@)(@@)(@@) $ 12760 - جعفر بن محمد بن جعفر المدائني يروي عن يزيد بن هارون وأبيه روى عنه أهل واسط PageV08P162(@)(@@)(@@)(@@) $ 12761 - جعفر بن محمد القلاسى من أهل الرملة يروي عن أبي الوليد روى عنه أهل بلده(@)(@@)(@@)(@@) $ 12762 - جعفر بن محمد الصائغ العابد من أهل بغداد يروي عن أبي نعيم وأبى غسان حدثنا عنه أحمد بن زنجويه كنيته أبو الفضل وهو جعفر بن محمد بن شاكر(@)(@@)(@@)(@@) $ 12763 - جعفر بن محمد بن أبان بن مسمول مولى أبي حاتم بن النعمان الباهلي من أهل حران يروي عن أبي نعيم ثنا عنه مكحول وغيره مات سنة أربع وستين ومائتين وكان متيقظا يحفظ(@)(@@)(@@)(@@) $ 12764 - جابر بن إسماعيل المصري يروي عن عقيل بن خالد روى عنه عبد الله بن وهب(@)(@@)(@@)(@@) $ 12765 - جابر بن إسحاق الباهلي شيخ يروي عن أبي معشر السدى روى عنه عمرو بن علي الفلاس مستقيم الحديث(@)(@@)(@@)(@@) $ 12766 - جابر بن عبد الرحمن بن عمرو السلمي يروى عن أبيه PageV08P163 روى عنه المصريون(@)(@@)(@@)(@@) $ 12767 - جابر بن غانم السلفي من أهل حمص يروي عن شبيب بن نعيم الكلاعي وسليم بن عامر الخبائري قالا الصف الأول في الصلاة والصف المؤخر في الجنازة أفضل روى عنه بقية بن الوليد الواسطي يروي عن يزيد بن هارون وغندر ثنا عنه علي بن عبد الله بن مبشر الواسطي وغيره من شيوخنا(@)(@@)(@@)(@@) $ 12768 - جميل بن الحسن الحمصي بصرى يروي عن أبي همام الأهوازي وعبد الله بن داود الخريبي ثنا عنه أحمد بن عبدان التستري بعبادان يغرب(@)(@@)(@@)(@@) $ 12769 - الجراح بن الضحاك الكندي من أهل الكوفة يروي عن علقمة بن مرثد روى عنه علي بن مجاهد(@)(@@)(@@)(@@) $ 12770 - الجراح بن مليح البهراني من أهل حمص يروي 
ms1422	 عن الزبيدي وبكر بن عمر روى عنه الهيثم بن خارجة(@)(@@)(@@)(@@) $ 12771 - الجراح بن مخلد القزاز من أهل البصرة يروي عن بن عيينة وأبى عاصم والبصريين حدثنا عنه إسحاق بن إبراهيم القاضي وغيره PageV08P164(@)(@@)(@@)(@@) $ 12772 - جنادة بن سلم العامري السوائي كنيته أبو الحكم من أهل الكوفة يروي عن عبيد الله بن عمر والكوفيين روى عنه سهل بن عثمان العسكري برواية سالم بن جنادة(@)(@@)(@@)(@@) $ 12773 - جنادة بن محمد بن أبي يحيى المري من أهل دمشق كنيته أبو عبد الله يروي عن عيسى بن يونس وابن أبي العشرين روى عنه إبراهيم بن يعقوب الجوزجاني ويعقوب بن سفيان وأهل الشام(@)(@@)(@@)(@@) $ 12774 - جارية بن هرم أبو شيخ الفقيمي من أهل البصرة يروي عن يعقوب بن عطاء روى عنه عمرو بن مالك النكري ربما أخطأ(@)(@@)(@@)(@@) $ 12775 - جمعة بن عبد الله البلخي أبو بكر يروي عن أبي مقاتل حفص بن سليم وهشيم ومروان بن معاوية ثنا عنه الحسن بن سفيان مستقيم الحديث ولكنه كان ينتحل مذهب الرأي ثم انتحل السنن وجعل يذب عنها حتى بلغ من صلابتها أن أحمد بن حرب دخل واشجرد ودعا الناس PageV08P165 إلى الأرجاء فأفسد بها عالما منهم فلما بلغ جمعة بن عبد الله ذلك خرج إلى واشجرد فجعل يبين للناس أمره ويصدهم عنه ويخبرهم ببدعته(@)(@@)(@@)(@@) $ 12776 - الجارود بن معاذ السلمي من أهل ترمذ يروي عن وكيع وأبى معاوية مستقيم الحديث روى عنه ابنه محمد بن الجارود وأهل بلده(@)(@@)(@@)(@@) $ 12777 - جعشم بن سعد يروي عن عطاء الخراساني روى عنه محمد بن إسحاق بن يسار(@)(@@)(@@)(@@) $ 12778 - جرى بن عبد العزيز يروي عن أخيه زبان بن عبد العزيز بن عمر بن عبد العزيز قوله روى عنه أبو عبد الرحمن المقرىء(@)(@@)(@@)(@@) $ 12779 - جرى بن شداد بن صبيح من أهل الرملة يروي عن بن عيينة روى عنه يعقوب بن سفيان حدثني الحسن بن سفيان حدثني الحسين بن إسحاق الأصبهاني حدثني إسماعيل بن محمد بن يوسف ثنا جامع بن صبيح قال قال فضيل بن عياض من زوج كريمته من مبتدع 
ms1423	 فقد قطع رحمها(@)(@@)(@@)(@@) $ 12780 - جميع بن عمر بن عبد الرحمن العجلي يروي عن يزيد بن عمر روى عنه مالك بن إسماعيل وسفيان بن وكيع(@)(@@)(@@)(@@) $ 12781 - جرول بن جيفل أبو توبة الجزري من أهل حران يروي عن عيسى بن سنان روى عنه يحيى بن عبد الحميد الحماني ربما خالف PageV08P166(@)(@@)(@@)(@@) $ 12782 - جهضم بن عبد الله اليمامي يروي عن يحيى بن أبي كثير أصله من خراسان هرب من أبي مسلم وانتقل إلى اليمامة فسكنها روى عنه أهل اليمامة(@)(@@)(@@)(@@) $ 12783 - جمهور بن منصور يروي عن يوسف بن الماجشون وهشيم روى عنه الحضرمي(@)(@@)(@@)(@@) $ 12784 - جندل بن والق التغلبي أبو على الكوفي يروي عن الكوفيين وعبيد الله بن عمرو الرقى روى عنه أبو زرعة وأهل العراق(@)(@@)(@@)(@@) $ 12785 - الجنيد بن بهرام الرجاني من أهل رجان يروي عن يزيد بن هارون حدثنا عنه يوسف بن بشر بن حمزة بحصن مهدىء مستقيم الحديث(@)(@@)(@@)(@@) || (باب الحاء)(@)(@@) قال أبو حاتم رضي الله عنه وممن روى من أتباع الأتباع ممن ابتدا اسمه على الحاء(@)(@@)(@@)(@@) $ 12786 - الحسن بن يحيى المروزي يروي عن كثير بن زياد روى عنه بن المبارك(@)(@@)(@@)(@@) $ 12787 - الحسن بن عقبة أبو كيران المرادي يروي عن الضحاك مزاحم روى عنه عبيد الله بن موسى وأبو نعيم PageV08P167(@)(@@)(@@)(@@) $ 12788 - الحسن بن علي بن حسن بن أبي الحسن أبو على المرادي من أهل المدينة يروي عن أبي مودود والزبير بن سعيد روى عنه إبراهيم بن المنذر الحزامي(@)(@@)(@@)(@@) $ 12789 - الحسن بن محمد الليثي أبو محمد البلخي كان على قضاء مرو يروي عن مقاتل بن حيان والناس روى عنه أهل مرو الحكايات وكان بن المبارك يميل إليه وكان في أيامه على القضاء بها(@)(@@)(@@)(@@) $ 12790 - الحسن بن عبد الرحمن بن العريان الحارثي كنيته أبو محمد من أهل البصرة يروى عن بن عون روى عنه أبو موسى وأهل البصرة(@)(@@)(@@)(@@) $ 12791 - الحسن بن قتيبة الخزاعي شيخ من أهل المدائن سكن بغداد يروي عن مسعر بن كدام وشعبة روى عنه بن أبي شيبة وأهل العراق كان يخطىء ويخالف(@)(@@)(@@)(@@) $ 12792 - الحسن 
ms1424	 بن زياد يروي عن بن جريج عن عكرمة بن عمار عن محمد بن عبيد بن أبي قدامة عن عبد العزيز بن اليمان أخي حذيفة بن اليمان قال كان رسول الله صلى الله عليه وسلم إذا حزبه أمر فزع إلى الصلاة روى عنه إسماعيل بن موسى الفزاري(@)(@@)(@@)(@@) $ 12793 - الحسن بن سهيل التياس يروى عن أبى عبيدة الناجي PageV08P168 الحكايات روى عنه حماد بن فرافصة البلخي من أهل بلخ وغيره كأنه كان بلخيا(@)(@@)(@@)(@@) $ 12794 - الحسن بن إبراهيم أبو حاتم ختن وهيب بن خالد يروي عن البصريين وقد جالس فرقد السنجي روى عنه موسى بن إسماعيل(@)(@@)(@@)(@@) $ 12795 - الحسن بن عياش مولى بنى أسد أخو أبي بكر بن عياش من أهل الكوفة يروي عن الثوري وزائدة روى عنه عبد الرحمن بن أبي حماد الكوفي(@)(@@)(@@)(@@) $ 12796 - الحسن بن صالح بن أبي الأسود الليثي يروي عن عمه منصور بن أبي الأسود وأهل العراق روى عنه أحمد بن عبدة الضبي(@)(@@)(@@)(@@) $ 12797 - الحسن بن حبيب بن ندبة الكوسج كنيته أبو سعيد من أهل البصرة يروي عن روح بن القاسم روى عنه البصريون(@)(@@)(@@)(@@) $ 12798 - الحسن بن بشر الكوفي أبو على الهمداني وقد قيل إنه بن بشر بن مسلم بن المسيب البجلي يروي عن زهير بن معاوية والمعافي بن عمران روى عنه محمد بن يحيى والعراقيون مات بعد الثمانين PageV08P169(@)(@@)(@@)(@@) $ 12799 - الحسن بن علي بن عاصم الواسطي يروى عن الأوزاعي عن سليمان بن حبيب أن بن عمر قال لو أدخلت أصبعي في جمرة ما أحببت أن تتبعني روى عنه محمد بن عبد الله بن المبارك المخزومي ومات الحسن بن علي في حياة أبيه(@)(@@)(@@)(@@) $ 12800 - الحسن بن عثمان قاضي بخارا يروي عن وكيع والعنقري روى عنه أهل بلده مستقيم الحديث(@)(@@)(@@)(@@) $ 12801 - الحسن بن نصر بن الحسين بن عثمان بن بشر بن المحتفز من أهل مرو كنيته أبو شداد ممن جالس بن عيينة مدة كان من أهل مرو وهو الذي قام في عزل إبراهيم بن صالح حتى عزل روى عنه المراوزة الحكايات(@)(@@)(@@)(@@) $ 12802 - الحسن 
ms1425	 بن أبي القاسم شيخ يروي عن شريك روى عنه أبو بكر بن أبي الأسود(@)(@@)(@@)(@@) $ 12803 - الحسن بن رشيد من أهل مرو يروي عن إبراهيم الصائغ روى عنه أبو عمار الحسن بن حارث وأهل مرو(@)(@@)(@@)(@@) $ 12804 - الحسن بن موسى الأشيب يروي عن حماد بن سلمة وشريك روى عنه أهل العراق كنيته أبو على وكان أصله من خراسان سكن بغداد ومات بالري سنة تسع ومائتين PageV08P170(@)(@@)(@@)(@@) $ 12805 - الحسن بن محمد بن أعين الحراني أبو على مولى أم عبد الملك بنت مروان يروي عن نافع بن سليمان روى عنه محمد بن يحيى بن كثير الحراني وأهل بلده مات سنة عشر ومائتين(@)(@@)(@@)(@@) $ 12806 - الحسن بن بلال شيخ بصرى يروي عن حماد بن سلمة روى عنه محمد بن خلف العسقلاني(@)(@@)(@@)(@@) $ 12807 - الحسن بن علي بن مسلم أبو عتبة السكوني الحمصي يروي عن معاوية بن يحيى الصدفي وإسماعيل بن عياش روى عنه يعقوب بن سفيان الفارسي(@)(@@)(@@)(@@) $ 12808 - الحسن بن سفيان إمام مسجد طرسوس يروي عن محمد بن حمير ومحمد سمع إبراهيم بن أبي عبلة روى عنه عبد الله بن زيد بن لقمان النهراني(@)(@@)(@@)(@@) $ 12809 - الحسن بن عمرو العبدي يروي عن شعبة بن الحجاج روى عنه محمد بن يحيى الذهلي يغرب(@)(@@)(@@)(@@) $ 12810 - الحسن بن واقع الرملي كنيته أبو على أصله من سرخس سكن الرملة يروي عن الحجازيين وأهل الشام وكان راويا لضمرة بن ربيعة روى عنه إبراهيم بن يعقوب الجوزجاني PageV08P171(@)(@@)(@@)(@@) $ 12811 - الحسن بن خمير الحرازي من أهل الشام يروي عن الجراح بن مليح وإسماعيل بن عياش روى عنه عمران بن بكار الكلاعي وأهل حمص ربما أخطأ(@)(@@)(@@)(@@) $ 12812 - الحسن بن سهرب من أهل بلخ يروي عن بن عيينة روى عنه أهل بلده مات سنة ست وعشرين ومائتين وكان متقنا وكنيته أبو على(@)(@@)(@@)(@@) $ 12813 - الحسن بن الربيع البوراني كنيته أبو على البجلي من أهل الكوفة يروى عن بن المبارك وأبى إسحاق الفزاري روى عنه أهل العراق وهو الذي غمض بن المبارك ودفنه مات سنة عشرين ومائتين وكان من بجيلة(@)(@@)(@@)(@@) $ 12814 
ms1426	 - الحسن بن شبيب البغدادي يروي عن شريك وخلف بن خليفة ثنا عنه أبو يعلى ربما أغرب(@)(@@)(@@)(@@) $ 12815 - الحسن بن أبي يزيد الكوفي يروى عن بن المبارك قال إن للعلم طغيانا كطغيان المال ثنا محمد بن المعافي العابد ثنا القاسم بن عثمان الجوعي ثنا الحسن بن أبى يزيد الكوفى عن بن المبارك(@)(@@)(@@)(@@) $ 12816 - الحسن بن عمر بن شقيق بن أسماء الجرمي أبو على من أهل البصرة يروي عن عبد الوارث وجعفر بن سليمان وأهل البصرة PageV08P172 وكان راويا لعبد الله بن أبي جعفر الرازي حدثنا عنه الحسن بن سفيان وأبو يعلى وكان يتجر إلى بلخ فكتب عنه أهلها وقد قيل عمرو بن شقيق بن النضر(@)(@@)(@@)(@@) $ 12817 - الحسن بن جعفر من أهل بخارا ثقة قال رأيت بن المبارك عند مخلد بن الحسين كأنه عصفور عند بازي روى عنه هانئ بن النضر الحارثي وأهل بلده(@)(@@)(@@)(@@) $ 12818 - الحسن بن محمد الطنافسي بن أخت يعلى بن عبيد من أهل الكوفة يروي عن بن فضيل ووكيع حدثنا عنه أحمد بن محمد بن سعيد التستري تحول إلى قزوين وسكن بها(@)(@@)(@@)(@@) $ 12819 - الحسن بن زياد المحاربي كنيته أبو علي مؤذن مسجد محارب من أهل الكوفة يروي عن عبد الرحمن بن محمد المحاربي روى عنه يعقوب بن سفيان(@)(@@)(@@)(@@) $ 12820 - الحسن بن خالد اليشكري يروي عن حزم بن أبي حازم عن الحسين ثنا عنه الحسن بن سفيان مستقيم الحديث PageV08P173(@)(@@)(@@)(@@) $ 12821 - الحسن بن عيسى بن ماسرجس مولى بن المبارك كنيته أبو على يروي عن بن المبارك وجرير روى عنه أهل نيسابور وكان يسكنها مات منصرفا من الحج بالثعلبية سنة تسع وثلاثين ومائتين(@)(@@)(@@)(@@) $ 12822 - الحسن بن هارون بن العقار يروي عن أبي خالد الأحمر الغرائب ثنا عنه محمد بن إسحاق بن إبراهيم الثقفى وهو بن أخي سلمة بن العقار(@)(@@)(@@)(@@) $ 12823 - الحسن بن علي الواسطي يروي عن يزيد بن هارون حدثنا عنه الحسن بن سفيان وغيره من شيوخنا مستقيم الحديث جدا(@)(@@)(@@)(@@) $ 12824 - الحسن بن محمد الكرابيسي من أهل البصرة يعرف ب شعبة الصغير من 
ms1427	 تيقظه يروي عن أبي عاصم والبصريين حدثنا عنه الحسن بن سفيان(@)(@@)(@@)(@@) $ 12825 - الحسن بن عيسى الحربي من أهل المصيصة يروى عن بن عيينة وأهل العراق روى عنه أهل الثغر كان يخطىء أحيانا(@)(@@)(@@)(@@) $ 12826 - الحسن بن شاذان الواسطي يروي عن أبي عاصم وأهل البصرة روى عنه أهل العراق(@)(@@)(@@)(@@) $ 12827 - الحسن بن أحمد بن أبي شعيب الحراني أبو مسلم يروي عن أبي نعيم وأهل العراق وكان راويا لمسكين بن بكير حدثنا عنه محمد PageV08P174 بن الحسن بن مكرم وشيوخنا(@)(@@)(@@)(@@) $ 12828 - الحسن بن إسحاق بن زياد المروزي يروى عن بن المبارك روى عنه المراوزة مات سنة إحدى وأربعين ومائتين(@)(@@)(@@)(@@) $ 12829 - الحسن بن حماد العطار من أهل مرو يروي عن أبي حمزة وأهل بلده روى عنه المراوزة حدثنا عبد الله بن محمود السعدي ثنا الحسن بن حماد العطار ثنا أبو حمزة السكري محمد بن ميمون في سنة ست وستين ومائة ثنا إبراهيم الصائغ حدثني حماد عن إبراهيم قال قال علي بن أبي طالب التوفيق خير قائد وحسن الخلق خير قرين والعقل خير صاحب والأدب خير ميراث ولا ظهر أفضل من المشورة ولا وحشة أشد من العجب وبإسناده عن إبراهيم قال جمع علي بن أبي طالب الدنيا والآخرة بخمس كلمات قال يقول اللهم إني أسألك من الدنيا وما فيها ما أسد به لساني وأحصن به فرجي وأؤدي به عن أمانتي وأصل به رحمى وأتجر فيه لآخرتى(@)(@@)(@@)(@@) $ 12830 - الحسن بن محمد المروزي من مدينة الداخلة قال سمعت بن عيينة يقول جاءنا من خراسان رجلان بن المبارك وإبراهيم الصائغ روى عنه محمد بن عبد الله بن قهزاد وأهل بلده(@)(@@)(@@)(@@) $ 12831 - الحسن بن حماد الضبي الكوفي أبو علي الذي يقال له سجادة PageV08P175 يروي عن وكيع وأهل بلده حدثنا عنه أبو يعلى وجماعة من شيوخنا مات يوم السبت لثمان بقين من رجب سنة إحدى وأربعين ومائتين(@)(@@)(@@)(@@) $ 12832 - الحسن بن الصباح البزار من أهل بغداد يروي عن عبدة بن سليمان والعراقيين حدثنا عنه الحسن بن سفيان مات سنة تسع وأربعين ومائتين 
ms1428	(@)(@@)(@@)(@@) $ 12833 - الحسن بن علي الحلواني أبو محمد الحلال يروي عن يزيد بن هارون حدثنا عنه شيوخنا مات في ذي الحجة سنة ثلاثين وأربعين ومائتين(@)(@@)(@@)(@@) $ 12834 - الحسن بن شوكر أبو على البغدادي يروي عن إسماعيل بن جعفر روى عنه إبراهيم بن إسحاق الأنصاري(@)(@@)(@@)(@@) $ 12835 - الحسن بن قزعة بن عبيد الهاشمي أبو على الخلقاني من أهل البصرة يروي عن حصين بن نمير وسفيان بن حبيب والبصريين حدثنا عنه عمرو بن محمد الهمداني وغيره(@)(@@)(@@)(@@) $ 12836 - الحسن بن إسماعيل المجالدي يروي عن أبي ضمرة والمدنيين ثنا عنه الحسين بن عبد الله بن يزيد مستقيم الحديث PageV08P176(@)(@@)(@@)(@@) $ 12837 - الحسن بن سهل الجعفي أبو علي من أهل الكوفة يروي عن أبي خالد الأحمر والكوفيين حدثنا عنه الحسن بن سفيان وغيره(@)(@@)(@@)(@@) $ 12838 - الحسن بن إسحاق بن سالم يروي عن وكيع روى عنه الحضرمي(@)(@@)(@@)(@@) $ 12839 - الحسن بن داود المنكدري من أهل المدينة يروي عن بن عيينة وأبى ضمرة حدثنا عنه أبو عروبة مات قبل الموسم سنة سبع وأربعين ومائتين(@)(@@)(@@)(@@) $ 12840 - الحسن بن خلف الواسطي يروي عن يزيد بن هارون وإسحاق الأزرق ثنا عنه أحمد بن محمد بن الأزهر(@)(@@)(@@)(@@) $ 12841 - الحسن بن صالح البزار من أهل واسط يروي عن أبي عاصم ثنا عنه بن خزيمة مستقيم الحديث(@)(@@)(@@)(@@) $ 12842 - الحسن بن محمد بن الصباح أبو على البزار الذي يقال له الزعفراني من أهل بغداد وزعفرانية التي نسبت إليها قرية من السواد يروى عن بن عيينة وكان راويا للشافعي وكان يحضر أحمد وأبو ثور عند الشافعي وهو الذي يتولى القراءة عليه مات في شهر ربيع الأول يوم الإثنين سنة تسع وأربعين ومائتين PageV08P177(@)(@@)(@@)(@@) $ 12843 - الحسن بن شجاع البلخي من أصحاب الحديث من أكثر الرحلة والكتب والحفظ والمذاكرة سمع مكي بن إبراهيم وأبا الوليد الطيالسي وأهل العراق حدثنا عنه محمد بن إسحاق الثقفي(@)(@@)(@@)(@@) $ 12844 - الحسن بن إسرائيل يروي عن عبد الوهاب بن عطاء وأهل العراق ثنا عنه عبدان الجواليقي مستقيم الحديث(@)(@@)(@@)(@@) $ 12845 - الحسن بن السكن الأطروش من أهل بغداد سكن الشام يروي عن عاصم 
ms1429	 وأبى داود الطيالسي حدثنا عنه مكحول مستقيم الحديث(@)(@@)(@@)(@@) $ 12846 - الحسن بن هارون من أهل نيسابور يروي عن مكي بن إبراهيم ثنا عنه أبو حامد السرفي(@)(@@)(@@)(@@) $ 12847 - الحسن بن السكين البلدي يروي عن محمد بن بشر العبدي وأهل العراق حدثنا عنه بن أخيه هارون بن عيسى بن السكين ببلد الموصل(@)(@@)(@@)(@@) $ 12848 - الحسن بن عمران بن ميسرة الأزدي مولى أيوب السختياني بصرى يروي عن أبي عاصم النبيل ثنا عنه عبد الجليل بن مروان بعبادان(@)(@@)(@@)(@@) $ 12849 - الحسن بن عبد الرحمن بن محمد بن عبد الرحمن بن أبى ليلى PageV08P178 يروي عن وكيع وأبى نعيم حدثنا عنه الحسن بن سفيان مستقيم الحديث إذ لم يكن في إسناد خبره ضعيف(@)(@@)(@@)(@@) $ 12850 - الحسن بن إبراهيم بن موسى البغدادي أبو على سكن مكة يقال له البياضي يروى عن أبى كناسة وعبيد الله بن موسى حدثنا عنه عبد الرحمن بن قريش أبو نعيم وغيره(@)(@@)(@@)(@@) $ 12851 - الحسن بن الخليل الحلبي يروي عن أبي نعيم الفضل بن دكين حدثنا عنه محمد بن المنذر بن سعيد(@)(@@)(@@)(@@) $ 12852 - الحسن بن عرفة بن يزيد العبدي كنيته أبو على من أهل بغداد يروي عن هشيم وابن المبارك روى عنه أهل العراق مات سنة ثلاث أو اثنتين وخمسين ومائتين(@)(@@)(@@)(@@) $ 12853 - الحسن بن علي الميموني أبو على يروي عن أبي نعيم ويحيى بن السكين روى عنه أحمد بن محمد المنكدر(@)(@@)(@@)(@@) $ 12854 - الحسن بن سلام السواق بغدادي يروي عن عبيد الله بن موسى ثنا شيوخنا محمد بن إسحاق الثقفي وغيره(@)(@@)(@@)(@@) $ 12855 - الحسن بن عبد الرحمن الاحتياطي من أهل الجزيرة كان يسكن PageV08P179 بلد الموصل يروي عن يوسف بن أسباط ثنا عنه شيوخنا محمد بن العباس المدني وغيره(@)(@@)(@@)(@@) $ 12856 - الحسن بن يحيى الأزدي من أهل البصرة يروي عن يزيد وأبى عاصم وكان صاحب حديث حدثنا عنه أحمد بن يحيى بن زهير بتستر وغيره(@)(@@)(@@)(@@) $ 12857 - الحسن بن ثواب شيخ يروي عن يزيد بن هارون حدثنا عنه محمد بن عبد الكريم بن الهيثم بدير عاقول(@)(@@)(@@)(@@) $ 12858 - الحسن بن أبي الربيع الجرجاني أبو 
ms1430	 على من أهل بغداد يروي عن يزيد بن هارون وعبد الرزاق ثنا عنه محمد بن المنذر وغيره واسم أبي الربيع يحيى(@)(@@)(@@)(@@) $ 12859 - الحسن بن محمد بن الحارث من أهل سجستان صاحب سنة وفضل يروي عن أبي نعيم روى عنه أهل بلده(@)(@@)(@@)(@@) $ 12860 - الحسن بن مكرم بن حسان البزار من أهل بغداد يروي عن يزيد بن هارون وأبى عاصم حدثنا عنه يحيى بن علي بن خلف القطان وغيره كنيته أبو على(@)(@@)(@@)(@@) $ 12861 - الحسن بن كليب البغدادي يروي عن عبيد الله بن موسى ثنا عنه محمد بن إسحاق الثقفى يخطىء ويغرب PageV08P180(@)(@@)(@@)(@@) $ 12862 - الحسن بن أبي أمية البغدادي سكن أنطاكية يروي عن يزيد بن هارون وأبى أسامة وأصرم بن حوشب ثنا عنه أهل أنطاكية العطار ووصيف وغيرهما واسم أبي أمية محبوب(@)(@@)(@@)(@@) $ 12863 - الحسن بن سهل الخياط يروي عن أبي أسامة والكوفيين روى عنه الحضرمي(@)(@@)(@@)(@@) $ 12864 - الحسن بن علي بن عفان العامري من أهل الكوفة يروي عن معاوية بن هشام وأبى نعيم والكوفيين ثنا عنه زكريا بن يحيى الساجي وغيره كنيته أبو محمد(@)(@@)(@@)(@@) $ 12865 - الحسن بن سهل بن عبد العزيز المجوز من أهل البصرة يروي عن أبي عاصم والبصريين يحدث عنه أصحابنا ربما أخطأ(@)(@@)(@@)(@@) $ 12866 - أبو العنبس الذي يروي عن أبي العدبس اسمه الحارث من أهل الكوفة يروي عن مسعر بن كدام يعتبر حديثه إذا روى عن الثقات المشاهير(@)(@@)(@@)(@@) $ 12867 - الحارث بن غصين أبو وهب الثقفي يروي عن عطاء بن السائب روى عنه حسين الجعفي(@)(@@)(@@)(@@) $ 12868 - الحارث بن عمر يروي عن جناح مولى ليلى عن عائشة بنت سعد عن أبيها روى عنه بن أبى فديك PageV08P181(@)(@@)(@@)(@@) $ 12869 - الحارث الغنوي يروي عن بكير بن الأخنس روى عنه هشيم بن بشير(@)(@@)(@@)(@@) $ 12870 - الحارث بن سلمان يروي عن عطاء بن السائب روى عنه الكوفيون(@)(@@)(@@)(@@) $ 12871 - الحارث بن منصور أبو منصور الواسطي يروي عن الثوري والحسن بن صالح بن حبى روى عنه يعقوب بن سفيان وأهل العراق يغرب سمعت يحيى بن علي القطان يقول سمعت علي بن عبد الله 
ms1431	 يقول أخبرنا أبو منصور الحارث بن منصور قال سمعت الثوري يقول فضول الدنيا حسرات يوم القيامة(@)(@@)(@@)(@@) $ 12872 - الحارث بن عبد الملك بن عبد الله بن إياس الليثي يروي عن القاسم بن يزيد روى عنه معن بن عيسى القزاز(@)(@@)(@@)(@@) $ 12873 - الحارث بن عبيدة شيخ يروي عن الزبيدي روى عنه عبد الوهاب بن الضحاك القرظي(@)(@@)(@@)(@@) $ 12874 - الحارث بن مسكين المصري مولى بنى فهر كنيته أبو عمرو يروى عن بن عيينة وكان راويا لابن وهب روى عنه أبو زرعة الرازي مات سنة خمسين ومائتين(@)(@@)(@@)(@@) $ 12875 - الحارث بن عطية الحارثي سكن المصيصة من أصدقاء مخلد PageV08P182 بن الحسين يروي عن الأوزاعي روى عنه الحسن بن الصباح وأهل الثغر ربما أخطأ(@)(@@)(@@)(@@) $ 12876 - الحارث بن عبد الله أبو الحسن الهمداني الذي يقال له خازن يروي عن هشيم وأبى معشر ثنا عنه الحسن بن سفيان مستقيم الحديث(@)(@@)(@@)(@@) $ 12877 - الحارث بن مرة بن مجاعة اليمامي الحنفي كنيته أبو مرة يروي عن شيبان بن زهير وهشام بن إسماعيل روى عنه أحمد بن حنبل وعلي بن المديني(@)(@@)(@@)(@@) $ 12878 - الحارث بن سليمان الرملي أبو سليمان يروي عن العراقيين وكان راويا لعقبة بن علقمة روى عنه أبو زرعة وعلي بن داود القنطري يغرب(@)(@@)(@@)(@@) $ 12879 - الحارث بن سريج النقال أصله من خوارزم سكن بغداد يروي عن المعتمر بن سليمان وأهل العراق ثنا عنه أحمد بن الحسن بن عبد الجبار وغيره من شيوخنا سمعت الحسن بن سفيان يقول سمعت الحارث بن سريج النقال يقول أنا حملت الرسالة للشافعي إلى عبد الرحمن بن مهدى فجعل يتعجب ويقول لو كان أقل لتفهم لو كان أقل لتفهم(@)(@@)(@@)(@@) $ 12880 - الحارث بن محمد بن أبي أسامة من أهل واسط يروي عن يزيد بن هارون روى عنه العراقيون والغرباء كان ممن عمر PageV08P183(@)(@@)(@@)(@@) $ 12881 - حسين بن ميمون الخندقي من أهل الكوفة يروي عن عبد الله بن عبد الله الرازي قاضي الري عن عبد الرحمن بن أبي ليلى يروي عنه هاشم بن البريد ربما أخطأ(@)(@@)(@@)(@@) $ 12882 - حسين بن عمران الجهني يروي عن عمران 
ms1432	 بن مسلم روى عنه روح بن عطاء(@)(@@)(@@)(@@) $ 12883 - حسين بن عقيل العقيلي من أهل الكوفة يروي عن الضحاك روى عنه أبو نعيم(@)(@@)(@@)(@@) $ 12884 - حسين بن حبيب اليمامي يروي عن يحيى بن أبي كثير روى عنه بن المبارك(@)(@@)(@@)(@@) $ 12885 - حسين بن إسماعيل من أهل تيماء يروي عن الدرباس روى عنه أحمد بن سليمان(@)(@@)(@@)(@@) $ 12886 - حسين بن علي الجعفي كنيته أبو عبد الله مولى الجعفي من أهل الكوفة يروي عن زائدة روى عنه عبد الله بن عرابة وأهل العراق مات سنة ثلاث ومائتين(@)(@@)(@@)(@@) $ 12887 - حسين بن حسين الأشقر أبو عبد الله الفزاري يروى عن PageV08P184 زهير بن معاوية وابن عون روى عنه محمد بن المثنى الزمن(@)(@@)(@@)(@@) $ 12888 - حسين بن حسن بن يسار أبو عبد الله البصري أخو أبي مالك بشر بن الحسين يروى عن بن عون روى عنه أهل البصرة(@)(@@)(@@)(@@) $ 12889 - حسين بن عبد الله من أهل نيسابور يروي عن حسن عن عمرو بن مالك عن أبى الجوزاء عن بن عباس قال اسم الله الأعظم في آل عمران قل اللهم مالك الملك روى عنه مسلم بن عبد الرحمن(@)(@@)(@@)(@@) $ 12890 - حسين بن محمد يروي عن حجاج بن حسان وشعبة روى عنه عبد الرحمن بن مهدى وموسى بن إسماعيل(@)(@@)(@@)(@@) $ 12891 - حسين بن عيسى الحنفي يروي عن معمر بن راشد روى عنه أبو سعيد الأشج(@)(@@)(@@)(@@) $ 12892 - حسين بن محمد أبو على المؤدب البغدادي التميمي أصله من مرو الروذ يروي عن جرير بن حازم ومحمد بن مطرف روى عنه إبراهيم بن سعيد الجوهري(@)(@@)(@@)(@@) $ 12893 - حسين بن عياش الجوهري الباجدائي كنيته أبو بكر يروي عن جعفر بن برقان روى عنه أهل الجزيرة مات سنة أربع ومائتين وهو مولى بنى سماك PageV08P185(@)(@@)(@@)(@@) $ 12894 - حسين بن الوليد أبو على القرشي من أهل نيسابور يروي عن شعبة والثوري روى عنه أهل بلده مات سنة ثلاث ومائتين(@)(@@)(@@)(@@) $ 12895 - حسين بن حفص الأصبهاني كنيته أبو محمد يروي عن الثوري روى عنه عمرو بن علي الفلاس وأهل بلده مات سنة عشر أو إحدى عشرة ومائتين 
ms1433	(@)(@@)(@@)(@@) $ 12896 - حسين بن منصور أبو على النيسابوري يروي عن مبشر بن عبد الله بن رزين وعبد الله بن نمير وأبى أسامة ثنا عنه الحسن بن سفيان ومحمد بن إسحاق الثقفي مات سنة ثمان وثلاثين ومائتين قبل بشر بن الحكم(@)(@@)(@@)(@@) $ 12897 - حسين بن الضحاك من أهل نيسابور يروي عن إسماعيل بن جعفر وعثمان بن مطر الشيباني حدثنا عنه محمد بن شادل الهاشمي يغرب(@)(@@)(@@)(@@) $ 12898 - حسين بن زياد أبو على المروزي مولى بنى علاقة سكن طرسوس يروي عن فضيل بن عياض روى عنه إسحاق بن الجراح الآدمي وأبو عمار المروزي روى عنه أهل الثغر مات سنة عشرين ومائتين PageV08P186(@)(@@)(@@)(@@) $ 12899 - حسين بن معاذ بن خليف من أهل البصرة يروي عن بن أبي عدى والبصريين ثنا عنه الحسن بن سفيان وغيره(@)(@@)(@@)(@@) $ 12900 - حسين بن عمرو بن محمد العنقري من أهل الكوفة يروي عن أبيه والبصريين ثنا عنه علي بن أحمد الجرجاني بحلب(@)(@@)(@@)(@@) $ 12901 - حسين بن عبد الأول النخعي أبو عبد الله الكوفي الأحول يروي عن حفص بن غياث والكوفيين روى عنه علي بن عبد الكريم بن الهيثم وأهل بلده(@)(@@)(@@)(@@) $ 12902 - حسين بن معمر بن عمر المازني البصري يروي عن أبي عاصم وعبد الله بن حسان العنبري روى عنه الحضرمي(@)(@@)(@@)(@@) $ 12903 - حسين بن حريث أبو عمار المروزي الخزاعي مولى الحسن بن ثابت بن قحطبة مولى عمران بن حصين يروي عن الفضل بن موسى السيناني حدثنا عنه الحسن بن سفيان وغيره مات بقرميسين منصرفا من الحج سنة أربع وأربعين ومائتين PageV08P187(@)(@@)(@@)(@@) $ 12904 - حسين بن علي بن يزيد الصدائي وصداء من اليمن يروي عن وكيع وأهل العراق حدثنا عنه محمد بن إسحاق بن إبراهيم مولى ثقيف مات سنة ثمان وأربعين ومائتين(@)(@@)(@@)(@@) $ 12905 - حسين بن عيسى بن حمران البسطامي أبو على يروي عن يزيد بن هارون والعراقيين ثنا عنه بن خزيمة وغيره مات سنة سبع وأربعين ومائتين(@)(@@)(@@)(@@) $ 12906 - حسين بن يزيد القرشي أبو عبد الله الطحان من أهل الكوفة يروي عن وكيع ثنا عنه الحسن بن سفيان وغيره(@)(@@)(@@)(@@) $ 12907 
ms1434	 - حسين بن عبد الرحمن الجرجرائي يروي عن عبد الله بن نمير ويزيد بن هارون ثنا عنه أهل واسط(@)(@@)(@@)(@@) $ 12908 - حسين بن مهدى الأبلى أبو سعيد يروي عن الأنصاري وعبد الرزاق ثنا عنه شيوخنا إسحاق بن إبراهيم القاضي وغيره(@)(@@)(@@)(@@) $ 12909 - حسين بن محمد بن شنبة يروي عن يزيد بن هارون حدثنا عنه شيوخنا(@)(@@)(@@)(@@) $ 12910 - حسين بن قزعة الباهلي أبو الحسن أخو الحسن بن قزعة يروى PageV08P188 عن علي بن عباس وأهل العراق روى عنه إبراهيم بن إسحاق الأنصاري(@)(@@)(@@)(@@) $ 12911 - حسين بن محمد بن أبي معشر المدني من أهل العراق يروي عن وكيع بن الجراح كنيته أبو بكر ثنا عنه أصحابنا(@)(@@)(@@)(@@) $ 12912 - حسين بن محمد مهيار الحافظ من أهل البصرة يروي عن أبي الوليد الطيالسي والناس ثنا عنه إبراهيم بن محمد بن عباد الغزال بالبصرة كان ممن عنى بعلم الحديث وشرع في تصنيف كتاب التاريخ إلا أن الموت عاجله فحيل بينه وبين ما نوى فلم يظهر له كثير علم(@)(@@)(@@)(@@) $ 12913 - حسين بن أبي السرى العسقلاني أخو محمد بن أبي السرى يروي عن وكيع وأهل الشام حدثنا عنه بن قتيبة يخطىء ويغرب(@)(@@)(@@)(@@) $ 12914 - حسين بن علي الكرابيسي أبو على من أهل بغداد يروي عن يزيد بن هارون والعراقيين حدثنا عنه الحسن بن سفيان وكان ممن جمع وصنف ممن يحسن الفقه والحديث ولكن أفسده قلة عقله فسبحان من رفع من شاء بالعلم اليسير حتى صار علما يقتدى به ووضع من شاء مع العلم الكثير حتى صار لا يلتفت إليه PageV08P189(@)(@@)(@@)(@@) $ 12915 - حسين بن محمد الذارع من أهل البصرة يروي عن أبي عاصم والبصريين روى عنه أهل بلده(@)(@@)(@@)(@@) $ 12916 - حسين بن سعيد المخرمي بغدادي يروى عن بن أبي عدى ثنا عنه محمد بن إسحاق بن إبراهيم مولى ثقيف(@)(@@)(@@)(@@) $ 12917 - حسين بن الحسن بن حرب المروزي أبو عبد الله سكن بمكة يروى عن بن المبارك وهشيم ثنا عنه إسحاق بن إبراهيم القاضي وغيره مات قبل الخمسين في سنة ست وأربعين ومائتين(@)(@@)(@@)(@@) $ 12918 - حسين بن سلمة بن إسماعيل بن 
ms1435	 أبي كبشة من أهل البصرة يروي عن أبي عاصم والبصريين حدثنا عنه بن خزيمة وغيره وكان طحانا بالبصرة(@)(@@)(@@)(@@) $ 12919 - حسين بن علي بن الأسود العجلي كوفي يروي عن أبي أسامة والكوفيين ثنا عنه حاجب بن أركين وغيره ربما أخطأ(@)(@@)(@@)(@@) $ 12920 - حسين بن محمد الحجبي من أهل عبادان يروي عن أبي نعيم روى عنه شكر وغيره PageV08P190(@)(@@)(@@)(@@) $ 12921 - حسين بن عبد الله بن حمران الرقى سكن الجبل يروي عن عصمة بن فضالة الخزرجي عن موسى بن عقبة ثنا عنه الحسين بن إسحاق الأصبهاني الحلال بالكرخ(@)(@@)(@@)(@@) $ 12922 - حسين بن أبي زيد الدباغ يروي عن يزيد بن هارون وأهل العراق حدثنا عنه أحمد بن يحيى بن زهير وغيره مات سنة أربع وخمسين ومائتين(@)(@@)(@@)(@@) $ 12923 - حسين بن بحر الأهوازي أبو عبد الله يروي عن أبي نعيم ثنا عنه أبو عروبة مات بملطية سنة إحدى وستين ومائتين(@)(@@)(@@)(@@) $ 12924 - حسين بن منصور الرقى يروي عن أبي نعيم وأبى الجواب ثنا عنه وصيف وغيره(@)(@@)(@@)(@@) $ 12925 - حسين بن منصور النيسابوري أبو علويه يروي عن أبي نعيم وكان راويا للحجاج بن محمد الأعور روى عنه محمد بن إسحاق الثقفى(@)(@@)(@@)(@@) $ 12926 - حسين بن معدان الفارسي من أهل فسا يروي عن أبى الوليد PageV08P191 الطيالسي وأهل العراق روى عنه ابنه علي بن الحسين بن معدان وأهل بلده(@)(@@)(@@)(@@) $ 12927 - حسين بن العلاء أبو على الساسي يروي عن علي بن حجر السعدي وكتب عنه أهل بلده مات سنة ثلاث وثمانين ومائتين(@)(@@)(@@)(@@) $ 12928 - حسين بن نوح بن سفيان السلمي من أهل سمرقند يروي عن أبي نعيم وقبيصة والد عبد الجليل روى عنه أهل بلده(@)(@@)(@@)(@@) $ 12929 - حسين بن نصر بن المعارك المصري يروي عن يزيد بن هارون حدثنا عنه بن خزيمة وزعم أنه كان صدوقا(@)(@@)(@@)(@@) $ 12930 - حسين بن أبي جعفر البطناني من أهل حلب كنيته أبو على يروي عن أبي الوليد وعبد الله بن أبي بكر العتكي حدثني عنه محمد بن عبد الرحمن الأصبهاني(@)(@@)(@@)(@@) $ 12931 - حسين بن جعفر بن محمد الفتات كوفي يروي عن أبي نعيم روى 
ms1436	 عنه أهل العراق(@)(@@)(@@)(@@) $ 12932 - حسين بن مندوست العامري من نيسابور يروي عن أبي نعيم وأهل العراق والشام ثنا محمد بن علي الفارسي بنيسابور قال حدثنا الحسين بن مندوست ثنا محمد بن كثير المصيصي ثنا الأوزاعي قال كانت عندنا امرأة تحيض يوما واحدا ثم تطهر وتمكث في نفاسها ثلاثا ثم تطهر PageV08P192(@)(@@)(@@)(@@) $ 12933 - حسين بن جنيد من أهل سمنان يروي عن أبي أسامة ثنا عنه أحمد بن سعيد الباشاني مستقيم الأمر فيما يروي(@)(@@)(@@)(@@) $ 12934 - حسين بن إدريس بن المبارك بن الهيثم بن زياد بن عبد الرحمن الأنصاري أبو على من أهل هراة يقال له بن خرم يروي عن علي بن حجر مات سنة ثلاثمائة في آخرها أو في أول سنة إحدى وثلاثمائة وكان ركنا من أركان السنة في بلده(@)(@@)(@@)(@@) $ 12935 - الحكم بن عبد الرحمن بن أبي نعم البجلي من أهل الكوفة يروي عن عبادة بن الوليد روى عنه الفضل بن دكين(@)(@@)(@@)(@@) $ 12936 - أبو عمر يروي عن ضرار بن عمرو روى عنه محمد بن طلحة(@)(@@)(@@)(@@) $ 12937 - الحكم بن طهمان أبو عزة الدباغ وهو الذي يقال له الحكم بن أبي القاسم يروي عن البصريين بن عون وغيره روى عنه موسى بن إسماعيل(@)(@@)(@@)(@@) $ 12938 - الحكم بن فضيل الواسطي يروى عن خالد الحذاء ويعلى بن عطاء روى عنه بشر بن مبشر وزيد بن الحباب PageV08P193(@)(@@)(@@)(@@) $ 12939 - الحكم بن بشير بن سلمان أبو محمد النهدي يروي عن عمرو بن قيس الملائي وأبى سنان روى عنه بشر بن الحكم وابن حميد(@)(@@)(@@)(@@) $ 12940 - الحكم بن حبيب العبدي من أهل نيسابور قال سألت سفيان الثوري وابن عيينة عن الجوار بمكة أفضل أم الأذان بخراسان فقال الأذان بخراسان حدثناه الحسن بن سفيان ثنا بشر بن الحكم حدثني أبي(@)(@@)(@@)(@@) $ 12941 - أبو اليمان اسمه الحكم بن نافع البهراني من أهل حمص يروي عن صفوان بن عمرو وشعيب بن أبي حمزة روى عنه محمد بن يحيى الذهلي وأهل بلده كان مولده سنة ثمان وثلاثين ومائة ومات سنة إحدى أو اثنتين وعشرين ومائتين(@)(@@)(@@)(@@) $ 12942 - الحكم بن 
ms1437	 عبد الله أبو النعمان البصري يروي عن شعبة وحماد بن زيد وكان حافظا ربما أخطأ روى عنه محمد بن مالك العنبري وأهل بلده(@)(@@)(@@)(@@) $ 12943 - الحكم بن مروان يروي عن إسرائيل روى عنه العباس بن الفضل بن رشيد البغدادي PageV08P194(@)(@@)(@@)(@@) $ 12944 - الحكم بن جميع السدوسي كوفي يروي عن الكوفيين عمار بن محمد بن أخت سفيان وغيره روى عنه أبو كريب يغرب(@)(@@)(@@)(@@) $ 12945 - الحكم بن المبارك أبو صالح الخاشتي مولى باهلة من أهل بلخ وخاشت ناحية المصلى بها يروي عن حماد بن زيد ومالك روى عنه عبد الله بن عبد الرحمن السمرقندي وأهل بلده مات سنة ثلاث عشرة ومائتين(@)(@@)(@@)(@@) $ 12946 - الحكم بن سليمان الجبلي من أهل جبل قرية على دجلة يروي عن يحيي بن عقبة بن أبي العيزار والعراقيين روى عنه عيسى بن السكين البلدي(@)(@@)(@@)(@@) $ 12947 - الحكم بن محمد أبو مروان الطبري يروى عن بن عيينة روى عنه أهل بلده مات سنة تسع عشرة ومائتين(@)(@@)(@@)(@@) $ 12948 - الحكم بن موسى السمسار كنيته أبو صالح من أهل بغداد يروي عن يحيى بن حمزة روى عنه أبو يعلى وغيره مات سنة ثنتين وثلاثين ومائتين(@)(@@)(@@)(@@) $ 12949 - حميد بن علي العقيلي يروي عن الضحاك بن مزاحم روى عنه مروان بن معاوية الفزاري PageV08P195(@)(@@)(@@)(@@) $ 12950 - حميد بن عبد الرحمن الكوفي يروي عن الضحاك بن مزاحم روى عنه وكيع بن الجراح(@)(@@)(@@)(@@) $ 12951 - حميد بن الأسود أبو الأسود صاحب الكرابيس يروى عن بن عون روى عنه بن المبارك وابن ابنه عبد الله بن محمد بن أبي الأسود(@)(@@)(@@)(@@) $ 12952 - حميد بن عبد الله المنكدري يروي عن دلهم بن صالح روى عنه الكوفيون(@)(@@)(@@)(@@) $ 12953 - حميد بن القاسم بن حميد بن عبد الرحمن بن عوف الزهري يروي عن أبيه عن جده عن عبد الرحمن بن عوف أن النبي صلى الله عليه وسلم قال أوصيكم بالسابقين الأولين من المهاجرين وأبنائهم من بعدهم روى عنه عتيق بن يعقوب الزبيري(@)(@@)(@@)(@@) $ 12954 - حميد بن أبي زياد الصائغ يروي عن عباد بن منصور عن عطاء عن عائشة قالت كنت أفرك 
ms1438	 المني من ثوب النبي صلى الله عليه وسلم ثم يصلي فيه حدثناه القاسم بن عيسى العطار بدمشق ثنا إبراهيم بن يعقوب الجوزجاني ثنا حميد بن أبى زياد(@)(@@)(@@)(@@) $ 12955 - حميد بن حماد بن أبي الخوار التميمي من أهل الكوفة يروي PageV08P196 عن مسعر بن كدام روى عنه محمد بن معمر البحراني ربما أخطأ(@)(@@)(@@)(@@) $ 12956 - حميد بن مسعدة من أهل البصرة يروي عن بن أبي عدى وأهل بلده حدثنا عنه إبراهيم بن إسحاق الأنماطي وغيره من شيوخنا مات سنة أربع وأربعين ومائتين(@)(@@)(@@)(@@) $ 12957 - حميد بن الربيع الخزاز اللخمي أبو الحسن من أهل بغداد يروي عن هشيم روى عنه محمد بن إسحاق بن خزيمة وغيره من شيوخنا ربما أخطأ(@)(@@)(@@)(@@) $ 12958 - حميد بن زنجويه بن قتيبة بن عبد الله الأزدي النسوي كنيته أبو أحمد يروي عن يعلى بن عبيد والناس كان من سادات أهل بلده فقها وعلما وهو الذي أظهر السنة بنسا حدثنا عنه الحسن بن سفيان وغيره مات سنة سبع وأربعين ومائتين(@)(@@)(@@)(@@) $ 12959 - حفص بن الحكم بن سنان بن سلمة المحبق الهذلي من أهل البصرة يروي عن أبيه روى عنه أبو عاصم النبيل(@)(@@)(@@)(@@) $ 12960 - حفص بن عبد الرحمن الغنوي بن أخى محمد بن سوقة PageV08P197 يروي عن أبي السوداء عن أبى مجلز روى عنه بن عيينة(@)(@@)(@@)(@@) $ 12961 - حفص بن عمر أبو عمر من أهل الكوفة يروي عن أبي الزعراء عن أبي الأحوص روى عنه الفضل بن دكين(@)(@@)(@@)(@@) $ 12962 - حفص بن عمر بن نبيه الخزاعي يروي عن أبيه روى عنه موسى بن إسماعيل(@)(@@)(@@)(@@) $ 12963 - حفص بن صالح الخشني يروي عن حسان بن منصور روى عنه سعيد بن أبي أيوب(@)(@@)(@@)(@@) $ 12964 - حفص بن عمر بن حفص يروي عن عامر بن يحيى روى عنه الهيثم بن خارجة وكان على قضاء البلقاء مدينة الشراة بناحية الشام(@)(@@)(@@)(@@) $ 12965 - حفص بن عجلان مولى بنى هاشم يروي عن حماد بن يحيى روى عنه محمد بن المبارك الصوري(@)(@@)(@@)(@@) $ 12966 - حفص بن حميد الأكاف العابد من أهل مرو يروى عن PageV08P198 بن المبارك روى عنه 
ms1439	 أهل بلده(@)(@@)(@@)(@@) $ 12967 - حفص بن عمر أبو عمران الإمام الواسطي يروي عن شعبة أصله من الري وسكن البصرة روى عنه أهلها(@)(@@)(@@)(@@) $ 12968 - حفص بن عبد الله السلمي كنيته أبو عمرو من أهل نيسابور يروي عن إبراهيم بن طهمان روى عنه أبيه أحمد بن حفص وقد قيل كنيته أبو سهل ومن أصحابنا من زعم أن أبا سهل الخراساني الذي يروي عنه أبو نعيم الفضل بن دكين عن إبراهيم بن طهمان هو حفص بن عبد الله هذا وما أراه بمحفوظ(@)(@@)(@@)(@@) $ 12969 - حفص بن عمرو القناد من أهل جنديسابور يروي عن داود بن أبي هند روى عنه عبد الله بن رشيد الجنديسابوري(@)(@@)(@@)(@@) $ 12970 - حفص بن عبد الرحمن أبو عمر من أهل بلخ سكن نيسابور يروي عن بن إسحاق روى عنه عمر بن يزيد وكان مرجئا(@)(@@)(@@)(@@) $ 12971 - حفص بن عمر أبو عمر الضرير من أهل البصرة يروي عن أبي عوانة وأهل البصرة حدثنا عنه أبو خليفة مات سنة عشرين ومائتين وكان من علماء أهل الفرائض والحساب والفقه والشعر وأيام الناس وكان قد ولد وهو أعمى PageV08P199(@)(@@)(@@)(@@) $ 12972 - حفص بن يحيى بن حفص بن عمر بن عباد التميمي من أهل سرخس يروي عن مالك ونافع القارىء روى عنه عبد الله بن يزيد المقرىء وأهل بلده(@)(@@)(@@)(@@) $ 12973 - حفص بن داود أبو عمر الربعي من أهل بخارا الذي يقال له المؤذن يروي عن محمد بن الفضل بن عطية والغنجار روى عنه أهل بلده(@)(@@)(@@)(@@) $ 12974 - حفص بن عمرو بن الحارث بن عمر بن شجرة النمري أبو عمر الحوضي من أهل البصرة يروي عن شعبة وأبان العطار حدثنا عنه أبو خليفة مات سنة خمس وعشرين ومائتين(@)(@@)(@@)(@@) $ 12975 - حفص بن عمر بن عبد العزيز بن صهبان أبو عمر الدوري من أهل بغداد يروي عن إسماعيل بن جعفر روى عنه محمد بن إسحاق بن إبراهيم وغيره مات سنة ثمان وأربعين ومائتين(@)(@@)(@@)(@@) $ 12976 - حفص بن علي الجمال من أهل سرخس يروى عن أزهر بن سعيد السمان ويزيد بن هارون وكان صاحب حديث روى 
ms1440	 عنه أهل بلده(@)(@@)(@@)(@@) $ 12977 - حفص بن عبد الله أبو عمر الحلواني يروي عن أبي عاصم وأهل العراق ثنا عنه محمد بن إسحاق الثقفى PageV08P200(@)(@@)(@@)(@@) $ 12978 - حفص بن عمر بن ربال الربالي أبو عمر المجاشعي من أهل البصرة يروي عن عمر بن على المقدمي والبصريين ثنا عنه شيوخنا(@)(@@)(@@)(@@) $ 12979 - حفص بن عمرو بن الصباح من أهل الرقة يعرف ب مشيخة ألف يروي عن أبي نعيم والبصريين حدثنا عنه أحمد بن عبيد الله الجندي وغيره ربما أخطأ(@)(@@)(@@)(@@) $ 12980 - حفص بن عمر السياري من أهل البصرة يروي عن محمد بن عبد الله الأنصاري والبصريين روى عنه أهل العراق(@)(@@)(@@)(@@) $ 12981 - حفص بن عمر المهرقاني من أهل الري يروي عن عبيد الله بن موسى وأهل العراق ثنا عنه أصحابنا بالري حسن الحديث يغرب كنيته أبو عمر(@)(@@)(@@)(@@) $ 12982 - حجاج بن محمد الأعور مولى سليمان بن مجالد مولى أبي جعفر الهاشمي كنيته أبو محمد أصله من ترمذ سكن المصيصة يروى عن بن جريج وشعبة روى عنه قتيبة بن سعيد وأهل العراق مات ببغداد سنة خمس أو ست وثلاثين ومائتين يوم الإثنين ليومين مضيا من ربيع الأول PageV08P201(@)(@@)(@@)(@@) $ 12983 - حجاج بن رشدين بن سعد من أهل مصر يروي عن حيوة بن شريح وابن لهيعة روى عنه محمد بن عبد الحكم وأهل مصر(@)(@@)(@@)(@@) $ 12984 - حجاج بن نصير أبو محمد الفساطيطي من أهل البصرة يروي عن شعبة روى عنه أحمد بن سعيد الدارمي وأهل العراق مات سنة ثلاث أو أربع عشرة ومائتين يخطىء ويهم(@)(@@)(@@)(@@) $ 12985 - حجاج بن سليمان الرعيني من أهل مصر يروي عن بن لهيعة روى عنه يونس بن عبد الأعلى الصدفي يعتبر بحديثه إذا روى عن الثقات(@)(@@)(@@)(@@) $ 12986 - حجاج بن يوسف بن أبي منيع الرصافي من أهل الشام كنيته أبو محمد سكن حلب يروي عن جده عبيد الله بن أبي زياد عن الزهري روى عنه الحسين بن الحسن المروزي وأيوب بن محمد الوزان(@)(@@)(@@)(@@) $ 12987 - حجاج بن فروخ الواسطي يروى عن بن جريج روى عنه محمد بن عمرو بن جبلة(@)(@@)(@@)(@@) $ 12988 