ms3200	 4، ح 81).(@)(@@) * وروى عن أبان بن عثمان، وروى عنه علي بن الحسن.(@)(@@) التهذيب: ج 9، ح 730.(@)(@@) * وروى عنه أحمد بن محمد بن أبي PageV10P508(@)(@@) نصر، وروى عنه محمد بن علي بن محبوب.(@)(@@) التهذيب: ج 5، ح 1584.(@)(@@) * وروى عن إسماعيل بن سهل، وروى عنه محمد بن الحسن الصفار.(@)(@@) مشيخة الفقيه: في طريقه إلى حريز بن عبد الله.(@)(@@) * وروى عن بكر بن محمد الأزدي، وروى عنه محمد بن الحسن الصفار.(@)(@@) مشيخة الفقيه: في طريقه إلى بكر بن محمد الأزدي.(@)(@@) وروى عنه البرقي.(@)(@@) التهذيب: ج 3، ح 806.(@)(@@) * وروى عن الحسن، وروى عنه محمد بن أحمد بن يحيى.(@)(@@) التهذيب: ج 10، ح 1034.(@)(@@) * وروى عن الحسن بن علي بن فضال، وروى عنه أبو جعفر.(@)(@@) التهذيب: ج 4، ح 119.(@)(@@) * وروى عن الحسن بن محبوب، وروى عنه محمد بن أحمد بن يحيى.(@)(@@) التهذيب: ج 1، ح 543 (الاستبصار:(@)(@@) ج 1، ح 537)، و ج 2، ح 364 (الاستبصار: ج 1، ح 1195)، و 850، و ج 3، ح 870، و ج 5، ح 799، و ج 6، ح 281، و ج 9، ح 183 (الاستبصار: ج 4، ح 277، وفيه محمد بن يحيى، بدل محمد بن أحمد بن يحيى).(@)(@@) وروى عنه محمد بن علي بن محبوب.(@)(@@) التهذيب: ج 3، ح 542 (الاستبصار:(@)(@@) ج 1، ح 844).(@)(@@) * وروى عن الحسن بن محمد، وروى عنه محمد بن أحمد.(@)(@@) الكافي: ج 5، ك 3، ب 123، ح 4، و ب 124، ح 6. والتهذيب: ج 8، ح 699.(@)(@@) * وروى عن الحسن بن محمد الحضرمي، وروى عنه أحمد بن محمد.(@)(@@) التهذيب: ج 8، ح 627 (الاستبصار:(@)(@@) ج 3، ح 1306).(@)(@@) * وروى عن الحسن بن يزيد، وروى عنه أبو جعفر.(@)(@@) التهذيب: ج 5، ح 700 (الاستبصار:(@)(@@) ج 2، ح 945).(@)(@@) وروى عنه محمد بن علي بن محبوب.(@)(@@) التهذيب: ج 1، ح 1123، و ج 2، ح 1375.(@)(@@) * وروى عن حماد، وروى عنه محمد ابن علي بن محبوب.(@)(@@) التهذيب: ج 4، ح 40 (الاستبصار: ج 2، PageV10P509(@)(@@) ح 43، وفيه العباس فقط)، و 180.(@)(@@) * وروى عن حماد بن عيسى، وروى عنه أبو جعفر.(@)(@@) التهذيب: ج 4، ح 386 (الاستبصار:(@)(@@) ج 2، ح 191)، و ج 5، ح 1101.(@)(@@) وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 6، ك 1، ب 30، و ح 12.(@)(@@) والتهذيب: ج 4، ح 72 (الاستبصار:(@)(@@) ج 2، ح 90)، و 