ms316	 آحاد مردم آن قدر است %~% که در طریق حساب از الوف بر آحاد(@)(@@) 36 خطاست دعوی حقیقت از مخالف تو %~% چنان که دعوی پروردگار از شداد(@)(@@) 37 جواهر سخنم گرچه هست بی‌قیمت %~% درین دیار که بازار شاعریست کساد(@)(@@) 38 از آن عقاید ارباب دین باوست درست %~% که داد داوری و عدل در شرایع داد(@)(@@) 39 زمان زمان فقها را ز قولش استدلال %~% نفس نفس حکما را به حکمش استشهاد(@)(@@) 40 بود بدیع کلام مفید مختصرش %~% چو در بیان معانی کند نکات ایراد(@)(@@) 41 به قول و فعل وی از مهد تا به عهد خرد %~% نکرده سهو و خطائی به هیچ نحو اسناد(@)(@@) 42 ز فعل ماضی و مستقبلش خدا راضی %~% که هست مصدر احسان به امر و نهی عباد(@)(@@) 43 ز نوع انس و ملک جنس علم و جوهر فضل %~% توراست خاصه که داری کمال استعداد(@)(@@) 44 محاسبان فلک عاجزند از آن که کنند %~% ثواب طاعت یک روزه تو راتعداد(@)(@@) 45 ز شست و شوی تو گردیده دلق باده کشان %~% هزار مرتبه اطهر ز خرقه زهاد(@)(@@) 46 صلاح رای تو خال خلاف از رخ خلق %~% چنان ربوده که صبح از رخ زمانه سواد(@)(@@) 47 طواف کوی تو و قتل دشمنت دارند %~% یکی فضیلت حج دیگری ثواب جهاد(@)(@@) 48 مراست ذکر جمیلت همیشه ورد زبان %~% که هست اجمل اذکار و افضل اوراد(@)(@@) 49 ایا مه فلک سروری که امر توراست %~% فلک مطبع و قضا تابع و قدر منقاد(@)(@@) 50 اگرچه محتشم از گردش قضا و قدر %~% به پای بوس سگان در تو دیر افتاد(@)(@@) 51 ولی نهاد چنان سر به طوق بندگیت %~% که تا قیام قیامت نمی‌شود آزاد(@)(@@) 52 ولی به غلغله کوس مدحتت فکنم %~% خروش و ولوله در چرخ اگر کنی امداد(@)(@@) 53 درین سراچه که از صرف گوی اجوف چرخ %~% بنای ناقص عهد است سست و بی‌بنیاد(@)(@@) 54 بنای حشمت جاهت که سالم است و صحیح %~% مثال دولت شه 
ms317	 قوتش مضاعف باد PageV1P628(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 دهنده‌ای که به گل نکهت و به گل جان داد %~% به هرکس آن چه سزا بود حکمتش آن داد(@)(@@) 2 به عرش پایه عالی به فرش پایه پست %~% ز روی مصلحت و رای مصلحت‌دان داد(@)(@@) 3 به دهر ظل خرد آن قدر که بود ضرور %~% ز پرتو حرکات سپهر گردان داد(@)(@@) 4 به ابر قطره چکاندن به باد قره زدن %~% برای نزهت دیرین سرای دوران داد(@)(@@) 5 دو کشتی متساوی اساس را در بحر %~% یکی رساند به ساحل یکی به طوفان داد(@)(@@) 6 دو سالک متشابه سلوک را در عشق %~% یکی ز وصل بشارت یکی ز هجران داد(@)(@@) 7 هزار دایه طلب را ز حسرت افزائی %~% رساند بر سر گنج و به کام ثعبان داد(@)(@@) 8 هزار خسته جگر را ز صبر فرمائی %~% گداخت جان ز غم آنگه نوید جانان داد(@)(@@) 9 گدای کوچه و سلطان شهر را از عدل %~% عدیل وار حیات و ممات یکسان داد(@)(@@) 10 درین مقاسمه‌اش نیز بود مصلحتی %~% که مسکنت به گدا سلطنت به سلطان داد(@)(@@) 11 زبان بسته که بد حکمتی نهفته در آن %~% به کمترین طبقات صنوف حیوان داد(@)(@@) 12 عزیز کرده زبانی که وقت قسمت فیض %~% دریغ داشت ز جن و ملک به انسان داد(@)(@@) 13 به شکرین دهنان داد از سخن نمکی %~% که چاشنی به نباتات شکرستان داد(@)(@@) 14 به قد سروقدان کرد جنبشی تعلیم %~% که خجلت قد رعنای سرو بستان داد(@)(@@) 15 بر ابروان مقوس زهی ز قدرت بست %~% که سهم چرخ مقوس ز تیرپران داد(@)(@@) 16 ز باغ حسن سیه نرگسی چو چشم انگیخت %~% به آن بلای سیه خنجری چو مژگان داد(@)(@@) 17 به چشمهای سیه شیوه‌ای ز ناز آموخت %~% که هر که خواست به آن شیوه دل دهد جان داد(@)(@@) 18 به ناز داد سکونی که وصف نتوان کرد %~% به عشوه طی لسانی که شرح نتوان داد(@)(@@) 19 به هر که لایق 
ms318	 اسباب کامرانی بود %~% سرور و مسند و خر گاه چتر و چوگان داد(@)(@@) 20 بهر که در طلب گنج لایزالی بود %~% گلیم مختصر فقر و گنج ویران داد(@)(@@) 21 به هر یکی ز سلاطین به صورتی دیگر %~% بسیط عرصه‌ای اندر بساط دوران داد(@)(@@) 22 چو پادشاهی اقلیم صورت و معنی %~% زیاده دید از ایشان بمیر میران داد(@)(@@) 23 غیاث ملت و دین کافتاب دولت او %~% ز خاک یزد ضیا تا به عرش یزدان داد(@)(@@) 24 سمی والد سامی محمد عربی %~% که داد رونق دین و رواج ایمان داد(@)(@@) 25 خدایگان سلاطین که چتر سلطنتش %~% به سایه جای هزاران خدیو و خاقان داد(@)(@@) 26 بذره تربیتش کار آفتاب آموخت %~% به مور تقویتش قدرت سلیمان داد(@)(@@) 27 قیام رکن جلالش که قایم ابدیست %~% بسی مدد به قوام چهار ارکان داد(@)(@@) 28 نه ابر ریخت به دشت و نه بحر داد به بر %~% به سایل آن چه کفش آشکار و پنهان داد(@)(@@) 29 دلش ز جوهر احیا توان گریست کریم %~% که هرچه مرگ ز مردم گرفت تاوان داد(@)(@@) 30 قضا زد آتش غیرت به مهر و ماه آن دم %~% که پاسبانی ایوان او به کیوان داد(@)(@@) 31 سپهر بر در او در مراتب خدمت %~% نخست پایه به سلطان چهارم ایوان داد(@)(@@) 32 چو گشت لشگریش فارس زمانه به او %~% قضا ز هفت فلک هفت گونه خفتان داد(@)(@@) 33 پلاس پوش درش خلعت مریدی خویش %~% به شاه و خسرو و خاقان و خان و سلطان داد(@)(@@) 34 به تو شمال وی از صحن پر کواکب چرخ %~% فلک فراخور شیلان او نمکدان داد(@)(@@) 35 بگرد رفت هزار ازدحام حشر آن جا %~% که میزبان سخایش صلای مهمان داد(@)(@@) 36 به شرق و غرب جهان زینتی که شاه ربیع %~% دهد ز سبزه و گل او ز سفره و خوان داد(@)(@@) 37 به جای سبزه زبرجد دمد ز خاک اگر %~% توان خواص کف او به ابر نیسان داد 
ms319	(@)(@@) 38 کرم بر اوست مسلم که آن چه وقت سؤال %~% گذشت در دل سایل هزار چندان داد(@)(@@) 39 برای آن که ز طول حیات داد حضور %~% تواند آن شه خرم دل طرب ران داد(@)(@@) 40 اگر زمانه کند کوتهی قضا خواهد %~% به بازگشت زمان گذشته فرمان داد(@)(@@) 41 سخای او که ز احسان به منعم و مفلس %~% هر آنچه داد بری از فتور و نقصان داد(@)(@@) 42 به جیب محتشمان لعل و در به دامان ریخت %~% به دست بی درمان سیم و زر به میان داد(@)(@@) 43 چو پا نهاد ز دشت عدم به ملک وجود %~% به جود دست برآورد و داد احسان داد(@)(@@) 44 فتاد زلزله در گور حاتم از غیرت %~% چو شخص همت او رخش جود جولان داد(@)(@@) 45 لب صدف پر ترجیح دست او برابر %~% گشوده گشت و گواهی ز بحر عمان داد(@)(@@) 46 به ملک مصر مگر داده باشد از یوسف %~% ازو به خطه یزد آن شرف که یزدان داد(@)(@@) 47 ایا بلند جنابی که آستان تو را %~% فلک گرانی قدر از جباه شاهان داد(@)(@@) 48 توئی ز معدلت آن کسرئی که در عهدت %~% رواج عدل از ایران اثر به توران داد(@)(@@) 49 تو در ممالک قدس آن شهی که مالک ملک %~% و گر تو را ز ملایک هزار دربان داد(@)(@@) 50 نخست رابطه انگیزی از ولای تو کرد %~% مهیمنی که به ارواح ربط ابدان داد(@)(@@) 51 شکوه سنج تو را عالم ثقیل و خفیف %~% ز سطح‌های فلک کفه‌های میزان داد(@)(@@) 52 خدا شناس که مادون ذات واجب را %~% به ممکنات قرار از کمال ایقان داد(@)(@@) 53 تو را به دور تو بر ممکنات فایق دید %~% تو را به عهد تو بر کائنات رجحان داد(@)(@@) 54 اگر ازین فلک تیز رو سکون طلبی %~% چو خاک بایدت از طوع تن به فرمان داد(@)(@@) 55 و گر برین کره آرمیده بانگ زنی %~% به او قرار و سکون تا 
ms320	 به حشر نتوان داد(@)(@@) 56 کسی نظیر تو باشد که وضع پست و بلند %~% به عکس یابد اگر در زمانه سامان داد(@)(@@) 57 تواند از زبر و زیر کردن گیتی %~% به زیر هفت زمین جای این نه ایوان داد(@)(@@) 58 کسی عدیل تو باشد که گر به نوع دگر %~% به پایدش نسق گرم و سرد دوران داد(@)(@@) 59 ز فیض قرب جنابت که کیمیا اثر است %~% فلک به عالی و سافل خواص چندان داد(@)(@@) 60 که خاک رهگذر کمترین منازل یزد %~% بدیده‌ها اثر سرمه صفاهان داد(@)(@@) 61 ز خاک پای سگان در تو یک ذره %~% به حاصل دو جهان هر که داد ارزان داد(@)(@@) 62 حیات را تو اگر پاس داری اندر دهر %~% ممات را نتوان احتمال امکان داد(@)(@@) 63 به خصم تشنه جگر هم رساند دست تو فیض %~% که آبش از مطر قطره‌های باران داد(@)(@@) 64 ملک حشم ملکا محتشم که قادر فرد %~% ز لطف بر سخنش اقتدار سحبان داد(@)(@@) 65 نمود ساز ز اقسام نظم قانونی %~% که مالش حسن و گوشمال حسان داد(@)(@@) 66 اگرچه از اثر بخت واژگون اکثر %~% مقدمات ثنایش نتیجه خسران داد(@)(@@) 67 دل تو آن محک آمد که از مراتب فرد %~% ز مخزن کرمش راتب نمایان داد(@)(@@) 68 به حال جمعی اگر برد از سخای تو رشک %~% ولی به نعمت هر ساله رشک ایشان داد(@)(@@) 69 چو بود عیب گدای تو محض گیرائی %~% ز التفات تو هم نان گرفت و هم نان داد(@)(@@) 70 همیشه تا به کف روزگار در و گهر %~% توان ز موهبت بحر و کان فراوان داد(@)(@@) 71 ز اقتدار تواند کف به خلق جهان %~% عطیه بیش ز بحر و زیاده از کان داد PageV1P629(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 چرخ را باز مه روی تو حیران دارد %~% که مه یک‌شنبه انگشت به دندان دارد(@)(@@) 2 حاجبت کرده بزه قوس نکوئی و هلال %~% سر به زانوی حجاب از اثر آن دارد(@)(@@) 3 در شفق 