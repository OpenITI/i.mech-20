ms781	 يمينا وشمالا )(@)(@@) ) ( طب ) عن سلمان بن عبد الرزاق عنه موقوفا .(@)(@@)(@@)(@@) $ 7123 قال النبي :(@)(@@) | 30 ( إن العبد إذا توضأ فأحسن الوضوء ثم صلى فأحسن الصلاة تحاتت عنه ذنوبه كما يتحاث ورق هاذه الشجرة )(@)(@@) ) ( طب ) عن سلمان رضي الله عنه .(@)(@@)(@@)(@@) $ 7124 قال النبي :(@)(@@) | 30 ( إن العبد إذا أسلم قبل مولاه لم يرد إليه ، وإذا أسلم المولى ثم أسلم العبد دفع إليه )(@)(@@) ) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ 7125 قال النبي :(@)(@@) | 30 ( إن العبد إذا قام في الصلاة فتحت له أبواب الجنة وكشفت له الحجب بينه وبين ربه واستقبلته الحور العين ما لم يمتخط أو يتنحنح )(@)(@@) ) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ 7126 قال النبي :(@)(@@) | 30 ( إن العبد يلبث مؤمنا أحقابا ثم أحقابا ثم يموت والله عز وجل عليه ساخط ، وإن العبد يلبث كافرا أحقابا ثم أحقابا ثم يموت والله عز وجل عنه راض ، ومن مات همازا لمازا ملقبا للناس كان علامته يوم القيامة أن يسمه الله على الخرطوم من كلا الشفتين )(@)(@@) ) ( طب بز ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7127 ) قال النبي :(@)(@@) | 30 ( إن العبد إذا صلى فلم يتم صلاته خشوعها ولا PageV03P037 ركوعها وأكثر الالتفات لم يتقبل منه ، ومن جر ثوبه خيلاء لم ينظر الله إليه يوم القيامة وإن كان على الله كريما )(@)(@@) ) ( طب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ 7128 قال النبي :(@)(@@) | 30 ( إن العبد إذا قام في الصلاة فإنه بين عيني الرحمان فإذا التفت قال له الرب : يا ابن آدم إلى من تلتفت ؟ إلى خير مني ، ابن آدم ! أقبل على صلاتك فأنا خير لك ممن تلتفت إليه )(@)(@@) ) ( بزعق ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 7129 قال النبي :(@)(@@) | 30 ( إن العبد من أمتي إذا قال : أشهد أن لا إلاه إلا الله وأن محمدا رسول الله تطلست ذنوبه كما يطلس أحدكم الكتاب الأسود من الرق الأبيض ، فإذا قال : أشهد أن لا إلاه إلا الله وأن محمدا رسول الله فتحت له أبواب السماء ، فلا يمر بصف من صفوف الملائكة إلا قال 
ms782	 : محمد رسول الله ولم يردها شيء دون الجبار عز وجل )(@)(@@) ) أبو نصر السجزي في الإبانة عن ابن مسعود رضي الله عنه وقال غريب جدا .(@)(@@)(@@)(@@) $ 7130 قال النبي :(@)(@@) | 30 ( إن العبد إذا عمل بالبدعة خلاه الشيطان والعبادة وألقى عليه الخشوع والبكاء )(@)(@@) ) أبو نصر عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ 7131 قال النبي :(@)(@@) | 30 ( إن العبد ليعمل الزمن الطويل من عمره أو كله بعمل . أهل الجنة وإنه لمكتوب عند الله من أهل النار ، وإن العبد ليعمل الزمن الطويل من عمره أو أكثره بعمل أهل النار وإنه لمكتوب عند الله من أهل الجنة )(@)(@@) ) الخطيب عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ 7132 قال النبي :(@)(@@) | 30 ( إن العبد يولد مؤمنا ويعيش مؤمنا ويموت كافرا ، وإن العبد يولد كافرا ويعيش كافرا ويموت مؤمنا ، وإن العبد ليعمل برهة من دهره بالسعادة ثم يدركه ما كتب له فيموت شقيا ، وإن العبد ليعمل برهة من دهره بالشقاء ثم يدركه ما كتب له فيموت سعيدا )(@)(@@) ) ( طب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7133 ) قال النبي :(@)(@@) | 30 ( إن العبد ليبلغ بحسن خلقه درجة الصوم والصلاة )(@)(@@) PageV03P038 ) الحكيم عن أبي الدرداء ( ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 7134 قال النبي :(@)(@@) | 30 ( إن العبد إذا اشتكى يقول الله لملائكته اكتبوا لعبدي ما كان يعمل مطلقا حتى يبدو لي أطلقه أم أقبضه )(@)(@@) ) ( طب ) عن ابن عمرو رضي الله عنهما .(@)(@@)(@@)(@@) $ 7135 قال النبي :(@)(@@) | 30 ( إن العبد إذا دخل بيته وأوى إلى فراشه ابتدره ملكه وشيطانه ، يقول شيطانه اختم بشر ، ويقول الملك : اختم بخير ، فإن ذكر الله وحمده طرد الملك الشيطان وظل بكاؤه ، وإن هو انتبه من منامه ابتدره ملكه وشيطانه ، يقول له الشيطان : افتح بشر ، ويقول الملك : افتح بخير ، فإن هو قال : الحمد لله الذي رعد إلي نفسي بعد موتها ولم يمتها في منامها ، الحمد لله الذي يمسك السماوات والأرض أن تزولا وللئن زالتا إن أمسكهما من أحد من بعده إنه كان حليما غفورا ، وقال : الحمد لله الذي يمسك السماء أن تقع على الأرض إلا بإذنه إن 
ms783	 الله بالناس لرؤوف رحيم ، فإن هو خر من فراشه فمات كان شهيدا ، وإن قام يصلي صلى في فضائل )(@)(@@) ) ( ن ع ) وابن السني عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ 7136 قال النبي :(@)(@@) | 30 ( إن العبد ليقول الكلمة لا يقولها إلا ليضحك بها الناس يهوي بها أبعد مما بين السماء والأرض وإنه ليزل عن لسانه أشد مما يزل عن قدميه )(@)(@@) ) الخرائطي في مكارم الإخلاق ( هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 7137 قال النبي :(@)(@@) | 30 ( إن العبد إذا كان على طريقة حسنة من العبادة ثم مرض ، قيل للموكل : اكتب له مثل عمله إذا كان طالقا حتى أطلقه أو أكفته إلي )(@)(@@) ) ( هق ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ 7138 قال النبي :(@)(@@) | 30 ( إن العبد إذا غسل يديه خرجت خطايا يديه ، وإذا غسل وجهه وتمضمض وتشوص واستنشق ومسح برأسه خرجت خطايا سمعه وبصره ولسانه ، وإذا غسل ذراعيه وقدميه كان كيوم ولدته أمه )(@)(@@) ) ( طس ) عن أبي أمامة رضي الله عنه .(@)(@@) PageV03P039(@)(@@)(@@)(@@) $ 7139 قال النبي :(@)(@@) | 30 ( إن العبد إذا كان همه الدنيا وسدمه أفشى الله عليه ضيعته وجعل بين عينيه فلا يصبح إلا فقيرا ، ولا يمسي إلا فقيرا ، وإن العبد إذا كانت الآخرة همه وسدمه جمع الله له ضيعته وجعل غناه في قلبه ، فلا يصبح إلا غنيا ، ولا يمسي إلا غنيا )(@)(@@) ) ( هناد ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ 7140 قال النبي :(@)(@@) | 30 ( إن العبد ليلقى كتابه يوم القيامة منشورا فينظر فيه فيرى حسنات لم يعملها فيقول : يا رب أنى هاذا لي ولم أعملها ؟ فيقال : هاذا ما اغتابك الناس وأنت لا تشعر )(@)(@@) ) أبو نعيم في المعرفة عن مسيب بن سعد البلوي رضي الله عنه .(@)(@@)(@@)(@@) $ 7141 قال النبي :(@)(@@) | 30 ( إن العبد ليمرض فيرق قلبه فيذكر ذنوبه فيقطر من عينيه مثل الذباب من الدموع فيطهره الله من ذنوبه ، فإن بعثه بعثه مطهرا ، وإن قبضه مطهرا )(@)(@@) ) ( ك ) في تاريخه والديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ 7142 قال النبي :(@)(@@) | 30 ( إن العبد لا يخطئه من الدعاء أحد ثلاث : إما ذنب يغفر ، وإما خير يدخر 
ms784	 ، وإما أجر يعجل )(@)(@@) ) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ 7143 قال النبي :(@)(@@) | 30 إن العبد إذا ظلم فلم ينتصر ولم يكن له من ينصره رفع طرفه إلى السماء فدعا الله ، قال الله : لبيك عبدي أنا أنصرك عاجلا أو آجلا )(@)(@@) ) ( ك ) في تاريخه والديلمي عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ 7144 قال النبي :(@)(@@) | 30 ( إن العبد إذا قام إلى الصلاة فالتفت قال له ربه : أي عبدي أنا خير مما تلتفت إليه فإن التفت الثانية والثالثة قال له مثل ذالك ، فإن التفت الرابعة أعرض الله تعالى عنه )(@)(@@) ) الديلمي عن حذيفة رضي الله عنه .(@)(@@)(@@)(@@) $ 7145 قال النبي :(@)(@@) | 30 ( إن العبد ليكذب الكذبة فيتباعد الملك عنه مسيرة ميل من نتن ما جاء به )(@)(@@) ) الخرائطي في مساوىء الأخلاق عن ابن عمر رضي الله عنهما .(@)(@@) PageV03P040(@)(@@)(@@)(@@) $ 7146 قال النبي :(@)(@@) | 30 ( إن العربية اندرست فجاءني بها جبريل غضة طرية كما شق على لسان إسماعيل عليه السلام )(@)(@@) ) ابن عساكر عن إبراهيم بن هدبة عن أنس رضي الله عنه قال : قال أصحاب النبي : يا رسول الله ، مالك أفصحنا لسانا وأبيننا بيانا قال : فذكره .(@)(@@)(@@)(@@) $ ( 7147 ) قال النبي :(@)(@@) | 30 ( إن العرب إذا اتبعت أذناب البقر صب الله عليهم المذلة وسلط عليهم ولد فارس فيدعون فلا يستجاب لهم ) )(@)(@@) تمام عن مساور بن شهاب بن مسور عن أبيه عن جده سعد بن أبي الغادية عن أبيه .(@)(@@)(@@)(@@) $ ( 7148 ) قال النبي :(@)(@@) | 30 ( إن العرش اهتزت أعواده لموت سعد ) )(@)(@@) ( طب ) عن أسيد بن حضير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7149 ) قال النبي :(@)(@@) | 30 ( إن العيافة والطرق والطيرة من الجبت ) )(@)(@@) ابن سعد ( حم طب ) عن قطن بن قبيصة عن أبيه .(@)(@@)(@@)(@@) $ ( 7150 ) قال النبي :(@)(@@) | 30 ( إن العين تذرف ، وإن الدمع يغلب ، وإن القلب يحزن ولا يعصي الله عز وجل ) )(@)(@@) ( طب ) عن السايب بن يزيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7151 ) قال النبي :(@)(@@) | 30 ( إن العينين وكاء السه فإذا نامت العينان استطلق الوكاء ) )(@)(@@) ( حم ) عن معاوية رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7152 ) قال النبي :(@)(@@) | 30 ( إن الغضب يفسد الإيمان كما يفسد الصبر العسل ، يا معاوية بن 
ms785	 حيدة إن استطعت أن تلقى الله وأنت تحسن الظن به فافعل ، فإن الله عند ظن عبده به ) )(@)(@@) ( طب هب ) و ابن عساكر عن بهز بن حكيم عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 7153 ) قال النبي :(@)(@@) | 30 ( إن الغضب ميسم من نار جهنم يضعه الله على نياط PageV03P041 أحدهم ، ألا ترى أنه إذا غضب احمرت عيناه ، اربد وجهه ، وانتفخت أوداجه ) )(@)(@@) الحكيم عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7154 ) قال النبي :(@)(@@) | 30 ( إن الفتنة إذا أقبلت شبهت ، وإذا أدبرت أسفرت ، وإن الفتنة تلقح بالنجوى ، وتنتج بالشكوى فلا تثيروها إذا حميت ، ولا تعرضوا لها إذا عرضت إن الفتنة راتعة في بلاد الله ، تطا في خطامها ، فلا يحل لأحد من البرية أن يوقظها حتى يأذن الله لها ، الويل لمن أخذ بخطامها ، ثم الويل له ، ثم الويل ) )(@)(@@) نعيم ( حل ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7155 ) قال النبي :(@)(@@) | 30 ( إن الفاقة لأصحابي سعادة ، وإن الغني للمؤمن في آخر الزمان سعادة ) )(@)(@@) الرافعي عن أنس عن ابن مسعود رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7156 ) قال النبي :(@)(@@) | 30 ( إن الفساق هم أهل النار ، قالوا : يا رسول الله ومن الفساق ؟ قال : النساء ، قالوا : أوليس بامهاتنا وبناتنا وأخواتنا ؟ قال : بلى ، ولاكنهن إذا أعطين لم يشكرن ، وإذا ابتلين لم يصبرن ) )(@)(@@) ( حم طب ك ) عن عبد الرحمان بن شبل رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7157 ) قال النبي :(@)(@@) | 30 ( إن القاضي ليزل في مزلقه أبعد من عدن في جهنم ) )(@)(@@) أبو سعيد النقاش في كتاب القضاء عن معاذ ورجاله ثقات إلا أن فيه بقية وقد عنعن .(@)(@@)(@@)(@@) $ ( 7158 ) قال النبي :(@)(@@) | 30 ( إن القبر الذي رأيتموني أناجي فيه ، قبر آمنة بنت وهب ، وإني استأذنت ربي في زيارتها فأذن لي فيه ، واستأذنته في الاستغفار لها فلم يأذن لي فيه ونزل علي : ما كا للنبي والذين آمنوا أن يستغفروا للمشركين فأخذني ما يأخذ الولد للوالدة من الرقة ، فذالك الذي أبكاني ) )(@)(@@) ( ك ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7159 ) قال النبي :(@)(@@) | 30 ( إن القرآن أنزل على سبعة أحرف فلا تماروا في PageV03P042 القرآن فإن المراء فيه كفر 
ms786	 ) )(@)(@@) ابن جرير والباوردي وأبو النصر السجزي في الإبانة عن أبي جهيم الحارث بن الصمة الأنصاري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7160 ) قال النبي :(@)(@@) | 30 ( إن القرآن أنزل على سبعة أحرف فاقرأوا ما تيسر منه ) )(@)(@@) ( خ ن ) عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7161 ) قال النبي :(@)(@@) | 30 ( إن القرآن أنزل على سبعة أحرف فأي ذالك قرأتم فقد أحسنتم فلا تماروا فيه ، فإن المراء فيه كفر ) )(@)(@@) ( طب ) و أبو نصر السجزي في الإبانة عن عمرو بن العاص رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7162 ) قال النبي :(@)(@@) | 30 ( إن القرآن يأتي أهله يوم القيامة أحوج ما كانوا إليه فيقول للمسلم : أتعرفني ؟ فيقول : من أنت ؟ فيقول : أنا الذي كنت تحب ، وتكره أن يفارقك ، الذي كان يشحبك ويذيبك ، فيقول : لعلك القرآن ، فيقدم به على ربه عز وجل فيعطي الملك بيمينه والخلد بشماله ويضع على رأسه السكينة ، وينشر على أبويه حلتان لا تقوم لهما الدنيا أضعافا فيقولان : لأي شيء كسينا هاذا ولم تبلغه أعمالنا ؟ فيقول : هاذا بأخذ ولدكما القرآن ) )(@)(@@) ابن الضريس ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7163 ) قال النبي :(@)(@@) | 30 ( إن القرآن يلقى صاحبه يوم القيامة حين ينشق عنه قبره كالرجل الشاحب فيقول له : هل تعرفني ؟ فيقول : ما أعرفك ، فيقول : أنا صاحبك القرآن أظمأتك في الهواجر ، وأسهرت ليلك ، وإن كل تاجر من وراء تجارته ، وأنا لك اليوم وراء كل تجارة ، فيعطى الملك بيمينه والخلد بشماله ، ويوضع على رأسه تاج الوقار ويكسا والداه حلتين لا تقوم لهما أهل الدنيا فيقولان : بما كسينا هاذه ؟ فيقال لهما : بأخذ ولدكما القرآن ، ثم يقال : اقرأ واصعد في درج الجنة وغرفها فهو في صعود ما دام يقرأ هاذا كان أو ترتيلا ) )(@)(@@) ( ش ) و محمد بن نصر وابن الضريس عن بريدة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7164 ) قال النبي :(@)(@@) | 30 ( إن القوم زعموا أنكم قد هلكتم هزلا وجوعا فارملوا PageV03P043 إذا دخلتم واستلمتم ثلاثة أشواط ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7165 ) قال النبي :(@)(@@) | 30 ( إن القوم إذا صلوا في الجمع فإن الله تعالى ليعجب منهم ) )(@)(@@) ( طب ) عن ابن 
ms787	 عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7166 ) قال النبي :(@)(@@) | 30 ( إن الكافر ليجر لسانه يوم القيامة وراءه قدر فرسخين يتوطؤه الناس ) )(@)(@@) ( حم ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7167 ) قال النبي :(@)(@@) | 30 ( إن الكافر ليدعو الله عز وجل في حاجته فتقضى له عاجلا ، وإن المؤمن ليدعو الله تعالى فتبطىء عليه الإجابة فتضج الملائكة لذالك فيقول الله تعالى : إنما أجبت الكافر لئلا يدعوني ولا يذكرني فإني أبغضه وأبغض صوته ، وأبطيء للمؤمن لئلا ينقطع عني ويذكرني فإني أحبه وأحب تضرعه ) )(@)(@@) الخليلي عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7168 ) قال النبي :(@)(@@) | 30 ( إن الكتب كانت تنزل من السماء من باب واحد وإن القرآن أنزل من سبعة أبواب على سبعة أحرف : حلال وحرام ، محكم ومتشابه ، وضرب أمثال ، وأمر وزجر ، فأحل حلاله وحرم حرامه ، واعمل بمحكمه ، وقف عند متشابهه ، واعتبر أمثاله فإن كلا من عند الله ، وما يتذكر إلا أولوا الألباب ) )(@)(@@) ( طب ) عن عمر بن أبي سلمة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7169 ) قال النبي :(@)(@@) | 30 ( إن الكذب لا يصلح منه جد ولا هزل ، ولا أن يعد الرجل ابنه ثم لا ينجز له ، إن الصدق يهدي إلى البر ، وإن البر يهدي إلى الجنة ، وإن الكذب يهدي إلى الفجور وإن الفجور يهدي إلى النار ، إنه يقال للصادق صدق وبر ، ويقال للكاذب كذب وفجر ، وإن الرجل ليصدق حتى يكتب عند الله صديقا ، ويكذب حتى يسمى عند الله كذابا ) )(@)(@@) ( ك هب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7170 ) قال النبي :(@)(@@) | 30 ( إن الذي يجهر بالقرآن كالذي يجهر بالصدقة ، PageV03P044 والذي يسر بالقرآن كالذي يسر بالصدقة ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7171 ) قال النبي :(@)(@@) | 30 ( إن الذي يكذب علي يبنى له بيت في النار ) )(@)(@@) الشافعي ( حم هق ) في المعرفة عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7172 ) قال النبي :(@)(@@) | 30 ( إن الذي يرفع الحديث هو القتات ) )(@)(@@) الخرائطي في مساوىء الأخلاق عن حذيفة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7173 ) قال النبي :(@)(@@) | 30 ( إن الذي يفوته العصر كأنما وتر أهله وماله ) )(@)(@@) ( عب ش ) عن ابن عمر رضي الله 
ms788	 عنهما .(@)(@@)(@@)(@@) $ ( 7174 ) قال النبي :(@)(@@) | 30 ( إن الذي يسجد قبل الإمام ويرفع قبله إنما ناصيته بيد شيطان ) )(@)(@@) ( طس ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7175 ) قال النبي :(@)(@@) | 30 ( إن الذي يجر ثيابه من الخيلاء لا ينظر الله إليه يوم القيامة ) )(@)(@@) ( م ن ه ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7176 ) قال النبي :(@)(@@) | 30 ( إن الذي يشرب في آنية الفضة إنما يجرجر في بطنه نار جهنم إلا أن يتوب ) ( طب ) عن أ$ م سلمة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 7177 ) قال النبي :(@)(@@) | 30 ( إن الذي لا يؤدي زكاة ماله مثل له يوم القيامة شجاعا أقرع له زبيبتان فيلزمه أو يطوقه يقول : أنا كنزك أن كنزك ) )(@)(@@) ( حم ن ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7178 ) قال النبي :(@)(@@) | 30 ( إن الذي أنزل الداء أنزل الدواء ، ولم ينزل داء إلا أنزل له دواء إلا داء واحدا : الهرم ) )(@)(@@) ( طب ) عن صفوان بن عسال رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7179 ) قال النبي :(@)(@@) | 30 ( إن الذي يحنو عليكن بعدي هو الصادق البار ، قاله PageV03P045 لأزواجه ) )(@)(@@) ( حم و ابن سعد ك طب ) وأبو نعيم في فضائل الصحابة عن أم سلمة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 7180 ) قال النبي :(@)(@@) | 30 ( إن الذين يقطعون السدر يصبون في النار على رؤسهم صبا ) )(@)(@@) ( هق ) عن عروة مرسلا وقال هو المحفوظ .(@)(@@)(@@)(@@) $ ( 7181 ) قال النبي :(@)(@@) | 30 ( إن الذين يذكرون من جلال الله وتسبيحه وتكبيره وتحميده وتهليله يتعاطفن حول العرش ، لهن دوي كدوي النحل يذكرن بصاحبهن ، أفلا يحب أحدكم أن لا يزال له عند الرحمان شيء يذكر به ) )(@)(@@) ( حم ش طب ك ) عن النعمان بن بشير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7182 ) قال النبي :(@)(@@) | 30 ( إن اللعنة إذا وجهت إلى من وجهت إليه ، فإن أصابت عليه سبيلا أو وجدت فيه مسلكا وإلا قالت : يا رب وجهت إلى فلان فلم أجد عليه سبيلا ولم أجد فيه مسلكا فيقال لها : ارجعي من حيث جئت ) )(@)(@@) ( حم ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7183 ) قال النبي :(@)(@@) | 30 ( إن المؤذنين أطول الناس أعناقا يوم القيامة ) )(@)(@@) ( ش ) عن معاوية رضي الله 
ms789	 عنه .(@)(@@)(@@)(@@) $ ( 7184 ) قال النبي :(@)(@@) | 30 ( إن المؤمن ليؤجر في إماطة الأذى عن الطريق ، وفي هدايته السبيل ، وفي تعبيره عن الأرثم وفي منحة اللبن حتى إنه ليؤجر في السلعة تكون مصرورة في ثوبه فيلمسها فتخطئها يده ) )(@)(@@) ( ع ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7185 ) قال النبي :(@)(@@) | 30 ( إن المؤمن إذا مرض لم يؤجر في مرضه ولاكن يكفر الله عنه ) )(@)(@@) ( طب ) عن أبي الدرداء رضي الله عنه .(@)(@@) PageV03P046(@)(@@)(@@)(@@) $ ( 7186 ) قال النبي :(@)(@@) | 30 ( إن المؤمن إذا خرج من قبره صور له عمله في صورة حسنة وشارة حسنة ، فيقول له : ما أنت ؟ فوالله إني لأراك امرأ الصدق ، فيقول له : أنا عملك ، فيكون له نورا ، وقائدا إلى الجنة ، وإن الكافر إذا خرج من قبره صور له عمله في صورة سيئة ، وشارة سيئة ، فيقول : ما أنت ؟ فوالله إني لأراك امرأ السوء ، فيقول : أنا عملك ، فينطلق به حتى يدخله النار ) )(@)(@@) ابن جرير عن قتادة مرسلا .(@)(@@)(@@)(@@) $ ( 7187 ) قال النبي :(@)(@@) | 30 ( إن المؤمن يقعد في قبره حين ينكفىء عنه من شهده ، فيقال له : رجل يقال له محمد ما هو ؟ فإن كان مؤمنا قال : هو عبد الله ورسوله ، فيقال له : نم نامت عيناك ، وإن كان غير مؤمن قال : والله ما أدري ، سمعت الناس يقولون شيئا فقلته ، ويخوضون فخضت ، فيقال له : نم لا نامت عيناك ) )(@)(@@) ( طب ) عن أسماء بنت أبي بكر رضي الله عنها .(@)(@@)(@@)(@@) $ ( 7188 ) قال النبي :(@)(@@) | 30 ( إن المؤمن ليجازى بأسوإ عمله في الدنيا : المرض والنصب والنكبة ، يا عائشة إنه ليس أحد يحاسب يوم القيامة إلا معذب ، قالت : أليس الله يقول : يحاسب حسابا يسيرا ؟ قال : ذاك عند العرض ، إنه من نوقق الحساب عذب ) )(@)(@@) ابن جرير عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 7189 ) قال النبي :(@)(@@) | 30 ( إن المؤمن يجاهد بسيفه ولسانه والذي نفسي بيده لكأن ما ترمونهم به نضح النبل ) )(@)(@@) ( حم خ ) في تاريخه ( ع طب ن هق ) و ابن عساكر عن كعب بن مالك أنه قال النبي إن الله أنزل في الشعر ما أنزل قال فذكره .(@)(@@)(@@)(@@) $ ( 7190 ) قال النبي :(@)(@@) | 30 ( إن المؤمنين وأولادهم 
ms790	 في الجنة وإن المشركين وأولادهم في النار ) )(@)(@@) ( عم ) عن علي رضي الله عنه .(@)(@@) PageV03P047(@)(@@)(@@)(@@) $ ( 7191 ) قال النبي :(@)(@@) | 30 ( إن المتحابين في الله لعلى عمود من ياقوتة حمراء ، في رأس العامود سبعون ألف غرفة ، إذا أشرفوا على أهل الجنة أضاء حسنهم في الجنة كما تضيء الشمس لأهل الدنيا ، فيقول أهل الجنة : انطلقوا فلننظر إلى المتحابين في الله عليهم ثياب سندس خضر مكتوب على جباههم : هاؤلاء المتحابون في الله تعالى ) )(@)(@@) الحكيم وابن أبي الدنيا في كتاب الإخوان وابن عساكر عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7192 ) قال النبي :(@)(@@) | 30 ( إن المتحابين في الله لترى غرفهم في الجنة كالكوكب الطالع الشرقي أو الغربي ، فيقال : من هاؤلاء ؟ فيقال : المتحابون في الله تعالى ) )(@)(@@) ( حم ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7193 ) قال النبي :(@)(@@) | 30 ( إن المتحابين لجلال الله في ظل الله يوم لا ظل إلا ظله ) )(@)(@@) ( طب ) عن معاذ وعبادة بن الصامت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7194 ) قال النبي :(@)(@@) | 30 ( إن المتحابين في الله في ظل عرش الله يوم لا ظل إلا ظله ، يفزع الناس ولا يفزعون ، ويخاف الناس ولا يخافون ) )(@)(@@) ( طب ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7195 ) قال النبي :(@)(@@) | 30 ( إن المجالس ثلاثة : سالم ، وغانم ، وشاحب ) )(@)(@@) ( حم ع حب ص ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7196 ) قال النبي :(@)(@@) | 30 ( إن المختلعات المنتزعات أنفسهن من أزواجهن هن المنافقات ) )(@)(@@) ابن النجار عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7197 ) قال النبي :(@)(@@) | 30 ( إن المختلعات هن المنافقات وحرم الله ريح الجنة على امرأة سألت زوجها الطلاق ) )(@)(@@) الخطيب في المتفق والمفترق عن ابن عمرو رضي PageV03P048 الله عنه في سنده .(@)(@@)(@@)(@@) $ ( 7198 ) قال النبي :(@)(@@) | 30 ( إن المرء كثير بأخيه وابن عممه ألا إن جعفرا قد استشهد وقد جعل له جناحان يطير بهما في الجنة ) )(@)(@@) ابن سعد عن عبد الله بن جعفر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7199 ) قال النبي :(@)(@@) | 30 ( إن المرأة خلقت من ضلع ، وإنك إن ترد إقامة الضلع تكسرها ، فدارها تعش بها ) )(@)(@@) ( حم حب طس ن ) عن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7200 
ms791	 ) قال النبي :(@)(@@) | 30 ( إن المرأة مثل الضلع إن جئت تقومها كسرتها ) )(@)(@@) العسكري في الأمثال عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 7201 ) قال النبي :(@)(@@) | 30 ( إن المرأة سهم من سهام إبليس فمن رأى امرأة ذات جمال فأعجبته فغض بصره عنها ابتغاء مرضاة الله أعقبه الله عبادة يجد لذتها ) )(@)(@@) ابن النجار عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7202 ) قال النبي :(@)(@@) | 30 ( إن المرأة المؤمنة في النساء كالغراب الأعصم في الغربان ، وإن النار قد خلقت للسفهاء ، وإن النساء من السفهاء إلا صاحبة القسط والسراج ) )(@)(@@) الحكيم عن كثير بن مرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7203 ) قال النبي :(@)(@@) | 30 ( إن المرابط في سبيل الله أعظم أجرا من رجل جمع كعبيه يرتاد شهرا صامه وقامه ) )(@)(@@) ( هب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7204 ) قال النبي :(@)(@@) | 30 ( إن المستشار مؤتمن ، خذ هاذا فإني رأيته يصلي واستوص به معروفا ) )(@)(@@) ( ت ) حسن عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7205 ) قال النبي :(@)(@@) | 30 ( إن المستشير معان والمستشار مؤتمن ) )(@)(@@) العسكري في الأمثال PageV03P049 عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 7206 ) قال النبي :(@)(@@) | 30 ( إن المستهزئين بالناس يفتح لأحدهم باب الجنة فيقال هلم فيجيء بكربه وغمه ، فإذا جاء أغلق دونه ، ثم يفتح له عباب آخر فيقال هلم فيجيء بكربه وغمه ، فإذا جاء أغلق دونه فما يزال كذالك حتى إن الرجل ليفتح له الباب فيقال له هلم هلم فما يأتيه ) )(@)(@@) ابن أبي الدنيا في ذم الغيبة عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 7207 ) قال النبي :(@)(@@) | 30 ( إن المسلم في ذمة الله منذ ولدته أمه إلى أن يقوم بين يديه تبارك وتعالى ، فإن وافى الله بشهادة أن لا إلاه إلا الله صادقا أو باستغفار صادقا كتبت له براءة من النار ) )(@)(@@) ( ن ) عن أبي سلمة بن عبد الرحمان عن أبيه ولم يسمع منه .(@)(@@)(@@)(@@) $ ( 7208 ) قال النبي :(@)(@@) | 30 ( إن المسلم ليصلي وخطاياه مرفوعة على رأسه ، فكلما سجد تحاتت عنه فيفرغ حين يفرغ من صلاته وقد تحاتت خطاياه ) )(@)(@@) ( طب هب ) عن سل مان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7209 ) قال النبي :(@)(@@) | 30 ( إن المسلم إذا لقي 
ms792	 أخاه المسلم فأخذ بيده تحاتت عنهما ذنوبهما كما يتحات الورق من الشجرة اليابسة في يوم ريح عاصف ، وإلا غفر لهما ولو كانت ذنوبهما مثل زبد البحر ) )(@)(@@) ( طب ) عن سل مان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7210 ) قال النبي :(@)(@@) | 30 ( إن المسلم إذا توضأ فأحسن الوضوء ثم صلى الصلوات الخمس تحاتت خطاياه كما تحات هاذا الورق ) )(@)(@@) ( ط ) و الدارمي والبغوي ( حم طب ) وابن مردويه عن سلمان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7211 ) قال النبي :(@)(@@) | 30 ( إن المسلم إذا مرض أوحى الله إلى ملائكته فيقول : يا ملائكتي أنا قيدت عبدي بقيد من قيودي ، فإن قبضته أغفر له ، وإن عافيته فجسد مغفور له لا ذنب له ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7212 ) قال النبي :(@)(@@) | 30 ( إن المسلم أخو المسلم لا يظلمه ولا يخذله ولا يسلمه في مصيبة نزلت له ، وإن يكن خيار العرب والموالي يحب بعضهم بعضا لا PageV03P050 يجدون من ذالك بدا ) )(@)(@@) ( طب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7213 ) قال النبي :(@)(@@) | 30 ( إن المسلم إذا اغتسل يوم الجمعة ثم أقبل إلى المسجد لا يؤذي أحدا ، فإن لم يجد الإمام خرج صلى ما بدا له ، فإن وجد الإمام قد خرج جلس فاستمع وأنصت حتى يقضي الإمام جمعته ، وكلامه إن لم يغفر في جمعته تلك ، ذنوبه كلها أن تكون كفارة للجمعة التي قبلها ) )(@)(@@) ( حم ) عن نبيشة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7214 ) قال النبي :(@)(@@) | 30 ( إن المسلم إذا توضأ فأحسن الوضوء ثم صلى الصلوات في جماعة فأتم ركوعها وسجودها غفر له ما بينهما ما لم يرتكب مقتلة ) )(@)(@@) ( ط ) عن عثمان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7215 ) قال النبي :(@)(@@) | 30 ( إن المسلم الذي يخالط الناس ويصبر على أذاهم أفضل من الذي لا يخالط الناس ولا يصبر على أذاهم ) )(@)(@@) ( هب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7216 ) قال النبي :(@)(@@) | 30 ( إن المصدق إذا انصرف عن القوم وهو راض عنهم ، رضي الله عنهم ، وإذا انصرف وهو ساخط عليهم سخط الله عليهم ) )(@)(@@) ( طب ) عن سراء بنت نبهان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7217 ) قال النبي :(@)(@@) | 30 
ms793	 ( إن المصورين يعذبون يوم القيامة ويقال : أحيوا ما خلقتم ) )(@)(@@) ( حم ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7218 ) قال النبي :(@)(@@) | 30 ( إن المصلي مناج ربه فلينظر ما ( 5 ايناجيه به ولا يجهر بعضكم على بعض بالقراءة ) )(@)(@@) ( حم هق ) عن البياضي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7219 ) قال النبي :(@)(@@) | 30 ( إن المصلي ليقرع باب الملك وإنه من يدم من قرع PageV03P051 الباب يوشك أن يفتح له ) )(@)(@@) الديلمي عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7220 ) قال النبي :(@)(@@) | 30 ( إن المعروف والمنكر خليفتان ينصبان للناس يوم القيامة ، فأما المعروف فيبشر أهله ويعدهم الخير ، وأما المنكر فيقول لأصحابه : إليكم إليكم وما يستطيعون له إلا لزوما ) )(@)(@@) ابن أبي الدنيا في قضاء الحوائج عن أبي موسى رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7221 ) قال النبي :(@)(@@) | 30 ( إن الملائكة على أبواب المسجد يكتبون الناس على منازلهم : جاء فلان من ساعة كذا وكذا ، جاء فلان من ساعة كذا وكذا ، جاء فلان والإمام يخطب ، جاء فلان فأدرك الصلاة ولم يدرك الخطبة ) )(@)(@@) ( ش ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7222 ) قال النبي :(@)(@@) | 30 ( إن الملائكة تصلي على أحدكم ما دام في مصلاه الذي صلى فيه ما لم يحدث : اللهم اغفر له ، اللهم ارحمه ) )(@)(@@) مالك وابن زنجويه ( ن حب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7223 ) قال النبي :(@)(@@) | 30 ( إن الملائكة لا تصحب رفقة فيها جرس ) )(@)(@@) ( مسدد وابن قانع والبغوي والباوردي وأبو نعيم عن حوطب أو حويطب بن عبد العزى وصحح ، قال البغوي : وما له غيره ، قال ابن قانع : هو حوطب أخو حويطب بن عبد العزى ) .(@)(@@)(@@)(@@) $ ( 7224 ) قال النبي :(@)(@@) | 30 ( إن الملائكة تنزل في العنان وهو السحاب فتذكر الأمر قضي في السماء فتسترق الشياطين السمع فتسمعه فتوحيه إلى الكهان فيكذبون معها مائة كذبة من عند أنفسهم ) )(@)(@@) ( خ ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 7225 ) قال النبي :(@)(@@) | 30 ( إن الملائكة كانت تمشي فلم أكن لأركب وهم يمشون فلما ذهبوا ركبت ) )(@)(@@) ( د ك هق ) عن ثوبان أن رسول الله أتي بدابة فركب فقيل له قال : فذكره .(@)(@@) PageV03P052(@)(@@)(@@)(@@) $ ( 7226 ) قال النبي :(@)(@@) | 30 ( إن الملائكة 
ms794	 قالوا : ربنا خلقتنا وخلقت بني آدم فجعلتهم يأكلون الطعام ويشربون الشراب ويلبسون الثياب ويأتون النساء ويركبون الدواب وينامون ويستريحون ، ولم تجعل لنا من ذالك شيئا ، فاجعل لهم الدنيا ولنا الآخرة ، فقال عز وجل : لا أجعل من خلقت بيدي ونفخت فيه من روحي كمن قلت له كن فكان ) )(@)(@@) ابن عساكر عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7227 ) قال النبي :(@)(@@) | 30 ( إن الملائكة قالت : يا ربنا أعطيت بني آدم الدنيا يأكلون فيها ويشربون ويركبون ويلبسون ونحن نسبح بحمدك ولا نأكل ولا نشرب ولا نلهو فكما جعلت لهم الدنيا فاجعل لنا الآخرة ، قال : لا أجعل صالح ذرية من خلقته بيدي كمن قلت له : كن فكان ) )(@)(@@) ( طب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7228 ) قال النبي :(@)(@@) | 30 ( إن الملائكة كانت تحمله ) )(@)(@@) ( ت ) حسن صحيح غريب عن أنس قال : لما حملت جنازة سعد بن معاذ قال المنافقون : ما أخف جنازته فقال النبي فذكره .(@)(@@)(@@)(@@) $ ( 7229 ) قال النبي :(@)(@@) | 30 ( إن الملائكة تبسط أجنحتها لطالب العلم ) )(@)(@@) ( هب ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 7230 ) قال النبي :(@)(@@) | 30 ( إن الملائكة لا تحضر جنازة الكافر بخير ، ولا جنبا حتى يغتسل أو يتوضأ وضوءه للصلاة ولا متضمخا بصفرة ) )(@)(@@) عبد الرزاق ( طب ) عن عمار رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7231 ) قال النبي :(@)(@@) | 30 ( إن الملائكة يرفعون أعمال العبد من عباد الله يستكثرونه ويزكونه حتى يبلغوا به إلى حيث شاء الله من سلطانه ، فيوحي الله إليهم إنكم حفظة على عمل عبدي وأنا رقيب على ما في نفسه ، إن عبدي هاذا لم يخلص لي عمله فاجعلوه في سجين ، ويصعدون بعمل العبد يستقلونه ويحقرونه حتى يبلغوا به حيث شاء الله من سلطانه فيوحي الله إليهم إنكم حفظة على عمل عبدي وأنا PageV03P053 رقيب على ما في نفسه إن عبدي هاذا أخلص لي عمله فاجعلوه في علتين ) )(@)(@@) ابن المبارك عن حمزة بن حبيب مرسلا .(@)(@@)(@@)(@@) $ ( 7232 ) قال النبي :(@)(@@) | 30 ( إن الملك أتاني فأخبرني أن بنعلي أذى فإذا جاء أحدكم إلى باب المسجد فليقلب نعليه فإن رأى فيهما شيئا فليمسحهما ثم ليصل فيهما 
ms795	 أو يخلعهما ) )(@)(@@) ( طس ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7233 ) قال النبي :(@)(@@) | 30 ( إن الملك مني بمنزلة ليس بها أحد منكم ، وإني أكره أن يجد مني ريح شيء ) )(@)(@@) ( طب ) عن أبي أيوب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7234 ) قال النبي :(@)(@@) | 30 ( إن المنفق في سبيل الله كالباسط يده بالصدقة ولا يقبضها ) ( طب ) عن س$ هل بن الحنظلية رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7235 ) قال النبي :(@)(@@) | 30 ( إن الميت يعذب بالنياحة عليه في قبره ) )(@)(@@) ( ط ) عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7236 ) قال النبي :(@)(@@) | 30 ( إن الميت يحضر ويؤمن على ما يقول أهله ، وإن البصر ليشخص للروح حين يعرج بها ) )(@)(@@) ابن سعد عن قبيصة بن ذؤيب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7237 ) قال النبي :(@)(@@) | 30 ( إن الميت ليعلم من يغسله ومن يكفنه ومن يدليه في حفرته ) )(@)(@@) ( حم ومسدد طس ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7238 ) قال النبي :(@)(@@) | 30 ( إن الميت ينضح عليه الحميم ببكاء الحي ) )(@)(@@) ( ع ) عن أبي بكر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7239 ) قال النبي :(@)(@@) | 30 ( إن الميت يعذب في قبره بما نيح عليه ) )(@)(@@) ( حم م د ) PageV03P054 عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7240 ) قال النبي :(@)(@@) | 30 ( إن الناس يكثرون ويقل الأنصار حتى يكونوا في الناس بمنزلة الملح في الطعام ، فمن ولي منكم أمرا ينفع قوما ويضر آخرين ، فليقبل من محسنهم ويتجاوز عن مسيئهم ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7241 ) قال النبي :(@)(@@) | 30 ( إن الناس اليوم كشجرة ذات جنى ، ويوشك أن يعودوا كشجرة ذات شوك ، إن ناقدتهم ناقدك ، وإن تركتهم لم يتركوك ، وإن هربت منهم طلبوك ، قيل : يا رسول الله وكيف المخرج من ذالك ؟ قال : تقرضهم من عرضك ليوم فاقتك ) )(@)(@@) ( ع طب ) و ابن عساكر عن أبي أمامة رضي الله عنه وضعف .(@)(@@)(@@)(@@) $ ( 7242 ) قال النبي :(@)(@@) | 30 ( إن النطفة إذا استتقرت في الرحم فمضى لها أربعون يوما جاء ملك الرحم فصور عظمه أذكر أم أنثى ؟ يا رب أشقي أم سعيد ؟ فيقضي الله عز وجل ما شاء ، ثم يقول : أي رب أجله ؟ فيقضي الله ما شاء فيكتب ثم 
ms796	 تطوى الصحيفة فلا تنتشر إلى يوم القيامة ) )(@)(@@) ( طب ) عن حذيفة بن أسيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7243 ) قال النبي :(@)(@@) | 30 ( إن النطفة إذا استقرت في الرحم أحضرها الله كل نسب بينها وبين آدم ، فركب خلقه ولحمه ودمه وشعره وبشره وسمعه وبصره فيقول : يا رب أذكر في صورة من تلك الصور ، أما قرأت هاذه الآية : في أي صورة ما شاء ركبك ) )(@)(@@) ( ح ) في تاريخه و ابن جرير وابن المنذر وابن شاهين وابن قانع والباوردي ( طب ) وابن مردويه عن موسى بن علي بن رباح عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 7244 ) قال النبي :(@)(@@) | 30 ( إن النظرة سهم من سهام إبليس مسموم ، من تركها مخافتي أبدلته إيمانا يجد حلاوته في قلبه ) )(@)(@@) ( طب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7245 ) قال النبي :(@)(@@) | 30 ( إن النور إذا دخل الصدر انفسخ ، قيل : هل لذالك من علم يعرف به ؟ قال : نعم ، التجافي عن دار الغرور ، والإنابة إلى دار الخلود ، PageV03P055 والاستعداد للموت قبل نزوله ) )(@)(@@) ( ك ) وتعقب عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7246 ) قال النبي :(@)(@@) | 30 ( إن النميمة الحقد في النار لا يجتمعان في قلب مسلم ) )(@)(@@) ( طس ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7247 ) قال النبي :(@)(@@) | 30 ( إن اليد العليا خير من اليد السفلى وابدأ بمن تعول ) )(@)(@@) ( حم ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7248 ) قال النبي :(@)(@@) | 30 ( إن اليسير من الرياء شرك ، وإن من عادى أولياء الله فقد بارز الله بالمحاربة ، وإن الله يحب الأبرار الأخفياء الأتقياء الذين إذا غابوا لم يفتقدوا ، وإذا حضروا لم يدعوا ولم يعرفوا ، قلوبهم مصابيح الهدى ، يخرجون من كل غبراء مظلمة ) )(@)(@@) ( طب ك ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7249 ) قال النبي :(@)(@@) | 30 ( إن اليمين الكاذبة تنفق السلعة وتمحق الكسب ) )(@)(@@) ( عب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7250 ) قال النبي :(@)(@@) | 30 ( إن آثاركم تكتب ) )(@)(@@) ( ت ) حسن غريب عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7251 ) قال النبي :(@)(@@) | 30 ( إن آخر من يخرج من النار ويدخل الجنة رجل يحبو فيقال له : ادخل الجنة ، فيخيل إليه أنها ملأى ، فيقول 
ms797	 : يا رب إنها ملأى ، فيقال له : أدخل إن لك عشرة أمثال الدنيا فيقول أنت الملك أتضحك بي فذالك أنقص أهل الجنة حظا ) )(@)(@@) ( طب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7252 ) قال النبي :(@)(@@) | 30 ( إن أباك أراد أمرا فأدركه ، يعني : الذكر ) )(@)(@@) ( حم طب ) عن عدي بن حاتم رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7253 ) قال النبي :(@)(@@) | 30 ( إن أباك لا يحب أن يذكر فذكر ) )(@)(@@) ( طب ) عن PageV03P056 سهل بن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7254 ) قال النبي :(@)(@@) | 30 ( إن أباكم لم يتق الله فيجعل له من أمره مخرجا ، بانت منه بثلاث على غير السنة ، وتسعمائة وسبع وتسعون إثما في عنقه ) )(@)(@@) و ابن عساكر عن إبراهيم بن عبد الله بن عبادة بن الصامت عن أبيه عن جده قال : طلق رجل امرأته ألفا فانطلق بنوه إلى رسول الله فسألوه هل له من مخرج ؟ قال : فذكره .(@)(@@)(@@)(@@) $ ( 7255 ) قال النبي :(@)(@@) | 30 ( إن أباكم آدم كان طوالا كالنخلة السحوق ستين ذراعا ، كثير الشعر ، موارى العورة ، فلما أصاب الخطيئة في الجنة خرج منها هاربا فلقيته شجرة فأخذت بناصيته فحبسته ، وناداه ربه أفرارا مني يا آدم ؟ قال : لا ، بل حياء منك يا رب مما جئت به ، فاهبط إلى الأرض ، فلما حضرته الوفاة بعث إليه من الجنة مع الملائكة بكفنه وحنوطه فلما رأتهم حواء ذهبت لتدخل دونهم ، فقال : خل بيني وبين رسل ربي فما أصابني الذي أصابني إلا فيك ، ولا لقيت الذي لقيت إلا منك ، فلما توفي غسلوه بالماء والسدر وترا وكفوه في وتر من الثياب ثم لحدوا له فدفنوه ، وقالوا : هاذه سنة ولد آدم من بعده ) )(@)(@@) عبد بن حميد في تفسيره وأبو الشيخ في العظمة والخرائطي في مكارم الأخلاق عن أبي بن كعب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7256 ) قال النبي :(@)(@@) | 30 ( إن أبر البر أن يصل الرجل أهل ود أبيه بعد أن يولي الأب ) )(@)(@@) ( حم خ ) في الأدب ( م د ت حب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7257 ) قال النبي :(@)(@@) | 30 ( إن إبراهيم حرم مكة ، وإني أحرم المدينة وهي حرام ، ما بين لابتيها 
ms798	 ) )(@)(@@) الشيرازي في الألقاب عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7258 ) قال النبي :(@)(@@) | 30 ( إن إبراهيم خليل الرحمان رأى الجنة فيما يرى النائم ، جنة عرضها السماوات والأرض أعدت لمحمد وأمته ، حدائقها شهادة أن لا PageV03P057 إلاه إلا الله ، وأشجارها محمد رسول الله ، وثمارها سبحان الله والحمد لله ، فقال له قومه : يا خليل الله من محمد وأمته ) )(@)(@@) الديلمي عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7259 ) قال النبي :(@)(@@) | 30 ( إن إبراهيم سأل ربه فقال : يا رب ما جزاء من حمدك ؟ قال : الحمد مفتاح الشكر ، والشكر يعرج به إلى عرش رب العالمين ، قال : فما جزاء من سبحك ؟ قال : لا يعلم تأويل التسبيح إلا رب العالمين ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7260 ) قال النبي :(@)(@@) | 30 ( إن أبغض الخلق إلى الله الألد الخصم ) )(@)(@@) الخرائطي في مساوىء الأخلاق عن الزبير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7261 ) قال النبي :(@)(@@) | 30 ( إن إبليس قد يئس أن يعبد في أرض العرب ) )(@)(@@) ( طب ) عن جرير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7262 ) قال النبي :(@)(@@) | 30 ( إن إبليس ليضع عرشه على البحر ودونه الحجب يتشبه بالله عز وجل ، ثم يبث جنوده فيقول : من لفلان الأدمي ؟ فيقوم اثنان ، فيقول : قد أجلتكما سنة ، فإن أغويتماه وضعت عنكم البعث وإلا صلبتكما ) )(@)(@@) ( طب ) و ابن عساكر عن أبي ريحانة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7263 ) قال النبي :(@)(@@) | 30 ( إن إبليس لما نزل إلى الأرض قال : يا رب أنزلتني إلى الأرض وجعلتني رجيما فاجعل لي بيتا قال : الحمام ، قال : فاجعل لي مجلسا ، قال : الأسواق ومجامع الطرق ، قال : فاجعل لي طعاما ، قال : ما لم يذكر اسم الله عليه قال : اجعل لي شرابا ، قال : كل مسكر ، قال : اجعل لي مؤذنا ، قال : المزامير ، قال : اجعل لي قرآنا ، قال : الشعر ، قال : اجعل لي كتابا ، قال : الوشم ، قال : اجعل لي حديثا ، قال : الكذب ، قال : اجعل لي رسولا ، قال : الكهانة ، قال : اجعل لي مصائد ، قال : النساء ) )(@)(@@) ابن أبي الدنيا في مكائد الشيطان PageV03P058 وابن جرير ( طب ) وابن مردويه عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7264 ) قال النبي :(@)(@@) | 30 ( إن إبليس يبعث جنوده 
ms799	 كل صباح ومساء فيقول : من أضل رجلا أكرمته ، ومن فعل كذا فله كذا ، فيأتي أحدهم فيقول : لم أزل به حتى طلق امرأته قال : يتزوج أخرى ، فيقول : لم أزل به حتى زنا ، فيجيزه ويكرمه ويقول لمثل هاذا فاعملوا ، ويأتي آخر فيقول : لم أزل بفلان حتى قتل ، فيصيح صيحة يجتمع إليه الجن ، فيقولون : يا سيدنا ما الذي فرحك ؟ فيقول : حدثني فلان أنه لم يزل برجل من بني آدم يفتنه ويصدره حتى قتل رجلا فدخل النار فيجيزه ويكرمه كرامة لم يكرم بها أحد من جنوده ثم يدعو بالتاج فيضعه على رأسه ويستعمله عليهم ) )(@)(@@) ( حل ) عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7265 ) قال النبي :(@)(@@) | 30 ( إن إبليس يئس أن تعبد الأصنام بأرض العرب ، ولاكنه سيرضى بدون ذالك منكم ، بالمحقرات من أعمالكم وهي الموبقات فاتقوا المظالم ما استطعتم فإن العبد يجيء يوم القيامة وله من الحسنات ما يرى أنه ينجيه ، فلا يزال عبد يقوم فيقول : يا رب إن فلانا ظلمني مظلمة ، فيقال : امحوا من حسناته حتى لا يبقى له حسنة ) )(@)(@@) ( ك ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7266 ) قال النبي :(@)(@@) | 30 ( إن إبليس لما رأى آدم أجوف قال : وعزتك لا أخرج من جوفه ما دام فيه الروح ، فقال الله عز وجل : وعزتي لا أحول بينه وبين التوبة ما دام الروح فيه ) )(@)(@@) ابن جرير عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 7267 ) قال النبي :(@)(@@) | 30 ( إن إبليس له خرطوم كخرطوم الكلب واضعه على قلب ابن آدم يذكره الشهوات واللذات ويأتيه بالأماني ويأتيه بالوسوسة على قلبه ليشككه في ربه ، فإذا قال العبد : أعوذ بالله السميع العليم من الشيطان الرجيم ، وأعوذ بالله أن يحضرون إن الله هو السميع العليم خنس الخرطوم عن القلب ) )(@)(@@) الديلمي عن معاذ رضي الله عنه .(@)(@@) PageV03P059(@)(@@)(@@)(@@) $ ( 7268 ) قال النبي :(@)(@@) | 30 ( إن إبليس الملعون يخطب شياطينه فيقول : عليكم باللمم وبكل مسكر وبالنساء ، فإني لم أجد جماع الشر إلا فيها ) )(@)(@@) ( ك ) في تاريخه و الديلمي عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7269 ) قال النبي :(@)(@@) | 30 ( إن إبليس يقول : أبغوا من 
ms800	 بني آدم البغي والحسد فإنهما يعدلان عند الله الشرك ) )(@)(@@) ( ك ) في تاريخه و الديلمي عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7270 ) قال النبي :(@)(@@) | 30 ( إن ابني هاذا سيد وليصلحن الله به بين فئتين من المسلمين عظيمتين ) )(@)(@@) يحيى بن معين في فوائده ( طب هق ) في الدلائل والخطيب وابن عساكر ( ض ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7271 ) قال النبي :(@)(@@) | 30 ( إن ابني هاذا سيد وإنه ريحانتي في الدنيا ، وإني أرجو أن يصلح الله به بين فئتين من المسلمين عظيمتين ) )(@)(@@) ( طب ) عن أبي بكرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7272 ) قال النبي :(@)(@@) | 30 ( إن ابني هاذا ، يعني : الحسين ، يقتل بأرض من أرض العراق يقال لها : كربلاء ، فمن شهد ذالك منكم فلينصره ) )(@)(@@) البغوي وابن السكن وابن منده والباوردي وابن عساكر عن أنس بن الحارث بن نبيه ، قال البغوي : لا أعلم روى غيره ، وقال ابن السكن : ليس يروى إلا من هاذا الوجه ولا يعرف لأنس غيره .(@)(@@)(@@)(@@) $ ( 7273 ) قال النبي :(@)(@@) | 30 ( إن ابني هاذا سيد ، وإن الله سيصلح على يديه بين فئتين عظيمتين من المسلمين ) )(@)(@@) ( طب ) عن أبي بكرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7274 ) قال النبي :(@)(@@) | 30 ( إن ابن سمية ما عرض عليه أمران قط إلا اختار الأرشد منهما ) )(@)(@@) ( حم ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7275 ) قال النبي :(@)(@@) | 30 ( إن ابن مظعون لحيي ستير ) )(@)(@@) ابن سعد ( طب ) عن سعد بن مسعود وعمارة بن غراب اليحصبي رضي الله عنهما .(@)(@@) PageV03P060(@)(@@)(@@)(@@) $ ( 7276 ) قال النبي :(@)(@@) | 30 ( إن ابن مكتوم ينادي بليل فكلوا واشربوا حتى ينادي بلال ) )(@)(@@) ابن سعد عن زيد بن ثابت ( حم ) عن عمه حبيب بن عبد الرحمن رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7277 ) قال النبي :(@)(@@) | 30 ( إن ابن مكتوم يؤذن بليل فكلوا واشربوا حتى يؤذن بلال ) )(@)(@@) ابن خزيمة عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 7278 ) قال النبي :(@)(@@) | 30 ( إن ابن أم مكتوم أعمى ، فإذا أذن ابن أم مكتوم فكلوا ، وإذا أذن بلال فأمسكوا لا تأكلوا ) )(@)(@@) عبد الرزاق عن ابن جريج عن سعد بن إبراهيم رضي الله عنه وغيره .(@)(@@)(@@)(@@) $ ( 7279 ) قال النبي :(@)(@@) | 30 ( إن أبواب 