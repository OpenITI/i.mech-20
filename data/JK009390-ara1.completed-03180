ms3163	 ) . .(@)(@@) PageV10P047(@)(@@)(@@)(@@) $ 248 / 29273 قال النبي :(@)(@@) | 30 ( إذا رأيت الناس يقتتلون علاى الدنيا فاعمد بسيفك علاى أعظم صخرة في الحرة فاضربه حتى ينكسر ثم اجلس في بيتك حتى تأتيك يعد خاطئة أو ميتة قاضية ) )(@)(@@) . ( طس ، عن محمد بن سلمة رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 249 / 29274 قال النبي :(@)(@@) | 30 ( إذا رجف قلب المؤمن في سبيل الله تحاتت عنه خطاياه كما يتحات عذق النخلة ) )(@)(@@) . ( طكس ، عن سلمان رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 250 / 29275 قال النبي :(@)(@@) | 30 ( إذا رددت السائل ثلاثا فلم يرجع ، فلا عليك أن تزجره ) )(@)(@@) . ( طس ، وابن النجار عن أبي هريرة رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 251 / 29276 قال النبي :(@)(@@) | 30 ( إذا رقد أحدكم فغلبته عيناه فليقل هاكذا : إن الله يتوفى الأنفس حين . . . ) )(@)(@@) . ( طك ، عن أبي أمامة رضي الله عنه قال : كنا مع رسول الله في سفر فلم يستيقظ ، حتى إذا دحر الشمس فأقام الصلاة فتقدم ثم صلى بهم وذكره ) . .(@)(@@)(@@)(@@) $ 252 / 29277 قال النبي :(@)(@@) | 30 ( إذا ركب الرجل الدابة فلم يذكر اسم الله ردفه الشيطان فقال له : تغن ، فإن لم يتغن قال له : تمن ) )(@)(@@) . ( طك ، عن ابن مسعود رضي الله عنه موقوفا ) . .(@)(@@)(@@)(@@) $ 253 / 29278 قال النبي :(@)(@@) | 30 ( إذا زالت الشمس فصلوا ) )(@)(@@) . ( طك ، عن حبان رضي الله عنه قال : شكونا حر الرمضاء فلم يشكنا ) . .(@)(@@)(@@)(@@) $ 254 / 29279 قال النبي :(@)(@@) | 30 ( إذا سألت ربك الخير فلا تسأل وفي يدك حجر ) )(@)(@@) . ( طك ، عن ابن مسعود رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 255 / 29280 قال النبي :(@)(@@) | 30 ( إذا سئلت أي الأجلين قضاى موساى ؟ فقل : خيرهما وأمنحهما وأبرهما ، وإن أي المرأتين تزوج ؟ فقل : الصغراى منهما ، PageV10P048 وهي التي جاءت فقالت : يا أبت استأكره إن خير من استأجرت القوي الأمين ، قال : ما رأيت من قوته ؟ قالت : أخذ حجرا ثقيلا فألقاه علاى البئر ، وقال : وما الذي رأيت من أمانته ؟ قالت : قال : امشي خلفي ولا تمشي أمامي ) )(@)(@@) . ( طص ، بز ، عن أبي ذر رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 256 / 29281 قال النبي :(@)(@@) | 30 ( إذا سالت عامة الأمطار وخففت الرياح فلا بأس بالصلاة فيه ) )(@)(@@) . ( طس ، عن ابن عمر رضي الله ع