ms1161	 عليه أجرا} (@)(@@) [الأنعام: 90](@)(@@) PageV04P1340(@)(@@)(@@)(@@) | 7582 - (@)(@@) حدثنا أبو زرعة , ثنا منجاب بن الحارث , ثنا بشر بن عمارة , عن أبي روق , عن الضحاك , عن ابن عباس , قوله: {قل لا أسألكم عليه أجرا} [الأنعام: 90] قال: قل لهم يا محمد: لا أسألكم على ما أدعوكم إليه أجرا(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7583 - (@)(@@) قرئ على يونس بن عبد الأعلى , ثنا ابن وهب , أخبرني سعيد بن أبي أيوب , عن عطاء بن دينار , في قول الله تعالى: {لا أسألكم عليه أجرا} [الأنعام: 90] يقول: لا أسألكم على ما جئتكم به أجرا(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7584 - (@)(@@) أخبرني أبو يزيد القراطيسي , ثنا أصبغ بن فرج , قال: سمعت عبد الرحمن بن زيد بن أسلم , يقول في قول الله: {قل لا أسألكم عليه أجرا} [الأنعام: 90] يقول: لا أسألكم على القرآن أجرا(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {أجرا} (@)(@@) [النساء: 40](@)(@@) PageV04P1340(@)(@@)(@@)(@@) | 7585 - (@)(@@) حدثنا أبو زرعة , ثنا منجاب بن الحارث , ثنا بشر بن عمارة , عن أبي روق , عن الضحاك , عن ابن عباس , في قوله: {قل لا أسألكم عليه أجرا} [الأنعام: 90] يقول: عرضا من عرض الدنيا(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {وما قدروا الله حق قدره} (@)(@@) [الأنعام: 91](@)(@@) PageV04P1341(@)(@@)(@@)(@@) | 7586 - (@)(@@) حدثنا أبي , ثنا أبو صالح , حدثني معاوية بن صالح , عن علي بن أبي طلحة , عن ابن عباس: {وما قدروا الله حق قدره} [الأنعام: 91] قال: هم الكفار الذين لم يؤمنوا بقدرة الله عليهم , فمن آمن أن الله على كل شيء قدير فقد قدر الله حق قدره , ومن لم يؤمن بذلك فلم يؤمن بالله حق قدره(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7587 - (@)(@@) حدثنا أبي , ثنا أبو حذيفة , ثنا شبل , عن ابن أبي نجيح , عن مجاهد , قوله: {وما قدروا الله حق قدره} [الأنعام: 91] يقول له: قريش(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7588 - (@)(@@) حدثنا أبي , ثنا قطبة بن العلاء الغنوي , ثنا أبو معشر , عن محمد بن كعب , في قوله: {وما قدروا الله حق قدره} [الأنعام: 91] قال: ما علموا كيف هو حيث كذبوا(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7589 - (@)(@@) حدثنا محمد بن يحيى , ثنا ابن أبي جعفر هو محمد بن عبد الله بن جعفر , عن يحيى بن الضريس , عن ميكائيل , قال: قوله: {وما قدروا الله حق قدره} [الأنعام: 91] قال: ما عظموا الله حق عظمته 
ms1162	(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {حق قدره} (@)(@@) [الأنعام: 91](@)(@@) PageV04P1341(@)(@@)(@@)(@@) | 7590 - (@)(@@) حدثنا أبو بكر بن أبي موسى الأنصاري , ثنا هارون بن حاتم , ثنا عبد الرحمن بن أبي حماد , ثنا أسباط , عن السدي , عن أبي مالك , قوله: {وما قدروا الله حق قدره} [الأنعام: 91] يعني: ما عظموه حق عظمته(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {إذ قالوا ما أنزل الله على بشر من شيء} (@)(@@) [الأنعام: 91](@)(@@) PageV04P1341(@)(@@)(@@)(@@) | 7591 - (@)(@@) حدثنا أبي , ثنا أبو صالح كاتب الليث , حدثني معاوية بن صالح , عن علي بن أبي طلحة , عن ابن عباس , قوله: {إذ قالوا ما أنزل الله على بشر من شيء} [الأنعام: 91] يعني: من بني إسرائيل , قالت اليهود: أنزل الله عليك كتابا؟ قال: «نعم» قالوا: والله ما أنزل الله من السماء كتابا , فأنزل الله: {قل} [الأنعام: 91] يا محمد: {من أنزل الكتاب الذي جاء به موسى نورا وهدى للناس} [الأنعام: 91](@)(@@) PageV00P000(@)(@@)(@@)(@@) | الوجه الثاني(@)(@@) PageV04P1341(@)(@@)(@@)(@@) | 7592 - (@)(@@) حدثنا الحسين بن الحسن , ثنا إبراهيم بن عبد الله , ثنا حجاج , قال: قال ابن جريج: أخبرني ابن كثير , أنه سمع مجاهدا , يقول: {ما قدروا الله حق قدره إذ قالوا ما أنزل الله على بشر من شيء} [الأنعام: 91] قال: قالها مشركو قريش(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {على بشر} (@)(@@) [الأنعام: 91](@)(@@) PageV04P1342(@)(@@)(@@)(@@) | 7593 - (@)(@@) حدثنا أبي , ثنا أبو صالح , حدثني معاوية , عن علي بن أبي طلحة , عن ابن عباس , قوله: {إذ قالوا ما أنزل الله على بشر من شيء} [الأنعام: 91] يعني من بني إسرائيل(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7594 - (@)(@@) أخبرنا أحمد بن عثمان بن حكيم الأودي , فيما كتب إلي , ثنا أحمد بن مفضل , ثنا أسباط , عن السدي , قوله: {إذ قالوا ما أنزل الله على بشر من شيء} [الأنعام: 91] قال فنحاص اليهودي: ما أنزل الله على محمد من شيء(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {من شيء} (@)(@@) [آل عمران: 92](@)(@@) PageV04P1342(@)(@@)(@@)(@@) | 7595 - (@)(@@) حدثنا أبي , ثنا أبو صالح , حدثني معاوية بن صالح , عن علي بن أبي طلحة , عن ابن عباس , قوله: {إذ قالوا ما أنزل الله على بشر من شيء} [الأنعام: 91] قالت اليهود: والله ما أنزل الله من السماء كتابا(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله عز وجل: {قل من أنزل الكتاب الذي جاء به موسى} (@)(@@) [الأنعام: 91](@)(@@) PageV04P1342(@)(@@)(@@)(@@) | 7596 - (@)(@@) وبه عن ابن 
ms1163	 عباس , قال: قالت اليهود: يا محمد , أنزل الله عليك كتابا؟ قال: «نعم» قالوا: والله ما أنزل من السماء كتابا , فأنزل الله: قل يا محمد: {من أنزل الكتاب الذي جاء به موسى} [الأنعام: 91] , قل الله أنزله(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7597 - (@)(@@) حدثنا محمد بن يحيى , أنبأ أبو الربيع , ثنا يعقوب , أنبأ جعفر , عن سعيد بن جبير , قال: جاء رجل من اليهود يقال له مالك بن الصيف فخاصم النبي صلى الله عليه وسلم فقال له النبي صلى الله عليه وسلم: «أنشدك بالذي أنزل التوراة على موسى , هل تجد في التوراة أن الله يبغض الحبر السمين؟» قال: وكان حبرا سمينا , فغضب وقال: ما أنزل الله على بشر من شيء , فقال له أصحابه الذين معه: ويحك ‍‍ ولا على موسى؟ قال: ما أنزل الله على بشر من شيء , فأنزل الله عز وجل: {وما قدروا الله حق قدره إذ قالوا ما أنزل الله على بشر من شيء قل من أنزل الكتاب الذي جاء به موسى نورا وهدى للناس} [الأنعام: 91](@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {نورا} (@)(@@) [النساء: 174](@)(@@) PageV04P1342(@)(@@)(@@)(@@) | 7598 - (@)(@@) قرأت على محمد بن الفضل , ثنا محمد بن علي , ثنا محمد بن مزاحم , ثنا بكير بن معروف , عن مقاتل بن حيان , قوله: {نورا} [النساء: 174] قال: نورا من العمى(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {وهدى للناس} (@)(@@) [الأنعام: 91](@)(@@) PageV04P1343(@)(@@)(@@)(@@) | 7599 - (@)(@@) حدثنا الحسن بن أبي الربيع , ثنا عبد الرزاق , ثنا الثوري , عن بيان , عن الشعبي , في قوله: {هدى} [الأنعام: 91] قال: هدى من الضلالة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | الوجه الثاني(@)(@@) PageV04P1343(@)(@@)(@@)(@@) | 7600 - (@)(@@) حدثنا أبو زرعة , ثنا عمر بن حماد بن طلحة , ثنا أسباط , عن السدي , قوله: {هدى} [الأنعام: 91] قال: نور(@)(@@) PageV00P000(@)(@@)(@@)(@@) | الوجه الثالث(@)(@@) PageV04P1343(@)(@@)(@@)(@@) | 7601 - (@)(@@) حدثنا أبو زرعة , ثنا يحيى بن عبد الله بن بكير , حدثنا ابن لهيعة , حدثنا عطاء بن دينار , عن سعيد بن جبير , قوله: {هدى} [الأنعام: 91] قال تبيان(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {تجعلونه قراطيس} (@)(@@) [الأنعام: 91](@)(@@) PageV04P1343(@)(@@)(@@)(@@) | 7602 - (@)(@@) حدثنا أبي , ثنا أبو حذيفة , ثنا شبل , عن ابن أبي نجيح , عن مجاهد , قوله: {قراطيس تبدونها وتخفون كثيرا} [الأنعام: 91] قال: اليهود(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7603 - (@)(@@) حدثنا محمد بن يحيى , ثنا العباس بن الوليد , ثنا يزيد , ثنا سعيد , عن قتادة , قوله: 
ms1164	 {تجعلونه قراطيس تبدونها وتخفون كثيرا} [الأنعام: 91] هم اليهود والنصارى(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {وعلمتم ما لم تعلموا أنتم ولا آباؤكم} (@)(@@) [الأنعام: 91](@)(@@) PageV04P1343(@)(@@)(@@)(@@) | 7604 - (@)(@@) حدثنا أبو زرعة , ثنا صفوان بن صالح , ثنا سعيد , عن قتادة , قوله: {وعلمتم ما لم تعلموا} [الأنعام: 91] قال: هؤلاء مشركو العرب(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7605 - (@)(@@) حدثنا محمد بن يحيى، أنبأ العباس، ثنا يزيد , ثنا سعيد , عن قتادة , قوله: {وعلمتم ما لم تعلموا أنتم ولا آباؤكم} [الأنعام: 91] قال: هم اليهود والنصارى قوما آتاهم الله علما فلم يقتدوا به , ولم يأخذوا به , ولم يعملوا به , فذمهم الله في عملهم ذلك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | الوجه الثالث(@)(@@) PageV04P1343(@)(@@)(@@)(@@) | 7606 - (@)(@@) حدثنا الحسين بن الحسن , ثنا إبراهيم بن عبد الله الهروي , ثنا حجاج , قال: قال ابن جريج: أخبرني ابن كثير , عن مجاهد: {وعلمتم ما لم تعلموا أنتم ولا آباؤكم} [الأنعام: 91] قال مجاهد: هذه للمسلمين(@)(@@) PageV00P000(@)(@@) حدثنا الحسين بن الحسن , ثنا إبراهيم بن عبد الله الهروي , ثنا حجاج , قال: ابن جريج , أخبرني ابن كثير , عن مجاهد: {قراطيس تبدونها وتخفون كثيرا} [الأنعام: 91] قال مجاهد: يهود الذين تبدونها وتخفون كثيرا(@)(@@) PageV04P1344(@)(@@)(@@)(@@) | قوله تعالى: {قل الله} (@)(@@) [النساء: 127](@)(@@) PageV04P1344(@)(@@)(@@)(@@) | 7608 - (@)(@@) حدثنا أبي , ثنا أبو صالح، حدثني معاوية بن صالح، عن علي بن أبي طلحة , عن ابن عباس , قوله: {وعلمتم ما لم تعلموا أنتم ولا آباؤكم قل الله} [الأنعام: 91] قال: الله أنزله(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7609 - (@)(@@) حدثنا محمد بن يحيى , ثنا العباس، ثنا يزيد، ثنا سعيد , عن قتادة , قوله: {ثم ذرهم في خوضهم يلعبون} [الأنعام: 91] قال: فذمهم الله في عملهم ذلك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {وهذا كتاب أنزلناه مبارك} (@)(@@) [الأنعام: 92](@)(@@) PageV04P1344(@)(@@)(@@)(@@) | 7610 - (@)(@@) وبإسناده في قوله: {وهذا كتاب أنزلناه مبارك} [الأنعام: 92] قال: هو القرآن الذي أنزله الله على محمد صلى الله عليه وسلم(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {مصدق} (@)(@@) [البقرة: 89](@)(@@) PageV04P1344(@)(@@)(@@)(@@) | 7611 - (@)(@@) أخبرنا محمد بن سعد بن عطية , فيما كتب إلي , حدثني أبي , حدثني عمي , حدثني أبي , عن أبيه , عن عبد الله بن عباس , قوله: {مصدق} [البقرة: 89] قال: شاهد(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {مصدق الذي بين يديه} (@)(@@) [الأنعام: 92](@)(@@) PageV04P1344(@)(@@)(@@)(@@) | 7612 - (@)(@@) حدثنا علي بن الحسين , ثنا محمد بن العلاء , ثنا عثمان بن سعيد , ثنا بشر بن عمارة , عن أبي روق 
ms1165	 , عن الضحاك , عن ابن عباس: {مصدق} [البقرة: 89] يقول: {مصدق الذي بين يديه} [الأنعام: 92] يقول: لما قبله من الكتب التي أنزلها الله والآيات والرسل الذين بعثهم الله بالآيات , نحو موسى , وعيسى , ونوح , وهود , وشعيب , وصالح , وأشباههم من المرسلين. {مصدق} [البقرة: 89] يقول: وأنت تتلو عليهم يا محمد وتخبرهم به غدوة وعشيا وبين ذلك، وأنت عندهم أمي لم تقرأ كتابا، وأنت تخبرهم بما في أيديهم على وجهه وصدقه. يقول الله في ذلك لهم عبرة وبيان , وعليهم حجة لو كانوا يعلمون(@)(@@) PageV00P000(@)(@@) حدثنا عصام بن رواد , ثنا آدم , عن أبي جعفر الرازي , عن الربيع , عن أبي العالية: {مصدق الذي بين يديه} [الأنعام: 92] يعني من التوراة والإنجيل(@)(@@) PageV04P1345(@)(@@)(@@)(@@) | قوله: {ولتنذر أم القرى} (@)(@@) [الأنعام: 92](@)(@@) PageV04P1345(@)(@@)(@@)(@@) | 7614 - (@)(@@) حدثنا أبي , ثنا أبو صالح , حدثني معاوية بن صالح , عن علي بن أبي طلحة , عن ابن عباس , قوله: {لتنذر أم القرى} [الشورى: 7] يعني: بأم القرى: مكة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7615 - (@)(@@) حدثنا أبي , حدثني الأنصاري , حدثني ابن جريج , قال عطاء وعمرو بن دينار يزيد أحدهما على الآخر: فبعث الله رياحا فشققت الماء فأبرزت موضع البيت على حشفة بيضاء , فمد الله الأرض منها , فلذلك هي أم القرى(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7616 - (@)(@@) أخبرنا أحمد بن عثمان بن حكيم الأودي , فيما كتب إلي , ثنا أحمد بن مفضل , ثنا أسباط , عن السدي , قوله: {لتنذر أم القرى ومن حولها} [الشورى: 7] أما أم القرى فهي مكة , وإنما سميت أم القرى لأن أول بيت وضع بها(@)(@@)(@@)(@@) | 7617 - (@)(@@) وروي عن مجاهد , والضحاك , والحسن , وقتادة , ويحيى بن يعمر , وأبي فاختة نحو ذلك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {ومن حولها} (@)(@@) [الأنعام: 92](@)(@@) PageV04P1345(@)(@@)(@@)(@@) | 7618 - (@)(@@) حدثنا أبي , ثنا أبو صالح , حدثني معاوية بن صالح , عن علي بن أبي طلحة , عن ابن عباس , قوله: {لتنذر أم القرى ومن حولها} [الشورى: 7] يعني: وما حولها من القرى إلى المشرق والمغرب(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7619 - (@)(@@) حدثنا علي بن الحسين , ثنا محمد بن العلاء , ثنا أبو خالد الأحمر , ثنا جويبر , عن الضحاك , في قوله: {ومن حولها} [الأنعام: 92] القرى كلها(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {والذين يؤمنون بالآخرة يؤمنون به} (@)(@@) [الأنعام: 92](@)(@@) PageV04P1345(@)(@@)(@@)(@@) | 7620 - (@)(@@) أخبرنا محمود بن آدم المروزي , فيما كتب 
ms1166	 إلي , قال: سمعت النضر بن شميل , يقول في تفسير المؤمن: إنه أمن من عذاب الله عز وجل(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {وهم على صلاتهم يحافظون} (@)(@@) [الأنعام: 92](@)(@@) PageV04P1346(@)(@@)(@@)(@@) | 7621 - (@)(@@) حدثنا أبو سعيد الأشج , ثنا حفص , عن الأعمش , عن أبي الضحى , عن مسروق , {على صلاتهم يحافظون} [الأنعام: 92] قال: على مواقيت الصلاة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7622 - (@)(@@) حدثنا محمد بن يحيى , ثنا العباس بن الوليد النرسي , ثنا يزيد , ثنا سعيد , عن قتادة , قوله: {على صلاتهم يحافظون} [الأنعام: 92] أي على وضوئها ومواقيتها وركوعها وسجودها(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {ومن أظلم ممن افترى على الله كذبا} (@)(@@) [الأنعام: 21](@)(@@) PageV04P1346(@)(@@)(@@)(@@) | 7623 - (@)(@@) حدثنا أبو سعيد الأشج , ثنا مسعر بن عبد الملك بن سلع , عن عيسى بن عمر , عن عمرو بن مرة , قال: قال عبد الله: ما من هذا القرآن شيء إلا قد عمل به من كان قبلكم وسيعمل به من بعدكم حتى كنت لأمر بهذه الآية: {ومن أظلم ممن افترى على الله كذبا أو قال أوحي إلي ولم يوح إليه شيء} [الأنعام: 93] : ولم يعمل هذا أهل هذه القبلة حتى كان المختار بن أبي عبيد(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7624 - (@)(@@) حدثنا أبي , ثنا ابن نفيل الحراني , ثنا مسكين بن بكير , عن معان بن رفاعة , قال: سمعت أبا خلف الأعمى , قال: كان ابن أبي سرح يكتب للنبي صلى الله عليه وسلم الوحي , فأتى أهل مكة فقالوا: يا ابن أبي السرح , كيف كتبت لابن أبي كبشة القرآن؟ قال: كنت أكتب كيف شئت , فأنزل الله تعالى: {ومن أظلم ممن افترى على الله كذبا} [الأنعام: 21](@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {أو قال أوحي إلي ولم يوح إليه شيء} (@)(@@) [الأنعام: 93](@)(@@) PageV04P1346(@)(@@)(@@)(@@) | 7625 - (@)(@@) حدثنا الحسن بن أبي الربيع , ثنا عبد الرزاق , ثنا معمر , عن قتادة , في قوله: {أو قال أوحي إلي ولم يوح إليه شيء} [الأنعام: 93] قال: نزلت في مسيلمة ورواه شيبان , عن قتادة: نزلت في مسيلمة والأسود العنسي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | الوجه الثاني(@)(@@) PageV04P1346(@)(@@)(@@)(@@) | 7626 - (@)(@@) أخبرنا أحمد بن عثمان بن حكيم الأودي , فيما كتب إلي , ثنا أحمد بن المفضل , ثنا أسباط , عن السدي , قوله: {ومن أظلم ممن افترى على الله كذبا أو قال(@)(@@)(@@)(@@) | [ص: 1347](@)(@@) أوحي إلي ولم يوح إليه 
ms1167	 شيء} [الأنعام: 93] قال: نزلت في عبد الله بن سعد بن أبي سرح القرشي , أسلم وكان يكتب للنبي صلى الله عليه وسلم فكان إذا أملى عليه {سميعا عليما} [النساء: 148] كتب: {عليما حكيما} [النساء: 11] , وإذا قال: {عليما حكيما} [النساء: 11] كتب: {سميعا عليما} [النساء: 148] فشك وكفر: إن كان محمد يوحى إليه فقد أوحي إلي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {ومن قال سأنزل مثل ما أنزل الله} (@)(@@) [الأنعام: 93](@)(@@) PageV04P1347(@)(@@)(@@)(@@) | 7627 - (@)(@@) أخبرنا محمد بن سعد بن عطية , فيما كتب إلي , حدثني أبي , حدثني عمي , حدثني أبي , عن أبيه , عن ابن عباس , في قوله: {ومن قال سأنزل مثل ما أنزل الله} [الأنعام: 93] قال: زعم أنه لو شاء قال مثله , يعني الشعر(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7628 - (@)(@@) حدثنا علي بن الحسين , ثنا محمد بن أبي أحمد , ثنا إبراهيم بن مختار , عن عنبسة , عن جابر عن الشعبي , قال: الذي قال: {سأنزل مثل ما أنزل الله} [الأنعام: 93] عبد الله بن أبي ابن سلول(@)(@@) PageV00P000(@)(@@)(@@)(@@) | والوجه الثالث(@)(@@) PageV04P1347(@)(@@)(@@)(@@) | 7629 - (@)(@@) أخبرنا أحمد بن عثمان بن حكيم الأودي , ثنا أحمد بن مفضل , ثنا أسباط , عن السدي , قال: {ومن قال سأنزل مثل ما أنزل الله} [الأنعام: 93] قال: نزلت في عبد الله بن سعد بن أبي السرح القرشي , كان يكتب للنبي صلى الله عليه وسلم , قال: إن كان الله ينزله فقد أنزلت مثل ما أنزل الله , قال محمد: {سميعا عليما} [النساء: 148] فقلت أنا: {عليما حكيما} [النساء: 11](@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {ولو ترى إذ الظالمون} (@)(@@) [الأنعام: 93](@)(@@) PageV04P1347(@)(@@)(@@)(@@) | 7630 - (@)(@@) حدثنا أبي , ثنا أبو صالح، حدثنا معاوية بن صالح، عن علي بن أبي طلحة , عن ابن عباس , في قوله: {ولو ترى إذ الظالمون في غمرات الموت} [الأنعام: 93] قال: هذا عند الموت(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {في غمرات الموت} (@)(@@) [الأنعام: 93](@)(@@) PageV04P1347(@)(@@)(@@)(@@) | 7631 - (@)(@@) حدثنا أبي , ثنا عبد العزيز بن منيب , ثنا أبو معاذ النحوي , عن عبيد بن سليمان , عن الضحاك , قوله: {في غمرات الموت} [الأنعام: 93] يعني: سكرات الموت(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {والملائكة} (@)(@@) [البقرة: 161](@)(@@) PageV04P1348(@)(@@)(@@)(@@) | 7632 - (@)(@@) حدثنا أبو زرعة , ثنا منجاب , ثنا بشر , عن أبي روق , عن الضحاك , عن ابن عباس , في قوله: {والملائكة باسطو أيديهم} قال: ملك الموت(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7633 - (@)(@@) أخبرنا 
ms1168	 أبو بدر الغبري , فيما كتب إلي , ثنا جابر بن إسحاق , ثنا أبو معشر , عن محمد بن قيس , قال: إن لملك الموت أعوانا من الملائكة , ثم تلا هذه الآية: {ولو ترى إذ الظالمون في غمرات الموت} [الأنعام: 93](@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7634 - (@)(@@) أخبرنا أبو عبد الله محمد بن حماد الطهراني , ثنا إسماعيل بن عبد الكريم , ثنا عبد الصمد , قال: سمعت وهبا , يقول: إن الملائكة الذين يقرنون بالناس هم الذين يتوفونهم , فتوفي لهم آجالهم فإذا كان يوم كذا وكذا توفته ثم نزع: {ولو ترى إذ الظالمون في غمرات الموت والملائكة باسطو أيديهم أخرجوا أنفسكم} إلى آخر الآية. فقيل لوهب: أليس قد قال الله: {قل يتوفاكم ملك الموت الذي وكل بكم} [السجدة: 11] قال: نعم، إن الملائكة إذا توفوا نفسا دفعوها إلى ملك الموت وهو كالعاقب يعني: العشار الذي يؤدي إليه من تحته(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {باسطو أيديهم أخرجوا أنفسكم}(@)(@@) PageV04P1348(@)(@@)(@@)(@@) | 7635 - (@)(@@) حدثنا أبي , ثنا أبو صالح , حدثنا معاوية بن صالح , عن علي بن أبي طلحة , عن ابن عباس , قوله: {والملائكة باسطو أيديهم} قال: هذا عند الموت , والبسط: الضرب {يضربون وجوههم وأدبارهم} [الأنفال: 50](@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7636 - (@)(@@) حدثنا أبو سعيد الأشج , ثنا أبو خالد الأحمر , عن جويبر , عن الضحاك: {والملائكة باسطو أيديهم} قال: بالعذاب {أخرجوا أنفسكم} [الأنعام: 93] قال: أما رأيت قوله: {لئن بسطت إلي يدك لتقتلني} [المائدة: 28] وروي عن أبي صالح: {باسطو أيديهم} قال: بالعذاب(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {اليوم تجزون عذاب الهون} (@)(@@) [الأنعام: 93](@)(@@) PageV04P1348(@)(@@)(@@)(@@) | 7637 - (@)(@@) حدثنا أحمد بن عثمان بن حكيم الأودي , فيما كتب إلي , ثنا أحمد بن مفضل , ثنا أسباط , عن السدي , قوله: {اليوم تجزون عذاب الهون} [الأنعام: 93] أما {عذاب الهون} [الأنعام: 93] قال: الذي يهينهم(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {بما كنتم تقولون على الله غير الحق} [الأنعام: 93] الآية(@)(@@) PageV04P1349(@)(@@)(@@)(@@) | 7638 - (@)(@@) حدثنا علي بن الحسين , ثنا أبو الأصبغ عبد العزيز بن يحيى , ثنا عتاب , عن خصيف , عن مقسم , عن ابن عباس , قال: آيتان يبشر بهما الكافر عند موته: {ولو ترى إذ الظالمون في غمرات الموت والملائكة باسطو أيديهم} إلى قوله: {بما كنتم تقولون على الله غير الحق وكنتم عن آياته تستكبرون} 
ms1169	 [الأنعام: 93] قال: فهاتان آيتان يبشر بهما الكافر في الدنيا(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {ولقد جئتمونا فرادى} (@)(@@) [الأنعام: 94](@)(@@) PageV04P1349(@)(@@)(@@)(@@) | 7639 - (@)(@@) حدثنا يونس بن عبد الأعلى , ثنا ابن وهب , أخبرني عمرو بن الحارث , أن ابن أبي هلال , حدثه أنه , سمع القرظي , يقول قرأت على عائشة زوج النبي صلى الله عليه وسلم قول الله تبارك وتعالى: {ولقد جئتمونا فرادى كما خلقناكم أول مرة} [الأنعام: 94] فقالت عائشة: يا رسول الله , واسوأتاه إن الرجال والنساء سيحشرون جميعا ينظر بعضهم إلى سوأة بعض فقال رسول الله صلى الله عليه وسلم: " {لكل امرئ منهم يومئذ شأن يغنيه} [عبس: 37] لا ينظر الرجال إلى النساء , ولا النساء إلى الرجال , شغل بعضهم عن بعض(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {كما خلقناكم أول مرة} (@)(@@) [الأنعام: 94](@)(@@) PageV04P1349(@)(@@)(@@)(@@) | 7640 - (@)(@@) حدثنا علي بن الحسين , ثنا سعيد بن عبد الله الطلاس , ثنا عباد بن العوام , ثنا هلال بن خباب , عن سعيد بن جبير , أنه تلا هذه الآية: {ولقد جئتمونا فرادى كما خلقناكم أول مرة} [الأنعام: 94] قال: كيوم ولد يرد عليه كل شيء نقص منه من يوم ولد(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {وتركتم ما خولناكم وراء ظهوركم} (@)(@@) [الأنعام: 94](@)(@@) PageV04P1349(@)(@@)(@@)(@@) | 7641 - (@)(@@) وذكر عن أبي داود , عن أبي حرة , عن الحسن , قال: يؤتى بابن آدم يوم القيامة كأنه بذج , فيقول له تبارك وتعالى: أين ما جمعت؟ فيقول: يا رب جمعته وتركته أوفر ما كان , فيقول: فأين ما قدمت لنفسك , فلا تراه قدم شيئا وتلا هذه الآية {ولقد جئتمونا فرادى كما خلقناكم أول مرة وتركتم ما خولناكم وراء ظهوركم} [الأنعام: 94](@)(@@) PageV00P000(@)(@@) أخبرنا أحمد بن عثمان بن حكيم الأودي , فيما كتب إلي , ثنا أحمد بن مفضل , ثنا أسباط , عن السدي , قوله: {وتركتم ما خولناكم} [الأنعام: 94] من المال والخدم(@)(@@) PageV04P1350(@)(@@)(@@)(@@) | قوله: {وراء ظهوركم} (@)(@@) [الأنعام: 94](@)(@@) PageV04P1350(@)(@@)(@@)(@@) | 7643 - (@)(@@) وبه عن السدي , قوله: {وراء ظهوركم} [الأنعام: 94] قال: في الدنيا(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {وما نرى معكم شفعاءكم الذين زعمتم أنهم فيكم شركاء} (@)(@@) [الأنعام: 94](@)(@@) PageV04P1350(@)(@@)(@@)(@@) | 7644 - (@)(@@) ذكره الحسن بن محمد بن الصباح، ثنا حجاج بن محمد , عن ابن جريج , أخبرني الحكم , عن عكرمة , قال: قال النضر: سوف تشفع لي اللات والعزى , فنزلت: {ولقد جئتمونا 
ms1170	 فرادى} [الأنعام: 94] الآية(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7645 - (@)(@@) أخبرنا أحمد بن عثمان بن حكيم , فيما كتب إلي , ثنا أحمد بن مفضل , ثنا أسباط , عن السدي , قوله: {وما نرى معكم شفعاءكم الذين زعمتم أنهم فيكم شركاء} [الأنعام: 94] قال: فإن المشركين يزعمون أنهم كانوا يعبدون هذه الآلهة لأنهم شفعاء لهم يشفعون لهم عند الله، وأن هذه الآلهة شركاء لله. تعالى الله عن قولهم(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {لقد تقطع بينكم وضل عنكم ما كنتم تزعمون} (@)(@@) [الأنعام: 94](@)(@@) PageV04P1350(@)(@@)(@@)(@@) | 7646 - (@)(@@) حدثنا أبي , ثنا أبو صالح , حدثني معاوية بن صالح , عن علي بن أبي طلحة , عن ابن عباس , قوله: {لقد تقطع بينكم وضل عنكم ما كنتم تزعمون} [الأنعام: 94] يعني الأرحام , والمنزل(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7647 - (@)(@@) حدثنا أبي , ثنا أبو حذيفة , ثنا شبل , عن ابن أبي نجيح , عن مجاهد , قوله: {لقد تقطع بينكم} [الأنعام: 94] , والبين: تواصلهم في الدنيا(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7648 - (@)(@@) أخبرنا أحمد بن عثمان بن حكيم , فيما كتب إلي , ثنا أحمد بن مفضل , ثنا أسباط , عن السدي , قوله: {لقد تقطع بينكم} [الأنعام: 94] يقول: تقطع ما كان بينكم(@)(@@) PageV00P000(@)(@@)(@@)(@@) | الوجه الثاني(@)(@@) PageV04P1350(@)(@@)(@@)(@@) | 7649 - (@)(@@) حدثنا أبي , ثنا عبد العزيز بن منيب , ثنا أبو معاذ , عن عبيد بن سليمان , عن الضحاك: {لقد تقطع بينكم} [الأنعام: 94] يعني ما كان بينهم وبين آلهتهم(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {إن الله فالق الحب والنوى} (@)(@@) [الأنعام: 95](@)(@@) PageV04P1351(@)(@@)(@@)(@@) | 7650 - (@)(@@) أخبرنا محمد بن سعد , فيما كتب إلي، حدثني أبي، حدثني عمي , حدثني أبي عن أبيه , عن ابن عباس , قوله: {إن الله فالق الحب والنوى} [الأنعام: 95] يقول: خلق الحب والنوى(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7651 - (@)(@@) حدثنا الحسن بن أبي الربيع , ثنا عبد الرزاق , ثنا معمر , عن قتادة , في قوله: {فالق الحب والنوى} [الأنعام: 95] قال: يفلق الحب والنوى عن النبات(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7652 - (@)(@@) حدثنا أبي , ثنا سهل بن عثمان، ثنا مروان , ثنا جويبر , عن الضحاك: {إن الله فالق الحب والنوى} [الأنعام: 95] قال: خالق الحب والنوى(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7653 - (@)(@@) حدثنا حجاج بن حمزة , حدثنا شبابة , ثنا ورقاء , عن ابن أبي نجيح , عن مجاهد , قوله: {إن الله فالق الحب والنوى} [الأنعام: 95] : الشقان اللذان فيهما(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {الحب والنوى} (@)(@@) [الأنعام: 95](@)(@@) PageV04P1351(@)(@@)(@@)(@@) | 7654 - (@)(@@) أخبرنا أحمد بن عثمان بن 
ms1171	 حكيم الأودي , فيما كتب إلي , ثنا أحمد بن مفضل , ثنا أسباط , عن السدي , قوله: {فالق الحب والنوى} [الأنعام: 95] فالق الحبة عن السنبلة , قوله: {والنوى} [الأنعام: 95] فالق النواة عن النخلة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {يخرج الحي من الميت} (@)(@@) [الأنعام: 95](@)(@@) PageV04P1351(@)(@@)(@@)(@@) | 7655 - (@)(@@) حدثنا أبي , ثنا نعيم بن حماد , ثنا ابن المبارك , ثنا معمر , عن الزهري , عن عبيد الله بن عبد الله , أن خالدة بنت الأسود بن عبد يغوث , دخلت على رسول الله صلى الله عليه وسلم وهو عند بعض نسائه , فقال: «من هذه؟» قيل: إحدى خالاتك يا رسول الله , قال: «إن خالاتي بهذه البلدة لغرائب فمن هي؟» قيل: خالدة بنت الأسود بن عبد يغوث , فقال: «سبحان الله» {يخرج الحي من الميت} [الأنعام: 95] "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7656 - (@)(@@) حدثنا محمد بن محمد بن مصعب الصوري , بمكة , ثنا مؤمل , ثنا حماد بن سلمة , وسفيان الثوري , عن سليمان التيمي , عن أبي عثمان , عن سلمان , قال: قال عمر: {يخرج الحي من الميت} [الأنعام: 95] , يخرج المؤمن من الكافر(@)(@@) PageV00P000(@)(@@) حدثنا الحسن بن أبي الربيع , ثنا عبد الرزاق , ثنا معمر , عن الزهري , أن النبي صلى الله عليه وسلم دخل على بعض نسائه فإذا بامرأة حسنة الهيئة , فقال: «من هذه؟» فقالت: خالدة بنت الأسود , فقال: " سبحان الله الذي {يخرج الحي من الميت} [الأنعام: 95] " وكانت امرأة صالحة، وكان أبوها كافرا(@)(@@) PageV04P1352(@)(@@)(@@)(@@) | الوجه الثاني(@)(@@) PageV04P1352(@)(@@)(@@)(@@) | 7658 - (@)(@@) حدثنا أبو سعيد الأشج , ثنا عبيد الله، عن إسرائيل، عن السدي , عمن حدثه , عن ابن عباس , في قوله: {يخرج الحي من الميت} [الأنعام: 95] قال: يخرج من النطفة بشرا وروي عن ابن مسعود وأبي سعيد الخدري , وسعيد بن جبير , ومجاهد , والنخعي , وقتادة , والضحاك نحو ذلك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7659 - (@)(@@) حدثنا أبو سعيد الأشج , ثنا وكيع , عن سفيان , عن السدي , عن أبي مالك , قوله: {يخرج الحي من الميت} [الأنعام: 95] قال: النخلة من النواة , والسنبلة من الحبة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7660 - (@)(@@) حدثنا أبو سعيد الأشج , ثنا أبو تميلة , ثنا أبو المنيب , عن عكرمة: {يخرج الحي من الميت ومخرج الميت من الحي} [الأنعام: 95] قال: البيضة تخرج من الحي وهي ميتة , ثم يخرج منها الحي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله 
ms1172	 تعالى: {ومخرج الميت من الحي} (@)(@@) [الأنعام: 95](@)(@@) PageV04P1352(@)(@@)(@@)(@@) | 7661 - (@)(@@) أخبرنا محمد بن محمد بن مصعب الصوري , ثنا مؤمل بن إسماعيل , ثنا حماد بن سلمة , وسفيان الثوري , عن سليمان التيمي , عن أبي عثمان، عن سلمان , قال: قال عمر: خمر الله عز وجل طينة آدم أربعين يوما , ثم وضع يده فيها، فارتفع على هذه كل طيب، وعلى هذه كل خبيث، ثم خلط بعضه ببعض - وقال مؤمل بيده هكذا - ودمج إحداهما بالأخرى , ثم خلق منها آدم , فمن ثم {يخرج الحي من الميت ومخرج الميت من الحي} [الأنعام: 95] , يخرج المؤمن من الكافر , ويخرج الكافر من المؤمن وروي عن الحسن وقتادة نحو ذلك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | الوجه الثاني(@)(@@) PageV04P1352(@)(@@)(@@)(@@) | 7662 - (@)(@@) أخبرنا أبو سعيد الأشج , ثنا سلمة بن رجاء , عن الأعمش , عن إبراهيم , عن عبد الله , قوله: {ومخرج الميت من الحي} [الأنعام: 95] قال: يخرج النطفة الميتة من الرجل الحي(@)(@@)(@@)(@@) | [ص: 1353](@)(@@) وروي عن ابن عباس , ومجاهد , وسعيد بن جبير , والنخعي , والضحاك والسدي نحو ذلك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7663 - (@)(@@) حدثنا أبي , ثنا عيسى بن جعفر , قاضي الري , ثنا مسلم بن خالد , عن ابن أبي نجيح , عن مجاهد: قوله: {يخرج الحي من الميت ومخرج الميت من الحي} [الأنعام: 95] قال: الناس الأحياء من النطف , والنطفة ميتة تخرج من الناس الأحياء , ومن الأنعام والنبات كذلك أيضا(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7664 - (@)(@@) حدثنا أبو سعيد الأشج , ثنا وكيع , عن سفيان , عن السدي , عن أبي مالك , في قوله: {ومخرج الميت من الحي} [الأنعام: 95] قال: النواة من النخلة , والحبة من السنبلة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7665 - (@)(@@) حدثنا أبو سعيد الأشج , ثنا أبو تميلة , ثنا أبو المنيب , عن عكرمة , قوله: {ومخرج الميت من الحي} [الأنعام: 95] قال: البيضة تخرج من الحي وهي ميتة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {ذلكم الله فأنى تؤفكون} (@)(@@) [الأنعام: 95](@)(@@) PageV04P1353(@)(@@)(@@)(@@) | 7666 - (@)(@@) حدثنا أبو زرعة , ثنا منجاب بن الحارث، ثنا بشر بن عمارة , عن أبي روق , عن الضحاك , عن ابن عباس: {أنى تؤفكون} [الأنعام: 95] , {أنى} [الأنعام: 95] قال: كيف(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7667 - (@)(@@) حدثنا أبي , ثنا محمد بن عبد الأعلى , ثنا محمد بن ثور , عن معمر , عن الحسن , {فأنى تؤفكون} [الأنعام: 95] , قال: أنى تصرفون(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7668 - (@)(@@) حدثنا أبو زرعة , ثنا 
ms1173	 منجاب بن الحارث , ثنا بشر بن عمارة , عن أبي روق , عن الضحاك , عن ابن عباس , قوله: {تؤفكون} [الأنعام: 95] قال: تكذبون(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {فالق} (@)(@@) [الأنعام: 95](@)(@@) PageV04P1353(@)(@@)(@@)(@@) | 7669 - (@)(@@) أخبرنا محمد بن سعد , فيما كتب إلي , حدثني أبي , حدثني عمي , عن أبيه , عن عطية , عن ابن عباس , قوله: {فالق الإصباح} [الأنعام: 96] , يقول: خالق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {الإصباح} (@)(@@) [الأنعام: 96](@)(@@) PageV04P1353(@)(@@)(@@)(@@) | 7670 - (@)(@@) حدثنا أبي , ثنا أبو صالح , حدثني معاوية بن صالح , عن علي بن أبي طلحة , عن ابن عباس , قوله: {فالق الإصباح} [الأنعام: 96] يعني: بالإصباح ضوء الشمس بالنهار , وضوء القمر بالليل(@)(@@) PageV00P000(@)(@@) أخبرنا محمد بن سعد العوفي , فيما كتب إلي , حدثني أبي , حدثني عمي , حدثني أبي , عن عطية , عن ابن عباس: {فالق الإصباح} [الأنعام: 96] يقول: خالق الليل والنهار(@)(@@)(@@)(@@) | 7672 - (@)(@@) وروي عن عبد الرحمن بن زيد بن أسلم , أنه قال: فلق الإصباح عن الليل(@)(@@) PageV00P000(@)(@@)(@@)(@@) | الوجه الثاني(@)(@@) PageV04P1354(@)(@@)(@@)(@@) | 7673 - (@)(@@) حدثنا حجاج بن حمزة , ثنا شبابة , ثنا ورقاء , عن ابن أبي نجيح , عن مجاهد: {فالق الإصباح} [الأنعام: 96] إضاءة الفجر وروي عن قتادة مثل ذلك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7674 - (@)(@@) حدثنا أبي , ثنا عبد العزيز بن منيب , ثنا أبو معاذ عن عبيد بن سليمان , عن الضحاك , قوله: {فالق الإصباح} [الأنعام: 96] يقول: خالق النور , نور النهار(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {وجعل الليل سكنا} (@)(@@) [الأنعام: 96](@)(@@) PageV04P1354(@)(@@)(@@)(@@) | 7675 - (@)(@@) حدثنا أبو زرعة , ثنا صفوان بن صالح , ثنا الوليد , ثنا سعيد بن بشير , عن قتادة , في قول الله: {وجعل الليل سكنا} [الأنعام: 96] يسكن فيه كل طير ودابة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7676 - (@)(@@) حدثنا علي بن الحسين , ثنا عبد الله بن محمد الأذرمي , ثنا ملبد بن إسحاق المروزي , ثنا ابن المبارك , عن عبد العزيز بن أبي رواد , قال: كان لصهيب امرأة فكان يطيل السهر , قال: فقالت له: يا صهيب , قد أفسدت علي نفسك فقال صهيب: إن الله جعل الليل سكنا لصهيب , وإن صهيبا إذا ذكر الجنة طال شوقه , وإذا ذكر النار طار نومه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {والشمس والقمر حسبانا} (@)(@@) [الأنعام: 96](@)(@@) PageV04P1354(@)(@@)(@@)(@@) | 7677 - (@)(@@) حدثنا أبي , ثنا أبو صالح كاتب الليث , حدثني معاوية بن صالح , عن علي بن أبي طلحة , عن ابن عباس , قوله: {والشمس والقمر حسبانا} [الأنعام: 96] , يعني: 
ms1174	 عدد الأيام والشهور والسنين(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7678 - (@)(@@) حدثنا الحسن بن أبي الربيع , ثنا عبد الرزاق , ثنا معمر , عن قتادة , في قوله: {والشمس والقمر حسبانا} [الأنعام: 96] , قال: يدوران في حساب(@)(@@) PageV00P000(@)(@@) حدثنا أبو زرعة , ثنا صفوان , ثنا الوليد , ثنا سعيد بن بشير , عن قتادة: {والشمس والقمر حسبانا} [الأنعام: 96] , أي: ضياء(@)(@@) PageV04P1355(@)(@@)(@@)(@@) | 7680 - (@)(@@) حدثنا أبو زرعة , ثنا يحيى بن عبد الله بن بكير، حدثني عبد الله بن لهيعة , حدثني عطاء بن دينار , عن سعيد بن جبير: {العليم} [الأنعام: 96] يعني: عالما بها(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {وهو الذي جعل لكم النجوم لتهتدوا بها} (@)(@@) [الأنعام: 97](@)(@@) PageV04P1355(@)(@@)(@@)(@@) | 7681 - (@)(@@) أخبرنا محمد بن سعد , فيما كتب إلي , حدثني أبي , حدثني عمي , عن أبيه , عن عطية , عن ابن عباس , قوله: {وهو الذي جعل لكم النجوم لتهتدوا بها في ظلمات البر والبحر} [الأنعام: 97] , قال: يضل الرجل وهو في الظلمة والجور عن الطريق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {وهو الذي أنشأكم من نفس واحدة} (@)(@@) [الأنعام: 98](@)(@@) PageV04P1355(@)(@@)(@@)(@@) | 7682 - (@)(@@) أخبرنا أحمد بن عثمان بن حكيم الأودي , فيما كتب إلي , ثنا أحمد بن مفضل , ثنا أسباط , عن السدي , يعني قوله: {وهو الذي أنشأكم من نفس واحدة} [الأنعام: 98] : أما {نفس واحدة} [النساء: 1] فمن آدم وروي عن مجاهد وأبي مالك , وقتادة , ومقاتل بن حيان مثل ذلك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {فمستقر} (@)(@@) [الأنعام: 98](@)(@@) PageV04P1355(@)(@@)(@@)(@@) | 7683 - (@)(@@) حدثنا محمد بن حماد الطهراني , ثنا حفص بن عمر العدني , ثنا الحكم بن أبان , عن عكرمة , عن ابن عباس: {فمستقر ومستودع} [الأنعام: 98] قال: المستقر ما كان في أرحام النساء وروي عن عبد الله بن مسعود , وقيس بن أبي حازم , وأبي عبد الرحمن السلمي , وعطاء , ومجاهد والنخعي , والضحاك , وقتادة , والسدي , وعطاء الخراساني نحو ذلك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | الوجه الثاني(@)(@@) PageV04P1355(@)(@@)(@@)(@@) | 7684 - (@)(@@) حدثنا الحسن بن أبي الربيع , ثنا عبد الرزاق , ثنا ابن عيينة , عن إسماعيل بن أبي خالد , عن إبراهيم , قال: قال عبد الله: مستقر في الدنيا(@)(@@)(@@)(@@) | [ص: 1356](@)(@@) قال أبو محمد: وروى الثقات عن ابن أبي خالد , عن النخعي , عن ابن مسعود: مستقرها: في الرحم(@)(@@) PageV00P000(@)(@@)(@@)(@@) | الوجه الثالث(@)(@@) PageV04P1356(@)(@@)(@@)(@@) | 7686 - (@)(@@) حدثنا الحسن بن أبي الربيع , ثنا عبد الرزاق , ثنا ابن التيمي , عن ليث , عن الحكم 
ms1175	 , عن مقسم , عن ابن عباس , قال: مستقرها: حين تأوي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | الوجه الرابع(@)(@@) PageV04P1356(@)(@@)(@@)(@@) | 7687 - (@)(@@) حدثنا الأشج , ثنا أبو أسامة , وأحمد بن بشير , عن إسماعيل بن أبي خالد , سمع السدي , يقول في حديث أحمد بن بشير , عن السدي: {فمستقر ومستودع} [الأنعام: 98] قال: المستقر ما فرغ من خلقه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | الوجه الخامس(@)(@@) PageV04P1356(@)(@@)(@@)(@@) | 7688 - (@)(@@) حدثنا أبي , ثنا عبد الله بن رجاء , ثنا إسرائيل , عن أبي يحيى , عن مجاهد , في قوله: {فمستقر ومستودع} [الأنعام: 98] قال: المستقر في الأرض(@)(@@) PageV00P000(@)(@@)(@@)(@@) | الوجه السادس(@)(@@) PageV04P1356(@)(@@)(@@)(@@) | 7689 - (@)(@@) حدثنا علي بن الحسين، ثنا أحمد بن منيع , ثنا هشيم , ثنا منصور , عن الحسن , في قوله: {مستقر} [الأنعام: 98] , قال: المستقر الذي قد مات فاستقر به عمله(@)(@@) PageV00P000(@)(@@)(@@)(@@) | الوجه السابع(@)(@@) PageV04P1356(@)(@@)(@@)(@@) | 7690 - (@)(@@) حدثنا أبي , ثنا محمد بن حاتم , ثنا يونس يعني ابن محمد، ثنا يعقوب الأشعري القمي , ثنا إبراهيم بن محمد ابن الحنفية , وسألته , فقلت: مستقر ومستودع؟ قال: المستقر في أصلاب الرجال(@)(@@) PageV00P000(@)(@@)(@@)(@@) | الوجه الثامن(@)(@@) PageV04P1356(@)(@@)(@@)(@@) | 7691 - (@)(@@) حدثنا أبي , ثنا الوليد بن نفيل , ثنا إسماعيل ابن علية , ثنا كلثوم بن جبر , عن سعيد بن جبير , في قوله: {فمستقر ومستودع} [الأنعام: 98] قال: إذا قروا في أرحام النساء , وعلى ظهر الأرض أو في بطنها , فقد استقروا(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {ومستودع} (@)(@@) [الأنعام: 98](@)(@@) PageV04P1357(@)(@@)(@@)(@@) | 7692 - (@)(@@) حدثني أبو عبد الله الطهراني محمد بن حماد , ثنا حفص بن عمر , ثنا الحكم بن أبان , عن عكرمة , عن ابن عباس , في قوله: {فمستقر ومستودع} [الأنعام: 98] قال: والمستودع ما كان في أصلاب الرجال(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7693 - (@)(@@) حدثنا أبي , ثنا أبو صالح , حدثني معاوية بن صالح , عن علي بن أبي طلحة , عن ابن عباس , قوله: {ومستودع} [الأنعام: 98] , قال: المستودع ما استودع في أصلاب الرجال والدواب وروي عن قيس بن أبي حازم , وسعيد بن جبير , وأبي عبد الرحمن السلمي , ومجاهد , وإبراهيم النخعي , وقتادة , والسدي , والضحاك , وعطاء الخراساني نحو ذلك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | الوجه الثاني(@)(@@) PageV04P1357(@)(@@)(@@)(@@) | 7694 - (@)(@@) حدثنا أبو سعيد الأشج , ثنا عبيد الله بن موسى , عن إسرائيل , عن السدي , عن مرة , عن عبد الله , {فمستقر ومستودع} [الأنعام: 98] قال: المستودع المكان الذي يموت فيه وروي عن الضحاك , عن ابن عباس مثل ذلك. وروي 
ms1176	 عن مجاهد في أحد قوليه مثله(@)(@@) PageV00P000(@)(@@)(@@)(@@) | الوجه الثالث(@)(@@) PageV04P1357(@)(@@)(@@)(@@) | 7695 - (@)(@@) حدثنا الحسن بن أبي الربيع , ثنا عبد الرزاق , ثنا ابن عيينة , عن إسماعيل بن أبي خالد , عن إبراهيم , قال: قال عبد الله: مستودعها في الآخرة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | الوجه الرابع(@)(@@) PageV04P1357(@)(@@)(@@)(@@) | 7696 - (@)(@@) حدثنا علي بن الحسين , ثنا أحمد بن منيع , ثنا هشيم , ثنا منصور , عن الحسن , {ومستودع} [الأنعام: 98] قال: إلى أجل(@)(@@) PageV00P000(@)(@@)(@@)(@@) | الوجه الخامس(@)(@@) PageV04P1357(@)(@@)(@@)(@@) | 7697 - (@)(@@) حدثنا أبي , ثنا محمد بن حاتم الزمي , ثنا يونس بن محمد , ثنا يعقوب الأشعري القمي , ثنا إبراهيم بن محمد ابن الحنفية , وسألته , فقلت: {فمستقر ومستودع} [الأنعام: 98] قال: المستودع في أرحام النساء(@)(@@)(@@)(@@) | [ص: 1358](@)(@@) قال أبو محمد: وهو أحد قولي عطاء بن أبي رباح , وقول زيد بن علي بن الحسين(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {قد فصلنا الآيات لقوم يفقهون} (@)(@@) [الأنعام: 98](@)(@@) PageV04P1358(@)(@@)(@@)(@@) | 7699 - (@)(@@) أخبرنا محمد بن يحيى , ثنا العباس بن الوليد , ثنا يزيد بن ربيع بن زريع , ثنا سعيد , عن قتادة , قوله: {قد فصلنا الآيات لقوم يفقهون} [الأنعام: 98] يقول: بينا {الآيات لقوم يفقهون} [الأنعام: 98](@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله عز وجل: {وهو الذي أنزل من السماء ماء} (@)(@@) [الأنعام: 99](@)(@@) PageV04P1358(@)(@@)(@@)(@@) | 7700 - (@)(@@) حدثنا أبي , ثنا سليمان بن حرب , ثنا حماد بن زيد , عن عبد الجليل , عن شهر بن حوشب , أن أبا هريرة , قال: ما نزل قطر إلا بميزان(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7701 - (@)(@@) حدثنا أبي , ثنا محمود بن غيلان , ثنا علي بن الحسن بن شقيق , ثنا الحسين بن واقد , ثنا علباء بن أحمر , عن عكرمة , قال: ينزل الله الماء من السماء السابعة فتقع القطرة منه على السحابة مثل البعير(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {فأخرجنا به نبات كل شيء} (@)(@@) [الأنعام: 99](@)(@@) PageV04P1358(@)(@@)(@@)(@@) | 7702 - (@)(@@) حدثنا أبي , ثنا أبو الأشعث , ثنا المعتمر , قال: سمعت أبي يحدث عن سيار , عن خالد بن يزيد , قال: كان عند عبد الملك بن مروان فذكروا الماء , فقال خالد بن يزيد: منه من السماء , ومنه ما يسقيه الغيم من البحر فيعذبه الرعد والبرق , فأما ما كان من البحر فلا يكون له نبات , وأما النبات فمما كان من السماء(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {فأخرجنا منه خضرا نخرج منه حبا متراكبا} (@)(@@) [الأنعام: 99](@)(@@) PageV04P1358(@)(@@)(@@)(@@) | 7703 - (@)(@@) أخبرنا أحمد بن 
ms1177	 عثمان بن حكيم , فيما كتب إلي , ثنا أحمد بن مفضل , ثنا أسباط , عن السدي , قوله: {فأخرجنا منه خضرا نخرج منه حبا متراكبا} [الأنعام: 99] قال: السنبل(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {ومن النخل من طلعها} (@)(@@) [الأنعام: 99](@)(@@) PageV04P1358(@)(@@)(@@)(@@) | 7704 - (@)(@@) حدثنا أبي , ثنا عبد العزيز بن منيب , ثنا أبو معاذ النحوي , عن عبيد بن سليمان , عن الضحاك , في قوله: {ومن النخل من طلعها} [الأنعام: 99] : يعني: النخل الملتزقة بالأرض(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {قنوان} (@)(@@) [الأنعام: 99](@)(@@) PageV04P1359(@)(@@)(@@)(@@) | 7705 - (@)(@@) حدثنا أبي , ثنا أبو صالح , حدثني معاوية بن صالح , عن علي بن أبي طلحة , عن ابن عباس , قوله: {ومن النخل من طلعها قنوان دانية} [الأنعام: 99] يعني بالقنوان الدانية: قصار النخل اللاصقة عذوقها بالأرض(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7706 - (@)(@@) حدثنا أبي , ثنا سهل بن عثمان , ثنا رجل , سماه عن السدي , عن ابن عباس , قوله: {قنوان دانية} [الأنعام: 99] قال: قنوان: الكبائس(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7707 - (@)(@@) حدثنا الحسن بن أبي الربيع , ثنا عبد الرزاق , ثنا معمر , عن قتادة , في قوله: قنوان دانية قال: {قنوان} [الأنعام: 99] عذوق النخل(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7708 - (@)(@@) أخبرنا أحمد بن الأزهر بن منيع , فيما كتب إلي , ثنا وهب بن جرير , ثنا أبي , عن علي بن الحكم , عن الضحاك , في قوله: {قنوان دانية} [الأنعام: 99] : يعني بالقنوان: الطلع(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {دانية} (@)(@@) [الأنعام: 99](@)(@@) PageV04P1359(@)(@@)(@@)(@@) | 7709 - (@)(@@) حدثنا أبو سعيد الأشج , ثنا عمرو العنقزي , عن سفيان الثوري , عن أبي إسحاق , عن البراء بن عازب , {قنوان دانية} [الأنعام: 99] قال: قريبة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7710 - (@)(@@) حدثنا أبي , ثنا سهل بن عثمان , ثنا رجل , سماه عن السدي , عن ابن عباس , قوله: {دانية} [الأنعام: 99] , والدانية: المنصوبة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7711 - (@)(@@) أخبرنا محمد بن سعد , فيما كتب إلي , حدثني أبي , حدثني عمي , عن أبيه , عن عطية , عن ابن عباس , قوله: {قنوان دانية} [الأنعام: 99] قال: دانية: تهدل العذوق من الطلع(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7712 - (@)(@@) حدثنا الحسن بن أبي الربيع , ثنا عبد الرزاق , عن معمر , عن قتادة , في قوله: {قنوان دانية} [الأنعام: 99] يقول: دانية: متهدلة قال أبو محمد: يعني متدلية(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {وجنات من أعناب والزيتون والرمان مشتبها وغير متشابه} (@)(@@) [الأنعام: 99](@)(@@) PageV04P1359(@)(@@)(@@)(@@) | 7713 - (@)(@@) حدثنا أبي , ثنا نصر بن علي , ثنا أبي , عن خالد بن قيس , عن قتادة 
ms1178	 , قوله: {مشتبها وغير متشابه} [الأنعام: 99] , يقال: متشابها ورقه مختلفا ثمره(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {انظروا إلى ثمره إذا أثمر} (@)(@@) [الأنعام: 99](@)(@@) PageV04P1359(@)(@@)(@@)(@@) | 7714 - (@)(@@) حدثنا أبي , ثنا عمرو بن علي , ثنا محمد بن الزبرقان , عن موسى بن عبيدة , عن محمد بن كعب , {انظروا إلى ثمره إذا أثمر} [الأنعام: 99] قال: رطبه وعنبه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {وينعه} (@)(@@) [الأنعام: 99](@)(@@) PageV04P1360(@)(@@)(@@)(@@) | 7715 - (@)(@@) حدثنا الحسن بن عرفة , ثنا عمار بن محمد , عن سفيان الثوري , عن أبي إسحاق , عن البراء , {انظروا إلى ثمره إذا أثمر وينعه} [الأنعام: 99] قال: نضجه حين ينضج وروي عن ابن عباس والسدي , والضحاك , وعطاء الخراساني , وقتادة , وعبد الله بن أبي إسحاق البصري مثل ذلك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {إن في ذلكم لآيات لقوم يؤمنون} (@)(@@) [الأنعام: 99](@)(@@) PageV04P1360(@)(@@)(@@)(@@) | قوله تعالى: {وجعلوا لله شركاء الجن وخلقهم} (@)(@@) [الأنعام: 100](@)(@@) PageV04P1360(@)(@@)(@@)(@@) | 7716 - (@)(@@) حدثنا أبي , ثنا أبو صالح , حدثني معاوية بن صالح , عن علي بن أبي طلحة , عن ابن عباس , {وجعلوا لله شركاء الجن} [الأنعام: 100] , والله خلقهم(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7717 - (@)(@@) حدثنا أبو سعيد الأشج , ثنا المحاربي , عن جويبر , عن الضحاك , في قوله: {وجعلوا لله شركاء} [الأنعام: 100] يقول: هل تشركون عبيدكم في الذي لكم فتكونوا فيه سواء؟ فكيف ترضون لي ما لا ترضون لأنفسكم؟(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {وخرقوا له بنين} (@)(@@) [الأنعام: 100](@)(@@) PageV04P1360(@)(@@)(@@)(@@) | 7718 - (@)(@@) حدثنا أبي , ثنا أبو صالح , حدثني معاوية بن صالح , عن علي بن أبي طلحة , عن ابن عباس , {وخرقوا له بنين وبنات بغير علم} [الأنعام: 100] : يعني: أنهم تخرصوا وروي عن قتادة , مثل ذلك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7719 - (@)(@@) أخبرنا محمد بن سعد , فيما كتب إلي , حدثني أبي , حدثني عمي , عن أبيه , عن عطية , عن ابن عباس , قوله: {وخرقوا له بنين وبنات} [الأنعام: 100] , قال: جعلوا له بنين وبنات(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7720 - (@)(@@) أخبرنا أحمد بن عثمان بن حكيم الأودي , فيما كتب إلي , ثنا أحمد بن مفضل , ثنا أسباط , عن السدي , قوله: {وخرقوا له بنين وبنات} [الأنعام: 100] يعني: قطعوا(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7721 - (@)(@@) حدثنا حجاج بن حمزة , ثنا شبابة , ثنا ورقاء , عن ابن أبي نجيح , عن مجاهد , قوله: {وخرقوا له بنين وبنات} [الأنعام: 100] يقول: كذبوا وروي عن الحسن , مثل ذلك(@)(@@) PageV00P000(@)(@@) حدثنا أبو سعيد الأشج , ثنا أبو أسامة , عن 
ms1179	 جويبر , عن الضحاك , {وخرقوا له بنين وبنات} [الأنعام: 100] قال: وصفوا له(@)(@@) PageV04P1361(@)(@@)(@@)(@@) | 7723 - (@)(@@) حدثنا أبي , ثنا نصر بن علي , ثنا أبي , ثنا خالد بن قيس , عن قتادة , قوله: {وخرقوا له بنين وبنات} [الأنعام: 100] قال: كذبوا له , أما اليهود والنصارى فقالوا: نحن أبناء الله وأحباؤه , وهم كذبوا به , وأما مشركو العرب فكانوا يعبدون اللات والعزى فيقولون: العزى بنات الله فأكذبهم الله ونفاهم من فرائهم(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {بنين وبنات بغير علم} (@)(@@) [الأنعام: 100](@)(@@) PageV04P1361(@)(@@)(@@)(@@) | 7724 - (@)(@@) أخبرنا أحمد بن عثمان بن حكيم , فيما كتب إلي , ثنا أحمد بن المفضل , ثنا أسباط , عن السدي , قوله: {وخرقوا له بنين وبنات بغير علم} [الأنعام: 100] يقول: قطعوا له بنين وبنات , قالت العرب: الملائكة بنات الله , وقالت اليهود والنصارى: المسيح وعزير أبناء الله(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7725 - (@)(@@) أخبرنا أبو يزيد القراطيسي , فيما كتب إلي , ثنا أصبغ بن الفرج , قال: سمعت عبد الرحمن بن زيد بن أسلم , يقول في قوله: {وخرقوا له بنين وبنات بغير علم} [الأنعام: 100] قال: خرقوا: كذبوا , لم يكن لله بنون ولا بنات , قالت النصارى: المسيح ابن الله , وقال المشركون: الملائكة بنات الله , فكل خرقوا الكذب , وخرق: اخترق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {سبحانه} (@)(@@) [البقرة: 116](@)(@@) PageV04P1361(@)(@@)(@@)(@@) | 7726 - (@)(@@) حدثنا أبو سعيد الأشج , ثنا حفص بن غياث , عن حجاج , عن ابن أبي مليكة , عن ابن عباس , قوله: {سبحان الله} [المؤمنون: 91] , قال: تنزيه الله نفسه عن السوء , ثم قال عمر لعلي رضي الله عنهما , وأصحابه عنده: لا إله إلا الله قد عرفناه , فما سبحان الله؟ فقال له علي رضي الله عنه: كلمة أحبها الله لنفسه ورضيها وأحب أن تقال(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7727 - (@)(@@) حدثنا أبي , ثنا ابن نفيل , ثنا النضر بن موسى , قال: سأل رجل ميمون بن مهران عن سبحان الله , فقال: اسم يعظم الله به، ويحاشى به من السوء(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7728 - (@)(@@) حدثني أبي , ثنا سهل بن عثمان , ثنا أبو مالك يعني عمرو بن هاشم الجنبي، عن جويبر , عن الضحاك , في قوله: {سبحانه} [الأنعام: 100] يقول: عجب(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {وتعالى عما يصفون} (@)(@@) [الأنعام: 100](@)(@@) PageV04P1362(@)(@@)(@@)(@@) | 7729 - (@)(@@) حدثنا أبي , ثنا نصر بن علي , ثنا أبي , عن خالد بن قيس , عن 
ms1180	 قتادة , {وتعالى عما يصفون} [الأنعام: 100] أي عما يكذبون(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {بديع السموات والأرض}(@)(@@) PageV04P1362(@)(@@)(@@)(@@) | 7730 - (@)(@@) حدثنا عصام بن رواد العسقلاني , ثنا آدم , عن أبي جعفر , عن الربيع , عن أبي العالية , قوله: {بديع السموات والأرض} قال: ابتدع خلقهما ولم يشركه في خلقهما أحد وروي عن الربيع بن أنس نحو ذلك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7731 - (@)(@@) حدثنا أبو زرعة , ثنا عمرو بن حماد بن طلحة , ثنا أسباط , عن السدي , {بديع السموات والأرض} , يقول: ابتدعهما فخلقهما ولم يخلق قبلهما شيئا فيتمثل عليه وروي عن مجاهد نحو ذلك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {أنى يكون له ولد ولم تكن له صاحبة} [الأنعام: 101] الآية(@)(@@) PageV04P1362(@)(@@)(@@)(@@) | 7732 - (@)(@@) حدثنا أبو زرعة , ثنا يحيى بن عبد الله , حدثني ابن لهيعة , حدثني عطاء بن دينار , عن سعيد بن جبير , قوله: {بكل شيء عليم} [الأنعام: 101] يعني: من أعمالكم عليم(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله عز وجل: {ذلكم الله ربكم لا إله إلا هو خالق كل شيء} (@)(@@) [الأنعام: 102](@)(@@) PageV04P1362(@)(@@)(@@)(@@) | 7733 - (@)(@@) حدثنا محمد بن يحيى , ثنا أبو غسان , ثنا سلمة بن الفضل , قال: قال محمد بن إسحاق: {لا إله إلا هو} [الأنعام: 102] أي: ليس معه غيره شريك في أمره(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {فاعبدوه وهو على كل شيء وكيل} (@)(@@) [الأنعام: 102](@)(@@) PageV04P1362(@)(@@)(@@)(@@) | 7734 - (@)(@@) حدثنا محمد بن يحيى , ثنا أبو غسان , ثنا سلمة بن الفضل , عن محمد بن إسحاق , قال: فيما حدثني محمد بن أبي محمد , عن عكرمة , أو سعيد بن جبير , عن ابن عباس , «اعبدوا» أي: وحدوا(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله: {لا تدركه الأبصار} (@)(@@) [الأنعام: 103](@)(@@) PageV04P1362(@)(@@)(@@)(@@) | 7735 - (@)(@@) حدثنا أبو سعيد بن يحيى بن سعيد القطان , ثنا يحيى بن آدم , ثنا أبو بكر بن عياش , عن عاصم بن أبي النجود , عن أبي الضحى , عن مسروق , عن عائشة , قالت(@)(@@)(@@)(@@) | [ص: 1363](@)(@@) : " من زعم أن محمدا , أبصر ربه فقد كذب , قال الله: {لا تدركه الأبصار وهو يدرك الأبصار} [الأنعام: 103] "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7736 - (@)(@@) حدثنا 