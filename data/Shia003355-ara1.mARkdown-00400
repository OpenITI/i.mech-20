ms381	 كتاب الفتى العاشق وهند المستعجلة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الفتى العاشق النسب وذات الخال.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الفتى الأحمق وشمسه عاشقته.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب العاشق المجنون وسلم وجاريتها المخبلة .(@)PageV00P366(@)(@@)(@@)(@@) ||| أسماء عشاق الانس للجن وعشاق الجن للانس(@)(@@)(@@)(@@) $DIC_BIB$ كتاب دعد والرباب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب رفاعة العبسي وسكر.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب سعسع وقمع.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب ناعم بن دارم ورحيمه وشيطان الطاق.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الأغلب والرباب .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الضرغام وجودووقس .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب عمرو ودقانوس .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الشماخ ورمع .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الخزرجي المحتال واسما.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب حصن بن النبهان والجنية.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الدلفاء وإخوتها والجني.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب عدد الفزارية والجني وعمرو.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب عمر بن سفيان السلمي والجنية.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب عمرو بن المكشوح والجنية.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب ربيعة بن قدام والجنية.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب سعد بن عمير والنوار.(@)(@@) قال محمد بن إسحاق: كانت الأسمار والخرافات. مرغوبا فيها مشتهاة في أيام خلفاء بنى العباس، وسيما في أيام المقتدر. فصنف الوراقون، وكذبوا. فكان ممن يفتعل ذلك رجل يعرف بابن دلان واسمه أحمد بن محمد بن دلان، وآخر يعرف بابن العطار، وجماعة. وقد ذكرنا فيما تقدم من كان يعمل الخرافات والأسمار على السنة الحيوان وغيره، وهم سهل بن هارون وعلي بن داود والعتابي وأحمد بن أبي طاهر.(@)(@@)(@@)(@@) ||| الكتاب المؤلفة في عجائب البحر وغيره(@)(@@) وهي كتاب يعرف بكتاب صخر المغربي، وألفه... ويحتوي على ثلاثين حديثا، عشرة في عجائب البر وعشرة في عجائب السحرة وعشرة في عجائب البحر.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب واثلة ابن الأسقع.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب السميفع بن ذي يرحم الحميري والعقوف بنت زيد.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الشيخ بن الشاب.(@)PageV00P367(@)(@@) بسم الله الرحمن الرحيم(@)(@@)(@@)(@@) || الفن الثاني من المقالة الثامنة من كتاب الفهرست في اخبار العلماء وأسماء ما صنفوه من الكتب ويحتوي على اخبار المعزمين والمشعبذين والسحرة وأصحاب النيرنجيات والحيل والطلسمات قال محمد بن إسحاق النديم: زعم المعزمون والسحرة ان الشياطين والجن والأرواح تطيعهم وتخدمهم وتنصرف بين أمرهم ونهيهم. فاما المعزمون ممن ينتحل الشرائع، فزعم ان ذلك يكون بطاعة الله جل اسمه، والابتهال إليه، والأقسام على الأرواح والشياطين به، وترك 
ms382	 الشهوات ولزوم العبادات. وان الجن والشياطين.(@)(@@) يطيعونهم اما طاعة لله جل اسمه لأجل الأقسام به، واما مخافة منه تبارك وتعالى. ولان في خاصية أسمائه، تقدست وذكره علا وجل، قمعهم واذلالهم. فاما السحرة، فزعمت أنها تستعبد الشياطين بالقرابين والمعاصي وارتكاب المحظورات، مما لله جل اسمه، في تركها رضا، وللشياطين في استعمالها رضا، مثل ترك الصلاة والصوم واباحات الدماء ونكاح ذوات المحرم، وغير ذلك من الافعال الشرية. وهذا الشأن ببلاد مصر وما والاها ظاهر، والكتب فيه، مؤلفة كثيرة موجودة. وبابل السحرة، بأرض مصر. قال لي من رآها: وبها بقايا ساحرين وساحرات. وزعم الجميع من المعزمين والسحرة، ان لهم خواتيم وعزائم ورقى ومنادل وجراب ودخن وغير ذلك، مما يستعملونه في علومهم.(@)(@@)(@@)(@@) ||| حكاية أخرى(@)(@@) زعم طائفة من الفلاسفة، وعبدة النجوم، انهم يعملون الطلسمات على ارصاد الكواكب لجميع ما يريدونه من الافعال البديعة والتهيجات والعطوف والتسليطات، ولهم نقوش على الحجارة والخرز والفصوص، وهذا علم فاشي ظاهر في الفلاسفة. وللهند اعتقاد في ذلك. وأفعال عجيبة. وللصين حيل وسحر من طريقة أخرى. وللهند خاصة، علم التوهم ولها في ذلك كتب، قد نقل بعضها إلى العربي. وللترك علم من السحر. قال لي من أثق بفضله:(@)PageV00P369 انهم يعملون عجائب، من هزائم الجيوش وقتل الأعداء وعبور المياه وقطع المسافات البعيدة في المدة القريبة. والطلسمات بأرض مصر والشام كثيرة ظاهرة الاشخاص. غير أن أفعالها قد بطلت لتقادم العهد.(@)(@@)(@@)(@@) ||| الكلام على الطريقة المحمودة في العزائم(@)(@@) يقال، والله أعلم واحكم، ان سليمان بن داود عليهما السلام أول من استعبد الجن والشياطين واستخدمها.(@)(@@) وقيل أول من استعبدها، على مذاهب الفرس، جمشيد بن اونجهان. قال: وكان يكتب لسليمان بن داود، آصف بن برخيا وهو ابن خالة سليمان، عبراني. ويوسف بن عيصو، عبراني والهرمزان بن الكردول، فارسي وعبراني.(@)(@@)(@@)(@@) ||| أسماء العفاريت الذين دخلوا على سليمان بن داود(@)(@@) وهم سبعون. زعموا ان سليمان بن داود عليه السلام جلس وأحضر رئيس الجن والشياطين، واسمه فقطس، وعرضهم فعرفه فقطس اسم واحد واحد منهم، وفعله في ولد آدم. واخذ عليهم العهد 
ms383	 والميثاق فإذا أقسم عليهم بذلك العهد أجابوا وانصرفوا. والعهود أسماء الله تعالى عز وجل. وهم، فقطس. عمرد.(@)(@@) كيوان. شمرعال. فيروز. مهاقال. زيزب . سيدوك. جندرب . سيار. زنبور. الراحس. كوكب.(@)(@@) حمران. داهر. قارون. شداد. صعصعه. بكتان. هرثمة. بكلم. فروخ. هرمز. همهمه. عيزار. مزاحم. مرة.(@)(@@) فترة. الهيم. ارهبة. خيثع. خيفتة. رياح. رحل. زوبعع . محتوكرا. هيشب. طقيعطان. وقاص. قدمنة.(@)(@@) مفرش. ابرايل. نزار. شفطيل. ديويد. انكرا. خطوفة. ننكيوش. مسلقر. قادم. اشجع. نودر. تيشامة.(@)(@@) عصار. ثعبان. نامان. نمودركى. طبابور. ساهتون. عذافر. مرداس. شيطوب. زعروش. صخر.(@)(@@) العرمرم.(@)(@@) خشرم. شاذان الحرث. الحويرث. عزره. فقرون.(@)(@@)(@@)(@@) ||| أسماء السبعة الذين هؤلاء من ولدهم(@)(@@) فأولهم. دنهش اليوم الأول. شاخبا اليوم الثاني. مربيا اليوم الثالث. عبرا اليوم الرابع.(@)(@@) مسمار اليوم الخامس نمودركى اليوم السادس. بخطش اليوم السابع.(@)(@@)(@@)(@@) $BIO_MAN$ أريوس الرومي(@)(@@) أريوس بن اصطفانوس بن بطلينس الرومي. ويلقب برشيد قومه. وكان من علماء الروم بالعزائم. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب يذكر فيه أولاد إبليس وتفرقهم في البلاد وما يختص به كل جنس منهم في العلل والأرواح.(@)(@@) والاستهلاكات والأفعال والأفعال وأنساب الجن.(@)(@@)(@@)(@@) $BIO_MAN$ لوهق(@)(@@) هو لوهق بن عرفج. قديم. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب طبائع الجن ومواليدهم ومواخيذهم والأرواح الصارعة.(@)(@@) وهذا الكتاب أكبر من كتاب أريوس الرومي.(@)PageV00P370(@)(@@)(@@)(@@) $BIO_MAN$ ابن هلال(@)(@@) من المحدثين. وهو أبو نصر أحمد بن هلال البكيل. وهلال بن وصيف، وهو الذي فتح هذا الامر في الاسلام. وكان مخدوما ومناطقا، وله أفعال عجيبة وأعمال حسنة وخواتيم مجربة. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الروح المتلاشية.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المفاخر في الأعمال.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب تفسير ما قالته الشياطين لسليمان بن داود (صلى الله على نبينا وعليهما) وما اخذ عليهم من العهود.(@)(@@)(@@)(@@) $BIO_MAN$ ابن الإمام(@)(@@) ومن المعزمين الذين يعملون بأسماء الله جل اسمه، رجل يعرف بابن الامام. وكان في أيام المعتضد. وطريقته محمودة غير مذمومة.(@)(@@) عبد الله بن هلال . صالح المديبري. عقبة الأذرعي. أبو خالد الخراساني. هؤلاء يعملون بالطريقة المحمودة، ولهم أفعال جليلة وأعمال نبيلة.(@)(@@)(@@)(@@) $BIO_MAN$ ابن أبي رصاصة(@)(@@) وهو أبو عمرو عثمان بن أبي رصاصة. ممن 
ms384	 رأيناه وشاهدناه. وكان مقدما في صناعته. سألته يوما يا أبا عمرو، انا أنزهك عن التعرض لهذا الشأن. فقال: يا سبحان الله. لي نيف وثمانون سنة. لو لم اعلم أن هذا أمر حق لتركته. ولكني لا أشك في صحته. فقلت: والله لا أفلحت. وله كتب كثيرة وأعمال حسنة. وأهل هذه الصناعة يفصلونه ويقدمونه.(@)(@@)(@@)(@@) ||| الكلام على الطريقة المذمومة(@)(@@) فاما الطريقة المذمومة وهي طريقة السحرة. فزعم من يخبر ذلك. ان بيذخ ابنة إبليس. وقيل هي ابنة ابن إبليس، وان لها عرشا على الماء وان المريد لهذا الامر متى فعل لها ما تريد، وصل إليها وأخدمته من يريد. وقضت حوائجه ولم يحتجب عنها. والذي يفعل لها القرابين من حيوان ناطق وغير ناطق. وان يدع المفترضات ويستعمل كل ما يقبح في العقل استعماله. وقد قيل إن بيذخ هو إبليس نفسه. وقال آخر: ان بيذخ يجلس على عرشها، فيحمل إليها، المريد لطاعتها فيسجد لها. تعالى الله وتقدست أسماؤه.(@)(@@) وقال لي انسان منهم: انه رآها في النوم، جالسة على هيئتها في اليقظة. وانه رأى حولها قوما يشبهون النبط سوادية. حفاة مشققي الأعقاب. وقال لي: رأيت في جملتهم ابن منذر بنى. وهذا رجل من أكابر السحرة، قريب العهد. اسمه أحمد بن جعفر، غلام بن زريق. وكان يناطق من تحت الطست.(@)(@@)(@@)(@@) ||| (@)(@@)(@@)(@@) $BIO_MAN$ ومنهم خلف ابن يوسف(@)(@@) الدستميساني. وله من الكتب على ما ذكر بعض أصحابه ويعرف بابن قنان، كتاب...(@)(@@)(@@)(@@) $BIO_MAN$ ومنهم حماد بن مره(@)(@@) اليماني. روى عن الزرقاء الساحرة على زعمه. وله من الكتب، كتاب التماثيل.(@)PageV00P371(@)(@@)(@@)(@@) $BIO_MAN$ ومنهم الحريري(@)(@@) وهو أبو القاسم الفضل بن سهل بن الفضل. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الحلولات والربوطات والعقد والإدارات.(@)(@@)(@@)(@@) $BIO_MAN$ ابن وحشية الكلداني(@)(@@) وهو أبو بكر أحمد بن علي بن المختار بن عبد الكريم بن جرثيا بن بدنيا بن برناطيا ابن عالاطيا الكسداني الصوفي، من أهل قسين. وكان يدعى انه ساحر يعمل اعمال الطلسمات، ويعمل الصنعة. ونحن نذكر كتبه في الصنعة في موضعها من آخر الكتاب. ومعنى الكسداني نبطي. وهم سكان الأرض 
ms385	 الأول من ولد سنحاريب. وله من الكتب في السحر والطلسمات، كتاب طرد الشياطين ويعرف بالاسرار.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب السحر الكبير، له.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب السحر الصغير.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب دوار على مذهب النبط وهو بشعر قاله .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مذاهب الكلدانيين في الأصنام.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الإشارة في السحر.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اسرار الكواكب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الفلاحة الكبير والصغير.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب حناطوثى اباعى الكسداني في النوع الثاني من الطلسمات، نقله ابن وحشية.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الحياة والموت في علاج الأمراض، لراهطا بن سموطان الكسداني.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الأصنام.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب القرابين.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الطبيعة، له.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الأسماء، له.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مفاوضاته مع أبي جعفر الأموي وسلامة بن سليمان الأخميمي في الصنعة والسحر.(@)(@@)(@@)(@@) $BIO_MAN$ أبو طالب(@)(@@) أحمد بن الحسين بن علي بن أحمد بن محمد بن عبد الملك الزيات. صاحب ابن وحشية. وهو الذي يروى هذه الكتب عنه، ويحيا في وقتنا هذا بل أحسبه مات قريبا.(@)(@@)(@@)(@@) ||| الكلام على الشعبذة والطلسمات والنيرنجات(@)(@@) أول من لعب بالشعبذة في الاسلام، عبيد الكيس، وآخر يعرف بقطب الرحا. ولهما في ذلك عدة كتب منها، كتاب الشعبذة، لعبيد الكيس.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الخفة والدك والقف، لقطب الرحا.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب بلع السيف والقضيب والحصى والسبح واكل الصابون والزجاج والحيلة في ذلك.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المخرقة، لعبيد الكيس. وآخر من رأينا ممن يلعب بالحقة منصورا بالعجب، ومات عن مائة وخمس عشرة سنة. وكان يقول لعبت بين يدي المعتمد.(@)(@@)(@@)(@@) $BIO_MAN$ قالشتانس(@)(@@) هذا قديم، ممن تكلم على خواص الأشياء والنيرنجات والطلسمات. وله من الكتب، كتاب الجامع في النيرنجات والخواص.(@)(@@)(@@)(@@) $BIO_MAN$ بلنياس الحكيم(@)(@@) من أهل الطوانة من بلاد الروم. ويقال انه أول من أحدث الكلام على الطلسمات. وكتابه، فيما عمله بمدينته وبممالك الملوك، من الطلسمات. معروف مشهور.(@)PageV00P372(@)(@@)(@@)(@@) $BIO_MAN$ اروس(@)(@@) رومي، وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب النيرنجات.(@)(@@)(@@)(@@) $BIO_MAN$ سه؟ الهندي(@)(@@) من القدماء. ومذهبه في النيرنجات مذهب الهند. وله كتاب سلك فيه مسلك أصحاب التوهم.(@)(@@)(@@)(@@) ||| كتب هرمس في النيرنجات والخواص والطلسمات(@)(@@)(@@)(@@) $DIC_BIB$ كتاب هرمس في النشر والتعاويذ والعزائم.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الهاريطوس من نيرنجات 
ms386	 الأشجار والثمار والأدهان والحشائش.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب فريقوينوس؟ في الأسماء والحفظة والتمائم والعوذ من حروف الشمس والقمر والنجوم الخمسة وأسماء الفلاسفة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب فريقوينوس؟ في الخواص. وجزأه ثلاثة اجزاء. كل جزء يحتوي على معنى.(@)PageV00P373(@)(@@) بسم الله الرحمن الرحيم(@)(@@)(@@)(@@) || الفن الثالث من المقالة الثامنة من كتاب الفهرست في اخبار العلماء وأسماء ما صنفوه من الكتب ويحتوي على الكتب المصنفة في معاني شتى لا يعرف مصنفوها ولا مؤلفوها (@)(@@)(@@)(@@) ||| أسماء خرافات تعرف باللقب لا نعرف من أمرها غير هذا(@)(@@)(@@)(@@) $DIC_BIB$ كتاب شكبذة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب كعب ضب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب ضلع الدبر .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب جمح .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب عاشق البقرة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب جرد الريح .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب سعدة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب حدسه؟ .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب حبل مشق.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب زنقطه .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب رقاصة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب سكن.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب خرو الطير.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب ثيلب .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب صغيره .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب طعنة السراح .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب برص.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب ري.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب عرارة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب رخية.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب حوشق .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب قور.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب بلبل.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب حي وحلمة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب جلبذة.(@)(@@)(@@)(@@) ||| أحاديث البطالين لا يعرف من صنفها(@)(@@)(@@)(@@) $DIC_BIB$ كتاب حوشب الأسدي.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب عروة بن عبد الله.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الغاضري.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب أبى السايب المخزومي.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب أبى عمر الأعرج.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب ضمضم المديني.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب قلوص.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب أبى سكة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مسرور الأوسي.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب أبى معن الغفاري.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الدارمي.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب ابن احمر.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب عقريط.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب حطمي الدلال.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب أبى الحر المديني.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب فند.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب هبة الله.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب نومة الضحى.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب ابن الشونيزي.(@)(@@)(@@)(@@) ||| أسماء قوم من المغفلين ألف في نوادرهم الكتب لا يعلم من ألفها.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب نوادر جحا.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب نوادر أبى ضمضم.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب نوادر ابن احمر.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب نوادر سورة الاعرابي.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب(@)PageV00P375 نوادر ابن الموصلي.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب نوادر ابن يعقوب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب نوادر أبى عبيد الحزمي.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب نوادر أبى علقمة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب نوادر سيفويه.(@)(@@)(@@)(@@) ||| أسماء الكتب المؤلفة 
ms387	 في الباه الفارسي والهندي والرومي والعربي على طريق الحديث المشبق(@)(@@)(@@)(@@) $DIC_BIB$ كتاب بنيان دخت.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب بنيان نفس.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب بهرام دخت في الباه.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مرطوس الرومي في حديث الباه.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الأكفية الكبير.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الأكفية الصغير.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب بردان وحباحب، لأبي حسان الكبير.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب بردان وحباحب الصغير.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الحرة والأمة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب السحاقات والبغائين ، لأبي العبس.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الفه ابن حاجب النعمان ويعرف بحديث ابن الدكاني.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب لعوب الرئيسة وحسين اللوطي.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الجواري الحبائب.(@)(@@)(@@)(@@) ||| الكتب المؤلفة في الخبلان والاختلاج والشامات والأكتاف والكتب المؤلفة في الفأل والزجر والخرز وما أشبه ذلك الفرس والهند والروم والعرب(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الفراسة لأرسطاليس .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الفراسة لكليمون.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب فراسة الحمام.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب زجر الفرس.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب زجر الهند.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب زجر الروم.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب زجر العرب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الخيلان، لمتس الرومي.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الشامات، لمتس الرومي.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الفأل لأهل الفرس.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب خطوط الكف والنظر في اليد، للهند.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الاختلاج على ثلاثة أوجه، للفرس.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب زجر الطير والفأل والعيافة والقيافة والكهانة، للمدائني.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الفأل الفلكي، للكندي.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الاختلاج والزجر وما يرى الرجل في ثيابه وجسده وصفة الخيلان وعلاج النساء ومعرفة ما تدل عليه الحيات.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب قرعة ابن المرتحل الكبيرة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب قرعة ابن المرتحل الصغيرة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب فيثاغورس في القرعة التي يقترع بها عند كل حاجة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب قرعة ذي القرنين.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب قرعة ألفتها النصارى.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب قرعة منسوبة إلى دانيال.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب قرعة منسوبة إلى الإسكندر بالسهام.(@)(@@)(@@)(@@) ||| الكتب المؤلفة في الفروسية وحمل السلاح وآلات الحروب والتدبير والعمل بذلك لجميع الأمم(@)(@@)(@@)(@@) $DIC_BIB$ كتاب آئين الرمي، لبهرام جور، وقيل لبهرام جوبين.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب آئين الضرب بالصوالجة، للفرس.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب تعبية الحروب وآداب الأساورة وكيف كانت ملوك الفرس تولى الأربعة الثغور من الشرق والغرب والحربي والتيمن .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الخليل الهرثمي الشعراني الفه للمأمون في الحروب، جود في تأليفه وجعله مقالتين، المقالة الأولى، 
ms388	 ثلاثة اجزاء. الجزء الأول عشرون بابا يحتوي على مائتين وأربعة وستين مسألة: الجزء الثاني، سبعة أبواب يحتوي(@)PageV00P376 على (اثنتين) وأربعين مسألة. الجزء الثالث، أربعة وعشرون بابا يحتوي على مائة وأربعة وأربعين مسألة. المقالة الثانية، ستة وثلاثون فصلا، الف وخمسة وعشرون بابا .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب عبد الجبار بن عدي للمنصور في آداب الحروب وصورة العسكر.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الاشميطي في الفروسية.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب أدب الحروب وفتح الحصون والمدائن وتربيص الكمين وتوجيه الجواسيس والطلائع والسرايا ووضع المسالح، ترجمته مما عمل للأردشير بن بابك.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب باجهر الهندي في فراسات السيوف ونعتها وصفاتها ورسومها وعلاماتها.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب السيوف التي كانت عند العرب وأصناف ذلك.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب شاناق الهندي في أمر تدبير الحرب وما ينبغي للملك ان يتخذ من الرجال وفى أمر الأساورة والطعام والسم.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب العلم بالنار والنفط والزرافات في الحروب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الدبابات والمنجنيقات والحيل والمكايد. رأيته بخط ابن خفيف.(@)(@@)(@@)(@@) ||| الكتب المؤلفة في البيطرة وعلاج الدواب وصفات الخيل واختياراتها(@)(@@)(@@)(@@) $DIC_BIB$ كتاب ابن أخي حرام في البيطرة، الفه للمتوكل.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الفه حكيم من حكماء الروم في علاج سائر الدواب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب البيطرة، لسموس، مقالة موجودة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الخيل وعلى أي نعت وصفة شية أفره ما يكون من الخيل.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب ارتباط الخيل مجهول.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب نقله إسحاق بن علي بن سليمان للفرس في علاج سائر الدواب والخيل والبغال والبقر والغنم والإبل ومعرفة ثمنها وشومها .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب البيطرة للحصيبي، مجهول.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب البيطرة، للروم.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب البيطرة، للفرس.(@)(@@)(@@)(@@) ||| الكتب المؤلفة في الجوارح واللعب بها وعلاجاتها للفرس والروم والترك والعرب(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الجوارح، لمحمد بن عبد الله بن عمر البازيار.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب البزاة، للفرس.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب البزاة للترك.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب البزاة للروم.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب البزاة، للعرب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الجوارح واللعب بها، لأبي دلف القاسم بن عيسى.(@)(@@)(@@)(@@) ||| أسماء الكتب المؤلفة في المواعظ والآداب والحكم للفرس والروم والهند والعرب مما يعرف مؤلفه أو لا يعرف(@)(@@)(@@)(@@) $DIC_BIB$ كتاب زادانفروخ في تأديب ولده.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مهراد رجشنس الفرمدار إلى 
ms389	 بزرجمهر بن المتكان .(@)(@@) أوله: انه لم يتنازع الرأي متنازعان أحدهما مخطئ والآخر مصيب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب بتروس؟ في الأدب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب بروسن في تدبير المنزل.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب إبراهيم بن زياد في الأدب المهدى .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب محمد بن الليث إلى الرشيد يعظه.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب محمد بن الليث إلى يحيى بن خالد.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الرد على الزنادقة، مجهول.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب عهد كسرى إلى ابنه هرمز يوصيه حين أصفاه الملك وجواب هرمز إياه.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب ملك من الملوك الخالية إلى ابنه في التأديب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب عهد كسرى إلى من أدرك التعليم من بنيه .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب ملك صالح من الملوك فيه جماع رؤوس أمور الملوك التي عليها تدور سياستها.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب(@)PageV00P377 عهد أردشير بابكان إلى ابنه سابور.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مؤبدان مؤبد في الحكم والجوامع والآداب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب عهد كسرى أنوشروان إلى ابنه، الذي يسمى عش البلاغة .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مسائل استرعايحش العالم والجواب عنها.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الملك ذي الشيبة وما جرى بينه وبين وزرائه وأهل مملكته من المحاورة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب ما كتب به كسرى إلى المروران وإجابته إياه.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب حديث اليأس والرجاء والمحاورة التي جرت بينهما.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الملك والمرأة التي علقها بين السماء والأرض يستظل تحتها الف فارس.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المسائل التي أنفذها ملك الروم إلى أنوشروان على يد بقراط الرومي.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب ارسال ملك الروم الفلاسفة إلى ملك الفرس يسئله عن أشياء من الحكمة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الفيلسوف الذي بلى بالجارية قيطر وحدئت الفلاسفة في أمرها.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الملك الذي أشار عليه أحد وزرائه بالنوم والآخر باليقظة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب ما أمر أردشير باستخراجه من خزائن الكتب التي وضعها الحكماء في التدبير.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب حديث السمع والبصر.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الملك والضرتين والوزراء.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب