ms161	 چون رسیدند در ره فراز(@)(@@) (@@) نهادند در یکدگر تیغ و تیر %~% ز گرد آسمان شد چو دریای قیر(@)(@@) (@@) 366 برآمد ز کوس و تبیره غریو %~% گریزان شد از نالهآ نای دیو(@)(@@) (@@) ز سم ستوران چنان خاست گرد %~% که با تیره شب روز را راست کرد(@)(@@) (@@) ستوه از سنان گشت روی سپهر %~% به گرد سپه در نهان گشت مهر(@)(@@) (@@) بسا دل که در برش خنجر کفاند %~% بسا تیر کز تن روان را پراند(@)(@@) (@@) ز رومی گره کشته شد بیشمار %~% همان از سپاه گل کامکار(@)(@@) (@@) 2665 سته دختر شاه گشت از زدن %~% به نیزه تن رومیان آزدن(@)(@@) (@@) نه چندان سپه بد ز رومی گروه %~% کز ایشان تهی بود صحرا و کوه(@)(@@) (@@) به تازئ سپه بر از ایشان شکست %~% فتاد وز همشان سپه داد دست(@)(@@) ~~سوی بنگه خویشتن تیزتاز ز پس روی دادند و رفتند باز4 90(@)(@@) ~~چو بر چپ و بر راست یک تن نماندگل کامکار اسپ را تیز راند(@)(@@) (@@) 3 ز رومی سپه کس نرفت از پسش %~% نیارست آهنگ کردن کسش(@)(@@) (@@) بنزد پدر سوی پرده سرای %~% بیامد ندید او پدر را به جای(@)(@@) (@@) همان بد گریزان شده شاه مصر %~% گرفته از آن رزمگه راه مصر PageV01P156(@)(@@) ![image filename](./0550Anonymous.HumayNama_0222.jpg)(@)(@)(@@) (@@) پدر را همی جست هر جایگاه %~% یکی بیشه دید او گرفته سپاه(@)(@@) (@@) که در وی نشایست رفتن سوار %~% درختش به هم در شده هاموار(@)(@@) (@@) 3 فرود آمد و رفت پیش پدر %~% همان هر چه ماندش سپه سر به سر(@)(@@) (@@) شب آمد همه رخت بردند پاک %~% در آن بیشه کش بود پر تار خاک(@)(@@) (@@) سحرگه چو سر بر زد از کوهسار %~% درفشنده مهر آمد از هر کنار(@)(@@) (@@) سپه قیصر روم را بیکران %~% گرفتند آن بیشه را در میان(@)(@@) (@@) نیارست در بیشه رفتن کسی %~% نه بیرون بی اندیشه رفتن کسی(@)(@@) (@@) همی گفت قیصر که آتش زنید %~% درین بیشه وز هر سویی بر دنید(@)(@@) (@@) مگرشان بسوزید در بیشه پاک %~% برآرید از جان و تنشان هلای(@)(@@) (@@) به پاسخ 
ms162	 ورا گفت یک یک سپاه %~% که زی بیشه ما را چنان نیست راه(@)(@@) (@@) کجا سر به سر آتشش در زنیم %~% ز سر تا به پایان به هم برزنیم(@)(@@) (@@) که چوبش همه تر و آبست و گل %~% نباید درین شاه را بست دل(@)(@@) (@@) 3685 همان بیشه بس بیکرانست وکوه %~% بدو هست پیوسته چون شد ستوه(@)(@@) (@@) از ما لشکر دشمنان یکسره %~% روند از سوی کوه و سوی دره 10a(@)(@@) (@@) بدیشان نباشد ز ما دسترس %~% ز بیرون بیشه بیاسیم و بس(@)(@@) (@@) ز هر سو برایشان گرفتیم راه %~% شوند اندرین بیشه یکسر تباه(@)(@@) (@@) که در بیشه گردند بی مر مار %~% برآرند از جان ایشان دمار(@)(@@) (@@) 369 دگر چون نیابند خود خوردنی %~% تباشند در بیشه جز مردنی(@)(@@) (@@) دو مه یا سه مه زنده مانند و بس %~% فسرده شود در دهانشان نفس(@)(@@) (@@) گرفتند پس گرد بیشه سپاه %~% برایشان ببستند هر گوشه راه(@)(@@) (@@) شه شام و یکسر سپاهش ز جان %~% بریدند اومید وز خانمان(@)(@@) (@@) ز تنگی نان خیره و آب خوش %~% ز بار غمان دل شده بارکش(@)(@@) (@@) 35 همان بود در بیشه بسیار مار %~% که کردند هزمان جگرشان فگار(@)(@@) (@@) دو بهره ز لشکر بدان بیشه در %~% تبه گشته بودند و رفته جگر(@)(@@) (@@) سه ماه اندر آن بیشه بودند زار %~% شده بی خور و خواب از بیم مار PageV01P157(@)(@@) ![image filename](./0550Anonymous.HumayNama_0223.jpg)(@)(@)(@@) (@@) فرستاد ده کس به ره تیزپای %~% مگرشان خبر آورند از همای(@)(@@) (@@) 3700 به ره چشم و گوش سراسر سپاه %~% که تا کی رسد شاهزاده ز راه(@)(@@) (@@) مگرشان رهاند روان از گزند %~% بباشند ایمن به جان از گزند(@)(@@) (@@) همی کرد نفرین گل کامکار %~% شب و روز بر گردش روزگار(@)(@@) (@@) ز بهر پدر بود خستهآ جگر %~% ز بهر سپاهش همه سر به سر(@)(@@) (@@) که از بهر او رنجه بودند پاک %~% شب و روز با ترس و با بیم و باک 10b(@)(@@) (@@) 3705 همی خواست خود را بریدن گلو %~% گرفته چو ره دید از چارسو(@)(@@) (@@) به دل گفت اگر زانکه خود 
ms163	 را کشم %~% نه خود را ز خویشان دو سد را کشم(@)(@@) (@@) پدر ماندم با سپه رنجهٔ‌ دل %~% اگر گیردم مرگ در پنجه دل(@)(@@) (@@) برآنم که اندر رسد از همای %~% کنون پیک کامد به ره تیزپای(@)(@@) (@@) شکیب آمد اندر دلش آن زمان %~% همی بود یک چند گه با غمان(@)(@@) (@@) 371 همای دلاور چو آنگاه پیک %~% فرستاد و شد تیز بر راه پیک(@)(@@) (@@) هم اندر زمان شد بر شاه هند %~% به دستوری رفتن راه هند(@)(@@) (@@) بدادش چو دستوری آنگاه شاه %~% بیامد شتابنده با او به راه(@)(@@) (@@) پس از بار گوهر بسی چارپای %~% همی رفت در راه پیش همای(@)(@@) (@@) شه هند با او بشد تا به بلخ %~% همان همرهانش نه با عیش تلخ(@)(@@) (@@) 2715 شه هند از بلخ چون گشت باز %~% بیامد به ره گرد گردنفراز(@)(@@) (@@) به ره در دوان پیک را دید شاد %~% جوابی که آورد وی را بداد(@)(@@) (@@) چو برخواند مر نامه را خود جواب %~% دو چشمش شد از درد ریزنده آب(@)(@@) (@@) ز بهر پدر وز پی جفت خویش %~% دل مهربانش شد از رنج ریش(@)(@@) (@@) دو منزل یکی کرد و خود پیش راند %~% سپه را سراسر ز پس باز ماند(@)(@@) (@@) چو نزدیکی مرز روم او رسید %~% به راه اندرون مر پدر را بدید(@)(@@) (@@) فرود آمد و برد پیشش نماز %~% پدر چون نگه کرد زی سرفراز(@)(@@) (@@) اسپ اندر افتاد بیهوش و هال %~% تو گفتی که بر تن شدش جان وبال11a 4(@)(@@) (@@) سر رفت وز خاک برداشتش %~% در آن خیرگی خوار نگذاشتش(@)(@@) (@@) بر در گرفتش زمانی دراز %~% برآورد سر شاه گردنفراز PageV01P158(@)(@@) ![image filename](./0550Anonymous.HumayNama_0224.jpg)(@)(@)(@@) (@@) 3725 پسر را ببوسید سدبار چهر %~% ورا گفت ای مرمرا ماه و مهر(@)(@@) (@@) بهر توام من به روم آمده %~% بدین کشور و مرز و بوم آمده(@)(@@) (@@) بیمایه قیصر شکسته شده %~% به جان زان بر و بوم رسته شده(@)(@@) (@@) پدر را چنین گفت کای سرفراز %~% مرا زان زمانه نیامد فراز(@)(@@) (@@) که تا باز دیدم رخت دلفروز %~% شبم شد ز دیدار روی 
ms164	 تو روز(@)(@@) (@@) 372 ز هندوستان با سپاهی گران %~% چنان آمدم من که باد بزان(@)(@@) (@@) که تا بر تو ناید ز دشمن شکست %~% نگردد ترا اختر جنگ پست(@)(@@) (@@) سپاهست و پیل از پسم بیشمار %~% همان بیکران اشتران زر بار(@)(@@) (@@) دو سد گنج افزونتر آوردهام %~% کشن راه از زیر پی کردهام(@)(@@) (@@) اشه هند را من ز روی بهی %~% نشاندم چو باید به شاهانشهی(@)(@@) (@@) 373 بسی جنگها کردم از بهر وی %~% سر دشمنش را سپردم به پی(@)(@@) (@@) به من داده چندان طرایف که شاه %~% شنیده نباشد ز کس هیچگاه(@)(@@) (@@) نه در مصر باشد نه در مرز شام %~% طرایف که شه دادم از بهر نام(@)(@@) (@@) بیامد شه هند با من به راه %~% همی راند در راه با من دو ماه(@)(@@) (@@) ز مرز خوراسان ز من بازگشت %~% پی پیل ژندش زمین درنوشت(@)(@@) (@@) 3740 همی خواست با من به روم آمدن %~% به کین سوی این مرز و بوم آمدن* 10(@)(@@) (@@) به سد لابه کردم ورا باز راه %~% که بر هندوان بود نو گشته شاه(@)(@@) (@@) قوی گشته شاهی هنوزش نبود %~% ز هر گوشهای دشمنش کین فزود(@)(@@) (@@) به من بر خزینه هزینه شدش %~% هزینه فزون کز خزینه شدش(@)(@@) (@@) مرا داده پیلست سد بیشتر %~% دونده هزار اسپ با زین زر(@)(@@) (@@) 3745 هزار اشتر بارکش همچنین %~% پلالک دو سد تیغ در خورد کین(@)(@@) (@@) همیدون گرانمایه سد پاره ترگ %~% به زر کرده سیسد سپرهای1 کرگ(@)(@@) (@@) زره بیشمارست و خنجر بسی %~% کمرها که چونان ندارد کسی(@)(@@) (@@) هزارست زرین و سیمین طبق %~% همیدون ز عودست رنگین طبق PageV01P159(@)(@@) ![image filename](./0550Anonymous.HumayNama_0225.jpg)(@)(@)(@@) (@@) پر از مشک و کافور حقه هزار %~% فزونست زرین همه هاموار(@)(@@) (@@) 3250 که یک حقه زان بار یک اشترست %~% سد استر همه بار عود ترست(@)(@@) (@@) سراپرده و خیمه سیسد فزون %~% به زر آزده دیبه گونه گون(@)(@@) (@@) همان خرگه از خز سرخش نمد %~% که چوبش ز عودست بیشست سد(@)(@@) (@@) غلام و کنیزست نیکو هزار %~% به زر جامهها بافته ده هزار(@)(@@) (@@) ز بهر می و میهمانست 
ms165	 باز %~% دو سد خوان سیمین ز زر کرده ساز(@)(@@) (@@) 275 صراحی و کاسهست از زر و سیم %~% طبقها مکلل به در یتیم(@)(@@) (@@) سمندر ازاریست از بهر خوان %~% که چونان ندیدست کس در جهان(@)(@@) (@@) طریفل کجا خیزد از هند هست %~% دو سد اشتر گامزن بار بست(@)(@@) (@@) سپاهست بگزیده پنجه هزار %~% بزرگانهندوستان هاموار3 12(@)(@@) (@@) من از پیش راندم چو باد بزان %~% لب از انده تو به دندان گزان(@)(@@) (@@) 376 که هستی ز قیصر شکسته شده %~% به جان زان بر و بوم رسته شده(@)(@@) (@@) سراپرده فرمای اینجا زدن %~% کجا هست جای فرود آمدن(@)(@@) (@@) دو روز و دو شب باید این جایگاه %~% فرود آمدن تا بیاید سپاه(@)(@@) (@@) پس آنگه ز پس باز رفتن به جنگ %~% نکردن بدین جای افزون درنگ(@)(@@) (@@) که در بیشهای شاه شامست اسیر %~% کسش نیست اندر جهان دستگیر(@)(@@) (@@) 276 همان دخترش هست با او که من %~% نخواهم بی او زنده بر پای تن(@)(@@) (@@) پدر گفت فرمان من آن تست %~% نه فرمان کجا جان من آن تست(@)(@@) (@@) مرا نیست فرزند جز تو دگر %~% تویی مرمرا نور دو چشم سر(@)(@@) (@@) سپه را بفرمود کامد فرود %~% یکی پیک مانندهٔ‌ باد و دود(@)(@@) (@@) فرستاد از سوی بیشه دوان %~% خبر برد ازو نزد دخت جوان(@)(@@) (@@) 3 شنید این چو از وی گل کامکار %~% رخش گشت همچون گل اندر بهار(@)(@@) (@@) به جان آفرین بر ستایش فزود %~% همان هر زمانی نیایش فزود(@)(@@) (@@) همای آنچه بر سر گذشتش ز پیش %~% %~% پدر را همه گفت از کم و بیش(@)(@@) (@@) ز قیس دلاور برش یاد کرد %~% دل شه بدان نامور شاد کرد(@)(@@) (@@) ز پس بود قیس یل نامجوی %~% به راه اندرون با سپه تیز پوی PageV01P160(@)(@@) ![image filename](./0550Anonymous.HumayNama_0226.jpg)(@)(@)(@@) (@@) 372 سیوم روز با لشکر اندر رسید %~% بر شاه شد شه چو او را بدید(@)(@@) (@@) نوازیدش و کرد جاهش فزون %~% بپرسید سد ره ز راهش فزون3 120(@)(@@) (@@) ستایش برش قیس بسیار کرد %~% ورا بر سپه شه سپهدار کرد(@)(@@) (@@) شه مصر چون دید چندین هزار 
ms166	 %~% ستور و شتر گوهر و زر بار(@)(@@) (@@) سراپرده وخیمهآ بیکران %~% صف پیل رزم و سپاه گران(@)(@@) (@@) 37 کشان پیل زرادخانه به رنج %~% همان تاج و تخت و گرانبار گنج(@)(@@) (@@) دو چشم سرش هر دو خیره بماند %~% بسی آفرین بر شه هند خواند(@)(@@) (@@) همای دلاور همه هرچه بود %~% پدر را ببخشید برجای زود(@)(@@) (@@) نپذرفت ازو هیچ جز یک ستور %~% رونده بدانسان که بر چرخ هور(@)(@@) (@@) دو اقلیم رفتی به یک روز در %~% به تازش چنان بد که مرغ بپر(@)(@@) (@@) 378 شه مصر دیگر نبد دیده پیل %~% یکایک بدید او چو یک کوه تیل(@)(@@) (@@) از ایشان به دل در شکوه آمدش %~% دل از سهم ایشان ستوه آمدش(@)(@@) (@@) سه روز و سه شب چون برآسود شاه %~% ز پس رفت و چون باد برداشت راه(@)(@@) (@@) همای همایون سپه برگزید %~% دو ره ده هزار و سر اندر کشید(@)(@@) (@@) بشد پیش و جایی نیاسود هیچ %~% شب و روز در راه نغنود هیچ(@)(@@) (@@) 379 به یک هفته نزدیک آن بیشه شد %~% بنزدیک بیشه بی اندیشه شد(@)(@@) (@@) همان روز بر زد به رومی سپاه %~% سوی بیشه بگشود یک کوژ راه(@)(@@) (@@) دو سد مرد را بیشتر کشت و خست %~% فزون از دو سد را گرفت و ببست(@)(@@) (@@) شه شام را کس فرستاد و گفت %~% برون باید آمد کنون از نهقت(@)(@@) (@@) که من این زمان راه بگشودهام %~% چو باد بزان راه پیمودهام12a 4(@)(@@) (@@) 3797 به سه روز فرسنگ سد راندهام %~% ز بس لشکر بیکران ماندهام(@)(@@) (@@) پدر را به راه اندرون دیدهام %~% ورا چهره و چشم بوسیدهام(@)(@@) (@@) مرا دید در ره ز پس بازگشت %~% تو گفتی که با باد هنباز گشت(@)(@@) (@@) شنید این خبر چون شه شام زود %~% برون آمد از بیشه با گام زود(@)(@@) (@@) خود و دختر و آنچه ماندش سپاه %~% رخ از درد و انده شده همچو کاه(@)(@@) (@@) 2900 نخستین برش شد گل کامکار %~% گرفتش ز مهر دل اندر کنار PageV01P161(@)(@@) ![image filename](./0550Anonymous.HumayNama_0227.jpg)(@)(@)(@@) (@@) چنان هر دوان را برآمد خروش %~% زگریه 
