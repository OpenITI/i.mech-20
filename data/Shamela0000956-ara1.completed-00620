ms601	 الكندي - عن ابن عبد الرحمن ابن أبزي.(@)(@@)(@@)(@@) $ 1438 - زائدة بن نشيط، عن أبي خالد الوالبي (2) .(@)(@@)(@@)(@@) $ 1439 - زائدة بن عمران الجعفي، عن سويد بن غفلة، روى عنه إبراهيم الفزاري.(@)(@@)(@@)(@@) $ 1440 - زائدة بن موسى الهمداني، عن يسار بن أبي كرب (3) عن شريح، سمع منه ابن المبارك ووكيع وأبو نعيم.(@)(@@)(@@)(@@) $ 1441 - زائدة بن قدامة أبو الصلت الكوفي، سمع عمر بن قيس وأبا إسحاق ومنصورا، روى عنه أبو أسامة، قال ابن أبي الأسود حدثني موسى بن داود قال حدثني عثمان بن زائدة الرازي: قلت لسفيان: أريد أن آتي الكوفة ممن أسمع؟ قال: عليك بزائدة وابن عيينة! قال قلت: أبو بكر بن عياش؟ قال: إن أردت التفسير فعنده.(@)(@@)(@@)(@@) $ 1442 - زائدة مولى عثمان سمع سعدا عن النبي صلى الله عليه PageV03P432(@)(@@) وسلم - قاله أبو عفان المدني الأموي عن ابن أبي الزناد عن أبيه عن زائدة، حديث منكر، قال أبو عبد الله: وأبو عفان (1) منكر الحديث.(@)(@@)(@@)(@@) $ 1443 - زائدة بن سليم، قال عمر بن محمد بن حسن قال حدثنا أبي قال نا زائدة بن سليم عن عمران بن عمير عن أبيه: عاد عثمان عبد الله بن مسعود في مرضه الذي مات فيه.(@)(@@)(@@)(@@) $ 1444 - زائدة بياع الثياب سمع الحسن - قاله آدم حدثنا شعبة.(@)(@@)(@@)(@@) $ 1445 - زائدة بن أبي الرقاد، عن زياد النميري وثابت، منكر الحديث، سمع منه محمد بن أبي بكر، كنيته أبو معاذ الباهلي.(@)(@@)(@@)(@@) || باب زبرقان(@)(@@)(@@)(@@) $ 1446 - زبرقان بن عمرو بن أمية الضمري، روى عنه ابن أبي ذئب، قال جعفر بن ربيعة عن الزبرقان بن عبد الله بن عمرو بن أمية عن أبي سلمة بن عبد الرحمن عن جعفر بن عمرو بن أمية عن أبيه: رأيت النبي صلى الله عليه وسلم يمسح على الخفين - قاله عبد الله بن يوسف وابن بكير حدثني بكر عن جعفر، وقال زكريا بن عدى * (الهمش) * (1) هو عثمان بن خالد من ولد عثمان بن عفان له ترجمة في التهذيب (7 / 114) كنيته أبو عفان باتفاق ضبطه عبد الغنى في المشتبه ص 86 وغيره ووقع بهامش الاصل " خ 
ms602	 - أبو غفار قال الشيخ وهو الصواب " كذا - ح.(@)(@@) [*](@)(@@) PageV03P433(@)(@@) حدثنا حاتم عن يعقوب بن عمرو بن عبد الله بن امية حدثنا الزبرقان ابن عمرو عن أبيه عن عمرو بن أمية سمع النبي صلى الله عليه وسلم قال: كل ما صنعت إلى أهلك صدقة، وقال إسحاق أخبرنا عبد الصمد نا شعبة عن عمرو بن أبي حكيم سمع الزبرقان سمع عروة بن الزبير عن زيد بن ثابت: كان النبي صلى الله عليه وسلم يصلي الظهر بالهاجرة فنزلت " والصلوة الوسطى " وعن أبي داود عن ابن أبي ذئب عن زبرقان (@)(@@) عن زهرة: كنا عند زيد بن ثابت فقال: الظهر؟ فأرسلوا إلى أسامة بن زيد فقال: هي الظهر كان النبي صلى الله عليه(@)(@@) وسلم يصليها بالهجير، وقال هشام حدثنا صدقة عن ابن أبي ذئب عن الزبرقان بن عمرو بن أمية الضمري عن زيد بن ثابت وأسامة - نحوه، وقال آدم حدثنا ابن أبي ذئب قال حدثنا زبرقان الضمري - نحوه، ورواه يحيى بن أبي بكير عن ابن أبي ذئب - نحوه.(@)(@@)(@@)(@@) $ 1447 - زبرقان بن عبد الله (1) ، سمع ابن عمر، روى عنه ابن أبي الموالي.(@)(@@)(@@)(@@) $ 1448 - زبرقان بن عبد الله بن مازن (2) ، عن ابى هريرة PageV03P434(@)(@@) قوله، روى عنه محمد بن ربيع بن كعب.(@)(@@)(@@)(@@) $ 1449 - زبرقان، </span>عن عمرو بن أمية (1) ، روى عنه كليب ابن صبيح.(@)(@@)(@@)(@@) $ 1450 - زبرقان بن عبد الله العبدي، عن كعب بن عبد الله، روى عنه الثوري وإسرائيل، كناه شعبة: أبو الورقاء (2) الكوفي عن عبد الله بن كعب، وهم فيه (3) . PageV03P435(@)(@@)(@@)(@@) $ 1451 - زبرقان بن عبد الله الأسدي السراج الكوفي أبو بكر، سمع أبا وائل، روى عنه يحيى القطان وأبو أسامة.(@)(@@)(@@)(@@) $ 1452 - زبرقان (1) ، قال قيس حدثنا مسلمة بن علقمة سمع داود بن أبي هند عن شهر عن زبرقان عن النواس عن النبي صلى الله عليه وسلم: الحرب خدعة - بطوله، وقال عمرو بن خالد حدثنا زهير سمع ابن خثيم سمع شهرا قال حدثتني أسماء بنت يزيد الأشهلية (2) عن النبي صلى الله عليه وسلم - مثله.(@)(@@)(@@)(@@) $ 1453 - زبرقان بن يسير (3) بن عمرو عن زيد 
ms603	 بن وهب سمع اباذر قوله، سمع منه عوام بن حوشب، أحسبه اخا قيس الشيباني. PageV03P436(@)(@@)(@@)(@@) $ 1454 - زبرقان، قال حبان حدثنا شريك بن الخطاب قال حدثني الزبرقان بن الحارث النميري (1) : قلت للأحنف بن قيس في مسجد الكوفة يا أبا بحر.(@)(@@)(@@)(@@) || باب زاذان(@)(@@)(@@)(@@) $ 1455 - زاذان أبو عبد الله مولى كندة، سمع ابن مسعود وعليا وابن عمر، روى عنه ذكوان أبو صالح وعبد الله بن السائب وعمرو بن مرة، قال أبو نعيم حدثنا أبو سلمة الصائغ سمع أبا رجاء الأحمسي عن زاذان أبي عمر: سئل علي عن درهمين بدرهم طيب؟ فقال رده، وقال عمر بن حفص عن أبيه عن الأعمش حدثني حبيب عن زاذان عن علي: الصاع بالصاعين الربا العجلان، وقال الثوري وشعبة عن حبيب عن رجل عن علي.(@)(@@)(@@)(@@) $ 1456 - زاذان بن فروخ.(@)(@@)(@@)(@@) $ 1457 - زاذان والد منصور، رأى رأس الحسين، روى عنه هشيم، مولى عبد الله بن أبي عقيل الثقفي، قال عارم حدثنا هشيم عن منصور بن أبي المغيرة - يعنى ابن زاذان. PageV03P437(@)(@@)(@@)(@@) $ 1458 - زاذان أبو يحيى القتات، ويقال عبد الرحمن، عن مجاهد، روى عنه الأعمش والثوري وسمع منه فطر وإسرائيل، ويقال مسلم ولم يصح مسلم، ويقال صاحب القت.(@)(@@)(@@)(@@) || باب زرارة(@)(@@)(@@)(@@) $ 1459 - زرارة بن كريم، قال أبو معمر حدثنا عبد الوارث قال حدثنا عتبة بن عبد الملك السهمي قال حدثني زرارة بن كريم ابن الحارث بن عمرو السهمي أن الحارث بن عمرو حدثه: أتيت النبي صلى الله عليه وسلم بمنى أو بعرفات ووقت ذات عرق لأهل العراق - أو قال لأهل المشرق.(@)(@@)(@@)(@@) $ 1460 - زرارة بن جزي، عن المغيرة بن شعبة، روى عنه مكحول، وقال سعدان بن يحيى: زرارة، سمع النبي صلى الله عليه وسلم (1) .(@)(@@)(@@)(@@) $ 1461 - زرارة بن أوفى العامري الحرشي قاضي البصرة، سمع أبا هريرة وسعد بن هشام، نسبه العكلي، مات قبل ابن سيرين، قال PageV03P438(@)(@@) سليمان بن حرب عن حمادبن زيد عن أيوب - وقال سليمان عن حماد عن عوف قال حدثنا زرارة قال نا عبد الله بن سلام، وقال عبد الله بن أبي شيبة حدثنا أبو 
ms604	 أسامة عن عوف عن زرارة حدثني عبد الله بن سلام عن النبي صلى الله عليه وسلم، وقال إسحاق سألت عليا فقال أخبرنا عبد الأعلى قال أخبرني داود بن أبي هند عن زرارة بن أوفى حدثني تميم الداري، قال علي بن نصر يقولون: أبو حاجب.(@)(@@)(@@)(@@) $ 1462 - زرارة بن مصعب بن عبد الرحمن بن عوف القرشي الزهري، عن المسور بن مخرمة، روى عنه الزهري.(@)(@@)(@@)(@@) $ 1463 - زرارة بن مصعب بن شيبة، روى ابن عيينة عن عبد الله بن زرارة القرشي عن أبيه، قال أبو عبد الله: أراه مرسلا.(@)(@@)(@@)(@@) $ 1464 - زرارة بن ربيعة (1) وهو زرارة بن أبي الحلال.(@)(@@) العتكي البصري أبو ربيعة، عن أبيه روى عنه هشيم سمع جابر بن زيد.(@)(@@)(@@)(@@) $ 1465 - زرارة بن عبد الله بن أبي أسيد سأل سعيد بن المسيب - قاله أبو نعيم عن الحكم بن أبي نعم - قوله.(@)(@@)(@@)(@@) || باب زرعة(@)(@@)(@@)(@@) $ 1466 - زرعة بن ثوب سمع عبد الله بن عمر - قاله ابن PageV03P439(@)(@@) وهب عن معاوية عن عامر بن جشيب سمع زرعة، وقال عمرو بن أبي سلمة عن سعيد زرعة بن ثوب القاضي هو والد ضمضم بن زرعة.(@)(@@)(@@)(@@) $ 467 - زرعة بن عمرو، قال شعيب بن حرب حدثنا خالد ابن يزيد القرشي سمع زرعة بن عمرو - وكان عمرو أحد الاربعة الذين حملو عثمان (1) أصيب - عن النبي صلى الله عليه وسلم، مرسل.(@)(@@)(@@)(@@) $ 1468 - زرعة بن عبد الرحمن بن جرهد الأسلمي المدني، عن جرهد، روى عنه أبو الزناد وسالم أبو النضر، وقال ابن عيينة: زرعة بن مسلم بن جرهد، ولم يصح.(@)(@@)(@@)(@@) $ 1469 - زرعة بن حصين بن سياه، قال علي حدثنا زيد بن حباب قال أخبرنا عمرو بن قيظي بن عمرو بن شداد قال أخبرني محمد وزرعة وسليمان بنو حصين بن سياه عن جدتهم أم سنبلة أنها أتت النبي صلى الله عليه وسلم بهدية فجاء النبي صلى الله عليه وسلم فقال: خذوها فإن أم سنبلة أهل باديتنا ونحن اهل حاضرتها، وامر لها بشئ سماه فاشتراه عبد الله بن حسن بن حسن بن علي.(@)(@@)(@@)(@@) $ 1470 - زرعة أبو 
ms605	 عبد الرحمن عن ابن عباس: في المذي.(@)(@@) والودي الوضوء - قاله محمد بن يوسف عن مالك بن مغول. PageV03P440(@)(@@)(@@)(@@) $ 1471 - زرعة بن عبد الله البياضي الأنصاري عن مولى لمعمر التيمي عن أسماء بنت عميس: قال النبي صلى الله عليه وسلم: لو كان شئ فيه شفاء من الموت لكان السنا - قاله محمود عن أبي أسامة سمع عبد الحميد بن جعفر سمع زرعة، روى عنه يزيد بن زياد (1) ، ويقال ابن عبد الرحمن، وقال أبو بكر الحنفي حدثنا عبد الحميد بن جعفر حدثنا عتبة بن عبد الله التيمي عن النبي صلى الله عليه وسلم.(@)(@@)(@@)(@@) $ 1472 - زرعة بن إبراهيم (2) الدمشقي، عن عطاء وخالد بن اللجلاج وجناح، روى عنه سعيد بن أبي هلال ومحمد بن شعيب وسمع منه ابن علاق. PageV03P441(@)(@@)(@@)(@@) $ 1473 - زرعة بن ضمرة سمع ابن عباس قوله - قاله إسماعيل عن الجريري عن حيان بن عمير عن زرعة.(@)(@@)(@@)(@@) || باب زاهر(@)(@@)(@@)(@@) $ 1447 - زاهر بن حرام الأشجعي، قال هلال بن فياض حدثنا رافع بن سلمة البصري سمع أباه عن سالم عن زاهر بن حرام الأشجعي وكان بدويا يأتي النبي صلى الله عليه وسلم بطرفة أو هدية وقال النبي(@)(@@) صلى الله عليه وسلم: إن لكل حاضر بادية وإن بادية آل محمد زاهر بن حرام، وقال عبد الله بن محمد عن هشام بن يوسف أخبرنا معمر عن ثابت عن أنس: كان زاهر بن حزام (1) يهدي للنبي صلى الله عليه وسلم - نحوه، روى شعيب بن صفوان عن ثابت عن سالم بن أبي الجعد عن النبي صلى الله عليه وسلم.(@)(@@)(@@)(@@) $ 1475 - زاهر بن الأسود الأسلمي، بايع تحت الشجرة، يعد في الكوفيين، قال مالك بن إسماعيل حدثنا شريك عن مجزأة ابن زاهر عن أبيه: قال النبي صلى الله عليه وسلم يوم عاشوراء: من أصبح صائما فليصم. PageV03P442(@)(@@)(@@)(@@) || باب زهرة(@)(@@)(@@)(@@) $ 1476 - زهرة بن معبد أبو عقيل القرشى، سمع جده عبد الله ابن هشام وأباه وابن المسيب، روى عنه حيوة، قال قتيبة عن الليث عن زهرة بن معبد: قال لي عمر بن عبد العزيز: أين تسكن من 
ms606	 مصر؟ قلت: الفسطاط، وسمع منه سعيد بن أبي أيوب وأبو معن.(@)(@@)(@@)(@@) $ 1477 - زهرة بن عمرو التيمي، حجازي عن الوليد بن عمرو وأبي حازم بن دينار، روى عنه عبد العزيز بن عبد الله، وقال معن حدثنا شعيب بن طلحة عن زهرة بن عمرو أن أبا بكر - مرسل.(@)(@@)(@@)(@@) || باب زامل(@)(@@)(@@)(@@) $ 1478 - زامل الطائي، قال قتيبة حدثنا وكيع من عصمة(@)(@@) ابن زامل عن أبيه رأى أبا هريرة يتوضأ من مطهرة المسجد، وقال مخلد حدثنا ابن مغراء حدثنا عصمة بن زامل بن أوس الطائي.(@)(@@)(@@)(@@) $ 1479 - زامل بن عمرو السكسكي، يعد في الشاميين، عن عريب الحبراني، روى عنه سعيد بن أبي هلال والزبيدي.(@)(@@)(@@)(@@) || باب زبان(@)(@@)(@@)(@@) $ 1480 - زبان بن فائد </span>عن سهل بن معاذ بن أنس الجهني عن أبيه عن النبي صلى الله عليه وسلم: من حرس من رواء المسلمين(@)(@@) PageV03P443(@)(@@) متطوعا لا بأجرة (1) سلطان لم ير النار بعينه (2) قال الله عزوجل " وإن منكم الا واردها " قاله أبو أيوب حدثنا ابن وهب قال نا يحيى بن أيوب، وقال أصبغ أخبرني ابن وهب أخبرني الليث وغيره عن عبيد الله بن حيان عن سهل عن أبيه صاحب النبي صلى الله عليه وسلم - في القدر، يقال عن زبان بن فائد الحمراوي (3) .(@)(@@)(@@)(@@) $ 1481 - زبان بن عبد العزيز، سمع عمر بن عبد العزيز قوله، روى عنه الليث، يقال أخو عمر، القرشي الأموي ابن عبد العزيز بن مروان بن الحكم، وسمع منه أسامة بن زيد.(@)(@@)(@@)(@@) $ 1482 - زبان بن نزار عن خالد بن يزيد الجمحي، مرسل - قاله إسحاق عن بقية عن خالد بن حميد سمع زبان.(@)(@@)(@@)(@@) $ 1483 - زبان (4) قال أحمد أبو جعفر (5) حدثنا روح قال PageV03P444(@)(@@) حدثنا أشعث عن محمد عن زبان بن يحيى بن الجزار عن أبيه عن ابن مسعود: لو أصبحت جنبا ما أفطرت، وعن هشام عن محمد عن زبان عن يحيى بن الجزار عن ابن مسعود - نحوه.(@)(@@)(@@)(@@) || باب زحر(@)(@@)(@@)(@@) $ 1484 - زحر بن قيس: خرجت حين أصيب على رضى الله عنه إلى المدائن، فكان أهله بها - قاله محمد بن أبي بكر عن أبي 
ms607	 محصن عن حصين عن الشعبي.(@)(@@)(@@)(@@) $ 1485 - زحر بن الحسن، سمع عبد العزيز بن حكيم، سمع منه ابن المبارك ووكيع، هو الحضرمي الكوفي.(@)(@@)(@@)(@@) $ 1486 - زحر بن حصن، سمع جده حميد بن منهب، روى عنه زكريا بن يحيى بن عمر بن حصن الطائي.(@)(@@)(@@)(@@) || باب زربي(@)(@@)(@@)(@@) $ 1487 - زربي، قال إسحاق عن أبي أسامة سمع إسماعيل بن زربي سمع أباه سمع البراء: نزل تحريم الخمر وفي أسقيتنا زبيب وتمر.(@)(@@)(@@)(@@) $ 1488 - زربي بن عبد الله أبو يحيى مؤذن هشام الفردوسي البصري، سمع منه عبد الصمد وعمرو بن منصور، وسمع أنسا، فيه نظر.(@)(@@) PageV03P445(@)(@@)(@@)(@@) || باب زيادة(@)(@@)(@@)(@@) $ 1489 - زيادة بن عبد الله بن زيد بن مربع الأنصاري، من بني حارثة مدني أخو علاقة، عن سهل بن سعد، روى عنه كثير ابن جعفر.(@)(@@)(@@)(@@) $ 1490 - زيادة بن محمد، عن محمد بن كعب الفرظى عن فضالة بن عبيد عن أبي الدرداء، روى عنه الليث، منكر الحديث.(@)(@@)(@@)(@@) || باب زاجر(@)(@@)(@@)(@@) $ 1491 - زاجر بن الهيثم عن عبد الله (1) قال الماعون الماء، سمع منه يحيى بن عبيد الله بن قزعة البصري.(@)(@@)(@@)(@@) $ 1492 - زاجر بن الصلت الطاحى البصري من اليمن، عنده مراسيل (2) . PageV03P446(@)(@@)(@@)(@@) || باب الواحد(@)(@@)(@@)(@@) $ 1493 - زارع بن عامر العبدي من عبد القيس، حدثنا موسى قال حدثنا مطر بن عبد الرحمن الأعنق قال حدثتني امرأة من صباح عبد القيس أم أبان بنت الزارع (1) عن جدها أن جدها زارع بن عامر خرج إلى النبي صلى الله عليه وسلم فما عدا منا أن قدمنا المدينة فقيل هذا رسول الله صلى الله عليه وسلم فأخذ بيديه ورجليه يقبلها.(@)(@@)(@@)(@@) $ 1494 - زبيب (2) بن ثعلبة العنبري التميمي، قال موسى عن شعيث بن عبد الله (3) بن زبيب وكان ينزل بالطنب في طريق مكة عن أبيه عن جده سمع النبي صلى الله عليه وسلم: من كان عليه رقبة من بني إسماعيل فليعتق من بلعنبر.(@)(@@)(@@)(@@) $ 1495 - زر بن حبيش أبو مريم الأسدي الكوفي، سمع عمر بن الخطاب، روى عنه إبراهيم وعاصم بن بهدلة.(@)(@@)(@@)(@@) $ 1496 - زبيد بن الصلت الكندي أخو كثير، سمع عمر، PageV03P447(@)(@@) روى عنه عروة بن 
ms608	 الزبير.(@)(@@)(@@)(@@) $ 1497 - زهدم بن مضرب الجرمي البصري، سمع ابن عباس وعمران بن حصين، روى عنه أبو جمرة وقتادة.(@)(@@)(@@)(@@) $ 1498 - زهدم بن الحارث الغفاري (1) ، رأى ابن عمر - PageV03P448(@)(@@) قاله لي محمد بن عقبة قال نا محمد بن عثمان القرشي قال نا زهدم البصري سمع وهبان (1) بن صيفي، سمع منه ابنه يحيى (2) . PageV03P449(@)(@@)(@@)(@@) $ 1499 - زبيد بن الحارث أبو عبد الرحمن الأيامي الكوفي، كناه علي بن قادم، قال أبو نعيم: مات سنة ثنتين وعشرين ومائة، سمع إبراهيم، روى عنه منصور والثوري، وقال نصر بن علي عن أبيه عن شعبة عن زبيد عن مرة عن عبد الله " حق تقاته " فذكرته لعمرو بن مرة فقال: كان زبيد صدوقا سمعت مرة يحدثه عن ربيع بن خثيم (1) ، وقال أحمد بن سليمان قال سفيان: كان عند طلحة نحو من خمسمائة حديث وعند زبيد مائة.(@)(@@)(@@)(@@) $ 1500 - زميل بن عباس مولى عروة بن الزبير القرشي، عن عروة، روى عنه يزيد بن الهاد، قال أبو عبد الله: ليس في العتيق مقيد، ولا يعرف لزميل سماع من عروة ولا ليزيد من زميل ولا تقوم به الحجة.(@)(@@)(@@)(@@) $ 1510 - زرزر بن صهيب من أهل شرجة مولى لآل جبير PageV03P450(@)(@@) ابن مطعم، سمع عطاء، روى عنه ابن عيينة قوله، حجازي.(@)(@@)(@@)(@@) $ 1502 - زنجي بن خالد بن الحويرث القرشي (1) ، سمع أباه، سمع منه عبد الواحد الحداد.(@)(@@)(@@)(@@) $ 1503 - زرد البصري العمي، سمع عمران بن قدامة، روى عنه موسى.(@)(@@)(@@)(@@) $ 1504 - زريك بن أبي زريك البصري، سمع الحسن وعطاء وابن سيرين ومعاوية بن قرة عن أبي السليل، يقال أبو نضرة العطاردي ويقال أبو النضر.(@)(@@)(@@)(@@) $ 1505 - زمعة بن صالح المكي، يروي عن سلمة بن وهرام وابن طاوس، روى عنه وكيع وابن وهب، يخالف في حديثه، تركه ابن مهدي أخيرا.(@)(@@)(@@)(@@) $ 1506 - زافر بن سليمان أبو سليمان القوهستاني الأيادي ويقال كوفي نزل بغداد وكان يكون بالري، عنده مراسيل.(@)(@@)(@@)(@@) $ 1507 - زنفل بن شداد أبو عبد الله العرفي (2) ، كناه محمد PageV03P451(@)(@@) ابن أبي الوزير، روى عنه النضر بن طاهر ومحمد بن أبي الوزير وبندار، سمع قزعة بن سويد.(@)(@@)(@@)(@@) $ 1508 
ms609	 - زجلة (1) : حججت مع عبد الله بن أبي زكريا(@)(@@) فأهدى لعمر بن عبد العزيز مري النينان وهو أمير المدينة - قاله يحيى ابن حسان ونا صدقة بن خالد قال نا زجلة.(@)(@@)(@@)(@@) | باب السين(@)(@@)(@@)(@@) || منهم (سعيد)(@)(@@)(@@)(@@) $ 1509 - سعيد بن زيد بن عمرو بن نفيل أبو الأعور القرشى ثم العدوى، قدم من الشام بعد ما انصرف النبي صلى الله عليه وسلم من بدر فضرب له رسول الله صلى الله عليه وسلم بسهمه - قاله أبو نعيم، حدثنا PageV03P452(@)(@@) عبد السلام عن يزيد بن أبي زياد عن يزيد بن يحنس عن سعيد بن زيدان النبي صلى الله عليه وسلم خرج وهو مختضن الحسن أو الحسين قال: اللهم إني أحبه فأحبه، - وقال المكي حدثنا الجعيد عن عائشة بنت سعد: أذن (1) سعد بسعيد وهلك بالعقيق ومات سعيد سنة ثمان وخمسين.(@)(@@)(@@)(@@) $ 1510 - سعيد بن عامر بن حذيم الجمحي، أدرك النبي صلى الله عليه وسلم، قال عبد الله بن محمد عن عبد الرزاق عن معمر عن الزهري: مات في زمان عمر، نسبه يزيد بن أبي زياد عن عبد الرحمن بن سابط، هو عامل عمر، حديثه مرسل (2) .(@)(@@)(@@)(@@) $ 1511 - سعيد بن يربوع المخزومي، وكان اسمه صرم (3) فسماه النبي صلى الله عليه وسلم سعيدا - قاله ابن المنذر عن زيد بن حباب قال حدثني ابن عبد الرحمن بن سعيد المخزومي، وقال علي حدثنا زيد أخبرنا عمر بن عثمان بن عبد الرحمن بن سعيد الصرم المخزومي قال أخبرني جدي عن أبيه أن النبي صلى الله عليه وسلم قال له: ان انا اكبر أو أنت؟ قال: انت PageV03P453(@)(@@) أقدم وخير وأنا قدم سنا وقال عبد الله حدثنا الليث قال حدثني يحيى أن سعيد بن يربوع اصيب في بصره فأتا ه عمر بن الخطاب يعزيه، قال يحيى: حسبت أبا بكر بن المنكدر حدثني بذلك ويقال أصرم.(@)(@@)(@@)(@@) $ 1512 - سعيد بن حريث أخو عمرو بن حريث المخزومى القرشى، يعد في لكوفيين، له صحبة، لم يثبت حديثه، رواه إسماعيل ابن إبراهيم بن مهاجر عن عبد الملك عن عمرو بن حريث عن أخيه. 
ms610	(@)(@@)(@@)(@@) $ 1513 - سعيد (1) والد كندير بن سعيد، قال عمرو بن عون قال حدثنا خالد عن داود عن العباس بن عبد الرحمن الهاشمي عن كندير بن سعيد عن أبيه: حججت في الجاهلية فبينا أنا أطوف بالبيت إذا راكب يقول: رب - رد إلي راكبي محمدا (2) * يا رب زده واصطنع عندي يدا (3) قيل: من هو؟ قيل: عبد المطلب بن هاشم، بعث ابن ابنه محمدا بإبله فلم يجئه فبينا هو كذلك إذا جاءه فقال: يا بني! لقد حزنت عليك حزنا لا تفارقني بعده أبدا، ويقال هو سعيد بن حيدة (4) . PageV03P454(@)(@@)(@@)(@@) $ 1514 - سعيد بن سعد بن عبادة الأنصاري الخزرجي المدني عن النبي صلى الله عليه وسلم وأبيه، هو أخو قيس.(@)(@@)(@@)(@@) ||| باب الألف(@)(@@)(@@)(@@) $ 1515 - سعيد بن أيمن (@)(@@) مولى كعب بن سور، </span>عن أنس، روى عنه أبو الأشهب وحماد وجزم البصري، وقال الحسن بن صباح حدثنا العكلي عن الربيع بن صبيح سمع سعيد بن أيمن عن عائشة قولها في التمر.(@)(@@)(@@)(@@) $ 1516 - سعيد بن أيمن عن كثير بن عباس قوله، روى(@)(@@) عنه ابن أبي ذئب.(@)(@@)(@@)(@@) $ 1517 - سعيد بن أبان بن سعيد بن العاصي الأموي القرشي والد يحيى وعبد الله وعنبسة الكوفي، عن معاوية بن إسحاق وموسى وسيف ابني خليد (1) وسمع عمر بن عبد العزيز، روى عنه عبد الله ابنه وسمع أيضا منه ابنه يحيى وقال أبو أحمد الزبيري: كان من خيار الناس.(@)(@@)(@@)(@@) $ 1518 - سعيد بن أبي أويس (2) ، سمع ابن المسيب، مرسل، PageV03P455(@)(@@) روى عنه ابن إسحاق، مرسل، وسمع منه سعيد بن أبي هلال.(@)(@@)(@@)(@@) $ 1519 - سعيد بن أسلم، عن موالى (1) لهم من بني غفار من أصحاب النبي صلى الله عليه وسلم، سمع منه بكير بن الأشج، منقطع (2) .(@)(@@)(@@)(@@) $ 1520 - سعيد بن إياس أبو مسعود الجريري، عن أبي العلاء وأبي نضرة، سمع منه الثوري وشعبة، وقال أحمد عن يزيد بن هارون: ربما ابتدأنا (3) الجريري وكان قد أنكر وسمعت من الجريري سنة إحدى أو اثنتين وأربعين وبعد ذاك، يقال هو من بنى قيس بن ثعلبة ابن بكر بن وائل وهو جرير بن عباد أخو الحارث 
ms611	 بن عباد (4) ، مات سنة أربع وأربعين ومائة، قال لي على قال لي يحيى بن سعيد: الجريري بعد ما اختلط سنة إحدى أو ثنتين وأربعين، قال يحيى وقال لى كهمس ابن الحسن أنكرنا الجريري في الطاعون، وقال يحيى: سألت الجريرى PageV03P456(@)(@@) فقلت حدثك غنيم بن قيس عن أبي موسى: مثل القلب؟ (1) فقال: نعم، قلت سمعت ابا عثمان عن سلمان: لولا أنكم تذنبون لجاء الله بقوم يذنبون فيغفر لهم؟ (2) قال: نعم، قلت حدثك عبد الله بن بريدة عن عبد الله بن عمرو عن النبي صلى الله عليه وسلم: بين كل أذانين صلاة؟ (3) قال: نعم، فلقيت عدي بن الفضل فقال: هو عبد الله بن مغفل، فلقيته فقال: اجعله مرسلا (4) . PageV03P457(@)(@@)(@@)(@@) $ 1521 - سيعد بن أبي أيوب أبو يحيى وهو ابن مقلاص الخزاعي المصري، عن عقيل، روى عنه ابن المبارك والمقري، يقال مات سنة تسع وأربعين ومائة.(@)(@@)(@@)(@@) $ 1522 - سعيد بن إبراهيم (1) ، عن عروة بن رويم عن عرباض قوله روى عنه سيعد بن ابى ايوب، وروى بقية عن سعيد ابن إبراهيم (2) ، ويقال عن الوليد بن مسلم عن سعيد بن إبراهيم حدثني حسان أبو يوسف (3) ، وقال هيثم بن أيوب حدثنا سعيد بن PageV03P458(@)(@@) إبراهيم بن أبي العطوف الحراني حدثنا أبو يوسف، قال أبو عبد الله: ولا أدري هو صاحب سعيد بن أبي أيوب أم لا (1) .(@)(@@)(@@)(@@) $ 1523 - سعيد بن أسعد (2) ، سمع عبد الرحمن بن القاسم ويحيى بن سعيد، سمع منه موسى (3) .(@)(@@)(@@)(@@) $ 1524 - سيعد بن أنس عن أنس عن النبي صلى الله عليه وسلم - في المظالم، لا يتابع عليه، قال عبد الله بن بكر حدثنا عباد بن شيبة عن سعيد، وقال نصر بن علي حدثنا عبد المؤمن بن عباد قال حدثنا سعيد بن أنس عن عكرمة عن ابن عباس: قال النبي صلى الله عليه وسلم: جف القلم - بطوله.(@)(@@)(@@)(@@) $ 1525 - سعيد بن ابيض بن حمال السبأى، يعد في اهل اليمن، PageV03P459(@)(@@) سمع فروة بن مسيك، روى عنه ابنه ثابت.(@)(@@)(@@)(@@) ||| باب الباء(@)(@@)(@@)(@@) $ 1526 - سعيد بن أبي بكر بن حفص بن عمر بن سعد بن أبي 
ms612	 وقاص القرشي الزهري، عن سالم روى عنه سعيد بن مسلم بن بانك الحجازي وزيد بن أبي أنيسة، سمع منه شعبة - ويروى ابن إسحاق عن عبد الملك بن أبي بكر بن حفص.(@)(@@)(@@)(@@) $ 1527 - سعيد بن أبي بردة بن أبي موسى الأشعري، روى عنه قتادة وشعبة.(@)(@@)(@@)(@@) $ 1528 - سعيد بن بشير النجاري، عن محمد بن عبد الرحمن ابن البيامانى، روى عنه الليث، ولا يصح حديثه (1) .(@)(@@)(@@)(@@) $ 1529 - سعيد بن بشير مولى بني نصر، عن قتادة، روى عنه الوليد بن مسلم ومعن بن عيسى، يتكلمون في حفظه، نراه أبا(@)(@@) عبد الرحمن الدمشقي الذي روى عنه هشيم: عن أبي عبد الرحمن عن قتادة.(@)(@@)(@@)(@@) ||| باب التاء(@)(@@)(@@)(@@) $ 1530 - سعيد التمار، عن أنس بن مالك، روى عنه مروان PageV03P460(@)(@@) ابن نهيك، في حديثه نظر.(@)(@@)(@@)(@@) $ 1531 - سعيد بن تليد الرعيني المصري، سمع عبد الله بن وهب، هو أراه سعيد بن عيسى بن تليد.(@)(@@)(@@)(@@) ||| باب الثاء(@)(@@)(@@)(@@) $ 1532 - سعيد الثقفي (1) ، قال ابن طهمان عن حصين بن عبد الرحمن عن أبي الحجاج عن سعيد الثقفي أن رجلا من قومه مر على النبي صلى الله عليه وسلم فقال: ارفع إزارك.(@)(@@)(@@)(@@) ||| باب الجيم(@)(@@)(@@)(@@) $ 1533 - سعيد بن جبير بن هشام أبو عبد الله مولى بني والبة من بني أسد، قال أحمد بن سليمان عن حزم عن واصل بن سليمان عن عبد الله بن سعيد: قتل سعيد وهو ابن تسع وأربعين، قال أبو نعيم: قتل سنة خمس وتسعين، وقال ابن أبي الأسود عن ابن مهدي: كان سفيان يقدم سعيدا على إبراهيم في العلم، سمع أبا مسعود وابن عباس وابن عمرو وابن الزبير وأنس (2) ، وعن ابى هريزة، سمع منه عمرو ابن دينار وأيوب وجعفر بن اياس. PageV03P461(@)(@@)(@@)(@@) $ 1534 سعيد بن جمهان أبو حفص الأسلمي، (@)(@@) يعد في البصريين، سمع من ابن أبي أوفى وسفينة، سمع منه حماد بن سلمة وعبد الوارث.(@)(@@)(@@)(@@) $ 1535 سعيد بن جابر (@)(@@) (1) عن أبيه أن أبا بكر شيع جيشا - قاله آدم حدثنا شعبة حدثنا أبو الفيض سمع سعيدا، روى عنه الشاميون.(@)(@@)(@@)(@@) $ 1536 - سعيد بن جميل العبسي، رأى ربعي 
ms613	 بن حراش، روى عنه أبو نعيم، هو الكوفي.(@)(@@)(@@)(@@) $ 1537 - سعيد بن جعفر بن المطلب بن أبي وداعة السهمي القرشي، سمع اباه، سمع منه ابن جريج.(@)(@@)(@@)(@@) ||| باب الحاء(@)(@@)(@@)(@@) $ 1538 - سعيد بن أبي الحسن أخو الحسن البصري مولى زيد بن ثابت الأنصاري، عن ابن عباس، وهو ابن يسار، روى عنه عوف، قال آدم حدثنا شيبان عن قتادة عن صاحب لهم عن أبي هريرة عن النبي صلى الله عليه وسلم أن ثلاثة دخلوا غارا فدعوا بأفضل أعمالهم فنجوا، وقال خليفة حدثنا معتمر سمع أباه عن قتادة حدثنا صاحب لنا عن أبي هريرة عن النبي صلى الله عليه وسلم - مثله، وقال عمرو بن مرزوق أخبرنا عمران عن قتادة عن سعيد بن ابى الحسن عن ابى هريرة PageV03P462(@)(@@) عن النبي صلى الله عليه وسلم - مثله، وقال أبو عوانة عن قتادة عن أنس عن النبي صلى الله عليه وسلم - نحوه، والأول أصح، مات قبل الحسن ومات الحسن سنة عشر ومائة.(@)(@@)(@@)(@@) $ 1539 - سعيد بن حيان من تيم الرباب أخو بني عدي الكوفي، عن علي، سمع منه أبو حيان، سمع شريحا والحارث بن وسويد، نسبه شعبة عن أبي حيان.(@)(@@)(@@)(@@) $ 1540 - سعيد بن حيان الأزدي اليحمدي، عن ابن عباس روى عنه عوف، وقال أبو معمر حدثنا عبد الواحد قال حدثنا عامر عن سعيد بن حيان الأزدي عن جابر بن زيد وسعيد بن جبير: دخل عليه الايلى (1) وقت أو لم يوقت، قال علي بن نصر: هو من أخوال أمي، قاضي بلخ.(@)(@@)(@@)(@@) $ 1541 - سعيد بن حيان البصري، سمع عتبة بن أبي سليمان يقول حدثني أبو السمين، سمع منه موسى، وكنية حيان أبو السمين ابن جحدر الطائي (2) .(@)(@@)(@@)(@@) $ 1542 - سعيد بن الحارث (@)(@@) قاضي (3) أهل المدينة </span>ويقال PageV03P463(@)(@@) ابن المعلى (1) سمع ابن عمرو جابرا وأبا سعيد، سمع منه محمد بن عمرو وفليح، روى عنه عمرو بن الحارث وعمارة بن غزية.(@)(@@)(@@)(@@) $ 1543 - سعيد بن الحارث، عن شريح، روى عنه الحسن أبو كيران قوله.(@)(@@)(@@)(@@) $ 1544 - سعيد بن الحويرث مولى السائب، سمع ابن عباس، سمع منه عمرو بن دينار 
ms614	 وابن جريج، ويقال ابن أبي الحويرث.(@)(@@)(@@)(@@) $ 1545 - سعيد بن حسان، سمع ابن الزبير، روى عنه إبراهيم بن نافع، وقال وكيع عن نافع بن عمر عن سعيد بن حسان عن ابن عمر أن النبي صلى الله عليه وسلم كان ينزل بعرفة في وادي نمرة.(@)(@@)(@@)(@@) $ 1546 - سعيد بن حسان المخزومى، حجازى، سمع ابن عياض ابن عدي بن الخيار النوفلي - قاله أبو نعيم حدثنا سعيد، وقال قتيبة حدثنا سفيان عن سعيد عن عروة بن عياض عن جابر عن النبي صلى الله عليه وسلم - في العزل، وسمع مجاهدا، سمع منه وكيع. PageV03P464(@)(@@)(@@)(@@) $ 1547 - سعيد بن الحكم بن أبي مريم المصري أبو محمد الجمحي، سمع يحيى بن أيوب والليث ومحمد بن مطرف، مات سنة أربع وعشرين ومائتين(@)(@@)(@@)(@@) $ 1548 - سعيد بن الحكم سمع أبا أيوب: " الوسطى العصر " (1) قاله وهب (2) حدثنا أبي سمعت يحيى بن أيوب عن(@)(@@) يزيد بن أبي حبيب عن مرة (3) ويقال سعد بن أحكم (4) .(@)(@@)(@@)(@@) $ 1549 - سعيد بن أبي حرة، سمع نافعا، روى عنه ابن PageV03P465(@)(@@) أبي عروبة.(@)(@@)(@@)(@@) $ 1550 - سعيد بن حنظلة العائذي (1) ، روى عنه محمد بن إسماعيل بن رجاء وسليمان بن قرم.(@)(@@)(@@)(@@) $ 1551 - سعيد بن حيى (2) الحولانى الجعلى، سمع اباه، روى عنه عياش بن عباس.(@)(@@)(@@)(@@) $ 1552 - سعيد بن حدير أبو غنيم، منقطع، روى عنه صفوان ابن عمرو الشامي.(@)(@@)(@@)(@@) $ 1553 - سعيد الحمصي الشامي (3) ، إسحاق قال حدثنا روح PageV03P466(@)(@@) ابن عبادة قال حدثنا مرزوق أبو عبد الله الشامي حدثنا سعيد الشامي حدثنا ثوبان عن النبي صلى الله عليه وسلم: لتطفي الحمى بالماء (1) ، قال PageV03P467(@)(@@) أبو عبد الله: إن لم يكن ابن زرعة فلا أدري.(@)(@@)(@@)(@@) $ 1554 - سعيد بن حريث (1) : سألت الحسن - قوله.(@)(@@)(@@)(@@) ||| باب الخاء(@)(@@)(@@)(@@) $ 1555 - سعيد بن خالد بن عمرو بن عثمان أبو عثمان الأموي، سمع عروة وقبيصة بن ذؤيب، روى عنه الزهري، قال محمد بن عبادة حدثنا يعقوب بن محمد قال حدثنا محمد بن معن عن أبيه أو قال حدثني جدي عن سعيد بن خالد بن عمرو بن عثمان بن عفان: والله لكأن عمر بن عبد العزيز كان صعدبه إلى 
ms615	 السماء فنظر ثم نزل إلى الأرض - يعنى في اجتهاده. PageV03P468(@)(@@)(@@)(@@) $ 1556 - سعيد (1) بن خالد بن عمرو بن حزم عن بعض أزواج النبي صلى الله عليه وسلم: ما هب النبي صلى الله عليه وسلم من يوم قط إلا وقع ساجدا - قاله عبيد حدثنا يونس حدثنا ابن إسحاق.(@)(@@)(@@)(@@) $ 1557 - سعيد بن خالد (2) بن قارظ المدني الزهري أخو المسور، سمع أبا سلمة وعن ربيعة بن عباد، سمع منه ابن أبي ذئب.(@)(@@)(@@)(@@) $ 1558 - سعيد بن خالد القرشي، رأى واثلة وأنسا، روى عنه إسماعيل بن عياش.(@)(@@)(@@)(@@) $ 1559 - سعيد بن خالد الخزاعي المدني، سمع عبد الله بن الفضل، روى عنه عبد الملك الجدي، فيه نظر.(@)(@@)(@@)(@@) $ 1560 - سعيد بن أبي خالد واسم أبي خالد سعد (3) أخو إسماعيل والنعمان وأشعث، عن أبي كاهل، روى عنه أخوه إسماعيل.(@)(@@)(@@)(@@) $ 1561 - سعيد بن أبي خيرة، يعد في البصريين، قال بدل حدثنا عباد بن راشد عن سعيد سمع الحسن عن أبي هريرة عن النبي صلى الله عليه وسلم: يأتي زمان يأكلون كلهم الربا، روى عنه داود بن أبي هند. PageV03P469(@)(@@)(@@)(@@) $ 1562 - سعيد بن خرشيد، سمع أبا الشعثاء وحسن بن محمد، روى عنه ابن جريج، حديثه في المكيين.(@)(@@)(@@)(@@) $ 1563 - سعيد بن خثيم أبو معمر الهلالي الكوفى، سمع جدته وأسد بن عبد الله وعن أخيه معمر بن خثيم.(@)(@@)(@@)(@@) $ 1564 - سعيد بن خثيم رجل من سليط عن رجل من أهل الشام عن رجل له صحبة: خطبنا النبي صلى الله عليه وسلم - نحو(@)(@@) حديث عرباض بن سارية - قاله لنا موسى حدثنا جعفر بن حيان.(@)(@@)(@@)(@@) $ 1565 - سعيد بن خازم أبو عبد الرحمن عن الأعمش عن ليث عن مجاهد: كان مع سليمان ... (1) قاله علي حدثنا أبو أحمد الزبيري سمع سعيدا، وقال وكيع عن الأعمش: سمعت مجاهدا.(@)(@@)(@@)(@@) ||| باب الدال(@)(@@)(@@)(@@) $ 1566 - سعيد بن دينار، سمع الشعبي قوله، روى عنه وكيع.(@)(@@)(@@)(@@) $ 1567 - سعيد بن داود الزنبري المدني سكن بغداد، عن مالك، ويقال ابن أبي داود.(@)(@@)(@@)(@@) ||| باب الذال(@)(@@)(@@)(@@) $ 1568 - سعيد بن ذي حدان، سمع سهل بن حنيف وعلقمة، PageV03P470(@)(@@) روى عنه أبو إسحاق.(@)(@@)(@@)(@@) $ 1569 - سعيد 
ms616	 بن ذي لعوة عن عمر في النبيذ روى عنه الشعبى، يخالف الناس في حديثه، لايعرف، وقال بعضهم: سعيد بن ذي حدان، وهو وهم، قال مسدد حدثنا يحيى عن سفيان عن أبي حيان عن الشعبي عن ابن عمر عن عمر: حرمت الخمر وهي من خمسة والخمر ما خامر العقل.(@)(@@)(@@)(@@) ||| باب الراء(@)(@@)(@@)(@@) $ 1570 - سعيد بن الربيع أبو زيد الهروي البصري، سمع شعبة وعلي بن المبارك، وقال علي بن نصر: جده مكاتب لزرارة بن أو في يبيع الهروية نسب إليها، قال عباس بن أبي طالب: مات سنة(@)(@@) إحدى عشرة ومائتين.(@)(@@)(@@)(@@) $ 1571 - سعيد بن أبي رعدة سمع قتادة عن سعيد بن المسيب وابن جبير: لا بأس بكراء الحمام - قاله مخلد عن أبي عبيدة.(@)(@@)(@@)(@@) $ 1572 - سعيد بن راشد أبو محمد المازني البصري السماك، عن عطاء والزهري، منكر الحديث (1) .(@)(@@)(@@)(@@) $ 1573 - سعيد بن رزيق، سمع مجاهدا، روى عنه القاسم PageV03P471(@)(@@) ابن مالك.(@)(@@)(@@)(@@) ||| باب ز(@)(@@)(@@)(@@) $ 1574 - سعيد بن زرعة (1) الخزاف (2) سمع ثوبان مولى النبي صلى الله عليه وسلم قوله في حب الدنيا - سمع منه حسن (3) بن همام.(@)(@@)(@@)(@@) $ 1575 - سعيد بن زيد بن عقبة، عن ابيه، روى عنه حجاج ابن أرطأة، هو الفزاري، يعد في الكوفيين.(@)(@@)(@@)(@@) $ 1576 - سعيد بن زيد أخو حماد بن زيد مولى الأزد لآل جرير بن حازم، البصري سمع علي بن الحكم، قال ابن محبوب: مات سنة سبع وستين ومائة قبل حماد بن سلمة، وقال مسلم: حدثنا سعيد ابن زيد أبو الحسن صدوق حافظ.(@)(@@)(@@)(@@) $ 1577 - سعيد بن زيد الذي قتل يوم اليمامة: قال عمر: لا يسألني الله خمسة دراهم في أكلة ابدا. PageV03P472(@)(@@)(@@)(@@) $ 1578 - سعيد بن زياد، عن جابر (1) ، روى عنه سعيد بن أبي هلال.(@)(@@)(@@)(@@) $ 1579 - سعيد بن زياد المكتب مولى بنى زهرة، سمع عثمان ابن عبد الرحمن التيمي وسليمان بن يسار وعن عبد الله بن محمد بن عمر ابن على، سمع منه خالد بن مخلد، منقطع، يعد في أهل المدينة.(@)(@@)(@@)(@@) $ 1580 - سعيد بن زياد الشيباني، سمع طاوسا وزياد بن صبيح، روى عنه يحيى القطان ووكيع.(@)(@@)(@@)(@@) $ 1581 - سعيد 
ms617	 بن زون الثعلبي البصري، رأى أنس بن مالك، روى عنه محمد بن سعيد، لا يتابع في حديثه.(@)(@@)(@@)(@@) $ 1582 - سعيد بن زربي أبو معاوية (2) ، سمع ثابتا البصري وأبا المليح، صاحب عجائب. PageV03P473(@)(@@)(@@)(@@) $ 1583 - سعيد الزيات، سمع ابن الحنفية قوله، روى عنه فرات القزاز (1) .(@)(@@)(@@)(@@) $ 1584 - سعيد بن زكريا المدائني القرشي أبو عمر (2) ، صدوق، كناه أحمد بن سليمان.(@)(@@)(@@)(@@) ||| باب السين(@)(@@)(@@)(@@) $ 1585 - سعيد بن أبي سعيد المقبري أبو سعد، قال ابن أبي أويس ينسب إلى مقبرة، وقال غيره: أبو سعيد مكاتب لامرأة من بني ليث مدني، وقال ابن طهمان عن ابن أبي ذئب عن سعيد المقبري عن النبي صلى الله عليه وسلم: ما سمعتم عني من حديث تعرفونه فصدقوه، وقال يحيى: عن أبي هريرة، وهو وهم ليس فيه أبو هريرة هو سعيد بن كيسان.(@)(@@)(@@)(@@) $ 1586 - سعيد بن أبي سعيد المهري أبو السميط، عن أبيه وعن إسحاق مولى زائدة، روى عنه أسامة وحرملة بن عمران.(@)(@@)(@@)(@@) $ 1587 - سعيد بن أبي سعيد الخدري الأنصاري وهو سعيد PageV03P474(@)(@@) ابن سعد بن مالك، مدني، سمع أباه.(@)(@@)(@@)(@@) $ 1588 - سعيد بن سعيد التغلبي أبو الصباح سمع سعيد بن عمير - قاله أبو أسامة، وعن أبي الشعثاء الكندي وعكرمة، روى عنه وكيع.(@)(@@)(@@)(@@) $ 1589 - سعيد بن سعيد بن جور بنده (1) ، سمع عطاء قوله، روى عنه أبو عاصم.(@)(@@) لم أجده في العتيق.(@)(@@)(@@)(@@) $ 1590 - سعيد بن سفيان القاري سمع عليا - قاله يحيى بن أبي عمرو عن عبد الله بن ناشر (2) قاله سلمة بن رجاء وعباد أبو عتبة، وقال ضمرة عن يحيى عن الوليد بن سفيان عن رجل عن علي عن النبي صلى الله عليه وسلم قال: يوشك أن يستحلوا الخمر والحرير (3) .(@)(@@)(@@)(@@) $ 1591 - سعيد بن سفيان الأسلمي، قال الحميدى حدثنا PageV03P475(@)(@@) ابن أبي الفديك سمع سعيدا عن جعفر بن محمد عن أبيه عن عبد الله ابن جعفر عن النبي صلى الله عليه وسلم: أن الله مع الدائن حتى يقضي دينه، وقال أبو نعيم حدثنا القاسم بن الفضل عن أبي جعفر عن عائشة عن النبي صلى الله عليه وسلم - بمعناه.(@)(@@)(@@)(@@) $ 1592 
ms618	 - سعيد بن سفيان البصري، سمع شعبة، يقال عن علي: ذهب حديثه (1) ، وسمعت إبراهيم بن بسطام يقول: مات سنة أربع أو خمس ومائتين، قال أبو عبد الله: أرى كنيته أبا الحسن.(@)(@@)(@@)(@@) $ 1593 - سعيد بن سويد الكلبي، قال عبد الله عن معاوية عن سعيد عن عبيدة الأملوكي أنه كان يعظ الناس، وعن عمر بن عبد العزيز وعبد الأعلى بن هلال (2) ، يعد في الشاميين، روى عنه أبو بكر بن أبي مريم. PageV03P476(@)(@@)(@@)(@@) $ 1594 - سعيد بن سويد (@)(@@) </span></span>(1) ، قال إسماعيل بن خليل أخبرنا علي بن مسهر سمع الأعمش عن عمر بن مرة عن سعيد رجل منهم: صلى بنا معاوية الجمعة بضحى، ولا يتابع عليه.(@)(@@)(@@)(@@) $ 1595 - سعيد بن سويد (2) ، عن زياد عن أبي الصديق.(@)(@@) مرسل، روى عنه العكلي.(@)(@@)(@@)(@@) $ 1596 - سعيد بن سويد (2) ، سمع عبد الملك بن عمير، روى عنه محمد بن الصلت.(@)(@@)(@@)(@@) $ 1597 - سعيد بن سنان أبو سنان الشيباني، عن عمرو بن مرة وعلقمة بن مرثد، يقال القزويني (3) .(@)(@@)(@@)(@@) $ 1598 - سعيد بن سنان أبو مهدي الحمصى الكندى، PageV03P477(@)(@@) عن أبي الزاهرية، منكر الحديث.(@)(@@)(@@)(@@) $ 1599 - سعيد بن سلمة المخزومي، قال ابن يوسف أخبرنا مالك عن صفوان بن سليم عن سعيد بن سلمة من آل ابن الأزرق سمع المغيرة بن أبي بردة سمع أبا هريرة عن النبي صلى الله عليه وسلم: الحل(@)(@@) ميتته، وقال عبد الله حدثنا الليث حدثنا يزيد بن أبي حبيب عن أبي كثير جلاح أن سعيد بن سلمة المخزومي أخبره أن المغيرة بن أبي بردة أخبره سمع أبا هريرة عن النبي صلى الله عليه وسلم، وقال ابن وهب أخبرني عمرو عن جلاح مولى عبد العزيز عن سعيد بن سلمة المخزومي - مثله، وقال ابن سلام أخبرنا محمد بن سلمة عن ابن إسحاق عن يزيد ابن ابى حبيب عن جلاح (1) (عن - 2) عبد الله بن سعيد المخزومي عن المغيرة بن أبي بردة عن أبي هريرة عن النبي صلى الله عليه وسلم، وقال سلمة حدثنا ابن إسحاق عن يزيد عن اللجلاج عن سلمة عن PageV03P478(@)(@@) المغيرة بن أبي بردة حليف بني عبد 
ms619	 الدار عن أبي هريرة عن النبي صلى الله عليه وسلم، وقال يوسف بن راشد حدثنا عبد الرحمن بن مغراء قال حدثنا ابن إسحاق عن يزيد بن أبي حبيب عن الجلاح (1) وكان رضا عن عبد الله بن سعيد المخزومي عن مغيرة بن أبي بردة الكناني عن أبي هريرة عن النبي صلى الله عليه وسلم.(@)(@@)(@@)(@@) $ 1600 - سعيد بن سلمة بن ابى الحسام أبو عمرو مولى آل(@)(@@) عمر بن الخطاب القرشي، </span>نسبه عبد الله بن رجاء، سمع محمد بن المنكدر وهشام بن عروة وعثمان الأخنسي، روى عنه موسى، هو المدني، وقال أبو عامر حدثنا أبو عمرو السدوسي المدني فلا أدري هو هذا أم غيره؟ (2)(@)(@@)(@@)(@@) $ 1601 - سعيد بن سلمة (3) ، سمع اباه، روى عنه سليمان ابن أبي زينب وعمرو بن الحارث.(@)(@@)(@@)(@@) $ 1602 - سعيد بن سمعان مولى الزرقيين الانصاري المدنى، PageV03P479(@)(@@) سمع أبا هريرة، روى عنه ابن أبي ذئب.(@)(@@)(@@)(@@) $ 1603 - سعيد بن سليم الضبي، قال الجعفي حدثنا العقدي سمع سعيدا سمع أنسا: كان النبي صلى الله عليه وسلم إذا سافرا أو غزا أردف كل يوم رجلا، وقال حجاج بن منهال حدثنا سعيد بن سليم أبو عثمان الضبي - نحوه، سمع منه عبد الأعلى بن محمد.(@)(@@)(@@)(@@) $ 1604 - سعيد بن سليم (1) بن قهد، قال أبو ثابت حدثنا ابن أبي حازم عن يحيى بن سعيد عن أبي بكر (2) أن رجلا من الأنصار سعيد بن سليم بن قهد أصابه شكوى ذهب عقله أو كبر(@)(@@) فلم يصم ففدى كل يوم بطعام مسكين.(@)(@@)(@@)(@@) $ 1605 - سعيد بن السائب الطائفي عن أبيه ونوح بن صعصعة ومحمد (3) بن أبي هندية، روى عنه معن بن عيسى.(@)(@@)(@@)(@@) $ 1606 - سعيد بن سليمان، عن يزيد بن نعامة، روى حاتم عن عمران القصير سمع سعيد بن سليمان الربيعي (4) ، مرسل، وقال PageV03P480(@)(@@) علي بن الهيثم حدثنا معلى قال حدثنا حاتم قال حدثنا عمران قال: حدثنا سعيد بن سليمان الربيعي.(@)(@@)(@@)(@@) $ 1607 - سعيد بن سليمان (1) بن ثابت الأنصاري الخزرجي النجاري (2) المدني أخو عبد الله سمع عمه (3) خارجة سمع زيد بن ثابت في أمرك بيدك فاختارت نفسها 
ms620	 واحدة - قاله إسماعيل عن مالك.(@)(@@)(@@)(@@) $ 1608 - سعيد بن سليمان أبو عثمان البغدادي، سمع الليث وعباد بن العوام، مات سنة خمس وعشرين، ومائتين، ولقبه سعدويه البزاز.(@)(@@)(@@)(@@) $ 1609 - سعيد بن سابق، عن إسماعيل بن ابى خالد، روى عنه هارون بن المغيرة، أحسبه والد محمد بن سعيد بن سابق (4) .(@)(@@)(@@)(@@) $ 1610 - سعيد بن سلام أبو الحسن البصري العطار، PageV03P481(@)(@@) عن الثوري، منكر الحديث.(@)(@@)(@@)(@@) $ 1611 - سعيد بن سالم أبو عثمان القداح، خراساني، سكن مكة، عن ابن جريج، يرى الإرجاء.(@)(@@)(@@)(@@) ||| باب الشين(@)(@@)(@@)(@@) $ 1612 - سعيد بن أبي شمر السبأى، قال أصبغ عن ابن وهب عن عمرو بن الحارث قال بكر بن سوادة أخبرني سعيد رأى مالك بن أزهر ينقي باطن قدميه وكان قد أدرك النبي صلى الله عليه وسلم.(@)(@@)(@@)(@@) $ 1613 - سعيد بن شفي عن ابن عباس: كان النبي صلى الله عليه وسلم إذا خرج من بيته صلى ركعتين حتى يرجع - قاله محمد بن عرعرة سمع شعبة عن أبي إسحاق عن أبي السفر، وقال أبو نعيم حدثنا زهير عن أبي إسحاق عن رجل من حية (1) سعيد بن شفي سمع ابن عباس، وقال عبيد الله عن إسرائيل عن أبي إسحاق عن سعيد بن شفي سمع ابن عباس.(@)(@@)(@@)(@@) $ 1614 - سعيد بن شيبان الطائي، روى عنه مسعر وابن عيينة، مرسل (2) . PageV03P482(@)(@@)(@@)(@@) $ 1615 - سعيد بن شرحبيل الكوفي الكندي، سمع الليث.(@)(@@)(@@)(@@) ||| باب الصاد(@)(@@)(@@)(@@) $ 1616 - سعيد (1) بن الصلت، عن سهل بن البيضاء، مرسل، وسمع ابن عباس، روى عنه محمد بن إبراهيم وبكر بن سوادة، وروى شريك بن أبي نمر عن سعيد بن الصلت بن يعقوب (2) مولى آل مخرمة (3) قوله، قال إبراهيم بن الحارث حدثنا يحيى بن أبي بكير قال حدثنا زهير بن محمد عن شريك عن سعيد بن الصلت ابى يعقوب PageV03P483(@)(@@) مولى لال مخزمة أنه بلغه في عاشوراء.(@)(@@)(@@)(@@) $ 1617 - سعيد بن أبي صدقة البصري، قال معاذ عن أشعث عن ابن سيرين عن عبد الله بن شقيق عن عائشة: كان النبي صلى الله عليه وسلم لا يصلى في شعرنا، وقال سليمان بن حرب حدثنا حماد بن زيد 