ms881	 تر زنجیر پیلستی(@)(@@) 7 به خلد و سلسبیلش راه نبود مرد عاصی را %~% تو عاصی‌از چه‌ردر پابن خلد و سلسبیلشی(@)(@@) 8 تو را در سایه طاووس بهشت ای سایه طوبی %~% غلط‌گفتم‌که طوبی را به سر ظل ظلیلستی(@)(@@) 9 شنیدستم که مار آید دلیل خلد شیطان را %~% سیه ماری به سوی خلد شیطان را دلیلستی(@)(@@) 10 بجز از سایه تو کی توان جستن عدیل تو %~% به‌روی یار خزم زی که بی‌یار و عدیلستی(@)(@@) 11 مرا بر نیلیستی دیده شنجرفی به هجر اندر %~% تو را تا توده شنجرف اندر زیر نیلستی(@)(@@) 12 قرامحمود یا خود شاملو ای طره جانان %~% سیه خیمه ترا اندر چه گلشن وز چه ایلستی(@)(@@) 13 بیفشان خویش را تا گویمت تبت‌ کجا باشد %~% به‌خود بشکن بگویم تا به چینت چند میلستی(@)(@@) 14 ز تیره ابر نوروزی همی بارد به لالستان %~% هرا دو دیده لالستان و تو ابر بخیلستی(@)(@@) 15 به‌هرکس وعده فردوس اعلی از تو در طاعت %~% مگر خاک ره شاهنشه دین را وکیلستی(@)(@@) 16 پناه دین حق نفس نبی مقصود حرف کن %~% علی کایینه ذات خداوند جلیلستی PageV1P407(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 نهانی از نظر ای بی‌نظیر از بس عیانستی %~% عیان شد سر این معنی‌که می‌گفتم نهانستی(@)(@@) 2 گهی‌گویم عیانستی‌گهی گویم نهانستی %~% نه اینستی نه آنستی هم اینستی هم آنستی(@)(@@) 3 به نزد آن‌ کت از عین عیان بیند نهانستی %~% به پیش آن کت از چشم نهان جوید عیانستی(@)(@@) 4 یقین هرچند می‌جوید گمان هرچند می‌پوید %~% نه محصور یقینستی نه مغلوب‌ گمانستی(@)(@@) 5 بیانی راکه کس واقف نباشد نکته‌پردازی %~% زبانی را که ‌کس دانا نباشد ترجمانتی(@)(@@) 6 به چشم حق نگر گر ژرف بیند مرد دانشور %~% تو در هر قطره‌یی پنهان چو بحر بیکرانستی(@)(@@) 7 اگرکس عکس خورشید فلک در آبدان بیند %~% نیارد گفت خورشید فلک در آبدانستی(@)(@@) 8 کجا مهری ‌که سیصد چند غبرا جرم رخشانش %~% درون آبدان بودن خلاف امتحانستی(@)(@@) 9 وگر گوید نه خورشیدست کاندر آبدان 
ms882	 دبدم %~% ز انکار عیان مردود عقل نکته‌دانستی(@)(@@) 10 یکی‌گفتا قدیم از اصل با حادث نپیوندد %~% سپس پیوند ما با ذات بی‌همتا چنانستی(@)(@@) 11 بگفتم راست می‌گوبی و راه راست می‌پویی %~% ولیکن آنچه می‌جویی عیان از این بیانستی(@)(@@) 12 بجنبد سرو را شاخ از نسیم و ریشه پابرجا %~% نجنبد اصل آن از باد اگر فرعش نوانستی(@)(@@) 13 ازین تمثال روشن شدکه شخص آفریش را %~% ثباتی با حدوث اندر طبیعت توامانستی(@)(@@) 14 به‌معنی هست پاینده به صورت هست زاینده %~% به ‌وجهی از مکان بیرون به وجهی در مکانستی(@)(@@) 15 از آن پایندگی همسایه با عقل گرانمایه %~% ازین زایندگی همپایه با یونان زمانستی(@)(@@) 16 روان بوعلی سینا ازین اشراق سینایی %~% به زیر خاک تاری پای‌کوبان‌ کف زنانستی(@)(@@) 17 کس ار زی تربیت پوید که قاآنی چنین‌ گوید %~% سراید مرحبا بالله‌که تحقیق آن‌چنانستی(@)(@@) 18 به خاصانت بپیوندد کلام نغز من چونان %~% که ره‌گم‌کرده را رهبر جرس زی ‌کاروانستی PageV1P408(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ماه من ماند به سر و ار سرو جولان داشتی %~% سرو من ماند به ماه ار ماه دستان داشتی(@)(@@) 2 ماه بودی ماه اگر چون سرو بودی بر زمین %~% سرو بودی سرو اگر چول ماه جولان داشتی(@)(@@) 3 سرو من ماند به ماه و ماه من ماند به سرو %~% سرو اگر مه مه اگر سرو خرامان داشتی(@)(@@) 4 سرو را ماند به بالا ماه را ماند به رخ %~% ماه اگر گفتی سرود و سو اگر جان‌ داشتی(@)(@@) 5 سرو بودی سرو اگر با مردمان ‌گفتی سخن %~% ماه بودی ماه اگر چاه زنخدان داشتی(@)(@@) 6 گفتمش سرو روان و خواندمش ماه تمام %~% سرو اگر بودی کمانکش ماه خفتان داشتی(@)(@@) 7 قد او سروست ‌و مویش‌ مشک ‌و رویش‌ ماه اگر %~% سرو مار و مشک چین و ماه مژگان داشتی(@)(@@) 8 آفتابش خواندمی بی‌گفتگو گر آفتاب %~% از زنخدان‌ گوی مشکین زلف چوگان داشتی(@)(@@) 9 پرنیان بودی به نرمی پیکرش‌گر پرنیان %~% با همه نرمی دلی چون 
ms883	 سخت سندان داشتی(@)(@@) 10 لاله بودی عارضش ‌گر لاله پیرامون خویش %~% همچو مشکین‌خط او یک باغ ریحان داشتی(@)(@@) 11 می نکردی کس گناه از بیم حرمان بهشت %~% چون نگار من بهشت ار حور و غلمان داشتی(@)(@@) 12 از فراق آن پری مجنون شدی هرکس چو من %~% جان بریان جسم عریان چشم‌گریان داشتی(@)(@@) 13 ترک شهرآشوب من ماند پری راگر پری %~% خوی رندان لعل خندان در دندان داشتی(@)(@@) 14 ای بت پیمانه‌نوش ای شاهد پیمان‌گسل %~% کاش چون ‌عشاق خوی و پاس و پیمان داشتی(@)(@@) 15 خود لبت‌ لعلیست‌ کز خورشید می‌جستی خراج %~% اینچنین لعل درخشان ‌گر بدخشان داشتی(@)(@@) 16 همچو رخسار تو صادق بود در دعوی حسن %~% هرکه چون زلفین مفتولت دو برهان داشتی(@)(@@) 17 گر نکردی عدل سالار جهان تعمیر ملک %~% ملک شه را شورش حسن تو ویران داشتی(@)(@@) 18 داور گیتی منوچهر آنکه برسودی به عرش %~% چرخ چارم ‌گر چنین خورشید تابان داشتی(@)(@@) 19 کی ربودی اهرمن زانگشت جم انگشتری %~% آصفی‌گر اینچنین دانا سلیمان داشتی(@)(@@) 20 کوه بودی توسنش گر کوه بودی ره‌نورد %~% برق بودی خنجرش‌ گر برق باران داشتی(@)(@@) 21 گاه غوغا شرزه شیرش گفتمی گر شرزه شیر %~% از سنان چنگال و از شمشیر دندان داشتی(@)(@@) 22 روز هیجا ژنده پیلش خواندمی گر ژنده پیل %~% از کمند جان‌ستان خرطوم پیچان داشتی(@)(@@) 23 توسنش باد وزانستی اگر باد وزان %~% جنبش برق و شکوه‌ کوه ثهلان داشتی(@)(@@) 24 اهل شرق و غرب گشتندی ز پا تا فرق غرق %~% گر سحابی چون عدویش جشم ‌گریان داشتی(@)(@@) 25 خنجر خونریز او را خواندمی رخشنده برق %~% برق اگر چون ابر موج‌انگیز طوفان داشتی(@)(@@) 26 قدرش ار بودی مجسم صدهزاران ساله راه %~% برتری از منظر برجیس وکیوان داشتی(@)(@@) 27 قهر جانکاهش اگر گشتی مصور در جهان %~% چنگ شیر و سهم پیل و سم ثعبان داشتی(@)(@@) 28 در کفش شمشیر بودی اژدها گر اژدها %~% چون نهنگان جایگه در بحر عمان داشتی(@)(@@) 29 میزبان‌گشتی اجل چون 
ms884	 تیغش ار بر خوان رزم %~% دیو و دد را تا به روز حشر مهمان داشتی(@)(@@) 30 گر نسیم خلق او یک ره وزیدی در جهان %~% سال و ماه و هفته‌گیتی راگلستان داشتی(@)(@@) 31 مرگ مانازاده شمشیر گیهان‌سوز اوست %~% ورنه چون آلام دیگر مرگ درمان داشتی(@)(@@) 32 حزم اوگر خواستی از روی حکمت پیل را %~% در دهان پشه‌یی تا حشر پنهان داشتی(@)(@@) 33 حاش لله اگرکسی‌وی را ستودی در سخا %~% گر سخایی چون سخای معن و قاآن داشتی(@)(@@) 34 بر روانم طعن و لعن از معن و قاآن هیچیک %~% همچو کهتر چاکرانش فضل و احسان داشتی(@)(@@) 35 درصدف‌هر قطره اش می گشت صد عمان‌گهر %~% نسبتی با جود او گر ابر نیسان داشتی(@)(@@) 36 بود آرش ترکمان چون او اگر مانند او %~% مرگ یکسو و نهان در پیش ترکان داشتی(@)(@@) 37 خنجرش‌گر خواستی در روز هیجا خلق را %~% از لباس زندگی چون خویش عریان داشتی(@)(@@) 38 گر نبودی عفو او عدلش ز روی انتقام %~% برگلوی مه طناب از تارکتان داشتی(@)(@@) 39 حاجب مهرش اگر قهرش نگشتی گاهگاه %~% زینهار ار هیچ عاصی بیم عصیان داشتی(@)(@@) 40 ملک‌بخشا تا ابد آباد بودی ملک فارس %~% از ازل گر چون تو سالاری نگهبان داشتی(@)(@@) 41 مر ترا کردی مفوض شهریار ملک‌بخش %~% ملکی ار صدره فزون از ملک ‌گیهان داشتی(@)(@@) 42 ور ترا بودی مسلم ملک ایران اینچنین %~% کافرم‌گر روس هرگز قصد ایران داشتی(@)(@@) 43 بود چون حزم تو گر حزم سکندر پایدار %~% دولتش‌کی تا به روز حشر پایان داشتی(@)(@@) 44 گر به شوخی جاهلی‌گویدکه قاآنی راد %~% داشتی حب وطن در دل ‌گر ایمان داشتی(@)(@@) 45 گویمش خود کافرم‌ گر هیچ مومن بیش ازین %~% جایگه در ملک شیراز از دل و جان داشتی(@)(@@) 46 می‌نبد در پارس رادی تا ورا بخشد مراد %~% ورنه‌ کی بیچاره عزم یزد وکرمان داشتی(@)(@@) 47 شیر گردون را درافکندی به ‌گردن پالهنگ %~% چون تو در دل هر که مهر شیر یزدان داشتی 
ms885	(@)(@@) 48 حیدر صفدر که‌گر با عرش می رفتی به خشم %~% از زبونی عرش را با فرش یکسان داشتی(@)(@@) 49 گر نبودی روز هیجا پای عفوش در میان %~% ضرب بازویش خلل در چار ارکان داشتی(@)(@@) 50 ور به دامان ولای او زدی ابلیس چنگ %~% از عطای ‌کردگار امید غفران داشتی(@)(@@) 51 یوسف ار بر رشته مهرش نجستی اعتصام %~% کی خلاصی از مضیق چاه و زندان داشتی(@)(@@) 52 مختصرگو غیر ذات او نبودی در جهان %~% واجبی در بر اگر تشریف امکان داشتی(@)(@@) 53 ای دریغا نیستی در دار دنیا مصطفی %~% ورنه در مدحش‌ مرا انباز حسان داشتی(@)(@@) 54 ختم‌کن قاآنیا گفتارکزگفتار تو %~% وجد کردی‌ کوه ‌اگر گوش‌ سخندان داشتی PageV1P409(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 تبارک ای نگار خلخی ای ماه نوشادی %~% که داری بر غم دیرین ما هردم ز نو شادی(@)(@@) 2 نخو‌ردم‌ هرچه ‌خوردم قند چون لعلت به‌شرینی %~% ندیدم هرچه دیدم سرو چون قدت به آزادی(@)(@@) 3 برون شد هشت‌چیز از هشت‌چیزم بی‌تو ای دلبر %~% که ‌هر غم ‌از غمانم کرده بی ‌آن هشت هشتادی(@)(@@) 4 ز چم‌ خواب‌و ز دل‌تاب‌و ز رخ‌آب و ز دل طاقت %~% زکف‌ایمان‌زسر سامان‌زپیکرجان‌زجان‌شادی(@)(@@) 5 تو ای ماه دو هفته ‌کرده‌یی هر هفت و هر هفته %~% کند در حسن هر پیرایه‌یی زان هفت هفتادی(@)(@@) 6 نبودی چون دل سخت تو شیرین بیستون ورنه %~% نکردی رخنه در وی تیشه فولاد فرهادی(@)(@@) 7 قوافی ذال بود و دال شد چون دیدم ای دلبر %~% که‌صاد چشم مستت‌کرده از خال سیه ضادی(@)(@@) 8 اگرنه صنع صباغی به من آموخت عشق تو %~% چرا مشکم همی‌ کافور گشت‌و لاله‌ام جادی(@)(@@) 9 ت‌رمشکین‌موی و شیرین‌گو‌ی بربستی و بشکستی %~% ز مو دکان عطاری ز لب بازار قنادی(@)(@@) 10 دمم دود و دلم‌ کوره عنا گاز و تنم آهن %~% بلا پتک و سرم سندان و پیشه عشق حدادی(@)(@@) 11 اذاکان الغراب آید به یادم هر زمان‌کاید %~% دلم را در طریق عشق زاغ زلف تو هادی(@)(@@) 12 اطیب 
ms886	 المسک ام ربا الغوالی ام شذا ورد %~% کزو بوی حبیبم در مشام آید در این وادی(@)(@@) 13 غزال نافر قد صاد اسد الغالب عن لحظ %~% بدیعست از چنان وحشی‌غزال‌ اینگونه صیادی PageV1P410(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 گشودی زلف قیرآگین جهان را قیروان‌کردی %~% نمودی چهر مهرآیین زمین را آسمان‌کردی(@)(@@) 2 قمر آوردی از گردون به شاخ نارون دستی %~% گهر دزدیدی از عمان نهان در ناردان‌ کردی(@)(@@) 3 یکی‌گردنده‌کوهی را لقب سیمین‌سرین دادی %~% یکی باریک ‌مویی را صفت لاغرمیان ‌کردی(@)(@@) 4 بدان فتراک‌گیسو نرم‌نرمک پای دل بستی %~% وزان‌شمشیر ابرو اندک‌اندک قصد جان کردی(@)(@@) 5 دو پرچین‌کردی‌از شبل‌به‌گرد یک‌گلستان‌گل %~% وزان ‌برچین پرچینم نژند و ناتوان‌کردی(@)(@@) 6 نمودی چهره ماه آسمان را زآستان راندی %~% گشودی غنچه‌گنج شایگان را رایگان‌کردی(@)(@@) 7 دو جلباب ‌ازشب‌ مشکین ‌فکندی‌ بر مه‌و پروین %~% و یا درباره ماچین دو برج از قیروان‌کردی(@)(@@) 8 ز غم چون شام تاریکست روز روشنم تا تو %~% شب تاریک را بر روز روش سایبان ‌کردی(@)(@@) 9 ز چین‌گیسوی‌مشکین فکندی رخنه‌ام در دین %~% جزاک ‌الله خیرا کز زره کار سنان‌ کردی(@)(@@) 10 ز بس نامهربانی با من ای آرام جان‌کردی %~% فلک را با همه نامهربانی مهربان‌کردی(@)(@@) 11 نگارا دلبرا یارا دلاراما وفادارا %~% خجل زین نامهابادی که ما را بی‌نشان‌کردی(@)(@@) 12 پری بگریزد از آهن تو ای ماه پری‌چهره %~% چرا یکپاره آهن را نهان در پرنیان‌ کردی(@)(@@) 13 سرینت ازکمر پیدا میانت درکمر پنهان %~% به‌ نقدت‌ کوه‌ سیمی‌ هست‌ اگر مویی‌ زیان کردی(@)(@@) 14 فکندی بر سرین از پس دو بویا سنبل مشکین %~% به نام زورقی را کز دو لنگر بادبان ‌کردی(@)(@@) 15 در اول ارغوانم را نمودی زعفران وآخر %~% ز خون دیده و دل زعفرانم ارغوان کردی(@)(@@) 16 سیه‌شد رویت ‌از خط‌ وین ‌خطا زان‌ زلفکال سر زد %~% که صد ره در سیه‌ کاری مر او را امتحان ‌کردی(@)(@@) 17 چه دهقانی که‌ گه در زعفرانم ارغوان ‌کشتی %~% چه صباغی‌ که گاه از ارغوانم زعفران کردی(@)(@@) 18 نگفتم 
