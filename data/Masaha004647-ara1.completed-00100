ms81	(@)(@)(@@) ق [جخ] كوفي ثقة.(@)(@)(@@)(@@)(@@) $ 1096 عمرو بن الحمق(@)(@)(@@) صاحب رسول الله (صلى الله عليه وآله وسلم)(@)(@)(@@) شهد له الحسين (عليه السلام) بالصلاح والعبادة(@)(@)(@@) ل، ى، ن [جخ، كش].(@)(@)(@@)(@@)(@@) $ 1097 عمر بن حنظلة الكوفي(@)(@)(@@) العجلي ق [جخ].(@)(@)(@@)(@@)(@@) $ 1098 عمر بن خالد الحناط(@)(@)(@@) ، بالحاء المهملة والنون، لقبه الأفرق ق [جش] مولى ثقة عين.(@)(@)(@@)(@@)(@@) $ 1099 عمرو بن دينار المكي(@)(@)PageV01P258(@)(@)(@@) قر، ق [جخ] أحد أئمة التابعين فاضل.(@)(@)(@@)(@@)(@@) $ 1100 عمرو بن دينار الكوفي(@)(@)(@@) ق [جخ] مهمل.(@)(@)(@@)(@@)(@@) $ 1101 عمر بن الربيع أبو أحمد(@)(@)(@@) البصري ق [كش] ثقة.(@)(@)(@@)(@@)(@@) $ 1102 عمر بن سالم السابري(@)(@)(@@) وأخوه حفص ق [جخ، ست، جش] ثقتان.(@)(@)(@@)(@@)(@@) $ 1103 عمر بن عبد الله بن يعلى(@)(@)(@@) بن مرة الثقفي لم [جش] روى عن أبيه عن جده عن أمير المؤمنين (عليه السلام).(@)(@)(@@)(@@)(@@) $ 1104 عمرو بن عبيد الله الأزرق(@)(@)(@@) أبو علي ق [كش].(@)(@)(@@)(@@)(@@) $ 1105- 1106 عمرو بن عثمان الثقفي(@)(@)(@@) الخراز بالراء والزاء، وقيل الأزدي أبو علي لم [كش] ثقة نقي الحديث صحيح الحكايات، ومن أصحابنا من أثبته: عمرو بن غياث والأول بخط الشيخ أبي جعفر، وأما عمرو بن غياث فإنه أبو الأسود الحضرمي، ذاك من رجال الصادق (عليه السلام).(@)(@)PageV01P259(@)(@)(@@)(@@)(@@) $ 1107 عمر بن علي بن أبي طالب(@)(@)(@@) ى [جخ] معروف.(@)(@)(@@)(@@)(@@) $ 1108 عمر بن علي بن الحسين(@)(@)(@@) الأشرف ين [جخ] معروف.(@)(@)(@@)(@@)(@@) $ 1109 عمر بن محمد بن سليم(@)(@)(@@) بن البراء يكنى بأبي بكر المعروف بابن الجعابي، بالجيم المكسورة والعين المهملة والباء المفردة، والتبس على بعض الأصحاب فقال بابن المعاني والحق الأول لم [جخ] خرج إلى سيف الدولة فقربه واختص به، وكان عارفا بالرجال من العامة والخاصة.(@)(@)(@@)(@@)(@@) $ 1110 عمر بن محمد بن عبد الرحمن(@)(@)(@@) بن أذينة بن سلم بن الحارث ق [جخ، جش] شيخ من أصحابنا البصريين ووجههم، روايته مكاتبة.(@)(@)(@@)(@@)(@@) $ 1111 عمرو بن محصن(@)(@)(@@) يكنى أبا أحيحة بالمهملتين ى [جخ] أصيب بصفين وهو الذي جهز أمير المؤمنين إلى الجمل بمائة ألف درهم.(@)(@)PageV01P260(@)(@)(@@)(@@)(@@) $ 1112 عمر بن محمد بن يزيد(@)(@)(@@) أبو الأسود بياع السابري مولى ثقيف ق، م [جخ، ست، جش] ثقة جليل القدر.(@)(@)(@@)(@@)(@@) $ 1113 
ms82	 عمرو بن مروان(@)(@)(@@) [جخ، كش] كوفي ثقة خزاز، بالمعجمات.(@)(@)(@@)(@@)(@@) $ 1114 عمرو بن منهال بن مقلاص(@)(@)(@@) القيسي ق، م [كش] له ولدان أحمد والحسن من أهل الحديث.(@)(@)(@@)(@@)(@@) $ 1115- 1116 عمرو بن إلياس البجلي(@)(@)(@@) كوفي قر، ق [جخ، كش] هو أبو إلياس بن [عمرو البجلي. أيضا ابن ابن الأول ق [جش] ثقة روى عن الطاطري، وأخواه يعقوب ورقيم ثقتان].(@)(@)(@@)(@@)(@@) $ 1117 عمر بن يزيد بياع السابري(@)(@)(@@) [جخ] ثقة له كتاب.(@)(@)(@@)(@@)(@@) $ 1118 عمرو بن يزيد الثقفي(@)(@)(@@) مولاهم البزاز ق [جخ] مهمل.(@)(@)(@@)(@@)(@@) $ 1119 عمر بن يزيد بن ذبيان(@)(@)(@@) الصيقل(@)(@)PageV01P261(@)(@)(@@) أبو موسى مولى بني نهد ق [جخ، جش] ثقة.(@)(@)(@@)(@@)(@@) $ 1120 عمرو بن اليسع(@)(@)(@@) كوفي [جش] له كتاب.(@)(@)(@@)(@@)(@@) $ 1121 عمران بن إسماعيل(@)(@)(@@) قال ابن بطة: حدثنا البرقي عنه بكتابه.(@)(@)(@@)(@@)(@@) $ 1122 عمران بن الحصين(@)(@)(@@) ى [كش] من الذين رجعوا إليه.(@)(@)(@@)(@@)(@@) $ 1123 عمران بن حمران الأذرعي(@)(@)(@@) من أهل أذرعات ق [كش].(@)(@)(@@)(@@)(@@) $ 1124 عمران بن شفاء الأصبحي(@)(@)(@@) كوفي ق [كش].(@)(@)(@@)(@@)(@@) $ 1125 عمران وعيسى ابنا عبد الله(@)(@)(@@) القميان ممدوحان(@)(@)(@@) دعا أبو عبد الله (عليه السلام) لعمران حيث خاط له المضارب فقال: أسأل الله تعالى أن يصلي على محمد وآل محمد وأن يظلك وعترتك يوم لا ظل إلا ظله. وقال فيه أيضا: إن بالباب رجلا منا أهل(@)(@)PageV01P262(@)(@)(@@) البيت. ثم قال: هو منا حيا وميتا.(@)(@)(@@)(@@)(@@) $ 1126 عمران بن علي بن أبي شعبة(@)(@)(@@) أبو الفضل الحلبي ثقة لا مطعن عليه.(@)(@)(@@)(@@)(@@) $ 1127 عمران بن قطن(@)(@)(@@) ق [كش] له كتاب.(@)(@)(@@)(@@)(@@) $ 1128 عمران بن محمد بن عمران(@)(@)(@@) بن عبد الله بن سعد الأشعري القمي ضا [جخ، ست] ثقة.(@)(@)(@@)(@@)(@@) $ 1129 عمران بن مسكان أبو محمد(@)(@)(@@) [جش] كوفي ثقة.(@)(@)(@@)(@@)(@@) $ 1130 عمران بن موسى الزيتوني(@)(@)(@@) [جش] قمي ثقة.(@)(@)(@@)(@@)(@@) $ 1131 عمران بن ميثم بن يحيى(@)(@)(@@) الأسدي قر، ق [كش] مولى ثقة.(@)(@)(@@)(@@)(@@) $ 1132 العمركي بن علي بن محمد(@)(@)(@@) البوفكي، وبوفك قرية من قرى نيسابور، شيخ من أصحابنا ثقة. وكان سيدنا جمال(@)(@)PageV01P263(@)(@)(@@) الدين (قدس الله روحه) يقول: في رواية صحيحة إن اسمه علي بن البوفكي، له كتب.(@)(@)(@@)(@@)(@@) $ 1133 عنبسة بن حماد(@)(@)(@@) خير فاضل قر، 
ms83	 ق [كش].(@)(@)(@@)(@@)(@@) $ 1134 عنبسة بن بجاد(@)(@)(@@) ، بالباء المفردة، العابد مولى بني أسد كان قاضيا ق [جخ، جش] ثقة.(@)(@)(@@)(@@)(@@) $ 1135 عنبسة بن مصعب العجلي(@)(@)(@@) ق، م [جخ].(@)(@)(@@)(@@)(@@) $ 1136 عوف بن الحارث(@)(@)(@@) ى [جخ] بدري.(@)(@)(@@)(@@)(@@) $ 1137 عون بن جعفر بن أبي طالب(@)(@)(@@) ى [جخ].(@)(@)(@@)(@@)(@@) $ 1138 عون بن جرير(@)(@)(@@) ، صاحب [عمرو بن] هارون الثقفي ذكره ابن بطة [جش، ست].(@)(@)PageV01P264(@)(@)(@@)(@@)(@@) $ 1139 عون بن سالم(@)(@)(@@) [كش] ثقة قليل الحديث كوفي.(@)(@)(@@)(@@)(@@) $ 1140 عون بن عبد الله بن جعفر(@)(@)(@@) بن أبي طالب ى [جخ] استشهد مع علي (عليه السلام).(@)(@)(@@)(@@)(@@) $ 1141 العوام بن حوشب بن يزيد(@)(@)(@@) بن أديم، وبعض الأصحاب أثبته بن رويم الشيباني ق [جش] ممدوح، هو أكبر من أخيه طلاب.(@)(@)(@@)(@@)(@@) $ 1142 عيسى بن أبي منصور شلقان(@)(@)(@@) ق [جخ، كش، جش] ممدوح،(@)(@)(@@) روي أن أبا عبد الله (عليه السلام) كان يقول إذا رءاه : من أحب أن يرى رجلا من أهل الجنة فلينظر إلى هذا(@)(@)(@@) كان خيرا فاضلا. واعلم أن عيسى هذا غير ابن صبيح العرزمي وإن كان أبو منصور اسمه صبيح ولكنه غير شلقان، ومن أصحابنا من توهمه إياه والشيخ (رحمه الله) قد بين اختلافهما.(@)(@)PageV01P265(@)(@)(@@)(@@)(@@) $ 1143 عيسى بن أحمد بن عيسى(@)(@)(@@) بن المنصور أبو موسى السرمنرآئي دي [جش].(@)(@)(@@)(@@)(@@) $ 1144 عيسى بن أعين الجريري(@)(@)(@@) ، بضم الجيم والراءين المهملتين، منسوب إلى جرير بن عباد، بالضم والتخفيف، بن ضبيعة بن قيس بن ثعلبة الأسدي ق [كش] مولى كوفي ثقة، وروى عن عبيد بن عيسى بن أعين صاحب السبوب وهي الثياب البيض [من] القز.(@)(@)(@@)(@@)(@@) $ 1145 عيسى بن أحمد المدايني(@)(@)(@@) الثقفي ق [جش].(@)(@)(@@)(@@)(@@) $ 1146 عيسى بن جعفر بن عاصم(@)(@)(@@) العاصمي م [كش] ممدوح، ضرب ثلاثمائة سوط ورمي به في دجلة،(@)(@)(@@) قال محمد بن الفرج: كتبت إلى أبي الحسن (عليه السلام) أسأله عنه فدعا له.(@)(@)PageV01P266(@)(@)(@@)(@@)(@@) $ 1147 عيسى بن داود النجار(@)(@)(@@) م [جش] كوفي من أصحابنا قليل الرواية.(@)(@)(@@)(@@)(@@) $ 1148 عيسى بن راشد(@)(@)(@@) ق [جش] يعرف بأبي كازر.(@)(@)(@@)(@@)(@@) $ 1149 عيسى بن روضة(@)(@)(@@) صاحب المنصور كان متكلما جيد الكلام [جش] له كتاب في الإمامة، وصفه أحمد 
ms84	 بن أبي طاهر في كتاب بغداد.(@)(@)(@@)(@@)(@@) $ 1150 عيسى بن السري أبو اليسع(@)(@)(@@) الكرخي بغدادي ق [جش، ست، كش، جخ] مدحاه.(@)(@)(@@)(@@)(@@) $ 1151 عيسى بن صبيح العرزمي(@)(@)(@@) بالراء فالزاي ق [كش] عربي ثقة صليب.(@)(@)(@@)(@@)(@@) $ 1152 عيسى بن عبد الله بن محمد(@)(@)PageV01P267(@)(@)(@@) بن عمر بن علي بن أبي طالب لم [جش] ثقة له كتاب.(@)(@)(@@)(@@)(@@) $ 1153 عيسى بن عبد الله القمي(@)(@)(@@) ق [جخ، كش] ثقة(@)(@)(@@) ، قبل الصادق (عليه السلام) بين عينيه وقال: أنت منا.(@)(@)(@@)(@@)(@@) $ عيسى بن عبد الله بن سعد(@)(@)(@@) بن مالك الأشعري ق، م [جخ، كش، عق] كان وجها عند أبي عبد الله (عليه السلام).(@)(@)(@@)(@@)(@@) $ 1154 عيسى بن ماهان أبو جعفر(@)(@)(@@) الرازي ق [جخ].(@)(@)(@@)(@@)(@@) $ 1155 عيسى بن المستفاد أبو موسى(@)(@)(@@) البجلي الضرير قر [جخ، ست، جش] لم يكن بذلك.(@)(@)(@@)(@@)(@@) $ 1156 عيسى بن مهران المستعطف(@)(@)PageV01P268(@)(@)(@@) أبو موسى لم [جخ، ست، جش] له كتب.(@)(@)(@@)(@@)(@@) $ 1157 عيسى مولى الأنصار(@)(@)(@@) من أهل خراسان ق [جخ] خدمه (عليه السلام).(@)(@)(@@)(@@)(@@) $ 1158 عيسى بن الوليد الهمداني(@)(@)(@@) [كش] كوفي ثقة.(@)(@)(@@)(@@)(@@) $ 1159 عيسى بن هشام(@)(@)(@@) [جش] له كتاب.(@)(@)(@@)(@@)(@@) $ 1160 العيص(@)(@)(@@) ، بالعين المهملة المكسورة والياء المثناة تحت والصاد المهملة، بن القاسم هو وأخوه الربيع ابنا أخت سليمان بن خالد الأقطع ق [جخ، كش] ممدوح ثقة عين.(@)(@)(@@)(@@)(@@) || باب الغين المعجمة(@)(@@)(@@)(@@) $ 1161 غالب بن عثمان الهمداني(@)(@)(@@) الشاعر ق [جخ] كوفي يكنى أبا سلمة مهمل.(@)(@)(@@)(@@)(@@) $ 1162 غالب بن عثمان المنقري(@)(@)PageV01P269(@)(@)(@@) مولاهم السمال، بالسين المهملة واللام بمعنى الكحال ق [جخ] كوفي.(@)(@)(@@)(@@)(@@) $ 1163 غياث بن كلوب بن فيهس(@)(@)(@@) البجلي [جش، جخ] له كتاب، ذكره مهملا.(@)(@)(@@)(@@)(@@) || باب الفاء(@)(@@)(@@)(@@) $ 1164 فارس بن حاتم بن ماهويه(@)(@)(@@) القزويني [كش] شاذ الحديث.(@)(@)(@@)(@@)(@@) $ 1165 فارس بن سليمان أبو شجاع(@)(@)(@@) الأرجاني لم [كش] شيخ من أصحابنا كثير الأدب والحديث.(@)(@)(@@)(@@)(@@) $ 1166 الفاكهة بن سعد(@)(@)(@@) ى [جخ] قتل بصفين.(@)(@)(@@)(@@)(@@) $ 1167 فائد الحناط(@)(@)(@@) كوفي، قال ابن فضال: ق، م.(@)(@)(@@)(@@)(@@) $ 1168 فرج السندي(@)(@)(@@) [جش] له كتاب.(@)(@)PageV01P270(@)(@)(@@)(@@)(@@) $ 1169 الفرزدق(@)(@)(@@) ، مادح علي بن الحسين (عليهما السلام) في وجه هشام حتى حبسه ين [كش، جخ] ممدوح، يكنى أبا فراس.(@)(@)(@@)(@@)(@@) $ 1170 فضالة بن 
ms85	 أيوب الأزدي(@)(@)(@@) م، ضا [جخ، كش] عربي صميم سكن الأهواز، فقيه من فقهائهما.(@)(@)(@@)(@@)(@@) $ 1171 الفضل بن أبي قرة التميمي(@)(@)(@@) السمندي بلد من آذربايجان. انتقل إلى إرمنية ق [جش] لم يكن بذاك.(@)(@)(@@)(@@)(@@) $ 1172 الفضل بن إسماعيل(@)(@)(@@) لم [كش] ثقة من أصحابنا قليل الحديث.(@)(@)(@@)(@@)(@@) $ 1173 الفضل بن الحارث(@)(@)(@@) لم [كش] ممدوح.(@)(@)(@@)(@@)(@@) $ 1174 الفضل بن الربيع(@)(@)(@@) ق [جخ] مهمل.(@)(@)(@@)(@@)(@@) $ 1175 الفضل بن الزبير الرسان(@)(@)PageV01P271(@)(@)(@@) قر، ق [كش] ممدوح.(@)(@)(@@)(@@)(@@) $ 1176 الفضل بن سليمان الكاتب(@)(@)(@@) البغدادي كان يكتب للمنصور والمهدي على ديوان الخراج ق، م [كش] مهمل.(@)(@)(@@)(@@)(@@) $ 1177 الفضل بن سنان(@)(@)(@@) ضا [جخ] نيسابوري وكيل.(@)(@)(@@)(@@)(@@) $ 1178 الفضل بن سهل ذو الرئاستين(@)(@)(@@) ضا [جخ] مهمل.(@)(@)(@@)(@@)(@@) $ 1179 الفضل بن شاذان النيسابوري(@)(@)(@@) أبو محمد د، دي، كر [جخ، ست] متكلم فقيه جليل القدر [كش] كان أبوه من أصحاب يونس وروى عن أبي جعفر الثاني، وقيل عن الرضا (عليه السلام) أيضا وكان أحد أصحابنا الفقهاء العظام المتكلمين حاله أعظم من أن يشار إليها،(@)(@)(@@) قيل : إنه دخل على أبي(@)(@)PageV01P272(@)(@)(@@) محمد العسكري (عليه السلام) فلما أراد أن يخرج سقط عنه كتاب من تصنيفه فتناوله أبو محمد (عليه السلام) ونظر فيه وترحم عليه، وذكر أنه قال: أغبط أهل خراسان لمكان الفضل وكونه بين أظهرهم(@)(@)(@@) وكفاه بذلك فخرا. وروى الكشي ما ينافي ذلك ولا التفات إليه.(@)(@)(@@)(@@)(@@) $ 1180 الفضل بن عبد الرحمن(@)(@)(@@) لم [كش] بغدادي متكلم.(@)(@)(@@)(@@)(@@) $ 1181 الفضل بن عبد الملك أبو العباس(@)(@)(@@) البقباق، بالباءين المفردتين والقافين ق [جخ] كوفي ثقة عين.(@)(@)(@@)(@@)(@@) $ 1182 الفضل بن عثمان المرادي(@)(@)(@@) كذا رأيته في نسخ بعض أصحابنا ورأيت بخط الشيخ أبي جعفر (رحمه الله) في كتاب الرجال: الفضيل مصغرا، الكوفي أبو محمد الصائغ، بالياء المثناة تحت والغين المعجمة ق [جخ، كش] مولى ثقة وهو ابن أخت علي بن ميمون المعروف بأبي الأكراد.(@)(@)(@@)(@@)(@@) $ 1183 الفضيل بن محمد بن راشد(@)(@)(@@) مولى الفضل البقباق [قي] مولى كوفي ثقة،(@)(@)PageV01P273(@)(@)(@@) كذا رأيته في كتاب بعض الأصحاب ورأيت بخط الشيخ: الفضل مولى محمد بن راشد.(@)(@)(@@)(@@)(@@) $ 1184 الفضيل بن يسار، بالياء المثناة تحت والسين المهملة، 
ms86	 النهدي(@)(@)(@@) أخوه أبو القاسم قر، ق [جخ، كش] مات في أيام أبي عبد الله (عليه السلام) قال ابن نوح: يكنى أبا مسور [كش](@)(@)(@@) روي أن أبا عبد الله (عليه السلام) كان إذا رءاه قال: بشر المخبتين ، من أحب أن يرى رجلا من أهل الجنة فلينظر إلى هذا.(@)(@)(@@)(@@)(@@) $ الفضيل بن يسار(@)(@)(@@) [بالياء المثناة تحت] ق، دي، كر [جخ] بصري مولى ثقة.(@)(@)(@@)(@@)(@@) $ 1185 الفيض بن المختار الجعفي(@)(@)(@@) الكوفي كذا رأيته في خط الشيخ أبي جعفر (رحمه الله)، وبعض أصحابنا أثبته الخثعمي، الأول أثبت قر، ق، م [جش] وقال [كش] ق.(@)(@)PageV01P274(@)(@)(@@)(@@)(@@) || باب القاف(@)(@@)(@@)(@@) $ 1186 القاسم البرسي بن إبراهيم(@)(@)(@@) طباطبا بن إسماعيل بن إبراهيم بن الحسن بن الحسن بن علي بن أبي طالب (عليه السلام) لم [كش].(@)(@)(@@)(@@)(@@) $ 1187 القاسم بن بريد(@)(@)(@@) ، بالباء المفردة المضمومة والراء المفتوحة بن معاوية، العجلي ق، م [جخ، كش] ثقة.(@)(@)(@@)(@@)(@@) $ 1188 القاسم بن بهرام أبو همدان(@)(@)(@@) ق [جخ] قاضي هيت.(@)(@)(@@)(@@)(@@) $ 1189 القاسم بن خليفة(@)(@)(@@) لم [كش] كوفي قليل الحديث.(@)(@)(@@)(@@)(@@) $ 1190 القاسم بن الربيع(@)(@)(@@) لم [جش] [له كتاب.(@)(@)(@@)(@@)(@@) $ 1191 القاسم بن سليمان البغدادي(@)(@)(@@) لم [جش] له كتاب.(@)(@)(@@)(@@)(@@) $ 1192 القاسم بن عروة] أبو محمد(@)(@)(@@) مولى أبي أيوب الخرزي البغدادي، و(@)(@)PageV01P275(@)(@)(@@) بها مات ق [كش] كان وزير أبي جعفر المنصور ممدوح.(@)(@)(@@)(@@)(@@) $ 1193 القاسم بن عوف الشيباني(@)(@)(@@) ين [كش] ممدوح [جخ، قي] كان يختلف بين علي بن الحسين ومحمد بن الحنفية.(@)(@)(@@)(@@)(@@) $ 1194 القاسم بن الفضيل بن يسار(@)(@)(@@) النهدي البصري ق [كش، جخ] أبو أحمد ثقة، وقيل أبو محمد.(@)(@)(@@)(@@)(@@) $ 1195 القاسم بن محمد بن أبي بكر(@)(@)(@@) ين [جخ].(@)(@)(@@)(@@)(@@) $ 1196 القاسم بن محمد بن أيوب(@)(@)(@@) بن ميمون من جلة أصحابنا وليس هو كاسولا.(@)(@)(@@)(@@)(@@) $ 1197 القاسم بن محمد الجوهري(@)(@)(@@) م [كش] كوفي سكن بغداد، وقال نصر بن الصباح: لم يلق أبا عبد الله (عليه السلام)، وقيل كان واقفيا أقول: إن الشيخ ذكر القاسم(@)(@)PageV01P276(@)(@)(@@) بن محمد الجوهري في رجال الكاظم (عليه السلام) وقال: كان واقفيا، وذكر في باب من لم يرو عن الأئمة: القاسم بن محمد الجوهري روى 
ms87	 عنه الحسين بن سعيد فالظاهر أنه غيره والأخير ثقة.(@)(@)(@@)(@@)(@@) $ 1198 القاسم بن محمد الخلقاني(@)(@)(@@) لم [جخ، ست] كوفي قريب الأمر.(@)(@)(@@)(@@)(@@) $ 1199 القاسم بن محمد بن علي(@)(@)(@@) بن إبراهيم بن محمد الهمداني وكيل الناحية.(@)(@)(@@)(@@)(@@) $ 1200 القاسم بن معن بن عبد الرحمن(@)(@)(@@) بن عبد الله بن مسعود المسعودي ق [جخ] أسند عنه.(@)(@)(@@)(@@)(@@) $ 1201 القاسم بن الوليد العرشي(@)(@)(@@) عماري ق [جخ، جش] مهمل.(@)(@)(@@)(@@)(@@) $ 1202 القاسم بن هشام اللؤلؤي(@)(@)(@@) كر [جخ، كش] قال محمد بن مسعود: رأيته خيرا فاضلا روى عن الحسن بن محبوب.(@)(@)(@@)(@@)(@@) $ 1203 قتيبة بن محمد الأعشى(@)(@)(@@) المؤدب أبو محمد المقري الكوفي مولى الأزد ق [جخ] مهمل [كش] ثقة عين.(@)(@)PageV01P277(@)(@)(@@)(@@)(@@) $ 1204 قثم بن العباس بن عبد المطلب(@)(@)(@@) ل [جخ].(@)(@)(@@)(@@)(@@) $ 1205 قدامة بن مظعون(@)(@)(@@) ل [جخ] شهد بدرا.(@)(@)(@@)(@@)(@@) $ 1206 قنبر مولى أمير المؤمنين (عليه السلام)(@)(@)(@@) ى [كش] قتله الحجاج على حبه، لم يعثر له على رواته عنه.(@)(@)(@@)(@@)(@@) $ 1207 قنيز(@)(@)(@@) ، بالنون والياء المثناة تحت فالزاي، وفي نسخة بالنون فالباء المفردة تحت، وبهذا قيده الشيخ أبو جعفر بخطه، بن علي بن شاذان يكنى أبا نصر لم [جخ] روى عن أبيه عن الفضل بن شاذان وروى أيضا عن حمزة بن محمد العلوي جليل القدر.(@)(@)(@@)(@@)(@@) $ 1208 قيس بن رمانة(@)(@)(@@) قر، ق [كش] ممدوح [جخ]: قيس بن أبي مسلم الأشعري الكوفي، وأمه رمانة يكنى أبا المفضل.(@)(@)PageV01P278(@)(@)(@@)(@@)(@@) $ 1210 قيس بن سعد بن عبادة(@)(@)(@@) ل، ى، ن [كش] من جملة العشرة الذين نصروا رسول الله (صلى الله عليه وآله وسلم) [جخ] وهو ممن لم يبايع أبا بكر.(@)(@)(@@)(@@)(@@) $ 1211 قيس بن عبادة بن ثعلبة(@)(@)(@@) بن قيس البكري ى [جخ، كش] ممدوح.(@)(@)(@@)(@@)(@@) $ 1212 قيس أخو عمار الساباطي(@)(@)(@@) ثقة.(@)(@)(@@)(@@)(@@) $ 1213 قيس بن عمار بن حيان(@)(@)(@@) قريب الأمر.(@)(@)(@@)(@@)(@@) $ 1214 قيس بن عوف(@)(@)(@@) ين [كش] ممدوح.(@)(@)(@@)(@@)(@@) $ 1215 قيس بن قهدان(@)(@)(@@) لم [كش](@)(@)PageV01P279(@)(@)(@@) ممدوح.(@)(@)(@@)(@@)(@@) $ 1216 قيس بن مسهر الصيداوي(@)(@)(@@) سين [جخ].(@)(@)(@@)(@@)(@@) || باب الكاف(@)(@@)(@@)(@@) $ 1217 كافور الخادم(@)(@)(@@) م [جخ] ثقة.(@)(@)(@@)(@@)(@@) $ 1218 كثير بن طارق أبو طارق(@)(@)(@@) القنبري من ولد قنبر مولى أمير المؤمنين (عليه السلام) لم [كش] 
ms88	 روى عن زيد وغيره.(@)(@)(@@)(@@)(@@) $ 1219 كثير الطويل(@)(@)(@@) [عق] عرف هذا الأمر.(@)(@)(@@)(@@)(@@) $ 1220 كثير بن كلثمة(@)(@)(@@) ، كذا رأيته بخط الشيخ أبي جعفر في رجال الصادق (عليه السلام) أبو الحارث وقيل: أبو الفضل قر، ق [جخ، جش] كوفي ثقة.(@)(@)(@@)(@@)(@@) $ 1221 كعب بن عبد الله(@)(@)(@@) ى [جخ] حضر وقعة الجمل وصفين وغيرهما.(@)(@)(@@)(@@)(@@) $ 1222 كعب بن عبد الله(@)(@)(@@) مولى بني طرفة ق [جش، جخ] كوفي ثقة.(@)(@)PageV01P280(@)(@)(@@)(@@)(@@) $ 1223 الكلح الضبي(@)(@)(@@) ى [جخ] كان على رجالته (عليه السلام) بصفين.(@)(@)(@@)(@@)(@@) $ 1224 كليب بن معاوية بن جبلة(@)(@)(@@) الصيداوي الأسدي أبو محمد، وقيل أبو الحسين قر، ق [جخ، كش] وابنه محمد بن كليب ق [كش] إنه (عليه السلام) قال في حقه: إني أحبه ولم أره.(@)(@)(@@)(@@)(@@) $ 1225 الكميت بن زيد الأسدي(@)(@)(@@) أبو المستهل قر، ق [جخ] مات في حياة أبي عبد الله (عليه السلام) [كش](@)(@)(@@) قال له الباقر (عليه السلام) لما أورده: من لقلب متيم مستهام: لا تزال مؤيدا بروح القدس ما دمت تقول فينا.(@)(@)(@@)(@@)(@@) $ 1226 كميل بن زياد النخعي(@)(@)(@@) ى، ن [جخ] من خواصهما.(@)(@)(@@)(@@)(@@) $ 1227 كنكر(@)(@)(@@) ، بالنون والراء المهملة أبو خالد القماط وهو الكابلي ين، قر [جخ، جش] كوفي.(@)(@)PageV01P281(@)(@)(@@)(@@)(@@) $ 1228 كيسان بن كليب أبو صادق(@)(@)(@@) ى، ن، سين، ين [جخ].(@)(@)(@@)(@@)(@@) || باب اللام(@)(@@)(@@)(@@) $ 1229 لوط بن يحيى الأزدي(@)(@)(@@) يكنى أبا مخنف ى [كش] قال الشيخ أبو جعفر الطوسي: وعندي أن هذا غلط لأنه لم يلق أمير المؤمنين وإنما كان أبوه يحيى من أصحابه، ولوط بن يحيى روى عن ن، سين، ق [ست] والصحيح أن أباه كان من أصحابه (عليه السلام) وهو لم يلقه [جش] قيل إنه روى عن أبي جعفر (عليه السلام) ولم يصح.(@)(@)(@@)(@@)(@@) $ 1230 ليث بن البختري المرادي(@)(@)(@@) ، بالخاء المعجمة، وهو أبو بصير الأصغر، وقد ذكرناه في الكنى.(@)(@)(@@)(@@)(@@) || باب الميم(@)(@@)(@@)(@@) $ 1231 مالك بن أعين الجهني(@)(@)PageV01P282(@)(@)(@@) قر، ق [كش] إن القمي كان يقول: هو ابن أعين، وليس من أخوه زرارة وهو بصري.(@)(@)(@@)(@@)(@@) $ 1232 مالك بن الحارث الأشتر(@)(@)(@@) النخعي ى [جخ، كش] جليل القدر، حاله أشهر من أن ينبه عليها.(@)(@)(@@) لما 
ms89	 بلغ أمير المؤمنين (عليه السلام) موته تأوه حزينا وقال : رحم الله مالكا، وما مالك عز علي هالكا، ولو كان صخرا لكان صلدا، ولو كان جبلا لكان فندا وكأنه قد مني قدا(@)(@)(@@) ويكفيه شرفا(@)(@)(@@) قوله (عليه السلام) : لقد كان لي كما كنت للرسول (صلى الله عليه وآله وسلم).(@)(@)(@@)(@@)(@@) $ 1233 مالك بن عطية الأحمسي(@)(@)(@@) أبو الحسين البجلي الكوفي ق [جخ] ثقة.(@)(@)(@@)(@@)(@@) $ 1234 المتوكل بن عمر بن المتوكل(@)(@)(@@) لم [ست، جش] روى عن يحيى(@)(@)PageV01P283(@)(@)(@@) بن يزيد دعاء الصحيفة.(@)(@)(@@)(@@)(@@) $ 1235 مثنى الحضرمي(@)(@)(@@) لم [جش] له كتاب.(@)(@)(@@)(@@)(@@) $ 1236 مثنى بن راشد(@)(@)(@@) لم [جش] له كتاب.(@)(@)(@@)(@@)(@@) $ 1237 مثنى بن عبد السلام(@)(@)(@@) لم [كش] لا بأس به.(@)(@)(@@)(@@)(@@) $ 1238 مثنى بن الوليد الحناط(@)(@)(@@) ق [كش] مولى كوفي.(@)(@)(@@)(@@)(@@) $ 1239 محسن بن أحمد القيسي(@)(@)(@@) من موالي قيس عيلان ضا [جش].(@)(@)(@@)(@@)(@@) $ 1240 محفوظ بن نصر الهمداني(@)(@)(@@) لم [جش] كوفي ثقة.(@)(@)(@@)(@@)(@@) $ 1241 محمد بن أبي بكر همام(@)(@)(@@) بن سهل الكاتب الإسكافي لم [جش] شيخ من أصحابنا ومقدمهم عظيم المنزلة كثير الحديث.(@)(@)(@@)(@@)(@@) $ 1242 محمد بن أبي بكر(@)(@)(@@) ل، ى [جخ](@)(@)PageV01P284(@)(@)(@@) ولد في حجة الوداع وقتل بمصر سنة ثمان وثلاثين من الهجرة في خلافة علي (عليه السلام) فكان عاملا عليها من قبله خاصا به [كش] هو من جملة الخمسة الذين كانوا من أصحاب أمير المؤمنين (عليه السلام) وهم محمد بن أبي بكر، وهاشم بن عتبة بن [ربيعة] أبي وقاص المرقال وجعدة بن هبيرة المخزومي ومحمد بن أبي حذيفة بن عتبة بن ربيعة، والخامس أبو الربيع بن أبي العاص بن ربيعة صهر النبي (صلى الله عليه وآله وسلم) سلف أمير المؤمنين (عليه السلام).(@)(@)(@@)(@@)(@@) $ 1243 محمد بن أبي حذيفة بن عتبة(@)(@)(@@) المذكور ى [جخ] كان عامله على مصر [كش] من أنصاره (عليه السلام) مات في سجن معاوية على البراءة من أمير المؤمنين وسبه ولم يفعل وقابله بالعظائم، ولم يأخذه في الله لومة لائم.(@)(@)(@@)(@@)(@@) $ 1244 محمد بن أبي الحسين أبي الخطاب(@)(@)(@@) أبو جعفر الزيات الهمداني واسم أبي الخطاب زيد لم [جش] جليل من أصحابنا عظيم القدر ثقة 
ms90	 عين حسن التصانيف(@)(@)PageV01P285(@)(@)(@@) صحيح الرواية.(@)(@)(@@)(@@)(@@) $ 1245 محمد بن أبي حمزة التيملي(@)(@)(@@) ق [جخ] ثقة فاضل.(@)(@)(@@)(@@)(@@) $ 1246 محمد بن أبي حمزة ثابت(@)(@)(@@) بن أبي صفية الثمالي، بالثاء المثلثة المضمومة ق [جخ، ست] مهمل [كش] ممدوح [جش] له كتاب.(@)(@)(@@)(@@)(@@) $ 1247 محمد بن أبي سلمة بن عبد الأسد(@)(@)(@@) بن هلال بن عبد الله بن عمرو بن مخزوم ل، ى [جخ] شهد مع علي (عليه السلام) هو وأخوه سلمة وأمهما أم سلمة زوجة النبي (صلى الله عليه وآله وسلم) أتت بهما إلى علي (عليه السلام) فقالت: هما عليك صدقة فلو يصلح لي الخروج لخرجت معك وقيل: سلمة وعمرو ابنا أبي سلمة، قال ابن عقدة: هذا أصح.(@)(@)PageV01P286(@)(@)(@@)(@@)(@@) $ 1248 محمد بن أبي الصهبان عبد الجبار(@)(@)(@@) دي، كر [جخ] قمي ثقة.(@)(@)(@@)(@@)(@@) $ 1249 محمد بن أبي عمر الطبيب(@)(@)(@@) ق [جخ] روى كتاب الديات وهو منسوب إلى ظريف بن ناصح لأنه طريقه.(@)(@)(@@)(@@)(@@) $ 1250 محمد بن أبي عمير البزاز(@)(@)(@@) بياع السابري ق، ضا [جخ] ثقة [ست] يكنى أبا أحمد من موالي الأزد واسم أبي عمير زياد [بن عيسى] من أوثق الناس عند الخاصة والعامة وأنسكهم وأورعهم وأعبدهم، وقد ذكره الجاحظ في كتابه في فخر قحطان على عدنان بذلك، وذكر أنه كان أوحد أهل زمانه في الأشياء كلها أدرك من الأئمة ثلاثة: أبا إبراهيم موسى بن جعفر (عليه السلام) ولم يرو عنه، وروى عن أبي الحسن الرضا (عليه السلام)، وروى عنه أحمد بن(@)(@)PageV01P287(@)(@)(@@) محمد بن عيسى كتب مائة رجل من رجال أبي عبد الله (عليه السلام) وله مصنفات كثيرة، وذكر ابن بطة أنها أربعة وتسعون كتابا [كش، جش] حبس بعد الرضا (عليه السلام) ونهب ماله وذهب كتبه، وكان يحفظ أربعين جلدا فلذلك أرسل أحاديثه. وكان قد سعى به أنه يعرف أسماء الشيعة ومواضعهم، فأمره السلطان بتسميتهم فأبى فضرب ضربا عظيما- وقيل: كان ذلك ليلي القضاء- قال: فلما بلغ بي الضرب ذلك كدت أسميهم فسمعت نداء [محمد بن يونس بن عبد الرحمن يقول]: يا محمد بن أبي عمير! اذكر موقفك بين يدي الله! فتقويت 
ms91	 بقوله وصبرت ولم أخبرهم والحمد لله وقيل إنه أدى مائة وأحد عشرين ألف درهم حتى خلص، وكان ممولا وكان مولى بني أمية وقيل مولى المهلب بن أبي صفرة، بغدادي الأصل والمقام،(@)(@)(@@) لقي الكاظم (عليه السلام) وسمع معه أحاديث كناه في بعضها فقال (عليه السلام): يا أبا(@)(@)PageV01P288(@)(@)(@@) أحمد! تعظيما له (رحمه الله).(@)(@)(@@)(@@)(@@) $ 1251 محمد بن أبي عمران موسى(@)(@)(@@) بن علي بن عبد ربه أبو الفرج القزويني [الكاتب] لم [جش] ثقة صحيح الرواية والطريقة.(@)(@)(@@)(@@)(@@) $ 1252 محمد بن أبي القاسم عبيد الله(@)(@)(@@) بن عمران الخبابي، بالخاء المعجمة المفتوحة والباءين المفردتين، البرقي الملقب بماجيلويه وأبو القاسم ملقب بندار لم [جش] سيد من أصحابنا فقيه فاضل في الآداب والغريب وهو صهر أحمد بن أبي عبد الله البرقي على ابنته، وابنه علي بن محمد منها وكان أخذه بالأدب.(@)(@)(@@)(@@)(@@) $ 1253 محمد بن أبي يونس تسنيم(@)(@)(@@) بن الحسن بن يونس أبو طاهر الوراق الحضرمي الكوفي لم [كش] ثقة عين، حديثه صحيح روى عنه العامة والخاصة وكان وراق أبي نعيم الفضل بن دكين.(@)(@)(@@)(@@)(@@) $ 1254 محمد بن إبراهيم بن أبي البلاد(@)(@)(@@) وأخوه يحيى مولى بني عبد الله بن(@)(@)PageV01P289(@)(@)(@@) غطفان لم [جش] ثقة قليل الحديث، وأخوه يحيى أكثر حديثا منه.(@)(@)(@@)(@@)(@@) $ 1255 محمد بن إبراهيم علان(@)(@)(@@) الكليني لم [جخ] خير.(@)(@)(@@)(@@)(@@) $ 1256 محمد بن إبراهيم بن جعفر(@)(@)(@@) أبو عبد الله الكاتب النعماني المعروف بابن زينب لم [جش] شيخ من أصحابنا عظيم القدر شريف المنزلة صحيح العقيدة كثير الحديث قدم بغداد وخرج إلى الشام ومات بها.(@)(@)(@@)(@@)(@@) $ 1257 محمد بن إبراهيم بن محمد(@)(@)(@@) الهمداني لم [كش] كان أبوه وكيل أبي الحسن (عليه السلام).(@)(@)(@@)(@@)(@@) $ 1258 محمد بن إبراهيم الحضيني(@)(@)(@@) ، بالحاء المهملة المضمومة والضاد المعجمة المفتوحة والياء المثناة تحت والنون، الأهوازي د [جش، كش] ممدوح.(@)(@)(@@)(@@)(@@) $ 1259 محمد بن إبراهيم بن محمد(@)(@)(@@) بن علي بن عبد الله بن عباس بن عبد المطلب ق [جش].(@)(@)PageV01P290(@)(@)(@@)(@@)(@@) $ 1260 محمد بن إبراهيم بن يوسف(@)(@)(@@) ، وقيل بن سيف، الكاتب يكنى أبا الحسن المعروف بالشافعي لم [ست، جش] كان على الظاهر يتفقه على مذهب 
ms92	 الشافعي ويرى رأي الإمامية وكان فقيها على المذهبين.(@)(@)(@@)(@@)(@@) $ 1261 محمد بن أحمد بن أبي عوف(@)(@)(@@) لم [جخ] من أهل بخارى لا بأس به.(@)(@)(@@)(@@)(@@) $ 1262 محمد بن أحمد بن أبي قتادة(@)(@)(@@) أبو جعفر ثقة من القميين صدوق عين مولى.(@)(@)(@@)(@@)(@@) $ 1263 محمد بن أحمد بن إبراهيم(@)(@)(@@) بن سليمان، أبو الفضل الجعفي المعروف بالصابوني لم [جش] سكن مصر وكان زيديا ثم عاد إلينا وكان منزله بمصر.(@)(@)(@@)(@@)(@@) $ محمد بن أحمد بن إسماعيل(@)(@)(@@) بن بزيع م، ضا، د [كش، جخ، ست] ثقة صحيح كوفي.(@)(@)(@@)(@@)(@@) $ 1264 محمد بن أحمد بن جعفر(@)(@)(@@) القمي العطار كر [جخ] كان وكيله [كش] ليس(@)(@)PageV01P291(@)(@)(@@) له ثالث في الأرض.(@)(@)(@@)(@@)(@@) $ 1265 محمد بن أحمد بن الجنيد(@)(@)(@@) يكنى أبا علي لم [جخ] كان جيد التصنيف [حسنه] إلا أنه كان يرى القول بالقياس فتركت كتبه لذلك ولم يتعول عليها [جش]، سمعت بعض شيوخنا يذكر أنه كان عنده مال للصاحب (عليه السلام) وسيف.(@)(@)(@@)(@@)(@@) $ محمد بن أحمد بن الحارث(@)(@)(@@) الخطيب بساوة لم [جخ] له كتاب في الإمامة.(@)(@)(@@)(@@)(@@) $ 1266 محمد بن أحمد بن حماد(@)(@)(@@) المروزي المحمودي د [كش] ممدوح.(@)(@)(@@)(@@)(@@) $ 1267 محمد بن أحمد بن خاقان(@)(@)(@@) النهدي أبو جعفر القلانسي [كش] كوفي خير [غض] ضعيف، وسيأتي في الضعفاء.(@)(@)(@@)(@@)(@@) $ 1268 محمد بن أحمد بن داود(@)(@)(@@) القمي لم [جش] شيخ هذه الطائفة وعالمها وشيخ القميين في وقته وفقيههم، حكى أبو عبد الله الحسين بن عبيد الله أنه لم ير [أحدا] أحفظ ولا أفقه(@)(@)PageV01P292(@)(@)(@@) منه، ولا أعرف بالحديث. ورد بغداد فأقام بها وحدث [ست] يكنى أبا الحسن، له كتب، مات سنة ثمان وستين وثلاثمائة ودفن بمقابر قريش.(@)(@)(@@)(@@)(@@) $ 1269 محمد بن أحمد بن روح(@)(@)(@@) ، بفتح الراء، الطرسوسي كذلك لم [جش] أبو أحمد، له كتاب.(@)(@)(@@)(@@)(@@) $ 1270 محمد بن أحمد بن عبد الله(@)(@)(@@) بن مهران بن خانبة، بالخاء المعجمة والنون والباء المفردة، الكرخي لم [جش] لوالده مكاتبة إلى الرضا (عليه السلام).(@)(@)(@@)(@@)(@@) $ 1271 محمد بن أحمد بن عبد الله(@)(@)(@@) أبو عبد الله البصري الملقب بالمفجع لم [جش] جليل من وجوه أهل الأدب واللغة والحديث، صحيح المذهب 
ms93	 حسن الاعتقاد، له شعر كثير في أهل البيت (عليهم السلام) يتفجع عليهم، ولذلك سمي المفجع. ومن شعره:(@)(@)(@@) إن يكن قيل لي المفجع نبزا %~% فلعمري أنا المفجع هما(@)(@)(@@)(@@)(@@) $ 1272 محمد بن أحمد بن عبد الله(@)(@)(@@) بن(@)(@)PageV01P293(@)(@)(@@) قضاعه بن صفوان بن مهران الجمال المعروف بالصفواني أبو عبد الله لم [جخ، ست] له مصنفات كثيرة وهو خاصي، وقيل إنه كان أميا، له كتب أملاها من ظهر قلبه ثقة ثقة. بأهل قاضي الموصل في الإمامة بين يدي ابن حمدان، فحم قاضي الموصل من ساعته وانفلج كفه التي بأهله بها واسودت ومات من الغد، فعظمت منزلة أبي عبد الله الصفواني عند الملوك بذلك [غض] فيه كلام يأتي في الضعفاء. ولست أتردد في ثقته، وأمره ظاهر لا يؤثر فيه تردد الغضائري، ولو لم يكن له إلا مباهلته لقاضي [الموصل] في الإمامة وهلاك القاضي من الغد واسوداد كفه التي بأهله بها.(@)(@)(@@)(@@)(@@) $ 1273 محمد بن أحمد بن عبيد الله(@)(@)(@@) بن محمد بن عيسى بن المنصور عباسي هاشمي يكنى أبا الحسن لم [جخ] روى عن عمه أبي موسى عيسى بن أحمد بن عيسى بن المنصور عن أبي محمد صاحب العسكر(@)(@)PageV01P294(@)(@)(@@) معجزات ودلائل.(@)(@)(@@)(@@)(@@) $ 1274 محمد بن أحمد بن علي(@)(@)(@@) الفتال النيسابوري المعروف بابن الفارسي أبو علي لم [جخ] متكلم جليل القدر فقيه عالم زاهد ورع قتله أبو المحاسن عبد الرزاق رئيس نيشابور الملقب بشهاب الإسلام.(@)(@)(@@)(@@)(@@) $ 1275 محمد بن أحمد(@)(@)(@@) يكنى أبا الحسين الزاهد من أهل طوس لم [جخ].(@)(@)(@@)(@@)(@@) $ 1276 محمد بن أحمد بن قيس(@)(@)(@@) بن عيلان ضا [جخ] كوفي ثقة له كتاب.(@)(@)(@@)(@@)(@@) $ 1277 محمد بن أحمد النعيمي(@)(@)(@@) أبو المظفر لم [جش] أخباري من أصحابنا.(@)(@)(@@)(@@)(@@) $ 1278 محمد بن [أحمد بن] محمد(@)(@)(@@) أبو جعفر الجريري، بالجيم المضمومة والراءين المهملتين قبل الياء المثناة تحت وبعدها، المعروف بابن البصري لم [جش] رجل من أصحابنا له رواية.(@)(@)(@@)(@@)(@@) $ 1279 محمد بن أحمد بن محمد(@)(@)(@@) بن(@)(@)PageV01P295(@)(@)(@@) الحارث أبو الحسين الخطيب بساوة المعروف بالحارثي لم [جش] وجه من أصحابنا ثقة.(@)(@)(@@)(@@)(@@) $ 1280 محمد بن أحمد بن محمد(@)(@)(@@) بن رجا 
ms94	 البجلي أبو جعفر لم [جش] كوفي سكن طاقات عرينة.(@)(@)(@@)(@@)(@@) $ 1281 محمد بن أحمد بن محمد(@)(@)(@@) بن سعيد بن عقدة الهمداني يكنى أبا نعيم لم [جش] جليل القدر عظيم الحفظ.(@)(@)(@@)(@@)(@@) $ 1282 محمد بن أحمد بن محمد(@)(@)(@@) بن عبد الله بن أبي الثلج لم [جخ، ست] بغدادي خاصي يكنى أبا بكر له كتاب التنزيل في أمير المؤمنين (عليه السلام).(@)(@)(@@)(@@)(@@) $ 1283 محمد بن أحمد بن نعيم(@)(@)(@@) الشاذاني، بالشين والذال المعجمتين والنون، لم [كش] قال محمد: اجتمع عندي مال الغريم فأنفذت به إليه وزدته من مالي(@)(@)PageV01P296(@)(@)(@@) فورد الجواب: وقد وصل إلي ما أنفذته إلي [من] خاصة مالك وهو كذا وكذا تقبل الله منك ممدوح.(@)(@)(@@)(@@)(@@) $ 1284 محمد بن أحمد بن يحيى(@)(@)(@@) الأشعري لم [جخ] صاحب نوادر الحكمة [ست] جليل القدر كثير الرواية لكن قيل: إنه كان لا يبالي عمن روى.(@)(@)(@@)(@@)(@@) $ 1285 محمد بن إسحاق(@)(@)(@@) صاحب الشقاق ق [جخ] كوفي.(@)(@)(@@)(@@)(@@) $ 1286 محمد بن إسحاق بن عمار(@)(@)(@@) بن حيان التغلبي، بالتاء المثناة فوق والغين المعجمة، الصيرفي لم [جش] ثقة عين [يه] واقفي.(@)(@)(@@)(@@)(@@) $ 1287 محمد بن إسحاق شعر، بالشين المعجمة والعين المهملة المفتوحتين(@)(@)(@@) ، ضا [كش] ممدوح.(@)(@)(@@)(@@)(@@) $ 1288 محمد بن [إسحاق بن] يسار(@)(@)(@@) المدني قر، ق [جخ] أسند عنه يكنى أبا بكر صاحب المغازي من سبي عين التمر وهو(@)(@)PageV01P297(@)(@)(@@) أول سبي دخل المدينة، وقيل كنيته أبو عبد الله.(@)(@)(@@)(@@)(@@) $ 1289 محمد بن إسماعيل بن أحمد(@)(@)(@@) بن بشير البرمكي المعروف بصاحب الصومعة أبو عبد الله لم [جش] سكن قم وليس أصله منها، ذكر ذلك أبو العباس بن نوح وكان ثقة مستقيما، وضعفه الغضائري، والثقة أرجح.(@)(@)(@@)(@@)(@@) $ 1290 محمد بن إسماعيل بن بزيع(@)(@)(@@) بالباء المفردة والزاء المعجمة، أبو جعفر مولى المنصور أبي جعفر [كش] كان من صالحي هذه الطائفة وثقاتهم كثير العمل.(@)(@)(@@)(@@)(@@) $ 1291 محمد بن إسماعيل الجعفري(@)(@)(@@) لم [ست، جش] له كتاب.(@)(@)(@@)(@@)(@@) $ 1292 محمد بن إسماعيل بن خيثم(@)(@)(@@) الكناني لم [جش].(@)(@)(@@)(@@)(@@) $ 1293 محمد بن إسماعيل بن ميمون(@)(@)(@@) الزعفراني أبو عبد الله لم [كش] ثقة عين(@)(@)PageV01P298(@)(@)(@@) روى عن الثقات ولقي أصحاب أبي عبد الله 
ms95	 (عليه السلام).(@)(@)(@@)(@@)(@@) $ 1294 محمد بن أصبغ الهمداني(@)(@)(@@) [ست] كوفي له كتاب.(@)(@)(@@)(@@)(@@) $ 1295 محمد بن بدران بن عمران(@)(@)(@@) أبو جعفر الرازي سكن الكوفة وجاور بقية عمره، يسكن إلى روايته وهو عين.(@)(@)(@@)(@@)(@@) $ 1296 محمد بن بديل بن ورقاء(@)(@)(@@) ل، ى [جخ] عداده في الكوفيين، أصله حجازي نزل الكوفة هو وأخوه عبد الله، قتلا معه بصفين، وهما رسولا رسول الله (صلى الله عليه وآله وسلم) وكان النبي (صلى الله عليه وآله وسلم) [كتب] إلى أبيهما بديل بن ورقاء.(@)(@)(@@)(@@)(@@) $ 1297 محمد بن بشر السوسنجردي(@)(@)(@@) ، بالسين المهملة قبل الواو وبعدها والنون والجيم والراء والدال المهملتين، ومن أصحابنا من قال عوض النون التاء المثناة فوق، وعوض الراء الزاء، وهو وهم. ويعرف بالحمدوني لم [جخ] له(@)(@)PageV01P299(@)(@)(@@) كتاب في الإمامة [كش] متكلم صحيح الاعتقاد، حج على قدميه خمسين حجة.(@)(@)(@@)(@@)(@@) $ 1298 محمد بن بشير(@)(@)(@@) لم [كش] هو وأخوه علي ثقتان كوفي مات بقم.(@)(@)(@@)(@@)(@@) $ محمد بن بكران بن عمران(@)(@)(@@) أبو جعفر الرازي لم [كش] سكن الكوفة وجاور بقية عمره، عين من الأعيان مسكون إليه.(@)(@)(@@)(@@)(@@) $ 1299 محمد بن بندار بن عاصم(@)(@)(@@) الذهلي القمي لم [جخ] ثقة عين.(@)(@)(@@)(@@)(@@) $ 1300 محمد بن البهلول(@)(@)(@@) لم [جش] كوفي له كتاب.(@)(@)(@@)(@@)(@@) $ 1301 محمد بن تميم النهشلي(@)(@)(@@) التميمي البصري لم [جش] له كتاب.(@)(@)(@@)(@@)(@@) $ 1302 محمد بن ثوابا(@)(@)(@@) ، بالثاء المثلثة والباء المفردة لم [جش] كوفي ثقة قليل الحديث.(@)(@)(@@)(@@)(@@) $ 1303 محمد بن جبرئيل الأهوازي(@)(@)(@@) لم [كش] له كتاب.(@)(@)(@@)(@@)(@@) $ 1304 محمد بن جبير بن مطعم(@)(@)PageV01P300(@)(@)(@@) ين [جخ، كش]: لم يكن في زمن علي بن الحسين (عليه السلام) في أول أمره إلا خمسة، ذكر من جملتهم [محمد بن جبير].(@)(@)(@@)(@@)(@@) $ 1305 محمد بن جرير، بالجيم والراءين المهملتين، بن محمد(@)(@)(@@) بن رستم الطبري الآملي، أبو جعفر لم [جخ، ست، جش] جليل من أصحابنا كثير العلم حسن الكلام ثقة في الحديث صاحب كتاب المسترشد في الإمامة، (رحمه الله) وهو غير صاحب التاريخ ذاك عامي.(@)(@)(@@)(@@)(@@) $ 1306 محمد بن جزك(@)(@)(@@) ، بالجيم والزاء، الجمال دي ثقة.(@)(@)(@@)(@@)(@@) $ 1307 محمد بن جعفر بن أحمد(@)(@)(@@) بن بطة المؤدب أبو جعفر 
ms96	 القمي لم [جش] كبير المنزلة بقم كثير الأدب والفضل والعلم يتساهل في الحديث ويعلق الأسانيد بالإجازة وفي فهرست ما رواه غلط كثير، كان ابن الوليد يقول: كان مخلطا ضعيفا.(@)(@)(@@)(@@)(@@) $ 1308 محمد بن جعفر بن أبي طالب(@)(@)PageV01P301(@)(@)(@@) ل، ى، سين [جخ] قدم على علي (عليه السلام) الكوفة قتل بكربلاء.(@)(@)(@@)(@@)(@@) $ 1309 محمد بن جعفر بن محمد(@)(@)(@@) بن الفتح الهمداني المعروف بالمراغي لم [كش] كان عالما بالأدب متكلما صحيح الرواية فيما نقله، وكان أبو الحسن السمسمي أحد غلمانه.(@)(@)(@@)(@@)(@@) $ 1310 محمد بن جعفر الأسدي(@)(@)(@@) الرازي لم [جخ] يكنى أبا الحسين كان أحد الأبواب.(@)(@)(@@)(@@)(@@) $ محمد بن جعفر الأسدي(@)(@)(@@) لم [ست] له كتاب الرد على أهل الاستطاعة.(@)(@)(@@)(@@)(@@) $ محمد بن جعفر بن محمد(@)(@)(@@) بن عون الأسدي أبو الحسين الكوفي ساكن الري يقال له محمد بن أبي عبد الله لم [جش] كان ثقة صحيح الحديث غير أن فيه طعنا أوجب ذكره في الضعفاء.(@)(@)PageV01P302(@)(@)(@@)(@@)(@@) $ 1311 محمد بن جعفر(@)(@)(@@) ضا [جخ] ابن عمه (عليه السلام).(@)(@)(@@)(@@)(@@) $ 1312 محمد بن جعفر بن محمد(@)(@)(@@) بن عبد الله النحوي أبو بكر المؤدب لم [كش] عالم بالعربية والحديث.(@)(@)(@@)(@@)(@@) $ 1313 محمد بن جعفر بن محمد(@)(@)(@@) بن علي بن الحسين يلقب ديباجة لم [جش] له نسخة.(@)(@)(@@)(@@)(@@) $ 1314 محمد بن جميل بن صالح(@)(@)(@@) الأسدي لم [كش] عربي صميم ثقة.(@)(@)(@@)(@@)(@@) $ 1315 محمد الحداد(@)(@)(@@) صاحب المعلى بن خنيس لم [جش] له كتاب.(@)(@)(@@)(@@)(@@) $ 1316 محمد بن حرب الهلالي(@)(@)(@@) ق [جخ] أمير مكة.(@)(@)(@@)(@@)(@@) $ 1317 محمد بن الحسن بن أبي سارة(@)(@)(@@) أبو جعفر مولى الأنصار يعرف بالرواسي قر، ق [كش] أصله كوفي سكن هو وأبوه قبله النيل.(@)(@)PageV01P303(@)(@)(@@)(@@)(@@) $ 1318 محمد بن الحسين بن أبي الخطاب(@)(@)(@@) أبو جعفر الزيات، واسم أبي الخطاب زيد الهمداني بالمهملة د، دي [جخ] ثقة.(@)(@)(@@)(@@)(@@) $ 1319 محمد بن الحسن بن أحمد(@)(@)(@@) بن الوليد أبو جعفر شيخ القميين وفقيههم ومتقدمهم لم [جش] يقال له نزيل قم ولم يكن أصله منها ثقة ثقة عين.(@)(@)(@@)(@@)(@@) $ 1320 محمد بن الحسن بن حمزة(@)(@)(@@) الجعفري أبو يعلى لم [جش] خليفة الشيخ أبي عبد الله بن النعمان المفيد، 
ms97	 متكلم فقيه مات (رحمه الله) يوم السبت سادس شهر رمضان سنة ثلاث وستين وأربعمائة ودفن في داره.(@)(@)(@@)(@@)(@@) $ 1321 محمد بن الحسن بن زياد(@)(@)(@@) العطار لم [كش] كوفي ثقة.(@)(@)PageV01P304(@)(@)(@@)(@@)(@@) $ 1322 محمد بن الحسن بن زياد(@)(@)(@@) الميثمي الأسدي مولاهم أبو جعفر ضا [كش] ثقة عين.(@)(@)(@@)(@@)(@@) $ 1323 محمد بن [حسين بن] سفرجلة(@)(@)(@@) أبو الحسن الخزاز، بالخاء والزايين المعجمات، الكوفي لم [جش] ثقة عين من أصحابنا واضح الرواية.(@)(@)(@@)(@@)(@@) $ 1324 محمد بن الحسين بن سعيد(@)(@)(@@) بن عبد الله بن سعيد الطبري يكنى أبا جعفر لم [جخ] خاصي.(@)(@)(@@)(@@)(@@) $ 1325 محمد بن الحسن الصيرفي(@)(@)(@@) لم [ست] له كتاب التحريف والتبديل مهمل.(@)(@)(@@)(@@)(@@) $ محمد بن الحسن الصفار(@)(@)(@@) كر [جخ، ست] له كتب مثل كتب الحسين بن سعيد وزيادة.(@)(@)(@@)(@@)(@@) $ 1326 محمد بن الحسن بن عبد الله(@)(@)(@@) بن الحسن بن محمد بن الحسن بن محمد بن(@)(@)PageV01P305(@)(@)(@@) عبد الله بن الحسين بن علي بن الحسين بن علي بن أبي طالب الجواني أبو عبد الله لم [كش] ساكن آمل طبرستان كان فقيها وسمع الحديث.(@)(@)(@@)(@@)(@@) $ 1327 محمد بن الحسن بن علي(@)(@)(@@) الطوسي أبو جعفر شيخ الطائفة وعمدتها، (قدس الله روحه) لم أوضح من أن يوضح حاله، ولد في شهر رمضان سنة خمس وثمانين وثلاثمائة، وقدم العراق سنة ثمان وأربعمائة وتوفي ليلة الإثنين ثاني عشر المحرم من سنة ستين وأربعمائة بالمشهد الشريف الغروي ودفن بداره.(@)(@)(@@)(@@)(@@) $ 1328 محمد بن الحسن بن علي(@)(@)(@@) أبو المثنى لم [كش] كوفي ثقة عظيم المنزلة في أصحابنا.(@)(@)(@@)(@@)(@@) $ 1329 محمد بن الحسن بن علي(@)(@)(@@) بن شاذان أبو الحسن لم [جخ] فاضل جليل القدر.(@)(@)(@@)(@@)(@@) $ 1330 محمد بن الحسن بن علي(@)(@)(@@) أبو عبد الله المحاربي، بالحاء المهملة والراء(@)(@)PageV01P306(@)(@)(@@) والباء المفردة، جليل من أصحابنا عظيم القدر عالم بأمور أصحابنا وأنسابهم.(@)(@)(@@)(@@)(@@) $ 1331 محمد بن الحسن بن فروخ، بالفاء المفتوحة والراء والخاء المعجمة(@)(@)(@@) ، الصفار، مولى عيسى بن موسى بن طلحة بن عبد الله بن السائب بن مالك بن عامر الأشعري أبو جعفر الأعرج لم [جش] كان وجها في أصحابنا القميين ثقة عظيم القدر راجحا قليل السقط في 
ms98	 الرواية، توفي بقم سنة سبعين ومائتين.(@)(@)(@@)(@@)(@@) $ 1332 محمد بن الحسين بن موسى(@)(@)(@@) بن محمد بن موسى بن إبراهيم بن موسى بن جعفر بن محمد بن علي بن الحسين بن علي بن أبي طالب (عليهم السلام) أبو الحسن الرضي نقيب العلويين ببغداد، أخو سيدنا المرتضى علم الهدى، حاله أشهر من أن يخفى. كان ميلاده سنة تسع وخمسين وثلاثمائة، و(@)(@)PageV01P307(@)(@)(@@) توفي في السادس من المحرم سنة ست وأربعمائة لم [جش].(@)(@)(@@)(@@)(@@) $ 1333 محمد بن الحسن القمي(@)(@)(@@) لم [جش] وليس بابن الوليد إلا أنه نظيره روى عن جميع مشايخه.(@)(@)(@@)(@@)(@@) $ محمد بن الحسن بن أحمد(@)(@)(@@) بن الوليد القمي جليل القدر بصير بالفقه ثقة.(@)(@)(@@)(@@)(@@) $ 1334 محمد بن الحسن الواسطي(@)(@)(@@) ق [جخ، كش، عق، فش] كان كريما على أبي جعفر وأبي الحسن (عليهما السلام) أنفذ نفقته في مرضه وكفنه وأقام مأتمه عند موته.(@)(@)(@@)(@@)(@@) $ 1335 محمد بن حفص بن عمرو(@)(@)(@@) أبو جعفر وهو ابن العمري كر [جخ] وكيل.(@)(@)(@@)(@@)(@@) $ 1336 محمد بن الحكيم الخثعمي(@)(@)(@@) أبو جعفر م [كش] كان يناظر الناس بالمدينة و(@)(@)PageV01P308(@)(@)(@@) يسأله أبو الحسن موسى (عليه السلام) فيخبره فيرضى بمناظرته.(@)(@)(@@)(@@)(@@) $ 1337 محمد بن حماد بن زيد(@)(@)(@@) الحارثي، بالحاء المهملة والراء والثاء المثلثة، أبو عبد الله لم [كش] ثقة، روى أبوه عن الصادق (عليه السلام).(@)(@)(@@)(@@)(@@) $ 1338 محمد بن حمران النهدي(@)(@)(@@) أبو جعفر ق [كش] ثقة كوفي الأصل نزل جرجرايا، وليس بابن أعين.(@)(@)(@@)(@@)(@@) $ 1339 محمد بن حمران بن أعين(@)(@)(@@) ، مولى بني شيبان ق [جخ] مهمل.(@)(@)(@@)(@@)(@@) $ 1340 محمد بن خالد البرقي(@)(@)(@@) أبو عبد الله مولى أبي موسى الأشعري م، ضا [جخ، ست] ثقة [غض]: حديثه يعرف وينكر يروي عن الضعفاء كثيرا.(@)(@)(@@)(@@)(@@) $ 1341 محمد بن خالد الأحمسي(@)(@)(@@) البجلي لم [كش] كوفي ثقة.(@)(@)PageV01P309(@)(@)(@@)(@@)(@@) $ 1342 محمد بن خالد الأصم(@)(@)(@@) لم [جش] كذا.(@)(@)(@@)(@@)(@@) $ 1343 محمد بن خالد الأشعري(@)(@)(@@) لم [جش] قمي قريب الأمر.(@)(@)(@@)(@@)(@@) $ 1344 محمد بن الخليل بن أسد(@)(@)(@@) الثقفي، وقيل النخعي لم [كش] كوفي من أصحابنا ثقة يكنى أبا عبد الله.(@)(@)(@@)(@@)(@@) $ 1345 محمد بن خليل بن جعفر(@)(@)(@@) المعروف بالسكاك، صاحب هشام بن الحكم 
ms99	 وتلميذه لم [ست] وكان متكلما، وخالف هشاما في أشياء لا في أصل الإمامة، له كتب [جخ] إمامي [جش] له كتاب في التشبيه.(@)(@)(@@)(@@)(@@) $ 1346 محمد بن خلف، أبو بكر(@)(@)(@@) الرازي لم [كش] متكلم جليل من أصحابنا.(@)(@)(@@)(@@)(@@) $ 1347 محمد بن الريان(@)(@)(@@) ، بالراء والياء المثناة تحت والنون، بن الصلت الأشعري القمي دي [جخ] كر [جش] له مسائل عنه ثقة.(@)(@)PageV01P310(@)(@)(@@)(@@)(@@) $ 1348 محمد بن زرارة بن أعين(@)(@)(@@) الشيباني ق [جخ] مهمل.(@)(@)(@@)(@@)(@@) $ 1349 محمد بن زرقان(@)(@)(@@) صاحب موسى بن جعفر (عليه السلام)، بن الجوان، صاحب جعفر بن محمد (عليه السلام) لم [جش] كذا وجدت.(@)(@)(@@)(@@)(@@) $ 1350 محمد بن زكريا بن دينار(@)(@)(@@) مولى بني غلاب أبو عبد الله وبنو غلاب قبيلة بالبصرة من بني نصر بن معاوية لم [جش] قيل: إنه ليس بغير البصرة منهم أحد، كان وجها من وجوه أصحابنا بالبصرة أخباريا واسع العلم. مات سنة ثمان وتسعين ومائتين.(@)(@)(@@)(@@)(@@) $ 1351 محمد بن زياد العطار(@)(@)(@@) لم [كش] ثقة روى أبوه عن أبي عبد الله (عليه السلام).(@)(@)(@@)(@@)(@@) $ 1352 محمد بن زيد الرزامي(@)(@)(@@) خادم الرضا (عليه السلام) ضا [جش].(@)(@)(@@)(@@)(@@) $ 1353 محمد بن سالم بن أبي سلمة(@)(@)(@@) الكندي السجستاني لم [جش] مهمل(@)(@)PageV01P311(@)(@)(@@) [كش] مدحه.(@)(@)(@@)(@@)(@@) $ 1354 محمد بن سالم بن شريح(@)(@)(@@) ، بالشين المعجمة والحاء المهملة، الأشجعي، بالشين المعجمة، الكوفي ق [جخ] ثقة يكنى أبا إسماعيل، ويقال سالم الحذاء الكوفي الأشجعي وسالم بن أبي واصلة ثقة.(@)(@)(@@)(@@)(@@) $ 1355 محمد بن السائب الكلبي(@)(@)(@@) قر، ق [جخ] مهمل.(@)(@)(@@)(@@)(@@) $ 1356 محمد بن سعيد بن عقيل(@)(@)(@@) بن أبي طالب سين [جخ].(@)(@)(@@)(@@)(@@) $ 1357 محمد بن سعيد بن غزوان(@)(@)(@@) لم [جش] له كتاب.(@)(@)(@@)(@@)(@@) $ 1358 محمد بن سعيد بن كلثوم(@)(@)(@@) المروزي دي [جخ] كان متكلما [كش] كان من جملة المتكلمين بنيشابور. وذكر أبو عبد الله علي الجرجاني أن محمد بن سعيد كان خارجيا ثم تشيع بعد مبايعته(@)(@)PageV01P312(@)(@)(@@) على الخروج بالسيف.(@)(@)(@@)(@@)(@@) $ 1359 محمد بن سعيد الكشي(@)(@)(@@) أبو الحسن لم [جخ] مستقيم المذهب.(@)(@)(@@)(@@)(@@) $ 1360 محمد بن سكين بن عمار(@)(@)(@@) النخعي الجمال لم [كش] روى أبوه عن أبي عبد الله (عليه السلام) ومن أصحابنا 
ms100	 من قال إنه روى عن أصحاب أبي عبد الله (عليه السلام) ولم أجده في رجاله.(@)(@)(@@)(@@)(@@) $ 1361 محمد بن سليمان الأسدي(@)(@)(@@) الكوفي ق [جخ].(@)(@)(@@)(@@)(@@) $ 1362 محمد بن سلمة بن أرتبيل(@)(@)(@@) أبو جعفر اليشكري لم [كش] جليل من أصحابنا الكوفيين عظيم.(@)(@)(@@)(@@)(@@) $ 1363 محمد بن سليمان بن الحسن(@)(@)(@@) بن الجهم بن بكير بن أعين، أبو طاهر الزراري كر [كش] حسن الطريقة ثقة عين، له إلى مولانا أبي محمد (عليه السلام) مسائل و(@)(@)PageV01P313(@)(@)(@@) جوابات [مات] سنة إحدى وثلاثمائة. وبعض أصحابنا أثبته الرازي وهو غلط، إنما هو الزراري.(@)(@)(@@)(@@)(@@) $ 1364 محمد بن سليمان بن رجاء(@)(@)(@@) الأنصاري مولاهم ق [جخ].(@)(@)(@@)(@@)(@@) $ 1365 محمد بن سليمان بن سويد(@)(@)(@@) الكلابي الجعفري أبو عمرو ق [جخ] مهمل.(@)(@)(@@)(@@)(@@) $ 1366 محمد بن سليمان بن عبد الله(@)(@)(@@) الأزرق ق [جخ].(@)(@)(@@)(@@)(@@) $ 1367 محمد بن سليمان بن عبد الله(@)(@)(@@) الأصبهاني الكوفي ثقة ق [جخ] مهمل [كش].(@)(@)(@@)(@@)(@@) $ 1368 محمد بن سليمان بن عثمان(@)(@)(@@) ق [جخ] مهمل.(@)(@)(@@)(@@)(@@) $ 1369 محمد بن سليمان بن عطية(@)(@)(@@) الهمداني ق [جخ] كوفي مهمل.(@)(@)(@@)(@@)(@@) $ 1370 محمد بن سليمان بن ظريف(@)(@)(@@) الهاشمي ق [جخ].(@)(@)(@@)(@@)(@@) $ 1371 محمد بن سليمان بن عمار(@)(@)(@@) أبو عمارة ق [جخ] مهمل.(@)(@)(@@)(@@)(@@) $ 1372 محمد بن سليمان القمي(@)(@)PageV01P314(@)(@)(@@) ق [جخ] مهمل.(@)(@)(@@)(@@)(@@) $ 1373 محمد بن سليمان بن مسلم(@)(@)(@@) أبو زينبة ق [جخ] مهمل.(@)(@)(@@)(@@)(@@) $ 1374 محمد بن سماعة بن موسى(@)(@)(@@) بن رويد، بالراء المضمومة، بن نشيط، بالنون والشين المعجمة، الحضرمي مولى عبد الجبار بن وائل بن حجر، أبو عبد الله والد الحسن وإبراهيم وجعفر وجد معلى بن الحسن لم [جش] كان ثقة في أصحابنا وجها.(@)(@)(@@)(@@)(@@) $ 1375 محمد بن سماعة العنزي(@)(@)(@@) الكوفي ق [جخ] مهمل.(@)(@)(@@)(@@)(@@) $ 1376 محمد بن سنان أبو جعفر(@)(@)(@@) الزاهري من ولد زاهر مولى عمرو بن الحمق الخزاعي وهو محمد بن الحسن بن سنان مات أبوه الحسن وهو طفل وكفله جده فنسب إليه ضا [جش] وقال [كش]:(@)(@)PageV01P315(@)(@)(@@) م، ضا [ست]: محمد بن سنان له كتب وقد طعن عليه وضعف وكتبه مثل كتب الحسين بن سعيد [غض]: محمد بن سنان أبو جعفر الهمداني ضعيف غال 