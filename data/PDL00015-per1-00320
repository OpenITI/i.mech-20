ms316	 عرقشان گشته‌ست همچون نیشتر(@)(@@) 58 با چنان بت کش علایی و صت کرد اندر غزل %~% خانه غم پست کرد آن کامران و نوش خور(@)(@@) 59 باز چون در بحر فکرت غوطه‌خوردی بهر نظم %~% گوهرین گردد ز بویه فضل تو در دل فکر(@)(@@) 60 هیچ فاضل در جان بی‌نثر و بی‌نظمت نراند %~% بر زبان معنی بکر و در بیان لفظ غرر(@)(@@) 61 آب از آتش گر نزاید هرگز و هرگز نزاد %~% ز آتش طبعت چرا زاده‌ست چندین شعر تر(@)(@@) 62 شعرها پیشت چنان باشد که از شهر حجاز %~% با یکی خرما کسی هجرت کند سوی هجر(@)(@@) 63 گر چه صدرت منشا شعرست و جای شاعران %~% گفتمت من نیز شعری بی تکلف ماحضر(@)(@@) 64 بوحنیفه گر چه بود اندر شریعت مقتدا %~% کس نشست از آب منسوخی سخنهای ز فر(@)(@@) 65 زاغ را با لحن بد هم بر شجر جایست از آنک %~% آشیانه بلبل تنها نباشد یک شجر(@)(@@) 66 گر چه استادان هنرمندند من شاگرد را %~% یک هنر باشد که پوشد هر چه باشد از هنر(@)(@@) 67 آب دریا گرچه بسیارست چو تلخست و شور %~% هرکرا تشنه‌ست لابد رفت باید زی شمر(@)(@@) 68 شیر از آهو گرچه افزونست لیکن گاه بوی %~% ناف آهو فضل دارد بر دهان شیر نر(@)(@@) 69 گر چه استادان من گفتند پیش از من ثنات %~% لیک پیدا نبود از پیش و پس اصل خیر و شر(@)(@@) 70 خانه آحاد پیشست از الوف اندر حساب %~% در نگر در پیشتر تا بیشتر یابی خطر(@)(@@) 71 یافتم تاثیر اقبال از برای آنکه کرد %~% اختر مدح تو اندر طالع شعرم نظر(@)(@@) 72 بیش از این تاثیر چبود کز ثناهای تو شد %~% شاه را گفت من پیش از قبولت پر درر(@)(@@) 73 ور خود از صدر تو یابم هیچ توقیع قبول %~% یافت طبعم ملک حر و شخص ملک شوشتر(@)(@@) 74 تا ز روی مایه مردم را نه از روی نسب %~% چار عنصر مادر آمد 
ms317	 هفت سیاره پدر(@)(@@) 75 باد صبح ناصحت چون روز عقبا بی‌مسا %~% باد شام حاسدت تا روز محشر بی‌سحر(@)(@@) 76 بر تو فرخ باد و شایان و مبارک این سه چیز: %~% خلعت سلطان و شعر بنده و ماه صفر(@)(@@) 77 باد امرت در زمین چون چار عنصر پیش رو %~% باد نامت در زمان چون هفت سیاره سمر PageV1P0508(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای خداوندان مال الاعتبار الاعتبار %~% ای خداخوانان قال الاعتذار الاعتذار(@)(@@) 2 پیش از آن کاین جان عذر آور فرو میرد ز نطق %~% پیش از آن کاین چشم عبرت بین فرو ماند ز کار(@)(@@) 3 پند گیرید ای سیاهیتان گرفته جای پند %~% عذر آرید ای سپیدیتان دمیده بر عذار(@)(@@) 4 ای ضعیفان از سپیدی مویتان شد همچو شیر %~% وی ظریفان از سیاهی رویتان شد همچو قار(@)(@@) 5 پرده‌تان از چشم دل برداشت صبح رستخیز %~% پنبه تا از گوش بیرون کرد گشت روزگار(@)(@@) 6 تا کی از دارالغروری ساختن دارالسرور %~% تا کی از دارالفراری ساختن دارالقرار(@)(@@) 7 در فریب آباد گیتی چند باید داشت حرص %~% چشمتان چون چشم نرگس دست چون دست چنار(@)(@@) 8 این نه آن صحراست کانجا بی جسد بینند روح %~% این نه آن بابست کآنجا بی خبر یابند بار(@)(@@) 9 از جهان نفس بگریزید تا در کوی عقل %~% آنچه غم بودست گردد مر شما را غمگسار(@)(@@) 10 در جهان شاهان بسی بودند کز گردون ملک %~% تیرشان پروین گسل بود و سنان جوزا فگار(@)(@@) 11 بنگرید اکنون بنات‌النعش وار از دست مرگ %~% نیزه‌هاشان شاخ شاخ و تیرهاشان پارپار(@)(@@) 12 می‌نبینید آن سفیهانی که ترکی کرده‌اند %~% همچو چشم تنگ ترکان گور ایشان تنگ و تار(@)(@@) 13 بنگرید آن جعدشان از خاک چون پشت کشف %~% بنگرید آن رویشان از چین چو پشت سوسمار(@)(@@) 14 سر به خاک آورد امروز آنکه افسر بود دی %~% تن به دوزخ برد امسال آنکه گردن بود پار(@)(@@) 15 ننگ ناید مر شما را زین سگان پر فساد %~% دل 
ms318	 نگیرد مر شما را زین خزان بی‌فسار(@)(@@) 16 این یکی گه زین دین و کفر را زو رنگ و بوی %~% و آن دگر گه فخر ملک و ملک را زو ننگ و عار(@)(@@) 17 این یکی کافی ولیکن فاش را ز اعتقاد %~% و آن دگر شافی ولیکن فاش را ز اضطرار(@)(@@) 18 زین یکی ناصر عبادالله خلفی ترت و مرت %~% وز دگر حافظ بلادالله جهانی تار و مار(@)(@@) 19 پاسبانان تو اند این سگ پرستان همچو سگ %~% هست مرداران ایشان هم بدیشان واگذار(@)(@@) 20 زشت باشد نقش نفس خوب را از راه طبع %~% گریه کردن پیش مشتی سگ پرست و موشخوار(@)(@@) 21 اندرین زندان برین دندان زنان سگ صفت %~% روزکی چند ای ستمکش صبر کن دندان فشار(@)(@@) 22 تا ببینی روی آن مردم‌کشان چون زعفران %~% تا ببینی رنگ آن محنت‌کشان چون گل انار(@)(@@) 23 گرچه آدم سیرتان سگ صفت مستولیند %~% هم کنون بینی که از میدان دل عیاروار(@)(@@) 24 جوهر آدم برون تازد برآرد ناگهان %~% زین سگان آدمی کیمخت و خر مردم دمار(@)(@@) 25 گر مخالف خواهی ای مهدی در آ از آسمان %~% ور موافق خواهی ای دجال یک ره سر برآر(@)(@@) 26 یک طپانچه مرگ و زین مردارخواران یک جهان %~% یک صدای صور و زین فرعون طبعان صدهزار(@)(@@) 27 باش تا از صدمت صور سرافیلی شود %~% صورت خوبت نهان و سیرت زشت آشکار(@)(@@) 28 تا ببینی موری آن خس را که می‌دانی امیر %~% تا بینی گرگی آن سگ را که می‌خوانی عیار(@)(@@) 29 در تو حیوانی و روحانی و شیطانی درست %~% در شمار هر که باشی آن شوی روز شمار(@)(@@) 30 باش تا بر باد بینی خان رای و رای خان %~% باش تا در خاک بینی شر شور و شور شار(@)(@@) 31 تا ببینی یک به یک را کشته در شاهین عدل %~% شیر سیر و جاه چاه و شور سوز و مال مار(@)(@@) 32 ولله ار داری به جز 
ms319	 بادی به دست ارمر ترا %~% جز به خاک پای مشتی خاکسارست افتخار(@)(@@) 33 کز برای خاک پاشی نازنینی را خدای %~% کرددر پیش ساستگاه قهرش سنگسار(@)(@@) 34 باش تا کل بینی آنها را که امروزند جزو %~% باش تا گل یابی آنها را که امروزند خار(@)(@@) 35 آن عزیزانی که آنجا گلبنان دولتند %~% تا نداریشان بدینجا خیره همچون خار خوار(@)(@@) 36 گلبنی کاکنون ترا هیزم نمود از جور دی %~% باش تا در جلوه‌ش آرد دست انصاف بهار(@)(@@) 37 ژنده‌پوشانی که آنجا زندگان حضرتند %~% تا نداری خوارشان از روی نخوت زینهار(@)(@@) 38 و آن سیاهی کز پی ناموس حق ناقوس زد %~% در عرب بواللیل بود اندر قیامت بونهار(@)(@@) 39 پرده‌دار عشق دان اسم ملامت بر فقیر %~% پاسبان در شناس آن تلخ آب اندر بحار(@)(@@) 40 ور بقا خواهی ز درویشان طلب زیرا که هست %~% بود درویشان قباهای بقا را پود و تار(@)(@@) 41 تا ورای نفس خویشی خویشتن کودک شمار %~% چون فرود طبع ماندی خویشتن غافل بدار(@)(@@) 42 کی شود ملک تو عالم تا تو باشی ملک او %~% کی بود اهل نثار آنکس که برچیند نثار(@)(@@) 43 هست دل یکتا مجویش در دو گیتی زان که نیست %~% در نه و در هشت و هفت و در شش و پنج و چهار(@)(@@) 44 نیست یک رنگی بزیر هفت چار از بهر آنک %~% ار گلست اینجای با خارست ور مل با خمار(@)(@@) 45 بهر بیشی راست اینجا کم زدن زیرا نکرد %~% زیر گردون قمر پس مانده را هرگز قمار(@)(@@) 46 در رجب خود روزه‌دار و «قل هوالله» خوان و پس %~% در صفر خوان «تبت» و در چارشنبه روزه‌دار(@)(@@) 47 چند ازین رمز و اشارت راه باید رفت راه %~% چند ازین رنگ و عبارت کار باید کرد کار(@)(@@) 48 همرهان با کوه‌هانان به حج رفتند و کرد %~% رسته از میقات و حرم و جسته از سعی و جمار(@)(@@) 49 تو هنوز از راه رعنایی ز بهر 
ms320	 لاشه‌ای %~% گاه در نقش هویدی گاه در رنگ مهار(@)(@@) 50 چون به حکم اوست خواهی تاج خواهی پای بند %~% چون نشان اوست خواهی طیلسان خواهی غیار(@)(@@) 51 تا به جان این جهانی زنده چون دیو و ستور %~% گر چه پیری همچو دنیا خویشتن کودک شمار(@)(@@) 52 حرص و شهوت در تو بیدارند خوش خوش تو مخسب %~% چون پلنگی بر یمین داری و موشی بر یسار(@)(@@) 53 مال دادی لیک رویست و ریا اندر بنه %~% کشت کردی لیک خوکست و ملخ در کشت‌زار(@)(@@) 54 خشم را زیر آر در دنیا که در چشم صفت %~% سگ بود آنجا کسی کاینجا نباشد سگ سوار(@)(@@) 55 خشم و شهوت مار و طاووسند در ترکیب تو %~% نفس را آن پایمرد و دیو را این دست یار(@)(@@) 56 کی توانستی برون آورد آدم را ز خلد %~% گر نبودی راهبر ابلیس را طاووس و مار(@)(@@) 57 عور کرد از کسوت عار ار ز دوده آدمی %~% زان که اندر تخم آدم عاریت باشد عوار(@)(@@) 58 حلم و خرسندی در آب و گل طلب کت اصل ازوست %~% کی بود در باد خرسندی و در آتش وقار(@)(@@) 59 حلم خاک و قدر آتش جوی کآب و باد راست %~% گرت رنگ و بوی بخشد پیله‌ور صد پیلوار(@)(@@) 60 تا تو اندر زیر بار حلق و جلقی چون ستور %~% پرده‌داران کی دهندت بار بر درگاه یار(@)(@@) 61 گرد خرسندی و بخشش گرد زیرا طمع و طبع %~% کودکان را خربزه گرمست و پیران را خیار(@)(@@) 62 راستکاری پیشه کن کاندر مصاف رستخیز %~% نیستند از خشم حق جز راست‌کاران رستگار(@)(@@) 63 تا به جان لهو و لغوی زنده اندر کوی دین %~% از قیامت قسم تو نقشست و از قرآن نگار(@)(@@) 64 حق همی گوید بده تا ده مکافاتت دهم %~% آن به حق ندهی و پس آسان بپاشی در شیار(@)(@@) 65 این نه شرط مومنی باشد که در ایمان تو %~% حق همی خاین نماید خاک 