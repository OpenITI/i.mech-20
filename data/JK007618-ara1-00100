ms81	 % بين تماثيل دمى كالأصنام % 9(@)(@@) % من كل خود ذات ثغر بسام % كالنور أبدته فتوق الأكمام % 10(@)(@@) % وانتصر الروم على بني حام % وقابل الجام المدير بالجام % PageV01P315 11(@)(@@) % ثم تقضت كتقضي الأحلام % آه على شرخ الشباب لو دام % 12(@)(@@) % على ليال سلفت وأيام % وحبذا دجلة في اليوم لغام % 13(@)(@@) % نسيمها الواني وماؤها الطام % مشرقة قصورها والآكام % 14(@)(@@) % وللغمام زجل وإرزام % يطرده الشمال طرد الأنعام % 15(@)(@@) % كأنما تهطاله والتسجام % جود الوزير ذي الندى والإقدام % 16(@)(@@) % ألمسمح الصعب العبوس القثام % مردي الكماة الهزبري المقدام % 17(@)(@@) % مغمد بيض المرهفات في الهام % ألعاقر الجود الكرام المطعام % 18(@)(@@) % مأوى الطريد وثمال الأيتام % محيي الثراء ومميت الإعدام % 19(@)(@@) % نعم مناخ بن السبيل المعتام % يحكم عقد الرأي أي إحكام % 20(@)(@@) % إحكام طب بالأمور علام % مؤيد في نقضه والإبرام % PageV01P316 21(@)(@@) % إذا القضايا لتبست والأحكام % وضل عن نهج الصواب الحكام % 22(@)(@@) % أوضح من إشكالها والإبهام % هداية من ربه وإلهام % 23(@)(@@) % أنطقني من بعد طول الإرمام % له عطاء سابغ وإنعام % 24(@)(@@) % أحسن في بتدائه والإتمام % لا يملك الكريم إلا الإكرام % 25(@)(@@) % يا عضد الدين معز الإسلام % يا ابن العوالي والظبا والأقلام % 26(@)(@@) % خير الورى خؤولة وأعمام % هم الرؤوس والأنام أقدام % 27(@)(@@) % وهم إذا ضل العفاة أعلام % أسد وغى لها الرماح آجام % 28(@)(@@) % شيمتهم بذل القرى والإطعام % أكنافهم خضر إذا غبر العام % 29(@)(@@) % من كل ضرغام نماه ضرغام % مقتحم هول الخطوب هجام % 30(@)(@@) % منزه عن دنس وعن ذام % إذا امتطى متن سبوح عوام % PageV01P317 31(@)(@@) % ضرم نار الحرب أي ضرام % فاصغ لمدح كلآلي نظام % 32(@)(@@) % فيه لمن يشنا علاك إرغام % من خاطر تياره جار طام % 33(@)(@@) % سيان كد عنده وإجمام % و بق على الدهر بقاء الأقدام % 34(@)(@@) % عالي البنا مغدق صوب الإنعام % ما سمعت تلبية بإحرام % PageV01P318 البحر : منسرح 1(@)(@@) % ألحمد لله عوفي الكرم % و نبعثت بالخواطر الهمم % 2(@)(@@) % واستأزر الإسلام وابتهج الملك وأوفت بنذرها الأمم % ام و بتهج ال % 3(@)(@@) % واستبقت من غمودها دلقا % إلى الأعادي الصوارم الحذم % 4(@)(@@) % تكاملت للوزير صحته % فالجور باك 
ms82	 والعدل مبتسم % 5(@)(@@) % عافية للحسود ممرضة % وصحة وهي للعدى سقم % 6(@)(@@) % هذا هناء للخلق قاطبة % يشترك العرب فيه والعجم % 8(@)(@@) % أسفر وجه الزمان مبتسما % بماجد للعفاة يبتسم % 9(@)(@@) % ومتلأ الدست من سنا قمر % ينجاب عن نور وجهه الظلم % 11(@)(@@) % أبلج رعي العهود شيمته % يخفر إلا في دينه الذمم % 12(@)(@@) % مغرى بحفظ العهد القديم إذا % % أضاعه عند غيره القدم % PageV01P319 13(@)(@@) % يرى من العار أن ذا أدب % يضام في عصره ويهتضم % 14(@)(@@) % أقسم لا خاب سائلوه ولا % ضاعت لديه الحقوق والحرم % 15(@)(@@) % متوج تخضع الجباه له % إذا انتدى للسلام والقمم % 16(@)(@@) % طود حجى راسخ خضم ندى % تياره بالسماح ملتطم % 18(@)(@@) % حاسم داء الدنيا العضال وما % % خلناه لولا الوزير ينحسم % 20(@)(@@) % عادت لبغداذ من مكارمه % وقد تولت أيامها القدم % 21(@)(@@) % وأصبحت من جميل سيرته % كعبة جود وأرضها حرم % 22(@)(@@) % لا ينتحي أهلها الخطوب ولا % يحل فيها السنون والإزم % 23(@)(@@) % إذا اشتكى الناس جدب عامهم % أشكاهم سيل جوده العرم % 24(@)(@@) % أو صرد الباخل القرى فيهقت % % مكللات جفانه الرذم % PageV01P320 25(@)(@@) % ترى وفود الندى بساحته % على بحور العطاء تزدحم % 26(@)(@@) % يا عضد الدين أنت أكرم من % داست بسيط الثرى له قدم % 29(@)(@@) % خلفت قوما بالجود ذكرهم % باق وهم في قبورهم رمم % 30(@)(@@) % صغرت أفعالهم ولا حاتم % يذكر في دهرهم ولا هرم % 31(@)(@@) % وحدثت فيهم الرواة فما % % بعثت إلا مصدقا لهم % 32(@)(@@) % يا من تصح العلى بصحته % ويشتكي لاشتكائه الكرم % 33(@)(@@) % ومن له راحة أناملها % % تفعل فينا ما تفعل الديم % 34(@)(@@) % يكاد للبأس والسماح يذو % % ب السيف فيها ويورق القلم % 35(@)(@@) % إليك مدحا أملت بدائعه % لاك وليث له القنا أجم % 36(@)(@@) % خط وقامت ب % نصرها الكلم % PageV01P321 37(@)(@@) % تعد في الشعر وهي منقصة % لو أنصفت قيل إنها حكم % 38(@)(@@) % لا عدمتك الدنيا ولا برحت % منيخة في عراصك النعم % 39(@)(@@) % ولا كبا يا بني الرقيل لكم % زند ولا أزلقت لكم قدم % PageV01P322 البحر : مجزوء الكامل 1(@)(@@) % حتام مطلك يا ظلوم % ما آن أن يقضى الغريم % 2(@)(@@) % إن كان وصلك ما 
ms83	 يرا % % م فإن وجدي ما يريم % 3(@)(@@) % دي هل تغي % رت الرسوم % 4(@)(@@) % ما لي إذا رمت السلو % تلوم القلب المليم % 5(@)(@@) % وإذا كتمت السر با % % م والمراد به جميم % 6(@)(@@) % عيني وقلبي في الهوى % % عون علي فمن ألوم % 7(@)(@@) % يا من له قد يقوم % بعذر عاشقه قويم % 10(@)(@@) % يا عاذلا في ظهر نا % % جية كما ذعر الظليم % 11(@)(@@) % ألبان من نجد فلي % % وجد بساكنه قديم % 14(@)(@@) % وعلى النقا إما مرر % ت بذي النقا ظبي رخيم % PageV01P323 16(@)(@@) % عجبا له يشتاقه % ظبي الكناسة والصريم % 17(@)(@@) % لله رونقه وقد % قلبي له مرعى ولل % % 19(@)(@@) % والروض يصقله الندى % % ها وهي سوق لا تقوم % 20(@)(@@) % وقد نتشى خوط الأرا % % كة والحمام له نديم % 21(@)(@@) % والزهر يضحك في خما % % ئله إذا بكت الغيوم % 22(@)(@@) % وسألت عن حالي وأن % نزلت بساحته الهموم % 24(@)(@@) % د في ترائبه نظيم % صية المنى وأنا الزعيم % 25(@)(@@) % يا من أضاء لنا بثا % % قب رأيه الليل البهيم % 26(@)(@@) % ولنا مقيل بارد % في ظله وندى عميم % 27(@)(@@) % شرع السخاء فمن موا % % ت بما بليت به عليم % PageV01P324 28(@)(@@) % ألمستجد مآثرا % يزهو بها الشرف القديم % 29(@)(@@) % سمح إذا بخل الحيا % % ثبت إذا طاش الحليم % 30(@)(@@) % من معشر طابت فرو % % عهم كما طاب الأروم % 31(@)(@@) % قوم إذا غضب الغما % % م فعندهم رضي المسيم % 33(@)(@@) % و سأل مغاني الحي بع % ر لا تساميه النجوم % 35(@)(@@) % تطوي الفلا والشوق سا % % ئقها وقائدها النسيم % 36(@)(@@) % متمطرات تلتوي % % تحت الرحال وتستقيم % 37(@)(@@) % وعلى غواربها نفو % % س لا تحس لها جسوم % 39(@)(@@) % لولاك يا بن محمد % لم يلف في الدنيا كريم % 41(@)(@@) % أغنيت عني حيث لا % % يغني الشقيق أو الحميم % PageV01P325 42(@)(@@) % حتى علوت بحجتي % % والناس كلهم خصوم % 43(@)(@@) % يفديك فظ لا يجا % % ور صدره قلب رحيم % 44(@)(@@) % نزر العطايا ماؤه % وشل ومربعه وخيم % 45(@)(@@) % لا يستهل سماؤه % بالمكرمات ولا تغيم % 46(@)(@@) % طير الرجاء على موا % % ئده محلأة تحوم % 47(@)(@@) % سلمت دراهمه ولكن عرضه عرض سقيم % كن عرضه عرض سقيم % 48(@)(@@) % هذا 
ms84	 ثناء أخي ولا % % ء وده محض سليم % 49(@)(@@) % لسماء مجدك أنجم % ولمن يعاديها رجوم % PageV01P326 البحر : وافر تام 1(@)(@@) % ليهنك أن عيني ما تنام % وأني فيك صب مستهام % 2(@)(@@) % وأن القلب بعدك ما استقرت % نوافره ولا برد الغرام % 3(@)(@@) % جننت وما نقضى عنا ثلث % فكيف إذا نطوى عام وعام % 4(@)(@@) % يلوم عليك خال من غرامي % % رويدك أين سمعي والملام % 5(@)(@@) % سلو مثل عطفك لا يرجى % % وصبر مثل وصلك لا يرام % 6(@)(@@) % وكيف أطيع عذالي وعندي % % هموم قد سهرت لها وناموا % % 7(@)(@@) % ونار أوقدت بالغور وهنا % فشب لها على كبدي ضرام % 8(@)(@@) % ذكرت بها زمان هوى ووصل % جني للصبى فيه غرام % 9(@)(@@) % يقيم مواسم اللذات فيه % وجوه من بني حسن وسام % 10(@)(@@) % وأياما بكاظمة قصارا % على أيام كاظمة السلام % PageV01P327 11(@)(@@) % تشدتك يا حمامات المصلى % % متى رفعت عن الخيف الخيام % 12(@)(@@) % وهل زالت مع الأظعان عنها % % بدور لا يزايلها التمام % 13(@)(@@) % ومايلني عن الخلصاء رام % مصيب لا تطيش له سهام % 14(@)(@@) % يخيل أن تصوره الأماني % % لغيني أو يمثله المنام % 15(@)(@@) % فأسقمني بأجفان مراض % وأقسم لا يفارقني السقام % 16(@)(@@) % ثنى عطفي له ذاك التثني % % وقام بحجتي فيه القوام % 17(@)(@@) % يعير البان خطوته اعتدالا % ويسكر من لواحظه المدام % 18(@)(@@) % وحمل خصره ما حملتنا % % أياد من أبي نصر جسام % 19(@)(@@) % فتى يده تحن إلى العطايا % % كما حن المشوق المستهام % 20(@)(@@) % لها شيم يفوح لها أريج % كما نفتقت عن الروض الكمام % PageV01P328 21(@)(@@) % تشد إليه أكوار المطايا % % كأن فناءه البلد الحرام % 22(@)(@@) % ولا جهم وقد ألقت عصاها % % بساحته الوفود ولا جهام % 23(@)(@@) % إذا جادت يداه وجاد صوب % الحيا لم يدر أيهما الغمام % 24(@)(@@) % وإن ضنت سحائبه سقانا % % سحاب من موارده ركام % 25(@)(@@) % له جود وبأس و صطناع % وإرغام وعفو وانتقام % 26(@)(@@) % تخاف سطاه أحداث الليالي % % وتصغر عنده النوب العظام % 27(@)(@@) % مجير لا يضام لديه جار % وراع لا يراع له سوام % 28(@)(@@) % أمنت صروف أيامي فظلمي % % على الأيام محظور حرام % 29(@)(@@) % وقد أمسى عماد الدين جاري % % وجار بني المظفر 
ms85	 لا يضام % 30(@)(@@) % من القوم الذين لهم وجوه % وإحسان يضيء به الظلام % PageV01P329 31(@)(@@) % عتادهم مثقفة رقاق % وجرد أعينها صيام % 32(@)(@@) % إذا عريت سيوفهم المواضي % % فليس سوى النفوس لها طعام % 33(@)(@@) % سخوا وسطوا فهم حياة % لمن يرجوهم وهم حمام % 34(@)(@@) % فقل يا دهر للبخلاء عني % % حظرت علي ما يهب اللئام % 35(@)(@@) % وإن ضنت بآمالي فأضحت % مصاعب لا يلين لها خطام % 36(@)(@@) % وكر على الحياض محلآت % حوائم لا يبل لها هيام % 37(@)(@@) % فأحميت القوافي عن رجال % مديحي فيهم عار وذام % 38(@)(@@) % وزرت بها حمى ملك كريم % يبخل حين تذكره الكرام % 39(@)(@@) % فلا نابي المضارب حين نرمي % % بحديه الخطوب ولا كهام % 40(@)(@@) % أقام نداك للآداب سوقا % وكانت عند غيرك لا تقام % PageV01P330 41(@)(@@) % فخذ مني الثناء بقدر وسعي % % فقدر علاك شيء لا يرام % 42(@)(@@) % ثناء فيك لم يمدح قديما % بجودته الوليد ولا هشام % PageV01P331 البحر : بسيط تام 1(@)(@@) % إلام أكتم فضلا ليس ينكتم % وكم أذود القوافي وهي تزدحم % 2(@)(@@) % وكم أداري الليالي وهي عاتبة % وكم تعبس أيامي وأبتسم % 3(@)(@@) % ما للحوادث تصميني بأسهمها % % رميا ولكنها تصمي ولا تصم % 4(@)(@@) % شيبن فودي وإن راقتك صبغته % إن الشبيبة في غير العلى هرم % 5(@)(@@) % لكل يوم خليل لا أفارقه % وعزمة من حبيب داره أمم % 6(@)(@@) % يا قلب ما لك لا تسلو الغرام ولا % % ينسيك عهد الهوى بعد ولا قدم % 7(@)(@@) % قد كنت تبكي وشعب الحي منصدع % فيم البكاء وهذا الشعب ملتئم % 8(@)(@@) % وحلوة الريق ما زالت تجنبني % % عن رشفه وشفائي ماؤه الشبم % 9(@)(@@) % ولت تشير بأطراف مخضبة % يظن من فتنته أنها عنم % 10(@)(@@) % تروقه وهو لا يدري لشقوته % أن الخضاب على ذاك البنان دم % PageV01P332 11(@)(@@) % ضنت علي بزور من مواعدها % % فجاد من غير ميعاد بها الحلم % 12(@)(@@) % فبت أشكو رسيس الشوق تظهرني % % الشكوى ويسترني عن طيفها السقم % 13(@)(@@) % فنلت من وصلها ما كنت آمله % بعدت من زمن لذاته حلم % 14(@)(@@) % يا طالب الجود يشكو بعد مطلبه % وتشتكيه سراها الأينق الرسم % 15(@)(@@) % عج بالمطي على الزوراء تلق بها % % مبارك 
ms86	 الوجه في عرنينه شمم % 16(@)(@@) % مؤيد العزم من آل المظفر مح % مود الخلائق ترعى عنده الذمم % 17(@)(@@) % رحب الذراع طويل الباع لا حرج % يوما إذا سئل الجدوى ولا سئم % 18(@)(@@) % بكل حي له آثار مكرمة % وكل أرض بها من جوده علم % 19(@)(@@) % تصمي قلوب العدى بالرعب سطوته % وتقشعر إذا سمي لها الصمم % 20(@)(@@) % ماضي العزيمة لا تثنيه عن أرب % سمر العوالي ولا الهندية الحذم % PageV01P333 21(@)(@@) % يستل من عزمه في الروع ذو شطب % ماضي الغرارين لا ناب ولا فصم % 22(@)(@@) % إذا عصته قلوب الناكثين أطاعت سيفه منهم الأعناق واللمم % ت سيفه منهم الأعناق واللمم % 23(@)(@@) % أمسى يحمل عز الدين همته % عبئا إذا حملته تظلع الهمم % 24(@)(@@) % لا تستميل هواه الغانيات ولا % تشغل همته الأوتار والنغم % 25(@)(@@) % ما روضة أنف بكر بمحنية % ند ثراها بجود نبتها سنيم % % 26(@)(@@) % خط الربيع لها من نور بهجته % رقما وحطت بها أثقالها الديم % 27(@)(@@) % تضحي ثغور الأقاحي في جوانبها % % ضواحكا ودموع المزن تنسجم % 28(@)(@@) % يوما بأطيب نشرا من علائقه % لحسنى وأحسن منه حين يبتسم % 29(@)(@@) % يكاد يقطر من نادي أسرته % ماء الحياة ومن أعطافه الكرم % 30(@)(@@) % بني الرفيل لكم في كل مكرمة % يد وفي كل مجد باذخ قدم % PageV01P334 31(@)(@@) % عصائب الملك من كسرى وخاتمه % لكم وتيجانه والسيف والقلم % 32(@)(@@) % حللت فيكم بآمالي على ثقة % بالنجح لما بلوت الناس كلهم % 33(@)(@@) % وكم . . . بليت بأغمار وجودهم % لما بلوتهم سيان والعدم % 34(@)(@@) % تأبى علي القوافي إن أردت لهم % مدحا وتنقاد لي فيكم وتنتظم % 35(@)(@@) % أبا الفتوح اجتل البكر العقيلة لم % يفتح بمثل لها عند الملوك فم % 36(@)(@@) % ليست كفاء لما تولي يداك على % % أن الخواطر في أمثالها عقم % 37(@)(@@) % وكيف يبلغ فيك المدح غايته % ما دون ما رمت منه تنفد الكلم % 38(@)(@@) % أم كيف أشكر ما أوليت من نعم % قبول شكري على إسدائها نعم % 39(@)(@@) % ما لي ظمئت وهذا البحر معترضا % دوني وتياره بالموج يلتطم % 41(@)(@@) % أما لأرض غدت حصباء مجدبة % سحابة ثرة أو مطرة شبم % PageV01P335 42(@)(@@) % لقد رعيت 
ms87	 المنى دهرا ومربعها % % كما علمت وبيل رعيه وخم % 43(@)(@@) % فإن ظفرت فعقبى الصبر صالحة % أو أخفق السعي قلت الرزق مقتسم % PageV01P336 البحر : وافر تام 1(@)(@@) % هي الأيام صحتها سقام % وغاية من يعيش بها الحمام % 2(@)(@@) % إذا وصلت فليس لها وفاء % وإن عهدت فليس لها ذمام % 3(@)(@@) % رضعناها وتفطمنا المنايا % % بها ولكل مرتضع فطام % 4(@)(@@) % فلا تستوط من دنياك ظهرا % بكف النائبات لها زمام % 5(@)(@@) % فليس لها وإن ساءت وسرت % على حالي تلونها دوام % 6(@)(@@) % أباطيل تصورها الأماني % % وأحلام يمثلها المنام % 7(@)(@@) % ألا يا ظاعنين وفي فؤاد المحب لوشك بينهم ضرام % محب لوشك بينهم ضرام % 8(@)(@@) % ترى يدنو بكم من بعد شحط % مزار أو يلم بكم لمام % 9(@)(@@) % وهل لزمان وصلكم معاد % وهل لصدوع شملكم التيام % 10(@)(@@) % قفوا قبل الوداع تروا نحولا % جناه على محبكم الغرام % PageV01P337 12(@)(@@) % ومما زادني قلقا فجفني % % له دام وقلبي مستهام % 13(@)(@@) % رزيئة من تهون لها الرزايا % % وتصغر عندها النوب العظام % 14(@)(@@) % كأن وقارها يوم استقلت % بها الأعناق رضوة أو شمام % 15(@)(@@) % تسير على الملوك لها حتشام % وللآمال حوليها ازدحام % 16(@)(@@) % برغمي أن تبيت على مهاد % حشاياه الجنادل والرغام % 17(@)(@@) % وأن تمسي وضيق اللحد دار % لها وحجابها فيه الرخام % 18(@)(@@) % وأن تنوي إلى سفر رحيلا % ولم ترفع لنيتها الخيام % 20(@)(@@) % فأي حمى أباحته الليالي % % ولم يك عزه مما يرام % 21(@)(@@) % رمته من الحوادث كف رام % مصيب لا تطيش له سهام % 22(@)(@@) % فما أغنت أسنتها المواضي % % ولا منعت عشيرتها الكرام % PageV01P338 24(@)(@@) % فلا جود غداة ثويت يرجى % % مخيلته ولا كرم يشام % 25(@)(@@) % وسيمت بعدك العلياء ضيما % وكانت في حياتك لا تضام % 27(@)(@@) % وكنت النجم جد به أفول % وشمس الأرض واراها الظلام % 28(@)(@@) % وبدر التيم عاجله سرار % وأسلمه إلى النقص التمام % 29(@)(@@) % كريمة قومها لو أن خلقا % يكون له عن الموت عتصام % 30(@)(@@) % لحامت عنك أسياف حداد % وجرد في أعنتها صيام % 31(@)(@@) % ولو دفع الردى المحتوم بأس % وإقدام ورأي و عتزام % 32(@)(@@) % وقاك حمامك البطل المحامي % % أبوك وعمك الليث الهمام % 33 
ms88	(@)(@@) % وقارع من بناة المجد آل ال % مظفر عنك أنجاد كرام % 34(@)(@@) % بكل يد يكاد يذوب فيها % % لشدة بأس حامله الحسام % PageV01P339 35(@)(@@) % حللت بموحش الأرجاء قفر % غدا ما للأنيس به مقام % 36(@)(@@) % ولا ضحك الثرى مذ بنت عنه % بنوار ولا هطل الغمام % 37(@)(@@) % ولا مالت بدوحتها غصون % ولا غنت على الأيك الحمام % 38(@)(@@) % ولا خطرت على روض شمال % ولا سفرت عن النور الكمام % 39(@)(@@) % مضيت سليمة من كل عاب % على قبر حللت به السلام % PageV01P340 البحر : طويل 1(@)(@@) % ألا من لمسجون بغير جناية % يعد من الموتى وما حان يومه % 2(@)(@@) % يروعه عند الصباح انتباهه % وطوبى له لو طال و متد نومه % 3(@)(@@) % ولقد ظننت وفاءكم % بالعهد لي أبدا يقوم % 3(@)(@@) % جفاه بلا ذنب أتاه صديقه % وأسلمه للهم والحزن قومه % 4(@)(@@) % وأرى رسومي عندكم % تعفو كما عفت الرسوم % 4(@)(@@) % وأرخص منه الدهر ما كان غاليا % على مشتري الأحزان في الناس سومه % 5(@)(@@) % فيا ابن الدوامي الذي جود كفه % عميم وفي بحر المكارم عومه % 6(@)(@@) % وليك ضامته الليالي وقد يرى % % حراما على الأيام والدهر ضيمه % 7(@)(@@) % فزر عائدا من يوم لقياك عيده % فقد طال عن تلك الوظيفة صومه % 8(@)(@@) % وقد كنت قدما مشفقا من ملامة % فما باله قد هان عندك لومه % PageV01P341 البحر : رجز تام 1(@)(@@) % مات السماح فاسفحي % % يا مقلة الفضل دما % % 4(@)(@@) % لا تتعبوا أفكاركم % ولا تكدوا الهمما % % 5(@)(@@) % ولا ترجوا دولة % ودهركم قد هرما % % 6(@)(@@) % إن استطعتم فابتغوا % % إلى السماء سلما % % 8(@)(@@) % والورد في راحة من % % راحته تشكو الظما % % 9(@)(@@) % مغرمة بنحلها % % ترى السماح مغرما % % 10(@)(@@) % والمال قد أمسى على % % أهل الندى محرما % % 11(@)(@@) % فهو يرى الموت ولا % % يرى الجواد المنعما % % 12(@)(@@) % يكره من يكره في % % أعقابه التندما % % 13(@)(@@) % وإنما يألف من % ما ألف التكرما % % PageV01P342 14(@)(@@) % يمسي بمن يمسي به % متيما متيما % % 15(@)(@@) % كأن هذا الدهر آ % % قد تجهما % % 16(@)(@@) % لا برح المثري بخيلا % والجواد معدما % % PageV01P343 البحر : طويل 1(@)(@@) % ولائمة لي في الهجاء أجبتها % % ملامك لي فيمن هجوت من الظلم % 2(@)(@@) % أحق 
ms89	 بلوم من سهرت مراعيا % له النجم في تنقيح غراء كالنجم % 3(@)(@@) % فلم ألق منه البشر فضلا عن الندى % % ويا رب مدح صار داعية الذم % PageV01P344 البحر : طويل 1(@)(@@) % إليك أمير المؤمنين قضية % أعيذك أن تلقى بها الله آثما % % 2(@)(@@) % ألست أمين الله في الخلق واجبا % عليك لهم أن تسترد المظالما % % 3(@)(@@) % ومناقب مثل النجو % % م علا وفي عدد النجوم % 3(@)(@@) % أفي العدل أن يمسي أسامة ضاريا % على أخذ أموال الرعية عازما % % 4(@)(@@) % إسمع مقالة معرب % عن وده المحض السليم % 4(@)(@@) % يشن عليهم كل يوم إغارة % وينزرهم مما صطفوه الكرائما % % 5(@)(@@) % في الليل البهيم % يدلي الشكور إلى الكريم % 5(@)(@@) % وأقسم إن أمسى وأصبح جمة % ذخائره في النفس والمال سالما % % 6(@)(@@) % فابسط عقال خلاعتي % % بالراح واجل بها همومي % % 6(@)(@@) % بأنك ما هذبت بغداذ من أخي % % فساد ولا ستأصلت دهرك ظالما % % PageV01P345 7(@)(@@) % و بعث بها تمرية % إن أعوزت بنت الكروم % 7(@)(@@) % وأنك ما أغمدت للجود صارما % شهيرا ولا جردت للعدل صارما % % 8(@)(@@) % و عذر فقد أدللت إد % لال الحميم على الحميم % PageV01P346 البحر : مجتث 1(@)(@@) % يا روح كل جتماع % وأنس كل نديم % 2(@)(@@) % إسمع فما زلت ترجى % % لكل أمر عظيم % 3(@)(@@) % بأننا قد حصلنا % % في دار حر كريم % 4(@)(@@) % وعندنا كل شيء % إلا بنات الكروم % 5(@)(@@) % فابعث بها من عقار % فيها جلاء الهموم % 6(@)(@@) % مضيئة كسجايا % % ك في الزمان البهيم % 7(@)(@@) % نظل في خفض عيش % في ظلها ونعيم % 8(@)(@@) % عند الرشيد ولكن % في دعوة بن الحكيم % PageV01P347 البحر : وافر تام 1(@)(@@) % تعرض للرئيس أبي علي % على حكم الإخاء بلا حتشام % 2(@)(@@) % فلي حق أمت به إليه % وأعلم أنه وافي الذمام % 3(@)(@@) % وقل يا سيدي قد صح عزمي % % وقولي قول أصحاب الحمام % 4(@)(@@) % أصوم لصومكم خمسين يوما % وأهجر كل محظور حرام % 5(@)(@@) % وأجتنب الذبائح لا بحكم الضرورة بل بحكم الإلتزام % ضرورة بل بحكم الإلتزام % 6(@)(@@) % وأترك طائعا من غير عذر % موافقة لكم شرب المدام % 7(@)(@@) % إلى أن تجمع الأيام شملي % % بكم ما بين باطية وجام % 8(@)(@@) % ونجلوها 
ms90	 على الندمان بكرا % كقرن الشمس في جنح الظلام % 9(@)(@@) % فإن الترهات لها اتفاق % على الشعراء في هذا المقام % 10(@)(@@) % ولا سيما وهذا عام محل % توالى الجدب فيه بعد عام % PageV01P348 11(@)(@@) % غدا وجه السحاب الطلق جهما % وأكدت فيه أنواء الغمام % 12(@)(@@) % وأضحى المسلمون مع النصارى % % على الإمساك فيه والصيام % 13(@)(@@) % وإن تممت بالحلوا وحاشى % % لجودك أن يكون بلا تمام % 14(@)(@@) % حصلت على الثناء الحر مني % % بها وسلمت من جهة الملام % 15(@)(@@) % وإن مهدت في التثقيل عذري % % فذلك من سجاياك الكرام % 16(@)(@@) % وفي البرشان لي طمع قوي % ولكن ليس ذا وقت الكلام % PageV01P349 البحر : كامل تام 1(@)(@@) % قالوا سفكت دما عزيزا سفكه % ويد المكارم لا يراق لها دم % 2(@)(@@) % لا ذنب لي فيما أتيت لأنني % % قبلت راحته وخدي مخذم % PageV01P350 البحر : خفيف تام 1(@)(@@) % قل لمجد الدين الذي ختم الجو % % د به يا ممهد الإسلام % 2(@)(@@) % أنت محيي ميت المكارم والمطعم % في المحل قاتل الإعدام % 3(@)(@@) % أنت مال الراجي ثمال اليتامى % % عصمة المستجير والمستضام % 4(@)(@@) % قد أتتنا الأطباق تنمى إلى سو % % دد آبائك الملوك الكرام % 5(@)(@@) % وهي مملوءة ومحفوفة بالكر % م الصاحبي والإكرام % 6(@)(@@) % وعليها الصحون فيها رحابا % كل صحن منها كصحن السلام % 7(@)(@@) % ليس فيها شيء يعاب ومعرو % % فك يأبى عن كل عاب وذام % 8(@)(@@) % غير أن الغلام من تحتها يمشي رويدا فالله عون الغلام % ي رويدا فالله عون الغلام % 9(@)(@@) % فابق صافي موارد الجود مسكو % % ب حيا الرفد سابغ الإنعام % PageV01P351 البحر : طويل 1(@)(@@) % حياك الربيع من فصاح أعاجم % بأخضر مياد من البان ناعم % 2(@)(@@) % وطرتن في خضراء مونقة الثرى % % قريبة عهد بالعهاد الروازم % 3(@)(@@) % لقد هاج لي تغريدكن عشية % لواعج شوق من هوى متقادم % 4(@)(@@) % وتذكار أيام قصار تصرمت % كما اكتحلت بالطيف أجفان حالم % 5(@)(@@) % نعم و كتسى مغناك يا دارة الحمى % % ملابن من وشي الرياض النواجم % 6(@)(@@) % إذا أسبلت فيها الغوادي دموعها % % حكت ثغر مفتر عن النور باسم % 7(@)(@@) % وفي عقدات الرمل ظبي كناسه % صدور العوالي شرعا والصوارم % 8(@)(@@) % وأهيف مهزوز 
ms91	 القوام إذا نثنى % % وهبت لعذري فيه ذنب اللوائم % 9(@)(@@) % بثغر كما يبدو لك الصبح باسم % وفرع كما يدجو لك الليل فاحم % 10(@)(@@) % مليح الرضا والسخط يلقاك عاتبا % بألفاظ مطلوم وألحاظ ظالم % PageV01P352 11(@)(@@) % وفي الجيرة الغادين كل خريدة % تنوء على ضعف بحمل المآثم % 12(@)(@@) % إذا جمشت أعطافهن يد الصبا % % تأودن أمثال الغصون النواعم % 13(@)(@@) % وقابلن سقمي بالخصور التي وهت % معاقدها وأدمعي بالمباسم % 14(@)(@@) % ومما شجاني أنني يوم بينهم % شكوت الذي ألقى إلى غير راحم % 15(@)(@@) % وحملت أثقال الجوى غير حامل % وأودعت أسرار الهوى غير كاتم % 16(@)(@@) % وأبرح ما قاسيته أن مسقمي % % بما حل بي من حبه غير حالم % 17(@)(@@) % ولو كنت مذ بانوا سهرت لساهر % لهان ولكني سهرت لنائم % 18(@)(@@) % عذيري من قلب يجاذبني الهوى % % إليك ومن لاح عليك ولائم % 19(@)(@@) % يعيرني من لم يذق حرق الأسى % % عليك ولا فيض الدموع السواجم % 20(@)(@@) % ولا بات يرعى شارد النجم طرفه % ولا ظل يستقري رسوم المعالم % PageV01P353 21(@)(@@) % فأخجل بأجفاني وجهد محمد % إذا ما ستهلا مثقلات الغمائم % 22(@)(@@) % أبي الفرج الفراج كل ملمة % وخواض موج المأزق المتلاطم % 23(@)(@@) % إلى بأسه تعزى الصوارم والقنا % % وعن جوده يروى حديث الأكارم % 24(@)(@@) % له وسجايا الناس لؤم ولكنه % فصاحة قس في سماحة حاتم % 25(@)(@@) % عجبت له يحمي الثغور وماله % تناهبه السوال نهب الغنائم % 26(@)(@@) % ويسلم من ريب الحوادث جاره % وما في يديه بالندى غير سالم % 27(@)(@@) % وما زال عدلا في القضية منصفا % ولكنه في المال أجور حاكم % 28(@)(@@) % تضيء له آراؤه وسيوفه % لدى كل يوم مظلم الجو قاتم % 29(@)(@@) % فيجمع بين الطير والوحش في الوغى % % وقد فرقت بين الطلى والجماجم % 30(@)(@@) % وكم غارة شعواء ضرم نارها % % بكل أشم المنكبين ضبارم % PageV01P354 31(@)(@@) % فوارس أمثال الأسود فوارسا % على ضمر مثل السهاء سواهم % 32(@)(@@) % لقد سيس منه الملك وهو مضيع % برأي بصير بالعواقب حازم % 33(@)(@@) % وأضحت به الدنيا وقد رد أمرها % % إلى محصد الآراء ثبت العزائم % 34(@)(@@) % رآه أمير المؤمنين لدائها % % وقد أعضلت أدواؤها خير حاسم % 35(@)(@@) % تخيره من نبعة كسروية 
ms92	 % أبى عودها أن يستلين لعاجم % 36(@)(@@) % وصال على الأعداء من حد بأسه % بأبيض مضاء الغرارين صارم % 37(@)(@@) % وألقى مقاليد الأمور مفوضا % إليه فلم يقرع لها سن نادم % 38(@)(@@) % وحمل أعباء الوزارة كاهلا % حمولا لاعباء الأمور العظائم % 39(@)(@@) % وزيرا يحن الدست شوقا وصبوة % إليه حنين المطفلات الروائم % 40(@)(@@) % رأى الناس بحر الجود ملآن فانثنوا % % إليه بآمال عطاش حوائم % PageV01P355 41(@)(@@) % فأضحوا على الإطلاق في أسر جودشه % ببيض الأيادي لا بسود الأداهم % 42(@)(@@) % أقائدها قب البطون إذا سمت % إلى طلب طارت بغير قوادم % 43(@)(@@) % تدافع الأبطال في كل مأزق % تدافع سيل العارض المتراكم % 44(@)(@@) % إذا أصبحت أرض العدو لغارة % أقامت مع الإمساء سوق المآتم % 45(@)(@@) % تدمي خدود الغانيات كأنما % % ركضت بهن في وجوه اللواطم % 46(@)(@@) % بعدلك أمسى الدين بعد عوجاجه % قويما وأضحى الملك عالي الدعائم % 47(@)(@@) % وما كنت إلا العارض الجون جلجلت % رواعده حتى ارتوى كل حائم % 48(@)(@@) % تمنى الأعادي أن يصيبك كيدهم % ومن دون ما راموه حز الغلاصم % 49(@)(@@) % ودسوا لكم تحت التراب مكائدا % فلم يظفروا إلا بعض الأباهم % 50(@)(@@) % أريتهم حمر المنايا سوافرا % تطالعهم من بين زرق اللهاذم % PageV01P356 51(@)(@@) % وكنت لهم لما رموك بمكرهم % قذى في العيون بل شجى في الحلاقم % 52(@)(@@) % حرمتضهم طيب الحياة فلم تدع % لهم عيشة فيها تلذ لطاعم % 53(@)(@@) % فماتوا بها موت الكلاب أذلة % وعاشوا بها في الجهل عيش البهائم % 54(@)(@@) % فيا عضد الدين ستمعها غرائبا % من المدح تستغني على كل ناظم % 55(@)(@@) % إذا سمتها تقريظ مدحك أصبحت % مصاعبها تنقاد طوع الخزائم % 56(@)(@@) % تزورك أيام التهاني فتجلب ال % % ثناء إلى أسواقكم في المواسم % 57(@)(@@) % وعش في نعيم لا يحول جديده % ومجد يجول في ظهور النعائم % PageV01P357 البحر : كامل تام 1(@)(@@) % يا من رأى حد الحسام مضاءه % ورأى السحاب سخاءه فتعلما % % 2(@)(@@) % يا من سجاياه تضيء لوفده % فتخال في ليل الحوادث أنجما % % 3(@)(@@) % أخلاقه كالروض رواه الندى % % وجلا الغمام متونه فتقسما % % 4(@)(@@) % ألواهب الجرد العتاق ضوامرا % والقائد الجيش اللهام عرمرما % % 5(@)(@@) % لك خلتان صرامة وسماحة % يتعاقبان سياسة وتكرما % % 6 
ms93	(@)(@@) % راحت لشانيك المذمم مغرما % % وغدت لراجيك المؤمل مغنما % % 7(@)(@@) % فعلام تلقى بالصرامة وحدها % % متعبدا لم يلف يوما مجرما % % 8(@)(@@) % فيبيت من إرهاف بأسك مثريا % وجلا ومن ألطاف برك معدما % % 9(@)(@@) % والعدل فعلهما معا فأكون قد % أحرزت في الحالين حظي منهما % % 10(@)(@@) % ويهون البوسى علي إذا وهى % % جلدي بما أني ألاقي الأنعما % % PageV01P358 11(@)(@@) % يا من سهرت مفكرا في مدحه % أيجوز أن أمسي لديك مذمما % % 12(@)(@@) % فأبيت أنسج من ثنائك للعلى % % حللا وكفك لا تريش الأسهما % % 13(@)(@@) % ما كنت أحسب قبل طول جفاك أن % يمسي الوصال إلى القطيعة سلما % % 14(@)(@@) % ألقى لديك وما أسأت إساءة % وأصبت منك وما اجترمت تجرما % % 15(@)(@@) % إني أعيذك أن تحل لشاعر % يوما لسانا أو تسد له فما % % 16(@)(@@) % فيعود من بعد البشاشة مطرقا % خجلا ومن بعد الفصاحة أعجما % % 17(@)(@@) % وإذا تأخر في زمانك فاضل % وا ضيعتي فمتى يكون مقدما % % 18(@)(@@) % ومن العجائب أن يهان لفضله % من بات أهلا أن يعز ويكرما % % 19(@)(@@) % ما زال مغترا برأيك إن سطا % % دهر ومعتزيا إليك إذا نتمى % % 20(@)(@@) % يدنو بعين أنت مقلتها إذا % % نظرت ويرمي عن هواك إذا رمى % % PageV01P359 21(@)(@@) % يحدو أوامرك المطاعة جاهدا % فيها وينتهج السبيل الأقوما % % 22(@)(@@) % صبا بما ستدعى رضاك متيما % كلفا بما يحظيه عندك مغرما % % 23(@)(@@) % نظمت مدائحه عليك قلائدا % تبقى إذا عمر الزمان تصرما % % 24(@)(@@) % أأخاف دهري أن يروع صروفه % سربي برائعة وربعك لي حما % % 25(@)(@@) % ويذلني خطب وعزك قاهر % ويكاظني ظمأ وبحرك قد طما % % 26(@)(@@) % ويحل من لحمي الغداة لآكل % ما كان أمس على الخطوب محرما % % 27(@)(@@) % حاشى لما غرسته كف نداك أن % يذوى وما شادته أن يتهدما % % 28(@)(@@) % ولورد جودك أن يكدر شربه % ولوجه برك أن يرى متجهما % % 29(@)(@@) % ولحسن عفوك وهو أوفى ذمة % للجار أن يلقى لديك تهضما % % 30(@)(@@) % فأذقه من برد الندى نهلا فقد % جرعته بالسخط كأسا علقما % % PageV01P360 31(@)(@@) % وارجع إلى عاداتك الحسنى فما % % عودتني ألقاك إلا منعما % % 32(@)(@@) % و مدد إلي على تطاول غلتي % % كف العطاء بشربه يروى الظما % % PageV01P361 البحر : كامل 
ms94	 تام 1(@)(@@) % زفرات وجد ما يبوخ ضرامها % % ومدامع متناصر تسجامها % % 2(@)(@@) % وهوى يماطل بالقضاء غريمه % وصبابة ما يستفيق غرامها % % 3(@)(@@) % ليت البخيلة يهتدي لي طيفها % % إن كان لا يهدى إلي سلامها % % 4(@)(@@) % بيضاء ما عرف الحفاظ ودادها % % يوما ولا صحب الوفاء ذمامها % % 5(@)(@@) % ينضى عن الليل البهيم رداؤها % % ويماط عن فلق الصباح لثامها % % 6(@)(@@) % تثني ثثنها عزائم سلوتي % % ويقيم عذري في الغرام قوامها % % 7(@)(@@) % كم ليلة بتنا نروع ظلامها % % بزجاجة رقت وراق مدامها % % 8(@)(@@) % صرف كسرنا بالمزاج مزاجها % % لتلين شزتها فزاد عرامها % % 9(@)(@@) % وبثغرها أخرى ختام كؤوسها % % مسك ولكن لا يفض ختامها % % 10(@)(@@) % أتعود أيامي برامة بعد ما % % سكنت بجرعاء الحمى آرامها % % PageV01P362 11(@)(@@) % وأحلها البين المشت محلة % بعدت مراميها وعز مرامها % % 12(@)(@@) % سارقتها نظر الوداع فما ارتوت % نفس يزيد على الورود هيامها % % 13(@)(@@) % وتحادرت عبراتها فكأنها % % درد وهي يوم الفراق نظامها % % 14(@)(@@) % فكأنها رفعت سجوف خدورها % % زهر الربيع تفتحت أكمامها % % 15(@)(@@) % يا غادرين وغادروا بجوانحي % % لبعادهم نارا يشب ضرامها % % 16(@)(@@) % عافي وتتعب في الندى لوامها % % أسفا ولا كبدي يبل أوامها % % 17(@)(@@) % جودوا لعين المستهام بهجعة % فعسى تمثلكم لها أحلامها % % 18(@)(@@) % ولقلما طرق الخيال قريحة % بالدمع جريا للجفون منامها % % 19(@)(@@) % لا تتلفوا بالبين مهجة عاشق % سيان بين حميمها وحمامها % % 20(@)(@@) % أعداه من هيف الخصور نحولها % % ي إلى القيامة في الأنام قيامها % % PageV01P363 21(@)(@@) % لله در شبيبة ذهبت نضا % % رة حسنها وتصرمت أيامها % % 22(@)(@@) % ومآرب من عيشة سلفت وإن % بقيت لنا تبعاتها وآثامها % % 23(@)(@@) % تتصرم الدنيا ويذهب بؤسها % % ونعيمها وحلالها وحرامها % % 25(@)(@@) % تبقى على الأيام موصولا بأيا % % م الخلود بقاؤها ودوامها % % 27(@)(@@) % وإذا نتديتم للفخار فأنتم % عمالها علماؤها أعلامها % % 28(@)(@@) % غر الأيادي والمواهب غزرها % % بيض المجالي والوجوه وسامها % % 29(@)(@@) % آل النبوة بردها وقضيبها % % لكم ومنبرها معا وحسامها % % 31(@)(@@) % وأما ومن جعل الخلافة منحة % لكم يمينا برة أقسامها % % 32(@)(@@) % لتطبقن الأرض دعوتكم على % % رغم العدو وللأنوف رغامها % % 33(@)(@@) % ولتحكمن على أقاصي الروم عن % كثب فتنفذ بالظبى أحكامها % % PageV01P364 34(@)(@@) % ترد الخليج جيادها منشورة % راياتها منصورة 
ms95	 أعلامها % % 36(@)(@@) % ولينشرن المستضيء بجوده % أبناء عم المصطفى الهادي وخير % 37(@)(@@) % رب الصنائع والمنائح أثقلت % بالطول أعناق الملوك جسامها % % 38(@)(@@) % أعدا البلاد على المحول سخاؤه % ف هتز هامدها وأخصب عامها % % 40(@)(@@) % والله أكرم أن يحل عذابه % في أمة والمستضيء إمامها % % 41(@)(@@) % معطاؤها مطعامها مطعانها % % مقدامها صوامها قوامها % % 42(@)(@@) % بصلاحه صلحت لنا الدنيا وفي % % أيامه ابتسمت لنا أيامها % % 43(@)(@@) % ملأت مطالعها أشعة عدله % ف نجاب عنها ظلمها وظلامها % % 44(@)(@@) % ورمى العدى بصوائب من بأسه % ويد الخليفة لا تطيش سهامها % % 45(@)(@@) % دانت له الأملاك بعد شماسها % % طوعا وأذعن للقياد خطامها % % PageV01P365 46(@)(@@) % وأطاعه شرق البلاد وغربها % % وحجازها وعراقها وشآمها % % 47(@)(@@) % لولا تمسكها بطاعته لما % % صحت عقيدتها ولا إسلامها % % 48(@)(@@) % أنى لها بمراغم عن أمره % لو حاولته لسفهت أحلامها % % 49(@)(@@) % وبه عبادتها تتم ونسكها % % ونكاحها وصلاتها وصيامها % % 50(@)(@@) % فاسلم أمير المؤمنين لدولة % ما ريع مذ ردت إليك سوامها % % 51(@)(@@) % واحكم على الأيام مالك أمرها % % حكم المطاع ففي يديك زمامها % % 52(@)(@@) % ولتشكرنك أمة أوليتها % % نعماء ما خطرت بها أوهامها % % 53(@)(@@) % حصنت بيضتها بكل كتيبة % لا يرهب الموت الزؤام غلامها % % 54(@)(@@) % أنت الذي خضعت لعزة بأسه % وسطاه تيجان الملوك وهامها % % 55(@)(@@) % والكعبة البيت الحرام وإن سمت % شرفا فقومك صيدها وكرامها % % PageV01P366 56(@)(@@) % بعلاك يفخر حجرها وحطيمها % % وإليك ينسب ركنها ومقامها % % 58(@)(@@) % إن عز مذخورا أهانته وإن % جمعت ظباها فرقت أقلامها % % 59(@)(@@) % ولك الكتائب والجيوش إذا سرت % في ظلها طلس الفلا وبهامها % % 60(@)(@@) % والأعوجيات الجياد مغيرها % % يوم الوغا وصفونها وصيامها % % 61(@)(@@) % والأرض عامرها وغامرها وقود % جبالها ووهادها وإكامها % % 62(@)(@@) % والزاخرات وما بهن من الجوا % % ري المنشآت كأنها أعلامها % % 63(@)(@@) % ف ستجلها عربية تحلو معا % % نيها ويعذب في القلوب كلامها % % 65(@)(@@) % بولائكم ترجو النجاة وفيكم % يوم الخصام جدالها وخصامها % % 66(@)(@@) % وعليكم تعويلها في يومها % % 67(@)(@@) % هي ما ظفرت بها كريمة قومها % % وعليك يا خير الورى إكرامها % % PageV01P367 68(@)(@@) % مدحا إذا الشعراء يوما حاولت % عرفان مودعها نبت أفهامها % % 69(@)(@@) % وإذا جروا في حلبة وجرت إلى % % شأو تبين نقصهم وتمامها % % 70(@)(@@) % لهم 
ms96	 من الآداب شوك قتادها % % مرعى ولي سعداتها وثمامها % % 71(@)(@@) % فتلق أيام الهناء بنعمة % صاف نداها سابغ إنعامها % % 72(@)(@@) % يبلي الدهور جديدها وتكر عا % % ئدة بمثلها أعوامها % % PageV01P368 البحر : مجتث 1(@)(@@) % يا نائب الله في الأر % ض والخليفة عنه % 2(@)(@@) % فنحن نلتمس الرز % ق والمعونة منه % 3(@)(@@) % ألله آتاك فضلا % ورحمة من لدنه % 4(@)(@@) % فكيف يدرك بالشعر % من صفاتك كنه % 5(@)(@@) % فراع من راعه الآن % صرف دهر و عنه % 6(@)(@@) % أخنت عليه الليالي % % وعزمه لم يخنه % 7(@)(@@) % قد عاش في ثروة دهره فلا تحوجنه % ره فلا تحوجنه % 8(@)(@@) % واستر محياه عن بذ % لة السؤال وصنه % PageV01P369 البحر : بسيط تام 1(@)(@@) % سقاك سار من الوسمي هتان % ولا رقت للغوادي فيك أجفان % 2(@)(@@) % رابي وللهو و % الأطراب أوطان % 3(@)(@@) % أعائد لي ماض من جديد هوى % أبليته وشباب فيك فينان % 4(@)(@@) % إذ الرقيب لنا عين مساعدة % والكاشحون لنا في الحب أعوان % 5(@)(@@) % وإذ جميلة توليني الجميل وعند % الغانيات وراء الحسن إحسان % 6(@)(@@) % ولي إلى البان من رمل الحمى طرب % فاليوم لا الرمل يصبيني ولا البان % 7(@)(@@) % وما عسا يدرك المشتاق من وطر % إذا بكى الربع والأحباب قد بانوا % % 10(@)(@@) % وليلة بات يجلو الراح من يدشه % فيها أغن خفيف الروح جذلان % 11(@)(@@) % خال من الهم في خلخاله حرج % فقلبه فارغ والقلب ملآن % 12(@)(@@) % يذكي الجوى بارد من ثغره شبم % ويوقظ الوجد طرف منه وسنان % PageV01P370 13(@)(@@) % إن يمس ريان من ماء الشباب فلي % % قلب إلى ريقه المعسول ظمآن % 14(@)(@@) % بين السيوف وعينيه مشاركة % من أجلها قيل للأغماد أجفان % 15(@)(@@) % فكيف أصحو غراما أو أفيق هوى % % وقده ثمل الأعطاف نشوان % 16(@)(@@) % أفديه من غادر بالعهد غادرني % % صدوده ودموعي فيه غدران % 17(@)(@@) % في خده وثناياه ومقلته % وفي عذاريه للمعشوق بستان % 18(@)(@@) % شقائق وأقاح نبته خضل % ونرجس عبق غض وريحان % 19(@)(@@) % ما زال يمزج كأسي من مراشفه % بقهوة أنا منها الدهر سكران % 20(@)(@@) % والليل ترمقني شزرا كواكبه % كأنه من دنوي منه غيران % 21(@)(@@) % حتى توالت تؤم الغرب جانحة % منها إليه زرافات 
ms97	 وأحدان % 22(@)(@@) % كأنها نقد بالدو نفرها % % لما بدا ذنب السرحان سرحان % PageV01P371 23(@)(@@) % أو فل جيش على الأعقاب منهزم % مالت بأيديهم للطعن خرصان % 24(@)(@@) % فقام يسحب بردا ضوعت عبقا % وجه الثرى منه أذيال وأردان % 25(@)(@@) % شوط من العمر أنضيت الشبيبة في % % ميدانه فرحا والعمر ميدان % 26(@)(@@) % أيام شرخ شبابي روضة أنف % ما ريع منه بوخط الشيب ريعان % 27(@)(@@) % تقر بي عين ندماني فها أنا قد % أمسيت ما لي غير الهم ندمان % 28(@)(@@) % فليت شعريا راض من كلفت به % أم معرض هو عني اليوم غضبان % 29(@)(@@) % من بعد ما صرت في حبي له مثلا % فسر وجدي به في الناس إعلان % 31(@)(@@) % الناصر الدين والحامي حماه ومن % وللخلافة عزم منه يقظان % 32(@)(@@) % خليفة ظاعة الرحمن طاعته % حق ا وعصيانه لله عصيان % 33(@)(@@) % إذا تمسكت في الدنيا بطاعته % فما لسعيك عند الله كفران % PageV01P372 34(@)(@@) % تسخو بكل نفيس نفسه ويرى % % أن النفائس للعلياء أثمان % 35(@)(@@) % رب الجياد من النقع المثار لها % % براقع ومن الخطي أرسان % 36(@)(@@) % تحذو قوائمها التبر النضار فمن % نعالها للملوك الصيد تيجان % 38(@)(@@) % تردي الأعادي عليها حين تبعثها % % قبا كما نبعثت تشتد ذؤبان % 39(@)(@@) % فاعجب لميمونة الأعراف ميسمها % % نصر وفيها لمن عاداه خذلان % 40(@)(@@) % لا يغمد السيف إلا في الكمي ولا % % يستصحب النصل إلا وهو عريان % 41(@)(@@) % يذكي الأسنة في ليل العجاج كما % % يذكى لباغي القرى في الليل نيران % 42(@)(@@) % تعشو السباع إليها حين يرفعها % % ظامي الحشا وخميص البطن طيان % 43(@)(@@) % تستطعم البيض في كفيه محدقة % به كما أحدقت بالبيت ضيفان % 44(@)(@@) % على خوان من القتلى كأنهم % على التباين من حوليه إخوان % PageV01P373 45(@)(@@) % فيا له من مضيف طالما عقرت % على مقاربه أبطال وأقران % 47(@)(@@) % نمته من غالب غلب غطارفة % بيض المآثر والأحساب غران % 49(@)(@@) % صوم الهواجر هجيراهم ولهم % إذا سجا الليل تسبيح وقرآن % 50(@)(@@) % حازوا تراث رسول الله و تصلت % لهم بدوحته الغناء عيدان % 51(@)(@@) % حلفت بالعيس أمثال القسي على % % أكوارها كقسي النبع ركبان % 52(@)(@@) % كأنها والموامي يرتمين بها % % نواجيا تخبط الظلماء 
ms98	 ظلمان % 53(@)(@@) % من كل مجفرة الجنبين تامكة % كأن ما ضم منها الرحل بنيان % 54(@)(@@) % أذابها للسرى ط % وع الأزمة اع % 55(@)(@@) % حتى لعادت وفي أنساعها ضمرا % منها نسوع وفي الأقران أقران % 56(@)(@@) % تهوي بكل منيب القلب تحفره % تقية ملء جنبيه وإيمان % PageV01P374 57(@)(@@) % شعثا يميلون من سكر اللغوب كما % % تمايلت في ذرى الأحقاف أغصان % 58(@)(@@) % يرجون مكة والبيت المحجب أن % يبدو لهم منه أستار وأركان % 59(@)(@@) % أموا جوادا إذا حلوا به وسعت % ذنوبهم رحمة منه ورضوان % 60(@)(@@) % والمشعرات الهدايا في أزمتها % % من الغوارب أنقاء وكثبان % 61(@)(@@) % يقتادها في حبال الذل خاضعة % أعناقها أنها لله قربان % 62(@)(@@) % صورا إلى الشعرات البيض قد خضبت % مشافر بالدم القاني وأدقان % 63(@)(@@) % لولا ولاء بني العباس ما ثقلت % لمفلس مخسر في الحشر ميزان % 64(@)(@@) % أنتم وقد بين الفرقان فضلكم % بين الهدى وضلال البغي فرقان % 65(@)(@@) % يا ناشر العدل في الدنيا ومنشره % ومن به تفخر الدنيا وتزدان % 66(@)(@@) % وموسع الدهر والأيام إن سفهت % حلما يخف له قدس وثهلان % PageV01P375 67(@)(@@) % لم يبق للجور سلطان على أحد % أنى وأنت لأهل الأرض سلطان % 68(@)(@@) % قالوا القران وطوفان الهواء له % بالشر عن كثب في الأرض طغيان % 69(@)(@@) % أما لهم فيه برهان وطائرك الميمون فيه لدفع الشر برهان % ون فيه لدفع الشر برهان % 70(@)(@@) % وكيف تسطو الليالي أو يكون لها % % في عصر مثلك إرهاق وعدوان % 71(@)(@@) % وأنت في كل علوي له أثر % مؤثر وعلى الطوفان طوفان % 72(@)(@@) % سعادة لو أحاط الخازمي بها % % لعاد فيما ادعاه وهو خزيان % 73(@)(@@) % ف سعد بها دولة غراء ما درعت % بمثلها حمير قدما وساسان % 74(@)(@@) % و سلم تدوم لك النعمى فإنك ما % % سلمت في جذل فالدهر جذلان % 75(@)(@@) % لا زلت بدر السماء يستضيء به % ويهتدي مظلم منا وحيران % 76(@)(@@) % ولا سعى لك صرف الدهر في حرم % ولا رأى من يرجوك حرمان % PageV01P376 البحر : مجزوء الكامل 1(@)(@@) % رب الزمان أجل قد % را أن يهنى بالزمان % 2(@)(@@) % لكنها العادات في % % رفع المدائح والتهاني % % 5(@)(@@) % أضحى بسيرته الأنام % من الحوادث في 
ms99	 أمان % 6(@)(@@) % أفنى بذابله ونائله % الأعادي والأماني % % 7(@)(@@) % لا زلت محفوظ العلى % % يلقى الندى والعفو عف % 8(@)(@@) % جذلان مخضر الندى % % والعود محمر السنان % 9(@)(@@) % ما فتر في وجه الربيع % الطلق ثغر الأقحوان % 10(@)(@@) % و ستخدمت عون القوافي % % فيك أبكار المعاني % % PageV01P377 البحر : طويل 1(@)(@@) % ليهنك أني في حبالك عاني % % وأنك مني في أعز مكان % 2(@)(@@) % وأني ضعيف في هواك تجلدي % % على أنني جلد على الحدثان % 3(@)(@@) % حمول لاعباء الملمات كاهلي % % وما لي بما حملتنيه يدان % 4(@)(@@) % ملكت أبيا من قيادي ولم يكن % ليصحب إلا في يديك عناني % % 5(@)(@@) % نأيت فحرمت الجفون عن الكرى % % وأغريت دمع العين بالهملان % 6(@)(@@) % وأعهد قبل البين قلبي يطيعني % % ولكنه يوم الوداع عصاني % % 7(@)(@@) % وما زال مطبوعا على الصبر قلبا % سواء بعاد عنده وتداني % % 8(@)(@@) % فما باله يوم النوى سار منجدا % مع الركب في أسر الصبابة عاني % % 9(@)(@@) % فليت طبيبا أمرضتني جفونه % وفي يده منها الشفاء شفاني % % 10(@)(@@) % وليت غريمي في الهوى وهو واحد % تحرج من ليانه فقضاني % % PageV01P378 11(@)(@@) % ولولا الهوى يا آل خنساء لم تكن % لتملكني فيكم خضيب بنان % 12(@)(@@) % ولا بت في أبياتكم سائلا قرى % % بغير القنا أو طالبا لأمان % 13(@)(@@) % أرجي جواد الكف عطف بخيلة % وأخشى حديد القلب فتك جبان % 14(@)(@@) % وقبلك ما أنهضت عزمي لحاجة % وأدركتها إلا بحد سنان % 15(@)(@@) % وأولى بمثلي أن يكون مهاده % سراة حصان لا سرير حصان % 16(@)(@@) % وبي أنف أن أقتضي بسرى الظبى % % ديوني لو غير الحبيب لواني % % 17(@)(@@) % ومن كان مجد الدين عونا وناصرا % له لم يطامن منكبا لهوان % 18(@)(@@) % ولم يخش من ريب الزمان ولم يجد % إليه سبيلا طارق الحدثان % 19(@)(@@) % فتى أصبح المعروف والعفو عنده % عتادا لعاف يجتديه وجاني % % 20(@)(@@) % وأدنت له الآمال وهي نوازح % سحائب جود من يديه دواني % % PageV01P379 21(@)(@@) % ندى صدقت للشائمين بروقه % وما كل برق صادق اللمعان % 22(@)(@@) % وهذب أخلاق الليالي فردها % % عواطف من بعد الجفاء حواني % % 23(@)(@@) % وجدد آثار المكارم بعد ما % % عفت أربع من أهلها ومغاني % % 24(@)(@@) % وكنا سمعنا الجود يروى 
ms100	 حديثه % فنحن نراه اليوم رأي عيان % 25(@)(@@) % بعيد المدى داني الندى من عفاته % فلله منه النازح المتداني % % 26(@)(@@) % رحيب المغاني ضيق البأس والندى % % معاذيره يومي قرى وطعان % 27(@)(@@) % كريم إذا ستكفيته أمر حادث % كفاني وإن رمت الحباء حباني % % 28(@)(@@) % سعى بين حالي والغنى جود كفه % فأصلح ما بيني وبين زماني % % 29(@)(@@) % وصلت على الأيام من حد عزمه % بأبيض ماضي الشفرتين يماني % % 30(@)(@@) % أغر هجان ينتمي من فعاله % إلى شيم مثل الصباح هجان % PageV01P380 31(@)(@@) % يريك وقارا في الندي كأنه % شماريخ رضوى أو هضاب أبان % 32(@)(@@) % ورأيا يفل المشرفي وهمة % تناط بعزم صادق وجنان % 33(@)(@@) % وبأسا يشاب السخط منه برأفة % فشدته ممزوجة بليان % 34(@)(@@) % وكم فرق الأبطال يوم كريهة % وأحرز خصل السبق يوم رهان % 35(@)(@@) % مآثر لو كنت بن حجر فصاحة % لقصر عن إحصائهن بياني % % 36(@)(@@) % فداء لمجد الدين كل مقصر % به السعي عن طرق المكارم واني % % 37(@)(@@) % يداجيه إجلالا وتحت ابتسامه % كمين من البغضاء والشنآن % 38(@)(@@) % توقد نار الغيظ بين ضلوعه % ولكنها نار بغير دخان % 39(@)(@@) % يروم مساعيه بغير كفاية % وقد حيل بين العير والنزوان % 40(@)(@@) % تهن أبا الفضل الجواد برتبة % سما عن مجار قدرها ومداني % % PageV01P381 41(@)(@@) % لها مرتقى دحض إذا رام حاسد % رقيا لها زلت به القدمان % 42(@)(@@) % ملأت أكف الراغبين مواهبا % فشكرك مملوء به الملوان % 43(@)(@@) % وسرت من الإحسان والعدل سيرة % بها سار قدما في الورى العمران % 44(@)(@@) % وقمت بأعباء الخلافة ناهضا % وقد نام عنها العاجز المتواني % % 45(@)(@@) % فلا عدمت منك الممالك همة % تبيت وفي تدبيرها الثقلان % 46(@)(@@) % ولا زال مأهولا جنابك يلتقي % % مواسم أفراح به وتهاني % % 47(@)(@@) % وسمعا لما حبرته من مدائح % فصاح إذا ستجليتهن حسان % 48(@)(@@) % ضمنت لك الإحسان عنها فقد وفى % % لمجدك فيها خاطري بضماني % % 49(@)(@@) % وسيرتها تطوي البلاد شواردا % بها العيس بين النص والوخدان % 50(@)(@@) % كرائم ما عرضتهن لخاطب % سواك فلم أسمح بهن لباني % % PageV01P382 51(@)(@@) % فإن عقيلات الكرام إذا بنى % % بهن سوى الكفوء الكريم زواني % % 52(@)(@@) % تلين قيادا للكريم وإنها % % لكل لئيم الصهر ذات حران 