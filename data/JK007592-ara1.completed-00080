ms61	 صاحب يسخر في موعده ، % فأحمد الله ، ولا أحمده % 2(@)(@@) % زرع المنى بقوله لفظة ، % ثم مطال بعده يحصده % PageV01P340 البحر : منسرح 1(@)(@@) % لا خير في العالمين كلهم ، % و لا من العالمين منفردا % % 2(@)(@@) % لا يسلم المرء حين يصلح من % % ذم حسود ، فكيف إن فسدا % % PageV01P341 البحر : طويل 1(@)(@@) % ومشمولة قد طال بالقفص حبسها ، % حكت نار إبراهيم في اللون والبرد % 2(@)(@@) % حططنا إلى خمارها بعد هجعة % رحال مطايا لم تزل يومها تخدي % % 3(@)(@@) % ملوك للذات الشباب تواضعوا ، % ولم يحلفوا فيها بذم ولا حمد % 4(@)(@@) % فباتوا لدى الخمار في بيت حانة ، % وأخلوا قصورا بالرصافة والحد % 5(@)(@@) % و دام عليهم بالمدام ممنطق % بزناره ، حلو الشمائل والقد % 6(@)(@@) % يمج سلاف الخمر في عسجدية ، % توهج في يمناه كالكوكب الفرد % 7(@)(@@) % محفرة فيها تصاوير فارس ، % وكسرى غريق حوله خرق الجند % PageV01P342 البحر : كامل تام 1(@)(@@) % قم يا نديمي نصطبح بسواد ، % قد كاد يبدو الصبح أو هو باد % 2(@)(@@) % وأرى الثريا في السماء كأنها % % قدم تبدت في ثياب حداد % 3(@)(@@) % فأجابني بيمينها ، فملأتها % % بزجاجة كالكوكب الوقاد % 4(@)(@@) % يا صاح لا يخدعك ساعة غقفلة % عن لذة ، أو فكرة لمعاد % 5(@)(@@) % واشرب على طيب الزمان فقد حدا % % بالصيف من أيلول أسرع حاد % 6(@)(@@) % وأشمنا في الليل برد نسيمه ، % وارتاحت الأرواح في الأجساد % 7(@)(@@) % وافاك بالأنداء قدام الحيا ، % فالأرض للأمطار في استعداد % 8(@)(@@) % كم في ضمائر تربها من روضة ، % بمسيل ماء ، أو قرارة واد % 9(@)(@@) % تبدو ، إذا جاء الزمان بقطرة ، % فكأنما كانا على ميعاد % PageV01P343 البحر : طويل 1(@)(@@) % و نار قد حناها صباحا بسحرة ، % متى ما يرق ماء عليها توقد % 2(@)(@@) % يجول حباب الماء في جنباتها ، % كما جال دمع فوق خد مورد % PageV01P344 البحر : طويل 1(@)(@@) % ألا رب يوم بالدويرة صالح ، % فكيف بيوم بعده لي فاسد % 2(@)(@@) % ظللت بها أسقى سلافة خمرة % بكف غزال ذي جفون صوائد % 3(@)(@@) % على جدول ريان لا يكتم القذى ، % كأن سواقيه متون المبارد % PageV01P345 البحر : سريع 1(@)(@@) % غدا بها صفراء كرخية ، % كأنها في كأسها تتقد % 2(@)(@@) % و تحسب زجاجا جرى ، % و تحسب 
ms62	 الأقداح ماء جمد % PageV01P346 البحر : كامل تام 1(@)(@@) % قم يا نديمي من منامك واقعد ، % حان الصباح ومقلتي لم ترقد % 2(@)(@@) % أما الظلام ، فحين رق قميصه ، % و أرى بياض الفجر كالسيف الصدى % % PageV01P347 البحر : بسيط تام 1(@)(@@) % هل لك في ليلة بيضاء مقمرة ، % كأنها فضة ذابت على البلد % 2(@)(@@) % و قهوة كشعاع الشمس صافية ، % كأن أقداحها قد عمن بالزبد % PageV01P348 البحر : وافر تام 1(@)(@@) % و ليل قد سهرت ونام فيه % ندامى صرعوا حولي رقودا % % 2(@)(@@) % أسامر فيه قهقهة القناني ، % ومزمارا يحدثني وعودا % % 3(@)(@@) % يكاد الليل يرجمني بنجم ، % و قال : أراه شيطانا مريدا % % PageV01P349 البحر : طويل 1(@)(@@) % خليلي قد طاب الشراب المبرد ، % و قد عدت بعد الشك والعود أحمد % 2(@)(@@) % فهاتا عقارا في قميص زجاجة % كياقوتة في درة تتوقد % 3(@)(@@) % يصوغ عليها الماء شباك فضة ، % لها حلق بيض تحل وتعقد % 4(@)(@@) % وغنى لنا في جوفها حبشية ، % عليها سراويل من الماء مجسد % 5(@)(@@) % فظاهرها حلم صبور على الأذى ، % و باطنها جهل يقوم ويقعد % 6(@)(@@) % و لما جنيناها قطافا روية % تذوب ، إذا مست عناقيدها اليد % PageV01P350 البحر : طويل 1(@)(@@) % ومقتول سكر عاش لي ، إذ دعوته ، % و بادر مسرورا يرى غيه رشدا % % 2(@)(@@) % وقام بكفيه بقايا خماره ، % و عيناه من خديه قد جفتا قدا % % PageV01P351 البحر : منسرح 1(@)(@@) % أهلا وسهلا بالناي والعود ، % وكأس ساق كالغصن مقدود % 2(@)(@@) % قد انقضت دولة الصيام ، وقد % % بشر سقم الهلال بالعيد % PageV01P352 البحر : خفيف تام 1(@)(@@) % عللاني بصوت ناي وعود ، % و اسقياني دم ابنة العنقود % 2(@)(@@) % أشرب الراح وهي تشرب عقلي ، % و على ذاك كان قتل الوليد % 3(@)(@@) % رب سكر جعلت موعده الصب % % ح ، وساق حثثته بمزيد % PageV01P353 البحر : رمل تام 1(@)(@@) % يا ليالي القديمات ارجعي ، % قد تخلفت بليلات شداد % 2(@)(@@) % نبأ خبرته من معشر ، % أخرجت أضغانهم حيات واد % 3(@)(@@) % إنني ذاك الذي جربتهم ، % لم يطل عهدي بإرغام الأعادي % % 4(@)(@@) % فمن الآن ، فكروا وارجعوا ، % فالذي تخشون أحلى في فؤادي % % 5(@)(@@) % ولحا الرحمن منا طالب ال % % صلح والأطوع في حبل القياد % 6(@)(@@) % وعلى الأظلم منا سخط الل % ه ، والأنكب 
ms63	 عن سبل الرشاد % 7(@)(@@) % أقدموا قبل رماح أشرعت ، % و سيوف ذات عص وصعاد % 8(@)(@@) % ثم إياي وأخرى مثلها ، % تكحل العين بمملول السهاد % 9(@)(@@) % وخذوا عفوي ما دمت لكم ، % يد أخذ ، والحقوا بعض ودادي % % 10(@)(@@) % لا تعودوا فيعد إسخاطه ، % واتركوا سيفي في بعض الغماد % PageV01P354 11(@)(@@) % أو فإني مسرع ، إن شئتم ، % بحسام مشرفي ، وجواد % 12(@)(@@) % و قناة فوقها كوكبها ، % و مجن ، كل هذا في بلادي % % 13(@)(@@) % و غذا قلت اركبوا قد حضروا ، % جملة الناس بأسياف حداد % 14(@)(@@) % و لقد ضاعت أياد عندكم ، % غرست في ترب غير جياد % 15(@)(@@) % أودعت قمحا ، فلما نثرت % كل أرض أنبتت شوك القتاد % % 16(@)(@@) % فجزاها لعنة لصاحب ، % ليس للزراع أصلا من معاد % 17(@)(@@) % حين وترت لكم أقواسكم ، % قمتم بالنبل ترمون سوادي % % 18(@)(@@) % أيها الموعد قد أسمعتني ، % ثم لم يثبت من الهم وسادي % % 19(@)(@@) % سوف تجني أنت ما تغرس لي ، % و تمس النار من قرع زنادي % % 20(@)(@@) % رب من قد كادني في ليلة ، % وهو في يوم الوغى باسمي ينادي % % PageV01P355 21(@)(@@) % حين خلى رسني جاذبه ، % وامحى قرطاس شيبي من مدادي % % 22(@)(@@) % ثم يغدو مرحا إن سبني ، % و يرى لحمي من أطيب زاد % 23(@)(@@) % ويظن الدهر نقدا كله ، % ثم يلقاني على طول البعاد % 24(@)(@@) % كيف يرجون اهتضامي بعدها ، % طال باعي ، وردائي ونجادي % % 25(@)(@@) % و لعذر لهم لو قبلها % % لم يروا إلا قداحي و زنادي % % 26(@)(@@) % إن يكونوا قد نسوا تلك ، فلي % % عودة تذعرهم حر جلادي % % 27(@)(@@) % طال حلمي عنهم ، فاستحدثوا % % خلقا مكروهة ، عريان بادي % % 28(@)(@@) % خلقا يخضب أطراف القنا ، % و متون النبل والبيض الصوادي % % 29(@)(@@) % بطعان نافذ يفري الحشا ، % و بضرب مثل أفواه المزاد % PageV01P356 البحر : كامل تام 1(@)(@@) % ما بالمنازل لو سألت أحد ، % ولقد يكون هوي بهن وود % 2(@)(@@) % أزمان أمرح في زمان صبا ، % أجري إلى اللهو ، ولست أرد % 3(@)(@@) % و الدهر لا تمحى ملاحته % % في أعصر أيامهن جدد % 4(@)(@@) % عز بفجع الدهر متبع % للهو ، حتى قام بي وقعد % 5(@)(@@) % في غفلة لا هم يعرفها ، % فطفقت أهزل بالزمان وجد % PageV01P357 البحر : طويل 
ms64	 1(@)(@@) % أرقت جميع الليل للبارق الذي % % ترفع مع نجد ، فشاق إلى نجد % 2(@)(@@) % أحل بدار اللهو حيث لقيتها ، % وأهزل باللذات ، والدهر في جد % 3(@)(@@) % ألا إنما الدنيا بلاغ لغاية ، % فإما إلى غي ، وإما إلى رشد % PageV01P358 البحر : متقارب تام 1(@)(@@) % و لما عدت خيلنا للطراد % جعلنا إلى الدير ميعادها % % 2(@)(@@) % وقاد مكلبنا ضمرا ، % سلوقية طالما قادها % % 3(@)(@@) % معلمة من بنات الريا % % ح ، إذا سألت عدوها زادها % % 4(@)(@@) % وتخرج أفواهها ألسنا % كشق الخناجر أغمادها % % 5(@)(@@) % فأمسكن صيدا ، ولم تدمه ، % كضم الكواعب أولادها % % PageV01P359 البحر : وافر تام 1(@)(@@) % وفتيان غدوا ، والليل داج ، % وضوء الصبح متهم الورود % 2(@)(@@) % كأن بزاتهم أمراء جيش % على أكتافهم صدأ الحديد % PageV01P360 البحر : رجز تام 1(@)(@@) % غدوت للصيد بغضف كالقتد ، % و الليل قد رق على وجه البلد % 2(@)(@@) % وابتل سربال النسيم وبرد ، % و الفجر في ليل الظلام يتقد % % 3(@)(@@) % غواضف مسهلات للأمد ، % لما عدون وعدت خيل الطرد % % 4(@)(@@) % و تقتفى الأرجل الغمام ، وقعد ، % و طار نقع في السماء وركد % % 5(@)(@@) % مثل القريب عندها ما قد بعد % . . . . . . . . . . . . . . . . % PageV01P361 البحر : وافر تام 1(@)(@@) % و صوت حمامة سجعت بليل ، % و قد حنت إلى إلف بعيد % 2(@)(@@) % فما زلنا نقول لها : أعيدي ، % وللساقي : ألا هل من مزيد % PageV01P362 البحر : خفيف تام 1(@)(@@) % زارني ، والدجى أحم الحواشي ، % و الثريا في الغرب كالعنقود % 2(@)(@@) % وهلال السماء طوق عروس ، % بات يجلى على غلائل سود % PageV01P363 البحر : طويل 1(@)(@@) % شربنا عصير الكرم تحت ظلاله ، % على وجه معشوق الشمائل أغيد % 2(@)(@@) % كأن عناقيد الكروم وظلها ، % كواكب در في سماء زبرجد % PageV01P364 البحر : مجتث 1(@)(@@) % حمامنا كعجوز % يشقى به الوارد % 2(@)(@@) % فبيت له منتن ، % وبيت له بارد % PageV01P365 البحر : طويل 1(@)(@@) % روينا ، فما نزداد يا رب من حيا ، % و أنت على ما في النفوس شهيد % 2(@)(@@) % سقوف بيوتي صرن أرضا أدوسها ، % و حيطان داري ركع وسجود % PageV01P366 البحر : بسيط تام 1(@)(@@) % لم يبق في العيش غير البؤس والنكد ، % فاهرب إلى الموت من هم ، ومن نكد % 2(@)(@@) % ملأت يا دهر عيني من مكارهها ، % يا دهر حسبك قد أسرفت 
ms65	 ، فاقتصد % PageV01P367 البحر : طويل 1(@)(@@) % ألست ترى موت العلى والمحامد ، % و كيف دفنا الخلق في قبر واحد % 2(@)(@@) % وللدهر أيام تسيء عواقبا ، % وتحسن ، إن أحسن ، غير عوامد % PageV01P368 البحر : طويل 1(@)(@@) % فإن تسألاني فيم حزني ، فإنه % % لشخص ثوى ، بين القبور ، فقيد % 2(@)(@@) % و ما كنت أخشى أن تحول نظرتي % % إلى شامت من غابط وحسود % % PageV01P369 البحر : بسيط تام 1(@)(@@) % يا صاحبي قد كفاك الدهر تفنيدي ، % جزعت من لحظات الكاعب الرود % 2(@)(@@) % وأرسل الشيب في رأسي ومفرقه ، % بزاته البيض في غربانه السود % PageV01P370 البحر : طويل 1(@)(@@) % هو الدهر قد جربته وعرفته ، % فصبرا على مكروهه وتجلدا % % 2(@)(@@) % وما الناس إلا سابق ثم لاحق ، % وآبق موت ثم يأخذه غدا % % PageV01P371 البحر : وافر تام 1(@)(@@) % أتاك الورد محبوبا مصونا ، % كمعشوق تكنفه الصدود % 2(@)(@@) % كأن بوجهه ، لما توافت % نجوم في مطالعها سعود % 3(@)(@@) % بياض في جوانبه احمرار ، % كما احمرت من الخجل الخدود % PageV01P372(@)(@@)(@@)(@@) | البحر : خفيف تام 1(@)(@@) % مر عيش علي قد كان لذا ، % و دهتني الأيام فيها وحذا % % 2(@)(@@) % وانثنى عني الشباب ، وغودر % ت فريدا من الأحبة فذا % % 3(@)(@@) % بضمير لا لهو فيه ، وقلب % و قذته قوارع الدهر وقذا % % 4(@)(@@) % و خليل صاف ، هني ، مري ، % جبذته الأيام مني جبذا % % 5(@)(@@) % بقعة من بقاع قرة عيني ، % هي أمرى بقاع ودي ، وأغذى % % 6(@)(@@) % ليت شعري أحاله مثل حالي ، % إذ صفا عيشه له ، والتذا % % 7(@)(@@) % سيف حكم في مفصل الحق ماض ، % شحذته تجارب الدهر شحذا % % 8(@)(@@) % ما أراني وإن تحلى لي الإخ % % وان من بعده لهم مستلذا % % 9(@)(@@) % قد رماني فيه الزمان بسهم ، % ينفذ الجوف والتراقي نفذا % % 10(@)(@@) % سره الله حيث كان ، فما كا % % ن أسر الدنيا به ، وألذا % % PageV01P373 11(@)(@@) % ولقد أغتدي على طرف الصب % % ح بطرف ، إذا ونى الجري ، بذا % % 12(@)(@@) % طاعن في العنان يستنكر السو % % ط مدلا ، ويأخذ الأرض أخذا % % 13(@)(@@) % و غذا ما عدا ، فنار أذاعت % % بدخان تهذه الريح هذا % % 14(@)(@@) % بحر شر يشاغب الصخر قرعا % بصخور وينبذ الترب نبذا % % 15(@)(@@) % يصرع العير والشبوب ، ولا أد % % ري أهذا إليه أقرب أم 
ms66	 ذا ؟ % 16(@)(@@) % أن تريني ، يا شر ، خلفت أيا % % مي صبا كان ناعم البال لذا % % 17(@)(@@) % ومشى الشيب قبل عقد الثلاثي % % ن فلما انتهى إليها أغذا % % 18(@)(@@) % ونهى عني العيون المريضا % % ت ، وأنضى ركب الهوى ، فأرذا % % 19(@)(@@) % فبحمد الإله إن جميع الخل % ق ، قد كان بعضه قبل شذا % % 20(@)(@@) % وأنا الواضح الذي إن تبدى % % يعرفوه ، ولا يقولون : من ذا ؟ % PageV01P374 21(@)(@@) % و قويم كالخط يزداد لينا ، % بدماء الأحشاء والجوف يغذى % % 22(@)(@@) % ذاك عندي ، وقد جمعت إليه % % رسل موت صوائب الوقع حذا % % 23(@)(@@) % ودروعا كأنها وجه ماء ، % صافحته ريح ، وعضبا محذا % % PageV01P375 البحر : رجز تام 1(@)(@@) % أنعت أمثالا قذذت قذا ، % يشحذها السوط البطين شحذا % % 2(@)(@@) % تواريا خلف الظباء حذا ، % كأنما يجبذهن جبذا % % 3(@)(@@) % يجذ غيطان الفلاة جذا ، % كالنبل هذتها القسي هذا % % 4(@)(@@) % لم أدر ذا أسرع شدا أم ذا % . . . . . . . . . . . . . . . . . . % PageV01P376 البحر : متقارب تام 1(@)(@@) % وبات كما سر أعداءه ، % إذا رام قوتا من النوم شذ % 2(@)(@@) % تغيره نزوات البعوض % في قمر مثل ظهر الجرذ % PageV01P377 (@)(@@)(@@)(@@) | (@)(@@) البحر : طويل 1(@)(@@) % سأثني على عهد المطيرة والقصر ، % وأدعو لها بالساكنين وبالقطر % 2(@)(@@) % خليلين لي إن الدما تريانه ، % فصبرا ، وإلا أي شيء سوى الصبر % 3(@)(@@) % عسى الله أن يتاح لي منه فرجة ، % يجيء بها من حيث أدري ولا أدري % % 4(@)(@@) % سألتكما بالله ما تعلمانني ، % و لا تكتما شيئا ، فعندكما خبري % % 5(@)(@@) % أأرفع نيران القرى لعفاتها ، % و أضرب يوم الروع في ثعرة الثغر % 6(@)(@@) % وأسأل نيلا لا يجاد بمثله ، % فيفتحه بشري ، ويختمه عذري % % 7(@)(@@) % ويا رب يوم لا تورى نجومه ، % مددت إلى المظلوم فيه يد النصر % 8(@)(@@) % فسبحان ربي ما لقوم أرى لهم % % كوامن أضغان عقاربها تسري % % 9(@)(@@) % إذا ما اجتمعنا في الندي تضاءلوا ، % كما خفيت مرضى الكواكب في الفجر % 10(@)(@@) % بنو العم لا بل هم بنو الغم والأذى ، % وأعوان دهري إن تظلمت من دهري % % PageV01P378 11(@)(@@) % وغاظهم المجد الذي لا يناله % لئيم ولا وان ضعيف عن الوتر % 12(@)(@@) % فدونكم الفعل الذي أنا فاعل ، % فإنكم مثلي ، إذا ، ولكم فخري % % 13(@)(@@) % نمتني إلى عم النبي 
ms67	 خلائق ، % علوا فوق أفلاك الكواكب والبدر % 14(@)(@@) % بنو الحبر والسجاد والكامل الذي % % وفى الملك حتى قر عند ذوي الأمر % 15(@)(@@) % ونحن رفعنا سيف مروان عنكم ، % فهل لكم ، يا آل أحمد ، في الشكر % 16(@)(@@) % أبو الفضل أولى الناس بالفضل كلهم ، % تعالوا نحاكمكم إلى البيت والحجر % 17(@)(@@) % و يوم حنين حين صاح وراءكم ، % فجئتم ، وكان الموت أقرب من شبر % 18(@)(@@) % ويا معشر الأنصار من كان عاقدا % ببيعتكم ، والدين في قبضة الكفر % 19(@)(@@) % و لولاه ما قرت بطيبة هجرة ، % و لولاه لم تجر الجياد على بدر % 20(@)(@@) % أقام بدار الكفر عينا على العدى ، % ينبي نبي الله بالكبد والغدر % PageV01P379 21(@)(@@) % لذلك لم ترقد جفون محمد % نبي الهدى حتى أريح من الأسر % 22(@)(@@) % ورد عليه ماله دون غيره ، % فإن كنت ذا جهل فسل كل ذي خبر % 23(@)(@@) % ولولا بلوغ السن منها ، وكفها % % سراجيه لما أتى آخر العمر % 24(@)(@@) % لأعطى أبا حفص يدير عنانها ، % و ما شك فيه والأمور إلى قدر % 25(@)(@@) % ألم تره من قبل ، حين أقامه % % شفيعا لأصحاب النبي إلى القطر % PageV01P380 البحر : طويل 1(@)(@@) % شجتك لهند دمنة وديار ، % خلاء كما شاء الفراق قفار % 2(@)(@@) % سليني إذا ما الحرب ثارت بأهلها ، % و لم يلك فيها للجبال قرار % 3(@)(@@) % ودارت رحي الموت والصبر قطبها ، % و أكثر ما فيها دم وغبار % 4(@)(@@) % و قام لها الأبطال بالبيض والقنا ، % وهبت رياح الآخرين فطاروا % % 5(@)(@@) % وقد علم المقتول بالشام أنني % % أريد به من رامني ، وأغاروا % % 6(@)(@@) % إذا شئت أوقرت البلاد حوافرا ، % و سارت ورائي هاشم ونزار % 7(@)(@@) % وعم السماء النقع حتى كأنه % % دخان ، وأطراف الرماح شرار % 8(@)(@@) % وبي كل خوار العنان كأنه ، % إذا لاح في نقع الكتيبة ، نار % 9(@)(@@) % وقمص حديد ضافيات ذيولها ، % لها حدق خزر العيون صغار % 10(@)(@@) % و بيض كأنصاف البدور أبية ، % إذا امتحنتهن السيوف ، خيار % PageV01P381 11(@)(@@) % و كم عاجم عودي تكسر نابه ، % إذا لان عيدان اللئام وخاروا % % PageV01P382 البحر : بسيط تام 1(@)(@@) % وقفت بالروض أبكي فقد مشبهه ، % حتى بكت بدموعي أعين الزهر % 2(@)(@@) % لو لم تعرها جفوني 
ms68	 الدمع تسفحه % % لرحمتي ، لاستعارته من المطر % 3(@)(@@) % فمن لباكية الأجفان سائلة ، % ظلت بلا فكر تبكي بلا فكر % 4(@)(@@) % حتى إذا الليل أرخى ستر ظلمته ، % وساعد اجفانها على السهر % 5(@)(@@) % لا تزدري يا ابنة جدة ثوبيه ، فبينهما ، % سيف يفرق بين الهام والقصر % PageV01P383 البحر : طويل 1(@)(@@) % نؤوم على غيظ الأعادي محسد ، % لأعلى مراقي العز تسمو خواطره % 2(@)(@@) % إذا ما أراد الحاسدون من امرئ % يزينهم أخلاقه ومآثره % % 3(@)(@@) % إذا ما هو استغنى اهتدى لافتقارهم ، % و لا يهتدي يوما إليه مفاقره % 4(@)(@@) % ويا عائبي ، والعيب حشو فؤاده ، % تأمل رويدا ، لست ممن أحاذره % 5(@)(@@) % وكنت كرام كوكبا ببصاقه ، % فرد عليه وبله ومواطره % PageV01P384 البحر : خفيف تام 1(@)(@@) % أي رسم لآل هند ودار ، % درسا غير ملعب ومنار % 2(@)(@@) % وأثاف بقين ، لا لاشتياق ، % جالسات على فريسة نار % 3(@)(@@) % وعراص جرت عليها سواري ال % % ريح حتى غودرن كالأسطار % 4(@)(@@) % ومغان ، كانت بها العين ملأى ، % من غصون تهتز في أقمار % 5(@)(@@) % سحقتها الرياح في كل فن ، % ومحتها بواكر الأمطار % 6(@)(@@) % أين أهل الديار عهدي بكم في % % ها جميعا ، لا أين أين الديار % 7(@)(@@) % و لقد أهتدي على طرق اللي % % ل بذي ميعة ، كميت مطار % 8(@)(@@) % بلل الركض جانبيه ، كما فا % % ضت بكف النديم كأس العقار % 9(@)(@@) % لا تشيم الروق عيني ولا أج % عل إلا إلى العدى أسفاري % % 10(@)(@@) % لا ولا أرتجي نوالا ، وهل تس % % تمطر الناس ديمة الأمطار % PageV01P385 11(@)(@@) % هاشمي ، إذا نسبت ، ومخصو % % ص يبيت من هاشم غير عار % 12(@)(@@) % أخزن الغيظ في قلوب الأعادي ، % ووحيد في الجحفل الجرار % 13(@)(@@) % و لي الصافنات تردي إلى المو % % ت ، ولا تهتدي سبيل الفرار % 14(@)(@@) % و سيوف كأنها حين هزت % ورق هزها سقوط القطار % 15(@)(@@) % ودروع كأنها شمط الجع % % د دهينا ، تضل فيها المداري % % 16(@)(@@) % وسهام تردي الورى من بعيد ، % واقعات مواقع الأبصار % 17(@)(@@) % وقدور كأنهن قروم ، % هدرت بين جلة وبكار % 18(@)(@@) % فوق نار شبعى من الحطب الجز % % ل ، إذا ما التظت رمت بالشرار % 19(@)(@@) % فهي تعلو اليفاع كالراية الحم % % راء تفري الدجى 
ms69	 إلى كل سار % 20(@)(@@) % قد ترديت بالمكارم دهرا ، % وكفتني نفسي من الافتخار % PageV01P386 21(@)(@@) % أنا جيش إذا غدوت وحيدا ، % % PageV01P387 البحر : طويل 1(@)(@@) % أيا ويحه ما ذنبه إن تذكرا % % سوالف أيام سبقن وأخرا % % 2(@)(@@) % وسكرة عيش فارغ من همومه ، % و معروف حال لم نخف أن ينكرا % % 3(@)(@@) % وعصر شباب كان ميعة حسنه ، % وظلا من الدنيا عليه منشرا % % 4(@)(@@) % إذا كنا لا يرددن ما فات من هوى ، % فلا تدع المخزون أن يتصبرا % % 5(@)(@@) % و قالوا : كبرت فانتضيت من الصبا ، % فقلت لهم : ما عشت إلا لأكبرا % % 6(@)(@@) % إذا لاح شيب الرأس يوما وليلة ، % فما أجدر الإنسان أن يتغيرا % % 7(@)(@@) % ولبثي وإخلافي أناسا فقدتهم ، % و ما كنت أرجو بعدهم أن أعمرا % % 8(@)(@@) % هم طردوا عن مقلتي رائد الكرى ، % و شكوا سواد القلب حتى تفطرا % % 9(@)(@@) % و أجلوا همومي من سواهم وأطبقوا % % جفوني فما أهوى من العيش منظرا % % 10(@)(@@) % وأصبحت معتل الحياة كأنني % % أسير رأى وجه الأمير ، ففكرا % % PageV01P388 11(@)(@@) % فإما تريني بالذي قد نكرته ، % فيا رب يوم لم أكن فيه منكرا % % 12(@)(@@) % أروح كغصن البان بيته الندى ، % و هز بأنفاس ضعاف وأمطرا % % 13(@)(@@) % فمال على ميثاء ناعمة الثرى ، % تغلغل فيها ماؤها وتحيرا % % 14(@)(@@) % كأن الصبا تهدي إليها إذا جرت % على تربها ، مسكا سحيقا وعنبرا % % 15(@)(@@) % سقته الغوادي والسواري قطارها ، % فجن كما شاء النبات ونورا % % 16(@)(@@) % و حلت عليه ليلة أرحبية ، % غذا ما صفا فيها الغدير تكدرا % % 17(@)(@@) % كأن الغواني بين بين رياضه ، % فغادرن فيه نشر ورد وعبهرا % % 18(@)(@@) % طويلة ما بين البياضين ، لم يكد % يصدق فيها فجرها حين بشرا % % 19(@)(@@) % إذا ما ألحت قشر الصخر وبلها ، % و همت غصون النبع أن تتكسرا % % 20(@)(@@) % فباتت إذا ما البرق أوقد وسطها % % حريقا أهل الرعد فيه وكبرا % % PageV01P389 21(@)(@@) % كأن الرباب الجون دون سحابه % خليع من الفتيان يسحب مئزرا % % 22(@)(@@) % إذا لحقته روعة من ورائه % تلفت واستل الحسام المذكرا % % 23(@)(@@) % فأصبح مستور التراب كأنما % % نشرت عليه وشي برد محبرا % % 24(@)(@@) % به كل موشي القوائم ناشط ، % و عين تراعي فاتر اللحظ 
ms70	 أحورا % % 25(@)(@@) % تطيف بذيال كأن صواره % غدائر ذي تاج عتا وتجبرا % % 26(@)(@@) % يحك الغصون المورقات بروقه % % كخصفك بالإشفى نعالا فخصرا % % 27(@)(@@) % وذي عنق مثل العصا شق رأسها % % وشذب عنها جلدها فتقشرا % % 28(@)(@@) % و ساق كشطر الرمح صم كعوبه % % تردى على ما فوقها وتأزرا % % 29(@)(@@) % فبادرته قبل الصباح بسابح % جواد ، كما شاء الحسود وأكثرا % % 30(@)(@@) % إذا ما بدا أبصرت غرة وجهه % % كعنقود كرم بين غصنين نورا % % PageV01P390 31(@)(@@) % و سالفتي ظبي من الوحش سانح ، % غذا ما عراه خوف شيء تبصرا % % 32(@)(@@) % وردفا كظهر الترس أسبل خلفه % % عسيب كفيض الطود لما تحدرا % % 33(@)(@@) % وأرسلته مستطعما لعنانه ، % أخا ثقة ما أنت إلا مبشرا % % 34(@)(@@) % و هم أتتني طارقات ضيوفه % فما كان إلا اليعملات له قرى % % 35(@)(@@) % بوحشية قفر تخال سرابها % % مها لامعات ، أو ملاء منشرا % % 36(@)(@@) % فلما تبدى الليل يحدو بنجمه ، % لبسنا ظلاما لم يكد صبحه يرى % % 37(@)(@@) % و طاف الكرى بالقوم حتى كأنهم % % نشاوى شراب دب فيهم وأسكرا % % 38(@)(@@) % فمن كل هذا قد قضيت لبانتي ، % و ولى ، فلم أملك أسى ، وتذكرا % % 39(@)(@@) % ويوم من الجوزاء أصليت ناره ، % وقد ستر الكناس إذ بان مشترى % % 40(@)(@@) % وقد أكلت شمس النهار ظلاله ، % وصارت كحرباء الهواجر معفرا % % PageV01P391 41(@)(@@) % و كم من عدو رام قصف قناتنا ، % فلاقى بنا يوما من الشر أحمرا % % 42(@)(@@) % إذا أنت لم تركب أداني حادث % من الأمر لاقيت الأقاصي أوعرا % % PageV01P392 البحر : طويل 1(@)(@@) % هي الدار إلا أنها منهم قفر ، % وإني بها ثاو ، وإنهم سفر % 2(@)(@@) % حبست بها لحظي ، وأطلقت عبرتي ، % وما كان لي في الصبر لو كان لي عذر % 3(@)(@@) % كأني ، وأيامي التي طوت النوى ، % تجيان باتا دون لقياهما ستر % 4(@)(@@) % توهمت فيها ملعبا ومسارحا ، % و نؤيا ، كملقى الطوق ثلمه القطر % 5(@)(@@) % فدع ذكر بثنى قد مضى ليس راجعا ، % فذلك دهر قد تولى ، وذا دهر % 6(@)(@@) % مهفهفة صفر الوشاح ، كأنها % % مهاة خلاء ظل يكنفها الدر % 7(@)(@@) % لها وجنات يضحك الورد فوقها ، % وطرف مريض حشو أجفانه السحر % 8(@)(@@) % فما روضة الزهر التي تلفظ الندى ، % ويصبح 
ms71	 فيما بينها للندى نشر % 9(@)(@@) % بأطيب من سلمى ، ولا كل طيب ، % و لا مثل ما تحلو به يفعل البدر % 10(@)(@@) % و غيث خصيب الترب تندى بقاعه ، % بهيم الذرى ، أثواب قيعانه خضر % PageV01P393 11(@)(@@) % رجيب كموج البحر يلتهم الربى % % ويغرق في آكلائه النعم الدثر % 12(@)(@@) % ألحت عليه كل طخياء ديمة ، % إذا ما بكت أجفانها ضحك الزهر % 13(@)(@@) % فما طلعت شمس النهار ضحية ، % ولا أصلا ، إلا ومن دونها خدر % 14(@)(@@) % كأن عيون العاشقين منوطة % بأرجائها ، فما يجف لها شفر % 15(@)(@@) % كأن الرباب الجون ، والفجر ساطع ، % دخان حريق لا يضيء له جمر % 16(@)(@@) % أمنك سرى يا شر برق ، كأنه % جناح فؤاد خافق ضمه صدر % 17(@)(@@) % أرقت له ، والركب ميل رؤوسهم ، % يخوضون ضحضاح الكرى وبهم وقر % 18(@)(@@) % علاهم حليد الليل حتى كأنهم % بزاة تجلى في مراقبها قمر % 19(@)(@@) % إلى أن تعرى النجم من حلة الدجى ، % وقال دليل القوم : قد ثقب الفجر % 20(@)(@@) % وقدوا أديم القوم حين ترفعت % لهم ليلة أخرى كما حلق النسر % PageV01P394 21(@)(@@) % و جيش كمثل الليل يسود شمسه ، % ويحمر من أعدائه البر والبحر % 22(@)(@@) % شهدت بطرف أعوجي وطرفة ، % وعضب حسام الحد في متنه أثر % 23(@)(@@) % و لما التقى الصفان فرق بيننا % % بريق ضراب البيض والأسل السمر % 24(@)(@@) % فولوا ، وقد ذاقوا التي يعرفونها ، % فكان لهم عذر ، وكان لنا فخر % 25(@)(@@) % إذا ما ركبت الجون والسيف منتضى ، % فقل لبني حواء يجمعهم أمر % 26(@)(@@) % و كم من خليل لم أمتع بعهده ، % وفيت له بالود فاجتحه الغدر % 27(@)(@@) % فقدمت صفحا عنه يوجب شكره ، % وما كان لي منه جزاء ، ولا شكر % 28(@)(@@) % وذلك حظي من رجال أعزة % علي ، فإن أهجرهم يكثر الهجر % 29(@)(@@) % لهم خير مالي حين يعتل مالهم ، % وسرعة نصري حين يعتذر النصر % 30(@)(@@) % إذا جاءنا العافي رأى في وجوهنا % % طلاقة أيدينا ، وبشره البشر % PageV01P395 البحر : - 1(@)(@@) % سقى الإله سر من را القطرا ، % و الكرح والخمس القرى ، والجسرا % % 2(@)(@@) % قد عجموا عودي ، وكنت مرا ، % حرا ، إذا لم يك حر حرا % % 3(@)(@@) % لا تأمنوا من بعد حلم شرا ، % كم 
ms72	 غصن أخضر صار جمرا % % PageV01P396 البحر : طويل 1(@)(@@) % إذا لم أجد بالمال جاد به الدهر ، % على وارثي ، والكف في قبرها صفر % 2(@)(@@) % وكيف أخاف الفقر ، والله ضامن % لرزقي ، وهل في البخل من بعد ذا عذر % 3(@)(@@) % فخلوا يدي تمطر بوابل جودها % % على الناس حتى يعجب الغيث والبحر % PageV01P397 البحر : خفيف تام 1(@)(@@) % قف خليلي نسأل لشرة دارا ، % أو محلا منها خلاء قفارا % % 2(@)(@@) % ألبستني سقما أقام ، وسارت ، % و استجابت قلبي إليها ، فطارا % % 3(@)(@@) % لي حبيب مكذب بالأماني ، % جعل الدهر موعدا وانتظارا % % 4(@)(@@) % عيروني بما يضن به ع % ني ، فيا ليته يحقق عارا % % 5(@)(@@) % قد شغلت الهوى بطول التجني ، % كل يوم يؤم قلبي اعتذارا % % 6(@)(@@) % ضاع شوق إليك ، لو تعلمين ، % بات بين الأحشاء يوقد نارا % % 7(@)(@@) % و يناجي بنات نعش بذكرا % % ك إذا الليل ألبس الأرض قارا % % 8(@)(@@) % و سؤالي عن بلدة أنت فيها ، % أتلقى من نحوك الأخبارا % % 9(@)(@@) % وجهادي عواذلا فيك لا يب % % رحن باللوم غدوة وابتكارا % % 10(@)(@@) % رب صاد إلى حديثك خلا % ب ، وقد طاف حول سري ودارا % % PageV01P398 11(@)(@@) % لو رأى مطلعا من الأرض سهلا % دب في الناس ينفث الأسرارا % % 12(@)(@@) % ما رأينا شبها لشرة في النا % % س ، فسقيا اشرة الأمطارا % % 13(@)(@@) % أيها الركب بلغوها سلامي ، % واتقوا أخذ طرفها السحارا % % PageV01P399 البحر : طويل 1(@)(@@) % فكيف بها لا الدار عنها قريبة ، % ولا أنت عنها ، آخر الدهر ، صابر % 2(@)(@@) % أبن لي فقد بانت بها مدة النوى ، % أأنت على شيء سوى الهم قادر % 3(@)(@@) % نعم أن يزول القلب عن مستقره % % خفوقا ، وتنهل الدموع البوادر % 4(@)(@@) % و أحيا حياة بعد سلمى مريضة ، % لها عاذل في حب سلمى وعاذر % 5(@)(@@) % ألا يا عباد الله ، هذا أخوكم % قتيل ، فهل منكم له اليوم ثائر ؟ % PageV01P400 البحر : طويل 1(@)(@@) % أبى القلب إلا حب من هو هاجر ، % و من هو ينساني ، ومن هو ذاكر % 2(@)(@@) % ومن هو عني كلما جئت معرض ، % ومن لا يوافيني ، ومن أنا عاذر % 3(@)(@@) % فكيف بمعشوق يحب ويشتهى ، % أأكتمه وجدي به ، أم أهاجر % 4(@)(@@) % وكيف يراني ، إن بدا 
ms73	 لي منعه ، % أأتركه زهدا به ، أم أكابر ؟ % PageV01P401 البحر : رجز تام 1(@)(@@) % يا ظالم الفعل ، ومظلوم النظر ، % و يا كثيبا وقضيبا وقمر % 2(@)(@@) % قدرت لي ، فحبذا هذا القدر ، % و إن ملأت العين دمعا وسهر % PageV01P402 البحر : كامل أحذ 1(@)(@@) % لما علمت بدأت بالهجر ، % و رميتني من حيث لا أدري % % 2(@)(@@) % ما كنت تدري كيف تقتلني ، % فهجرتني ، وفطنت للهجر % PageV01P403 البحر : مجزوء الرجز 1(@)(@@) % قد صاد قلبي قمر ، % يسحر منه النظر % 2(@)(@@) % و قد فنيت بعده ، % و ضاع ذاك الحذر % 3(@)(@@) % بوجنة ، كأنما % % يقدح منها الشرر % 4(@)(@@) % وشارب قد هم أو % نم عليه الشعر % 5(@)(@@) % ضعيفة أجفانه ، % والقلب منه حجر % 6(@)(@@) % كأنما ألحاظه % من فعله تعتذر % 7(@)(@@) % لم أر وجها مثل ذا % % نجا عليه بشر % PageV01P404 البحر : مجزوء الرمل 1(@)(@@) % قال : أذنبت ، ولا أدري ، % وروى الأحزان في صدري % % 2(@)(@@) % لا أطيق الهجر أحمله ، % ضعفت نفسي عن الهجر % 3(@)(@@) % و تجنت بي لتغدرني ، % أنا أهواها على غدر % PageV01P405 البحر : كامل أحذ 1(@)(@@) % بان الخليط ، ولم يطق صبرا ، % ووجدت طعم فراقهم مرا % % 2(@)(@@) % و كأنما الأمطار بعدهم ، % كست الطلول غلائلا خضرا % % 3(@)(@@) % هل تذكرين ، وأنت ذاكرة ، % مشي الرسول إليكم سرا % % 4(@)(@@) % إن يغفلوا يسرع لحاجته ، % وإذا رأوه أحسن العذرا % % 5(@)(@@) % فطن يؤدي ما يقال له ، % ويزيد بعض حديثنا سحرا % % 6(@)(@@) % قالت لأتراب خلون بها ، % و بكت ، فبلل دمعها النحرا : % 7(@)(@@) % ما باله قطع الوصال ، ولم % % يسمح زيارة بيننا شهرا % % 8(@)(@@) % يا ليته في مجلس معنا ، % نشكو إليه النأي والهجرا % % 9(@)(@@) % حتى طرقت على مخاطرة ، % أطأ الصوارم والقنا السمرا % % 10(@)(@@) % يا ليلة ما كان أقصرها ، % لا زلت أشكر بعدها الدهرا % % PageV01P406 البحر : مجزوء الخفيف 1(@)(@@) % و ظباء غرائر % مشبعات المآزر % 2(@)(@@) % صرن نحوي بأعين % ناعسات الضمائر % PageV01P407 البحر : بسيط تام 1(@)(@@) % يا ليلة بت فيها دائم السهر ، % أرعى النجوم ، حليف الهم والفكر % 2(@)(@@) % كأنها ، حين ذر الليل ظلمته ، % جمر جلته الصبا في مصطلى خضر % 3(@)(@@) % يا ويح قلبي من ريم بليت به ، % بالصبح منتقب ، بالليل معتجر % PageV01P408 البحر : وافر تام 1(@)(@@) % فواحزني 
ms74	 على غفلات عيش فواحزني على غفلات عيش % وأيام سلفن لنا قصار % 2(@)(@@) % ودار للمليحة لم تعمر % لنا لذاتها بين الديار % PageV01P409 البحر : طويل 1(@)(@@) % إلى الله أشكو الشوق ، لا إن لقيتها % % يقل ، ولا إن بنت يخلقه الدهر % 2(@)(@@) % مقيم على الأحشاء قد قطعت به ، % فساعته يوم ، وليلته شهر % PageV01P410 البحر : سريع 1(@)(@@) % ما بال ليلي لا يرى فجره ، % وما لدمعي دائما قطره % 2(@)(@@) % أستودع الله حبيبا نأى ، % ميعاد دمعي أبدا ذكره % PageV01P411 البحر : متقارب تام 1(@)(@@) % بقلبي لنار الهوى حجمرة ، % و للشوق في مقلتي عبرة % 2(@)(@@) % و أسخن عيني حبيب نأى ، % و كانت لعيني به قرة % 3(@)(@@) % يقولون لي : خيرة في الفرا % % ق ، فقلت لهم : خيرة مرة % PageV01P412 البحر : مجتث 1(@)(@@) % يا رب ما لي صبر ، % و لا لليلي فجر % 2(@)(@@) % و حشو قلبي جمر ، % طال فما يقر % 3(@)(@@) % أفسد ديني بدر ، % في الطرف منه سحر % 4(@)(@@) % والقلب منه صخر % كأن فاه الخمر % 5(@)(@@) % ينبت فيه الدر ، % ووعده يغر % 6(@)(@@) % حلو ، وخلف مر ، % يا ليل ، بل يا دهر % 7(@)(@@) % طلت وطال الفجر % . . . . . . . . . . . . . . % PageV01P413 البحر : خفيف تام 1(@)(@@) % يا هلالا يدور في فلك الما % % ورد ! رفقا بأعين النظاره % % 2(@)(@@) % قف لنا في الطريق ، إن لم تزرنا ، % وقفة في الطريق نصف الزياره % % PageV01P414 البحر : كامل تام 1(@)(@@) % يا عاذلي في ليليه ونهاره ، % خل الهوى يكوي المحب بناره % % 2(@)(@@) % ويح المتيم ، ويحه ، ماذا على % % عذاله من ذنبه ، أو عاره % % 3(@)(@@) % يا حسن أحمد إذ غدا متشمرا % في قرطق يمشي بكأس عقاره % % 4(@)(@@) % والغصن في أثوابه ، والدر في % % فمه ، وجيد الظبي في أزراره % % 5(@)(@@) % لكنه قاس كذوب وعده ، % نائي المزار على دنو جواره % % 6(@)(@@) % ما كان أحذقني بهجرة مثله ، % لولا ملاحة خده وعذاره % % PageV01P415 البحر : بسيط تام 1(@)(@@) % حاشا لشرة بل طوبى لعاشقها ، % لو كانت الشمس تحكيها أو القمر % 2(@)(@@) % إذا لكان يرى في كل ما طلعت % شبه لها ، فيقل الهم والفكر % PageV01P416 البحر : سريع 1(@)(@@) % أشكو غلى الله هوى شادن ، % جاء صباحا زاده نورا % % 2(@)(@@) % إن جاء في الليل تجلى ، وإن 
ms75	 % % 3(@)(@@) % فكيف أحتال ، إذا زارني ، % حتى يكون الأمر مستورا % % PageV01P417 البحر : مجزوء الكامل 1(@)(@@) % يا من يسارقني النظر ، % و إذا نظرت إليه فر % 2(@)(@@) % ما لي أرى لحظات عي % % نك عندنا لا تستقر % 3(@)(@@) % إن كنت تبخل بالكلا % % م ، فلا أقل من النظر % 4(@)(@@) % جسمي يقول بسقمه ، % عندي من الحب الخبر % PageV01P418 البحر : كامل تام 1(@)(@@) % يا وجه شرة ، يا أخا البدر ، % أرضيت بالإعراض والهجر % 2(@)(@@) % وتركتني ، وحججت معتمرا ، % طوبى لركن البيت والحجر ! % PageV01P419 البحر : بسيط تام 1(@)(@@) % طال النهار ، فأين الليل والسهر ، % إني لبدري وبدر الليل منتظر % 2(@)(@@) % يا طول شوقي إلى نوم الرقيب وقد % % خلا حبيبي لي حتى بدا السحر % 3(@)(@@) % يا قلب صبرا على يوم الفراق ، فقد % % حق الذي منه حقا كنت أنتظر % 4(@)(@@) % يا شوق خذ من حياتي واتركن زما % % ن البين ، ما في حياتي بعدهم وطر % PageV01P420 البحر : خفيف تام 1(@)(@@) % قد سقتني خمرا ، وريقا كخمر ، % بنت عشر في كفها بنت عشر % 2(@)(@@) % ذر في وجهها الملاحة ذرا ، % خالق هز غصنها تحت بدر % 3(@)(@@) % مرحبا باختلاج جفن عيون ، % بشرت عينها برؤية شر % 4(@)(@@) % لك عندي عتق من الدمع إن ص % ح الذي قلته ، ولو بعد شهر % PageV01P421 البحر : سريع 1(@)(@@) % بالله ! يا ذا المقلة الساهرة ، % إغفر ذنوب الدمعة القاطره % % 2(@)(@@) % ته كيفما شئت علينا ، فقد % % تاهت بك الدنيا على الآخره % % PageV01P422 البحر : وافر تام 1(@)(@@) % أصابت عينها عين ، فزيدت % فتورا في الملاحة وانكسارا % 2(@)(@@) % و صار لغمزها عدد ، إذا ما % % أشار إليه لحظ ، أو أشارا % % PageV01P423 البحر : طويل 1(@)(@@) % سلمت ، أمير المؤمنين ، على الدهر ، % ولا زلت فينا باقيا واسع العمر % 2(@)(@@) % حللت الثريا خير دار ومنزل ، % فلا زال معمورا وبورك من قصر % 3(@)(@@) % فليس له ، فيما بنى الناس ، مشبه ، % ولا ما بناه الجن في سالف الدهر % 4(@)(@@) % و ما زال يرعاه الإمام برأيه ، % و بالعز ، والتقديم ، والنهي ، والأمر % 5(@)(@@) % فتم ، فما في الحسن شيء يريده % % لسان ، ولا قلب بقول ولا فكر % 6(@)(@@) % سيثني عليه من محاسن قصره ، % مدائح ليست من كلام ولا 
ms76	 شعر % 7(@)(@@) % يشير إلى رأي مصيب وحكمة ، % و جود لدى الإنفاق بالبيض والصفر % 8(@)(@@) % جنان ، وأشجار تلاقت غصونها % % فأورقن بالأثمار والورق الخضر % 9(@)(@@) % ترى الطير في أغصانهن هواتفا ، % تنقل من وكر لهن إلى وكر % 10(@)(@@) % هجرت سواها كل دار عرفتها ، % و حق لدار غيرش دارك بالهجر % PageV01P424 11(@)(@@) % وبنيان قصر قد علت شرفاته ، % كصف نساء قد تربعن في الأزر % 12(@)(@@) % و أنهار ماء كالسلاسل فجرت % لترضع أولاد الرياحين والزهر % 13(@)(@@) % وميدان وحش تركض الخيل وسطه % % فيؤخذ منها ما يشاء على قدر % 14(@)(@@) % إذا ما رأت ماء الثريا ونبته % يسير وثوب الكلب فيهن والصقر % 15(@)(@@) % عطايا إله منعم كان عالما % بأنك أوفى الناس فيهن بالشكر % 16(@)(@@) % حكمت بعدل لم ير الناس مثله ، % وداويت بالرفق الجموح وبالقهر % 17(@)(@@) % و لا بأس أنكى من تشبط حازم ، % و لا درع أوقى للنفوس من العمر % 18(@)(@@) % وما زلت حي الملك ترجى وتتقى ، % وتفترس الأعداء بالبيض والسمر % 19(@)(@@) % و ما ليث غاب يهدم الجيش خوفه ، % بمشية وثاب على النهي والزجر % 20(@)(@@) % يجر إلى أشباله ، كل ليلة ، % عقيرة وحش أو قتيلا من السفر % PageV01P425 21(@)(@@) % إذا ما رأوه طار جمعهم معا ، % كما طير النفخ التراب عن الجمر % 22(@)(@@) % جري أبي يحسب الألف واحدا ؛ % بعيد ، إذا ما كر يوما ، من الفر % 23(@)(@@) % يزعزع أحشاء البلاد زئيره ، % ويبطل أبطال الرجال من الذعر % 24(@)(@@) % إذا ضم قرنا بين كفيه خلته % يعاني عروسا في غلائلها الحمر % 25(@)(@@) % فحرم أرض الحائرين وماءها ، % فهيهات من يغدو عليها ومن يسري % % 26(@)(@@) % بأجرأ منه حد بأس وعزمة ، % إذا ما نزا قلب الجبان إلى النحر % 27(@)(@@) % فكل أناس يشهرون أكفهم % % دعاء له بالعز فيهم وبالنصر % PageV01P426 البحر : طويل 1(@)(@@) % عليم بأعقاب الأمور كأنه % بمختلسات الظن يسمع أو يرى % % 2(@)(@@) % إذا أخذ القرطاس خلت يمينه % % تفتح نورا ، أو تنظم جوهرا % % PageV01P427 البحر : طويل 1(@)(@@) % أيا موصل النعما ، على كل حالة ، % إلي ، قريبا كنت أو نازح الدار % 2(@)(@@) % كما يلحق الغيث البلاد بسيله ، % وإن جاد في أرض سواها بأمطار % 3(@)(@@) % ويا مقبل 
ms77	 ، والدهر عني بمعرض ، % يقسم لحمي بين ناب وأظفار % 4(@)(@@) % و يا من يراني حيثث كنت بذكره ، % و كم من اناس لم يروني بأبصار % 5(@)(@@) % و كم نعمة لله في صرف نقمة ، % ترجى ، ومكروه حلا بعد إمرار % 6(@)(@@) % وما كل ما تهوى النفوس بنافع ، % وما كل ما تخشى النفوس بضرار % 7(@)(@@) % لقد عمر الله الوزارة باسمه ، % ورد إليها أهلها بعد إقفار % 8(@)(@@) % وكانت زمانا لا يقر قرارها ، % فلاقت نصابا ثابتا غير خوار % PageV01P428 البحر : كامل تام 1(@)(@@) % طال الفراق ، فبان عنه صبره ، % و قسا عليه ، فليس يرحم دهره % 2(@)(@@) % و الله ما خانتك سلوة عينيه ، % وفؤاده يهوى سواك يسره % 3(@)(@@) % عذر القتيل بحبها ، لكن من % % قد عاش بعد فراقها ما عذره % % 4(@)(@@) % و يقول لم أهجر ، بلى ، إذ بنتم ، % أوليس يشبه بين صب هجره % % 5(@)(@@) % قد طال عهدي بالإمام وأخلفت % أسباب وعد كاد يدرس ذكره % % 6(@)(@@) % ظلت تحاربني العوائق دونه ، % و تمدني ، أمد طويل صبره % % 7(@)(@@) % والله يقضي ما يشاء بخيره ، % من حيث لا تدري ويدري أمره % 8(@)(@@) % ملك تواضعت الملوك لغره ، % قسرا ، وفاض على الجداول بحره % % 9(@)(@@) % وكأنما رفع الحجاب لناظر ، % عن صبح ليل قد توقد فجره % % 10(@)(@@) % و تراه في ليل السرى وكأنه % % نار يقلب طرفه ويقره % % PageV01P429 11(@)(@@) % و غذا بدا ملأ العيون مهابة ، % فتظل تسرق لحظها وتسره % % 12(@)(@@) % و كأنما يهتز ، بين ثيابه ، % نصل يلوح بصفحتيه أثره % % 13(@)(@@) % و يجيش نار الحرب تحت عقابها ، % و الموت في صرف الفوارس جمره % 14(@)(@@) % و تراه يصغي في القناة ، بكفه ، % نجما ، ونجما في القناة يجره % % PageV01P430 البحر : طويل 1(@)(@@) % تذكر لما ضاق بالهم صدره ، % و أدبر عنه كل مولى وناصر % 2(@)(@@) % وخلاه خلان الصفاء ، لما به ، % ولم ير في البلوى مقاما لصابر % 3(@)(@@) % أتاك امرؤ ، فيه لنعماك موضع ، % فعاجله لا تغلب عليه ، وبادر % 4(@)(@@) % ولست الفتى يحتال شر خصاله ، % و تلقي له آماله بالمعاذر % 5(@)(@@) % لأنك مجبول على الجود وحده ، % ولست على بخل يخاف بقادر % 6(@)(@@) % ودينك أن لا تتقي سائلا بلا ، % فإن 
ms78	 قلتها لي فهي إحدى الكبائر % PageV01P431 البحر : وافر تام 1(@)(@@) % أمير المؤمنين ، فدتك نفسي ، % لقيت سلامة ، وربحت أجرا % % 2(@)(@@) % وكانت فرصة من ريب دهر ، % فلم تحفل بها جلدا وصبرا % % 3(@)(@@) % و لكني رعيت النجم خوفا ، % وأحزانا أقاسيها وفكرا % % 4(@)(@@) % فكاد يطير للإشفاق قلبي ، % فضم جناحه قلبي وقرا % % PageV01P432 البحر : كامل تام 1(@)(@@) % ذهب الشباب ، وكدر العمر ، % في صبوة ، وعلا لك الأمر % 2(@)(@@) % حتى بلغت السؤال منه ، فهل % % حان التقى لك ، وانجلى الشكر % 3(@)(@@) % و لربما رواك من قبل % ظبي ، مجاجة ريقه خمر % 4(@)(@@) % متلفت حتى أتاك ، وقد % % خاف الرقيب وهزه الذعر % 5(@)(@@) % إسلم ، أمير المؤمنين ، ودم % في غبطة ، وليهنك النصر % 6(@)(@@) % فلرب حادثة نهضت بها ، % متقدما ، فتأخر الدهر % 7(@)(@@) % ليث ، فرائسه الكماة ، فما % % يبيض من دمها له ظفر % 8(@)(@@) % سحب الجيوش فكم بها فتحت % بعد التمنع بلدة بكر % 9(@)(@@) % ما رد عن متحصن يده ، % إلا وقلعته له قبر % 10(@)(@@) % مستأسد في الحرب ، همته % قدامه ، والقتل والأسر % PageV01P433 11(@)(@@) % وعقابه عدل ، وعزمته ، % كالمشرفي ، ووعده نذر % PageV01P434 البحر : طويل 1(@)(@@) % ألا أيها الربع الذي عطل الدهر ، % عفاك بكائي فيك لم يعفك القطر % 2(@)(@@) % خليلي إن لم تسعداني على البكا ، % فلا تكثرا لومي ، فكم يصبر الصبر % 3(@)(@@) % سقى الله شمسا بالمخرم دارها ، % يهون عليها مني العتب والهجر % 4(@)(@@) % جلتها علينا الريح بين كواعب ، % و قد كتمتهن المقانع والأزر % 5(@)(@@) % فأبدت لنا كشحا هضميا ، على نقا ، % و رمانض صدر ما ليانعه هصر % 6(@)(@@) % أبى الله إلا كل ما سر أحمدا ، % وللحاسدين الرغم والجدع والعثر % 7(@)(@@) % به قرت الدنيا ، وفاض خراجها % % على الملك ، فاستغنى وأمكنه القهر % 8(@)(@@) % و لولاه درت ، بالسيوف وبالقنا ، % لقاح مع الهيجاء ، أطيارها حمر % PageV01P435 البحر : طويل 1(@)(@@) % أضاف إلي الليل طول تفكر ، % وهما متى يستمطر الدمع يقطر % 2(@)(@@) % وقال الغواني : قد تنكرت بعدنا ، % وهل دام ذو عهد ، فلم يتنكر ؟ % 3(@)(@@) % تعاودت الأسقام جسمي فلم تدع % لعواده غير القميص المزرر % 4(@)(@@) % ألا رب كأس قد سبقت لشربها % % صباحا ، كباز هم بالنهض أقمر % 5(@)(@@) % وقد صغت الجوزاء حتى 
ms79	 كأنها % % وراء نجوم هاويات وغور % 6(@)(@@) % صنوج على رقاصة قد تمايلت % لتلهي شربا بين دف ومزهر % 7(@)(@@) % وقلت لساقي الراح : لا تعقرنها % % بماء ، وأحزانا بصرفك ، فاعقر % 8(@)(@@) % و لا تسقينها بنت عام ، فإنها % % كما هي في عنقودها لم تغير % 9(@)(@@) % قريبة عهد بالغصون وبالثرى ، % و بالشرب من ماء الفرات المفجر % 10(@)(@@) % و ليل موشى بالنجوم صدعته % إلى صبحه صدع الرداء المحبر % PageV01P436 11(@)(@@) % و يا حاسدا يكوي التهلف قلبه ، % إذا ما رآه عاديا وسط عسكر % 12(@)(@@) % تصفح بني الدنيا ، فهل فيهم له % % نظير تراه ، واجتهد وتفكر % PageV01P437 البحر : طويل 1(@)(@@) % و يا حاسدا يكوي التلهف قلبه ، % كما بدئت والأمر من بعده الأمر % 2(@)(@@) % خف الله ، إن الله ليس بغافل ، % ولا بد من يسر إذا ما انتهى العسر % PageV01P438 البحر : مخلع البسيط 1(@)(@@) % اقطع وصالي ، فلست مني ، % ودم على جفوتي ، وهجري % % 2(@)(@@) % لا أشتهي الخل عند عيني ، % صديق وفري عدو فقري % % PageV01P439 البحر : خفيف تام 1(@)(@@) % من ذممناه في المودة أكثر ، % أين ، قل : أين ، من جنى وتغير % 2(@)(@@) % وكأني منه بألف كتاب % ورسول ، وألف وعد مزور % 3(@)(@@) % و تجنى مكابرا يحسب الغضبا % % ن للعفو كل وقت مسخر % 4(@)(@@) % سوف أبدي له وأظهر تصدي % % قا ولكنني سوى ذاك أضمر % PageV01P440 البحر : متقارب تام 1(@)(@@) % أقول ، وقد صد عني امرؤ ، % وما كنت بالصد منه جدير % % 2(@)(@@) % كما لم أر النفع في وصله ، % كذلك هجرانه لا يضير % % PageV01P441 البحر : مخلع البسيط 1(@)(@@) % و زائر زارني ثقيل ، % ينصر همي على سروري % % 2(@)(@@) % أوجع للقلب من غريم % ظل ملحا على فقير % 3(@)(@@) % بغير زاد ولا شراب ، % و لا حميم ولا شعير % PageV01P442 البحر : مجتث 1(@)(@@) % دبسية الاسم لك % ن صوتها عير % 2(@)(@@) % قباضة كل أمر ، % كقبض باز الطير % 3(@)(@@) % قالت لنا : كيف أنتم % % عيني ، ونحن بخير % 4(@)(@@) % أمرضت قلبي ، فما إن % % يطيق خدمة دير % PageV01P443 البحر : متقارب تام 1(@)(@@) % إذا ما تخلف من قد دعوت ، % فدعه وما اختار من أمره % % 2(@)(@@) % و لا تشربن بادكار له ، % ولكن تثاءب على ذكره % % PageV01P444 البحر : مخلع البسيط 1 
ms80	(@)(@@) % قومي إلى النار لا تعودي ، % قد فرج الله في سروري % % 2(@)(@@) % اسمك دبسية ، فيا ذي ! % إن كنت دبسية ، فطيري % % PageV01P445 البحر : سريع 1(@)(@@) % ظلنا نسقى سكرا حامضا ، % غصبا على أنفسنا قسرا % % 2(@)(@@) % و نقلنا من قصب يابس ، % كأننا نعمل آجرا % % 3(@)(@@) % وعندنا من يتغنى لنا ، % كأنه من فمه يخرا % % PageV01P446 البحر : مجزوء الوافر 1(@)(@@) % أردت الشرب في القمر ، % وقطع الليل بالسهر % 2(@)(@@) % و قد جمعت ما يلهي ، % فلم أترك ولم أذر % 3(@)(@@) % فدب الغيم معتمدا ، % فأخفاه عن النظر % 4(@)(@@) % فبت أفور من غضب ، % على الأحداث والغير % 5(@)(@@) % وجاء إلي شيطاني ، % يحرشني على القدر % 6(@)(@@) % و حاول كفرة مني ، % و جرأني على سقر % 7(@)(@@) % فقام العقل يطفئ عن % % فؤادي جمرة الضجر % 8(@)(@@) % وولى آيسا مني ، % وفزت عليه بالظفر % 9(@)(@@) % ووكل بي تلامذة ، % فأسقوني إلى السحر % 10(@)(@@) % وأبدوا لي مليح الوج % % ه منقوشا من الشرر % PageV01P447 11(@)(@@) % تمرن في الهوى ، وبدا ، % و حل مخانق الصور % 12(@)(@@) % فما يأتي على طلب ، % و لا يعصي من الحصر % 13(@)(@@) % وأغروني فكان إلي % % ه قد كان في سكري % % 14(@)(@@) % فلما أصبحوا طاروا % % إلى إبليس بالخبر % PageV01P448 البحر : مجتث 1(@)(@@) % من معيني على السهر ، % و على الغم والفكر % 2(@)(@@) % و ابلائي من شادن % كبر الحب إذ كبر % % 3(@)(@@) % قام كالغصن في النقا ، % يتبع الشمس بالقمر % 4(@)(@@) % غافلا عن بليتي ، % قاتلا لي ، وما شعر % % 5(@)(@@) % شاطر لي مقطب ، % فاسق الفعل والنظر % % 6(@)(@@) % خنجري اليمين إن % سمته قبلة نفر % % 7(@)(@@) % قد سقاني المدام وا % % لليل بالصبح مؤتزر % % 8(@)(@@) % و الثريا كنور غص % % ن على الغرب قد نثر % % 9(@)(@@) % صاح إن أمكنتك % لذة عيش فلا تذر % % 10(@)(@@) % و تقدم ، ولا تقف ، % فاز بالحب من جسر % % PageV01P449 11(@)(@@) % كم عذول على الخطي % % ئة ، والله قد غفر % % PageV01P450 البحر : كامل تام 1(@)(@@) % قد حثني بالكأس ، أو في فجره ، % ساق علامة دينه في خصره % % 2(@)(@@) % و كأن حمرة خده في لونها ، % وكأن طيب رياحها من نشره % % 3(@)(@@) % حتى إذا صب المزاج تبسمت % عن ثغرها فحسبتها عن ثغره % % 4(@)(@@) % يا 