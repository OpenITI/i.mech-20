ms308	 گفت آن گوش کاندر هجر او کردم فدا %~% زشت باشد گر بدو رجعت کنم بار دگر(@)(@@) 27 در چنین حالی چنین آزاد مردی کرد او %~% می ندیدم در جهان پیری ازو آزاده‌تر(@)(@@) 28 ای ز بخشش بخل را چون کوه کرد مغز خشک %~% وی ز کوشش خصم را چون ابر کرده دیده‌تر(@)(@@) 29 باطنت را دین به صحرا آورید از بهر صلح %~% چون نگه کرد اندرو از ابره به دید آستر(@)(@@) 30 گر نماند درد و گردی در میان نبود عجب %~% درد بر دارد شفا و گرد بنشاند مطر(@)(@@) 31 در میان یوسف و یعقوب اگر گفتی رود %~% عاقلان دانند کان گفتار نبود معتبر(@)(@@) 32 در میان دوستان گه جنگ باشد گاه صلح %~% در مزاج اختران گه نفع باشد گاه ضر(@)(@@) 33 دشمنان بد جگر که را بسنبند از کلوخ %~% دوستان نیک‌دل خم را بشویند از تبر(@)(@@) 34 گاه الفت داد باید نیش کژدم را امان %~% وقت خصمی کند باید کام تنین را ز فر(@)(@@) 35 طبع تا باشد موافق سرد و گرمش میخوران %~% چون مخالف گشت یا تلخیش ده یا نیشتر(@)(@@) 36 ای دریغا گوش او بشنودی ار باری کنون %~% تا تو زین الماس بران چون همی پاشی درر(@)(@@) 37 جان همی حاضر کند هر بار تا از روی عشق %~% او ز گوش جان نیوشد دیگران از گوش سر(@)(@@) 38 ای ترا یزدان از آن خوان داده نعمت کز شرف %~% ذله پروردان آن خوانند نعمان وز فر(@)(@@) 39 هیچ منت نیست کس را بر تو کت حق پرورید %~% گاه در مهد قبول و گاه در سفت ظفر(@)(@@) 40 فخر و فر این جهان و آن جهان گشتی چو داد %~% شیرت از پستان فخر و میوت از بستان فر(@)(@@) 41 تو بزرگ از آسمانی دیگران از آب و خاک %~% تو عزیز از کردگاری دیگران ز اصل و گهر(@)(@@) 42 مرغ کان ایزد کند چون مهر پرد بر سپهر %~% مرغ کان 
ms309	 عیسی کند بس خوار باشد پیش خور(@)(@@) 43 کی چرا سازد چو مرغ خانگی بر خاکدان %~% هرکرا روح‌القدس پرورده باشد زیر پر(@)(@@) 44 فاسقان را زحمتی هم در خلا هم در ملا %~% عاشقان را رحمتی هم در سفر هم در حضر(@)(@@) 45 عالمی را در حضر دلشاد کردی زین حضور %~% کشوری را زان سفر آزاد کردی از سقر(@)(@@) 46 آنچه بر صورت پرستان هری کردی عیان %~% هیچ صورت‌بین ندارد زان معانی جز خبر(@)(@@) 47 طیلسان داران دین بودند آنجا نعره زن %~% خانگه داران جان بودند آنجا جامه در(@)(@@) 48 حنبلی چون دید چشمت چشم او شد همچو سیم %~% اشعری چون دید رایت روی او شد همچو زر(@)(@@) 49 عقل این می‌گفت «اذا جا القضا ضاق الفضا» %~% جان آن می‌گفت «اذا جا القدر ضاع الحذر»(@)(@@) 50 از پی احیا شرع و معرفت کردی جدا %~% تیرگی ز اصحاب جبر و خیرگی ز اهل قدر(@)(@@) 51 این کنون ز «الحکم لله» نقش دارد بر نگین %~% و آن دگر ز «ایاک نعبد» حلقه دارد بر کمر(@)(@@) 52 زرد گوشان هری را کردی از گفتار نغز %~% چون سیه چشمان جنت گوش و گردن پر گهر(@)(@@) 53 در هری این ساحری دیدی به ترک و روم شو %~% تا چلیپا سوختن بینی تو در چین و خزر(@)(@@) 54 گر نه عرق منبر تستی در اشجار عراق %~% روح نامی اره‌ای گشتستی اندر هر شجر(@)(@@) 55 گر زر سحر گفت تو دین را نبودی پرورش %~% دایگی این سحر کی کردی به تاثیر سحر(@)(@@) 56 تا ز روی مایه مردم را نه از روی نسب %~% چار عنصر مادرند و هفت سیاره پدر(@)(@@) 57 باد امرت در زمین چون چار عنصر پیش رو %~% باد نامت در زمان چون هفت سیاره سمر(@)(@@) 58 باد رایت بی تباهی باد شخصت بی حدوث %~% باد جاهت بی تناهی باد جانت بی ضرر(@)(@@) 59 باد همچون دور همکار تو کارت مستقیم %~% باد همچون دین هم نام 
ms310	 تو نامت مشتهر PageV1P0505(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 بیخ اقبال که چون شاخ زد از باغ هنر %~% گر چه پژمرده شود باز قبول آرد بر(@)(@@) 2 دولت با هنران را فلک مرد افگن %~% زند آسیب ولیکن نکند زیر و زبر(@)(@@) 3 گوشمالی دهد ایام ولیکن نه به خشم %~% تا هنر با خرد آمیخته گردد ز عبر(@)(@@) 4 کی ز دوران فلک طعمه تقدیر شود %~% هر کرا بهر هنر بخت بپرورد به بر(@)(@@) 5 ز بر عرش زند خیمه اقبال و محل %~% هر کرا بدرقه بخت آمد و همخوابه ظفر(@)(@@) 6 از قفا خوردن ایام چه ننگ آید و عار %~% که هم اسباب بزرگیست هم آیات خطر(@)(@@) 7 مرد در ظلمت ایام گهر یابد و کام %~% که به ظلمت گهر اسپرد همی اسکندر(@)(@@) 8 کار چون راست بود مرد کجا گیرد نام %~% از چنین حادثه‌ها مردان گردند سمر(@)(@@) 9 مرد آسیب فلک یابد کاندر دو صفت %~% همچنو عنصر نفع آمد و سرمایه ضر(@)(@@) 10 هیچ نامرد مخنث که شنیدست به دهر %~% کز هنر در خور تاج آمد و آن منبر(@)(@@) 11 شیر پرزور نه از پایه خواریست به بند %~% سگ طماع نه از بهر عزیزیست به در(@)(@@) 12 سخت بسیار ستاره‌ست بر این چرخ ولیک %~% پس سیه جرم نگردند مگر شمس و قمر(@)(@@) 13 از هنر بود که در طالع سرهنگ جلیل %~% چشم زخم فلکی کرد به ناگاه اثر(@)(@@) 14 هم از آن چرخ چو آن مدت ناخوش بگذشت %~% اخترش کرد بدان طالع فرخنده نظر(@)(@@) 15 که گرش دایره کین ور شود از نقطه بخت %~% بشکند دایره را قوت بختش چنبر(@)(@@) 16 رتبت و شعر و رهی پروری و جبهت ملک %~% طاهربن علی آن صاحب کلک و خنجر(@)(@@) 17 آنکه تا چرخ ز تقدیر فلک حامه گشت %~% نه چنو زاد و بزاید به همه عمر دگر(@)(@@) 18 آنکه مر ملک ملک را ز نکو رایی و داد %~% دست بنهاد چو در عمر خود 
ms311	 از عدل عمر(@)(@@) 19 هر که در سایه گه دولت او گام نهاد %~% کند از مسکن او حادثه چرخ حذر(@)(@@) 20 هر کرا شاخ بزرگیش برو چنگ آویخت %~% خلعت و بخشش و عز یابد از آن شاخ ثمر(@)(@@) 21 همچو سرهنگ محمد پسر مرد آویز %~% که همی محمدت و مردی ازو گیرد فر(@)(@@) 22 آنکه زان حادثه زو شرم زده بود قضا %~% آنکه زین موهبه زو شادروان گشت قدر(@)(@@) 23 آن هنرمند جوانی که چو در بست میان %~% فلک پیر گشاید پی دیدنش بصر(@)(@@) 24 و آن خردمند جوانی که چو دو لب بگشاید %~% خانه عقل دو صد کله ببندد ز درر(@)(@@) 25 مایه ور گشته ز تحصیل کفش خرد و بزرگ %~% سودها برده ز آثار دلش ماده و نر PageV1P0506(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای ذات تو ناشده مصور %~% اثبات تو کرده عقل باور(@)(@@) 2 اسم تو ز حد و رسم بیزار %~% ذات تو ز جنس و نوع برتر(@)(@@) 3 محمول نه‌ای چنانکه اعراض %~% موضوع نه‌ای چنانکه جوهر(@)(@@) 4 فعلت نه به قصد آمر خیر %~% قولت نه به لفظ ناهی شر(@)(@@) 5 حکم تو به رقص قرص خورشید %~% انگیخته سایه‌های جانور(@)(@@) 6 صنع تو به دور دور گردون %~% آمیخته رنگهای دلبر(@)(@@) 7 ببریده در آشیان تقدیس %~% وصف تو ز جبرییل شهپر(@)(@@) 8 بگشاده به شه نمای تنزیه %~% حسنت ز عروس عرش زیور(@)(@@) 9 هم بر قدمت حدوث شاهد %~% هم بر ازلت ابد مجاور(@)(@@) 10 ای گشته چو آفتاب تابان %~% در سایه نور خود مستر(@)(@@) 11 معشوق جهانی و نداری %~% یک عاشق با ساز و در خور(@)(@@) 12 بنهفته به حر گنج قارون %~% یک در تو در دو دانه گوهر(@)(@@) 13 عالم پس ازین دو گشت پیدا %~% آدم هم ازین دو برد کیفر(@)(@@) 14 عالم چو یکی رونده دریا %~% سیاره سفینه طبع لنگر(@)(@@) 15 آبش چو نبات و سنگ حیوان %~% درش چو حقیقت سخن‌ور(@)(@@) 16 غواص چه چیز عقل فعال %~% زینسان که 
ms312	 به بحر دین پیمبر(@)(@@) 17 علت چو سیاست فرودین %~% از دست چو حرص خصم بی مر(@)(@@) 18 آخر چه هر آنچه بود اول %~% مقصود چه آنچه بود بهتر(@)(@@) 19 بنگر به صواب اگر نه‌ای کور %~% بنشو به حقیقت ار نه‌ای کر(@)(@@) 20 ای باز هوات در ربوده %~% از دام زمانه چون کبوتر(@)(@@) 21 ای پنجه حرص در کشیده %~% ناگه چو رسن سرت به چنبر(@)(@@) 22 در قشر بمانده کی توان دید %~% مقصود خلاصه مقشر(@)(@@) 23 از توبه و از گناه آدم %~% خود هیچ ندانی ای برادر(@)(@@) 24 سربسته بگویم ار توانی %~% بردار به تیغ فکرتش سر(@)(@@) 25 درویش کند ز راه ترتیب %~% نزدیکی تو به سوی داور(@)(@@) 26 در خلد چگونه خورد گندم %~% آنجا که نبود شخص نان خور(@)(@@) 27 بل گندمش آن گه ببایست %~% کز خلد نهاد پای بر در(@)(@@) 28 این جمله همه بدیده آدم %~% ابلیس نیامده ز مادر(@)(@@) 29 در سجده نکردنش چه گویی %~% مجبور بدست یا مخیر(@)(@@) 30 گر قادر بد خدای عاجز %~% ور عاجز بد خدا ستمگر(@)(@@) 31 کاری که نه کار تست مسگال %~% راهی که نه راه تست مسپر(@)(@@) 32 بیهوده مجوی آب حیوان %~% در ظلمت خویش چون سکندر(@)(@@) 33 کن چشمه که خضر یافت آنجا %~% با دیو فرشته نیست همبر PageV1P0507(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 مرد کی گردد به گرد هفت کشور نامور %~% تا بود زین هشت حرف اوصاف دانش بی‌خبر(@)(@@) 2 مهر جود و حرص فضل و ملک عقل و دست عدل %~% خلق خوب و طبع پاک و یار نیک و بذل زر(@)(@@) 3 میم و حا و میم و دال خا و طا و یا و با %~% آنکه چون نامش مرکب ازین صورت سیر(@)(@@) 4 صورت این حرفها نبود چو نیکو بنگری %~% جز خصال و نام سرهنگ و عمید نامور(@)(@@) 5 آنکه همچون عقل و دولت رای او را بود و هست %~% هم بر گفتن صواب و هم بر رفتن ظفر(@)(@@) 6 آنکه 
