ms81	 % 3(@)(@@) % فإن تكونوا براء ، من جنايته ؛ % فإن من رفد الجاني هو الجاني % % 4(@)(@@) % ما بالكم ! يا أقل الله خيركم % لا تغضبون لهذا الموثق العاني ؟ % 5(@)(@@) % جار نزعناه قسرا في بيوتكم ، % والخيل تعصب فرسانا بفرسان % 6(@)(@@) % إذ لاتردون عن أكناف أهلكم % شوازب الخيل من مثنى ووحدان % 7(@)(@@) % ب ' المرج ' ، إذ ' أم بسام ' تناشدني : % بنات عمك ! يا ' حار بن حمدان ' % 8(@)(@@) % فظلت أثني صدور الخيل ساهمة % بكل مضطغن بالحقد ، ملآن % 9(@)(@@) % ونحن قوم ، إذا عدنا بسيئة % على العشيرة ، أعقبنا بإحسان % PageV01P373 البحر : كامل تام 1(@)(@@) % أتعز أنت على رسوم مغان ، % فأقيم للعبرات سوق هوان % 2(@)(@@) % فرض علي ، لكل دار وقفة % تقضي حقوق الدار والأجفان % 3(@)(@@) % لولا تذكر من هويت ب ' حاجر ' % لم أبك فيه مواقد النيران % 4(@)(@@) % ولقد أراه ، قبيل طارقة النوى ، % مأوى الحسان ، ومنزل الضيفان % 5(@)(@@) % ومكان كل مهند ، ومجر ك % ل مثقف ، ومجال كل حصان % 6(@)(@@) % نشر الزمان عليه ، بعد أنيسه ، % حلل الفناء ؛ وكل شيء فان ! % 7(@)(@@) % ولقد وقفت فسرني ما ساءني % % فيه ، وأضحكني الذي أبكاني % % 8(@)(@@) % ورأيت في عرصاته مجموعة % أسد الشرى ، وربائب الغزلان % 9(@)(@@) % يا واقفان ، معي ، على الدار اطلبا % % غيري لها ، إن كنتما تقفان ! % 10(@)(@@) % منع الوقوف ، على المنازل ، طارق % أمر الدموع بمقلتي ونهاني % % PageV01P374 11(@)(@@) % فله ، إذا ونت المدامع أو همت ، % عصيان دمعي ، فيه ، أو عصياني % % 12(@)(@@) % إنا لجمعنا البكاء ، وكلنا % % يبكي على شجن من الأشجار % 13(@)(@@) % ولقد جعلت الحب ستر مدامعي % % ولغيره عيناي تنهملان % 14(@)(@@) % أبكي الأحبة بالشآم ، وبيننا % % قلل الدروب وشاطئا جيحان % 15(@)(@@) % وحسبت فيما أشعلت نيراني % % مثلي على كنف من الأحزان % 16(@)(@@) % فضلت لدي مدامع فبكيت لل % % باكي بها ، وولهت للولهان % 17(@)(@@) % ما لي جزعت من الخطوب وإنما % % أخذ المهيمن بعض ما أعطاني % % 18(@)(@@) % ولقد سررت كما غممت عشائري % % زمنا ، وهنأني الذي عناني % % 19(@)(@@) % وأسرت في مجرى خيولي غازيا % وحبست فيما أشعلت نيراني % % 20(@)(@@) % يرمي بنا ، شطر البلاد ، مشيع % صدق الكريهة ، فائض الإحسان % PageV01P375 21(@)(@@) % بلد ، لعمرك ، لم أزل زواره % مع سيد قرم أغر ، هجان % 22 
ms82	(@)(@@) % إنا لنلقى الخطب فيك وغيره % بموفق عند الخطوب ، معان % 24(@)(@@) % ولطالما حطمت صدر مثقف ، % ولطالما أرعفت أنف سنان % 25(@)(@@) % ولطالما قدت الجياد إلى الوغى % % قب البطون ، طويلة الأرسان % 26(@)(@@) % وأنا الذي ملأ البسيطة كلها % % ناري ، وطنب في السماء دخاني % % 32(@)(@@) % إن لم تكن طالت سني فإن لي % % رأي الكهول ونجدة الشبان % 33(@)(@@) % قمن ، بما ساء الأعادي ، موقفي ، % والدهر يبرز لي مع الأقران % 34(@)(@@) % يمضي الزمان ، وما ظفرت بصاحب % إلا ظفرت بصاحب خوان % 35(@)(@@) % يا دهر خنت مع الأصادق خلتي % % وغدرت بي في جملة الإخوان % 36(@)(@@) % لكن سيف الدولة المولى الذي % % لم أنسه وأراه لا ينساني % % PageV01P376 37(@)(@@) % أيضيعني من لم يزل لي حافظا ، % كرما ، ويخفضني الذي أعلاني ! % 38(@)(@@) % خدن الوفاء ، ولا وفي غيره ، % يرضى أعاني ضيق حالة عان % 39(@)(@@) % إني أغار على مكاني أن أرى % % فيه رجالا لا تسد مكاني % % 40(@)(@@) % أو أن تكون وقيعة أو غارة % ما لي بها أثر مع الفتيان % 44(@)(@@) % إقرا السلام ، على الذين سيوفهم % ما أحرجوا ، عطفوا على هامان % 47(@)(@@) % سيف الهدى من حد سيفك يرتجى % % يوم ، يذل الكفر للإيمان % 48(@)(@@) % هذي الجيوش ، تجيش نحو بلادكم % % محفوفة بالكفر والصلبان % 49(@)(@@) % ألبغي أكثر ما تقل خيولهم % والبغي شر مصاحب الإنسان % 50(@)(@@) % ليسوا ينون ، فلا تنوا في أمركم ، % لا ينهض الواني لغير الواني % % 51(@)(@@) % غضبا لدين الله أن لا تغضبوا % % لم يشتهر في نصره سيفان % PageV01P377 52(@)(@@) % حتى كأن الوحي فيكم منزل ، % ولكم تخص فضائل القرآن % 53(@)(@@) % قد أغضبوكم فاغضبوا ، وتأهبوا % % للحرب أهبة ثائر ، غضبان % 54(@)(@@) % ف ' بنو كلاب ' وهي قل أغضبت % فدهت قبائل ' مسهر بن قنان ' % 55(@)(@@) % وبنو عباد ، حين أحرج حارث % جروا التخالف في ' بني شيبان ' % 56(@)(@@) % خلا ' عديا ' ، وهو صاحب ثأرهم % كرما ، ونالوا الثأر بابن أبان % 57(@)(@@) % والمسلمون ، بشاطيء ' اليرموك ' لم % % 58(@)(@@) % وحماة ' هاشم ' حين أخرج صدرها % % جروا البلاء على ' بني مروان ' % 59(@)(@@) % والتغلبيون احتموا عن مثلها % % فعدوا على العادين ب ' السلان ' % 60(@)(@@) % وبغى على ' عبس ' ' حذيفة ' فاشتفت % منه صوارمهم ومن ذبيان % 61(@)(@@) % وسراة ' بكر ' ، بعد 
ms83	 ضيق فرقوا % % جمع الأعاجم عن ' أنوشروان ' % PageV01P378 62(@)(@@) % أبقت لبكر مفخرا ، وسما لها ، % من دون قومهما ، يزيد وهاني % % 63(@)(@@) % المانعين العنقفير بطعنهم ، % والثائرين بمقتل ' النعمان ' ! % PageV01P379 البحر : كامل تام 1(@)(@@) % ما صاحبي إلا الذي من بشره % عنوانه في وجهه ولسانه % 2(@)(@@) % كم صاحب لم أغن عن إنصافه % في عسره ، وغنيت عن إحسانه % PageV01P380 البحر : طويل 1(@)(@@) % % علاها ، وإن ضاق الخناق حماها % % 2(@)(@@) % و ما اشتورت إلا وأصبح شيخها ، % ولا أحربت إلا وكان فتاها % % 3(@)(@@) % ولا ضربت بين القباب قبابه ، % وأصبح مأوى الطارقين سواها % % PageV01P381 البحر : بسيط تام 1(@)(@@) % يا ليلة ، لست أنسى طيبها أبدا ، % كأن كل سرور حاضر فيها % % 2(@)(@@) % باتت ، وبت ، وبات الزق ثالثنا % % حتى الصباح تسقيني وأسقيها % % 3(@)(@@) % كأن سود عناقيد بلمتها ، % أهدت سلافتها صرفا ، إلى فيها % % PageV01P382 البحر : وافر تام 1(@)(@@) % لقد علمت سراة الحي أنا % % لنا الجبل الممنع جانباه % 2(@)(@@) % يفيء الرغبون إلى ذراه ، % و يأوي الخائفون إلى حماه % PageV01P383 البحر : مخلع البسيط 1(@)(@@) % % خلوت ، يوم الفراق ، منه % 2(@)(@@) % ما تركت لي الجفون إلا % ما استنزلتني الخدود عنه % 3(@)(@@) % قد طال يا قلب ما تلاقي ، % إن مات ذو صبوة فكنه % PageV01P384 البحر : كامل تام 1(@)(@@) % خفض عليك ! ولا تبت قلق الحشا % % مما يكون ، وعله ، وعساه % 2(@)(@@) % فالدهر أقصر مدة مما ترى ، % وعساك أن تكفى الذي تخشاه % PageV01P385 البحر : خفيف تام 1(@)(@@) % لست أرجو النجاة ، من كل ما أخ % شاه ، إلا بأحمد وعلي % 2(@)(@@) % وببنت الرسول فاطمة الطه % ر ، وسبطيه والإمام علي % 3(@)(@@) % و التقي النقي باقر علم ال % % له فينا ، محمد بن علي % 4(@)(@@) % و ابنه ' جعفر ' و ' موسى ' ومولا % % نا علي ، أكرم به من علي ! % 5(@)(@@) % وأبي جعفر سمي رسول ال % % له ، ثم ابنه الزكي ' علي ' % 6(@)(@@) % و ابنه ' العسكري ' والقائم المظ % % هر حقي محمد بن علي % 7(@)(@@) % فيهم أرتجي بلوغ الأماني % % PageV01P386 البحر : هزج 1(@)(@@) % عرفت الشر لا للشر % لكن لتوقيه % 2(@)(@@) % ومن لم يعرف الشر % من الناس يقع فيه % PageV01P387 البحر : مجتث 1(@)(@@) % قلبي يحن إليه % نعم ، ويحنو عليه % 2(@)(@@) % و ما جنى 
ms84	 أو تجنى % % إلا اعتذرت إليه % 3(@)(@@) % فكيف أملك قلبي ، % والقلب رهن لديه ؟ % 4(@)(@@) % وكيف أدعوه عبدي ، % و عهدتي في يديه ؟ % PageV01P388 البحر : مجتث 1(@)(@@) % ألورد في وجنتيه ، % والسحر في مقلتيه ! % 2(@)(@@) % وإن عصاه لساني % % فالقلب طوع يديه ! % 3(@)(@@) % يا ظالما ، لست أدري % % أدعو له ، أم عليه ! % 4(@)(@@) % أنا إلى الله مما % % دفعت منه إليه ! % PageV01P389 البحر : مجزوء الكامل 1(@)(@@) % لمن الجدود الأكرمو % % ن ، من الورى ، إلا ليه ؟ % 2(@)(@@) % من ذا يعد ، كما أعد ، % من الجدود العاليه ؟ % 3(@)(@@) % من ذا يقوم لقومه ، % بين الصفوف ، مقاميه ! ؟ % 4(@)(@@) % من ذا يرد صدوره % ن ، إذا أغرن علانيه ؟ % 5(@)(@@) % أحمي حريمي أن يبا % % ح ، ولست أحمي ماليه ! % 6(@)(@@) % وتخافني كوم اللقا % % ح ، وقد أمن عداتيه % 7(@)(@@) % تمسي ، إذا طرق الضيو % % ف ، فناؤها بفنائيه % 8(@)(@@) % ناري ، على شرف تأج % % ج ، للضيوف الساريه % 9(@)(@@) % يا نار ، إن لم تجلبي % % ضيفا ، فلست بناريه ! % 10(@)(@@) % والعز مضروب السرا % % دق والقباب الجاريه % PageV01P390 11(@)(@@) % يجني ولا يجنى علي % ه ، ويتقي الجلى بيه ! % PageV01P391 البحر : مجزوء الكامل 1(@)(@@) % انظر لضعفي ، ياقوي ! % وكن لفقري ، يا غني ! % 2(@)(@@) % أحسن إلي ؛ فإنني % % عبد إلى نفسي مسي ! % PageV01P392 البحر : مجزوء الكامل 1(@)(@@) % لولا العجوز بمنبج % ما خفت أسباب المنيه % 2(@)(@@) % ولكان لي ، عما سأل % ت من الفدا ، نفس أبيه % 3(@)(@@) % لكن أردت مرادها ، % ولو انجذبت إلى الدنيه % 4(@)(@@) % وأرى محاماتي علي % ها أن تضام من الحميه % 5(@)(@@) % أمست ب ' منبج ' ، حرة % بالحزن ، من بعدي ، حريه % 6(@)(@@) % لو كان يدفع حادث ، % أو طارق بجميل نيه % 7(@)(@@) % لم تطرق نوب الحوا % % دث أرض هاتيك التقيه % 8(@)(@@) % لكن قضاء الله ، وال % % أحكام تنفذ في البريه % 9(@)(@@) % والصبر يأتي كل ذي % % رزء على قدر الرزيه % 10(@)(@@) % لا زال يطرق منبجا ، % في كل غادية ، تحيه % PageV01P393 11(@)(@@) % فيها التقى ، والدين مج % % موعان في نفس زكيه % 12(@)(@@) % يا أمتا ! لا تحزني ، % وثقي بفضل الله فيه ! % 13(@)(@@) % يا أمتا ! لا تيأسي ، % لله ألطاف خفيه % 14(@)(@@) % كم حادث عنا جلا % % ه ، وكم كفانا من بليه % 15(@)(@@) % أوصيك بالصبر الجمي 
ms85	 % % ل ! فإنه خير الوصيه ! % PageV01P394 البحر : رجز تام 1(@)(@@) % ما العمر ما طالت به الدهور ، % العمر ما تم به السرور ! % 2(@)(@@) % أيام عزي ، ونفاذ أمري % % هي التي أحسبها من عمري % % 3(@)(@@) % ما أجور الدهر على بنيه ! % وأغدر الدهر بمن يصفيه ! % 4(@)(@@) % لو شئت مما قد قللن جدا % % عددت أيام السرور عدا % % 5(@)(@@) % أنعت يوما ، مر لي ب ' الشام ' ، % ألذ ما مر من الأيام % 6(@)(@@) % دعوت بالصقار ، ذات يوم ، % عند انتباهي ، سحرا من نومي % % 7(@)(@@) % قلت له : اختر سبعة كبارا % كل نجيب يرد الغبارا % % 8(@)(@@) % يكون للأرنب منها اثنان ، % وخمسة تفرد للغزلان % 9(@)(@@) % واجعل كلاب الصيد نوبتين % ترسل منها اثنين بعد اثنين % % 10(@)(@@) % و لا تؤخر أكلب العراض ! % فهن حتف للظباء قاض % PageV01P395 11(@)(@@) % ثم تقدمت إلى الفهاد % والبازيارين بالاستعداد % 12(@)(@@) % وقلت : إن خمسة لتقنع % والزرقان : الفرخ والملمع % 13(@)(@@) % و أنت ، يا طباخ ، لا تباطا ! % عجل لنا اللبات والأوساطا ! % 14(@)(@@) % ويا شرابي البلقسيات % تكون بالراح ميسرات % 15(@)(@@) % بالله لا تستصحبوا ثقيلا ! % واجتنبوا الكثرة والفضولا ! % 16(@)(@@) % ردوا فلانا ، وخذوا فلانا ! % وضمنوني صيدكم ضمانا ! % 17(@)(@@) % فاخترت ، لما وقفوا طويلا ، % عشرين ، أو فويقها قليلا % % 18(@)(@@) % عصابة ، أكرم بها عصابه ، % معروفة بالفضل والنجابه % % 19(@)(@@) % ثم قصدنا صيد عين قاصر % مظنة الصيد لكل خابر % 20(@)(@@) % جئناه والشمس ، قبيل المغرب % تختال في ثوب الأصيل المذهب % % PageV01P396 21(@)(@@) % وأخذ الدراج في الصياح ، % مكتنفا من سائر النواحي % % 22(@)(@@) % في غفلة عنا وفي ضلال ، % ونحن قد زرناه بالآجال % 23(@)(@@) % يطرب للصبح ، وليس يدري % % أن المنايا في طلوع الفجر % 24(@)(@@) % حتى إذا أحسست بالصباح % ناديتهم : ' حي على الفلاح ! ' % 25(@)(@@) % نحن نصلي والبزاة تخرج % مجردات ، والخيول تسرج % 26(@)(@@) % فقلت للفهاد : فامض وانفرد % وصح بنا ، إن عن ظبي ، واجتهد % 27(@)(@@) % فلم يزل ، غير بعيد عنا ، % إليه يمضي ما يفر منا % % 28(@)(@@) % وسرت في صف من الرجال ، % كأنما نزحف للقتال % 29(@)(@@) % فما استوينا كلنا حتى وقف % لما رآنا مال بالأعناق % 30(@)(@@) % ثم أتاني عجلا ، قال : ألسبق ! % فقلت : إن كان العيان قد صدق % PageV01P397 31(@)(@@) % سرت إليه فأراني جاثمه 
ms86	 % ظننتها يقظى وكانت نائمه % 32(@)(@@) % ثم أخذت نبلة كانت معي ، % ودرت دورين ولم أوسع % 33(@)(@@) % حتى تمكنت ، فلم أخط الطلب ، % لكل حتف سبب من السبب % 34(@)(@@) % وضجت الكلاب في المقاود ، % تطلبها وهي بجهد جاهد % 35(@)(@@) % وصحت بالأسود كالخطاف % ليس بأبيض ولا غطراف % 36(@)(@@) % ثم دعوت القوم : هذا بازي ! % فأيكم ينشط للبراز ؟ % 37(@)(@@) % فقال منهم رشأ : ' أنا ، أنا ! ' % ولو درى ما بيدي لأذعنا ! % 38(@)(@@) % فقلت : قابلني وراء النهر ، % أنت لشطر وأنا لشطر ! % 39(@)(@@) % طارت له دراجة فأرسلا % % أحسن فيها بازه وأجملا % % 40(@)(@@) % علقها فعطعطوا ، وصاحوا ، % و الصيد من آلته الصياح ! % PageV01P398 41(@)(@@) % فقلت : ما هذا الصياح والقلق ؟ % أكل هذا فرح بذا الطلق ؟ % 42(@)(@@) % فقال : إن الكلب يشوي البازا % % قد حرز الكلب ، فجز ، وجازا % % 43(@)(@@) % فلم يزل يزعق : يا مولائي ! % وهو كمثل النار في الحلفاء % 44(@)(@@) % طارت ، فأرسلت فكانت سلوى % % حلت بها قبل العلو البلوى % % 45(@)(@@) % فما رفعت الباز حتى طارا % % آخر عودا يحسن الفرارا % % 46(@)(@@) % أسود ، صياح ، كريم ، كرز ، % مطرز ، مكحل ، ملزز % 47(@)(@@) % عليه ألوان من الثياب % من حلل الديباج والعنابي % % 48(@)(@@) % فلم يزل يعلو وبازي يسفل % يحرز فضل السبق ليس يغفل % 49(@)(@@) % يرقبه من تحته بعينه ، % وإنما يرقبه لحينه % % 50(@)(@@) % حتى إذا قارب ، فيما يحسب ، % معقله ؛ والموت منه أقرب % PageV01P399 51(@)(@@) % أرخى له بنبجه رجليه ، % والموت قد سابقه إليه % 52(@)(@@) % صحت وصاح القوم بالتكبير ، % وغيرنا يضمر في الصدور % 53(@)(@@) % ثم تصايحنا فطارت واحده % شيطانة من الطيور مارده % 54(@)(@@) % من قرب فأرسلوا إليها % % ولم تزل أعينهم عليها % % 55(@)(@@) % فلم يعلق بازه وأدى % % من بعد ما قاربها وشدا % % 56(@)(@@) % صحت : أهذا الباز أم دجاجه ؟ % ليت جناحيه على دراجه % 57(@)(@@) % فاحمرت الأوجه والعيون % وقال : هذا موضع ملعون % 58(@)(@@) % إن لزها الباز أصابت نبجا % % أو سقطت لم تلق إلا مدرجا % % 59(@)(@@) % اعدل بنا للنبج الخفيف % والموضع المنفرد المكشوف % 60(@)(@@) % فقثلت : هذي حجة ضعيفة % وغرة ظاهرة معروفه % PageV01P400 61(@)(@@) % نحن جميعا في مكان واحد ، % فلا تعلل بالكلام البارد ! % 62(@)(@@) % قص جناحيه يكن في الدار % مع الدباسي ، ومع القماري 
ms87	 ! % 63(@)(@@) % واعمد إلى جلجله البديع ، % فاجعله في عنز من القطيع ! % 64(@)(@@) % حتى إذا أبصرته ، وقد خجل ، % قلت : أراه ، فارها ، على الحجل % 65(@)(@@) % دعه ، وهذا الباز فاطرد به % تفاديا من غمه وعتبه ! % 66(@)(@@) % وقلت للخيل ، التي حولينا : % تشاهدوا كلكم علينا ! % 67(@)(@@) % بأنه عارية مضمونه ، % يقيم فيها جاهه ودينه % 68(@)(@@) % جئت بباز حسن مبهرج % دون العقاب وفويق الزمج % 69(@)(@@) % زين لرائيه ، وفوق الزين ، % ينظر من نارين في غارين % 70(@)(@@) % كأن فوق صدره والهادي % % آثار مشي الذر في الرماد % PageV01P401 71(@)(@@) % ذي منسر فخم وعين غائره ، % وفخذ ملء اليمين وافره % 72(@)(@@) % ضخم ، قريب الدستبان جدا % % يلقى الذي يحمل منه كدا % % 73(@)(@@) % وراحة تغمر كفي سبطه % زاد على قدر البزاة بسطه % 74(@)(@@) % سر ، وقال : هات ! قلت : مهلا ! % احلف على الرد ! ' فقال : كلا ! % 75(@)(@@) % أما يميني ، فهي عندي غاليه % وكلمتي مثل يميني وافيه % % 76(@)(@@) % قلت : فخذه هبة بقبلة ! % فصد عني ، وعلته خجله % 79(@)(@@) % فلم أزل أمسحه حتى انبسط % وهش للصيد قليلا ، ونشط % 80(@)(@@) % صحت به : اركب ! فاستقل عن يد % مبادرا أسرع من قول : قد ! % 81(@)(@@) % وضم ساقيه وقال : قد حصل ! % قلت له : ' الغدرة من شر العمل ! ' % 82(@)(@@) % سرت ، وسار الغادر العيار % ليس لطير معنا مطار % PageV01P402 83(@)(@@) % ثم عدلنا نحونهر الوادي ، % والطير فيه عدد الجراد % 84(@)(@@) % أدرت شاهينين في مكان % لكثرة الصيد مع الإمكان % 85(@)(@@) % دارا علينا دورة وحلقا ، % كلاهما ، حتى إذا تعلقا % % 86(@)(@@) % توازيا ، واطردا اطرادا ، % كالفارسين التقيا أو كادا % % 87(@)(@@) % ثمت شدا فأصابا أربعا % % ثلاثة خضرا ، وطيرا أبقعا % % 88(@)(@@) % ثم ذبحناها ، وخلصناهما % % وأمكن الصيد فأرسلناهما % % 89(@)(@@) % فجدلا خمسا من الطيور ، % فزادني الرحمن في سروري % % 90(@)(@@) % أربعة منها أنيسيان % وطائرا يعرف بالبيضاني % % 91(@)(@@) % خيل نناجيهن كيف شينا % % طيعة ، ولجمها أيدينا % % 92(@)(@@) % وهي إذا ما استصعب القياده % صرفها الجوع على الإراده % PageV01P403 93(@)(@@) % % تساقطت ما بيننا من الفرق % 94(@)(@@) % حتى أخذنا ما أردنا منها % % ثم انصرفنا راغبين عنها % % 95(@)(@@) % إلى كراكي بقرب النهر % عشرا نراها ، أو فويق العشر % 96(@)(@@) % لما رآها الباز ، من بعد ، لصق % وحدد الطرف إليها 
ms88	 وذرق % 97(@)(@@) % فقلت : قد صاد ، ورب الكعبه ، % % 98(@)(@@) % فدار حتى أمكنت ثم نزل % فحط منها أفرعا مثل الجمل % 99(@)(@@) % ما انحط إلا وأنا إليه % ممكنا رجلي من رجليه % 100(@)(@@) % جلست كي أشبعه إذا هيه % قد سقطت من عن يمين الرابيه % 101(@)(@@) % فشلته أرغب في الزيادة ، % وتلك للطراد شر عادة % % 102(@)(@@) % لم أجزه بأحسن البلاء ، % أطعت حرصي ، وعصيت دائي % % PageV01P404 103(@)(@@) % فلم أزل أختلها وتختتل ، % وإنما نختلها إلى أجل % 104(@)(@@) % عمدت منها لكبير مفرد % يمشي بعنق كالرشاء المحصد % 105(@)(@@) % طار ، وما طار ليأتيه القدر ، % وهل لما قد حان سمع أو بصر ! ؟ % 106(@)(@@) % حتى إذا جدله كالعندل ، % أيقنت أن العظم غير الفصل % 107(@)(@@) % ذاك ، على ما نلت منه ، أمر % عثرت فيه وأقال الدهر ! % 108(@)(@@) % خير من النجاح للإنسان % % 109(@)(@@) % صحت إلى الطباخ : ماذا تنتظر ؟ % انزل عن المهر ، وهات ما حضر % 110(@)(@@) % جاء بأوساط ، وجرد تاج ، % من حجل الصيد ومن دراج % 111(@)(@@) % فما تنازلنا عن الخيول ، % يمنعنا الحرص عن النزول % 112(@)(@@) % وجيء بالكأس وبالشراب ، % فقلت : وفرها على أصحابي ! % PageV01P405 113(@)(@@) % أشبعني اليوم ورواني الفرح ، % فقد كفاني بعض وسط وقدح % 114(@)(@@) % ثم عدلنا نطلب الصحراء ، % نلتمس الوحوش والظباء % 115(@)(@@) % عن لنا سرب ببطن الوادي % % 116(@)(@@) % قد صدرت عن منهل روي ، % من غبر الوسمي والولي % 117(@)(@@) % ليس بمطروق ولا بكي ، % ومرتع مقتبل جني % 118(@)(@@) % رعين فيه ، غير مذعورات ، % % 119(@)(@@) % مر عليه غدق السحاب % بواكف ، متصل الرباب % 120(@)(@@) % مازال في خفض ، وحسن حال % حتى أصابته بنا الليالي % % 121(@)(@@) % سرب حماه الدهر ما حماه % لما رآنا ارتد ما أعطاه % 122(@)(@@) % بادرت بالصقار والفهاد % حتى سبقناه إلى الميعاد % PageV01P406 123(@)(@@) % فجدل الفهد الكبير الأقرنا ، % شد على مذبحه واستبطنا % % 124(@)(@@) % وجدل الآخر عنزا حائلا % رعت حمى الغورين حولا كاملا % % 125(@)(@@) % ثم رميناهن بالصقور % فجئنها بالقدر المقدور % 126(@)(@@) % أفردن منها في القراح واحدة % % قد ثقلت بالخصر وهي جاهده % 127(@)(@@) % مرت بنا ، والصقر في قذالها % % يؤذنها بسيء من حالها % % 128(@)(@@) % ثم ثناها وأتاها الكلب % هما ، عليها ، والزمان إلب % 129(@)(@@) % فلم نزل نصيدها ونصرع % حتى 
ms89	 تبقى في القطيع أربع % 130(@)(@@) % ثم عدلنا عدلة إلى الجبل % إلى الأراوي ، والكباش والحجل % 131(@)(@@) % فلم نزل بالخيل والكلاب % نحوزها حوزا ، إلى الغياب % 132(@)(@@) % ثم انصرفنا ، والبغال موقره ، % في ليلة ، مثل الصباح ، مسفره % PageV01P407 133(@)(@@) % حتى أتينا رحلنا بليل ، % وقد سبقنا بجياد الخيل % 134(@)(@@) % % حتى عددنا مئة وزيدا % % 135(@)(@@) % فلم نزل نقلي ، ونشوي ، ونصب ، % حتى طلبنا صاحيا فلم نصب % 136(@)(@@) % شربا ، كما عن ، من الزقاق % بغير ترتيب ، وغير ساق % 137(@)(@@) % فلم نزل سبع ليال عددا % % أسعد من راح ، وأحظى من غدا % % PageV01P408 
