ms1021	(@)(@@)(@@)(@@) $ 8100 - سعيد بن خازم أبو عبد الرحمن كوفي يروي عن الأعمش والكوفيين روى عنه أبو أحمد الزبيري(@)(@@)(@@)(@@) $ 8101 - سعيد بن خثيم أبو معمر الهلالي من أهل الكوفة وقد قيل إنه من بني سليط يروي عن جده راشد بن عبد الله وعن أخيه معمر بن خثيم روى عنه جعفر بن حيان PageV06P359(@)(@@)(@@)(@@) $ 8102 - سعيد بن أبي خيرة يروي عن الحسن روى عنه داود بن أبي هند(@)(@@)(@@)(@@) $ 8103 - سعيد القيسي يروى عن بن سيرين وعكرمة روى عنه بن المبارك ومعن بن عيسى(@)(@@)(@@)(@@) $ 8104 - سعيد بن أبي عروبة واسم أبي عروبة مهران مولى بني يشكر كنيته أبو النضر يروي عن قتادة والنضر بن أنس بن مالك روى عنه أهل العراق وابن المبارك والناس مات سنة خمسين ومائة قبل هشام الدستوائي بثلاث سنين وكان قد اختلط سنة خمس وأربعين ومائة وبقى خمس سنين في اختلاطه وأحب إلى أن لا يحتج به إلا بما روى عنه القدماء قبل اختلاطه مثل بن المبارك ويزيد بن زريع وذويهما ويعتبر برواية المتأخرين عنه دون الاحتجاج بهما وكان سماع شعيب بن إسحاق منه سنة أربع وأربعين ومائة قبل أن يختلط بسنة وقد قيل مات بن عروبة سنة خمس وخمسين ومائة(@)(@@)(@@)(@@) $ 8105 - سعيد بن عجلان يروي عن سعيد بن جبير روى عنه رباح بن أبى معروف يخطىء ويخالف(@)(@@)(@@)(@@) $ 8106 - سعيد بن دينار يروي عن الشعبي روى عنه وكيع بن الجراح PageV06P360(@)(@@)(@@)(@@) $ 8107 - سعيد بن سويد الكلبي من أهل الشام يروى عن عبيدة الأملوكى وعن عبد الأعلى بن هلال عن العرباض روى عنه معاوية بن صالح(@)(@@)(@@)(@@) $ 8108 - سعيد بن سابق والد محمد بن سعيد يروي عن إسماعيل بن أبي خالد روى عنه هارون بن المغيرة الرازي(@)(@@)(@@)(@@) $ 8109 - سعيد بن عثمان البلوي يروي عن عاصم بن أبي البداح عن أبيه روى عنه عيسى بن يونس(@)(@@)(@@)(@@) $ 8110 - سعيد بن أبي رعدة يروي عن قتادة روى عنه أبو عبيدة الحداد(@)(@@)(@@)(@@) $ 8111 - سعيد بن حكيم القيسي أبو زيد يروي عن حبيب بن سليم روى عنه إبراهيم بن 
ms1022	 محمد بن ميمون الكندي PageV06P361(@)(@@)(@@)(@@) $ 8112 - سعيد الزيات يروى عن بن الحنفية روى عنه فرات القزاز(@)(@@)(@@)(@@) $ 8113 - سعيد بن مرجانة مولى لبني عامر بن لؤي من أهل الحجاز يروي عن علي بن الحسين روى عنه إسماعيل بن أبي حكيم وأهل المدينة مات سنة عشرين ومائة وهو سعيد بن عبد الله ومرجانة أمه ولم يسمع من أبي هريرة شيئا(@)(@@)(@@)(@@) $ 8114 - سعيد بن سويد يروي عن عبد الملك بن عمير روى عنه محمد بن الصلت(@)(@@)(@@)(@@) $ 8115 - سعيد بن زربى يروي عن مجاهد روى عنه القاسم بن مالك المزني وليس هذا بسعيد بن زربى صاحب ثابت ذاك ضعيف وهذا صدوق(@)(@@)(@@)(@@) $ 8116 - سعيد بن أبي أيوب من أهل مصر يروي عن زيد بن أسلم وأهل المدينة روى عنه خالد بن يزيد وأهل مصر مات سنة تسع PageV06P362 وأربعين ومائة وقد قيل إنه مات في آخر سنة إحدى وستين أو أول اثنتين وستين ومائة(@)(@@)(@@)(@@) $ 8117 - سعيد بن عبيد الله الجبيري يروي عن الحكم بن عبد الله بن إسحاق عن بن عباس في صوم يوم عاشوراء روى عنه روح بن عبادة وهو الذي يروي عن بكر بن عبد الله المزني(@)(@@)(@@)(@@) $ 8118 - سعيد بن ذكوان أبو العراف يروي عن طاوس ووهب بن منبه روى عنه مطرف بن مازن(@)(@@)(@@)(@@) $ 8119 - سعيد بن سلمة شيخ من أهل الشام يروي عن أبيه روى عنه عمرو بن الحارث وسليمان بن أبي زينب(@)(@@)(@@)(@@) $ 8120 - سعيد بن أبي سعيد مولى المهري كنيته أبو السميط يروي عن أبيه وإسحاق مولى زائدة روى عنه أسامة بن زيد وحرملة بن عمران وليس هذا بسعيد بن أبي سعيد المقبري ذاك أدخلناه في التابعين وهذا في أتباع التابعين PageV06P363(@)(@@)(@@)(@@) $ 8121 - سعيد بن أبي سعيد الثعلبي كنيته أبو الصباح يروي عن أبي الشعثاء وعكرمة روى عنه وكيع بن الجراح(@)(@@)(@@)(@@) $ 8122 - سعيد بن سعيد بن جوربنده من أهل اليمن يروي عن عطاء روى عنه أبو عاصم النبيل(@)(@@)(@@)(@@) $ 8123 - سعيد بن خازم التيمي كوفي يروي عن أبي إسحاق الشيباني والأعمش روى عنه خالد بن 
ms1023	 مخلد القطواني والكوفيون(@)(@@)(@@)(@@) $ 8124 - سعيد بن عبد الله بن جابر يروي عن سعيد بن المسيب وعروة بن الزبير روى عنه بكير بن عبد الله بن الأشج(@)(@@)(@@)(@@) $ 8125 - سعيد بن سلمة المخزومي من آل بن الأزرق من PageV06P364 أهل المدينة يروي عن المغيرة بن أبي بردة روى عنه صفوان بن سليم(@)(@@)(@@)(@@) $ 8126 - سعيد بن صفوان التجيبي من أهل مصر يروي عن سعيد بن مسعود قوله روى عنه معاوية بن صالح(@)(@@)(@@)(@@) $ 8127 - سعيد بن سليمان الربعي وقد قيل الربيعي يروي المراسيل روى عنه عمران القصير(@)(@@)(@@)(@@) $ 8128 - سعيد بن عبد الله شيخ يروي عن الحسن روى عنه موسى بن إسماعيل(@)(@@)(@@)(@@) $ 8129 - سعيد بن عبد الجبار الزبيدي من أهل الشام يروي عن عمر بن روبة التغلبي عن أبي أمامة الباهلي روى عنه أهل بلده(@)(@@)(@@)(@@) $ 8130 - سعيد بن عبد الرحمن الزبيدي كنيته أبو شيبة يروي عن مجاهد وابن أبي مليكة روى عنه عبد الواحد بن زياد ومروان بن معاوية الفزاري وليس هذا بسعيد بن عبد الرحمن الذي كان بالري ذاك زبيري بالراء روى عنه حكام بن سلم وهذا زبيدى بالدال مات PageV06P365 سعيد بن عبد الرحمن الزبيدي سنة ست وخمسين ومائة(@)(@@)(@@)(@@) $ 8131 - سعيد بن عبيد الطائي من أهل الكوفة كنيته أبو الهذيل يروي عن علي بن ربيعة وبشير بن يسار روى عنه عبد الله بن المبارك ووكيع(@)(@@)(@@)(@@) $ 8132 - سعيد بن المهلب بن أبي صفرة يروي عن طلق بن حبيب قال كنت أشد الناس تكذيبا بالشفاعة حتى لقيت جابر بن عبد الله فقال صمنا إن لم أكن سمعت محمدا يقول يخرجون من النار الحديث روى عنه القاسم بن الفضل الحداني(@)(@@)(@@)(@@) $ 8133 - سعيد بن المهلب يروي عن سعيد بن جبير روى عنه طلحة بن النضر(@)(@@)(@@)(@@) $ 8134 - سعيد بن سماك بن حرب قال مر محارب بن دثار فقال PageV06P366 يا أبا المغيرة روى عنه عارم وقد روى عن أبيه قال لا أعلمه إلا عن جابر بن سمرة قال كان رسول الله صلى الله عليه وسلم يقرأ في صلاة المغرب ليلة الجمعة 
ms1024	 قل يا أيها الكافرون وقل هو الله أحد وكان يقرأ في صلاة العشاء الآخرة ليلة الجمعة سورة الجمعة والمنافقين ثنا جماعة من شيوخنا عن أبي قلابة قال حدثني أبي قال حدثني سعيد بن سماك والمحفوظ عن سماك أن النبي صلى الله عليه وسلم(@)(@@)(@@)(@@) $ 8135 - سعيد بن فروة يروي عن شريح روى عنه بن ابنه خالد بن يزيد بن سعيد بن فروة(@)(@@)(@@)(@@) $ 8136 - سعيد بن أبي غليظ من أهل الشام يروي عن عبادة بن نسي روى عنه سعيد بن أبي أيوب(@)(@@)(@@)(@@) $ 8137 - سعيد بن عبد الرحمن أخو أبي حرة من أهل البصرة يروى عن بن سيرين روى عنه عبد الرحمن بن مهدي وأبو نعيم PageV06P367(@)(@@)(@@)(@@) $ 8138 - سعيد بن عمير يروي عن نافع عن بن عمر في عرق يوم القيامة روى عبد الحميد بن جعفر عن أبيه عنه(@)(@@)(@@)(@@) $ 8139 - سعيد بن عبد الرحمن الأموي مولى سعيد بن العاص يروي عن حنظلة بن علي روى عنه إسحاق بن سليمان الرازي(@)(@@)(@@)(@@) $ 8140 - سعيد بن غنيم الكلاعي كنيته أبو غنيم من أهل الشام يروي المراسيل روى عنه إسماعيل بن عياش وليس هذا بسعيد بن حدير أبو غنيم(@)(@@)(@@)(@@) $ 8141 - أبو العنبس اسمه سعيد بن كثير بن عبيد التيمي من موالي أبي بكر عداده في أهل الكوفة وكان أصله من المدينة يروي عن أبيه عن أبي هريرة روى عنه عيسى بن يونس والكوفيون PageV06P368(@)(@@)(@@)(@@) $ 8142 - سعيد بن عمرو بن أشوع القاضي يروي عن الشعبي روى عنه زكريا بن أبي زائدة والثوري(@)(@@)(@@)(@@) $ 8143 - سعيد بن كثير بن المطلب بن أبي وداعة السهمي من أهل مكة أخو كثير بن كثير كنيته أبو إسماعيل يروي عن عمه جعفر بن المطلب روى عنه بن جريج(@)(@@)(@@)(@@) $ 8144 - سعيد بن عبد العزيز بن أبي يحيى التنوخي من أهل دمشق كنيته أبو محمد وكان من عباد أهل الشام وفقهائهم ومتقنيهم في الرواية يروي عن الزهري ونافع ومكحول روى عنه أهل الشام مات سنة سبع وستين ومائة وهو بن بضع وسبعين سنة وكان يقول ولد الأوزاعي قبل 
ms1025	 أن يجمع أبواي(@)(@@)(@@)(@@) $ 8145 - سعيد بن عبد الملك بن مروان بن الحكم أخو سليمان ويزيد والوليد وهشام يروي عن المدنيين روى عنه هشام بن عروة وأهل المدينة وكان يقال له سعيد الخير لم يسلك مسلك أخوته فيما PageV06P369 كانا فيه حدثنا إبراهيم بن خزيم بالشاش قال ثنا عبد بن حميد قال ثنا أبو نعيم قال ثنا عبد السلام بن حرب عن إسحاق بن عبد الله بن أبي فروة عن سعيد بن عبد الملك عن عمرو بن ثابت العتواري عن أبي سعيد الخدري عن النبي صلى الله عليه وسلم قال ليلة القدر ليلة ثلاث وعشرين(@)(@@)(@@)(@@) $ 8146 - سعيد بن الفضل القرشي كنيته أبو عثمان من أهل البصرة يروي عن عاصم الأحول وابن سيرين روى عنه أهل البصرة(@)(@@)(@@)(@@) $ 8147 - سعيد بن عمرو بن جعدة المخزومي يروي عن أبيه والزهري روى عنه عثمان بن عبد الله بن أبي عتيق(@)(@@)(@@)(@@) $ 8148 - سعيد بن عثمان يروي عن مسلم بن أبي بكرة عداده في أهل البصرة روى عنه عبد الصمد بن عبد الوارث(@)(@@)(@@)(@@) $ 8149 - سعيد بن مسلم بن جندب الهذلي أخو عبد الله بن مسلم يروي عن أبيه روى عنه الصلت بن محمد PageV06P370(@)(@@)(@@)(@@) $ 8150 - سعيد بن مسروق الثوري من أهل الكوفة يروي عن الشعبي وعكرمة روى عنه ابنه سفيان الثوري وشعبة وأبو عوانة مات سنة ثمان وعشرين ومائة(@)(@@)(@@)(@@) $ 8151 - سعيد بن عطية الليثي كنيته أبو سلمة يروي عن سعيد بن جبير روى عنه أبو داود الطيالسي(@)(@@)(@@)(@@) $ 8152 - سعيد بن أبي كعب من أهل البصرة يروي عن راشد الحماني والبصريين وراشد سمع أنسا روى عنه محمد بن عقبة السدوسي(@)(@@)(@@)(@@) $ 8153 - سعيد بن مسلم القرشي يروي عن محمد بن زياد روى عنه موسى بن إسماعيل(@)(@@)(@@)(@@) $ 8154 - سعيد بن مرثد من أهل الشام يروي عن عبد الرحمن بن حوشب روى عنه حريز بن عثمان الرحبي PageV06P371(@)(@@)(@@)(@@) $ 8155 - سعيد بن عبيد الله الثقفي يروي عن زياد بن جبير بن حية عن أبيه عن النبي صلى الله عليه وسلم قال الراكب خلف الجنازة والماشي 
ms1026	 سواء حيث شاء منهما والطفل يصلى عليه روى عنه أبو عبيدة الحداد وزياد بن جبير سمع بن عمر(@)(@@)(@@)(@@) $ 8156 - سعيد بن معدي كرب قوله روى عنه حريز بن عثمان الرحبي(@)(@@)(@@)(@@) $ 8157 - سعيد بن أبي راشد يروي عن عطاء عن أبي هريرة في المسح على الخفين روى عنه مروان بن معاوية إن لم يكن سعيد بن السماك فلا أدري من هو فإن كان ذاك فهو ضعيف PageV06P372(@)(@@)(@@)(@@) $ 8158 - سعيد بن نمران من أهل الشام يروي عن يزيد بن نمران روى عنه سعيد بن عبد العزيز التنوخي(@)(@@)(@@)(@@) $ 8159 - سعيد بن موسى بن وردان المصري يروي عن هشام بن أبي رقية روى عنه حيوة بن شريح(@)(@@)(@@)(@@) $ 8160 - سعيد بن يزيد أبو الشجاع الحميري الإسكندراني يروي عن عبد الله بن هبيرة روى عنه الليث بن سعد وابن المبارك(@)(@@)(@@)(@@) $ 8161 - سعيد بن مروان أبو عثمان الرهاوي يروي عن عصام بن بشير روى عنه أهل الجزيرة(@)(@@)(@@)(@@) $ 8162 - سعيد مولى بني شيبة من أهل مكة يروي عن عطاء وطاوس روى عنه القاسم بن مالك المزني(@)(@@)(@@)(@@) $ 8163 - سعيد بن يزيد الكوفي يروي عن الشعبي روى عنه أبو نعيم الفضل بن دكين PageV06P373(@)(@@)(@@)(@@) $ 8164 - سعيد بن يحيى الذي يقال له سعدان من أهل الشام يروي عن إسماعيل بن أبي خالد روى عنه هشام بن عمار(@)(@@)(@@)(@@) $ 8165 - سعيد بن أبي هلال الليثي من أهل المدينة يروي عن سعيد بن جبير وزيد بن أسلم ونافع روى عنه المدنيون وأهل مصر سعيد بن أبي سعيد المقبري وعبد الرحمن بن حرملة ويزيد بن أبي حبيب وذووهم مات سنة تسع وأربعين ومائة(@)(@@)(@@)(@@) $ 8166 - سعيد بن محمد الوراق أبو الحسن يروي عن الأعمش روى عنه أهل الكوفة(@)(@@)(@@)(@@) $ 8167 - سعيد بن يوسف يروي عن يحيى بن أبي كثير روى عنه إسماعيل بن عياش(@)(@@)(@@)(@@) $ 8168 - سعيد بن أبي يحيى من أهل اليمن يروي عن أبيه روى عنه أبو عاصم النبيل(@)(@@)(@@)(@@) $ 8169 - سعيد بن مسلمة بن هشام بن عبد الملك بن مروان أبو عثمان أمه أم ولد كان يسكن الزيتونة 
ms1027	 بالجزيرة يروي عن يحيى بن سعيد الأنصاري روى عنه الناس PageV06P374(@)(@@)(@@)(@@) $ 8170 - سعد بن إبراهيم بن عبد الرحمن بن عوف الزهري القرشي كنيته أبو إبراهيم يروي عن بن المسيب والقاسم بن محمد قدم واسط فكتب عنه الثوري وشعبة ومات سنة خمس وعشرين ومائة وقد قيل سنة ست وعشرين ومائة ويقال سنة سبع وعشرين ومائة وكان على قضاء المدينة زمن القاسم بن محمد(@)(@@)(@@)(@@) $ 8171 - سعد بن إسحاق بن كعب بن عجرة السالمي الأنصاري من أهل المدينة يروي عن أبيه روى عنه مالك وشعبة مات قبل خروج محمد بن عبد الله بن الحسن(@)(@@)(@@)(@@) $ 8172 - سعد بن عبادة الزرقي الأنصاري يروي عن أبيه عن عمر وعثمان روى عنه عبد الله بن لاحق PageV06P375(@)(@@)(@@)(@@) $ 8173 - سعد بن شراح المعافري من أهل مصر يروي عن سويد بن عفراء عن أبي ذر روى بن وهب عن يعقوب بن عمرو عنه(@)(@@)(@@)(@@) $ 8174 - سعد بن عمار يروي عن بن المسيب وعروة وأبان بن عثمان روى عنه بكير بن عبد الله بن الأشج(@)(@@)(@@)(@@) $ 8175 - سعد بن عمرو يروي المراسيل روى عنه بن المبارك(@)(@@)(@@)(@@) $ 8176 - سعد بن سالم يروي عن بن سيرين روى عنه سليمان الجرمي(@)(@@)(@@)(@@) $ 8177 - سعد بن زبراء يروي عن أبي سلمة بن عبد الرحمن روى عنه بن جريج(@)(@@)(@@)(@@) $ 8178 - سعد بن عبد الله بن سعد الأيلي أخو الحكم بن عبد الله مولى الحارث بن الحكم بن أبي العاص بن أمية بن عبد شمس يروي عن سالم والقاسم روى عنه ضمرة بن ربيعة PageV06P376(@)(@@)(@@)(@@) $ 8179 - سعد بن أوس العبدي من أهل الكوفة يروي عن الشعبي وبلال بن يحيى روى عنه وكيع وأبو نعيم(@)(@@)(@@)(@@) $ 8180 - سعد بن أوس العدوي من أهل البصرة كنيته أبو محمد يروي عن زياد بن كسيب ومصدع بن أبي يحيى المعرقب روى عنه حميد بن مهران ومحمد بن دينار الطاحي(@)(@@)(@@)(@@) $ 8181 - سعد مولى أبي بكرة الثقفي يروي عن عبيد الله بن أبي بكرة عداده في أهل البصرة روى عنه محمد بن عبد العزيز الجرمي(@)(@@)(@@)(@@) $ 8182 - سعد الثمالي من 
ms1028	 أهل الكوفة يروي المراسيل روى عنه أبو إسحاق السبيعي(@)(@@)(@@)(@@) $ 8183 - سعد بن معاذ الأنصاري يروي عن الحسن روى عنه إسحاق بن رافع PageV06P377(@)(@@)(@@)(@@) $ 8184 - سعد بن زياد بن سعد الأنصاري يروي عن أبيه روى عنه بن أبي فديك(@)(@@)(@@)(@@) $ 8185 - سعد بن الصلت من أهل فارس من شيراز يروي عن الأعمش وإسماعيل بن أبى خالد روى عنه بن ابنته إسحاق بن إبراهيم بن شاذان ربما أغرب(@)(@@)(@@)(@@) $ 8186 - سعد بن المنذر بن أبي حميد الساعدي يروي عن حمزة بن أبي أسيد روى عنه محمد بن عمرو بن علقمة(@)(@@)(@@)(@@) $ 8187 - سعد بن عطية بن قيس الكلابي من أهل الشام يروي عن أبيه روى عنه عبد الأعلى بن مسهر الغساني(@)(@@)(@@)(@@) $ 8188 - سعد بن زياد أبو عاصم مولى بنى هاشم يروي عن نافع روى عنه موسى بن إسماعيل وكان بن عشر سنين حين مات الحجاج بن يوسف PageV06P378(@)(@@)(@@)(@@) $ 8189 - سعد بن سعيد بن قيس بن فهد الأنصاري أخو يحيى بن سعيد وعبد ربه بن سعيد يروي عن عمر بن ثابت عن أبي أيوب الأنصاري روى عنه بن عيينة والناس مات سنة إحدى وأربعين ومائة وكان يخطىء لم يفحش خطأه فلذلك سلكناه مسلك العدول(@)(@@)(@@)(@@) $ 8190 - سعد الطائي أبو مجاهد يروي عن أبي المدلة عن أبي هريرة روى عنه إسماعيل بن أبي خالد وسعدان الجهني وزهير بن معاوية عداده في الكوفيين(@)(@@)(@@)(@@) $ 8191 - سعد بن القعقاع الطائي يروي عن رجل عن عدي بن حاتم وكان شاعرا روى عنه بن عيينة(@)(@@)(@@)(@@) $ 8192 - سليمان بن موسى الأسدي الدمشقي كنيته أبو أيوب PageV06P379 ويقال أبو هاشم يروي عن عطاء ونافع والزهري وكان فقيها ورعا كانوا إذا اجتمعوا عند عطاء هو الذي كان يتولى لهم سؤل المسائل مات سنة خمس عشره ومائه من شربة سقيها وقد قيل إنه سليمان بن موسى بن عمرو بن سعيد بن العاص بن سعيد بن العاص حدثني محمد بن المنذر بن سعيد قال ثنا أبو زرعة قال ثنا سليمان بن عبد الرحمن قال ثنا عبد الله بن كثير القارى عن 
ms1029	 بن جابر قال قدم سليمان بن موسى على هشام بن عبد الملك الرصافة فسقاه طبيب هشام شربة فقتله فسقى هشام ذلك الطبيب من ذلك الدواء فقتله حدثنا القطان بالرقة قال ثنا هشام بن عمار قال ثنا بن عباس قال ثنا المطعم بن المقدام عن عطاء قال سيد شباب أهل العراق الحجاج بن أرطأة وسيد شباب أهل الحجاز عبد الملك بن جريج وسيد شباب أهل الشام سليمان بن موسى PageV06P380(@)(@@)(@@)(@@) $ 8193 - سليمان بن علي بن عبد الله بن عباس بن عبد المطلب أخو داود ومحمد يروي عن أبيه روى عنه محمد بن راشد وابنه محمد بن سليمان(@)(@@)(@@)(@@) $ 8194 - سليمان بن عبد الله الأحول خال بن أبي نجيح يروي عن عطاء روى عنه أهل الحجاز وهو سليمان بن أبي مسلم المكي(@)(@@)(@@)(@@) $ 8195 - سليمان بن مسهر الفزاري من أهل الكوفة يروي عن خرشة بن الحر روى عنه إبراهيم النخعي والأعمش(@)(@@)(@@)(@@) $ 8196 - سليمان بن علي الربعي أبو عكاشة البصري يروي عن أبي المتوكل وأبي الجوزاء روى عنه حماد بن زيد وقد روى عنه يزيد بن هارون قال دلني عليه هشام بن حسان(@)(@@)(@@)(@@) $ 8197 - سليمان بن ناشرة الألهاني من أهل الشام يروي عن محمد بن زياد الألهاني روى عنه سليمان بن سلمة الخبائري يعتبر حديثه من غير رواية سليمان بن سلمة عنه PageV06P381(@)(@@)(@@)(@@) $ 8198 - سليمان بن عطاء بن يزيد الليثي يروي عن أبيه روى عنه يحيى بن أبي عمرو السيباني(@)(@@)(@@)(@@) $ 8199 - سليمان بن ميسرة الأحمسي من أهل الكوفة يروي عن طارق بن شهاب روى عنه الأعمش وطلحة بن مصرف(@)(@@)(@@)(@@) $ 8200 - سليمان بن عبد الله بن عتريس يروي عن عبد الرحمن بن يزيد روى عنه أهل الكوفة(@)(@@)(@@)(@@) $ 8201 - سليمان بن عبد الله بن الزبرقان يروي عن يعلى بن شداد بن أوس عن معاوية روى عنه أهل الجزيزة خالد بن حيان وغيره(@)(@@)(@@)(@@) $ 8202 - سليمان بن الأسود الناجي من أهل البصرة كنيته أبو محمد PageV06P382 يروي عن أبي المتوكل الناجي وابن سيرين روى عنه وهيب بن خالد وسعيد بن أبي عروبة 
ms1030	 وقد قيل سليمان الأسود(@)(@@)(@@)(@@) $ 8203 - سليمان بن سحيم مولى آل عباس بن عبد المطلب ويقال مولى آل حنين عداده في أهل الحجاز يروي عن عطاء وطاوس وإبراهيم بن عبد الله بن معبد روى عنه بن عيينة وابن إسحاق والماجشون وليس هذا مولى لخزاعة ذلك تابعي(@)(@@)(@@)(@@) $ 8204 - سليمان بن عبد الله بن الحارث الهاشمي أخو إسحاق وعبد الله والصلت بني عبد الله بن الحارث يروي عن المدنيين روى عنه الزبير بن سعيد(@)(@@)(@@)(@@) $ 8205 - سليمان بن أبان يروي المراسيل روى عنه سعيد بن أبي هلال(@)(@@)(@@)(@@) $ 8206 - سليمان بن عامر بن عمير الكندي البرزي من أهل مرو قال سمعت الربيع بن أنس يقول من استطاع منكم أن يكون له في PageV06P383 مدينة مرو دار فيها بئرا وطحانة فليفعل روى عنه إسحاق بن إبراهيم الحنظلي وأهل بلده(@)(@@)(@@)(@@) $ 8207 - سليمان البكالي من أهل الكوفة يروي عن عطاء روى عنه أبو عوانة(@)(@@)(@@)(@@) $ 8208 - سليمان بن سفيان أبو سفيان المديني يروي عن عبد الله بن دينار روى عنه المعتمر بن سليمان وأبو عامر العقدى وكان يخطىء(@)(@@)(@@)(@@) $ 8209 - سليمان بن شهاب العبسي يروي عن عبد الله بن المعتمر روى عنه حلام بن صالح(@)(@@)(@@)(@@) $ 8210 - سليمان بن السائب يروي عن الحسن وجابر بن زيد عداده في أهل البصرة روى عنه عصمة بن سالم(@)(@@)(@@)(@@) $ 8211 - سليمان بن عبد الله بصري يروي عن معاذة العدوية روى PageV06P384 عنه نوح بن قيس الطاحي(@)(@@)(@@)(@@) $ 8212 - سليمان بن أبي حثمة المدني يروي عن أبيه عن عمر بن الخطاب روى عنه ابنه عثمان بن سليمان بن أبي حثمة(@)(@@)(@@)(@@) $ 8213 - سليمان بن سويد يروي عن عطاء روى عنه الثوري(@)(@@)(@@)(@@) $ 8214 - سليمان بن حفص القرشي يروي عن الحجازيين روى عنه هشام بن سعد(@)(@@)(@@)(@@) $ 8215 - سليمان بن عبد الرحمن مولى بني عامر بن لؤي يروي عن محمد بن عبد الرحمن عن أبي هريرة روى عنه بن أبي ذئب(@)(@@)(@@)(@@) $ 8216 - سليمان مولى الحسن بن علي يروي عن عبد الله بن أبي طلحة عن أبيه روى عنه أهل العراق ثابت البناني وغيره 
ms1031	(@)(@@)(@@)(@@) $ 8217 - سليمان بن حميد يروي عن محمد بن كعب القرظي روى عنه عمرو بن الحارث وإبراهيم بن نشيط الوعلاني(@)(@@)(@@)(@@) $ 8218 - سليمان بن سليم أبو سلمة الكناني كنانة كلب من PageV06P385 أهل حمص يروي عن يحيى بن جابر وأهل الشام روى عنه محمد بن حرب الأبرش(@)(@@)(@@)(@@) $ 8219 - سليمان بن رفيع الجمال قال دخلت المسجد الحرام والناس مجتمعون على رجل فاطلعت فإذا عطاء بن أبي رباح جالس كأنه غراب أسود حدثنا الحسن بن أحمد بن بسطام بالأبلة قال ثنا عمرو بن علي الفلاس قال ثنا سليمان بن رفيع(@)(@@)(@@)(@@) $ 8220 - سليمان بن سمير الألهاني من أهل الشام يروي عن جماعة من التابعين روى عنه أهل الشام(@)(@@)(@@)(@@) $ 8221 - سليمان بن عبد الرحمن مولى أسد بن خزيمة من أهل PageV06P386 دمشق يروي عن عبيد بن فيروز عن البراء روى عنه الليث بن سعد وعمرو بن الحارث(@)(@@)(@@)(@@) $ 8222 - سليمان بن حصين بن سياه أخو محمد بن حصين يروي عن جدته أم سنبلة روى عنه عمرو بن قيظى(@)(@@)(@@)(@@) $ 8223 - سليمان بن عتبة الدمشقي من أهل الشام يروي عن جماعة من التابعين روى عنه أهل الشام مات سنة خمس وثمانين ومائة(@)(@@)(@@)(@@) $ 8224 - سليمان بن داود الخولاني من أهل دمشق يروي عن الزهري قصة الصدقات روى عنه يحيى بن حمزة وقد روى أبو اليمان عن شعيب عن الزهري بعض ذلك الحديث وليس هذا بسليمان بن داود اليمامي ذلك ضعيف وهذا ثقة وقد رويا جميعا عن الزهرى PageV06P387(@)(@@)(@@)(@@) $ 8225 - سليمان بن عبد الله بن عويمر الأسلمي يروي عن الحجازيين روى عنه عبد الرحمن بن أبي الزناد(@)(@@)(@@)(@@) $ 8226 - سليمان بن خارجة بن زيد بن ثابت الأنصاري من أهل المدينة أخو عبد الله بن خارجة يروي عن خارجة بن زيد بن ثابت الأنصاري روى عنه الوليد بن أبي الوليد(@)(@@)(@@)(@@) $ 8227 - سليمان بن بلال مولى بن أبي عتيق بن أبي بكر الصديق كنيته أبو أيوب وقد قيل أبو محمد من أهل المدينة يروي عن محمد بن المنكدر ويحيى بن سعيد الأنصاري روى عنه خالد بن مخلد 
ms1032	 القطواني وابن أبي أويس مات سنة سبع وسبعين ومائة وقد قيل سنة اثنتين وسبعين ومائة وكان جميلا داهية(@)(@@)(@@)(@@) $ 8228 - سليمان الخوزي شيخ يروي عن الحسن وابن سيرين روى عنه عبيد الله بن عمر القواريري PageV06P388(@)(@@)(@@)(@@) $ 8229 - سليمان أبو الربيع الهمداني يروي عن سعيد بن جبير وأبي عبد الرحمن السلمي روى عنه بن المبارك(@)(@@)(@@)(@@) $ 8230 - سليمان بن عبد الرحمن بن خباب يروي عن القاسم بن محمد روى عنه فليح بن سليمان(@)(@@)(@@)(@@) $ 8231 - سليمان بن سعد يروي عن الزهري روى عنه الليث بن سعد(@)(@@)(@@)(@@) $ 8232 - سليمان بن رزين يروي عن سالم بن عبد الله روى عنه علقمة بن مرثد وهو الذي يقال له سالم بن رزين(@)(@@)(@@)(@@) $ 8233 - سليمان بن سالم القرشي من أهل البصرة كنيته أبو داود يروي عن لبابة مولاة بني خلف عن عائشة روى عنه موسى بن إسماعيل PageV06P389(@)(@@)(@@)(@@) $ 8234 - سليمان بن زرعة يروي المراسيل روى عنه صفوان بن عمرو السكسكي(@)(@@)(@@)(@@) $ 8235 - سليمان بن راشد يروي المقاطيع روى عنه سعيد بن أبي هلال(@)(@@)(@@)(@@) $ 8236 - سليمان بن وهب الأبناوي من أهل اليمن يروي عن النعمان بن بزرج روى عنه أهل صنعاء(@)(@@)(@@)(@@) $ 8237 - سليمان بن أبي خليفة يروي عن جابر بن زيد روى عنه علي بن المديني(@)(@@)(@@)(@@) $ 8238 - سليمان بن المغيرة القيسي مولى قيس بن ثعلبة من أهل البصرة كنيته أبو سعيد يروي عن الحسن وثابت روى عنه بن المبارك وأهل العراق مات سنة خمس وستين ومائة(@)(@@)(@@)(@@) $ 8239 - سليمان بن عبيد الله بن أبي سليمان الكندي أبو عمر يروي عن الحجازيين روى عنه مروان بن معاوية PageV06P390(@)(@@)(@@)(@@) $ 8240 - سليمان العلاف يروي المراسيل روى عنه عوف الأعرابي(@)(@@)(@@)(@@) $ 8241 - سليمان بن عبد الرحمن التجيبي يروي عن سعد بن مسعود روى عنه حيوة بن شريح(@)(@@)(@@)(@@) $ 8242 - سليمان بن مسلمة يروي عن الحسن روى عنه محمد بن سليم البصري(@)(@@)(@@)(@@) $ 8243 - سليمان بن أبي العتيك يروي عن الشعبي روى عنه هشيم والمعتمر بن سليمان(@)(@@)(@@)(@@) $ 8244 - سليمان بن فروخ أبو واصل يروي عن أبي أيوب الأزدي روى عنه قريش بن حيان 
ms1033	(@)(@@)(@@)(@@) $ 8245 - سليمان بن محمد بن كعب بن عجرة الأنصاري السالمي يروي عن عمته زينب عن أبي سعيد الخدري روى عنه أبو طوالة(@)(@@)(@@)(@@) $ 8246 - سليمان أبو داود المعلم مؤدب بن المبارك قال سألت عكرمة عن قول الله تعالى ولقد رآه نزلة أخرى قال رأى ربه بقلبه روى عنه بن المبارك وأهل بلده PageV06P391(@)(@@)(@@)(@@) $ 8247 - سليمان بن عبيد الناجي من أهل البصرة يروي عن أبي الصديق الناجي روى عنه خالد بن الحارث ويحيى القطان وليس هذا بسليمان الأسود(@)(@@)(@@)(@@) $ 8248 - سليمان بن معاذ الضبي يروي عن سماك بن حرب روى عنه أبو داود الطيالسي(@)(@@)(@@)(@@) $ 8249 - سليمان بن عمير يروي عن هانئ عن عثمان روى عنه بن المبارك(@)(@@)(@@)(@@) $ 8250 - سليمان بن كيسان أبو عيسى التميمي يروي عن هارون بن راشد روى عنه حيوة بن شريح PageV06P392(@)(@@)(@@)(@@) $ 8251 - سليمان بن محمد بن محمود بن محمد بن مسلمة الأنصاري من أهل المدينة يروي عن عمه جعفر بن محمود عن محمد بن مسلمة روى عنه سعد بن سعيد(@)(@@)(@@)(@@) $ 8252 - سليمان بن مسلم أبو المعلى النخعي من أهل الكوفة يروي عن الشعبي وأبيه روى عنه التبوذكي(@)(@@)(@@)(@@) $ 8253 - سليمان بن عبيد البارقي الخراساني يروي عن إسماعيل بن ثوبان روى عنه المعتمر بن سليمان(@)(@@)(@@)(@@) $ 8254 - سليمان بن محمد يروي عن أبي حازم روى عنه المستلم بن سعيد الواسطي(@)(@@)(@@)(@@) $ 8255 - سليمان بن عبيد المازني أبو داود يروي عن عمران بن زيد المدني روى عنه موسى بن إسماعيل PageV06P393(@)(@@)(@@)(@@) $ 8256 - سليمان بن عيسى يروي عن جده موسى بن طلحة عن علي روى عنه يحيى بن سعيد الأموي(@)(@@)(@@)(@@) $ 8257 - سليمان العطار من أهل واسط والد صلة بن سليمان يروي عن رياح بن عبيدة عن بن عمر روى عنه شعبة بن الحجاج(@)(@@)(@@)(@@) $ 8258 - سليمان بن مينا من أهل الكوفة يروي عن نفيع روى عنه المسعودي(@)(@@)(@@)(@@) $ 8259 - سليمان بن يسار صاحب المقصورة وكان مكفوفا يروي عن محمد بن عمر بن علي روى عنه بن أبي ذئب وسليمان بن بلال(@)(@@)(@@)(@@) $ 8260 - سليمان بن يسار الحضرمي من أهل الشام يروي 
ms1034	 المراسيل روى عنه صفوان بن عمرو السكسكي(@)(@@)(@@)(@@) $ 8261 - سليمان بن أبي المغيرة أبو عبد الله العبسي من أهل الكوفة يروى PageV06P394 عن سعيد بن جبير وإسماعيل بن أبي خالد روى عنه شعبة والثوري وابن عيينة(@)(@@)(@@)(@@) $ 8262 - سليمان الهمداني يروي عن شريح روى عنه الزبير بن عدي(@)(@@)(@@)(@@) $ 8263 - سليمان بن عبد الله أبو عمران الأنصاري يروي عن أم الدرداء روى عنه أهل الشام(@)(@@)(@@)(@@) $ 8264 - سليمان مولى لهم يعنى للحجازيين يروي عن عبد الله بن المسيب بن أبي السائب روى عنه بن جريج(@)(@@)(@@)(@@) $ 8265 - سليمان بن يزيد أبو المثنى الكعبي من أهل المدينة يروي عن عمر بن طلحة روى عنه بن أبي فديك(@)(@@)(@@)(@@) $ 8266 - سليمان بن حيان الجعفري من أهل الكوفة أبو خالد الأحمر يروي عن يحيى بن سعيد الأنصاري وأبي إسحاق روى عنه إسحاق بن إبراهيم الحنظلي وأهل العراق مات في شوال سنة تسع وثمانين ومائة(@)(@@)(@@)(@@) $ 8267 - سليمان بن أبي يزيد البصري يروي المقاطيع روى عنه بقية بن الوليد PageV06P395(@)(@@)(@@)(@@) $ 8268 - سلمة بن أبي سلمة بن عبد الرحمن بن عوف القرشي الزهري يروي عن أبيه روى عنه الزهري وعقيل بن خالد وأمه أم ولد وأخوه عمر بن أبي سلمة(@)(@@)(@@)(@@) $ 8269 - سلمة بن صفوان بن سلمة الزرقي الأنصاري المدني يروي عن أبي سلمة بن عبد الرحمن روى عنه محمد بن إسحاق ومالك(@)(@@)(@@)(@@) $ 8270 - سلمة بن ضب العتكي من أهل مرو يروي عن سيف بن سبيعة عن بن عمر روى عنه الفضل بن موسى السيناني كنيته أبو أسماء(@)(@@)(@@)(@@) $ 8271 - سلمة بن حبيب يروي عن عروة بن علي السهمي عن أبي هريرة روى عنه الحجاج بن الحجاج الأسلمي(@)(@@)(@@)(@@) $ 8272 - سلمة بن زياد يروي عن سالم بن أبي الجعد روى عنه ابنه زياد بن سلمة PageV06P396(@)(@@)(@@)(@@) $ 8273 - سلمة بن شريح الأنصاري يروي عن يحيى بن محمد بن بشير روى عنه خالد بن حميد(@)(@@)(@@)(@@) $ 8274 - سلمة بن يزيد يروي عن أذينة عن عمر روى عنه المغيرة بن مقسم(@)(@@)(@@)(@@) $ 8275 - سلمة بن شهاب العبدي يروي المراسيل روى عنه إسماعيل بن 
ms1035	 أبي خالد(@)(@@)(@@)(@@) $ 8276 - سلمة بن يحيى بن طلحة بن عبيد الله التيمي أخو طلحة وإسحاق ابني يحيى بن طلحة يروي عن عمته أم إسحاق وكانت تحت الحسن بن علي روى عنه المغيرة بن مقسم(@)(@@)(@@)(@@) $ 8277 - سلمة مولى حميري بن كراثة أبو صخر الحنظلي التميمي يروي عن أبي حرة الرقاشي روى عنه ابنه حماد بن سلمة PageV06P397(@)(@@)(@@)(@@) $ 8278 - سلمة بن النعمان بن سلمة يروى عن أبيه عن بن عمر وابن عباس روى عنه عبد الصمد بن عبد الوارث(@)(@@)(@@)(@@) $ 8279 - سلمة بن عبيد الله يروي عن إبراهيم النخعي روى عنه المغيرة بن مقسم(@)(@@)(@@)(@@) $ 8280 - سلمة بن عبيد الله بن محصن الأنصاري يروي عن أبيه روى عنه عبد الرحمن بن أبي شميلة(@)(@@)(@@)(@@) $ 8281 - سلمة بن حرب بن زياد يروي عن أبي مدرك عن أنس بن مالك أصلح لي شأني كله ولا تكلني إلى أحد من الناس ولا إلى نفسي طرفة عين ثنا محمد بن الحسن بن مكرم بالبصرة قال ثنا نصر بن علي قال ثنا سلمة بن حرب PageV06P398(@)(@@)(@@)(@@) $ 8282 - سلمة بن جنادة الهذلي يروي عن سنان بن سلمة روى عنه الحجاج الأحول(@)(@@)(@@)(@@) $ 8283 - سلمة بن عبد الله بن عمر بن أبي سلمة بن عبد الأسد المخزومي يروي عن المدنيين روى عنه محمد بن عمرو بن علقمة(@)(@@)(@@)(@@) $ 8284 - سلمة بن وهرام يروي عن طاوس وعكرمة روى عنه معمر وابن عيينة وأبيه عبيد الله بن سلمة يعتبر بحديثه من غير رواية زمعة بن صالح عنه(@)(@@)(@@)(@@) $ 8285 - سلمة بن هرثمة يروي عن مسروح روى عنه شبيب بن غرقد(@)(@@)(@@)(@@) $ 8286 - سلمة بن موسى يروي عن سعيد بن جبير روى عنه بن عيينة(@)(@@)(@@)(@@) $ 8287 - سلمة بن بخت مولى قريش من أهل المدينة يروي عن عكرمة روى عنه المدنيون(@)(@@)(@@)(@@) $ 8288 - سلمة بن علقمة التميمي من أهل البصرة كنيته أبو بشر وكان PageV06P399 حافظا متقنا يروى عن بن سيرين ونافع روى عنه شعبة والبصريون(@)(@@)(@@)(@@) $ 8289 - سلمة بن الحجاج أبو بشر يروي عن عكرمة روى عنه الأسود بن شيبان ويحيى القطان(@)(@@)(@@)(@@) $ 8290 - سلمة 
ms1036	 بن بشير الدمشقي يروي عن خصيلة بنت واثلة بن الأسقع عن أبيها روى عنه محمد بن يوسف الفريابي(@)(@@)(@@)(@@) $ 8291 - سلمة بن سابور يروي عن عطية العوفي روى عنه الفضل بن موسى السيناني كان يحيى القطان يتكلم فيه ومن أمحل المحال أن يلزق بسلمة ما جنت يدا عطية(@)(@@)(@@)(@@) $ 8292 - سلمة بن ميمون يروي عن حمزة بن أبي أسيد روى عنه معن بن عيسى القزاز(@)(@@)(@@)(@@) $ 8293 - سلمة بن محرز يروي عن طاوس روى عنه وكيع بن الجراح PageV06P400(@)(@@)(@@)(@@) $ 8294 - سلمة بن السائب الكلبي يروي عن أبي رافع عن أبي هريرة عن النبي صلى الله عليه وسلم في طلوع الشمس من مغربها روى عنه أخوه محمد بن السائب الكلبي(@)(@@)(@@)(@@) $ 8295 - سلمة الصائغ يروي عن عطاء بن أبي رباح روى عنه وكيع بن الجراح(@)(@@)(@@)(@@) $ 8296 - سفيان بن عبد الرحمن بن عاصم بن سفيان الثقفي يروي عن جده عاصم بن سفيان روى عنه أبو الزبير(@)(@@)(@@)(@@) $ 8297 - سفيان بن سعيد بن مسروق بن حمزة بن حبيب بن موهبة بن نصر بن ثعلبة بن ملكان بن ثور بن عبد مناة بن أد بن طابخة بن إلياس بن مضر أبو عبد الله الثوري يروي عن عبد الله بن دينار وعمرو بن دينار روى عنه شعبة وابن المبارك والناس وهم إخوة أربعة سفيان والمبارك وحبيب وعمر بنو سعيد بن PageV06P401 مسروق وكان سفيان من سادات أهل زمانه فقها وورعا وحفظا وإتقانا شمائله في الصلاح والورع أشهر من أن يحتاج إلى الإغراق في ذكرها كان مولده سنة خمس وتسعين في إمارة سليمان بن عبد الملك فلما قعد بنو العباس راوده المنصور على أن يلي الحكم فأبى وخرج من الكوفة هاربا للنصف من ذي القعدة سنة خمس وخمسين ومائة ثم لم يرجع إليها حتى مات وكان موته بالبصرة في دار عبد الرحمن بن مهدي في شعبان سنة إحدى وستين ومائة وهو بن ست وستين سنة وقبره في مقبرة بني كليب بالبصرة وقد زرته وكان قد أوصى إلى عمار بن سيف وكان بن أخته 
ms1037	 بكتبه ليمحوها ويدفنها وليس لسفيان عقب كان له بن فمات قبله(@)(@@)(@@)(@@) $ 8298 - سفيان بن دينار كنية دينار أبو الورقاء الأجمري التمار العصفري كنيته أبو سعيد يروي عن الشعبي ومصعب بن سعد روى عنه عبد الرحمن بن مغراء وأبو أسامة PageV06P402(@)(@@)(@@)(@@) $ 8299 - سفيان بن بشر الأنصاري يروي عن أبي عبد الرحمن الحبلي روى عنه معاوية بن صالح(@)(@@)(@@)(@@) $ 8300 - سفيان بن عيينة بن أبي عمران الهلالي كنيته أبو محمد من أهل الكوفة انتقل إلى مكة يروي عن الزهري وعمرو بن دينار روى عنه أهل الحجاز والغرباء وكان مولده سنة سبع ومائة ليلة النصف من شعبان وجالس الزهرى وهو بن ست عشرة سنة وشهرين ونصف وذلك أن الزهري قدم عليهم سنة ثلاث وعشرين ومائة ثم خرج إلى الشام ومات بها سنة أربع وعشرين ومائة ومات سفيان بن عيينة يوم السبت في آخر يوم من جمادى الآخرة سنة ثمان وتسعين ومائة ودفن بالحجون وكان من PageV06P403 الحفاظ المتقنين وأهل الورع والدين ممن علم كتاب الله وكثر تلاوته له وشهر فيه وحج نيفا وسبعين حجة واسم أبي عمران جده ميمون وهم إخوة خمسة سفيان ومحمد وآدم وعمران وإبراهيم بنو عيينة بن أبي عمران وكلهم قد حمل عنه العلم(@)(@@)(@@)(@@) $ 8301 - سفيان بن حسين بن حسن السلمي من أهل واسط يروي عن عطاء وطاوس والزهري وأما روايته عن الزهري فإن فيها تخاليط يجب أن يجانب وهو ثقة في غير حديث الزهري مات في ولاية هارون يجب أن يمحى اسمه من كتاب المجروحين(@)(@@)(@@)(@@) $ 8302 - سفيان بن عبد الله الحضرمي أبو طلحة الخولاني يروي عن الضحاك بن عبد الرحمن بن عرزب عن أبي موسى الأشعري روى عنه أبو سنان الشامي(@)(@@)(@@)(@@) $ 8303 - سفيان بن زياد يروي عن سعيد بن جبير وعكرمة روى عنه أبو أسامة PageV06P404(@)(@@)(@@)(@@) $ 8304 - سفيان بن منقذ يروي عن أبيه عن بن عمر روى عنه حرملة بن عمران(@)(@@)(@@)(@@) $ 8305 - سفيان بن عبد الرحمن الثقفي يروي عن داود بن أبي عاصم روى عنه ابنه عبد الله بن سفيان(@)(@@)(@@)(@@) $ 8306 - سفيان بن 
ms1038	 عبد الله بن محمد بن زياد بن حدير الأسدي من أهل الكوفة يروي عن زياد بن حدير روى عنه جرير بن عبد الحميد والكوفيون(@)(@@)(@@)(@@) $ 8307 - سفيان بن الحارث أبو جهور البصري الجرموزي يروي عن أبي غالب روى عنه ابنه جهور بن سفيان(@)(@@)(@@)(@@) $ 8308 - سفيان بن حبيب أبو معاوية من أهل البصرة يروي عن حميد الطويل روى عنه البصريون مات في أول سنة ثلاث وثمانين ومائة وقد قيل كنيته أبو حبيب(@)(@@)(@@)(@@) $ 8309 - سفيان بن نشيط من أهل البصرة يروي عن طاوس روى عنه موسى بن إسماعيل PageV06P405(@)(@@)(@@)(@@) $ 8310 - سفيان بن عامر شيخ من أهل ترمذ صدوق يروي عن طاوس روى عنه صالح بن عبد الله الترمذي(@)(@@)(@@)(@@) $ 8311 - سهل بن عقيل الأنصاري يروي عن عبد الله بن هبيرة روى عنه الليث بن سعد(@)(@@)(@@)(@@) $ 8312 - سهل شيخ يروي عن شداد بن الهادي روى عنه أبو يعفور ولست أعرفه ولا أدري من أبوه(@)(@@)(@@)(@@) $ 8313 - سهل بن محمد بن أبي حثمة يروي عن عمه سليمان بن أبي حثمة عن محمد بن مسلمة روى عنه أبو معاوية الضرير(@)(@@)(@@)(@@) $ 8314 - سهل بن صدقة القرشي مولى عمر بن عبد العزيز يروى المراسيل روى بن المبارك عن أبي الصباح عنه(@)(@@)(@@)(@@) $ 8315 - سهل بن أبي الصلت السراج العبسي من أهل البصرة يروي عن الحسن روى عنه أبو عاصم النبيل PageV06P406(@)(@@)(@@)(@@) $ 8316 - سهل بن أسلم من أهل البصرة يروي عن الحسن روى عنه أحمد بن المقدام أبو الأشعث العجلي(@)(@@)(@@)(@@) $ 8317 - سهل بن أبي سهل يروي عن أمه عن عائشة روى عنه سعيد بن أبي هلال(@)(@@)(@@)(@@) $ 8318 - سهل بن يوسف أبو عبد الله الأنماطي من أهل البصرة يروي عن حميد الطويل والبصريين روى عنه أحمد بن حنبل وأهل العراق مات سنة تسعين ومائة(@)(@@)(@@)(@@) $ 8319 - سالم بن أبي أمية أبو النضر مولى عمر بن عبيد الله بن معمر التيمي القرشي من أهل المدينة يروي عن أبي سلمة بن عبد الرحمن وبسر بن سعيد يروي عنه مالك بن أنس والثوري والناس وهو والد إبراهيم بن أبي 
ms1039	 النضر الذي يقال له بردان مات سالم في ولاية مروان بن محمد(@)(@@)(@@)(@@) $ 8320 - سالم بن عبد الله المحاربي يروي عن مجاهد روى عنه الأوزاعي(@)(@@)(@@)(@@) $ 8321 - سالم بن عبد الله أبو عبيد الله يروي عن سعيد بن جبير روى عنه شريك بن الخطاب PageV06P407(@)(@@)(@@)(@@) $ 8322 - سالم بن سالم أبو عبيد الله يروي عن عبد الرحمن بن أبي بكرة روى عنه حماد بن سلمة(@)(@@)(@@)(@@) $ 8323 - سالم بن عبد الله المحاربي ولاه عبد الله بن علي قضاء دمشق يروي عن جماعة من التابعين روى عنه أهلها(@)(@@)(@@)(@@) $ 8324 - سالم بن عبيد الله أبو المهاجر الرقى يروي عن عطاء روى عنه علي بن ثابت الجزري وهو مولى لبني كلاب مات سنة ثمان وخمسين ومائة(@)(@@)(@@)(@@) $ 8325 - سالم بن ثوبان الكوفي يروي عن شريح روى عنه أهل بلده(@)(@@)(@@)(@@) $ 8326 - سالم بن أبي سالم الجيشاني من أهل مصر يروي عن أبيه عن أبي ذر وعن معاوية بن معتب عن أبي هريرة روى عنه PageV06P408 عبيد الله بن أبي جعفر ويزيد بن حبيب عن أبي الخير اليزني عنه(@)(@@)(@@)(@@) $ 8327 - سالم بن هلال الناجي يروي عن أبي الصديق الناجي روى عنه يحيى بن سعيد القطان(@)(@@)(@@)(@@) $ 8328 - سالم بن رزين أبو عبد الله من أهل البصرة يروي عن أبي عثمان النهدي روى عنه موسى بن إسماعيل(@)(@@)(@@)(@@) $ 8329 - سالم بن منقذ يروي عن عمرو بن أوس روى عنه عبد الملك بن عمير(@)(@@)(@@)(@@) $ 8330 - سالم بن أبي مريم من أهل المدينة يروى عن عقيصا دينار روى عنه علي بن جبلة(@)(@@)(@@)(@@) $ 8331 - سالم بن غيلان من أهل مصر يروي عن الوليد بن قيس عن أبي سعيد الخدري روى عنه حيوة بن شريح(@)(@@)(@@)(@@) $ 8332 - سالم بن صالح بن إبراهيم بن عبد الرحمن بن عوف يروى PageV06P409 عن أبيه وأبوه سمع أنس بن مالك فيما يقال روى عنه إبراهيم بن سعد(@)(@@)(@@)(@@) $ 8333 - سالم أبو عبد الرحيم مولى معاوية الباهلي يروي عن عبد الله بن بريدة أنه إذا أذن المؤذن المغرب صلى ركعتين روى عنه أبو تميلة يحيى بن واضح 
ms1040	 والفضل بن موسى(@)(@@)(@@)(@@) $ 8334 - سالم بن راشد أبو جميع قال قال الحسن لا تقولوا للمسلم لئيم فإن اللئيم هو الكافر ثنا محمد بن أحمد بن المهلب بالأيلة قال ثنا بن أبي الشوارب قال ثنا أبو جميع(@)(@@)(@@)(@@) $ 8335 - سالم بن عبد الواحد أبو العلاء المرادي يروي عن الحسن والكوفيين روى عنه وكيع ومروان بن معاوية(@)(@@)(@@)(@@) $ 8336 - سالم الفراء شيخ يروي عن زيد بن أسلم روى عنه عمرو بن الحارث PageV06P410(@)(@@)(@@)(@@) $ 8337 - سالم بن دينار أبو جميع الهجيمي مولى الحارث بن سليم الهجيمي وقد قيل إنه سالم بن راشد يروي عن ثابت البناني روى عنه التبوذكي(@)(@@)(@@)(@@) $ 8338 - سالم أبو حماد شيخ يروي عن السدي روى عنه عبيد الله بن موسى(@)(@@)(@@)(@@) $ 8339 - سالم بن نوح بن أبي عطاء أبو سعيد العطار من أهل البصرة يروي عن قتادة روى عنه أهل البصرة مات بعد المائتين(@)(@@)(@@)(@@) $ 8340 - سالم المكي مولى عكاشة يروي عن عطاء وسالم وابن أبي مليكة روى عنه أبو عاصم النبيل(@)(@@)(@@)(@@) $ 8341 - سالم بن مخراق أبو الزرقاء العبدي يروي المقاطيع روى عنه أهل العراق PageV06P411(@)(@@)(@@)(@@) $ 8342 - سويد بن حجير أبو قزعة الباهلي من أهل البصرة يروي عن الحسن وأبي نضرة روى عنه شعبة وابن جريج وابنه قزعة بن سويد(@)(@@)(@@)(@@) $ 8343 - سويد بن نجيح أبو قطبة يروي عن الشعبي وعكرمة روى عنه عبد الواحد بن زياد ومحمد بن عبيد الطنافسي حدثنا إبراهيم بن خزيم بالشاش قال ثنا عبد بن حميد قال ثنا سويد بن نجيح عن يزيد الفقير قال قلت لأبي سعيد الخدري إن منا رجالا هم أقرأنا للقرآن وأكثرنا صلاة وأكثرنا صوما وأوصلنا للرحم خرجوا علينا بأسيافهم فقال أبو سعيد سمعت رسول الله صلى الله عليه وسلم يقول يخرج قوم يقرؤون القرآن لا يجاوز حناجرهم يمرقون من الدين كما يمرق السهم من الرمية PageV06P412(@)(@@)(@@)(@@) $ 8344 - سويد الحاجب المهري من أهل مصر يروي عن أبي الخير مرثد بن عبد الله اليزني روى عنه عمرو بن الحارث(@)(@@)(@@)(@@) $ 8345 - سويد أبو الخطاب الفريعي يروي عن إياس بن سلمة بن 