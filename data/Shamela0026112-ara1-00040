ms21	 الصحابة(@)(@@)(@@)(@@) | 657 - (@)(@@) والحافظ ابو الخطاب عمر بن حسن بن علي الكلبي الداني ثم السبتي ابن دحية(@)(@@) PageV01P221(@)(@@)(@@)(@@) | 658 - (@)(@@) والحافظ ابو بكر محمد بن اسماعيل بن خلوف الازدي الاونبي نزبل اشبيلية من ابناء الثمانين واولي الاسناد والمعرفة(@)(@@)(@@)(@@) | 659 - (@)(@@) والحافظ ضياء الدين ابو عبد الله محمد بن عبد الواحد بن احمد المقدسي الحنبلي(@)(@@)(@@)(@@) | 660 - (@)(@@) والحاظ محب الدين ابو عبد الله محمد بن محمود بن النجار صاحب التاريخ(@)(@@)(@@)(@@) | 661 - (@)(@@) والحافظ ابو عبد الله محمد بن سعيد بن يحيى بن الدبيثي المؤرخ المقرئ(@)(@@)(@@)(@@) | الطبقة العشرون(@)(@@)(@@)(@@) | 662 - (@)(@@) الحافظ زكي الدين عبد العظيم بن عبد القوي المنذري المصري(@)(@@)(@@)(@@) | 663 - (@)(@@) والحافظ زكي الدين محمد بن يوسف البرزالي الاشبيلي(@)(@@)(@@)(@@) | 664 - (@)(@@) والحافظ سيف الدين احمد بن المجد عيسى بن عبد الله المقدسي الحنبلي(@)(@@)(@@)(@@) | 665 - (@)(@@) والحافظ عز الدين ابو الفتح عمر بن محمد بن منصور بن الحاجب الاميني(@)(@@)(@@)(@@) | 666 - (@)(@@) والحافظ ابو موسى عيسى بن سليمان الرعيني الاندلسي(@)(@@)(@@)(@@) | 667 - (@)(@@) والحافظ شرف الدين احمد بن محمود بن الجوهري الدمشقي(@)(@@)(@@)(@@) | 668 - (@)(@@) والحافظ تقي الدين ابراهيم بن محمد الازهر الصريفيني مات بدمشق وله ستون سنة(@)(@@)(@@)(@@) | 660 - (@)(@@) والحافظ ابو القاسم قاسم بن محمد بن الطياسان الانصاري القرطبي وله تصانيف ومعرفة(@)(@@) PageV01P222(@)(@@)(@@)(@@) | 671 - (@)(@@) والحافظ اسعد الدين ابو القاسم عبد الرحمن بن مقرب الكندي الاسكندراني(@)(@@)(@@)(@@) | 672 - (@)(@@) والحافظ المفتي تقي الدين ابو عمرو عثمان بن عبد الزحمن الشهرزوري اشافعي ابن الصلاح(@)(@@)(@@)(@@) | 673 - (@)(@@) والامام شرف الدين محمد بن عبد الله بن محمد بن ابي الفضل السملي المرسي(@)(@@)(@@)(@@) | 674 - (@)(@@) والحافظ صدر الين حسن بن محمد بن محمد البكري الصوفي على ضعف فيه(@)(@@)(@@)(@@) | 675 - (@)(@@) والمفيد محب الدين عبد الله بن احمد بن ابي بكر السعدي المقدسي ولم يكتهل(@)(@@)(@@)(@@) | 676 - (@)(@@) والحافظ ابو عبد الله محمد بن عبد الله بن ابي بكر القضاعي البلنسي ابن الابار(@)(@@)(@@)(@@) | 677 - (@)(@@) والحافظ ابو بكر محمد بن احمد بن عبد الله بن سيدالناس اليعمري الاشبيلي خطيب تونس عالم المغرب(@)(@@)(@@)(@@) | 678 - (@)(@@) والصاحب الحافظ كمال الدين ابو القاسم عمر بن احمد بن هبة الله العقيلي الحلبي صاحب تاريخ حلب(@)(@@)(@@)(@@) | 679 - (@)(@@) والحافظ عز 
ms22	 الدين ابو محمد عبد الرازق ابن رزق الله بن ابي بكر الرسعن المسر(@)(@@)(@@)(@@) | 680 - (@)(@@) والحافظ زين الدين ابو البقاء خالد بن يوسف بن سعد النابلسي(@)(@@)(@@)(@@) | 681 - (@)(@@) ونسيبه الحافظ شرف الدين يوسف بن الحسن بن بدر بن النابلسي(@)(@@) PageV01P223(@)(@@)(@@)(@@) | 682 - (@)(@@) والحافظ ابو بكر محمد بن يوسف بن موسى بن مسدي الازدي الغرناطي المجاور(@)(@@)(@@)(@@) | 683 - (@)(@@) والعلامة شهاب الدين ابو القاسم عبد الرحمن بن اسماعيل بن ابراهيم المقدسي الشافعي صاحب التصانيف(@)(@@)(@@)(@@) | 684 - (@)(@@) والتحاظ جمال الدين ابو حامد محمد بن علي بن محمودالصابوني(@)(@@)(@@)(@@) | 685 - (@)(@@) والمفيد شمس الدين محمد بن عبد المنعم بن عمار بن هامل الحراني(@)(@@)(@@)(@@) | 686 - (@)(@@) والمحدث المفيد وجيه الدين ابو المظفر منصور بن سليم الهمداني مؤرخ الاسكندرية وله الاربعون البلدية وغير ذلك(@)(@@)(@@)(@@) | الطبقة الحادية والعشرون(@)(@@)(@@)(@@) | 687 - (@)(@@) الامام شيخ الاسلام محيي الدين ابو زكريا يحيى بن شرف بن مري النواوي الشافعي الحافظ(@)(@@)(@@)(@@) | 688 - (@)(@@) والحافظ العلامة شرف الدين ابو محمد عبد المؤمن بن خلف الدمياطي(@)(@@) PageV01P224(@)(@@)(@@)(@@) | 689 - (@)(@@) والحافظ جمال الدين ابو العباس احمد بن محمد بن عبد الله الحلبي ابن الظاهري(@)(@@)(@@)(@@) | 690 - (@)(@@) والمتقن شرف الدين محمد بن ابي القاسم بن عنان الميدومي المصري(@)(@@)(@@)(@@) | 691 - (@)(@@) والميد مكين الدين ابو الحسن بن عبد العظيم الحصني(@)(@@)(@@)(@@) | 692 - (@)(@@) والحافظ المفيد رشيد الدين ابو بكر محمد بن الحافظ عبد العظيم المنذري ومات شابا(@)(@@)(@@)(@@) | 693 - (@)(@@) والحافظ زين الدين ابو الفنح محمد بن ابي بكر الابيوردي الصوفي(@)(@@)(@@)(@@) | 694 - (@)(@@) والمحدث امين الدين ابو اليمن عبد الصمد بن الوهاب بن زين الامناء ابن عساكر(@)(@@)(@@)(@@) | 695 - (@)(@@) والامام قطب الدين ابو بكر محمد بن احمد بن علي بن القسطلاني(@)(@@)(@@)(@@) | 696 - (@)(@@) والحافظ تقي الدين عبد بن محمد بن عباس الاسعردي(@)(@@)(@@)(@@) | 697 - (@)(@@) والمحدث تقي الدين ادريس ين مزيز الحموي(@)(@@)(@@)(@@) | 698 - (@)(@@) والمحدث تقي الدين ادريس بن محمد بن مزيز الحموي(@)(@@)(@@)(@@) | 698 - (@)(@@) والمحدث محب الدين احمد بن عبد الله محمد الطبري المكي مصنف الاحكام(@)(@@)(@@)(@@) | 699 - (@)(@@) والحاظ ز الدين ابو القاسم احمد بن عبد الرحمن الحسيني المصري النقيب(@)(@@) PageV01P225(@)(@@)(@@)(@@) | 700 - (@)(@@) والحافظ نجم الدين علي بن عب الكاي الربعي بن عبد الكافي الربعي الدمشقي 
ms23	 ومات شابا(@)(@@)(@@)(@@) | 701 - (@)(@@) والحافظ شنس الدين محمد بن محمد بن جعوان الانصاري الدمشقي النحوي وتوي قبل الكهولة(@)(@@)(@@)(@@) | 702 - (@)(@@) والحاظ شهاب الدين احمد بن فرح بن احمد اللخمي الاشبيلي(@)(@@)(@@)(@@) | 703 - (@)(@@) والحافظ المقرئ ابو جعفر احمد بن ابراهيم بن الزبير الثقفي الغرناطي(@)(@@)(@@)(@@) | 704 - (@)(@@) والحافظ العلامة قاضي القضاة تقي الدين ابو الفتح محمد بن علي بن وهب بن مطيع القشيري ابن دقيق العيد(@)(@@)(@@)(@@) | الطبقة الثانية والعشرون(@)(@@)(@@)(@@) | 705 - (@)(@@) الحافظ الحجة جمال الدين ابو الحجاج يوسف بن عبد الرحمن القضاعي الكلبي المزي(@)(@@)(@@)(@@) | 706 - (@)(@@) والحافظ العلم شيخ الاسلام تقي الدين ابو العباس احمد بن عبد الحليم بن عبد السلام الحراني ابن تيمية(@)(@@) PageV01P226(@)(@@)(@@)(@@) | 707 - (@)(@@) والحافظ قاضي القضاة سعد الدين مسعود بن احمد بن مسعود الحارثي الحنبلي(@)(@@)(@@)(@@) | 708 - (@)(@@) والمحدث العلامة اثير الدين ابو حيان محمد بن يوسف بن علي بن حيان الاندلسي شيخ العربية بالقاهرة(@)(@@)(@@)(@@) | 709 - (@)(@@) والمحدث اللغوي صفي الدين بن محمد ابي بكر الارموي القرافي(@)(@@)(@@)(@@) | 710 - (@)(@@) والحافظ المفيد شمس الدين محمد بن عبد الرحمن بن سامة(@)(@@)(@@)(@@) | 711 - (@)(@@) وشيخنا المفيد ابو الحسن علي بن مسعود بن نفيس الموصلي(@)(@@)(@@)(@@) | 712 - (@)(@@) والحافظ عليم الدين ابو محمد القاسم بن محمد بن يوسف البرزالي(@)(@@)(@@)(@@) | 713 - (@)(@@) والمفيد شمس الدين ابو العلاء محمود بن ابي بكر البخاري وكان حافظا(@)(@@)(@@)(@@) | 714 - (@)(@@) والحافظ قطب الدين عبد الكريم بن عبد النور بن منير الحلبي(@)(@@)(@@)(@@) | 715 - (@)(@@) والحافظ فتح الدين ابو الفتح محمد بن محمد بن محمد بن سيد الناس اليعمري الاندلسي ثم المصري(@)(@@) آخر الكتاب والحمد لله. PageV01P227 
