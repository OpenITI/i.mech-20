ms1412	 الحسيني العبيدلي، مات .... ،(@)(@)PageV05P363(@)(@)(@@)(@@)(@@) ||| CHECK 8417 - وبرهان الدين محمد بن محمد بن محمد(@)(@)(@@)(@@)(@@) ||| CHECK 8416 - ونجم الدين محمد بن عمر بن ....(@)(@)(@@)(@@)(@@) ||| CHECK 8415 - إبراهيم بن محمد اللغوي(@)(@)(@@)(@@)(@@) ||| CHECK 8414 - والشريف أبو البركات الجؤاني، كلهم نسأبون(@)(@)(@@)(@@)(@@) ||| CHECK 8413 - وأبو بكر محمد بن عبده العبقسي الطرسوسي(@)(@)(@@) 8413 - • وأبو بكر محمد بن عبده العبقسي الطرسوسي،(@)(@@) 8414 - • والشريف أبو البركات الجؤاني، كلهم نسأبون.(@)(@@) النساج: [نسبة] إلى نسج الثياب (¬1).(@)(@@) النسائي: بالهمز والنسوي بالواو [نسبة] إلى نسا مقصورا، وفي "جامع الأصول" (¬2) ممدودا وذلك غير معروف، مدينة بخراسان بين أبيورد وسرخس (¬3)، إليه:(@)(@@) • الإمام أحمد بن شعيب الحافظ (¬4)، مات [سنة] 303، قيل ومدينة بفارس ومدينة بكرمان وكورة بناحية خجند، يقالمالها نساء العليا وفيها نساء السفلى وإلى هذه الثلاث ينسب بالواو إلى:(@)(@)(@@) 8415 - • إبراهيم بن محمد اللغوي (¬5)، مات [سنة 519]،(@)(@@) • والإمام حسن بن سفيان (¬6)، مات [سنة] 303.(@)(@@) النسطاسي: [نسبة] إلى نسطاس جد (¬7).(@)(@@) النسفي: [نسبة] إلى نسف مدينة بما وراء النهر (¬8) ويقال لها: نخشب، منها:(@)(@@) • الإمام حافظ الدين عبد الله بن أحمد بن [محمود] (¬9)، مات [سنة 701]،(@)(@)(@@) 8416 - • ونجم الدين محمد بن عمر بن .... مات .... ،(@)(@@) • وأبو جعفر محمد بن أحمد (¬10) صاحب "الخلافيات"،(@)(@@) • وأبو المعين ميمون بن محمد بن أحمد (¬11)، مات [سنة 508]،(@)(@)(@@) 8417 - • وبرهان الدين محمد بن محمد بن محمد (¬12)، مات [سنة] 687.(@)(@@) النسوخي: [نسبة] إلى النسوخ، قرية على يسار القادسية (¬13).(@)(@)PageV05P364(@)(@)(@@)(@@)(@@) ||| CHECK 8422 - أما الثاني فهو جلال زاده مصطفى جلبي(@)(@)(@@)(@@)(@@) ||| CHECK 8421 - أحدهما من ديار قرامان ومن أحفاد مولانا جلال الدين الرومي(@)(@)(@@)(@@)(@@) ||| CHECK 8419 - محمد بن أحمد بن مكي النشابي الحنفي(@)(@)(@@) نسيم الدين: لقب محمد بن سعيد الكازروني (¬1)، مات [سنة 801].(@)(@)(@@)(@@)(@@) ||| AUTO 8418 - نسيمي(@)(@)(@@) : [هو الشيخ عماد الدين سيد عمر نسيمي من مشاهير الشعراء العثمانيين وأهل التصوف، قيل إنه من نسيم في بغداد، ووفد