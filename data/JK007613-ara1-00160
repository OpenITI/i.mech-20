ms141	 من صمم % % ولا أكلف زيدا غير إسعاد % % PageV01P533 11(@)(@@) % يا جارة يوم راح الحي جارتنا % % تسبي الحليم ولا تنساق للحادي % % 12(@)(@@) % قامت لتركب فارتجت روادفها % % في لين غصن من الريحان منآد % % 13(@)(@@) % كأنما خلقت في قشر لؤلؤة % فكل أكنافها وجه بمرصاد % 14(@)(@@) % فقلت : شمس الضحى في مرط جارية % يا من رأى الشمس في مرط وأبراد % % 15(@)(@@) % تلقى بتسبيحة من حسن ما خلقت % وتستفز حشى الرائي بإرعاد % 16(@)(@@) % كأن عيني تراها في مجاسدها % % إذا رأيت رسوم الدار والنادي % % 17(@)(@@) % بيضاء كالدرة الزهراء غرتها % % تصطاد عينا ولا ترجى لمصطاد % % 18(@)(@@) % كأنها لاترى جسما تخونه % بين الحبيب ولم تشعر بإسهاد % % 19(@)(@@) % أصوم يوما فأرقا من تذكرها % % ولا أصلي الضحى إلا بعداد % 20(@)(@@) % وقد عجبت وإغرامي بها عجب % مالي أقود حرونا غير منقاد % % PageV01P534 21(@)(@@) % أحين كنت سراجا يستضاء به % يكون في الغي إفراعي وإصعادي % % 22(@)(@@) % كلا سأترك ذكري تلك إذ رقدت % % عني وأذكر يوما غير رقاد % PageV01P535 البحر : كامل تام 1(@)(@@) % يا عبد باهلة الذي يتوعد % أعلي تبرق إذ شبعت وترعد ؟ % 2(@)(@@) % يا عبد باهلة ابتليت بحية % فتركت طاعتنا ورحت تهدد % % 3(@)(@@) % وشتمت ربك في العشيرة قائما % لتكون موجودا وليتك توجد % % 4(@)(@@) % وة كذاك عبد السوء يشتم ربه % % سفها ، ولكن هل تجاب الأعبد ؟ % 5(@)(@@) % اقعد فإنك باهلي واغل % يجزيك سوءتك الضياع الرود % 6(@)(@@) % وإذا سكرت فخذ بأير مساعف % واسكت فإنك ناطق لاترشد % 7(@)(@@) % تجري من الذهب المصنم راحتي % % كرما وناري باليفاع توقد % 8(@)(@@) % ولئن عمرت لتعرفن قصيدة % تجب الصلاة لها عليك فتسجد % % 9(@)(@@) % وتظل ترعد من هديل حمامة % وإذا دعيت لسوأة لاترعد % 10(@)(@@) % وملأت ثوبك إن رأيت كتيبة % في النوم أللها الحديد الموجد % PageV01P536 11(@)(@@) % ومجنت حتى ما تصلي ركعة % ونسيت ما قال النبي محمد % % 12(@)(@@) % وحسبتني كأبيك لاينكي العدى % % فاصبر لحسبتك التي لاتحمد % 13(@)(@@) % مولاك أرقب من ربيعة عامر % % أهدى لكفك قائما لا يرقد % 14(@)(@@) % فتركت عقر قناتكم عند امرئ % جمح الشباب به الأنيق الأغيد % % 15(@)(@@) % وكذاك كان أبوك يؤثر بالهنى % % ويظل في لقط النوى يتردد 
ms142	 % 16(@)(@@) % فلئن قعدت على الخنا وحسدتني % % إن الكريم إذا جرى لمحسد % 17(@)(@@) % يا عبد باهلة الذي لزم الخنا % % وأضاع عقر قناته لاتسعد % 18(@)(@@) % لولا دلفت لمن دهاك بأيره % فحسرت عنك حزازة لا تبرد % % 19(@)(@@) % لو كنت من أسد العشيرة لم تنم % % حتى يخالطه الحسام الأربد % % 20(@)(@@) % عودت نفسك أن تضام فخلها % % كل امرئ رهن بما يتعود % % PageV01P537 21(@)(@@) % وأبى لك الحسب اللئيم فناله % وكساك ذلته أبوك القعدد % 22(@)(@@) % لا تستطيع مرفلا من عامر % عجل العقاب وأنت عبد أقفد % % 23(@)(@@) % وخشيت سطوة عامري فاتك % تقف الوفود ببابه والوفد % 24(@)(@@) % وبنيت بالبعر المحل وبالنوى % % بيتا عليه خزاية لا تنفد % % 25(@)(@@) % وطلبت بالخلق المرقع شأونا % % فلترجعن وبظر أمك يرعد % % 26(@)(@@) % مهلا موالينا أقيموا خرجنا % % وإذا غضبنا غضبة فتبددوا % % 27(@)(@@) % خدم الملوك إذا قعدنا في الحبى % % قاموا وإن نفزع لروع يقعدوا % % 28(@)(@@) % كونوا لمولاكم يدا وصلت يدا % ودعوا الفساد يعيث فيه المفسد % % 29(@)(@@) % وتشبهوا بأب وعم صالح % متعبدين لنا ونعم العبد % PageV01P538 البحر : كامل تام 1(@)(@@) % أنى شبابك قد مضى محمودا % % ودع الغواني إن أردن صدودا % % 2(@)(@@) % وصرمنا حبلك بعد أول نظرة % وبما يكن إلى حديثك صيدا % % 3(@)(@@) % أيام ينبعث القريض بمجلس % شاف لدائك أو تبيت عميدا % % 4(@)(@@) % تصطاد من بقر الأنيس وتصطفي % % كأس المدامة عندهن ركودا % % 5(@)(@@) % ولقد شربت رضابهن على الصدا % % وعلى الصبابة ودهن برودا % % 6(@)(@@) % من كل مقبلة الشباب كأنها % % صنم لأعجم لا يني معبودا % % 7(@)(@@) % تدني القناع على محاسن مشرق % كالبدر يحفل عصفرا وعقودا % % 8(@)(@@) % وكأنما نظرت بعيني شادن % حيران أبصر شادنا مطرودا % % 9(@)(@@) % ويشك فيها الناظرون إذا مشت % % أتسيل أم تمشي لهم تأويدا % % 10(@)(@@) % أرخت على قصب الروادف فانثنت % % كالخيزرانة لدنة أملودا % % PageV01P539 11(@)(@@) % وكأنها شربت سلافة بابل % بالساهرية خالطت قنديدا % % 12(@)(@@) % فتن مبتلة تميل إلى الصبى % % ولمن تصيدها تكون صيودا % % 13(@)(@@) % وصفت مجاسدها روادف فعمة % ومهفهفا قلق الوشاح خضيدا % % 14(@)(@@) % وعلى الترائب زينهن كأنه % % وسنان جاذب مضجعا ليؤودا % % 15(@)(@@) % وإذا بدا لك وجهها أكبرته % عجبا ويا لك في القلائد جيدا ! % 16 
ms143	(@)(@@) % وكفى بمضطرب العقود فإنه % % نحر يزين زبرجدا وفريدا % % 17(@)(@@) % ولئن صددن لقد قضيت لبانة % وغنيت دهرا ناعما غريدا % % 18(@)(@@) % ودمى أوانس من بنات محرق % حور نواعم أوجها وجلودا % % 19(@)(@@) % أرسلن في لطف إلي أن ائتنا % % غاب الرقيب وما تخاف وعيدا % % 20(@)(@@) % فأتيتهن مع الجري يقودني % % طربا ويا لك قائدا ومقودا ! % PageV01P540 21(@)(@@) % لما التقينا قلن : هات فقد مضت % سنة نؤمل أن نراك قعيدا % % 22(@)(@@) % حدث فقد رقد الوشاة وليتهم % حتى القيامة يلبثون رقودا % % 23(@)(@@) % قلت : اقترحن من الهوى فسألنني % % طرف الحديث فكاهة ونشيدا % % 24(@)(@@) % حتى إذا بعث الأذين فراقنا % % ورأيت من وجه الصباح خدودا % % 25(@)(@@) % جرت الدموع وقلن : فيك جلادة % عنا ونكره أن نراك جليدا % % 26(@)(@@) % فالآن حين صحوت إني إن أرى % % كلفا فيرجع ودهن جديدا % % 27(@)(@@) % لا تعص ذا رشد ويمن مشهورة % ومن السعادة أن تكون رشيدا % % 28(@)(@@) % متع صديقك غير مخلق وجهه % % وإذا سئلت فلا تكن جلمودا % % 29(@)(@@) % وفتى يذب عن المتاع ويبتغي % % ما في يديك إذا رآك مفيدا % % 30(@)(@@) % شيعته ليهين بعض متاعه % % يوما ويكرم نفسه فيسودا % % PageV01P541 31(@)(@@) % فدنا فأشرق ثم أظلم وجهه % % عرف الولاء فزاده تربيدا % % 32(@)(@@) % أبلغ سراة بني الحصين بأنني % % قلدتهم مدحي وكنت ودودا % % 33(@)(@@) % حملت قرمهم الفنيق قصائدي % % حذا يلذ بها الرواة نشيدا % % 34(@)(@@) % وإذا ذكرت بني قتيبة أصبحت % نفسي تنازعني القريض جديدا % % 35(@)(@@) % الذائدين عن الحريم بجدهم % والمنعمين أبوة وجدودا % % 36(@)(@@) % قوم لهم كرم الإخاء وعزة % لا يمكنون بها الظلامة صيدا % % 37(@)(@@) % تأبى قلوبهم المذلة والخنا % % وأبت أكفهم البحور جمودا % % 38(@)(@@) % فطن لمعروف وإن لم يفطنوا % % للغي يعرفه الخليل معيدا % % 39(@)(@@) % وترى عليهم نضرة ومهابة % شرفا وإن ملكوا أمنت وعيدا % % 40(@)(@@) % متوازرون على المحامد والندى % % لا يحسبون غنى يديم خلودا % % PageV01P542 41(@)(@@) % وكأنهم في نحر كل مخوفة % أسد جعلن لها الملاحم عيدا % % 42(@)(@@) % يغدون في حلق النعيم وتارة % في المسك يصبح للجلود جلودا % % 43(@)(@@) % ومرفلين على العشيرة أصبحوا % % سبقا مرازبة العراق قعودا % % 44(@)(@@) % وبنى لهم ملكا أطال عماده % سلف يرى بمجرة أخدودا % % 45(@)(@@) % تنشق 
ms144	 روعات الوغى عن رأسه % صلتان يفتك بالأمور وحيدا % % 46(@)(@@) % كم من عفارية أبل متوج % % قتل الإله به وكان مريدا % % 47(@)(@@) % قاد الجنود من البصيرة للعدى % % حتى وقعن بصين ثغر قودا % % 48(@)(@@) % خيلا مخففة وخيلا حسرا % لايعتلجن مع الشكائم عودا % % 49(@)(@@) % أنزلن غوزك من صياصي عزه % % ظهرا وكان غزيه مجدودا % % 50(@)(@@) % وأفأن نسوة نيزك وتركنه % % جزرا ورهط بني الأشل حصيدا % % PageV01P543 51(@)(@@) % وحملن ربهم الأجل هدية % في الشاكرية عانيا مصفودا % % 52(@)(@@) % ومنعن خاقان المسارح فانثنى % % عجلا يشل سوامه مزؤودا % % 53(@)(@@) % وأقمن قتلى للمقانب والقنا % % بعد الحصانة منهلا مورودا % % 54(@)(@@) % تلك المكارم لا مقام معذر % برق الحبي له فحاد محيدا % % 55(@)(@@) % وأبو قتيبة في الكريهة مثله % أسد يرشح للقاء أسودا % % 56(@)(@@) % ملك على مضض العدو محله % يعطي الجزيل ويقتل الصنديدا % % 57(@)(@@) % تهدى له فلق الرؤوس إذا غدا % % وإذا تروح حاديا ليجودا % % 58(@)(@@) % ولقد أقول لقافلين رأيتهم % بقفا المسالح يقسمون قصيدا % % 59(@)(@@) % كيف الأمير لزائر متخير % ترك الأقارب والبعيد بعيدا % % 60(@)(@@) % ودا ومختبطا ودائم عشرة % يسعى لجارية تريد نقودا % % PageV01P544 61(@)(@@) % تأبى صواحبها ويأبى أهلها % % إلا العلاء فكلفوه كؤودا % % PageV01P545 البحر : بسيط تام 1(@)(@@) % لم يدر ما قلت ' مسعود ' فضيعه % % يا سوأتا من طلابى جود ' مسعود ' % 2(@)(@@) % وقائل كيف ' مسعود ' فقلت له % هو الجواد ، ولكن فاسق الجود % 3(@)(@@) % غيث الزواني إذا أمسى بعقوته % وآفة المال بين الزق والعود % % PageV01P546 البحر : بسيط تام 1(@)(@@) % ليس النعيم وإن كنا نزن به % % إلا نعيم ( سهيل ) ثم ( حماد ) % 2(@)(@@) % ناكا ونيكا إلى أن حل شيبهما % % في غفلة عن نبي الرحمة الهادي % % 3(@)(@@) % فهدين طورا وفهادين آونة % ما كان قبلهما فهد بفهاد % % 4(@)(@@) % ما العيش إلا ( لحماد أبي عمر % لم يدر أن له ربا بمرصاد % PageV01P547 البحر : متقارب تام 1(@)(@@) % ألا قل ل ' عبدة ' إن جئتها % % وقد يبلغ الأقرب الباعدا % % 2(@)(@@) % أجدك لا أنت تشفينني % % ولا الصيد متبع صائدا % % 3(@)(@@) % وطارف حب أصاب الفؤاد % % وجدت تباريحه زائدا % % 4(@)(@@) % إذا نقص النأي حب امرئ % % وجدت تباريحه زائدا % % 5(@)(@@) % يجور إذا هي جارت به % % ويصبح 
ms145	 إن قصدت قاصدا % % 6(@)(@@) % قطعت الليالي في هجره % % 7(@)(@@) % وشرب بهاليل في ليلة % % من الشهر حلوا بها صاعدا % % 8(@)(@@) % تخال جنا الورد والرازقي % بينهم روضة فاردا % % 9(@)(@@) % لهم زجل بعد نوم العيو % % وصفراء تستألف الفاقدا % % 10(@)(@@) % إذا ماثنت جيدها نظرة % حسبت الغزال بها عاقدا % % PageV01P548 11(@)(@@) % فذاك بما يصطفي ودها % % خلا أن يكون لها رائدا % % PageV01P549 البحر : منسرح 1(@)(@@) % غيب جيرانه بذي حمد % عن ليل من لم ينم ولم يكد % 2(@)(@@) % خلوا علي الهيام إذ ركبوا % % أكبر بما أفردوا لمنفرد % 3(@)(@@) % يبكي على وسنة تزودها % % جيرانه بل بكى من السهد % % 4(@)(@@) % كونا كمن قال لا نعاتبه % كل امرئ منته إلى أمد % % 5(@)(@@) % خليفة الحزن في مدامعه % يمسي بها نائيا عن الوسد % % 6(@)(@@) % يا ليت شعري والقصد من خلقي % % والناس من جائر ومقتصد % % 7(@)(@@) % ما زادني ذا الجوى بذكرهم % إلا هجوعا والهم كالوتد % 8(@)(@@) % ما زال ضيفا له يواكله % يمد غما برعية الأسد % 9(@)(@@) % إن الذي غادرت حمولهم % % صب وإن كان مظهر الجلد % % 10(@)(@@) % لا يشتهي الليل من تقلبه % ظهرا لبطن تقلب الصرد % PageV01P550 11(@)(@@) % كأنما يتقى بليلته % % جهم المحيا يبيت بالرصد % 12(@)(@@) % لم يدر حتى رموا مطيهم % ثم استمروا بجنة الخلد % % 13(@)(@@) % يقول لي صاحبي وقد بقيت % % نفسي على سغبة من العقد % % 14(@)(@@) % يا أيها المكتوي على ظعن % باتوا وما سلموا على أحد % 15(@)(@@) % هاتيك دار التي تهم بها % % كالبرد بين الكثيب فالسند % % 16(@)(@@) % كانت محل الخليط فانقلبت % وحشا من المنشدين والخرد % 17(@)(@@) % فانظر إذا اشتقت في منازلها % % أو زر حبيبا دعاك من بعد % % 18(@)(@@) % والله يلقى كمن كلفت به % من آل بكر أظن بالنكد % % 19(@)(@@) % أبقى لك البين في ملاعبه % % فانصاع للبين آخر الأبد % % 20(@)(@@) % يعتاد عينيك من تذكرها % % رمصان مثل العوائد الخرد % % PageV01P551 21(@)(@@) % ماذا بإرسالها تعاتبني % % في زائر زارني ولم يعد % 22(@)(@@) % قالت لحوراء من مناصفها % % كالريم لم تكتحل من الرمد % % 23(@)(@@) % روحي إلى مشرك بخلتنا % % خلة أخرى وقد يرى كمدي % % 24(@)(@@) % قولي : تقول التي أسأت لها % % إن لم أنله ماشيمتي 
ms146	 برد % 25(@)(@@) % قصرت طرفي إليك قانعة % وأنت ذو طرتين في ورد % 26(@)(@@) % فاذهب سيكفيك ما برمت به % % منا وتخلى حباك للورد % % 27(@)(@@) % فقلت : لا تسرعي بمعتبة % % في غير ذنب جنيته بيدي % % 28(@)(@@) % لا كنت إن لم أكن أحبكم % جهدي فما بعد حب مجتهد % % 29(@)(@@) % أي حديث دب الوشاة به % أبصرت غيي فأبصري رشدي % % 30(@)(@@) % ما كان إلا حديث جارية % % لم تلق روحي ووافقت جسدي % % PageV01P552 31(@)(@@) % يا ويحها طفلة خلوت بها % % ليس دنوي فيها من العدد % % 32(@)(@@) % فأعهدينا من الظنون على % % تبليغ واش وقول ذي حسد % 33(@)(@@) % قد تبت مما كرهت فاحتسبي % % غفران ما قد جنيت معتمدي % % 34(@)(@@) % كانت على ذاك من مودتنا % % إذ نحن من غائب ومصطرد % 35(@)(@@) % نطوي لذاك الزمان نصرفه % طيبا ونشفي به صدى الكمد % % 36(@)(@@) % حتى انطوى العيش عن مريرته % % في صوت جار حدا بنا غرد % % 37(@)(@@) % فاعذر محبا بفقد جيرته % متى يبن من هويت يفتقد % % PageV01P553 البحر : طويل 1(@)(@@) % ألا لا أرى شيئا ألذ من الوعد % ومن أمل فيه وإن كان لا يجدي % % 2(@)(@@) % ومن غفلة الواشي إذا ما أتيتها % % ومن نظري أبياتها جالسا وحدي % % 3(@)(@@) % ومن بكية في الملتقى ثم ضحكة % وكلتاهما أحلى من الماء بالشهد % 4(@)(@@) % كأني إذا ما أطمعت في لقائها % % على دعوة الداعي إلى جنة الخلد % 5(@)(@@) % أعد بها الساعات حتى كأنها % % أرى وجهها لا بل تمثله عندي % % 6(@)(@@) % وإن أخلفت خف الحشا لفعالها % % نزاع . . . . واقشعر لها جلدي % % 7(@)(@@) % وبت كأني بالنجوم معلق % أسائل وسطاها عن الكوكب الفرد % 8(@)(@@) % وبيضاء من بيض تروق عيونها % % وألوانها راحت تضل ولا تهدي % % 9(@)(@@) % رماني الهوى من عينها فأصابني % % فأصبحت من شوق إليها على جهد % % 10(@)(@@) % أصارع نفسا في الهوى قد تجردت % % لتصرعني حتى ارعويت إلى الجمد % % PageV01P554 11(@)(@@) % ومن نكد الأيام علقني الهوى % % بذات الثناء الغمر والنائل الحفد % % 12(@)(@@) % أراني لما تهوى قريبا ولا أرى % % مقاربة فيها بهزل ولا جد % % 13(@)(@@) % فلله در المالكية إذ صبت % إلى اللهو أو كانت تدل على رشد % % 14(@)(@@) % مصورة فيها على 
ms147	 العين فلته % وكالشمس تمشي في الوشاح وفي العقد % % 15(@)(@@) % سأدعو بأخلاقي الكرائم قربها % % وبالود إن كانت تدوم على الود % % 16(@)(@@) % لقد لامني المولى عليها وإنما % % يلوم على حوراء تبدع بالخد % % 17(@)(@@) % فقلت له : بعض الملامة إنني % % أرى القصد لكن لا سبيل إلى القصد % % 18(@)(@@) % كأن فؤادي طائر حان ورده % يهز جناحيه انطلاقا إلى ورد % % 19(@)(@@) % ومن حبها أبكي إليها صبابة % وألقى بها الأحزان وفدا على وفد % 20(@)(@@) % يروح بعيني غصة من دموعها % % وتصبح أحشائي تطير من الوجد % PageV01P555 21(@)(@@) % ونبئتها قالت جهارا لأختها % % ألا إن نفسي عند من روحه عندي % % 22(@)(@@) % فوالله ما أدري أغيري تطلعت % % بما أرسلت من ذاك أم حردت حردي % % 23(@)(@@) % ومجلس خمس قد تركت لحبها % % وهن كزهر الروض أن لؤلؤ السرد % % 24(@)(@@) % يساقطهن للزير الموكل بالصبا % % حديثا كوشي البرد يغرين في الورد % % 25(@)(@@) % كأن رجائي بعدما انتظرت به % % على عاقل بالشعف أو جبل صلد % % 26(@)(@@) % إذا قربت شطت وتدنو إذا دنت % % تعول بريعان الشباب على الصمد % % 27(@)(@@) % فيا عجبا من سعدى قريبة % ومن قربها في البعد ويلي على البعد % % 28(@)(@@) % فيا سقما فقد الحبيب إذا نأى % % ورؤيته في النوم أودى من الفقد % % PageV01P556 البحر : رمل تام 1(@)(@@) % يا ابنة الخير عدينا موعدا % % وإذا زغت فمنينا غدا % % 2(@)(@@) % واذكري قول أديب ناصح % يوم أوصاني وأوصى ولدا % % 3(@)(@@) % كمش الوأي إذا وجهته % والق زوارك روضا وندا % % 4(@)(@@) % معك الناس إذا أطعتهم % % ومع النجم إذا اليأس بدا % % 5(@)(@@) % لعنة الله على جارية % % صرفت قلبك عني حسدا % % 6(@)(@@) % راقبت ودي فلما استمكنت % وضعت نيرا على غير سدا % % 7(@)(@@) % فإذا نحن التقينا فتنة % لم تكن عونا وكانت وتدا % % 8(@)(@@) % وتألت ما أتت لي مسخطا % كذبت والمنزل القطر جدا % % 9(@)(@@) % ما اتقت سخطي ولا روعها % % مرهف الناب بزأر مأسدا % % 10(@)(@@) % يا ابنة الخير احذريها إنها % % عقرب تسري على من رقدا % % PageV01P557 11(@)(@@) % إن اعراضك من تبليغنا % % أسخط القلب وأوهى الكبدا % % 12(@)(@@) % وعلى سلواك إن منيتني % % فتعيلت قريبا مبعدا % % 13(@)(@@) % رحت في النوك كمن قيل له 
ms148	 % % أنت مبتاع بعيرا فحدا % % 14(@)(@@) % فتوليت بحزن داخل % في الحشا ينمى ويبقى أبدا % % 15(@)(@@) % ويقولون : ادن منها مجلسا % قلت : لو وقد عمرو وقدا % % 16(@)(@@) % يابنة الخير تشكرت يدا % لك عندي فأعيدي لي يدا % % 17(@)(@@) % بأبي أنت وإن باعدتني % % وبأمي أنت يا نفسي الفدا % % 18(@)(@@) % إن نبت عيني وكانت زلة % فاغفريها قبل أن ألقى الردى % % 19(@)(@@) % حلم ذي القدرة حظ زانه % والبلايا لا تحاشي أحدا % % 20(@)(@@) % ريم قد تبت وطالت عشرتي % % شهد الله ودمعي شهدا % % PageV01P558 21(@)(@@) % يا ابنة الخير اقبلي معذرتي % % وأنيلي بلغ العير المدى % % 22(@)(@@) % لا تكوني كامرىء فارقته % يقفأ الراده يرعى رغدى % % 23(@)(@@) % ضيق المسك ولو أحميته % % لم يذب جودا ولكن جمدا % % 24(@)(@@) % لو تردى لم يزد إخوانه % حين ينعى أن يقولوا بعدا % % 25(@)(@@) % ولقد قلت لأخرى أعرضت % % دون ريحانة قتلي صردا % % 26(@)(@@) % يحتوي وصلك قلبي غاديا % وتراك العين فيها رمدا % % 27(@)(@@) % ليس عن ريمة فضل في الهوى % % لست بي حبها . . . أو عقدا % % 28(@)(@@) % ريمة الريمة عينا وحشا % بعد ردف من رآه سجدا % % 29(@)(@@) % غيبت ودا فلما غيبت % أسرت نومي وأبقت سهدا % % 30(@)(@@) % إذ تعاطينا ووهب نائم % % برد المزنة يسقي البردا % % PageV01P559 31(@)(@@) % رب عيش عندنا عشنا به % % ونعيم لو خلدنا خلدا % % PageV01P560 البحر : وافر تام 1(@)(@@) % أعادك طيفها وبما يعود % وحب الغانيات جوى يؤود % 2(@)(@@) % ذكرت القاطعات على بلاد % فللعينين من سبل فريد % 3(@)(@@) % غداة يروقه كفل نبيل % وعين في النقاب لها صيود % 4(@)(@@) % ويوم الحنو حنو بني زياد % قفا نبأ وأعينهم شهود % % 5(@)(@@) % يحيي بعضنا بعضا جهارا % كأنا لا نكاد ولا نكيد % 6(@)(@@) % ومن بالي وإن رغموا كعاب % غدت في الخز أو كادت تميد % 7(@)(@@) % مشهرة الجمال بعارضيها % % إذا سفرت لها نظر جديد % 8(@)(@@) % من الخفرات لم تطلع بفحش % على جار ولا بكرت ترود % % 9(@)(@@) % عفا أثر لعبدة كان عفا % % وأبقى الحزن ما ضرب الوريد % % 10(@)(@@) % وقد طفق الوليد يلوم فيها % % وأي الدهر ساعفك الوليد % % PageV01P561 11(@)(@@) % فمهلا لا أبا لك بعض لومي % % ضججت من الهوى وأنا العميد % 12(@)(@@) % لقد 
ms149	 ترك الفؤاد لتلك ودا % وسؤلا لا يشيد به مشيد % 13(@)(@@) % ليالي نلتقي بحماد حوضى % % على لطف يطالعه الحسود % 14(@)(@@) % فأصبح عيشنا فيها تولى % % وهل للعيش في الدنيا خلود % % 15(@)(@@) % ولما قربت لبكور ثني % جمال الحي فانقعر العمود % 16(@)(@@) % تصدت تستزيدك في هواها % % عبيدة بعدما جهد المزيد % 17(@)(@@) % فيا كبدا من الطرب المعنى % % إليها إن أهونه شديد % 18(@)(@@) % فقدت الحب من شرع لصاد % فبئس الورد يألفه الورود % % 19(@)(@@) % رأيت الدهر يشعب كل إلف % ولايبقى لوحدته الوحيد % 20(@)(@@) % قريب ما ملكت وإن تراخى % % وبيت الجار مطلبه بعيد % PageV01P562 21(@)(@@) % بجدك يا ابن قزعة نلت مالا % ألا إن اللئام لهم جدود % % 22(@)(@@) % ولو تعطى بسعيك مت جوعا % ولم تظفر يداك بما تريد % % 23(@)(@@) % أمن خوف الزيادة في الهدايا % % أقمت دجاجة فيمن يزيد % % 24(@)(@@) % كسوتك حلة مما أسدي % % برودا لا يفارقها يزيد % 25(@)(@@) % ملابس لا ترث على الليالي % % ولا تبلى وإن بليت جلود % % 26(@)(@@) % جلست أحوكها والليل داج % % محبرة تبيد ولا تبيد % 27(@)(@@) % يورثها بنوك بني بنيهم % % إذا هلكوا ومنشرها جديد % % 28(@)(@@) % كذاك الدهر يبلي كل شيء % % ولا يفنى على الدهر القصيد % % 29(@)(@@) % فهل من عارف شربا لصاد % ينال بجوده ما لا تجود % % 30(@)(@@) % صببت على ابن قزعة من عذابي % % أذاة لا يسكنها البرود % PageV01P563 31(@)(@@) % ولا . . . . الحرسي منا % % لقد لاقى كما لاقت ثمود % 32(@)(@@) % على الضعفاء ليث حين يسطو % % وتوعده فيسهره الوعيد % 33(@)(@@) % مولينا على الأمات جلد % % على وجل فدرهمه قيود % % 34(@)(@@) % يخال البخل مفترضا عليه % % فيجمد مثل ما جمد الحديد % % 35(@)(@@) % فأفرخ روعه لا أجتديه % % ولكن سوف يبلغه النشيد % % 36(@)(@@) % له وجه يخف على الموالي % % وكف لا يؤملها الوفود % % 37(@)(@@) % يقوم به القليل إلى المخازي % % ويخزله عن المجد القعود % 38(@)(@@) % غبي العين عن طلب المعالي % % وفي السوآت شيطان مريد % % 39(@)(@@) % أبا يحيى علام تكون وغدا % كبرت وفيك عن كرم صدود % % 40(@)(@@) % فإن تك ناقصا من كل خير % فما لك في مساءتنا تزيد % PageV01P564 41(@)(@@) % ستهجرك الكرام فبن ذميما % فإنك للئام أخ ودود % PageV01P565 البحر : خفيف تام 
ms150	 1(@)(@@) % اسمعي يا خليد أنت الخلود % ما يقول المتيم المعمود % % 2(@)(@@) % إن تصدي عني فلست براء % وجه نومي حتى يموت الصدود % % 3(@)(@@) % لو دعاك الذي دعاني من الشو % % ق فواقا أردت بي ما أريد % 4(@)(@@) % قربيني خليد إني ودود % وحقيق بالقرب منك الودود % 5(@)(@@) % لا تمني أخاك في ملة الحب % % بداء دواؤه مفقود % % 6(@)(@@) % لا أعفي به ولا أعرف العي % % ش وعندي بلية لا تبيد % % 7(@)(@@) % يا بلائي قط طلت حتى لو أني % % من حديد لذاب ذاك الحديد % % 8(@)(@@) % كم جوى عبرة وزفرة عين % قد تضمنتها فما أستزيد % 9(@)(@@) % حسب نفسي من حبها ما بنفسي % % أنا بال والحب غض جديد % % 10(@)(@@) % لم أقصر عن الأوانس حتى % % مسني من عبيدة التسهيد % % PageV01P566 11(@)(@@) % جل ما بي منها وما جل نيل % عندها إنها عليها جمود % 12(@)(@@) % أي شيء أجل من أن قلبي % % ليس يصحو ولا أراها تجود % % 13(@)(@@) % قيدتني عن كل أنثى تعدى % % بهواها ومن هواها قيود % % 14(@)(@@) % أيها اللائمي ولم آت بأسا % يشهد الله والثلاث الشهود % % 15(@)(@@) % قد عصاني قلبي إلى من عصاه % فاستفاد الهوى وما يستفيد % % 16(@)(@@) % قادني للشقاء جهرا فؤادي % % وفؤادي فعال تلك المعيد % 17(@)(@@) % ويح نفسي أمن دلال فتاة % راح همي وخف عني الهجود % 18(@)(@@) % لا رعى الله من يلوم محبا % في هواه ولا سقته الرعود % % 19(@)(@@) % عش بأخلافها قليلا ستلقا % % ك بأخلافها الصفاة الصلود % 20(@)(@@) % هي لا تجتدي محبا ولا تج % % دي عليه ففيم يبكي الحسود % % PageV01P567 21(@)(@@) % قد تبرضتها فغير جواد % بهوان يأوي به مجهود % 22(@)(@@) % ليت شعري أكلهن بخيل % مثل ما قد يكون أم هن جود % % 23(@)(@@) % بل ينال الهوى رجال ولكن % % نام جدي ولا تنام الجدود % % 24(@)(@@) % ربما قد دعوت باللهو خودا % ودعتني أنفاسها والجلود % 25(@)(@@) % ذاك إذ مدخلي عليهن عفو % ونعيمي دان وعيشي خريد % 26(@)(@@) % ثم بدلت صفحتي للغواني % % كل شيء إلى بلى مردود % PageV01P568 البحر : وافر تام 1(@)(@@) % عبيدة أطلقي عني صفادي % % ولا تعدي علي مع الأعادي % % 2(@)(@@) % ومن يكف يالهوى جلدا فإني % % رقيق القلب 
ms151	 لست من الجلاد % % 3(@)(@@) % كأني من هواك أخو فراش % يفوق بنفسه قلق الوساد % % 4(@)(@@) % سقاه البابلي براحتيه % سجال الموت في عقد الوداد % 5(@)(@@) % وغامطة لفقدك في التداني % % تسائل كيف أنت على البعاد % % 6(@)(@@) % فقلت بفقدها حاربت نومي % % وحاربت التيقظ بافتقادي % % 7(@)(@@) % تنام ولا أنام كأن عيني % % لمقلة عينها وهبت رقادي % % 8(@)(@@) % فنامت عينها وجنت لعيني % % بما وهبت لها شوك القتاد % % 9(@)(@@) % فكوني حرة في حفظ عيني % % هداك لقبلة المعروف هاد % % 10(@)(@@) % لعلك تسمعين غدا مقالي % % بحيث صبا الفؤاد إلى سعاد % % PageV01P569 11(@)(@@) % أقول لمثبت وبه حراك % يهم ولا يسمح بانقياد % % 12(@)(@@) % أبعد عبيدة الحوراء تصبو % % إلى أنثى فقدتك من فؤاد % % 13(@)(@@) % فراجع باسمها طربا إليها % % كما انصرف الذلول مع القياد % % 14(@)(@@) % كأن القلب لم يسمع بسعدى % % ولم يهمم لعبدة بالفساد % 15(@)(@@) % تجافى عن صبابته إليها % % وكانت زلة غير اعتماد % % 16(@)(@@) % وما إن تطربين إلى المنادي % % بعبدة فاستطرت إلى المنادي % % 17(@)(@@) % بأول ممسك بذناب غي ي % % عداني الغي عن سبل الرشاد % % 18(@)(@@) % خليلي اتئادكما بعذر % ولومكما أخا غير اتئاد % % 19(@)(@@) % دعا لوم المحب إذا تمادى % % فما لوم المحب من السداد % 20(@)(@@) % لعلكما على اللوماء فيها % % تحثكما الطماعة بارتداد % % PageV01P570 21(@)(@@) % فلست براجع ما حن إلف % وما هتف الحمام ببطن واد % 22(@)(@@) % وأقسم فاقصداأو عدباني % % بطول ملامة غير اقتصاد % % 23(@)(@@) % لو ان الغانيات ملكن قلبي % % لكان محل عبدة في السواد % % 24(@)(@@) % كأني يوم شيعني صحابي % % فرحت ولم أنخ منها بوادي % % 25(@)(@@) % أسير مسلم بدماء قوم % إلى ذي غلة حران صادي % % 26(@)(@@) % تواكلها الأباعد في يديه % % وليس له من الأدنين فادي % % PageV01P571 البحر : كامل تام 1(@)(@@) % يا عبد ضاق بحبكم جلدي % % وهواكم صدع على كبدي % % 2(@)(@@) % إني حلفت ألية صدقت % بفناء بيت الواحد الصمد % 3(@)(@@) % لتركتني صبا بحبكم % % وقتلتني ظلما بلا قود % 4(@)(@@) % أبقيت من قلبي حشاشته % % وحللت بين الروح والجسد % 5(@)(@@) % أفما أنى لك يا عبيدة أن % تشفي أخا الأحزان والكمد % 6(@)(@@) % يمسي ويصبح هائما بكم % ويهال بالترويع والسهد % % 7(@)(@@) % نرجو عبيدة أن تجود لنا 
ms152	 % % ما إن يرجى بعد من أحد % 8(@)(@@) % علقتها بيضاء ناعمة % لم تجف عن طول ولم تزد % 9(@)(@@) % وتريك عيني جؤذر خرق % % بالروض لم تكحل من الرمد % 10(@)(@@) % أحوى المدامع زان قامته % % حلل الدمقس تظل في أود % % PageV01P572 11(@)(@@) % كالزمهرير يكون صائفة % وهوى المعانق ليلة الصرد % 12(@)(@@) % تمت ترائبها إلى قدم % % والساق مكملة إلى العضد % % 13(@)(@@) % وإذا نظرت وجدت مطمعها % % ماء السؤال سواه لم تجد % % 14(@)(@@) % قولا لها ما دمت مطلعا % إلا ودونك أعين الرصد % % 15(@)(@@) % نفسي وأسرتي الفداء لكم % % والأهل بعد المال والولد % PageV01P573 البحر : طويل 1(@)(@@) % ألم يأن أن تسلى مودة مهددا % % فتخلف حلما أو تصيب فترقدا % % 2(@)(@@) % وما ذكرك اللائي مضين براجع % عليك نوى الجيران حتى تبددا % % 3(@)(@@) % أجدك لاتنسى بمقصودة اللوى % % عشية إذ راحت تجر المعضدا % % 4(@)(@@) % عسيبا كإيم الجن ما فات مرطها % % ومثل النقا في المرط منها ملبدا % % 5(@)(@@) % تريك أسيل الخد أشرق لونه % كشمس الضحى وافت مع الطلق أسعدا % % 6(@)(@@) % ونحرا يريك الدر لما بدت لنا % % به لبة منها تزين الزبرجدا % % 7(@)(@@) % وحمراء كلواذ الكثيب تطربت % فؤادي وهاجت عبرة وتلددا % % 8(@)(@@) % ثقال إذا راحت كسول إذا غدت % % وتمشي الهوينا حين تمشي تأودا % % 9(@)(@@) % ترى قرطها مستهلكا دون حبلها % % بنفنفه من واضح الليث أجيدا % % 10(@)(@@) % غدت بهوانا من رفاعة نية % شطون وهر فاجع من توددا % % PageV01P574 11(@)(@@) % فآلى على الهجر الرقاد ولم تزل % نجيا لضيفان الهموم مسهدا % % 12(@)(@@) % كأني غداة ستقرأ الحي هالك % شربت ببين الحي من سم أسودا % % 13(@)(@@) % إذا انجاب هم آب آخر مثله % ولم تكتحل عيني من الهم مرودا % % 14(@)(@@) % بذي اللوث من سر المهاري كأنما % % يروح معدى أن يكل ويعمدا % % 15(@)(@@) % بدفيه آثار النسوع كأنها % % مجر سيول في الصفا حين خددا % % 16(@)(@@) % وناعمة التاويب عديت ليلها % % بتكليفناها فدفدا ثم فدفدا % % 17(@)(@@) % حميت الكرى عينا لها واحتميته % % إلى أن جلا وجه من الصبح أربدا % % 18(@)(@@) % فأصبحت أثني غرب روعاء أوحشت % بها جنة من طائر حي غردا % % 19(@)(@@) % مواشلة مثل الفريدة عبدت % % بشرقي وعساء السمينة مرقدا % % 20 
ms153	(@)(@@) % رعت غيبة عنه وأضحى بغيبه % لقى للمنايا بين دعصين مفردا % % PageV01P575 21(@)(@@) % غدت وبها شيء وراحت بمثله % % لترغده من حشيها أن ترغدا % % 22(@)(@@) % فما وجدت إلا مجر إهابه % وإلا إهابا بالقفي مقددا % % 23(@)(@@) % فسافت عليه ساعة ثم أدبرت % % حديدة طرف العين نظارة العدا % % 24(@)(@@) % رشدت أمير المؤمنين وإنما % % ظفرت ووليت الأمين المسددا % % 25(@)(@@) % ونعم أمير المصر يصبح للقا % % ودودا وفي الإسلام عفا موددا % % 26(@)(@@) % أغر عليما بالسياسة لم يقم % عنيفا ولارث القوى متهددا % % 27(@)(@@) % يزين بعدل ملكه ويزينه % % محاسن دينا من يدين تأيدا % % 28(@)(@@) % من المنعمين الشم يجري بحلمه % الأراجي حتى أورد الهم موردا % % 29(@)(@@) % رحيم بنا سهل الفناء كأنما % % يرانا بنيه بين كهل وأمردا % % 30(@)(@@) % فبلغ أمير المؤمنين وقل له : % بعثت علينا من أراح وأرقدا % % PageV01P576 31(@)(@@) % نكى زاده بالملحدين فأصبحوا % % خبيئا كمن تحت الثرى أو مجردا % % 32(@)(@@) % فزد من كفاك المصر حين هززته % % فإن الذي يعنيك يعني محمدا % % 33(@)(@@) % له صفد دان وشعب مؤخر % وإن سيم خسفا قذم الموت أسودا % % 34(@)(@@) % به نطحر الأقذاء عن سرياتنا % % ونلقى إذا نأبى الجنان تغردا % % 35(@)(@@) % تعود أخذ الحمد منا بماله % وكل امرئ جار على ما تعودا % % 36(@)(@@) % يجود لنا لا يمنع المال باخلا % ولا اليوم إن أعطاك مانعه غدا % % 37(@)(@@) % كذلك تلقى الهاشمي إذا غدا % % جوادا وإن عاودته كان أجودا % % 38(@)(@@) % له شيم تحكي أبا كان سابقا % إذا قسمت كانت نحوسا وأسعدا % % 39(@)(@@) % ومن عمه فيه شمائل أصبحت % % وبالا على قوم وإن كن . . . . دا % % 40(@)(@@) % إمامان لايدرى أهذا بسيبه % على الناس أم ذا كان أم ذاك أعودا % % PageV01P577 41(@)(@@) % هما جربا قبل الجياد وقلدا % % فأيهما أشبهت كنت المقلدا % % 42(@)(@@) % سماحا إذا ماجرت الحرب ذيلها % % وعزا إذا جمر كجمر توقدا % % 43(@)(@@) % تخولت مخزوما وفزت بهاشم % فأصبحت من فرعي قريش مرددا % % 44(@)(@@) % وأنت ابن من رادى أمية بالقنا % % جهارا وبالبصري ضربا مؤيدا % % 45(@)(@@) % أهب لهم فرسان حرب مطلة % وخرسا تباهى في السنور حشدا % % 46(@)(@@) % فما برحوا يسدون حتى رماهم % بملمومة لم تبق نيرا ولا سدا % % 47 
ms154	(@)(@@) % فأصبحت النعمى علينا وأصبحوا % % قتيلا ومحمولا إليك مصفدا % % 48(@)(@@) % أبوك أبو العباس جلى بسيفه % % وأنت المرجى في قرابة أحمدا % % 49(@)(@@) % وكل أب يدعى له سيف نجدة % يعد ويسمو في المكارم مصعدا % % 50(@)(@@) % وكم لك أم حرة حارثية % وأخرى من الصيد المقيمين مرفدا % % PageV01P578 51(@)(@@) % خزمت بمخزوم أنوفا كثيرة % وهشمت أخرى بالهواشم حشدا % % 52(@)(@@) % ولابيت إلا بيت مجدك فوقه % منيفا يراعى الفرقدين مشيدا % % 53(@)(@@) % وأنت الهمام المستجار من الردى % % مرارا ومن دهر طغى وتمردا % % 54(@)(@@) % وإن يأتك المستشرعون فربما % % أتوك فرويت القديم المصردا % % 55(@)(@@) % فعالك محمود وأنت محسد % وهل تجد المحمود إلا محسدا % % 56(@)(@@) % فرعت قريشا في أرومتها التي % % يمد يديه دونها كل أصيدا % % 57(@)(@@) % يذبون عن واد حرام وبيضة % إذا أفرخت أحيت من الدهر مجمدا % % 58(@)(@@) % أرى الناس ما كنتم ملوكا بأمنة % ولو فقدوكم خالف القائم اليدا % % 59(@)(@@) % وأنتم سقاة الحج لولا حياضكم % % وأدلئكم لم تحمد الناس موردا % % 60(@)(@@) % ورثتم رسول الله بيت خلافة % وعزا على رغم العدو وسؤددا % % PageV01P579 61(@)(@@) % لكم نجدة العباس في كل موطن % ويوم حنين إذ أشاع وأشهدا % % 62(@)(@@) % مقيم يذب المشركين بسيفه % % حفاظا وقد ولى الخميس وعردا % % 63(@)(@@) % بني لكم العباس في شرف العلى % % وفضل ابن عباس أغار وأنجدا % % 64(@)(@@) % وأنتم حماة الدين لولا دفاعكم % لقد قذيت عيناه أو كان أرمدا % % 65(@)(@@) % ومروان لما أن طغا وأتتكم % % زوائر منه بادئات وعودا % % 66(@)(@@) % نصبتم له البيض اللوامع بالردى % % وخطية أخمدن ما كان أوقدا % % 67(@)(@@) % ففرقتم أشياعه وهدمتم % بملككم العادي ملكا مولدا % % 68(@)(@@) % فأصبح مطلوبا وآب برأسه % % كتائب أدركن الحمار المطردا % % 69(@)(@@) % ومستوقع عند البرية أنكم % % مدعون في الهيجا إلى من توردا % % 70(@)(@@) % أنختم لنا ما بين شربة جيدة % % إلى الصين تروون القنا والمهندا % % PageV01P580 71(@)(@@) % فدى لبني العباس نفسي وأسرتي % % وما ملكت نفسي طريفا ومتلدا % % 72(@)(@@) % إذا حاربوا قوما رأيت لواءهم % يقود المنايا بارقات ورعدا % % 73(@)(@@) % بأرعن تمسي الأرض منه مريضة % وتلقى له الجن العفاريت سجدا % % 74(@)(@@) % أقول لسعدى حين هز عدوها % % وجانبها المعروف ممن تزيدا % % 75(@)(@@) % سيكفيك سجل 
ms155	 من سجال محمد % وعيد العدى والبخل ممن تعقدا % % 76(@)(@@) % سمام الأعادي من يديه وفيهما % . . . . . فيها شفاء من الصدا % % 77(@)(@@) % إذا عزت الأنداد ذل نواله % وسيان تذليل المواهب والندا % % 78(@)(@@) % ذري الذرى في المحل يوري زناده % إذا المسهب المأمول أكدى وأصلدا % % 79(@)(@@) % إذا آذنته الحرب آذن نومه % بحرب إلى ان يقعد الحرب مقعدا % % 80(@)(@@) % حمول على المكروه نفسا كريمة % إذا هم لم يقعد بما كان أوعدا % % PageV01P581 البحر : مجزوء الكامل 1(@)(@@) % وردت همومك يوم صاعد % وتعرضت لك بالأجالد % % 2(@)(@@) % وأرقت من سار سرى % % لك في السموط وفي القلائد % % 3(@)(@@) % قمر المجرة لايني % % قمرا يزورك في المراقد % 4(@)(@@) % وإذا غدوت ذكرته % وبدا لعينك في المجاسد % % 5(@)(@@) % لله ذكرة عاشق % يدنو بها النائي المباعد % % 6(@)(@@) % بك ما ترى فيما يج % % يز مجاز حاجات لوافد % 7(@)(@@) % أما الربيع فالكربي % % ع فعاله المحمود شاهد % % 8(@)(@@) % قل للخليفة إن خلص % ن إلى الخليفة غير باعد % % 9(@)(@@) % إن الربيع فأدنه % نعم الوزير على الشدائد % % 10(@)(@@) % شهد نصيحته بمك % % ها . . . . . . بالمجالد % % PageV01P582 11(@)(@@) % ضبط الخلافة واحدا % لله درك أي واحد % % 12(@)(@@) % ما زال يكتم أمرها % % ويهزها هز المناجد % % 13(@)(@@) % ويصونها ويذود عن % % ها . . . . . . . . بالمجالج % % 14(@)(@@) % وبنو علي مشفقو % % ن من الأقارب والأباعد % % 15(@)(@@) % حتى صفت لمحمد % ما دون ذا نصح لزائد % % 16(@)(@@) % وسما بموسى غير وا % % ن حين زلزلت الموارد % % 17(@)(@@) % ومضى على منواله % % حسن اليدين على الأحاسد % % 18(@)(@@) % حدبا على أعقابهم % % وعلى المكارم غير راقد % % 19(@)(@@) % وإذا ذكرت فعاله % % بشرت نفسي بالفوائد % % 20(@)(@@) % ووقفت إن طليبتي % % عند الملي بها المساند % % PageV01P583 21(@)(@@) % سبق الربيع بفضله % % أيام مكة كل قائد % % 22(@)(@@) % خلي الجياد خلافه % % ومضى بآبدة الأوابد % % PageV01P584 البحر : طويل 1(@)(@@) % أخالد لم أخبط إليك بنعمة % سوى أنني عاف وأنت جواد % 2(@)(@@) % فإن تعطني أفرغ إليك محامدي % % وإن تأب لا يضرب عليك سداد % 3(@)(@@) % ركابي على حرف وقلبي مشيع % وغير بلاد الباخلين بلا د % % 4(@)(@@) % إذا أنكرتني بلدة أو أنكرتها % % نهضت مع البازي علي سواد % % 5(@)(@@) % أخالد بين الأجر والحمد حاجتي % % فأيهما 
ms156	 تأتي فأنت عماد % 6(@)(@@) % وما خاب بين الأجر والحمد عامل % له منهما عند العواقب زاد % 7(@)(@@) % أخالد ناهزها فإن سماعها % % جميل ومأتاها تقى وسداد % PageV01P585 البحر : وافر تام 1(@)(@@) % أشادن إن ' ريمة ' لا تصاد % % وإن لقاء ( ريمة ) مستزاد % 2(@)(@@) % أشادن كيف رأيك في صديق % به عقد ( بريمة ) أو وجاد % 3(@)(@@) % ( بريمة ) خالفت عيني سهودا % وبئس خليفة النوم السهاد % % 4(@)(@@) % أشادن لو أعنت فإن عيني % % لها سبل وليس لها رقاد % 5(@)(@@) % أغادي الهم منفردا لصوقا % % على كبدي كما لصق القراد % % 6(@)(@@) % وأفرح أن أعاد وقد أراني % % أذاد عن الحديث ولا أعاد % 7(@)(@@) % أشادن قد مضى ليل وليل % أكابده وقد قلق الوساد % 8(@)(@@) % فأي فتى أصيب بمثل مابي % % يصاب على الهوى أو يستزاد % 9(@)(@@) % أشادن إنها طلق وإني % % أبا لك لا أنام ولا أكاد % 10(@)(@@) % وما عن نائل كلفي ولكن % شقيت بها ومزنتها جماد % PageV01P586 11(@)(@@) % إذا ما باعدت قربت برأي % وإن قربت فشيمتها البعاد % 12(@)(@@) % وقالت قد كبرت فلست منا % % وليس لما مضى منك ارتداد % % 13(@)(@@) % فحسبي من مهازلة الغواني % % ومن كأس لسورتها فساد % 14(@)(@@) % تركت اللهو بل نفد التصابي % % وأي العيش ليس له نفاد % 15(@)(@@) % وحاجة صاحب ثقلت عليه % حملت ولا يقوم لها الوجاد % 16(@)(@@) % وصفراوين من بقر وراح % أصبتهما وما حسن السواد % 17(@)(@@) % ويوم في ذرى جشم بن بكر % نعمت به وندماني زياد % 18(@)(@@) % إذا ما شئت غناني كريم % له حسب وليس له تلاد % 19(@)(@@) % يصب لسانه طرفا علينا % % كما تتساقط النطف السداد % % 20(@)(@@) % فلما حثت الصهباء فينا % % وغرد صاحبي وخلا المساد % PageV01P587 21(@)(@@) % شربنا من بنات الدن حتى % % تركنا الدن ليس له فؤاد % 22(@)(@@) % وعيش قد ظفرت به كدادا % ألذ العيش ما جلب الكداد % 23(@)(@@) % وأملاك وهبت لهم ثنائي % % وليس كزاجر النيل الثماد % 24(@)(@@) % وجدت لبعضهم جودا وبعض % كماء البحر أكدر لا يراد % 25(@)(@@) % وليس الجود منتحلا ولكن % % على أحسابها تجري الجياد % 26(@)(@@) % فتى ممن نزلت به ولكن % % بروح تكشف الكرب الشداد % 27(@)(@@) % قريع بني المهلب حين يغدو % % به ويبكي العدا 
ms157	 وبه يجاد % 28(@)(@@) % إذا مرت الرياح يمين روح % جرت ذهبا وطاب لها الجلاد % % 29(@)(@@) % يضم سلاحه ملكا هماما % عليه مهابة وله اقتصاد % 30(@)(@@) % ورئبال العراق إذا تداعت % % على أبطالها البيض الحداد % % PageV01P588 31(@)(@@) % يعيش بفضله ناء ودان % كما تحيا على الغيث البلاد % % 32(@)(@@) % وجارية من الغر العوالي % % تزف إلى الملوك ولاتقاد % 33(@)(@@) % تسرك باللقاء ولا تراها % % ويعطي ماله فيها الجواد % 34(@)(@@) % أقول لها وقد خرجت بليل % مناصحة وللنصح اجتهاد % % 35(@)(@@) % زري روحا فلن تجدي كروح % إذا أزمت بك السنة الجماد % % 36(@)(@@) % إذا خلى مكان الملك روح % فليس لمن يطيف به رقاد % % 37(@)(@@) % وحاسد قبة بنيت لروح % أطال عمادها سلف وآدوا % % 38(@)(@@) % فقلت له أراك حسدت روحا % كذاك الملك يحسده العباد % 39(@)(@@) % تشدد لا تمت حسادا وغما % لروح ملكه ولك الكياد % % 40(@)(@@) % أغر على المنابر أريحي % كأن جبينه القمر الفراد % % PageV01P589 41(@)(@@) % وضامن عسكر وعنان خيل % % نهيد به العدو ولا نهاد % 42(@)(@@) % كأن المستزيدي فضل روح % غوارب دجلة الجون استزادوا % % 43(@)(@@) % أذل لطالب العضلات روح % فواضله وعز به الجهاد % 44(@)(@@) % وقوم نالهم بجدى وقوم % أصابتهم كتائبه فكادوا % % 45(@)(@@) % ألا يا أيها الرجل المباهي % % بأسرته وليس له عماد % 46(@)(@@) % لقد قاد الجنود عليك روح % % بآباء له أمروا وقادوا % % 47(@)(@@) % من المتنزلين على المنايا % % وإن جلبوا لك المعروف عادوا % % 48(@)(@@) % وكيف تراك إن حاربت روحا % هبلت وتحتك العير الكداد % 49(@)(@@) % ملوك القريتين تنازعته % وأخلاق تسود ولا تساد % % 50(@)(@@) % أبا خلف لك الشرف المعلى % % وبيت بني المهلب والعداد % PageV01P590 51(@)(@@) % إذا شهدوا فأنت لهم دوار % وإن غابوا فليس بك افتقاد % 52(@)(@@) % تثوب لك القبائل مجلبات % كما ثابت على النصبين عاد % 53(@)(@@) % فناؤك واسع ونداك ضاف % وحليتك السنور والنجاد % % 54(@)(@@) % وما زالت يد لك للعوالي % % وأخرى للسماحة تستجاد % 55(@)(@@) % تراح إلى العلا وتسوس حربا % ولايورى ليقظتك الزناد % PageV01P591 البحر : طويل 1(@)(@@) % تلوم ابنة السعدي في حل عقدة % شريت بها ود العشيرة أو مجدا % % 2(@)(@@) % رأت جارتها ردت عليه حديقة % من المال ماطت نجتني رطبا رغدا % % 3(@)(@@) % فلم تولنا إلا 
ms158	 محامد صاحب % فباتت على هم وأبدت لنا وجدا % % 4(@)(@@) % فقلت لها صبرا بني فإنها % % مواريث لم نملك لأعناقها ردا % % 5(@)(@@) % وقد شفني ألا تزال كليفة % تنصبني فيها فأصبح مكمدا % % 6(@)(@@) % دعيني ابنة السعدي إن خليقتي % % أتت دون مالي فانثنى وحده قصدا % % 7(@)(@@) % وقد يرزق الله اللئيم وربما % % غدا الماجد المحمود من ماله فردا % % 8(@)(@@) % وما كنت إلا كالأصم ابن جعفر % رأى المال لا يبقى فأبقى له حمدا % % 9(@)(@@) % أفيئي فإنا لاحقون فإنما % % يؤخرنا أنا يعد لنا عدا % % 10(@)(@@) % سأنفق ما نالت يدي ويهزني % % لبذل الندى ميراث من لم يكن وغدا % % PageV01P592 11(@)(@@) % وما المال إلا مثل ظل سحابة % غدت طبقا ثم انجلت قطعا بردا % % 12(@)(@@) % فقل للذي يبقي لمن ليس باقيا % تصيب ولم تعقب نجاحا ولا رشدا % % 13(@)(@@) % تمتع من اللذات واستبق منصبا % فإنك لاقي القوم قد جفلوا بردا % % 14(@)(@@) % ولا تك كالشاكي مضائض حاجة % غبيا فلما مات قيل له بعدا % % PageV01P593 البحر : بسيط تام 1(@)(@@) % يأيها الرجل الغادي لحاجته % % عند الخليقة بين المطل والجود % % 2(@)(@@) % إن الحوائج قد سدت مطالعها % % فابعث لها جاه يعقوب بن داوود % % 3(@)(@@) % يابن الأكارم في دين وفي حسب % أنت المجرب لا تقفأ بموعود % 4(@)(@@) % قالت فطيمة صم فينا فقلت لها % % إن شاء يعقوب صمنا يابنة الجود % 5(@)(@@) % إذا ابن داوود أعطاني معونته % % كان الفراغ ولم أربع على عود % % PageV01P594 البحر : طويل 1(@)(@@) % رحلت لألقى من يقوم بحاجتي % % فلم ألقه إلا يزيد بن مزيد % 2(@)(@@) % فقل للذي يرجو لحاق ابن مزيد % وأيامه عنيت نفسك فاقعد % 3(@)(@@) % مضى شأوه قبل الجياد وقرؤه % % طراد الأعادي مشهدا بعد مشهد % 4(@)(@@) % يغادي الوغى كالليث في حومة الوغى % % وفي الخفض كالبازي راح على اليد % % 5(@)(@@) % ولو نازعته الريح يوما إزاره % لأرسله جودا ولم يتجرد % PageV01P595 البحر : هزج 1(@)(@@) % منعت الغسل في الحمام % والغسل له عاده % 2(@)(@@) % وما أحوجني صاح % إلى حمام حماده % % 3(@)(@@) % قضاها الله من مسك % ومن عنبرة غاده % % 4(@)(@@) % أردت . . . . . . . . فثنا % % ني الحساد والذاده % % 5(@)(@@) % ودون لقائها ليلا % أسود الجن والساده % % 6 
ms159	(@)(@@) % وعين الصقر ترعاني % % وتلك العين وقاده % % 7(@)(@@) % فلست لها بمعتاد % وليست لي بمعتاده % % 8(@)(@@) % دنا أجلي وما أسلو % % وما يلقى مع الذاده % % PageV01P596 البحر : كامل تام 1(@)(@@) % دع ذكر عبدة إنه فند % % وتعز ترفد منك ما رفدوا % % 2(@)(@@) % ما نولتك بما تطالبها % % إلا مواعد كلها فند % 3(@)(@@) % فاسكن إلى سكن تسر به % % ذهب الزمان وأنت منفرد % 4(@)(@@) % قد شاب رأسك في تذكرها % % وهفا الفراق ورقت الكبد % 5(@)(@@) % فاستبق عرضك أن يدنسه % ظن المريب وظنه حسد % % 6(@)(@@) % لا تجر شيبك للصبى فرسا % واقعد فإن لديك قد قعدوا % % 7(@)(@@) % بل أيها الرجل المضر به % % حب النساء فليس يتئد % 8(@)(@@) % أخرت رشدك في غد فغد % بل كيف تأمن ما يسوق غد % 9(@)(@@) % ترجو غدا وغد كحاملة % في الحي لا يدرون ما تلد % 10(@)(@@) % في اليوم حظك إن أخذت به % % وغد ففي تلقائه العدد % PageV01P597 11(@)(@@) % الحب تعحبني لذاذته % والفسق أقبح ما أتى أحد % 12(@)(@@) % لو كنت آمنة خلوت به % يوما فحدثني بما يجد % 13(@)(@@) % قالت لها تعفين من رفث % وعلي أني سوف أقتصد % 14(@)(@@) % فأخلي له يكحل برؤيتكم % % عينا تعناها بكم رمد % 15(@)(@@) % فلهوت والظلماء جاثمة % بالشمس إلا أنها جسد % % 16(@)(@@) % حتى انقضى في الصبح ملعبنا % % وكذاك يهلك ماله أمد % PageV01P598 البحر : كامل تام 1(@)(@@) % أمن الحوادث والهوى المعتاد % رقد الخلي وما أحس رقادي % % 2(@)(@@) % أجيب قائل كيف أنت ' بصالح ' % حتى مللت وملني عوادي % % 3(@)(@@) % ومقال عاذلتي وقد عاينتها % % إن المرعث رائح أو غادي % % 4(@)(@@) % من حب غانية أصاب دلالها % % قلبي فعاودني كذي الأعواد % % 5(@)(@@) % إني لأرهب أن تكون منيتي % % والحب داعية الفتى لفساد % % 6(@)(@@) % حتى تراني ما أكاتم حاجة % ونسيت من حبي عبيد معادي % % 7(@)(@@) % سلبت فؤادك يوم رحت وغادرت % جسدا أجاوره بغير فؤاد % 8(@)(@@) % مالت به كبد إليك رقيقة % وصبابة تسري له بسهاد % 9(@)(@@) % لا تصرميه يا عبيدة واقصدي % % نفسي فداك وطارفي وتلادي % % PageV01P599 البحر : منسرح 1(@)(@@) % أذكرت نفسي عشية الأحد % من زائر صادني ولم يصد % 2(@)(@@) % أحور عبى لنا حبائله % % بالحسن لا بالرقى ولا 
ms160	 العقد % 3(@)(@@) % فبت أبكي من حب جارية % % لم تجزني نائلا ولم تكد % 4(@)(@@) % إلا حديثا كالخمر لذته % تكون سكرا في الروح والجسد % 5(@)(@@) % ما ساق لي حبها وأتعبني % % وهنا ولكن خلقت من كبد % 6(@)(@@) % إن أترك القصد من تذكرها % % يوما فما حبها بمقتصد % % 7(@)(@@) % طابت لنا مجلسا على عجل % % ثم انقضى يومنا فلم يعد % 8(@)(@@) % كأنما كان حلم نائمة % سرت بما لم تنل ولم تكد % 9(@)(@@) % لله عجزاء كلما انصرفت % خلت عليه أجل من أحد % % 10(@)(@@) % ضيف إذا ما انتظرت جيئته % يوما فواقا أقام كالوتد % % PageV01P600 11(@)(@@) % أقول إذ ودعت وودعني % % نومي ولا صبر لي على السهد % 12(@)(@@) % يا رب إني عشقت رؤيتها % % عشق المصلين جنة الخلد % % 13(@)(@@) % عجزاء من نسوة منعمة % هيف ثقال أردافها خرد % 14(@)(@@) % رأت لها صورة تروق بها % % قأقبلت فردة لمنفرد % 15(@)(@@) % تزيده فتنة تطعمه % % بوعدها في غد وبعد غد % % 16(@)(@@) % كأنها تبتغي إساءته % % بالقرب من فعلها وبالبعد % % 17(@)(@@) % من بز صفراء في مجاسدها % % والله يوما يقعد عن الرشد % 18(@)(@@) % مأدومة بالعبير تضحك عن % % مثل وشاح الجمان أو برد % % 19(@)(@@) % مؤشر طيب المذاقة كالرا % % ح بطعم التفاح منجرد % % 20(@)(@@) % يا ليت لي مشربا بريقتها % % أشفي به غلة على كبدي % % PageV01P601 21(@)(@@) % صفراء ماتحكمين في رجل % % يفري من الشوق جهد مجتهد % % 22(@)(@@) % قد مات غما وشفه كمد % عليك فارثي له من الكمد % PageV01P602 البحر : بسيط تام 1(@)(@@) % ودع عبيدة إن البين قد أفدا % % وهل ترى في رحيل دونها رشدا % % 2(@)(@@) % لا بل لغاد إذا زمت ركائبه % على المقيمين . . . . عهدا % % 3(@)(@@) % فلا تضني بتسيلم على رجل % % لا يجد الناس إلا دون ما وجدا % % 4(@)(@@) % عهدا إلى عاشق لو يستطيعكم % % يا عبد سلم قبل البين أو عهدا % % 5(@)(@@) % ولست أدري إذا شط المزار بكم % % هل تجمع الدار أم لا نلتقي أبدا % % 6(@)(@@) % ضنت عبيدة بالتسليم فاحتجبت % فهيجت دمع عين كان قد جمدا % % 7(@)(@@) % فقلت إذ شهدت عيني بحبكم % ولم أجد عن حوار فيك ملتحدا % % 8(@)(@@) % قد يعجز الشيء ذا لب ويدركه % % من 