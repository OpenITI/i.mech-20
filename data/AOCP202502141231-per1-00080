ms61	 ترکس که: «به چشمت مانم!» %~% زان بیهدهها بود، که مستان گویند!(@)(@)PageV01P187(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0191.jpg)(@)(@)(@@)(@@)(@@) | لاادری(@)(@@) (@@) 605 ای بندهآ لعلت فلک پیروزه %~% مه کرده، زخورشید رخت دریوزه(@)(@@) (@@) هر عهد، کنه با نرگس مست تو کنم %~% ترسم، که چو عهد گل بود ده روزه(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 606 گل، گونه از آن لعل پسندیده گرفت %~% سنبل، خم از آن طرهآ پیچیده گرفت(@)(@@) (@@) لیکن، چو دل سیاه خود را، لاله %~% در نرگس او بدید، دزدیده گرفت(@)(@@)(@@)(@@) | جمال عبد الرزاق(@)(@@) (@@) 607 نرگس، که به باغ سر به سر چشم افتد %~% با چشم توام، خردهآ در چشم افتد(@)(@@) (@@) بنگر، که زخاک بر نمی دارد چشم %~% زان شرم، که با تو چشم بر چشم افتد(@)(@@)(@@)(@@) | وله(@)(@@) ~~608 دل، زلف تو را بنفشه خواند، حاشایا چون نرگس چشم توداند؟ حاشا(@)(@@) (@@) نرگس چه بود، بنفشه را خود چه محل؟ %~% کوری و کبودی، به توماند؟ حاشا!(@)(@@)(@@)(@@) | اشهری(@)(@@) ~~609 گل دید، که هر کس که به رویت نگردصد خرمن گل را، به یکی جونخرد(@)(@@) (@@) در شهر، به طوف می رود، دست به دست %~% دانست، که کس به رایگانش نبرد!(@)(@@)(@@)(@@) | عزیزالدین شروانی(@)(@@) ~~610 گل را، چودهن باز گشاید خندهبا عمر دو روزهاش، خوش آید خنده(@)(@@) (@@) گرنه دهنش ز زعفران آکندند %~% باعمر چنین، که را برآید خنده؟(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 611 در باغ، چوزد بنفشهآ خوشبو سر %~% دلها به نظاره بر زد، از هر سوسر(@)(@@) (@@) برخط خوشت فتاد چشمش، حالی %~% از رشک خطت فتاد بر زانو سر(@)(@@) (@@) 612 زاول، که بنفشه بر سر سنگ شکفت %~% غیره %~% گفتا که: منم با سرزلفین تو کفت(@)(@@) (@@) در حال، کشیدند زبانش زقفا %~% تاخود به چه زهره این سخن یارد گفت!(@)(@)PageV01P188(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0192.jpg)(@)(@)(@@)(@@)(@@) | کمال زیاد(@)(@@) (@@) 613 گفتم که مگر بنفشه بر طرف چمن %~% مانندهآ زلف توست، پر پیچ و شکن(@)(@@) (@@) اکنون که همی نگه کنم، جان وجهان %~% در هجرانت، خمیده پشت است چو من(@)(@@) (@@) 614 بنگر تو، بدان بنفشه زار دلکش %~% مهستی %~% چون کبریت گرفته اندر آتش(@)(@@) (@@) پشتی دارد، چوپشت مهجوران گوژ 
ms62	 %~% بویی دارد، چوبوی معشوقان خوش(@)(@@)(@@)(@@) | لغیرها(@)(@@) (@@) 61 گل، گر به نوا نبود در گلشن خود %~% صد برگ چرا نهاد پیرامن خود؟(@)(@@) (@@) گر مست و خراب نیست، پس بهر چرا %~% پیوسته، کند شکوفه در دامن خود؟(@)(@@)(@@)(@@) | لاادری(@)(@@) (@@) 616 دی، رفتم دیدم: طرف ملک چمن %~% آراستآه، از بنفشه وبرگ سمن(@)(@@) (@@) استاده درختها، چومستان به صبوح %~% آورده، شکوفه های رنگین به دهن(@)(@@)(@@)(@@) | وله(@)(@@) ~~617 مست است بهار، آنک! از می خوردنمی آوردش باد صبا، بر گردن(@)(@@) ~~هربرف، که در خمار خوردهست درخت روزی دو دگر، شکوفه خواهد کردن(@)(@@)(@@)(@@) | سعد رعد گنجهای(@)(@@) (@@) 618 گل، رغم تورا رخ چمن می آراست %~% پنداشت، که ماند به رخ خوب توراست(@)(@@) ~~چون دید، که نیست با رخت راست به راست از شرم رخت، پره بداد از چپ و راست!(@)(@@)(@@)(@@) | ظهیر خونجی(@)(@@) ~~619 گل را، که مبارک رخ و فرخنده پی است هر جا که بود، زینت آنجا زوی است(@)(@@) (@@) گفتم: زکدام شهری، ای من خاکت؟ %~% گفتا: نشنیده ای که اصلم زخوی است(@)(@@)(@@)(@@) | تاج قراسی قزوینی(@)(@@) (@@) 62 وقت است، که سبزه دل رباید اکنون %~% گل، از پس پرده رو نماید اکنون(@)(@@) (@@) فصاد صبا، نیشتر خار چمن %~% خون، از رگ غنچه برگشاید اکنون(@)(@@)(@@)(@@) | صدرخجندی(@)(@@) (@@) 621 مشاطهآ چرخ، باغ می آراید %~% گلبن، تتق سبز همی فرماید(@)(@@) (@@) بلبل، زنوازدن همی ناساید %~% یعنی که: گل از پرده برون می آید!(@)(@)PageV01P189(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0193.jpg)(@)(@)(@@)(@@)(@@) | محمد طبیب اردبیلی(@)(@@) ~~622 گل را زرخت، غنچه به صد تاب گرفت وز رشک رخ تواش، تب وتاب گرفت(@)(@@) (@@) رنگ رخ سرخ او مبین، نیک نگر! %~% در سینهآ او، که جمله زرداب گرفت!(@)(@@)(@@)(@@) | بهاء شروانی(@)(@@) (@@) 623 خوبان، همه عمر شرمسارند زگل %~% وز دیده سرشک رشک با رند زگل(@)(@@) (@@) این طرفه نگر، که آب گل برد رخت %~% وانگه، طمع گلاب دارند زگل!(@)(@@)(@@)(@@) | فخرنقاش(@)(@@) (@@) 624 ای روی تو درمان دل خستهآ گل %~% بگشاده به مدح تو، لب بستهآ گل(@)(@@) ~~هر صبحدمی، دست فلک در بندد از گلبن رخسارتو، صد دستهآ گل(@)(@@)(@@)(@@) | جمال عبدالرزاق 
ms63	(@)(@@) (@@) 625 گل، هر سالی باتو به بازار آید %~% هر مه، مه چرخ با تو پهلو ساید(@)(@@) (@@) این، تا سر ماه می گدازد از شرم %~% وان، تا سر سال روبه کس ننماید(@)(@@)(@@)(@@) | عزیز شروانی(@)(@@) (@@) 626 هنگام گل آمد، به تماشا نرویم؟ %~% یاران همه رفتند، چرا ما نرو یم؟(@)(@@) ~~باغ ارچه خوش است، بی فلانی خوش نیستبی او نتوان رفت، بیا تا نرویم(@)(@@) (@@) 627 بازای گل زرد، این نکوییت زچیست؟ %~% چون طرهآ یار، مشکبوییت زچیست؟(@)(@@) ~~گرهمچومنت غم است، این خنده چراست؟ور نیست، نشان زرد روییت زچیست؟(@)(@@) (@@) 628 در بحر حریصی، چونهنگی نکنم %~% در عالم لطف، چشم تنگی نکنم(@)(@@) (@@) چون گل، بر جمله خلق محبوبم ازانک %~% %~% چون لاله، دو رویی و دو رنگی نکنم(@)(@@)(@@)(@@) | مجیر بیلقانی(@)(@@) (@@) 62 بلبل، سحری دو دیده پرخون آمد %~% با ناله ونوحهآ دگرگون آمد(@)(@@) (@@) گل، در پس پرده بود، چون نوحه شنید %~% خندان خندان، ز پرده بیرون آمد(@)(@@)(@@)(@@) | ادیب صابر(@)(@@) (@@) 230 زان روی خوش و خندهآ آهستهآ گل %~% گشته ست، به دوستی دلم بستهآ گل(@)(@@) (@@) چون روی تو، گل شکفت در رستهآ گل %~% ما و، می رخسار تو، و دستهآ گل PageV01P190(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0194.jpg)(@)(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 631 آن افسر شاهانه نگر، بر سر گل %~% جان و سر گل، که نادر است افسر گل(@)(@@) (@@) مگرفت، همه ملک جهان لشکر گل %~% بی لشکر می، رفت نشاید بر گل(@)(@@)(@@)(@@) | مسعود سعد(@)(@@) (@@) 632 آهیخت، پریر لاله زاتش خنجر %~% دی، نیلوفر فکند بر آب سپر(@)(@@) (@@) ای باد، زره بر سمن امروز مدر %~% وی خاک، زغنچه ساز فردا مغفر(@)(@@)(@@)(@@) | صفت تابستان(@)(@@) (@@) 632 از شعلهآ آفتاب عالم پرور %~% در خرمن عالم، چو فلک زد آذر(@)(@@) (@@) شد گرم هوا به بوستان، ای دلبر %~% اکنون من و، عیش و، خانه وخنیا گر!(@)(@@)(@@)(@@) | پسرقاضی قزوین(@)(@@) (@@) 63 می خواه کهن، که عهد گل باز نواست %~% ساکن بنشین، که عمر بس تیزرو است(@)(@@) (@@) در هر طرف باغ، چراغی است زگل %~% بس روشن وخوش، ولی به بادی گرو است!(@)(@@)(@@)(@@) | ابوالمعالی(@)(@@) (@@) 634 آراسته گشت باغ 
ms64	 و، افروخته راغ %~% آمد گه عندلیب و، شد نوبت زاغ(@)(@@) (@@) ازگل، همه باغ گشت چون شمع و چراغ %~% اکنون من ویار گلرخ و، باده وباغ!(@)(@@)(@@)(@@) | شرف صالح(@)(@@) (@@) 632 باغ، ارچه زگل نشو و نمایی دارد %~% چون بلبل خوش غزلسرایی دارد(@)(@@) ~~63 جایی که از این سوست زر، وآن سولعل بر کار کسی راست بود باغ، که(@)(@@) او %~% وله %~% چون بلبل و گل، برگ و نوایی دارد %~% گر هست گرامی زرو، بی آهو لعل(@)(@@) (@@) بیچاره گل، از بهر چه شد خوار چنین %~% اله %~% نه تا برتا زراست و، توبر تولعل؟(@)(@@) ~~638 با یار بگفتم که: گل توبرتو بربست زباغ رخت و، می گفت مگو(@)(@@) (@@) خواهدشد و، با وی ام به شادی دعوی است %~% وله %~% گفتا: بگذار، من بر او ضامن او!(@)(@@) ~~630 گل را که توان به حسن نیکو گفتن ورشرم کنی عجب به یک رو گفتن(@)(@@) ~~زاف روی، ه با تو کرد خود را ماننددر روی تو، نتوان سخن او گفتن PageV01P191(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0195.jpg)(@)(@)(@@)(@@)(@@) | وله(@)(@@) ~~640 گر زلف تورا کمند و غل می گویم یا لعل تورا عقیق و مل می گویم(@)(@@) (@@) شرمم ناید، که با همه دانش و عقل %~% در پیش رخت، حدیث گل می گویم؟(@)(@@)(@@)(@@) | اوله(@)(@@) ~~641 گل، گر همه لاف حسن از روی توزد در خوی بنشست، تا دم از خوی توزد(@)(@@) (@@) طفلی است نپرورده! برو خرده مگیر %~% از بیخودی، ارچه دست در موی توزد!(@)(@@) جمال الدین خلیل شروانی(@)(@@) (@@) 642 در زلف تو، گل که آنچنان جای گرفت %~% دانی به چه فن در آن میان جای گرفت(@)(@@) (@@) همخانگی دل منش می بایست %~% در حلقهآ زلف تو، از آن جای گرفت(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 43» تا از قد و عارض تو، ای شمع چگل %~% کردند کحل و سرو طراوت حاصل(@)(@@) (@@) تا سرو بود، همیشه گیرد بالا %~% تا گل باشد، همیشه باشد خوشدل(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 644 رخسار تو، ازجهان خوشم می آید %~% لعلت، زمیان جان خوشم می آید(@)(@@) (@@) می دارد نسبتی به چشمت، نرگس 
ms65	 %~% زین نرگس شوخ، از آن خوشم می آید(@)(@@)(@@)(@@) | اوله(@)(@@) ~~645 گل، با رخ تو نام نجوید امسالبا بوی تو، کس سمن نبوید امسال(@)(@@) (@@) نرگس، که ازوست زینت ملک چمن %~% با نرگس شوخ تو، نروید امسال(@)(@@) (@@) 942 ای ازرخ گلبوت، نشان لاله %~% اوله %~% وزعکس رخ تو، تازه جان لاله(@)(@@) (@@) با روی تو، لاف حسن می زد که چنین %~% در کام، سیاه شد زبان لاله(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 647 یک ره، به چمن خرام ای چشمهآ نوش %~% ای پیش رخت، لاله چو من رفته زهوش(@)(@@) ~~تا از گل و سوسن و بنفشه بینی 648 بستان، که مشال آن رخ زیبا اوست(@)(@@) %~% اله %~% پیوسته، مفرح دل شیدا اوست %~% از شوق تو، صد هزار گویا خاموش(@)(@@) (@@) خوبوشد و، بینمش بدان سان گویی %~% کز طره و زلف او، نسیمی با اوست PageV01P192(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0196.jpg)(@)(@)(@@)(@@)(@@) | نمط دوم(@)(@@)(@@)(@@) | در صفت خزان(@)(@@)(@@)(@@) | فرخی سجستانی(@)(@@) ~~625 زاغان، به چمن فتنه برانگیختهاند خوش دستانان، زباغ بگریختهاند(@)(@@) (@@) رماتم بلبلان، درختان رزان %~% دستار سپید برف بر بیخته اند(@)(@@)(@@)(@@) | ابوحنیفهآ اسکاف(@)(@@) (@@) 65 تا روی هوا، زمیغ بربست نقاب %~% نیلوفر تازه، غوطه خورد اندر آب(@)(@@) (@@) بلبل، چو دو چشم خویش بگشاد زخواب %~% گل ریخته دید و، بوستان گشته خراب(@)(@@)(@@)(@@) | معزی(@)(@@) (@@) 65 تا لشکر دی، زده زهر سو علمی %~% ابری نتوان نمودن آسان به دمی(@)(@@) (@@) گر زرد گلت بشد، مدار ایچ غمی %~% گلبرگ سپید بارد، از ابر همی(@)(@@)(@@)(@@) | سیفی(@)(@@) (@@) 65 کوه و در و دشت، سیم سیما شدهاند %~% گویی که به کافور مطرا شدهاند(@)(@@) (@@) بر چرخ، ستارگان مجزا شدهاند %~% امروز، نثار مجلس ما شدهاند(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 652 تا آن دم سرد، در دهان دارد برف %~% معشوق مرا، زمن نهان دارد برف(@)(@@) (@@) ننماید روی، تا جهان دارد برف %~% یعنی: گل تازه را زیان دارد برف!(@)(@@)(@@)(@@) | لقائله(@)(@@) ~~65 از برگ خزان، روی زمین زرین شد وز برف هوا پر [ازمه] و پروین شد(@)(@@) (@@) کافور نثار گشت، بر صحن جهان %~% زین است جهان، که نامیه عنین شد(@)(@@)(@@)(@@) | الؤلؤ سمرقندی(@)(@@) (@@) 65 تا فصل 
ms66	 خزان سوی جهان می آید %~% .................. گهرفشان می آید(@)(@@) (@@) نوروز و بهار، رخت بر می بندند. %~% و اینک مه دی، دوان دوان می آید(@)(@@) (@@) 65 ای باد هوا، معتدل وسرد شدی %~% چ %~% گویی نفس عاشق پر درد شدی(@)(@@) (@@) وی شاخ درخت، ازچه قبل زرد شدی %~% دینار بر افشان، که جوانمرد شدی PageV01P193(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0197.jpg)(@)(@)(@@)(@@)(@@) | معزی(@)(@@) (@@) 657 در خانه خوریم باده، کزباد خزان %~% شد رنگ رزان، چو جامهآ رنگرزان(@)(@@) ~~گرآب رزان رفت، غمی نیست از آن اکنون من و یار و آتش و آب رزان!(@)(@@)(@@)(@@) | الغیره(@)(@@) ~~658 ای روی تو نوبهار، [شد] وقت خزان برخیز، بریز از بی من خون رزان(@)(@@) (@@) تا خون رزان هست، چه ریزی خونم %~% کاندوهت ازاین خیزد، شادیت از آن!(@)(@@)(@@)(@@) | عزیز شروانی(@)(@@) ~~659 ای مهر فلک، صبر زما بر بودی ماهی شد و، روی خود به ما ننمودی(@)(@@) (@@) در برج حمل شدی، و بنهفتی روی %~% فی الجمله توهم به حوت بهتر بودی(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 660 از برف، هوا بی فر و اورنگ بماند %~% در فصل بهار، باغ بی رنگ بماند(@)(@@) (@@) چندان دم سرد خلق بر چرخ رسید %~% کایینهآ آفتاب در زنگ بماند(@)(@@)(@@)(@@) | وله(@)(@@) ~~661 از برف، هوا چو پیر فرتوت بماندخلق، از دمه بی قوت و بی قوت بماند(@)(@@) (@@) خورشید، همی خواست شدن سوی حمل %~% از بسرف رهش نبود، در حوت بماند PageV01P194(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0198.jpg)(@)(@)(@@)(@@)(@@) | باب هفتم(@)(@@) در ترانه ها که در ترسلات به کار آید(@)(@@)(@@)(@@) | سید اشرف(@)(@@) ~~66 تا شرح غمت بگفت دل، با قلممسرگشته شد و، در آمد از پا قلمم(@)(@@) ~~جون نامه تمام گشت، معلوم نبود کز شوق تو من خسته ترم، یا قلمم(@)(@@)(@@)(@@) | اشهری(@)(@@) (@@) 623 ای از سرخامه، سحر %~% گشتتدر نامه، ز در نهاده گنج انگشتت(@)(@@) ~~دست تو، کلید در ارزاق آمددندانهآ آن کلید، پنج انگشتت(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 664 کوته کردم قصه، که بس مشکل بود %~% و آرندهآ نامه نیز، مستعجل بود(@)(@@) ~~پروای نبشتنش بسی نیزکماند دستم، که گهی بر سر و گه بر دل بود(@)(@@)(@@)(@@) | لاادری(@)(@@) ~~665 
ms67	 تا دورم، از آن دو زلف شبرنگ به تاب بر آتش دل، زدیده می ریزم آب(@)(@@) ~~اکنون چه کنم، که بخت برگشتهآ من گفتار به نامه کرد و، دیدار به خواب!(@)(@@)(@@)(@@) | وله(@)(@@) ~~666 چون پیک تو، نامهآ تو آورد چوبادبر من، در خرمی و شادی بگشاد(@)(@@) (@@) برجست زخرمی رهی تو چوباد %~% بوسید زمین و، نامه بر چشم نهاد PageV01P195(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0199.jpg)(@)(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 667 دل را، چو گل ار هزار توجامه بدی %~% با هجرتو، جمله چون سر خامه بدی(@)(@@) (@@) چون، نامه به خدمت توخواهد پیوست %~% ای کاش، رهی در شکن نامه بدی!(@)(@@)(@@)(@@) | لاادری(@)(@@) (@@) 668 در هجر تو، ای ساحر هر هنگامه %~% رخ می نهم از غصه به خاص و عامه(@)(@@) (@@) کتبت زقلم بماند و، پیک از نامه %~% اندوه زحد گذشت و، کار از کامه(@)(@@)(@@)(@@) | مهستی(@)(@@) (@@) 669 دل کو، که به نامه شرح غم آغازم %~% یا جان، که ز درد با سخن پردازم(@)(@@) (@@) از بیدلی وبیخبری، کاغذ و کلک %~% ولها %~% می گیرم و، می گریم و، می اندازم!(@)(@@) (@@) 670 چون، بند زنامهآ تو بگشاد رهی %~% بر دستخط تو، بوسه ها داد رهی(@)(@@) (@@) شد شاد به وعدهآ تو، دلشاد رهی %~% دیدار تو را، دو چشم بنهاد رهی(@)(@@)(@@)(@@) | لها(@)(@@) (@@) 671 از من صنما، قرار مستان آخر %~% مشکن به جفا و جور پیمان آخر(@)(@@) (@@) گر نامهآ من، همی نیرزد به جواب %~% ای بی معنی، ببین و برخوان آخرا(@)(@@)(@@)(@@) | لغیرها(@)(@@) (@@) 672 تا نامهآ آزار تو، بر خواند ستم %~% بس عذر نکو، که بر زبان راند ستم(@)(@@) (@@) من، هیچ ندانم سبب آزارت %~% خاقانی %~% انگشت گزان در این، عجب ماندستم(@)(@@) (@@) 673 چون سوی تونامه ای نو یسم، زنخست %~% باد، از بی عزم ره کمر بندد چست(@)(@@) (@@) باد سحری، نامه رسان من وتوست %~% ای باد، چه مرغی، که پرت باد درست!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 67 چون نامهآ تو نزد من آمد، شب بود %~% بر خواندم و، زو شبی دگر کردم سود(@)(@@) ~~چون نور معانی تو سر برزد، زود 675 ای ابر، زکشت 
ms68	 خشک، نم باز مگیر(@)(@@) %~% لغیره %~% اندر دوشبم، هزار خورشید نمود %~% وی کان، زکف تهی درم باز مگیر(@)(@@) (@@) گر پا و زبان گرفته ای از من باز %~% باری، پس ازاین دست و قلم باز مگیر!(@)(@)PageV01P196(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0200.jpg)(@)(@)(@@)(@@)(@@) | لاادری(@)(@@) (@@) 67 گفتم که زغصه مشکلی بنویسم %~% وز دفتر غصه، حاصلی بنویسم(@)(@@) (@@) کو دل، که بدو شرح غمی بازدهم %~% یا دست، که احوال دلی بنویسم(@)(@@)(@@)(@@) | فخرالدین مبارکشاه(@)(@@) ~~روزم، چو شب است زان بت خود کامه خون می چکد از دیده، که عنوان دل(@)(@@) است %~% زان پاره کنم چوصبح، هر شب جامه %~% یا رب، که چه درد [دارم] اندر نامه!(@)(@@)(@@)(@@) | ناصر قزوینی(@)(@@) (@@) 678 از دست بشد بی تو، دل خود کامه %~% روزم، زغمت همی بدرد جامه(@)(@@) (@@) اکنون، به کدام دست گیرم خامه %~% یا خود، به کدام دل نویسم نامه!(@)(@@)(@@)(@@) | جمال حاجی شروانی(@)(@@) (@@) 67 ای از عقلا، چون علما از عامه %~% گفتم که نویسمت جواب نامه(@)(@@) (@@) پا نامه، چویک شمه بگفتم غم دل %~% بی طاقت شد، شکست از غم خامه(@)(@@)(@@)(@@) | سید اشرف(@)(@@) (@@) گر دارد از این هزار باره بترم 68 نه یاد کند یار ز رنج سفرم %~% نه(@)(@@) نامه نویسد، نه بپرسد خبرم %~% هرگز، گلهآ دوست به دشمن نبرم!(@)(@@)(@@)(@@) | سلطان خوارزمشاه(@)(@@) (@@) 68 مانند ستاره اشک من خون بچکد %~% ره ره، عرق شرم زگردون بچکد(@)(@@) (@@) در نامه، اگر بازنمایم غم دل %~% والله، که زنوک قلمم خون بچکد(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 68 از عشق تو، گرم گشت هنگامهآ من %~% تر گشت زآب چشم من، خامهآ من(@)(@@) (@@) از رشک، به تو نامه ازآن ننو یسم %~% تا پیش زمن، نبیندت نامهآ من!(@)(@@)(@@)(@@) | لاادری PageV01P197(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0201.jpg)(@)(@)(@@)(@@)(@@) | فخرالدین مستوفی(@)(@@) (@@) 684 گفتم به قلم: شوق من ارنیست تورا %~% داری سر آن، اگر چه سرنیست تورا(@)(@@) (@@) تا قصهآ شوق من نویسی بریار %~% گفت: «آتش ونی، مگر خبر نیست تورا؟)(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 685 در سخنت، چو از دهان برخیزد %~% زلف چگل، از روی بتان برخیزد(@)(@@) (@@) وز بیم سر کلک عبیر افشانت %~% بند ستم، از نای جهان برخیزد(@)(@@)(@@)(@@) | فخری 
ms69	 گرگانی(@)(@@) ~~معنیش، چنان به خوبی آراسته بود 686 آن بت، که مرا به از همه خواسته بود 687 چون، نامهای از صدر سرافراز آمد هم، راحت کلی به دلم باز رسید(@)(@@) %~% لغیر %~% گویی زمیان جان من خاسته بود %~% در نامه، بسی عذر زمن خواسته(@)(@@) بود %~% هم، جان به تن مردهآ من باز آمد %~% جان وتنم، از گداز در ناز آمد(@)(@@)(@@)(@@) | امیر عمر گنجه ای(@)(@@) (@@) 688 گه طبع رهی، فتنهآ ناز تو شود %~% گه جان رهی، عاشق ساز تو شود(@)(@@) (@@) کوته مفرست رقعه، کاندوه دلم %~% الغیره %~% کوتاه، ز رقعهآ دراز تو شود(@)(@@) (@@) 689 جانا، به جواب رقعه دلشادم کن %~% وزبند غم وعشق خود، آزادم کن(@)(@@) (@@) هر چند، بر تو از فراموشانم %~% باری، به دو حرف مختصریادم کن(@)(@@)(@@)(@@) | لاادری(@)(@@) (@@) 690 نا دیدن روی تو، مرا عمر بکاست %~% بر دست کسان، عذرتو نتوانم خواست(@)(@@) (@@) چون شرح دهم به نامه، دردی که مراست؟ %~% له %~% کان جز به مشافهه نمی آید راست(@)(@@) (@@) 691 در نامهآ تو، چو دست برخامه نهم %~% خواهم، که دل اندر شکن نامه نهم(@)(@@) (@@) روزی، که صبا بوی تو آرد بر من %~% چون صبح، زغصه دست در جامه نهم(@)(@@) صدرمهذب الدین شروانی(@)(@@) (@@) 699 با نامهات، از سوز جگر سردارم %~% چون، افسر نامهآ تو بر سر دارم(@)(@@) (@@) اور نکنی، اگر بگویم کز فخر %~% زان نامه، چه بار نامه در سر دارم!(@)(@)PageV01P198(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0202.jpg)(@)(@)(@@)(@@)(@@) | باب هشتم(@)(@@) ~~درعشق وصفت عشق واحوال آن(@)(@@) وآن دونمط است(@)(@@)(@@)(@@) | نمط اول(@)(@@)(@@)(@@) | در ذکر مطایبه(@)(@@)(@@)(@@) | سنایی(@)(@@) (@@) 693 گفتی که : «زبهر مجلس افروختنی %~% در عشق چه لفظهاست، اندوختنی!»(@)(@@) (@@) ای بیخبر از سوخته و سوختنی %~% وله %~% عشق آمدنی بود، نه آموختنی!(@)(@@) ~~694 ما، عقل به دست عشق دادیم گرو بی عقل خوشیم، اگر نباشد به دوجو(@)(@@) ~~مر عاشق را، عقل چه محرم باشدای عقل، حدیث عشق بی توست برو!(@)(@@)(@@)(@@) | وله(@)(@@) ~~695 عاشق شوی ای دل و، زجان اندیشی دزدی کنی و، ز پاسبان اندیشی!(@)(@@) (@@) دعوی محبت کنی و، لاف زنی %~% وآنگه، ززبان 
ms70	 این و آن اندیشی1 PageV01P199(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0203.jpg)(@)(@)(@@) باله مق واوان آن(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 696 آن روز، که کار مهر گردون زدهاند %~% مهر زر عاشقی، دگرگون زدهاند(@)(@@) (@@) واقف نشوی به عقل، تا چون زدهاند %~% وله %~% کاین زر، زسرای عقل بیرون زده اند(@)(@@) (@@) 6977 بی روی تو، برنیاید از دل دم عشق %~% درفتنهآ توست، سربه سر عالم عشق(@)(@@) (@@) ما را گویی : چرا نگیری کم عشق %~% عاشق باشی توتا بدانی غم عشق(@)(@@) (@@) 698 با دل گفتم: «چرا نگیری کم عشق؟» %~% اله %~% گفتا: «رنه به اختیار باشد غم عشق!»)(@)(@@) (@@) گفتم: «نرسی به وصل!» گفتا: «شاید! %~% آواره چومن، بسی است در عالم عشق!»)(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 699 ای دل، چو همی حل نشود مشکل عشق %~% برخیره، چه جویی ره بیحاصل عشق؟(@)(@@) (@@) بس کس، که چوتوبه تیغ غم بسمل عشق %~% وله %~% کآخر، نشناخت هیچ کس منزل عشق(@)(@@) (@@) 700 ای دل، پس از این مگرد گرد در عشق %~% تو خاک بگردی و، نداری سر عشق(@)(@@) (@@) بس کس چوتو، جان بداد بر بستر عشق %~% ناکرده درست، حرفی از دفتر عشق(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 701 بیهوده مزن توای سنایی، دم عشق %~% زیرا نشود چو تو کسی محرم عشق(@)(@@) (@@) پندی بپذیر و، گیریک ره کم عشق %~% کز آب روان، گرد برآرد غم عشق(@)(@@) (@@) 702 جز دست بلا، نیست جنیبت کش عشق %~% اله %~% جزتیر نیاز، نیست در ترکش عشق(@)(@@) (@@) هر چند معطرم زبوی خوش عشق %~% شد ریخته آب رویم از آتش عشق!(@)(@)PageV01P200(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0204.jpg)(@)(@)(@@)(@@)(@@) | وله(@)(@@) ~~7 چزمن، به جهان نیست کسی غمخور عشق زان، بر سر من نهاد چرخ افسر عشق(@)(@@) (@@) یکباره شدم، به طبع خوش چاکر عشق %~% وله %~% دارم سر آنکه سرکنم در سر عشق(@)(@@) ~~70 آنها، که اسیر عشق دلدارانند از دیده، سوشک خون دل بارانند(@)(@@) (@@) هرگز، نشود بخت بد از عشق جدا %~% بخت بد و عاشقی بهم یارانند!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 705 هر روز، به نو برآید، آن زرگر عشق %~% در گردن محنت افکتد زیور عشق(@)(@@) (@@) احداد از آن نهادهاند بر در عشق %~% تا بگریزد، هر 
