ms2981	 - واشار إلى صدره. PageV09P375(@)(@@)(@@)(@@) $ 1738 -(@)(@@) أبو سعيد مولى عبد الله بن مسعود روى عن عبد الله بن مسعود روى عنه أبو يعفور (1) سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 1739 -(@)(@@) أبو سعيد روى عن ابن عباس في الصلاة روى الثوري عن فرات القزاز عنه، سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1740 -(@)(@@) أبو سعيد مولى عبد الله بن عامر بن كريز سمع ابا هريرة (1210 ك) روى عنه العلاء بن عبد الرحمن وداود بن قيس واسامة ابن زيد سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1741 -(@)(@@) أبو سعيد المدينى سمع ابن عمر روى عنه بشير بن سلمان سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1742 -(@)(@@) أبو سعيد صاحب الفساطيط مولى سهيل بن ذريح سمع سمرة ابن جندب روى وهب بن اسماعيل عن ابن ابى كبشة عنه (2) سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1743 -(@)(@@) أبو سعيد التمار روى عن أبي سعيد الخدرى روى عنه زيد بن أسلم سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 1744 -(@)(@@) أبو سعيد روى عن سعيد بن جبير روى عنه السدي سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1745 -(@)(@@) أبو سعيد بن رافع عم عباد بن أبي صالح [روى عن ... - 3] روى عنه عمرو بن دينار سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 1746 -(@)(@@) أبو سعيد الاعسم [روى عن ... - 3] روى عنه حجاج بن أرطأة سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 1747 -(@)(@@) أبو سعيد الحميري [روى عن ... - 4] روى عن حيوة بن PageV09P376(@)(@@) شريح سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1748 -(@)(@@) أبو سعيد المهرى مولى لهم (1) روى عن عبد الله بن عمرو روى عنه ابنه سعيد سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1749 -(@)(@@) أبو سعيد مولى بنى تيم (2) روى عن رجل من بني شيبة روى عنه ابن المبارك والوليد بن شجاع وهشام بن عمار سمعت أبي يقول ذلك وسألته (3) عنه فقال: ما ارى بحديثه بأسا.(@)(@@)(@@)(@@) $ 1750 -(@)(@@) أبو سعيد روى عن علي رضى الله عنه، روى يحيى بن مسلم بن الضحاك عن امه عنه.(@)(@@) نا عبد الرحمن قال سألت أبا زرعة عنه فقال: لااعرفه الا في هذا الحديث.(@)(@@)(@@)(@@) $ 1751 -(@)(@@) أبو سعيد روى عن خالد بن يزيد عن سعيد بن أبي هلال روى 
ms2982	 عنه معاوية بن صالح سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 1752 -(@)(@@) أبو سعيد راوي عن أبي غالب عن أبي امامة عن النبي صلى الله عليه وسلم قال: الكراث والبصل سك (4) ابليس - يعنى طيبه.(@)(@@) روى عنه عبد العزيز بن عبد الصمد.(@)(@@) نا عبد الرحمن قال سئل أبي (5) عنه فقال: لا أعرفه.(@)(@@)(@@)(@@) $ 1753 -(@)(@@) أبو سعيد قال شهدت ابن عمر وعروة يتحدثان.(@)(@@) روى شعبة (418 م 6) عن إبراهيم بن محمد بن حاطب عنه سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1754 -(@)(@@) أبو سعيد الاموى روى عن شعبة [روى عنه ... - 6] سمعت أبي يقول: كان أحمد بن حنبل يرضاه.(@)(@@)(@@)(@@) $ 1755 -(@)(@@) أبو سعد (7) الزرقى الانصاري روى شعبة عن ابى الفيض عن عبد الله بن مرة عنه، وهو الذى روى يونس بن ميسرة عن ابى PageV09P377(@)(@@) سعد في الضحايا.(@)(@@) وهو زوج اسماء بنت يزيد سمعت أبي يقول ذلك.(@)(@@) وقال سعيد بن عبد العزيز: كانت له صحبة.(@)(@@)(@@)(@@) $ 1756 -(@)(@@) أبو سعد (1) بن ابى فضالة الانصاري كانت له صحبة قال سمعت النبي صلى الله عليه وسلم يقول: إذا جمع الله عزوجل الاولين والآخرين - روى عبد الحميد بن جعفر عن ابيه عن زياد بن ميناء عنه سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1757 -(@)(@@) أبو سعد الأنصاري روى عن النبي صلى الله عليه وسلم: الندم توبة، والتائب من الذنب كمن لاذنب له، ومنك من اعتبك، وانى لاكره المرأة المرهاء، والمرأة السلتاء.(@)(@@) روى ابن أبي فديك عن يحيى ابن ابى خالد عن ابن ابى سعد عن ابيه.(@)(@@)(@@)(@@) $ 1758 -(@)(@@) أبو سعد (2) الحبرانى روى عن أبي هريرة، روى ثور بن يزيد عن حصين الحبرانى [عنه - 3] .(@)(@@) نا عبد الرحمن قال سألت أبا زرعة عنه فقال: لا اعرفه.(@)(@@) فقلت لقى ابا هريرة؟ قال: على هذا يوضح.(@)(@@)(@@)(@@) $ 1759 -(@)(@@) (4) أبو سعد الساعدي روى عن أنس روى عنه رواد (5) بن الجراح.(@)(@@) نا عبد الرحمن قال سألت أبي عنه فقال: هو مجهول، لم يرو عنه غير رواد.(@)(@@) نا عبد الرحمن قال سئل أبو زرعة عن اسم ابى سعد الساعدي فقال: لا اعرف اسمه.(@)(@@)(@@)(@@) $ 1760 -(@)(@@) أبو سعد الازدي روى عن 
ms2983	 عبد الله بن عمرو (6) روى عنه أبو إسحاق الهمداني والأعمش سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1761 -(@)(@@) أبو سعد الخزاعى روى عن ابن ابزى قال: كان النبي صلى الله عليه وسلم يسمى في الصلاة - يعنى ان يدعو عليه أو يدعو له.(@)(@@) روى PageV09P378(@)(@@) يحيى القطان عن سفيان عن منصور عنه، سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1762 -(@)(@@) أبو سعد الاعمى مكي [روى عن ... - 1] روى عنه ابن جريج سمعت أبي يقول ذلك قال أبو محمد روى عن ابى هريرة.(@)(@@)(@@)(@@) $ 1763 -(@)(@@) [أبو سعد - 2] قال رايت الزبير.(@)(@@) روى عنه سيف بن ميسرة سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1764 -(@)(@@) أبو سعد الغفاري سمع أبا هريرة [روى عنه ... - 3] سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 1765 -(@)(@@) أبو سعد (4) بن حفص بن رواحة الانصاري، حلبى، وهو ابن حفص بن عمر بن (419 م 6) ثابت، وكان يسكن حلب، روى عن مسعر بن كدام وعن أبيه روى عنه هشام بن عمار والوليد بن شجاع (1211 ك) حدثنا عبد الرحمن قال سمعت أبي يقول ذلك وسألته عنه فقال: ما أرى بحديثه بأسا.(@)(@@)(@@)(@@) $ 1766 -(@)(@@) أبو سليمان الليثى روى عن أبي سعيد الخدري عن النبي صلى الله عليه وسلم قال: أطعموا طعامكم الاتقياء.(@)(@@) روى سعيد بن أبي أيوب عن عبد الله بن الوليد عنه، سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1767 -(@)(@@) أبو سليمان روى عن أبي هريرة عن النبي صلى الله عليه وسلم قال: الميت إذا وضع على سريره قال: قدموني.(@)(@@) روى عنه معاوية بن صالح سمعت أبي يقول ذلك. PageV09P379(@)(@@)(@@)(@@) $ 1768 -(@)(@@) أبو سليمان الحدانى روى عن أنس بن مالك روى عنه شعبة وربما قال شعبة: سليمان أو أبو سليمان.(@)(@@) سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1769 -(@)(@@) أبو سليمان المرعشي روى عن كعب قوله روى عنه قتادة سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1770 -(@)(@@) أبو سليمان بن جبير بن مطعم روى عن سعيد بن المسيب روى عنه يحيى بن سعيد الاموى (1) سمعت أبي يقول ذلك.(@)(@@) نا عبد الرحمن قال ذكره أبي عن إسحاق بن منصور عن يحيى بن معين قال: أبو سليمان ابن جبير بن مطعم ثقة. 
ms2984	(@)(@@)(@@)(@@) $ 1771 -(@)(@@) أبو سليمان الازدي سمع ابا يحيى عن ابن عباس روى شعبة عن ابى هارون الغنوى عنه سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1772 -(@)(@@) أبو سليمان العصرى (2) روى عن عقبة بن صهبان عن أبي بكرة روى عنه سعيد بن زيد (3) سمعت أبي يقول ذلك.(@)(@@) نا عبد الرحمن قال ذكره أبي عن إسحاق بن منصور عن يحيى بن معين انه قال: أبو سليمان العصرى [ثقة - 4] .(@)(@@)(@@)(@@) $ 1773 -(@)(@@) أبو سليمان روى عن زيد بن صوحان روى عنه سلام بن مسكين سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 1774 -(@)(@@) أبو سليمان التيمى من تيم الله روى عن عمر بن حبيب (5) روى PageV09P380(@)(@@) عنه المحاربي سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1775 -(@)(@@) أبو سليمان روى عن محمد بن إسحاق روى عنه حفص بن ميسرة حدثنا عبد الرحمن.(@)(@@) قال سئل أبو زرعة عنه فقال لا اعرفه.(@)(@@)(@@)(@@) $ 1776 -(@)(@@) (1) أبو سفيان سمع عليا رضي الله عنه روى عنه عمران بن سليمان سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1777 -(@)(@@) أبو سفيان مولى ابن أبي أحمد سمع أبا هريرة وأبا سعيد [روى عنه ... - 2] سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1778 -(@)(@@) أبو سفيان مدينى سمع أبا هريرة روى عنه واصل بن سيف سمعت أبي يقول ذلك.(@)(@@) ويقول: هو مجهول.(@)(@@)(@@)(@@) $ 1779 -(@)(@@) أبو سفيان بن جابر بن عتيك (3) قدم مصر روى عن أبيه روى عنه نافع بن يزيد وسعيد بن أبي أيوب سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1780 -(@)(@@) أبو سفيان الشامي روى عن بحير (420 م 6) [بن ريسان - 4] روى عنه يحيى بن أبي كثير سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1781 -(@)(@@) أبو سفيان الانمارى روى عن حبيب بن عبد الله بن ابى كبشة روى عنه بقية بن الوليد سمعت أبي يقول ذلك.(@)(@@) قال أبو محمد وروى عن يحيى بن سعيد الأنصاري.(@)(@@) نا عبد الرحمن قال سألت أبي عنه فقال هو: مجهول.(@)(@@)(@@)(@@) $ 1782 -(@)(@@) أبو سفيان بن عبد الرحمن بن المطلب بن أبي وداعة السهمي روى عن ابيه عن جده، روى أبو عامر العقدى عن عبدربه بن عطاء(@)(@@) الله عنه سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1783 -(@)(@@) أبو سفيان بن العلاء روى 
ms2985	 عن الحسن البصري قال حدثنى عبد الله PageV09P381(@)(@@) ابن مغفل (1) روى عنه وكيع.(@)(@@) قال يحيى بن سعيد القطان: كنت أشتهى ان اسمع من ابى سفيان حديث الحسن عن عبد الله بن مغفل، كان يقول فيه: حدثنى ابن مغفل.(@)(@@) سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 1784 -(@)(@@) أبو سفيان روى عن سالم الخياط عن الحسن روى عنه إسماعيل ابن ابراهيم الصائغ.(@)(@@) نا عبد الرحمن قال سألت أبي عنه فقال: [هو - 2] مجهول.(@)(@@)(@@)(@@) $ 1785 -(@)(@@) أبو سفيان الصواف (3) بصرى روى عن ابى عون [روى عنه ... - 4] نا عبد الرحمن قال قرئ على العباس بن محمد الدوري عن يحيى بن معين أنه قال: أبو سفيان الصواف الذى يروى عن ابن عون كان كذابا.(@)(@@)(@@)(@@) $ 1786 -(@)(@@) أبو سفيان بن عبدربه (5) روى عن عمر بن نبهان روى عنه عمرو ابن ابى قيس.(@)(@@) نا عبد الرحمن قال سألت أبي عنه فقال: هو شيخ مجهول.(@)(@@)(@@)(@@) $ 1787 -(@)(@@) أبو سفيان روى عن عبد الله بن دينار روى عنه منصورين دينار.(@)(@@) نا عبد الرحمن قال سئل أبو زرعة عنه فقال: لا اعرفه.(@)(@@)(@@)(@@) $ 1788 -(@)(@@) أبو سفيان روى عن مسلم بن كثير (6) عن عمرو بن حريش عن عبد الله بن عمرو روى عنه محمد بن إسحاق بن يسار:.(@)(@@) نا عبد الرحمن انا PageV09P382(@)(@@) يعقوب [بن إسحاق - 1] فيما كتب إلي قال نا عثمان بن سعيد [الدارمي - 2] قال قلت ليحيى بن معين محمد بن اسحاق عن ابى سفيان، ما حال ابى سفيان هذا؟ فقال: ثقة مشهور قلت (3) عن مسلم بن كثير عن عمرو بن حريش (1312 ك) الزبيدى، فقال: هذا حديث مشهور.(@)(@@)(@@)(@@) $ 1789 -(@)(@@) أبو سلمة (4) مولى آل ربيعة روى عن ابى هريرة حديث: لو كان المدين معلقا بالثريا روى عنه إسماعيل بن جعفر سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 1790 -(@)(@@) أبو سلمة الكلاعى سمع ثوبان روى عنه الأحوص بن حكيم سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 1791 -(@)(@@) أبو سلمة بن عبد الله [بن عبد الله - 5] بن عمر بن الخطاب وقال بعضهم: أبو سلمة بن عبيد الله بن (421 م 6) عبد الله بن عمر بن الخطاب روى عن 
ms2986	 القاسم بن محمد روى عنه عبد العزيز الدراوردي وأبو عاصم النبيل سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1792 -(@)(@@) (6) [أبو سلمة روى عن وهب بن منبه قوله روى عنه حماد(@)(@@) ابن سلمة سمعت أبي يقول ذلك - 7] .(@)(@@)(@@)(@@) $ 1793 -(@)(@@) أبو سلمة روى عن أبيه قال قدم علينا عمر بن عبد العزيز مكة روى عنه عبد الرحمن بن مهدي (8) سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1794 -(@)(@@) أبو سلمة الشامي روى عن ابى مسلم الجليلى روى عنه حريز بن عثمان سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 1795 -(@)(@@) أبو سلمة العاملي شامى (9) روى عن الزهري.(@)(@@) روى هشام بن عمار عن عبد الملك بن محمد الصنعانى عنه.(@)(@@) نا عبد الرحمن قال سألت ابى PageV09P383(@)(@@) عنه فقال: كذاب متروك الحديث، والحديث الذى رواه باطل.(@)(@@)(@@)(@@) $ 1796 -(@)(@@) (1) [أبو سلمة الواسطي ويعرف بالقرادى روى عن الشعبي روى عنه شعبة احاديث سمعت أبي يقول ذلك - 2] نا عبد الرحمن قال سألت أبي عنه فقال لا يسمى وهو شيخ مجهول.(@)(@@)(@@)(@@) $ 1797 -(@)(@@) أبو سلمة روى عن شهر بن حوشب روى [عنه - 3] عبد الصمد بن عبد الوارث سمعت أبي يقول ذلك وسألته عنه فقال: ضعيف الحديث.(@)(@@)(@@)(@@) $ 1798 -(@)(@@) أبو سلمة الصائغ [روى عن ... روى عنه ... - 2] سمعت أبي يقول: هو شيخ [مجهول - 4] .(@)(@@)(@@)(@@) $ 1799 -(@)(@@) أبو سلمة اللوذانى روى عن أنس أن النبي صلى الله عليه وسلم(@)(@@) قال: من احدث اخافى الله عزوجل رفعه الله عزوجل بها درجة في الجنة، وما تواد رجلان في الله عزوجل الا كان افضلهما منزلة عند الله عزوجل اشدهما حبا لاخيه حتى يحدث احدهما، وأشرهما الذى يحدث.(@)(@@) روى عنه عمرو بن قيس الملائى.(@)(@@) قال أبو محمد روى محمد بن حميد عن الحكم بن بشير عن عمرو بن قيس الملائي عن ابى سلمة هذا الحديث، قال أبو عبد الله (5) لم يسمع أبو سلمة من انس.(@)(@@)(@@)(@@) $ 1800 -(@)(@@) أبو سبرة (6) روى عن محمد بن كعب [القرظى - 2] روى عنه الأعمش سمعت أبي يقول ذلك.(@)(@@) حدثنا عبد الرحمن قال ذكره أبي عن إسحاق بن منصور عن يحيى بن معين انه قال: أبو سبرة الذي روى عن محمد 
ms2987	 بن كعب القرظى، الذى روى عنه الاعمش لا اعرفه.(@)(@@)(@@)(@@) $ 1801 -(@)(@@) أبو سبرة روى عن شريح في الرهن روى عنه سيار. PageV09P384(@)(@@) نا عبد الرحمن قال سمعت أبي وأبا زرعة يقولان ذلك.(@)(@@)(@@)(@@) $ 1802 -(@)(@@) أبو سبرة النخعي روى عن فروة بن مسيك روى عنه الحسن (1) ابن الحكم النخعي سمعت أبي يقول (422 م 6) ذلك.(@)(@@)(@@)(@@) $ 1803 -(@)(@@) أبو سويد (2) له صحبة روى عن النبي صلى الله عليه وسلم أنه صلى على المتسحرين روى هشام بن سعد عن حاتم بن ابى نصر عن عبادة بن نسي عنه [قال ابى: لا اعرف ابا سويد - 3] .(@)(@@)(@@)(@@) $ 1804 -(@)(@@) أبو سويد القضاعى سمع تبيعا روى عنه سعيد بن أبي رفيق.(@)(@@) حدثنا عبد الرحمن قال سمعت أبي يقول ذلك [وقال: لا اعرف ابا سويد - 4] .(@)(@@)(@@)(@@) $ 1805 -(@)(@@) أبو سويد بن المغيرة روى عن الحسن ان الاحنف قدم على عمر رضي الله عنه.(@)(@@) روى عنه حماد بن زيد سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 1806 -(@)(@@) أبو سيف مولى عبد الرحمن بن سمرة القرشى (5) روى عنه ثابت البنانى قوله سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1807 -(@)(@@) أبو سيف (6) روى عن الأعمش روى عنه يعقوب القمى.(@)(@@) نا عبد الرحمن قال سألت أبي عنه فقال: لا أعرفه.(@)(@@)(@@)(@@) $ 1808 -(@)(@@) أبو سيف روى عن الحسن قوله روى عنه يعقوب بن القعقاع سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 1809 -(@)(@@) أبو سلام مولى الفهريين قال سمعت علي بن عبد الله بن عباس يقول: إذا جامعت فاستتر من السماء.(@)(@@) روى عنه معن بن عيسى سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 1810 -(@)(@@) أبو سلام روى عن ابى محذورة في الاذان.(@)(@@) نا عبد الرحمن قال PageV09P385(@)(@@) سئل ابى عنه [فقيل: - 1] هل يسمى؟ قال: لا اعلمه.(@)(@@)(@@)(@@) $ 1811 -(@)(@@) أبو سلمى راعى (2) رسول الله صلى الله عليه وسلم قال سمعت النبي صلى الله عليه وسلم يقول: بخ بخ لخمس ما اثقلهن في الميزان روى الوليد بن مسلم عن ابن جابر وعبد الله بن العلاء عن ابى سلام الاسود(@)(@@) عن ابى سلمى راعى (2) رسول الله صلى الله عليه وسلم، قال (3) : رأيته في مسجد الكوفة.(@)(@@) وروى هشام الدستوائى عن 
ms2988	 يحيى بن أبي كثير عن ابى سلام قال حدثنى رجل أنه سمع النبي صلى الله عليه وسلم.(@)(@@) ورواه ابان عن يحيى بن أبي كثير عن زيد بن سلام عن ابى سلام عن مولى رسول الله صلى الله عليه وسلم.(@)(@@) وروى زيد بن يحيى بن عبيد عن عبد الله [ابن العلاء - 4] عن ابى سلام عن ثوبان عن النبي صلى الله عليه وسلم.(@)(@@)(@@)(@@) $ 1812 -(@)(@@) أبو سلمى (1213 ك) أدرك النبي صلى الله عليه وسلم ولم يحفظ عنه الاشيئا واحدا قال سمعت النبي صلى الله عليه وسلم يقرأ في صلاة الغداة (إذا الشمس كورت) روى عنه السري بن يحيى.(@)(@@) نا عبد الرحمن قال سمعت ابى يقول [قلت - 5] لحسان بن عبد الله: لقى السرى بن يحيى هذا الشيخ؟ قال: نعم.(@)(@@)(@@)(@@) $ 1813 -(@)(@@) أبو سيارة [المنقى - 5] قال قلت يا رسول الله - روى عنه (423 م 6) سليمان بن موسى.(@)(@@)(@@)(@@) $ 1814 -(@)(@@) أبو السمح قال: كنت اخدم النى صلى الله عليه وسلم.(@)(@@) روى عبد الرحمن بن مهدي عن يحيى بن الوليد بن مسير (6) عن محل بن خليفة عنه سمعت أبي يقول ذلك.(@)(@@) قال أبو زرعة: لا اعرف اسم ابى السمح PageV09P386(@)(@@) هذا ولا اعرف [له - 1] غير هذا الحديث قال: كنت اخدم النبي(@)(@@) صلى الله عليه وسلم فكان إذا اراد أن يغتسل قال ولنى قفاك.(@)(@@) فأوليه قفاى فاستتربه (2) .(@)(@@)(@@)(@@) $ 1815 -(@)(@@) أبو السنابل بن بعكك ان سبيعة وضعت بعد وفاة زوجها.(@)(@@) روى ابراهيم عن الأسود عنه سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1816 -(@)(@@) أبو سكينة روى عن النبي صلى الله عليه وسلم قال: إذا ملك احدكم شيئا فيه ثمن رقبة فليعتقها فانها تفدى بكل عضو منها عضوا منا من النار روى يزيد بن ربيعة الصنعانى عن بلال بن سعد [عنه - 1] ولا صحبة له ولا يسمى.(@)(@@) وروى عن عبد الله بن عبد الرحمن قال قدم عمر رضى الله عنه جابية دمشق.(@)(@@) روى عنه جعفر بن برقان.(@)(@@) نا عبد الرحمن قال سئل أبو زرعة عن اسمه فقال: لا اعرف اسمه.(@)(@@)(@@)(@@) $ 1817 -(@)(@@) أبو سود بن ابى وكيع [جد 
ms2989	 وكيع - 1] بن ابى سود قال سمعت النبي صلى الله عليه وسلم يقول: اليمين الذى (3) يقتطع بها الرجل مال أخيه تعقم الرحم.(@)(@@) روى ابن المبارك عن معمر عن رجل من بنى تميم عنه سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1818 -(@)(@@) أبو سلالة الأسلمي روى عن النبي صلى الله عليه وسلم قال: يكون عليكم ائمة يملكون رقابكم يحدثونكم فيكذبونكم.(@)(@@) روى حكام بن سلم عن عنبسة بن سعيد قاضي الري عن عاصم بن عبيد الله عن عبد الله بن عبد الرحمن عن ابى سلالة [الاسلمي - 4] .(@)(@@)(@@)(@@) $ 1819 -(@)(@@) أبو سلامة الشيباني سمع عمر رضي الله عنه روى عنه سماك بن حرب.(@)(@@) سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 1820 -(@)(@@) أبو سارية سمع انسا روى عنه هشام بن سعد سمعت أبي يقول ذلك. PageV09P387(@)(@@)(@@)(@@) $ 1821 -(@)(@@) أبو سمية روى حديث جابر في الورود [روى عنه ... - 1] سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1822 -(@)(@@) أبو سهلة مولى عثمان بن عفان روى عن عثمان بن عفان رضي الله عنه روى عنه قيس ابن ابى حازم.(@)(@@) نا عبد الرحمن قال سئل أبو زرعة عن اسمه فقال لا اعرف اسمه.(@)(@@)(@@)(@@) $ 1823 -(@)(@@) أبو سنان البكري روى عن عمر رضي الله عنه [روى عنه - 2] حجاج بن أرطاة.(@)(@@) نا عبد الرحمن قال سئل أبو زرعة عنه فقال: لا اعرفه.(@)(@@)(@@)(@@) $ 1824 -(@)(@@) أبو السوار السلمى سمع ابا حاضر روى عنه عباد بن العوام سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 1825 -(@)(@@) أبو السكن الهجرى روى (424 م 6) عن جابر عن النبي صلى الله عليه وسلم، روى عبد الصمد بن عبد الوارث عن صدقة عنه سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1826 -(@)(@@) أبو سخيلة روى عن على رضي الله عنه روى عنه الخضر بن القواس سمعت أبي يقول ذلك.(@)(@@) نا عبد الرحمن قال سئل أبو زرعة عن اسم ابى سحيلة فقال: لا اعرف اسمه.(@)(@@)(@@)(@@) $ 1827 -(@)(@@) أبو سرار الغنوى روى عن أبيه عن عمر (3) بن عبد العزيز روى عنه أبو سلمة موسى بن إسماعيل.(@)(@@)(@@)(@@) $ 1828 -(@)(@@) أبو سورة ابن احى ابى ايوب الأنصاري روى عن أبي أيوب روى عنه واصل بن السائب.(@)(@@) نا 
ms2990	 عبد الرحمن قال سألت ابا زرعة عن ابى سورة فقال: أبو سورة [هو - 4] بن اخى ابى ايوب.(@)(@@)(@@)(@@) $ 1829 -(@)(@@) أبو سهيل بن مسلم روى عن أنس بن مالك عن النبي صلى الله(@)(@@) عليه وسلم قال: طلب العلم فريضة على كل مسلم.(@)(@@) روى عنه اسماعيل PageV09P388(@)(@@) ابن عياش.(@)(@@)(@@)(@@) |||| باب الشين(@)(@@)(@@)(@@) $ 1830 -(@)(@@) أبو شداد رجل من اهل دما قال: جاء نا كتاب رسول الله صلى الله عليه وسلم في قطعة اديم: من محمد رسول الله صلى الله عليه وسلم إلى اهل عمان.(@)(@@) روى أبو سلمة المنقرى عن عبد العزيز بن زياد الحبطى قال نا أبو شداد سمعت أبى يقول ذلك.(@)(@@)(@@)(@@) $ 1831 -(@)(@@) أبو شداد روى عن مجاهد روى عنه أبو جريج ويونس بن يزيد سمعت أبي يقول ذلك.(@)(@@) قال أبو زرعة: لا اعرف اسمه.(@)(@@)(@@)(@@) $ 1832 -(@)(@@) أبو شعيب الحضرمي روى عن أبي أيوب الأنصاري في الاستنجاء.(@)(@@) روى الاوزاعي عن عثمان (1214 ك) بن ابى سودة عنه سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1833 -(@)(@@) أبو شعيب رأى عبد الله بن عمر يحلق عنه الشعر.(@)(@@) روى وكيع عن عبيد (1) بن عبد الملك ابى عبد الملك عنه سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1834 -(@)(@@) أبو شعيب سمع الحسن وقتادة ويونس روى عنه يزيد بن هارون سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 1835 -(@)(@@) أبو شعيب روى عن جده عن ابن مسعود روى عنه عبد الله ابن عون سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1836 -(@)(@@) (2) [أبو شعيب روى عن طاوس عن ابن عمر في الركعتين(@)(@@) قبل المغرب سمعت أبي يقول ذلك - 3] نا عبد الرحمن قال ذكره أبي عن إسحاق بن منصور عن يحيى بن معين أنه قال: أبو شعيب الذى روى عن طاوس عن ابن عمر مشهور بصرى.(@)(@@)(@@)(@@) $ 1837 -(@)(@@) أبو شعبة مولى سويد بن مقرون روى عنه محمد بن المنكدر PageV09P389(@)(@@) سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 1838 -(@)(@@) (1) [أبو شعبة روى عن ابن الفارس بن الابلق روى عنه عبد الملك بن ميسرة سمعت ابى يقول (425 م 6) ذلك - 2] .(@)(@@)(@@)(@@) $ 1839 -(@)(@@) أبو شعبة الاشجعى البصري روى عنه هلال بن يساف سمعت ابى يقول ذلك. 
ms2991	(@)(@@)(@@)(@@) $ 1840 -(@)(@@) أبو شيبة الخدرى روى عن النبي صلى الله عليه وسلم قال: من قال لا إله إلا الله دخل الجنة.(@)(@@) نا عبد الرحمن قال سئل أبو زرعة عنه فقال: له صحبة ولا يعرف (2) اسمه.(@)(@@)(@@)(@@) $ 1841 -(@)(@@) أبو شيبة المهرى روى عن ثوبان وعمرو بن عبسة (4) روى عنه بلج وجنادة بن أبي خالد سمعت أبي يقول ذلك.(@)(@@) نا عبد الرحمن قال سئل أبو زرعة عن ابى شيبة المهرى فقال: هو من التابعين ولا يعرف اسمه.(@)(@@)(@@)(@@) $ 1842 -(@)(@@) أبو شيبة روى عن عكرمة عن ابن عباس انه كان ينام بين جاريتين روى عنه عباد بن العوام سمعت أبي يقول ذلك.(@)(@@) نا عبد الرحمن قال سئل أبو زرعة عن ابى شيبة المكى فقال: روى عنه ابن أبي زائدة وعباد بن العوام، ولا يعرف اسمه.(@)(@@)(@@)(@@) $ 1843 -(@)(@@) أبو الشموس البلوى قال كنت مع رسول الله صلى الله عليه وسلم في غزوة تبوك.(@)(@@) روى زياد بن نصر من أهل وادى القرى عن سليم بن مطير عن أبيه عنه سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1844 -(@)(@@) أبو الشمال بن ضباب روى عن أبي أيوب الأنصاري عن النبي صلى الله عليه وسلم انه قال: اربع من سنن المرسلين الحياء والسواك والتعطر والنكاح.(@)(@@) روى عنه مكحول.(@)(@@) نا عبد الرحمن قال سئل PageV09P390(@)(@@) أبو زرعة عن ابى الشمال فقال: لا أعرفه إلا في هذا الحديث، ولا اعرف اسمه.(@)(@@)(@@)(@@) $ 1845 -(@)(@@) أبو الشعثاء الكوفى روى عن ابن عمر وابن عباس روى عنه أبو سنان الشيباني وسعيد بن سعيد الثعلبي سمعت أبي يقول ذلك، ويقول لا يسمى، وهو كوفى.(@)(@@) قال على ابن المدينى: أبو الشعثاء [الذي روى عنه أبو إسحاق الهمداني ويونس بن ابى اسحاق وابو العنبس وابو سنان هو الكندى وليس هو سليم.(@)(@@) سمعت ابى يقول أبو الشعثاء الكندى - 1] اسمه يزيد بن مهاصر، وخالف عليا في ذلك.(@)(@@)(@@)(@@) $ 1846 -(@)(@@) أبو شيخ روى عن شريح قوله روى عنه أبو يعفور العبدي سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 1847 -(@)(@@) أبو شمر الضبعى روى عن عائذ بن عمرو وأبي عثمان النهدي روى عنه 
ms2992	 شعبة سمعت أبي يقول ذلك.(@)(@@) نا عبد الرحمن قال سألت ابى(@)(@@) عنه فقال: شيخ.(@)(@@)(@@)(@@) $ 1848 -(@)(@@) أبو شريح روى عن ابى مسلم روى عنه محمد بن زيد سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1849 -(@)(@@) أبو شرقى روى عن أبي عثمان النهدي روى عنه شعبة (426 م 6) سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 1850 -(@)(@@) أبو شهدة قوله روى حكيم (2) بن محمد عن طلحة (3) عن ابى شهدة سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 1851 -(@)(@@) أبو شهاب روى عن زيد بن أسلم روى عنه يحيى بن سعيد PageV09P391(@)(@@) العطار، حدثنا عبد الرحمن قال سألت أبي عنه فقال: [هو - 1] مجهول.(@)(@@)(@@)(@@) |||| باب الصاد(@)(@@)(@@)(@@) $ 1852 -(@)(@@) أبو صالح الاشعري شامى سمع ابا ريحانة وابا عبد الله وروى عن أبي أمامة روى عنه حسان بن عطية وأبو سلام الأسود سمعت أبي يقول ذلك.(@)(@@) نا عبد الرحمن نا محمد بن عوف الحمصي قال قال أبو مسهر ناهقل [بن زياد - 2] نا الاوزاعي عن حسان بن عطية عن ابى صالح الأشعري.(@)(@@) نا عبد الرحمن قال سألت ابى عن ابى صالح الاشعري فقال: لا بأس به.(@)(@@) نا عبد الرحمن قال سئل أبو زرعة عن ابى صالح الاشعري فقال: روى عنه حسان بن عطية وابو سلام الاسود اسماعيل بن عبيد الله، ولا(@)(@@) يعرف اسمه.(@)(@@)(@@)(@@) $ 1853 -(@)(@@) أبو صالح الحادى (3) روى عن النعمان بن بشير روى ريحان ابن سعيد عن عباد بن منصور عن ايوب عن ابى قلابة عنه سمعت أبي يقول ذلك.(@)(@@) نا عبد الرحمن قال سئل أبو زرعة عن أبى صالح الحادى فقال: روى عنه أبو قلابة، لا يعرف اسمه.(@)(@@)(@@)(@@) $ 1854 -(@)(@@) أبو صالح مولى الساعديين، ويقال أبو صالح السعدى سمع ابا هريرة وروى عن كعب روى عنه هاشم بن هاشم وشريك بن عبد الله بن ابى نمر (1215 ك) سمعت أبي يقول ذلك.(@)(@@) نا عبد الرحمن قال سئل أبو زرعة عن ابى صالح مولى الساعديين فقال: روى عنه شريك بن عبد الله بن ابى نمر وهاشم بن هاشم، لا بأس به، ولا يعرف اسمة(@)(@@)(@@)(@@) $ 1855 - أبو صالح الخولانى روى عن ابى 
ms2993	 هريرة ومرة بن كعب روى عنه عامر الاحول والوضين بن عطاء سمعت أبي يقول ذلك.(@)(@@) نا عبد الرحمن قال سألت أبي عنه فقال: لا بأس به.(@)(@@) نا عبد الرحمن قال سئل أبو زرعة عن ابى صالح الخولانى فقال: روى عنه عامر الاحول PageV09P392(@)(@@) لا يعرف اسمه.(@)(@@)(@@)(@@) $ 1856 -(@)(@@) أبو صالح مولى جبير بن مطعم روى عنه الحارث بن يزيد.(@)(@@) نا عبد الرحمن قال سئل أبو زرعة عن اسمه فقال: لا يعرف اسمه.(@)(@@)(@@)(@@) $ 1857 -(@)(@@) أبو صالح الخوزى روى عن أبي هريرة عن النبي صلى الله عليه وسلم قال: من لم يسئل الله عزوجل يغضب عليه روى عنه أبو المليح [سئل أبو زرعة عن اسم ابى صالح الخوزى فقال: لا يعرف اسمه(@)(@@) روى عنه أبو المليح - 1] لا بأس به [قال أبو محمد:(@)(@@) أبو المليح يقال له صبيح (427 م 6) سكن المدينة - 2] .(@)(@@)(@@)(@@) $ 1858 -(@)(@@) أبو صالح الانصاري قال: قدمت حمص اول ما فتحت.(@)(@@) روى صفوان بن عمرو عن مروان بن [رؤبة عنه.(@)(@@) نا عبد الرحمن قال سمعت أبي يقول ذلك.(@)(@@) قال أبو محمد روى ابن المبارك عن بشار بن سعيد عن أبي صالح - 3] الحمصي عن النبي صلى الله عليه وسلم فيمن مات مرابطا مرسل.(@)(@@) قال أبو محمد فلا ادرى أهو أبو صالح الانصاري أو غيره؟.(@)(@@)(@@)(@@) $ 1859 -(@)(@@) أبو صالح البزاز [روى عن ... - 4] روى عنه أبو البخترى سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 1860 -(@)(@@) أبو صالح [مولى عمر روى عن ... - 5] روى عنه عبد الرحمن بن القاسم سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 1861 -(@)(@@) أبو صالح العطار روى عن معاوية بن أبي سفيان روى أبو نعيم عن يزيد بن أبي صالح عن أبيه ابى صالح العطار، سمعت أبي يقول ذلك (6) . PageV09P393(@)(@@)(@@)(@@) $ 1862 أبو صالح الاحمسي المؤذن [روى عن ... - 1] روى عنه النعمان بن الزبير سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1863 -(@)(@@) أبو صالح مولى البراء بن عبد عمرو، روى بكير بن الاشج عن(@)(@@) عبيد الله بن مقسم عنه، سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1864 -(@)(@@) أبو صالح العقيلى روى عن أبي العلاء روى عنه أبو هلال الراسبي سمعت ابى 
ms2994	 يقول ذلك.(@)(@@)(@@)(@@) $ 1865 -(@)(@@) أبو الصلت الثقفى روى عن عمر رضي الله عنه روى عنه عبد الله ابن عمار اليمامي (2) سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1866 -(@)(@@) أبو الصلت السراج سمع ابن عمر روى عنه حفص بن أبي حفص السراج سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 1867 -(@)(@@) أبو الصلت جد عيسى بن معمر روى عن كعب روى عنه صفوان بن عمرو سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1868 -(@)(@@) أبو الصلت بياع المزاد (3) روى عن ابى عقرب روى عنه أبو يعفور العبدي سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 1869 -(@)(@@) أبو الصهباء البكري انه سأل علي بن أبي طالب رضي الله عنه روى عنه سعيد بن جبير.(@)(@@) حدثنا عبد الرحمن قال سئل أبو زرعة عن اسمه فقال: لا اعرفه اسمه.(@)(@@)(@@)(@@) $ 1870 -(@)(@@) أبو الصهباء البصري روى عن بكر بن عبد الله روى عنه معن PageV09P394(@)(@@) ابن؟ ؟ سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 1871 -(@)(@@) أبو الصهباء الكوفى سمع سعيد بن جبير روى عنه حماد بن زيد واخوه سعيد بن زيد وعمارة بن زاذان والحسن بن أبي جعفر سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 1872 -(@)(@@) (428 م 6) أبو صفوان روى عن ابن مسعود، مرسل، روى عنه أشعث بن سوار سمعت أبي يقول ذلك ويقول: هو مجهول لم يدرك ابن مسعود.(@)(@@)(@@)(@@) $ 1873 -(@)(@@) أبو صفوان روى عن محمد بن عبيد بن ابى صالح روى عنه عطاف (1) بن خالد.(@)(@@) حدثنا عبد الرحمن قال سألت أبي عنه فقال: [هو - 2] ضعيف الحديث.(@)(@@)(@@)(@@) $ 1874 -(@)(@@) أبو صفية رجل من [المهاجرين من - 3] أصحاب النبي صلى الله عليه وسلم كان يسبح بالنوى روى يونس بن عبيد عن امه عنه.(@)(@@)(@@)(@@) $ 1875 -(@)(@@) أبو الصعبة أن عمر رضي الله عنه قال روى عمران بن موسى عن ابن ابى صعبة عن أبيه سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1876 -(@)(@@) أبو صحار روى عن أبيه عن علي رضي الله عنه روى عنه عبد السلام بن مالك سمعت أبي يقول ذلك ويقول: هو مجهول.(@)(@@)(@@)(@@) |||| باب الضاد(@)(@@)(@@)(@@) $ 1877 -(@)(@@) أبو الضحاك روى عن أبي هريرة روى عنه شعبة سمعت أبي يقول ذلك، ويقول (4) أبو الضحاك هذا لا أعلم 
ms2995	 روى عنه غير شعبة.(@)(@@)(@@)(@@) $ 1878 -(@)(@@) أبو الضحاك رأى مصعب بن الزبير روى عنه قرة بن خالد سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1879 -(@)(@@) أبو الضحاك روى عن ابى حكيمة روى عنه عبد الرحمن بن PageV09P395(@)(@@) الاصبغ سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 1880 -(@)(@@) أبو ضمرة بن العيص (1) وكان مصاب البصر بمكة فلما نزلت (الا المستضعفين من الرجال والنساء) تجهز يريد النبي صلى الله عليه وسلم فأدركه الموت بالتنعيم فنزلت هذه الآية (ومن يخرج (1216 ك) من بيته مهاجرا إلى الله ورسوله) روى اسراءيل عن سالم الافطس عن سعيد بن جبير عنه.(@)(@@)(@@)(@@) $ 1881 -(@)(@@) (2) [أبو ضمرة سمع عمر بن عبد العزيز روى عنه الليث بن سعد سمعت ابى يقول ذلك - 3] .(@)(@@)(@@)(@@) $ 1882 -(@)(@@) أبو ضمرة القاص سمع كعبا قوله روى عنه حريز بن عثمان وفرج بن يحمد سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 1883 -(@)(@@) أبو الضيف روى عن كعب روى عنه حميد بن هلال سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1884 -(@)(@@) أبو ضرغامة روى عن على رضي الله عنه روى عنه عبد الرحمن بن مغراء.(@)(@@) نا عبد الرحمن قال سألت أبي عنه فقال: لا يعرف.(@)(@@)(@@)(@@) |||| باب الطاء(@)(@@)(@@)(@@) $ 1885 -(@)(@@) (429 م 6) أبو طلحة الاسدي روى عن [أنس عن - 4] النبي صلى الله عليه وسلم قال: كل بناء وبال على صاحبه.(@)(@@) روى عنه ابراهيم ابن محمد بن حاطب وابو العميس.(@)(@@) وروى شريك عن عبد الملك عنه سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1886 -(@)(@@) أبو طلحة الخولانى روى عن الضحاك بن عبد الرحمن بن عرزب عن أبي موسى الأشعري روى عنه أبو سنان عيسى بن سنان سمعت أبي يقول ذلك. PageV09P396(@)(@@)(@@)(@@) $ 1887 -(@)(@@) أبو طلحة روى عن شريح روى عنه ابن المنتشر سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1888 -(@)(@@) أبو طلحة سمع ما هان سمع منه ابن عيينة سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1889 -(@)(@@) أبو طلحة [روى عن ... - 1] روى عنه معن بن عيسى القزاز سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1890 -(@)(@@) أبو طالب روى عن أبي ذر روى الليث (2) عن عبيد الله بن ابى جعفر عن الحصمى عنه سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1891 -(@)(@@) أبو طالب الضبعى 
ms2996	 الحجام روى عن ابن عباس روى عنه قتادة سمعت أبي يقول ذلك.(@)(@@) نا عبد الرحمن ثنا يونس بن حبيب نا أبو داود نا شعبة عن قتادة قال سمعت ابا طالب الحجام - وأثنى عليه خيرا - يحدث (3) عن ابن عباس.(@)(@@) نا عبد الرحمن نا عمرو بن عبد الله الاودى حدثنا وكيع عن شعبة عن قتادة عن ابى طالب الحجام عن ابن عباس قال وكيع: وكان ثقة.(@)(@@) نا عبد الرحمن نا أبي نا ابن ابى مريم انا مخلد بن يزيد حدثني (4) شعبة عن قتادة عن أبي طالب الحجام - قال وكان رجل صدق (5) نا عبد الرحمن قال سئل أبو زرعة عن اسم ابى طالب فقال: لا اعرف اسمه وهو بصرى ثقة.(@)(@@)(@@)(@@) $ 1892 -(@)(@@) أبو طالب روى عن طالوت العرفطى روى عنه النضر بن إسماعيل سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 1893 -(@)(@@) أبو طاهر مولى الحسين (6) بن على رأى أنس بن مالك روى عنه حفص بن غياث، روى محمد بن القاسم الاسدي قال سألت ابا طاهر مولى الحسين (6) بن على عن اسمه فقال: مالى اسم الا أبو طاهر سمعت أبي يقول ذلك PageV09P397(@)(@@)(@@)(@@) $ 1894 -(@)(@@) أبو طاهر روى عن عبد الله بن عبيد بن عمير روى عنه سلام بن مسكين سمعت أبي يقول ذلك.(@)(@@) قال أبو محمد وروى عن ابى وائل ايضا.(@)(@@)(@@)(@@) $ 1895 -(@)(@@) (430 م 6) أبو طاهر روى عن ابى يزيد المدينى روى عنه جعفر بن سليمان سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 1896 -(@)(@@) أبو طيبة الحجام قال حجمت النبي صلى الله عليه وسلم.(@)(@@) روى شريك عن ليث عن عبد الوارث عن انس قال: مربنا أبو طيبة فقلنا له من اين جئت؟ قال: حجمت النبي صلى الله عليه وسلم.(@)(@@)(@@)(@@) $ 1897 -(@)(@@) أبو طلق (1) أنه أتى النبي صلى الله عليه وسلم فقال: ما يعدل الحج؟ قال: عمرة في رمضان.(@)(@@) روى عبد الرحيم بن سليمان الرازي عن المختار بن فلفل عن طلق بن حبيب عنه.(@)(@@)(@@)(@@) $ 1898 -(@)(@@) أبو طريف روى عن النبي صلى الله عليه وسلم روى عنه الوليد ابن عبد الله بن ابى سميرة (2) سمعت 
ms2997	 ابى يقول ذلك.(@)(@@)(@@)(@@) $ 1899 -(@)(@@) أبو طعمة قارئ اهل مصر سمع ابى عمر روى عنه ابنا يزيد(@)(@@) ابن جابر وعبد الله بن عيسى وابن لهيعة سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1900 -(@)(@@) أبو طليب مولى أنس بن مالك روى عن أنس روى عنه محمد (3) ابن إسحاق سمعت أبي يقول ذلك(@)(@@)(@@)(@@) $ 1901 - أبو طارق السراج سمع سعيد بن جبير روى عنه وكيع وأبو نعيم سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1902 -(@)(@@) أبو الطيب روى عن عكرمة روى عنه شبابة.(@)(@@) نا عبد الرحمن أنا عبد الله بن أحمد [بن محمد - 4] بن حنبل فيما كتب إلي قال سألت أبي عن أبي الطيب الذى روى عن عكرمة الذى روى عنه شبابة فقال: PageV09P398(@)(@@) ارى شيخا ثقة روى ابن المبارك عن رجل عنه.(@)(@@)(@@)(@@) $ 1903 -(@)(@@) أبو طالوت روى عن أنس بن مالك عن النبي صلى الله عليه وسلم انه كان يحب القرع روى عنه معاوية بن صالح.(@)(@@)(@@)(@@) |||| باب الظاء(@)(@@)(@@)(@@) $ 1904 -(@)(@@) أبو ظبيان الازدي سمع عمر رضي الله عنه روى عنه موسى بن عبد الله بن يزيد وابو هند سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1905 -(@)(@@) أبو ظبية الكلاعى سمع معاذ [بن جبل - 1] والمقداد (2) روى عنه شهر بن حوشب ومحمد (1217 ك) بن سعد وثابت البناني سمعت أبي يقول ذلك.(@)(@@) نا عبد الرحمن أنا يعقوب [بن إسحاق - 1] فيما كتب إلي قال نا عثمان [بن سعيد - 1] قال قلت ليحيى بن معين أبو ظبية الذي يروى عنه محمد بن سعد (3) الانصاري؟ فقال ثقة.(@)(@@) نا عبد الرحمن(@)(@@) قال سئل أبو زرعة عن ابى ظبية هل يسمى قال: لا اعرف احدا يسميه.(@)(@@)(@@)(@@) |||| باب العين(@)(@@)(@@)(@@) ||||| (431 م 6) (من يكنى ابا عبد الله - 4)(@)(@@)(@@)(@@) $ 1906 - أبو عبد الله الشامي قال سمعت معاوية بن ابى سفيان يخطب وهو يقول حدثنى الانصاري يعنى زيد بن أرقم، روى عنه شعبة.(@)(@@) نا عبد الرحمن قال سألت أبي عنه فقال: لا يسمى ولا يعرف، وهو شيخ.(@)(@@)(@@)(@@) $ 1907 -(@)(@@) أبو عبد الله سمع بلالا وعبد الرحمن بن عوف [روى عنه ... - 5] سمعت أبي يقول ذلك. PageV09P399(@)(@@)(@@)(@@) $ 1908 -(@)(@@) أبو عبد الله الاشعري 
ms2998	 سمع خالد بن الوليد ويزيد بن ابى سفيان وشرحبيل ابن حسنة روى عنه أبو صالح الاشعري واسماعيل بن عبيد الله سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 1909 -(@)(@@) أبو عبد الله روى عن ابى هريرة قال: اجعل صلاتك معهم سبحة روى يحيى بن أبي كثير عن محمد بن ابراهيم عنه سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1910 -(@)(@@) أبو عبد الله روى عن ابى سعيد الخدرى عن النبي صلى الله عليه وسلم: الدينار بالدينار.(@)(@@) روى الليث بن سعد عن بكير بن عبد الله بن الاشج عنه سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1911 -(@)(@@) أبو عبد الله مولى الجندعيين روى عن أبي هريرة [روى عنه ... - 1] سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1912 -(@)(@@) أبو عبد الله الأنصاري روى عن عائشة قالت: السمر لثلاث، لمتهجد بالقرآن من الليل، أو مسافر، أو لعروس.(@)(@@) روى عنه معاوية بن صالح سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 1913 -(@)(@@) أبو عبد الله الشيباني يقال له ابن سوار وكان من شيعة علي رضي الله عنه روى عنه عاصم الاحوال سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 1914 -(@)(@@) أبو عبد الله الشرعبى سمع ثوبان روى عنه عبد القدوس بن حبيب سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1915 -(@)(@@) أبو عبد الله الحجام المكى سمع ابن عمر روى عنه عبد الله بن محمد اليمامي (2) سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 1916 -(@)(@@) أبو عبد الله الحناط (3) روى عن ابى رهم الغفاري عن ابى هريرة PageV09P400(@)(@@) عنه سعيد بن أبي هلال [سمعت ابى يقول ذلك - 1] .(@)(@@)(@@)(@@) $ 1917 -(@)(@@) أبو عبد الله (2) الاغر، ويقال أبو مسلم الاغر، و [يقال - 1] هما اثنان، ويقال اسمه وكنيته واحد (3) روى عن أبي هريرة [روى عنه ... - 4] .(@)(@@) نا عبد الرحمن قال قيل لابي: كيف حديثه؟ قال: صالح.(@)(@@)(@@)(@@) $ 1918 -(@)(@@) أبو عبد الله (432 م 6) النجرانى روى عن القاسم أبي(@)(@@) عبد الرحمن روى عنه يحيى بن حمزة وسويد بن عبد العزيز سمعت أبي يقول ذلك.(@)(@@) وسألته عنه فقال: صالح الحديث لا بأس به.(@)(@@)(@@)(@@) $ 1919 -(@)(@@) أبو عبد الله الشامي روى عن (5) [تميم الداري روى عنه ضرار بن عمرو.(@)(@@) سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1920 -(@)(@@) أبو عبد الله 
ms2999	 الشامي روى عن ... روى عنه - 4] جعفر بن سليمان سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1921 -(@)(@@) أبو عبد الله البكري روى عمن حدثه عن المقبرى روى عنه هشيم سمعت أبي يقول ذلك، وسألته عنه فقال: شيخ مجهول لا يسمى.(@)(@@)(@@)(@@) $ 1922 -(@)(@@) أبو عبد الله القزاز (6) روى عن سالم بن عبد الله روى عنه الدراوردي سمعت أبي يقول ذلك ويقول: هو مجهول.(@)(@@)(@@)(@@) $ 1923 -(@)(@@) أبو عبد الله مولى ابى موسى روى عن سعيد بن ابى الحسن روى عنه عبد ربه بن سعيد سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1924 -(@)(@@) أبو عبد الله روى عن عبيد بن ابى الجعد حديثا منقطعا [روى عنه..- 4] سمعت أبي يقول ذلك. PageV09P401(@)(@@)(@@)(@@) $ 1925 -(@)(@@) أبو عبد الله المدائني، روى يعلى بن عبيد عن سالم الانعمى عن عمرو بن هرم عن ابى عبد الله حدثه حذيفة عن النبي صلى الله عليه وسلم: اقتدوا باللذين من بعدى.(@)(@@) سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) |||||(@)(@@)(@@)(@@) $ 1926 -(@)(@@) أبو عبد الرحمن الجهنى قال سمعت النبي صلى الله عليه وسلم يقول: انى راكب غدا إلى اليهود فلا تبدؤهم بالسلام.(@)(@@) روى عنه مرثد ابن عبد الله اليزنى.(@)(@@)(@@)(@@) $ 1927 -(@)(@@) أبو عبد الرحمن حاضن عائشة قال: رأيت النبي صلى الله عليه وسلم وعائشة في ثوب واحد نصفه على النبي صلى الله عليه وسلم ونصفه على عائشة.(@)(@@) روى علي بن هاشم بن البريد عن عبد الملك بن أبي سليمان عن يحيى بن ابى محمد عنه.(@)(@@)(@@)(@@) $ 1928 -(@)(@@) أبو عبد الرحمن روى عن أبي بكر الصديق رضي الله عنه روى عنه عمرو بن دينار.(@)(@@) نا عبد الرحمن قال قرئ على العباس بن محمد الدوري قال سئل يحيى بن معين عن ابى عبد الرحمن الذي يروي عن ابى بكر يروى عنه عمرو بن دينار فقال: لا اعرفه.(@)(@@)(@@)(@@) $ 1929 -(@)(@@) أبو عبد الرحمن روى عن بلال روى (433 م 6) شعبة عن ابى بكر بن حفص عن ابى عبد الله (1) مولى لبنى مرة عن ابى عبد الرحمن قال: كنت قاعدا مع عبد الرحمن (1218 ك) بن عوف.(@)(@@) حدثنا عبد الرحمن قال قيل لابي زرعة من 
ms3000	 أبو عبد الرحمن؟ قال: لا أعرفه.(@)(@@)(@@)(@@) $ 1930 -(@)(@@) أبو عبد الرحمن الموصلي [روى عن..- 2] روى عنه موسى بن أبي عائشة سمعت أبي يقول ذلك. PageV09P402(@)(@@)(@@)(@@) $ 1931 -(@)(@@) (1) أبو عبد الرحمن الكندى شامى روى عن كثير بن مرة روى عنه معاوية بن صالح سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 1932 -(@)(@@) أبو عبد الرحمن الجبلانى [روى عن ... - 2] روى عنه أبو عبد الرحمن المرادى محمد بن عبد الرحمن مؤذن مسجد مصر سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1933 -(@)(@@) أبو عبد الرحمن روى عن الشعبي عن النعمان بن بشير عن النبي صلى الله عليه وسلم قال: لا يشكر الله من لا يشكر الناس (3) روى عنه أبو وكيع ولا يتابع في هذا (4) (5) [سمعت أبي يقول ذلك.(@)(@@) ](@)(@@)(@@)(@@) $ 1934 - أبو عبد الرحمن روى عن عبد الله بن مسعود روى عنه مسلم البطين - 6] .(@)(@@) نا عبد الرحمن قال ذكره أبي عن إسحاق بن منصور عن يحيى بن معين ان سئل فقيل له: الحديث الذى رواه ابراهيم بن المهاجر عن مسلم البطين عن أبي عبد الرحمن عن عبد الله؟ قال: كذا هو.(@)(@@) ولم يعرف ابا (7) عبد الرحمن.(@)(@@)(@@)(@@) $ 1335 -(@)(@@) أبو عبيدة بن عبد الله بن مسعود روى عن أبيه روى عنه أبو اسحاق السبيعى.(@)(@@) نا عبد الرحمن قال ذكره أبي عن إسحاق بن منصور عن يحيى بن معين قال: أبو عبيدة بن عبد الله بن مسعود ثقة.(@)(@@) نا عبد الرحمن قال سئل أبو زرعة عن اسم ابى عبيدة هذا فقال: اسمه وكنيته واحد.(@)(@@) نا عبد الرحمن سمعت أبي يقول: أبو عبيدة بن عبد الله بن مسعود لا يسمى(@)(@@)(@@)(@@) $ 1936 - (8) [أبو عبيدة بن حذيفة بن اليمان العبسي روى عن حذيفة PageV09P403(@)(@@) روى عنه يوسف بن ميمون.(@)(@@) سمعت أبي يقول ذلك.(@)(@@) سمعت أبي يقول: [لا يسمى - 1] .(@)(@@)(@@)(@@) $ 1937 -(@)(@@) أبو عبيدة بن عقبة بن نافع روى عن ابن عمر روى عنه عبد الكريم بن الحارث سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 1938 -(@)(@@) أبو عبيدة روى عن أنس روى عنه سفيان بن حسين سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1939 -(@)(@@) أبو عبيدة من آل سيرين [روى عن ... - 1] روى عنه 