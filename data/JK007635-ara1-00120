ms101	 ثلاثا وانبرت % % بهم بدن المطايا تترامى % % 28(@)(@@) % وأحالوني على آثارهم % % ما شفوا داء ولا بلوا أواما % % 29(@)(@@) % يا حداة الظعن هل من وقفة % بربى طيبة تشفي المستهاما % % 30(@)(@@) % وقفة لا أشتكي من بعدها % % لوعة البين ولا أشكو الهياما % % PageV01P352 31(@)(@@) % هي أقصى أملي لا رامة % ومنى قلبي لا دار أماما % % 32(@)(@@) % أنخ العيس بها وأقرأ على % % من به طابت صلاة وسلاما % % 33(@)(@@) % والثم الأرض لديه خاضعا % واستلم أعتابه العليا استلاما % % 34(@)(@@) % أنها حضرة قدس لم تزل % % حولها الأملاك أفواجا قياما % % 35(@)(@@) % وادع إن ناجيته مبتهلا % واخفض الصوت خشوعا واحتراما % % 36(@)(@@) % واعتصم منه بحبل إنه ال % % عروة الوثقى لمن رام اعتصاما % % 37(@)(@@) % خيرة الله الذي أرسله % % بالهدى للدين والدنيا قواما % % 38(@)(@@) % ملأ العالم نورا وسنا % وجلا عن غرة الحق ظلاما % % 39(@)(@@) % ورقى هام المعالي صاعدا % وامتطى من كاهل المجد سناما % % 40(@)(@@) % خصه الله بأسمى رتبة % جل أدنى قدرها عن أن يسامى % % PageV01P353 41(@)(@@) % ولقد أسرى به في ليلة % كان فيها للنبيين إماما % % 42(@)(@@) % ليلة ود سنى الصبح لها % % أنه في فمها كان ابتساما % % 43(@)(@@) % فاقت الأفلاك فخرا عندما % % وطئت أقدامه منهن هاما % % 44(@)(@@) % أحرز السهم المعلى إذ دنا % % قاب قوسين ولم يقرع سهاما % % 45(@)(@@) % بدأ الله به الخلق كما % % ختم الله به الرسل الكراما % % 46(@)(@@) % حاز أصناف المعالي قدره % % وحوى الآخر منها والقدامى % % 47(@)(@@) % وأتانا بكلام معجز % أفحم المنطيق إن رام الكلاما % % 48(@)(@@) % فضلت آياته إذ نسقت % % نسقا يهزأ بالدر نظاما % % 49(@)(@@) % فانثنى عنهامقرا أن في % % أنفه الرغم وفي فيه الرغاما % % 50(@)(@@) % يا لها أحكام حق أحكمت % % لا يرى عقد لأ ليها انفصاما % PageV01P354 51(@)(@@) % ولكم من معجز أظهره % % لم يدع للحق في الخلق اكتتاما % % 52(@)(@@) % يا رسول الله يا أكرم من % % أغدقت سحب أياديه الأناما % % 53(@)(@@) % يا منيل المرتجي من جوده % % نعما غرا وآمالا وساما % % 54(@)(@@) % جد لراجيك بما أمله % % وأنله ماله أم وراما % % 55(@)(@@) % وانتقذني من يد البين الذي % % شف جسمي وبرى مني العظاما % % 56(@)(@@) % وبأرض الهند طالت غيبتي % % إنها ساءت مقرا 
ms102	 ومقاما % % 57(@)(@@) % فمتى أرحل عنها قاصدا % ربعك المأنوس والبيت الحراما % % 58(@)(@@) % أولني يا خير من أولى يدا % منك قربا يبرئ الداء العقاما % % 59(@)(@@) % وأقلني عثرات لم أزل % % ساعيا في كسبها خمسين عاما % % 60(@)(@@) % ثم كن لي من ذنوبي شافعا % يوم يقضي الله عفوا وانتقاما % % PageV01P355 61(@)(@@) % وصلاة الله تترى دائما % وتغشاك مدى الدهر دواما % % 62(@)(@@) % وتعم الآل والصحب الألى % % بعلاهم نهض الحق وقاما % % PageV01P356 البحر : طويل 1(@)(@@) % لقد آن أن تثني أبي زمامها % % وتسعف مشتاقا برد سلامها % % 2(@)(@@) % سلام عليها كيف شطت ركابها % % وأنى دنت في سيرها ومقامها % % 3(@)(@@) % حملت تمادي صدها حين كان لي % % قوى جلد لم أخش بث التئامها % % 4(@)(@@) % وكنت أرى أن الصدود مودة % ستدلي بقرب الود بعد انصرامها % % 5(@)(@@) % فأما وقد أورى الهوى بجوانحي % % جوى غلة لم يأن بل أوامها % % 6(@)(@@) % فلست لعمري بالجليد على النوى % % وهل بعدها للنفس غير حمامها % % 7(@)(@@) % إذا قلت هذا آن تنعم بالرضا % % يقول العدى هذا أوان انتقامها % % 8(@)(@@) % أطارحها الواشون أني سلوتها % % وها أنا قد حكمتها في احتكامها % % 9(@)(@@) % أبى القلب إلا أوبة لعهودها % % وحفظا لها في ألها وذمامها % % 10(@)(@@) % يسفهني فيها وشاة ولوم % ومن سفه إفراطها في ملامها % % PageV01P357 11(@)(@@) % وهل طائل في أن يلوم على الهوى % % طليق وقلبي موثق بغرامها % % 12(@)(@@) % وأتعب من رام العذول سلوه % % محب يرى نيل المنى في التزامها % % 13(@)(@@) % وإني بعد الوصل أرجو لقاءها % % لماما ولكن كيف لي بلمامها % % 14(@)(@@) % أحب لريا نشرها كل نفحة % تمر بنجد أو خزامى خزامها % % 15(@)(@@) % سقى أرض نجد كل وطفاء ديمة % وما أرضها لولا محط خيامها % % 16(@)(@@) % أجل وسقى تلك الربوع لأجلها % % وأغدق مرعى رندها وبشامها % % 17(@)(@@) % هوى أنشأته المالكية لم يزل % % وثيقا على حل العرى وانفصامها % % 18(@)(@@) % فهل علمت أن الهوى ذلك الهوى % % وأن فؤادي فيه طوع زمامها % % 19(@)(@@) % ولم يبق مني الوجد غير حشاشة % تراد على توزيعها واقتسامها % % 20(@)(@@) % كفاك فحسبي من زماني خطوبه % % فإن فؤادي عرضة لسهامها % % PageV01P358 21(@)(@@) % أساور منها كل يوم وليلة % % صروفا قعود الجد دون قيامها 
ms103	 % % 22(@)(@@) % إلى الله أشكوها حوادث لم تزل % % تروع حتى مقلتي في منامها % % 23(@)(@@) % ولولا رجائي في أجل مؤمل % % رجوت لنفسي منه برء سقامها % % 24(@)(@@) % إذن لقضى خطب الزمان وصرفه % % عليها وأمست في إسار لزامها % % 25(@)(@@) % هو الأبلج الوضاح أشرق نوره % % فجلى عن الدنيا قتام ظلامها % % 26(@)(@@) % أجل ذوي العليا وواحد فخرها % % وأكرم أهليها ومولى كرامها % % 27(@)(@@) % حمى حوزة المجد المؤثل والعلى % % فأصبح من عليائها في سنامها % % 28(@)(@@) % وقام بأعباء الشريعة ناهضا % فأيدها في حلها وحرامها % % 29(@)(@@) % به أينعت روض الندى وتهدلت % % فروع العلى وانهل صوب غمامها % % 30(@)(@@) % فتى لا يرى الأموال إلا لبذلها % % إذا ما رآها غيره لاغتنامها % % PageV01P359 31(@)(@@) % له منن يربو على الحصر عدها % % غدا كل راج سارحا في سوامها % % 32(@)(@@) % نمته سراة من ذؤابة هاشم % رقت شامخات المجد قبل فطامها % % 33(@)(@@) % ولاحت نجوما في سماء فخارها % % فأشرق فيها وهو بدر تمامها % % 34(@)(@@) % أمولى الموالي شيخها وغلامها % % ورب المعالي فذها وتؤامها % % 35(@)(@@) % رقيت من العلياء أرفع ذروة % مقام ذكاء والبدر دون مقامها % % 36(@)(@@) % فأصبح لا يرجو لحاقك لاحق % بعلياك إلا شانها باهتضامها % % 37(@)(@@) % فدتك أناس أنت أول عزها % % ودولة قوم كنت بدء قوامها % % 38(@)(@@) % يناويك فيها جاهل كل همه % % دراكك في سبل العلى واقتحامها % % 39(@)(@@) % وهيهات كم جاراك جهلا عصابة % فخلفتها آنافها في رغامها % % 40(@)(@@) % وكم غابط نعماك لج بجهله % % ضلالا وقد أوردته من جمامها % % PageV01P360 41(@)(@@) % فأغضيت عنه صافحا متفضلا % وعادت عليه هاطلات انسجامها % % 42(@)(@@) % وإني على ما قد جنيت لواثق % بسهل السجايا منك لا بعرامها % % 43(@)(@@) % فهل تسعفني من رضاك بنظرة % تنال بها الآمال اقصى مرامها % % 44(@)(@@) % يكاد يحل اليأس نفسي لما بها % % إذا نظرت فيما جنت باجترامها % % 45(@)(@@) % وتطمعني أخلاقك الغر أنها % % رياض زهت أنوارها في كمامها % % 46(@)(@@) % فكيف وقد منيتني منك منية % بوعد أرى كل المنى في استلامها % % 47(@)(@@) % وأنك ممن يسبق القول فعله % % وكم من رجال فعلها في كلامها % % 48(@)(@@) % وقربي إليك الدهر أقصى مطالبي % % وإن كثرت من روقها ووسامها % % 49(@)(@@) % فخذها نظام الدين وابن 
ms104	 نظامه % % محبرة تزهو بحسن نظامها % % 50(@)(@@) % ضننت بها عن كل سمع وإنما % % مديحك كان اليوم فض ختامها % % PageV01P361 البحر : بسيط تام 1(@)(@@) % صحت لصحتك العلياء والكرم % % وأصبح المجد بعد الروع يبتسم % % 2(@)(@@) % وأسفرت أوجه الامال ضاحكة % واستبشرت بشفا عليائك الأمم % % 3(@)(@@) % وأصبح الدست مملوءا سنى قمر % % تجلى بطلعته الأحلاك والظلم % 4(@)(@@) % يفديك كل مفدى في عشيرته % % ويمرض الضر من يشناك والشقم % % 5(@)(@@) % لا جاوزت سوحك العلياء قط ولا % % عدت نواحيك الأفراح والنعم % 6(@)(@@) % ولا برحت مدى الأيام في نعم % مؤملا يمترى من كفك الكرم % PageV01P362 البحر : بسيط تام 1(@)(@@) % مهلا سقتك الغوادي هاطل الديم % % من ذا يباريك في قول وفي حكم % 2(@)(@@) % نطمت قسرا نجوم الافق في نسق % ورمت نظمي وأين الأفق من كلمي % % 3(@)(@@) % ما الدر في نسق والبدر في أفق % والليث في نقم والغيث في كرم % % 4(@)(@@) % أبهى نظاما وأسنى منك مطلعا % % أدهى انتقاما وأجدى منك في نعم % % 5(@)(@@) % فهل لمن رام أن يحكي علاك علا % في مثل هذي المساعي الغر من قدم % % 6(@)(@@) % إن رمت فخرا فقل ما شئت من همم % أو رمت مشيا فطأ ما شئت من قمم % PageV01P363 البحر : بسيط تام 1(@)(@@) % ما نفثه السحر إلا شعرك السامي % % يا من علا كل نثار ونظام % 2(@)(@@) % لأنت أفصح من لاقيت من يمن % ومن شآم على الاطلاق يا شامي % % PageV01P364 البحر : بسيط تام 1(@)(@@) % دع الندامة لا يذهب بك الندم % % فلست أول من زلت به قدم % % 2(@)(@@) % هي المقادير والأحكام جارية % وللمهيمن في أحكامه حكم % 3(@)(@@) % خفض عليك فما حال بباقية % هيهات لا نعم تبقى ولا نقم % % 4(@)(@@) % قد كنت بالأمس في عز في دعة % حيث السرور وصفوا العيش والنعم % % 5(@)(@@) % واليوم أنت بدار الذل ممتهن % صفر اليدين فلا بأس ولا كرم % 6(@)(@@) % كأن سيفك لم تلمع بوراقه % % وغيث سيبك لم تهمع له ديم % % 7(@)(@@) % ما كان أغناك عن حل ومرتحل % لولا القضاء وما قد خطه القلم % 8(@)(@@) % يا سفرة أسفرت عن كل بائقة % لا أنتجت بعدك المهرية الرسم % % 9(@)(@@) % حللت 
ms105	 في سوح قوم لا خلاق لهم % % سيان عندهم الأنوار والظلم % 10(@)(@@) % تسطو بأسد الشرى فيها ثعالبها % % والصقر تصطاده الغربان والرخم % % PageV01P365 11(@)(@@) % ويفضل الغمد يوم الفخر صارمه % % وتستطيل على ساداتها الخدم % 12(@)(@@) % إن لم يبن لهم فضلي فلا عجب % فليس يطرب شاد من به صمم % % 13(@)(@@) % أو أنكروا في العلى قدري فقد شهدت % % حتما بما أنكروه العرب والعجم % 14(@)(@@) % ما شان شأني مقامي بين أظهرهم % % فالتبر في الترب لم تنقص له قيم % 15(@)(@@) % لا تعجبوا لهمومي إن برت جسدي % % وأصبحت نارها في القلب تضطرم % 16(@)(@@) % فهم كل امرئ مقدار همته % % وليس يفترقان الهم والهمم % 17(@)(@@) % لا كان لي في رقاب المعتفين يد % ولا سعت بي إلى نحو العلى قدم % % 18(@)(@@) % إن لم أشق عباب البحر ممتطيا % هوجاء ليس لها عقل ولا خطم % 19(@)(@@) % أما الركاب فقد أوليتهن قلى % والخيل لا قرعت أشداقها اللجم % 20(@)(@@) % ما زلت أطوي عليها كل مقفرة % % يهماء لا نصب فيها ولا علم % % PageV01P366 21(@)(@@) % فلم أنل عندها مما أؤمله % % إلا أماني نفس كلها حلم % 22(@)(@@) % يا للرجال لخطب جل فادحه % % حتى المعارف ضاعت عندها الذمم % 23(@)(@@) % ما إن وثقت بخل أو أخي ثقة % إلا دهاني بخطب شره عمم % 24(@)(@@) % وكل ذي رحم أوليته صلة % شكت إلى ربها من قطعه الرحم % 25(@)(@@) % هذا ابن أمي الذي راعيت قربته % % ما كان عندي بسوء الظن يتهم % % 26(@)(@@) % أدنيته نظرا مني لحرمته % % وذو الديانة للأرحام يحترم % 27(@)(@@) % أضحى لعرضي مع الأعداء منتهكا % وراح للمال قبل الناس يلتهم % % 28(@)(@@) % ما صان لي نسبا يوما ولا نشبا % ولا رعى لي عهودا نقضها يصم % 29(@)(@@) % قد كنت أحسبه بالغيب يحفظني % % ولو زواني عنه الموت والعدم % % 30(@)(@@) % حتى إذا غبت عنه قام منتهبا % داري وراح لما خلفت يغتنم % PageV01P367 31(@)(@@) % تالله ما فعل الأعداء فعلته % % كلا ولا اهتضموا ما ظل يهتضم % % 32(@)(@@) % هلا نهاه نهاه أو حفيظته % % عن سلب ما حلي النسوان والحرم % % 33(@)(@@) % وافى بهن وما أوفى بذمته % % سلبا عواطل لا سور ولا خدم % % 34(@)(@@) % أين 
ms106	 الفتوة إن لم ينهه ورع % ولم يخف غب ما قد راح يجترم % % 35(@)(@@) % هبه أضاع إخائي غير محتشم % أليس عن دون هذا المرء يحتشم % % 36(@)(@@) % كأنه كان مطويا على إحن % فعندما غبت عنه راح ينتقم % % 37(@)(@@) % ما كان هذا جزائي إذ رعيت له % % حق الاخاء ولكن للورى شيم % 38(@)(@@) % فقل سلام على الأرحام ضائعة % فقد لعمري أضاعت حقها الأمم % PageV01P368 البحر : بسيط تام 1(@)(@@) % يا قائلا إن القشر البن قد حرما % % لكونه مفسدا عقل الذي طعما % % 2(@)(@@) % إفساده العقل ممنوع كما شهدت % به التجارب فاسأل من به علما % % 3(@)(@@) % وإن بتحريمه أفتى مكابرة % أبو كثير فدعه والذي زعما % % 4(@)(@@) % فليس تحريمه يوما بضائرنا % % إذ كان إفساده للعقل قد عدما % % 5(@)(@@) % وما يحلل شيئا أو يحرمه % % إلا الذي خلق الأشياء لا العلما % % PageV01P369 البحر : بسيط تام 1(@)(@@) % ليقعد الدهر بي ما شاء وليقم % % ليس التضاؤل للأهوال من شيمي % % 2(@)(@@) % ما جرد الدهر عضبا من فوادحه % % إلا وجردت عضبا من شبا همي % % 3(@)(@@) % كم عاذر عاذل في الدهر قلت له % % أقصر فليتك لم تعذر ولم تلم % 4(@)(@@) % غيري لتهدي الليالي ولتضل به % % فلست منها على حال بمتهم % % 5(@)(@@) % أنضو الليالي وتنضوني منادمة % وما قرعت بها سنا من الندم % % 6(@)(@@) % فقل لمن سامني صبرا على مضض % من القطيعة عمدا غير محتشم % % 7(@)(@@) % لا تحسبني وإن ألفيتني سلما % يوما بمستسلم للحادث العمم % 8(@)(@@) % لئن صدعت صفاة الشمل مجتهدا % فما عطفت على قربى ولا رحم % % 9(@)(@@) % ماذا على الفرع خانته الأصول إذا % % تأصل الفرع بين المجد والكرم % PageV01P370 البحر : منسرح 1(@)(@@) % عارضه السندسي من رقمه % % وثغره اللؤلؤي من نظمه % 2(@)(@@) % ومن كسا الأرجوان وجنته % % وأكسب الأقحوان مبتسمه % 3(@)(@@) % ومن أعار الصباح طلعته % % فلاح يجلو عن أفقه ظلمه % 4(@)(@@) % وأرقم الصدغ والعذار على % % صفحة خديه من برى قلمه % % 5(@)(@@) % محجب إن بدت محاسنه % % هفت عليه القلوب مزدحمه % % 6(@)(@@) % لو لم يكن في صفاته علما % ما نشر الحسن فوقه علمه % 7(@)(@@) % لم أنس إذ زارني بلا عدة % في ليلة بالسعود 
ms107	 مبتسمه % 8(@)(@@) % فبت فيها بالوصل مبتهجا % وأنفس الكاشحين مضطرمه % 9(@)(@@) % ولم يزل والمدام يعطفه % % علي عطفا حتى لثمت فمه % 10(@)(@@) % فذقت ماء الحياة من برد % لم يخش فقد الحياة من لثمه % PageV01P371 11(@)(@@) % وبات والسكر قد أطاف به % % يظهر لي من هواه ما كتمه % 12(@)(@@) % حتى بدا الصبح فانثنى عجلا % لم يش واش به ولا اتهمه % 13(@)(@@) % أقسم بالليل من ذوائبه % % والصبح من فرقه إذا قسمه % 14(@)(@@) % ما طاب بعد استماع منطقه % % لمسمعي من محاور كلمه % % 15(@)(@@) % سوى كلام لسيد سند % حاز العلى والفخار والعظمه % 16(@)(@@) % لا سيما شعره الذي اطردت % % أبياته بالبيان منسجمه % % 17(@)(@@) % كأنه الدر ضمه نسق % أو الدراري في الأفق منتظمه % % 18(@)(@@) % إن يصغ يوما إليه ذو صمم % أزال عنه بلطفه صممه % % 19(@)(@@) % يا سيدا جل قدره فسمت % % صفاته بالكلام متسمه % % 20(@)(@@) % ويا شريفا حلت شهامته % % بكل مجد ومفخر شيمه % PageV01P372 21(@)(@@) % شنفت سمعي بنظم قافية % لو باهت الدر أرخصت قيمه % % 22(@)(@@) % فلا عد منا بلاغة نسقت % % منه المعاني وأبدعت حكمه % 23(@)(@@) % لا زلت في عزة وفي دعة % وصولة من عداك منتقمه % % 24(@)(@@) % ما أودع السحر في بلاغته % % وضمن الدر شاعر كلمه % PageV01P373 البحر : طويل 1(@)(@@) % سرت نفحة من حيهم بسلام % % فأحيت بما حيت صريع غرام % 2(@)(@@) % لئن نقعت من لاعج الوجد غلة % فمن بعد ما أروت لهيب أوام % % 3(@)(@@) % أحيت براح أم بريا تحية % سكرت بها سكري بكاس مدام % 4(@)(@@) % سرت قبل مسراها الصبا بشميمها % % فأزرت بعرفي عبهر وخزام % % 5(@)(@@) % ووافى شذاها بالشفاء لمدنف % من الشوق مغلول الجوانح ظامي % % 6(@)(@@) % ولما دنت مني حللت لها الحبى % % وبادرت إعظاما لها بقيام % 7(@)(@@) % ومطت قناع الطرس عن ضوء حسنها % % فنار بها ربعي وضاء مقامي % % 8(@)(@@) % فشنفت سمعي من فرائد لفظها % % بجوهر أسلاك ودر نظام % 9(@)(@@) % وقلدت جيدي من تقاصير نظمها % % عقود لآل فذة وتؤام % 10(@)(@@) % ولم أدر ما أهداه لي حسن سجعها % % أرنة شاد أم هديل حمام % % PageV01P374 11(@)(@@) % كأن معانيها بحالك نقسها % % بدور تمام في بهيم ظلام % % 12(@)(@@) % كأن مبانيها مباسم 
ms108	 غادة % نضت عن لآليها فضول لثام % % 13(@)(@@) % كأن قوافيها أزاهر روضة % تبسمن صبحا عن ثغور كمام % % 14(@)(@@) % وما بالها لا تجمع الحسن كله % % وقد بلغت في الحسن كل مرام % % 15(@)(@@) % ولا غرو أن أربت على القول أنها % % كلام ملوك أو ملوك كلام % % 16(@)(@@) % فيا سيدا مذ غالني الدهر قربه % % وقفت عليه لوعتي وهيامي % % 17(@)(@@) % تحدر دمعي مذ تذكر عهده % % تحدر قطر من متون غمام % 18(@)(@@) % وأصبحت الأحشاء من فرط شوقه % % تشب لظى نيرانها بضرام % % 19(@)(@@) % بعثت بأبيات من الشعر أصبحت % تمائم جيدي بل شفاء سقامي % % 20(@)(@@) % أبنت بها عن لهجة هاشمية % ملكت بها للقول كل زمام % % PageV01P375 21(@)(@@) % توارثتها عن عصبة مضرية % مداره فصح منجبين كرام % % 22(@)(@@) % وضمنتها من خالص الود نفثة % شحذت بها عضبي ورشت سهامي % % 23(@)(@@) % وإن كنت أضمرت السكوت تحية % % فحسبي سكوت ناطق بذمامي % % 24(@)(@@) % فلا برحت تغشاك مني رسائل % بنشر ثناء أو بطيب سلام % 25(@)(@@) % أحيي به ذاك المحيا وإنما % % أحيي به والله بدر تمام % PageV01P376 البحر : طويل 1(@)(@@) % بكيت لبرق لاح بالثغر باسمه % % فكانت جفوني لا السحاب غمائمه % % 2(@)(@@) % أما والهوى لولا تساجم عبرتي % % لما لام قلبي في الصبابة لائمه % 3(@)(@@) % كتمت خفايا الحب بين جوانحي % % فنمت دموعي بالذي أنا كاتمه % % 4(@)(@@) % ومن يمسك الأجفان وهي سحائب % إذا لمعت لمع البروق مباسمه % % 5(@)(@@) % خليلي قد أبرمتماني ملامة % وألمتما قلبي بما لا يلائمه % % 6(@)(@@) % كأني بدع في ملابسه الهوى % % ولم يك قبلي مغرم القلب هائمه % 7(@)(@@) % ترومان من قلبي السلو جهالة % بما أنا من سر المحبة عالمه % % 8(@)(@@) % وكيف سلوي من ألفت وإننا % % لإلفان مذ نيطت بكل تمائمه % 9(@)(@@) % سقى الله أيامي بمكة والصبا % % تفتح عن نور الشباب كمائمه % % 10(@)(@@) % وحيا الحيا ربع الهوى بسويقة % % وجاد بأجياد من الدمع ساجمه % % PageV01P377 11(@)(@@) % ليالي أغفو في ظلال بشاشة % ولم ينتبه من حادث الدهر نائمه % % 12(@)(@@) % هنالك لا ظبي الصريم مصارم % ولا جذ حبل الوصل من هو صارمه % 13(@)(@@) % أجر ذيولي في بلهنية الصبا % % وروض شبابي ناضر الغصن ناعمه % % 14(@)(@@) % يواصلني 
ms109	 بدر إذا تم ضوؤه % % يواريه من ليل الذوائب فاحمه % 15(@)(@@) % وكم ليلة وافى على حين غفلة % فبت بها حتى الصباح أنادمه % % 16(@)(@@) % وأفرشته مني الترائب والحشا % % وبات وسادي زنده ومعاصمه % 17(@)(@@) % ونحى للثمي عن لماه لثامه % % ولم أدر غيري بات والبدر لاثمه % % 18(@)(@@) % فبتنا كما شاء الغرام يلفنا % % هوى وتقى لا تستحل محارمه % 19(@)(@@) % إلى حين هبت نسمة الفجر وانبرت % % تجر ذيولا في الرياض نسائمه % % 20(@)(@@) % وسل على الليل الصباح حسامه % % فقامت حمامات الغصون تخاصمه % % PageV01P378 21(@)(@@) % فقمنا ولم يعلق بنا ظن كاشح % ولا نطقت عنا لواش نمائمه % % 22(@)(@@) % نعم قد صفا ذاك الوصال وقد عفا % % ولم تعف آثار الهوى ومعالمه % % 23(@)(@@) % إليك نصير الدين بحت بلوعة % براني بها برد الهوى وسمائمه % % 24(@)(@@) % ولولا اعتقادي صدق ودك لم أبح % % بما لست أرضى أن غيرك واهمه % 25(@)(@@) % لعمري لأنت الصادق الود والذي % % تصدقني فيما ادعيت مكارمه % % 26(@)(@@) % وأنك فرد في زمان غدت به % % عن الخير عجما عربه وأعاجمه % % 27(@)(@@) % إلى الله أشكو منهم عهد معشر % تحايد عن حفظ الذمام ذمائمه % 28(@)(@@) % إذا سر منهم ظاهر ساء باطن % تدب إلى نهش الصديق أراقمه % 29(@)(@@) % عجمتهم عجم المثقف عوده % % فما ظفرت كفي بصلب معاجمه % 30(@)(@@) % فأعرضت عنهم طاويا كشح غائر % على الود مني أن تذل كرائمه % PageV01P379 31(@)(@@) % فحسبي نصير الدين في الدهر ناصرا % على الدهر إن أنحت علي مظالمه % 32(@)(@@) % لقد ظفرت كفاي منه بماجد % فواتحه محمودة وخواتمه % % 33(@)(@@) % فتى ثاقب الآراء طلاع أنجد % حميد المساعي مبرمات عزائمه % 34(@)(@@) % له خلق كالروض يعبق نشره % % وتفتر عن غر السجايا بواسمه % 35(@)(@@) % هو الخضر الأكناف والخضرم الذي % % يرى مثلا كل الخضارم عائمه % % 36(@)(@@) % وزير له دست الوزارة قائم % وعرش المعالي أيدات قوائمه % 37(@)(@@) % إذا صاول الأبطال شاهدت صائلا % تزيد على المريخ سطوا صوارمه % 38(@)(@@) % وإن نافث الكتاب ألفيت كاتبا % عطارد في فن الكتابة خادمه % % 39(@)(@@) % إذا ما امتطت متن اليراع بنانه % % حوى قصبات السبق ما هو راقمه % % 40(@)(@@) % فيهزأ بالمنثور ما هو ناثر % ويزري بنظم الدر 
ms110	 ما هو ناظمه % PageV01P380 41(@)(@@) % به أنجبت أبناء فارس فارسا % تقدت به خيل العلى ورواسمه % 42(@)(@@) % أقر له بالسبق سباق غاية % وأعظمه من كل حي أعاظمه % % 43(@)(@@) % بنى لهم بيتا من المجد باذخا % له شرف باق رفيع دعائمه % % 44(@)(@@) % إلى مكرمات كالشموس منيرة % تجلى بها من كل ليل أداهمه % 45(@)(@@) % فلله هاتيك المكارم إنها % % علائم مكنون العلى وعيالمه % % 46(@)(@@) % ولله هاتيك الشمائل إنها % % نوافج طيب نشرتها الطائمه % 47(@)(@@) % أتتني نصير الدين منك قصيدة % تبارى فرادى الدهر منها توائمه % % 48(@)(@@) % تأرج ربعي من ذكا طيب نشرها % % وفاحت علينا من شذاها نواسمه % % 49(@)(@@) % كأن سحيق المسك كان مدادها % % ومن عذب الريحان كانت مراقمه % 50(@)(@@) % نشرت بها برد الشباب على امرىء % - وحقك - لا تثنيه عنك لوائمه % % PageV01P381 51(@)(@@) % يصافيك ودا لو مزجت بعذبه % % أجاجا حلت للشاربين علاقمه % 52(@)(@@) % ويوليك عهدا لا انفصام لعقده % % ولو بلغ المجهود في السعي فاصمه % % 53(@)(@@) % فكن واثقا مني بأوثق ذمة % يلازمني فيها الوفا وألازمه % % 54(@)(@@) % فلست كمن يحلو لدى الود قوله % % وتشجى بمر الفعل مني حلاقمه % % 55(@)(@@) % فإن شئت فاخبرني على كل حالة % % تجد سيف صدق لا يخونك قائمه % % 56(@)(@@) % أبى أن يلم الغدر مني بساحة % على نسب طالت فروعا جراثمه % % 57(@)(@@) % عزاه إلى العليا لؤي بن غالب % وعبد مناف ذو العلاء وهاشمه % % 58(@)(@@) % وشيبة ذو الحمد الذي وطئت به % % عشائره فوق السها وأقاومه % 59(@)(@@) % وذو المجد عبد الله أكرم والد % لأكرم مولود نمته أكارمه % 60(@)(@@) % وأحمد خير المرسلين وصنوه % علي أبو ريحانتيه وفاطمه % PageV01P382 61(@)(@@) % وأبناؤه الغر الجحاجحة الألى % % بهم أكمل الدين الإلهي خاتمه % 62(@)(@@) % هم سادة الدنيا وساسة أهلها % % فمن ذا يناوي فخرهم ويقاومه % 63(@)(@@) % عليهم سلام الله ما هل عارض % وما شام برق بالأبيرق شائمه % PageV01P383 البحر : مجزوء الكامل 1(@)(@@) % يا أيها المولى الذي % % هو في معارفه علم % 2(@)(@@) % لله تحفتك التي % % من ليس يقبلها ظلم % 3(@)(@@) % فكأنها في فضلها % % نار تلوح على علم % 4(@)(@@) % أبياتها بمدادها % % تحكي الكواكب في الظلم % % 5(@)(@@) % لم يحو طرس مثلها % % كلا ولا رقم 
ms111	 القلم % % 6(@)(@@) % مني السلام عليك ما % % غنى الحمام بذي سل % % PageV01P384 البحر : مجزوء الكامل 1(@)(@@) % حيا بكأس من مدام % % عذب اللمى لدن القوام % % 2(@)(@@) % وجلا لنا لما انجلى % % شمس الضحى بدر التمام % % 3(@)(@@) % وسرت مهيمنة الصبا % % تهدي لنا نشر الخزام % 4(@)(@@) % وترنحت عذب الربى % % طربا لترجيع الحمام % 5(@)(@@) % وتبسم الروش الندي % % وقد بكت عين الغمام % % 6(@)(@@) % وسرى وميض البرق يل % % مع في الدجى لمع الحسام % % 7(@)(@@) % فارقت مضمضمة الكرى % % وأرقت من ضوء المدام % 8(@)(@@) % طاب السهاد لمقلتي % % فسلوت عن طيب المنام % 9(@)(@@) % وسرى يحث كؤوسه % % ساق يجل عن الكلام % % 10(@)(@@) % من ورد مبسمه شفاي % ومن لواحظه سقامي % % PageV01P385 11(@)(@@) % ما زال ينقع من مرا % % شفه وأكؤسه أوامي % % 12(@)(@@) % حتى رضيت عن الهوى % % وحمدت عاقبة الغرام % PageV01P386 البحر : خفيف تام 1(@)(@@) % زف يا ابن الكرام بنت الكروم % فهي شمس قد رصعت بالنجوم % % 2(@)(@@) % واسقنيها - سقيتها - في زمان % يضحك الروض من بكاء الغيوم % % 3(@)(@@) % وأدرها علي في الكأس صرفا % فعليها ضمان صرف الهموم % 4(@)(@@) % هي برء الأسى وداعي التصابي % % وسرور الفتى وسر النعيم % % 5(@)(@@) % عصرت من قديم عهد وجاءت % % وهي تروي حديث عصر قديم % 6(@)(@@) % ما تجلت في الكأس إلا وجلت % % عن سماء الهنا غمام الغموم % % 7(@)(@@) % كلما عبس النديم إليها % % ضحكت من سرورها للنديم % 8(@)(@@) % لو أضل السراة سبل هداهم % % لهدتهم في جنح ليل بهيم % % 9(@)(@@) % أشرقت للعقول يا صاح نورا % وأضاءت نارا لموسى الكليم % 10(@)(@@) % عاطنيها ولا تقل هي إثم % إنما الاثم من شراب الأثيم % PageV01P387 11(@)(@@) % أكثر اللائم المعنف فيها % % ليس مثلي في شربها بملوم % % 12(@)(@@) % نحن منها على مقام من % % الأنس مقيمون في نعيم مقيم % % 13(@)(@@) % عقلت من عقول قوم فزاغوا % % بضلال عن نهجها المستقيم % 14(@)(@@) % أنكر الجاهلون منها رموزا % جهلوا علمها بفهم سقيم % % 15(@)(@@) % وعلى سلبها الوقار فكم % % أهدت ثباتا إلى الوقار الحليم % % 16(@)(@@) % وأذمت كرام قوم فذمت % % وذمام الكرام غير ذميم % PageV01P388 البحر : سريع 1(@)(@@) % هاتا أعيدا لي حديثي القديم % % أيام وسمي بالتصابي وسيم % % 2(@)(@@) % وعللاني بنسيم الصبا % % إن كان يستشفي 
ms112	 عليلا سقيم % 3(@)(@@) % لله أيامي بسفح اللوى % % إذ كنت الهوى في ظلال النعيم % 4(@)(@@) % بانت فبان الصبر من بعدها % % فمدمعي غاد وحزني مقيم % 5(@)(@@) % وشادن غر بأمر الهوى % % قريب عهد جيده بالتميم % 6(@)(@@) % يرتع لهوا في نعيم الصبا % % وعاشقوه في العذاب الأليم % 7(@)(@@) % العين ترعى منه في جنة % والقلب من إعراضه في جحيم % % 8(@)(@@) % إذا بدا في شعره خلته % % شمس الضحى فر جنح ليل بهيم % % 9(@)(@@) % أرعى له العهد وكم ليلة % حليت من ذكراه كأس النديم % 10(@)(@@) % فليتني إذ لم يزرني سوى % % خياله من بعض أهل الرقيم % % PageV01P389 11(@)(@@) % ولائم لام على حبه % % جهلا بأهل الحب وهو المليم % % 12(@)(@@) % يروم مني الغدر فيه وما % % ذمام عهدي في الهوى بالذميم % % 13(@)(@@) % صم صدى العاذل في حب من % % أسكنته من مهجتي في الصميم % 14(@)(@@) % فليت شعري هل درى من به % % قد هام واستسلم قلبي السليم % % 15(@)(@@) % أني أصبحت به شاعرا % أنظم فيه كل عقد نظيم % % 16(@)(@@) % لكنني لست وإن ظن بي % % بشاعر في كل واد أهيم % 17(@)(@@) % ونفحة هبت لنا موهنا % يا حبذا نفحة ذاك النسيم % % 18(@)(@@) % مرت بأكناف ربى حاجر % فأرجت أرجاءها بالشميم % 19(@)(@@) % تروي حديث الحب لي مسندا % عن رامة عن ريم ذاك الصريم % % 20(@)(@@) % بالله خبر يا نسيم الصبا % % كيف اللوى بعدي وكيف الغميم % % PageV01P390 21(@)(@@) % هل خفر العهد أهيل الحمى % % بعدي أم يرعون عهدي القديم % PageV01P391 البحر : سريع 1(@)(@@) % وليلة عانقت في جنحها % % ثالثة الشمس وبدر التمام % % 2(@)(@@) % فلم يطب لي ضمها ساعة % حتى ضممت السيف عند المنام % 3(@)(@@) % فاستنكرت ضمي له بيننا % % وقد صفا الوصل وطاب اللزام % 4(@)(@@) % قالت فدتك النفس من حازم % ما تصنع الان بهذا الحسام % % 5(@)(@@) % يغنيك عنه لا خشيت العدى % % مهند اللحظ ورمح القوام % % PageV01P392 البحر : طويل 1(@)(@@) % وأبرزتها بطحاء مكة بعدما % % أصات المنادي بالصلاة فأعتما % % 2(@)(@@) % فضوأ أكناف الحجون ضياؤها % % وأشرق بين المأزمين وزمزما % % 3(@)(@@) % ولما سرت للركب نفحة طيبها % % تغنى لها حاديهم وترنما % % 4(@)(@@) % وشام محياها الحجيج على السرى % % فيمم مغناها ولبى وأحرما % % 5(@)(@@) % فتاة 
ms113	 هي الشمس المنيرة في الضحى % % ولكنها تبدو إذا الليل أظلما % % 6(@)(@@) % تعلم منها الغصن عطفة قدها % % وما كان أحرى الغصن أن يتعلما % % 7(@)(@@) % وأسفر عنها الصبح لما تلثمت % % ولو أسفرت للصبح يوما تلثما % % 8(@)(@@) % إذا ما رنت لحظا وماست تأودا % فما ظبية الجرعا وما بانة الحمى % % 9(@)(@@) % تراءت على بعد فكبر ذو التقى % % ولاحت على قرب فصلى وسلما % % 10(@)(@@) % وكم حللت بالصد قتل أخي الهوى % % وكان يرى قتل الصدود محرما % % PageV01P393 11(@)(@@) % وظنت فؤادي خاليا فرمت به % % هوى عاد دائي منه أدهى وأعظما % % 12(@)(@@) % ولو أنها أبقت علي أطقته % % ولكنها لم تبق لحما ولا دما % % PageV01P394 البحر : وافر تام 1(@)(@@) % إلام تطيل نوحك يا حمام % % ولا وجد عراك ولا غرام % 2(@)(@@) % تبيت على الغصون حليف شجو % تطارحني كأنك مستهام % 3(@)(@@) % وما صدعت لك البرحاء قلبا % ولا أودى بمهجتك الهيام % % 4(@)(@@) % ولو صاليت نار الشوق أمسى % % على خديك للدمع انسجام % % 5(@)(@@) % وما بك بعض ما بي غير أني % % آلام على البكاء ولا تلام % 6(@)(@@) % وكابدت النوى عشرين عاما % ويوم من نوى الأحباب عام % 7(@)(@@) % أحن إلى الخيام وإن قلبي % % بمرتهن بمن حوت الخيام % % 8(@)(@@) % وأذكر إذ يظللنا بشام % بشرقي الحمى سقي البشام % % 9(@)(@@) % فيا زمنى إذ الدنيا فتاة % كما أهوى وإذ دهري غلام % 10(@)(@@) % أعائدة ليالي المواضي % % على حزوى سقى خزوى الغمام % % PageV01P395 11(@)(@@) % ليالي لا أروم سوى التصابي % % وما لي غير من أهوى مرام % 12(@)(@@) % أسامر في الدجى شمس الحميا % % ومن ندماني البدر التمام % % 13(@)(@@) % وألهو والكؤوس لها ضياء % بغانية غدائرها ظلام % % 14(@)(@@) % رداح لو تمشت في رياض % لغرد فوق قامتها الحمام % % 15(@)(@@) % لنا من وصلها العيش المهنا % % ولكن هجرها الموت الزؤام % % 16(@)(@@) % فيا عصر الصبا والأنس باد % سقاك الغيث عارضه ركام % % 17(@)(@@) % ويا عصر الشباب عليك مني % % مدى الدهر التحية والسلام % % PageV01P396 البحر : سريع 1(@)(@@) % معصيتي أعظم من طاعتي % % لكن رجائي منهما أعظم % 2(@)(@@) % وأنت ذو الرحمة يا سيدي % % إن لم تكن ترحم من يرحم % PageV01P397 البحر : كامل تام 1(@)(@@) % ومورد الوجنات أغيد خاله 
ms114	 % % قد كان يفتن بالوسامة عمه % 2(@)(@@) % إن خص قلبي بالغرام فربه % % بالحسن من فرط الملاحة عمه % % 3(@)(@@) % كحل العيون وكان في أجفانه % % عضب حكى ناب الشجاع وسمه % 4(@)(@@) % وبكى بطرف ذي احورار زانه % % كحل فقلت سقى الحسام وسمه % PageV01P398 البحر : طويل 1(@)(@@) % عتبت على دهري بأفعاله التي % % براني بها برم السهام من الهم % 2(@)(@@) % ليصرف عني فادحات نوائب % أضاق بها ذرعي وأضنى بها جسمي % % 3(@)(@@) % فقال ألم تعلم بأن حوادثي % % وأخطارها اللاتي تلم بذي الفهم % 4(@)(@@) % يضيق بها ذو الجهل ذرعا وإنما % % إذا أشكلت ردت لمن كان ذا علم % % PageV01P399 البحر : سريع 1(@)(@@) % وروضة قابلنا بشرها % % بضاحك النوار بسامه % % 2(@)(@@) % تسحب فيها الريح أذيالها % % وينفح الورد بأكمامه % PageV01P400 البحر : رمل تام 1(@)(@@) % سمح البدر بوصل فشفى % % من جوى الحب سقيما مغرما % % 2(@)(@@) % وسما عن مشبه ثم ومن % % أين للبدر شبيه في السما % % PageV01P401 البحر : بسيط تام 1(@)(@@) % ريعت وقد أبصرت نبت العذار بدا % % كالروض يفتر عن غب من الديم % 2(@)(@@) % فقلت ما الشعر هذا ما ترين به % % وإنما هو نبت الحلم والكرم % PageV01P402 البحر : طويل 1(@)(@@) % وعود به عود المسرة مورق % % يغني كما غنت عليه الحمائم % 2(@)(@@) % إذا حركت أوتاره كف غادة % % فسيان من شوق خلي وهائم % 3(@)(@@) % يرنح من يصغي إليه صبابة % % كما رنحته في الرياض النسائم % PageV01P403 البحر : وافر تام 1(@)(@@) % تذكر بالحمى رشأ أغنا % % وهاج له الهوى طربا فغنى % % 2(@)(@@) % وحن فؤاده شوقا لنجد % وأين الهند من نجد وأنى % % 3(@)(@@) % وغنت في فروع الأيك ورق % % فجاوبها بزفرته وأنا % % 4(@)(@@) % وطارحها الغرام فحين رنت % % له بتنفس الصعداء رنا % % 5(@)(@@) % وأورى لاعج الأشواق منه % % بريق بالأبريق لاح وهنا % % 6(@)(@@) % معنى كلما هبت شمال % % تذكر ذلك العيش المهنا % % 7(@)(@@) % إذا جن الظلام عليه أبدى % % من الوجد المبرح ما أجنا % % 8(@)(@@) % سقى وادي الغضا دمعي إذا ما % % تهلل لا السحاب إذا أرجحنا % % 9(@)(@@) % فكم لي في رباه قضيب حسن % % تفرد بالملاحة إذ تثنى % % 10(@)(@@) % كلفت به وما كلفت فرضا % فأوجب طرفه قتلي وسنا % % PageV01P404 11(@)(@@) % وأبدى حبه قلبي 
ms115	 وأخفى % % فصرح بالهوى شوقا وكنى % % 12(@)(@@) % تفنن حسنه في كل معنى % فصار العيش لي بهواه فنا % % 13(@)(@@) % بدا بدرا ولاح لنا هلالا % وأشرق كوكبا واهتز غصنا % % 14(@)(@@) % وثنى قده الحسن ارتياحا % % فهام القلب بالحسن المثنى % % 15(@)(@@) % ولو أن الفؤاد على هواه % % تمنى كان غاية ما تمنى % % 16(@)(@@) % بكيت دما وجن إليه قلبي % % فخضب من دمي كفا وحنا % % 17(@)(@@) % ألا يا صاحبي ترفقا بي % % فإن البين أنصبني وعنا % % 18(@)(@@) % ولم تبق النوى لي غير عزم % % إذا حفت به المحن اطمأنا % % 19(@)(@@) % وأقسم ما الهوى غرضي ولكن % % أعلل بالهوى قلبا معنى % % 20(@)(@@) % وأصرف بالتأني صرف دهري % % وأعلم أن سيظفر من تأنى % % PageV01P405 21(@)(@@) % وأدفع فادحات الخطب عني % % بتفويضي إذا ما الخطب عنا % % 22(@)(@@) % ولا والله لا أرجو ليسري % % وعسري غير من أغنى وأقنى % % 23(@)(@@) % وما قصدي بتحبير القوافي % % سوى لفظ أحبره ومعنى % % 24(@)(@@) % لأستجني ثمار القول مدحا % % لمن أضحى بطيبة مستجنا % % 25(@)(@@) % ومدح محمد شرفي وفخري % % وهل شرف وفخر منه أسنى % % 26(@)(@@) % إمام الأنبياء وخير مولى % به سعد الورى إنسا وجنا % % 27(@)(@@) % رقى بكماله رتب المعالي % % وحل من العلى سهلا وحزنا % % 28(@)(@@) % هدى الله الأنام به وأهدى % % لمن والاه إيمانا وأمنا % % 29(@)(@@) % وكم قد نال من يسراه يسرا % أخو عسر ومن يمناه يمنا % % 30(@)(@@) % وكم وافاه ذو كرب وحزن % % ففرج كربه وأزال حزنا % % PageV01P406 31(@)(@@) % وأغنى بائسا وكفاه بؤسا % % وأنجد صارخا وأصح مضنى % % 32(@)(@@) % ختام جميع رسل الله حقا % % ومبدأ كل إحسان وحسنى % % 33(@)(@@) % بمولده أضاء الكون نورا % % وأشرق في البسيطة كل مغنى % % 34(@)(@@) % وفاخرت السماء الأرض لما % % غدت بقدومه السامي تهنى % % 35(@)(@@) % فخار لا يساويه فخار % % مناط النجم من أدناه أدنى % % 36(@)(@@) % تبيد له الليالي وهو باق % ويفنى الواصفون وليس يفنى % % 37(@)(@@) % لمعجزه أقر الضد عجزا % وظلت عنده الفصحاء لكنا % % 38(@)(@@) % مثاني تقشعر له جلود % % ويغدو كل قلب مطمئنا % % 39(@)(@@) % فيولي كل من والاه ربحا % ويعقب كل من ناواه غبنا % % 40(@)(@@) % وزالت معجزات الرسل معهم % % ومعجز أحمد يزداد حسنا % % PageV01P407 41(@)(@@) % هو المختار من 
ms116	 أزل نبيا % % وما زالت له العلياء تبنى % % 42(@)(@@) % براه واصطفاه الله قدما % % وأعلاه وأسماه وأسنى % % 43(@)(@@) % وأرضعه ثدي المجد درا % % وآواه من العلياء حضنا % % 44(@)(@@) % وصيره حبيبا ثم أسرى % % به ليلا فقربه وأدنى % % 45(@)(@@) % كذلك كل محبوب يوافي % % أحبته إذا ما الليل جنا % % 46(@)(@@) % سما السبع الطباق وبات يسمو % % إلى رتب هناك له تسنا % % 47(@)(@@) % فراح يجر أذيال المعالي % % ويسحب فوق هام المجد ردنا % % 48(@)(@@) % فمن كمحمد إن عد فخر % % سما بالفخر منفردا وضمنا % % 49(@)(@@) % أجل المرسلين علا وقدرا % % وأرجحهم لدى الترجيح وزنا % % 50(@)(@@) % وأعظمهم لدى البأساء يسرا % % وأسمحهم إذا ما جاد يمنى % % PageV01P408 51(@)(@@) % وأشرف من تقلد سيف حق % وهز مثقف الأعطاف لدنا % % 52(@)(@@) % فجلى في رهان الفضل سبقا % % وجلى عن سماء الحق دجنا % % 53(@)(@@) % وطهر بالمواضي رجس قوم % % جفته قلوبهم حسدا وضغنا % % 54(@)(@@) % وخير فيهم أسرا ومنا % % فأطلق أسرهم وعفا ومنا % % 55(@)(@@) % وراموا منه إحسانا وفضلا % % فأوسعهم بنائله وأغنى % % 56(@)(@@) % وكم للهاشمي جميل وصف % % عليه خناصر الأشهاد تثنى % % 57(@)(@@) % وماذا يبلغ المثني على من % % عليه إل هه في الذكر أثنى % % 58(@)(@@) % ألا يا سيد الكونين سمعا % % لداع سائل أمنا ومنا % % 59(@)(@@) % وغوثا يا فدتك النفس غوثا % فقد شف الأسى جسمي وأضنى % % 60(@)(@@) % فما في الخلق أسرع منك نصرا % لملهوف وأسمع منك أذنا % % PageV01P409 61(@)(@@) % وها أنا فيك قد أحسنت ظني % % فحاشا أن تخيب فيك ظنا % % 62(@)(@@) % وكيف يخاف ريب الدهر عبد % تكون له من الحدثان حصنا % % 63(@)(@@) % أروم فكاك أسري من زمان % علقت بكفه الشلاء رهنا % % 64(@)(@@) % وأرجو النصر منك على عدو % % متى استقبلته قلب المجنا % % 65(@)(@@) % ركنت إليك في أسري ونصري % % وحسبي جاهك المأمول ركنا % % 66(@)(@@) % وكم لي فيك من أمل فسيح % ستنجحه إذا ما الدهر ضنا % % 67(@)(@@) % وقد طال البعاد وزاد شوقي % % إليك وعاقني دهري وأونى % % 68(@)(@@) % فأبدلني ببعد الدار قربا % % وبوئني بتلك الدار سكنى % % 69(@)(@@) % وجد لي بالشفاعة يوم حشري % % وأسكني من الجنات عدنا % % 70(@)(@@) % عليك صلاة ربك ما تغنى % % حمام الأيك في فنن وحنا % % PageV01P410 71(@)(@@) % وآلك 
ms117	 والصحابة خير آل % % وصحب ما شدا شاد وغنى % % PageV01P411 البحر : بسيط تام 1(@)(@@) % اشرب هنيئا عليك التاج مرتفقا % % بصوت شاد ودع شاذا وغمدانا % % 2(@)(@@) % إن كان ألبست العليا ابن ذي يزن % % تاجا فقد ألبست اليوم تيجانا % % PageV01P412 البحر : طويل 1(@)(@@) % أيا ماجدا قد أتقن اللفظ والمعنى % % ومعه من الإحسان ما لم يكن معنا % % 2(@)(@@) % إليك فقد صيرت سحبان مفحما % وأخجلت بالافضال يا سيدي معنا % % PageV01P413 البحر : بسيط تام 1(@)(@@) % بانوا فليت غرامي بعد هم بانا % % واستشعر القلب بعد البين سلوانا % % 2(@)(@@) % لا بل سروا بفؤادي قبل سيرهم % % وأبدلوا من جميل الصبر أحزانا % % 3(@)(@@) % هل يعلم الصحب أني بعد فرقتهم % % أبيت أرعى نجوم الليل سهرانا % % 4(@)(@@) % أقضي الزمان ولا أقضي به وطرا % وأقطع الدهر أشواقا وأشجانا % % 5(@)(@@) % ولا غريب إذا أصبحت ذا حزن % إن الغريب حزين حيثما كانا % % 6(@)(@@) % أرى فؤادي وإن ضاقت مسالكه % % بمدح نجل رسول الله جذلانا % % 7(@)(@@) % عمار أبنية المجد الذي رفعت % % آباؤه الغر من ناديه أركانا % % 8(@)(@@) % السيد الماجد الندب الشريف ومن % % قد بذ بالفضل أكفاء وأقرانا % % 9(@)(@@) % سما به النسب الوضاح فاجتمعت % % فيه المحامد أشكالا وألوانا % % 10(@)(@@) % يا واسع الخلق إفضالا ومكرمة % وموسع الخلق إنعاما وإحسانا % PageV01P414 11(@)(@@) % فقت الكرام بما أوليت من كرم % لله درك مفضالا ومعوانا % % 12(@)(@@) % ما قلت في المجد قولا يوم مفتخر % % إلا أقمت عليه منك برهانا % % 13(@)(@@) % لا زلت في الدهر مرضي العلى أبدا % ونائلا من إله الخلق رضوانا % % 14(@)(@@) % عليك مني سلام الله ما صدحت % % ورق الحمام وهز الريح أغصانا % % PageV01P415 البحر : - 1(@)(@@) % شوقي إليكم يا أهل ودي % % ألف بين الأسى وبيني % % 2(@)(@@) % هذا وشوقي لكم أراه % % شوقا لنفسي من غير مين % 3(@)(@@) % وصدق ما أدعيه فيكم % % أن عليا أبو الحسين % % PageV01P416 البحر : كامل تام 1(@)(@@) % يا بارقا صدع الدجى لمعانه % وسرى يهل على الحمى هتانه % % 2(@)(@@) % بالله إن يممت منزلنا الذي % % بانت وما بان الهوى سكانه % % 3(@)(@@) % بلغ تحيتي العفيف أخا العلى % % أصفى الأخلاء المعظم شانه % 4(@)(@@) % واشرح له شوقي إليه وصف له % % وجدي الذي 
ms118	 يقضي به وجدانه % % 5(@)(@@) % واحذر عليه أن تبث جميع ما % % قاسيته كيلا يذوب جنانه % 6(@)(@@) % وأجبه عما قد حواه كتابه % % من عقد نظم فصلت عقيانه % % 7(@)(@@) % لا يحسبن أني سلوت جنابه % % هيهات عز أخا الأسى سلوانه % % 8(@)(@@) % لم أنس أنسا كان لي بلقائه % % طابت معاهده وطاب زمانه % 9(@)(@@) % أيام روض العيش يشرق نوره % % وتميس من طرب به أغصانه % % 10(@)(@@) % يا أيها الشهم الذي أثنى على % % فتكاته يوم الطعان سنانه % % PageV01P417 11(@)(@@) % أهديت من غرر المعاني معجزا % بهر العقول بديعه وبيانه % % 12(@)(@@) % لله درك ناطقا يقضي على % % حر الكلام بما يشاء لسانه % % 13(@)(@@) % ومحبرا وشي القريض إذا امتطى % % متن البراعة للبيان بنانه % % 14(@)(@@) % ومبرزا إن رام سبقا أقصرت % % عن أن تحاول شأوه أقرانه % 15(@)(@@) % قسما بأيمان الفتوة والوفا % % وقديم عهد أسست أركانه % % 16(@)(@@) % إن الوداد كما عهدت وإنما % % هذا الزمان تلونت ألوانه % % 17(@)(@@) % والعذر في تركي دعاءك مسرعا % عذر وحقك واضح برهانه % % 18(@)(@@) % لكن عسى قد آن إبان اللقا % % والشيء يقبل إن أتى إبانه % 19(@)(@@) % فيلين من دهري بذلك ما قسا % % ويعود بعد إساءة إحسانه % % PageV01P418 البحر : بسيط تام 1(@)(@@) % يا راحلين وهم في القلب سكان % هل غير قلبي لكم مأوى وأوطان % % 2(@)(@@) % خذوا من الأرض أنى شئتم نزلا % فأنتم في سويدا القلب قطان % % 3(@)(@@) % وأنت يا حادي الظعن التي ظعنت % % فيها العشية أقمار وأغصان % % 4(@)(@@) % بالله إن لم يكن بد لمن ظعنوا % % من منزل بالحمى تأويه أظعان % % 5(@)(@@) % فعج بشرقي وادي الرمل من اضم % % حيث الغضا والأضى والرند والبان % % 6(@)(@@) % لعلهم أن يحلوا منه منزلة % كانوا يحلونها والدهر جذلان % % 7(@)(@@) % أيام أختال في برد الصبا مرحا % والعمر غض وصفو العيش فينان % 8(@)(@@) % لا أوحش الله من ناء تؤرقني % % ذكراه وهو خلي البال وسنان % 9(@)(@@) % أذوى وريق شبابي بعده ظمأ % وغصنه من مياه الحسن ريان % % 10(@)(@@) % حيا به الله يوما روح عاشقه % % فإنما هو للأرواح ريحان % PageV01P419 11(@)(@@) % قد جل في حسنه عن أن يقاس به % % ظبي وبدر وأغصان وكثبان % 12(@)(@@) % لله كم فيه 
ms119	 من حسن يدل به % % لو كان يشفع ذاك الحسن إحسان % % 13(@)(@@) % يا عاذلي في هواه لا ترم شططا % دعني فعذلك شان والهوى شان % % 14(@)(@@) % والله ما جادل العذال عاشقه % % إلا وقام له بالحسن برهان % 15(@)(@@) % وأين من سمعي اللاحي وزخرفه % ولي من الحب سلطان وشيطان % 16(@)(@@) % وليلة بات بدري وهو معتنقي % % فيها سرورا وبدر الأفق غيران % 17(@)(@@) % فظل ينقع من قلبي غليل جوى % إذ كان من قبل إعراض وهجران % 18(@)(@@) % حتى بدا الفجر فارتاعت كواكبها % % كأنها نقد والفجر سرحان % % 19(@)(@@) % فقام يثني قواما زانه هيف % كأنه بمدام الوصل نشوان % 20(@)(@@) % وراح والدمع من أجفانه درر % ورحت والدمع من جفني عقيان % % PageV01P420 21(@)(@@) % لله أزمان وصل قد مضت وقضت % % أن لا تعود بها ما عشت أزمان % % 22(@)(@@) % مرت فلم يبق لي إلا تذكرها % % وذكر ما قد مضى للوجد عنوان % % 23(@)(@@) % فيا زمان اللوى حييت من زمن % ولا أغب اللوى والسفح هتان % % PageV01P421 البحر : كامل تام 1(@)(@@) % تبدي السلو وأنت مرتهن % % وخفي سرك في الهوى علن % 2(@)(@@) % هذي شهود الحب ناطقة % لا الروح تكذبها ولا البدن % % 3(@)(@@) % إن رمت تكتم ما تكابده % % بعد النوى فلرأيك الغبن % 4(@)(@@) % ما زال يجهدك الغرام أسى % حتى جفا أجفانك الوسن % 5(@)(@@) % في كل حين للفؤاد شجى % يوهي العزاء وللهوى شجن % % 6(@)(@@) % أنى لقلبك أن يقال صحا % % وثنى جموح ضلاله الرسن % % 7(@)(@@) % قد كان أولاك النصوح هدى % لو أنه في النصح مؤتمن % 8(@)(@@) % لكن تعامى عن نصيحته % % منك الفؤاد وصمت الأذن % % 9(@)(@@) % وغدوت تخطر في بلهنية % من صفو عيشك والهوى فتن % 10(@)(@@) % يصيبك كل مهفهف نضر % من قده يتعلم الغصن % % PageV01P422 11(@)(@@) % فتن القلوب بحسن طلعته % % فكأنه في حسنه وثن % 12(@)(@@) % وأراك من باهي محاسنه % % منحا ولكن دونها محن % 13(@)(@@) % أما الغرام فقد منيت به % % فعلام يرهن عزمك الوهن % % 14(@)(@@) % قد طال مكثك حيث لا وطر % يصفو به عيش ولا وطن % % 15(@)(@@) % وأضر قلبك طول مغترب % لا مسكن يدنو ولا سكن % 16(@)(@@) % فالام ترضى لا رضيت بأن % % ينمى إليك العجز 
ms120	 والجبن % 17(@)(@@) % أحلا لنفسك أن يقال لها % % هذا علي حطه الزمن % 18(@)(@@) % حصل الجهول على مآربه % % ومضى بغير طلابه القمن % % 19(@)(@@) % حتى متى قول ولا عمل % وإلى متى قصد ولا سنن % 20(@)(@@) % ما شان شأنك قط منتقص % % أنت العلي وذكرك الحسن % % PageV01P423 21(@)(@@) % فاقطع برحلك حيث لا عتب % واربأ بعرضك حيث لا درن % 22(@)(@@) % وافخر بسبقك لا بسبق أب % فخرا فأنت السابق الأرن % % 23(@)(@@) % إن يبل ثوبك فالنهى جنن % أو تود خيلك فالعلى حصن % % 24(@)(@@) % لا تبتئس لملمة عرضت % لا فرحة تبقى ولا حزن % PageV01P424 البحر : خفيف تام 1(@)(@@) % ذكر الخيف والحمى وحجونه % % فذرى دمعه وأبدى مصونه % 2(@)(@@) % وأعاد الهوى له عيد وجد % منع النوم بالبكاء جفونه % 3(@)(@@) % لا تلوموه إن بكى من جواه % % وأجد الأسى عليه جنونه % % 4(@)(@@) % كل صب إذا تذكر يوما % هيج الذكر وجده وشجونه % 5(@)(@@) % يا نزولا ببطن مكة عطفا % بمحب أبحتم اليوم هونه % % 6(@)(@@) % مولع بالأسى عزيز تأس % قرح الدمع خده وشؤونه % % 7(@)(@@) % قد أطلتم مطل المحبين فاقضوا % % دين صب أذقتموه منونه % 8(@)(@@) % ثم إن شئتم صلوا أو فصدوا % % ما عليه إذا قضيتم ديونه % PageV01P425 البحر : كامل تام 1(@)(@@) % لولا ازديارك في الكرى وهنا % % كان السهاد لطرفه أهنا % % 2(@)(@@) % ألطيف كان أرق منك له % % لولا الصباح لزاره مثنى % % 3(@)(@@) % إن تمنعي يقظى زيارته % % فلقد أبحت وصاله وسنى % % 4(@)(@@) % يا ظبية بالسفح راتعة % تشتو الغضا وتربع الحزنا % % 5(@)(@@) % إن ينأحيك فالهوى أمم % أو تقص دارك فالحشى مغنى % % 6(@)(@@) % ما كنت أحسب قبل فرقتنا % % أن سوف تغلق مهجتي رهنا % % 7(@)(@@) % ولقد سألت عريف ركبهم % % عنها فقال ترحلت معنا % % 8(@)(@@) % لله مسكنها على إضم % لو دام لي ولها به السكنى % % 9(@)(@@) % إذ كان روض صبابتي نضرا % غضا وغصن شبيبتي لدنا % % 10(@)(@@) % أيام تسعدني بزورتها % % سعدى وكل لبانتي لبنى % % PageV01P426 11(@)(@@) % لم أنسها والبين يزعجها % % تبدي العزاء وتكتم الحزنا % % 12(@)(@@) % حتى إذا جد الرحيل بها % % بلت سجال دموعها الردنا % % 13(@)(@@) % واها من غادة سكنت % % مني الحشا إذ حاولت ظعنا % % 14(@)(@@) % قد بعتها روحي 