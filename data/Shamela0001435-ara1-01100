ms1081	 هشام بن عروة، عن أبيه، قال: (@)(@@) @MATN@ «أنزل عبس وتولى في ابن أم مكتوم ولم يذكر فيه عن عائشة» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٣٢ - (@)(@@) حدثنا عبد بن حميد قال: حدثنا محمد بن الفضل قال: حدثنا ثابت بن يزيد، عن هلال بن خباب، عن عكرمة، عن ابن عباس، عن النبي صلى الله عليه وسلم قال: (@)(@@) @MATN@ «تحشرون حفاة عراة غرلا» ، (@)(@@) فقالت امرأة: أيبصر أو يرى بعضنا عورة بعض؟ قال: (@)(@@) @MATN@ «يا فلانة» @(@)(@@) QB@ {لكل امرئ منهم يومئذ شأن يغنيه} @QE@ [عبس: ٣٧] . PageV05P432 هذا حديث حسن صحيح، قد روي من غير وجه عن ابن عباس. وفيه عن عائشة (@) (@)(@) (@)(@@)(@@)(@@) || باب ومن سورة إذا الشمس كورت (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٣٣ - (@)(@@) حدثنا عباس بن عبد العظيم العنبري قال: حدثنا عبد الرزاق قال: أخبرنا عبد الله بن بحير، عن عبد الرحمن وهو ابن يزيد الصنعاني، قال: سمعت ابن عمر يقول: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «من سره أن ينظر إلى يوم القيامة كأنه رأي عين» (@)(@@) فليقرأ: إذا الشمس كورت، وإذا السماء انفطرت، وإذا السماء انشقت " (@)PageV05P433 (@)(@) (@)(@@)(@@)(@@) || باب ومن سورة ويل للمطففين (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٣٤ - (@)(@@) حدثنا قتيبة قال: حدثنا الليث، عن ابن عجلان، عن القعقاع بن حكيم، عن أبي صالح، عن أبي هريرة، عن رسول الله صلى الله عليه وسلم قال: (@)(@@) @MATN@ «إن العبد إذا أخطأ خطيئة نكتت في قلبه نكتة سوداء، فإذا هو نزع واستغفر وتاب سقل قلبه، وإن عاد زيد فيها حتى تعلو قلبه، وهو الران الذي ذكر الله» @(@)(@@) QB@ {كلا بل ران على قلوبهم ما كانوا يكسبون} @QE@ [المطففين: ١٤] . (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٣٥ - (@)(@@) حدثنا يحيى بن درست البصري قال: حدثنا حماد بن زيد، عن أيوب، عن نافع، عن ابن عمر قال: حماد: هو عندنا مرفوع، @QB@ {يوم يقوم الناس لرب العالمين} @QE@ [المطففين: ٦] قال: (@)(@@) @MATN@ «يقومون في الرشح إلى أنصاف آذانهم» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٣٦ - (@)(@@) حدثنا هناد قال: حدثنا عيسى بن يونس، عن ابن عون، عن نافع، عن ابن عمر، عن النبي صلى الله عليه وسلم: @QB@ {يوم يقوم الناس لرب العالمين} @QE@ [المطففين: ٦] قال: (@)(@@) @MATN@ «يقوم أحدهم في الرشح إلى أنصاف أذنيه» . (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) وفيه عن 
ms1082	 أبي هريرة (@)PageV05P434 (@)(@) (@)(@@)(@@)(@@) || باب ومن سورة إذا السماء انشقت (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٣٧ - (@)(@@) حدثنا عبد بن حميد قال: حدثنا عبيد الله بن موسى، عن عثمان بن الأسود، عن ابن أبي مليكة، عن عائشة قالت: سمعت النبي صلى الله عليه وسلم يقول: (@)(@@) @MATN@ «من نوقش الحساب هلك» ، (@)(@@) قلت: يا رسول الله، إن الله يقول: @QB@ {فأما من أوتي كتابه بيمينه} @QE@ [الانشقاق: ٧] - إلى قوله - @QB@ {يسيرا} @QE@ [النساء: ٣٠] قال: (@)(@@) @MATN@ «ذلك العرض» : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) حدثنا سويد بن نصر قال: أخبرنا عبد الله بن المبارك، عن عثمان بن الأسود، بهذا الإسناد نحوه. حدثنا محمد بن أبان، وغير واحد قالوا: حدثنا عبد الوهاب الثقفي، عن أيوب، عن ابن أبي مليكة، عن عائشة، عن النبي صلى الله عليه وسلم نحوه (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٣٨ - (@)(@@) حدثنا محمد بن عبيد الهمذاني قال: حدثنا علي بن أبي بكر، عن همام، عن قتادة، عن أنس، عن النبي صلى الله عليه وسلم قال: (@)(@@) @MATN@ «من حوسب عذب» . (@)(@@) @MATN@ «وهذا حديث غريب من حديث قتادة عن أنس، لا نعرفه من حديث قتادة عن أنس، عن النبي صلى الله عليه وسلم إلا من هذا الوجه» (@)(@@) (@)PageV05P435 (@)(@) (@)(@@)(@@)(@@) || باب ومن سورة البروج (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٣٩ - (@)(@@) حدثنا عبد بن حميد قال: حدثنا روح بن عبادة، وعبيد الله بن موسى، عن موسى بن عبيدة، عن أيوب بن خالد، عن عبد الله بن رافع، عن أبي هريرة قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «اليوم الموعود يوم القيامة، واليوم المشهود يوم عرفة، والشاهد يوم الجمعة، وما طلعت الشمس ولا غربت على يوم أفضل منه، فيه ساعة لا يوافقها عبد مؤمن يدعو الله بخير إلا استجاب الله له، ولا يستعيذ من شيء إلا أعاذه الله منه» . (@)(@@) هذا حديث لا نعرفه إلا من حديث موسى بن عبيدة، وموسى بن عبيدة يضعف في الحديث؛ ضعفه يحيى بن سعيد وغيره من قبل حفظه. وقد روى شعبة، وسفيان الثوري، وغير واحد من الأئمة عن موسى بن عبيدة. حدثنا علي بن حجر قال: حدثنا قران بن تمام الأسدي، عن موسى بن عبيدة، بهذا الإسناد نحوه. وموسى بن 
ms1083	 عبيدة الربذي يكنى أبا عبد العزيز، وقد تكلم فيه يحيى بن سعيد القطان وغيره من قبل حفظه (@)PageV05P436 (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٤٠ - (@)(@@) حدثنا محمود بن غيلان، وعبد بن حميد، المعنى واحد، قالا: حدثنا عبد الرزاق، عن معمر، عن ثابت البناني، عن عبد الرحمن بن أبي ليلى، عن صهيب قال: كان رسول الله صلى الله عليه وسلم إذا صلى العصر همس - والهمس في قول بعضهم تحرك شفتيه كأنه يتكلم - فقيل له: إنك يا رسول الله إذا صليت العصر همست؟ قال: (@)(@@) @MATN@ " إن نبيا من الأنبياء كان أعجب بأمته فقال: من يقوم لهؤلاء؟ فأوحى الله إليه أن خيرهم بين أن أنتقم منهم وبين أن أسلط عليهم عدوهم، فاختاروا النقمة، فسلط عليهم الموت، فمات منهم في يوم سبعون ألفا " (@)(@) (@)(@@) قال: وكان إذا حدث بهذا الحديث حدث بهذا الحديث الآخر قال: (@)(@@) @MATN@ " كان ملك من الملوك وكان لذلك الملك كاهن يكهن له، فقال الكاهن: انظروا لي غلاما فهما - أو قال: فطنا - لقنا فأعلمه علمي هذا، فإني أخاف أن أموت فينقطع منكم هذا العلم، ولا يكون فيكم من يعلمه. قال: فنظروا له على ما وصف، فأمروه أن يحضر ذلك الكاهن وأن يختلف إليه، فجعل يختلف، إليه وكان على طريق الغلام راهب في صومعة - قال معمر: أحسب أن أصحاب الصوامع كانوا يومئذ مسلمين - قال: فجعل الغلام يسأل ذلك الراهب كلما مر به، فلم يزل به حتى أخبره، فقال: إنما أعبد الله. قال: فجعل الغلام يمكث عند الراهب ويبطئ عن الكاهن، فأرسل الكاهن إلى أهل الغلام إنه لا يكاد يحضرني، فأخبر الغلام الراهب بذلك، فقال له الراهب: إذا قال لك الكاهن: أين كنت؟ فقل: عند أهلي، PageV05P437 وإذا قال لك أهلك: أين كنت؟ فأخبرهم أنك كنت عند الكاهن. قال: فبينما الغلام على ذلك إذ مر بجماعة من الناس كثير قد حبستهم دابة، فقال بعضهم: إن تلك الدابة كانت أسدا. قال: فأخذ الغلام حجرا فقال: اللهم إن كان ما يقول الراهب حقا فأسألك أن أقتلها. قال: ثم رمى فقتل الدابة. فقال الناس: من قتلها؟ قالوا: 
ms1084	 الغلام، ففزع الناس وقالوا: لقد علم هذا الغلام علما لم يعلمه أحد. قال: فسمع به أعمى، فقال له: إن أنت رددت بصري فلك كذا وكذا. قال: لا أريد منك هذا، ولكن أرأيت إن رجع إليك بصرك، أتؤمن بالذي رده عليك؟ قال: نعم. قال: فدعا الله فرد عليه بصره، فآمن الأعمى، فبلغ الملك أمرهم، فبعث إليهم، فأتي بهم، فقال: لأقتلن كل واحد منكم قتلة لا أقتل بها صاحبه، فأمر بالراهب والرجل الذي كان أعمى فوضع المنشار على مفرق أحدهما فقتله، وقتل الآخر بقتلة أخرى. ثم أمر بالغلام، فقال: انطلقوا به إلى جبل كذا وكذا فألقوه من رأسه، فانطلقوا به إلى ذلك الجبل، فلما انتهوا إلى ذلك المكان الذي أرادوا أن يلقوه منه جعلوا يتهافتون من ذلك الجبل ويتردون، حتى لم يبق منهم إلا الغلام. قال: ثم رجع، فأمر به الملك أن ينطلقوا به إلى البحر فيلقونه فيه، فانطلق به إلى البحر، فغرق الله الذين كانوا معه وأنجاه، فقال الغلام للملك: إنك لا تقتلني حتى تصلبني وترميني وتقول إذا رميتني: بسم الله رب هذا الغلام. قال فأمر به، فصلب، ثم رماه، فقال: PageV05P438 بسم الله رب هذا الغلام. قال: فوضع الغلام يده على صدغه حين رمي، ثم مات، فقال أناس: لقد علم هذا الغلام علما ما علمه أحد، فإنا نؤمن برب هذا الغلام. قال: فقيل للملك أجزعت أن خالفك ثلاثة، فهذا العالم كلهم قد خالفوك. قال: فخد أخدودا ثم ألقى فيها الحطب والنار، ثم جمع الناس. فقال: من رجع عن دينه تركناه، ومن لم يرجع ألقيناه في هذه النار، فجعل يلقيهم في تلك الأخدود. قال: يقول الله تبارك وتعالى فيه: @QB@ {قتل أصحاب الأخدود النار ذات الوقود} @QE@ [البروج: ٥] حتى بلغ @QB@ {العزيز الحميد} @QE@ [إبراهيم: ١] قال: فأما الغلام فإنه دفن " قال: فيذكر أنه أخرج في زمن عمر بن الخطاب وإصبعه على صدغه كما وضعها حين قتل،: (@)(@@) @MATN@ «هذا حديث حسن غريب» (@)(@@) (@) (@)(@) (@)(@@)(@@)(@@) || باب ومن سورة الغاشية (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٤١ - (@)(@@) حدثنا محمد بن بشار قال: حدثنا عبد الرحمن بن مهدي قال: 
ms1085	 حدثنا سفيان، عن أبي الزبير، عن جابر قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ " أمرت أن أقاتل الناس حتى يقولوا: لا إله إلا الله، فإذا قالوها عصموا مني دماءهم وأموالهم إلا بحقها وحسابهم على الله " ، ثم قرأ: @QB@ {إنما أنت مذكر لست عليهم بمصيطر} @QE@ [الغاشية: ٢٢] : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@)PageV05P439 (@)(@) (@)(@@)(@@)(@@) || باب ومن سورة الفجر (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٤٢ - (@)(@@) حدثنا أبو حفص عمرو بن علي قال: حدثنا عبد الرحمن بن مهدي، وأبو داود، قالا: حدثنا همام، عن قتادة، عن عمران بن عصام، عن رجل، من أهل البصرة، عن عمران بن حصين، أن النبي صلى الله عليه وسلم سئل عن الشفع والوتر، فقال: (@)(@@) @MATN@ «هي الصلاة بعضها شفع وبعضها وتر» : (@)(@@) @MATN@ «هذا حديث غريب لا نعرفه إلا من حديث قتادة» (@)(@@) وقد رواه خالد بن قيس أيضا، عن قتادة (@)(@) (@)(@@)(@@)(@@) || باب ومن سورة والشمس وضحاها (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٤٣ - (@)(@@) حدثنا هارون بن إسحاق الهمداني قال: حدثنا عبدة، عن هشام بن عروة، عن أبيه، عن عبد الله بن زمعة، قال: سمعت النبي صلى الله عليه وسلم يوما يذكر الناقة والذي عقرها فقال: @QB@ {إذ انبعث أشقاها} @QE@ [الشمس: ١٢] (@)(@@) @MATN@ «انبعث لها رجل عارم عزيز منيع في رهطه مثل أبي زمعة» (@)(@@) (@)(@) (@)(@@) ثم سمعته يذكر النساء فقال: (@)(@@) @MATN@ «إلام يعمد أحدكم، فيجلد امرأته PageV05P440 جلد العبد ولعله أن يضاجعها من آخر يومه» (@)(@@) (@) (@)(@) (@)(@@) قال: ثم وعظهم في ضحكهم من الضرطة فقال: (@)(@@) @MATN@ «إلام يضحك أحدكم مما يفعل» : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@)(@) (@)(@@)(@@)(@@) || باب ومن سورة والليل إذا يغشى (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٤٤ - (@)(@@) حدثنا محمد بن بشار قال: حدثنا عبد الرحمن بن مهدي قال: حدثنا زائدة بن قدامة، عن منصور بن المعتمر، عن سعد بن عبيدة، عن أبي عبد الرحمن السلمي، عن علي: قال: كنا في جنازة في البقيع، فأتى النبي صلى الله عليه وسلم فجلس وجلسنا معه ومعه عود ينكت به في الأرض، فرفع رأسه إلى السماء فقال: (@)(@@) @MATN@ «ما من نفس منفوسة إلا قد كتب مدخلها» ، (@)(@@) فقال القوم: يا رسول الله، أفلا نتكل على كتابنا، فمن كان من أهل السعادة، فهو يعمل للسعادة، ومن كان من أهل 
ms1086	 الشقاء، فإنه يعمل للشقاء؟ قال: (@)(@@) @MATN@ «بل اعملوا فكل ميسر، أما من كان من أهل السعادة فإنه ميسر لعمل السعادة، وأما من كان من أهل الشقاء فإنه ميسر لعمل الشقاء» ، (@)(@@) ثم قرأ: @QB@ {فأما من أعطى واتقى وصدق بالحسنى فسنيسره لليسرى وأما من بخل واستغنى وكذب بالحسنى فسنيسره للعسرى} @QE@ [الليل: ٦] : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@)PageV05P441 (@)(@) (@)(@@)(@@)(@@) || باب ومن سورة والضحى (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٤٥ - (@)(@@) حدثنا ابن أبي عمر قال: حدثنا سفيان بن عيينة، عن الأسود بن قيس، عن جندب البجلي، قال: كنت مع النبي صلى الله عليه وسلم في غار، فدميت إصبعه، فقال النبي صلى الله عليه وسلم: (@)(@@) @MATN@ «هل أنت إلا إصبع دميت، وفي سبيل الله ما لقيت» (@)(@@) قال: وأبطأ عليه جبريل، فقال المشركون: قد ودع محمد، فأنزل الله تعالى: @QB@ {ما ودعك ربك وما قلى} @QE@ [الضحى: ٣] : (@)(@@) @MATN@ «هذا حديث حسن صحيح» ، (@)(@@) وقد رواه شعبة، والثوري، عن الأسود بن قيس (@)(@) (@)(@@)(@@)(@@) || باب ومن سورة ألم نشرح (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٤٦ - (@)(@@) حدثنا محمد بن بشار قال: حدثنا محمد بن جعفر، وابن أبي عدي، عن سعيد بن أبي عروبة، عن قتادة، عن أنس بن مالك، عن مالك بن صعصعة، رجل من قومه، أن النبي صلى الله عليه وسلم قال: (@)(@@) @MATN@ " بينما أنا عند البيت بين النائم واليقظان، إذ سمعت قائلا PageV05P442 يقول: أحد بين الثلاثة، فأتيت بطست من ذهب فيها ماء زمزم، فشرح صدري إلى كذا وكذا - قال قتادة: قلت لأنس بن مالك: ما يعني؟ - قال: إلى أسفل بطني، فاستخرج قلبي، فغسل قلبي بماء زمزم، ثم أعيد مكانه، ثم حشي إيمانا وحكمة " وفي الحديث قصة طويلة: (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) وقد رواه هشام الدستوائي، وهمام، عن قتادة وفيه عن أبي ذر (@) (@)(@) (@)(@@)(@@)(@@) || باب ومن سورة التين (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٤٧ - (@)(@@) حدثنا ابن أبي عمر قال: حدثنا سفيان، عن إسماعيل بن أمية، قال: سمعت رجلا بدويا أعرابيا، يقول: سمعت أبا هريرة يرويه يقول: (@)(@@) @MATN@ " من قرأ سورة: والتين والزيتون فقرأ: @QB@ {أليس الله بأحكم الحاكمين} @QE@ [التين: ٨] فليقل: بلى وأنا على ذلك من الشاهدين " : (@)(@@) @MATN@ «هذا حديث إنما يروى بهذا الإسناد عن هذا الأعرابي، عن أبي 
ms1087	 هريرة ولا يسمى» (@)(@@) (@)(@) (@)(@@)(@@)(@@) || باب ومن سورة اقرأ باسم ربك (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٤٨ - (@)(@@) حدثنا عبد بن حميد قال: أخبرنا عبد الرزاق، عن معمر، عن عبد الكريم الجزري، عن عكرمة، عن ابن عباس: PageV05P443 @QB@ {سندع الزبانية} @QE@ [العلق: ١٨] قال: قال أبو جهل، لئن رأيت محمدا يصلي لأطأن على عنقه، فقال النبي صلى الله عليه وسلم: (@)(@@) @MATN@ «لو فعل لأخذته الملائكة عيانا» : (@)(@@) @MATN@ «هذا حديث حسن صحيح غريب» (@)(@@) (@) (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٤٩ - (@)(@@) حدثنا أبو سعيد الأشج قال: حدثنا أبو خالد الأحمر، عن داود بن أبي هند، عن عكرمة، عن ابن عباس قال: كان النبي صلى الله عليه وسلم يصلي فجاء أبو جهل فقال: ألم أنهك عن هذا؟ ألم أنهك عن هذا؟ ألم أنهك عن هذا؟ (@)(@@) @MATN@ «فانصرف النبي صلى الله عليه وسلم فزبره» ، (@)(@@) فقال أبو جهل: إنك لتعلم ما بها ناد أكثر مني، فأنزل الله: @QB@ {فليدع ناديه سندع الزبانية} @QE@ [العلق: ١٨] فقال ابن عباس: (@)(@@) @MATN@ «والله لو دعا ناديه لأخذته زبانية الله» ، (@)(@@) @MATN@ «هذا حديث حسن صحيح غريب» (@)(@@) وفيه عن أبي هريرة (@)(@) (@)(@@)(@@)(@@) || باب ومن سورة ليلة القدر (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٥٠ - (@)(@@) حدثنا محمود بن غيلان قال: حدثنا أبو داود الطيالسي قال: حدثنا القاسم بن الفضل الحداني، عن يوسف بن سعد، قال: قام رجل إلى الحسن بن علي، بعد ما بايع معاوية، فقال: سودت PageV05P444 وجوه المؤمنين، أو يا مسود وجوه المؤمنين فقال: لا تؤنبني رحمك الله، فإن النبي صلى الله عليه وسلم أري بني أمية على منبره فساءه ذلك، فنزلت: @QB@ {إنا أعطيناك الكوثر} @QE@ [الكوثر: ١] يا محمد، يعني نهرا في الجنة، ونزلت: @QB@ {إنا أنزلناه في ليلة القدر وما أدراك ما ليلة القدر ليلة القدر خير من ألف شهر} @QE@ [القدر: ٢] يملكها بعدك بنو أمية يا محمد (@)(@@) @MATN@ «قال القاسم، فعددناها فإذا هي ألف شهر لا تزيد يوما ولا تنقص.» (@)(@@) هذا حديث غريب لا نعرفه إلا من هذا الوجه من حديث القاسم بن الفضل وقد قيل عن القاسم بن الفضل، عن يوسف بن مازن، والقاسم بن الفضل الحداني هو ثقة؛ وثقه يحيى بن سعيد وعبد الرحمن بن مهدي، ويوسف بن سعد رجل مجهول ولا 
ms1088	 نعرف هذا الحديث على هذا اللفظ إلا من هذا الوجه " (@) (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٥١ - (@)(@@) حدثنا ابن أبي عمر قال: حدثنا سفيان، عن عبدة بن أبي لبابة، وعاصم هو ابن بهدلة، سمعا زر بن حبيش، يقول: قلت لأبي بن كعب، إن أخاك عبد الله بن مسعود يقول: من يقم الحول يصب ليلة القدر، فقال: يغفر الله لأبي عبد الرحمن، (@)(@@) @MATN@ «لقد علم أنها في العشر الأواخر من رمضان، وأنها ليلة سبع وعشرين، ولكنه أراد أن لا يتكل الناس، ثم حلف لا يستثني أنها ليلة سبع وعشرين» ، (@)(@@) قال: قلت له: بأي شيء تقول ذلك يا أبا المنذر؟ قال: PageV05P445 (@)(@@) @MATN@ «بالآية التي أخبرنا رسول الله صلى الله عليه وسلم، أو بالعلامة أن الشمس تطلع يومئذ لا شعاع لها» : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@) (@)(@) (@)(@@) باب: ومن سورة لم يكن (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٥٢ - (@)(@@) حدثنا محمد بن بشار قال: حدثنا عبد الرحمن بن مهدي قال: حدثنا سفيان، عن المختار بن فلفل، قال: سمعت أنس بن مالك يقول: قال رجل للنبي صلى الله عليه وسلم: يا خير البرية، قال: (@)(@@) @MATN@ «ذلك إبراهيم» .: (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@)(@) (@)(@@)(@@)(@@) || باب ومن سورة إذا زلزلت الأرض (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٥٣ - (@)(@@) حدثنا سويد بن نصر قال: أخبرنا عبد الله بن المبارك قال: أخبرنا سعيد بن أبي أيوب، عن يحيى بن أبي سليمان، عن سعيد المقبري، عن أبي هريرة قال: قرأ رسول الله صلى الله عليه وسلم هذه الآية: @QB@ {يومئذ تحدث أخبارها} @QE@ [الزلزلة: ٤] قال: (@)(@@) @MATN@ «أتدرون ما أخبارها؟» (@)(@@) قالوا: PageV05P446 الله ورسوله أعلم. قال: (@)(@@) @MATN@ " فإن أخبارها أن تشهد على كل عبد أو أمة بما عمل على ظهرها، تقول: عمل يوم كذا كذا وكذا، فهذه أخبارها " : (@)(@@) @MATN@ «هذا حديث حسن صحيح غريب» (@)(@@) (@) (@)(@) (@)(@@)(@@)(@@) || باب ومن سورة ألهاكم التكاثر (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٥٤ - (@)(@@) حدثنا محمود بن غيلان قال: حدثنا وهب بن جرير قال: حدثنا شعبة، عن قتادة، عن مطرف بن عبد الله بن الشخير، عن أبيه، أنه انتهى إلى النبي صلى الله عليه وسلم وهو يقرأ: ألهاكم التكاثر قال: (@)(@@) @MATN@ " يقول ابن آدم: مالي مالي، وهل لك من مالك إلا ما تصدقت فأمضيت، أو أكلت 
ms1089	 فأفنيت، أو لبست فأبليت؟ " : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٥٥ - (@)(@@) حدثنا أبو كريب قال: حدثنا حكام بن سلم الرازي، عن عمرو بن أبي قيس، عن الحجاج، عن المنهال بن عمرو، عن زر بن حبيش، عن علي قال: (@)(@@) @MATN@ " ما زلنا نشك في عذاب القبر حتى نزلت: ألهاكم التكاثر " قال أبو كريب، مرة عن عمرو بن أبي قيس، عن ابن أبي ليلى، عن المنهال بن عمرو،: (@)(@@) @MATN@ «هذا حديث غريب» (@)(@@) (@)PageV05P447 (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٥٦ - (@)(@@) حدثنا ابن أبي عمر قال: حدثنا سفيان بن عيينة، عن محمد بن عمرو بن علقمة، عن يحيى بن عبد الرحمن بن حاطب، عن عبد الله بن الزبير بن العوام، عن أبيه، قال: لما نزلت: @QB@ {ثم لتسألن يومئذ عن النعيم} @QE@ [التكاثر: ٨] قال الزبير: يا رسول الله، وأي النعيم نسأل عنه، وإنما هما الأسودان التمر والماء؟ قال: (@)(@@) @MATN@ «أما إنه سيكون» . (@)(@@) @MATN@ «هذا حديث حسن» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٥٧ - (@)(@@) حدثنا عبد بن حميد قال: حدثنا أحمد بن يونس، عن أبي بكر بن عياش، عن محمد بن عمرو، عن أبي سلمة، عن أبي هريرة قال: لما نزلت هذه الآية: @QB@ {ثم لتسألن يومئذ عن النعيم} @QE@ [التكاثر: ٨] قال الناس: يا رسول الله، عن أي النعيم نسأل؟ فإنما هما الأسودان والعدو حاضر، وسيوفنا على عواتقنا؟ قال: (@)(@@) @MATN@ «إن ذلك سيكون» : (@)(@@) @MATN@ «وحديث ابن عيينة عن محمد بن عمرو عندي أصح من هذا، سفيان بن عيينة أحفظ وأصح حديثا من أبي بكر بن عياش» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٥٨ - (@)(@@) حدثنا عبد بن حميد قال: حدثنا شبابة، عن عبد الله بن العلاء، عن الضحاك بن عبد الرحمن بن عرزم الأشعري، قال: سمعت أبا هريرة يقول: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ " إن أول ما يسأل عنه يوم القيامة - يعني العبد من النعيم - أن يقال له: ألم نصح لك جسمك، ونرويك من الماء البارد " : (@)(@@) @MATN@ «هذا حديث غريب» (@)(@@) PageV05P448 والضحاك هو ابن عبد الرحمن بن عرزب، ويقال ابن عرزم، وابن عرزم أصح " (@) (@)(@) (@)(@@)(@@)(@@) || باب ومن سورة الكوثر (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٥٩ - (@)(@@) حدثنا عبد بن حميد قال: حدثنا عبد الرزاق، عن معمر، عن قتادة، عن أنس، في قوله تعالى: 
ms1090	 @QB@ {إنا أعطيناك الكوثر} @QE@ [الكوثر: ١] : أن النبي صلى الله عليه وسلم قال: (@)(@@) @MATN@ «هو نهر في الجنة» (@)(@@) قال: فقال النبي صلى الله عليه وسلم: (@)(@@) @MATN@ " رأيت نهرا في الجنة حافتاه قباب اللؤلؤ. قلت: ما هذا يا جبريل؟ قال: هذا الكوثر الذي أعطاكه الله " : هذا حديث حسن صحيح (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٦٠ - (@)(@@) حدثنا أحمد بن منيع قال: حدثنا سريج بن النعمان قال: حدثنا الحكم بن عبد الملك، عن قتادة، عن أنس، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ " بينا أنا أسير في الجنة، إذ عرض لي نهر حافتاه قباب اللؤلؤ، قلت للملك: ما هذا؟ قال: هذا الكوثر الذي أعطاكه الله، قال: ثم ضرب بيده إلى طينة فاستخرج مسكا، ثم رفعت لي سدرة المنتهى فرأيت عندها نورا عظيما " : (@)(@@) @MATN@ «هذا حديث حسن صحيح قد روي من غير وجه عن أنس» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٦١ - (@)(@@) حدثنا هناد قال: حدثنا محمد بن فضيل، عن عطاء بن السائب، PageV05P449 عن محارب بن دثار، عن عبد الله بن عمر، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «الكوثر نهر في الجنة، حافتاه من ذهب، ومجراه على الدر والياقوت، تربته أطيب من المسك، وماؤه أحلى من العسل، وأبيض من الثلج» . (@)(@@) هذا حديث حسن صحيح (@) (@)(@) (@)(@@)(@@)(@@) || باب ومن سورة الفتح (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٦٢ - (@)(@@) حدثنا عبد بن حميد قال: حدثنا سليمان بن داود، عن شعبة، عن أبي بشر، عن سعيد بن جبير، عن ابن عباس، قال: كان عمر يسألني مع أصحاب النبي صلى الله عليه وسلم، فقال له عبد الرحمن بن عوف: أتسأله ولنا بنون مثله؟ فقال له عمر: إنه من حيث تعلم، فسأله عن هذه الآية: @QB@ {إذا جاء نصر الله والفتح} @QE@ [النصر: ١] فقلت: (@)(@@) @MATN@ «إنما هو أجل رسول الله صلى الله عليه وسلم أعلمه إياه، وقرأ السورة إلى آخرها» ، (@)(@@) فقال له عمر: والله ما أعلم منها إلا ما تعلم: هذا حديث حسن صحيح حدثنا محمد بن بشار قال: حدثنا محمد بن جعفر قال: حدثنا شعبة، عن أبي بشر، بهذا الإسناد نحوه، إلا أنه قال: فقال له عبد الرحمن بن عوف: أتسأله ولنا 
ms1091	 ابن مثله؟ هذا حديث حسن صحيح (@)PageV05P450 (@)(@) (@)(@@)(@@)(@@) || باب ومن سورة تبت (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٦٣ - (@)(@@) حدثنا هناد، وأحمد بن منيع قالا: حدثنا أبو معاوية قال: حدثنا الأعمش، عن عمرو بن مرة، عن سعيد بن جبير، عن ابن عباس، قال: صعد رسول الله صلى الله عليه وسلم ذات يوم على الصفا فنادى: (@)(@@) @MATN@ «يا صباحاه» ، (@)(@@) فاجتمعت إليه قريش، فقال: (@)(@@) @MATN@ «إني نذير لكم بين يدي عذاب شديد، أرأيتم لو أني أخبرتكم أن العدو ممسيكم أو مصبحكم أكنتم تصدقوني؟» (@)(@@) فقال أبو لهب: ألهذا جمعتنا؟ تبا لك، فأنزل الله: @QB@ {تبت يدا أبي لهب وتب} @QE@ [المسد: ١] : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@)(@) (@)(@@)(@@)(@@) || باب ومن سورة الإخلاص (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٦٤ - (@)(@@) حدثنا أحمد بن منيع قال: حدثنا أبو سعد هو الصغاني، عن أبي جعفر الرازي، عن الربيع بن أنس، عن أبي العالية، عن أبي بن كعب، أن المشركين قالوا لرسول الله صلى الله عليه وسلم: انسب لنا ربك، فأنزل الله: @QB@ {قل هو الله أحد الله الصمد} @QE@ [الإخلاص: ١] فالصمد: الذي لم يلد ولم يولد، PageV05P451 لأنه ليس شيء يولد إلا سيموت، وليس شيء يموت إلا سيورث، وإن الله عز وجل لا يموت ولا يورث: @QB@ {ولم يكن له كفوا أحد} @QE@ [الإخلاص: ٤] قال: (@)(@@) @MATN@ «لم يكن له شبيه ولا عدل وليس كمثله شيء» (@)(@@) (@) (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٦٥ - (@)(@@) حدثنا عبد بن حميد قال: حدثنا عبيد الله بن موسى، عن أبي جعفر الرازي، عن الربيع، عن أبي العالية، أن النبي صلى الله عليه وسلم ذكر آلهتهم فقالوا: انسب لنا ربك. قال: فأتاه جبريل بهذه السورة: قل هو الله أحد، فذكر نحوه ولم يذكر فيه، عن أبي بن كعب. وهذا أصح من حديث أبي سعد. وأبو سعد اسمه: محمد بن ميسر، وأبو جعفر الرازي اسمه: عيسى، وأبو العالية اسمه: رفيع وكان عبدا أعتقته امرأة سائبة (@)(@) (@)(@@)(@@)(@@) || باب ومن سورة المعوذتين (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٦٦ - (@)(@@) حدثنا محمد بن المثنى قال: حدثنا عبد الملك بن عمرو العقدي، عن ابن أبي ذئب، عن الحارث بن عبد الرحمن، عن أبي سلمة، عن عائشة، أن النبي صلى الله عليه وسلم نظر إلى القمر، فقال: (@)(@@) @MATN@ «يا عائشة 
ms1092	 استعيذي بالله من شر هذا، فإن هذا هو الغاسق إذا وقب» : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@)PageV05P452 (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٦٧ - (@)(@@) حدثنا محمد بن بشار قال: حدثنا يحيى بن سعيد، عن إسماعيل بن أبي خالد قال: حدثني قيس وهو ابن أبي حازم، عن عقبة بن عامر الجهني، عن النبي صلى الله عليه وسلم قال: (@)(@@) @MATN@ " قد أنزل الله علي آيات لم ير مثلهن: @QB@ {قل أعوذ برب الناس} @QE@ [الناس: ١] إلى آخر السورة، و @QB@ {قل أعوذ برب الفلق} @QE@ [الفلق: ١] إلى آخر السورة " : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@)(@) (@)(@@)(@@)(@@) || باب (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٦٨ - (@)(@@) حدثنا محمد بن بشار قال: حدثنا صفوان بن عيسى قال: حدثنا الحارث بن عبد الرحمن بن أبي ذباب، عن سعيد بن أبي سعيد المقبري، عن أبي هريرة، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ " لما خلق الله آدم ونفخ فيه الروح عطس فقال: الحمد لله، فحمد الله بإذنه، فقال له ربه: رحمك الله يا آدم، اذهب إلى أولئك الملائكة، إلى ملإ منهم جلوس، فقل: السلام عليكم، قالوا: وعليك السلام ورحمة الله، ثم رجع إلى ربه، فقال: إن هذه تحيتك وتحية بنيك، بينهم، فقال الله له ويداه مقبوضتان: اختر أيهما شئت، قال: اخترت يمين ربي وكلتا يدي ربي يمين مباركة ثم بسطها فإذا فيها آدم وذريته، فقال: أي رب، ما هؤلاء؟ فقال: هؤلاء ذريتك، فإذا كل إنسان مكتوب عمره بين عينيه، فإذا فيهم رجل أضوؤهم - أو من أضوئهم - قال: يا رب من هذا؟ قال: هذا ابنك داود PageV05P453 قد كتبت له عمر أربعين سنة. قال: يا رب زده في عمره. قال: ذاك الذي كتب له. قال: أي رب، فإني قد جعلت له من عمري ستين سنة. قال: أنت وذاك. قال: ثم أسكن الجنة ما شاء الله، ثم أهبط منها، فكان آدم يعد لنفسه، قال: فأتاه ملك الموت، فقال له آدم: قد عجلت، قد كتب لي ألف سنة. قال: بلى ولكنك جعلت لابنك داود ستين سنة، فجحد فجحدت ذريته، ونسي فنسيت ذريته. قال: فمن يومئذ أمر بالكتاب والشهود " : (@)(@@) @MATN@ «هذا حديث حسن غريب 
ms1093	 من هذا الوجه، وقد روي من غير وجه عن أبي هريرة، عن النبي صلى الله عليه وسلم» (@)(@@) من رواية زيد بن أسلم، عن أبي صالح، عن أبي هريرة، عن النبي صلى الله عليه وسلم (@) (@)(@) (@)(@@)(@@)(@@) || باب (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٦٩ - (@)(@@) حدثنا محمد بن بشار قال: حدثنا يزيد بن هارون قال: حدثنا العوام بن حوشب، عن سليمان بن أبي سليمان، عن أنس بن مالك، عن النبي صلى الله عليه وسلم قال: (@)(@@) @MATN@ " لما خلق الله الأرض جعلت تميد، فخلق الجبال، فقال بها عليها فاستقرت، فعجبت الملائكة من شدة الجبال. قالوا: يا رب هل من خلقك شيء أشد من الجبال؟ قال: نعم الحديد. PageV05P454 قالوا: يا رب فهل من خلقك شيء أشد من الحديد؟ قال: نعم النار. فقالوا: يا رب فهل من خلقك شيء أشد من النار؟ قال: نعم الماء. قالوا: يا رب فهل من خلقك شيء أشد من الماء؟ قال: نعم الريح. قالوا: يا رب فهل من خلقك شيء أشد من الريح؟ قال: نعم ابن آدم، تصدق بصدقة بيمينه يخفيها من شماله " : (@)(@@) @MATN@ «هذا حديث غريب لا نعرفه مرفوعا إلا من هذا الوجه» (@)(@@) (@) (@)(@) (@)(@@)(@@)(@@) | ٤٥ - أبواب الدعوات عن رسول الله صلى الله عليه وسلم (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في فضل الدعاء (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٧٠ - (@)(@@) حدثنا عباس بن عبد العظيم العنبري قال: حدثنا أبو داود الطيالسي قال: حدثنا عمران القطان، عن قتادة، عن سعيد بن أبي الحسن، عن أبي هريرة، عن النبي صلى الله عليه وسلم قال: (@)(@@) @MATN@ «ليس شيء أكرم على الله تعالى من الدعاء» : (@)(@@) @MATN@ «هذا حديث غريب، لا نعرفه مرفوعا إلا من حديث عمران القطان، وعمران القطان هو ابن داور ويكنى أبا العوام» (@)(@@) حدثنا محمد بن بشار قال: حدثنا عبد الرحمن بن مهدي، عن عمران القطان، بهذا الإسناد نحوه (@)PageV05P455 (@)(@) (@)(@@)(@@)(@@) || باب منه (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٧١ - (@)(@@) حدثنا علي بن حجر قال: أخبرنا الوليد بن مسلم، عن ابن لهيعة، عن عبيد الله بن أبي جعفر، عن أبان بن صالح، عن أنس بن مالك، عن النبي صلى الله عليه وسلم قال: (@)(@@) @MATN@ «الدعاء مخ العبادة» : (@)(@@) @MATN@ «هذا حديث غريب من 
ms1094	 هذا الوجه لا نعرفه إلا من حديث ابن لهيعة» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٧٢ - (@)(@@) حدثنا أحمد بن منيع قال: حدثنا مروان بن معاوية، عن الأعمش، عن ذر، عن يسيع، عن النعمان بن بشير، عن النبي صلى الله عليه وسلم قال: (@)(@@) @MATN@ «الدعاء هو العبادة» (@)(@@) ثم قرأ: @QB@ {وقال ربكم ادعوني أستجب لكم إن الذين يستكبرون عن عبادتي سيدخلون جهنم داخرين} @QE@ [غافر: ٦٠] : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) وقد رواه منصور، والأعمش، عن ذر، ولا نعرفه إلا من حديث ذر (@)(@) (@)(@@)(@@)(@@) || باب منه (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٧٣ - (@)(@@) حدثنا قتيبة قال: حدثنا حاتم بن إسماعيل، عن أبي المليح، عن أبي صالح، عن أبي هريرة، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «إنه من لم يسأل الله يغضب عليه» : (@)(@@) وقد روى وكيع، عن غير واحد، عن أبي المليح، هذا الحديث ولا نعرفه PageV05P456 إلا من هذا الوجه. حدثنا إسحاق بن منصور قال: حدثنا أبو عاصم، عن حميد أبي المليح، عن أبي صالح، عن أبي هريرة، عن النبي صلى الله عليه وسلم نحوه. حميد هذا يقال له: الفارسي سكن المدينة (@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في فضل الذكر (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٧٥ - (@)(@@) حدثنا أبو كريب قال: حدثنا زيد بن حباب، عن معاوية بن صالح، عن عمرو بن قيس، عن عبد الله بن بسر، أن رجلا قال: يا رسول الله إن شرائع الإسلام قد كثرت علي، فأخبرني بشيء أتشبث به، قال: (@)(@@) @MATN@ «لا يزال لسانك رطبا من ذكر الله» : (@)(@@) @MATN@ «هذا حديث حسن غريب من هذا الوجه» (@)(@@) (@)PageV05P457 (@)(@) (@)(@@)(@@)(@@) || باب منه (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٧٦ - (@)(@@) حدثنا قتيبة قال: حدثنا ابن لهيعة، عن دراج، عن أبي الهيثم، عن أبي سعيد الخدري، أن رسول الله صلى الله عليه وسلم سئل أي العباد أفضل درجة عند الله يوم القيامة؟ قال: (@)(@@) @MATN@ «الذاكرون الله كثيرا والذاكرات» . (@)(@@) قال: قلت: يا رسول الله ومن الغازي في سبيل الله؟ قال: (@)(@@) @MATN@ «لو ضرب بسيفه في الكفار والمشركين حتى ينكسر ويختضب دما لكان الذاكرون الله كثيرا أفضل منه درجة» . (@)(@@) هذا حديث غريب إنما نعرفه من حديث دراج (@)PageV05P458 (@)(@) (@)(@@)(@@)(@@) || باب منه (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٧٧ - (@)(@@) حدثنا الحسين بن حريث قال: حدثنا الفضل بن موسى، 
ms1095	 عن عبد الله بن سعيد هو ابن أبي هند، عن زياد، مولى ابن عياش عن أبي بحرية، عن أبي الدرداء، قال: قال النبي صلى الله عليه وسلم: (@)(@@) @MATN@ «ألا أنبئكم بخير أعمالكم، وأزكاها عند مليككم، وأرفعها في درجاتكم وخير لكم من إنفاق الذهب والورق، وخير لكم من أن تلقوا عدوكم فتضربوا أعناقهم ويضربوا أعناقكم» ؟ (@)(@@) قالوا: بلى. قال: (@)(@@) @MATN@ «ذكر الله تعالى» (@)(@@) قال معاذ بن جبل: (@)(@@) @MATN@ «ما شيء أنجى من عذاب الله من ذكر الله» (@)(@@) وقد روى بعضهم هذا الحديث عن عبد الله بن سعيد، مثل هذا بهذا الإسناد، وروى بعضهم عنه فأرسله (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في القوم يجلسون فيذكرون الله عز وجل ما لهم من الفضل (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٧٨ - (@)(@@) حدثنا محمد بن بشار قال: حدثنا عبد الرحمن بن مهدي قال: حدثنا سفيان، عن أبي إسحاق، عن الأغر أبي مسلم، أنه شهد على أبي هريرة، وأبي سعيد الخدري، أنهما شهدا على رسول الله صلى الله عليه وسلم أنه قال: PageV05P459 (@)(@@) @MATN@ «ما من قوم يذكرون الله إلا حفت بهم الملائكة، وغشيتهم الرحمة، ونزلت عليهم السكينة، وذكرهم الله فيمن عنده» . (@)(@@) حدثنا يوسف بن يعقوب قال: حدثنا حفص بن عمر قال: حدثنا شعبة، عن أبي إسحاق، قال: سمعت الأغر أبا مسلم، قال: أشهد على أبي سعيد، وأبي هريرة، أنهما شهدا على رسول الله صلى الله عليه وسلم فذكر مثله. هذا حديث حسن صحيح (@) (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٧٩ - (@)(@@) حدثنا محمد بن بشار قال: حدثنا مرحوم بن عبد العزيز العطار قال: حدثنا أبو نعامة، عن أبي عثمان النهدي، عن أبي سعيد الخدري، قال: خرج معاوية، إلى المسجد فقال: ما يجلسكم؟ قالوا: جلسنا نذكر الله. قال: آلله ما أجلسكم إلا ذاك؟ قالوا: والله ما أجلسنا إلا ذاك. قال: أما إني لم أستحلفكم تهمة لكم، وما كان أحد بمنزلتي من رسول الله صلى الله عليه وسلم أقل حديثا عنه مني، إن رسول الله صلى الله عليه وسلم خرج على حلقة من أصحابه فقال: (@)(@@) @MATN@ «ما يجلسكم؟» (@)(@@) قالوا: جلسنا نذكر الله ونحمده لما هدانا للإسلام ومن علينا به، 
ms1096	 فقال: (@)(@@) @MATN@ «آلله ما أجلسكم إلا ذاك؟» (@)(@@) قالوا: آلله ما أجلسنا إلا ذاك. قال: (@)(@@) @MATN@ «أما إني لم أستحلفكم لتهمة لكم، إنه أتاني جبريل وأخبرني أن الله يباهي بكم الملائكة» : (@)(@@) @MATN@ " هذا حديث حسن غريب لا نعرفه إلا من هذا الوجه، وأبو نعامة السعدي اسمه: عمرو بن عيسى، وأبو عثمان النهدي اسمه عبد الرحمن بن مل " (@)PageV05P460 (@)(@) (@)(@@)(@@)(@@) || باب في القوم يجلسون ولا يذكرون الله (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٨٠ - (@)(@@) حدثنا محمد بن بشار قال: حدثنا عبد الرحمن بن مهدي قال: حدثنا سفيان، عن صالح، مولى التوأمة، عن أبي هريرة، عن النبي صلى الله عليه وسلم قال: (@)(@@) @MATN@ «ما جلس قوم مجلسا لم يذكروا الله فيه، ولم يصلوا على نبيهم، إلا كان عليهم ترة، فإن شاء عذبهم وإن شاء غفر لهم» : (@)(@@) @MATN@ " هذا حديث حسن، وقد روي من غير وجه عن أبي هريرة، عن النبي صلى الله عليه وسلم، ومعنى قوله: ترة: يعني حسرة وندامة. وقال بعض أهل المعرفة بالعربية: الترة هو الثأر " (@)PageV05P461 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء أن دعوة المسلم مستجابة (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٨١ - (@)(@@) حدثنا قتيبة قال: حدثنا ابن لهيعة، عن أبي الزبير، عن جابر، قال: سمعت رسول الله صلى الله عليه وسلم يقول: (@)(@@) @MATN@ «ما من أحد يدعو بدعاء إلا آتاه الله ما سأل أو كف عنه من السوء مثله، ما لم يدع بإثم أو قطيعة رحم» (@)(@@) وفي الباب عن أبي سعيد، وعبادة بن الصامت (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٨٢ - (@)(@@) حدثنا محمد بن مرزوق قال: حدثنا عبيد بن واقد قال: حدثنا سعيد بن عطية الليثي، عن شهر بن حوشب، عن أبي هريرة، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «من سره أن يستجيب الله له عند الشدائد والكرب فليكثر الدعاء في الرخاء» : (@)(@@) @MATN@ «هذا حديث غريب» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٨٣ - (@)(@@) حدثنا يحيى بن حبيب بن عربي قال: حدثنا موسى بن إبراهيم بن كثير الأنصاري، قال: سمعت طلحة بن خراش، قال: سمعت جابر بن عبد الله، يقول: سمعت رسول الله صلى الله عليه وسلم يقول: (@)(@@) @MATN@ «أفضل الذكر لا إله إلا الله، وأفضل الدعاء الحمد لله» : (@)(@@) @MATN@ «هذا حديث حسن غريب لا نعرفه إلا 
ms1097	 من حديث موسى بن إبراهيم» (@)(@@) وقد روى علي بن المديني، وغير واحد عن موسى بن إبراهيم، هذا الحديث (@)PageV05P462 (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٨٤ - (@)(@@) حدثنا أبو كريب، ومحمد بن عبيد المحاربي، قالا: حدثنا يحيى بن زكريا بن أبي زائدة، عن أبيه، عن خالد بن سلمة، عن البهي، عن عروة، عن عائشة، قالت: (@)(@@) @MATN@ «كان رسول الله صلى الله عليه وسلم يذكر الله على كل أحيانه» : (@)(@@) @MATN@ " هذا حديث حسن غريب، لا نعرفه إلا من حديث يحيى بن زكريا بن أبي زائدة، والبهي اسمه: عبد الله " (@)(@) (@)(@@)(@@)(@@) || باب ما جاء أن الداعي يبدأ بنفسه (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٨٥ - (@)(@@) حدثنا نصر بن عبد الرحمن الكوفي قال: حدثنا أبو قطن، عن حمزة الزيات، عن أبي إسحاق، عن سعيد بن جبير، عن ابن عباس، عن أبي بن كعب، (@)(@@) @MATN@ «أن رسول الله صلى الله عليه وسلم كان إذا ذكر أحدا فدعا له بدأ بنفسه» : (@)(@@) @MATN@ " هذا حديث حسن غريب صحيح، وأبو قطن اسمه: عمرو بن الهيثم " (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في رفع الأيدي عند الدعاء (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٨٦ - (@)(@@) حدثنا أبو موسى محمد بن المثنى، وإبراهيم بن يعقوب، وغير واحد قالوا: حدثنا حماد بن عيسى الجهني، عن حنظلة بن أبي سفيان PageV05P463 الجمحي، عن سالم بن عبد الله، عن أبيه، عن عمر بن الخطاب، قال: (@)(@@) @MATN@ «كان رسول الله صلى الله عليه وسلم إذا رفع يديه في الدعاء، لم يحطهما حتى يمسح بهما وجهه» (@)(@@) قال محمد بن المثنى في حديثه: لم يردهما حتى يمسح بهما وجهه: (@)(@@) @MATN@ «هذا حديث غريب، لا نعرفه إلا من حديث حماد بن عيسى، وقد تفرد به وهو قليل الحديث، وقد حدث عنه الناس، وحنظلة بن أبي سفيان الجمحي هو ثقة، وثقه يحيى بن سعيد القطان» (@)(@@) (@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء فيمن يستعجل في دعائه (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٨٧ - (@)(@@) حدثنا الأنصاري قال: حدثنا معن قال: حدثنا مالك، عن ابن شهاب، عن أبي عبيد، مولى ابن أزهر، عن أبي هريرة، عن النبي صلى الله عليه وسلم قال: (@)(@@) @MATN@ " يستجاب لأحدكم ما لم يعجل، يقول: دعوت فلم يستجب لي " : (@)(@@) @MATN@ «هذا حديث حسن صحيح» ، (@)(@@) وأبو عبيد اسمه: سعد، وهو 
ms1098	 مولى عبد الرحمن بن أزهر، ويقال: مولى عبد الرحمن بن عوف، وعبد الرحمن بن أزهر هو ابن عم عبد الرحمن بن عوف ": وفي الباب عن أنس (@)PageV05P464 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في الدعاء إذا أصبح وإذا أمسى (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٨٨ - (@)(@@) حدثنا محمد بن بشار قال: حدثنا أبو داود وهو الطيالسي قال: حدثنا عبد الرحمن بن أبي الزناد، عن أبيه، عن أبان بن عثمان، قال: سمعت عثمان بن عفان، يقول: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ " ما من عبد يقول في صباح كل يوم ومساء كل ليلة: بسم الله الذي لا يضر مع اسمه شيء في الأرض ولا في السماء، وهو السميع العليم ثلاث مرات، فيضره شيء " وكان أبان، قد أصابه طرف فالج، فجعل الرجل ينظر إليه، فقال له أبان: (@)(@@) @MATN@ «ما تنظر؟ أما إن الحديث كما حدثتك، ولكني لم أقله يومئذ ليمضي الله علي قدره» : (@)(@@) @MATN@ «هذا حديث حسن صحيح غريب» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٨٩ - (@)(@@) حدثنا أبو سعيد الأشج قال: حدثنا عقبة بن خالد، عن أبي سعد سعيد بن المرزبان، عن أبي سلمة، عن ثوبان، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ " من قال حين يمسي: رضيت بالله ربا، وبالإسلام دينا، وبمحمد نبيا، كان حقا على الله أن يرضيه " : (@)(@@) @MATN@ «هذا حديث حسن غريب من هذا الوجه» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٩٠ - (@)(@@) حدثنا سفيان بن وكيع قال: حدثنا جرير، عن الحسن بن عبيد الله، عن إبراهيم بن سويد، عن عبد الرحمن بن يزيد، عن عبد الله، PageV05P465 قال: كان النبي صلى الله عليه وسلم إذا أمسى قال: (@)(@@) @MATN@ " أمسينا وأمسى الملك لله، والحمد لله ولا إله إلا الله وحده لا شريك له - أراه قال -: له الملك وله الحمد، وهو على كل شيء قدير، أسألك خير ما في هذه الليلة وخير ما بعدها، وأعوذ بك من شر هذه الليلة وشر ما بعدها، وأعوذ بك من الكسل وسوء الكبر، وأعوذ بك من عذاب النار وعذاب القبر " وإذا أصبح قال ذلك أيضا: (@)(@@) @MATN@ «أصبحنا وأصبح الملك لله والحمد لله» : (@)(@@) @MATN@ «هذا حديث حسن» (@)(@@) وقد رواه شعبة، بهذا الإسناد، عن 
ms1099	 ابن مسعود، ولم يرفعه (@) (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٩١ - (@)(@@) حدثنا علي بن حجر قال: حدثنا عبد الله بن جعفر قال: أخبرنا سهيل بن أبي صالح، عن أبيه، عن أبي هريرة، قال: كان رسول الله صلى الله عليه وسلم يعلم أصحابه يقول: (@)(@@) @MATN@ " إذا أصبح أحدكم فليقل: اللهم بك أصبحنا، وبك أمسينا، وبك نحيا وبك نموت وإليك المصير، وإذا أمسى فليقل: اللهم بك أمسينا وبك أصبحنا وبك نحيا وبك نموت وإليك النشور " : (@)(@@) @MATN@ «هذا حديث حسن» (@)(@@) (@)PageV05P466 (@)(@) (@)(@@)(@@)(@@) || باب منه (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٩٢ - (@)(@@) حدثنا محمود بن غيلان قال: حدثنا أبو داود، قال: أخبرنا شعبة، عن يعلى بن عطاء، قال: سمعت عمرو بن عاصم الثقفي، يحدث عن أبي هريرة، قال: قال أبو بكر: يا رسول الله مرني بشيء أقوله إذا أصبحت وإذا أمسيت؟ قال: (@)(@@) @MATN@ " قل: اللهم عالم الغيب والشهادة، فاطر السموات والأرض، رب كل شيء ومليكه، أشهد أن لا إله إلا أنت، أعوذ بك من شر نفسي ومن شر الشيطان وشركه، قال: قله إذا أصبحت، وإذا أمسيت، وإذا أخذت مضجعك " : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@)(@) (@)(@@)(@@)(@@) || باب منه (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٩٣ - (@)(@@) حدثنا الحسين بن حريث قال: حدثنا عبد العزيز بن أبي حازم، عن كثير بن زيد، عن عثمان بن ربيعة، عن شداد بن أوس: أن النبي صلى الله عليه وسلم قال له: (@)(@@) @MATN@ " ألا أدلك على سيد الاستغفار: اللهم أنت ربي، لا إله إلا أنت، خلقتني وأنا عبدك، وأنا على عهدك ووعدك PageV05P467 ما استطعت، أعوذ بك من شر ما صنعت، وأبوء لك بنعمتك علي، وأعترف بذنوبي، فاغفر لي ذنوبي إنه لا يغفر الذنوب إلا أنت، لا يقولها أحدكم حين يمسي فيأتي عليه قدر قبل أن يصبح إلا وجبت له الجنة، ولا يقولها حين يصبح فيأتي عليه قدر قبل أن يمسي إلا وجبت له الجنة " وفي الباب عن أبي هريرة، وابن عمر، وابن مسعود، وابن أبزى، وبريدة. وهذا حديث حسن غريب من هذا الوجه، وعبد العزيز بن أبي حازم هو ابن أبي حازم الزاهد، وقد روي هذا الحديث من غير هذا الوجه، عن شداد بن أوس (@) (@)(@) (@)(@@)(@@)(@@) || باب ما 
ms1100	 جاء في الدعاء إذا أوى إلى فراشه (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٩٤ - (@)(@@) حدثنا ابن أبي عمر قال: حدثنا سفيان بن عيينة، عن أبي إسحاق الهمداني، عن البراء بن عازب، أن النبي صلى الله عليه وسلم قال له: (@)(@@) @MATN@ " ألا أعلمك كلمات تقولها إذا أويت إلى فراشك، فإن مت من ليلتك مت على الفطرة، وإن أصبحت أصبحت وقد أصبت خيرا، تقول: اللهم أسلمت نفسي إليك، ووجهت وجهي إليك، وفوضت أمري إليك، PageV05P468 رغبة ورهبة إليك، وألجأت ظهري إليك، لا ملجأ ولا منجى منك إلا إليك، آمنت بكتابك الذي أنزلت وبنبيك الذي أرسلت " قال البراء: فقلت: وبرسولك الذي أرسلت، قال: فطعن بيده في صدري، ثم قال: (@)(@@) @MATN@ «وبنبيك الذي أرسلت» . (@)(@@) هذا حديث حسن صحيح غريب، قد روي من غير وجه عن البراء. ورواه منصور بن المعتمر، عن سعد بن عبيدة، عن البراء، عن النبي صلى الله عليه وسلم نحوه، إلا أنه قال: (@)(@@) @MATN@ «إذا أويت إلى فراشك وأنت على وضوء» . (@)(@@) وفي الباب عن رافع بن خديج (@) (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٩٥ - (@)(@@) حدثنا محمد بن بشار قال: حدثنا عثمان بن عمر قال: حدثنا علي بن المبارك، عن يحيى بن أبي كثير، عن يحيى بن إسحاق، ابن أخي رافع بن خديج، عن رافع بن خديج: أن النبي صلى الله عليه وسلم قال: (@)(@@) @MATN@ " إذا اضطجع أحدكم على جنبه الأيمن ثم قال: اللهم أسلمت نفسي إليك، ووجهت وجهي إليك، وألجأت ظهري إليك، وفوضت أمري إليك، لا ملجأ منك إلا إليك، أومن بكتابك وبرسولك، فإن مات من ليلته دخل الجنة " : (@)(@@) @MATN@ «هذا حديث حسن غريب من هذا الوجه من حديث رافع بن خديج» (@)(@@) (@)PageV05P469 (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٩٦ - (@)(@@) حدثنا إسحاق بن منصور قال: أخبرنا عفان بن مسلم قال: حدثنا حماد بن سلمة، عن ثابت، عن أنس بن مالك: أن رسول الله صلى الله عليه وسلم كان إذا أوى إلى فراشه قال: (@)(@@) @MATN@ «الحمد لله الذي أطعمنا وسقانا وكفانا وآوانا، فكم ممن لا كافي له ولا مؤوي» : (@)(@@) @MATN@ «هذا حديث حسن صحيح غريب» (@)(@@) (@)(@) (@)(@@)(@@)(@@) || باب منه (@)(@) (@)(@@)(@@)(@@) ||| ٣٣٩٧ - (@)(@@) حدثنا صالح بن عبد الله قال: حدثنا أبو معاوية، عن الوصافي، 