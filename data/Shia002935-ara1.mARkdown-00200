ms181	 ابنا محمد الأشعريان، روى الحسن بن علي بن فضال(@)PageV00P435(@)(@@) عنهما.(@)(@@)(@)(@@)(@@)(@@) $ 6236 - الفضل بن أبي قرة، روى حميد عن إبراهيم بن سليمان عن الفضل.(@)(@@)(@@)(@@) $ 6237 - فضالة بن أيوب، روى عنه الحسين بن سعيد. 1(@)(@@)(@@)(@@) $ 6238 - فيهس.(@)(@@)(@)(@@)(@@)(@@) $ 6239 - الفتح بن يزيد الجرجاني.(@)(@@)(@@)(@@) || باب القاف(@)(@@)(@@)(@@) $ 6240 - القاسم بن محمد الاباركني، من أصحاب العياشي. 2(@)(@@)(@@)(@@) $ 6241 - القاسم بن إسماعيل القرشي، يكنى أبا محمد المنذر، روى عنه حميد ابن زياد أصولا كثيرة.(@)(@@)(@)(@@)(@@)(@@) $ 6242 - قنبرة بن علي بن شاذان، يكنى أبا نصر، روى عن أبيه، عن الفضل بن شاذان، روى عنه حمزة بن محمد العلوي الذي روى عنه ابن بابويه.(@)(@@)(@)(@@)(@@)(@@) $ 6243 - القاسم بن العلا الهمداني، وكان جليل القدر، روى عنه الصفواني.(@)(@@)(@)(@@)(@@)(@@) $ 6244 - القاسم بن محمد الجوهري، روى عنه الحسين بن سعيد.(@)(@@)(@)(@@)(@@)(@@) $ 6245 - القاسم بن يحيى، روى عنه أحمد بن محمد بن عيسى.(@)(@@)(@)(@@)(@@)(@@) $ 6246 - القاسم بن محمد الأصفهاني، المعروف بكاسام، روى عنه أحمد بن أبي عبد الله.(@)(@@)(@)(@@)(@@)(@@) $ 6247 - القاسم بن عروة، روى عنه البرقي أحمد.(@)(@@)(@)(@@)(@@)(@@) $ 6248 - قتيبة الأعشي، روى حميد عن القاسم بن إسماعيل عنه.(@)(@@)(@@)(@@) || باب الكاف(@)(@@)(@@)(@@) $ 6249 - كليب بن معاوية الأسدي، روى عنه صفوان.(@)PageV00P436(@)(@@)(@@)(@@) || باب اللام(@)(@@)(@@)(@@) $ 6250 - الليث بن نصر، من أصحاب العياشي.(@)(@@)(@@)(@@) || باب الميم(@)(@@)(@@)(@@) $ 6251 - محمد بن الحسن القمي، وليس بابن الوليد إلا أنه نظيره، روى عن جميع شيوخه، روى عن سعد وعن الحميري والأشعريين محمد بن أحمد بن يحيى و غيرهم، روى عنه التلعكبري إجازة.(@)(@@)(@)(@@)(@@)(@@) $ 6252 - محمد بن علي ماجيلويه القمي، روى عنه محمد بن علي بن الحسين بن بابويه.(@)(@@)(@)(@@)(@@)(@@) $ 6253 - محمد بن موسى بن المتوكل، روى عن عبد الله بن جعفر الحميري، روى عنه ابن بابويه.(@)(@@)(@)(@@)(@@)(@@) $ 6254 - محمد بن أحمد بن هشام، روى عن علي بن الحسين بن بابويه.(@)(@@)(@)(@@)(@@)(@@) $ 6255 - محمد بن السندي، روى عن علي بن الحكم.(@)(@@)(@)(@@)(@@)(@@) $ 6256 - محمد بن عبد الحميد، روى عنه ابن الوليد.(@)(@@)(@)(@@)(@@)(@@) $ 6257 - موسى بن رنجوية الأرمني، يكنى أبا عمران، روى عن عبد الله بن الحكم، روى أحمد بن إدريس عن محمد بن حسان عن أبي عمران.(@)(@@)(@)(@@)(@@)(@@) $ 6258 
ms182	 - المختار بن بلال بن المختار بن أبي عبيد، روى عن فتح بن يزيد الجرجاني، روى عنه الصفار. 1(@)(@@)(@@)(@@) $ 6259 - محمد بن الحسين بن عبد العزيز، روى عن محمد بن عيسى الطلحي، روى عنه ابن الوليد.(@)(@@)(@)(@@)(@@)(@@) $ 6260 - محمد بن حفص بن غياث، روى عن أبيه، روى عنه محمد بن الوليد(@)PageV00P437(@)(@@) الخزاز، وروى عن محمد بن الحسن الصفار، والحميري، وسعد 1(@)(@@)(@@)(@@) $ 6261 - محمد بن خالد الطيالسي، روى عنه علي بن الحسن بن فضال و سعد ابن عبد الله.(@)(@@)(@)(@@)(@@)(@@) $ 6262 - محمد بن أحمد بن يحيى الأشعري، صاحب نوادر الحكمة، وقد ذكرناه في الفهرست، روى عنه سعد ومحمد بن يحيى وأحمد بن إدريس.(@)(@@)(@)(@@)(@@)(@@) $ 6263 - محمد بن يحيى المعاذي.(@)(@@)(@)(@@)(@@)(@@) $ 6264 - ومحمد بن علي الهمداني.(@)(@@)(@)(@@)(@@)(@@) $ 6265 - ومحمد بن هارون.(@)(@@)(@)(@@)(@@)(@@) $ 6266 - ومموية.(@)(@@)(@)(@@)(@@)(@@) $ 6267 - ومحمد بن عبد الله بن مهران ضعفاء، روى عنهم محمد بن أحمد بن يحيى.(@)(@@)(@)(@@)(@@)(@@) $ 6268 - محمد بن علي بن محبوب الأشعري، له تصانيف ذكرناها في الفهرست، روى عنه أحمد بن إدريس ومحمد بن يحيى العطار وغيرهما.(@)(@@)(@)(@@)(@@)(@@) $ 6269 - محمد بن بندار بن عاصم، المعروف بالذهلي، روى عنه الحسين بن محمد ابن عامر، الذي روى عنه ابن الوليد.(@)(@@)(@)(@@)(@@)(@@) $ 6270 - محمد بن همام البغدادي، يكنى أبا علي، وهمام يكنى أبا بكر،(@)PageV00P438(@)(@@) جليل القدر، ثقة، روى عنه التلعكبري وسمع منه أولا سنة ثلاث وعشرين و ثلاثمائة وله منه إجازة، ومات سنة اثنتين وثلاثين وثلاثمائة.(@)(@@)(@)(@@)(@@)(@@) $ 6271 - محمد بن عبد الله الحميري، أبو جعفر، قمي.(@)(@@)(@)(@@)(@@)(@@) $ 6272 - محمد بن قولويه الجمال، والد أبي القاسم جعفر بن محمد، يروي عن سعد بن عبد الله وغيره.(@)(@@)(@)(@@)(@@)(@@) $ 6273 - محمد بن الحسن بن أحمد بن الوليد القمي، جليل القدر بصير بالفقه، ثقة، يروي عن الصفار وسعد، روى عنه التلعكبري وذكر انه يلقه لكن وردت عليه إجازته علي يد صاحبه جعفر بن الحسين المؤمن بجميع رواياته، أخبرنا عنه أبو الحسين ابن أبي جيد بجميع رواياته. 1(@)(@@)(@@)(@@) $ 6274 - محمد بن يحيى العطار، روى عنه الكليني، قمي، كثير الرواية.(@)(@@)(@)(@@)(@@)(@@) $ 6275 - محمد بن علي بن الحسين بن بابويه القمي، 
ms183	 يكنى أبا جعفر، جليل القدر حفظة، بصير بالفقه والاخبار والرجال، له مصنفات كثيره ذكرناها في الفهرست، روى عنه التلعكبري، أخبرنا عنه جماعة، منهم محمد بن محمد بن النعمان والحسين ابن عبيد الله.(@)(@@)(@)(@@)(@@)(@@) $ 6276 - محمد بن يحيى، يكنى أبا الحسن الفارسي، يروي عن خلق، و طاف الدنيا وجمع كثيرا من الاخبار.(@)(@@)(@)(@@)(@@)(@@) $ 6277 - محمد بن يعقوب الكليني، يكنى أبا جعفر الأعور، جليل القدر عالم بالاخبار، وله مصنفات يشتمل عليها الكتاب المعروف بالكافي، مات سنة تسع و عشرين وثلاثمائة في شعبان ببغداد ودفن بباب الكوفة، وذكرنا كتبه في الفهرست.(@)(@@)(@)(@@)(@@)(@@) $ 6278 - محمد بن جعفر الأسدي، يكنى أبا الحسين الرازي، كان أحد الأبواب.(@)(@@)(@)(@@)(@@)(@@) $ 6279 - محمد بن إبراهيم، المعروف بعلان الكليني، خير.(@)PageV00P439(@)(@@)(@)(@@)(@@)(@@) $ 6280 - محمد بن إسماعيل، يكنى، أبا الحسن، نيسابوري، يدعي بندقي. 1(@)(@@)(@@)(@@) $ 6281 - مكي بن علي بن سختويه، فاضل.(@)(@@)(@)(@@)(@@)(@@) $ 6282 - محمد بن مسعود بن محمد بن عياش السمرقندي، يكنى أبا النضر، أكثر أهل المشرق علما وفضلا وأدبا وفهما ونبلا في زمانه، صنف أكثر من مائتي مصنف ذكرناها في الفهرست، وكان له مجلس للخاص ومجلس للعام رحمه الله.(@)(@@)(@)(@@)(@@)(@@) $ 6283 - محمد بن إبراهيم الوراق، من أهل سمرقند.(@)(@@)(@)(@@)(@@)(@@) $ 6284 - محمد بن نصير، من أهل كش، ثقة جليل القدر كثير العلم، روى عنه أبو عمرو الكشي.(@)(@@)(@)(@@)(@@)(@@) $ 6285 - محمد بن الحسن البراني، يكنى أبا بكر، كانت له رواية.(@)(@@)(@)(@@)(@@)(@@) $ 6286 - محمد بن سعد، أبا الحسن، من أهل كش صالح مستقيم المذهب. 2(@)(@@)(@@)(@@) $ 6287 - محمد بن أحمد بن أبي عوف، من أهل بخاري، لا بأس به.(@)(@@)(@)(@@)(@@)(@@) $ 6288 - محمد بن عمر بن عبد العزيز الكشي، يكنى أبا عمرو، صاحب كتاب الرجال، من غلمان العياشي، ثقة بصير بالرجال والاخبار، مستقيم المذهب. 3(@)(@@)(@@)(@@) $ 6289 - محمد بن طاهر بن جمهور، من غلمان العياشي.(@)(@@)(@)(@@)(@@)(@@) $ 6290 - محمد بن نعيم الخياط، أمي الا انه كان حافظا، يروي عن العياشي.(@)(@@)(@)(@@)(@@)(@@) $ 6291 - محمد بن يحيى الضرير المؤدب، من غلمان العياشي.(@)(@@)(@)(@@)(@@)(@@) $ 6292 - محمد بن بلال المعلم.(@)(@@)(@)(@@)(@@)(@@) $ 6293 - محمد بن فتح المعلم.(@)(@@)(@)(@@)(@@)(@@) $ 6294 - محمد بن شعيب البوجاكني.(@)(@@)(@)(@@)(@@)(@@) $ 6295 - محمد بن يوسف بن يعقوب 
ms184	 الجعفري، الدين الزاهد، هؤلاء من أصحاب(@)PageV00P440(@)(@@) العياشي.(@)(@@)(@)(@@)(@@)(@@) $ 6296 - محمد بن يوسف الكرماني روى عنه أيضا. 1(@)(@@)(@@)(@@) $ 6297 - محمد بن الحسين الصائغ، روى عنه حميد، مات سنة تسع وستين و مائتين وصلي عليه جعفر بن عبد الله المحمدي ودفن في جعفي.(@)(@@)(@)(@@)(@@)(@@) $ 6298 - محمد بن موسى خوراء، يكنى أبا جعفر، روى عنه حميد.(@)(@@)(@)(@@)(@@)(@@) $ 6299 - محمد بن خليل بن راشد، روى عنه حميد.(@)(@@)(@)(@@)(@@)(@@) $ 6300 - محمد بن نافع، روى عنه حميد.(@)(@@)(@)(@@)(@@)(@@) $ 6301 - محمد بن عباس بن عيسى، روى عنه حميد كتبا كثيرة من الأصول.(@)(@@)(@)(@@)(@@)(@@) $ 6302 - محمد بن أحمد بن رجاء البجلي، يكنى أبا جعفر، روى عنه حميد كتبا كثيرة من الأصول، ومات سنة ست وستين ومائتين في طريق مكة وهو راجع، و دفن بذات عرق.(@)(@@)(@)(@@)(@@)(@@) $ 6303 - محمد بن عبد الله المسلي، روى عنه حميد نوادر، مات سنة ست وستين ومائتين وصلي عليه ابنه. 2(@)(@@)(@@)(@@) $ 6304 - محمد بن خالد الطيالسي، يكنى أبا عبد الله، روى عنه حميد أصولا كثيرة ومات سنة تسع وخمسين ومائتين، وله سبع وتسعون سنة.(@)(@@)(@)(@@)(@@)(@@) $ 6305 - محمد بن حسان عرزم، يكنى أبا جعفر، روى عنه حميد كتاب إبراهيم ابن أبي بكر بن أبي سمال. 3(@)(@@)(@@)(@@) $ 6306 - محمد بن الحسن بن حازم، يكنى أبا جعفر، روى عنه حميد أصولا كثيرة، مات سنة أحدي وستين ومائتين وصلي عليه قاسم بن حازم.(@)(@@)(@)(@@)(@@)(@@) $ 6307 - محمد بن جعفر بن محمد بن جعفر بن الحسن بن جعفر بن الحسن بن الحسن بن علي بن أبي طالب عليهما السلام، المعروف بابي قيراط، روى عنه(@)PageV00P441(@)(@@) التلعكبري، يكنى أبا الحسن وسمع منه سنة ثمان وعشرين وثلاثمائة وله منه إجازة.(@)(@@)(@)(@@)(@@)(@@) $ 6308 - المظفر بن جعفر بن محمد بن عبد الله بن محمد بن عمر بن علي بن أبي طالب عليه السلام، روى عنه التلعكبري إجازة كتب العياشي محمد بن مسعود ابن محمد بن عياش السلمي، عن أبيه جعفر بن محمد، عن أبيه أبي النضر، يكنى أبا طالب.(@)(@@)(@)(@@)(@@)(@@) $ 6309 - محمد بن أحمد بن عبيد الله بن أحمد بن عيسى بن المنصور، عباسي هاشمي، روى 
ms185	 عنه التلعكبري، يكنى أبا الحسن، يروي عن عمه أبي موسى عيسى بن أحمد بن عيسى بن المنصور، عن أبي محمد صاحب العسكر عليه السلام معجزات ودلائل.(@)(@@)(@)(@@)(@@)(@@) $ 6310 - محمد بن علي بن معمر الكوفي، يكنى أبا الحسين صاحب الصبيحي، سمع منه التلعكبري سنة تسع وعشرين وثلاثمائة وله منه إجازة. 1(@)(@@)(@@)(@@) $ 6311 - محمد بن القاسم بن زكريا المحاربي، المعروف بالسوداني، يكنى أبا عبد الله، روى عنه التلعكبري وسمع منه سنة أربع وعشرين وثلاثمائة، وله منه إجازة.(@)(@@)(@)(@@)(@@)(@@) $ 6312 - محمد بن الحسين بن حفص الخثعمي الأشناني الكوفي، يكنى أبا جعفر، روى عنه التلعكبري وسمع منه سنة خمس عشرة وثلاثمائة وفيما بعدها، مات سنة سبع عشرة وثلاثمائة، وله منه إجازة.(@)(@@)(@)(@@)(@@)(@@) $ 6313 - محمد بن محمد بن الأشعث الكوفي، يكنى أبا علي، ومسكنه بمصر في سقيفة جواد، يروي نسخة عن موسى بن إسماعيل بن موسى بن جعفر، عن أبيه إسماعيل بن موسى، عن أبيه موسى بن جعفر عليهما السلام، قال التلعكبري: أخذ لي والدي منه إجازة في سنة ثلاث عشرة وثلاثمائة. 2(@)PageV00P442(@)(@@)(@@)(@@) $ 6314 - محمد بن أحمد بن محمد بن عبد الله بن أبي الثلج الكاتب، بغدادي، خاصي، يكنى أبا بكر، سمع منه التلعكبري سنة اثنتين وعشرين وثلاثمائة وما بعدها إلي سنة خمس وعشرين، وفيها مات، وله منه إجازة.(@)(@@)(@@)(@@) $ 6315 - محمد بن أحمد بن الحسين الزعفراني العسكري، يكنى أبا عبد الرحمان المصري نزيل، بغداد، روى عنه التلعكبري، سمع منه سنة خمس وعشرين و ثلاثمائة، وله منه إجازة.(@)(@@)(@@)(@@) $ 6316 - محمد بن أحمد بن مخزوم المقري، يكنى أبا الحسين، مولي بني هاشم، بغدادي، روى عنه التلعكبري وسمع منه سنة ثلاثين وثلاثمائة وفيما بعدها، و له منه إجازة.(@)(@@)(@@)(@@) $ 6317 - محمد بن أحمد بن محمد بن سعيد بن عقدة الهمداني، يكنى أبا نعيم، كان جليل القدر عظيم الحفظ، روى عنه التلعكبري وسمع منه في حياة أبيه، وكان يروي عن حميد.(@)(@@)(@@)(@@) $ 6318 - محمد بن أحمد بن عبد الله بن قضاعة بن صفوان بن مهران الجمال، المعروف بالصفواني، يكنى أبا عبد الله، له مصنفات 
ms186	 ذكرناها في الفهرست، يروي عن علي بن إبراهيم بن هاشم، روى عنه التلعكبري، وأخبرنا عنه محمد بن محمد بن النعمان وأبو محمد الحسن بن القاسم العلوي المحمدي، وهو خاصي، نزيل بغداد.(@)(@@)(@@)(@@) $ 6319 - محمد بن الحسين بن سعيد بن عبد الله بن سعيد الطبري، يكنى أبا جعفر، خاصي، روى عنه التلعكبري وقال: سمعت منه سنة ثلاثين وثلاثمائة وفيما بعدها، وله منه إجازة، وسمع منه الدعاء الذي كتب به إلي أهل قم، وروى حديث ابن بغا لما توجه إلى قم.(@)(@@)(@@)(@@) $ 6320 - محمد بن علي بن الفضل بن تمام الدهقان الكوفي، يكنى أبا الحسين، روى عنه التلعكبري وسمع منه سنة أربعين وثلاثمائة، وله منه إجازة، وأخبرنا عنه أبو محمد المحمدي.(@)(@@)(@@)(@@) $ 6321 - محمد بن العباس بن علي بن مروان، المعروف بابن الحجام، يكنى PageV00P443(@)(@@) أبا عبد الله، سمع منه التلعكبري سنة ثمان وعشرين وثلاثمائة، وله منه إجازة.(@)(@@)(@)(@@)(@@)(@@) $ 6322 - محمد بن العباس بن الوليد النحوي، يكنى أبا الحسين، روى عنه التلعكبري.(@)(@@)(@)(@@)(@@)(@@) $ 6323 - محمد بن بكران بن حمدان، المعروف بالنقاش، من أهل قم، روى عنه التلعكبي، سمع منه سنة خمس وأربعين وثلاثمائة، وله منه إجازة.(@)(@@)(@)(@@)(@@)(@@) $ 6324 - محمد بن الحسن بن هارون الكندي، الطحان الكوفي، يكنى أبا جعفر، روى عنه التلعكبري. 1(@)(@@)(@@)(@@) $ 6325 - محمد بن داود بن سليمان الكاتب، يكنى أبا الحسن، روى عنه التلعكبري وذكر ان إجازة محمد بن محمد بن الأشعث الكوفي وصلت إليه علي يد هذا الرجل في سنة ثلاث عشره وثلاثمائة، وقال: سمعت منه في هذه السنة من الأشعثيات ما كان اسناده متصلا بالنبي صلى الله عليه وآله وسلم وما كان غير ذلك لم يروه عن صاحبه، وذكر التلعكبري ان سماعه هذه الأحاديث المتصلة الأسانيد من هذا الرجل، ورواية جميع النسخ بالإجازة عن محمد بن محمد بن الأشعث، وقال: ليس لي من هذا الرجل إجازة.(@)(@@)(@)(@@)(@@)(@@) $ 6326 - محمد بن موسى بن يعقوب السامري، بكرخ سامراء، يكنى أبا الحسن، روى عنه التلعكبري حديث الفص ولم يسمع منه غيره.(@)(@@)(@)(@@)(@@)(@@) $ 6327 - محمد بن وهبان بن محمد الهنائي، المعروف 
ms187	 بالدبيلي، يكنى أبا عبد الله، بصري، روى عنه التلعكبري، أخبرنا عنه أحمد بن إبراهيم القزويني، وكان يروي دعاء أويس القرني. 2(@)(@@)(@@)(@@) $ 6328 - محمد، شاكري أبي محمد الحسن بن علي العسكري عليهما السلام، يكنى أبا عبد الله، روى عنه التلعكبري حكايته لحال أبي محمد عليه السلام، قال: سمعته منه(@)PageV00P444(@)(@@) في دار أبي علي بن همام. 1(@)(@@)(@@)(@@) $ 6329 - محمد بن عمر بن محمد بن سلم بن البراء بن سبرة بن يسار التميمي القاضي، يكنى أبا بكر، المعروف بابن الجعابي الحافظ، بغدادي، روى عنه التلعكبري وأخبرنا عنه محمد بن محمد بن النعمان.(@)(@@)(@)(@@)(@@)(@@) $ 6330 - محمد بن عبد ربه الأنصاري، أجاز التلعكبري جميع حديثه، و كان يروي عن سعد بن عبد الله وعبد الله بن جعفر الحميري ونظرائهما علي يد أبي أحمد إسماعيل بن يحيى العبسي.(@)(@@)(@)(@@)(@@)(@@) $ 6331 - محمد بن جعفر القطني، يروي كتب الحسين بن سعيد عن عبد السلام ابن عبد الوهاب عن الحسين والحسن ابني سعيد، روى عنه التلعكبري.(@)(@@)(@)(@@)(@@)(@@) $ 6332 - محمد بن أحمد، يكنى أبا الحسين الزاهد، من أهل طوس، روى عنه التلعكبري إجازة. 2(@)(@@)(@@)(@@) $ 6333 - محمد بن أحمد العلوي، روى عنه أحمد بن إدريس.(@)(@@)(@)(@@)(@@)(@@) $ 6334 - محمد بن حسان الرازي، روى عنه الصفار وغيره.(@)(@@)(@)(@@)(@@)(@@) $ 6335 - محمد بن القاسم بن بشار، روى عنه سعد والحميري.(@)(@@)(@)(@@)(@@)(@@) $ 6336 - محمد بن عبد الله بن جعفر الحميري، روى عنه أحمد بن هارون الفامي وجعفر بن الحسين، روى عنهما محمد بن علي بن الحسين بن بابويه.(@)(@@)(@)(@@)(@@)(@@) $ 6337 - موسى بن أبي موسى الكوفي، روى عن محمد بن أيوب بن يحيى بن ضريس والحسن بن علي بن زياد، عن يحيى بن عبد الحميد، روى عنه موسى بن المتوكل. 3(@)PageV00P445(@)(@@)(@)(@@)(@@)(@@) $ 6338 - محمد بن محمد بن رباط الكوفي، قال: حدثنا أبو جعفر محمد بن الحسين ابن عبد الله بن سعيد الطبري ببغداد، قال: حدثنا عمي إبراهيم بن عبد الله بن سعيد، قال: لما توجه موسى بن بغا إلي قم فوطأها وطأه خشنة وعظم بها ما فعل بأهلها، فكتبوا بذلك إلي أبي محمد صاحب العسكر 
ms188	 عليه السلام يسألونه الدعاء لهم، فكتب عليه السلام إليهم ان ادعوا بهذا الدعاء في وتركم، وهو - وذكر الدعاء. 1(@)(@@)(@@)(@@) $ 6339 - محمد بن علي بن أحمد بن هشام القمي، يكنى أبا جعفر، روى عن محمد ابن علي ما جيلويه، روى عنه ابن نوح.(@)(@@)(@)(@@)(@@)(@@) $ 6340 - المظفر بن أحمد القزويني، يكنى أبا الفرج، روى عن أبي جعفر الأسدي، روى عنه الصفواني.(@)(@@)(@)(@@)(@@)(@@) $ 6341 - محمد بن مروان بن زياد الغزال، روى عن الحسن بن محبوب، روى عنه القاسم بن العلاء الهمداني، الذي روى عنه الصفواني.(@)(@@)(@)(@@)(@@)(@@) $ 6342 - محمد بن أحمد بن العباس بن نوح، جد أبي العباس بن نوح، روى عنه أبو العباس.(@)(@@)(@)(@@)(@@)(@@) $ 6343 - محمد بن محمد بن الحسين بن هارون الكندي الكوفي، روى عن ابن عقدة، روى عنه ابن نوح. 2(@)(@@)(@@)(@@) $ 6344 - محمد بن مزيد بن محمود بن أبي الأزهر المتوشحي النحوي، روى عن يعقوب بن يزيد، روى عنه أبو المفضل.(@)(@@)(@)(@@)(@@)(@@) $ 6345 - محمد بن أحمد بن بشر الأصفهاني، يكنى أبا جعفر، روى عن أبي جعفر محمد بن إبراهيم الدقاق القمي عن عبد الله بن الحسن بن موسى، قال: حدثنا محمد ابن عبد الله بن إسحاق الهمداني عن أخيه، قال: بعثتي المتوكل مع يحيى بن هرثمه في حمل أبي الحسن علي بن محمد بن علي بن موسى عليهم السلام - و ذكر الحديث -(@)PageV00P446(@)(@@) روى عنه محمد بن همام.(@)(@@)(@)(@@)(@@)(@@) $ 6346 - محمد بن محمد بن الحسن بن هارون الكندي، روى عنه ابن نوح.(@)(@@)(@)(@@)(@@)(@@) $ 6347 - محمد بن الحسن البرناني، روى عنه الكشي. 1(@)(@@)(@@)(@@) $ 6348 - محمد بن يزداد، روى عن محمد بن الحسين بن أبي الخطاب.(@)(@@)(@)(@@)(@@)(@@) $ 6349 - محمد بن موسى الجورجاني، روى عن أبي عمرو عثمان بن سعيد بن عمرو الأسدي زيارة سلمان وكيفية القول عنده، روى ابن نوح عن رجل عن أبي جعفر محمد بن لاحق الشيباني عن محمد بن موسى.(@)(@@)(@)(@@)(@@)(@@) $ 6350 - محمد بن عبد الله بن محمد، روى عنه ابن نوح دعاء الحريق باسناده.(@)(@@)(@)(@@)(@@)(@@) $ 6351 - محمد بن عثمان بن سعيد العمري، يكنى أبا جعفر، وأبوه يكنى أبا عمرو، جميعا 
ms189	 وكيلان من جهة صاحب الزمان عليه السلام، ولهما منزلة جليلة عند الطائفة.(@)(@@)(@)(@@)(@@)(@@) $ 6352 - محمد بن أحمد بن محمد بن سنان الزاهري، يكنى أبا عيسى، نزيل الري، روى عن أبيه عن جده محمد بن سنان، روى عنه ابن نوح وأبو المفضل.(@)(@@)(@)(@@)(@@)(@@) $ 6353 - محمد بن أسلم الجبلي، روى عنه محمد بن الحسين بن أبي الخطاب.(@)(@@)(@)(@@)(@@)(@@) $ 6354 - محمد بن مصبح، روى عنه موسى بن جعفر البغدادي.(@)(@@)(@)(@@)(@@)(@@) $ 6355 - محمد بن عمرو الزيات، روى عنه علي ابن السندي.(@)(@@)(@)(@@)(@@)(@@) $ 6356 - محمد بن بحر الرهني، يرمي بالتفويض.(@)(@@)(@)(@@)(@@)(@@) $ 6357 - محمد بن إبراهيم بن يوسف الكاتب، أبو الحسن، ويعرف بأبي بكر الشافعي، أخبرنا عنه ابن عبدون.(@)(@@)(@)(@@)(@@)(@@) $ 6358 - محمد بن أحمد بن الجنيد، أبو علي، أخبرنا عنه جماعة.(@)(@@)(@)(@@)(@@)(@@) $ 6359 - محمد بن أحمد بن داود القمي، يكنى أبا الحسن، أخبرنا عنه جماعة.(@)(@@)(@)(@@)(@@)(@@) $ 6360 - محمد بن عبد الله بن المطلب الشيباني، أبو المفضل، كثير الرواية الا أنه ضعفه قوم، أخبرنا عنه جماعة.(@)PageV00P447(@)(@@)(@)(@@)(@@)(@@) $ 6361 - محمد بن عيسى اليقطيني، ضعيف.(@)(@@)(@)(@@)(@@)(@@) $ 6362 - محمد بن أورمة ضعيف، روى عنه الحسين بن الحسن بن أبان.(@)(@@)(@)(@@)(@@)(@@) $ 6363 - محمد بن الحسن بن جمهور العمي، روى سعد عن أحمد بن الحسين بن سعيد عنه.(@)(@@)(@)(@@)(@@)(@@) $ 6364 - محمد بن علي الشلمغاني، يعرف بابن أبي العزاقر، غال.(@)(@@)(@)(@@)(@@)(@@) $ 6365 - محمد بن إدريس الحنظلي، أبو حاتم، روى عنه عبد الله بن جعفر الحميري.(@)(@@)(@)(@@)(@@)(@@) $ 6366 - محمد بن أبي الصهبان عبد الجبار، روى عنه سعد وغيره.(@)(@@)(@)(@@)(@@)(@@) $ 6367 - محمد بن أحمد بن الخطيب بساوة، روى عنه ابن بطة.(@)(@@)(@)(@@)(@@)(@@) $ 6368 - محمد بن أحمد بن عبد الله، المعروف بالمفجع، روى عنه الدوري.(@)(@@)(@)(@@)(@@)(@@) $ 6369 - محمد بن عمر بن سلم الجعابي، أبو بكر، أخبرنا عنه محمد بن محمد بن النعمان.(@)(@@)(@)(@@)(@@)(@@) $ 6370 - محمد بن أحمد بن أبي الثلج، روى عنه الدوري.(@)(@@)(@)(@@)(@@)(@@) $ 6371 - محمد بن منصور بن يونس بزرج، روى حميد عن محمد بن الحسين الصائغ عنه.(@)(@@)(@)(@@)(@@)(@@) $ 6372 - محمد بن عمر الجرجاني، بغدادي، روى عنه البرقي.(@)(@@)(@)(@@)(@@)(@@) $ 6373 - محمد بن إسحاق القمي، روى عنه أحمد بن أبي عبد الله. 1(@)(@@)(@@)(@@) $ 6374 - محمد بن عبد الله 
ms190	 بن جعفر الحميري، روى ابن بابويه أبو جعفر عن أحمد بن هارون الفامي عنه. 2(@)PageV00P448(@)(@@)(@@)(@@) $ 6375 - محمد بن محمد بن النعمان، جليل، ثقة.(@)(@@)(@@)(@@) $ 6376 - محمد بن جرير بن رستم الطبري، وليس بصاحب التاريخ.(@)(@@)(@@)(@@) $ 6377 - موسى بن جعفر البغدادي.(@)(@@)(@@)(@@) $ 6378 - موسى بن سابق.(@)(@@)(@@)(@@) $ 6379 - موسى بن حبيب.(@)(@@)(@@)(@@) $ 6380 - موسى بن طلحة، روى عنه البرقي.(@)(@@)(@@)(@@) $ 6381 - موسى بن عامر، روى عنه الحميري.(@)(@@)(@@)(@@) $ 6382 - منصور بن العباس، روى عنه البرقي.(@)(@@)(@@)(@@) $ 6383 - المعلى بن محمد البصري، روى عنه الحسين بن محمد.(@)(@@)(@@)(@@) $ 6384 - معاوية بن حكيم، روى عنه الصفار.(@)(@@)(@@)(@@) || باب النون(@)(@@)(@@)(@@) $ 6385 - نصر بن صباح، يكنى أبا القاسم، من أهل بلخ، لقى جلة من كان في عصره من المشائخ والعلماء وروى عنهم، الا انه قيل: إنه كان من الطيارة، غال.(@)(@@)(@@)(@@) || باب الهاء(@)(@@)(@@)(@@) $ 6386 - هارون بن موسى التلعكبري، يكنى أبا محمد، جليل القدر، عظيم المنزلة، واسع الرواية، عديم النظير، ثقة، روى جميع الأصول والمصنفات، مات سنة خمس و ثمانين وثلاثمائة، أخبرنا عنه جماعة من أصحابنا.(@)(@@)(@@)(@@) $ 6387 - الهيثم بن أبي مسروق النهدي، روى عنه سعد بن عبد الله.(@)(@@)(@@)(@@) $ 6388 - الهيثم بن عدي، روى عنه محمد بن أحمد بن يحيى.(@)(@@)(@@)(@@) $ 6389 - هارون بن يحيى البزاز، أبا الحسن، روى عنه ابن نوح. PageV00P449(@)(@@)(@@)(@@) || باب الياء(@)(@@)(@@)(@@) $ 6390 - يحيى بن زكريا، المعروف بالكتنجي، يكنى أبا القاسم، روى عنه التلعكبري وسمع منه سنة ثماني عشرة وثلاثمائة، وكان سنه حين لقيه أكثر من مائة و عشرين سنة وقد لقى العسكريين عليهما السلام. 1(@)(@@)(@@)(@@) $ 6391 - يونس بن علي العطار، روى عنه حميد بن زياد كتاب أبي حمزة الثمالي و غير ذلك من الأصول.(@)(@@)(@)(@@)(@@)(@@) $ 6392 - يوسف بن السخت، روى عن محمد بن جمهور العمي، روى عنه محمد بن أحمد بن يحيى.(@)(@@)(@)(@@)(@@)(@@) $ 6393 - يوسف بن محمد، روى عنه محمد بن أحمد بن يحيى، بصري.(@)(@@)(@)(@@)(@@)(@@) $ 6394 - يحيى بن عبد الحميد الحماني.(@)(@@)(@)(@@)(@@)(@@) $ 6395 - يحيى بن إبراهيم، روى عنه البرقي. 2(@)(@@)(@@)(@@) $ 6396 - يحيى بن أبي بكر بن مهرويه، روى عنه أحمد بن أبي عبد الله.(@)(@@)(@)(@@)(@@)(@@) $ 6397 - يحيى بن حسن العلوي، 
ms191	 له كتاب نسب آل أبي طالب، روى ابن أخ طاهر عنه. 3(@)(@@)(@@)(@@) $ 6398 - يحيى العلوي، أبو محمد، من بني زبارة، نيسابوري.(@)(@@)(@)(@@)(@@)(@@) $ 6399 - يعلي بن حسان الواسطي، روى عنه الصفار.(@)PageV00P450(@)(@@)(@@)(@@) || باب الكنى(@)(@@)(@@)(@@) $ 6400 - أبو علي العلوي وأخوه أبو الحسين، اسمه محمد بن محمد بن يحيى من بني زبارة، معروفان جليلان من أهل نيسابور.(@)(@@)(@)(@@)(@@)(@@) $ 6401 - أبو الحسين الملبدي، من أهل الأدب والمعرفة، في وقت الطاهرية.(@)(@@)(@)(@@)(@@)(@@) $ 6402 - أبو نصر بن يحيى الفقيه من أهل سمرقند، ثقة خير فاضل، كان يفتي العامة بفتياهم والحشوية بفتياهم والشيعة بفتياهم.(@)(@@)(@)(@@)(@@)(@@) $ 6403 - أبو بكر العنابي، زاهد، من أصحاب العياشي. 1(@)(@@)(@@)(@@) $ 6404 - أبو علي الوارثي.(@)(@@)(@)(@@)(@@)(@@) $ 6405 - وأبو نصر الخلقاني.(@)(@@)(@)(@@)(@@)(@@) $ 6406 - وأبو عمرو الخياط.(@)(@@)(@)(@@)(@@)(@@) $ 6407 - وأبو عبد الله البقال، هولا من أصحاب العياشي.(@)(@@)(@)(@@)(@@)(@@) $ 6408 - أبو جعفر بن أبي عوف، بخاري، من أصحاب العياشي.(@)(@@)(@)(@@)(@@)(@@) $ 6409 - أبو الحسن بن عشاية، روى عنه حميد حديثا واحدا.(@)(@@)(@)(@@)(@@)(@@) $ 6410 - أبو عمر، الضرير، روى عنه حميد.(@)(@@)(@)(@@)(@@)(@@) $ 6411 - أبو جعفر السقاء الأحول المنجم، وكان لقى الرضا عليه السلام، رآه التلعكبري بدسكرة الملك سنة أربعين وثلاثمائة ووصف له الرضا عليه السلام و حكي حكايته.(@)(@@)(@)(@@)(@@)(@@) $ 6412 - أبو عبد الله الجاموراني الرازي.(@)(@@)(@)(@@)(@@)(@@) $ 6413 - أبو علي النيسابوري.(@)(@@)(@)(@@)(@@)(@@) $ 6414 - أبو يحيى الواسطي، روى عنهم محمد بن أحمد بن يحيى.(@)(@@)(@)(@@)(@@)(@@) $ 6415 - أبو سعد، روى عنه أحمد بن محمد بن عيسى.(@)(@@)(@)(@@)(@@)(@@) $ 6416 - أبو عمرو ابن أخ السكوني، اسمه محمد بن محمد بن نصر السكوني،(@)PageV00P451(@)(@@) بصري، أخبرنا عنه أحمد بن إبراهيم القزويني. 1(@)(@@)(@@)(@@) $ 6417 - أبو عبد الله.(@)(@@)(@)(@@)(@@)(@@) $ 6418 - أبو الحسين بن أبي طاهر الطبري، وقيل: اسمه علي بن الحسين، روى عن أبي جعفر الأسدي، وعن جعفر بن محمد بن مالك، من غلمان العياشي.(@)(@@)(@)(@@)(@@)(@@) $ 6419 - أبو عبد الرحمان المسعودي.(@)(@@)(@)(@@)(@@)(@@) $ 6420 - أبو حيون، روى عنه البرقي أحمد بن أبي عبد الله.(@)(@@)(@)(@@)(@@)(@@) $ 6421 - أبو حمزة الغنوي، روى عنه عبد الله بن الصلت.(@)(@@)(@)(@@)(@@)(@@) $ 6422 - أبو عبد الرحمان العرزمي.(@)(@@)(@)(@@)(@@)(@@) $ 6423 - أبو أيوب الأنباري.(@)(@@)(@)(@@)(@@)(@@) $ 6424 - أبو يحيى الواسطي.(@)(@@)(@)(@@)(@@)(@@) $ 6425 - أبو سليمان الجبلي.(@)(@@)(@)(@@)(@@)(@@) $ 6426 - أبو عبد الله الجاموراني.(@)(@@)(@)(@@)(@@)(@@) $ 6427 - أبو طالب البصري. 
ms192	(@)(@@)(@)(@@)(@@)(@@) $ 6428 - أبو العباس صاحب عمار بن مروان، روى عنهم أحمد بن أبي عبد الله.(@)(@@)(@@)(@@) || باب النساء(@)(@@)(@@)(@@) $$ 6429 - فاطمة بنت هارون بن موسى بن الفرات، روى عنها التلعكبري قالت:(@)(@@) سمعت جدي موسى بن الفرات يقول: حدثني محمد بن أبي عمير بكتاب عبيد الله بن علي الحلبي، ولم يسمع منها غير هذا الكتاب.(@)PageV00P452 
