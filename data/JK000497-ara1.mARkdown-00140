ms121	(@)(@@)(@@)(@@) || ( باب مهدي ومهيد )(@)(@@)(@@)(@@) $ 1804 مهدى بن ميمون بصرى ثقة(@)(@@)(@@)(@@) $ 1805 المهند بن على العتكي بصرى ثقة(@)(@@)(@@)(@@) $ 1806 مهيد بن على العتكي ثقة قلت وهو الصواب PageV02P301(@)(@@)(@@)(@@) $ 1807 مهيد القيسي كوفى ثقة روى عنه قيس بن مسلم PageV02P302(@)(@@)(@@)(@@) || ( باب مؤثر ومورق )(@)(@@)(@@)(@@) $ 1808 مؤثر بن عفازة من أصحاب عبد الله ثقة(@)(@@)(@@)(@@) $ 1809 مورق العجلي بصرى تابعي ثقة(@)(@@)(@@)(@@) || ( باب موسى )(@)(@@)(@@)(@@) $ 1810 موسى بن إسماعيل أبو سلمة بصرى ثقة(@)(@@)(@@)(@@) $ 1811 موسى بن الأشعث البلوى مصرى تابعي ثقة(@)(@@)(@@)(@@) $ 1812 موسى بن أنس بن مالك بصرى تابعي ثقة(@)(@@)(@@)(@@) $ 1813 موسى بن أيوب الغافقي مصري لا باس به(@)(@@)(@@)(@@) $ 1814 موسى بن أيوب النصيبي سكن أنطاكية ثقة(@)(@@)(@@)(@@) $ 1815 موسى بن خلف العمى ثقة(@)(@@)(@@)(@@) $ 1816 موسى بن داود كوفى ثقة(@)(@@)(@@)(@@) $ 1817 موسى بن سلمة أبو إسماعيل بصرى ثقة PageV02P303(@)(@@)(@@)(@@) $ 1818 موسى بن طلحة بن عبيد الله تابعي ثقة رجل صالح كوفى وكان خيارا PageV02P304(@)(@@)(@@)(@@) $ 1819 موسى بن عبد الله بن يزيد الأنصاري كوفى تابعي ثقة وأبوه من أصحاب النبي صلى الله عليه وسلم(@)(@@)(@@)(@@) $ 1820 موسى بن عقبة مدني ثقة رجل صالح(@)(@@)(@@)(@@) $ 1821 موسى بن على بن رباح مصرى ثقة(@)(@@)(@@)(@@) $ 1822 موسى بن مسعود النهدي يكنى أبا حذيفة بصري صدوق ثقة(@)(@@)(@@)(@@) $ 1823 موسى بن المسيب ثقة(@)(@@)(@@)(@@) $ 1824 موسى بن وردان مصرى تابعي ثقة PageV02P305(@)(@@)(@@)(@@) $ 1825 موسى الجهني ثقة في عداد الشيوخ(@)(@@)(@@)(@@) || ( باب ميسرة وميمون )(@)(@@)(@@)(@@) $ 1826 ميسرة بن حبيب النهدي ثقة كوفى روى عن المنهال بن عمرو وهو في عداد الشيوخ(@)(@@)(@@)(@@) $ 1827 ميمون بن جابان بصرى ثقة PageV02P306(@)(@@)(@@)(@@) $ 1828 ميمون بن مهران جزري تابعي ثقة وكان يحمل على على رضى الله عن على حدثنا أبو مسلم حدثني أبي وكان ميمون بن مهران إذا رأى شابا حسن العقل وإن لم يكن على طريقة حسنة أكرمه وابتدأه بالسلام إذا لقيه وحده وسأله عن أهله واظهر له برا ثم يقول له ها هنا مريض اذهب بنا نعوده ها هنا جنازة اذهب بنا نحضرها قال فيذهب فيقول للفتى اصحابه رايناك مع ميمون بن مهران أي شيء تصنع مع ميمون فيقول لهم 
ms122	 قال لي كذا وكذا فذهبت معه قال فإذا لقيه ميمون مع اصحابه اعرض عنه كأنه لم يره فإذا لقيه وحده سلم عليه فلا يزال حتى يتنسك PageV02P307(@)(@@)(@@)(@@) | ( باب النون )(@)(@@)(@@)(@@) || باب ناجية وناشرة(@)(@@)(@@)(@@) $ 1829 ناجية بن عبد الله بن عتبة بن مسعود ثقة(@)(@@)(@@)(@@) $ 1830 ناجية بن كعب كوفى تابعي ثقة(@)(@@)(@@)(@@) $ 1831 ناشرة بن سمى اليزني مصرى تابعي ثقة(@)(@@)(@@)(@@) || ( باب من اسمه نافع )(@)(@@)(@@)(@@) $ 1832 نافع بن جبير بن مطعم مدني تابعي ثقة(@)(@@)(@@)(@@) $ 1833 نافع بن خالد الخزاعي كوفى تابعي ثقة وأبوه من أصحاب النبي صلى الله عليه وسلم(@)(@@)(@@)(@@) $ 1834 نافع بن عاصم بن عروة تابعي ثقة PageV02P308(@)(@@)(@@)(@@) $ 1835 نافع بن عمر الجمحي ثقة(@)(@@)(@@)(@@) $ 1836 نافع بن يزيد مصرى ثقة PageV02P309(@)(@@)(@@)(@@) $ 1837 نافع القارىء هو نافع بن عبد الرحمن بن أبي نعيم مولى بن شعوب حليف العباس بن عبد المطلب(@)(@@)(@@)(@@) $ 1838 نافع مولى بن عمر مدني تابعي ثقة(@)(@@)(@@)(@@) $ 1839 نافع مولى أبي قتادة مدني تابعي ثقة PageV02P310(@)(@@)(@@)(@@) || ( باب نباتة ونبيح ونبيط ونبي ونجي )(@)(@@)(@@)(@@) $ 1840 نباتة الجعفي كوفى تابعي ثقة روى عن عمر(@)(@@)(@@)(@@) $ 1841 نبيح العنزي كوفى تابعي ثقة(@)(@@)(@@)(@@) $ 1842 نبيط والد سلمة من أصحاب النبي صلى الله عليه وسلم(@)(@@)(@@)(@@) $ 1843 نبي كوفى تابعي ثقة(@)(@@)(@@)(@@) $ 1844 نجى والد عبد الله بن نجى كوفى تابعي ثقة PageV02P311(@)(@@)(@@)(@@) || ( باب النزال ونسير ونصر )(@)(@@)(@@)(@@) $ 1845 النزال بن سبرة الهذلى كوفى تابعي ثقة من كبار التابعين سمع من عبد الله(@)(@@)(@@)(@@) $ 1846 نسير بن ذعلوق أبو طعمة كوفى تابعي ثقة مولى الربيع بن خثيم(@)(@@)(@@)(@@) $ 1847 نصر بن أوس وسعد بن أوس كوفيان ثقتان وليسا أخوين PageV02P312(@)(@@)(@@)(@@) $ 1848 نصر بن عاصم بصرى تابعي ثقة(@)(@@)(@@)(@@) || ( باب النضر والنعمان )(@)(@@)(@@)(@@) $ 1849 النضر بن إسماعيل بن أبي حازم البجلي كوفى ثقة وكان إمام مسجد الجامع(@)(@@)(@@)(@@) $ 1850 النضر بن أنس بن مالك بصرى تابعي ثقة(@)(@@)(@@)(@@) $ 1851 النضر بن محمد اليمامي سكن جرش كنيته أبو محمد ثقة وهو من أروى الناس عن عكرمة بن عمار اليمامي سمع من عكرمة بن عمار ألف حديث رحلت إليه من مكة فوصلت في خمسة عشر يوما PageV02P313(@)(@@)(@@)(@@) $ 1852 
ms123	 نعمان بن بشير حدثنا أبو داود عن سفيان عن منصور عن ذر عن يسيع عن النعمان بن بشير عن النبي صلى الله عليه وسلم قال الدعاء هو العبادة ثم قرأ وقال ربكم ادعونى أستجب لكم(@)(@@)(@@)(@@) $ 1853 النعمان بن ثابت أبو حنيفة كوفي تيمي من رهط حمزة الزيات وكان خزازا يبيع الخز PageV02P314(@)(@@)(@@)(@@) $ 1854 النعمان بن أبي خالد أخو إسماعيل بن أبي خالد الأحمسي الكوفى ثقة وأخواهما أشعث وسعيد(@)(@@)(@@)(@@) $ 1855 نعمان بن أبي خلف ثقة(@)(@@)(@@)(@@) $ 1856 النعمان بن مقرن المزني من أصحاب النبي صلى الله عليه وسلم استعمله عمر على نهاوند فقتل وكان الفتح على يديه(@)(@@)(@@)(@@) || ( باب نعيم )(@)(@@)(@@)(@@) $ 1857 نعيم بن حكيم ثقة من أهل المدائن PageV02P315(@)(@@)(@@)(@@) $ 1858 نعيم بن حماد مروزي ثقة حدثنا أبو مسلم حدثني أبي قال قال لي نعيم وضعت ثلاثة كتب على الجهيمة اكتبها قلت لا قال لم قلت أخاف أن يقع في قلبي منها شيء قال تركها والله خير لك قلت فلم تدعونى إلى شيء تركه أحب إليك فأبيت ان اكتبها حدثنا أبو مسلم حدثني أبي قال سألت نعيم بن حماد قلت جاء عن النبي صلى الله عليه وسلم انه لم يشبع في يوم من خبز بر مرتين وجاء أنه كان يعد لأهله قوت سنة فكيف هذا قال كان يعد لأهله قوت سنة فتنزل به النازلة فيقسمه فيبقى بلا شيء صلى الله عليه وسلم حدثنا أبو مسلم حدثني أبي قال وسألت نعيما قلت يسرك أنك شهدت صفين قال لا قلت فقالوا لك لابد أن تكون مع أحد الفريقين قال فان كان لا بد فمع علي(@)(@@)(@@)(@@) $ 1859 نعيم بن حنظلة كوفي تابعي ثقة PageV02P316(@)(@@)(@@)(@@) $ 1860 نعيم بن زياد شامي تابعي ثقة كنيته أبو طلحة(@)(@@)(@@)(@@) $ 1861 نعيم بن عيسى كوفى ثقة PageV02P317(@)(@@)(@@)(@@) $ 1862 نعيم بن المتئد أبو المتئد هو بن أخت سفيان بن عيينة كوفى ثقة رجل صالح متعبد(@)(@@)(@@)(@@) $ 1863 نعيم بن هبار الغطفاني شامي تابعي ثقة(@)(@@)(@@)(@@) $ 1864 نعيم بن أبي هند الأشجعي كوفى ثقة PageV02P318(@)(@@)(@@)(@@) || ( باب نفيع ونوح ونوفل )(@)(@@)(@@)(@@) $ 1865 نفيع أبو 
ms124	 بكرة من أصحاب النبي صلى الله عليه وسلم بصرى وكان من خيار أصحاب النبي صلى الله عليه وسلم(@)(@@)(@@)(@@) $ 1866 نفيع أبو رافع الصائغ تابعي ثقة من خيار التابعين بصرى وكان عبدا فاعتق وكان رجلا صالحا من كبار التابعين(@)(@@)(@@)(@@) $ 1867 نهشل الضبي قال يحيى كوفى ثقة روى عنه سفيان الثوري ومحمد بن فضيل وجرير بن عبد الحميد(@)(@@)(@@)(@@) $ 1868 نهشل الذي يحدث عن الضحاك بن مزاحم عن بن عباس فسئل يحيى يعرفه قال لا PageV02P319(@)(@@)(@@)(@@) $ 1869 نوح بن دراج ضعيف الحديث وكان له فقه وكان أبوه بقالا بالكوفة وكان نوح ولى قضاء الكوفة حكم بن شبرمة بحكم فرده نوح وكان من اصحابه فرجع إلى قوله فقال بن شبرمة كادت تزل به من حال قدم لولا تداركها نوح بن دارج وكان شريك بن عبد الله إذا قيل له في ولده ان يؤدبهم قال من أدب نوحا ادراج أدب نوحا(@)(@@)(@@)(@@) $ 1870 نوح بن قيس بصري ثقة(@)(@@)(@@)(@@) $ 1871 نوفل الضبي كوفي ثقة قديم الموت لم ندركه نحن PageV02P320(@)(@@)(@@)(@@) $ 1872 نوفل والد عبد الرحمن بن نوفل من أصحاب النبي صلى الله عليه وسلم PageV02P321(@)(@@)(@@)(@@) | ( باب الهاء )(@)(@@)(@@)(@@) || باب من اسمه هارون(@)(@@)(@@)(@@) $ 1873 هارون بن إبراهيم الأعور ضعيف الحديث وكان يقرىء صاحب قراءات(@)(@@)(@@)(@@) $ 1874 هارون بن رياب بصرى ثقة(@)(@@)(@@)(@@) $ 1875 هارون بن أبي عائشة ثقة روى عنه بن جريج(@)(@@)(@@)(@@) $ 1876 هارون بن عنترة كوفى ثقة PageV02P322(@)(@@)(@@)(@@) $ 1877 هارون بن معروف سكن بغداد ثقة(@)(@@)(@@)(@@) || ( باب هاشم )(@)(@@)(@@)(@@) $ 1878 هاشم بن البريد كوفى ثقة وكان يتشيع(@)(@@)(@@)(@@) $ 1879 هاشم بن القاسم أبو النضر من الأبناء سكن بغداد صاحب سنة ثقة وكان أهل بغداد يفخرون به PageV02P323(@)(@@)(@@)(@@) $ 1880 هاشم بن هاشم بن عتبة بن أبي وقاص مدني ثقة(@)(@@)(@@)(@@) || ( باب هانئ وهبيرة )(@)(@@)(@@)(@@) $ 1881 هانئ أخو مطرف ويزيد بن عبد الله بن الشخير بصرى ثقة(@)(@@)(@@)(@@) $ 1882 هانئ بن معاوية الصدفي مصرى تابعي ثقة(@)(@@)(@@)(@@) $ 1883 هانئ بن هانئ كوفى تابعي ثقة(@)(@@)(@@)(@@) $ 1884 هبيرة بن خزيمة وصوابه بن حديرة كوفى ثقة PageV02P324(@)(@@)(@@)(@@) $ 1885 هبيرة بن يريم من أصحاب عبد الله ثقة(@)(@@)(@@)(@@) || ( باب هدبة 
ms125	 وهرثمة وهرم وهريرة وهريم )(@)(@@)(@@)(@@) $ 1886 هدبة بن خالد الأزدي بصرى ثقة(@)(@@)(@@)(@@) $ 1887 هرثمة بن سلمان كوفى تابعي ثقة قلت وفى الحاشية بن سلمى(@)(@@)(@@)(@@) $ 1888 هرم بن الحارث بصرى تابعي ثقة(@)(@@)(@@)(@@) $ 1889 هرير الأسلمى مصرى تابعي ثقة PageV02P325(@)(@@)(@@)(@@) $ 1890 هريم بن سفيان كوفى ثقة(@)(@@)(@@)(@@) || ( باب هزال وهزهاز وهزيل )(@)(@@)(@@)(@@) $ 1891 هزال بن أبي جميل شامي تابعي ثقة(@)(@@)(@@)(@@) $ 1892 الهزهاز بن ميزن سمع من عبد الله ثقة PageV02P326(@)(@@)(@@)(@@) $ 1893 هزيل بن شرحبيل الأودي الأعمى من أصحاب عبد الله تابعي كوفى ثقة روى عنه الزهرى(@)(@@)(@@)(@@) || ( باب هشام )(@)(@@)(@@)(@@) $ 1894 هشام بن إسماعيل العطار دمشقي ثقة رجل صالح شيخ كيس صاحب سنة ولم يكن بدمشق في زمانه أحد أفضل منه(@)(@@)(@@)(@@) $ 1895 هشام بن البريد كوفى ثقة وكان يتشيع(@)(@@)(@@)(@@) $ 1896 هشام بن حجير مكي ثقة صاحب سنة PageV02P327(@)(@@)(@@)(@@) $ 1897 هشام بن حسان القردوسى بصرى ثقة حسن الحديث يقال إن عنده ألف حديث حسن ليست عند غيره(@)(@@)(@@)(@@) $ 1898 هشام بن حكيم بن حزام بن خويلد الأسدي من أصحاب النبي صلى الله عليه وسلم وكان متبتلا(@)(@@)(@@)(@@) $ 1899 هشام بن أبي رقية مصري تابعي ثقة(@)(@@)(@@)(@@) $ 1900 هشام بن سعد جائز الحديث وهو حسن الحديث PageV02P328(@)(@@)(@@)(@@) $ 1901 هشام بن سلمان المجاشعي حدثنا أبو مسلم حدثني أبي حدثنا يعقوب بن إسحاق أخبرني هشام بن سلمان المجاشعي قال سمعت رجلا قال للحسن البر أفضل أم الجهاد قال البر البر البر كما بين السماء والأرض(@)(@@)(@@)(@@) $ 1902 هشام بن عائذ بن نصيب ثقة روى عن بن عمر سمع منه الثوري PageV02P329(@)(@@)(@@)(@@) $ 1903 هشام بن أبي عبد الله وهو بن سنبر هو أبو عبد الله بصري ثقة ثبت في الحديث وكان أروى الناس عن ثلاثة عن قتادة وحماد بن أبي سليمان ويحيى بن أبي كثير كان يقول بالقدر ولم يكن يدعو إليه(@)(@@)(@@)(@@) $ 1904 هشام بن عبد الملك أبو الوليد الطيالسي بصري ثقة ثبت في الحديث وكان يروي عن سبعين امرأة وكانت الرحلة بعد أبي داود اليه وكان كثيرا ما يسأل عن حديث عباس بن مرداس ان النبي صلى الله عليه وسلم 
ms126	 دعا عشية عرفة لأمته بالمغفرة وهو غريب وليس يروي عباس بن مرداس سوى هذا الحديث وكانوا إذا سألوه عنه قال أي شيء ليس عندي سوى هذا الحديث PageV02P330(@)(@@)(@@)(@@) $ 1905 هشام بن عبيد الله روى عن القاسم بن عبد الله رازي ضعيف حدثنا أبو نعيم ثنا سفيان عن هشام أبي كليب عن بن أبي نعم عن أبي سعيد الخدري قال نهى رسول الله صلى الله عليه وسلم عن عسب الفحل أو أجر الفحل PageV02P331(@)(@@)(@@)(@@) $ 1906 هشام بن عروة بن الزبير وكان ثقة سمع من أسماء بنت أبي بكر الصديق لم يرو هشام بن عروة عن بن سيرين شيئا إنما يرسل عنه(@)(@@)(@@)(@@) $ 1907 هشام بن عرة لم يكن يحسن يقرأ كتبه كتبت عنه ثلاثة مجالس(@)(@@)(@@)(@@) $ 1908 هشام بن عمار الدمشقي ثقة صدوق PageV02P332(@)(@@)(@@)(@@) $ 1909 هشام بن أبي هشام يكنى أبا المقدام بصرى ضعيف الحديث واسم أبي هشام زياد مولى عثمان بن عفان(@)(@@)(@@)(@@) $ 1910 هشام بن يحيى بصرى ثقة(@)(@@)(@@)(@@) $ 1911 هشام بن يوسف قاضى صنعاء ثقة PageV02P333(@)(@@)(@@)(@@) || ( باب هشيم وهقل وهلال وهمام وهني )(@)(@@)(@@)(@@) $ 1912 هشيم بن بشير يكنى أبا معاوية واسطي ثقة وكان يدلس وكان يعد من حفاظ الحديث(@)(@@)(@@)(@@) $ 1913 هشيم بن أبي ساسان ثقة(@)(@@)(@@)(@@) $ 1914 هقل بن زياد شامي ثقة(@)(@@)(@@)(@@) $ 1915 هلال بن يساف كوفى ثقة تابعي(@)(@@)(@@)(@@) $ 1916 همام بن الحارث النخعي من أصحاب عبد الله ثقة(@)(@@)(@@)(@@) $ 1917 همام بن منبه يماني ثقة تابعي(@)(@@)(@@)(@@) $ 1918 همام بن يحيى بصرى ثقة PageV02P334(@)(@@)(@@)(@@) $ 1919 هنى بن نويرة كوفى ثقة(@)(@@)(@@)(@@) || ( باب الهيثم )(@)(@@)(@@)(@@) $ 1920 الهيثم بن الأسود كوفى تابعي ثقة من كبار التابعين(@)(@@)(@@)(@@) $ 1921 الهيثم بن جميل ثقة صاحب سنة بغدادي سكن أنطاكية(@)(@@)(@@)(@@) $ 1922 الهيثم بن خالد مصرى ثقة PageV02P335(@)(@@)(@@)(@@) $ 1923 الهيثم بن شفى مصرى تابعي ثقة كذا هو مضبوط في الأصل بفتح الشين وسكون الفاء الموحدة والله أعلم PageV02P336(@)(@@)(@@)(@@) $ 1924 الهيثم بن عدى الطاي كذاب وقد رأيته PageV02P337(@)(@@)(@@)(@@) | ( باب الواو )(@)(@@)(@@)(@@) || باب واسع وواصل وواقد وواهب ووائل(@)(@@)(@@)(@@) $ 1925 واسع بن حبان مدني تابعي ثقة(@)(@@)(@@)(@@) $ 1926 واسع بن حبان مصرى ثقة(@)(@@)(@@)(@@) $ 1927 واصل بن حيان 
ms127	 الأحدب كوفى ثقة(@)(@@)(@@)(@@) $ 1928 واصل مولى أبي عيينة بصرى ثقة(@)(@@)(@@)(@@) $ 1929 واقد بياع الغنم كوفى ثقة(@)(@@)(@@)(@@) $ 1930 واهب بن عبد الله المعافري مصرى تابعي ثقة(@)(@@)(@@)(@@) $ 1931 واهب بن مغيث مصرى تابعي ثقة(@)(@@)(@@)(@@) $ 1932 وائل بن داود الليثي ثقة PageV02P338(@)(@@)(@@)(@@) $ 1933 وائل بن ربيعة من أصحاب عبد الله ثقة PageV02P339(@)(@@)(@@)(@@) $ 1934 وائل بن مهانة التيمى من تيم الرباب سمع من عبد الله(@)(@@)(@@)(@@) || ( باب وبرة ووحشي ووضاح ووكيع )(@)(@@)(@@)(@@) $ 1935 وبرة بن عبد الرحمن كوفى تابعي ثقة(@)(@@)(@@)(@@) $ 1936 وحشي بن حرب شامي لا بأس به(@)(@@)(@@)(@@) $ 1937 وضاح أبو عوانة بصرى ثقة مولى يزيد بن عطاء الواسطي ويزيد بن عطاء جائز الحديث وأبو عوانة أرفع عنه PageV02P340(@)(@@)(@@)(@@) $ 1938 وكيع بن الجراح أبو سفيان كوفى ثقة عابد صالح أديب من حفاظ الحديث وكان يفتى وهو أثبت في سفيان من جماعة ذكرهم قال العجلي كان عكرمة بن عمار يحدث في المسجد الحرام بمكة ووكيع بن الجراح يكتب في الألواح فجاء عبد الله بن المبارك فجعل ينظر مع وكيع فقال وكيع نرى انسانا ينظر مع آخر في ألواح ببصر جيد(@)(@@)(@@)(@@) || ( باب الوليد )(@)(@@)(@@)(@@) $ 1939 الوليد بن ايمن الباهلى شامي تابعي ثقة(@)(@@)(@@)(@@) $ 1940 الوليد بن سليمان بن أبي السائب دمشقي ثقة PageV02P341(@)(@@)(@@)(@@) $ 1941 الوليد بن شجاع أبو همام بن أبي بدر السكوني رأيته يأخذ الحديث أخذا رديئا وقال مرة لا بأس به(@)(@@)(@@)(@@) $ 1942 الوليد بن عبادة بن الصامت شامي تابعي ثقة(@)(@@)(@@)(@@) $ 1943 الوليد بن عبد الله بن جميع الزهري مكي ثقة وقال مرة حجازي(@)(@@)(@@)(@@) $ 1944 الوليد بن عنبسة مصرى تابعي ثقة قلت وفى نسخة بن عبسة(@)(@@)(@@)(@@) $ 1945 الوليد بن العيزار كوفى ثقة(@)(@@)(@@)(@@) $ 1946 الوليد بن قيس مصرى تابعي ثقة(@)(@@)(@@)(@@) $ 1947 الوليد بن أبي مالك ثقة(@)(@@)(@@)(@@) $ 1948 الوليد بن مسلم الدمشقي ثقة PageV02P342(@)(@@)(@@)(@@) $ 1949 الوليد بن أبي الوليد مصري تابعي ثقة PageV02P343(@)(@@)(@@)(@@) $ 1950 الوليد المعيطي شامي ثقة(@)(@@)(@@)(@@) || ( باب وهب ووهيب )(@)(@@)(@@)(@@) $ 1951 وهب بن الأجدع كوفى تابعي ثقة(@)(@@)(@@)(@@) $ 1952 وهب بن جابر الخيوانى كوفى تابعي ثقة(@)(@@)(@@)(@@) $ 1953 وهب بن جرير بن حازم يكنى أبا العباس بصرى ثقة 
ms128	 وكان عفان يتكلم فيه ومات بالمنجشانية على ستة اميال من البصرة منصرفا من الحج فحمل ودفن بالبصرة(@)(@@)(@@)(@@) $ 1954 وهب بن أبي ذبي الهنائي بصرى ثقة(@)(@@)(@@)(@@) $ 1955 وهب بن خالد حمصي ثقة(@)(@@)(@@)(@@) $ 1956 وهب بن كيسان مدني تابعي ثقة كنيته أبو نعيم PageV02P344(@)(@@)(@@)(@@) $ 1957 وهب بن منبه يماني من الأبناء تابعي ثقة وكان على قضاء صنعاء ثنا أبو مسلم حدثني أبي حدثنا إسماعيل بن عبد الكريم حدثني عبد الصمد بن معقل قال قيل لوهب بن منبه يا أبا عبد الله كنت ترى الرؤيا تحدثنا بها فلا نلبث ان نراها كما رأيت قال هيهات ذهب ذلك عني منذ وليت القضاء(@)(@@)(@@)(@@) $ 1958 وهيب بن خالد بصرى ثقة ثبت PageV02P345(@)(@@)(@@)(@@) $ 1959 وهيب بن الورد مكي ثقة عابد وكان سفيان يقول اذهبوا بنا إلى هذا الرجل الصالح نسلم عليه PageV02P346(@)(@@)(@@)(@@) | ( باب الياء )(@)(@@)(@@)(@@) || باب من اسمه يحيى(@)(@@)(@@)(@@) $ 1960 يحيى بن آدم مولى خالد بن سعيد بن العاص كوفى ثقة وكان جامعا للعلم عاقلا ثبتا في الحديث وأبوه ثقة روى عن سفيان الثوري(@)(@@)(@@)(@@) $ 1961 يحيى بن أبي إسحاق مدني ثقة(@)(@@)(@@)(@@) $ 1962 يحيى بن أيوب مصرى ثقة PageV02P347(@)(@@)(@@)(@@) $ 1963 يحيى بن أبي بكير كوفى ثقة حسن العقل ظريفا سمع من وكيع وابن إدريس وحفص وابن عيينة وكان موسرا سكن مصر فأتاه رجل سندى كان يطلب الحديث فسأله في حديث سفيان ليخرجه له فقال له يحيى إن كنت محتاجا قويتك لا تسخر بي هذا كان بالكوفة يريد ليستأكل بالحديث لن تنال مني درهما قال فاني محتاج فأعطاه دينارا(@)(@@)(@@)(@@) $ 1964 يحيى بن أبي بكير قاضي كرمان كوفي ثقة روى عنه أحمد بن حنبل حدثنا أحمد بن حنبل ثنا يحيى بن أبي بكير ثنا زائدة عن عاصم بن أبي النجود عن ذر عن عبد الله قال كان أول من أظهر إسلامه سبعة رسول الله صلى الله عليه وسلم وأبو بكر وعمار وأمه سمية وصهيب وبلال والمقداد فأما رسول الله صلى الله عليه وسلم فمنعه الله بعمه أبي طالب واما أبو بكر فمنعه الله بقومه واما 
ms129	 سائرهم فاخذهم المشركون فالبسوهم ادراع الحديد وصهروهم في الشمس فما منهم انسان الا وقد واتاهم على ما أرادوا الا بلالا فإنه هانت عليه نفسه في الله وهان على قومه فاعطوه الولدان فاخذوا يطوفون به في شعاب مكة وهو يقول أحد أحد قال العجلي كان يخطىء في هذا الحديث يحيى بن أبي بكير يقول عن زائدة عن عاصم عن زر وانما رواه الناس عن منصور عن مجاهد PageV02P348(@)(@@)(@@)(@@) $ 1965 يحيى بن جابر الطائي شامي تابعي ثقة(@)(@@)(@@)(@@) $ 1966 يحيى الجابر كوفي يكتب حديثه وليس بالقوي(@)(@@)(@@)(@@) $ 1967 يحيى بن الجزار كوفي ثقة وكان يتشيع(@)(@@)(@@)(@@) $ 1968 يحيى بن الحارث الطائي فارسي من أهل شيراز ثقة صاحب سنة(@)(@@)(@@)(@@) $ 1969 يحيى بن حسان عالم بالحديث كوفي ثقة مأمون PageV02P349(@)(@@)(@@)(@@) $ 1970 يحيى بن حصين كوفي ثقة(@)(@@)(@@)(@@) $ 1971 يحيى بن حماد بصرى ثقة وكان من أروى الناس عن أبي عوانة(@)(@@)(@@)(@@) $ 1972 يحيى بن حمزة شامي ثقة وكان على قضاء دمشق(@)(@@)(@@)(@@) $ 1973 يحيى بن أبي حية كان يدلس لا بأس به PageV02P350(@)(@@)(@@)(@@) $ 1974 يحيى بن راشد بصرى ثقة صاحب حديث وأبوه فارسي ثقة PageV02P351(@)(@@)(@@)(@@) $ 1975 يحيى بن زكريا بن أبي زائدة ثقة وكان ممن جمع له الفقه والحديث وكان على قضاء المدائن ويعد من حفاظ الكوفيين للحديث مفتيا ثبتا صاحب سنة ووكيع إنما صنف كتبه على كتب يحيى بن زكريا بن أبي زائدة(@)(@@)(@@)(@@) $ 1976 يحيى بن سعيد بن حيان أبو حيان التيمي كوفي ثقة كان خيارا وأبوه ثقة وكان يحيى صالحا مبرزا صاحب سنة وروى عن أبي زرعة بن عمرو بن جرير تابعي(@)(@@)(@@)(@@) $ 1977 يحيى بن سعيد بن قيس بن قهد الأنصاري مدني تابعي ثقة وكان له فقه ولي القضاء وكان رجلا صالحا وجده قيس بن قهد من أصحاب النبي صلى الله عليه وسلم وسمع يحيى من أنس بن مالك PageV02P352(@)(@@)(@@)(@@) $ 1978 يحيى بن سعيد القطان يكنى أبا سعيد بصرى ثقة نقى الحديث وكان لا يحدث إلا عن ثقة وهو أثبت في سفيان من جماعة ذكرهم(@)(@@)(@@)(@@) $ 1979 يحيى بن سلمة بن كهيل ضعيف الحديث 
ms130	 وكان يغلو في التشيع(@)(@@)(@@)(@@) $ 1980 يحيى بن سليم القرشي ثقة(@)(@@)(@@)(@@) $ 1981 يحيى بن سيرين بصرى تابعي ثقة(@)(@@)(@@)(@@) $ 1982 يحيى بن طلحة بن عبيد الله تابعي ثقة روى عن أبيه(@)(@@)(@@)(@@) $ 1983 يحيى بن عابس كوفى تابعي ثقة PageV02P353(@)(@@)(@@)(@@) $ 1984 يحيى بن عباد السعدي مجهول بالنقل لا يقيم الحديث حديثه يدلك على ضعفه(@)(@@)(@@)(@@) $ 1985 يحيى بن عبد الله بن الأدرع ثقة(@)(@@)(@@)(@@) $ 1986 يحيى بن عبد الرحمن بن حاطب مدني تابعي ثقة(@)(@@)(@@)(@@) $ 1987 يحيى بن عبد الرحمن بن سعد بن زرارة مدني تابعي ثقة PageV02P354(@)(@@)(@@)(@@) $ 1988 يحيى بن عبد الملك بن حميد بن أبي غنية كوفى ثقة رجل صالح حدثنا أبو مسلم حدثني أبي حدثني أبي عبد الله قال قيل ليحيى بن عبد الملك بن أبي غنية دواء عينيك ترك البكاء قال فما جبرهما إذا(@)(@@)(@@)(@@) $ 1989 يحيى بن عبيد البهراني كوفي ثقة(@)(@@)(@@)(@@) $ 1990 يحيى بن عمرو بن سلمة كوفى ثقة وأبوه كوفى تابعي ثقة(@)(@@)(@@)(@@) $ 1991 يحيى بن أبي عمرو السيباني ثقة شامي(@)(@@)(@@)(@@) $ 1992 يحيى بن عيسى ثقة سكن الرملة وكان فيه تشيع PageV02P355(@)(@@)(@@)(@@) $ 1993 يحيى بن القمطة حجازي تابعي ثقة PageV02P356(@)(@@)(@@)(@@) $ 1994 يحيى بن أبي كثير اليمامي ثقة حسن الحديث يكنى أبا نصر وكان يعد من أصحاب الحديث ولم يسمع من عروة شيئا قال العجلي قدم معاوية بن سلام على يحيى بن أبي كثير فأعطاه كتابا فيه أحاديث زيد بن سلام ولم يقرأه ولم يسمعه منه(@)(@@)(@@)(@@) $ 1995 يحيى بن محمد الجاري مدني ثقة(@)(@@)(@@)(@@) $ 1996 يحيى بن المهلب أبو كدينة كوفي ثقة(@)(@@)(@@)(@@) $ 1997 يحيى بن معين من أهل انبار على اثنى عشر فرسخا من بغداد وكان أبوه كاتبا لعبد الله بن مالك(@)(@@)(@@)(@@) $ 1998 يحيى بن النضر الأنصاري مدني تابعي ثقة PageV02P357(@)(@@)(@@)(@@) $ 1999 يحيى بن وثاب الأسدي كوفى تابعي ثقة وكان يقرىء أهل الكوفة في زمانه وقرأ على عبيد بن نضلة الخزاعي كل يوم آية حدثنا أبو مسلم حدثني أبي قال وأمر الحجاج بن يوسف بالكوفة أن لا يؤم الا عربي فقال له قومه قد أمر الحجاج أن لا يؤم 
ms131	 إلا عربي فقال ليس عن مثلي نهي أنا لاحق بالعرب ثم أتى الحجاج فقرأ فقال الحجاج من هذا قالوا هذا يحيى بن وثاب قال ماله قالوا أمرت ان لا يؤم الا عربي فنحاه قومه وهو مولى فقال ليس عن مثل هذا نهيت ليصل بهم فصلى بهم الفجر والظهر والعصر والمغرب والعشاء فلما سلم قال اطلبوا إماما غيري انا ما أصلي بكم إنما أردت ان لا تستبدلوني فاما ان صار الأمر إلي فلست أصلي بكم(@)(@@)(@@)(@@) $ 2000 يحيى بن يعلى المحاربي ضعيف عبد الرحمن ارفع منه PageV02P358(@)(@@)(@@)(@@) $ 2001 يحيى أبو عبد الله بن يحيى كوفي تابعي ثقة PageV02P359(@)(@@)(@@)(@@) $ 2002 يحيى بن يمان العجلي من كبار أصحاب الثوري وكان ثقة جائز الحديث متعبدا معروفا بالحديث صدوقا إلا أنه فلج بآخره فتغير حفظه وكان فقيرا صبورا(@)(@@)(@@)(@@) || ( باب يزيد )(@)(@@)(@@)(@@) $ 2003 يزيد بن إبراهيم التستري بصرى ثقة(@)(@@)(@@)(@@) $ 2004 يزيد بن الأصم مدني تابعي ثقة وهو بن خالة بن عباس خالتهما ميمونة زوج النبي صلى الله عليه وسلم(@)(@@)(@@)(@@) $ 2005 يزيد بن البراء بن عازب كوفى تابعي ثقة(@)(@@)(@@)(@@) $ 2006 يزيد بن بلال بن الحارث الفزاري كوفى تابعي ثقة(@)(@@)(@@)(@@) $ 2007 يزيد بن ثابت الأنصاري مدني أنصارى من أصحاب النبي صلى الله عليه وسلم أخو زيد بن ثابت PageV02P360(@)(@@)(@@)(@@) $ 2008 يزيد بن الحارث بن بلال الفزاري كوفى تابعي ثقة قلت وفى الحاشية لعله زيد(@)(@@)(@@)(@@) $ 2009 يزيد بن حازم بصرى ثقة ازدى وهو مولى حماد بن زيد من فوق(@)(@@)(@@)(@@) $ 2010 يزيد بن أبي حبيب مصرى تابعي ثقة(@)(@@)(@@)(@@) $ 2011 يزيد بن أبي حكيم العدني قال يحيى كان ليس به بأس لم اكتب عنه شيئا(@)(@@)(@@)(@@) $ 2012 يزيد بن حميد أبو التياح بصرى ثقة PageV02P361(@)(@@)(@@)(@@) $ 2013 يزيد بن دثار بن عبيد بن الأبرص الأسدي كوفى تابعي ثقة روى عنه سماك بن حرب(@)(@@)(@@)(@@) $ 2014 يزيد بن رباح أبو فراس مصرى تابعي ثقة(@)(@@)(@@)(@@) $ 2015 يزيد بن الربيع يكنى أبا خالد بصرى ثقة(@)(@@)(@@)(@@) $ 2016 يزيد بن زريع يكنى أبا خالد السدوسي بصرى ثقة ثبت في الحديث PageV02P362(@)(@@)(@@)(@@) $ 2017 يزيد بن زياد بن 
ms132	 عبيد بن الأبرص الأسدي كوفى تابعي ثقة روى عنه سماك(@)(@@)(@@)(@@) $ 2018 يزيد بن زياد خال سالم بن أبي الجعد كوفى ثقة PageV02P363(@)(@@)(@@)(@@) $ 2019 يزيد بن أبي زياد مولى بنى هاشم كوفى ثقة جائز الحديث وكان بآخره يلقن(@)(@@)(@@)(@@) $ 2020 يزيد بن شريك التيمى من أصحاب عبد الله ثقة(@)(@@)(@@)(@@) $ 2021 يزيد بن عبد ربه أبو الفضل الحمصي ثقة وكان كيسا PageV02P364(@)(@@)(@@)(@@) $ 2022 يزيد بن عبد الله بن أسامة بن الهاد مدني ثقة وهو من آل عبد الله بن شداد بن الهاد(@)(@@)(@@)(@@) $ 2023 يزيد بن عبد الله أبو الفضل الحمصي ثقة وكان كيسا(@)(@@)(@@)(@@) $ 2024 يزيد بن عبد الله بن الشخير أبو العلاء بصرى ثقة أخو مطرف وهانى(@)(@@)(@@)(@@) $ 2025 يزيد بن عبد الرحمن بن أذينة أبو كثير الأعمى يمامي تابعي ثقة(@)(@@)(@@)(@@) $ 2026 يزيد بن أبي عبيد حجازي تابعي ثقة PageV02P365(@)(@@)(@@)(@@) $ 2027 يزيد بن عطاء الواسطي مولى أبي عوانة جائز الحديث وأبو عوانة أرفع منه(@)(@@)(@@)(@@) $ 2028 يزيد بن عقبة الفزاري كوفى تابعي ثقة(@)(@@)(@@)(@@) $ 2029 يزيد بن عميرة الزبيدي شامي تابعي ثقة من كبار التابعين(@)(@@)(@@)(@@) $ 2030 يزيد بن عياض بن جعدبة الليثي ضعيف(@)(@@)(@@)(@@) $ 2031 يزيد بن قتادة بصرى تابعي ثقة(@)(@@)(@@)(@@) $ 2032 يزيد بن القعقاع بن شبرمة بن أخى عبد الله بن شبرمة روى عنه ثقة(@)(@@)(@@)(@@) $ 2033 يزيد بن مردانبة كوفى ثقة(@)(@@)(@@)(@@) $ 2034 يزيد بن أبي مريم الأنصاري شامي ثقة PageV02P366(@)(@@)(@@)(@@) $ 2035 يزيد بن أبي مريم كوفى تابعي ثقة(@)(@@)(@@)(@@) $ 2036 يزيد بن معاوية النخعي بابة الربيع من أصحاب عبد الله ثقة(@)(@@)(@@)(@@) $ 2037 يزيد بن ميسرة العقيلي بصرى ثقة(@)(@@)(@@)(@@) $ 2038 يزيد بن نعيم بن هزال مدني تابعي ثقة PageV02P367(@)(@@)(@@)(@@) $ 2039 يزيد بن هارون سلمى يكنى أبا خالد واسطي شامي ثقة ثبت في الحديث وكان متعبدا متنسكا حسن الصلاة جدا كان قد عمى يصلى الضحى ست عشرة ركعة بها من الجودة غير قليل وكان متنسكا عابدا توفى سنة ست ومائتين PageV02P368 لقى يحيى بن سعيد الأنصاري وروى عنه نحوا من مائة حديث وسبعين حديثا لقيه بالحيرة وكان يحيى بن سعيد قاضيا على الحيرة وقال أبو 
ms133	 مسلم قلت له من استقضاه قال بعض بنى أمية ثم لقيه يزيد وكان جد يحيى من أصحاب النبي صلى الله عليه وسلم وكان يحيي رجلا صالحا قلت له كم يحفظ قال ستمائة سبعمائة قال وقال يزيد يوما بالبصرة حدثني يحيى بن سعيد فقيل له من يحيى بن سعيد قال الأنصاري وليس بقطانكم هذا وقال يزيد ما أحب أن أحفظ القرآن حتى لا أخطىء فيه شيئا لأن لا يدركنى ما قال رسول الله صلى الله عليه وسلم في الخوارج يقرأون القرآن لا يجاوز حناجرهم يمرقون من الدين كما يمرق السهم من الرمية وكان يوما عنده بن أبي خدويه ونظيره من أصحاب الحديث فحدث بحديث فقال له بن أبي خدويه ماذا أحاط بهذا الحديث من البلاء فلان يرسل عن فلان وفلان لم يسمع من فلان وفلان إنما أخذ هذا الحديث مناولة فقال له يزيد ما سمعت هذا إلا الساعة لم يكن يزيد يعرف هذا الموضع قال وكان يزيد يؤذن فكان يقول حي على الفلح فقالوا له فقال جرى لساني على هذا واسم أبي خدويه سهل بن حسان بصرى ثقة حسن الحديث حسن العقل يشابه على بن المديني PageV02P369(@)(@@)(@@)(@@) $ 2040 يزيد بن هرمز مدني تابعي ثقة(@)(@@)(@@)(@@) $ 2041 يزيد أبو مالك تابعي ثقة ذكره في اليمانيين(@)(@@)(@@)(@@) $ 2042 يزيد أبو مزيد شامي تابعي ثقة PageV02P370(@)(@@)(@@)(@@) $ 2043 يزيد الأودي كوفى تابعي ثقة(@)(@@)(@@)(@@) || ( باب يسار ويسير ويعفور )(@)(@@)(@@)(@@) $ 2044 يسار أبو نجيح المكى ثقة(@)(@@)(@@)(@@) $ 2045 يسير بن عمرو الكلبي سمع من عبد الله ثقة(@)(@@)(@@)(@@) $ 2046 يسير بن عميلة الفزاري كوفى تابعي ثقة وكان حسين الجعفي يقول نسير PageV02P371(@)(@@)(@@)(@@) $ 2047 يعفور بن المغيرة بن شعبة تابعي ثقة(@)(@@)(@@)(@@) || ( باب يعقوب )(@)(@@)(@@)(@@) $ 2048 يعقوب بن إبراهيم بن سعد مدني ثقة(@)(@@)(@@)(@@) $ 2049 يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف ثقة قلت ويحتمل أن يكون هو الذي قبله(@)(@@)(@@)(@@) $ 2050 يعقوب بن عبد الله بن الأشج مدني ثقة نزل مصر PageV02P372(@)(@@)(@@)(@@) $ 2051 يعقوب بن كعب الحلبي سكن أنطاكية مولى عامر بن إسماعيل ثقة رجل 
ms134	 صالح صاحب سنة(@)(@@)(@@)(@@) $ 2052 يعقوب بن المغيرة بن شعبة تابعي ثقة(@)(@@)(@@)(@@) || ( باب يعلى )(@)(@@)(@@)(@@) $ 2053 يعلى بن عبيد أخو محمد بن عبيد الطنافسي كوفى ثقة يكنى أبا يوسف وكان حديثه أربعة آلاف يحفظها PageV02P373(@)(@@)(@@)(@@) $ 2054 يعيش بن الوليد بن هشام الأموي ثقة(@)(@@)(@@)(@@) || ( باب بوسف )(@)(@@)(@@)(@@) $ 2055 يوسف بن أسباط كوفى ثقة صاحب سنة وخير دفن كتبه تحول إلى قرية يقال لها سيلحين بين أنطاكية وحلب وآواه أبو أسامة إلى قريته وهو في سن وكيع دفن كتبه وقال لا يصلح قلبي عليها(@)(@@)(@@)(@@) $ 2056 يوسف بن أبي بردة بن أبي موسى الأشعري كوفى ثقة PageV02P374(@)(@@)(@@)(@@) $ 2057 يوسف بن الحكم أبو الحجاج بن يوسف الثقفى ثقة وإنما روى حديثا واحدا عن محمد بن سعد بن أبي وقاص عن أبيه عن النبي صلى الله عليه وسلم قال من أراد هوان قريش اهانه الله(@)(@@)(@@)(@@) $ 2058 يوسف بن عبد الله بن سلام مدني تابعي ثقة(@)(@@)(@@)(@@) $ 2059 يوسف بن عدى أبو يعقوب كوفى ثقة وأخوه زكريا أرفع منه(@)(@@)(@@)(@@) $ 2060 يوسف بن عطية بن ثابت الصفار ضعيف الحديث PageV02P375(@)(@@)(@@)(@@) $ 2061 يوسف بن يونس بن أبي إسحاق كوفى ثقة وقال مرة جائز الحديث PageV02P376(@)(@@)(@@)(@@) || ( باب يونس )(@)(@@)(@@)(@@) $ 2062 يونس بن أبي إسحاق ثقة وقال مرة جائز الحديث(@)(@@)(@@)(@@) $ 2063 يونس بن بكير الشيباني وكان على مظالم جعفر بن برمك ضعيف الحديث وابنه بكر مذكور في موضعه(@)(@@)(@@)(@@) $ 2064 يونس بن جبير أبو غلاب بصرى تابعي ثقة(@)(@@)(@@)(@@) $ 2065 يونس بن خباب كوفى أظنه قال شيعى خبيث يقال إنه كان يقول عثمان قتل ابنتى النبي صلى الله عليه وسلم الشك من أبي مسلم PageV02P377(@)(@@)(@@)(@@) $ 2066 يونس بن فروة الزنديق قرنه بزنديق قال وإنه ليطلب وإنه لفى المسجد الحرام فذهب فألقى نفسه بين النساء فحللنه فقيل له لم فعلت قال إنهن ارحم ثم خرج إلى البصرة فلم يزل بها حتى مات فلما احتضر قال ما أشد الغربة انظروا لي ها هنا أحدا من أهل بلادى فنظروا فإذا أفضل رجلين من أهل الكوفة عبد الرحمن بن عبد الملك بن ابجر والحسن بن عياش 
ms135	 أخو أبي بكر بن عياش فأوصى إلى الحسن بن عياش في تركته وأوصى إلى عبد الرحمن بالصلاة عليه فلما حضرت الصلاة قال بنو تميم يماني يصلى عليه مضرى وكان عبد الرحمن كنديا فقيل إنه أوصى بذلك فخلوا سبيله وكان أصحاب الحديث يأتونه في مكانه وإذا سمع بصاحب حديث بعث إليه وكان يقول أنت يعنى يا يحيى تريد مثل أبي وائل عن عبد الله أين نجد لك يحيى كل وقت هذا اذهب إلى الكوفة فجئنى بكتبى أحدثك قال له يحيى أنا أختلف إليك وأخاف على دمى فأين أذهب فآتى بكتبك قال وكان يحيى جبانا جدا PageV02P378(@)(@@)(@@)(@@) $ 2067 يونس بن ميسرة بن حلبس شامي ثقة تابعي(@)(@@)(@@)(@@) $ 2068 يونس بن يزيد الأيلي ثقة قال وكيع لقيت يونس يعنى الأيلي فجهد الجهد حتى يخلص منه حديث واحد فلم يكن يحفظ PageV02P379(@)(@@)(@@)(@@) $ 2069 يونس بن يونس بن أبي إسحاق جائز الحديث PageV02P380(@)(@@)(@@)(@@) | ( باب الكنى )(@)(@@)(@@)(@@) || باب الألف(@)(@@)(@@)(@@) $ 2070 أبو الأبيض شامي ثقة تابعي(@)(@@)(@@)(@@) $ 2071 أبو أحمد بن عبد الله بن الزبير الأسدي مذكور مع محمد بن يوسف الفريابي(@)(@@)(@@)(@@) $ 2072 أبو إدريس الخولاني اسمه عائذ الله تقدم(@)(@@)(@@)(@@) $ 2073 أبو أسامة كوفى ثقة وكان يعد من حكماء أصحاب الحديث حدثني داود بن يحيى بن يمان عن أبيه عن سفيان قال ما بالكوفة شاب اعقل من أبي أسامة قال العجلي ومات أبو أسامة بالكوفة في شوال سنة إحدى ومائتين وحضرت جنازته وصلى عليه محمد بن إسماعيل بن على بن عبد الله بن عباس الهاشمي وكبر عليه أربعا(@)(@@)(@@)(@@) $ 2074 أبو إسحاق الشيباني سليمان بن أبي سليمان تقدم(@)(@@)(@@)(@@) $ 2075 أبو إسحاق الفزاري إبراهيم بن محمد تقدم(@)(@@)(@@)(@@) $ 2076 أبو أسماء مولى عبد الله بن جعفر مدني تابعي ثقة PageV02P381(@)(@@)(@@)(@@) $ 2077 أبو أسماء الرحبي شامي تابعي ثقة(@)(@@)(@@)(@@) $ 2078 أبو إسماعيل المؤدب ثقة سكن بغداد(@)(@@)(@@)(@@) $ 2079 أبو أسيد الساعدي من أصحاب النبي صلى الله عليه وسلم كان أعمى(@)(@@)(@@)(@@) $ 2080 أبو الأشعث الصنعاني صنعاء دمشق شامي تابعي ثقة PageV02P382(@)(@@)(@@)(@@) $ 2081 أبو الأعين العبدي ثقة(@)(@@)(@@)(@@) $ 2082 أبو أفلح الهمداني بصرى ثقة 
ms136	(@)(@@)(@@)(@@) $ 2083 أبو أكيمة مدني تابعي ثقة PageV02P383(@)(@@)(@@)(@@) $ 2084 أبو امامة سهل بن حنيف مدني تابعي ثقة PageV02P384(@)(@@)(@@)(@@) $ 2085 أبو أيوب بصرى تابعي ثقة PageV02P385(@)(@@)(@@)(@@) || ( باب الباء الموحدة )(@)(@@)(@@)(@@) $ 2086 أبو بحرية شامي تابعي ثقة(@)(@@)(@@)(@@) $ 2087 أبو البخترى الطاى كوفى تابعي ثقة وكان فيه تشيع(@)(@@)(@@)(@@) $ 2088 أبو بردة الظفري مدني تابعي ثقة PageV02P386(@)(@@)(@@)(@@) $ 2089 أبو بردة بن أبي موسى الأشعري كوفى تابعي ثقة وكان على قضاء الكوفة ولى بعد شريح وكان كاتبه سعيد بن جبير(@)(@@)(@@)(@@) $ 2090 أبو بسرة مدني تابعي ثقة(@)(@@)(@@)(@@) $ 2091 أبو بشر شامي تابعي ثقة(@)(@@)(@@)(@@) $ 2092 أبو بكر الصديق رضي الله عنه قال العجلي سألت الفريابي ما تقول أبو بكر أفضل أو لقمان قال ما سمعت هذا إلا منك أبو بكر أفضل من لقمان رضي الله عنهما قال عاتب الله الخلق في هذه الآية ما خلا أبا بكر الصديق إلا تنصروه فقد نصره الله إذ أخرجه الذين كفروا ثاني اثنين إذ هما في الغار إذ يقول لصاحبه واسمه عبد الله بن عثمان ولقبه عتيق من عتق وجهه وكان أعلم قريش بأنسابها رضوان الله عليه(@)(@@)(@@)(@@) $ 2093 أبو بكر بن أنس بن مالك بصرى تابعي ثقة(@)(@@)(@@)(@@) $ 2094 أبو بكر بن حفص بن عمر بن سعد بن أبي وقاص مدني ثقة PageV02P387(@)(@@)(@@)(@@) $ 2095 أبو بكر بن حفص بن سعد بن مالك ثقة قلت الظاهر أنه الذي قبله(@)(@@)(@@)(@@) $ 2096 أبو بكر بن سالم العمرى المدني ثقة(@)(@@)(@@)(@@) $ 2097 أبو بكر بن عبد الرحمن بن الحارث بن هشام المخزومي مدني تابعي ثقة(@)(@@)(@@)(@@) $ 2098 أبو بكر بن عمرو الزهرى كوفى تابعي ثقة(@)(@@)(@@)(@@) $ 2099 أبو بكر بن عياش كوفى ثقة مولى بنى أسد PageV02P388(@)(@@)(@@)(@@) $ 2100 أبو بكر بن أبي موسى الأشعري كوفى تابعي ثقة(@)(@@)(@@)(@@) $ 2101 أبو بكر الحنفي أخو عبيد الله بن عبد المجيد بصرى ثقة وكان له فقه PageV02P389(@)(@@)(@@)(@@) $ 2102 أبو بكر بن قطاف النهشلي من أنفسهم وكان ثقة وكان يرى الإرجاء لين القول فيه وكان إذا سمع الرجل من أصحابه يقول إنه مؤمن على إيمان جبريل وميكائيل يقول فقدتك إن هذا الكلام لم 
ms137	 يجىء بيوم خير قط لا تقل هكذا ولكن قل آمنت بما آمن به جبريل وميكائيل فلا يعيب ذا عليك أحد وكان يقال إنه ممن يخلف الأخ من إخوانه أربعين عاما في أهله(@)(@@)(@@)(@@) $ 2103 أبو بكرة الصحابي اسمه نفيع تقدم من أصحاب النبي صلى الله عليه وسلم وكان من خيار أصحاب النبي صلى الله عليه وسلم PageV02P390(@)(@@)(@@)(@@) || ( باب التاء )(@)(@@)(@@)(@@) $ 2104 أبو تميم الجيشاني مصرى تابعي ثقة(@)(@@)(@@)(@@) $ 2105 أبو تميم مصرى تابعي ثقة قلت لعله الأول(@)(@@)(@@)(@@) $ 2106 أبو التياح اسمه يزيد بن حميد تقدم بصرى تابعي ثقة(@)(@@)(@@)(@@) || ( باب الجيم )(@)(@@)(@@)(@@) $ 2107 أبو جبيرة ثنا أبو مسلم قال قال أبي أحمد الشعبي عن أبي جبيرة عن النبي صلى الله عليه وسلم حديث واحد لا تنابزوا بالألقاب ليس له عن النبي صلى الله عليه وسلم غير هذا الحديث وهو كوفى(@)(@@)(@@)(@@) $ 2108 أبو جعفر الرازي التيمى ضعيف الحديث PageV02P391(@)(@@)(@@)(@@) $ 2109 أبو جمرة الضبعي بصري ثقة(@)(@@)(@@)(@@) $ 2110 أبو جناب الكلبي كوفى ضعيف الحديث يكتب حديثه وفيه ضعف(@)(@@)(@@)(@@) $ 2111 أبو الجهم روى عنه مطرف كوفى تابعي ثقة PageV02P392(@)(@@)(@@)(@@) $ 2112 أبو الجوزاء كوفى تابعي ثقة(@)(@@)(@@)(@@) || ( باب الحاء المهملة )(@)(@@)(@@)(@@) $ 2113 أبو حازم الأحمسي كوفى من أصحاب النبي صلى الله عليه وسلم وهو والد قيس بن أبي حازم(@)(@@)(@@)(@@) $ 2114 أبو حازم الأحمسي يروى عن أبي هريرة كوفى PageV02P393(@)(@@)(@@)(@@) $ 2115 أبو حازم الأشجعي اسمه سلمان تقدم مولى عزة كوفى تابعي ثقة سمع من أبي هريرة(@)(@@)(@@)(@@) $ 2116 أبو حازم بن دينار التمار الأعرج مدني تابعي ثقة وكان رجلا صالحا سمع من سهل بن سعد الساعدي ولم يسمع من أبي هريرة(@)(@@)(@@)(@@) $ 2117 أبو حبيبة مولى عروة مدني تابعي ثقة(@)(@@)(@@)(@@) $ 2118 أبو حسان الأعرج بصرى تابعي ثقة ويقال كان يرى رأى الخوارج(@)(@@)(@@)(@@) $ 2119 أبو الحسن المدايني كان بالبصرة فلم أر أحدا كتب عنه شيئا(@)(@@)(@@)(@@) $ 2120 أبو الحصين الحجري بصرى تابعي ثقة PageV02P394(@)(@@)(@@)(@@) $ 2121 أبو حفصة الحبشي شامي تابعي ثقة(@)(@@)(@@)(@@) $ 2122 أبو حفصة الجشمي شامي تابعي ثقة(@)(@@)(@@)(@@) $ 2123 أبو الحكم عن بن عباس وعن بن عمر حجازي ثقة(@)(@@)(@@)(@@) $ 2124 أبو الحكم 
ms138	 عن الطفيل سيار بن منظور كوفى تابعي ثقة PageV02P395(@)(@@)(@@)(@@) $ 2125 أبو الحلال العتكي بصرى تابعي ثقة(@)(@@)(@@)(@@) $ 2126 أبو حميمة بن حصين بصرى ثقة(@)(@@)(@@)(@@) $ 2127 أبو حنظلة السكسكي شامي تابعي ثقة(@)(@@)(@@)(@@) $ 2128 أبو حيان من أصحاب عبد الله ثقة PageV02P396(@)(@@)(@@)(@@) $ 2129 أبو حي المؤذن شامي تابعي ثقة PageV02P397(@)(@@)(@@)(@@) $ 2130 أبو حيي الصنعاني مصرى تابعي ثقة(@)(@@)(@@)(@@) || ( باب الخاء المعجمة )(@)(@@)(@@)(@@) $ 2131 أبو خالد الأحمر اسمه سليمان بن حيان تقدم(@)(@@)(@@)(@@) $ 2132 أبو خالد الأنصاري روى عنه بكر بن سوادة مصرى تابعي ثقة(@)(@@)(@@)(@@) $ 2133 أبو خالد الدالاني PageV02P398(@)(@@)(@@)(@@) $ 2134 أبو خدويه سهل بن حسان البصري ثقة حسن الحديث حسن العقل يشابه على بن المديني(@)(@@)(@@)(@@) $ 2135 أبو خشينة حاجب بن عمر بصرى ثقة(@)(@@)(@@)(@@) $ 2136 أبو الخطاب مصرى تابعي ثقة(@)(@@)(@@)(@@) $ 2137 أبو خلدة خالد بن دينار بصرى ثقة PageV02P399(@)(@@)(@@)(@@) || ( باب الدال المهملة )(@)(@@)(@@)(@@) $ 2138 أبو الدهقان من أصحاب عبد الله ثقة(@)(@@)(@@)(@@) $ 2139 أبو الدهماء العدوى بصرى تابعي ثقة(@)(@@)(@@)(@@) $ 2140 أبو الديلمي شامي تابعي ثقة(@)(@@)(@@)(@@) || ( باب الراء )(@)(@@)(@@)(@@) $ 2141 أبو راشد الحبراني شامي تابعي ثقة لم يكن بدمشق في زمانه أفضل منه(@)(@@)(@@)(@@) $ 2142 أبو راشد كوفى تابعي ثقة PageV02P400(@)(@@)(@@)(@@) $ 2143 أبو رافع الصائغ ثقة من كبار التابعين وكان عبدا فأعتق وكان رجلا صالحا بصرى اسمه نفيع تقدم(@)(@@)(@@)(@@) $ 2144 أبو الربيع كوفى تابعي ثقة(@)(@@)(@@)(@@) $ 2145 أبو ربيعة بصرى ضعيف وقد كتبت عنه وليس هو بشيء(@)(@@)(@@)(@@) $ 2146 أبو رجاء العطاردي فخذ من بنى تميم بصرى تابعي ثقة وكان جاهليا(@)(@@)(@@)(@@) $ 2147 أبو رزين الأسدي كوفى تابعي ثقة(@)(@@)(@@)(@@) $ 2148 أبو رهم السماعى تابعي شامي ثقة PageV02P401(@)(@@)(@@)(@@) $ 2149 أبو الرياح الأسدي كوفى تابعي ثقة PageV02P402(@)(@@)(@@)(@@) || ( باب الزاي )(@)(@@)(@@)(@@) $ 2150 أبو الزبير مكي تابعي ثقة(@)(@@)(@@)(@@) $ 2151 أبو زرعة اللخمي مصرى تابعي ثقة(@)(@@)(@@)(@@) $ 2152 أبو الزعراء الذي روى عنه بن عيينة ثقة(@)(@@)(@@)(@@) $ 2153 أبو الزهير مصرى تابعي ثقة PageV02P403(@)(@@)(@@)(@@) || ( باب السين المهملة )(@)(@@)(@@)(@@) $ 2154 أبو سالم الجيشاني مصرى تابعي ثقة(@)(@@)(@@)(@@) $ 2155 أبو سبرة مدني تابعي ثقة(@)(@@)(@@)(@@) $ 2156 أبو سعيد الحبراني شامي تابعي ثقة(@)(@@)(@@)(@@) $ 2157 أبو سعيد بن الحارث مدني تابعي ثقة(@)(@@)(@@)(@@) $ 2158 أبو سعيد المقبري مدني تابعي ثقة 
ms139	 قلت اسمه كيسان(@)(@@)(@@)(@@) $ 2159 أبو سعيد المؤدب سكن بغداد ثقة(@)(@@)(@@)(@@) $ 2160 أبو سعيد مولى المهري مصرى تابعي ثقة(@)(@@)(@@)(@@) $ 2161 أبو سفيان الذي يروى عنه الأعمش جائز الحديث وليس بالقوي PageV02P404(@)(@@)(@@)(@@) $ 2162 أبو سلام الحبشي شامي تابعي ثقة(@)(@@)(@@)(@@) $ 2163 أبو سلمة بن عبد الرحمن بن عوف مدني تابعي ثقة(@)(@@)(@@)(@@) $ 2164 أبو سنان الديلي مدني تابعي ثقة PageV02P405(@)(@@)(@@)(@@) $ 2165 أبو سهلة مولى عثمان كوفى تابعي ثقة(@)(@@)(@@)(@@) || ( باب الشين المعجمة )(@)(@@)(@@)(@@) $ 2166 أبو الشعثاء حدثنا أبو مسلم حدثني أبي حدثنا بن أبي مريم قال سمعت سفيان بن عيينة قال له إنسان حدثك عمرو بن دينار عن أبي الشعثاء عن على بن أبي طالب قال أسكت ما حدث أبو الشعثاء عن على بن أبي طالب حديثا قط(@)(@@)(@@)(@@) $ 2167 أبو شعيب الأنصاري مصرى تابعي ثقة(@)(@@)(@@)(@@) $ 2168 أبو شهاب الحناط كوفى ثقة روى عنه سعدويه PageV02P406(@)(@@)(@@)(@@) $ 2169 أبو شيخ الهنائي بصرى تابعي ثقة PageV02P407(@)(@@)(@@)(@@) || ( باب الصاد )(@)(@@)(@@)(@@) $ 2170 أبو صالح باذام ثقة تقدم(@)(@@)(@@)(@@) $ 2171 أبو صالح مولى جبير بن مطعم مصرى تابعي ثقة(@)(@@)(@@)(@@) $ 2172 أبو صالح الحنفي اسمه عبد الرحمن بن قيس ويقال ماهان كوفى تابعي ثقة من خيار التابعين من أصحاب على(@)(@@)(@@)(@@) $ 2173 أبو صالح مولى السفاح مدني تابعي ثقة(@)(@@)(@@)(@@) $ 2174 أبو صالح السمان اسمه ذكوان ثقة تقدم(@)(@@)(@@)(@@) $ 2175 أبو صالح مولى ضباعة روى عنه الكوفيون ثقة(@)(@@)(@@)(@@) $ 2176 أبو صالح الضبي ثقة كوفى(@)(@@)(@@)(@@) $ 2177 أبو صالح مولى عثمان روى عنه زهرة بن معبد وأهل مصر ثقة(@)(@@)(@@)(@@) $ 2178 أبو صالح مولى المهري مدني تابعي ثقة PageV02P408(@)(@@)(@@)(@@) $ 2179 أبو صالح روى عنه أهل البصرة سليمان التيمى وخالد الحذاء اسمه ميزان(@)(@@)(@@)(@@) $ 2180 أبو صالح روى عنه بن أبي كثير اسمه قيلويه تابعي ثقة(@)(@@)(@@)(@@) $ 2181 أبو صالح الغفاري مصرى تابعي ثقة PageV02P409(@)(@@)(@@)(@@) $ 2182 أبو صالح روى عنه إسماعيل بن أبي خالد في التفسير اسمه ثقة وهو مولى أم هانئ روى عن على بن أبي طالب(@)(@@)(@@)(@@) $ 2183 أبو صخر اسمه حميد بن زياد تقدم(@)(@@)(@@)(@@) $ 2184 أبو صرمة تابعي ثقة(@)(@@)(@@)(@@) $ 2185 أبو الصهباء البكري تابعي ثقة PageV02P410(@)(@@)(@@)(@@) $ 2186 أبو الصمد 
ms140	 بن الأعمى من أصحاب عبد الله(@)(@@)(@@)(@@) || ( باب الضاد )(@)(@@)(@@)(@@) $ 2187 أبو الضحاك الحمصي شامي تابعي ثقة(@)(@@)(@@)(@@) || ( باب الطاء المهملة خال مبيض )(@)(@@)(@@)(@@) || باب الظاء(@)(@@)(@@)(@@) $ 2188 أبو ظبيان الجنبي كوفى تابعي ثقة PageV02P411(@)(@@)(@@)(@@) || (@)(@@)(@@)(@@) $ 2189 أبو العالية الرياحي اسمه رفيع بصرى تابعي ثقة من كبار التابعين ويقال إنه لم يسمع من على شيئا إنما يرسل عنه وقتادة لم يسمع من أبي العالية إلا أربعة أحاديث(@)(@@)(@@)(@@) $ 2190 أبو العالية البراء بصرى تابعي ثقة(@)(@@)(@@)(@@) $ 2191 أبو عامر الألهاني شامي تابعي ثقة(@)(@@)(@@)(@@) $ 2192 أبو عبد الله مولى الجندعيين مدني تابعي ثقة(@)(@@)(@@)(@@) $ 2193 أبو عبد الله الأغر مدني تابعي ثقة(@)(@@)(@@)(@@) $ 2194 أبو عبد الله الجدلي كوفى تابعي ثقة(@)(@@)(@@)(@@) $ 2195 أبو عبد الجبار شامي تابعي ثقة PageV02P412(@)(@@)(@@)(@@) $ 2196 أبو عبد الرحمن السلمي المقرىء الأعمى كوفى من أصحاب عبد الله ثقة وكان يقرىء في زمان عثمان إلى زمان الحجاج وقرأ على عثمان بن عفان وعرض على على بن أبي طالب(@)(@@)(@@)(@@) $ 2197 أبو عبس المسعودي كوفى ثقة(@)(@@)(@@)(@@) $ 2198 أبو عبيد الله مسلم بن مشكم شامي تابعي ثقة من خيار التابعين(@)(@@)(@@)(@@) $ 2199 أبو عبيدة بن حذيفة كوفى تابعي ثقة PageV02P413(@)(@@)(@@)(@@) $ 2200 أبو عبيدة بن عبد الله بن مسعود كوفى ثقة تابعي ولم يسمع من أبيه شيئا(@)(@@)(@@)(@@) $ 2201 أبو عبيدة بن معن بن عبد الرحمن بن عبد الله بن مسعود ثقة وكان ختم على الأعمش القرآن(@)(@@)(@@)(@@) $ 2202 أبو عبيدة الحداد بغدادي ثقة(@)(@@)(@@)(@@) $ 2203 أبو العبيدين الأعمى من أصحاب عبد الله ثقة(@)(@@)(@@)(@@) $ 2204 أبو عثمان مصرى تابعي ثقة PageV02P414(@)(@@)(@@)(@@) $ 2205 أبو عثمان قال العجلي حدثنا أبو عثمان البغدادي ثقة ثنا سفيان بن عيينة عن عمرو بن دينار عن بن أبي مليكة عن المسور بن مخرمة قال قال عمر بن الخطاب لعبد الرحمن بن عوف ألم يكن معي قاتلوا في الله آخر مرة كما قاتلتم فيه أول مرة قال متى ذلك يا أبا محمد قال إذا كانت بنو أمية الأمراء وبنو مخزوم الوزراء PageV02P415(@)(@@)(@@)(@@) $ 2206 أبو عثمان النهدي ثقة حدثنا أبو مسلم حدثني أبي حدثنا يوسف بن عدى ثنا عبد 