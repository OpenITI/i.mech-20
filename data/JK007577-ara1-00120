ms101	 النفوس حصاره % % 24(@)(@@) % والمرجفون يلبدون عجاجة % % رجما بغيب أخفيت أقداره % % 25(@)(@@) % حتى إذا قالوا تسعر ثاقب % % عم السماء بلفحه استسعاره % % 26(@)(@@) % أذكى شعاع الشمس نار قرانه % % وهو الذي رصدت له أدواره % % 27(@)(@@) % واحتل بيت الليث في آثاره % % زحل وليث الغاب يرهب زاره % % 28(@)(@@) % والعلم علم الله جل جلاله % % والعبد إدراك القصور قصاره % % 29(@)(@@) % وإذا الغني خفيت عليه مسالك % % منه فكيف لغيره إبصاره % % 30(@)(@@) % بين النجوم تشبها ريح الصبا % % والليل ينهب بالنسيم صواره % % PageV01P428 31(@)(@@) % والصبح قطع في فجاج شروقه % % والأرض قصر أحميت أقطاره % % 32(@)(@@) % إذ أقبلت سحب الغمام حوافلا % % فحثا يجلجل في الثرى مدراره % % 33(@)(@@) % وأنار شيب البرق عارض عارض % % تحدى بأصوات الرعود قطاره % % 34(@)(@@) % فغزت عدو المحل في أحجاره % % حتى إذا طفيت بهن جماره % % 35(@)(@@) % أخذت عليه شعابه ونقابه % % جون الغمام فعفيت آثاره % % 36(@)(@@) % فاهتز نبت الأرض بعد سكونه % % نشأ وفك من الرغام إساره % % 37(@)(@@) % واستأنف الروض اقتبال شبابه % % فأظل من بعد المشيب عذاره % % 38(@)(@@) % وتسربل الريحان حلة سندس % % رقمت جنوب جيوبها أزهاره % % 39(@)(@@) % وتتوجت زهرا مفارق دوحه % % وتدرجت في حجره أبكاره % % 40(@)(@@) % لولا مقام للضراعة قمته % % فمحا خطيات الورى استغفاره % % PageV01P429 41(@)(@@) % ما كان هذا الخطب مما ينقضي % % وللج في آفاقها إعصاره % % 42(@)(@@) % يا أيها الملك المرجى والذي % % شهدت بتقوى ربه أخباره % % 43(@)(@@) % كم موقف لك والقلوب خوافق % % يهفو بأجرام الجبال وقاره % % 44(@)(@@) % في جحفل لجب تلاطم موجه % % وطما بأثباج الظبا زخاره % % 45(@)(@@) % شغفت به بيض الصوارم في الطلا % % وطما بأثباج الظبا زخاره % % 46(@)(@@) % أطلعت من شهب الرماح ثواقبا % % في مأزق أخفى ذكاء غباره % % 47(@)(@@) % هيهات يجحد فضل مجدك جاحد % % إن العلا علم وفخرك ناره % % 48(@)(@@) % وأدرت أفلاك السياسة فوقه % % فافتر في ليل الخطوب نهاره % % 49(@)(@@) % إن أصبحت أرض الخلافة معدنا % % فالناس تربته وأنت نضاره % % 50(@)(@@) % لا غرو أن طلعت فعالك أنجما % % إن الهدى فلك عليك مداره % % PageV01P430 51(@)(@@) % حليته وحميت من أرجائه % % فلأنت حقا صوره وسواره % % 52(@)(@@) % أبني عبادة إن فخر قد يمكم % % تليت بفرقان الهدى أسطاره % % 53(@)(@@) % النصر لفظ 
ms102	 أنتم مدلوله % % والدين روض أنتم نواره % % 54(@)(@@) % والحلم لحظ أنتم أجفانه % % والعلم قلب أنتم أنواره % % 55(@)(@@) % نصر النبوة فيكم مستودع % % فهو النسيم وأنتم أسحاره % % 56(@)(@@) % القوم ظل الله بين عباده % % حاط اليقين بهم فعز ذماره % % 57(@)(@@) % آوى لظلهم الهدى ولقبل ما % % أردى الضلال بعزهم مختاره % % 58(@)(@@) % من كان أنصار النبي جدوده % % فملائك السبع العلا أنصاره % % 59(@)(@@) % لله في إنجاز نصرك موعد % % قد آن من إصباحه إسفاره % % 60(@)(@@) % دجت الخطوب فكنت نور ظلامها % % خفي الرشاد فكنت أنت مناره % % PageV01P431 61(@)(@@) % فجوارح الإسلام أنت حياتها % % حقا وصدر الدين أنت صداره % % 62(@)(@@) % فاهزز ظبا النصر العزيز فإن من % % عاداك مطلول النجيع جباره % % 63(@)(@@) % قد عاذ ذو الإقدام منك بسلمه % % ذعرا وأذعن رهبة جباره % % 64(@)(@@) % ذخرتك أحكام الإله لنصره % % ونمتك من هذا الأنام خياره % % 65(@)(@@) % فارفع شعار الحق في علم الهدى % % حتى يقر على النجوم قراره % % 66(@)(@@) % وانعم بمقتبل السعود فإنما % % يجري القضاء بكل ما تختاره % % 67(@)(@@) % في مصر قلبي من خزائن يوسف % % حب وعير مدائحي تمتاره % % 68(@)(@@) % حليت شعري باسمه فكأنه % % في كل قطر حله ديناره % % PageV01P432 البحر : طويل 1(@)(@@) % أدارهم بين الأجارع فالسدر % % سقتك الغوادي كل منسكب القطر % % 2(@)(@@) % أجيبي تجافت عن رباك يد الردى % % ولا نضبت أمواه موردك الغمر % % 3(@)(@@) % ولا زال ظل البان فيك منعما % % يميس من الأوراق في حلل خضر % % 4(@)(@@) % متى ظعن الحي الجميع وأصبحوا % % كما افترق الحجاج في ليلة النفر % % 5(@)(@@) % وأين استقلوا هل بهضب تهامة % % محلين أم حلوا على قنة الحجر % % 6(@)(@@) % وإذ زجروها معرقين فهل سروا % % بشط دجيل أم أجازوا على الجسر % % 7(@)(@@) % أم الشام أموا أم على رمل خالج % % حدوا عابرين النيل قصدا إلى مصر % % 8(@)(@@) % فقالت سروا والليل مرخ سدوله % % وجنح الليالي في اقتبال من العمر % % 9(@)(@@) % وشدوا عقود العزم فوق رحالهم % % فما راعني إلا ركائبهم تسري % % 10(@)(@@) % فهذا عزمي قد بثت شجونه % % إليك وما قد كان بعد فلا أدري % % PageV01P433 11(@)(@@) % ولولا نسيم دل طيب حديثه % % علي وآراج تضوع للسفر % % 12(@)(@@) % لما عرفوا مني المكان 
ms103	 ولا بدت % % مثول طلول فوق كثباني العفر % % 13(@)(@@) % يمينا برب الراقصات إلى منى % % وحرمة ما بين المقام إلى الحجر % % 14(@)(@@) % لو أنني أعطيت الصبابة حقها % % وأمكنت مغتال التشوق من صدري % % 15(@)(@@) % لما سغت من ورد الحياة صباية % % ولو سغتها من بعد ذاك فما عذري % % 16(@)(@@) % ولكن أبت إلا التصبر همة % % لها قصبات السبق في معرك الدهر % % 17(@)(@@) % تعوضت أنس الصبر من وحشة النوى % % وفوضت لله التصرف في أمري % % 18(@)(@@) % أفقرا وقد أوردت في مورد الغنى % % وخوفا وقد أصبحت جار بني نصر % % 19(@)(@@) % حططت بآل الله عوج ركائبي % % فلقيت بالترحيب والسهل والبر % % 20(@)(@@) % ولذت بهم من صولة الدهر عائذا % % كما جنح الطير المروع إلى وكر % % PageV01P434 21(@)(@@) % فمد جناح الأمن فوق مخافتي % % وقد فر عنها الذعر من شدة الذعر % % 22(@)(@@) % وأصبحت لا أخشى الزمان ودونه % % كتائب من قوم كرام ومن وفر % % 23(@)(@@) % مقيما أرى الأحداث من حيث لا ترى % % فمن مبلغ عن منزلي ربة الخدر % % 24(@)(@@) % بأقدم من يمضي إذا الخيل أحجمت % % وأحلم من يغضي وأكرم من يقري % % 25(@)(@@) % إذا نزل المكروه أو بخل الحيا % % فغيث لمعتر وغوث لمضطر % % 26(@)(@@) % فدونك يا آل الوجيه ملاعبي % % ظلالك والديباج من مرج خضر % % 27(@)(@@) % ويا بدر المال الصموت تبرجي % % وشأنك فابيضي إذا شئت واصفري % % 28(@)(@@) % ويا حلل الهضب اليماني فاخري % % نجوم الدجى أو حاسني زمن الزهر % % 29(@)(@@) % أيا ظاعنا نحر الدجنة يبتغي % % طلوع سنى الخيمات في مطلع الفجر % % 30(@)(@@) % ألا حدثن عني الأحبة إنني % % حططت بحي لا يلين على قسر % % PageV01P435 31(@)(@@) % وإني مذ يممت حضرة يوسف % % تقل مقادير الخلائق عن قدر % % 32(@)(@@) % بحيث أتيت الأرض مسكا ترابها % % وأوطيت من حصبائها أنفس الدر % % 33(@)(@@) % سقيت بها ظمآن من مورد الحيا % % وأنشقت في آفاقها عنبر الشحر % % 34(@)(@@) % وحييت شمس الملك في مطلع الهدى % % وقبلت كف الليث في لجة البحر % % 35(@)(@@) % ووقفت آمالي على ملك الورى % % فأعديت أرباح الرجاء على خسر % % 36(@)(@@) % وناديت بالأمال من هضبة العلا % % هلموا إلى ورد السماحة والبشر % % 37(@)(@@) % أمير الطوال السمر والقضب البتر 
ms104	 % % وحافظ دين الله في نازح الثغر % % 38(@)(@@) % خبت نار حرب لم تهجها وأقفرت % % منازل قوم لم تبت منك في خدر % % 39(@)(@@) % وفلت جموع ناصبتك فإنها % % تقارع سيفا في يد الصمد الوتر % % 40(@)(@@) % تركت أبيات المفارق منهم % % ترابا وأغماد السيوف عصا تجري % % PageV01P436 41(@)(@@) % فلله ما أعززت من ملة الهدى % % ولله ما أذللت من ملة الكفر % % 42(@)(@@) % ولله عيد فاتحتك سعوده % % تحييك بالفتح القريب وبالنصر % % 43(@)(@@) % ولله من صوم قضيت حقوقه % % وزودته المتلو من سور الذكر % % 44(@)(@@) % وصلت به ليل التمام بيومه % % وناجيت منها الروح في ليلة القدر % % 45(@)(@@) % إلى أن تقضى عنك لا عن ملالة % % فبورك من صوم زكي ومن فطر % % 46(@)(@@) % أمولاي لو كان النهار صحيفتي % % وكان ظلام الليل من دونها حبري % % 47(@)(@@) % وكانت حديدات الجوارح أالسنا % % لقصرت في حمدي علاك وفي شكري % % 48(@)(@@) % أعدت لنا من عهد أسلافك الرضا % % عهودا فيا طيب الوصال على الهجر % % 49(@)(@@) % وجددت فينا نعمة طال عهدنا % % بها فاجتلينا غرة الزمن النضر % % 50(@)(@@) % خليلي إن الشعر سحر وإنني % % إذا شئتما تحقيقه بابل السحر % % PageV01P437 51(@)(@@) % وما الدر إلا ما أراني قائلا % % فساحله نظمي ولجته فكري % % 52(@)(@@) % جعلت امتداحي فيك أشرف حلية % % أباهي بها الأقوام في محفل الفخر % % 53(@)(@@) % وأعددت حبي في علاك وسيلة % % ألاقي بها الرحمن في موقف الحشر % % PageV01P438 البحر : طويل 1(@)(@@) % رجعنا بحول الله بعد استدارة % % برقبانها للإنس كيد اختياره % % 2(@)(@@) % كما راجع البركار مفروض نقطة % % من السطح منها كان بدء مداره % % PageV01P439 البحر : منسرح 1(@)(@@) % أغرى بي الشامت الحسود % % وما درى أني مهجور % % 2(@)(@@) % فإن شكت أسيافها من دمي % % يقول للألحاظ مه جوروا % % PageV01P440 البحر : كامل تام 1(@)(@@) % يا وارث المهدي في الجبل الذي % % فضل الجبال فكان مطلع بدره % % 2(@)(@@) % بمصلاه ومدرسه الذي % % أهدى من التوحيد يانع زهره % % 3(@)(@@) % أبشر فإنك بعدما بعد المدى % % وتولت الدنيا مجدد أمره % % 4(@)(@@) % واعلم بأنك أنت عامر ربعه % % واعلم بأنك أنت نكته سره % % 5(@)(@@) % وإذا بلغت إلى محلك سالما % % سلم لسعدك في أزمة أمره % % PageV01P441 البحر : طويل 1(@)(@@) % مبارك ما قدمت 
ms105	 سفيان رغبة % % ولا خوف تقصير ولا سوء سيرة % % 2(@)(@@) % وما نظرة مني إليك أعدها % % سوى نعمة لله في كبيرة % % 3(@)(@@) % وإن كان ما لقيت قبلك أنجما % % فأنت على التحقيق شمس منيرة % % 4(@)(@@) % ورب صلاة قدم النفل قبلها % % وتشرب من قبل الثريد حريرة % % PageV01P442 البحر : طويل 1(@)(@@) % كأنا بتامسنا نجوس خلالها % % وممدودها في سيرنا ليس يقصر % % 2(@)(@@) % مراكب في البحر المحيط تخبطت % % ولا جهة تدرى ولا البر يبصر % % PageV01P443 البحر : وافر تام 1(@)(@@) % بتافلفت برغوث كثير % % يضج لهوله الفلك الأثير % % 2(@)(@@) % إذا عجلت لنا بالوثب قلنا % % أثار جراد مزرعة مثير % % PageV01P444 البحر : كامل تام 1(@)(@@) % يا ابن الخلائف يا سمي محمد % % يا من علاه ليس يحصر حاصر % % 2(@)(@@) % أبشر فأنت مجدد الملك الذي % % لولاك أصبح وهو رسم داثر % % 3(@)(@@) % من ذا يعاند منك وارثه الذي % % بسعوده فلك المشيئة دائر % % 4(@)(@@) % ألقت إليك يد الخلافة أمرها % % إذ كنت أنت لها الولي الناصر % % 5(@)(@@) % هذا وبينك للصريخ وبينها % % حرب مضرسة وبحر زاخر % % 6(@)(@@) % من كان هذا الصنع أول أمره % % حسنت له العقبى وعز الآخر % % 7(@)(@@) % مولاي عندي في علاك محبة % % والله يعلم ما تكن ضمائر % % 8(@)(@@) % قلبي يحدثني بأنك جابر % % كسري وحظي منك حظ وافر % % 9(@)(@@) % بثرى جدودك قد حططت حقيبتي % % فوسيلتي لعلاك نور باهر % % 10(@)(@@) % وبذلت وسعي واجتهادي مثلما % % يلقى لملكك سيف أمرك عامر % % PageV01P445 11(@)(@@) % وهو الولي لك الذي اقتحم الردى % % ونضى العزيمة وهو سيف باتر % % 12(@)(@@) % وولي جدك في الشدائد عندما % % خذلت علاه قبائل وعشائر % % 13(@)(@@) % فاستهد منه النصح واعلم أنه % % في كل معضلة طبيب ماهر % % 14(@)(@@) % وبعثتها لتنوب قبل توصلي % % لك إذ عراني عنك عذر ظاهر % % 15(@)(@@) % إن كنت قد عجلت بعض مدائحي % % فهي الرياض وللرياض بواكر % % PageV01P446 البحر : مجزوء الكامل 1(@)(@@) % مولاي يهنيك المطر % % وافى به الوطن الوطر % % 2(@)(@@) % رحم العباد بخاطر % % في حق نفسك قد خطر % % 3(@)(@@) % متدارك الدفعات يحسب % % من بنانك قد قطر % % 4(@)(@@) % أقسمت لو طلبت سعودك % % صلد صخر لانفطر % % 5(@)(@@) % عدم الغياث بستر عدلك % % في البرية والبطر % % 6(@)(@@) % أمن 
ms106	 الوجود بجودك البؤس % % وكان على خطر % % 7(@)(@@) % وروت حديث علاك حتى % % الترك كلا والتطر % % 8(@)(@@) % والله ما يحكيك ما % % كتب البيان وما سطر % % PageV01P447 البحر : طويل 1(@)(@@) % برابعة الساعات جئت أخبر % % وللمدح في المولى الهمام أخبر % % 2(@)(@@) % ولم لا وقد أحيا بك الله سنة % % نهلل في أعيادها ونكبر % % 3(@)(@@) % كأن ربيعا كان للناس شهره % % ربيعا سقاه عارض منك ممطر % % 4(@)(@@) % فأرجاؤه من نور وجهك تزدهي % % وبطحاؤه من نور وجهك تزهر % % 5(@)(@@) % محمد قد عظمت دين محمد % % ومثلك من يبدي الجميل ويظهر % % 6(@)(@@) % لقد شد أزر الملك منك خليفة % % له تحت ستر الغيب نصر مؤزر % % 7(@)(@@) % تبشر منه العارفون بوارد % % قريب المدى بالله فيما تبشر % % 8(@)(@@) % فكن واثقا بالله مستنصرا به % % فهل ثم إلا الله يكفي وينصر % % 9(@)(@@) % يقل جموع الشرك وهي كثيرة % % وينمي من الدين القليل فيكثر % % PageV01P448 البحر : طويل 1(@)(@@) % هنيئا بما خولت من رفعة القدر % % ودمت قرير العين منشرح الصدر % % 2(@)(@@) % وبشرى لملك قد طلعت بأفقه % % هلالا له سير إلى رتبة البدر % % 3(@)(@@) % خلفت الأب المرضي خير خلافة % % وقمت بأمر الله ممتثل الأمر % % 4(@)(@@) % ولما قضى المختار هل قام بعده % % بضم شتات الدين غير أبي بكر % % 5(@)(@@) % سعيد على الإسلام أنت وأهله % % فلا زلت في سعد يدوم وفي نصر % % PageV01P449 البحر : كامل تام 1(@)(@@) % أنا روضة وجه الأمير محمد % % شمسي ودوني للحسام غدير % % 2(@)(@@) % وإذا التقى روض ونهر كيف لا % % يلفى لأكواس الحروب مدير % % PageV01P450 البحر : طويل 1(@)(@@) % كأني قرص الشمس عند طلوعها % % وقد قدمت من قبلها نسمة الفجر % % 2(@)(@@) % كأن نسيما والهجير مطنب % % حديث وصال جاء في زمن الهجر % % 3(@)(@@) % وإلا كما هبت بمحتدم الوغى % % صبا النصر لكن من جنود بني نصر % % PageV01P451 البحر : متقارب تام 1(@)(@@) % جلا الحق قلبي حتى أنارا % % فآنست من جانب الطور نارا % % 2(@)(@@) % ودرت على مركزي دورة % % يحقر من دارها ملك دارا % % 3(@)(@@) % وحققت أنيتي وهي كنز % % فأخرجته إذ هدمت الجدارا % % 4(@)(@@) % وأبصرت رسمي رسما محيلا % % وأبصرت وصفي وصفا معارا % % 5(@)(@@) % فمن كان مثلي نال الغنى % % وباهى 
ms107	 وجر الذيول افتخارا % % 6(@)(@@) % رمى للوجود بأوهامه % % وحل القيود وفك الإسارا % % 7(@)(@@) % ولم يرض من بعد بالأهل أهلا % % ولم يرض من بعد بالدار دارا % % 8(@)(@@) % فمهما نطقت نطقت ادكارا % % ومهما صمت صمت اعتبارا % % 9(@)(@@) % ودير قطعت إليه الفلا % % وجبت الدجى وركبت البحارا % % 10(@)(@@) % ونادمت من أهله فتية % % تراهم سكارى وما هم سكارى % % PageV01P452 11(@)(@@) % كلفنا به في سياق الحديث % % فقمنا نعاقر فيه العقارا % % 12(@)(@@) % ولما حللنا بأكنافه % % حللنا الحبا ونبذنا الوقارا % % 13(@)(@@) % وطرنا إلى الراح فيه ارتياحا % % ومن هزه الوجد والشوق طارا % % 14(@)(@@) % ولاحت لهم خطفات البروق % % تلوح مرارا وتخفى مرارا % % 15(@)(@@) % يعارض فيها الجلال الجمال % % فهم بين قبض وبسط حيارا % % 16(@)(@@) % زعقنا براهبه زعقة % % وقلنا مددنا الأكف افتقارا % % 17(@)(@@) % ومن أجل خمرك جبنا الفلا % % وخضنا الدجى وقطعنا القفارا % % 18(@)(@@) % فقال وما مهرها عندكم % % فقلت أمتنا النفوس الكبارا % % 19(@)(@@) % فقال خبأت لكم خمرة % % تشح عليها النفوس الغيارا % % 20(@)(@@) % فكل حكيم وذكر حكيم % % عليها حنا وإليها أشارا % % PageV01P453 21(@)(@@) % مقدسة عن مكان يرى % % منزهة عن شعاع توارا % % 22(@)(@@) % معتقة جسمتها اليهود % % ومن بعدها ثلثتها النصارى % % 23(@)(@@) % وقال البراهيم والفرس فيها % % وقد جهلوا الحق نورا ونارا % % 24(@)(@@) % وغبنا فلم ندر من أمرنا % % سوى أننا قد غلبنا اضطرارا % % 25(@)(@@) % إليك سمي نبي الهدى % % مقالا يطابق منك اختيارا % % 26(@)(@@) % دعتني لما لست أهلا له % % علاك فجئت بجهدي ائتمارا % % 27(@)(@@) % فغط على نقصه بالكمال % % وأول قبولك مني اعتذارا % % PageV01P454 البحر : متقارب تام 1(@)(@@) % خليلي إن اشتقتني مرة % % تشوقك القلب مني مرارا % % 2(@)(@@) % وما زلت أصفيك محض الوداد % % وأمنحك الحب بحتا نضارا % % 3(@)(@@) % جعلتك في حادث الدهر سورا % % وفي معصم الفخر مني سوارا % % 4(@)(@@) % وأعددت ودك كنزا عتيدا % % أقمت الوفاء عليه جدارا % % 5(@)(@@) % لعمرك لو حيز لي ملك كسرى % % وخاقان ذي التاج أو ملك دارا % % 6(@)(@@) % وخيرت في ودك المرتضى % % وفيه لملت إليه ختيارا % % 7(@)(@@) % نسبت لي الذنب ظلما ولو % % جنيت لأملت منك اعتفارا % % 8(@)(@@) % فمثلك من يعثر الخل يوما % % فيغضي له ويقيل العثارا % % 9(@)(@@) % فكيف وكيف ولا ذنب 
ms108	 لي % % سوى الود مهما أعدت اعتبارا % % 10(@)(@@) % فمالك عوفيت ترضي العدا % % وتولي البعاد وتبدي النفارا % % PageV01P455 11(@)(@@) % تواريت عن ناظري ظاهرا % % وشخصك في الفكر ما إن توارى % % 12(@)(@@) % وأحللتني للأمان حمى % % ورميت بها من فؤادي الجمارا % % 13(@)(@@) % فمن بعتبك بعد العتاب % % وكنت أؤمل عنك اصطبارا % % PageV01P456 البحر : خفيف تام 1(@)(@@) % يا بني السادة الكرام نداء % % يبتغي الجبر للمهيض الكسير % % 2(@)(@@) % أنا بالحي مستجير وبالميت % % أما في كليهما من مجير % % 3(@)(@@) % ليس موسى هذا بصاحب فرعون % % ولا في عصاه من تأثير % % 4(@)(@@) % فانصروني وعينوا لي رسولا % % صارم الحد محكم التدبير % % 5(@)(@@) % وأريحوا بالياس قلبي فإني % % قد تخبطت في وبال كبير % % PageV01P457 البحر : كامل تام 1(@)(@@) % والي الولاة وواحد الزمن الذي % % تبأى الملوك بمثله وتفاخر % % 2(@)(@@) % صيرت حاتم طي يزري به % % زار ويسخر إن تذوكر ساخر % % 3(@)(@@) % إن كان طلا أنت جود ساجم % % أو كان نهرا أنت بحر زاخر % % 4(@)(@@) % وإذا الزمان الأول استعلى بأهليه % % أناف بك الزمان الآخر % % PageV01P458 البحر : طويل 1(@)(@@) % رأيت هدايا الأرض دونك قدرها % % فأهديتك العلم الذي جل ذكره % % 2(@)(@@) % عيونا من الأخبار والأدب الذي % % تضوع مسراه وأينع زهره % % 3(@)(@@) % ودر ثناء من علاك انتخبته % % ومن عجب يهدى إلى البحر دره % % 4(@)(@@) % وآثار أملاك كرام تقلدوا % % حلا بيتك النصري لله دره % % 5(@)(@@) % بلوا خلق الدنيا رخاء وشدة % % وجر بهم حلو الزمان ومره % % 6(@)(@@) % فما منهم من ضاق بالروع ذرعه % % ولا من تعاصى في الشدائد صبره % % 7(@)(@@) % وقاموا بأمر الله إن دهم الردى % % تكنفهم عضد الإلاه ونصره % % 8(@)(@@) % فدونك من أخبارهم كل رائق % % يطيب على الترداد والعود ذكره % % 9(@)(@@) % وكم طرفة أوردتها وغريبة % % تجلى بها من مجلس الملك نحره % % 10(@)(@@) % هدية مقصور عليك اعتماده % % وخدمة عبد مخلص لك صدره % % PageV01P459 11(@)(@@) % وسميتها من بعد ما أسأل الرضى % % لها طرفة العصر الذي بك فخره % % 12(@)(@@) % وإني وإن أطنبت فيك لقاصر % % ومن بلغ المجهود قد بان عذره % % PageV01P460 البحر : بسيط تام 1(@)(@@) % يا واحد الدهر في علم وفي عمل % % وعمدة الملك في ورد وفي صدر % % 2(@)(@@) % يا 
ms109	 صاحب القلم الأعلى الذي نسخت % % يراعه الصفر حكم الصارم الذكر % % 3(@)(@@) % ما مثل قولي لك انظر كسوة حسنت % % أو مثل قولي لك أذكر راوي السير % % 4(@)(@@) % وما اسم شيء إذا صحفت ثانيه % % فاذكربه رجلا قد طال في صحر % % 5(@)(@@) % يأتي مع النجم في تعديل جدوله % % حينا وإن كان معدودا من الشجر % % 6(@)(@@) % لا زالت العيس تروي كل شاردة % % عن منتداك بملء السمع والبصر % % 7(@)(@@) % فكلما رددت علياك قيل لها % % بالله قل وأعد يا طيب الخبر % % PageV01P461 البحر : طويل 1(@)(@@) % جنابك محفوظ وسعدك سافر % % وحزبك ظافر % % 2(@)(@@) % وفعلك للصنع الجميل محالف % % ورأيك للنجح المبين مؤازر % % 3(@)(@@) % وصرح علاك في سراوة يعرب % % تبيد الليالي دونه وهو عامر % % 4(@)(@@) % يطل على أوج السماك عماده % % ولا طنب إلا العلى والمفاخر % % 5(@)(@@) % وألبست سيمى المجد في المهد ناشئا % % وسدت وما شدت عليك المآزر % % 6(@)(@@) % وقد تعلم الغايات من بدآتها % % وتظهر في أولى الأمور الأواخر % % 7(@)(@@) % وعالج داء الدهر منك مجرب % % طبيب بأدواء السياسة ماهر % % 8(@)(@@) % فأنت لحبل الملك لا شك واصل % % وأنت لصدع الدين لا شك جابر % % 9(@)(@@) % تروم الأبيات الصعاب فتنثني % % ليان الهوادي وهي شمس نوافر % % 10(@)(@@) % وتقبس من نور الإلاه هداية % % فتبصر بدءا ما له الأمر صائر % % PageV01P462 11(@)(@@) % وكم فتكة في الروم بكر جلوتها % % منصاتها للمسلمين المنابر % % 12(@)(@@) % تهادى وألفاف البنود خدورها % % وتقدمها عند الزفاف البشائر % % 13(@)(@@) % ولما استجارتك الجزيرة والردى % % محيط وغصت بالقلوب الحناجر % % 14(@)(@@) % وحجبتها بالسيف عن كل ظالم % . . . . % 15(@)(@@) % وكيف له بالقرب منها وإنها % % لتأوي إلى إيمانها وهو كافر % % 16(@)(@@) % وقد كثرت في الروم من فتكاتها % % عداد اليتامى والأيامى الحرائر % % 17(@)(@@) % وطالت لها الرنات في أرض رومة % % كما زحفت عند الغناء المزامر % % 18(@)(@@) % ولله منها في الوجود جزيرة % % شكتها بمنبت الشمال الجزائر % % 19(@)(@@) % وليس عجيبا أن تغص عقيلة % % بأخرى وتشكو بالضرار الضرائر % % 20(@)(@@) % وصابرت شطر الحول إلا أقله % % تراوح أحزاب العدا وتباكر % % PageV01P463 21(@)(@@) % فعز مرام الروم في كل حيلة % % وأصبح في الحصر العدو المحاصر % % 22(@)(@@) % قصرت عليها النفس غير معرج % % على 
ms110	 ذكر من ضمت عليه المقاصر % % 23(@)(@@) % وخاطرت بالنفس النفيسة دونها % % وهل فاز بالأخطار إلا المخاطر % % 24(@)(@@) % وما كان يدري قيمة الدر ربه % % لو التزمت أصدافهن الجواهر % % 25(@)(@@) % عبرتهما بحرين بحرا من العدا % % وبحرا من اللج الذي هو زاخر % % 26(@)(@@) % ولما تبدت للمحاق حجبتها % % تصادم فيهن الجوى وتصادر % % 27(@)(@@) % تلوح إياة البدر والليل حالك % % فتبصرنا نسعى له ونبادر % % 28(@)(@@) % وهيهات أين البدر منك إذا بدا % % وكيف يجوز اللبس والفرق ظاهر % % 29(@)(@@) % ولكنها منا تعله وارد % % بحار الأماني أعوزته المصادر % % 30(@)(@@) % فيا ليلة الاثنين كم لك من يد % % لموقعها الإسلام والله شاكر % % PageV01P464 31(@)(@@) % قدمت كما وافى على الكبرة الصبا % % وجادت على المحل السحاب المواطر % % 32(@)(@@) % وإلا كما لذ الأمان لخائف % % وواصل من بعد القطيعة هاجر % % 33(@)(@@) % وأطلع منك الفلك شمسا منيرة % % لها فلك بالعلم والحلم دائر % % 34(@)(@@) % ورامت بك الأعداء كل بعيدة % % من المكر لم تخطر عليها الخواطر % % 35(@)(@@) % وفيت وخانوا والوفاء غريزة % % وما يستوي في الدهر واف وغادر % % 36(@)(@@) % وما هذه الأبصار تعمى حقيقة % % ولكنها تعمى النهى والبصائر % % 37(@)(@@) % ومن للعدا أن يبلغوا فيك ما % % 38(@)(@@) % لقد لبس الأذفنش منها ملاءة % % من اللؤم تأباها الملوك الأكابر % % 39(@)(@@) % وأسرع ينضو ثوبها متنصلا % % وربك يدري ما تكن الضمائر % % 40(@)(@@) % فقابلت بالصفح الجميل اعتذاره % % وإن عظمت منه إليك الجرائر % % PageV01P465 41(@)(@@) % فإنك أولى من يقود إلى الرضا % % وأحلم من تلقى إليه المعاذر % % 42(@)(@@) % ألا فاشكروا يا أهل أندلس يدا % % ليوسف لا يحصي لها الفخر حاصر % % 43(@)(@@) % ألا فالثموا منه الدروع فإنها % % وسائل للغفران هذي المغافر % % 44(@)(@@) % ألا فاشكروا تلك الكتائب واجعلوا % % محاريب ما تبديه منها الحوافر % % 45(@)(@@) % هنيئا أمير المسلمين بأوبة % % أهل بها لله باد وحاضر % % 46(@)(@@) % يلذ على الأفواه ترداد ذكرها % % كما شار مقطوفا من الشهد شائر % % 47(@)(@@) % ودونكها حسناء أما جمالها % % فبدع وأما الطرف منها فساحر % % 48(@)(@@) % تبين المعالني في سواد مدادها % % كما سترت زهر الوجوه الغدائر % % PageV01P466 البحر : طويل 1(@)(@@) % يمينا بمن حث الركائب في بدر % % ومهبط وحي الله في ليلة القدر % % 2 
ms111	(@)(@@) % لقد مزجت روحي بروحك في الهوى % % كما مزج الماء الزلال مع الخمر % % 3(@)(@@) % فأنت إلى قلبي ألذ من الهوى % % وأشهى إلى نفسي من النهي والأمر % % 4(@)(@@) % وقد شفني وجد إليك ولوعة % % هي الجمر أو أذكى وقودا من الجمر % % 5(@)(@@) % فإن طرقتني من جنابك نسمة % % وضعت لها يمنى يدي على صدري % % 6(@)(@@) % ملكت بني الدنيا ويملكني الهوى % % ألا فاعجبوا بالله يا قوم من أمري % % 7(@)(@@) % حبيب إذا ما حجبته يد النوى % % فطيف له يسري وذكر له يجري % % 8(@)(@@) % بنفسي من أهدي إلي تحية % % كما حملت ريح الصبا نفحة الزهر % % 9(@)(@@) % يمثل منه البدر والنجم والدجى % % مثالا لعيني أو خيالا إلى فكري % % 10(@)(@@) % فإن غاب عني وجهه ودلاله % % أعلل قلبي بالدجنة والبدر % % PageV01P467 11(@)(@@) % وإن غاب قرط عنده ومقلد % % رجعت إلى الجوزاء والأنجم الزهر % % 12(@)(@@) % لحا الله أجفان الغواني فإنها % % تسوق الهوى للقلب من حيث لا يدري % % 13(@)(@@) % لها فتكات في القلوب كأنها % % سيوف الملوك الغالبين بني نصر % % 14(@)(@@) % ليوث الهدى تحمى كل خائف % % غيوث الندى تهمي على كل مضطر % % 15(@)(@@) % أولئك قومي دونوا المجد والعلا % % فكنت كبسم الله في أول السطر % % 16(@)(@@) % تراءت لعزمي همة يوسفية % % بها قصر الله الكمال على قصر % % PageV01P468 البحر : رمل تام 1(@)(@@) % سكن الحب فؤادي وعمر % % ونهى الشوق بقلبي وأمر % % 2(@)(@@) % وغزت قلبي ألحاظ الظبا % % بظباها أين يا قلب المفر % % 3(@)(@@) % بأبي والله لحظ فاتر % % ما جنى في مهجة إلا اعتذر % % 4(@)(@@) % من مجيري من نصيري في الهوى % % ضاع بين الغنج ثأري والحور % % 5(@)(@@) % كنت يا قلبي على طول المدى % % تحذر الحب وهل ينجي الحذر % % 6(@)(@@) % وبنفسي من إذا جن الدجى % % أمسك النوم وأهداني السهر % % 7(@)(@@) % غصن بان وهلال ورشا % % إن تثنى أو تبدى أو خطر % % 8(@)(@@) % لو بدا للحور يوما وجهه % % قلن جل الله ما هذا بشر % % 9(@)(@@) % زار في ليلين ليل للدجى % % حالك الجنح وليل للشعر % % 10(@)(@@) % فضممت الغصن من ثوب النقى % % ولثمت الراح من بين الدرر % % PageV01P469 11(@)(@@) % وجرى دمعي . . . . . . % % 12(@)(@@) % قلت مهلا لا تروع إنما 
ms112	 % % هي من دمعي لآلىء غرر % % 13(@)(@@) % فاعتراه من كلامي خجل % % خلط الورد بسوسان الخفر % % 14(@)(@@) % حبذا ليل نعمناه وقد % % حلت الزهرة في بيت القمر % % 15(@)(@@) % وحمدنا الصبر في الأمر وقد % % حمد العقبى محب قد صبر % % 16(@)(@@) % خضت بحر الحب والدمع وهل % % تدرك الآمال إلا بالغرر % % 17(@)(@@) % فسطا الوصل على الهجر كمن % % ببني نصر على الدهر انتصر % % 18(@)(@@) % أبحر الجود وأملاك الورى % % وسيوف الله تردي من كفر % % 19(@)(@@) % لهم الفخر بحق وكفى % % بأبي الحجاج أسمى مفتخر % % 20(@)(@@) % أي مجد أحكمت آياته % % فهي تتلى مثلما تتلى السور % % PageV01P470 21(@)(@@) % دام في سعد جديد ومنى % % تصل الآصال فيها بالبكر % % 22(@)(@@) % ما ارتدى بالغيث روض فروت % % نسمة الريح عن الزهر خبر % % PageV01P471 البحر : طويل 1(@)(@@) % أما وخيال في المنام يزور % % وإن كان عندي أن ذلك زور % % 2(@)(@@) % لقد ضقت ذرعا بالنوى بعد بعدكم % % على أنني في النائبات صبور % % 3(@)(@@) % أدافع من شوقي ووجدي كتائبا % % يزلزل رضوى عندها وثبير % % 4(@)(@@) % سرايا إذا ما الليل مد رواقه % % على سرحة الصبر الجميل تغير % % 5(@)(@@) % برى جسدي فيكم غرام ولوعة % % إذا سكن الليل البهيم تثور % % 6(@)(@@) % فلولا أنيني ما اهتدى نحو مضجعي % % خيالكم بالليل حين تزور % % 7(@)(@@) % ولو شئت في طي الكتاب لزرتكم % % ولم تدر عني أحرف وسطور % % 8(@)(@@) % تذكرت عهدا طال بعد انصرامه % % عليه الأسى وانجاب وهو قصير % % 9(@)(@@) % وقد طلعت للريح في ظلماته % % نجوم توالي حثهن بدور % % 10(@)(@@) % وهب نسيم الروض في روضة الرضا % % بليلا وأكواس السرور تدور % % PageV01P472 11(@)(@@) % وعهدا بعين الدمع للدمع بعده % % موارد في آماقنا وبحرور % % 12(@)(@@) % عهود مني غص الزمان بحسنها % % فغار عليها والزمان غيور % % 13(@)(@@) % فها أنا أستقري الرياح إذا سرت % % ليخبرني بالظاعنين خبير % % 14(@)(@@) % وإن خط وجدي من دموعي رسالة % % على صفح خدي فالنسيم سفير % % 15(@)(@@) % فيا رحلة الصيف الذي بجوانحي % % لها لهب لا ينقضي وسعير % % 16(@)(@@) % أحول منك الشهر حولا على الورى % % وأصبحت والأيام وهي شهور % % 17(@)(@@) % ويا قلب لا تطرح سلاحك رهبة % % فهل هي إلا أنة وزفير % % 18(@)(@@) % جنيت الهوى لا 
ms113	 عن ملال ولا قلا % % فمثلي بموصول الملام جدير % % 19(@)(@@) % وجردت عني لبسة الوصل طائعا % % وكم شرق بالماء وهو نمير % % 20(@)(@@) % أأحمد إن جل الذي بي من الهوى % % وأصبحت مالي في هواك نصير % % PageV01P473 21(@)(@@) % فلست من اللطف الخفي بيائس % % فكم من بكاء كان عنه سرور % % 22(@)(@@) % أتاني كتاب منك لا بل حديقة % % تفيأتها والهجر منك هجير % % 23(@)(@@) % وأرسلت دمع العين حين قرأتها % % فمنها أمامي روضة وغدير % % 24(@)(@@) % تكلفت فيك الصبر والصبر معوز % % وملت إلى الأطماع وهي غرور % % 25(@)(@@) % ولذت إلى الآمال وهي سفاهة % % وهونت فيك الخطب وهو عسير % % 26(@)(@@) % سألقي إلى أيدي الزمان مقادتي % % فيعدل في أحكامه ويجور % % 27(@)(@@) % وإن الذي بالبعد أجرى قضاءه % % على جمع شملي كيف كان قدير % % 28(@)(@@) % فتدرك آمال وتقضى مآرب % % لدي وتشفى باللقاء صدور % % PageV01P474 البحر : طويل 1(@)(@@) % نبيت على علم يقين من الدهر % % ونعلم أن الخلق في قبضة القهر % % 2(@)(@@) % ونركن للدنيا اغترارا بلهوها % % وحسبك من يرجو الوفاء من الغدر % % 3(@)(@@) % ونمطل بالعزم الزمان سفاهة % % فيوم إلى يوم وشهر إلى شهر % % 4(@)(@@) % ونغري بما يفنى المطامع والهوى % % ونرفض ما يبقى فيا ضيعة العمر % % 5(@)(@@) % وندفع أحبابا كراما إلى الردى % % ونسلو ونلهو بعد ذاك عن الأمر % % 6(@)(@@) % هو الدهر لا يبقى على حدثانه % % جديد ولا ينفك عن حادث نكر % % 7(@)(@@) % وبين الخطوب الطارقات تفاضل % % كفضل من اغتالته في رفعة القدر % % 8(@)(@@) % ألم تر أن المجد أقوت ربوعه % % وصوح من أدواحه كل مخضر % % 9(@)(@@) % ولاحت على وجه العلاء كآبة % % فقطب من بعد الطلاقة والبشر % % 10(@)(@@) % أمولاتنا الكبرى فداؤك أننا % % برئنا إلى الأشجان من شيمة الصبر % % PageV01P475 11(@)(@@) % فقدناك فقد النواظر نورها % % وكنت لنا نورا يضيء لمن يسري % % 12(@)(@@) % عجبت لمغتال الردى كيف لم يرع % % لمنزلك المحفوف بالنهي والأمر % % 13(@)(@@) % وكيف انبرى صرف الحمام مصمما % % خلال الصفاح البيض والأسل السمر % % 14(@)(@@) % ستور من الدين المتين كثيفة % % وكم دونها للملك والعز من ستر % % 15(@)(@@) % نعد الرماح المشرفية والقنى % % ويطرق أمر الله من حيث لا ندري % % 16(@)(@@) % هو الدهر يجري في البرية 
ms114	 حكمه % % فعز الغنى سيان أو ذلة الفقر % % 17(@)(@@) % رمى تبعا بالحتف قصدا فلم يكن % % لأتباعه في ذلك الخطب من نصر % % 18(@)(@@) % وأردى أنوشروان كسرى بصرفه % % كسيرا ولم يترك لقيصر من قصر % % 19(@)(@@) % لقد فجع الإسلام منك وأهله % % بذخر بعيد الصيت مشتهر الذكر % % 20(@)(@@) % وواحدة فاقت نساء زمانها % % كما فضلت أمثالها ليلة القدر % % PageV01P476 21(@)(@@) % وهل خفض التأنيث للشمس رتبة % % وهل رفع التذكير من رتبة البدر % % 22(@)(@@) % أصالة آراء وفضل سياسة % % وفخر انتماء دونه منتهى الفخر % % 23(@)(@@) % وديوان مجد ضمنت صفحاته % % خلال الملوك الغالبين بني نصر % % 24(@)(@@) % بإبقاء معروف ورعي وسيلة % % بإيواء ملهوف بنصرة مضطر % % 25(@)(@@) % أرى سفر الدنيا يرجى إيابه % . . . . . . . . . . . . إلى الحشر % % 26(@)(@@) % أعيدي لقصر الملك منك التفاتة % % ولو بمزار للخيال الذي يسري % % 27(@)(@@) % فكم فيه من قلب لبعدك خافق % % ومن لوعة تذكي ومن عبرة تجري % % 28(@)(@@) % وشمل جميع فرقته يد النوى % % ومرآى بديع غيرته يد الدهر % % 29(@)(@@) % ومنصب ملك أوحشت جنباته % % وهالة إيوان تراءت بلا بدر % % 30(@)(@@) % وما كنت إلا الشمس يحيا بك الورى % % على بعد العلياء أو رفعة القدر % % PageV01P477 31(@)(@@) % وهيهات من للشمس منك بمشبه % % كمال بلا نقص ونفع بلا ضر % % 32(@)(@@) % حملنا على الأعناق منك سحابة % % مباركة السقيا مقدسة القطر % % 33(@)(@@) % ولما أتينا اللحد في غلس الدجى % % رأينا أفول الشمس في مطلع الفجر % % 34(@)(@@) % فلو أن قبرا صار للناس قبلة % % جعلنا مصلانا إلى ذلك القبر % % 35(@)(@@) % ولو وجد الخلق السبيل لتربة % % حوت لحدك المكنوف بالفضل والبر % % 36(@)(@@) % لطافوا بها سبعا ولبوا وأحرموا % % ففازوا لديها بالمثوبة والأجر % % 37(@)(@@) % وذادت عن العلياء عزمة يوسف % % سليل علاك الطاهر الملك البر % % 38(@)(@@) % ولكنه حكم من الله نابع % % يقابل بالتسليم والصبر والشكر % % 39(@)(@@) % ودونك من عبد لملكك نادب % % ثناء كما هب النسيم على الزهر % % 40(@)(@@) % ولو كان في وسعي عناء بلغته % % بما يقتضيه قدرك الضخم لا قدري % % PageV01P478 41(@)(@@) % ووالله ما وفيت حقك واجبا % % ولكنه شيء أقمت به عذري % % PageV01P479 البحر : طويل 1(@)(@@) % يحييك بالريحان والروح من قبر % % رضا الله عمن حل فيك مدى الدهر 
ms115	 % % 2(@)(@@) % إلى أن يقوم الناس تعنو وجوههم % % إلى باعث الأموات في موقف الحشر % % 3(@)(@@) % ولست بقفر إنما أنت روضة % % منعمة الريحان عاطرة النشر % % 4(@)(@@) % ولو أنني أنصفتك الحق لم أقل % % سوى يا كمام الزهر أو صدف الدر % % 5(@)(@@) % ويا ملحد التقوى ويا مدفن الهدى % % ويا مسقط العليا ويا مغرب البدر % % 6(@)(@@) % لقد حط فيك الرحل أي خليفة % % أصيل المعالي غرة في بني نصر % % 7(@)(@@) % لقد حل فيك العز والمجد والعلا % % وبدر الدجى والمستجار من الذعر % % 8(@)(@@) % ومن كأبي الحجاج حامي حمى الهدى % % ومن كأبي الحجاج ماحي دجى الكفر % % 9(@)(@@) % إمام الهدى غيث الندى دافع العدا % % بعيد المدى في حومة المجد والفخر % % 10(@)(@@) % سلالة سعد الخزرج بن عبادة % % وحسبك من بيت رفيع ومن قدر % % PageV01P480 11(@)(@@) % إذا ذكر الإغضاء والحلم والتقى % % وحدثت عن علياه حدث عن البحر % % 12(@)(@@) % تخونه صرف الزمان وهل ترى % % دواما لحال أو بقاء على أمر % % 13(@)(@@) % هو الدهر ذو وجهين يوم وليلة % % ومن كان ذا وجهين يعتب في غدر % % 14(@)(@@) % تولى شهيدا ساجدا في صلاته % % أصيل التقى رطب اللسان من الذكر % % 15(@)(@@) % وقد عرف الشهر المبارك حق ما % % أفاض من النعمى ووفى من البر % % 16(@)(@@) % وباكر عيد الفطر والأمر مبرم % % وليس سوى كأس الشهادة من فطر % % 17(@)(@@) % أتيح له وهو العظيم مهابة % % وقدرا حقير الذات والخلق والقدر % % 18(@)(@@) % شقي أتته من لدنه سعادة % % ومنكر قوم جاء بالحادث النكر % % 19(@)(@@) % وما غض من عال جناية سافل % % وأسباب حكم الله جلت عن الحصر % % 20(@)(@@) % فهذا علي قد قضى بابن ملجم % % وأوقع وحشي بحمزة ذي الفخر % % PageV01P481 21(@)(@@) % نعد السيوف المشرفية والقنا % % ويطرق أمر الله من حيث لا ندري % % 22(@)(@@) % ومن كان بالدنيا الدنية واثقا % % على حالة يوما فقد باء بالخسر % % 23(@)(@@) % فيا ملك الملك الذي ليس ينقضي % % ويا من إليه الحكم في الخلق والأمر % % 24(@)(@@) % تغمد بستر العفو منك ذنوبنا % % فلسنا نرجي غير عفوك من ستر % % 25(@)(@@) % وألحق أمير المسلمين برحمة % % تبوئه دار المقامة والأجر % % 26(@)(@@) % ومن كأبي الحجاج حامي حمى 
ms116	 الهدى % % ومن كأبي الحجاج ماحي دجى الكفر % % 27(@)(@@) % فما عندك اللهم خير ثوابه % % وأبقى ودنيا المرء خدعة مغتر % % 28(@)(@@) % وصل على الهادي المشفع ما بدت % % سماة الصباح الطلق في مطلع الفجر % % PageV01P482 البحر : طويل 1(@)(@@) % بحيث القباب البيض والأسل السمر % % ليوث غيوث كلما أخلف القطر % % 2(@)(@@) % مقاول من أقيال سعد بن خزرج % % أنوفهم شم وأوجههم غر % % 3(@)(@@) % يشب على أبياتهم ضرم القرى % % فيهدي إذا ما ظل في السفر السفر % % 4(@)(@@) % يقولون والآفاق غير مغيمة % % كأن على الأرجاء أردية غبر % % 5(@)(@@) % إذا الوفر لم يدلل على الحمد ربه % % فلا جلت النعمى ولا وفر الوفر % % 6(@)(@@) % وما العمر إلا زينة مستعارة % % ترد ولكن الثناء هو العمر % % 7(@)(@@) % وإن زحفوا من دون راية يوسف % % تقول تعالى من له الخلق والأمر % % 8(@)(@@) % وتبصر سحبا من دروع سوابع % % يطير بها عزم ويقدمها نصر % % 9(@)(@@) % إمام به عز الهدى وتبادرت % % لطاعته الدنيا وذل به الكفر % % 10(@)(@@) % وأصبح ثغر الثغر يبسم ضاحكا % % وقد كان مما نابه ليس يفتر % % PageV01P483 11(@)(@@) % أقام سياج السلم دون ذماره % % فلا ظبة تعرى ولا روعة تعرو % % 12(@)(@@) % تناقلت الركبان طيب حديثه % % فلما رأوه صدق الخبر الخبر % % 13(@)(@@) % مضاء تضيق الأرض عنه برحبها % % وشيمة حلم لا يضيق بها صدر % % 14(@)(@@) % فما عمر إن قيس يوما ببأسه % % وإن وصفوه بالدهاء فما عمر % % 15(@)(@@) % لك الله ما أمضى سيوفك في العدا % % إذا ما أسود الحرب خامرها الذعر % % 16(@)(@@) % ودارت على أبطالها أكؤس الردى % % فمالت كأن القوم أزرى بها السكر % % 17(@)(@@) % وأي فؤاد منهم غير خافق % % إذا خفقت في البحر أعلامك الحمر % % 18(@)(@@) % دعتك قلوب المؤمنين وأخلصت % % وقد طاب منها السر لله والجهر % % 19(@)(@@) % ومدت إلى الله الأكف ضراعة % % فقال لهن الله قد قضي الأمر % % 20(@)(@@) % وألبسها النعمى ببيعتك التي % % بها أمن الإسلام وانسدل الستر % % PageV01P484 21(@)(@@) % وجاءتك كالآرام تختال في الحلى % % جياد المذاكي والمحجلة الغر % % 22(@)(@@) % وراد وشقر واضحات شياتها % % فأجسامها تبر وأرجلها در % % 23(@)(@@) % وشهب إذا ما ضمرت يوم غارة % % مطهمة غارت بها الشهب الزهر % % 24(@)(@@) % طوامح 
ms117	 في أرسانهن فوارة % % يبين على أعطافها الزهو والكبر % % 25(@)(@@) % كأني بهم لما تعاطوا حديثها % % وأعناقهم ميل وأعينهم خزر % % 26(@)(@@) % وجاشوا إلى رأي من الكفر فائل % % وغرهم الشيطان بالله فاغتروا % % 27(@)(@@) % وربك بالنصر المؤزر كافل % % فعادته في قومك العضد والنصر % % 28(@)(@@) % كأنك قد ضمرت كل كتيبة % % غنائمها بيض وآسالها سمر % % 29(@)(@@) % إذا ما انجلى عنها القتام تدافعت % % على الأرض من ماديها لجج خضر % % 30(@)(@@) % عليها من الأبطال كل مجرب % % نقاب تساوى عنده الحلو والمر % % PageV01P485 31(@)(@@) % فدوخت الآفاق حتى أنيسها % % خلاء وحتى ربعها بلقع قفر % % 32(@)(@@) % لقد ضل من يبغي من البحر ضلة % % ولم يدر أن البحر أنملك العشر % % 33(@)(@@) % وعاش لنور النيرين بزعمه % % وما الشمس إلا دون وجهك والبدر % % 34(@)(@@) % تلقيت شهر الصوم بالبر والتقى % % تود بأن لا ينقضي ذلك الشهر % % 35(@)(@@) % وودع يثني بالذي أنت أهله % % وقد حلت الزلفى وقد عظم الأمر % % 36(@)(@@) % ووافاك شهر الصوم يزهى بغرة % % تزف بها البشرى ويبدو بها البشر % % 37(@)(@@) % أتيت مصلاه على قدم الرضا % % وقد عظم التمجيد لله والذكر % % 38(@)(@@) % وقد غص من وسغ السبيكة وسعها % % وجر بها أذياله العسكر المجر % % 39(@)(@@) % وما ريء من مثل له يوم زينة % % كأن نضيد الزهر راق به الزهر % % 40(@)(@@) % ودارت من الأعزاز تحت لوائها % % رماة على أوتارها للعدا وتر % % PageV01P486 41(@)(@@) % إذا اصطنبوا أقواسهم وتمنطقوا % % فتبصر جيش الترك جاشت به مصر % % 42(@)(@@) % فهنيته عيدا سعيدا إذا انقضى % % أتتك ضروب منه ليس لها حصر % % 43(@)(@@) % ولا زلت في ملك منيع مؤيد % % تهش له الدنيا ويعلو له الدهر % % 44(@)(@@) % إذا نحن أثنينا عليك بمدحة % % فهيهات يحصى الرمل أو يحصر القطر % % 45(@)(@@) % ولكننا نأتي بما نسطيعه % % ومن بذل المجهود حق له العذر % % PageV01P487 البحر : طويل 1(@)(@@) % محلك بالدنيا وبالدين معمور % % فشانيك مخذول وراجيك منصور % % 2(@)(@@) % إليك تناهى حمد كل فضيلة % % فها هو ممدود عليك ومقصور % % 3(@)(@@) % كأن محاميد الزمان دفاتر % % وحمدك تصحيح عليه وتطرير % % 4(@)(@@) % تحوط أمور الملك منك سياسة % % حباها من اللطف الإلهي تدبير % % 5(@)(@@) % بمائس غصن العطف غض شبابه % % أثير 
ms118	 له في عالم الكون تأثير % % 6(@)(@@) % يفوه بفضل الحكم غرب لسانه % % فيفصح في تبيانه وهو مبتور % % 7(@)(@@) % عميم الندى حتى بماء شبابه % % كريم بأفواه المواهب مشكور % % 8(@)(@@) % يفوه إذا يروي ويصمت في الظما % % وفي حالتيه مستغاث ومحذور % % 9(@)(@@) % تغادر أبطال الكتائب كتبه % % وأعناقها ميل وأعينها صور % % 10(@)(@@) % ويرغب في نعماه كل مؤمل % % ويرهب بوساه أمير ومأمور % % PageV01P488 11(@)(@@) % ومن عجب أن يستنال نواله % % فيعذب شهدا وهو في الشكل زنبور % % 12(@)(@@) % كأن لسان الدهر نفث يراعه % % يترجم عما أضمرته المقادير % % 13(@)(@@) % إذا اهتز في روض المهارق غصنه % % تساقط منظوم البيان ومنثور % % 14(@)(@@) % تخال صباح الطرس يرقم بالدجى % % ويرقش بالمسك المفتق كافور % % PageV01P489 البحر : متقارب تام 1(@)(@@) % وقالوا الجزيرة قد صوحت % % فقلت غمام الندى تنتظر % % 2(@)(@@) % إذا وكفت كف موسى بها % % غماما يعود الجناب الخضر % % PageV01P490 البحر : كامل تام 1(@)(@@) % عقب الشعير لقد هوت بك عيري % % كالمجرمين هووا لقعر سعير % % 2(@)(@@) % بينا نرى من فوق ظهر مجدب % % صارت من الأشكال في تقعير % % 3(@)(@@) % من كل راحية كغارب ناقة % % أو كل عرجاء كعنق بعير % % 4(@)(@@) % ما الشين في اسمك غير نقطة ألثغ % % بدل السعير أتى بلفظ شعير % % PageV01P491 البحر : وافر تام 1(@)(@@) % وهت مني القوى بطريق شاط % % ودار على تألمي الإزار % % 2(@)(@@) % فلا سن الإله مزار شاط % % إذا ما شاط شط بها المزار % % PageV01P492 البحر : طويل 1(@)(@@) % بغيضة وحش الليل خوف ووحشة % % كأن فؤادي وحشة قد أعارها % % 2(@)(@@) % ولكن هذي أقفرت من أنيسها % % وغيضة قلبي يسكن الهم دارها % % PageV01P493 البحر : كامل تام 1(@)(@@) % انظر إليه والأصيل مورس % % والشمس ترسل من عنان مسيرها % % 2(@)(@@) % فكأنما هو زئبق مترجرج % % ألقت عليه الشمس من إكسيرها % % PageV01P494 البحر : كامل تام 1(@)(@@) % حقر لها ما في يديها بدأة % % واضمن لها عوضا وإن لم يحضر % % 2(@)(@@) % واربأ بنفسك عن تسامح بائع % % واغنم إذا سامتك شهوة مشتر % % PageV01P495 البحر : بسيط تام 1(@)(@@) % لا تقربن بما ينعى عليك غدا % % وتستخف بحمل لست تقدره % % 2(@)(@@) % فشاهد الزور يقضي حق صاحبه % % وبعد هذا بتلك العين ينظره % % PageV01P496 البحر : طويل 1(@)(@@) % قعدت لتذكير 
ms119	 ولو كنت منصفا % % لذكرت نفسي فهي أحوج للذكرا % % 2(@)(@@) % إذا لم يكن مني لنفسي واعظ % % فيا ليت شعري كيف تفعل في أخرا % % PageV01P497 البحر : طويل 1(@)(@@) % ولما حثثت السير والله حاكم % % لملكك في الدنيا بعز وفي الأخرا % % PageV01P498 البحر : طويل 1(@)(@@) % أنا ملعب الوصل الذي يشرح الصدرا % % وبرج سماء يجمع الشمس والبدرا % % 2(@)(@@) % حفيظ على الأسرار حتى كأنني % % دعيت سريرا أنني أحفظ السرا % % 3(@)(@@) % إذا ما أجلت العين بين بدائعي % % وشاهدت حسنا يذهل العقل والفكرا % % 4(@)(@@) % وقد مد ستر التبر فوقي وأرسلت % % يد اليمن والتوفيق من تحته سترا % % 5(@)(@@) % رأيت جوادا لا يخاف عثاره % % ومركب سعد لا يجوع ولا يعرا % % 6(@)(@@) % كأني رياض زارها واكف الحيا % % فألبسها وشيا وطيبها نشرا % % 7(@)(@@) % وثامن أملاك الجهاد أقامني % % فألبسني عزا ورفع لي قدرا % % 8(@)(@@) % ويستعبد الأحرار جود يمينه % % وتخجل وجه الشمس غرته الغرا % % 9(@)(@@) % ولا زال نصري العلى رائق الحلى % % يصاحب جيش النصر رايته الحمرا % % 10(@)(@@) % ولا زلت أفقا للقباب ومطلعا % % يريك البدور الغر والأنجم الزهرا % % PageV01P499 11(@)(@@) % إذا ما دنا الإمساء حييت بالمنى % % ومهما أتى الإصباح حييت بالبشرا % % PageV01P500 البحر : طويل 1(@)(@@) % يحق لي المجد المؤثل والفخر % % ويعرف فضلا حزته البر والبحر % % 2(@)(@@) % أنا المطلع الميمون والفلك الذي % % به تلتقي الشمس المنيرة والبدر % % 3(@)(@@) % مطية توفيق من السعد جلها % % وحليتها الدر المرصع والتبر % % 4(@)(@@) % مقيم وفي ذات القوائم نسبتي % % ولو كنت أنوي السير ما كان لي عذر % % 5(@)(@@) % أأبرح من مثوى السعادة والرضا % % وحليتي العليا ومسكني القصر % % 6(@)(@@) % تقر بمرآيا العيون إذا بدت % % عجائب أشكالي وينشرح الصدر % % 7(@)(@@) % لبست من التبر المثمن حلة % % وقمت مقاما دونه الأنجم الزهر % % 8(@)(@@) % يقصر عن أمداحه كل مادح % % وهيهات يحصى الرمل أو يحصر القطر % % PageV01P501 البحر : مخلع البسيط 1(@)(@@) % لو كان لي في الهوى اختيار % % ما شط بي عنكم المزار % % 2(@)(@@) % رحلت عنكم ولي فؤاد % % له بأحوازكم قرار % % 3(@)(@@) % ما حسنت بعدكم وجوه % % عندي ولا أعجبت ديار % % 4(@)(@@) % وقادني نحوكم غرام % % يهيج أشواقه ادكار % % 5(@)(@@) % فليس لي عنكم براح % % ما اختلف 
ms120	 الليل والنهار % % 6(@)(@@) % ولما شجاه البعد عنك وشفه % % تبدى نحول الشوق فوق هلاله % % 7(@)(@@) % ولولا اختصاص الشرع يوما بعينه % % وأنك توفي الأمر حق امتثاله % % 8(@)(@@) % لما امتاز يوم العيد من يوم غيره % % فدهرك عيد كله في احتفاله % % 9(@)(@@) % ودونكها كالروض عاهده الحيا % % وجر عليه الفضل ذيل اعتداله % % 10(@)(@@) % إذا لم يكن في السيف من طيب طبعه % % له صيقل لم ينتفع بصقاله % % PageV01P502 البحر : - 1(@)(@@) % السعد جندك والقضاء دليل % % والله بالنصر العزيز كفيل % % 2(@)(@@) % فإذا هممت بلغت كل ممنع % % وإذا رأيت الرأي ليس يفيل % % 3(@)(@@) % شهدت لك العلياء أنك ربها % % والدين أنك سيفه المسلول % % 4(@)(@@) % والجود أنك غيثه الهامي الحيا % % هذ وكل شاهد مقبول % % 5(@)(@@) % والحق يغني عن شهادة شاهد % % أنى يرام على الصباح دليل % % PageV01P503 البحر : منسرح 1(@)(@@) % هلم إليها إنها دار % % سكانها للعريب أنصار % % PageV01P504 البحر : طويل 1(@)(@@) % إذا نمت نم للأمن فوق سرير % % وإن قمت قم في غبطة وسرور % % 2(@)(@@) % ودونك فاستغرب على الماء موقفي % % كما وقف ابن الماء وسط غدير % % 3(@)(@@) % على نصبة الأفراح أحكم بنيتي % % حكيم بما يأتيه جد بصير % % 4(@)(@@) % فإن كنت عن كأس وراح وشادن % % سؤولا فلا . . . مثل خبير % % PageV01P505 البحر : كامل تام 1(@)(@@) % كفلت عنايتك الجميلة % % لي بإحراز الوطر % % 2(@)(@@) % ولقيت من بر وخير % % ملء سمعي والبصر % % 3(@)(@@) % شكرا لأنعمك التي % % يزداد منها من شكر % % 4(@)(@@) % لما تعذر أن أشاهد % % ذلك الوجه الأغر % % 5(@)(@@) % وجهتها لتنوب فيه % % وفي هنائك بالمطر % % 6(@)(@@) % وأقبل الكف الكريمة % % فهو أولى منتظر % % PageV01P506 البحر : كامل تام 1(@)(@@) % يا فارس الأجواد بين سفينة % % غزوية تشجي العدو ومنبرا % % 2(@)(@@) % ولقد نمتك إلى الخطابة نسبة % % فإذا تنوسيت إلاكم فاذكرا % % PageV01P507 البحر : كامل تام 1(@)(@@) % جاءتك تعرف بالشميم سراها % % كرمت عناصرها وطاب ثراها % % 2(@)(@@) % لما بعثت بها تورد خدها % % واحمر من خجل لديك عراها % % 3(@)(@@) % فاحنو عليها عودة لجمالها % % واجعل لقاءك بالقبول قراها % % PageV01P508 البحر : كامل تام 1(@)(@@) % عندي لموعدك افتقار محوج % % ووعودك افتقرت إلى إنجازها % % 2(@)(@@) % والله يعلم فيك صدق مودتي % % وحقيقة الأشياء غير مجازها % % PageV01P509 البحر : طويل 1 