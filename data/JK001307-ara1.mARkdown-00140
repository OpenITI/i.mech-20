ms121	 سعيد بن دينار عن الربيع بن صبيح(@)(@@) مجهول والخبر منكر هو دمشقي(@)(@@)(@@)(@@) $ 2378 سعيد بن ذي لعوة الذي(@)(@@) روى عنه الشعبي ضعفه جماعة قال ابن حبان دجال يزعم انه رأى عمر بن الخطاب يشرب المسكر له حديث(@)(@@)(@@)(@@) $ 2379 سعيد بن راشد المازني السماك عن عطاء(@)(@@) قال النسائي متروك(@)(@@)(@@)(@@) $ 2380 سعيد بن أبي راشد(@)(@@) عن عطاء لعله السماك وعنه مروان ابن معاوية لا يعرف هو الذي قبله قطعا(@)(@@)(@@)(@@) $ 2381 سعيد بن رحمة بن نعيم المصيصي عن ابن المبارك(@)(@@) قال ابن حبان لا يجوز أن يحتج به(@)(@@)(@@)(@@) $ 2382 سعيد بن أبي رزين عن أخيه عن ليث بن أبي سليم(@)(@@) لا يعرف PageV01P258(@)(@@)(@@)(@@) $ 2383 سعيد بن أبي رعدة عن ابن سيرين وقتادة مجهول(@)(@@)(@@)(@@) $ 2384 سعيد بن رفاعة مجهول(@)(@@)(@@)(@@) $ 2385 سعيد بن رواحة بصري(@)(@@) لا يعرف(@)(@@)(@@)(@@) $ 2386 خت سي د(@)(@@) سعيد بن زياد عن جابر(@)(@@) قال أبو حاتم الرازي ضعيف(@)(@@)(@@)(@@) $ 2387 سعيد بن زياد بن فايد الداري عن أبيه(@)(@@) لا يكاد يعرف وخبره منكر في أكل الزبيب رواه عنه ابن قتيبة العسقلاني(@)(@@)(@@)(@@) $ 2388 د س(@)(@@) سعيد بن زياد عن زياد بن صبيح في التصليب(@)(@@) ضعفه الدارقطني قال ابن معين صالح له عندهما حديث(@)(@@)(@@)(@@) $ 2389 ت(@)(@@) سعيد بن زربي عن ابن سيرين(@)(@@) قال النسائي ليس بثقة وضعفه الدارقطني وأبو داود(@)(@@)(@@)(@@) $ 2390 ت ق(@)(@@) سعيد بن زكريا المدائني عن زمعة بن صالح(@)(@@) صدوق لينه بعضهم وتركه أحمد(@)(@@)(@@)(@@) $ 2391 سعيد بن زكريا أخو اسماعيل و(@)(@@)(@@)(@@) $ 2392 ت(@)(@@) سعيد بن زرعة عن ثوبان(@)(@@) مجهولان وذكر ابن حبان هذا في الثقات(@)(@@)(@@)(@@) $ 2393 سعيد بن زون الثعلبي البصري عن أنس ضعفوه PageV01P259(@)(@@)(@@)(@@) $ 2394 م عه خت(@)(@@) سعيد بن زيد أخو حماد بن زيد(@)(@@) وثقه ابن معين وضعفه القطان والدارقطني وغيرهما(@)(@@)(@@)(@@) $ 2395 د س(@)(@@) سعيد بن سالم القداح عن ابن جريج(@)(@@) صدوق قال عثمان الدارمي ليس بذاك(@)(@@)(@@)(@@) $ 2396 سعيد بن أبي سعيد الزبيدي(@)(@@) عن هشام بن عروة وعنه بقية لا يعرف(@)(@@)(@@)(@@) $ 2397 سعيد بن أبي سعيد العيار الصوفي(@)(@@) تكلم في بعض سماعه(@)(@@)(@@)(@@) $ 2398 
ms122	 ت(@)(@@) سعيد بن سفيان عن شعبة(@)(@@) قال ابن المديني ذهب حديثه وقواه الترمذي(@)(@@)(@@)(@@) $ 2399 سعيد بن سفيان أندلسي رحل ولقي الدبري(@)(@@) قال ابن الفرضي خلط في آخر عمره فوضع ذلك منه(@)(@@)(@@)(@@) $ 2400 سعيد بن سلام العطار عن ثور قال أحمد كذاب وقال غيره متروك(@)(@@)(@@)(@@) $ 2401 خت م س(@)(@@) سعيد بن سلمة بن أبي الحسام(@)(@@) اعتمده مسلم قال س في سننه ضعيف PageV01P260(@)(@@)(@@)(@@) $ 2402 ع(@)(@@) سعيد بن سليمان سعدوية(@)(@@) ثقة مشهور وقال الدارقطني تكلموا فيه وعن أحمد كان صاحب تصحيف ما شئت(@)(@@)(@@)(@@) $ 2403 سعيد بن سلمة المصري عن أبيه(@)(@@)(@@)(@@) $ 2404 وسعيد بن سليمان بن قهد(@)(@@) مجهولان(@)(@@)(@@)(@@) $ 2405 سعيد بن سليمان الدمشقي عن يحيى الذماري(@)(@@) مجهول قلت بل هو مشهور(@)(@@)(@@)(@@) $ 2406 سعيد بن سليمان النشيطي ابن بنت نشيط(@)(@@) عن حماد بن سلمة فيه لين وقال أبو زرعة ليس بالقوي وقال د لا أحدث عنه(@)(@@)(@@)(@@) $ 2407 سعيد بن سليم الضبي عن أنس ضعفوه(@)(@@)(@@)(@@) $ 2408 سعيد بن سماك بن حرب عن أبيه(@)(@@) قال أبو حاتم الرازي متروك(@)(@@)(@@)(@@) $ 2409 د س ت(@)(@@) سعيد بن سمعان(@)(@@) عن أبي هريرة فيه جهالة ضعفه الأزدي ووثقه النسائي(@)(@@)(@@)(@@) $ 2410 م د ت ق سي(@)(@@) سعيد بن سنان أبو سنان البرجمي عن الشعبي(@)(@@) وثقه ابن معين وقال أحمد ليس بالقوي(@)(@@)(@@)(@@) $ 2411 ق سعيد بن سنان أبو مهدي الحمصي عن أبي الزاهرية متروك متهم(@)(@@)(@@)(@@) $ 2412 سعيد بن سيرين بيض له ابن أبي حاتم مجهول PageV01P261(@)(@@)(@@)(@@) $ 2413 سعيد بن شرحبيل عن زيد بن أبي أوفى(@)(@@)(@@)(@@) $ 2414 وسعيد بن صخر الدارمي عن حماد بن سلمة وهو والد أحمد و(@)(@@)(@@)(@@) $ 2415 ت ق عس(@)(@@) سعيد بن عبد الله الجهني عن محمدبن عمر بن علي(@)(@@)(@@)(@@) $ 2416 وسعيد بن عبدالله عن الحسن(@)(@@)(@@)(@@) $ 2417 وسعيد بن عبد الله الدمشقي عن الربيع بن صبيح وعنه طائفة(@)(@@)(@@)(@@) $ 2418 وسعيد بن عبد الله عن فلان عن علي مجهولون(@)(@@)(@@)(@@) $ 2419 سعيد بن عبد الله بن ضرار عن انس(@)(@@) قال أبو حاتم الرازي ليس بقوي(@)(@@)(@@)(@@) $ 2420 سعيد بن عبد الجبار الحمصي عن روح بن 
ms123	 جناح(@)(@@) قال النسائي ليس بثقة(@)(@@)(@@)(@@) $ 2421 سعيد بن عبد الجبار بن وائل عن أبيه(@)(@@) قال النسائي ليس بالقوي أما(@)(@@)(@@)(@@) $ 2422 سعيد بن عبد الجبار البصري شيخ لعبد الله بن أحمد فصدوق(@)(@@)(@@)(@@) $ 2423 عخ م د س ق(@)(@@) سعيد بن عبد الرحمن الجمحي القاضي عن PageV01P262 سهيل ثقة لينه الفسوي قال ابن حبان روى عن عبيد الله ابن عمر وغيره اشياء موضوعة يتخايل من سمعها انه المتعمد لها وقال أبو حاتم لا يحتج به(@)(@@)(@@)(@@) $ 2424 سعيد بن عبد الرحمن اخو أبي حرة الرقاشي وثقه جماعة ولينه القطان(@)(@@)(@@)(@@) $ 2425 س(@)(@@) سعيد بن عبد الرحمن أبو شيبة الزبيدي(@)(@@) عن سعيد ابن جبير وثقة أبو داود وقال أبو أحمد عبد الله بن عدي لا يتابع على حديثه(@)(@@)(@@)(@@) $ 2426 م عه بخ(@)(@@) سعيد بن عبد العزيز في الزهري ليس بذاك(@)(@@) وقد اشار حمزة الكناني إلى انه تغير بآخرة(@)(@@)(@@)(@@) $ 2427 سعيد بن عبد الكريم روى عنه أبو بكر بن عياش(@)(@@) قال الازدي متروك(@)(@@)(@@)(@@) $ 2428 سعيد بن عبد الملك بن واقد الحراني عن أبي المليح(@)(@@) قال أبو حاتم يتكلمون فيه(@)(@@)(@@)(@@) $ 2429 خ ت س ق(@)(@@) سعيد بن عبيد الله بن جبير بن حية الثقفي(@)(@@) قال الدارقطني ليس بالقوي(@)(@@)(@@)(@@) $ 2430 سعيد بن عبيد الله بن الوليد الوصافي(@)(@@) ضعفة أبو حاتم PageV01P263(@)(@@)(@@)(@@) $ 2431 سعيد بن عبيد بن كثير(@)(@@) مجهول قلت هو شيخ لأبي النضر(@)(@@)(@@)(@@) $ 2432 سعيد بن عثمان الكريزي عن غندر(@)(@@) حدث بأصبهان بمناكير(@)(@@)(@@)(@@) $ 2433 سعيد بن أبي عروبة ثقة(@)(@@) إمام تغير حفظه بأخره ويتهم بالقدر قال أبو حاتم هو قبل أن يختلط ثقة ووثقه ابن معين وأحمد(@)(@@)(@@)(@@) $ 2434 سعيد بن عقبة عن الأعمش(@)(@@) قال ابن عدي مجهول غير ثقة(@)(@@)(@@)(@@) $ 2435 ت(@)(@@) سعيد بن عمارة عن الحارث بن النعمان(@)(@@) قال الأزدي متروك(@)(@@)(@@)(@@) $ 2436 سعيد بن عمرو عن أنس(@)(@@)(@@)(@@) $ 2437 وسعيد بن أبي عمرة عن سلمان(@)(@@) مجهولان(@)(@@)(@@)(@@) $ 2438 سعيد بن عنبسة الرازي عن عباد بن العوام(@)(@@) كذبه ابن معين وغيره(@)(@@)(@@)(@@) $ 2439 سعيد بن عنبسة شيخ لأبي العريان مجهول(@)(@@)(@@)(@@) $ 2440 سعيد بن عيسى 
ms124	 عن معتمر بن سليمان(@)(@@) قال الدارقطني ضعيف PageV01P264(@)(@@)(@@)(@@) $ 2441 سعيد بن غنيم أبو شيبة الكلاعي(@)(@@) تفرد عنه إسماعيل ابن عياش لا يعرف(@)(@@)(@@)(@@) $ 2442 سعيد بن الفضل عن عاصم الأحول(@)(@@) قال أبو حاتم منكر الحديث وقواه غيره(@)(@@)(@@)(@@) $ 2443 سعيد بن قطن عن أنس مجهول قلت بل معروف(@)(@@)(@@)(@@) $ 2444 خ م قد س(@)(@@) سعيد بن كثير بن عفير(@)(@@) ثقة مشهور قال أبو إسحاق الجوزجاني كان مخلطا غير ثقة فيه غير لون من البدع وقال ابن يونس أنكر عليه أحاديث(@)(@@)(@@)(@@) $ 2445 سعيد بن كرز عن أبيه وعنه يحيى بن كثير العنبري مجهول(@)(@@)(@@)(@@) $ 2446 سعيد بن لقمان عن بعض التابعين(@)(@@) قال الأزدي لا يحتج بحديثه(@)(@@)(@@)(@@) $ 2447 سعيد بن محمد المدني عن ابن المنكدر(@)(@@) قال ابن حبان لا يجوز أن يحتج به ووهاه أبو حاتم(@)(@@)(@@)(@@) $ 2448 ت ق(@)(@@) سعيد بن محمد الوراق الكوفي(@)(@@) عن يحيى بن سعيد الأنصاري ضعفوه بمرة(@)(@@)(@@)(@@) $ 2449 خ م د ق(@)(@@) سعيد بن محمد الجرمي(@)(@@) عن حاتم بن إسماعيل ثقة إلا أنه شيعي وثقه أبو داود وخلق(@)(@@)(@@)(@@) $ 2450 سعيد بن محمد الحجواني الكوفي(@)(@@) عن وكيع ضعفه الدارقطني(@)(@@)(@@)(@@) $ 2451 سعيد بن محمد الذهلي الأحول الكديمي(@)(@@) منكر الحديث PageV01P265(@)(@@)(@@)(@@) $ 2452 سعيد بن محمود الطوسي شيخ لمكي بن عبدان(@)(@@) قال أبو أحمد الحاكم منكر الحديث(@)(@@)(@@)(@@) $ 2453 بخ ت ق(@)(@@) سعيد بن المرزبان أبو سعد البقال(@)(@@) مشهور ليس بالحجة قال ابن معين لا يكتب حديثه وقال أبو زرعة صدوق مدلس وقال الفلاس متروك(@)(@@)(@@)(@@) $ 2454 ت ق(@)(@@) سعيد بن مسلمة بن هشام بن عبد الملك عن الأعمش ضعفوه(@)(@@)(@@)(@@) $ 2455 سعيد بن معن عن مالك متهم(@)(@@)(@@)(@@) $ 2456 بخ سعيد بن المهلب عن سعيد بن جبير(@)(@@) لا يعرف ذكره ابن حبان في الثقات(@)(@@)(@@)(@@) $ 2457 سعيد بن موسى عن مالك(@)(@@) اتهمه ابن حبان بوضع الحديث وله عن رباح بن زيد موضوعات(@)(@@)(@@)(@@) $ 2458 سعيد بن ميسرة عن أنس(@)(@@) واه قال ابن عدي هو مظلم الأمر(@)(@@)(@@)(@@) $ 2459 سعيد بن نشيط(@)(@@) روى عنه ابن لهيعة مجهول وقال البستي لا يصح(@)(@@)(@@)(@@) $ 2460 سعيد بن أبي 
ms125	 نصر السكوني عن ابن أبي ليلي القاضي(@)(@@) تركه أبو زرعة مجهول(@)(@@)(@@)(@@) $ 2461 سعيد بن نمران عن أبي بكر الصديق(@)(@@) لا يعرف(@)(@@)(@@)(@@) $ 2462 سعيد بن هاشم الفيومي عن مالك(@)(@@) قال الدارقطني ضعيف(@)(@@)(@@)(@@) $ 2463 سعيد بن هاشم المخزومي عن نافع القارىء(@)(@@) منكر الحديث ولا يعرف PageV01P266(@)(@@)(@@)(@@) $ 2464 سعيد بن هبيرة المروزي عن حماد بن سلمة(@)(@@) اتهمه ابن حبان وابن عدي(@)(@@)(@@)(@@) $ 2465 سعيد بن هناد البوشنجي مجهول(@)(@@)(@@)(@@) $ 2466 سعيد بن هند الخزاز(@)(@@) قال النسائي ليس بثقة وقال الدارقطني ليس بقوي ~(@)(@@)(@@)(@@) $ 2467 سعيد بن واصل عن شعبة(@)(@@) قال النسائي متروك(@)(@@)(@@)(@@) $ 2468 خ س ق(@)(@@) سعيد بن يحيى سعدان اللخمي عن الأعمش(@)(@@) صويلح قال الدارقطني ليس بذاك(@)(@@)(@@)(@@) $ 2469 سعيد بن يحيى أبو سفيان الحميري(@)(@@) في الكني متوسط(@)(@@)(@@)(@@) $ 2470 سعيد بن يزيد بن الصلت عن ابن جريج(@)(@@) لا يعرف وحديثه غريب منكر(@)(@@)(@@)(@@) $ 2471 سعيد بن يوسف شيخ لاسماعيل بن عياش(@)(@@) قال النسائي ليس بالقوي(@)(@@)(@@)(@@) $ 2472 سعيد بن يوسف الهجري مجهول(@)(@@)(@@)(@@) $ 2473 سعيد التمار عن أنس(@)(@@) قال البخاري فيه نظر(@)(@@)(@@)(@@) $ 2474 سعيد الرعيني عن الأحنف(@)(@@)(@@)(@@) $ 2475 وسعيد الحرشي عن إسماعيل بن عبد الله(@)(@@)(@@)(@@) $ 2476 وسعيد عن أبي الأسود و(@)(@@)(@@)(@@) $ 2477 د(@)(@@) سعيد مولى نمران مجاهيل PageV01P267(@)(@@)(@@)(@@) $ 2478 م ت س(@)(@@) سعير بن الخمس عن حبيب بن أبي ثابت(@)(@@) ثقة قال أبو حاتم لا يحتج به(@)(@@)(@@)(@@) $ 2479 ق(@)(@@) السفر بن نسير الحمصي عن بعض التابعين(@)(@@) قال الدارقطني لا يعتبر به(@)(@@)(@@)(@@) $ 2480 م تبعا خت عه(@)(@@) سفيان بن حسين الواسطي(@)(@@) صدوق مشهور قال ابن معين لم يكن بالقوي وقال بعضهم ليس به بأس وقال أبو حاتم ليس به بأس إلا في الزهري(@)(@@)(@@)(@@) $ 2481 سفيان بن زياد عن حجاج بن نصير(@)(@@) ضعفه الدارقطني(@)(@@)(@@)(@@) $ 2482 سفيان بن أبي السراج عن مغيرة بن سويد مجهولان(@)(@@)(@@)(@@) $ 2483 عه(@)(@@) سفيان بن عقبة أخو قبيصة(@)(@@) صدوق له أحاديث تستنكر قاله ابن معين وغيره(@)(@@)(@@)(@@) $ 2484 د ق(@)(@@) سفيان بن أبي العوجاء عن أبي شريح الخزاعي(@)(@@) قال البخاري في حديثه نظر(@)(@@)(@@)(@@) $ 2485 ع(@)(@@) سفيان بن عيينة(@)(@@) روى محمد بن 
ms126	 عبد الله بن عمار عن يحيى القطان قال أشهد أن سفيان اختلط سنة سبع وتسعين ومائة فمن سمع منه فيها فسماعه لا شيءقلت سمع منه فيها محمد بن عاصم PageV01P268 الثقفي فأما سنة ثمان وتسعين فلم يلقه أحد فيها لأنه فيها توفي قبل مجيء الحاج بأربعة أشهر وأنا أستبعد هذا الكلام من القطان فانه مات في صفر سنة ثمان وقت مجيء الحاج وأخبارهم فمتى شهد على سفيان بأنه اختلط أولعله علم ذلك في وسط السنة مع أن القطان متعنت جدا وأبن عيينة ثقة مطلقا(@)(@@)(@@)(@@) $ 2486 سفيان بن الليل(@)(@@) قال العقيلي كان يترفض لا يصح حديثه تابعي(@)(@@)(@@)(@@) $ 2487 سفيان بن محمد الفزاري المصيصي عن ابن وهب(@)(@@) قال ابن عدي كان يسرق الحديث(@)(@@)(@@)(@@) $ 2488 م(@)(@@) سفيان بن موسى عن أيوب وغيره(@)(@@) مجهول قلت بل مشهور ثقة(@)(@@)(@@)(@@) $ 2489 ت ق(@)(@@) سفيان بن وكيع بن الجراح(@)(@@) ضعف وقال أبو زرعة كان يتهم بالكذب(@)(@@)(@@)(@@) $ 2490 سقر بن عبد الرحمن عن شريك القاضي(@)(@@) قال مطين كذاب(@)(@@)(@@)(@@) $ 2491 سكين بن أبي سراج عن عبد الله بن دينار(@)(@@) اتهمه ابن حبان وقد روى عنه كذاب(@)(@@)(@@)(@@) $ 2492 سكين بن عبد العزيز العبدي روى عنه عارم(@)(@@) قال النسائي ليس بالقوي PageV01P269(@)(@@)(@@)(@@) $ 2493 سلام بن أبي خبزة العطار عن ثابت(@)(@@) واه وهو والد سعيد(@)(@@)(@@)(@@) $ 2494 سلام بن رزين قاضي أنطاكيه عن الأعمش(@)(@@) لا يعرف وحديثه كذب(@)(@@)(@@)(@@) $ 2495 سلام بن سعيد العطار هو ابن أبي خبزة(@)(@@) ساقط متروك(@)(@@)(@@)(@@) $ 2496 ق(@)(@@) سلام بن سلم وقيل ابن سليم المدائني السعدي الخراساني الأصل الطويل عن زيد العمي وحميد الطويل ومنصور ابن زاذان(@)(@@) متروك وقال أبو زرعة ضعيف(@)(@@)(@@)(@@) $ 2497 ت س(@)(@@) سلام بن سليمان أبو المنذر المزني البصري المقرئ(@)(@@) شيخ يعقوب سمع من ثابت وطبقته قال ابن معين لا بأس به وبعضهم لم يحتج به وقال أبو حاتم صدوق(@)(@@)(@@)(@@) $ 2498 سلام بن سليمان المدائني(@)(@@) عن شعبة وعنه محمد بن زيدان الكوفي هو ابن أخي شبابة(@)(@@)(@@)(@@) $ 2499 سلام بن سليمان بن سوار المدائني أبو العباس الثقفي ابن اخي شبابة 
ms127	 نزل دمشق وحدث عن ابن أبي ذئب قال ابن عدي عامة ما يرويه لا يتابع عليه PageV01P270(@)(@@)(@@)(@@) $ 2500 سلام بن سليم أبو الأحوص(@)(@@) ثقة حجة وقد انفرد عن سماك عن القاسم بن عبد الرحمن عن أبيه عن أبي بردة عن النبي صلى الله عليه وسلم اشربوا ولا تسكروا قال س هذا حديث منكر وقال أحمد كان أبو الأحوص يخطئ في هذا الحديث قال س وأما أبو عوانة عن سماك فقال عن قرصافه عن عائشه قولها وقرصافه مجهولة(@)(@@)(@@)(@@) $ 2501 سلام بن أبي الصهباء عن قتادة(@)(@@) قال أحمد حسن الحديث وقال البخاري منكر الحديث(@)(@@)(@@)(@@) $ 2502 سلام بن سوار(@)(@@) يروي عنه هشام بن عمار لا يعرف والخبر منكر(@)(@@)(@@)(@@) $ 2503 سلام بن عبد الله أبو حفص عن أبي العلاء(@)(@@) قال أبو حاتم ذاهب الحديث(@)(@@)(@@)(@@) $ 2504 ت(@)(@@) سلام بن أبي عمرة الخراساني عن عكرمه(@)(@@) قال ابن معين ليس بشيء(@)(@@)(@@)(@@) $ 2505 سلام بن قيس(@)(@@) عن الحسن وعنه عمرو بن ربيعه لا يدري من هما(@)(@@)(@@)(@@) $ 2506 خ م ل ت س ق(@)(@@) سلام بن أبي مطيع عن قتاده PageV01P271 قال أحمد ثقة وقال أبن حبان لا يجوز ان يحتج بما انفرد به وقال ابن عدي لا بأس به وليس بمستقيم الحديث في قتادة خاصة وله غرائب ويعد من خطباء أهل البصرة وقال الحاكم هو منسوب إلى الغفلة وإلى سوء الحفظ(@)(@@)(@@)(@@) $ 2507 سلام بن مسكين(@)(@@) ثقة شهير(@)(@@)(@@)(@@) $ 2508 سلام بن واقد(@)(@@) ثقه المروزي لا شيء(@)(@@)(@@)(@@) $ 2509 سلام بن وهب(@)(@@) عن ابن طاووس بخبر موضوع لا يعرف(@)(@@)(@@)(@@) $ 2510 سلام بن يزيد القاري كذا سماه داود بن المحبر(@)(@@)(@@)(@@) $ 2511 سلام وقيل أبو سلام(@)(@@) عن حماد بن أبي سليمان قال أبو حاتم متروك(@)(@@)(@@)(@@) $ 2512 ت س ق(@)(@@) سلامه بن روح الأيلي(@)(@@) عن عقيل قال أبو زرعه منكر الحديث وقال أبو حاتم يكتب حديثه(@)(@@)(@@)(@@) $ 2513 سلامه بن سلام شيخ للجويباري(@)(@@) قال ابن الجوزي متروك(@)(@@)(@@)(@@) $ 2514 سلامة بن عمر المصري(@)(@@) روى عنه ابن يونس وقال خلط وحدث بما لم يسمع(@)(@@)(@@)(@@) $ 2515 سلامه الأسدي عن سعيد 
ms128	 بن جبير مجهول(@)(@@)(@@)(@@) $ 2516 سلم بن إبراهيم الوراق(@)(@@) عن مبارك بن فضاله ضعفه ابن معين وذكره ابن حبان في الثقات PageV01P272(@)(@@)(@@)(@@) $ 2517 سلم بن بالق أبو الخليل عمر(@)(@@) وزعم أنه رأى صحابيا بعسقلان بقي إلى خلافة المنصور ولم أر أحدا وهاه ولا من احتج به(@)(@@)(@@)(@@) $ 2518 د ت(@)(@@) سلم بن جعفر(@)(@@) عن الحكم بن أبان وثق قال الأزدي متروك(@)(@@)(@@)(@@) $ 2519 ت ق(@)(@@) سلم بن جنادة أبو السائب(@)(@@) صدوق سمع حفص ابن غياث قال أبو أحمد الحاكم يخالف قي بعض حديثه(@)(@@)(@@)(@@) $ 2520 خ م(@)(@@) سلم بن زرير(@)(@@) ثقة ضعفه ابن معين فقط وقال أبو حاتم ليس بالقوي قد خرج له خ في الأصول وم في الشواهد وهو مقل حديثه ثمانية عشر حديثا ووثقه أبو حاتم(@)(@@)(@@)(@@) $ 2521 سلم بن سالم البلخي الزاهد(@)(@@) عن حميد ضعفه أحمد بن حنبل والنسائي غال في الارجاء(@)(@@)(@@)(@@) $ 2522 سلم بن عبد الله الزاهد(@)(@@) عن القاسم بن معن وهاه ابن حبان(@)(@@)(@@)(@@) $ 2523 سلم بن عبد الرحمن(@)(@@) عن أبي زرعة البجلي واه ضعفه بعضهم وقواه ابن معين(@)(@@)(@@)(@@) $ 2524 سلم بن عطية وقيل مسلم بن عطية(@)(@@) وهاه ابن حبان PageV01P273(@)(@@)(@@)(@@) $ 2525 سلم بن محمد الوراق(@)(@@) عن عكرمة بن عمار لم يرضه يحيى بن معين(@)(@@)(@@)(@@) $ 2526 سلم بن ميمون الخواص(@)(@@) عن مالك قال أبو حاتم لا يكتب حديثه(@)(@@)(@@)(@@) $ 2527 بخ تم د سي(@)(@@) سلم العلوي البصري عن أنس وهو ابن قيس(@)(@@) قال ابن معين ثقة وقال شعبة ذاك كان يرى الهلال قبل الناس بليلتين وقال ابن عدي له نحو خمسة أحاديث ما فيها متن منكر وقال ابن حبان لا يحتج به وضعفه ابن معين مرة(@)(@@)(@@)(@@) $ 2528 سلمة بن أحمد السمرقندي(@)(@@) عن خالد بن يزيد العمري صاحب مناكير(@)(@@)(@@)(@@) $ 2529 س ق(@)(@@) سلمة بن الأزرق(@)(@@) عن أبي هريرة لا يعرف(@)(@@)(@@)(@@) $ 2530 س(@)(@@) سلمة بن تمام الشقري أبو عبد الله(@)(@@) عن التابعين وثقه يحيى وضعفه أحمد(@)(@@)(@@)(@@) $ 2531 سلمة بن حبيب(@)(@@) عن بعض التابعين انفرد بخبر منكر ذكره البخاري(@)(@@)(@@)(@@) $ 2532 سلمة بن حرب الكلابي(@)(@@) عن أبي مدرك 
ms129	 مجهولان وعنه نصر بن علي(@)(@@)(@@)(@@) $ 2533 سلمة بن حفص(@)(@@) عن يحيى بن يمان قال أبو حاتم بن حبان كان يضع الحديث كوفي PageV01P274(@)(@@)(@@)(@@) $ 2534 خ ت ق(@)(@@) سلمة بن رجاء الكوفي(@)(@@) عن إبراهيم بن أبي عبلة قال أبو زرعة وغيره صدوق وقال النسائي ضعيف وقال ابن عدي حدث بأحاديث لا يتابع عليها(@)(@@)(@@)(@@) $ 2535 سلمة بن رباح شيخ لمحمد بن يحيى العدني(@)(@@) قال ابن أبي حاتم مجهول(@)(@@)(@@)(@@) $ 2536 سلمة بن سابور عن عطية العوفي(@)(@@) قال ابن معين ضعيف(@)(@@)(@@)(@@) $ 2537 سلمة بن سليمان الضبي عن أبي عوانة(@)(@@) قال ابن عدي منكر الحديث(@)(@@)(@@)(@@) $ 2538 سلمة بن سليمان الموصلي عن ابن أبي رواد ضعفه أبو الفتح الأزدي(@)(@@)(@@)(@@) $ 2539 سلمة بن شريح عن عبادة بن الصامت(@)(@@) لا يعرف(@)(@@)(@@)(@@) $ 2540 سلمة بن صالح الواسطي الأحمر(@)(@@) عن ابن المنكدر متروك الحديث(@)(@@)(@@)(@@) $ 2541 سلمة بن أبي الطفيل(@)(@@) قال عبد الرحمن بن خراش الحافظ مجهول(@)(@@)(@@)(@@) $ 2542 سلمة بن عبيد الله بن محصن عن أبيه(@)(@@) قال أحمد لا أعرفه وغمزه العقيلي(@)(@@)(@@)(@@) $ 2543 سلمة بن الفضل عن حميد قال أبو حاتم لا أعرفه منكر الحديث(@)(@@)(@@)(@@) $ 2544 د ت فق(@)(@@) سلمة بن الفضل الأبرش قاضي الري(@)(@@) عن ابن اسحاق وثقه أبو داود وغيره وضعفه ابن راهوية وغيره وقال خ عنده مناكير PageV01P275(@)(@@)(@@)(@@) $ 2545 سلمة بن كلثوم عن الأوزاعي(@)(@@) قال الدارقطني يهم كثيرا(@)(@@)(@@)(@@) $ 2546 د ق(@)(@@) سلمة بن محمد بن عمار بن ياسر أبو عبيدة عن جده منقطع لم يدركه له فيهما حديث(@)(@@)(@@)(@@) $ 2547 سلمة بن مسلم أو ابن مسلمة عن عطاء(@)(@@) قال أبو حاتم عنده مناكير(@)(@@)(@@)(@@) $ 2548 د تم س ق(@)(@@) سلمة بن نبيط الأشجعي عن أبيه(@)(@@) قال البخاري يقال اختلط بأخرة وثقه أحمد ووكيع(@)(@@)(@@)(@@) $ 2549 بخ ت ق(@)(@@) سلمة بن وردان عن أنس(@)(@@) لين الحديث ضعفه الدارقطني وغيره(@)(@@)(@@)(@@) $ 2550 ت ق(@)(@@) سلمة بن وهرام يروي عنه زمعة(@)(@@) مناكير ضعفه أبو داود ووثقه ابن معين وأبو زرعة(@)(@@)(@@)(@@) $ 2551 سلمة الضبي عن هشام بن عروة(@)(@@) له حديث واحد وهو منكر(@)(@@)(@@)(@@) $ 2552 د ق(@)(@@) سلمى بن 
ms130	 عبد الله أبو بكر الهذلي(@)(@@) عن الحسن تركوا حديثه(@)(@@)(@@)(@@) $ 2553 سلمان بن فروخ أبو واصل عن أبي أيوب الأنصاري(@)(@@) لا يعرف وخبره منكر(@)(@@)(@@)(@@) $ 2554 سليط عن بهية(@)(@@) لا يعرف PageV01P276(@)(@@)(@@)(@@) $ 2555 سليمان بن أحمد الواسطي(@)(@@) محدث مشهور سمع الوليد بن مسلم ضعفوه(@)(@@)(@@)(@@) $ 2556 سليمان بن أحمد الملطي ثم المصري(@)(@@) متأخر روى عنه ابن الثلاج لا يوثق به وكذبه الدارقطني(@)(@@)(@@)(@@) $ 2557 سليمان بن أحمد الطبراني الحافظ(@)(@@) ثقة لينه ابن مردويه وحده(@)(@@)(@@)(@@) $ 2558 سليمان بن أحمد السرقسطي(@)(@@) يروي عن أبي العلاء الواسطي كذاب(@)(@@)(@@)(@@) $ 2559 سليمان بن إبراهيم الأصبهاني الحافظ(@)(@@) مقبول ضعفه يحيى ابن منده الحافظ(@)(@@)(@@)(@@) $ 2560 د ت س(@)(@@) سليمان بن أرقم أبو معاذ البصري عن الحسن(@)(@@) واهي الحديث ضعفه أبو حاتم وغيره قال يحيى لا شيء وقال خ تركوه(@)(@@)(@@)(@@) $ 2561 سليمان بن أيوب الطلحي الكوفي(@)(@@) له مناكير بقي إلى حدود المائتين وخرج له الضياء في المختارة(@)(@@)(@@)(@@) $ 2562 سليمان بن بحير عن أبيه(@)(@@) مجهول(@)(@@)(@@)(@@) $ 2563 سليمان بن بزيع عن مالك(@)(@@) قال أبو سعيد بن يونس منكر الحديث وقيل ابن أبي بزيع(@)(@@)(@@)(@@) $ 2564 سليمان بن بشار عن هشيم(@)(@@) وطبقته متهم بوضع الحديث حدث بمصر PageV01P277(@)(@@)(@@)(@@) $ 2565 سليمان بن بشير(@)(@@) ذكره يعقوب الفسوي في الضعفاء ولا أعرفه(@)(@@)(@@)(@@) $ 2566 سليمان بن جبير عن أنس(@)(@@) مجهول(@)(@@)(@@)(@@) $ 2567 سليمان بن جعفر شيخ لبقية(@)(@@) لا يعرف والخبر منكر(@)(@@)(@@)(@@) $ 2568 سليمان بن جنادة عن أبيه(@)(@@) قال البخاري منكر الحديث(@)(@@)(@@)(@@) $ 2569 سليمان بن الحجاج شيخ للدراوردي(@)(@@) لا يعرف(@)(@@)(@@)(@@) $ 2570 قد(@)(@@) سليمان بن حفص عن هشام بن سعد مجهول(@)(@@) وذكره ابن حبان في الثقات(@)(@@)(@@)(@@) $ 2571 سليمان بن الحكم بن عوانة عن الأعمش(@)(@@) واه باتفاقهم(@)(@@)(@@)(@@) $ 2572 ع(@)(@@) سليمان بن حيان أبو خالد الأحمر(@)(@@) ثقة مشهور وقد ذكره ابن عدي في كامله وقال هو وابن معين قبله صدوق ليس حجة(@)(@@)(@@)(@@) $ 2573 سليمان بن أبي خالد المديني البزاز(@)(@@) شيخ للقعنبي لا يعرف(@)(@@)(@@)(@@) $ 2574 سليمان بن خالد الواسطي عن قتادة(@)(@@) ضعفه الدارقطني(@)(@@)(@@)(@@) $ 2575 د(@)(@@) سليمان بن خربوذ كان في زمن الأعمش(@)(@@) روى عنه عثمان بن عثمان لا 
ms131	 يعرف(@)(@@)(@@)(@@) $ 2576 سليمان بن داود مولى يحيى بن يعمر(@)(@@) مجهول عنه أيوب السختياني(@)(@@)(@@)(@@) $ 2577 س(@)(@@) سليمان بن داود الخولاني الشامي عن الزهري وأبي PageV01P278 قلابة مختلف فيه قال أبو حاتم وغيره لا بأس به وقال ابن معين ضعيف(@)(@@)(@@)(@@) $ 2578 سليمان بن داود اليمامي عن يحيى بن أبي كثير(@)(@@) ضعفه غير واحد(@)(@@)(@@)(@@) $ 2579 سليمان بن داود بن قيس المدني(@)(@@) متكلم فيه قاله الأزدي(@)(@@)(@@)(@@) $ 2580 خت م عه(@)(@@) سليمان بن داود أبو داود الطيالسي(@)(@@) صاحب المسند كان يحفظ ثلاثين ألف حديث وثقوه وقال إبراهيم الجوهري أخطأ في ألف حديث وقال أبو حاتم كان كثير الخطأ(@)(@@)(@@)(@@) $ 2581 سليمان بن داود المنقري الشاذكوني الحافظ(@)(@@) مشهور رماه ابن معين بالكذب وقال البخاري فيه نظر(@)(@@)(@@)(@@) $ 2582 سليمان بن داود الحراني بومة عن الزهري(@)(@@) ضعفه غير واحد(@)(@@)(@@)(@@) $ 2583 سليمان بن الربيع النهدي كوفي عن أبي نعيم ونحوه(@)(@@) تركه الدارقطني(@)(@@)(@@)(@@) $ 2584 سليمان بن رجاء عن عبد العزيز بن مسلم(@)(@@) مجهول(@)(@@)(@@)(@@) $ 2585 سليمان بن زياد عن شيبان النحوي(@)(@@) لا يعرف وحديثه منكر بل باطل(@)(@@)(@@)(@@) $ 2586 سليمان بن زياد(@)(@@) قال ابن يونس في روايته عن ابن وهب نظر يقال اختلط(@)(@@)(@@)(@@) $ 2587 بخ(@)(@@) سليمان بن يزيد وقيل ابن زيد أبو إدام المحاربي(@)(@@) عن ابن أبي أوفى كذبه يحيى بن معين PageV01P279(@)(@@)(@@)(@@) $ 2588 سليمان بن سالم القطان المدني(@)(@@) روى عنه يعقوب بن حميد بن كاسب قال البخاري أتى بخبر لا يتابع عليه وقال ابن عدي لا أرى به بأسا(@)(@@)(@@)(@@) $ 2589 سليمان بن أبي سراج(@)(@@) ضعفه الدارقطني(@)(@@)(@@)(@@) $ 2590 د(@)(@@) سليمان بن سفيان المدني عن عبد الله بن دينار(@)(@@) ضعفوه(@)(@@)(@@)(@@) $ 2591 سليمان بن سفيان الجهني عن قيس بن الربيع ضعيف(@)(@@)(@@)(@@) $ 2592 سليمان بن سلم الرازي(@)(@@) مجهول يروي عن الحارث بن فضيل(@)(@@)(@@)(@@) $ 2593 سليمان بن سلمة أبو أيوب الخبائري عن إسماعيل بن عياش(@)(@@) تركه أبو حاتم(@)(@@)(@@)(@@) $ 2594 سليمان بن سلمة عن أصحاب مالك(@)(@@) اتهمه ابن حبان بوضع الحديث(@)(@@)(@@)(@@) $ 2595 سليمان بن أبي سليمان القافلائي عن الحسن ومحمد(@)(@@) متروك الحديث(@)(@@)(@@)(@@) $ 2596 سليمان بن أبي سليمان اليمامي وهو ابن 
ms132	 داود ضعيف تقدم(@)(@@)(@@)(@@) $ 2597 ت(@)(@@) سليمان بن أبي سليمان مولى ابن عباس(@)(@@) لا يعرف تفرد عنه العوام بن حوشب(@)(@@)(@@)(@@) $ 2598 سليمان بن شعيب بن الليث بن سعد(@)(@@) ثنا ابن لهيعة قال ابن يونس روى مناكير(@)(@@)(@@)(@@) $ 2599 سليمان بن شهاب عن عبد الله(@)(@@) بن معتمر مجهول PageV01P280(@)(@@)(@@)(@@) $ 2600 سليمان بن صلاية الملطي متهم(@)(@@)(@@)(@@) $ 2601 عس(@)(@@) سليمان بن عبد الله(@)(@@) عن معاذة عن علي أنا الصديق الأكبر في الضعفاء للعقيلي وقال خ لا يتابع عليه(@)(@@)(@@)(@@) $ 2602 د(@)(@@) سليمان بن عبد الحميد البهراني(@)(@@) كذبه النسائي وقبله غيره وقال أبو حاتم صدوق(@)(@@)(@@)(@@) $ 2603 سليمان بن عبد الله أبو الوليد الرقي(@)(@@) قال ابن معين ليس بشيء ذكره الجوزي(@)(@@)(@@)(@@) $ 2604 ت ق(@)(@@) سليمان بن عبيد الله الرقي أبو أيوب صويلح(@)(@@) عن عبيد الله بن عمرو قال ابن معين ليس بشيء(@)(@@)(@@)(@@) $ 2605 ق قد(@)(@@) سليمان بن عتبة الدمشقي عن يونس بن ميسرة(@)(@@) وثقه دحيم ووهاه ابن معين(@)(@@)(@@)(@@) $ 2606 م د س ق(@)(@@) سليمان بن عتيق عن ابن الزبير(@)(@@) قال البخاري لا يصح حديثه(@)(@@)(@@)(@@) $ 2607 سليمان بن أبي عثمان التجيبي(@)(@@) روى عنه سالم بن غيلان مصري مجهول PageV01P281(@)(@@)(@@)(@@) $ 2608 ق(@)(@@) سليمان بن عطاء الحراني عن مسلمة الجهني(@)(@@) هالك اتهم بالوضع لقيه النفيلي وقال أبو حاتم ليس بالقوي(@)(@@)(@@)(@@) $ 2609 سليمان بن عمران عن حفص بن غياث(@)(@@) قال ابن أبي حاتم دل حديثه على أنه ليس بصدوق(@)(@@)(@@)(@@) $ 2610 سليمان بن عمرو أبو داود النخعي(@)(@@) عن عبد الملك بن عمير وكان يكذب(@)(@@)(@@)(@@) $ 2611 سليمان بن عيسى بن نجيح السجزي(@)(@@) عن ابن عون كان يضع الحديث(@)(@@)(@@)(@@) $ 2612 سليمان بن الفضل(@)(@@) عن ابن المبارك تكلم فيه أبو أحمد بن عدي(@)(@@)(@@)(@@) $ 2613 م د ت س(@)(@@) سليمان بن قرم أبو داود الضبي وهو ابن معاذ نسب إلى جده(@)(@@) عن محمد بن المنكدر وثقه أحمد وقال أبو زرعة ليس بذاك وقال أبو حاتم ليس هو بالمتين وقال ابن حبان رافضي غال يقلب الأخبار(@)(@@)(@@)(@@) $ 2614 ع(@)(@@) سليمان بن كثير العبدي البصري عن الزهري ثقة مشهور ضعفه ابن معين 
ms133	 وقال النسائي ليس به بأس الا في الزهري(@)(@@)(@@)(@@) $ 2615 سليمان بن كراز الطفاوي(@)(@@) عن مبارك بن فضالة ضعفه ابن عدي(@)(@@)(@@)(@@) $ 2616 سليمان بن أبي كريمة(@)(@@) عن هشام بن عروة لين صاحب مناكير(@)(@@)(@@)(@@) $ 2617 سليمان بن محمد بن حيان الموصلي(@)(@@) ضعفه الأزدي(@)(@@)(@@)(@@) $ 2618 سليمان بن محمد بن الفضل النهرواني(@)(@@) متأخر ضعفه الدارقطني(@)(@@)(@@)(@@) $ 2619 سليمان بن محمد الهاشمي عن شريك لا يعرف PageV01P282(@)(@@)(@@)(@@) $ 2620 سليمان بن محمد القافلائي هو ابن أبي سليمان مر(@)(@@)(@@)(@@) $ 2621 سليمان بن مرثد عن عائشة وأبي الدرداء لا يدرى ألقيهما أم لا(@)(@@)(@@)(@@) $ 2622 سليمان بن مرقاع الجندعي عن مجاهد(@)(@@) قال العقيلي منكر الحديث(@)(@@)(@@)(@@) $ 2623 سليمان بن مساحن مجهول عن نافع(@)(@@)(@@)(@@) $ 2624 سليمان بن مسافع الحجبي(@)(@@) عن منصور بن صفية لا يعرف والخبر منكر(@)(@@)(@@)(@@) $ 2625 سليمان بن مسلم الخشاب عن سليمان التيمي(@)(@@) تركه ابن حبان وغيره(@)(@@)(@@)(@@) $ 2626 خت م د ت س(@)(@@) سليمان بن معاذ هو سليمان بن قرم قد ذكر(@)(@@)(@@)(@@) $ 2627 سليمان بن المعافى بن سليمان الرسعني(@)(@@) قال ابن عدي لم يسمع من أبيه شيئا فحملوه على أن روى عنه قلت تكون روايته عنه وجادة(@)(@@)(@@)(@@) $ 2628 ع(@)(@@) سليمان بن مهران الأعمش(@)(@@) ثقة جبل ولكنه يدلس قال وهب بن زمعة سمعت ابن المبارك يقول انما أفسد حديث أهل الكوفة الأعمش وأبو اسحاق وقال جرير سمعت مغيرة يقول أهلك أهل الكوفة أبو اسحاق وأعمشكم هذا كأنه عنى الرواية عمن جاء PageV01P283(@)(@@)(@@)(@@) $ 2629 سليمان بن موسى(@)(@@) عن مظاهر بن أسلم صويلح الحال(@)(@@)(@@)(@@) $ 2630 عه فق(@)(@@) سليمان بن موسى الأشدق أبو أيوب(@)(@@) عن عطاء ونافع وثق وقال البخاري عنده مناكير وقال النسائي ليس بالقوي(@)(@@)(@@)(@@) $ 2631 سليمان بن هرم عن ابن المنكدر(@)(@@) قال الأزدي لا يصح حديثه قلت تفرد عن ابن المنكدر عن جابر بحديث العابد والرمانة وعنه كاتب الليث(@)(@@)(@@)(@@) $ 2632 سلميان بن يزيد أبو المثنى الكعبي الخزاعي(@)(@@) عن أنس قال أبو حاتم منكر الحديث ليس بقوي(@)(@@)(@@)(@@) $ 2633 ق(@)(@@) سليمان بن بشير ويقال ابن بشير ويقال ابن قسيم أبو الصباح النخعي الكوفي عن إبراهيم النخعي 
ms134	 والحكم روى عنه شعبة وضعفه أبو داود وغيره(@)(@@)(@@)(@@) $ 2634 سليمان البصري عن أنس(@)(@@)(@@)(@@) $ 2635 وسليمان عن مولى لأنس(@)(@@)(@@)(@@) $ 2636 وسليمان العبدي عن تبيع(@)(@@)(@@)(@@) $ 2637 وسليمان أبو حبيب عن أبي الجلد(@)(@@)(@@)(@@) $ 2638 وسليمان عن أبي هريرة مجهولون(@)(@@)(@@)(@@) $ 2639 سليم بن عثمان الفوزي الحمصي(@)(@@) عن محمد بن زياد الألهاني متهم واه PageV01P284(@)(@@)(@@)(@@) $ 2640 سليم بن عمرو الأنصاري شامي(@)(@@) لا يعرف وخبره باطل رواه عنه علي بن عياش(@)(@@)(@@)(@@) $ 2641 سليم بن عيسى عن الثوري(@)(@@) قال العقيلي مجهول وحديثه منكر قلت بل إمام في القراءة جائز الحديث(@)(@@)(@@)(@@) $ 2642 سليم بن مطير عن أبيه(@)(@@) ذكره ابن حبان في كتاب الضعفاء(@)(@@)(@@)(@@) $ 2643 سليم بن منصور بن عمار(@)(@@) عن ابن علية تكلم فيه ولم يترك(@)(@@)(@@)(@@) $ 2644 سليم أبو سلمة عن الشعبي(@)(@@) قال النسائي ليس بثقة(@)(@@)(@@)(@@) $ 2645 سليم أبو ميمونة عن أبي هريرة(@)(@@) ة قيل كان يبيع الصور(@)(@@)(@@)(@@) $ 2646 سليم أبو عتبة السلمي(@)(@@) عن الشعبي مجهول(@)(@@)(@@)(@@) $ 2647 سليم بن صالح(@)(@@) عن ابن ثوبان لا يعرف(@)(@@)(@@)(@@) $ 2648 سليم بن مسلم الكاتب الخشاب(@)(@@) عن ابن جريج قال النسائي متروك وقال ابن معين جهمي خبيث(@)(@@)(@@)(@@) $ 2649 م عه خت(@)(@@) سماك بن حرب صدوق جليل(@)(@@) كان شعبة يضعفه وقال ابن المبارك ضعيف الحديث وقال ابن خراش في حديثه لين وقال أحمد مضطرب الحديث(@)(@@)(@@)(@@) $ 2650 بخ(@)(@@) سماك بن سلمة الضبي(@)(@@) لا يعرف على أنه قد وثق(@)(@@)(@@)(@@) $ 2651 س ق(@)(@@) سمرة بن سهم(@)(@@) تابعي لا يعرف PageV01P285(@)(@@)(@@)(@@) $ 2652 سمعان بن مالك عن أبي وائل(@)(@@) قال أبو زرعة الرازي ليس بالقوي(@)(@@)(@@)(@@) $ 2653 سمعان بن مهدي(@)(@@) عن أنس لا يعرف ألصقت به نسخة قبح الله واضعها(@)(@@)(@@)(@@) $ 2654 سمير بن داود مجهول(@)(@@)(@@)(@@) $ 2655 سميع بن زاذان شيخ لوكيع مجهول(@)(@@)(@@)(@@) $ 2656 خ ق د ت(@)(@@) سنان بن ربيعة(@)(@@) عن أنس صدوق قال ابن معين ليس بالقوي وقال أبو حاتم مضطرب الحديث قلت خرج له البخاري مقرونا بآخر وقد وثقه بعضهم(@)(@@)(@@)(@@) $ 2657 ت(@)(@@) سنان بن هارون البرجمي(@)(@@) قال أبو حاتم شيخ وقال ابن معين ليس حديثه بشيء(@)(@@)(@@)(@@) $ 2658 سنان مولى واثلة 
ms135	 روى عنه خالد بن أبي يزيد مجهول(@)(@@)(@@)(@@) $ 2659 سندول قال أبو داود متروك(@)(@@)(@@)(@@) $ 2660 سندي بن أبي هارون شيخ مسدد مجهول(@)(@@)(@@)(@@) $ 2661 ق(@)(@@) سنيد بن داود المصيصي(@)(@@) عن حماد بن زيد قال أبو داود لم يكن بذاك وضعفه أبو حاتم(@)(@@)(@@)(@@) $ 2662 سهل بن أحمد الديباجي عن أبي خليفة رمي بعظيمتين الرفض والكذب PageV01P286(@)(@@)(@@)(@@) $ 2663 سهل بن ادريس(@)(@@) قال أحمد بن عبدان كان يلين عن سلمة بن شبيب(@)(@@)(@@)(@@) $ 2664 سهل بن تمام عن قرة بن خالد(@)(@@) قال أبو زرعة ربما وهم في الشيء(@)(@@)(@@)(@@) $ 2665 سهل بن ثعلبة عن عبد الله بن الحارث بن جزء(@)(@@)(@@)(@@) $ 2666 وسهل بن حزن عن أبيه مجهولان(@)(@@)(@@)(@@) $ 2667 سهل بن حماد بعد المائتين وليس بالدلال لا يعرف(@)(@@)(@@)(@@) $ 2668 سهل بن خاقان(@)(@@) عن جعفر الصادق في قراءة يس حديثا موضوعا(@)(@@)(@@)(@@) $ 2669 سهل بن رجاء(@)(@@) قال الدارقطني ينفرد عن الثقات بأحاديث(@)(@@)(@@)(@@) $ 2670 سهل بن زياد القطان أبو علي(@)(@@) عن شريك ليس بالقوي(@)(@@)(@@)(@@) $ 2671 سهل بن سليمان الاسود بصري عن شعبة تركوه(@)(@@)(@@)(@@) $ 2672 ق(@)(@@) سهل بن صقير عن ابن عيينة(@)(@@) تكلم فيه ابن عدي فيه لين(@)(@@)(@@)(@@) $ 2673 ق(@)(@@) سهل بن أبي الصلت السراج عن الحسن صدوق ( وله حديث ينكر وثقه أبو داود )(@)(@@)(@@)(@@) $ 2674 سهل بن صخر(@)(@@) لا أعرفه ونقل لي أنه ضعيف(@)(@@)(@@)(@@) $ 2675 سهل بن عبد الله بن بريدة(@)(@@) عن أبيه قال ابن حبان منكر الحديث(@)(@@)(@@)(@@) $ 2676 سهل بن عبد الله المرزوي عن عبد الملك بن مهران(@)(@@) مجهولان في أكل الطين(@)(@@)(@@)(@@) $ 2677 سهل بن عامر البجلي(@)(@@) عن مالك بن مغول رماه أبو حاتم بالكذب PageV01P287(@)(@@)(@@)(@@) $ 2678 سهل بن العباس الترمذي عن ابن علية(@)(@@) تركه الدارقطني(@)(@@)(@@)(@@) $ 2679 سهل بن علي عن علي بن الجعد(@)(@@) متهم بالكذب توفي 387(@)(@@)(@@)(@@) $ 2680 سهل بن عمار النيسابوري عن يزيد بن هارون(@)(@@) كذبه الحاكم(@)(@@)(@@)(@@) $ 2681 سهل بن قرين بفتح القاف عن ابن أبي ذيب(@)(@@) قال الأزدي كذاب وقيل سهيل(@)(@@)(@@)(@@) $ 2682 د ت ق(@)(@@) سهل بن معاذ بن أنس الجهني عن أبيه(@)(@@) ضعفه ابن معين ولم يترك(@)(@@)(@@)(@@) $ 2683 سهل 
ms136	 بن يزيد عن فضالة بن عبيد(@)(@@) مجهول وعن أفلح به سعيد(@)(@@)(@@)(@@) $ 2684 سهل بن فلان الفزاري عن أبيه عن جندب مجهول(@)(@@)(@@)(@@) $ 2685 سهل أبو حريز مولى المغيرة عن الزهري(@)(@@) قال ابن حبان لا يحتج به(@)(@@)(@@)(@@) $ 2686 سهل الأعرابي بصري عن رجل وبلال بن أبي بردة(@)(@@) قال ابن حبان منكر الحديث(@)(@@)(@@)(@@) $ 2687 سهيل بن بيان عن خالد الحذاء(@)(@@) لقيه أبو حاتم وهاه الفلاس(@)(@@)(@@)(@@) $ 2688 ص(@)(@@) سهيل بن خالد العبدي(@)(@@) عن محمد بن سواء بخبر منكر(@)(@@)(@@)(@@) $ 2689 سهيل بن أبي حزم عن ثابت(@)(@@) قال البخاري والنسائي ليس بالقوي(@)(@@)(@@)(@@) $ 2690 سهيل بن ذكوان أبو السندي عن عائشة(@)(@@) قال وكانت سوداء فكذبه يحيى بن معين وقال غير واحد متروك الحديث PageV01P288(@)(@@)(@@)(@@) $ 2691 م عه(@)(@@) سهيل بن أبي صالح ذكوان(@)(@@) ثقة تغير حفظه وقال ابن معين ليس بالقوي(@)(@@)(@@)(@@) $ 2692 سهيل بن عمير عن أبيه(@)(@@)(@@)(@@) $ 2693 وسهيل بن فرقد عن الحسن مجهولان(@)(@@)(@@)(@@) $ 2694 سوادة بن اسماعيل(@)(@@) عن أنس مجهول وخبره كذب في الماء المشمس(@)(@@)(@@)(@@) $ 2695 سوادة بن علي هو ابن بنت ابن نمير(@)(@@) ضعفه الدارقطني يروي عن أبي نعيم(@)(@@)(@@)(@@) $ 2696 د ق(@)(@@) سوار بن داود أبو حمزة وقيل داود ابن سوار كما تقدم صالح الحديث(@)(@@)(@@)(@@) $ 2697 كد(@)(@@) سوار بن سهل شيخ لأبي داود السجزي لا يكاد يعرف(@)(@@)(@@)(@@) $ 2698 سوار بن عبد الله بن قدامة العنبري(@)(@@) قال الثوري ليس بشيء(@)(@@)(@@)(@@) $ 2699 سوار بن عمر لا يدرى من هو(@)(@@) قال البخاري لم يصح حديثه PageV01P289(@)(@@)(@@)(@@) $ 2700 سوار بن محمد بن قريش المصري عن يزيد بن زريع(@)(@@) مقل رفع حديثا فأخطأ(@)(@@)(@@)(@@) $ 2701 سوار بن مصعب شيخ أبي الجهم(@)(@@) قال أحمد والدارقطني متروك الحديث(@)(@@)(@@)(@@) $ 2702 سوار أبو ادريس المرهبي(@)(@@) عن المسيب بن نجبة شيعي جلد(@)(@@)(@@)(@@) $ 2703 سوار عن ابن عباس(@)(@@) قال ابن معين شبه لا شيء(@)(@@)(@@)(@@) $ 2704 سويد بن إبراهيم العطار بصري عن الحسن(@)(@@) ضعفه النسائي وقواه غيره(@)(@@)(@@)(@@) $ 2705 سويد بن الخطاب عن إياس بن سلمة(@)(@@) قال يحيى بن معين لا شيء عنه الحوضي والتبوذكي(@)(@@)(@@)(@@) $ 2706 م ق(@)(@@) سويد بن سعيد الحدثاني 
ms137	(@)(@@) شيخ مسلم محدث نبيل له مناكير قال أبو حاتم صدوق وقال أحمد متروك وقال النسائي ليس بثقة وقال البخاري عمي وكان يقبل التلقين وقواه الدارقطني(@)(@@)(@@)(@@) $ 2707 سويد بن سعيد الدقاق عن علي بن عاصم(@)(@@) شيخ منكر الحديث يجهل وقواه الدارقطني PageV01P290(@)(@@)(@@)(@@) $ 2708 ت ق(@)(@@) سويد بن عبد العزيز الدمشقي قاضي بعلبك(@)(@@) عن أبي الزبير قال البخاري في حديثه نظر لا يحتمل وقال أحمد متروك الحديث وقال س وغيره ضعيف(@)(@@)(@@)(@@) $ 2709 م ت س ق(@)(@@) سويد بن عمرو الكلبي(@)(@@) عن حماد بن سلمة وثقوه وأما ابن حبان فقال كان يضع الحديث المتون الواهية على الأسانيد الصحاح(@)(@@)(@@)(@@) $ 2710 سويد بن قيس مصري يروي عن زهير البلوي لا يعرف(@)(@@)(@@)(@@) $ 2711 ت س ق(@)(@@) سيار بن حاتم صالح صالح الحديث فيه خفة ولم يضعفه أحد بل قال الأزدي عنده مناكير(@)(@@)(@@)(@@) $ 2712 سيار بن مغرور بغين معجمة قاله ابن معين وقال غيره بمهملة قال علي بن المديني مجهول لم يرو عنه غير سماك بن حرب(@)(@@)(@@)(@@) $ 2713 سيسوية زوج أم موسى الاسواري مجهول(@)(@@)(@@)(@@) $ 2714 سيف بن أبي زياد شيخ لمروان بن معاوية مجهول(@)(@@)(@@)(@@) $ 2715 خ م د س ق(@)(@@) سيف بن سليمان المكي صاحب مجاهد(@)(@@) ثقة إلا أنه رمي بالقدر قال ابن معين قدري PageV01P291(@)(@@)(@@)(@@) $ 2716 ت(@)(@@) سيف بن عمر التميمي الأسدي(@)(@@) له تواليف متروك باتفاق وقال ابن حبان اتهم بالزندقة قلت ادرك التابعين وقد اتهم قال ابن حبان يروي الموضوعات(@)(@@)(@@)(@@) $ 2717 سيف بن عميرة(@)(@@) عن أبان بن تغلب وغيره تكلم فيه قاله الأزدي(@)(@@)(@@)(@@) $ 2718 ت(@)(@@) سيف بن محمد بن اخت سفيان الثوري عن التابعين(@)(@@) قال أحمد كذاب يضع الحديث(@)(@@)(@@)(@@) $ 2719 سيف بن المبارك الدينوري عن محمد بن فضيل(@)(@@) قال الخليلي لا يحتج به(@)(@@)(@@)(@@) $ 2720 سيف بن مسكين عن سعيد بن أبي عروبة(@)(@@) وهاه ابن حبان(@)(@@)(@@)(@@) $ 2721 سيف بن منير عن أبي الدرداء(@)(@@) فيه جهالة ضعفه الدارقطني وهو مجهول له عن أبي الدرداء مرفوعا لا تكفروا اهل بيتي وإن عملوا الكبائر لكنه من رواية مكرم بن حكيم أحد 
ms138	 الضعفاء عنه(@)(@@)(@@)(@@) $ 2722 سيف بن أبي المغيرة عن مجالد(@)(@@) ضعفه الدارقطني وغيره(@)(@@)(@@)(@@) $ 2723 ت ق(@)(@@) سيف بن هارون البرجمي(@)(@@) وثقه بعضهم وضعفه النسائي والدارقطني(@)(@@)(@@)(@@) $ 2724 سيف بن هارون آخر عن شعبة ضعيف PageV01P292(@)(@@)(@@)(@@) $ 2725 سيف بن وهب عن أبي الطفيل(@)(@@) قال النسائي ليس هو بثقة وضعفه أحمد(@)(@@)(@@)(@@) $ 2726 السيف الآمدي علي بن أبي علي(@)(@@) تارك للصلاة شاك في دينه نفوه من دمشق من أجل اعتقاده(@)(@@)(@@)(@@) | حرف الشين(@)(@@)(@@)(@@) $ 2727 شاذان هو النضر يأتي في حرف النون(@)(@@)(@@)(@@) $ 2728 د س شاذ بن فياض اسمه هلال بصري مشهور عن شعبة(@)(@@)(@@)(@@) $ 2729 شاه بن شير الخراساني عن قتيبة(@)(@@) كان يضع الحديث وهو ابن شيرماه وقيل شيرباميان(@)(@@)(@@)(@@) $ 2730 شاهين بن حيان أخو فهد(@)(@@) ضعفه أبو حاتم وغيره(@)(@@)(@@)(@@) $ 2731 شباب بن العلاء عن حماد بن زيد مجهول(@)(@@)(@@)(@@) $ 2732 خ م(@)(@@) شبابة بن سوار(@)(@@) ثقة في نفسه قال أحمد كان داعية في الارجاء وقال أبو حاتم لا يحتج به(@)(@@)(@@)(@@) $ 2733 شبل بن العلاء بن عبد الرحمن عن أبيه(@)(@@) قال ابن عدي له مناكير(@)(@@)(@@)(@@) $ 2734 شبوية عن ابن مبارك(@)(@@) له حديث منكر PageV01P293(@)(@@)(@@)(@@) $ 2735 ت ق(@)(@@) شبيب بن بشر عن أنس(@)(@@) قال أبو حاتم وغيره لين الحديث وثقه ابن معين(@)(@@)(@@)(@@) $ 2736 خ س(@)(@@) شبيب بن سعد بن الحبطي ثقه له غرائب(@)(@@)(@@)(@@) $ 2737 شبيب بن سليم عن الحسن(@)(@@) ضعفه الدارقطني(@)(@@)(@@)(@@) $ 2738 ت(@)(@@) شبيب بن شيبة أحد البلغاء(@)(@@) عن الحسن ضعفوه في الحديث(@)(@@)(@@)(@@) $ 2739 شبيب بن مهران العبدي عن قتادة(@)(@@) قال السيف بن المجد فيه بعض الكلام(@)(@@)(@@)(@@) $ 2740 شبيب أبو الحارث(@)(@@) عن موسى بن مجاهد مجهول(@)(@@)(@@)(@@) $ 2741 شبيل بن عائذ روى(@)(@@) عنه عامر بن حفص مجهول(@)(@@)(@@)(@@) $ 2742 شجاع بن عبد الرحمن(@)(@@) عن الحسين مجهول(@)(@@)(@@)(@@) $ 2743 شجاع بن الوليد ثقة مشهور(@)(@@) قال أبو حاتم لين الحديث وقال ليس بحجة(@)(@@)(@@)(@@) $ 2744 شجاع عن أبي طيبة عن ابن مسعود(@)(@@) قال أحمد لا أعرفهما(@)(@@)(@@)(@@) $ 2745 شداد بن الحارث مجهول(@)(@@)(@@)(@@) $ 2746 شداد بن أبي سلام ممطور وعنه محرز الجزري(@)(@@) لا يكاد يعرف PageV01P295(@)(@@)(@@)(@@) $ 2747 م س(@)(@@) شداد بن 
ms139	 سعيد الراسبي أبو طلحة(@)(@@) صدوق وغيره أقوى منه سمع يزيد بن الشخير قال العقيلي له غير حديث لا يتابع على شيء منها كذا قال وأما ابن عدي فقال لم أر له حديثا منكرا(@)(@@)(@@)(@@) $ 2748 د(@)(@@) شداد بن أبي عمرو بن حماس(@)(@@) تابعي لا يعرف وذكره ابن حبان في الثقات(@)(@@)(@@)(@@) $ 2749 شراحيل بن عبد الحميد مجهول(@)(@@)(@@)(@@) $ 2750 شراحيل بن عمرو العنسي عن عمرو بن الأسود(@)(@@) ضعفه محمد بن عوف الطائي(@)(@@)(@@)(@@) $ 2751 شراحيل بن عمرو عن بكر بن خنيس(@)(@@) فيه ضعف(@)(@@)(@@)(@@) $ 2752 شراحيل عن فضالة بن عبيد(@)(@@)(@@)(@@) $ 2753 وشراحيل عن إبراهيم مجهولان(@)(@@)(@@)(@@) $ 2754 شرحبيل بن الحكم عن عامر بن عايل(@)(@@) قال ابن خزيمة أنا أبرأ من عهدتهما(@)(@@)(@@)(@@) $ 2755 د ق بخ(@)(@@) شرحبيل بن سعد المدني عن زيد بن ثابت(@)(@@) اتهمه ابن أبي ذئب وضعفه الدارقطني وغيره(@)(@@)(@@)(@@) $ 2756 د ت ق(@)(@@) شرحبيل بن مسلم(@)(@@) تابعي مشهور ضعفه ابن معين ووثقه أحمد PageV01P296(@)(@@)(@@)(@@) $ 2757 شرقي بن قطامي مؤدب المهدي عن مجالد(@)(@@) ضعفه زكريا الساجي(@)(@@)(@@)(@@) $ 2758 شرقي الجعفي عن سويد بن غفلة الحائك(@)(@@) ملعون قال البخاري حديثه ليس بالقائم(@)(@@)(@@)(@@) $ 2759 عه(@)(@@) شريح بن النعمان الصائدي(@)(@@) عن علي قوي الأمر وقال أبو حاتم شبه المجهول(@)(@@)(@@)(@@) $ 2760 شريك بن تميم عن أبيه عن أبي ذر مجهول(@)(@@)(@@)(@@) $ 2761 د ت(@)(@@) شريك بن حنبل(@)(@@) لا يعرف قال أبو أسحاق ثنا شريك ولا يعرف إلا منه(@)(@@)(@@)(@@) $ 2762 شريك بن سهيل شامي(@)(@@) روى عنه صفوان بن عمرو مجهول(@)(@@)(@@)(@@) $ 2763 خ م س(@)(@@) شريك بن عبد الله بن أبي نمر المديني(@)(@@) تابعي صدوق قال ابن معين والنسائي ليس بالقوي وقال ابن معين في موضع آخر لا بأس به(@)(@@)(@@)(@@) $ 2764 عه م متابعة(@)(@@) شريك بن عبد الله النخعي القاضي(@)(@@) صدوق وثقة ابن معين وغيره وقال النسائي لا بأس به وقال ابن المبارك هو أعلم بحديث الكوفيين من الثوري وقال الدارقطني وغير واحد ليس بالقوي وقال أبو حاتم لا يقوم مقام الحجة في حديثه بعض الغلط PageV01P297(@)(@@)(@@)(@@) $ 2765 شعبة بن عمرو عن أنس(@)(@@) قال البخاري أحاديثه 
ms140	 مناكير(@)(@@)(@@)(@@) $ 2766 د(@)(@@) شعبة بن يحيى مولى ابن عباس(@)(@@) قال أحمد ما به بأس وقال النسائي ليس بالقوي(@)(@@)(@@)(@@) $ 2767 شعبة بن كريب بن أبرهة(@)(@@) مجهول وكذا(@)(@@)(@@)(@@) $ 2768 شعبة بن بريدة الحنفي(@)(@@)(@@)(@@) $ 2769 شعيب بن إبراهيم الكوفي الراوي عن سيف(@)(@@) كتبه فيه جهالة(@)(@@)(@@)(@@) $ 2770 شعيب بن أحمد البغدادي(@)(@@) ثنا عبد الحميد بن صالح بخبر كذب في ان الثوب يسبح(@)(@@)(@@)(@@) $ 2771 شعيب بن أبي الأشعث عن هشام بن عروة مجهول(@)(@@)(@@)(@@) $ 2772 د(@)(@@) شعيب بن أيوب الصريفيني(@)(@@) وثقه الدارقطني وغيره وقال أبو داود إني لأخاف الله في الراوية عنه(@)(@@)(@@)(@@) $ 2773 س(@)(@@) شعيب بن بيان الصفار عن شعبة(@)(@@) صدوق وقال الجوزجاني له مناكير(@)(@@)(@@)(@@) $ 2774 شعيب بن حرب وليس بالمدائني(@)(@@) قال البخاري منكر الحديث مجهول ثم أورد له عن صخر بن جويريه عن نافع حديثا منكرا PageV01P298(@)(@@)(@@)(@@) $ 2775 شعيب بن حيان بصري(@)(@@) معاصر لشعبة قال البخاري لا يصح حديثه(@)(@@)(@@)(@@) $ 2776 شعيب بن راشد شيخ لقتيبة كوفي(@)(@@)(@@)(@@) $ 2777 وشعيب بن أبي راشد عن تابعي مجهولان(@)(@@)(@@)(@@) $ 2778 شعيب بن سهل قاضي بغداد(@)(@@) ذكره ابن أبي حاتم وقال أحمد بن حنبل جهمي(@)(@@)(@@)(@@) $ 2779 م س تم(@)(@@) شعيب بن صفوان عن حميد الطويل(@)(@@) وثقه أحمد وقال ابن عدي عامة ما يرويه لا يتابع عليه(@)(@@)(@@)(@@) $ 2780 شعيب بن طلحة(@)(@@) قال ابن معين لايعرف وقال الدارقطني متروك له عن معن(@)(@@)(@@)(@@) $ 2781 شعيب بن كيسان عن أنس(@)(@@) ذكره البخاري في الضعفاء ولينه العقيلي(@)(@@)(@@)(@@) $ 2782 شعيب بن مبشر عن الأوزاعي(@)(@@) ذكره ابن حبان في الضعفاء وهو صويلح(@)(@@)(@@)(@@) $ 2783 شعيب بن ميمون عن حصين بن عبد الرحن(@)(@@) مجهول قلت بل روى عنه ثلاثة وقال الدارقطني ليس بالقوي(@)(@@)(@@)(@@) $ 2784 شعيب بن واقد(@)(@@) عن نافع أبي هرمز ضرب الفلاس على حديثه وسمع منه أبو حاتم(@)(@@)(@@)(@@) $ 2785 س(@)(@@) شعيب بن يحيى التجيبي عن حيوة بن شريح ثقة(@)(@@) قال أبو حاتم ليس بمعروف PageV01P299(@)(@@)(@@)(@@) $ 2786 شعيث بن شداد مدني(@)(@@) روى عنه أبو بكر بن أبي سبرة مجهول(@)(@@)(@@)(@@) $ 2787 شعيث بن إبراهيم بن زبيب عن أبيه عن جده أعرابي لعله صدوق 