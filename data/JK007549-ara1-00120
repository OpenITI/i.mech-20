ms101	 إذا ما حاربوا % % عز قراسية ، وجد مدفع % 117(@)(@@) % الذائدون ، فلا يهدم حوضهم ، % والواردون ، فوردهم لا يقدع % 118(@)(@@) % ما كان يضلع من أخي عمية ، % إلا عليه دروء سعد أضلع % 119(@)(@@) % فاعلم بأن لآل سعد عندنا % % عهدا وحبل وثيقة لا يقطع % 121(@)(@@) % عرفوا لنا السلف القديم وشاعرا % ترك القصائد ليس فيها مصنع % PageV01P351 122(@)(@@) % ورأيت نبلك يا فرزدق قصرت % ووجدت قوسك ليس فيها منزع % PageV01P352 البحر : طويل 1(@)(@@) % ليس زمان بالكميتين راجعا ، % وليس إلى ذاك الزمان رجوع % 2(@)(@@) % ليالي لا سري إليهن شائع ، % ولا أنت للمستودعات مشيع % 3(@)(@@) % فلو أنجبت أم الفرزدق لم يعب % فوارسنا لا مات وهو جميع % % 4(@)(@@) % ألا ربما فدى بكورا فوارسي ، % بأميه ، ملهوف الفؤاد مروع % 5(@)(@@) % هو النخبة الحوار ما دون قلبه % % حجاب ولا حول الفؤاد ضلوع % 6(@)(@@) % أصاب قرار اللؤم في بطن أمه % وراضع ثدي اللؤم رضيع % PageV01P353 البحر : - 1(@)(@@) % بان الخليط فعينه لا تهجع ، % والقلب من حذر الفراق مروع % 2(@)(@@) % ود العوازل يوم رامة أنهم % قطعوا الحبال وليتها لا تقطع % 3(@)(@@) % قال العواذل غيرع جد نصاحة : % أعلى الشباب وقد بليت تفجع ؟ % 4(@)(@@) % يا ليت لو رفعت بنا عيدية % أعناقهن على الطريق تزعزع % 5(@)(@@) % صبحن دومة بعد خمس جاهد % غلسا وفضل نسوعها يتنوع % 6(@)(@@) % تعلو السماوة تلتظي حزانها % % و الآل فوق ذري وعال يلمع % 7(@)(@@) % يكفي الأدلة بعد سوء ظنونهم % مر المطي إذا الحداة تشغوا % % 8(@)(@@) % والأرحبي إذا الظلال تقاصرت ، % يغري الغري وذات غرب ميلع % 9(@)(@@) % حرف تحاذر في خشاش ناشب % حصدا يسور كما يسور الأشجع % 10(@)(@@) % شذب المكارب من جذوع سميحة % يمطو الجديل ، وسرطمان شعشع % PageV01P354 11(@)(@@) % وتثير مظهرة وقد وقد الحصى % % شاة الكناس إذا اسمأل التبع % 12(@)(@@) % و ترى الحصى زجلا يطير نفيه % قبض المناسم والحصى يتصعصع % % 13(@)(@@) % و العيس تعتصر الهواجر بدنها % % عصر الصنوبر كل غر ينبع % 14(@)(@@) % سرنا من الأدمى ورمل مخفق % نرجو الحيا وجناب غيث يربع % 15(@)(@@) % كم قد تتابع منكم من أنعم % و المحل يذهب أن تعود الأمرع % % 16(@)(@@) % أثبتم زلل المراقي بعدما % % كادت قوى 
ms102	 سبب الحبال تقطع % 17(@)(@@) % أشكو إليك ، فأشكني ، ذرية % لا يشبعون ، وأمهم لا تشبع % 18(@)(@@) % كثروا على فما يموت كبيرهم % حتى الحساب ولا الصغير المرضع % 19(@)(@@) % و غذا نظرت يربيني من أمهم % عين مهججة ، وخذ أسفع % 20(@)(@@) % وإذا تقسمت العيال غبوقها ، % كثر الأنين وفاض منها المدمع % PageV01P355 21(@)(@@) % رشني فقد دخلت علي خصاصة % مما جمعت وكل خير تجمع % PageV01P356 البحر : بسيط تام 1(@)(@@) % أواصل أنت أم العمر أم تدع % أم تقطع الحبل منهم مثل ما قطعوا % % 2(@)(@@) % تمت جمالا ودينا ليس يقربها % % قس النصارى ولا من همها البيع % 3(@)(@@) % من زائر زار لم ترجع تحيته ، % ماذا الذي ضرهم لو أنهم رجعوا % % 4(@)(@@) % حلأت ذا غلة ، هيمان عن شرع ، % لو شئت روى غليل الهائم الشرع % % 5(@)(@@) % ما ردكم ذا لبانات بحاجته % قد فات يومئذ من نفسه قطع % 6(@)(@@) % بل حاجة لك في الحي الذين غدوا % % مروا على السرذي الأغيال فاجتزعوا % % 7(@)(@@) % حلوا الأجارع من نجد وما نزلوا % % أرضا بها ينبت النيتون والسلع % 8(@)(@@) % باعدت الوصل إلا أن يجر لنا % % حبل الشموس فلا يأس ولا طمع % % 9(@)(@@) % لا لوم إذ لج في منع أقاربها % % إن الفؤاد مع الشيء الذي منعوا % % 10(@)(@@) % ماذا تذكر وصل لم يكن صددا % أم ما زيارة ركب قلما هجعوا % % PageV01P357 11(@)(@@) % قربت وجناء لم يعقد حوالبها % % طي الصدار ولم يرشح لها ربع % 12(@)(@@) % كأنها قارح طارت عقيقته % يرعى السماوة أو طاو به سفع % % 13(@)(@@) % كان الذين هجوني من ضلالتهم % مثل الفراش وحر النار إذ يقع % 14(@)(@@) % أصبحت عند ولاة الناس أثبتهم % فلجا وأبعدهم غلوا إذا نزعوا % % 15(@)(@@) % لولا الخليفة والقرآن يقرأه % ما قام للناس أحكام ولا جمع % 16(@)(@@) % أنت الأمين ، أمين الله ، لا سرف % فيما وليت ، ولا هيابة ورع % 17(@)(@@) % مثل المهند لم تبهر ضريبته % لم يغش غربيه تفليل ولا طبع % 18(@)(@@) % وارى الزناد من الأعياص في مهل % فالعالمون ، لما يقضي به ، تبع % 19(@)(@@) % ما عد قوم باحسان صنيعهم % إلا صنيعكم فوق الذي صنعوا % % 20(@)(@@) % أنت المبارك يهدي الله شيعته ، % إذا تفرقت 
ms103	 الأهواء والشيع % PageV01P358 21(@)(@@) % فكل أمر على يمن أمرت به ، % فينا مطاع ومهما قلت مسستمع % 22(@)(@@) % أدليت دلوي في الفراط فاغترفت ، % في الماء فضل وفي الأعطان متسع % 23(@)(@@) % إني سيأتيكم ، والدار نازحة ، % شكري وحسن ثناء الوفد إن رجعوا % % 24(@)(@@) % يا آل مروان ! إن الله فضلكم % فضلا عظيما على من دينه البدع % 25(@)(@@) % الجامعين ، إذا ما عد سعيهم ، % جمع الكرام ولا يوعون ما جمعوا % % 26(@)(@@) % تلقى الرجال إذا ما خيف صولته % يمشون هونا وفي أعناقهم خضع % 27(@)(@@) % فان عفوت فضلت الناس عافية % و إن وقعت فما وقع كما تقع % 28(@)(@@) % ما كان ددونك من مقصى لحاجتنا ؛ % و لا وراءك للحاجات مطلع % 29(@)(@@) % إن البرية ترضى ما رضيت لها % % إن سرت ساروا وإن قلت اربعوا ربعوا % % PageV01P359 البحر : طويل 1(@)(@@) % أبا العوف إن الشول ينقع رسلها % % ولكن دم الثأر النميري أنقع % 2(@)(@@) % تبكي على سلمى إذا الحي أصعدوا % % و تترك ريان القتيل المضيعا % % 3(@)(@@) % إذا صب ما في القعب فاعلم بأنه % دم الشيخ فاشرب من دم الشيخ أو دعا % % PageV01P360 البحر : طويل 1(@)(@@) % أتجعل يا بن القين أولاد دارم % كشيبان شلت من يديك الأصابع % 2(@)(@@) % وأين محل المجد إلا عليهم ؛ % و أين الندى إلا لهم والدسائع % 3(@)(@@) % فما رحلت شيبان إلا رأيتها % % إماما وإلا سائر الناس تابع % 4(@)(@@) % لهم يوم ذي قار أناخوا فضاربوا % % كتائب كسرى حين طار الوشائع % 5(@)(@@) % و ما راح فيها يشكري لا غذا % % لذهل وتيم الله رأس مشايع % PageV01P361 البحر : طويل 1(@)(@@) % متى ما التوى بالظاعنين نزيع ، % فللعين غرب والفؤاد صدوع % 2(@)(@@) % وليس زمان بالكميتين راجعا ؛ % وليس إلى ذاك الزمان رجوع % 3(@)(@@) % و قالوا له لا يولعن بك الهوى % % بلى إن هذا فاعلن ولوع % 4(@)(@@) % ليالي لا سري لديهن شائع ؛ % ولا أنا للمستودعات مضيع % 5(@)(@@) % أبا مالك لا بد أني قارع % لعظمك إني للعظام قروع % 6(@)(@@) % أتغضب لما ضيع القين عرضه ، % و أنت لأم دون ذاك مضيع % 7(@)(@@) % أصاب قرار اللؤم في بطن أمه ، % وراضع ثدي اللؤم فهو رضيع % PageV01P362 البحر : طويل 1 
ms104	(@)(@@) % إذا كنت بالوعساء من كفه الغضا % % لقيت أسيديا بها غير أروعا % % 2(@)(@@) % سريعا ، إذا قيل الغداء ، ازدلافه ، % بطيئا إذا داعي الصباح تشنعا % PageV01P363 البحر : بسيط تام 1(@)(@@) % قد كان في مائتي شاق تعزبها % % شبع لضيفك يا خنابة الضبع % 2(@)(@@) % ما المستنير منيرا حين تطرقه % و لا بطاهر بين الصلب والزمع % PageV01P364 البحر : وافر تام 1(@)(@@) % جزيت الطيبات أخا لقوم % أخا يا عرو كنت لهم جماعا % 2(@)(@@) % وثغر قد شهدت فلم تضعه ، % و لولا ما شهدت لكان ضاعا % % 3(@)(@@) % وكم من مأزق جليت عنه % إذا كان الرجال به رعاعا % % 4(@)(@@) % تخيرت المنايا يوم زارت % نواصينا تقمعهاانقمعها % % PageV01P365 البحر : طويل 1(@)(@@) % أكلفت تصعيد الحدوج الروافع % كأن خبالي بعد برء مراجعي % % 2(@)(@@) % قفا نعرف الربعين بين مليحة % و برقة سلمانين ذات الأجارع % 3(@)(@@) % سقى الغيث سلمانين والبرق العلا % % إلى كل واد من مليحة دافع % 4(@)(@@) % أرجعت من عرفان ربع كأنه % بقية وشم في متون الأشاجع % 5(@)(@@) % متى أنت مهتاج بحلمك بعدما % % وصلت به حبل القرين المنازع % 6(@)(@@) % إذا ما رجا الظمآن ورد شريعة % ضربن حبال الموت دون الشرائع % 7(@)(@@) % إذا قلن ليست للرجال أمانة % و فينا فلم ننقض عهود الودائع % 8(@)(@@) % سقين البشام المسك ثم رشفنه % رشيف الغريريات ماء الوقائع % 9(@)(@@) % لقد هاج هذا الشوق عينا مريضة ، % و نوح الحمام الصادحات السواج % 10(@)(@@) % فذكرن ذا الإعوال والشوق ذكره % % فهيجن ما بين الحشا والأضالع % PageV01P366 11(@)(@@) % ألم تك قد خبرت إن شطت النوى % % بأنك يوما غدها غير جازع % 12(@)(@@) % فلما استقلوا كدت تهلك حسرة % وراعتك إحدى المفظعات الروائع % 13(@)(@@) % سمت بي من شيبان أم نزيعة % كذلك ضرب المنجيات النزائع % 14(@)(@@) % فلما سقيت السم خنزير تغلب % أبا مالك جدعت قين الصعاصع % 15(@)(@@) % رميت ذوي الأضغان حتى تناذروا % % حماي وألقى قوسه كل نازع % 16(@)(@@) % فإني بكي الناظرين كليهما % % طبيب وأشفى من نسا المنظالع % 17(@)(@@) % إذا ما استضافتني الهموم قريتها % % زماعي وليل الذاملات الهوابع % % 18(@)(@@) % حراجيج يعلفن الذميل كأنها % % معاطف نبع أو حني الشراجع % 19(@)(@@) % إذا بلغ الله الخليفة لم تبل 
ms105	 % سقاط الرزايا من حسير وظالع % 20(@)(@@) % سمونا إلى بحر البحور ولم نسر % إلى ثمد من معرض العين قاطع % PageV01P367 21(@)(@@) % تؤم عظام الجم ، عادية الجبا ، % على الطرق المستوردات المهايع % 22(@)(@@) % فلما التقى وفدا معد عرضتهم % % بسجلين من آذيك المتدافع % 23(@)(@@) % و أنت ابن أعياص في متمنع % مقايسة طالت مداد المذارع % 24(@)(@@) % فلما تسربلت الخلافة أقبلت % عليك بأبواب الأمور الجوامع % 25(@)(@@) % تبحج هذا الملك في مسقره % فليس إلى قوم سواكم براجع % 26(@)(@@) % و ضاربتم حتى شفيتم من العمى % % قلوبا وحتى جاز نقش الطوابع % 27(@)(@@) % فقد سرني أن لا يزال يزيدكم % يسير بأمر الأمة المتتابع % 28(@)(@@) % أتتك قريش لاجئين وغيرهم % إلى كل دفء من جناحك واسع % 29(@)(@@) % ويرجو أمير المؤمنين وسيبه % مراضيع مثل الريش سفع المدامع % PageV01P368 البحر : طويل 1(@)(@@) % أعاذل ما بالي أرى الحي ودعوا % % وباتوا على طياتهم فتصدعوا % % 2(@)(@@) % إذا ذكرت شعثاء طار فؤاده % لطير الهوى وارفضت العين تدمع % 3(@)(@@) % تمنى هواها من تعلل باطل ، % و تعرض حاجات المحب فتمنع % % 4(@)(@@) % ولو أنها شاءت لقد بذلت له % شرابا به يروى الغليل وينقع % 5(@)(@@) % و شعث على خوص دقاق كأنها % % قسي من الشريان تبرى وترقع % 6(@)(@@) % إذا رفعوا طي الخباء رأيته % كضارب طير في الحبالة يلمع % 7(@)(@@) % ترى القوم فيه ممسكين بجانب % وللريح منه جانب يتزعزع % 8(@)(@@) % ألا يا لقوم لا تهدكم مجاشع % فأصلب منها خيزران وخروع % 9(@)(@@) % فهم ضيعوا الجار الكريم ، ولا أرى % % كحرمة ذاك الجار جارا يضيع % 10(@)(@@) % تقول قريش بعد عدر مجاشع % لحى الله جيران الزبير ورجعوا % % PageV01P369 11(@)(@@) % فلو أن يربوعا دعى إذ دعاهم % لآب جميعا رحله المتمزع % 12(@)(@@) % فأدوا حواري الرسول ورحله % إلى أهله ثم افخروا بعد أو دعوا % % 13(@)(@@) % ألم تر بيت اللؤم بين مجاشع % مقيما إلى أن يمضي الدهر أجمع % 14(@)(@@) % علونا كما تعلو النجوم عليهم % وقصر حتى ما لكفيه مدفع % 15(@)(@@) % فان تسألوا حي نزار تنبئوا % % إذا الحرب شالت من يضرو وينفع % 16(@)(@@) % وإنا لنكفي الخور لو يشكروننا % % ثنايا المنايا ، والقنا يتزعزع % 17(@)(@@) % نحل على الثغر 
ms106	 المخوف وأنتم % سراب على قيقاءة يتربع % 21(@)(@@) % وتفيك عمر و عن حماها وعامر % فما لك إلا عند كيرك مطبع % PageV01P370 البحر : طويل 1(@)(@@) % سيخزى إذا ضنت حلائب مالك % ثوير ويخزى عاصم وجميع % 2(@)(@@) % فقبلك ما أعيا الرماة إذا رموا % % صفا ليس في عاديهن صدوع % 4(@)(@@) % لقد نفحت منك الوريدين علجة % خبيثة ريح المنخزين قبوع % 5(@)(@@) % فلا تدنيا رحل الدلهمس إنه % بصير بما يأتي اللئام سميع % % 6(@)(@@) % هو النخبة الخوارما دون قلبه % حجاب وما فوق الحجاب ضلوع % 7(@)(@@) % فلو أنجبت أم الدلهمس لم يعب % فوارسنا لا عاش وهو جميع % 9(@)(@@) % اصاب قرار اللؤم في بطن أمه % وراضع ثدي اللؤم فهو رضيع % PageV01P371 البحر : طويل 1(@)(@@) % يزين أيام ابن أروى فعاله % و عادي مجد في أشم رفيع % 2(@)(@@) % دعوت امرأ يا ضب غير مواكل % فلا تكفرونا بعد يوم ربيع % PageV01P372 البحر : طويل 1(@)(@@) % وإن امرأ جدا أبيه وأمه % % عتيبة والقعقاع ، غير وضيع % PageV01P373 البحر : طويل 1(@)(@@) % باع أباه المستنير وأمه % بأشخاب عنز بئس ربح المبايع % % 2(@)(@@) % تعرضت لي من دون برزة وابنها ، % ألؤم ابن لؤم يا دعي البلاتع % % 5(@)(@@) % نهيت بنات المستنير عن الرقى % % وعن مشهين الليل بين المزارع % 6(@)(@@) % و ما مستنير الخبث إلا فراشة % هوت بين مؤتج الحريقين ساطع % % PageV01P374 البحر : وافر تام 1(@)(@@) % ذكرت ثرى نواظر والخزامى % فكاد القلب ينصدع انصداعا % % 2(@)(@@) % الام على الصابة والمهاري % % تحن إذا تذكرت النزاعا % % 3(@)(@@) % رأين تغ يري فذعرن منه ، % كذعر الفارس البقر الرتاعا % % 4(@)(@@) % كأن الرجل فوق قرا جفول % أقام الماتحان له الشراعا % % 5(@)(@@) % ذكرت ، إذا نظرت إلى يديها ، % يدي عسراء شمرت القناعا % % 6(@)(@@) % سما عبد العزيز إلى المعالي ، % وفات العالمين ندى وباعا % % 7(@)(@@) % ألست ابن الأئمة من قريش % و أرحبها بمكرمة ذراعا % % 8(@)(@@) % فقد أوصى الوليد أخا حفاظ % فما نسي الوصاة ولا أضاعا % % 9(@)(@@) % إذا جد الرحيل بنا فرحنا % % فنسأل ذا الجلال بك المتاعا % % PageV01P375 البحر : طويل 1(@)(@@) % ذكرت وصال البيض والشيب شائع ، % ودار الصبا من عهدهن بلاقع % 2(@)(@@) % أشت عماد البين واختلف الهوى % % ليقطع ما بين 
ms107	 الفريقين قاطع % 3(@)(@@) % لعلك يوما أن يساعفك الهوى % % فيجمع شعبي طية لك جامع % 4(@)(@@) % أخالد ! ما من حاجة تنبري لنا % % بذكراك إلا ارفض مني المدامع % 5(@)(@@) % وأقرضت ليلى الود ثمت لم ترد % لتجزي قرضي ، والقروض ودائع % 6(@)(@@) % سمت لك منها حاجة بين ثهمد % ومذعى وأعناق المطي خواضع % 7(@)(@@) % يسمن كما سام المنيحان أقدحا % نحاهن من شيبان سمح مخالع % 8(@)(@@) % فهلا أتقيت الله إذ رعت محرما % سرى ثم ألقى رحله فهو هاجع % 9(@)(@@) % و من دونه تيه كأن شخاصها % % يحلن بأمثال فهن شوافع % 10(@)(@@) % تحن قلوصي بعد هدء وهاجها % % وميض على ذات السلاسل لامع % PageV01P376 11(@)(@@) % فقلت لها حنى رويدا فانني % % إلى أهل نجد من تهامة نازع % 12(@)(@@) % تغيض ذفراها بجون ، كأنه % كحيل جرى في قنفذ الليث نابع % 13(@)(@@) % ألا حييا الأعراف من منبت الغضا % % وحيث حبا حول الصريف الأجارع % 14(@)(@@) % سلمت وجادتك الغيوث الروابع % فإنك واد ، للأحبة ، جامع % 15(@)(@@) % فلم أر يا بن القرم كاليوم منظرا % تجاوزه ذو حاجة وهو طائع % 16(@)(@@) % أتنسين ما نسري لحب لقائكم % وتهجيرنا والبيد غبر خواشع % 17(@)(@@) % بني القين لاقيتم شجاعا بهضبة % ربيب حبال تتقيه الأشاجع % 18(@)(@@) % فإنك قين وابن قينين ، فاصطبر % لذلك إذ سدت عليك المطالع % 19(@)(@@) % ولما رأيت الناس هرت كلابهم ، % تشيعت ، إذ لم يحم إلا المشايع % 20(@)(@@) % و جهزت في الآفاق كل قصيدة % شرود ، ورود ، كل ركب تنازع % PageV01P377 21(@)(@@) % يجزن إلى نجران من كان دونه ، % ويظهرن في نجد وهن صوادع % 22(@)(@@) % تعرض أمثال القوافي ، كأنها % % نجائب تعلو مربدا فتطالع % 23(@)(@@) % أجئتم تبغون العرام فعندنا % % عرام لمن يبغي العرامة واسع % 24(@)(@@) % تشمس يربوع ورائي بالقنا % % وعادتنا الإقدام ، يوم نقارع % 25(@)(@@) % لنا جبل صعب عليه مهابة % منيع الذرى في الخندفيين فارع % 26(@)(@@) % و في الحي يربوع إذا ما تشمسوا % % وفي الهندوانيات للضيم مانع % 27(@)(@@) % لنا في بني سعد جبال حصينة % و منقذ في باحة العز واسع % % 28(@)(@@) % و تبذخ من سعد قروم بمفزع % بهم عند أبواب الملوك ندافع % 29(@)(@@) % لسعد ذرى عادية يهتدي بها % % ودرء 
ms108	 على من يبتغي الدرء ضالع % 30(@)(@@) % وإن حمى لم يحمه غير فرتنى ، % و غير ابن ذي الكيرين خزيان ضائع % PageV01P378 31(@)(@@) % رأت مالك نبل الفرزدق قصرت % عن المجد ، إذ لا يأتلي الغلو نازع % 32(@)(@@) % تعرض حتى أثبتت بين خطمه % وبين مخط الحاجبين القوارع % 33(@)(@@) % أرى الشيب في وجه الفرزدق قد علا % % لهازم قرد ، رنحته الصواقع % 34(@)(@@) % و أنت ابن قين يا فرزدق فازدهر % بكيرك ، إن الكير للقين نافع % 35(@)(@@) % فإنك إن تنفخ بكيرك تلقنا % % نعد القنا والخيل ، يوم نقارع % 36(@)(@@) % إذا مد غلو الجري طاح ابن فرتنى % % و جد التجاري فالفرزدق ظالع % 37(@)(@@) % و أبا بنو سعد فلو قلت أنصتوا % % لتنشد فيهم ، حز أنفك جادع % 38(@)(@@) % رأيتك ، إذ لم يغنك الله بالغنى ، % لجأت إلى قيس وخدك ضارع % 40(@)(@@) % وقد كان في يوم الحواري جاركم % وذخر له في الجنبتين قعاقع % 41(@)(@@) % يقول لليلى قين صعصعة اشفعي % % وفيما وراء الكير للقين شافع % PageV01P379 44(@)(@@) % إذا أسفرت يوما نساء مجاشع % بدت سوءة مما تجن البراقع % 45(@)(@@) % مناخر شانتها القيون ، كأنها % % أنوف خنازير السواد القوابع % 46(@)(@@) % مباشيم عن غب الخزيز كأنما % % تصوت في أعفاجهن الضفادع % 47(@)(@@) % و قد قوست أم البعيث وأكرهت % على الزفر حتى شنجتها الأخادع % % 49(@)(@@) % لقد علمت ، غير الفياش ، مجاشع % إلى من تصير الخافقات اللوامع % 50(@)(@@) % لنا بانيا مجد ، فبان لنا العلى ، % و حام إذا احمر القنا والأشاجع % 51(@)(@@) % أتعدل أحسابا كراما حماتها % % بأحسابكم ؟ إني إلى الله راجع % 52(@)(@@) % لقومي أحمى في الحقيقة منكم % و أضرب للجبار والنقع ساطع % % 53(@)(@@) % وأوثق عند المردفات ، عشية ، % لحاقا إذا ما جرد السيف لامع % 54(@)(@@) % و أمنع جيرانا وأحمد في القرى % % إذا اغبر في المحل النجوم الطوالع % PageV01P380 55(@)(@@) % وسمام بدهم غير منتقض القوى % % رئيس سلبنا بزه ، وهو دارع % 56(@)(@@) % ندسنا أبا مندوسة القين بالقنا % % ومار دم من جار بيبة ناقع % 57(@)(@@) % ونحن نفرنا حاجبا مجد قومه % و ما نال عمرو مجدنا والأقارع % 58(@)(@@) % ونحن صدعنا هامة ابن محرق % فما رقات تلك العيون الدوامع % 59(@)(@@) % وما بات قوم 
ms109	 ضامنين لنا دما ، % فتوفينا إلا دماء شوافع % 60(@)(@@) % بمرهفة بيض إذا هي جردت % تألق فيهن المنايا اللوامع % 61(@)(@@) % لقد كان يا أولاد خجخح فيكم % محول رحل للزبير ومانع % 62(@)(@@) % و قد كاد في يوم الحواري جاركم % أحاديث صمت من نثاها المسامع % 63(@)(@@) % و بتم تعشون الخزير كأنكم % مطلقة حينا ة و حينا تراجع % 64(@)(@@) % يقبح جبريل وجوه مجاشع % وتنعى الحواري النجوم الطوالع % PageV01P381 65(@)(@@) % إذا قيل أي الناس شر قبيلة % و أعظم عارا قيل تلك مجاشع % 67(@)(@@) % فأصبح عوف في السلاح وأصبحت % تفش جشاءلت الخزير مجاشع % 69(@)(@@) % ندمت على يوم السباقين بعدما % % وهيت فلم يوجد لوهيك راقع % 70(@)(@@) % فما أنتم بالقوم يوم افتديتم % به عنوة ، ، والسمهري شوارع % PageV01P382 البحر : طويل 1(@)(@@) % ألا أيها القلب الطروب المكلف % أفق ربما ينأى هواك ويسعف % 2(@)(@@) % ظللت وقد خبرت أن لست جازعا % لربع بسلمانين عينك تذرف % 3(@)(@@) % و تزعم أن البين لا يشعف الفتى % % بلى ! مثل بيني يوم لبنان يشعف % 4(@)(@@) % وطال حذاري غربة البين والنوى % % و أحدوثة من كاشح يتقوف % 5(@)(@@) % و لة علمت علمي أمامة كذبت % مقالة من ينعى علي ، ويعنف % 6(@)(@@) % بأهلي أهل الدار إذ يسكونها % % و جادك من دار ربيع وصيف % % 7(@)(@@) % سمعت الحمام الورق في رونق الضحى % % بذي السدر من وادي المراضين تهتف % 8(@)(@@) % نظرت ورائي نظرة قادها الهوى % % وألحي المهارى يوم عسفان ترجف % 9(@)(@@) % ترى العرمس الوجناء يدمى أظلها ، % و تحذي نعالا والمناسم رعف % 10(@)(@@) % مددنا لذات البغي حتى تقطعت % أزابيها والشدقمي المعلف % PageV01P383 11(@)(@@) % ضرحن حصى المعزاء حتى عيونها % % مهججة أبصارهن ، وذرف % 12(@)(@@) % كأن ديارا بين أسنمة النقا % % و بين هذاليل النحيزة مصحف % 13(@)(@@) % فلست بناس ما تغنت حمامة % ولا ما ثوى بين الجناحين زفزف % 14(@)(@@) % ديارا من الحي الذين نحبهم % فما للمخازي عن قفيرة مصرف % 15(@)(@@) % هم الحي يربوع تعادى جيادهم % على الثغر والكافون ما يتخوف % 16(@)(@@) % عليهم من الماذي كل مفاضة % دلاص لهاذيل حصين ورفرف % 17(@)(@@) % ولا يستوي عقر الكزوم بصوأر ، % وذو التاج تحت الراية المتسيف % 18(@)(@@) % و 
ms110	 مولى تميم حين يأوى إليهم % و إن كان فيهم ثروة العز منصف % 19(@)(@@) % بني مالك جاء القيون بمقرف % إلى سابق يجري ولا يتكلف % 20(@)(@@) % و ما شهدت يوم الاياد مجاشع % و ذا نجب يوم الأسنهة ترعف % PageV01P384 21(@)(@@) % فوارسنا الحواط السرح دونهم % % 22(@)(@@) % لقد مد للقين الرهان فرده ، % عن المجد ، عرق من قفيرة مقرف % 23(@)(@@) % لحى الله من ينبو الحسام بكفه % و من يلج الماخور في الحجل يرسف % 24(@)(@@) % ترفقت بالكيرين قين مجاشع ، % و أنت بهز المشرفية أعنف % 25(@)(@@) % و تنكر هز المشرفي يمينه % ويعرف كفيه الإناء المكتف % 26(@)(@@) % ولو كنت منا يا ابن شعرة ما نبا % % بكفيك مصقول الحديدة مرهف % 27(@)(@@) % عرفتم لنا العز السوابق قبلكم % وكان لقينيك السكيت المخلف % 28(@)(@@) % أنا ابن سعد وعمرو ومالك ، % و دفك من نفاخة الكير أجنف % 29(@)(@@) % ألم تر أن الله أخزى مجاشعا % إذا ضم أفواج الحجيج المعرف % 30(@)(@@) % ويوم منى نادت قريش بغدرهم ، % ويوم الهدايا في المشاعر عكف % PageV01P385 31(@)(@@) % و يبغض ستر البيت آل مجاشع % و حجابه والعابد المتطوف % 32(@)(@@) % و كان حديث الركب غدر مجاشع % إذا انحدروا من نخلتين وأوجفوا % % 33(@)(@@) % و إن الحواري الذي غر حبلكم % له البدر كاب والكواكب كسف % 34(@)(@@) % و لو في بني سعد نزلت لما عصت % عواند في جوف الحواري نزف % 35(@)(@@) % % نسورا رأت أوصاله فهي عكف % 36(@)(@@) % فلست بواف بالزبير ورحله % ولا أنت بالسيدان بالحق تنصف % 37(@)(@@) % بنو منقر جروا فتاة مجاشع % و شد ابن ذيال وخيلك وقف % 40(@)(@@) % فباتت تنادي غالبا ، وكأنها % % على الرضف من جمر الكوانين ترضف % 46(@)(@@) % % وإني لتبتز الملوك فوارسي ، % 50(@)(@@) % و هم كلفوها الرمل رمل معبر % تقول : أهذا مشي حرد تلقف % PageV01P386 52(@)(@@) % و إني لبتز الملوك فوارسي % % إذا غرهم ذو المرجل المتجخف % 53(@)(@@) % ألم تر تيم كيف يرمي مجاشعا % شديد حبال المنجنيقين مقذف % 54(@)(@@) % عجبت لصهر ساقكم آل درهم ، % إلى صهر أقوام يلام ويصلف % 55(@)(@@) % لئيمان هذي يدعيها ابن درهم % و هذا ابن قين جلده يتوسف % 56(@)(@@) % وحالفتم للؤم ، يا آل 
ms111	 درهم ، % حلاف النصارى دين من يتحنف % % 58(@)(@@) % أتمدح سعدا حين أخزت مجاشعا % عقيرة سعد والخباء مكشف % 59(@)(@@) % نفاك حجيج البيت عن كل مشعر % كما رد ذو النميتين المزيف % 60(@)(@@) % وما زلت موقوفا على باب سوءة % و أنت بدار المخزيات موقف % 61(@)(@@) % ألؤما و إقرارا على كل سوءة % فما للخازي عن قفيرة مصرف % % 62(@)(@@) % ألم تر أن النبع يصلب عوده % ولا يستوي ، والخروع المتقصف % PageV01P387 63(@)(@@) % وما يحمد الأضياف رفد مجاشع % إذا روحت حنانة الريح حرجف % 64(@)(@@) % إذا الشول راحت والقريع أمامها % % و هن ئيلات العرائك شسف % % 66(@)(@@) % و قائلة ما للفرزد لا يرى % % على السن يستغني ، ولا يتعفف % 67(@)(@@) % يقولون : كلا ليس للقين غالب ، % بلى إن ضرب القين بالقين يعرف % 69(@)(@@) % أخو اللؤم ما دام الغضا حول عجلز % وما دام يسقى في رمادان أحقف % 70(@)(@@) % إذا ذقت مني طعم حرب مريرة % عطفت عليك الحرب والحرب تعطف % 71(@)(@@) % تروغ ، وقد أخزوك في كل موطن ، % كما راغ قرد الحرة المتخذف % 72(@)(@@) % أتعدل كفها لا ترام حصونه % بهار المراقي جوله يتقصف % % 73(@)(@@) % تحوط تميم من يحوط حماهم % ويحمي تميما من له ذاك يعرف % 74(@)(@@) % أنا ابن أبي سعد وعمرو ومالك % أنا ابن صميم لا وشيظ تحلفوا % % PageV01P388 75(@)(@@) % إذا خطرت عمرو وورائي وأصبحت % قروم بني بدر تسامى وتصرف % % 76(@)(@@) % و لم أنس من سعد بقصوان مشهدا % وبالأدمى ما دامت العين تطرف % 77(@)(@@) % و سعد اذا صاح العدو بسرحهم % أبوا أن يهدوا للصياح فأزحفوا % % 78(@)(@@) % دياربني سعد ، ولا سعد بعدهم ، % عفت غير أنقاء بيبرين تعزف % % 79(@)(@@) % إذا نزلت أسلاف سعد بلادها ، % وأثقال سعد ، ظلت الأرض ترجف % PageV01P389 البحر : وافر تام 1(@)(@@) % إذا أولى النجوم بدت فغارت ، % و قلت أني من الليل انتصاف % % 2(@)(@@) % حسبت النوم طار مع الثريا % % و ما غلظ الفراش ولا اللحاف % 3(@)(@@) % أبا حفص ! مخافة كل ظلم % عليك ، وكيف يهجع من يخاف % 4(@)(@@) % وأدعو الله فيك ، وأن يجلي % % عماية ما يزايلها انكشاف % 5(@)(@@) % وأن يجدوك إذ هزوك صلتا ، % عفيفا من سجيتك العفاف % % PageV01P390 البحر : رجز 
ms112	 تام 1(@)(@@) % تقول ذات المطرف الهفهاف % والردف والأنامل اللطاف % 2(@)(@@) % إنك من ذي غزل لجافي % % تقول ذات الهفهاف % 3(@)(@@) % و أنت لا تورد بالأجواف % غير ثماني أينق عجاف % 4(@)(@@) % بقيا من الغدة والسوافي ، % عوج ظماء نظر الشتاف % 5(@)(@@) % فاروي من الماء ، ولا تعافي ، % علك إن أوديت في اصطرافي % % 6(@)(@@) % تلقين في البغية والتطواف % مثل أبي هوذة أو عطاف % 7(@)(@@) % لزن المحيا ضيق الأكناف ، % يدنو وتنأين بلب جاف % % 8(@)(@@) % شم العلوق جلد العطاف % % PageV01P391 البحر : وافر تام 1(@)(@@) % سنخبر أهلنا بقرى حماس % ونخبر ما فعلت أبا خفاف % 2(@)(@@) % تعذر للنزيل وكان عرق % لنا في ابني نميرة غير جاف % PageV01P392 البحر : طويل 1(@)(@@) % طربت وما هذا الصبا والتكالف % و هل للهوى إذراعه الين صارف % 2(@)(@@) % طربت بأبراد وذكرك الهوى % % عراقية ذكر لقلبك شاعف % 3(@)(@@) % تعل ذكي المسك وحفا ، كأنه % عناقيد ميل لم ينلهن قاطف % 4(@)(@@) % و أحذر يوم البين أن يعرف الهوى % % و تبدي الذي تخفي العيون الذوارف % 5(@)(@@) % إذا قيل هذا البين راجعت عبرة % لها بجربان البنيقة واكف % 6(@)(@@) % يقول بنعف الأخربية صاحبي : % متى يرعوي غرب النوى المتقاذف % 7(@)(@@) % وإني وإن كانت إلى الشام نيتي ، % يماني الهوى أهل المجازة آلف % 8(@)(@@) % و إن الذي بلغت رقاه نسوة % نمتك إلى العليا فوارس داحس % 9(@)(@@) % وترمى فتشويها الرماة وقتلت % قلوبا بنبل لم تشنها المراصف % 10(@)(@@) % صرمت اللواتي كن يقتدن ذا الهوى % % شبيه بهن الربرب المتآلف % PageV01P393 11(@)(@@) % طلبنا أمير المؤمنين ، ودونه % تنائف غبر واصلتها تنائف % % 12(@)(@@) % بمائرة الأعضاد أما لشدقم % واما بنات الداعري العلائف % 13(@)(@@) % يخذن بنا وخدا وقد خضب الحصى % % مناسم أيدي اليعملات الرواعف % 14(@)(@@) % بلغنا أمير المؤمنين ولم يزل % على علة فيهن رحل ورادف % 15(@)(@@) % ويرجوك من لم تستطعك ركابه ، % ويرجوك ذو حق ببابك ضائف % 16(@)(@@) % و إني لنعماك التي قد تظاهرت % و فضلك يا خر البرية عارف % 17(@)(@@) % فلا الجهد ما عاش الخليفة مرهقي ، % ولا أنا لي عند الخليفة كاسف % 18(@)(@@) % إذا قيل شكوى بالامام تصدعت % عليه من الخوف القلوب الرواجف % 19(@)(@@) % أتانا 
ms113	 حديث كان لا صبر بعده % أتت كل حي قبل ذاك المتالف % 20(@)(@@) % فلما دعونا للخليفة ربنا ، % وكان الحيا تزجى إليه الضعائف % PageV01P394 21(@)(@@) % أتتنا لك البشرى فقرت عيوننا ، % ودارت على أهل النفاق المخاوف % 22(@)(@@) % فأنت لرب العالمين خليفة ، % و لي لعهد الله بالحق عارف % 23(@)(@@) % هداك الذي يهدي الخلائف للتقى % % و اعطيت نصرا لم تنله الخلائف % 24(@)(@@) % و أدت اليك الهند ما في حصونها % % و من أرض صين استان تجبي الطرائف % 25(@)(@@) % و أرض هرقل قد قهرت و داهرا % و تسعى لكم من آل كسرى النواصف % 26(@)(@@) % و ذلك من فضل الذي جمعت له % صفوف المصلى والهدي العواكف % % 27(@)(@@) % ونازعت أقواما فلما قهرتهم ، % و أعطيت نصرا عا منك العواطف % 28(@)(@@) % لقد وجدوا منكم حبالا متينة % فذلوا و لانت للقياد السوالف % 29(@)(@@) % و أنت ابن عيص الأبطحين وتنتمي % % لفرع صميم لم تنله الزعانف % 30(@)(@@) % % وصيد مناف المقرمات المطارف % PageV01P395 31(@)(@@) % له باذخات من لؤي بن غالب % يقصر عنها المدعي والمخالف % 32(@)(@@) % نجيب أريب كان جدك منجبا % و أدت اليك المنجيات العفائف % % 33(@)(@@) % وما زال من آل الوليد مذبب ، % أخو ثقة عن كل ثغر يفاذف % PageV01P396 البحر : بسيط تام 1(@)(@@) % انظر خليلي بأعلا ثرمداء ضحى % و العيس جائلة أغراضها خنف % % 2(@)(@@) % استقبل الحي بطن السرأم عسفوا % % فالقلب فيهم رهين أين ما انصرفوا % % 3(@)(@@) % من نحو كابة تحتث الحداة بهم % كي يشعفوا آلفا صبا ، فقد شعفوا % % 4(@)(@@) % إن الزيارة لا ترجى ودونهم % جهم المحيا وفي أشباله غضف % 5(@)(@@) % آلوا عليها يمينا ، لا تكلمنا ، % من غير سوء ، ولا من ريبة حلفوا % % 6(@)(@@) % يا حبذا الخرج بين الدام فالأدمى % % فالرمث من برقة الروحان فالغرف % % 7(@)(@@) % ألمم على الربع بالترباع ، غيره % ضرب الأهاضيب والنأآجة العصف % 8(@)(@@) % كأنه بعد تحنان الرياح به ، % رق تبين فيه اللامو الألف % % 9(@)(@@) % خبر عن الحي سرا أو علانية % جادتك مدجنة في عينها وطف % 10(@)(@@) % ما استوصف الناس عن شأ يروقهم % إلا أرى أم عمرو فوق ما وصفوا % % PageV01P397 11(@)(@@) % كأنها مزنة غراء ، واضحة ، % أو درة 
ms114	 لا يواري ضوءها الصدف % % 12(@)(@@) % مكسوة البدن في لب يزينها % % وفي المناصب من أنيابها عجف % 13(@)(@@) % تسقى اميتاحا ندى المسواك ريقتها % % كما تضمن ماء المزنة الرصف % 14(@)(@@) % قال العواذل : هل تنهاك تجربة ، % أما ترى الشيب والأخدان قد دلفوا % % 15(@)(@@) % أما تلم على ربع بأسنمة % إلا لعينيك جار غربه يكف % 16(@)(@@) % يا أيها الربع قد طالت صبابتنا ، % حتى مللنا وأمسى الناس قد عزفوا % % 17(@)(@@) % قد كنت أهوى ثرى نجدو ساكنه % فالغور غورا به عسفان فالجحف % 18(@)(@@) % لما ارتحلنا ونحو الشام نيتنا ، % قالت جعادة هذي نية قذف % 19(@)(@@) % كلفت صحبي أهوالا على ثقة ، % لله درهم ركبا وما كلفوا % % 20(@)(@@) % ساروا اليك من السهبي ودونهم % فيحان فالحزن فالصمان فالوكف % PageV01P398 21(@)(@@) % يزجون نحوك أطلاحا مخدمة % قد مسها النكب والأنقاب والعجف % % 22(@)(@@) % في سير شهرين ما يطوى ثمائلها % % حتى تشد إلي اغراضها السنف % 23(@)(@@) % ما كان مذ رحلوامن أهل أسمنة % غلا الذميل لها ورد ولا علف % % 24(@)(@@) % لا ورد للقوم إن لم يعزفوا بردى % % إذا تجوب عن أعناقها السدف % 25(@)(@@) % صبحن توماء والناقوس يقرعه % قس النصارى حراجيجا بنا تجف % 26(@)(@@) % يا ابن الأروم وفي الأعياص منبتها ، % لا قادح يرتقي فيها ولا قصف % % 27(@)(@@) % إني لزائركم ودا وتكرمة ، % حتى يقارب قيد المكبر الرسف % % 28(@)(@@) % أرجو الفواصل ، إن الله فضلكم % يا قبل نفسك لاقى نفسي التلف % 29(@)(@@) % ما من جفانا إذا حاجاتنا نزلت % كمن لنا عنده التكريم واللطف % 30(@)(@@) % كم قد نزلت بكم ضيفا فتلحفني % % فضل اللحاف ونعم الفضل يلتحف % PageV01P399 31(@)(@@) % أعطوا هنيدة يحدوها ثمانية % ما في غطائهم من ولا سرف % % 32(@)(@@) % كومامها ريس مثل الهضب لو وردت % ماء الفرات لكاد البحر ينتزف % % 33(@)(@@) % جوف الحناجر والأجواف ما صدرت % عن معطن الماء إلا حوضها رشف % 34(@)(@@) % بالصيف يقمع مثلوث المزاد لها % % كأنهم من خليجي دجلة اغترفوا % % 35(@)(@@) % % على رجال وإن لم يشكر واعطف % 36(@)(@@) % يا رب قوم وقوم حاسدين لكم % ما فيهم بدل منكم ولا خلف % 37(@)(@@) % % نعم القديم إذا ما عد والسلف % 38(@)(@@) % حرب وآل أبي 
ms115	 العاصي بنوا لكم % مجدا تلادا وبعض المجد مطرف % % 39(@)(@@) % يا ابن العواتك خير العالمين أبا ، % قد كان يدفئني من ريشكم كنف % 40(@)(@@) % إن الحجيج دعوا يستمعون به % تكاد ترجف جمع كلما رجفوا % % PageV01P400 41(@)(@@) % وما ابتنى الناس من بنيان مكرمة ، % إلا لكم فوق من يبني العلا غرف % 42(@)(@@) % ضخم الدسيعة والأبيات غرته % كالبدر ليلة كاد الشهر ينتصف % 43(@)(@@) % الله أعطاك فاشكر فضل نعمته % أعطاك ملك التي ما فوقها شرف % 44(@)(@@) % هذي البرية ترضى ما رضيت لها ، % إن سرت ساروا وإن قلت اربعوا وقفوا % % 45(@)(@@) % هو الخليفة فارضوا ما قضى لكم ، % بالحق يصدع ما في قوله جنف % 46(@)(@@) % يقضي القضلء الذي يشفى النفاق به % % فاسبشتر الناس بالحق الذي عرفوا % % 47(@)(@@) % أنت المبارك والميمون سيرته ، % لولا تقوم درء الناس لاختلفوا % % 48(@)(@@) % سربلت سربال ملك غير مبتدع % قبل الثلاثين ، إن الخير مؤتنف % 49(@)(@@) % تدعو فينصر أهل الشام إنهم % قوم أطاعوا ولاة الحق وائتلفوا % % 50(@)(@@) % ما في قلوبهم نكث ولا مرض % إذا قذفت محلا خالعا قذفوا % % PageV01P401 51(@)(@@) % قد جرب الناس قبل اليوم أنهم % لا يفزعون إذا ما قعقع الحجف % 52(@)(@@) % آل المهلب جذ الله دابرهم % % أمسوا رمادا فلا أصل ولا طرف % 53(@)(@@) % قد لهفوا حين أخزى الله شيعتهم % آل المهلب من ذل وقد لهفوا % % 54(@)(@@) % ما نالت الأزد من دعوى مضلهم % إلا المعاصم والأعناق تختطف % 55(@)(@@) % و الأزد قد جعلوا المنتوف قائدهم % فقتلهم جنود الله وانتتفوا % % 56(@)(@@) % تهوي بذي العقر أقحافا جماجمها ، % كأنها الحنظل الخطبان ينتتقف % % PageV01P402 البحر : طويل 1(@)(@@) % ألا حي أهل الجوف قبل العوائق % ومن قبل روعات الحبيب المفارق % 2(@)(@@) % سقى الحاجز المحلال والباطن الذي % % يشن على القبرين صوب الغوادق % 3(@)(@@) % ولما لقينا خيل أبجر أعلنوا % % بدعوى لجيم غير ميل العواتق % 4(@)(@@) % صبرنا لهم ، والصبر منا سجية ، % بأسيافنا تحت الظلال الخووافق % 5(@)(@@) % فلما رأوا ألاهوادة بيننا % % دعوا بعد كرب يا عمير بن طارق % 6(@)(@@) % ومبد لنا ضغنا ، ولولا رماحنا % % بأرض العدى لم يرع صوب البوارق % 7(@)(@@) % عرفتم لعتاب عليكم ورهطه % ندام الملوك وافتراش النمارق 
ms116	 % 8(@)(@@) % هم الداخلون الباب لا تدخلونه % على الملك والحامون عند الحقائق % 9(@)(@@) % وأنتم كلاب النار ترمى وجوهكم % عن الخير لا تغشون باب السرادق % 11(@)(@@) % وإنا لنحميكم إذا ما تشنعت % بنا الخيل تردي من شنون وزاهق % PageV01P403 البحر : رجز تام 1(@)(@@) % لا تحسبي سبسب العراق % ونغضان القلص المناقي % % 2(@)(@@) % كأنما يرقين في مراقي % % نوم الضحى واضعة الرواق % 3(@)(@@) % هان على ذات الحشا الخفاق % ما لقيت نفسي من الاشفاق % 4(@)(@@) % و ما تلاقى قدمي وساققى % % من الحفا وعدم السواق % 5(@)(@@) % جارية من ساكني الأسواق ، % لباسة للقمص الرقاق % 6(@)(@@) % أبغض ثوبيها إليها الباقي ، % تأكل من كيس امريء وراق % 7(@)(@@) % قد وثقت إن مات بالنفاق % فهو عليها هين الفراق % 8(@)(@@) % تضحك عن ذي أشر براق % كالأقحوان اهتز في البراق % PageV01P404 البحر : رجز تام 1(@)(@@) % شبهت ، والقوم دوين العرق ، % نارا لسلمى لمعان البرق % % 2(@)(@@) % والقوم فوق يعملات شدق % إذا تبارين بسير دفق % 3(@)(@@) % تأخذ منهن الفلا ، وتبقي ، % سجية من كرم وعتق % PageV01P405 البحر : كامل تام 1(@)(@@) % سيروا فرب مسبحين وقائل % هذا شقا لبنى ربيعة باقي % % 2(@)(@@) % أبني ربيعة ، إنما أزرى بكم % نكد الجدود ودقة الأخلاق % 3(@)(@@) % يمشي هبيرة لعد مقتل شيخه % مشي المراسل أوذنت بطلاق % 4(@)(@@) % ماذا أردت إلي حين تسعرت % ناري وشمر مئزري عن ساقي % % 5(@)(@@) % إن القراف بمنخريك لبين ، % و سواد وجهك يا بن أم عفاق % PageV01P406 البحر : طويل 1(@)(@@) % بات هلال بالخضارم موجفا ، % و لم يتعوذ من شرور الطوارق % 2(@)(@@) % فصبحه سفيان في ذات كوكب % فجرد بيضا صادقات البوارق % 3(@)(@@) % وسفيان خواض إلى حارة الوغى % % ولوج إذا ما هيب باب السرادق % PageV01P407 البحر : بسيط تام 1(@)(@@) % ما ينسي الدهر لا يبرح لنا شجنا % يوم تداركه الأجمال والنوق % 2(@)(@@) % ما زال في القلب وجد يرتقي صعدا % حتى أصاب سواد العين تغريق % 6(@)(@@) % أين الأولى أنزلوا النعمان ضاحية % أم أين أبناء شيبان الغرانيق % 7(@)(@@) % صاهرت قوما لئاما في صدورهم % ضغن قديم وفي أخلاقهم ضيق % 9(@)(@@) % قل للأخيطلأ إذ جد لجراء بنا % % أقصر فإنك بالتقصير محقوق % 10(@)(@@) % لا تطلع الشمس 
ms117	 إلا وهو في تعب % و لا تغيب إلا وهو مسبوق % 11(@)(@@) % نفسي الفداء لقيس يوم تعصبكم % إذ لا يبل لسان الأخطل الريق % % 12(@)(@@) % بيض بأيديهم شهب مجربة ، % للهام جذ وللأعناق تطبيق % % 13(@)(@@) % والتغلبيون بئس الفحل فحلهم % فحلا وأمهم زلاء منطيق % % 15(@)(@@) % تحت المناطق أستاه مصلبة % مثل الدوا مسها الأنقاس والليق % PageV01P408 البحر : كامل تام 1(@)(@@) % أمسى خليطك قد أجد فراقا % % هاج الحزين وذكر الأشواقا % % 2(@)(@@) % هل تبصران ظعائنا بعنيزة % أم هل تقول لنا بهن لحاقا % % 3(@)(@@) % حث الحداة بهم وراء حمولهم % بزلا تجاسر لم يكن حقاقا % % 4(@)(@@) % يا رب قائلة تقول وقائل : % أسراق ! إنك قد خزيت سراقا % % 5(@)(@@) % إن الذين عووا عواءك قد لقوا % % مني صواعق تخضع الأعناقا % % 6(@)(@@) % فإذا لقيت مجيلسا من بارق % لاقيت أطبع مجلس أخلاقا % % 7(@)(@@) % الناقصين إذا يعد حصاهم % والجامعين مذلة ونفاقا % % 8(@)(@@) % و لقد هممت بأن أدمر بارقا % فرقبت فيهم عمنا إسحاقا % % PageV01P409 البحر : كامل تام 1(@)(@@) % أسرى الخالدة الخيال ، ولا أرى % % طللا أحب من الخيال الطارق % 2(@)(@@) % إن البلية من يمل حديثه % فانشح فؤادك من حديث الوامق % 3(@)(@@) % أهواك فوق هوى النفوس ولم يزل % مذ بنت قلبي كالجناح الخافق % 4(@)(@@) % طربا إليك ولم تبالي حاجتي ، % ليس المكذب كالخليل الصادق % 5(@)(@@) % هل رام بعد محلنا روض القطا % % فرويتان إلى غدير الخانق % 6(@)(@@) % ما يقحمون على من متمرد % إلا سبقت فنعم قوم السابق % PageV01P410 البحر : طويل 1(@)(@@) % بت أرائي صاحبي تجلدا % وقد علقتني من هواك علوق % 2(@)(@@) % فكيف بها لا الدار جامعة الهوى % % ولا أنت عصرا عن صباك مفيق % 3(@)(@@) % أتجمع قلبا بالعراق فريقه % و منه بأضلال الأراك فريق % 4(@)(@@) % كأن لم ترقني الرائحات عشية % و لم تمس في أهل العراق وميق % % 5(@)(@@) % أعالج برحا من هواك وشفني % % فؤاد إذا ما تذكرين خفوق % % 6(@)(@@) % أوانس ، أما من أردن عناءه % فعان ومن أطلقن فهو طليق % 7(@)(@@) % دعون الهوى ثم ارتمين قلوبنا % % بأسهم أعداء وهن صديق % % 8(@)(@@) % عجبت من الغيران لما تداركت % جمال يخالجن البرين ونوق % 9(@)(@@) % و من يأمن الحجاج 
ms118	 أما عقابه % فمر وأما عقده فوثيق % 10(@)(@@) % وما ذقت طعم النوم إلا مفزعا ، % و ما ساغ لي بين الحيازم ريق % PageV01P411 11(@)(@@) % و حملت أثقالي نجاة كأنها % % إذا ضمرت بعد الكلال فنيق % 12(@)(@@) % من الهوج مصلاتا كأن جرانها % % يمان نضا جفنين فهو دلوق % 13(@)(@@) % يبين للنسعين فوق دفوفها ، % وفوق متون الحالبين طريق % 14(@)(@@) % ترى لمجر النسعتين بجوزها % % موارد حرمي ، لهن طريق % 15(@)(@@) % طوى أمهات الدر حتى كأنها % % فلافل هندي فهن لصوق % 16(@)(@@) % إذا القوم قالوا وردهن ضحى غد % يغالين حتى وردهن طروق % 17(@)(@@) % و خفتك حتى استنزلتني مخافتي % % وقد حال دوني من عماية نيق % 18(@)(@@) % يسر لك البغضاء كل منافق % كما كل ذي دين عليك شفيق % 19(@)(@@) % و اطفأت نيران العراق وقد علا % % لهن دخان ساطع وحريق % 20(@)(@@) % و غن امرءا يرجو الغلول وقد رأى % % نكالك فيما قد مضى لسروق % PageV01P412 21(@)(@@) % و أنت لنا نور وغيث وعصمة % و نبت لمن يرجو نداك وريق % 22(@)(@@) % ألا رب عاص ظالم قد تركته % لأوداجه المستنزفات شهيق % PageV01P413 البحر : طويل 1(@)(@@) % يا تيم ! ما القارون في شدة القرى % % بتيم ولا الحامون عند الحقائق % 2(@)(@@) % و تيم تماشيها الكلاب إذا غدوا % % و لم تمش تيم في ظلال الخوافق % 3(@)(@@) % و تيم بأبواب الزورب أذلة % وما تهتدي تيم لباب السرادق % 4(@)(@@) % وما أحسن التيمي ، في جاهلية ، % منادمة الجبار فوق النمارق % 6(@)(@@) % تعادى على الثغر المخوف جيادنا ، % و تيم تحاسا جنحا في المعالق % 7(@)(@@) % وما أنتم يا تيم قد تعلمونه % بفرسان غارات الصباح الدوالق % PageV01P414 البحر : وافر تام 1(@)(@@) % متى أهجم عليك يقل دعي % أصابته السنابك في مضيق % 2(@)(@@) % وأكرم من أبي الخلجي رهطا % أغصته أعزتنا بريق % PageV01P415 البحر : طويل 1(@)(@@) % لنعم الفتى والخيل تنحط في القنا % % نعى ابن زياد للعقيلي طارق % % 2(@)(@@) % فيا صم من للخيل تنحط في القنا % % و يا صم من للمنديات الطوارق % 3(@)(@@) % و قد كان مقداما على حارة الوغى % % ولوجا إذا ما هيب باب السرادق % 4(@)(@@) % رأيت جياد الخيل بعدك عريت % و حلت رحال اليعملات المحانق 
ms119	 % PageV01P416 البحر : طويل 1(@)(@@) % ألا حي دار الهاجرية بالزرق ، % و أحبب بها دارا على البعد و السحق % 2(@)(@@) % سقتك الغوادي هل بربعك قاطن % أم الحي ساروا نحو فيحان فالعمق % 3(@)(@@) % فقد كنت إذ ليلى تحلك مرة % لنا بك شوق غير طرق ولا رنق % 4(@)(@@) % ألا قل لبراد إذا ما لقيته % وبين له ، إن البيان من الصدق % 5(@)(@@) % أحق بلا غاي أتتني مشابها % وبين له ، إن البيان من الصدق % 6(@)(@@) % فاياك لا تبدر اليك قصيدة % تغني بها الركبان في الغرب والشرق % 7(@)(@@) % فلولا أبو زيد وزيد أكلتم % جنا ما اجتنيتم من مرير ومن حذق % 8(@)(@@) % بني أرقم ! لا توعدوني ، فإنني % % أرى لكم حقا فلا تجهلوا حقي % % 9(@)(@@) % وربوا الذي بيني وبين قديمكم ، % و كفوا الأذى عني يلن لكم خلقي % % 10(@)(@@) % فإني لسهل للصديق ملاطف ، % و للكاشح العادي شجى داخل الحلق % PageV01P417 البحر : رجز تام 1(@)(@@) % قد وطنت مجاشع ، من الشقا ، % قردا وذيخ قلع تشرقا % % 2(@)(@@) % ألأم قينين إذا ما استوسقا % % و اجتمعا في اللؤم أو تفرقا % % 8(@)(@@) % قالت لعلجي نهشل فصدقا % % إن بني شعرة الفرزدقا % % 9(@)(@@) % قين لقين أينما تصفقا % % وهو يرائي الناس حجلا مغلقا % % 10(@)(@@) % أنفق في الماخور ما قد أنفقا % % و أكل الصب = يف الخزير الأورقا % % 11(@)(@@) % ونال من غيل القيون رفقا ، % كيرك ، يا أخبث قين عرقا % % 12(@)(@@) % هلا حميت الكير أن يخرقا ؛ % إن عقالا مخ رار دلقا % % 13(@)(@@) % تلق القيون دون ذاك العوقا ؛ % يال تميم من يخاف البروقا % % 14(@)(@@) % في آل يربوع يلاقي المصدقا % % ونسج داود علينا حلقا % % 15(@)(@@) % إن أبا مندوسة المعرقا % % يوم تمنانا فكان المزهقا % % PageV01P418 16(@)(@@) % لاقى من الموت خليجا متأقا ؛ % لما رأونا والسيوف البرقا % % 17(@)(@@) % قد نلن من عهد سريج رونقا ، % يصدعن بيض الدار عين المطرقا % % 18(@)(@@) % قبا إذا أخطأ فصلا طبقا % % يموت الروح إذا ما أخفقا % % 19(@)(@@) % إنا لنسمو ، للعدو ، حنقا ، % بالخيل أكداسا تثير عسقا % % 20(@)(@@) % يقال هذا أجم تحرقا % % بالخيل أشتاتا تقاد عرقا % % 21(@)(@@) % من كل شقاء تراها خيفقا % % تسابح البيد بشد أنفقا % % 22(@)(@@) % و 
ms120	 كل مشطون العنان أشدقا % % يمد في القيقب حتى يقلقا % % 23(@)(@@) % يتبعن ذا نقيبة موفقا % % يمضي إذا خمس الفلاة أرهقا % % 24(@)(@@) % فانشق فيها الآل أو ترقرقا % % وشبه القوم النجاد الخفقا % % 25(@)(@@) % شاما ورادا في شموس أبلقا % % PageV01P419 البحر : - 1(@)(@@) % طرقت لميس ، وليتها لم تطرق ، % حتى تفك حبال عان موثق % 2(@)(@@) % حييت دارك بالسلام تحية ، % يوم السلي ، فما لها لم تنطق % 3(@)(@@) % واستنكرالفتيات شيب المفرق ، % من بعد طول صبابة وتشوق % 4(@)(@@) % قد كنت أتبع حبل قائدة الصبا % % إذ للشباب بشاشة لم تخلق % 5(@)(@@) % أقفير قد علم الزبير ورهطه % أن ليس حبل مجاشع بالأوثق % 6(@)(@@) % ذكر البلاء فلم يكن لمجاشع % حمل اللواء ولا حماة المصدق % 7(@)(@@) % نحن الحماة بكل ثغر يتقي % % و بنا يفرج كل باب مغلق % 8(@)(@@) % وبنا يدافع كل أمر عظيمة ، % ليست كنزوك في ثياب الكرق % 9(@)(@@) % قد أنكرت شبه الفرزدق مالك % و نزلت منزلة الذليلش الملصق % 10(@)(@@) % حوض الحمار أبو الفرزدق فاعلموا % % عقد الأخادع وانشناج المرفق % PageV01P420 11(@)(@@) % شر الخليقة من علمنا منكم % حوض الحمار وشر من لم يخلق % 12(@)(@@) % كم قد أثير عليكم من خزية % ليس الفرزدق بعدها بفرزدق % 13(@)(@@) % ذكوان شد على ظعائنكم ضحى % % و سقى أباك من الأمر الأعلق % PageV01P421 البحر : طويل 1(@)(@@) % لعمري لقد أشجى تميما وهدها % % على نكبات الدهر موت الفرزدق % 2(@)(@@) % عشية راحوا للفراق بنعشه ، % إلى جدث في هوة الأرض معمق % 3(@)(@@) % لقد غادروا في اللحد من كان ينتمي % % إلى كل نجم في السماء محلق % 4(@)(@@) % ثوى حامل الأثقال عن كل مغرم % و دامغ شيطان الغشوم السملق % 5(@)(@@) % عماد تميم كلها ولسانها % % و ناطقها البذاخ في كل منطق % 6(@)(@@) % فمن لذوي الأرحام بعد ابن غالب % لجار وعان في السلاسل موثق % 7(@)(@@) % ومن ليتيم بعد موت ابن غالب % و أم عيال ساغبين ودردق % 8(@)(@@) % ومن يطلق الأسرى ومن يحقن الدما % % يداه ويشفي صدر حران محنق % 9(@)(@@) % و كم من دم غال تحمل ثقله % و كان حمولا في وفاء ومصدق % 10(@)(@@) % وكم حصن جبار همام وسوقة % إذا ما أتى 