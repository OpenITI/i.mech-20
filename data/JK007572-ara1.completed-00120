ms101	 شفاه الأراقم % وعاتبني فيها شفار الصوارم % % 2(@)(@@) % عدتني عنها الحرب يصرف نابها % % وصلصال رعد في زئير الضراغم % % 3(@)(@@) % فكيف بها نجدية حال دونها % % صعاليك نجد في متون الصلادم % % 4(@)(@@) % أتى دونها نأي المزار وبعده % وآساد أغيال وجن صرائم % % 5(@)(@@) % وأشوس غيران عليها حلاحل % طويل نجاد السيف ماضي العزائم % % 6(@)(@@) % ولو شئت لم تبعد علي خيامها % % ولو طنبت بين النجوم العواتم % % 7(@)(@@) % وبات لها مني على ظهر سابح % أشم أبي الظلم من آل ظالم % % 8(@)(@@) % وأسهرها جر الرماح على الثرى % % بأيدي فتو الأزد صفر العمائم % % 9(@)(@@) % فهل تبلغنيها الجياد كأنها % % أعنتها من طول لوك الشكائم % % 10(@)(@@) % من الأعوجيات التي ترزق الغنى % % وتضمن أقوات النسور القشاعم % % PageV01P313 11(@)(@@) % من اللاء هاجت للنوى أريحيتي % % وهزت إلى فسطاط مصر قوادمي % % 12(@)(@@) % فشيعت جيش النصر تشييع مزمع % وودعته توديع غير مصارم % % 13(@)(@@) % وقد كدت لا ألوي على من تركته % ولكن عداني ما ثنى من عزائمي % % 14(@)(@@) % ولو أنني استأثرت بالإذن وحده % لسرت ولم أحفل بلومة لائم % % 15(@)(@@) % طربت إلى يوم أوفيه حقه % ليعلم أهل الشعر كيف مقاومي % % 16(@)(@@) % أصب إلى مصر لساعة مشهد % يعض لها غيابها بالأباهم % % 17(@)(@@) % فإن لم أشاهد يومها ملء ناظري % % أشاهده ملء السمع ملء الحيازم % % 18(@)(@@) % وقد صورت نفسي لي الفتح صورة % وشامته لي من غير نظرة شائم % % 19(@)(@@) % كذاك إذا قام الدليل لذي النهى % % على كون شيء كان ضربة لازم % % 20(@)(@@) % على أني قضيت بعض مآربي % % وأقررت عيني بالجيوش الخضارم % % PageV01P314 21(@)(@@) % وآنست من أنصار دولة هاشم % جحاجحة تسعى لدولة هاشم % % 22(@)(@@) % ويممت في طرق الجهاد سبيلهم % % لأصلى كما يصلون لفح السمائم % % 23(@)(@@) % وفارقتهم لا مؤثرا لفراقهم % % ولا مستخفا بالحقوق اللوازم % % 24(@)(@@) % فلله ما ضم السرادق والتقت % عليه ظلال الخافقات الحوائم % % 25(@)(@@) % فثم مصابيح الظلام وشيعة ال % % إمام وأسد المأزق المتلاحم % % 26(@)(@@) % وفي الجيش ملآن به الجيش باسط % يديه بقسطاط من العدل قائم % % 27(@)(@@) % مدبر حرب لا بخيل بنفسه % عليها ولا مستأثر بالغنائم % 28(@)(@@) % ولا صارف راياته عن محارب % ولا ممسك معروفه 
ms102	 عن مسالم % % 29(@)(@@) % وللصارخ الملهوف أول ناصر % وللمترف الجبار أول قاصم % 30(@)(@@) % فلا عبقري كان أو هو كائن % فرى فريه في المعضلات العظائم % % PageV01P315 31(@)(@@) % كذلك ما قاد الكتائب مثله % لإنصاف مظلوم ولا قمع ظالم % % 32(@)(@@) % ولم يتجمع لامرئ كان قلبه % خضاب العوالي واجتناب المآثم % % 33(@)(@@) % رضاك ابن وحي الله عنه فإنه % رعى أولياء الله رعي السوائم % % 34(@)(@@) % إذا اختلفوا في الأمر ألف بينهم % % طبيب بأدواء النفوس السقائم % % 35(@)(@@) % فلا رأيه في حالة يتبع الهوى % % ولا سمعه مستوقف للنمائم % % 36(@)(@@) % جزته جوازي الخير عنهم فأنه % سقاهم بشؤبوب من العدل ساجم % % 37(@)(@@) % فقد سار فيهم سيرة لم يسر بها % % من الناس إلا مثل كعب وحاتم % % 38(@)(@@) % أفاء عليهم ظل أيامك التي % % زهين بأيام العلى والمكارم % % 39(@)(@@) % وما غال جيش الشرق قبلك غائل % ولا سيما بعد العطايا الجسائم % % 40(@)(@@) % وبعد صلات ما رأى الناس مثلها % % ولا حدثوا في السالف المتقادم % % PageV01P316 41(@)(@@) % أولئك قوم يعلم الله أنهم % % قد اقتسموا الدنيا اقتسام المغانم % % 42(@)(@@) % فكم ألف ألف قد غدوا يطأونها % % بأقدامهم وطء الحصى بالمناسم % % 43(@)(@@) % ولو كنت ممن يستريب عيانه % ويدركه فيما رأى وهم واهم % % 44(@)(@@) % لحدثت نفسي انني كنتث حالما % وإن لم أكن فيما رأيت بحالم % % 45(@)(@@) % فلا يسألني من تخلف عنهم % فيقرع في آرائه سن نادم % % 46(@)(@@) % لعمري هم أنصار حق وكلهم % من المجد في بيت رفيع الدعائم % % 47(@)(@@) % لقد أظهروا من شكر نعمة ربهم % % وقائدهم ما لست عنه بنائم % % 48(@)(@@) % وإني قد حملت منهم نصائحا % كرائم تهدى عن نفوس كرائم % % 49(@)(@@) % إليك امير المؤمنين حملتها % % ودائع كالأموال تحت الخواتم % % 50(@)(@@) % شهدت بما أبصرته وعلمته % شهادة بر لا شهادة ثم % % PageV01P317 51(@)(@@) % فقمت بها عن ألسن القوم خطبة % إذا ذكرت لم تخزهم في المواسم % % PageV01P318 البحر : متقارب تام 1(@)(@@) % أما والمذاكي يلكن الشكم % و ضرب القوانس فوق البهم % % 2(@)(@@) % ووقع الصعاد وحر الجلاد % إذا ما الدماء خضبن اللمم % % 3(@)(@@) % يمينا لأنت مليك الملوك % فمن شاء خص ومن شاء عم % 4(@)(@@) % وإني لأعجب من خلتيين % جود 
ms103	 يديك وبخل الأمم % % 5(@)(@@) % فعان يرجي لديك الفكاك % % وعاف يشيم لديك الديم % % 6(@)(@@) % فمن أين ساروا فأنت السبيل % ومن أين ضلوا فأنت العلم % % 7(@)(@@) % ويأبى لك الذم طيب النجار % وطيب الخلال وطيب الشيم % % 8(@)(@@) % خلقت شهابا يضيء الخطوب % ولست شهابا يضيء الظلم % % 9(@)(@@) % فلو كنت حيث نجوم السماء % لما كان في الأرض رزق قسم % 10(@)(@@) % كرمت فكنت شجى للكرام % فلم تترك القطر حتى لؤم % % PageV01P319 11(@)(@@) % فأشبهك البحر إن قيل ذا % % غطم وذا جواد خضم % 12(@)(@@) % و اخطأك الشبه إن قيل ذا % % أجاج وهذا فرات شبم % % 13(@)(@@) % إذا لم يكن منهلا للورود % فلا خير في موجه الملتطم % % 14(@)(@@) % رأيتك سيف بني هاشم % وخير السيوف اليماني الخذم % % 15(@)(@@) % فلو كنت حاربت جند القضاء % % و أنت على سابح لانهزم % % 16(@)(@@) % ولو أن دهرك شخص تراه % لتسطوبه فاتكا ما سلم % % 17(@)(@@) % إلى جعفر يتناهى المديح % وفيه تثير القوافي الحكم % % 18(@)(@@) % فسل ظمىء الترب عن نيله % وحسبك من عالم ما علم % % 19(@)(@@) % هو استن للريح هذا الهبوب % ورشح ذا العارض المرتكم % % 20(@)(@@) % فما همت المزن حتى همى % % ولا ابتسم البرق حتى ابتسم % % PageV01P320 21(@)(@@) % وليس رشاء وإن مد من % % رشاء ولا وذم من وذم % % 22(@)(@@) % عفاف يدي وعلو الهمم % % بمزن ولا كل يم بيم % 23(@)(@@) % ولا كل ما في أكف ندى % ولا كل ما في أنوف شمم % % 24(@)(@@) % فأقسم لو أن عصر الشباب % كأيامه لأمنا الهرم % % 25(@)(@@) % هو الواهب المقربات الجياد % صواهل واليعملات الرسم % 26(@)(@@) % إلى كل عضب رقيق الفرند % ومطرد الكعب لدن أصم % 27(@)(@@) % ومسرودة مثل نسج السراب % ترقرق فوق الكمي العمم % % 28(@)(@@) % و بيضة خدر تجر الذيول % كما أتلع الخشف لما بغم % % 29(@)(@@) % وبدرة ألف يمانية % يحيي الوفود بها بدر تم % 30(@)(@@) % ولم أر أنفذ من كتبه % إذا جعل السيف حيث القلم % % PageV01P321 31(@)(@@) % لعمري لقد مزعت خيله % و أنعلهن خدود الأكم % % 32(@)(@@) % % و لا نسي العفو لما انتقم % % 33(@)(@@) % فلو أبصرت وائل يومه % لما عددت فارسا من جشم % 34(@)(@@) % غداة رمى المعشر المارقين % بصماء 
ms104	 توقص منها القمم % % 35(@)(@@) % وذي لجب يرتدي بالقنا % % و يعثر في العثير المدلهم % 36(@)(@@) % وباتوا يريحون كوم اللقاح % % 37(@)(@@) % فأضحى بحيث الرغاء الزئير % وحالت بحيث الخيام الأجم % % 38(@)(@@) % و أعطى القبيل سوام القتيل % بما فيه من وبر أو نعم % % 39(@)(@@) % فلو ناقة عند ذاك انثنت % لتروي فصيلا لجادت بدم % % 40(@)(@@) % فمن حاتم ثكلوا حاتما % ومن هرم حيث عدوا هرم % % PageV01P322 41(@)(@@) % إذا هو أعطى البعير الفريد % برمته . . . ظن أن قد كرم % % 42(@)(@@) % وأنت رأيتك تعطي الألوف % فتنهب نهبا ولا تقتسم % % 43(@)(@@) % و كان إذا ما قرى بكرة % تفرد بالجود فيما زعم % % 44(@)(@@) % و أنت تجود بمثل البكار % من التبر في مثلها من أدم % % 45(@)(@@) % إذا عرب لم تكن في الصميم % % 46(@)(@@) % فلو نسبت يمن كلها % % إليك لقنا لها لا جرم % % 47(@)(@@) % بحيث الأكف طوال إلى % % مآربها والعرانين شم % 48(@)(@@) % إنك من معشر طفلهم % يتوج قبل بلوغ الحلم % % 49(@)(@@) % و يسمو إلى المجد قبل الفطام % فكيف يكون إذا ما فطم % % 50(@)(@@) % ملوك الملوك وأبناؤها % % وفوق الهوادي تكون القمم % % PageV01P323 51(@)(@@) % تشيع فيكم لساني ومن % تشيع في قوله لم يلم % % 52(@)(@@) % فلست أبالي بأي بدأت % بفخري بكم أو بمدحي لكم % % 53(@)(@@) % فإن طفقت واله بيننا % % تحن حنينا فتلك الرحم % % 54(@)(@@) % هل اللؤلؤ الرطب إلا الذي % % نظمت لكم عقده فانتظم % % 55(@)(@@) % قواف لسؤددكم تقتنى % % 56(@)(@@) % قصرن عليكم كأن الشآم % و أرض العراق عليها حرم % % 57(@)(@@) % تكنفتموني فلم أضطهد % وأعززتموني فلم أهتضم % % 58(@)(@@) % ففي ناظري عن سواكم عمى % وفي أذني عن سواكم صمم % % 59(@)(@@) % فشملي بشملكم جامع % و شعبي بشعبكم ملتئم % % 60(@)(@@) % فلا انفصمت عروة بيننا % % إذا ما العرى جعلت تنفصم % % PageV01P324 61(@)(@@) % أبا أحمد دعوة حرة % لحر المواثيق حر الذمم % % 62(@)(@@) % حمدت لقاءك حمد الربيع % % وشمت نوالك شيم الديم % % 63(@)(@@) % و ما الغيث أولى بأن يستهل % و ما الغيث أولى بأن ينسجم % % 64(@)(@@) % و من حق غيري أن يجتدي % % ومن حق مثلي أن يحتكم % % 65(@)(@@) % وأنت ملي بدور الفعال % و إني ملي بدر الكلم % % 66(@)(@@) % وحسبك 
ms105	 من هبرزي له % على كل عضو لسان وفم % % 67(@)(@@) % و لم أر مثل جزيل الثناء % مكافأة لجزيل النعم % % 68(@)(@@) % خرست ولي منطق العالمين % فقل الفصيح جميل البكم % % 69(@)(@@) % فلو أن حدي كهام نبا % % ولو أن ذهني كليل سئم % % 70(@)(@@) % أذم إليك اعتوار الخطوب % و صرف الحواذث فيما أذم % PageV01P325 71(@)(@@) % و مما اعان علي الزمان % % 72(@)(@@) % فلا بالعجول ولا بالملول % و لا بالسؤوال ولا المغتنم % % 73(@)(@@) % وإني وإن ترني قابضا % جناحي إلي كظيما وجم % % 74(@)(@@) % أقلل من هفوات المزار % وأبدي الغناء وأخفي العدم % % 75(@)(@@) % فإني من العرب الاكرمين % وفي أول الدهر ضاع الكرم % % PageV01P326 البحر : بسيط تام 1(@)(@@) % يا خير ملتحف بالمجد والكرم % و أفضل الناس من عرب ومن عجم % 2(@)(@@) % يا ابن السدى والندى والمعلومات معا % والحلم والعلم والآداب والحكم % % 3(@)(@@) % لو كنت أعطى المنى فيما أؤمله % حملت عنك الذي حملت من ألم % % 4(@)(@@) % وكنت أعتده يدا ظفرت بها % % من الايادي وقسما أوفر القسم % % 5(@)(@@) % حتى تروح معافى الجسم سالمه % وتستبل إلى العلياء والكرم % % 6(@)(@@) % الله يعلم أني مذ سمعت بما % % عراك لم أغتمض وجدا ولم أنم % % 7(@)(@@) % فعند ذا أنا مدفوع إلى قلق % ومرة أنا مصروف إلى سدم % % 8(@)(@@) % أدعوا وطورا أجيل الوجه مبتهلا % على صعيد الثرى في حندس الظلم % % 9(@)(@@) % وكيف لا ، كيف أن يخطو السقام إلى % % من في يديه شفاء الضر والسقم % % 10(@)(@@) % إلى الهمام الذي لم ترن مقلته % إلا إلى الهمم العظمى من الهمم % % PageV01P327 11(@)(@@) % أجرى الكرام إلى غايات مكرمة % أجل وأمضاهم طرا حسام فم % % 12(@)(@@) % إيها لعا لك يا ابن الصيد من ألم % و لا لعا لأناس مظلمي الشيم % % 13(@)(@@) % قوم تعروا من الآداب واتشحوا % % مرادي اللؤم والإخلاف للذمم % % 14(@)(@@) % من كل أنحل في معقوله خوص % صفر من الظرف مسلوب من الفهم % % 15(@)(@@) % كأنه صنم من بعد فطنته % وما التنفس معهود من الصنم % % 16(@)(@@) % ولا زلت تسحب أذيال الندى كرما % في نعمة غير مزجاة من النعم % % 17(@)(@@) % ما نمنم الروض أو حاكت وشائعه % أيدي السحاب الغوادي 
ms106	 الغر بالديم % % PageV01P328 البحر : طويل 1(@)(@@) % تظلم منا الحب والحب ظالم % فهل بين ظلامين قاض وحاكم % % 2(@)(@@) % في البين حرف معجم قد قرأته % على خدها لو أنني منه سالم % % 3(@)(@@) % وقد كان فيما أثر المسك فوقه % دليل ومن خلف الحداد المآتم % % 4(@)(@@) % ليالي لا أوي إلى غير ساجع % ببينك حتى كل شيء حمائم % % 5(@)(@@) % و لما التقت ألحاظنا ووشاتنا % % و أعلن سر الوشي ما الوشي كاتم % % 6(@)(@@) % تأوه إنسي من الخدر ناشج % فأسعد وحشي من السدر باغم % % 7(@)(@@) % و قالت : قطا سار سمعت حفيفه % فقلت : قلوب العاشقين الحوائم % % 8(@)(@@) % سلوا بانة الوادي أأسماء بانة % بجرعائه أم عانك متراكم % % 9(@)(@@) % وما عذب المسواك إلا لأنه % يقبلها دوني وإني لراغم % % 10(@)(@@) % و قلت له صف لي جنى رشفاتها % % فألثمني فاها بما هو زاعم % % PageV01P329 11(@)(@@) % إذا خلة بانت لهونا بذكرها % % وإن أقفرت دار كفتنا المعالم % % 12(@)(@@) % و قد يستفيق الشوق بعد لجاجه % و تعدى على البهم العتاق الرواسم % % 13(@)(@@) % خليلي هبا فانصراها على الدجى % % كتائب حتى يهزم الليل هازم % % 14(@)(@@) % وحتى أرى الجوزاء تنثر عقدها % % و تسقط من كف الثريا الخواتم % % 15(@)(@@) % وتغدو على يحيى الوفود ببابه % كما ابتدرت أم الحطيم المواسم % % 16(@)(@@) % فتى الملك يغنيه عن السيف رأيه % و يكفيه من قود الجيوش العزائم % % 17(@)(@@) % فلا جود إلا بالجزيل لآمل % و لا عفو إلا أن تجل الجرائم % % 18(@)(@@) % أخو الحرب وابن الحرب جر نجاده % % إليها وما قدت عليه التمائم % % 19(@)(@@) % أمثله في ناظر غير ناظري % % كأني فيما قد أرى منه حالم % % 20(@)(@@) % و ليس كما قالوا المنية كاسمها % % ولكنها في كفه اليوم صارم % % PageV01P330 21(@)(@@) % و يعدل في شرق البلاد وغربها % % على أنه للبيض والسمر ظالم % % 22(@)(@@) % تشكين أن لاقين منه تقصدا % فأين الذي يلقى الليوث الضراغم % % 23(@)(@@) % ولو أن هذا الأخرس الحي ناطق % لصلت عليك المقربات الصلادم % % 24(@)(@@) % و ما تلك أوضاح عليها وإن بدت % و لكنها حيتك عنها المباسم % % 25(@)(@@) % تمشت شموس طلقة في جلودها % % وضمت على هوج الرياح الشكائم % % 26(@)(@@) % تعرضها 
ms107	 للطعن حتى كأنها % % لها من عداها أضلع وحيازم % % 27(@)(@@) % وتطعنهم لم تعد نحرا ولبة % كأنك في عقد من الدر ناظم % % 28(@)(@@) % وكم جحفل مجر قرعت صفاته % بصاعقة يصلي بها وهي جاحم % % 29(@)(@@) % أتتك به الآساد تبدي زئيرها % % فطارت به عن جانبيك القشاعم % % 30(@)(@@) % أتوك فما خروا إلى البيض سجدا % ولكنما كانت تخر الجماجم % % PageV01P331 31(@)(@@) % ولو حاربتك الشمس دون لقائهم % % لأعجلها جند من الله هازم % % 32(@)(@@) % سبقت المنايا واقعا بنفوسهم % % كما وقعت قبل الخوافي القوادم % % 33(@)(@@) % تقود الكماة المعلمين إلى الوغى % % لهم فوق أصوات الحديد هماهم % % 34(@)(@@) % غدوا في الدروع السابغات كأنما % % تدير عيونا فوقهن الأراقم % % 35(@)(@@) % فليس لهم إلا الدماء مشارب % وليس لهم إلا النفوس مطاعم % % 36(@)(@@) % يودون لو صيغت لهم من حفاظهم % وإقدامهم تلك السيوف الصوارم % 37(@)(@@) % ولو طعنت قبل الرماح أكفهم % ولو سبقت قبل الأكف المعاصم % 38(@)(@@) % رأى بك ليث الغاب كيف اختضابه % % من العلق المحمر والنقع قاتم % 39(@)(@@) % وجرأته شبلا صغيرا على الطلى % % فهل يشكرن اليوم وهو ضبارم ؟ % 40(@)(@@) % وعلمته حتى إذا ما تمهرت % به السن قلت اذهب فإنك عالم % % PageV01P332 41(@)(@@) % ستفخر أن الدهر ممن أجرته % وأن حياة الخلق مما تسالم % % 42(@)(@@) % وأنك عن حق الخلافة ذائد % وأنك عن ثغر الخلافة باسم % % 43(@)(@@) % وأنك فت السابقين كأنما % % مساعيك في سوق الرجال أداهم % % 44(@)(@@) % مريت سجالا من عقاب ونائل % كأنك للأعمار والرزق قاسم % % 45(@)(@@) % وأمنت من سبل العفاة فجدعت % إليك أنوف البيد وهي رواغم % % 46(@)(@@) % وأدنيتها بالإذن حتى كأنما % % تخطت إليك السيف والسيف قائم % % 47(@)(@@) % وتنظر علوا أين منك وفودها % % كأنك يوم الركب للبرق شائم % % 48(@)(@@) % فلا تخذل البدر المنير الذي به % سروا فله حق على الجود لازم % % 49(@)(@@) % أيأخذ منه الفجر والفجر ساطع % ويثبت فيه الليل والليل فاحم % % 50(@)(@@) % علوت فلولا التاج فوقك شككت % تميم بن مر فيك أنك دارم % % PageV01P333 51(@)(@@) % وجدت فلولا أن تشرف طيء % لقد قال بعض القوم إنك حاتم % % 52(@)(@@) % لك البيت بيت الفخر أنت عموده % وليس له إلا الرماح دعائم % % 53(@)(@@) % أناف به 
ms108	 أن ليس فوقك بالغ % وشيده أن ليس خلفك هادم % % 54(@)(@@) % وما كانت الدنيا لتحمل أهلها % % ولكنكم فيها البحور الخضارم % % 55(@)(@@) % فمهلا فقد أخرستمونا كأنما % % صنائعكم عرب ونحن أعاجم % % 56(@)(@@) % فلا زال منهل من المجد ساكب % عليك ومرفض من العز ساجم % 57(@)(@@) % فثم زمان كالشبيبة مذهب % وئم ليال كالقدود نواعم % 58(@)(@@) % ولله در البين لولا خليفة % تخلفني عنكم وحبل مداوم % 59(@)(@@) % ودر القصور البيض يعمر ملكها % % ملوك بني الدنيا وهن الكرائم % 60(@)(@@) % وأنت بها فاردد تحية بعضنا % % إذا قبلت كفيك عنا الغمائم % PageV01P334 61(@)(@@) % ولو أنني في ملحد ودعوتي % % لقامت تفديك العظام الرمائم % % 62(@)(@@) % تحملت بالآمال إذا أنت راحل % وأقبلت بالآلاء إذ أنت قادم % % 63(@)(@@) % مددت يدا تهمي على المزن من عل % فهل لك بحر فوقها متلاطم % % 64(@)(@@) % هو الحوض حوض الله من يك واردا % فقد صدرت عنه الغيوث السواجم % % 65(@)(@@) % فإن كان هذا فعل كفيك باللهى % % لقد أصبحت كلا عليك المكارم % % PageV01P335 البحر : طويل 1(@)(@@) % ثوت مضر الحمراء تحت طرافها % % وقالت نزار يا ربيعة ألجمي % % 2(@)(@@) % وقدم بكرا سعيها قبل تغلب % وقالا لشيبان جميعا تقدمي % % 3(@)(@@) % لكم فارع لم يبلغ النجم ظله % وشاهقة قعساء لم تتسنم % % PageV01P336 البحر : طويل 1(@)(@@) % نظرت كما جلت عقاب على إرم % وإني لفرد مثل ما انفرد الزلم % % 2(@)(@@) % بمرقبة مثل السنان تقدمت % خياشيمه واستردف العامل الأصم % 3(@)(@@) % فلا قلة شهباء إلا ربأتها % % ولا علم إلا رقأت ذرى العلم % % 4(@)(@@) % فقلت : أدار المالكية ما أرى % % بأسفل ذا الوادي أم الطلح والسلم % % 5(@)(@@) % وأكذبني الطرف فخفضت كلكلا % وأطرقت إطراق الشجاع ولم أرم % 6(@)(@@) % فلما أجن الشمس ريب من الدجى % % ولف سوام الحي سيل من العتم % % 7(@)(@@) % عرفت ديار الحي بالنار للقرى % % تشب وبالأنجوج يذكى ويضطرم % % 8(@)(@@) % وأرعيتها سمعي وقد راعني لها % % صهيل المذاكي قبل قرقرة النعم % % 9(@)(@@) % فلما رأيت الأفق قد سار سيرة % مجوسية واسنحكك اللوح وادلهم % 10(@)(@@) % ولم يبقى إلا سامر الليل هادر % من البزل أو غريد سرب من البهم % % PageV01P337 11(@)(@@) % طرقت فتاة الحي إذ نام أهلها % % وقد قام 
ms109	 ليل العاشقين على قدم % % 12(@)(@@) % فقالت : أحقا كلما جئت طارقا % هتكت حجاب المجد عن ظبية الحرم % % 13(@)(@@) % فسكنت من إرعادها وهي هونة % ضعيفة طي الخصر في لحظها سقم % % 14(@)(@@) % أضم عليها أضلعي وكأنها % % من الذعر نشوى أو تطرقها لمم % % 15(@)(@@) % أميل بها ميل النزيفة مسندا % إلى الصدر منها ناعم الصدر قد نجم % % 16(@)(@@) % ولم أنسها تثني يدي بمطرف % لطيف على المسواك مختضب بدم % % 17(@)(@@) % فبت أداري النفس عما يريبها % % ونام القطا من طول ليلي ولم أنم % % 18(@)(@@) % ولم أنس منها نظرة حين ودعت % وقد ملئت دلو الصباح إلى الوذم % % 19(@)(@@) % أنازعها باللحظ سرا كأنها % % تعلم منها اللحظ ما نسيض القلم % % 20(@)(@@) % وقد أحكم الغيران في سوء ظنه % فما شك في قتلي وإن كان قد حلم % % PageV01P338 21(@)(@@) % فبات بقلب قد توغر خلبه % علي وشبت ناره لي واحتدم % % 22(@)(@@) % وأقبل يستاف الثرى من مدارجي % % ومسحب أذيالي على الرغل والينم % % 23(@)(@@) % فما راعه إلا مكان توكؤي % % على سية القوس المغشاة بالأدم % % 24(@)(@@) % ومسقط قدح من قداحي على الثرى % % و منقد ذيل من ذيولي على الأكم % % 25(@)(@@) % وقد صدقت ما ظن نفحة عازب % من الروض دلته على الطارق الملم % 26(@)(@@) % يطيف بأطناب القباب مسهدا % فينشق ريح الليث والليث في الأجم % % 27(@)(@@) % لدى بنت قيل قد أجارت عميدها % % فكفت عميد الحي عنه وإن رغم % % 28(@)(@@) % و تقنى حياء أن يلم بخدرها % % فتنفيه عنا هيبة المجد والكرم % % 29(@)(@@) % ونبه أقصى الحي أني وترتهم % % وقد مل من رجم الظنون وقد سئم % % 30(@)(@@) % هتكت سجوف الخدر وهو بمرصد % فلما تعارفنا هممت به وهم % PageV01P339 31(@)(@@) % فبادرت سيفي حين بادر سيفه % % 32(@)(@@) % ونبه أقصى أني وترتهم % وقد عل صدر السيف من ماجد عمم % % 33(@)(@@) % فما أسرجوا حتى تعثرت بالقنا % % ولا ألجموا حتى مرقت من الخيم % % 34(@)(@@) % ومن بين بردي اللذين تراهما % % رقيق حواشي النفس والطبع والشيم % % 35(@)(@@) % يسير على نهج ابن عمر و فيقتدي % % بأروع مجموع على فضله الأمم % % PageV01P340 البحر : كامل تام 1(@)(@@) % إيها لك النعمى على فأنعمي % % وبرئت من 
ms110	 حرج السلام فسلمي % % 2(@)(@@) % لله موقف عاشق ومعشق % من ظالم منا ومن متظلم % % 3(@)(@@) % بادرت موطئ نعله حتى إذا % % عفرت خدي في الثرى المتنسم % % 4(@)(@@) % اعتل من وجناته فأجال في % % صحن العقيق جداولا من عندم % % 5(@)(@@) % أجرى على ذهبيها عصبيها % % ودنا لسفك دمي بورد من دم % % PageV01P341 البحر : كامل تام 1(@)(@@) % يا ذا البديهة في المقال أما كفت % بدهات هذا النقض والإبرام % % 2(@)(@@) % حكم يجلي غيب كل ملمة % كالشمس تكشف جنح كل ظلام % 3(@)(@@) % و لذا تراك عيوننا وقلوبنا % % مثل الشهاب على سواء الهام % % 4(@)(@@) % ما أكثر الأسماء حين أعدها % % من ماجد وسميذع وهمام % % 5(@)(@@) % فإذا رجعت إلى الحقيق فإنما % % إياك تعني ألسن الأقوام % % 6(@)(@@) % فاترك لأهل الشعر معنى واحدا % مما تثير هواجس الأوهام % % 7(@)(@@) % فلأنت والصيد الذين نميتهم % % من كل رحب الباع أبلج سام % % 8(@)(@@) % أهل الأصالة والنباهة والفصا % % حة والنهي والفهم والإفهام % % 9(@)(@@) % تمشي البلاغة خلفكم وأمامكم % % و يطيب ما تطؤون بالأقدام % % 10(@)(@@) % و تكاد تعشب أرضكم بكلامكم % لو أن أرضا أعشبت بكلام % % PageV01P342 11(@)(@@) % من أين أنكر فضلكم ولو أنني % % كأبي عبادة أو أبي تمام % % PageV01P343 (@)(@@)(@@)(@@) | (@)(@@) البحر : كامل تام 1(@)(@@) % هل من أعقة عالج يبرين % أم منهما بقر الحدوج العين % 2(@)(@@) % و لمن ليال ما ذممنا عهدها % % مذ كن إلا أنهن شجون % % 3(@)(@@) % المشرقات كأنهن كواكب % و الناعمات كأنهن غصون % % 4(@)(@@) % بيض وما ضحك الصباح وإنها % % بالمسك من طرر الحسان لجون % % 5(@)(@@) % أدمى لها المرجان صفحة خده % وبكى عليها اللؤلؤ المكنون % % 6(@)(@@) % أعدى الحمام تأوهي من بعدها % % فكأنه فيما سجعن رنين % % 7(@)(@@) % بانوا سراعا للهوادج زفرة % مما رأين وللمطي حنين % % 8(@)(@@) % فكأنما صبغة ا الضحى بقبابهم % أو عصفرت فيها الخدود جفون % % 9(@)(@@) % ماذا على حلل الشقيق لو أنها % % عن لابسيها في الخدود تبين % % 10(@)(@@) % لأعطشن الروض بعدهم ولا % % يرويه لي دمع عليه هتون % % PageV01P344 11(@)(@@) % أأعير لحظ العين بهجة منظر % وأخونهم إني إذا لخؤون % % 12(@)(@@) % لا الجو جو مشرق ولو اكتسى % % زهرا ولا الماء المعين معين % % 13(@)(@@) % لا يبعدن إذ العبير 
ms111	 له ثرى % % والبان أيك والشموس قطين % % 14(@)(@@) % أيام فيه العبقري مفوف % و السابري مضاعف موضون % % 15(@)(@@) % والزاعبية شرع والمشرف % % ية لمع والمقربات صفون % % 16(@)(@@) % و العهد من لمياء إذ لا قومها % % خزر ولا الحرب الزبون زبون % % 17(@)(@@) % عهدي بذاك الجو وهو أسنة % وكناس ذاك الخشف وهو عرين % % 18(@)(@@) % هل يدنيني منه أجرد سابح % مرح وجائلة النسوع أمون % % 19(@)(@@) % و مهند فيه الفرند كأنه % ذمر له خلف الغرار كمين % % 20(@)(@@) % غضب المضارب مقفر من أعين % لكنه من أنفس مسكون % % PageV01P345 21(@)(@@) % قد كان رشح حديده أجلى وما % % صاغت مضاربه الرقاق قيون % % 22(@)(@@) % و كأنما يلقى الضريبة دونه % بأس المعز أو اسمه المحزون % % 23(@)(@@) % هذا معد والخلائق كلها % % هذا المعز متوجا والدين % % 24(@)(@@) % هذا ضمير النشأة الأولى التي % % بدأ الإله وغيبها المكنون % % 25(@)(@@) % من أجل هذا قدر المقدور في % % أم الكتاب وكون التكوين % % 26(@)(@@) % وبذا تلقى آدم من ربه % عفوا وفاء ليونس اليقطين % % 27(@)(@@) % يا أرض كيف حملت ثني نجاده % والنصر أعظم منك والتمكين % % 28(@)(@@) % حاشا لما حملت تحمل مثله % أرض ولكن السماء تعين % 29(@)(@@) % لو يلتقي الطوفان قبل وجوده % لم ينج نوحا فلكه المشحون % % 30(@)(@@) % لو أن هذا الدهر يبطش بطشه % لم يعقب الحركات منه سكون % % PageV01P346 31(@)(@@) % الروض ما قد قيل في أيامه % لا أنه ورد ولا نسرين % % 32(@)(@@) % و المسك ما لثم الثرى من ذكره % لا أن كل قرارة دارين % % 33(@)(@@) % ملك كما حدثت عنه رأفة % فالحمر ماء والشراسة لين % % 34(@)(@@) % شيم لو أن اليم أعطي رفقها % % لم يلتقم ذا النون منه النون % % 35(@)(@@) % تالله لا ظلل الغمام معاقل % تأبى عليه ولا النجوم حصون % 36(@)(@@) % ووراء حق ابن الرسول ضراغم % أسد وشهباء السلاح منون % 37(@)(@@) % الطالبان : المشرفية والقنا % % و المدركان : النصر والتمكين % % 38(@)(@@) % و صواهل لا الهضب يوم مغارها % % هضب ولا البيد الحزون حزون % % 39(@)(@@) % حيث الحمام وما لهن قوادم % و على الريود وما لهن وكون % % 40(@)(@@) % و لهن من ورق اللجين توجس % ولهن من مقل الظباء شفون % % PageV01P347 41(@)(@@) % فكأنها تحت 
ms112	 النضار كواكب % وكأنها تحت الحديد دجون % % 42(@)(@@) % عرفت بساعة سبقها لا أنها % % علقت بها يوم الرهان عيون % % 43(@)(@@) % و أجل علم البرق فيها أنها % % مرت بجانحتيه وهي ظنون % 44(@)(@@) % في الغيث شبه من نداك كأنما % % مسحت على الأنواء منك يمين % % 45(@)(@@) % أما الغنى فهو الذي أوليتنا % % فكأن جودك بالخلود رهين % % 46(@)(@@) % تطأ الجياد بنا البدور كأنها % % تحت السنابك مرمر مسنون % % 47(@)(@@) % فالفيء لا متنقل والحوض لا % % متكدر والمن لا ممنون % % 48(@)(@@) % انظر إلى الدنيا بإشفاق فقد % أرخصت هذا العلق وهو ثمين % % 49(@)(@@) % لو يستطيع البحر لاستعدى على % % جدوى يديك وإنه لقمين % % 50(@)(@@) % أمدده أو فاصفح له عن نيله % فلقد تخوف أن يقال ضنين % % PageV01P348 51(@)(@@) % و أذن له يغرق أمية معلنا % ما كل مأذون له مأذون % % 52(@)(@@) % واعذر أمية أن تغص بريقها % % فالمهل ما سقيته والغسلين % % 53(@)(@@) % ألقت بأيدي الذل ملقى عمرها % % بالثوب إذ فغرت له صفين % % 54(@)(@@) % قد قاد أمرهم وقلد وقلد ثغرهم % منهم مهين لا يكاد يبين % % 55(@)(@@) % لتحكمنك أو تزايل معصما % كف ويشخب بالدماء وتين % % 56(@)(@@) % أولم تشن بها وقائعك التي % % جفلت وراء الهند منها الصين % % 57(@)(@@) % هل غير أخرى صيلم ، إن الذي % % وقاك تلك بأختها لضمين % 58(@)(@@) % بل لو سريت إلى الخليج بعزمة % سرت الكواكب فيه وهي سفين % % 59(@)(@@) % لو لم تكن حزما أناتك لم يكن % للنار في حجر الزناد كمون % % 60(@)(@@) % قد جاء أمر الله واقترب المدى % % من كل مطلع وحان الحين % % PageV01P349 61(@)(@@) % ورمى إلى البلد الأمين بطرفه % ملك على سر الإله أمين % % 62(@)(@@) % لم يدر ما رجم الظنون وإنما % % دفع القضاء إليه وهو يقين % % 63(@)(@@) % كذبت رجال ما دعت من حقكم % % ومن المقال كأهله مأفون % % 64(@)(@@) % أبني لؤي أين فضل قديمكم % % بل أين حلم كالجبال رصين % % 65(@)(@@) % نازعتم حق الوصي ودونه % حرم وحجر مانع وحجون % % 66(@)(@@) % ناضلتموه على الخلافة بالتي % % ردت وفيكم حدها المسنون % 67(@)(@@) % حرفتموها عن أبي السبطين عن % زمع وليس من الهجان هجين % % 68(@)(@@) % لو تتقون الله لم يطمح لها % % طرف ولم يشمخ 
ms113	 لها عرنين % % 69(@)(@@) % لكنكم كنتم كأهل العجل لم % % يحفظ لموسى فيهم هرون % % 70(@)(@@) % لو تسألون القبر يوم فرحتم % لأجاب أن محمدا محزون % % PageV01P350 71(@)(@@) % ماذا تريد من الكتاب نواصب % وله ظهور دونها وبطون % % 72(@)(@@) % هي بغية أضللتموها فارجعوا % % في آل ياسين ثوت ياسين % % 73(@)(@@) % ردوا عليهم حكمهم فعليهم % نزل البيان وفيهم التبين % % 74(@)(@@) % البيت بيت الله وهو معظم % والنور نور الله وهو مبين % % 75(@)(@@) % والستر ستر الغيب وهو محجب % والسر سر الوحي وهو مصون % % 76(@)(@@) % النور أنت وكل نور ظلمة % و الفوق أنت وكل فوق دون % % 77(@)(@@) % لو كان رأيك شايعا في أمة % علموا بما سيكون قبل يكون % % 78(@)(@@) % أو بشرك في شعاع الشمس لم % % يكسف لها عند الشروق جبين % % 79(@)(@@) % أو كان سخطك عدوة في السم لم % % يحمله دون لهاته التنين % % 80(@)(@@) % أم تسكن الدنيا فواق بكية % إلا وأنت لخوفها تأمين % % PageV01P351 81(@)(@@) % الله يقبل نسكنا عنا بما % % يخرضيك من هدي وأنت معين % % 82(@)(@@) % فرضان من صوم وشكر خليفة % هذا بهذا عندنا مقرون % 83(@)(@@) % فارزق عبادك منك فضل شفاعة % واقرب بهم زلفى فأنت مكين % % 84(@)(@@) % لك حمدنا لا أنه لك مفخر % ما قدرك المنثور والموزون % % 85(@)(@@) % قد قال فيك الله ما أنا قائل % فكأن كل قصيدة تضمين % % 86(@)(@@) % الله يعلم أن رأيك في الورى % % مأمون حزم عنده وأمين % % 87(@)(@@) % و لأنت أفضل من تشير بجاهه % تحت المظلة بالسلام يمين % % PageV01P352 البحر : بسيط تام 1(@)(@@) % لا يطعم البيض إلا رأس ذي صيد % أو ساق أدماء فيها النقي بنيان % 2(@)(@@) % فهن للكوم في رأس القرى عقل % وللرؤوس غداة الروع تيجان % PageV01P353 البحر : كامل تام 1(@)(@@) % متهلل والبدر فوق جبينه % يلقاك بشر سماحه من دونه % 2(@)(@@) % و الدين والدنيا جميعا والندى % % و البأس طوع شماله ويمينه % 3(@)(@@) % كالمشرفي العضب شاع فرنده % وجلت مضاربه أكف قيونه % % 4(@)(@@) % جذلان فالآداب في حركاته % والحلم في إطراقه وسكونه % 5(@)(@@) % بادي الرضا وحذار منه معاودا % غضبا يريك الموت بين جفونه % 6(@)(@@) % ومصمم لو ينتحي بلوائه % ريب المنون لكان ريب منونه % % 7 
ms114	(@)(@@) % لين تساس به الخطوب وشدة % والنصل شدة بأسه في لينه % % 8(@)(@@) % و مقارب فيما يروم مباعد % أعيا لبيب القوم جم فنونه % 9(@)(@@) % يجلو له الغيب المستر هاجس % ثقف النباهة ظنه كيقينه % % 10(@)(@@) % حلو الشمائل ما اكتفين براعة % بالحسن حتى زدن في تحسينه % % PageV01P354 11(@)(@@) % فإذا اشرأب إلى القصيد فدره % مكنون در ليس من مكنونه % 12(@)(@@) % غيث العفاة تلوذ منه وفودهم % بأخي السماح وخله وخدينه % % 13(@)(@@) % لو يستطيع هدى الركاب لقصدها % % وأنار ليل الركب ضوء جبينه % % 14(@)(@@) % لا يندب الآمال آمله ولم % % تحلك لنائبة وجوه ظنونه % % 15(@)(@@) % عز الندى بك والرجاء وأهله % و أهنت وفرك فاستعاذ لهونه % % 16(@)(@@) % لتدم خلودا وليعدم لك جعفر % في عز سؤدده وفي تمكينه % 17(@)(@@) % لا يبعدن بادي الصبابة مغرم % حنت كواكب ليله لحنينه % % 18(@)(@@) % يرعاك والأرض الأريضة دونه % من بيده وسهوله وحزونه % % 19(@)(@@) % بهج بتأييد الإله ونصره % صب إليك مولع بشجونه % % 20(@)(@@) % ملك أعز يلاث ثني نجاده % بجديره في يعرب وقمينه % PageV01P355 21(@)(@@) % بهزبر هذا الناس وابن هزبرهم % % وأمين هذا الملم وابن أمينه % % 22(@)(@@) % تلقاه بالإقدام مدرعا فمن % مسرود ماذي ومن موضونه % % 23(@)(@@) % سائل ولاة النكث كيف قفوله % عنهم وكيف إياب أسد عرينه % % 24(@)(@@) % يسري له لجب كأن زهاءه % آذي بحر يرتمي بسفينه % 25(@)(@@) % أنحى لهم خطيه فتهافتت % مهجاتهم تستن من مسنونه % % 26(@)(@@) % و ابتز ما لهم وملكهم وقد % لحظته خزرا كالئات عيونه % 27(@)(@@) % يا رب بكر من ليالي حربه % فيهم يعد مثالها من عونه % % 28(@)(@@) % غزو رمى صم الجبال بعزمه % حتى ألان متونها بمتونه % 29(@)(@@) % يا أيها الموفي بغرة ماجد % تسري بغب السعد غب دجونه % % 30(@)(@@) % أوسعت عبدك من أياد شكرها % % حظان من دنيا الشكور ودينه % % PageV01P356 31(@)(@@) % في حين لم يعدل نداك ندى يد % لكن صبير المزن جاء لحينه % % 32(@)(@@) % من وبله وسكوبه وملثه % وسفوحه ودلوحه وهتونه % % 33(@)(@@) % لم يشف جهد القول منه وإنني % % رهن به وكفيله كرهينه % 34(@)(@@) % حزت الكمال ففيك معنى مشكل % ينبو بيان القول عن تبيينه % % 35(@)(@@) % أقسمت بالبيت العتيق وما حوت % بطحاؤه من 
ms115	 حجره وحجونه % % 36(@)(@@) % ما ذاك إلا أن كونك ناشئا % سبب لهذا الخلق في تكوينه % PageV01P357 البحر : كامل تام 1(@)(@@) % الشمس عنه كليلة أجفانها % % عبرى يضيق بسرها كتمانها % % 2(@)(@@) % لو تستطيع ضياءه لدنت له % % 3(@)(@@) % وأريكها تخبو على برحائها % % لم تخف مذعنة ولا إذعانها % % 4(@)(@@) % إيوان ملك لو رأته فارس % ذعرت وخر لسمكه إيوانها % % 5(@)(@@) % واستعظمت ما لم يخلد مثله % سابورها قدما ولا ساسانها % % 6(@)(@@) % سجدت إلى النيران أعصرها ولو % % بصرت به سجدت له نيرانها % % 7(@)(@@) % بل لو تجادلها به ألبابها % % في الله قام لحسنه برهانها % % 8(@)(@@) % أو ما ترى الدنيا وجامع حسنها % % صغرى لديه وهي يعظم شانها % % 9(@)(@@) % لولا الذي فتنت به لاستعبرت % ثكلى تفض ضلوعها أشجانها % % 10(@)(@@) % خضل البشاشة مرتو من مائها % % فكأنه متهلل جذلانها % % PageV01P358 11(@)(@@) % يندى فتنشأ في تنقل فيئه % غر السحائب مسبلا هطلانها % % 12(@)(@@) % وكأن قدس ويذبلا رفدا ذرى % % أعلامه حتى رست أركانها % % 13(@)(@@) % تغدو القصور البيض في جنباته % صورا إليه يكل عنه عيانها % % 14(@)(@@) % و القبة البيضاء طائرة به % تهوي بمنخرق الصبا أعنانها % % 15(@)(@@) % ضربت بأروقة ترفرف فوقها % % فهوى بفتخ قوادم خفقانها % % 16(@)(@@) % يعشو إلى لمعانها % % في حيث أسلم مقلة إنسانها % % 17(@)(@@) % بطنانها وشي البرود وعصبها % % فكأنما قوهيها ظهرانها % % 18(@)(@@) % نيطت أكاليل بها منظومة % فغدا يضاحك درها مرجانها % % 19(@)(@@) % و تعرضت طرر الستور كأنها % % عذبات أوشحة يروق جمانها % % 20(@)(@@) % و كأن أفواف الرياض نثرن في % % صفحاتها فتفوفت ألوانها % % PageV01P359 21(@)(@@) % فأدر جفونك واكتحل بمناظر % غشى فرند لجيينها عقيانها % % 22(@)(@@) % لترى فنون السحر أمثلة وما % % يدري الجهول لعلها أعيانها % % 23(@)(@@) % مستشرفات من خدور أوانس % مصفوفة قد فصلت تيجانها % % 24(@)(@@) % متقابلات في مراتبها جنت % حربا على البيض الحسان حسانها % % 25(@)(@@) % فاخلع حميدا بينها عذر الصبا % % و ليبد سر ضمائر إعلانها % % 26(@)(@@) % و حباكها كلف الضلوع بحسنها % % ريان جانحة بها ملآنها % % 27(@)(@@) % تساي المحب كلف الضلوع بحسنها % % ثكر النفوس محرما سلوانها % % 28(@)(@@) % ردت على الشعراء ما حاكت لها % % غر القوافي بكرها وعوانها % % 29(@)(@@) % و أتت تجرر في ذيول قصائد % يكفيك عن 
ms116	 سحر البيان بيانها % % 30(@)(@@) % أعيت لبيبا وهي موقع طرفه % فقضى عليه بجهله عرفانها % % PageV01P360 31(@)(@@) % إبراهمية سودد تعزى إلى % % نجر الكرام : جنانها ومعانها % % 32(@)(@@) % فكأنه سيف بن ذي يزن بها % % وكأنها صنعاء أو غمدانها % % 33(@)(@@) % سحبت بها أردانه فتضوعت % عبقا بصائك مسكه أردانها % % 34(@)(@@) % وكأنما لبست شبيبته وقد % غادى الندى متهللا ريعانها % % 35(@)(@@) % و كأنما الفردوس دار قراره % و كأن شافع جوده رضوانها % % 36(@)(@@) % أبدت لمرآك الجليل جلالة % يعلو لمكرمة بذاك مهانها % % 37(@)(@@) % وهفت جوانبها ولولا ما رسا % % من عبء مجدك ما استقر مكانها % % 38(@)(@@) % ولنعم مغنى اللهو ترأم ظله % % آرام وجرة رحن أو أدمانها % % 39(@)(@@) % وتخالها صفراء عارضت الدجى % % وسرت فنادم كوكبا ندمانها % % 40(@)(@@) % قدمت تزايل أعصرا كرت على % % حوبائها لما انقضى جثمانها % % PageV01P361 41(@)(@@) % و أتت على عهد التبابع مدة % غضا على مر الزمان زمانها % % 42(@)(@@) % يمنية الأرباب نجرانية ال % ؛ أنساب حيث سمت بها نجرانها % % 43(@)(@@) % أو كسروية محتد وأرومة % شمطاء يدعى باسمها دهقانها % % 44(@)(@@) % أو قرقف مما تنشي الروم لا % % نشواتها ذمت ولا نشوانها % % 45(@)(@@) % كان اقتناها الجاثليق يكنها % % و يصون درة غائص صوانها % % 46(@)(@@) % في معشر من قومه عثرت بهم % % نوب الزمان فغالهم حدثانها % % 47(@)(@@) % كرمت ثرى متأرجا وتوسطت % أرض البطارق مشرفا أفدانها % % 48(@)(@@) % لم يضرموا نارا لهيبتها ولم % يستطع بأكناف الفضاء دخانها % % 49(@)(@@) % فكأن هيكلها تقدم راية % وكأن صف الدارعين دنانها % % 50(@)(@@) % غنيت تطوف بها ولائدهم كما % % طافت بربات الحجال قيانها % % PageV01P362 51(@)(@@) % قد أوتيت من علمهم فكأنها % % أحبار تلك الكتب أو رهبانها % % 52(@)(@@) % جازتهم ترمد في غلوائها % % فتخرموا وخلا لها ميدانها % % 53(@)(@@) % فكلتك ناجود تدير كؤوسها % % هيف تجاذب قضبها كثبانها % % 54(@)(@@) % من قاصرات الطرف كل خريدة % لم يأت دون وصالها هجرانها % % 55(@)(@@) % لم تدر ما حر الوداع ولا شجت % صبا بمنعرج اللوى أظعانها % % 56(@)(@@) % قد ضرجت بدم الحياء فأقبلت % متظلما من وردها سوسانها % % 57(@)(@@) % تشكو الصفاد لبهرها فكأنما % % رسفان عان دلها رسفانها % % 58(@)(@@) % سامته بعض الظلم وهي غريرة % لا ظلمها يخشى ولا عدوانها % % 59(@)(@@) % فأتته بين قراطق 
ms117	 ومناطق % يثنى على سيرائها خفتانها % % 60(@)(@@) % وإذا ارتمته بما تريش ومكنت % فأصاب أسود قلبه إمكانها % % PageV01P363 61(@)(@@) % لم تدر ما أصمى المليك أنزعها % % بسديد ذاك الرمي أو حسبانها % % 62(@)(@@) % في أريحيات كريعان الصبا % % حركاتها وعلى النهى إسكانها % % 63(@)(@@) % ولئن تلقيت الشباب وعصره % بالملهيات فعصرها وأوانها % % 64(@)(@@) % ولئن أبت لك خفض ذاك ولينه % نفس كهضب عمايتين جنانها % % 65(@)(@@) % فلقبلما أسلتك عن بيض الدمى % % بيض تكسر في الوغى أجفانها % % 66(@)(@@) % و ضرائب تنبي الحسام مضاربا % أردت شراستها فخيف ليانها % % 67(@)(@@) % وأبوة هجرت مقاصر ملكها % % فكأنما أسيافها أوطانها % % 68(@)(@@) % قوم هم أيمهم إقدامها % % و جلادها وضرابها وطعانها % % 69(@)(@@) % وإذا تمطرت الجياد سوابقا % فبهم تكنفها وهم فرسانها % % 70(@)(@@) % و إذا تحدوا بلدة فبزأرهم % % صعقاتها وببأسهم رجفانها % % PageV01P364 71(@)(@@) % آل الوغى تبدو على قسماتهم % أقمارها وتحفهم شهبانها % % 72(@)(@@) % يصلون حر جحيمها إن عردت % أبطالها وتزاورت أقرانها % % 73(@)(@@) % جرثومة منها الجبال الشم لم % % يغضض متالعها ولا ثهلانها % % 74(@)(@@) % ردت إليك فأنت يعربها الذي % % تعزى إليه وجعفر قحطانها % % 75(@)(@@) % فافخر بتيجان الملوك وملكها % % فلأنت غير مدافع خلصانها % % 76(@)(@@) % لله أنت مواشكا عجلا إلى % % جدوى يد مد الفرات بنانها % % 77(@)(@@) % يفديك ذو سنة عن الآمال لم % % يألف مضاجع سؤدد وسنانها % % 78(@)(@@) % ترد الأماني الخمس منه مشارعا % ملء الحياض محللأ ظمآنها % % 79(@)(@@) % من كل عاري الليت من نظم التي % % رجحت بخير تجارة أثمانها % % 80(@)(@@) % يدني السؤال إليه عامل صعدة % متغلغل بين الشغاف سنانها % % PageV01P365 81(@)(@@) % أعلتك عنهم همة لم يعتلق % مثنى النجوم بها ولا وحدانها % % 82(@)(@@) % دانيت أقطار البلاد بعزمة % ملقى وراء الخافقين جرانها % % 83(@)(@@) % و هي الأقاصي من ثغور الملك لا % % تخشى مخاوفها وأنت أمانها % % 84(@)(@@) % متقلدا سيف الخلافة للتي % % يلقى إليه إذا استمر عنانها % % 85(@)(@@) % تزجى الجياد إلى الجلاد كأنما % % سرعان واردة القطا سرعانها % % 86(@)(@@) % وتهز ألوية الجنود خوافقا % تحت العجاج كواسرا عقبانها % % 87(@)(@@) % حتى إذا حرجت به أرض العدى % % متمطيا وتضايقت أعطانها % % 88(@)(@@) % ألقت مقاليدا إليه وقبله % ما انفك خالعها ولا خلعانها % % 89(@)(@@) % لا قلت إن الدين والدنيا له 
ms118	 % عوض ولؤم مقالة بهتانها % % 90(@)(@@) % أمد المطالب والوفود إذا حدت % فوت العيون ركابها ركبانها % % PageV01P366 91(@)(@@) % ألف الندى دأبا عليه كأنه % رتك المطي إليه أو وخدانها % % 92(@)(@@) % غفار موبقة الجرائم صافح % و سجية من ماجد غفرانها % % 93(@)(@@) % شيم إذا ما القول حن تبرعت % كرما فأسجح عطفها وحنانها % % 94(@)(@@) % إني وإن قصرت عن شكريه لم % % يغمط لدي صنيعة كفرانها % % 95(@)(@@) % كنت الوليد فلم ينازعه بنو % % خاقان مكرمة ولا خاقانها % % 96(@)(@@) % منن كباكرة الغمام كفيلة % بالنجح موقوف عليه ضمانها % % 97(@)(@@) % يا ويلتا مني علي أمخرسي % % إحسانها أو مغرقي طوفانها % % 98(@)(@@) % ما لي بها إلا احتراق جوانحي % % يدني إليك ودادها حرنها % % 99(@)(@@) % دامت لنا تلك العلى متفيئا % أظلالها متهدلا أفنانها % % 100(@)(@@) % واسلم لغض شبيبة ولدولة % عزت وعز مؤيدا سلطانها % % PageV01P367 البحر : كامل تام 1(@)(@@) % كفي فأيسر من مرد عناني % % وقع الأسنة في كلى الفرسان % 2(@)(@@) % ليس ادخار البدرة النجلاء من % % شيمي ولا منع اللهى من شاني % % 3(@)(@@) % هل للفتى في العيش من مندوحة % إلا اصطفاء مودة الإخوان ؟ % 4(@)(@@) % و إذا الجواد جرى على عاداته % فذر الجواد وغاية الميدان % 5(@)(@@) % لا أرهب الإعدام بعد تيقني % % أن الغنى شجن من الأشجان % % 6(@)(@@) % ملأت يدي دلوي إلى أوذامها % % و أعرت للعافي قوى أشطاني % % 7(@)(@@) % و لقد سمعت الله يندب خلقه % جهرا إلى الإفضال والإحسان % 8(@)(@@) % و إذا نجا من فتنة الدنيا امرؤ % فكأنما ينجو من الطوفان % 9(@)(@@) % يأبى لي الغدر الوفاء بذمتي % % و الذم آباه كما يأباني % % 10(@)(@@) % إني لآنف أن يميل بي الهوى % % أو أن يراني الله حيث نهاني % % PageV01P368 11(@)(@@) % حزب الإمام من الورى حزبي إذا % % عدوا وخلصان الهدى خلصاني % % 12(@)(@@) % لا تبعدن عصابة شيعية % ظفروا ببغيتهم من الرحمن % 13(@)(@@) % قوم إذا ماج البرية والتقى % % خصمان في المعبود يختصمان % 14(@)(@@) % تركوا سيوف في أغمادها % % وتقلدوا سيفا من القرآن % 15(@)(@@) % عقدوا الحبى بصدور مجلسهم كمن % عرف المعز حقيقة العرفان % 16(@)(@@) % قد شرف الله الورى بزمانه % حتى الكواكب والورى سيان % 17(@)(@@) % و كفى بمن ميراثه الدنيا ومن % % خلقت له 
ms119	 وعبيده الثقلان % 18(@)(@@) % و كفى بشيعته الزكية شيعة % و كفى بهم في البر من صنوان % 19(@)(@@) % عصمت جوارحهم من العدوى كما % % وقيت جوانحهم من الأضغان % 20(@)(@@) % قد أيدوابالقدس إلا أنهم % قد أونسوا بالروح والريحان % PageV01P369 21(@)(@@) % لله درهم بحيث لقيتهم % إن الكرام كريمة الأوطان % 22(@)(@@) % يغشون نادي أفلح فكأنما % % يفشون رب التاج من عدنان % 23(@)(@@) % حيوا جلالة قدره فكأنما % % حيوا أمين الله في الإيوان % 24(@)(@@) % يردون جمة علمه ونواله % فكأنهم حيث التقى البحران % 25(@)(@@) % حفت به شفعاؤهم واستمطروا % % من جانبيه سحائب الغفران % 26(@)(@@) % ورأوه من حيث التقت أبصارهم % متصورا في صورة البرهان % 27(@)(@@) % تنبو عقول الخلق عن إدراكه % وتكل عنه صحائح الأذهان % 28(@)(@@) % تستكبر الأملاك قبل لقائه % وتخر حين تراه للأذقان % 29(@)(@@) % أبلغ أمير المؤمنين على النوى % % قولا يريه نصيحتي ومكاني % % 30(@)(@@) % إن السيوف بذي الفقار تشرفت % ولقل سيف مثل أفلح ثان % PageV01P370 31(@)(@@) % قد كنت أحسبني تقصيت الورى % % وبلوت شيعة أهل كل زمان % 32(@)(@@) % فإذا موالاة البرية كلها % % جمعت له في السر والإعلان % % 33(@)(@@) % و إذا الذين أعدهم شيعا إذا % % قيسوا إليه كعبد الأوثان % % 34(@)(@@) % نضحت حرارة قلبه بمودة % ضربت عليه سرادق الإيمان % 35(@)(@@) % وحنا جوانح صدره مملوءة % علما بما يأتي من الحدثان % 36(@)(@@) % يتبرك الروح الزكي بقربه % نسكا ويروي مهجة الهيمان % % 37(@)(@@) % أمعز أنصار المعز من الورى % % والمنزل النصاب دار هوان % 38(@)(@@) % بك دان ملك المشرقين وأهله % وأناب بعد النكث والخلعان % 39(@)(@@) % و إنا وجدنا فتح مصر آخرا % لك ذكره في سالف الأزمان % 40(@)(@@) % فبعرمك انهدت قوى أركانها % % وبقربك امتدت إلى الإذعان % PageV01P371 41(@)(@@) % وطأت بالغارات مركب عزها % % والجيش حتى ذل للركبان % 42(@)(@@) % فإليك ينسب حيث كنت وإنما % % فخر الصلي لقادح النيران % 43(@)(@@) % عصفت على الأعراب منك زعازع % سكفت دم الأقران بالأقران % 44(@)(@@) % ما قر أعين آل قرة مذ سقوا % % بك ما سقوه من الحميم الآني % % 45(@)(@@) % وقبيلة قتلتها وقبيلة % أثكلتها بالبرك في الأعطان % 46(@)(@@) % أخلى البحيرة منهم والبيد ما % % خسف الصعيد بشدة الرجفان % 47(@)(@@) % فشغلت أهل الخيم عن تطنيبها % % وأسمتهم 
ms120	 شردا مع الظلمان % 48(@)(@@) % وسمت إلى الواحات خيلك ضمرا % حتى انتهت قدما إلى أسوان % 49(@)(@@) % قد ظاهروا لبد الدروع عليهم % إني مدحتك مخلصا % 50(@)(@@) % وغدوا حوالي مترف لا ينثني % % علماه عن إنس ولا عن جان % PageV01P372 51(@)(@@) % فكأن دينك يوم أردى كفره % أجل بطشت له بعمر فان % 52(@)(@@) % وكأن أسراب الجياد ضحى وقد % % خفت إليه كواسر العقبان % 53(@)(@@) % عطفت عليه صدورها وكأنما % % عطفت على كسرى أنو شروان % 54(@)(@@) % وكأنما البراض صبح أهله % وكأن هجائن النعمان % 55(@)(@@) % ظلت سيوفك وهي تأخذث روحه % كالنار تلفحه بغير دخان % 56(@)(@@) % حكمت بسعد المشتري لك ساعة % حكمت له بالنحس من كيوان % 57(@)(@@) % فأتى جيوشك إذ أتته كأنه % % 58(@)(@@) % فعجبت كيف تخالف القدران في % % عقباهما وتشابه الأملان % 59(@)(@@) % رعت الأوابد في الفدافد فجأة % بعجارف الرديان والوخدان % 60(@)(@@) % وتعوذ الشيطان منك وكيده % لما ذعرت جزيرة الشيطان % PageV01P373 61(@)(@@) % سارت جيادك في الفلا سير القطا % % يحملن ظلمانا على ظلمان % 62(@)(@@) % ضمنت صهوة كل طرف مثله % وحملت سرحانا على سرحان % 63(@)(@@) % في مهمه ، ما جابه الركبان مذ % طردت من الدنيا بنو مروان % 64(@)(@@) % لو سار فيه الشنفرى فترا لما % % حملته في وعسائه قدمان % % 65(@)(@@) % يجتبن كل ملمع بالآل ما % % للجن بالتعريس فيه يدان % 66(@)(@@) % خضن الظلام إليه ثم اجتنبه % ومرقن من سجفيه كالحسبان % 68(@)(@@) % كم غلن من مستكبر في قومه % % متمنع بالعز والسلطان % 69(@)(@@) % أو في دروع البأس من مستلئم % أو في ثياب الخز من نشوان % 70(@)(@@) % باتت تحييه سقاة مدامة % فغدت تحييه سقاة طعان % 71(@)(@@) % يهوي السنان إليه وهو يظنه % كأس الصبوح على يد الندمان % PageV01P374 72(@)(@@) % ولكم سلبت بها عزيزا تاجه % وتركت فيها من عبيط قان % % 73(@)(@@) % ومجدلا فوق الثرى ونجيعه % و الروح من ودجيه مختلطان % 74(@)(@@) % وكم استبحن وكم أبحنك من حمى % وحقوف رمل في معاطف بان % 75(@)(@@) % و كواعب محفوفة بعصائب % قد كللت بالدر والمرجان % 76(@)(@@) % و المسك يعبق في البرود كأنها % % زهر الربيع مفوف الألوان % 77(@)(@@) % لم يبق إلا السد تخرق ردمه % فلقد أطاعك في الورى العصران 