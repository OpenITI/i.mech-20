ms121	 آنان فزونم به شیرین زبانی(@)(@@) 59 نه نیز از تو آن خواسته چشم دارم %~% که باشد بدان مر ترا بازمانی(@)(@@) 60 من از تو همی مال توزیع خواهم %~% بدین خاصگانت یگان و دوگانی(@)(@@) 61 بیندیش از آن روز کاندر مظالم %~% به توزیع کردی مرا میزبانی(@)(@@) 62 کسی کو کند میزبانی کسی را %~% نباید که بگریزد از میهمانی(@)(@@) 63 الا تا ببارد سرشک بهاری %~% الا تا بروید گل بوستانی(@)(@@) 64 بزی با امانی و حور قبایی %~% به رود غوانی و لحن اغانی(@)(@@) 65 بر آن وزن این شعر گفتم که گفته‌ست %~% ابوالشیص اعرابی باستانی(@)(@@) 66 اشاقک و اللیل ملقی الجران %~% غراب ینوح علی غصن بان PageV1P83(@)(@@)(@@)(@@) || [genre: Qt](@)(@@) 1 صنما! گرد سرم چند همی‌گردانی %~% زشتی از روی نکو زشت بود گر دانی(@)(@@) 2 یا بکن آنچه شب و روز همی وعده دهی %~% یا مکن وعده هر آن چیز که آن نتوانی(@)(@@) 3 از حد و غایت نافرمانی در مگذر %~% که پدیدارست اندازه نافرمانی(@)(@@) 4 دل من بردی و از خویشتنم دور کنی %~% برنیاید صنما کار بدین آسانی(@)(@@) 5 مهربانی نکنی بر من و مهرم طلبی %~% ندهی داد و همی‌داد ز من بستانی(@)(@@) 6 بی‌وفایی کنی و نادان سازی تن خویش %~% نیستی‌ای بت یکباره بدین نادانی(@)(@@) 7 نبوی راضی گر زانکه امیرت خوانم %~% من بدان راضی باشم که غلامم خوانی(@)(@@) 8 از تو ما را نه کنار و نه پیام و نه سلام %~% مکن ای دوست که کیفر بری و درمانی(@)(@@) 9 گویی: اندر دل پنهانت همی‌دارم دوست %~% به بود دشمنی از دوستی پنهانی(@)(@@) 10 مکن ای دوست که بیداد نشانی نگذاشت %~% عدل باز آمد با بوالحسن عمرانی(@)(@@) 11 خواجه و سید سادات رئیس الرؤسا %~% همچو خورشید به بخشندگی و رخشانی PageV1P84(@)(@@)(@@)(@@) || [genre: Qt](@)(@@) 1 نوروز روزگار نشاطست و ایمنی %~% پوشیده ابر دشت به دیبای ارمنی(@)(@@) 2 بر یاسمین عصابه در منضد است %~% بر ارغوان طویله یاقوت معدنی(@)(@@) 3 خیل بهار خیمه به صحرا 
ms122	 برون زند %~% واجب کند که خیمه به صحرا برون‌زنی(@)(@@) 4 از بامداد تا به شبانگاه می خوری %~% وز شامگاه تا به سحرگاه گل چنی(@)(@@) 5 بر ارغوان قلاده یاقوت بگسلی %~% بر مشک بید نایژه عود بشکنی(@)(@@) 6 بر گل همی‌نشینی و بر گل همی‌خوری %~% بر خم همی‌خرامی و بر دن همی‌دنی(@)(@@) 7 درست ناخریده و مشکست رایگان %~% هر چند برفشانی و هر چند برچنی(@)(@@) 8 نرگس همی رکوع کند در میان باغ %~% زیرا که کرد فاخته بر سرو مؤذنی(@)(@@) 9 دارد خجسته غالیه دانی ز سندروس %~% چون نیمه‌ای به عنبر سارا بیاکنی(@)(@@) 10 نرگس بسان کفه سیمین ترازوییست %~% چون زر جعفری به میانش درافکنی(@)(@@) 11 ماند به سینه و دم طاووس شاخ گل %~% چون مشک و در دانه بدو در پراکنی(@)(@@) 12 دو رویه گل چو دایره از سرخ دیبه است %~% چون پشت او به رشته زرین بیاژنی(@)(@@) 13 باطنش هست دیگر و ظاهرش دیگرست %~% گویی شده‌ست این گل دور وی باطنی(@)(@@) 14 نرگس بسان چرخ به شش پره آسیا %~% آن چرخ آسیا که ستون زمردین کنی(@)(@@) 15 چرخش ز زر زرد کنی وانگهی درو %~% دندانه بلورین گردش فرو کنی(@)(@@) 16 شاخ بنفشه بر سر زانو نهاده سر %~% ماننده مخالف بوسهل زوزنی(@)(@@) 17 شیخ‌العمید سید صاحب که ذوالجلال %~% نعمتش داد و صحت تن داد و ایمنی(@)(@@) 18 هرگز منی نکرد و رعونت ز بهر آنک %~% رسوا کند رعونت و رسوا کند منی(@)(@@) 19 از همت بلند بدین مرتبت رسید %~% هرگز به مرتبت نرسد مردم دنی(@)(@@) 20 او را ز ریمنی گهر پاک باز داشت %~% ممکن نباشد از گهر پاک ریمنی(@)(@@) 21 آید به سوی او ز همه خلق محمدت %~% چون با نشیمن آید مرغ نشیمنی(@)(@@) 22 از جام انگبین نترابد جز انگبین %~% از نفس او نیاید الا لطف کنی(@)(@@) 23 هست او شریف و همت او همچو او شریف %~% هست اوسنی و همت او همچو اوسنی(@)(@@) 24 رای موافق و 
ms123	 نیت و اعتقاد او %~% از روزگار توسن برداشت توسنی(@)(@@) 25 هستند شاه را خلفای دگر جز او %~% لیکن به کام اوست دل شاه معتنی(@)(@@) 26 خورشید را ستاره بسی هست بر فلک %~% لیکن به ماه باز دهد نور و روشنی(@)(@@) 27 احسان شهریار به تعلیم نیک اوست %~% چون قوت بهار به باران بهمنی(@)(@@) 28 ای ذونسب به اصل خود و ذوفنون به علم %~% کامل تو در فنون زمانه چو یک فنی(@)(@@) 29 با عز مشک ویژه و با قدر گوهری %~% با جاه زرساوی و با نفع آهنی(@)(@@) 30 نامردمی نورزی و ورزی تو مردمی %~% ناگفتنی نگویی و گویی تو گفتی(@)(@@) 31 خرمن ز مرغ گرسنه خالی کجا بود %~% ما مرغکان گرسنه تو بار خرمنی(@)(@@) 32 تا حرف بی‌نقط بود و حرف با نقط %~% تا خط مستوی بود و خط منحنی(@)(@@) 33 عمر و تن تو باد فزاینده و دراز %~% عیش خوش تو باد گوارنده و هنی PageV1P85(@)(@@)(@@)(@@) || [genre: Qt](@)(@@) 1 یکی سخنت بگویم گر از رهی شنوی %~% یکی رهت بنمایم اگر بدان بروی(@)(@@) 2 سبوی بگزین تا گردی از مکاره دور %~% برو بدان ره تا جاودانه شاد بوی(@)(@@) 3 ایا کریم زمانه! علیک عین‌الله %~% تویی که چشمه خورشید را به نور ضوی(@)(@@) 4 تویی که فاتح مغموم این سپهر بوی %~% تویی که کاشف مکروه این زمانه شوی(@)(@@) 5 اگر ز هیبت تو آتشی برافروزند %~% برآسمان بر استارگان شوند شوی(@)(@@) 6 به نیکویی نگری گر همی به کس نگری %~% به مردمی گروی گر همی به کس گروی(@)(@@) 7 عذاب دوزخ آنجا بود کجا تو نیی %~% ثواب جنت آنجا بود کجا تو بوی(@)(@@) 8 برند آن تو هر کس تو آن کس نبری %~% دوند زی تو همه کس تو زی کسی ندوی(@)(@@) 9 اگر قوام زمانه برآفتاب بود %~% تو آن زمانه قوامی که آفتاب توی(@)(@@) 10 نیاید از تو بخیلی چو از رسول دروغ %~% دروغ بر تو نگنجد جو بر خدای دوی(@)(@@) 11 
ms124	 سخاوت تو و رای بلند و طالع و طبع: %~% نه منقلب نه مخالف نه منکسف نه غوی(@)(@@) 12 وفا و همت و آزادگی و دولت و دین: %~% نکوی و عالی و محمود و مستوی و قوی(@)(@@) 13 چو بو شعیب و خلیل و چو قیس و عمرو و کمیت %~% به ذوق و وزن عروض و به نظم و نثر و روی(@)(@@) 14 چو ابن رومی شاعر چو ابن‌مقله دبیر %~% چو ابن‌معتز نحوی چو اصمعی لغوی(@)(@@) 15 بلا و نعمت و اقبال و مردمی و ثنای %~% بری و آری و توزی و کاری و دروی(@)(@@) 16 به مردمی تو اندر زمانه مردم نیست %~% که رای تو به علوست و باب تو علوی(@)(@@) 17 ز همت و هنر تو شگفت ماندستم %~% که ایمنی تو بر او و بر آسمان نشوی(@)(@@) 18 به مشتریت گمانی برم به همت و طبع %~% که همچو هور لطیفی و همچو نور قوی(@)(@@) 19 به گاه خلعت دادن به گاه صله شعر %~% نه سیم تو ملکی و نه زر تو هروی(@)(@@) 20 مدیح تو متنبی به سر نیارد برد %~% نه بوتمام و نه اعشی قیس و نه طهوی(@)(@@) 21 بزرگوارا! نام‌آورا! خداوندا! %~% حدیث خواهم کردن به تو یکی نبوی(@)(@@) 22 حدیث رقعه توزیع برتو عرضه کنم %~% چنانکه عرضه کند دین به مانوی منوی(@)(@@) 23 هزار سال همیدون بزی به پیروزی %~% به مردمی و به آزادگی و نیکخوی PageV1P86(@)(@@)(@@)(@@) || [genre: Qt](@)(@@) 1 آفرین زان مرکب شبدیز فعل رخش خوی %~% اعوجی مادرش و آن مادرش را یحموم شوی(@)(@@) 2 گاه بر رفتن چو مرغ و گاه پیچیدن چو مار %~% گاه رهواری چو کبک و گاه برجستن چو گوی(@)(@@) 3 چون نهنگان اندرآب و چون پلنگان بر جبال %~% چون کلنگان در هوا و همچو طاووسان به کوی(@)(@@) 4 در شود بی‌زخم و زجر و در شود بی‌ترس و بیم %~% همچو آذرشست بتش همچو مرغابی به جوی(@)(@@) 5 پی ز قوس و فش 
ms125	 ز درع و رگ ز موی و تن ز کوه %~% سر ز نخل و دم ز حبل و برزسنگ و سم ز روی(@)(@@) 6 دیر خواب و زود خیز و تیز سیر و دور بین %~% خوش عنان و کش خرام و پاکزاد و نیکخوی(@)(@@) 7 سخت پای و ضخم ران و راست دست و گرد سم %~% تیزگوش و پهن پشت و نرم چرم و خرد موی(@)(@@) 8 ابر سیر و باد گرد و رعد بانگ و برق جه %~% کوه کوب و سهل بر و شخ نورد و راهجوی(@)(@@) 9 گور ساق و شیر زهره یوز تاز و غرم تک %~% پیل گام و کرگ سینه رنگ تاز و گرگ پوی(@)(@@) 10 تیزچشم آهن جگر فولاد دل کیمخت لب %~% سیم دندان چاه بینی ناوه کام و لوح روی(@)(@@) 11 نیزه و تیغ و کمند و ناچخ و تیر وکمان %~% گردن و گوش و دم و سم و زهار و ساق اوی(@)(@@) 12 اینچنین اسبی مرا داده‌ست بی زین شهریار %~% اسب بی‌زین همچنان باشد که بی‌دسته سبوی PageV1P87(@)(@@)(@@)(@@) || [genre: Qt](@)(@@) 1 اندر آمد نوبهاری چون مهی %~% چون بهشت عدن شد هر مهمهی(@)(@@) 2 بر سر هر نرگسی ماهی تمام %~% شش ستاره بر کنار هر مهی(@)(@@) 3 یا چو سیم اندوده شش ماه بدیع %~% حلقه حلقه گرد زر ده دهی(@)(@@) 4 بامدادان بر هوا قوس قزح %~% بر مثال دامن شاهنشهی(@)(@@) 5 پنج دیبای ملون بر تنش %~% باز جسته دامن هر دیبهی(@)(@@) 6 هر کجا پویی ز مینا خرمنی‌ست %~% هر کجا جویی ز دیبا خرگهی(@)(@@) 7 نرگس تازه میان مرغزار %~% همچو در سیمین زنخ زرین چهی(@)(@@) 8 سرو بالا دار هم پهلوی مورد %~% چون درازی در کنار کوتهی(@)(@@) 9 بوستان‌افروز پیش ضیمران %~% چون نزاری پیش روی فربهی(@)(@@) 10 بر سر هر شاخساری مرغکی %~% بر زبان هر یکی بسم‌اللهی(@)(@@) 11 بوستان ماننده معشوق میر %~% با دگرگونه لباسی هر گهی(@)(@@) 12 میر نیکوکار و میر حقشناس %~% مهربانتر میر 
