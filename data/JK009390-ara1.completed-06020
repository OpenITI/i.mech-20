ms6001	 ، فقال : يا فلان إرجع إلاى منزلك ، فوالله لا أؤذيك أبدا ) . ( هب ) . )(@)(@@)(@@)(@@) $ 10555 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( كان رسول الله يقول : اللهم إني أعوذ بك من جار السوء في دار إقامة ، فإن جار البادية يتحول ) . ( كر ) . )(@)(@@)(@@)(@@) $ 10556 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( قالوا : يا رسول الله إن فلانة تصوم النهار ، وتقوم الليل وتؤذي جيرانها ، قال : هي في النار ، قالوا : يا رسول الله PageV17P405 إن فلانة تصلي المكتوبة ، وتصدق بالأثوار من الأقط ، ولا تؤذي جيرانها ، قال : هي في الجنة ) . ( ابن النجار ) . )(@)(@@)(@@)(@@) $ 10557 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( أشد الناس علاى الرجل يوم القيامة مملوكه ) . ( عب ) . )(@)(@@)(@@)(@@) $ 10558 عن أبي هريرة رضي الله عنه ، عن النبي قال :(@)(@@) | 30 ( أطعموهم مما تأكلون ، وألبسوهم مما تلبسون ، وما تعسر عليكم فبيعوه ، ولا تعذبوا خلق الله يعني : المملوكين ) . ( ابن النجار ) . )(@)(@@)(@@)(@@) $ 10559 عن أبي هريرة رضي الله عنه :(@)(@@) | 30 ( أن رجلا سلم علاى النبي فقال : وعليك السلام ) . ( ابن جرير في تهذيبه ) . )(@)(@@)(@@)(@@) $ 10560 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( جلس عند رسول الله رجلان ، أحدهما أشرف من الآخر ، فعطس الشريف ولم يحمد الله ، فلم يشمته رسول الله ، وعطس الآخر فحمد الله تعالاى ، فشمته رسول الله ، فقال الشريف : عطست فلم تشمتني ، وعطس هاذا فشمته ، فقال : إنك نسيت الله تعالاى فنسيتك ، وهاذا ذكر الله تعالاى فذكرته ) . ( ابن شاهين ) . )(@)(@@)(@@)(@@) $ 10561 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( إن الله يحب العطاس ويكره التثاؤب ، فإذا قال أحدكم : هاه هاه ، فإنما ذالك الشيطان يضحك في جوفه ) . ( عب ) . )(@)(@@)(@@)(@@) $ 10562 عن أبي هريرة رضي الله عنه ، عن النبي قال :(@)(@@) | 30 ( لما خلق الله تعالاى آدم عطس فألهمه ربه أن قال : الحمد لله ، قال له ربه تعالاى : رحمك ربك ، فذالك سبقت رحمته غضبه ، ثم إن الله تعالاى قال : إئت الملائكة فسلم عليهم ، PageV17P406 فأتاهم فقال : السلام عليكم ، فقالوا : السلام عليك ورحمة الله ، فزادوه ورحمة الله ) . ( هب ) . )(@)(@@)(@@)(@@) $ 10563 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( جلس عند 
ms6002	 النبي رجلان ، أحدهما أشرف من الآخر ، فعطس الشريف فلم يحمد الله تعالاى ، فلم يشمته النبي ، وعطس الآخر ، فحمد الله تعالاى ، فشمته النبي ، فقال الشريف : يا رسول الله عطست فلم تشمتني ، وعطس هاذا فشمته ، فقال : إن هاذا ذكر الله عز وجل فذكرته ، وإنك نسيت الله تعالاى فنسيتك ) . ( حم ، هب ) . )(@)(@@)(@@)(@@) $ 10564 عن أبي هريرة رضي الله عنه ، عن النبي :(@)(@@) | 30 ( أنه كان إذا عطس يخفض صوته ، واستتر بثوب أو يده ) . ( هب ) . )(@)(@@)(@@)(@@) $ ( 10565 ) عن أبي هريرة رضي الله عنه : ' أن رسول الله صلى الله عليه وسلم كان يكره العطسة الشديدة في المسجد ' . ( عد ، هب ) .(@)(@@)(@@)(@@) $ 10566 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( شمت أخاك ثلاثا ، فما زاد فهو زكام ) . ( د ، هب ) . )(@)(@@)(@@)(@@) $ 10567 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( رفع الحديث إلاى النبي بمعناه ) . ( د ، هب ) . )(@)(@@)(@@)(@@) $ 10568 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( كان رسول الله إذا عطس غطى وجهه بثوبه ، ووضع كفيه علاى حاجبيه ) . ( ابن النجار ) . )(@)(@@)(@@)(@@) $ 10569 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( إذا عطس الرجل فليقل : الحمد لله علاى كل حال ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 10570 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( عطس عند النبي رجلان ، PageV17P407 أحدهما أشرف من الآخر ، فعطس الشريف فلم يحمد الله تعالاى ، فلم يشمته النبي ، وعطس الآخر فحمد الله تعالاى ، فشمته النبي ، فقال الشريف : عطست عندك فلم تشمتني ، وعطس هاذا فشمته ، فقال : هاذا ذكر الله تعالاى فذكرته ، وإنك نسيت الله تعالاى فنسيتك ) . ( ابن النجار ، حم ، هب ) . )(@)(@@)(@@)(@@) $ 10571 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( الأذنان من الرأس ) . ( عب ) . )(@)(@@)(@@)(@@) $ 10572 عن أبي هريرة رضي الله عنه :(@)(@@) | 30 ( أن النبي توضأ غرفة غرفة وقال : لا يقبل الله صلاة إلا به ) . ( كر ) . )(@)(@@)(@@)(@@) $ 10573 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : ( من كان يؤمن بالله واليوم الآخر ، فلا يقعد علاى مائدة يشرب عليها الخمر ) . ( ابن النجار ) . )(@)(@@)(@@)(@@) $ 10574 عن أبي هريرة رضي الله عنه :(@)(@@) | 30 ( أن رسول الله توضأ مرتين مرتين 
ms6003	 ) . ( ش ) . )(@)(@@)(@@)(@@) $ 10575 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( أمرنا رسول الله بتغطية الوضوء ، وإيكاء السقاء ، وإكفاء الاناء ) . ( ص ) . )(@)(@@)(@@)(@@) $ 10576 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( ليكن إذا توضأت أول ما تبدأ به أن تستنشق ، فإنه منفرة للشيطان ، أو مقمعة ) . ( عب ) . )(@)(@@)(@@)(@@) $ 10577 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( قال النبي : يا أبا هريرة إذا توضأت فقل : بسم الله ، والحمد لله ، فإن حفظتك لا تستريح تكتب لك الحسنات حتى تحدث من ذالك الوضوء ) . ( طس ) . )(@)(@@)(@@)(@@) $ 10578 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( كان رسول الله إذا توضأ بدأ بميامنه ) . ( ابن النجار ) . )(@)(@@) PageV17P408(@)(@@)(@@)(@@) $ 10579 عن أبي هريرة رضي الله عنه :(@)(@@) | 30 ( أن النبي أمر بالمضمضة والاستنشاق ) . ( كر ) . )(@)(@@)(@@)(@@) $ 10580 قال الديلمي في مسند الفردوس : أنبأنا محمد بن طاهر الحافظ ، أنبأنا أبو القاسم حبيش الموصلي ، أنبأنا أبو الحسن بن نحشل ، حدثني أبو بكر محمد بن علي بن جابر بتنيس ، حدثنا أبو الحسن بن حجر العسقلاني ، حدثني محمد بن عبد الله الصنابحي ، عن أبيه ، عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : ( إذا توضأتم فأشربوا أعينكم الماء من الوضوء ، ولا تنفضوا أيديكم فإنها مراوح الشيطان ) . )(@)(@@)(@@)(@@) $ 10581 عن أبي هريرة رضي الله عنه :(@)(@@) | 30 ( أن النبي كان لا ينام ليلة ولا يبيت حتى يستن ) . ( كر ) . )(@)(@@)(@@)(@@) $ 10582 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( من استحق النوم فعليه الوضوء ) . ( عب ، ص ) . )(@)(@@)(@@)(@@) $ 10583 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( لا وضوء إلا من حدث ، فساء أو ضراط ) . ( ص ) . )(@)(@@)(@@)(@@) $ 10584 عن جعفر بن برقان قال :(@)(@@) | 30 ( كان أبو هريرة رضي الله عنه يتوضأ مما مسته النار ، فبلغ ذالك ابن عباس رضي الله عنهما فأرسل إليه فقال : أرأيت إن أخذت دهنة طيبة فدهنت بها لحيتي أكنت مترضئا ؟ فقال أبو هريرة : يا ابن أخي إذا حدثت بالحديث عن رسول الله فلا تضرب له الأمثال جدلا ) . ( عب ) . )(@)(@@)(@@)(@@) $ 10585 عن أبي هريرة رضي الله عنه :(@)(@@) | 30 ( أن رسول الله قال : إنما أنا 
ms6004	 لكم مثل الوالد للولد ، إذا أتيتم الغائط فلا تستقبلوا القبلة ولا تستدبروها ، وأمر بثلاثة PageV17P409 أحجار ، ونهاى عن الروث والرمة يعني العظام ونهاى أن يستطيب الرجل بيمينه ) . ( عب ) . )(@)(@@)(@@)(@@) $ 10586 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : إنما أنا لكم كالوالد لولده أعلمكم ، إذا أتاى أحدكم الغائط فلا يستقبل القبلة ولا يستدبرها ، وإذا استطاب فلا يستطب بيمينه ، وكان يأمر بثلاثة أحجار ، وينهاى عن الروث والرمة وهي العظم ) . ( ص ) . )(@)(@@)(@@)(@@) $ 10587 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( دخل أعرابي المسجد ورسول الله فيه ، فبال ، فأمر بسجل من ماء فأفرغ علاى بوله ) . ( ش ) . )(@)(@@)(@@)(@@) $ 10588 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( سئل النبي عن الفأرة تقع في السمن ؟ فقال : إذا كان جامدا فألقوها وما حولها ، وإن كان مائعا فلا تقربوه ) . ( عب ) . )(@)(@@)(@@)(@@) $ 10589 عن أبي هريرة رضي الله عنه :(@)(@@) | 30 ( أنه سئل عن سؤر طهور المرأة تطهر منه ؟ فقال : إن كنا لننفر حوحل قصعتنا نغتسل منها كلانا ) . ( ش ) . )(@)(@@)(@@)(@@) $ 10590 عن عون بن عبد الله قال :(@)(@@) | 30 ( كنا عند أبي هريرة رضي الله عنه وهم يستفتونه ، فقال أعرابي : إني لأراهم لو استفتوك أفتيتهم في الخراءة ، قال : وأنا أفتيك : يا ابن أخي أنهاك عن الملاعن : قارعة الطريق ، وظل الحائط ، وظل الشجرة حيث ينزل المسافر ) . ( عب ) . )(@)(@@)(@@)(@@) $ 10591 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( إذا غابت المدورة فقد وجب الغسل ) . ( ص ) . )(@)(@@)(@@)(@@) $ 10592 عن أبي هريرة رضي الله عنه :(@)(@@) | 30 ( سأله رجل كم أفيض علاى رأسي PageV17P410 وأنا جنب ؟ قال : كان رسول الله يحثو علاى رأسه ثلاث حثيات ، فقال الرجل : إن شعري طويل ، فقال : كان رسول الله أكثر شعرا منك وأطيب ) . ( ش ) . )(@)(@@)(@@)(@@) $ 10593 عن أبي هريرة رضي الله عنه : $ 30 ( أنه نهاى أن يغتسل الرجل والمرأة من إناء واحد(@)(@@) ) . ( ص ) . ) $(@)(@@)(@@)(@@) $ 10594 عن أبي هريرة رضي الله عنه :(@)(@@) | 30 ( أنه كان يكره أن يدخل الجنب يده في الماء ) . ( عب ) . )(@)(@@)(@@)(@@) $ 10595 عن أبي هريرة رضي الله عنه يبلغ به عن النبي :(@)(@@) | 30 ( أن من كانت 
ms6005	 به جنابة فلا يرقدن حتى يتوضأ وضوءه للصلاة ) . ( ص ) . )(@)(@@)(@@)(@@) $ 10596 عن أبي هريرة رضي الله عنه :(@)(@@) | 30 ( أن ثمامة بن أثال أسلم ، وأمره النبي أن يغتسل ، ثم أمره أن يصلي ) . ( أبو نعيم ) . )(@)(@@)(@@)(@@) $ 10597 عن أبي هريرة رضي الله عنه :(@)(@@) | 30 ( أنه سئل عن سؤرة الحوض تردها الكلاب ، ويشرب فيها الحمار ، فقال : لا يحرم الماء شيء ) . ( ص ) . )(@)(@@)(@@)(@@) $ 10598 عن أبي هريرة رضي الله عنه أنه قال في السنور :(@)(@@) | 30 ( إذا ولغ في الاناء يغسله سبع مرات ) . ( ص ) . )(@)(@@)(@@)(@@) $ 10599 عن أبي هريرة رضي الله عنه في الهر يلغ في الاناء ، وقال :(@)(@@) | 30 ( اغسله مرة ) . ( عب ) . )(@)(@@)(@@)(@@) $ 10600 عن أبي هريرة رضي الله عنه :(@)(@@) | 30 ( أن النبي مسح علاى الخفين ) . ( ش ) . )(@)(@@)(@@)(@@) $ 10601 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( لما نزلت آية التيمم ، لم أدر كيف أصنع ؟ فأتيت النبي فلم أجده ، فانطلقت أطلبه فاستقبلته ، فلما رآني عرف PageV17P411 الذي جئت له ، فبال ثم ضرب بيديه الأرض ، فمسح وجهه وكفيه ) . ( ش ) . )(@)(@@)(@@)(@@) $ 10602 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( جاء أعرابي إلاى النبي فقال : يا رسول الله إني أكون في الرمل أربعة أشهر أو خمسة ، فيكون منا نفساء ، أو الحائض ، أو الجنب ، فما تراى ؟ قال : ( عليك بالتراب ) . ( عب ، هب ) . )(@)(@@)(@@)(@@) $ 10603 عن أبي هريرة رضي الله عنه :(@)(@@) | 30 ( أن ناسا من أهل البادية أتوا رسول الله فقالوا : إنا نكون بالرمال الأشهر الثلاثة والأربعة ، ويكون فينا الجنب والنفساء والحائض ، ولسنا نجد الماء ؟ فقال : عليكم بالأرض ، ثم ضرب بيده الأرض لوجهه ضربة واحدة ، ثم ضرب ضربة أخراى فمسح علاى يديه إلاى المرفقين ) . ( ص ) . )(@)(@@)(@@)(@@) $ 10604 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( أخبرنا أبو القاسم أن جبريل أخبره : أن الحجم أنفع ما يداوي به الناس ) . ( خط في المتفق ) . )(@)(@@)(@@)(@@) $ 10605 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( دخل علي رسول الله وأنا أشتكي ، فقال : ألا أرقيك برقية علمنيها جبريل ؟ بسم الله أرقيك ، والله يشفيك ، من كل إرب يؤذيك ، ومن شر النفاثات في العقد ، ومن شر حاسد إذا 
ms6006	 حسد ) . ( ش ) . )(@)(@@)(@@)(@@) $ 10606 عن أبي سلمة عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : لا عدواى ولا صفر ولا طيرة ولا هامة ، فقال الأعرابي : يا رسول الله فما بال الابل تكون في الرمل كأنها الظباء ، فيجيء إليه البعير الأجرب فيدخل فيها فيجربها كلها ؟ قال : فمن أعداى الأول ؟ ) . ( خ ، م ، د ، وابن جرير ) . )(@)(@@)(@@)(@@) $ 10607 عن ابن شهاب ، أن أبا سلمة حدثه أن رسول الله قال :(@)(@@) | 30 ( لا عدواى ، ويحدث أن رسول الله قال : لا يورد ممرض علاى مصح ، فقال أبو PageV17P412 سلمة : كان أبو هريرة رضي الله عنه يحدثهما كليهما عن رسول الله ، ثم صمت بعد ذالك عن قوله : لا عدواى ، وأقام علاى قوله : لا يورد ممرض علاى مصح ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 10608 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( جاء أعرابي إلاى النبي فقال : يا رسول الله النقبة تكون بمشفر البعير أو بعجبه فتشمل الابل كلها جربا ، فقال رسول الله : فما أعدى الأول ، لا عدواى ، ولا هامة ، ولا صفر ، خلق الله كل نفس فكتب حياتها ومصيباتها ، ورزقها ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 10609 عن قتادة ، عن أبي حسان :(@)(@@) | 30 ( أن رجلين دخلا علاى عائشة رضي الله عنه فحدثاها أن أبا هريرة رضي الله عنه قال : إن رسول الله قال : الطيرة في المرأة والفرس والدار ، فغضبت غضبا شديدا ، وطارت سعة في الأرض ، وسعة في السماء ، وقالت : ما قاله ، إنما قال : كان أهل الجاهلية يتطيرون من ذالك ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 10610 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( إن الله لا يرفع العلم ، إنما يهلك العلماء ، ولا يتعلم الجهال ) . ( كر ) . )(@)(@@)(@@)(@@) $ 10611 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : يا أبا هريرة علم الناس القرآن وتعلمه ، فإنك إن مت وأنت كذالك ، زارت الملائكة قبرك كما يزار البيت العتيق ، وعلم الناس سنتي وإن كرهوا ذالك ، وإن أحببت أن لا توقف علاى الصراط طرفة عين حتى تدخل الجنة ، فلا تحدث في دين الله تعالاى حدثا برأيك ) . PageV17P413 ( أبو نصر السجزي في الإبانة وقال 
ms6007	 : غريب ، خط ، وابن النجار ) . )(@)(@@)(@@)(@@) $ 10612 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( نهاى النبي عن النظر في النجوم ) . ( ابن النجار ) . )(@)(@@)(@@)(@@) $ 10613 عن البختري بن عبيد ، عن ابنه ، عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : من حدث عني حديثا هو لله عز وجل رضى ، فأنا قلته ، وإن لم أكن قلته ، قالوا : يا رسول الله ولم ؟ قال : لأن به أرسلت ) . ( كر ) . )(@)(@@)(@@)(@@) $ 10614 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( إني لأعلم فتنة يوشك أن تكون التي قبلها معها كنفجة أرنب ، وإني لأعلم المخرج منها ، أن امسك بيدي حتى يجيء من يقتلني ) . ( نعيم ) . )(@)(@@)(@@)(@@) $ 10615 عن أبي هريرة رضي الله عنه :(@)(@@) | 30 ( أن عمرو بن الشريد جاء بخادم أسود إلاى رسول الله فقال : يا رسول الله إن أمي جعلت عليها رقبة مؤمنة ، فهل يجزيء أن أعتق هاذه ؟ فقال النبي للخادم : أين ربك ؟ فرفعت رأسها فقالت : في السماء ، فقال : من أنا ؟ قالت : رسول الله ، قال : أعتقها فإنها مؤمنة ) . ( أبو نعيم في المعرفة ) . )(@)(@@)(@@)(@@) $ 10616 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( قدم جهيش بن أويس النخعي علاى رسول الله في نفر من أصحابه من مذحج فقالوا : يا رسول الله إنا حي من مذحج ، ثم ذكر حديثا طويلا فيه أبيات شعر ) . ( أبو نعيم ) . )(@)(@@) PageV17P414(@)(@@)(@@)(@@) $ 10617 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله يوم خيبر : لأعطين الراية غدا رجلا يحب الله ورسوله ، يفتح الله علاى يديه ، قال عمر رضي الله عنه : فما أحببت الامارة قط إلا يومئذ ، فتشوفت لها رجاء أن أدعاى لها ، فدعا عليا رضي الله عنه فبعثه وأعطاه الراية ، وقال : ( إذهب فقاتل حتى يفتح الله تعالاى علاى يديك ولا تلتفت ، فسار علي بالناس ، ثم وقف ولم يلتفت ) ، فقال : يا رسول الله علاى ما أقاتل الناس ؟ ( قال : قاتلهم حتى يشهدوا أن لا إلاه إلا الله وأن محمدا رسول الله ، فإذا قالوا ذالك ، منعوا منك دماءهم وأموالهم إلا بحقها وحسابهم علاى الله عز وجل ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 10618 عن 
ms6008	 أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( جاء رجل إلاى رسول الله فقال : يا رسول الله دلني علاى عمل إذا عملت به دخلت الجنة قال : ( كن محسنا ) قال : كيف أعلم أني محسن ؟ قال : ( سل جيرانك ) ؟ فإن قالوا : إنك محسن ، فإنك محسن ؛ وإن قالوا : ( إنك مسيء ، فأنت مسيء ) . ( هب ) . )(@)(@@)(@@)(@@) $ 10619 عن أبي هريرة رضي الله عنه :(@)(@@) | 30 ( أن النبي قال : ( تعلموا الفرائض وعلموها فإنه نصف العلم وهو ينساى ، وهو أول شيء ينزع من أمتي ) . ( ه ، ك ) . )(@)(@@)(@@)(@@) $ 10620 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( ليأتين علاى الناس زمان ، الموت فيه أحب إلاى أحدهم من العسل بالماء البارد في اليوم القائظ ، ثم لا يموت ) . ( نعيم ) . )(@)(@@)(@@)(@@) $ 10621 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله ( وذكر الفتنة الرابعة : لا ينجو من شرها إلا من دعا كدعاء الغرق ، وأسعد الناس فيها كل تقي خفي ، إذا ظهر لم يعرف ، وإذا جلس لم يفتقد ، وأشقاى الناس كل خطيب PageV17P415 مصقع ، أو راكب موضع ) . ( نعيم ) . )(@)(@@)(@@)(@@) $ 10622 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( ليأتين علاى الناس زمان ، خير منازلهم البادية ) . ( نعيم في الفتن ) . )(@)(@@)(@@)(@@) $ 10623 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : ( تدوم الفتنة الرابعة ثمانية عشر عاما ، ثم تنجلي حين تنجلي ، وقد انحسرت الفرات عن جبل من ذهب ، يكب عليه الأمة فيقتل عليه من كل تسعة سبعة ) . ( نعيم ) . )(@)(@@)(@@)(@@) $ 10624 عن أبي هريرة رضي الله عنه :(@)(@@) | 30 ( أن النبي قال : ( أتتكم الشرف الجون ) قالوا : وما الشرف الجون ؟ قال : ( الفتن كأمثال الليل المظلم ) . ( العسكري في الأمثال ) . )(@)(@@)(@@)(@@) $ 10625 عن أبي هريرة قال :(@)(@@) | 30 ( يا أهل الشام ليخرجنكم الروم منها كفرا كفرا حتى تلحقوا بسنبك من الأرض ، قيل : وما ذالك السنبك ؟ قال : حسما جذام ، ولسيوف الروم علاى كوادنها متعلقين جعابها بين بارق ولعلع ) . ( كر ) . )(@)(@@)(@@)(@@) $ 10626 عن كهيل بن حرملة النمري قال : سمعت أبا هريرة رضي الله عنه يقول :(@)(@@) | 30 ( كيف بكم إذا خرجتم منها كفرا كفرا إلاى سنبك من الأرض يقال لها : حسما 
ms6009	 جذام إذ لم تأخذوا أبيض ولا أصفر ، ولم يخدمكم ندراء ، ولا ينان ، ولا جرجنة ، ولا مارق ؟ وكيف بكم إذا خرجتم منها كفرا كفرا ، إلاى سنبك من الأرض يقال لها : حسما جذام ؟ فقال قائل : أبصر ما تقول يا أبا هريرة فغضب حتى تخالج لونه ، فقال : لقد ضل أبو هريرة وما اهتداى ، إن لم تكن سمعته أذناي ووعاه قلبي قالها مرارا ) . ( ش ، كر ) . )(@)(@@)(@@)(@@) $ 10627 عن أبي هريرة قال : $ 30 ( ويل للعرب من شر قد اقترب : PageV17P416 إمارة الصبيان إن أطاعوهم أدخلوهم النار ، وإن عصوهم ضربوا أعناقهم ) . ( ش ) .(@)(@@)(@@)(@@) $ 10628 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( ويل للعرب من شر قد اقترب ، أظلت ورب الكعبة أظلت والله لهي أسرع إليهم من الفرس المضمر السريع ، الفتنة العمياء الصماء المشبهة ، يصبح الرجل فيها علاى أمر ، ويمسي علاى أمر ، القاعد فيها خير من القائم ، والقائم فيها خير من الماشي ، والماشي فيها خير من الساعي ، ولو أحدثكم بكل الذي أعلم ، لقطعتم عنقي من هاهنا وأشار إلاى قفاه ، ويقول : اللهم لا تدرك أبا هريرة إمرة الصبيان ) . ( ش ) . )(@)(@@)(@@)(@@) $ 10629 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( لتؤخذن المرأة فليبقرن بطنها ، ثم ليؤخذن ما في الرحم فلينبذن مخافة الولد ) . ( ش ) . )(@)(@@)(@@)(@@) $ 10630 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( لا يأتي عليكم إلا قليل حتى يقضي الثعلب وسنته بين ساريتين من سواري المسجد يعني : مسجد المدينة يقول : من الخراب ) . ( ش ) . )(@)(@@)(@@)(@@) $ 10631 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( تقتتل هاذه الأمة ، حتى يقتل القائل لا يدري علاى أي شيء قتل ، ولا يدري المقتول علاى أي شيء قتل ) . ( ش ) . )(@)(@@)(@@)(@@) $ 10632 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : ( تكثر الفتن ، ويكثر الهرج ) قلنا : وما الهرج ؟ قال : ( القتل ؛ ويقبض العلم ، قال : أما إنه ليس ينزع من صدور الرجال ، ولاكن يقبض العلماء ) . ( ش ) . )(@)(@@)(@@)(@@) $ 10633 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( والله لو تعلمون ما أعلم ، لضحكتم قليلا ، ولبكيتم كثيرا ، والله ليقعن القتل والموت في هاذا الحي 
ms6010	 من PageV17P417 قريش ، حتى يأتي الرجل الكناسة فيجد بها النعل ، فيقول : كأنها نعل قرشي ) . ( ش ) . )(@)(@@)(@@)(@@) $ 10634 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( تكون فتنة لا ينجي منها إلا دعاء كدعاء الغرق ) . ( ش ) . )(@)(@@)(@@)(@@) $ 10635 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( ويل للعرب من هرج قد اقترب : الأجيجة وما الأجيجة ؟ قال : الويل الطويل في الأجيجة ، ويل للعرب من بعد الخمس والعشرين والمائة من القتل الذريع ، والموت السريع ، والجوع الفظيع ويسلط عليهم البلاء بذنوبها ، فتكثر صدورها ، وتهتك ستورها ، ويغير سرورها ، فبذنوبها تنزع أوتادها ، وتقطع أطنابها ، وتبختر قراؤها ، ويل لقريش من زنديقها ، يحدث أحداثا تهتك ستورها ، وينزع هيبتها ، ويهدم عليها جدورها ، حتى تقوم النائحات الباكيات : فباكية تبكي على دينها ، وباكية تبكي من ذلها بعد عزها ، وباكية تبكي من استحلال فرجها ، وباكية تبكي شوقا إلاى قبرها ، وباكية تبكي من جوع أولادها ، وباكية تبكي من انقلاب جنودها عليها ) . ( كر ) . )(@)(@@)(@@)(@@) $ 10636 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( سمعت رسول الله يقول : ( إنه سيصيب أمتي داء الأمم ) قالوا : يا نبي الله وما داء الأمم ؟ قال : ( الأشر والبطر والتكاثر والتنافس في الدنيا والتباغض والتحاسد ، حتى يكون البغي ، ثم يكون الهرج ) . ( ابن أبي الدنيا . . . وابن النجار ) . )(@)(@@)(@@)(@@) $ 10637 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( أظلتكم الفتن كقطع الليل المظلم ، أنجاى الناس فيها صاحب شاهقة ، يأكل من رسل غنمه ، أو رجل من وراء الدرب آخذ بعنان فرسه ، يأكل من فيىء سيفه ) . ( ش ) . )(@)(@@)(@@)(@@) $ 10638 عن أبي غسان المديني قال :(@)(@@) | 30 ( قدمنا الشام مع داود بن فراهج ، ومعنا رجل من بني وعلة السبائي ، كان صاحب علم وحكم ، فقال داود : أنت رجل PageV17P418 شريف ، إلق هاذا الرجل وتعرض له يعني : الوليد بن يزيد فبالحري أن ترد علينا خيرا ، فقال : إنه مقتول لتمام أربعين ليلة من هاذا اليوم ، وهو انقضاء خلافة العرد ، إلاى قيام صاحب الوادي من آل أبي سفيان ، ثم يعود إلاى الشام سنتهم حتى يكونوا أصحاب الأعماق ، فقال داود بن فراهج : سمعت أبا هريرة رضي الله عنه يقول 
ms6011	 : سمعت رسول الله : يقول : ( صاحب الأعماق الذي يهزم الله العدو علاى يديه نصر ) ، فقال : إنما سمي نصرا ، لنصر الله تعالاى إياه ؛ فأما اسمه : فسعيد ) . ( كر ) . )(@)(@@)(@@)(@@) $ 10639 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : ( أربعة ملاحم في الجنة : الجمل في الجنة ، وصفين في الجنة ، وحرة في الجنة ، وكان يكتم الرابعة ) . ( كر ) . )(@)(@@)(@@)(@@) $ 10640 عن أبي هريرة رضي الله عنه :(@)(@@) | 30 ( أن الني قال : ( رأيت في النوم بني الحكم ، أو بني أبي العاص ينزون علاى منبري كما ينزو القردة ، قال : فما رئي النبي مستجمعا ضاحكا حتى توفي ) . ( ق في الدلائل ، كر ) . )(@)(@@)(@@)(@@) $ 10641 عن أبي هريرة رضي الله عنه :(@)(@@) | 30 ( أن رسول الله رأى في المنام أن بني الحكم يرقون علاى منبره وينزلون ، فأصبح كالمتغيظ ، وقال : إني رأيت بني الحكم ينزون علاى منبري نزو القردة ، قال : فما رئي رسول الله مستجمعا ضاحكا بعد ذالك حتى مات ) . ( ع ، كر ) . )(@)(@@)(@@)(@@) $ 10642 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( إذا بلغ بنو أبي العاص ثلاثين ، كان دين الله دخلا وفي لفظ : دغلا ، ومال الله نحلا ، وعباد الله خولا ) . ( ع ، كر ) . )(@)(@@)(@@)(@@) $ 10643 عن أبي هريرة رضي الله عنه :(@)(@@) | 30 ( أن يهودية أهدت للنبي شاة مصلية فأكل منها ثم قال : ( أخبرتني أنها مسمومة ، فمات ، بشر بن البراء منها ، PageV17P419 فأرسل إليها ، فقال : ما حملك علاى ما صنعت ) ؟ قالت : أردت أن أعلم : إن كنت نبيا لم يضرك ، وإن كنت ملكا أرحت الناس منك ، فأمر بها فقتلت ) . ( ك ) . )(@)(@@)(@@)(@@) $ 10644 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( سئل رسول الله فقيل : متى وجبت لك النبوة ؟ قال : ( فيما بين خلق آدم ونفخ الروح فيه ) . ( كر ) . )(@)(@@)(@@)(@@) $ 10645 عن أبي هريرة رضي الله عنه :(@)(@@) | 30 ( أن النبي ولد مختونا ) . ( كر ) . )(@)(@@)(@@)(@@) $ 10646 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( خرج علينا رسول الله فقال : ( ادع أصحابك من أهل الصفة ، فجعلت أتتبعهم رجلا رجلا فجمعتهم ، فجئنا باب رسول الله فاستأذنا ، فاذن لنا ، ووضعت بين أيدينا صفحة أظن أن فيها قدر مد 
ms6012	 من شعير ، فوضع رسول الله يده وقال : ( خذوا بسم الله ) ، فأكلنا ما شئنا ثم رفعنا أيدينا ، ( فقال رسول الله حين وضعت الصحفة : والذي نفس رسول الله بيده ما أمساى في آل محمد طعام ليس بشيء ترونه ) ، قيل لأبي هريرة : قدر كم كانت حين فرغتم ؟ قال : ( مثلها حين وضعت ، إلا أن فيها أثر الأصابع ) . ( بز ) . )(@)(@@)(@@)(@@) $ 10647 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : بينما امرأتان نائمتان معهما ولداهما ، عدا الذئب عليهما فأخذ ولد إحداهما ، فاختصمتا إلاى داود في الباقي ، فقضاى به للكبراى منهما ، فخرجتا فلقيهما سليمان بن داود فقال : ما قضاى به الملك بينكما ؟ قالت الصغراى : قضاى به للكبراى ، قال سليمان : هاتوا السكين ، فأشقه بينكما ، قالت الصغراى : هو للكبراى ، دعه لها ، فقال سليمان : هو لك خذيه يعني للصغراى حين رأى رحمتها عليه ، قال أبو هريرة : وما سمعت بالسكين قط إلا يومئذ من رسول الله ، وما كنا نسميها إلا المدية ) . ( عب ) . )(@)(@@)(@@)(@@) $ 10648 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : ( ما نفعني PageV17P420 مال قط ما نفعني مال أبي بكر ) ، فبكاى أبو بكر رضي الله عنه ثم قال : هل أنا ومالي إلا لك يا رسول الله ) . ( كر ) . )(@)(@@)(@@)(@@) $ 10649 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( كنا عند النبي فالتفت وأبو بكر الصديق رضي الله عنه عن يمينه وقال : هنيئا لك يا أبا بكر تحية من عند الله تعالاى إياك هبط جبريل فقال : يا محمد من هاذا المتخلل بالعباءة عن يمينك ؟ فقلت : هاذا أبو بكر ، أنفق ماله علي قبل الفتح ، وصدقني ، وزوجني ابنته ، فقال : يا محمد أقرئه السلام من الله تعالاى وقل له : أراض أنت عني في فقرك هاذا أم ساخط ؟ فبكاى أبو بكر طويلا ، ثم قال : رضيت وسلمت لقضاء الله وقدره يا رسول الله ) . ( أبو نعيم في فضائل الصحابة ، قال ابن كثير : فيه غرابة شديدة ، وشيخ الطبراني عبد الرحمان بن معاوية العتبي ، وشيخه محمد بن نصر الفارسي لا أعرفهما ولم أر أحدا ذكرهما ) . )(@)(@@)(@@)(@@) $ 10650 عن 
ms6013	 أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : ( خير أمتي من بعدي أبو بكر وعمر لا تخبرهما يا علي ) . ( الديلمي ) . )(@)(@@)(@@)(@@) $ 10651 عن أبي هريرة رضي الله عنه رضي الله عنه قال :(@)(@@) | 30 ( خرج النبي متكئا علاى علي بن أبي طالب فاستقبله أبو بكر وعمر رضي الله عنهما فقال له : يا علي أتحب هاذين الشيخين ؟ قال : نعم يا رسول الله قال : أحبهما تدخل الجنة ) . ( كر ) . )(@)(@@)(@@)(@@) $ 10652 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( دخل رسول الله بمارية القبطية بيت حفصة ابنة عمر رضي الله عنهما فوجدتها معه فعاتبته في ذالك ، قال : فإنها حرام علي اين أمسها ، ثم قال : يا حفصة ألا أبشرك ؟ قالت : بلاى بأبي أنت وأمي قال : يلي هاذا الأمر من بعدي أبو بكر ، ويلي من بعد أبي بكر أبوك ، اكتمي هاذا علي ) . ( كر ) . )(@)(@@) PageV17P421(@)(@@)(@@)(@@) $ 10653 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( ذكر رسول الله فتنة فحذر منها ، قالوا : فما تأمر من أدركها منا ؟ قال : عليكم بالأمين وأصحابه وهو يشير إلاى عثمان بن عفان رضي الله عنه ) . ( أبو نعيم ، كر ) . )(@)(@@)(@@)(@@) $ 10654 عن حبيب كاتب مالك ، عن مالك ، عن ابن شهاب ، عن سعيد بن المسيب ، عن أبي هريرة رضي الله عنه :(@)(@@) | 30 ( أن عثمان بن عفان رضي الله عنه لما ماتت امرأته رقية بتت رسول الله بكاى فقال رسول الله : ما يبكيك ؟ قال : أبكي علاى انقطاع صهري منك ، قال : فهاذا جبريل يأمرني بأمر الله أن نزوجك أختها ) . ( كر ) وقال : ذكر أبي هريرة فيه غير محفوظ ، والمحفوظ عن سعيد مرسلا ، ثم روي من طريق ابن لهيعة : عن عقيل ، عن ابن شهاب ، عن سعيد بن المسيب : ( أن رسول الله لقي عثمان بن عفان رضي الله عنه وهو مغموم لهفان ، فقال رسول الله : ما شأنك يا عثمان ؟ قال : بأبي أنت يا رسول الله وأمي وهل دخل علاى أحد من الناس ما دخل علي ، توفيت بنت رسول الله عندي رحمها الله ، وانقطع الظهر ، وذهب الصهر فيما بيني وبينك إلاى آخر الأبد 
ms6014	 ، فقال له رسول الله : أتقول ذالك يا عثمان ؟ قال : إي والله أقوله يا رسول الله فبينما هو يحاوره ، إذ قال رسول الله لعثمان : هاذا جبريل يا عثمان يأمرني عن أمر الله أن أزوجك أختها أم كلثوم علاى مثل صداقها ، وعلاى مثل عشرتها ، فزوجه رسول الله إياها ) . ( قال كر : هذا مع إرساله أصح من حديث مالك ) . )(@)(@@)(@@)(@@) $ 10655 عن أبي هريرة رضي الله عنه :(@)(@@) | 30 ( أن النبي وقف علاى قبر ابنته الثانية التي كانت عند عثمان رضي الله عنه ، فقال : ألا أبو آيم ألا أخو أيم يزوجها عثمان ، ولو كن عشرا لزوجتهن عثمان وما زوجتهن إلا بوحي من السماء ) . ( عد ، كر ) . )(@)(@@)(@@)(@@) $ 10656 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 اشتراى عثمان بن عفان رضي PageV17P422 الله عنه من رسول الله الجنة مرتين بيع الخلق : يوم رومة ، ويوم جيش العسرة ) . ( عد ، كر ) . )(@)(@@)(@@)(@@) $ 10657 عن أبي هريرة رضي الله عنه :(@)(@@) | 30 ( أن رسول الله ذكر فتنة فقربها ، فجاء رجل مقنع رأسه ، فقال : هاذا وأصحابه يومئذ علاى الحق ، فأخذت بكتفي عثمان رضي الله عنه ثم رددت وجهه علاى النبي فقلت : هاذا يا رسول الله ؟ قال : نعم ) . ( كر ) . )(@)(@@)(@@)(@@) $ 10658 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( أشهد لسمعت رسول الله يقول : ( يكون بعدي فتن وأمور ) ، قلنا : فأين المنجا منها يا رسول الله ؟ قال : ( إلاى الأمين وحزبه وأشار إلاى عثمان بن عفان ) . ( كر ) . )(@)(@@)(@@)(@@) $ 10659 عن أبي هريرة رضي الله عنه :(@)(@@) | 30 ( أن رسول الله دخل حشا بالمدينة وهو الحائط ، فجاء أبو بكر رضي الله عنه فاستأذن عليه ، فقال : ائذنوا له وبشروه بالجنة ؛ ثم جاء عمر رضي الله عنه فاستأذن ، فقال : ائذنوا له وبشروه بالجنة ، ثم جاء عثمان رضي الله عنه فاستأذن ، فقال : ائذنوا له وبشروه بالجنة مع ما يصيبه من البلاء الشديد ) . ( كر ) . )(@)(@@)(@@)(@@) $ 10660 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( نظر رسول الله إلاى طلحة رضي الله عنه بمنى ، فقال : ( هاذا شهيد يمشي علاى وجه الأرض ) . ( كر ) . )(@)(@@)(@@)(@@) $ 10661 عن أبي هريرة رضي الله عنه 
ms6015	 :(@)(@@) | 30 ( أن رسول الله قال : طلحة في الجنة ، فأقبل عمر رضي الله عنه علاى طلحة يهنئه ) . ( عد ، كر ) . )(@)(@@)(@@)(@@) $ 10662 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( كان بين عبد الرحمان بن عوف وبين خالد بن الوليد رضي الله عنه بعض ما يكون بين الناس ، فقال رسول الله : دعوا لي أصحابي ، فإن أحدكم لو أنفق مثل أحد ذهبا ، لم يدرك وفي PageV17P423 لفظ : لم يبلغ مد أحدهم ولا نصيفه ) . ( كر ) . )(@)(@@)(@@)(@@) $ 10663 عن أبي هريرة قال :(@)(@@) | 30 ( كنا معاشر أصحاب رسول الله ونحن متوافرون نقول : أفضل هاذه الأمة بعد نبيها أبو بكر ، ثم عمر ، ثم عثمان رضي الله عنه ، ثم نسكت ) . ( الشاشي ، كر ) . )(@)(@@)(@@)(@@) $ 10664 عن أبي هريرة رضي الله عنه :(@)(@@) | 30 ( أن رسول الله كان علاى حراء فتحرك ، فقال رسول الله : اسكن حراء فما عليك إلا نبي ، أو صديق ، أو شهيد وكان عليه النبي وأبو بكر وعمر وعثمان رضي الله عنه ) . ( كر ) . )(@)(@@)(@@)(@@) $ 10665(@)(@@) | 30 عن أبي هريرة رضي الله عنه قال :(@)(@@) $ 30 ( قال رسول الله : نعم عبد الله أبو بكر ، نعم عبد الله عمر ، نعم عبد الله أبو عبيدة بن الجراح ، نعم عبد الله أسيد بن حفير ، نعم عبد الله معاذ بن جبل ، نعم عبد الله عبد الله بن رواحة ، نعم عبد الله ثابت بن قيس بن شماس ) . ( كر ) . ) $(@)(@@)(@@)(@@) $ 10665(@)(@@) | 30 عن أبي هريرة رضي الله عنه قال :(@)(@@) $ 30 ( قال رسول الله : نعم عبد الله أبو بكر ، نعم عبد الله عمر ، نعم عبد الله أبو عبيدة بن الجراح ، نعم عبد الله أسيد بن حفير ، نعم عبد الله معاذ بن جبل ، نعم عبد الله عبد الله بن رواحة ، نعم عبد الله ثابت بن قيس بن شماس ) . ( كر ) . ) $(@)(@@)(@@)(@@) $ 10666 عن الحصين بن عبد الرحمان بن عمرو بن معاذ عن أبي سفيان مولاى ابن أبي حمدان أن أبا هريرة رضي الله عنه كان يقول :(@)(@@) | 30 ( حدثوني عن رجل دخل الجنة لم يصل قط صلاة ، فإذا لم يعرفه الناس فسألوه من هو ؟ فيقول : أصيرم بن الأشهل 
ms6016	 عمرو بن ثابت بن وقش ، قال الحصين : فقلت لمحمود بن لبيد : كيف كان شأن الأصيرم ؟ قال : كان يأبى الاسلام علاى قومه ، فلما كان يوم أحد ، وخرج رسول الله ، بدا له الاسلام فأسلم ، ثم أخذ سيفه فغدا حتى القوم ، فدخل في عرض الناس ، فقاتل حتى أثبته الجراح ، فبينا رجال من بني عبد الأشهل يلتمسون قتلاهم في المعركة إذا هم به ، فقالوا : إن هاذا أصيرم ما جاء به ؟ لقد تركناه وإنه لمنكر لهاذا الحديث فسألوه ما جاء به ؟ فقالوا له : ما جاء بك يا عمرو ؟ أحدبا علاى قومك ، أم رغبة في الاسلام ؟ فقال : بل رغبة في الاسلام ، PageV17P424 فآمنت بالله ورسوله وأسلمت ، وأخذت سيفي فقاتلت مع رسول الله حتى أصابني ما أصابني ، ثم لم يلبث أن مات في أيديهم ، فذكروه لرسول الله فقال : إنه لمن أهل الجنة ) . ( ابن إسحاق وأبو نعيم في المعرفة ) . )(@)(@@)(@@)(@@) $ 10667 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : ما أظلت الخضراء ، ولا أقلت الغبراء علاى ذي لهجة أصدق من أبي ذر من سره أن ينظر إلاى تواضع عيساى بن مريم فلينظر إلاى أبي ذر وفي لفظ : أشبه الناس بعيساى نسكا وزهدا وبرا ) . ( أبو نعيم ) . )(@)(@@)(@@)(@@) $ 10668 عن ثابت قال : قال أبو هريرة رضي الله عنه :(@)(@@) | 30 ( ما رأيت أحدا أشبه صلاة برسول الله من ابن أم سليم يعني : أنسا ) . ( البغوي في الجعديات ، كر ) . )(@)(@@)(@@)(@@) $ 10669 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( كان جعفر يحب المساكين ، يجلس إليهم يحدثهم ويحدثونه ، وكان رسول الله يسميه أبا المساكين ) . ( أبو نعيم ) . )(@)(@@)(@@)(@@) $ 10670 عن أبي هريرة رضي الله عنه :(@)(@@) | 30 ( أن النبي قال للعباس رضي الله عنه : ( فيكم النبوة والمملكة وفي لفظ : الخلافة فيكم والنبوة ) . ( كر ) . )(@)(@@)(@@)(@@) $ 10671 عن ابن عباس ، عن أبي هريرة رضي الله عنهم قال :(@)(@@) | 30 ( قال رسول الله : ( اللهم اغفر للعباس ولولد العباس ، ولمن أحبهم ) . ( كر ) . )(@)(@@)(@@)(@@) $ 10672 عن خيثمة بن عبد الرحمن قال :(@)(@@) | 30 ( جلست إلاى أبي هريرة رضي الله عنه وقلت : حدثني ، فقال أبو هريرة : ممن أنت 
ms6017	 ؟ قلت : من أهل الكوفة ، قال : تسألني وفيكم علماء أصحاب رسول الله ، والمجار من الشيطان عمار بن ياسر رضي الله عنه ) . ( كر ) . )(@)(@@) PageV17P425(@)(@@)(@@)(@@) $ 10673 عن أبي سلمة ، عن أبي هريرة رضي الله عنه قال : ( قال رسول الله :(@)(@@) | 30 ( من سيدكم يا بني عبيد ) ؟ قالوا : الجد بن قيس ، علاى أن فيه بخلا ، فقال : ( وأي داء أدوأ من البخل ) ؟ قالوا : فمن سيدنا يا رسول الله ؟ قال : ( بشر بن البراء بن معرور ) . ( أبو نعيم ) . )(@)(@@)(@@)(@@) $ 10674 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( كان رسول الله يبني المسجد ، فإذا نقل الناس حجرا ، نقل عمار حجرين ، وإذا نقل الناس لبنة نقل عمار لبنتين ، فقال النبي : ( ويح ابن سمية تقتله الفئة الباغية ) . ( ع ، كر ) . )(@)(@@)(@@)(@@) $ 10675 عن العلاء ، عن أبي هريرة ، عن النبي : أنه قال لعمار رضي الله عنه :(@)(@@) | 30 ( تقتلك الفئة الباغية ) . ( كر ) . )(@)(@@)(@@)(@@) $ 10676 أنبأنا هشام بن حسان ، عن محمد ، عن أبي هريرة رضي الله عنه قال : $ 30 ( كنا عنده وعليه ثوبان ممشقان ، فتمخط ثم مسح أنفه بثوبه ، ثم قال : الحمد لله يتمخط أبو هريرة في الكتان ، لقد رأيتني وأني لأخر فيما بين منبر النبي وحجرة عائشة رضي الله عنها مغشيا علي من الجوع ، فيجيء الرجل فيقعد علاى صدري ، فأقول : ليس بي ذاك ، إنما هو من الجوع ، وقال : إني كنت أجيرا لابن عفان وابنة غزوان علاى عقيبة رجلي ، وشبع بطني ، أخدمهم إذا نزلوا ، وأسوق بهم إذا ارتحلوا ، فقالت يوما : لتركبنه قائما ، ولتردنه حافيا ، فزوجنيها الله تعالاى بعد ، فقلت : لتردنه حافيا ، ولتركبنه وهو قائم قال : وكانت في أبي هريرة مزاحة ) . ( عب ) .(@)(@@)(@@)(@@) $ ( 10677 ) عن أبي هريرة رضي الله عنه : ' أن النبي & قال : هل من رجل PageV17P426 يأخذ مما فرض الله تعالى ورسوله كلمة أو ثنتين أو ثلاثا ، أو أربعا أو خمسا فيجعلهن في طرف ردائه فيعمل بهن ويعلمهن ؟ قلت : أنا ؛ وبسطت ثوبي ، وجعل رسول الله & يحدث حتى سكت ، فضممت ثوبي إلى صدري ، فإني أرجو أن أكون لم أنس حديثا سمعته منه بعد ' . ( كر ) .(@)(@@)(@@)(@@) $ 10678 عن أبي هريرة رضي الله عنه 
ms6018	 : $ 30 ( أنه لما أقبل إلاى المدينة ضل معه غلامه ، فتعسف الليل أجمع لا يدري أين يذهب فقال :(@)(@@) يا ليلة من طولها وعنائها %~% علاى أنها من دارة الكفر نجت(@)(@@) فبينما هو جالس عند النبي إذ أقبل غلامه ، فقال النبي : ( يا أبا هريرة هاذا غلامك ) ، قال : فإني أشهدك يا رسول الله أنه لله عز وجل ) . ( ز ) . ) $(@)(@@)(@@)(@@) $ 10679 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : ( ليدخلن من هاذا الباب رجل ينظر الله تعالاى إليه ، فدخل غلام ابن المغيرة ابن شعبة حبشي ، يقال له : هلال : غائر العينين ، ذابل الشفتين ، بادي الثنايا ، خميص البطن ، أحمش الساقين ، أحنف القدمين ، مهزول ، تعلوه صفرة علاى سوأته خرقة ، وهو يحرك شفتيه بالذكر والتسبيح ؛ فقال له النبي : ( مرحبا بهلال ، هل لك في الفداء ) ؟ بل صم علاى ما أنت عليه وصل علي يا هلال ) . ( أبو عبد الرحمان السلمي في سنن الصوفية والديلمي ) . )(@)(@@)(@@)(@@) $ 10680 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( كنت مع النبي في المسجد ، إذ دخل عبد حبشي مجدع وعلاى رأسه حبرة ، غلام للمغيرة بن شعبة ، فقال النبي : ( مرحبا بيسار ) . ( الديلمي ) . )(@)(@@)(@@)(@@) $ 10681 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( رأيت رسول الله أخذ بيد PageV17P427 الحسن بن علي ، وجعل رجليه علاى ركبتيه وهو يقول : ( ترق عين بقه ) . ( وكيع في الغرر ، والرامهرمزي في الأمثال ) . )(@)(@@)(@@)(@@) $ 10682 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( إن النبي قال للحسن : ( اللهم إني أحبه ، فأحبه وأحب من يحبه ) . ( كر ، حم ) . )(@)(@@)(@@)(@@) $ 10683 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( خرج النبي إلاى بيت فاطمة رضي الله عنها فخرجت معه ، فقال : أثم لكع ؟ فاحتبس ، فظننت أنها تلبسه سحابا أو تغسله ، فجاء الحسن يشتد فاعتنقه وقال : اللهم إني أحبه فأحبه وأحب من يحبه ) . ( ع ، كر ) . )(@)(@@)(@@)(@@) $ 10684 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( جلس رسول الله في المسجد وأنا معه ، فقال : ( ادعوا لي لكع ) ، فجاء الحسن يشتد حتى أدخل يديه في لحية النبي ، وجعل النبي يفتح فمه ، ويدخل فمه في فمه 
ms6019	 وفي لفظ لسانه في فمه ، ثم قال : ( اللهم إني أحبه فأحبه ، وأحب من يحبه ثلاث مرات يقولها ) . ( كر ) . )(@)(@@)(@@)(@@) $ 10685 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( سمعت أذناي هاتان وأبصرت عيناي هاتان رسول الله وهو آخذ بكفيه جميعا حسنا أو حسينا ، وقدماه علاى قدم رسول الله وهو يقول : ( حزقة حزقة ، ترق عين بقه ) فترقى الغلام ، حتى يطلع قدميه علاى صدر رسول الله ، ثم قال له : إفتح فاك ، ثم قبله ، ثم قال : اللهم أحبه فإني أحبه ) . ( كر ) . )(@)(@@)(@@)(@@) $ 10686 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( رأيت رسول الله حامل الحسن بن علي علاى عاتقه ولعابه يسيل عليه ) . ( كر ) . )(@)(@@)(@@)(@@) $ 10687 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( رأيت رسول الله يمص PageV17P428 لسان الحسن كما يمص الرجل التمرة ) . ( ابن شاهين في الأفراد ، كر ) . )(@)(@@)(@@)(@@) $ 10688 عن سعيد المقبري قال :(@)(@@) | 30 ( كنا مع أبي هريرة رضي الله عنه إذ جاء الحسن بن علي فسلم ، فقال أبو هريرة : وعليك السلام يا سيدي سمعت رسول الله يقول : إنه لسيد ) . ( ع ، كر ) . )(@)(@@)(@@)(@@) $ 10689 عن عمير بن إسحاق :(@)(@@) | 30 ( أن أبا هريرة رضي الله عنه لقي الحسن بن علي رضي الله عنهما فقال : إرفع ثوبك حتى أقبل حيث رأيت النبي يقبل ، فرفع عن بطنه ، فوضع فمه علاى سرته ) . ( ابن النجار ) . )(@)(@@)(@@)(@@) $ 10690 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( بصر عيناي هاتان ، وسمع أذناي النبي وهو آخذ بيد حسن أو حسين وهو يقول : ترق عين بقه فيضع الغلام قدمه علاى قدم النبي ثم يرفعه فيضعه علاى صدره ، ثم يقول : إفتح فاك ، ثم يقبله ثم يقول : اللهم إني أحبه فأحبه ) . ( ش ) . )(@)(@@)(@@)(@@) $ 10691 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( بصر عيناي هاتان ، وسمع أذناي رسول الله أخذ بيد الحسن أو الحسين وهو يقول : ( ترق عين بقه ) فوضع الغلام قدميه علاى قدم رسول الله فيرفعه إلاى صدره ، ويقول له : إفتح فاك ، فيفتح فاه فيقبله النبي ؛ ثم قال : ( اللهم إني أحبه فأحبه ) . ( كر ) . )(@)(@@)(@@)(@@) $ 10692 عن أبي هريرة رضي 
ms6020	 الله عنه قال :(@)(@@) | 30 ( كان رسول الله يصلي صلاة العشاء ، وكان الحسن والحسين يثبان علاى ظهره ، فلما صلى ، قال أبو هريرة : يا رسول الله ألا أذهب بهما إلاى أمهما ؟ فقال رسول الله : لا ، فبرقت برقة ، فما زالا في ضوئها حتى دخلا إلاى أمهما ) . ( كر ) . )(@)(@@)(@@)(@@) $ 10693 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( كنا مع رسول الله في صلاة العشاء ، وكان إذا سجد ركب الحسن والحسين علاى ظهره ، فإذا رفع رأسه رفع رفعا رفيقا ، ثم إذا سجد عادا ، فلما قضاى صلاته أقعدهما في حجره ، فقلت : يا PageV17P429 رسول الله ألا أذهب بهما إلاى أمهما ؟ فبرقت برقة ، فلم يزالا في ضوئها حتى دخلا علاى أمهما ) . ( كر ) . )(@)(@@)(@@)(@@) $ 10694 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( قال النبي : ( أي عم إنك أعظم علي حقا ، وأحسنهم عندي يدا ، ولأنت أعظم علي حقا من والدي ، فقل كلمة تجب لك علي بها الشفاعة يوم القيامة ، قل : ( لا إلاه إلا الله ) . ( ك ، عن أبي هريرة ) . )(@)(@@)(@@)(@@) $ 10695 عن عبد الله بن رباح قال : قال أبو هريرة رضي الله عنه :(@)(@@) | 30 ( ألا أعلمكم بحديث من حديثكم يا معشر الأنصار ؟ قال : قال رسول الله : ( يا معشر الأنصار ) قالوا : لبيك يا رسول الله قال : ( قلتم : أما الرجل ، فقد أدركته رغبة في قريته ، ورأفة بعشيرته ) ، قالوا : قد قلنا ذاك يا رسول الله ( قال كلا إني عبد الله ورسوله ، هاجرت إليكم ، المحيا محياكم ، والممات مماتكم ، فأقبلوا إليه يبكون ويقولون : والله يا رسول الله ما قلنا الذي قلنا ، إلا الظن بالله ورسوله ، قال : فإن الله ورسوله يصدقانكم ويعذرانكم ) . ( ش ) . )(@)(@@)(@@)(@@) $ 10696 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( لا تستريثوا هلكة قريش ، فإنهم أول من يهلك ، حتى إن النعل لتوجد في المزبلة فيقال : خذوا هاذه النعل إنها لنعل قريش ) . ( نعيم ) . )(@)(@@)(@@)(@@) $ 10697 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : ( بنو أسامة مني وأنا منهم ، حسبما رأيتموهم فاعرفوا لهم حقهم وفضلوهم ) . ( قط ، في الأفراد ) . )(@)(@@)(@@)(@@) $ 10698 عن أبي هريرة رضي الله عنه قال 