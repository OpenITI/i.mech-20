ms481	 كرم % فيك جسيم فقيل مختصره % % 336(@)(@@) % ولو علت لابسا سواك من الن % ناس لطالت وبينت قصره % % PageV01P1801 البحر : - 1(@)(@@) % دار أمن وقرار % واعتلاء واقتدار % 2(@)(@@) % ومعافاة وشكر % % لا ابتلاء واصطبار % 3(@)(@@) % أسست والطير بال % % يمن وبالسعد جواري % % 4(@)(@@) % حلها بحر وأوفت % % فوق بحر ذي غمار % % 5(@)(@@) % وعلي أشبه البح % % رين حقا بالبحار % % 6(@)(@@) % منزل يشهد بالن % نبل كبار لكبار % % 7(@)(@@) % لم يزل يبنى بناء ال % % مجد مرفوع المنار % % 8(@)(@@) % سبق السباق عفوا % غير مشقوق الغبار % % 9(@)(@@) % سبق وثاب الجراثي % % م سبوح في الخبار % % 10(@)(@@) % سيد الكتاب طرا % ليس في ذاك تماري % % PageV01P1802 11(@)(@@) % خير دار حل فيها % % خير أرباب الديار % % 12(@)(@@) % وقديما وفق الل % % ه خيارا لخيار % % 13(@)(@@) % بنيت بالمرمر المس % % نون والتبر النضار % % 14(@)(@@) % ولباب الساج لابل % % بيلنجوج القماري % % 15(@)(@@) % واكتست ثوب بياض % ليله مثل النهار % % 16(@)(@@) % فأتت زهراء تعشى % % بائتلاق واستعار % % 17(@)(@@) % ذات لمع واتضاح % فهي من نور ونار % % 18(@)(@@) % قسم الإشراق منها % % بين سقف وجدار % % 19(@)(@@) % ألبس الزرين والجب % % سين من بعد اختيار % 20(@)(@@) % حين لم يرض شعارا % لهما دون دثار % % PageV01P1803 21(@)(@@) % عليا الزين مرارا % كررت بعد مرار % % 22(@)(@@) % جنة تذكر بالجن % نة قلبا ذا اعتبار % % 23(@)(@@) % ذات بستانين قد زي % % نا بنور وثمار % % 24(@)(@@) % في غصون ناعمات % مثل أوصال العذاري % % 25(@)(@@) % تتقي من يجتني من % % ها بلين واهتصار % % 26(@)(@@) % في بقاع دمثات % عطرات المستثار % % 27(@)(@@) % تتداعى الغن فيها % % من قيان وقمار % % 28(@)(@@) % وتراعى الوحش فيها % % من ألوف ونوار % % 29(@)(@@) % جمعت وحش المقا % % صير إلى وحش القفار % % 30(@)(@@) % كم بها سربا من ال % % وحش كحيلا باحورار % % PageV01P1804 31(@)(@@) % ذا رقاب كالمضاحي % % وقرون كالمداري % % 32(@)(@@) % كم بها سربا من الإن % % س له فيها تباري % % 33(@)(@@) % ذا وجوه كالمرايا % % وقدود كالسواري % % 34(@)(@@) % تصرع الفارس منه % % ن عن الطرف المطار % % 35(@)(@@) % أعين فيهن سكر % دونه سكر العقار % % 36(@)(@@) % وقديما عجز الأس % % وار عن ذات السوار % 37(@)(@@) % يا لهاتيك وجوها % في ثياب الكيمخار % % 38(@)(@@) % و الحرير الحر والعص % فر مرفض الشرار % % 39(@)(@@) % منظر لا 
ms482	 يسأل الن % ناظر جودا باغتفار % % 40(@)(@@) % من جميع الزين كاس % من جميع الشين عاري % % PageV01P1805 41(@)(@@) % كم بها من صدغ أس % ود معشوق المدار % % 42(@)(@@) % حول خد فيه ماء % واقف للعين جاري % % 43(@)(@@) % فيه لوعات وفيه % % ري أكباد حرار % % 44(@)(@@) % ذي عذار يترك الن % ناسك مخلوع العذار % % 45(@)(@@) % كم بها من شارب أخ % % ضر حلو المستدار % % 46(@)(@@) % كسرار الشهر بل أخ % % فى مخطا من سرار % % 47(@)(@@) % تحته ثغر يباهي % % ه لدى كل افترار % % 48(@)(@@) % في فم ينفح مسكا % حين يدنو للسرار % % 49(@)(@@) % ملك عف تلقى % % كل فحش بازورار % % 50(@)(@@) % ما اكتسى ملبس شين % لا ولا ملبس عار % % PageV01P1806 51(@)(@@) % أنشأ الدار التي أن % % شأ لإفراط اغترار % % 52(@)(@@) % بل بنى تذكره الجن % % نة في خير عقار % % 53(@)(@@) % مثل الفردوس في الدن % يا بليغا ذا اختصار % % 54(@)(@@) % بمبان كالرواسي % % وصحان كالصحاري % % 55(@)(@@) % وحكاها في سناء % ما اكتسته من شوار % 56(@)(@@) % نجدت من خير نجد % ملكت أيدي التجار % % 57(@)(@@) % ذا تماثيل حسان % % من صغار وكبار % % 58(@)(@@) % نشرت أسرة كسرى % % دستبدا في دوار % % 59(@)(@@) % أو رماة في طراد % خلف سرب أو صوار % % 60(@)(@@) % أو رعيل من حمير ال % % وحش مشبوب الحضار % % PageV01P1807 61(@)(@@) % خلفه كل حثيث الر % ركض في نقع مثار % 62(@)(@@) % كلهم مشلي كلاب % مسلهمات ضواري % % 63(@)(@@) % قد نحا سهما لظبي % أو لثور أو حمار % % 64(@)(@@) % متعت بالسيد المذ % % كور في يوم الفخار % % 65(@)(@@) % ولينم فيها خليا % من هموم وحذار % % 66(@)(@@) % إنها من شكل دار ال % % فوز لا دار البوار % 67(@)(@@) % كعبة يعمرها الن % ناس بحج واعتمار % % 68(@)(@@) % طالبي فضل علي % وعطاياه الغزار % % 69(@)(@@) % فهم بين أيادي % % مستماح مستجار % % 70(@)(@@) % مستماح المال في المع % % روف محمي الذمار % % PageV01P1808 71(@)(@@) % مستشار حين تخشى % % عثرات المتشار % % 72(@)(@@) % أيها الجار الذي أص % % بح مأمول الجوار % 73(@)(@@) % والذي لا يصرف الآ % % مل عنه باعتذار % % 74(@)(@@) % أنزل الدار المبنا % % ة على سقيا القطار % % 75(@)(@@) % وعلى استقبال وجه % من ربيع ذي اخضرار % % 76(@)(@@) % متوش باصفرار % % وبياض واحمرار % % 77(@)(@@) % ذي نجوم من خزامى % % وشموس 
ms483	 من بهار % % 78(@)(@@) % وتسربل ثوب عيش % ليس بالثوب المعار % % 79(@)(@@) % أخلق الدار التي أن % % شأت إخلاق الإزار % % 80(@)(@@) % أبلها في طاعة الل % ه وجدد ألف دار % % PageV01P1809 81(@)(@@) % وليطل عمرك مسرو % % را بأيام قصار % % 82(@)(@@) % يصل الله بها خل % % دك في دار القرار % % 83(@)(@@) % حيث لا تعدم في الدا % % رين منه خير جار % % 84(@)(@@) % ليت شعري عنك هل أه % هلت أمري لادكار % % 85(@)(@@) % نظرا يحسن أني % % لم أدع حسن انتظاري % % PageV01P1810 البحر : - 1(@)(@@) % يضن أبو عيسى علينا بقطنة % كأن أبا اسحاق ليس بحاضر % 2(@)(@@) % وفي جود إبراهيم طال بقاؤه % % لناعوض معتاضه غير خاسر % % 3(@)(@@) % إليك أبا عيسى بقطنك إننا % % لنا سيد مستأثر بالمآثر % % 4(@)(@@) % أبت لابن حماد مساعيه أن يرى % % إذا ابتدر الساعون غير مبادر % % 5(@)(@@) % كريم يرى الأموال شر ذخيرة % بعين ترى المعروف خير الذخائر % % 6(@)(@@) % تناولني منه ببر شكرته % عليه ولم يطلب به شكر شاكر % % 7(@)(@@) % رأى نيقا يستغرق النعت كله % % جميلا محياه حميد المخابر % 8(@)(@@) % تضن به الأم الرؤوم على ابنها % % وإن كان مأمولا لسد المفاقر % 9(@)(@@) % له نفس قبل المذاق كأنما % % بديهته أنفاس غيداء عاطر % 10(@)(@@) % تحية مشتم ملدة طاعم % إذا ملكته الكف نزهة ناظر % % PageV01P1811 11(@)(@@) % فأهداه لي أهدى له الله نعمة % محصنة من سوء دور الدوائر % % 12(@)(@@) % وكنت أخا ضعف فأنهض منتي % % ومازال معروفا بأيمن طائر % % 13(@)(@@) % وأني لأرجو منه قطنا لكسوتي % % وأي كريم مطعم غير ساتر % % 14(@)(@@) % وما لأبي عيسى هنالك منة % ولكن لإبراهيم تاج المفاخر % % 15(@)(@@) % فتى حل من بيت الحلومة والتقى % % وبذل العطايا منزلا غير داثر % % 16(@)(@@) % محلا إذا وافاه للرفد وفده % % رأى خير معمور وأفضل عامر % % 17(@)(@@) % فتى لا تراه فاخرا بمكانه % % على أنه فوق النجوم الزواهر % 18(@)(@@) % وما وضعته همة دون مفخر % ولكنها أعلته فوق المفاخر % 19(@)(@@) % إذا شيم الأحرار حالت فأصبحت % % إماء أبى منهن غير الحرائر % PageV01P1812 البحر : - 1(@)(@@) % سوءة للدهر إذ يخ % لط إخلاصي بغيره % 2(@)(@@) % ما عليه لو كفاني ال % % قوت يا قلة خيره % % 3(@)(@@) % لتروا مني وليا % رأيكم أفضل 
ms484	 ميره % % 4(@)(@@) % وبشير بلقاء % منكم أيمن طيره % % 5(@)(@@) % يملأ الآفاق من أس % % دائه فيكم ونيره % % 6(@)(@@) % سائر المدح وإن كا % % ن بكم إغذاذ سيره % % PageV01P1813 البحر : - 1(@)(@@) % أخا ثقتي أعزز علي بنوبة % مناك بها صرف القضاء المقدر % 2(@)(@@) % أصبت وما للعبد عن حكم ربه % % محيص وأمر الله أعلى وأقهر % % 3(@)(@@) % وقد مات من لا يخلف الدهر مثله % عليك من الأسلاف والحق يبهر % % 4(@)(@@) % أب بعد أم برة وأقارب % مضوا سرجا في ظلمة الليل تزهر % % 5(@)(@@) % فنمت ولم تهجر شرابك بعدهم % وكم تهجر النفس الزلال وتسهر % 6(@)(@@) % تعزيت عمن أثمرتك حياته % ووشك التعزي عن ثمارك أجدر % % 7(@)(@@) % لأن احتيال الدهر في ابن وفي ابنة % يسير وكر الدهر شيخيك أعسر % % 8(@)(@@) % تعذر أن نعتاض من أمهاتنا % % وآبائنا والنسل لا يتعتذر % % 9(@)(@@) % إلى أن يقيم الله يوم حسابه % فيلقون والأرواح تطوى وتنشر % % 10(@)(@@) % فلا تهلكن حزنا عن ابنة جنة % غدت وهي عند الله تحبى وتحبر % % PageV01P1814 11(@)(@@) % لعل الذي أعطاك ستر حياتها % % كساها من اللحد الذي هو أستر % % 12(@)(@@) % وفي الماء طهر ليس في الطهر مثله % % وللترب أحيانا من الماء أطهر % % 13(@)(@@) % ولن تخبر الأنثى طوال حياتها % % ولكنها بعد المنية تخبر % % 14(@)(@@) % وليس بمأمون عليها عثارها % % مدى الدهر أو يقضى عليها وتقبر % % 15(@)(@@) % وكم من أخي حرية قد رأيته % بنار ذوي الأصهار يكوى ويصهر % % 16(@)(@@) % فلا تتهم لله فيها ولا ية % ولا نظرا فالله للعبد أنظر % % 17(@)(@@) % وأنت وإن أبصرت رشدك كله % فذو المنظر الأعلى برشدك أبصر % 18(@)(@@) % ولن يعوز الوهاب إخلاف فارس % فصبرا فإن البر من يتصبر % % 19(@)(@@) % وفي العيش محلول وفي العيش ممقر % وللدهر معروف وللدهر منكر % 20(@)(@@) % وما هذه الدنيا بدار إقامة % ولكنما الدنيا مجاز ومعبر % % PageV01P1815 البحر : - 1(@)(@@) % وسميطة صفراء دينارية % ثمنا ولونا زفها لك حزور % 2(@)(@@) % عظمت فكادت أن تكون إوزة % ونوت فكاد إهابها يتفطر % 3(@)(@@) % طفقت تجود بذوبها جوذابة % % قانى لباب اللوز فيها السكر % % 4(@)(@@) % نعم السماء هناك ظل صبيبها % % يهمي ونعم الأرض ظلت تمطر % % 5(@)(@@) % ياحسنها فوق الخوان وبنتها 
ms485	 % % قدامها بصهيرها يتغرغر % % 6(@)(@@) % ظلنا نقشر جلدها عن لحمها % % وكأن تبرا عن لجين يقشر % % 7(@)(@@) % وتقدمتها قبل ذاك ثرائد % % مثل الرياض بمثلهن يصدر % % 8(@)(@@) % ومدققات كلهن مزخرف % بالبيض منها ملسن ومدثر % % 9(@)(@@) % وأتت قطائف بعد ذاك لطائف % ترضى اللهاة بها ويرضى الحنجر % % 10(@)(@@) % ضحك الوجوه من الطبرزد فوقها % % دمع العيون من الدهان تعصر % % PageV01P1816 11(@)(@@) % من مال ذي فخر كأن بنانه % خلج الفرات إذا غدت تتفجر % 12(@)(@@) % يعطي الكثير فيستقل كثيره % وقليله من غيره مستكثر % % 13(@)(@@) % شمس يحف يمينها وشمالها % % بدر السماء ومشتريها الأزهر % % 14(@)(@@) % لله درهم ثلاثة إخوة % حسنت مناظرهم وطاب المخبر % % 15(@)(@@) % بكر الربيع يزف أخضر ناضرا % وهم أزف من الربيع وأنضر % 16(@)(@@) % وطغت ثلاثة أبحر فتزاخرت % وهم هنالك بالفواضل أزخر % % 17(@)(@@) % عمروا على طول الزمان فإنهم % % نجل بهم يحيا السماح ويعمر % % 18(@)(@@) % وأقول بعد مديحهم مستعتبا % ما للوفاء من الكرام يؤخر % % 19(@)(@@) % قد جائكم تمر وأوجب قسمه % قرب المصيف فما لنا لا نتمر % % 20(@)(@@) % لاسيما ولنا بذلك موعد % ووفاء موعدكم وفاء يؤثر % % PageV01P1817 21(@)(@@) % ما حسبكم لطفا لديكم محضرا % عمن لديه به ثناء محضر % % PageV01P1818 البحر : - 1(@)(@@) % كثير نوالك في جنب ما % % جبلت عليه من الجود نزر % 2(@)(@@) % ونزر نوالك عند الذي % % يجود به سائر الناس غمر % 3(@)(@@) % فمن يستزدك يجد مذهبا % ومن يرض يرض بما فيه خير % 4(@)(@@) % ولي همة زاد في طولها % % وفي عرضها أن كفيك بحر % 5(@)(@@) % وكنت وعدت لها جمة % وبشرني منك بالسيل قطر % 6(@)(@@) % وقلت لرفدك لما بدا % % هلال كأن قد نما منه بدر % 7(@)(@@) % فأنجز مواعيد أكدتها % % فقد مر عصر وقد كر عصر % % 8(@)(@@) % ولا تخلفني فإن الكري % % م سيان وأي وآه ونذر % % 9(@)(@@) % وهل يخلف الوعد من قوله % % كما الوعد عهد كذا الخلف غدر % 10(@)(@@) % ومطل الكريم مواعيده % % أمان من الخلف ما فيه ختر % % PageV01P1819 11(@)(@@) % ولن ينكر المطل لاسيما % % لمن ماله الدهر مد وجزر % % 12(@)(@@) % ولو وعدتني عنك المنى % % لأمست مواعيدها وهي وفر % % PageV01P1820 البحر : - 1(@)(@@) % جزى القاسم الحسنى محسن وجهه % وجاعله ممن يطيب 
ms486	 ويكثر % 2(@)(@@) % فتى لا يعد العطر ضربة لازب % % ولكنه من نفسه متعطر % % 3(@)(@@) % أخو طيرة لا يكره الله مثلها % % ولكنها مما يحب ويؤثر % % 4(@)(@@) % إذا نحن قلنا المدح فيه فإنه % % من المدح مالم يجزه متطير % % 5(@)(@@) % وإن مديحا لا يثاب لندبة % لميت وإن لم يقبر الميت مقبر % % 6(@)(@@) % ولو أصبح الممدوح حيا تخيرت % له نفسه ما يصطفي المتخير % % 7(@)(@@) % ومن خير الأشياء باق تحوزه % بفان إذا ما استثبت المتبصر % % PageV01P1821 البحر : - 1(@)(@@) % عيني لاتتهلل منكما الدرر % وحالفا النوم لا يقذيكما السهر % 2(@)(@@) % ويا همومي ابتغي مأوى سوى خلدي % % فلن يضمك مني اليوم محتضر % % 3(@)(@@) % عفت على كل جرم أجرمت وجنت % أوائل الدهر أحداث له أخر % 4(@)(@@) % يا دهرنا كل جرم أنت مجرمه % بعد اجتياح أبي حسان مغتفر % % 5(@)(@@) % أصاب سهمك منه شر من حملت % أنثى ومن حازه في صلبه ذكر % % 6(@)(@@) % لما ثوى عاف بطن الأرض جيفته % لكن حوباءه ارتحاحت لها سقر % % 7(@)(@@) % فهذه رهبت من أن يحل بها % % أن لا يجود على غضرائها المطر % % 8(@)(@@) % وهذه فرحت واستبشرت ثقة % بأن سيضعف منها الحر والسعر % 9(@)(@@) % أقول لما به أودى وقد جعلت % % أخبار مهلكه في الناس تنتشر % % 10(@)(@@) % به الردى لا بضرغام خنابسة % يبغي افتراسي ومالي دونه وزر % % PageV01P1822 البحر : - 1(@)(@@) % وخل كخلمالسوء أنكرت وده % وخلته أن نال من وجهي الكبر % 2(@)(@@) % يظل يراعيني بعيني شناءة % يدل على بغضائها النظر الشزر % % 3(@)(@@) % رأى الدهر قد أودى بماء شبيبتي % % فأنكر مني الشيب إنكاره النكر % 4(@)(@@) % كأنا تعاقدنا الخلالة بيننا % % على أنني بسل على الدهر أو حجر % % 5(@)(@@) % ضمنت له أن لا أخون فظنني % % ضمنت له أن لا يخونني الدهر % 6(@)(@@) % تجاهل أحداث الزمان وإنه % ليعلم حقا أن قصري له قصر % % PageV01P1823 البحر : - 1(@)(@@) % وخل كخلمالسوء أنكرت وده % وخلته أن نكر الدهر منظري % % 2(@)(@@) % يظل يراعيني بعيني شناءة % ويعرض عن ودي بخد مصعر % % 3(@)(@@) % كأنا تعاقدنا الخلالة بيننا % % لوجه طرير أو لخلق مصور % % 4(@)(@@) % رأى الدهر قد أودى بماء شبيبتي % % فأنكر من أحداثه غير منكر 
ms487	 % % 5(@)(@@) % ولم ترى خلم السوء تمنح وصلها % % خليلا فترعاه على حين مكبر % % 6(@)(@@) % ومن يزل بالحادثات معيرا % فوشكان ما يلحقنه بالمعير % % 7(@)(@@) % ومهما شكا الشاكون من جور دهرهم % % فليس مريبا معشرا دون معشر % % 8(@)(@@) % وإني وإن جفني تقادم عهده % % لأمضي مضاء المشرفي المذكر % % PageV01P1824 البحر : - 1(@)(@@) % بدت لي غادة لم تبد إلا % % توهمها هناك البدر بدرا % % 2(@)(@@) % تماشي الغنج في خفين صيغا % % وفاقا للمنى شكلا وقدرا % % 3(@)(@@) % فقلت لها بكم هذان قالت % % بحملها على كتفيك شهرا % % 4(@)(@@) % فقلت وفيهما قدماك قالت % % نعم فنخرت عشرا ثم عشرا % % PageV01P1825 البحر : - 1(@)(@@) % مدحت سليمان المغلب مدحة % تجاوز قدر العبد لو كان يشكر % 2(@)(@@) % فعمي عنه ناظراه كأنه % بعوراء عيني جده ظل ينظر % % 3(@)(@@) % وما كان مدحي من طريد هزيمة % على عقبيه سلحه بعد يقطر % % 4(@)(@@) % شننت عليه حلة ليس عيبها % % سوى أنها ظلت تطول ويقصر % % PageV01P1826 البحر : - 1(@)(@@) % جاءتك تستعديك قافية % يا ابن الفرات على أبي الصقر % % 2(@)(@@) % مهرت ضرائرها وما مهرت % % بقرى ولهى أحق بالمهر % % 3(@)(@@) % فاحكم فإنك لم تزل حكما % للقوم في الجلى من الأمر % % 4(@)(@@) % واغضب لها غضبا يقود رضا % يشكرك قائلها يد الدهر % % PageV01P1827 البحر : - 1(@)(@@) % يا فاصد العرق المبارك فصده % قسما لقد صفيت غير مكدر % 2(@)(@@) % عرق فراه شبا الحديدة عن دم % كعصارة المسك الذكي الأذفر % 3(@)(@@) % يشفى من الكلب العياء إذا أبى % % كل الإباء على الشفاء الأكبر % % 4(@)(@@) % لو كان ماء للوجوه لأشرقت % ورأت لها الأبصار أحسن منظر % % 5(@)(@@) % سفكت به كف الطبيب صبابة % كم دونها من ورد موت أحمر % % 6(@)(@@) % إني أظن قرارة حظيت به % ستكون أخرى الدهر معدن عنبر % % 7(@)(@@) % لو تشرب الأرض الدماء لطيبها % % شربت فصيدك أمس أرض العسكر % % 8(@)(@@) % أتلف به داء وأخلف صحة % والبس جديد العيش لبس معمر % % 9(@)(@@) % غادرت فصدك غرة مشهورة % % في وجه يوم السبت حتى المحشر % % 10(@)(@@) % قد كان يوما لانباهة باسمه % فكسوته سيما أغر مشهر سريعقلت لقوم سادة قادة يا سادة تعلى مآخيرها المخانيث ينيكونكموناكة الناس مذاكيرها بذيئمالي أرى ناكتكم غلمةكالحور صانتها 
ms488	 مقاصيرها مؤنثي الخلق لهم أعين دلالها باد وتفتيرها فقال شيخ منهم عاقل فكر فهادي ا % % PageV01P1828 البحر : - 1(@)(@@) % سقط أبيات % % PageV01P1829 البحر : - 1(@)(@@) % قلت لقوم سادة قادة % يا سادة تعلى مآخيرها % % PageV01P1830 البحر : - 1(@)(@@) % المخانيث ينيكونكم % % وناكة الناس مذاكيرها % % PageV01P1831 البحر : - 1(@)(@@) % مالي أرى ناكتكم غلمة % كالحور صانتها مقاصيرها % % PageV01P1832 البحر : - 1(@)(@@) % مؤنثي الخلق لهم أعين % دلالها باد وتفتيرها % % PageV01P1833 البحر : - 1(@)(@@) % فقال شيخ منهم عاقل % فكر فهادي النفس تفكيرها % % PageV01P1834 البحر : - 1(@)(@@) % هل وضع الفيشة قد أنثت % هاتيك والتظفير تظفيرها % % PageV01P1835 البحر : - 1(@)(@@) % أما ترى الفيشة قد مكنت % في الأرض فالتدبير تدبيرها % % PageV01P1836 البحر : - 1(@)(@@) % فأغضب على الأشياء أو خلها % % بحيث أجرتها مقاديرها % % PageV01P1837 البحر : - 1(@)(@@) % الطويلارقت كأني بت ليلي على الجمر % أراعي كرى بين المساكين والنسر % % PageV01P1838 البحر : - 1(@)(@@) % كرى طار عن عيني فحلق صاعدا % فأتبعته طرفي فأمعن في النفر % % PageV01P1839 البحر : - 1(@)(@@) % ولم لا وخنزير مهين يهينني % % فيغضي على لؤم وأغضي على قسر % % PageV01P1840 البحر : - 1(@)(@@) % سأشكو إلى مستنكر النكر قاسم % فينظر في أمري بناظرتي صقر % % PageV01P1841 البحر : - 1(@)(@@) % أقاسم قد انفذت كل وسيلة % وأنفقت ما أثلت من تالد الصبر % % PageV01P1842 البحر : - 1(@)(@@) % على أنك المرء الذي جبرت به % % يد الله أوصال الكسير من الكسر % % PageV01P1843 البحر : - 1(@)(@@) % وإني الذي لم يبق في الجهد غاية % لتجبره لوجدت للكسر بالجبر % % PageV01P1844 البحر : - 1(@)(@@) % وجشمت نفسي فيك كل عظيمة % إلى أن تكففت الشفاعة من عمرو % % PageV01P1845 البحر : - 1(@)(@@) % فكان جوابي أن حجبت وهكذا % % يكون جواب المبتغي الغوث من قبر % % PageV01P1846 البحر : - 1(@)(@@) % وإن فقيرا عد عمرا لفقره % % مسدا لذو فقرينفقر على فقر % % PageV01P1847 البحر : - 1(@)(@@) % ففقر من العقل المسدد للهدى % % وفقر من المال المشدد للأزر % % PageV01P1848 البحر : - 1(@)(@@) % وما كان إلا القبر خبث طوية % % ونوما عن الحمد المجمل والأجر % % PageV01P1849 البحر : - 1(@)(@@) % فيا من رأى مثلي وعمرو يرده % بصغر إلا تبكي بذي لجة غمر % % PageV01P1850 البحر : - 1(@)(@@) % أيحجبني عمرو فلا يحجب الحيا % % ولا ترتمي الآفاق بالجمر والصخر % % PageV01P1851 البحر : - 1(@)(@@) % ألا ترجف الدنيا وتهوي جبالها % % وتخبو مصابيح السماء إلى الحشر % % PageV01P1852 البحر : - 1(@)(@@) % بلى قد خبت ولكن سطوت على الدجى % % بغرتك المقدوح منها سنا 
ms489	 الفجر % % PageV01P1853 البحر : - 1(@)(@@) % وقد حجب الله الحيا غير عصمة % بكفيك تغنى المقحقين عن القطر % % PageV01P1854 البحر : - 1(@)(@@) % تفكرت من عمرو وفي وفيكم % % فأحسست في الأحشاء جمرا على جمر % % PageV01P1855 البحر : - 1(@)(@@) % وما قصمت مذ كنت ظهري مصيبة % وطغوى أبي الخرطوم قاصمة الظهر % % PageV01P1856 البحر : - 1(@)(@@) % ايركب عمرو في الزنوج ولم يزل % % يبيت عروسا للزنوج بلا مهر % % PageV01P1857 البحر : - 1(@)(@@) % ويحجب مثلي مستطيلا بعزكم % % وإمدادكم إياه بالجاه والوفر % % PageV01P1858 البحر : - 1(@)(@@) % عفا الله ما أسلفته من كبيرة % سواها فقد غطت على الشمس والبدر % % PageV01P1859 البحر : - 1(@)(@@) % وترت بوتر فيك لا استقيده % % ولو أنني استنجدت بالصبر والنصر % % PageV01P1860 البحر : - 1(@)(@@) % ولا سلم حتى تسرد ظلامتي % % وإلا فأيقن أننا فئتا ثغر % % PageV01P1861 البحر : - 1(@)(@@) % ولا حرب إلا عتب نفس كريمة % على سيد في رأيه قال بالظفر % % PageV01P1862 البحر : - 1(@)(@@) % تخطى بنعماه الجسيمة عاتقي % % إلى أنف عمرو تلك آبدة العصر % % PageV01P1863 البحر : - 1(@)(@@) % وليس شفائي قتل عمرو لأنه % % يراح به من ذلك الجبل الوعر % % PageV01P1864 البحر : - 1(@)(@@) % وما راحتي في طرحه ثقل أنفه % % وما دركي في أن يفك من الأسر % % PageV01P1865 البحر : - 1(@)(@@) % ولكن شفائي أن يطول بقاؤه % % بحيث يراني ذا ثراء وذا وفر % % PageV01P1866 البحر : - 1(@)(@@) % علي يا لقوم من عذيري من عمرو % % غدا ثعلبا يستطعم الموت من ببر % PageV01P1867 البحر : - 1(@)(@@) % عزمت على طي الأهاجي منعما % عليه ومثلي جاد بالصفح والغفر % PageV01P1868 البحر : - 1(@)(@@) % فعادوا ما أنكرت منه بقطعه % % كلام شفيعي كاده الله ذو المكر % % PageV01P1869 البحر : - 1(@)(@@) % ومن عاد عدنا طالبين بحقنا % % ولا بد للمستنبط الماء من حفر % % PageV01P1870 البحر : - 1(@)(@@) % فلا يتعرض لي بكيد يخاله % % خفيا فينكأ فيه بالضرس والظفر % % PageV01P1871 البحر : - 1(@)(@@) % لعمرو اليد المقروف شري بظفرها % % لقد غررت تغرير قارفة البثر % % PageV01P1872 البحر : - 1(@)(@@) % سقى الله بستان الأنيقة منظرا % ومختبرا سقيا من الدمع والخمر % % PageV01P1873 البحر : - 1(@)(@@) % لعهدي بها يوما وقد بصرت به % % فقالتتعالى مالك الخلق والأمر % % PageV01P1874 البحر : - 1(@)(@@) % ولو لم تالف قلبها ببنانها % % وقد ريع من عمرولطار من الصدر % % PageV01P1875 البحر : - 1(@)(@@) % على أنها قالت دعوه حيالنا % % ففي وجه ملهى عن النغم والزمر % % PageV01P1876 البحر : - 1(@)(@@) % دعوا الفيل ذا 
ms490	 الخرطوم يفرح ساعة % بخرطومه المقبوح لا وجهه النضر % % PageV01P1877 البحر : - 1(@)(@@) % دعوه يذكرنا نكيرا ومنكرا % وصيحة إسرافيل في صيحة النشر % % PageV01P1878 البحر : - 1(@)(@@) % دعوه يعوذنا من العين إنه % % هو العوذة الكبرى المنوطة في النحر % % PageV01P1879 البحر : - 1(@)(@@) % دعوه نردد لحظنا فيه إنه % % من النزه المغفول عنهن في القفز % % PageV01P1880 البحر : - 1(@)(@@) % وما مثله يبقى علينا لأنه % % لنا من هدايا الدهر ذي الغدر والختر % % PageV01P1881 البحر : - 1(@)(@@) % وغنته صوتا طيبا وهو قولها % % لصفع أبي الخرطوم أحلى من القمر % % PageV01P1882 البحر : - 1(@)(@@) % عشقنا قفا عمرو وإن كان وجهه % يذكرنا قبح الخيانة والغدر % PageV01P1883 البحر : - 1(@)(@@) % فتى وجهه كالهجر لا وصل بعده % وأما قفاه فهو وصل بلا هجر % PageV01P1884 البحر : - 1(@)(@@) % وغنته صوتا ثانيا وهو قولها % % طربت إلى أنف صبور على النقر % PageV01P1885 البحر : - 1(@)(@@) % رأى أنف عمرو أن يطول كطوله % % لنذر جرى منه فزاد على النذر % % PageV01P1886 البحر : - 1(@)(@@) % وعوج من عمرو تمكن خبله % كما عوجت كف الصبي من السطر % % PageV01P1887 البحر : - 1(@)(@@) % وغنته صوتا ثالثا وهو قولها % % غدا أنف عمرو وهو نهد على قعر % % PageV01P1888 البحر : - 1(@)(@@) % ولى عمرو لي لبلاب غيضة % وطال فما يفنى بذرع ولا حزر % % PageV01P1889 البحر : - 1(@)(@@) % إذا ما مشى عمرو ولج اضطرابه % % فعيناه في شطر ورجلاه في شطر % % PageV01P1890 البحر : - 1(@)(@@) % ثلاثة أصوات تغنت مجيدة % بهن لعمرو وهو افرد من وتر % % PageV01P1891 البحر : - 1(@)(@@) % ولو أنها عاشت قليلا لسمعت % % طنين قفاه كل مستحكم الوقر % % PageV01P1892 البحر : - 1(@)(@@) % وذلك جهر الحب والشوق سره % ولا خير في عشق يكون بلا جهر % % PageV01P1893 البحر : - 1(@)(@@) % وكم من ضروط قد أسال مخاطها % % هواها أبا الخرطوم غزرا على غزر % % PageV01P1894 البحر : - 1(@)(@@) % وقد لقبوه نهر بوق تعسفا % وفي الوغد اشباه من البوق والنهر % % PageV01P1895 البحر : - 1(@)(@@) % فللقد منه طول نهر معوج % وللأنف منه نغمة البوق في الكفر % % PageV01P1896 البحر : - 1(@)(@@) % ويا عجبا من أن عمرا منادم % وأني مدحور ألوف مع الدحر % % PageV01P1897 البحر : - 1(@)(@@) % ولو قيل شبه ريق ظبي تحبه % لشبهه المخبول بالسمن والتمر % % PageV01P1898 البحر : - 1(@)(@@) % أيا فيل بغداد إذا عاج خطمه % وخنزير كلواذي إذا عت في الجعر % % PageV01P1899 البحر : - 1(@)(@@) % ويا عجبا 
ms491	 من أن عمرا منادم % وأني مدحور ألوف مع الدحر % % PageV01P1900 البحر : - 1(@)(@@) % ولو قيلشبه ريق ظبي تحبه % لشبهه المخبول بالسمن والتمر % % PageV01P1901 البحر : - 1(@)(@@) % أيا فيل بغداد إذا عاج خطمه % % وخنزير كلواذى إذا عت في الجعر % % PageV01P1902 البحر : - 1(@)(@@) % يا مرزم القصر وهو أنف مكرم % وأنفك أولى بالختان من البظر % % PageV01P1903 البحر : - 1(@)(@@) % وتعقر قدري مستخفا بحاجتي % % رويدك إن القتل أدهى من العقر % % PageV01P1904 البحر : - 1(@)(@@) % منحتكها يا ابن الوزير تلعة % وفاكهة تكفيك فاكهة الشهر % % PageV01P1905 البحر : - 1(@)(@@) % وطالع هلال الصوم في وجه نعمة % مجددة زهراء بل نعم عشر % % PageV01P1906 البحر : - 1(@)(@@) % فأنتإذا ما تم أروع منظرا % وأعلى مكانا منه عند أخي حجر % % PageV01P1907 البحر : - 1(@)(@@) % ومتسخبر بالغيب عنك أجبته % وما منطق زكاه معناك بالنزر % PageV01P1908 البحر : - 1(@)(@@) % فقلت ولم أظلم لك والعرف وافر % فلا الصنع في خظر ولا العرف في حصر % % PageV01P1909 البحر : - 1(@)(@@) % هو البحر إن يصبح من الله مده % ففي الله يمشي جزره ساعة الجزر % % PageV01P1910 البحر : - 1(@)(@@) % وما جزره إلا استفاضة فضله % % على ساكني بدو وفي قاطني حضر % % PageV01P1911 البحر : - 1(@)(@@) % يفيض إذا فاضت يد الله جاريا % على عادتيه غير ملح ولا كدر % % PageV01P1912 البحر : - 1(@)(@@) % مدالا مديلا كل يوم وليلة % منالا منيلا زاكي الريع والبذر % % PageV01P1913 البحر : - 1(@)(@@) % يناهزه الساقي قريبا مجمه % ويسبره الداهي بعيدا على السبر % % PageV01P1914 البحر : - 1(@)(@@) % متى جئت ممتارا فناهيك من قتى % % وإن جئت مرتادا فناهيك من حبر % % PageV01P1915 البحر : - 1(@)(@@) % ألم ترني في ظل نعمة قاسم % قشرت العصا للمعتدي أيما قشر % % PageV01P1916 البحر : - 1(@)(@@) % وما حار لي حاشاه بل كان سيدا % أبى لي أن يدعونني شحمة الصهر % % PageV01P1917 البحر : - 1(@)(@@) % ومالي عديد حاضر غير أنني % % أروح وأغدو في عديد به دثر % % PageV01P1918 البحر : - 1(@)(@@) % تضيفته أحلى من الشهد مرفدا % وجاورته أحمى حميا من الدبر % % PageV01P1919 البحر : - 1(@)(@@) % وسيما قسيما يطرف العين نوره % حكيما ثابت الجاه والزبر % % PageV01P1920 البحر : - 1(@)(@@) % تباكي يداه الغيث طورا وتارة % يضاحك فوه البرق عن لؤلؤ حدر % PageV01P1921 البحر : - 1(@)(@@) % إذا باع تجر الحمد إياه حمدهم % % فقد ربحت ربح الغنى صفقة التجر % PageV01P1922 البحر : - 1(@)(@@) % يروقك من جد له وفكاهة 
ms492	 % بأحسن من وجه وأرشق من خصر % % PageV01P1923 البحر : - 1(@)(@@) % ويهوي إليه كل قلب بوده % % هوي القطامي الغريب إلى الوكر % % PageV01P1924 البحر : - 1(@)(@@) % لذلك أضحى فضل الله نشره % كتفضيله عرف النحور على القبر % % PageV01P1925 البحر : - 1(@)(@@) % وحسبك أن ألقى عليك اختياره % % إمام أطاعته القلوب بلا قهر % % PageV01P1926 البحر : - 1(@)(@@) % لقاء علي فيه عند اختباره % وحزم أبي حفص وعدل أبي بكر % % PageV01P1927 البحر : - 1(@)(@@) % وما لمديحي في ثناك زيادة % سوى انني نظام جوهرك النثر % PageV01P1928 البحر : - 1(@)(@@) % أقول وتعطي نائلا بعد نائل % فأقطع من صخر وتغرف من بحر % PageV01P1929 البحر : - 1(@)(@@) % ولا تغفلن أمرا وهي منه جانب % % فيتبعه في الوهي لاشك سائره % 2(@)(@@) % إذا طرف من حبلك انحل عقده % تداعت وشيكا بانتقاض مرائره % % PageV01P1930 البحر : - 1(@)(@@) % إذا اختط قوم خطة لمدينة % تقاضتهم أضعافها للمقابر % % 2(@)(@@) % وفي ذاك ما ينهاهم أن يشيدوا % % وأن يقتنوا إلا كزاد المسافر % PageV01P1931 البحر : - 1(@)(@@) % حريث نبيطي مسمى بحرثه % رآه مسميه صغيرا فصغرا % % 2(@)(@@) % إذا ما عواري الهجاء تعذرت % فقل فيه ما فيه فلن يتعذرا % % 3(@)(@@) % يسير على هاجيه وجدان سبه % وأعسر ما في سبه أن يسيرا % % 4(@)(@@) % وذلك أن الله أخمل ذكره % وأعطاه من شنع المخازي وأكثرا % % 5(@)(@@) % وكم مثله من خامل قد كسوته % % رداء جديد الطرتين محبرا % % 6(@)(@@) % فأضحى تراءاه العيون نباهة % ألا ساء زيا للفخور ومفخرا % % 7(@)(@@) % تشير إليه كل كف بسبة % كما ناهدت أيدي الحجيج المجمرا % % PageV01P1932 البحر : - 1(@)(@@) % قد زفت الشمس إلى البدر % يالك من قدر ومن قدر % 2(@)(@@) % خليفة الله على خلقه % % وبنت عالي الشأن والأمر % 3(@)(@@) % يا درة البحر بشرى إنما % % أخرجت من بحر إلى بحر % % 4(@)(@@) % لا زلت تأوين إلى ظله % % ما آوت الدنيا إلى الدهر % % PageV01P1933 البحر : - 1(@)(@@) % أفطر وأكباد العداة تفطر % في نعمة تنمي ودنيا تزهر % 2(@)(@@) % لا زلت تقدم في العلى طلابها % % ويقدمون إلى الردى وتؤخر % % 3(@)(@@) % وأما ومن أردى عدوك ما استوى % % لك قتله إلا وأنت معمر % % 4(@)(@@) % قد كان دبر ما علمت فعاقه % قدر عليه من السماء مدبر % % PageV01P1934 البحر : - 1(@)(@@) % لا وألحاظ العيون الساحره % % بين أهداب 
ms493	 الجفون الفاتره % % 2(@)(@@) % ما تولى آل وهب دولة % فرآها الله إلا ظافره % % 3(@)(@@) % وكفاكم بأبي قاسمهم % % ذي الأيادي والسجايا الطاهره % % 4(@)(@@) % من يكن لم يندر الدهر به % فعبيد الله فيه نادره % 5(@)(@@) % هل ترى يا قوم ما أبصره % من أبي القاسم عين ناظره % % 6(@)(@@) % سيد من سادة لابرحت % % نعم الله عليهم ظاهره % % 7(@)(@@) % ساسنا فالدهر عرس كله % وعطايا ووجوه ناضره % % 8(@)(@@) % بعدما كان حروبا تلتظي % % ورزايا ووجوها باسره % % 9(@)(@@) % أضحت الآفاق خرجا زاجيا % ولقد كانت سيوفا قاطره % % 10(@)(@@) % أقسم الملك يمينا إنه % بعض أعلام الإله الباهره % % PageV01P1935 11(@)(@@) % يا إمام الناس زده نعمة % لا تزل كفك كفا قادره % % 12(@)(@@) % واشكر الله الذي أعطاكه % إن في جنبيه نفسا شاكره % % 13(@)(@@) % كم تلافيت به من فائت % وتألفت به من نافره % % 14(@)(@@) % كم سنا نور ذكا منه وكم % % أطفأ الله به من نائره % % 15(@)(@@) % فتتوجه هنيئا إنه % % خير تيجانك تلك الفاخره % % 16(@)(@@) % وتمثل بهداه إنه % % خير أمثالك تلك السائره % % 17(@)(@@) % يا بني العباس شكرا إنكم % % في جنان ورياض زاهره % % 18(@)(@@) % سلمت يابن سليمان لكم % % زينة الدنيا وعقبى الآخره % % 19(@)(@@) % قد أنيلت كل كف خبئت % % وأقيلت كل رجل عاثره % % 20(@)(@@) % بإمام لم تزل آلاؤه % تتوالى كالغيوث الماطره % % PageV01P1936 21(@)(@@) % ملك بادرة بدرته % حين لاتبدر منه بادره % % 22(@)(@@) % ووزير عمر الدنيا لكم % % ولقد كانت خلاف العامره % 23(@)(@@) % شيد الملك به بنيانه % بعدما كان رسوما داثره % % 24(@)(@@) % وابهجوا يا آل وهب إنها % % كرة رابحة لا خاسره % % 25(@)(@@) % من سعادات جدود أقبلت % % وسعادات جدود حاضره % % 26(@)(@@) % تتوالى عن سعود جعلت % % أبدا طالعة لا غائره % % 27(@)(@@) % قد مضت كرة موت وأتت % % بعدها كرة خلد غابره % % 28(@)(@@) % ليس من فقر على راجيكم % وكذا ليست عليكم فاقره % % 29(@)(@@) % دارت الأفلاك بالفوز لكم % % وعلى رأس العدو الدائره % % PageV01P1937 البحر : - 1(@)(@@) % يظلم الناس يعلم اللهأفرى % % أنت بالكشخ منه أولى وأحرى % % 2(@)(@@) % كان للكركدن قرن فأضحى % % قرنه اليوم عند قرنك مدرى % % 3(@)(@@) % من يكن تاجه كتاجك هذا % % فليكن بابه كإيوان كسرى % % 4(@)(@@) % لاعدمت القرون يا ابن 
ms494	 حريث % إن في طولها لأرفع ذكرى % % 5(@)(@@) % لو تخففتبالقيادة ما اسطع % % ت لكنت الثقيل يا تل محرى % % 6(@)(@@) % لهتكت الحياء عنك فأبدى % % لك وجها كوجه أمك سكرى % % 7(@)(@@) % شر ماء صراه في شر صلب % % شر فحل قراه في شر مقرى % % 8(@)(@@) % خالط اللؤم في فقار أبيه % % فجرى اللؤم منه في كل مجرى % % 9(@)(@@) % يدعي الشعر وهو كفراء وفلكا % % من جؤاثا عليه كزى وهطرى % % 10(@)(@@) % بلغمي الطباع قد أضخمته % % لقوة لاتحيك فيها الشوصرى % % PageV01P1938 البحر : - 1(@)(@@) % أبا حفيص رويدا % أمرك من بعض ميري % % 2(@)(@@) % أأنت تشتم عرضي % % وأنت في طول أيري % % 2(@)(@@) % يا زوج تلك التي زوج % % ها البرية غيري % % 2(@)(@@) % ما ساقك الله نحوييا زوج تلك التي زوجها البرية غيري أأنت تشتم عرضيوأنت في طول أيريبذيء % % فيما أظن لخيري % % 3(@)(@@) % إن لم تدعك يميني % % بالصفع شماس دير % PageV01P1939 البحر : - 1(@)(@@) % وماء جلت عن حر صفحته القذى % % من الريح معطار الأصائل والبكر % 2(@)(@@) % به عبق مما تسحب فوقه % % نسيم الصبا تجري على النور والزهر % % PageV01P1940 البحر : - 1(@)(@@) % إن تصطنعني تصطنعني شاكرا % أو تختدعني تختدعني عاذرا % % PageV01P1941 البحر : - 1(@)(@@) % نعال كنباية والعنبر % ومسك دارينكم الأذفر % 2(@)(@@) % ومندل الهند الذي يرتضى % % يقسم في الناس ولا نذكر % % 3(@)(@@) % يا مانعينا من هداياكم % ثناؤنا من عطركم أعطر % % 4(@)(@@) % ثناؤنا يبقى ويطوي الفلا % % طيا فلا يثنى ولا يقصر % % 5(@)(@@) % وعطركم تدرس آثاره % ويسأم السير ولا يفخر % % 6(@)(@@) % أقسمت بالكأس إذا أعملت % % واصطخب المزمار والمزهر % % 7(@)(@@) % لو جائنا العود وأتباعه % % وخيرهن العنبر الأخضر % % 8(@)(@@) % لقد غدا يثنى به شعرنا % % أضعاف ما يثنى به المجمر % % 9(@)(@@) % أو جائنا المسك جزينا به % % مايصبح المسك به يهجر % % 10(@)(@@) % أو أصبح المنشور من شكرنا % % كأنه من ريحه ينشر % % PageV01P1942 11(@)(@@) % ولو أتى الكافور قلنا يد % % بيضاء كالكافور لاتكفر % % 12(@)(@@) % أو جائنا من عندكم مركب % أحمر كالشعلة أو أشقر % % 13(@)(@@) % نسبته ينسبها داهر % ولونه ينحله قيصر % % 14(@)(@@) % يعزى إلى السند ويعتده % في الروم لون ناصع أحمر % % 15(@)(@@) % مصرصر لكنه صيت % % عقارب الدار له تذعر % % 16(@)(@@) % فيه على 
ms495	 اعداء مستنجد % في ظلمة الليل ومستنصر % % 17(@)(@@) % ما صر إلا ولنا نطقه % بالشكر أو يحسر أو نحسر % % 18(@)(@@) % لانخل من جملة ألطافكم % % لا يخل من شكركم محضر % % 19(@)(@@) % ما خلت من يهدي لنا فانيا % نجزيه عنه باقيا يخسر % % 20(@)(@@) % الحمد لله الذي لم تزل % % أنواره ساطعة تزهر % % PageV01P1943 21(@)(@@) % حظي مما عندكم تافه % وحظكم من ودي الأوفر % % 22(@)(@@) % وليس بي قدر هداياكم % بل بي أني صاحب يحقر % % 23(@)(@@) % رأيتني إذا خنتم حصتي % % وموضعي من رأيكم أغبر % % 24(@)(@@) % وفعلكم عنوان آرائكم % % وقد يبين المخبر المنظر % % 25(@)(@@) % خذها وإن جدت بإسعافنا % % فلا تقل إني لا أشكر % % 26(@)(@@) % وإن أبى الله ومقداره % فلا تقل إني لا أعذر % % 27(@)(@@) % مهما يقدر منك في أمرنا % % فالعذر من تلقائنا يقدر % % 28(@)(@@) % ولو أردنا اللوم أعجزتنا % % وهل ينال القمر الأزهر % % 29(@)(@@) % ليس سماء الله منحطة % % وإن تدانت حين تستمطر % % 30(@)(@@) % يامن إذا حلاه إخوانه % حلي مدح حسنه يبهر % % PageV01P1944 31(@)(@@) % فإنما من عندهم نظمه % ومن لدنه الدر والجوهر % % PageV01P1945 البحر : - 1(@)(@@) % قالوا انتبذ قلت مهلا % عندي نبيذ كثير % 2(@)(@@) % ما عاش لي ابن سعيد % فإن شأني كبير % 3(@)(@@) % وكل ماأبتغيه % % فالخطب فيه يسير % % 4(@)(@@) % إذا كتبت إليه % % فليس شيء عسير % % 5(@)(@@) % لي عنده بحر سقيا % % للفلك فيه مسير % % 6(@)(@@) % فتى مباح العطايا % % إذا اعتراه فقير % % 7(@)(@@) % وللصديق ظهير % من عزه ونصير % % 8(@)(@@) % وباللطيف عليم % وبالخفي خبير % % 9(@)(@@) % وبالثناء سميع % وبالجميل بصير % % 10(@)(@@) % كم من رسول بعثنا % % ه نحوه يستمير % % PageV01P1946 11(@)(@@) % وافاه وهو رسول % وعاد وهو بشير % % 12(@)(@@) % قالوا فبرهن على ما % % تقول وهو جدير % % 13(@)(@@) % قلت الرسول وعندي % % للجاحد التنوير % % 14(@)(@@) % جيئوا به وكأن قد % جاء النبيذ يطير % % 15(@)(@@) % في ضمني النجح من قب % % ل أن يشير مشير % % 16(@)(@@) % عمرت يا بن سعيد % ماسرك التعمير % % 17(@)(@@) % فأنت لطالب العر % % ف روضة وغدير % % 18(@)(@@) % وأنت لطالب العل % % م بحر علم غزير % % 19(@)(@@) % على الكرام أمير % % وأنت ذاك الأمير % % 20(@)(@@) % الله لي فيك من كل % ل ما أخاف مجير % % PageV01P1947 21(@)(@@) % وفارس أجبن 
ms496	 من صفرد % % يحول أو يثول من صفره % 22(@)(@@) % لوصاح في الليل به صائح % لكانت الأرض له طفره % % 23(@)(@@) % يرحمه الرحمن من جبنه % % فيطعم الله به نصره % % 24(@)(@@) % من أقدم الناس ولكنما % % إقدامه تضييعه حذره % % PageV01P1948 البحر : - 1(@)(@@) % متنطق من جلده % % متختم في خصره % 2(@)(@@) % أبدا تراه وصدره % في بطنه أو ظهره % % PageV01P1949 البحر : - 1(@)(@@) % ألا بكرت حرى الملام تسعر % وبئس صبوح المرء لوم مبكر % 2(@)(@@) % توعدني بالشيب أن قد أظلني % % وماذكرتني غير ما كنت أذكر % % 3(@)(@@) % فقلت لها والمرء حام ومانع % شريعته ما أمكن القول مصدر % % 4(@)(@@) % ألا الآن إذ لم تبق إلا علالتي % % أبادر شيبي بالملاهي وأبدر % % 5(@)(@@) % نهتني فزادتني حفاظا على الصبى % % ألا ربما ينهى الجهول فيأمر % % PageV01P1950 البحر : - 1(@)(@@) % ترى شبه الآساد فيهم مبينا % ولكنهم أدهى دهاء وأنكر % 2(@)(@@) % وجوههم عند اللقاء وجوهها % % وألحاظهم ألحاظها حين تنظر % % 3(@)(@@) % هم هي لولا إربهم وحلومهم % % لهم منظر منها مهيب ومخبر % % 4(@)(@@) % لهم عدة تكفيهم كل عدة % بنات المنايا والحني المدثر % % 5(@)(@@) % هي القوة الحق المسماة قوة % % بتسمية القرآن فيما يفسر % % 6(@)(@@) % يزلون عن أكباد كل حنية % % خفافا مع الآجال تعلو وتقصر % % 7(@)(@@) % نواها نواهم في الرمايا كأنما % % مواقعها فيما يشاؤون يقدر % % 8(@)(@@) % لها ألسن ما تستفيق لهاتها % % يكاد لعاب الموت منهن يقطر % % 9(@)(@@) % ظماء إلى ورد الدماء نواهل % لها مورد من غيرمأتاه نصدر % % 10(@)(@@) % يولي المولي منهم وهو مانع % حقيقته لم يخز منه المذمر % % PageV01P1951 11(@)(@@) % يليك بحد شائك وهو مقبل % يليك بحد مثله حين يدبر % % 12(@)(@@) % هو النار من أي النواحي غشيتها % % تلقاك منها جانب يتسعر % % 13(@)(@@) % أو الرمح ذو النصلين كيف رهقته % رهقت حمامالموت أو يتأخر % % 14(@)(@@) % تكون له إجفالة ثم كرة % يدمرفيها سادرا ما يدمر % 15(@)(@@) % كذلك تلقى الليث فضل شهامة % تكون له إجلاءة ثم يعكر % % 16(@)(@@) % تراكهم ما تاركوك غنيمة % شهيدي رسول الله والحق يبهر % % 17(@)(@@) % فإن كنت منهم جاهلا أومغمرا % وهل من نثاهم جاهل مغمر % % 18(@)(@@) % فسائل بهم أعداءهم أو ديارهم % % تخبرك إن لم يبق منهم مخبر % % PageV01P1952 البحر 
ms497	 : - 1(@)(@@) % ومعتضد بالله أضحى وربه % له عضد يحميه دور الدوائر % % 2(@)(@@) % إذا كيد سرا كيد عنه عدوه % وفي بأسه كفء لبأس المجاهر % % 3(@)(@@) % وما كيد من أضحى له الله ناصرا % وعينا على مستخفيات السرائر % % 4(@)(@@) % ولو لم يخبر عن عداه لخبرت % جوارحهم عنهم بما في الضمائر % % 5(@)(@@) % وحق بنصر الله ناصر دينه % فأين به عن ناصر وابن ناصر % % 6(@)(@@) % إذا حاول الأعداء أن يمكروا به % % أحال عليهم مكرهم خير ماكر % % PageV01P1953 البحر : - 1(@)(@@) % ما إن علمنا من طعام حاضر % نعتده لفجاءة الزوار % 2(@)(@@) % كمهيئين من المطاعم فيهما % % شبه من الأبرار والفجار % 3(@)(@@) % هام وأرغفة وضاء فخمة % قد أخرجا من جاحم فوار % % 4(@)(@@) % كوجوه أهل الجنة ابتسمت لنا % % مقرونة بوجوه أهل النار % % PageV01P1954 البحر : - 1(@)(@@) % كأن نسيم الروض إبان نوره % % أرذت عليه مزنة حين أسحرا % % 2(@)(@@) % أتانا به رش من الريح لو نأى % % معرسنا عنه مدى النبل قصرا % % PageV01P1955 البحر : - 1(@)(@@) % إذا حسنت أخلاف قوم فبئسما % % خلفتم به أسلافكم آل طاهر % % 2(@)(@@) % جنوا لكم أن تمدحوا وجنيتم % لموتاكم أن يشتموا في المقابر % % 3(@)(@@) % فلو أنهم كانوا رأوا غيب أمركم % % لقد وأدوكم سيما أم عامر % % 4(@)(@@) % أحيئلة عرفاء تسحب رجلها % % أجدك لا يرضيك مدحة شاعر % % 5(@)(@@) % كأنك قد فت المديح فما ترى % % لمجدك فيه من كفي مقادر % % 6(@)(@@) % فكيف ولو جاريت من وطىء الحصا % % لجئت وراء الناس آخر آخر % % 7(@)(@@) % ألست بن بوشنج أعيرج ناقصا % وإن نلت مهما نلته بالمقادر % % 8(@)(@@) % وما كانت الدنيا وأنت عميدها % % لتعدل عند الله عبة طائر % % 9(@)(@@) % ولو كان في الناس ابن حر وحرة % لمت ولم تخطرعلى بال ذاكر % % 10(@)(@@) % أحسبك في العيدين إيجاف موكب % تخايل فيه مسبطر المشافر % % PageV01P1956 البحر : - 1(@)(@@) % ما يفيق الكتاب من ظلم إبرا % % هيم يوما ولا محاباة عمرو % % 2(@)(@@) % نحلوا ذا واوا وبزوا أخاه % % ألفا منه بين ردف وصدر % % 3(@)(@@) % وكذا يظلم المسمى بإبرا % % هيم أهل الديوان في كل أمر % % 4(@)(@@) % ويحابون من يسمى بعمرو % % فتفقد ما قلت في كل عصر % % PageV01P1957 البحر : - 1(@)(@@) % وحلس من الكتاب 
ms498	 أخضر ناعم % توسنه داني الرباب مطير % 2(@)(@@) % إذا درجت فيه السمال تتابعت % % ذوائبه حتى تقول غدير % % PageV01P1958 البحر : - 1(@)(@@) % وإذا بغى باغ عليك بجهله % % فاقتله بالمعروف لا بالمنكر % 2(@)(@@) % أحسن إليه إذا أساء فأنتما % % من ذي الجزاء بمسمع وبمنظر % PageV01P1959 البحر : - 1(@)(@@) % يود الفتى طول تعميره % ولا متناهي إلا قصير % 2(@)(@@) % كما أنكانبدء الفتى % % كذاك إلى كانأيضا يصير % % PageV01P1960 البحر : - 1(@)(@@) % أحل العراقي النبيذ وشربه % وقال الحرامان المدامة والسكر % 2(@)(@@) % وقال الحجازي الشرابان واحد % % فحلت لنا بين اختلافهما الخمر % 3(@)(@@) % سآخذ من قوليهما طرفيهما % % وأشربها لافارق الوازر الوزر % % PageV01P1961 البحر : - 1(@)(@@) % أظنك مما قد مطلت مثوبتي % % يسرك لو دارت علي الدوائر % 2(@)(@@) % إذا ورد المال الذي كنت أرتجي % % اتيحت له تلقاء غيري مصادر % % 3(@)(@@) % وعللت من ورد سواه بموعد % فليس لأمري آخر الدهر آخر % % 4(@)(@@) % تربص بي عضوا من المال بائرا % عليك وهل عضو من المال بائر % % 5(@)(@@) % تظل إذا حبرت فيك قصيدة % من المدح فيها المحكمات السوائر % % 6(@)(@@) % تقدر لي من كل مال تفيده % جزارته حتى كأني جازر % % 7(@)(@@) % لشتان ما بيني وبينكتصطفي % % مديحي وحظي من لهاك الحقائر % % 8(@)(@@) % ولسن لهى لكن منى ومواعد % % تأخرن حتى قيل هن عواقر % % 9(@)(@@) % إذا كان إنجاز المواعيد كرها % % فأحسن منها قبل ذاك المعاذر % % PageV01P1962 البحر : - 1(@)(@@) % أبا حسن إن حبل المطا % % ل إن مد كان بلا آخر % 2(@)(@@) % فإما اصطنعت إلى شاكر % وإما اعتذرت إلى عاذر % 3(@)(@@) % ولا عذر إن أنت خاتلتني % % عن العذر فعل امرىء ماكر % % 4(@)(@@) % فإن تعمل المطل حتى إذا % % حداني الملال مع الصادر % % 5(@)(@@) % وجاءك عني مالا تحب % ب من قذع منجد غائر % % 6(@)(@@) % وقلت لأول مستخبر % % وقفت على طلل داثر % % 7(@)(@@) % رحلت على أمل بادن % وأنت على أمل ضامر % % 8(@)(@@) % طفقت تؤنبني سادرا % لتلزمني الذنب في الظاهر % % 9(@)(@@) % وقلت امرؤ خانه صبره % وقدطال صبري على الصابر % % 10(@)(@@) % فلا تذهبن إلى هذه % % فلست لعقلي بالقامر % % PageV01P1963 11(@)(@@) % وقد يسرق العذر من مفحم % ولا يسرق العذر من شاعر % % PageV01P1964 البحر : - 1(@)(@@) % أبو علي بن أبي قره 
ms499	 % % أبو عيي بن أبي عره % 2(@)(@@) % نبئت عن شيخته أنها % % تفعل ما لا تفعل الحرة % % 3(@)(@@) % تلك التي صادفها بعلها % % عذراء لا شك من السرة % % 4(@)(@@) % شيخ له في حرها ضرة % ومالها في أيره ضره % 5(@)(@@) % لم يشهد الفتح ولاسيلت % طعنته من دمها قطره % % 6(@)(@@) % طهرني الله كتطهيره % % ليلة زفت من دم العذره % % 7(@)(@@) % ذاك دم لم يره ربه % أثر في ثوب أبي قره % % 8(@)(@@) % وابنهما النغل يرى أنه % % في الظرف والعلم فتى البصره % % PageV01P1965 البحر : - 1(@)(@@) % فقدتك يا ابن أبي طاهر % وأطعمت ثكلك من شاعر % 2(@)(@@) % فلست بسخن ولا بارد % % وما بين ذين سوى الفاتر % % 3(@)(@@) % وأنت كذاك تغثي النفو % % س تغثية الفاتر الخاثر % % 4(@)(@@) % تذبذب فنك بين الفنو % % ن فلا فن باد ولا حاضر % % 5(@)(@@) % رأيتك تنبحني سادرا % كفعلك بالقمر الباهر % % 6(@)(@@) % وما زال ذلك دأب الكلا % % ب وما ذاك للبدر بالضائر % % 7(@)(@@) % وإن قسي لموتورة % بكل أمين القوى حادر % % 8(@)(@@) % وإن سهامي لمبرية % % كهمك من عدة الثائر % 9(@)(@@) % ولكن وقاك معراتها % % تضاؤل قدرك في الخاطر % % 10(@)(@@) % فلا تخشى من أسهمي قاصدا % ولا تأمنن من العائر % % PageV01P1966 البحر : - 1(@)(@@) % رأيت جناة الحرب غير كفاتها % % إذا اختلفت فيها الرماح الشواجر % 2(@)(@@) % كذلك زناد النار عنها بنجوة % ولكنما تصلى صلاها المساعر % % PageV01P1967 البحر : - 1(@)(@@) % لي ابن عم يجر الشر مجتهدا % علي قدما ولا يصلى له نارا % % 2(@)(@@) % يجني فأصلى بما يجني فيخذلني % % وكلما كان زندا كنت مسعارا % % PageV01P1968 البحر : - 1(@)(@@) % ورازقي مخطف الخصورقد ضمنت مسكا إلى الشطوروفي الأعالي ماء ورد جوري لم يبق منه وهج الحرورإلا ضياء في ظروف نور لو أنه يبقى على الدهورقرط آذان الحسان الحور بلا فريد وبلا شذور له مذاق العسل المشور ونكهة المسك مع الكافورورقة الماء على % % كأنه مخازن البلور % PageV01P1969 البحر : - 1(@)(@@) % قد ضمنت مسكا إلى الشطور % % وفي الأعالي ماء ورد جوري % % PageV01P1970 البحر : - 1(@)(@@) % لم يبق منه وهج الحرور % % إلا ضياء في ظروف نور % % PageV01P1971 البحر : - 1(@)(@@) % لو أنه يبقى على الدهور % % قرط آذان الحسان الحور % % PageV01P1972 البحر : - 1(@)(@@) % بلا فريد 
ms500	 وبلا شذور % % له مذاق العسل المشور % % PageV01P1973 البحر : - 1(@)(@@) % ونكهة المسك مع الكافور % % ورقة الماء على الصدور % % PageV01P1974 البحر : - 1(@)(@@) % وبرد مس الخصر المقرور % % باكرته والطير في الوكور % % PageV01P1975 البحر : - 1(@)(@@) % وعذر اللذات في البكور % % بفتية من ولد المنصور % % PageV01P1976 البحر : - 1(@)(@@) % أملأ للعين من البدور % % حتى أتينا خيمة الناطور % % PageV01P1977 البحر : - 1(@)(@@) % قبل ارتفاع الشمس للذرور % % فانقض كالطاوي من الصقور % % PageV01P1978 البحر : - 1(@)(@@) % بطاعة الراغب لا المجبور % % والحر عبد الحلب المشطور % % PageV01P1979 البحر : - 1(@)(@@) % حتى أتانا بضروع خور % % مملوءة من عمل مخصور % % PageV01P1980 البحر : - 1(@)(@@) % والطل مثل اللؤلؤ المنثور % % من ناقع فيها ومن محدور % % PageV01P1981 البحر : - 1(@)(@@) % أبيض مثل المهرق المنشور % % أو مثل متن المنصل المشهور % % PageV01P1982 البحر : - 1(@)(@@) % ينساب مثل الحية المذعور % % بين سماطي شجر مسطور % % PageV01P1983 البحر : - 1(@)(@@) % ناهيك للعنقود من طهور % % فنيلت الأوطار في سرور % % PageV01P1984 البحر : - 1(@)(@@) % وكل ما نقضي من الأمور % % تعلة عن يومنا المنظور % % PageV01P1985 البحر : - 1(@)(@@) % ومتعة من متع الغرور % % PageV01P1986 البحر : - 1(@)(@@) % المنسرح شنطف يا عوذة السموات والأرض % % وشمس النهار والقمر % PageV01P1987 البحر : - 1(@)(@@) % إن كان إبليس خالقا بشرا % أنت عندي من ذلك البشر % % 2(@)(@@) % صورك المارد اللعين فأع % % طتك يداه مقابح الصور % 3(@)(@@) % ولم تعافي من البغاء ولا ال % % برد وخبث النسيم والدفر % % 4(@)(@@) % بل أنت فوق المنى إذا ذكر ال % % قبح وفحش العيوب والقذر % % 5(@)(@@) % لم تقطعي قط ذا مكايدة % بل تقطعين الوتين بالبخر % % 6(@)(@@) % والطيز عند الغناء مختلج % تضحك أشداقه إلى الكمر % % 6(@)(@@) % ترمين آنافنا بأسهمهوالطيز عند الغناء مختلجتضحك أشداقه إلى الكمر بذيء % % عن شر قوس وشر ما وتر % % 7(@)(@@) % شنطف يا سوء ما منيت به % % ما كنت إلا فريسة القدر % % 8(@)(@@) % كأن قوائم العرش استحالت % قوائمها بمعترك الأيور % % 8(@)(@@) % إذا استلقت فأثبت من فراش % % وإن كبت فأثبت من سرير % % PageV01P1988 8(@)(@@) % لم تنشري قط نائكا وكذاوافر إذا استلقت فأثبت من فراشوإن كبت فأثبت من سرير كأن قوائم العرش استحالتقوائمها بمعترك الأيور % % وجهك حقا يا نشرة النشر % % PageV01P1989 البحر : - 1(@)(@@) % قرأت على أهلي كتابك إذ أتى % % وقلت لهم هذا أمان من الدهر % % 2(@)(@@) % فكل امرىء 