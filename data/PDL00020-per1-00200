ms181	 تیرگی داری و بیرون سو صفا(@)(@@) 7 آتشین داری زبان و دل سیاهی چون چراغ %~% گرد خود گردی از آن تردامنی چون آسیا(@)(@@) 8 رخت از این گنبد برون بر گر حیاتی بایدت %~% زان که تا در گنبدی با مردگانی هم وطا(@)(@@) 9 نفس عیسی جست خواهی راه کن سوی فلک %~% نقش عیسی در نگارستان راهب کن رها(@)(@@) 10 بر گذر زین تنگنای ظلمت اینک روشنی %~% درگذر زین خشک سال آفت اینک مرحبا(@)(@@) 11 بر در فقر آی تا پیش آیدت سرهنگ عشق %~% گوید ای صاحب خراج هر دو گیتی اندر آ(@)(@@) 12 شرب عزلت ساختی از سر ببر باد هوس %~% باغ وحدت یافتی از بن بکن بیخ هوا(@)(@@) 13 با قطار خوک در بیت المقدس پا منه %~% با سپاه پیل بر درگاه بیت الله میا(@)(@@) 14 سر بنه کاینجا سری را صد سر آید در عوض %~% بلکه بر سر هر سری را صد کلاه آید عطا(@)(@@) 15 هر چه جز نور السموات از خدائی عزل کن %~% گر تو را مشکوة دل روشن شد از مصباح لا(@)(@@) 16 چون رسیدی بر در لاصدر الا جوی از آنک %~% کعبه را هم دید باید چون رسیدی در منا(@)(@@) 17 ور تو اعمی بوده‌ای بر دوش احمد دار دست %~% کاندر این ره قائد تو مصطفی به مصطفا(@)(@@) 18 اوست مختار خدا و چرخ و ارواح و حواس %~% زان گرفتند از وجودش منت بی‌منتها(@)(@@) 19 هشت خلد و هفت چرخ و شش جهات و پنج حس %~% چار ارکان و سه ارواح و دو کون از یک خدا(@)(@@) 20 چون مرا در نعت چون اویی رود چندین سخن %~% از جهان بر چون منی تا کی رود چندین جفا PageV1P0412(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 کار من بالا نمی‌گیرد در این شیب بلا %~% در مضیق حادثاتم بسته بند عنا(@)(@@) 2 می‌کنم جهدی کزین خضرای خذلان بر پرم %~% حبذا روزی که این توفیق یابم حبذا(@)(@@) 3 صبح آخر دیده بختم 
ms182	 چنان شد پرده در %~% صبح اول دیده عمرم چنان شد کم بقا(@)(@@) 4 با که گیرم انس کز اهل وفا بی‌روزیم %~% من چنین بی‌روزیم یا نیست در عالم وفا(@)(@@) 5 در همه شروان مرا حاصل نیامد نیم دوست %~% دوست خود ناممکن است ایکاش بودی آشنا(@)(@@) 6 من حسین وقت و نااهلان یزید و شمر من %~% روزگارم جمله عاشورا و شروان کربلا(@)(@@) 7 ای عراق الله جارک نیک مشعوفم به تو %~% وی خراسان عمرک الله سخت مشتاقم تو را(@)(@@) 8 گرچه جان از روزن چشم از شما بی‌روزی است %~% از دریچه گوش می‌بیند شعاعات شما(@)(@@) 9 عذر من دانید کاینجا پای بست مادرم %~% هدیه جانم روان دارید بر دست صبا(@)(@@) 10 تشنه دل تفته‌ام از دجله آریدم شراب %~% دردمند زارم از بغداد سازیدم دوا(@)(@@) 11 بوی راحت چون توان برد از مزاج این دیار %~% نوشدارو چون توان جست از دهان اژدها(@)(@@) 12 پیش ما بینی کریمانی که گاه مائده %~% ماکیان بر در کنند و گربه در زندان سرا(@)(@@) 13 گر برای شوربائی بر در اینها شوی %~% اولت سکبا دهند از چهره آنگه شوربا(@)(@@) 14 مردم ای خاقانی اهریمن شدند از خشم و ظلم %~% در عدم نه روی کانجا بینی انصاف و رضا PageV1P0413(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 عروس عافیت آنگه قبول کرد مرا %~% که عمر بیش‌بها دادمش به شیربها(@)(@@) 2 چو کشت عافیتم خوشه در گلو آورد %~% چو خوشه باز بریدم گلوی کام و هوا(@)(@@) 3 خروس کنگره عقل پر بکوفت چو دید %~% که در شب امل من سپیده شد پیدا(@)(@@) 4 چو ماه سی شبه ناچیز شد خیال غرور %~% چو روز پانزده ساعت کمال یافت ضیا(@)(@@) 5 مسیح وار پی راستی گرفت آن دل %~% که باژ گونه روی بود چون خط ترسا(@)(@@) 6 ز مرغزار سلامت در مراست خبر %~% که هم مسیح خبر دارد از مزاج گیا(@)(@@) 7 مرا طبیب دل اندرز گونه‌ای کرده است %~% کز این سواد بترس از حوادث سودا 
ms183	(@)(@@) 8 به تلخ و ترش رضا ده به خوان گیتی بر %~% که نیشتر خوری ار بیشتر خوری حلوا(@)(@@) 9 اسیر طبع مخالف مدار جان و خرد %~% زبون چارزبانی مکن دو حور لقا(@)(@@) 10 که پوست پاره‌ای آمد هلاک دولت آن %~% که مغز بی‌گنهان را دهد به اژدها(@)(@@) 11 مرا شهنشه وحدت ز داغ گاه خرد %~% به شیب و مقرعه دعوت همی کند که بیا(@)(@@) 12 از این سراچه آوا و رنگ دل بگسل %~% به ارغوان ده رنگ و به ارغنون آوا(@)(@@) 13 در این رصد گه خاکی چه خاک می‌بیزی %~% نه کودکی نه مقامر ز خاک چیست تو را(@)(@@) 14 به دست آز مده دل که بهر فرش کنشت %~% ز بام کعبه ند زدند مکیان دیبا(@)(@@) 15 به بوی نفس مکن جان که بهر گردن خوک %~% کسی نبرد زنجیر مسجد الاقصا(@)(@@) 16 ببین که کوکبه عمر خضر وار گذشت %~% تو بازمانده چو موسی به تیه خوف و رجا(@)(@@) 17 پریر نوبت حج بود و مهد خواجه هنوز %~% از آن سوی عرفات است چشم بر فردا(@)(@@) 18 به چاه جاه چه افتی و عمر در نقصان %~% به قصد فصد چه کوشی و ماه در جوزا(@)(@@) 19 برفت روز و تو چون طفل خرمی آری %~% نشاط طفل نماز دگر بود عذرا(@)(@@) 20 چو عمر دادی دنیا بده که خوش نبود %~% به صد خزینه تبذل به دانگی استقصا(@)(@@) 21 دو رنگی شب و روز سپهر بوقلمون %~% پرند عمر تو را می‌برند رنگ و بها(@)(@@) 22 دو چشمه‌اند یکی قیر و دیگری سیماب %~% شب بنفشه وش و روز یاسمین سیما(@)(@@) 23 تو غرق چشمه سیماب و قیر و پنداری %~% که گرد چشمه حیوان و کوثری به چرا(@)(@@) 24 جهان به چشمی ماند در او سیاه و سپید %~% سپید ناخنه دار تو سیاه نابینا(@)(@@) 25 ببر طناب هوس پیش از آنکه ایامت %~% چهار میخ کند زیر خیمه خضرا(@)(@@) 26 به صور نیم شبی درفکن رواق 
