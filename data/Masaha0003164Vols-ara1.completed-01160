ms1141	 العبادى.(@)(@)(@@)(@@)(@@) $ القمى: ابراهيم الكاشانى(@)(@)(@@) -،(@)(@)(@@)(@@)(@@) $ القمى: احمد الفتحانى(@)(@)(@@) -،(@)(@)(@@)(@@)(@@) $ القمى: احمد(@)(@)(@@) -،(@)(@)(@@)(@@)(@@) $ القمى: عطا على(@)(@)(@@) -،(@)(@)(@@)(@@)(@@) $ القمى: على المنعل(@)(@)(@@) -،(@)(@)PageV07P190(@)(@)(@@)(@@)(@@) $ القمى: ابو الفتح(@)(@)(@@) -،(@)(@)(@@)(@@)(@@) $ القمى: محسن الرضوى(@)(@)(@@) -،(@)(@)(@@)(@@)(@@) $ القمى: مسعود(@)(@)(@@) -.(@)(@)(@@)(@@)(@@) $ القناقوى:(@)(@)(@@) يوسف-.(@)(@)(@@)(@@)(@@) $ قوام الدين: حسن النقيب(@)(@)(@@) -،(@)(@)(@@)(@@)(@@) $ قوام الدين: الحسين الخفرى(@)(@)(@@) -،(@)(@)(@@)(@@)(@@) $ قوام الدين: عبد الله بن محمود(@)(@)(@@) -،(@)(@)(@@)(@@)(@@) $ قوام الدين: يوسف الشيرازى(@)(@)(@@) -.(@)(@)(@@)(@@)(@@) $ القهستانى:(@)(@)(@@) الحسين الايدى-.(@)(@)(@@)(@@)(@@) $ القيروانى:(@)(@)(@@) سعيد-.(@)(@)PageV07P191(@)(@)(@@)(@@)(@@) || «ك»(@)(@)(@@)(@@)(@@) $ كاتب الآستانه:(@)(@)(@@) كيقباد-.(@)(@)(@@)(@@)(@@) $ الكاتب السلطانى:(@)(@)(@@) محمد-.(@)(@)(@@)(@@)(@@) $ الكازرونى:(@)(@)(@@) ابو القاسم-.(@)(@)(@@)(@@)(@@) $ الكاشانى: ابراهيم(@)(@)(@@) -،(@)(@)(@@)(@@)(@@) $ الكاشانى: احمد الفتحانى(@)(@)(@@) -،(@)(@)(@@)(@@)(@@) $ الكاشانى: تقى الدين-، جعفر(@)(@)(@@) -،(@)(@)(@@)(@@)(@@) $ الكاشانى: حبيب الله-،(@)(@)(@@)(@@)(@@) $ الكاشانى: الحافظ(@)(@)(@@) -،(@)(@)(@@)(@@)(@@) $ الكاشانى: الحسن(@)(@)(@@) -،(@)(@)(@@)(@@)(@@) $ الكاشانى: الحسين(@)(@)(@@) -،(@)(@)(@@)(@@)(@@) $ الكاشانى: سعد الدين الاسترآبادى(@)(@)(@@) -،(@)(@)(@@)(@@)(@@) $ الكاشانى: سلطان احمد(@)(@)(@@) -،(@)(@)(@@)(@@)(@@) $ الكاشانى: شمس الدين(@)(@)(@@) -،(@)(@)(@@)(@@)(@@) $ الكاشانى: صدر الدين(@)(@)(@@) -،(@)(@)(@@)(@@)(@@) $ الكاشانى: طاهر(@)(@)(@@) -،(@)(@)(@@)(@@)(@@) $ الكاشانى: فتح الله(@)(@)(@@) -،(@)(@)(@@)(@@)(@@) $ الكاشانى: محتشم(@)(@)(@@) -،(@)(@)(@@)(@@)(@@) $ الكاشانى: محمد(@)(@)(@@) -،(@)(@)(@@)(@@)(@@) $ الكاشانى: يحيى(@)(@)(@@) -.(@)(@)(@@)(@@)(@@) $ الكاشفى:(@)(@)(@@) الحسين-.(@)(@)(@@)(@@)(@@) $ الكاظمى:(@)(@)(@@) محمد-.(@)(@)(@@)(@@)(@@) $ كبه مير:(@)(@)(@@) مطهر-.(@)(@)(@@)(@@)(@@) $ كتابدار:(@)(@)(@@) على-.(@)(@)(@@)(@@)(@@) $ الكربلائى:(@)(@)(@@) حسين-.(@)(@)PageV07P192(@)(@)(@@)(@@)(@@) $ الكركى: الحسن(@)(@)(@@) -،(@)(@)(@@)(@@)(@@) $ الكركى: الحسن بن جعفر(@)(@)(@@) -،(@)(@)(@@)(@@)(@@) $ الكركى: الحسين(@)(@)(@@) -،(@)(@)(@@)(@@)(@@) $ الكركى: الحسين المجتهد(@)(@)(@@) -،(@)(@)(@@)(@@)(@@) $ الكركى: عبد الحميد(@)(@)(@@) -،(@)(@)(@@)(@@)(@@) $ الكركى: عبد العالى(@)(@)(@@) -،(@)(@)(@@)(@@)(@@) $ الكركى: على بن شجاع(@)(@)(@@) -،(@)(@)(@@)(@@)(@@) $ الكركى: على(@)(@)(@@) -،(@)(@)(@@)(@@)(@@) $ الكركى: على المنشار-.(@)(@)(@@)(@@)(@@) $ الكرمانى:(@)(@)(@@) مؤمن-.(@)(@)(@@)(@@)(@@) $ محمد كريم الدشت بياضى:(@)(@)(@@) ابن فصيح الدين محمد القاضى، كان قاضيا بها. له «شرح نصاب الصبيان» المطبوع 1266 وبعدها، معه شرح ملحقات النصاب التى الحقها به والده فصيح الدين وأظن والده فصيح الدين هو الشارح ل «بيست باب» (-ذ 13: 131) باسم الوزير مير على شير النوائى (م 906) وهو ابن عبد الكريم البسطامى الأصل ولعله متحد مع كريم الدين الشيرازى.(@)(@)(@@)(@@)(@@) $ كريم الدين الشيرازى:(@)(@)(@@) من تلاميذ ابراهيم بن سليمان القطيفى المعاصر للمحقق الكركى والمتوفى بعد 945. ويروى عنه شجاع الدين محمود بن على، كما ذكره الحسين بن حيدر بن قمر الكركى فى مشيخته (ذ 1 قم 600 والبحار-ج 109: 161-176) عند روايته عن شجاع الدين محمود بن على المرعشى وهو جد سلطان العلماء، ومر فصيح الدين ابن عبد الكريم شارح «بيست باب» باسم الوزير مير علىشير النوائى (ص 154) وله ملحقات «النصاب» التى شرحها مع اصل «النصاب» ولده القاضى محمد كريم بن فصيح الدين الذى هو سمى جده القاضى بدشت بياض.(@)(@)(@@)(@@)(@@) $ الكشميرى:(@)(@)(@@) عبد اللطيف-.(@)(@)(@@)(@@)(@@) $ الكعبى:(@)(@)(@@) صالح الحميدانى-.(@)(@)(@@)(@@)(@@) $ الكفعمى: ابراهيم(@)(@)(@@) -،(@)(@)(@@)(@@)(@@) $ الكفعمى: احمد-.(@)(@)(@@) (القرن العاشر: 13)(@)(@)PageV07P193(@)(@)(@@)(@@)(@@) $ كمال الدين: حبيب الله 
ms1142	 الجزردانى-،(@)(@)(@@)(@@)(@@) $ كمال الدين: حسن الاسترآبادى-،(@)(@)(@@)(@@)(@@) $ كمال الدين: حسين الالهى(@)(@)(@@) -،(@)(@)(@@)(@@)(@@) $ كمال الدين: حسين الشيرازى-،(@)(@)(@@)(@@)(@@) $ كمال الدين: الحسين الكاشفى-،(@)(@)(@@)(@@)(@@) $ كمال الدين: الحسينى الميبدى-،(@)(@)(@@)(@@)(@@) $ كمال الدين: درويش محمد العاملى(@)(@)(@@) -،(@)(@)(@@)(@@)(@@) $ كمال الدين: محسن الرضوى-،(@)(@)(@@)(@@)(@@) $ كمال الدين: محمد الاسترآبادى-،(@)(@)(@@)(@@)(@@) $ كمال الدين: محمد اللارى(@)(@)(@@) -.(@)(@)(@@)(@@)(@@) $ كمال الدين الاسترآبادى:(@)(@)(@@) ابن الخواجه مقصود على؛ كتب بخطه «شرح الاشارات» للخواجه نصير الدين سنة 980 وصححه وقابله لفظيا معتذرا بأنه قليل البضاعة وأحال إكماله إلى ذوى البضاعة. والنسخة فى موقوفة مدرسة (البروجردى بالنجف) .(@)(@)(@@)(@@)(@@) $ كمال الدين المازندرانى:(@)(@)(@@) ابن غياث. كتب بخطه قطعة من كتاب الطهارة من «التذكرة» للحلى وفرغ منه فى (5 ج 2-932) . رأيته عند السيد مصطفى التسترى فى النجف.(@)(@)(@@)(@@)(@@) $ الكونينى:(@)(@)(@@) مفلح-.(@)(@)(@@)(@@)(@@) $ كيا:(@)(@)(@@) على-.(@)(@)(@@)(@@)(@@) $ ملا كيقباد:(@)(@)(@@) كاتب الآستانة الرضوية، من الأفاضل. كتب بخطه الجزء الأول من عقود «جامع المقاصد» من المتاجر إلى إحياء الموات سنة 962 والنسخة موجودة ولعلها من وقفه فى (الرضوية) . وبخطه أيضا فى 960 «نهاية الاحكام» للحلى الجزء الاول منه فى كتب المدرسة (الفاضلية) .(@)(@)PageV07P194(@)(@)(@@)(@@)(@@) || «گ»(@)(@)(@@)(@@)(@@) $ گرگين:(@)(@)(@@) ابراهيم الاسترآبادى-:(@)(@)(@@)(@@)(@@) $ الگيلانى: احمد الگيلكى(@)(@)(@@) -،(@)(@)(@@)(@@)(@@) $ الگيلانى: پيله فقيه(@)(@)(@@) -،(@)(@)(@@)(@@)(@@) $ الگيلانى: الطالقانى(@)(@)(@@) -،(@)(@)(@@)(@@)(@@) $ الگيلانى: عبد الله-، محمد(@)(@)(@@) -.(@)(@)PageV07P195(@)(@)(@@)(@@)(@@) || «ل»(@)(@)(@@)(@@)(@@) $ اللارى:(@)(@)(@@) محمد-.(@)(@)(@@)(@@)(@@) $ اللاهيجى: احمد الجيلانى(@)(@)(@@) -،(@)(@)(@@)(@@)(@@) $ اللاهيجى: أحمد(@)(@)(@@) -،(@)(@)(@@)(@@)(@@) $ اللاهيجى: پيله فقيه(@)(@)(@@) -،(@)(@)(@@)(@@)(@@) $ اللاهيجى: شيخ زادهء(@)(@)(@@) -،(@)(@)(@@)(@@)(@@) $ اللاهيجى: عبد الوهاب(@)(@)(@@) -،(@)(@)(@@)(@@)(@@) $ اللاهيجى: على(@)(@)(@@) -،(@)(@)(@@)(@@)(@@) $ اللاهيجى: محمود(@)(@)(@@) -.(@)(@)(@@)(@@)(@@) $ لسان:(@)(@)(@@) صدر جهان الطبسى-.(@)(@)(@@)(@@)(@@) $ اللنگرودى:(@)(@)(@@) الحسين الرضوى-.(@)(@)(@@)(@@)(@@) $ لوحى الاصفهانى (الملا-) :(@)(@)(@@) من دراويش شعراء أهل البيت ومادحيهم كما فى «تذكرهء نصرآبادى-ص 430» وبه لقب سبطه محمد بن محمد الموسوى الذى ولد قبل الألف كان حياء الى 1063 وهو الشهير بمير لوحى كما ذكر فى «صحيفة الرشاد» (ذ 15 قم 91 وذ 19 قم 406) والظاهر أن اللقب كان بعد وفات الملا لوحى، فالظاهر أنه من العاشرة.(@)(@)(@@)(@@)(@@) $ اللويزى-اللويزانى: ابراهيم الكفعمى(@)(@)(@@) -،(@)(@)(@@)(@@)(@@) $ اللويزى-اللويزانى: عبد الصمد الجباعى(@)(@)(@@) .(@)(@)(@@)(@@)(@@) $ ليث البحرانى:(@)(@)(@@) عبر عنه فى «الرياض 4: 427» بالشيخ الأجل وقال كان من متأخرى علماء البحرين وقد ذكره عبد الرحيم بن الحسين البحرانى فى كتاب «جوامع السعادات فى فنون الدعوات» ووصفه ب[الشيخ الجليل النبيل]ونسب إليه كتاب «النهج القويم» فى مناجات(@)(@)PageV07P196(@) الرب العظيم» (-ذ 24 قم 2219) وينقل عنه بعض الأدعية. 
ms1143	 أقول: ومر فى ص 120 عبد الرحيم وكتابه «جوامع السعادات» .(@)(@)(@@)(@@)(@@) $ الليثى: على(@)(@)(@@) -،(@)(@)(@@)(@@)(@@) $ الليثى: عوض(@)(@)(@@) -.(@)(@)PageV07P197(@)(@)(@@)(@@)(@@) || «م»(@)(@)(@@)(@@)(@@) $ ماجد الشيبانى:(@)(@)(@@) يأتى فى الحادى عشر.(@)(@)(@@)(@@)(@@) $ ماجد المهرى:(@)(@)(@@) ابن مسعود بن شمس بن كمال بن مسعود المهرى الحصارى الفاضل. كتب بخطه «من لا يحضره الفقيه» وفرغ من بعض أجزائه 985 رأيت النسخة. فى كتب السيد محمد اليزدى وعليها خطوط العلماء واجازاتهم، منها اجازة الشيخ على بن احمد بن أبى جامع للسيد خلف الحويزى.(@)(@)(@@)(@@)(@@) $ الماحوزى:(@)(@)(@@) على-.(@)(@)(@@)(@@)(@@) $ المارونى:(@)(@)(@@) مفلح-.(@)(@)(@@)(@@)(@@) $ المازحى:(@)(@)(@@) احمد-.(@)(@)(@@)(@@)(@@) $ المازندرانى: احمد الغفارى(@)(@)(@@) -،(@)(@)(@@)(@@)(@@) $ المازندرانى: على(@)(@)(@@) -،(@)(@)(@@)(@@)(@@) $ المازندرانى: كمال الدين(@)(@)(@@) -،(@)(@)(@@)(@@)(@@) $ المازندرانى: محمد(@)(@)(@@) -،(@)(@)(@@)(@@)(@@) $ المازندرانى: موسى(@)(@)(@@) -.(@)(@)(@@)(@@)(@@) $ مهارك اليمانى:(@)(@)(@@) ابن خضر الهندى المولود 911 والمتوفى 1001 ولتاريخ وفاته ذكرته فى المئة الحاديعشرة.(@)(@)(@@)(@@)(@@) $ المتروكى:(@)(@)(@@) نجم الدين-.(@)(@)PageV07P198(@)(@)(@@)(@@)(@@) $ المتكلم:(@)(@)(@@) ابو البركات الاسترآبادى-.(@)(@)(@@)(@@)(@@) $ المتوج (1) :(@)(@)(@@) منصور البحرانى-.(@)(@)(@@)(@@)(@@) $ ابو المجد:(@)(@)(@@) حسن-.(@)(@)(@@)(@@)(@@) $ المجتهد: الحسين(@)(@)(@@) -،(@)(@)(@@)(@@)(@@) $ المجتهد: الكركى(@)(@)(@@) -.(@)(@)(@@)(@@)(@@) $ المجلسى:(@)(@)(@@) مقصود على-.(@)(@)(@@)(@@)(@@) $ ابو المحاسن: الحسين الجرجانى(@)(@)(@@) -،(@)(@)(@@)(@@)(@@) $ ابو المحاسن: زهرة الجبعى(@)(@)(@@) -.(@)(@)(@@)(@@)(@@) $ محتشم الكاشانى:(@)(@)(@@) الشاعر الشهير (913-996) كان معاصر الشاه طهماسب والمحقق الكركى وقد أرخ جلوس الشاه اسماعيل الثانى السنى بسنة 984 فى ستة رباعيات اوردها النصرآبادى. وله «يازده بند» (2) المشهور فى المراثى الذى عربه آية الله بحر العلوم و«خمسه ثاقب» و«گريان» وغيرهما. وديوانه جامع اللطائف أيضا موجود، وفى تذكرة نصرآبادى ص 472 أورد تاريخ موت ميرزا مخدوم المذكور فى ص 176 بسنة 992 فى رباعية لمحتشم. وحكى فى «خزانهء عامره» ص 404 تاريخ موت محتشم عن تذكرة محمد صادق ناظم التبريزى انه عام 1000 وعن تذكرة داغستانى أنه[درد محتشم-(@)(@)PageV07P199(@)(@)(@@) 996]وتوفى الناظم حدود تأليف تذكرة نصرآبادى كما جاء فيه ص 412 وكان تأليفه فى الربع الأخير من القرن الحادى عشر.(@)(@)(@@)(@@)(@@) $ محسن الدشتكى:(@)(@)(@@) ابن المير شرف الدين على بن المير غياث الدين منصور بن المير صدر الدين محمد الحسينى الشيرازى. هو من الاعلام الاجلاء ويكنى ابو محمد. يروى عنه الميرزا محمد بن على بن ابراهيم الاسترآبادى الرجالى صاحب كتب الرجال الكبير والوسيط والوجيز (م 1028) وهو يروى عن والده على عن والده المير غياث الدين منصور الدشتكى (م 948) عن آبائه مسلسلا إلى أمير المؤمنين (ع) كما 
ms1144	 ذكره نظام الدين احمد بن معصوم والد السيد على خان الدشتكى فى اجازته (ذ 1 قم 679) لجمال الدين محمد بن عبد الحسين الدشتكى.(@)(@)(@@)(@@)(@@) $ محسن الرضوى:(@)(@)(@@) كمال الدين بن رضى الدين محمد بن فادشاه القمى المشهدى المجاز من محمد بن على بن أبى جمهور الأحسائى فى 15 ذى القعدة 897 (ذ 1 قم 1279) والاجازة موجودة فى البحار (ج 108 ص 3-13) بطرقه السبعة المذكورة فى أول «العوالى (1) » ويروى عنه ولد العالم الجليل شمس الدين محمد مهدى بن محسن الرضوى تلميذ المحقق الكركى والمجاز منه بالاجازة الصادرة له من المحقق الكركى فى 937 (ذ 1 قم 1127) قال المحقق الكركى فى تلك الاجازة بعد ذكر اوصاف المجاز[السيد محمد الملقب بالمهدى بن المرحوم المبرور المتوج المحبور، شرف السادة والنقباء، قدوة الأجلاء الفضلاء الاتقياء، كمال السيادة والدين محسن الرضوى المشهدى قدس الله روحه]وأطرى فى الثناء عليه استاده ابن أبى جمهور فى اجازته المذكورة وكتب جملة من نصانيفه بالتماس هذا السيد مصرحا باسمه فى البعض مثل «كشف البراهين» ومعبرا عنه ببعض السادة فى بعض آخر مثل «كاشفة الحال» وسمى بعض كتبه باسمه مثل «الطوالع المحسنية» فى شرح الرسالة الجمهورية وذكر فى أول مناظرته الفاضل الهروى: أنه كان فى المشهد الرضوى. قال[وكان منزلى بمنزل السيد الأجل والكهف الأظل محسن بن محمد الرضوى القمى وكان من أعيان المشهد وأشرافهم]وكان تشرفه(@)(@)PageV07P200(@) بالمشهد الرضوى بعد اتمام حجة فى 877 وعوده إلى العراق، ثم توجه لزيارة المشهد وفى الطريق شرع فى «زاد المسافرين» وتممه فى المشهد فى دار السيد محسن، وشرحه باستدعائه وسمى الشرح «كشف البراهين فى شرح زاد المسافرين» وفرغ منه 878.(@)(@)(@@)(@@)(@@) $ محسن المشعشعى:(@)(@)(@@) ابن محمد بن فلاح المذكور والده فى التاسعة ص 130-131 تسلط بعد موت أبيه فى 870 وبنى «المحسنية» إلى أن مات فى 905 وله عدة أولاد:(@)(@)(@@) سلطان على وفياض المعارض معه حتى قتل وفلاح (م 912) وحسن الذى قتله أخوه الفلاح وأيوب، ذكرهم عبد الله التسترى فى «تذكرهء شوشتر» (ذ 3 قم 900) وهم ملوك الحويزة وسلاطينها ويعبر عنه 
ms1145	 بسلطان محسن. قال فى «المجالس» إنه كان كريما محبا لأهل الفضل ولذا كتب علماء الشيعة باسمه كتبا ورسائل، فكتب شمس الدين محمد الاسترآبادى باسمه «حاشية شرح التجريد «للقوشچى (ذ 6 قم 622) . أقول: ظاهر نظر علمائنا إليه أنه لم يكن كأخيه على المقتول فى 860 فى حياة أبيه محمد من الغلاة ولا مثل أعدائه المقصرين (1) بل كان أولاده سلطان على وأيوب كما ذكره فى «المجالس» من مروجى المذهب الحق الوسط وان قتلهما الشاه اسماعيل مع بعض آخر سنة 914 بتهمة الغلو وحيدر بن محسن هو الذى رخص ولده عبد المطلب فى إقامة الصلاة واظهار شعائر الاسلام كما ذكره على خان ابن خلف بن عبد المطلب فيما كتبه إلى الشيخ على صاحب «الدر المنثور» (ذ 8 قم 269) وسننقل عنه فى الحادية عشرة فى احوال خلف المشعشعى. قال كان صلاحه فى اخفاء مذهبه لأنه كبير العشيرة كما كان إخفاء أبى طالب اسلامه لصالح رسول الله (ص) وبالجملة لم يكن صاحب الترجمة من العلماء وداخلا فى موضوع الكتاب وإنما ذكرته لاستظهار تشيعه الحق وإنه لم يكن سبيله كسبيل والده محمد وأخيه على. وأما ما ذكره فى «آثار الشيعة» من أن «عمدة الطالب» (ذ 15: 336) كتب باسم صاحب الترجمة فخطاء لأن «العمدة» ألف سنة (802) وبين التأليف إلى وفات السيد محسن ازيد من مأه عام. واما والده محمد بن فلاح(@)(@)PageV07P201(@) فقد كان فى اول أمره تلميذ جمال الدين ابى العباس احمد بن فهد (م 841) فاطلع على بعض الأسرار من رسالة شيخه المذكور فى «تسخير القلوب» فادعى أنه المهدى المنتظر وأنه سيظهر، فبلغ الخبر إلى شيخه فكتب ابن فهد إلى الأمير منصور بن قبان بن ادريس البوشنجى فى أخذه وقتله، فأخذه الأمير وأراد قتله فحلف السيد له بأنى سنى صوفى والشيعة يعاندونى لذلك وصدقه الأمير وخلصه. فذهب السيد إلى كسيد واجتمع معه خلق من المعدان أولهم بنى سلامة إلى أوائل سنة 844 فارتحل إلى دوب ثم بعد أيام إلى الجزائر ثم إلى الحويزة وصار ذا شوكة وسار إلى 
ms1146	 البصرة وابنه السلطان على بن محمد ذهب الى واسط وحاصرها وفى 857 توجه السلطان على بعساكره إلى المشهد الغروى وفى 860 توجه إلى نواحى بغداد ثم توجه إلى محاصرة بهبهان فاصابه سهم من القلعة فقتل وتوجه السيد محمد إلى الواسط وقتل من بها من الجند فلم ينج منهم أحد وذلك فى آخر 861 وتوفى السيد محمد يوم الأربعاء 8- شعبان 866 وقد عمل الشبر بن (1) محمد بن ثنوان رسالة فى نسب عليخان بن خلف المشعشعى (ذ 4 قم 256 و817 ذ 24 قم 700 و704) فسرد نسب الشبر المؤلف الى المشعشعيين، ثم نسب المشعشعيين الى الامام موسى الكاظم (ع) .(@)(@)(@@)(@@)(@@) $ المحسنى:(@)(@)(@@) جعفر النسابة.(@)(@)PageV07P202(@)(@)(@@)(@@)(@@) $ محفوظ:(@)(@)(@@) عبد الله-.(@)(@)(@@)(@@)(@@) $ المحقق الثانى:(@)(@)(@@) على الكركى.(@)(@)(@@)(@@)(@@) $ محمد بن ابراهيم:(@)(@)(@@) الذى شرح له تقى الدين ابو الخير محمد بن محمد الفارسى كتاب الملا على القوشچى فى الهيئة المعروف ب «فارسى هيئت» (ذ 16: 94) وصفه فى اوله بقوله [شمس فلك الفضل والافضال ونجم سماد الكرامة والكمال-إلى قوله-زين الشرع المبين محمد بن الخلق العظيم وهادى الخلائق إلى الدين القويم، ابراهيم... ]ونسخة الشرح موجودة فى مكتبة (الخوانسارى) .(@)(@)(@@)(@@)(@@) $ محمد الاحسائى:(@)(@)(@@) ابن الحسن بن على الاوالى الاصل، ولد باحساء وكتب لنفسه «الدروس» للشهيد عن نسخة ولد المصنف رضى الدين ابو طالب محمد بن محمد بن مكى الذى كتب على ظهر نسخته فائدة فى بيان ما اصطلحه والده فى «الدروس» من التعبير فيه عن اسماء العلماء. وفرغ صاحب الترجمة منه عصر الخميس آخر رمضان 962 وقد قابلها وصححها وكتب عليها البلاغات بخطه وفى آخر النسخة اجازة الحسين آل عصفور والميرزا مهدى بن ابو القاسم الموسوى الشهرستانى كتباها بخطهما لمحمد بن اسماعيل بن ناصر بن عبد السلام الجد حفصى فى 1210 ويوجد بخط صاحب الترجمة المجلد الثالث من «المسالك» فيه؛ الوقوف، الهبات، السبق والرماية، الوصايا، إلى اواخر النكاح. كتبه عن نسخة خط تلميذ الشهيد محمود بن محمد اللاهيجى المؤرخة 966، بتفصيل نذكره فى ترجمته. وعبر فيه عن نفسه[محمد بن الحسن بن على الاحسائى مولدا والاوالى الغروانى أصلا والعاملى 
ms1147	 نسبا وصهرا والرميلة منشا... ]وهذا المجلد من «المسالك» بخط صاحب الترجمة رأيته بمكتبة الميرزا مجد الدين بن صدر الافاضل النصيرى بطهران.(@)(@)(@@)(@@)(@@) $ محمد الاردبيلى:(@)(@)(@@) ابو الصلاح تقى الدين بن المولى المقدس الأردبيلى احمد بن محمد(@)(@)PageV07P203(@) (م 993) ألف والده باسمه «حاشية الشرح الجديد للتجريد» وفرغ منها (13-ع 1-986) (-ذ 6 قم 612) .(@)(@)(@@)(@@)(@@) $ محمد الاسترآبادى:(@)(@)(@@) محمد الركابى.(@)(@)(@@)(@@)(@@) $ محمد الاسترآبادى:(@)(@)(@@) جمال الدين الذى كان صدرا مع المير قوام الدين حسن الاصفهانى فى 930 ثم استقل المير قوام الدين بالصدارة. حكى ترجمتهما فى «الرياض» عن «التحفة» لسام ميرزا ابن الشاه اسماعيل. ولا يوجد فى المطبوع من «التحفة» ولعله اراد ما جاء فى «عالمآرا ص 144 و153» ولكن اسمه هناك جمال الدين بدون «محمد» .(@)(@)(@@)(@@)(@@) $ محمد الاسترآبادى:(@)(@)(@@) ابن الحسين المعلم المعاصر لمعين الدين نصر الله الآتى ذكره.(@)(@)(@@) كتب بخطه عدة ابيات على نسخة «الشرايع» التى كتبها معين الدين المذكور كما كتب معاصره الآخر محمد بن ناصر الدين النجفى أيضا عدة أبيات كما يأتى والأبيات التى بخط صاحب الترجمة هذه:(@)(@)(@@) يعيب الناس كلهم زمانا %~% وما لزماننا عيب سوانا(@)(@)(@@) نعيب زماننا والعيب فينا %~% ولو نطق الزمان لنا هجانا(@)(@)(@@) فان الذئب يترك لحم ذئب %~% ويأكل بعضنا بعضا عيانا(@)(@)(@@) وهذه الابيات من القصيدة الطويلة المنسوبة إلى على بن موسى الرضا (ع) وقد ادرجها صاحب «جواهر الادب» فيه وهو مطبوع.(@)(@)(@@)(@@)(@@) $ محمد الاسترآبادى:(@)(@)(@@) ملا شمس الدين معاصر المير صدر الدين الدشتكى (م 903) والمولى جلال الدين الدوانى (م 908) قال القاضى فى «المجالس» فى ترجمة السلطان محسن(@)(@)(@@)(@@)(@@) $ المشعشعى:(@)(@)(@@) ان صاحب الترجمة كتب «حاشية الشرح الجديد» للقوشچى (ذ 6 قم 622) باسم السلطان محسن وفيه اعتراضات على «الحاشية القديمة (ذ 6: 67) للمولى الدوانى الذى(@)(@)PageV07P204(@) كتبه باسم السلطان يعقوب بايندرى، كما كتب المير الدشتكى «الحاشية الجديدة» باسم السلطان ايلدرم البايزيدى.(@)(@)(@@)(@@)(@@) $ محمد الاسترآبادى:(@)(@)(@@) مير شمس الدين الحسينى الداماد، لأنه كان صهر المحقق الكركى على بنتيه. رزق المير محمد باقر الداماد من بنته الثانية التى تزوجها بعد الأولى بأمر النبى (ص) للمحقق فى المنام، المحكى تفصيله عن «رياض الشعراء» لعلى قلى خان 
ms1148	 الواله المعروف ب بشش انگشتى الداغستانى كما حكاه فى «الرياض» .(@)(@)(@@)(@@)(@@) $ محمد الاسترآبادى:(@)(@)(@@) شمس الدين بن الحسن المجاز من ابراهيم القطيفى ابن سليمان فى النجف فى (21 محرم 920) بالاجازة الطويلة ذات الخمس فوائد المسطورة فى «البحار ج 108 ص 85-123» (-ذ 1 قم 628) أثنى عليه كثيرا فمما قال: [انه محقق العلوم العقلية والآداب، عارف المحكمات والمتشابهات من الكتاب].(@)(@)(@@)(@@)(@@) $ محمد الاسترآبادى:(@)(@)(@@) مير صفى الدين بن جمال الدين الحسينى، تلميذ المحقق الكركى وشارح «التهذيب» للعلامة واستاد المير ابو الولى بن شاه محمود الاينجو الحسينى الشيرازى الذى يروى عنه الحسين بن حيدر بن قمر الكركى، كما ذكره فى مشيخته (ذ 1 قم 600 والبحار ج 109 ص 161-176) .(@)(@)(@@)(@@)(@@) $ محمد الاسترآبادى:(@)(@)(@@) ابن ابى طالب الموسوى الحسينى من تلاميذ المحقق الكركى وشارح «الجعفرية» فى حياته وسمى الشرح ب «المطالب المظفرية» لانه كتبه باسم الامير سيف الدين مظفر البتكچى الجرجانى معبرا عن استاده الكركى بقوله[... من تأليفات المفضل شيخنا وسيدنا شيخ الاسلام وخاتم المجتهدين-إلى قوله فى دعائه-لازال كاسمه عليا عاليا متعاليا على كافة العالمين... ].(@)(@)(@@)(@@)(@@) $ محمد الاسترآبادى:(@)(@)(@@) ابن ابى طالب، كتب بخطه اجازة لقطب الدين احمد بن(@)(@)PageV07P205(@) شمس الدين محمد التادوانى فى غرة جمادى الثانية 922 على ظهر «جواهر الكلمات» لعطاء الله الرستمدارى. ولصاحب الترجمة كتاب «نجات العباد فى معرفة المبدء والمعاد» وشرحه المزجى عليه. رأيت خط الحسين بن حيدر الكركى على ظهر نسخة من «نجات العباد» المذكور، وصورته[... تأليف المولى المحقق المدقق الأفضل الأكمل خلاصة المتأخرين وزينة المتبحرين مولانا محمد بن ابى طالب الاسترآبادى تغمده الله بغفرانه. كتب ذلك عليه صاحبه ومستكتبه أفقر عباد الله الغنى المغنى الحسين بن حيدر الحسينى الكركى العاملى، عامله الله بلطفه الخفى... ]وللمترجم له اجازة من المحقق الكركى تاريخها (17-ع 1-925) وهى مفصلة أدرجها حبيب الله بن على مدد فى كتابه «لباب الالقاب-ص 38» وعنوانه ابو عبد الله محمد بن ابى طالب الاسترآبادى. وله «ترجمة نفحات اللاهوت» لاستاده بالفارسية (ذ 4 قم 496) وقد تسمى «اللعنية» ونسخها موجودة فى مكتبة (امير المؤمنين «ع» العامة» 
ms1149	 للأمينى التبريزى.(@)(@)(@@)(@@)(@@) $ محمد الاسترآبادى:(@)(@)(@@) ابن عبد الرحيم بن داود بن محمد المعاصر للمحقق الكركى وتلميذه. وقد كتب بخطه مجلدا من حاشية الكركى على «القواعد» للحلى (ذ 6 قم 928) فى الحرم المقدس المرتضوى وفرغ منه أواسط شوال 930 وقد كتبها عن نسخة خط المصنف نسخة الاصل، ثم قابلها مع نسخة الأصل التى عليها حواش منه مد ظله كثيرا أيضا وفرغ منه فى ج 2-931 والنسخة فى كتب السيد محسن القزوينى.(@)(@)(@@)(@@)(@@) $ محمد الاسترآبادى:(@)(@)(@@) كمال الدين من علماء عصر الشاه طهماسب (م 984) [وكان متولى الخزانة (الرضوية) ومرجع الأمور الحسبية ويجرى على يده وظائف جميع الطبقات من الخدام والمدرسين والعلماء وغيرهم]انتهى ملخص ما فى «التكملة» لسيدنا الحسن صدر الدين.(@)(@)(@@)(@@)(@@) $ محمد الاسترآبادى:(@)(@)(@@) ابن ميران. قابل كتاب «التهذيب» وصححه وقرأه على الصدر(@)(@)PageV07P206(@) علاء الملك المرعشى (-ص 142) سنة 986 فى جمع آخرين (1) قال علاء الملك: ان صاحب الترجمة كان اكثرهم قراءة. وقد نقل صورة خط علاء الملك، الملا سلطان حسين بن محمد الندوشنى (2) استاد سلطان العلماء، فى آخر نسخة «التهذيب» التى قابلها مع نسخة علاء الملك فى 1026.(@)(@)(@@)(@@)(@@) $ محمد الاسترآبادى:(@)(@)(@@) نصير الدين بن عبد الكريم الانصارى: مؤلف كتاب «محاسن الآداب» فى ترجمة مكارم الأخلاق الذى ألفه باسم الشاه طهماسب الصفوى وفرغ منه (963) والنسخة فى مكتبة امير المؤمنين (ع) العامة للأمينى بالنجف كتابتها 1062 وفى (المجلس 2044) -ذ 20 قم 2220.(@)(@)(@@)(@@)(@@) $ محمد الاسترآبادى:(@)(@)(@@) ابن نظام الدين. فاضل فقيه مدقق، له شرح «الألفية» للشهيد وغير ذلك. كذا ترجمه فى «الأمل» وكأنه ما اطلع على ترجمة المؤلف الا بعد ما راى شرحه على الألفية فى (الرضوية) ولا يعلم من النسخة عصر المؤلف. نعم المقطوع أنه ما كان مقاربا لعصر الشيخ الحر لأن تاريخ وقفية النسخة (1037) فهو إما أهل هذه المئة أو ما قبلها. ومر فى «الضياء اللامع-ص 116-117» محمد بن نظام بن على الاسترابادى الذى كتب بخطه على أمالى الصدوق فى سنة 813.(@)(@)(@@)(@@)(@@) $ محمد الاصفهانى: سلطان محمد الاصفانى(@)(@)(@@) -،(@)(@)(@@)(@@)(@@) $ محمد الاصفهانى: ملك محمد(@)(@)(@@) .(@)(@)(@@)(@@)(@@) $ محمد الاصفهانى:(@)(@)(@@) محمد بن حيدر بن سبلى الرلاس (كذا بغير نقطة) المشتهر 
ms1150	 بميركى كتب الخراجية للمحقق الكركى وهو «قاطعة اللجاج فى تحقيق حل الخراج» (ذ 17: 7) الذى فرغ مؤلفه نهار الاثنين (11 ع 1-916) وفرغ من الكتابة (928) وكتب فى آخره أنه قرأ(@)(@)PageV07P207(@) عليه الرسالة أعز ولده أبو القاسم وكتب أبو القاسم هذا تملكه على ظهر النسخة، وإمضائه [ابو القاسم بن محمد بن حيدر الاصفهانى]والنسخة عند الميرزا محمد على (الاردوبادى) بالنجف.(@)(@)(@@)(@@)(@@) $ محمد الاصفهانى:(@)(@)(@@) ابن صدر الدين كتب المجلد الخامس عشر من «التذكرة» للحلى (ذ 4 قم 169) وفرغ من نسخه فى منتصف جمادى الثانية 960. رأيته فى موقوفة نوروز على البسطامى بمشهد خراسان، يظهر من آثاره أنه من العلماء.(@)(@)(@@)(@@)(@@) $ المير محمد الاصفهانى:(@)(@)(@@) السيد معز الدين محمد بن تقى الدين محمد الاصفهانى، الصدر فى العشر الخامس من القرن العاشر، للحكومة الصفوية فى العاصمة قزوين. له رسالة فى عدم انفعال الماء القليل (ذ 15 قم 1529) رد عليها بعده القاضى نور الله التسترى الشهيد 1019 برسالة فى اثبات انفعاله (ذ 2 قم 1610) . والمترجم له وزميله نعمة الله الحلى الآتى تلميذان لابراهيم القطيفى المذكور فى (ص 4-5) وله منه اجازة (ذ 1 قم 629) ذكرت فى «الرياض-1: 15-17» وتاريخ الاجازة 928 فى النجف. وصف المترجم له فى «الرياض» بقوله (1) [السيد الأجل الحسيب الفاضل النقيب المير معز الدين محمد الصدر الاصفهانى]وكان أستاذه القطيفى يعارض المحقق الكركى الذى كان مقربا عند الشاه طهماسب (930-984) خاصة فى مسألتى الجمعة والخراج السياسيين فى ذلك العصر فالكركى يوجب الجمعة ويحلل الخراج والقطيفى يحرمهما، ولم يقبل القطيفى جوائز الشاه وهداياه وردها عليه رغم اعتراض الكركى عليه فى ذلك كما فى «الرياض 1: 15-18» حتى بعد ان نصب الشاه تلميذ القطيفى اى نعمة الله الحلى شريكا مع غياث الدين منصور الدشتكى فى الصدارة، فعزل نعمة الله واستقل غياث الدين بالصدارة، لكنه بدوره مال الى فتوى القطيفى فعزل أيضا باشارة من الكركى كما يأتى فى ترجمته ونصب مكانه معز الدين محمد المترجم له، فبقى ثمان سنين حتى عزل بتحريك الحكيم الكازرونى ونصب مكانه المير اسد الله المرعشى الشوشترى المذكور فى 
ms1151	 ص 20 كما فصله(@)(@)PageV07P208(@)(@)(@@) اسكندر فى «عالمآراى عباسى-ص 144» .(@)(@)(@@)(@@)(@@) $ محمد الانصارى:(@)(@)(@@) نصير الدين ابن عبد الكريم نزيل هرات ومعاصر شاه طهماسب الصفوى (930-984) . ترجم «عدة الداعى» لابن فهد فى بلدة هراة باشارة الامير قزاق خان بن محمد خان وفرغ منه (12 شوال 967) . رأيته عند (حفيد اليزدى) .(@)(@)(@@)(@@)(@@) $ محمد الأنصارى:(@)(@)(@@) ابن نظام الدين محمود، كان بمشهد خراسان فى (978) مشتغلا بمدرسة «الأفضلية» فكتب هناك بخطه «كنز العرفان» للفاضل المقداد، فرغ من الكتابة يوم الجمعة 21 رمضان من تلك السنة والنسخة عند (سلطان المتكلمين بطهران) .(@)(@)(@@)(@@)(@@) $ محمد بن بهرام:(@)(@)(@@) كما فى نسخة «تلخيص المرام» له فى (الرضوية) مر فى حرف الباء (ص 29) بعنوان محمد بهرام كما فى «الرياض-1: 365» .(@)(@)(@@)(@@)(@@) $ محمد البيونى:(@)(@)(@@) ابن على. رأيت بخطه كتاب «دفع المناوات» للحسين الكركى كتبه فى 962 ولعله من تلاميذ المصنف، كتبه وعارضه عليه. وقد فرغ المؤلف 959 والكتابة بعده بثلاث سنين. والنسخة عند (جعفر بحر العلوم) فى النجف.(@)(@)(@@)(@@)(@@) $ محمد التبريزى:(@)(@)(@@) هو الخواجه جلال الدين محمد التبريزى كما فى «الرياض-4:(@)(@)(@@) 403 وجهانگشاى خاقان-ص 600-604» الكججى كما فى «عالمآراى عباسى-ص 159» ولعله منسوب الى الشيخ الكججانى بتبريز المذكور فى «رجال حبيب السير-ص 82» . استوزره الشاه اسماعيل الصفوى فى 929 بعد قتل ميرزا شاه حسين الوزير ولم يطل وزارته سنة كاملة حيث مات الشاه اسماعيل وجلس الشاه طهماسب (930-984) وغضب سلطان روملو على الوزير هذا وأحرقه ملفوفا فى البوريا فنسب اليه هذا البيت:(@)(@)(@@) (القرن العاشر: 14)(@)(@)PageV07P209(@) گرفتم خانه در كوى بلا، در من گرفت آتش (@@) كسى كو خانه در كوى بلا گيرد چنين گيرد(@)(@)(@@)(@@)(@@) $ محمد التبريزى:(@)(@)(@@) حاج ملا شرف الدين. له الحاشية على الحاشية الشريفية على شرح الشمسية القطبية (ذ 6 قم 384) فى مبحث تمام المشترك، موجودة فى (الرضوية) كتابتها 955 وعليها حواشى الشاه فتح الله الشيرازى. قال الأمينى التبريزى: ويحتمل قويا كون المترجم له هو المولى محمد بن عبد الاول التبريزى الحنفى (م 963) فعده من الأصحاب فى غير محله.(@)(@)(@@)(@@)(@@) $ محمد تركه:(@)(@)(@@) خواجه افضل الدين (م 991) كما فى «عالمآرا: 115» تولى قضا العسكر فى عصر الشاه طهماسب 
ms1152	 الصفوى (930-984) مع علاء الملك المرعشى (-ص 142) كما حكاه فى «الرياض-3: 314» عنه. ثم سافر إلى الهند ورجع إلى مشهد خراسان وصار مدرسا بها. وألف «انموذج العلوم» بعد رجوعه (ذ 2 قم 1621) وذكرنا ديوانه فى (ذ 9 قم 501) بتخلصه «أفضل» . وذكر القزوينى فى «تنميم الأمل» رسالته فى «المعقولات الثانية» (ذ 21 قم 4976) ومقالته فى الاعتراض على شيخه احمد المقدس الاردبيلى بن محمد فى مسألة «الأمر بالشئ نهى عن ضده الخاص» وهى مع مقالات سائر تلاميذه فى رده مثل صاحبى «المعالم» و«المدارك» والمير فيض الله التفرشى كلها موجودة بخط شرف الدين المازندرانى فى مكتبة (الهادى كاشف الغطاء) ورأيت تملكه بخطه على مجموعة سبع وخمسين رسالة كلها بخط الحاج محمود النيريزى فى (989) ومر فى التاسعة (ص 89 و119) محمد بن على بن محمد تركه المجيز لسالك الدين فى (880-870) وصائن الدين على بن محمد بن محمد تركه صاحب كتاب «المفاحص» الذى الفه (823) ومر فى الثامنة (ص 182) جده افضل الدين ابو حامد محمد بن حبيب الله الاصفهانى المعروف بتركه مؤلف كتاب «قواعد التوحيد» الذى شرحه سبطه صائن الدين المذكور. وترجمه سيدنا فى «التكملة» وأرخه كذلك وحكى الفاضل فى «الروضات» عن «سلم السماوات» للكازرونى (-ص 186) أنه ترجم فى كتابه المذكور استاده الحكيم الفاضل افضل الدين محمد بن حبيب الله(@)(@)PageV07P210(@) المعروف بتركه وذكر أنه كان اشتهار علمه ومرجعيته من حدود 970 إلى 990 فى بلاد عراق العجم وديار خراسان. ولعله هو صاحب الترجمة وكان والده ايضا حبيب الله. وهو متأخر بكثير عن افضل الدين ابى حامد محمد بن حبيب الله الاصفهانى المعروف بتركه الذى الف سبطه صائن «المفاحص» فى سنة 823.(@)(@)(@@)(@@)(@@) $ محمد بن تركى:(@)(@)(@@) شمس الدين، تلميذ ابراهيم بن سليمان القطيفى النجفى بالاجازة الكبيرة الصادرة منه له فى النجف سنة (915) (ذ 1 قم 627) فيها بعد اوصاف كثيرة [الشيخ الفاضل العالم الورع النقى]وفى آخر الاجازة بعد تمامها كتب إجازة مختصرة لولده منصور (ذ 1 قم 630) واصفا له به[الشيخ الأجل الركن الاظل-إلى قوله بعد عدة اوصاف-الفاضل العالم العامل الشيخ 
ms1153	 منصور بن الشيخ الاجل شمس الدين محمد بن تركى ... ]وصاحب الترجمة مقدم على الخواجه افضل الدين محمد تركه المعاصر للشاه طهماسب.(@)(@)(@@)(@@)(@@) $ محمد التسترى:(@)(@)(@@) مير شمس الدين بن اسد الله صاحب رسالة «اثبات وجود صاحب الزمان (ع) » الذى ذكره القاضى فى «المجالس» وقال[انه كتبه بأمر المغفور له السلطان صاحبقران ويجب على المؤمنين المحافظة عليه]ومراده الشاه طهماسب الأول (930-984) - (ذ 1 قم 533) .(@)(@)(@@)(@@)(@@) $ محمد التولانى:(@)(@)(@@) جمال الدين بن على البصرى نزيل شيراز، قرأ عليه فيها فيمابين (962 و964) الحسن بن على بن شدقم المدنى علوم العربية والأدبيات، كما ذكره ضامن بن شدقم فى «تحفه الازهار» وقال فى وصفه[العالم العلامة المحقق الفهامة جمال الدين محمد... ] أقول: الظاهر أن والده على التولانى مؤلف «التولانية» المذكور فى التاسعة ص 90 و(ذ 4:(@)(@)(@@) 501) هو التولينى الذى ترجمه صاحب «الرياض 3: 380» .(@)(@)(@@)(@@)(@@) $ محمد الثمارى:(@)(@)(@@) ابن جويبر بن محمد الحسينى قرأ عليه زين الدين على بن بدر الدين(@)(@)PageV07P211(@) حسن بن على النقيب الحمزى الحسينى المدنى المولود (950) . ذكرناه فى الحاديعشر.(@)(@)(@@)(@@)(@@) $ محمد الجامعى:(@)(@)(@@) هو ابن أحمد بن على بن أحمد بن أبى جامع العاملى من علماء عصره، كتب بخطه «التنقيح الرايع» للفاضل المقداد السيورى وفرغ من نصفه الأول (908) ومن الباقى قرب الزوال يوم الجمعة ثانى ذى الحجة الحرام (909) والنسخة عند (الهادى كاشف الغطاء) ولعله والد أحمد بن صالح الشهير بابن أبى جامع (-ص 10) المجاز بهذا العنوان عن المحقق الكركى سنة 928 وأن صالحا ذكر له بعنوان اللقب بل المحتمل أن كلمة صالح كانت فى أصل الاجازة معرفة باللام وأسقط الناسخ اللام بزعم الزيادة.(@)(@)(@@) ويؤيده أن أحمد المجاز عن الكركى هو والد على المجاز عن الشهيد الثانى سنة (960) كما ذكره حفيده على تلميذ الشهيد وهو على بن رضى الدين بن على تلميذ الشهيد. قال فى رسالته فى آل ابى جامع (ذ 4 قم 228) التى أرسلها إلى الحر أن احمد المجاز عن الكركى هو والد على تلميذ الشهيد. وقد ترجم صاحب «الرياض-3: 349» على هذا بعنوان على بن احمد بن محمد بن أبى جامع، فيظهر منه ان 
ms1154	 احمد المجاز من الكركى كان ابن محمد صاحب هذه الترجمة وأن صالحا لقب له أوصفة وأن على بن احمد المجاز من الشهيد هو حفيد صاحب الترجمة.(@)(@)(@@) محمد الجبيلى: ابن مكى بن عيسى بن حسن بن عيسى العاملى الجبيلى، كذا ترجم فى إجازات «البحار ج 109 ص 162» ترجمه ولده نجيب الدين على بن محمد فى اجازته فى (1010) للحسين بن حيدر الكركى (ذ 1 قم 1161) وذكر فيها أنه يروى عن والده صاحب الترجمة وأنه يروى والده عن جماعة وهم عبد الحميد الكركى تلميذ الشهيد الثانى المجاز منه ووالده مكى بن عيسى المجاز من ابراهيم بن على بن عبد العالى الميسى وشيخه وأستاده وأبو زوجته محيى الدين أحمد بن تاج الدين الميسى وهؤلاء أعنى الشهيد الثانى وابراهيم ومحيى الدين كلهم يروون عن على بن عبد العالى الميسى. وبخطه تملكه «كفاية الأثر» بالبيع الشرعى سابع ربيع الاول (976) ثم وقفت النسخة والدته وهى الحاجة بنت الحاج أحمد بن محارب، لصاحب الترجمة وأولاده، والوقفية أيضا بخط صاحب الترجمة، صورتها مسطورة فى «معادن الجواهر» . غ(@)(@)PageV07P212(@)(@)(@@)(@@)(@@) $ محمد الجرجانى:(@)(@)(@@) ابن احمد مؤلف كتاب «المنازل والمراحل للأجسام وللأرواح» كل منهما بالعدد المقدس «تسعة عشر» وهو عدد حروف البسملة. توجد نسخة كتبت فى سنة 975 فى مكتبة (امير المؤمنين العامة) للأمينى بالنجف (ذ 22 قم 6911) .(@)(@)(@@)(@@)(@@) $ محمد الجزائرى:(@)(@)(@@) ابن الحارث كان فاضلا عالما شاعرا صدوقا محققا من تلامذة على بن عبد العالى العاملى الكركى. كذا ترجم فى «أمل الآمل» أقول: هو محمد بن الحرث النصورى الجزائرى الذى يروى عنه المير حسين بن الحسن الموسوى العاملى الكركى الذى توفى بقزوين (1001) كما ذكره الحسين بن حيدر الكركى فى بعض اجازاته المذكورة فى «الروضات» . ورأيت مجموعة من رسائله مكتوبة على ظهرها[أنها رسائل الشيخ العالم الفاضل المحقق الشيخ محمد بن الحارث المنصورى الجزائرى]أولها نبذة فى مسائل الاجتهاد ثم نبذة فى تفسير[لو كان فيهما آلهة الا لله]ثم نبذة من بعض الدلائل على شرف المسائل أى الكلام، ولكل منها خطبة وديباجة مستقلة فيها ذكر اسم المؤلف. والنسخة عند 
ms1155	 (حفيد اليزدى) وهى بخط نصار بن محمد الحويزى 1023 وقد نظر فى مجموعة فقهية كلامية كتبها محمد بن نعمة الله فى 921 وكتب عليها اشعارا له منها قوله:(@)(@)(@@) لا زال يعلو قدره دائما %~% على الورى صاحب هذا الكتاب(@)(@)(@@) ما غرد القمرى فى أبكنه %~% وأضحك الارض بكاء السحاب(@)(@)(@@) وأيضا:(@)(@)(@@) لصاحبه السعادة والسلامة %~% وطول العمر ما ناحت حمامة(@)(@)(@@) وعز دائم لا ذل فيه %~% وإقبال إلى يوم القيامة(@)(@)(@@)(@@)(@@) $ محمد الجزينى:(@)(@)(@@) ابن محمد بن مساعد بن عياش العاملى قال صاحب «الأمل» [كان فاضلا قاريا صالحا، له كتاب «مقتل الحسين» وكتاب «الأدعية المأثورة» من المعاصرين للشهيد الثانى وعنه فى «الرياض 5: 176» .(@)(@)(@@)(@@)(@@) $ محمد بن أبى جمهور الاحسائى:(@)(@)(@@) هو العارف المحدث محمد بن زين الدين بن أبى(@)(@)PageV07P213(@) جمهور الاحسائى، صاحب «عوالى اللئالى» (ذ 15: 358 وذ 16: 71) وعرفنا هناك بنسخها الثمينة. ولها مقدمة فى عشرة فصول ذكر فى الأول منها طرقه السبعة التى ذكرناها فى «الضياء اللامع ص 1» فلا نكررها هنا. وله «المجلى» فرغ منه (895) وجمع فيها الكلام والحكمة والتصوف والشريعة والطريقة (ذ 20 قم 1726) فابن ابى جمهورى يتبع مدرسة السيد حيدر الآملى المذكور فى «الحقايق الراهنة 71-66» فى القول بأن التشيع هو ظاهر التصوف وان التصوف هو باطن التشيع وكلما ابتعد الشيعى عن التصوف فقد اقترب من التسنن بل حاول ابن أبى جمهو فى «المجلى» اثبات أن الاشاعرة أقرب إلى الاعتزال منهم إلى جمود التسنن السلفى الذى مات فى عصر مأمون ولم يتمكن المتوكل من إحيائه. وله «الدرر اللئالى العمادية» (ذ 8 قم 496) فرغ منه (901) فهو ممن ادرك العاشرة جزما.(@)(@)(@@) وله «كاشفة الحال» (ذ 17: 241-240) . يروى صاحب الترجمة عن على بن هلال الجزائرى استاد المحقق الكركى (م 940) لكنه توفى قبل الكركى بكثير، فكان فى مكة عام 877. وقد أجاز صاحب الترجمة لمحمد بن صالح الغروى الحلى سنة (898) (ذ 1 قم 1280) . وممن يروى عنه، محسن الرضوى (-ص 200) وله «جمع الجمع» (ذ 5: 138)(@)(@)(@@)(@@)(@@) $ محمد الجيلانى:(@)(@)(@@) نور الدين بن صدر الدين. كتب بخطه شرح بعض المتون وفرغ منه يوم السبت خامس صفر 981 لم 
ms1156	 أعرف المتن لنقص أوله، وآخر الشرح[وآله الطيبين الذين هم قاهروا الكفرة وكاسروا الانصاب]والظاهر انه هو الشارح. والنسخة فى مكتبة (شيخنا الشيرازى بسامراء) .(@)(@)(@@)(@@)(@@) $ محمد الحافظ:(@)(@)(@@) شاه ملا حافظ.(@)(@)(@@)(@@)(@@) $ محمد الحائرى:(@)(@)(@@) الموسوى ابن أبى طالب بن احمد الحسينى. مؤلف كتاب «تسلية المجالس وزينة المجالس» (ذ 4 قم 885) الكتاب الكبير فى المقتل الذى ذكره المجلسى فى اول البحار (ص 21) وقال إنه[للسيد النجيب العالم... ]ونقل عنه فى عاشر البحار (ج 44 ص 310 و354) قول ابن الأشعث: [أتظن أنك بعثتنى الى بقال من بقا قيل الكوفة وجرمقانى من جرامقة الحيرة... ؟]. فهو غير مجد الدين محمد الحسينى(@)(@)PageV07P214(@) مؤلف «زينة المجالس» الآتى فى القرن الحادى عشر، ولعله الاسترآبادى المذكور فى (ص 205) فانه فى آخر المجلس الخامس فى أحوال مسلم بن عقيل أظهر الشكوى من اهل زمانه وغدرهم به كما غدر أهل الكوفة بمسلم. قال ولما نجاه الله منهم هاجر إلى كربلاء واتخذها موطنا ومستقرا... ]فيظهر انه لم يكن حائرى الأصل.(@)(@)(@@)(@@)(@@) $ محمد الحسينى:(@)(@)(@@) أفصح الدين ابن حبيب الله بن احمد، شارح «نهج البلاغة» وقد فرغ من شرحه (881) ذكرته فى الضياء ص 15 ولعله بقى إلى هذه المئة.(@)(@)(@@)(@@)(@@) $ محمد الحسينى:(@)(@)(@@) ابن على بن الحسن. كتب بخطه نسخة كتاب فى «اعتقادات الامامية فى الاصول والفروع» فى (19 شوال 936) وقد سمى المير محمد الچهارسوئى الاصفهانى م 1293 هذا الكتاب «معتقد الامامية» فذكرناه فى (ذ 21 قم 4656) .(@)(@)(@@)(@@)(@@) $ محمد الحسينى:(@)(@)(@@) شمس الدين بن حليت وصفه تلميذه محمد بن صالح الغرى-كذا بخطه ولعله الغروى الحلى كما فى البحار 108: 18 فيما كتبه من الاجازة لربيع بن جمعة الغرى (كذا) العبادى الحويزى سنة 897 (ذ 1 قم 1273) بقوله[السيد المفضال المنقذ من الحيرة والضلال السيد شمس الدين محمد بن السيد حليت الحسينى]وذكر المولى محمد ابن صالح فى الاجازة المذكورة أن شيخه وأستاده الآخر محمد بن على بن أبى جمهور الأحسائى.(@)(@)(@@) وقدم ذكر صاحب الترجمة عليه ويظهر منه حياته. وبالجملة هو معاصر لابن أبى جمهور والاجازة المذكورة على نسخة «الارشاد» التى كتبها ربيع المجاز عند (التقوى بطهران) 
ms1157	 .(@)(@)(@@)(@@)(@@) $ محمد الحسينى:(@)(@)(@@) ابن سعد الله. كتب بخطه النستعليق «توضيح الارشاد» وهو شرح المير جان محمد التبريزى على «ارشاد الهادى» فى النحو. تأليف سعد التفتازانى وفرغ من كتابة النسخة 929.(@)(@)(@@)(@@)(@@) $ محمد الحسينى:(@)(@)(@@) ابن عزيز الله. رأيت بخطه نسخة «مكارم الأخلاق» كتبها وفرغ من الكتابة ليلة الجمعة (14 ج 2-974) ويظهر من خصوصيات النسخة أنه من(@)(@)PageV07P215(@) العلماء الفضلاء. والنسخة فى كتب (الخوانسارى) .(@)(@)(@@)(@@)(@@) $ محمد الحسينى الكاشانى:(@)(@)(@@) تقى الدين الكاشانى.(@)(@)(@@)(@@)(@@) $ محمد الحسينى:(@)(@)(@@) محمد العميدى.(@)(@)(@@)(@@)(@@) $ محمد الحموى:(@)(@)(@@) فاضل الدين.(@)(@)(@@)(@@)(@@) $ محمد بن خاتون:(@)(@)(@@) هو شمس الدين محمد بن على بن محمد بن خاتون العاملى جد نعمة الله بن احمد بن محمد الآتى ذكره. سرد نسبه كذلك فى آخر اجازته للكركى (ذ 1 قم 1289) فى 11 ذى الحجة 900 ووصفه حفيده المذكور فى اجازته للمولى عبد الله التسترى سنة 988 (ذ 1 قم 1361) بقوله[الجد الأسد الأكمل المحقق المدقق شمس الدين محمد... ]وقال إنه يروى عنه المحقق الكركى وولده ابو العباس أحمد بن محمد بن محمد وقال ولد الشيخ نعمة الله المذكور وهو شهاب الدين أحمد بن نعمة الله أيضا فى إجازته (ذ 1 قم 684) لعبد الله فى التاريخ المذكور: أن جده شمس الدين هذا يروى عن جمال الدين احمد ابن الحاج على العيناثى عن جعفر بن حسام عن حسن بن ايوب عن الشهيد. أقول: واجازة صاحب الترجمة للكركى (ذ 1 قم 1289) تاريخها تسعماة-11 ذى الحجة أدرج فيها اجازة جمال الدين احمد العيناثى لصاحب الترجمة كما أن العيناثى أدرج فى اجازته إجازتى العلامة الحلى (ذ 1 قم 910) وفخر المحققين (ذ 1 قم 1243) لمهنا بن سنان وكلها فى «إجازات البحار» ج 107 ص 143-151 وولد صاحب الترجمة هو ابو العباس احمد بن محمد الذى كتب المحقق الكركى فى 931 اجازة له ولولديه (ذ 1 قم 1114) نعمة الله على وزين الدين جعفر. ويروى عن ابى العباس احمد، الشهيد الثانى وكذا يروى عنه حفيده شهاب الدين احمد بن نعمة الله على بن ابى العباس، كما صرح به الحفيد فى اجازته (ذ 1 
ms1158	 قم 684) لعبد الله التسترى فى 988.(@)(@)(@@) ولشهاب الدين احمد حفيد صاحب الترجمة ولدان عالمان محمد المجيز للميرزا ابراهيم الهمدانى سنة 1008 (ذ 1 قم 1210) وسديد الدين على بن احمد الذى هو والد شمس الدين(@)(@)PageV07P216(@) محمد الخاتونى تلميذ البهائى ومترجم أربعينه سنة 1027 وذكرتهما فى الحادية عشرة.(@)(@)(@@)(@@)(@@) $ محمد الخفرى:(@)(@)(@@) شمس الدين ابن احمد معاصر المحقق الكركى ومعتمده فى كاشان.(@)(@)(@@) تلمذ عليه المولى فيض الله قاضى عسكر الشاه طهماسب سنتين بكاشان كما ذكره سام ميرزا فى «التحفة-ص 49» وتوفى سنة 957 وحكى عن ظهر بعض تصانيفه أنه توفى يوم الاحد 28 صفر 942. له «التكملة» فى شرح تذكرة الهيئة النصيرية (ذ 4: 409 و6: 47 و13:(@)(@)(@@) 144 و23: 9) فرغ منه 932 و«الحاشية على شرح التجريد (ذ 6: 64 و116) و«اثبات الواجب» وفيه بيان صعوبة ادراك ما فى ذات امير المؤمنين (ع) ورسالة فى تحقيق الهيولا والمحاكمة بين مدرستى الدشتكى والدوانى (ذ 20: 134) . ومر ولده قوام الدين حسين فى ص 64 ويظهر من تصانيفه انه كان تلميذ المير صدر الدين والد غياث الدين منصور الدشتكى. وترجمه القزوينى فى «تتميم الأمل» بعنوان احمد بن محمد الخفرى. وفصل ترجمته فى «الروضات-ص 674» بعنوان شمس الدين محمد وكذلك فى «مجالس المؤمنين» .(@)(@)(@@)(@@)(@@) $ محمد خواجكى شيخ:(@)(@)(@@) ابن احمد الشيرازى نزيل كولكن من أعمال دكن الهند.(@)(@)(@@) كان عاميا ثم استبصر كما يظهر من تصانيفه المذكورة فى محالها من الذريعة الموجود بعضها فى (الرضوية) منها «شرح الباب الحاديعشر» ألفه سنة 952 و«شرح الفصول النصيرية» بالفارسية ألفه سنة 953 و«التمهيدات» المنضم إلى الشرح المذكور فى مجلد كما فصله فى فهرس (الرضوية) وشرح على شرح الجامى على الكافية كما فى الفهرست المذكور و«النظامية فى مذهب الامامية» كتبه لنظام شاه الدكنى بعد تشيعه و«مختصر مجمع البيان» والشرح على شرح الجامى الموسوم ب «الفوائد الضيائية» و«بحر المنافع» و«المحجة البيضاء» و«تحفة الفحول» فى شرح معرب الفصول النصيرية بالعربية الموجودة باصفهان (ذ 13 قم 1444) .(@)(@)(@@)(@@)(@@) $ محمد الخيروى:(@)(@)(@@) علاء الدين بن هداية الله الحسنى الحسينى الخيروى من أعمال فارس، تلميذ عز الدين حسين بن عبد 
ms1159	 الصمد الحارثى والد البهائى، قرأ عليه كتاب «النصوص»(@)(@)PageV07P217(@) فى ذى القعدة من 967 (ذ 14 قم 930) وكتب صاحب الترجمة ذلك بخطه بعد القرائة عليه. والنسخة بخط حسين بن على الخيروى من أعمال فارس كتابتها 965.(@)(@)(@@) محمد الدشتكى صدر الدين الثالث: ابو المعالى الشهيد (903-828) ابن غياث الدين منصور الأول بن صدر الدين محمد الثانى بن ابراهيم بن صدر الدين محمد الأول بن إسحاق ابن على بن عربشاه الحسينى الدشتكى الشيرازى جد أبى نصر صدر الدين الرابع الواعظ ووالد «أستاد البشر» و«العقل الحاديعشر» غياث الدين منصور الثانى. ذكر ولده المنصور فى شرحه على «اثبات الواجب» الموسوم ب «كشف الحقايق المحمدية» لوالده الصدر المترجم له أنه ولد يوم الثلثاء ثانى شعبان 828 وقله طايفة التركمان فى يوم الجمعة ثانى عشر رمضان 903 كما حكاه القاضى فى «المجالس» وذكر أنه أخذ العلوم الشرعية عن والده غياث الدين منصور وعن ابن عم والده المير نظام الدين احمد بن إسحاق بن على بن عربشاه. وذكر ساير مشايخه وتصانيفه. وصدر الدين الواعظ حفيد صاحب الترجمة، ذكر فى اجازته الاتى ذكرها ان الصدر الشهيد يروى عن أبيه غياث الدين منصور عن أبيه صدر الدين محمد الثانى عن ابيه ابراهيم وهكذا الآباء عن المعصوم (ع) وكذا ذكر على خان الدشتكى المدنى فى اجازته لمحمد باقر المكى (ذ 1 قم 1087) ، فنسبة صدر الدين الشهيد ألى ابراهيم كما وقعت فى ترجمته، إما من باب النسبة إلى الجد او غفلة عن الواقع. وظهر أن والد الصدر الشهيد ايضا من حملة العلم وقد أخذ عنه ولده الصدر، العلوم الشرعية كما ان سائر آبائه من سلسلة حملة العلم والحديث. ومن تلاميذه الحاج محمود بن محمد النيريزى المجاز منه فى 903 على ظهر «اثبات الواجب» له الذى كتبه الحاج محمود مع عدة من رسائله وفوائده، فى مجموعة نفيسة فيها سبع وخمسون رسالة كلها بخط الحاج محمود من 903 إلى 919 توجد المجموعة عند (التقوى) بطهران وفيها من رسائل صاحب الترجمة «اثبات الواجب» الذى كتب عليه 
ms1160	 الاجازة بخطه (1) . وقد أورد ولده غياث الدين منصور الثانى فى آخر «كشف الحقايق» الذى(@)(@)PageV07P218(@) هو شرح ل «إثبات الواجب» الموسوم ب «الحقايق المحمدية» تأليف والده المير صدر الدين بعض أحواله، ثم أورد عدة أصول فى طى ثمانية فصول وذكر فى كل منها عقايد والده من تجرد النفس والمعاد وغيرها. وفى الفصل الثامن ذكر عقايده الأحلافية وعلومه ومعارفه وتواريخ ولادته ووفاته كما مر، وقال[إن والده أيضا كان عالما متشرعا واعظا ناجحا منصورا مظفرا مستجاب الدعوة ووالدته كانت من بيت الولاية منتسبة الى الشيخ ابراهيم الكريم، وأنه أخذ الحديث وبعض الشرعيات عن ابن عمه نظام الدين احمد، وفنون الأدب والفقه عن علامة عصره ابن عمه مجد الدين حبيب الله وذكر طرقه ومشايخه الى أبى على والخواجه الطوسى. قال[وله اربعة عشر تصنيفا منها حاشية شرح القطبى للشمسية، حاشية شرح المطلع، رسالة فى تحقيق الحروف، رسالة فى الفياض، رسالة فى حل مغالطة لجذر الأصم، تعليقات على تيسير الفقه، شرح كبير على شرح التجريد الجديد، رسالة فارسية فى قوس وقزح رسالة فارسية فى الجواهر، اثبات الواجب الذى سميناه «الحقايق المحمدية» وشرحناه وذكر أنه فى الأوائل كان مولعا بالشطرنج وعاملا به وفى الأخير تركه بتاتا إلى أن استشهد صبح الجمعة 13 شهر الصوم 903]فهناك تشابه بين الصدر الثالث (الكبير) المترجم له والصدر الرابع (الصغير) فى توسع المشرب يظهر مما ذكر فى (ذ 10: 38) .(@)(@)(@@)(@@)(@@) $ محمد الدشتكى صدر الدين الرابع:(@)(@)(@@) هو ابو نصر محمد بن غياث الدين منصور الثانى (م 948) بن صدر الحقيقة محمد الدشتكى صدر الدين الثالث (م 903) بن غياث منصور الأول ابن محمد صدر الدين الثانى ابن ابراهيم بن محمد صدر الدين الأول بن اسحاق ابن على بن عربشاه الحسينى من بيت علم وثروة بشيراز فى القرنين التاسع والعاشر ويعرف(@)(@)PageV07P219(@) المترجم له بصدر الدين الواعظ، الصغير. ومر كيفية توبته فى (ذ 10: 38) . له إجازة مسطورة فى آخر «البحار» (ذ 1 قم 1307) كتبها لعلى بن قاسم الحسينى العريضى اليزدى سنة 973. ورأيت بخطه تملكه ل «تحفهء شاهى» فى الهيئة لقطب 