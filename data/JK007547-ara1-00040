ms21	 حرف كمشترف % إلى الشخاص من التضغان محجوم % PageV01P093 البحر : طويل 1(@)(@@) % أباهل لو أن الأنام تنافروا % % على أيهم شر قديما وألأم % 2(@)(@@) % لفاز لكم سهما لثيم عليهم ، % ولو كانت العجلان فيهم وجرهم % 3(@)(@@) % فأيكما يا ابني دخان ، إذا دعا % % إلى اللؤم داع ، عنكما يتقدم % 4(@)(@@) % فما منكم إلا وفي رهانه % بألأم من يمشي ومن يتكلم % PageV01P094 البحر : وافر تام 1(@)(@@) % ألا كيف البقاء لباهلي % هوى بين الفرزدق والجحيم % 2(@)(@@) % ألست أصم أبكم باهليا % مسيل قرارة الحسب اللئيم % 3(@)(@@) % ألست ، إذا نسبت لباهلي ، % أنا الحامي المضمن كل أمر % 4(@)(@@) % وهل ينجي ابن نخبة حين يعوي ، % تناول ذي السلاح من النجوم % PageV01P095 البحر : وافر تام 1(@)(@@) % حرف النونأرى الزعل بن عروة حين يجري ، % إذا جارى إلى أمد الرهان % 2(@)(@@) % وسوف يرى ابن عروة حين نجري % % إلى الغايات يوم يرى مكاني % % 3(@)(@@) % فمن يك من ذرى عز ومجد ، % فمن آبائك الغرر الرزان % 4(@)(@@) % ورثت فلم تضيع مأثرات ، % وقصر عن بنائك كل بان % 5(@)(@@) % وتنهض حين تنهض للمعالي ، % وتنطق حين تنطق بالبيان % 6(@)(@@) % وتعطي العرف عفوا سائليه ، % وتروي الزاعبية في الطعان % 7(@)(@@) % وتضرب حين تضرب للمعالي ، % مكان الجوز من عقد العنان % PageV01P096 البحر : كامل تام 1(@)(@@) % نام الخلي ، وما أغمض ساعة ، % أرقا ، وهاج الشوق لي أحزانا % % 2(@)(@@) % وإذا ذكرتك يا ابن موسى أسبلت % عيني بدمع دائم الهملان % 3(@)(@@) % ما كنت أبكي الهالكين لفقدهم ، % ولقد بكيت وعز ما أبكاني % % 4(@)(@@) % كسفت له شمس النهار فأصبحت % شمس النهار وكأنها بدخان % 5(@)(@@) % لا حي بعدك يا ابن موسى فيهم % يرجونه لنوائب الحدثان % 6(@)(@@) % كانوا ليالي كنت فيهم أمة ، % يرجى لها زمن من الأزمان % 7(@)(@@) % فالناس بعدك يا ابن موسى أصبحوا % % كفتاة حرب غير ذات سنان % 8(@)(@@) % متشابهين بيوتهم بمجازة % للسيل ، بين سباسب ومتان % 9(@)(@@) % أودى ابن موسى والمكارم والندى % % والعز ، عند تحفظ السلطان % 10(@)(@@) % جمع ابن موسى والمكارم والندى % % في القبر بين سبائب الأكفان % PageV01P097 11(@)(@@) % ما مات فيهم بعد طلحة مثله % للسائلين ، ولا ليوم طعان % 12(@)(@@) % ولئن جيادك يا ابن موسى 
ms22	 أصبحت % ملمس المتون تجول في الأشطان % 13(@)(@@) % لبما تقاد إلى العدو ضوامرا % جردا ، مجنبة مع الركبان % 14(@)(@@) % من كل سابحة وأجرد سابح ، % كالسيد يوم تغيم ودخان % 15(@)(@@) % كان ابن موسى قد بنى ذا هيبة % صعب الذرى متمنع الأركان % 16(@)(@@) % فثوى وغادر فيكم بصنيعة ، % خير البيوت وأحسن البنيان % PageV01P098 البحر : بسيط تام 1(@)(@@) % جاد الديار التي بالرمس خالية ، % أنواء أوطف جرار العثانين % 2(@)(@@) % وما بها ، بعد آثار الحلال بها ، % غير الرماد ، وغير المثل الجون % % 3(@)(@@) % أنا ابن ضبة تنميني معاقلها ، % ومن بني دارم شم العرانين % PageV01P099 البحر : طويل 1(@)(@@) % أبى الحزن أن أسلى بني وسورة % أراها إذا الأيدي تلاقت غضابها % % 2(@)(@@) % وما ابناي إلا مثل من قد أصابه % حبال المنايا مرها واشتعابها % % 3(@)(@@) % ثوى ابناي في بيتي مقام كلاهما % % أخلته عني بطيء ذهابها % % 4(@)(@@) % ومحفورة لا ماء فيها مهيبة % % يغطى بأعواد المنية نابها % % 5(@)(@@) % أناخ إليها ابناي ضيفي مقامة ، % إلى عصبة ما تستعار ثيابها % % 6(@)(@@) % فلم أر حيا قد أتى دون نفسه % من الأرض جولا هوة وترابها % % 7(@)(@@) % من الناس إلأا أن نفسي تعلقت % إلى أجل حتى يجيء مصابها % % 8(@)(@@) % وكانوا هم المال الذي لا أبيعه ، % ودرعي إذا ما الحرب هرت كلابها % % 9(@)(@@) % وكم قاتل للجوع قد كان منهم ، % ومنم حية قد كان سما لعابهم % % 10(@)(@@) % إذا ذكرت أسماؤهم أو دعوا بها % % تكاد حيازيمي تفرى صلابها % % PageV01P100 11(@)(@@) % وكنت بهم كالليث في خيس غابة % أبى ضارعات كان يرجى نشابها % % 12(@)(@@) % وكنت وإشرافي عليهم وما أرى % % لنفسي إذ هم في فؤادي لبابها % % 13(@)(@@) % كراكز أرماح تجزعن بعدما % % أقيمت حوانيها وسنت حرابها % % 14(@)(@@) % إذا ذكرت عيني الذين هم لها % % قذى هيج منها للبكاء انسكابها % % 15(@)(@@) % بني الأرض قد كانوا بني فعزني % % عليهم ، لآجال المنايا كتابها % % 16(@)(@@) % ولولا الذي للأرض ما ذهبت بهم % % ولما تفلل بالسيوف حرابها % % 17(@)(@@) % وكائن أصابت مؤمنا من مصيبة % على الله عقباها ، ومنه ثوابها % % 18(@)(@@) % هجرنا بيوتا ، أن تزار ، وأهلها % % عزيز علينا ، يا نوار ، اجتنابها % % 19(@)(@@) % وداع علي الله لو مت قد رأى 
ms23	 % % بدعوته ما يتقي لو يجابها % % 20(@)(@@) % ومن متمن أن أموت وقد بنت % حياتي له شما عظاما قبابها % % PageV01P101 21(@)(@@) % سيبلغ عني الأخطلين ابن غالب % وأخطل بكر حين عب عبابها % % 22(@)(@@) % % سخاوي تنضى في الفيافي ركابها % % 23(@)(@@) % وخنس تسوق السخل كل عشية % % بداوية غبراء درم حدابها % % 24(@)(@@) % فلا تحسبا أني تضعضع جانبي ، % ولا أن نار الجرب يخئو شهابها % % 25(@)(@@) % بقيت وأبقت من قناتي مصابتي % % عشوزنة زوراء صما كعابها % % 26(@)(@@) % على حدث لو أن سلمى أصابها % % بمثل بني ارفض منها هضابها % % 27(@)(@@) % وما زلت أرمي الحرب حتى تركتها % % كسير الجناح ما تدف عقابها % % 28(@)(@@) % إذا ما امترها الحالبون عصبتها % % على الجمر حتى ما يدر عصابها % % 29(@)(@@) % وأقعت على الأذناب كل قبيلة ، % على مضض مني ، وذلت رقابها % % 30(@)(@@) % أخ لكما إن عض بالحرب أصبحت % ذلولا ، وإن عضت به فل نابها % % PageV01P102 البحر : كامل تام 1(@)(@@) % إن المهالبة الكرام تحملوا % % دفع المكاره عن ذوي المكروه % 2(@)(@@) % زانوا قديمهم بحسن فعالهم ، % وكريم أخلاق بحسن وجوه % PageV01P103 البحر : طويل 1(@)(@@) % به أهل بدر ، عاقدين النواصيا % % قتيل كرى من حيث أصبحت نائيا % % 2(@)(@@) % وليلة بتنا بالجبوب تخيلت % تريد أمير المؤمنين وليتها % % 3(@)(@@) % أطافت بأطلاح وطلح ، كأنما % % لقوا في حياض الموت للقوم ساقيا % % 4(@)(@@) % فلما أطافت بالرجال ، ونبهت % بريح الخزامى هاجع العين وانيا % % 5(@)(@@) % تخطت إلينا سير شهر لساعة % من الليل ، خاضتها إلينا الصحاريا % % 6(@)(@@) % أتت بالغضا ، من عالج ، هاجعا هوى % % إلى ركبني هوجاء تغشى الفيافيا % % 7(@)(@@) % فباتت بنا ضيفا دخيلا ، ولا أرى % % سوى حلم جاءت به الريح ساريا % % 8(@)(@@) % وكانت إذا ما الريح جاءت ببشرها % % إلي سقتني ثم عادت بدائيا % % 9(@)(@@) % وإني وإياها كمن ليس واجدا % سواها لما قد أنطفته مداويا % % 10(@)(@@) % وأصبح رأسي بعد جعد كأنه % عناقيد كرم لا يريد الغواليا % % PageV01P104 11(@)(@@) % كأني به استبدلت بيضة دارع ، % % 12(@)(@@) % وقد به استبدلت بيضة دارع ، % يروع كما راع الغناء العذاريا % % 13(@)(@@) % أتيناك زوارا ، وسمعا وطاعة ، % فلبيك يا خير البرية داعيا % % 14(@)(@@) % فلو أنني بالصين ثم دعوتني ، % ولو لم أجد ظهرا أتيتك 
ms24	 ساعيا % % 15(@)(@@) % وما لي لا أسعى إليك مشمرا ، % وأمشي على جهد ، وأنت رجائيا % % 16(@)(@@) % وكفاك بعد الله في راحتيهما % % لمن تحت هدي فوقنا الرزق رافيا % % 17(@)(@@) % وأنت غياث الأرض والناس كلهم ، % بك الله قد أحيا الذي كان باليا % % 18(@)(@@) % وما وجد الإسلام بعد محمد % وأصحابه للدين ، مثلك راعيا % % 19(@)(@@) % يقود أبو العاصي وحرب لحوضه % فراتين قد غما اليحور الجواريا % % 20(@)(@@) % إذا اجتمعا في حوضه فاض منهما % % على الناس فيض يعلوان الروابيا % % PageV01P105 21(@)(@@) % فلم يلق حوض مثل حوض هما له ، % ولا مثل آذي فراتيه ساقيا % % 22(@)(@@) % وما ظلم الملك ابن عاتكة التي % % لها كل بدر قد أضاء اللياليا % % 23(@)(@@) % أرى الله بالإسلام والنصر جاعلا % على كعب من ناواك كعبك عاليا % % 24(@)(@@) % سبقت بنفسي بالجريض مخاطرا % إليك على نضوي الأسود العواديا % % PageV01P106 
