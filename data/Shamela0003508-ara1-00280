ms261	 بخير(@)(@@)(@@)(@@) | 3979 - (@)(@@) سمعت يحيى قول وسئل عن حديث قتادة عن أيمن عن أبي أمامة قال لا أعرف أيمن(@)(@@)(@@)(@@) | 3980 - (@)(@@) سمعت يحيى يقول حوشب بن عقيل ليس به بأس(@)(@@)(@@)(@@) | 3981 - (@)(@@) سمعت يحيى يقول علي بن مسعدة ليس به بأس(@)(@@)(@@)(@@) | 3982 - (@)(@@) سمعت يحيى يقول أبو حتروش سلمة بن هزال بصري ليس بشيء(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3983 - (@)(@@) سمعت يحيى يقول لم يلق يحيى بن أبي كثير زيد بن سلام وقدم معاوية بن سلام عليهم فلم يسمع يحيى بن أبي كثير أخذ كتابه عن أخيه ولم يسمعه فدلسه عنه(@)(@@)(@@)(@@) | 3984 - (@)(@@) وأبو سلام ممطور وهو جد زيد بن سلام ويحيى بن أبي كثير يقول حدث أبو سلام ولم يلقه ولم يسمع منه شيئا(@)(@@)(@@)(@@) | 3985 - (@)(@@) سمعت العباس يقول قال بعض المحدثين ما رأيت رجلا مثل يحيى بن أبي كثير كنا نحدثه بالغداة ويحدثنا بالعشي يعني يدلس(@)(@@)(@@)(@@) | 3986 - (@)(@@) سمعت يحيى يقول أبو عوانة وضاح(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3987 - (@)(@@) سمعت يحيى يقول قال عباد بن عباد لم يمنع هشيم من أن يسمع من سعيد بن أبي عروبة إلا الكبر والأنفة(@)(@@)(@@)(@@) | 3988 - (@)(@@) سمعت يحيى يقول قد سمع بن سيرين بالكوفة الحديث سمع من عبيدة ونحوه وسمع من شريح قلت ليحيى فإن بن شبرمه يروي عن بن سيرين قال دخل بن سيرين الكوفة في وقت لم يكن بن شبرمة ولكن لعله سمع منه في الموسم قال هذا أو نحوه(@)(@@)(@@)(@@) | 3989 - (@)(@@) سمعت يحيى يقول عباد بن العوام وعباد بن عباد جميعا ثقة وعباد بن عباد أوثقهما وأكثرهما حديثا(@)(@@)(@@)(@@) | 3990 - (@)(@@) سمعت يحيى يقول عيسى بن إبراهيم يعني القرشي ليس حديثه بشيء(@)(@@)(@@)(@@) | 3991 - (@)(@@) سمعت يحيى يقول في حديث عبد الله بن رباح عن عائشة قال يحيى بينهما رجل وهو عبد العزيز بن النعمان(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3992 - (@)(@@) سمعت يحيى يقول قال يحيى بن سعيد القطان إذا سمعت من هشام الدستوائي وسعيد بن أبي عروبة وشعبة لا تبال من أيهم سمعت كلهم ثقة(@)(@@)(@@)(@@) | 3993 - (@)(@@) قال يحيى بن معين قال يحيى بن سعيد إذا كان عندي عن سعيد بن أبي عروبة لم أبال ألا 
ms262	 أسمعه من هشام وإذا كان عندي عن هشام لم ابال الا أسمعه من شعبة فان كان عندي عن شعبة لم أبال الا أسمعه منهما(@)(@@)(@@)(@@) | 3994 - (@)(@@) سمعت يحيى يقول يوسف بن عطية ليس بشيء(@)(@@)(@@)(@@) | 3995 - (@)(@@) وسالم بن نوح ليس بشيء(@)(@@)(@@)(@@) | 3996 - (@)(@@) سمعت يحيى يقول قد روى حماد بن سلمة عن سالم أبي حاتم وهو بصري(@)(@@)(@@)(@@) | 3997 - (@)(@@) سمعت يحيى يقول بكر بن بكار ليس بشيء(@)(@@)(@@)(@@) | 3998 - (@)(@@) وأبو بحر البكراوي ضعيف الحديث(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3999 - (@)(@@) سمعت يحيى يقول أبو البزري ومنقر أبو بشامة لم يرو عنهما إلا عمران بن حدير(@)(@@)(@@)(@@) | 4000 - (@)(@@) سمعت يحيى يقول قد روى حماد بن سلمة عن محمد بن نوح عن الحسن قلت ليحيى من محمد بن نوح قال شيخ له(@)(@@)(@@)(@@) | 4001 - (@)(@@) قال وقد ورى حماد بن سلمة عن رجل يقال له أبو نضرة اسمه زيد بن البختري(@)(@@)(@@)(@@) | 4002 - (@)(@@) سمعت يحيى يقول روى حماد بن سلمة عن ثابت عن حبيب بن سبيعة عن الحارث قيل ليحيى من الحارث هذا قال لا أدري(@)(@@)(@@)(@@) | 4003 - (@)(@@) سمعت يحيى يقول قد روى حماد عن رجل يقال له المغيرة بن مسلم مولى الحسن بن علي قال يحيى والمغيرة أخو عبد العزيز بن مسلم القسملي وهذا غير ذاك(@)(@@)(@@)(@@) | 4004 - (@)(@@) سمعت يحيى يقول داود بن أبي هند أحب إلي من عاصم الأحول وهو ثقة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4005 - (@)(@@) سمعت يحيى يقول سليمان بن قتة يروي عنه حميد الطويل ويروي عنه موسى بن أبي عائشة ويروي عنه عاصم الجحدري(@)(@@)(@@)(@@) | 4006 - (@)(@@) وعاصم الجحدري بصري وهو صاحب القراءة وكنيته أبو المجشر(@)(@@)(@@)(@@) | 4007 - (@)(@@) سمعت يحيى يقول حدثنا أبو قطن عن شعبة قال نهاني أيوب أن أحدث زينوا القرآن بأصواتكم(@)(@@)(@@)(@@) | 4008 - (@)(@@) سمعت يحيى يقول قال بن عون رأيت عكرمة قال يحيى بن معين وسمع من عكرمة(@)(@@)(@@)(@@) | 4009 - (@)(@@) سمعت يحيى يقول في قصة حديث يزيد التستري ذهبت عنه أبلته(@)(@@)(@@)(@@) | 4010 - (@)(@@) سمعت يحيى يقول معتمر بن سليمان أبو محمد وسليمان أبو المعتمر(@)(@@)(@@)(@@) | 4011 - (@)(@@) ومفضل بن فضالة يحدث عنه حجاج ويونس بن محمد وليس هو بذاك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4012 - (@)(@@) سمعت يحيى يقول 
ms263	 عبد الله بن عمر النميري يحدث عن يونس بن يزيد الأيلي وهو بصري(@)(@@)(@@)(@@) | 4013 - (@)(@@) سمعت يحيى يقول أبو مكين نوح بن ربيعة وقال وكيع أبو مكين بن أبان أخو الحكم بن أبان وقد أخطأ فيه وكيع إنما هو نوح بن ربيعة(@)(@@)(@@)(@@) | 4014 - (@)(@@) سمعت يحيى يقول كثير بن شنظير ليس بشيء(@)(@@)(@@)(@@) | 4015 - (@)(@@) قال يحيى أبو الأزهر صالح بن درهم ثقة يروي عنه شعبة ومروان الفزاري(@)(@@)(@@)(@@) | 4016 - (@)(@@) وعبد المؤمن بصري ثقة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4017 - (@)(@@) سمعت يحيى يقول قد روى شعبة عن الحكم عن أبي عمر الصيني ورواه عبد العزيز بن رفيع عن أبي عمر الصيني ورواه جرير عن عبد العزيز بن رفيع عن أبي صالح عن أبي الدرداء قلت ليحيى بن معين فقد روى أبو حفص الأبار عن ليث عن عبد الرحمن بن أبي ليلى عن أبي الدرداء فقال يحيى الحديث حديث الحكم عن أبي عمر الصيني عن أبي الدرداء(@)(@@)(@@)(@@) | 4018 - (@)(@@) حدثنا يحيى قال حدثنا محمد بن الحسن الواسطي قال أنبأنا أبو الحكم عبد الرحمن بن فروخ القطان كان بن سيرين يذكر أوزانه لكيلا تنقص إذا احتكت(@)(@@)(@@)(@@) | 4019 - (@)(@@) سمعت يحيى يقول عمرو بن عبيد البصري ليس بشيء(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4020 - (@)(@@) سمعت يحيى يقول حدثنا عبيد الله بن ثور بن أبي الحلال قال حدثنا الحلال بن ثور عن عبد المجيد بن وهب عن أبي الحلال قال سألت عثمان بن عفان عن جائزة السلطان فقال لحم ظبي ذكي قال يحيى وأبو الحلال اسم ربيعة بن زرارة(@)(@@)(@@)(@@) | 4021 - (@)(@@) سمعت يحيى يقول إذا اختلف إسماعيل بن علية وحماد بن زيد في أيوب كان القول قول حماد بن زيد قيل ليحيى فإن خالفه سفيان الثوري قال القول قول حماد في أيوب قال يحيى ومن خالفه من الناس جميعا في أيوب فالقول قوله وقال حماد جالست أيوب عشرين سنة(@)(@@)(@@)(@@) | 4022 - (@)(@@) سمعت يحيى يقول معتمر يروي عن زيد أبي المعلى ويروي عنه عبد الصمد وهو يروي عن أنس بن مالك(@)(@@)(@@)(@@) | 4023 - (@)(@@) سمعت يحيى يقول شعبة يقول عبد الله بن أبي المجالد وغير شعبة 
ms264	 هشيم يقول عن أشعث والشيباني عن محمد بن أبي المجالد(@)(@@)(@@)(@@) | 4024 - (@)(@@) سمعت يحيى يقول قد روى شعبة عن مصعب بن الجهبذ(@)(@@)(@@)(@@) | 4025 - (@)(@@) قال يحيى أبو قلابة عن النعمان بن بشير مرسل(@)(@@)(@@)(@@) | 4026 - (@)(@@) سمعت يحيى بن معين قال يحيى بن يعمر لم يسمع من عائشة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4027 - (@)(@@) سمعت يحيى يقول قد روى بن عون عن أيوب فاستفهمته فقلت عن أيوب فقال نعم قد روى عنه(@)(@@)(@@)(@@) | 4028 - (@)(@@) سمعت يحيى يقول قد سمع معتمر من أيوب قلت ليحيى فسليمان التيمي سمع من أيوب قال هو يروي عمن هو دون أيوب(@)(@@)(@@)(@@) | 4029 - (@)(@@) سمعت يحيى يقول قد سمع أبو غالب من بن عمر(@)(@@)(@@)(@@) | 4030 - (@)(@@) سمعت يحيى يقول هلال بن أبي ميمونة يروي عنه زياد بن سعد(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4031 - (@)(@@) سمعت يحيى يقول شهر بن حوشب شامي نزل البصرة وهو ثقة وكان من الأشعريين من أنفسهم(@)(@@)(@@)(@@) | 4032 - (@)(@@) سمعت يحيى يقول هلال بن أبي زينب ثقة يروي عنه بن عون فقط(@)(@@)(@@)(@@) | 4033 - (@)(@@) وهلال بن أبي ميمونة هو هلال بن علي الذي يروي عنه فليح وهلال بن علي يروي عنه يحيى بن أبي كثير(@)(@@)(@@)(@@) | 4034 - (@)(@@) سمعت يحيى يقول قال حجاج الأعور كتب لي سليمان بن مجالد إلى شعبة فأتيته فكنت أسأله حديث حماد عن إبراهيم فكان يحدثني وكان لا يدع أحدا يكتب عنده فكنت أسأله ثم أقول البول البول فقال شعبة هذا والله باطل إنما يريد يتذكر الأطراف(@)(@@)(@@)(@@) | 4035 - (@)(@@) سمعت يحيى يقول قد روى بن عون عن السدي قال حدثنا السدي أو حبيب بن أبي ثابت(@)(@@)(@@)(@@) | 4036 - (@)(@@) سمعت يحيى يقول عباد المنقري هو عباد بن راشد(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4037 - (@)(@@) سمعت يحيى يقول كان داود بن أبي هند يجلس إلى فضل الرقاشي وهو فضل بن عيسى وهو قدري(@)(@@)(@@)(@@) | 4038 - (@)(@@) وكان عباد بن منصور قدريا وكان صديقا لأيوب(@)(@@)(@@)(@@) | 4039 - (@)(@@) سمعت يحيى يقول عبد الرحمن بن زيد العمي ليس بشيء(@)(@@)(@@)(@@) | 4040 - (@)(@@) سمعت يحيى يقول قد سمع يحيى بن سعيد القطان من نعيم بن حكيم وأبو مريم الذي يروي عنه نعيم بن حكيم لم يرو عنه غيره 
ms265	(@)(@@)(@@)(@@) | 4041 - (@)(@@) سمعت يحيى يقول شيبان بن عبد الرحمن أحب إلي من معمر في قتادة(@)(@@)(@@)(@@) | 4042 - (@)(@@) سمعت يحيى يقول في حديث إذا صليتم علي فصلوا على المرسلين قال يحيى إنما هو عن قتادة مرسل(@)(@@)(@@)(@@) | 4043 - (@)(@@) سمعت يحيى يقول قد روى محمد بن سيرين عن خالد يعني الحذاء(@)(@@)(@@)(@@) | 4044 - (@)(@@) سمعت يحيى يقول أبو هارون العبدي ليس بثقة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4045 - (@)(@@) سمعت يحيى يقول عبيد الله بن الأخنس ليس به بأس يروي عنه سعيد بن أبي عروبة ويروي عنه يحيى القطان وسمع منه الخفاف وسمع منه أبو عبيدة الحداد وكان خزازا وكنيته أبو مالك(@)(@@)(@@)(@@) | 4046 - (@)(@@) قال يحيى وكان عبد الوهاب بن عطاء عجليا مولى لهم(@)(@@)(@@)(@@) | 4047 - (@)(@@) سمعت يحيى يقول كان جرير بن يزيد في دار المطلب كان فيها أو قال كان نازلا فيها فجاءه إنسان يسأله فقال يا غلام اذهب إلى الجواري فمن أراد منهن أن نصبغ ثيابها فلتبعث بها فجاء الغلام بثياب كثيرة فقال للذي سأله شدها في بعض الأثواب وخذها(@)(@@)(@@)(@@) | 4048 - (@)(@@) سمعت يحيى يقول حدثنا عبيد الله بن أبي الحلال قال حدثتني أمي عن عمتها قالت مات أبو الحلال يوم مات وهو بن عشرين ومائة سنة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4049 - (@)(@@) حدثنا يحيي قال عبيد الله بن أبي الحلال قال حدثتني أمي عن عمتها كان لأبي الحلال غرف منها غرفة لها أربعة أبواب وكان يقوم على باب منها فيقول أيا فلان أيا فلان حتى يأتي على أربعة أبواب ثم يقول هل تحس منهم من أحد أو تسمع لهم ركزا ثم يقبل على صلاته(@)(@@)(@@)(@@) | 4050 - (@)(@@) حدثنا يحيى قال حدثنا سعيد بن عامر قال سمعت سعيد بن أبي عروبة قال ما كان أحد أحفظ عن محمد بن سيرين من هشام بن حسان(@)(@@)(@@)(@@) | 4051 - (@)(@@) حدثنا يحيى بن معين قال حدثنا سعيد بن عامر عن هشام قال جاورت الحسن أو قال جالست الحسن عشر سنين(@)(@@)(@@)(@@) | 4052 - (@)(@@) حدثنا يحيى قال حدثنا سعيد بن عامر عن همام عن قتادة قال قال لي سعيد بن المسيب ما رأيت أحدا أسأل عما يختلف فيه منك 
ms266	 قال قلت إنا يسأل من يعقل عما يختلف فيه فأما ما لا يختلف فيه فلم يسأل عنه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4053 - (@)(@@) سمعت يحيى يقول قال أبو النضر هاشم بن القاسم عن شعبة قال لم يسمع الحسن من سمرة(@)(@@)(@@)(@@) | 4054 - (@)(@@) قال يحيى قال علي بن زيد لم يسمع الحسن من أبي هريرة شيئا قط(@)(@@)(@@)(@@) | 4055 - (@)(@@) ولم يسمع بن سيرين من بن عباس إنما سمع من عكرمة عن بن عباس(@)(@@)(@@)(@@) | 4056 - (@)(@@) سمعت يحيى يقول عباد بن صالح بصري يروي عنه عبد الرحمن بن مهدي(@)(@@)(@@)(@@) | 4057 - (@)(@@) سمعت يحيى يقول مات منصور وأيوب في سنة واحدة(@)(@@)(@@)(@@) | 4058 - (@)(@@) سمعت يحيى يقول قال يزيد بن هارون سمعت من سعيد بن أبي عروبة حين مر بنا وسمعت من سعيد بن أبي عروبة سنة ثلاث وثلاثين أو سنة ثنتين وثلاثين(@)(@@)(@@)(@@) | 4059 - (@)(@@) سمعت يحيى يقول سعيد بن ميناء روى عنه أيوب وحماد الأبح وهو مكي(@)(@@)(@@)(@@) | 4060 - (@)(@@) سمعت يحيى يقول جامع بن مطر بن ثمامة روى عنه أبو عبيدة وعبد الصمد(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4061 - (@)(@@) سمعت يحيى يقول مرجي بن رجاء ومرجي بن وداع صاحب التعبير جميعا ضعيفان وقد قال يحيى مرة ومرجي بن رجاء صالح الحديث(@)(@@)(@@)(@@) | 4062 - (@)(@@) سمعت يحيى يقول قرط بن حريث بصري قد كتبت عنه كان يروي عن سلام بن مسكين ولم يكن به بأس وهو مولى باهلة(@)(@@)(@@)(@@) | 4063 - (@)(@@) وحجاج بن فرافصة بصري لا بأس به قد روى عن بن سيرين(@)(@@)(@@)(@@) | 4064 - (@)(@@) ومحمد بن فضاء ضعيف الحديث(@)(@@)(@@)(@@) | 4065 - (@)(@@) سمعت يحيى يقول حماد بن زيد غسل جعفر بن سليمان الهاشمي وقال أبو الفضل قال لي سليمان بن حرب أخذت الغسل عن حماد بن زيد وقال حماد أخذت الغسل عن أيوب وقال أيوب أخذت الغسل عن أبي قلابة(@)(@@)(@@)(@@) | 4066 - (@)(@@) سمعت يحيى يقول النضر بن مطرف ليس بشيء(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4067 - (@)(@@) سمعت يحيى يقول عنبسة بن سعيد بصري وهو أخو أبي الربيع السمان وهو ضعيف(@)(@@)(@@)(@@) | 4068 - (@)(@@) سمعت يحيى يقول أبو رافع هو إسماعيل بن رافع(@)(@@)(@@)(@@) | 4069 - (@)(@@) سمعت يحيى يقول قال عبد الصمد عن شعبة عن محمد بن أبي 
ms267	 النوار عن محمد بن ذكوان عن رجل عن كعب قال إن الله يبغض أهل البيت اللحمين والحبر السمين(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4070 - (@)(@@) سمعت العباس يقول سمعت محمد بن عبيد الطنافسي قال كنا عند سفيان الثوري فأتاه رجل فقال يا أبا عبد الله أرأيت هذا الحديث الذي يروي إن الله يبغض أهل البيت اللحمين أهم الذين يكثرون أكل اللحم فقال سفيان لا هم الذين يكثرون أكل لحوم الناس(@)(@@)(@@)(@@) | 4071 - (@)(@@) حدثنا العباس قال حدثنا محمد بن عبيد قال كنا عند سفيان الثوري فأتاه رجل فقال يا أبا عبد الله رأيت في المنام كأن ريحانة قبل الشام ماتت فقال له سفيان إن صدقت رؤياك مات الأوزاعي قال فجاء رجل إلى سفيان فقال عظم الله أجرك في أخيك الأوزاعي فقد مات(@)(@@)(@@)(@@) | 4072 - (@)(@@) سمعت يحيى يقول محمد بن ذكوان يحدث عنه حماد بن زيد وعبد الصمد بن عبد الوارث(@)(@@)(@@)(@@) | 4073 - (@)(@@) سمعت يحيى يقول الوليد أبو بشر هو الوليد بن مسلم بن شهاب العنبري روى عنه خالد الحذاء وعم عباس العنبري أيضا هو من ولد توبة العنبري(@)(@@)(@@)(@@) | 4074 - (@)(@@) سمعت يحيى يقول الحارث بن ثقف ضعيف الحديث(@)(@@)(@@)(@@) | 4075 - (@)(@@) وعبد الله بن بارق ليس بشيء(@)(@@)(@@)(@@) | 4076 - (@)(@@) سمعت يحيى يقول فر أبو قلابة إلى الشام فمات بها أرادوا أن يستقضوه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4077 - (@)(@@) سمعت يحيى يقول روى بن عون عن بن سيرين عن المغيرة بن سلمان عن بن عمر قال حفظت عن النبي صلى الله عليه وسلم عشر ركعات فسئل يحيى بن معين سمعه أيوب من مغيرة بن سلمان فقال نعم يقول أيوب سمعت المغيرة بن سلمان في بيت سيرين(@)(@@)(@@)(@@) | 4078 - (@)(@@) وأبو المهلب اسمه مطرح بن يزيد(@)(@@)(@@)(@@) | 4079 - (@)(@@) سمعت يحيى يقول وسألته عن الرجل يقول كل امرأة تزوجتها فهي طالق قال ليس بشيء يتزوج(@)(@@)(@@)(@@) | 4080 - (@)(@@) سألت يحيى عن وتره فقال أنا أوتر كل ليلة بثلاث أقرأ فيها بسبح اسم ربك الأعلى وقل يا أيها الكافرون وقل هو الله أحد ولا أقنت إلا في النصف الأخير من رمضان فإذا قنت في النصف رفعت يدي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4081 
ms268	 - (@)(@@) سمعت يحيى يقول معمر لم يرو عن عبد الكريم أبي أمية البصري شيئا وقد روى عن عبد الكريم الجزري(@)(@@)(@@)(@@) | 4082 - (@)(@@) سمعت يحيى يقول منصور بن عبد الرحمن العداني هو منصور الأشل(@)(@@)(@@)(@@) | 4083 - (@)(@@) سمعت يحيى يقول بكر الأعنق ليس به بأس(@)(@@)(@@)(@@) | 4084 - (@)(@@) وعمر بن نبهان يحدث عنه أبو قتيبة وجعفر بن سليمان وهو ثقة(@)(@@)(@@)(@@) | 4085 - (@)(@@) والحارث بن نبهان ليس حديثه بشيء(@)(@@)(@@)(@@) | 4086 - (@)(@@) سمعت يحيى يقول أبو الدهماء اسمه قرفة بن بهيس(@)(@@)(@@)(@@) | 4087 - (@)(@@) سمعت يحيى يقول أبو الهيثم اسمه عمارة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4088 - (@)(@@) سمعت يحيى يقول حدثنا بن مهدي عن حماد بن سلمة عن حميد قال كان الحسن يشد أسنانه بالذهب قال يحيى وكانوا ينكرون هذا على بن مهدي(@)(@@)(@@)(@@) | 4089 - (@)(@@) سمعت يحيى يقول كان أبو داود الطيالسي يروي حديث شعبة عن عبد الله بن دينار عن بن عمر عن النبي صلى الله عليه وسلم في القزع قيل إنه أخطأ فتركه وقد قال يحيى بن معين مرة إن أبا داود حدث به في المجلس فصاح به الناس يا أبا داود ليس هذا من حديثك إنما ذا حديث شبابة فقال أبو داود فدعوه إذن فدعوه فارغة فارغة(@)(@@)(@@)(@@) | 4090 - (@)(@@) سمعت يحيى يقول عبيد الله بن شميط بن أخي الأخضر بن عجلان(@)(@@)(@@)(@@) | 4091 - (@)(@@) سمعت يحيى يقول إسحاق بن عبد الله بن أبي طلحة صار إلى اليمامة(@)(@@)(@@)(@@) | 4092 - (@)(@@) سمعت يحيى يقول محمد بن الحارث الحارثي بصري وليس هو بشيء(@)(@@)(@@)(@@) | 4093 - (@)(@@) سمعت يحيى يقول الفضيل بن سليمان ليس بثقة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4094 - (@)(@@) سمعت يحيى يقول لم يسمع الحسن من سمرة شيئا هو كتاب قال يحيى في حديث الحسن عن سمرة من قتل عبده قتلناه قال في سماع البغداديين ولم يسمع الحسن من سمرة قال يحيى ولم يسمع من الأسود بن سريع(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4095 - (@)(@@) سمعت يحيى يقول قد سمع الحسن من عبد الرحمن بن سمرة وأنس بن مالك وابن عمر ورأى عثمان بن عفان ولم يسمع من بن عباس قال يحيى قال يزيد في حديثه سمع الحسن من بن عباس قال يحيى ولم يسمع 
ms269	 منه(@)(@@)(@@)(@@) | 4096 - (@)(@@) سئل يحيى سمع الحسن من معقل بن يسار قال ليس ذاك ببين قال يحيى سمع الحسن من أحمر(@)(@@)(@@)(@@) | 4097 - (@)(@@) سئل يحيى سمع الحسن من جندب قال لا أدري قال يحيى وجرير يرويه وليس يرويه الناس أجمعون(@)(@@)(@@)(@@) | 4098 - (@)(@@) سمعت يحيى يقول قد سمع خالد الحذاء من عبد الرحمن بن سعيد بن وهب(@)(@@)(@@)(@@) | 4099 - (@)(@@) قال يحيى بن معين في حديث أنه كره الشكال في الخيل رواه شعبة عن عبد الله بن يزيد النخعي وإنما هو عن سلم بن عبد الرحمن(@)(@@)(@@)(@@) | 4100 - (@)(@@) قلت ليحيى كم تختار أن تكبر على الجنائز قال أربعا قلت فإن صليت خلف رجل فكبر خمسا قال أكبر ما كبر ولا أنصرف(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4101 - (@)(@@) حدثنا العباس قال حدثنا أبو النضر هاشم بن القاسم قال حدثنا الأشجعي قال صليت مع الثوري على جنازة فكبر الإمام أربعا ثم كبر الخامسة فانصرف سفيان وقال ما تراهم يريدون(@)(@@)(@@)(@@) | 4102 - (@)(@@) حدثنا العباس قال حدثنا الأسود بن عامر شاذان قال أنبأنا شريك عن ليث عن عبد الرحمن بن الأسود عن أبيه قال كان بن مسعود يرفع يديه في القنوت إلى ثدييه(@)(@@)(@@)(@@) | 4103 - (@)(@@) سمعت يحيى يقول في حديث بشير بن الخصاصية في خلع النعل قال كان بن سيرين يمشي في نعليه بين القبور قلت فلا تأخذ بحديث بشير بن الخصاصية في خلع النعل فقال آخذ بحديث بن سيرين ثم قال يحيى أليس قد قال النبي صلى الله عليه وسلم إدا أمرتكم بشيء فخذوا منه ما استطعتم وإذا نهيتك عن شيء فانتهوا(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4104 - (@)(@@) سمعت يحيى يقول لا أرى المسح على العمامة قال أبو الفضل وذاك أن المسح على العمامة له شرط شديد(@)(@@)(@@)(@@) | 4105 - (@)(@@) سمعت العباس يقول سمعت أبا عبيد القاسم بن سلام يقول المسح على العمامة لا بأس به إلا أنه إن نام فيها أو لم ينم انحل منها كور أو كوران أو زلت عن الرأس لم أر المسح عليها ولكن إن تعمم رجل فلم تزل عن رأسه مسح عليها(@)(@@)(@@)(@@) | 4106 - (@)(@@) سمعت يحيى يقول لا أرى الصلاة 
ms270	 على الرجل إذا مات بغير البلد وكان يوهن هذا الحديث(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4107 - (@)(@@) قال يحيى ولا أرى لرجل أن يهب أبنته بلا مهر ولا أرى أن يزوجها على سورة من القرآن ورأيت يحيى يوهن هذه الأحاديث(@)(@@)(@@)(@@) | 4108 - (@)(@@) سمعت يحيى يقول داود بن أبي القصاف يروي عنه سعيد بن أبي عروبة ويروي عنه داود بن الزبرقان يدلس عنه(@)(@@)(@@)(@@) | 4109 - (@)(@@) سمعت يحيى يقول حجاج الأحول الباهلي بصري روى عن سعيد بن أبي عروبة وقد أدركه يزيد بن زريع أيضا(@)(@@)(@@)(@@) | 4110 - (@)(@@) سمعت يحيى يقول هشام بن أبي هشام وهو هشام أبو المقدام وهو هشام بن زياد أخو الوليد بن أبي هشام وهو مولى عثمان بن عفان وهو ضعيف والوليد بن أبي هشام ثقة(@)(@@)(@@)(@@) | 4111 - (@)(@@) سمعت يحيى يقول وذكر بعض القسام فقال هو من ولد عمران النخلي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4112 - (@)(@@) سمعت يحيى يقول قال يحيى بن سعيد إذا سمعت من شعبة لم أبال ألا أسمعه من سفيان وإذا سمعته من سفيان لم أبال ألا أسمعه من شعبة(@)(@@)(@@)(@@) | 4113 - (@)(@@) سمعت يحيى يقول خالد بن رباح وكنيته أبو الفضل بياع البصري يروي عنه يزيد بن هارون وأبو عبيدة(@)(@@)(@@)(@@) | 4114 - (@)(@@) سمعت يحيى يقول الدجين ليس حديثه بشيء وقد سمع منه بن المبارك(@)(@@)(@@)(@@) | 4115 - (@)(@@) سمعت يحيى يقول خالد الحذاء مولى أظن يحيى قال مولى لمولى قريش(@)(@@)(@@)(@@) | 4116 - (@)(@@) سمعت يحيى يقول حماد بن سلمة سمع من شيخ يقال له أبو أيوب وما روى عن أبي أيوب غير هذا فهو الذي يروي قتادة عن أبي أيوب وبعضهم يقول أبو أيوب العتكي وبعضهم يقول الأزدي والأزد من العتيك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4117 - (@)(@@) سمعت يحيى يقول عبد الرحمن بن إسحاق صاحب الزهري بصري وكان أصله مدينيا ومات بالبصرة(@)(@@)(@@)(@@) | 4118 - (@)(@@) سمعت يحيى يقول أبو رجاء عمران بن تيم(@)(@@)(@@)(@@) | 4119 - (@)(@@) سمعت يحيى يقول الضحاك بن يسار روى عنه مسلم بن إبراهيم ووكيع(@)(@@)(@@)(@@) | 4120 - (@)(@@) سمعت يحيى يقول مات أبو هلال الراسبي في ذي الحجة سنة سبع وستين ومائة(@)(@@)(@@)(@@) | 4121 - (@)(@@) ومات سلام بن مسكين في ذي القعدة سنة سبع وستين(@)(@@)(@@)(@@) | 4122 - (@)(@@) ومات سلام 
ms271	 بن أبي مطيع وهو مقبل من مكة سنة أربع وسبعين(@)(@@)(@@)(@@) | 4123 - (@)(@@) ومات أبو الأشهب سنة خمس وستين أظنه قال في أول يوم من شعبان(@)(@@)(@@)(@@) | 4124 - (@)(@@) ومات هشام الدستوائي سنة ثلاث وخمسين(@)(@@)(@@)(@@) | 4125 - (@)(@@) سمعت يحيى يقول الضحاك بن يسار يضعفه البصريون(@)(@@)(@@)(@@) | 4126 - (@)(@@) سمعت يحيى يقول مات خالد سنة أربعين(@)(@@)(@@)(@@) | 4127 - (@)(@@) ومات يونس في سنة سبع وثلاثين(@)(@@)(@@)(@@) | 4128 - (@)(@@) ومات عبد العزيز بن مسلم سنة سبع وستين قبل حماد بن سلمة بسنة(@)(@@)(@@)(@@) | 4129 - (@)(@@) ومات شعبة قبل سفيان بسنة ومات شعبة سنة ستين ومائة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4130 - (@)(@@) ومات القاسم بن الفضل الحداني سنة تسع وستين(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4131 - (@)(@@) ومات سعيد بن زيد يعني أخا حماد بن زيد في السنة التي مات فيها حماد بن سلمة قبل حماد بن سلمة(@)(@@)(@@)(@@) | 4132 - (@)(@@) ومات أبو عوانة سنة ست وسبعين في ربيع الآخر ومكث عبد الواحد بعده عشرة أشهر(@)(@@)(@@)(@@) | 4133 - (@)(@@) ومات يزيد بن زريع سنة اثنتين وثمانين(@)(@@)(@@)(@@) | 4134 - (@)(@@) ومات معتمر بن سليمان سنة سبع وثمانين في المحرم(@)(@@)(@@)(@@) | 4135 - (@)(@@) ومات بشر بن المفضل بعده بشهرين(@)(@@)(@@)(@@) | 4136 - (@)(@@) سمعت يحيى يقول روح بن القاسم ثقة(@)(@@)(@@)(@@) | 4137 - (@)(@@) سئل يحيى عن روح بن أسلم فلم يقل إلا خيرا وقال شيخ مسكين وقد كان معاذ أدخله في شيء من عمله(@)(@@)(@@)(@@) | 4138 - (@)(@@) سمعت يحيى يقول زكريا بن حكيم الندبي هو الحبطي وليس بشيء(@)(@@)(@@)(@@) | 4139 - (@)(@@) سمعت يحيى يقول أدهم أبو بشر السدوسي روى عنه هشيم وابن علية(@)(@@)(@@)(@@) | 4140 - (@)(@@) سمعت يحيى يقول أنس بن سيرين أكبر من محمد بن سيرين(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4141 - (@)(@@) سمعت يحيى يقول أبو بكر الهذلي لم يكن بثقة وكان يكون في مسجد غندر وكان مسجد غندر مسجد هذيل قال يحيى قال غندر كان أبو بكر الهذلي كذابا(@)(@@)(@@)(@@) | 4142 - (@)(@@) سمعت يحيى يقول حميد الطويل بن تيرويه(@)(@@)(@@)(@@) | 4143 - (@)(@@) سمعت يحيى يقول كان حماد بن زيد مولى الجهاضم(@)(@@)(@@)(@@) | 4144 - (@)(@@) سمعت يحيى يقول الوليد بن عبد الرحمن الجرشي الذي يروي عنه داود بن أبي هند قد روى عنه أيضا إبراهيم بن أبي عبلة(@)(@@)(@@)(@@) | 4145 - (@)(@@) سمعت يحيى يقول حدثنا يحيى بن سعيد القطان عن 
ms272	 عوف عن الحسن إنما أشكو بثي قال حزني(@)(@@)(@@)(@@) | 4146 - (@)(@@) سمعت يحيى يقول أبو المهلب معاوية بن عمرو(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4147 - (@)(@@) سمعت يحيى يقول أشعث بن عبد الملك صاحب الحسن كنيته أبو هانئ ولم يقل يحيى صاحب الحسن ولكنه عندي هكذا(@)(@@)(@@)(@@) | 4148 - (@)(@@) سمعت يحيى يقول أبو غفار بصري قد روى عنه يحيى بن سعيد القطان ومروان بن معاوية قال أبو الفضل وقد روى عنه عيسى بن يونس(@)(@@)(@@)(@@) | 4149 - (@)(@@) سألت يحيى عن جعفر بن ميمون فقال هو بصري صالح الحديث وقد روى عنه سعيد بن أبي عروبة وغندر وأبو عبيدة الحداد قال أبو الفضل وقد روى عنه عيسى بن يونس(@)(@@)(@@)(@@) | 4150 - (@)(@@) سألت يحيى بن معين عن حديث رواه عباد بن العوام عن هلال بن خباب عن أبي هاشم عن بن عمر قال يحيى أبو هاشم هذا قد سمع من بن عمر هذا يقال له أبو هاشم السنجاري وقد روى عنه خصيف فيما أحسب(@)(@@)(@@)(@@) | 4151 - (@)(@@) سمعت يحيى يقول قد روى هشام بن حسان عن أيوب(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4152 - (@)(@@) سمعت يحيى يقول وسئل عن حماد بن سلمة حديث عاصم بن المنذر بن الزبير عن أبي بكر بن عبيد الله بن عبد الله بن عمر هذا خير الإسناد أو قال يحيى هذا جيد الإسناد قيل له فإن بن علية لم يرفعه قال يحيى وإن لم يحفظه بن علية فالحديث جيد الإسناد وهو أحسن من حديث الوليد بن كثير يعني يحيى في قصة الماء لا ينجسه شيء(@)(@@)(@@)(@@) | 4153 - (@)(@@) قال يحيى بن معين لا أرى بأسا بالماء إذا كان في بئر فوقع فيه شيء فمات إلا أن ماءها كثير ما لم يغير طعما أو ريحا قلت له فإن تغوط إنسان في البئر أو بال فيها قال أكرهها إذا بال فيها إنسان أو تغوط فأما سائر ذلك فلا(@)(@@)(@@)(@@) | 4154 - (@)(@@) سمعت يحيى يقول قد روى شعبة عن الحكم عن زياد بن حدير(@)(@@)(@@)(@@) | 4155 - (@)(@@) سمعت يحيى يقول حماد بن زيد أثبت من حماد بن سلمة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4156 - (@)(@@) سمعت يحيى يقول حدثنا حجاج عن شعبة عن 
ms273	 منصور بن زاذان عن بن سيرين قال كان حميد بن عبد الرحمن أفقه أهل البصرة قبل أن يموت بعشر سنين(@)(@@)(@@)(@@) | 4157 - (@)(@@) سمعت يحيى يقول الحسن بن دينار ليس بشيء(@)(@@)(@@)(@@) | 4158 - (@)(@@) والحسن الجفري ليس بشيء(@)(@@)(@@)(@@) | 4159 - (@)(@@) حدثنا يحيى قال حدثنا عبد الصمد بن عبد الوارث عن حماد بن زيد قال قال حماد بن أبي سليمان من أمن أن يثقل ثقل قلت ليحيى حماد بن زيد عن حماد بن أبي سليمان قال يحيى مرسل(@)(@@)(@@)(@@) | 4160 - (@)(@@) حدثنا يحيى قال سمعت مروان بن معاوية الفزاري عن شقيق بن عبد الله قال رأيت على أنس بن مالك قميص كتان هكذا قال الفزاري لم يقل قميص كتان(@)(@@)(@@)(@@) | 4161 - (@)(@@) سمعت يحيى يقول مكحول البصري قد رأى بن عمر(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4162 - (@)(@@) سمعت يحيى يقول عباس بن الفضل ليس بشيء يحدث بحديث عن سعيد عن قتادة عن جابر بن زيد عن بن عباس عن النبي صلى الله عليه وسلم إذا كانت سنة كذا وكذا كان كذا وهذا حديث ليس له أصل(@)(@@)(@@)(@@) | 4163 - (@)(@@) سمعت يحيى يقول يوسف بن عبده كنيته أبو عبده وهو بصري ثقة قد حدث عن ثابت البناني(@)(@@)(@@)(@@) | 4164 - (@)(@@) حدثنا يحيى قال حدثنا عبد الصمد بن عبد الوارث عن صرد بن ظرطم عن حبيب بن أبي فضالة قال كان علي يقول يا قنبر ادخل السجن ولا تخرج(@)(@@)(@@)(@@) | 4165 - (@)(@@) حدثنا يحيى قال حدثنا بن أبي عدي عن بن عون عن أنس بن سيرين أن أنس بن مالك كان يوضع له الماء والأشنان للاستنجاء(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4166 - (@)(@@) حدثنا يحيى قال حدثنا أبو داود الطيالسي عن حرب بن شداد عن يحيى بن أبي كثير عن أنس بن سيرين عن أنس بن مالك أنه صلى على جنازة بعد ما صلي عليها قلت ليحيى يحيى بن أبي كثير عن أنس بن سيرين قال هكذا قال قلت روى يحيى بن أبي كثير عن بن سيرين قال ما سمعت غير هذا(@)(@@)(@@)(@@) | 4167 - (@)(@@) سمعت يحيى يقول وسئل عن بن عون أكبر من أيوب قال كان أكبر من أيوب سنتين 
ms274	 وعاش بن عون بعد أيوب عشرين سنة(@)(@@)(@@)(@@) | 4168 - (@)(@@) قال يحيى ومات بن عون بعد الأعمش ذهب وكيع بعد الأعمش إلى عون فسمع(@)(@@)(@@)(@@) | 4169 - (@)(@@) سئل يحيى سمع المطلب من أبي موسى قال لا(@)(@@)(@@)(@@) | 4170 - (@)(@@) سمعت يحيى يقول أبو ظلال هلال القسملي وهو ضعيف(@)(@@)(@@)(@@) | 4171 - (@)(@@) سمعت يحيى يقول حدثنا بن مهدي عن مالك عن نافع عن بن عمر أن النبي صلى الله عليه وسلم نهى عن النجش(@)(@@)(@@)(@@) | 4172 - (@)(@@) سمعت يحيى يقول سلم بن أبي الذيال كان غائبا عن البصرة وهو بصري روى عنه معتمر وإسماعيل بن مسلم العيدي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4173 - (@)(@@) سألت يحيى عن حديث معمر عن محمد بن عبد الرحمن الجحشي من هو قال مجهول(@)(@@)(@@)(@@) | 4174 - (@)(@@) سألت يحيى عن شيخ روى عنه معمر يقال له عثمان يروي عن مقسم قال يحيى هذا يقال له عثمان المشاهد(@)(@@)(@@)(@@) | 4175 - (@)(@@) سمعت يحيى يقول أبو المنهال اسمه عبد الرحمن بن مطعم روى عنه عمرو بن دينار وهو بصري وقد روى شعبة عن حبيب بن أبي ثابت عن أبي المنهال بن بنانة لا يكون بن بنانة إلا بصري(@)(@@)(@@)(@@) | 4176 - (@)(@@) سمعت يحيى يقول أبو العجفاء هرم(@)(@@)(@@)(@@) | 4177 - (@)(@@) وأبو ميمونة اسمه سلمان وهو الذي يقال هلال بن أبي ميمونة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4178 - (@)(@@) سمعت يحيى يقول أخرج إلينا غندر جرابا من جرب الطيالسة فيه حديث بن عيينة فنظر فيه خلف المخرمي ونظرنا فيه على أن نصيب فيه خطأ فما أصبنا فيه خطأ وقد كان على ودهم أنهم يصيبوا فيه خطأ فما أصابوا(@)(@@)(@@)(@@) | 4179 - (@)(@@) سمعت يحيى يقول جعل جار ليحيى بن سعيد يشتمه ويقع فيه ويقول هذا الخوزي ونحن في المسجد فجعل يحيى يبكي ويقول صدق ومن أنا وما أنا وجعل يذم نفسه(@)(@@)(@@)(@@) | 4180 - (@)(@@) حدثنا يحيى بن معين قال كان يحيى بن سعيد إذا قرئ عنده القرآن سقط حتى يصيب وجهه الأرض قلت ليحيى رأيته أنت قال لا ولكن بلغني أنه كان يصيبه هذا(@)(@@)(@@)(@@) | 4181 - (@)(@@) سمعت يحيى يقول قال يحيى بن سعيد ما دخلت كنيفا قط إلا ومعي امرأة قال يحيى كان رجلا ضعيف 
ms275	 القلب(@)(@@)(@@)(@@) | 4182 - (@)(@@) سمعت يحيى يقول يوسف السمتي كان يكذب ويخاصم اليهود والنصارى(@)(@@)(@@)(@@) | 4183 - (@)(@@) سمعت يحيى يقول سالم بن نوح ليس بحديثه بأس(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4184 - (@)(@@) سمعت يحيى يقول كل ما كان غندر يحدث فما كان قد سمعه ثم عرضه على المحدث قال فيه حدثنا وإن كان قد سمع الحديث من المحدث ولم يكن يعرضه عليه يقول فلان ولا يقول حدثنا وإذا كان في كتابه ما قد سمعه من المحدث ثم عرض عليه كان في كتابه عين(@)(@@)(@@)(@@) | 4185 - (@)(@@) سمعت يحيى يقول سمعت عفان يقول رأى رجل ليحيى بن سعيد قبل موته بعشرين سنة بشر يحيى بن سعيد بأمان من الله يوم القيامة(@)(@@)(@@)(@@) | 4186 - (@)(@@) سألت يحيى عن أصحاب قتادة أيهم أرفع عندك فقال سعيد وهشام وشعبة(@)(@@)(@@)(@@) | 4187 - (@)(@@) سمعت يحيى يقول حدثنا يحيى بن سعيد عن عبيد الله عن نافع قال كان بن عمر لا يتخذ في بيته مكانا يصلي فيه(@)(@@)(@@)(@@) | 4188 - (@)(@@) قال يحيى بن معين كان يحيى بن سعيد يخطىء في هذا لا أعلم شكا في الضحايا وأخطأ إنما هو شركا في الضحايا وكان يخطىء في حديث آخر قال إن عبد الله متع بخادم وقال غيره إن عبد الله بن عبد الله متع بخادم(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4189 - (@)(@@) سمعت يحيى يقول قال الأصمعي سألت عبد الملك بن صالح الهاشمي عن عرب سوسن فقال إنما هو عرب سوس قرية من قرى الشام أنا بها عارف قال يحيى ويروى عن بن عون أنه قال عرب السوسن(@)(@@)(@@)(@@) | 4190 - (@)(@@) سمعت يحيى يقول المشمعل بن إياس بصري وهو ثقة روى عنه يحيى بن سعيد وعبد الرحمن(@)(@@)(@@)(@@) | 4191 - (@)(@@) والمشمعل بن لحان صالح الحديث إلا أن المشمعل بن إياس أوثق منه كثيرا(@)(@@)(@@)(@@) | 4192 - (@)(@@) سمعت يحيى يقول مات وهيب بن خالد وهو بن ثمانية وخمسين(@)(@@)(@@)(@@) | 4193 - (@)(@@) سمعت يحيى يقول قرط بن عيوق ليس به بأس(@)(@@)(@@)(@@) | 4194 - (@)(@@) وقرط بن حريث قد كتبت أنا عنه وليس به بأس ولكن كان قدريا أتيناه إلى منزله فقال لنا نزهوا الله عن هذه المعاصي فدعانا إلى القدر فخرجت وكان مولى 
ms276	 لباهلة قال يحيى وكان قرط هذا يقوم لرجل من المحدثين حديثه يعني يحيى أنه كان يخرج منه اللحن(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4195 - (@)(@@) قلت ليحيى ما تقول في الرجل يقوم للرجل حديثه ينزع عنه اللحن فقال لا بأس به(@)(@@)(@@)(@@) | 4196 - (@)(@@) سمعت يحيى يقول يزيد بن أبي صالح الدباغ أبو حبيب البصري يحدث عنه وكيع وعبد الصمد(@)(@@)(@@)(@@) | 4197 - (@)(@@) قال يحيى ويزيد بن درهم بصري(@)(@@)(@@)(@@) | 4198 - (@)(@@) قال يحيى هذا البيت وإذا افتقرت إلى الذخائر لم تجد ذخرا يكون كصالح الأعمال قال يحيى هذا للأخطل(@)(@@)(@@)(@@) | 4199 - (@)(@@) سمعت يحيى يقول الحارث بن عبيد ضعيف الحديث(@)(@@)(@@)(@@) | 4200 - (@)(@@) سمعت يحيى يقول عبيد صاحب السابري بصري(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4201 - (@)(@@) سمعت يحيى يقول قد روى معتمر بن سليمان وسعيد بن أبي عروبة عن ثابت بن زيد وهو من ولد زيد بن أرقم ليس هو ثابت بن زيد أبو زيد هذا رجل آخر وجميعا من أهل البصرة(@)(@@)(@@)(@@) | 4202 - (@)(@@) سمعت يحيى يقول حدث عبد الرحمن بن مهدي بحديث سليمان بن المغيرة قال وكان أبو عبيدة على الجيش فقلت له إنما هذا وكان أبو عبيدة على الحسر(@)(@@)(@@)(@@) | 4203 - (@)(@@) سمعت يحيى يقول أشعث بن سوار أحب إلي من إسماعيل بن مسلم(@)(@@)(@@)(@@) | 4204 - (@)(@@) سمعت يحيى يقول أيوب بن النجار يمامي ثقة وقد سمعت منه(@)(@@)(@@)(@@) | 4205 - (@)(@@) سمعت يحيى يقول يونس بن عبيد لم يسمع من نافع شيئا إنما روى عنه مراسيل ولكنه روى عن بن نافع(@)(@@)(@@)(@@) | 4206 - (@)(@@) سمعت يحيى يقول الربيع بن حبيب البصري ثقة(@)(@@)(@@)(@@) | 4207 - (@)(@@) سمعت يحيى يقول حديث سفينة أشطت دم جزور بجذل وقال هارون الخزاز عن شيبة والصواب هو سفينة قيل له من سفينة قال سفينة يعني صاحب النبي صلى الله عليه وسلم(@)(@@)(@@)(@@) | 4208 - (@)(@@) سمعت يحيى يقول عثمان بن سعد سمع منه وكيع وغيره(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4209 - (@)(@@) سمعت يحيى يقول كان عمير بن إسحاق لا يساوي شيئا ولكن يكتب حديثه قال أبو الفضل يعني يحيى بقوله إنه ليس بشيء يقول إنه لا يعرف ولكن بن عون روى عنه فقلت ليحيى ولا يكتب حديثه قال بلى(@)(@@)(@@)(@@) | 4210 - (@)(@@) سمعت يحيى يقول 
ms277	 في حديث عياض بن حمار حديث قتادة عن عقبة قيل له من عقبة هذا قال هو عقبة بن وساج قال لا قيل عقبة بن عبد الغافر فقال لا هو عقبة رجل آخر(@)(@@)(@@)(@@) | 4211 - (@)(@@) سمعت يحيى يقول صغدي البصري ليس بشيء(@)(@@)(@@)(@@) | 4212 - (@)(@@) وصغدي الكوفي ثقة يروي عنه أبو نعيم(@)(@@)(@@)(@@) | 4213 - (@)(@@) سمعت يحيى يقول إسحاق بن إدريس بصري ليس بشيء يضع الأحاديث(@)(@@)(@@)(@@) | 4214 - (@)(@@) سمعت يحيى يقول معبد بن هلال يروي عنه حماد بن يزيد وهو مشهور(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4215 - (@)(@@) سمعت يحيى يقول أبو العوام الباهلي هو شيخ يروي عنه وكيع وغيره وليس هو عمران القطان عمران القطان هو بن داور(@)(@@)(@@)(@@) | 4216 - (@)(@@) سمعت يحيى يقول قد روى يحيى بن سعيد القطان عن محمد بن عبد الله بن أبي مريم وقد روى عنه مالك بن أنس وحاتم بن إسماعيل(@)(@@)(@@)(@@) | 4217 - (@)(@@) سمعت يحيى يقول حدثني وهب بن جرير قال كان عباد بن منصور صديقا لأيوب فلما ولي عباد بن منصور القضاء عرض عليه أيوب راحلة وغلاما وأن يخرج إلى مكة قلت ليحيى أيوب الذي عرض عليه الراحلة قال نعم قال يحيى وقال وهب بن جرير يذهب أيوب إلى قدري خبيث يعرض عليه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4218 - (@)(@@) سمعت يحيى يقول حاتم بن أبي صغيرة هو حاتم بن مسلم اسم أبي صغيرة مسلم(@)(@@)(@@)(@@) | 4219 - (@)(@@) سمعت يحيى يقول النهاس بن قهم قاص(@)(@@)(@@)(@@) | 4220 - (@)(@@) سمعت يحيى يقول النعمان بن راشد ليس بشيء(@)(@@)(@@)(@@) | 4221 - (@)(@@) وإسحاق بن راشد صالح الحديث(@)(@@)(@@)(@@) | 4222 - (@)(@@) وخيثمة البصري روى عنه منصور وغيره قلت ليحيى فلم يحدث عنه البصريون قال لا(@)(@@)(@@)(@@) | 4223 - (@)(@@) حدثنا يحيى قال حدثنا معتمر بن سليمان عن هشام عن بن سيرين عن عبد الرحمن بن أبي بكرة أنه قال لامرأة وزوجها يغسل لا تسبقيني بنفسك قالت هيهات سبقت هكذا قال يحيى بن سيرين عن عبد الرحمن بن أبي بكرة(@)(@@)(@@)(@@) | 4224 - (@)(@@) قيل ليحيى سعيد بن ميناء سمع من عبد الله بن عمرو بن العاص قال نعم(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4225 - (@)(@@) سمعت يحيى يقول سمعت أبا قطن يقول كتب لي شعبة إلى أبي حنيفة 
ms278	 قال فأتيت أبا حنيفة فقال لي كيف أبو بسطام فقلت بخير فقال نعم حشو المصر هو(@)(@@)(@@)(@@) | 4226 - (@)(@@) حدثنا يحيى قال حدثنا معتمر بن سليمان قال حدثني منقذ قال حدثتني أنت عني عن أيوب عن الحسن قال ويح كلمة رحمة(@)(@@)(@@)(@@) | 4227 - (@)(@@) سمعت يحيى يقول داود بن الزبرقان ليس حديثه بشيء وقد روى عنه سعيد بن أبي عروبة حديثا في أصنافه قلت ليحيى من رواه عن سعيد قال الخفاف(@)(@@)(@@)(@@) | 4228 - (@)(@@) حدثنا يحيى قال حدثنا هشام بن يوسف عن معمر قال لي أيوب عبد الكريم أبو أمية غير ثقة قال فلا تحملن عنه(@)(@@)(@@)(@@) | 4229 - (@)(@@) سمعت يحيى يقول أبو المتوكل الناجي وأبو الصديق ليس بحديثهما بأس(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4230 - (@)(@@) حدثنا يحيى قال حدثنا عبد الرزاق قال سألت معمرا عن الخرق يكون في الخف فقال إذا خرج من مواضع الوضوء شيء فلا تمسح عليه واخلع(@)(@@)(@@)(@@) | 4231 - (@)(@@) حدثنا يحيى قال حدثنا عبد الرزاق قال سمعت الثوري يقول امسح عليهما ما تعلقا بالقدم وإن تخرقا قال وكذلك كانت خفاف المهاجرين والأنصار مخرقة مشققة(@)(@@)(@@)(@@) | 4232 - (@)(@@) حدثنا يحيى قال حدثنا حجاج قال سمعت شعبة يحدث قال قال أبو إسحاق سمعت أبا إياس يقول ما بالبصرة أحد أحب إلي أن ألقى الله بمثل عمله من أبي التياح(@)(@@)(@@)(@@) | 4233 - (@)(@@) حدثنا يحيى قال حدثنا حجاج عن شعبة قال قال لي يعلى بن عطاء أكتبك قلت لا قال أما والله ما أفعل هذا بكل أحد وما أعرض هذا على أحد قال شعبة فما كتبت شيئا قط إلا حديثين ما أحفظهما وما أحسن قراءتهما قال شعبة وحدثني يعلى بن عطاء عن أبيه أن رجلا أتى النبي صلى الله عليه وسلم يستأذنه في الجهاد هذا الحديث قال شعبة ولم يذكره عن عبد الله بن عمرو بن العاص فتهاونت له فقال لا تأخذهما عني عن أبي وقد ولد أبي لثلاث سنين بقين من خلافة عمر بن الخطاب(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4234 - (@)(@@) سمعت يحيى يقول قد روى علي بن زيد عن سعيد بن جبير وقد روى علي بن زيد عن أبي الضحى 
ms279	(@)(@@)(@@)(@@) | 4235 - (@)(@@) سمعت يحيى يقول سمعت يحيى بن سعيد القطان قال سمعت أبا معاوية الضرير يحدث في حياة الأعمش عن الأعمش عن أبي صالح عن أبي هريرة قال السائحون الصائمون قلت ليحيى بن سعيد إنما حدثنا به أبو معاوية عن شيخ عن أبي هريرة قال يحيى هكذا سمعته منه(@)(@@)(@@)(@@) | 4236 - (@)(@@) سمعت يحيى يقول جعفر بن ميمون بصري وليس هو بذاك(@)(@@)(@@)(@@) | 4237 - (@)(@@) سمعت يحيى يقول عمران أبو بكر هو عمران القصير وليس به بأس(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4238 - (@)(@@) سمعت يحيى يقول المفضل بن لاحق أبو بشر بن لاحق يحدث عنه أبو عبيدة الحداد وغيره وهو ثقة(@)(@@)(@@)(@@) | 4239 - (@)(@@) سمعت يحيى يقول يروي يحيى بن سعيد القطان عن شيخ يقال له حسن بن علي ويروى عنه وكيع أيضا(@)(@@)(@@)(@@) | 4240 - (@)(@@) سمعت يحيى يقول في حديث رفاعة بن عرابة فمن قال عرادة فقد أخطأ فقال رجل بحضرة يحيى بن معين معاذ بن هشام يقول عن رفاعة بن عرادة فقال يحيى الصواب عرابة(@)(@@)(@@)(@@) | 4241 - (@)(@@) سمعت يحيى يقول قد روى محمد بن بكر البرساني عن كثير بن أبي كثير وهو كوفي(@)(@@)(@@)(@@) | 4242 - (@)(@@) سمعت يحيى يقول حماد بن الجعد بصري ليس حديثه بشيء(@)(@@)(@@)(@@) | 4243 - (@)(@@) قال يحيى عزرة الذي يروى عنه قتادة بصري(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4244 - (@)(@@) سمعت يحيى يقول العوام بن حمزة يروى عنه يحيى بن سعيد وغندر وليس حديثه بشيء(@)(@@)(@@)(@@) | 4245 - (@)(@@) قال يحيى والعوام بن مراجم لم أسمع أحدا يحدث عنه إلا شعبة(@)(@@)(@@)(@@) | 4246 - (@)(@@) حدثنا العباس قال حدثنا حجاج الفسطاطي قال حدثنا شعبة عن العوام بن مراجم من بنى قيس بن ثعلبة عن أبي عثمان النهدي عن عثمان بن عفان أن النبي صلى الله عليه وسلم قال لتقتصن الجماء من القرناء يوم القيامة قال أبو الفضل فذكرت هذا الحديث ليحيى بن معين قال إنما هو أبو عثمان عن سلمان فقلت له ما نقول في الكتاب عن الحجاج قال نعم فاكتب عنه فإنه شيخ لا بأس به(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4247 - (@)(@@) حدثنا العباس قال حدثنا حجاج الفسطاطي قال حدثنا قرة بن خالد عن قتادة قال كان الحكم بن 
ms280	 أبي العاص يقرأ وهو الذي في السماء الله وفي الأرض إله(@)(@@)(@@)(@@) | 4248 - (@)(@@) سمعت يحيى يقول مرسلات الحسن ليس بها بأس(@)(@@)(@@)(@@) | 4249 - (@)(@@) سمعت يحيى يقول كهمس بن الحسن ليس هو الحسن البصري هو رجل أخر وقد روى إسماعيل بن علية عن عبد الله بن الحسن البصري(@)(@@)(@@)(@@) | 4250 - (@)(@@) قال يحيى محمد بن الحارث الذي يروى عنه عفان ليس بثقة(@)(@@)(@@)(@@) | 4251 - (@)(@@) والربيع بن بدر هو عليلة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4252 - (@)(@@) سمعت يحيى يقول عبد الرحمن أو عبيد الرحمن بن فضالة شك أبو الفضل أخو مبارك بن فضالة ليس به بأس يروى عنه عفان ووكيع بن الجراح(@)(@@)(@@)(@@) | 4253 - (@)(@@) سمعت يحيى يقول عبد الله بن بكر المزني ليس به بأس(@)(@@)(@@)(@@) | 4254 - (@)(@@) ودريك ليس به بأس(@)(@@)(@@)(@@) | 4255 - (@)(@@) سمعت يحيى يقول قد حدث داود بن أبي هند عن خلاس(@)(@@)(@@)(@@) | 4256 - (@)(@@) سمعت يحيى يقول وقلت له من أبو نهيك الذي يروى عنه قتادة فقال هو عندي الذي يروى عنه حسين بن واقد فإن لم يكن ذاك فلا أدري من هو أو نحو هذا من الكلام(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4257 - (@)(@@) سمعت يحيى بن معين يقول لم يسمع الحسن من علي بن أبي طالب شيئا قيل له سمع من عثمان بن عفان قال يقول في بعض الحديث رأيت عثمان قام خطيبا ويقال إنه رأى عثمان بن أبي العاص(@)(@@)(@@)(@@) | 4258 - (@)(@@) قيل ليحيى الحسن رأى بن عمر قال يذكرون في بعض الحديث قال قال الحسن دخلنا على بن عمر قال يحيى ولم يسمع الحسن من جابر بن عبد الله(@)(@@)(@@)(@@) | 4259 - (@)(@@) سمعت يحيى يقول أبو الجويرية حطان بن خفاف(@)(@@)(@@)(@@) | 4260 - (@)(@@) وأبو الرواع مجمع(@)(@@)(@@)(@@) | 4261 - (@)(@@) سمعت يحيى يقول حوشب صاحب الحسن حوشب بن مسلم(@)(@@)(@@)(@@) | 4262 - (@)(@@) ويحيى بن أبي كثير يكنى أبا النضر(@)(@@)(@@)(@@) | 4263 - (@)(@@) جهم الجد هو جهم بن دينار(@)(@@)(@@)(@@) | 4264 - (@)(@@) أبو المعلى العطار يحيى بن ميمون(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4265 - (@)(@@) سمعت يحيى يقول عبد الكريم أبو أمية البصري هو عبد الكريم بن أبي المخارق وابن جريج يروى عنه ويقول عبد الكريم بن أبي المخارق(@)(@@)(@@)(@@) | 4266 - (@)(@@) سمعت يحيى يقول الحارث بن عمير أبو عمير 