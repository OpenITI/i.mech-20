ms535	 وهب الهمداني عن أنس وجماعة وعنه إسرائيل وجماعة ثقة م د ق(@)(@@)(@@)(@@) | 4620- (@)(@@) قيس الجذامي عن عقبة بن عامر وعنه كثير بن مرة وغيره س(@)(@@)(@@)(@@) | 4621- (@)(@@) قيس أبو عمارة مولى الانصار عن عبد الله بن أبي بكر بن حزم وعنه معن وجماعة ثقة ق(@)(@@)(@@)(@@) | 4622- (@)(@@) قيس الكلابي عن النبي صلى الله عليه وسلم في الانبطاح عنه ابنه عطية س(@)(@@)(@@)(@@) | 4623- (@)(@@) قيس عن زيد بن ثابت وعنه ابنه محمد القاص س(@)(@@) PageV00P000(@)(@@)(@@)(@@) | حرف الكاف(@)(@@)(@@)(@@) | 4624- (@)(@@) كامل بن العلاء أبو العلاء التميمي الكوفي عن أبي صالح السمان وعطاء وطائفة وعنه أبو نعيم وعبد الله بن رجاء وخلق وثقه بن معين وقال النسائي ليس بالقوي د ت ق(@)(@@)(@@)(@@) | 4625- (@)(@@) كثير النواء الكوفي مولى بني تيم عن عطية العوفي وطائفة وعنه بن عيينة وطبقته شيعي جلد ضعفوه ومشاه بن حبان ت(@)(@@)(@@)(@@) | 4626- (@)(@@) كثير بن أفلح مولى أبي أيوب أحد كتاب المصاحف العثمانية سمع أنسا وعثمان وعنه الزهري مرسلا وابن سيرين وثقه النسائي س(@)(@@)(@@)(@@) | 4627- (@)(@@) كثير بن جمهان عن أبي هريرة وغيره وعنه عطاء بن السائب له في السعي قال أبو حاتم يكتب حديثه 4(@)(@@)(@@)(@@) | 4628- (@)(@@) كثير بن الحارث الدمشقي عن القاسم أبي عبد الرحمن وعنه معاوية بن صالح وجماعة قال أبو حاتم صالح الحديث ت(@)(@@)(@@)(@@) | 4629- (@)(@@) كثير بن زاذان عن عاصم بن ضمرة وعنه عنبسة قاضي الري وجماعة لا يثبت حديثه ت ق(@)(@@)(@@)(@@) | 4630- (@)(@@) كثير بن زياد العتكي بصري نزل بلخ عن أبي العالية وجماعة وعنه حماد بن زيد وجماعة وثقوه د ت ق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4631- (@)(@@) كثير بن زيد الاسلمي أبو محمد المدني عن المقبري وطائفة وعنه بن أبي فديك وآخرون قال أبو زرعة صدوق فيه لين د ت ق(@)(@@)(@@)(@@) | 4632- (@)(@@) كثير بن السائب عن أبناء قريظة وعنه عمارة بن خزيمة س(@)(@@)(@@)(@@) | 4633- (@)(@@) كثير بن سليم الضبي المدائني عن أنس والحسن وعنه العقدي وجبارة بن المغلس وطائفة ضعفوه ق(@)(@@)(@@)(@@) | 4634- (@)(@@) كثير بن شنظير الازدي عن مجاهد وطائفة وعنه عبد الوارث وعدة قال أبو زرعة لين وقال أحمد وغيره صالح الحديث خ م د ت ق(@)(@@)(@@)(@@) | 4635- (@)(@@) كثير بن الصلت الكندي أبو عبد 
ms536	 الله أخو زييد عن أبي بكر وعمر وعنه يونس بن جبير وغيره قيل له صحبة س(@)(@@)(@@)(@@) | 4636- (@)(@@) كثير بن العباس عن أبيه وأخيه عبد الله وعنه الزهري وجماعة وكان صالحا عابدا فقيها سيدا خ م د س(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4637- (@)(@@) كثير بن عبد الله بن عمرو بن عوف المزني المدني عن أبيه ونافع وعنه القعنبي وجماعة واه قال أبو داود كذاب د ت ق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4638- (@)(@@) كثير بن عبيد الحمصي أبو الحسن إمام الجامع عن بقية ونحوه وله معرفة ورحلة وعنه أبو داود والنسائي وابن ماجة وأبو عروبة د س ق(@)(@@)(@@)(@@) | 4639- (@)(@@) كثير بن عبيد عن عائشة وجماعة وعنه بن عون وجماعة وثق د(@)(@@)(@@)(@@) | 4640- (@)(@@) كثير بن فائد بصري عن ثابت وعنه أبو عاصم وغيره وثق ت(@)(@@)(@@)(@@) | 4641- (@)(@@) كثير بن فرقد المدني عن نافع وعنه مالك والليث وثق خ د س(@)(@@)(@@)(@@) | 4642- (@)(@@) كثير بن قاروندا عن سالم بن عبد الله وجماعة وعنه النضر بن شميل وعدة وثق س(@)(@@)(@@)(@@) | 4643- (@)(@@) كثير بن قليب الصدفي مصري عن عقبة بن عامر في السجود كما في بعض النسخ بالسنن د(@)(@@)(@@)(@@) | 4644- (@)(@@) كثير بن قيس ويقال قيس بن كثير ت عن أبي الدرداء في فضل العلم د ق(@)(@@)(@@)(@@) | 4645- (@)(@@) كثير بن كثير بن المطلب بن أبي وداعة عن أبيه وجماعة وعنه بن عيينة وجماعة ثقة شاعر خ د س ق(@)(@@)(@@)(@@) | 4646- (@)(@@) كثير بن أبي كثير عن مولاه عبد الرحمن بن سمرة وجماعة وعنه قتادة وجماعة وثق د ت س(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4647- (@)(@@) كثير بن مدرك عن علقمة والاسود وعنه منصور وجماعة وثق م د س(@)(@@)(@@)(@@) | 4648- (@)(@@) كثير بن مرة الحضرمي الحمصي عن معاذ والكبار وعنه خالد بن معدان ومكحول وخلق ثقة وقال النسائي لا بأس به 4(@)(@@)(@@)(@@) | 4649- (@)(@@) كثير بن المطلب بن أبي وداعة السهمي عن أبيه وعنه بنوه كثير وجعفر وسعيد ثقة د س ق كثير النواء مركثير النواء مر 4625(@)(@@)(@@)(@@) | 4650- (@)(@@) كثير بن هشام الرقي الكلابي صاحب جعفر بن برقان عن بندار والكوسج وخلق وثقه جماعة وقال أبو حاتم يكتب حديثه مات 207 م 4(@)(@@)(@@)(@@) | 4651- (@)(@@) كدام السلمي عن أبي كباش وعنه عثمان بن 
ms537	 واقد وأبو حنيفة ت(@)(@@)(@@)(@@) | 4652- (@)(@@) كردوس الثعلبي ويقال التغلبي عن بن مسعود وجماعة وعنه زياد بن علاقة وجماعة وقيل كردوس ثلاثة متعاصرون د س(@)(@@)(@@)(@@) | 4653- (@)(@@) كريب أبورشدين عن مولاه بن عباس وعائشة وعنه ابناه محمد ورشدين وموسى بن عقبة(@)(@@) وثقوه مات بالمدينة 98 ع(@)(@@)(@@)(@@) | 4654- (@)(@@) كعب بن ذهل وقيل بن زمل عن أبي الدرداء وعنه تمام بن نجيح وتمام واه مجهول د(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4655- (@)(@@) كعب بن عاصم الاشعري صحابي عنه أم الدرداء في الصيام س ق(@)(@@)(@@)(@@) | 4656- (@)(@@) كعب عن الحسن وعكرمة وعنه مسلم بن إبراهيم وغيره حديثه خطأ س(@)(@@)(@@)(@@) | 4657- (@)(@@) كعب بن عجرة من أصحاب الشجرة عن الشعبي وابن سيرين توفي 52 ع(@)(@@)(@@)(@@) | 4658- (@)(@@) كعب بن علقمة التنوخي المصري تابعي سمع بن المسيب وعدة وعنه الليث وطائفة توفي 13 م د ت س(@)(@@)(@@)(@@) | 4659- (@)(@@) كعب بن عمرو ويقال عمرو بن كعب اليامي يقال له صحبة روى طلحة بن مصرف عن أبيه عنه وهو جده في الوضوء د(@)(@@)(@@)(@@) | 4660- (@)(@@) كعب بن عمرو أبو اليسر السلمي بدري عنه موسى بن طلحة وجماعة توفي 55 بالمدينة م 4(@)(@@)(@@)(@@) | 4661- (@)(@@) كعب بن عياض الاشعري له صحبة عنه جبير بن نفير ت س(@)(@@)(@@)(@@) | 4662- (@)(@@) كعب الاحبار بن ماتع أبو إسحاق الحميري أسلم زمن الصديق وسمع عمر سكن الشام وعنه أبو هريرة وابن المسيب مات أيام عثمان خ د ت س(@)(@@)(@@)(@@) | 4663- (@)(@@) كعب بن مالك أحد الثلاثة عقبي من شعراء النبي صلى الله عليه وسلم عنه بنوه عبد الله وعبد الرحمن ومحمد توفي سنة خمسين ع(@)(@@)(@@)(@@) | 4664- (@)(@@) كعب بن مرة البهزي ويقال مرة بن كعب صحابي نزل الاردن عنه جبير بن نفير وأبو الاشعث الصنعاني مات بعد الخمسين 4(@)(@@)(@@)(@@) | 4665- (@)(@@) كعب أبو عامر عن أبي هريرة وعنه ليث بن أبي سليم ت ق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4666- (@)(@@) كلثوم بن جبر بصري عن بن الزبير وأنس وعنه الحمادان وعبد الوارث وثقوه وقال النسائي ليس بقوي مات 13 م س(@)(@@)(@@)(@@) | 4667- (@)(@@) كلثوم بن جوشن القشيري عن الحسن وعدة وعنه كثير بن هشام وطائفة قال أبو داود منكر الحديث ق(@)(@@)(@@)(@@) | 4668- (@)(@@) كلثوم بن المصطلق عن النبي صلى الله عليه وسلم 
ms538	 قيل له صحبة وعنه الزبير بن عدي وجماعة وثق د س ق(@)(@@)(@@)(@@) | 4669- (@)(@@) كلدة بن الحنبل أخو صفوان بن أمية لامه له صحبة وعنه أمية بن صفوان د ت س(@)(@@)(@@)(@@) | 4670- (@)(@@) كليب بن ذهل مصري عن عبيد بن جبر وعنه يزيد بن أبي حبيب وثق د(@)(@@)(@@)(@@) | 4671- (@)(@@) كليب بن شهاب الجرمي عن أبيه وعمر وعدة وعنه ابنه عاصم وغيره وثق 4(@)(@@)(@@)(@@) | 4672- (@)(@@) كليب بن صبح عن عقبة بن عامر وغيره وعنه جعفر بن ربيعة وغيره وثقه بن معين د(@)(@@)(@@)(@@) | 4673- (@)(@@) كليب بن منفعة عن جده وعنه الحارث بن مرة وضمضم بن عمرو بصري وسط د(@)(@@)(@@)(@@) | 4674- (@)(@@) كليب بن وائل التيمي البكري عن بن عمر وجماعة وعنه حفص بن غياث وطائفة قال أبو داود ليس به بأس وضعفه أبو زرعة خ د ت(@)(@@)(@@)(@@) | 4675- (@)(@@) كليب الجهني جد عثيم بن كثير عنه حفيده د(@)(@@)(@@)(@@) | 4676- (@)(@@) كناز بن الحصين أبو مرثد الغنوي بدري عنه واثلة بن الاسقع حديث لا تصلوا إلى القبور مات 12 م د ت س(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4677- (@)(@@) كنانة بن العباس بن مرداس السلمي عن أبيه وعنه ابنه عبد الله قال البخاري لم يصح حديثه د ق(@)(@@)(@@)(@@) | 4678- (@)(@@) كنانة بن نعيم العدوي عن أبي برزة وغيره وعنه ثابت وعبد العزيز بن صهيب وثق م د س(@)(@@)(@@)(@@) | 4679- (@)(@@) كنانة عن مولاته صفية وعثمان وعنه زهير بن معاوية ومحمد بن طلحة وجماعة وثق ت(@)(@@)(@@)(@@) | 4680- (@)(@@) كهمس بن الحسن التميمي عن أبي الطفيل وجماعة وعنه وكيع والمقرئ وخلق ثقة مات 149 ع(@)(@@)(@@)(@@) | 4681- (@)(@@) كهمس بن المنهال السدوسي اللؤلؤي عن بن أبي عروبة وجماعة وعنه خليفة بن خياط(@)(@@) وغيره قال أبو حاتم يكتب حديثه خ(@)(@@)(@@)(@@) | 4682- (@)(@@) كلاب بن تليد عن بن المسيب وعنه عبد الله بن مسلم وثق س(@)(@@)(@@)(@@) | 4683- (@)(@@) كلاب بن علي عن أبي سلمة وعنه يحيى بن أبي كثير س(@)(@@)(@@)(@@) | 4684- (@)(@@) كيسان بن جرير صحابي عنه ابنه عبد الرحمن ق(@)(@@)(@@)(@@) | 4685- (@)(@@) كيسان أبو سعيد المقبري عن عمر وأبي هريرة وعنه ابنه سعيد وجماعة مات سنة مائة ع(@)(@@) PageV00P000(@)(@@)(@@)(@@) | حرف اللام(@)(@@)(@@)(@@) | 4686- (@)(@@) لجلاج العامري له صحبة عنه ابناه خالد والعلاء وغيرهما د ت س 
ms539	(@)(@@)(@@)(@@) | 4687- (@)(@@) لقمان بن عامر الحمصي عن أبي أمامة وطائفة وعنه الزبيدي وجماعة قال أبو حاتم يكتب حديثه د س(@)(@@)(@@)(@@) | 4688- (@)(@@) القيط بن عامر بن صبرة أبو رزين العقيلي صحابي عنه ابنه عاصم وجماعة 4(@)(@@)(@@)(@@) | 4689- (@)(@@) لمازة بن زبار أبو لبيد الجهضمي عن عمر وعلي وعنه جرير بن حازم وجماعة فيه نصب وثق د ت ق(@)(@@)(@@)(@@) | 4690- (@)(@@) لهيعة بن عقبة عن سفيان بن وهب الخولاني وعنه يزيد بن أبي حبيب وجماعة وثق مات سنة مائة ق(@)(@@)(@@)(@@) | 4691- (@)(@@) الليث بن سعد أبو الحارث الامام مولى بني فهم سمع عطاء وابن أبي مليكة ونافعا وعنه قتيبة ومحمد بن رمح وأمم ثبت من نظراء مالك قيل كان مغله في العام ثمانين ألف دينار فما وجبت عليه زكاة عاش إحدى وثمانين سنة مات 175 في شعبان ع(@)(@@)(@@)(@@) | 4692- (@)(@@) ليث بن أبي سليم أبو بكر القرشي مولاهم الكوفي عن مجاهد وطبقته لا نعلمه لقي صحابيا وعنه شعبة وزائدة وجرير فيه ضعف يسير من سوء حفظه كان ذا صلاة وصيام وعلم كثير وبعضهم احتج به مات 4 138 م مقرونا(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4693- (@)(@@) ليث بن عاصم أبو زرارة القتباني المصري عن بن عجلان وطبقته وعنه يونس بن عبد الاعلى(@)(@@) وجماعة مات 211 عن ست وتسعين سنة صالح س(@)(@@) 0)(@)(@@) PageV00P000(@)(@@)(@@)(@@) | حرف الميم(@)(@@)(@@)(@@) | 4694- (@)(@@) محمد بن أبان بن وزير البلخي أبو بكر مستملي وكيع روى عنه الجماعة سوى مسلم وابن خزيمة وخلق حجة صنف وجمع مات 244 خ 4(@)(@@)(@@)(@@) | 4695- (@)(@@) محمد بن إبراهيم التيمي المدني أبو عبد الله الفقيه عن عائشة وأبي سعيد وعنه يحيى بن سعيد والاوزاعي وخلق وثقوه وقال أحمد روى مناكير مات 12 ع(@)(@@)(@@)(@@) | 4696- (@)(@@) محمد بن إبراهيم بن دينار المدني الفقيه عن موسى بن عقبة وطبقته وعنه أبو مصعب وجماعة قال بن عبد البر كان مفتي المدينة مع مالك وقال أبو حاتم ثقة مات 182 خ(@)(@@)(@@)(@@) | 4697- (@)(@@) محمد بن إبراهيم بن سليمان أبو جعفر الاسباطي الكوفي عن المطلب بن زياد وجماعة وعنه أبو داود وابن أبي داود صدوق مات 248 د(@)(@@)(@@)(@@) | 4698- (@)(@@) محمد بن إبراهيم بن صدران المؤذن أبو جعفر 
ms540	 بصري عن يزيد بن زريع وعدة وعنه أبو داود والترمذي والنسائي وابن خزيمة وثق توفي 247 د ت س محمد بن إبراهيم بن طلحة عن عبد الله بن عمرو صوابه إبراهيم بن محمد بن طلحة كما مضى محمد بن إبراهيم بن طلحة عن عبد الله بن عمرو صوابه إبراهيم بن محمد بن طلحة كما مضى س 19(@)(@@)(@@)(@@) | 4699- (@)(@@) محمد بن أبي شيبة إبراهيم بن عثمان العبسي عن أبيه والاعمش وعنه بنوه أبو بكر وعثمان والقاسم وثقه بن معين مات 182 س(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4700- (@)(@@) محمد بن إبراهيم بن أبي عدي أبو عمرو بصري ثقة سمع حميدا وطبقته وعنه أحمد بن سنان وعدة مات 194 ع(@)(@@)(@@)(@@) | 4701- (@)(@@) محمد بن إبراهيم بن العلاء الشامي السائح عن إسماعيل بن عياش ونحوه وعنه بن ماجة وأبو يعلى وجماعة كذبه الدارقطني ق(@)(@@)(@@)(@@) | 4702- (@)(@@) محمد بن إبراهيم بن مسلم بن مهران وهو محمد بن مسلم ومحمد بن مهران ومحمد بن أبي المثنى سمع سلمة بن كهيل وجماعة وعنه الطيالسيان وجماعة لم يضعف د ت س(@)(@@)(@@)(@@) | 4703- (@)(@@) محمد بن إبراهيم بن المطلب السهمي عن أبيه وعنه إبراهيم بن المنذر وغيره وثق ق(@)(@@)(@@)(@@) | 4704- (@)(@@) محمد بن إبراهيم الباهلي عن محمد بن زيد وعنه جهضم بن عبد الله ت ق محمد بن إبراهيم عن أبي هريرة وعنه يحيى بن أبي كثير فهذا التيمي وبينه وبين أبي هريرة عبد الرحمن بن يعقوب قاله النسائي محمد بن إبراهيم عن أبي هريرة وعنه يحيى بن أبي كثير فهذا التيمي وبينه وبين أبي هريرة عبد الرحمن بن يعقوب قاله النسائي 4695(@)(@@)(@@)(@@) | 4705- (@)(@@) محمد بن أحمد بن حسين بن مدويه الترمذي عن جعفر بن عون وخلق وعنه الترمذي وابن أبي داود ت(@)(@@)(@@)(@@) | 4706- (@)(@@) محمد بن أحمد بن أبي خلف القطيعي عن بن عيينة وجماعة وعنه مسلم وأبو داود والسراج وثقه أبو حاتم مات 236 م د(@)(@@)(@@)(@@) | 4707- (@)(@@) محمد بن أحمد بن الحجاج أبو يوسف الصيدلاني الرقي الحافظ عن بن عيينة وطبقته(@)(@@) PageV00P000(@)(@@) وعنه النسائي وابن ماجة وأبو حاتم وقال صدوق وأبو عروبة مات 246 س ق 