ms601	 سهم عقاب تیر در چرخ %~% نسرین‌ فلک شوند بسمل(@)(@@) 51 االبیض علی الرؤس تغلی %~% بالبیض کانها مراجل(@)(@@) 52 تهتز اسنه العوالی %~% بالجو کانها سنابل(@)(@@) 53 الوحش ینحن کالنوائح %~% والطیر یصحن کالثواکل(@)(@@) 54 الرمح حشا الرجال یفری %~% باطعن کالسن العواذل(@)(@@) 55 من صوت سنابک المذاکی %~% من وقع حوافر الهیاکل(@)(@@) 56 ترتح علی الثری الصیاصی %~% تنحط علی الربی الجنادل(@)(@@) 57 الرمح تمد کالافاعی %~% والقوس ترن کالهوابل(@)(@@) 58 فی راس عدوک المنازع %~% فی‌کف حسودک المناصل(@)(@@) 59 تبیض لبأسک المفارق %~% تصفر لبطشک الانامل(@)(@@) 60 بندی سر دشمنان به فتراک %~% چون رشته به فلکه مغازل(@)(@@) 61 بازوی نزار ملک و دین را %~% فربه سازی به سیف ناحل(@)(@@) 62 ای عم شهنشه مکرم %~% ای بأس تو همچو مرگ هایل(@)(@@) 63 گر فیض قبول خاطرت را %~% حالی شود این قصیده قابل(@)(@@) 64 شاید که به مدحتش سرایند %~% لم یأت بمثلها الاوایل(@)(@@) 65 وز فضل تو اهل عصر خوانند %~% قاآنی را ابوالفضایل(@)(@@) 66 تا چاره مطلقات را نیست %~% بعد از سه طلاق از محلل(@)(@@) 67 از حلیه بخت تو مبادا %~% یک لحظه عروس ملک عاطل(@)(@@) 68 تا منطقه در دو نقطه دارد %~% پیوسته تماس با معدل(@)(@@) 69 از منطقه جلالت تو %~% خورشید شرف مباد مایل(@)(@@) 70 تا حشر رسد خطابت از عرش %~% ای فال سعید و بخت مقبل PageV1P292(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای رخش ره‌نورد من ای مرغ تیزبال %~% کز دودمان برقی و از تخمه خیال(@)(@@) 2 در طبع سیر تست سبکباری نسیم %~% در جیب نعل تست نسب‌نامه شمال(@)(@@) 3 گه مغز که بدری بی‌جهد گاز و چنگ %~% گه در هوا بپری بی‌سعی پر و بال(@)(@@) 4 تاکی هوای آخور آخر برون خرام %~% تات از پی رحیل به کوهان نهم رحال(@)(@@) 5 بشتاب و مغز باد مشوش‌ کن از مسیر %~% بخرام و لوح خاک منقش کن از نعال(@)(@@) 6 دم بر فراز و مغز فلک را یکی بکوب %~% سیم برفشان و ناف زمین را یکی بمال(@)(@@) 7 ز اصطبل 
ms602	 طبل عزم فروکوب و شو برون %~% تا ز آب دیده‌ گرد فرو شویمت ز یال(@)(@@) 8 ای نایب براق بپیماره عراق %~% کایدون مرا به فارس اقامت بود محال(@)(@@) 9 تا چند خورد باید اندوه آب و نان %~% تا چند برد باید تیمار عم و خال(@)(@@) 10 لا ترجلن یا ملک الخیل و اعجلن %~% کم عجله ینال بها المر لاینال(@)(@@) 11 آهنگ شهر قم ‌کن ‌گم ‌کن ز پارس پی %~% قم قبل ان یضیق لنا الوقت و المجال(@)(@@) 12 رو کن به حضرتی که ندانسته جود او %~% در از صدف‌ گهر ز خزف‌ گوهر از سفال(@)(@@) 13 کهن امان پناه زمان ‌گوهر شرف %~% غیث‌کرم غیاث امم جوهر نوال(@)(@@) 14 فهرست آفرینش و سرمایه وجود %~% عنوان حکمرانی و دیباچه جلال(@)(@@) 15 برهان دین و داد فریدون شه آنکه هست %~% قسطاس فهم و فکرت مقیاس فر و فال(@)(@@) 16 بی ‌عون مهر او نبود بخت را اثر %~% بی‌زیب عدل او نبود ملک را جمال(@)(@@) 17 خاک از نهیب خنجر او یابد ارتعاش %~% آب از نهیب ناچخ او دارد اشتعال(@)(@@) 18 با مهر او ضلال مخلد بود رشاد %~% با قهر او رشاد موید بود ضلال(@)(@@) 19 جز از طریق وهم نیابد کسش نظیر %~% جز بر سبیل فرض نیابد کسش همال(@)(@@) 20 ای‌ کت به تحفه تاج سپارد همی تکین %~% ای‌ کت به هدیه باج فرستد همی ینال(@)(@@) 21 روزی دهد عطای تو بی ‌دعوت امید %~% پاسخ دهد سخای تو بی‌سقبت سوال(@)(@@) 22 منشور روی و رای تو در جیب مهر و ماه %~% توقیع امر و نهی تو در دست ماه و سال(@)(@@) 23 امر ترا به طوع قدر دارد استماع %~% حکم ترا به طبع قضا دارد امتثال(@)(@@) 24 در پیش ابر اگر ز سخایت رود سخن %~% پیشانیش عرق‌کند از فرط انفعال(@)(@@) 25 ور بر زگال تیره فتد عکس تیغ تو %~% از تف آن چو دوزخ سوزان شود زگال(@)(@@) 26 آنجا که شخص تست مجسم 
ms603	 بود هنر %~% آنجاکه طبع تست مصور شود کمال(@)(@@) 27 رسوا شود حسود تو در هرکجا که هست %~% چون دزد شب که ناگه درگیردش سعال(@)(@@) 28 با ترکتاز جود تو نشگفت اگر ز بیم %~% پنهان‌کند پشیزه خود را به بحر وال(@)(@@) 29 گیهان محیط تست و به معنی محاط تو %~% برسان جامه ‌کاو به بدن دارد اشتمال(@)(@@) 30 چرخ از غبار خنگ تو تاریک چون جحیم %~% کوه از نهیب رمح تو باریک چون خلال(@)(@@) 31 از بسکه بار فتح و ظفر می‌کشد به دوش %~% تیغت خمیده پشت نماید به شکل دال(@)(@@) 32 روز وغا که از دم شمشیر سرفشان %~% درگام اکدشان متوقد شود نعال(@)(@@) 33 ازگرذ ره چو توده قطران شود سپهر %~% از رنگ خون چو سوده مرجان شود رمال(@)(@@) 34 زانبوه‌گرد رخش محدب شود وهاد %~% زاسیب نعل اسب مقعر شود تلال(@)(@@) 35 چنگال شیر شرزه نداند کس از سیوف %~% دندان مارگرزه نداند کس از نبال(@)(@@) 36 از نعل اسبها متحرک شود زمین %~% بر چوب نیزها متوقد شود نصال(@)(@@) 37 هرگه‌که میغ تیغ تو آتش‌فشان شود %~% کس پور زال را نشناسد ز پیر زال(@)(@@) 38 مغز ستاره بر دری از تیغ فتنه‌سوز %~% کتف زمانه بشکنی از گرز مرد مال(@)(@@) 39 فرماندها مها ملکا ملک‌پرورا %~% آن‌کیست غیر حق‌که قدیمست و لایزال(@)(@@) 40 ایدون گرت ز چرخ گزندی رسد مرنج %~% ایدر گرت ز دهر ملالی رسد منال(@)(@@) 41 بس عیش و عشر تا که نماند به هیچ روی %~% بس رنج و اندها که نماند به هیچ حال(@)(@@) 42 مه را به چرخ‌گاه فرازست وگه نشیب %~% جان را به جسم گاه نشاطست و گه ملال(@)(@@) 43 نی زار نالد آنگه از جان برد محن %~% می تلخ‌ گردد آن‌ گه از دل برد کلال(@)(@@) 44 خورشیدسان زوالی اگر یافتی مرنج %~% جاوید می‌نماند خورشید را زوال(@)(@@) 45 ور کوکبت قرین وبالست غم مخور %~% وقتی به سوی خانه خویش آید از وبال(@)(@@) 46 سلطان برای مصلحتی بود 
ms604	 اگر ترا %~% روزی دو ساخت معتکف ‌کنج اعتزال(@)(@@) 47 زر آن زمان عزیزتر آید که ناقدی %~% بگدازدش به بوته و بگذاردش بقال(@)(@@) 48 فولاد راگداز دهند از برای آنک %~% شمشیر از آن‌کنند پی دفع بدسگال(@)(@@) 49 تو تیر شست شاهی از آنت رها نمود %~% تا خصم را دهد ز نهیب توگوشمال(@)(@@) 50 وافکند چون شهاب ترا از سپهر ملک %~% تا سوزد از تو دیوصفت خصم بدفعال(@)(@@) 51 پیراست شاخ و برگ ترا چون نهال از آنک %~% ریزد چو شاخ و برگ قوی‌تر شود نهال(@)(@@) 52 شه آفتاب مملکتست و تو ماه نو %~% هم بدر ازو شوی اگر از وی شدی هلال(@)(@@) 53 حکم ملک قضاست رضا ده به حکم او %~% هم خیر ازو رسد اگر از وی رسد نکال(@)(@@) 54 شاه آنچه می‌کند همه از روی حکمتست %~% حالی مباش رنجه‌که نیکو شود مآل(@)(@@) 55 ای بس جراحتا که برو نیشتر زنند %~% تا خون مرده خیزد و بپذیرد اندمال(@)(@@) 56 شاگرد کاوستادش سیلی زند به روی %~% خواهد معذبش ‌که مهذب‌ کند خصال(@)(@@) 57 داروی‌تلخ را نخورد خسته جز به‌عنف %~% وان تلخ با حلاوت جان دارد اتصال(@)(@@) 58 نشتر زند پزشک به قیفال دردمند %~% کز دفع خون مزاج ‌گراید به اعتدال(@)(@@) 59 آید به چشم من‌که مهی بیش نگذرد %~% کت شه به حکمرانی ملکی دهد مثال(@)(@@) 60 ای‌کز هوای مدح تو در حالتند و رقص %~% افکار در ضمایر و ابکار در حجال(@)(@@) 61 داند خدا که بود جدا از تو حال من %~% چون حال تشنه‌بی که جدا ماند از زلال(@)(@@) 62 ای بس‌که قامتم از مویه همچو موی بود %~% ای بس ‌که ‌گشت پیکرم از ناله همچو نال(@)(@@) 63 خونم بریخت دست فراقت اگرچه نیست %~% الا به‌ کیش تیر تو خون ریختن حلال(@)(@@) 64 جز من‌ که بار هجر تو بردم به جان و دل %~% کاهی شنیده‌ای‌ که ‌کند کوهی احتمال(@)(@@) 65 منت خدای را که رسیدم به‌ کام دل %~% زان نقمت 
ms605	 فراق بدین نعمت وصال(@)(@@) 66 حالی چو اخرسی ‌که اشارت‌ کند به دست %~% با صد زبان زبان من از مدح تست لال(@)(@@) 67 ارجو که مدح من بگزینی به مدح غیر %~% کز اشهد فصیح بهست اسهد بلال(@)(@@) 68 سیم و زرم نبود که آرمت هدیه‌ای %~% بپذیر جای هدیه من باری این مقال(@)(@@) 69 دانی‌ که از تو بود گرم بود سیم و زر %~% دانی ‌که از تو بود گرم بود جاه و مال(@)(@@) 70 تا راه دل زنند نکویان به روی و موی %~% تا صید جان‌کنند نکویان به خط و خال(@)(@@) 71 چون روی یار یار ترا تازه باد عیش %~% چون خال دوست خصم ترا تیره ‌باد حال PageV1P293(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 بیا و ساغر می‌ کن ز باده مالامال %~% که ماه روزه به حسرت ‌گذشت نالانال(@)(@@) 2 بباید از غم و انده ‌گریخت میلامیل %~% می دو ساله به پیمانه ریخت مالامال(@)(@@) 3 بنوش باده و نوشان به یاد رحمت حق %~% که فضل بار خدا شاملست در همه حال(@)(@@) 4 به آب باده غبار دل از پیاله بشوی %~% که هست در دلت اندک ز روزه گرد ملال(@)(@@) 5 مرا ز عید خوش آمد که هست روزه حرام %~% نه‌ بلکه خوشترم از آنکه هست بوسه حلال(@)(@@) 6 کنون به بدرقه روزه باده باید خورد %~% به عذر آنکه نکردیمش از چه استقبال(@)(@@) 7 همیشه باده‌ گوارا و دلپذیر بود %~% خصوص آخر شعبان و غره شوال(@)(@@) 8 مرا ز روزه جز این دل‌خوشی نبد که به عید %~% کنم معانقه با آن غزل‌ سرای غزال(@)(@@) 9 مرا به طبع خوش آید ز روز عید که عید %~% بهانه‌ایست نکو بهر بوسه اطفال(@)(@@) 10 چه مایه طفل سمنبر که با هزار حیل %~% خیال بوسه او مر مرا نمود محال(@)(@@) 11 کنون خود آید و لب بهر بوسه باز کند %~% چو سایلی‌ که‌ گشاید کف از برای سؤال(@)(@@) 12 خصوص ترک من آن ساده‌لوح سیمین‌بر %~% که وقف بوسه 
ms606	 نمود دست روی زهره‌ مثال(@)(@@) 13 ز پای تا به سرش هر کجا که می‌بینی %~% گمان بری که بدانجا نزول کرده جمال(@)(@@) 14 ز بسکه‌بوسه‌ز دستم‌به‌هر دو عارض او %~% ز نقش بوسه رخش‌ گشته پر وهاد و تلال(@)(@@) 15 به احتیاط چنان بوسمش دو تنگ شکر %~% که بر زمین نچکد زان دو تنگ یک مثقال(@)(@@) 16 درون مشت چو گیرم سرین سیمینش %~% گمان‌ کند که بپا اندرش کنم خلخال(@)(@@) 17 مرا از آن بت شیرین حکایتیست عجیب %~% بیا و بشنو و عبرت بگیر ازین تمثال(@)(@@) 18 ز من چو آهوی رم‌دیده پار وحشی بود %~% به زهد و زرق و ریا رام‌ کردمش امسال(@)(@@) 19 بساط زهد و ریا را چنان بگستردم %~% که هر که دید مرا خیره ماند از آن احوال(@)(@@) 20 به جبهه داغ نهادم چو زاهد سالوس %~% به دست سبحه‌ گرفتم چو واعظ محتال(@)(@@) 21 حکایتم همه از فضل زهد بود و ورع %~% روایتم همه از علم فقه بود و رجال(@)(@@) 22 گهی حدیث ‌کرامات ‌گفتم و معجز %~% گهی بیان احادیث کردم و اقوال(@)(@@) 23 پی مراقبه گه سر نهاده بر زانو %~% پی مکاشفه‌ گه پشت ‌کرده بر دیوال(@)(@@) 24 گهی صحیفه و زادالمعاد اندر پیش %~% که جز دعا نگشایم‌ زبان به هیچ مقال(@)(@@) 25 نموده‌ گه به تلاوت قرات قرآن %~% شمرده‌ گه به فصاحت فضیلت ابدال(@)(@@) 26 گمان نموده پس از چند روز دلبر من %~% که مر مرا به ورع در زمانه نیست همال(@)(@@) 27 بسان سایه مر آن ترک آفتاب جبین %~% به هرکجاکه شدم می‌دویدم از دنبال(@)(@@) 28 به صبح عید صیام از پی مبارکباد %~% دوان به‌سوی من آمد چو مه به برج و بال(@)(@@) 29 بغل گشودم و از روی مکر و شید و حیل %~% بر او به لحن عرب بانگ برزدم‌ که تعال(@)(@@) 30 دوید و آمد و بنشست و دست من بوسید %~% عنان صبر من از دست برد شوق وصال(@)(@@) 31 به برکشیدم 
