ms41	 إلى جز قرية بأصبهان وجد.(@)(@@)(@@)(@@) || باب الجيم والسين(@)(@@)(@@)(@@) $DIC_NIS$ الجسيري (@)(@@) بالفتح والسكون إلى جسر بطن من عنزة وقضاعة وغيرهما.(@)(@@)(@@)(@@) || باب الجيم والشين(@)(@@)(@@)(@@) $DIC_NIS$ الجشمي (@)(@@) بالضم وفتح المعجمة إلى جشيم من الأنصار وغيرهم.(@)(@@)(@@)(@@) $DIC_NIS$ الجشنسي (@)(@@) بكسر أوله والنون وسكون المعجمة آخره مهملة إلى جشنس جد.(@)(@@)(@@)(@@) $DIC_NIS$ الجشيبي (@)(@@) بالفتح والكسر آخره موحدة إلى جشيبة من بني سامة بن لؤي وجشيب جد.(@)(@@)(@@)(@@) $DIC_NIS$ الجشيشي (@)(@@) بمعجمتين مصغرا إلى جشيش عدة بطون.(@)(@@)(@@)(@@) || باب الجيم والصاد(@)(@@)(@@)(@@) $DIC_NIS$ الجصيني (@)(@@) بالفتح وتشديد المهملة المكسورة إلى جصين محلة بمرو.(@)(@@)(@@)(@@) || باب الجيم والعين(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الجعبري (@)(@@) إلى جعبر بوزن جعفر وموحدة قلعة على الفرات بين بالس والرقة انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الجعدي (@)(@@) بالفتح والسكون إلى جعدة بطن والجعد جد وإلى مذهب الجعد بن درهم.(@)(@@)(@@)(@@) $DIC_NIS$ الجعفري (@)(@@) إلى جعفر بن أبي طالب وجعفر بن كلاب بن ربيعة بن عامر بن صعصعة وجعفر بن مبشر رأس الجعفرية من المعتزلة وجعفر بن ثعلبة بطن من يربوع وجد قلت: وإلى الجعفرية محلة ببغداد وقرية بمصر أيضا انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الجعفي (@)(@@) بالضم والسكون إلى جعفي بن سعد العشيرة من مذحج إليه البخاري ولاء.(@)(@@)(@@)(@@) $DIC_NIS$ الجعلي (@)(@@) بالضم وفتح المهملة إلى بني جعل.(@)(@@)(@@)(@@) || باب الجيم والغين(@)(@@)(@@)(@@) $DIC_NIS$ الجغوني (@)(@@) بالفتح وضم المعجمة إلى جد.(@)(@@)(@@)(@@) $DIC_NIS$ الجغلاني (@)(@@) بالضم وسكون المعجمة إلى جغلان جد.(@)(@@)(@@)(@@) || باب الجيم والفاء(@)(@@)(@@)(@@) $DIC_NIS$ الجفري (@)(@@) بالفتح وسكونه الفاء إلى جفر ناحية بالمدينة وبالضم إلى جفرة خالد بالبصرة.(@)(@@)(@@)(@@) || باب الجيم والكاف(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الجكاني (@)(@@) إلى جكان بالفتح والتشديد محلة بهراة انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الجكواني (@)(@@) بالضم وسكون الكاف إلى جكوان قرية بسجستان قلت: قال ياقوت بالراء بدل الواو على الأصح انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الجكلي (@)(@@) بكسرتين وتشديد اللام إلى جكل بدل من بلاد الترك.(@)(@@)(@@)(@@) || باب الجيم واللام(@)(@@)(@@)(@@) $DIC_NIS$ الجلختجاني (@)(@@) بضم أوله والفوقية وفتح اللام والجيم الأخيرة وسكون الخاء المعجمة إلى جلختجان قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الجلختي (@)(@@) بفتحتين وسكون المعجمة وفوقية إلى الجلخت جد.(@)(@@)(@@)(@@) $DIC_NIS$ الجلدي (@)(@@) بالفتح والسكون إلى جلد بن سعد العشيرة.(@)(@@)(@@)(@@) $DIC_NIS$ الجلسي (@)(@@) بالكسر والسكون إلى جلس، بطن من السكون.(@)(@@)(@@)(@@) $DIC_NIS$ الجلفري (@)(@@) بالضم والسكون 
ms42	 وفتح اللام المشددة وقاف قلت: قال ياقوت بكسرتين إلى الجلق قيل PageV01P065(@)(@@) اسم لدمشق وقيل لكورتها وقيل موضع بها انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الجلكي (@)(@@) بالضم وفتح اللام المخففة إلى جلك قرية بأصبهان.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الجللتاني (@)(@@) بضم أوله واللام وسكون الثانية وتخفيف الفوقية إلى جللتا قرية بالنهروان انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الجلواباذي (@)(@@) بفتح أوله والواو والموحدة وسكون اللام آخره معجمة إلى جلواباذ قرية بهمذان.(@)(@@)(@@)(@@) $DIC_NIS$ الجلودي (@)(@@) بضمتين ومهملة وقيل بفتح أوله إلى الجلود المعروفة وجلود قرية بإفريقية.(@)(@@)(@@)(@@) $DIC_NIS$ الجلولتيني (@)(@@) بفتح أوله واللام الثانية والفوقية بعدها وضم الواو وسكون التحتية بعدها نون إلى جلولتين قرية بالنهروان.(@)(@@)(@@)(@@) $DIC_NIS$ الجليقي (@)(@@) بالفتح والكسر إلى جليقة بلد بالروم.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الجليلي (@)(@@) مكبرا إلى جبل الجليل من عمل صيداء انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الجليني (@)(@@) بالضم وكسر اللام المشددة وتحتية ونون إلى جلين جد.(@)(@@)(@@)(@@) $DIC_NIS$ الجلي (@)(@@) بالكسر والتشديد.(@)(@@)(@@)(@@) || باب الجيم والميم(@)(@@)(@@)(@@) $DIC_NIS$ الجماجمي (@)(@@) بالفتح والتخفيف وكسر الجيم الثانية إلى جماجم سمكة بجرجان.(@)(@@)(@@)(@@) $DIC_NIS$ الجمازي (@)(@@) بالفتح والتشديد وزاي إلى جماز جد.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الجماعيلي (@)(@@) بالفتح والتشديد والعين مهملة إلى جماعيل بأرض فلسطين انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الجمالي (@)(@@) بالفتح والتخفيف إلى من لقب بالجمال.(@)(@@)(@@)(@@) $DIC_NIS$ الجمامي (@)(@@) بالفتح والتشديد إلى جمام بطن من حمير.(@)(@@)(@@)(@@) $DIC_NIS$ الجماني (@)(@@) بالضم والتشديد ونون إلى طول الجمة. PageV01P066(@)(@@)(@@)(@@) $DIC_NIS$ الجمحي (@)(@@) بالضم والفتح ومهملة إلى بني جمح بطن من قريش.(@)(@@)(@@)(@@) $DIC_NIS$ الجمدي (@)(@@) بالفتح والسكون ومهملة إلى جمد بن معدي كرب.(@)(@@)(@@)(@@) $DIC_NIS$ قلت (@)(@@) وبفتحتين إلى جمد قرية ببغداد انتهي وبالراء إلى بني جمرة بطن من ضبة ومن تميم ومن الأزد وجد.(@)(@@)(@@)(@@) $DIC_NIS$ الجملي (@)(@@) بفتحتين إلى جمل بن كنانة قلت: وإلى جمل قرية ببغداد انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الجميلي (@)(@@) مكبرا إلى جميل جد ودرب جميل ببغداد.(@)(@@)(@@)(@@) || باب الجيم والنون(@)(@@)(@@)(@@) $DIC_NIS$ الجنابذي (@)(@@) بالضم وفتح النون والموحدة ثم معجمة إلى جنابذ ويقال: كونابذ قرية بنيسابور.(@)(@@)(@@)(@@) $DIC_NIS$ الجنابي (@)(@@) بالفتح وقيل الضم وتشديد النون آخره موحدة إلى جنابة بلد بالبحرين وبالفوقية إلى جنات جد.(@)(@@)(@@)(@@) $DIC_NIS$ الجناحي (@)(@@) إلى ذي الجناحين جعفر بن أبي طالب والجناحية قوم من الشيعية ينسبون إلى حفيد ابنه عبد الله.(@)(@@)(@@)(@@) $DIC_NIS$ الجناري 
ms43	 (@)(@@) بالكسر وتخفيف النون وراء إلى جنارة قرية بين سارية واستراباذ.(@)(@@)(@@)(@@) $DIC_NIS$ الجنائزي (@)(@@) إلى الجنائز المعروفة.(@)(@@)(@@)(@@) $DIC_NIS$ الجنبذي (@)(@@) بالضم وسكون النون وفتح الموحدة ومعجمة إلى جنبذ شبه أزج مدور قلت: هو معنى اللفظ ولكنه اسم لقرية بنيسابور انتهى. PageV01P067(@)(@@)(@@)(@@) $DIC_NIS$ الجندبي (@)(@@) بالضم وفتح المهملة إلى جندب بن الحارث.(@)(@@)(@@)(@@) $DIC_NIS$ الجنبي (@)(@@) إلى جنب بلفظ شق الإنسان قبيلة من اليمن.(@)(@@)(@@)(@@) $DIC_NIS$ الجنجروذي (@)(@@) بفتح الجيمين وسكون النون وضم الراء ومعجمة إلى جنجروذ قرية بنيسابور ويقال كنجروذ.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الجنجيالي (@)(@@) بكسر الجيمين وسكون النون بينهما وتخفيف التحتية إلى جنجيال بلد بالأندلس.(@)(@@)(@@)(@@) $DIC_NIS$ والجنجيلي (@)(@@) بضبطه لكن بفتح أوله وسكون التحتية إلى جنجيلة مدينة بالأندلس أيضا انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الجندبي (@)(@@) مر بعد: الجنبذي.(@)(@@)(@@)(@@) $DIC_NIS$ الجندعي (@)(@@) بالضم وسكون النون وفتح المهملة ثم مهملة إلى جندع بطن من ليث.(@)(@@)(@@)(@@) $DIC_NIS$ الجندفرجى (@)(@@) بالضم وسكون النون والرا وفتح المهملة والفا اخره جيم الى جندفرج قرية بنيسابور.(@)(@@) الجند فرقاني: بضبطه وبعد الراء قاف والفاء ونون إلى جندفرقان قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الجنديني (@)(@@) بالضم والسكون إلى جندين قرية بهمذان انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الجنديسابوري (@)(@@) بضبطه وسكون التحتية ومهملة وموحدة مضمومة وراء إلى جنديسابور مدية بخوزستان.(@)(@@)(@@)(@@) $DIC_NIS$ الجندي (@)(@@) بفتحتين ومهملة إلى جند بلد باليمن وبطن من المعافر وبسكون النون إلى الجند بلد على طرف سيحون والجند طائفة من التركمان وجندة جد وبالضم والسكون إلى الجند وهو العسكر وجندة جد PageV01P068(@)(@@) وبالفتح والسكون والزاي إلى جنزة مدينة بأذربيجان وجد.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الجنزرودي (@)(@@) بفتح أوله والزاي وضم الراء ومهملة إلى جنزرود قرية بنيسابور انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الجنوجردي (@)(@@) بضمتين وكسر الجيم وسكون الراء ومهملة إلى جنوجرد قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الجنيدي (@)(@@) مصغرا إلى الجنيد جد.(@)(@@)(@@)(@@) $DIC_NIS$ الجنيقي (@)(@@) بالفتح والكسر وتحتية وقاف إلى جنيق جد.(@)(@@)(@@)(@@) $DIC_NIS$ الجني (@)(@@) إلى أبي الجن جد.(@)(@@)(@@)(@@) || باب الجيم والواو(@)(@@)(@@)(@@) $DIC_NIS$ الوادي (@)(@@) بالفتح والتشديد إلى جواد بطن من حضرموت.(@)(@@)(@@)(@@) $DIC_NIS$ الجواربي (@)(@@) بالفتح والتخفيف والراء والموحدة إلى الجوارب جمع جراب.(@)(@@)(@@)(@@) $DIC_NIS$ الجواز (@)(@@) بالفتح والتشديد والزاي إلى بيع الجوز وباللام إلى الرحلة والجولان في البلاد.(@)(@@)(@@)(@@) $DIC_NIS$ الجوالقي (@)(@@) بالضم وكسر اللام وقاف إلى عمل 
ms44	 الجوالق وبيعه.(@)(@@)(@@)(@@) $DIC_NIS$ الجواليقي (@)(@@) بالفتح إلى الجواليق جمع جوالق.(@)(@@)(@@)(@@) $DIC_NIS$ الجوانكاني (@)(@@) بالضم والتخفيف ونون إلى جوانكان قرية بجرجان.(@)(@@)(@@)(@@) $DIC_NIS$ الجواني (@)(@@) بالضم إلى جوان رجل قلت: وبالفتح والتشديد إلى الجوانية موضع قرب المدينة انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الجوباري (@)(@@) بالضم والموحدة والراء إلى جوبار قرية بمرو وبهراة وبجرجان أيضا وجوبارة محلة بأصبهان وبالنون آخره إلى جوبان قرية بمرو. PageV01P069(@)(@@)(@@)(@@) $DIC_NIS$ الجوبري (@)(@@) بفتح أوله والموحدة وراء إلى جوبر قرية بدمشق ونيسابور أيضا وبالقاف إلى جوبق موضع بنسف وبها وضم اليم إلى جوبق موضع بيع الفواكه بمرو وبنسف أيضا.(@)(@@) الجوبيناباذ قرية ببلخ.(@)(@@)(@@)(@@) $DIC_NIS$ الجوبي (@)(@@) بالفتح وموحدة إلى جوب بطن من همذان وبالضم إلى جوب الكردي.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الجوجري (@)(@@) بفتح الجيمين وراء إلى جوجر بلد قرب سمنود انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الجوخاني (@)(@@) بالضم والمعجمة والنون إلى جوخان موضع تجفيف التمر في البصرة وبالدال المهملة بدل الخاء إلى جودان رجل وقبيلة من الجهاضم وبالمعجمة والموحدة إلى جوذاب لقب.(@)(@@)(@@)(@@) $DIC_NIS$ الجوذقاني (@)(@@) بفتح أوله والمعجمة والقاف إلى جوذقان قرية بنيسابور.(@)(@@)(@@)(@@) $DIC_NIS$ الجوربذي (@)(@@) بالضم وفتح الراء والموحدة ومعجمة إلى جوربذ قرية بإسفراين.(@)(@@)(@@)(@@) $DIC_NIS$ الجوربي (@)(@@) بالفتح إلى الجورب المعروف.(@)(@@)(@@)(@@) $DIC_NIS$ الجورزكي (@)(@@) بالضم وفتح الراء والزاي إلى جورزك قرية بإسفراين.(@)(@@)(@@)(@@) $DIC_NIS$ الجورجيري (@)(@@) بالضم وسكون الواو والراء الأولى وكسر الجيم وتحتية إلى جورجير قرية بأصبهان.(@)(@@)(@@)(@@) $DIC_NIS$ الجوروي (@)(@@) بضم أوله والراء.(@)(@@)(@@)(@@) $DIC_NIS$ الجوري (@)(@@) بالضم والراء إلى جور بلد الورد بفارس ومحلة بنيسابور وبالزاي إلى جوزة قرية بالموصل وجوزي الطائر الصغير بلغة أصبهان وبها والفتح إلى الجوز المعروف قلت: ومسجد الجوز بدمشق وبالضم والفتح والراء إلى جور قرية بأصبهان انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الجورقاني (@)(@@) بالضم وفتح الراء والقاف إلى جورقان قبيلة من الأكراد وناحية بهمذان وبالزاي والجيم إلى جوزجانان بإسقاط الزيادة PageV01P070(@)(@@) بلد بخراسان وبالزاي والمهملة إلى جوزدان قرية بأصفهان.(@)(@@)(@@)(@@) $DIC_NIS$ الجوزفلقي(@)(@@) إلى جوزفلق بلفظ المأكول ومصدر فلق قرية قرب أبسكون.(@)(@@)(@@)(@@) $DIC_NIS$ الجوزقي (@)(@@) إلى جوزق كجعفر قرية بنيسابور وهراة أيضا وبالسين المهملة إلى جوسق قرية بنهروان.(@)(@@)(@@)(@@) $DIC_NIS$ الجوزراني (@)(@@) بفتح أوله والزاي والراء إلى جوزران قرية بعكبرا.(@)(@@)(@@)(@@) $DIC_NIS$ الجوزي (@)(@@) مر في الجوري.(@)(@@)(@@)(@@) $DIC_NIS$ 
ms45	 الجوسقاني (@)(@@) بوزنه إلى جوسقان قرية بإسفراين.(@)(@@)(@@)(@@) $DIC_NIS$ الجوسقي (@)(@@) مر في الجوزقي.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الجوسي (@)(@@) إلى جوسية بالضم وكسر المهملة وتخفيف التحتية قرية بحمص انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الجوشني (@)(@@) بالمعجمة والنون إلى جوشن بطن من غطفان وجد.(@)(@@)(@@)(@@) $DIC_NIS$ الجوصي (@)(@@) بالفتح إلى جوص جد الحافظ.(@)(@@)(@@)(@@) $DIC_NIS$ الجوعي (@)(@@) بالضم إلى الجوع.(@)(@@)(@@)(@@) $DIC_NIS$ الجوغاني (@)(@@) بالضم والمعجمة إلى جوغان قرية بجرجان.(@)(@@)(@@)(@@) $DIC_NIS$ الجوفي (@)(@@) بالفتح والفاء إلى درب الجوف محلة بالبصرة.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الجوكاني (@)(@@) إلى جوكان بالضم وفتح الواو بلد بفارس انتهى. PageV01P071(@)(@@)(@@)(@@) $DIC_NIS$ الجولكي (@)(@@) بالضم وفتح اللام إلى جولك رجل.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الجومي (@)(@@) إلى جومة بالضم مدينة بفارس وقرية بحلب انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الجوني (@)(@@) بالفتح والنون إلى جون بطن من الأزد وبالضم إلى جونية مدينة بالشام.(@)(@@)(@@)(@@) $DIC_NIS$ الجوهري (@)(@@) إلى بيع الجوهري.(@)(@@)(@@)(@@) $DIC_NIS$ الجويباري (@)(@@) بالضم وسكون الواو والتحتية وفتح الموحدة وراء إلى جويبار قرية بهراة وسمرقند وسكة جويبار بنسف.(@)(@@)(@@)(@@) $DIC_NIS$ الجويثي (@)(@@) بالفتح وكسر الواو المشددة وسكون التحتية ومثلثة إلى جويث بلد بنواحي البصرة.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الجويخاني (@)(@@) بالضم والكسر وتحتية ومعجمة إلى جويخان قرية بفارس انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الجويكي (@)(@@) بالضم والكسر إلى جويك محلة بنسف.(@)(@@)(@@)(@@) $DIC_NIS$ الجويمي (@)(@@) بالضم قلتك وفتح الواو وتحتية ساكنة إلى جويم مدينة بفارس انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الجويني (@)(@@) إلى جوين ناحية بنيسابور وقرية بسرخس.(@)(@@)(@@)(@@) $DIC_NIS$ الجوبي (@)(@@) بوزنه وتشديد الياء الأولى إلى جوية بطن من فزارة.(@)(@@)(@@)(@@) $DIC_NIS$ الجوي (@)(@@) بالضم وتشديد الواو إلى الجوة قرية باليمن.(@)(@@)(@@)(@@) || باب الجيم والهاء(@)(@@)(@@)(@@) $DIC_NIS$ الجهبذ (@)(@@) بكسر الجيم والموحدة وسكون الهاء ومعجمة ناقد الذهب.(@)(@@)(@@)(@@) $DIC_NIS$ الجهرمي (@)(@@) بفتح أوله والراء إلى جهرم بلد بفارس وبالضاد المعجمة إلى الجهاضمة بطن من الأزد والجهاضم محلة لهم بالبصرة.(@)(@@)(@@)(@@) $DIC_NIS$ الجهمي (@)(@@) بالفتح إلى جهم بن صفوان رأس الجهمية وإلى أبي جهم بن حذيفة بن عتبة بن ربيعة بن عبد شمس. PageV01P072(@)(@@)(@@)(@@) $DIC_NIS$ الجهني (@)(@@) بالضم والفتح إلى جهينة قبيلة من قضاعة وقرية بالموصل.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الجهوذانكي (@)(@@) إلى جهوذانك بالفتح والضم ومعجمة ونون قرية ببلخ انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الجهيري (@)(@@) بالفتح والكسر إلى جهير جد.(@)(@@)(@@)(@@) || باب الجيم واللام ألف(@)(@@)(@@)(@@) $DIC_NIS$ الجلاباذي (@)(@@) بالضم والتخفيف وموحدة ومعجمة إلى جلاباذ 
ms46	 محلة بنيسابور.(@)(@@)(@@)(@@) $DIC_NIS$ الجلابي (@)(@@) بالفتح والتشديد والجلاب إلى جلب السلع وإلى جد وبالضم إلى جلاب قلت: نهر مدينة حران انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الجلاجلي (@)(@@) بجيمين إلى الجلاجل كمساجد جمع جلجل.(@)(@@)(@@)(@@) $DIC_NIS$ الجلاني (@)(@@) بالكسر والتشديد والنون إلى جلان بطن من أسد.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الجلاوندي (@)(@@) إلى جلاوند بفتحات وتخفيف اللام وسكون اللام ومهملة قرية بقم انتهى.(@)(@@)(@@)(@@) || باب الجيم والياء(@)(@@)(@@)(@@) $DIC_NIS$ الجياسري (@)(@@) بالكسر وفتح التحتية والمهملة وراء إلى جياسر قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الجياني (@)(@@) بالفتح والتشديد ونون إلى جيان بلد بالأندلس وقرية بالري.(@)(@@)(@@)(@@) $DIC_NIS$ الجيخني (@)(@@) بالكسر والسكون وفتح المعجمة ونون إلى جيخن قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الجيذي (@)(@@) بالكسر ومعجمة إلى جيذة جد.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الجيذاي (@)(@@) إلى جيذا بالكسر والمعجمة والقصر قرية بواسط انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الجيراخشتي (@)(@@) بالكسر وفتح الراء والخاء المعجمة وسكن الشين المعجمة وفوقية إلى جيراخشت قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الجيراني (@)(@@) بفتح أوله والراء إلى جيران قرية بأصبهان.(@)(@@)(@@)(@@) $DIC_NIS$ الجيرفتي (@)(@@) بالكسر وضم الراء وسكون الفاء وفوقية إلى جيرفت بلد بكرمان قلت: فتح ياقوت الراء انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الجيرمزداني (@)(@@) بالكسر وفتح الراء والميم والدال المهملة وسكون الزاي إلى جيرمزدان قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الجيرنجي (@)(@@) بالكسر وفتح الراء وسكون النون وجيم إلى جيرنج قرية بمرو. PageV01P073(@)(@@)(@@)(@@) $DIC_NIS$ الجيروني (@)(@@) بالفتح وضم الراء إلى جيرون موضع بدمشق.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الجيزاباذي (@)(@@) بالكسر وتخفيف الزاي والموحدة ومعجمة إلى جيزاباذ محلة بنيسابور انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الجيزي (@)(@@) بالكسر والزاي إلى الجيزة بلد على النيل قبالة الفسطاط.(@)(@@)(@@)(@@) $DIC_NIS$ الجيشاني (@)(@@) بفتح أوله والمعجمة إلى جيشان قبيلة من اليمن وموضع به.(@)(@@)(@@)(@@) $DIC_NIS$ الجيشبري (@)(@@) بالكسر وفتح المعجمة وضم الموحدة وراء إلى جيشبر قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الجيشي (@)(@@) بالفتح إلى الجيش العسكر.(@)(@@)(@@)(@@) $DIC_NIS$ الجيلي والجيلاني:(@)(@@) بالكسر إلى جيل ويقال لها كيل وجيلان وكيلان بلاد مفرقة وراء طبرستان وإلى جيل قرية دون المدائن والجيلاني أيضا إلى جيلان جد وخشب صلب من خشب العناب.(@)(@@)(@@)(@@) | حرف الحاء المهملة(@)(@@)(@@)(@@) || باب الحاء والألف(@)(@@)(@@)(@@) $DIC_NIS$ الحابسي (@)(@@) بكسر الموحدة ومهملة إلى حابس جد.(@)(@@)(@@)(@@) $DIC_NIS$ الحاتمي (@)(@@) بكسر الفوقية إلى حاتم جد.(@)(@@)(@@)(@@) $DIC_NIS$ الحاجبي (@)(@@) إلى حاجب جد وبطن من غفار.(@)(@@)(@@)(@@) $DIC_NIS$ الحارثي (@)(@@) إلى بني حارثة 
ms47	 بطن من الخزرج ومن مراد وغيرهما.(@)(@@)(@@)(@@) $DIC_NIS$ الحازمي (@)(@@) بالزاي إلى حازم جد.(@)(@@)(@@)(@@) $DIC_NIS$ الحاضري (@)(@@) بالمعجمة والراء إلى حاضر جد قلت: وموضع بنواحي حلب وإلى الحاضر بلد بالأندلس انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الحاطبي (@)(@@) إلى حاطب بطن من تيم الله وجد. PageV01P074(@)(@@)(@@)(@@) $DIC_NIS$ الحافي (@)(@@) بالفاء إلى ترك النعل.(@)(@@)(@@)(@@) $DIC_NIS$ الحاكمية (@)(@@) إلى الحاكم بأمر الله.(@)(@@)(@@)(@@) $DIC_NIS$ الحامدي (@)(@@) إلى حامد جد.(@)(@@)(@@)(@@) $DIC_NIS$ الحامضي (@)(@@) إلى حامض رأسه جد.(@)(@@)(@@)(@@) || باب الحاء والباء(@)(@@)(@@)(@@) $DIC_NIS$ الحبابي (@)(@@) بالفتح وموحدتين إلى حباب وحبابة جد.(@)(@@)(@@)(@@) $DIC_NIS$ الحباسي (@)(@@) بالفتح والتخفيف والمهملة إلى حباسة رجل وبالضم والمعجمة إلى حباسة جد.(@)(@@)(@@)(@@) $DIC_NIS$ الحباني (@)(@@) بالفتح وتشديد الموحدة إلى حبان بن منقذ الصحابي وحبانة بنت السمط من حضرموت وبالكسر إلى حبان جد وسكة حبان بنيسابور وبالضم إلى حبان جد.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الحبالي (@)(@@) إلى حبال بلفظ جمع حبل بلد قرب الكرك انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الحبتي (@)(@@) بالفتح وسكون الموحدة وفوقية إلى حبته بنت مالك بن عمرو بن عوف.(@)(@@)(@@)(@@) $DIC_NIS$ الحبتري (@)(@@) بفتح أوله والفوقية وراء إلى حبتر بطن من خزاعة.(@)(@@)(@@)(@@) $DIC_NIS$ الحبراني (@)(@@) بالضم والسكون وراء إلى حبران بطن من حمير.(@)(@@)(@@)(@@) $DIC_NIS$ الحبري (@)(@@) بالكسر والسكون والحبار إلى الحبر الذي يكتب به وبفتح الموحدة إلى الحبرة ثياب من اليمن.(@)(@@)(@@)(@@) $DIC_NIS$ الحبشي (@)(@@) بفتحتين إلى الحبشة وحبش بطن من حمير وجد وبالضم والسكون لغة فيهما.(@)(@@)(@@)(@@) $DIC_NIS$ الحبطي (@)(@@) بفتحتين إلى الحبطات بطن من تميم.(@)(@@)(@@)(@@) $DIC_NIS$ الحبلي (@)(@@) بضمتين إلى بني الحبلى حي من اليمن قلت: وبالفتح والسكون إلى حبلة قرية بعسقلان انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الحبيبي (@)(@@) إلى حبيب مكبرا جد قلت: وبلد من عمل حلب انتهى. وبالتصغير وسكون التحتية إلى حبيب بطن من بني عامر بن لؤي.(@)(@@)(@@)(@@) $DIC_NIS$ الحبيني (@)(@@) بالضم وكسر والموحدة المشددة وتحتية ونون إلى سكة حبين بمرو.(@)(@@)(@@)(@@) || باب الحاء والتاء(@)PageV01P075(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الحتاوي (@)(@@) بالفتح والتشديد إلى حتاوة قرية بعسقلان انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الحتري (@)(@@) بالضم وسكون الفوقية.(@)(@@)(@@)(@@) || باب الحاء والجيم(@)(@@)(@@)(@@) $DIC_NIS$ الحجاجي (@)(@@) إلى حجاج قرية ببيهق وجد.(@)(@@)(@@)(@@) $DIC_NIS$ الحجاري (@)(@@) بكسر الراء إلى بيع الحجارة قلت: ووادي الحجارة كورة بالأندلس انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ [الحجازي](@)(@@) وبالزاي إلى الحجاز المعروف.(@)(@@)(@@)(@@) $DIC_NIS$ الحجبي (@)(@@) بفتحتين وباء موحدة 
ms48	 إلى حجابة الكعبة شرفها الله تعالى.(@)(@@)(@@)(@@) $DIC_NIS$ الحجري (@)(@@) بفتحتين إلى الحجر المعروف وحجر جد وبسكون الجيم إلى حجر قبيلة من حمير ومن الأزد وبالضم مع الفتح إلى الحجر جمع حجرة وهي الدار الصغيرة ومع السكون إلى حجر موضع باليمن.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الحجراي (@)(@@) إلى حجرا بالكسر والقصر قرية بدمشق انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الحجي (@)(@@) بالكسر إلى الحج كالحاج.(@)(@@)(@@)(@@) $DIC_NIS$ الحجوري (@)(@@) بالفتح والضم وراء إلى حجور بطن من همذان.(@)(@@)(@@)(@@) || باب الحاء والدال(@)(@@)(@@)(@@) $DIC_NIS$ الحداء (@)(@@) بتشديد المهملة إلى الحداء.(@)(@@)(@@)(@@) $DIC_NIS$ الحدادي (@)(@@) بالفتح والتشديد إلى الحديد كالحداد وحدادة قرية بقومس وبالضم والتخفيف إلى حداد بطن من الأزد وغيره وبالكسر إلى حداد بطن من محارب.(@)(@@)(@@)(@@) $DIC_NIS$ الداني (@)(@@) بالفتح والتشديد إلى حدان بطن من تميم وبالضم إلى حدان بطن ومحلة لهم بالبصرة. PageV01P076(@)(@@)(@@)(@@) $DIC_NIS$ الحدائي (@)(@@) بفتحتين وهمزة إلى حداء بطن من مراد.(@)(@@)(@@)(@@) $DIC_NIS$ الحدباني (@)(@@) بالضم وسكون وموحدة إلى حدبان بطن من كنانة وبفتحتين ومثلثة إلى الحدثان جد والحديثة بلد على الفرات وكذا.(@)(@@)(@@)(@@) $DIC_NIS$ الحدثي: قلت (@)(@@) الحدثي أيضا إلى الحدث قلعة بين ملظية وسميساط انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الحدسي (@)(@@) بفتحتين ومهملة إلى حدس بطن من لخم وقيل حدان.(@)(@@)(@@)(@@) $DIC_NIS$ الحدلي (@)(@@) بضمتين ولام إلى حديلة بطن من الأزد.(@)(@@)(@@)(@@) $DIC_NIS$ الحديثي (@)(@@) إلى الحديثة أيضا والحديث.(@)(@@)(@@)(@@) || باب الحاء والذال(@)(@@)(@@)(@@) $DIC_NIS$ الحذاء (@)(@@) إلى حذو النعل.(@)(@@)(@@)(@@) $DIC_NIS$ الحذاري (@)(@@) بالضم وتخفيف الذال المعجمة وراء إلى حذار بطن من أسد وبالقاف إلى حذاقة بطن من قضاعة.(@)(@@)(@@)(@@) $DIC_NIS$ الحذيفي (@)(@@) بالتصغير وآخره فاء إلى حذيفة بن اليمان.(@)(@@)(@@)(@@) || باب الحاء والراء(@)(@@)(@@)(@@) $DIC_NIS$ الحرابي (@)(@@) بالكسر والتخفيف والموحدة إلى حراب.(@)(@@)(@@)(@@) $DIC_NIS$ الحرازي (@)(@@) بالفتح والتشديد وزاي إلى حراز جد وبالتخفيف إلى حراز بطن من ذي الكلاع قلت: وموضع لهم قرب زبيد انتهى.(@)(@@) وبالميم مخففا إلى حرام الأنصاري وغيره وسكة بني حرام بالبصرة.(@)(@@)(@@)(@@) $DIC_NIS$ الحراني (@)(@@) بالفتح والتشديد إلى حران مدينة بالجزيرة وبالضم والتخفيف إلى حران سكة بأصبهان.(@)(@@)(@@)(@@) $DIC_NIS$ الحربوي (@)(@@) بالفتح والسكون وضم الباء الموحدة إلى حربوية جد قلت: وبفتح الموحدة إلى حربي بالقصر بين بغداد وتكريت انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الحربي (@)(@@) إلى حرب جد ومحلة الحربية ببغداد وبالضم 
ms49	 والفتح إلى حرب بطن من قضاعة وغيره. PageV01P077(@)(@@)(@@)(@@) $DIC_NIS$ الحرثاني (@)(@@) بالضم والسكون ومثلثة إلى حرثان عدة بطون.(@)(@@)(@@)(@@) $DIC_NIS$ الحرثي (@)(@@) بالفتح والكسر إلى الحرثة بطن من غافق.(@)(@@)(@@)(@@) $DIC_NIS$ الحرحاني (@)(@@) إلى حرحان بمهملات كرغفان قرية بقومس.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الحرداني (@)(@@) بوزنه إلى حردان قرية بدمشق انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الحرسي (@)(@@) بفتحتين إلى الحرس محلة بمصر وبطن من طيئ والحريس من الأنصار.(@)(@@)(@@)(@@) $DIC_NIS$ الحرستاني (@)(@@) بفتح أوله والراء والفوقية وسكون المهملة ونون.(@)(@@)(@@)(@@) $DIC_NIS$ ويقال: الحرستي (@)(@@) إلى حرستا قرية بباب دمشق.(@)(@@)(@@)(@@) $DIC_NIS$ الحرشي (@)(@@) بفتحتين ومعجمة إلى بني الحريش بن كعب بن ربيعة بن عامر بن صعصعة.(@)(@@)(@@)(@@) $DIC_NIS$ الحرفي (@)(@@) بالضم والسكون والفاء للبقال وإلى حرفة بطن من تغلب ويشكر وقضاعة وتيم قلت: وإلى حرف رستاق بنواحي الأنبار انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الحرقاني (@)(@@) بالضم والسكون والقاف ونون إلى حرقا بطن من قضاعة.(@)(@@)(@@)(@@) $DIC_NIS$ الحرقي (@)(@@) بالضم والفتح والقاف إلى الحرقات من جهينة والحرقة بطن من غافق قلت: وناحية بعمان انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الحرمازي (@)(@@) بالكسر والسكون آخره زاي إلى الحرماز بن مالك بن عمرو بن تميم.(@)(@@)(@@)(@@) $DIC_NIS$ الحرملي (@)(@@) بفتح أوله والميم إلى الحرملة قرية بأنطاكية.(@)(@@)(@@)(@@) $DIC_NIS$ الحرمي (@)(@@) بفتحتين إلى حرمة مكة.(@)(@@)(@@)(@@) $DIC_NIS$ الحروري (@)(@@) بالفتح وضم الراء الأولى إلى حروراء موضع بالكوفة اجتمع به الخوارج.(@)(@@)(@@)(@@) $DIC_NIS$ الحريثي (@)(@@) مصغرا وآخره مثلثة إلى حريث جد.(@)(@@)(@@)(@@) $DIC_NIS$ الحريجي (@)(@@) مكبرا آخره جيم إلى حريج بطن PageV01P078 من فزارة وبالراء إلى الحرير وبالزاي إلى حريز قرية باليمن وبالشين المعجمة إلى الحريشة وبالصاد المهملة إلى الحريص لقب.(@)(@@)(@@)(@@) $DIC_NIS$ الحريضي (@)(@@) مصغرا بمعجمة إلى الحرض وهو الأشنان.(@)(@@)(@@)(@@) $DIC_NIS$ الحريمي (@)(@@) مكبرا إلى حريم قبيلة والحريم الطاهري محلة ببغداد وبالتصغير إلى حريم بطن من الصدف.(@)(@@)(@@)(@@) || باب الحاء والزاي(@)(@@)(@@)(@@) $DIC_NIS$ الحزار (@)(@@) بتشديد الزاي للجزر وهو خرص التمر والطعام.(@)(@@)(@@)(@@) $DIC_NIS$ الجزازي (@)(@@) بزاءين الأولى مشددة إلى حزاز بطن من عذرة.(@)(@@)(@@)(@@) $DIC_NIS$ الحزامي (@)(@@) بالكسر والتخفيف إلى حزام والد حكيم قلت: وحزام جد للنووي غيره انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الحزمي (@)(@@) بالفتح والسكون إلى حزم جد وبالنون إلى حزن بن خفاجة.(@)(@@)(@@)(@@) $DIC_NIS$ الحزوري (@)(@@) بفتحتين وتشديد الواو وراء إلى الحزور جد قلت: والحزورة مكان بمكة انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ 
ms50	 الحزيبي (@)(@@) مصغرا بموحدة إلى حزيب رجل.(@)(@@)(@@)(@@) $DIC_NIS$ الحزيزي (@)(@@) بالكسر وسكون الزاي الأولى وفتح التحتية إلى حزيز قرية باليمن.(@)(@@)(@@)(@@) $DIC_NIS$ الحزيمي (@)(@@) مكبرا إلى حزيمة بطن من نهد.(@)(@@)(@@)(@@) $DIC_NIS$ الحزي (@)(@@) بالضم وقيل بالفتح والتشديد إلى حزة مدينة بالموصل.(@)(@@)(@@)(@@) || باب الحاء والسين(@)(@@) الحساني إلى حسان جد بالتشديد.(@)(@@)(@@)(@@) $DIC_NIS$ الحسحاسي (@)(@@) بمهملات وتسكين السين الأولى إلى حسحاس بطن من أسد ومن الأزد.(@)(@@)(@@)(@@) $DIC_NIS$ الحسلي (@)(@@) بالكسر والسكون ولام إلى حسل بطن من مازن.(@)(@@)(@@)(@@) $DIC_NIS$ الحسناباذي (@)(@@) بفتح أوله والنون والموحدة وسكون السين المهملة آخره معجمة إلى حسناباذ قرية بأصبهان. PageV01P079(@)(@@)(@@)(@@) $DIC_NIS$ الحسني (@)(@@) بفتحتين إلى الحسن بن علي بن أبي طالب رضي الله تعالى عنه والحسن البصري وحسنة أم شرحبيل وحسنة قرية بفارس.(@)(@@)(@@)(@@) $DIC_NIS$ الحسنوي (@)(@@) بالفتح والسكون وضم النون إلى حسنويه.(@)(@@)(@@)(@@) $DIC_NIS$ الحسيني (@)(@@) مكبرا إلى حسين بطن من طيئ ومصغرا إلى الحسين بن علي.(@)(@@)(@@)(@@) || باب الحاء والشين(@)(@@)(@@)(@@) $DIC_NIS$ الحشاني (@)(@@) بالكسر وتشديد المعجمة إلى حشان بطن من تميم.(@)(@@)(@@)(@@) $DIC_NIS$ الحشمي (@)(@@) بالفتح والسكون إلى حشم بطن من جذام.(@)(@@)(@@)(@@) $DIC_NIS$ الحشيشي (@)(@@) مصغرا بمعجمتين إلى حشيش عدة بطون.(@)(@@)(@@)(@@) || باب الحاء والصاد(@)(@@)(@@)(@@) $DIC_NIS$ الحصرمي (@)(@@) بكسر أوله والراء وسكون المهملة إلى الحصرم جد.(@)(@@)(@@)(@@) $DIC_NIS$ الحصري (@)(@@) بالضم والسكون إلى جمع الحصير.(@)(@@)(@@)(@@) $DIC_NIS$ الحصكفي (@)(@@) بفتح أوله والكاف وسكون المهملة وفاء إلى حصن كيفا مدينة بديار بكر.(@)(@@)(@@)(@@) $DIC_NIS$ الحصني (@)(@@) بالكسر والسكون إلى حصن موضع بين حلب والرقة ومواضع أخر.(@)(@@)(@@)(@@) $DIC_NIS$ الحصيبي (@)(@@) مصغرا بالموحدة إلى الحصيب والد بريدة وبالنون إلى الحصين جد.(@)(@@)(@@)(@@) || باب الحاء والضاد(@)(@@)(@@)(@@) $DIC_NIS$ الحضرمي (@)(@@) بفتح أوله والراء وسكون المعجمة إلى حضرموت بلد بأقصى اليمن وقبيلة.(@)(@@)(@@)(@@) $DIC_NIS$ الحضري (@)(@@) بالفتح والسكون إلى الحضر بلد بالموصل وبفتحتين قلت: إلى الحاضرة ضد البادية انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الحضني (@)(@@) بفتحتين ونون إلى حضن بطن من قضاعة. PageV01P080(@)(@@)(@@)(@@) $DIC_NIS$ الحضوري (@)(@@) بالفتح والضم وراء إلى حضور بلد من همذان.(@)(@@)(@@)(@@) $DIC_NIS$ الحضيري (@)(@@) مكبرا إلى الحضيرة محلة ببغداد.(@)(@@)(@@)(@@) $DIC_NIS$ الحضيني (@)(@@) بالنون مصغرا.(@)(@@)(@@)(@@) || باب الحاء والطاء(@)(@@) الحطابي والحطاب: إلى الحطب.(@)(@@)(@@)(@@) $DIC_NIS$ الحطراني (@)(@@) بالكسر والسكون وراء ونون.(@)(@@)(@@)(@@) $DIC_NIS$ الحطمي (@)(@@) بفتحتين إلى حطمة بطن من جذام وبالضم إلى حطمة من عبد 
ms51	 القيس.(@)(@@)(@@)(@@) $DIC_NIS$ الحطيني (@)(@@) بكسر أوله والطاء المشددة وتحتية ونون إلى حطين قرية بساحل الشام وقرية بتنيس وبين طبرية وعكا.(@)(@@)(@@)(@@) || باب الحاء والظاء(@)(@@)(@@)(@@) $DIC_NIS$ الحظيري (@)(@@) بالفتح وكسر الظاء المعجمة إلى موضع فوق بغداد قلت: يقال له الحظيرة انتهى.(@)(@@)(@@)(@@) || باب الحاء والفاء(@)(@@)(@@)(@@) $DIC_NIS$ الحفار (@)(@@) إلى حفر القبور.(@)(@@)(@@)(@@) $DIC_NIS$ الحفري (@)(@@) بفتحتين وراء إلى الحفر محلة بالكوفة وبالضم والسكون يحيى بن سليمان الحفري إلى حفرة موضع بالقيروان.(@)(@@)(@@)(@@) $DIC_NIS$ الحفصاباذي (@)(@@) بفتح أوله والمهملة والباء الموحدة وسكون الفاء ومعجمة إلى حفصاباذ قرية بسرخس وبمرو أيضا.(@)(@@)(@@)(@@) $DIC_NIS$ الحفصوي (@)(@@) بالفتح والسكون والضم إلى حفصويه جد.(@)(@@)(@@)(@@) $DIC_NIS$ الحفصي (@)(@@) إلى حفص جد ورأس الحفصية من الخوارج.(@)(@@)(@@)(@@) $DIC_NIS$ الحفناوي (@)(@@) بالفتح والسكون ونون إلى حفنا قرية بمصر.(@)(@@)(@@)(@@) || باب الحاء والقاف(@)PageV01P081(@)(@@)(@@)(@@) $DIC_NIS$ الحقلي (@)(@@) بالفتح وسكون القاف إلى حقل قرية بجنب أيلة.(@)(@@)(@@)(@@) $DIC_NIS$ الحقلاوي (@)(@@) بضبطه إلى حقلا بطن من حمير.(@)(@@)(@@)(@@) || باب الحاء والكاف(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الحكري (@)(@@) بالكسر والسكون إلى .. ..(@)(@@)(@@)(@@) $DIC_NIS$ الحكمي (@)(@@) بفتحتين إلى الحكم بن سعد العشيرة من مذحج وغيره.(@)(@@)(@@)(@@) $DIC_NIS$ الحكيمي (@)(@@) مكبرا إلى حكيم جد.(@)(@@)(@@)(@@) || باب الحاء واللام(@)(@@)(@@)(@@) $DIC_NIS$ الحلبي (@)(@@) إلى حلب المشهورة.(@)(@@)(@@)(@@) $DIC_NIS$ الحلسي (@)(@@) بالكسر والسكون ومهملة إلى حلس بطن من كنانة.(@)(@@)(@@)(@@) $DIC_NIS$ الحلبسي (@)(@@) بفتح أوله والموحدة وسكون اللام ومهملة إلى حلبس جد.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الحلحولي (@)(@@) بالفتح والسكون وضم المهملة إلى حلحول قرية بين القدس والخيل انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الحلفي (@)(@@) بالفتح والسكون إلى حلف بطن من خثعم.(@)(@@)(@@)(@@) $DIC_NIS$ الحلواني (@)(@@) بالضم والسكون ونون إلى حلوان مدينة آخر السواد وقرية بمصر وبفتح أوله وسكون اللام إلى الحلواء المأكولة.(@)(@@)(@@)(@@) $DIC_NIS$ الحلولي (@)(@@) بضمتين إلى الحلول مذهب كفر.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الحلوي (@)(@@) إلى حلي كظبي مدينة باليمن انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الحلي (@)(@@) يتلو في الحلاوي.(@)(@@)(@@)(@@) $DIC_NIS$ الحليفي (@)(@@) بالفاء مصغرا إلى حليف بطن من خثعم وباللام إلى حليل بطن من خزاعة.(@)(@@)(@@)(@@) $DIC_NIS$ الحليمي (@)(@@) مكبرا إلى حليمة السعدية وجدة وحليم جد الفقيه الشافعي.(@)(@@)(@@)(@@) || باب الحاء والميم(@)(@@)(@@)(@@) $DIC_NIS$ الحمادي (@)(@@) بالفتح والتشديد إلى حماد جد.(@)(@@)(@@)(@@) $DIC_NIS$ الحمازي (@)(@@) بالكسر والتخفيف والزاي إلى حماز جد.(@)(@@)(@@)(@@) $DIC_NIS$ الحماسي (@)(@@) بوزنه ومهملة إلى حماس بطن من مذحج قلت: وبالفتح إلى 
ms52	 حماسة انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الحمار والحمال(@)(@@) معروف. PageV01P082(@)(@@)(@@)(@@) $DIC_NIS$ الحمامي (@)(@@) إلى الحمام المعروف وبالفتح والتخفيف إلى الحمام الطير وبني حمامة بطن من الأزد.(@)(@@)(@@)(@@) $DIC_NIS$ الحماني (@)(@@) بالكسر والتشديد إلى حمان قبيلة من تميم.(@)(@@)(@@)(@@) $DIC_NIS$ الحمائي والحموي(@)(@@) إلى حماة مدينة بالشام.(@)(@@)(@@)(@@) $DIC_NIS$ الحمداني (@)(@@) إلى حمدان جد.(@)(@@)(@@)(@@) $DIC_NIS$ الحمدوني (@)(@@) إلى حمدونة أم ولد الرشيد.(@)(@@)(@@)(@@) $DIC_NIS$ الحمدوي (@)(@@) إلى حمدويه جد.(@)(@@)(@@)(@@) $DIC_NIS$ الحمراني (@)(@@) بالضم والراء إلى حمران بن أعين ومولى عثمان.(@)(@@)(@@)(@@) $DIC_NIS$ الحمراوي (@)(@@) بالفتح إلى الحمراء موضع بفسطاط مصر.(@)(@@)(@@)(@@) $DIC_NIS$ الحمري (@)(@@) بالضم إلى حمرة بطن من همذان وتميم.(@)(@@)(@@)(@@) $DIC_NIS$ الحمزي (@)(@@) بالفتح والزاي إلى حمزة مدينة بالغرب وإلى قراءة حمزة والحمزية فرقة من الخوارج.(@)(@@)(@@)(@@) $DIC_NIS$ الحمشاذي (@)(@@) بفتح أوله والمعجمة وسكون الميم وذاله معجمة إلى حمشاذ جد.(@)(@@)(@@)(@@) $DIC_NIS$ الحمصي (@)(@@) بالكسر والسكون إلى حمص بلد بالشام وبتشديد الميم وكسرها إلى الحمص المأكول وحمصة جد راوي جزء البطاقة قلت: وإلى دار الحمص بمصر انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الحمكاني (@)(@@) بفتحات وتخفيف إلى حمكان جد.(@)(@@)(@@)(@@) $DIC_NIS$ الحكمي (@)(@@) كذلك إلى حمك جد وباللام إلى حمل بطن من بني الحارث وغيره.(@)(@@)(@@)(@@) $DIC_NIS$ الحمنني (@)(@@) بفتح أوله والنون الأولى إلى حمنن أخي عبد الرحمن بن عوف.(@)(@@)(@@)(@@) $DIC_NIS$ الحموي (@)(@@) بضم الميم المشددة إلى حمويه.(@)(@@)(@@)(@@) $DIC_NIS$ الحميدي (@)(@@) مكبرا إلى الحميد الأمير الساماني وبالتصغير إلى حميد بطن من أسد وحميد جد صاحب الجمع وغيره.(@)(@@)(@@)(@@) $DIC_NIS$ الحميري (@)(@@) بالكسر والسكون وفتح التحتية إلى حمير من أصول القبائل باليمن.(@)(@@)(@@)(@@) $DIC_NIS$ الحميسي (@)(@@) بالتصغير ومهملة إلى حميس بن عامر بن ثعلبة وابن أد بن طابخة بن الياس بن مضر وباللام إلى حميل بن PageV01P083 شبث بن أساف بن هريم قلت: وإلى الحميلية قرية بنواحي بغداد انتهى وبالنون إلى حمين جد.(@)(@@)(@@)(@@) $DIC_NIS$ الحمي (@)(@@) بالفتح والتشديد إلى حمة جد.(@)(@@)(@@)(@@) || باب الحاء والنون(@)(@@)(@@)(@@) $DIC_NIS$ الحناطي (@)(@@) إلى بيع الحنطة كالحناط.(@)(@@)(@@)(@@) $DIC_NIS$ الحناني (@)(@@) بالفتح والتخفيف إلى حنان رجل.(@)(@@)(@@)(@@) $DIC_NIS$ الحنائي (@)(@@) بالكسر والتشديد إلى الحناء المعروف.(@)(@@)(@@)(@@) $DIC_NIS$ الحنبيل (@)(@@) إلى مذهب أحمد بن حنبل.(@)(@@)(@@)(@@) $DIC_NIS$ الحندري (@)(@@) بضم المهملتين وراء إلى حندر قرية بعسقلان.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الحندوثائي (@)(@@) بالفتح والسكون وضم المهملة ثم مثلثة إلى حندوثا قرية 
ms53	 بمعرة النعمان انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الحنشي (@)(@@) بفتحتين ومعجمة إلى حنش بطن من بني ربيعة.(@)(@@)(@@)(@@) $DIC_NIS$ الحنطبي (@)(@@) بفتح أوله والمهملة ثم موحدة إلى حنطب جد.(@)(@@)(@@)(@@) $DIC_NIS$ الحنظلي (@)(@@) بفتح أوله والمعجمة إلى حنظلة بطن من غطفان وتميم وجعفي وإلى درب حنظلة بالري أبو حاتم الرازي.(@)(@@)(@@)(@@) $DIC_NIS$ الحنفي (@)(@@) إلى بني حنيفة قبيلة من اليمامة وإلى مذهب أبي حنيفة رحمه الله.(@)(@@)(@@)(@@) $DIC_NIS$ الحنوطي (@)(@@) إلى الحنوط المعروف.(@)(@@)(@@)(@@) $DIC_NIS$ الحنوي (@)(@@) بفتحتين إلى حنا مدينة بديار بكر وتعرف الآن حاني كداني.(@)(@@)(@@)(@@) $DIC_NIS$ الحنيفي (@)(@@) مصغرا إلى عثمان بن حنيف وبنون آخره إلى حنين جد.(@)(@@)(@@)(@@) $DIC_NIS$ الحني (@)(@@) بالضم والتشديد إلى حن أخي قصي بن كلاب لأمه.(@)(@@)(@@)(@@) || باب الحاء والواو(@)(@@)(@@)(@@) $DIC_NIS$ الحواريني (@)(@@) بالضم وفتح الراء إلى حوارين بلد بالبحرين.(@)(@@)(@@)(@@) $DIC_NIS$ الحوالي (@)(@@) بالفتح والتخفيف إلى عبد الله بن حوالة الأزدي.(@)(@@)(@@)(@@) $DIC_NIS$ الحوأبي (@)(@@) بفتح أوله والهمزة وسكون الواو آخره موحدة إلى الحوأب موضع بين مكة والبصرة. PageV01P084(@)(@@)(@@)(@@) $DIC_NIS$ الحوتكي (@)(@@) بوزنه وفوقية.(@)(@@)(@@)(@@) $DIC_NIS$ الحوتي (@)(@@) إلى حوت بلفظ السمك بطن من كندة ومن همذان.(@)(@@)(@@)(@@) $DIC_NIS$ الحوري (@)(@@) بالفتح والراء إلى حورية قرية بالرقة قلت: وإلى حورا قرية ببغداد انتهى(@)(@@)(@@)(@@) $DIC_NIS$ [الحوري] (@)(@@) وبالزاي إلى الحوز قرية قرب واسط والحوز محلة ببعقوبا.(@)(@@)(@@)(@@) $DIC_NIS$ الحوراني (@)(@@) بالفتح والراء إلى حوران مدينة بالشام قلت: وناحية بخراسان انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الحوزي (@)(@@) مر في الحوري.(@)(@@)(@@)(@@) $DIC_NIS$ الحوشبي (@)(@@) بفتح أوله والمعجمة وموحدة إلى حوشب جد.(@)(@@)(@@)(@@) $DIC_NIS$ الحوشي (@)(@@) بالفتح إلى حوش قرية بأسفراين.(@)(@@)(@@)(@@) $DIC_NIS$ الحوصلي (@)(@@) بفتح أوله والمهملة إلى حوصلة رجل.(@)(@@)(@@)(@@) $DIC_NIS$ الحوضي (@)(@@) إلى الحوض المعروف، قلت: وموضع بالبصرة انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ [الحوطي] (@)(@@) وبالطاء إلى حوط قرية بحمص أو جبلة وبالفاء إلى حوف وكنت أظن أنها قرية بمصر حتى رأيت في تاريخ البخاري أنها من عمان قلت: بل هي ناحية بمصر كبيرة معوفة فيها قرى كثيرة وجزم به ياقوت رحمه الله تعالى وغيره انتهى.(@)(@@)(@@)(@@) || باب الحاء واللام ألف(@)(@@)(@@)(@@) $DIC_NIS$ الحلابي (@)(@@) بالفتح والتشديد وموحدة إلى حلابة جد.(@)(@@)(@@)(@@) $DIC_NIS$ الحلاج (@)(@@) إلى حلج القطن.(@)(@@)(@@)(@@) $DIC_NIS$ الحلاوي (@)(@@) بالفتح والتخفيف إلى الحلاوة وبالكسر والتشديد إلى الحلة بلد على طرف الفرات والصواب إليها حلي. 
ms54	(@)(@@)(@@)(@@) || باب الحاء والياء(@)(@@)(@@)(@@) $DIC_NIS$ الحياوي (@)(@@) بالفتح وتخفيف التحتية إلى الحياء بطن من خولان.(@)(@@)(@@)(@@) $DIC_NIS$ الحياني (@)(@@) بالتشديد والنون إلى حيان جد.(@)(@@)(@@)(@@) $DIC_NIS$ الحيدي (@)(@@) بالفتح والسكون ومهملة إلى حيدة بن معاوية القشيري وبالكسر إلى حيد جد PageV01P085(@)(@@)(@@)(@@) $DIC_NIS$ [الحيري] (@)(@@) وبالكسر والراء إلى الحيرة بلد بالكوفة ونيسابور.(@)(@@)(@@)(@@) $DIC_NIS$ الحيزاني (@)(@@) بالكسر والزاي إلى حيزان مدينة بديار بكر.(@)(@@)(@@)(@@) $DIC_NIS$ الحيشمي (@)(@@) بفتح ألوه والمعجمة إلى حيشم بطن من كلب.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الحيفي (@)(@@) بالفتح وسكون التحتية وفاء إلى قصر حيفة بساحل بحر الشام انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الحيكاني (@)(@@) بالفتح والسكون ونون إلى حيكان لقب.(@)(@@)(@@)(@@) $DIC_NIS$ الحيواني (@)(@@) بفتحتين إلى بيع الحيوان.(@)(@@)(@@)(@@) $DIC_NIS$ الحيوي (@)(@@) بالفتح وضم المشددة إلى حيويه.(@)(@@)(@@)(@@) | حرف الخاء المعجمة(@)(@@)(@@)(@@) || باب الخاء والألف(@)(@@)(@@)(@@) $DIC_NIS$ الخابطية (@)(@@) بكسر الباء الموحدة فرقة من المعتزلة رأسهم أحمد بن خابط.(@)(@@)(@@)(@@) $DIC_NIS$ الخابوري (@)(@@) بضم الموحدة وراء إلى الخابور نهر بين الرقة والموصل.(@)(@@)(@@)(@@) $DIC_NIS$ الخاخسري (@)(@@) بسكون الخاء الثانية وفتح المهملة وراء إلى خاخسر قرية بسمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الخاري (@)(@@) إلى خار موضع بالري.(@)(@@)(@@)(@@) $DIC_NIS$ والخارباني (@)(@@) إلى خاربان بنواحي بلخ انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الخارجي (@)(@@) إلى الخوارج قلت وإلى خارج قرية بإفريقية انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الخارزنجي (@)(@@) بسكون الراء والنون وفتح الزاي بنيهما آخره جيم إلى خارزنج قرية بنواحي نيسابور ويقال الخارزنكي.(@)(@@)(@@)(@@) $DIC_NIS$ الخارفي(@)(@@) بكسر الراء وفاء إلى خارف بطن من همذان وبالكاف إلى خارك جزيرة قريبة من عمان. PageV01P086(@)(@@)(@@)(@@) $DIC_NIS$ الخازمي (@)(@@) بالزاي إلى خازم أمير خراسان.(@)(@@)(@@)(@@) $DIC_NIS$ الخاستي (@)(@@) بسكون المهملة ويقال بالمعجمة وفوقية إلى خاست بلد بنواحي بلخ.(@)(@@)(@@)(@@) $DIC_NIS$ الخاقاني (@)(@@) بالقاف إلى خاقان جد.(@)(@@)(@@)(@@) $DIC_NIS$ الخالبرزني (@)(@@) بفتح الموحدة والزاي وسكون الراء بينهما ونون إلى خالبزرن قرية بسرخس.(@)(@@)(@@)(@@) $DIC_NIS$ الخالداباذي (@)(@@) بفتح المهملة والموحدة آخره معجمة إلى خالداباذ قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الخالدي (@)(@@) إلى خالد جد قلت: وإلى الخالدية قرية بالموصل وإلى سكة خالد بنيسابور انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الخامري (@)(@@) بكسر الميم وراء إلى الأخمور بطن من المعافر.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الخانجاهي (@)(@@) إلى خانجاه قرية بهمذان ظنا من ياقوت.(@)(@@)(@@)(@@) $DIC_NIS$ والخانساري (@)(@@) بمهملة وراء إلى خانسار قرية بجرباذقان انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الخانقاهي (@)(@@) بالقاف إلى الخانقاه وهي رباط الصوفية قلت: هي بكسر 
ms55	 النون انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الخانقيني (@)(@@) بكسر النون والقاف إلى خانقين قرية على طيق بغداد.(@)(@@)(@@)(@@) $DIC_NIS$ الخانوقي (@)(@@) بضم النون وقاف إلى الخانوقة قرية بناحية الرقة.(@)(@@)(@@)(@@) $DIC_NIS$ الخاني (@)(@@) إلى خان لنجان مدينة بأصبهان وإلى الخان المعروف.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الخاوراني (@)(@@) إلى خاوران قرية بخلاط انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الخاوسي (@)(@@) بمهملة إلى خاوس بلد بما وراء النهر وبصاد مهملة إلى خاوص بلد فوق سمرقند. PageV01P087(@)(@@)(@@)(@@) || باب الخاء والباء(@)(@@)(@@)(@@) $DIC_NIS$ الخبازي (@)(@@) إلى الخبر كالخباز.(@)(@@)(@@)(@@) $DIC_NIS$ الخباشي (@)(@@) بالضم والتخفيف ومعجمة إلى خباشة جد.(@)(@@)(@@)(@@) $DIC_NIS$ الخباط (@)(@@) إلى الخبط وهو ورق الشجر.(@)(@@)(@@)(@@) $DIC_NIS$ الخباقي (@)(@@) بالفتح والقاف إلى خباق قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الخبايري (@)(@@) بالفتح والتخفيف وتحتية وراء إلى الخباير بطن من الكلاع.(@)(@@)(@@)(@@) $DIC_NIS$ الخبذعي (@)(@@) بالكسر والسكون وفتح المعجمة ومهملة إلى خبدع بطن من همذان.(@)(@@)(@@)(@@) $DIC_NIS$ الخبريني (@)(@@) بالفتح والسكون وكسر الراء إلى خبرين قرية ببست.(@)(@@)(@@)(@@) $DIC_NIS$ الخبري (@)(@@) مثله إلى خبر قرية بشيراز.(@)(@@)(@@)(@@) $DIC_NIS$ الخبزأرزي (@)(@@) إلى خبز الأرز وهو بلفظه.(@)(@@)(@@)(@@) $DIC_NIS$ الخبزي (@)(@@) إلى الخبز وأبي خبزة جد.(@)(@@)(@@)(@@) $DIC_NIS$ الخبشي (@)(@@) بفتحتين ومعجمة.(@)(@@)(@@)(@@) $DIC_NIS$ الخبوشاني (@)(@@) بضمتين إلى خبوشان بلد بنيسابور.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الخبيصي (@)(@@) بالفتح والكسر وتحتية ومهملة إلى خبيص مدينة بكرمان انتهى. PageV01P088(@)(@@)(@@)(@@) || باب الخاء والتاء(@)(@@)(@@)(@@) $DIC_NIS$ الختلي (@)(@@) بضم أوله والفوقية وتشديد اللام إلى الختل قرية بطريق خراسان(@)(@@)(@@)(@@) $DIC_NIS$ [الختلي] (@)(@@) وبالفتح والسكون إلى ختلان بلاد وراء بلخ(@)(@@)(@@)(@@) $DIC_NIS$ [الختلي] (@)(@@) قلت: وبالضم وتشديد ثانيه وفتحه إلى ختل كورة خلف جيحون انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الختني (@)(@@) بالضم والفتح إلى ختن من بلاد الترك.(@)(@@)(@@)(@@) $DIC_NIS$ الختي (@)(@@) بالفتح والتشديد إلى خت رجل.(@)(@@)(@@)(@@) || باب الخاء والثاء(@)(@@)(@@)(@@) $DIC_NIS$ الخثعمي (@)(@@) بفتح أوله والمهملة وسكون المثلثة إلى خثعم بن أنمار.(@)(@@)(@@)(@@) $DIC_NIS$ الخثمي (@)(@@) بالضم والفتح إلى خثم جد.(@)(@@)(@@)(@@) $DIC_NIS$ الخثيمي (@)(@@) مصغرا إلى خثيم بطن من طيئ وغيره.(@)(@@)(@@)(@@) || باب الخاء والجيم(@)(@@)(@@)(@@) $DIC_NIS$ الخجادي (@)(@@) بالضم وتخفيف اليم ومهملة إلى خجادا قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الخجستاني (@)(@@) بضم الخاء والجيم وسكون المهملة وفوقية إلى خجستان من جبال هراة.(@)(@@)(@@)(@@) $DIC_NIS$ الخجندي (@)(@@) بالضم وفتح الجيم وسكون النون ومهملة إلى خجندة مدينة بطرف سيحون.(@)(@@)(@@)(@@) || باب الخاء والدال(@)(@@)(@@)(@@) $DIC_NIS$ الخداباذي (@)(@@) بالضم وفتح المهملة والموحدة ومعجمة إلى خداباذ قرية 
ms56	 ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الخدامي (@)(@@) بالكسر وتخفيف المهملة إلى خدام جد.(@)(@@)(@@)(@@) $DIC_NIS$ الخداني (@)(@@) بالفتح والتشديد ونون إلى خدان بطن من بني أسد بن خزيمة.(@)(@@)(@@)(@@) $DIC_NIS$ الخدري (@)(@@) بالضم وسكون المهملة وراء إلى خدرة قبيلة من الأنصار ومن بلي(@)(@@)(@@)(@@) $DIC_NIS$ [الخدري] (@)(@@) وبالكسر إلى خدرة بطن من ذهل بن شيبان.(@)(@@)(@@)(@@) $DIC_NIS$ الخدفراني (@)(@@) بالضم والسكون وكسر الفاء وراء إلى خذفران قرية بسمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ الخدوي (@)(@@) بالفتح وضم المهملة المشددة إلى خدويه جد.(@)(@@)(@@)(@@) $DIC_NIS$ الخديجي (@)(@@) مكبرا إلى خديج بالجيم جد.(@)(@@)(@@)(@@) $DIC_NIS$ الخديسري (@)(@@) بالضم وكسر المهملة وتحتية ومهملة مفتوحة وراء إلى خديسر من ثغور سمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ الخديمنكني (@)(@@) بالضم وكسر المهملة وتحتية وفتح الميم والكاف وسكون النون الأولى إلى خديمنكن من قرى كرمينية.(@)(@@)(@@)(@@) || باب الخاء والذال(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الخذامي (@)(@@) بالكسر ومعجمة إلى سكة خذام بنيسابور انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الخذاندي (@)(@@) بالضم وتخفيف المعجمة وسكون النون ومهملة إلى خذاند قرية بسمرقند.(@)(@@)(@@)(@@) || باب الخاء والراء(@)(@@)(@@)(@@) $DIC_NIS$ الخرابي (@)(@@) بالفتح وتخفيف الراء إلى خراب المعتصم موضع ببغداد.(@)(@@)(@@)(@@) $DIC_NIS$ الخراجري (@)(@@) بفتح أوله والراء والجيم وراء إلى خراجر قرية قرب بخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الخراديني (@)(@@) بالفتح والتخفيف وكسر المهملة وتحتية ونون إلى خرادين قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الخراساني (@)(@@) بالضم والتخفيف إلى خراسان إقليم من الري إلى مطلع الشمس.(@)(@@)(@@)(@@) $DIC_NIS$ الخراسكاني (@)(@@) بفتحات إلى خراسكان قرية بأصبهان. PageV01P089(@)(@@)(@@)(@@) $DIC_NIS$ الخراط (@)(@@) إلى خرط الخشب.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الخرانديري (@)(@@) إلى خراندير قرية بخراسان في ظن ياقوت انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الخرائطي (@)(@@) بفتحتين وكسر الهمزة.(@)(@@)(@@)(@@) $DIC_NIS$ الخرباني (@)(@@) بالفتح والسكون والموحدة إلى خربان جد.(@)(@@)(@@)(@@) $DIC_NIS$ الخربي (@)(@@) بالفتح والكسر إلى الخرب جد وبالضم والسكون إلى خربة جد.(@)(@@)(@@)(@@) $DIC_NIS$ الخرتنكي (@)(@@) بفتح أوله والفوقية وسكون الراء قبلها والنون إلى خرتنك قرية بسمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ الخرتيزي (@)(@@) بالفتح والسكون وكسر الفوقية وتحتية وزاي إلى خرتيز قرية بدهستان.(@)(@@)(@@)(@@) $DIC_NIS$ الخرجاني (@)(@@) بفتح أوله والجيم وسكون الراء إلى خورجان محلة بأصبهان.(@)(@@)(@@)(@@) $DIC_NIS$ الخرجردي (@)(@@) بالفتح وسكون الراءين وكسر الجيم آخره مهملة إلى خرجرد من بلاد بوشنج.(@)(@@)(@@)(@@) $DIC_NIS$ الخرجوشي (@)(@@) بالفتح والسكون وضم الجيم ومعجمة إلى خرجوش جد.(@)(@@)(@@)(@@) $DIC_NIS$ الخرجي (@)(@@) بالضم والسكون جيم إلى خرجة جد.(@)(@@)(@@)(@@) $DIC_NIS$ الخرخاني (@)(@@) بالضم والسكون ومعجمة ونون إلى 
ms57	 خرخان بلد بين نيسابور والري.(@)(@@)(@@)(@@) $DIC_NIS$ الخردلي (@)(@@) بفتح أوله والمهملة إلى الخردل المأكول.(@)(@@)(@@)(@@) $DIC_NIS$ الخرزي (@)(@@) بفتحتين وزاي إلى الخرز المعروفة.(@)(@@)(@@)(@@) $DIC_NIS$ الخرسي (@)(@@) بالضم والسكون ومهملة قلت إلى مربعة الخرس محلة ببغداد انتهى. PageV01P090(@)(@@)(@@)(@@) $DIC_NIS$ الخرشكتي (@)(@@) بفتح أوله والراء والكاف وسكون المعجمة آخره فوقية إلى خرشكت من بلاد الشاش.(@)(@@)(@@)(@@) $DIC_NIS$ الخرشني (@)(@@) بفتح أوله والمعجمة وسكون الراء آخره نون إلى خرشنة من بلاد الشام.(@)(@@)(@@)(@@) $DIC_NIS$ الخرشي (@)(@@) بفتحتين إلى خرشة جد.(@)(@@)(@@)(@@) $DIC_NIS$ الخرططي (@)(@@) بفتح أوله والطاء الأولى إلى خرطط قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الخرعانكثي (@)(@@) بفتح أوله والمهملة والكاف وسكون الراء والنون آخره مثلثة إلى خرعانكث قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الخرعوني (@)(@@) بضم أوله والمهملة إلى خرعون قرية بسمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ الخرقاني (@)(@@) بالضم والقاف إلى خرقان قرية في جبال بسطام وبالفتح إلى خرقان قرية بمسرقند.(@)(@@)(@@)(@@) $DIC_NIS$ الخرقي (@)(@@) بفتحتين وقاف إلى خرق قرية بمرو وبالكسر إلى بيع الخرق والثياب منهم أبو القاسم الحنبلي صاحب المختصر.(@)(@@)(@@)(@@) $DIC_NIS$ الخركني (@)(@@) بفتح أوله والكاف إلى خركن قرية بنيسابور.(@)(@@)(@@)(@@) $DIC_NIS$ الخركوشي (@)(@@) بالفتح وضم الكاف ومعجمة إلى خركوش سكة بنيسابور.(@)(@@)(@@)(@@) $DIC_NIS$ الخرماباذي (@)(@@) بالضم وتشديد الراء وموحدة ومعجمة إلى خرماباذ قرية ببلخ.(@)(@@)(@@)(@@) $DIC_NIS$ الخرميثين (@)(@@) بالضم وكسر الميم وتحتية وفتح المثلثة إلى خرميثن قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الخرمي (@)(@@) بالضم وفتح المشددة إلى خرم جد.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الخرني (@)(@@) بفتح أوله والراء المشددة إلى خرن قرية بهمذان.(@)(@@)(@@)(@@) $DIC_NIS$ والخروي (@)(@@) إلى خرو الجبل قرية بني خابران وطوس انتهى. PageV01P091(@)(@@)(@@)(@@) $DIC_NIS$ الخروري (@)(@@) بالفتح وضم الراء الأولى إلى خرور قرية بخوارزم.(@)(@@)(@@)(@@) $DIC_NIS$ الخروزونجي (@)(@@) بفتح أوله والزاي وضم الراء قبل الواو آخره جيم إلى خروزنج قرية ببلخ.(@)(@@)(@@)(@@) $DIC_NIS$ الخرهي:..(@)(@@) .. .. .. .. .. .. .. .. .. ..(@)(@@)(@@)(@@) $DIC_NIS$ الخريبي (@)(@@) مصغرا آخره موحدة إلى الخريبة محلة بالبصرة وبالميم إلى خريم جد.(@)(@@)(@@)(@@) $DIC_NIS$ الخري (@)(@@) بالضم والتشديد إلى خرة جد.(@)(@@)(@@)(@@) || باب الخاء والزاي(@)(@@)(@@)(@@) $DIC_NIS$ الخزاري (@)(@@) بالضم وتخفيف الزاي آخره راء إلى خزار ناحية قرب نسف.(@)(@@)(@@)(@@) $DIC_NIS$ الخزاز (@)(@@) بزاءين إلى الخز.(@)(@@)(@@)(@@) $DIC_NIS$ الخزاعي (@)(@@) بالضم إلى خزاعة قبيلة من الأزد.(@)(@@)(@@)(@@) $DIC_NIS$ الخزاف والخزفي:(@)(@@) إلى الخزف.(@)(@@)(@@)(@@) $DIC_NIS$ الخزاندي (@)(@@) بالضم والفتح وسكون النون ومهملة إلى خزاند قرية بسمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ الخزجي (@)(@@) بالفتح 
ms58	 والسكون وجيم إلى خزج بطن من قضاعة.(@)(@@)(@@)(@@) $DIC_NIS$ الخزرجي (@)(@@) إلى الخزرج من الأنصار.(@)(@@)(@@)(@@) $DIC_NIS$ الخزرجي (@)(@@) بفتحتين وراء إلى دربند خزران عند سد ذي القرنين وخزر جد.(@)(@@)(@@)(@@) $DIC_NIS$ الخززي (@)(@@) بالضم والفتح آخره زاي أيضا إلى خزز جد.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الخزفي (@)(@@) إلى ساباط الخزف ببغداد انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الخزواني (@)(@@) بفتحتين إلى خزوان قرية ببخارى، قلت: قال ياقوت: بسكون الزاي انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الخزيمي (@)(@@) مصغرا إلى خزيمة جد.(@)(@@)(@@)(@@) || باب الخاء والسين.(@)PageV01P092(@)(@@)(@@)(@@) $DIC_NIS$ الخسروجردي (@)(@@) بالضم وسكون المهملة وفتح الراء الأولى وكسر الجيم آخره مهملة إلى خسروجرد قرية ببيهق.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الخسروسابوري (@)(@@) إلى خسروسابور قرية بواسط انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الخسروشاهي (@)(@@) بالضم وفتح الراء والمعجمة إلى خسروشاه قرية بمرو.(@)(@@)(@@)(@@) || باب الخاء والشين(@)(@@)(@@)(@@) $DIC_NIS$ الخشاب (@)(@@) إلى الخشب.(@)(@@)(@@)(@@) $DIC_NIS$ الخشابي (@)(@@) بالضم وتشديد المعجمة آخره موحدة إلى خشاب قرية بالري.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الخشاغري (@)(@@) إلى خشاغر قرية ببخارى انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الخشاني (@)(@@) بالفتح والتخفيف آخره نون إلى خشان بطن من قيس عيلان وبالكسر والتشديد إلى خشان بطن من مذحج.(@)(@@)(@@)(@@) $DIC_NIS$ الخشاوري (@)(@@) بفتح الخاء والمعجمة والواو ثم راء إلى خشاورة سكة بنيسابور قلت: ضم ياقوت الخاء انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الخشبية (@)(@@) بفتحتين طائفة من الشيعة.(@)(@@)(@@)(@@) $DIC_NIS$ الخشتياري (@)(@@) بالفتح والسكون وكسر الفوقية وتخفيف التحتية وراء إلى خشتيار جد.(@)(@@)(@@)(@@) $DIC_NIS$ الخشخاشي (@)(@@) بفتح الخاءين ومعجمتين إلى الخشخاش جد.(@)(@@)(@@)(@@) $DIC_NIS$ الخشرمي (@)(@@) بفتح أوله والراء إلى خشرم جد.(@)(@@)(@@)(@@) $DIC_NIS$ الخشكي (@)(@@) بالضم والسكون إلى خشك جد.(@)(@@)(@@)(@@) $DIC_NIS$ الخشوفغني (@)(@@) بضمتين وفتح الفاء وسكون المعجمة ثم نون إلى خشوفغن قرية بالصغد.(@)(@@)(@@)(@@) $DIC_NIS$ الخشوننكثي (@)(@@) بضمتين وفتح النون الأولى والكاف آخره مثلثة إلى خشوننكث قرية بسمرقند. PageV01P093(@)(@@)(@@)(@@) $DIC_NIS$ الخشني (@)(@@) بالضم والفتح إلى خشين قبيلة من قضاعة وقرية بإفريقية وبالفتح والكسر إلى الخشن جد.(@)(@@)(@@)(@@) $DIC_NIS$ الخشنامي (@)(@@) بالضم والسكون ونون إلى خشنام جد.(@)(@@)(@@)(@@) $DIC_NIS$ الخشمنجكثي (@)(@@) بالضم وسكون المعجمة والنون وكسر الميم وفتح الجيم والكاف ومثلثة إلى خشمنجكث قرية بما وراء النهر.(@)(@@)(@@)(@@) $DIC_NIS$ الخشيشي (@)(@@) مصغرا إلى خشيش جد.(@)(@@)(@@)(@@) $DIC_NIS$ الخشيناني (@)(@@) بالفتح والكسر وتحتية ونونين إلى خشينان محلة بأصبهان.(@)(@@)(@@)(@@) $DIC_NIS$ الخشينديزي (@)(@@) بفتح أوله والتحتية الأولى وسكون الشين والنون وكسر المهملة بعدها آخره 
ms59	 زاي إلى خشينديزة قرية بنسف.(@)(@@)(@@)(@@) $DIC_NIS$ الخشي (@)(@@) بالضم والتشديد إلى خش قرية بإسفراين.(@)(@@)(@@)(@@) || باب الخاء والصاد(@)(@@)(@@)(@@) $DIC_NIS$ الخصاص (@)(@@) إلى الخص.(@)(@@)(@@)(@@) $DIC_NIS$ الخصاصي (@)(@@) بالفتح والتشديد إلى خصاصة بطن من الأزد.(@)(@@)(@@)(@@) $DIC_NIS$ الخصيبي (@)(@@) بالفتح وكسر المهملة وتحتية وموحدة إلى خصيب رجل.(@)(@@)(@@)(@@) $DIC_NIS$ الخصيفي (@)(@@) بالفاء مصغرا إلى خصيف جد.(@)(@@)(@@)(@@) || باب الخاء والضاد(@)(@@)(@@)(@@) $DIC_NIS$ الخضرمي (@)(@@) بكسر أوله والراء وسكون الضاد المعجمة إلى خضرمة قلت: وهي بلد باليمامة انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الخضري (@)(@@) مثله بلا ميم إلى الخضر بالفتح والكسر جد وبالضم والسكون إلى الخضر قبيلة من قيس عيلان.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الخضيري (@)(@@) مصغرا إلى الخضيرية محلة ببغداد وهو من أنساب سلفي فالظاهر أنه إليها انتهى.(@)(@@)(@@)(@@) || باب الخاء والطاء(@)(@@)(@@)(@@) $DIC_NIS$ الخطابي (@)(@@) بالفتح والتشديد إلى عمر بن الخطاب وأخيه زيد والخطاب جد ومذهب الخطابية. PageV01P094(@)(@@)(@@)(@@) $DIC_NIS$ الخطامي (@)(@@) بالكسر والتخفيف وميم إلى خطامة بطن من طيئ.(@)(@@)(@@)(@@) $DIC_NIS$ الخطبي (@)(@@) إلى إنشاء الخطب.(@)(@@)(@@)(@@) $DIC_NIS$ الخطفي (@)(@@) بفتحتين وفاء إلى جد جدير الشاعر.(@)(@@)(@@)(@@) $DIC_NIS$ الخطمي (@)(@@) بالفتح والسكون إلى بني خطمة بطن من الأنصار.(@)(@@)(@@)(@@) $DIC_NIS$ الخطيبي (@)(@@) مكبرا بالموحدة إلى جد كان خطيبا وبالميم إلى خطيم جد.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الخطي (@)(@@) بالفتح والتشديد إلى الخط أرض بالحبرين تقوم فيه الرماح الخطية انتهى.(@)(@@)(@@)(@@) || باب الخاء والفاء(@)(@@)(@@)(@@) $DIC_NIS$ الخفاجي (@)(@@) بفتح الخاء والفاء وجيم إلى خفاجة امرأة ولد لها أولاد كثيرة فيما قال ابن السمعاني وقال ابن الأثير بل إلى خفاجة بن عمرو بن عقيل.(@)(@@)(@@)(@@) $DIC_NIS$ الخفافي (@)(@@) إلى الخفاف كالخفاف.(@)(@@)(@@)(@@) $DIC_NIS$ الخفيفي (@)(@@) بالتصغير وفاءين إلى خفيف بطن من قضاة.(@)(@@)(@@)(@@) || باب الخاء واللام(@)(@@)(@@)(@@) $DIC_NIS$ الخلبي (@)(@@) بالضم وتشديد اللام وموحدة.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الخلخالي (@)(@@) بفتح المعجمتين وسكون اللام الأولى إلى خلخال مدينة بطرف أذربيجان انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الخلدي (@)(@@) بالضم والسكون ومهملة إلى الخلد محلة ببغداد.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الخلعي (@)(@@) بالكسر والفتح إلى بيع الخلع انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الخلقاني (@)(@@) بالضم والسكون وقاف إلى بيع خلقان الثياب.(@)(@@)(@@)(@@) $DIC_NIS$ الخلمي (@)(@@) بالضم والسكون وميم إلى خلم بلد ببلخ.(@)(@@)(@@)(@@) $DIC_NIS$ الخلنجي (@)(@@) بفتحتين وسكون النون وجيم إلى الخلنج.(@)(@@)(@@)(@@) $DIC_NIS$ الخلوقي (@)(@@) بالفتح والضم وقاف إلى خلوق أو خلوقة بطن من العرب.(@)(@@)(@@)(@@) $DIC_NIS$ الخلوي (@)(@@) بتشديد 
ms60	 اللام وضمها إلى خلويه جد. PageV01P095(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الخلي (@)(@@) بالفتح والتشديد إلى خلة قرية باليمن انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الخليعي (@)(@@) مصغرا ومهملة إلى خليع جد.(@)(@@)(@@)(@@) $DIC_NIS$ الخليلي (@)(@@) مكبرا إلى بدل الخليل عليه الصلاة والسلام جد.(@)(@@)(@@)(@@) || باب الخاء والميم.(@)(@@)(@@)(@@) $DIC_NIS$ الخماشي (@)(@@) بالضم والتخفيف ومعجمة إلى خماشة جد وبالميم إلى خمامة بطن من أوس وخمام بطن من قضاعة.(@)(@@)(@@)(@@) $DIC_NIS$ الخماني (@)(@@) بالفتح والتخفيف ونون إلى خمانة جد وبالضم والتشديد إلى قرية قلت: بالشام انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الخمايجاني (@)(@@) بالضم والتخفيف وسكون التحتية وجيم ونون إلى خمايجان قرية بنواحي فارس.(@)(@@)(@@)(@@) $DIC_NIS$ الخمخيسري (@)(@@) بالضم والسكون وكسر المعجمة وتحتية ساكنة وفتح المهملة وراء إلى خمخيسر قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الخمركي (@)(@@) بالضم والسكون وفتح الراء إلى خمرك من بلاد الشاش.(@)(@@)(@@)(@@) $DIC_NIS$ الخمري (@)(@@) بفتحتين وراء إلى خمر بطن من همذان وبالضم والسكون إلى الخمر المعروفة.(@)(@@)(@@)(@@) $DIC_NIS$ الخمقاباذي (@)(@@) بالكسر والسكون وقاف وباء موحدة ومعجمة إلى خمقاباذ ويقال بالنون بدل الميم قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الخمقري (@)(@@) بفتح أوله والقاف وراء إلى خمس قرى وهي بنج ديه.(@)(@@)(@@)(@@) $DIC_NIS$ الخملي (@)(@@) بالضم والسكون إلى خمل قبيلة من كنانة.(@)(@@)(@@)(@@) $DIC_NIS$ الخميثني (@)(@@) بالضم وفتح الميم والمثلثة بين تحتية ساكنة ونون إلى خميثين قرية بسمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ الخميروي (@)(@@) بالفتح والكسر وضم الراء إلى خميرويه جد. PageV01P096(@)(@@)(@@)(@@) $DIC_NIS$ الخمي (@)(@@) بالضم والتشديد لقب لا نسب.(@)(@@)(@@)(@@) || باب الخاء والنون(@)(@@)(@@)(@@) $DIC_NIS$ الخناجني (@)(@@) بالضم وتخفيف النون وكسر الجيم ونون إلى خناجن قرية باليمن.(@)(@@)(@@)(@@) $DIC_NIS$ الخنازيري (@)(@@) إلى الخنازير جمع خنزير.(@)(@@)(@@)(@@) $DIC_NIS$ الخناسي (@)(@@) بالضم والتخفيف ومهملة إلى خناس جد.(@)(@@)(@@)(@@) $DIC_NIS$ الخناصري (@)(@@) بالضم والتخفيف وكسر المهملة وراء إلى خناصرة موضع بالشام قرب حلب.(@)(@@)(@@)(@@) $DIC_NIS$ الخناعي (@)(@@) بالضم والتخفيف وعين مهملة إلى خناعة بطن من هذيل.(@)(@@)(@@)(@@) $DIC_NIS$ الخناق (@)(@@) بالفتح والتشديد وقاف بياع السمك بالأندلس.(@)(@@)(@@)(@@) $DIC_NIS$ الخنامتي (@)(@@) بالضم والتخفيف وفتح الميم وفوقية إلى خنامتى قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الخنباجي (@)(@@) بالفتح والسكون وتخفيف الموحدة وجيم إلى خنباج جد.(@)(@@)(@@)(@@) $DIC_NIS$ الخنبسي (@)(@@) بالفتح والسكون وكسر الموحدة ومهملة إلى خنبس بن ضيغم بطن من قضاعة وبكسر أوله أيضا إلى خنبس بن عمرو منهم أيضا وبفتح أوله والموحدة ومعجمة إلى خنبش جد. 