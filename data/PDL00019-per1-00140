ms135	 خدمت تو کند جان زار مانده کجاست(@)(@@) 63 به من جواب و سؤال امور دیوان را %~% تعلقی نبود کان شعار و رسم شماست(@)(@@) 64 سؤالکیست در این حالتم به غایت لطف %~% گمان بنده چنانست کان نه نازیباست(@)(@@) 65 ز غایت کرم تست یا ز خامی من %~% که با گناه چنین منکرم امید عطاست(@)(@@) 66 بدین دقیقه که راندم گمان کدیه مبر %~% به بنده گرچه گدایی شعریعت شعر است(@)(@@) 67 سرم به ظل عنایت بپوش بس باشد %~% که عمرهاست که در تف آفتاب عناست(@)(@@) 68 همیشه تا به جهان اندرون ز دور فلک %~% شبست و روز و زین هر دو ظلمتست و ضیاست(@)(@@) 69 شبت همیشه ز اقبال روز روشن باد %~% که روز روشن اقبال تو شب اعداست(@)(@@) 70 به خرمی و خوشی بگذران جهان جهان %~% که هرچه جز خوشی و خرمی همه سوداست PageV1P0339(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 شهر پرفتنه و پر مشغله و پر غوغاست %~% سید و صدر جهان بار ندادست کجاست(@)(@@) 2 دیر شد دیر که خورشید فلک روی نمود %~% چیست امروز که خورشید زمین ناپیداست(@)(@@) 3 بارگاهش ز بزرگان و ز اعیان پر شد %~% او نه بر عادت خود روی نهان کرده چراست(@)(@@) 4 دوش گفتند که رنجور ترک بود آری %~% بار نادادنش امروز بر آن قول گواست(@)(@@) 5 پرده دارا تو یکی درشو و احوال بدان %~% تا چگونه است بهش هست که دلها درواست(@)(@@) 6 ور ترا بار بود خدمت ما هم برسان %~% مردمی کن بکن این کار که این کار شماست(@)(@@) 7 ور توانی که رهی بازدهی به باشد %~% تا درآییم و سلامیش کنیم ار تنهاست(@)(@@) 8 ور چنانست که حالیست نه بر وفق مراد %~% خود مگو برگ نیوشیدن این حال کراست(@)(@@) 9 که تواند که به اندیشه درآرد به جهان %~% کز جهان آنکه جهان صد یک ازو بود جداست(@)(@@) 10 وانکه باقی به مدد دادن جاهش بودی %~% نعمت و ایمنی امروز نه در حال بقاست(@)(@@) 11 
ms136	 وانکه برخاست ازو رسم بدی چون بنشست %~% چون چنین است بهین کاری تسلیم و رضاست(@)(@@) 12 آفریده چکند گر نکشد بار قضا %~% کافرینش همه در سلسله بند قضاست(@)(@@) 13 والی ما که سپهر است ولایت سوز است %~% وای کین والی سوزنده به غایت والاست(@)(@@) 14 اجل از بارخدای اجل اندر نگذشت %~% گر تو گویی که ز من درگذرد این سوداست(@)(@@) 15 چه توان کرد برون شد ز قضا ممکن نیست %~% دامن از عمر بیفشاند و به یک ره برخاست(@)(@@) 16 ای ز اولاد پیمبر وسط عقد مپرس %~% کز فراق تو بر اولاد پیمبر چه عناست(@)(@@) 17 وی دو قرن از کرمت برده جهان برگ و نوا %~% تو چه دانی که جهان بی‌تو چه بی‌برگ و نواست(@)(@@) 18 به وفات تو جهان ماتم اولاد رسول %~% تازه‌تر کرد مگر سلخ رجب عاشوراست(@)(@@) 19 از فنای چو تویی گشت مبرهن ما را %~% که تر و خشک جهان رهرو سیلاب فناست(@)(@@) 20 با تو گیتی چو جفا کرد وفا با که کند %~% وین عجب نیست که خود عادت او جمله جفاست(@)(@@) 21 دایه دهر نپرورد کسی را که نخورد %~% بینی ای دوست که این دایه چه بی‌مهر و وفاست(@)(@@) 22 گرچه خلقی ز جفاهای فلک مجروحند %~% اندرین دور که شب حامل تشویش و بلاست(@)(@@) 23 بلخ را هیچ قفایی چو وفات تو نبود %~% آخر ای دور فلک وقت بدان این چه قفاست(@)(@@) 24 رفتی و با تو کمالی که جهان داشت ببرد %~% گر جهان را پس از این ناقص خوانیم سزاست(@)(@@) 25 کی دهد کار جهان نور و تو غایب ز جهان %~% شب و خورشید بهم هر دو کجا آید راست(@)(@@) 26 تنگ بودی ز بزرگیت جهان وین معنی %~% داند آنکس که به اسباب بزرگی داناست(@)(@@) 27 وین عجب‌تر که کنون بی‌تو از آن تنگترست %~% زانکه از درد تو خالی نه خلا ونه ملاست(@)(@@) 28 گرچه در هر جگری درد و غمت بیخی زد 
ms137	 %~% که شبان‌روزی چون ذکر تو در نشو و نماست(@)(@@) 29 ما چه دانیم که از ما چه سعادت بگذشت %~% وان تصور نه به اندازه این سینه ماست(@)(@@) 30 کیست با این همه کز ناله زارش همه شب %~% سقف گردون نه پر از ولوله صوت و صداست(@)(@@) 31 کیست ای بوده چو دریا و چو ابرت دل و دست %~% کز فراقت نه مژه ابرو کنارش دریاست(@)(@@) 32 تا جهان را نگذاری ز چنان جاه یتیم %~% که یتیمی جهان گرچه نه طفلست خطاست(@)(@@) 33 تا به خاک اندر آرام نگیری که سپهر %~% همچنان در طلب خدمت تو ناپرواست(@)(@@) 34 ای دریغا که ز تو درد دلی ماند به دست %~% وانکه این درد نه دردیست که درمانش دواست(@)(@@) 35 ای دریغا که غم هجر و غم رفتن تو %~% نیست آن شب که درو هیچ امید فرداست(@)(@@) 36 ای دریغا که ثناها به دعا باز افتاد %~% چون چنین است بهین ذکر درین حال دعاست(@)(@@) 37 یاربش در کنف لطف خدایی خوددار %~% کان چنان لطفی کان درخور آنست تراست(@)(@@) 38 چون رهانیدی از این تفرقها جمعش کن %~% با که با اهل عبا زانکه هم از اهل عباست(@)(@@) 39 ور به گیتی نظری کرد برو تنگ مکن %~% که جهان دجله شد و ما همه را استسقاست PageV1P0340(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ملک مصونست و حصن ملک حصین است %~% منت وافر خدای را که چنین است(@)(@@) 2 شعله باسست هرچه عرصه ملکست %~% سایه عدلست هرچه ساحت دین است(@)(@@) 3 خنجر تشویش با نیام به صلح است %~% خامه انصاف با قرار مکین است(@)(@@) 4 خواب که در چشم فتنه هست نه صرفست %~% بلکه به خونابه سرشک عجین است(@)(@@) 5 آب که در جوی ملک هست نه تنهاست %~% بل ز روانی دور دوام قرین است(@)(@@) 6 جام سپهر افتاد و درد ستم ریخت %~% دست جهان گو که دور ما معین است(@)(@@) 7 عاقله آسمان که نزد وقوفش %~% نیک و بد روزگار 
ms138	 جمله یقین است(@)(@@) 8 گرچه نگوید که اعتصام جهان را %~% از ملکان کیست آنکه حبل متین است(@)(@@) 9 دور زمان داند آنکه وقت تمسک %~% عروه وثقی خدایگان زمین است(@)(@@) 10 شاه جهان سنجر آنکه بسته امرش %~% قیصر و فغفور و رای و خان و تگین است(@)(@@) 11 دیر زیاد آنکه در جبین نفاذش %~% زیر یک آیه هزار سوره مبین است(@)(@@) 12 شیر شکاری که داغ طاعت فرضش %~% شیر فلک را حروف لوح سرین است(@)(@@) 13 آنکه ز تاثیر عین نعل سمندش %~% قلعه بدخواه ملک رخنه چو سین است(@)(@@) 14 آنکه یسارش به بزم حمل گرانست %~% وآنکه یمینش به رزم حمله گزین است(@)(@@) 15 بحر نه از موج واله تب و لرز است %~% کز غم آسیب آن یسار و یمین است(@)(@@) 16 تیغ جهادش کشیده دید ظفر گفت %~% آنکه بدو قایمست ذات من این است(@)(@@) 17 راه حوادث بزد رزانت رایش %~% خلق چه داند که آن چه رای رزین است(@)(@@) 18 باره نخواهد همی جهان که جهان را %~% امن کنون خود نگاهبان امین است(@)(@@) 19 عمر نیابد ستم همی که ستم را %~% روز نخستین چو روز بازپسین است(@)(@@) 20 فکرت او پی برد بجاش اگر چند %~% در رحم مادر زمانه جنین است(@)(@@) 21 نعمتش از مستحق گزیر نداند %~% گر همه در طینتش بقیت طین است(@)(@@) 22 با کرم او الف که هیچ ندارد %~% در سرش اکنون هوای ثروت شین است(@)(@@) 23 ای به سزا سایه خدای که دین را %~% سایه چترت هزار حصن حصین است(@)(@@) 24 قهر ترا هیبتی که در شب ظلش %~% روز سیه را هزار گونه کمین است(@)(@@) 25 حکم ترا روزگار زیر رکابست %~% رای ترا آفتاب زیر نگین است(@)(@@) 26 تا شرف خدمت رکاب تو یابد %~% توسن ایام را تمنی زین است(@)(@@) 27 خطبه ملک ترا که داند یا رب %~% کیست خطیبش که عرش پیش‌نشین است(@)(@@) 28 نام ترا در کنایه سکه صحیفه است %~% نعت ترا در قرینه 
ms139	 خطبه قرین است(@)(@@) 29 با قلم خود گرفت خازن و همت %~% هرچه قضا را ز سر غیب دفین است(@)(@@) 30 بی‌شرف مهر مشرفان وقوفت %~% کتم عدم را کدام غث و سمین است(@)(@@) 31 مردمک چشم جور آبله دارد %~% تا که بر ابروی احتیاط تو چین است(@)(@@) 32 تا چه قدر قدرتی که شیر علم را %~% در صف رزم تو مسته شیر عرین است(@)(@@) 33 عکس سنان در کف تو معرکه سوز است %~% چشم زره در بر تو حادثه‌بین است(@)(@@) 34 لازم ازین است خصم منهزمت را %~% آنکه جبینش قفا قفاش جبین است(@)(@@) 35 دوزخ قهر تو در عقوبت خصمت %~% آتش خشم خدا و دیو لعین است(@)(@@) 36 بنده در این مختصر غرض که تو گفتی %~% آیت تحصیل آن چو روز مبین است(@)(@@) 37 قاعده تهنیت همی ننهد زانک %~% خصم نه فغفور چین و غور نه چین است(@)(@@) 38 گرچه هنوز از غریو لشکر خصمت %~% جمجمه کوه پر صدای انین است(@)(@@) 39 ورچه ز تیغ مبارزان سپاهت %~% سنگ به خون مبارزانش عجین است(@)(@@) 40 با چو تو صاحب‌قران به ذکر نیرزد %~% وین سخن الهام آسمان برین است(@)(@@) 41 ذکر تو با ذکر کردگار کنم راست %~% نام ترا نام کردگار قرین است(@)(@@) 42 گو برو از خطبه بازپرس و ز سکه %~% هرکه یقینش به شک و ریب رهین است(@)(@@) 43 تا که به آمد شد شهور و سنین در %~% طی شدن عمر شادمان و حزین است(@)(@@) 44 شادی و عمر تو باد کین دو سعادت %~% مصلحت کلی شهور و سنین است(@)(@@) 45 ناصر جاهت خدای عز و جل است %~% کوست که در خیر ناصر است و معین است PageV1P0341(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 روز می خوردن و شادی و نشاط و طربست %~% ناف هفته است اگر غره ماه رجبست(@)(@@) 2 برگ‌ریزان به همه حال فرو باید ریخت %~% به قدح آنچه از او برگ و نوای طربست(@)(@@) 3 مادر باغ سترون شد و زادن بگذاشت 
ms140	 %~% چکند نامیه عنین و طبیعت عزبست(@)(@@) 4 دختر رز که تو بر طارم تاکش دیدی %~% مدنی شد که بر آونگ سرش در کنبست(@)(@@) 5 موی بر خیک دمیده ز حسد تیغ زنست %~% تا به خلوت لب خم بر لب بنت‌العنبست(@)(@@) 6 گرنه صراف خزان کیسه‌فشان رفت ز باغ %~% چون چمن‌ها ز ذهابش همه یکسر ذهبست(@)(@@) 7 این عجب نیست بسی کز اثر لاله و خوید %~% گفتی آهوبره میناسم و بیجاده لبست(@)(@@) 8 یارب الماس لبش باز که کرد و شبه سم %~% بینی این گنبد فیروه که چون بلعجبست(@)(@@) 9 این همان سکنه و صحراست که گفتی ز سموم %~% تربت آن خزف و رستنی این حطبست(@)(@@) 10 خیز از سعی دخان بین و ز تاثیر بخار %~% تا در این هر دو کنون چند رسوم عجبست(@)(@@) 11 روزن این همه پر ذره زرین زره است %~% عرصه آن همه پر پشه سیمین سلبست(@)(@@) 12 لمعه در سکنه کانون شده بر خود پیچان %~% افعی کاه‌ربا پیکر مرجان عصبست(@)(@@) 13 دود حلقه شده بر سطح هوا خم در خم %~% سطرهاییست که مکتوب بنان لهبست(@)(@@) 14 شعله آتش از این روی که گفتم گویی %~% در مقادیر کتابت قلم منتجبست(@)(@@) 15 هر زمان لرزه بر آب شمر افتد مگرش %~% در مزاج از اثر هیبت دستور تبست(@)(@@) 16 صاحب عادل ابوالفتح که در جنبش فتح %~% جنبش رایت عالیش قویتر سببست(@)(@@) 17 طاهر آن ذات مطهر که سپهرش گوید %~% صدر طاهر گهر و صاحب طاهر نسبست(@)(@@) 18 آنکه در شش جهت از فضله خوان کرمش %~% هیچ دل نیست که از آز در آن دل کربست(@)(@@) 19 وانکه در نه فلک ار برق کمالی بجهد %~% همه از بارقه خاطر او مکتسبست(@)(@@) 20 ساحت بارگهش مولد ملک عجمست %~% عدل فریادرسش داور دین عربست(@)(@@) 21 ضبط ملک فلک اندیشه همی کرد شبی %~% زانشب اوراد مقیمان فلک قد وجبست(@)(@@) 22 صاحبانه ملکا هم نه چرا زانکه ترا %~% مدحت از حرف برونست چه جای 