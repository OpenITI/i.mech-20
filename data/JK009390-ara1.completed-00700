ms681	 هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6343 ) قال النبي :(@)(@@) | 30 ( إنما أجلكم فيما خلا من الأمم كما بين صلاة العصر إلى مغارب الشمس ، وإنما مثلكم ومثل اليهود والنصارى كمثل رجل استأجر أجراء فقال : من يعمل من غدوة إلى نصف النهار على قيراط قيراط ، فعملت اليهود ، ثم قال : من يعمل من نصف النهار إلى صلاة العصر على قيراط قيراط فعملت النصارى ، ثم قال : من يعمل من العصر إلى أن تغيب الشمس على قيراطين قيراطين فأنتم هم ، فغضبت اليهود والنصارى وقالوا : ما لنا أكثر عملا وأقل عطاء ؟ قال : هل ظلمتكم من حقكم شيئا ؟ قالوا : لا ، قال : فذالك فضلي أوتيه من أشاء ) )(@)(@@) ( مالك حم خ ت ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6344 ) قال النبي :(@)(@@) | 30 ( إنما أخاف على أمتي الأئمة المضلين ) )(@)(@@) ( ت ) عن ثوبان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6345 ) قال النبي :(@)(@@) | 30 ( إنما أخاف عليكم من بعدي ما يفتح عليكم من زهرة الدنيا وزينتها ، إنه لا يأتي الخير بالشر ، وإن مما ينبت الربيع يقتل حبطا أو يلم ، إلا آكلة الخضر ، فإنها أكلت حتى إذا امتلأت خاصرتاها استقبلت الشمس فثلطت وبالت ثم رتعت ، وإن هاذا المال خضرة حلوة ونعم صاحب المسلم هو لمن أعطاه المسكين واليتيم وابن السبيل ، فمن أخذه بحقه ووضعه في حققه فنعم المعونة هو ، ومن أخذه بغير حقه كان كالذي يأكل ولا يشبع ، ويكون عليه شهيدا يوم القيامة ) )(@)(@@) ( حم ق ن ه ) عن أبي سعيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6346 ) قال النبي :(@)(@@) | 30 ( إنما أرى بني هاشم وبني المطلب شيئا واحدا ، PageV02P417 إنهم لم يفارقونا في جاهلية ولا إسلام ) )(@)(@@) ( حم خ د ن ه ) عن جبير بن مطعم رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6347 ) قال النبي :(@)(@@) | 30 ( إنما استراح من غفر له ) )(@)(@@) ( حل ) عن عائشة رضي الله عنها ( ابن عساكر ) عن بلال رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6348 ) قال النبي :(@)(@@) | 30 ( إنما الأسود لبطنه وفرجه ) )(@)(@@) ( عق طب ) عن أم أيمن رضي الله عنها .(@)(@@)(@@)(@@) $ ( 6349 ) قال النبي :(@)(@@) | 30 ( إنما الأعمال كالوعاء ، إذا طاب أسفله طاب 
ms682	 أعلاه ، وإذا فسد أسفله فسد أعلاه ) )(@)(@@) ( ه ) عن معاوية رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6350 ) قال النبي :(@)(@@) | 30 ( إنما الإمام جنة يقاتل به ) )(@)(@@) ( د ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 6351 قال النبي :(@)(@@) | 30 ( إنما الإمام جنة يقاتل من ورائه ويتقى به ، فإن أمر بتقوى الله وعدل فإن له بذالك أجرا ، وإن أمر بغيره فإن عليه وزرا ) )(@)(@@) ( ق ن ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6352 ) قال النبي :(@)(@@) | 30 ( إنما الأمل رحمة من الله لامتي لولا الأمل ما أرضعت أم ولدا ، ولا غرس غارس شجرا ) )(@)(@@) ( خط ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6353 ) قال النبي :(@)(@@) | 30 ( إنما البيع عن تراض ) )(@)(@@) ( ه ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6354 ) قال النبي :(@)(@@) | 30 ( إنما الحلف حنث أو ندم ) )(@)(@@) ( ه ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6355 ) قال النبي :(@)(@@) | 30 ( إنما الخاتم لهاذه وهاذه ، يعني : الخنصر والبنصر ) )(@)(@@) ( طب ) عن أبي موسى ا رضي الله عنه .(@)(@@) PageV02P418(@)(@@)(@@)(@@) $ ( 6356 ) قال النبي :(@)(@@) | 30 ( إنما الخال والد ) )(@)(@@) ( الخرائطي في مكارم الأخلاق ) عن وهب خال النبي ( ز ) .(@)(@@)(@@)(@@) $ ( 6357 ) قال النبي :(@)(@@) | 30 ( إنما الدنيا متاع ، وليس من متاع الدنيا شيء أفضل من المرأة الصالحة ) )(@)(@@) ( ن ه ) عن ابن عمرو رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 6358 ) قال النبي :(@)(@@) | 30 ( إنما الدين النصح ) )(@)(@@) ( أبو الشيخ في التوبيخ ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6359 ) قال النبي :(@)(@@) | 30 ( إنما الربا في النسيئة ) )(@)(@@) ( حم م ن ه ) عن أسامة بن زيد رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6360 ) قال النبي :(@)(@@) | 30 ( إنما الشؤم في ثلاثة : في الفرس والمرأة والدار ) )(@)(@@) ( خ د ه ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6361 ) قال النبي :(@)(@@) | 30 ( إنما الطاعة في المعروف ) )(@)(@@) ( حم ق ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6362 ) قال النبي :(@)(@@) | 30 ( إنما العشور على اليهود والنصارى وليس على المسلمين عشور ) )(@)(@@) ( د ) عن رجل .(@)(@@)(@@)(@@) $ ( 6363 ) قال النبي :(@)(@@)