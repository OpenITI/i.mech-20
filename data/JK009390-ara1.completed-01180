ms1161	 ( تجوزوا في الصلاة ، فإن خلفكم الضعيف والكبير وذا الحاجة ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 10189 ) قال النبي :(@)(@@) | 30 ( تجيء ريح بين يدي الساعة فيقبض فيها روح كل مؤمن ) )(@)(@@) ( طب ك ) عن عياش بن أبي ربيعة رضي الله عنه .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 10190 ) قال النبي :(@)(@@) | 30 ( تجافوا عن ذنب السخي فإن الله أخذ بيده كلما عثر ) )(@)(@@) ( حل هب ) و الخطيب عن ابن عباس رضي الله عنهما .(@)(@@) PageV04P063(@)(@@)(@@)(@@) $ ( 10191 ) قال النبي :(@)(@@) | 30 ( تجافوا عن زلة السخي فإنه إذا عثر أخذ الرحمان بيده ) )(@)(@@) ابن عساكر عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10192 ) قال النبي :(@)(@@) | 30 ( تجاوز الله لي عن أمتى ما حدثت به أنفسها ما لم تعمل به أو تتكلم به ) )(@)(@@) الخطيب عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 10193 ) قال النبي :(@)(@@) | 30 ( تجهزوا لقبوركم ، فإن القبر له في كل يوم سبع مرات يقول : يا ابن آدم الضعيف ترحم في حياتك علاى نفسك قبل أن تلقاني أترحم عليك وتلقى منى السرور ) )(@)(@@) الديلمى عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 10194 ) قال النبي :(@)(@@) | 30 ( تجوز عن أمتي عن ثلاث : عن الخطا والنسيان والكره ) )(@)(@@) ابن عساكر عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10195 ) قال النبي :(@)(@@) | 30 ( تجوز في الصلاة يا عثمان واقدر الناس بأضعفهم ، فإن فيهم الضعيف وذا الحاجة والحامل والمرضع ، إني لأسمع بكاء الصبي فأتجوز ) )(@)(@@) ( طب ) عن عثمان بن أبي العاص رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10196 ) قال النبي :(@)(@@) | 30 ( تجوزوا عن هاذه الأمة عن الخطا والنسيان وما أكرهوا عليه ) )(@)(@@) عبد الرازق عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 10197 ) قال النبي :(@)(@@) | 30 ( تجيء الريح التى يقبض الله فيها نفس كل مؤمن ، ثم طلوع الشمس من مغربها وهى الآية التي ذكر الله في كتابه ) )(@)(@@) ( طب ك ) عن أبي الطفيل عن حذيفة بن أسيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10198 ) قال النبي :(@)(@@) | 30 ( تجيء قزوين يوم القيامة ولها جناحان تطير بهما بين السماء والأرض من درة بيضاء مجوفة ، بأهلها تنادي أنا قزوين قطعة من الفردوس ، من دخلني حتى أشفع له إلى 