ms341	 أخا % حين أمذقتم ودادي محضا % % 19(@)(@@) % ناصلا من صدإ العار كما % % خلص القين الحسام المنتضى % % 20(@)(@@) % لبس المجد فما أوحشه % أي ثوب في هوى المجد نضا % % PageV01P1035 21(@)(@@) % سودد حل تراث ونرى % % كرم القوم معارا مقرضا % % 22(@)(@@) % شرف با آل أيوب مشى % % معرقا فيكم مطبلا معرضا % % 23(@)(@@) % نرتعي اودية مهشمة % وترودون ربيعا محمضا % % 24(@)(@@) % وقف الحب على دوحتكم % % غصن منها لقلبي قبضا % % 25(@)(@@) % نجتني منه خيارا لكم % حلو ما لاك فم أو قرضا % % 26(@)(@@) % مدحا تنشر اعراضكم % نشر حسناء لعرس معرضا % % 27(@)(@@) % سائرات تحت أوصافكم % شاهدات لا يذقن الغمضا % % 28(@)(@@) % ماسعى للبيت يمشي حاسرا % راجل وابن ركاب ركضا % % 29(@)(@@) % وجرت أوداجها قائمة % يوم جمع وتلوت ربضا % % PageV01P1036 البحر : - 1(@)(@@) % سقى زمنا ببابل عقربي % ملي بالذي يروي ويرضي % % 2(@)(@@) % عنيف السير أوطف مستمر % على غلواء ما يقضي ويمضي % % 3(@)(@@) % يزور الأرض بعد جفائه في % % قضيض من زماجره وقض % 4(@)(@@) % سقى فجرى فأسمن كل ضاو % يمر به ورفع كل خفض % 5(@)(@@) % فمن ملان بعد الغيض ضاغن % ومن ريان بعد اليبس غض % 6(@)(@@) % وكرم أسرة كانوا إذا ما ان % % تجعت زلالي الصافي وحمضي % % 7(@)(@@) % هم حملوا وسوق الدهر عني % % وهم نشطوا عرى نسعي وغرضي % % 8(@)(@@) % أضاءوا مذهبي فسرحت طرفي % % وسيعا بعد إطراقي وغضي % % 9(@)(@@) % وقاموا بين أيامي وبيني % % فلم تقتل ولا راعت بنبض % 10(@)(@@) % حموا وجهي ولم أسال سواهم % وأعطوا كل نافلة وفرض % PageV01P1037 11(@)(@@) % فأصبح فيهم وأروح عنهم % إلى وفرين من مالي وعرضي % % 12(@)(@@) % فهل من حامل شوقي إليهم % على ما فيه من ألم ومض % 13(@)(@@) % فحامله فموصله إليهم % على بزلاء ينحلها وينضي % % 14(@)(@@) % يؤم الزابيين بها ويعلو % % قويقا بين تقريب وركض % 15(@)(@@) % فيسمع ثم سامعة كراما % % أيامى العيش بعدهم ويفضي % % 16(@)(@@) % وإني مذ نأت دنياي عنهم % من الدنيا على هجر ورفض % 17(@)(@@) % أقضي ما أغالط من زماني % % بلوعات تكاد علي تقضي % % 18(@)(@@) % فكم أحيا وفي بغداد بعضي % % على مرضي وفي تكريت بعضي % % 19(@)(@@) % ومسبوقين في طرق المعالي % % وإن زجروا بحث أو بحض % 20(@)(@@) % أصاحبهم 
ms342	 فيمسي الود منهم % على زلق من الشحناء دحض % PageV01P1038 21(@)(@@) % وأبرم فيهم مدحا متانا % فتلقاها وعايبهم بنقض % 22(@)(@@) % ولو حامى كمال الملك عني % % رعيت الخصب في دعة وخفض % 23(@)(@@) % إذا لأعاد سلسالا نميرا % على عاداته ثمدي وبرضي % % 24(@)(@@) % فدتك أبا المعالي كل كف % تقصر عنك في بسط وقبض % 25(@)(@@) % وكل مدنس الأب لا بحت % يميط العار عنه ولا برحض % 26(@)(@@) % دعي في الفضائل كل يوم % له نسب يجيء به ويمضي % % 27(@)(@@) % نأى بك جمرة بالغيظ تسري % % إلى سوداء مهجته وتفضي % % 28(@)(@@) % كرمت ففي عطايا الغيث شوب % وماء يديك من صاف ومحض % 29(@)(@@) % ويعطي الناس من جدة وتعطى % % عطاء الحمد من دين وقرض % 30(@)(@@) % وتخجلك المواهب وهي كثر % كأنك مسخط ونداك مرضي % % PageV01P1039 31(@)(@@) % قضى الله الكمال فكنت شخصا % لصورته وخلق الناس يقضي % % 32(@)(@@) % شريتك بالبرية بعد قطعي % % طريق الإختيار بهم ونفضي % % 33(@)(@@) % ورعت بك النوائب وهي فوقي % % وتحتي بين حائمة وربض % 34(@)(@@) % فقد أسلمتني بنواك حتى % % نسلن قوادمي وبرين نحضي % % 35(@)(@@) % فها أنا بين حاجاتي وشوقي % % لفت من مخالبها ورض % 36(@)(@@) % أزم إليكم قلبي وعيني % % بآية فيكم جذلي وغمضي % % 37(@)(@@) % أسادتنا كم الإبطاء عنكم % وصبركم على الهجر الممض % 38(@)(@@) % ألما يأتكم وقتكم المسمى % % ألما يأن زبدكم بمخض % 39(@)(@@) % فكمء سخط على الدنيا وصد % عن الدولات وهي على الترضي % % 40(@)(@@) % حديثكم يبرح بالمعالي % % فنهضا إنها أيام نهض % % PageV01P1040 41(@)(@@) % أراها أينعت ودنا جناها % % وأذعن ختمها لكم بفض % 42(@)(@@) % عسى أقذي بقربكم عيونا % % حسدن علي من حزن وبرض % 43(@)(@@) % ويبرد من أعاديكم وشيكا % زفير جوانح بالهم رمض % 44(@)(@@) % وبعد فما لكم أغفلتموني % % وأخلب بارق من بعد ومض % 45(@)(@@) % أظنا انني عنكم غني % بحلي أو بتطوافي وركضي % % 46(@)(@@) % معاذ الله والعهد المراعى % % ولو أنضيت تامكتي ونقضي % % 47(@)(@@) % وتعويلي من النيروز وفدا % % على متنجز لي ومستنض % 48(@)(@@) % فلا تتوهوا لي خصب مرعى % % إذا قعدت سماؤكم بأرضي % % PageV01P1041 البحر : - 1(@)(@@) % صفراء من غير مرض % % بلهاء تفهيم الغرض % 2(@)(@@) % عمياء تبدي السنن ال % % قصد ركوب لم ترض % 3(@)(@@) % يراكض الريح 
ms343	 بها % % فارسها وما ركض % 4(@)(@@) % كأنه يبسط من % عنانها وما قبض % 5(@)(@@) % لها ابن سوء اسمه % في الأفق وهو منخفض % 6(@)(@@) % أخرس يبدي كل ما % % دق خقيا وغمض % 7(@)(@@) % ترى دما ترضعه % ولم تلد ولم تحض % PageV01P1042 البحر : - 1(@)(@@) % غال بها فيما تسام واشترط % فلاءها على البيع الشطط % 2(@)(@@) % واعلم بأن الغبن حيث نشطت % ربطها والغنم حيث ترتبط % 3(@)(@@) % من ضامنات الحاج لو دانيتها % % بالنجم لم تلو به ولم تلط % 4(@)(@@) % ليس على راكبها جناية % من علم يعيي ولا أرض تشط % 5(@)(@@) % إن لم تكن أنت الذي ينصبه % طول السرى فهي التي لم تعي قط % 6(@)(@@) % كأنها تحت الدجى جنية % راكبها في ظهرها نجم هبط % 7(@)(@@) % لا تطأ الأرض وإن تسهلت % لوطأة الدائس إلأ ما تخط % 8(@)(@@) % كأنما أربعها من خفة % واحدة في السير حين تختلط % 9(@)(@@) % تجري فتدمي أذنها بيدها % % كأنها بسنبكيها تشترط % 10(@)(@@) % تنخل الغالون من آياتها % % صفوة ما خلف فيهم وفرط % PageV01P1043 11(@)(@@) % لم تتحرش بشميم أمها % % هجائن الفرس ولاغبس النبط % 12(@)(@@) % لها من العرب ضمور ناسب % يغنى به عن الوسوم من علط % 13(@)(@@) % جرداء لولا سعف منتشر % من عرفها قلت عسيب مخترط % 14(@)(@@) % بمحزم كما طويت بردة % وملجم كما نشرت عن سفط % % 15(@)(@@) % هي التي رحت بها مغتبطا % وقد لحقت بعد خمس بالغبط % 16(@)(@@) % وبت جار الحي ترعى معهم % على نوى المرعى ومصدوع الخطط % 17(@)(@@) % وناظرات من فروج الرقم مذ % سنت عليهن السجوف لم تمط % 18(@)(@@) % بيضات كن ملس لو خطيت % ما بينهن وصمة لم تتخط % 19(@)(@@) % لم يبتذلن أوجها وأيديا % في وهج النار ولامخض الأقط % 20(@)(@@) % وادي الغضا يرقدن حوليه الضحى % % لطيمة السفر اليمانين تحط % PageV01P1044 21(@)(@@) % كأن روضا تتهاداه الصبا % % هباتهن يتنازعن الشرط % 22(@)(@@) % طرقتهن والدجى لم ينفتق % وسبحة الجوزاء لم تنخرط % 23(@)(@@) % أنشد قلبي عندهن ضلة % نشدك بالقاع بعيرا منتشط % 24(@)(@@) % وبينهن طيبة شارفة % لم تتعرف عندها قبلي اللقط % 25(@)(@@) % ضاعف درعيها وقد تجردت % مرجل أسحم ذيال قطط % 26(@)(@@) % وحف إذا ما غربت فيه يدا % % فارقة 
ms344	 أدرد أسنان المشط % 27(@)(@@) % صد بها معرضة أن قرأت % خطا من الشيب فودي وخط % 28(@)(@@) % من منصفي من عنت في طرفها % % يزحم هداب الرداء بالشمط % 29(@)(@@) % قالت كبرت والغنى معبس % لا بد ما لم تحتضر فتعتبط % 30(@)(@@) % دبت أفانين صروف الدهر لي % % أساودا فناهشتني ورقط % PageV01P1045 31(@)(@@) % ونجذتني حقب علوقها % % بالشيب وهي لم تجملني فرط % 32(@)(@@) % وكم أصبت ثم أرمي غلطا % % فدلني على الإصابات الغلط % 33(@)(@@) % وصاحب كالجرح أعيا سبره % وجل عن ضبط العصاب والقمط % 34(@)(@@) % حملته لا أتشكى ثقله % كي لا تقولوا طرف أو مشترط % 35(@)(@@) % وكالشجا قافية أسغتها % % لو عارضت حنجرة البازل أط % 36(@)(@@) % أسمعها مستدعيا منه الرضى % % أصم لا يسمع إلا ما سخط % 37(@)(@@) % يأكل مدحي وعتابي سحتا % حلوا ومرا ما ضغا ومسترط % 38(@)(@@) % يأكله بالذل ممنونا به % فلا يبالي ساقط كيف لقط % 39(@)(@@) % ليت بني عبد الرحيم ليتهم % يبقون لي من عرض الدنيا فقط % 40(@)(@@) % الواهبين طعمة أرضهم % ما أخصب العام عليهم أو قحط % PageV01P1046 41(@)(@@) % والمانعين انفا جارهم % لم يلتصق بنسب ولم ينط % 42(@)(@@) % يحاط فيهم وهو ممنوع الحمى % % إذا تسمى باسمهم لو لم يحط % 43(@)(@@) % سادات مجد وإذا قست بهم % سيدهم باعد فضلا وشحط % 44(@)(@@) % جاء الحسين فاحتذى مثالهم % ثمت زاد جائزا تلك النقط % 45(@)(@@) % يشمخ ان ترفعه وراثة % علياء لم يرفع لها ولم يحط % 46(@)(@@) % كالليث لا تحلو له مضغة ما % % لم بفتلذ بكفه ويعتبط % 47(@)(@@) % مد إلى ناصية المجد يدا % % ينقبض المزن مكان تنبسط % 48(@)(@@) % تفدى بيسري لك إن أعجلتها % % بالجود يمنى كل رواغ ملط % 49(@)(@@) % يعطي مقلا ويضن مكثرا % وإنما أحسنت ظنا وقنط % 50(@)(@@) % وما يد البخيل إلا سوأة % متى بدتء بارزة فقل تغط % PageV01P1047 51(@)(@@) % ومنكر حقك لم تعلق به % من الوفاء شيمة ولمء تلط % 52(@)(@@) % أسفلته لو شكر العبد يدا % % غطى عليها بالجحود وغمط % 53(@)(@@) % لو شئت بعد غلطة الأيام في ار % % تقائه جازيته لما سقط % 54(@)(@@) % غرر إذ خاطرك الجهل به % ما كل من ابصر عشواء خبط % 55(@)(@@) % ما كنت إلا 
ms345	 جبلا ارسى ولا % % كان سوى سهم من الشر مرط % 56(@)(@@) % اسمع فما تؤثر أخبار العلا % % إلا شذوذا وهي عنك تنضبط % 57(@)(@@) % هل أنافي وصفك إلا ناقل % تملي سجاياك علي وأخط % 58(@)(@@) % أوانسا لولاك ما كنت بها % % ما فارقت حشمتها بمغتبط % 59(@)(@@) % كل نوار لم يفارق نزقة % أخمصها النعل وجنباها النمط % 60(@)(@@) % كم عنق وهي لها طوق وكم % من أذن تصغي لها وهي قرط % PageV01P1048 61(@)(@@) % أروضها لا نصبي ضاع ولا % % أجري فيها عند نعماك حبط % 62(@)(@@) % في كل يوم قاسم الحسن به % أقسط في غيري وفي شعري قسط % 63(@)(@@) % كن كسالى قبلكم لكنه % ما نشط الإحسان للشعر نشط % PageV01P1049 البحر : - 1(@)(@@) % بكرت هيما تحل الربطا % % تملك الماء على سرب القطا % % 2(@)(@@) % تحسب الأخفاف في أجنحة % طرن والجرجار منها اللغطا % % 3(@)(@@) % كل هوجاء ترى في حبلها % % من أبان منكبا منخرطا % % 4(@)(@@) % تصف المعقول منها ماردا % غل والناشط سهما مرطا % % 5(@)(@@) % ما رأت جزع أشي خوصها % % فرأت كف لعنق مضبطا % % 6(@)(@@) % ظمأ لا تبغين له % مشتكى إلا وسيعات الخطا % % 7(@)(@@) % فانه يا حابسها فضلالعصا % % إنما تأمر أمرا شططا % % 8(@)(@@) % وعلى الماء الذي جئت له % كل جم الأخذ منزور العطا % % 9(@)(@@) % يمنع الرشفة لا ترزأه % ويفري باللحاظ النبطا % % 10(@)(@@) % بارد الريق إذا مر سقى % % مرهف الجفن إذا هم سطا % % PageV01P1050 11(@)(@@) % يا فروع البان من وادي الغضا % % زادكن الله بي مختبطا % % 12(@)(@@) % أجتني حيث اجتنى الظبي العرا % % قي أو اعطي المنى حيث عطا % % 13(@)(@@) % وسقى الدمع وإلا فالحيا % % ذلك الملعب والمختلطا % % 14(@)(@@) % آه كم فيكن لي من نظرة % قتلت عمدا وكانت غلطا % % 15(@)(@@) % وفؤاد أبدا أرمي به % لعيون تستقل اللقطا % % 16(@)(@@) % ومقيل فرش اللهو به % فوقكن الأزر لي والريطا % % 17(@)(@@) % زمن ليت المنى ترجعه % لو بليت رد عيش فرطا % % 18(@)(@@) % كل يوم أتمنى وطرا % لم أكن أمس به مغتبطا % % 19(@)(@@) % أشتكي الآتي إلى الماضي ولا % % يعدم الأقرب لي ما شحطا % % 20(@)(@@) % قل لبيضاء توسعت بها % % قد تلثمنك صلا أرقطا % % PageV01P1051 21(@)(@@) % إنما كنت حساما حط في % % مفرقي 
ms346	 واسمك شيب وخطا % % 22(@)(@@) % أنكر الطراق منه قبسا % أعلق النار به من سلطا % % 23(@)(@@) % وتواصت رسل الألحاظ من % قبل أن تبلغه أن يسقطا % % 24(@)(@@) % قمت من نادي الهوى أندبه % شعرا صار برغمي شمطا % % 25(@)(@@) % ولئن هان ضعيفا ذاويا % قيما عز دهينا قططا % % 26(@)(@@) % وأخ والنوم في أجفانه % نحلة شنوا عليها المأقطا % % 27(@)(@@) % ومن الليل عليه فضلة % ميسم الصبح بها ما علطا % % 28(@)(@@) % وسطور الأفق قد جللها % % أزرق الفجر فعادت نقطا % % 29(@)(@@) % والثريا في وآخير الدجى % % هامة شمطاء غلت مشطا % % 30(@)(@@) % قلت قم قد يئست منا العلا % % فتمطى يوسد الكف المطا % % PageV01P1052 31(@)(@@) % ينفض الونية عن أعطافه % منفض المعقول لاقى منشطا % % 32(@)(@@) % ثم قال اطلب بنا غاياتها % % وتقحمها مخيضا مورطا % % 33(@)(@@) % قد مللنا الناس فاصفح عنهم % عرض هذا الملإ المنبسطا % % 34(@)(@@) % لا تقع إلا رءوسا فيهم % دع ذنابها لهم والوسطا % % 35(@)(@@) % فأثرناها رفيقي عزمة % شاكلت بينهما فاختلطا % % 36(@)(@@) % نأخذ الأرفع من طرق العلا % % ونعدي المنحني والمهبطا % % 37(@)(@@) % فوصلنا والعلا لم تختضع % باعتساف والذرى لم تلتطا % % 38(@)(@@) % نرد الغدر زلالا شبما % % ونفيء المجد ظلا سبطا % % 39(@)(@@) % والثرى أخضر لا يلبسه % جلدة الشهباء عام قحطا % % 40(@)(@@) % وإذا العوراء غطت وجهها % % عنك لم تلق على المال غطا % % PageV01P1053 41(@)(@@) % ليس إلا جفنة فهاقة % للقرى أو بازلا معتبطا % % 42(@)(@@) % غرر تجلو الدياجي ولهى % % يتفرجن الخطوب الضغطا % % 43(@)(@@) % نعم بانات صبا مطلولة % تطردالريح شمالا قطقطا % % 44(@)(@@) % تسرح الأبصار حيث اقترحت % والرجاء الرحب كيف اشترطا % % 45(@)(@@) % كل فضل عادل ميزانه % فإذا جاء عطاء فرطا % % 46(@)(@@) % لاا تعبس نعمة ضاحكة % قاسم الحظ بها ماغلطا % % 47(@)(@@) % رضي المقدار والحظ بها % % إن رضي حاسدها أو سخطا % % 48(@)(@@) % لبني عبد العزيز اجتهدت % بوجيف المنتقى والمرطى % % 49(@)(@@) % لمساميح حووا سقف العلا % % حصصا واقتسموه خططا % % 50(@)(@@) % كل وضاح قدامى دسته % قبل الآمالي تحفي البسطا % % PageV01P1054 51(@)(@@) % تبصر الغاشين حولي بابه % أبدا ركبا ورجلي سمطا % % 52(@)(@@) % لو مشى حولا على شوك القنا % % ورأى الضيم قعودا ما امتطى % % 53(@)(@@) % فإذا استصرخ في نازلة % سلط الآراء فيما سلطا % % 54 
ms347	(@)(@@) % قام تأويد الخلافات بهم % حادثات وسلافا فرطا % % 55(@)(@@) % وإذا لم يصبحوا أربابها % % وزروا فيها وكانوا الوسطا % % 56(@)(@@) % وإذا ما ولدوا بدرا جلا % % ظلم الأرض وبحرا غطمطا % % 57(@)(@@) % مثلما أحيا الندى فخر العلا % % واستراش الكرم المنجلطا % % 58(@)(@@) % ساكن الصدر ليان مسه % فرش البشر شعارا ووطا % % 59(@)(@@) % شائما فيها ظبا مبروة % يفتللن الصارم المخترطا % % 60(@)(@@) % مثل حيات النقا ما عرمت % كان مأكولا بها مسترطا % % PageV01P1055 61(@)(@@) % مبصرات فقر القول إذا % % ما ابن عشواء بليل خبطا % % 62(@)(@@) % تضبط الدنيا فإن سام يدا % ضم دينار أبت أن تضبطا % % 63(@)(@@) % وسعى طفلا فطالت يده % سوددا كهلهم المختلطا % % 64(@)(@@) % جئته والدهر قد أرصد لي % % من خفي الكيد ذئبا أمعطا % % 65(@)(@@) % وجروح اليأس في حالي سدى % % تقذف القيد وتعيي القمطا % % 66(@)(@@) % فوفى جذلان حتى ردني % % وقصارى غايتي أن تغبطا % % 67(@)(@@) % تأذخذ الأبصار مني شارة % تدع الشيخ فتى مستشرطا % % 68(@)(@@) % نعمة لو قعد الشكر بها % % بهرت وأشتهرت أن تغمطا % % 69(@)(@@) % فاتت الأملاك حتى منعت % كل راجي غاية أن يقنطا % % 70(@)(@@) % فاستمع تخبرك عني شرد % % تقطع الأرض الربى والغوطا % % PageV01P1056 71(@)(@@) % تدع الآمال إما روضة % سقيت أو عترة أو نمطا % % 72(@)(@@) % معدن كل لسان مفصح % حولها يسقط حتى تلقطا % % 73(@)(@@) % وإذا هجن القوافي نسبت % كانت العرب وكن النبطا % % 74(@)(@@) % وإذا النيروز ضمت عطفه % فترة هزته حتى يبسطا % % 75(@)(@@) % فابتدا بين يديكم قائما % لكم يفتح منها سفطا % % 76(@)(@@) % فاهتبلها تحفة وأنعم بها % % زائرا إما دنا أو شحطا % % PageV01P1057 البحر : - 1(@)(@@) % أصب برأيي أصاب الحظ أو غلطا % % فانهض له كسل المقدار أو نشطا % % 2(@)(@@) % ولا تفرط جلوسا في انتظار غد % فخير عزميك امر لم يكن فرطا % % 3(@)(@@) % خاتل يد الدهر وانصل غيلة أبدا % من حبله مارق الجنبين منخرطا % % 4(@)(@@) % ولا تشاوره في أمر هممت به % فربما لهوج الآراء أو خبطا % % 5(@)(@@) % أن قلت خذ بيدي في الخوف أرسلها % % أو قلت في الأمر دعني مرسلا ضبطا % % 6(@)(@@) % أبو العجائب ادوى أو شفا وكسا % % أو بر مرتجعا أو حل أو ربطا % % 7(@)(@@) % جب هذه الأرض إما 
ms348	 عشت محتشما % مؤملا فوقها أو عشت معتبطا % % 8(@)(@@) % إما ذنابى فلا تحفل بمنقصة % أو قمة الرأس فاحذر أن تقع وسطا % % 9(@)(@@) % فما الحياة وإن طالت بصالحة % لمن يعد متاعا بائرا سقطا % % 10(@)(@@) % ما خطة العجز والأرزاق معرضة % إلا لمن نام تحت الذل أو قنطا % % PageV01P1058 11(@)(@@) % يا أهل بابل لا طار الوفاء لكم % بعدي إذا سرت في جو ولا هبطا % % 12(@)(@@) % لأتركن رحيليعنكم سمة % شنغاء يعلط فيها العار ما علطا % % 13(@)(@@) % كم يمضغ البين لحمي بين أظهركم % وربما مل طول المضغ فاسترطا % % 14(@)(@@) % كأنني صعبة فيكم معبدة % بدت من السرح في واد وقد قحطا % % 15(@)(@@) % لا فرجة الرائحات السائمات لها % % ولا ترى ممسكا في الله مرتبطا % % 16(@)(@@) % وإن رأى ربها نشدانها وقعت % في جانب لم يعرف أهله اللقطا % % 17(@)(@@) % فهي لمثلي مقام عند مثلكم % وعند سفن الفلا الإرقاص والملطى % % 18(@)(@@) % والأرض حاملة ما شاء راكبها % % بزلاء ذات سنام تامك ومطا % % 19(@)(@@) % فلتأتينكم بالغيب هاجرة % يضحي بها ورق الأعراض مختبطا % % 20(@)(@@) % صوائبا كسهام النزع معتمدا % وافى لمقصده أو عائرا مرطا % % PageV01P1059 21(@)(@@) % تمضي فلا يملك الإعتاب رجعتها % % ومن يرد عقيلا بعد ما انتشطا % % 22(@)(@@) % باتت تخوفني الأخطار مشفقة % ترى الإقامة حزما والنوى غلطا % % 23(@)(@@) % هل تعلمين أمرأ ردت محالته % على الحفيظين ما خطا وما نقطا % % 24(@)(@@) % وهل رأيت الذي نجاه مجثمه % بعقوة الدار أو أرداه إن شحطا % % 25(@)(@@) % ما نحن إلا قطين الموت يعسف با % % لواني ويلحق بالسلاف من فرطا % % 26(@)(@@) % وطول أيامنا والدهر يطلبنا % % مراحل تنتهي أعدادها وخطا % % 27(@)(@@) % وقد كانت الدار دراي والكرام بها % % حماة سرحي وجيراني معي خلطا % % 28(@)(@@) % يحرموني فلا عودي بمهتصر % فيهم ولا خضر أوراقي لمن خرطا % % 29(@)(@@) % ويؤمنون بآياتي فيتبعهم % مقلدا من بغى فيها ومن غمطا % % 30(@)(@@) % صحبتهم وشبابي روضة أنف % ألوث منه برأسي فاحم قططا % % PageV01P1060 31(@)(@@) % مرفرفين على بري وتكرمتي % % حتى غدا شعري في لمتي شمطا % % 32(@)(@@) % لا الظن أكدي ولا أجدي بمدحهم % وحبهم حاس مثقالا ولا حبطا % % 33(@)(@@) % أجادل من بني عبد الرحيم علت % محلقات 
ms349	 وخلتني ومن سقطا % % 34(@)(@@) % لما رأت قلل الأطواد ساكنة % أولى بها عافت الأوطان والغوطا % % 35(@)(@@) % لو لم تكن أنجما للناس ما طلبت % ذرى الشواهق فاختطت بها خططا % % 36(@)(@@) % ناطوا منازلهم بالهضب نازحة % فقطعوا وحشة من قلبي النيطا % % 37(@)(@@) % كأنهم يوم ذموها مخيسة % كانت على كبدي أيدي المطي تطا % % 38(@)(@@) % بانوا بغبطة أيامي وكان بهم % عيشي كما اقترح المحبوب واشترطا % % 39(@)(@@) % فإن سألت زماني أن يعوضني % % بهم بديلا فقد كلفته شططا % % 40(@)(@@) % سعى إلينا كمال الملك غادية % وطفاء ترضي من الإعراض ما سخطا % % PageV01P1061 41(@)(@@) % إذا سرت روضت بالأرض أوجعلت % عرض البسيطة فيما بيننا بسطا % % 42(@)(@@) % كأنها بمجاري ذيلها رقمت % وشيا بنمنمة أو فوفت نمطا % % 43(@)(@@) % لها من الفكر إمداد بلا أمد % كأنما ماؤها من كفة انبسطا % % 44(@)(@@) % ترد معرضة الأسماع مقبلة % والجعد من كل فهم لينا سبطا % % 45(@)(@@) % تميس فيها سجاياه فتحسبها % % كواعب الحي قامت تحمل الريطا % % 46(@)(@@) % جزاء ما حاط لي من حرمة ورعى % % عهدا وما مد من نعمى وما بسطا % % 47(@)(@@) % فتى يرى يدي العليا على يده % % إذا سألت نوالا أو قبلت عطا % % 48(@)(@@) % أفادني العز في الجدوى فصيرني % % على انقباضي إلى جدواه منبسطا % % 49(@)(@@) % رد الكمال حبيسا في حبائله % عبدا فأطلق عن يدي الندى الربطا % % 50(@)(@@) % لو كان خلق الندى مما يجاد به % حباك أخلاقه جذلان مغتبطا % % PageV01P1062 51(@)(@@) % خلائق تحبس الغادي لحاجته % طيبا وتستنزل الأحداج والربطا % % 52(@)(@@) % كان خمار بصرى بات يسكبها % % أو فض عطار دارين بها سفطا % % 53(@)(@@) % حلو جناها إذا عاذ الصديق بها % % وحنظل من أعاديها لمن خبطا % % 54(@)(@@) % سهولة الماء فيها رقة وندى % % وقسوة النار فيها هيبة وسطا % % 55(@)(@@) % إذا حمى أقسطت أحكام صارمه % وإن همى قاسما أمواله قسطا % % 56(@)(@@) % إذا استجموه لم تضغطه جلسته % توحشا أو دعوه فرج الضغطا % % 57(@)(@@) % كالسيف تلبس منه مغمدا شرفا % وشارة ويقيك الشر مخترطا % % 58(@)(@@) % كفى القبيل وحيد لا قرين له % وساد أمرد من بالشيب قد وخطا % % 59(@)(@@) % قد ارهقوه فلا جبنا ولا جزعا % واستخطبوه فلا عيا ولا لغطا 
ms350	 % % 60(@)(@@) % إذا استغشوا فلول السيف واتهموا % % من الذوابل محطوما ومنتحطا % % PageV01P1063 61(@)(@@) % سلت يداه وعين الحرب راقدة % لهم أساود يقسمن الردى رقطا % % 62(@)(@@) % ضموا إلى تارد العلياء طارفها % % تمازج الكسب والميراث واختلطا % % 63(@)(@@) % بنت له فارس بيتا دعامته % في الأفق لا بين ذي طلح وذي الأرطا % % 64(@)(@@) % قوم قرى ضيفهم عقر البدور إذا % % غدا قرى المعتمين السمن والأقطا % % 65(@)(@@) % إذا احتبت حلقة النادي بعزهم % نصوا الدسوت ومدوا دونها السمطا % % 66(@)(@@) % كنتم رضاي عن الدنيا فلو حفظت % من النوى شملكم لم أعرف السخطا % % 67(@)(@@) % تركتم عيشتي بلهاء عاطشة % في مجهل سبسب ينسي القطاة قطا % % 68(@)(@@) % قد عرق الدهر عظمي بعد فرقتكم % من بعد ماخر من جلدي وما كشطا % % 69(@)(@@) % فلاحظوني على بعد المزار بما % % يكون سترا على عوراته وغطا % % 70(@)(@@) % فليس بيني وبين الرزق غيركم % إن جل أو دق سفار ولا وسطا % % PageV01P1064 71(@)(@@) % واسمع لها أنت خير السامعين لها % % عذراء ما طر معناها ولا لقطا % % 72(@)(@@) % مزفوفة لم يضيعها حواضنها % % زورا ولم تعرف المدري ولا المشطا % % 73(@)(@@) % تغني بشافعها من حسنها أبدا % عن التحسن مستجلى ومشترطا % % 74(@)(@@) % كأنها لعلوق السامعين بها % % تهدي إلى كل سمع عاطل قرطا % % 75(@)(@@) % للمهرجان بها والعيد سارية % ظهرا ينقلها رفعا ومنهبطا % % 76(@)(@@) % يومان إن خولفت جنسا هما فلقد % تناسبا في اجتماع السعد وارتبطا % % 77(@)(@@) % للفرس والعرب من شأنيهما شرف % يرد خزيا على اعقابها النبطا % % 78(@)(@@) % فطاول الدهر مغبوطا بحفظهما % % في ظل نعماء من دامت له غبطا % % PageV01P1065 البحر : - 1(@)(@@) % ما نازل بمن علا % % وصاعد بمن هبط % 2(@)(@@) % دان على رأي العيو % % ن وهو إن ريم شطط % % 3(@)(@@) % فهو إذا درجته % فوق وتحت ووسط % % 4(@)(@@) % جسم له وجهان ما % % شاء الجمال اشترط % % 5(@)(@@) % وأعين لم يحصه % % ن بحساب من ضبط % % 6(@)(@@) % يقل فيهن المصي % % ب والكثير من غلط % 7(@)(@@) % لا تسع الدنيا له % بعضا ولا سير يحط % PageV01P1066 البحر : - 1(@)(@@) % هبت ومنها الخلاب والخدع % تأخذ مني باللوم أو تدع % 2(@)(@@) % لأهبة السير لا تطير مع الذ % % كر بها لوعة ولا 
ms351	 تقع % 3(@)(@@) % لم يختلب جنسها الوداع ولا أه % % تزت لها خلف ظاعن ضلع % 4(@)(@@) % قبلك أعيت عواذلي أذني % % اي صفات بالعذل تنصدع % 5(@)(@@) % في سلف الرائحين جائرة % تسمع أحكامها فتتبع % 6(@)(@@) % لها سوادا قلبي وطرفي فما % % يغرب فيها دمعي ولا الجزع % 7(@)(@@) % حوراء ود الظبي المكان الذي % % تنظر منه والظبي مرتبع % 8(@)(@@) % صحح رقي حب الوفاء لها % % ومهجتي في لحاظها قطع % 9(@)(@@) % بانت بحلو المنى وعيشي وآ % % تي العيش ماض ولو كان يرتجع % 10(@)(@@) % وعلمت طيفها الصدود وقد % كنت بأفك الأحلام أقتنع % PageV01P1067 11(@)(@@) % وليلة النعف والسرى آمر % بالنوم والشوق زاجر يزع % 12(@)(@@) % أكرهت عيني على الكرى رقب ال % % طيف ونومي أولاه ممتنع % 13(@)(@@) % فما وفت شيمة ملونة % تستن في غدرها وتبتدع % 14(@)(@@) % حتى تمنيت لو سهرت مع الر % كب وود السارون لو هجعوا % % 15(@)(@@) % شيبني قبل ان كبرت له % حب لظمياء ناشئ يفع % 16(@)(@@) % يأخذ ما تأخذ السنون من ال % % جسم ولا يترك الذي تدع % 17(@)(@@) % آه لشمطاء لا هي الشعر % برأسي ولا هي الصدع % 18(@)(@@) % تؤذنني بالمدى وتخرق من % عمري ولا تسده الرقع % 19(@)(@@) % صحبت منها يبس الرفيق ويا % % ليت افترقنا من فبل نجتمع % 20(@)(@@) % كصاحب البلدة القواء أخو % % ه الذئب فيها وجاره السبع % PageV01P1068 21(@)(@@) % قالوا ارتدع إنه البياض وقد % كنت بحكم السواد أرتدع % 22(@)(@@) % لم ينقل الشيب لي طباعا ولا % % دنسني قبل صقله طبع % 23(@)(@@) % نفسي أحجى من أن تحلم بال % % وعظ وقلبي بالمجد مضطلع % 24(@)(@@) % وإن هوى بي أو حطني حمق ال % % حظ فهمي يسمو ويرتفع % 25(@)(@@) % صدقت دهري عني ليعرفني % % لو كنت فيه بالصدق أنتفع % 26(@)(@@) % وقلت مل بي عن طرق مسألة الن % ناس وقدنى فإنني تبع % 27(@)(@@) % جربت قوما وفاؤهم بارق ال % % خلب لا يمطرون إن لمعوا % % 28(@)(@@) % في العسر واليسر يمنعون فإن % أعطوا تنميت أنهم منعوا % % 29(@)(@@) % طمعت فيهم حتى يئست ما ال % % يائس سوى ما أفادك الطمع % 30(@)(@@) % فاقعد إذا السعي جر مهضمة % وجع إذا ما أهانك الشبع % PageV01P1069 31(@)(@@) % وصاحب كاليد الشليلة لا 
ms352	 % % يدفع شيء بها فيندفع % 32(@)(@@) % مشى جوادا معي فحين علا % % تجمعت لي بوده ضبع % 33(@)(@@) % حملت نفسي عنه عزوفا وقد % يحمي فيمشي بثقله الظلع % 34(@)(@@) % وقلت باب الإله إن ضقت مف % % توح وهذا الفضاء متسع % 35(@)(@@) % وفي وفاء الحلو الوفاء ابن أي % وب مراد كاف ومنتجع % 36(@)(@@) % مولى يدي والحسام يسلمها % % وناصري يوم تخذل الشيع % 37(@)(@@) % علقت منه شرر القوى مرس ال % % فتل وحبل الآمال منقطع % 38(@)(@@) % أبلج يعدي الدجى سناه فتب % % يض إذا خاضها وتنتصع % 39(@)(@@) % راض العلا قارح العزيمة واس % % تظهر حتى كأنه جذع % 40(@)(@@) % مسدد النطق مستريب بما % % قال من الحق آمن فزع % PageV01P1070 41(@)(@@) % يطلعه نجد كل مشكلة % رأي وراء الغيوب مطلع % 42(@)(@@) % عن على قدرة وجاد وجو ال % % جدي جعد الأرواح منقشع % 43(@)(@@) % وشد منه ملك الإمامين جل % % د المتن لا عاجز ولا ضرع % 44(@)(@@) % ينصح لله والخلافة لا % % يرفع في شهوة ولا يضع % 45(@)(@@) % وزارة مذ اتيتها عاشت الس % نة فيها وماتت البدع % 46(@)(@@) % تشهد لي أنها اليقين قضا % % يا الله والمسلمون والجمع % 47(@)(@@) % وزرتهم وارثا اباك فما ار % % تابوا بما أصلوا وما افترعوا % % 48(@)(@@) % واغترسوا عرقك الكريم فما % % أطيب ما أستثمروا الذي زرعوا % % 49(@)(@@) % كان اصطناعا على تمنعه % منهم بمن قدموا وما اصطنعوا % % 50(@)(@@) % كنت لسانا يقضي إذا نطقوا % % قضاء أرماحهم إذا شرعوا % % PageV01P1071 51(@)(@@) % وسنة تدفع المخالف عن % دعوتهم مذ هم بك ادرعوا % % 52(@)(@@) % فضل طريف منه ومتلد % تنقله حاكيا وتخترع % 53(@)(@@) % وحدك الناس في الدعاء ولو % % ثنوا لضلوا إفكا ولو جمعوا % % 54(@)(@@) % وأطنب المادحون فيك بما % % صاغوا من السائرات أو رصعوا % % 55(@)(@@) % ولم يقولوا إلا بما علموا % % ولا رووا فيك غير ما سمعوا % % 56(@)(@@) % فليبق للناس منك من أطبق الن % اس عليه في الفضل واجتمعوا % % 57(@)(@@) % ولتجتنب ربعك الخطوب وفي % % قوم مصيف لها ومرتبع % 58(@)(@@) % وليغش منك النيروز أكرم من % حط إليه الوفود أو رفعوا % % 59(@)(@@) % يوم جواد حكاك حتى على ال % % ترب حلى من جداه أو خلع % 60(@)(@@) % يعطيك بشرى الخلود ما 
ms353	 طفقت % تحتجب الشمس ثم تطلع % PageV01P1072 61(@)(@@) % وليفد كفيك مغلق اليد مخ % % فور النواحي بالبخل ممتنع % 62(@)(@@) % ما عنده في المهم يطرقه % جد ولا بالندى له ولع % PageV01P1073 البحر : - 1(@)(@@) % صدق الوشاة العهد عندك ضائع % لو كان يوعظ يك قلب سامع % 2(@)(@@) % قلتالتعاتب وهو هجرةليلة % ثم استمر وزاد فهو تقاطع % 3(@)(@@) % تحتك نفس تطمئن إذا الهوى % % ترك النفوس إليك وهي نوازع % 4(@)(@@) % ومدامع يبس النواحي كلما % % بلت عليك من الحفاظ مدامع % 5(@)(@@) % أهوى المليحة كل ما أحرزته % بك ضائر أفأنت يوما نافع % 6(@)(@@) % قسما لئن رد الشباب وجاهه % ما قد علمت فما إليها شافع % 7(@)(@@) % أعدوة والحب أنت وإنما % % تعصين فيك إن أحبك طائع % 8(@)(@@) % شهد الوفاء بأنني لو خنته % ما كان يجمعني وعهدك جامع % 9(@)(@@) % عادات أيامي اللئيمة غادرت % نعمي بمن أهوى وهن فجائع % 10(@)(@@) % دميت قروحك يا جريح زمانه % تحت الحمول أما لخرقك راقع % PageV01P1074 11(@)(@@) % نظرا لنفسك ما حياؤك كاشف % عنك الهوان وما احتشامك دافع % 12(@)(@@) % سالمت دهري قبل أعلم أنه % فيمن يهادنه السلامة طامع % 13(@)(@@) % فالآن أصميه بسهم ما له % في قلبه إلا المنية نازع % 14(@)(@@) % , , يزدانفادار وليس بمدع % من قال لابن الشمس نورك ساطع % 15(@)(@@) % لا قرن لي وعلي منه وفي يدي % % درع مضاعفة وسيف قاطع % 16(@)(@@) % في , , فارس نسب يجاذب فجره % ما فيه لابن المزربان منازع % 17(@)(@@) % لله درك واهبا متبرعا % وسواك مرغوب إليه مانع % 18(@)(@@) % لم يؤت من حظ الشجاعة ساهر % فيها الذي تؤتى وطرفك هاجع % 19(@)(@@) % وكم انتضيت من الدواة مهندا % خطراته بالدارعين وقائع % 20(@)(@@) % ميت له بالنفس نفس حية % ظام وفي شفتيه ماء مائع % PageV01P1075 21(@)(@@) % يجرى غداة النيل أسود كالحا % وكأنه للنقع أصفر فاقع % 22(@)(@@) % يفديك قوم يستغيثك كلما % % خابت وسائل عندهم وذرائع % 23(@)(@@) % باعوا المحامد بالثراء وحسبهم % خسران صفقة ما اجتناه البائع % 24(@)(@@) % اليوم عيد من الملوك جدوده ال % % ماضون حق مستفيض شائع % 25(@)(@@) % كم من نصيب للخلافة عندنا % % في مثله , , رمضان منه مانع % 26(@)(@@) % فالبس له حلل المعمر بعده % في العز ما 
ms354	 نجم الهلال الطالع % 27(@)(@@) % واسمع كما انتظم الفريد ورق ما % % ء غمامة وصفا الفرند اللامع % 28(@)(@@) % بنت الليالي السود أسهرني لها % % حفظ الأيادي البيض وهي ودائع % 29(@)(@@) % لما رأيت الدهر ضاق وأهله % عني وعندك لي فناء واسع % 30(@)(@@) % حصنت باسمك جانبي تعوذا % % فليصنع الحدثان ما هو صانع % PageV01P1076 البحر : - 1(@)(@@) % لأية لبسة خلع الخلاعه % وكان عصى العذول فلم أطاعه % 2(@)(@@) % تلثم كالغمامة أعجبته % فشام خلالها برقا فراعه % 3(@)(@@) % وغالى في ابتياع صبا شرته ال % % ليالي منه مرتخصا فباعه % 4(@)(@@) % قليلا ما حملت عليه ودا % % قليلا مذ أحبك ما أضاعه % 5(@)(@@) % نزلنا في , , بنى ساسان دورا % بها تسلى بيوتك في , , قضاعه % 6(@)(@@) % وعوض كل يوم منك حولا % يسر فكان يوم البين ساعه % 7(@)(@@) % ألا يا صاحبي إن ناب خطب % دفعت به فأحسن بي دفاعه % 8(@)(@@) % نشدتك والكرى بيد الليالي % % إذا أهدته أسرعت إرتجاعه % 9(@)(@@) % أكان سوى الوزير بنا وقلنا % % لماء المزن جد إلا رباعه % 10(@)(@@) % إليه صرفت عن ذا الناس نفسي % % كما اعتزلت تألفها القناعه % PageV01P1077 11(@)(@@) % أقول لهمة لو قيل مدي % % بباع النجم لم ترض ارتفاعه % 12(@)(@@) % إذا ما الضيم رابك فاستجيري % % ذرا , , سابور وانتجعي بقاعه % 13(@)(@@) % ثقي ولوأن حاجتك , , الثريا % % إذا ما الليث مد له ذراعه % 14(@)(@@) % فدى البخلاء والجنباء منهم % فتى وصل السماحة بالشجاعه % 15(@)(@@) % زكنت إليه ظنا صار حقا % وكم وقفت براكبها الطماعه % 16(@)(@@) % وزرت فقمت بين يدي كريم % تحول قوى بحضرته الضراعه % 17(@)(@@) % صفا ماءوزدت على الهوينا % % صفا ما رمت في أمر خداعه % 18(@)(@@) % أقول لسائلي بك وهو ناء % كأن لم يرض من خبر سماعه % 19(@)(@@) % أمامك ملك , , آل ويه فاسأل % بذاك الشمل من ولي اجتماعه % 20(@)(@@) % ومن لو أبصر الأعداء وحشا % % تعقبه فصاد لهم سباعه % PageV01P1078 21(@)(@@) % ولو زحموا , , ثبيرا في مضيق % ألان على مناكبهم صراعه % 22(@)(@@) % لقد أعطيت عدل الحق حتى % % لخلتك تقسم الدتيا المشاعه % 23(@)(@@) % وما ملك يمد الرأى إلا % فتى وصلت قناة الخط باعه % 24(@)(@@) % ولا أولادك الأوضاح إلا % وفودالفجر أحرزت الصداعه % 25(@)(@@) % هو البيت 
ms355	 اطمأن المجد فيه % فألقى واستقر به متاعه % 26(@)(@@) % ومن حسناتهم ذا اليوم عيد % حووا سبقا بفضلهم اختراعه % 27(@)(@@) % وشرفهم بفضلك ألف عام % فأمنك الغذون انقطاعه % 28(@)(@@) % لعلك ناظر في حال عبد % بعين الرأى كيف ترى اصطناعه % 29(@)(@@) % أعر لسنى سماعك كيف أشكو % % وأظلم ذاك من حظى ضياعه % 30(@)(@@) % يؤخرني القريض لدى أناس % ركبت إلى مدائحهم شراعه % PageV01P1079 31(@)(@@) % قصائد لو سبقت بهن حتى % % أصيرهن في سفر بضاعه % 32(@)(@@) % شريت جمال , , يوسف وهو راض % بهن وعدت فاستثنيت صاعه % 33(@)(@@) % وكم أغمدتها وسللت أخرى % % برعت بها فلم تجد البراعه % 34(@)(@@) % بخست كتابة وحرمت شعرا % فهل من ثالث لي من صناعه % 35(@)(@@) % أميل على الكراهة مع أناس % كما مالت مع الريح اليراعه % 36(@)(@@) % وما إن كدني إلا ارتكاض % على رزق يجيء بلا شفاعه % 37(@)(@@) % فإن يدرك فأنت له وإلا % فليس علي إلا الاستطاعه % PageV01P1080 البحر : - 1(@)(@@) % على أي لائمة أربع % وفي أيما سلوة أطمع % 2(@)(@@) % وقد أخذ العهد يوم الرحيل % أمامي والعهد مستودع % 3(@)(@@) % فقصرك يا خادعي من وفائي % % لؤمت أعن كرمي أخدع % 4(@)(@@) % ويا صاحبي والنوى بيننا % % ضلال فطرق الهوى مهيع % 5(@)(@@) % لأمر أخوك غدا صامتا % على أنه الخاطب المصقع % 6(@)(@@) % سقى الغيث بغداد إما سقى % % لذكرتها جد بي المدمع % 7(@)(@@) % وحيا بها قمرا استق % % ر بعد فراقي به مطلع % 8(@)(@@) % رأى شهر بعدي محاقا له % فلم يغنه العشر والأربع % 9(@)(@@) % ونوم على الطيف عاهدته % وقد زار لو أنني أهجع % 10(@)(@@) % ضحكت أهون بيني عليه % وعبس يزرى بمن يفجع % PageV01P1081 11(@)(@@) % أغرك بعد فراق الوزي % % ر أني لضرب النوى أخضع % 12(@)(@@) % أسير وضلع الهوى عند من % تفر لفرقته الأضلع % 13(@)(@@) % وأسكن من وطني بعده % إلى حسرة فلما تقلع % 14(@)(@@) % وفي ضمن فرحة عوذي جوى % يدل على أنني موجع % 15(@)(@@) % , , أكافينا كافي الحادثا % % ت سودا لنا سمرها شرع % 16(@)(@@) % بك انتصر الأدب المستضام % وأنشر ميته المضجع % 17(@)(@@) % سفرت بفضلك عن وجهه % وظل الخمول له برقع % 18(@)(@@) % إذا المدح ناداه شوقا إليك % فناداه بطئي إذا أسرع % 19 
ms356	(@)(@@) % فتحت بجودك عينا ترى % % وفودك أو أذنا تسمع % 20(@)(@@) % أرى مقصدا ثم علي % % ه عين بعود المرجع % PageV01P1082 21(@)(@@) % وقد هزني والدجى مسبل % وأسهرني والورى هجع % 22(@)(@@) % حوادث تخشى صميم الفؤاد % لها في صميم الصفا مصدع % 23(@)(@@) % فلا ربعة زادها مشبع % يغذي ولا نهلة تنفع % 24(@)(@@) % سأهجر دارك لا عن قلى % كما يهجر المرتع المربع % 25(@)(@@) % أودع دارك عن خبرة % بأي غرام غدا أودع % 26(@)(@@) % فجودك بالعذر العرف لي % % سماحان هذا وذا يوسع % 27(@)(@@) % سينسب حسن وقبح إلي % % ك حاشاك يقبح ما تصنع % 28(@)(@@) % ويسأل عن ربحي المبضعون % وغيرك يخسر ما أبضع % 29(@)(@@) % رحلت ولم أبقي خلقا سواي % % إذا اندفع القول لا يدفع % 30(@)(@@) % وسقت إليك لسان , , العراق % وإنك للشاهد المقنع % PageV01P1083 31(@)(@@) % لسان يصرفه في الرجال % طريق على غيره مسبع % 32(@)(@@) % إذا هو أحمد فالشهد من % % ه والسم من ذمه منقع % 33(@)(@@) % وما ينظر الناس ماذا رحلت % ولكن يراعون ما أرجع % 34(@)(@@) % وود أوامرك العاليات % فتى حافظ كل ما يودع % 35(@)(@@) % يسرك ما اصطنعته يداك % إذا ضاع في غيره المصنع % 36(@)(@@) % تهنأ بقابل شهر الصيام % وأحصده خيرا كما تزرع % 37(@)(@@) % تلابطه شره الظالمين % وأنت له خاشعا تخشع % 38(@)(@@) % وسرك منه الذي ساءهم % لحفظك في الله ما ضيعوا % % 39(@)(@@) % ولما برزت ترأى الهلال % مضى آيسا منه من يطمع % 40(@)(@@) % لأنهم أنكروا أن يروا % % هلالا على قمر يطلع % PageV01P1084 البحر : - 1(@)(@@) % هل بعد مفترق الأظعان مجتمع % أم هل زمان بهم قد فات يرتجع % 2(@)(@@) % تحملوا تسع البيداء ركبهم % ويحمل القلب فيهم فوق ما يسع % 3(@)(@@) % مغربين هم والشمس قد ألفوا % % ألا تغيب مغيبا حيثما طلعوا % % 4(@)(@@) % شاكين للبين أجفانا وأفئدة % مفجعين به أمثال ما فجعوا % % 5(@)(@@) % تخطو به فاترات في أزمتها % % أعناقها تحت إكراه النوى خضع % 6(@)(@@) % تشتاق نعمان لا ترضى بروضته % دارا ولو طاب مصطاف ومرتبع % 7(@)(@@) % فداء وافين تمشي الوافيات بهم % دمع دم وحشا في إثرهم قطع % 8(@)(@@) % الليل بعدهم كالفجر متصل % ما شاء والنوم مثل الوصل منقطع % 9(@)(@@) % ليت الذين أصاخو 
ms357	 يوم صاح بهم % داعي النوى ثوروا صموا كما سمعوا % % 10(@)(@@) % أوليت ما أخذ التوديع من جسدي % % قضى علي فللتعذيب ما يدع % PageV01P1085 11(@)(@@) % وعاذل لج أعصيه ويأمرني % % فيهم وأهرب منهم وهو يتبع % 12(@)(@@) % يقول نفسك فاحفظها فإن لها % % حقا وإن علاقات الهوى خدع % 13(@)(@@) % روح حشاك ببرد اليأس تسل به % ما قيل في الحب إلا أنه طمع % 14(@)(@@) % والدهر لونان والدنيا مقلبة % الآن يعلم قلب كيف يرتدع % 15(@)(@@) % هذي قضايا رسول الله مهملة % غدرا وشمل رسول الله منصدع % 16(@)(@@) % والناس للعهد ما لاقوا وما قربوا % % وللخيانة ما غابوا وما شسعوا % % 17(@)(@@) % وآله وهم آل الإله وهم % % رعاة ذا الدين ضيموا بعده ورعوا % % 18(@)(@@) % ميثاقه فيهم ملقى وأمته % مع من بغاهم وعادهم له شيع % 19(@)(@@) % تضاع بيعته يوم الغدير لهم % بعد الرضا وتحاط الروم والبيع % 20(@)(@@) % مقسمين بأيمان هم جذبوا % % ببوعها وبأسياف هم طبعوا % % PageV01P1086 21(@)(@@) % ما بين ناشر حبل أمس أبرمه % % تعد مسنونة من بعده البدع % 22(@)(@@) % وبين مقتنص بالمكر يخدعه % عن آجل عاجل حلو فينخدع % 23(@)(@@) % وقائل لي علي كان وارثه % بالنص منهن فهل أعطوه أم منعوا % % 24(@)(@@) % فقلت كانت هنات لست أذكرها % % يجزي بها لله أقواما بما صنعوا % % 25(@)(@@) % أبلغ رجالا إذا سميتهم عرفوا % % لهم وجوه من الشحناء تمتقع % 26(@)(@@) % توافقوا وقناة الدين مائلة % فحين قامت تلاحوا فيه واقترعوا % % 27(@)(@@) % أطاع أولهم في الغدر ثانيهم % وجاء ثالثهم يقفو ويتبع % 28(@)(@@) % قفوا على نظر في الحق نفرضه % والعقل يفصل والمحجوج ينقطع % 29(@)(@@) % بأي حكم بنوه يتبعونكم % وفخركم أنكم صحب له تبع % 30(@)(@@) % وكيف ضاقت على الأهلين تربته % وللأجانب من جنبيه مضطجع % PageV01P1087 31(@)(@@) % وفيم صيرتم الإجماع حجتكم % والناس ما اتفقوا طوعا ولا اجتمعوا % % 32(@)(@@) % أمر علي بعيد من مشورته % مستكرة فيه والعباس يمتنع % 33(@)(@@) % وتدعيه قريش بالقرابة وال % % أنصار لا رفع فيه ولا وضع % 34(@)(@@) % فأي خلف كخلف كان بينكم % لولا تلفق أخبار وتصطنع % 35(@)(@@) % واسألهم يوم خم بعد ما عقدوا % % له الولاية لم خانوا ولم خلعوا % % 36(@)(@@) % قول صحيح ونيات بها 
ms358	 نغل % لا ينفع السيف صقل تحته طبع % 37(@)(@@) % إنكارهم يا أمير المؤمنين لها % % بعد اعترافهم عار به ادرعوا % % 38(@)(@@) % ونكثهم بك ميلا عن وصيتهم % شرع لعمرك ثان بعده شرعوا % % 39(@)(@@) % تركت أمرا ولو طالبته لدرت % معاطس راغمته كيف تجتدع % % 40(@)(@@) % صبرت تحفظ أمر الله ومااطرحوا % % ذبا عن الدين فاستيقظت إذ هجعوا % % PageV01P1088 41(@)(@@) % ليشرقن بحلو اليوم مر غد % إذا حصدت لهم في الحشر ما زرعوا % % 42(@)(@@) % جاهدت فيك بقولي يوم تختصم ال % % أبطال إذ فات سيفي يوم تمتصع % 43(@)(@@) % إن اللسان لوصال إلى طرق % في القلب لا تهتديها الذبل الشرع % 44(@)(@@) % آباي في فارس والدين دينكم % حقا لقد طاب لي أس ومرتبع % 45(@)(@@) % ما زلت مذ يفعت سني ألوذ بكم % حتى محا حقكم شكي وأنتجع % 46(@)(@@) % وقد مضت فرطات إن كفلت بها % % فرقت عن صحفي البأس الذي جمعوا % % 47(@)(@@) % سلمان فيها شفيعي وهو منك إذا ال % % آباء عندك في أبنائهم شفعوا % % 48(@)(@@) % فكن بها منقذا من هول مطلعي % % غدا وأنت من الأعراف مطلع % 49(@)(@@) % سولت نفسي غرورا إن ضمنت لها % % أني بذخر لك سوى حبيك أنتفع % PageV01P1089 البحر : - 1(@)(@@) % يقولون يوم البين عينك تدمع % دعوا مقلة تدري غدا من تودع % 2(@)(@@) % ترى بالنوى الأمر الذي لا يرونه % هوى فيقولون الذي ليس تسمع % 3(@)(@@) % إذا كان للعذال في السمع موضع % مصون فما للحب في القلب موضع % 4(@)(@@) % يرى القوم فيهم أن مسراهم غذا % صدقتك إني من غد لمروع % 5(@)(@@) % لك الله موضوع اليدين على الحشا % % صباحا وبيضات الهوادج ترفع % 6(@)(@@) % ودون انصداع الشمل لو يسمعونه % أنين حصاة القلب منه تصدع % 7(@)(@@) % أعد ذكر نعمان أعد إن ذكره % % من الطيب ما كررته يتضوع % 8(@)(@@) % فإن قر قلبي فاتهمه وقل له % بمن أنت بعد العامرية مولع % 9(@)(@@) % أمنقاد أحلام الكرى أن تسره % سهرنا فسل حسناء إن كنت تهجع % 10(@)(@@) % أرميا على الهجران والشيب واخط % فهلا وفي قوس الشبية منزع % PageV01P1090 11(@)(@@) % رويدك لو كانت سوى الحب خطة % لأعياك أني الخاشع المتضرع % 12(@)(@@) % سلي الدهر عن حملي 
ms359	 تفاوت ثقله % وصبري على أحداثه وهو يجزع % 13(@)(@@) % وتوقير نفسي عن حظوظ كثيرة % يخف إليها الحامل المتسرع % 14(@)(@@) % وما خشنت إلا وقلت دعي غدا % % لكل غد رزق مع الشمس يطلع % 15(@)(@@) % رشادك خير الكسب ما جر سوددا % عليك وميسور من العيش يقنع % 16(@)(@@) % وإلا صديقا كان أيوب حافظا % بحيث السواد في الفؤاد مضيع % 17(@)(@@) % حمى الله والمجد الصريح ابن حرة % حماني وأرماح الحوادث شرع % 18(@)(@@) % وناديت إخواني فأقبل وحده % علي فلباني وكلهم دعوا % % 19(@)(@@) % من السابقين نجدا إن تحمسوا % % لحفظ حمى أو عفة إن تورعوا % % 20(@)(@@) % لهم قضب فلوا بها قضب الوغى % % مغامدها أيديهم حين تقطع % PageV01P1091 21(@)(@@) % أراقم لا ترجو الرقاة اختداعها % % ولا يبلغ الدرياق موضع تلسع % 22(@)(@@) % طلبنا فما جازت أبا طالب بنا % % منى شطط ولا رجاء موسع % 23(@)(@@) % وطرنا بهمات تحوم على العلا % % فلما تراءى صاح رائدنا قعوا % % 24(@)(@@) % خلفت به من كل رث وداده % كثوب العدا ينعط وهو يرقع % 25(@)(@@) % فعش لي أقلدك الجزاء مراسلا % على العرض لا مازين سوق وأذرع % 26(@)(@@) % إذا زانت الدر اليتيمة أصبحت % بعيدة يتم من معان ترصع % 27(@)(@@) % لها أرج في السمع باق وإن غدت % يخب بها نقع الرواة ويوضع % 28(@)(@@) % على أوجه الأعياد ميسم حسنها % % من اسمك سطر في الجباه موقع % 29(@)(@@) % أراغم دهري بالحفاظ عليكم % وحافظ قوم آخرين مضيع % 30(@)(@@) % وقال غوي إن في الناس مثلكم % فقلت له غيري بمثلك يخدع % PageV01P1092 البحر : - 1(@)(@@) % إذا رضيت رباك عن الربيع % فأهون ما أدل به دموعي % % 2(@)(@@) % أدار الحب إذ خنساء جار % ورامة ملعب العيش الخليع % 3(@)(@@) % وأتراب الهوى متزاورات % سريعات الأفول من الطلوع % 4(@)(@@) % ليالي إذ ليالي من شبابي % % شواعب حين أدنت من صدوعي % % 5(@)(@@) % إذا صدت لتهجرني شموس % سفرت فكان من وجهي شفيعي % % 6(@)(@@) % وقفنا نستعيدك ما ألفنا % % وأين ذهاب أمسك من رجوع % 7(@)(@@) % ويبكي نازل الطراق منا % % فيصبغها دموعا من نجيع % 8(@)(@@) % وما خمدت بذي العلمين نار % يشيم ضيوف موقدها ضلوعي % % 9(@)(@@) % ونابذة مع الحصيات عهدي % % وكان لها مكان يد 
ms360	 الضجيع % 10(@)(@@) % إذا قاضيتها أخذت بعدل % لحسن الوجه من قبح الصنيع % PageV01P1093 11(@)(@@) % وليل قد سهرت وكم سهاد % أحب إلى العيون من الهجوع % 12(@)(@@) % وخوانين منفردين عني % % فما نقص الوحيد عن الجميع % 13(@)(@@) % وعاذلة تمد حبالها لي % % وطرت فأين حبلك من وقوعي % % 14(@)(@@) % تلوم على النزاهة وهي تدري % % بأن قناعتي حسمت قنوعي % % 15(@)(@@) % وقافية جمعت لها شرودا % % بها ووصلت حبل أخ قطوع % 16(@)(@@) % ترى البيت الجديد يهز منها % % معاوده على سمع رجيع % 17(@)(@@) % وسوق للكساد شريت فيها % % بديع البيع بالحمد البديع % 18(@)(@@) % فلو شهد ابن أيوب مقامي % % نجوت بمصرخ منه سميع % 19(@)(@@) % إذن لحمى يدي وحمى جناني % % أخ لا بالخؤون ولا بالخدوع % 20(@)(@@) % فتى يده على خللي ودائي % % يد الراقي على العضو اللسيع % PageV01P1094 21(@)(@@) % أتاني رائدي بالصدق عنه % فها أنا منه أرتع في ربيع % 22(@)(@@) % صفا لقبيل أيوب غديري % % ولان على مقادتهم منيعي % % 23(@)(@@) % إذا ما الناس كنت لهم ببعضي % % مماذقة محضت لهم جميعي % % 24(@)(@@) % فداؤك حاسدوك على اختياري % % وقد جهلوا الأشم من الجديع % 25(@)(@@) % وغاظهم انفرادك بي ونشري % % محاسنك الغرائب في الجموع % 26(@)(@@) % وكل غريبة الأبوين بكر % رداح شرط سمعك أو شموع % 27(@)(@@) % عريقة مفخر نشأت وقرت % مع الأبكار في بيت رفيع % 28(@)(@@) % يعدنك زائرات كل عيد % نواطق بالصبابة والنزوع % 29(@)(@@) % وغيرك جاء يخطبهن مني % % فما أغنى الوقوف على الربوع % PageV01P1095 البحر : - 1(@)(@@) % عاتبت دهري في الجناية لو وعى % % ونشدته الحرم الوكيدة لو رعى % % 2(@)(@@) % وطلبت منه بسلمه وبحربه % نصفا فأعيا حاسرا ومقنعا % % 3(@)(@@) % في كل يوم عثرة من صرفه % لا تستقال بأن يقال لهالعا % % 4(@)(@@) % جنب هواك ملونا ساعاته % بالعذر لا يعطيك حتى يمنعا % % 5(@)(@@) % لولا التحامل بالمصائب لم يكن % بالمنفسات من الذخائر مولعا % % 6(@)(@@) % نزلت مثقلة كفافك إنني % % من قبل حملك موشكا أن أظلعا % % 7(@)(@@) % من ساءه صمم المسامع إنني % % يوم العروبة ساءني أن أسمعا % % 8(@)(@@) % ونعى إلي أبو بكر صباحها % % لسفاهه لو كان يعلم من نعى % % 9(@)(@@) % يوم على الإسلام قبلك فرحة % ويكون بعدك حسرة وتفجعا % % 10(@)(@@) % ومن 