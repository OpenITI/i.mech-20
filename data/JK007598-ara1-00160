ms141	 % 7(@)(@@) % فلا رعي عندي حتى يباح % بأطرافها البلد المعشب % 8(@)(@@) % رويدك ياناق كم تذكرين % مناخا به استأسد الثعلب % 9(@)(@@) % يهون الكمي بأرجائه % ويقلق في غمده المقضب % 10(@)(@@) % ولو كفكف الدهر من غربه % طغى في أزمته المصحب % PageV01P467 11(@)(@@) % ولم ينتجع عذبات اللوى % % إذا لاح بارقها الخلب % 12(@)(@@) % يرود بتيماء حو التلاع % وقد خانها الزمن الأشهب % 13(@)(@@) % وأصحرن عن أدم يقشعر % كما هنىء الجمل الأجرب % 14(@)(@@) % فمالي أحل ربا لا يشد % عقال المطي بها الأركب % 15(@)(@@) % وما بي عن غاية نبوة % وإن فزع الحي من غالب % 16(@)(@@) % فإن يدي دربت بالظبا % % وساعدها بالقنا أدرب % 17(@)(@@) % وعندي من الخيل ذو ميعة % يطوف بقبتنا مقرب % 19(@)(@@) % وألحفه البرد في شتوة % تغض الهرير لها الأكلب % 21(@)(@@) % إذا مد من نبرات الصهيل % ثنى مسمعيه له المعرب % 22(@)(@@) % % تدثره أسد أغلب % PageV01P468 23(@)(@@) % يجر الدلاص غداة الوغى % % كما اعتن في مشيه الأنكب % 24(@)(@@) % ولو كنت أبغي بنفسي العلا % % لأفضى إلي بها المذهب % 25(@)(@@) % فكيف أداني الخطا دونها % % ويجذب ضبعي إليها الأب % 26(@)(@@) % ولي معقل بفناء الوزير % يروح إلى فيئه المعزب % 27(@)(@@) % ويخجل من راحتيه الغمام % إذا در نائله الصيب % 28(@)(@@) % أتى في السماحة مالم يدع % لأهل الندى سيرا تعجب % 29(@)(@@) % فأول أفعالهم آخر % وبكر مكارمهم ثيب % 30(@)(@@) % وأفضى إلى أمد لو جرت % إليه الصبا طفقت تلغب % 31(@)(@@) % مدى هز من دونه رمحه السماك % وإبرته العقرب % 32(@)(@@) % وكيف يساجل في سؤدد % حواشيه من علق تخضب % PageV01P469 33(@)(@@) % وأدنى عطاياه ملبونة % تباري أعنتها شزب % 34(@)(@@) % وصهب ينم بأعراقها % % إذا مابتذلن الخطا ، أرحب % 35(@)(@@) % وغيد من الترك مكحولة % عيونا يقلبها الربرب % 36(@)(@@) % وأنى يساميه ذو محتد % مضارب أعراقه تؤشب % 37(@)(@@) % كأن محياه وقب الصفا % % تغشى جوانبه الطحلب % 38(@)(@@) % ولو شاء غادر أشلاءه % يحيي الضباع بها الأذؤب % 39(@)(@@) % لشد بك الملك أطنابه % وكادت دعائمه تسلب % 40(@)(@@) % وعز بك الشرق حتى لوى % % إليك أخادعه المغرب % 41(@)(@@) % تفل برأيك حد الحسام % إذا اعتكر الرهج الأصهب % 42(@)(@@) % وتملأ بالخيل عرض الفضا % % ء حتى يئن لها السبسب 
ms142	 % PageV01P470 43(@)(@@) % نظام العلا مد من شوطها % % نوى بالمخبين لا تصقب % 44(@)(@@) % ولولاك ما روعت صاحبي % للبين أغربة تنعب % 45(@)(@@) % ولا سانح هز من روقه % سليما ، ولا بارح أعضب % 46(@)(@@) % فكيف الإياب ومن دونه % موارد ، غدرانها تنضب % 47(@)(@@) % ومن عجب أنني في ذراك % على الدهر من حنق أغضب % 48(@)(@@) % فأنت الزمان ، وأحوالنا % % إليك ، إذا رزحت ، تنسب % PageV01P471 البحر : وافر تام 1(@)(@@) % وروض زرته والأفق يصحي % % أحايينا وآونة يغيم % 2(@)(@@) % كأن القطر من سبل الغوادي % % على زهراته الدر النظيم % 3(@)(@@) % يلين له أديم الجو حتى % % يصح به ويعتل النسيم % PageV01P472 البحر : طويل 1(@)(@@) % ألا بأبي من حيل دون مزاره % وقد بت أستسقي الغمام لداره % 2(@)(@@) % عهدت بها خشفا أغن ، كأنني % % أرى بمخط النؤي ملقى سواره % 3(@)(@@) % فلا برحت تسري الرياح مريضة % بها ، ويحييها الحيا بانهماره % 4(@)(@@) % وقفت بها نضوا طليحا ، وشجوه % يلوي عرا أنساعه بهجاره % 5(@)(@@) % ويعذلني من غلمة الحي باسل % على شيمتيه مسحة من نزاره % 6(@)(@@) % ويزعم أن الحب عار على الفتى % % أما علموا أني رضيت بعاره % 7(@)(@@) % كأني غداة البين من دهش النوى % % صريع يد الساقي ، عقير عقاره % 8(@)(@@) % فصاح غدا في شجاني نعيبه % يهز جناحي فرقة من مطاره % 9(@)(@@) % بجزع بطاحي ينوش أراكه % مها في خليطي أسده ونماره % 10(@)(@@) % حبست بها العيس المراسيل أجتلي % % على منحنى الوادي عيون صواره % PageV01P473 11(@)(@@) % وأعذل حيا من كنانة خيموا % % بحيث شكا الصب الطوى في وجاره % 12(@)(@@) % وقد ملأت عرض السماوة أينق % تلف خزامى روضها بعراره % 13(@)(@@) % أسرهم أن الربيع أظلها % % وجر بها الكلبي فضل إزاره % 14(@)(@@) % وتحت نجادي باتر الحد صارم % تدب صغار النمل فوق غراره % 15(@)(@@) % فليا بأعراف الجياد على الوجى % % تزره هوادي الخيل في عقر داره % 16(@)(@@) % ورمة كعب إن مالا أصيبه % لجاري ، وقد يعشى إلى ضوء ناره % 17(@)(@@) % ولست كمن يعلي إلى الهون طرفه % ولا يركب الخطي دون ذماره % 18(@)(@@) % فقد ساد جساس بن مرة وائلا % بقتل كليب دون لقحة جاره % 19(@)(@@) % حلفت بمحبوك السراة كأنني % % أنوط بذيل الريح ثني عذاره % 20 
ms143	(@)(@@) % وتلمع في أعلى محياه غرة % هي الصبح شق الليل غب اعتكاره % PageV01P474 21(@)(@@) % وتلطمه أيدي العذارى بخمرها % % إذا انتظر الساري مشن غواره % 22(@)(@@) % ويشتد بي والرمح يلثم نحره % إلى كل قرن للأسنة كاره % 23(@)(@@) % وتحت القنا للأعوجيات رنة % بضرب يطير الهام تحت شراره % 24(@)(@@) % ويزجرها مني أشيعث يرتدي % % بأبيض يلقي عنه أعباء ثاره % 25(@)(@@) % لأدرعن الليل حتى أزيره % أغر يناصي الشهب يوم فخاره % 26(@)(@@) % إذا طاشت الأحلام واسترخت الحبا % % تفيأت الآراء ظل وقاره % 27(@)(@@) % وألوى بمن جاراه حتى كأنه % معنى يداني خطوه في إساره % 28(@)(@@) % وكيف يبارى في السماحة ماجد % متى يختلف وفد الرياح يباره % 29(@)(@@) % تعطف كهلان بن زيد وحمير % عليه فأرسى مجدها في قراره % 30(@)(@@) % إليك زجرنا يا عدي بن مهرب % أمونا وصلنا ليله بنهاره % PageV01P475 31(@)(@@) % يلم بمغشي القباب وينثني % % حقائبه مملوءة من نضاره % 32(@)(@@) % إذا السنة الشهباء ألقت جرانها % % كفيت أبا الأطفال عام غياره % 33(@)(@@) % وزارك من عليا أمية مدره % تهز الليالي سرحه لنفاره % 34(@)(@@) % ولولاك لم أخبط دجى الليل بعدما % % أعيد قميرا بدره في سراره % 35(@)(@@) % وكم مهمه نائي المعرس جبته % وذي مرح أنضبته في قفاره % 36(@)(@@) % فجاءك منهوك العريكة ناحلا % وقد فارق الجرعاء ملء ضفاره % PageV01P476 البحر : طويل 1(@)(@@) % ألا هل إلى أرض بها أم سالم % وصول لطاوي شقة وبلاغ % 2(@)(@@) % فليس لماء بعد لينة بالحمى % % إذا ذقته بين الضلوع مساغ % 3(@)(@@) % أصد عن الواشي كأني طريدة % تراع بمستن الردى وتراغ % 4(@)(@@) % وأصبو ويلحاني على الحب عاذلي % % وأين فؤاد للسلو يصاغ % 5(@)(@@) % ومن شغلته بالهوى نظراتها % % فليس له حتى الممات فراغ % PageV01P477 البحر : طويل 1(@)(@@) % ترنح من برح الغرام مشوق % عشية زمت للتفرق نوق % 2(@)(@@) % فبات يواري دمعه بردائه % وأي دموع في الرداء يريق % 3(@)(@@) % إذا لاحظ الحي اليمانون بارقا % له تحت أذيال الظلام خفوق % 4(@)(@@) % تمطت إلى حزوى بهم غربة النوى % % وعيش اليماني بالسراة وريق % 5(@)(@@) % ولولا الهوى لم أتبع الطرف بازغا % كما اهتز ماضي الشفرتين ذليق % 6(@)(@@) % وكان غراب البين يخشى نعيبه % فكيف دهتني بالفراق بروق 
ms144	 % 7(@)(@@) % وفي الركب من قيس رعابيب ، عهدها % % لدي ، وإن شط المزار ، وثيق % 8(@)(@@) % فيا سعد كر اللحظ هل تبصر الحمى % % فإنسان عيني في الدموع غريق % 9(@)(@@) % ومن هؤلياء العريب على اللوى % % لخيلهم بالواديين عنيق % 10(@)(@@) % فثم عرار يستطاب شميمه % وظل كخيطان الأراك صفيق % PageV01P478 11(@)(@@) % أرى السبر منهم عامريا وكل من % ثوى من هلال بالعذيب صديق % 12(@)(@@) % وقد علقتني والنوى مطمئنة % بنا ، من هوى أم الوليد علوق % 13(@)(@@) % ولي نشوات تسلب المرء لبه % إذا ما التقينا ، والمدامة ريق % 14(@)(@@) % وقد فرق البين المشتت بيننا % % فشط مزار واستقل رفيق % 15(@)(@@) % وأشأم من جيراننا إذ تزيلوا % % فريق ، وأعرقنا ونحن فريق % 16(@)(@@) % طلعنا إلى الزوراء من أيمن الحمى % % ثنايا بأخفاف المطي تضيق % 17(@)(@@) % نزور أمير المؤمنين ، ودونه % خفي الصوى مرت الفجاج عميق % 18(@)(@@) % ولا أرض إلا وهي من كل جانب % إلى بابه للمعتفين طريق % 19(@)(@@) % له هزة في ندوة الحي للندى % % كما هز أعطاف الخليع رحيق % 20(@)(@@) % وبشر يلوح الجود منه وهيبة % تروع لحاظ المجتلي وتروق % PageV01P479 21(@)(@@) % وكف كما انهل الغمام طليقة % ووجه كما لاح الهلال طليق % 22(@)(@@) % وعز بمرسى الأخشبين مخيم % ومجد لدى البيت العتيق عتيق % 23(@)(@@) % إمام الورى إني بحبلك معصم % ومسرح طرفي في ذراك أنيق % 24(@)(@@) % أسير وأسري للمعالي ، وما بها % % لطالبها إلا لديك لحوق % 25(@)(@@) % وأزهى على الأيام وهي تروعني % % وأنيابها - لاريع جارك - روق % 26(@)(@@) % وقد ولدتني عصبة ضم جدهم % وجد بني ساقي الحجيج عروق % 27(@)(@@) % وإني لأبواب الخلائف قارع % بهم ولساحات الملوك طروق % 28(@)(@@) % ولولاك ما بلت بدجلة غلة % مطايا ، لها تحت الرحال شهيق % 29(@)(@@) % وكم خلفت أنضاؤها من معاشر % تساوى صهيل عندهم ونهيق % 30(@)(@@) % فإني ، وإن ضجت ركابي من النوى % % بها حين يلقين الهوان ، خليق % PageV01P480 البحر : وافر تام 1(@)(@@) % وبارقة تمخض بالمنايا % % صخوب الرعد دامية الظلال % 2(@)(@@) % تشيب ذوائب الأيام رعبا % وينفض روعها لمم الليالي % % 3(@)(@@) % إذا خطرت رياح النصر فيها % % تلقتها خياشيم العوالي % % 4(@)(@@) % وقد شامت مخيلتها سيوف % تلمظ في دم سرب العزالي % % 5(@)(@@) % فكم أجل طويناه 
ms145	 قصير % وآمال نشرناها طوال % 6(@)(@@) % بيوم خاض جانحتيه عمرو % لقى حرب تلقح عن حيال % 7(@)(@@) % ولما جرت الظلماء ذيلا % يواري مسلك الأسل النهال % 8(@)(@@) % ولاح كجلدة النمر الثريا % % بليل مثل ناظرة الغزال % 9(@)(@@) % تولى والظلام له خفير % على متمطر خذم النعال % 10(@)(@@) % وبات كأن خافية النعامى % % تنوء به ، وقادمة الشمال % PageV01P481 البحر : رجز تام 1(@)(@@) % واها لأيامي بأكناف اللوى % % والدهر طلق المجتلى رطب الثرى % % 2(@)(@@) % إذ الشباب الغض يندى ظله % وصبوتي يعذرني فيها الصبا % % 3(@)(@@) % ولمتي داجية ، إذا بدت % % سدت خصاص الخدر أحداق المها % % 4(@)(@@) % ثم انقضت أزمانه حميدة % ومن يرجي عودة لما مضى % % 5(@)(@@) % فلا الصبا يرجع إذ تصرمت % أيامه ، ولا عشيات الحمى % % 6(@)(@@) % ولي حنين لم تسعه أضلعي % % إلى اللوى يذكي تباريح الجوى % % 7(@)(@@) % وبين جنبي هوى أسره % ولوعة تسكن ألواذ الحشى % % 8(@)(@@) % يا حبذا عصر اللوى وأهله % حيث ظباء الإنس تحميها الظبا % % 9(@)(@@) % والروض مطلول يميد زهره % تحت حصى المرجان من قطر الندى % % 10(@)(@@) % والأقحوان ابتسمت ثغوره % غب مناجاة النسيم إذ ونى % % PageV01P482 11(@)(@@) % وقد رنا نرجسه بمقلة % يحار فيها الدمع من صوب الحيا % % 12(@)(@@) % فذاك دهر لم أجد بأدمعي % % دامية حتى تولى وانقضى % % 13(@)(@@) % وانقرضت شبيبة كأنها % % سبيبة في دمنة الحي لقى % % 14(@)(@@) % واشتعل الرأس فزالت ميعتي % % شيبا ، وفي الشيب الوقار والنهى % % 15(@)(@@) % وهو من الشباب أبهى منظرا % وأين من منبلج الفجر الدجى % % 16(@)(@@) % والمرء لا يروقه طلوعه % ويجتويه ، والشباب يشتهى % % 17(@)(@@) % فبعده الشيب ، وفيه ملبس % والشيب ليس بعده إلا الردى % % 18(@)(@@) % وكل ماساق الهلاك نحوه % فهو لديه كالهلاك مجتوى % % 19(@)(@@) % والنفس تلهو بالمنى مغترة % وللمنايا رصد على الورى % % 20(@)(@@) % تنافسوا فوق الثرى في ثروة % وتحته فقيرهم كذي الغنى % % PageV01P483 21(@)(@@) % والعبد كالمولى رميم عظمه % والطفل كالشيخ ، وكالكهل الفتى % % 22(@)(@@) % وأنت لا تأوي لما تربه % من جيد مصيره إلى البلى % % 23(@)(@@) % توقره وزرا ، ولا يصحب من % ألقي في ضريحه إلا التقى % % 24(@)(@@) % وهاأنا نهنه ما أحذره % من غلوائي ، فالنذير قد أتى % % 25(@)(@@) % ومن يناغ الأربعين عمره % ويحتضنه غيه فلا 
ms146	 اهتدى % % 26(@)(@@) % والشيب لما نشرت أفوافه % طويت أحشائي على جمر الغضى % % 27(@)(@@) % وإن أظل صبحه فودي فما % % فارقني ليل الشباب عن قلى % % 28(@)(@@) % ولم أزل أخطر في ردائه % بين رعابيب حسان كالدمى % % 29(@)(@@) % من كل بلهاء التثني إن مشت % حسبتها من كسل نشوى الخطا % % 30(@)(@@) % كالظبية الغيداء جيدا إن عطت % والجؤذر الوسنان طرفا إن رنا % % PageV01P484 31(@)(@@) % رخيمة ألفاظها ، فاترة % ألحاظها ، والسحر منها يجتنى % % 32(@)(@@) % فهي كما اهتز القنا من ترف % تمشي الهوينى ، أو كما ارتج النقا % % 33(@)(@@) % كنت سواد عينها حتى رأت % بياض شعري ، فتصدت للنوى % % 34(@)(@@) % وخالستني اللحظ من مكحولة % كنت كرى فيها فأصبحت قذى % % 35(@)(@@) % وانقشع الجهل فأخبى ناره % لمع قتير بث أنوار الحجى % % 36(@)(@@) % وارفض عن أجفان عيني رقدة % أطارها عنها انتباهي للعلا % % 37(@)(@@) % فلثت أعراف جياد حملت % صحبي بأعراف جياد للعدا % % 38(@)(@@) % من كل محبوك السراة شيظم % لايتشكى ملحا ولا وجى % % 39(@)(@@) % تحبو الرياح الهوج في أشواطه % والبرق يكبو خلفه إذا عدا % % 40(@)(@@) % كالنار إن حركته في حضره % وإن تسكنه فكالماء جرى % % PageV01P485 41(@)(@@) % تنتهب الأرض بكل حافز % كالقعب ، وهو كالصفا على الصفا % % 42(@)(@@) % وهن شعث كالسعالي عودت % حسن المشى بين العوالي في الوغى % % 43(@)(@@) % لهن إرخاء الذئاب ، فوقها % % تحت القنا كالغاب آساد الشرى % % 44(@)(@@) % شوس كأمثال الصقور أعنقت % بهم مذاكيها كأسراب القطا % % 45(@)(@@) % وأوقدوا نارين بأسا وندى % حيث الطلى تشقى بهم أو الشوى % % 46(@)(@@) % فمنهما للحرب ، وهي مرة % واحدة تذكى وأخرى للقرى % % 47(@)(@@) % تضفو عليهم أدرع موضونة % يرتد عنها السيف مفلول الشبا % % 48(@)(@@) % مشتبكات حلقا كأنها % % مسرودة بأعين من الدبى % % 49(@)(@@) % إن نفذت فيها الرماح خلتها % % أراقما يسبحن في الماء الروى % % 50(@)(@@) % فصافحت أذيالها صوارما % كأنها مطبوعة من الجذا % % PageV01P486 51(@)(@@) % أو سرق الشمس إليها نظرة % فاستلبت شعاعها رأد الضحى % % 52(@)(@@) % ولم يجل فيها الكمي طرفه % إلا تلقت ناظريه بالعشا % % 53(@)(@@) % وللرديني اهتزاز معشري % % لمن دعا إلى الوغى أو اعتفى % % 54(@)(@@) % يكاد يلوي متنه لدونة % كالصل في مهربه يلوي المطا % % 55(@)(@@) % واليثربيات بأيدي غلمة % تهوي إلى أعدائهم 
ms147	 خسا زكا % % 56(@)(@@) % وليس تنمى عندهم رمية % فقل لهم : لا شللا ولا عمى % % 57(@)(@@) % كأنما أعينهم محمرة % من غضب مكتحلات باللظى % % 58(@)(@@) % إذا اعتزوا عدوا أبا سميدعا % من عبد شمس أموي المنتمى % % 59(@)(@@) % من دوحة نال السماء فرعها % % وأصلها في سرة الأرض رسا % % 60(@)(@@) % بنو خليل الله ، فيهم عرقت % أرومة منها النبي المصطفى % % PageV01P487 61(@)(@@) % والخلفاء الراشدون ، وبهم % أوضح للدين منار وصوى % % 62(@)(@@) % والأمويون الذين ركزوا % % في نصره سمر الرماح في الكلى % % 63(@)(@@) % وآل عباس لقوا أعداءه % فاحتكمت سيوفهم على الطلى % % 64(@)(@@) % ومن كقومي ، وهم من يعرب % ومن نزار بن معد في الذرا % % 65(@)(@@) % فحبهم عصمة كل متق % وهم مصابيح الهدى لمن غوى % % 66(@)(@@) % ومن يحم عليهم رجاؤه % يعلق بحبل لا تهي منه القوى % % 67(@)(@@) % وإن تخطاهم إلى غيرهم % تمكنت منه أضاليل المنى % % 68(@)(@@) % وليس للهمة ممن يبتغي % % نجاته إلا إليهم مرتقى % % 69(@)(@@) % وهم ثمال الناس ، من لا يعتصم % بهم يكن من دينه على شفا % % 70(@)(@@) % خلائف ساسوا الأنام وهم % كالنعم الهامل فوضى وسدى % % PageV01P488 71(@)(@@) % قد ملكوا الدنيا وكانت عاطلا % فما لها غير مساعيهم حلى % % 72(@)(@@) % إن حاربوا أرضى السيوف سخطهم % أو سالموا شدوا على الحلم الحبا % % 73(@)(@@) % لاتنطق العوراء فيهم ، وبهم % يجتنب الجاهل إهداء الخنى % % 74(@)(@@) % ويبسطون بالنوال أيديا % منها أفاويق الثراء تمترى % % 75(@)(@@) % وسوف أقفو في المعالي هديهم % ودون غاياتهم نيل السها % % 76(@)(@@) % فكم أغض ناظري على قذى % وتنطوي ترائبي على شجى % % 77(@)(@@) % في عصب يضني الكريم قربهم % وشر أدوائك مافيه الضنى % % 78(@)(@@) % وقد رماني نكد الدهر بهم % وما درى أي معاوي رمى % % 79(@)(@@) % فلا رعى الله لئاما وهبوا % % نزرا ، وقد شيب بمن وأذى % % 80(@)(@@) % ناموا شباعا فقئت عيونهم % وجارهم أرق عينيه الطوى % % PageV01P489 81(@)(@@) % والمدح والهجو سواء عندهم % فمن هذي بمدحهم كمن هجا % % 82(@)(@@) % فقربا يا صاحبي أنيقا % كدن يبارين الرياح في البرى % % 83(@)(@@) % إن مناخ السوء لا يثوي به % من لم تكن أوطانه إلا الفلا % % 84(@)(@@) % أروع لا يقرع باب باخل % لم يتزر بسؤدد ولا ارتدى % % 85(@)(@@) % لست 
ms148	 كريم الوالدين ماجدا % إن لم أصل تأويبهن بالسرى % % 86(@)(@@) % فبي صدى يحرقني أواره % ولا تلوب غلتي على صرى % % 87(@)(@@) % ولا أروم المال منهوما به % فالمال محفور حواليه الزبى % % 88(@)(@@) % والمجد مما أقتني وأبتني % % فإن عثرت دونه فلا لعا % % 89(@)(@@) % ولا أحط بالوهاد أرحلي % % والعبشميون يحلون الربا % % 90(@)(@@) % ولي مدى لابد من بلوغه % وكل ساع ينتهي إلى مدى % % PageV01P490 91(@)(@@) % لله دري أي ذي حفيظة % في مدرعي ياسعد وهو يزدرى % % 92(@)(@@) % فلو علمت بعض ما يجنه % لم تسترب منه بكل ما ترى % 93(@)(@@) % يربط فيما يعتريه جأشه % وقلبه مشتمل على الأسى % % 94(@)(@@) % لم يبتسم إذ أنهضته نعمة % وأجهضته شدة فما بكى % % 95(@)(@@) % والسيف لا يعرف ما غناؤه % وهو لجي الغمد حتى ينتضى % % 96(@)(@@) % والقول إن لم يقرن الفعل به % تصديقه فهو الحديث المفترى % % 97(@)(@@) % وهذه قصيدة شبيهة % بالماء تسقاه على برح الصدى % % 98(@)(@@) % إن غرد الراوي بها تطربا % تلقف السامع منها ما روى % % 99(@)(@@) % ومن تمنى أن ينال شأوها % % هوى به إلى العناء ما هوى % % 100(@)(@@) % فالشعر ما لم يقتسر أبيه % وذاد عنه الطبع وحشي اللغى % % PageV01P491 البحر : طويل 1(@)(@@) % سقى الله رملي كوفن الغيث حافلا % به الضرع من جون الربابين وابل % 2(@)(@@) % وفضت نسيما يعبق الترب نشره % بها ركضات الريح بين الخمائل % 3(@)(@@) % ولا زال فيها الظل ألمى تلفتت % إليه صبا تعتاده بالأصائل % 4(@)(@@) % مواقع عراص الشآبيب تحتمي % % بأسمر رقاص الأنابيب ذابل % 5(@)(@@) % ويأوي إليها كل أروع يرتقي % % إلى المجد حر البأس حلو الشمائل % 6(@)(@@) % لبيق بتصريف القناة إذا سما % % إلى الحرب صلب العود رخو الحمائل % % 7(@)(@@) % نماه إلى فرعي أمية عصبة % تذل لها طوعا رقاب القبائل % 8(@)(@@) % بأيديهم تهتز ناصية العلا % % ويحتلب العافي أفاويق نائل % 9(@)(@@) % سأكفيهم الخطب الجسيم بصارم % تمطى المنايا بين غربيه ناحل % 10(@)(@@) % وألثم نحر القرن كل مثقف % بصير إذا أشرعته بالمقاتل % PageV01P492 11(@)(@@) % فقد بسطت باعي به خنزوانة % % تضمن يوم الروع ري المناصل % PageV01P493 البحر : طويل 1(@)(@@) % صبابة نفس ليس يشفى غليلها % % ولوعة أشواق كثير قليلها % % 2(@)(@@) % وظمياء لم 
ms149	 تحفل بسر أصونه % ولا بدموع في هواها أذيلها % % 3(@)(@@) % وينزفها ربع تروي طلوله % بوجرة عين في الديار أجيلها % % 4(@)(@@) % ولولا جوى أطوي عليه جوانحي % % لما هاج عيني للبكاء محيلها % % 5(@)(@@) % إذا صافحتها الريح طابت لأنها % % بمنزلة ناجت ثراها ذيولها % % 6(@)(@@) % مريضة أرجاء الجفون ، وإنما % % أصح عيون الغانيات عليلها % % 7(@)(@@) % رمتني بسهم راشه الكحل بالردى % % وأقتل ألحاظ الملاح كحيلها % % 8(@)(@@) % وسالفتي أدماء تحت أراكة % تمد إليها الجيد وهي تطولها % % 9(@)(@@) % فولت وقد أبقت بقلبي علاقة % تمر بها الأيام وهو مقيلها % % 10(@)(@@) % وقلت لأدنى صاحبي ، وقد وشى % % بسري دمع إذا تراءت حمولها % % PageV01P494 11(@)(@@) % ذر اللوم إني لست أرعيك مسمعي % % فتلك هوى نفسي وأنت خليلها % % 12(@)(@@) % وليت لسانا أرهف العذل غربه % على الصب مفلول الشباة كليلها % % 13(@)(@@) % أرد عذولي وهو يمحضني الهوى % % بغيظ ، ويحظى بالقبول عذولها % % 14(@)(@@) % ويعتادني ذكرى العقيق وأهله % بحيث الحمام الورق شاج هديلها % % 15(@)(@@) % تنوح وتبكي فوق أفنان أيكة % فداهن من أرض العراق نخيلها % % 16(@)(@@) % ولولا تباريح الصبابة لم أبل % بكاها ولا أذرى دموعي عويلها % % 17(@)(@@) % بواد حمته عصبة عبشمية % عظام مقاريها ، كرام أصولها % % 18(@)(@@) % أزين بها شعري كما زنتها به % ولله دري في قواف أقولها % % 19(@)(@@) % ينم بمجدي حين أفخر منطقي % % ويعرب عن عتق المذاكي صهيلها % % 20(@)(@@) % فلم أر قوما مثل قومي لبائس % ببيداء يستاف التراب دليلها % % PageV01P495 21(@)(@@) % يبل دريسيه الندى ، وتلفه % على الكور من هوج الرياح بليلها % % 22(@)(@@) % مطاعين والهيجاء تغشى غمارها % % مطاعيم والغبراء تخشى محولها % % 23(@)(@@) % وكم ماجد فيهم يحل جبينه % حبا الليل والظلماء مرخى سدولها % % 24(@)(@@) % وأخمصه من تحته هامة السها % % وهمته في المجد عال تليلها % % 25(@)(@@) % فهل تبلغني دارهم أرحبية % على الأين يمري بالحداء ذميلها % % 26(@)(@@) % حباني بها بدر فكم جبت مهمها % حليما به سوطي ، سفيها جديلها % % 27(@)(@@) % فتى تورق السمر اللدان بكفه % وإن دب في أطرافهن ذبولها % % 28(@)(@@) % وتغشى الوغى بيضا حدادا سيوفه % فترجع حمرا باديات فلولها % % 29(@)(@@) % ويوقظ وسنان التراب بضمر % توارى بشؤبوب النجيع حجولها % % 30(@)(@@) % عليها كماة الترك من فرع يافث % كثير 
ms150	 بمستن المنايا نزولها % % PageV01P496 31(@)(@@) % هم الأسد بأسا في اللقاء وأوجها % إذا غضبوا ، والسمهرية غيلها % % 32(@)(@@) % وإن نطقوا قلت القطا من قبيلهم % وهم غلمة من ولد نوح قبيلها % % 33(@)(@@) % وقد أشبهوها أعينا إذ تلاحظوا % % على شوس ، والبيض تدمى نصولها % % 34(@)(@@) % صفت بك دنيا كدرتها عصابة % تمرد غاويها وعز ذليلها % % 35(@)(@@) % ولولاك لم تقلم أظافير فتنة % تعاورها شبانها وكهولها % % 36(@)(@@) % فماتت بجمع إذ أظلت رقابهم % سيوف يصم المارقين صليلها % % 37(@)(@@) % ولو نتجت أضحت قوابلها القنا % % ولم يغذ إلا بالدماء سليلها % % 38(@)(@@) % ومن يتغبر من أفاويق فتنة % يذق طعنات ليس يودى قتيلها % % 39(@)(@@) % فعش ليد تولي ، وملك تحوطه % ونائبة تكفي ، ونعمى تنيلها % % 40(@)(@@) % ودم للمعالي فهي عندك تبتغى % % ومشتبه ، إلا عليك سبيلها % % PageV01P497 البحر : طويل 1(@)(@@) % ألا هل يفيق الدهر من سكراته % ويرفض عن أجفانه طارق الحلم % 2(@)(@@) % ويلمع طاغي الشفرتين براحتي % % وراء عجاج راشح بدم سجم % 3(@)(@@) % ولي صاحب من عبد شمس إذا انتمى % % تسنم أعلى ذروة الشرف الضخم % 4(@)(@@) % نأى فأثار الحرب يصرف نابها % % علي زمان كان يجنح للسلم % 5(@)(@@) % فلا زال يرويه الغمام إذا همى % % بما في ثغور البارقات من الظلم % PageV01P498 البحر : بسيط تام 1(@)(@@) % نأى بجانبه ، والصبح مبتسم % طيف تبلج عنه موهنا حلم % 2(@)(@@) % فانصاع يتبعه قلب له شجن % وضاع من بعده جسم به سقم % 3(@)(@@) % قد كنت آنس بالأنوار آونة % فما وفت ، وكفتني غدرها الظلم % 4(@)(@@) % خاضت دجى الليل سلمى وهي تخفرها % % والدار لا صقب منا ولا أمم % 5(@)(@@) % تطوي الفلا وجناح الليل منتشر % إلي حيث ينهي سيله إضم % 6(@)(@@) % والركب بالقاع يسري في عيونهم % كرى يدب على آثاره السأم % 7(@)(@@) % فناعس عقب المسرى تهب به % ومائل لنواحي الرحل ملتزم % 8(@)(@@) % وبي من الشوق ماأعصي الغيور به % كما يطيع هواي المدمع السجم % 9(@)(@@) % وحنة بت أستبكي الخلى بها % % وقد بدا من حفافي توضح علم % 10(@)(@@) % أصبو إليه وقد جر الربيع به % ذيوله ، وتولت وشيه الديم % PageV01P499 11(@)(@@) % ومابي الربع لكن من يحل به % وإنما لسليمى يكرم السلم % 12(@)(@@) % والدهر يغري 
ms151	 نواها بي ، وعن كثب % من صرفها بأبي عثمان أنتقم % 13(@)(@@) % أغر يستمطر العافون راحته % فيستهل كفاء المنية النعم % 14(@)(@@) % إذا بدا اختلس الأبصار نظرتها % % إليه من هيبة في طيها كرم % 15(@)(@@) % واستنفض القلب طرف في لواحظه % تيه الملوك وأنف كله شمم % % 16(@)(@@) % ذو راحة ألفتها في سماحتها % % مكارم تتقاضاه بها الشيم % 17(@)(@@) % يمد للمجد باعا مابه قصر % ولا تخون خطاه نحوه القدم % 18(@)(@@) % وينتضي كأبيه في مقاصده % عزما يفل به الصمصامة الخذم % 19(@)(@@) % لما اقشعر أديم الفتنة اعتركت % فيها المغاوير ، والأرواح تخترم % 20(@)(@@) % فكف من غربها لما استقام به % زيغ الخطوب ، وأجلى العارض الهزم % PageV01P500 21(@)(@@) % بالخيل مستبقات في أعنتها % % فرسانها الأسد ، والخطية الأجم % 22(@)(@@) % أنسن بالحرب حتى كاد يحفزها % % حب اللقاء إذا ما قعقع اللجم % 23(@)(@@) % فما تمد إلى غير الدعاء يد % وليس يفتح إلا بالثناء فم % 24(@)(@@) % تعسا لشر ذمة دبوا الضراء له % أدمى الشحيحة من أيديهم الندم % 25(@)(@@) % وغادر ابن عدي في المكر لقى % يجري على ملتقى الأوداج منه دم % 26(@)(@@) % فاسلم ولا تصطنع إلا أخا ثقة % ندبا إذا نفضت للحادث اللمم % 27(@)(@@) % يغضي حياء وفي جلبابه أسد % أكدت مباغيه فهو المحرج الضرم % 28(@)(@@) % واسعد بيومك ، فالإقبال مؤتنف % والشمل مجتمع والشعب ملتئم % 29(@)(@@) % قد سنت الفرس للنيروز ما طفقت % تجري إليه على آثارها الأمم % 30(@)(@@) % وكم تطلبت ما أهدي فما اقتصرت % على الذي بلغته الطاقة الهمم % PageV01P501 31(@)(@@) % وإن في كلمات العرب شاردة % أداء ما شرطته قبلنا العجم % 32(@)(@@) % فأرع سمعك شعرا كاد من طرب % إلى معاليك قبل النظم ينتظم % 33(@)(@@) % إن الهدايا ، وخير القول أصدقه % تفنى ، بقيت ، وتبقى ، هذه الكلم % PageV01P502 البحر : كامل أحذ 1(@)(@@) % بأبي وإن عظم الفداء فتى % للهم في جنبيه معترك % 2(@)(@@) % نبهته والليل معتكر % ونجومه في الأفق تشتبك % 3(@)(@@) % ومشى على كسل فقلت له : % عثرت بك الوخادة الرتك % 4(@)(@@) % أرضيت أمرا لا يزال به % في الذل عرض أخيك ينتهك ؟ % 5(@)(@@) % والدهر يرمز بالخطوب ، وفي % % غلوائها الأيام تنهمك % 6(@)(@@) % ما نحن من سوق فنشبههم % لم ينمنا 
ms152	 إلا أب ملك % 7(@)(@@) % فانظر إلى الأجداد كيف سعوا % % للمكرمات وأية سلكوا % % 8(@)(@@) % هلا أخذت بهديهم فهم % تركوا العلا لك ، فارع ما تركوا % % 9(@)(@@) % واطلب مداهم إنهم نفر % عاشوا بذكرهم وقد هلكوا % % 10(@)(@@) % وإذا عجزت ولم تلم به % فالعجز بعد طلابه درك % PageV01P503 البحر : متقارب تام 1(@)(@@) % هي العيس مبتدرات الخطا % % نوافخ من مرح في البرى % % 2(@)(@@) % أتجزع للبين أضم ترعوي % % إلى جلد أسأرته النوى % % 3(@)(@@) % ولم يترك البين لي عبرة % ولكنها علق يمترى % % 4(@)(@@) % فصبرا على عدواء الديار % وإن أضرمت برحاء الجوى % % 5(@)(@@) % وفي منشط الرمث عذرية % أبت قضب الهند أن تجتلى % % 6(@)(@@) % إذا رفع السجف عنها بدت % % هلالا على غصن في نقا % % 7(@)(@@) % رمتني بألحاظها الفاترات % فعادت سهاما وكانت ظبا % % 8(@)(@@) % وكم بالجنينة من شادن % يصيد بعينيه ليث الشرى % % 9(@)(@@) % طرقت الخيام على رقبة % طروق الخيال يخوض الدجى % % 10(@)(@@) % وتحتي أدهم يخفي الصهيل % كما استرق المضرحي الوعى % % PageV01P504 11(@)(@@) % أشم المعذر ، ضافي السبيب ، عالي السراة ، سليم الشظى % % ب ، عالي السراة ، سليم الشظا % % 12(@)(@@) % كساه الدجى حلة ، والصباح % يلوح بجبهته والشوى % % 13(@)(@@) % فأقبل نحوي ، وأترابه % حواليه كالخشف بين المها % % 14(@)(@@) % وبات يمسح مكحولة % يرنق في ناظريها الكرى % % 15(@)(@@) % وجاذبني فضلات العنان % حذارا إلى عذبات اللوى % % 16(@)(@@) % وقمنا إلى منحنى الواديين % نجر على أجرعيه الردا % % 17(@)(@@) % وبتنا نكفكف صوب الغمام % بفضل الوشاح تخيت الغضى % % 18(@)(@@) % فياما أحيسن ذاك العناق % وقد مس ثني نجادي ندى % % 19(@)(@@) % يفض القلائد من ضيقه % وتلفظ أطواقهن الطلى % % 20(@)(@@) % وقالت سليمى لأترابها % % أتعرفن بالله هذا الفتى % % PageV01P505 21(@)(@@) % أغر نمته إلى خندف % شمائل تخلق منها العلا % % 22(@)(@@) % إذا نشر الفخر أحسابه % تبسم عنهن عرق الثرى % % 23(@)(@@) % أبا الغمر دعوة من أورثته % أمية من مجدها ماترى % % 24(@)(@@) % إذا الخارجي ثوى بالحضيض % سموت ، وأنت معي ، للذرا % % 25(@)(@@) % فدتك الأعاريب من ماجد % قريب النوال بعيد المدى % % 26(@)(@@) % ضربت على الأين صدر المطي % فقد إليك أديم الفلا % % 27(@)(@@) % وأوقدت نارك حتى طرقت % ومن شيم العربي القرى % % 28(@)(@@) % فلم أر أندى يدا بالنوا % % ل 
ms153	 منك وأكرم منها لظى % % PageV01P506 البحر : طويل 1(@)(@@) % هل الحب إلا عبرة تترقرق % ولوعة وجد بالجوانح تعلق % 2(@)(@@) % وكلتاهما حيث الصبابة برحت % بقلب إذا ما اعتاده الشوق يخفق % 3(@)(@@) % شقيقة نفسي بالعواذل بعض ما % % أعاني إذا ناح الحمام المطوق % 4(@)(@@) % أما وغرامي ، حلفة أستلذها % % لقد كدت من ذكراك بالروح أشرق % 5(@)(@@) % وأهون ما ألقى من الحب أنني % % على النأي أطفو في دموعي وأغرق % 6(@)(@@) % صفت بالهوى مني ومنك سرائر % جمعن قلوبا في جسوم تفرق % 7(@)(@@) % وفيك سكوتي والضمائر تنتجي % % وعنك إذا ما ساعد القول أنطق % PageV01P507 البحر : طويل 1(@)(@@) % بكت شجوها وهنا ، وكدت أهيم % حمائم ورق صوتهن رخيم % 2(@)(@@) % تجاوبن إذ حط الصباح لثامه % ورق من الليل البهيم أديم % 3(@)(@@) % فأذريت أسراب الدموع ، وشفني % % جوى بين أثناء الضلوع أليم % 4(@)(@@) % وأومض لي برقا سحاب ومبسم % فلم أدر أي البارقين أشيم % 5(@)(@@) % يطول سهادي إن تناعس بارق % ويلوي بصبري أن يهب نسيم % 6(@)(@@) % وكيف أرجي أن أصح ، وكل ما % % رماني به صرف الزمان سقيم ؟ % 7(@)(@@) % شمال كترنيق النعاس ، ومقلة % بها اقتنص الأسد الضراغم ريم % 8(@)(@@) % وهل واجد يمتاح عبرته النوى % % ويسبله الشوق الرقاد ، مليم % 9(@)(@@) % فلا تعذليني يابنة القوم ، إنني % % وإن هم دهري بالسفاه حليم % 10(@)(@@) % أضم جفوني دون بارقة المنى % % وأحمد مر العيش وهو ذميم % PageV01P508 11(@)(@@) % وأستف ترب الأرض إن عضني الطوى % % ويجزىء عن لس الغمير هشيم % 12(@)(@@) % ولا أشتكي الأيام ، إن اعتداءها % % على عبد شمس يا أميم قديم % 13(@)(@@) % وتقطع عن حيي نزار علائقي % % صروف الليالي ، والخطوب تضيم % 14(@)(@@) % وألوي إلى الأتراك جيدي ، فلا الندى % % قليل ، ولا أم الوفاء عقيم % 15(@)(@@) % لهم أنفس ، والحرب فاغرة فما % بمعترك الموت الزؤام تقيم % 16(@)(@@) % وأوجههم والسخط يبدي قطوبها % % كأوجه أسد ، كلهن شتيم % 17(@)(@@) % وهن بدور حين يشرقن في الدجى % % فلا فارقتها نضرة ونعيم % 18(@)(@@) % وقد دب في كتابهم نشوة الغنى % % وكلهم جعد اليدين لئيم % 19(@)(@@) % إذا زارهم خل مقل لووا به % مناخر لم يعطس بهن كريم % 20(@)(@@) % ولولا أخونا من بجيلة لم يكن % لهم 
ms154	 حسب عند الفخار صميم % PageV01P509 21(@)(@@) % هو الغرة البيضاء في جبهاتهم % وكلهم جون الإهاب بهيم % 22(@)(@@) % فليت المطايا كن حسرى وظلعا % ولم يتبعن الرعي وهو وخيم % 23(@)(@@) % بكل مقيل مجت الشمس ريقها % % عليه ، وكشح الظل فيه هضيم % 24(@)(@@) % سأرحل عنهم والمحيا بمائه % وعرضي مس مس الهوان سليم % 25(@)(@@) % فإن جهلوا فضلي عليهم فإنني % % بتمزيق أعراض اللئام عليم % PageV01P510 البحر : بسيط تام 1(@)(@@) % الناس بالعيد مسرورون غير فتى % % يشفه في إسار الغربة الحزن % 2(@)(@@) % وبين جنبيه هم لا يبوح به % ففرحة المرء حيث الأهل والوطن % 3(@)(@@) % ولا اغتراب علينا فالبلاد لنا % % فتوحها وبنا يسترحب العطن % 4(@)(@@) % إذ لم تكن قبلنا بالمجد حالية % ولا لها منظر من بعدنا حسن % % 5(@)(@@) % والأرض تزهى بنا أطرافها فمتى % % نمل إلى الشام يحسدها بنا اليمن % 6(@)(@@) % وتلك دار ورثناها معاوية % لكن كوفن ألقانا بها الزمن % 7(@)(@@) % أصبو إليها وأشواقي تبرح بي % % وتمنع العين أن يعتادها الوسن % 8(@)(@@) % فليت شعري ، وليت غير نافعة % هل يبدون لعيني منجد حضن ؟ % 9(@)(@@) % وهل أنيخ بباب القصر ناجية % مناخها فيه من صوب الحيا قمن ؟ % 10(@)(@@) % هنالك الهضبات الحمر لو هتفت % بالميت راجع فيها روحه البدن % PageV01P511 البحر : طويل 1(@)(@@) % أتيحت لداء في الفؤاد عضال % ربا بالظباء العاطلات حوال % % 2(@)(@@) % تذيل دموع العين وهي مصونة % وأرخصها في الحب وهي غوال % 3(@)(@@) % سواجم تكفيها الحيا وانهماله % إذا انحل في وطف الغمام عزالي % % 4(@)(@@) % ولولاك يا ذات الوشاحين لم تكن % موشحة من أدمعي بلآلي % % 5(@)(@@) % وأغضيت عيني عن مهاها فلم أبل % لديها بعيني جؤذر وغزال % 6(@)(@@) % ولكنني أرضى الغواية في الهوى % % وأحمل فيه ما جناه ضلالي % % 7(@)(@@) % وقتك الردى بيض حسان وجوهها % % ومثرية من نضرة وجمال % 8(@)(@@) % طلعن بدورا في دجى من ذوائب % ومسن غصونا في متون رمال % 9(@)(@@) % أرى نظرات الصب يعثرن دونها % % بأعراف جرد أو رؤوس عوال % 10(@)(@@) % عرضن علي الوصل ، والقلب كله % لديك ، فأنى يبتغين وصالي % % PageV01P512 11(@)(@@) % وهن ملاح غير أن نواظرا % تديرينها ، زلت بهن نعالي % % 12(@)(@@) % ولولاك ما بعت العراق وأهله % بوادي الحمى 
ms155	 ، والمندلي بضال % 13(@)(@@) % فما لنساء الحي يضمرن غيرة % سبتها العوالي ، ما لهن وما لي ؟ % 14(@)(@@) % ولو خالفتني في متابعة الهوى % % يميني ما واصلتها بشمالي % % 15(@)(@@) % وفيك صدود من دلال ، أظنه % - على ما حكى الواشي - صدود ملال % 16(@)(@@) % قنعت بطيف من خيالك طارق % وأي خيال يهتدي لخيال % 17(@)(@@) % فلا تنكري سيري إليك على الوجى % % ركائب لا ينعلن غير ظلال % 18(@)(@@) % إذا زجرت منهن وجناء خلتها % % وقد مسها الإعياء ، ذات عقال % 19(@)(@@) % وخوضي إليك الليل أركب هوله % وإن بعد المسرى فلست أبالي % % 20(@)(@@) % ولا تقبلي قول العذول فتندمي % % إذا قطعت عنك الوشاة حبالي % % PageV01P513 21(@)(@@) % سلي ابني نزار عن جدودي بعدما % % سمعت ببأسي إذ هززت نصالي % % 22(@)(@@) % هل اشتملت فيهم صحيفة ناسب % على مثل عمي يا أميم ، وخالي % % 23(@)(@@) % فهل ملثم اللبات رمحي إذا دعا % % مصاليت يغشون المصاع نزال % 24(@)(@@) % فلا تلزميني ذنب دهر يسومني % % على غلظ الأيام رقة حال % 25(@)(@@) % وتمشي الهوينى بين جنبي همة % تذم زمانا ضاق فيه مجالي % % 26(@)(@@) % وعند بنيه حين تخشى بناته % قلوب نساء في جسوم رجال % 27(@)(@@) % ولا تنكري ما أشتكي من خصاصة % عرفت بها البأساء منذ ليال % 28(@)(@@) % فبالتلعات الحو من أرض كوفن % مبارك لا تدمي صدور جمالي % % 29(@)(@@) % يحوط حماها غلمة أموية % بخطية ملس المتون طوال % 30(@)(@@) % وكل رميض الشفرتين مهند % كأن بغربيه مدب نمال % PageV01P514 31(@)(@@) % ضربن بألحيهن ، والريح قرة % على قلتي أروند غب كلال % 32(@)(@@) % فما رعت القربى قريش ، ولا اتقت % عتابي ، ولم يكسف لذلك بالي % % 33(@)(@@) % وأكرم مثواها وأمجدها القرى % % بنو خلف حتى حططت رحالي % % 34(@)(@@) % وفازوا بحمدي إذ ظفرت بودهم % فلم أتعرض بعده لنوال % 35(@)(@@) % مغاوير من أبناء بهرام ذادة % بهم تلقح الهيجاء بعد حيال % 36(@)(@@) % يهشون للعافي كأن وجوههم % صدور سيوف حودثت بصقال % 37(@)(@@) % فصاحبت منهم كل قرم حوى العلا % % بملثومة في الجود ذات سجال % 38(@)(@@) % وبذ الحيا إذ جاد ، والليث إذ سطا % % على القرن ، في أكرومة وصيال % 39(@)(@@) % يرى بسنان الزاغبية كوكبا % فيطعن حتى ينثني كهلال % 40(@)(@@) % ولا يتخطى مقتلا 
ms156	 ، فكأنه % لدى الطعن يعشو نحوه بذبال % PageV01P515 41(@)(@@) % رعى حرمات المجد في تكرما % وقد شد عزمي للمسير قبالي % % 42(@)(@@) % وأيقن أني لا ألوذ بباخل % يضيع عرضا في صيانة مال % 43(@)(@@) % وكنت خفيف المنكبين فأكرها % % على منن طوقتهن ثقال % 44(@)(@@) % وحزت ندى ما شانه بمطاله % وحاز ثناء لم يشنه مطالي % % 45(@)(@@) % فسقت إليه الشكر بعد سؤاله % وساق إلي العرف قبل سؤالي % % PageV01P516 البحر : رمل تام 1(@)(@@) % بكرت ، والليل في زي الغداف % ساحبات الريط من عبد مناف % 2(@)(@@) % يتناجين بعذلي إذ غدت % بزتي درعي وألقيت عطافي % % 3(@)(@@) % يا نساء الحي ما في أذني % % مسلك للوم فاتركن خلافي % % 4(@)(@@) % إن ظل النقع أولى بالفتى % % في طلاب العز من ظل الطراف % 5(@)(@@) % غمزت مني الليالي صعدة % لم يقوم درءها عض الثقاف % 7(@)(@@) % % نعر النية نسال القوافي % % PageV01P517 البحر : كامل تام 1(@)(@@) % هو ما ترى فأقل من تعنيفي % % وحذار من مقل الظباء الهيف % 2(@)(@@) % وله يبيت له المتيم ساهرا % بحشى على ألم الجوى موقوف % 3(@)(@@) % ويظل حلف الدمع ملء جفونه % والوجد ملء فؤاده المشغوف % 4(@)(@@) % عرضت ونن على الحمى ، ومطينا % % كالسمهري أقيم بالتثقيف % 5(@)(@@) % نشوانة اللحظات ترسل نظرة % عجلت بها كالشادن المطروف % 6(@)(@@) % يهفو بها مرح الصبا فتهز من % قد ، كما جدل العنان ، قضيف % 7(@)(@@) % ووتراع عند قيامها حذرا على % % خصر ، يجول به الوشاح ، لطيف % 8(@)(@@) % ووراء ذياك اللثام مباسم % حامت عليها غلة الملهوف % 9(@)(@@) % تفتر عن برد يكاد يذيبه % قبل تردد في اللمى المرشوف % 10(@)(@@) % لما رأت رحلي يقرب للنوي % % علقت سواد بحنوه المعطوف % PageV01P518 11(@)(@@) % وجرت أحاديث تبيت قلائد % من أجلهن حواسدا لشنوف % 12(@)(@@) % أأميم كفي من دموعك وانظري % % خببي إلى أمد العلا ووجيفي % % 13(@)(@@) % وتبرضي النغب الثماد وجاوري % % سروات حي بالبطاح خلوف % 14(@)(@@) % أنا من عرفت وبعد يومهم غد % وعلي بزة أجدل غطريف % 15(@)(@@) % لا يعلم اللؤماء أين معرسي % % وبأي واد مربعي ومصيفي % % 16(@)(@@) % لفظت ديارهم الكرام فما لوى % % طمع إلى عرصاتهن صليفي % % 17(@)(@@) % وأبى عريق في من عربية % أني أخيم والهوان حليفي % % 18(@)(@@) % ونجيبة ممغوطة 
ms157	 أنساعها % % تخدي بمعروق العظام نحيف % 19(@)(@@) % فزجرتها والورد يضمن ريها % % ولها على الظمأ ازورار عيوف % 20(@)(@@) % وطفقت أفرق ، وهي طائشة الخطا % % لمم الدجى بيد الصباح الموفي % % PageV01P519 21(@)(@@) % ونصلت من أعجازه في غلمة % تشفي الغليل بهم صدور سيوفي % % 22(@)(@@) % فأتت معاوي الفخار وألصقت % ودم بأطراف الرماح نزيف % 23(@)(@@) % نزلت بمغشي الرواق ، فناؤه % مثوى وفود أو مقر ضيوف % 24(@)(@@) % بالمستثير المجد من سكناته % حتى يوشح تالدا بطريف % 25(@)(@@) % وإلى أبي العباس يجتذب الندى % % مدحا هي الحبرات من تفويفي % % 26(@)(@@) % وإذا اعتركن بمسمع قرطنه % فقرا كسمط اللؤلؤ المرصوف % 27(@)(@@) % مدت هواديها الرئاسة نحوه % في حادث يلد الشقاق مخوف % 28(@)(@@) % وأقر نافرة القلوب فلم يثب % أسد يجيل الطرف حول غريف % 29(@)(@@) % والضربة الأخدود لم يعجم لها % % سطر بعاجل طعنة اخطيف % 30(@)(@@) % قرم يجير على الزمان إذا اعتدى % % ويقيم زيغ نوائب وصروف % PageV01P520 31(@)(@@) % ويلف كاشحه جوانحه على % % جرح بعالية القنا مقروف % 32(@)(@@) % ضمن الحياة لمعتفيه يراعه % ورمى العداة حسامه بحتوف % 33(@)(@@) % وقد امتطى رتبا منيفات الذرا % % حل السها منها مكان رديف % 34(@)(@@) % بخلائق نفحت بريا روضة % غناء ذات تبسم ورفيف % 35(@)(@@) % وأنامل كفلت بصوبي نائل % زدم بأطراف الرماح نزيف % 36(@)(@@) % تندى إذا جمدت أكف معاشر % فكأنها خلقت من المعروف % 37(@)(@@) % يابن الأكارم دعوة تفتر عن % أمل بأندية الملوك مطيف % 38(@)(@@) % وعدتني الأيام عنك برتبة % ووفور حظ منك غير طفيف % 39(@)(@@) % والعبد منتظر وهن مواطل % ومن العناء إطالة التسويف % PageV01P521 البحر : سريع 1(@)(@@) % أقسم بالجرد السراحيب % والرمح رعاف الأنابيب % 2(@)(@@) % لألبسن اليوم حرباؤه % من شمسه تحت شآبيب % 3(@)(@@) % أطوي على ظل قصير الخطا % % مناسم العيس المطاريب % 4(@)(@@) % وأقتفي حن أروم العلا % % آثار آباء مناجيب % 5(@)(@@) % وكيف أبغيها وفقد الغنى % % يذل أعناق المصاعيب % 6(@)(@@) % والعسر قيد المرء لكنني % % أقرع للمجد ظنابيبي % % 7(@)(@@) % أمشي على ظلعي إلى شأوه % تعجرفا فعل الأعاريب % PageV01P522 البحر : بسيط تام 1(@)(@@) % تذكر الوصل فارفضت مدامعه % واعتاده الشوق فانقضت أضالعه % 2(@)(@@) % وبرقع الدمع عينيه لذي هيف % نمت على القمر الساري براقعه % 3(@)(@@) % فبات يرقبه ، والليل يخفره 
ms158	 % والقلب تهفو إلى حزوى نوازعه % 4(@)(@@) % ولاعج الوجد يطويه وينشره % حتى بدا الصبح موشيا أكارعه % 5(@)(@@) % فزاره زورة تعيى الأسود بها % % أعز زرت على خشف مدارعه % 6(@)(@@) % وراح يتضح حر الوجد من نغب % في مشرب خصر طابت مشارعه % 7(@)(@@) % كأنها ضرب شيبت لذائقها % % بعاتق نفحت مسكا ذوارعه % 8(@)(@@) % والليل مد رواقا من غياهبه % على فتى كرمت فيه مضاجعه % 9(@)(@@) % ثم افترقنا وقد بث الصباح سنا % إلا النعام بها تخدي خواضعه % 10(@)(@@) % يجري من الدمع ما يرضى المشوق به % ويرتقي نفس سدت مطالعه % PageV01P523 11(@)(@@) % هذا ورب فلاة لا يجاوزها % % 12(@)(@@) % قريتها عزمات من أخي ثقة % تفتر عن أسد ضار وقائعه % 13(@)(@@) % والأرحبية تطغى في أزمتها % % إذا السراب ثنى طرفي يخادعه % 14(@)(@@) % واليوم ألقت به الشعرى كلاكلها % % وصوحت من ربا فلج مراتعه % 15(@)(@@) % فظل للركب ، والحرباء منتصب % بيت على مفرق العيوق رافعه % 16(@)(@@) % تلوي طوارفه عنا السموم كما % % تهدي النسيم إلى صحبي وشائعه % 17(@)(@@) % عماده أسل تروى إذا اضطرمت % نار الوغى من دم الجاني شوارعه % 18(@)(@@) % والريح والهة حيرى تلوذ به % حيث النسيم يروع الترب وادعه % 19(@)(@@) % جعلت أطنابه أرسان عادية % يشجى بها من فضاء الأرض واسعه % 20(@)(@@) % زارت بنا ناصر الدين الذي نهجت % إلى العلا طرقا شتى صنائعه % PageV01P524 21(@)(@@) % حلو الشمائل مر البأس ذو حسب % من مجده مكتس عار أشاجعه % 22(@)(@@) % والمن لا يقتفي آثار نائله % إذا تقراه من عاف مطامعه % 23(@)(@@) % أفضى به الأمد الأقصى إلى شرف % ضاح له من سنام العز يافعه % % 24(@)(@@) % لولاك يابن أبي عدنان ما عرضت % شوس القوافي لمن بارت بضائعه % 25(@)(@@) % ألفت مدحك والآمال تهتف بي % % وراض جودك أفكارا تطاوعه % 26(@)(@@) % والشعر لا يزدهي مثلي وإن شردت % أمثاله وثنى الأسماع رائعه % 27(@)(@@) % لكن مدحك تغريني علاك به % فالدهر منشده والمجد سامعه % 28(@)(@@) % ومستقل به دون الأنام فتى % تضفو على نغم الراوي بدائعه % 29(@)(@@) % أتاك ، والنائل المرجو بغيته % لديك ، والأدب المجفو شافعه % 30(@)(@@) % خل كريم وشعر سائر وهوى % % ثوى على منحنى الأضلاع ناصعه % PageV01P525 31(@)(@@) % وكيف لا 
ms159	 يبلغ الحاجات طالبها % % وهذه في مباغيه ذرائعه % 32(@)(@@) % فاجذب بضبعي ففي الأحرار مصطنع % وحلية السيد المتبوع تابعه % PageV01P526 البحر : طويل 1(@)(@@) % وليل طويل الباع فرقت شمله % بخرق جميع الرأي غير شتيته % 2(@)(@@) % أهبت به والعيس ميل رقابها % % ليبعد مسرى همه بعد صيته % 3(@)(@@) % فنفض عن أجفانه غبر الكرى % % وقد مال ترنيق النعاس بليته % 4(@)(@@) % وما ظنه ، والنجم واه نطاقه % بأروع محيي ليله ومميته % 5(@)(@@) % هفا مرحا والديك يدعو صباحه % وخاض حشاه والقطا في مبيته % PageV01P527 البحر : كامل تام 1(@)(@@) % أذكى بقلبي لوعة إذ أومضا % % برق أضاء وميضه ذات الأضا % % 2(@)(@@) % فبدا وقد نشر الصباح رداءه % كالأيم ماج به الغدير فنضنضا % % 3(@)(@@) % إن لم يصرح بابتسامك جهرة % فلقد وحبك يالبينى عرضا % % 4(@)(@@) % ونظرت إذ غفل الرقيب فراعني % % نعم لأهلك هام في وادي الغضى % % 5(@)(@@) % وسعت له خطط العدو بغلمة % شوس إذا ابتدروا الوغى ضاق الفضا % % 6(@)(@@) % حيث الغمام تبجست أطباؤه % وكسى الحمى حلل الربيع فروضا % % 7(@)(@@) % ومتيم شرق اللحاظ بدمعه % فإذا استراب به العواذل غمضا % % 8(@)(@@) % هجر الكرى قلق الجفون به فلو % % عثر الخيال بطرفه ما غمضا % % 9(@)(@@) % ونصا الشباب وعن ضمير عاتب % أعطى المشيب قياده لا عن رضى % % 10(@)(@@) % إن ساءه بنزوله فهو الذي % % ساء الأنام مخيما ومغرضا % % PageV01P528 11(@)(@@) % وشكا غراب البين أسود حالكا % حتى شدا بنوى الأحبة أبيضا % % 12(@)(@@) % وتعثرت نوب الزمان بماجد % إن لم يقاتل في النوائب حرضا % % 13(@)(@@) % وإذا تنكر مورد لمطيه % لم يستشف بحافتيه العرمضا % % 14(@)(@@) % وانصاع كالوحشي سابق ظله % وتقعقت عمد الخيام فقوضا % % 15(@)(@@) % لا استنيم إلى الهوان ، ولايرى % % أمري إلى الوكل الجبان مفوضا % % 16(@)(@@) % وأرد طارقة الليالي إن عرت % بعزائمي وهي الصوارم تنتضى % % 17(@)(@@) % وأغر إن بسط المرجي نحوه % كلتا يديه لنائل لم تقبضا % % 18(@)(@@) % وله أمائر سؤدد ، أيس العدا % % منه ، وأمرض حاسديه وأرمضا % % 19(@)(@@) % وجه يجول البشر في صفحاته % ويد تنوب عن الحيا إن برضا % % 20(@)(@@) % ألقت أزمتها إليه همة % كانت على خدع الأماني ريضا % % PageV01P529 21(@)(@@) % وشكرته شكر المهيض جناحه % نبتت قوادم هزهن لينهضا % % 22 
ms160	(@)(@@) % يامنعما بالي ولم يك كاسفا % ومؤثلا مالي ولم أك منفضا % % 23(@)(@@) % أسرفت في الدنيا علي : أواهبا % ألبستني حلل الغنى أم مقرضا ؟ % PageV01P530 البحر : طويل 1(@)(@@) % أبا خالد طال المقام على الأذى % % وضاق بما تسمو له هممي باعي % % 2(@)(@@) % فحل عقال الأرحبي ولا تقم % بحيث تناجي الذل صاح بك الناعي % % PageV01P531 البحر : طويل 1(@)(@@) % حلفت بمرقوع الأظل تشبثت % به فلوات نلن من خطواته % 2(@)(@@) % لأبتغين العز حتى أناله % وأنتزعن المجد من سكناته % 3(@)(@@) % فخير لمن يغضي الجفون على القذى % % ويضرع للأعداء ، فقد حياته % 4(@)(@@) % وما أنس لا أنس العراق وربه % يخادعه أشياعه عن أناته % 5(@)(@@) % ويغرونه بي والإباء سجيتي % % إذا خوفوني ضلة سطواته % 6(@)(@@) % فزرت عماد الدين معتصما به % أسور سؤور الليث في وثباته % 7(@)(@@) % فصدق ظني صدق الله ظنه % بما لاتناجيه المنى من هباته % 8(@)(@@) % ورعت به من لو تأمل صارمي % % رأى الموت يرنو نحوه من شباته % 9(@)(@@) % فأعرض عنه بعدما سابق الردى % % إليه غداة الروع صدر قناته % 10(@)(@@) % وغادرني نضو الهموم بمنزل % تعيب الحبارى شهبة في بزاته % PageV01P532 11(@)(@@) % فثب يا عبيد الله وثبه ماجد % أعير المضاء السيف من عزماته % 12(@)(@@) % ولا تحسبن المال مما يروقني % % فقدما سمونا للغنى من جهاته % 13(@)(@@) % ولي همة تهفو إلى كل سؤدد % تفرع آبائى ذرا هضباته % 14(@)(@@) % وتبغي لديك الانتصار من امرىء % إذا عد مجد كان في أخرياته % 15(@)(@@) % وآباؤه من تعرفون من الورى % % ولولا التقى عرفتكم أمهاته % 16(@)(@@) % وملتحف بالأمن من أنت جاره % ولو كان آساد الشرى من عداته % 17(@)(@@) % فراع حقوق الفضل في ولا تقل % عدوا رماني بالأذى عثراته % 18(@)(@@) % ودونك شعرا إن فضضت ختامه % تضوع ريح الشيح بين رواته % 19(@)(@@) % وألبست دهرا أنت مالك رقه % به غررا يلمعن في صفحاته % 20(@)(@@) % فيا قائليه لو بلغتم به المدى % % عرفتم من المسبوق في حلباته % PageV01P533 21(@)(@@) % وأي فتى ما بين بردي حطه % خطوب تشيب الطفل عن نخواته % 22(@)(@@) % ولست وإن كانت إلي مسيئة % أذم زمانا أنت من حسناته % 23(@)(@@) % سبقت بنيه في قواف أروضها % % فلا تجعلني 