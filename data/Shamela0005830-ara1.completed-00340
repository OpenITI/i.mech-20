ms321	 - (@)(@@) يزيد بن عطارد السدوسي قال أبو حاتم الرازي ليس ممن يحتج بحديثه(@)(@@)(@@)(@@) $ 3796 - (@)(@@) يزيد بن عمر عن مجالد قال أبو حاتم الرازي مجهول(@)(@@)(@@)(@@) $ 3797 - (@)(@@) بزبد بن عوف عن ابن عمر قال أبو حاتم الرازي مجهول(@)(@@)(@@)(@@) $ 3798 - (@)(@@) يزيد بن عياض بن جعدبة أبو الحكم الليثي المكي سكن البصرة وروى عن الزهري وابن المنكدر قال يحيى ليس بشيء ولا يكتب حديثه وقال مرة ليس بثقة وقال علي ضعيف ليس بالقوي سئل مالك عن ابن سمعان فقال كذاب قيل فيزيد بن عياض فقال أكذب وأكذب وقال البخاري ومسلم منكر الحديث وقال السعدي ذهب حديثه وقال النسائي وأحمد بن صالح والأزدي متروك الحديث وقال الفلاس ضعيف الحديث جدا وقال الدراقطني ضعيف(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 3799 - (@)(@@) يزيد بن عيسى مولى بني هاشم بن اهل باب البصرة قال ابن حماد بن سلمة وغيره المقلوبات التي لا تشبه حديث الأثبات لا يجوز الاحتجاج بأفراده(@)(@@)(@@)(@@) $ 3800 - (@)(@@) يزيد بن فراس عن أبان قال الرازي مجهول(@)(@@)(@@)(@@) $ 3801 - (@)(@@) يزيد بن كيسان أبو إسماعيل اليشكري يروي عن أبي حازم الأشجعي قال يحيى بن سعيد ليس ممن يعتمد عليهم وهو وسط صالح وقال ابن معين ثقة وقال الرازي لا يحتج بحديثه ومحله الستر قال المصنف ثم (يزيد بن كيسان أبو منين) روى عنه يحيى بن سعيد القطان قال احمد كان صدوقا(@)(@@)(@@)(@@) $ 3802 - (@)(@@) يزيد بن محمد يروي عن عمر بن عبد العزيز قال الدارقطني مجهول(@)(@@)(@@)(@@) $ 3803 - (@)(@@) يزيد بن مروان الخلال قال يحيى بن معين كذاب وقال ابن حبان يروي الموضوعات عن الأثبات لا يجوز الاحتجاج به بحال(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 3804 - (@)(@@) يزيد بن مسهر قال الرازي مجهول(@)(@@)(@@)(@@) $ 3805 - (@)(@@) يزيد بن معاوية أبو شيبة الخراساني قال أبو حاتم الرازي منكر الحديث وقال أبو زرعة صالح(@)(@@)(@@)(@@) $ 3806 - (@)(@@) يزيد بن مفلس بن عبد الله بن مزيد الباهلي يروي عن مالك وهشام وكان ينفرد عن الثقات بالأشياء المقلوبات وقال ابن حبان لا تجوز الرواية عنه إلا اعتبارا ولا الاحتجاج به(@)(@@)(@@)(@@) $ 3807 - (@)(@@) يزيد بن ميمون قال الرازي مجهول(@)(@@)(@@)(@@) $ 3808 - (@)(@@) يزيد بن يوسف أبو يوسف الشامي 
ms322	 صنعاني صنعاء دمشق حدث عن الأوزاعي قال يحيى ليس بشيء وقال مرة ليس بثقة وقال النسائي والأزدي متروك الحديث وقال أبو علي صالح بن محمد تركوا حديثه وقال الدراقطني ضعيف وقال مرة متروك وقال ابن حبان كان سيء الحفظ كثير الوهم يرفع المراسيل ولا يعلم ويسند الموقوف ولا يفهم فلما كثر ذلك منه سقط الاحتجاج بأفراده(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 3809 - (@)(@@) يسار بن محمد البناني قال يحيى لا شيء(@)(@@)(@@)(@@) || من اسمه ((يسع))(@)(@@)(@@)(@@) $ 3810 - (@)(@@) يسع بن طلحة عن عطاء قال البخاري منكر الحديث وقال أبو حاتم الرازي ليس بالقوي منكر الحديث كان الحميدي يحمل عليه وقال ابن حبان يروي عن عطاء مالا يشبه حديثهم لا يجوز الاحتجاج به بحال(@)(@@)(@@)(@@) $ 3811 - (@)(@@) يسع بن عيسى قال أبو حاتم الرازي مجهول(@)(@@)(@@)(@@) $ 3812 - (@)(@@) يسع بن محمد القرشي يروي عن أبي سليمان الأيلي قال الأزدي منكر الحديث(@)(@@)(@@)(@@) $ 3813 - (@)(@@) يسع بن المغيرة المخزومي قال أبو حاتم الرازي ليس بالقوي(@)(@@) PageV00P000(@)(@@)(@@)(@@) || من اسمه ((يعقوب))(@)(@@)(@@)(@@) $ 3814 - (@)(@@) يعقوب عن ابن سيرين قال الرازي مجهول(@)(@@)(@@)(@@) $ 3815 - (@)(@@) يعقوب أبو يوسف الأعشى يروي عن الأعمش قال الأزدي كذاب يضع الحديث خبيث رجل سوء(@)(@@)(@@)(@@) $ 3816 - (@)(@@) يعقوب بن إبراهيم الزهري الذي يروي عن هشام بن عروة قال ابن عدي ليس بمعروف(@)(@@)(@@)(@@) $ 3817 - (@)(@@) يعقوب بن بشر أبو بشير الحذاء قال أبو حاتم الرازي ضعيف(@)(@@)(@@)(@@) $ 3818 - (@)(@@) يعقوب بن تحية يروي عن يزيد بن هارون وهو مجهول(@)(@@)(@@)(@@) $ 3819 - (@)(@@) يعقوب بن جبير أبو يوسف المكي قال أبو حاتم الرازي مجهول(@)(@@)(@@)(@@) $ 3820 - (@)(@@) يعقوب بن الجهم الحمصي ذكر ابن عدي عن أشياخه تضعيفه وروى له حديثا منكرا وقال ((البلاء فيه منه))(@)(@@)(@@)(@@) $ 3821 - (@)(@@) يعقوب بن حميد بن كاسب المدني سكن مكة وقال يحيى والنسائي ليس بشيء وقال يحيى مرة ليس بثقة وقال مرة ثقة وقال الأزدي ضعيف الحديث(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 3822 - (@)(@@) يعقوب بن أبي زينب قال الرازي مجهول(@)(@@)(@@)(@@) $ 3823 - (@)(@@) يعقوب بن عبد الله بن سعد أبو الحسن القمي الأشعري يروي عن ليث بن أبي سليم وجعفر بن أبي المغيرة روى عنه جرير بن إسماعيل بن أبان قال الدراقطني ليس 
ms323	 بالقوي(@)(@@)(@@)(@@) $ 3824 - (@)(@@) يعقوب بن عبيد بن نشيط رأى عمر بن الخطاب قال الرازي مجهول(@)(@@)(@@)(@@) $ 3825 - (@)(@@) يعقوب بن عطاء بن أبي رباح المكي قال أحمد ويحيى ضعيف(@)(@@)(@@)(@@) $ 3826 - (@)(@@) يعقوب بن عوذ بن سماك الأنصاري قال الرازي مجهول(@)(@@)(@@)(@@) $ 3827 - (@)(@@) يعقوب بن فضالة الخزاعي قال أبو حاتم الرازي مجهول(@)(@@)(@@)(@@) $ 3828 - (@)(@@) يعقوب بن محمد بن عيسى بن عبد الملك أبو يوسف الزهري حدث عن إبراهيم بن سعد وهشام بن عروة قال أحمد ليس بشيء وقال مرة لا يساوي شيئا وقد ضعفه أبو زرعة وقد روى عنه الخرائطي فقال (يعقوب بن عيسى) وكأنه قصد تدليسه(@)(@@)(@@)(@@) $ 3829 - (@)(@@) يعقوب بن موسى المدني يروي عن مسلمة بن راشد قال الأزدي مجهول(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 3830 - (@)(@@) يعقوب بن الوليد أبو يوسف وقيل أبو هلال الأزدي مدني روى عن هشام بن عروة وأبي حازم وقال أحمد كان من الكذابين الكبار يضع الحديث وقال يحيى لم يكن بشيء كذاب وقال أبو زرعة غير ثقة ولا مأمون وقال الرازي والنسائي متروك الحديث وقال أبو زرعة ليس بشيء قال ابن حبان يضع الحديث على الثقات لا يحل كتب حديثه إلا على التعجب وقال الدارقطني ضعيف(@)(@@)(@@)(@@) || من اسمه ((يعلى))(@)(@@)(@@)(@@) $ 3831 - (@)(@@) يعلى بن الأشدق أبو الهيثم العقيلي الجزري قال أبو حاتم الرازي ضعيف الحديث وقال أبو زرعة ليس بشيء وقال ابن عدي روى عن عمه عبد الله بن جراد عن النبي صلى الله عليه وسلم أحاديث كثيرة منكرة وهو وعمه غير معروفين قال البخاري لا يكتب حديثه وقال ابن حبان لقي يعلى عبد الله بن جراد فلما كبر اجتمع عليه من لا دين له فوضعوا له شبيها بمائتي حديث نسخة عن عبد الله بن جراد فجعل يحدث بها وهو لا يدري لا تحل الرواية عنه بحال(@)(@@)(@@)(@@) $ 3832 - (@)(@@) يعلى بن عباس الصنعاني(@)(@@)(@@)(@@) $ 3833 - (@)(@@) ويعلى بن أبي يحيى قال أبو حاتم الرازي مجهولان(@)(@@)(@@)(@@) || (@)(@@)(@@)(@@) $ 3834 - (@)(@@) يعيش روى عنه الحارث بن مرة قال الرازي مجهول(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 3835 - (@)(@@) يعتم ين سالم بن قنبر البصري مولى علي قال ابن عدي يروي عنه أنس مناكير وعامة 
ms324	 احاديثه غير محفوظة وقال أبو حاتم الرازي مجهول ضعيف الحديث وقال ابن حيان يضع الحديث على أنس(@)(@@)(@@)(@@) || من اسمه ((يمان))(@)(@@)(@@)(@@) $ 3836 - (@)(@@) يمان أبو حذيفة وقيل ابن حذيفة البصري يروي [عن] عمرة قال الدراقطني ضعيف(@)(@@)(@@)(@@) $ 3837 - (@)(@@) يمان بن رئاب الخراساني قال الدراقطني ضعيف يرى رأى الخوارج(@)(@@)(@@)(@@) $ 3838 - (@)(@@) يمان بن سعيد أبو رضوان الشامي المصيصي قال الدراقطني ضعيف(@)(@@)(@@)(@@) $ 3839 - (@)(@@) يمان بن عدي أبو عدي الحضرمي الحمصي يروي عن أبي منيب الحرشي والزبيدي قال أحمد هو ضعيف رفع حديث التفليس قال فيه (عن أبي هريرة) قال الدراقطني ضعيف(@)(@@)(@@)(@@) $ 3840 - (@)(@@) يمان بن معن المديني قال أبو حاتم الرازي مجهول(@)(@@)(@@)(@@) $ 3841 - (@)(@@) يمان بن المغيرة بن حذيفة العنزي التيمي البصري يروي عن عطاء بن أبي رباح قال يحيى ليس بشيء وقال السعدي لا يحمد الناس حديثه وقال النسائي ليس بثقة وقال البخاري منكر الحديث وقال أبو زرعة والدارقطني ضعيف وقال ابن حبان يروي المناكير التي لا أصول لها فاستحق الترك(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 3842 - (@)(@@) يمان بن نصر قال أبو حاتم الرازي مجهول(@)(@@)(@@)(@@) || من اسمه ((يوسف))(@)(@@)(@@)(@@) $ 3843 - (@)(@@) يوسف بن إبراهيم أبو يوسف اللآلي التيمي قال أبو حاتم الرازي ضعيف الحديث منكر الحديث عنده عجائب وقال ابن حبان يروي عن أنس ما ليس من حديثه لا تحل الرواية عنه(@)(@@)(@@)(@@) $ 3844 - (@)(@@) يوسف بن أسباط بن واسط أبو محمد الشيباني قال أبو حاتم الرازي كان رجلا صالحا لكنه دفن كتبه ثم حدث من حفظه فكان يغلط كثيرا لا يحتج به وقال يحيى ثقة وقال المصنف قلت وثم آخران يقال لهما (يوسف بن أسباط) لم يقدح فيهما(@)(@@)(@@)(@@) $ 3845 - (@)(@@) يوسف بن بحر بن عبد الرحمن التيمي الأطرابلسي قاض حمص قال ابن عدي ليس بالقوي رفع أحاديث واتى على الثقات بمناكير(@)(@@)(@@)(@@) $ 3846 - (@)(@@) يوسف بن جعفر بن علي الخوارزمي يروي عن إسحاق بن إبراهيم اليماني قال أبو سعيد محمد بن علي النقاش كان يضع الحديث(@)(@@)(@@)(@@) $ 3747 - (@)(@@) يوسف بن خالد بن عمر أبو خالد السمتي البصري يروي عن زياد بن سعد قال يحيى كذاب خبيث عدوالله رجل سوء 
ms325	 لا يحدث عنه أحد فيه خير وقال مرة زنديق لا يكتب حديثه وقد روى عنه الشافعي وقال كان ضعيفا وقال عمرو بن علي كان يكذب وقال النسائي كذاب متروك الحديث وقال أبو زرعة ذاهب الحديث وقال ابن حبان كان يضع الأحاديث على الشيوخ ويقرأ عليهم ثم يرويها عنهم لا تحل الرواية عنه(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 3848 - (@)(@@) يوسف بن الخطاب المدني قال أبو حاتم الرازي مجهول(@)(@@)(@@)(@@) $ 3849 - (@)(@@) يوسف بن أبي ذرة يروي عن جعفر بن عمرو الضمري قال يحيى لا شيء وقال ابن حبان يروي المناكير التي لا أصل لها من كلام رسول الله صلى الله عليه وسلم لا يحل الاحتجاج به بحال(@)(@@)(@@)(@@) $ 3850 - (@)(@@) يوسف بن زياد أبو عبد الله يروي عن عبد الرحمن الإفريقي وابن أبي خالد قال البخاري منكر الحديث وقال الدراقطني هو مشهور بالأباطيل(@)(@@)(@@)(@@) $ 3851 - (@)(@@) يوسف بن زياد بن عبد الله النهدي البصري قال الرازي منكر الحديث(@)(@@)(@@)(@@) $ 3852 - (@)(@@) يوسف بن سعيد الجذامي قال أبو حاتم الرازي مجهول(@)(@@)(@@)(@@) $ 3853 - (@)(@@) يوسف بن السفر أبو الفيض الشامي كاتب الأوزاعي قال أبو زرعة والنسائي والدارقطني متروك الحديث وقال دحيم ليس بشيء وقال أبو حاتم الرازي منكر الحديث جدا وقال الدراقطني مرة اخرى متروك يكذب قال وقد روى عنه عبد الله بن عمران العائذي فقال (يوسف بن الفيض) وقال ابن حبان لا يجوز الاحتجاج به بحال(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 3854 - (@)(@@) يوسف بن عطية أبو سهل الصفار الباهلي البصري السعدي يروي عن قتادة وثابت قال يحيى ليس بشيء وقال السعدي لا يحمد حديثه وقال النسائي متروك الحديث وقال عمرو بن علي كثير الوهم والخطا وما كلمته كان يكذب وقال أبو حاتم الرازي وأبو زرعة والدارقطني ضعيف الحديث وقال ابن حبان يقلب الأخبار ويلزق المتون الموضوعة بالأسانيد الصحيحة لا يجوز الاحتجاج به(@)(@@)(@@)(@@) $ 3855 - (@)(@@) يوسف بن عطية أبو المنذر الوراق الكوفي حدث عن ميمون بن أبي حمزة وعمرو بن شمر قال عمرو بن علي هو اكذب من البصري حدث بأحاديث منكرة عن قوم معروفين وقال الدارقطني ضعيف(@)(@@)(@@)(@@) $ 3856 - (@)(@@) يوسف بن الغرق البصري 
ms326	 يروي عن هشام الدستوائي قال الرازي ليس بالقوي قال أبو الفتح الأزدي هو كذاب وقال أبو علي الحافظ هو منكر الحديث(@)(@@)(@@)(@@) $ 3857 - (@)(@@) يوسف بن محمد بن المنكدر يروي عن أبيه قال أبو حاتم الرازي ليس بقوي وقال ابن حماد والنسائي والأزدي هو متروك الحديث وقال الدراقطني ضعيف وقال أبو زرعة صالح وقال ابن حبان غلب عليه الصلاح فغفل عن الحفظ فكان يأتي بالشيء توهما فبطل الاحتجاج به(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 3858 - (@)(@@) يوسف بن ميمون أبو خزيمة الصباغ الكوفي وقيل البصري يروي عن عطاء قال احمد ضعيف ليس بشيء وقال أبو حاتم الرازي والبخاري منكر الحديث وقال أبو زرعة واهي الحديث وقال الدارقطني ضعيف وقال ابن حبان فاحش الخطأ كثير الوهم يروي عن الثقات ما لا يشبه حديث الأثبات فلما فحش ذلك بطل الاحتجاج به(@)(@@)(@@)(@@) $ 3859 - (@)(@@) يوسف بن يزيد أبو معشر البراء كان يبري العود قال يحيى ضعيف(@)(@@)(@@)(@@) $ 3860 - (@)(@@) يوسف بن يعقوب القاضي باليمن قال أبو حاتم الرازي مجهول(@)(@@)(@@)(@@) $ 3861 - (@)(@@) يوسف بن يعقوب بن يوسف أبو عمرو النيسابوري روى عن أبي بكر بن أبي شيبة قال أبو علي الحافظ ما رأيت نيسابوريا يكذب غيره وقال البرقاني لا يساوي شيئا(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 3682 - (@)(@@) يوسف بن يونس بن يعقوب الأفطس طرسوسي يروي عن سليمان بن بلال قال ابن عدي كل ما روى عن الثقات منكر وقال ابن حبان يروي عن سليمان بن بلال ما ليس من حديثه لا يجوز الاحتجاج به إذا انفرد وقال الدارقطني ثقة(@)(@@)(@@)(@@) || من اسمه ((يونس))(@)(@@)(@@)(@@) $ 3863 - (@)(@@) يونس بن أبي إسحاق قال أبو حاتم الرازي كان صدوقا إلا أنه لا يحتج بحديثه يونس بن الحارث الطائفي يروي عن أبي بردة وقال أحمد أحاديثه مضطربة وضعفه وقال النسائي ضعيف وقال يحيى لا شيء وقال في رواية ليس به من بأس ويكتب حديثه(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 3865 - (@)(@@) يونس بن خباب أبو حمزة الكوفي مولى لبني أسد يروي عن عطاء ومجاهد كان شديد الرفض قال يحيى بن سعيد كان كذابا قال يحيى بن معين ليس بشيء رجل سوء وقال مرة ضعيف 
ms327	 وكذلك قال النسائي وقال ابن حبان لا تحل الرواية عنه وقال الدراقطني كان رجل سوء فيه شيعية مفرطة كان يسب عثمان وذكر الدارقطني عن عباد بن العوام أنه سمع يونس بن خباب حدث بحديث القبر وزاد فيه (00 يسئل عن علي 00) قال فقلت له لم تسمع بهذا فقال أنت من هؤلاء الذين يحبون عثمان الذي قتل ابنتي رسول الله صلى الله عليه وسلم قلت له قتل واحدة فلم زوجه الأخرى(@)(@@)(@@)(@@) $ 3866 - (@)(@@) يونس بن شعيب يروي عن أبي أمامة قال البخاري منكر الحديث وقال ابن حبان لا يجوز الاحتجاج به بحال(@)(@@)(@@)(@@) $ 3867 - (@)(@@) يونس بن عبد ربه الجزري قال الأزدي مجهول منكر الحديث(@)(@@)(@@)(@@) $ 3868 - (@)(@@) يونس بن عبد الرحمن العسقلاني قال أبو حاتم الرازي ليس بالقوي(@)(@@)(@@)(@@) $ 3869 - (@)(@@) يونس بن عطاء بن عثمان بن ربيعة الصدائي يروي عن حميد بن زادويه الطويل وقال ابن حبان يروي العجائب لا يجوز الاحتجاج به إذا انفرد(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 3870 - (@)(@@) يونس بن العيزار قال أبو حاتم الرازي مجهول(@)(@@)(@@)(@@) $ 3781 - (@)(@@) يونس بن [أبي] الفرات الإسكاف قال ابن حبان لا يجوز الاحتجاج به لغلبة المناكير في حديثه(@)(@@)(@@)(@@) $ 3872 - (@)(@@) يونس بن أبي فروة الشامي(@)(@@)(@@)(@@) $ 3873 - (@)(@@) ويونس بن أبي النعمان قال أبو حاتم الرازي مجهولان(@)(@@)(@@)(@@) $ 3874 - (@)(@@) يونس بن هارون الأردني قال ابن حبان يروي عن مالك العجائب لا تحل الرواية عنه ولا الاحتجاج به بحال(@)(@@)(@@)(@@) $ 3875 - (@)(@@) يونس بن واقد أبو الجنيد قال أبو حاتم الرازي مجهول(@)(@@)(@@)(@@) $ 3876 - (@)(@@) يونس بن أبي يعفور العبدي يروي عن أبيه واسم أبيه وقدان قال يحيى والنسائي كان ضعيفا وقال ابن حبان يروي عن الثقات ما لا يشبه حديث الأثبات(@)(@@) PageV00P000(@)(@@)(@@)(@@) | ذكر الكنى لمن لم يعرف اسمهم من الضعفاء والمتروكين أو لمن اشتهر بالكنية(@)(@@)(@@)(@@) $ 3877 - (@)(@@) أبو أدام واسمه سليمان وقد سبق في حرف السين(@)(@@)(@@)(@@) $ 3878 - (@)(@@) أبو الأزهر الخراساني عن عبد الله بن عمير قال الأزدي متروك(@)(@@)(@@)(@@) $ 3879 - (@)(@@) أبو إسحاق الحجازي يروي عن موسى بن أبي عائشة قال ابن حبان لا يجوز الاحتجاج به(@)(@@)(@@)(@@) $ 3880 - (@)(@@) أبو إسحاق الكوفي روى عنه هشيم ويقال 
ms328	 أبو ليلى قال الأزدي ليس بثقة(@)(@@)(@@)(@@) $ 3881 - (@)(@@) أبو اسماعيل السكوني قال أبو حاتم الرازي مجهول(@)(@@)(@@)(@@) $ 3882 - (@)(@@) أبو أشرس الكوفي قال ابن حبان لا يحل ذكره في الكتب إلا على سبيل الاخبار عنه وروى عن شريك ما لم يحدث به(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 3883 - (@)(@@) أبو الأصفر يروي عن صعصعة بن معاوية قال ابن حبان لا يجوز الاحتجاج به(@)(@@)(@@)(@@) $ 3884 - (@)(@@) أبو الأعين العبدي يروي عن أبي الأحوص قال يحيى بن معين ضعيف لا يعرف وقال ابن حبان كان يأتي بأشياء مقلوبة واوهام كانه يتعمدها فلا يجوز الاحتجاج به(@)(@@)(@@)(@@) $ 3885 - (@)(@@) أبو أمية البصري قد سبق في من اسمه (اسماعيل)(@)(@@)(@@)(@@) $ 3886 - (@)(@@) أبو بشر عن أبي الزاهرية قال يحيى لا شيء(@)(@@)(@@)(@@) $ 3887 - (@)(@@) أبو بكر الأعشى سبق في من اسمه (عبد الحميد)(@)(@@)(@@)(@@) $ 3888 - (@)(@@) أبو بكر المديني يروي عن أبي هريرة قال أبو حاتم الرازي مجهول(@)(@@)(@@)(@@) $ 3889 - (@)(@@) أبو بكر بن أبي الأزهر يروي عن أبي كريب قال ابن ثابت الخطيب كان يضع الحديث على الثقات(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 3890 - (@)(@@) أبو بكر ابن عبد الله بن أبي العطاف النهشلي الكوفي يروي عن أبي بردة بن أبي موسى قال ابن حبان كان شيخا صالحا لكن غلب عليه التقشف حتى صار يهم ولا يعلم فبطل الاحتجاج به(@)(@@)(@@)(@@) $ 3891 - (@)(@@) أبو بكر بن عبد الله بن محمد بن أبي سبرة المديني حدث عن زيد بن أسلم قال احمد كان يضع الحديث ويكذب وقال يحيى ليس حديثه بشيء وقال البخاري منكر الحديث وقال النسائي متروك الحديث وقال الدراقطني ضعيف(@)(@@)(@@)(@@) $ 3892 - (@)(@@) أبو بكر بن عبد الله بن أبي مريم الغساني الحمصي قيل اسمه بكير وقيل بكر وقيل عبد السلام وقد سبق في من اسمه بكير(@)(@@)(@@)(@@) $ 3893 - (@)(@@) أبو بكر بن عياش يقال اسمه شعبة ويقال محمد ويقال سالم ويقال اسمه كنيته وهو مولى واصل بن حيان وهو القارئ الزاهد قال احمد هو ثقة وربما غلط وكان يحيى بن سعيد لا يعبأ به وإذا ذكر عنده كلح وجهه وكان محمد بن عبد الله بن نمير يضعفه وقال يحيى بن معين ثقة(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 3894 
ms329	 - (@)(@@) أبو بكر بن عياش الحمصي حدث عن جعفر بن عبد الواحد الهاشمي عنه عن عثمان بن شباك الشامي قال أبو الخطيب عثمان وأبو بكر مجهولان وجعفر غير ثقة قال المصنف قلت وثم آخر يقال له (أبو بكر بن عياش السلمي) حدث عن جعفر بن مروان وكان فاضلا قال الخطيب وله كتاب مصنف في غريب الحديث(@)(@@)(@@)(@@) $ 3895 - (@)(@@) أبو بلج قد سبق في من اسمه (يحيى)(@)(@@)(@@)(@@) $ 3896 - (@)(@@) أبو توبة القصاص البصري قال الدراقطني ضعيف(@)(@@)(@@)(@@) $ 3897 - (@)(@@) أبو جنادة قد سبق في من اسمه (حصين)(@)(@@)(@@)(@@) $ 3898 - (@)(@@) أبو الجنيد الضرير قال يحيى ليس بثقة(@)(@@)(@@)(@@) $ 3899 - (@)(@@) أبو الجهم الأيادي الواسطي قال أحمد مجهول وقال أبو زرعة واهي الحديث وقال ابن حبان يروي عن الزهري ما ليس من حديثه وقال الأزدي ضعيف مجهول(@)(@@)(@@)(@@) $ 3990 - (@)(@@) أبو حريز قد سبق في من اسمه سهل(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 3901 - (@)(@@) أبو الحسن الأزدي روى عنه أبو كريب قال أبو حاتم الرازي مجهول(@)(@@)(@@)(@@) $ 3902 - (@)(@@) أبو حفص العبدي واسمه (عمر بن حفص) قال يحيى ليس بشيء وقال الدراقطني ضعيف(@)(@@)(@@)(@@) $ 3903 - (@)(@@) أبو حكيم الأزدي يروي عن عباد بن منصور قال ابن حبان يأتي عن الثقات بما لا يتابع عليه(@)(@@)(@@)(@@) $ 3904 - (@)(@@) أبو حماد الكوفي الحنفي (واسمه المفضل بن صدقة) قال الدارقطني ليس بالقوي(@)(@@)(@@)(@@) $ 3905 - (@)(@@) أبو خلف عن انس قال يحيى كذاب(@)(@@)(@@)(@@) $ 3906 - (@)(@@) أبو الخير حدث عن أبي البحتري وكان كذابا ذكره إبراهيم الحربي(@)(@@)(@@)(@@) $ 3907 - (@)(@@) أبو داود المديني عن ابن عمرو قال أبو حاتم الرازي مجهول(@)(@@)(@@)(@@) $ 3908 - (@)(@@) أبو داود النخعي قد سبق في من اسمه سليمان(@)(@@)(@@)(@@) $ 3909 - (@)(@@) أبو داود الواسطي قال أبو حاتم الرازي مجهول(@)(@@)(@@)(@@) $ 3910 - (@)(@@) أبو الدهماء يروي عن محمد بن عمرو قال ابن حبان يروي المقلوبات ويأتي عن الثقات بما لا يشبه حديث الأثبات فلا يحتج به إذا انفرد(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 3911 - (@)(@@) أبو رجاء الجزري يروي عن فرات بن السائب قال ابن حبان لا يجوز الاحتجاج بأفراده(@)(@@)(@@)(@@) $ 3912 - (@)(@@) أبو رجاء الحنفي عن أبي موسى قال علي المديني مجهول(@)(@@)(@@)(@@) $ 3913 - (@)(@@) أبو زرعة عن أبي إدريس(@)(@@)(@@)(@@) $ 3914 - (@)(@@) وأبو الزعيزعة كاتب مروان 
ms330	 قال أبو حاتم الرازي كلاهما مجهول(@)(@@)(@@)(@@) $ 3915 - (@)(@@) أبو زيد عن رزيق قال أبو حاتم الرازي مجهولان(@)(@@)(@@)(@@) $ 3916 - (@)(@@) أبو زيد مولى عمرو بن حريث الذي يروي حديث النبيذ عن ابن مسعود قال البخاري رجل مجهول لا يعرف بصحبة عبد الله وقال أبو زرعة مجهول لا يعرف وقال ابن حبان لا يدري من هو ولا يعرف أبوه ولا بلده(@)(@@)(@@)(@@) $ 3917 - (@)(@@) أبو سعد الساعدي يروي عن انس بن مالك قال أبو حاتم الرازي مجهول وقال ابن حبان يروي المناكير ولا يجوز الاحتجاج به(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 3918 - (@)(@@) أبو سفيان الأنماري يروي عن حبيب بن عبد الله بن أبي كبشة وسالم الحناط قال ابن حبان يروي الطامات قال أبو حاتم الرازي مجهول(@)(@@)(@@)(@@) $ 3919 - (@)(@@) أبو سفيان السعدي واسمه (طريف بن مجالد) قال الدارقطني ضعيف(@)(@@)(@@)(@@) $ 3920 - (@)(@@) أبو سفيان الصواف قد سبق اسمه في (عبد الله)(@)(@@)(@@)(@@) $ 3921 - (@)(@@) أبو سفيان الصيرفي يقال له ابن رواحة روى عن ابن عون قال الأزدي يكذب(@)(@@)(@@)(@@) $ 3922 - (@)(@@) أبو سفيان بن عبد ربه قال أبو حاتم الرازي مجهول(@)(@@)(@@)(@@) $ 3923 - (@)(@@) أبو السكن يروي عن الشعبي قال يحيى لم يكن بشيء كذاب(@)(@@)(@@)(@@) $ 3924 - (@)(@@) أبو سلمة عن شهر بن حوشب قال الرازي ضعيف الحديث(@)(@@)(@@)(@@) $ 3925 - (@)(@@) أبو سورة يروي عن أبي أيوب الأنصاري قال الدارقطني مجهول(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 3926 - (@)(@@) أبو شهاب عن زيد بن أسلم قال الرازي مجهول(@)(@@)(@@)(@@) $ 3927 - (@)(@@) أبو شيبة الجوهري يروي عن انس قال الأزدي متروك الحديث(@)(@@)(@@)(@@) $ 3928 - (@)(@@) أبو صحار قال الرازي هو مجهول(@)(@@)(@@)(@@) $ 3929 - (@)(@@) أبو صفوان عن خطاب قال أبو حاتم الرازي ضعيف(@)(@@)(@@)(@@) $ 3930 - (@)(@@) أبو الصلت قد سبق في من اسمه (عبد السلام)(@)(@@)(@@)(@@) $ 3931 - (@)(@@) أبو الطيب الحربي عن عبد العزيز بن أبي رواد قال ابن حبان شيخ يروي الأعاجيب لا يجوز الاحتجاج به بحال وقال يحيى بن معين أبو الطيب الحربي سمع من معمر كذاب خبيث(@)(@@)(@@)(@@) $ 3932 - (@)(@@) أبو عامر الصائغ يروي عن أبي خلف الأعمى عن انس قال الأزدي يضع الحديث من معادن الكذب(@)(@@)(@@)(@@) $ 3933 - (@)(@@) أبو عباد الزاهد قال ابمنحبان يروي عن مخلد بن الحسين ما لم يحدث به 
ms331	 لا يحل(@)(@@) PageV00P000(@)(@@) الإحتجاج به(@)(@@)(@@)(@@) $ 3934 - (@)(@@) أبو عبد الرحمن الشامي يروي عن عبادة بن لسي قال الأزدي كذاب لا يكت حديثه(@)(@@)(@@)(@@) $ 3935 - (@)(@@) أبو عبد السلام يروي عن ابن عمر قال الدارقطني مجهول وقال في موضع آخر الزبير أبو عبد السلام يروي عنه حماد بن سلمة يحدث عن أيوب بن عبد الله بن مكرز عن ابن مسعود بالمنكرات قال الدارقطني وقد ذكره ابن حبان فقال أيوب بن عبد السلام لا يجوز الاحتجاج به(@)(@@)(@@)(@@) $ 3936 - (@)(@@) أبو عبد الله البكاء يروي عن أبي خلف عن انس قال الأزدي متروك الحديث(@)(@@)(@@)(@@) $ 3937 - (@)(@@) أبو عبد الله البكري يروي عن سعيد المقبري قال ابن حبان ينفرد عن الثقات بالمقلوبات لا يجوز الاحتجاج به إذا انفرد(@)(@@)(@@)(@@) $ 3938 - (@)(@@) أبو عبد الله الشامي يروي عن أبي مليكة الذماري قال الأزدي ضعيف جدا(@)(@@)(@@)(@@) $ 3939 - (@)(@@) أبو عبد الله القهستاني يروي عن أبي إسحاق قال الأزدي ضعيف مجهول(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 3940 - (@)(@@) أبو عبيد عن انس بن مالك قال الأزدي شبيه لا شيء(@)(@@)(@@)(@@) $ 3941 - (@)(@@) أبو عبيدة بن الفضيل بن عياض ضعيف(@)(@@)(@@)(@@) $ 3942 - (@)(@@) أبو عروة عن زياد قال أبو حاتم الرازي مجهول(@)(@@)(@@)(@@) $ 3943 - (@)(@@) أبو عقال عن أنس ذكرناه في من اسمه هلال)(@)(@@)(@@)(@@) $ 3944 - (@)(@@) أبو عقيل قال أبو حاتم الرازي مجهول(@)(@@)(@@)(@@) $ 3945 - (@)(@@) أبو العلاء شيخ يروي عن نافع ما ليس من حديثه قال ابن حبان لا يجوز الاحتجاج به(@)(@@)(@@)(@@) $ 3946 - (@)(@@) أبو العلاء الشامي يروي عن أبي أمامة قال الدراقطني هو مجهول(@)(@@)(@@)(@@) $ 3947 - (@)(@@) أبو عمار عن علي قال أبو حاتم الرازي مجهول(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 3948 - (@)(@@) أبو عمر عن الزهري قال أبو حاتم الرازي مجهول(@)(@@)(@@)(@@) $ 3949 - (@)(@@) أبو عمر الشامي يروي عن مكحول قال الأزدي متروك(@)(@@)(@@)(@@) $ 3950 - (@)(@@) أبو عمر بن محمد قد سبق فين اسمه (عبد الكبير)(@)(@@)(@@)(@@) $ 3951 - (@)(@@) أبو عمرو الجملي عن زاذان(@)(@@)(@@)(@@) $ 3952 - (@)(@@) وأبو عمرو الداري عن ابن عجلان(@)(@@)(@@)(@@) $ 3953 - (@)(@@) وأبو العوام الدوسي عن أبي ذر(@)(@@)(@@)(@@) $ 3954 - (@)(@@) أبو عون بن أبي ركبة عن غيلان بن جرير قال أبو حاتم الرازي مجهول(@)(@@)(@@)(@@) $ 3955 - (@)(@@) أبو العيال قال أبو حاتم الرازي مجهول(@)(@@)(@@)(@@) $ 3956 - (@)(@@) أبو عيسى 
ms332	 عن ابن مسعود قال أبو حاتم الرازي مجهول(@)(@@)(@@)(@@) $ 3957 - (@)(@@) أبو غطفان عن أبي هريرة قال الدراقطني مجهول(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 3958 - (@)(@@) أبو الفرج مولى عمر بن عبد العزيز قال أبو زرعة كان يكذب(@)(@@)(@@)(@@) $ 3959 - (@)(@@) أبو الفضل عن عنبسة بن سعيد قال الرازي مجهولان(@)(@@)(@@)(@@) $ 3960 - (@)(@@) أبو الفضل عن أبي الجوزاء قال الأزدي متروك الحديث(@)(@@)(@@)(@@) $ 3961 - (@)(@@) أبو الفيض عن نافع قال علي ليس بشيء(@)(@@)(@@)(@@) $ 3962 - (@)(@@) أبو القاسم الضرير عن عبد العزيز الماجشون قال أبو زرعة منكر الحديث(@)(@@)(@@)(@@) $ 3963 - (@)(@@) أبو كرز القرشي قد سبق في من اسمه (عبد الله)(@)(@@)(@@)(@@) $ 3964 - (@)(@@) أبو كعب الحارثي رأى عثمان قال الرازي مجهول(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 3965 - (@)(@@) أبو ليلى سمع عبيد الله بن أبي بكر قال يحيى ليس بشيء(@)(@@)(@@)(@@) $ 3966 - (@)(@@) أبو ليلى عن بريدة قال يحيى ضعيف(@)(@@)(@@)(@@) $ 3967 - (@)(@@) أبو ماجد الحنفي يروي عن ابن مسعود قال الدراقطني مجهول(@)(@@)(@@)(@@) $ 3968 - (@)(@@) أبو مالك الواسطي يروي عن داود بن أبي هند قال الأزدي تركوا حديثه(@)(@@)(@@)(@@) $ 3969 - (@)(@@) أبو مبارك عن عطاء بن أبي رباح قال أبو حاتم الرازي مجهول(@)(@@)(@@)(@@) $ 3970 - (@)(@@) أبو المثنى قد سبق في من اسمه (سليمان)(@)(@@)(@@)(@@) $ 3971 - (@)(@@) أبو محمد عن الحسن قال أبو حاتم الرازي مجهول(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 3972 - (@)(@@) أبو محمد عن أبي كنانة قال أبو حاتم الرازي مجهول(@)(@@)(@@)(@@) $ 3973 - (@)(@@) أبو محمد عن عائشة قال ابن حبان يروي عنها ما لم تحدث به الثقات عنها لا يجوز الاحتجاج به(@)(@@)(@@)(@@) $ 3974 - (@)(@@) أبو محمد البصري عن الحسن بن علي(@)(@@)(@@)(@@) $ 3975 - (@)(@@) وأبو محمد البصري عن نعيم بن أبي هند قال أبو حاتم الرازي مجهولان(@)(@@)(@@)(@@) $ 3976 - (@)(@@) أبو محمد الثقفي يروي عن انس قال الأزدي لا يكتب حديثه(@)(@@)(@@)(@@) $ 3977 - (@)(@@) أبو محمد الخراساني روى عنه أبو عبد الرحمن المقرئ قال أبو حاتم الرازي مجهول(@)(@@)(@@)(@@) $ 3978 - (@)(@@) أبو محمد الشامي يروي عن التابعين قال الأزدي كذاب مجهول(@)(@@)(@@)(@@) $ 3979 - (@)(@@) أبو مخيس اليشكري روى عن انس قال الأزدي متروك مجهول(@)(@@)(@@)(@@) $ 3980 - (@)(@@) أبو مرزوق عن أبي غالب قال ابن حبان رويا ما لم يتابعا عليه لا يحتج بهما(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 3981 - (@)(@@) أبو مرزوق التجيبي(@)(@@)(@@)(@@) $ 3982 - (@)(@@) وأبو مسكين الجزري عن إسماعيل بن 
ms333	 نشيط(@)(@@)(@@)(@@) $ 3983 - (@)(@@) وأبو مطر البصري قال الرازي كلهم مجاهيل(@)(@@)(@@)(@@) $ 3984 - (@)(@@) أبو المطوس المكي قال ابن حبان يروي عن أبيه ما لا يتابع عليه لا يجوز الاحتجاج بأفراده(@)(@@)(@@)(@@) $ 3985 - (@)(@@) أبو معمر يروي عن انس ما لم يحدث به قال ابن حبان لا يحل ذكره إلا على سبيل الأخبار عن امره(@)(@@)(@@)(@@) $ 3986 - (@)(@@) أبو معن الأيلي قال الأزدي ضعيف غير معروف(@)(@@)(@@)(@@) $ 3987 - (@)(@@) أبو مقاتل السمرقندي سبق فيمن اسمه حفص قال ابن مهدي والله ما تحل الرواية عنه(@)(@@)(@@)(@@) $ 3988 - (@)(@@) أبو المنيب له صحبة قال الرازي مجهول(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 3989 - (@)(@@) أبو المهاجر الرقي عن ميمون بن مهران قال الأزدي ضعيف(@)(@@)(@@)(@@) $ 3990 - (@)(@@) أبو موسى الصفار عن ابن عباس قال الرازي مجهول(@)(@@)(@@)(@@) $ 3991 - (@)(@@) أبو موسى الهمداني عن علي قال الرازي مجهول(@)(@@)(@@)(@@) $ 3992 - (@)(@@) أبو ناشرة قال الدراقطني مجهول(@)(@@)(@@)(@@) $ 3993 - (@)(@@) أبو نصيرة يروي عن التابعين قال الأزدي ضعيف(@)(@@)(@@)(@@) $ 3994 - (@)(@@) أبو النعمان عن أبي وقاص قال الرازي مجهول(@)(@@)(@@)(@@) $ 3995 - (@)(@@) أبو النعمان الأنصاري يروي عن هشام بن عروة المناكير وقال ابن حبان لا يجوز الاحتجاج به بحال(@)(@@)(@@)(@@) $ 3996 - (@)(@@) أبو نعيم عن محمد بن زياد البلخي قال الرازي مجهول(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 3997 - (@)(@@) أبو هارون الشامي يروي عن الحكم بن عتيبة قال السعدي ساقط(@)(@@)(@@)(@@) $ 3998 - (@)(@@) أبو هاشم عن أبي هريرة قال الدارقطني مجهول(@)(@@)(@@)(@@) $ 3999 - (@)(@@) أبو همدان القاسم بن بهرام قال الدارقطني متروك وقال ابن عدي كذاب(@)(@@)(@@)(@@) $ 4000 - (@)(@@) أبو همدان بن هارون قال يحيى كذاب(@)(@@)(@@)(@@) $ 4001 - (@)(@@) أبو الهندي عن أنس مجهول ولا يعرف اسمه قاله الخطيب(@)(@@)(@@)(@@) $ 4002 - (@)(@@) أبو الهيثم البصري عن سعيد بن أبي عمرة قال الرازي مجهول(@)(@@)(@@)(@@) $ 4003 - (@)(@@) أبو الهيثم القرشي عن موسى بن عقبة قال الأزدي كذاب(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 4004 - (@)(@@) أبو وقاص عن زيد بن أرقم قال الرازي مجهول(@)(@@)(@@)(@@) $ 4005 - (@)(@@) أبو بحبى تقدم فيمن اسمه (سليم)(@)(@@)(@@)(@@) $ 4006 - (@)(@@) أبو يحيى القتات قد سبق في من اسمه (عبد الرحمن)(@)(@@)(@@)(@@) $ 4007 - (@)(@@) أبو يحيى المدني مولى آل الزبير يروي عن بشر بن مطعم قال الأزدي جميعا مجهولان(@)(@@)(@@)(@@) $ 4008 - (@)(@@) أبو يحيى الوقار تقدم فيمن اسمه (زكريا)(@)(@@)(@@)(@@) $ 4009 - (@)(@@) أبو يزيد الضبي عن ميمونة بنت 
ms334	 سعد قال الدارقطني ليس بمعروف(@)(@@)(@@)(@@) $ 4010 - (@)(@@) أبو يسار القرشي عن أبي هاشم يروي عنه الأوزاعي قال الرازي مجهول(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 4011 - (@)(@@) أبو يعقوب أحد الغرباء قدم بغداد فحدث بها عن هشام بن عروة قال يحيى كذاب(@)(@@)(@@)(@@) $ 4012 - (@)(@@) أبو يونس روى عنه حماد بن سلمة قال الرازي مجهول(@)(@@) PageV00P000(@)(@@)(@@)(@@) | ذكر من لا يعرف اسمه ولا كنيته(@)(@@)(@@)(@@) $ 4013 - (@)(@@) ابن أعبد عن علي رضي الله عنه قال علي بن المديني ليس بمعروف(@)(@@)(@@)(@@) $ 4014 - (@)(@@) ابن حاضر(@)(@@)(@@)(@@) $ 4015 - (@)(@@) وابن أبي سعيد قال أبو حاتم الرازي مجهولان(@)(@@)(@@)(@@) $ 4016 - (@)(@@) وابن العذراء روى عن ابن جريح قال الرازي هو الذي روى (من لبس نعلا صفراء) ليس بشيء هو كذب مموضوع(@)(@@)(@@)(@@) $ 4017 - (@)(@@) ابن عياش الحميري قال أبو حاتم الرازي مجهول(@)(@@)(@@)(@@) $ 4018 - (@)(@@) ابن نمران عن شراحيل بن عمرو قال أبو زرعة ذاهب الحديث PageV00P000 
