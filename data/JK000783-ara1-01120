ms1101	 به | بأس في الحديث يجمع حديثه وبقية الإسناد ثقات مشهورون . |(@)(@@) 4106 - حدثنا عمر قال : نا سليمان بن عبد الرحمن قال : نا | سليمان بن عتبة قال : سمعت يونس بن ميسرة بن حلبس يحدث عن | أبي إدريس عن أبي الدرداء - رضي الله عنه - عن رسول الله - [ & ] - | قال : ' لا يدخل الجنة عاق ولا مدمن خمر ولا مكذب | بقدر ' . |(@)(@@) 4107 - وبإسناده عن رسول الله - [ & ] - قال : ' لا | يبلغ عبد حقيقة الإيمان حتى يعلم أن ما أصابه لم يكن ليخطئه وما | أخطأه لم يكن ليصيبه ' . | PageV10P045 |(@)(@@) 4108 - وبإسناده قال : قيل يا رسول الله أرأيت ما نعمل أشيء قد | فرع منه أم أشيء نستأنفه ، فقال : ' كل امرئ مهيأ لما خلق له ' .(@)(@@) وهذه الثلاثة الأحاديث التي بإسناد واحد أسانيدها حسان وهي | تروى عن غير أبي الدرداء فاقتصرنا على رواية أبي الدرداء فيها عن | رسول الله - [ & ] - إلا أن يزيد غير أبي الدرداء في متن | من متونها شيئا فيكتب الحديث للزيادة التي زادها وإلا كان ذلك كافيا . |(@)(@@) 4109 - حدثنا محمد بن المثنى بن عبيد قال : نا أبو معاوية عن | الأعمش ، عن عمرو بن مرة ، عن سالم بن أبي الجعد عن أم الدرداء عن | أبي الدرداء - رضي الله عنه - قال : قال رسول الله - [ & ] - : | ' ألا أدلك على خير من كثير من الصلاة والصدقة ' قالوا : بلى | قال : ' إصلاح ذات البين ' . | PageV10P046(@)(@@) وهذا الحديث لا نعلمه يروى عن رسول الله - [ & ] - | بإسناد متصل أحسن من هذا الإسناد لهذا الكلام وإسناده صحيح | وكلامه عن رسول الله - [ & ] - غريب . |(@)(@@) 4110 - حدثنا نصر بن علي قال : نا نصر بن نجيح قال : نا أبو | عمر حفص عن زياد النميري عن أنس بن مالك عن أبي الدرداء | - رضي الله عنهما - عن النبي - [ & ] - قال : ' من وافق من | أخيه شهوة غفر له ' . | PageV10P047(@)(@@) وهذا الحديث لا نعلم يروى كلامه عن رسول الله - [ & ] - | إلا من هذا الوجه ، بهذا الإسناد ونصر بن نجيح بصري وحفص | ابن عمر بصري ، لم يكن بالقوي في الحديث وإنما كتبنا هذا الحديث على | ما فيه من علة لأنه لا يحفظ عن رسول الله 
ms1102	 فلذلك كتبناه . |(@)(@@) 4111 - حدثنا محمد بن عامر قال : نا الربيع بن نافع قال : نا | يحيى بن حمزة عن ثور بن يزيد عن بسر بن عبيد الله عن أبي إدريس | الخولاني عن أبي الدرداء - رضي الله عنه - قال : قال رسول الله - [ & ] - : | ' بينا أنا نائم رأيت عمود الكتاب احتمل من تحت | رأسي فظننت أنه مذهوب به فأتبعته بصري فعمد به إلى الشام ألا وإن | الإيمان حين تقع الفتن بالشام ' . | PageV10P048(@)(@@) وهذا الحديث لا نعلمه يروى عن رسول الله - [ & ] - | إلا من أحاديث أهل الشام رواه عبد الله بن بسر وأبو الدرداء | ووحشي بن حرب ، ولا نعلم له إسنادا أحسن من هذا الإسناد عن أبي | الدرداء وقد روى عن أبي الدرداء من غير هذا الوجه وهذا أحسن إسنادا | يروى أيضا عن أبي الدرداء . |(@)(@@) 4112 - حدثنا محمد بن عامر قال : نا الربيع بن نافع : قال : نا | محمد بن مهاجر ، عن يزيد بن أبي مالك عن أبي عبيد الله عن أبي الدرداء | - رضي الله عنه - قال : قال رسول الله - [ & ] - : ' لا ألفين ما | نوزعت أحدا منكم على الحوض يقال إنك لا تدري ما أحدث بعدك ' . | قال أبو الدرداء : ادع الله ألا يجعلني منهم قال : ' لست منهم ' [ وليس | PageV10P049 | هذا في حديث أحد ] .(@)(@@) وهذا الحديث قد روى نحو كلامه [ 206 ] عن رسول الله - [ & ] - | من وجوه كثيرة ، وزاد أبو الدرداء في حديثه ادع الله ألا | يجعلني منهم وليس هذا في حديث أحد ممن نعلمه روى نحو هذا الكلام | عن رسول الله - [ & ] - فلذلك كتبناه ومحمد بن مهاجر | ثقة ويزيد بن أبي مالك ثقة وأبو عبيد الله مشهور من أهل الشام . |(@)(@@) 4113 - حدثنا محمد بن عامر قال : نا الربيع قال : حدثني محمد | ابن مهاجر عن يونس بن حلبس عن أبي إدريس عائذ الله عن أبي الدرداء | - رضي الله عنه - قال : مر النبي - [ & ] - بدمنة قوم فيها | سخلة ميتة قال : ' ما لأهلها فيها حاجة ' قالوا يا نبي الله لو كان لأهلها | فيها حاجة ما نبذوها قال : ' فوالله للدنيا أهون على الله من هذه السخلة | على 
ms1103	 أهلها فلا ألفينها أهلكت أحدا منكم ' .(@)(@@) وهذا الحديث قد روي نحو كلامه عن رسول الله - [ & ] - | من وجوه وأعلى من يروي ذلك عنه أبو الدرداء بهذا الإسناد | PageV10P050 | وإسناده صحيح من حديث أهل الشام وفي حديث أبي الدرداء زيادة على | سائر الأحاديث : ' فلا ألفينها أهلكت أحدا منكم ' . |(@)(@@) 4114 - حدثنا محمد قال : نا إسحاق بن إبراهيم عن هشام بن | سعد عن عثمان بن حيان عن أم الدرداء عن أبي الدرداء - رضي الله عنه - | قال : كنا نكون مع رسول الله - [ & ] - في السفر في الحر | الشديد وما في القوم صائم إلا رسول الله - [ & ] - | وعبد الله بن رواحة .(@)(@@) وهذا الحديث لا نعلمه أحدا رواه بهذا اللفظ إلا أبو الدرداء | وحده وإسناده حسن هشام بن سعد ثقة وعثمان بن حيان ثقة ومن | بعدهما فثقات . |(@)(@@) 4115 - حدثنا إبراهيم بن هاني قال : نا أبو المغيرة قال : نا سعيد | ابن عبد العزيز قال : نا إسماعيل بن عبيد الله عن أم الدرداء عن أبي | PageV10P051 | الدرداء - رضي الله عنه - قال : كنا مع النبي - [ & ] - في | سفر وإن أحدنا ليضع يده على رأسه من شدة الحر فما منا صائم إلا | رسول الله - [ & ] - وعبد الله بن رواحة .(@)(@@) وهذا الحديث قد روي عن أبي الدرداء من غير هذا الوجه وزاد فيه | إسماعيل بن عبيد الله حرفا ذكرناه من أجل الزيادة وحسن إسناده . |(@)(@@) 4116 - حدثنا إبراهيم قال : نا سعيد بن سليمان قال : نا حماد بن | أسامة عن يزيد بن سنان أبي فروة قال : نا أبو عبيد الله قال : | سمعت شيخا في المسجد الحرام يقول : قال أبو الدرداء قال رسول الله | - [ & ] - : ' إن لكل شيء أنفة وإن أنفة الصلاة التكبيرة | الأولى فحافظوا عليها ' . | PageV10P052(@)(@@) قال أبو عبيد الله فحدثت به رجاء بن حيوة فحدثني قال : حدثتني | أم الدرداء عن أبي الدرداء عن النبي - [ & ] - .(@)(@@) وهذا الحديث لا نعلمه يروى بهذا اللفظ عن رسول الله - [ & ] - | إلا بهذا الإسناد عن أبي الدرداء عنه ، وقد روي نحو كلامه | عن رسول الله - [ & ] - بغير لفظه نذكره إن شاء الله في | موضعه . يزيد بن سنان الرهاوي قد 
ms1104	 حدث عنه الناس وأبو عبيد الله فليس | بمعروف وما بعده من الإسناد فصحيح . |(@)(@@) 4117 - حدثنا إبراهيم قال : نا بشر قال : نا بشر بن عمارة عن | الأحوص بن حكيم عن خالد بن معدان عن أبي الدرداء ، وأبي أمامة | رضي الله عنهما قالا قال رسول الله - [ & ] - : ' ذكاة | الجنين ذكاة أمه ' . | PageV10P053(@)(@@) وهذا الحديث قد ورد عن النبي - [ & ] - من وجوه | رواه أبو سعيد الخدري وأبو أيوب وأعلى من رواه أبو الدرداء فذكرنا | حديث أبي الدرداء وأبي أمامة إذ كان مضموما إلى أبي الدرداء ولا نعيده | عن غيرهما إلا أن يكون فيه زيادة . |(@)(@@) 4118 - حدثنا محمد بن مسكين قال : نا أسد بن موسى قال : نا | أبو معاوية عن موسى الصغير عن هلال بن يساف عن أم الدرداء | PageV10P054 | عن أبي الدرداء - رضي الله عنه - قال : قال رسول الله - [ & ] - : | ' إن بين أيديكم عقبة كئودا لا ينجو فيها إلا كل مخف ' .(@)(@@) وهذا الحديث لا نعلمه يروى عن رسول الله - [ & ] - | من وجه من الوجوه إلا من هذا الوجه ، ولا نعلم حدث به إلا | أبو معاوية عن موسى الصغير وموسى رجل من أهل الكوفة ثقة حدث | عنه الناس وهلال بن يساف مشهور وما بقى من الإسناد فصحيح . |(@)(@@) 4119 - حدثنا محمد بن مسكين والحسن بن عبد العزيز الجروي | قالا : نا أسد بن موسى قال : نا أبو معاوية عن موسى الصغير عن | PageV10P055 | هلال بن يساف عن أم الدرداء عن أبي الدرداء - رضي الله عنه - قال : | قال رسول الله - [ & ] - [ 207 ] : ' قل هو الله أحد تعدل | ثلث القرآن ' .(@)(@@) وهذا الحديث قد روي عن النبي - [ & ] - من وجوه | بهذا الكلام ، ولا نعلمه يروى عن أبي الدرداء بإسناد متصل أحس من | هذا وإسناده صحيح ، ولا نعلم روى هلال بن يساف عن أم الدرداء إلا | هذين الحديثين ، ولا نعلم روى هذا الحديث عن أبي معاوية إلا أسد بن | موسى وهو ثقة من أهل مصر كان يقال له أسد السنة . |(@)(@@) 4120 - حدثنا عبدة بن عبد الله قال : نا زيد بن الحباب قال : نا | معاوية بن صالح عن أبي الزاهرية 
ms1105	 عن كثير بن مرة عن أبي الدرداء | - رضي الله عنه - أن رجلا سأل النبي - [ & ] - في كل صلاة | قراءة قال : ' نعم ' . | PageV10P056(@)(@@) وهذا الحديث لا نعلمه يروى عن رسول الله - [ & ] - | بإسناد بمثل هذا اللفظ إلا عن أبي الدرداء وإسناده حسن معاوية | ابن صالح ثقة وأبو الزاهرية مشهور حدث عنه الناس وكثير بن مرة | مشهور أيضا حدث عنه الناس . |(@)(@@) 4121 - حدثنا بشر بن آدم قال : نا أبو عاصم قال : نا سعيد بن | زيد عن سعيد البراد عن عثمان بن حيان قال : كنت عند أم | الدرداء فأخذت برغوثا فألقيته في النار ، فقالت سمعت أبا الدرداء | يقول قال رسول الله - [ & ] - : ' لا يعذب بالنار إلا رب | النار ' . | PageV10P057(@)(@@) قال وسمعت رسول الله - [ & ] - : يقول ' من أبلغ ذا | سلطان حاجة من لا يستطيع إبلاغه ثبت الله قدميه على الصراط يوم | تزل فيه الأقدام ' .(@)(@@) وهذا الحديث قد روي بعض كلامه عن رسول الله - [ & ] - | بغير هذا اللفظ وهو : ' لا يعذب بالنار إلا رب النار ' .(@)(@@) روى نحو هذا الكلام عن رسول الله - [ & ] - من | وجوه وزاد أبو الدرداء ' من أبلغ ذا سلطان ' فهذا الأخير عن أبي | الدرداء لا نحفظه عن رسول الله - [ & ] - من وجه متصل ، | إلا من هذا الوجه ، فلذلك كتبناه وسعيد البراد روى عنه حماد بن زيد | وسعيد بن زيد أخوه وهو بصري . |(@)(@@) 4122 - حدثنا الحسن بن يحيى قال : نا موسى بن إسماعيل وحدثنا | محمد بن معمر قال : حدثنا أبو هشام المغيرة بن سلمة قال : نا عبد الواحد | ابن زياد قال : نا الحسن بن عبيد الله قال : نا زيد بن وهب قال : | PageV10P058 | سمعت أبا الدرداء رضي الله عنه يقول قال رسول الله - [ & ] - : | ' من مات لا يشرك بالله دخل الجنة ' قلت : وإن زنى وإن | سرق ؟ قال : ' وإن زنى ، وإن سرق ، وإن رغم أنف أبي الدرداء ' .(@)(@@) وهذا الحديث قد روى عن أبي ذر وأبي الدرداء من غير وجه | وأحسن إسنادا يروى في ذلك عن أبي الدرداء هذا الإسناد فإن الحسن بن | عبيد الله مشهور من أهل الكوفة وزيد بن وهب مشهور ثقة فذكرنا هذا 
ms1106	 | الإسناد لشهرته ولا نعيده عن أبي الدرداء ولا عن أبي ذر إلا أن يزيدا في | ذلك بغير هذا الإسناد كلاما يجب أن يكتب من أجل الزيادة وإلا اقتصرنا | على هذا الحديث بهذا اللفظ دون غيره . | PageV10P059 |(@)(@@) 4123 - حدثنا الحسن بن يحيى قال : نا عبد الله بن رجاء قال : | نا حرب بن شداد عن يحيى بن أبي كثير قال : نا عبد الرحمن بن عمرو | - يعني - الأوزاعي أن وليد بن هشام حدثه أن أباه حدثه قال : حدثني | معدان بن أبي طلحة أن أبا الدرداء أخبره أن رسول الله - [ & ] - | قاء فأفطر قال : فلقيت ثوبان مولى رسول الله - [ & ] - | فقلت له إن أبا الدرداء حدثني أن النبي - [ & ] - قاء | فأفطر قال : صدق وأنا صببت عليه وضوءه .(@)(@@) وهذا الحديث بهذا اللفظ قد روي من وجوه عن أبي الدرداء ولكن | PageV10P060 | اقتصرنا على هذا الإسناد دون غيره ؛ لأن هذا الإسناد فيه أن يحيى بن أبي | كثير رواه عن الأوزاعي فكتبناه من أجل ذلك ولم نعده عن غيره . |(@)(@@) 4124 - حدثنا الحسن بن يحيى وعبد الملك بن محمد الرقاشي قالا | نا مسلم قال : نا شعبة قال : نا يزيد بن خمير عن سليمان بن مرثد | عن ابنة أبي الدرداء عن أبي الدرداء - رضي الله عنه - عن النبي - [ & ] - | قال : ' لو تعلمون ما أعلم لضحكتم قليلا ولبكيتم كثيرا | ولخرجتم إلى الصعدات ، تريدون أن تنجوا فلا تنجوا ' وقال أحدهما : | ' ولا أدري تنجوا أو لا تنجوا ' .(@)(@@) وهذا الحديث لا نعلمه يروى عن أبي الدرداء إلا من هذا الوجه ، | وقد روي عن غير أبي الدرداء ، عن النبي - [ & ] - من | وجوه أصح من هذا وإنما كتبنا هذا الحديث عن أبي الدرداء وإن كان | غيره أصح إسنادا منه ؛ لأن فيه زيادة في [ 208 ] كلامه وهو ' تريدون أن | PageV10P061 | تنجوا ' فلذلك كتبناه ، ولا نعلم هذا الحديث أسنده عن شعبة إلا مسلم | وقد رواه جماعة غير مسلم عن شعبة فأوقفوه عن أبي الدرداء . |(@)(@@) 4125 - حدثنا بشر بن خالد وإبراهيم بن زياد قالا نا محمد بن | مصعب قال : نا أبو بكر بن أبي مريم عن 
ms1107	 خالد بن محمد عن بلال | ابن أبي الدرداء عن أبيه - رضي الله عنه - أن رسول الله - [ & ] - | قال : ' حبك الشيء يعمي ويصم ' .(@)(@@) وهذا الحديث لا نعلمه يروى عن أبي الدرداء ولا عن غير أبي | الدرداء إلا من هذا الوجه ، وأبو بكر بن أبي مريم ثقة وخالد بن محمد | ليس بمعروف ، وبلال بن أبي الدرداء مشهور في النسب وفي الرواية روى | PageV10P062 | عنه غير إنسان ولولا أن الحديث لم نحفظه عن أحد عن رسول الله - [ & ] - | إلا بهذا الإسناد ما كتبناه لمكان خالد بن محمد . |(@)(@@) 4126 - حدثنا إبراهيم بن زياد قال : نا إبراهيم بن أبي العباس قال | نا عبد الحميد بن بهرام ، عن شهر بن حوشب عن عبد الرحمن بن غنم | عن أبي الدرداء رضي الله عنه قال : قال رسول الله - [ & ] - | ' إن الشيطان قد يئس أن يعبد في جزيرة العرب ولكن قد | رضى منكم بمحقرات ' .(@)(@@) وهذا الحديث قد روي عن النبي - [ & ] - من غير | وجه . |(@)(@@) 4127 - حدثنا إبراهيم قال : نا إسحاق بن عيسى قال : نا يحيى | PageV10P063 | ابن حمزة عن عبد الرحمن بن يزيد بن جابر قال : حدثني زيد بن أرطاة | قال : سمعت جبير بن نفير يحدث عن أبي الدرداء - رضي الله عنه - قال : | قال رسول الله - [ & ] - ' فسطاط المسلمين يوم الملحمة | بالغوطة التي جانب مدينة يقال لها دمشق ' .(@)(@@) وهذا الحديث قد روي نحو كلامه عن النبي - [ & ] - | من غير هذا الوجه فذكرنا حديث أبي الدرداء لحسن إسناده ولم نعده عن | غيره إلا أن يزيد كلاما فيكتب من أجل الزيادة . |(@)(@@) 4128 - حدثنا خالد بن محمد بن خالد قال : نا سعيد بن سليمان | قال : نا حماد عن علي بن زيد عن بلال بن أبي الدرداء عن أبيه | - رضي الله عنه - قال : قال رسول الله - [ & ] - : ' ما أظلت | الخضراء ولا أقلت الغبراء من ذي لهجة أصدق من أبي ذر ' . | PageV10P064(@)(@@) وهذا الحديث قد روي عن أبي الدرداء من غير هذا الحديث فذكرنا | هذا الوجه لعزة إسناده ؛ لأنا لم نحفظ عن علي بن زيد عن بلال بن أبي | الدرداء غير هذا الحديث ، ولا 
ms1108	 نعلم حدث بهذا الحديث عن علي بن زيد | إلا حماد بن سلمة . |(@)(@@) 4129 - حدثنا إبراهيم بن هاني قال : نا محمد بن المبارك الصوري | قال : نا صدقة قال : حدثني زيد بن واقد عن بسر بن عبيد الله عن | أبي إدريس الخولاني عن أبي الدرداء - رضي الله عنه - قال : كنت جالسا | عند رسول الله - [ & ] - إذ أقبل أبو بكر - رضي الله عنه - | آخذا بطرف ثوبه ، قد أبدى عن ركبته فلما رآه رسول الله - [ & ] - | قال : ' أما صاحبكم - أحسبه قال : - فقد خامر ' فأقبل حتى | سلم على رسول الله - [ & ] - ، فقال : يا رسول الله إنه | كان بيني وبين عمر شيء فأسرعت إليه ، ثم إني ندمت على ما كان | PageV10P065 | فسألته أن يغفر لي فأبى فتبعته إلى البقيع حتى تحوز بداره مني فأقبلت | إليك ، فقال رسول الله - [ & ] - ' يغفر الله لك يا أبا بكر ' | ثلاث مرار ، ثم إن عمر ندم حين سأله أبو بكر أن يغفر له فأبى عليه ، ثم | خرج من منزله ، حتى أتى منزل أبي بكر فسأل : هل ثم أبو بكر ؟ قالوا : لا | نعلم أتى رسول الله - [ & ] - فأقبل عمر إلى رسول الله | - [ & ] - حتى سلم عليه فجعل وجه رسول الله - [ & ] - | يتمعر حتى أشفق أبو بكر أن يكون من رسول الله - [ & ] - | إلى عمر ما يكره فلما رأى ذلك أبو بكر جثى على ركبتيه | وقال أنا والله يا رسول الله كنت أظلم ، فقال رسول الله - [ & ] - : | ' يا أيها الناس إن الله بعثني إليكم فقلتم كذبت ، وقال أبو بكر | صدقت فواساني بنفسه وماله فهل أنتم تاركو إلي صاحبي ' ثلاث مرار .(@)(@@) وهذا الحديث لا نعلمه يروى عن رسول الله - [ & ] - | من وجه متصل عنه إلا من هذا الوجه ، عن أبي الدرداء وحده | وصدقة صالح الحديث من أهل دمشق وهو صدقة بن خالد وزيد بن واقد | وبسر بن عبيد الله فقد تقدم ذكرنا لهما . |(@)(@@) 4130 - حدثنا إبراهيم بن هانئ قال : نا محمد بن المبارك الصوري | PageV10P066 | قال : نا عمرو بن [ 209 ] واقد عن إسماعيل بن عبيد الله عن أم الدرداء | عن أبي الدرداء ويونس عن أبي إدريس 
ms1109	 عن معاذ عن النبي - [ & ] - | قال : ' إن أول شيء نهاني عنه ربي بعد عبادة الأوثان | شرب الخمر وملاحاة الرجال ' .(@)(@@) وهذا الحديث لا نعلمه يروى عن رسول الله - [ & ] - | بإسناد متصل إلا بهذا الإسناد ، وعمرو بن واقد ليس بالقوي وقد | احتمل الناس حديثه ورووا عنه ، ومن قبله ومن بعده فثقات . |(@)(@@) 4131 - حدثنا إبراهيم قال : نا محمد بن المبارك عن عمارة بن أبي | الشعثاء قال : حدثني شيبان بن قيس قال : حدثني شبيب بن نعيم | الكلاعي عن يزيد بن النمران ( أن ) أبا الدرداء حدثه أن رسول الله | - [ & ] - قال : ' من أخذ أرضا من أرض الجزية فجعلها | في رقبته فقد ولى الإسلام ظهره ' . | PageV10P067(@)(@@) وهذا الحديث لا نعلمه يروى عن رسول الله - [ & ] - | بهذا اللفظ إلا من هذا الوجه ، بهذا الإسناد وعمارة بن أبي الشعثاء | وشيبان بن قيس وشبيب بن نعيم الكلاعي ويزيد بن نمران ليسوا بمعروفين | بالنقل وإنما كتبنا هذا الحديث على ما فيه من العلة لأنا لم نحفظه عن رسول | الله - [ & ] - إلا من هذا الوجه ، فكتبناه وبينا ما فيه من علة . |(@)(@@) 4132 - حدثنا إبراهيم قال : نا أبو الأسود النضر قال : نا ابن | لهيعة عن يزيد بن أبي حبيب عن سعد بن مسعود التجيبي أخبره | PageV10P068 | أنه سمع عبد الله بن جبير يخبر : أنه سمع أبا الدرداء يخبر أن رسول الله | - [ & ] - قال : ' أنا أول من يؤذن له يوم القيامة برفع رأسه | فأرفع رأسي فأعرف أمتي عن يميني وعن شمالي ' قيل : كيف تعرفهم يا | رسول الله ؟ قال : ' غر محجلون من الوضوء ، وذراريهم نور بين أيديهم ' .(@)(@@) وهذا الحديث لا نعلم يروى بلفظه عن رسول الله - [ & ] - | حديث فلذلك كتبناه وسعد بن مسعود هذا فليس بالمعروف | وعبد الله بن جبير فلا نعرفه بالنقل ولكن لما ذكر في هذا الحديث زيادة | لفظ ليس في حديث غيره كتبناه من أجل ذلك وبينا علته . |(@)(@@) 4133 - حدثنا إبراهيم قال : نا أبو اليمان قال : نا أبو بكر بن أبي | مريم عن ضمرة بن حبيب عن أبي الدرداء - رضي الله عنه - عن النبي | - [ & ] - قال : ' إن الله عز وجل تصدق 
ms1110	 عليكم بثلث | PageV10P069 | أموالكم عند وفاتكم ' .(@)(@@) وهذا الحديث قد روي عن رسول الله - [ & ] - من | غير وجه وأعلى من روى ذلك عن رسول الله - [ & ] - | أبو الدرداء ، ولا نعلم له طريقا عن أبي الدرداء غير هذا الطريق وأبو بكر | ابن أبي مريم وضمرة معروفان بنقل العلم قد احتمل عنهما الحديث . |(@)(@@) 4134 - حدثنا محمد بن يحيى القطيعي قال : نا بشر بن عمر | قال : نا هشام بن سعد عن زيد بن أسلم عن أم الدرداء عن أبي الدرداء | رضي الله عنه قال : قال رسول الله - [ & ] - ' ما ينبغي | للعان أن يكون وجيها عند الله عز وجل ' .(@)(@@) وهذا الحديث لا نعلمه يروى عن رسول الله - [ & ] - | بهذا اللفظ إلا من هذا الوجه ، وإسناده حسن ، ولا نعلم روى | زيد بن أسلم عن أم الدرداء غير هذا الحديث . | PageV10P070 |(@)(@@) 4135 - حدثنا إبراهيم بن هاني قال : نا أبو صالح قال : حدثني | معاوية بن صالح عن ربيعة بن يزيد عن أبي إدريس ، عن أبي الدرداء | - رضي الله عنه - قال قام رسول الله - [ & ] - يصلي | فسمعناه يقول : ' أعوذ بالله منك ' ، ثم قال : ' ألعنك بلعنة الله ' ثلاثا ، | ثم أهوى بيده كأنه يتناول شيئا فلما فرغ من الصلاة قالوا : يا رسول الله | قد سمعناك تقول في الصلاة شيئا لم نسمعك تقوله قبل ذلك ورأيناك | تبسط يدك قال : ' إن عدو الله إبليس جاء بشهاب من نار ليجعله في | وجهي ، فقلت : أعوذ بالله منك فلم يستأخر ، ثم قلت له فلم يستأخر ، | ثم قلت له فلم يستأخر ، ثم قلت له : لعنك الله بلعنة الله التامة فلم | يستأخر ، ثم قلتها فلم يستأخر ، ثم قلتها فلم يستأخر ، ثم أردت أن | آخذه ، فلولا دعوة أخينا سليمان لأصبح مربوطا يلعب به ولدان أهل | المدينة ' . | PageV10P071(@)(@@) وهذا الحديث حسن الإسناد ولا نعلم يروى مثل لفظه عن | رسول الله - [ & ] - حديث وقد روى بنحو معناه وبعض | كلامه عن غير واحد من أصحاب النبي - [ & ] - وفي هذا | زيادة كلام ليس في سائر الأحاديث فكتبناه للزيادة التي فيه ولحسن | إسناده . |(@)(@@) 4136 - حدثنا عبد الله بن أحمد بن شبويه قال : نا أبو 
ms1111	 اليمان قال : | نا صفوان بن عمرو عن أبي إدريس السكوني عن جبير بن نفير عن | أبي الدرداء - رضي الله عنه - قال : أوصاني خليلي بثلاث : بصيام ثلاثة | أيام من كل شهر ، وأن لا أنام إلا على وتر ، وسبحة الضحى في السفر | والحضر .(@)(@@) وهذا الحديث قد روي عن النبي [ 210 ] - [ & ] - | من غير وجه فذكرنا حديث أبي الدرداء لجلالته وحسن إسناده إلا أن | يزيد غيره كلاما فيكتب من أجل الزيادة . | PageV10P072 |(@)(@@) 4137 - حدثنا عبد الله بن أحمد قال : نا صفوان بن صالح قال : | نا العوام بن صبيح قال : نا يونس بن ميسرة عن أم الدرداء عن أبي | الدرداء - رضي الله عنه - قال : قال رسول الله - [ & ] - ^ ( كل | يوم هو في شأن ) ^ قال : ' من شأنه أن يغفر ذنبا أو يكشف كربا أو | يجيب داعيا ويرفع قوما ويضع آخرين ' وقال رسول الله - [ & ] - : | ' فرغ الله إلى كل عبد من أجله ورزقه ومضجعه وأثره ' .(@)(@@) وهذا الحديث قد روي عن أبي الدرداء من غير وجه وهذا من | PageV10P073 | أحسن إسناد يروى عنه وقد ذكرنا عن أبي الدرداء في موضع آخر ^ ( كل | يوم هو في شأن ) ^ وفي هذا زيادة في تفسير وفيه زيادة فرغ الله إلى كل | عبد من خمس وليس هذا في الحديث الذي كتبناه . |(@)(@@) 4138 - حدثنا محمد بن المثنى قال : نا محمد بن جعفر قال : نا | شعبة عن يزيد بن خمير قال : سمعت عبد الرحمن بن جبير بن نفير يحدث | عن أبيه عن أبي الدرداء - رضي الله عنه - عن النبي - [ & ] - : | أنه أمر بامرأة مجح على فسطاط فقال : ' لعله يريد أن يلم بها ' قالوا : | نعم ، فقال رسول الله - [ & ] - : ' لقد هممت أن ألعنه | لعنة تدخل معه قبره كيف يورثه وهو لا يحل له ؟ كيف يستخدمه وهو | لا يحل له ؟ ' . |(@)(@@) 4139 - حدثنا إبراهيم بن عبد الله قال : نا يحيى بن يحيى قال : | نا عبد الله بن المبارك قال : أنا عبد الرحمن بن يزيد بن جابر قال : | حدثني زيد بن أرطاة عن جبير بن نفير عن أبي الدرداء - رضي الله | PageV10P074 | عنه - قال سمعت رسول 
ms1112	 الله - [ & ] - يقول : ' إنما ترزقون | وتنصرون بضعفائكم ابغوني ضعفاءكم ' .(@)(@@) وهذا الحديث إسناده حسن ولا نحفظ بلفظه عن رسول الله - [ & ] - | [ وهذا الحديث قد روي عن رسول الله - [ & ] - | نحو لفظه بغير هذا اللفظ ] فذكرنا كل حديث بلفظه في | موضعه . |(@)(@@) 4140 - حدثنا عبيد الله بن يعيش قال : نا يونس بن بكير قال : | نا سعيد بن ميسرة البكري ، عن أنس عن أبي الدرداء - رضي الله عنه - | قال : كان رسول الله - [ & ] - لا ينخل له الدقيق ولم يكن | PageV10P075 | له إلا قميص واحد .(@)(@@) وهذا الحديث لا نعلمه يروى عن أحد من أصحاب النبي - [ & ] - | بهذا اللفظ إلا عن أبي الدرداء بهذا الإسناد وسعيد بن | ميسرة قد حدث عنه يونس بأحاديث لم يتابع عليها وقد احتملها أهل | العلم على ما فيها . |(@)(@@) 4141 - حدثنا هشام قال : نا محمد بن عيسى بن سميع قال : نا | إبراهيم بن سليمان الأفطس عن الوليد بن عبد الرحمن الجرشي عن | جبير بن نفير عن أبي الدرداء - رضي الله عنه - قال : خرج علينا رسول الله | - [ & ] - ونحن نذكر الفقر ونتخوفه فقال : ' آلفقر تخافون ؟ ! | والذي نفسي بيده لتصبن الدنيا عليكم صبا حتى لا ترفع ، وأيم الله | لأتركنكم على مثل البيضاء ليلها ونهارها سواء ' . فقال أبو الدرداء : | PageV10P076 | صدق الله ورسوله ، تركنا والله على مثل البيضاء ليلها ونهارها سواء .(@)(@@) وهذا الحديث لا نعلمه يروى عن رسول الله - [ & ] - | بهذا اللفظ إلا من هذا الوجه بهذا الإسناد وإسناده حسن . |(@)(@@) 4142 - حدثنا إبراهيم بن حميد قال : نا محمد بن يزيد بن شداد | قال : نا سعيد بن سالم القداح قال : نا سعيد بن بشير عن إسماعيل بن | عبيد الله عن أم الدرداء عن أبي الدرداء - رضي الله عنه - قال : قال | رسول الله - [ & ] - : ' فضل الصلاة في المسجد الحرام على | غيره مائة ألف صلاة ، وفي مسجدي ألف صلاة ، وفي مسجد بيت | المقدس خمسمائة صلاة ' . | PageV10P077(@)(@@) وهذا الحديث لا نعلمه يروى عن رسول الله - [ & ] - | من وجه من الوجوه بهذا اللفظ إلا من هذا الوجه بهذا الإسناد وإسناده | حسن . |(@)(@@) 4143 - حدثنا إبراهيم قال : نا الهيثم بن خارجة قال : نا سليمان 
ms1113	 | ابن عتبة عن يونس بن ميسرة عن أبي إدريس الخولاني عن أبي | الدرداء - رضي الله عنه - عن النبي - [ & ] - قال : ' خلق الله | تبارك وتعالى آدم حين خلقه فضرب كتفه اليمنى فأخرج ذرية بيضاء | كأنهم الذر وضرب كتفه اليسرى فأخرج ذرية سوداء كأنهم الحمم | فقال للذي في يمينه إلى الجنة ولا أبالي وقال للذي في يساره إلى النار | ولا أبالي ' . | PageV10P078(@)(@@) وهذا الحديث لا نعلمه يروى عن رسول الله - [ & ] - | بهذا اللفظ إلا من هذا الوجه بهذا الإسناد وإسناده حسن . |(@)(@@) 4144 - حدثنا عمر بن الخطاب السجستاني قال : نا هشام قال : | نا سليمان بن عتبة قال : نا يونس بن ميسرة عن أبي إدريس عن أبي | الدرداء - رضي الله عنه - ، عن النبي - [ & ] - قال : ' إنكم | ستجندون أجنادا جندا بالشام ومصر والعراق واليمن ' قالوا : فخر لنا | يا رسول الله . قال : ' عليكم بالشام ' قالوا : إنا أصحاب ماشية ولا نطيق | الشام قال : ' فمن لم يطق الشام فليلحق بيمنه فإن الله قد تكفل لي | بالشام ' .(@)(@@) وهذا الحديث لا نعلمه يروى عن رسول الله - [ & ] - | أحسن من حديث أبي الدرداء هذا ، وقد روي عن غير أبي | الدرداء نحو من هذا الكلام وذكرنا حديث أبي الدرداء لجلالته وحسن | إسناده . | PageV10P079 |(@)(@@) 4145 - حدثنا نصر بن علي قال : نا عبد الله بن داود . |(@)(@@) 4145 م - وحدثناه إبراهيم التيمي قال : نا أبو داود قال : نا عاصم | ابن رجاء بن حيوة عن داود بن جميل ، عن كثير بن قيس عن أبي | الدرداء - رضي الله عنه - قال : قال رسول الله - [ & ] - : | ' العلماء خلفاء الأنبياء إن الأنبياء لم يورثوا دينارا ولا درهما إنما ورثوا | العلم ' .(@)(@@) وهذا الحديث لا نعلمه يروى عن رسول الله - [ & ] - | بهذا اللفظ إلا من هذا الوجه وإسناده صالح داود بن جميل وكثير | بن قيس لا نعلمهما معروفين في غير هذا الحديث . |(@)(@@) 4146 - حدثنا عبد الله بن سعيد الكندي قال : نا إسحاق بن | سليمان قال : نا معاوية بن يحيى عن يونس بن ميسرة عن أبي إدريس | عن أبي الدرداء - رضي الله عنه - قال : قال رسول الله - [ & ] - : | ' الطهارات أربع قص الشارب 
ms1114	 وحلق العانة وتقليم الأظفار | PageV10P080 | والسواك ' .(@)(@@) وهذا الحديث لا نعلمه يروى عن رسول الله - [ & ] - | إلا من هذا الوجه ومعاوية بن يحيى قد تقدم ذكرنا له لأنه ليس | بالقوي وقد حدث عنه أهل العلم واحتملوا حديثه . |(@)(@@) 4147 - حدثنا محمد بن المثنى قال : نا محمد بن أبي عدي قال : نا | راشد بن محمد الحماني عن شهر بن حوشب عن أم الدرداء ، عن | أبي الدرداء عن النبي - [ & ] - . |(@)(@@) 4148 - وحدثنا محمد بن العباس الملحمي قال : نا عبد الوهاب بن | عطاء قال : نا راشد الحماني عن شهر بن حوشب عن أم | الدرداء عن أبي الدرداء - رضي الله عنه - قال : أوصاني أبو القاسم - [ & ] - | PageV10P081 | ' ألا أشرك بالله شيئا وإن حرقت ، وألا أترك صلاة | مكتوبة متعمدا ؛ فمن تركها متعمدا فقد كفر ، ولا أشرب الخمر فإنها | مفتاح كل شر ' .(@)(@@) وهذا الحديث لا نعلمه يروى عن رسول الله - [ & ] - | بهذا اللفظ إلا من هذا الوجه بهذا الإسناد وراشد أبو محمد | بصري ليس به بأس قد حدث عنه غير واحد وشهر بن حوشب قد روى | عنه الناس وتكلموا فيه واحتملوا حديثه . |(@)(@@) 4149 - حدثنا محمد بن المثنى قال : نا يحيى بن أبي بكير قال : نا | إسرائيل عن زياد المصغر عن الحسن عن المقدام قال جلس عبادة | PageV10P082 | وأبو الدرداء إلى الحارث بن معاوية فقال أبو الدرداء أيكم يذكر حين | صلى بنا رسول الله - [ & ] - إلى بعير من المغنم فلما | انصرف أخذ وبرة من البعير فقال : ' ما يحل لي مما أفاء الله عليكم ولا | مثل هذه إلا الخمس والخمس مردود فيكم ' .(@)(@@) وهذا الحديث قد روى عن النبي - [ & ] - بنحو | كلامه من غير وجه بغير هذا اللفظ ولكن بشبيه معناه نذكر كل حديث | بلفظه في موضعه إن شاء الله والمقدام الرهاوي لا نعلم حدث عنه إلا | الحسن هذا الحديث وزياد المصغر لا نعلم روي عنه إلا إسرائيل . |(@)(@@) 4150 - حدثنا عمر بن الخطاب قال : نا عبد الله بن صالح قال : | حدثني معاوية بن صالح عن ضمرة بن حبيب ، عن أبي الدرداء - رضي | الله عنه - قال : قال رسول الله - [ & ] - : ' إن الله 
ms1115	 يحب كل | قلب حزين ' . | PageV10P083(@)(@@) وهذا الحديث لا نعلمه يروى عن رسول الله - [ & ] - | إلا من هذا الوجه بهذا الإسناد . |(@)(@@) 4151 - حدثنا سلمة بن شبيب والفضل بن أبي طالب قالا : نا | يزيد بن هارون قال أنا شريك عن عبد العزيز بن رفيع عن أبي عمر | الصيني عن أم الدرداء قالت : نزل بأبي الدرداء ضيف فقال أمقيم | فنسرح أم ظاعن فنعلف ؟ ، ثم قال أبو الدرداء : إن رسول الله - [ & ] - | أتاه ناس من الفقراء فقالوا يا رسول الله ذهب أصحاب | الأموال بالدنيا والآخرة يصلون كما نصلي ويصومون كما نصوم | ويجاهدون ويتصدقون ولا نتصدق ، فقال : ' يا أبا الدرداء ، ألا أدلك على | PageV10P084 | أمر إذا فعلتموه أدركتم من سبقكم ولم يدرككم أحد إلا من قال مثل | قولكم . [ 212 ] تسبح في كل صلاة ثلاثا وثلاثين . وتحمد ثلاث | وثلاثين . وتكبر أربع وثلاثين ' .(@)(@@) وهذا الحديث قد روي نحو كلامه عن رسول الله - [ & ] - | من وجوه ولا نعلم أحدا جوده ووصله إلا يزيد بن هارون عن | شريك . |(@)(@@) 4152 - حدثنا نصر بن علي قال : نا أبو أحمد قال : نا إسرائيل | عن عبد الله بن المختار عن محمد بن واسع عن أم الدرداء عن أبي | الدرداء - رضي الله عنه - قال : لتكن المساجد مجلسك فإني سمعت رسول | PageV10P085 | الله - [ & ] - يقول : ' إن الله عز وجل ضمن لمن كانت | المساجد بيته الأمن والجواز على الصراط يوم القيامة ' .(@)(@@) وهذا الحديث روي عن النبي - [ & ] - نحو كلامه | بغير لفظه ولا نعلم هذا اللفظ يروى عن رسول الله - [ & ] - | إلا بهذا الإسناد من هذا الوجه وهو حسن الإسناد . | PageV10P086 |(@)(@@) 4153 - حدثنا حميد بن الربيع قال : نا حسين بن علي قال : | نا زائدة عن سليمان ، عن عبدة بن أبي لبابة عن سويد بن غفلة عن | أبي الدرداء ، - رضي الله عنه - يبلغ به النبي - [ & ] - قال : | ' من أتى فراشه وهو ينوي أن يقوم يصلي من الليل فغلبته عينه حتى | يصبح كتب له ما نوى وكان نومه صدقة ' . | PageV10P087(@)(@@) وهذا الحديث لا نعلمه يروى عن رسول الله - [ & ] - | من وجه من الوجوه إلا من هذا الوجه بهذا الإسناد وهو حسن | الإسناد 
ms1116	 من غريب حديث الأعمش متصل الإسناد . | PageV10P088 |(@)(@@) | مسند | ثوبان | رضي الله عنه(@)(@@) | PageV10P089 | صفحة فارغة . | PageV10P090 |(@)(@@) | حديث ثوبان(@)(@@) 4154 - حدثنا بشر بن معاذ أبو سهل العقدي قال : نا يزيد بن | زريع قال : نا سعيد عن قتادة عن سالم بن أبي الجعد عن معدان عن | ثوبان - رضي الله عنه - أن نبي الله - [ & ] - قال : ' من | ترك بعده كنزا مثل يوم القيامة شجاع أقرع له زبيبتان يتبعه يقول | ويلك ما أنت فيقول : أنا كنزك الذي كنزت يقول فلا يزال حتى يلتقم | يده ، ثم يتبع سائر جسده أو في سائر جسده ' .(@)(@@) وهذا الحديث قد روي نحو كلامه عن النبي - [ & ] - | بغير هذا اللفظ ولا نعلم لثوبان طريقا غير هذا الطريق وإسناده | حسن . |(@)(@@) 4155 - حدثنا بشر بن معاذ قال : نا يزيد بن زريع قال : نا | سعيد عن قتادة عن سالم بن أبي الجعد عن معدان عن ثوبان - رضي | PageV10P091 | الله عنه - قال : قال رسول الله - [ & ] - : ' من سأل مسألة | وهو عنها غني كانت شينا في وجهه يوم القيامة ' .(@)(@@) وهذا الحديث لا نعلمه يروى عن رسول الله - [ & ] - | بهذا اللفظ من وجه يثبت عنه غير هذا الوجه ولا نعلم له طريقا | عن ثوبان غير هذا الطريق . |(@)(@@) 4156 - وحدثنا عمرو بن علي قال : نا أبو داود قال : نا بكير بن | أبي السميط عن قتادة عن سالم بن أبي الجعد عن معدان عن ثوبان | - رضي الله عنه - قال : قال رسول الله - [ & ] - : ' أفطر | الحاجم والمحجوم ' . |(@)(@@) 4157 - وحدثنا الجراح بن مخلد قال : نا زفر بن هبيرة قال : نا | PageV10P092 | عبد الرحمن بن ثابت بن ثوبان عن أبيه عن مكحول عن أبي أسماء | عن ثوبان عن النبي - [ & ] - . | PageV10P093(@)(@@) وقد روي هذا الحديث يحيى بن أبي كثير عن أبي قلابة عن أبي | أسماء عن ثوبان هكذا قال يحيى بن أبي كثير ، رواه الحفاظ عن يحيى | ورواه خالد الحذاء عن أبي قلابة عن أبي الأشعث الصنعاني عن شداد بن | أوس وخالد حافظ ، ورواه أيوب عن أبي قلابة عمن حدثه عن شداد | ورواه عاصم الأحول وأبو غفار عن أبي قلابة عن أبي الأشعث 
ms1117	 عن أبي | أسماء عن شداد وحديث خالد عندي أحسنها ولا نعلم حدث بحديث | عبد الرحمن بن ثابت عن أبيه عن مكحول عن أبي أسماء عن ثوبان غير | زفر بن هبيرة . |(@)(@@) 4158 - وحدثناه محمد بن معمر قال : نا روح بن عبادة قال : نا | سعيد عن قتادة عن شهر بن حوشب عن عبد الرحمن بن غنم عن | ثوبان عن النبي - [ & ] - بمثله . | PageV10P094(@)(@@) وهذه الأسانيد عن ثوبان في ' أفطر الحاجم والمحجوم ' أسانيدها | حسان أما قتادة عن شهر فلا نعلم رواه عن قتادة إلا سعيد بن أبي عروبة | وأما قتادة عن سالم فلا نعلم رواه عن قتادة إلا بكير بن أبي السميط وهو | شيخ من أهل البصرة ، ليس به بأس إلا أن هذا الحديث ليس بمحفوظ عن | قتادة عن سالم ، وأحسب أن بكيرا أخطأ فيه إذ قال : عن سالم ، وقد رواه | عن الليث بن سعد عن قتادة ، عن الحسن عن ثوبان فأوهم فيه لأن الثقات | يروونه عن الحسن عن أبي هريرة ، وأخطأ الليث فيه ، ورواه أيوب بن | أبي سكين الواسطي ، عن قتادة عن شهر بن حوشب عن بلال وأخطأ فيه | ويقال ابن مسكين وكنية [ 213 ] أيوب أبو العلاء ، والحديث عندي أشبه | بحديث ابن أبي عروبة لأنه أحفظ من غيره . |(@)(@@) 4159 - حدثنا محمد بن بشار قال : نا يحيى بن سعيد قال : نا شعبة | عن قتادة عن سالم عن معدان عن ثوبان - رضي الله عنه - أن النبي | - [ & ] - قال : ' من فارق الروح جسده وهو بريء من | ثلاث : من الكبر والدين والغلول ؛ وجبت له الجنة أو قال له الجنة ' . | PageV10P095 |(@)(@@) 4159 م - قال : وقال رسول الله - [ & ] - : ' من | صلى على جنازة فله قيراط ومن انتظرها حتى تدفن فله قيراطان | أصغرهما مثل أحد ' .(@)(@@) وهذا الحديث لا نعلمه يروى عن رسول الله - [ & ] - | بهذا اللفظ إلا من هذا الوجه بهذا الإسناد وإسناده حسن عن | ثوبان . |(@)(@@) 4160 - حدثنا أبو كامل قال : نا عبد الواحد بن زياد عن | ليث عن أبي زرعة عن أبي إدريس عن ثوبان - رضي الله عنه - أن | رسول الله - [ & ] - لعن الراشي والمرتشي 
ms1118	 والرائش . | PageV10P096(@)(@@) وهذا الحديث - قوله والرائش - لا نعلمه يروى عن رسول الله | - [ & ] - من وجه من الوجوه إلا من هذا الوجه فلذلك | كتبناه وبينا أن هذا الحديث إنما هو عن ليث بن أبي سليم عن أبي زرعة | عن أبي إديس وقد أدخل ذاود بن علبة عن ليث بين أبي زرعة وبينه | رجلا فذكره عن أبي الخطاب وأبو الخطاب فليس بالمعروف إلا أنه قد | روى عنه ليث غير حديث وإنما يكتب حديثه إذا لم يحفظ ما يروى إلا عنه . |(@)(@@) 4161 - حدثنا أبو كريب قال : نا مزاحم بن ذاود بن علبة عن | أبيه عن ليث عن صاحب له يقال له : أبو الخطاب عن أبي زرعة | عن أبي إدريس عن ثوبان - رضي الله عنه - أنه سمع النبي - [ & ] - | PageV10P097 | يقول : ' إن المختلعات هن المنافقات ' .(@)(@@) وهذا الحديث قد روي عن أبي هريرة رواه الحسن عنه ولم يسمع | الحسن من أبي هريرة ورواه ثوبان من هذا الطريق وقد بينا علة ليث وأبي | الخطاب واقتصرنا على حديث ثوبان في هذا دون غيره . |(@)(@@) 4162 - حدثنا أبو كريب قال : نا رشدين بن سعد عن | PageV10P098 | عبد الرحمن بن زياد بن أنعم ، عن هبيرة بن عبد الرحمن عن أبي أسماء | عن ثوبان مولى رسول الله - [ & ] - أحسبه رفعه قال : | ' الكذب مكتوب إلا ما نفع به مسلم أو دفع به عنه ' .(@)(@@) وهذا الحديث لا نعلمه يروى عن رسول الله - [ & ] - | بهذا اللفظ إلا من هذا الوجه بهذا الإسناد ، ورشدين بن سعد لم | يكن حافظا ، وقد روى عنه ابن المبارك فمن دونه واحتملوا حديثه | وعبد الرحمن بن زياد لم يكن أيضا حديثه يدل على أنه حافظ لأن في | حديثه مناكير وكان أحد العقلاء وروى عنه الناس ولا يكون رشدين ولا | عبد الرحمن بن زياد حجة في حديث إذا انفردا به ولا واحد منهما إذا | انفرد بحديث . |(@)(@@) 4163 - حدثنا أحمد بن منصور قال : نا عبد الرزاق قال أنا الثوري | عن خالد الحذاء عن أبي قلابة عن أبي أسماء عن ثوبان - رضي الله | PageV10P099 | عنه - قال : قال رسول الله - [ & ] - : ' يقتتل عند 
ms1119	 كنزكم | هذا ثلاثة كلهم ابن خليفة ، ثم لا يصل إلى واحد منهم ، ثم تقبل | الرايات السود من قبل المشرق فيقتلونكم قتلا لم يقتله قوم ، ثم ذكر شيئا | فإذا رأيتموه فبايعوه ولو حبوا على الثلج فإنه خليفة الله المهدي ' .(@)(@@) وهذا الحديث قد روي نحو كلامه من غير هذا الوجه بهذا اللفظ | وهذا اللفظ لا نعلمه إلا في هذا الحديث وإن كان قد روي أكثر معنى هذا | الحديث فإنا اخترنا هذا الحديث لصحته وجلالة ثوبان وإسناده إسناد صحيح . |(@)(@@) 4164 - وحدثنا إبراهيم بن سعيد الجوهري قال : نا الربيع عن | نافع قال : نا يزيد بن ربيعة عن أبي الأشعث الصنعاني عن أبي | PageV10P100 | عثمان عن ثوبان - رضي الله عنه - قال : قال رسول الله - [ & ] - : | ' لن تنقطع الهجرة ما جوهد الكفار ' .(@)(@@) وهذا الحديث قد روي عن غير واحد بنحو كلامه وذكرنا حديث | ثوبان دون غيره إلا أن يزيد أحد بمعناه كلاما فيكتب لعلة الزيادة فيه . |(@)(@@) 4165 - وحدثنا إبراهيم بإسناده عن رسول الله - [ & ] - | قال : ' من أحدث حدثا أو آوى محدثا أو ادعى إلى غير أبيه أو | تولى غير مواليه فعليه لعنة الله والملائكة والناس أجمعين لا يقبل منه | صرف ولا عدل ' ، وقال رسول الله - [ & ] - : ' كيف أنتم | في قوم مرجت عهودهم وأماناتهم وصاروا حثالة ' وشبك بين أصابعه | قالوا : فكيف نصنع يا رسول الله ؟ قال : ' اصبروا خالقوا الناس بأخلاقهم | وخالفوهم في أعمالهم ' . | PageV10P101(@)(@@) وهذا الحديث قد روي نحو كلامه عن رسول الله - [ & ] - | من وجوه بعض كلامه لا نحفظه عن رسول الله - [ & ] - | إلا من هذا الوجه [ 214 ] بهذا الإسناد فكتبنا الحديث بطوله لما | فيه من الزيادة وما وجدنا من الحديث عند من هو أوثق من ( . . . . . ) | هذا الحديث ذكرناه عمن هو أوثق وأقررنا ما لم نحفظه إلا بهذا الإسناد | في موضعه . |(@)(@@) 4166 - حدثنا القاسم بن هاشم بن سعيد قال : نا عتبة بن | السكن الحمصي ، قال : نا الأوزاعي قال أخبرني صالح بن جبير قال : | حدثني أبو أسماء الرحبي قال : حدثني ثوبان - رضي الله عنه - أن رسول | الله - [ & ] - كان يستحب أن يصلي بعد نصف النهار 
ms1120	 | حتى ترتفع الشمس فقالت عائشة يا رسول الله أراك تستحب الصلاة | هذه الساعة قال : ' تفتح فيها أبواب السماء وينظر الله تبارك وتعالى | بالرحمة إلى خلقه وهي صلاة كان يحافظ عليها آدم ونوح وإبراهيم | PageV10P102 | وموسى وعيسى ' .(@)(@@) وهذا الحديث لا نعلمه يروى عن رسول الله - [ & ] - | بهذا اللفظ إلا عن ثوبان بهذا الإسناد ، وعتبة بن السكن قد روى عن | الأوزاعي أحاديث لم يتابع عليها وصالح بن جبير فلا نعلم روى عنه غير | الأوزاعي . |(@)(@@) 4167 - حدثنا إبراهيم بن سعيد وزهير بن محمد قالا : نا الربيع بن | نافع قال : نا محمد بن مهاجر عن العباس بن سالم عن أبي سلام | عن ثوبان - رضي الله عنه - قال : قال رسول الله - [ & ] - : | ' حوضي من عدن إلى عمان البلقاء ، ماؤه أحلى من العسل ، وأطيب من | المسك وأبيض من اللبن آنيته أكثر من عدد نجوم السماء من شرب منه | شربة لم يظمأ بعدها أبدا ' قيل : يا رسول الله من أول الناس ورودا عليك | أو عليه فقال : ' المهاجرون الشعث رؤسا الدنس ثيابا الذين لا ينكحون | PageV10P103 | المتمنعمات ولا تفتح لهم السدد ' .(@)(@@) وهذا الحديث لا نعلمه يروى عن رسول الله - [ & ] - | بوجه من الوجوه متصلا بهذا اللفظ إلا من هذا الوجه عن ثوبان وإسناده | حسن محمد بن مهاجر ثقة والعباس بن سالم ليس به بأس وأبو سلام مشهور . |(@)(@@) 4168 - وحدثنا إبراهيم بن سعيد قال : نا الربيع بن نافع قال : نا | معاوية بن سلام عن زيد بن سلام أنه سمع أبا سلام قال : حدثني | PageV10P104 | أبو أسماء الرحبي أن ثوبان مولى رسول الله - [ & ] - | حدثه قال : كنت قائما عند رسول الله - [ & ] - فجاء حبر | من أحبار اليهود فقال : السلام عليك يا محمد ، فدفعته دفعة كاد أن | يصرع منها فقال : لم دفعتني ؟ فقلت : ألا تقل يا رسول الله ؟ قال اليهودي : | إنا ندعوه باسمه الذي سماه به أهله ، فقال رسول الله - [ & ] - : | ' إن اسمي محمدا الذي سماني به أهلي ' فقال اليهودي : جئت | أسألك عن شيء ، فقال له رسول الله - [ & ] - : ' ينفعك | إن حدثتك ' قال : أسمع بأذني ، فنكت رسول الله - [ & ] - | بعود كان معه 