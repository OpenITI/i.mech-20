ms141	 يحملوا عيب ذي قال يعيبهم % % في الجود والبأس إلا أنه سرف % % 15(@)(@@) % هم الذين هم آووا وهم نصروا % % لما أتاهم من الرحمن ما عرفوا % % 16(@)(@@) % لا يقرع السن في ضنك المكر إذا % % تقارعت فيه بيض الهند والحجف % % 17(@)(@@) % وأبرز الموت عن مسود أوجهه % % فالصبر يبعد والأقران تزدلف % % 18(@)(@@) % ففاز قدحك بالفتح المبين ضحى % % والكفر منتهب الأقطار منتسف % % 19(@)(@@) % وأبت بالمفخر الأسنى يشيده % % حق بسيفك للإسلام معترف % % 20(@)(@@) % أمكنت من رقه الإسلام محتكما % % فيها وأسلمها حران ملتهف % % PageV01P436 21(@)(@@) % مخدع بأماني الغدر مكتئب % % بالخزي مشتمل بالذل ملتحف % % 22(@)(@@) % فات السيوف بشلو حائن ومضى % % أمضى من السيف في أحشائه الأسف % % 23(@)(@@) % فالفخر منتظم والملك منتقم % % والحق منتصر والدين منتصف % % 24(@)(@@) % أ في شيعة بين الخزي المحيط بهم % % عن غب ما اجترحوا غدرا وما اقترفوا % % PageV01P437 البحر : بسيط تام 1(@)(@@) % حسبي رضاك من الدهر الذي عتبا % % وجود كفيك للحظ الذي انقلبا % % 2(@)(@@) % يا مالكا أصبحت كفي وما ملكت % % ومهجتي وحياتي بعض ما وهبا % % 3(@)(@@) % ما أقلع الغيث إلا ريثما خفقت % % مجادح الجود من يمناك فانسكبا % % 4(@)(@@) % ولا نأى السعد إلا وهو تجذبه % % شوافع المجد عن علياك فاقتربا % % 5(@)(@@) % أنت ارتجعت المنى غرا محجلة % % نحوي وقد أعجزتني دهمها هربا % % 6(@)(@@) % لئن دهتني شمالا حرجفا عصفت % % بماء وجهي لقد أنشأتها سحبا % % 7(@)(@@) % لئن تنوسي تحريم المحرم لي % % سعيا لعجلان ما أمنت لي رجبا % % 8(@)(@@) % أنستني بسنا الإصباح منبلجا % % في حين أوحشني البدر الذي غربا % % 9(@)(@@) % وصبحتني غواد منك مغدقة % % عن بارق لي في جنح الظلام خبا % % 10(@)(@@) % لئن توهمه الأعداء لي نكبا % % أنحت علي لقد عوضتها رتبا % % PageV01P438 11(@)(@@) % لئن فجعت بها بيضاء من ورق % % تبأى علي لقد أخلفتها ذهبا % % 12(@)(@@) % فمن يباري جواد الشكر فيك وقد % % ناولتني يدك العلياء يوم كبا % % 13(@)(@@) % وكنت ملجأه في النائبات وقد % % سال الزمان عليه أسهما وظبى % % 14(@)(@@) % وذب عدلك دون الحق منتقما % % ورد نصرك ظلم العلم محتسبا % % 15(@)(@@) % حتى تلافيت في ضنك المقام له % % حظا غدا بين أيدي الظلم منتهبا % % 16 
ms142	(@)(@@) % أبى لك الله إلا أن تفوز بها % % خيرا ثوابا وخيرا عنده عقبا % % 17(@)(@@) % أياديا إن أكن مخصوص نصرتها % % فقد عممت بهن العلم والأدبا % % 18(@)(@@) % وأنعما أكسبتني عز مفخرها % % وغادرت كاشحي رهنا بما كسبا % % 19(@)(@@) % فإن يقع جهد شكري دونهن فقد % % أوجبن من حسن ظني فوق ما وجبا % % 20(@)(@@) % من بعد ما أضرم الواشون جاحمة % % كانت ضلوعي وأحشائي لها حطبا % % PageV01P439 21(@)(@@) % ودسسوا لي في مثنى حبائلهم % % شنعاء بت بها حران مكتئبا % % 22(@)(@@) % حتى هززت فلا زند القريض كبا % % فيما لدي ولا سيف البديه نبا % % 23(@)(@@) % وأشرقت شاهدات الحق تنشر لي % % نورا غدت فيه أقوال الوشاة هبا % % 24(@)(@@) % هيهات أعجز أهل الأرض أن يجدوا % % للدر غير عباب البحر منتسباب % % 25(@)(@@) % وحاش للورد أن يعزى إلى رمض % % وأن يكون له غير الربيع أبا % % 26(@)(@@) % لمن سنا الشمس إن أضحت مشكلة % % فيه لمن نفحات المسك إن كذبا % % 27(@)(@@) % وكيف يصدقني منك الرجاء ولا % % أجزي ثناءك إلا المين والكذبا % % 28(@)(@@) % ودون ما أنا من نعماك محتمل % % ما أنطق الصخر أو ما أنبط القلبا % % 29(@)(@@) % حاشى لقدرك أن أزجي الثناء له % % دعوى وأهدي إليه الدر مغتصبا % % 30(@)(@@) % لكنها همم أنشأتها نعما % % تشاكها بنفيس القدر فاصطحبا % % PageV01P440 31(@)(@@) % ولست أول من أعيت بدائعه % % فاستدعت القول ممن ظن أو حسبا % % 32(@)(@@) % إن امرأ القيس في بعض لمتهم % % وفي يديه لواء الشعر إن ركبا % % 33(@)(@@) % والشعر قد أسر الأعشى وقيده % % خبرا وقد قيل والأعشى إذا شربا % % 34(@)(@@) % وكيف أظما وبحري زاخر فطنا % % إلى خيال من الضحضاح قد نضبا % % 35(@)(@@) % فإن نأى الشك عني أوفها أنذا % % مهيأ لجلي الخبر مرتقبا % % 36(@)(@@) % عبد لنعماك في كفيه نجم هدى % % سار بمدحك يجلو الشك والريبا % % 37(@)(@@) % إن شئت أملى بديع الشعر أو كتبا % % أو شئت خاطب بالمنثور أو خطبا % % 38(@)(@@) % كروضة الحزن أهدى الوشي منظرها % % والماء والزهر والأنوار والعشبا % % 39(@)(@@) % أو سابق الخيل أعطى الحضر متئدا % % والشد والكر والتقريب والخببا % % 40(@)(@@) % سبكته عامري السنخ منقطعا % % إليك من سائر الآمال منقضبا % % PageV01P441 41(@)(@@) % فحق للعلم أن 
ms143	 يزهى به فرحا % % وحق للشعر أن يشدو به طربا % % 42(@)(@@) % فأحجم الدهر عن فتى أدب % % قد حالف العز والأملاك والعربا % % 43(@)(@@) % وبلغته المنى من حمير أملا % % وأعلقته العلا من عامر سببا % % 44(@)(@@) % فأضحت المنية الغراء لي وطنا % % وأضحت الدعوة العلياء لي نسبا % % 45(@)(@@) % وذللت لي أرض أينعت ثمرا % % وظللتني سماء ملئت شهبا % % 46(@)(@@) % وقد وجدت عياذ الله أمنني % % في ذمة الملك المنصور ما حزبا % % 47(@)(@@) % من شر تشغيب حسادي إذا حسدوا % % وشر غاسق أيامي إذا وقبا % % 48(@)(@@) % وقل عني أحزاب العدى ملك % % معود أن يفل الجحفل اللجباأ % % 49(@)(@@) % ويترك الملك الجبار مختلعا % % عنه رداء العلا والعز مستلبا % % 50(@)(@@) % مجدلا بجنوب الأرض منعفرا % % ومشعرا بنجيع الجوف مختضبا % % PageV01P442 51(@)(@@) % وقائد الخيل عم الجو عثيرها % % ومادت الأرض من أهوالها رعبا % % 52(@)(@@) % وصفوة الله من أنصار دعوته % % ومن تنقى لنصر الدين وانتخبا % % 53(@)(@@) % موف على الرتب القصوى مدى فمدى % % ووارث الملك قحطانا أبا فأبا % % 54(@)(@@) % حيث اعتزى فخر إسماعيل في سلفي % % هود وحيث تلاقت خندف وسبا % % 55(@)(@@) % من كل قرم غدا بالمجد مشتملا % % ومستقلا بتاج الملك معتصبا % % 56(@)(@@) % ألقت إلى يده الدنيا أزمتها % % فأحرز الأرض ملكا والعلا حسبا % % 57(@)(@@) % مستحقر لعباب البحر إن وهبا % % ومستكن بركن الحلم إن غضبا % % 58(@)(@@) % كأنه والمنى تسعى إلى يده % % صب تنسم من نحو الحبيب صبا % % 59(@)(@@) % فليشكر الله يا منصور منك يدا % % كشفت عني بها الأحزان والكربا % % 60(@)(@@) % وطالما لاذت الدنيا بحقوك من % % خطب ألم فسكنت المعقل الأشباء % % PageV01P443 61(@)(@@) % وكيف يخلف منك الظن ما رغبا % % أو يعوز المجد في كفيك ما طلبا % % 62(@)(@@) % وقد غدوت الآمال الورى أمدا % % وقد غدوت لأفلاك العلا قطبا % % 63(@)(@@) % وأنت بحر الندى لم يأل أن عذبا % % وأنت حزب الهدى لم يعد أن غلبا % % PageV01P444 البحر : رمل تام 1(@)(@@) % أخلق الدهر بقاء واستجد % % عمرا يفضل عن عمر الأبد % % 2(@)(@@) % والبس المجد حلى بعد حلى % % واعتوره أمدا بعد أمد % % 3(@)(@@) % وابلغ الغايات مغبوطا بها % % في ضمان الله بقيا واستزد % % 4(@)(@@) % وإذا سرك صنع فليدم % % وإذا وافاك 
ms144	 عيد فليعد % % 5(@)(@@) % وإذا جاءك يوم بالمنى % % فاقتبل أضعافها في يوم غد % % 6(@)(@@) % نعم تترى وجد يعتلي % % وعلا تبأى وفتح يستجد % % 7(@)(@@) % واهدم الكفر وغير ملكه % % وابن أعلام الهدى عزا وشد % % 8(@)(@@) % والبس الصبر إلى أرض العدى % % وقد النصر إليه واستمدب % % 9(@)(@@) % واخسف الشرك بعزم ينتضى % % سيفه عن قل هو الله أحد % % 10(@)(@@) % وجد الخيل تثنى مرحا % % فهداها لمدى الشأو المجد % % PageV01P445 11(@)(@@) % ودعا السمر فوافت شرعا % % وظبى الهند فجاءت تتقد % % 12(@)(@@) % فكأن ما كان للرمح شبا % % قبله يوما ولا للسيف حد % % 13(@)(@@) % فرمى عن قوس بأس صادق % % وسطا بساعد الدين الأشد % % 14(@)(@@) % رب أرض بغراري سيفه % % وجد الرحمن فيها وعبد % % 15(@)(@@) % وبلاد للعدى من ذعره % % عدم الإشراك فيها وفقد % % 16(@)(@@) % فانتحى للكفر حتى لم يجد % % واقتفى آثاره حتى همد % % 17(@)(@@) % جاب عنه الأرض حتى جمعوا % % في أقاصيها على أدنى العدد % % 18(@)(@@) % وعفا أعلامهم حتى لقد % % كاد أن يخفى لهم يوم الأحد % % 19(@)(@@) % همم غاياتها لا تنتهي % % عزمات شأوها لا يتئد % % 20(@)(@@) % لعزيز نصره حيث انتوى % % وعلي كعبه حيث قصد % % PageV01P446 21(@)(@@) % منتقى الآباء من ذي يمن % % ماجد الأحوال في عليا معد % % 22(@)(@@) % منهم الأقيال والصيد الألى % % طرف الملك لهم ثم تلد % % 23(@)(@@) % ولهم مفتخر الجود الذي % % ولدته طييء بنت أدد % % 24(@)(@@) % وهم المغفور في بدر لهم % % وهم الأبرار في يوم أحد % % 25(@)(@@) % وهم حراس نفس المصطفى % % حين نام الجيش عنه وهجد % % 26(@)(@@) % وهم أندى وأعطى من قرى % % وهم أرضى وأزكى من شهد % % 27(@)(@@) % وهنيئا لك يا مولى الورى % % ولدا أنجبته وما ولد % % 28(@)(@@) % قمر أشرق في أفق العلا % % فأضاء الدهر منه وسعد % % 29(@)(@@) % وحيا أغدق إلا أنه % % برق الإقدام منه ورعد % % 30(@)(@@) % فهو للإسلام غيث صائب % % وعلى الإشراك شؤبوب برد % % PageV01P447 31(@)(@@) % من رسولي نحوه يخبره % % بالذي فيه يقيني يعتقد % % 32(@)(@@) % دونك السؤدد موفورا فسد % % وجنود الدين والدنيا فقد % % 33(@)(@@) % أي مجد لم تحزه عن أب % % وفخار لم يحزه لك جد % % 34(@)(@@) % أ أسمعوه رغبة من راغب % % ويدي رهن لكم إن لم 
ms145	 يجد % % 35(@)(@@) % فأروه فارسا مستلئما % % وأنا كذابكم إن لم يشد % % 36(@)(@@) % هدئوه بالعوالي والظبى % % وبأبطال الكماة تجتلد % % 37(@)(@@) % جاءت الأعياد تستقبله % % للأماني والسرور المستجد % % 38(@)(@@) % فهنا الإسلام منه عدة % % للهدى والدين من أسنى العدد % % 39(@)(@@) % حضروا الإذن الذي عودتهم % % كظماء الطير أسرابا ترد % % 40(@)(@@) % فدنوا واستوقفتهم هيبة % % ملأتهم من سرور وزؤد % % PageV01P448 41(@)(@@) % فتوانوا بقلوب لم ترم % % ثم أدنتهم جسوم لم تكد % % 42(@)(@@) % ثم أموا الراحة العليا التي % % عمت الدنيا أمانا وصفد % % 43(@)(@@) % يستضيئون بشمس طلقة % % ويهالون بإقدام أسد % % 44(@)(@@) % فهناهم ثم لا زال الورى % % منك في أثواب آمال جدد % % PageV01P449 البحر : كامل تام 1(@)(@@) % لك البشرى ودمت قرير عين % % بشأوي كوكبيك الثاقبين % % 2(@)(@@) % مليكي حمير نشا وشبا % % بتيجان السناء متوجين % % 3(@)(@@) % صفيي ما نمت عليا معد % % وسيطي يعرب في الذروتين % % 4(@)(@@) % وسيفي عاتقيك الصارمين % % وطودي مفخريك الشامخين % % 5(@)(@@) % هما للدين والدنيا محلا % % سويداواهما في المقلتين % % 6(@)(@@) % نذرتهما لدين الله نصرا % % فقد قاما لنذرك وافيين % % 7(@)(@@) % وما زالا لديك ولن يزالا % % بأعباء الخلافة ناهضين % % 8(@)(@@) % شرائع كنت مبدعها وكانا % % على مسعاك فيها دائبين % % 9(@)(@@) % وقاما في سماء علاك نورا % % وإشراقا مقام النيرين % % 10(@)(@@) % فحاط الملك أكلأ حائطين % % وحل الدين أمنع معقلين % % PageV01P450 11(@)(@@) % بحاجب شمس دولة عبد شمس % % وسيف الله منها في اليدين % % 12(@)(@@) % وناصرها الذي ضمنت ظباه % % حمى الثغرين منها الأعليين % % 13(@)(@@) % غذوتهما لبان الحرب حتى % % تركتهما إليها آنسين % % 14(@)(@@) % وما زالا رضيعيها عوانا % % وبكرا ناشئين ويافعينب % % 15(@)(@@) % فما كذبت ظنونك يوم جاءا % % إلى أمد المكارم سابقين % % 16(@)(@@) % ولا خابت مناك وقد أنافا % % على رتب المعالي ساميين % % 17(@)(@@) % ولا نسيت عهود الحارثين % % ولا ضاعت وصايا المنذرين % % 18(@)(@@) % ولا خزيت مآثر ذي كلاع % % ولا أخوت كواعب ذي رعين % % 19(@)(@@) % ولما استصرخ الإسلام طاعا % % إلى العادات منك مبيين % % 20(@)(@@) % كما لبيته أيام تلقى % % سيوف عداته بالراحتين % % PageV01P451 21(@)(@@) % تراث حزت مفخره نزاعا % % إلى أبناء عمك في حنين % % 22(@)(@@) % وقدت زمامه حفظا ورعيا % % إلى سبطي علاك الأولين % % 23(@)(@@) % فيا عز الهدى يوم استقلا % % لحزب الله غير 
ms146	 مواكبين % % 24(@)(@@) % ويا خزي العدى لما استتما % % إليهم بالكتائب قائلين % % 25(@)(@@) % وقد نهدا بأيمن طائرين % % وقد طلعا بأسعد طالعين % % 26(@)(@@) % وقد جاءت جنود النصر زحفا % % تلوذ بظل أكرم رايتين % % 27(@)(@@) % كتائب مثل جنح الليل تبأى % % على بدر الظلام بغرتين % % 28(@)(@@) % لكل مقضقض الأقران ماض % % كأن بثوبه ذا لبدتين % % 29(@)(@@) % فتى ولدته أطراف العوالي % % ومقعصة المنايا توأمين % % 30(@)(@@) % كأن سنانه شيعي بغي % % تقحم ثائرا بدم الحسين % % PageV01P452 31(@)(@@) % وكل أصم عراص التثني % % وذي شطب رقيق الشفرتين % % 32(@)(@@) % كأنهما وليل الحرب داج % % سنا برقين فيها خاطفين % % 33(@)(@@) % أما وسناهما يوم استنارا % % بنور الأبلجين الأزهرين % % 34(@)(@@) % وراحا بالمنايا فاستباحا % % ديار لميق غير معردين % % 35(@)(@@) % وقد جاشت جيوش الموت فيها % % بأهول من توافي الأيهمين % % 36(@)(@@) % كأن مجرة الأفلاك حفت % % بها محفوفة بالشعريين % % 37(@)(@@) % وقد زمت ركاب الشراك منها % % إلى سفر وكانا الحاديين % % 38(@)(@@) % وناءا بالدماء على رباها % % حيا للدين نوء المرزمين % % 39(@)(@@) % لعزم موفقين مسددين % % وبأس مؤيدين مظفرين % % 40(@)(@@) % وقد خسفا كرنة بالعوالي % % وبوغة بادئين وعائدين % % PageV01P453 41(@)(@@) % لقد زجر الهدى يوم استطارا % % إلى الأعداء أيمن سانحين % % 42(@)(@@) % وشام الكفر يوم تيمماه % % بجند الحق أشأم بارقين % % 43(@)(@@) % فتلك مصانع الأمن استحالت % % مصارع كل ذي ختر ومين % % 44(@)(@@) % لغاو سل سيف النكث فيها % % كما نعب الغراب بيوم بين % % 45(@)(@@) % فأضحت منه ثانية لحزوى % % وولى ثالثا للقارظين % % 46(@)(@@) % تناديه المعاهد ليت بيني % % وبينك قبل بعد المشرقين % % 47(@)(@@) % لئن وجدته أشأم من قدار % % لقد عدمته أخيب من حنين % % 48(@)(@@) % سليب الملك منبت الأماني % % وفقد العز إحدى المينتين % % 49(@)(@@) % طريد الروع لو حسب الزبانى % % تلاحظه لغار مع البطين % % 50(@)(@@) % وكل مخادع لك لم يخادع % % حسامك منه حسم الأخدعين % % PageV01P454 51(@)(@@) % هوت بهم مواطئ كل غدر % % إلى أخزى موارد كل حين % % 52(@)(@@) % لسيف لا تقي حداه نفسا % % تراءى من وراء الصفحتين % % 53(@)(@@) % فباء عداك من خلف الأماني % % ومن فقد الحياة بخيبتين % % 54(@)(@@) % فللإشراك كلتا الخزيتين % % وللإسلام إحدى الحسنيين % % 55(@)(@@) % مغانم لا يحيط بهن إلا % % حساب الكاتبين الحافظين % % 56(@)(@@) % كأن الأرض جاءتنا تهادى 
ms147	 % % بوجرة أو بشعبي رامتين % % 57(@)(@@) % بكل أغر سامي الطرف غلت % % يداه للإسار بيارقين % % 58(@)(@@) % وأغيد أذهلت سيفاك عنه % % هريت الشدق عبل الساعدين % % 59(@)(@@) % فيا سمر القنا زهوا وفخرا % % بين الجحفلين % % 60(@)(@@) % ويا قضب الحديد خلاك ذم % % بما أحرزت من قصب اللجين % % PageV01P455 61(@)(@@) % بطعن الأكرمين الأجودين % % وضرب الأمجدين الأنجدين % % 62(@)(@@) % فلله المنابر يوم تبأى % % بفتح جاء يتلو البشريين % % 63(@)(@@) % لئن كان اسمه في الأرض فتحا % % فكنيته تمام النعمتين % % 64(@)(@@) % وخر لها الصليب بكل أرض % % صريعا للجبين ولليدين % % 65(@)(@@) % مآثر عامريين استبدا % % لساحات المكارم عامرين % % 66(@)(@@) % وهمات تنازع سابقات % % إلى ميراث ملك التبعين % % 67(@)(@@) % هما شمسا مفارق كل فخر % % فخل سناهما والمغربين % % 68(@)(@@) % وبحرا الجود ليثا كل غاب % % فكل عدويهما بالعدوتين % % 69(@)(@@) % ويا قطب العلا مليت نعمى % % تملاها بقرب الفرقدين % % 70(@)(@@) % فقرة أعين الإسلام ألا % % تزال بمن ولدت قرير عين % % PageV01P456 البحر : طويل 1(@)(@@) % هو النصر والتمكين أدرك طالبه % % ولاحت وشيكا بالسعود كواكبه % % 2(@)(@@) % وبشر بالفتح المبين افتتاحه % % وأحرزت الصنع الجليل عواقبه % % 3(@)(@@) % وسلطان عز في أرومة مفخر % % تعالت على زهر النجوم مراتبه % % 4(@)(@@) % وجود تناهى في الخلائق وانتهت % % إلى حاتم في الأكرمين مناسبه % % 5(@)(@@) % تقضت رجاء الراغبين سجاله % % وعمت كما عم الغمام مواهبه % % 6(@)(@@) % وملجأ أمن المستضام ومعقل % % كفى الدهر حتى ما تنوب نوائبه % % 7(@)(@@) % وسيف محلى بالمكارم جفنه % % معودة نصر الإله مضاربه % % 8(@)(@@) % إذا سله دين الهدى بكر الردى % % لديه يراعي أمره ويراقبه % % 9(@)(@@) % تخيره الرحمن من سرو حمير % % فناضل عنه باتك الحد قاضبه % % 10(@)(@@) % مخلدة في الصالحين سماته % % وباقيه في العالمين مناقبه % % PageV01P457 11(@)(@@) % حسام الإمام المصطفى وسنانه % % ومفزعه في المشكلات وحاجبه % % 12(@)(@@) % هو القدر المحتوم من ذا يرده % % وسلطان رب العرش من ذا يغالبه % % 13(@)(@@) % سما لعميد المشركين بعزمة % % تداعت لها أركانه وجوانبه % % 14(@)(@@) % وشيعته يا ابن الكرام بجحفل % % سواء عليه خرقه وسباسبه % % 15(@)(@@) % يكاثر أعداد الحصى بكماته % % وتعتد أضعاف النجوم قواضبه % % 16(@)(@@) % لهام كسا أرض الفضاء بجمعه % % وفاضت على شمس النهار ذوائبه % % 17(@)(@@) % نهضت به والجو بالنقع مفعم % % وأنسته 
ms148	 والليل تسطو غياهبه % % 18(@)(@@) % وأعلى لك القدر الجليل أمامه % % لواء أضاء الشرق والغرب ثاقبه % % 19(@)(@@) % فلما رأى غرسية أنه الردى % % يقينا وأن الله لا شك غالبه % % 20(@)(@@) % وقد جل حزب الله دون شغافه % % وقد سلكت في ناظريه كتائبه % % PageV01P458 21(@)(@@) % ووافاه ريح العزم يسقي ربوعه % % وتنهل بالموت الزؤام سحائبه % % 22(@)(@@) % وأبصر بحر الموت طم عبابه % % وفاضت نواحيه وجاشت غواربه % % 23(@)(@@) % وأيقن أن الله صادق وعده % % وأن أماني الضلال كواذبه % % 24(@)(@@) % وأسلمه ضنك المقام إلى التي % % لها قام ناعيه وضجت نواديه % % 25(@)(@@) % قد رابه أنصاره وكماته % % وأوحشه أشياعه وأقاربه % % 26(@)(@@) % وأخلفه الشيطان خادع وعده % % وأيقن أن الله عنك محاربه % % 27(@)(@@) % تلقاك في جيش من الذل جحفل % % صورامه آماله ورغائبه % % 28(@)(@@) % ومن قبل أحفى الرسل نحوك ضارعا % % على حين أن عزت لديك مطالبه % % 29(@)(@@) % وأعيا بآراء الترضي وزيره % % وأنفذ ألفاظ التذلل كاتبه % % 30(@)(@@) % فأعطى بكلتي راحتيه مبادرا % % لأمرك مرض بالذي أنت راغبه % % PageV01P459 31(@)(@@) % وأمكن حبل الرق من حر جيده % % متابع عزم حيث أمرك جاذبه % % 32(@)(@@) % فأعطيته ما لو تأخر ساعة % % لزمت إلى نار الجحيم ركائبه % % 33(@)(@@) % وأضحت سبايا المسلمين حصونه % % وقد نفذت ولدانه وكواعبه % % 34(@)(@@) % فلاك عز الملك والنصر ربه % % وهنأك الصنع المتمم واهبه % % 35(@)(@@) % وله في عبد الملك المظفر رحمهما الله تعالى % % من الكامل % % 36(@)(@@) % شهدت لك الأبطال يوم كفاحها % % والحرب بين غدوها ورواحها % % 37(@)(@@) % والبيض يوم جلائها ومضائها % % والخيل في إقحامها ومراحها % % 38(@)(@@) % ومواكب الأملاك يوم بهائها % % ومشاهد السادات يوم سماحها % % 39(@)(@@) % أن المدى يوم ارتهان سباقها % % لك والمعلى يوم فوز قداحها % % 40(@)(@@) % عقدت بمفرقك الرياسة تاجها % % وكستك لبس ردائها ووشاحها % % PageV01P460 41(@)(@@) % ونمتك من أملاك يعرب نبعة % % تلوي الكواكب في ذرى أدواحها % % 42(@)(@@) % آساد أغيال على مهتاجها % % وبحار إنعام على ممتاحها % % 43(@)(@@) % ومحط أرحال المنى بموارد % % رحب على الوراد عذب مراحها % % 44(@)(@@) % ومنابت العز الذي عمرت به % % في الدهر شم إكامها وبطاحها % % 45(@)(@@) % ومعاقد التيجان فوق مفارق % % بهرت إياة الشمس من أوضاحها % % 46(@)(@@) % والبأس ملء صدورها والحلم حشو برودها والجود موطن 
ms149	 راحها % % 47(@)(@@) % حكمت لها مضر على ساداتها % % يوم افتخار أحيحة بن جلاحها % % 48(@)(@@) % خصت بتعليم الأذان فنوديت % % في نومها بصلاحها وفلاحها % % 49(@)(@@) % واستقرض الرحمن جنة خلده % % ببتات حائطه أبو دحداحها % % 50(@)(@@) % ومناقب أربت على خطبائها % % ومآثر زادت على مداحها % % PageV01P461 51(@)(@@) % فنمتك في أقيالها وملوكها % % وعمرت سبل نوالها وسماحها % % 52(@)(@@) % فلبست ثوب سنائها ووفائها % % وحفظت عهد سيوفها ورماحها % % 53(@)(@@) % فعبأت للإسلام عطفة رحمة % % ألحفت أهل الأرض ظل جناحها % % 54(@)(@@) % وتباشرت منك المنى لما دنت % % بميسر الشيم الكرام متاحها % % 55(@)(@@) % وبطشت بالإشراك بطشة قادر % % بالله مجتث العدى مجتاحها % % 56(@)(@@) % فحطمت عدة ملكها وقصمت عروة % % جمعها وكفيت غرب جماحها % % 57(@)(@@) % وقريت عليا بنبلونة عزمة % % هبت عليها من مهب رياحها % % 58(@)(@@) % وتكنفتك من السعود كواكب % % طلعت بخيلك في وجوه نجاحها % % 59(@)(@@) % والخيل تغدو في الوغى بفوارس % % تخذت معاقلها ذرى أشباحها % % 60(@)(@@) % ثم انبرى المنصور فيها قارعا % % باب السماء بدعوة استفتاحها % % PageV01P462 61(@)(@@) % مستنجزا تأييد ذي العرش الذي % % فلق المشارق عن سنا إصباحها % % 62(@)(@@) % فنهبت عمر حياتها وحويت رق م % % حريمها وحكمت في أرواحها % % 63(@)(@@) % فأقمت فيها للجلاد وللردى % % سوقا حويت المجد في أرباحها % % 64(@)(@@) % ورمت ظباك إليك نفس مليكها % % واري زناد الخزي غير شحاحها % % 65(@)(@@) % مسترحما لك من وقائع لم تزل % % يودي بمهجتها أليم جراحها % % 66(@)(@@) % فزعا إليك بنفس عان خاضع % % بادي المقاتل للسيوف مباحها % % 67(@)(@@) % في شيعة أمت إليك وقد رأت % % أن الخضوع إليك خير سلاحها % % 68(@)(@@) % فأجرت منه بالتعطف مهجة % % وقفا مواعدها على أنواحها % % 69(@)(@@) % وكررت خيل الله تحمل مثلها % % أطلاح أسفار على أطلاحها % % 70(@)(@@) % فصدعت أحشاء الظلام بعزمة % % تسري البصائر في سنا مصباحها % % PageV01P463 71(@)(@@) % والنصر يشرق في ظبى أسيافها % % والفتح يلمع في ذرى أرماحها % % 72(@)(@@) % حتى صبحت بلاد ميرو وقعة % % أنحى على الإشراك سوء صباحها % % 73(@)(@@) % لاقتك دون حصونها فكأنما % % لاقت سيوفك في فضاء براحها % % 74(@)(@@) % وأبحت منها كل مخطفة الحشا % % شرق على اللبات نظم وشاحها % % 75(@)(@@) % فجئت بلمس البعل إلا أنها % % خطت رماح الخط عقد نكاحها % % 76(@)(@@) % بيض حدتهن السيوف فأبرزت 
ms150	 % % صفحات أوجههن بيض صفاحها % % 77(@)(@@) % يا حاجبا شمس الأقاصي والدنى % % بنداه ثوب أمانها وصلاحها % % 78(@)(@@) % اسلم ولا زالت حياتك غبطة % % أبدا تدير عليك أكؤس راحها % % PageV01P464 البحر : طويل 1(@)(@@) % تبلج عن إشراق غرتك الصبح % % وأسفر عن إقدامك النصر والفتح % % 2(@)(@@) % وقرت عيون المسلمين بأوبة % % مصادرها عز وموردها نجح % % 3(@)(@@) % كأن شعاع الشمس من نور هديها % % وعرف نسيم الروض من طيبها نفح % % 4(@)(@@) % ضربت بحزب الله في الأرض مقدما % % إلى متجر جنات عدن له ربح % % 5(@)(@@) % فضعضعت تيجان الضلال بوقعة % % على الشرك لا يؤسى لها أبدا جرح % % 6(@)(@@) % ورويت من ماء الجماجم والطلى % % متون جياد شفها الظمأ الترح % % 7(@)(@@) % بوارق ما أومضن عنك لناكث % % فأخلف من سقيا دم ديمة تسحو % % 8(@)(@@) % صفائح أعداها سناك فأشرقت % % ولم يعدهن العفو منك ولا الصفح % % 9(@)(@@) % وزرقا تعالى للعداة كأنما % % تطاير من زند المنون لها قدح % % 10(@)(@@) % هواد إذا جلين عنك لناكث % % فحتم المنايا من لواحظها لمح % % PageV01P465 11(@)(@@) % وسابحة في البر والبحر لم يزل % % ببسأك في بحر الدماء لها سبح % % 12(@)(@@) % إذا جمجمت يوما بها منك صولة % % إلى الشرك لم يملك أعنتها الكبح % % 13(@)(@@) % رفعت برايات الهدى من صدورها % % هوادي أدنى شأوها الشد والضبح % % 14(@)(@@) % فما حملت خطبا إلى دار خالع % % وإن عز إلا كان أيسره الفدح % % 15(@)(@@) % ولا وطئت للكفر أرضا وإن نأى % % بها الغول إلا مسها منهم قرح % % 16(@)(@@) % فكم روعت للغي في عقر داره % % حمى لم يرع من قبلهن له سرح % % 17(@)(@@) % بكل حمي الأنف دونك لم يخم % % به ساعد عبل ولا صارم شبح % % 18(@)(@@) % تحلوا فناطوا بالعواتق في الوغى % % جيوبا كراما حشوهن لك النصح % % 19(@)(@@) % وكم طردوا من تحت غيل وغابة % % إليك أسودا ما يمل لها ذبح % % 20(@)(@@) % وسرب مها أخلى الهياج خدودها % % فأسفر عن أحداقها الضال والطلح % % PageV01P466 21(@)(@@) % لواه عن الأكفاء عزا وإن تقل % % لها بالقنا الخطي خطب تقل نكح % % 22(@)(@@) % تركن عميد الشرك ما بين جفنه % % وبين غرار النوم عهد ولا صلح % % 23(@)(@@) % يلوذ بشم الراسيات وسحره % % من الطود شعب 
ms151	 للمخاتل أو سفح % % 24(@)(@@) % وما كر إلا نادبا لمعاهد % % لك الفرح الباقي بها وله الترح % % 25(@)(@@) % ويا رب علق لم يسسه موفق % % فوفره جود وبدده شح % % 26(@)(@@) % تركت لعينيه مقاصر عزه % % وأحسن ما حليت أوجهها القبح % % 27(@)(@@) % وأوطأت أيدي الخيل بيضة ملكه % % فأقلعن لا قيض هناك ولا مح % % 28(@)(@@) % وإن حمت الآجال بعض حماته % % فإنك في أعجاز ليلهم صبح % % 29(@)(@@) % وأنت ركزت الملك في الأرض مثلما % % يثبت فيها ذو الجلال وما يمحو % % 30(@)(@@) % لقد كدحوا نكثا لعهدك منهم % % فخيب ذاك السعي وانقلب الكدح % % PageV01P467 31(@)(@@) % وأمسوا وأوضحوا موجفين ببغيهم % % إلى نقم أمسوا لهن ولم يضحوا % % 32(@)(@@) % موارد لا مرعى السيوف بعقرها % % جديب ولا شرب الرماح بها نشح % % 33(@)(@@) % سريت لهم بالخيل في ظل غيهب % % من الليل ما يطوى عليك له كشح % % 34(@)(@@) % تقابل فيه البدر والبدر والقنا % % وزهر نجوم الليل والجنح والجنح % % 35(@)(@@) % وسبطان من أملاك يعرب أقدما % % بأجنادها كالنجم يقدمه النطح % % 36(@)(@@) % سراجان للإسلام ما طلعا معا % % على الخطب إلا بشر اليمن والنجح % % 37(@)(@@) % فهذا حسام في يد الملك قاضب % % رسوب وهذا في يمين الهدى رمح % % 38(@)(@@) % هو الحاجب المحتل من رتب العلا % % بحيث تناهى الفخر والحمد والمدح % % 39(@)(@@) % وأنفس نفس في الورى غير أنه % % إذا لقي الأعداء فهو بها سمح % % 40(@)(@@) % وصنو علاه ناصر الدولة الذي % % يفوز له في كل مكرمة قدح % % PageV01P468 41(@)(@@) % فتلك الربى من بنبلونة والحمى % % من الراح مسود بأرجائه الصبح % % 42(@)(@@) % وبيعة شنت اقروج أوريت فوقها % % سنا لهب فيه لعميائها شرح % % 43(@)(@@) % وكان لها الفصح الأجل فأصبحت % % لنارك فصحا مالها بعده فصح % % 44(@)(@@) % فلله عينا من رأى بك صرحها % % ومن جاحم النيران في سمكه صرح % % 45(@)(@@) % رفعت من الصلبان في عرصاتها % % وقودا له في وجه رومية لفح % % 46(@)(@@) % وفجرت فيها من دماء حماتها % % بحورا لها في تاج ملكهم نضح % % 47(@)(@@) % وأشرعت في أرجائها كل ثاقب % % له في شغاف القلب من قيصر جرح % % 48(@)(@@) % طوالع من آفاق جيش كأنه % % بخرق الملا كسف من الليل أو جنح % % 49 
ms152	(@)(@@) % يضل مدى الأبصار في جنباته % % ويحسر عن غاياته الريح والضح % % 50(@)(@@) % فجوزيت عن سعي البلاد بأنعم % % ذخائرها فوز وعاجلها فتح % % PageV01P469 51(@)(@@) % ووفيت أجر الصابرين مضاعفا % % من الدين والدنيا لك المن والمنح % % 52(@)(@@) % ومليت شهرا للصيام نسكته % % بأشفاع غزو دأبها الضرب والكفح % % 53(@)(@@) % ولا زال عز النصر والفتح عامدا % % لآية ما ينوي وآية ما ينحو % % PageV01P470 البحر : كامل تام 1(@)(@@) % سر سار صنع الله حيث تسير % % قدما وساعد عزمك المقدور % % 2(@)(@@) % ووصلت موصولا ببغيتك المنى % % وميسرا لمرادك التيسير % % 3(@)(@@) % وأعاد عادات جرت لك بالمنى % % رب على أضعافهن قدير % % 4(@)(@@) % فالسعد بالنصر العزيز مخبر % % واليمن بالفتح المبين بشير % % 5(@)(@@) % حكمت لك الأقدار أنك باهر % % ملك الملوك وأنه مبهور % % 6(@)(@@) % وقضى لك الرحمن أنك قاهر % % حزب الضلال وأنه مقهور % % 7(@)(@@) % جعلت فداءك أنفس أحييتها % % وبها جميعا لا بك المحذور % % 8(@)(@@) % فانهض بحزب الله يقدم جمعه % % حفظ الإله وسعيك المشكور % % 9(@)(@@) % في جحفل جم العديد كأنه % % فلك على الأرض الفضاء يدور % % 10(@)(@@) % عمت به الأقطار إلا موضعا % % فيه عدوك للسيوف أسير % % PageV01P471 11(@)(@@) % لجب يغص الأرض وهي عريضة % % ويرد غرب الطرف وهو حسير % % 12(@)(@@) % من كل مقدام يكاد فؤاده % % طربا إلى نغم السيوف يطير % % 13(@)(@@) % متسربل صدأ الحديد كأنه % % قمر تعرض دونه ساهور % % 14(@)(@@) % ومهند يزجي المنون كأنه % % عبد بطاعة حده مأمور % % 15(@)(@@) % لج بشير النصر فيه سابح % % برق سحاب الموت منه قطير % % 16(@)(@@) % ومثقف صدق الكعوب كأنه % % قلم تمكن من شباه النور % % 17(@)(@@) % وأقب مصقول الأديم كأنه % % بحر بريعان الجراء يمور % % 18(@)(@@) % مرح يكر القلب حيث يقوده % % ويسير طرف العين حيث يسير % % 19(@)(@@) % هزج يكاد يبين في نغماته % % ويلاك يا غرسية المغرور % % 20(@)(@@) % أين النجاء وقد أظلك مغضبا % % ليث العرين الحاجب المنصور % % PageV01P472 21(@)(@@) % وأتاك في لبس الحديد مضاعفا % % سيف الهدى ولواؤه المنشور % % 22(@)(@@) % سهم إذا شجر القواضب صائب % % سيف إذا اعتنق الكماة مبير % % 23(@)(@@) % غيث إذا ما الغيث أخلف هاطل % % بدر إذا دجت الخطوب منير % % 24(@)(@@) % سام إلى شيم الملوك منازع % % هاد على خلق الهدى 
ms153	 مفطور % % 25(@)(@@) % متفرد بمناقب متقاصر % % عن كنهها المنظوم والمنثور % % 26(@)(@@) % عبد المليك فتى المكارم والذي % % حظ الرجاء بسيبه موفور % % 27(@)(@@) % فهناك سلك صارمين كلاهما % % للملك والدين الحنيف نصير % % 28(@)(@@) % وذخيرة في النائبات ومعقل % % من صرف أحداث الزمان مجير % % 29(@)(@@) % حازا سناء مناظر ومخابر % % ملئت بهن نواظر وصدور % % PageV01P473 البحر : طويل 1(@)(@@) % ألا هكذا فليسم للمجد من سما % % ويحم ذمار الملك والدين من حمى % % 2(@)(@@) % وإلا فللمنصور غايات ما شآ % % إليه بني الدنيا وأغراض من رمى % % 3(@)(@@) % وحق لمن لاقى فأقدم سيفه % % على غمرات الموت أن يتقدما % % 4(@)(@@) % ومن حقرت مستعظم الهول نفسه % % إذا الخيل كرت أن يكون المعظما % % 5(@)(@@) % ومن مل أنس المال حتى تحكمت % % على ما حوت كفاه أن يتحكما % % 6(@)(@@) % ومن حمت العلق النفيس سيوفه % % من الضيم أن تختار مرتبع الحما % % 7(@)(@@) % ومن تيمته أوجه المجد أن يرى % % وقلب العلا صبا إليه متيما % % 8(@)(@@) % ولله يا منصور آراؤك التي % % بنيت بها نحو الكواكب سلما % % 9(@)(@@) % وهذا عظيم الشرك قد جاء خاضعا % % وألقى بكفيه إليك محكما % % 10(@)(@@) % سليل ملوك الكفر في ذروة السنا % % ووارث ملك الروم أقدم أقدما % % PageV01P474 11(@)(@@) % توسط أنساب القياصر فانتمى % % من الصيد والأملاك أقرب منتمى % % 12(@)(@@) % ولما تقاضى غرب سيفك نفسه % % وحاطت له الأقدار محتقن الدما % % 13(@)(@@) % ولم يستطع نحو الحياة تأخرا % % بفوت ولا نحو النجاة تقدما % % 14(@)(@@) % تداركه المقدار في قبضة الردى % % وخاطبه حنا عليه فأفهما % % 15(@)(@@) % وبشره التأميل منك بعطفة % % تلقى بها روح الحياة تنسما % % 16(@)(@@) % فأشرع أرماح التذلل ظاعنا % % وأصلت أسياف الخضوع مصمما % % 17(@)(@@) % وقابله النصر الذي لك صفوه % % مع السعد حتى احتازه لك مغنما % % 18(@)(@@) % وقاد لحبل الرق نحوك نفسه % % فلاقاك ممتنا ووافاك منعما % % 19(@)(@@) % وحفت به للحاجب القائد الذي % % أبى الدهر إلا ما أمر وأحكما % % 20(@)(@@) % حماية آباء ومنعة قادر % % يتيه على صرف الزمان محرما % % PageV01P475 21(@)(@@) % فراح ذليلا ثم أضحى مبجلا % % وأمسى مهانا ثم أصبح مكرما % % 22(@)(@@) % وأصبح من حظ السلامة وافرا % % بأن راح من عز الإمارة معدما % % 23(@)(@@) % ولاقاك فاستخذى لديك 
ms154	 تذللا % % ليحتاز من أدنى رضاك ترحما % % 24(@)(@@) % لئن خفرته منك ذمة قادر % % لقد فارق الكفر الخذول مذمما % % 25(@)(@@) % لئن سمته البأساء في عقر داره % % لقد عضته في دار ملكك أنعما % % 26(@)(@@) % لئن خاض في استقبالك الجود والندى % % لقد خاض في آثارك النقع والدما % % 27(@)(@@) % ومر يبكي من معاهد ملكه % % معالم عفتها السيوف وأرسما % % 28(@)(@@) % تراع بها الأجبال من رنة الصدى % % ويذعر فيها الطير أن يترنما % % 29(@)(@@) % بسطت له أمنا وقد بسط القنا % % ثرى أرضه من هلها بك أعظما % % 30(@)(@@) % سقيت به الإسلام أريا وطالما % % سقاهم بكأس الموت صابا وعلقما % % PageV01P476 31(@)(@@) % وها هو ذا في راحتيك مذللا % % رهينا لما أمضيت فيه محكما % % 32(@)(@@) % رمى نفسه قسرا إلى الملك الذي % % رأى الدهر مملوكا له فتعلما % % 33(@)(@@) % ولولا سيوف النصر حين انتضيتها % % لقد جل هذا الصنع أن يتوهما % % 34(@)(@@) % فجاء وقيد الروع يقصر خطوه % % ويمتد في حبل الخضوع تقدما % % 35(@)(@@) % يخاطب عن رعب وإن كان مفصحا % % ويفصح عن ذعر وإن كان أعجما % % 36(@)(@@) % إذا راعه هول الجنود فأحجما % % تداركه ذكرى رضاك فأقدما % % 37(@)(@@) % وما كر رجع الطرف إلا وضيغم % % يساور في رعب الأسنة ضيغما % % 38(@)(@@) % وأرقم يسطو بالهواء اضطرابه % % يناهس في ليل من النقع أرقما % % 39(@)(@@) % وعقبان أعلام تمر يخالها % % على نفسه في معرك الحرب حوما % % 40(@)(@@) % فلله يوم جل قدر عديده % % وعدته عن مثلما وكأنما % % PageV01P477 41(@)(@@) % جنود كأن الأرض من لمعانها % % بروق تلالا أو حريق تضرما % % 42(@)(@@) % سحاب من البيض الخوافق قد علا % % وبحر من السرد المضاعف قد طمى % % 43(@)(@@) % بكل كمي عامري كأنما % % تسربل من شمس الضحى وتعمما % % 44(@)(@@) % يحيي الأمير بالحياة مبشرا % % وإن كان قد فاجاه بالموت معلما % % 45(@)(@@) % وقد طالما لاقاه قرنا مساورا % % فوشكان ما لاقاه حزبا مسلما % % 46(@)(@@) % كأن النجوم الزهر حفت بوجهه % % فأدته محروسا إلى قمر السما % % 47(@)(@@) % فقابل وجها بالجمال متوجا % % وقبل كفا بالسماح مختما % % 48(@)(@@) % فهنيت يا منصور سعدا مجددا % % وإقبال صنع بالبقاء متمما % % 49(@)(@@) % ومليت من أسباط مجدك حاجبا % % يباشر منه المجد والفخر مقدما 
ms155	 % % 50(@)(@@) % رميت به بحر الضلالة فانتهى % % وجشمته عبء العلا فتجشما % % PageV01P478 البحر : بسيط تام 1(@)(@@) % شما سنا البارق المنهل فالتمحا % % أي السرى أم أم أي البلاد نحا % % 2(@)(@@) % واستخبرا نفحات الريح هل سبكت % % درا من التبر أو شابت دجى بضحى % % 3(@)(@@) % أم استهامت هوادي الليل فاقتبست % % أم هل تضلل حادي المزن فاقتدحا % % 4(@)(@@) % سار كأن اضطرام الشوق أقلقه % % فليس يرقأ منه مدمع سفحا % % 5(@)(@@) % ومستهل حيا أحيا الورى غدقا % % بل طائر بتباشير المنى سنحا % % 6(@)(@@) % سنا تألق في دار يبشرنا % % دنوه بتلقي شاحط نزحا % % 7(@)(@@) % هي السوانح للمنصور قد نطقت % % بقربه وخفاء الفأل قد برحا % % 8(@)(@@) % لعل قادم بشراه يخبرنا % % عن هاجس بأماني النفس قد نجحا % % 9(@)(@@) % برق تهلل في المزن الهتون كأن % % من وجهه ضاء أو عن كفه سمحا % % 10(@)(@@) % والريح تسحب ذيل القطر في أرج % % وحف كأن بريا ذكره نفحا % % PageV01P479 11(@)(@@) % إن الملا بجنود الأرض قد بجحت % % والجو من رهج الفرسان قد طفحا % % 12(@)(@@) % بكل معتنق الأقران في كرب % % لو زلزلت قنن الأطواد ما برحا % % 13(@)(@@) % شرى من الله نفسا حزت طاعتها % % فأحرز الدين والدنيا بما ربحا % % 14(@)(@@) % كأنه في مجال الخيل ليث شرى % % وعند مزدحم الفرسان قطب رحى % % 15(@)(@@) % يكاد يشتف نفس القرن من طرب % % إذا المهند غناه بما اقترحا % % 16(@)(@@) % وسابح الشأو ما أقحمت هاديه % % بحر المهالك إلا غاض أو سبحا % % 17(@)(@@) % طرف تقود عنان الطرف غرته % % إذا تعالى مجدا أو ونى مرحا % % 18(@)(@@) % وأزرق يتلظى فوق عامله % % شهاب قذف إلى العيوق قد طمحا % % 19(@)(@@) % ومرهف يتثنى شاربا ثملا % % من طول ما اغتبق الأرواح واصطبحا % % 20(@)(@@) % هاتيك أجنحة الرايات خافقة % % إلى المبارك من جو العلا جنحا % % PageV01P480 21(@)(@@) % وقلب الملك في الآفاق منتظرا % % طرفا إلى الغرة العلياء ملتمحا % % 22(@)(@@) % والأرض قد لبست أثواب زهرتها % % وقلد الروض من أزهاره وشحا % % 23(@)(@@) % والأيك يهفو بأنفاس الصبا سحرا % % قد هب مستنطقا أوتاره الفصحا % % 24(@)(@@) % يا من إليه استطار الشوق أنفسنا % % نأيا وآب فطارت نحوه فرحا % % 25(@)(@@) % مليت حاجبك الأعلى ودمت له 
ms156	 % % وقمت بالشكر فيه للذي منحا % % 26(@)(@@) % نجم أنافت على الدنيا رياسته % % ومعلم للهدى والدين قد وضحا % % 27(@)(@@) % سللته لحمى الإسلام منتقما % % ممن عتا في سبيل الله أو جمحا % % 28(@)(@@) % متوجا بسناء الملك مشتملا % % بالحزم ملتحفا بالبأس متشحا % % 29(@)(@@) % مستنصر الله في الأعداء منتصرا % % له ومستفتحا بالله مفتتحا % % 30(@)(@@) % ملاذنا من صروف الدهر إن طرقت % % دهما ومفزعنا في الخطب إن فدحا % % PageV01P481 31(@)(@@) % الشعر أجدر أن يلقاه معترفا % % بالعجز عما يناوي منه ممتدحا % % 32(@)(@@) % والصحف تنفد والأقلام عاجزة % % عن خط ما اجتث من أعدائه ومحا % % 33(@)(@@) % فعش ودم وابق واملك واقتبل نعما % % واحلل منيعا من المكروه منتزحا % % 34(@)(@@) % وقر عينا بسبطي حمير حقبا % % مستوفيا فيهما آمالك الفسحا % % PageV01P482 البحر : بسيط تام 1(@)(@@) % جاءتك خاضعة أعناقها الأمم % % مستسلمين لما تمضي وتحتكم % % 2(@)(@@) % واسترهنتك ملوك الأرض أنفسها % % ما استنفد البأس أو ما استدرك الكرم % % 3(@)(@@) % فليهن سيفك أن الكفر منقصم % % بهبتيه وأن الدين منتظم % % 4(@)(@@) % فهل ترى للعدى في الأرض باقية % % إلا حشاشة من يبكي ويلتدم % % 5(@)(@@) % هذي قواصي ملوك الشرك مذعنة % % تنبا وتعلم أن الشرك يصطلم % % 6(@)(@@) % وراسيات جبال الكفر يخبرنا % % هويها أن ذاك الطود منهدم % % 7(@)(@@) % فل لسيفك في أقصى بلادهم % % بك استعاذوا ومن كراتك انهزموا % % 8(@)(@@) % فشلهم طارد الذعر المطيف بهم % % حتى أجارهم في ظلك الحرم % % 9(@)(@@) % معتسفين سهوب الأرض قد جهلوا % % من كل آنسة الأقطار ما علموا % % 10(@)(@@) % معاهد قدت فيها الخيل فانقلبت % % مثل الربوع محا آثارها القدم % % PageV01P483 11(@)(@@) % عفت معالمها من بعدهم سحب % % صوب الصوارم منها والقنا ديم % % 12(@)(@@) % لا يسألون لها رسما بقاطنه % % إلا أجابتهم الأشلاء والرمم % % 13(@)(@@) % ولا تخب مطاياهم على بلد % % إلا استثيرت بأدنى وخدها اللمم % % 14(@)(@@) % غادرتها موحشات بعد آنسها % % والأرض خاوية منهم بما ظلموا % % 15(@)(@@) % لئن تناهى بهم أفق فشط بهم % % لشد ما حملتهم نحوك الهمم % % 16(@)(@@) % حتى رموا بعصا التسيار فامتسكوا % % حبلا من الملك المنصور واعتصموا % % 17(@)(@@) % ألقوا إليك بأيدي الذل فاعتقدوا % % عهدا من الأمن محفوظا له الذمم % % 18(@)(@@) % وجاهدوا عفوه عن أنفس علمت 
ms157	 % % أن الحياة لها من بعض ما غنموا % % 19(@)(@@) % يمشون في ظلل الرايات تذكرهم % % أيام تغشاهم العقبان والرخم % % 20(@)(@@) % من كل أغلب محذور بوادره % % يساور الريح أحيانا ويلتهم % % PageV01P484 21(@)(@@) % وكل فتخاء ماض حد منسرها % % كأنه نحو أكباد العدى قرم % % 22(@)(@@) % وأرقم يتلوى نحو أرؤسهم % % حتى يكاد لها في الجو يلتقم % % 23(@)(@@) % والأسد تزأر والرايات خافقة % % كأنها مثبتات في قلوبهم % % 24(@)(@@) % والخيل منظومة بالخيل لا كتب % % منها لغاية ذي سعي ولا أمم % % 25(@)(@@) % والأرض من رهبة الأبطال مائدة % % والجو من رهج الفرسان مزدحم % % 26(@)(@@) % والسمر في هبوات النقع ثاقبة % % والبيض في قرب الأغماد تضطرم % % 27(@)(@@) % كأنما ملأت رحب الفضاء لهم % % غلب الضراغم والغابات والأجم % % 28(@)(@@) % وأولياء الهدى والدين قد ستروا % % من أوجه بسناها الخطب يبتسم % % 29(@)(@@) % تعمموا بإياة الشمس واشتملوا % % رقراق نهي سراب البيد والتثموا % % 30(@)(@@) % كأنما تتلالا في رؤوسهم % % وقد توافوا أياد منك أو شيم % % PageV01P485 31(@)(@@) % وشيعة الكفر في مثنى حبائلهم % % تصدق العيش أحيانا وتتهم % % 32(@)(@@) % حتى تراءاك من أقصى السماط وقد % % شيم الحمام وسيف العفو محتكم % % 33(@)(@@) % ممثل في هواديهم وأرؤسهم % % ما عودت منهم المصقولة الخذم % % 34(@)(@@) % لما انتضيت سناها في مفارقهم % % خرت سجودا لك الأعناق والقمم % % 35(@)(@@) % وأوجه عفروها الترب خاضعة % % كأن كل جبين منهم قدم % % 36(@)(@@) % فإن يفض بحرك المحيي لهم فلقد % % جازوا الصفوف وموج الذعر يلتطم % % 37(@)(@@) % أو عاينوا البدر في أعلى منازله % % فقد أحاطت بهم من دونه ظلم % % 38(@)(@@) % فإن عفوت ففي الرحمن مؤتلف % % وإن سطوت ففي الرحمن منتقم % % 39(@)(@@) % واسلم ولا برحت فيهم لنا نقم % % تترى بهم ولك الآلاء والنعم % % PageV01P486 البحر : طويل 1(@)(@@) % إذا شئت كان النجم عندك شاهدي % % بلوعة مشتاق ومقلة ساهد % % 2(@)(@@) % غريب كساه البين أثواب مدنف % % وحفت به الأشجان حف الولائد % % 3(@)(@@) % بعيد الضحى من بعد إلف مفارق % % طويل الدجى من طول بث معاود % % 4(@)(@@) % كأن ظلام الليل سد طريقه % % تعلق أجفاني برعي الفراقد % % 5(@)(@@) % وقد لبست آفاقه من دجونه % % حداد نواع للصباح فواقد % % 6(@)(@@) % سليني عن الليل التمام قطعته % % بزفرة مشتاق 
ms158	 وأنفاس واجد % % 7(@)(@@) % طواك على طيب الكرى فطويته % % بشكوى سلي عنهن صم الجلامد % % 8(@)(@@) % يطاول ليل التم بثي مسعدا % % على ذكر إلف بان غير مساعد % % 9(@)(@@) % ويوحشني ملء السماء كواكبا % % إلى كوكب في مغرب البين واحد % % 10(@)(@@) % ألم أدر أن الصبح شبهك قبلها % % فأعرف منه الآن خلف المواعد % % PageV01P487 11(@)(@@) % سترعى وفاء العهد لي إن نقضته % % لواعج بث في هواك معاهدي % % 12(@)(@@) % ويوشك أن تجلى وجوه مطالبي % % بأزهر وضاح وأروع ماجد % % 13(@)(@@) % مليك لشمل الملك والعز جامع % % وعن حرم الأحساب والمجد ذائد % % 14(@)(@@) % أغر سما للدين فاعتصم الهدى % % به وهدى المعروف سبل المحامد % % 15(@)(@@) % حيا طبق الآفاق شرقا ومغربا % % فما تقتفى في المحل آثار رائد % % 16(@)(@@) % بسيف لأقدار الحتوف مساور % % وسيب لتهتان الغيوم مجاود % % 17(@)(@@) % سليل علا تنميه أنساب حمير % % إلى كل بان للمفاخر شائد % % 18(@)(@@) % همام له من فخر يعرب في العلا % % ذرى كل سامي السبك راسي القواعد % % 19(@)(@@) % محاتد عز واعتلاء كأنما % % سنا الشمس من إشراق تلك المحاتد % % 20(@)(@@) % فتى أذعن الدهر الأبي لحكمه % % فأضحى إليه ملقيا بالمقالد % % PageV01P488 21(@)(@@) % هو البدر إشراقا ونورا وسيفه % % مدى الدهر منه في محل عطارد % % 22(@)(@@) % تدانت من الآمال أنواء كفه % % وبرز سبقا في المدى المتباعد % % 23(@)(@@) % فحجب منه الملك أكرم حاجب % % وقاد جنود النصر أكرم قائد % % 24(@)(@@) % كتائب توحيد الإله شعارها % % وما يوم خزي الكفر فيها بواحد % % 25(@)(@@) % إذا يممت منه حمى فكأنما % % أربت عليه مصعقات الرواعد % % 26(@)(@@) % لئن حل دار الملك من بعد قافلا % % لقد شد أقصاها برأي مجاهد % % 27(@)(@@) % فشاهد عنه النصر إن لم يشاهد % % وجالد عنه الصبر إن لم يجالد % % 28(@)(@@) % رعى الله للمنصور نصرة دينه % % فجازاه خير ابن تلا خير والد % % 29(@)(@@) % وأيد هذا الملك والدين منهما % % بأيمن يمنى ساعدت خير ساعد % % 30(@)(@@) % فيا جامع الإسلام شملا وتاركا % % ديار الأعادي موحشات المعاهد % % PageV01P489 31(@)(@@) % ليهنك أن العيد وافاك قادما % % بأوشك باد للسرور وعائد % % 32(@)(@@) % تلقاك بالبشرى وحياك بالمنى % % وساعد للبشرى لأعدل شاهد % % 33(@)(@@) % فلا زالت الأيام أعياد فضلكم % % لكل موال 
ms159	 خالص الشكر حامد % % 34(@)(@@) % ولا زلتم مأوى غريب وآمل % % ومفزع ملهوف وفرصة قاصد % % PageV01P490 البحر : كامل تام 1(@)(@@) % إن تفخر الدنيا فأنت فخارها % % أو تختر العليا فأنت خيارها % % 2(@)(@@) % المجد ممنوع بسيفك عزه % % والأرض معمور بملكك دارها % % 3(@)(@@) % زهيت بذكرك أرضها وسماؤها % % وجرى بسعدك ليلها ونهارها % % 4(@)(@@) % هديت بهديك في الظلام نجومها % % وسرت بنورك في الدجى أقمارها % % 5(@)(@@) % يا عامريين اعمروا رتب العلا % % فلكم سني سنائها وفخارها % % 6(@)(@@) % وتمكنوا من دولة العز التي % % أنتم زكي أرومها ونجارها % % 7(@)(@@) % لا تعدمن علاكم الرتب التي % % أضحت معظمة بكم أقدارها % % 8(@)(@@) % بكم اكتست حلل السنا وبسعيكم % % ضاءت معالمها وحيط ذمارها % % 9(@)(@@) % رضيت تعبدكم لها أملاكها % % وتفاخرت بولائكم أحرارها % % 10(@)(@@) % من دوحة الكرم المنعمة التي % % أخذت بآفاق العلا أشجارها % % PageV01P491 11(@)(@@) % مدت لأمن المسلمين ظلالها % % ودنت لأرزاق العباد ثمارها % % 12(@)(@@) % في ذروة الشرف التي شادت لكم % % شرفاتها قحطانها ونزارها % % 13(@)(@@) % أعطتكم رهن السباق جيادها % % وخلا لفائت شأوكم مضمارها % % 14(@)(@@) % سبق القضاء بأنكم أملاكها % % دون الأنام وأنكم أنصارها % % 15(@)(@@) % لله منك إذا الشفار تقاصرت % % همم تمر بمرها أقدارها % % 16(@)(@@) % يا قائد الخيل العتاق كأنما % % عزماته أرماحها وشفارها % % 17(@)(@@) % ليث يخاطر في المكر بنفسه % % همم عظيم في العلا أخطارها % % 18(@)(@@) % أوطأت أرض المشركين كتائبا % % فيها وشيك فنائها ودمارها % % 19(@)(@@) % وتركت أرض ليون وهي كأنها % % لم تغن بالأمس القريب ديارها % % 20(@)(@@) % مرفوعة لك في العلا أعلامها % % لما غدت بك عافيا آثارها % % PageV01P492 21(@)(@@) % شيع حواها حد سيفك عنوة % % أضحت وعقبى الإنتقام قصارها % % 22(@)(@@) % وفلول من فات الفرار بنفسه % % جاءت يعاجلها إليك فرارها % % 23(@)(@@) % من بعدما عاذت بحفظ حياتها % % ببروج منع للنجوم جوارها % % 24(@)(@@) % واستعصمت بمعاقل قد أصبحت % % للحين وهي قيودها وإسارها % % 25(@)(@@) % غبقوا بخمر الحرب صرفا فاغتدت % % تلك الحفائظ والحتوف خمارها % % 26(@)(@@) % وكأنما بصرت لظى بمكانهم % % متمنعين فعاجلتهم نارها % % 27(@)(@@) % نار تطاير بالغواة كأنها % % حين ارتمت بهم هناك شرارها % % 28(@)(@@) % وتبرؤوا من كل مخطفة الحشا % % محفوظة لحليلها أطهارها % % 29(@)(@@) % شجيت بمصرع بعلها ثم انثنت % % مطلوبة بجفونها أوتارها % % 30(@)(@@) % من كل 
ms160	 مغرمة بخل تمتري % % السيف أمضى فيه أم تذكارها % % PageV01P493 31(@)(@@) % لبست ثياب الأمن حين تمنعت % % آفاقها وتباعدت أقطارها % % 32(@)(@@) % وتسربلت حلل الثلوج جبالها % % واستفرغت مد الحيا أنهارها % % 33(@)(@@) % والخيل والأبطال تجهد خلفها % % ألا يشط على الخليل مزارها % % 34(@)(@@) % حتى عبرن خليج دوير كأنها % % سفن ترامى بالحتوف بحارها % % 35(@)(@@) % بقواضب قضبت بهن حياتها % % وصوارم صرمت بها أعمارها % % 36(@)(@@) % وكتائب لهجت بطيب ذكركم % % فلذيذه عند الهياج شعارها % % 37(@)(@@) % وكأنهن وقد دجت ظلم الوغى % % في الروع أفلاك عليك مدارها % % 38(@)(@@) % وصلت بيمنك صومها بجهادها % % وندى يديك بأوبها إفطارها % % 39(@)(@@) % حتى قدمت بمفخر الفتح الذي % % أحيا المنى بقدومه استبشارها % % 40(@)(@@) % وطلعت للمتأملين بغرة % % كالشمس يحسر دونها أبصارها % % PageV01P494 41(@)(@@) % فنفوس أهل الخافقين فداؤها % % والله من صرف الحوادث جارها % % PageV01P495 البحر : بسيط تام 1(@)(@@) % إليك منك فرار الخائف الوجل % % وفي يديك أمان الفارس البطل % % 2(@)(@@) % تقابلت نحوك الآفاق واجتمعت % % على يمينك شتى الطرق والسبل % % 3(@)(@@) % ويممتك ملوك الأرض معلمة % % إليك نص نجاء الخيل والإبل % % 4(@)(@@) % فالبر والبحر من آتيك في شغل % % والشرق والغرب من راجيك في جذل % % 5(@)(@@) % قد ساعدتك نجوم السعد طالعة % % فاسعد وأعطيت غايات المنى فسل % % 6(@)(@@) % وأسلمت لك أملاك البلاد معا % % أعنة الملك والأيام والدول % % 7(@)(@@) % وفاز قدحك إذ قارعت أرؤسها % % بطاعة الدهر والأديان والملل % % 8(@)(@@) % وقد تيمم شنج منك عائدة % % تجيره من سيوف الكرب والوهل % % 9(@)(@@) % وقاد نحوك والتوفيق يقدمه % % جيشا من الذل ملء السهل والجبل % % 10(@)(@@) % مستعطفا لحياة جل مطلبها % % عن مبلغ الكتب أو مستعطف الرسل % % PageV01P496 11(@)(@@) % مستخذيا لسيوف النصر حين أبت % % من دين طاعته قولا بلا عمل % % 12(@)(@@) % خلى الكتائب قسرا والظبى وغدا % % عن الأحبة والأشياع في شغل % % 13(@)(@@) % مذل صفحة عان جل مطلبه % % داع إلى صفحك المأمول مبتهل % % 14(@)(@@) % في شيعة ملأت ذلا قلوبهم % % نهوج سبل إليها للقنا ذلل % % 15(@)(@@) % محكمين يسوقون النفوس إلى % % إنفاذ حكمك سوق السبي والنفل % % 16(@)(@@) % مستبشرين بما أحييت من أمل % % مستسلمين لما أمضيت من أجل % % 17(@)(@@) % خاضوا إليك بحار الموت زاخرة % % يمور فيهن موج النقع كالظلل 