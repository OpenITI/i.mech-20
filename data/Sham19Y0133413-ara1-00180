ms169	(@)(@)(@@) -(@)(@)(@@)(@@)(@@) || AUTO ف(@)(@)(@@) ي كلت رجليها سلامى واحدة ... كلتاهما مقرونة بزائدة(@)(@)(@@)(@@)(@@) || AUTO ف(@)(@)(@@) إما كرام موسرون لقيتهم ...(@)(@)(@@)(@@)(@@) || AUTO ف(@)(@)(@@) حسبي من ذو عندهم ما ك(@)(@)(@@)(@@)(@@) || AUTO ف(@)(@)(@@) انيا(@)(@)(@@)(@@)(@@) || AUTO ف(@)(@)(@@) إن أنت لم ين(@)(@)(@@)(@@)(@@) || AUTO ف(@)(@)(@@) عك علمك(@)(@)(@@)(@@)(@@) || AUTO ف(@)(@)(@@) انتسب ... لعلك تهديك القرون الأوائل PageV02P293 (@@) فلا تطمع أبيت اللعن فيها ... ومنعكها بشيء يستطاع(@)(@@) فإلا يكنها أو تكنه فإنه ... أخوها غذته أمه بلبانها(@)(@@) فقلت أعيراني القدوم لعلني ... أخط به قبرا لأبيض ماجد(@)(@@) فياليتني إذا ما كان ذاكم ... ولجت وكنت أولهم ولوجا(@)(@@) في فتية جعلوا الصليب إلههم ... حاشاي إني مسلم معذور(@)(@@) فإن الماء ماء أبي وجدي ... وبئري ذو حفرت وذو طويت(@)(@@) فأما الألى يسكن غور تهامة ... فكل فتاة تترك الحجل أقصما(@)(@@) فيوم علينا ويوم لنا ... ويم نساء ويوم نسر PageV02P294 (@@) فأما القتال فلا قتال لديكم ... ولكن سيرا في عراض المواكب(@)(@@) فقلت يمين الله أبرح قاعدا ... ولو قطعوا رأسي لديك وأوصالي(@)(@@) فكيف إذا مررت بدار قوم ... وجيران لنا كانوا كراما(@)(@@) فأصبحوا والنوى عالي معرسهم ... وليس كل النوى تلقى المساكين(@)(@@) فأصبحوا قد أعاد الله نعمتهم ... إذا هم قريش وإذ ما مثلهم بشر(@)(@@) فإنك موشك أن لا تراها ... وتعدو دون غاضرة العوادي(@)(@@) ألا ليت الشباب يعود يوما ... فأخبره بما صنع المشيب(@)(@@) فمن يك لم ينجب أبوه وأمه ... فإن لنا الأم النجيبة والأب PageV02P295 (@@) في فنية كسوف الهند قد علموا ... أن هالك كل من يحفى ويتنعل(@)(@@) فلو أنك في يوم الرخاء سألتني ... فراقك لم أبخل وأنت صديق(@)(@@) فو الله ما فارقتكم قاليا لكم ... ولكن ما يقضى فسوف يكون(@)(@@) فمن يك أمسى بالمدينة رحله ... فإني وقيار بها لغريب(@)(@@) فقام يذود الناس عنها بسيفه ... وقال ألا لا من سبيل إلى هند(@)(@@) فلا لغو ولا تأثيم فيها ... وما فاهوا به أبدا مقيم(@)(@@) فلا مزنة ودقت ودقها ... ول أرض أبقل إبقالها(@)(@@) فبكى بناتي شجوهن وزوجتي ... والظاعنون إلى ثم تصدعوا PageV02P296 (@@) فلم يدر إلا الله ما هيجت لنا ... عشية آناء الديار وشامها(@)(@@) فيالك من ذي حاجة حيل دونها ... وما كل ما يهوى امرؤ هو نائله 
ms170	(@)(@@) فهيهات هيهات العقيق وأهله ... وهيهات خل بالعقيق نحاوله(@)(@@) فأين إلى أين النجاء ببلغتي ... أتاك أتاك اللاحقون احبس احبس(@)(@@) فصبرا في مجال الموت صبرا ... فما نيل الخلود بالمستطاع(@)(@@) فجئت وقد نضت لنوم ثيابها ... لدى الستر إلا لبسة المتفضل(@)(@@) فليت لي بهم قوم إذا ركبوا ... شنوا الإغارة فرسانا وركبانا PageV02P297 (@@) فقدني وإياهم فإن ألق بعضهم ... يكونوا كتعجيل السنام المسرهد(@)(@@) فكونوا أنتم وبني أبيكم ... مكان الكليتين من الطحال(@)(@@) فقالت أكل الناس أصبحت مانحا ... لسانك كيما أن تغر وتخدعا(@)(@@) فلثمت فاها آخذا بقرونها ... شرب النزيف ببرد ماء الحشرج(@)(@@) فأرسلها العراك ولم يذدها ... ولم يشفق على نغص الدخال(@)(@@) فإياك إياك المراء فإنه ... إلى الشر دعاء وللشر جالب(@)(@@) فمهما تشأ منه فزارة تعطكم ... ومهما تشأ منه فزارة تمنعا PageV02P298 (@@) فخير نحن عند البأس منكم ... إذا الداعي المثوب قال يالا(@)(@@) فإن يك جثماني بأرض سواكم ... فإن فؤادي عندك الدهر أجمع(@)(@@) فيارب هل إلا بك النصر يرتجى ... عليهم وهل إلا عليك المعول(@)(@@) فيا الغلامان اللذان فرا ... إياكما أن تكسبانا شرا(@)(@@) فيا شوق ما أبقى ويالي من النوى ... ويا دمع ما أجرى ويا قلب ما أصبا(@)(@@) فيا لك من ليل كأن نجومه ... بكل مغار الفتل شدت بيذبل(@)(@@) فلولا الله والمهر المفدى ... لرحت وأنت غربال الإهاب PageV02P299 (@@) فرد شعورهن السود بيضا ... ورد وجوههن البيض سودا(@)(@@) فلا تعجلي يا مي أن تتبيني ... بنصح أتى الواشون أم بحبول(@)(@@) فظل طهاة اللحم ما بين منضج ... صفيف شواء أو قدير معجل(@)(@@) فإما أن تكون أخي بصدق ... فأعرف منك غثى من سميني(@)(@@) وإلا فاطرحني واتخذني ... عدوا أتقيك وتتقيني(@)(@@) فما كان بين الخير لو جاء سالما ... أبو حجر إلا ليال قلائل(@)(@@) فما برحت أقدامنا في مقامنا ... ثلاثتنا حتى أزيروا المنائيا(@)(@@) فقلت للركب لما أن علا بهم ... من عن يمين الحبيا نظرة قبل(@)(@@) فالمحه من سنا برق رأى بصري ... أم وجه عالية اختالت بها الكلل(@)(@@) فمثلك حبلى قد طرقت ومرضع ... فألهيتها عن ذي تمائم محول PageV02P300 (@@) فإن الحمر من شر المطايا ... كما الحبطات شر بني تميم(@)(@@) فحور قد لهوت بهن عين 
ms171	 ... نواعم في المورط وفي الرياط(@)(@@) فنعم ابن اخت القوم غير مكذب ... زهير حسام مفرد من حمائل(@)(@@) فنعم أخو الهيجا ونعم شهابها ... (زهير حسام مفرد من حمائل)(@)(@@) فقلت اقتلوها عنكم بمزاجها ... وأحبب بها مقتولة حين تقتل(@)(@@) فقالت لنا أهلا وسهلا وزودت ... جنى النحل أو ما زودت منه أطيب(@)(@@) فلا تعدد المولى شريكك في الغنى ... ولكنما المولى شريكك في العدم(@)(@@) فإن تزعميني كنت أجهل فيكم ... فإني شريت الحلم بعدك بالجهل(@)(@@) فتاتان أما منهما فشبيهة ... هلالا والأخرى تشبه البدرا PageV02P301 (@@) فما قومي بثعلبة بن سعد ... ولا بفزارة الشعر الرقابا(@)(@@) فذلك إن يلق المنية يلقها ... حميدا وإن يستغن يوما فأجدر(@)(@@) فوافيناهم من بجمع ... كأسد الغاب مردان وشيب(@)(@@) فإن تسألوني بالنساء فإنني ... خبير بأدواء النساء طبيب(@)(@@) إذا شاب رأس المرء أو قل ماله ... فليس له من ودهن نصيب(@)(@@) فتلك ولاة السوء قد طال ملكهم ... فحتام حتام العناء المطول(@)(@@) فأطعمنا من لحمها وسنامها ... شواء وخير الخير ما كان عاجله(@)(@@) فقلت له لما تمطى بصلبه ... وأردف أعجازا وناء بكلكل PageV02P302 (@@) فساغ لي الشراب وكنت(@)(@)(@@)(@@)(@@) || AUTO ق(@)(@)(@@) بلا ... أكاد أغص بالماء الحميم(@)(@@) فما كان (حصن) بدر وحابس ... يفو(@)(@)(@@)(@@)(@@) || AUTO ق(@)(@)(@@) ان مرداس في المجمع(@)(@@) فما زالت ال(@)(@)(@@)(@@)(@@) || AUTO ق(@)(@)(@@) تلى تمج دماءها ... بدجلة حتى ماء دجلة أشكل(@)(@@) فأ(@)(@)(@@)(@@)(@@) || AUTO ق(@)(@)(@@) سم أن لو الت(@)(@)(@@)(@@)(@@) || AUTO ق(@)(@)(@@) ينا وأنتم ... لكان لكم يوم من الشر مظلم(@)(@@) فلو نبش الم(@)(@)(@@)(@@)(@@) || AUTO ق(@)(@)(@@) ابر من كليب لخبر بالذنائب أي زير(@)(@@) فيوم الشعثمين ت(@)(@)(@@)(@@)(@@) || AUTO ق(@)(@)(@@) ر عينا ... وكيف ل(@)(@)(@@)(@@)(@@) || AUTO ق(@)(@)(@@) اء من تحت ال(@)(@)(@@)(@@)(@@) || AUTO ق(@)(@)(@@) بور(@)(@@) فيها اثنتان وأربعون حلوبة ... سودا كخافية الغراب الأسحم(@)(@@) -(@)(@)(@@)(@@)(@@) || AUTO ق(@)(@)(@@) -(@)(@)(@@)(@@)(@@) || AUTO ق(@)(@)(@@) الت بنات العم يا سلمى وإن ... كان ف(@)(@)(@@)(@@)(@@) || AUTO ق(@)(@)(@@) يرا معدما(@)(@)(@@)(@@)(@@) || AUTO ق(@)(@)(@@) الت وإنن PageV02P303 (@@) قضى الله يا أسماء أن لست زائلا ... أحبط حتى يغمض العين مغمض(@)(@@) قنافد هداجون حول بيوتهم ... بما كان إياهم عطية عودا(@)(@@) قد قيل ما قيل إن صدقا وإن كذبا ... فما اعتذارك من قول إذا قيلا(@)(@@) قالت ألا ليتما 
ms172	 هذا الحمام لنا ... إلى حمامتنا أو نصفه فقد(@)(@@) قضى كل ذي دين فوفى غريمه ... وعزة ممطول معنى غريمها(@)(@@) قم قائما قم قائما ... صادفت عبدا نائما(@)(@@) [وأمة مراغما] ... وعشراء رائما(@)(@@) قفى قبل التفرق يا ضباعا ... ولا يك موقف منك الوداعا(@)(@@) قومي ذرا المجد بانوها وقد علمت ... بكنه ذلك عدنان وقحطان PageV02P304 (@@) قد ثكلت أمه من كنت واحده ... وبات منتشبا في برتن الأسد(@)(@@) قالت وكنت رجلا فطينا ... هذا لعمر الله إسرائينا(@)(@@) قوم إذا سمعوا الصريخ رأيتهم ... ما بين ملجم مهره أو سافع(@)(@@) قفا نبك من ذكرى حبيب وعرفان ... وربع عفت آثاره منذ أزمان(@)(@@) قد كنت أحجو أبا عمرو أخا ثقة ... حتى ألمت بنا يوما ملمات(@)(@@) قد جربوه فألفوه المغيث إذا ... ما الروع عم فلا يلوي على أحد(@)(@@) قد سالم الحيات منه القدما ... الأفعوان والشجاع الشجعما PageV02P305 (@@) قفا نب(@)(@)(@@)(@@)(@@) || AUTO ك(@)(@)(@@) من ذ(@)(@)(@@)(@@)(@@) || AUTO ك(@)(@)(@@) رى حبيب ومنزل ... بسقط اللوى بين الدخول فحومل(@)(@@) قلت لبواب لديه درهما ... تيذن فإني حمها وجارها(@)(@@) -(@)(@)(@@)(@@)(@@) || AUTO ك(@)(@)(@@) -(@)(@)(@@)(@@)(@@) || AUTO ك(@)(@)(@@) لاهما حين جد الجد بينهما ... قد أقلعا و(@)(@)(@@)(@@)(@@) || AUTO ك(@)(@)(@@) لا أنفيهما رابي(@)(@)(@@)(@@)(@@) || AUTO ك(@)(@)(@@) مية جابر إذا قال ليتي ... أصادفه وأفقد بعض مالي(@)(@)(@@)(@@)(@@) || AUTO ك(@)(@)(@@) رب القلب من جواه يذوب ... حين قال الوشاة هند مغضوب(@)(@@) [ولو أن ما أسعى لأدنى معيشة] ...(@)(@)(@@)(@@)(@@) || AUTO ك(@)(@)(@@) فاني ولم أطلب قليل من المال(@)(@)(@@)(@@)(@@) || AUTO ك(@)(@)(@@) أن فتات العهن في(@)(@)(@@)(@@)(@@) || AUTO ك(@)(@)(@@) ل منزل ... نزلن به حب الفنا لم يحطم(@)(@)(@@)(@@)(@@) || AUTO ك(@)(@)(@@) أن قلوب الطير رطبا ويابسا ... لدى و(@)(@)(@@)(@@)(@@) || AUTO ك(@)(@)(@@) رها العناب والحشف البالي PageV02P306 (@@) كما خط الكتاب بخط يوما ... يهودي يقارب أو يزيل(@)(@@) كأن برذون أبا عصام ... زند حمار دق باللجام(@)(@@) كناحت يوما صخرة بعسيل ... [فرشني بخير لا أكون ومرحة](@)(@@) كناطح صخرة يوما ليوهنها ... فلم يضرها وأوهي قرنه الوعل(@)(@@) كما قيل قبل اليوم خالف تذكرا ... [خلافا لقولي من فيالة رأيه](@)(@@) كأن العقيليين يوم لقيتهم ... فراخ القطا لاقين أجدل بازيا(@)(@@) كم عمة لك يا جرير وخالة ... فدعاء قد حلبت على عشارى(@)(@@) كأنك فينا يا 
ms173	 أبات غريب ... . . . . . . . . . . . . . . . .(@)(@)PageV02P307(@)(@)(@@) كأني غداة البين يوم تحملوا ... لدى سمرات الحي ناقف حنظل(@)(@@) كفى الشيب والإسلام للرء ناهيا ... ......................(@)(@@) كأن صغرى وكبرى من فقاقعها ... حصباء در على أرض من الذهب(@)(@@) كأنك من جمال بني أقيش ... يقعقع بين رجليه بشن(@)(@@) كأن حفيف النبل من فوق عجزها ... غوارب نحل أخطأ الغار مطنف(@)(@@) كهز الرديني تحت العجاج ... جرى في الأنابيب ثم اضطرب(@)(@@) كذبت وبيت الله لو كان صادقا ... لما سبقتني بالبكاء الحمائم(@)(@@) كما في بني بكر بن سعد سيد ... ضخم الدسيعة ماجد نفاع(@)(@@) كأنهم أسيف بيض يمانية ... عضب مضاربها باق بها الأثر PageV02P308 (@@) -(@)(@)(@@)(@@)(@@) || AUTO ل(@)(@)(@@) -(@)(@)(@@)(@@)(@@) || AUTO ل(@)(@)(@@) ئن كان حبيك(@)(@)(@@)(@@)(@@) || AUTO ل(@)(@)(@@) ي كاذبا ...(@)(@)(@@)(@@)(@@) || AUTO ل(@)(@)(@@) قد كان حيك حقا يقينا(@)(@)(@@)(@@)(@@) || AUTO ل(@)(@)(@@) ئن كان إياه(@)(@)(@@)(@@)(@@) || AUTO ل(@)(@)(@@) قد حا(@)(@)(@@)(@@)(@@) || AUTO ل(@)(@)(@@) بعدنا ... عن ا(@)(@)(@@)(@@)(@@) || AUTO ل(@)(@)(@@) عهد وا(@)(@)(@@)(@@)(@@) || AUTO ل(@)(@)(@@) إنسان قد يتغير(@)(@)(@@)(@@)(@@) || AUTO ل(@)(@)(@@) وجهك في ا(@)(@)(@@)(@@)(@@) || AUTO ل(@)(@)(@@) إحسان بسط وبهجة ... أنا(@)(@)(@@)(@@)(@@) || AUTO ل(@)(@)(@@) هماه قفو أكرم وا(@)(@)(@@)(@@)(@@) || AUTO ل(@)(@)(@@) د(@)(@)(@@)(@@)(@@) || AUTO ل(@)(@)(@@) و(@)(@)(@@)(@@)(@@) || AUTO ل(@)(@)(@@) ا أبوك و(@)(@)(@@)(@@)(@@) || AUTO ل(@)(@)(@@) و(@)(@)(@@)(@@)(@@) || AUTO ل(@)(@)(@@) ا قب(@)(@)(@@)(@@)(@@) || AUTO ل(@)(@)(@@) ه عمر ... أ(@)(@)(@@)(@@)(@@) || AUTO ل(@)(@)(@@) قت إ(@)(@)(@@)(@@)(@@) || AUTO ل(@)(@)(@@) يك معد با(@)(@)(@@)(@@)(@@) || AUTO ل(@)(@)(@@) مقا(@)(@)(@@)(@@)(@@) || AUTO ل(@)(@)(@@) يد(@)(@)(@@)(@@)(@@) || AUTO ل(@)(@)(@@) قيم بن(@)(@)(@@)(@@)(@@) || AUTO ل(@)(@)(@@) قمان من أخته ... فكان ابن أخت(@)(@)(@@)(@@)(@@) || AUTO ل(@)(@)(@@) ه وابنما(@)(@)(@@)(@@)(@@) || AUTO ل(@)(@)(@@) هفي ع(@)(@)(@@)(@@)(@@) || AUTO ل(@)(@)(@@) يك(@)(@)(@@)(@@)(@@) || AUTO ل(@)(@)(@@)(@@)(@@) || AUTO ل(@)(@)(@@) هفة