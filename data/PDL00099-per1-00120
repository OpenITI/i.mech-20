ms105	 نحو عاید وصله خواهد اگر منا(@)(@@) 55 یا من‌نه آن منم‌که صله‌هست و عایدش %~% ورآن منم چه شد صله و عاید منا(@)(@@) 56 ارجوکزین سپس‌ دهدم فیض‌عام تو %~% دینار بار بار و زر و سیم من منا(@)(@@) 57 نی نی هزار شکرکه ازکودکی هگرز %~% آرو شره نبوده مرا رسم و دیدنا(@)(@@) 58 گنجی‌ مرا ز علم و هنر داده‌کردگار %~% کایمن بود زکاستن وکید رهزنا(@)(@@) 59 گنجم درون خاطر و من دردمشق دهر %~% سرگشته بی‌سبب چو خداوند زهمنا(@)(@@) 60 لیک آوخاکه چهره اهرون فکرتم %~% از غم شدست تیره‌تزاز روی اهرنا(@)(@@) 61 طبعم عقیم‌گشت و به پنجه رسید سال %~% پنجاه ساله زن شود آری سترونا(@)(@@) 62 تا شیر شرزه روی بتابد ز آتشا %~% تا مارگرزه سخت بپیچد به چندنا(@)(@@) 63 خصم تو را ز آتش و آب سنان تو %~% در آب چشم‌و آتش دل باد مسکنا PageV1P097(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 نسیم خلد می‌رود مگر ز جویبارها %~% که بوی مشک می‌دهد هوای مرغزارها(@)(@@) 2 فراز خاک وخشت‌ها دمیده سبزکشتها %~% چه‌کشتها بهشتها نه ده نه صد هزارها(@)(@@) 3 به‌چنگ بسته چنگها بنای هشته رنگها %~% چکاوهاکلنگها تذروها هزارها(@)(@@) 4 ز نای خویش فاخته دوصد اصول ساخته %~% ترانها نواخته چو زیر و بم تارها(@)(@@) 5 ز خاک رسته لالها چوبسدین پیالها %~% به برگ لاله ژالها چو در شفق ستارها(@)(@@) 6 فکنده‌اند همهمه کشیده‌اند زمزمه %~% به‌شاخ سروبن همه چه‌کبکها چه سارها(@)(@@) 7 نسیم روضه ارم جهد به مغز دمبدم %~% ز بس دمیده پیش هم به طرف جویبارها(@)(@@) 8 بهارها بنفشها شقیقها شکوفها %~% شمامها خجسته‌ها اراک‌ها عرارها(@)(@@) 9 ز هرکرانه مستها پیالها به دستها %~% ز مغز می‌پرستها نشانده می خمارها(@)(@@) 10 ز ریزش سحابها بر آبها حبابها %~% چو جوی نقره آبها روان در آبشارها(@)(@@) 11 فراز سرو بوستان نشسته‌اند قمریان %~% چو مقریان نغز خوان‌به‌زمردین منارها(@)(@@) 12 فکنده‌اند غلغله دو صد هزار یکدله %~% به شاخ‌گل پی‌گله ز رنج انتظارها(@)(@@) 13 درختهای بارور چو اشتران باربر %~% همی ز پشت یکدگرکشیده صف 
ms106	 قطارها(@)(@@) 14 مهارکش شمالشان سحابها رحالشان %~% اصولشان عقالشان فروعشان مهارها(@)(@@) 15 درین بهار دلنشین‌که‌گشته خاک عنبرین %~% ز من ربوده عقل و دین نگاری از نگارها(@)(@@) 16 رفیق جو شفیق خو عقیق لب شقیق رو %~% رقیق دل دقیق مو چه مو ز مشک تارها(@)(@@) 17 به طره‌کرده تعبیه هزار طبله غالیه %~% به مژه بسته عاریه برنده ذوالفقارها(@)(@@) 18 مهی دو هفت سال او سواد دیده خال او %~% شکفته از جمال او بهشت‌ها بهارها(@)(@@) 19 دوکوزه شهد در لبش دو چهره ماه نخشبش %~% نهفته زلف چون شبش به تارها تتارها(@)(@@) 20 سهیل حسن چهر او دو چشم من سپهر او %~% مدام مست مهر او نبیدها عقارها(@)(@@) 21 چگویمت‌که‌دوش چون‌به‌ناز وغمزه‌شدبرون %~% به حجره آمد اندرون به طرز می‌گسارها(@)(@@) 22 به‌کف بطی ز سرخ می‌که‌گر ازو چکد به نی %~% همی ز بند بند وی برون جهد شرارها(@)(@@) 23 دونده در دماغ و سر جهنده در دل و جگر %~% چنانکه برجهد شرر به خشک ریشه خارها(@)(@@) 24 مرا به‌عشوه‌گفت‌هی تراست هیچ میل می %~% بگفتمش به یادکی ببخش هی بیارها(@)(@@) 25 خوش‌است کامشب‌ای صنم‌خوریم می به‌یاد جم %~% که‌گشته دولت عجم قوی چوکوهسارها(@)(@@) 26 ز سعی صدر نامور مهین امیر دادگر %~% کزوگشوده باب و در ز حصن و از حصارها(@)(@@) 27 به جای ظالمی شقی نشسته عادلی تقی %~% که مؤمنان متقی‌کنند افتخارها(@)(@@) 28 امیر شه امین شه یسار شه یمین شه %~% که سر ز آفرین شه به عرش سوده بارها(@)(@@) 29 یگانه صدر محترم مهین امیر محتشم %~% اتابک شه عجم امین شهریارها(@)(@@) 30 امیر مملکت‌گشا امین ملک پادشا %~% معین دین مصطفی ضمین رزق‌خوارها(@)(@@) 31 قوام احتشامها عماد احترامها %~% مدار انتظامها عیار اعتبارها(@)(@@) 32 مکمل قصورها مسدد ثغورها %~% ممهد امورها منظم دیارها(@)(@@) 33 کشنده شریرها رهاکن اسیرها %~% خزانه فقیرها نظام بخش‌کارها(@)(@@) 34 به‌هر بلد به‌هر مکان به‌هر زمین به‌هر زمان %~% کنند مدح او به جان به طرز حقگزارها(@)(@@) 35 خطیبها ادیبها اریبها لبیبها %~% قریبها غریبها صغارها کبارها(@)(@@) 36 
ms107	 به عهد او نشاطهاکنند و انبساطها %~% به مهد در قماطها ز شوق شیرخوارها(@)(@@) 37 سحاب‌کف محیط دل‌کریم خوبسیط ظل %~% مخمرش از آب وگل فخارها وقارها(@)(@@) 38 به ملک شه ز آگهی بسی فزوده فرهی %~% که‌گشت مملکت تهی ز ننگها ز عارها(@)(@@) 39 معین شه امین شه یسار شه یمین شه %~% که فکر دوربین شه‌گزیدش ازکبارها(@)(@@) 40 فنای جان ناکسان شرار خرمن خسان %~% حیات روح مفلسان نشاط دلفکارها(@)(@@) 41 به‌گاه خشمش آنچنان طپد زمین و آسمان %~% که هوش مردم جبان ز هول‌گیر و دارها(@)(@@) 42 زهی ملک رهین تو جهان در آستین تو %~% رسیده از یمین تو به هر تنی یسارها(@)(@@) 43 به هفت خط و چار حد به هر دیار و هر بلد %~% فزون ز جبر و حد و عد تراست جان نثارها(@)(@@) 44 کبیرها دبیرها خبیرها بصیرها %~% وزیرها امیرها مشیرها مشارها(@)(@@) 45 دوسال هست‌کمترک‌که‌فکرت‌توچون محک %~% ز نقد جان یک به یک به سنگ زد عیارها(@)(@@) 46 هم ازکمال بخردی به فر و فضل ایزدی %~% ز دست جمله بستدی عنان اختیارها(@)(@@) 47 چنان ز اقتدار توگرفت پایه‌کار تو %~% که‌گشت روزگار تو امیر روزگارها(@)(@@) 48 چه مایه‌خصم ملک و دین‌که‌کرد ساز رزم وکین %~% که ساختی به هر زمین زلاششان مزارها(@)(@@) 49 خلیل را نواختی بخیل راگداختی %~% برای هردو ساختی چه تختها چه دارها(@)(@@) 50 در ستم شکسته‌یی ره نفاق بسته‌یی %~% به آب عدل شسته‌یی ز چهر دین غبارها(@)(@@) 51 به پای تخت پادشه فزودی آن قدر سپه %~% که صف‌کشد دو ماهه ره پیادها سوارها(@)(@@) 52 کشیده‌گرد ملک و دین ز سعی فکرت رزین %~% ز توپهای آهنین بس آهنین حصارها(@)(@@) 53 حصارکوب‌وصف‌شکن‌که‌خیزدش‌تف‌ازدهن %~% چو ازگلوی اهرمن شررفشان به خارها(@)(@@) 54 سیاه‌مور در شکم‌کنند سرخ‌چهره هم %~% چه‌چهره قاصد عدم چه مور خیل مارها(@)(@@) 55 شوند مورها در او تمام مار سرخ رو %~% که بر جهندش ازگلو چو مارها ز غارها(@)(@@) 56 ندیدم اژدر اینچنین دل آتشین تن آهنین %~% که افکند در اهل‌کین ز مارها 
ms108	 دمارها(@)(@@) 57 نه داد ماند ونه دین ز دیو پر شود زمین %~% فتد خمار ظلم‌وکین به‌مغز ذوالخمارها(@)(@@) 58 به‌نظم‌ملک ودین نگر ز بسکه‌جسته زیب‌و فر %~% که نگسلد یک‌از دگر چو پودها ز تارها(@)(@@) 59 الاگذشت آن زمن‌که بگسلد در چمن %~% میان لاله و سمن حمارها فسارها(@)(@@) 60 مرا بپرور آنچنان‌که ماند از تو جاودان %~% ز شعر بنده در جهان خجسته یادگارها(@)(@@) 61 به جای آب شعر من اگر برند در چمن %~% ز فکر آب و رنج تن رهند آبیارها(@)(@@) 62 هماره تابه هر خزان شود ز باد مهرگان %~% تهی زرنگ و بو جهان چو پشت س‌وسمارها(@)(@@) 63 خجسته باد حال تو هزار قرن سال تو %~% به هر دل از خیال تو شکفته نوبهارها PageV1P098(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ازسروش وحدتم‌برگوش هوش‌آمدخطاب %~% یافتی لا تبطل الاوقات فی عهدالشباب(@)(@@) 2 بعد ازین درکنج عزلت پای در دامن‌کشم %~% من‌کجا و مستی ومیخانه و جام شراب(@)(@@) 3 تا توانم نغمهای نای وحدت را شنید %~% گوش بگمارم چرا بر ناله چنگ و رباب(@)(@@) 4 انقلونی یا قضاه‌الحق من ارض‌الخطا %~% دللونی یا هداه‌الذین الی دارالصواب(@)(@@) 5 چند در دام طبیعت دانه برچینم ز آز %~% تا به‌کی بر جیفه دنیاگرایم چون‌کلاب(@)(@@) 6 هادی‌خودنفس‌سرکش راگزینم‌ای شگفت %~% گرچه صد کرت شنیدستم اذا کان‌الغراب(@)(@@) 7 از نکونامی مرا بر سر چه آمدکاین زمان %~% سر به بدنامی‌برآرم‌درمیان شیخ و شاب(@)(@@) 8 ازخدا وز خویش شرمم باد آخر تا به‌کی %~% روح را زاطوار ناشایسته دارم در عذاب(@)(@@) 9 آفتابم من چرا جان را بکاهم چون هلال %~% شاهبازم من چرا بیغاره یابم از ذباب(@)(@@) 10 من‌که برگردون زنم خرگاه دانش از چه‌رو %~% درگلوی جان چو میخ خرگهم باشد طناب(@)(@@) 11 اهرمن خونم بریزد سوی آن پویم شگفت %~% غافلم از پرسش میعاد و از روز حساب(@)(@@) 12 مرغ جان را تا به‌کی محبوس دارم در قفس %~% چهره توفیق را تا چند پوشم در نقاب(@)(@@) 13 چند در تعمیر دنیاکوشم و تخریب دین %~% تا به‌کی دارم روان 
ms109	 خویش را در اضطراب(@)(@@) 14 مصطفی‌فرمود ان‌الناس فی‌الدنیا ضیف %~% حاصلش‌یعنی‌لدواللموت وابنوا للخراب(@)(@@) 15 درنمانم زین سپس درکار و بار خویشتن %~% عرضه‌دارم حال خود را برجناب مستطاب(@)(@@) 16 نقطه پرگار هستی خط دیوان وجود %~% قطب‌گردون‌کرم توقیع طغرای ثواب(@)(@@) 17 سرور عالم ابوالقاسم محمد آنکه چرخ %~% با وجود او بود چون ذره پیش آفتاب(@)(@@) 18 الذی ردت الیه الشمس و انشق القمر %~% کان امیا ولکن عنده ام الکتاب(@)(@@) 19 والذی فی کفه الکفار لما ابصروا %~% کلم الحصبا قالوا انه شیئی عجاب(@)(@@) 20 رهنمای هردو عالم آنکه در یک چشم زد %~% برگذشت‌ازچارحدوهفت‌خط‌و شش‌حجاب(@)(@@) 21 از ضمیر انور و از جود ابر دست اوست %~% نور جرم آفتاب و مایه دست سحاب(@)(@@) 22 با شرار قهر او هر هفت دوزخ یک شرر %~% باسحاب دست‌او هر هفت‌دریا یک حباب(@)(@@) 23 گر وجود او ندادی ذات واجب را ظهور %~% تا ابد سرپنجه تقدیر بودی در خضاب(@)(@@) 24 تالی هستی‌اوهست آنچه‌هست‌از ممکنات %~% غیرذات حق‌کزو هستی وی شد بهره‌یاب(@)(@@) 25 نه‌سپهروشش‌جهات‌وهفت دوزخ‌هشت‌خلد %~% با سه‌مولود و دو عالم چار مام و هفت باب(@)(@@) 26 در همه عمر از وجود او خطایی سر نزد %~% زانکه بودافعال نیکویش سراسروحی ناب(@)(@@) 27 باوجود آنکه صادر شد خطا از بوالبشر %~% گر همی باور نداری از نبی برخوان فتاب(@)(@@) 28 وز سلیمان حشمت‌الله‌گر خطایی نامدی %~% چیست القینا علی‌کر سیه ثم اناب(@)(@@) 29 روز وشب ازهاتف غیب این نداگردد بلند %~% انه من مال عن شرعه قد نال العقاب(@)(@@) 30 هر زمان از ساکنان عرش آید این سروش %~% من تطرق فی طریقه قد اصاب ما اصاب(@)(@@) 31 معنی‌خوف‌و رجا تفسیربغض ومهر اوست %~% کاین‌یکی رامعصیت نامند وآن یک‌را ثواب(@)(@@) 32 توبه آدم نیفتادی قبول‌کردگار %~% تابه‌فیض خدمتش صدره‌نگشتی فیض‌یاب(@)(@@) 33 آتش نمرودکی‌گشتی‌گلستان بر خلیل %~% گر به انساب جلیل او نجستی انتساب(@)(@@) 34 موسی‌از تیه ضلالت نامدی هرگز برون %~% تا ز طور رأفتش لبیک نشنیدی جواب(@)(@@) 35 نوح اگر بر جودی جودش نجستی التجا %~% همچوکنعان نامدی‌هرگز برون‌از بحر آب(@)(@@) 36 
ms110	 تا نشست ایوب از سرچشمه لطفش بدن %~% کی به‌اول حال‌کردی زان‌چنان‌حالت ایاب(@)(@@) 37 تا مسیح از خاک راهش مسح پیشانی نکرد %~% کی‌شدی‌برآسمان همچون‌دعای مستجاب(@)(@@) 38 یوسف ار بر رشته مهرش نکردی اعتصام %~% یونس ار بر درگه قربش نجستی اقتراب(@)(@@) 39 تا ابد آن یک نمی‌آمد برون از بطن حوت %~% تا قیامت آن یکی بودی به زندان عذاب(@)(@@) 40 آسمان هرجاکه درماند بدو جوید پناه %~% آری آری آستان او بود حسن المآب(@)(@@) 41 عقل پیش قائل ذاتش بود تسلیم محض %~% پشه‌کی لاف توانایی زند پیش عقاب(@)(@@) 42 ای شهنشاهی‌که پیش ابر دست همتت %~% عرصه دریای پهناور نماید چون سراب(@)(@@) 43 تا نه بر مسمار ذاتت محکم الاطناب شد %~% کی شدی افراشته این خرگه زرین قباب(@)(@@) 44 فی‌المثل بر تری آتش اگر بدهی مثال %~% در زمان ماهیت آتش پذیرد انقلاب(@)(@@) 45 ور به تبدیل زمین و آسمان فرمان دهی %~% آن‌کند چون‌این‌درنگ‌واین‌کندچون آن‌شتاب(@)(@@) 46 نی تو راممکن توان‌گفتن نه‌واجب لیک حق %~% بعد ذات خویشتن ذات تراکرد انتخاب(@)(@@) 47 چون برآیی بر براق برق‌پیما جبرئیل %~% گیرد از دستی عنان و از دگر دستی رکاب(@)(@@) 48 خسروا تادرفشان‌گردیده درمدحت حبیب %~% گشته‌خورشید ازفروغ‌فکرتش دراحتجاب(@)(@@) 49 وانکه از دیباچه نعتت‌کند بابی رقم %~% درقیامت بررخش‌ یزدان‌گشاید هشت باب(@)(@@) 50 بر دعای دوستدارانت‌کنم ختم سخن %~% زانکه‌باشد حذ اوصاف توبیرون از حساب(@)(@@) 51 تا ز تابان مشعل خورشید انور بزم روز %~% هرسحر روشن شودچونان که‌شب ازماهتاب(@)(@@) 52 تا قیامت‌کوکب بخت هوا خواهان تو %~% باد روشن‌تر ز نور نیر و جرم شهاب PageV1P099(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 خیمه زربفت زد بر چرخ نیلی آفتاب %~% از پرند نیلگون آویخت بس زرین طناب(@)(@@) 2 بال بگشود از پس شام سیه صبح سفید %~% همچو سیمین شاهبازی از پی مشکین غراب(@)(@@) 3 عنبرین‌موی شب‌ارکافورگون شدعیب نیست %~% صبح روز پیری آید از پس شام شباب(@)(@@) 4 تاکه سیمین حلقهای اختران درد ز هم %~% خور برون‌آمد چو زرین تیغی ازمشکین قراب(@)(@@) 5 یا نه‌گفتی از پی صید حواصل بچگان 
