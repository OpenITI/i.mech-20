ms241	(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2466 - (@)(@@) حدثني قتيبة بن سعيد قال كان رشدين وابن لهيعة لا يباليان ما دفع إليهما فيقرآنه(@)(@@)(@@)(@@) | 2467 - (@)(@@) عبد الملك بن عبد الرحمن أبو العباس أصله شامي سكن البصرة عن الأوزاعي وابن أبى عبلة ضعفه عمرو بن علي جدا منكر الحديث(@)(@@)(@@)(@@) | 2468 - (@)(@@) حدثني عبيد الله بن سعيد سمعت يحيى بن سعيد يقول مهدي بن هلال غير ثقة(@)(@@)(@@)(@@) | 2469 - (@)(@@) كنيته أبو عبد الله البصري(@)(@@)(@@)(@@) | 2470 - (@)(@@) محمد بن مروان الكوفي صاحب الكلبي سكتوا عنه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2471 - (@)(@@) عبد الأعلى بن عبد الأعلى أبو همام الشامي البصري القرشي يقال له أبو محمد فيغضب من أبى همام قال لي عمرو بن عيسى أبو عثمان مات عبد الأعلى سنة تسع وثمانين(@)(@@)(@@)(@@) | 2472 - (@)(@@) قال بن معين وغمزوا يوسف بكذب(@)(@@)(@@)(@@) | 2473 - (@)(@@) واسم السمتي يوسف بن خالد أبو خالد البصري سكتوا عنه(@)(@@)(@@)(@@) | 2474 - (@)(@@) حدثني يحيى بن موسى قال مات حميد بن عبد الرحمن بن حميد وهو أبو عوف الرؤاسي الكوفي آخر سنة تسع وثمانين(@)(@@)(@@)(@@) | 2475 - (@)(@@) ويقال مات علي بن حمزة أبو الحسن الكسائي بالري سنة تسع وثمانين(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2476 - (@)(@@) قال أحمد مات علي بن هاشم سنة تسع وثمانين ومائة وهو بن البريد أبو الحسن الخزاز العابدى مولى لهم الكوفي ومات مبشر بن عبد الله بن رزين أبو بكر السلمي النيسابوري سنة تسع أو ثمان وثمانين(@)(@@)(@@)(@@) | 2477 - (@)(@@) حدثني عمرو بن محمد ثنا عمار بن محمد أبو يقظان وكان أوثق من سيف بن أخت سفيان الثوري ومات عمار بن سيف الضبي فيروى عنه عن سفيان عن عاصم عن أبي عثمان في قطربل وصراة قطربل موضع عند باب بغداد وصراة نهر لا يتابع عليه منكر ذاهب(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2478 - (@)(@@) حدثني خالد بن يوسف بن خالد قال مات أبي يوسف بن خالد بن عمير أبو خالد السمتي البصري سنة تسع وثمانين في رجب(@)(@@)(@@)(@@) | 2479 - (@)(@@) عمرو بن هاشم أبو مالك الجنبي عن بن إسحاق فيه نظر(@)(@@)(@@)(@@) | 2480 - (@)(@@) يحيى بن عقبة بن أبى العيزار عن منصور سمع منه علي بن أبي هاشم وهو منكر الحديث(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2481 - (@)(@@) القاسم بن غصن سمع 
ms242	 جميل بن زيد سمع منه محمد بن عبد العزيز الرملي قال أحمد يحدث بمناكير(@)(@@)(@@)(@@) | 2482 - (@)(@@) مغيرة بن موسى البصري عن بن أبي عروبة منكر الحديث(@)(@@)(@@)(@@) | 2483 - (@)(@@) النضر بن منصور منكر الحديث(@)(@@)(@@)(@@) | 2484 - (@)(@@) النضر بن كثير أبو سهل البصري أراه روى عن بن طاوس في رفع الأيدي وقال مرة أراه ذكره عن النبي صلى الله عليه وسلم عنده مناكير(@)(@@)(@@)(@@) | 2485 - (@)(@@) عثمان بن مطر أبو الفضل الشيباني سمع ثابتا ومعمرا سمع منه سعيد بن سليمان وعلي بن هاشم وروى وكيع عن عثمان الشيباني عن الأزرق عنده عجائب(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2486 - (@)(@@) حدثنا علي قلت لسفيان إن أبا علقمة الفروي قال عن بن المنكدر عن جابر رضي الله عنه أكل النبي صلى الله عليه وسلم ولم يتوضأ فقال أحسن(@)(@@)(@@)(@@) | 2487 - (@)(@@) سمعت بن المنكدر أخبرني من سمع جابرا أكل النبي صلى الله عليه وسلم وقال بعضهم عن بن المنكدر سمعت جابرا ولا يصح(@)(@@)(@@)(@@) | 2488 - (@)(@@) وحدثني إبراهيم بن المنذر ثنا أبو علقمة عبد الله بن محمد بن عبد الله بن أبى فروة هو موالي آل عثمان بن عفان القرشي المدني رأى الأعرج وسمع يزيد بن خصيفة(@)(@@)(@@)(@@) | 2489 - (@)(@@) وحدثني هارون قال مات في المحرم سنة تسعين(@)(@@)(@@)(@@) | 2490 - (@)(@@) حدثني محمد بن أبي بكر قال مات عمر بن علي سنة ثنتين وتسعين(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2491 - (@)(@@) وقال محمد بن وزير مات فيها محمد بن يزيد الواسطي وقال غيره سنة ثمان وثمانين ومائة(@)(@@)(@@)(@@) | 2492 - (@)(@@) أبو سعيد الكلاعي قال لي علي بن حجر كان محمد بن يزيد يقول مولى خولان نعم الشيخ كان(@)(@@)(@@)(@@) | 2493 - (@)(@@) قال أحمد سمعت من سهل بن يوسف سنة تسعين ومائة لم أسمع منه بعد شيئا أراه كان مات وقال غيره كنيته أبو عبد الله البصري الأنباطى(@)(@@)(@@)(@@) | 2494 - (@)(@@) كنية عمر المقدمي أبو حفص البصري(@)(@@)(@@)(@@) | 2495 - (@)(@@) ويقال مات عتاب بن بشير أبو الحسن الحراني مولى بني أمية بحران سنة تسعين ومائة قال لي علي بن حجر أظن كنيته أبو سهل(@)(@@)(@@)(@@) | 2496 - (@)(@@) حدثني محمد بن حرب قال مات أبو مروان يحيى بن أبي زكريا الغساني 
ms243	 الواسطي بعد محمد بن يزيد(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2497 - (@)(@@) وحدثني حسن بن أبى زيد ثنا عبيدة بن حميد الضبي ببغداد سنة تسعين ومائة ومات بعد ذاك كنيته أبو عبد الرحمن مؤدب محمد بن هارون يقال له الحذاء قال أحمد لم يكن بحذاء(@)(@@)(@@)(@@) | 2498 - (@)(@@) حدثني بشر بن الحكم ثنا سهل بن سليمان الأسود القرشي سمع شعبة قال سمعت يزيد بن البراء قال قال عمر مرسل(@)(@@)(@@)(@@) | 2499 - (@)(@@) قال أحمد كان سهل من أصحاب الحديث أروى الناس عن شعبة ترك الناس حديثه(@)(@@)(@@)(@@) | 2500 - (@)(@@) حدثني عمرو بن علي قال سهل بن سليمان الأسود ترك حديثه(@)(@@)(@@)(@@) | 2501 - (@)(@@) ثمامة بن عبيدة العبدي من ناحية البصرة نسبه علي إلى الكذب(@)(@@)(@@)(@@) | 2502 - (@)(@@) الحكم بن يعلى بن عطاء المحاربي الكوفي سمع عباد بن عبد الصمد أبو معمر سمع سعيد بن جبير سمع سواد بن قارب قال لي سليمان بن عبد الرحمن رأيته بدمشق وهو منكر الحديث صباح بن سهل أبو سهل البصري عن محمد بن عمرو منكر الحديث وقال القواريرى حدثنا صباح بن سهل أبو سهل الواسطي سمع حصين بن عبد الرحمن سمع جابر بن سمرة سمع النبي صلى الله عليه وسلم يقول أهل الدرجات العلا يراهم من أسفل منهم وإن أبا بكر وعمر منهم وسمع عاصم الأحول ولا يتابع في حديثه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2503 - (@)(@@) عبد الله بن خالد بن سلمة المخزومي القرشي نزل البصرة في بني راسب عن أبيه روى عنه محمد بن عقبة منكر الحديث(@)(@@)(@@)(@@) | 2504 - (@)(@@) وقال عبد الصمد ثنا عبد الله بن ذكوان ثنا محمد بن المنكدر عن جابر في الأذان منكر الحديث(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2505 - (@)(@@) عبد الرحيم بن زيد بن الحواري أبو زيد العمي البصري عن أبيه سمع منه محمد بن سلام تركوه(@)(@@)(@@)(@@) | 2506 - (@)(@@) عبد المهيمن بن عباس بن سهل الساعدي الأنصاري المدني عن أبيه صاحب مناكير(@)(@@)(@@)(@@) | 2507 - (@)(@@) يحيى بن يعلى الأسلمي القطواني وقطوان موضع بالكوفة سمع حيوة ويونس بن خباب سمع منه ضرار وجندل مضطرب الحديث زكريا بن منظور بن ثعلبة بن أبي مالك أبو يحيى القرظي منكر الحديث مدني سمعت 
ms244	 الحميدي يتكلم فيه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2508 - (@)(@@) محمد بن سليمان بن مسمول المسمولي المخزومي سكن مكة يروى عن نافع عن بن عمر والقاسم بن مخول أدركه الحميدي إبراهيم بن أبي حية أبو إسماعيل واسم أبي حية اليسع بن أسعد المكي منكر الحديث(@)(@@)(@@)(@@) | 2509 - (@)(@@) إسماعيل بن إبراهيم أبو يحيى التيمي كوفى ضعفه لي بن نمير جدا(@)(@@)(@@)(@@) | 2510 - (@)(@@) بشير بن ميمون أبو صيفي واسطي عن عكرمة والمقبري ومجاهد يتهم بالوضع(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2511 - (@)(@@) حفص بن سليمان أبو عمر الأسدي كوفي وهو حفص بن أبي داود أراه هو القارىء عن عاصم وعلقمة بن مرثد سكتوا عنه(@)(@@)(@@)(@@) | 2512 - (@)(@@) يروى عن حفص بن عمر بن أبى العطاف المدني منكر الحديث(@)(@@)(@@)(@@) | 2513 - (@)(@@) روى عن أبي الزناد عن الأعرج عن أبي هريرة عن النبي صلى الله عليه وسلم في تعليم الفرائض وقال مرة عن أبي الزناد عن المقبري عن أبي هريرة ولا يصح(@)(@@)(@@)(@@) | 2514 - (@)(@@) حصين بن عمر أبو عمر الأحمسي عن مخارق بن أبي خالد عنده مناكير(@)(@@)(@@)(@@) | 2515 - (@)(@@) رفدة بن قضاعة الغساني الشامي عن الأوزاعي لا يتابع في حديثه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2516 - (@)(@@) عبد العزيز بن عمران أبو ثابت لا يكتب حديثه مدني عمران كنيته أبو ثابت(@)(@@)(@@)(@@) | 2517 - (@)(@@) حكيم بن خذام أبو سمير البصري منكر الحديث يرى القدر سمع عبد الملك بن عمير والأعمش(@)(@@)(@@)(@@) | 2518 - (@)(@@) قال يحيى بن سعيد كنا نتهم إبراهيم بالكذب وهو بن محمد بن أبي يحيى الأسلمي المدني تركه بن المبارك والناس(@)(@@)(@@)(@@) | 2519 - (@)(@@) حدثني محمد ثنا بشر بن عمر قال نهاني مالك عنه قلت من أجل القدر تنهاني عنه قال ليس في دينه بذاك(@)(@@)(@@)(@@) | 2520 - (@)(@@) وقال بن جريج أخبرت عن إبراهيم بن محمد بن أبي عطاء عن موسى بن وردان يقال هو بن أبي يحيى(@)(@@)(@@)(@@) | 2521 - (@)(@@) ذواد بن علبة الحارثي الكوفي يخالف في حديثه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2522 - (@)(@@) حدثنا بن الأصبهاني ثنا المحاربي عن ليث عن مجاهد قال لي أبو هريرة يا فارسي أشكم درد(@)(@@)(@@)(@@) | 2523 - (@)(@@) قال بن الأصبهاني ورفعه ذواد وليس له أصل أبو هريرة لم يكن فارسيا إنما مجاهد فارسي(@)(@@)(@@)(@@) | 2524 - (@)(@@) يحيى بن 
ms245	 ميمون أبو أيوب التمار بصري قدم بغداد سنة تسعين ومائة قال لي عمرو بن علي كذاب يروي عن عبد الله بن مثنى(@)(@@)(@@)(@@) | 2525 - (@)(@@) قال أحمد قال عبد الرزاق يونس بن سليم خير من برق يعني عمرو بن برق قال أحمد فلما ذكر هذا عند ذاك علمت أن ذا ليس بشيء يروي عن يونس بن يزيد(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2526 - (@)(@@) عمر بن غياث عن عاصم ولم يذكر سماعا من عاصم معضل الحديث روى عنه أبو نعيم ومعاوية بن هشام(@)(@@)(@@)(@@) | 2527 - (@)(@@) كنية النضر بن كثير أبو سهل السعدي البصري عن بن طاوس وابن عقيل عنده مناكير كناه قتيبة(@)(@@)(@@)(@@) | 2528 - (@)(@@) كنية محمد بن أبان بن صالح بن عمير أبو عمر الكوفي ليس بالحافظ عندهم قال عبد الله بن عمر بن محمد بن أبان بن صالح بن عمير نحن من العرب وقع عليهم سبي في الجاهلية وتزوج محمد بن أبان في الجعفيين فنسب إليهم مولى لقريش(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2529 - (@)(@@) حدثنا محمد بن إسماعيل الضبي عن أبي المعلى العطار روى عنه علي بن حميد أبو الحسن الهذلي منكر الحديث(@)(@@)(@@)(@@) | 2530 - (@)(@@) محمد بن إسماعيل بن رجاء بن ربيعة الزبيدي عن سعيد بن حنظلة عن مازن بن عبد الله العائذي سمع عليا ما وجدت إلا القتال ولا يتابع مازن في حديثه(@)(@@)(@@)(@@) | 2531 - (@)(@@) أنكر أحمد أحاديث سويد بن عبد العزيز السلمي قاضي دمشق روى عن يحيى بن سعيد عن عمرة عن عائشة سارق أحيائنا كسارق أمواتنا وإنما يروى عن يحيى بن سعيد عن رجل عن عمر بن عبد العزيز قوله(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2532 - (@)(@@) حدثني إسحاق الواسطي ثنا عبد الحكيم بن منصور الخزاعي أبو سفيان الواسطي مات بعد هشيم عن عبد الملك بن عمير قال رأيت عبد الرحمن بن أبي ليلى في الحلقة فيها نفر من أصحاب محمد يسمعون لحديثه وينصتون له فيهم البراء بن عازب رأيته في أحاديث عبد الحكيم عن عبد الملك والهجري مستقيمة(@)(@@)(@@)(@@) | 2533 - (@)(@@) عثمان بن عثمان الغطفاني أبو عمر القرشي وقال هلال بن بشر هو الغطفاني(@)(@@)(@@)(@@) | 2534 - (@)(@@) وقال بن الطباع حدثنا عثمان 
ms246	 بن عثمان الكلبي سمع علي بن زيد مات عمر بن عبد العزيز لأربعين سنة يعني سمع منه أحمد بن حنبل مضطرب الحديث(@)(@@)(@@)(@@) | 2535 - (@)(@@) عثمان بن العلاء عن سلمة بن وردان سمع أنسا رفعه قال خالق ما يرى قال إبراهيم بن حمزة قال محمد بن معن منكر الحديث(@)(@@)(@@)(@@) | 2536 - (@)(@@) عبد الملك بن هارون بن عنترة بن عبد الرحمن الشيباني منكر الحديث(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2537 - (@)(@@) قال يحيى بن معين رأيت علي بن عابس وقال ليس بشيء هو الأسدي الأزرق بياع الملاء عن العلاء بن المسيب عن أبيه عن عبد الله بن مسعود عن النبي صلى الله عليه وسلم قال بارك لأمتي في بكورها وروى عن إسماعيل عن قيس عن بن مسعود عن النبي صلى الله عليه وسلم قال من كان عليه محرر فليعتق من بلعنبر(@)(@@)(@@)(@@) | 2538 - (@)(@@) عمرو بن أزهر يقال العتكي نزل بغداد رماه أبو سعيد الحداد بالوضع(@)(@@)(@@)(@@) | 2539 - (@)(@@) صالح بن عبد الله بن صالح المدني عنده مناكير(@)(@@)(@@)(@@) | 2540 - (@)(@@) وقال يحيى بن معين عنبسة بن عبد الرحمن بن عنبسة القرشي متروك وروى الوليد عن عنبسة بن عبد الرحمن من آل سعيد بن العاص(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2541 - (@)(@@) كنية مسلم بن خالد الزنجي أبو خالد المكي مولى عبد الله بن سفيان بن عبد الأسد بن هلال بن عبد الله بن عمر المخزومي القرشي كناه آدم قال علي ليس بشيء(@)(@@)(@@)(@@) | 2542 - (@)(@@) قال أحمد انقلبت على مصعب بن سلام أحاديث يوسف بن صهيب فجعلها على الزبرقان السراج وقدم بن أبي شيبة فجعل يذاكر عنه أحاديث عن شعبة وهى للحسن بن عمارة وهو التيمى حديثه في الكوفيين(@)(@@)(@@)(@@) | 2543 - (@)(@@) مطرف بن مازن الكناني قال يحيى قال لي هشام سمع مني كتاب معمر وابن جريج حدث به عن معمر وابن جريج قال يحيى هو كذاب هو قاضي اليمن يحدث عن معمر ويعلى بن مقسم(@)(@@)(@@)(@@) | 2544 - (@)(@@) مفضل بن صالح عن الأعمش منكر الحديث(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2545 - (@)(@@) كنية النضر بن إسماعيل أبو المغيرة البجلي القاص إمام مسجد الكوفة عن محمد بن سوقة(@)(@@)(@@)(@@) | 2546 - (@)(@@) قال أحمد لم يكن 
ms247	 يحفظ الإسناد روى عن إسماعيل عن قيس رأيت أبا بكر أخذ بلسانه وإنما هذا حديث زيد بن أسلم(@)(@@)(@@)(@@) | 2547 - (@)(@@) النضر بن منصور منكر الحديث(@)(@@)(@@)(@@) | 2548 - (@)(@@) كنية نصر بن باب أبو سهل عن إبراهيم الصائغ سكتوا عنه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2549 - (@)(@@) كنية الهيثم بن عدي الطائي أبو عبد الرحمن قال يعقوب بن محمد حدثنا أبو عبد الرحمن من أهل منبج وأمه من سبي منبج وهو الهيثم سكتوا عنه(@)(@@)(@@)(@@) | 2550 - (@)(@@) قال صدقة دفن يوسف بن أسباط كتبه فكان بعد يقلب عليه ولا يجىء كما ينبغي يضطرب في حديثه(@)(@@)(@@)(@@) | 2551 - (@)(@@) كنية أيوب بن عتبة أبو يحيى قاضي اليمامة عن يحيى بن أبي كثير وقيس بن طلق عندهم لين(@)(@@)(@@)(@@) | 2552 - (@)(@@) أيوب بن خوط أبو أمية البصري يقال الحبطي تركه بن المبارك وغيره(@)(@@)(@@)(@@) | 2553 - (@)(@@) أيوب بن وأقد أبو الحسن الكوفي عن عثمان بن حكيم عنده مناكير(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2554 - (@)(@@) كنية أشعث السمان أبو الربيع عن عاصم بن عبيد الله سمع منه وكيع وأبو نعيم ليس بالحافظ عندهم(@)(@@)(@@)(@@) | 2555 - (@)(@@) حدثني محمد بن خلف أبو بكر ثنا يعقوب بن إسحاق ثنا شعبة بن الحجاج أخبرنا سفيان بن سعيد الثوري ثنا علي بن الأقمر عن أبي جحيفة قال قال رسول الله صلى الله عليه وسلم أما أنا فلا آكل متكئا قال يعقوب كبير عن كبار(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2556 - (@)(@@) حدثني الضخم عن الضخام شعبة الخير أبو بسطام سمعت شعبة يقول سفيان الثوري أمير المؤمنين في الحديث(@)(@@)(@@)(@@) | 2557 - (@)(@@) قال سعيد بن سليمان لما أدخلنا على إسحاق بن إبراهيم بدأ يعلى بن الجعد فقال ما تقول في القرآن فقال القرآن كلام الله فقال إسحاق يا شيخ إننا كنا نراك بغير هذا قال علي لا والذي لا إله غيره ما دنت الله بغير هذا فقال لتقولن أو لنفعلن بك قال فقال وقلنا قال سعيد بن سليمان لما خرج يا غلام قرب الحمار فإنا والله قد كفرنا بعدك(@)(@@)(@@)(@@) | (عشر إلى مائتين)(@)(@@)(@@)(@@) | 2558 - (@)(@@) قال مات محمد بن سلمة أبو عبد الله الحراني يقال مولى باهلة سنة إحدى وتسعين ومائة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2559 - (@)(@@) ويقال 
ms248	 مات خالد بن حيان أبو يزيد الرقي مولى كندة الخراز سنة إحدى وتسعين ومائة(@)(@@)(@@)(@@) | 2560 - (@)(@@) مات سلمة بن الفضل أبو عبد الله الأبرش الرازي الأنصاري بعد تسعين ومائة قال على رمينا بحديثه قبل أن يخرج من الري وضعفه إسحاق بن إبراهيم(@)(@@)(@@)(@@) | 2561 - (@)(@@) قال حسين بن حريث مات الفضل بن موسى سنة إحدى وتسعين ومائة فيها أرى قال غيره ثنتين وتسعين أبو عبد الله السنانى المروزي مولى بنى قطيعة من بنى زبيد بن مذحج(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2562 - (@)(@@) حدثني على بن حجر ثنا معمر بن سليمان أبو عبد الله الرقي النخعي وقال غيره مات في شعبان سنة إحدى وتسعين ومائه(@)(@@)(@@)(@@) | 2563 - (@)(@@) حدثني محمد بن المشنى قال مات عبد الله بن إدريس سنة ثنتين وتسعين ومائة ومات فيها غندر وعرعرة بن البرند(@)(@@)(@@)(@@) | 2564 - (@)(@@) عبيد الله بن تمام بن قبس السلمي عن سهل عن أبيه عن أبي هريرة رفعه من أدرك من الجمعة ركعة فليضف إليها أخرى ومن أدرك جلوسا صلى أربعا عنده عن يونس وخالد الحذاء عجائب(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2565 - (@)(@@) كنية عباس بن الفضل أبو الفضل الأنصاري نزل الموصل عن القاسم بن عبد الرحمن قال أحمد حديثه عن يونس وخالد وداود وشعبة صحيح وأنكرت من حديثه عن سعيد عن قتادة عن عكرمة أو جابر بن زيد عن بن عباس قال لي كعب يلي من ولدك رجل هو كذب وكان من أصحاب شعبة يروي عن عيينة بن عبد الرحمن عن أبيه عن عبد الله بن مغفل كنا مع النبي صلى الله عليه وسلم لا يتابع عليه سمع منه الحسن بن بشر(@)(@@)(@@)(@@) | 2566 - (@)(@@) الحكم بن يفعلى بن عطاء المحاربي الكوفي عن عباد بن عبد الصمد قال سليمان بن عبد الرحمن رأيته بدمشق عنده عجائب(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2567 - (@)(@@) الحكم بن سعيد المدني الأموي منكر الحديث قال إبراهيم بن حمزة ثنا الحكم بن سعيد عن الجعيد بن عبد الرحمن عن نافع عن بن عمر عن النبي صلى الله عليه وسلم أو عن أبيه عن النبي صلى الله عليه وسلم القدرية مجوس أمتي(@)(@@)(@@)(@@) | 2568 
ms249	 - (@)(@@) ومحمد بن عيسى العبدي سمع بن المنكدر عن جابر في المؤذنين قاله مسلم بن إبراهيم منكر الحديث(@)(@@)(@@)(@@) | 2569 - (@)(@@) قال محمد بن معمر ثنا سهل بن حماد ثنا محمد بن عيسى أبو يحيى العبدي ثنا بن المنكدر عن جابر بهذا(@)(@@)(@@)(@@) | 2570 - (@)(@@) قال محمد بن عيسى بن القاسم الشامي عن بن أبى ذيب عن الزهري عن سعيد في مقتل عثمان سمع منه هشام بن عمار يقال إنه لم يسمع من بن أبي ذئب هذا الحديث كنية موسى بن عبد العزيز القنبارى أبو شعيب أصله فارسي كتب عنه بعدن دفن كتابه سنة أربع وتسعين ومات بعد ذاك بقليل(@)(@@)(@@)(@@) | 2571 - (@)(@@) حدثني يوسف الصفار قال مات أبو بكر بن عياش سنة ثلاث وتسعين(@)(@@)(@@)(@@) | 2572 - (@)(@@) حدثني محمد قال مات فيها عبد الوهاب وهو بن عبد المجيد الثقفي البصري(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2573 - (@)(@@) وحدثنا محمد قال حدثني محمد بن مقاتل قال أحمد ولد في سنة أربع وتسعين(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2574 - (@)(@@) قال إسحاق سمعت أبا بكر يقول اسمي وكنيتي واحد مولى بني كاهل من أسد الكوفي الحناط وقال بعضهم اسمه شعبة ولا يصح(@)(@@)(@@)(@@) | 2575 - (@)(@@) حدثني محمد بن الوليد قال مات غندر محمد بن جعفر سنة ثلاث وتسعين ومائة(@)(@@)(@@)(@@) | 2576 - (@)(@@) كنية أبو عبد الله البصري صاحب الكرابيس(@)(@@)(@@)(@@) | 2577 - (@)(@@) سمعت عليا سمعت عبد الرحمن يقول حدث شعبة بحديث في أول ما أتيناه فتطلع غندر ليستفهمه فقال فقدتك سمع علمي كله وهو يسألني وكان عبد الرحمن يحثنا على غندر ويقول لوددت أني كنت كتبت كتبه وكنا نستفيد من كتب غندر في حياة شعبة قال علي قال وكيع ما فعل الصحيح الكتاب يعني غندرا قال علي وهو أحب إلي من عبد الرحمن في شعبة وجالس شعبة نحوا من عشرين سنة مات مروان بن معاوية الفزاري سكن مكة سنة ثلاث وتسعين قبل التروية بيوم فجاءة قاله علي كنية مروان أبو عبد الله(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2578 - (@)(@@) كنية مسهر بن عبد الملك بن سلع الهمداني الكوفي أبو محمد فيه بعض النظر(@)(@@)(@@)(@@) | 2579 - (@)(@@) وقال يعقوب بن محمد ثنا الحكم بن سعيد ثنا هشام 
ms250	 عن أبيه عن عائشة عن النبي صلى الله عليه وسلم قال يا رب يا رب حديث منكر(@)(@@)(@@)(@@) | 2580 - (@)(@@) حدثني عبد الله بن أبي الأسود قال مات بن أبى عدى سنة أربع وتسعين(@)(@@)(@@)(@@) | 2581 - (@)(@@) حدثني عمرو بن عيسى أبو عثمان قال مات عبد الوهاب وابن أبي عدي سنة أربع وتسعين(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2582 - (@)(@@) حدثني محمد قال مات بن أبى عدى سنة ثنتين وتسعين ومات بن علية سنة أربع وتسعين(@)(@@)(@@)(@@) | 2583 - (@)(@@) حدثني سعيد بن يحيى بن سعيد قال مات أبي سنة أربع وتسعين ومائة لنصف من شعبان أبو أيوب الأموي قال ومات عمي محمد بن سعيد قبله بسنة(@)(@@)(@@)(@@) | 2584 - (@)(@@) مات محمد بن حرب أبو عبد الله الأبرش الخولاني الحمصي سنة أربع وتسعين ومائة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2585 - (@)(@@) كنية يحيى بن سعيد بن أبان بن سعيد بن العاص أبو أيوب القرشي الأموي الكوفى أخو عبد الله وعنبسة وعبيد(@)(@@)(@@)(@@) | 2586 - (@)(@@) حدثني حسن بن خلف قال مات إسحاق بن يوسف المخزومي أبو محمد سنة ست وتسعين ومائة(@)(@@)(@@)(@@) | 2587 - (@)(@@) حدثني محمود بن غيلان قال مات بشر بن السري وإسحاق الأزرق ومحمد بن فضيل والمحاربي والوليد بن مسلم سنة خمس وتسعين ومائة اسم المحاربي عبد الرحمن بن محمد أبو محمد الكوفي والوليد بن مسلم أبو العباس الدمشقي مولى بنى أمية(@)(@@)(@@)(@@) | 2588 - (@)(@@) حدثني هارون بن حميد قال مات إسحاق الأزرق سنة أربع وتسعين وهو بن يوسف الواسطي أبو محمد وكنية بشر بن السري أبو عمرو الأفوة البصري سكن مكة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2589 - (@)(@@) حدثني إبراهيم بن المنذر قال قال لي حرملة بن عبد العزيز هو بن الربيع بن سبرة الجهني(@)(@@)(@@)(@@) | 2590 - (@)(@@) أبو سعيد بن معبد نزل علي الوليد بن مسلم قافلا من الحج فمات عندي بذي المروة آخر سنة أربع وتسعين أو أول سنة خمس(@)(@@)(@@)(@@) | 2591 - (@)(@@) حدثنا جراح بن مخلد قال مات عبد الرحمن بن عثمان أبو بحر البكراوي أول صفر سنة خمس وتسعين وهو بن أمية بن عبد الرحمن بن أبي بكرة الثقفي البصري قال أحمد طرح الناس حديثه قال محمد بن إسماعيل لم يتبين 
ms251	 طرحه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2592 - (@)(@@) حدثني بن أبى برزة قال مات يحيى بن سليم سنة خمس وتسعين ومائة ويحيى كان يختلف إلى الطائف فنسب إليه(@)(@@)(@@)(@@) | 2593 - (@)(@@) حدثني محمد بن المبارك أبو جعفر قال مات أبو كامل مظفر بن مدرك بغدادي سنة خمس وتسعين من الأبناء(@)(@@)(@@)(@@) | 2594 - (@)(@@) حدثني محمد بن محبوب قال سمعت حفص بن غياث يقول ولدت سنة سبع عشرة هو النخعي الكوفي أبو عمر القاضي(@)(@@)(@@)(@@) | 2595 - (@)(@@) حدثنا محمد قال مات حفص بن غياث سنة ست وتسعين ومائة(@)(@@)(@@)(@@) | 2596 - (@)(@@) وحدثني جراح قال مات معاذ بن معاذ بن نصر بن حسان أبو المثنى العنبري التميمي قاضى البصرة سنة ست وتسعين ومائة(@)(@@)(@@)(@@) | 2597 - (@)(@@) ومات مخلد بن حسين أصله بصري تحول إلى المصيصة سنة ست وتسعين ومائة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2598 - (@)(@@) ومات الحسن بن ندبة أبو سعيد العبدي قبل معاذ سنة خمس أو ست وتسعين هو الكوسج البصري سمع حجاج بن فرافصة(@)(@@)(@@)(@@) | 2599 - (@)(@@) قال وإبراهيم بن هراسة الكوفي تركوه تكلم فيه أبو عبيدة وغيره كان مروان الفزاري يقول حدثنا أبو إسحاق الشيباني بكنيته لكى لا يعرف(@)(@@)(@@)(@@) | 2600 - (@)(@@) قال أحمد بن صالح مات عنبسة بن خالد بن يزيد بن أخى يونس سنة سبع وتسعين هو الأيلي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2601 - (@)(@@) خالد بن عمرو يعد في الكوفيين أراه قرشي قال أحمد منكر الحديث سمع منه أبو عبيد القاسم(@)(@@)(@@)(@@) | 2602 - (@)(@@) قال بن معين سعيد بن محمد الوراق ليس بشيء هو الثقفى الكوفى(@)(@@)(@@)(@@) | 2603 - (@)(@@) قال محمد بن ميسر أبو سعد الصاغاني الضرير سمع هشام بن عروة وأبا جعفر الرازي فيه اضطراب(@)(@@)(@@)(@@) | 2604 - (@)(@@) ورى أبو سعد هذا عن أبي جعفر الرازي عن الربيع بن أنس عن أبي العالية عن أبي بن كعب قال المشركون للنبي صلى الله عليه وسلم انسب لنا ربك فنزلت قل هو الله أحد أو كما قال فاستغربناه حتى وجدناه عن أبي جعفر عن النبي صلى الله عليه وسلم مرسل(@)(@@)(@@)(@@) | 2605 - (@)(@@) حدثني عبد الله بن أبي الأسود قال مات وكيع سنة سبع وتسعين ومائة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2606 - (@)(@@) حدثني هارون بن الأشعث أبو عمران قال مات أبو 
ms252	 سعيد عبد الرحمن بن عبد الله مولى بني هاشم سنة سبع وتسعين(@)(@@)(@@)(@@) | 2607 - (@)(@@) قال يزيد بن عبد ربه مات بقية سنة سبع وتسعين ومائة وهو بقية بن الوليد أبو محمد الكلاعي من أنفسهم الحمصي قال وكيع سمعت الأعمش سنة خمس وأربعين وجاءنا خبر محمد(@)(@@) PageV00P000(@)(@@)(@@)(@@) | (آخر السابع وأول الثامن)(@)(@@) بسم الله الرحمن الرحيم(@)(@@)(@@)(@@) | 2608 - (@)(@@) أخبرنا أبو ذر عبد بن أحمد الهروي قال أخبرنا أبو علي زاهر بن أحمد الفقيه بسرخس قال أخبرنا أبو محمد زنجويه بن محمد النيسابوري قال حدثنا محمد بن إسماعيل البخاري قال(@)(@@)(@@)(@@) | 2609 - (@)(@@) حدثني هارون بن عبد الله قال مات محمد بن فليح سنة سبع وتسعين وهو محمد بن فليح بن سليمان أبو عبد الله الأسلمي ويقال مولى أسلم المدني وقال بعضهم الخزاعي سمع أباه وموسى بن عقبة وابن حرملة ومات فيها في ذي القعدة لثمان مضين حفص بن عبد الرحمن أبو عمر الهلالي سكن نيسابور أصله بلخى سمع بن إسحاق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2610 - (@)(@@) حدثني محمد بن يحيى بن سعيد أبو صالح القطان البصري ويقال عن على إنه مولى بنى تميم(@)(@@)(@@)(@@) | 2611 - (@)(@@) حدثني محمد بن يحيى بن سعيد قال سمعت أبي قال سألت سفيان الثوري وشعبة ومالك بن أنس وابن عيينة عن الرجل أعرف منه ضعفا في الحديث أو تهمة أبينه للناس فقالوا نعم(@)(@@)(@@)(@@) | 2612 - (@)(@@) حدثني عبد الله بن أبي الأسود قال مات بن عيينة ويحيى بن سعيد وابن مهدي سنة ثمان وتسعين ومائة وبين بن عيينة وبين بن مهدى ثمانية أيام ومات يحيى قبل بن المهدى بأربعة أشهر(@)(@@)(@@)(@@) | 2613 - (@)(@@) حدثنا علي قال سمعت سفيان يقول جالست الزهرى وأنا بن ست عشرة سنة وشهرين ونصف وولدت سنة سبع ومائة وقدم علينا الزهري في ذي القعدة سنة ثلاث وعشرين ومائة وخرج إلى الشام فمات فيها(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2614 - (@)(@@) حدثني إبراهيم بن المنذر قال مات محمد بن معن قريبا من موت بن عيينة وهو بن بضع وتسعين(@)(@@)(@@)(@@) | 2615 - (@)(@@) مات معن بن عيسى سنة ثمان وتسعين(@)(@@)(@@)(@@) | 2616 - (@)(@@) مات صفوان بن عيسى أبو محمد الزهري القرشي 
ms253	 البصري سنة ثمان وتسعين ومائة ويقال سنة مائتين(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2617 - (@)(@@) وولد عبد الرحمن بن مهدي بن حسان أبو سعيد البصري يقال مولى الأزد سنة خمس ويقال ست وثلاثين ومائة في المحرم(@)(@@)(@@)(@@) | 2618 - (@)(@@) كنية معن بن عيسى بن يحيى بن دينار أبو يحيى مولى أشجع القزاز المدني(@)(@@)(@@)(@@) | 2619 - (@)(@@) حدثني مقدم بن محمد بن يحيى مات عمي القاسم بن يحيى بن عطاء بن مقدم أبو محمد الهلالي الواسطي منذ إحدى وخمسين سنة وأشهر كأنه سنة سبع وتسعين(@)(@@)(@@)(@@) | 2620 - (@)(@@) قال أحمد مات عنبسة بن خالد بن يزيد الأيلي بن أبى النجاد القرشي بن أخى يونس سنة ثمان وتسعين(@)(@@)(@@)(@@) | 2621 - (@)(@@) وحدثني إسماعيل قال مات أبو عباد هو يحيى بن عباد الضبعي سنة ثمان وتسعين قدم من البصرة بغداد سنة حماد بن سلمة وجعفر بن سليمان(@)(@@)(@@)(@@) | 2622 - (@)(@@) قال عمرو بن محمد أبو سعيد مولى قريش العنقزي وعنقز شيء نسب إليه يقال العنقز مر زنجوش(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2623 - (@)(@@) حدثني إسحاق بن نصر قال مات عمرو بن محمد العنقزي سنة تسع وتسعين ومائة(@)(@@)(@@)(@@) | 2624 - (@)(@@) حدثني أحمد بن أبي رجاء قال مات فيها بن نمير وإبراهيم بن عيينة وصلى على بن نمير محمد بن بشر(@)(@@)(@@)(@@) | 2625 - (@)(@@) حدثني موسى بن عبد الرحمن قال مات عمرو العنقزي سنة مائتين(@)(@@)(@@)(@@) | 2626 - (@)(@@) مات بشر بن مبشر الواسطي سنة تسع وتسعين(@)(@@)(@@)(@@) | 2627 - (@)(@@) ويقال مات الحسن بن موسى الأشيب من أبناء خراسان أبو علي بالري سنة تسع ومائتين كان ببغداد(@)(@@)(@@)(@@) | 2628 - (@)(@@) حدثني الوليد بن عمرو بن سكين أبو العباس قال مات عمرو بن النضر(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2629 - (@)(@@) أبو النضر البصري مولى أرى منذ خمسين سنة وذلك في سنة تسع وأربعين روى عنه أبو عاصم(@)(@@)(@@)(@@) | 2630 - (@)(@@) حدثني بشر بن مرحوم ثنا نافع بن خارجة مولى عبد الله بن حجش كان يأتينا في دارنا هلك منذ عشرين سنة أبو شبهها قال ذلك بشر سنة ثنتين وعشرين ومائتين أو نحوها سمع أباه عن جده(@)(@@)(@@)(@@) | 2631 - (@)(@@) كنية عبد الله بن نمير أبو هشام الهمداني كوفي(@)(@@)(@@)(@@) | 2632 - (@)(@@) أما عبد الله بن معاوية الزبيري القرشي 
ms254	 البصري منكر الحديث(@)(@@)(@@)(@@) | 2633 - (@)(@@) قال بن سعد أبو سعد الأشهلي الأنصاري المدني كان ببغداد مات قبل المائتين ومات سفيان بن عبد الملك المروزي قبل المائتين ومات معاذ بن خالد بن سفيان بن دينار أبو بكر مولى عبد القيس المروزي قبل المائتين(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2634 - (@)(@@) حدثني يوسف بن يعقوب قال مات عبيد بن سعيد بن أبان أبو محمد الأموي القرشي سنة مائتين(@)(@@)(@@)(@@) | 2635 - (@)(@@) حدثني عبد الرحمن بن شيبة قال مات أبو ضمرة سنة مائتين اسمه انس بن عياض الليثي المدني(@)(@@)(@@)(@@) | 2636 - (@)(@@) قال يزيد بن عبد ربه مات محمد بن حمير أبو عبد الحميد السليحي من قضاعة الحمصي سنة مائتين في صفر(@)(@@)(@@)(@@) | 2637 - (@)(@@) حدثني علي بن مسلم قال مات سيار بن حاتم أبو سلمة العنزي البصري سنة مائتين أو تسع وتسعين ومائة ومات مغيرة بن سلمة أبو هشام القرشي البصري سنة مائتين(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2638 - (@)(@@) وكان معاذ بن هشام بن أبي عبد الله أبو عبد الله الدستوائي البصري بالبصرة سنة مائتين وسكن ناحية اليمن(@)(@@)(@@)(@@) | 2639 - (@)(@@) وحدثني عبد الرحمن بن شيبة قال محمد بن إسماعيل بن أبي الفديك أبو إسماعيل مولى بني الديل واسم أبي الفديك دينار عن أبيه المدني قال الفروي مات سنة مائتين(@)(@@)(@@)(@@) | 2640 - (@)(@@) حدثني عمر بن محمد بن حسن بن الزبير الأسدي الكوفي قال مات أبي محمد أبو جعفر بعد أبي السرايا كأنه سنة مائتين أو نحوها(@)(@@)(@@)(@@) | 2641 - (@)(@@) بكر بن يونس بن بكير الكوفي عن موسى بن علي منكر الحديث(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2642 - (@)(@@) إبراهيم بن مهاجر بن مسمار المدني مولى سعد بن أبي وقاص الزهري القرشي منكر الحديث(@)(@@)(@@)(@@) | 2643 - (@)(@@) أصرم بن غياث أبو غياث النيسابوري عن مقاتل بن حيان منكر الحديث سمع منه حسين بن منصور(@)(@@)(@@)(@@) | 2644 - (@)(@@) أصرم بن حوشب متروك الحديث أراه الهمداني(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2645 - (@)(@@) حفص أبو عمران الإمام الواسطي سمع شعبة وعبد الحميد بن جعفر يتكلمون فيه أرى يقال له النجار(@)(@@)(@@)(@@) | 2646 - (@)(@@) حماد بن عمرو أبو إسماعيل النصيبي منكر الحديث ضعفه علي بن حجر(@)(@@)(@@)(@@) | 2647 - (@)(@@) داود بن عطاء أبو سليمان المدني مولى المزنيين عن موسى 
ms255	 بن عقبة قال أحمد رأيته ليس بشيء(@)(@@)(@@)(@@) | 2648 - (@)(@@) قال أحمد وداود المحبر منكر الحديث شبه لا شيء لا يدري ما الحديث(@)(@@)(@@)(@@) | 2649 - (@)(@@) درست بن زياد أبو الحسن البصري عن الرقاشي حديثه ليس بالقائم(@)(@@)(@@)(@@) | 2650 - (@)(@@) سليمان بن عمرو أبو داود النخعي الكوفي رماه قتيبة وإسحاق بالكذب(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2651 - (@)(@@) سليمان بن عطاء سمع مسلمة بن عبد الله سمع منه يحيى بن صالح الشامي في حديثه مناكير(@)(@@)(@@)(@@) | 2652 - (@)(@@) قال أحمد ترك الناس حديث عبد الله بن سلمة الأفطس البصري علي بن غراب أبو علي الفزاري الكوفي قال أحمد كان يدلس ولا أراه إلا صدوقا ويقال المحاربي ولا أراه يصح أنه المحاربي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2653 - (@)(@@) حدثني إبراهيم بن المنذر حدثني إسحاق بن جعفر بن محمد بن علي بن حسين بن علي الهاشمي وكان أوثق من أخيه محمد وأقدم سنا المدني سمع كثير بن عبد الله وسعيد بن بانك(@)(@@)(@@)(@@) | 2654 - (@)(@@) وإسماعيل بن مخراق أراه المدني منكر الحديث(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2655 - (@)(@@) نصر بن حماد البجلي كان ببغداد أبو الحارث الوراق عن شعبة يتكلمون فيه(@)(@@)(@@)(@@) | (عشر إلى عشر ومائتين)(@)(@@)(@@)(@@) | 2656 - (@)(@@) حدثني إسحاق بن نصر قال مات أبو أسامة سنة إحدى ومائتين وهو حماد بن أسامة الكوفى(@)(@@)(@@)(@@) | 2657 - (@)(@@) حدثني عيسى بن عثمان بن عيسى قال مات يحيى بن عيسى أبو زكريا التميمي سنة إحدى ومائتين أو نحوها كوفي الأصل وإنما قيل الرملي لأنه كان حدث بالرملة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2658 - (@)(@@) ومات فيها أمية بن خالد بن الأسود بن هدبة أبو عبد الله البصري الأزدي من بني قيس بن ثوبان(@)(@@)(@@)(@@) | 2659 - (@)(@@) مات عمر بن حفص أبو حفص العبدي يقال بعد المائتين وليس بالقوي(@)(@@)(@@)(@@) | 2660 - (@)(@@) مات علي بن عاصم أبو الحسن مولى قريبة بنت محمد بن أبى بكر الصديق القرشي يتكلمون فيه سنة إحدى ومائتين(@)(@@)(@@)(@@) | 2661 - (@)(@@) وقال وهب بن بقية سمعت يزيد بن زريع قال ثنا علي عن خالد ببضعة عشر حديثا سألنا خالدا عن حديث فأنكره ثم آخر فأنكره ثم ثالث فأنكر فأخبرناه فقال كذاب فاحذروه قال البخاري أما أنا فلا أكتبه يعني حديث علي بن عاصم 
ms256	(@)(@@)(@@)(@@) | 2662 - (@)(@@) حدثني هارون بن حميد قال مات علي بن عاصم سنة إحدى ومائتين(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2663 - (@)(@@) حدثني عبيد الله بن سعد بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف الزهري القرشي مات أبي سعد بن إبراهيم سنة إحدى ومائتين(@)(@@)(@@)(@@) | 2664 - (@)(@@) حدثني إسماعيل بن أبي أويس قال مات أخي أبو بكر بن أبي أويس وهو عبد الحميد بن عبد الله بن أويس الأصبحي حليف بني تيم من قريش سنة ثنتين ومائتين(@)(@@)(@@)(@@) | 2665 - (@)(@@) ومات حماد بن مسعدة أبو سعيد البصري سنة ثنتين ومائتين(@)(@@)(@@)(@@) | 2666 - (@)(@@) ويقال مات سعيد بن يحسى أبو سفيان الحميري الواسطي الحذاء يوم الأربعاء لأربع بقين من شعبان سنة ثنتين ومائتين(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2667 - (@)(@@) حدثني فضل بن يعقوب مات يحيى بن سكن بغدادي بصري الأصل بالرقة سنة ثنتين ومائتين(@)(@@)(@@)(@@) | 2668 - (@)(@@) حدثني منذر بن الوليد بن عبد الرحمن الجارودي البصري قال مات أبو العباس سنة ثنتين ومائتين في جمادى الآخرة(@)(@@)(@@)(@@) | 2669 - (@)(@@) مات طلاب بن خراش أبو يريم الشيباني سنة ثنتين ومائتين يروي عن أخيه مراسيل(@)(@@)(@@)(@@) | 2670 - (@)(@@) حدثني جراح بن مخلد قال مات سالم بن نوح بن أبي عطاء أبو سعيد العطار بعد المائتين وهو البصري ومات يحيى بن كثير أبو غسان بعد المائتين(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2671 - (@)(@@) ومات سلم بن قتيبة بعد المائتين هو الشعيري البصري خراساني نزل البصرة(@)(@@)(@@)(@@) | 2672 - (@)(@@) يقال مات مصعب بن المقدام سنة ثلاث ومائتين(@)(@@)(@@)(@@) | 2673 - (@)(@@) حدثني أحمد بن أبى الرجاء قال مات يحيى بن آدم وزيد بن الحباب وحسين الجعفي وأبو داود الحفري وأبو أحمد الزبيري سنة ثلاث ومائتين(@)(@@)(@@)(@@) | 2674 - (@)(@@) وحدثني محمد بن المثني قال مات فيها أبو داود يعنى الطيالسي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2675 - (@)(@@) حدثني موسى بن عبد الرحمن الكندي المسروقي قال مات محمد بن بشر سنة ثلاث ومائتين أبو عبد الله العبدي الكوفي(@)(@@)(@@)(@@) | 2676 - (@)(@@) قال يزيد بن عبد ربه مات شريح بن يزيد أبو حيوة سنة ثلاث ومائتين في صفر وهو والد حيوة الحضرمي الحمصي(@)(@@)(@@)(@@) | 2677 - (@)(@@) حدثني يوسف بن راشد قال مات يحيى بن ضريس قاضي الري في شهر ربيع الأول سنة 
ms257	 ثلاث ومائتين ومات محمد بن بكر بن عثمان البرساني سكن البصرة فيها في ذي الحجة ومات إبراهيم بن حبيب بن الشهيد أبو إسحاق مولى الأزد البصري سنة ثلاث ومائتين ومات الحسين بن الوليد أبو علي النيسابوري القرشي سنة ثلاث ومائتين(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2678 - (@)(@@) ويقال مات سلمة بن سليمان أبو سليمان المروزي سنة ثلاث ومائتين وقال بعضهم مات قبل ذلك(@)(@@)(@@)(@@) | 2679 - (@)(@@) اسم الحفري عمر بن سعد الكوفي وحفر موضع(@)(@@)(@@)(@@) | 2680 - (@)(@@) حدثني هارون بن حميد قال مات الفضل بن عنبسة أبو الحسن الواسطي أراه سنة ثلاث ومائتين الخزاز(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2681 - (@)(@@) حدثني موسى بن عبد الرحمن يعني الكندي المسروقي قال مات محمد بن عبيد الأحدب سنة ثلاث ومائتين وهو الطنافسي الكوفي الإيادي أبو عبد الله أخو يعلى(@)(@@)(@@)(@@) | 2682 - (@)(@@) وقال غيره مات محمد سنة خمس بالكوفة وخمس أصح(@)(@@)(@@)(@@) | 2683 - (@)(@@) مات أحمد بن أبي طيبة واسم أبي طيبة عيسى بن سليمان بن دينار الدارمي الجرجاني سنة ثلاث ومائتين يحدث عن عنبسة(@)(@@)(@@)(@@) | 2684 - (@)(@@) حدثني هارون بن سفيان قال مات عبد الصمد بن جابر الضبي أبو الفضل سنة ثلاث أو أربع ومائتين وكان على شرطة زهير فقلت لأبي نعيم فقال كان يتقشف لي زمن شريك كوفى الأصل سكن بغداد التقشف التزهد(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2685 - (@)(@@) حدثني محمد بن عبيد المدني قال مات عبيد بن ميمون أبو عباد مولى هارون بن زيد بن مهاجر بن قنفذ بن عمير بن جدعان من تيم بن مرة القرشي سنة أربع ومائتين(@)(@@)(@@)(@@) | 2686 - (@)(@@) مات محمد بن إدريس أبو عبد الله الشافعي القرشي سنة أربع ومائتين سكن مصر(@)(@@)(@@)(@@) | 2687 - (@)(@@) ومات النضر بن شميل أبو الحسن المازني البصري سكن مرو سنة أربع ومائتين(@)(@@)(@@)(@@) | 2688 - (@)(@@) مات عبد الوهاب بن عطاء أبو نصر الخفاف ببغداد سنة أربع ومائتين(@)(@@)(@@)(@@) | 2689 - (@)(@@) حدثني زكريا بن يحيى قال مات فيها زحر بن حصن أبو الفرج الطائي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2690 - (@)(@@) حدثنا أحمد بن يحيى الأودي قال مات إسحاق بن منصور أبو عبد الرحمن سنة أربع ومائتين سمع داود الطائي وسليمان بن قرم وعن إسرائيل(@)(@@)(@@)(@@) | 2691 - (@)(@@) حدثني أحمد بن عبد 
ms258	 الله بن علي بن سويد بن منجوف أبو بكر السدوسي قال مات أبي أبو محمد سنة أربع ومائتين البصري(@)(@@)(@@)(@@) | 2692 - (@)(@@) حدثني فضل بن يعقوب قال مات هاشم بن القاسم أبو النضر سنة خمس ومائتين وقال غيره مات ببغداد في شوال أو في ذي القعدة سنة تسع ومائتين(@)(@@)(@@)(@@) | 2693 - (@)(@@) يقال له قيصر ويقال الليثي ويقال تميمى خراساني نزل بغداد(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2694 - (@)(@@) حدثني محمد بن مسكين قال مات بشر بن بكر أبو عبد الله أظنه البجلي آخر سنة خمس ومائتين وهو الشامي(@)(@@)(@@)(@@) | 2695 - (@)(@@) حدثنا أحمد بن سعيد قال مات أبو عامر العقدي ويعقوب بن إسحاق الحضرمي سنة خمس ومائتين في يوم واحد ومات روح بن عبادة تلك السنة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2696 - (@)(@@) حدثنا حفص بن عمر قال حدثنا عبيدة بن أبي رائطة الكوفي قدم علينا أيام شعبة سمع أبا حميدة الظاعني وعثمان صاحب إبراهيم وعن عاصم بن بهدلة ومات القاسم بن عمرو بن محمد هو أبو محمد العنقزي مولى لقريش الكوفي سنة ست أو خمس ومائتين(@)(@@)(@@)(@@) | 2697 - (@)(@@) حدثني واصل بن عبد الله قال مات أبي عبد الله بن بدر بن واصل بن عبد الله بن سعد بن أطول الجهني أبو الفضل في شعبان سنة خمس ومائتين(@)(@@)(@@)(@@) | 2698 - (@)(@@) حدثني علي بن مسلم قال مات محمد بن أبي عبيدة بن معن بن عبد الرحمن بن عبد الله بن مسعود الهذلي الكوفى المسعودي سنة خمس ومائتين(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2699 - (@)(@@) حدثني إبراهيم بن بسطام قال مات سعيد بن سفيان سنة أربع أو خمس ومائتين وهو البصري وبلغني عن علي بن عبد الله قال ذهب حديثه(@)(@@)(@@)(@@) | 2700 - (@)(@@) ومات شجاع بن الوليد بن قيس السكوني أبو بدر الكوفي سكن بغداد سنة خمس ومائتين وقال غيره توفي شجاع سنة أربع(@)(@@)(@@)(@@) | 2701 - (@)(@@) مات عبد الملك بن إبراهيم أبو عبد الله مولى بني عبد الدار القرشي الجدي سنة أربع أو خمس ومائتين(@)(@@)(@@)(@@) | 2702 - (@)(@@) واسم العقدي عبد الملك بن عمرو البصري(@)(@@)(@@)(@@) | 2703 - (@)(@@) حدثني بن أبي بزة قال مات مؤمل سنة ست ومائتين في رمضان لسبع عشرة خلت يوم 
ms259	 الأحد وأما ابنه قال نحن من الصليبة من كنانة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2704 - (@)(@@) وحدثني من أثق به أنه مولى لبني بكر بن عبد مناة من كنانة وهو أبو عبد الرحمن بن إسماعيل البصري سكن مكة(@)(@@)(@@)(@@) | 2705 - (@)(@@) حدثني أحمد بن سعيد قال مات بشر بن عمر أبو محمد وعبد الصمد آخر سنة ست ومائتين وأول سنة سبع ومائتين(@)(@@)(@@)(@@) | 2706 - (@)(@@) حدثني حسن بن خلف قال مات يزيد بن هارون سنة ست ومائتين(@)(@@)(@@)(@@) | 2707 - (@)(@@) حدثني محمد بن المثني قال مات وهب بن جرير ويزيد بن هارون سنة ست ومائتين يقال مولى سليمان بن مجالد مولى أبى جعفر الهاشمي(@)(@@)(@@)(@@) | 2708 - (@)(@@) حدثني فضل بن يعقوب قال مات حجاج سنة خمس ومائتين ببغداد(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2709 - (@)(@@) قال أحمد مات حجاج بن محمد الأعور أبو محمد المصيصي أصله ترمذي سنة ست ومائتين(@)(@@)(@@)(@@) | 2710 - (@)(@@) ومات شبابة بن سوار الفزاري مولاهم المدائني أبو عمرو سنة ست ومائتين(@)(@@)(@@)(@@) | 2711 - (@)(@@) ومات عبد العزيز بن أبي رزمة واسم أبي رزمة غزوان أبو محمد مولى بني يشكر المروزي في المحرم سنة ست ومائتين(@)(@@)(@@)(@@) | 2712 - (@)(@@) كنية عبد الصمد بن عبد الوارث بن سعيد أبو سهل مولى بلعنبر البصري(@)(@@)(@@)(@@) | 2713 - (@)(@@) كنية بن وهب بن جرير بن حازم أبو العباس الأزدي البصري(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2714 - (@)(@@) وكنية يزيد بن هارون أبو خالد السلمي الواسطي ولد سنة ثمان عشرة ومائة(@)(@@)(@@)(@@) | 2715 - (@)(@@) حدثني هارون بن حميد قال مات يزيد سنة ست ومائتين ووهب بن جرير سنة سبع ومائتين(@)(@@)(@@)(@@) | 2716 - (@)(@@) حدثني عبد القدوس بن محمد البصري قال مات أبي محمد بن عبد الكبير بن شعيب بن الحبحاب المعوى الأزدي أبو عبد الله سنة ست ومائتين سمع عمه عبد السلام بن شعيب(@)(@@)(@@)(@@) | 2717 - (@)(@@) مات داود بن محبر أبو سليمان ببغداد سنة ست يوم الجمعة لثمان مضين من جمادى الأولى قال أحمد شبه لا شيء لا يدرى ما الحديث(@)(@@)(@@)(@@) | 2718 - (@)(@@) حدثني هارون بن عبد الله المدني قال مات عبد الله بن نافع الصائغ سنة ست أبو محمد المدني مولى بني مخزوم في حفظه شيء(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2719 - (@)(@@) مات جعفر بن عون 
ms260	 بن عمرو بن حريث المخزومي أبو عون القرشي بالكوفة سنة أربع ومائتين(@)(@@)(@@)(@@) | 2720 - (@)(@@) مات كثير بن هشام أبو سهل الكلابي الرقى بفم الصلح في شعبان سنة سبع ومائتين سكن بغداد(@)(@@)(@@)(@@) | 2721 - (@)(@@) حدثني هارون قال مات أبو غزية محمد بن موسى سنة سبع ومائتين هو بن مسكين عن بن أبي الزناد عنده مناكير(@)(@@)(@@)(@@) | 2722 - (@)(@@) كان يونس بن يحيى بن نباتة أبو نباتة المدني حيا سنة سبع ومائتين(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2723 - (@)(@@) مات محمد بن عمر الواقدي أبو عبد الله الأسلمي مدني قاضي بغداد تركوه سنة سبع ومائتين لثنتي عشرة مضين من ذي الحجة ببغداد(@)(@@)(@@)(@@) | 2724 - (@)(@@) ويقال مات أبو قتادة عبد الله بن واقد الحراني مولى بني حمان سنة سبع ومائتين سكتوا عنه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2725 - (@)(@@) ومات سهل بن حسان وهو بن أبى جلودية أبو يحيى البصري سنة سبع ومائتين في شعبان(@)(@@)(@@)(@@) | 2726 - (@)(@@) حدثني محمد بن عبد الله بن عبيد بن عقيل قال حدثنا جدي عبيد بن عقيل بن صبيح أبو عمرو الهلالي البصري سنة سبع ومائتين في شعبان سمع شعبة(@)(@@)(@@)(@@) | 2727 - (@)(@@) مات محمد بن القاسم أبو إبراهيم الأسدي كوفي بالكوفة سنة سبع ومائتين لأربع عشرة خلت من ربيع الآخر سنة ست كذبه أحمد(@)(@@)(@@)(@@) | 2728 - (@)(@@) مات عبد العزيز بن أبان أبو خالد القرشي لنصف من رجب ببغداد سنة سبع ومائتين تركه أحمد(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2729 - (@)(@@) يقال مات يونس بن محمد أبو محمد المعلم المؤدب البغدادي لسبع خلون من صفر سنة ثمان ومائتين ويقال سبع ومائتين أو قريبا منها(@)(@@)(@@)(@@) | 2730 - (@)(@@) وقال محمد بن عمر بن على سمعت سعيد بن عامر يقول ولدت سنة ثنتين وعشرين ومائة وأراه قال ومات وهو بن ست وثمانين وهو مولى بني عجيف وأخواله بن ضبيعة أبو محمد الضبعي البصري(@)(@@)(@@)(@@) | 2731 - (@)(@@) حدثني عبيد الله بن سعد قال مات يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف القرشي الزهري مدني أبو يوسف بالعراق سنة ثمان ومائتين(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2732 - (@)(@@) ومات الأسود بن عامر أبو عبد الرحمن ولقبه شاذان يقال أصله شامي أول سنة ثمان ومائتين 