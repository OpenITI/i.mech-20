ms1001	 يروي عن أبيه وجواب بن عبد الله ويزيد بن شريك روى عنه القاسم بن مالك المزني PageV06P311(@)(@@)(@@)(@@) $ 7874 - ركيح بن أبي عبيدة شيخ يروي عن أبيه عن أم سلمة قالت ربما صبغ رسول الله صلى الله عليه وسلم قميصه وإزاره ورداءه بزعفران وورس ثم يلبسه ويخرج فيه حدثنا عبد الله بن جابر بطرسوس ثنا محمد بن يزيد المستملي قال ثنا بن أبي فديك قال ثنا زكريا بن إبراهيم عن ركيح(@)(@@)(@@)(@@) $ 7875 - رافد شيخ يروي عن عكرمة روى عنه داود بن أبي هند(@)(@@)(@@)(@@) $ 7876 - رضراض شيخ يروي عن قيس بن ثعلبة عن عبد الله روى عنه أهل الكوفة(@)(@@)(@@)(@@) $ 7877 - رمح بن نفيل الكلابي من أهل الكوفة يروي عن الشعبي روى عنه مروان بن معاوية الفزاري وأبو أسامة(@)(@@)(@@)(@@) $ 7878 - رقيم بن الشابة يروى عن أبيه عن بن عباس عداده في أهل مكة روى عنه بن عيينة PageV06P312(@)(@@)(@@)(@@) || (باب الزاي)(@)(@@) قال أبو حاتم رضي الله عنه وممن روى عن التابعين ممن ابتدأ اسمه على الزاي(@)(@@)(@@)(@@) $ 7879 - زيد بن علي بن حسين بن علي بن أبي طالب يروي عن أبيه روى عنه ابنه حسين بن زيد وأهل الكوفة(@)(@@)(@@)(@@) $ 7880 - زيد بن واقد الدمشقي من أهل الشام يروي عن مكحول وبسر بن عبيد الله روى عنه يحيى بن حمزة وصدقة بن خالد يعتبر حديثه من غير رواية ابنه عبد الخالق بن زيد(@)(@@)(@@)(@@) $ 7881 - زيد بن أرطأة أخو عدي بن أرطأة الفزاري يروي عن جبير بن نفير عداده في أهل الشام روى عنه بن جابر والعلاء بن الحارث(@)(@@)(@@)(@@) $ 7882 - زيد بن الأخنس يروي عن سعيد بن المسيب روى عنه إسماعيل بن أمية(@)(@@)(@@)(@@) $ 7883 - زيد بن عبد الرحمن بن معمر بن حزم الأنصاري أخو أبى طوالة PageV06P313 يروي عن عبد الرحمن الأعرج روى عنه عبد الله بن أبي بكر بن محمد بن عمرو بن حزم(@)(@@)(@@)(@@) $ 7884 - زيد بن أيمن يروي عن عبادة بن نسي وأهل الشام روى عنه سعيد بن أبي هلال(@)(@@)(@@)(@@) $ 7885 - زيد بن الحباب يروي عن أبي سعيد 
ms1002	 مولى بني ليث عن أبي هريرة روى عنه صفوان بن سليم(@)(@@)(@@)(@@) $ 7886 - زيد بن الحسن القرشي من أهل الكوفة يروي عن معروف بن خربوذ روى عنه سعيد بن سليمان الواسطي(@)(@@)(@@)(@@) $ 7887 - زيد بن رفيع الجزري مولى أسماء بن خارجة من أهل نصيبين يروي عن أبي عبيدة بن عبد الله بن مسعود روى عنه معمر وأهل بلده وكان فقيها ورعا فاضلا PageV06P314(@)(@@)(@@)(@@) $ 7888 - زيد بن أبي أنيسة الجزري مولى لغني كان يسكن الرها يروي عن سعيد المقبري روى عنه مالك وأهل بلده مات سنة خمس وعشرين ومائة وهو بن ست وثلاثين سنة وكان فقيها ورعا وهو أخو يحيى بن أبي أنيسة يحيى ضعيف وهو ثقة(@)(@@)(@@)(@@) $ 7889 - زيد بن سلام بن أبي سلام الأسود أخو معاوية بن سلام من أهل دمشق يروي عن أبي سلام روى عنه يحيى بن أبي كثير(@)(@@)(@@)(@@) $ 7890 - زيد أبو رجاء الأحمسي يروي عن زاذان عن علي روى عنه راشد الصائغ(@)(@@)(@@)(@@) $ 7891 - زيد بن سويد الرقاشي يروي عن سعيد بن المسيب روى عنه هارون بن رئاب وابنه سويد بن زيد(@)(@@)(@@)(@@) $ 7892 - زيد السراج يروي عن أبي مجلز روى عنه المغيرة بن مسلم PageV06P315(@)(@@)(@@)(@@) $ 7893 - زيد بن عبد الرحمن بن سعيد بن زيد بن عمرو بن نفيل العدوي القرشي يروي المراسيل روى عنه عبد الله بن الحارث المخزومي(@)(@@)(@@)(@@) $ 7894 - زيد بن عطاء بن السائب يروي عن محمد بن المنكدر عن جابر عن النبي صلى الله عليه وسلم قال رحم الله رجلا كان فيكم سهلا إذا باع سهلا إذا اشترى سهلا إذا قضى سهلا إذا اقتضى روى عنه إسرائيل بن يونس(@)(@@)(@@)(@@) $ 7895 - زيد بن عبد الله بن أبي إسحاق يروي عن أبيه عن جده قال رأيت عليا بالبصرة وعليه عمامة سوداء من خز فأتيته فقلت أين تريد يا أمير المؤمنين قال شاعران يتهاجيان أفرق بينهما روى عنه يعقوب بن إسحاق الحضرمي(@)(@@)(@@)(@@) $ 7896 - زيد أبو عمرو يروي عن أم حيان روى عنه فضيل بن منبوذ(@)(@@)(@@)(@@) $ 7897 - زيد بن عبد الله بن معمر يروي 
ms1003	 عن عبد الرحمن الأعرج روى عنه عبد الله بن أبي بكر بن محمد بن عمرو بن حزم PageV06P316(@)(@@)(@@)(@@) $ 7898 - زيد أبو أسامة الحجام يروي عن عكرمة عداده في أهل الكوفة روى عنه أهلها ثنا بن قتيبة قال ثنا يزيد بن موهب قال ثنا أبو معاوية قال ثنا أبو أسامة عن عكرمة عن بن عباس قال لعن رسول الله صلى الله عليه وسلم المؤنثين من الرجال والمذكرات من النساء(@)(@@)(@@)(@@) $ 7899 - زيد بن حبان يروي عن الزهري روى عنه أبو نعيم(@)(@@)(@@)(@@) $ 7900 - زيد السلمي يروي عن أبي جعفر محمد بن علي روى عنه أبو عبد الله الجعفي(@)(@@)(@@)(@@) $ 7901 - زيد بن عبد الله بن أبي أمية يروي عن محمد بن كعب القرظي روى عنه محمد بن إسحاق(@)(@@)(@@)(@@) $ 7902 - زيد بن السائب أبو السائب يروي المقاطيع روى عنه زيد بن الحباب(@)(@@)(@@)(@@) $ 7903 - زيد بن عبد الحميد الخطابي من آل الخطاب يروي عن أهل المدينة وعمر بن عبد العزيز روى عنه الأوزاعي(@)(@@)(@@)(@@) $ 7904 - زيد بن معاوية العبسي من أهل الكوفة يروى عن علقمة والأسود PageV06P317 روى عنه أبو إسحاق السبيعي وابنه بشر بن زيد بن معاوية(@)(@@)(@@)(@@) $ 7905 - زيد بن مرة بن أبي ليلى أبو المعلى من أهل البصرة يروي عن الحسن روى عنه المعتمر بن سليمان وأبو داود(@)(@@)(@@)(@@) $ 7906 - زيد بن حيان مولى ربيعة من أهل البصرة يروي عن الحسن روى عنه الجزريون مات سنة ثمان وخمسين ومائة وهو أخو عمر بن حيان(@)(@@)(@@)(@@) $ 7907 - زيد بن المخارق يروي عن إبراهيم النخعي روى عنه سفيان الثوري(@)(@@)(@@)(@@) $ 7908 - زيد بن رباح من أهل المدينة يروي عن أبي عبد الله الأغر عن أبي هريرة روى عنه مالك بن أنس(@)(@@)(@@)(@@) $ 7909 - زيد بن نفيع يروي المراسيل روى عنه أسيد بن أبي أسيد(@)(@@)(@@)(@@) $ 7910 - زيد مولى بني هلال يروي عن الشاميين وعمر بن عبد العزيز روى عنه شعبة(@)(@@)(@@)(@@) $ 7911 - زيد بن صالح الأسدي من أهل خراسان يروي عن يحيى بن سعيد PageV06P318 الأنصاري روى عنه أهل بلده حدثني أبو بدر بحران قال ثنا 
ms1004	 زيد بن صالح الأسدي قال ثنا يحيى بن سعيد الأنصاري عن نافع عن بن عمر أنه طلق امرأته في زمن رسول الله صلى الله عليه وسلم وهي حائض وأن عمر ذكر ذلك لرسول الله صلى الله عليه وسلم فأمره أن يراجعها حتى تحيض ثم تطهر(@)(@@)(@@)(@@) $ 7912 - زيد أبو هاشم مولى بشر بن مالك بن سيار يروي عن مالك بن يسار روى عنه حسين بن حسن(@)(@@)(@@)(@@) $ 7913 - زياد بن خيثمة الجعفي من أهل الكوفة يروي عن أبي إسحاق روى عنه زهير بن معاوية وهشيم(@)(@@)(@@)(@@) $ 7914 - زياد بن حصين بن قيس اليربوعي أبو جهمة من أهل البصرة يروي عن أبي العالية عن بن عباس عن النبي صلى الله عليه وسلم قال ارموا بني إسماعيل فإن أباكم كان راميا روى عنه الأعمش وفطر بن خليفة(@)(@@)(@@)(@@) $ 7915 - زياد بن سعد الخراساني كنيته أبو عبد الرحمن سكن مكة وكان من الحفاظ المتقنين يروي عن الزهري وأبي الزبير روى عنه بن جريج ومالك وابن عيينة وكان زياد شريكا لابن جريج PageV06P319(@)(@@)(@@)(@@) $ 7916 - زياد بن الجعد بن أبي الجعد الأشجعي من أهل الكوفة يروي عن عبد الله بن أبي الجعد روى عنه ابنه نافع بن زياد(@)(@@)(@@)(@@) $ 7917 - زياد بن أبان من أهل البصرة يروي عن الحسن روى عنه إبراهيم بن طهمان(@)(@@)(@@)(@@) $ 7918 - زياد بن إسماعيل القرشي المكي يروي عن محمد بن عباد بن جعفر روى عنه بن جريج والثوري(@)(@@)(@@)(@@) $ 7919 - زياد بن أبي زياد الجصاص أبو محمد من أهل واسط يروي عن الحسن وابن سيرين روى عنه هشيم ويزيد بن هارون ربما وهم حدثنا أحمد بن علي بن المثنى قال ثنا عبد الله بن مطيع قال ثنا هشيم عن زياد بن أبي زياد عن الحسن بن أبي الحسن عن قيس بن عاصم قال أتيت النبي صلى الله عليه وسلم فلما دنوت منه سمعته يقول هذا سيد أهل الوبر فسلمت عليه ثم قلت يا رسول الله المال الذي لا يكون علي فيه تبعة من ضيف أضافني أو عيال إذا 
ms1005	 كثر PageV06P320 فقال نعم المال الأربعون من الإبل والأكثر ستون وويل لأصحاب المئين إلا من أعطى في رسلها ونجدتها وأفقر ظهرها وأطرق فحلها ونحر سمينها وأطعم القانع والمعتر قلت يا رسول الله ما أكرم هذه الأخلاق وأحسنها أنه لا يحل بالوادي الذي أنا فيه أكثر من إبلي قال فكيف تصنع بالمنيحة قال قلت إني لأمنح في كل عام مائة قال وكيف تصنع بالعارية قال يغدو الإبل ويغدو الناس فمن أخذ برأس بعير ذهب به قال فكيف تصنع بالإفقار قال إني لأفقر البكر الضرع والناب المدبر قال فمالك أحب إليك أو مال مولاك قال قلت بل مالي قال فإنما لك من مالك ما أكلت فأفنيت ولبست فأبليت وأعطيت فأمضيت وما بقي فلمولاك قلت لمولاي قال نعم قال أما والله لئن بقيت لأدعن عدتها قليلا قال الحسن ففعل PageV06P321 رحمه الله فلما حضرته الوفاة دعا بنيه فقال يا بني خذوا عني فلا أحد أنصح لكم مني إذا أنا مت فسودوا كباركم ولا تسودوا صغاركم فتستسفه الناس كباركم ويهونوا عليهم وعليكم باستصلاح المال فإنه منبهة للكريم ويستغنى به عن اللئيم وإياكم والمسألة فإنها آخر كسب الرجل إن أحدا لم يسأل إلا بترك كسبه وإذا أنا مت فلفوني في ثيابي الذي كنت أصلي فيها وأصوم وإياكم والنياحة فإني سمعت رسول الله صلى الله عليه وسلم ينهي عنها وادفنوني في مكان لا يعلم به أحد فإنه قد كانت بيننا وبين بكر بن وائل خماشات في الجاهلية فأخاف أن يدخلوها عليكم في الإسلام فيعيبوا عليكم دينكم قال الحسن نصحا في الحياة ونصحا في الممات(@)(@@)(@@)(@@) $ 7920 - زياد الأعلم الباهلي من أهل البصرة يروى عن الحسن روى PageV06P322 عنه الحمادان وأهل البصرة(@)(@@)(@@)(@@) $ 7921 - زياد بن أبي حبيب قوله روى عنه صخر بن عبد الله(@)(@@)(@@)(@@) $ 7922 - زياد بن ثور يروي المراسيل روى عنه عبد الرحمن بن عمرو الأوزاعي(@)(@@)(@@)(@@) $ 7923 - زياد أبو بشر يروي عن الحسن روى عنه موسى بن عقبة(@)(@@)(@@)(@@) $ 7924 - زياد بن حصين بن أوس النهشلي يروي عن أبيه روى عنه 
ms1006	 أهل العراق(@)(@@)(@@)(@@) $ 7925 - زياد بن الجراح مولى عثمان يروي عن عمرو بن ميمون وعبد الله بن معقل روى عنه جعفر بن برقان وعبد الكريم الجزريان(@)(@@)(@@)(@@) $ 7926 - زياد بن رياح أبو رياح يروي عن الحسن روى عنه حكام الهذلي(@)(@@)(@@)(@@) $ 7927 - زياد بن سعد المدني الأنصاري يروى عن أبيه عن بن عمر روى عنه ابنه سعيد بن زياد بن سعد الأنصاري PageV06P323(@)(@@)(@@)(@@) $ 7928 - زياد بن رياح أبو قيس يروي عن الحسن روى عنه غيلان بن جرير أحسبه الأول(@)(@@)(@@)(@@) $ 7929 - زياد بن سلم بن زياد بن أبي سفيان الزيادي كنيته أبو المغيرة يروي عن إبراهيم بن جرير وإسحاق بن عبد الله بن الحارث(@)(@@)(@@)(@@) $ 7930 - زياد بن عراق يروي عن طيسلة بن على الهذلى عن بن عمر روى عنه إسماعيل بن علية في الكبائر السبع(@)(@@)(@@)(@@) $ 7931 - زياد بن راشد أبو سفيان المدني الكاتب يروي عن داود بن فراهيج روى عنه علي بن المديني والناس وهو مولى محمد بن مسلم بن شهاب الزهري(@)(@@)(@@)(@@) $ 7932 - زياد بن الشيخ الصنعاني يروي عن عطاء روى عنه يحيى بن عمير(@)(@@)(@@)(@@) $ 7933 - زياد بن أبي هارون الحنفي من أهل الكوفة يروي عن عمرو PageV06P324 بن مرة وقيس بن مسلم روى عنه زيد بن الحباب(@)(@@)(@@)(@@) $ 7934 - زياد بن الربيع اليحمدي الأزدي من أهل البصرة كنيته أبو خداش يروي عن ثابت البناني روى عنه أهل البصرة مات سنة خمس وثمانين ومائة(@)(@@)(@@)(@@) $ 7935 - زياد بن عبد الرحمن يروي عن بن سيرين روى عنه عبد الواحد بن واصل(@)(@@)(@@)(@@) $ 7936 - زياد بن أبي زياد أبو شعيب يروي عن أبي حكيم روى عنه عبد الله بن المبارك(@)(@@)(@@)(@@) $ 7937 - زياد بن عباد يروي عن كعب روى عنه الضحاك بن يسار(@)(@@)(@@)(@@) $ 7938 - زياد بن صيفي بن صهيب بن سنان مولى بن جدعان التيمي يروي عن أبيه روى عنه ابنه عبد الحميد بن زياد(@)(@@)(@@)(@@) $ 7939 - زياد مولى عبد الله يروي عن أم ولد لعبد الله أحسبه بن مسعود روى عنه أبو إسحاق السبيعي(@)(@@)(@@)(@@) $ 7940 - زياد بن ضميرة بن سعد الضمري من 
ms1007	 أهل الحجاز ويقال بن ضمرة يروي عن الحجازيين روى عنه أهل بلده(@)(@@)(@@)(@@) $ 7941 - زياد بن عبد الله البلوي يروي عن بن سندر روى عنه سعيد PageV06P325 بن أبي أيوب(@)(@@)(@@)(@@) $ 7942 - زياد مولى عبيد بن عمير الليثي من أهل مكة يروي عن عمرو بن دينار والقاسم بن أبي بزة روى عنه عبد الله بن عبيد بن عمير(@)(@@)(@@)(@@) $ 7943 - زياد بن عمرو بن هند الجملي من أهل الكوفة يروي عن عمران بن حذيفة عن ميمونة روى عنه منصور بن المعتمر(@)(@@)(@@)(@@) $ 7944 - زياد بن عمرو أبو سحابة يروي عن شعيب بن محمد بن عبد الله روى عنه حيوة بن شريح(@)(@@)(@@)(@@) $ 7945 - زياد بن عثمان يروي عن عباد بن زياد روى عنه الحجاج بن الحجاج الأسلمي(@)(@@)(@@)(@@) $ 7946 - زياد بن المنذر يروي عن نافع بن الحارث عن أبى بردة PageV06P326 روى عنه يونس بن بكير(@)(@@)(@@)(@@) $ 7947 - زياد بن عميرة الصيرفي يروي عن مولى لعائشة روى الليث بن سعد عن أبي هانئ عنه(@)(@@)(@@)(@@) $ 7948 - زياد بن كليب أبو معشر النخعي من أهل الكوفة يروي عن الشعبي وإبراهيم النخعي روى عنه يونس بن عبيد وخالد الحذاء وشعبة وكان من الحفاظ المتقنين مات سنة سبع عشرة ومائة(@)(@@)(@@)(@@) $ 7949 - زياد بن أبي عثمان الحنفي يروي عن الحسن وعكرمة روى عنه عبد الصمد بن عبد الوارث(@)(@@)(@@)(@@) $ 7950 - زياد مولى قيس الحذاء يروي عن عكرمة روى عنه أبو مودود PageV06P327(@)(@@)(@@)(@@) $ 7951 - زياد بن أبي زياد مولى بن عياش من أهل المدينة يروي عن عراك بن مالك روى عنه بن الهاد(@)(@@)(@@)(@@) $ 7952 - زياد أبو العلاء يروي عن الحسن روى عنه هشيم بن بشير وليس هذا بأبي العلاء الثقفي(@)(@@)(@@)(@@) $ 7953 - زياد بن فياض أبو الحسن الخزاعي من أهل الكوفة يروي عن أبي عياض وعبد الرحمن بن أنعم والهزهاز بن ميزن روى عنه الثوري وشعبة مات سنة تسع وعشرين ومائة(@)(@@)(@@)(@@) $ 7954 - زياد بن جبير بن حية يروي عن أبيه عن المغيرة بن شعبة روى عنه أهل العراق المبارك بن فضالة وغيره(@)(@@)(@@)(@@) $ 7955 - زياد المصفر مولى مصعب كنيته 
ms1008	 أبو عثمان يروي عن الحسن روى عنه الثوري حدثنا أبو خليفة قال ثنا علي بن المديني ثنا وكيع عن سفيان عن زياد المصفر عن الحسن عن بن مسعود قال وسط كل في الركوع والسجود عشر تسبيحات PageV06P328(@)(@@)(@@)(@@) $ 7956 - زياد مولى محمد بن سيرين يروي عن محمد بن سيرين وكان خادمه روى عنه حماد بن زيد(@)(@@)(@@)(@@) $ 7957 - زياد بن مخراق كنيته أبو الحارث من أهل البصرة يروي عن معاوية بن قرة روى عنه إسماعيل بن علية وأهل البصرة(@)(@@)(@@)(@@) $ 7958 - زياد بن أبي مسلم من أهل البصرة كنيته أبو عمر يروي عن صالح أبي الخليل روى عنه وكيع وأبو نعيم وكان من عباد أهل البصرة(@)(@@)(@@)(@@) $ 7959 - زياد بن سوقة شيخ من أهل المدينة يروي عن أبي الزبير روى عنه المنذر بن جهم قليل الحديث فيما لا يتابع عليه وقد وهم من زعم أنه أخو محمد بن سوقة محمد لا أخ له وهو كوفي وهذا مدني(@)(@@)(@@)(@@) $ 7960 - زياد بن عبد الله بن الربيع يروي عن حميد الطويل روى عنه البصريون(@)(@@)(@@)(@@) $ 7961 - زياد بن مسلم يروي عن أهل المدينة وعمر بن عبد العزيز روى عنه معمر بن راشد(@)(@@)(@@)(@@) $ 7962 - زياد مولى معيقيب يروي المراسيل PageV06P329 روى عنه سعيد بن أبي أيوب(@)(@@)(@@)(@@) $ 7963 - زياد بن مالك أبو السكينة من أهل الشام يروي المراسيل روى عنه أبو بكر بن أبي مريم(@)(@@)(@@)(@@) $ 7964 - زياد بن نعيم الحضرمي من أهل مصر يروي عن مسلم بن يسار روى عنه أهل بلده(@)(@@)(@@)(@@) $ 7965 - زياد بن نافع يروي عن كعب الأحبار روى عنه بكر بن سوادة(@)(@@)(@@)(@@) $ 7966 - زياد بن نصر من أهل وادى القرى يروي عن سليم بن مطير روى عنه عبد الرحمن بن شيبة(@)(@@)(@@)(@@) $ 7967 - زياد أبو هشام مولى عثمان بن عفان يروي عن محجن روى عنه ابنه هشام بن زياد(@)(@@)(@@)(@@) $ 7968 - زياد شيخ يروي عن زر عن بن مسعود روى عنه إسماعيل السدي ولا أدري من هو PageV06P330(@)(@@)(@@)(@@) $ 7969 - زياد بن محمد بن زيد بن عبد الله بن عمر بن الخطاب أخو 
ms1009	 واقد وعمر وعاصم وأبي بكر بني محمد بن زيد من أهل المدينة يروي عن أبيه ونافع روى عنه شعبة وعمار بن زريق(@)(@@)(@@)(@@) $ 7970 - الزبير بن عثمان بن عبد الله بن سراقة بن مالك القرشي من بني عدي بن كعب يروي عن محمد بن عبد الرحمن بن ثوبان روى عنه موسى بن يعقوب الزمعي قتل سنة إحدى أو ثنتين وثلاثين ومائة(@)(@@)(@@)(@@) $ 7971 - الزبير بن هشام بن عروة بن الزبير أخو محمد بن هشام يروي عن أبيه وأبوه رأى بن عمر ويروي عن أهل المدينة روى عنه نافع بن يزيد ومن قال الزبير بن عروة فقد نسبه إلى جده(@)(@@)(@@)(@@) $ 7972 - الزبير بن خبيب بن ثابت بن عبد الله بن الزبير بن العوام يروي عن نافع ومحمد بن عباد بن جعفر روى عنه معن بن عيسى القزاز(@)(@@)(@@)(@@) $ 7973 - الزبير بن عيسى والد الحميدي يروي عن هشام بن عروة روى سلمة بن شبيب عن الخليل بن يزيد عنه(@)(@@)(@@)(@@) $ 7974 - الزبير بن عباد بن حمزة بن الزبير بن العوام يروى عن المدنيين PageV06P331 روى عنه ابنه يحيى بن الزبير(@)(@@)(@@)(@@) $ 7975 - الزبير بن موسى بن ميناء يروي عن المدنيين وعمر بن عبد العزيز روى عنه المطلب بن كثير(@)(@@)(@@)(@@) $ 7976 - الزبير بن السائب الثقفي يروي عن عبيد بن عمير روى عنه عكرمة بن عمار(@)(@@)(@@)(@@) $ 7977 - الزبير بن خريت من أهل البصرة يروي عن عكرمة روى عنه حماد بن زيد وجرير بن حازم ثنا أبو خليفة قال ثنا علي بن المديني قال ثنا حماد بن زيد قال ثنا الزبير بن خريت عن عكرمة في الرجل يحلق رأسه يوم النحر قال كان لا يرى به بأسا بأن يغسله بالخطمي ثم يحلقه(@)(@@)(@@)(@@) $ 7978 - الزبير بن عبيد يروي عن نافع ولست أدري من نافع هذا روى عنه مخلد والد أبي عاصم النبيل(@)(@@)(@@)(@@) $ 7979 - الزبير بن عبد الله بن رهيمة من أهل المدينة يروي عن القاسم ونافع روى عنه العقدي وابن المبارك وهو الذي يروي عن جدته رهيمة خادم عثمان بن عفان PageV06P332(@)(@@)(@@)(@@) $ 7980 
ms1010	 - الزبير بن سعيد بن سليمان بن نوفل بن الحارث بن عبد المطلب أمه حمادة بنت يعقوب بن سعيد بن نوفل بن الحارث بن عبد المطلب مات في ولاية أبي جعفر وهو يروي عن صفوان بن سليم وقد أدرك بن المبارك الزبير هذا وروى عنه ويروي عن عبد الله بن علي بن يزيد بن ركانة عن جده أنه طلق امرأته البتة الحديث(@)(@@)(@@)(@@) $ 7981 - الزبير أبو عبد السلام يروي عن أيوب بن عبد الله بن مكرز عن وابصة بن معبد روى عنه حماد بن سلمة(@)(@@)(@@)(@@) $ 7982 - الزبير أبو خالد شيخ يروي عن أبان بن عثمان روى عنه حماد بن سلمة(@)(@@)(@@)(@@) $ 7983 - الزبير بن جنادة أبو عبد الله الهجري المعلم سكن مرو يروي عن عطاء وابن بريدة روى عنه عيسى بن يونس وأبو تميلة وهو الذي يروي عن عطاء أنه سئل عن رجل فقئت عينه ليس له عين غيرها قال إن كانت عيينة أصيبت في سبيل الله فديتها PageV06P333 كاملة وإلا فالنصف رواه عنه أبو تميلة(@)(@@)(@@)(@@) $ 7984 - الزبير بن خزيمة يروي عن أبيه عن عبد الله بن مسعود روى عنه محمد بن قيس الأسدي(@)(@@)(@@)(@@) $ 7985 - الزبير بن خزيمة الخثعمي قوله روى عنه الوليد بن عبد الرحمن بن عمرو بن مسافع وهو الذي يقال له بن خزيمة(@)(@@)(@@)(@@) $ 7986 - الزبير بن الشعشاع يروي عن أبيه عن علي روى عنه طلحة بن حسين الليثي(@)(@@)(@@)(@@) $ 7987 - الزبير بن نجيح بن مغلس أبو المغلس يروي عن عمر بن عبد العزيز وأهل الشام روى عنه الحسين بن علي الجعفي(@)(@@)(@@)(@@) $ 7988 - زكريا بن أبي زائدة الهمداني الأعمى كنيته أبو يحيى واسم أبي زائدة فيروز وقد قيل خالد من أهل الكوفة يروي عن الشعبي وأبي إسحاق روى عنه الثوري ووكيع وابنه يحيى بن زكريا مات سنة ثمان أو تسع وأربعين ومائة(@)(@@)(@@)(@@) $ 7989 - زكريا بن يحيى بن عمارة أبو يحيى الذراع من أهل البصرة PageV06P334 يروي عن عبد العزيز بن صهيب روى عنه أهل بلده مات سنة سبع وثمانين ومائة يخطىء(@)(@@)(@@)(@@) $ 7990 - زكريا بن 
ms1011	 يحيى الكندي الأعمى يروي عن الشعبي وعكرمة عداده في أهل الكوفة روى عنه أبو أسامة وجعفر بن عون(@)(@@)(@@)(@@) $ 7991 - زكريا شيخ كان بالري يروي عن أبي وائل روى عنه الثوري(@)(@@)(@@)(@@) $ 7992 - زكريا شيخ يروي عن القاسم روى عنه المسعودي(@)(@@)(@@)(@@) $ 7993 - زكريا بن أبي العتيك وهو الذي يقال له زكريا بن حكيم يروي عن أبي جعفر والشعبي روى عنه هشيم والمغيرة بن سليمان(@)(@@)(@@)(@@) $ 7994 - زكريا بن عمر يروي عن عطاء روى عنه بن جريج وأحسبه الذي روى عنه منصور بن المعتمر(@)(@@)(@@)(@@) $ 7995 - زكريا بن صهيب يروي عن أبي صالح روى عنه الثوري(@)(@@)(@@)(@@) $ 7996 - زكريا بن حكيم يروي عن الحسن روى عنه عنبسة بن عبد الواحد(@)(@@)(@@)(@@) $ 7997 - زكريا بن خالد يروي عن الزهري روى عنه عنبسة الرازي PageV06P335(@)(@@)(@@)(@@) $ 7998 - زكريا بن سياه أبو يحيى من أهل الكوفة يروي عن عمران بن مسلم روى عنه أبو أسامة(@)(@@)(@@)(@@) $ 7999 - زكريا بن خالد بن زيد بن حارثة الأنصاري يروي المراسيل روى عنه مجمع بن يعقوب المدني(@)(@@)(@@)(@@) $ 8000 - زكريا بن إسحاق المكي يروي عن عمرو بن دينار ويحيى بن عبد الله بن صيفي روى عنه بن المبارك وأبو عاصم النبيل(@)(@@)(@@)(@@) $ 8001 - زكريا بن جراد يروي عن عبد الرحمن السلمي روى عنه موسى بن قيس الكوفي(@)(@@)(@@)(@@) $ 8002 - زكريا بن مازن الهذلي يروي عن الحسن روى عنه عبد الصمد بن عبد الوارث(@)(@@)(@@)(@@) $ 8003 - زكريا بن يحيى بن أبي الحواجب من أهل الكوفة يروي عن الأعمش والكوفيين روى عنه أبو حاتم السجستاني ربما أخطأ(@)(@@)(@@)(@@) $ 8004 - زهير بن سالم العبسي أبو المخارق يروي عن الحارث بن أنعم PageV06P336 روى عنه ثور بن يزيد وصفوان بن عمرو السكسكي(@)(@@)(@@)(@@) $ 8005 - زهير بن أبي ثابت الأسدي الأعمى كنيته أبو الأزهر وهو الذي يقال له زهير بن حبيب العبسي يروي عن سليم بن زافر روى عنه الأجلح(@)(@@)(@@)(@@) $ 8006 - زهير بن قيس البلوي من أهل مصر يروي عن علقمة بن رمثة روى عنه سويد بن قيس(@)(@@)(@@)(@@) $ 8007 - زهير بن محمد العنبري أصله من خراسان سكن الشام كنيته 
ms1012	 أبو المنذر يروي عن زيد بن أسلم وهشام بن عروة روى عنه عبد الرحمن بن مهدي وأبو عامر العقدي يخطىء ويخالف(@)(@@)(@@)(@@) $ 8008 - زهير بن معاوية بن الرحيل الجعفي كنيته أبو خيثمة من أهل الكوفة سكن الجزيرة يروي عن أبي إسحاق وأبي الزبير روى عنه يحيى بن آدم وأبو نعيم مات سنة ثلاث أو أربع وسبعين ومائة في رجب وكان حافظا متقنا وكان أهل العراق يقولون في أيام الثوري إذا مات الثوري ففي زهير خلف وكانوا يقدمونه في الإتقان على غيره من أقرانه PageV06P337(@)(@@)(@@)(@@) $ 8009 - زهير بن مالك أبو الوازع يروي عن عاصم بن ضمرة عداده في أهل الكوفة روى عنه إسرائيل(@)(@@)(@@)(@@) $ 8010 - زهير بن هنيد أبو الذيال العدوي من أهل البصرة يروي عن أبي نعامة روى عنه عبيد الله بن عمر القواريري(@)(@@)(@@)(@@) $ 8011 - زفر بن صعصعة بن مالك يروي عن أبيه عن أبي هريرة روى عنه إسحاق بن عبد الله بن أبي طلحة(@)(@@)(@@)(@@) $ 8012 - زفر بن عقيل يروي عن سعدى بنت الحارث امرأة طلحة بن عبيد الله روى عنه بكير بن الأشج(@)(@@)(@@)(@@) $ 8013 - زفر بن أبي كثير السحيمي من أهل اليمامة يروي عن أبيه واسم أبي كثير يزيد بن عبد الرحمن روى عنه ملازم بن عمرو(@)(@@)(@@)(@@) $ 8014 - زفر بن عاصم يروي عن أهل المدينة وعمر بن عبد العزيز روى عنه مالك بن أنس PageV06P338(@)(@@)(@@)(@@) $ 8015 - زفر بن الهذيل بن قيس من بلعنبر كنيته أبو الهذيل الكوفي وكان من أصحاب أبي حنيفة يروي عن يحيى بن سعيد الأنصاري روى عنه شداد بن حكيم البلخي وأهل الكوفة وكان زفر متقنا حافظا قليل الخطأ لم يسلك مسلك صاحبه في قلة التيقظ في الروايات وكان أقيس أصحابه وأكثرهم رجوعا إلى الحق إذا لاح له ومات بالبصرة وكان أبوه من أصبهان وكان موته في ولاية أبي جعفر(@)(@@)(@@)(@@) $ 8016 - زائدة بن عمران الجعفي من أهل الكوفة يروي عن سويد بن غفلة روى عنه أهل الكوفة(@)(@@)(@@)(@@) $ 8017 - زائدة بن أوس الكندي يروي عن أبي عبد الرحمن بن أبزى روى 
ms1013	 عنه أبو فروة(@)(@@)(@@)(@@) $ 8018 - زائدة بن نشيط يروي عن أبي خالد الوالبي روى عنه ابنه عمران بن زائدة وأهل العراق(@)(@@)(@@)(@@) $ 8019 - زائدة بن قدامة الثقفي من أهل الكوفة كنيته أبو الصلت PageV06P339 يروي عن أبي إسحاق ومنصور روى عنه أبو أسامة وأهل العراق وكان من الحفاظ المتقنين وكان لا يعد السماع حتى يسمعه ثلاث مرات وكان لا يحدث أحدا حتى يشهد عنده عدل أنه من أهل مات سنة إحدى وستين ومائة(@)(@@)(@@)(@@) $ 8020 - زائدة بياع الثياب يروي عن الحسن روى عنه شعبة بن الحجاج(@)(@@)(@@)(@@) $ 8021 - الزبرقان بن عبد الله بن عمرو بن أمية الضمري يروي عن أبي سلمة بن عبد الرحمن روى عنه بن أبي ذئب وعمرو بن أبي حكيم وقد وهم من زعم إنه سمع من زيد بن ثابت بينه وبين زيد في خبره عروة بن الزبير(@)(@@)(@@)(@@) $ 8022 - الزبرقان بن عبد الله العبدي من أهل الكوفة كنيته أبو الزرقاء يروي عن كعب بن عبد الله روى عنه الثوري وإسرائيل PageV06P340(@)(@@)(@@)(@@) $ 8023 - الزبرقان بن عبد الله الأسدي السراج من أهل الكوفة كنيته أبو بكر يروي عن أبي وائل وأبي رزين روى عنه يحيى القطان وأبو أسامة وهو الذي قال نهاني أبو وائل أن أجالس أصحاب أرأيت أرأيت(@)(@@)(@@)(@@) $ 8024 - الزبرقان بن الحارث النميري يروي عن الأحنف بن قيس روى عنه شريك بن الخطاب(@)(@@)(@@)(@@) $ 8025 - الزبرقان بن بشير بن عمرو الشيباني كنيته أبو قيس يروي عن زيد بن وهب روى عنه العوام بن حوشب وقد قيل بن يسير بن عمرو(@)(@@)(@@)(@@) $ 8026 - زبيد بن الحارث الأيامى من أهل الكوفة كنيته أبو عبد الرحمن يروي عن أبي وائل ومرة روى عنه منصور والثوري مات سنة ثنين وعشرين ومائة وكان من العباد الخشن مع الفقه في الدين ولزوم الورع الشديد(@)(@@)(@@)(@@) $ 8027 - زنكل شيخ يروي عن أبي عبيدة بن عبد الله بن مسعود عن PageV06P341 أبيه قال إن من خير أخلاق الدنيا والآخرة من رجى خيره وأمن شره ومن شر أخلاق الدنيا والآخرة من لم يرج خيره ولم يؤمن شره 
ms1014	 كيف أنتم إذا غشيتكم فتنة ينشأ فيها الصغير ويربو فيها الكبير قيل هذا منكر فمتى ذلك يا أبا عبد الرحمن قال إذا كثرت أمراؤكم وقلت أمناؤكم وكثرت قراءكم والتمس الدنيا بعمل الآخرة وتفقه لغير الله حدثنا الحسن بن سفيان قال ثنا سعيد بن حفص النفيلي قال ثنا محمد بن سلمة عن أبي عبد الرحمن عن زيد بن أبي أنيسة عن الأعمش عن زنكل عن أبي عبيدة عن أبيه(@)(@@)(@@)(@@) $ 8028 - زنكل بن علي بن محجن أبو فزارة يروي عن جماعة من التابعين روى عنه أهل الجزيرة(@)(@@)(@@)(@@) $ 8029 - زرارة بن مصعب الشني يروي عن الحارث بن خالد بن العاص عن عائشة لولا حداثة قومك بالكفر الحديث روى عنه ابنه عبد الله بن زرارة(@)(@@)(@@)(@@) $ 8030 - زرارة بن عبد الله بن أسيد يروي عن سعيد بن المسيب PageV06P342 روى عنه الحكم بن أبي نعم(@)(@@)(@@)(@@) $ 8031 - زرارة بن ربيعة العتكي الأزدي كنيته أبو ربيعة من أهل البصرة وهو الذي يقال له زرارة بن أبي الحلال العتكي أخو الحلال بن أبي الحلال واسم أبي الحلال ربيعة يروي عن أبيه ومجاهد روى عنه أهل البصرة(@)(@@)(@@)(@@) $ 8032 - زرعة بن معبد بن عبد الله بن ليث بن بكر يروي عن جماعة بن التابعين روى عنه أهل فلسطين(@)(@@)(@@)(@@) $ 8033 - زرعة بن عبد الله البياضي وقيل زرعة بن عبد الرحمن الأنصاري يروي عن مولى لمعمر التيمي عن أسماء بنت عميس روى عنه يزيد بن زياد القرظي(@)(@@)(@@)(@@) $ 8034 - زرعة بن إبراهيم الدمشقي الزبيدي يروي عن عطاء وخالد بن اللجلاج روى عنه سعيد بن أبي هلال ومحمد بن شعيب بن شابور وهو PageV06P343 الذي روى عنه بقية ويقول حدثني الزبيدي في أشياء يرويها يوهم أنه محمد بن الوليد بن عمار الزبيدي يجب أن يعتبر بحديثه من غير رواية بقية عنه(@)(@@)(@@)(@@) $ 8035 - زرعة بن عمرو يروي المراسيل وكان أبوه عمرو أحد الأربعة الذين حملوا عثمان بن عفان يوم أصيب روى عنه خالد بن يزيد القرشي(@)(@@)(@@)(@@) $ 8036 - زهرة بن معبد أبو عقيل القرشي يروى عن بن المسيب 
ms1015	 وجده عبد الله بن هشام روى عنه حيوة بن شريح وسعيد بن أبي أيوب يخطىء ويخطأ عليه وقد قيل إنه من التابعين وهو ممن استخير الله فيه(@)(@@)(@@)(@@) $ 8037 - زهرة بن عمرو بن منقذ التيمي من أهل الحجاز يروي عن أبي حازم والوليد بن عمرو روى عنه عبد العزيز بن عبد الله الأويسي والناس حدثنا أبو يعلى قال ثنا داود بن عمرو الضمري الضبي قال ثنا زهرة بن عمرو بن منقذ التيمي عن PageV06P344 أبي حازم عن سهل بن سعد قال قال رسول الله صلى الله عليه وسلم قيد شوط من الجنة خير من الدنيا وما فيها وغدوة أو روحة خير من الدنيا وما فيها(@)(@@)(@@)(@@) $ 8038 - زحر بن الحسن الحضرمي من أهل الكوفة يروي عن عبد العزيز بن حكيم روى عنه بن المبارك ووكيع(@)(@@)(@@)(@@) $ 8039 - زامل بن عمرو السكسكي من أهل الشام يروي عن عريب الحبراني روى عنه الزبيدي وسعيد بن أبي هلال(@)(@@)(@@)(@@) $ 8040 - أبو عمرو بن العلاء صاحب القراءات اسمه زبان بن العلاء بن عمار بن حصين بن حليم بن مازن بن خزاعي من أهل البصرة وهم إخوة أربعة أبو عمرو وأبو سفيان ومعاذ وعمر فأكبرهم سنا أبو عمرو ثم أبو سفيان وكان يقال لأبي سفيان سنسن ثم معاذ ثم عمر PageV06P345 فأما أبو عمرو فله نحو خمسين حديثا فأما أبو سفيان فما له إلا حديثا واحدا عن الحسن عن عبد الله بن المغفل لولا أن الكلاب أمة من الأمم لأمرت بقتلها حدثنا أبو خليفة قال ثنا محمد بن سلام الجمحي قال ثنا سعيد بن عبيد قال كنا في جنازة أبي سفيان ومعنا شعبة فقال شعبة حدثني صاحب هذه الجنازة قال قلت للحسن من حدثك أن النبي صلى الله عليه وسلم قال لولا أن الكلاب أمة من الأمم لأمرت بقتلها فقال حدثني والله الذي لا إله إلا هو عبد الله بن المغفل في هذا المسجد وأومأ إلى مسجد الجامع بالبصرة وأما معاذ بن العلاء فلست أحفظ له إلا حديثين حديث الجوع وحديث 
ms1016	 الغسل يوم الجمعة رواهما جميعا عن نافع عن بن عمر وعمر بن العلاء لا حديث له ومات أبو عمرو بن العلاء في طريق الشام سنة أربع وخمسين ومائة وله بالبصرة عقب وفي PageV06P346 أبي عمرو يقول الفرزدق (@)(@@) ما زلت أفتح أبوابا وأغلقها %~% حتى رأيت أبا عمرو بن عمار(@)(@@)(@@)(@@) $ 8041 - زبان بن عبد العزيز بن مروان بن الحكم أخو عمر بن عبد العزيز يروي المراسيل روى عنه الليث بن سعد وأسامة بن زيد(@)(@@)(@@)(@@) $ 8042 - زبان بن يحيى بن الجزار يروي عن أبيه عن بن مسعود روى عنه محمد بن سيرين(@)(@@)(@@)(@@) $ 8043 - زبان بن نزار يروي عن خالد بن يزيد الجمحي روى عنه خالد بن حيان(@)(@@)(@@)(@@) $ 8044 - زريق بن حكيم الأيلي يروي عن جماعة من التابعين روى عنه أهل الحجاز وأهل الشام(@)(@@)(@@)(@@) $ 8045 - زميل بن عباس مولى عروة بن الزبير يروي عن عروة بن الزبير روى عنه بن الهاد(@)(@@)(@@)(@@) $ 8046 - زنجي بن خالد بن الحويرث القرشي يروي عن أبيه روى عنه PageV06P347 أبو عبيدة الحداد واسم أبي عبيدة عبد الواحد بن واصل(@)(@@)(@@)(@@) $ 8047 - زرزر بن صهيب مولى لآل جبير بن مطعم من أهل الحجاز كان يسكن بشرجة يروي عن عطاء روى عنه بن عيينة(@)(@@)(@@)(@@) $ 8048 - زريك بن أبي زريك بصري كنيته أبو نضر ويقال أبو نضرة يروي عن عطاء والحسن وابن سيرين روى عنه أهل البصرة(@)(@@)(@@)(@@) $ 8049 - زرد البصري العمى يروي عن عمرو بن قدامة روى عنه موسى بن إسماعيل(@)(@@)(@@)(@@) $ 8050 - زجلة قال حججت مع عبد الله بن أبي زكريا روى عنه صدقة بن خالد الدمشقي(@)(@@)(@@)(@@) || (باب السين)(@)(@@) قال أبو حاتم رضي الله عنه وممن روى عن التابعين ممن ابتدأ اسمه على السين(@)(@@)(@@)(@@) $ 8051 - سعيد بن أبان بن سعيد بن العاص القرشي الأموي والد يحيى PageV06P348 وعبد الله وعنبسة عداده في أهل الكوفة يروي عن معاوية بن إسحاق وأهل الكوفة وكان صديقا لعمر بن عبد العزيز روى عنه ابناه يحيى وعبد الله وكان سعيد من خيار عباد الله من أفاضل أهل بيته(@)(@@)(@@)(@@) $ 8052 - سعيد بن 
ms1017	 عبد الرحمن بن حسان بن ثابت الأنصاري يروي عن أبيه روى عنه أهل المدينة وكان شاعرا(@)(@@)(@@)(@@) $ 8053 - سعيد بن خالد بن عمرو بن عثمان كنيته أبو عثمان يروي عن عروة بن الزبير وقبيصة بن ذؤيب روى عنه الزهري(@)(@@)(@@)(@@) $ 8054 - سعيد بن عمرو بن سليم بن عمرو بن خلدة بن عامر بن مخلد بن عامر بن زريق الزرقي الأنصاري من أهل المدينة يروي عن أبيه والقاسم بن محمد روى عنه عبد الملك بن الحسن مات سنة أربع PageV06P349 وثلاثين ومائة وأمه عبادة بنت عبادة واسمه سعيد بن عثمان بن خلدة(@)(@@)(@@)(@@) $ 8055 - سعيد بن سليمان بن زيد بن ثابت الأنصاري المدني أخو عبد الله بن سليمان يروي عن عمه خارجة بن زيد روى عنه مالك بن أنس مات سنة اثنتين وثلاثين ومائة وكان يلي قضاء المدينة لإبراهيم بن هشام بن إسماعيل(@)(@@)(@@)(@@) $ 8056 - سعيد بن عبد الجبار بن وائل بن حجر الكندي يروي عن أبيه روى عنه محمد بن حجر كنيته أبو الحسن مات سنة ثمان وخمسين ومائة في السنة التي توفي فيها أبو جعفر(@)(@@)(@@)(@@) $ 8057 - سعيد بن أبي بكر بن حفص بن عمر بن سعد بن أبي وقاص القرشي يروي عن سالم بن عبد الله أن بن عمر صام في السفر في رمضان روى عنه سعيد بن مسلم بن بانك PageV06P350(@)(@@)(@@)(@@) $ 8058 - سعيد بن أبي بردة بن أبي موسى الأشعري يروي عن أبيه روى عنه قتادة وزيد بن أبي أنيسة وشعبة(@)(@@)(@@)(@@) $ 8059 - سعيد بن إياس الجريري كنيته أبو مسعود من أهل البصرة من ولد جرير بن عباد أخو الحارث بن عباد وقد قيل إنه مولى قيس بن ثعلبة بن بكر بن وائل يروي عن أبي العلاء وأبي نضرة روى عنه الثوري وشعبة وأهل بلده مات سنة أربع وأربعين ومائة وكان قد اختلط قبل أن يموت بثلاث سنين وقد رآه يحيى بن سعيد القطان وهو مختلط ولم يكن اختلاطا فاحشا فلذلك أدخلناه في الثقات(@)(@@)(@@)(@@) $ 8060 - سعيد بن أيمن يروي عن كثير بن عباس روى عنه 
ms1018	 بن أبي ذئب(@)(@@)(@@)(@@) $ 8061 - سعيد بن أوس يروي عن سعيد بن المسيب روى عنه سعيد بن أبي هلال ومحمد بن إسحاق(@)(@@)(@@)(@@) $ 8062 - سعيد بن عبد الرحمن بن مكمل الأعشى من أهل المدينة يروي عن أيوب بن بشير روى عنه سهل بن أبي صالح وشريك بن أبى نمر PageV06P351(@)(@@)(@@)(@@) $ 8063 - سعيد بن عبد الرحمن بن أبزى مولى خزاعة من أهل الكوفة يروي عن أبيه روى قتادة عن عزرة عنه(@)(@@)(@@)(@@) $ 8064 - سعيد بن جابر الرعيني يروي عن أبيه عن أبي بكر روى عنه الشيباني(@)(@@)(@@)(@@) $ 8065 - سعيد بن عبد الرحمن بن وائل الأنصاري من أهل الحجاز يروي عن عبد الله بن عبد الله بن عمر روى عنه فليح بن سليمان(@)(@@)(@@)(@@) $ 8066 - سعيد بن حكيم أخو بهز بن حكيم يروي عن أبيه عن جده روى عنه داود الوراق من حديث سفيان بن حسين عنه(@)(@@)(@@)(@@) $ 8067 - سعيد بن عبد الرحمن بن أبي سعيد الخدري يروي عن أبيه عداده من أهل المدينة روى عنه محمد بن إسحاق(@)(@@)(@@)(@@) $ 8068 - سعيد بن عبيد الهنائي يروي عن عبد الله بن شقيق وبكر بن عبد الله المزني روى عنه سلم بن قتيبة والعراقيون PageV06P352(@)(@@)(@@)(@@) $ 8069 - سعيد بن عمرو بن سعيد بن العاص بن أمية يروي عن أبيه روى عنه أهل العراق(@)(@@)(@@)(@@) $ 8070 - سعيد بن حريث يروي عن الحسن قوله روى عنه أهل العراق(@)(@@)(@@)(@@) $ 8071 - سعيد بن أسعد يروي عن يحيى بن سعيد الأنصاري وأهل المدينة روى عنه موسى بن إسماعيل التبوذكي(@)(@@)(@@)(@@) $ 8072 - أبو مسلمة سعيد بن يزيد يروي عن أبي نضرة روى عنه شعبة والبصريون(@)(@@)(@@)(@@) $ 8073 - سعيد بن جميل العبسي يروي عن ربعي بن حراش روى عنه أبو نعيم(@)(@@)(@@)(@@) $ 8074 - سعيد بن عبيد بن السباق يروي عن أبيه عن سهل بن حنيف روى عنه محمد بن إسحاق بن يسار PageV06P353(@)(@@)(@@)(@@) $ 8075 - سعيد بن عبد الرحمن بن أبي العمياء يروي عن سهل بن أبي أمامة روى عنه بن وهب(@)(@@)(@@)(@@) $ 8076 - سعيد بن دريك التميمي يروي عن عطاء ونافع روى عنه الربيع بن زياد حدثنا 
ms1019	 علي بن أحمد بن سعيد قال ثنا محمد بن عبيد بن عبد الملك الأسدي قال ثنا الربيع بن زياد قال ثنا سعيد بن دريك عن عطاء بن جابر قال نهى رسول الله صلى الله عليه وسلم عن كراء الأرض بالثلث والربع(@)(@@)(@@)(@@) $ 8077 - سعيد بن حدير أبو غنيم قوله روى عنه صفوان بن عمرو السكسكي(@)(@@)(@@)(@@) $ 8078 - سعيد بن غزوان من أهل الشام يروي عن صالح بن يحيى بن مقدام بن معدي كرب روى عنه الحارث بن عبيدة الكلاعي(@)(@@)(@@)(@@) $ 8079 - سعيد بن كعب يروي عن جابر بن زيد روى الثوري عن عبد الحميد عنه PageV06P354(@)(@@)(@@)(@@) $ 8080 - سعيد بن حيي الخولاني ثم الجعلي يروي عن أبيه روى عنه عياش بن عباس القتباني(@)(@@)(@@)(@@) $ 8081 - سعيد بن سالم الكندي يروي عن معاوية بن عياض بن غطيف عن أبيه عن جده قال سمعت رسول الله صلى الله عليه وسلم يقول إن شرب الخمر فاجلدوه وإن عاد فاجلدوه وإن عاد فاجلدوه وإن عاد فاقتلوه حدثنا بن قتيبة ثنا عبد الوهاب بن الضحاك قال ثنا إسماعيل بن عياش عن سعيد بن سالم(@)(@@)(@@)(@@) $ 8082 - سعيد بن جعفر بن المطلب بن أبي وداعة السهمي يروي عن أبيه روى عنه بن جريج(@)(@@)(@@)(@@) $ 8083 - سعيد بن حيان بن جحدر الطائي وهو الذي يقال له سعيد بن أبي السمين كان كنية حيان أبا السمين يروي عن عتبة بن أبي سليمان روى عنه التبوذكي PageV06P355(@)(@@)(@@)(@@) $ 8084 - سعيد بن زياد المكتب مولى بني زهرة من أهل المدينة يروي عن سليمان بن يسار روى عنه خالد بن مخلد(@)(@@)(@@)(@@) $ 8085 - سعيد بن الحارث يروي عن شريح روى عنه الحسن بن ذكوان(@)(@@)(@@)(@@) $ 8086 - سعيد بن زياد الشيباني يروي عن طاوس روى عنه وكيع ويحيى بن سعيد القطان(@)(@@)(@@)(@@) $ 8087 - سعيد بن إبراهيم بن معقل يروي عن عروة بن رويم روى عنه سعيد بن أبي أيوب(@)(@@)(@@)(@@) $ 8088 - سعيد بن خرشيد يروي عن أبي الشعثاء والحسن بن محمد قولهما روى عنه بن جريج(@)(@@)(@@)(@@) $ 8089 - أبو سنان الشيباني اسمه سعيد بن سنان من أهل 
ms1020	 الكوفة يروي عن عمرو بن مرة كان أصله من قزوين روى عنه يحيى بن آدم والكوفيون وكان عابدا فاضلا PageV06P356(@)(@@)(@@)(@@) $ 8090 - سعيد الصراف يروي عن عطاء بن أبي رباح روى عنه يحيى بن عبد الله بن عبد الرحمن بن أبي عمرة الأنصاري(@)(@@)(@@)(@@) $ 8091 - سعيد بن حسان المخزومي من أهل الحجاز يروي عن عياض بن عدي بن الخيار النوفلي روى عنه بن عيينة ووكيع(@)(@@)(@@)(@@) $ 8092 - سعيد بن مسلم بن بانك من أهل المدينة يروي عن عامر بن عبد الله بن الزبير روى عنه خالد بن مخلد القطواني(@)(@@)(@@)(@@) $ 8093 - سعيد بن زياد يروي عن جابر بن زيد روى عنه سعيد بن أبي هلال(@)(@@)(@@)(@@) $ 8094 - سعيد بن خالد بن عبد الله بن قارظ الزهري أخو المسور بن خالد من أهل المدينة يروي عن أبي سلمة بن عبد الرحمن روى عنه بن أبي ذئب مات في آخر ولاية بني أمية حدثنا PageV06P357 إبراهيم بن خزيم قال ثنا عبد بن حميد قال ثنا أبو بكر الحنفي قال ثنا بن أبي ذئب قال حدثني سعيد بن خالد القارظي قال أتيت أبا سلمة بن عبد الرحمن أزوره بقباء فقال سمعت أبا سعيد الخدري يقول قال رسول الله صلى الله عليه وسلم إذا سقط الذباب في الطعام فامقلوه فإن في أحد جناحيه سما وفى الآخر شفا وإنه يقدم السم ويؤخر الشفاء(@)(@@)(@@)(@@) $ 8095 - سعيد بن زيد بن عقبة الفزاري من أهل الكوفة يروي عن أبيه عن سمرة روى عنه الحجاج بن أرطأة(@)(@@)(@@)(@@) $ 8096 - سعيد بن سلمة بن أبي الحسام مولى آل عمر بن الخطاب من أهل المدينة كنيته أبو عمرو يروى عن بن المنكدر وهشام بن عروة روى عنه موسى بن إسماعيل(@)(@@)(@@)(@@) $ 8097 - سعيد بن أبي صدقة أبو قرة يروي عن محمد بن سيرين روى عنه حماد بن زيد PageV06P358(@)(@@)(@@)(@@) $ 8098 - سعيد بن أبي زياد يروي عن أبي سلمة بن عبد الرحمن روى عنه سعيد بن أبي هلال(@)(@@)(@@)(@@) $ 8099 - سعيد بن أبي حرة يروي عن نافع روى عنه سعيد بن أبي عروبة 