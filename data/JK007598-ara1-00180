ms161	 عرضة لبناته % PageV01P534 البحر : طويل 1(@)(@@) % خذ الكأس مني أيها الرشأ الأحوى % % وشم نظرا يصحو من المقلة النشوى % % 2(@)(@@) % فللأمد الأدنى سمت بك همة % ولي همة تسمو إلى الغاية القصوى % % 3(@)(@@) % أنا ابن سراة الحي من فرع غالب % أرى فيهم من تالد المجد ما أهوى % % 4(@)(@@) % وأطلب أمرا حال بيني وبينه % زمان نباني وامتعضت من الشكوى % % 5(@)(@@) % فيا سعد ناولني السريجي إنه % شكا ظمأ برحا وقد حان أن يروى % % 6(@)(@@) % وقرب جوادي وانشر الدرع إنها % % إذا الحرب حكت بركها بي لا تطوى % % 7(@)(@@) % ستعلم إن قرطت طرفي عنانه % من الأشر الرواع والمرس الألوى % % PageV01P535 البحر : بسيط تام 1(@)(@@) % أما وحبيك هذا منتهى حلفي % % ليظهرن الذي أخفيه من شغفي % % 2(@)(@@) % فبين جنبي سر لا يبوح به % سوى دموع ، متى ما تذكري تكف % 3(@)(@@) % أستكتم القلب أسرارا تنم بها % % إلى الوشاة شؤون الأدمع الذرف % 4(@)(@@) % وعاذل مج سمعي ما يفوه به % وقد جعلت أحاديث النوى شنفي % % 5(@)(@@) % وفي الجوانح حب لا يغيره % صد الملوك وبعد النية القذف % 6(@)(@@) % وما الحبيب ، وما أعني سواك به % ممن يقل عليه في النوى أسفي % % 7(@)(@@) % ولا أخاف الردى إن كنت راضية % به ، فكم كلف أفضى إلى نلف % 8(@)(@@) % وإن أبيت فما بالرفق يملكني % % من لا يلائم أخلاقي ، ولا العنف % 9(@)(@@) % ولا الهوى يعطف الإكراه شارده % ليس الفؤاد إذا ولى بمنعطف % 10(@)(@@) % ووقفة لم أقل فيها على وجل % للدمع ، من حذري عين الرقيب : قف % PageV01P536 11(@)(@@) % بمنزل يستعير الظبي من غيد % في حافتيه ، وغصن البان من هيف % 12(@)(@@) % والعامرية تسقي الورد مجهشه % بنرجس من سجال الدمع مغترف % 13(@)(@@) % تقول حتام لا تلوي على وطن % وكم تعذب جسما بادي الترف % 14(@)(@@) % وكم تشيم بروقا غير صادقة % والآل ليس بما يروي صداك يفي % % 15(@)(@@) % وأنت من معشر لولا تأخرهم % جاءت بذكرهم الأولى من الصحف % 16(@)(@@) % شم العرانين لاتدمى أنوفهم % عند اللقاء ولا تعرى من الأنف % 17(@)(@@) % ولا تخب هوادي الخيل إن ركبوا % % إلى الوغى بمعازيل ولا كشف % 18(@)(@@) % فاستبق نفسك لا يود 
ms162	 السفار بها % % فهي الحشاشة من مجد ومن شرف % 19(@)(@@) % وعرض مثلك لا تغتاله نوب % تفتر عيشته فيها عن الشظف % 20(@)(@@) % وليس يرضى ، وفي أحشائه غلل % ريا بما يصم الظمآن من نطف % PageV01P537 21(@)(@@) % يا أخت سعد وسعد خير من جذبت % إلى العلا ضبعه الأشياخ من حذف % 22(@)(@@) % كفي وغاك فما عودي بمهتصر % وإن أرابك ما تلقين من عجفي % % 23(@)(@@) % لا عيب بالسيف إن رقت مضاربه % من النحول ، ولابالرمح من قضف % 24(@)(@@) % وإن تغربت لم أفزع إلى وكل % ولم يكن من صرى الأمواه مر تشفي % % 25(@)(@@) % وقد فليت الورى حتى قليتهم % إلا بقايا كرام من بني خلف % 26(@)(@@) % جاد الزمان بهم والبكم شيمته % فالفضل في خلف منهم وفي سلف % 27(@)(@@) % وهم وإن حسبوا في أهله ولهم % علا رعوا تالدا منها بمطرف % 28(@)(@@) % كالماء والنار موجودين في حجر % والبدر في سدف والدر في صدف % 29(@)(@@) % فآل صفوان إن تذكر مناقبهم % يلو الحسود إليها جيد معترف % 30(@)(@@) % وقد أظل أبا أروى ذرا نسب % بسؤدد كجبين الصب ملتحف % PageV01P538 31(@)(@@) % ذو همة لن تنال الشهب غايتها % % علت وما احتفلت منها بمرتدف % 32(@)(@@) % جم التواضع والأقدار تخدمه % ولا يصعر خديه من الصلف % 33(@)(@@) % كالبحر لو أمن التيار راكبه % والبدر لو لم يشنه عارض الكلف % 34(@)(@@) % طلق محياه للعافي ، وراحته % في الجود تزري على الهطالة الوطف % 35(@)(@@) % رقت وراقت سجاياه ، فنفحتها % % تشي إليك بريا الروضة الأنف % 36(@)(@@) % وينتضي الحلم منه عفو مقتدر % عن كل معترف بالذنب مقترف % 37(@)(@@) % بث المواهب حتى ضم نائله % من المحامد شملا غير مؤتلف % 38(@)(@@) % ولم يذر في الندى إسرافه كرما % وإنما شرف الأجواد في السرف % 39(@)(@@) % لبيك ياجمحي المكرمات فقد % ناديت شعري وعز الياس مكتنفي % % 40(@)(@@) % فازور عن كل نكس لا يهاب به % إلى الثناء عن العلياء منحرف % PageV01P539 41(@)(@@) % إذا تجاذبتما أهداب مكرمة % حللت في الصدر منها وهو في الطرف % 42(@)(@@) % لئن جحدتك نعمى مدريقها % % إلى النوائب مني باع منتصف % 43(@)(@@) % فلا تلقيت خلي حين تزعجه % فظاظة الدهر ، بالمعروف من لطفي % % PageV01P540 البحر : طويل 
ms163	 1(@)(@@) % خليلي خوضا غمرة الليل إنني % % لبست الدجى والخيل تنضو مراحها % % 2(@)(@@) % فرب نهار قاتم كنت شمسه % وكم ليلة ليلاء كنت صباحها % % 3(@)(@@) % وتحتي طيار العنان كأنه % خدارية هزت لصيد جناحها % % 4(@)(@@) % وإني لتسمو بي إلى المجد همة % تود الثريا أن تكون وشاحها % % 5(@)(@@) % فلي من قريش أطيبوها وغامد % تعاون من يربوع في رياحها % % 6(@)(@@) % كرام يهينون العشار إذا شتوا % % وقد أخذت كوم المطايا سلاحها % % 7(@)(@@) % بأيد إذا ما أنكر الكلب أهله % % عرفت لها طعنا يشظى رماحها % % 8(@)(@@) % وها أنا أسعى للمعالي فطالما % % أجالت جدودي في معد قداحها % % 9(@)(@@) % فإن نلتها استخلصت حقي وإن أخب % فخطوة ساع لم تصادف نجاحها % % PageV01P541 البحر : كامل تام 1(@)(@@) % خدع المنى وخواطر الأوهام % أضغاث كاذبة من الأحلام % 2(@)(@@) % نهوى البقاء وليس فيه طائل % والمرء نهب حوادث الأيام % 3(@)(@@) % يحوي رغائب ماله وراثه % من بعده ويبوء بالآثام % 4(@)(@@) % والعيش أوله عقيد مشقة % وأذى ، وآخره مقيل حمام % 5(@)(@@) % والعمر لو جاز المدى لتبرم ال % % أرواح منه بصحبة الأجسام % 6(@)(@@) % بينا الفتى قلقا به نياته % ألقى مراسيه بدار مقام % 7(@)(@@) % وهوى كزيد بن الحسين إلى الثرى % % غب الثراء محالف الإعدام % 8(@)(@@) % في معوز سمل مشى فيه البلى % % والقبر بئس معرس الأقوام % 9(@)(@@) % نضدت عليه بنية من رمسه % كالغمد مشتملا على الصمصام % 10(@)(@@) % وأصابه ريب المنية إذ رمى % % طويت على شلل يمين الرامي % % PageV01P542 11(@)(@@) % لو قارع الناس المنون لردها % % عنه السيوف فوالقا للهام % 12(@)(@@) % تدمى أغرتها بأيدي غلمة % قرشية بيض الوجوه كرام % % 13(@)(@@) % يطؤون أذيال الدروع بمأقط % حرج يفيء عليه ظل قتام % 14(@)(@@) % وتضيء في هبواته صفحاتهم % كالفجر يخطر في رداء ظلام % 15(@)(@@) % والمال جم ، والحمى متمنع % والمجد أتلع ، والعروق نوام % 16(@)(@@) % رميت بثالثة الأثافي هاشم % فبكت بأربعة عليه سجام % 17(@)(@@) % والعبد شمس ، والتجلد خيمها % % عين مؤرقة ، وجفن دام % 18(@)(@@) % وهم الأسود الغلب حول ضريحه % يبكونه بنواظر الآرام % 19(@)(@@) % فتضاءلت كور الجبال لفقده % غبر الفجاج خواشع الأعلام % 20(@)(@@) % ولقلتي أروند رنة ثاكل % % حران حين ثوى أبو الأيتام % PageV01P543 21(@)(@@) % فجعوا 
ms164	 بتاج الدين حتى عضهم % زمن ألح بشرة وعرام % 22(@)(@@) % لما نعته المكرمات إلى العلا % % لبس الحداد شريعة الإسلام % 23(@)(@@) % فمضى وقد أصحبته سيارة % كالروض يضحك من بكاء غمام % 24(@)(@@) % غراء من كلمى إذا هي سطرت % ظهرت بها النخوات في الأقلام % 25(@)(@@) % ليست لعارفة أجازيه بها % % لكنها لوشائج الأرحام % 26(@)(@@) % وأحق مفتقد بها ذو سؤدد % آباؤه من هاشم أعمامي % % 27(@)(@@) % ولو استطعت كففت عنه يد الردى % % بشباة رمح أو غرار حسام % 28(@)(@@) % وبفتية ألفوا المصاع كأنهم % أسد من الأسلات في آجام % 29(@)(@@) % وإذا دعوا لكريهة لم ينظروا ال % % إسراج واقتصروا على الإلجام % 30(@)(@@) % فهم الليوث غداة يحتضر الوغى % % وهم الغيوث عشية الإطعام % PageV01P544 31(@)(@@) % وقدورهم يعد القرى إرزامها % % والرعد ليس يهم بالإرزام % 32(@)(@@) % وإذا اعتزوا أروى زنادهم أب % مر الحفيظة للحقيقة حام % 33(@)(@@) % فالعم أبلج من كنانة في الذرا % % والخال أروع من بني همام % 34(@)(@@) % ليسوا من النفر الذين أصولهم % خبثت وليس لهن فرع نام % 35(@)(@@) % رفعتهم جدة وجدهم لقى % من لؤمه ، بمدارج الأقدام % 36(@)(@@) % لازال ترضعه أفاويق الحيا % % وطفاء ينتجها الصبا لتمام % 37(@)(@@) % فتلفعت بحبيها قلل الربا % % وتلثمت من برقها بضرام % PageV01P545 البحر : بسيط تام 1(@)(@@) % لله أي فتى مجد تناوشه % مني نوائب عن أنيابها كشر % 2(@)(@@) % أرخي عطافي وأضحي غير محتفل % بها وقد شد من غيري لها الأزر % 3(@)(@@) % ولا أخيض المطايا وهي ظامئة % سؤر الموارد حتى تصفو الغدر % 4(@)(@@) % وبين جنبي سر لا تبوح به % إلا الأسنة والمأثرة البتر % 5(@)(@@) % فعن قليل تئن الأرض من خببي % % إلى المعالي إذا ما ابتلت العذر % PageV01P546 البحر : بسيط تام 1(@)(@@) % نهج الثناء إلى ناديك مختصر % لو أدركت وصفك الأوهام والفكر % 2(@)(@@) % ماذا يقول لك المثني وقد نزلت % على ابن عمك في تقريظك السور % 3(@)(@@) % فت المدائح حتى قال أفصحنا % % إن البلاغة في تحبيرها حصر % 4(@)(@@) % ماضر من كان عبد الله والده % أن لم يكن أبويه الشمس والقمر % 5(@)(@@) % يا خير من بشرت بعد النبي به % عدنان وادرعت عزا به مضر % 6(@)(@@) % أحيا بك الله 
ms165	 ما كانت تدل به % عليا قريش ومنها السادة الغرر % 7(@)(@@) % لك الوقار من الصديق ، تكنفه % مهابة كان محبوا بها عمر % 8(@)(@@) % وجود عثمان والآفاق شاحبة % ونجدة من علي والقنا كسر % 9(@)(@@) % وعلم جدك عبد الله شيب به % دهاؤه حين أعيى الوارد الصدر % 10(@)(@@) % وهمة من أبي الأملاك طلت بها % % باعا وقصر عنها الأنجم الزهر % PageV01P547 11(@)(@@) % وهيبة الكامل الموفي على أمد % مامد طرفا إلى أدناه مفتخر % 12(@)(@@) % وفيك من شيم المنصور سطوته % والبيض تلمع والهيجاء تستعر % 13(@)(@@) % ومكرمات من المهدي تنشرها % % وأي هدي إلى العلياء تفتقر % 14(@)(@@) % وللرشيد سجايا منك نعرفها % % فضل يرجى ، ورأي تلوه القدر % 15(@)(@@) % وقد ورثت أبا إسحاق جرأته % في مأزق حاضراه النصر والظفر % 16(@)(@@) % وفيك من جعفر حزم يلوح به % على مساعيك من مسعاته أثر % 17(@)(@@) % وبأس طلحة في إقدام أحمد إذ % وشت بسر المنايا البيض والسمر % 18(@)(@@) % ومن أبي الفضل عز يستجار به % يوم الوغى وظلام النقع معتكر % % 19(@)(@@) % وحلم إسحاق والألباب طائشة % بحيث يختضب الصمصامة الذكر % 20(@)(@@) % وعزمة القادر المحبو سائله % والخارجي لوى من جيده الأشر % PageV01P548 21(@)(@@) % ورأفة القائم المرجو نائله % والسحب تعتل والأنواء تعتذر % 22(@)(@@) % وللذخيرة فضل أنت وارثه % وكان أروع ، ما في عوده خور % 23(@)(@@) % وعزة المقتدي تكسى مهابتها % % حتى يعود خفيا دونك النظر % 24(@)(@@) % إن أثلوا لك ، والدنيا بعذرتها % % علا ، فهذي علا أثلتها أخر % 25(@)(@@) % فاسمع شكية من يلفى ولاؤهم % منه بحيث يكون السمع والبصر % 26(@)(@@) % فهذه شتوة ألقت كلاكلها % % حتى استبد بصفو العبشة الكدر % 27(@)(@@) % ومنزلي أبلت الأيام جدته % فشفني المبليان : الهم والسهر % 28(@)(@@) % وللفؤاد وجيب في جوانبه % كما يهز الجناح الطائر الحذر % 29(@)(@@) % يحكي عناق محب من يهيم به % إذا تعانقن في أرجائه الجذر % 30(@)(@@) % ولن تقيم به نفس فتألفه % إذ ليس للعين في أقطاره سفر % PageV01P549 31(@)(@@) % والسقف يبكي بأجفان المشوق إذا % % أرسى به هزم الأطباء منهمر % 32(@)(@@) % وما سرى البرق والظلماء عاكفة % إلا وفي القلب من نيرانه شرر % 33(@)(@@) % وابن المعاوي يهوى أن يكون له % مغنى ببغداذ لا يخشى 
ms166	 به الغير % 34(@)(@@) % مثوى يدافع عن كتبي ، وأكثرها % % فيه مديحك أن يغتالها المطر % 35(@)(@@) % و شافعي عمدة الدين الملوذ به % في الروع ، والخيل في أعطافها زور % 36(@)(@@) % إذا أهبت به والحرب لاقحة % روى القنا من أعاديك الدم الهدر % 37(@)(@@) % فالأرض داركم والعبد جاركم % وأنتم أنتم ، والحمد يدخر % PageV01P550 البحر : خفيف تام 1(@)(@@) % يا ضلوعين تلهبي في اكتئاب % يا دموعي تأهبي لانسكاب % 2(@)(@@) % إن برح الغرام ينزف دمعا % راض شوقي إباءه في التصابي % % 3(@)(@@) % وكذا الماء ليس يجريه إلا % وهج النار من غصون رطاب % 4(@)(@@) % وبلائي ثلاثة طرقتني % % بسهاد ولوعة وانتحاب % 5(@)(@@) % حنة بعد صيحة ونعيب % منء مطي وسائق وغراب % 6(@)(@@) % فتقضت شبيبتي بين شكوى % % وتجن وهجرة وعتاب % 7(@)(@@) % والتفاتي إلى سني يريني % % عددا ليس يقتضي غدرها بي % % 8(@)(@@) % شاب رأسي ولم تمس يميني % % ذنب الأربعين عند حسابي % % 9(@)(@@) % ورأت شيبي الرباب فقالت : % ما جناه ؟ فقلت : حب الرباب % 10(@)(@@) % ملكت رقي الصبابة حتى % % خاض صبح المشيب ليل الشباب % PageV01P551 البحر : طويل 1(@)(@@) % إمام الهدى لا زال عصرك باسما % عن الشرف الوضاح والكرم المحض % 2(@)(@@) % أرى الأجم استولى عليه قطينه % وفضل في سكناه بعض على بعض % 3(@)(@@) % ونحن بحيث الذئب بات مروعا % يقلص جفنيه الحذار عن الغمض % 4(@)(@@) % وقد كنت أرجو أن أخيم عندكم % بمنزلة بين الرفاهة والخفض % 5(@)(@@) % طلبت الثريا في السماء بمدحكم % فأنزلتموني بالثريا على الأرض % PageV01P552 البحر : طويل 1(@)(@@) % طويت رجائي عنك يا دهر إنني % % ألوذ بظل من وفائك قالص % 2(@)(@@) % ويرميك ذمي بالتي لا شوى لها % % وليس يسوء الوغد لذع القوارص % 3(@)(@@) % وكل كريم أنت آخر رزقه % على عقب الحرمان أول ناكص % 4(@)(@@) % تهيم بمنفي السحالة زائف % وتعرض عن صافي السبيكة خالص % 5(@)(@@) % فلم تعلق البأساء إلا بكامل % ولا عثر النعماء إلا بناقص % PageV01P553 البحر : طويل 1(@)(@@) % أيا صاحبي رحلي خذا أهبة النوى % % فهذا مناخ لا أريد به مكثا % % 2(@)(@@) % ولولا العلا لم أسلب العيس هبة % تهز على الأكوار أغلمة شعثا % % 3(@)(@@) % ترفع عمن يألف اللوم همتي % % ولم أتكلف عن معائبه بحثا 
ms167	 % % 4(@)(@@) % فلا خير في من لا يلين لذكره % جماح القوافي حين يمدح أو يرثى % % 5(@)(@@) % وكم علقت كف امرىء ذي حفيظة % بحبلي فما أوهيت مرته نكثا % % 6(@)(@@) % إذا قصرت عما أحاوله يدي % % بأرض فإني لا أطيل بها لبثا % % 7(@)(@@) % أفارقها والفجر في حجر أمه % ولم يلفظ الوكر الخدارية الغرثى % % PageV01P554 البحر : كامل أحذ 1(@)(@@) % وعليلة الألحاظ ترقد عن % صب يصافح جفنه الأرق % 2(@)(@@) % ففؤاده كسوارها حرج % ووساده كوشاحها قلق % 3(@)(@@) % عانقتها والشهب ناعسة % والأفق بالظلماء منتطق % 4(@)(@@) % فلثمتها واليل من قصر % قد كاد يلثم فجره الشفق % 5(@)(@@) % بمضاجع ألف العفاف بها % % كرم بأذيال التقى علق % 6(@)(@@) % ثم افترقنا حين فاجأنا % % صبح تقاسم ضوءه الحدق % 7(@)(@@) % وبنحرها من أدمعي بلل % وبراحتي من نشرها عبق % PageV01P555 البحر : بسيط تام 1(@)(@@) % ومرتد بالدجى روحت صهوته % بعد اختلاس ذماء الريح بالعنق % 2(@)(@@) % فما مسحت بعرف الصبح حافره % ولا فليت عليه لمة الغسق % 3(@)(@@) % وليس في الأرض من يطوي إليه فلا % % يجلو لمى الليل فيها مبسم الفلق % PageV01P556 البحر : بسيط تام 1(@)(@@) % وخطة من بيوت الحي زرت بها % % بيضا يهز الصبا منهن أعطافا % % 2(@)(@@) % هيفا تخف إذا حاولن منتهضا % خصورهن ويستثقلن أردافا % % 3(@)(@@) % وهن يبسمن عن غر كشفن بها % % عن اللآلىء للرائين أصدافا % % 4(@)(@@) % ويرتمين بنبل يتخذن لها ال % قلوب عند استراق اللحظ أهدافا % % 5(@)(@@) % والشيب خيط في فودي كما نشرت % يد الصبا لرياض الحزن أفوافا % % 6(@)(@@) % فلم يرعني سوى أيد أناملها % % مخضوبة من دم العشاق أطرافا % % 7(@)(@@) % بسطنها لوداعي حين فارقني % % ليل الشباب وصبح الشيب قد وافى % % PageV01P557 البحر : كامل تام 1(@)(@@) % بكر الخليط وفي العيون من الجوى % % دفع النجيع وبالقلوب شواظ % 2(@)(@@) % والركب من دهش النوى في حيرة % لا راقدون ولا هم أيقاظ % 3(@)(@@) % وبدت لنا هيفاء مخطفة الحشى % % فتناهبت وجناتها الألحاظ % 4(@)(@@) % في نسوة رقت خدودا أشربت % ماء الشبيبة والقلوب غلاظ % 5(@)(@@) % فكأنما ألفاظها عبراتها % % وكأنما عبراتها الألفاظ % PageV01P558 البحر : بسيط تام 1(@)(@@) % زارت أميمة والظلماء تعتكرزارت أميمة والظلماء تعتكر % والنجم يخطر في ألحاظه السهر % 2(@)(@@) % فبت 
ms168	 والوجد يطويني وينشرني % % حتى رأيت فروع الصبح تنتشر % 3(@)(@@) % ألقي إليها أحاديثا تلين لنا % % متونها ، ودموع العين تبتدر % 4(@)(@@) % ولي إذا خالستني القول أو سفرت % عن وجهها ما اشتهاه السمع والبصر % 5(@)(@@) % فلست أدري وذيل الليل يسترنا % % أتلك في حسنها أبهى أم القمر % PageV01P559 البحر : وافر تام 1(@)(@@) % أما والخيل تعثر في العجاج % وآساد تهش إلى الهياج % 2(@)(@@) % وضرب لا ينهنهه تريك % يطابق خلسة الطعن الخلاج % 3(@)(@@) % إذا لقحت به حرب عقيم % تمخضت المنايا للنتاج % 4(@)(@@) % لأرتدين بالظلماء حتى % % تشق عزائمي ثغر الدياجي % % 5(@)(@@) % وتعترك الفوارس في مكر % يريك السمر دامية الزجاج % 6(@)(@@) % فكم أغضي الجفون على قذاها % % بحيث الأرض ضيقة الفجاج % 7(@)(@@) % ألست ابن الملوك وهل كقومي % % ذرا لمروع وحيا لراج % 8(@)(@@) % وكم متخمط فيهم أبي % وخراج من الغمرات ناج % 9(@)(@@) % وأروع تحت أخمصه الثريا % % وفوق جبينه خرزات تاج % 10(@)(@@) % نموني للعلا فحللت منها % % بحيث يرى من الأذن المناجي % % PageV01P560 11(@)(@@) % ولي شيم أوابد آنسات % يشاب العذب منها بالأجاج % 12(@)(@@) % متى يطلب معاندتي لئيم % فدون سجاحتي غلق الرتاج % PageV01P561 البحر : طويل 1(@)(@@) % أيا عقدات الرمل من أرض كوفن % سقاكن رجاف العشي هتون % 2(@)(@@) % أذيل لذكراكن دمعي وفي الحشى % % هوى لسيالات بكن مصون % 3(@)(@@) % إذا حدث الركبان عنكن هيجوا % % تباريح وجد والحديث شجون % 4(@)(@@) % فجن بكن اللب مني على النوى % % وما بي لولا حبكن جنون % PageV01P562 البحر : طويل 1(@)(@@) % هي النفس في مستنقع الموت تبرك % وتأخذ منها النائبات وتترك % 2(@)(@@) % فلا الطمع المزري بها يستفزني % % ولا الضيم مذ عزت بجنبي يعرك % 3(@)(@@) % وأسعى فقد أيقنت أن مآربي % % إذا ساعد المقدار بالسعي تدرك % 4(@)(@@) % ولي عزمات يعلم القرن أنها % % به قبل تجريد الصوارم تفتك % 5(@)(@@) % سأجني حروبا تتقى غمراتها % % وتحقن فيهن الدماء وتسفك % 6(@)(@@) % وأسكن والأقدام بعد ثبوتها % % تزل وأطراف القنا تتحرك % 7(@)(@@) % وفي كل فود للسريجي مضرب % وكل فؤاد للرديني مسلك % 8(@)(@@) % بحيث تغيب الخيل في رهج الوغى % % وتبدو وبيض الهند تبكي وتضحك % 9(@)(@@) % أيمضي الشباب الغض قبل وقائع % يكاد حجاب الشمس فيهن يهتك 
ms169	 % 10(@)(@@) % فلست ابن أم المجد إن أغمد الظبا % % وغيري بأذيال العلا يتمسك % PageV01P563 البحر : بسيط تام 1(@)(@@) % يا صاحبي أثيراها على عجل % هوجا إلى عذبات الورد تستبق % 2(@)(@@) % الليل يعلم ما تخفي أضالعه % مني ويبديه من أحشائه الفلق % 3(@)(@@) % أسري ولا أتأرى في مغمضة % يعيى بأمثالها الهيابة الفرق % 4(@)(@@) % وأركب الأمر تستوشي عواقبه % خطبا يصافح فيه الأعين الأرق % 5(@)(@@) % فللعلا قحم يغشى مصاعبها % % ثبت المقارم في أسيافه قلق % 6(@)(@@) % أغر لا يتقرى عوده خور % ولا يرف على أخلاقه ملق % 7(@)(@@) % إذا انجلى النقع عنه عند معركة % تقاسمته على أرجائها الحدق % PageV01P564 البحر : خفيف تام 1(@)(@@) % كلماتي قلائد الأعناق % سوف تفنى الدهور وهي بواق % 2(@)(@@) % دل فيها الذهن الجلي بألفا % % ظ رقاق على معان دقاق % 3(@)(@@) % فقريضي يراه منء ينقد الأش % % عار سهل المرام صعب المراقي % % 4(@)(@@) % لم يشنه المعنى العويص ولا لف % ظ يكد الأسماع مر المذاق % 5(@)(@@) % وهو في منجم الفصاحة من فر % عي نزار مقابل الأعراق % 6(@)(@@) % وإليه يصبو الرواة وفيه % مع شكل الحجاز ظرف العراق % 7(@)(@@) % مؤيس مطمع قريب بعيد % فهو أنس المقيم زاد الرفاق % PageV01P565 البحر : طويل 1(@)(@@) % وفتيان صدق إن يهب بهم العدا % % إلى غمرات لا يرعهم ورودها % % 2(@)(@@) % إذا احتضنوا بيض الصوارم أومضت % بحمر المنايا والرؤوس غمودها % % 3(@)(@@) % على أعوجيات تهش إلى الوغى % % ويلقى تكاليف الأذى من يذودها % % 4(@)(@@) % وفوق مطاها كل أروع ماجد % يقود نزارا كلها ويسودها % % 5(@)(@@) % وتعبق ريا كفه يزنية % إذا لمستها كاد يخضر عودها % % 6(@)(@@) % وقد حاربته من معد وغيرها % % قبائل تبغي الملك صعرا خدودها % % 7(@)(@@) % فخايل في ثني المفاضة ظله % وسلت بأطراف العوالي حقودها % % 8(@)(@@) % ونحن ملكنا الأرض فانتعش الورى % % بأيد سباط شيب بالبأس جودها % % 9(@)(@@) % وسقناهم والخير فينا سجية % إلى نعم لا يستطاع جحودها % % 10(@)(@@) % فإن يحسدونا لا نلمهم ، وهذه % مآثر تأبى أن يلام حسودها % % PageV01P566 البحر : كامل تام 1(@)(@@) % ومهفهف أشكو فظاظة عاذل % يزري علي إلى لطافة خصره % 2(@)(@@) % أسرى فجاب سناه أردية الدجى % % حتى استجار الليل منه بشعره % 3(@)(@@) % والخد 
ms170	 من عرق يفيض جمانه % كالورد قرطه الغمام بقطره % 4(@)(@@) % وبكفه القدح الروي ، ومنه ما % % ألتذه ويروقني من خمره % 5(@)(@@) % هي لونها من وجنتيه وطعمها % % من ريقه ، وحبابها من ثغره % PageV01P567 البحر : طويل 1(@)(@@) % أروح بأشجان على مثلها أغدو % % فحتى متى يزري بي الزمن الوغد % 2(@)(@@) % أفي كل يوم دولة مستجدة % يذل بها حر ويسمو لها عبد % 3(@)(@@) % إذا أقبلت ألقت على الذم بركها % % وإن أدبرت لم يتل أربابها الحمد % 4(@)(@@) % فذو النقص في عيش وريق غصونه % وليس لذي فضل بها عيشة رغد % 5(@)(@@) % أيا دهر كفكف من جماحك إنني % % إذا الخطب أمهى نابه أسد ورد % 6(@)(@@) % ولست أشيم البرق فليدع للحيا % % سواي ولا يرفع عقيرته الرعد % 7(@)(@@) % وتخطر أحيانا ببالي مطامع % فيمنع عرضي أن يلابسها المجد % 8(@)(@@) % تبعت أضاليل المنى في شبيبتي % % فحل مشيبي وهي تخدعني بعد % PageV01P568 البحر : بسيط تام 1(@)(@@) % رأت أميمة أطماري وناظرها % % يعوم بالدمع منهلا بوادره % 2(@)(@@) % ومادرت أن في أثنائها رجلا % ترخى على الأسد الضاري غدائره % 3(@)(@@) % أغر في ملتقى أوداجه صيد % حمر مناصله بيض عشائره % 4(@)(@@) % إن رث بردي فليس السيف محتفلا % بالغمد وهو رميض الغرب باتره % 5(@)(@@) % وهمتي في ضمير الدهر كامنة % وسوف يظهر ما تخفي ضمائره % 6(@)(@@) % وهل له غير قومي من يهز به % عطفيه تيها وبي تمت مفاخره % 7(@)(@@) % كانت أوائله تزهى بأولهم % كما بآخرهم زينت أواخره % PageV01P569 البحر : طويل 1(@)(@@) % تقول ابنة السعدي وهي تلومني % % أما لك عن دار الهوان رحيل % 2(@)(@@) % فإن عناء المستنيم إلى الأذى % % بحيث يذل الأكرمون ، طويل % 3(@)(@@) % ومافي الورى إلا لك البدر والد % ولا لسواك النيرات قبيل % 4(@)(@@) % وعندك محبوك السراة مطهم % وفي الكف مطرور الشباة صقيل % 5(@)(@@) % فثب وثبة فيها المنايا أو المنى % % فكل محب للحياة ذليل % 6(@)(@@) % وإن لم تطقها فاعتصم بابن حرة % لهمته فوق السماك مقيل % 7(@)(@@) % يعين على الجلى ويستمطر الندى % % على ساعة فيها النوال قليل % 8(@)(@@) % فللموت خير للفتى من ضراعة % ترد إليه الطرف وهو كليل % 9(@)(@@) % وما علمت أن العفاف سجيتي % % وصبري 
ms171	 على ريب الزمان جميل % 10(@)(@@) % أبى لي أن أغشى المطامع منصبي % % ورب بأرزاق العباد كفيل % PageV01P570 البحر : كامل تام 1(@)(@@) % ومقيل عفر زرته ويد الردى % % بسطت أناملها لكي تجتاحها % % 2(@)(@@) % ولدي مرقوم القميص قد احتمت % منه بأكثبة الحمى بأباحضها % % 3(@)(@@) % وفللت عن بقر الصريمة غربه % والرعب أقمأ باللوى أشباحها % % 4(@)(@@) % فكأنها خلعت عليه إذ نجت % منه نواظر لا تكف طماحها % % 5(@)(@@) % وتحولت نقطا بضاحي جلده % حتى وقت بعيونها أرواحها % % PageV01P571 البحر : طويل 1(@)(@@) % خليلي إن ألوى بي الفقر لم أبل % أيسفح ماء الوجه مني أو الدم % 2(@)(@@) % يعم الورى جدواي إن راشني الغنى % % وأستر عنهم خلتي حين أعدم % 3(@)(@@) % ولما رأتني العامرية مقترا % جرى بأعالي خدها الدمع يسجم % 4(@)(@@) % فقالت وأحداث الليالي تنوشني : % من الأموي الماجد المتهضم ؟ % 5(@)(@@) % يزيد على لؤم الزمان تكرما % ويرنو إليه عابسا وهو يبسم % PageV01P572 البحر : كامل أحذ 1(@)(@@) % واها لجائلة الوشاح سرت % ونواشيء الظلماء تعترض % 2(@)(@@) % وملأت مسحب ذيلها قبلا % ولدي حق الزور مفترض % 3(@)(@@) % فنأت وثغر الصبح مبتسم % ودنت وطرف النجم مغتمض % 4(@)(@@) % والجسم مني مشعر مرضا % مذ دب في ألحاظها المرض % 5(@)(@@) % وسهامها نحوي مفوقة % أرمى بها ، وفؤادي الغرض % PageV01P573 البحر : بسيط تام 1(@)(@@) % إذا رمى النقع عين الشمس بالعمش % فاحرص على الموت في كسب العلا تعش % 2(@)(@@) % ولا ترم شأوها إلا بذي شطب % كأن متنيه يفتران عن نمش % 3(@)(@@) % فلا لعا لفتى ناءت مطيته % بكلكل لمناخ السوء مفترش % 4(@)(@@) % ترنو بخوصاء قد ألقى الكلال يدا % فيها كماوية في كف مرتعش % 5(@)(@@) % فكم تقيم بأرض في خمائلها % % مرعى يضيق على مهرية نفش % 6(@)(@@) % إذا تكفأت في حضن الهوان بها % % لم يألف المشرفي الغمد من دهش % 7(@)(@@) % ولست من صرعة لما منيت بها % % خليت جنبيك للرامي بمنتعش % PageV01P574 البحر : طويل 1(@)(@@) % ومرتبع لذنا بأذيال دوحه % من الحر والبيضاء شبت لظاتها % % 2(@)(@@) % وظلت تناجينا صبا مشرقية % تزيل تباريح الجوى نسماتها % % 3(@)(@@) % وللطير أسراب تناغى بألسن % على عذب الأغصان شتى لغاتها % % 4(@)(@@) % فتلك قدود من قيان لهذه % عليها إذا ما غردت 
ms172	 نغماتها % % 5(@)(@@) % ومما شجاني بعد ورق تجاوبت % مطوقة تطلى بورس سراتها % % 6(@)(@@) % وتبكي بعين لاتجود بعبرة % وأبكي بعين جمة عبراتها % % 7(@)(@@) % ولولا الهوى لم أرعها سمع آلف % صليل السريجيات حمرا ظباتها % % 8(@)(@@) % ولا ملكت ظمياء نفسا أبية % قليل إلى دار الهوان التفاتها % % 9(@)(@@) % بها تقصر الأعمار في حومة الوغى % % وتهوى المعالي أن تطول حياتها % % PageV01P575 البحر : طويل 1(@)(@@) % أبا خالد لا تبخس الشعر حقه % فتقتص منك الشاردات الأوابد % 2(@)(@@) % وإن خفت هجوا واتقيت بنائل % قوارص تأباها النفوس المواجد % 3(@)(@@) % فمن قبل أن يقضى إلى الفكر وحيه % وتملأ أفواه الرواة القصائد % 4(@)(@@) % أغرك أني للسان عن الخنى % % بحلمي - ومن أخلاقنا الحلم - ذائد % 5(@)(@@) % فما الظن ، والمغرور من لا يهابني % % بصل على أنيابه السم راكد ؟ % PageV01P576 البحر : سريع 1(@)(@@) % يا ربة البرقع كم غلة % حامت على ما ضمه البرقع % 2(@)(@@) % وفوقت عينك لي أسهما % لم تمتنع من وقعها الأدرع % 3(@)(@@) % هبي المطايا فرقت بيننا % % لا فارقتها أبدا أنسع % 4(@)(@@) % ونم ما تظهره أعين % منا بما تضمره أضلع % 5(@)(@@) % فلم قسا قلبك في موقف % رقت به الألفاظ والأدمع % PageV01P577 البحر : طويل 1(@)(@@) % خليلي إني ضقت ذرعا بمنزل % يعاني به الرواد رعي هشيم % 2(@)(@@) % وخيمت بين اثنين : مثر مبخل % وأروع طلق الراحتين عديم % 3(@)(@@) % وشر بلاد الله ماساد أهله % أرذال لا يرعون حق كريم % 4(@)(@@) % ومن كان مغمور النجار فإنني % % من الشرف الوضاح قد أديمي % % 5(@)(@@) % أعد أبا لو أنه ولد الورى % % لما التحقت أعراقهم بلئيم % PageV01P578 البحر : طويل 1(@)(@@) % سقى الله رملي كوفن صيب الحيا % % ولا برحا مستن راع ورائد % 2(@)(@@) % ولي أدمع إن أمسك المزن دره % كفلن بصوب البارقات الرواعد % 3(@)(@@) % فقد أوطنتها من أمية عصبة % غذوا بالمعالي في حجور المحامد % 4(@)(@@) % أبوهم معاوي النجار أمهم % مقابلة الأعراق في آل غامد % 5(@)(@@) % وكم ولدا من صائب الرأي حازم % ومن أريحي وافر العرض ماجد % 6(@)(@@) % وكانوا بها ، والعز في غلوائه % مطاعين في الهيجا طوال السواعد % 7(@)(@@) % وجودهم يكسو الرقاب قلائدا % وبأسهم يفري مناط القلائد % 8(@)(@@) % وقد قايضتهم 
ms173	 إذ أتيح بوارها % % بشرذمة ينميهم شر والد % 9(@)(@@) % هم أفسدوا ، إذ صاهرونا ، أصولنا % % وكم صالح شانته صحبة فاسد % 10(@)(@@) % أرذال من أوباش من تجمع القرى % % يرومون شأوي وهو عند الفراقد % PageV01P579 11(@)(@@) % ولو شاء قومي لم يبل عدوهم % غليل الصدى إلا بسؤر الموارد % 12(@)(@@) % وحاطوا حماهم بي وما استشرفت لهم % غوائله تسري خلال المكائد % 13(@)(@@) % ولكنني أعرضت عنهم فكلهم % يلف على الشحناء أضلاع حاسد % 14(@)(@@) % وأنفع من وصل الأقارب للفتى % % إذا زهدوا فيه جوار الأباعد % PageV01P580 البحر : طويل 1(@)(@@) % إلى الأمن يفضي بالفتى ما يحاذر % فللكلم من يأسو وللكسر جابر % 2(@)(@@) % وكم أنفس لم تنتفع بموارد % وروى صداها بعد يأس مصادر % 3(@)(@@) % فلا تعذلينا يابنة القوم إننا % % بمنزلة تمتاح منها المفاقر % 4(@)(@@) % ولولا انتكاس الدهر زينت أسرة % بنا حيث ألقينا العصا ومنابر % 5(@)(@@) % ونحن سراة الناس في كل موطن % فلا تلزمينا ماجنته المقادر % 6(@)(@@) % وللفقر خير من غنى في مذلة % إذا أخذت منا الجدود العواثر % 7(@)(@@) % وعاداتنا ألا نروم سوى العلا % % وأم المعالي في زمانك عاقر % PageV01P581 البحر : كامل تام 1(@)(@@) % صدت أميمة حين لاح بمفرقي % % شيب يبرح بالمحب الوامق % 2(@)(@@) % لا تعرضي عني فأنت جنيته % وهواك قنع بالمشيب مفارقي % % 3(@)(@@) % ولقد خلعت عليك ما استحسنته % وهو الشباب وذاك جهد العاشق % 4(@)(@@) % وتركتني أرعى النجوم بناظر % يشكو الغرام إلى فؤاد خافق % 5(@)(@@) % فسمحت حتى بالحشاشة في الهوى % % وبخلت حتى بالخيال الطارق % PageV01P582 البحر : بسيط تام 1(@)(@@) % أنا المعاوي أعمامي خلائف من % أبناء عدنان والأخوال من سبإ % % 2(@)(@@) % فما لجدي ولا لي في العلا شبه % وأين شبه أبي سفيان في ملإ % % 3(@)(@@) % ساد الأنام فلم يعدل به أحد % وكل صيد كما قد قيل في الفرإ % 4(@)(@@) % لكنني في زمان أهله همج % وكلهم حين تطريه أبو لجإ % 5(@)(@@) % يا دهر حتام تجفو من تزان به % أما لديك بما يلقاه من نبإ % 6(@)(@@) % تدني اللئام وتقصي كل ذي حسب % وهل يقاس نمير الماء بالحمإ % 7(@)(@@) % فالعبد ريان من نعمى يجود بها % % والحر ملتهب الأحشاء من ظمإ % 8 
ms174	(@)(@@) % والفقر تطفأأنوار الكرام به % كما يقل وميض السيف بالصدإ % PageV01P583 البحر : طويل 1(@)(@@) % أقول لسعدى وهي تذري دموعها % % وقد شافه الغرب النجوم الشوابك % 2(@)(@@) % ذريني أراع النجم في مدلهمة % تخوض دياجيها المطي الأوارك % 3(@)(@@) % فمثلي إذا ما هم لم يثن عزمه % بكاء الغواني والدموع السوافك % 4(@)(@@) % ألم تعلمي أني إذا أخذ الكرى % % مآخذه في العين للنوم تارك % 5(@)(@@) % وموطيء عيسي صفحة الليل والسرى % % كريه إذا ضاقت عليها المبارك % 6(@)(@@) % فإني ابن بيت خيمت عنده العلا % % وناشت ذيول الرسل فيه الملائك % 7(@)(@@) % له الربوات الشم من فرع خندف % ومن يعرب فيه سنام وحارك % 8(@)(@@) % إذا الأموي انحط عن خيلائه % شكاه إلى العلياء فهر ومالك % PageV01P584 البحر : طويل 1(@)(@@) % رأتني فتاة الحي أغبر شاحبا % فأذرت دموعا كالجمان تريقها % % 2(@)(@@) % ولم تدر أني مستهام برتبة % من المجد لم ينهج لغيري طريقها % % 3(@)(@@) % أروم العلا والعدم عنهن حاجز % فتلك لعمري خطة لا أطيقها % % PageV01P585 البحر : طويل 1(@)(@@) % قضت وطرا مني الليالي فلم أبح % بشكوى ولم يدنس علي قميص % 2(@)(@@) % أغالي بعرضي والنوائب تعتري % % وغيري يبيع العرض وهو رخيص % 3(@)(@@) % وقد علمت عليا كنانة أنني % % على ما يزين الأكرمين حريص % 4(@)(@@) % أصون على الأطماع وجها لبشره % إذا عبس الدهر الخؤون وبيض % 5(@)(@@) % فظهري بأعباء الخصاصة مثقل % وبطني من زاد اللئام خميص % PageV01P586 البحر : طويل 1(@)(@@) % تركت العلا والعيس ينفخن في البرى % % لمتشح بالذل إذ قل ماله % 2(@)(@@) % وقد كنت أزجي الأرحبي على الوجى % % فأنزل عنه والكلال عقاله % 3(@)(@@) % فألقيت إذ لم يبق في الأرض مسرح % رحالي فقل في الطرف ضاق مجاله % 4(@)(@@) % وإني لأرضى من زماني ببلغة % وعرضي مصون لم يشنه ابتذاله % 5(@)(@@) % بشرب كولغ الذئب راعته نبأة % وأكل كنوش الصقر مما يناله % PageV01P587 البحر : بسيط تام 1(@)(@@) % أقول والفخر ما اهتز الندي له % ولم ينشره مطوي على فند % 2(@)(@@) % نحن الألى ملك الدنيا أوائلنا % % فمجدهم يسم الأعناق بالصيد % 3(@)(@@) % وما سعى والد منا لمكرمة % لم تحتضن مثلها المسعاة من ولد % 4(@)(@@) % فظل تالدة فينا وطارفة % علا ترف حواشيها على 
ms175	 الحسد % 5(@)(@@) % إذا انتسبنا أحب الناس أنهم % منا ولم نرض أن نعزى إلى أحد % PageV01P588 البحر : كامل تام 1(@)(@@) % ومدجج نازلته في مأزق % يضفو عليه من العجاج رداء % 2(@)(@@) % فشفيت منه النفس حين أعتاده % سفها علي من المخيلة داء % 3(@)(@@) % بصفيحة بيضاء لما شمتها % % دلفت إليه منية سوداء % PageV01P589 البحر : بسيط تام 1(@)(@@) % وفتية من بني سعد طرقتهم % فبت ألبس بالأبطال أبطالا % % 2(@)(@@) % ثم انصرفت وجرد الخيل دامية % صدورهن ولم يكلمن أكفالا % 3(@)(@@) % وكنت أعلمهم أني مجالدهم % بصارمي ، فوفى حر بما قالا % % PageV01P590 البحر : بسيط تام 1(@)(@@) % يا ريم مالي إلا بالهوى شغل % فمنية النفس حيث الأعين النجل % 2(@)(@@) % لولاك ما غرقت في الدمع إذ أرقت % مدامع لم يغازلها الكرى هطل % 3(@)(@@) % وبالفؤاد أناة حين أجذبه % إلى السلو ولكن أدمعي عجل % 4(@)(@@) % فمن لصب بكى شوقا إلى بلد % أقمت فيه وسدت دونه السبل % 5(@)(@@) % إذا الصبا نسمت فاقرأ تحيته % فما له غير أنفاس الصبا رسل % PageV01P591 البحر : طويل 1(@)(@@) % لحى الله من يرنو إلى أمد العلا % % بعين متى تلحظ شبا السيف تشخص % 2(@)(@@) % وغيري إذا ريع استكان وإن يشد % بذكر مساعي قومه يتخرص % 3(@)(@@) % ولي برباع تنبت الذل ربصة % ولولا انتكاس الدهر لم أتربص % 4(@)(@@) % سألحف أهل الأرض ظل عجاجة % إذا لبسته الخيل لم يتقلص % 5(@)(@@) % وفي أم رأسي نخوة أموية % ضمنت لها أن يلثم النجم أخمصي % % PageV01P592 البحر : منسرح 1(@)(@@) % لله قومي فكم ندى خضل % فيهم ، وكم محتد لهم سنم % 2(@)(@@) % وباسم والجياد عابسة % والبيض محمرة الظبا بدم % 3(@)(@@) % لم يتوسد ذراع همته % إلا رأى النجم موطىء القدم % 4(@)(@@) % وإن أضاءت في الليل غرته % أرتك صبحا في حندس الظلم % 5(@)(@@) % من أي أقطاره أتيت ثنى % % إليك أعطافه من الكرم % PageV01P593 البحر : طويل 1(@)(@@) % طرقت أبا عمر و فراع مطيتي % % بواديه كلب ينكر الضيف نابح % 2(@)(@@) % وأعرض عنها وهي دام أظلها % % على لغب ، دمى وريديه ذابح % PageV01P594 البحر : طويل 1(@)(@@) % ووغد حديث بالخصاصة عهده % ألظ به الإثراء حتى تبذخا % % 2(@)(@@) % وعاش أبوه دهره للخنى أبا % وملي جدي 
ms176	 عمره للعلا أخا % % 3(@)(@@) % وما كان عرنين امرىء هو مثله % لتنفخ فيه الكبرياء ويشمخا % % 4(@)(@@) % وأي لئيم لا يصعر خده % إذا افتر عما زحزح الشدة الرخا % % 5(@)(@@) % فطأطأ بيض الهند من نخواته % وبي يخطم الأنف الأشم إذا انتخى % % PageV01P595 البحر : مديد تام 1(@)(@@) % بأبي ريم تبلج لي % % عن رضى في طيه غضب % 2(@)(@@) % وأراني صبح وجنته % بظلام الصدغ ينتقب % 3(@)(@@) % وسعى باكأس مترعة % كضرام النار تلتهب % 4(@)(@@) % فهي شمس بيدي قمر % وكلا عقديهما الشهب % 5(@)(@@) % ولها من ذاتها طرب % فلهذا يرقص الحبب % PageV01P596 البحر : طويل 1(@)(@@) % لعمر أبي وهو ابن من تعرفونه % % لقد ذل عرض لم يصنه إباء % 2(@)(@@) % أيقتادني نحو الدنية مطمع % علي إذا إن لم أذره عفاء % 3(@)(@@) % لوت طرفي حبلي عن الذل همة % لها بمناط الشعريين ثواء % 4(@)(@@) % وحي إذا الأنساب أظلم ليلها % % تبلج عنهم صبحها فأضاؤوا % % 5(@)(@@) % نماني منهم كل أبيض ماجد % على صفحتيه بهجة وحياء % 6(@)(@@) % أغر كماء المزن أخلص نجره % ولم يتورك والديه إماء % 7(@)(@@) % يخوض إذا ما الحرب بزت قناعها % % حياض الردى والمشرفي رداء % 8(@)(@@) % ويعتاده عند الندى أريحية % كما هز أعطاف الخليع طلاء % 9(@)(@@) % ويروى إذاما أمكن الورد جارنا % % وأذوادنا صعر الخدودش ظماء % 10(@)(@@) % ويحلب فينا العيش وسع إنائه % ويرضعه در النعيم ثراء % PageV01P597 11(@)(@@) % ويرعى حمانا مطمئنا جنانه % له من ظبا أسيافنا خفراء % 12(@)(@@) % ونحن إلى الداعي سراع ، وفي الخنى % % يهز مقاريف الرجال بطاء % 13(@)(@@) % فما سكنتنا للهوان خصاصة % ولا حركتنا في الغنى خيلاء % PageV01P598 البحر : كامل تام 1(@)(@@) % ومعرس للهو يسحب ذيله % فيه السحاب ، وطيره يترنم % 2(@)(@@) % زرنا الرياض به وقد بسط الخطا % % فيها الصبا وشقيقها يتبسم % 3(@)(@@) % فكأنما نشرت بهن غلائل % خضر أريق على حواشيها الدم % PageV01P599 البحر : طويل 1(@)(@@) % أقول لسعد وهو للمجد مقتن % وللحمد مرتاد وللعهد حافظ % 2(@)(@@) % أخي أما ترتاح للسير إذ بدا % % سنا لحشاشات الدجنة لافظ % 3(@)(@@) % فهب ينادي صاحبيه وطرفه % عن النجم مزور وللفجر لاحظ % 4(@)(@@) % وظل يبز الناجيات مراحها % % إليك أبا المغوار ، والسير باهظ % 5(@)(@@) % وجاءك والأيام خزر 
ms177	 عيونها % % تلاينه طورا وطورا تغالظ % 6(@)(@@) % فردت بغيظ عنه حين أجرته % فلا الخطب مرهوب ولا الدهر غائظ % 7(@)(@@) % ومد إليك الباع حتى أطاله % بذي قدرة ترفض عنها الحفائظ % 8(@)(@@) % علوت ففقت النجم حتى تخاوصت % إليك عيون الشهب وهي جواحظ % 9(@)(@@) % فسيبك مأمول وجارك آمن % ومشتى ركابي في جنابك قائظ % 10(@)(@@) % أقول لمن يبغى مداك وقد رأى % % عدوك في أرجائه وهو فائظ % PageV01P600 11(@)(@@) % أواضع جفن فوق آخر من كرى % متى لحقت شأو الصميم الوشائظ % 12(@)(@@) % تنبه ونفض غبر النوم فالعلا % % بغيض إليها النائم المتياقظ % 13(@)(@@) % إذا المرء لم يسرع إلى الرشد طائعا % أذيق الردى كرها وفي السيف واعظ % PageV01P601 البحر : كامل تام 1(@)(@@) % نظرت ففاجأت النفوس منون % وشكت قلوب ما جنته عيون % 2(@)(@@) % وبكيت إذ ضحكت فأشبه ثغرها % % دمعي وكل لؤلؤ مكنون % 3(@)(@@) % أأميم إن خفيت عليك صبابتي % % فسلي ظلام الليل كيف أكون % 4(@)(@@) % واستخبري عني النجوم فقد رأت % سهري وأروقة الغياهب جون % 5(@)(@@) % ولئن أذلت مصون دمعي في الهوى % % فعلى البكاء يعول المحزون % PageV01P602 البحر : بسيط تام 1(@)(@@) % الشعر سحر وعندي من روائعه % أصفى من الماء أو أبهى من الدرر % 2(@)(@@) % قدت قوافيه غرا فالرواة لهم % % بهن زهو عتاق الخيل بالغرر % 3(@)(@@) % فهن يغرفن من بحر لرقته % ومن جزالته ينسفن من حجر % 4(@)(@@) % قصائد بدويات وصلت بها % % مقطعات عليها رقة الحضر % 5(@)(@@) % وفقت ساكنة الأبيات من وبر % بها ، ونازلة الأمصار من مدر % 6(@)(@@) % فكل من فاه بعدي بالقريض أتى % % بما تقيل في تحبيره أثري % % PageV01P603 البحر : طويل 1(@)(@@) % أترب الخنى ما لابن أمك مولعا % بترب الندى وابن العلا وأخي الحسب % 2(@)(@@) % أيمشي بعرضي في الأراذل خامل % خفي مساري العرق مؤتشب النسب % 3(@)(@@) % ولي دوحة فوق السماوات فرعها % % وتحت قرار الأرض من عرقها شعب % 4(@)(@@) % فخالي رفيع السمك في العجم بيته % وعمي له جرثومة المجد في العرب % 5(@)(@@) % وليس يجاري مقرف ذا صراحة % من الخيل حتى تستوي الرأس والذنب % 6(@)(@@) % لعمرك إني حين أعتد في الورى % % لكالمندلي الرطب يعتد في الحطب % PageV01P604 البحر : طويل 1 
ms178	(@)(@@) % خليلي إن الأرض ضاقت برحبها % % وكم بين أطراف القنا من منادح % 2(@)(@@) % ولا عز إلا صهلة الخيل في الوغى % % فلا تألفا شدو القيان الصوادح % 3(@)(@@) % وإني لأرجو والرجاء وسيلة % إلى الله أن أكفى تلمس كادح % 4(@)(@@) % وأحظى بملك من جدودي ورثته % فزندي وري وهو في كف قادح % 5(@)(@@) % عجبت من اثنين استضيما وأجحفت % بقدريهما أيدي الخطوب الفوادح % 6(@)(@@) % من ابن كريم لم تصبه خصاصة % ومن أموي للأراذل مادح % PageV01P605 البحر : بسيط تام 1(@)(@@) % لم يعرف الدهر قدري حين ضيعني % % وكيف يعرف قدر اللؤلؤ الصدف % PageV01P606 البحر : بسيط تام 1(@)(@@) % ومنزل برداء العز متشح % وقد رضيناه مصطافا ومرتبعا % % 2(@)(@@) % تكسو علومي عرنين التقى شمما % في حافتيه وأجياد العلا تلعا % % 3(@)(@@) % لما تسنم أعلاه هوى بفتى % يطبق الأرض تيها والسماء معا % % 4(@)(@@) % وكيف يحمل سقف مثله همما % لم يستطع حملها السقف الذي رفعا % % 5(@)(@@) % والله دافع عني إذ رأى شرفا % لو لم أطل باعه بالفضل لا تضعا % % 6(@)(@@) % ولو قضى بالذي نادى الأنام به % لم يلف بعدي شمل المجد مجتمعا % % 7(@)(@@) % فالله أسأل عمرا كلما بلغت % مدى القروح سنوه فر لي جذعا % % PageV01P607 البحر : طويل 1(@)(@@) % ألا ما لحي بالعذيب خماص % فلا مال إلا صارمي ودلاصي % % 2(@)(@@) % مصاليت يغشون المنايا وقولهم % لمن صد عنها لات حين مناص % 3(@)(@@) % أعد لهم للحرب تحرقنا بها % % وقد شرقت بالدارعين عراصي % % 4(@)(@@) % إذا ابتدروا الغايات قربها لهم % وجيف جياد أو ذميل قلاص % 5(@)(@@) % متى يشتمل إنعامنا وإنتقامنا % % على كل دان في البلاد وقاص % 6(@)(@@) % فنحن من القوم الألى قهروا العدا % % بحز رقاب أو بجز نواصي % % 7(@)(@@) % إذا طاوع المقدار لم نحمد الغنى % % ولسنا نذم الدهر حين يعاصي % % PageV01P608 البحر : سريع 1(@)(@@) % الخمر ما أكرم أكفاءها % % فأبعد الهم بإدنائها % % 2(@)(@@) % وهاتها فالديك مستيقظ % والشهب قد همت بإغفائها % % 3(@)(@@) % والليل إن وارتك ظلماؤه % فالراح تجلوه بأضوائها % % 4(@)(@@) % ترى على الكأس إذا صفقت % والحبب الطافي بأرجائها % % 5(@)(@@) % لآلئا في التبر مغروسة % تستوقف العين بلألائها % % 6(@)(@@) % فهي دواء النفس في شربها % % ما تشتهيه وهي 
ms179	 من دائها % % PageV01P609 البحر : طويل 1(@)(@@) % وماضرهم غب الأحاديث أنها % % ستبقى وأيام الحياة قلائل % 2(@)(@@) % فلولا اتقائي وارتقائي عن الخنى % % لقلت ، ولكن الكريم يجامل % PageV01P610 البحر : طويل 1(@)(@@) % دعاني إلى الصهباء - والليل عاقد % نواصيه ظبي في فؤادي كناسه % 2(@)(@@) % وبت لقى من عتبه ومدامه % وريقته والليل ضاف لباسه % 3(@)(@@) % فأسكرني والنجم مرخ نطاقه % جنى الريق لا ما أرعفت منه كاسه % PageV01P611 البحر : طويل 1(@)(@@) % مضى زمن كنت الذنابي لأهله % وفزت بنعمى نش عنك غديرها % % 2(@)(@@) % نعم وقد استوزرت جهلا ، فما الذي % % يرام من الدنيا وأنت وزيرها ؟ % 3(@)(@@) % فلا خطر يا بن اللئام لدولة % وأنت على رغم المعالي خطيرها % % PageV01P612 البحر : طويل 1(@)(@@) % وسرب عذارى من ربيعة عامر % تشابه منها العقد والدمع والثغر % 2(@)(@@) % وفيهن مقلاق الوشاح إذا مشت % وأثقلها الردفان خف بها الخصر % 3(@)(@@) % أقول لها والليل مد رواقه % علينا ولم يهتك جوانبه الفجر % 4(@)(@@) % وقد سفرت عن وجهها فتمزقت % دجاه ولكن رد ظلمته الشعر : % 5(@)(@@) % خذي رمقي إن رمت قتلي فإنه % بقية ما أبقاه حبك والهجر % PageV01P613 البحر : طويل 1(@)(@@) % حلفت بأيمان ينال ذوو الهوى % % بهن الرضى ممن ثنى عطفه العتب % 2(@)(@@) % بفترة ألحاظ هي السيف منتضى % ورقة ألفاظ هي اللؤلؤ الرطب % 3(@)(@@) % وريق يكاد الراح يحكي مذاقه % أظن وظني صادق أنه عذب % 4(@)(@@) % لقد شفني عتب تراخى به المدى % % ومالي بحمد الله غير الهوى ذنب % 5(@)(@@) % ملكت علي العين والقلب بعدها % % فلا العين تعديني عليك ولا القلب % PageV01P614 البحر : طويل 1(@)(@@) % تجافيت عن عز ينال بذلة % وروحت نفسي حين عودتها الياسا % % 2(@)(@@) % ولي همة تستصغر الدهر والورى % % فألئم به دهرا وأخسر بهم ناسا % % PageV01P615 البحر : طويل 1(@)(@@) % وأحور معشوق الدلال مهفهف % يدير إلى العشاق مقلة ريم % 2(@)(@@) % سباني بخد كالصباح منور % وعطفة صدغ كالظلام بهيم % PageV01P616 البحر : طويل 1(@)(@@) % ألكني إلى هذاالوزير وقل له % لقد صرعتنا خلفة الدهر فانعش % 2(@)(@@) % وراع رعاك الله أحوال كوفن % ونقر - هداك الله - عنا وفتش % 3(@)(@@) % فعاملنا يزني ويجني ويعتدي % % وحاكمنا يعلو ويعلى ويرتشي % % PageV01P617 البحر : بسيط تام 1(@)(@@) % أبناء طلحة طابوا 
ms180	 بالندى مهجا % إذ طيب المجد والعلياء محتدهم % 2(@)(@@) % فأمسهم قاصر عن يومهم شرفا % ويومهم حاسد في فضلهم غدهم % 3(@)(@@) % صغيرهم ككبير في اقتناء علا % من تلق منهم تقل لاقيت سيدهم % PageV01P618 البحر : طويل 1(@)(@@) % لقد طفت في تلك المعاهد كلها % % وسيرت طرفي بين تلك المعالم % 2(@)(@@) % فلم أر إلا واضعا كف حيرة % على ذقن ، أو قارعا سن نادم % PageV01P619 البحر : بسيط تام 1(@)(@@) % كفي أميمة غرب اللوم والعذل % فليس عرضي على حال بمبتذل % 2(@)(@@) % إن مسني العدم فاستبقي الحياء ولا % % تكلفيني مديح العصبة السفل % 3(@)(@@) % وشعر مثلي - وخير القول أصدقه - % ماكان يفتر عن فخر وعن غزل % 4(@)(@@) % أما الهجاء فلا أرضى به كرما % % والمدح إن قلته فالمجد يغضب لي % % 5(@)(@@) % وكيف أمدح أقواما أوائلهم % كانوا لأسلافنا الماضين كالخول % 6(@)(@@) % لئن أطاعتني الأقدار وارتجعت % صوارمي إرث آبائي من الدول % 7(@)(@@) % ولم أرو أنابيب الرماح دما % في مأزق برداء النقع مشتمل % 8(@)(@@) % فلا رفعت لساري الليل نار قرى % تكاد ترمي جبين النجم بالشعل % PageV01P620 البحر : متقارب تام 1(@)(@@) % وعدتم وأخلفتم والفتى % % إلى ما يلين به منجذب % 2(@)(@@) % وقد كنت أكذب في مدحكم % فجازيتم كذبا بالكذب % PageV01P621 البحر : طويل 1(@)(@@) % بلينا بقوم يدعون رئاسة % لها طرق يعيى عليهم سلوكها % % 2(@)(@@) % فتبا لدهر قدمتهم صروفه % وما خير دنيا هؤلاء ملوكها % % PageV01P622 البحر : بسيط تام 1(@)(@@) % بكى على حجة الإسلام حين ثوى % % من كل حي عظيم القدر أشرفه % 2(@)(@@) % وما لمن يمتري في الله عبرته % على أبي حامد لاح يعنفه % 3(@)(@@) % تلك الرزية تستوهي قوى جلدي % % والطرف تسهره والدمع تنزفه % 4(@)(@@) % فما له خلة في الزهد تنكرها % % وما له شبه في العلم يعرفه % 5(@)(@@) % مضى وأعظم مفقود فجعت به % من لا نظير له في الخلق يخلفه % PageV01P623 البحر : طويل 1(@)(@@) % أعد نظرا هل شارف الحي ثهمدا % % وقد وشحت أرجاؤه الروض أغيدا % % 2(@)(@@) % جلا الأقحوان النضر ثغرا مفلجا % به ، والشقيق الغض خدا موردا % % 3(@)(@@) % إذا المزن أذرى دمعه فيه خلته % على طرر الريحان درا منضدا % % 4(@)(@@) % وما الجزع من واديه ربعا ألفته 