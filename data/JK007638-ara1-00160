ms141	 % هو في الخطب صخرة صماء % % 12(@)(@@) % وسجايا تنفس الروض منها % % عن نسيم تظله الأنداء % % PageV01P477 البحر : مجزوء الكامل 1(@)(@@) % إسلم وحضرتك المهابه % % للناس أمن أو مثابه % % 2(@)(@@) % أنت الهزبر وإنما % % لك حوزة الإسلام غابه % % 3(@)(@@) % وستغتدي لك أو غدت % % عن صاحب الأمر النيابه % % 4(@)(@@) % إنظر إلى أمل أناخ % ببابك العالي ركابه % % 5(@)(@@) % يا من إذا مضر انتمت % % لعلى نمته في الذؤابه % % 6(@)(@@) % وإذا هي انتضلت بأس % % هم رأيها فله الأصابه % % 7(@)(@@) % وله مكارم غبرت % % حتى بوجهك يا عرابه ) % 8(@)(@@) % لا يستطيع البحر يوما % أن ينوب لنا منابه % % 9(@)(@@) % وله خلال في السماحة % ليس توجد في السحابة % % 10(@)(@@) % رجع الزمان إلى الصبا % % بك إذ أعدت له شبابه % % PageV01P478 11(@)(@@) % أنت الذي اقتدحت بنو % % فهر به زند النجابه % % 12(@)(@@) % عقدت به علم الفخار % فرف منشور الذؤابه % % 13(@)(@@) % سمعا مقالة من أعد % ك للعظيم إذا أرابه % % 14(@)(@@) % يا مبدىء النعما ليك % ملها أعدها مستطابه % % 15(@)(@@) % فيدي وأنت مطيلها % % قصرت فعجل بالإثابه % % 16(@)(@@) % فالحزم شاورني وقا % % ل اهتف به واحمد جوابه % % PageV01P479 البحر : طويل 1(@)(@@) % قفا حييا بالكرخ عني ربيبها % % فيا طيب رياه الغداة وطيبها % % 2(@)(@@) % تفيأ من تلك المقاصر ظلها % % فعطر فيهن الصبا وجنوبها % % 3(@)(@@) % غزال ولكن في الرصافة ناشئ % وهل تألف الغزلان إلا كثيبها % % 4(@)(@@) % فو الله ما أدري ! أرز جيوبه % % على الشمس ، أم زرت عليه جيوبها ؟ % 5(@)(@@) % تعشقته نشوان من خمرة الصبا % % منعم أطراف البنان خضبها % % 6(@)(@@) % لو ان النصارى عاينت نار خده % % إذا أوقدت ناقوسها وصليبها % % 7(@)(@@) % يرشفنيها ريقة عنية % كخلق أبي الهادي روت عنه طيبها % % 8(@)(@@) % فتى كل فخر إن نظرنا قداحه % وجدنا معلاها له ورقيبها % % 9(@)(@@) % تراه الورى في المحل فراج خطبها % % ندى ولدى فصل الخطاب خطيبها % % 10(@)(@@) % إلى الحسن اجتبنا الفلا بنوازع % خفاف ، سيثقلن الحقائب نيبها % % PageV01P480 11(@)(@@) % حلفت بأيديها لسوف أزيرها % % على الكرخ وضاح العشايا طروبها % % 12(@)(@@) % إذا ما طرحنا الرحل عنها بربعه % غفرت لأيام الزمان ذنوبها % % PageV01P481 البحر : كامل تام 1(@)(@@) % يا من لويت به يد الخطب % وبه ثنيت طلايع 
ms142	 الكرب % 2(@)(@@) % ولقيت حد الحادثات به % % ففللت ذا غرب بذي غرب % % 3(@)(@@) % وأرحت آمالي بساحته % % فطرحت ثقل الهم عن قلبي % % 4(@)(@@) % بشرى ( لهاشم ) حيث سالمني % % فيك الزمان ، وكان من حربي % % 5(@)(@@) % فلتشهد الدنيا وساكنها % % أني مخضت لخيرهم وطبي % % 6(@)(@@) % وبحسبهم ذما شهادتها % % أني بغيرك لم أ ل حسبي % % 7(@)(@@) % أنت الذي آباؤه درجوا % % وهم حلي عواطل الحقب % % 8(@)(@@) % يتناقلون الفخر بينهم % % ندب لهم يرويه عن ندب % 9(@)(@@) % مازال صب بالعلاء لهم % % 10(@)(@@) % حتى ورثت عظيم سؤددهم % % كرم الغيوث ، ورفعة الشهب % % PageV01P482 11(@)(@@) % فقبضت عن شرف يد الجدب % % وبسطت عن سرف يد الخصب % % 12(@)(@@) % ومرى مكارمك الثناء كما % % يمري النسيم حلائب السحب % % 13(@)(@@) % طب بأدواء الأمور لها % % تضع الهناء مواضع النقب % 14(@)(@@) % % خصب السنين أليفة الجدب % % 15(@)(@@) % لا بالولود ولا اللبون ولا % % برؤوم غير الشح من سقب % % 16(@)(@@) % من لو عصبت بنان راحته % % بالسيف ما درت على العصب % % 17(@)(@@) % ما الريح ناعمة الهبوب سرت % % سحرا على نزه من العشب % % 18(@)(@@) % بأرق منك خلائقا كرمت % % ممزوجة الصهباء بالعذب % % PageV01P483 البحر : خفيف تام 1(@)(@@) % قد جنى لي الزمان أعظم ذنب % وغدا عنه شاعلي أن يتوبا % % 2(@)(@@) % بخطوب يقول من قد عنته : % هكذا تفحم الخطوب الخطيبا % % 3(@)(@@) % ليت شعري بما اعتذار محب % قد بدا منه ما يسوء الحبيبا % % 4(@)(@@) % فتأمل في قصتي وتعجب ! % أفهل هكذا رأيت عجيبا ؟ % 5(@)(@@) % أنا مستغفر ، وقد أذنب الدهر % نأى معرضا ، وجئت منيبا % % 6(@)(@@) % فتجاوز بفضل صفحك عمن % % لسوى الصفح لم يجيء مستنيبا % % 7(@)(@@) % ثم هب لي جناية الدهر ، يا من % % لم يلد مثلك الزمان وهوبا % % PageV01P484 البحر : خفيف تام 1(@)(@@) % إن في الكرخ بين تلك البيوت % % كم لصب متيم من خفوت % % 2(@)(@@) % ولبيض فضية الجسم كم من % % وجنات تحمر كالياقوت % % 3(@)(@@) % يتعطفن عن غصون رشيقا % % ت ويبسمن عن أغر شتيت % % 4(@)(@@) % كلما أحيت الضحى دعت الشم % % س وقالت لها ، بغيظك موتي % % 5(@)(@@) % مثل موت الحسود غيظا بفخر ال % % حسن الاسم في الورى والنعوت % % 6(@)(@@) % ماجد يخفض التكرم منه % % ما علت فيه عزة 
ms143	 الجبروت % % 7(@)(@@) % عشقت نفسه مفاكهة العليا % % ء حتى لقال حبك قوتي % % 8(@)(@@) % لم يزل بيته على أول الدن % % يا عيال عليه كل البيوت % % 9(@)(@@) % قبلة صلت القوافي إليه % % قانتات بالحمد أي قنوت % % 10(@)(@@) % قد نفى الإثم مصطفى النسك عنه % % مذ بناه على التقى للثبوت % % PageV01P485 11(@)(@@) % يا بن قوم ما ناضلوا الخصم إلا % شغلوه بسنة المنكوت % % 12(@)(@@) % خلق الناس للكلام ولكن % % خلقوا إن نطقتم للسكوت % % PageV01P486 البحر : طويل 1(@)(@@) % عشقت ظماء الكسح لا بل غرائها % % تود الثريا أن تكون رعاثها % % 2(@)(@@) % من الخرد الوسنانة اللحظ حرمت % % على العين مني أن تذوق حثاثها % % 3(@)(@@) % نشت في خدور عنك فتيان عامر % حمت بذكور المرهفات إناثها % % 4(@)(@@) % ومرتبعات في رياض كأنما % % ندى حسن في واسم منه غاثها % % 5(@)(@@) % كأخلاقه أزهارها اللآء دبجت % % بوطفاء خلنا من يديه انبعاثها % % 6(@)(@@) % شأى في المعالي والمكارم والنهى % % فأحرز غايات الفخار ثلاثها % % 7(@)(@@) % همام به لاقست أبناء عصره % ومن بالصقور الغلب قاس بغاثها % % 8(@)(@@) % تراه بنو الآمال في المحل غيثها % % وعند طروق النائبات غياثها % % 9(@)(@@) % تردت ثياب العيش فيه قشيبة % وعند سواه قد تردت رثائها % % 10(@)(@@) % من القوم لا تلقى سوى الحمد كسبها % % وليس ترى إلا المعالي تراثها % % PageV01P487 11(@)(@@) % معودة سبق السؤال صلاتها % % فإن هي لم تسبق وإلا استراثها % % 12(@)(@@) % وكم لفتى لاثت مآزرها العلى % % فما حمدت إلا عليك ملاثها % % PageV01P488 البحر : كامل تام 1(@)(@@) % فيك العلاء مضيئة أبراجها % % فلأنت بدر سمائها وسراجها % % 2(@)(@@) % وبك ابتهاج أسرة الشرف التي % % لولاك بعد أخيك عطل تاجها % % 3(@)(@@) % أقبلتما تتجاريان لغاية % لم يستقم لسواكما منهاجها % % 4(@)(@@) % سبق الأنام لها وجئت مصليا % ومعا ملطمة أتت أفواجها % % 5(@)(@@) % حتى استوت قدما كما في ذروة % للمجد عز على الورى معراجها % % 6(@)(@@) % هو مصطفى الشرف الذي من بعده % % وجدته أكرم من عليه معاجها % % 7(@)(@@) % أنت الذي ارتشف الورى من خلقه % % راحا ألذ من الرحيق مزاجها % % 8(@)(@@) % ما اعتلت الدنيا بداء جدوبها % % إلا وجودك طبها وعلاجها % % 9(@)(@@) % ولقد حميت وئيدة الكرم التي % % لولاك ما سلمت لها أوداجها % % 10(@)(@@) % نسجت 
ms144	 لك العليا ملابس فخرها % % فزهى عليك مطرزا ديباجها % % PageV01P489 11(@)(@@) % لم تحد مدلجة الركائب رغبة % إلا وكان لربعكم إدلاجها % % 12(@)(@@) % ما طرقت أم الرجاء لآمل % إلا وأصبح من نداك نتاجها % % PageV01P490 البحر : كامل تام 1(@)(@@) % طمحت إليك فما ألذ طماحها % % هيفاء راض لك الغرام جماحها % % 2(@)(@@) % وحبتك للتقبيل منها وجنة % تحمي بعقرب صدغها تفاحها % % 3(@)(@@) % خوطية العطفين ذات موشح % منه على غصن تدير وشاحها % % 4(@)(@@) % مجدولة بيضاء رائقة الصبا % % ملكت على أهل الورى أرواحها % % 5(@)(@@) % وبمسقط العلمين غازلت الدمى % % فعلقتها مرضى العيون صحاحها % % 6(@)(@@) % من كل صاحية الشمائل لم يزل % % سكر الدلال بما يطيل مراحها % % 7(@)(@@) % زفت إلي كخدها عنبية % خضبت بلون الراح منها راحها % % 8(@)(@@) % وتروحت ذات الأراك بنفحة % منها فشاق عبيرها مرتاحها % % 9(@)(@@) % وإلى أبي الهادي بعثت بمثلها % % في الحسن ما استجلى سواه ملاحها % % 10(@)(@@) % لأغر يبسط في المكارم راحة % بيضاء تمتاح الورى مصلاحها % % PageV01P491 11(@)(@@) % ما استغلقت لبني المكارم حاجة % إلا وكان بنانه مفتاحها % % PageV01P492 البحر : خفيف تام 1(@)(@@) % رف قلب المشوق لا للملاح % بل لشوق إليكم وارتياح % 2(@)(@@) % لو ملكت الهوى لطرت إليكم % % يا جناحي وأين مني جناحي % % 3(@)(@@) % في نواحي الفؤاد أنتم وقلبي % % معكم ساكن بتلك النواحي % % 4(@)(@@) % وإليكم مهما شدت ذات طوق % طرب الصب لا لذات الوشاح % % 5(@)(@@) % يا رقودا ( ببابل ) لا علمتم % % كيف يمسي أخو الحشا المرتاح % % 6(@)(@@) % كم أرقنا إلى الصباح ولا والله % لم أعن غيركم من صباح % % 7(@)(@@) % وانتشقنا الرياح نطلب ذروا % من شذا ، ذكرة يجيب الرياح % % 8(@)(@@) % من لعيني بطلعة هي منكم % % طلعة البشر ، طلعة الأفراح % % 9(@)(@@) % من سناكم حرمت حتى بقلبي % % سقط شوق رزقت فيه اقتداحي % % 10(@)(@@) % فعلى الوجد ما أرق فؤادي % % وعلى البعد ما أشق اطراحي % % PageV01P493 11(@)(@@) % نضحت جوكم ولكن بطل % من جفوني ندية الأرواح % % 12(@)(@@) % لي ( بفيحائكم ) علاقة ود % ما محا خطها من القلب ماحي % % 13(@)(@@) % فاخرت أرضها السماء وقالت : % يا سما واجب عليك امتداحي % % 14(@)(@@) % أتباهين ' بالضراح ' وعندي % % بيت من كان فيه فخر الضراح % % 15(@)(@@) % سادة جودهم تبطح من قبل 
ms145	 % فسادوا به قريش البطاح % % 16(@)(@@) % وكفاهم ( بجعفر ) الجود فخرا % في علا شامخ ومجد صراح % % 17(@)(@@) % يا زعيم العلى ونعم زعيم % منه تأوي لسيد جحجاح % % 18(@)(@@) % ملء عين الدنيا مثلت ولكن % % بين بردي تكرم وسماح % % 19(@)(@@) % وطببت الزمان حتى لنادى : % بك حسبي سبرت غور جراحي % % 20(@)(@@) % إن يكن في لقاك قصر خطوي % % فلقد طال في علاك امتداحي % % PageV01P494 21(@)(@@) % لك مني ، كما اقترحت ، ولاء % موجب لي عليك نيل اقتراحي % % PageV01P495 البحر : خفيف تام 1(@)(@@) % يا شريفا به يزان المديح % ويراض الزمان وهو جموح % 2(@)(@@) % وإلى باب فضله ينتهي القص % % د وفي ربعه الرجاء يريح % % 3(@)(@@) % صالحا للسماح جئت بعصر % فيه حتى الحيا المرجى شحيح % % 4(@)(@@) % ومسحت السماح ميتا بكف % عاد حيا بها فأنت المسيح % % 5(@)(@@) % لك لاحت مناقب زاهرات % مثلها ليس في السماء يلوح % % 6(@)(@@) % ويد بالندى تحلب طبعا % لا كما تحلب الغمائم ريح % 7(@)(@@) % فالحيا لا يميحنا ما يميح % وهو دأبا من درها يستميح % % 8(@)(@@) % غبت يا منهضي ، وأقعدني الده % % ر ، وعندي من صرفه تبريح % % 9(@)(@@) % فبعثت الرجاء نحوك وفدا % واثقا أنه رجاء نجيح % % 10(@)(@@) % فأنلني على تباعد وادينا % % يدا أغتدي بها وأروح % % PageV01P496 11(@)(@@) % فأقم للضراح مجدك سام % ولحساد مفخريك الضريح % % 12(@)(@@) % صدر نادي العلى له أنت قلب % ولجسم الزمان شخصك روح % % PageV01P497 البحر : خفيف تام 1(@)(@@) % حمد الركب في حماك مناخه % % حيث ربى طير الرجا أفراخه % % 2(@)(@@) % يا أخا المكرمات كم من صريخ % لبني الدهر أغثت صراخه % % 3(@)(@@) % وبكم العطاء كم مسحت كف % ك عينا بدمعها نضاخه % % 4(@)(@@) % ما دعاك الأنام للخطب إلا % وبنعليك قد وطأت صماخه % % 5(@)(@@) % كم حمدنا نقاء كفك جودا % عند كف بخلا ذممنا اتساخه % % 6(@)(@@) % ونسخنا فضل الكرام ومن قر % % آن علياك قد عرفنا انتساخه % % 7(@)(@@) % قمت في ريق الشبيبة حتى % % سدت في الدهر بالنهى أشياخه % % 8(@)(@@) % غاض ماء الندى عن الوفد إلا % من يديكم فما تغب نقاخه % % 9(@)(@@) % إن بن الندى وبينك عقدا % أمنت وفد راحتيك انفساخه % % 10(@)(@@) % إنما أنتم فروع فخار % كان قدما آباؤكم أسناخه % % PageV01P498 11 
ms146	(@)(@@) % حيث ثوب الرجاء ما رث إلا % واليكم منه أجد انسلاخه % % 12(@)(@@) % هاك يابن الكرام بنت قريض % شمخت أن ينيلها ( شماخه ) % PageV01P499 البحر : رجز تام 1(@)(@@) % عيشك غض والزمان أغيد % وطرف حسادك فيه أرمد % 2(@)(@@) % يا لابس النعماء هنيت بها % % ملابسا كساكهن أمجد % % 3(@)(@@) % أقبح شيء أن تذم زمنا % حسبك فيه ( حسنا محمد ) % 4(@)(@@) % يا أعين الوفاد قري بفتى % في مطلع العلياء منه فرقد % % 5(@)(@@) % ذاك الذي كلتا يديه لجة % يطيب للعافين منها المورد % 6(@)(@@) % مبارك الطلعة مرهوب الحمى % % في بردتيه قمر وأسد % % 7(@)(@@) % موقر المجلس ذو ركانة % حبوته على ( شمام ) تعقد % % 8(@)(@@) % بالفصل في صدر الندي ناطق % كأنما لسانه مهند % % 9(@)(@@) % سقيط طل لك من بيانه % % أو لؤلؤ في سلكه منضد % 10(@)(@@) % روضة فضل يجتني رائدها % % زهرا بطيب النشر عنه يشهد % % PageV01P500 11(@)(@@) % ينمى لقوم في الزمان خلقوا % % جواهرا يزان فيها الأبد % % 12(@)(@@) % هم خير من رشحه لسؤدد % مجد وأزكى من نماه محتد % % PageV01P501 البحر : رمل تام 1(@)(@@) % بوركت طلعتك الغراء يا % % قمرا في فلك العلياء مفرد % % 2(@)(@@) % أنت ريحانة فضل لا أرى % % مثل رياها بهذا العصر يوجد % % 3(@)(@@) % لك ذكر نشره يهدي شذا % فيه أنفاس النسيم الغض تشهد % % 4(@)(@@) % ولسان في القضايا ذرب % ينطق الفصل ، إذا الفصل تردد % % 5(@)(@@) % وبيان لو يجارى سحره % سحر ' هاروت وماروت ' لبلد % % 6(@)(@@) % عقد الألباب تنحل به % % وبه ينتظم الأمر فيعقد % % PageV01P502 البحر : متقارب تام 1(@)(@@) % شهدت لنفسك أن الكمال % % أتى معها يوم ميلادها % % 2(@)(@@) % كما شهدت لك أم العلى % % بأنك أكرم أولادها % % 3(@)(@@) % رضعت النجابة في حجرها % % وضمك أطهر أبرادها % % 4(@)(@@) % فكفك كعبة معروفها % % ووجهك قبلة قصادها % % 5(@)(@@) % تكاثر في جانبيك الضيوف % % نجوم السماء بأعدادها % % 6(@)(@@) % تعللها وببرد الحديث % % تزيل حرارة أكبادها % % 7(@)(@@) % فتسمي وبشرك عن مائها % % ينوب ، وخلقك عن زادها % % 8(@)(@@) % فعال أخي كرم أرغمت % % مكارمه أنف حسادها % % 9(@)(@@) % وذهنك لو لم يكن روضة % لما أتحفتنا بأورادها % % 10(@)(@@) % ترف بأنفاسك الطيبات % عليها حشاشة روادها % % PageV01P503 11(@)(@@) % لك الفائقات بنات القريض % بإنشائها وبإنشادها % % 12(@)(@@) % تود الكواعب منها تخط 
ms147	 % طراز الجمال بأجسادها % % 13(@)(@@) % فلو بمذهبها قلدت % % لزان مفضض أجيادها % % 14(@)(@@) % ولو بمسكها ضمخت % % رمت بالغوالي لأضدادها % % 15(@)(@@) % ولو لعواقدها سحرها % % لحلت به عزم آسادها % % 16(@)(@@) % فلا زلت قرة عين العلى % % وسيد سائر أمجادها % % 17(@)(@@) % لها كهف عزك أمن المروع % وجودك كافل وفادها % % 18(@)(@@) % ودم للسماحة يا بحرها % % فجودك أروى لورادها % % PageV01P504 البحر : متقارب تام 1(@)(@@) % فتى منه أرضعت المكرمات % % ربيب نهى طاهر المولد % % 2(@)(@@) % ترعرع والجود في باحة % بها قد ترشح للسؤدد % % PageV01P505 البحر : رجز تام 1(@)(@@) % قل لأبي الهادي الذي ما أخذت % % بنو الثنا من الثنا ما أخذا % % 2(@)(@@) % لله في ثوب الزمان واحد % منك بغير المدح ما تلذذا % % 3(@)(@@) % سموت فانحط سواك قائلا : % من طلب الرفعة فليسم كذا % % 4(@)(@@) % يرقى ذرى العلياء من بحجرها % % نشا ، وفي لبانها المحض اغتذى % % 5(@)(@@) % ذو فكرة لم ترم في شاكلة % بسهمها إلا وفيها نفذا % % 6(@)(@@) % وذو لسان في الخصام لم يزل % % أقطع من حد حسام شحذا % % 7(@)(@@) % يسكت لكن بجواب حاضر % يترك أكباد الخصوم فلذا % % 8(@)(@@) % فاردد أحاديث الصبا إن كن لم % % يروين عن شمائل منه الشذا % % 9(@)(@@) % لا حبذا إن لم يذعن نشره % % وإن أذعن نشره فحبذا % % 10(@)(@@) % كم قد أقام الدهر عن فريسة % من برثن الخطب لها منتقذا % % PageV01P506 11(@)(@@) % يطرد شيطان العنا عن نفسه % % من بسماح كفه تعوذا % % 12(@)(@@) % حكى رجاء الوفد لولا جوده % ' يونس ' لما بالعراء نبذا % % PageV01P507 البحر : خفيف تام 1(@)(@@) % عين فتانه لها القلب خدر % سحرتني وأعين الغيد سحر % 2(@)(@@) % طفلة الحي شأنها اللهو لكن % % حالتا لهوها خضاب وعطر % % 3(@)(@@) % أقرأتني الجمال حرفا فحرفا % وهو في صدرها المطرز سفر % % 4(@)(@@) % وجلت لي وما سوى الثغر كأس % وسقتني وما سوى الريق خمر % % 5(@)(@@) % وهدتني بوجهها وهو بدر % تحت ليل أظلني وهو شعر % % 6(@)(@@) % نشرته دلا علي ولفت % % ني عناقا فلذ لف ونشر % % 7(@)(@@) % يا سقى عهدها حيا من ثنايا % % ها ودمعي لها وميض وقطر % % 8(@)(@@) % جرحتني بلحظها ثم قالت : % هل لجرح الهوى بقلبك سبر ؟ % 9(@)(@@) % لا وكأسي محمد حسن الفخر 
ms148	 % بقلبي جرح الهوى مستمر % % 10(@)(@@) % حي في مطلع السماح هلالا % عن عيون الراجين لا يستسر % % PageV01P508 11(@)(@@) % ولدته العلياء أنجب من قد % % حملاه للمجد بطن وظهر % % 12(@)(@@) % مستهلا على يد اليمن فيه % % بارك السعد وهو طهر أعز % 13(@)(@@) % ونما في العلاء غصن صباه % % وهو من ريق المحاسن نضر % % 14(@)(@@) % ما نضا بردة الشباب ومنه % % ملء برد الزمان مجد وفخر % % 15(@)(@@) % خلفكم يا مشايخ الحزم عجزا % فات سبقا كهل التجارب غر % 16(@)(@@) % من إذا حلبة الخطابة فيها % % ضمه والخصوم سبق وحضر % % 17(@)(@@) % قال بالفصل ناطقا فأرموا % % وادعى الفضل سابقا فأقروا % % 18(@)(@@) % وروى نثره الفريد فقالوا : % أكلام بفيه أم فيه در ؟ % 19(@)(@@) % يده ليس تألف الدرهم المضرو % % ب مكثا لكن عليها يمر % 20(@)(@@) % كره البخل مذ ترعرع حتى % % سمعه عن سماع لا فيه وقر % % PageV01P509 21(@)(@@) % وإلى الآن ليس يدري سوى قول % % بلى منذ قالها وهو ذر % 22(@)(@@) % سل به الأرض بالوقار وبالأط % % واد أيا على قراها أقر % 23(@)(@@) % وعلى وجهها إذا اغبر جدبا % أنداه أم الغمام أدر % 24(@)(@@) % ذو محيا يكاد يقطر ماء ال % % بشر منه لو كان للبشر قطر % % 25(@)(@@) % وسجايا كالروض باكره الطل % نسيم الصبا عليه يمر % 26(@)(@@) % ومزايا تكاثر الشهب عدا % % وبها لا يحيط نظم ونثر % % 27(@)(@@) % فهو والمكرمات روح وجسم % ووشاح يزينها وهو خصر % % 28(@)(@@) % وبإيداعها له السر لطف % وبتفويضها له الأمر جبر % 29(@)(@@) % يا أخا المكرمات وهو نداء % أجد المكرمات فيه تسر % 30(@)(@@) % هاك سيارة مع الريح لكن % % تلك شهر رواحها وهي دهر % % PageV01P510 31(@)(@@) % بنت فكر على النوى لك أمت % % لم يلد مثلها لمثلك فكر % % 32(@)(@@) % كلما أثقل الحيا من خطاها % % خف فيها هوى إليك مبر % 33(@)(@@) % ذات علم مهما يطل ليل هم % كل ليل يأتي بعقباه فجر % % 34(@)(@@) % وعناء المسرى يزول إذا طا % % ب لها بعده لديك المقر % 35(@)(@@) % حيها خير ما اجتليت عروسا % بنت يوم لها قبولك مهر % % 36(@)(@@) % أخت عذر جاءت على العتب تسعى % % ألها إذ تأخرت عنك عذر % % PageV01P511 البحر : بسيط تام 1(@)(@@) % أيامنا بك 
ms149	 بيض كلها غرر % % وعيشنا بك غض مونق نضر % 2(@)(@@) % ووجهك المتجلي للندى مرحا % من نوره تستمد الشمس والقمر % % 3(@)(@@) % يا شمس داره أفق المجد كم لك من % % صنايع لم تكن بالعد تنحصر % 4(@)(@@) % لله كم لك من معنى تحير في % % إدراكه العقل والأوهام والفكر % % 5(@)(@@) % قد قلت للمبتغي جهلا علاك لقد % % جريت لكن عنها شأنك القصر % % 6(@)(@@) % تبغي على ماجد ما رامه أحد % إلا وعاد بطرف عنه ينحسر % % 7(@)(@@) % ذاك الذي ما جرى يوما لنيل على % % إلا وقصر عن إدراكه البصر % % 8(@)(@@) % كم زرته فرأيت الأرض قد جمعت % % في مجلس لفتى فيه استوى البشر % % 9(@)(@@) % في العسر واليسر فيه لم يخيب أمل % ولا تغير من أخلاقه الغير % % 10(@)(@@) % كأنما صلة الوفاد واجبة % عليه نصت به الآيات والسور % % PageV01P512 11(@)(@@) % لولاه أصبحت الدنيا بأجمعها % % ما للسماح بها عين ولا أثر % % 12(@)(@@) % وليس بالسحب من بخل إذا انقشعت % % لكنها لحياء منه تستر % % PageV01P513 البحر : متقارب تام 1(@)(@@) % ولاؤك أنفس ما يذخر % ومدحك أطيب ما ينشر % 2(@)(@@) % وودك أيمن ما يقتنى % % وضعك أحسن ما يشكر % % 3(@)(@@) % كبرت عن المثل ، حتى الزمان % % بجنب علائك مستصغر % % 4(@)(@@) % فاطهر ما كان ماء السماء % وأنت ولكنك الأطهر % % 5(@)(@@) % جرت والصبا كرما راحتا % % ك ، فأمطرتا ما تمطر % % 6(@)(@@) % وناظر خلقك زهر الرياض % فأخجلها إذ هو الأزهر % % 7(@)(@@) % فيا من نشى والنهى وارتبى % % بحجر العلى هو والمفخر % % 8(@)(@@) % دعتك المكارم قبل الفطام % % لما عنه أشياخها تقصر % % 9(@)(@@) % وقالت : أعد في ليل الضيوف % بوجهك وهو لهم مقمر % % 10(@)(@@) % وأكثر كما اشتهت المكرمات % % ففاكهة الكرم المكثر % % PageV01P514 11(@)(@@) % فقمت كما اقترحت بالذي % % له صغر الخبر المخبر % % 12(@)(@@) % تحيي لك الوفد وجها أغر % يكاد لرقته يقطر % % 13(@)(@@) % فلا يحمد الورد إلا لديك % % إذا ذم من غيرك المصدر % % 14(@)(@@) % عجبت ولازال لي من نداك % % وخلقك يظهر ما يبهر % % 15(@)(@@) % فمعتصر ذا ولا يسكر % % وذا مسكر وهو لا يعصر % % 16(@)(@@) % فيا من تفرع من دوحة % بغير المكارم لا تثمر % % 17(@)(@@) % تفيأت ظلك حيث الزمان % هجير البلاء به 
ms150	 يسعر % % 18(@)(@@) % ونادمت أخلاقك الزاهرات % % كأني في روضة أحبر % % 19(@)(@@) % وألقيت في آهل من حماك % % عصى السير أحمد ما أبصر % % 20(@)(@@) % بحيث أديم الثرى طيب % ندي وروض النهى يزهر % % PageV01P515 21(@)(@@) % وقلت لنفسي : بلغت المنى % % بلبثك حيث زكى العنصر % % 22(@)(@@) % به قد طرحت كبار الهموم % ومنهن همته أكبر % % 23(@)(@@) % فكيف اعترت عزمه فترة % وما كنت أحسبه يفتر % % 24(@)(@@) % وعهدي به كنت ألقى الخطوب % % على قلتي وبه أكثر % % 25(@)(@@) % وبت أراجع نفسي بذاك % % وأنظر ماذا به تخبر % % 26(@)(@@) % أذاكرها : هل أعدت سواك % % فتخلف بالله ما تذكر % % 27(@)(@@) % أبن لي فنفسي دون الوقوف % على واقع الأمر لا تصبر % PageV01P516 البحر : كامل تام 1(@)(@@) % باتت تروحني بنشر عبيرها % % بيضاء تطوي النيرين بنورها % % 2(@)(@@) % وجلت علي مدامة بمفاصلي % % منها وجدت فتور عين مديرها % % 3(@)(@@) % ورأيت شعلة خذ ها في كأسها % % قد أوجستها مهجني بضميرها % % 4(@)(@@) % وغدت تفاكهني عشية أقبلت % % بفنون دل بت طوع غرورها % % 5(@)(@@) % فرنت بناظرتي عقيلة ربرب % بكرت تربع إلى بطاف غديرها % % 6(@)(@@) % ودنت إلي وأسفرت عن وجنة % حسدا تموت الشمس عند سفورها % % 7(@)(@@) % وصفت لعيني في بدايع حسنها % % خور الجنان فحلتها من حورها % % 8(@)(@@) % ثم انثنت خجلا تصد بمقلة % سرقت من الآرام لحظ غريرها % % 9(@)(@@) % وتبسمت سرا فأومض بارق % لعذيب مبسمها قضى بسرورها % % 10(@)(@@) % فأضاء ليلة وصلها حتى غدت % % لا فرق بين عشيها وبكورها % % PageV01P517 11(@)(@@) % فتغيرت خوف الرقيب ، لعلمها % % بمكانها مني ، يشي لغيورها % % 12(@)(@@) % فتسترت بظفائر لو تحتها % % سرت الكواكب ما اهتدت لمسيرها % % 13(@)(@@) % باتت ترفرف بين أنفاس الصبا % % وتضوع بين ورودها وصدورها % % 14(@)(@@) % حتى لقد حملت شذا من عرفها % % أشفقت تعرفه الورى بعبيرها % % 15(@)(@@) % فوددت أقطع كف ما شطة الصبا % % كي لا ترجل شعرها بمرورها % % 16(@)(@@) % ولئن ظننت على النسيم بها فلا % % عجب ولو وافى بوقت هجيرها % % 17(@)(@@) % فبمقلتي لو لم أخف إنسانها % % لحجبتها عن لحظ عين سميرها % % 18(@)(@@) % وكذبت ما في العين إنسان ولا % % في العالمين صغيرها وكبيرها % % 19(@)(@@) % من أين إنسان لعيني غيرها % % والناس غير أبي الحسين أميرها % % 20(@)(@@) % ألها 
ms151	 أمير في البلاغة غيره % % وبها تشير إليه كف مشيرها % % PageV01P518 21(@)(@@) % ولئن إليه غدت تشير فإنها % % ما أدركته بفكرها لقصورها % % 22(@)(@@) % بل عين فكرتها رأت إنسان ع % % ين زمانه في نوره لا نورها % % 23(@)(@@) % فرأت مناقب منه ( فاروقية % % ما أن تزينت السما بنظيرها % % 24(@)(@@) % ومآثرا ' عمرية ' بقليلها % % كثرت عداد الشهب لا بكثيرها % % 25(@)(@@) % وخلائقا رشفت سلافتها الورى % % فغدت بها سكرى ليوم نشورها % % 26(@)(@@) % هيهات بنت الكرم منها إنها % % بنت المكارم قد ذكت بعبيرها % % 27(@)(@@) % محلوبة من كرمها مشمولة % بنسيمها ممزوجة بنميرها % % 28(@)(@@) % نفحت بعارفة علي خطيرة % قد أفحمت مني لسان شكورها % % 29(@)(@@) % باتت لدي ولست أكفرها يدا % ما للغمام يد بفيض غزيرها % % PageV01P519 30(@)(@@) % جذبت بضبعي فارتقيت بها على % % هام المجرة رافلا بجيرها % % 31(@)(@@) % فلو أن أعضائي تحول ألسنا % تثني عليه إلى انقطاع دهورها % % 32(@)(@@) % بقصائد حبات قلبي لفظها % % وسواد أحداقي مداد سطورها % % 33(@)(@@) % ما كنت أبلغ شكره فيها ولو % % أني ملأت الكون في تحريرها % % 34(@)(@@) % أم كيف أشكره الصنيعة بالثنا % % ومتى يقوم حقيره بخطيرها % % 35(@)(@@) % مع أنه مفض لما لا ينتهي % % ومن الأمور به ارتكاب عسيرها % % 36(@)(@@) % فالحق فيه أن أحبر مدحة % أشكره في أخرى على تحبيرها % % 37(@)(@@) % إذ من معادن فضله نظمتها % % وبه اهتديت إلى التقاط شذورها % % 38(@)(@@) % هو ذاك منتجع الفصاحة مجتنى % % ثمر البلاغة مستمد غزيرها % % 39(@)(@@) % رب القوافي السائرات بحيث لم % % يقطع نهاية سيرها ابن أثيرها % % PageV01P520 40(@)(@@) % وكمي مزبرة ترى لسن الضبا % % خرسا إذ نطقت بآي زبورها % % 41(@)(@@) % لو شاء يوما ساق أرواح العدى % % صلة لموصول الردى بصريرها % % 42(@)(@@) % من عن لسان الروح أصبح ناطقا % لا عن لسان لبيدها وجريرها % % 43(@)(@@) % بزواهر نجمت فأطفأ ضوؤها % % شعل النجوم الزهر عند ظهورها % % 44(@)(@@) % وكأنما طبعت بمرآة السما % % بدل الكواكب شكلهن بنورها % % 45(@)(@@) % لم ينشها إلا عقودا ، ناثرا % لنظيمها ، أو ناظما لنثيرها % % 46(@)(@@) % مدحا يفضلهن ما بين الورى % % لنذيرها الهادي وآل نذيرها % % 47(@)(@@) % حيث القوافي ما برحن فواركا % لم تمنح الشعراء غير نفورها % % 48(@)(@@) % واليوم قد صارت طروقة فحلها % % منه وقر 
ms152	 نفارها بمصيرها % % 49(@)(@@) % مسكت خطام قيادها يده وهم % % لم يمسكوا إلا خطام غرورها % % PageV01P521 50(@)(@@) % وله ذكور اللفظ دون إناثها % % ولهم إناث اللفظ دون ذكورها % % 51(@)(@@) % لا زال منها ناظما ما لم يدع % % فضلا لأولها ولا لأخيرها % % PageV01P522 البحر : متقارب تام 1(@)(@@) % ودار علا لم يكن غيرها % % لدائرة الفخر من مركز % 2(@)(@@) % بها قد تضمن صدر الندي % فتى ليديه الندى يعزي % % 3(@)(@@) % صليب الصفاة صليب القناة % عود معاليه لم يغمز % 4(@)(@@) % أرى المدح يقصر عن شأوه % فأطنب إذا شئت أو أوجز % % 5(@)(@@) % فلست تحيط بوصف إمرء % نشا هو والمجد في حيز % % 6(@)(@@) % ربيب المكارم ترب السماح % % قرى المعتفي ثروة المعوز % 7(@)(@@) % فأي العوارف لم يبتدء % % وأي المواعيد لم ينجز % % 8(@)(@@) % فتى في صريح العلى ليس فيه % % لكاشح علياه من مغمز % 9(@)(@@) % وذو هاجس أينما رجه % % فما طلب الغيب بالمعجز % % 10(@)(@@) % تراه خبيرا بلحن المقال % بصيرا بتعمية الملغز % % PageV01P523 11(@)(@@) % نسجن المكارم أبراده % وقلن لأيدي الثنا : طرزي % % 12(@)(@@) % ترى الدهر يحلب من كفه % % لبون ندى قط لم تعزز % % PageV01P524 البحر : متقارب تام 1(@)(@@) % أدر يا نديمي علينا الكؤوسا % % فقد شاقت الراح منا النفوسا % % 2(@)(@@) % نشطنا عشيا لشرب المدام % % فارعش بكأسك منا الرؤوسا % % 3(@)(@@) % وقم هاتها من بنات الكروم % % على ورد خديك تجلى عروسا % % 4(@)(@@) % كأن الندامى على شربها % % بدور دجى تتعاطى شموسا % % 5(@)(@@) % تداعوا لنيرانها ساجدين % % ودعواهم لا عد منا المجوسا % % 6(@)(@@) % سأحبس ما عشت ركب الرجاء % % بحيث يفك النوال الحبيسا % % 7(@)(@@) % لدى من تخيرت المكرمات % على نحرها منه عقدا نفيسا % % 8(@)(@@) % له المجلس المحتبي بالنهى % % يراع به من يروع الخميسا % % 9(@)(@@) % وقل بأن يفرش الفرقدين % % ويتخذ البدر فيه جليسا % % 10(@)(@@) % فيا بن نجوم جرت في العلاء % % لقوم سعودا وقوم نجوسا % % PageV01P525 11(@)(@@) % غدا بك يوم الندى ضاحكا % ويوم العدى عاد جهما عبوسا % % 12(@)(@@) % بقيت على عطل الحاسدين % % تحلي يد المدح فيك الطروسا % % PageV01P526 البحر : رمل تام 1(@)(@@) % حازم يسلس من بعد الشماس % كل أمر راضه صعب المراس % % 2(@)(@@) % ذو ذكاء لو ذكاء رامه % لدعاه عجزه عد 
ms153	 بأياس % % 3(@)(@@) % قتل الأيام خبرا وله % % قبس التجريب أسنى الاقتباس % % 4(@)(@@) % لو سيوفا طبعت آراؤه % % لبرت ما أدركت حتى الرواسي % % PageV01P527 البحر : مجزوء الكامل 1(@)(@@) % ولرب ريم طرفه % % بالهدب سهم اللحظ راشا % % 2(@)(@@) % ورمى به صبا لفرط % ضناه يرتعش ارتعاشا % % 3(@)(@@) % قالت : جنحت لسلوة % فانظر لسهمك كيف طاشا % % 4(@)(@@) % فأجبتها : لا والذي % % جعل النهار لنا معاشا % % 5(@)(@@) % أنا في سبيل هوى الكوا % % عب أرقط العشاق جاشا % % 6(@)(@@) % هيهات أسلو أو يقال % سلا الندى حسن وحاشا % % 7(@)(@@) % ذاك الذي لحوائم الآ % % مال لم يترك عطاشا % % 8(@)(@@) % مذ قام للعليا مؤم % لها وبحر علاه جاشا % % 9(@)(@@) % ماتت نفوس الحاسدين % % بغيضها والفضل عاشا % % 10(@)(@@) % من لو تساجله الغيوث % أراك وابلها رشاشا % % PageV01P528 11(@)(@@) % تستشعر الأسد الغضاب % % لعظم هيبته اندهاشا % % 12(@)(@@) % وعلى سراج جبينه الآ % % مال تحسبها فراشا % % PageV01P529 البحر : وافر تام 1(@)(@@) % أنخ يا سعد ناجية القلاص % % بحيث الدار طيبة العراص % % 2(@)(@@) % وعد فأعد حقائبها بطانا % بنائل موئل النفر الخماص % % 3(@)(@@) % فثمة ضاحك العرصات عمت % % نوافله الأداني والأقاصي % % 4(@)(@@) % بها حلت تميمتها المعالي % % وأمست وهي مرخية العقاص % % 5(@)(@@) % أما وندى كم انتاش ابن دهر % به نصب البلا شرك اقتناص % % 6(@)(@@) % له خلص الثناء على مجيد % به وجد السبيل إلى الخلاص % % 7(@)(@@) % أغر يرى دلاص الحمد أضفى % % على عرض الكريم من الدلاص % % 8(@)(@@) % ترقى في العلاء بحيث منها % % تبوء في الذوائب والنواصي % % 9(@)(@@) % شرى درر الثنا تغلو ، ونادى : % أوفري أنت عندي في ارتخاص % % 10(@)(@@) % ويا عرضي هدرت دماك جودا % ويا عرضي اقترح شرف القصاص % % PageV01P530 11(@)(@@) % فقل : يا بحر مدك رهن جزر % وقل : يا بدر تمك لانتقاص % % 12(@)(@@) % دعي دعوى الفخار فكل فخر % به لمحمد شرف اختصاص % % PageV01P531 البحر : خفيف تام 1(@)(@@) % أعلي أحللك الذروة العلياء % % عيص من أشرف الأعياص % 2(@)(@@) % حزت أقصى الكمال والفضل حتى % % بهما سدت كل دان وقاص % % 3(@)(@@) % أنت بدر وتمه لكمال % وتمام البدور للانتقاص % % 4(@)(@@) % لم تكن متحفي ، ومجدك لولا % % إنك البحر ' درة الغواص ' % 5(@)(@@) % يا بن من لانتجاع روض المزايا % % ليس إلا إليه 
ms154	 وخد القلاص % % 6(@)(@@) % أقعدت عن شوارد النظم فكري % % علل عقنه عن الإقتناص % % 7(@)(@@) % لو يبارحنني قليلا لا تحف % % تك منه بالمطرب الرقاص % % 8(@)(@@) % غير أني أقول إذ راض فكري % % من صعاب القريض ذات اعتياص % % 9(@)(@@) % احتذى اخمصاك خصمك يابن % % النفر البيض والكرام الخماص % % 10(@)(@@) % قد ضربت القباب في مفرق الأنجم % % فاعتقد أطنابها بالنواصي % % PageV01P532 11(@)(@@) % وأقم في سلامة وحبور % رافه البال مستطاب العراص % % PageV01P533 البحر : كامل تام 1(@)(@@) % وسم الربيع بزعمه ذات الأضا % % كذب الربيع فذاك دمعي روضا % % 2(@)(@@) % وقف السحاب بها معي لكنما % % دمعي استهل وإنما هو أومضا % % 3(@)(@@) % بكر الخليط عن الديار فلم أزل % % أدعوه إذ هو واصطباري قوضا % % 4(@)(@@) % يا راحلا عن ناظري لمهجتي % % أزمعت من سفح العقيق إلى الغضا % % 5(@)(@@) % الآن أبناء الرجاء غدا السرى % % لهم يحب وكان قبل مبغضا % % 6(@)(@@) % من حيث لم يسقبلوا في مطلب % وجه النجاح هناك إلا أعرضا % % 7(@)(@@) % حلف الزمان بأن يديم مطاله % حتى لدى الحسن المكارم تقتضى % % 8(@)(@@) % وصلوا السهول مع الحزون وإنما % % قطعوا الفضاء لخير من ضم الفضا % % 9(@)(@@) % لبسوا له ليل المطامع أسودا % وبه اجتلوا صبح المكارم أبيضا % % 10(@)(@@) % فرأوا أغر يكاد يقطر بشره % % ماء له اهتز الربيع وروضا % % PageV01P534 11(@)(@@) % وفتى له الشرف الرفيع بأسره % ألقى مقاليد السماح وفوضا % % 12(@)(@@) % أعباء مجد لو تكلف ثقلها % % حتى يلملم لم يطق أن ينهضا % % PageV01P535 البحر : خفيف تام 1(@)(@@) % ليس إلا إليك للعيس نشط % % كل رحل إلى حماك يحط % 2(@)(@@) % يا أخا المكرمات حسبك فخرا % أنها حين تعتزي لك رهط % % 3(@)(@@) % لك خلق به الرضى لمحب % ولذي البغض والقلى فيه سخط % % 4(@)(@@) % بشروا يا بني الرجاء الأماني % % بابن علياء كفه الجعد سبط % % 5(@)(@@) % وانزلوا حيث لا تمد الليالي % % يد خطب وحيث لا الدهر يسطو % % 6(@)(@@) % في حمى ليس يرفع الطرف فيه % % رهبة أشوس ولا الليث يخطو % % 7(@)(@@) % حرم آمن مهابته ستر % عل من به استجار يلط % 8(@)(@@) % رجع الدهر لاقتبال صباه % % بعد ما قد علاه للشيب وخط % % 9(@)(@@) % بفتى أصبحت مناقبه الغر % على جبهة 
ms155	 الزمان تخط % 10(@)(@@) % يقبض المال لا لغير العطايا % % فالندى في يديه قبض وبسط % % PageV01P536 11(@)(@@) % لو رأينا الجوزاء تحكي مزاياه % % لقلنا لدرها أنت سمط % % 12(@)(@@) % والثريا قد داسها فلهذا % % لم نقل إنها لعلياه قرط % % PageV01P537 البحر : كامل تام 1(@)(@@) % رأت المشيب بعارضيك ففاظها % % وثنت بذات البان عنك لحاظها % % 2(@)(@@) % هيفاء لو برزت لنساك الورى % % يوما لأحبى دلها وعاظها % % 3(@)(@@) % ريم لئالىء نحرها تحكي لئا % % لىء ثغرها اللائي حكت ألفاظها % % 4(@)(@@) % قد كان شملك بالكواعب جامعا % أيام سوق صباك كان عكاظها % % 5(@)(@@) % فتنبت عين الزمان ففرقت % % بالشيب شملك ، لا رأت إيقاظها % % 6(@)(@@) % رقت إليك قلوبهن مع الصبا % % وأعادهن لك المشيب غلاظها % % 7(@)(@@) % فدع الغواني القاتلات بصدها % % كم فتية غنج اللحاظ أفاظها % % 8(@)(@@) % واهتف هديت ولو من النبل العدى % % كسرت عليك لغيظها أرعاظها % % 9(@)(@@) % بمدائح الحسن الذي آباؤه % % كانوا لأسرار الندى حفاظها % % 10(@)(@@) % حمال ثقل المكرمات بهمة % لم تشك مذ نهضت بها إبهاظها % % PageV01P538 11(@)(@@) % يا من أعاد النيرات ضياءها % % فزهت وأعطى المخدرات حفاظها % % 12(@)(@@) % أو قدت نار قرى لضيفك ضوؤها % % وبقلب كاشحك اقتدحت شواظها % % PageV01P539 البحر : وافر تام 1(@)(@@) % دعوا كبدي دونكم دموعي % % فداعي البين يهتف بالجميع % 2(@)(@@) % وما أبقى على كبدي ولكن % % لتأنس في محبتكم ضلوعي % % 3(@)(@@) % كتمت بها الهوى زمنا إلى أن % % دعاها يوم بينكم : أذيعي % % 4(@)(@@) % فصاعدت الدموع لكم نجيعا % ويوشك أن تسيل مع الدموع % % 5(@)(@@) % وبالعلمين واضحة المحيا % % رشوف الثغر طيبة الفروع % % 6(@)(@@) % تمني المستهام بغير نيل % فتطمعه بخالبة لموع % % 7(@)(@@) % منعت وصالها فسلوت عنها % % وقلت لها وراءك من منوع % % 8(@)(@@) % فأنت وما صنعت فعنك حسبي % % بمدح محمد الحسن الصنيع % % 9(@)(@@) % ربيع زماننا وأرق طبعا % إلى الندماء من زمن الربيع % % 10(@)(@@) % ربيب مكارم وفتى معال % ترعرع في ذرى الشرف الرفيع % % PageV01P540 11(@)(@@) % درور أنامل الكفين جودا % غداة السجب جامدة الضروع % % 12(@)(@@) % كسى أعطافه نفحات فخر % وقال لها : على الثقلين ضنوعي % % PageV01P541 البحر : طويل 1(@)(@@) % ذكرت بذات البان حيث مضى لنا % % زمان به ظل الشبيبة سائغ % 2(@)(@@) % كواعب ترمي عن قسي حواجب % بأسهم لحظ 
ms156	 لا تقيها السوابغ % % 3(@)(@@) % تدب على الورد الندي بخدها % % عقارب من أصداغهن لوادغ % % 4(@)(@@) % لوادغ أحشاء يبيت سليمها % % ودرياقه عذب من الريق سائغ % % 5(@)(@@) % لهوت بها حينا أطيع بها الهوى % % غراما وشيطان الصبابة نازغ % % 6(@)(@@) % إلى أن رأت يد الشيب ناصلا % بها من كلا فودي ما الله صابغ % % 7(@)(@@) % فأصبحت لا قلبي من الغيد فارغ % بلى قلبها مني غدا وهو فارغ % % 8(@)(@@) % وأمسيت في ليل من الغم تحته % فؤادي له ضرس من الهم ماضغ % % 9(@)(@@) % إلى أن جلى عني الهموم بأسرها % % هلال على في مطلع السعد بازغ % % 10(@)(@@) % هلال على تجلوه طوقا لنحرها % % له ربه من جوهر المجد صائغ % % PageV01P542 11(@)(@@) % فتى لم تكن أهل المساعي جميعها % % لتبلغ من علياهم هو بالغ % % 12(@)(@@) % يقصر كعب عن نداه وحاتم % ويقصر حتى جرول والنوابغ % % PageV01P543 البحر : كامل تام 1(@)(@@) % ألفتك نافرة الظباء الهيف % واستوطنت في ربعك المألوف % 2(@)(@@) % فانعم بناعمة الشبيبة غضة % بيضاء ضامية الوشاح رشوف % % 3(@)(@@) % أبدا يروق العين في وجناتها % % ورد ولكن ليس بالمقطوف % % 4(@)(@@) % هي قبلة صلى لها غزلي كما % % صلى ثناي لقبلة المعروف % % 5(@)(@@) % الماجد الحسن المكارمه ملجأ ال % % عافي الكريث ونجدة الملهوف % % 6(@)(@@) % قمر زهت منه البسيطة كلها % % بأشع من قمر السماء الموفي % % 7(@)(@@) % الأزهر الغطريف نجل الأزهر ال % % غطريف نجل الأزهر الغطريف % % 8(@)(@@) % ما راق في صدر الندي بشاشة % % إلا وراع بهيبة ابن غريف % % 9(@)(@@) % ومقوم الآراء ثقفه النهى % % وكذا الرماح تقام بالتثقيف % 10(@)(@@) % كرما يتابع للوفود هباته % % لم يثن في عذل ولا تعنيف % % PageV01P544 11(@)(@@) % الجود عند سواه أن يعد الندى % % ويميت ذاك الوعد بالتسويف % % 12(@)(@@) % هو غيث مكرمة وبدر مفاخر % ومحط آمال وأمن مخوف % PageV01P545 البحر : خفيف تام 1(@)(@@) % حملتك الديار مالا تطيق % مذ عرى شمل أهلها التفريق % 2(@)(@@) % عرصات حبست أيدي المراسي % % ل عليها والدمع ملك طليق % % 3(@)(@@) % كنت ترتادها وريقة روض % وهي اليوم دمنة لا تروق % % 4(@)(@@) % سحقتها اليوم المطايا كأن لم % % تك بالأمس وهي مسك سحيق % % 5(@)(@@) % صاح ماذا عليك من رسم دار % قد تعفت 
ms157	 وزال عنها الفريق % % 6(@)(@@) % أوحشت غير أن يئن ابن ورقا % % ء بها أو يحن صب مشوق % % 7(@)(@@) % فاطرح ذكرها لمدح عظيم % هيبة باسمه تضيق الحلوق % % 8(@)(@@) % حسن الفعل ماجد الفرع والأص % % ل جدير بالمكرمات حقيق % % 9(@)(@@) % لحقته أماجد العصر لكن % % عز في شأوه عليها اللحوق % % 10(@)(@@) % ذو لسان كما ينضنض صل % وفم فيه ريقة الصل ريق % % PageV01P546 11(@)(@@) % هو في أعين الخصوم لسان % وبأحشائهم سنان ذليق % % 12(@)(@@) % وإذا غاية من المجد عنت % % لم يعقه عن نيلها ( العيوق ) % PageV01P547 البحر : سريع 1(@)(@@) % قامت تجنى لي في دلها % % قلت لها : رفقا بأسراك % 2(@)(@@) % قالت : نعت البدر في سعده % % قلت : نعم وهو محياك % 3(@)(@@) % قالت : وصفت الدر في سمطه % % قلت : بلى وهو ثناياك % % 4(@)(@@) % قالت : نسيم الورد أطريته % % قلت : أجل والورد خداك % % 5(@)(@@) % قلت : فمن خصرك قلبي اشتكى % % ضعفا فقالت : كذب الشاكي % % 6(@)(@@) % قلت : إذا أدعو له بالضنا % % قالت : وزده ثقل أوراك % % 7(@)(@@) % قلت : فمشغوف الحشا ماله % منك سوى أن يتمناك % % 8(@)(@@) % عني أذيعي يا نموم الصبا % % مقالة طابت كرياك % % 9(@)(@@) % آليت لا أنسب خبثا إلى % % عصر أتى بالحسن الزاكي % % 10(@)(@@) % أحنى بني الأيام عطفا على % % ضرائك منهم وهلاك % % PageV01P548 11(@)(@@) % ذو راحة حاكى الحيا جودها % % والفضل للمحكي لا الحاكي % % 12(@)(@@) % تجلت البحر فقال الورى : % ما أجمد البحر وأنداك % % PageV01P549 البحر : كامل تام 1(@)(@@) % ملك عظيم القدر أم ملك % من تحت علياه جرى ملك % % 2(@)(@@) % لبست له الدنيا أشعتها % % فانجاب عن أقطارها الحلك % 3(@)(@@) % نصر الرجا بالجود حين غدا % % بين الرجا والجود معترك % % 4(@)(@@) % إن تنفرد بالجود راحته % فالناس في معروفه اشتركوا % % 5(@)(@@) % لا تلتقي أجفان حسده % % سهدا كأن لها الكرى حسك % PageV01P550 البحر : كامل تام 1(@)(@@) % يا من بهمته عقدت رجاي إذ % % همم الأنام حبالهن ركاك % 2(@)(@@) % لازمته من بعد ما جربتهم % % وعن الجميع ذوي رجاي فكاك % % 3(@)(@@) % لا يفهمون المكرمات كأنها % % عربية وكأنهم أتراك % % 4(@)(@@) % بك قد دفعت الحادثات بقوة % عني وكنت وليس في حراك % % 5(@)(@@) % فارقت كوثر جود كفك طالبا % ماء الحياة فحاق بي الأهلاك 
ms158	 % % 6(@)(@@) % فدعوت مصطرخا لكي تنتاشني % % شلوا بأنياب الخطوب ألاك % % 7(@)(@@) % فاسلم تقر لذي الهوى بك عينه % % وعيون أهل الحقد فيك تشاك % % 8(@)(@@) % تجري لهم بسعودها ونحوسها % % أبد الزمان علاك والأفلاك % PageV01P551 البحر : مجزوء الكامل 1(@)(@@) % حيتك تنهمل انهمالا % % وطفاء مرخية العزالى % % 2(@)(@@) % يا دار لا سلبت أكف % الدهر حسنك والجمالا % % 3(@)(@@) % وتنسمت فيك الرياح % صبا ولا هبت شمالا % % 4(@)(@@) % فلكم على هيفاء قد % % ضرب الغيور بك الحجالا % % 5(@)(@@) % من كل ناعمة الصبا % % تثني معاطفها دلالا % % 6(@)(@@) % يا سعد عد عن الهوى % % فلقد أطلت به المقالا % % 7(@)(@@) % أعط المدائح حقها % % ودع الغزالة والغزالا % % 8(@)(@@) % خف الرجاء لمن نشأن % % أكفهم سحبا ثقالا % % 9(@)(@@) % قوم على الزوراء أوجههم % % نجوم دجى تلالا % % 10(@)(@@) % بمحمد الحسن ارتقوا % % شرفا على الجوزاء طالا % % PageV01P552 11(@)(@@) % داسوا النجوم بفخره % % وبحلمه وزنوا الجبالا % % 12(@)(@@) % هو أمجد الدنيا أبا % هو أكرم الثقلين خالا % % PageV01P553 البحر : خفيف تام 1(@)(@@) % قل لام العلى ولدت كريما % % رق خلقا وراق خلقا وسيما % % 2(@)(@@) % بدر مجد مدحته فكأني % % من مساعيه قد نظمت النجوما % % 3(@)(@@) % ملك تلمح النواظر منه % ملكا في سما المعالي كريما % % 4(@)(@@) % مجده في ارتفاعه ثامن الأف % % لاك من فوقها أطل قديما % % 5(@)(@@) % وإذا ما رأيت دار أبي الها % % دي ومعروفها رأيت نعيما % % 6(@)(@@) % إن رحلت ارتحل لربع نداه % % وأقم فيه إن ترد أن تقيما % % 7(@)(@@) % فهو الجنة التي استعذب النا % % س جميعا رحيقها المختوما % % 8(@)(@@) % سبر الدهر بالتجارب حتى % بالنهى والفخار صار زعيما % % 9(@)(@@) % واستهلت كلتا يديه إلى أن % % لم يدع في بني الزمان عديما % % 10(@)(@@) % فيه ينزل الرجا واليه % % كل ركب سرى ينص الرسيما % % PageV01P554 11(@)(@@) % هو من أيكة على أول الده % % ر زكت في ثرى المعالي اروما % % 12(@)(@@) % أثمرت سؤددا وفخرا وعزا % ونمتها غطارفا وقروما % % PageV01P555 البحر : رمل تام 1(@)(@@) % كم مقامات نهى حررها % % ليس فيها للحريري مقامه % % 2(@)(@@) % وأنيقات بهى لو شامها % % جوهري الشعر ما سام نظامه % % PageV01P556 البحر : خفيف تام 1(@)(@@) % في فمي لم يزل لذكرك نشر % طيب واختبر بذاك النسيما % % 2(@)(@@) % وبمرآة فكرتي 
ms159	 لم يزل شخصك % % نصب العينين مني مقيما % % 3(@)(@@) % وعلى النحر من علاك ثنائي % % ليس ينفك عقده منظوما % % 4(@)(@@) % لا تظن البعاد يحجب عني % منك ذيالك المحيا الكريما % % 5(@)(@@) % فوشوقي وموقع الود مني % % قسما لا أراه إلا عظيما % % 6(@)(@@) % أنت عندي بالذكر أحضر من قل % % بي بقلبي فكن بذاك عليما % % 7(@)(@@) % لست أقوى لحمل عتبك يا من % % حملت فخره المعالي قديما % % 8(@)(@@) % فاثن عن غرب عتبك اليوم عني % % فبه قد تركت قلبي كلبما % % PageV01P557 البحر : خفيف تام 1(@)(@@) % يا سمي الذي فداه من الذبح % % إله السما بذبح عظيم % 2(@)(@@) % والحفيظ العليم من في هداه % % ناب عن جده الحفيظ العليم % % 3(@)(@@) % جئت يا فرع هاشم أجتني منك % % سجايا طابت كطيب الأروم % % 4(@)(@@) % فعدتني عن المرام عواد % جلبتها يد الزمان اللئيم % % 5(@)(@@) % حجبت بيننا شكاتك يا بدر % فكم لي من نظرة في النجوم % % 6(@)(@@) % لست أنت السقيم لكن قلبي % % يا شفاك الأله عين السقيم % PageV01P558 البحر : خفيف تام 1(@)(@@) % خلق شف فالنسيم كثيف % عنده إن قرنت فيه النسيما % % 2(@)(@@) % لأخي شيمة تعلم منها % % الغيث أن يستهل لا أن يدوما % % 3(@)(@@) % قد حواها من معشر ورثوها % % منه من كان مثلهم مستقيما % % 4(@)(@@) % فهي في اللطف أولا وأخيرا % شرع تفضل العرار شميما % % 5(@)(@@) % وكأن القديم كان حديثا % وكأن الحديث كان قديما % % PageV01P559 البحر : بسيط تام 1(@)(@@) % لا زلت يا دهر تجلو منظرا حسنا % % عن طلعة سعدها في يمنها اقترنا % % 2(@)(@@) % لماجد أشرقت في الكرخ غرته % شمسا تمزق في أنوارها الدجنا % % 3(@)(@@) % أغر ساد فكان البدر ترمقه ال % % دنيا وجاد فكان العارض الهتنا % % 4(@)(@@) % وكم سمعت لداع : من لمكرمة % فهل سمعت سواه من يقول : أنا % % 5(@)(@@) % محمد حسن الأخلاق راحته ال % % بيضاء كم طوقت جيد الورى مننا % % 6(@)(@@) % أما وحبوة علياه وما جمعت % % من الفخار وبرديه وما ضمنا % % 7(@)(@@) % لقد كسى مجده الزورا بأجمعها % % بردا من الفخر فيه فاخرت عدنا % % 8(@)(@@) % يا باسطا للندى كفا بنائلها % % تبخل الأجودين البحر والمزنا % % 9(@)(@@) % قسنا الورى فوجدناها الوهاد لكم % % جميعها ، ووجدنا لها 
ms160	 قننا % % 10(@)(@@) % والحلم يولد فيما بينكم معكم % % يا خفة الطود لو في طفلكم وزنا % % PageV01P560 11(@)(@@) % لا زال بيت علاكم للورى حرما % من راعه الدهر واستذرى به أمنا % % 12(@)(@@) % أنتم جواهر عقد الفخر لا برحت % % بكم تحلي يدا علياكم الزمنا % % PageV01P561 البحر : بسيط تام 1(@)(@@) % يا جعفر الجود كم انهلت ظمآنا % % فراح مبتلة أحشاه ريانا % % 2(@)(@@) % وكم بسطت يدا ما للسحاب يد % بأن تساجلها جودا وإحسانا % % 3(@)(@@) % بنت عمادا به من مجدها رفعت % % سقفا يسامت في علياه كيوانا % % 4(@)(@@) % وكم دفعت بها في صدر نازلة % طرحت منها عن اللاجين ثهلانا % % 5(@)(@@) % فمن يساميك في مجد وفي شرف % وأنت أرفع أبناء العلى شانا % % 6(@)(@@) % وليس ما فيك كبرا مثل ما زعم % الحساد بل شمخ من هاشم كانا % % 7(@)(@@) % لو الكمال بدا شخصا لما وجدوا % % سواك في عين ذاك الشخص إنسانا % % 8(@)(@@) % فيا أرق ذوي المعروف كلهم % % يدا وأصلب أهل الحزم عيدانا % % 9(@)(@@) % قد انتجعتك والأنواء محفلة % غيثا يقوم مقام الغيث هتانا % % 10(@)(@@) % فكنت ديمة جود أمطرت ورقا % لدي فاعجب لقطر كان عقيانا % % PageV01P562 11(@)(@@) % فلتشكرنك ما غنت مطوقة % نواطق بالثنا تطريك إعلانا % % PageV01P563 البحر : وافر تام 1(@)(@@) % بمجدك يا أعز علي مني % % ومجدك ما ذخرت سواه ثاني % % 2(@)(@@) % على جمر من الضراء ترضى % % أقلب هكذا بيدي زماني % % 3(@)(@@) % أيقصيني وأنت ترى وتغضي % % كأنك لا تراه ولا تراني % % 4(@)(@@) % خلال ما عهدتك ترتضيها % % وكنت إذ دعوتك غير واني % % 5(@)(@@) % فخذ إما بما يدني ، وإما % % بما يقصي عياني عن مكاني % % 6(@)(@@) % فإني قد ملكت المكث فيه % % وما لي عنه بالمسرى يدان % PageV01P564 البحر : مجزوء الكامل 1(@)(@@) % أفحمتني وأنا المفوه % % وأرق من أثنى ونوه % % 2(@)(@@) % أرتجت باب رويتي % % فتبدلت ضعفا بقوه % % 3(@)(@@) % فافتح على ذهني أصف % % ما فيك من شرف الفتوه % % 4(@)(@@) % وتدان من فكري فمجد % ك لم ينل فكر علوه % % 5(@)(@@) % أولست بالسيف الذي % % أمنت مرجوه نبوه % % 6(@)(@@) % جمع الصباحة والسماحة % % والسجاحة والمروه % % 7(@)(@@) % وحنا على الدنيا فلا % % فقدت بنو الدنيا حنوه % % 8(@)(@@) % وأجد من رسم المكارم % % ما 