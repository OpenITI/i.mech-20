ms81	 % % 8(@)(@@) % على أنه أقذى العيون وأوشكت % % صدور العلى والمجد ترفض من ضنك % % 9(@)(@@) % فلما تجلى للقلوب يقينه % % ودكت له شم الذرى أيما دك % % 10(@)(@@) % بكى حزنا من كان لا يعرف البكا % % وأنشد كل مقلتيه قفا نبك % PageV01P287 11(@)(@@) % وأمست بقاع الفضل عاطلة السرى % % وأضحت بحار المجد راكدة الفلك % 12(@)(@@) % لقد كان شكي فيه أبرد للحشا % % فيا ليتني ما زلت منه على شك % % 13(@)(@@) % كذا جد أحداث الليالي وصرفها % % فأي امرىء مدت إليه يد الهلك % 14(@)(@@) % برغم العوالي السمهرية والظبى % % أصيب ولم تطعن عليه ولم تنك % % 15(@)(@@) % أبا هاشم أشرقت كوكب سحرة % فلا عجب إن غبت عنا على وشك % % 16(@)(@@) % فقدتك فقد الروض زهر كمامه % % ورحت من الأشجان أبكي وأستبكي % % 17(@)(@@) % لئن ظل صبري عنك منفصم العرى % % فقلبي من الأحزان ليس بمنفك % % 18(@)(@@) % وإن لم أكن أبصرت شخصك في الورى % % فما غاب عني شخص إحسانك المحكي % % 19(@)(@@) % أعزي أباك البر عنك وإنني % % وإياه من وجد سهيمان في شرك % % 20(@)(@@) % أتكتحل الأجفان بعدك بالكرى % % سلوا وتفتر الثغور من الضحك % % PageV01P288 21(@)(@@) % وهيهات ما في الأنس بعدك مطمع % ولا لأسارى حزن يومك من فك % 22(@)(@@) % ألوذ بستر الصبر عنك تجلدا % فيأبى له عظم المصاب سوى الهتك % 23(@)(@@) % وإن رمت إطفاء لنار تلهفي % % عليك غدا حزني لها أبدا يذكي % % 24(@)(@@) % ولو رد عنك الحتف بالبأس لم يقف % % سناني عن طعن وسيفي عن بتك % 25(@)(@@) % إذا خاض لج الموت دونك فتية % على ضمر تهوى الشكائم بالعلك % % 26(@)(@@) % ولكن قضاء الله غير مدافع % وأحكامه تجري ولم تخش من درك % 27(@)(@@) % ولله قبر ضم جسمك فانبرى % % بطيب شذا رياك يهزأ بالمسك % % 28(@)(@@) % فكم ضم من مجد وكم حاز من علا % وكم حاز من رشد وكم نال من نسك % 29(@)(@@) % يعز على أرض الغري وكربلا % % وطيبة ذات الطيب والحرم المكي % % 30(@)(@@) % بأنك في أرض سواهن ملحد % ولو أنها تعلو السماكين في السمك % % PageV01P289 31(@)(@@) % فلا برحت تسقي ثراك مدامع % تزيد على عز السحائب في السفك % 32(@)(@@) % أبا ناصر لا يستفزنك الأسى 
ms82	 % % على حادث يشكى إليه فلا يشكي % % 33(@)(@@) % فإنك طود لا تذل لفادح % وهيهات طود المجد ليس بمندك % % 34(@)(@@) % تأس بخير الخلق آبائك الألى % % بكت لرزاياهم أولو الدين والشرك % 35(@)(@@) % على إنها لم يبق صرفها % % على سوقة في العالمين ولا ملك % % 36(@)(@@) % ولا تبد للبأساء إلا تكرما % وإن بالغت في النهر يوما وفي النهك % % 37(@)(@@) % وكن في صروف الدهر كالذهب الذي % % يزيد عيارا كلما زيد في السبك % % 38(@)(@@) % وكيف وأنت الندب لو أن حاكيا % حكى عنك غير الصبر كذبت ما يحكي % % 39(@)(@@) % أفاض عليك الله درع وقاية % تقيك من الأسواء موضونة الحبك % % 40(@)(@@) % ودم لا نأت للعز عنك مآرب % ولا خرجت غر العلى لك عن ملك % PageV01P290 البحر : بسيط تام 1(@)(@@) % يا دار مية بالجرعاء حياك % % صوب الحيا الرائح الغادي وأحياك % % 2(@)(@@) % ولا أغبك من دمعي سواجمه % % إن كان يرضيك ريا مدمعي الباكي % % 3(@)(@@) % سقيا ورعيا لأيام قضيت بها % % عيش الشبيبة في أكناف مرعاك % % 4(@)(@@) % ما هينمت نسمات الروض خافقة % إلا تنسمت منها طيب رياك % % 5(@)(@@) % ولا تغنى حمام الأيك في فنن % إلا تذكرت أيامي بمغناك % 6(@)(@@) % أصبو إلى الرمل من جرعاء ذي إضم % وما لقلبي وللجرعاء لولاك % 7(@)(@@) % يخونني جلدي ما حن مكتئب % وينفذ الصبر مهما عن ذكراك % 8(@)(@@) % لله طيب ليال فيك مشرقة % مرت فما كان أحلاها وأحلاك % % 9(@)(@@) % إذ النوى لم ترع شملي ولا عريت % من اصطياد الظباء الغيد أشراكي % % 10(@)(@@) % ياظبية بالكثيب الفرد راتعة % أوحشت عيني وفي الأحشاء مثواك % PageV01P291 11(@)(@@) % رميت قلبي بسهم من رناك وقد % % سكنت فيه فما أبعدت مرماك % % 12(@)(@@) % الغصن يعرب عن عطفيك مائسه % وطلعة البدر تنبي عن محياك % % 13(@)(@@) % وكاد يحكيك ضوء الصبح مبتسما % لكن ثناه وميض من ثناياك % % 14(@)(@@) % وقيل شمس الضحى تحكيك مشرقة % وما حكتك ولكن أوهم الحاكي % % PageV01P292 البحر : منسرح 1(@)(@@) % من أودع الراح والأقاح فمك % ومن أعار الصباح مبتسمك % % 2(@)(@@) % أصبح من قد رآك ملتثما % يتيه سكرا فكيف من لثمك % 3(@)(@@) % لو أنصفتك الحسان قاطبة % أصبحت مولى وأصبحت خدمك % % 4(@)(@@) % قالوا 
ms83	 حكى فرقك الصباح ولو % % حكمت فيه أوطأته قدمك % % 5(@)(@@) % يا مقسما أن يذيبني كلفا % حسبك أبررت بالجفا قسمك % 6(@)(@@) % وأنت يا طرفه السقيم أما % % تكف عن ظلم غير غير من ظلمك % % 7(@)(@@) % سلبتني صبري الجميل وما % % كفاك حتى كسوتني سقمك % PageV01P293 البحر : خفيف تام 1(@)(@@) % كوكب الصبح قد بدا يحكيك % % فامزج الكأس يا رشا من فيك % 2(@)(@@) % بادر الصبح بالصبوح فقد % % فاح ريح الصبا وصاح الديك % 3(@)(@@) % وأدرها علي مشرقة % عن سنى البدر في الدجى تغنيك % % 4(@)(@@) % وادع في الأنس والسرور بها % % ودع الهم شأنه شانيك % 5(@)(@@) % هي عين الحياة فاحي بها % % روح صب بروحه يفديك % % 6(@)(@@) % إن ضللت السبيل في غسق % فبمشكاة نورها تهديك % % 7(@)(@@) % واصل الراح ما حييت ولا % % تصغ سمعا لعاذل يغويك % 8(@)(@@) % واهجر اللائمين إن غضبوا % % إن فيها جميع ما يرضيك % % 9(@)(@@) % هي لا شك آية ظهرت % % فانف عنها مقال ذي التشكيك % 10(@)(@@) % قل لميت الغرام قم سحرا % واصطحبها فإنها تحييك % PageV01P294 11(@)(@@) % لا تقل إثمها يحل بنا % % فهي من كل مأثم تنجيك % 12(@)(@@) % يا عذولي أسرفت في عذلي % % كف عني فما جرى يكفيك % % 13(@)(@@) % خلني والمدام في شغل % واشتغل أنت بالذي يعنيك % % PageV01P295 البحر : مخلع البسيط 1(@)(@@) % من قاس جدوى يديك يوما % بالغيث ما بر في امتداحك % % 2(@)(@@) % الغيث ينهل وهو باك % وأنت تعطي وأنت ضاحك % PageV01P296 البحر : بسيط تام 1(@)(@@) % هذا المصلى وذا النخيل % يا حبذا ظله الظليل % % 2(@)(@@) % وهذه طيبة تراءت % % فعج بنا أيها الدليل % 3(@)(@@) % أما ترى العيس من نشاط % تكاد في سيرها تسيل % % 4(@)(@@) % تميد من تحتنا ارتياحا % ونحن من فوقها نميل % % 5(@)(@@) % فاحبس ولا تجهد المطايا % % تم السرى وانقضى الرحيل % % 6(@)(@@) % وانزل ولا تخش من عناء % فها هنا يكرم النزيل % 7(@)(@@) % وها هنا تدرك الأماني % % وها هنا ينقع الغليل % % 8(@)(@@) % فسل سبيل الورود فيه % % فورده العذب سلسبيل % % 9(@)(@@) % مقام قدس إليه يسمو % % من السماوات جبرئيل % % 10(@)(@@) % وقل صلاة الإله تترى % % عليك يا أيها الرسول % % PageV01P297 11(@)(@@) % يا خير من زمت المطايا % % له ومن شدت الحمول 
ms84	 % 12(@)(@@) % أنت الذي جاهه جليل % وجوده وافر جزيل % % 13(@)(@@) % يدعوك عبد إليك يعزى % % فهل له إذ دعا قبول % % 14(@)(@@) % فؤاده بالأسى جريح % وجسمه بالضنى عليل % % 15(@)(@@) % قد عاث صرف الزمان فيه % % وخانه صبره الجميل % % 16(@)(@@) % أصبح بالهند في انفراد % فلا عشير ولا قبيل % % 17(@)(@@) % ليس به في الورى حفي % ولا له منهم كفيل % 18(@)(@@) % وأنت أدرى بما يقاسي % % فشرح أحواله طويل % 19(@)(@@) % خذ بيدي يا فدتك نفسي % % فقد عفا صبري المحيل % 20(@)(@@) % وطال بالرغم عنك بعدي % % فهل إلى قربكم سبيل % % PageV01P298 21(@)(@@) % فأدنني منك وانتقذني % % من غربة عبؤها ثقيل % % 22(@)(@@) % فقد تفألت بالتداني % % والفأل بالخير لا يفيل % % 23(@)(@@) % متى أرى يا ترى ركابي % % لها إلى طيبة ذميل % % 24(@)(@@) % فيشتفي قلبي المعنى % % ويكتسي جسمي النحيل % 25(@)(@@) % ويصبح الشمل في اجتماع % والقرب من بعدنا بديل % % 26(@)(@@) % أرجوك يا أشرف البرايا % % وما الرجا فيك مستحيل % 27(@)(@@) % أن تنجح اليوم كل سؤلي % % وإن أبى دهري البخيل % 28(@)(@@) % صلى عليك الإله يا من % % بجوده ترتوي المحول % 29(@)(@@) % والآل والصحب خير آل % % جميلهم في الورى جليل % 30(@)(@@) % ما غنت الورق في رياض % وأطرب السجع والهديل % % PageV01P299 البحر : مجزوء الكامل 1(@)(@@) % هذا الحجاز وذاك ضاله % قد قلصت عنه ظلاله % 2(@)(@@) % ماذا بكاء المستهام % % برقمتيه وما سؤاله % % 3(@)(@@) % إن كان أطعمه الحمى % % فاليوم تؤيسه رماله % % 4(@)(@@) % قد بان عنه جماله % % وتحملت منه جماله % % 5(@)(@@) % أين المعاهد والعهود % % وأين من مال اعتداله % 6(@)(@@) % لهفي على الرشأ الذي % % قد أفلتت مني حباله % % 7(@)(@@) % يصفو ويكدر حبه % % فالحب أكدره ملاله % % 8(@)(@@) % ما إن حلالي وعده % % إلا ومرره مطاله % % 9(@)(@@) % منع الكرى عن ناظري % % كيلا يلم بنا خياله % % 10(@)(@@) % لو أن ما بي من هواه % % بيذبل ذابت قلاله % % PageV01P300 11(@)(@@) % يا ويح قلب قد تفرغ % % في هواه به اشتغاله % % 12(@)(@@) % حملته ما لم يطق % % واليوم قد قل احتماله % % 13(@)(@@) % ولكل خطب حيلة % والبين قل لي ما احتياله % % 16(@)(@@) % نعم التجأت بمن أذل % % 17(@)(@@) % فاليوم لا أخشى الزما % % ن وملجئي يخشى صياله % % 18(@)(@@) % مولى به نلت 
ms85	 المنى % % وقضى لي الآمال ماله % % 19(@)(@@) % وسع الورى إفضاله % % فغدا يعمهم نواله % % 20(@)(@@) % إن رام نال وإن يقل % % فالقول يتبعه فعاله % % 21(@)(@@) % ليث يهولك صوله % % 23(@)(@@) % يا أيها المولى الذي % % قد أكمل العليا كماله % % PageV01P301 24(@)(@@) % وبه زها روض العلى % % والمجد قد صح اعتلاله % 25(@)(@@) % إني بعفوك واثق % والعفو أكرمه مذاله % % 26(@)(@@) % فأقل عثاري إن عثرت % % ولا تقل ظهر اختلاله % 27(@)(@@) % فلأنت أكرم من رجوت % % وخير من كرمت خصاله % % 28(@)(@@) % كم نائل أوليتنيه % % وساغ لي عذبا زلاله % 29(@)(@@) % بوأتني المجد المؤثل % % عندما مدت ظلاله % % 31(@)(@@) % فاسلم ودم متبوئا % مجدا سما عزا مناله % % PageV01P302 البحر : طويل 1(@)(@@) % إليك فقلبي لا تقر بلابله % إذا ما شدت فوق الغصون بلابله % % 2(@)(@@) % تهيج له ذكرى حبيب مفارق % زرود وحزوى والعقيق منازله % 3(@)(@@) % سقاهن صوب الدمع مني ووبله % % منازل لا صوب الغمام ووابله % % 4(@)(@@) % يحل بها من لا أصرح باسمه % % غزال على بعد المزار أغازله % % 5(@)(@@) % تقسمه رق الجمال وجزله % فرن وشاحاه وصمت خلاخله % % 6(@)(@@) % وما أنا بالناسي ليالي بالحمى % % تقضت وورد العيش صفو مناهله % % 7(@)(@@) % ليالي لا ظبي الصريم مصارم % ولا ضاق ذرعا بالصدود مواصله % 8(@)(@@) % وكم عاذل قلبي وقد لج في الهوى % % وما عادل في شرعة الحب عاذله % % 9(@)(@@) % يلومون جهلا في الغرام وإنما % % له وعليه بره وغوائله % % 10(@)(@@) % فلله قلب قد تمادى صبابة % على اللوم لا تنفك تغلى مراجله % % PageV01P303 11(@)(@@) % وبالحلة الفيحاء من أبرق الحمى % % رداح حماها من قنا الخط ذابله % % 12(@)(@@) % تميس كماماس الرديني مائدا % وتهتز عجبا مثلما اهتز عامله % % 13(@)(@@) % مهفهفة الكشحين طاوية الحشا % % فما مائد الغصن الرطيب ومائله % % 14(@)(@@) % تعلقتها عصر الشبيبة والصبا % % وما علقت بي من زماني حبائله % % 15(@)(@@) % حذرت عليها آجل البعد والنوى % % فعاجلني من فادح البين عاجله % % 16(@)(@@) % إلى الله يا ظمياء نفسا تقطعت % % عليك غراما لا أزال أزاوله % 17(@)(@@) % وخطب بعاد كلما قلت هذه % % أواخره كرت علي أوائله % 18(@)(@@) % لئن جار دهري بالتفرق واعتدى % % وغال التداني من دهى البين غائله % % 19(@)(@@) % فإني لأرجو نيل ما قد أملته 
ms86	 % % كما نال من يحيى الرغائب آمله % % 20(@)(@@) % كريم وفي إحسانه ونواله % % بما ضمنت للسائلين مخائله % % PageV01P304 21(@)(@@) % من النفر الغر الذين بمجدهم % % تأيد أرز المجد واشتد كاهله % % 22(@)(@@) % لقد ألبست نفس المعالي بروده % % وزرت على شخص الكمال غلائله % % 23(@)(@@) % جواد يرى بذل النوال فريضة % عليه فما زالت تعم نوافله % 24(@)(@@) % له همة نافت على الأوج رفعة % تقاصر عنها حين همت تطاوله % % 25(@)(@@) % أجل همام أدرك المجد همة % وأكرم مولى جاوز الحد نائله % % 26(@)(@@) % وقد أيقنت نفس المكارم أنها % % لتحيا بيحيى حين عمت فواضله % 27(@)(@@) % أخ لي ما زالت أواخي إخائه % % موطدة منه ببر يواصله % % 28(@)(@@) % ليهنك مجد يا ابن أحمد لم تزل % % فواضله مشهورة وفضائله % 29(@)(@@) % أبى الله إلا أن ينيف بك العلى % % ويعلي بك المجد الذي أنت كافله % % 30(@)(@@) % وما زلت تسعى بالمكارم طالبا % مقاما تناهى دونه من يحاوله % % PageV01P305 31(@)(@@) % فحسبك قد جزت الأنام برتبة % تشير لها من كل كف أنامله % 32(@)(@@) % سأشكر ما أهديت لي من أزاهر % يجول عليها من ندى الحسن جائله % % 33(@)(@@) % وأثني على ما صغته من قلائد % تحلى بها من جيد مدحي عاطله % % 34(@)(@@) % فدم سالما من كل سوء مهنأ % بما نلته دهرا وما أنت نائله % 35(@)(@@) % ودونكها من بعض شكري وما عسى % % يفي بالذي أوليت ما أنا قائله % % PageV01P306 البحر : طويل 1(@)(@@) % أبو طالب عم النبي محمد % به قام أزر الدين واشتد كاهله % % 2(@)(@@) % ويكفيه فخرا في المفاخر أنه % % مؤازره دون الأنام وكافله % % 3(@)(@@) % لئن جهلت قوم عظيم مقامه % % فما ضر ضوء الصبح من هو جاهله % % 4(@)(@@) % ولولاه ما قامت لأحمد دعوة % ولا انجاب ليل الغي وانزاح باطله % % 5(@)(@@) % أقر بدين الله سترا لحكمة % فقال عدو الحق ما هو قائله % % 6(@)(@@) % وماذا عليه وهو في الدين هضبة % إذا عصفت من ذي العناد أباطله % 7(@)(@@) % وكيف يحل الذم ساحة ماجد % أواخره محمودة وأوائله % 8(@)(@@) % عليه سلام الله ما ذر شارق % وما تليت أخباره وفضائله % % PageV01P307 البحر : منسرح 1(@)(@@) % لا طرقتك الخطوب والعلل % % ولا اعتراك الفتور والكسل % % 2(@)(@@) % حاشاك 
ms87	 من علة ومن كسل % ما اعتل إلا الرجاء والأمل % 3(@)(@@) % يا ماجدا بالفخار متسما % دانت له الشامخات والقلل % 4(@)(@@) % ولاح نجم الهدى بطلعته % % فاتضحت من ضيائه السبل % % 5(@)(@@) % أنت الذي حزت كل مكرمة % بها مدى الدهر يضرب المثل % 6(@)(@@) % فاسلم ودم راقيا ذرى شرف % تقصر عنها البوازل الطول % % 7(@)(@@) % وابق موقا من كل حادثة % وغصنك الدهر مورق خضل % % PageV01P308 البحر : كامل تام 1(@)(@@) % وافتك تنهج للخطاب سبيلا % % وتجر ذيلا للعتاب طويلا % % 2(@)(@@) % غراء تهزأ بالنجوم لوامعا % والزهر غضا والنسيم بليلا % % 3(@)(@@) % قد سمتها التقبيل فيك ولم أقل % % لولا المشيب لسمتها تقبيلا % % 4(@)(@@) % حملتها جمل العتاب وإنما % % فصلت در مقالها تفصيلا % % 5(@)(@@) % ما فاخرت قولا بحسن نظامها % % إلا وجاءت وهي أحسن قيلا % % 6(@)(@@) % أجريت طرف العتب في مضمارها % % فأتاك يشأو السابقات ذميلا % % 7(@)(@@) % ما لليالي قد وقفن مبرزا % وفللن عضبا من وفاك صقيلا % % 8(@)(@@) % فصرمتني ونبذت حبل مودتي % % واعتضت عن ودي العداة بديلا % % 9(@)(@@) % وصدفت عن سبل الوفاء مجنبا % وسلكت من طرق الجفاء سبيلا % % 10(@)(@@) % فحملت منك على مزاولة النوى % % عبئا علي مع الزمان ثقيلا % % PageV01P309 11(@)(@@) % مهلا فما أعرضت عني واثقا % إلا بمن لم يغن عنك فتيلا % % 12(@)(@@) % فانظر لنفسك ما أتيت فلن أرى % % لك لو علمت بما أتيت قبيلا % % 13(@)(@@) % الله في حرمات ود أصبحت % % هملا وأصبح هديها تضليلا % % 14(@)(@@) % كم شامت قد كان يأمل أن يرى % % ربع الوداد وقد رآه محيلا % % 15(@)(@@) % فارجع بودك عن قريب طالبا % عذرا على رغم العدو جميلا % % 16(@)(@@) % حتى أجادل فيك كل مكذب % % وأقيم منك على الوفاء دليلا % % 17(@)(@@) % حاشا لمثلك والمودة ذمة % أمسى بها العهد القديم كفيلا % % 18(@)(@@) % إني أؤمل أن أزيل بك الجوى % % وأبل من حر الفؤاد غليلا % % 19(@)(@@) % وأعود أنشد في هواك ندامة % % يا ليتني لم أتخذك خليلا % % PageV01P310 البحر : وافر تام 1(@)(@@) % سقى تلك الأباطح والرمالا % % عهاد الغيث ينهمل انهمالا % % 2(@)(@@) % وحيا الله بالجرعاء حيا % رعيت به الغزالة والغزالا % % 3(@)(@@) % ديارا كنت آمنها نزولا % ولا أخشى لدائرة نزالا % % 4(@)(@@) % إذا هزت غوانيها 
ms88	 قدودا % تهز رجالها أسلا طوالا % % 5(@)(@@) % لعمرك ما رماة بني أبيها % % بأصمى من لواحظها نبالا % % 6(@)(@@) % وبي منهن واضحة المحيا % % هضيم الكشح جاهزة دلالا % % 7(@)(@@) % تعير الظبي ملتفتا وجيدا % وتكسو الغصن لينا واعتدالا % % 8(@)(@@) % تميط لثامها عن بدر تم % تجلى فوق غرتها هلالا % % 9(@)(@@) % أغار من الرياح إذا أمالت % مهفهف قدها يوما فمالا % % 10(@)(@@) % تقابلها إذا هبت قبولا % % وتشملها إذا نسمت شمالا % % PageV01P311 11(@)(@@) % وما أغرى الفؤاد بحب خود % منوع لن تنيل ولن تنالا % % 12(@)(@@) % سبت جفني نومهما لكيلا % % أواصل في المنام لها خيالا % % 13(@)(@@) % ولست إذا طلبت الوصل منها % % بأول عاشق طلب المحالا % % 14(@)(@@) % غبطت الركب حين بها استقلوا % % فكم حملت جمالهم جمالا % % 15(@)(@@) % أقول لصاحبي لما تجلت % % وجلت أن أصيب لها مثالا % % 16(@)(@@) % أبدر الأفق لاح فقال كلا % متى كانت منازله الحجالا % % 17(@)(@@) % ورب لوائم أوقرن سمعي % % ملاما ظل يوقرني ملالا % % 18(@)(@@) % هجرن بذمهن الهجر منها % % ولا هجرا عرفن ولا وصالا % % 19(@)(@@) % ولو أني أكافيهن يوما % جعلت خدودهن لها نعالا % % 20(@)(@@) % وكم حاولت صبري في هواها % % فقال إليك عني واستقالا % % PageV01P312 البحر : خفيف تام 1(@)(@@) % يا غزالا يخفي سناه الغزاله % % فتنتني لحاظك الغزاله % 2(@)(@@) % مر دهر والعيش صفو إلى أن % % ذاق قلبي طعم الهوى فحلاله % 3(@)(@@) % ما لقلبي والحب لو لم تمله % % للتصابي أعطافك المياله % % 4(@)(@@) % زادني لحظك السقيم اعتلالا % لا شفى الله سقمه واعتلاله % 5(@)(@@) % كنت غرا بالحب حتى دهتني % % برناها لحاظك المغتاله % % 6(@)(@@) % كيف أرجو الوفا وأنت على العهد % % بطيء الرضا سريع الملاله % % 7(@)(@@) % قلت لما أاطال فيك عذولي % % أنا راض به على كل حاله % % 8(@)(@@) % يا نسيما سرى من الغور وهنا % ساحبا في ربى الحمى أذياله % % 9(@)(@@) % طاب نشرا بطيب من سكن الجزع % % ووافى يجر برد الجلاله % % 10(@)(@@) % فروى أحسن الحديث صحيحا % مسندا عنهم وأدى الرساله % % PageV01P313 11(@)(@@) % هات كرر ذاك الحديث لسمعي % % ولك الطول ان رايت الإطاله % % 12(@)(@@) % قد نكأت الغداة في القلب جرحا % كنت أرجو بعد البعاد اندماله % 13(@)(@@) % يالك الخير إن أتيت ربى سلع % % وشارفت 
ms89	 كثبه ورماله % 14(@)(@@) % قف بأعلامه وسل عن فؤاد % ختلته ظباؤه المختاله % % 15(@)(@@) % وتلطف واشرح لهم حال صب % غير السقم حاله فأحاله % % 16(@)(@@) % ما سرى بارق برامة إلا % واستهلت دموعي الهطاله % % 17(@)(@@) % وتذكرت مربع الأنس والهم % % وعصر الصبا وعهد البطاله % 18(@)(@@) % حيث ظلي من الشباب ظليل % والهوى مسبغ علي ظلاله % % PageV01P314 البحر : متقارب تام 1(@)(@@) % سقى الله أيامنا بالحجاز % % ولا جازها الغيدق الهاطل % 2(@)(@@) % فما كان أرغد عيشي بها % % إذ المنزل القفر بي آهل % 3(@)(@@) % لقد طال وجدي وذكري لها % % وليس لما قد مضى طائل % 4(@)(@@) % فيا لهف نفسي له ماضيا % ترحل والوجد بي نازل % % 5(@)(@@) % ترى من غرامي به دائم % % وحالي من فقده حائل % % 6(@)(@@) % درى أن وجدي به لا يزول % % وصبري من بعده زائل % % 7(@)(@@) % يقولون لي إنه خاذل % وخير الظبا الشادن الخاذل % % 8(@)(@@) % أتعذلني جاهلا حاله % % لك الويل يا أيها العاذل % 9(@)(@@) % تجيب الصفاة وليس يجيب % % ودمعي على وجنتي سائل % % PageV01P315 البحر : متقارب تام 1(@)(@@) % إلى الله مما يلاقي المحب % بليلى وما نال في الحب نيلا % % 2(@)(@@) % قضى العمر بين بكا واشتياق % فيبكي نهارا ويشتاق ليلا % % PageV01P316 البحر : مجتث 1(@)(@@) % يا عاذلي في الأماني % % أكثرت في العذل قولا % % 2(@)(@@) % دعني أعلل نفسي % % ما أضيق العيش لولا % % PageV01P317 البحر : طويل 1(@)(@@) % ومزر بضوء الشمس لم تر وجهه % ولا ماثلته في علو ولا نبل % % 2(@)(@@) % بلينا جوى إن رام منا تدللا % على الحب إبلاء النفوس ولا نبلي % % PageV01P318 البحر : طويل 1(@)(@@) % وأهيف قد قد القلوب بقده % % وما هو حدي سنان ولا نصل % 2(@)(@@) % صلتنا لظى الهيجاء إن سامنا هوى % على حبه صلي النفوس ولا نصلي % % PageV01P319 البحر : رجز تام 1(@)(@@) % روى لنا المشط حديثا عجبا % من فرعها الداجي كليل أليل % 2(@)(@@) % إذ أرسلته واردا مسلسلا % فاعجب له من مرسل مسلسل % PageV01P320 البحر : بسيط تام 1(@)(@@) % تجن واعتب تجد مني بذاك رضا % والعذر إن شئت مسموع ومقبول % 2(@)(@@) % ولم أؤاخذك في ذنب ولا عتب % فالذنب والعتب موضوع ومحمول % PageV01P321 البحر : طويل 1(@)(@@) % لنا كل يوم رنة وعويل % % وخطب يكل 
ms90	 الرأي وهو صقيل % 2(@)(@@) % بكيت لو أن الدمع يرجع ميتا % وأعولت لو أجدى الحزين عويل % 3(@)(@@) % لحما لله دهرا لا تزال صروفه % % تطول علينا دائما وتعول % % 4(@)(@@) % علام وفيما قد أصاب مقاتلي % % وغادرني هامي الدموع أعول % 5(@)(@@) % وحملني خطبا تضاءلت دونه % % وما أنا قدما للخطوب حمول % % 6(@)(@@) % بموت كريم ماجد وابن ماجد % له العز دار والعلاء مقيل % % 7(@)(@@) % فتى قد عنت يوم الهياج له القنا % % وراح الحسام العضب وهو ذليل % 8(@)(@@) % بكاه القنا الخطي علما بأنه % % كسير وأن المشرفي كليل % 9(@)(@@) % فمن للعوالي بعد كفيه والندى % % ومن في صفوف الناكثين يجول % 10(@)(@@) % ومن بعده للسيف والضيف % % والعلى ومن بعده للمكرمات كفيل % PageV01P322 11(@)(@@) % ربيب علا شح الزمان بمثله % % وكل زمان بالكرام بخيل % 12(@)(@@) % ولما نعى الناعي به ضاق بي الفضا % % وراحت دموعي الجامدات تسيل % % 13(@)(@@) % وهيهات أن تأتي النساء بمثله % % ويخلف عنه في الأنام بديل % 14(@)(@@) % سأبكيك يا عمار ما ناح طائر % وما ندبت بعد الرحيل طلول % % 15(@)(@@) % مصابي وإن طولته عنك قاصر % ودمعي وإن كثرت فيك قليل % % 16(@)(@@) % سلكت وأسلكت الأسى في حشاشتي % % ممر سبيل ما سواه سبيل % % 17(@)(@@) % لك اليوم في قلبي مكان مودة % ودادك فيه ما حييت نزيل % % 18(@)(@@) % فإن هاطلات السحب شحت بسقيها % % سقاك من الجفن القريح هطول % % 19(@)(@@) % عليك سلام الله مني تحية % % مدى الدهر ما غال البرية غول % % PageV01P323 البحر : بسيط تام 1(@)(@@) % حسن ابتدائي بذكري جيرة الحرم % % له براعة شوق تستهل دمي % % 2(@)(@@) % دعني وعجبي وعج بي بالرسوم ودع % % مركب الجهل واعقل مطلق الرسم % 3(@)(@@) % بانوا فهان دمي عندي فها ندمي % % على ملفق صبري بعد بعدهم % % 4(@)(@@) % وذيل الدم دمعي يوم فرقهم % % وراح حبي بلبي لاحقا بهم % % 5(@)(@@) % يا زيد زيد المنى مذ تم طرفني % % وقال هم بهم تسعد بقربهم % 6(@)(@@) % كم عاذل عادل عنهم يصحف لي % % ما حرفته وشاة الظلم والظلم % % 7(@)(@@) % ما زلت في حرق منهم وفي حزن % % مشوش الفكر من خصمي ومن حكمي % % 8(@)(@@) % ظنوا سلوي إذ ضنوا فما لفظوا % % بذكر أنس 
ms91	 مضى للقلب في إضم % 9(@)(@@) % قدري أبو حسن يا معنوي بهم % % ووصف حال ابنة حال بحبهم % % 10(@)(@@) % أجروا سوابق دمعي في محبتهم % % واستطردوها كخيلي يوم مزدحم % % PageV01P324 11(@)(@@) % ذوى وريق شبابي في الغرام بهم % % من استعارة نار الشوق والألم % 12(@)(@@) % ولوا بسخط وعنف نازحين وقد % % قابلتهم بالرضا والرفق من أمم % 13(@)(@@) % وإن هم استخدموا عيني لرعيهم % % أو حاولوا بذلها فالسعد من خدمي % % 14(@)(@@) % إن افتنانهم في الحسن هيمني % % قدما وقد وطئت فرق السهى قدمي % % 15(@)(@@) % لفي ونشري انتهائي مبدأي شغفي % % معهم لديهم إليهم منهم بهم % % 16(@)(@@) % ما أسعد الظبي لو يحكي لحاظهم % % أو كنت يا ظبي تعزى لالتفاتهم % 17(@)(@@) % أملت عودهم بعد العتاب وقد % % عادوا ولكن إلى استدراك صدهم % 18(@)(@@) % قالوا وقد أبهموا إنا لنرغب أن % % نراك من إضم لحما على وضم % 19(@)(@@) % إن أدن ينأوا وما قلبي كقلبهم % % وهل يطابق مصدوع بملتئم % % 20(@)(@@) % أرسلت إذ لذ لي جيهم مثلا % % وقد يكون نقيع السم في الدسم % PageV01P325 21(@)(@@) % تخيير قلبي أضناني بهم ومحا % % مني الوجود وألجاني إلى الندم % % 22(@)(@@) % راموا النزاهة عن هجو وقد فعلوا % % ما ليس يرضاه حفظ العهد والذمم % 23(@)(@@) % هازلت بالجد عذالي فقلت لهم % % أكثرتم العذل فاخشوا كظة البشم % 24(@)(@@) % تهكما قلت للواشين لي بهم % % لقد هديتم لفصل القول والحكم % 25(@)(@@) % قالوا وقد زخرفوا قولا بموجبه % % فهمت قلت هيام الصب ذي اللمم % 26(@)(@@) % كم ادعوا صدقهم يوما وما صدقوا % % سلمت ذاك فما أرجو بصدقهم % % 27(@)(@@) % قالوا سمعنا وهم لا يسمعون وقد % % أوروا بجنبي نارا باقتباسهم % 28(@)(@@) % عدلت قصدا لأسلوب الحكيم وقد % % قالوا تشاقلت ثوب الصدق والحكم % % 29(@)(@@) % هديت يا لائمي فاترك مواربتي % % فليس يحسن إلا ترك ودهم % % 30(@)(@@) % أحسن أسيء ظن حقق ادن أقص أطل % % حك وش فوف أبن اخف ارتحل أقم % PageV01P326 31(@)(@@) % من رام رشد أخي غي هدى وأتى % % كلامه جامعا للصدق لا التهم % % 32(@)(@@) % قالوا تراجعهم من بعد قلت نعم % % قالوا أتصدق قلت الصدق من شيمي % % 33(@)(@@) % وإنني سوف أوليهم مناقضة % إذا هرمت وشب الشيخ بالهرم % 34 
ms92	(@)(@@) % غايرت غيري في جيهم فأنا % % أهوى الوشاة لتقريبي لسمعهم % % 35(@)(@@) % هم وشحوني بمنثور الدموع وقد % % توشحوا من لأ ليهم بمنتظم % 36(@)(@@) % عدمت تذييل حظي حين قصره % % طول التفرق والدنيا إلى عدم % % 37(@)(@@) % تشابهت فيهم أطراف وصفهم % % ووصفهم لم يطقه ناطق بفم % % 38(@)(@@) % أنا الذي جئت تتميما لمدحهم % % نظما بقول يباهي الدر في القيم % % 39(@)(@@) % هجوت في معرض المدح الحسود لهم % % فقلت انك ذو صبر على السدم % 40(@)(@@) % لم يكتفوا بي عميدا في محبتهم % % بل كل ذي نظر فيهم أراه عمي % % PageV01P327 41(@)(@@) % زاد احتباك غرامي يا عذول بهم % % فبرئ القلب من غي أو اتهم % % 42(@)(@@) % نتائجي اتصلت والاتصال بهم % % عز وعزي بهم فخر على الأمم % % 43(@)(@@) % بهجرهم كم وكم فل الهوى أمما % ورد صدرا على عجز بهجرهم % % 44(@)(@@) % سلوت من بعدهم هيف القدود فلم % % استثن إلا غصونا شبهت بهم % 45(@)(@@) % وقد قصدت مراعاة النظير لهم % % من جلنار ومن ورد ومن عنم % % 46(@)(@@) % رفعت حالي إليهم إذ خفضت وقد % % نصبت طرفي إلى التوجيه رسلهم % % 47(@)(@@) % طربت في البعد من تمثيل قربهم % % والمرء قد تزدهيه لذة الحلم % 48(@)(@@) % عتاب المرء نفسه اتبت نفسي وقلت الشيب أنذرني % % وأنت يا نفس عنه اليوم في صمم % 49(@)(@@) % لا بر صدقي وعزمي في العلى قسمي % % إن لم أردك رد الخيل باللجم % % 50(@)(@@) % وقد هديت إلى حسن التخلص من % % غي النسيب بمدحي سيد الأمم % % PageV01P328 51(@)(@@) % محمد أحمد الهادي البشير بن عب % % عبد الله فخر نزار باطرادهم % % 52(@)(@@) % عز الذليل ذليل العز مبغضه % % فاعجب لعكس أعاديه وذلهم % % 53(@)(@@) % هو القسيم له أوفى القسيم على % % نفي القسيم ولا ترديد في القسم % 54(@)(@@) % زاكي النجار علو المجد ناسبه % % زاهي الفخار كريم الجد ذو شمم % 55(@)(@@) % أفضاله ومعاليه ورفعته % % جمع من الفضل فيه غير منقسم % % 56(@)(@@) % أوصافه انسجمت للذاكرين لها % % في هل أتى في سبا في نون والقلم % % 57(@)(@@) % فاسمع تناسب أطراف المديح له % % وافهم معانيه إن كنت ذا فهم % % 58(@)(@@) % معظم بائتلاف المعنيين له % % من عفو مقتدر أو عز منتقم % 59 
ms93	(@)(@@) % كل البليغ وقد أطرى مبالغة % عن حصر بعض الذي أولى من النعم % % 60(@)(@@) % لو أنه رام إغراق العداة له % % لأصبح البر بحرا غي مقتحم % % PageV01P329 61(@)(@@) % ولا غلو إذا ما قلت عزمته % % تكاد تثني عهود الأعصر القدم % 62(@)(@@) % قاسوه بالبحر والتفريق متضح % أين الأجاج من المستعذب الشبم % % 63(@)(@@) % تلميحه كم شفى في الخلق من علل % وما لعيسى يد فيها فلا تهم % 64(@)(@@) % وآدم إذ بدا عنوان زلته % % به توسل عند الله في القدم % % 65(@)(@@) % به دعا إذ دعا فرعون شيعته % % موسى فافلت من تسهيم سحرهم % % 66(@)(@@) % لاح الهدى فهدى تشريع ملته % % لما بدا لسلوك المنهج الأمم % % 67(@)(@@) % والله لولا هداه ما اهتدى أحد % لمذهب من كلام الله ذي الحكم % 68(@)(@@) % نفى بإيجابه عنا وسنته % % جهلا نضل به عن واضح اللقم % % 69(@)(@@) % ولا رجوع لغاوي نهج ملته % % بلى بإرشاده الكشاف للغمم % % 70(@)(@@) % ردت بمعجزه من غير تورية % له الغزالة تعدو نحو أفقهم % PageV01P330 71(@)(@@) % تجاهل العارف الباغي فقال له % % أمعجز ما ترى أم سحر مجترم % % 72(@)(@@) % وما عليه اعتراض في نبوته % % 73(@)(@@) % وقصد إحضاره في الذهن لاح لنا % % لما سرى فيؤم الرسل من أمم % 74(@)(@@) % هو العوالم عن حصر بأجمعها % % وملحق الجزء بالكلي في العظم % % 75(@)(@@) % تهذيب فطرته أغناه عن أدب % في القول والفعل والأخلاق والشيم % 76(@)(@@) % ما زال آباؤه بالحمد مذ عرفوا % % فكان أحمدهم وفق اتفاقهم % 77(@)(@@) % ضياؤه الشمس في تفريق جمع دجى % وقدره الشمس لم تدرك ولم ترم % % 78(@)(@@) % وكم غزا للعدى جمعا فقسمه % % فالزوج للأيم والمولود لليتم % % 79(@)(@@) % فمن يماثله أو من يجانسه % % أو من يقاربه في العلم والعلم % % 80(@)(@@) % لقد تقمص بردا وشعته له % % فخرا يد الأعظمين البأس والكرم % PageV01P331 81(@)(@@) % تكميل قدرته بالحلم متصف % مع المهابة في بشر وفي أضم % % 82(@)(@@) % شيئان شبههما شيئان منه لنا % % نداه في المحل مثل البرء في السقم % % 83(@)(@@) % سامي الكناية مهزول الفصيل إذا % % ما جاءه الضيف أبدى بشر مبتسم % % 84(@)(@@) % لا يسلب القرن إيجابا لرفعته % % ويسلب النقص من إفضاله العمم % % 85(@)(@@) % يجزي العداة 
ms94	 بعدوان مشاكلة % والفضل بالفضل ضعفا في جزائهم % % 86(@)(@@) % ساوت شجاعته فيهم فصاحته % % فردهم معجزا بالكلم والكلم % % 87(@)(@@) % ماضيه كالبرق والتشبيه متضح % ينهل في إثره ما لاح صوب دم % % 88(@)(@@) % إذا فرائد جيش عنده اتسقت % % مشى العرضنة والشعواء في ضرم % 89(@)(@@) % كفاه نصرا على تصريع جيشهم % % رعب تراع له الآساد في الأجم % % 90(@)(@@) % لم تبق يدر لهم بدرا وفي أحد % لم يبق من أحد عند اشتقاقهم % % PageV01P332 91(@)(@@) % ألم يفد أجر بر جاد في ملأ % لم يستحل بانعكاس عن عطائهم % % 92(@)(@@) % إن مد كفا لتقسيم النوال لهم فهم % % ما بين معطى ومستجد ومستلم % 93(@)(@@) % درى إشارة من وافاه مجتديا % فجاد ما جاد مرتاحا بلا سأم % % 94(@)(@@) % شمسس وبدر ونجم يستضاء به % % ترتيبه ازدان من فرع إلى قدم % % 95(@)(@@) % ما أوغل الفكر في قول لمدحته % % وهو الزعيم زعيم القادة البهم % % 96(@)(@@) % للواصفين علاه كل آونة % توليد معنى به الألفاظ لم تقم % % 97(@)(@@) % إبداع مدحي لمن لم يبق من بدع % أفاد ربحي فإن أطنبت لم ألم % 98(@)(@@) % % إلا وجاء بعقد غير منفصم % % 99(@)(@@) % فهل نوادر قولي إذ أتت علمت % % بأنها مدح خير العرب والعجم % % 100(@)(@@) % تطريز مدحي في علياه منتظم % في خير منتظم في خير منتظم % PageV01P333 101(@)(@@) % تكرار قولي حلا في الباذخ العلم م % % ابن الباذج العلم بن الباذج العلم % % 102(@)(@@) % وآله الطاهرون المجتبون أتى % % في هل أتى ظاهرا تنكيت فضلهم % 103(@)(@@) % هم عصمة للورى ترجى النجاه بهم % % يا فوز من زانه حسن اتباعهم % % 104(@)(@@) % أطعهم واحذر العصيان تنج إذا % % بيض الوجوه غدت في النار كالفحم % 105(@)(@@) % بسط الأكف يرون الجود مغنمة % لا يعرفون لهم لفظا سوى نعم % % 106(@)(@@) % ما الروض غب الندى فاحت روائحه % % يوما بأضوع من تفريغ نعتهم % % 107(@)(@@) % بيض المكارم سود النقع حور ظبى % خضر الديار فدبج وصف حالهم % 108(@)(@@) % تفسيرهم ومزاياهم وفخرهم % % بعلمهم ومعاليهم وجودهم % 109(@)(@@) % لا يستطيع الورى تعديد فضلهم % % في العلم والحلم والأفضال والكرم % 110(@)(@@) % الحسن ناسق والإحسان وافق م % % والإفضال طابق ما بين انتظامهم % % PageV01P334 111(@)(@@) % ما طاب 
ms95	 تعليل نشر الريح إذ نسمت % % إلا لالمامها يوما بأرضهم % 112(@)(@@) % من التعطف ما زالوا على خلق % إن التعطف معروف لخلقهم % 113(@)(@@) % يعفون عن كل ذي ذنب إذا قدروا % % مستتبعين نداهم عند عفوهم % % 114(@)(@@) % تمكين عدل لهم أرسوا قواعده % % يرعى به الذئب في الموعى مع الغنم % % 115(@)(@@) % وظنهم زاد إيضاحا وبخلهم % % بعرضهم ونداهم فاض كالديم % % 116(@)(@@) % إن شئت في معرض الذم المديح فقل % % لا عيب فيهم سوى إكثار نيلهم % % 117(@)(@@) % محققون لتوهيم العدى أبدا % كأنهم يعشقون البيض في القمم % 118(@)(@@) % من كل كاسر جفن لا هدو له % % من الغرار فخذ ألغاز وصفهم % % 119(@)(@@) % هم أردفوا عذب الخطى جائلة % حيث الوشاح بضرب الصارم الخذم % 120(@)(@@) % قل في علي أمير النحل غرتهم % % ما شئت وفق اتساع المدح واحتكم % % PageV01P335 121(@)(@@) % لا تعرضن لتعريضي بمدحته % % فإنني في ولادي غير متهم % 122(@)(@@) % هم هم ائتلفوا جمعا وما اختلفوا % % لولا الأبوة قلنا باستوائهم % % 123(@)(@@) % إيداع قلبي هواهم شاد لي بهم % % من العناية ركنا غير منهدم % % 124(@)(@@) % الحمد لله حمدا دائما أبدا % على مواردتي قومي بحبهم % 125(@)(@@) % إن التزامي في ديني بجدهم % % ما زال يفعم قلبي صدق ودهم % % 126(@)(@@) % إذا تزاوج إثمي فاقتضى نقمي % % حققت فيهم رجائي فاقتضى نعمي % % 127(@)(@@) % هم المجاز إلى باب الجنان غدا % فلست أخشى وهم لي زلة القدم % 128(@)(@@) % جردت منهم لأعناق العدى قضبا % تبري الرقاب بحد غير منثلم % 129(@)(@@) % حققت إيهام توكيدي لحبهم % % ولم أزل مغريا وجدي بهم بهم % % 130(@)(@@) % بهم ترصع نظمي وانجلى ألمي % % وكم توسع علمي واعتلى علمي % % PageV01P336 131(@)(@@) % طويت عن كل أمر يستلذ به % % كشحا وقد لذ لي تفصيل مدحهم % 132(@)(@@) % إذا أتيت بترشيح لمدحتهم % % حلى لساني وجيدي فضل ذكرهم % % 133(@)(@@) % حذفت ود سوى آل الرسول ولم % % أمدح سواهم ولم أحمد ولم أرم % 134(@)(@@) % تقييد قلبي بمدحي فيهم شرفي % % في النشأتين ففخري في مديحهم % % 135(@)(@@) % سمطت من فرحي في وصفهم مدحي % % ولم أنل منحي إلا بجاههم % % 136(@)(@@) % جزيت في كلمي أغليت في حكمي % % أبديت من هممي أرويت كل ظمي % % 137 
ms96	(@)(@@) % نلت السلامة من بحر القريض وقد % % سلكته لاختراعي در وصفهم % % 138(@)(@@) % وصحبه الأوفياء الأصفياء أتى % % تضمين مزدوج مدحي لجمعهم % 139(@)(@@) % لفظي ومعناي قد صح ائتلافهما % % بمدح أروع ماضي السيف والقلم % 140(@)(@@) % موازن مازن مستحسن حسن % معاون صائن مستمكن شهم % PageV01P337 141(@)(@@) % تألف اللفظ والوزن البسيط له % % فاطرب له من بديع النظم منسجم % 142(@)(@@) % وألف الوزن والمعنى له لسني % % بمقول غير ذي عي ولا وجم % % 143(@)(@@) % وجاء باللفظ فيه وهو مؤتلف % باللفظ يحدو به الحادون بالنغم % % 144(@)(@@) % لا ترض إيجاز مدحي فيه واصغ إلى % % مدحي الذي شاع بين الحل والحرم % % 145(@)(@@) % تسجيع منتظمي والغر من حكمي % % ألفاظها بفمي در من الحكم % % 146(@)(@@) % وأنت يا سيد الكونين معتمدي % % في أن تسهل ما أرجو ومعتصمي % % 147(@)(@@) % أدمجت مدحك والأيام عابسة % وأنت أكرم من يرجى لدى الازم % 148(@)(@@) % وكم مننت بلا من على وجل % من احتراس حلول الخطب لم ينم % 149(@)(@@) % حسن البيان أرانا منك معجزة % أضحت تقر لديها الفصح بالبكم % % 150(@)(@@) % نصرت بالرعب والأقدار كافية % وعقد نصرك لم يحلله ذو أضم % PageV01P338 151(@)(@@) % كم مارد حرد شطرته بيد % تشطير منتقم بالله ملتزم % 152(@)(@@) % فمن يساويك في فضل ومكرمة % وأنت أفضل خلق الله كلهم % 153(@)(@@) % براعتي أبت التصريح في طلبي % % لما رأت من غوادي جودك السجم % 154(@)(@@) % الحق بحسن ابتدائي ما أنال به % % حسن التخلص يتلو حسن مختتم % % PageV01P339 البحر : طويل 1(@)(@@) % سل البان عنهم أين بانوا ويمموا % % أللجزع ساروا أم برامة خيموا % % 2(@)(@@) % وهل شرعت تلك القباب بسفحها % % وأمسى بها حاديهم يترنم % 3(@)(@@) % وهل رنحت فيها الغواني قدودها % % وأغصانها من غيرة تتبرم % 4(@)(@@) % وهل هيمنت ريح الصبا بشعابها % % سحيرا وراحت بالشذا تتنسم % % 5(@)(@@) % وهل وردت ماء العذيب أوانس % % فإني أرى أرجاءه تتبسم % % 6(@)(@@) % وبي غادة منهن ما أسفرت ضحى % لشمس الضحى إلا غدت تتلثم % 7(@)(@@) % تغير سنى الأقمار غرة وجهها % % ويحسد عطفيها الوشيج المقوم % 8(@)(@@) % تقسم فيها الحسن لما تفردت % % فكل فؤاد في هواها مقسم % 9(@)(@@) % ولم أنسها والبين ينعق بيننا % % ونار الجوى بين الجوانح تضرم 
ms97	 % 10(@)(@@) % وقد نثرت در الدموع بخدها % % وفي جيدها در العقود المنظم % PageV01P340 11(@)(@@) % أسائلها يوم التفرق عن دمي % % فتومي بكف عند من ؟ وهي عندم % 12(@)(@@) % وسارت فسالت أدمع من محاجر % % فما أبعدت إلا وأكثرها دم % 13(@)(@@) % وراحت حداة العيس تشدو بذكرها % % وظلت مطاياها تغور وتتهم % 14(@)(@@) % وما كلمتني حين زمت رحالها % % ولكن قلبي راح وهو مكلم % 15(@)(@@) % وكم من خلي ثم لم يدر ما الهوى % % غدا وهو مغرى بالصبابة مغرم % 16(@)(@@) % أغارت عليه بالفتور لحاظها % % وأقصده منها نبال وأسهم % 17(@)(@@) % تصرم صفو العيش بعد فراقها % % فلم يبق إلا حسرة وتندم % 18(@)(@@) % يقولون سل عنها الديار بذي الغضا % % وهل ذو الغضا إلا فؤادي المتيم % 19(@)(@@) % وما خيمت بالمنحنى من محجر % ولكن ضلوعي المنحنى والمخيم % 20(@)(@@) % وإن يممت سفح العقيق بمقتلي % % فيا حبذا سفح العقيق الميمم % PageV01P341 21(@)(@@) % ونفحة طيب من لطائم نشرها % % تحملها عنها النسيم المهينم % 22(@)(@@) % فجاء يجر الذيل من مرح بها % % ووافى بها والركب يقظى ونوم % % 23(@)(@@) % فلم يدر ما أهدته لي غير مهجتي % % ولا ارتاح إلا قلبي المتألم % 24(@)(@@) % لئن ضاع عهدي عندها بعد بعدها % % فما ضاع عندي عهدها المتقدم % 25(@)(@@) % ولم تثنني عنها مقالة لائم % وان أكثرت فيها وشاة ولوم % 26(@)(@@) % وأكتم وجدي في هواها تجلدا % ولكن دمعي بالغرام يترجم % 27(@)(@@) % توهم سلواني العذول جهالة % بما جن قلبي ساء ما يتوهم % 28(@)(@@) % فيا جيرة كانوا وكنا بقربهم % % نذل تصاريف الزمان ونرغم % 29(@)(@@) % تحلى بهم عيشي ليالي وصالهم % % فمرت فأضحى وهو صاب وعلقم % 30(@)(@@) % نشدتكم هل عهدنا بطويلع % % على العهد مأهول كما كنت أعلم % PageV01P342 31(@)(@@) % وهل دارنا بالشعب جامعة لنا % % وهل عائد بالوصل عيد وموسم % 32(@)(@@) % % وعاد ربيع الوصل وهو محرم % 33(@)(@@) % ولو شئتم ما فرق البين بيننا % % ولا عن طير للتفرق أشأم % 34(@)(@@) % ولكنكم أبعدتم شقة النوى % % فأصبحت من جور النوى أتظلم % % 35(@)(@@) % صلوا أو فصدوا كيف شئتم فأنتم % % أحبه فلبي جرتم أم عدلتم % 36(@)(@@) % وإن جل خطبي في هواكم فمخلصي % % إذا عظم الخطب الجناب المعظم % 37(@)(@@) % محمد المبعوث 
ms98	 من آل هاشم % وخاتم رسل الله وهو المقدم % 38(@)(@@) % نبي الهدى بحر الندى أشرف الورى % % وأكرم خلق الله جاها وأعظم % 39(@)(@@) % بمبعثه إنجيل عيسى مبشر % وتوراة موسى والزبور مترجم % 40(@)(@@) % به أشرقت شمس الهداية بعدما % % أضل الورى ليل من الغي مظلم % PageV01P343 41(@)(@@) % له معجزات لا يوارى ضياؤها % % وكيف يوارى الصبح أم كيف يكتم % 42(@)(@@) % بمولده غارت بحيرة ساوة % وايوان كسرى راح وهو مهدم % 43(@)(@@) % وأخمد نيران المجوس قدومه % % وكانت على عبادها تتضرم % 44(@)(@@) % وأمست نجوم الأفق تدنو وشهبها % % رجوم لسراق الشياطين ترجم % 45(@)(@@) % درت على ظئريه من بركاته % % بمقدمة أنواع بر وأنعم % 46(@)(@@) % وردت عليه الشمس بعد غروبها % % وشق له بدر السماء المتمم % % 47(@)(@@) % وفاضت مياه من أنامل كفه % % فأورت بها علا ظماء وحوم % 48(@)(@@) % ومن شاطىء الوادي أجابته دوحة % وجاءت إليه من قريب تسسلم % 49(@)(@@) % وحن إليه الجذع بعد فراقه % % فراح لما قد ناله يتحطم % 50(@)(@@) % وفي كفه من خشية سبح الحصى % % ومن جودها أثرى فقير ومعدم % PageV01P344 51(@)(@@) % ترقى إلى السبع السماوات صاعدا % وبارؤه يدينه برا ويكرم % 52(@)(@@) % فأم جميع الأنبياء مقدما % وحقق له حقا هناك التقدم % 53(@)(@@) % وصلى عليه الله في ملكوته % % وقال لنا صلوا عليه وسلموا % % 54(@)(@@) % نبي هو النور المضيء لناظر % % ولم أر نورا قبله يتجسم % 55(@)(@@) % نبي أبان الدين بعد خفائه % % وأوضح منه ما يحل ويحرم % % 56(@)(@@) % وجلى ظلام الشرك منه بغرة % هي الصبح لكن أفقها ليس بظلم % % 57(@)(@@) % هو البحر والبر الرؤوف وإنه % % أبر بنا من كل بر وأرحم % % 58(@)(@@) % يجود وقد لاحت تباشير بشره % % ويبذل وهو الضاحك المتبسم % 59(@)(@@) % مكارمه أربت على الحصر كثرة % وكل بليغ عن معاليه مفخم % 60(@)(@@) % وماذا يقول المادحون وقد أتى % % بمدحته نص من الذكر محكم % PageV01P345 61(@)(@@) % إذا ما بدا في آله الغز خلته % % هنالك بدر التم حفته أنجم % % 62(@)(@@) % علي أمير المؤمنين وصيه % % إليه انتهى كل النهى والتكرم % 63(@)(@@) % به ضاء نور الحق واتضحت لنا % % معالم دين الله والأمر مبهم % 64(@)(@@) % وما أنكرت أعداؤه عن جهالة % % مناقبه العظمى 
ms99	 ولكنهم عموا % % 65(@)(@@) % هو البطل الشهم الأغر السميدع % % الهمام السري الأكرم المتكرم % 66(@)(@@) % يفل شبا الأعداء وهو مذرب % ويثني عنان الجيش وهو عرمرم % % 67(@)(@@) % لئن جحدت قوم عظيم مقامه % % وقالوا بما قالوا ضلالا وأبهموا % % 68(@)(@@) % فقد شهد الذكر المبين بفضله % % وطيبة والبيت العتيق وزمزم % 69(@)(@@) % وأبناؤه من بعده أنجم الهدى % % هم العروة الوثقى التي ليس تفصم % 70(@)(@@) % مودتهم أجر النبوة في الورى % % وحبهم فرض علينا محتم % % PageV01P346 71(@)(@@) % هم القوم كل القوم في الفضل والندى % % وما منهم إلا منيل ومنعم % 72(@)(@@) % ولا عيب فيهم غير أن نزيلهم % % يخير فيما عندهم ويحكم % 73(@)(@@) % عليهم صلاة الله ما هبت الصبا % % ونشرهم من طيها يتنسم % % 74(@)(@@) % فيا خير خلق الله جئتك قاصدا % وقصدك في الدارين مغنى ومغنم % 75(@)(@@) % فكن لي شفيعا من ذنوبي في غد % إذا أحرزت أهل الذنوب جهنم % % 76(@)(@@) % وأنعم فدتك النفس لي بزيارة % فأنت الذي يولي الجزيل وينعم % % 77(@)(@@) % فقد طال بعدي عن جنابك سيدي % % وقلبي بالأشواق نحوك مفعم % % 78(@)(@@) % وفي النفس آمال أريد نجاحها % % وأنت بما في النفس أدرى وأعلم % % 79(@)(@@) % عليك صلاة الله ثم سلامه % % مدى الدهر لا يفنى ولا يتصرم % % 80(@)(@@) % وآلك والصحب الكرام أولي النهى % % بهم يبدأ الذكر الجميل ويختم % PageV01P347 البحر : بسيط تام 1(@)(@@) % مثال نعل رسول الله ذي الكرم % % شفاء كل عليل من ضنى السقم % % 2(@)(@@) % أكرم به من مثال زانه شرف % من أشرف الرسل خير الخلق كلهم % % 3(@)(@@) % محمد أحمد المحمود من شرفت % % بوطىء نعليه أرض القدس والحرم % 4(@)(@@) % فالثمه لثم محب لم يفز بلقا % % حبيبه فرأى الآثار للقدم % 5(@)(@@) % وعفر الخد فيه واكتحل نظرا % به فرؤيته تشفي من الألم % 6(@)(@@) % واحمله تظفر بما ترجوه من أمل % واحفظه تحفظ من الأسواء واللمم % % 7(@)(@@) % وكم نجا حاملوه الحافظون له % % من سوء خطب ملم فادح عمم % % 8(@)(@@) % وراجع النفحات العنبرية في % % وصف النعال التي فاقت على القمم % 9(@)(@@) % تظفر بما يبرىء الأبصار من رمد % والقلب من كمد والسمع من صمم % % 10(@)(@@) % لله در إمام حبرت يده % % تلك 
ms100	 الدراري التي صيغت من الكلم % % PageV01P348 11(@)(@@) % وكم فتى فاته لثم النعال غدا % % يرجو ويأمل أن يلقاه من أمم % 12(@)(@@) % وراح ينشد والأشواق تزعجه % % مثال نعليه هلا قبلة بفم % % PageV01P349 البحر : رمل تام 1(@)(@@) % أشذا نعمان أهدته النعامى % % أم سرت تحمل عن نعم سلاما % % 2(@)(@@) % كلما أهدت الينا نفحة % خلتها فضت عن المسك ختاما % % 3(@)(@@) % أرج الروض بريا طيبها % % وروى عن طيبها نشر الخزامى % % 4(@)(@@) % وسرت بالهند منها نسمة % فشممنا شيح نجد والبشاما % % 5(@)(@@) % يا رعى الله ربوعا بالحمى % % وسقاها صوب دمعي فالغماما % % 6(@)(@@) % وكسا أعطاف هاتيك الربى % % حللا طرزها الغيث انسجاما % % 7(@)(@@) % كم بها من غادة إن أسفرت % % في الدجى أوفت على البدر تماما % % 8(@)(@@) % وإذا ما أشرقت رأد الضحى % % سفرت عن طلعة الشمس لثاما % % 9(@)(@@) % هزت السمر عليها غيرة % غلمة الحي إذا هزت قواما % % 10(@)(@@) % وانتضت دون حماها قضبا % مرهفات ترشح الموت الزؤاما % % PageV01P350 11(@)(@@) % ما نبالي لو أمنا طرفها % % أسنانا أقبلونا أم حساما % % 12(@)(@@) % وعذول رام نصحي في الهوى % % كلما خاطبني قلت سلاما % % 13(@)(@@) % أتراه لا رأى ذاك البها % % كان أعمى أم تراه يتعامى % % 14(@)(@@) % يا نزول المنحنى من أضلعي % % وحلولا من غضا قلبي مقاما % % 15(@)(@@) % إن أكن شبت غراما بعد كم % % فالهوى العذري ما زال غلاما % % 16(@)(@@) % بنتم عن ظل بانات اللوى % % وشرعتم بربى نجد خياما % % 17(@)(@@) % كل يوم نية تنأى بكم % % وهواكم حيثما حل أقاما % % 18(@)(@@) % كم إلى كم أتقاضى وصلكم % % وإلام الهجر لا كان إلاما % % 19(@)(@@) % أفحقا لا تملون الجفا % % وعذولي فيكم مل الملاما % % 20(@)(@@) % وجميع الدهر صد وقلى % ينقضي الدهر ولم أقض مراما % % PageV01P351 21(@)(@@) % ما مرامي بغرامي بكم % % وعذابي في الهوى كان غراما % % 22(@)(@@) % يا نداماي وأسرار الهوى % % لم يطق كتمانها إلا الندامى % % 23(@)(@@) % أعلمتم أن جيران اللوى % % خفروا العهد ولم يرعوا ذماما % % 24(@)(@@) % سفكوا بالخيف عن عمد دمي % % واستحلوا بمنى مني حراما % % 25(@)(@@) % زعموا أيام جمع جمعت % % بهم شملي ولاء ولماما % % 26(@)(@@) % لا ومن سارت إليه ذللا % في براهن يبارين النعاما % % 27(@)(@@) % لم تكن إلا 