ms2341	 ، ولم يغتب الناس كان معي في الجنة كهاتين ) )(@)(@@) سمويه عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21836 ) قال النبي :(@)(@@) | 30 ( من حسن الله خلقه ، وحسن خلقه ، ورزقه الإسلام ، أدخله الجنة ) )(@)(@@) ابن النجار عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21837 ) قال النبي :(@)(@@) | 30 ( من حضر معصية فكرهها فكأنما غاب عنها ، ومن غاب عنها فأحبها فكأنه حاضرها ) )(@)(@@) ابن أبي الدنيا في كتاب الأمر بالمعروف والنهي عن المنكر ، ( هق ) وضعفه عن أبي هريرة رضي الله عنه .(@)(@@) PageV07P194(@)(@@)(@@)(@@) $ ( 21838 ) قال النبي :(@)(@@) | 30 ( من حضر منكم الجمعة فليغتسل كغسله من الجنابة ) )(@)(@@) الخطيب عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21839 ) قال النبي :(@)(@@) | 30 ( من حضر إماما فليقل خيرا أو ليسكت ) )(@)(@@) أبو بكر الشافعي في الغيلانيات ، والخرائطي في مكارم الأخلاق ، وابن عساكر عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21840 ) قال النبي :(@)(@@) | 30 ( من حضره الموت فوضع وصيته على كتاب الله كان ذالك كفارة لما ضيع من زكاة في حياته ) )(@)(@@) ( ه طب ) و الخطيب عن معاوية بن قرة عن أبيه .(@)(@@)(@@)(@@) $ ( 21841 ) قال النبي :(@)(@@) | 30 ( من حفر قبرا احتسابا كان له من الأجر كأنما أسكن مسكينا في بيت إلى يوم القيامة ) )(@)(@@) الديلمي عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 21842 ) قال النبي :(@)(@@) | 30 ( من حفر قبرا بنى الله له بيتا في الجنة ، ومن غسل ميتا خرج من ذنوبه كيوم ولدته أمه ، ومن كفن ميتا كساه الله من حلل الجنة ، ومن عزى حزينا ألبسه الله التقوى ، وصلى على روحه في الأرواح ، ومن عزى مصابا كساه الله حلتين من حلل الجنة لا تقوم لهما الدنيا ، ومن اتبع جنازة حتى يقضى دفنها ، كتب له ثلاثة قراريط : القيراط منها أعظم من جبل أحد ، ومن كفل يتيما أو أرملة أظله الله في ظله وأدخله جنته ) )(@)(@@) ( طس ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21843 ) قال النبي :(@)(@@) | 30 ( من حفر ماء ، لم يشرب منه كبد حرى من إنس وجن ولا من سبع وطائر إلا آجره الله يوم القيامة ، ومن بنى مسجدا كمفحص قطاة أو أصغر بنى الله له بيتا في الجنة ) )(@)(@@) و 
ms2342	 الشاشي وسمويه ( ض ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21844 ) قال النبي :(@)(@@) | 30 ( من حفظ على أمتي أربعين حديثا من أمر دينها بعثه PageV07P195 الله يوم القيامة فقيها عالما ) )(@)(@@) ( قط ) في العلل عن ابن عباس وعن معاذ ( حب ) في الضعفاء عن ابن عباس ، ( عد ) وابن عساكر من طريق عن أبي هريرة ، ابن الجوزي عند أنس رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 21845 ) قال النبي :(@)(@@) | 30 ( من حفظ على أمتي أربعين حديثا فيما ينفعهم من أمر دينهم بعث يوم القيامة من العلماء ، وفضل العالم على العابد سبعين درجة ، الله أعلم فيما بين كل درجتين ) )(@)(@@) ( ع عد هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21846 ) قال النبي :(@)(@@) | 30 ( من حفظ على أمتي أربعين حديثا من أمر دينها ، بعثه الله فقيها ، وكنت له يوم القيامة شافعا وشهيدا ) )(@)(@@) الشيرازي في الألقاب ، ( حب ) في الضعفاء وأبو بكر في الغيلانيات ( هب ) والسيفي ، وابن النجار عن أبي الدرداء ، ابن الجوزي في العلل عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21847 ) قال النبي :(@)(@@) | 30 ( من حفظ على أمتي أربعين حديثا ينتفعون بها بعثه الله تعالى يوم القيامة فقيها عالما ) )(@)(@@) ابن الجوزي عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21848 ) قال النبي :(@)(@@) | 30 ( من حفظ على أمتي أربعين حديثا ينفعهم الله تعالى بها ، قيل له : ادخل من أي أبواب الجنة شئت ) )(@)(@@) أبو نعيم في الحلية وابن الجوزي عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21849 ) قال النبي :(@)(@@) | 30 ( من حفظ على أمتي أربعين حديثا فيما يضرهم وينفعهم من أمر دينهم حشره الله تعالى يوم القيامة فقيها ) )(@)(@@) ابن الجوزي عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21850 ) قال النبي :(@)(@@) | 30 ( من حفظ على أمتي أربعين حديثا مما يحتاجون إليه من الحلال والحرام كتبه الله تعالى فقيها عالما ) )(@)(@@) ابن الجوزي عن أنس رضي الله عنه .(@)(@@) PageV07P196(@)(@@)(@@)(@@) $ ( 21851 ) قال النبي :(@)(@@) | 30 ( من حفظ على أمتي أربعين حديثا من أمر دينها فهو من العلماء ، وكنت له شفيعا يوم القيامة ) )(@)(@@) الديلمي عن ابن مسعود عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21852 ) قال النبي :(@)(@@) | 30 ( من 
ms2343	 حفظ ما بين لحييه وبين رجليه دخل الجنة ) )(@)(@@) ( ك هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21853 ) قال النبي :(@)(@@) | 30 ( من حفظ ما بين فقميه ورجليه دخل الجنة ) )(@)(@@) ( حم طب ك هب ) عن أبي رافع ، ( طب ) عن سهل بن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21854 ) قال النبي :(@)(@@) | 30 ( من حفظ لسانه ستر الله عورته ، ومن كف غضبه كف الله عنه عذابه ، ومن اعتذر إلى الله قبل الله معذرته ) )(@)(@@) الحكيم عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21855 ) قال النبي :(@)(@@) | 30 ( من حفظ عشر آيات من أول سورة الكهف كانت له نورا يوم القيامة ) )(@)(@@) أبو عبيد وابن مردويه عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21856 ) قال النبي :(@)(@@) | 30 ( من حفظ عني شيئا فليحدث به ، ومن كذب علي متعمدا فليتبوأ مقعده من النار ) )(@)(@@) ( طب ) عن أبي موسى الغافقي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21857 ) قال النبي :(@)(@@) | 30 ( من حفظني في أصحابي ورد على حوضي ، ومن لم يحفظني في أصحابي لم يرني يوم القيامة إلا من بعيد ) )(@)(@@) ( طب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21858 ) قال النبي :(@)(@@) | 30 ( من حلب شاته ورقع قميصه وخصف نعله ، وآكل خادمه ، وحمل من سوقه ، فقد برىء من الكبر ) )(@)(@@) ابن منده وأبو نعيم عن حكيم بن جحد عن أبيه وضعف .(@)(@@)(@@)(@@) $ ( 21859 ) قال النبي :(@)(@@) | 30 ( من حلى نفسه أو شيئا من سلاحه بمثل عين PageV07P197 الجرادة من ذهب كوي به يوم القيامة ) )(@)(@@) الديلمي عن قيس بن عباد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21860 ) قال النبي :(@)(@@) | 30 ( من حلف على يمين فرأى غيرها خيرا منها فأتى الذي هو خير فهو كفارته ) )(@)(@@) ( هق ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21861 ) قال النبي :(@)(@@) | 30 ( من حلف على منبري ولو على قضيب سواك أخضر كاذبا كان من أهل النار ) )(@)(@@) ( قط ) في الأفراد عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21862 ) قال النبي :(@)(@@) | 30 ( من حلف على يمين فرأى غيرها خيرا منها فليأتها ، فإن ذالك كفارتها إلا طلاق أو عتاق ) )(@)(@@) ( ط ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21863 ) قال النبي :(@)(@@) | 30 ( من حلف 
ms2344	 على يمين يقتطع بها مال امرىء مسلم وهو فاجر ، لقي الله تعالى وهوع أجذم ) )(@)(@@) ( ك ) عن الأشعث بن قيس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21864 ) قال النبي :(@)(@@) | 30 ( من حلف على يمين فهو كما حلف ، إن قال هو يهودي فهو يهودي ، وإن قال هو نصراني فهو نصراني ، وإن قال هو بريء من الإسلام فهو بريء من الإسلام ، ومن ادعى دعوى الجاهلية فإنه من حثاء جهنم وإن صام وصلى ) )(@)(@@) ( ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21865 ) قال النبي :(@)(@@) | 30 ( من حلف على يمين صبر ليقطع بها مال امرىء مسلم لقي الله وهو عليه غضبان ، عفا عنه أو عاقبه ) )(@)(@@) ( طب ك ) عن الأشعث بن قيس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21866 ) قال النبي :(@)(@@) | 30 ( من حلف على يمين ليقتطع بها مال امرىء مسلم ، لقي الله يوم القيامة وهو عليه غضبان ، قيل : يا رسول الله وإن كان شيئا يسيرا ؟ قال : وإن كان سواك من أراك ) )(@)(@@) الشافعي في سننه ، ( ك ) عن معبد بن كعب عن أبيه ، ( كر ) عن ابن مسعود رضي الله عنه .(@)(@@) PageV07P198(@)(@@)(@@)(@@) $ ( 21867 ) قال النبي :(@)(@@) | 30 ( من حلف على يمين يريد أن يقتطع بها حق أخيه ظالما ، لم ينظر الله إليه يوم القيامة ، ولم يزكه ، وله عذاب إليم ) )(@)(@@) ( طب ) عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21868 ) قال النبي :(@)(@@) | 30 ( من حلف على يمين كاذبة ليقتطع بها حق أخيه لقي الله وهو عليه غضبان ) )(@)(@@) ( حم ) و عبد بن حميد ، ( ن طب هق هب ) عن عدي بن عميرة الكندي ( طب ) عن العرس بن عميرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21869 ) قال النبي :(@)(@@) | 30 ( من حلف أنه بريء من الإسلام ، فإن كان كاذبا فهو كما قال ، وإن كان صادقا لم يرجع إلى الإسلام سالما ) )(@)(@@) ( حم ع ك هق ض ) عن عبد الله بن بريدة عن أبيه .(@)(@@)(@@)(@@) $ ( 21870 ) قال النبي :(@)(@@) | 30 ( من حلف على يمين فقال : إن شاء الله ، فقد استثنى ) )(@)(@@) ( د ن ك هق ) عن ابن عمر ، ( ن ) عن أبي هريرة ، الخطيب عن جابر ، ( طب ) عن ابن مسعود رضي الله 
ms2345	 عنهم موقوفا .(@)(@@)(@@)(@@) $ ( 21871 ) قال النبي :(@)(@@) | 30 ( من حلف بالله لأفعلن كذا ، وأضمر إن شاء الله ، ثم لم يفعل الذي حلف عليه لم يحنث ) )(@)(@@) ابن عساكر عن أبي حنيفة عن نافع عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21872 ) قال النبي :(@)(@@) | 30 ( من حلف على يمين فاستثنى ثم أتى ما حلف فلا كفارة عليه ) )(@)(@@) ( حل ) و الخطيب وابن عساكر عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21873 ) قال النبي :(@)(@@) | 30 ( من حلف فاستثنى ، فإن شاء مضى ، وإن شاء ترك غير حنث ) )(@)(@@) ( ن ه هق ) عن ابن عمر رضي الله عنهما .(@)(@@) PageV07P199(@)(@@)(@@)(@@) $ ( 21874 ) قال النبي :(@)(@@) | 30 ( من حلف بالأمانة فليس منا ، ومن حب زوج امرىء أو مملوكه فليس منا ) )(@)(@@) ( هق ) عن بريدة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21875 ) قال النبي :(@)(@@) | 30 ( من حلف على أحد بيمين وهو يرى أنه سيبره فلم يفعل فإنما إثمه على الذي لم يبره ) )(@)(@@) ( هق ) وضعفه عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21876 ) قال النبي :(@)(@@) | 30 ( من حلف بسورة من القرآن فعليه بكل آية كفارة ، إن شاء بر ، وإن شاء فجر ) )(@)(@@) ( هق ) عن الحسن مرسلا ، ( هق ) عن مجاهد مرسلا ، الديلمي عن الحسن عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21877 ) قال النبي :(@)(@@) | 30 ( من حلف على يمين فقال في إثر يمينه إن شاء الله ثم حنث فيما حلف فيه ، فإن كفارة يمينه : إن شاء الله ) )(@)(@@) ( هق ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21878 ) قال النبي :(@)(@@) | 30 ( من حلف بغير الله فليس من الله ) )(@)(@@) الديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21879 ) قال النبي :(@)(@@) | 30 ( من حلف بالشيء أو بالهدى أو جعل ماله في سبيل الله ، وفي المساكين ، أو في رتاج الكعبة فكفارته كفارة يمين ) )(@)(@@) الديلمي عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 21880 ) قال النبي :(@)(@@) | 30 ( من حلف بسورة من القرآن فعليه بكل آية منها يمين صبر ، فمن شاء بره ، ومن شاء فجره ) )(@)(@@) ( عب ) عن مجاهد مرسلا .(@)(@@)(@@)(@@) $ ( 21881 ) قال النبي :(@)(@@) | 30 ( من حلف فقال : إن شاء الله لم يحنث ) )(@)(@@) ( عب ) عن أبي هريرة رضي الله عنه 
ms2346	 .(@)(@@)(@@)(@@) $ ( 21882 ) قال النبي :(@)(@@) | 30 ( من حمد نفسه على عمل صالح فقد ضل شكره PageV07P200 وحبط عمله ) )(@)(@@) أبو نعيم عن عبد الغفور الأنصاري عن عبد العزيز عن أبيه وكانت له صحبة .(@)(@@)(@@)(@@) $ ( 21883 ) قال النبي :(@)(@@) | 30 ( من حمل جوانب السرير الأربع كفر الله عنه أربعين كبيرة ) )(@)(@@) ( طس ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21884 ) قال النبي :(@)(@@) | 30 ( من حمل قوائم السرير الأربع إيمانا واحتسابا حط الله عنه أربعين كبيرة ) )(@)(@@) ابن النجار عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21885 ) قال النبي :(@)(@@) | 30 ( من حمل من أمتي أربعين حديثا فهو من العلماء ) )(@)(@@) ابن النجار عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21886 ) قال النبي :(@)(@@) | 30 ( من حمل علينا السلاح فليس منا ، ولا راصد بطريق ) )(@)(@@) ابن النجار عن عمرو بن شعيب عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 21887 ) قال النبي :(@)(@@) | 30 ( من حمل من أمتي دينا وجهد في قضائه فمات قبل أن يقضيه فأنا وليه ) )(@)(@@) ( هق ) و ابن النجار عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 21888 ) قال النبي :(@)(@@) | 30 ( من حمل إلينا طعاما فهو في ضيافتنا حتى يخرج ، ومن ضاع له شيء فأنا ضامن له ، ولا ينبغي في سوقنا محتكر ) )(@)(@@) ( ك ) في تاريخه عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21889 ) قال النبي :(@)(@@) | 30 ( من حمل بضاعته فقد برىء من الكبر ) )(@)(@@) ابن لال عن أبي أمامة ، أبو نعيم عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21890 ) قال النبي :(@)(@@) | 30 ( من حمى عن عرض أخيه في الدنيا بعث الله تعالى له ملكا يوم القيامة يحميه عن النار ) )(@)(@@) ابن أبي الدنيا في ذم الغيبة ، والخرائطي في مكارم الأخلاق عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21891 ) قال النبي :(@)(@@) | 30 ( من خاف الله أخاف الله منه كل شيء ، ومن لم PageV07P201 يخف الله أخافه الله من كل شيء ) )(@)(@@) أبو الشيخ عن واثلة عبد الرحمان بن محمد بن عبد الكريم الكرجي في أماليه ، والرافعي عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21892 ) قال النبي :(@)(@@) | 30 ( من خالف دينه دين المسلمين فاضربوا عنقه ، وإذا شهد أن لا إلاه إلا الله وأن محمدا رسول الله 
ms2347	 فلا سبيل عليه إلا أن يأتي شيئا فيقام عليه حده ) )(@)(@@) ( طب ك ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21893 ) قال النبي :(@)(@@) | 30 ( من خالف جماعة المسلمين شبرا فقد خلع ربقة الإسلام من عنقه ) )(@)(@@) ( ك ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21894 ) قال النبي :(@)(@@) | 30 ( من خاف شيئا حذره ، ومن رجا شيئا عمل له ، ومن أيقن بالخلف جاد بالعطية ) ال| ديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21895 ) قال النبي :(@)(@@) | 30 ( من خبب زوجة خادم على أهلها فليس منا ، ومن أفسد امرأة على زوجها فليس منا ) )(@)(@@) ( حم هق ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21896 ) قال النبي :(@)(@@) | 30 ( من خبب عبدا على مولاه فليس منا ) )(@)(@@) الشيرازي في الألقاب عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21897 ) قال النبي :(@)(@@) | 30 ( من ختم القرآن عن ظهر قلب أو نظر ، أعطاه الله شجرة في الجنة ) )(@)(@@) ابن مردويه عن ابن الزبير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21898 ) قال النبي :(@)(@@) | 30 ( من ختم له عند موته بلا إلاه إلا الله دخل الجنة ) )(@)(@@) ابن عساكر عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21899 ) قال النبي :(@)(@@) | 30 ( من خرج مع أخ له في طريق موحشة فكأنما أعتق PageV07P202 رقبة ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21900 ) قال النبي :(@)(@@) | 30 ( من خرج يريد سفرا فرجع من طيرة فقد كفر بما أنزل على محمد ) )(@)(@@) الديلمي عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21901 ) قال النبي :(@)(@@) | 30 ( من خرج يدعو إلى نفسه أو إلى غيره وعلى الناس إمام فعليه لعنة الله والملائكة والناس أجمعين فاقتلوه ) )(@)(@@) الديلمي عن أبي بكر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21902 ) قال النبي :(@)(@@) | 30 ( من خرج يطلب بابا من العلم يريد به حقا من باطل ، أو هدى من ضلالة كان كعبادة متعبد أربعين عاما ) )(@)(@@) الديلمي عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21903 ) قال النبي :(@)(@@) | 30 ( من خرج من بيته يريد الصلاة فهو في الصلاة ، فاتته أو أدركها ) )(@)(@@) ( ك ) في تاريخه عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21904 ) قال النبي :(@)(@@) | 30 ( من خرج على أمتي وهم مجتمعون يريد 
ms2348	 أن يفرق بينم فاقتلوه كائنا من كان ) )(@)(@@) ( ع ) و أبو عوانة ، ( ض ) عن أسامة بن شريك ، ( طب ) عن عرفجة الأشجعي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21905 ) قال النبي :(@)(@@) | 30 ( من خرج من بيته يريد سفرا فقال حين يخرج : بسم الله ، آمنت بالله ، واعتصمت بالله ، وتوكلت على الله ، ولا حول ولا قوة إلا بالله ، رزق خير ذالك المخرج ، وصرف عنه شر ذالك المخرج ) )(@)(@@) ابن السني في عمل يوم وليلة ، والخطيب وابن عساكر عن عثمان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21906 ) قال النبي :(@)(@@) | 30 ( من خرج مخرجا فقال حين يخرج : بسم الله ، آمنت بالله ، وتوكلت على الله ، عصمه الله من شر مخرجه ) )(@)(@@) ابن جرير عن عثمان رضي الله عنه .(@)(@@) PageV07P203(@)(@@)(@@)(@@) $ ( 21907 ) قال النبي :(@)(@@) | 30 ( من خرج يريد علما يتعلمه فتح له باب الجنة ، وفرشت له الملائكة أكفافها ، وصلت عليه ملائكة السماوات ، وحيتان البحر ، وللعالم من الفضل على العابد كفضل القمر ليلة البدر على أصغر كوكب في السماء ، إن العلماء ورثة الأنبياء ، لم يورثوا دينارا ولا درهما ولاكنهم ورثوا العلم فمن أخذ بالعلم فقد أخذ بحظ وافر ، موت العالم مصيبة لا تجبر ، وثلمة لا تسد ، وهو نجم طمس ، موت قبيلة أيسر من موت عالم ) )(@)(@@) ( خ كر ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21908 ) قال النبي :(@)(@@) | 30 ( من خرج حاجا أو معتمرا ، فله بكل خطوة حتى يؤوب إلى رحله ألف ألف حسنة وتمحى عنه ألف ألف سيئة ، وترفع له ألف ألف درجة ) )(@)(@@) ابن عساكر عن أبي هريرة وابن عباس رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 21909 ) قال النبي :(@)(@@) | 30 ( من خرج من بيته مجاهدا في سبيل الله ، وأبن المجاهدين ، فخر عن دابته فمات ، فقد وقع أجره على الله ، أو لسعته دابة فمات فقد وقع أجره على الله ، أو مات حتف أنفه ، فقد وقع أجره على الله ، ومن قتل قصعا فقد استوجب المآب ) )(@)(@@) ( حم ) و ابن سعد ( طب ك هق ) وأبو نعيم عن محمد بن عبد الله بن عتيك عن أبيه .(@)(@@)(@@)(@@) $ ( 21910 ) قال النبي :(@)(@@) | 30 ( من خرج مجاهدا في سبيل الله فأصابته جائحة 
ms2349	 ، أو لسعته دابة فمات فهو شهيد ، ومن مات حتف أنفه فقد وقع أجره على الله ، ومن قتل قعصا فقد استوجب المآب ) )(@)(@@) العسكري في الأمثال عن محمد بن عبد الله بن عتيك عن أبيه .(@)(@@) PageV07P204(@)(@@)(@@)(@@) $ ( 21911 ) قال النبي :(@)(@@) | 30 ( من خرج حتى يأتي هاذا المسجد يعني مسجد قباء فيصلي فيه كانت كعدل عمرة ، ومن خرج على طهر لا يريد إلا مسجدي هاذا يريد مسجد المدينة ليصلي فيه كانت له بمنزلة حجة ) )(@)(@@) ( هب ) عن أبي أمامة بن سهل بن حنيف عن أبيه .(@)(@@)(@@)(@@) $ ( 21912 ) قال النبي :(@)(@@) | 30 ( من خرج من بيته إلى المسجد كتب له كاتبه بكل خطوة يخطوها إلى المسجد عشر حسنات ، والقاعد في المسجد ينتظر الصلاة كالقانت ويكتب من المصلين حتى يرجع إلى بيته ) )(@)(@@) ابن المبارك والخطيب عن عقبة بن عامر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21913 ) قال النبي :(@)(@@) | 30 ( من خرج من الجماعة قيد شبر فقد خلع ربقة الإسلام من عنقه حتى يراجعه ، ومن مات ليس عليه إمام جماعة فإن موتته موتة جاهلية ) )(@)(@@) ( ك ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21914 ) قال النبي :(@)(@@) | 30 ( من خرج حاجا أو معتمرا أو غازيا ثم مات في طريقه كتب الله له أجر الغازي والحاج والمعتمر إلى يوم القيامة ) )(@)(@@) ( هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21915 ) قال النبي :(@)(@@) | 30 ( من خرق خرقناه ، ومن عرض عرضنا له ، ومن نبش دفناه ) )(@)(@@) ابن لال والديلمي عن عمران بن يزيد بن البراء بن عازب عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 21916 ) قال النبي :(@)(@@) | 30 ( من خشي منكم أن لا يقوم من آخر الليل فليوتر من أول الليل ، ومن طمع منكم أن يقوم آخر الليل فليوتر آخر الليل فإن قراءة آخر الليل محضورة وذالك أفضل ) )(@)(@@) ( حب ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21917 ) قال النبي :(@)(@@) | 30 ( من خيل له في صلاته أنه قد أحدث فلا ينصرف PageV07P205 حتى يسمع صوتا أو يجد ريحا ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21918 ) قال النبي :(@)(@@) | 30 ( من دان بدين وفي نفسه وفاؤه فمات ، تجاوز الله عنه وأرضى 
ms2350	 غريمه بما شاء ، ومن دان بدين وليس في نفسه وفاؤه فمات اقتص الله لغريمه منه يوم القيامة ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21919 ) قال النبي :(@)(@@) | 30 ( من دخل مسجدي هاذا ليتعلم خيرا أو يعلمه كان بمنزلة المجاهد في سبيل الله ، ومن دخل لغير ذالك من أحاديث الناس كان بمنزلة من يرى ما يعجبه وهو شيء لغيره ) )(@)(@@) ( طب ض ) عن سهل بن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21920 ) قال النبي :(@)(@@) | 30 ( من دخل على قوم لطعام لم يدع إليه فأكل ، دخل فاسقا وأكل ما لا يحل له ) )(@)(@@) ( هق ) و ابن النجار عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 21921 ) قال النبي :(@)(@@) | 30 ( من دخل في شيء من أسعار المسلمين ليغليه عليهم ، كان حقا على الله أن يقذفه في معظم النار يوم القيامة ، رأسه أسفله ) )(@)(@@) ( ط حم طب ك هق ) عن معقل بن يسار رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21922 ) قال النبي :(@)(@@) | 30 ( من دخل مسجدنا هاذا ليتعلم خيرا أو يعلمه كان كالمجاهد في سبيل الله ، ومن دخله لغير ذالك كان كالناظر إلى ما ليس له ) )(@)(@@) ( حم حب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21923 ) قال النبي :(@)(@@) | 30 ( من دخل مكة فتواضع لله عز وجل ، وآثر رضاه على جميع أموره ، لم يخرج منها حتى يغفر له ) )(@)(@@) ( الديلمي ) عن ابن عمر رضي الله عنهما .(@)(@@) PageV07P206(@)(@@)(@@)(@@) $ ( 21924 ) قال النبي :(@)(@@) | 30 ( من دخل الحمام منكم فليستتر ) )(@)(@@) ( ش ) عن طاووس مرسلا .(@)(@@)(@@)(@@) $ ( 21925 ) قال النبي :(@)(@@) | 30 ( من دخل على مريض لم يحضر وفاته فقال : أسأل الله رب العرش العظيم أن يشفيك سبع مرات ، شفي ) )(@)(@@) ( ش ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21926 ) قال النبي :(@)(@@) | 30 ( من دعا بوضوء فساعة يفرغ من وضوئه يقول : أشهد أن لا إلاه إلا الله وأشهد أن محمدا رسول الله ، اللهم اجعلني من التوابين واجعلني من المتطهرين فتحت له ثمانية أبواب الجنة يدخل من أيها شاء ) )(@)(@@) ابن السني في عمل يوم وليلة ، ( طس ) عن ثوبان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21927 ) قال النبي :(@)(@@) | 30 ( من دعا بهاؤلاء الكلمات الخمس 
ms2351	 لم يسأل الله شيئا إلا أعطاه : لا إلاه إلا الله والله أكبر ، لا إلاه إلا الله وحده لا شريك له ، له الملك وله الحمد وهو على كل شيء قدير ، لا إلاه إلا الله ولا حول ولا قوة إلا بالله ) )(@)(@@) ( طب ) عن معاوية رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21928 ) قال النبي :(@)(@@) | 30 ( من دعا بهاذا الدعاء عشية عرفة ما لم يدع بإثم أو قطيعة رحم استجيب له : سبحان الذي في السماء عرشه ، سبحان الذي في الأرض موطئه ، سبحان الذي في البحر سبيله ، سبحان الذي في القبور قضاؤه ، سبحان الذي في الجنة رحمته ، سبحان الذي في النار سلطانه ، سبحان الذي في الجنة رحمته ، سبحان الذي في التار سلطانه ، سبحان الذي في الهواء روحه ، سبحان الذي رفع السماء ، سبحان الذي وضع الأرض ، سبحان الذي لا منجا منه إلا إليه ) )(@)(@@) ( طب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21929 ) قال النبي :(@)(@@) | 30 ( من دعا الناس إلى قول أو عمل ، ولم يعمل هو PageV07P207 به ، لم يزل في سخط الله حتى يكف أو يعمل بما قال أو دعا إليه ) )(@)(@@) ( طب حل ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21930 ) قال النبي :(@)(@@) | 30 ( من دعا لأخيه بظهر الغيب كتبت له عشر حسنات ، ومن بدأه بالسلام كتبت له عشر حسنات ) )(@)(@@) أبو الشيخ عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21931 ) قال النبي :(@)(@@) | 30 ( من دعاكم على كراع فأجيبوه ) )(@)(@@) ابن عساكر عن ابن عمر ( طب ) عن أبي أمامة رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 21932 ) قال النبي :(@)(@@) | 30 ( من دعي إلى سلطان فلم يجب فهو ظالم لا حق له ) )(@)(@@) ( طب ) عن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21933 ) قال النبي :(@)(@@) | 30 ( من دعي إلى حكم من الحكام فلم يجب فهو ظالم ) )(@)(@@) ( د ) في مراسيله ، ( هق ) عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 21934 ) قال النبي :(@)(@@) | 30 ( من دفن ثلاثة من الولد فصبر عليهم واحتسبهم وجبت له الجنة ، ومن دفن اثنان فصبر عليهما واحتسبهما وجبت له الجنة ) )(@)(@@) ( طب ) عن جابر بن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21935 ) قال النبي :(@)(@@) | 30 ( من دفن ثلاثة من الولد احتسبهم 
ms2352	 ، حرم الله عليه النار ) )(@)(@@) ( طب كر ) عن واثلة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21936 ) قال النبي :(@)(@@) | 30 ( من ذب عن لحم أخيه بالغيبة كان حقا على الله أن يعتقه من النار ) )(@)(@@) ابن المبارك ( حم ) والخرائطي في مكارم الأخلاق ( طب هب ن ) عن أسماء بنت يزيد رضي الله عنها .(@)(@@)(@@)(@@) $ ( 21937 ) قال النبي :(@)(@@) | 30 ( من ذبح قبل أن يصلي فإنما هو لحم قدمه لأهله ، PageV07P208 ومن ذبح بعد أن يصلي فقد أصاب السنة ) )(@)(@@) الشيرازى في الألقاب عن البراء عن أبي برزة بن نيار رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21938 ) قال النبي :(@)(@@) | 30 ( من ذرعه القيء في شهر رمضان فلا يفطر ، ومن تقيأ عامدا فقد أفطر ) )(@)(@@) ( كر ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21939 ) قال النبي :(@)(@@) | 30 ( من ذكر الله تعالى في نفسه ذكره الله في نفسه ، ومن ذكر الله في ملأ ذكره الله في ملأ أكثر وأطيب ، ومن تقرب إلى الله شبرا تقرب منه ذراعا ، ومن تقرب من الله ذراعا تقرب منه باعا ، ومن أتى الله مشيا أتاه هرولة ، ومن أتى الله هرولة أتاه الله سعيا ) )(@)(@@) ( ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21940 ) قال النبي :(@)(@@) | 30 ( من ذكر عنده أخوه المسلم وهو يستطيع نصره فلم ينصره ، أدركه الله بها في الدنيا والآخرة ) )(@)(@@) الخرائطي في مكارم الأخلاق عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21941 ) قال النبي :(@)(@@) | 30 ( من ذكر عنده أخوه المسلم بظهر الغيب وهو يقدر على أن ينصره فنصره ، نصره الله في الدنيا والآخرة ) )(@)(@@) الخرائطي عن عمران بن حصين رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21942 ) قال النبي :(@)(@@) | 30 ( من رأى حية فلم يقتلها خوفا منها فليس مني ) )(@)(@@) ( طب ) عن إبراهيم بن جزء عن أبيه .(@)(@@)(@@)(@@) $ ( 21943 ) قال النبي :(@)(@@) | 30 ( من رأى مبتلى فقال : الحمد لله الذي عافاني مما ابتلاك به وفضلني على كثير ممن خلق تفضيلا عافاه الله مما ابتلاه به كائنا ما كان ) )(@)(@@) ابن شاهين عن عبد الله بن أبان بن عثمان عن جده حذيفة بن أوس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21944 ) قال النبي :(@)(@@) | 30 ( من رأى مبتلى فقال : الحمد 
ms2353	 لله الذي عافاني مما ابتلاك به وفضلني على كثير من خلقه تفضيلا إلا كان ذالك شكر تلك النعمة ) )(@)(@@) PageV07P209 الشيرازي في الألقاب عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21945 ) قال النبي :(@)(@@) | 30 ( من رأى خيرا في منامه فليحمد الله وليشكره ، ومن رأى غير ذالك فليستعذ بالله ولا يذكرها فإنها لا تضره ) )(@)(@@) ( قط ) في الأفراد عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21946 ) قال النبي :(@)(@@) | 30 ( من رأى شيئا فأعجبه له أو لغيره فليقل : ما شاء الله ، لا قوة إلا بالله ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21947 ) قال النبي :(@)(@@) | 30 ( من رأى نعمة فليحمد الله ، ومن استبطأ الرزق فليستغفر الله ، ومن حزبه أمر فليقل : لا حول ولا قوة إلا بالله ) )(@)(@@) ( ك ) في تاريخه و الديلمي عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21948 ) قال النبي :(@)(@@) | 30 ( من رأى أنه يشرب لبنا فهو على الفطرة ، ومن رأى أن عليه درعا من حديد فهو في حصن من حديد ، ومن رأى أنه يبني بنيانا فهو شيء من عمل الخير يعمل ، ومن رأى أنه غرق فهو في النار ، ومن رآني فقد رآني ، فإن الشيطان لا يتشبه بي ) )(@)(@@) الحسن بن سفيان والروياني ( طب ) عن ثابت بن عبد الله بن أبي بكرة عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 21949 ) قال النبي :(@)(@@) | 30 ( من رأى صاحب بلاء فقال : الحمد لله الذي عافاني مما ابتلاك به ، وفضلني على كثير ممن خلق تفضيلا لم يصبه ذالك البلاء ) )(@)(@@) ( ت ) حسن غريب عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21950 ) قال النبي :(@)(@@) | 30 ( من رأى منكرا فغيره بيده فقد برىء ، ومن لم يستطع أن يغيره بيده فغيره بلسانه فقد برىء ، ومن لم يستطع أن يغيره بلسانه فغيره بقلبه فقد برىء وذالك أضعف الإيمان ) )(@)(@@) ( ن ) عن أبي سعيد رضي الله عنه .(@)(@@) PageV07P210(@)(@@)(@@)(@@) $ ( 21951 ) قال النبي :(@)(@@) | 30 ( من رآني في المنام فقد رآني ) )(@)(@@) ( حم ) و السراج والبغوي ( قط ) في الأفراد ( ش طب ض ) عن أبي مالك الأشجعي عن أبيه .(@)(@@)(@@)(@@) $ ( 21952 ) قال النبي :(@)(@@) | 30 ( من رآني في المنام فقد رآني ، إن الشيطان 
ms2354	 لا يتمثل في صورتي ) )(@)(@@) ( ش ) عن ابن مسعود وأبي هريرة وجابر رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 21953 ) قال النبي :(@)(@@) | 30 ( من رآني في المنام فقد رآني ، فإن الشيطان لا يتصور بصورتي ) )(@)(@@) ابن النجار عن البراء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21954 ) قال النبي :(@)(@@) | 30 ( من رآني في المنام فقد رآني ، فإن الشيطان لا يتمثل بي ) )(@)(@@) ( ت ) حسن صحيح ، ( ه حب طب ) عن ابن عباس ، الخطيب عن أبي مالك الاشجعي عن أبيه ، ( ش ه ) عن أبي سعيد ، ابن النجار عن عمران بن حصين رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 21955 ) قال النبي :(@)(@@) | 30 ( من رآني في المنام فقد رآني ، فإن الشيطان لا يتمثل بي ، ورؤيا المؤمن جزء من ستة وأربعين جزءا من النبوة ) )(@)(@@) ( حم ش خ ت ) في الشمائل ، و أبو عوانة عن أنس ، ( حم م ه ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21956 ) قال النبي :(@)(@@) | 30 ( من رآني في المنام فقد رآني ، فإن الشيطان لا يتصور بي ) )(@)(@@) الروياني ( ض ) عن البراء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21957 ) قال النبي :(@)(@@) | 30 ( من رآني في المنام فكأنما رآني في اليقظة ، فمن رآني فقد رآني حقا فإن الشيطان لا يستطيع أن يتمثل بي ) )(@)(@@) ( طب ) عن ابن عمر ، وابن عساكر عن ابن عمر ، ( ه ع طب ) عن أبي جحيفة رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 21958 ) قال النبي :(@)(@@) | 30 ( من رآني في المنام فقد رآني ، فإن الشيطان لا PageV07P211 يتشبه بي ) )(@)(@@) ابن عساكر عن أبي جحيفة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21959 ) قال النبي :(@)(@@) | 30 ( من رآني في المنام فقد رآني في اليقظة ) )(@)(@@) الدارمي عن أبي قتادة ( طب ) عن أبي بكرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21960 ) قال النبي :(@)(@@) | 30 ( من رآني فقد رأى الحق ، فإن الشيطان لا يتكونني ) )(@)(@@) ( حم خ ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21961 ) قال النبي :(@)(@@) | 30 ( من رآني في المنام فقد رآني ، فإن الشيطان لا يتمثل بي ، ومن رأى أبا بكر الصديق في المنام فقد رآه فإن الشيطان لا يتمثل به ) )(@)(@@) الخطيب والديلمي عن حذيفة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21962 ) قال النبي :(@)(@@) | 30 ( من رآني في المنام 
