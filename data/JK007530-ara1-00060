ms41	 ألجأها % % حامي الوديقة بين الساق والفنن % 20(@)(@@) % في نسوة شمس لامكره عنف % ولا فواحش في سر ولا علن % PageV01P151 21(@)(@@) % يرفلن في الريط لم ينقب دوابره % مشي النعاج بحقف الرملة الحرن % 22(@)(@@) % يثنين أعناق أدم يرتعين بها % % حب الأراك وحب الضال من دنن % 23(@)(@@) % يعلون بالمردقوش الورد ضاحية % على سعابيب ماء الضالة اللجن % 24(@)(@@) % زار الخيال لدهماء الركاب وقد % نام الخلي ببطن القاع من أسن % 25(@)(@@) % من طي أرضين أو من سلم نزل % من ظهر ريمان أو من عرض ذي جدن % 26(@)(@@) % مطوا طليحا تسجى غير مفترش % إلا جناجن ألقاها على شزن % 27(@)(@@) % ما أنست في فضاء الأرض أو طرقت % غيري وغير سواد الرحل من سكن % 28(@)(@@) % وعنفجيج يمد الحر جرتها % % حرف طليح كركن الرعن من حضن % 29(@)(@@) % في عازب رغد صدح الذباب به % رأد النهار كصدح الفحل في الحصن % 30(@)(@@) % لاقى خناذيذ أمثالا ، فجاوبها % % بصيت صاته من صائت أرن % PageV01P152 31(@)(@@) % تحمي ذمار جنين قل ما معه % طاو كضغث الخلى في البطن مكتمن % % 32(@)(@@) % تذب عنه بليف شوذب شمل % يحمي أسرة بين الزور والثفن % 33(@)(@@) % كان موضع وصليها إذا بركت % وقد تطابق منها الزور بالثفن % 34(@)(@@) % مبيت خمس من الكدري في جدد % يفحصن عنهن باللبات والجرن % 35(@)(@@) % إن تك دهماء قد رثت حبائلها % % فما تعللت من دهماء بالغبن % 36(@)(@@) % ولو تراني وإياها لقلت لنا : % كأن ما كان من دهماء لم يكن % 37(@)(@@) % إن تك لي حاجة قضيت أولها % % فهذه حاجة أجررتها رسني % PageV01P153 البحر : طويل 1(@)(@@) % كأني ورحلي روحتنا نعامة % تجرم عنها بالقفير رئالها % % 2(@)(@@) % وتهوي إذا العيس العتاق تفاضلت % هوي قدوم القين حال فعالها % % PageV01P154 البحر : وافر تام 1(@)(@@) % أأخطل لم ذكرت نساء قيس % فما روعن منك ولا سبينا % % 2(@)(@@) % ذوات البأو من ذبيان عنكم % قضى القاضي لها أن لا تهونا % % 3(@)(@@) % ونسوة عامر وبني سليم % وأعصر ما سلين ولا خزينا % % 4(@)(@@) % حمى أبضاعها الشم الغيارى % % ردوا من دونها بالدارعينا % % 5(@)(@@) % بكل أشق مقصوص الذنابى % % بشكيات فارس قد شجينا % % 6(@)(@@) % صبحنا تغلب 
ms42	 اللؤم السرايا % % تمطى بالكماة وتنطوينا % % 7(@)(@@) % صبحناهم مسومة رعالا % سقين بماء حرب وافتلينا % % 8(@)(@@) % نقدمها ، إذا نكصت ، عليهم % ونحذوها السريح إذا وجينا % % 9(@)(@@) % ونحن القائدون بواردات % ضباب الموت حتى ينجلينا % % 10(@)(@@) % كأن الخيل قد صبحن كلبا % يرين وراءهم ما يبتغينا % % PageV01P155 11(@)(@@) % سخطن ، فلا يرينهم بواء ، % ولا ينزعن حتى يغتدينا % % 12(@)(@@) % ولو كحلت حواجب خيل قيس % بكلب بعد تغلب ما قذينا % % 13(@)(@@) % فما تسلم لكم أفراس قيس % فلا ترجوا البنات ولا البنينا % % 14(@)(@@) % أثرن عجاجة في دير لبى % % وفي الحضرين شيبن القرونا % % 15(@)(@@) % إذا وطئت سنابكهن عبدا % زهيريا سمعت له أنينا % % 16(@)(@@) % لقد لاقت رحى كلب صباحا % رحى لقمان تلتهم الطحينا % % 17(@)(@@) % شربنا من دماء بني حبيب % ولولا البأو عنهم قد روينا % % 18(@)(@@) % بقرنا منهم ألفي بعير % فلم نترك لحاملة جنينا % % PageV01P156 البحر : وافر تام 1(@)(@@) % كأن سخالها بلوى سمار % إلى الخرماء أولاد السمال % PageV01P157 البحر : بسيط تام 1(@)(@@) % طاف الخيال بنا ركبا يمانينا % % ودون ليلى عواد لو تعدينا % % 2(@)(@@) % منهن معروف آيات الكتاب ، وقد % تعتاد تكذب ليلى ما تمنينا % % 3(@)(@@) % لم تسر ليلى ، ولم تطرق بحاجتها % % من أهل ريمان إلا حاجة فينا % % 4(@)(@@) % من سرو حمير أبوال البغال به % أنى تسديت وهنا ذلك البينا % % 5(@)(@@) % أمست بأذرع أكباد فحم لها % % ركب بلينة ، أو ركب بساوينا % % 6(@)(@@) % يا دار ليلى خلاء لا أكلفها % % إلا المرانة حتى تعرف الدينا % % 7(@)(@@) % تهدي زنانير أرواح المصيف لها % % ومن ثنايا فروج الكور تهدينا % % 8(@)(@@) % هيف هدوج الضحى سهو مناكبها % % يكسونها بالعشيات العثانينا % % 9(@)(@@) % يكسونها منزلا لاحت معارفه % سفعا ، أطال بهن الحي تدمينا % % 10(@)(@@) % عرجت فيها أحييها وأسألها % % فكدن يبكينني شوقا ويبكينا % % PageV01P158 11(@)(@@) % فقلت للقوم : سيروا لا أبا لكم % أرى منازل ليلى لا تحيينا % % 12(@)(@@) % وطاسم دعس آثار المطي به ، % نائي المخارم عرنينا فعرنينا % % 13(@)(@@) % قد غيرته رياح ، واخترقن به % من كل مأتى سبيل الريح يأتينا % % 14(@)(@@) % يصبحن دعس مراسيل المطي به % حتى يغيرن منه أو يسوينا % % 15(@)(@@) % في ظهر مرت عساقيل السراب به % كأن وغر قطاه وغر 
ms43	 حادينا % % 16(@)(@@) % كأن أصوات أبكار الحمام به % من كل محنية منه يغنينا % % 17(@)(@@) % أصوات نسوان أنباط بمصنعة % بجدن للنوح واجتبن التبانينا % % 18(@)(@@) % في مشرف ليط لياق البلاط به % كانت لساسته تهدى قرابينا % % 19(@)(@@) % صوت النواقيس فيه ، ما تفرطه % أيدي الجلاذي ، وجون ما يغفينا % % 20(@)(@@) % كأن أصواتها من حيث تسمعها % % صوت المحابض يخلجن المحارينا % % PageV01P159 21(@)(@@) % واطأته بالسرى حتى تركت به % ليل التمام ترى أسدافه جونا % % 22(@)(@@) % حتى استبنت الهدى ، والبيد هاجمة % يخشعن في الآل غلفا أو يصلينا % % 23(@)(@@) % واستحمل الشوق مني عرمس سرح % تخال باغزها بالليل مجنونا % % 24(@)(@@) % ترمي الفجاج بحيدار الحصى قمزا % في مشية سرح خلط أفانينا % % 25(@)(@@) % ترمي به ، وهي كالحرداء خائفة ، % قذف البنان الحصى بين المخاسينا % % 26(@)(@@) % كانت تدوم إرقالا فتجمعه % إلى مناكب يدفعن المذاعينا % % 27(@)(@@) % وعاتق شوحط صم مقاطعها % % مكسوة من خيار الوشي تلوينا % % 28(@)(@@) % عارضتها بعنود غير معتلث % ترن منه متون حين يجرينا % % 29(@)(@@) % حسرت عن كفي السربال آخذه % فردا يجر على أيدي المفدينا % % 30(@)(@@) % ثم انصرفت به جذلان مبتهجا % كأنه وقف عاج بات مكنونا % % PageV01P160 31(@)(@@) % ومأتم كالدمى حور مدامعها % % لم تبأس العيش أبكارا ولا عونا % % 32(@)(@@) % شم مخضرة ، صينت منعمة % من كل داء بإذن الله يشفينا % % 33(@)(@@) % كأن أعين غزلان ، إذا اكتحلت % بالإثمد الجون ، قد قرضنها حينا % % 34(@)(@@) % كأنهن الظباء الأدم أسكنها % % ضال بغرة ، أو ضال بدارينا % % 35(@)(@@) % يمشين هيل النقا مالت جوانبه % ينهال حينا ، وينهاه الثرى حينا % % 36(@)(@@) % من رمل عرنان أو من رمل أسنمة % جعد الثرى بات في الأمطار مدجونا % % 37(@)(@@) % يهززن للمشي أوصالا منعمة % هز الجنوب ضحى عيدان يبرينا % % 38(@)(@@) % أو كاهتزاز رديني تداوله % أيدي التجار فزادوا متنه لينا % % 39(@)(@@) % بيض يجردن من ألحاظهن لنا % % بيضا ، ويغمدن ما جردنه فينا % % 40(@)(@@) % إذا نطقن رأيت الدر منتثرا % وإن صمتن رأيت الدر مكنونا % % PageV01P161 41(@)(@@) % نازعت ألبابها لبي بمختزن % من الأحاديث حتى ازددن لي لينا % % 42(@)(@@) % في ليلة من ليالي الدهر صالحة % لو كان بعد انصراف الدهر مأمونا % % 43(@)(@@) % أبلغ خديجا ، فإني قد سمعت له 
ms44	 % بعض المقالة يهديها فتأتينا % % 44(@)(@@) % مالك تجري إلينا غير ذي رسن % وقد تكون إذا نجريك تعنينا % % 45(@)(@@) % وقد بريت قداحا أنت مرسلها ، % ونحن راموك ، فانظر كيف ترمينا % % 46(@)(@@) % فاقصد بذرعك ، واعلم لو تجامعنا % % أنا بنو الحرب نسقيها وتسقينا % % 47(@)(@@) % سم الصباح بخرصان مقومة % والمشرفية نهديها بأيدينا % % 48(@)(@@) % إن مشائيم إن أرشت جاهلنا % % يوم الطعان ، وتلقاها ميامينا % % 49(@)(@@) % وعاقد التاج ، أوسام له شرف % من سوقة الناس ، نالته عوالينا % % 50(@)(@@) % فاستبهل الحرب من حران مطرد % حتى يظل على الكفين مرهونا % % PageV01P162 51(@)(@@) % وإن فينا صبوحا إن أربت به % % جمعا بهيا ولآفا ثمانينا % % 52(@)(@@) % ومقربات عناجيجا مطهمة % من آل أعوج ملحوفا وملبونا % % 53(@)(@@) % إذا تجاوبن صعدن الصهيل إلى % % صلب الشؤون ، ولم تصهل براذينا % % 54(@)(@@) % ورجلة يضربون البيض عن عرض % ضربا تواصى به الأبطال سجينا % % 55(@)(@@) % فلا تكونن كالنازي ببطنته % بين القرينين حتى ظل مقرونا % % PageV01P163 البحر : وافر تام 1(@)(@@) % ذعرت بجوس نهبلة قذاف % من العيدي باقية القتال % PageV01P164 البحر : طويل 1(@)(@@) % ألا يا ديار الحي بالسبعان % أمل عليها بالبلى الملوان % 2(@)(@@) % نهار وليل دائم ملواهما % % على كل حال الدهر يختلفان % 3(@)(@@) % أبيني ديار الحي ، لا هجر بيننا ، % ولكن روعات من الحدثان % 4(@)(@@) % لدهماء إذ للناس والعيش غرة % وإذا خلقانا بالصبا يسران % 5(@)(@@) % تشكت ببعض الطرف حتى فهمته % حياء ، وما فاهت به الشفتان % 6(@)(@@) % كبيضة أدحي يوحوح فوقها % % هجفان مرتاعا الضحى وحدان % 7(@)(@@) % أحسا حسسا من سباع وطائف % فلا وخد إلا دون ما يخدان % 8(@)(@@) % يكادان بين الدونكين وألوة % وذات القتاد السمر ينسلخان % 9(@)(@@) % عشية قالت لي ، وقالت لصاحبي % % ببرقة ملحوب : ألا تلجان ؟ % 10(@)(@@) % فلما ولجنا أمكنت من عاننها % % وأمسكت عن بعض الخلاط عناني % % PageV01P165 11(@)(@@) % تأمل خليلي هل ترى من ظعائن % تحملن بالعلياء فوق إطان % 12(@)(@@) % فقال : أراها بين تبراك موهنا % وطلحام إذ علم البلاد هداني % % 13(@)(@@) % وقد أفضلت عيني على عينه % وقطع إلحاق الحداة قراني % % 14(@)(@@) % تحملن من جنان بعد إقامة % وبعد عناء من فؤادك عاني % % 15(@)(@@) % على كل وخاد اليدين مشمر % كأن ملاطيه ثقيف إران 
ms45	 % 16(@)(@@) % كسون السديل كل أدماء حرة % وحمراء لا يحذي بها جلمان % 17(@)(@@) % وكل رباع أو سديس مسدم % يمد بذفرى حرة وجران % 18(@)(@@) % سلكن لكيزا باليمين ، ولوزة % شمالا ، ومفضى السيل ذي الغذيان % 19(@)(@@) % وأوقدن نارا للرعاء بأذرع % سيالا وشيحا غير ذات دخان % 20(@)(@@) % فصبحن من ماء الوحيدين نقرة % بميزان رعم إذ بدا ضدوان % PageV01P166 21(@)(@@) % وأصبحن لم يتركن من ليلة السرى % % لذي الشوق إلا عقبة الدبران % 22(@)(@@) % وعرسن والشعرى تغور كأنها % % شهاب غضا يرمى به الرجوان % 23(@)(@@) % أتاهن لبان ببيض نعامة % حواها بذي اللصبين فوق جنان % 24(@)(@@) % فهل يبلغني أهل دهماء حرة % وأعيش نضاح القفا مرجان % 25(@)(@@) % شلقد طال عن دهماء لدي وعذرتي % % وكتمانها أكني بأم فلان % 26(@)(@@) % جعلت لجهال الرجال مخاضة % ولو شئت قد بينتها بلساني % 27(@)(@@) % فقل للحماس يترك الفخر إنما % % بنى اللؤم بيتا فوق كل يمان % 28(@)(@@) % أقرت به نجران ثم حبونن % فتثليث فالأرسان فالقرظان % 29(@)(@@) % تمنيت أن تلقى فوارس عامر % بصحراء بين السود والحدثان % 30(@)(@@) % أيا لهفتي ألا تكون شهدتهم % فتسقى بكأسي ذلة وهوان % PageV01P167 31(@)(@@) % ولو كنت جرم الخنفساء شهدتهم % جعلت قناة غير ذات سنان % 32(@)(@@) % ولو شهدت أم النجاشي ضربنا % % بصفين فدتنا بكل يماني % 33(@)(@@) % وجاءت به حياكة عركي % تنازعها في طهرها رجلان % 34(@)(@@) % ونحن منعنا البحر أن يشربوا به % وقد كان منكم ماؤه بمكان % PageV01P168 البحر : وافر تام 1(@)(@@) % رحلت إليك من جنفاء حتى % % أنخت فناء بيتك بالمطالي % % PageV01P169 البحر : رمل تام 1(@)(@@) % أصبح الدهر وقد ألوى بهم % غير تقوالك من قيل وقال % PageV01P170 البحر : طويل 1(@)(@@) % ولو تشترى منه لباع ثيابه % بنبحة كلب أو بنار يشيمها % % PageV01P171 البحر : - 1(@)(@@) % . . . . . . . . % . . . . . . . أو جبرن على عثم % PageV01P172 البحر : طويل 1(@)(@@) % أمن ظعن هبت بليل فأصبحت % بصوعة تحدى كالفسيل المكمم % 2(@)(@@) % تبادر عيناك الدموع كأنها % % تفيضان من واهي الكلى متخرم % PageV01P173 البحر : طويل 1(@)(@@) % فلو قبل مبكاها بكيت صبابة % بليلى شفيت النفس قبل التندم % 2(@)(@@) % ولكن بكت قبلي ، فهاج لي البكا % % بكاها ، فقلت : الفضل للمتقدم % PageV01P174 البحر : بسيط تام 1(@)(@@) % وافى الخيال ، وما وافاك من أمم 
ms46	 % من أهل قرن وأهل الضيق من حرم % 2(@)(@@) % أمسى بقرن ، فما ، اخضل العشاء له % حتى تنور بالزوراء من خيم % 3(@)(@@) % يسقي بأجداد عاد هملا رغدا % مثل الظباء التي في نالة الحرم % 4(@)(@@) % أما الرواء ففينا حد ترئية % مثل الجبال التي بالجزع من إضم % 5(@)(@@) % أما الإفادة فاستلوت ركائبنا % % عند الجبابير بالبأساء والنعم % 6(@)(@@) % أما الأداة ففينا ضمر صنع % جرد عواجر بالألباد واللجم % 7(@)(@@) % ونسج داود من بيض مضاعفة % من عهد عاد وبعد الحي من إرم % 8(@)(@@) % يصبحن بالخبت يجتبن النعاف على % % أصلاب هاد معيد لابس القتم % 9(@)(@@) % لا تحلب الحرب مني بعد عينتها % % إلا علالة سيد مارد سدم % 10(@)(@@) % لا حرب بالحرب يشفيها الإله ويش % فيها شفاعة بين الإل والرحم % PageV01P175 11(@)(@@) % حتى تشول لقاحا بعد قارحها % % تحربوها كحرب الذئب للغنم % 12(@)(@@) % لا ألفين وإياكم كعارمة % إلا تجد عارما في الناس تعترم % PageV01P176 البحر : رمل تام 1(@)(@@) % حي دار الحي لا دار بها % % بسخال فأثال فحرم % 2(@)(@@) % هزئت مية أن ضاحكتها % % فرأت عارض عود قد ثرم % 3(@)(@@) % وبياضا أحدثته لمتي % % مثل عيدان الحصاد المنحصم % 4(@)(@@) % يا ابنة الرحال لو جاريتني % % سالف الدهر لجاريت الرقم % 5(@)(@@) % وخصوم شمس أرمي بهم % شعب الجور إذا لم يستقم % 6(@)(@@) % وقعودي عند ذي غادية % تقذف الأعداء عني بالكلم % 7(@)(@@) % نتنادى ، ثم ينمي صوتنا % % صلق يهدم حافات الأطم % 8(@)(@@) % وحنين من عنود بدأة % أقرع النقبة حنان لحم % 9(@)(@@) % يزع الدارع منه مثل ما % % يزع الدالي من الدلو الودم % 10(@)(@@) % ثم نومن ، ونمنا ساعة ، % خشع الطرف سجودا في الخطم % PageV01P177 البحر : بسيط تام 1(@)(@@) % لقد تقوس لحييه ولمته % شيب ، وذلك مما يحدث الزمن % PageV01P178 البحر : بسيط تام 1(@)(@@) % تخوف السير منها تامكا قردا % كما تخوف عود النبعة السفن % PageV01P179 البحر : بسيط تام 1(@)(@@) % هتاك أخبية ، ولاج أبوبة % يخلط بالبر منه الجد واللينا % % PageV01P180 البحر : بسيط تام 1(@)(@@) % كأن نزو فراخ الهام بينهم % نزو القلات زهاها قال قالينا % % PageV01P181 البحر : بسيط تام 1(@)(@@) % زارتك من دونها شرج وحرته % وما تجشمت من دان ولا أون % PageV01P182 البحر 
ms47	 : طويل 1(@)(@@) % ألا ناديا ربعي كبيشة باللوى % % بحاجة محزون ، وإن لم يناديا % % 2(@)(@@) % توضحن في علياء قفر كأنها % % مهاريق فلوح يعرضن تاليا % % 3(@)(@@) % تمشى به الطلمان كالدهم قارفت % بزيت الرهاء الجون والدفل طاليا % % 4(@)(@@) % إذاغشيت جدا بليل تناولت % عشاش الغراب كالهضاب بوانيا % % 5(@)(@@) % نواهك بيوت الحياض إذا غدت % عليه ، وقد ضم الضريب الأفاعيا % % 6(@)(@@) % كأن ذراها من دجوج قعائد % نفى الشرق عنها المغضنات السواريا % % 7(@)(@@) % أأم تميم ، إن تريني عدوكم % وبيتي فقد أغنى الحبيب المصافيا % % 8(@)(@@) % بني عامر ، ما تأمرون بشاعر % تخير بابات الكتاب هجائيا % % 9(@)(@@) % أأعفوا كما يعفو الكريم ، فإنني % % أرى الشغب فيما بيننا متماديا % % 10(@)(@@) % أم اغمض بين الجلد واللحم غمضة % بمبرد رومي يقط النواصيا % % PageV01P183 11(@)(@@) % فأما سراقات الهجاء فإنها % % كلام تهاداه اللئام تهاديا % % 12(@)(@@) % أم اخبط خبط الفيل هامة رأسه % بحرد ، فلا يبقي من العظم باقيا % % 13(@)(@@) % وعندي الدهيم لو أحل عقالها % % فتصعد لم تعدم من الجن حاديا % % 14(@)(@@) % أحقا أتاني أن عوف بن مالك % ببطن رمى يهدي إلي القوافيا % % 15(@)(@@) % أبانوا أخاهم ، إذ أرادوا زياله ، % بأسواط قد عاقدين النواصيا % % 16(@)(@@) % فأجمع أجلاسا شدادا يسوقها % % إلي ، إذا راح الرعاء ، رعائيا % % PageV01P184 البحر : بسيط تام 1(@)(@@) % إن الحليفة ماء لست قاربه % مع الثناء الذي خبرت يأتيها % % 2(@)(@@) % لا لين الله للمعروف حاضرها % % ولا يزل مغلسا ما عاش باديها % % 3(@)(@@) % فكم وطئنا بها من شافه بطل % وكم أخذنا من انفال نفادها % % 4(@)(@@) % إذ ردها الخيل تعدو وهى خافصة % حد النبارس مطرودا نواحيها % % PageV01P185 
