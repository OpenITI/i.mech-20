ms571	 أبو عمر البصري صدوق من العاشرة ت عس(@)(@@)(@@)(@@) $ 7868 يوسف بن صهيب الكندي الكوفي ثقة من السادسة د ت س(@)(@@)(@@)(@@) $ 7869 يوسف بن عبد الله بن الحارث الأنصاري مولاهم أبو الوليد البصري ثقة من الخامسة م ت س ق(@)(@@)(@@)(@@) $ 7870 يوسف بن عبد الله بن سلام الإسرائيلي المدني أبو يعقوب صحابي صغير وقد ذكره العجلي في ثقات التابعين بخ 4(@)(@@)(@@)(@@) $$$ يوسف بن عبد الله بن نجيد في عبد الله بن نجيد(@)(@@)(@@)(@@) $ 7871 يوسف بن عبدة الأزدي مولاهم أبو عبدة البصري القصاب لين الحديث من السابعة بخ ت(@)(@@)(@@)(@@) $ 7872 يوسف بن عدي بن رزق التيمي مولاهم الكوفي نزيل مصر ثقة من العاشرة مات سنة اثنتين وثلاثين وقيل غير ذلك خ س(@)(@@)(@@)(@@) $ 7873 يوسف بن عطية بن ثابت الصفار البصري أبو سهل متروك من الثامنة فق(@)(@@)(@@)(@@) $ 7874 يوسف بن عطية الباهلي أبو المنذر الكوفي متروك أيضا من الثامنة وقال عمرو بن علي هو أكذب من الصفار تمييز(@)(@@)(@@)(@@) $ 7875 يوسف بن عمرو بن يزيد الفارسي أبو يزيد المصري صدوق صالح فقيه من التاسعة مات سنة خمس ومائتين د س(@)(@@)(@@)(@@) $ 7876 يوسف بن عيسى بن دينار الزهري أبو يعقوب المروزي ثقة فاضل من العاشرة مات سنة تسع وأربعين خ م ت س(@)(@@)(@@)(@@) $ 7877 يوسف بن أبي كثير مجهول من السابعة ق(@)(@@)(@@)(@@) $$$ يوسف بن مازن في يوسف بن سعد(@)(@@)(@@)(@@) $ 7878 يوسف بن ماهك بن بهزاد بضم الموحدة وسكون الهاء بعدها زاي الفارسي المكي ثقة من الثالثة مات سنة ست ومائة وقيل قبل ذلك ع(@)(@@)(@@)(@@) $ 7879 يوسف بن محمد بن ثابت بن قيس بن شماس بفتح المعجمة وتشديد الميم مقبول من السابعة وقد قيل فيه محمد بن يوسف د س(@)(@@)(@@)(@@) $ 7880 يوسف بن محمد بن صيفي ويقال بن يزيد بن صيفي بن صهيب بن سنان مقبول من الثامنة ق(@)(@@)(@@)(@@) $ 7881 يوسف بن محمد بن المنكدر التيمي ضعيف من السابعة ق PageV01P611(@)(@@)(@@)(@@) $ 7882 يوسف بن محمد العصفري أبو يعقوب الخراساني نزيل البصرة ثقة من العاشرة خ(@)(@@)(@@)(@@) $ 7883 يوسف 
ms572	 بن مروان النسائي أبو الحسن المؤدب نزيل بغداد ثقة من العاشرة مات سنة ثمان وعشرين س(@)(@@)(@@)(@@) $ 7884 يوسف بن مسعود بن الحكم الزرقي بضم الزاي الأنصاري المدني مقبول من الثالثة س(@)(@@)(@@)(@@) $ 7885 يوسف بن المنازل بلفظ جمع المنزل أبو يعقوب الكوفي ثقة من العاشرة مات سنة ثلاث عشرة س ق(@)(@@)(@@)(@@) $ 7886 يوسف بن مهران البصري وليس هو يوسف بن ماهك ذاك ثقة وهذا لم يرو عنه إلا بن جدعان وهو لين الحديث من الرابعة بخ ت(@)(@@)(@@)(@@) $ 7887 يوسف بن موسى بن راشد القطان أبو يعقوب الكوفي نزيل الري ثم بغداد صدوق من العاشرة مات سنة ثلاث وخمسين خ د ت عس ق(@)(@@)(@@)(@@) $ 7888 يوسف بن موسى التستري أبو غسان اليشكري نزيل الري صدوق من صغار العاشرة تمييز(@)(@@)(@@)(@@) $ 7889 يوسف بن ميمون المخزومي مولاهم الكوفي الصباغ ضعيف من الرابعة ق(@)(@@)(@@)(@@) $ 7890 يوسف بن ميمون الكوفي صدوق من السادسة فرق بينهما بن حبان والرازيان وغيرهم تمييز(@)(@@)(@@)(@@) $ 7891 يوسف بن واضح الهاشمي أبو يعقوب البصري المكتب ثقة من العاشرة مات سنة خمسين وقيل بعدها س(@)(@@)(@@)(@@) $ 7892 يوسف بن يحيى القرشي مولاهم أبو يعقوب البويطي صاحب الشافعي ثقة فقيه من أهل السنة مات في المحنة ببغداد سنة إحدى أو اثنتين وثلاثين ل ت(@)(@@)(@@)(@@) $ 7893 يوسف بن يزيد بن كامل القراطيسي أبو يزيد مولى بني أمية ثقة من الحادية عشرة مات سنة سبع وثمانين ويقال إنه عاش مائة سنة س(@)(@@)(@@)(@@) $ 7894 يوسف بن يزيد البصري أبو معشر البراء بالتشديد العطار صدوق ربما أخطأ من السادسة خ م(@)(@@)(@@)(@@) $ 7895 يوسف بن يعقوب بن أبي سلمة الماجشون أبو سلمة المدني ثقة من الثامنة مات سنة خمس وثمانين وقيل قبل ذلك خ م ت س ق(@)(@@)(@@)(@@) $ 7896 يوسف بن يعقوب بن أبي القاسم السدوسي مولاهم أبو يعقوب السلعي بكسر المهملة وفتح اللام بعدها مهملة وقيل بفتح أوله ثم سكون البصري الضبعي بضم المعجمة وفتح الموحدة صدوق من التاسعة مات سنة إحدى ومائتين خ ت س ق(@)(@@)(@@)(@@) $ 7897 يوسف 
ms573	 بن يعقوب الصفار أبو يعقوب الكوفي مولى قريش ثقة من العاشرة مات سنة إحدى وثلاثين خ م(@)(@@)(@@)(@@) $$$ يوسف أبو الحكم عن بن عمر صوابه عمران بن موسى أبو الحكم(@)(@@)(@@)(@@) $ 7898 يوسف القرشي الأموي المدني مقبول من الثالثة س ق PageV01P612(@)(@@)(@@)(@@) $ 7899 يونس بن أبي إسحاق السبيعي أبو إسرائيل الكوفي صدوق يهم قليلا من الخامسة مات سنة اثنتين وخمسين على الصحيح ر م 4(@)(@@)(@@)(@@) $ 7900 يونس بن بكير بن واصل الشيباني أبو بكر الجمال الكوفي صدوق يخطىء من التاسعة مات سنة تسع وتسعين خت م د ت ق(@)(@@)(@@)(@@) $ 7901 يونس بن جبير الباهلي أبو غلاب البصري ثقة من الثالثة مات بعد التسعين وأوصى أن يصلي عليه أنس بن مالك ع(@)(@@)(@@)(@@) $ 7902 يونس بن الحارث الثقفي الطائفي نزيل الكوفة ضعيف من السادسه د ت ق(@)(@@)(@@)(@@) $$$ يونس بن حلبس هو بن ميسرة يأتى(@)(@@)(@@)(@@) $ 7903 يونس بن خباب بمعجمة وموحدتين الأسيدي مولاهم الكوفي صدوق يخطىء ورمي بالرفض من السادسة بخ 4(@)(@@)(@@)(@@) $ 7904 يونس بن راشد الحراني أبو إسحاق القاضي صدوق رمي بالإرجاء من الثامنة د(@)(@@)(@@)(@@) $$$ يونس بن أبي سالم هو بن يوسف الليثي(@)(@@)(@@)(@@) $ 7905 يونس بن سليم الصنعاني مجهول من التاسعة ت س(@)(@@)(@@)(@@) $ 7906 يونس بن سيف الكلاعي الحمصي مقبول من الرابعة ووهم من سماه يوسف د س(@)(@@)(@@)(@@) $ 7907 يونس بن عبد الأعلى بن ميسرة الصدفي أبو موسى المصري ثقة من صغار العاشرة مات سنة أربع وستين وله ست وتسعون سنة م س ق(@)(@@)(@@)(@@) $ 7908 يونس بن عبيد الله العميري الليثي أبو عبد الرحمن البصري صدوق من كبار العاشرة كد(@)(@@)(@@)(@@) $ 7909 يونس بن عبيد بن دينار العبدي أبو عبيد البصري ثقة ثبت فاضل ورع من الخامسة مات سنة تسع وثلاثين ع(@)(@@)(@@)(@@) $ 7910 يونس بن عبيد مولى محمد بن القاسم الثقفي مقبول من الرابعة د ت س(@)(@@)(@@)(@@) $ 7911 يونس بن عبيد الثقفي مولاهم أخو زياد لأبيه قبل أن يستلحق معاوية زيادا له ذكر بلا رواية وهو من الثانية تمييز PageV01P613(@)(@@)(@@)(@@) $ 7912 يونس بن أبي الفرات القرشي مولاهم 
ms574	 أبو الفرات البصري الإسكاف ثقة من السادسة لم يصب بن حبان في تليينه خ ت س ق(@)(@@)(@@)(@@) $ 7913 يونس بن القاسم الحنفي أبو عمر اليمامي ثقة من الثامنة خ(@)(@@)(@@)(@@) $$$ يونس بن أبي كثير عن أبي بردة صوابه يونس بن أبي إسحاق وقد تقدم(@)(@@)(@@)(@@) $ 7914 يونس بن محمد بن مسلم البغدادي أبو محمد المؤدب ثقة ثبت من صغار التاسعة مات سنة سبع ومائتين ع(@)(@@)(@@)(@@) $ 7915 يونس بن محمد الصدوق كذاب من التاسعة أيضا تمييز(@)(@@)(@@)(@@) $$$ يونس بن مسلم صوابه أبو يونس حاتم بن مسلم(@)(@@)(@@)(@@) $ 7916 يونس بن ميسرة بن حلبس بمهملتين في طرفيه وموحدة وزن جعفر وقد ينسب لجده ثقة عابد معمر من الثالثة مات سنة اثنتين وثلاثين د ت ق(@)(@@)(@@)(@@) $ 7917 يونس بن نافع الخراساني أبو غانم القاضي صدوق يخطىء من الثامنة مات سنة تسع وخمسين د س(@)(@@)(@@)(@@) $ 7918 يونس بن يحيى بن نباتة الأموي أبو نباتة المدني صدوق من التاسعة مات سنة سبع ومائتين بخ ت س ق(@)(@@)(@@)(@@) $$$ يونس بن يزيد بن سنان صوابه نوح بن يزيد بن سيار(@)(@@)(@@)(@@) $ 7919 يونس بن يزيد بن أبي النجاد الأيلي بفتح الهمزة وسكون التحتانية بعدها لام أبو يزيد مولى آل أبي سفيان ثقة إلا أن في روايته عن الزهري وهما قليلا وفي غير الزهري خطأ من كبار السابعة مات سنة تسع وخمسين على الصحيح وقيل سنة ستين ع(@)(@@)(@@)(@@) $ 7920 يونس بن أبي يعفور بفتح التحتانية وسكون المهملة وضم الفاء واسمه وقدان بالقاف العبدي الكوفي صدوق يخطىء كثيرا من الثامنة م ق(@)(@@)(@@)(@@) $ 7921 يونس بن يوسف بن حماس بكسر المهملة وتخفيف الميم وآخره مهملة ثقة عابد من السادسة وقال بن حبان هو يوسف بن يونس وهم من قلبه والله أعلم م س ق آخر الأسماء فرغت منه في ثامن شهر ربيع الأول سنة ست وعشرين وثماني مائة PageV01P614(@)(@@)(@@)(@@) | 1 ( باب الكنى على الترتيب الماضي في الأسماء والاعتبار بما بعد أداة الكنية )(@)(@@)(@@)(@@) $$$ PageV01P615(@)(@@)(@@)(@@) || ( حرف الألف )(@)(@@)(@@)(@@) $ 7922 أبو إبراهيم الأشهلي المدني مقبول من الثالثة قيل إنه عبد الله 
ms575	 بن أبي قتادة ولا يصح ت س(@)(@@)(@@)(@@) $$$ أبو إبراهيم الأسدي هو محمد بن القاسم تقدم(@)(@@)(@@)(@@) $$$ أبو إبراهيم الترجماني هو إسماعيل بن إبراهيم بن بسام تقدم(@)(@@)(@@)(@@) $$$ أبو الأبرد مولى بني خطمة هو زياد تقدم وقيل موسى بن سليم ت ق(@)(@@)(@@)(@@) $ 7923 أبو الأبيض العنسي بالنون الشامي ثقة من الثانية قتل سنة ثمان وثمانين ووهم من سماه عيسى س(@)(@@)(@@)(@@) $ 7924 أبو أبي بن أم حرام اسمه عبد الله بن عمرو وقيل بن كعب الأنصاري صحابي نزل بيت المقدس وهو آخر من مات من الصحابة بها وزعم بن حبان أن اسمه شمعون د ق(@)(@@)(@@)(@@) $ 7925 أبو أحمد بن علي الكلاعي الدمشقي قيل هو عمر بن أبي عمر مجهول من مشايخ بقية من السابعة ق(@)(@@)(@@)(@@) $$$ أبو أحمد الزبيري محمد بن عبد الله بن الزبير(@)(@@)(@@)(@@) $$$ أبو أحمد في البخاري عن محمد بن يحيى هو المرار بن حمويه ويقال محمد بن عبد الوهاب الفراء(@)(@@)(@@)(@@) $$$ أبو الأحوص البغوي محمد بن حيان(@)(@@)(@@)(@@) $$$ أبو الأحوص الجشمي عوف بن مالك(@)(@@)(@@)(@@) $$$ أبو الأحوص الحنفي سلام بن سليم(@)(@@)(@@)(@@) $$$ أبو الأحوص الشامي حكيم بن عمير(@)(@@)(@@)(@@) $ 7926 أبو الأحوص مولى بني ليث أو غفار مقبول من الثالثة لم يرو عنه غير الزهري 4(@)(@@)(@@)(@@) $$$ أبو الأحوص قاضي عكبرا محمد بن الهيثم(@)(@@)(@@)(@@) $$$ أبو إدام بكسر أوله المحاربي الكوفي سليمان بن زيد(@)(@@)(@@)(@@) $$$ أبو إدريس الخولاني عائذ الله بن عبد الله(@)(@@)(@@)(@@) $ 7927 أبو إدريس السكوني الحمصي مقبول من السادسة د(@)(@@)(@@)(@@) $ 7928 أبو إدريس المرهبي بضم أوله وكسر الهاء بعدها موحدة الكوفي اسمه سوار أو مساور صدوق يتشيع من الرابعة ت ق PageV01P617(@)(@@)(@@)(@@) $ 7929 أبو إدريس بصري مقبول من الخامسة س(@)(@@)(@@)(@@) $ 7930 أبو أرطاة كوفي مقبول من الرابعة س(@)(@@)(@@)(@@) $ 7931 أبو الأزهر ويقال أبو زهير الأنماري صحابي سكن الشام لا يعرف اسمه وقيل يحيى بن نفير د(@)(@@)(@@)(@@) $$$ أبو الأزهر الباهلي البصري صالح بن درهم د(@)(@@)(@@)(@@) $$$ أبو الأزهر النيسابوري أحمد بن الأزهر س ق(@)(@@)(@@)(@@) $$$ أبو الأزهر الدمشقي المغيرة بن فروة د(@)(@@)(@@)(@@) $ 7932 أبو الأزهر البصري مقبول من الثانية ق(@)(@@)(@@)(@@) $$$ أبو أسامة 
ms576	 الحجام هو زيد(@)(@@)(@@)(@@) $$$ أبو أسامة الرقي زيد بن علي(@)(@@)(@@)(@@) $$$ أبو أسامة الكوفي حماد بن أسامة(@)(@@)(@@)(@@) $$$ أبو الأسباط الحارثي بشر بن رافع(@)(@@)(@@)(@@) $ 7933 أبو إسحاق الأشجعي الكوفي شيخ لأبي النضر مقبول وقال ليس هو عبيد الله هو آخر من الثامنه س(@)(@@)(@@)(@@) $$$ أبو إسحاق الكوفي عبد الله بن ميسرة(@)(@@)(@@)(@@) $ 7934 أبو إسحاق الكوفي آخر اسمه هارون روى عنه حماد بن زيد(@)(@@)(@@)(@@) $$$ أبو إسحاق الحميسي خازم بن الحسين(@)(@@)(@@)(@@) $$$ أبو إسحاق السبيعي عمرو بن عبد الله(@)(@@)(@@)(@@) $$$ أبو إسحاق الشيباني سليمان بن أبي سليمان(@)(@@)(@@)(@@) $$$ أبو إسحاق الطالقاني إبراهيم بن إسحاق بن عيسى(@)(@@)(@@)(@@) $$$ أبو إسحاق الفزاري إبراهيم بن محمد بن الحارث(@)(@@)(@@)(@@) $ 7935 أبو إسحاق مولى عبد الله بن الحارث مدني مقبول من الثالثة س(@)(@@)(@@)(@@) $ 7936 أبو إسحاق الدوسي مولى بني هاشم مقبول من الثالثة ويحتمل أن يكون الذي قبله تمييز(@)(@@)(@@)(@@) $$$ أبو إسحاق الهروي إبراهيم بن عبد الله بن حاتم(@)(@@)(@@)(@@) $ 7937 أبو إسحاق عن أبي الحويرث مجهول من السابعة فق(@)(@@)(@@)(@@) $ 7938 أبو إسرائيل الجشمي بضم الجيم وفتح المعجمة اسمه شعيب مقبول من الثالثة س(@)(@@)(@@)(@@) $$$ أبو إسرائيل الملائي بضم الميم والمد اسمه إسماعيل بن خليفة(@)(@@)(@@)(@@) $$$ أبو أسماء الرحبي عمرو بن مرثد PageV01P618(@)(@@)(@@)(@@) $ 7939 أبو أسماء الصيقل مجهول من الخامسة س(@)(@@)(@@)(@@) $$$ أبو أسماء عن أم سلمة صوابه عبد الله مولى أسماء(@)(@@)(@@)(@@) $$$ أبو إسماعيل الأسلمي عن أبي حازم هو بشير بن سلمان(@)(@@)(@@)(@@) $$$ أبو إسماعيل الترمذي هو محمد بن إسماعيل(@)(@@)(@@)(@@) $$$ أبو إسماعيل القناد إبراهيم بن عبد الملك(@)(@@)(@@)(@@) $$$ أبو إسماعيل المؤدب إبراهيم بن سليمان(@)(@@)(@@)(@@) $ 7940 أبو الأسود الديلي بكسر المهملة وسكون التحتانية ويقال الدؤلي بالضم بعدها همزة مفتوحة البصري اسمه ظالم بن عمرو بن سفيان ويقال عمرو بن ظالم ويقال بالتصغير فيهما ويقال عمرو بن عثمان أو عثمان بن عمرو ثقة فاضل مخضرم مات سنة تسع وستين ع(@)(@@)(@@)(@@) $ 7941 أبو الأسود السلمي صحابي له حديث وقيل الصواب أبو اليسر السلمي س(@)(@@)(@@)(@@) $ 7942 أبو الأسود المحاربي مولى بني عمرو بن حريث قاضي الكوفة اسمه سويد مقبول من الخامسة س(@)(@@)(@@)(@@) $$$ أبو الأسود المرادي النضر بن 
ms577	 عبد الجبار(@)(@@)(@@)(@@) $$$ أبو الأسود والد سوادة مسلم بن مخراق(@)(@@)(@@)(@@) $$$ أبو الأسود يتيم عروة هو محمد بن عبد الرحمن النوفلي(@)(@@)(@@)(@@) $ 7943 أبو أسيد بن ثابت الأنصاري المدني صحابي قيل اسمه عبد الله له حديث والصحيح فيه فتح الهمزة قاله الدارقطني ت س(@)(@@)(@@)(@@) $$$ أبو أسيد البراد صوابه أبو سعيد بن أبي أسيد(@)(@@)(@@)(@@) $$$ أبو أسيد الساعدي بضم أوله مالك بن ربيعة(@)(@@)(@@)(@@) $$$ أبو الأشعث الجرمي هو الصنعاني ت(@)(@@)(@@)(@@) $$$ أبو الأشعث الصنعاني هو شراحيل بن آده بالمد والتخفيف(@)(@@)(@@)(@@) $$$ أبو الأشعث العجلي أحمد بن المقدام(@)(@@)(@@)(@@) $$$ أبو الأشهب العطاردي جعفر بن حيان(@)(@@)(@@)(@@) $$$ أبو الأعيس الخولاني عبد الرحمن بن سلمان(@)(@@)(@@)(@@) $ 7944 أبو أفلح الهمداني المصري مقبول من الخامسة د س ق(@)(@@)(@@)(@@) $$$ أبو أمامة بن سهل بن حنيف اسمه أسعد وقيل سعد(@)(@@)(@@)(@@) $$$ أبو أمامة الباهلي صدي بن عجلان(@)(@@)(@@)(@@) $ 7945 أبو أمامة البلوي حليف بني حارثة اسمه إياس وقيل عبد الله بن ثعلبة وقيل ثعلبة بن عبد الله أو بن سهيل صحابي له أحاديث م 4(@)(@@)(@@)(@@) $ 7946 أبو أمامة ويقال أبو أميمة التميمي الكوفي مقبول من الرابعة د PageV01P619(@)(@@)(@@)(@@) $ 7947 أبو أمية الشعباني الدمشقي اسمه يحمد بضم التحتانية وسكون المهملة وكسر الميم وقيل بفتح أوله والميم وقيل اسمه عبد الله مقبول من الثانية عخ د ت ق(@)(@@)(@@)(@@) $$$ أبو أمية الضمري عمرو بن أمية(@)(@@)(@@)(@@) $$$ أبو أمية الطرسوسي محمد بن إبراهيم(@)(@@)(@@)(@@) $$$ أبو أمية القشيري أنس بن مالك(@)(@@)(@@)(@@) $ 7948 أبو أمية المخزومي أو الأنصاري صحابي له حديث د س ق(@)(@@)(@@)(@@) $$$ أبو أنس الأصبحي مالك بن أبي عامر(@)(@@)(@@)(@@) $$$ أبو أويس الأصبحي عبد الله بن عبد الله بن أويس(@)(@@)(@@)(@@) $$$ أبو إياس البجلي عامر بن عبدة(@)(@@)(@@)(@@) $$$ أبو إياس المزني معاوية بن قرة(@)(@@)(@@)(@@) $$$ أبو أيوب الإفريقي عبد الله بن علي(@)(@@)(@@)(@@) $$$ أبو أيوب الأنصاري خالد بن زيد(@)(@@)(@@)(@@) $$$ أبو أيوب الرقي الحطاب سليمان بن عبيد الله(@)(@@)(@@)(@@) $$$ أبو أيوب الغيلاني سليمان بن عبيد الله(@)(@@)(@@)(@@) $ 7949 أبو أيوب المراغي الأزدي اسمه يحيى ويقال حبيب بن مالك ثقة من الثالثة مات بعد الثمانين خ م د س ق(@)(@@)(@@)(@@) $$$ أبو أيوب الهاشمي سليمان بن 
ms578	 داود بن داود بن علي(@)(@@)(@@)(@@) $$$ أبو أيوب مولى عثمان اسمه سليمان وقيل عبد الله بن أبي سليمان(@)(@@)(@@)(@@) $ 7950 أبو أيوب الشامي عن الزهري مجهول من السابعة س PageV01P620(@)(@@)(@@)(@@) || ( حرف الباء الموحدة )(@)(@@)(@@)(@@) $$$ أبو بحر البكراوي عبد الرحمن بن عثمان(@)(@@)(@@)(@@) $$$ أبو بحرية بتشديد التحتانية عبد الله بن قيس(@)(@@)(@@)(@@) $$$ أبو البختري بفتح الموحدة والمثناة بينهما معجمة ساكنة سعيد بن فيروز(@)(@@)(@@)(@@) $ 7951 أبو البداح بفتح الموحدة وتشديد المهملة وآخره مهملة بن عاصم بن عدي بن الجد بفتح الجيم البلوي حليف الأنصار يقال اسمه عدي ويقال كنيته أبو عمرو وأبو البداح لقب ثقة من الثالثة مات سنة عشر ومائة وقيل بعد ذلك ووهم من قال له صحبة 4(@)(@@)(@@)(@@) $$$ أبو بدر السكوني شجاع بن الوليد(@)(@@)(@@)(@@) $$$ أبو بدر الغبري عباد بن الوليد(@)(@@)(@@)(@@) $ 7952 أبو بردة بن أبي موسى الأشعري قيل اسمه عامر وقيل الحارث ثقة من الثالثة مات سنة أربع ومائة وقيل غير ذلك جاز الثمانين ع(@)(@@)(@@)(@@) $ 7953 أبو بردة بن نيار بكسر النون بعدها تحتانية خفيفة البلوي حليف الأنصار صحابي اسمه هانئ وقيل الحارث بن عمرو وقيل مالك بن هبيرة مات سنة إحدى وأربعين وقيل بعدها ع(@)(@@)(@@)(@@) $$$ أبو بردة بن عبد الله بن أبي بردة اسمه بريد بموحدة وراء مصغر(@)(@@)(@@)(@@) $$$ أبو بردة التميمي عمرو بن يزيد الكوفي(@)(@@)(@@)(@@) $$$ أبو برزة بفتح أوله وبالزاي الأسلمي اسمه نضلة بن عبيد(@)(@@)(@@)(@@) $ 7954 أبو البزري بفتح الموحدة والزاي بعدها راء مقبول من الرابعة مات سنة بضع وعشرين ت(@)(@@)(@@)(@@) $ 7955 أبو بسرة بضم أوله وسكون المهملة الغفاري مقبول من الرابعة د ت(@)(@@)(@@)(@@) $$$ أبو بشر البصري هو بكر بن الحكم أو المفضل بن لاحق بخ(@)(@@)(@@)(@@) $$$ أبو بشر العنبري الوليد بن مسلم(@)(@@)(@@)(@@) $$$ أبو بشر الكوفي بيان بن بشر(@)(@@)(@@)(@@) $$$ أبو بشر اليشكري جعفر بن إياس(@)(@@)(@@)(@@) $ 7956 أبو بشر مؤذن مسجد دمشق مقبول من السادسة مد(@)(@@)(@@)(@@) $ 7957 فأما أبو بشر صاحب أبي الزاهرية فضعيف من طبقته(@)(@@)(@@)(@@) $ 7958 أبو بشر صاحب أبي وائل مجهول من السادسة ت PageV01P621(@)(@@)(@@)(@@) $ 7959 أبو بشر شيخ للحسن بن صالح مجهول وقيل فيه الحلبي 
ms579	 وقيل اسمه عبد الله بن بشر وقيل هو الوليد بن محمد البلقاوي والله أعلم من السابعة ت(@)(@@)(@@)(@@) $ 7960 أبو بشير بفتح أوله وكسر المعجمة الأنصاري المدني قيل اسمه قيس بن عبيد صحابي ممن شهد الخندق ومات بعد الستين يقال جاز المائة خ م د س(@)(@@)(@@)(@@) $$$ أبو بصرة الغفاري حميل بن بصرة(@)(@@)(@@)(@@) $ 7961 أبو بصير العبدي الكوفي الأعمى يقال اسمه حفص مقبول من الثالثة قد س ق(@)(@@)(@@)(@@) $$$ أبو بكار الغزال الحكم بن فروخ(@)(@@)(@@)(@@) $$$ أبو بكر بن أحمر اسمه جبريل(@)(@@)(@@)(@@) $ 7962 أبو بكر بن إسحاق بن يسار المطلبي مولاهم أخو محمد صاحب المغازي مقبول من السادسة س(@)(@@)(@@)(@@) $$$ أبو بكر بن إسحاق الصغاني اسمه محمد(@)(@@)(@@)(@@) $$$ أبو بكر بن أبي الأسود اسمه عبد الله بن محمد بن حميد(@)(@@)(@@)(@@) $$$ أبو بكر بن أصرم اسمه بور بالموحدة تقدموا(@)(@@)(@@)(@@) $ 7963 أبو بكر بن أنس بن مالك الأنصاري ثقة من الرابعة م صد س(@)(@@)(@@)(@@) $$$ أبو بكر بن أبي أويس هو عبد الحميد بن عبد الله(@)(@@)(@@)(@@) $$$ أبو بكر بن أبي الجهم هو بن عبد الله يأتي(@)(@@)(@@)(@@) $$$ أبو بكر بن حزم هو بن عمرو يأتي(@)(@@)(@@)(@@) $$$ أبو بكر بن أبي حثمة هو بن سليمان يأتي(@)(@@)(@@)(@@) $$$ أبو بكر بن حفص بن عمر بن سعد اسمه عبد الله(@)(@@)(@@)(@@) $$$ أبو بكر بن حفص الأبلي اسمه إسماعيل(@)(@@)(@@)(@@) $$$ أبو بكر بن حويطب اسمه رباح تقدموا(@)(@@)(@@)(@@) $ 7964 أبو بكر بن خالد بن عرفطة العذري حليف بني زهرة مقبول من الثالثة س(@)(@@)(@@)(@@) $$$ أبو بكر بن خلاد الباهلي اسمه محمد تقدم(@)(@@)(@@)(@@) $ 7965 أبو بكر بن أبي زهير الثقفي اسم أبيه معاذ مقبول من الثالثة ق(@)(@@)(@@)(@@) $ 7966 أبو بكر بن سالم بن عبد الله بن عمر ثقة من الخامسة خ م(@)(@@)(@@)(@@) $$$ أبو بكر بن أبي سبرة هو بن عبد الله يأتي PageV01P622(@)(@@)(@@)(@@) $ 7967 أبو بكر بن سليمان بن أبي حثمة عبد الله بن حذيفة العدوي المدني ثقة عارف بالنسب من الثالثة خ م د ت س(@)(@@)(@@)(@@) $ 7968 أبو بكر بن شعيب بن الحبحاب بمهملتين مفتوحتين بينهما موحدة ساكنة وفى آخره موحدة 
ms580	 الأزدي البصري قيل اسمه عبد الله ثقة من السابعة م ت(@)(@@)(@@)(@@) $$$ أبو بكر بن شيبة اسمه عبد الرحمن بن عبد الملك(@)(@@)(@@)(@@) $$$ أبو بكر بن أبي شيبة اسمه عبد الله بن محمد بن إبراهيم تقدما(@)(@@)(@@)(@@) $ 7969 أبو بكر بن أبي شيخ السهمي ويقال له بكير بن موسى مقبول من السابعة س(@)(@@)(@@)(@@) $ 7970 أبو بكر بن عبد الله بن أبي الجهم العدوي وقد ينسب إلى جده ثقة فقيه من الرابعة ر م ت س ق(@)(@@)(@@)(@@) $ 7971 أبو بكر بن عبد الله بن الزبير بن العوام مستور من الثالثة مات شابا ق(@)(@@)(@@)(@@) $ 7972 أبو بكر بن عبد الله بن قيس البكري بصري مجهول من الثامنة قد(@)(@@)(@@)(@@) $ 7973 أبو بكر بن عبد الله بن محمد بن أبي سبرة بفتح المهملة وسكون الموحدة بن أبي رهم بن عبد العزى القرشي العامري المدني قيل اسمه عبد الله وقيل محمد وقد ينسب إلى جده رموه بالوضع وقال مصعب الزبيري كان عالما من السابعة مات سنة اثنتين وستين ق(@)(@@)(@@)(@@) $ 7974 أبو بكر بن عبد الله بن أبي مريم الغساني الشامي وقد ينسب إلى جده قيل اسمه بكير وقيل عبد السلام ضعيف وكان قد سرق بيته فاختلط من السابعة مات سنة ست وخمسين د ت ق(@)(@@)(@@)(@@) $ 7975 أبو بكر بن عبد الله الثقفي الأصبهاني مجهول من السابعة ووهم من زعم أنه يعقوب القمي بخ(@)(@@)(@@)(@@) $ 7976 أبو بكر بن عبد الرحمن بن الحارث بن هشام بن المغيرة المخزومي المدني قيل اسمه محمد وقيل المغيرة وقيل أبو بكر اسمه وكنيته أبو عبد الرحمن وقيل اسمه كنيته ثقة فقيه عابد من الثالثة مات سنة أربع وتسعين وقيل غير ذلك ع(@)(@@)(@@)(@@) $$$ أبو بكر بن عبد الرحمن بن أبي سفيان بن حويطب اسمه رباح(@)(@@)(@@)(@@) $ 7977 أبو بكر بن عبد الرحمن بن المسور بن مخرمة مقبول من السابعة س(@)(@@)(@@)(@@) $ 7978 أبو بكر بن عبيد الله بن أنس بن مالك مجهول الحال من الخامسة بخ ت(@)(@@)(@@)(@@) $ 7979 أبو بكر بن عبيد الله بن عبد الله بن 