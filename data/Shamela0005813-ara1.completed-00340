ms321	 عن: (ق 151 / ب) عن: عبد الله بن عون(@)(@@) روى عنه: عبد الله بن المبارك، والحسين بن(@)(@@) الوليد النيسابوري.(@)(@@)(@@)(@@) $ 3584 - (@)(@@) أبو سفيان: حرب المنقري.(@)(@@) حدث عن: الحسن، وقتادة.(@)(@@) كناه البخاري.(@)(@@)(@@)(@@) $ 3585 - (@)(@@) أبو سفيان: نصر بن موسى(@)(@@) الحرشي المروزي.(@)(@@) رأى إبراهيم بن ميمون الصائغ.(@)(@@) أخبرنا محمد بن يونس المقريء، ثنا الحسين(@)(@@) ابن محمد، ثنا محمود بن غيلان، ثنا(@)(@@) أبو سفيان نصر بن موسى، قال: رأيت إبراهيم(@)(@@) ابن ميمون الصائغ.(@)(@@)(@@)(@@) $ 3586 - (@)(@@) أبو سفيان: وكيع بن الجراح بن(@)(@@) مليح بن عدي بن فرس الرؤاسي الكوفي.(@)(@@) حدث عن: سليمان الأعمش، وهشام بن(@)(@@) عروة.(@)(@@) روى عنه: يحيى بن آدم، وعبد الرزاق،(@)(@@) وأحمد بن حنبل.(@)(@@)(@@)(@@) $ 3587 - (@)(@@) أبو سفيان: صالح بن مهران(@)(@@) الإصبهاني.(@)(@@) حدث عن: النعمان بن عبد السلام، وعصام(@)(@@) ابن يزيد.(@)(@@) روى عنه: عمرو بن علي، قال: وكان من(@)(@@) الثقات.(@)(@@) أخبرنا محمد بن محمد بن يونس، ثنا أسيد(@)(@@) ابن عاصم، ثنا أبو سفيان صالح بن مهران.(@)(@@)(@@)(@@) $ 3588 - (@)(@@) أبو سفيان: محمد بن حميد(@)(@@) المعمري.(@)(@@) حدث عن: معمر، وسفيان الثوري.(@)(@@) روى عنه: أبو معمر، وسريج بن يونس.(@)(@@) أخبرنا أبو إسحاق إسماعيل بن عمرو(@)(@@) السمرقندي، ثنا محمد بن حامد بن حميد(@)(@@) السمرقندي، ثنا علي بن إسحاق السمرقندي(@)(@@) ثنا أبو سفيان المعمري محمد بن حميد، عن(@)(@@) معمر.(@)(@@)(@@)(@@) $ 3589 - (@)(@@) أبو سفيان: سعيد بن يحيى بن(@)(@@) مهدي الحميري الواسطي.(@)(@@) حدث عن: حصين بن عبد الرحمن، وسفيان(@)(@@) ابن حسين.(@)(@@) روى عنه: إسحاق بن راهويه، أخبرنا عبد الله(@)(@@) ابن إبراهيم بن الصباح المقريء، ثنا أبو مسعود(@)(@@) أنا سعيد بن يحيى أبو سفيان الحميري، عن(@)(@@) سفيان بن حسين.(@)(@@)(@@)(@@) $ 3590 - (@)(@@) أبو سفيان: قطبة بن العلاء بن(@)(@@) المنهال الغنوي.(@)(@@) حدث عن: أبيه، وسفيان الثوري.(@)(@@) كناه يعقوب بن سفيان الفارسي.(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 3591 - (@)(@@) أبو سفيان: عبد الرحيم بن مطرف(@)(@@) البروجي.(@)(@@) عن: عيسى بن يونس.(@)(@@) روى عنه: محمد بن عوف، وعثمان بن(@)(@@) خرزاد وكناه.(@)(@@)(@@)(@@) $ 3592 - (@)(@@) أبو سفيان: وقيل: أبو منصور:(@)(@@) الحارث بن منصور.(@)(@@) حدث عن: سفيان، كناه مسلم هكذا.(@)(@@)(@@)(@@) $ 3593 - (@)(@@) أبو سفيان: أحمد بن سفيان(@)(@@) النسائي.(@)(@@) حدث عن: عبد الرزاق.(@)(@@) كناه 
ms322	 محمد بن المسيب الأرغياني.(@)(@@)(@@)(@@) $ 3594 - (@)(@@) أبو سفيان: الأنماري.(@)(@@) حدث عن: حبيب (ق 152 / أ) ابن عبد الله(@)(@@) ابن أبي كبشة.(@)(@@) روى عنه: بقية بن الوليد.(@)(@@) أخبرنا خيثمة، ثنا أبو عتبة، ثنا بقية عنه.(@)(@@)(@@)(@@) || (ومن كنيته أبو سنان)(@)(@@)(@@)(@@) $ 3595 - (@)(@@) أبو سنان: عبد الله بن وهب بن(@)(@@) عبد الله بن محصن.(@)(@@) توفي والنبي صلى الله عليه وسلم محاصر(@)(@@) قريظة، قاله الشعبي.(@)(@@)(@@)(@@) $ 3596 - (@)(@@) أبو سنان: وقيل: أبو عبد الرحمن،(@)(@@) وأبو محمد، وأبو زيد: معقل بن سنان(@)(@@) الأشجعي، وله صحبة.(@)(@@) أخبرنا أحمد بن مهران، وأحمد بن عثمان،(@)(@@) قالا: ثنا موسى، ثنا شباب، قال: ومعقل(@)(@@) ابن سنان، أبو سنان.(@)(@@)(@@)(@@) ||| (ومن التابعين)(@)(@@)(@@)(@@) $ 3597 - (@)(@@) أبو سنان: يزيد بن أمية الدؤلي.(@)(@@) حدث عن: علي، وابن عباس(@)(@@) رضي الله عنهما.(@)(@@) روى عنه: محمد بن مسلم بن شهاب(@)(@@) الزهري، وزيد بن أسلم ولد زمن وقعة أحد.(@)(@@) رواه وهب بن جرير، عن أبيه، عن معلى بن(@)(@@) حكيم، عن نافع، قال: أراد هشام بن(@)(@@) إسماعيل بن يزيد بن أمية أبا سنان الدؤلي،(@)(@@) وكان ولد زمن وقعة أحد.(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 3598 - (@)(@@) أبو سنان: الأسلمي.(@)(@@) حدث عن: علي بن أبي طالب.(@)(@@) روى عنه: محمود بن لبيد.(@)(@@) قاله البخاري.(@)(@@)(@@)(@@) $ 3599 - (@)(@@) أبو سنان: البكري.(@)(@@) حدث عن: عمر بن الخطاب.(@)(@@) روى عنه: الحجاج بن أرطأة.(@)(@@) وروى محمد بن عبد الرحمن بن لبينة، عن(@)(@@) أبي سنان، عن عمر بن الخطاب رضي الله عنه(@)(@@) أراه هذا، أو الدؤلي، قاله ابن منده.(@)(@@)(@@)(@@) $ 3600 - (@)(@@) أبو سنان: عيسى بن سنان الحنفي.(@)(@@) حدث عن: يعلى بن شداد، والضحاك بن(@)(@@) عبد الرحمن، وابي طلحة الخولاني.(@)(@@) روى عنه: حماد بن سلمة، وعيسى بن يونس(@)(@@) وأبو أسامة.(@)(@@) سمعت محمد بن يعقوب، قال: سمعت(@)(@@) عباسا، قال: سمعت يحيى بن معين،(@)(@@) يقول: أبو سنان القسملي، اسمه: عيسى(@)(@@) ابن سنان.(@)(@@)(@@)(@@) $ 3601 - (@)(@@) أبو سنان: العجلي.(@)(@@) حدث عن: أنس بن مالك.(@)(@@) روى عنه: ربيعة بن كلثوم.(@)(@@)(@@)(@@) $ 3602 - (@)(@@) أبو سنان: مسلم.(@)(@@) روى حديثه: يعقوب القمي، عن أبي مالك(@)(@@) عنه.(@)(@@)(@@)(@@) $ 3603 - (@)(@@) أبو سنان: عامل عمر بن(@)(@@) عبد العزيز.(@)(@@) روى عنه: محمد بن حمران البصري.(@)(@@)(@@)(@@) $ 3604 
ms323	 - (@)(@@) أبو سنان: الغنوي.(@)(@@) عن: أبيه، عن عمر بن عبد العزيز.(@)(@@) روى عنه: أبو سلمة (ق 152 / ب) موسى(@)(@@) ابن إسماعيل.(@)(@@) قاله البخاري.(@)(@@)(@@)(@@) $ 3605 - (@)(@@) أبو سنان: ضرار بن مرة الكوفي(@)(@@) الشيباني.(@)(@@) حدث عن: سعيد بن جبير، وعبد الله بن أبي(@)(@@) الهذيل.(@)(@@) روى عنه: سفيان الثوري، وشعبة بن الحجاج(@)(@@) وابن عيينة، أخبرنا عبد الرحمن بن يحيى بن(@)(@@) منده، ثنا أبو مسعود أحمد بن الفرات، أنا(@)(@@) يحيى بن آدم، ثنا سفيان الثوري، عن أبي(@)(@@) سنان ضرار بن مرة.(@)(@@)(@@)(@@) $ 3606 - (@)(@@) أبو سنان: سعيد بن سنان الشيباني(@)(@@) القزويني.(@)(@@) حدث عن: عمرو بن مرة، وحبيب بن أبي،(@)(@@) والضحاك بن مزاحم.(@)(@@) روى عنه: الثوري، وأبو معاوية، وزيد بن(@)(@@) الحباب، وأبو داود، كوفي نزل قزوين.(@)(@@) أخبرنا محمد بن الحسين بن علي المديني(@)(@@) PageV00P000(@)(@@) المستملي، ثنا إسحاق بن إسماعيل الفلفلاني،(@)(@@) ثنا إسحاق بن سليمان الرازي، ثنا أبو سنان(@)(@@) سعيد بن سنان الشيباني.(@)(@@)(@@)(@@) $ 3607 - (@)(@@) أبو سنان: روى عنه: كهمس بن(@)(@@) الحسن، اسمه: حجاج بن يسار.(@)(@@)(@@)(@@) || (ومن كنيته أبو سالم)(@)(@@)(@@)(@@) $ 3608 - (@)(@@) أبو سالم: الجيشاني.(@)(@@) حدث عن: علي بن أبي طالب رضي الله عنه(@)(@@) وأبي ذر.(@)(@@) روى عنه: ابنه سالم.(@)(@@) عداده في أهل مصر.(@)(@@) سمعت محمد بن يعقوب، قال: سمعت(@)(@@) عباسا، قال: سمعت يحيى بن معين،(@)(@@) يقول: أبو سالم الجيشاني، اسمه: سفيان(@)(@@) ابن هانيء.(@)(@@)(@@)(@@) $ 3609 - (@)(@@) أبو سالم: سبيع السلوكي،(@)(@@) كوفي.(@)(@@) حدث عن: الحسن بن علي بن أبي طالب،(@)(@@) وعبد الله بن الزبير.(@)(@@) روى محمد بن يوسف الفريابي، عن إسرائيل(@)(@@) ثنا غالب أبو الهذيل، قال: سمعت أبا سالم(@)(@@) السلولي سبيعا.(@)(@@)(@@)(@@) $ 3610 - (@)(@@) أبو سالم: الحنفي، جد عبد الله بن(@)(@@) بدر.(@)(@@) عن أم سالم، عن أبي سالم.(@)(@@)(@@)(@@) $ 3611 - (@)(@@) أبو سالم: ماهان الحنفي، وقيل:(@)(@@) أبو صالح.(@)(@@) روى عنه: المنهال بن عمرو بن الشيباني.(@)(@@) قال محمد بن إسماعيل البخاري، قال علي(@)(@@) ابن المديني: ماهان أبو سالم، قلت: إن أحمد(@)(@@) ابن حنبل، يقول: ماهان أبو صالح، قال: أنا(@)(@@) أخبرت أحمد، وكان عندنا كذاك، حتى(@)(@@) وجدنا (ق 153 / أ) ماهان أبو سالم.(@)(@@)(@@)(@@) $ 3612 - (@)(@@) أبو سالم: الحراني.(@)(@@) من أهل مديبر.(@)(@@) حدث 
ms324	 عن: زهير، وموسى بن أعين.(@)(@@) روى عنه: أبو شعيب السوسي.(@)(@@) قاله علي بن أحمد الحراني.(@)(@@)(@@)(@@) $ 3613 - (@)(@@) أبو سالم: محمد بن عبد الله بن(@)(@@) جعشم الصنعاني.(@)(@@) حدث عن: ابن عيينة، وعبد المجيد.(@)(@@) أخبرنا محمد بن محمد بن عبد الله بن حمزة،(@)(@@) ثنا عبيد بن محمد الكشوري، ثنا أبو سالم بن(@)(@@) جعشم.(@)(@@) PageV00P000(@)(@@)(@@)(@@) || (من كنيته أبو سوار)(@)(@@)(@@)(@@) $ 3614 - (@)(@@) أبو سوار: حسان بن حريث(@)(@@) العدوي البصري.(@)(@@) أدرك عمر، وحدث عن: عمران بن حصين.(@)(@@) روى عنه: محمد بن سيرين، وقتادة، وابن(@)(@@) عون.(@)(@@) وسماه أحمد بن حنبل، وأبو بكر بن أبي(@)(@@) الأسود، وابن نمير، وعمرو بن علي،(@)(@@) والبخاري.(@)(@@)(@@)(@@) $ 3615 - (@)(@@) أبو السوار: عبد الله بن قدامة(@)(@@) العنبري القاضي، بصري.(@)(@@) سمع: أبا برزة الأسلمي.(@)(@@) روى عنه: توبة العنبري.(@)(@@) سماه شعبة بن الحجاج، عن توبة، قال:(@)(@@) سمعت أبا السوار القاضي عبد الله بن قدامة من(@)(@@) عنزة.(@)(@@)(@@)(@@) $ 3616 - (@)(@@) أبو السوار، وأبو الثورين: محمد(@)(@@) ابن عبد الرحمن.(@)(@@) تقدم ذكره.(@)(@@)(@@)(@@) || (من كنيته أبو سليم)(@)(@@)(@@)(@@) $ 3617 - أبو سليم: الحراني.(@)(@@) عن: عكرمة.(@)(@@) أخبرنا علي بن أحمد، ثنا أبو بدر بن مسرج،(@)(@@) ثنا عمي، ثنا محمد بن مسلمة، عن أبي سليم(@)(@@) رجل من أهل حران، عن عكرمة.(@)(@@)(@@)(@@) $ 3618 - (@)(@@) أبو سليم: مولى أم سلمة.(@)(@@) روى عنه: عبد الله بن هبيرة.(@)(@@) عداده في أهل مصر، قاله أبو سعيد بن يونس.(@)(@@)(@@)(@@) $ 3619 - (@)(@@) أبو سليم: كوفي.(@)(@@) حدث عن: أنس بن مالك.(@)(@@) روى عنه: إسرائيل.(@)(@@)(@@)(@@) $ 3620 - (@)(@@) أبو سليم: العنزي.(@)(@@) حدث عن: رجل من عنزة، صحب النبي(@)(@@) صلى الله عليه وسلم.(@)(@@) رواه أبو اليد الطيالسي، عن السري بن يحيى(@)(@@) عنه.(@)(@@)(@@)(@@) $ 3621 - (@)(@@) أبو سليم: زياد، مولى أبي سفيان(@)(@@) ابن الحارث.(@)(@@) تابعي، عن: أبي سفيان.(@)(@@)(@@)(@@) $ 3622 - (@)(@@) أبو سليم: عبيد بن يحيى الكوفي.(@)(@@) حدث عن: قيس، وأبي مريم عبد الغفار بن(@)(@@) القاسم، نزل رقة.(@)(@@) أخبرنا خيثمة، وعبد الرحمن بن(@)(@@) أحمد الجلاب، قالا: ثنا(@)(@@) PageV00P000(@)(@@) (ق 153 / ب) هلال بن العلاء، ثنا أبو سليم(@)(@@) عبيد بن يحيى.(@)(@@)(@@)(@@) $ 3623 - (@)(@@) أبو سليم: إسماعيل بن حصن بن(@)(@@) حسان الجبيلي.(@)(@@) حدث عن: محمد بن شعيب.(@)(@@) أخبرنا خيثمة، ثنا أبو سليم 
ms325	 إسماعيل بن حصن(@)(@@) ابن حسان.(@)(@@)(@@)(@@) || (من كنيته أبو السكن)(@)(@@)(@@)(@@) $ 3624 - (@)(@@) أبو السكن: عميرة بن سعد اليامي(@)(@@) كوفي.(@)(@@) حدث عن: علي بن أبي طالب رضي الله عنه.(@)(@@) روى عنه: طلحة بن مصرف.(@)(@@) كناه البخاري.(@)(@@)(@@)(@@) $ 3625 - (@)(@@) أبو السكن: زياد السعدي الباهلي.(@)(@@) عن: طلحة بن مصرف، وزبيد، وعلقمة بن(@)(@@) مرثد.(@)(@@) أخبرنا محمد بن يونس، وعلي بن محمد بن(@)(@@) نصر، قالا: ثنا الحسين بن محمد، ثنا بشر بن(@)(@@) الحكم العبدي، عن زياد أبي السكن.(@)(@@)(@@)(@@) $ 3626 - (@)(@@) أبو السكن: عاصم الخلوصي.(@)(@@) أخبرنا علي بن نصر، ثنا الحسين بن محمد،(@)(@@) ثنا عمرو بن علي، ثنا أبو قتيبة، ثنا عاصم(@)(@@) أبو السكن الخلوصي، عن عكرمة.(@)(@@)(@@)(@@) $ 3627 - (@)(@@) أبو السكن: مكي بن إبراهيم بن(@)(@@) بشير بن فرقد.(@)(@@) حدث عن: يزيد بن أبي عبيد، والجعيد بن(@)(@@) عبد الرحمن.(@)(@@) روى عنه: أحمد بن حنبل.(@)(@@) ثنا عبد الصمد بن الفضل، وإسماعيل بن بشير(@)(@@) وحمدان بن ذا النون، قالوا: ثنا أبو السكن(@)(@@) مكي بن إبراهيم بن بشير بن فرقد.(@)(@@)(@@)(@@) $ 3628 - (@)(@@) أبو السكن: رأى عامر الشعبي، لم(@)(@@) يسم.(@)(@@) روى عنه: نعيم بن حماد.(@)(@@)(@@)(@@) $ 3629 - (@)(@@) أبو السكن: الهجري.(@)(@@) حدث عن: جابر.(@)(@@) روى حديثه: عبد الصمد بن عبد الوارث، عن(@)(@@) صدقة الدقيقي عنه.(@)(@@) PageV00P000(@)(@@)(@@)(@@) || (من كنيته أبو السمح)(@)(@@)(@@)(@@) $ 3630 - (@)(@@) أبو السمح: خادم رسول الله صلى الله عليه وسلم.(@)(@@) روى عنه: محل بن خليفة.(@)(@@)(@@)(@@) $ 3631 - (@)(@@) أبو السمح: دراج، وقيل: اسمه(@)(@@) عبد الرحمن.(@)(@@) حدث عن: أبي الهيثم.(@)(@@) روى عنه: سالم بن غيلان، وعمر بن الحارث(@)(@@) وعبد الله بن لهيعة.(@)(@@) عداده في أهل مصر، قاله أبو سعيد بن يونس.(@)(@@) أخبرنا أبو الطاهر أحمد بن عمرو، ثنا يونس بن(@)(@@) عبد الأعلى، ثنا عبد الله بن وهب، عن عمرو(@)(@@) ابن الحارث، عن دراج أبي السمح، وقال(@)(@@) (ق 154 / أ) يحيى بن بكير، حدثني(@)(@@) عبد الله بن لهيعة، ثنا دراج أبو السمح رجل(@)(@@) من أهل مصر، واسمه عبد الرحمن.(@)(@@)(@@)(@@) $ 3632 - (@)(@@) أبو السمح: المصري.(@)(@@) حدث عن: أبي قبيل المعافري.(@)(@@) روى عنه: زيد بن الحباب.(@)(@@) أخبرنا محمد بن يعقوب، ثنا عبد الله بن أحمد(@)(@@) ابن حنبل، 
ms326	 قال: قرأت على أبي، عن زيد بن(@)(@@) الحباب، حدثني أبو السمح المصري، حدثني(@)(@@) أبو قبيل، قال عبد الله: قال أبي: ليس هذا(@)(@@) دراج، هذا شيخ لزيد بن الحباب.(@)(@@)(@@)(@@) $ 3633 - (@)(@@) أبو السمح: المصري.(@)(@@) حدث عن: عبد الله بن وهب، متأخر.(@)(@@)(@@)(@@) || (من كنيته أبو سكينة)(@)(@@)(@@)(@@) $ 3634 - (@)(@@) أبو سكينة: له صحبة.(@)(@@) عداده في أهل الشام.(@)(@@) روى عنه: عبد الله بن محيريز.(@)(@@)(@@)(@@) $ 3635 - (@)(@@) أبو سكينة: زياد بن مالك، شامي.(@)(@@) روى عنه: أبو بكر بن أبي مريم.(@)(@@) أخبرنا علي بن نصر، ثنا الحسين بن محمد،(@)(@@) ثنا أبو جعفر أحمد بن سعيد، ثنا أحمد بن(@)(@@) سليمان بن أبي الطيب، قال: أبو سكينة اسمه:(@)(@@) زياد بن مالك، أخبرناه ابن عياش، عن أبي(@)(@@) بكر بن أبي مريم.(@)(@@)(@@)(@@) $ 3636 - (@)(@@) أبو سكينة: البهراني، كان قاضيا(@)(@@) بأرمينية.(@)(@@) روى عنه: جعفر بن برقان.(@)(@@) قاله لي علي بن أحمد الحراني.(@)(@@)(@@)(@@) || (من كنيته أبو ساسان)(@)(@@)(@@)(@@) $ 3637 - (@)(@@) أبو ساسان: بريدة بن الحصيب(@)(@@) الأسلمي.(@)(@@) له صحبة، اختلفوا في كنيته.(@)(@@) قاله العباس بن مصعب، صاحب التاريخ.(@)(@@)(@@)(@@) $ 3638 - (@)(@@) أبو ساسان: حضين بن المنذر بن(@)(@@) الحارث بن وعله الرقاشي.(@)(@@) حدث عن: عثمان بن عفان، وعلي بن أبي(@)(@@) PageV00P000(@)(@@) طالب رضي الله عنهما.(@)(@@) روى عنه: الحسن بن أبي الحسن، وعبد الله(@)(@@) ابن فيروز الداناج.(@)(@@)(@@)(@@) $ 3639 - (@)(@@) أبو ساسان: مشاش، وقيل:(@)(@@) أبو الأزهر: خراساني.(@)(@@) حدث عن: عطاء، وطاوس.(@)(@@) روى عنه: شعبة، وهشيم.(@)(@@) أخبرنا محمد بن يعقوب بن يوسف، ثنا(@)(@@) عبد الله بن أحمد بن حنبل، ثنا أبي، ثنا هشيم(@)(@@) ثنا شيخ من أهل خراسان يكنى أبا ساسان،(@)(@@) قال: سألت الضحاك بن مزاحم، قال أبي(@)(@@) أبو ساسان هذا هو مشاش الذي روى عنه شعبة(@)(@@) (ق 154 / ب) .(@)(@@)(@@)(@@) || (من كنيته أبو سبرة)(@)(@@)(@@)(@@) $ 3640 - (@)(@@) أبو سبرة: الجهني.(@)(@@) له صحبة.(@)(@@) روى حديثه: عيسى بن سبرة بن أبي سبرة،(@)(@@) عن أبيه، عن جده.(@)(@@)(@@)(@@) $ 3641 - (@)(@@) أبو سبرة الأسدي، له صحبة.(@)(@@) روى عن: أبيه عبد الرحمن بن أبي سبرة.(@)(@@)(@@)(@@) $ 3642 - (@)(@@) أبو سبرة: يزيد بن مالك.(@)(@@) هو جد خيثمة الذي تقدم ذكره.(@)(@@)(@@)(@@) $ 3643 - (@)(@@) أبو سبرة: ابن أبي رهم بن(@)(@@) عبد العزى 
ms327	 بن أبي قيس بن عبدود بن نضر بن(@)(@@) مالك بن حسل بن عامر بن لؤي بن غالب(@)(@@) شهد مع النبي صلى الله عليه وسلم بدرا.(@)(@@) قاله محمد بن عمر الواقدي، أخبرنا محمد بن(@)(@@) أحمد بن إسحاق المديني، ثنا الحسن بن الجهم(@)(@@) ثنا الحسين بن فرج عنه.(@)(@@)(@@)(@@) $ 3644 - (@)(@@) أبو سبرة الهذلي، تابعي.(@)(@@) سمع: عبد الله بن عمر.(@)(@@) روى عنه: عبد الله بن بريدة الأسلمي(@)(@@)(@@)(@@) $ 3645 - (@)(@@) أبو سبرة النخعي، كوفي.(@)(@@) حدث عن: محمد بن كعب القرظي.(@)(@@) روى عنه: سليمان الأعمش.(@)(@@)(@@)(@@) $ 3646 - (@)(@@) أبو سبرة: عبد الله بن سبرة(@)(@@) الهمذاني، كوفي.(@)(@@) روى عنه: الشعبي.(@)(@@) حدث عنه: يحيى بن زكريا بن أبي زائدة.(@)(@@) أخبرنا علي بن نصر، ثنا الحسين بن محمد،(@)(@@) ثنا داود بن رشيد، ثنا يحيى بن زكريا بن أبي(@)(@@) زائدة، أخبرني أبو سبرة عبد الله بن سبرة(@)(@@) الهمذاني.(@)(@@)(@@)(@@) || (من كنيته أبو سلام)(@)(@@)(@@)(@@) $ 3647 - (@)(@@) أبو سلام: الحبشي.(@)(@@) تابعي اسمه: ممطور بن سلام.(@)(@@) سمعت محمد بن يعقوب، قال: سمعت(@)(@@) الدوري، قال: سمعت يحيى بن معين،(@)(@@) PageV00P000(@)(@@) يقول: أبو سلام اسمه: ممطور(@)(@@)(@@)(@@) $ 3648 - (@)(@@) أبو سلام: عبد الملك، وقيل: ابن(@)(@@) سلام.(@)(@@) سمعت محمد بن يعقوب، قال: سمعت(@)(@@) عباسا، قال: سمع يحيى بن معين، يقول:(@)(@@) عبد الملك بن مسلم يكنى أبا سلام.(@)(@@)(@@)(@@) $ 3649 - (@)(@@) أبو سلام: معاوية بن سلام.(@)(@@) حدث عن: يحيى بن كثير.(@)(@@) أخبرنا علي بن يعقوب بن إبراهيم، أبو زرعة(@)(@@) عبد الرحمن بن عمرو النضري الدمشقي، ثنا(@)(@@) يحيى بن صالح الوحاظي، ثنا أبو سلام معاوية(@)(@@) ابن سلام.(@)(@@)(@@)(@@) || (من كنيته أبو السائب)(@)(@@)(@@)(@@) $ 3650 - (@)(@@) (ق 155 / أ) أبو السائب:(@)(@@) عثمان بن مظعون.(@)(@@) له صحبة، توفي في عهد رسول الله صلى الله عليه وسلم(@)(@@) وقال له النبي صلى الله عليه وسلم(@)(@@) رحمك الله أبا السائب.(@)(@@)(@@)(@@) $ 3651 - (@)(@@) أبو السائب: مولى هشام بن زهرة(@)(@@) مديني.(@)(@@) حدث عن: أبي هريرة، وأبي سعيد.(@)(@@) روى عنه: العلاء بن عبد الرحمن، وشريك(@)(@@) ابن أبي نمير، وبكير بن الأشج، ومحمد بن(@)(@@) عمرو بن عطاء، وصيفي.(@)(@@) أخبرنا العباس بن محمد بن معاذ، ثنا إبراهيم(@)(@@) ابن عبد الله السعدي، ثنا 
ms328	 حفص بن(@)(@@) عبد الرحمن، عن محمد بن إسحاق، عن(@)(@@) محمد بن عمرو بن عطاء، عن أبي السائب(@)(@@) مولى هشام بن زهرة.(@)(@@)(@@)(@@) $ 3652 - (@)(@@) أبو السائب: مولى أم سلمة.(@)(@@) روى عنه: أبو الهيثم.(@)(@@)(@@)(@@) $ 3653 - (@)(@@) أبو السائب: المخزومي.(@)(@@) حدث عن: جدته آمنة بنة أرقم، ولها(@)(@@) صحبة.(@)(@@) روى عنه: حسين بن زيد العلوي.(@)(@@)(@@)(@@) $ 3654 - (@)(@@) أبو السائب: زيد بن السائب.(@)(@@) روى عنه: زيد بن الحباب.(@)(@@)(@@)(@@) $ 3655 - (@)(@@) أبو السائب: سلم بن جنادة بن(@)(@@) سلم، من ولد جابر بن سمرة.(@)(@@) حدث عن: أبي أمامة، وابن نمير.(@)(@@)(@@)(@@) $ 3656 - (@)(@@) أبو السائب: فارسي.(@)(@@) حدث: [عن ... .] .(@)(@@) PageV00P000(@)(@@)(@@)(@@) || (ومن كنيته أبو السرى)(@)(@@)(@@)(@@) $ 3657 - (@)(@@) أبو السرى: ثابت بن يزيد الكوفي(@)(@@) الأزدي.(@)(@@) حدث عن: عمرو بن ميمون.(@)(@@) حدثنا محمد بن يعقوب، ثنا عباسا، ثنا يحيى(@)(@@) ابن معين، قال: وروى شعبة، عن أبي السري(@)(@@) ثابت.(@)(@@)(@@)(@@) $ 3658 - (@)(@@) أبو السري: وأبو صدقة: سليمان(@)(@@) ابن كندير.(@)(@@) روى عنه: شعبة، قاله الحسين بن محمد.(@)(@@)(@@)(@@) $ 3659 - (@)(@@) أبو السري: سهل بن أبي حليمة،(@)(@@) وهو: ابن محمود الخزاعي.(@)(@@) روى عنه: أحمد بن إبراهيم الدورقي.(@)(@@)(@@)(@@) $ 3660 - (@)(@@) أبو السري: منصور بن عمار(@)(@@) الواعظ، كناه السراج.(@)(@@)(@@)(@@) $ 3661 - (@)(@@) أبو السري: القاسم بن عاصم.(@)(@@) حدث عن: علي بن عياش الحمصي.(@)(@@) كناه محمد بن المسيب.(@)(@@)(@@)(@@) $ 3662 - (@)(@@) أبو السري: هناد بن السري.(@)(@@) حدث عن: عبثر بن القاسم، وابن إدريس،(@)(@@) ووكيع بن الجراح، أخبرني أبي، حدثني أبي(@)(@@) ثنا أبو السري هناد بن السري.(@)(@@)(@@)(@@) $ 3663 - (@)(@@) أبو السري: موسى بن الحسين بن(@)(@@) عباد النسائي - يعرف - بالجلاجلي.(@)(@@) حدث عن: عبد الله بن بكر، وأبي نعيم.(@)(@@) أخبرنا أحمد بن محمد بن إبراهيم الوراق، ثنا(@)(@@) أبو السري موسى بن الحسن.(@)(@@)(@@)(@@) $ 3664 - (@)(@@) أبو السري: سورة بن زهير(@)(@@) الخراساني، نزل الإسكندرية.(@)(@@) حدث عن: مسعر.(@)(@@) روى عنه: أحمد بن سيار وكناه.(@)(@@)(@@)(@@) || (من كنيته أبو سليمان)(@)(@@)(@@)(@@) $ 3665 - (@)(@@) أبو سلمان: وقيل: أبو عبد الله،(@)(@@) وأبو عائشة: زيد بن صوحان.(@)(@@)(@@)(@@) $ 3666 - (@)(@@) أبو سلمان: اسمه يزيد.(@)(@@) حدث عن: ابن عمر.(@)(@@) روى عنه: الأعمش.(@)(@@) سمعت محمد بن يعقوب، قال: سمعت(@)(@@) عباسا، قال: سمعت يحيى يقول ذلك.(@)(@@)(@@)(@@) $ 3667 - (@)(@@) أبو سلمان: اسمه: همام المؤذن.(@)(@@) حدث عن: 
ms329	 أبي محذورة.(@)(@@) روى عنه: أبو جعفر الفراء، وقبيصة، عن(@)(@@) سفيان، عن أبي جعفر، عن أبي سلمان.(@)(@@)(@@)(@@) $ 3668 - (@)(@@) أبو سلمان: عبد الرحمن بن أبلجان(@)(@@) الكوفي.(@)(@@) روى عنه: مسعر بن كدام.(@)(@@) PageV00P000(@)(@@) قاله البخاري.(@)(@@) أخبرنا أحمد بن محمد بن إبراهيم، ثنا محمد(@)(@@) ابن عمران بن حبيب، ثنا القاسم بن الحكم،(@)(@@) ثنا مسعر، عن أبي سلمان.(@)(@@)(@@)(@@) $ 3669 - (@)(@@) أبو سلمان: اسمه مسلم.(@)(@@) عن: عمر.(@)(@@) ذكره البخاري.(@)(@@)(@@)(@@) || (ومن كنيته أبو السليل)(@)(@@)(@@)(@@) $ 3670 - (@)(@@) أبو السليل: ضريب بن نقير(@)(@@) القيسي البصري.(@)(@@) حدث عن: زهدم.(@)(@@) روى عنه: سليمان الهيثمي، وسعيد(@)(@@) الجريري، وأبو مودود وسماه.(@)(@@)(@@)(@@) $ 3671 - (@)(@@) أبو السليل: عبيد الله بن أياد بن(@)(@@) لقيط، كوفي.(@)(@@) روى عنه: أبو نعيم، وأبو الوليد.(@)(@@) كناه البخاري.(@)(@@)(@@)(@@) || (ومن كنيته أبو سهيل)(@)(@@)(@@)(@@) $ 3672 - (@)(@@) أبو سهيل: وقيل: أبو جندل:(@)(@@) عبد الله بن سهيل بن عمرو.(@)(@@) له صحبة.(@)(@@) أخبرنا محمد بن أحمد بن إسحاق الدميني،(@)(@@) ثنا الحسن بن الجهم، ثنا الحسين بن الفرج، ثنا(@)(@@) محمد بن عمر الواقدي، عن عبد الله بن سهيل(@)(@@) ابن عمرو، يكنى أبا سهيل.(@)(@@)(@@)(@@) $ 3673 - (@)(@@) أبو سهيل: نافع بن مالك بن أبي(@)(@@) عامر الأصبحي.(@)(@@) عم مالك بن أنس.(@)(@@) حدث عن: أنس.(@)(@@) وسمع: (ق 156 / أ) أباه، وسعيد بن(@)(@@) المسيب.(@)(@@) روى عنه: مالك بن أنس، وعمر بن حمزة،(@)(@@) والزبير بن سعيد الهاشمي وسماه.(@)(@@)(@@)(@@) $ 3674 - (@)(@@) أبو سهيل: البخاري.(@)(@@) حدث عن: محمد بن سلام البيكندي.(@)(@@)(@@)(@@) || (من كنيته أبو سلم)(@)(@@)(@@)(@@) $ 3675 - (@)(@@) أبو سلم الباهلي، بصري.(@)(@@) حدث عن: عثمان بن مقسم.(@)(@@) أخبرنا علي بن نصر، ثنا الحسين بن محمد،(@)(@@) قال: سمعت عمرو بن علي، يقول: سمعت(@)(@@) PageV00P000(@)(@@) إسماعيل بن الفضل، عن بحر السقا، يقول:(@)(@@) سمعت عثمان بن مقسم.(@)(@@)(@@)(@@) $ 3676 - (@)(@@) أبو سلم: يحيى البكاء.(@)(@@) حدث عن: ابن عمر.(@)(@@) روى عنه: حماد.(@)(@@) كناه مسلم بن الحجاج.(@)(@@)(@@)(@@) $ 3677 - (@)(@@) أبو سلم: القاضي بإصبهان: عمرو(@)(@@) ابن عثمان البري.(@)(@@)(@@)(@@) || (من كنيته أبو سلامة)(@)(@@)(@@)(@@) $ 3678 - (@)(@@) أبو سلامة.(@)(@@) سمع: عمر بن الخطاب رضي الله عنه،(@)(@@) كوفي.(@)(@@) روى عنه: سماك بن حرب.(@)(@@)(@@)(@@) $ 3679 - (@)(@@) أبو سلامة: الحبيبي.(@)(@@) من ولد حبيب ابن مسلمة.(@)(@@) حدث عن: أبيه.(@)(@@)(@@)(@@) $ 3680 - (@)(@@) أبو سلامة: وقيل: 
ms330	 أبو سلام:(@)(@@) عبد الملك بن مسلم.(@)(@@) هكذا ذكره البخاري.(@)(@@)(@@)(@@) || (من كنيته أبو سهلة)(@)(@@)(@@)(@@) $ 3681 - (@)(@@) أبو سهلة: السائب بن خلاد بن(@)(@@) سويد.(@)(@@) له صحبة.(@)(@@) قاله البخاري.(@)(@@)(@@)(@@) $ 3682 - (@)(@@) أبو سهلة.(@)(@@) حدث عن: عائشة.(@)(@@) روى عنه: قيس بن أبي حازم، مشهور.(@)(@@)(@@)(@@) $ 3683 - (@)(@@) أبو سهلة: السائب بن خلاد بن(@)(@@) السائب، تابعي.(@)(@@) حدث عن: أبيه، ولأبيه صحبة.(@)(@@)(@@)(@@) || (من كنيته أبو سويد)(@)(@@)(@@)(@@) $ 3684 - (@)(@@) أبو سويد: له صحبة.(@)(@@) حدث عن: النبي صلى الله عليه وسلم.(@)(@@) روي عنه: عبادة بن نسي.(@)(@@) أخبرنا أحمد بن الحسن بن عتبة الرازي، ثنا(@)(@@) أبو الزنباع، ثنا يحيى بن بكير، ثنا الليث، عن(@)(@@) هشام بن سعد، عن حاتم بن أبي نصر، عن(@)(@@) عبادة بن نسي، عن رجل من أصحاب النبي(@)(@@) صلى الله عليه وسلم يكنى أبا سويد.(@)(@@)(@@)(@@) $ 3685 - (@)(@@) أبو سويد: معاوية بن سويد بن(@)(@@) PageV00P000(@)(@@) مقرن.(@)(@@) حدث عن: البراء.(@)(@@) كناه مسلم، أخبرنا الحسين، عن مكي(@)(@@) عنه.(@)(@@)(@@)(@@) $ 3686 - (@)(@@) أبو سويد العبدي.(@)(@@) حدث عن: عبد الله (ق 156 / ب) بن(@)(@@) عمر.(@)(@@) روى عنه: أبو مكين نوح بن ربيعة.(@)(@@) وروى وكيع، عن بركة بن يعلى عنه.(@)(@@)(@@)(@@) $ 3687 - (@)(@@) أبو سويد: القضاعي.(@)(@@) حدث عن: تبيع.(@)(@@) عداده في أهل مصر.(@)(@@) روى عنه: سعيد بن أيوب.(@)(@@) قاله لي ابن يونس ابن عبد الأعلى.(@)(@@)(@@)(@@) $ 3688 - (@)(@@) أبو سويد ابن المغيرة.(@)(@@) حدث عن: الحسن.(@)(@@) روى عنه: حماد بن زيد.(@)(@@)(@@)(@@) $ 3689 - (@)(@@) أبو سويد: مولى عبد الرحمن بن(@)(@@) سبرة.(@)(@@) روى عنه: ثابت البناني.(@)(@@)(@@)(@@) || (من كنيته أبو سيف)(@)(@@)(@@)(@@) $ 3690 - (@)(@@) أبو سيف.(@)(@@) حدث عن: الحسن.(@)(@@) روى عنه: يعقوب القعقاع.(@)(@@)(@@)(@@) $ 3691 - (@)(@@) أبو سيف.(@)(@@) عن: الحسن، والأعمش.(@)(@@) روى عنه: يعقوب بن عبد الله القمي.(@)(@@)(@@)(@@) || (من كنيته أبو سراج)(@)(@@)(@@)(@@) $ 3692 - (@)(@@) أبو سراج.(@)(@@) حدث عن: الأشج القيسي.(@)(@@) روى حديثه: سويد أبو حاتم، عن قتادة، عن(@)(@@) الحبسي عنه.(@)(@@)(@@)(@@) $ 3693 - (@)(@@) أبوسراج.(@)(@@) حدث عن: عمرو بن جرير بن عبد الله(@)(@@) البجلي.(@)(@@) روى عنه: عمران بن حدير.(@)(@@)(@@)(@@) $ 3694 - (@)(@@) أبو سراج: سأل سعيد بن المسيب.(@)(@@) روى عنه: الأسود بن شيبان.(@)(@@) أراه الأول قاله ابن منده.(@)(@@) PageV00P000(@)(@@)(@@)(@@) || (من كنيته أبو سرية)(@)(@@)(@@)(@@) $ 3695 - (@)(@@) أبو سرية: راشد بن سعد.(@)(@@) حدث عن: 
ms331	 خالد بن معدان.(@)(@@) قاله البخاري.(@)(@@)(@@)(@@) $ 3696 - (@)(@@) أبو سرية: وقيل: أبو وبرة:(@)(@@) عمير بن نمير.(@)(@@) عداده في أهل الشام.(@)(@@)(@@)(@@) $ 3697 - (@)(@@) أبو سرية.(@)(@@) حدث عن: ابن عمر.(@)(@@) روى عنه: إسماعيل بن أبي خالد.(@)(@@)(@@)(@@) || من كنيته ابو سعاد(@)(@@)(@@)(@@) $ 3698 - (@)(@@) أبو سعاد، وابو عمرو، وأبو عامر،(@)(@@) وأبو حماد: عقبة بن عامر.(@)(@@) له صحبة.(@)(@@)(@@)(@@) $ 3699 - (@)(@@) أبو سعاد.(@)(@@) حدث عن: سعيد بن جبير، وابن الحنيفة.(@)(@@) روى عنه: سفيان الثوري.(@)(@@)(@@)(@@) $ 3700 - (@)(@@) أبو سعاد: الجهني.(@)(@@) روى عنه: معاذ بن عبد الله بن حبيب.(@)(@@)(@@)(@@) || (ومن أفراد (@)(@@)(@@)(@@) ||| الصحابة)(@)(@@)(@@)(@@) $ 3701 - (@)(@@) ابو سريح: حذيفة بن أسيد.(@)(@@)(@@)(@@) $ 3702 - (@)(@@) أبو سليط: اسمه: أسير بن عمرو(@)(@@) ابن قيس.(@)(@@) شهد بدرا.(@)(@@)(@@)(@@) $ 3703 - (@)(@@) أبو سروعة: عقبة بن الحارث.(@)(@@)(@@)(@@) $ 3704 - (@)(@@) ابو السنابل: ابن بعكك.(@)(@@)(@@)(@@) $ 3705 - (@)(@@) ابو السمط: شرحبيل بن السمط.(@)(@@)(@@)(@@) $ 3706 - (@)(@@) أبو سيارة: المتعي.(@)(@@) له صحبة.(@)(@@)(@@)(@@) $ 3707 - (@)(@@) أبو السبع: ذكوان بن عبد قيس.(@)(@@)(@@)(@@) $ 3708 - (@)(@@) أبو سلمى: راعي النبي(@)(@@) صلى الله عليه وسلم.(@)(@@) روى عنه: أبو سلام الأسود، وعباد بن(@)(@@) عبد الصمد.(@)(@@)(@@)(@@) $ 3709 - (@)(@@) أبو سويد التميمي: والد وكيع.(@)(@@)(@@)(@@) $ 3710 - (@)(@@) أبو سلالة: الأسلمي.(@)(@@) روى حديثه: عاصم بن عبيد الله، عن عبيد الله(@)(@@) بن عبد الله عنه.(@)(@@)(@@)(@@) $ 3711 - (@)(@@) أبو سوية: سهيل الفقيمي.(@)(@@) أدرك النبي صلى الله عليه وسلم.(@)(@@) وحدث عن: قيس بن عاصم.(@)(@@) PageV00P000(@)(@@)(@@)(@@) ||| (ومن التابعين)(@)(@@)(@@)(@@) $ 3712 - (@)(@@) أبو السباق: سعيد بن عبيد بن(@)(@@) السباق.(@)(@@) حدث عن: ميمونة.(@)(@@) روى عنه: الزهري.(@)(@@) قاله البخاري.(@)(@@)(@@)(@@) $ 3713 - (@)(@@) أبو السفر: سعيد بن يحمد.(@)(@@) حدث عن: ابن عمر، وابن عباس.(@)(@@)(@@)(@@) $ 3714 - (@)(@@) أبو السديدع: التميمي.(@)(@@) حدث عن: ابن عباس.(@)(@@) روى عنه: علي بن المبارك.(@)(@@)(@@)(@@) $ 3715 - (@)(@@) أبو السوية.(@)(@@) عن: ابن حجيرة.(@)(@@) روى عنه: عمرو بن الحارث.(@)(@@)(@@)(@@) $ 3716 - (@)(@@) أبو سباع.(@)(@@) حدث عن: واثلة.(@)(@@) روى عنه: يزيد بن أبي مالك.(@)(@@)(@@)(@@) $ 3717 - (@)(@@) أبو سبأ: عتبة بن تميم.(@)(@@) عن: علي بن أبي طلحة، والوليد بن عامر.(@)(@@) روى عنه: بقية، وإسماعيل بن [عياش] .(@)(@@) روى حدير الحمصي، عن ابن سبأ، عن أبي(@)(@@) ذر.(@)(@@) أراه هذا، وهو نهشل.(@)(@@) قاله البخاري.(@)(@@)(@@)(@@) $ 3718 - (@)(@@) أبو سلاسي.(@)(@@) عن أبي سعيد الخدري.(@)(@@) روى عنه: سعيد بن سعيد الزرقي.(@)(@@)(@@)(@@) $ 3719 - (@)(@@) أبو سخيلة.(@)(@@) عن: 
ms332	 أبي ذر، وسلمان.(@)(@@) روى عنه: فضيل بن مرزوق، والخضر [بن](@)(@@) القواس.(@)(@@)(@@)(@@) $ 3720 - (@)(@@) أبو سريع.(@)(@@) عن: عبيد بن يعلى.(@)(@@) روى عنه: عاصم بن حكيم.(@)(@@)(@@)(@@) $ 3721 - (@)(@@) أبو السمين.(@)(@@) حدث عن: عبد الله بن عمر.(@)(@@) روى عنه: عبيد بن أبي سليمان.(@)(@@)(@@)(@@) $ 3722 - (@)(@@) أبو سارية.(@)(@@) عن: أنس.(@)(@@) روى عنه: هشام بن سعد.(@)(@@) قاله البخاري.(@)(@@)(@@)(@@) $ 3723 - (@)(@@) أبو السمحاء.(@)(@@) عن: معاذ بن جبل.(@)(@@) روى عنه: عبد الرحمن بن شريح، مصري.(@)(@@)(@@)(@@) $ 3724 - (@)(@@) (ق 157 / ب) أبو سنانة:(@)(@@) النخعي، كوفي.(@)(@@) PageV00P000(@)(@@) عن: عائشة.(@)(@@) روى عنه: برد بن أبي زياد.(@)(@@)(@@)(@@) $ 3725 - (@)(@@) أبو سمية.(@)(@@) عن: جابر.(@)(@@) روى عنه: كثير بن زياد.(@)(@@) قاله البخاري.(@)(@@)(@@)(@@) $ 3726 - (@)(@@) أبو سيحان.(@)(@@) عن: هشام بن عبد الملك.(@)(@@) روى عنه: شعيب مولى أم حكيم.(@)(@@)(@@)(@@) $ 3727 - (@)(@@) أبو سحيم: مبارك بن عبد الله.(@)(@@) حدث عن: عبد العزيز بن صهيب.(@)(@@)(@@)(@@) $ 3728 - (@)(@@) أبو السفر: هارون بن حيان.(@)(@@) روى عنه: هشام بن عمار.(@)(@@)(@@)(@@) $ 3729 - (@)(@@) أبو السوداء: عمرو بن عمران.(@)(@@)(@@)(@@) $ 3730 - (@)(@@) أبو سويرة: جبلة بن سحيم.(@)(@@) قاله يحيى بن معين.(@)(@@)(@@)(@@) $ 3731 - (@)(@@) أبو سحابة: زياد بن عمرو.(@)(@@) قاله البخاري.(@)(@@)(@@)(@@) $ 3732 - (@)(@@) أبو سيدان: عبيد بن الطفيل(@)(@@) الكوفي.(@)(@@) حدث عن: ربعي بن حراش.(@)(@@) روى عنه: عبيد الله بن موسى، وسماه.(@)(@@)(@@)(@@) $ 3733 - (@)(@@) أبو سمير: حكيم بن [خذام] .(@)(@@) عن: الأعمش، وعبد الملك بن عمير.(@)(@@)(@@)(@@) $ 3734 - (@)(@@) أبو سوادة: مسلم بن مخراق.(@)(@@) روى عنه: حزام القطعي وكناه.(@)(@@)(@@)(@@) $ 3735 - (@)(@@) أبو سعدة: موسى بن السائب.(@)(@@)(@@)(@@) $ 3736 - (@)(@@) أبو سودة: الربيع بن النعمان(@)(@@) الغنوي.(@)(@@) قاله البخاري.(@)(@@)(@@)(@@) $ 3737 - (@)(@@) أبو سكين: زكريا بن يحيى(@)(@@) الطائي.(@)(@@)(@@)(@@) $ 3738 - (@)(@@) أبو سنام.(@)(@@) روى عنه: كهمس بن الحسن.(@)(@@)(@@)(@@) $ 3739 - (@)(@@) أبو سماعة: عميرة بن عبد المؤمن.(@)(@@) PageV00P000(@)(@@)(@@)(@@) | (باب الشين)(@)(@@)(@@)(@@) || (@)(@@)(@@)(@@) $ 3740 - (@)(@@) أبو شريح: الخزاعي، خويلد بن(@)(@@) عمرو الكعبي.(@)(@@) له صحبة.(@)(@@) وقيل اسمه: هانيء.(@)(@@) أخبرنا أحمد بن الحسن بن عتبة، ثنا عبد الله(@)(@@) ابن بحيس المدني، ثنا الحزامي، قال:(@)(@@) وأبو شريح الكعبي اسمه: خويلد.(@)(@@)(@@)(@@) $ 3741 - (@)(@@) أبو شريح: هانيء بن يزيد الحارثي(@)(@@) له صحبة.(@)(@@) كناه النبي صلى الله عليه وسلم.(@)(@@) روى عنه: ابنه شريح.(@)(@@)(@@)(@@) $ 3742 - (@)(@@) أبو شريح: عبد الرحمن بن شريح(@)(@@) الإسكندراني المصري، كان ينزل المعافر.(@)(@@) روى 
ms333	 عنه: عبد الله بن المبارك، وعبد الله بن(@)(@@) وهب.(@)(@@)(@@)(@@) $ 3743 - (@)(@@) أبو شريح: ضبارة بن مالك(@)(@@) الحمصي.(@)(@@) روى عنه: بقية، وإسماعيل بن عياش.(@)(@@)(@@)(@@) || (من كنيته أبو شداد)(@)(@@)(@@)(@@) $ 3744 - (@)(@@) (ق 158 / أ) أبو شداد: شهد(@)(@@) وفاة النبي صلى الله عليه وسلم.(@)(@@) روى عنه: معاوية بن صالح الحمصي.(@)(@@)(@@)(@@) $ 3745 - (@)(@@) أبو شداد: رجل من أهل دما،(@)(@@) كتب إليه النبي صلى الله عليه وسلم.(@)(@@) روى عنه: عبد العزيز بن زياد.(@)(@@)(@@)(@@) $ 3746 - (@)(@@) أبو شداد: اسمه سلمان.(@)(@@) حدث عن: أم سلمة.(@)(@@) كناه البخاري.(@)(@@)(@@)(@@) $ 3747 - (@)(@@) أبو شداد: إسحاق بن مضر(@)(@@) المروزي.(@)(@@) روى عنه: مسلم بن الحجاج.(@)(@@)(@@)(@@) $ 3748 - (@)(@@) أبو شداد.(@)(@@) حدث عن: مجاهد.(@)(@@) روى عنه: ابن جريج.(@)(@@)(@@)(@@) $ 3749 - (@)(@@) أبو شداد.(@)(@@) عن: جابر.(@)(@@) روى عنه: عمر بن نبهان.(@)(@@) PageV00P000(@)(@@)(@@)(@@) || (من كنيته أبو شرحبيل)(@)(@@)(@@)(@@) $ 3750 - (@)(@@) أبو شرحبيل: وقيل: أبو شراحيل:(@)(@@) ذي الكلاع، من أهل اليمن.(@)(@@) أدرك النبي صلى الله عليه وسلم، ولم يره.(@)(@@) سمعت محمد بن يعقوب، يقول: سمعت(@)(@@) عباسا، يقول: سمعت يحيى بن معين،(@)(@@) يقول: ذي الكلاع أبو شرحبيل.(@)(@@)(@@)(@@) $ 3751 - (@)(@@) أبو شرحبيل: سلام بن شرحبيل.(@)(@@) روى عنه: سليمان الأعمش.(@)(@@) حدث عن: حبة، وسواء ابني خالد.(@)(@@)(@@)(@@) $ 3752 - (@)(@@) أبو شرحبيل: عيسى بن خالد بن(@)(@@) نافع، ابن أخي أبي اليمان الحمصي.(@)(@@) حدث عن: أبي اليمان.(@)(@@) روى عنه: عبد الله بن أحمد بن حنبل، وابن(@)(@@) صدقة.(@)(@@)(@@)(@@) || (من كنيته أبو شيبة)(@)(@@)(@@)(@@) $ 3753 - (@)(@@) أبو شيبة: الخدري.(@)(@@) سمع: النبي صلى الله عليه وسلم.(@)(@@) روى عنه: مشرس راوية أبي عاصم، عن(@)(@@) يونس بن الحارث، عن أبيه.(@)(@@)(@@)(@@) $ 3754 - (@)(@@) أبو شيبة.(@)(@@) سمع: عمرو بن عنبسة.(@)(@@) روى عنه: جنادة بن أبي خالد.(@)(@@)(@@)(@@) $ 3755 - (@)(@@) أبو شيبة: سعيد بن عبد الرحمن(@)(@@) الزبيدي.(@)(@@) حدث عن: مجاهد.(@)(@@) روى عنه: سفيان الثوري، وعبد الواحد بن(@)(@@) زياد.(@)(@@) سمع منه: حكام بن سلم بالري.(@)(@@)(@@)(@@) $ 3756 - (@)(@@) أبو شيبة: عبد الرحمن بن إسحاق(@)(@@) الكوفي.(@)(@@) سمع: النعمان بن سعد.(@)(@@) روى عنه: ابن إدريس، وأبو معاوية وغيرهما.(@)(@@)(@@)(@@) $ 3757 - (@)(@@) أبو شيبة.(@)(@@) عن: عمر بن الخطاب.(@)(@@) روى حديثه: عبد الرحمن بن إسحاق، عن(@)(@@) أبيه، عن جده.(@)(@@)(@@)(@@) $ 3758 - (@)(@@) أبو شيبة.(@)(@@) حدث عن: ثوبان، وأبي الدرداء.(@)(@@) روى 
ms334	 عنه: أبو الفيض موسى بن أبي عوف،(@)(@@) PageV00P000(@)(@@) وأبو الجودي.(@)(@@)(@@)(@@) $ 3759 - (@)(@@) أبو شيبة: شعيب بن رزيق.(@)(@@) حدث عن: الحسن، وعطاء.(@)(@@) روى عنه: الوليد بن مسلم، وبشر بن عمر.(@)(@@) أخبرنا أحمد (ق 158 / ب) ابن محمد بن(@)(@@) إبراهيم، ثنا محمد بن عبد الوهاب العسقلاني(@)(@@) أنا آدم، ثنا أبو إياس، حدثنا أبو شيبة شعيب بن(@)(@@) رزيق.(@)(@@)(@@)(@@) $ 3760 - (@)(@@) أبو شيبة: آدم بن الزبرقان الكوفي.(@)(@@) حدث عن: عامر الشعبي.(@)(@@) روى عنه: سعيد بن أبي أيوب، أخبرنا أحمد(@)(@@) ابن محمد بن زياد، ثنا محمد بن إسماعيل،(@)(@@) ثنا عبد الرحمن المقريء، ثنا سعيد بن أبي(@)(@@) أيوب، ثنا آدم بن الزبرقان، وهو: أبو شيبة.(@)(@@)(@@)(@@) $ 3761 - (@)(@@) أبو شيبة: يوسف بن أبي تميم(@)(@@) اللالي.(@)(@@) عن: أنس بن مالك.(@)(@@) روى عنه: عقبة بن خالد وغيره.(@)(@@)(@@)(@@) $ 3762 - (@)(@@) أبو شيبة: الجهني.(@)(@@) حدث عن: ابن أبي ليلى.(@)(@@) روى عنه: يوسف بن أبي إسحاق.(@)(@@)(@@)(@@) $ 3763 - (@)(@@) أبو شيبة: ابن أبي راشد، مولى(@)(@@) عبيد بن عمير.(@)(@@) حدث عن: محمد بن علي بن أبي طالب.(@)(@@) روى عنه: سفيان بن عيينة.(@)(@@)(@@)(@@) $ 3764 - (@)(@@) أبو شيبة: زياد بن درهم النخعي.(@)(@@) حدث عن: عكرمة.(@)(@@) روى عنه: أبو زهير عبد الرحمن بن مغراء،(@)(@@) وعباد بن العوام.(@)(@@)(@@)(@@) $ 3765 - (@)(@@) أبو شيبة: الزبيدي.(@)(@@) حدث عن: بكر بن عبد الله المزني.(@)(@@) روى عنه: زهير بن معاوية.(@)(@@)(@@)(@@) $ 3766 - (@)(@@) أبو شيبة: يحيى بن عبد الله،(@)(@@) وقيل عبد الرحمن بن يحيى.(@)(@@) روى عنه: هشيم وغيره.(@)(@@)(@@)(@@) $ 3767 - (@)(@@) أبو شيبة: وقيل: أبو شعبة: واصل(@)(@@) ابن عبد الرحمن.(@)(@@) كناه مسلم بن الحجاج.(@)(@@)(@@)(@@) $ 3768 - (@)(@@) أبو شيبة: شعبة بن الحجاج.(@)(@@)(@@)(@@) $ 3769 - (@)(@@) أبو شيبة: إبراهيم بن عثمان بن(@)(@@) خواستي العبسي الكوفي، قاضي واسط.(@)(@@) جد بني شيبة، حدث عن: الحكم بن عيينة.(@)(@@) روى عنه: يزيد بن هارون.(@)(@@)(@@)(@@) $ 3770 - (@)(@@) أبو شيبة: يزيد بن معاوية.(@)(@@) حدث عن: عبد الملك بن عمير.(@)(@@) روى عنه: سعيد بن منصور.(@)(@@)(@@)(@@) $ 3771 - (@)(@@) أبو شيبة: يحيى بن دينار.(@)(@@) كناه مسلم بن الحجاج.(@)(@@)(@@)(@@) $ 3772 - (@)(@@) أبو شيبة: يحيى بن يزيد الرهاوي.(@)(@@) PageV00P000(@)(@@) عن: زيد بن أنيسة.(@)(@@) روى عنه: إسماعيل بن عياش.(@)(@@)(@@)(@@) $ 3773 - (@)(@@) أبو شيبة: إبراهيم بن أبي بكر. 
ms335	(@)(@@) روى عنه: ابن أبي شيبة.(@)(@@) حدث عن: عبيد الله بن موسى، وبكر القاضي.(@)(@@)(@@)(@@) || (من كنيته أبو شمر)(@)(@@)(@@)(@@) $ 3774 - (@)(@@) أبو شمر: أبرهة الأصبحي(@)(@@) (ق 159 / أ) ، له صحبة.(@)(@@) قال أبو سعيد بن يونس، له ذكر في المصريين.(@)(@@)(@@)(@@) $ 3775 - (@)(@@) أبو شمر: شرحبيل، ويلقب: ذي(@)(@@) الجوشن، الضبابي.(@)(@@) سمع: النبي صلى الله عليه وسلم.(@)(@@) روى عنه: أبو إسحاق السبيعي.(@)(@@) أخبرنا علي بن محمد بن نصر، ثنا الحسين بن(@)(@@) محمد، ثنا محمد بن عباد المكي، ثنا سفيان،(@)(@@) عن أبي إسحاق، عن ذي الجوشن، أبي شمر(@)(@@) الضبابي.(@)(@@) قال سفيان: وكان ابنه جاور لأبي إسحاق،(@)(@@) ولا أراه إلا سمعه من ابن ذي الجوشن.(@)(@@)(@@)(@@) $ 3776 - (@)(@@) أبو شمر: الضبعي البصري.(@)(@@) حدث عن: عائذ بن عمرو.(@)(@@) روى عنه: شعبة بن الحجاج.(@)(@@) أخبرنا محمد بن أحمد بن محبوب المروزي،(@)(@@) ثنا سعيد بن مسعود المروزي، ثنا النضر بن(@)(@@) شميل، ثنا شعبة، عن أبي شمر الضبعي.(@)(@@)(@@)(@@) $ 3777 - (@)(@@) أبو شمر: الأدمري، شامي.(@)(@@) عن: كعب.(@)(@@) روى عنه: شريح بن عبيد.(@)(@@)(@@)(@@) $ 3778 - (@)(@@) أبو شمر.(@)(@@) حدث عن: عبد الله بن أبي مليكة.(@)(@@) روى عنه: الصلت بن طريف.(@)(@@) أراه الأول، قاله ابن منده.(@)(@@)(@@)(@@) || (من كنيته أبو الشعثاء)(@)(@@)(@@)(@@) $ 3779 - (@)(@@) أبو الشعثاء: جابر بن زيد.(@)(@@) حدث عن: ابن عباس.(@)(@@) روى عنه: عمرو بن دينار.(@)(@@)(@@)(@@) $ 3780 - (@)(@@) أبو الشعثاء: سليم بن الأسود(@)(@@) المحاربي الكوفي.(@)(@@) سمع: عبد الله بن مسعود.(@)(@@) روى عنه: أبو إسحاق، وإبراهيم النخعي،(@)(@@) وابنه أشعث.(@)(@@)(@@)(@@) $ 3781 - (@)(@@) أبو الشعثاء: قنبرة، مولى ابن(@)(@@) عمر.(@)(@@) سمع: عبد الله بن عباس، وابن عمر.(@)(@@) روى عنه: صالح بن عبيد السلمي.(@)(@@) قاله علي ابن المديني.(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 3782 - (@)(@@) أبو الشعثاء: بشير بن نهيك.(@)(@@) حدث عن: أبي هريرة.(@)(@@) روى عنه: النضر بن أنس.(@)(@@) أخبرنا محمد بن عبد الله العماني، ثنا عبد الله(@)(@@) ابن أحمد بن حنبل قال: قال أبي: بشير بن(@)(@@) نهيك أبي الشعثاء.(@)(@@)(@@)(@@) $ 3783 - (@)(@@) أبو الشعثاء: العجاج، واسمه:(@)(@@) عبد الله التميمي، بصري.(@)(@@) سمع: أبا هريرة.(@)(@@) روى عنه: ابنه رؤبة.(@)(@@)(@@)(@@) $ 3784 - (@)(@@) أبو الشعثاء: يزيد بن المهاجر(@)(@@) الكندي.(@)(@@) كناه محمد بن عبد الله بن نمير.(@)(@@)(@@)(@@) $ 3785 - (@)(@@) أبو الشعثاء: أحمد بن 
ms336	 عثمان(@)(@@) الواسطي.(@)(@@) روى عنه: علي بن عبد العزيز، ومسلم بن(@)(@@) الحجاج، وأسلم بن سهل (159 / ب) .(@)(@@)(@@)(@@) $ 3786 - (@)(@@) أبو الشعثاء: الكندي.(@)(@@) عن: ابن عمر.(@)(@@) روى عنه: يونس بن أبي إسحاق.(@)(@@)(@@)(@@) $ 3787 - (@)(@@) أبو الشعثاء.(@)(@@) عن: أنس.(@)(@@) روى عنه: عمر بن سهل المازني.(@)(@@)(@@)(@@) $ 3788 - (@)(@@) أبو الشعثاء.(@)(@@) عن: عبد الله بن بريدة.(@)(@@) روى عنه: عبد الملك بن أبي سليمان.(@)(@@)(@@)(@@) || (من كنيته أبو شعبة)(@)(@@)(@@)(@@) $ 3789 - (@)(@@) أبو شعبة.(@)(@@) حدث عن: سويد بن مقرن.(@)(@@) روى عنه: محمد بن المنكدر.(@)(@@)(@@)(@@) $ 3790 - (@)(@@) أبو شعبة: البكري، من أهل(@)(@@) البصرة.(@)(@@) حدث عن: الحسن، والحسين، وابن عمر(@)(@@) رضي الله عنهم.(@)(@@) روى عنه: عمار الدهني، وهلال بن يساف.(@)(@@)(@@)(@@) $ 3791 - (@)(@@) أبو شعبة: الأسدي.(@)(@@) رأى عبد الله بن عمر.(@)(@@) روى عنه: عبيد بن عبد الملك.(@)(@@)(@@)(@@) $ 3792 - (@)(@@) أبو شعبة: عبيد بن عبد الرحمن(@)(@@) العدوي البصري.(@)(@@) سمع: ابن عباس.(@)(@@) روى عنه: قتادة، وخلدة، ومطر الوراق،(@)(@@) وكناه وسماه.(@)(@@)(@@)(@@) $ 3793 - (@)(@@) أبو شعبة.(@)(@@) رأى الحسن، روى عنه: ليث بن أبي سليم.(@)(@@)(@@)(@@) $ 3794 - (@)(@@) أبو شعبة: نوح الراسبي.(@)(@@) حدث عن: يزيد بن عمر، وعن الحسن.(@)(@@) روى عنه: زيد بن الحباب وسماه وكناه.(@)(@@)(@@)(@@) $ 3795 - (@)(@@) أبو شعبة.(@)(@@) عن: عبد الرحمن بن فارس الأبلق.(@)(@@) روى عنه: عبد الملك بن ميسرة.(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 3796 - (@)(@@) أبو شعبة: مولى ابن مسعود.(@)(@@) حدث عن: أبي مسعود رضي الله عنه.(@)(@@) روى عنه: صدقة بن أبي عمران، عن أبي(@)(@@) يعفور عنه.(@)(@@)(@@)(@@) $ 3797 - (@)(@@) أبو شعبة: الحنفي.(@)(@@) حدث عن: أبي الربيع.(@)(@@) روى عنه: أبو تميلة يحيى بن واضح.(@)(@@)(@@)(@@) $ 3798 - (@)(@@) أبو شعبة: ميمون.(@)(@@) حدث عن: زيد بن علي.(@)(@@) قاله البخاري.(@)(@@)(@@)(@@) || (من كنيته أبو شعيب)(@)(@@)(@@)(@@) $ 3799 - (@)(@@) أبو شعيب: الصلت بن دينار(@)(@@) الأزدي البصري.(@)(@@) حدث عن: عبد الله بن شقيق، وعقبة بن(@)(@@) صهبان.(@)(@@) روى عنه: الثوري، وأبو داود.(@)(@@) أخبرنا علي بن محمد بن نصر، ثنا الحسين بن(@)(@@) محمد، قال: سمعت عمرو بن علي، يقول:(@)(@@) سمعت يحيى بن سعيد، يقول: ذهبت أنا(@)(@@) وعوف، نعود الصلت بن دينار، فذكر(@)(@@) الصلت عليا فنال منه، فقال له عوف: يا أبا(@)(@@) شعيب لا رفع الله صرعتك.(@)(@@)(@@)(@@) $ 3800 - (@)(@@) أبو شعيب: اسمه يزيد.(@)(@@) سمع (ق 
ms337	 160 / أ) : عكرمة مولى ابن(@)(@@) عباس.(@)(@@) روى عنه: عبد الله بن المبارك.(@)(@@)(@@)(@@) $ 3801 - (@)(@@) أبو شعيب: الحنظلي.(@)(@@) سمع: طاوسا، وسعيد بن جبير.(@)(@@) روى عنه: الثوري.(@)(@@) أخبرنا خيثمة وغيره، قالا: ثنا إسحاق بن(@)(@@) إبرهيم، عن عبد الرزاق، عن الثوري، عن(@)(@@) أبي شعيب الحنظلي، عن أبي سعاد، عن(@)(@@) سعيد بن جبير في الغزل.(@)(@@) رواه وكيع، عن سفيان، فقال: عن أبي سعاد(@)(@@) سعيد بن جبير، ووهم فيه.(@)(@@)(@@)(@@) $ 3802 - (@)(@@) أبو شعيب.(@)(@@) حدث عن: جده، عن ابن مسعود.(@)(@@) روى عنه: عبد الله بن عون.(@)(@@) قاله البخاري.(@)(@@)(@@)(@@) $ 3803 - (@)(@@) أبو شعيب: الحضرمي.(@)(@@) سمع: أبا أيوب الأنصاري.(@)(@@) روى عنه: عثمان بن أبي سودة.(@)(@@)(@@)(@@) $ 3804 - (@)(@@) أبو شعيب الأسدي.(@)(@@) عن: ابن عمر.(@)(@@) روى ابن عيينة، عن أبي عبد الملك عبيد بن(@)(@@) عبد الملك عنه، وقال أبو نعيم: عن عبيد بن(@)(@@) PageV00P000(@)(@@) عبد الملك، عن أبي شعيب.(@)(@@)(@@)(@@) $ 3805 - (@)(@@) أبو شعيب: مولى الأنصار.(@)(@@) حدث عن: عبد الله بن عمرو.(@)(@@) روى عنه: يزيد بن أبي حبيب، وبكير الأشج(@)(@@) عداده في أهل مصر.(@)(@@) قاله لي أبو سعيد بن يونس.(@)(@@)(@@)(@@) $ 3806 - (@)(@@) أبو شعيب: مولى أبي وحوج(@)(@@) البلوي.(@)(@@) حدث عن: أبي وحوج.(@)(@@) روى عنه: الحارث بن يعقوب، عداده في(@)(@@) أهل مصر، قاله لي أبو سعيد بن يونس.(@)(@@)(@@)(@@) $ 3807 - (@)(@@) أبو شعيب: البناني عبد الله بن أبي(@)(@@) عبد الله.(@)(@@) حدث عن: الحسن، ومحمد بن سيرين.(@)(@@) روى عنه: يزيد بن هارون.(@)(@@) قاله البخاري.(@)(@@)(@@)(@@) $ 3808 - (@)(@@) حماد بن شعيب الحماني، كوفي.(@)(@@) حدث عن: الأعمش، وحبيب بن أبي ثابت،(@)(@@) كناه ابن نمير.(@)(@@)(@@)(@@) $ 3809 - (@)(@@) أبو شعيب: راشد، بصري.(@)(@@) ذكره محمد بن إسماعيل البخاري.(@)(@@)(@@)(@@) $ 3810 - (@)(@@) أبو شعيب: موسى بن عبد العزيز(@)(@@) القنباري العدوي.(@)(@@)(@@)(@@) $ 3811 - (@)(@@) أبو شعيب: قديم الحراني.(@)(@@) والد أحمد.(@)(@@)(@@)(@@) $ 3812 - (@)(@@) أبو شعيب: صالح بن زياد السوسي(@)(@@) المقريء.(@)(@@) قرأ على اليزيدي، عن أبي عمرو بن العلاء(@)(@@) وحدث.(@)(@@)(@@)(@@) $ 3813 - (@)(@@) أبو شعيب: صالح بن حكيم(@)(@@) التمار.(@)(@@) روى عنه: أحمد بن عمير بن يوسف.(@)(@@)(@@)(@@) $ 3814 - (@)(@@) أبو شعيب: صالح بن عمران الدعاء(@)(@@) بصري، دخل مصر والإسكندرية.(@)(@@)(@@)(@@) $ 3815 - (@)(@@) أبو شعيب: عبد الله بن الحسن بن(@)(@@) (ق 160 / ب) أبي شعيب الحراني. 
ms338	(@)(@@) حدث عن: البابلتي.(@)(@@)(@@)(@@) || (من كنيته أبو شجاع)(@)(@@)(@@)(@@) $ 3816 - (@)(@@) أبو شجاع: مولى أسلم، مصري.(@)(@@) روى عنه: حرملة بن عمران، قاله أبو سعيد بن(@)(@@) يونس.(@)(@@)(@@)(@@) $ 3817 - (@)(@@) أبو شجاع: سعيد بن يزيد(@)(@@) الإسكندراني.(@)(@@) روى عنه: الليث بن سعد، وعبد الله بن(@)(@@) المبارك.(@)(@@) أخبرنا إسماعيل بن محمد البغدادي، نا(@)(@@) الحسن بن عرفة، نا ابن المبارك، عن أبي(@)(@@) PageV00P000(@)(@@) شجاع سعيد بن يزيد.(@)(@@)(@@)(@@) $ 3818 - (@)(@@) أبو شجاع: الجرجاني.(@)(@@) روى عنه: السري بن يحيى البصري.(@)(@@)(@@)(@@) || (من كنيته أبو شيخ)(@)(@@)(@@)(@@) $ 3819 - (@)(@@) أبو شيخ: حيوان بن خالد الهنائي.(@)(@@) عن: عمر بن الخطاب رضي الله عنه.(@)(@@) روى عنه: قتادة، ويحيى بن أبي كثير.(@)(@@) أخبرنا خيثمة، ومحمد بن يعقوب بن يوسف(@)(@@) قالا: ثنا العباس بن الوليد بن مزيد، أخبرني(@)(@@) أبي، عن الأوزاعي، عن يحيى بن أبي كثير،(@)(@@) عن أبي شيخ الهنائي.(@)(@@)(@@)(@@) $ 3820 - (@)(@@) أبو شيخ: اسمه: مهاجر.(@)(@@) حدث عن: زيد بن صوحان.(@)(@@) روى عنه: يونس بن أبي يعفور، عن أبيه عنه.(@)(@@)(@@)(@@) $ 3821 - (@)(@@) أبو شيخ: مخلد بن هلال، أخو(@)(@@) خالد الحذاء.(@)(@@) أخبرنا علي بن محمد بن نصر، ثنا هشام بن(@)(@@) علي ثنا، كثير بن يحيى، ثنا أبو شيخ مخلد بن(@)(@@) هلال.(@)(@@)(@@)(@@) $ 3822 - (@)(@@) أبو شيخ: جارية بن هرم الفقيمي(@)(@@) البصري.(@)(@@) حدث عن: هشام بن عروة، وعبيد الله بن(@)(@@) عمر.(@)(@@) أخبرنا عبد الواحد بن أبي الخصيب، ثنا الحسن(@)(@@) ابن منصور المصيصي، ثنا داود بن منصور(@)(@@) الرماني، ثنا أبو شيخ جارية بن هرم الفقيمي.(@)(@@)(@@)(@@) $ 3823 - (@)(@@) أبو شيخ: الإصبهاني.(@)(@@) نزل بغداد، اسمه: عبد الله بن زياد.(@)(@@)(@@)(@@) || (من كنيته أبو شهاب)(@)(@@)(@@)(@@) $ 3824 - (@)(@@) أبو شهاب: موسى بن نافع الكوفي(@)(@@) الأسدي.(@)(@@) حدث عن: سعيد بن جبير.(@)(@@) روى عنه: الثوري، ووكيع، و [أبو] نعيم.(@)(@@)(@@)(@@) $ 3825 - (@)(@@) أبو شهاب: محمد بن إبراهيم(@)(@@) الكوفي.(@)(@@) حدث عن: عاصم بن بهدلة.(@)(@@) روى عنه: مسدد بن مسرهد.(@)(@@)(@@)(@@) $ 2826 - (@)(@@) أبو شهاب: عبد ربه بن نافع.(@)(@@) حدث عن: يونس بن عبيد، والأعمش.(@)(@@) روى عنه: عبد الرحمن (ق 161 / أ) ابن(@)(@@) مهدي، وأبو داود.(@)(@@)(@@)(@@) $ 3827 - (@)(@@) أبو شهاب: مسروح.(@)(@@) حدث عن: سفيان الثوري.(@)(@@) روى عنه: يزيد بن موهب، وعمرو بن زرارة(@)(@@)(@@)(@@) $ 3828 
ms339	 - (@)(@@) أبو شهاب: معمر بن محمد(@)(@@) البلخي.(@)(@@) حدث عن: حماد بن سلمة.(@)(@@) روى عنه: عبد الصمد بن الفضل وغيره.(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 3829 - (@)(@@) أبو شهاب: معمر بن محمد بن(@)(@@) أبي شهاب.(@)(@@) حدث عن: عصام بن يوسف، ومكي.(@)(@@) أخبرنا محمد بن علي بن الحسين، ثنا(@)(@@) أبو شهاب معمر.(@)(@@)(@@)(@@) || (من كنيته أبو شراعة)(@)(@@)(@@)(@@) $ 3830 - (@)(@@) أبو شراعة: صباح بن عبد الله(@)(@@) البجلي.(@)(@@) حدث عن: أنس بن مالك.(@)(@@) روى عنه: مروان الفزاري.(@)(@@) أخبرنا علي بن محمد بن نصر، ومحمد بن(@)(@@) يونس، قالا: ثنا الحسين بن محمد، ثنا عمرو(@)(@@) ابن زرارة، أنا الفزاري، ثنا الصباح بن عبد الله(@)(@@) البجلي أبو شراعة.(@)(@@)(@@)(@@) $ 3831 - (@)(@@) أبو شراعة.(@)(@@) عن: ابن عباس.(@)(@@) روى عنه: داود بن عبد الجبار.(@)(@@)(@@)(@@) $ 3832 - (@)(@@) أبو شراعة.(@)(@@) عن: يحيى بن الجزار.(@)(@@) روى عنه: عقبة بن إسحاق السلمي.(@)(@@)(@@)(@@) $ 3833 - (@)(@@) أبو شراعة.(@)(@@) حدث عن: عبادة بن نسي.(@)(@@) روى عنه: الوليد بن مسلم.(@)(@@)(@@)(@@) || (من كنيته أبو شبل)(@)(@@)(@@)(@@) $ 3834 - (@)(@@) أبو شبل: علقمة بن قيس النخعي،(@)(@@) كوفي.(@)(@@) حدث عن: عمر، وعبد الله بن مسعود.(@)(@@) روى عنه: الشعبي، وإبراهيم النخعي،(@)(@@) ومحمد بن سيرين، أخبرنا محمد بن يونس،(@)(@@) ثنا الحسين بن محمد، ثنا حامد بن عمر، ثنا(@)(@@) حماد بن زيد، عن منصور بن المعتمر، عن(@)(@@) أبي إسحاق، عن سعيد بن ذي حدان، قال:(@)(@@) قلت لعلقمة يا أبا نهشل.(@)(@@)(@@)(@@) $ 3835 - (@)(@@) أبو شبل: العلاء بن عبد الرحمن بن(@)(@@) يعقوب.(@)(@@) حدث عن: أنس بن مالك.(@)(@@)(@@)(@@) $ 3836 - (@)(@@) أبو شبل: مهنا.(@)(@@) قاله مسلم بن الحجاج.(@)(@@)(@@)(@@) || (من كنيته أبو شيبان)(@)(@@)(@@)(@@) $ 3837 - (@)(@@) أبو شيبان: الأسود بن شيبان(@)(@@) البصري.(@)(@@) حدث عن: موسى بن أنس، وخالد بن(@)(@@) سمير.(@)(@@) روى عنه: عبد الرحمن بن مهدي، وسهل بن(@)(@@) PageV00P000(@)(@@) حماد وكناه.(@)(@@)(@@)(@@) $ 3838 - (@)(@@) أبو شيبان: أشرس.(@)(@@) عن: الحسن، قاله البخاري.(@)(@@)(@@)(@@) $ 3839 - (@)(@@) أبو شيبان.(@)(@@) حدث عن: سعيد الجريري (ق 161 / ب) .(@)(@@) روى عنه: عبد الرزاق، ويحيى بن آدم.(@)(@@)(@@)(@@) $ 3840 - (@)(@@) أبو شيبان: سأله حماد بن زيد،(@)(@@) عن حديث سليمان بن أبي داود.(@)(@@) أراه الأول، قاله ابن منده.(@)(@@)(@@)(@@) || (@)(@@)(@@)(@@) $ 3841 - (@)(@@) أبو شجرة: يزيد بن شجرة.(@)(@@) ذكر في الصحابة، ولا يثبت وهو من تابعي(@)(@@) أهل 
ms340	 الشام.(@)(@@)(@@)(@@) $ 3842 - (@)(@@) أبو شجرة: وقيل: أبو القاسم:(@)(@@) كثير بن مرة.(@)(@@) روى عنه: خالد بن معدان، وأبو الزاهرية(@)(@@) وكناه.(@)(@@)(@@)(@@) $ 3843 - (@)(@@) أبو شراحيل، وقيل: أبو شراحبيل:(@)(@@) تقدم ذكره.(@)(@@)(@@)(@@) $ 3844 - (@)(@@) أبو شريك: معقل بن مالك.(@)(@@) حدث عن: عقبة الأصم.(@)(@@) روى عنه: البخاري وكناه.(@)(@@)(@@)(@@) $ 3845 - (@)(@@) أبو شريك: يحيى بن يزيد بن(@)(@@) حماد المصري.(@)(@@) حدث عن: رشدين بن سعد وغيره.(@)(@@)(@@)(@@) || (ومن أفراد(@)(@@)(@@)(@@) ||| الصحابة)(@)(@@)(@@)(@@) $ 3846 - (@)(@@) أبو شقيرة: له صحبة.(@)(@@) روى عنه: مخلد بن عقبة.(@)(@@)(@@)(@@) $ 3847 - (@)(@@) أبو شهم.(@)(@@) روى عنه: قيس بن أبي حازم.(@)(@@)(@@)(@@) $ 3848 - (@)(@@) أبو شاه: له ذكر في حديث أبي(@)(@@) هريرة.(@)(@@)(@@)(@@) $ 3849 - (@)(@@) أبو الشموس: البلوي، كنت مع(@)(@@) النبي صلى الله عليه وسلم في غزوة تبوك.(@)(@@) روى عنه: مطير أبو سليم عنه.(@)(@@)(@@)(@@) $ 3850 - (@)(@@) أبو شراك: عمرو بن عمرو الفهري(@)(@@) شهد بدرا مع النبي صلى الله عليه وسلم.(@)(@@) قاله الواقدي.(@)(@@)(@@)(@@) ||| (ومن التابعين)(@)(@@)(@@)(@@) $ 3851 - (@)(@@) أبو شقيرة.(@)(@@) رأى الحسن، والحسين رضي الله عنهما.(@)(@@) روى عنه: ليث بن أبي سليم.(@)(@@)(@@)(@@) $ 3852 - (@)(@@) أبو الشمال: ابن ضباب.(@)(@@) حدث عن: أبي أيوب.(@)(@@) روى عنه: مكحول.(@)(@@)(@@)(@@) $ 3853 - (@)(@@) أبو شرقي.(@)(@@) عن أبي عثمان النهدي.(@)(@@) روى عنه: شعبة.(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 3854 - (@)(@@) أبو شعيرة: جد أبي إسحاق(@)(@@) السبيعي.(@)(@@) روى عنه: أبو إسحاق.(@)(@@)(@@)(@@) $ 3855 - (@)(@@) أبو شهدة.(@)(@@) عن: طلحة.(@)(@@) روى عنه: الحكم بن محمد.(@)(@@) قاله البخاري.(@)(@@)(@@)(@@) $ 3856 - (@)(@@) أبو الشماح: المعافري.(@)(@@) عن: أبي قبيل.(@)(@@) روى عنه: زيد بن الحباب، قاله لي أبو سعيد(@)(@@) بن يونس.(@)(@@)(@@)(@@) $ 3857 - (@)(@@) أبو شبيب.(@)(@@) عن: عكرمة.(@)(@@) روى عنه: وكيع.(@)(@@)(@@)(@@) $ 3858 - (@)(@@) أبو شدقم: صحب أبا أمامة.(@)(@@) رواه حماد بن زيد، عن العباس بن الوليد عنه.(@)(@@)(@@)(@@) $ 3859 - (@)(@@) أبو شبرمة: عبد الله بن شبرمة(@)(@@) الكوفي.(@)(@@) كناه يحيى بن سعيد.(@)(@@)(@@)(@@) $ 3860 - (@)(@@) أبو شبيل: محمد بن محمد بن(@)(@@) النعمان الباهلي.(@)(@@)(@@)(@@) $ 3861 - (@)(@@) أبو شيظم: عقال بن ناجيه.(@)(@@) كناه أبو عروبة (ق 162 / أ) .(@)(@@)(@@)(@@) $ 3862 - (@)(@@) أبو شاكر: عبد الله بن خالد بن أبي(@)(@@) مريم.(@)(@@) حدث عن: أبيه، عن نافع.(@)(@@) كناه إسماعيل بن أبي أويس في حديث.(@)(@@)(@@)(@@) $ 3863 - (@)(@@) أبو شهيد، وأبو محمد: حبيب بن(@)(@@) الشهيد.(@)(@@) قاله البخاري.(@)(@@)(@@)(@@) $ 3864 - (@)(@@) أبو شجار: عبد الحكم.(@)(@@) كناه مسلم.(@)(@@)(@@)(@@) $ 3865 - (@)(@@) أبو 