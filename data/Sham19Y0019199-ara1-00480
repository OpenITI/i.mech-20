ms461	 وثمانون سنة. قال: أدركت خمسمائة من الصحابة وما كتبت سوادا في بياض.(@)(@@) والشعب: بالفتح بطن من همدان.(@)(@)(@@)(@@)(@@) ||| AUTO 2170 - عامر بن شهر(@)(@)(@@) (¬1).(@)(@)(@@)(@@)(@@) ||| AUTO 2171 - عامر بن الطفيل(@)(@)(@@) (¬2).(@)(@)(@@)(@@)(@@) ||| AUTO 2172 - عامر بن عبد الله بن الزبير(@)(@)(@@) (¬3).(@)(@)(@@)(@@)(@@) ||| AUTO 2173 - عامر بن عبد الله بن قيس، [الأشعري] أبو بردة(@)(@)(@@) (¬4).(@)(@)(@@)(@@)(@@) ||| AUTO 2174 - عامر بن عبد الله بن مسعود، [أبو عبيدة](@)(@)(@@) (¬5).(@)(@)(@@)(@@)(@@) ||| AUTO 2175 - عامر بن عبد الله [بن الجراح] بن هلال بن وهب [الفهري القرشي]، أبو عبيدة بن الجراح(@)(@)(@@) (¬6).(@)(@)(@@)(@@)(@@) ||| AUTO 2176 - أبو عكرمة عامر بن عمران بن زياد الضبي النحوي(@)(@)(@@) (¬7)، من أهل سر من رأى. كان لغويا أخباريا. روى عن ابن الإعرابي، وعنه القاسم بن محمد بن بشار. وكان أعلم الناس بأشعار العرب. صنف "كتاب الخيل". من "نحاة السيوطي".(@)(@)PageV02P194(@)(@)(@@)(@@)(@@) ||| AUTO 2177 - عامر بن فهيرة(@)(@)(@@) (¬1).(@)(@)(@@)(@@)(@@) ||| AUTO 2178 - عايذ الله بن عبد الله أبو إدريس الخولاني(@)(@)(@@) (¬2).(@)(@)(@@)(@@)(@@) ||| AUTO 2179 - عايشة بنت أبي بكر الصديق، أم المؤمنين(@)(@)(@@) (¬3)، فقيهة، عالمة، فصيحة، كثيرة الحديث، عالمة بأيام العرب وأشعارها، تزوجها النبي -عليه السلام- بكرا بعد خديجة بمكة وهي بنت سبع وبنى عليها في المدينة في شوال سنة 2 وهي بنت تسع سنين وماتت بالمدينة سنة سبع وخمسين في رمضان ليلة الثلاثاء وأمرت أن تدفن ليلا، فدفنت بالبقيع وهي إحدى الستة المشهورين بالرواية. قال الزركشي: عائشة -بالهمز- وعوام المحدثين يقرؤنه بياء.(@)(@)(@@)(@@)(@@) ||| AUTO 2180 - عايشة بنت يوسف بن أحمد [الباعونية]، الصوفية(@)(@)(@@) (¬4).(@)(@)(@@)(@@)(@@) ||| AUTO 2181 - عباب بن أسيد(@)(@)(@@) (¬5).(@)(@)(@@)(@@)(@@) ||| AUTO 2182 - عباد بن بشر(@)(@)(@@) (¬6).(@)(@)(@@)(@@)(@@) ||| AUTO 2183 - أبو الحسن عباس بن عباس بن أحمد الوزير الحنفي(@)(@)(@@) (¬7)، المتوفى سنة خمس وثمانين وثلاثمائة. وله تسع وخمسون سنة.(@)(@)PageV02P195(@)(@)(@@)(@@)(@@) ||| CHECK 2186 - عباس بن أحمد بن محمد [البرتي، أبو خبيب](@)(@)(@@) كان وزير مؤيد الدولة حسن بن بويه. حدث عن جماعة. وعنه أبو الشيخ وأبو بكر بن مردويه وابنه الصاحب، وله كتاب في أحكام القرآن ينصر فيه مذهب الاعتزال (¬1)، كما كان ولده على مذهبه في الاعتزال. ذكره تقي الدين.(@)(@)(@@)(@@)(@@) ||| AUTO 2184 - عبادة بن الصامت(@)(@)(@@) (¬2).(@)(@)(@@)(@@)(@@) ||| AUTO 2185 - عبادة بن عبد الله الأندلسي الشاعر(@)(@)(@@) (¬3).(@)(@@) 2186 - عباس بن أحمد 
ms462	 بن محمد [البرتي، أبو خبيب (¬4)].(@)(@)(@@)(@@)(@@) ||| AUTO 2187 - عباس بن أحنف [الحنفي اليمامي]، الشاعر(@)(@)(@@) (¬5).(@)(@)(@@)(@@)(@@) ||| AUTO 2188 - عباس بن حمدان [الأصبهاني] أبو الفضل(@)(@)(@@) (¬6).(@)(@)(@@)(@@)(@@) ||| AUTO 2189 - عباس بن عبد المطلب [أبو الفضل(@)(@)(@@) (¬7)، وأمه نثيلة بنت حيان، يقال إنها أول عربية كست البيت بالديباج لأن العباس ضل وهو صبي فنذرت إن وجدته فلما وجدت فعلت. وكان أسن من النبي -عليه السلام- بسنتين وقيل بثلاث سنين، وكان قد ولي السقاية وعمارة المسجد الحرام بعد أخيه أبي طالب، وكان بمكة مع المشركين وهو مؤمن يكتم إيمانه، وأخذ لرسول PageV02P196 (@@) الله البيعة على أهل العقبة من الأنصار، وأظهر إسلامه يوم فتح مكة، وقيل أسلم يوم بدر فأستقبل النبي -عليه السلام- يوم الفتح ... ](@)(@)(@@)(@@)(@@) ||| AUTO 2190 - عباس بن علي بن داود، الملك الأفضل(@)(@)(@@) (¬1). [من دولة بني رسول باليمن، وتوفي سنة 778 وحمل إلى تعز ودفن بها بمدرسة. وله مآثر منها مدرسة أخرى بمكة تجاه باب الكعبة وأبنية غيرها. وكان ملكا عال الهمة شديد البأس فقيها مؤرخا له مصنفات منها "كتاب بغية ذوي الهمم في أنساب العرب والعجم" وهو مختصر مفيد، و"نزهة العيون في معرفة الطوائف والقرون" و"العطايا السنية" في طبقات فقها اليمن وأعيانها، واختصر "تاريخ ابن خلكان" اختصارا حسنا، ولما توفي أجمعوا على ولده الملك الأشرف إسمعيل].(@)(@)(@@)(@@)(@@) ||| AUTO 2191 - أبو الفضل عباس بن الفرج الرياشي اللغوي النحوي(@)(@)(@@) (¬2)، المتوفى قتيلا بالبصرة سنة سبع وخمسين ومائتين.(@)(@@) قرأ على المازني النحو وقرأ عليه المازني اللغة وكان عالما باللغة والشعر، كثير الرواية عن الأصمعي وأخذ عنه المبرد وابن دريد وصنف "الخيل" و"الإبل" وغير ذلك. قتله الزنج بالبصرة وكان قائما يصلي الضحى في مسجده. وثقه الخطيب.(@)(@@) ورياش: رجل من جذام، كان أبوه عبدا له فنسب إليه. ذكره السيوطي.(@)(@)(@@)(@@)(@@) ||| AUTO 2192 - عباس بن محمد بن أبي بكر، المستعين [بالله](@)(@)(@@) (¬3).(@)(@)(@@)(@@)(@@) ||| AUTO 2193 - عباس بن مرداس الصحابي(@)(@)(@@) (¬4).(@)(@)PageV02P197(@)(@)(@@)(@@)(@@) ||| CHECK 2197 - الإمام أبو محمد عبد بن حميد بن نصر الكشي الحافظ، صاحب "المسند"(@)(@)(@@)(@@)(@@) ||| AUTO 2194 - عباس بن يوسف [الشكلي](@)(@)(@@) (¬1).(@)(@)(@@)(@@)(@@) ||| AUTO 2195 - عباس الملكي الطبيب(@)(@)(@@) .(@)(@)(@@)(@@)(@@) ||| AUTO 2196 - الإمام الحافظ أبو ذر عبد بن 
ms463	 أحمد بن محمد بن عبد الله بن السماك [الهروي] الأنصاري المالكي، شيخ الحرم(@)(@)(@@) (¬2)، المتوفى بمكة سنة ست وثلاثين وأربعمائة وله [تسع وسبعون سنة].(@)(@@) جاور بمكة وصنف التصانيف. وسمع أبا إسحق المستملي والكشميهمني وابن حمويه، وعنه الخطيب وابن عبد البر.(@)(@)(@@) 2197 - الإمام أبو محمد عبد بن حميد بن نصر الكشي الحافظ (¬3)، صاحب "المسند" (¬4)، المتوفى سنة تسع وأربعين ومائتين.(@)(@@) قال السمعاني: هو أبو محمد عبد الحميد، المعروف بعبد بن حميد، إمام جليل القدر، ممن جمع وصنف. روى عنه البخاري ومسلم والترمذي وكانت إليه الرحلة من أقطار الأرض، وثقه ابن حبان.(@)(@)(@@)(@@)(@@) ||| AUTO 2198 - أبو حكيم عبد الله بن إبراهيم بن عبد الله الخبري الشافعي(@)(@)(@@) (¬5)، المتوفى في ذي الحجة سنة ست وسبعين وأربعمائة عن ....(@)(@@) تفقه على أبي إسحق الشيرازي وبرع في الفرائض والحساب وصنف فيهما، وكان يعرف العربية ويكتب الخط الحسن، وشرح "الحماسة" وعدة دواوين، كالبحتري والمتنبي والرضي الموسوي. وسمع وحدث باليسير. وروى عنه سبطه أبو الفضل محمد بن ناصر السلامي.(@)(@)PageV02P198(@)(@)(@@) والخبري: إلى خبر، بفتح الخاء المعجمة وسكون الباء الموحدة، ناحية بشيراز (¬1). ذكره السبكي.(@)(@)(@@)(@@)(@@) ||| AUTO 2199 - العالم الفاضل عبد الله بن إبراهيم بن الشيخ الشبستري، الشهير بنيازي(@)(@)(@@) (¬2)، المتوفى بقسطنطينية في حدود سنة ثلاثين وتسعمائة.(@)(@@) قرأ على علماء العجم ومهر في العلوم العربية والنقلية والعقلية، ثم أتى بلاد الروم وعين له السلطان سليم خان وظيفة وعمل قصيدة فارسية مقدار ستين بيتا، كان أحد مصراعي كل بيت تاريخا لجلوس السلطان سليمان والآخر لفتح رودس. وله "حواشي على حاشية التجريد" للسيد و"حواشي على الحاشية الكبرى" له، وله رسالة فارسية في المعمى. وكان شابا، جميل الصورة، طويل القامة. ذكره أبو الخير وقد سبق ذكر والده.(@)(@)(@@)(@@)(@@) ||| AUTO 2200 - أبو محمد عبد الله إبراهيم الكندي(@)(@)(@@) (¬3)، قال الخزرجي: كان فقيها، نحويا، لغويا، محققا، شرح "الكافي للصغار" في النحو وسماه "الدرر" وانتفع به الناس كثيرا. ذكره السيوطي.(@)(@)(@@)(@@)(@@) ||| AUTO 2201 - عبد الله بن أبي بكر بن محمد المدني(@)(@)(@@) (¬4).(@)(@)(@@)(@@)(@@) ||| AUTO 2202 - عبد الله بن أبي أوفى علقمة [الأسلمي](@)(@)(@@) (¬5).(@)(@)(@@)(@@)(@@) ||| AUTO 2203 - عبد الله بن أبي 
ms464	 ابن سلول(@)(@)(@@) (¬6)، بتنوين أبي وكتابة ابن بالألف وإعرابه بالرفع، لأن سلول أمه، كابن ماجه في الحديث، فلو قرئ الابن مجرورا بالإضافة لانقلب المعنى وتبقى سلول أم أبيه وإنما هي زوجه.(@)(@@) وسلول: فعول غير مصروف للعلمية والتأنيث.(@)(@)PageV02P199(@)(@)(@@)(@@)(@@) ||| AUTO 2204 - عبد الله بن أبي ربيعة(@)(@)(@@) .(@)(@)(@@)(@@)(@@) ||| AUTO 2205 - عبد الله بن أحمد بن إبراهيم بن زنبور الوزير(@)(@)(@@) .(@)(@)(@@)(@@)(@@) ||| AUTO 2206 - الشيخ أبو محمد عبد الله بن أحمد بن أحمد بن أحمد بن عبد الله بن الخشاب النحوي اللغوي(@)(@)(@@) (¬1)، المتوفى في رمضان سنة سبع وستين وخمسمائة.(@)(@@) قال القفطي: كان أعلم أهل زمانه بالنحو، يقال إنه في درجة الفارسي، وله معرفة بالحديث واللغة والمنطق والفلسفة والحساب والهندسة. قرأ الأدب على الجواليقي وسمع الحديث من أبي الغنائم وجماعة. وكان يكتب خطا حسنا، وتخرج به جماعة وروى كثيرا. سمع منه أبو سعد السمعاني وابن سكينة، وكان ثقة في الحديث، وكان بخيلا في ملبسه وعيشه، قليل المبالاة لحفظ ناموس العلم، كثير المزاح واللعب، طيب الأخلاق، وكان يتعمم بالعمامة فتبقى حتى تسود وتنقطع من الوسخ. ولم يتزوج، [ولا تسرى] وكان إذا أراد شراء كتاب غافل الناس وقطع منه ورقة، ليأخذه بثمن بخس وإذا استعار من أحد كتابا وطالبه به، قال له: دخل بين الكتب فلا أقدر عليه، لكنه وقف كتبه على أهل العلم ورؤي بعد موته على هيئة حسنة، فقيل له: ما فعل الله بك؟ قال: غفر لي. صنف "شرح الجمل" للجرجاني و"شرح اللمع" لابن جني لم يتم و"الرد على ابن بابشاذ في شرح الجمل" و"الرد على التبريزي في تهذيب الإصلاح" و"الرد على الحريري" و"شرح مقدمة الوزير ابن هبيرة في النحو". ذكره السيوطي.(@)(@)(@@)(@@)(@@) ||| AUTO 2207 - القائم بأمر الله عبد الله بن أحمد بن إسحق(@)(@)(@@) (¬2). [ولد سنة 391 وأمه أم ولد تسمى قطر وبويع بعد أبيه بعهد منه، وكان جميلا مليح الوجه ورعا دينا زاهدا عاقلا، وكان كثير الصدقة ووقع في أيامه غلاء عظيم عم الدنيا شرقا وغربا وأشياء هائلة، وكان ابتداء دولة السلجوقيه وانقراض دولة بني بويه. ولم يزل أمره 
ms465	 مستقيما إلى أن قبض عليه أرسلان التركي فانتصر له طغرلبك فظفر بأرسلان البساسيري وقتله، ورد الخليفة إلى مكانه ولم يسترد شيئا مما نهب من قصره إلا بالثمن، ولزم الصيام والقيام، ثم إنه افتصد ونام فانحل موضع الفصد وخرج منه PageV02P200 (@@) دم كثير، فاستيقظ وقد انحلت قوته، ثم توفي ليلة الخميس الثالث عشر من شعبان سنة 467 فكانت خلافته أربعا وأربعين سنة وتسعة أشهر وله من العمر سبع وسبعون سنة].(@)(@)(@@)(@@)(@@) ||| AUTO 2208 - أبو محمد عبد الله بن أحمد بن أسعد بن أبي الهيثم(@)(@)(@@) (¬1)، قال الخزرجي: كان فقيها فاضلا مقرئا لغويا نحويا، صنف "الإيضاح في القراءات" و"التبصرة في النحو". ذكره السيوطي.(@)(@)(@@)(@@)(@@) ||| AUTO 2209 - عبد الله بن أحمد بن بشر بن ذكوان(@)(@)(@@) (¬2). [ويقال بشير بن ذكوان بن عمرو بن حسان بن داود بن حسنون بن سعد بن غالب بن فهر بن مالك بن النضر، أبو عمرو، وأبو محمد، القرشي الفهري الدمشقي، الإمام الأستاذ الشهير، الراوي الثقة، شيخ الإقراء بالشام وإمام جامع دمشق، وتوفي يوم الاثنين لليلتين بقيتا من شوال، وقيل: لسبع خلون منه، سنة اثنتين وأربعين ومائتين،(@)(@@) وهو الأصح].(@)(@)(@@)(@@)(@@) ||| AUTO 2210 - أبو هفان عبد الله بن أحمد بن حرب بن خالد النحوي اللغوي الأديب(@)(@)(@@) (¬3)، راوية أهل البصرة. روى عن الأصمعي وعنه يموت بن المزرع وغيره. وكان ثقة صنف "صناعة الشعر" و"أخبار الشعراء". ذكره السيوطي.(@)(@)(@@)(@@)(@@) ||| AUTO 2211 - الشيخ أبو محمد عبد الله بن أحمد بن حمويه بن أحمد بن يوسف بن عين السرخسي(@)(@)(@@) (¬4)، المتوفى سنة إحدى وثمانين وثلاثمائة، عن ثمان وثمانين سنة.(@)(@@) كان عالما، ثقة، صاحب أصول حسان. روى البخاري عن الفربري وعنه الإمام أبو الحسن الداودي. ذكره صاحب "غاية المرام".(@)(@)(@@)(@@)(@@) ||| AUTO 2212 - أبو الحسين عبد الله بن أحمد بن الحسين الشاماتي الأديب(@)(@)(@@) (¬5)، المتوفى سنة خمس وسبعين وسبعمائة. صنف "شرح ديوان المتنبي" و"شرح الحماسة" و"شرح أبيات أمثال أبي عبيد". ذكره السيوطي.(@)(@)PageV02P201(@)(@)(@@)(@@)(@@) ||| AUTO 2213 - الإمام الزاهد عبد الله بن أحمد بن عبد الله القفال المروزي الشافعي(@)(@)(@@) (¬1)، وليس هو القفال الكبير، المتوفى سنة سبع عشرة وأربعمائة وهو 
ms466	 ابن تسعين سنة، بعدما أفنى شبابه في صناعة الأقفال.(@)(@@) وكان ماهرا فيها وكان صنع قفلا بآلاته من وزن أربع حبات من حديد وتفقه على جماعة وسمع الحديث بمرو وبخارى وحدث في آخر عمره وأملى وكان أفقه أهل زمانه، من أعظم محاسن خراسان.(@)(@@) قال السمعاني: وطريقته المهذبة في مذهب الشافعي أمتن طريقة وأوضحها. رحل إليه من البلاد للتفقه عليه وتخرج به جماعة صاروا أئمة في البلاد. وقد صار معتمد المذهب على طريقة العراق وحامل لوائها أبو حامد الإسفرايني وطريقه خراسان والقائم بأعبائها القفال. ذكره السبكي.(@)(@)(@@)(@@)(@@) ||| AUTO 2214 - عبد الله بن أحمد بن عبد العزيز [البشبيشي] الشيخ جمال الدين(@)(@)(@@) (¬2).(@)(@)(@@)(@@)(@@) ||| AUTO 2215 - جلال الدين عبد الله بن أحمد بن علي بش أحمد ابن الفصيح النحوي العراقي الكوفي الحنفي(@)(@)(@@) (¬3)، المتوفى بدمشق سنة خمس وأربعين وسبعمائة، عن ثلاث وأربعين سنة.(@)(@@) طلب الحديث، وسمع من الجزري، والذهبي، وشارك في الفضائل. [وكان] كاتبا مجيدا، جمع وأفاد، وتوطن بدمشق. قاله الصفدي.(@)(@)(@@)(@@)(@@) ||| AUTO 2216 - عبد الله بن أحمد بن علي بن ميكال، أبو الفضل(@)(@)(@@) (¬4)، صاحب "مخزن البلاغة" و"فضائل الملوك".(@)(@)(@@)(@@)(@@) ||| AUTO 2217 - الشيخ الإمام عبد الله بن أحمد بن علي الفاكهي المكي الشافعي(@)(@)(@@) (¬5)، مصنف "مجيب الندا في شرح قطر الندا" صنف سنة أربع وعشرين وتسعمائة.(@)(@)PageV02P202(@)(@)(@@)(@@)(@@) ||| AUTO 2218 - عبد الله بن أحمد بن محمد بن قدامة [بن مقدام] بن نصر [المقدسي] موفق الدين(@)(@)(@@) (¬1).(@)(@)(@@)(@@)(@@) ||| AUTO 2219 - عبد الله بن أحمد بن محمد [بن عطية المالقي، أبو محمد](@)(@)(@@) (¬2).(@)(@)(@@)(@@)(@@) ||| AUTO 2220 - أبو القاسم عبد الله بن أحمد بن محمود الكعبي البلخي الحنفي(@)(@)(@@) (¬3)، المتوفى بها في شعبان سنة تسع عشرة وثلاثمائة.(@)(@@) صاحب التصانيف في الكلام وكان فيه اعتزال. أقام ببغداد واشتهرت بها كتبه، ثم عاد إلى بلخ ومات بها. ومن مصنفاته "تفسير القرآن" في اثني عشر مجلدا و"مفاخر خراسان" و"محاسن آل طاهر" و"عيون المسائل" تسع مجلدات و"أوائل الأدلة" و"المقالات" و"المسترشد في الإمامة" و"كتاب الأسماء والأحكام" و"تجديد الجدل" و"نقض كتاب أبي علي الجبائي في الإرادة" و"أدب الجدل" وكتاب "السنة والجماعة" و"الفتاوى "الواردة من جرجان والعراق] " (¬4) وكتاب 
ms467	 " [نقض] النقض على المجبرة" و"الجوابات" و"الانتقاد للعلم الإلهي على محمد بن زكريا" و"تحف الوزراء" وغير ذلك. ذكره تقي الدين.(@)(@)(@@)(@@)(@@) ||| AUTO 2221 - الإمام أبو البركات عبد الله بن أحمد بن محمود، الشهير بحافظ الدين النسفي الحنفي(@)(@)(@@) (¬5)، المتوفى بإيذج في ربيع الأول سنة إحدى وسبعمائة وقيل عشرة وسبعمائة.(@)(@@) تفقه على شمس الأئمة الكردري وروى "الزيادات" عن العتابي وأخذ عنه الأئمة منهم الصغناقي. له مؤلفات مفيدة منها "المستصفى شرح المنظومة" و"الكافي شرح الوافي" و"كنز الدقائق" و"المنار" و"العمدة" و"الكشف شرح المنار" و"الاعتماد شرح العمدة".(@)(@@) وقال ابن سابق: له شرح أصغر على "المنار" سماه "العطف على الكشف" وشرحان على الأخسيكثي و"المدارك" في التفسير و"المنافع شرح النافع" و"الوافي" تصنيفه أيضا. وله "منار" آخر في أصول الدين وغير ذلك. ذكره تقي الدين وابن الشحنة.(@)(@)PageV02P203(@)(@)(@@)(@@)(@@) ||| AUTO 2222 - عبد الله بن أحمد [المالقي المعروف] بابن بيطار(@)(@)(@@) (¬1).(@)(@)(@@)(@@)(@@) ||| AUTO 2223 - عبد الله بن أحمد الملك المنصور(@)(@)(@@) (¬2)، صاحب اليمن.(@)(@)(@@)(@@)(@@) ||| AUTO 2224 - أبو محمد عبد الله بن إدريس بن يزيد بن عبد الرحمن الأودي الكوفي الحنفي(@)(@)(@@) (¬3)، المتوفى بها سنة اثنتين وتسعين ومائة وله اثنتان وسبعون سنة.(@)(@@) حدث عن أبيه والأعمش وابن جريج، وعنه الإمام مالك وأحمد وابن المبارك وإسحق ويحيى وإبنا أبي شيبة وخلق. وكان حجة، أحد الأعلام، عابدا، فاضلا، صديقا لمالك، أقدمه الرشيد ليوليه القضاء فأبى وقال: لا أصلح ومحاسنه كثيرة. ذكره تقي الدين.(@)(@)(@@)(@@)(@@) ||| AUTO 2225 - عبد الله بن أرقم(@)(@)(@@) (¬4).(@)(@)(@@)(@@)(@@) ||| AUTO 2226 - عبد الله بن إسحق بن هيثم(@)(@)(@@) (¬5).(@)(@)(@@)(@@)(@@) ||| AUTO 2227 - عبد الله بن إسحق أبو محمد الخضرمي الخراساني(@)(@)(@@) (¬6)، له "أجزاء الحديث".(@)(@)(@@)(@@)(@@) ||| AUTO 2228 - الشيخ الكبير عبد الله بن أسعد بن علي بن سليمان بن فلاح الحميري عفيف الدين أبو السعادات اليافعي الشافعي اليمني الصوفي(@)(@)(@@) (¬7)، نزيل مكة المكرمة، المتوفى بها في سنة إحدى وسبعين وسبعمائة.(@)(@)PageV02P204(@)(@)(@@) كان عالما في علمي الحقيقة والشريعة، له تأليفات رائقة، منها: "روض الرياحين" و"الدر النظيم) و"مرآة الجنان" (¬1) وكان علمه يقتبس وبركته تلتمس ذا ورع وزهد وتعبد وكرامات ومناقب.(@)(@)(@@)(@@)(@@) ||| AUTO 2229 - عبد الله بن أسعد بن علي الموصلي [بن الدهان] 
ms468	(@)(@)(@@) (¬2).(@)(@)(@@)(@@)(@@) ||| AUTO 2230 - عبد الله بن إسمعيل بن علي الملك الطاهر(@)(@)(@@) .(@)(@)(@@)(@@)(@@) ||| AUTO 2231 - الشيخ عبد الله بن أشرف بن محمد المصري الرومي الحنفي، المعروف بابن أشرف(@)(@)(@@) (¬3)، المتوفى سنة [889] (¬4) وهو صاحب "مزكي النفوس". أخذ الطريقة عن شيخه السيد حسين البغدادي كما ذكره في آخر كتابه، وله رسائل في الكيمياء.(@)(@)(@@)(@@)(@@) ||| AUTO 2232 - عبد الله بن أنيس(@)(@)(@@) (¬5).(@)(@)(@@)(@@)(@@) ||| AUTO 2233 - عبد الله بن آيدغدي سيف الدين بن الجندي(@)(@)(@@) (¬6).(@)(@)(@@)(@@)(@@) ||| AUTO 2234 - عبد الله بن أيوب بن يوسف الملك الطاهر [الرسولي](@)(@)(@@) (¬7).(@)(@)(@@)(@@)(@@) ||| AUTO 2235 - أبو محمد عبد الله بن بري بن عبد الجبار اللغوي النحوي المقدسي الشافعي(@)(@)(@@) (¬8)، نزيل مصر، المتوفى بها في شوال سنة اثنتين وثمانين وخمسمائة، عن ثلاث وثمانين سنة.(@)(@@) كان إماما مقدما في اللغة والعربية وله أمالي مفيدة وصنف على كتاب "الصحاح" حواشي كثيرة في مجلدات و"اللباب [في] الرد على ابن الخشاب" في رده على الحريري، PageV02P205 (@@) و"الرد على الحريري في درة الغواص"، سمع الحديث من أبي صادق وغيره وروى عنه أبو الحسن علي بن هبة الله وكان ثقة قيما بالنحو واللغة والشواهد. قرأ "كتاب سيبويه" على محمد بن عبد الملك الشنتريني وقرأ عليه الجزولي وكان مع علمه وفهمه، ذا غفلة، يحكى عنه حكايات عجيبة. ذكره السيوطي وغيره.(@)(@)(@@)(@@)(@@) ||| AUTO 2236 - عبد الله بن بريدة الحصيب(@)(@)(@@) (¬1).(@)(@)(@@)(@@)(@@) ||| AUTO 2237 - عبد الله بن بسر -بالسين المهملة وضم الباء- المازني(@)(@)(@@) (¬2).(@)(@)(@@)(@@)(@@) ||| AUTO 2238 - عبد الله بن تاج الرياسة الوزير(@)(@)(@@) (¬3).(@)(@)(@@)(@@)(@@) ||| AUTO 2239 - عبد الله بن ثعلبة(@)(@)(@@) (¬4).(@)(@)(@@)(@@)(@@) ||| AUTO 2240 - عبد الله بن ثوب [أبو مسلم الخولاني](@)(@)(@@) (¬5).(@)(@)(@@)(@@)(@@) ||| AUTO 2241 - عبد الله بن جحش(@)(@)(@@) (¬6).(@)(@)(@@)(@@)(@@) ||| AUTO 2242 - عبد الله بن جعفر بن أبي طالب(@)(@)(@@) (¬7).(@)(@)PageV02P206(@)(@)(@@)(@@)(@@) ||| AUTO 2243 - أبو محمد عبد الله بن جعفر بن درستويه بن المرزبان النحوي(@)(@)(@@) (¬1)، المتوفى سنة سبع وأربعين وثلاثمائة، عن تسع وثمانين سنة.(@)(@@) صحب المبرد ولقي ابن قتيبة وأخذ عنه الدارقطني وغيره. وكان شديد الانتصار للبصريين في النحو واللغة. وئقه ابن مندة وغيره وضعفه هبة الله اللالكائي. صنف "الإرشاد" في النحو و"شرح الفصيح" و"الرد على المفضل" و"الرد على الخليل" "غريب الحديث" و"المقصور والممدود" و"معاني الشعر" 
ms469	 و"أخبار النحاة" وغير ذلك. ذكره السيوطي.(@)(@)(@@)(@@)(@@) ||| AUTO 2244 - عبد الله بن حارث بن نوفل(@)(@)(@@) (¬2).(@)(@)(@@)(@@)(@@) ||| AUTO 2245 - عبد الله بن حاضر(@)(@)(@@) (¬3).(@)(@)(@@)(@@)(@@) ||| AUTO 2246 - عبد الله بن حبيب بن ربيعة(@)(@)(@@) (¬4).(@)(@)(@@)(@@)(@@) ||| AUTO 2247 - الشيخ أبو محمد عبد الله بن الحجاج ابن الياسمين(@)(@)(@@) (¬5).(@)(@)(@@)(@@)(@@) ||| AUTO 2248 - عبد الله بن حذافة(@)(@)(@@) (¬6).(@)(@)(@@)(@@)(@@) ||| AUTO 2249 - عبد الله بن حذيفة(@)(@)(@@) .(@)(@)(@@)(@@)(@@) ||| AUTO 2250 - عبد الله بن حرث [بن جزء الزبيدي](@)(@)(@@) (¬7).(@)(@)(@@)(@@)(@@) ||| AUTO 2251 - عبد الله بن حسن بن أحمد المالقي(@)(@)(@@) (¬8)(@)(@)PageV02P207(@)(@)(@@)(@@)(@@) ||| AUTO 2252 - عبد الله بن حسن بن عبد الرحمن(@)(@)(@@) (¬1).(@)(@)(@@)(@@)(@@) ||| AUTO 2253 - عبد الله بن حسن بن محمد بن علي الرضا(@)(@)(@@) .(@)(@)(@@)(@@)(@@) ||| AUTO 2254 - محب الدين أبو البقاء عبد الله بن الحسين بن عبد الله بن الحسين العكبري البغدادي الضرير النحوي الحنبلي(@)(@)(@@) (¬2)، المتوفى في ربيع الآخر سنة ست عشرة وستمائة، عن ثمان وسبعين سنة.(@)(@@) قرأ بالروايات على البطائحي وتفقه بأبي يعلى الفراء، وقرأ العربية على ابن الخشاب وغيره وصار من الرؤساء المتقدمين وقصده الناس من الأقطار. أقرأ وصنف كتبا، منها: " التبيان في إعراب القرآن" وكتاب "تفسير القرآن" و"شرح الحماسة" و"شرح المتنبي" و"شرح الفصيح" و"شرح المقامات" و"المحصل شرح المفصل" و"نزهة الطرف في الصرف" و"إعراب الشواذ" و"التعليقة" في الخلاف و"الملقح في الجدل" و"الناهض" و"البلغة" و"التلخيص" الثلاثة في الفرائض و"شرح لامية العجم" و"شرح خطب ابن نباتة" و"شرح الإيضاح والتكملة" و"شرح اللمع" و"شرح أبيات سيبويه" و"الباب الكتاب" و"اللباب في علل البناء والإعراب" و"الترصيف" و"الإشارة" و"التلخيص" و"التلقين" و"التهذيب" والأربعة في النحو، و"ترتيب إصلاح المنطق [على حروف المعجم] " و"الاستيعاب في الحساب" وسمع الحديث من أبي زرعة المقدسي وغيره وكان ثقة كثير المحفوظ، أضر في صباه بالجدري وكان إذا أراد التصنيف أحضرت إليه مصنفات ذلك الفن وقرئت عليه وله تردد إلى الرؤساء لتعليم الأدب. ذكره السيوطي.(@)(@)(@@)(@@)(@@) ||| AUTO 2255 - أبو محمد عبد الله بن حسين الناصحي الحنفي النيسابوري(@)(@)(@@) (¬3)، المتوفى سنة سبع وأربعين وأربعمائة.(@)(@@) ولي القضاء ببخارى للسلطان محمود [بن سبكتكين] وله "مختصر في الوقف". اختصر كتاب "الخصاف" و"الهلال" و"مختصر في الفقه" سماه "المسعودي". أفتى ودرس وصنف.(@)(@)PageV02P208(@)(@)(@@) وكان ثقة دينا، صالحا، مجتهدا. 
ms470	 حج سنة 412 وعقد له مجلس الإملاء ببغداد، فحدث عن بشر الإسفرايني وأبي محمد الحاكم الحافظ. روى عنه أبو عبد الله الفاسي.(@)(@)(@@)(@@)(@@) ||| AUTO 2256 - عبد الله بن حنظلة(@)(@)(@@) (¬1).(@)(@)(@@)(@@)(@@) ||| AUTO 2257 - عبد الله بن خطل(@)(@)(@@) (¬2).(@)(@)(@@)(@@)(@@) ||| AUTO 2258 - عبد الله بن حنيف الأنطاكي(@)(@)(@@) .(@)(@)(@@)(@@)(@@) ||| AUTO 2259 - عبد الله بن خليد أبو العميثل(@)(@)(@@) (¬3).(@)(@)(@@)(@@)(@@) ||| AUTO 2260 - أبو عبد الرحمن عبد الله بن داود بن عامر بن الربيع الهمداني الخريبي الشعبي الكوفي الحنفي(@)(@)(@@) (¬4)، المتوفى في شوال سنة ثلاث عشرة ومائتين.(@)(@@) سمع الثوري والأوزاعي وابن جريج. وعنه جماعة إلا مسلما. وكان إماما، حافظا، ثقة، سكن محلة الخربية بالبصرة. ذكره تقي الدين.(@)(@)(@@)(@@)(@@) ||| AUTO 2261 - عبد الله بن ذي النجادين(@)(@)(@@) .(@)(@)(@@)(@@)(@@) ||| AUTO 2262 - عبد الله بن رباح العائقي(@)(@)(@@) .(@)(@)(@@)(@@)(@@) ||| AUTO 2263 - عبد الله بن رواحة [الأنصاري الخزرجي](@)(@)(@@) (¬5).(@)(@)(@@)(@@)(@@) ||| AUTO 2264 - الإمام أبو بكر عبد الله بن الزبير بن عيسى بن عبد الله بن الزبير بن حميد بن زهير بن الحارث بن أسد بن عبد العزى الحميدي الأسدي القرشي الشافعي(@)(@)(@@) (¬6)، المتوفى سنة تسع عشرة ومائتين.(@)(@)PageV02P209(@)(@)(@@) وهو صاحب "المسند" وشيخ البخاري وتلميذ الشافعي. سمع سفيان بن عيينة. روى عنه البخاري وأبو زرعة وأبو حاتم وخلق. وكان ثقة، كثير الحديث وهو رئيس أصحاب ابن عيينة. روى عنه "مسنده" أبو علي بشر بن موسى الآمدي.(@)(@)(@@)(@@)(@@) ||| AUTO 2265 - عبد الله بن زبير بن العوام(@)(@)(@@) (¬1)، - بتشديد الواو- هو أول مولود للمهاجرين بالمدينة وأمه أسماء بنت أبي بكر الصديق -رضي الله عنه-، بويع للخلافة له بمكة سنة أربع وستين واجتمع على طاعته أهل الحجاز واليمن والعراق وخراسان، قتله الحجاج يوم الثلاثاء سبع عشرة خلت من جمادى الأولى سنة 72 اثنتين وسبعين. حج بالناس ثماني حجج.(@)(@)(@@)(@@)(@@) ||| AUTO 2266 - أبو يحيى عبد الله بن زيد بن الحارث الحضرمي النحوي(@)(@)(@@) (¬2)، المتوفى سنة سبع وعشرين ومائة، عن ثمان وثمانين سنة.(@)(@@) أحد الأئمة في القراءات والعربية. أخذ القراءة عن يحيى بن معمر وروى عن أبيه عن جده عن علي، وتناظر هو وأبو عمرو [بن العلاء] وهو الذي مهد القياس و"شرح العلل". وكان يطعن على العرب 
ms471	 ويعيب الفرزدق وينسبه إلى اللحن فهجاه بقوله:(@)(@@) فلو كان عبد الله مولى هجوته ... ولكن عبد الله مولى مواليا(@)(@@) فقال له: لحنت، ينبغي أن تقول: "مولى موالي". وكان مولى آل الخضرمي وهم حلفاء لبني عبد شمس. ذكره السيوطي.(@)(@)(@@)(@@)(@@) ||| AUTO 2267 - عبد الله بن زيد بن سهل الأنصاري(@)(@)(@@) (¬3).(@)(@)(@@)(@@)(@@) ||| AUTO 2268 - عبد الله بن زيد بن عاصم(@)(@)(@@) (¬4).(@)(@)(@@)(@@)(@@) ||| AUTO 2269 - عبد الله بن زيد بن عمرو أبو قلابة التابعي(@)(@)(@@) (¬5).(@)(@)(@@)(@@)(@@) ||| AUTO 2270 - عبد الله بن زيد بن ياسين الدولعي(@)(@)(@@) .(@)(@)PageV02P210(@)(@)(@@)(@@)(@@) ||| AUTO 2271 - عبد الله بن سالم أبو سالم السلمي(@)(@)(@@) ، عاش سنة 130.(@)(@)(@@)(@@)(@@) ||| AUTO 2272 - عبد الله بن السائب بن صيفي المخزومي القارئ التابعي أبو السائب(@)(@)(@@) (¬1)(@)(@)(@@)(@@)(@@) ||| AUTO 2273 - عبد الله بن سعد بن أبي سرح، كاتب الوحي(@)(@)(@@) (¬2).(@)(@)(@@)(@@)(@@) ||| AUTO 2274 - عبد الله بن سعد(@)(@)(@@) (¬3)، والي مصر نيابة.(@)(@)(@@)(@@)(@@) ||| AUTO 2275 - عبد الله بن سعيد بن أبي جمرة الأندلسي(@)(@)(@@) (¬4)، صاحب "مختصر البخاري" (¬5).(@)(@)(@@)(@@)(@@) ||| AUTO 2276 - عبد الله بن سعيد بن كلاب أبو نصر السنجري(@)(@)(@@) (¬6).(@)(@)(@@)(@@)(@@) ||| AUTO 2277 - أبو منصور عبد الله بن سعيد بن مهدي الحوافي الكاتب(@)(@)(@@) (¬7)، المتوفى في شعبان سنة ثمانين وأربعمائة.(@)(@@) قال القفطي: تمكن ببغداد وكان نحويا، أديبا، حاسبا، بليغا، شاعرا، لغويا. حدث عن خالد بن الحسين الأبهري الأديب وكان أكثر رواياته كتب الأدب. صنف "خلق الإنسان" على حروف المعجم وأشياء في فنون. ومن شعره:(@)(@@) فلا تيأس إذا ما سد باب ... فأرض الله واسعة المسالك(@)(@@) ولا تجزع إذا ما اعتاص أمر ... لعل الله يحدث بعد ذلك (¬8)(@)(@@) ذكره السيوطي.(@)(@)(@@)(@@)(@@) ||| AUTO 2278 - عبد الله بن سلام(@)(@)(@@) (¬9).(@)(@)PageV02P211(@)(@)(@@)(@@)(@@) ||| AUTO 2279 - عبد الله بن سليمان بن أشعث السجستاني الشافعي(@)(@)(@@) (¬1)، الحافظ ابن الحافظ، المتوفى سنة ست عشرة وثلاثمائة. عن ست وثمانين سنة.(@)(@@) ولد بسجستان ونشأ بنيسابور وبغداد وسمع بهما وبالحرمين ومصر والشام، عن خلق. روى عنه عبد الرحمن بن أبي حاتم والدارقطني.(@)(@)(@@)(@@)(@@) ||| AUTO 2280 - عبد الله بن سليمان بن داود بن عبد الرحمن بن سليمان بن عمر بن حوط الله الحارثي الأندي(@)(@)(@@) (¬2)، المتوفى بغرناطة في ربيع الأول سنة ثنتي عشرة وستمائة، عن ثلاث وستين [سنة]. كان فقيها، 
ms472	 أصوليا، أديبا، شاعرا، حافظا، معظما عند الملوك، بارع الخط، يكتب بيده اليسرى ويغلب عليه طريقة الظاهر. ولي قضاء إشبيلية وقرطبة ومرسية وصنف. ذكره السيوطي نقلا عن النضار.(@)(@)(@@)(@@)(@@) ||| AUTO 2281 - عبد الله بن سليمان الأندلسي القرطبي النحوي، الملقب بدرود(@)(@)(@@) (¬3)، قال السلفي: معروف بالأدب والنحو وكان أعمى شرح كتاب الكسائي وله شعر كثير. ذكره السيوطي.(@)(@)(@@)(@@)(@@) ||| AUTO 2282 - عبد الله بن شبرمة بن حسان الكوفي(@)(@)(@@) (¬4).(@)(@)(@@)(@@)(@@) ||| AUTO 2283 - عبد الله بن شقيق(@)(@)(@@) (¬5)، تابعي.(@)(@)(@@)(@@)(@@) ||| AUTO 2284 - عبد الله بن صفوان بن أمية(@)(@)(@@) (¬6)، تابعي.(@)(@)(@@)(@@)(@@) ||| AUTO 2285 - عبد الله بن طاهر بن حسين(@)(@)(@@) (¬7) [عامل خراسان من جهة المأمون. كانت ولادته سنة 182 وتأدب في صغره وقرأ العلم والفقه وولي مصر من المأمون في سنة 211 واستخلص الإسكندرية من المغاربة فوهب له المأمون خراج مصر وصعد المنبر فما نزل حتى فرق الكل PageV02P212 (@@) ولما تولى خراسان بنى هناك ابنية الخيرات وسار سيرة حسنة إلى أن توفي سنة 229 عن ثمان وأربعين بنيسابور ثم تولى ابنه طاهر].(@)(@)(@@)(@@)(@@) ||| AUTO 2286 - عبد الله بن طاهر الأبهري(@)(@)(@@) .(@)(@)(@@)(@@)(@@) ||| AUTO 2287 - عبد الله بن طاوس بن كيسان [اليماني](@)(@)(@@) (¬1).(@)(@)(@@)(@@)(@@) ||| AUTO 2288 - عبد الله بن الطفيل [بن سخبرة الأزدي](@)(@)(@@) (¬2).(@)(@)(@@)(@@)(@@) ||| AUTO 2289 - عبد الله بن طلحة بن محمد بن عبد الله اليابري النحوي(@)(@)(@@) (¬3)، المتوفى سنة ثماني عشرة وخمسمائة.(@)(@@) قال في البلغة: أصولي فقيه روى عن أبي الوليد الباجي وقرأ عليه الزمخشري بمكة "كتاب سيبويه" و"شرح رسالة ابن أبي زيد" ورد على ابن حزم. ذكره السيوطي.(@)(@)(@@)(@@)(@@) ||| AUTO 2290 - عبد الله بن طورسون فيضي(@)(@)(@@) .(@)(@)(@@)(@@)(@@) ||| AUTO 2291 - عبد الله بن طيب أبو الفرج(@)(@)(@@) (¬4).(@)(@)(@@)(@@)(@@) ||| AUTO 2292 - عبد الله بن عامر الدمشقي القاري [اليحصبي، أبو عمران(@)(@)(@@) (¬5)، أحد القراء السبعة، توفي بدمشق يوم عاشوراء سنة ثمان عشرة ومائة].(@)(@)(@@)(@@)(@@) ||| AUTO 2293 - عبد الله بن عامر [بن كريز الأموي](@)(@)(@@) (¬6) والي خراسان.(@)(@)(@@)(@@)(@@) ||| AUTO 2294 - عبد الله بن عباس بن عبد المطلب [الهاشمي القرشي](@)(@)(@@) (¬7).(@)(@)PageV02P213(@)(@)(@@)(@@)(@@) ||| AUTO 2295 - عبد الله بن عبد الله بن جابر(@)(@)(@@) .(@)(@)(@@)(@@)(@@) ||| AUTO 2296 - عبد الله بن عبد الله(@)(@)(@@) (¬1) بن زهر ابن أبي مليكة (¬2).(@)(@)(@@)(@@)(@@) ||| AUTO 2297 - عبد 
ms473	 الله بن عبد الله الترجمان(@)(@)(@@) (¬3)، صاحب "تحفة الأريب [في الرد على أهل الصليب] ".(@)(@)(@@)(@@)(@@) ||| AUTO 2298 - عبد الله بن عبد الله بن عثمان ابن أبي بكر الصديق(@)(@)(@@) (¬4).(@)(@)(@@)(@@)(@@) ||| AUTO 2299 - عبد الله بن عبد الله بن أبي [بن مالك الأنصاري الخزرجي](@)(@)(@@) (¬5).(@)(@)(@@)(@@)(@@) ||| AUTO 2300 - عبد الله بن عبد الله بن عمر [بن الخطاب القرشي العدوي](@)(@)(@@) (¬6).(@)(@)(@@)(@@)(@@) ||| AUTO 2301 - عبد الله بن عبد الأسد أبو سلمة [القرشي المخزومي](@)(@)(@@) (¬7).(@)(@)(@@)(@@)(@@) ||| AUTO 2302 - الشيخ جمال الدين أبو المحاسن عبد الله بن عبد الحق بن أوحد الدين الخطيب الحنفي(@)(@)(@@) (¬8)، ذكر في "الغرف العلية" أنه صار خطيبا بعينتاب وتل ناصر وأن له شرحا على "ملحة الإعراب" وفرغ من تأليفه في رمضان سنة خمس وثلاثين وسبعمائة. ذكره تقي الدين.(@)(@)(@@)(@@)(@@) ||| AUTO 2303 - عبد الله بن عبد الحكم المالكي(@)(@)(@@) (¬9).(@)(@)PageV02P214(@)(@)(@@)(@@)(@@) ||| AUTO 2304 - القاضي بهاء الدين عبد الله بن عبد الرحمن بن عبد الله بن محمد بن محمد بن عقيل القرشي الهاشمي العقيلي الهمداني الأصل ثم المصري الشافعي النحوي(@)(@)(@@) (¬1)، المتوفى بالقاهرة في 23 ربيع الأول سنة تسع وستين وسبعمائة، عن إحدى وسبعين سنة.(@)(@@) قرأ على التقي الصايغ ولازم العلاء القونوي وبه تخرج وانتفع، ثم لازم الجلال القزويني وأبا حيان وتفنن وسمع من الحجار. ناب في الحكم ثم ولي القضاء بعد ابن جماعة ثمانين يوما ودرس بالقطبية والخشابية والجامع الناصري والطولوني. وكان إماما في العربية والبيان وصنف التفسير إلى أواخر آل عمران وله "مختصر الشرح الكبير" و"الجامع النفيس" في الفقه، جامع للخلاف والأوهام الواقعة للنووي وابن الرفعة مبسوط [جدا] لم يتم، و"المساعد في شرح التسهيل". ذكره السيوطي.(@)(@)(@@)(@@)(@@) ||| AUTO 2305 - عبد الله بن عبد الرحمن بن عبد اللطيف السيد أصيل الدين الحسيني(@)(@)(@@) (¬2).(@)(@)(@@)(@@)(@@) ||| AUTO 2306 - عبد الله بن عبد الرحمن بن عوف(@)(@)(@@) (¬3)، أحد الفقهاء السبعة.(@)(@)(@@)(@@)(@@) ||| AUTO 2307 - الشيخ الحافظ أبو محمد عبد الله بن عبد الرحمن بن الفضل بن بهرام الدارمي السمرقندي(@)(@)(@@) (¬4)، مصنف "المسند"، المتوفى بها سنة خمس وخمسين ومائتين ودفن تجاه المدرسة الجوزجانية وله أربع وسبعون سنة.(@)(@)(@@)(@@)(@@) ||| AUTO 2308 - عبد الله بن عبد الظاهر بن نشوان [محي 
ms474	 الدين](@)(@)(@@) (¬5).(@)(@)(@@)(@@)(@@) ||| AUTO 2309 - أبو عبيد عبد الله بن عبد العزيز بن محمد البكري الأندلسي الشلطشي(@)(@)(@@) (¬6)، نزيل قرطبة، المتوفى في شوال سنة سبع وثمانين وأربعمائة.(@)(@@) كان إماما، لغويا، أخباريا، متفننا، صنف "شرح نوادر القالي" و"معجم ما استعجم من البلاد [والمواضع] " و"إشتقاق الأسماء". ومن مؤلفاته "فصل المقال في شرح كتاب الأمثال" لأبي عبيد وكتاب "مسالك الممالك".(@)(@)PageV02P215(@)(@)(@@) وشلطيش: بلدة بالقرب من شلب وكانت لأبيه، فأخذها منه المعتضد بن عباد. ذكره السيوطي وقال: كان لا يصحو من الخمر أبدا.(@)(@)(@@)(@@)(@@) ||| AUTO 2310 - عبد الله بن عبد الغفار غزالي زاده(@)(@)(@@) .(@)(@)(@@)(@@)(@@) ||| AUTO 2311 - الشيخ أبو محمد عبد الله بن عبد الملك بن عبد الله القرشي البكري القرطبي المرجاني(@)(@)(@@) (¬1)، المتوفى سنة ....(@)(@@) صنف "بهجة النفوس والأسرار في تاريخ هجرة المختار".(@)(@)(@@)(@@)(@@) ||| AUTO 2312 - الإمام أبو سعد عبد الله بن عبد الكريم بن هوازن القشيري الشافعي(@)(@)(@@) (¬2)، المتوفى سنة سبع وسبعين وأربعمائة، عن ثلاث وستين سنة.(@)(@@) تفقه وبرع في الأصول وكان إماما كبيرا، له حظ من التصوف. أصوليا نحويا، قدم بغداد مع والده، فسمع من القاضي أبي الطيب. وكان والده يعامله معاملة الأقران. روى عنه ابن أخيه عبد الغافر الفارسي ومات قبل أمه فاطمة بنت الدقاق. ذكره السبكي.(@)(@)(@@)(@@)(@@) ||| AUTO 2313 - عبد الله بن عبد المؤمن ابن الوجيه الواسطي(@)(@)(@@) (¬3).(@)(@)(@@)(@@)(@@) ||| AUTO 2314 - عبد الله بن عبدان [الهمذاني](@)(@)(@@) (¬4).(@)(@)(@@)(@@)(@@) ||| AUTO 2315 - عبد الله بن عتبة بن مسعود، التابعي(@)(@)(@@) (¬5)(@)(@)(@@)(@@)(@@) ||| AUTO 2316 - عبد الله بن عتيك الأنصاري(@)(@)(@@) (¬6).(@)(@)(@@)(@@)(@@) ||| AUTO 2317 - عبد الله بن عثمان بن عامر بن كعب أبو بكر الصديق -رضي الله عنه-(@)(@)(@@) (¬7).(@)(@)PageV02P216(@)(@)(@@)(@@)(@@) ||| AUTO 2318 - عبد الله بن عدي [بن عبد الله بن محمد](@)(@)(@@) (¬1) أبو أحمد الجرجاني (¬2).(@)(@)(@@)(@@)(@@) ||| AUTO 2319 - عبد الله بن عروة بن زبير(@)(@)(@@) (¬3).(@)(@)(@@)(@@)(@@) ||| AUTO 2320 - عبد الله بن عصام المقدسي(@)(@)(@@) .(@)(@)(@@)(@@)(@@) ||| AUTO 2321 - عبد الله بن علي بن أحمد المستكفي بالله(@)(@)(@@) (¬4) [من الدولة العباسية، وأمه أم ولد تسمى فضة وقيل أملح الناس، بويع بعد ما كحل المتقي بسعي توزون ولما استولى معز الدولة بن بويه على أهواز خرج توزون وكان المستكفي فوض إليه تدبير الملك فكان بينهما حروب 
ms475	 كثيرة، ثم مات توزون ولقب المستكفي نفسه إمام الحق ودخل معز الدولة بغداد وهو أول من ملكها من الديلم بإذن المستكفي غصبا عليه ودام أشهر ثم وقعت الوحشة بينهما لأنه بلغه أن المستكفي قد دبر على هلاكه فدخل عليه بحواشيه وقبل يده فطرح له كرسيا فجلس عليه ثم قدم إليه رجلان من الديلم ومدا يديهما إلى المستكفي فظن أنهما يريدان تقبيل يده فمدهما فجذباه من السرير وجعلا عمامته في عنقه ثم سحب واعتقل ثم خلع وسملت عيناه. فأجتمع ببغداد ثلاثة من الخلفاء عميان وانتهت دار الخلافة حتى لم يبق فيها شيء ومضى المعز إلى منزله وساقوا المستكفي ماشيا إليه وذلك لثمان بقين من جمادى الآخرة سنة 334 وكانت خلافته سنة وأربعة أشهر، ثم توفي سنة 343 وهو ابن ستة وأربعين].(@)(@)(@@)(@@)(@@) ||| AUTO 2322 - عبد الله بن علي بن أحمد بن عبد الله سبط الخياط(@)(@)(@@) (¬5).(@)(@)PageV02P217(@)(@)(@@)(@@)(@@) ||| CHECK 2329 - تاج الدين أبو عبد الله عبد الله بن علي بن عمر السنجاري، المعروف بابن قاضي صور الحنفي، ثم الدمشقي(@)(@)(@@)(@@)(@@) ||| AUTO 2323 - أبو محمد عبد الله بن علي بن إسحق الصيمري النحوي(@)(@)(@@) (¬1)، صاحب "التبصرة" في النحو وهو كتاب جليل أكثر ما يشتغل به أهل المغرب، وأكثر أبو حيان من النقل عنه. ذكره السيوطي.(@)(@)(@@)(@@)(@@) ||| AUTO 2324 - عبد الله بن علي بن شكر [الشيبي الدميري] الوزير(@)(@)(@@) (¬2).(@)(@)(@@)(@@)(@@) ||| AUTO 2325 - عبد الله بن علي بن صائن بن عبد الجليل الفرغاني(@)(@)(@@) (¬3).(@)(@)(@@)(@@)(@@) ||| AUTO 2326 - عبد الله بن علي بن عبد الله الرشاطي(@)(@)(@@) (¬4).(@)(@)(@@)(@@)(@@) ||| AUTO 2327 - عبد الله بن علي بن عبد الله بن حمزة أبو عبد الرحمن اللهبي القارئ(@)(@)(@@) (¬5).(@)(@)(@@)(@@)(@@) ||| AUTO 2328 - جمال الدين عبد الله بن علي بن عثمان بن إبراهيم بن مصطفى بن سليمان المارديني ابن التركماني الحنفي(@)(@)(@@) (¬6)، المتوفى في شعبان سنة تسع وستين وسبعمائة وله إحدى وخمسون سنة. اشتغل ومهر في الفقه وكمل شرح والده على "الهداية" واستقر في القضاء بمصر استقلالا بعد موت والده سنة 750 واستمر إلى وفاته، مع التواضع للطلبة والفقراء والترفع على الأغنياء، [وكان] وافر الوقار، مقدما 
ms476	 عند الملوك وقد بالغ المقريزي في الثناء عليه ولم يخلف بعده مثله. ذكره تقي الدين.(@)(@@) 2329 - تاج الدين أبو عبد الله (¬7) عبد الله بن علي بن عمر السنجاري، المعروف بابن قاضي صور (¬8) الحنفي، ثم الدمشقي (¬9)، المتوفى بدمشق في ربيع الأول سنة تسع وتسعين PageV02P218 (@@) وسبعمائة، عن سبع وسبعين سنة.(@)(@@) ولد بسجستان وتفقه على ابن عينون عز الدين حسن وغيره ونظم "المختار من ربيع الأبرار" و"السراجية"، وله "كتاب البحر الجاري" في الفتاوى جمع فيه بين المذاهب الأربعة وأقوال جمع من الصحابة و"نظم سلوان المطاع" وله "قصيدة في مكارم الأخلاق".(@)(@@) قال ابن أبي شريف: قدم دمشق ودرس بالماردانية وصحب البرهان بن جماعة واشتغل بإربل وماردين والموصل.(@)(@@) وصور: بلدة بين حصن كيفا وماردين. انتهى.(@)(@)(@@)(@@)(@@) ||| AUTO 2330 - عبد الله بن علي بن المنجد بن ماجد تقي السروجي(@)(@)(@@) (¬1).(@)(@)(@@)(@@)(@@) ||| AUTO 2331 - عبد الله بن علي أبو نصر السراج(@)(@)(@@) (¬2)، صاحب "اللمع".(@)(@)(@@)(@@)(@@) ||| AUTO 2332 - عبد الله بن عمر بن الخطاب -رضي الله عنه-(@)(@)(@@) (¬3).(@)(@)(@@)(@@)(@@) ||| AUTO 2333 - عبد الله بن عمر بن محمد بن حمويه(@)(@)(@@) (¬4).(@)(@)(@@)(@@)(@@) ||| AUTO 2334 - ناصر الدين أبو الخير عبد الله بن عمر بن محمد بن علي، المعروف بالقاضي البيضاوي الشافعي(@)(@)(@@) (¬5)، المتوفى بتبريز في سنة إحدى وتسعين وستمائة وقيل سنة خمس وثمانين وستمائة.(@)(@@) كان إماما، محققا، علامة، جمع بين المنقول والمعقول، مبرزا نظارا، له مصنفات معتبرة، منها "الطوالع" في الكلام و"المنهاج" في الأصول و"المصباح" في الكلام أيضا و"أنوار التنزيل" في التفسير و"الغاية القصوى" وهو مختصر "الوسيط" في الفروع وشرح " المصابيح" وشرح "مختصر ابن الحاجب" و"مختصر الكافية" وشرحه. وذكر الكتبي من PageV02P219 (@@) مصنفاته "شرح المحصول" و"شرح المنتخب" للإمام و"الإيضاح" في أصول الدين و"شرح التنبيه" في أربع مجلدات و"تهذيب الأخلاق" و"كتاب في المنطق" و"نظام التواريخ " وهو مقدمة فارسية.(@)(@)(@@)(@@)(@@) ||| AUTO 2335 - عبد الله بن عمرو بن العاص(@)(@)(@@) (¬1).(@)(@)(@@)(@@)(@@) ||| AUTO 2336 - عبد الله بن عون بن أرطبان [المزني البصري أبو عون](@)(@)(@@) (¬2)(@)(@)(@@)(@@)(@@) ||| AUTO 2337 - عبد الله بن عياش(@)(@)(@@) .(@)(@)(@@)(@@)(@@) ||| AUTO 2338 - عبد الله بن عيسى ابن بختويه(@)(@)(@@) (¬3).(@)(@)(@@)(@@)(@@) ||| AUTO 2339 - الشيخ الزاهد القدوة أبو محمد عبد ألله بن غانم 
ms477	 بن علي بن إبراهيم النابلسي(@)(@)(@@) (¬4)، المتوفى بها في شعبان سنة اثنتين وسبعين وستمائة.(@)(@@) سمع بدمشق من الضياء المقدسي وكان شيخ الأرض المقدسة في وقته، وله أشعار كثيرة ومصنف في "شرح حال الأولياء" ومصنف على أسلوبه في "إشارات الطيور والأزهار" لطيف. ذكره ابن أبي شريف.(@)(@)(@@)(@@)(@@) ||| AUTO 2340 - عبد الله بن فرخ بن عسال الخراساني الحنفي(@)(@)(@@) (¬5)، المتوفى بمصر سنة خمس وسبعين ومائة وله ستون سنة.(@)(@@) تفقه على أبي حنيفة وحمل عنه المسائل، ثم دخل مصر وحدث وكان الناس يتبركون به ويجلسون له على طريقه ليدعو لهم. وكان يقول بشرب النبيذ وتحليله ويروي أحاديث في ذلك، حج ومات بعد انصرافه. روى له أبو داود ونقل توثيقه عن ابن حبان. ذكره تقي الدين.(@)(@)PageV02P220(@)(@)(@@)(@@)(@@) ||| AUTO 2341 - عبد الله بن فراق(@)(@)(@@) .(@)(@)(@@)(@@)(@@) ||| AUTO 2342 - شهاب الدين عبد الله بن فضل الله بن أبي نعيم الشيرازي الوصاف(@)(@)(@@) (¬1)، ألف كتابه لغازان محمود وفرغ في شعبان سنة 711 وذكر في 3 مجلدات أن والده فضل الله مات في ذي القعدة سنة 698 وهو مؤلف "المعجم في أخبار ملوك العجم" ألفه سنة 654 (¬2).(@)(@)(@@)(@@)(@@) ||| AUTO 2343 - عبد الله بن قاسم بن المظفر المرتضى [بن علي الشهرزوري، المنعوت](@)(@)(@@) (¬3).(@)(@)(@@)(@@)(@@) ||| AUTO 2344 - عبد الله بن قرط الأزدي [الثمالي](@)(@)(@@) (¬4).(@)(@)(@@)(@@)(@@) ||| AUTO 2345 - عبد الله بن قيس أبو موسى الأشعري(@)(@)(@@) (¬5).(@)(@)(@@)(@@)(@@) ||| AUTO 2346 - عبد الله بن كثير بن عمرو القارئ(@)(@)(@@) (¬6) [أحد القراء السبعة، الداري المكي، سمع عبد الله ابن الزبير بن العوام ومحمد بن قيس بن مخرمة وأبا المنهال عبد الرحمن بن مطعم المكي ومجاهدا، وروى عنه ابن جريج وابن أبي نجيح وشبل بن أبي عباد، كان ثقة وله أحاديث صالحة توفي بمكة سنة ثنتين وعشرين ومائة].(@)(@)(@@)(@@)(@@) ||| AUTO 2347 - عبد الله بن كيسان(@)(@)(@@) .(@)(@)(@@)(@@)(@@) ||| AUTO 2348 - المولى الفاضل عبد الله بن لطف الله بن محمد بن بهاء الدين(@)(@)(@@) (¬7)، المتوفى بقسطنطينية سنة [996]. اشتغل وحصل وصار ملازما للمولى أبي السعود وكان له به عناية ودرس بعدة مدارس، منها الثمان والسليمانية، ثم تولى قضاء غلطه ثم بروسة، ثم إستانبول ثم قضاء العسكر بأناطولي 
ms478	 وأقام يسيرا، ثم عزل. وله "حاشية على شرح المفتاح" وبعض الحواشي والرسائل. ذكره تقي الدين.(@)(@)PageV02P221(@)(@)(@@)(@@)(@@) ||| AUTO 2349 - فخر المجاهدين الإمام أبو عبد الرحمن قدوة الزاهدين عبد الله بن المبارك بن واضح الحنظلي مولاهم التركي الأب الخوارزمي الأم الحنفي(@)(@)(@@) (¬1)، المتوفى بهيت في رمضان سنة إحدى وثمانين ومائة وله اثنان وستون سنة.(@)(@@) وأفنى عمره في الأسفار حاجا ومجاهدا وتاجرا. سمع عاصما الأحول وحميد الطويل وأمما سواهم ودون العلم في الأبواب وفي الغزو والرقائق، وعنه خلق لا يحصون منهم عبد الرحمن بن مهدي ويحى بن معين وأبو بكر بن أبي شيبة وأحمد بن حنبل وغيرهم وعن ابن معين.(@)(@@) كان ثقة ثبتا وكانت كتبه التي حدث بها نحوا من عشرين ألف حديث، جمع الحديث والفقه والعربية وأيام الناس والشجاعة والشعر والفصاحة والزهد والعبادة. وكان من صيانة العلم وعدم ابتذاله لأرباب الدول على جانب عظيم، ورواياته في الفقه عن أبي حنيفة كثيرة جدا، وكان أبوه عبدا صالحا لقاضي مرو. ذكره الغزالي في "سير الملوك". ولما مات وسمع موته الرشيد جلس للعزاء وأمر الأعيان أن يعزوه فيه وعد ذلك من محاسنه، روح الله روحه ونفعنا ببركاته.(@)(@)(@@)(@@)(@@) ||| AUTO 2350 - الحافظ أبو بكر عبد الله بن محمد بن إبراهيم أبن أبي شيبة العبسي مولاهم الكوفي(@)(@)(@@) (¬2)، صاحب التصانيف، منها "المسند"، المتوفى سنة خمس وثلاثين ومائتين. روى عن ابن المبارك ووكيع ويزيد بن هرون. وعنه البخاري ومسلم وأبو داود وابن ماجه.(@)(@@) قال أحمد بن حنبل: صدوق. ووثقه أبو حاتم وكان حافظا متقنا.(@)(@)(@@)(@@)(@@) ||| AUTO 2351 - شرف الدين [الواني] أبو محمد عبد الله بن محمد بن إبراهيم بن محمد الفقيه المحدث الحنفي(@)(@)(@@) (¬3)، المتوفى سنة تسع وأربعين وسبعمائة.(@)(@@) سمع القاسم ابن عساكر وغيره وأكثر وكان [فصيح القراءة سريعها]، حاد الذهن بالقاهرة جمع "أربعين بلدانية" وكان فاضلا. ذكره تقي الدين.(@)(@)PageV02P222(@)(@)(@@)(@@)(@@) ||| AUTO 2352 - صلاح الدين عبد الله بن محمد بن إبراهيم بن غنايم، ابن المهندس الحنفي(@)(@)(@@) (1)، المتوفى في محرم سنة تسع وستين وسبعمائة وله ثمان وسبعون سنة.(@)(@@) سمع من أحمد بن عبد المنعم وحدث بالكثير 
ms479	 وتفرد وسمع منه [لحافظ] أبو الفضل وخرج له والده "أربعين حديثا" من عواليه وحج مرارا على قدميه من مصر ودمشق وحفظ " المختار" وجمع "تاريخا" كبيرا لفقهاء الحنفية وطالع عليه كتبا كثيرة ببلاد متفرقة وسمع بالقاهرة قليلا. ذكره تقي الدين.(@)(@)(@@)(@@)(@@) ||| AUTO 2353 - عبد الله بن محمد بن أحمد بن خالد، ابن القيسراني(@)(@)(@@) (¬2).(@)(@)(@@)(@@)(@@) ||| AUTO 2354 - أبو القاسم عبد الله بن محمد بن أحمد بن محمد العكبري الأديب الشافعي، [المعروف بابن المعلم](@)(@)(@@) (¬3)، المتوفى سنة ست عشرة وخمسمائة.(@)(@@) تفقه على الشيخ أبي إسحق وسمع الحديث وصنف "الانتصار لحمزة الزيات" فيما نسبه إليه ابن قتيبة في "مشكل القرآن". ذكره السبكي.(@)(@)(@@)(@@)(@@) ||| AUTO 2355 - أبو العباس عبد الله بن محمد بن جعفر بن محمد بن هرون، الشهير بابن المعتز العباسي(@)(@)(@@) (¬4)، المتوفى في ربيع الآخر سنة ست وتسعين ومائتين، وله ثمان وأربعون سنة.(@)(@@) أخذ الأدب والعربية عن المبرد وثعلمب، فمهر وصار أشعر بني العباس، بل أشعر الناس، في الأوصاف والتشبيهات. وكان من محاسن الزمان وهو أول من صنف في صنعة الشعر وصنع "كتاب البديع".(@)(@)(@@)(@@)(@@) ||| AUTO 2356 - أبو محمد عبد الله بن محمد بن حرب [بن خطاب] الخطابي اللغوي(@)(@)(@@) (¬5)، من نحاة الكوفة، شاعر، صنف "النحو الكبير" و" [النحو] الصغير" و"المكتم في النحو" و"عمود النحو". ذكره السيوطي.(@)(@)PageV02P223(@)(@)(@@)(@@)(@@) ||| AUTO 2357 - الشيخ أبو القاسم عبد الله بن محمد بن حسين بن داود بن باقيا بن محمد بن يعقوب الحلبي الحنفي، المعروف بالبندار، الشاعر الأديب(@)(@)(@@) (¬1)، المتوفى بحلب في محرم سنة 485 خمس وثمانين وأربعمائة، عن خمس وسبعين سنة.(@)(@@) كان فاضلا له خط حسن ومصنفات، منها: "الجمان في مشتبهات القرآن" و"ملح الكتاب" وجمع شعره في ديوان كبير وله مقامات أدبية وكان ظريفا من محاسن الناس إلا أنه كان مطعونا عليه في دينه وعقيدته، كثير الهذل والمجون، . وله "شرح الفصيح ".(@)(@)(@@)(@@)(@@) ||| AUTO 2358 - الإمام الحافظ أبو بكر عبد الله بن محمد بن زياد النيسابوري الشافعي(@)(@)(@@) (¬2)، المتوفى في ربيع الآخر سنة أربع وعشرين وثلاثمائة، عن إحدى وأربعين سنة.(@)(@@) روى عن المزني والزعفراني وأبي زرعة الرازي وعنه ابن 
ms480	 عقدة والدارقطني وخلق.(@)(@@) قال الحاكم: كان إمام عصره من الشافعية بالعراق ومن أحفظ الناس للفقهيات وجمع بين الفقه والحديث وله "زيادات كتاب المزني". ذكره السبكي.(@)(@)(@@)(@@)(@@) ||| AUTO 2359 - أبو الحسن عبد الله بن محمد بن سفيان الخراز النحوي(@)(@)(@@) (¬3)، المتوفى سنة خمس وعشرين وثلاثمائة. أخذ عن ثعلب والمبرد وخلط المذهبين وكان معلما في دار الوزير ابن الجراح، صنف "المختصر" في النحو و"المقصور والممدود" و"معاني القرآن" و"المذكر والمؤنث" وغير ذلك. ذكره السيوطي.(@)(@)(@@)(@@)(@@) ||| AUTO 2360 - أبو محمد عبد الله بن محمد بن سيد البطليوسي(@)(@)(@@) ، المعروف بابن السيد (¬4)، -بكسر السين- نزيل بلنسية، المتوفى في رجب سنة إحدى وعشرين وخمسمائة، عن سبع وستين سنة.(@)(@@) كان لغويا، أديبا، متبحرا، فهيما وله يد في العلوم القديمة، انتصب لإقراء النحو واجتمع إليه الناس. ذكره [الفتح بن خاقان] في "قلائد العقيان" وبالغ في وصفه. صنف "شرح أدب الكاتب" و"شرح الموطأ" و"شرح سقط الزند" و"شرح ديوان المتنبي " و"إصلاح الخلل الواقع في الجمل" و"الحلل في شرح أبيات الجمل" و"المثلث" و"المسائل المنثورة". ذكره السيوطي.(@)(@)PageV02P224(@)(@)(@@)(@@)(@@) ||| AUTO 2361 - عبد الله بن محمد بن شاهاور نجم داية أبن أنوشروان بن أبي نجيب الرازي الحافظ](@)(@)(@@) (¬1).(@)(@)(@@)(@@)(@@) ||| AUTO 2362 - عبد الله [بن نجم] بن محمد بن شاس [الجذامي السعدي المصري] المالكي(@)(@)(@@) (¬2).(@)(@)(@@)(@@)(@@) ||| AUTO 2363 - عبد الله بن محمد بن صارة الشنتري [أبو محمد البكري](@)(@)(@@) (¬3).(@)(@)(@@)(@@)(@@) ||| AUTO 2364 - عبد الله بن محمد بن عبد الله بن أحمد المقتدي بالله(@)(@)(@@) (¬4).(@)(@)(@@)(@@)(@@) ||| AUTO 2365 - عبد الله بن محمد بن عبد الله بن مظفر ابن أبي عصرون(@)(@)(@@) (¬5).(@)(@)(@@)(@@)(@@) ||| AUTO 2366 - أبو محمد عبد الله بن محمد بن عبد الرحمن بن أحمد بن عبد الله ابن اللبان الأصفهاني المقرئ الشافعي(@)(@)(@@) (¬6)، المتوفى بأصبهان في جمادى الآخرة سنة ست وأربعين وأربعمائة، عن .. سمع بأصبهان وبغداد ومكة وتفقه على الشيخ أبي حامد وحدث. سمع منه الخطيب وكان من أحسن الناس تلاوة للقرآن، مناظرا، حسن الأخلاق، زاهدا، صنف كتبا. ذكره السبكي.(@)(@)(@@)(@@)(@@) ||| AUTO 2367 - عبد الله بن محمد بن عبد الرحمن الرازي(@)(@)(@@) .(@)(@)(@@)(@@)(@@) ||| AUTO 2368 - عبد الله بن محمد بن عبد الرحمن بن أبي بكر 