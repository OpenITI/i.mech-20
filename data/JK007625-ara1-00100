ms81	 أم يوم نائل % % وأنت وهبت الغانمين به الخمسا % % 24(@)(@@) % وقد طاب ريانا على طبرية % % فيا طيبها ريا ويا حسنها مرسى % % PageV01P321 البحر : - 1(@)(@@) % عفا الله عنكم عن ذوي الشوق نفسوا % % فقد تلفت منا قلوب وأنفس % % 2(@)(@@) % ألم تعلموا أني من الشوق موسر % % ألم تعلموا أني من الصبر مفلس % % 3(@)(@@) % ظننتم بعيني أنها تألف الكرى % % فهلا بعثتم طيفكم يتجسس % % 4(@)(@@) % عذاب فيكم عذب % % وقتلي لكم حل % % 5(@)(@@) % وهذا الدمع قد أعرب % % عن شوقي فاستملوا % % 6(@)(@@) % وهذا الدين قد حل % % فلم ذا الوعد والمطل % % 7(@)(@@) % أعيذوني من الهجر % % فهجرانكم قتل % % 8(@)(@@) % هبوا لي لقية منكم % % فبالأرواح ما تغلو % % 9(@)(@@) % وإن شئتم على قلبي % % وسلوانكم دلوا % % 10(@)(@@) % لفقد الملك العادل % % يبكي الملك والعدل % % PageV01P322 11(@)(@@) % فأين الكرم العد % % وأين النائل الجزل % % 12(@)(@@) % وقد أظلمت الآفاق % % لا شمس ولا ظل % % 13(@)(@@) % ولما غاب نور الدين % % عنا أظلم الحفل % % 14(@)(@@) % وزال الخصب والخير % % وزاد الشر والمحل % % 15(@)(@@) % ومات البأس والجود % % وعاش اليأس والبخل % % 16(@)(@@) % وعز النقص لما هان % % أهل الفضل والفضل % % 17(@)(@@) % وهل ينفق ذو العلم % % إذا ما نفق الجهل % % 18(@)(@@) % وإن الجد لا يسمن % % حتى يسمن الهزل % % 19(@)(@@) % ومذ فارق أهل الخير % % ماضم له شمل % % 20(@)(@@) % وكاد الدين ينحط % % وكاد الكفر أن يعلو % % PageV01P323 21(@)(@@) % على قلبي من الأيام % % في خفتها ثقل % % 22(@)(@@) % وقد حط على الكره % % من الهم به رحل % % 23(@)(@@) % ومن صلتبه في الدهر % % أضحى وهو لي صل % % 24(@)(@@) % تولى دوني الدون % % وأبقى العز لي عزل % % 25(@)(@@) % وأولى بي من الحلية % % ما بينهم العطل % % 26(@)(@@) % وماذا ينفع الأعين % % من بعد العمى كحل % % 27(@)(@@) % ولولا الملك الصالح % % ماشدوا ولا حلوا % % 28(@)(@@) % ولما أن زكا النجر % % زكا في الكرم النجل % % 29(@)(@@) % وجاء الفرع بالمقصود % % لما ذهب الأصل % % 30(@)(@@) % وجود البعض كما لكل % % إذا ما فقد الكل % % PageV01P324 31(@)(@@) % وليث الغاب إن غاب % % حمى موضعه الشبل % % 32(@)(@@) % وما كان لنور الدين % % ولا نجله مثل % % 33(@)(@@) % توكلت على الله % % إذا ضافت بي السبل % % 34(@)(@@) % وعلقت بحبل الله % % كفي فهو الحبل 
ms82	 % % PageV01P325 البحر : كامل تام 1(@)(@@) % عذر الزمان بأي وجه يقبل % % ومحبكم بالصد فيه ويقتل % % 2(@)(@@) % مالي سوى إنسان عيني مسعدا % % بالدمع إنسان عليه أعول % % 3(@)(@@) % الدهر ليل كله في ناظري % % لاصبح إلا وجهك المتهلل % % 4(@)(@@) % خيرتم بين المنية والنوى % % لا تهجروا فالموت عندي أسهل % % 5(@)(@@) % كان منكر فضل حقي جاهلا % % إن كنت أنكر فضلكم أو أجهل % % 6(@)(@@) % يا غائبين وهم بفكري حضر % % يا راحلين وهم بقلبي نزل % % 7(@)(@@) % ما للسلو إلى فؤادي منهج % % ما للصبابة غير قلبي منهل % % 8(@)(@@) % لا تعدلوا عني فما لي معدل % % عنكم وليس سواكم لي موئل % % 9(@)(@@) % كل الخطوب دفعتها بتجلدي % % إلا التفرق فهو خطب معضل % % 10(@)(@@) % إذا لم يجدني طيفكم في زورة % % فلأنني منه أدق وأنحل % % PageV01P326 11(@)(@@) % لا صبر لي لا قلب لي لا غمض لي % % لا علم لي بالبين ماذا أفعل % % 12(@)(@@) % إن تذهلوا عني فإني ذاهل % % بهواكم عن ذكركم لا أذهل % % PageV01P327 البحر : كامل تام 1(@)(@@) % من للعلى من للذرى من للهدى % % يحميه من للبأس من للنائل % % 2(@)(@@) % طلب البقاء لملكه في آجل % % إذا لم يثق ببقاء ملك العاجل % % 3(@)(@@) % بحر أعاد البر بحرا بره % % وبسيفه فتحت بلاد الساحل % % 4(@)(@@) % من كان أهل الحق في أيامه % % وبعزه يردون أهل الباطل % % 5(@)(@@) % وفتوحه والقدس من أبكارها % % أبقت له فضلا بغير مساجل % % 6(@)(@@) % ما كنت استسقي بغيرك وابلا % % ورأيت جودك مخجلا للوابل % % 7(@)(@@) % فسقاك رضوان الإله لأنني % % لا أرتضى سقيا الغمام الهاطل % % PageV01P328 البحر : كامل تام 1(@)(@@) % قد أهدي الإثراء في الإيفاض لي % % مذ فاض لي بالرحب بحر الفاضل % % 2(@)(@@) % قد عاض لي ملقاه من فقري غنى % % ما زال صرف الدهر منه عاضلي % % 3(@)(@@) % كم من منى ظلت وعاودت الهدى % % بلقائه حتى غلبت مناضلي % % 4(@)(@@) % عاينت طود سكينة ورأيت شمس % % فضيلة ووردت بحر فواضل % % 5(@)(@@) % ولقيت سحبان البلاغة ساحبا % % ببيانه ثوب الفخار لوائل % % 6(@)(@@) % أبصرت قسا في الفصاحة معجزا % % فعرفت أني في فهاهة باقل % % 7(@)(@@) % حلف الفصاحة والحصافة والسماحة % % والحماسة والتقى والنائل % % 8(@)(@@) % بحر من الفضل الغزير خضمه 
ms83	 % % طامي العباب وماله من ساحل % % 9(@)(@@) % وجميع ما في الأرض سبعة أبحر % % وبحوره تسمى بعشر أنامل % % 10(@)(@@) % في كفه قلم يعجل جريه % % ما كان من أجل ورزق آجل % % PageV01P329 11(@)(@@) % يجري ولا جري الحسام إذا مضى % % حداه بل جري القضاء النازل % % 12(@)(@@) % نابت كتابته مناب كتيبة % % كفلت بهزم كتائب وجحافل % % 13(@)(@@) % كم جاد اسعافا لعافيه وكم % % أملي التجاح على رجاي الآمل % % 14(@)(@@) % بيراعه أبدا يراعي عالم % % في سربه ويراع سرب الجاهل % % 15(@)(@@) % فعدوه في عدوه ووليه % % في عدله يا حسن عاد عادل % % 16(@)(@@) % ريان من ماء التقى صاد إلى % % كسب المحامد وهي خير مناهل % % 17(@)(@@) % غطت فضيلته نقيصة دهرنا % % عنا وأذهب حقه بالباطل % % 18(@)(@@) % كفلت كفايته بكل فضيلة % % أكرم بكاف للفضائل كافل % % 19(@)(@@) % أكرم به من خدن إفضال وذي % % فضل لأهل الشام شاف شامل % % 20(@)(@@) % ما حل في بلد فكان محله % % إلا محل حيا بروض ماحل % % PageV01P330 21(@)(@@) % ففداء حزمك كل غاش غاشم % % وفداء فضلك كل غاف غافل % % 22(@)(@@) % يا أوحد العصر الذي بز الورى % % فضلا بغير مشاكه ومشاكل % % 23(@)(@@) % يا أفضل الفصحاء بل يا أفصح البلغاء % % منفردا بغير مساجل % % 24(@)(@@) % يا حاليا بالفضل حل تفضلا % % مني بجدك جيد خط عاطل % % 25(@)(@@) % كم ناقص إدباره قد ردني % % لكنما إقبال فضلك قابلي % % 26(@)(@@) % قد كان هذا الشام لولا أنتم % % روع المقيم به وروح الراحل % % 27(@)(@@) % كيف السبيل إلى نجاح مقاصدي % % ومحاسني وهي العيوب وسائلي % % 28(@)(@@) % ما لي وجاه الجاهلين فأغنني % % عنهم كفيتهم وجد بالجاه لي % % 29(@)(@@) % جدلي بمنتك الضعيفة منتي % % عنها وأثقل من جميلك كاهلي % % 30(@)(@@) % أرجوك معتنيا لدى السلطان بي % % كرما فمثلك يعتني بأماثلي % % PageV01P331 31(@)(@@) % توفي وليك دين مجد عاقه % % لي الوعود من الزمان الماطل % % 32(@)(@@) % قرر لي الشغل المبجل مخليا % % بالي من الهم المقيم الشاغل % % 33(@)(@@) % لا زلت غيث مكارم وبقيت غوث % % أكارم وسلمت كهف أفاضل % % PageV01P332 البحر : مجتث 1(@)(@@) % بمهجتي خنث العطف % % مستلذ الدلال % % 2(@)(@@) % يقول لي بانكسار % % ورقة واعتلال % % 3(@)(@@) % معاتبا بحديث % % أصفى من السلسال % % 4(@)(@@) % ما مصر مثل دمشق 
ms84	 % % بعت الهدى بالضلال % % 5(@)(@@) % فقلت عنت أمور % % عجيبة الأشكال % % 6(@)(@@) % أسير في طلب العز % % مثل سير الهلال % % 7(@)(@@) % لم يبلغ البدر لولا المسير % % أوج الكمال % % 8(@)(@@) % وكيف أترك شغلي % % وإنه رأس مالي % % 9(@)(@@) % صلاح حالي صلاح الدين % % الغزير النوال % % 10(@)(@@) % مالي أفارق ملكا % % ملكته آمالي % % PageV01P333 11(@)(@@) % يا ناصر الدين قلبي % % عليه في بلبال % % PageV01P334 البحر : كامل تام 1(@)(@@) % كن عاذري في حبهم لا عاذلي % % يا فارغا من شغل قلبي الشاغل % % 2(@)(@@) % هب أن سمعي للنصيحة قابل % % ما نافعي والقلب ليس بقابل % % 3(@)(@@) % أخفيت سر الوجد خيفة عذلي % % فتعرفوا من أدمعي ومخايلي % % 4(@)(@@) % لم يقبلوا عذر المحبق وقابلوا % % حق الهوى من لؤمهم بالباطل % % 5(@)(@@) % مالوا إلى وصلي فحين وصلتهم % % ملوا وليس يمل غير الواصل % % 6(@)(@@) % يا ناشدا يبغي فؤادا ضائعا % % يوم النوى إثر الخليط الزائل % % 7(@)(@@) % أين الفواد أراحل في إثرهم % % أم سائل ما بين دمع سائل % % 8(@)(@@) % وأغن أغنى طرفه في سحره % % ورضابه في سكره عن بابل % % 9(@)(@@) % من وجهه حسن وليس بمحسن % % والقد معتدل وليس بعادل % % 10(@)(@@) % متلون كمدامعي متعفف % % كضمائري متعذر كوسائلي % % PageV01P335 11(@)(@@) % أنا في الضنى كالخصر منه أشتكي % % من جائر ما يشتكي من جائل % % 12(@)(@@) % يا قلبه القاسي تعلم عطفه % % وتمايلا من عطفه المتمايل % % 13(@)(@@) % سقيا لوصل الغانيات وشربنا % % كأس الرضاب على غناء خلاخل % % 14(@)(@@) % بنواظر قد خلتهم غوافلا % % لفتورهن وهو غير غوافل % % 15(@)(@@) % وقدودهن قدود سمر رواعف % % وجفونهم جفون بيض مناصل % % 16(@)(@@) % أيام لا عهد الوفاء بحائل % % غدرا ولا أم الصفاء بحائل % % 17(@)(@@) % أعقيلة الحي اللقاح ودونها % % بيض وسمر من ظبى وذوابل % % 18(@)(@@) % بكرت تلوم على لزوم مواطن % % وضع الرفيع بها ورفع الخامل % % 19(@)(@@) % طال التردد في البلاد فلم أفز % % منها على رغم العدو بطائل % % 20(@)(@@) % أوما رأيت البحر يغرق دره % % ويخلص الأزباد نحو الساحل % % PageV01P336 21(@)(@@) % مضرية عذلت على حب الندى % % من ليس يسمع فيه عذل العاذل % % 22(@)(@@) % يا هذه لولا السماحة لم يكن % % ينميك خير عشائر وقبائل % % 23(@)(@@) % عنفت في حب السماحة مؤثرا % % عدم الكريم على 
ms85	 ثراء الباخل % % 24(@)(@@) % أوهل يخاف العدم من وجد الغنى % % من جود مولانا الإمام العادل % % 25(@)(@@) % ولقد وردت فناء بحر للندى % % أغنى به عن أنهر وجداول % % 26(@)(@@) % في كفه للجود خمسة أبحر % % فياضة تسمى بخمس أنامل % % 27(@)(@@) % ممدود ظل العدل ليس بزائل % % معمود ركن الملك ليس بمائل % % 28(@)(@@) % وعرمرم لجب كمنهال النقا % % مجر ومنهل السحاب الهامل % % 29(@)(@@) % ستر الغزالة بالعجاجة مطلعا % % زهر الأسنة في سماء قساطل % % 30(@)(@@) % فالشمس ما بين العجاج كأنها % % بدر تطلع جنح ليل لائل % % PageV01P337 31(@)(@@) % والنقع ينصل بالنصول خضابه % % فكأنه لون الشباب الناصل % % 32(@)(@@) % والمقربات بأنسر وقوائم % % تحكي قوادم أنسر وأجادل % % 33(@)(@@) % في مأزق لا يسمع الواغي به % % إلا أنين صوارم وصواهل % % 34(@)(@@) % والجيش من ملك الجيوش برأيه % % في صائب وبجأشه في صائل % % 35(@)(@@) % هزم العدا قبل اللقاء برعبه % % فغدوا بأم في الشقاوة هابل % % 36(@)(@@) % طلبوا الفرار ولم يزل متكفلا % % بهزيمة الرعديد بأس الباسل % % 37(@)(@@) % أمطوق الأعناق من إفضاله % % نعما تسامت عن سؤال السائل % % 38(@)(@@) % ماذا أقول ولا يقوم بشكر ما % % توليه من نعمى لسان القائل % % 39(@)(@@) % أو هل بلوغ مقاصدي بقصائدي % % أم هل قبول وسائلي برسائلي % % 40(@)(@@) % أم قد كفى سببا إلى درك المنى % % صدق الولاء وحسن ظن الآمل % % PageV01P338 41(@)(@@) % الفخر كل الفخر لي نظمي لكم % % مدحا تزين مشاهدي ومحافلي % % 42(@)(@@) % لكن يقول الحاسدون لم انثنى % % غريد مدحهم بجيد عاطل % % 43(@)(@@) % وإذا حظيت من الإمام برتبة % % فيها الفخار على جميع الناس لي % % 44(@)(@@) % لا زلت غيث مواهب وبقيت غوث % % ممالك وسلمت كهف أرامل % % PageV01P339 البحر : سريع 1(@)(@@) % ما يمنع الخادم من قصده الخدمة % % غير الطرق والوحل % % 2(@)(@@) % كأنما موصلكم مقطع % % ما يهتدى فيه إلى وصل % % 3(@)(@@) % وكل معروف بها منكر % % كما تراه ضيق السبل % % 4(@)(@@) % وكل من حل بها لا يرى % % في زمن الخصب سوى المحل % % 5(@)(@@) % ومذ دخلناها حصلنا بها % % كرها على خرج بلا دخل % % 6(@)(@@) % أصعب ما نلقاه من أهلها % % قول بلا أهل ولا سهل % % 7(@)(@@) % وكنت أهواها ولكنني % % لقيت منها كل ما يسلي % % 8(@)(@@) % وأنت 
ms86	 من أصبح إحسانه % % حلية هذا الزمن العطل % % 9(@)(@@) % ما كان ضرك لو وقفت لسائل % % ترك الفواد بدائه في المنزل % % 10(@)(@@) % هلا وقفت لقلب من أحرقته % % مقدار إطفاء الحريق المشعل % % PageV01P340 11(@)(@@) % إن أسر مرتحلا ففي أسر الهوى % % قلبي لديك مقيدا لم يرحل % % 12(@)(@@) % عذب العذاب لدى فؤاد المبتلى % % إذ كنت أنت معذبي والمبتلي % % PageV01P341 البحر : كامل تام 1(@)(@@) % والقدس أعضل داؤه من قبلكم % % فوفيتم بشفاء ذاك المعضل % % 2(@)(@@) % درج الملوك على تمني فتحه % % زمنا وغلتهم به لم تبلل % % 3(@)(@@) % وأتى زمانكم فأمكن آخرا % % ماقد تعذر في الزمان الأول % % 4(@)(@@) % ما كان قد ولا يكون كفتحكم % % للقدس في الماضي ولا المستقبل % % 5(@)(@@) % أوجدتم منه الذي عدم الورى % % وفعلتم في الفتح ما لم يفعل % % 6(@)(@@) % أيدي الملوك تقاصرت عن مفخر % % طلتم به فبلوا لبعض الأنمل % % 7(@)(@@) % أحييتم فرع الكرام ولم يزل % % نصر المحق بكم وقهر المبطل % % PageV01P342 البحر : كامل تام 1(@)(@@) % بالله يا ريح الشمال تحملي % % مني التحية نحو ذاك المنزل % % 2(@)(@@) % خفي على حمل السلام وخففي % % عن قلب صب بالصبابة مثقل % % 3(@)(@@) % قولي لمن شغل الفؤاد بحبه % % ويحاك إن فؤاده منه خلي % % 4(@)(@@) % حلت عقود دموعه وعقوده % % وعهوده معقودة لم تحلل % % 5(@)(@@) % سقيا لأحباب تبدل ودهم % % بعدي ولم أنقض ولم أتبدل % % 6(@)(@@) % الظاعنين وودهم مستوطن % % والراحلين وذكرهم لم يرحل % % 7(@)(@@) % لي بعدهم حال المعنى المبتلى % % حزنا وعين الساهر المتململ % % 8(@)(@@) % يا راكبا يطوي الفلا مستعجلا % % هيجت أحزاني فلا تستعجل % % 9(@)(@@) % أقفلت باب مسرتي وفتحت من % % دمعي وحزني كل باب مقفل % % 10(@)(@@) % عرج وعج نحو الحمى سقي الحمى % % أعدل فليس عن الحمى من معدل % % PageV01P343 البحر : سريع 1(@)(@@) % يا أسدا يحمي عرين العلى % % هنيت جمع الشمل بالشبل % % 2(@)(@@) % عثمان ذي النورين بين الورى % % من سؤدد سام ومن فضل % % 3(@)(@@) % يا طيب النجر بلغت المنى % % تمليا بالطاهر النجل % % 4(@)(@@) % يحكيك إقداما وبأسا فما % % أشبه هذا الفرع بالأصل % % 5(@)(@@) % فحائل الرشد على بشره % % شاهدة بالفضل والنبل % % 6(@)(@@) % ملك قضى الله له أنه % % على ملوك الأرض يستعلي % % 7(@)(@@) % بالملك 
ms87	 الناصر سلطاننا % % طالت يد الإحسان والعدل % % 8(@)(@@) % بشمله المجموع آمالنا % % بنجحها مجموعة الشمل % % PageV01P344 البحر : سريع 1(@)(@@) % احمل إلى مصر ومن يلتمس % % غناه في غربته يحمل % % 2(@)(@@) % كتابتي قد كسدت سوقها % % وحليتي بارت ولم أعضل % % PageV01P345 البحر : متقارب تام 1(@)(@@) % تحسن بأفعالك الصالحات % % ولا تعجبن بحسن جليل % % 2(@)(@@) % فحسن النساء جمال الوجوه % % وحسن الرجال وجوه الجميل % % PageV01P346 البحر : مجزوء الكامل 1(@)(@@) % قلبي العليل فكيف سوغ % % وصف طرفك بالعليل % % 2(@)(@@) % وأنا المحب المستهام % % فما لخصرك والنحول % % 3(@)(@@) % سلبت شمائلك العقول % % فما يراد من الشمول % % 4(@)(@@) % وسلاف ثغرك ليس يشفي % % غير رشفتها غليلي % % 5(@)(@@) % ولقد ظمئت فهل سبيل % % نحو ذاك السلسبيل % % PageV01P347 البحر : دو بيت 1(@)(@@) % أنتم سؤلي فلم منعتم سولي % % أنتم أملي فقربوا مأمولي % % 2(@)(@@) % مملوككم بمجده المبذول % % يستعطفكم في دمه المطلول % % PageV01P348 البحر : طويل 1(@)(@@) % قضى عمره في الهجر شوقا إلى الوصل % % وأبلاه من ذكرى الأحبة ما يبلي % % 2(@)(@@) % وكان خلي القلب من لوعة الهوى % % فأصبح من برح الصبابة في شغل % % 3(@)(@@) % وأطربه اللاحي بذكر حبيبه % % فآلى عليه أن يزيد من العذل % % 4(@)(@@) % وإن مرير العيش يحلو بذكركم % % وهل لمرير العيش غيري مستحل % % 5(@)(@@) % وصالكم الدنيا وهجركم الردى % % وقربكم عزي وبعدكم ذلي % % 6(@)(@@) % ومستحسن حفظ الوداد فراقبوا % % لأجل اقتناء الحمد عهدي لا أجلي % % 7(@)(@@) % نفى الصبر من قلب المتيم خبله % % وكيف ثبات القلب في مسكن الخبل % % 8(@)(@@) % فقلبي بين الشوق والصبر واقف % % على جدد بين الولاية والعزل % % 9(@)(@@) % إذا ما بقاء المرء كان بوصل من % % يحب فإن الهجر نوع من القتل % % 10(@)(@@) % وهل نافعي عذل ونصح على الهوى % % وعذلي يغري بي ونصحي لا يسلي % % PageV01P349 11(@)(@@) % وما كنت مفتون الفؤاد وإنما % % علي فتوني دله فاتن الدل % % 12(@)(@@) % نحولي ممن شد عقد نطاقه % % على ناحل واه من الخصر منحل % % 13(@)(@@) % إذا رام للصد القيام أبت له % % روادفه إلا القيام على وصلي % % 14(@)(@@) % وكيف تجلى في هزيع من الدجى % % وعصن تثنى فوق حقف من الرمل % % 15(@)(@@) % وناظره نشوان لامن سلافة % % سقيم بلا سقم كحيل بلا كحل % % 16(@)(@@) % وأشهد 
ms88	 أن الحسن ما خط خطه % % بعارضه والسحر ما طرفه يملي % % 17(@)(@@) % وما لحظه إلا عقار فإنني % % وجدت هوى عينيه يذهب بالعقل % % 18(@)(@@) % سقى الله بالزوراء مصر استقامتي % % لإنجازه الوعد المصون من المطل % % 19(@)(@@) % غداة نضوت الجد أبلى جديده % % ولا عيش إلا هز عطفي إلى الهزل % % 20(@)(@@) % أنادم غرا من أفاضل أهلها % % كراما وكل حلية الزمن العطل % % PageV01P350 21(@)(@@) % وإخوان صدق للصداقة بيننا % % صفاء صدور طهروها من الغل % % 22(@)(@@) % ندارس آي العقل من سورة الهوى % % ونفهم معنى العلم من صورة الجهل % % 23(@)(@@) % وها أنا قد أصبحت بالشام شائما % % سنا بارق من غير وبل ولا كل % % 24(@)(@@) % يؤهلني للبعد من كل حظوة % % ويحرمني اللذات بعدي من الأهل % % 25(@)(@@) % ولا صاحب عندي أحاول نصره % % بتخفيف ما يعروه من فادح الثقل % % 26(@)(@@) % وإني أرى عين الخصاصة ثروتي % % إذا عجزت عن سدها خلة الخل % % 27(@)(@@) % ألاين حسادي الأشداء رقبة % % لهم وأعاني الصعب بالخلق السهل % % 28(@)(@@) % وأبقي مداراة اللئيم لعله % % يبيت ولا يطوي الضمير على دغل % % 29(@)(@@) % سوى السوء لا تجدي مداراة حاسدي % % كما يستفاد السم من صلة الصل % % 30(@)(@@) % ومن نقص دهري قصد فضلي بصرفه % % ليرخص منه ما من الحق أن يغلي % % PageV01P351 31(@)(@@) % وإني من العلياء في الكنف الذي % % به حظ فضلي كلما انحط يستعلي % % 32(@)(@@) % وماذا بأرض الشام أبغي تعسفا % % ولا ناقتي فيها ترام ولا رحلي % % 33(@)(@@) % ولي حرم منه الأفاضل في حمى % % من الصون بالمعروف بالبذل في حل % % 34(@)(@@) % أبي الفضل فيه أن يكون كماله % % لغير كمال الدين أعني أبا الفضل % % 35(@)(@@) % رحيب النوادي والندى واسع الذرا % % رفيع الذرا عالي السنا وافر الظل % % 36(@)(@@) % نداه حيا المعروف قد شمل الورى % % عموما وغيث الخصب شرد بالمحل % % 37(@)(@@) % إذا خفيت سبل الكرام فإنه % % كريم المساعي بينهم واضح السبل % % 38(@)(@@) % وفي الجدب إن جادت سماه سماحة % % بدا زهر الإسعاف في الأمل العقل % % 39(@)(@@) % تساوى له الإعلان والسر في العلى % % فخلوته ملء المهابة كالحفل % % 40(@)(@@) % فتى السن ألا أن للملك قوة % % بما هو يستهديه من رأيه الكهل % % PageV01P352 41 
ms89	(@)(@@) % من القوم أما المال منهم فعرضه السماح % % وأما العرض منهم فللبخل % % 42(@)(@@) % أضاء زمان المستضيء إمامنا % % بآرائه الميموة العقد والحل % % 43(@)(@@) % فمن رأيه ما يطلع السعد من سنا % % ومن عزمه ما يطبع النصر من نصل % % 44(@)(@@) % وما روضة غناء مرهوبة الثرى % % مضوعة الأسحار طيبة الفصل % % 45(@)(@@) % شمائلها طابت وطاب شمالها % % سقتها شمولا عند مجتمع الشمل % % 46(@)(@@) % تردد أنفاس النسيم عليلة % % عليها فيشفي مرها كل معتل % % 47(@)(@@) % تهب الصبا فيها بليل بليلة % % على زهر من عبرة الطل مبتل % % 48(@)(@@) % لها من ثغور الأقحوان تبسم % % وتنظر عن أحداق نرجسها النجل % % 49(@)(@@) % كأن نعاماها تبلغ نحونا % % تحيا قرأناها على ألسن الرسل % % 50(@)(@@) % تؤرج أرجاء الرضاء كأنما % % تجامل في حمل التحية عن جمل % % PageV01P353 51(@)(@@) % مرجعة فوق الغصون حمامها % % فنون هدل بين أفنانها الهدل % % 52(@)(@@) % تنوح بها الورقاء شجوا كأنها % % مفجعة بين الحمائم بالشكل % % 53(@)(@@) % مطوقة أبلت سواد حدادها % % ففي الجيد باق منه طوق له كحلي % % 54(@)(@@) % بأحسن من أخلاقك الزهر بهجة % % وأذكى وأزكى من سجيتك الرسل % % 55(@)(@@) % إليك سرت مني مطايا مدائح % % من الشكر والإحماد موقرة الحمل % % 56(@)(@@) % سوائر في الآفاق وهي مطيفة % % ببابك دون الخلق مخلوفة العقل % % 57(@)(@@) % تهذب معناها بصقلي لفظها % % كما بان إثر المشرفي لدى الصقل % % 58(@)(@@) % وإن يجل شعري في مديحك رونقا % % وحسنا فإن الشهد من نحل النحل % % 59(@)(@@) % سلمت ولا لاقت عداك سلامة % % ورهطك في كثر وشانيك في فل % % 60(@)(@@) % ودمت ولا زالت بسطوك ديمة الوبال % % على الأعداء دائمة الوبل % % PageV01P354 61(@)(@@) % ودرت لك النعمى على كل آمل % % بقيت بقاء الذر والحرث والنسل % % PageV01P355 البحر : سريع 1(@)(@@) % لعل نجم الدين ذا الفضل % % يذكر الفاضل في شغلي % % 2(@)(@@) % إن أجل الناس قدرا فتى % % بفضله يتعب من أجلي % % 3(@)(@@) % ومثله من يعتنى بالعلى % % ويستديم الحمد من مثلي % % PageV01P356 البحر : سريع 1(@)(@@) % عند سليمان على قدره % % هدية النملة مقبوله % % 2(@)(@@) % ويصغر المملوك عن نملة % % عندك والرحمة مأموله % % 3(@)(@@) % رقي لمولانا وملكي له % % وذمتي بالشكر مشغوله % % 4(@)(@@) % وكيف يقضي الحق ذو منة % % ضعيفة بالعجز معلوله % % 5 
ms90	(@)(@@) % وإنما شيمة مولى الورى % % طاهرة بالخير مجبوله % % PageV01P357 البحر : كامل تام 1(@)(@@) % سل سيف ناظره لماذا سله % % وعلى دمي لم دله قد له % % 2(@)(@@) % واستفت كيف أباح في شرع الهوى % % دم من يهيم به وفيم أحله % % 3(@)(@@) % سل عطفه فعسى لطافة عطفه % % تعدي قساوة قلبه ولعله % % 4(@)(@@) % كثرت لقسوة قلبه جفواته % % ياما أرق وفاءه وأقله % % 5(@)(@@) % يا منجدا ناديته مستنجدا % % في خلتي والمرء ينجد خله % % 6(@)(@@) % سر حاملا سري فأنت لحمله % % أهل وخفف عن فؤادي ثقله % % 7(@)(@@) % وإذا وصلت فغض عن وادي الغضا % % طرف المريب وحي عني أهله % % 8(@)(@@) % أهد السلام هديت للرشا الذي % % أعطاه قلبي رشده فأضله % % PageV01P358 البحر : خفيف تام 1(@)(@@) % لائم للمحب غير ملائم % % هام قلبي وقلبه غير هائم % % 2(@)(@@) % لم يزل واجدا علي لأنني % % بت للوجد واجد وهو عادم % % 3(@)(@@) % أغتدي للهوى سليبا سليما % % وهو سال من الصبابة سالم % % 4(@)(@@) % ناصحي غير عالم بالذي بي % % ومن الغبن ناصح غير عالم % % 5(@)(@@) % خل ياخل في الهوى عذل صعب % % واجد من لواذع العذل واجم % % 6(@)(@@) % لا ترع بالملام من ليس يخشى % % في سبيل الغرام لومة لائم % % 7(@)(@@) % لا تظن الهوى مفارق قلبي % % فهو وصف كما علمت ملائم % % 8(@)(@@) % لفؤادي ضمانة وغرام % % أتلفاه بلا ضمين وغارم % % 9(@)(@@) % نار وجدي دخانها في شحوبي % % وفؤادي صال ووجهي ساهم % % 10(@)(@@) % قد كتمت الهوى وباح به الدمع % % فسري ما بين مفش وكاتم % % PageV01P359 11(@)(@@) % من لصب رمته مقلة رئم % % حبه من ضميره غير رائم % % 12(@)(@@) % لجفون البيض الصوارم بيض % % لم تزل في الجفون وهي صوارم % % 13(@)(@@) % وبوادي العذيب أدم ظباء % % فاتكات لحاظها بالضراغم % % 14(@)(@@) % وبنفسي ظامي الوشاح على عذب % % لماه قلبي المعذب حائم % % 15(@)(@@) % فحمى العشق آهل الربع منه % % وحمى الصبر عنه عافي المعالم % % 16(@)(@@) % ساحر طرفه وساج وإني % % لتمنيه ساهر اطرف ساجم % % 17(@)(@@) % قرب الطيف وصله وهو ناء % % وأتاني مستيقظا وهو نائم % % 18(@)(@@) % أنصفاني رأيتما قط ملظوما % % قضى نحبه على حب ظالم % % 19(@)(@@) % حبذا والحبيب في الوهل مني % % راغب والحسود بالكره راغم % % 20(@)(@@) % وسقى الله 
ms91	 عيشنا المتقضي % % ورعى الله عهدنا المتقادم % % PageV01P360 21(@)(@@) % حين عصر الصبا كحالي حال % % وهو في مرة كأحلام حالم % % 22(@)(@@) % فليالي العراق بيض من البيض % % غوان من الغواني اغونم % % 23(@)(@@) % وزماني مساعد ورفيقي % % في الهوى مسعد ودهري مسالم % % 24(@)(@@) % ومنادي المنى مجاوبه الإسعاف % % والسؤول للنجاح منادم % % 25(@)(@@) % ومن الأكرمين كل نديم % % لست من قربه مدى الدهر نادم % % 26(@)(@@) % ما فقدنا السرور إلا هدانا % % كل هاد لما بنى الهم هادم % % 27(@)(@@) % وبذاك الجناب أوطان أوطاري % % كما أنها مغاني المغانم % % 28(@)(@@) % ومراد المراد بالعرف زاه % % ومراح المراح بالعرف فاغم % % 29(@)(@@) % ومبيتي ما بين كأس وثغر % % راشفا منهما متى شئت لائم % % 30(@)(@@) % ورد خد ند وغصن قوام % % ذا جني غض وذلك ناعم % % PageV01P361 31(@)(@@) % فأنا اليوم بالشآم وحيد % % لسنا البارق العراقي شائم % % 32(@)(@@) % لا ودود على وفائي مقيم % % لا وفي بشرط ودي قائم % % 33(@)(@@) % أبدا بين همتي وزماني % % في اقتراحي وفي اطراحي ملاحم % % 34(@)(@@) % عظمت همتي وها أنا استصغر % % في المطلب العظيم العظائم % % 35(@)(@@) % مانجا من مطاعن العجز راض % % بملاه من عيشه ومطاعم % % 36(@)(@@) % مبتغى قلبي المشوق ببغداد % % وجسمي نائي المحل بجاسم % % 37(@)(@@) % ليت شعري متى يبشر عني % % أصدقائي فيها بأني قادم % % 38(@)(@@) % مالشملي بها سوى أمر مولاي % % عماد الدين المملك ناظم % % 39(@)(@@) % واحد العصر ثالث الشمس والبدر % % وثاي الحيا بغير مزاحم % % 40(@)(@@) % إن يكن مانح المراحم بالجود % % فبالبأس مانع للمحارم % % PageV01P362 41(@)(@@) % شيد المجد وهو في المهد شدت % % بتمام العلى عليه التمائم % % 42(@)(@@) % وهو بالحزم مدرك كل سؤل % % ولعمري كم حازما رام حازم % % 43(@)(@@) % نطق قس ورأي قيس وإقدام % % علي وجود كعب وحاتم % % 44(@)(@@) % وندى فرق الخزائن مقتادا % % إلى المعدم الغنى بالخزائم % % 45(@)(@@) % بشر البشر منه كل مرج % % ديمة الخير بالنجاح الدائم % % 46(@)(@@) % طلعة طلقة وباع طويل % % ويد بسطة وثغر باسم % % 47(@)(@@) % وعطايا غزر وعز أياد % % وسجايا زهر وبيض عزائم % % 48(@)(@@) % كفلت كفه بنجح الأماني % % ونشور الآمال وهي دمائم % % 49(@)(@@) % فله في التقى مآثر نزهن % % سجاياه عن جميع المآثم % % 50(@)(@@) % ما رياض فاحت لطائف أنافس % % صباها 
ms92	 لطائف ولطائم % % PageV01P363 51(@)(@@) % أظهرت سر نشرها فكأن قد % % مشت الريح بينها بالنمائم % % 52(@)(@@) % وشي أنوارها المفوف أسدى % % وأنارت فيه أكف الغمائم % % 53(@)(@@) % كقدور تعلقتها قلوب % % ذات شجو غصونها والحمائم % % 54(@)(@@) % فبشدو الغناء للورق أعراس % % وبالنوح للحمام مآتم % % 55(@)(@@) % من سجايا بني المظفر أبهى % % ومساعيهم الحسان الكرائم % % 56(@)(@@) % ما استقامت إلا بهم سنة الشرع % % ودين الهدى ودولة هاشم % % 57(@)(@@) % واستوت في خضارم الرأي فلك الملك % % منهم على مراسي المراسم % % 58(@)(@@) % أحسنوا العفو والتجاوز حتى % % مهدوا حرمة لأهل الجرائم % % 59(@)(@@) % كم بكت أعين الليالي فعادت % % وهي اليوم ضاحكات المباسم % % 60(@)(@@) % وبشمس الورى علي أبي نصر % % تجلى عنا ظلام المظالم % % PageV01P364 61(@)(@@) % ذو نوال لكل عاف معاف % % ولسقم الرجا مداو مداوم % % 62(@)(@@) % ففداكم بني المظفر عاص % % لم يطع أمره من الأمر عاصم % % 63(@)(@@) % من محاسنة المحاسن بالشر % % وما زال للمساوي مساوم % % 64(@)(@@) % كم رديء رد وساع كمين % % في سعير وجاحد في جاحم % % 65(@)(@@) % يا ابن من حكمه على الخلق طرا % % وعلى ماله مرجيه حاكم % % 66(@)(@@) % أنا راق في هضب علياك مدحا % % ولطرز الثناء بالنظم راقم % % 67(@)(@@) % غير قاص عن قاصد لك عرفا % % لفقار افتقاره هو قاصم % % 68(@)(@@) % لم يزل فائزا بصدق الأماني % % كل راج لظنه فيك راجم % % 69(@)(@@) % بالموالين قوة للموالي % % والخوافي بها نهوض القوادم % % PageV01P365 البحر : - 1(@)(@@) % بكر العارض تحدوه النعامى % % فسقيت الغيث يا دار أماما % % PageV01P366 البحر : رمل تام 1(@)(@@) % خطرت تحمل من سلمى سلاما % % فانثنى يشكر إنعام النعامى % % 2(@)(@@) % مغرم هاجت جواه نسمة % % يا لها من نسمة هاجت غراما % % 3(@)(@@) % نفحة أذكت بقلبي لفحة % % كلما هبت له زادت ضراما % % 4(@)(@@) % عاتبت سلمى سميرا أم ترى % % غازلت بالروض أنفاس الخزامى % % 5(@)(@@) % يا لأوطاري فقد أنشرها % % نشرها من بعد ما كانت رماما % % 6(@)(@@) % ذكرت ريح الصبا روح الصبا % % وزمانا كنت بل كان غلاما % % 7(@)(@@) % ونديما لي لم أندم به % % يا رعاه الله من بين الندامى % % 8(@)(@@) % ألهم الدوح التثني بثه % % شجوه بل علم النوح الحماما % % 9(@)(@@) % قال ما أطيب أيام الصبا % % قلت ما أطيبه لو 
ms93	 كان داما % % 10(@)(@@) % كان وعدا بالأماني مزنه % % كلما استسقيته عاد جهاما % % PageV01P367 11(@)(@@) % وهضيم الكشح في حبي له % % لم يزدني كاشحي إلا اهتضاما % % 12(@)(@@) % كرم العاشق منه مثلما % % لؤم العاذل فيه حين لاما % % 13(@)(@@) % بقوام علم الهز القنا % % ولحاظ تودع السكر المداما % % 14(@)(@@) % أتراه إذ تنثى ورنا % % سمهريا أم سل حساما % % 15(@)(@@) % خده يجرحه لحظ الورى % % فلذا عارضه يلبس لاما % % 16(@)(@@) % ويريك الخط منه دائرا % % هالة البدر إذا حط اللثاما % % 17(@)(@@) % وكثيب الرمل قد أخجله % % وقضيب البان ردفا وقواما % % 18(@)(@@) % أنا منه ومن العذال في % % نصيب أشكو ملالا وملاما % % 19(@)(@@) % لم تكن تلك وقد لاحظنني % % لحظات إنما كانت سهاما % % 20(@)(@@) % تركت في غمرات مهجتي % % غمرات ملكت منها الزماما % % PageV01P368 21(@)(@@) % مهجة أرخصها سوم الهوى % % وتسامى عزة من أن تساما % % 22(@)(@@) % ومقامي بعد توديعهم % % بالحمى ما خلته إلا حماما % % 23(@)(@@) % عدم الإصباح ليلي بعدكم % % أسفروا لي مرة تجلو الظلاما % % 24(@)(@@) % بت عن طيفكم مستخبرا % % من غرامي بكم من كان ناما % % 25(@)(@@) % وغرامي رمت أن أكتمه % % فأبى الدمع لأسراري اكتتاما % % 26(@)(@@) % ولماذا ظمئت نحوكم % % مقلة إنسانها في الدمع عاما % % 27(@)(@@) % يا رفيقي ارفقا بي فالهوى % % عنفه يكفي المحب المستهاما % % 28(@)(@@) % أنجداني فبنجد أربي % % حين غيري شام بالغور الشآما % % 29(@)(@@) % وانشرا عندي أخبار الحمى % % فبأخبار الحمى قلبي هاما % % 30(@)(@@) % ناظري من دمعتي في شغل % % فانظروا عني هاتيك الخياما % % PageV01P369 31(@)(@@) % سار قلبي يوم ساروا وانثنوا % % نحو نجد وأقاموا فأقاما % % 32(@)(@@) % عللاني بأحاديثهم % % فأحاديثهم تشفي الأواما % % 33(@)(@@) % هذه أطلالهم تشكو الظما % % فدعا الأدمع تنهل انسجاما % % 34(@)(@@) % رفقا نستسق جدوى ظفر % % فهو من بخل بالجود الغماما % % 35(@)(@@) % فهو الغيث إذا بث اللها % % وهو الليث إذا فل اللهاما % % 36(@)(@@) % لم يزد أعداءه يوم الوغى % % والقنا إلا انحطاطا وانحطاما % % 37(@)(@@) % إجتلى من مشرق المجد السنا % % وامتطى من بازل الملك السناما % % 38(@)(@@) % وأضاءت بسنا سنته % % ظلم الظلم لأيام الأيامى % % 39(@)(@@) % أولدت أنعمه عقم المنى % % وشفى من يأسنا الداء العقاما % % 40(@)(@@) % كرم يحيي وبأس مهلك % % وهما ما صحبا إلا هماما % % PageV01P370 41(@)(@@) % أنت 
ms94	 عذر الدهر يا واحده % % ولقد أعظم لولاه اجتراما % % 42(@)(@@) % ببنيه ملكا أو سوقة % % ملأ الأرض طغاة وطغاما % % 43(@)(@@) % ليس بدعا سقمي من صحتي % % فالقنا حطم من حيث استقاما % % 44(@)(@@) % وإذا المرء تشكى خطة % % كانت الصحة للنفس سقاما % % 45(@)(@@) % صغتها منظومة في مدحكم % % فتلاها الدر فذا وتؤاما % % 46(@)(@@) % جمعت لفظا ومعنى شائقا % % بعدا في الحسن مرمى ومراما % % 47(@)(@@) % هي راح كيف حلت عجبا % % وهي سحر كيف ما كانت حراما % % 48(@)(@@) % فاغتنمها إنما أوفى الورى % % من يرى من مثلي الحمد اغتناما % % PageV01P371 البحر : منسرح 1(@)(@@) % توفي العاضد الدعي فما % % يفتح ذو بدعة بمصر فما % % 2(@)(@@) % وعصر فرعونها انقضى وغدا % % يوسفها في الأمور محتكما % % 3(@)(@@) % وانطفأت جمرة الغواة وقد % % باح من الشرك كل ما اضطرما % % 4(@)(@@) % وصار شمل الصلاح ملتئما % % بها وعقد السداد متنظما % % 5(@)(@@) % لما غدا معلنا شعار بني العباس % % حقا والباطل اكتتما % % 6(@)(@@) % وبات داعي التوحيد منتصرا % % ومن دعاة الإشراك منتقما % % 7(@)(@@) % وظل أهل الضلال في ظلل % % داجية من غيابة وعمى % % 8(@)(@@) % وارتبك الجاهلون في ظلم % % لما أضاءت منابر العلما % % 9(@)(@@) % وعاد بالمستضيء مجتهدا % % بناء حق قد كان منهدما % % 10(@)(@@) % واعتلت الدولة التي اضطهدت % % وانتصر الدين بعدما اهتضما % % PageV01P372 11(@)(@@) % واهتز عطف الإسلام من جذل % % وافتر ثغر الإيمان وابتسما % % 12(@)(@@) % واستبشرت أوجه الهدى فرحا % % فليقرع الكفر سنه ندما % % 13(@)(@@) % عاد حريم الأعداء منتهك الحمى % % وفيء الطغاة مقتسما % % 14(@)(@@) % قصور أهل القصور أخرجها % % عامر بيت من الكمال سما % % 15(@)(@@) % أزعج بعد السكون ساكنها % % ومات ذلا وأنفه رغما % % PageV01P373 البحر : كامل تام 1(@)(@@) % بفتوح عصرك يفخر الإسلام % % وبنور نصرك تشرق الأيام % % 2(@)(@@) % وبفتح قلعة بعلبك تهذبت % % هذي الممالك واستقام الشام % % 3(@)(@@) % وبكى الحسود دما وثغر الثغر من % % فرح بنصرك للهدى بسام % % 4(@)(@@) % فتح تسنى في الصيام كأننا % % شكرا لما منح الإله صيام % % 5(@)(@@) % من ذا رأى في الصوم عيد سعادة % % حلت لنا والفطر فيه حرام % % 6(@)(@@) % باليمن هذا الشهر مشهور كما % % قد عم بالبركات هذا العام % % 7(@)(@@) % أسدى صلاح الدين والدني يدا % % بنوالها سوق الرجاء تقام 
ms95	 % % 8(@)(@@) % فتمل فتحك واقصد الفتح الذي % % بحصوله لفتوحك الإتمام % % 9(@)(@@) % دم للعلى حتى يدوم نظامها % % واسلم يعز بنصرك الإسلام % % PageV01P374 البحر : طويل 1(@)(@@) % أيا ساكني مصر عفا الله عنكم % % وعافاكم مما ألاقيه منكم % % 2(@)(@@) % أبيت على هجرانكم متندما % % ومن ينأ عنكم كيف لا يتندم % % 3(@)(@@) % فإن كنتم لم تعلموا ما لقيته % % من الوجد والأشواق فالله يعلم % % 4(@)(@@) % بقيتم وعشتم سالمين من الأذى % % ومنية قلبي أن تعيشوا وتسلموا % % PageV01P375 البحر : طويل 1(@)(@@) % أأحبابنا من بعدنا كيف أنتم % % فقد بان صبري والكرى منذ بنتم % % 2(@)(@@) % وما زلتم أهل المودة والوفا % % ولكنما خان الزمان فخنتم % % 3(@)(@@) % وإني بحال لست أذكر بعضها % % على كل حال أنتم كيف أنتم % % 4(@)(@@) % محبكم من لوعة الوجد مشتك % % وقد كنتم تشكونه لو علمتم % % 5(@)(@@) % أسيركم العاني أما تطلقونه % % فديتكم ما ضركم لو مننتم % % PageV01P376 البحر : بسيط تام 1(@)(@@) % بملك مصر أهني مالك الأمم % % فاسعد وأبشر بنصر الله عن أمم % % 2(@)(@@) % أضحى بعدلك شمل الملك ملتئما % % وهل بعدلك شيء غير ملتئم % % 3(@)(@@) % يا فاعل الخير عن طبع بلا كلف % % ومولي العرف عن خلق بلا سأم % % 4(@)(@@) % ووامقا ثلم ثغر الكفر تعجبه % % لا لثم ثغر شنيب واضح شبم % % 5(@)(@@) % لله درك نور الدين من ملك % % بالعزم مفتتح بالنصر مختتم % % 6(@)(@@) % آثار عزمك في الإسلام واضحة % % وسره لك باد غير مكتتم % % 7(@)(@@) % بما من العدل والإحسان تنشره % % تخاف ربك خوف المذنب الأثم % % 8(@)(@@) % أوردت مصر خيول النصر عادمة % % ثني الأعنة إقداما على اللجم % % 9(@)(@@) % فأقبلت في سحاب من ذوابها % % وقضبها بدماء الهام منسجم % % 10(@)(@@) % تمكن الرعب في قلب العدو بها % % تمكن النار بالإحراق في الفحم % % PageV01P377 11(@)(@@) % سرت لتقطع ما للكفر من سبب % % واه وتوصل ما للدين من رحم % % 12(@)(@@) % مستسهلات وعور الطرق في طلب العلياء % % مقتحمات أصعب القحم % % 13(@)(@@) % وجاعلات من الإفرنج غلهم % % والقيد في موضع الأطواق والحزم % % 14(@)(@@) % لقد شفت غلة الإسلام وانتقمت % % من العدو بحد الصارم الحذم % % 15(@)(@@) % أعانها الله في إطفاء جمر أذى % % من شر شاور في الإسلام مضطرم % % 16(@)(@@) % وأصبحت 
ms96	 بك مصر بعد خيفتها % % للأمن والعز والإقبال كالحرم % % 17(@)(@@) % والسنة اتسقت والبدعة انمحقت % % وعاودت دولة الإحسان والكرم % % 18(@)(@@) % ملوكها لك صاروا أعددا وغدا % % بها عبيدك أملاكا ذوي حرم % % 19(@)(@@) % أنبت عنك بها قرما ينوب بها % % في البأس عن عنتر في الجود عن هرم % % 20(@)(@@) % لله درك نور الدين من ملك % % عدل لحفظ أمور الدين ملتزم % % PageV01P378 21(@)(@@) % كانت ولا ية مصر قبل عزتها % % بكشف دولتها لحما على وضم % % 22(@)(@@) % فالنيل ملتطم جار على خجل % % جارا لبحر نوال منك ملتطم % % 23(@)(@@) % أغز الفرنج فهذا وقت غزوهم % % واحكم جموعهم بالذابل الحطم % % 24(@)(@@) % وطهر القدس من رجس الفرنج وثب % % على البغاث وثوب الأجدل القطم % % 25(@)(@@) % فملك مصر وملك الشام قد نظما % % في عقد عز من الإسلام منتظم % % 26(@)(@@) % محمود الملك الغازي يسوسهما % % بالفضل والعدل والإفضال والنعم % % 27(@)(@@) % بالشكر كل لسان ناطق أبدا % % محمود الملك محمود بكل فم % % 28(@)(@@) % فأشك مصر وأظهر عز سنتها % % كم تقتضي وإلى كم تشتكي وكم % % PageV01P379 البحر : طويل 1(@)(@@) % ولم أنس بالزرقاء يوم وداعنا % % أنامل تدمى حيرة للتندم % % 2(@)(@@) % أعدتك يا زرقاء حمراء إنني % % بكيتك حتى شيب ماؤك بالدم % % 3(@)(@@) % تأخر قلبي عندهم مختلفا % % وخالفتهم في عزمتي والتقدم % % 4(@)(@@) % فيا ليت شعري هل أعود إليهم % % وهل ليت شعري نافع للمتيم % % PageV01P380 البحر : مخلع البسيط 1(@)(@@) % ريم هضيم يروم هضمي % % من سقم عينيه عين سقمي % % 2(@)(@@) % وطرفه في فتور صبري % % وخصره في نحول جسمي % % 3(@)(@@) % ماجد في ثلم ثغر صبري % % لو جاد لي ثغره بلثم % % 4(@)(@@) % في عارضيه طراز حسن % % بهي نسج شهي رقم % % 5(@)(@@) % ووجهه بالعذار بدر % % أحيط من هالة بتم % % 6(@)(@@) % ورد حياء ومسك خط % % ينم هذا وذاك ينمي % % 7(@)(@@) % قد نقطت شمس وجنتيه % % للحسن من خاله بنجم % % 8(@)(@@) % واهي مناط الوشاح حلت % % فيه بوجدي عقود عزمي % % 9(@)(@@) % نطاقه في القياس نطق % % وعطفه جانح لسلمي % % 10(@)(@@) % وخلقه جامح لحربي % % وعطفه جانح لسلمي % % PageV01P381 11(@)(@@) % إلام ظلما يصد ألمي % % صادي قلبي عن ريم ظلم % % 12(@)(@@) % لو أطلق الرسم من وصالي % % لم أبل في 
ms97	 صده كرسم % % 13(@)(@@) % أفكرت في عزه وذلي % % فهام في الحالتين فهمي % % 14(@)(@@) % من وهج الوجه دمع عيني % % بذوب قلب يهيم يهمي % % 15(@)(@@) % إذا غدا الدمع من وشاتي % % فبوح سر الهوى بكتمي % % 16(@)(@@) % إن رمت يا عاذلي صلاحي % % فخلني والهوى وزعمي % % 17(@)(@@) % شاهد بعيني الحبيب تشهد % % أن هواه من المهم % % 18(@)(@@) % لومك يذكي الغرام قل لي % % أنت نصيحي أم أنت خصمي % % 19(@)(@@) % ولا ساءني واللوم لوم % % كلام سوء وأسو كلم % % 20(@)(@@) % يا بدر بادر بشمس راح % % يقشع منها غمام غم % % PageV01P382 21(@)(@@) % وانقع وقيت الأذى أواما % % لابن كريم ببنت كرم % % 22(@)(@@) % وهز مني للأنس عطفا % % وخص جيش الأسى بهزم % % 23(@)(@@) % واجعل رضاعي جنى رضاب % % بفيك منه يعز فطمي % % 24(@)(@@) % فريقك الحلو عذب ورد % % يروي صدى القلب وهو يظمي % % 25(@)(@@) % واشف غليلي بشهد ثغر % % جناه ترياق كل سم % % 26(@)(@@) % بقدك الساحر التثني % % جد لي من غصنه بضم % % 27(@)(@@) % بخدك الباهر التجلي % % جد لي من ورده بشم % % 28(@)(@@) % يا حارمي في الوصال حظي % % موفرا بالفراق قسمي % % 29(@)(@@) % وقاتلي بالصدود ظلما % % لا تتقلد دمي واثمي % % 30(@)(@@) % يا راميا قوسه بحتفي % % موتره ما يزال يصمي % % PageV01P383 31(@)(@@) % بالعين والحاجبين تغني % % عن كل قوس وكل سهم % % 32(@)(@@) % يا حبذا بالعراق نعمى % % شكرتها في وصال نعم % % 33(@)(@@) % أرمي بطرفي هوى إليها % % وهي لقلبي باللحظ ترمي % % 34(@)(@@) % غداة مغنى حماي حاوي % % حو من الغانيات حم % % 35(@)(@@) % أيام فوق السماء أمري % % وفق مرادي وتحت حكمي % % 36(@)(@@) % أيام حل دمي المصون الحرام % % في بذله لأدم % % 37(@)(@@) % أدمي بلثمي خدود بيض % % عيونها للقلوب تدمي % % 38(@)(@@) % واجتلي الكأس في ندامي % % غر من الأكرمين شم % % 39(@)(@@) % غدا بنسج الغرام فينا % % ينسج عقلا لكل فدم % % 40(@)(@@) % . . . . . نسمو % % من نفحات الصبا لنسم % % PageV01P384 41(@)(@@) % . . . . . . لثم در % % بين عقيق وفض ختم % % 42(@)(@@) % . . . . . عقود العقول تلقى % % من التصابي بكف فصم % % 43(@)(@@) % . . . . . ليالي الوصال زهرا % % تبدلت في النوى بسحم % % 44(@)(@@) % . . . . . سواد فودي % % مذ عقبت بيضها بدهم % % 45(@)(@@) % يشيب في الرأس مثل نار % % توقدت من خلال فحم % % 46(@)(@@) % يزيد مني الهموم ذكري 
ms98	 % % أيام عمر مضين قدم % % 47(@)(@@) % رضت طويلا جموح حظي % % فلم يلن عوده لعجمي % % 48(@)(@@) % ليس يعادي الزمان غيري % % كأن فضلي إليه جرمي % % 49(@)(@@) % أكظم غيظي وليس جدي % % لغائظات الأمور كظمي % % 50(@)(@@) % أيا زماني الغشوم أقصر % % إنك لا تستيطع غشمي % % PageV01P385 51(@)(@@) % عبد الرحيم الرحيم أضحى % % عوني على خطبك الملم % % 52(@)(@@) % ألوذ منه بذي جناب % % يلجي طراقه وينمي % % 53(@)(@@) % بالسيد الأروع المرجى % % لكشف إزل وكف أزم % % 54(@)(@@) % بالفاضل الأفضل الأجل % % المفضل الأشرف الأشم % % 55(@)(@@) % بحاتمي النوال سمح % % ليس يرى الجود غير حتم % % 56(@)(@@) % غيث غياث وجود جود % % وبحر علم وطود حلم % % 57(@)(@@) % ذو أنف أنف كل خطب % % يقتاد من بأسه بخطم % % 58(@)(@@) % زكاء نجر ورحب صدر % % وطول باع وطيب جذم % % 59(@)(@@) % ومزن من ووجه منح % % غير جهام وغير جهم % % 60(@)(@@) % محاسنا الرأي منه عدلا % % كل ظلام وكل ظلم % % PageV01P386 61(@)(@@) % المنعم المستحق مني % % جميع شكري ببعض شكم % % 62(@)(@@) % وما بنى المجد مثل مولى % % خص الندى ماله بهزم % % 63(@)(@@) % ذو محتد في النجار زاك % % وسؤدد في الفخار ضخم % % 64(@)(@@) % نعماه ترجى لكف بؤس % % وفك أسر وجبر يتم % % 65(@)(@@) % يراعه في اليمين منه % % تستخرج الدر من خضم % % 66(@)(@@) % فهو حسام لم يبق داء % % إلا وقد خصه بحسم % % 67(@)(@@) % وحده حص كل حصد % % من كل ما نائب بثلم % % 68(@)(@@) % يروض الطرس منه مزجى % % سحب من المكرمات سحم % % 69(@)(@@) % سطوره للعلى نجوم % % تخفض في أوجها وتسمي % % 70(@)(@@) % إن جاء عاف فنجم سعد % % أو جاء عات فنجم رجم % % PageV01P387 71(@)(@@) % أقلامه خاطبت خطوبا % % من ظفرها ظفرت بقلم % % 72(@)(@@) % كم عقدت راية لرأي % % مؤيد عزمه بحزم % % 73(@)(@@) % والسمع والصلب للأعادي % % ما بين وقر بها ووقم % % 74(@)(@@) % له يد للولي منها % % ولي ولي ووسم وسمي % % 75(@)(@@) % ما وابل منجم الغوادي % % بكل سهل وكل حزم % % 76(@)(@@) % هام رباب بالوشي منه % % هام الربى في بديع وشم % % 77(@)(@@) % يحوك نسج الربيع فيه % % نمارق الزهر فوق أكم % % 78(@)(@@) % أغزر من جوده وفصح % % في العجز عن وصفه لبكم % % 79(@)(@@) % مولاي حالي كما تراه % % في نقص حظ 
ms99	 وفضل هم % % 80(@)(@@) % لم يقض ديني وكل يوم % % غريم دهري يزيد عزمي % % PageV01P388 81(@)(@@) % أهلي مقيمون من دمشق % % في بلدة نارها بلجم % % 82(@)(@@) % قد طال ذيل بهم فطول % % طولا بجاهي العريض كمي % % 83(@)(@@) % أصبحت في مصر ذا رجاء % % إلى الندى الجم منك جم % % 84(@)(@@) % أصاب قصدي وتم أمري % % وبان نجحي وفاز أمي % % 85(@)(@@) % وإنني قد وجدت وجدي % % منك كما قد عدمت عدمي % % 86(@)(@@) % نعشتني من عثار دهري % % فحزت حمدي وحاز ذمي % % 87(@)(@@) % عندي مواعيد للمعالي % % يمطل دهري بها برغمي % % 88(@)(@@) % نتيجة النجح منك يقضي % % أن المواعيد غير عقم % % 89(@)(@@) % ولي مني كلها أراه % % منك على خبرة وعلم % % 90(@)(@@) % قضاء ديني ونيل سولي % % وحفظ جاهي وجري رسمي % % PageV01P389 91(@)(@@) % وصنيعة لا يضيع فيها % % عزمي كما لا يفوت غنمي % % 92(@)(@@) % وحرمة تستنير منها % % سعود قدري في أفق عظم % % 93(@)(@@) % يممت أما ولست أرضى % % تيمما في جناب يم % % 94(@)(@@) % لم أملي لم يزن بنحح % % لم شعثي لم يعن بلم % % 95(@)(@@) % رم رم أمري وحل حالي % % ما كرم في الورى كرمي % % 96(@)(@@) % رث ثرائي بكل طرز % % وغث جاهي بغير شحم % % 97(@)(@@) % مضارع الفعل حظ فضلي % % وعائق الصرف حرف جزم % % 98(@)(@@) % ناهيك من مخول معم % % يحنو على المخول المعم % % 99(@)(@@) % كل عدو شناك يلقى % % في الناس طمس اسمه كطسم % % 100(@)(@@) % شمل العدا والعروض منهم % % ما بين شت وبين شتم % % PageV01P390 101(@)(@@) % ونلت عزا بغير صرف % % ووصل ملك بغير صدم % % 102(@)(@@) % تملها فهي بكر فكري % % شهية من نتاج شهم % % 103(@)(@@) % حدوت عيسي بها فجاءت % % شقشقة من هدير قرم % % 104(@)(@@) % بحرك طامي والعباب فاغسل % % طمي في نظمها ورمي % % 105(@)(@@) % لي خاطر مجبل لهمي % % فنحته من صفا أصم % % 106(@)(@@) % أقدم رغبا فحام رعبا % % لقدر فخر لديك فخم % % 107(@)(@@) % إليك يا كعبة المعالي % % حج حجاه بلطف حجم % % 108(@)(@@) % أجر على الوهم عظم شاني % % واجبر على الوهن عظم نظمي % % 109(@)(@@) % بصفحة الصفح منك يبدو % % جرم قصوري بغير جرم % % 110(@)(@@) % باسمك للشكر باسمات % % مني منى سقتهن باسمي % % PageV01P391 111(@)(@@) % أقبل وأفضل علي وافضل % % عرب معان 
ms100	 لدي عجم % % 112(@)(@@) % ما دمت عوني فليس يغدو % % جميل رسمي قبيح وصم % % PageV01P392 البحر : دو بيت 1(@)(@@) % أذللت ذوي الشرك بعز العزم % % والكفر بهز صارمي في عزم % % 2(@)(@@) % شيدت بني الملك بأمري الجزم % % والنصر رايته قرين الحزم % % PageV01P393 البحر : خفيف تام 1(@)(@@) % كيف لا يفتدي لي الدهر عبدا % % وأنا عبد عبد عبد الرحيم % % 2(@)(@@) % بدوام الأجل سيدنا الفاضل % % يا دولة الأفاضل دومي % % 3(@)(@@) % إذ أراه ينوب عني لدى الملك % % مناب الأرواح عند الجسوم % % 4(@)(@@) % مالك الحل في الممالك والعقد % % وحكم التحليل والتحريم % % 5(@)(@@) % معمل للنفاذ في كل قطر % % قلما حاكما على إقليم % % 6(@)(@@) % تتلقى الملوك في كل أرض % % كتبه القادمات بالتعظيم % % 7(@)(@@) % ناحل الجسم ذو خطاب به يصغر % % للدهر كل خطب جسيم % % PageV01P394 البحر : كامل تام 1(@)(@@) % رسم علي لذلك الرسم % % أني أقاسمه ضنى الجسم % % 2(@)(@@) % دار على حرب الزمان لنا % % جنحت بها سلمى إلى سلمي % % 3(@)(@@) % ما للهوى أبدا يلازمني % % فيها فهل كتب الهوى باسمي % % 4(@)(@@) % يا صاح تعذلني على شعف % % ما زال يعذرني له خصمي % % 5(@)(@@) % إني رضعت لبان حبهم % % ويعز عنه وإن جفوا فطمي % % 6(@)(@@) % كلم فراقهم ولومك لي % % في حبهم كلم على كلم % % 7(@)(@@) % بخلوا علي بوصل طيفهم % % ما كان بخل الطيف في زعمي % % 8(@)(@@) % أني يطيب ويستطيب كرى % % قلب يهيم وناظر يهمي % % 9(@)(@@) % أوما سوى هجري عقابهم % % أم ليس غير هواهم جرمي % % 10(@)(@@) % أما الغرام فأدمعي أبدا % % يعربن عنه بألسن عجم % % PageV01P395 11(@)(@@) % والقلب مسكنهم فكيف رضوا % % أن يجعلوه مسكن الهم % % 12(@)(@@) % والسقم في جسم المحب فلم % % وصفت عيون البيض بالسقم % % 13(@)(@@) % أدم سفكن دمي بأعينها % % يا للرجال من الدمى الأدم % % 14(@)(@@) % بيض الظبى تنبو وترشقنا % % بيض الظباء بأعين تدمي % % 15(@)(@@) % ما كنت أعلم قبل رؤيتها % % أن النواظر أسهم تصمي % % 16(@)(@@) % أقمار خمر إن سفرن لنا % % وإن انتقبن أهلة اللثم % % 17(@)(@@) % يضعفن عن حمل الإزار فلم % % يحملن أوزارا من الإثم % % 18(@)(@@) % لظباء كاظمة مقابلتي % % غيظي من الرقباء بالكظم % % 19(@)(@@) % وأغن بالكشح الهضيم له % % يا كاشحي أغناك عن هضمي % % 20 