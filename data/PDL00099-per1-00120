ms113	 عتاب(@)(@@) 48 این همه‌گفتم ولی بالله تمام افسانه بود %~% فرق‌کن افسانه را از وصف ای‌کامل نصاب(@)(@@) 49 وصف‌آن باشدکزاو موصوف‌رابتوان شناخت %~% نه همی افسانه‌گفتن همچوکور از ماهتاب(@)(@@) 50 وصف‌نور آنست‌کز چشمت درآید در ضمیر %~% مدح آب آنست کز جانت نشاند التهاب(@)(@@) 51 ای‌که سیرابی خدارا وصف‌آب ازمن مپرس %~% هل بجویم تشنه‌یی آنگه بگویم وصف آب(@)(@@) 52 چشم بندی هست تعریف از پی نامحرمان %~% تا نبیند چشمشان رخسار جانان بی‌نقاب(@)(@@) 53 وینکه من‌گویم تمام افسانهای عاشتیست %~% تا بدان افسانه نامحرم رود لختی به خواب(@)(@@) 54 دیده‌باشی شاهدی چون بارقیب آید به‌بزم %~% عشق‌غیرت پیشه هرساعت فتد درپیچ‌وتاب(@)(@@) 55 مصلحت را صد هزار افسانه‌گوید با رقیب %~% خوابش‌‌آید خودز وصل‌دوست‌گردد کامیاب(@)(@@) 56 مغزگفتی نغزگفتی لیک قاآنی بترس %~% زابلهان‌کند فهم و جاهلان دیریاب(@)(@@) 57 راه‌تنگست و فرس لنگست و معبر پر ز سنگ %~% ای سوار تیز رو لختی عنان واپس بتاب(@)(@@) 58 بیش‌ازینت حدگفتن نیست‌ورگویی خطاست %~% ختم‌کن اینجا سخن والله علم بالصواب PageV1P100(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 دوشم مگر چه بودکه هیچم نبرد خواب %~% پروین به رخ فشاندم تا سر زد آفتاب(@)(@@) 2 بیدار بود خادمکی در سرای من %~% گفت‌از چه‌خواب می‌نروی دادمش جواب(@)(@@) 3 کامروز بخت خواجه ز من پرسشی نمود %~% زین پس چو بخت‌خواجه نخواهم شدن به‌خواب(@)(@@) 4 گفت ار چنین بود قلمی‌گیر وکاغذی %~% بنگار بیتکی دو سه در مدح بوتراب(@)(@@) 5 تفسیر عقل ترجمه اولین ظهور %~% تأویل عشق ماحصل چارمین‌کتاب(@)(@@) 6 روح رسول زوج بتول آیت وصول %~% منظور حق مشیت مطلق وجود ناب(@)(@@) 7 تمثال روح صورت جان معنی خرد %~% همسال عشق شیر خدا میرکامیاب(@)(@@) 8 گنج بقا ذخیره هستی‌کلید فیض %~% امن جهان امان خلایق امین باب(@)(@@) 9 مشکل‌گشای هرچه به‌گیتی ز خوب و زشت %~% روزی‌رسان هرچه به‌گیهان ز شیخ و شاب(@)(@@) 10 منظور حق ز هرچه به قرآن خورد قسم %~% مقصود رب‌ز هرچه به فرقان‌کند خطاب(@)(@@) 11 داغی نه بر جبین و پرستار او قلوب %~% طوقی نه برگلوی وگرفتار او رقاب(@)(@@) 12 وجه‌الله 
ms114	 اوست دل مبر از وی به هیچ‌وجه %~% باب‌الله اوست پامکش از وی به‌هیچ باب(@)(@@) 13 او هست جان پاک و جهان مشتی آب و خاک %~% زین پاکتر بگویم هم اوست خاک و آب(@)(@@) 14 یک لحظه پیش ازین‌که نگارم مناقبش %~% در دل نشسته‌بود چو خورشید بی‌نقاب(@)(@@) 15 چون مدح او نوشتم اندر حجاب رفت %~% زیراکه لفظ و خامه‌شد اندر میان حجاب(@)(@@) 16 نی نی صفات من بود اینها نه وصف او %~% بشنو دلیل تاکه نیفتی در اضطراب(@)(@@) 17 آخر نه هرچه زاد ز هرچیز وصف اوست %~% زانسان‌که‌گرمی‌از شرر و مستی از شراب(@)(@@) 18 این وصف آب نیست‌که‌گویی شرر برد %~% کاین وصف‌هم‌تراعطش‌افزاست چون‌سراب(@)(@@) 19 در مدح سیل اینکه خرابی‌کند چرا %~% بس مدح سیل‌کردی و جایی نشد خراب(@)(@@) 20 لیکن هم ار به دیده معنی نظرکنی %~% در پرده قشور توان یافتن لباب(@)(@@) 21 زیراکه از خیال رهی هست تا خرد %~% کاسباب خوب و زشت بدو داد انتساب(@)(@@) 22 هرچند ذکر آب عطش را مفید نیست %~% خوشتر ز وصف آتش در دفع التهاب(@)(@@) 23 لطف و عذاب هردو ز یزدان رسد ولی %~% لاشک حدیث لطف به از قصه عذاب(@)(@@) 24 چون نیک بنگری سخن از عرش ایزدی %~% زانجاکه آمدست بدانجاکند ایاب(@)(@@) 25 ازگوش باز در دل و از جان رود به عرش %~% در دل ز راه‌گوش نیوشاکند شتاب(@)(@@) 26 پس شد عیان‌که سامع و قایل بود یکی %~% کاو خودکند سؤال‌و هم او خود دهد جواب(@)(@@) 27 باری علی چو شافع دیوان محشرست %~% ارجو شفیع من شود اندر صف حساب(@)(@@) 28 زانسان‌که هست صاحب دیوان شفیع من %~% در حضرت جناب جوانبخت مستطاب(@)(@@) 29 شیخ اجل مراد ملل منشا دول %~% فهرست مجد نظم بقا فرد انتخاب(@)(@@) 30 آن میر حق‌یرست‌که درگنج معرفت %~% یک تن نیامدست چو اوکامل‌النصاب(@)(@@) 31 با او هر آنکه‌کینه سگالد به حکم حق %~% حالی به‌گردنش رگ شریان شود طناب(@)(@@) 32 داند ضمیر اوکه سعیدست یا شقی %~% هر نطفه را نرفته به زهدان 
ms115	 ز پشت باب(@)(@@) 33 قاآنیا ببندگیش جان نثارکن %~% گم شو ز خویش و زندگی جاودان بیاب(@)(@@) 34 خواهی دعاکنی‌که خدایش دهد دوکون %~% حاجت بگفت نیست خداکرد مستجاب PageV1P101(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 دو قلاع کفرند با هم مصاحب %~% یکی تیغ خسرو یکی‌کلک صاحب(@)(@@) 2 یکی خرمن ظلم را برق خاطف %~% یکی‌کشته عدل را مزن ساکب(@)(@@) 3 یکی ضبط ملک عجم را مزاول %~% یکی ربط دین عرب را مواظب(@)(@@) 4 یکی ماشطه چهر ملک از مساعی %~% یکی واسطه رزق خلق از مواهب(@)(@@) 5 یکی حل و عقد اجل را ممارس %~% یکی رتق و فتق امل را مراقب(@)(@@) 6 یکی زاهن و خود آهن دلان را %~% چو آهن‌ربا روز پیکار جاذب(@)(@@) 7 یکی ملک اجلال را جم عادل %~% یکی قلک اقبال را یم واهب(@)(@@) 8 یکی ابر باذل یکی ببر با دل %~% یکی غیث وابل یکی لیث ساغب(@)(@@) 9 یکی رافع فاقه ازکف‌کافی %~% یکی دافع فتنه از سهم صائب(@)(@@) 10 هرآنچ این‌کند با مخالف ز خامه %~% هرآنچ آن‌کند با معاند ز قاضب(@)(@@) 11 نه باگله ذئبان‌کنند از براثن %~% نه با صعوه عقبان‌کنند از مخالب(@)(@@) 12 یکی رایت مجد را چیست رافع %~% یکی آیت نجد راکیست ناصب(@)(@@) 13 یکی با خطابش ثعالب ضیاغم %~% یکی با عتابش ضیاغم ثعالب(@)(@@) 14 دوگوییست قاآنیا از دو بینی %~% یکی‌گوکه نبود دوگویی مناسب(@)(@@) 15 زهی ز اهتزاز صبای قبولت %~% چه صابی صبی صاحب رای صائب(@)(@@) 16 ز تاثیر تریاق لطفت عجب نی %~% که جدوار روید ز نیش عقارب(@)(@@) 17 بکاخت ز آمد شد اهل حاجت %~% نبیندکسی چین در ابروی حاجب(@)(@@) 18 شکال از قبولت به هرماس چیره %~% حمام از خطابت به سیمرغ غالب(@)(@@) 19 پلنگان به صحرا نهنگان به دریا %~% ز خشم تو خائف ز قهر تو هارب(@)(@@) 20 به توکج رود هرکه چون خط ترسا %~% بسوزاد قلبش چو قندیل راهب(@)(@@) 21 به تن باز ناید ز انفاس عیسی %~% روانی‌که از رحمتت‌گشته خائب(@)(@@) 22 ز مکتوبه‌یی داده‌کلکت جهان را %~% نظامی‌که 
ms116	 شاهان دهند ازکتائب(@)(@@) 23 بر رفته سقف سرای جلالت %~% فلک چیست دانی نسیج العناکب(@)(@@) 24 کنی آنچه با نامه‌یی در معارک %~% کنی آنچه با خامه‌یی در محارب(@)(@@) 25 نه ترکان توران‌کنند از عوالی %~% نه‌گردان ایران‌کنند از قواضب(@)(@@) 26 به تعجیل مضراب در چنگ چنگی %~% بجنبد قلم‌گر به دست محاسب(@)(@@) 27 محاسب نه یک تن همه اهل‌گیتی %~% نه یک روز تا روز محشر مواظب(@)(@@) 28 مداد آنچه نقش نوشتن پذیرد %~% اگر ما جاری اگر طین لازب(@)(@@) 29 قلم هرچه در دست بتوان‌گرفتن %~% ورق هرچه بهر نوشتن مناسب(@)(@@) 30 به دیوان فضلت نیارندکردن %~% نه حصر محامد نه حد مناقب(@)(@@) 31 زهی امر و نهی تو اندر ممالک %~% نفاذی که ارواح را در قوالب(@)(@@) 32 در این مه‌که باشد عمل پارسا را %~% کهی لف شاره‌گهی قص شارب(@)(@@) 33 ز اندیشه صوم و تشویش سرما %~% گروهی ز می برخی از توبه تائب(@)(@@) 34 چنان سردگیتی‌که با سیف قاطع %~% نگردد ز مرکب جدا پای راکب(@)(@@) 35 چو مویی‌که در می‌فتد جرعه‌کش را %~% به خون سرشک اندران جسم ذائب(@)(@@) 36 گران‌گشته بی‌باده صاف ساغر %~% بر آنسان‌که بی‌جان فرخنده قالب(@)(@@) 37 چنان لعل دلبر بخندد صواعق %~% چنان چشم عاشق بگرید سحائب(@)(@@) 38 کند ابر هاطل ز تقطیر ژاله %~% زمن را چوگردون پر از نجم ثاقب(@)(@@) 39 همی هردم از برف زال زمانه %~% به عارض پریشان‌کند شعر شائب(@)(@@) 40 مرا هست بی‌مهر ماهی‌که بر من %~% بود مهر آن ماه چون روزه واجب(@)(@@) 41 دو چشمش تعالی دو جادوی لاهی %~% دو زلفش تبارک دو هندوی لاعب(@)(@@) 42 به ایوان خرامد غزالی غزلخوان %~% به میدان شتابد پلنگی مغاضب(@)(@@) 43 عذار فروزانش در فرع فاحم %~% سهیل یمانیست در لیل ضارب(@)(@@) 44 به خون تن من خضیبش انامل %~% ز دود دل من وسیمش حواجب(@)(@@) 45 غزلخوان غزالیست‌کزگرگ غمزه %~% کند صید غژمان هژبر محارب(@)(@@) 46 مرا چون پری دیده دیوانه سازد %~% چوگردد پری‌وارم از دیده غایب(@)(@@) 47 پریدوش چون مهره اختران را %~% برون 
ms117	 ریخت از حقه چرخ ملاعب(@)(@@) 48 چو از قعر وارون چهی سنگ ریزه %~% ز چرخ معلق عیان شدکواکب(@)(@@) 49 فروزنده دری در آن لیل اللیل %~% چو آویزه در ز جعدکواعب(@)(@@) 50 درآمد ز در آن بت مهر چهرم %~% پراکنده بر ماه مشک از دو جانب(@)(@@) 51 خرامان و سرمست و مخمور و بیخود %~% شکسته‌کله تاب داده ذوائب(@)(@@) 52 چو بنشست برخاستم از سر جان %~% سرودم‌که ای جان به وصل تو راغب(@)(@@) 53 دراین فصل‌واین ماه‌و این وقت‌و این‌شب %~% من و وصل تو زه‌زه از این عجایب(@)(@@) 54 فوالله ماکان من قبل هذا %~% فؤادی خبیرا بتلک الغرائب(@)(@@) 55 لقد اسعف الدهرکل المقاصد %~% لقد انجح الجد جل المطالب(@)(@@) 56 المت بنا نعمه الله بالحق %~% و همت و تمت علینا الرغائب(@)(@@) 57 من الله مالت الینا الموائد %~% من‌الحق عالت علینا المواهب(@)(@@) 58 تو وکوی من بخ بخ ای بخت مقبل %~% من و روی تو خه‌خه‌ای دهر خاطب(@)(@@) 59 شب و آفتاب آنگهی‌کوی مسکین %~% بیابان و آب آنگهی‌کام لائب(@)(@@) 60 ز رویت چو روز است روشن‌که امشب %~% پس از صبح صادق دمد صبح‌کاذب(@)(@@) 61 مراد من ایدون چه باشد مرادت %~% بگو ای مراد ترا طبع طالب(@)(@@) 62 بگفتا یکی چامه خواهم ملفق %~% به وصف زمستان و تعریف صاحب(@)(@@) 63 به دستم شد آن شوشتر خامه جنبان %~% چو در دست بربط نوازان مضارب(@)(@@) 64 به امداد آمه به نامه ز خامه %~% رقم‌کردم این چامه نغز راتب(@)(@@) 65 همی بارد از ابر بارنده راضب %~% چو از دست دستور واهب مواهب(@)(@@) 66 فرو ریزد از این بخار مصاعد %~% لآلی چو ازکف رادش رغایب(@)(@@) 67 بر اغبر هجوم آرد از ابر باران %~% چوگرد سرایش‌گه سان مواکب(@)(@@) 68 سیه ابر برخیره‌گردید گریان %~% چو بدخواه جاهش ز فرط‌کرائب(@)(@@) 69 هوا سرد شد چون دم خصم جاهش %~% که درگرم دوزخ بماناد واصب(@)(@@) 70 خنک‌گشت عالم چو جسم خلیلش %~% که‌گلشن براو باد نار نوائب(@)(@@) 71 شمر در بر آورد پولاد جوشن %~% چو 
