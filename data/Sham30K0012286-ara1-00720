ms701	 بز(@)(@@) ازي = محمد بن محمد 827 ال(@)(@@)(@@)(@@) || AUT بز(@)(@@) دوي = علي بن محمد 482 ال(@)(@@)(@@)(@@) || AUT بز(@)(@@) دوي = محمد بن محمد 496 ال(@)(@@)(@@)(@@) || AUT بز(@)(@@) ري = عمر بن محمد 560 ال(@)(@@)(@@)(@@) || AUT بز(@)(@@) نطي = أحمد بن محمد 221 ابن ال(@)(@@)(@@)(@@) || AUT بز(@)(@@) وري = محفوظ بن معتوق ال(@)(@@)(@@)(@@) || AUT بز(@)(@@) ي = أحمد بن محمد 243(@)(@@)(@@)(@@) || AUT بس(@)(@@) ال(@)(@@)(@@)(@@) || AUT بس(@)(@@) اسيري = أرسلان بن عبد الله 451 ال(@)(@@)(@@)(@@) || AUT بس(@)(@@) اط = توفيق بن أحمد 1334 ال(@)(@@)(@@)(@@) || AUT بس(@)(@@) اطي = محمد بن أحمد 842 __________ (1) تهذيب التهذيب 1: 432 وذيل المذيل 27 وفي كتاب الألقاب لابن الفرضي - خ: اسمه عامر، ويكنى أبا عبد الله. (2) المعسول 12: 72 - 87. PageV02P0050(@)(@@) ابن بسام (الشاعر) = علي بن محمد 302 ابن بسام (صاحب الذخيرة) = علي بن بسام 542 البسام = محمد بن حمد 1246 بستان = (الرومي) = مصطفى بن محمد 977 البستاني = بطرس بن بولس 1300 البستاني = سليم بن بطرس 1301 البستاني = سليمان بن خطار 1343 البستاني = عبد الله بن ميخائيل 1348 البستاني = ميخائيل عيد 1353 البستي = محمد بن حبان 354 البستي = علي بن محمد 400(@)(@@)(@@)(@@) ||| AUT بسر بن أرطاة(@)(@@) (000 - 86 ه = 000 - 705 م)(@)(@@)(@@)(@@) ||| AUT بسر بن أرطاة(@)(@@) (أو ابن أبي أرطاة) العامري القرشي، أبو عبد الرحمن: قائد فتاك من الجبارين. ولد بمكة قبل الهجرة وأسلم صغيرا، وروى عن النبي صلى الله عليه وسلم حديثين (في مسند أحمد) ثم كان من رجال معاوية بن أبي سفيان. وشهد فتح مصر. ووجهه معاوية سنة 39ه في ثلاثة آلاف إلى المدينة، فأخضعها، وإلى مكة فاحتلها، وإلى اليمن فدخلها. وكان معاوية قد أمره بأن يوقع بمن يراه من أصحاب علي، فقتل منهم جمعا. وعاد إلى الشام، فولاه معاوية على البصرة سنة 41ه بعد مقتل علي وصلح الحسن، فمكث يسيرا وعاد إلى الشام، فولاه البحر، فغزا الروم سنة 50 ه فبلغ القسطنطينية. وأصيب بعد ذلك في عقله، فلم يزل معاوية مقربا له، مدنيا منزلته، وهو على تلك الحال، إلى أن مات، في دمشق، وقيل في المدينة، 
ms702	 عن نحو تسعين عاما (1) . __________ (1) الإصابة 1: 152 وفيه: (قال ابن حبان: من قال ابن أبي أرطاة فقد وهم) . وتهذيب ابن عساكر 3: 220 - 225 وفيه: (حكى ابن مندة عن أبي سعيد بن يونس أن بسرا من أصحاب النبي صلى الله عليه وسلم) . وميزان الاعتدال 1: 144 وفيه: (قال ابن معين: كان ابن أبي أرطاة رجل سوء، أهل المدينة ينكرون أن يكون له صحبة) . وتاريخ الإسلام للذهبي 3: 140 وفيه: (بسر بن أبي أرطاة عمير، ويقال:(@)(@@)(@@)(@@) ||| AUT بسر بن أرطاة(@)(@@) ) PageV02P0051(@)(@)(@@)(@@)(@@) ||| AUT بسطام بن قيس(@)(@@) (000 - نحو 10 ق ه = 000 - نحو 612 م)(@)(@@)(@@)(@@) ||| AUT بسطام بن قيس(@)(@@) بن مسعود الشيباني، أبو الصهباء: سيد شيبان، ومن أشهر فرسان العرب في الجاهلية. يضرب المثل بفروسيته. وكان يقال: أغلى فداءا من(@)(@@)(@@)(@@) ||| AUT بسطام بن قيس(@)(@@) ) أسره عيينة بن الحارث، فافتدي بأربع مئة ناقة وثلاثين فرسا. أدرك الإسلام ولم يسلم. وقتله عاصم بن خليفة الضبي يوم الشقيقة (بعد البعثة النبوية) قال الجاحظ: بسطام أفرس من في الجاهلية والإسلام. ونسب إليه صاحب (شعراء النصرانية) نظما ركيكا لاأراه إلا مصنوعا (1) .(@)(@@)(@@)(@@) ||| AUT بسطام بن مصقلة(@)(@@) (000 - 83 ه = 000 - 702 م)(@)(@@)(@@)(@@) ||| AUT بسطام بن مصقلة(@)(@@) بن هبيرة الشيباني: أمير، من القادة الشجعان الولاة. كان على الري. ولما خرج ابن الأشعث وفد عليه بسطام منجدا، وهو يقاتل الحجاج في (دير الجماجم) فجعله على ربيعة. وقاد كتيبة القراء، وكانت من أشد كتائب ابن الأشعث، وقاتل قتال الأبطال. ثم قتل في وقعة مسكن (على نهر دجيل) (2) . __________ وأورد الخلاف في صحبته ثم قال: (والصحيح أنه لا صحبة له) وأشار إلى ما ارتكبه في اليمن من سبي النساء المسلمات وقتل الطفلين البريئين عبد الرحمن وقثم ابني عبيد الله بن عباس، وقال: إن أمهما هامت بهما وقالت فيهما أبياتا سائرة، وبقيت تقف للناس مكشوفة الوجه وتنشدها في الموسم. وفي العسجد المسبوك - خ - أن بسرا (أول جبار دخل اليمن وعسف أهله) . وفي سفينة البحار 1: 82 فظائع من بطشه وقسوته. وفي التاج (مادة: بسر) إن عبد الرحمن بن 
ms703	 بكار، ومحمد بن عبد الله بن بكار، وحفيده أحمد بن إبراهيم بن محمد، ومحمد بن الوليد الحافظ، كلهم محدثون (بسريون) من ولد بسر بن أرطاة. (1) الكامل للمبرد 1: 109 والكامل لابن الأثير 1: 224 وشعراء النصرانية 256 وأمثال الميداني 2: 22 والآمدي 64 وبلوغ الأرب للآلوسي 1: 280 - 285 ثم 2: 69 وجمهرة الأمثال 2: 113 والمستقصى - خ. وانظر مجمع الأمثال 2: 9. (2) ابن الأثير: حوادث سنة 83. PageV02P0051(@)(@)(@@)(@@)(@@) ||| AUT شوذب(@)(@@) (000 - 101 ه = 000 - 720 م) بسطام اليشكري المعروف ب(@)(@@)(@@)(@@) ||| AUT شوذب(@)(@@) : ثائر جبار. خرج في أيام عمر بن عبد العزيز بمكان قريب من الكوفة اسمه (جوخا) وكان أصحابه 80 رجلا، فتريث عمر في قتالهم إلى أن مات، وولي يزيد بن عبد الملك فأذن بقتالهم، فحاربهم أهل الكوفة، فلم يفلحوا وتبعهم(@)(@@)(@@)(@@) ||| AUT شوذب(@)(@@) وأصحابه إلى الكوفة. ثم سير إليهم يزيد ثلاثة جيوش، كل جيش في ألفين فانهزمت الجيوش. وعظم أمر(@)(@@)(@@)(@@) ||| AUT شوذب(@)(@@) وخاف الناس شره، فجهز مسلمة بن عبد الملك جيشا فيه عشرة آلاف مقاتل، بقيادة سعيد بن عمرو الحرشي، فأحاطوا ب(@)(@@)(@@)(@@) ||| AUT شوذب(@)(@@) ثم قتلوه (1) . البسطامي (الزاهد) = طيفور 261 البسطامي = عمر بن محمد 570 البسطامي = عبد الرحمن بن محمد 858 البسطامي = هداية الله بن عبد الله 1281 البسكري = يوسف بن علي 465 البسنوي = علي دده 1007 البسنوي (غلامك) = محمد بن موسى 1045(@)(@@)(@@)(@@) ||| AUT البسوس(@)(@@) (000 - 000 = 000 - 000) بسوس بنت منقذ التميمية: شاعرة جاهلية يضرب المثل بشؤمها. وهي خالة جساس بن مرة الشيباني. كانت لها (أو لجارها سعد بن شمس الجرمي) ناقة يقال لها سراب، رآها (كليب وائل) ترعى في حماه، فرمى ضرعها بسهم، فحزنت(@)(@@)(@@)(@@) ||| AUT البسوس(@)(@@) . وقالت شعرا أثار جساس بن مرة، فقتل كليبا. فهاجت حرب بكر وتغلب ابني وائل بسببها أربعين سنة، فقيل: أشأم من(@)(@@)(@@)(@@) ||| AUT البسوس(@)(@@) . وعرفت (حرب(@)(@@)(@@)(@@) ||| AUT البسوس(@)(@@) ) باسمها (2) . __________ (1) ابن الأثير 5: 25 والطبري 8: 142. (2) المستقصى 1: 176 - 178 ومجمع الأمثال 1: 154 وثمار القلوب 245 والتاج 4: 108 وفيهم من يرى سبب المثل غير ما تقدم، انظر فصل المقال 306، 364، 504. PageV02P0051(@)(@@) NOTMATCH(@)(@@)(@@)(@@) ||| AUT