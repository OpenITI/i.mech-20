ms362	(@)(@@)(@@)(@@) | 7099 - (@)(@@) ويزيد بن زريع الرملي عن عطاء الخراساني ضعفه ابن معين(@)(@@)(@@)(@@) | 7100 - (@)(@@) يزيد بن زياد عن محمد بن كعب عن معاوية قال البخاري لا يتابع على حديثه(@)(@@)(@@)(@@) | 7101 - (@)(@@) م مقرونا عه / يزيد بن أبي زياد الكوفي مشهور سيء الحفظ قال ابن حبان صدوق إلا أنه كبر وساء حفظه وكان يتلقن وقال يحيى ليس بالقوي وقال أيضا لا يحتج بحديثه وقال ابن المبارك إرم به(@)(@@)(@@)(@@) | 7102 - (@)(@@) يزيد بن أبي زياد ويقال ابن زياد شامي عن الزهري قال البخاري منكر الحديث وقال النسائي متروك(@)(@@)(@@)(@@) | 7103 - (@)(@@) يزيد بن أبي زياد بن السكن عن الشعبي قال أبو حاتم لا تقوم به الحجة(@)(@@)(@@)(@@) | 7104 - (@)(@@) يزيد بن أبي زياد عن محمد بن هلال عن أبيه عن أبي هريرة كانت يمين رسول الله صلى الله عليه وسلم لا وأستغفر الله قال أبو حاتم ضعيف وكأن هذا موضوع قلت ويروي عن شعبه قال الدارقطني ليس بثقة(@)(@@)(@@)(@@) | 7105 - (@)(@@) يزيد بن زيد شيخ لأبي إسحاق السبيعي لا يعرف له في التفسير لفظة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7106 - (@)(@@) د ت ق / يزيد بن سفيان أبو المهزم عن أبي هريرة تركه النسائي وضعفه جماعة(@)(@@)(@@)(@@) | 7107 - (@)(@@) يزيد بن سفيان عن سليمان التيمي له نسخه منكرة تكلم فيه ابن حبان(@)(@@)(@@)(@@) | 7108 - (@)(@@) يزيد بن أبي سلمة الأيلي ضعفه ابن معين(@)(@@)(@@)(@@) | 7109 - (@)(@@) ق / يزيد بن السمط وثقه أبو داؤد وضعفه الحاكم(@)(@@)(@@)(@@) | 7110 - (@)(@@) ت ق يزيد بن سنان أبو فروة الرهاوي مشهور ضعفه أحمد وابن المديني(@)(@@)(@@)(@@) | 7111 - (@)(@@) يزيد بن سهيل تابعي أرسل وعنه عمرو بن الحارث مجهول(@)(@@)(@@)(@@) | 7112 - (@)(@@) يزيد بن شداد عن معاوية بن قرة مجهول(@)(@@)(@@)(@@) | 7113 - (@)(@@) د ت ق / يزيد بن شريح الحمصي تابعي صالح الحديث قال الدارقطني يعتبر به(@)(@@)(@@)(@@) | 7114 - (@)(@@) د / يزيد بن صالح أو ابن صبح تابعي حمصي نكرة(@)(@@)(@@)(@@) | 7115 - (@)(@@) يزيد بن صالح اليشكري النيسأبوري الفراء مجهول قلت بل مشهور صدوق(@)(@@)(@@)(@@) | 7116 - (@)(@@) يزيد بن عبد الله البغدادي بيض له مجهول ومثله(@)(@@)(@@)(@@) | 7117 - (@)(@@) ق / يزيد بن عبد الله شيخ لمكحول(@)(@@)(@@)(@@) | 7118 - (@)(@@) ع / يزيد بن عبد ا