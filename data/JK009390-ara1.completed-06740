ms6721	 ، وفي صوته صحل ، PageV19P289 وفي عنقه سطع ، وفي لحيته كثاثة ، أزج ، أقرن ، إن صمت فعليه الوقار ، وإن تكلم سماه وعلاه البهاء ، أجمل الناس وأبهاه من بعيد ، وأحلاه وأحسنه من قريب ، حلو المنطق ، فصل ، لا هذر ولا نزر ، كأن منطقه خرزات نظم يتحدرن ، ربع لا تشنؤه من طول ، ولا تقتحمه عين من قصر ، غصن بين غصنين ، فهو أنظر الثلاثة منظرا ، وأحسنهم قدرا ، له رفقاء يحفون به ، إن قال أنصتوا لقوله ، وإن أمر تبادروا إلاى أمره ، محفود محشود ، لا عابس ولا مفند ، قال أبو معبد : هو والله صاحب قريش الذي ذكر لنا من أمره ما ذكر بمكة ، ولقد هممت أن أصحبه ، ولأفعلن إن وجدت إلاى ذالك سبيلا ، فأصبح صوت بمكة عاليا ، يسمعون الصوت ولا يدرون من صاحبه ، وهو يقول :(@)(@@) جزاى الله رب الناس خير جزائه %~% رفيقين قالا خيمتي أم معبد(@)(@@) هما نزلاها بالهداى واهتدت به %~% فقد فاز من أمساى رفيق محمد(@)(@@) فيا لقصي ما زواى الله عنكم %~% به من فعال لا تجازاى وسؤدد(@)(@@) ليهن بني كعب مكان فتاتهم %~% ومقعدها للمؤمنين بمرصد(@)(@@) سلوا أختكم عن شاتها وإنائها %~% فإنكم إن تسألوا الشاة تشهد(@)(@@) دعاها بشاة حائل فتحلبت %~% عليه صريحا ضره الشاة مزبد(@)(@@) فغادرها رهنا لديها بحالب %~% يرددها في مصدر ثمص مورد(@)(@@) فلما أن سمع حسان بن ثابت بذالك ، شبب يجيب الهاتف وهو يقول :(@)(@@) PageV19P290(@)(@@) لقد خاب قوم زال عنهم نبيهم %~% ووقدس من يسري إليه ويغتدي(@)(@@) ترحل عن قوم فضلت عقولهم %~% وحل علاى قوم بنور مجدد(@)(@@) هداهم به بعد الضلالة ربهم %~% وأرشدهم من يتبع الحق يرشد(@)(@@) وهل يستوي ضلال قوم تسكعوا %~% عمايتهم هاد به كل مهتد(@)(@@) وقد نزلت منه علاى أهل يثرب %~% ركاب هدى حلت عليهم بأسعد(@)(@@) نبي يراى ما لا يراى الناس حوله %~% ويتلو كتاب الله في كل مسجد(@)(@@) وإن قال في يوم مقالة غائب %~% فتصديقها في اليوم أو في ضحاى الغد(@)(@@) ليهن بني كعب مكان فتاتهم %~% ومقعدها للمؤمنين بمرصد(@)(@@) ليهن أبا بكر سعادة جده %~% بصحبته ، من أسعد الله يسعد(@)(@@) ( طب ، وأبو نعيم ، كر ) . )(@)(@@) | 197(@)(@@)(@@)(@@) $ 3 
ms6722	 ( حبة وسواء ابني خالد رضي الله عنهما ) 3 $(@)(@@)(@@)(@@) $ 14517 عن سلام بن شرحبيل :(@)(@@) | 30 ( أنه سمع حبة وسواء ابني خالد رضي الله عنهما أنهما أتيا النبي وهو يعالج حائطا أو بناء له فأعاناه عليه ، فقال : لا تيأسا من الرزق ما اعتزت رءوسكما ، إن المولود يولد أحمر ليس عليه قشر ، ثم يرزقه الله عز وجل ) . ( أبو نعيم ) . )(@)(@@)(@@)(@@) |||| 198 ( حجر بن علي أو عدي الكندي رضي الله عنه )(@)(@@)(@@)(@@) $ 14518 عن حجر بن عدي الكندي رضي الله عنه :(@)(@@) | 30 ( أنه لما انطلق به PageV19P291 ليقتل ، قال لهم : دعوني فلاصلي ركعتين ، فصلق ركعتين ، ثم قال : لا تطلقوا عني حديدا ، ولا تغسلوا عني دما وادفنوني في ثيابي ، فإني ملاق معاوية بالجادة ، وإني مخاصم ) . ( كر ) . )(@)(@@)(@@)(@@) |||| 199 ( حجر بن عنبس وقيل ابن قيس الكندي رضي الله عنه )(@)(@@)(@@)(@@) $ 14519 عن حجر بن عنبس رضي الله عنه قال :(@)(@@) | 30 ( خطب أبو بكر وعمر فاطمة رضي الله عنهم ، فقال النبي : هي لك يا علي علاى أن تحسن صحبتها ) . ( أبو نعيم ) . )(@)(@@)(@@)(@@) |||| 200 ( حجير والد مخيش رضي الله عنه )(@)(@@)(@@)(@@) $ 14520 عن أبي مخيش بن حجير ، عن أبيه رضي الله عنه :(@)(@@) | 30 ( أن النبي خطب في حجة الوداع فقال : أيها الناس أي بلد هاذا ؟ قالوا : بلد حرام ، قال : فأي شهر هاذا ؟ قالوا : شهر حرام ، قال : فأي يوم هاذا ؟ قالوا : يوم النحر ، قال : ألا إن دماءكم وأموالكم وأعراضكم عليكم حرام ، كحرمة يومكم هاذا ، كحرمة شهركم هاذا ، فليبلغ شاهدكم غائبكم ، لا ترجعوا بعدي كفارا يضرب بعضكم رقاب بعض ) . ( أبو نعيم ) . )(@)(@@)(@@)(@@) |||| 201 ( حدير أبي فوزة السلمي رضي الله عنه )(@)(@@)(@@)(@@) $ 14521 عن بشير مولاى معاوية قال :(@)(@@) | 30 ( سمعت عشرة من أصحاب النبي أحدهم حدير أبو فوزة يقول : إذا رأوا الهلال : اللهم اجعل شهرنا الماضي خير شهر ، وخير عاقبة ، وأرسل علينا شهرنا هاذا بالسلامة والإسلام ، PageV19P292 والأمن والإيمان ، والمعافاة والرزق الحسن ) . ( خ في تاريخه ، وابن منده ، وقال : الصواب أبو فوزة ، والدولابي في الكنى ، وابن نعيم ، كر ) . )(@)(@@)(@@)(@@) $ 14522 عن عثمان بن أبي العاتكة : حدثني أخ لي يقال له : زياد :(@)(@@) | 30 ( أن 
ms6723	 النبي كان إذا رأى الهلال قال : اللهم بارك لنا في شهرنا هاذا الداخل ، فذكر الحديث ، وقال : توالاى علاى هاذا الدعاء ستة من أصحاب النبي سمعوه منه ، والسابع حدير أبو فوزة السلمي رضي الله عنه ) . ( ابن منده ، كر ) . )(@)(@@)(@@)(@@) |||| 202 ( حذيفة بن أسيد الغفاري رضي الله عنه )(@)(@@)(@@)(@@) $ 14523 عن أبي الطفيل عامر بن واثلة ، عن حذيفة بن أسيد الغفاري رضي الله عنه قال :(@)(@@) | 30 ( لما صدر رسول الله من حجة الوداع ، نهاى أصحابه عن شجرات بالبطحاء متقاربات أن ينزلوا تحتهن ، ثم بعث إليهن فقم ما تحتهن من الشوك وشذبن ، عن رؤوس القوم ، ثم عمد إليهن فصلى تحتهن ، ثم قام فقال : أيها الناس إنه قد نبأني اللطيف الخبير أنه لم يعمر نبي إلا مثل نصف عمر النبي الذي من قبله ، وإني لأظن أني موشك أن أدعاى فأجيب ، وأني مسؤول وأنكم مسؤولون ، فماذا أنتم قائلون ؟ قالوا : نشهد أنك قد بلغت ونصحت ، فجزاك الله خيرا ، قال : ألستم تشهدون أن لا إلاه إلا الله ، وأن محمدا عبده ورسوله ، وأن جنته حق ، وناره حق ، وأن الموت حق ، وأن الساعة آتية لا ريب فيها ، وأن الله يبعث من في القبور ؟ قالوا : نشهد بذالك ، قال : اللهم اشهد ، ثم قال : أيها الناس إن الله مولاي ، وأنا مولاى المؤمنين ، وأنا أولاى PageV19P293 بالمؤمنين من أنفسهم ، فمن كنت مولاه فعلي مولاه ، اللهم وال من والاه ، وعاد من عاداه ، ثم قال : أيها الناس إني فرطكم وأنتم واردون علاى الحوض ، حوض عرضه ما بين بصراى وصنعاء ، فيه عدد النجوم قدحان من فضة ، وإني سائلكم حين تردون علي عن الثقلين ، فانظروا كيف تخلفوني فيهما ، الثقل الأكبر : كتاب الله سبب طرفه بيد الله ، وطرف بأيديكم ، فتمسكوا به ، لا تضلوا ولا تبدلوا ، وعترتي أهل بيتي ، وإنه قد نبأني اللطيف الخبير أنهما لن يفترقا حتى يردا علي الحوض ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 14524 عن حذيفة بن أسيد الغفاري رضي الله عنه قال :(@)(@@) | 30 ( سأل رجل رسول الله عن الساعة ؟ فقال : ما أعددت لها ؟ قال : ما أعددت لها كبيرا ، إلا أني أحب 
ms6724	 الله ورسوله ، قال : فأنت مع من أحببت ) . ( طب ، عن أبي سرعة ) . )(@)(@@)(@@)(@@) $ 14525 عن أبي الطفيل ، عن حذيفة بن أسيد رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله :(@)(@@) $ 30 عرضت علي أمتي البارحة أدناى هاذه الشجرة ، من أولها إلاى آخرها ، فقال رجل : يا رسول الله هاذا عرض عليك من خلق ، فكيف عرض عليك من لم يخلق ؟ قال : صوروا لي في الطين ، حتى لأنا أعرف بالإنسان منهم من أحدكم بصاحبه ) . ( الحسن بن سفيان ، طب ، ض ، وأبو نعيم ) . ) $(@)(@@)(@@)(@@) $ 14525 عن أبي الطفيل ، عن حذيفة بن أسيد رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله :(@)(@@) $ 30 عرضت علي أمتي البارحة أدناى هاذه الشجرة ، من أولها إلاى آخرها ، فقال رجل : يا رسول الله هاذا عرض عليك من خلق ، فكيف عرض عليك من لم يخلق ؟ قال : صوروا لي في الطين ، حتى لأنا أعرف بالإنسان منهم من أحدكم بصاحبه ) . ( الحسن بن سفيان ، طب ، ض ، وأبو نعيم ) . ) $(@)(@@)(@@)(@@) $ 14526 عن حذيفة بن أسيد الغفاري رضي الله عنه قال :(@)(@@) | 30 ( الدابة تكون لها ثلاث خرجات من الدهر : فتخرج خرجة من أقصاى اليمن ، حتى ينشر ذكرها في أهل البادية ولا يدخل ذكرها القرية يعني مكة ، ثم تمكث زمانا طويلا بعد ذالك ، ثم تخرج خرجة أخراى قريبا من مكة ، فينتشر ذكرها في أهل البادية ، وينشر ذكرها بمكة ، ثم تكمن زمانا طويلا ، ثم بينما الناس يوما بأعظم المساجد PageV19P294 علاى الله حرمة وخيرها وأكرمها علاى الله المسجد الحرام ، لم يرعهم إلا وهي في ناحية المسجد ترغو ما بين الركن والمقام إلاى باب بني مخزوم علاى يمين الخارج من المسجد ، تنفف عن رأسها التراب ، فارفض الناس عنها شتي ومعا ، وتثبت لها عصابة من المؤمنين ، وعرفوا أنهم لن يعجزوا الله ، فبدت بهم فجلت وجوههم حتى تجعلها كأنها الكواكب الدرية ، ثم ولت في الأرض لا يدركها طالب ، ولا يعجزها هارب ، حتى أن الرجل ليقوم يتعوذ منها بالصلاة ، فتأتيه من خلفه فتقول : يا فلان الآن تصلي فيقبل عليها بوجهه ، فتسمه في وجهه ثم تذهب ، ويتجاور الناس في دورهم 
ms6725	 وفي أسفارهم ، ويشتركون في الأموال ، ويصطحبون في الأمصار ويعرف المؤمن من الكافر ، حتى أن المؤمن ليقول للكافر : يا كافر أقضني حقي ، وحتى أن الكافر ليقول للمؤمن : يا مؤمن أقضني حقي ) . ( ط ، طب ، ك ، وتعقب ، هق ، في البعث ، وعبد بن حميد في تفسيره ، عن أبي الطفيل ، عن حذيفة بن أسيد الغفاري رضي الله عنه ) . )(@)(@@)(@@)(@@) $ 14527 عن حذيفة بن أسيد الغفاري رضي الله عنه قال :(@)(@@) | 30 ( بلغ رسول الله موت النجاشي ، فقال لأصحابه : إن أخاكم النجاشي قد مات ، فمن أراد أن يصلي عليه فليصل عليه فتوجه رسول الله نحو الحبشة فكبر أربعا ) . ( طب ) . )(@)(@@)(@@)(@@) $ 14528 عن حذيفة بن أسيد ، عن عطاء رضي الله عنه :(@)(@@) | 30 ( أن النبي نعاى الثلاثة الذين قتلوا بمؤتة ، ثم صلى عليهم ) . ( ش ) . )(@)(@@)(@@)(@@) |||| 203 ( حذيفة بن اليمان رضي الله عنه )(@)(@@)(@@)(@@) $ 14529 عن حذيفة رضي الله عنه :(@)(@@) | 30 ( أنه قيل له : ما النفاق ؟ قال : الرجل يتكلم بالإسلام ولا يعمل به ) . ( ابن جرير ) . )(@)(@@) PageV19P295(@)(@@)(@@)(@@) $ 14530 عن أبي يحيى قال :(@)(@@) | 30 ( سئل حذيفة رضي الله عنه : من المنافق ؟ قال : الذي يصف الإسلام ولا يعمل به ) . ( ش ) . )(@)(@@)(@@)(@@) $ 14531 عن حذيفة رضي الله عنه قال :(@)(@@) | 30 ( المنافقون الذين فيكم اليوم شر من المنافقين الذين كانوا علاى عهد رسول الله ، إن أولائك كانوا يسرون نفاقهم ، وإن هاؤلاء أعلنوه ) . ( ش ) . )(@)(@@)(@@)(@@) $ 14532 عن أبي البختري قال : $ 30 ( قال رجل : اللهم أهلك المنافقين ، قال حذيفة رضي الله عنه : لو هلكوا ما انتصفتم من عدوكم ) . ( ش ) .(@)(@@)(@@)(@@) $ 14533 عن صلة بن زفر قال :(@)(@@) | 30 ( قلنا لحذيفة رضي الله عنه كيف عرفت أمر المنافقين ولم يعرفه أحد من أصحاب رسول الله ولا أبو بكر ولا عمر رضي الله عنهما ؟ قال : إني كنت أسير خلف رسول الله فنام علاى راحلته ، فسمعت ناسا يقولون : لو طرحناه عن راحلته فاندقت عنقه فاسترحنا منه ، فسرت بينهم وبينه ، فجعلت أقرأ وأرفع صوتي ، حتى انتبه النبي قال : من هاذا ؟ قلت : حذيفة ، قال : من هاؤلاء ؟ قلت : فلان وفلان حتى عددتهم ، قال : وسمعت ما قالوا ؟ قلت : نعم ، ولذالك سرت بينك وبينهم 
ms6726	 ، قال : أما إنهم منافقون : فلان وفلان ، لا تخبرن أحدا ) . ( طب ) . )(@)(@@)(@@)(@@) $ 14534 عن حذيفة رضي الله عنه قال :(@)(@@) | 30 ( مر بي عمر بن الخطاب رضي الله عنه وأن جالس في المسجد ، فقال لي : يا حذيفة إن فلانا قد مات فاشهده ، ثم مضاى ، حتى إذا كاد أن يخرج من المسجد التفت إلي فرآني وأنا جالس فعرف ، فرجع إلي فقال : يا حذيفة أنشدك الله أمن القوم أنا ؟ قلت : اللهم لا ، ولن أبرىء أحدا بعدك فرأيت عيني عمر جادتا ) . ( كر ) . )(@)(@@)(@@)(@@) $ 14535 عن حذيفة رضي الله عنه قال :(@)(@@) | 30 ( من فارق الجماعة شبرا خلع ربقة الإسلام من عنقه ) . ( ش ) . )(@)(@@) PageV19P296(@)(@@)(@@)(@@) $ 14536 عن حذيفة رضي الله عنه قال :(@)(@@) | 30 ( إني لأعرف أهل دينين هما في النار : قوم يقولون : الإيمان كلام ، وقوم يقولون : ما بال الصلوات الخمس ، وإنما هما صلاتان ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 14537 عن حذيفة بن اليمان رضي الله عنه قال :(@)(@@) | 30 شكوت إلاى رسول الله ذرب لساني ، قال : أين أنت من الاستغفار ، إني لأستغفر الله في كل يوم مائة مرة ) . ( ش ) . )(@)(@@)(@@)(@@) $ 14538 عن حذيفة رضي الله عنه :(@)(@@) | 30 ( أنه قرأ هاذه الآية : { فقاتلوا أئمة الكفر } ، قال : ما قوتل أهل هاذه الآية بعد ) . ( ش ) . )(@)(@@)(@@)(@@) $ 14539 عن حذيفة رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : يا أبا بكر أرأيت لو أنك وجدت رجلا مع أم رومان كيف كنت صانعا ؟ قال : كنت والله فاعلا شرا ، قال : فأنت يا عمر ؟ قال : والله كنت قاتله ، قال : فأنت يا سهل ؟ قال : كنت أقول لعن الله الأبعد ، هو خبيث ، ولعن الله البعداى فهي خبيثة ، ولعن الله أول الثلاثة أخبر بهاذا ، قال : تأولت القرآن يا ابن البيضاء : { والذين يرمون أزواجهم } ) . ( الديلمي ) . )(@)(@@)(@@)(@@) $ 14540 عن حذيفة رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : يبعث الناس ثلاثة أصناف ، وذالك في قول الله عز وجل : { فمنهم ظالم لنفسه ، ومنهم مقتصد ، ومنهم سابق بالخيرات } فالسابق بالخيرات يدخل الجنة بغير حساب ، والمقتصد يحاسب حسابا يسيرا ، والظالم لنفسه يدخل الجنة برحمة الله ) . ( الديلمي ) . )(@)(@@) PageV19P297(@)(@@)(@@)(@@) $ 14541 عن حذيفة رضي الله عنه قال 
ms6727	 :(@)(@@) | 30 ( إن الأمر بالمعروف والنهي عن المنكر حسن ، وليس من السنة أن ترفع السلاح علاى إمامك ) . ( ش ، ونعيم ) . )(@)(@@)(@@)(@@) $ 14542 عن حذيفة رضي الله عنه قال :(@)(@@) | 30 ( إن كان الرجل ليتكلم الكلام علاى عهد النبي ، فيصير منافقا ، إني لأسمعها من أحدكم في المقعد الواحد أربع مرات ، لتأمرن بالمعروف ولتنهون عن المنكر ، ولتحاضن علاى الخير ، أو يسحتنكم الله بعذاب جميعا ، أو ليؤثرن عليكم شراركم ، ثم يدعو خياركم فلا يستجاب لهم ) . ( ش ) . )(@)(@@)(@@)(@@) $ 14543 عن حذيفة رضي الله عنه قال :(@)(@@) | 30 ( ليأتين عليكم زمان ، خيركم فيه من لا يأمر بالمعروف ، ولا ينهاى عن المنكر ) . ( ش ) . )(@)(@@)(@@)(@@) $ 14544 عن حذيفة رضي الله عنه قال :(@)(@@) | 30 ( كان شاب علاى عهد رسول الله يبكي عند ذكر النار ، حتى حبسه ذالك في البيت ، فذكر ذالك للنبي ، فأتاه النبي ، فلما نظر إليه الشاب ، قام فاعتنقه وخر ميتا ، فقال النبي : جهزوا صاحبكم ، فإن الفرق من النار فلذ كبده ، والذي نفسي بيده لقد أعاذه الله منها ، من رجا شيئا طلبه ، ومن خاف من شيء هرب منه ) . ( ابن أبي الدنيا ، والموفق بن قدامة في كتاب البكاء والرقة ) . )(@)(@@)(@@)(@@) $ 14545 عن حذيفة رضي الله عنه قال :(@)(@@) | 30 ( ليس خياركم من ترك الدنيا للآخرة ، ولا من ترك الآخرة للدنيا ، ولاكن خياركم من أخذ من كل ) . ( كر ) . )(@)(@@)(@@)(@@) $ 14546 عن حذيفة رضي الله عنه قال :(@)(@@) | 30 ( خياركم الذين يأخذون من دنياهم لآخرتهم ، ومن آخرتهم لدنياهم ) . ( كر ) . )(@)(@@)(@@)(@@) $ 14547 عن حذيفة رضي الله عنه قال :(@)(@@) | 30 ( لوددت أن لي من يصلح من مالي ، فأغلق بابي ، فلا يدخل علي أحد ، ولا أخرج إليهم حتى ألحق بالله ) . ( ك ) . )(@)(@@) PageV19P298(@)(@@)(@@)(@@) $ 14548 عن النزال بن سبرة قال :(@)(@@) | 30 ( كنا مع حذيفة رضي الله عنه في البيت ، فقال له عثمان رضي الله عنه : ما هاذا الذي يبلغني عنك ؟ فقال : ما قلته ، فقال عثمان : أنت أصدقهم وأبرهم ، فلما خرج قلت له : ألم تقل ما قلته ؟ قال : بلاى ، ولاكن أشتري ديني ببعضه مخافة أن يذهب كله ) . ( كر ) . )(@)(@@)(@@)(@@) $ 14549 عن حذيفة رضي الله عنه :(@)(@@) | 30 ( أنه قيل له : ما 
ms6728	 لك لا تتكلم ؟ قال : إن لساني سبع أتخوف إن تركته أن يأكلني ) . ( كر ) . )(@)(@@)(@@)(@@) $ 14550 عن حذيفة رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : إن مما أتخوف عليكم رجلا قرأ القرآن ، حتى إذا رؤيت بهجته وكان ردء الإسلام أعراه إلاى ما شاء الله وانسلخ منه ، ونبذه وراء ظهره ، وخرج علاى جاره بالسيف ، ورماه بالشرك ، قلت : يا رسول الله أيهما أولاى بالشرك ؟ المرمي أو الرامي ؟ قال : لا بل الرامي ) . ( أبو نعيم ) . )(@)(@@)(@@)(@@) $ 14551 عن أبي داود الأحمدي قال :(@)(@@) | 30 ( خطبنا حذيفة رضي الله عنه بالمدائن ، فقال : أيها الناس تفقدوا أرقاءكم ، واعلموا من أين يأتونكم بضرائبهم ، فإن لحما نبت من سحت لن يدخل الجنة أبدا ، واعلموا أن بائع الخمر ومبتاعه ومقتنيه كآكله ) . ( عب ) . )(@)(@@)(@@)(@@) $ 14552 عن حذيفة رضي الله عنه قال :(@)(@@) | 30 ( لو لم تذنبوا وتخطئوا لجاء الله بقوم يذنبون ويخطئون فيغفر الله لهم يوم القيامة ) . ( خ ، في تاريخه ، كر ) . )(@)(@@)(@@)(@@) $ 14553 عن حذيفة رضي الله عنه قال :(@)(@@) | 30 ( لما قبض رسول الله واستخلف أبو بكر رضي الله عنه ، قيل له في الحكم بن العاص ؟ فقال : ما كنت لأحل عقدة عقدها رسول الله ) . ( طب ، وأبو نعيم ) . )(@)(@@) PageV19P299(@)(@@)(@@)(@@) $ 14554 عن زنكل بن علي وزير لعمر بن عبد العزيز قال :(@)(@@) | 30 ( قال حذيفة بن اليمان رضي الله عنه : يا طاعون خذني إليك ثلاث مرات ، قبل سفك دم حرام ، وقبل جور في الحكم ، وقبل إمارة الصبيان ، وكثرة الزبانية ) . ( كر ) . )(@)(@@)(@@)(@@) $ 14555 عن حذيفة رضي الله عنه قال :(@)(@@) | 30 ( ألا لا يمش رجل منكم شبرا إلاى ذي سلطان ليذله ، فلا والله لا يزال قوم أذلوا السلطان أذلاء إلاى يوم القيامة ) . ( ش ) . )(@)(@@)(@@)(@@) $ 14556 عن حذيفة رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : اسمعوا ، قلنا : سمعنا ، قال : اسمعوا ثلاثا : إنه سيكون عليكم أمراء يكذبون ويظلمون ، فمن دخل عليهم ، فصدقهم بكذبهم ، وأعانهم علاى ظلمهم ، فليس مني ولا أنا منه ، ولن يرد علي الحوض ، ومن لم يدخل عليهم ، ولم يصدقهم بكذبهم ، ولم يعنهم علاى ظلمهم ، فهو مني وأنا منه ، وهو وارد علي الحوض ) . ( ابن 
ms6729	 جرير ) . )(@)(@@)(@@)(@@) $ 14557 عن عقيل بن دينار مولاى حارثة ، عن حارثة بن ظفر :(@)(@@) | 30 ( أن حصارا كان وسط دار ، فاختصموا إلاى النبي فيه ، فبعث حذيفة بن اليمان رضي الله عنه فذكر نحوه ) . ( أبو نعيم ) . )(@)(@@)(@@)(@@) $ 14558 عن حذيفة رضي الله عنه قال :(@)(@@) | 30 ( إن العبد إذا توضأ فأحسن وضوءه ، ثم قام إلاى الصلاة ، استقبله الله بوجهه يناجيه فلم يصرفه عنه حتى يكون هو الذي ينصرف ، أو يلتفت يمينا أو شمالا ) . ( عب ) . )(@)(@@)(@@)(@@) $ 14559 عن بريدة :(@)(@@) | 30 ( أن النبي استعمل حذيفة رضي الله عنه علاى بعض الصدقة ، فلما قدم ، قال : يا حذيفة هل رزىء من الصدقة شيء ؟ PageV19P300 قال : لا ، يا رسول الله أنفقنا بقدر ، إلا أن ابنة لي ، أخذت جديا من الصدقة ، قال : كيف بك يا حذيفة إذا ألقيت في النار ، وقيل لك ائتنا به فبكاى حذيفة ، ثم بعث إليها ، فجيء به فألقاه في الصدقة ) . ( كر ) . )(@)(@@)(@@)(@@) $ 14560 عن حذيفة رضي الله عنه قال :(@)(@@) | 30 ( لا وتر إلا علاى من تلا القرآن ) . ( عب ) . )(@)(@@)(@@)(@@) $ 14561 عن حذيفة بن اليمان رضي الله عنه قال :(@)(@@) | 30 ( صليت مع النبي ، فكان ركوعه نحوا من قيامه ، ثم قال : سمع الله لمن حمده ، ثم قام طويلا ) . ( ش ) . )(@)(@@)(@@)(@@) $ 14562 عن شقيق قال :(@)(@@) | 30 ( كنت أنا وحذيفة رضي الله عنه إذ جاء رجل يصلي فبزق بين يديه ، فلما انفتل ، قال له حذيفة : لا تبزقن بين يديك ، ولا عن يمينك ، فإن عن يمينك كاتب الحسنات ، وابزق عن يسارك ، أو خلفك ، فإن الرجل إذا قام يصلي استقبله الله عز وجل بوجهه ، فلا يصرفه حتى يكون هو الذي يصرفه ، أو يحدث حدث سوء ) . ( كر ) . )(@)(@@)(@@)(@@) $ 14563 عن زيد بن وهب قال :(@)(@@) | 30 ( دخل حذيفة رضي الله عنه المسجد ، فإذا رجل يصلي لا يتم الركوع والسجود ، فلما انصرف قال له حذيفة : مذ كم هاذه صلاتك ؟ قال : مذ أربعين سنة ، فقال حذيفة : ما صليت مذ أربعين سنة ، ولو مت وهاذه صلاتك مت علاى غير الفطرة التي فطر عليها محمد ، ثم أقبل عليه يعلمه ، فقال : إن الرجل ليخفف الصلاة ، ويتم 
ms6730	 الركوع والسجود ) . ( عب ، ش ، خ ، ن ) . )(@)(@@)(@@)(@@) $ 14564 عن قتادة :(@)(@@) | 30 ( أن أبا سعيد مولاى بني أسيد صنع طعاما ، ثم دعا أبا ذر وحذيفة وابن مسعود رضي الله عنهم ، فحضرت الصلاة ، فتقدم أبو ذر ليصلي بهم ، فقال له حذيفة : وراءك رب البيت أحق بالإمامة ، فقال له أبو ذر : PageV19P301 كذالك يا ابن مسعود ؟ قال : نعم فتأخر أبو ذر ، قال أبو سعيد : فقدموني وأنا مملوك فأممتهم ) . ( عب ) . )(@)(@@)(@@)(@@) $ 14565 عن حذيفة بن اليمان رضي الله عنه قال :(@)(@@) | 30 ( صليت مع رسول الله ، فافتتح البقرة ، فقلت : يختمها فيركع بها ، ثم افتتح آل عمران ، فقلت : يختمها ، فيركع بها ، ثم افتتح النساء ، فقلت : يركع بها ، فقرأ حتى ختمها ) . ( ش ) . )(@)(@@)(@@)(@@) $ 14566 عن حذيفة رضي الله عنه قال :(@)(@@) | 30 ( مررت بالنبي ليلة وهو يصلي في المسجد فقمت أصلي وراءه ، يخيل إلي أنه لا يعلم ، فاستفتح سورة البقرة ، فقلت : إذا جاء مائة آية ركع ، فجاءها فلم يركع ، فقلت : إذا جاء مائتي آية ركع ، فجاءها فلم يركع ، فقلت : إذا ختمها ركع ، فختم فلم يركع ، فلما ختم قال : اللهم لك الحمد وترا ، ثم افتتح آل عمران فقلت : إن ختمها ركع فلم يركع ، وقال : اللهم لك الحمد ثلاث مرات ، ثم افتتح سورة النساء ، فقلت : إذا ختم ركع ، فختمها فركع ، فسمعته يقول : سبحان ربي العظيم ويرجع شفتيه فأعلم أنه يقول غير ذالك ، ثم سجد فسمعته يقول : سبحان ربي الأعلاى ويرجع شفتيه ، فأعلم أنه يقول غير ذالك ، فلا أفهم غيره ، ثم افتتح سورة الأنعام ، فتركته وذهبت ) . ( عب ) . )(@)(@@)(@@)(@@) $ 14567 عن سعيد بن العاص :(@)(@@) | 30 ( أنه قال في غزوة ومعه حذيفة رضي الله عنه : أيكم شهد مع رسول الله صلاة الخوف ؟ فقال حذيفة : أنا ، فأمرهم حذيفة فلبسوا السلاح ، ثم قال : إن هاجكم هيج فقد حل لكم القتال ، فصلى بإحداى الطائفتين ركعة ، والاخراى مواجهة العدو ، ثم انصرف هاؤلاء ، فقاموا مقام PageV19P302 أولائك ، وجاء أولائك فصلى بهم ركعة أخراى ، ثم سلم عليهم ) . ( عب ، ش ، وعبد بن حميد ، د ، ن ، وابن جرير ، هب ، ك ، هق ) . )(@)(@@)(@@)(@@) $ 14568 عن قتادة :(@)(@@) | 30 ( أن حذيفة 
ms6731	 ركع بالمدائن ثلاث ركعات ، ثم سجد سجدتين ، وفعل في الاخراى مثل ذالك ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 14569 عن الحسن العربي :(@)(@@) | 30 ( أن حذيفة صلى في الكسوف ست ركعات وأربع سجدات ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 14570 عن منصور ، عن طلحة بن مصرف ، وحذيفة بن اليمان رضي الله عنه قالا :(@)(@@) | 30 ( خللوا الأصابع لا يحشوها الله نارا ) . ( عب ) . )(@)(@@)(@@)(@@) $ 14571 عن حذيفة رضي الله عنه قال :(@)(@@) | 30 ( ما أبالي مسست ذكري أو طرف أنفي ) . ( ص ) . )(@)(@@)(@@)(@@) $ ( 14572 ) عن حذيفة بن اليمان رضي الله عنه أنه قال لامرأته : خللي رأسك بالماء قبل أن يخلله الله بنار ' . ( عب ، ص ، وابن جرير ) .(@)(@@)(@@)(@@) $ 14573 عن محمد بن سيرين قال :(@)(@@) | 30 ( نبئت أن النبي رأى حذيفة رضي الله عنه فراغ عنه ، فقال : لم لم أرك ؟ فقال : بلاى يا رسول الله ولاكن كنت جنبا ، فقال : إن المؤمن لا ينجس ) . ( ص ) . )(@)(@@)(@@)(@@) $ 14574 عن حذيفة بن اليمان رضي الله عنه قال :(@)(@@) | 30 ( رأيت رسول الله أتاى سباطة قوم ، فبال قائما ، فأردت أن أتنحى ، فدعاني فدنوت منه ، ثم تنحى فأتيته بماء فتوضأ ومسح علاى خفيه ) . ( عب ، ش ، ص ) . )(@)(@@)(@@)(@@) $ 14575 عن إبراهيم :(@)(@@) | 30 ( أن عبد الله بن مسعود ، وحذيفة ابن PageV19P303 اليمان رضي الله عنهما كانا يقولان : يمسح المسافر علاى الخفين ثلاثة أيام ولياليهن ، وللمقيم يوم وليلة ) . ( عب ) . )(@)(@@)(@@)(@@) $ 14576 عن حذيفة رضي الله عنه قال :(@)(@@) | 30 ( بحسب المؤمن من العلم أن يخشاى الله عز وجل ، وبحسب المؤمن من الكذب أن يقول : أستغفر الله وأتوب إليه ثم يعود ) . ( كر ) . )(@)(@@)(@@)(@@) $ 14577 عن حذيفة رضي الله عنه قال :(@)(@@) | 30 ( كفى من العلم الخشية وكفاى من الجدال أن يذكر العالم حسناته وينساى سيئاته ، وكفاى من الكذب أن يتوب من الذنب ثم يعود إليه ) . ( كر ) . )(@)(@@)(@@)(@@) $ 14578 عن حذيفة رضي الله عنه قال :(@)(@@) | 30 ( إنا قوم عرب ، نردد الأحاديث ، فنقدم ونؤخر ) . ( هق ، كر ) . )(@)(@@)(@@)(@@) $ 14579(@)(@@) | 30 عن حذيفة رضي الله عنه قال :(@)(@@) $ 30 ( إنما يفتي أحد ثلاثة : من عرف الناسخ والمنسوخ ، أو رجل ولي سلطانا فلا يجد من ذالك بدا ، أو متكلف ) . ( كر ) . ) $(@)(@@)(@@)(@@) $ 14579(@)(@@) | 30 عن 
ms6732	 حذيفة رضي الله عنه قال :(@)(@@) $ 30 ( إنما يفتي أحد ثلاثة : من عرف الناسخ والمنسوخ ، أو رجل ولي سلطانا فلا يجد من ذالك بدا ، أو متكلف ) . ( كر ) . ) $(@)(@@)(@@)(@@) $ 14580 عن حذيفة رضي الله عنه قال :(@)(@@) | 30 ( اتقوا الله يا معشر القراء ، وخذوا طريق من كان قبلكم ، فوالله لئن استقمتم لقد سبقتم سبقا بعيدا ، ولئن تركتموه يمينا وشمالا لقد ضللتم ضلالا بعيدا ) . ( ش ، كر ) . )(@)(@@)(@@)(@@) $ 14581 عن حذيفة بن اليمان رضي الله عنه قال :(@)(@@) | 30 ( ما منعني أن أشهد بدرا إلا أني خرجت أنا وأبي حسل ، فأخذنا كفار قريش فقالوا : إنكم تريدون محمدا ؟ فقلنا : ما نريده ، ما نريد إلا المدينة ، فأخذوا منا عهد الله وميثاقه : لننصرفن إلاى المدينة ولا نقاتل معه ، فأتينا رسول الله فأخبرناه الخبر ، فقال : انصرفا ، ففيا لهم بعهدهم ، ونستعين الله عليهم ) . ( ش ، والحسن بن سفيان ، وأبو نعيم ) . )(@)(@@) PageV19P304(@)(@@)(@@)(@@) $ 14582 عن عكرمة :(@)(@@) | 30 ( أن أبا حذيفة بن اليمان رضي الله عنه يوم أحد قتله رجل من المسلمين ، وهو يراى أنه من المشركين ، فواده رسول الله من عنده ، قال : وكان اسمه حسيل بن اليمان ، أو حسل ) . ( أبو نعيم ) . )(@)(@@)(@@)(@@) $ 14583 عن زيد بن أسلم قال :(@)(@@) | 30 ( قال رجل لحذيفة رضي الله عنه : أشكو إلاى الله تعالاى صحبتكم رسول الله ، فإنكم أدركتموه ولم ندركه ، ورأيتموه ولم نره ، قال حذيفة رضي الله عنه : ونحن نشكو إلاى الله إيمانكم به ولم تروه ، والله ما أدري لو أنك أدركته كيف كنت تكون ؟ لقد رأيتنا مع رسول الله ليلة الخندق ، ليلة باردة مطيرة ، إذ قال رسول الله : هل من رجل يذهب فيعلم لنا علم القوم ، جعله الله رفيق إبراهيم يوم القيامة ؟ فما قام منا أحد ، ثم قال : هل من رجل يذهب فيعلم لنا علم القوم أدخله الله الجنة ؟ فوالله ما قام منا أحد ، ثم قال : هل من رجل يذهب فيعلم لنا علم القوم ، جعله الله تعالاى رفيقي في الجنة ؟ فما قام منا أحد فقال أبو بكر رضي الله عنه : يا رسول الله ابعث حذيفة ، قال حذيفة : فقلت : دونك ، فوالله ما 
ms6733	 قال رسول الله : يا حذيفة حتى قلت : يا رسول الله بأبي وأمي أنت ، والله ما بي أن أقتل ، ولاكن أخشاى أن أؤسر ، فقال رسول الله : إنك لن تؤسر ، فقلت : يا رسول الله مرني بما شئت ، فقال : اذهب حتى تدخل في القوم ، فتأتي قريشا ، فتقول : يا معشر قريش إنما يريد الناس أن يقولوا غدا : أين قريش ؟ أين قادة الناس ؟ أين رءوس الناس ؟ تقدموا فتقدموا ، فتصلوا بالقتال ، فيكون القتل بكم ، ثم ائت كنانة ، فقل : يا معشر كنانة إنما يريد الناس غدا أن يقولوا : أين كنانة ؟ أين رماة الحدق ، تقدموا فتقدموا فتصلوا بالقتال فيكون القتل بكم ، ثم ائت قيسا ، فقل : يا معشر قيس إنما يريد الناس غدا أن يقولوا : أين قيس ؟ أين أحلاس الخيل ؟ أين فرسان الناس ؟ تقدموا فتقدموا فتصلوا بالقتال ، ويكون القتل بكم ، ثم قال لي : ولا تحدث في سلاحك شيئا ، قال ححيفة : فذهبت ، فكنت بين ظهراني PageV19P305 القوم أصطلي معهم علاى نيرانهم ، وأذكر لهم القول الذي قال لي رسول الله : أين قريش ؟ أين كنانة ؟ أين قيس ؟ حتى إذا كان وجه السحر ، قام أبو سفيان يدعو باللات والعزى ويشرك ، ثم قال : لينظر رجل من جليسه ؟ قال : ومعي رجل يصطلي ، قال : فوثبت عليه مخافة أن يأخذني ، فقلت : من أنت ؟ قال : أنا فلان ، قلت : أولاى ، فلما رأى أبو سفيان الصبح ، قال أبو سفيان : نادوا أين قريش ؟ أين رءوس الناس ؟ أين قادة الناس ؟ تقدموا ، قالوا : هاذه المقالة التي أتينا بها البارحة ، ثم قال : أين كنانة ؟ أين رماة الحدق ، تقدموا ، فقالوا : هاذه المقالة التي أتينا بها البارحة ثم قال : أين قيس ؟ أين فرسان الناس ، أين أحلاس الخيل ؟ تقدموا ، فقالوا هاذه المقالة التي أتينا بها البارحة ، قال : فخافوا فتخاذلوا ، وبعث الله عليهم الريح ، فما تركت لهم بناء إلا هدمته ، ولا إناء إلا كفأته ، وتنادوا بالرحيل ، قال حذيفة : حتى رأيت أبا سفيان ، وثب علاى جمل له معقول ، فجعل يستحثه للقيام ، ولا يستطيع القيام لعقاله ، فقال حذيفة : فوالله لولا ما قال لي رسول الله : ولا تحدث في سلاحك شيئا لرميته 
ms6734	 من قريب ، قال : وسار القوم ، وجئت رسول الله ، فضحك حتى رأيت أنيابه ) . ( د ، كر ) . )(@)(@@)(@@)(@@) $ 14584 عن حذيفة رضي الله عنه قال :(@)(@@) | 30 ( سمعت رسول الله يقول يوم الخندق : شغلونا عن صلاة العصر فلم يصلها يومئذ حتى غابت الشمس ملاء الله تعالاى بيوتهم وقبورهم نارا ) . ( هق في عذاب القبر ) . )(@)(@@)(@@)(@@) $ 14585 عن وهب ، أنبأنا سعيد بن عبد الرحمان الجشمي رجل من الأنصار من بني سلمة ، عن أبيه ، عن جده ابن جهاد ، وكان ابن جهاد من أصحاب رسول الله أن ابنه قال :(@)(@@) | 30 ( يا أبتاه رأيتم رسول الله وصحبتموه ، والله لو رأيته لفعلت وفعلت ، فقال : يا بني اتق الله وسدد ، فو الذي نفسي بيده ، لقد رأيتنا معه يوم الخندق ، وهو يقول : من يذهب فيأتيني بخبرهم جعله PageV19P306 الله رفيقي يوم القيامة ؟ فما قام من الناس أحد من صميم ما بنا من الجوع والقر ، ثم ناداى يا حذيفة باسمه فقال : يا رسول الله والذي نفسي بيده ، ما منعني أن أقوم إلا خشية أن لا آتيك بخبرهم ، فقال : اذهب ودعا له رسول الله بخير ) . ( كر ) . )(@)(@@)(@@)(@@) $ 14586 عن حذيفة رضي الله عنه :(@)(@@) | 30 ( أن النبي بعث بعثا إلاى دومة الجندل ، فقال : إنكم ستجدون أكيدر خارجا يتصيد الصيد فخذوه ، فانطلقوا فوجدوه كما قال رسول الله ، فأخذوه وعلوا أهل المدينة وأشرفوا علاى المسلمين يكلمونهم ، فقال رجل من المسلمين : أذكرك الله ، هل تجدون محمدا في كتابكم ؟ فقال : لا ، فقال رجل إلاى جنبه : إنا نجده في كتابنا فقال الرجل لأبي بكر رضي الله عنه : يا أبا بكر أليس قد كفر هاؤلاء الآن ؟ قال : بلاى فاسكت ، وأنتم سوف تكفرون ، وسكت الرجل ودخل البيت ، وخرج مسيلمة يتنبأ ، فقال رجل : سمعتك تقول ونحن بدومة الجندل وأنتم سوف تكفرون ، وذالك خروج مسيلمة فقال : لا ، ولاكن في آخر الزمان ) . ( ابن منده ، والمحاملي في أماليه ، وأبو نعيم في ! المعرفة ، كر ) . )(@)(@@)(@@)(@@) $ 14587 عن حذيفة بن اليمان رضي االه عنه قال :(@)(@@) | 30 ( أنا أعلم الناس بكل فتنة هي كائنة إلاى يوم القيامة ، وما بي أن يكون رسول الله أسر 
ms6735	 إلي في ذالك شيئا لم يحدث به غيري ، ولاكن رسول الله حدث مجلسا أتاهم فيه عن الفتن التي تكون ، منها صغار ، ومنها كبار ، فذهب أولائك الرهط كلهم غيري ) . ( حم ، ونعيم ، والروياني ، وسنده حسن ) . )(@)(@@)(@@)(@@) $ 14588 عن حذيفة رضي الله عنه قال :(@)(@@) | 30 ( هاذه فتن قد أظلت كجباه البقر يهلك فيها أكثر الناس إلا من كان يعرفها قبل ذالك ) . ( ش ، ونعيم ) . )(@)(@@)(@@)(@@) $ 14589 عن حذيفة رضي الله عنه قال :(@)(@@) | 30 ( ما بينكم وبين أن يرسل عليكم PageV19P307 الشر فراسخ ، إلا موت عمر رضي الله عنه ) . ( نعيم ، كر ) . )(@)(@@)(@@)(@@) $ 14590 عن حذيفة رضي الله عنه قال :(@)(@@) | 30 ( لا يغرنك ما تراى ، فإن هاؤلاء يوشكوا أن ينفرجوا عن دينهم كما تنفرج المرأة عن قبلها ) . ( ش ، ونعيم ) . )(@)(@@)(@@)(@@) $ 14591 عن حذيفة رضي الله عنه قال :(@)(@@) | 30 ( تكون فتنة ثم تكون بعدها جماعة وتوبة ، ثم جماعة وتوبة ، حتى ذكر الرابعة ، ثم لا تكون بعدها توبة ولا جماعة ) . ( ش ، ونعيم ) . )(@)(@@)(@@)(@@) $ 14592 عن حذيفة رضي الله عنه قال :(@)(@@) | 30 ( في الامة أربع فتن ، تسلمهم الرابعة إلاى الدجال : الرقطاء ، والمظلمة ، وهنة وهنة ) . ( نعيم ) . )(@)(@@)(@@)(@@) $ 14593 عن حذيفة رضي الله عنه قال :(@)(@@) | 30 ( الفتن بعد رسول الله إلاى أن تقوم الساعة أربع : فالاولاى خمس ، والثانية عشر ، والثالثة عشرون ، والرابعة الدجال ) . ( نعيم ) . )(@)(@@)(@@)(@@) $ 14594 عن حذيفة رضي الله عنه قال :(@)(@@) | 30 ( الفتن ثلاث وفي لفظ : تكون ثلاث فتن تسوقهم الرابعة إلاى الدجال ، التي ترمي بالرصف والتي ترمي بالنشف ، والسوداء المظلمة ، والتي تموج موج البحر ) . ( ش ، ونعيم ) . )(@)(@@)(@@)(@@) $ 14595 عن صلة بن زفر ، سمع حذيفة بن اليمان ، وقال له رجل :(@)(@@) | 30 ( خرج الدجال فقال حذيفة رضي الله عنه : أما ما كان فيكم أصحاب محمد فلا والله لا يخرج حتى يتمنى قوم خروجه ، ولا يخرج حتى يكون خروجه أحب إلاى الأقوام من شرب الماء البارد في اليوم الحار ، وليكونن فيكم أيتها الامة أربع فتن : الرقطعاء ، والمظلمة ، وفلانة ، وفلانة ، ولتسلمنكم الرابعة إلاى الدجال ، وليقتتلن بهاذا الغائط فئتان ، ما أبالي في أيهما رميت بسهم كنانتي ) . ( نعيم ) . )(@)(@@) PageV19P308(@)(@@)(@@)(@@) $ 14596 عن حذيفة رضي الله عنه 
ms6736	 قال :(@)(@@) | 30 ( يأتي علاى الناس زمان يصبح الرجل بصيرا ، ويمسي وما يبصر شعره ) . ( نعيم ) . )(@)(@@)(@@)(@@) $ 14597 عن حذيفة بن اليمان رضي الله عنه قال :(@)(@@) | 30 ( اتقوا فرقتين تقتتلان علاى الدنيا فإنهما تجران إلاى النار جرا ) . ( نعيم ) . )(@)(@@)(@@)(@@) $ 14598 عن حذيفة رضي الله عنه قال :(@)(@@) | 30 ( ذكر رسول الله دعاة علاى أبواب جهنم : من أطاعهم أقحموه فيها ، قال : قلت : يا رسول الله فكيف النجاة منها ؟ قال : تلزم جماعة المسلمين وإمامهم ، قال : قلت : فإن لم يكن لهم جماعة ولا إمام ؟ قال : اعتزل تلك الفرق كلها ولو أن تعض بأصل شجرة حتى يدركك الموت وأنت علاى ذالك ) . ( نعيم ) . )(@)(@@)(@@)(@@) $ 14599 عن حذيفة رضي الله عنه قال :(@)(@@) | 30 ( تعودوا الصبر قبل أن ينزل بكم البلاء فإنه يوشك أن ينزل بكم البلاء مع أنه لن يصيبكم أشد مما أصابنا ونحن مع رسول الله ) . ( نعيم ، هب ، كر ) . )(@)(@@)(@@)(@@) $ 14600 عن حذيفة رضي الله عنه قال :(@)(@@) | 30 ( لو حدثتكم أن أمكم تغزوكم ، أتصدقوني ؟ قالوا : أو حق ذالك ؟ قال : حق ) . ( نعيم ) . )(@)(@@)(@@)(@@) $ 14601 عن حذيفة رضي الله عنه قال :(@)(@@) | 30 ( كان الناس يسألون رسول الله عن الخير ، وكنت أسأله عن الشر مخافة أن يدركني ، فقلت : يا رسول الله إنا كنا أهل جاهلية وشر ، فقد جاء الله بهاذا الخير ، فهل بعد هاذا الخير من شر ؟ قال : فهل بعد ذلك الشر من خير ؟ قال : نعم ، وفيه دخن ، قلت : وما دخنه ؟ قال : قوم يستنون بغير سنتي ، ويهتدون بغير هديي ، تعرف منهم وتنكر ، قلت : فهل بعد ذالك الخير من شر ؟ قال : نعم ، دعاة إلاى أبواب جهنم ، من أجابهم إليها قذفوه فيها ، قال : قلت : صفهم لي يا رسول الله قال : هم من جلدتنا ، ويتكلمون بألسنتنا ) . ( نعيم بن حماد في الفتن ، والعسكري في الأمثال ) . )(@)(@@) PageV19P309(@)(@@)(@@)(@@) $ 14602 عن حذيفة بن اليمان رضي الله عنه قال :(@)(@@) | 30 ( ما من صاحب فتنة يبلغون ثلاثمائة إنسان ، إلا ولو شئت أن أسميه باسمه واسم أبيه ومسكنه إلاى يوم القيامة كل ذالك مما علمنيه رسول الله ، قالوا : بأعيانها ؟ قال : أو أشباهها ، يعرفها الفقهاء ، أو قال : العلماء 
ms6737	 ، إنكم كنتم تسألون رسول الله عن الخير ، وأسأله عن الشر ، وتسألونه عما كان ، وأسأله عما يكون ) . ( نعيم ) . )(@)(@@)(@@)(@@) $ 14603 عن حذيفة رضي الله عنه قال :(@)(@@) | 30 ( ليكونن بعد عثمان رضي الله عنه اثنا عشر ملكا من بني أمية ، قيل : له خلفاء ؟ قال : بل ملوك ) . ( نعيم ) . )(@)(@@)(@@)(@@) $ 14604 عن حذيفة رضي الله عنه قال :(@)(@@) | 30 ( إن الرجل ليكون في الفتنة وما هو منها ) . ( ش ، ونعيم ) . )(@)(@@)(@@)(@@) $ 14605 عن ابن عباس رضي الله عنهما :(@)(@@) | 30 ( أنه أتاه رجل وعنده حذيفة بن اليمان ، فقال : يا ابن عباس قوله تعالاى : { حام ، عسق } ؟ فأطرق ساعة وأعرض عنه ، ثم كررها ، فلم يجبه بشيء ، فقال حذيفة : أنا أنبئك ، قد عرفت لم كرهها ؟ إنها نزلت في رجل من أهل بيته يقال له : عبد الإلاه أو : عبد الله ينزل علاى نهر من أنهار المشرق ، يبني عليه مدينتين ، يشق النهر بينهما شقا ، جمع فيهما كل جبار عنيد ) . ( نعيم ) . )(@)(@@)(@@)(@@) $ 14606 عن حذيفة رضي الله عنه قال :(@)(@@) | 30 ( يخرج رجل من أهل المشرق يدعو إلاى آل محمد ، وهو أبعد الناس منهم بنصب علامات سود ، أولها نصر ، وآخرها كفر ، يتبعه خشارة العرب ، وسفلة الموالي ، والعبيد الاباق ، ومراق الآفاق ، سيماهم السواد ، ودينهم الشرك ، وأكثرهم الجدع ، قيل : وما الجدع ؟ قال : القلف ، ثم قال حذيفة لابن عمر رضي الله عنهما : ولست مدركه يا أبا PageV19P310 عبد الرحمان فقال عبد الله : ولاكن أحدث به من بعدي ، قال : فتنة تدعاى الحالقة تحلق الدين ، يهلك فيها صريح العرب ، وصالح الموالي ، وأصحاب الكنوز ، والفقهاء ، وتنجلي عن أقل من القليل ) . ( نعيم ) . )(@)(@@)(@@)(@@) $ 14607 عن حذيفة رضي الله عنه قال :(@)(@@) | 30 ( إذا رأيتم أول الترك بالجزيرة ، فقاتلوهم حتى تهزموهم ، أو يكفيكم الله مؤنتهم فإنهم يفضحون الحرم بها ، فهو علامة خروج أهل المغرب وانتقاض ملك ملكهم ) . ( نعيم ) . )(@)(@@)(@@)(@@) $ 14608 عن حذيفة رضي الله عنه قال : $ 30 ( لا تقوم الساعة حتى يقوم علاى الناس من لا يزن قشر شعيرة يوم القيامة ) . ( نعيم ) .(@)(@@)(@@)(@@) $ 14609 عن حذيفة رضي الله عنه :(@)(@@) | 30 ( أنه قال لأهل مصر : إذا أتاكم كتاب من قبل المشرق يقرأ 
ms6738	 عليكم : من عبد الله أمير خلمؤمنين ، فانتظروا كتابا آخر يأتيكم من المغرب : من عبد الله أمير المؤمنين ، والذي نفس حذيفة بيده اقتتلتم أنتم وهم عند القنطرة ، فيكون بينكم سبعون ألفا من القتلاى ، وليخرجنكم من أرض مصر وأرض الشام كفرا كفرا ، ولتباعن المرأة العربية علاى درج دمشق بخمسة وعشرين درهما ، ثم يدخلون أرض حمص فيقيمون ثمانية عشر شهرا ، يقتسمون فيها الأموال ، ويقتلون فيها الذكر والانثى ، ثم يخرج عليهم رجل ، شر من أظلته السماء ، فيقتلهم فيهزمهم حتى يدخلهم أرض مصر ) . ( نعيم ) . )(@)(@@)(@@)(@@) $ 14610 عن حذيفة رضي الله عنه قال :(@)(@@) | 30 ( فتح لرسول الله فتح لم يفتح له مثله منذ بعثه الله تعالاى ، فقلت له : يهنئك الفتح يا رسول الله قد وضعت الحرب أوزارها فقال : هيهات هيهات والذي نفسي بيده إن دونها يا حذيفة لخصالا ستا ، أولهن موتي ، قال : قلت : إنا لله وإنا إليه راجعون ثم PageV19P311 يفتح بيت المقدس ، ثم يكون بعد ذالك فتنة تقتتل فيها فئتان عظيمتان ، يكثر فيها القتل ، ويكثر فيها الهرج ، دعوتهما واحدة ، ثم يسلط عليكم موت فيقتلكم قعصا كما تموت الغنم ، ثم يكثر المال فيفيض ، حتى يدعاى الرجل إلاى مائة دينار فيستنكف أن يأخذها ، ثم ينشأ لبني الأصفر غلام من أولاد ملوكهم ، قلت : ومن بنو الأصفر يا رسول الله قال : الروم ، فيشب في اليوم الواحد كما يشب الصبي في الشهر ، ويشب في الشهر كما يشب الصبي في السنة ، فإذا بلغ أحبوه واتبعوه ، ما لم يحبوا ملكا قبله ، ثم يقوم بين ظهرانيهم فيقول : إلاى متى تترك هاذه العصابة من العرب ، لا يزالون يصيبون منكم طرفا ، ونحن أكثر منهم عددا وعدة في البر والبحر ؟ إلاى متى يكون هاذا ؟ فأشيروا علي بما ترون فيقوم أشرافهم فيخطبون بين أظهرهم ويقولون : نعم ما رأيت والأمر أمرك ) . ( نعيم ) . )(@)(@@)(@@)(@@) $ 14611 عن حذيفة رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : خيركم في المائتين كل خفيف الحاذ ، قيل : يا رسول الله وما الخفيف الحاذ ؟ قال : الذي لا أهل له ولا ولد ) . ( كر ) . )(@)(@@)(@@)(@@) $ 14612 عن حذيفة رضي الله عنه 
ms6739	 :(@)(@@) | 30 ( أن عمر رضي الله عنه سأل عن قول رسول الله في الفتن التي تموج موج البحر ؟ فقلت : إن بينك وبينها بابا مغلقا ، يوشك أن يكسر كسرا ، قال عمر : كسرا لا أبا لك ؟ قلت : نعم ، قال : فلو أنه فتح لكان لعله أن يعاد فيغلق ، فقلت : بل كسرا ، قال : وحدثته أن ذالك الباب رجل يقتل أو يموت حديثا ليس بالأغاليط ) . ( أبو نعيم ) . )(@)(@@)(@@)(@@) $ 14613 عن حذيفة رضي الله عنه قال :(@)(@@) | 30 ( قلت : يا رسول الله هل بعد هاذا الخير من شر ؟ قال : شر وفتنة ، قلت : فهل بعد ذالك الشر من خير ؟ قال : PageV19P312 هدنة علاى دخن ، وجماعة علاى أقذاء ، فيها دعاة إلاى النار ، يا حذيفة لأن تموت وأنت عاض علاى جذل ، خير لك من أن تستجيب لأحد منهم ) . ( العسكري في الأمثال ) . )(@)(@@)(@@)(@@) $ ( 14614 ) عن زيد بن سلام ، عن أبيه أو عن جده : أن حذيفة بن اليمان رضي الله عنه لما أن احتضر ، أتاه أناس من الأنصار فقالوا : يا حذيفة ! لا نزاك إلا مقبوضا ، فقال لهم : عن مسرور وحبيب جاء على فاقه ، لا أفلح من ندم ، اللهم ! إني لم أشارك غادروا في غدرته ، فأعوذ بك اليوم من صاحب السوء ، وصباح السوء ، كان الناس يسألون رسول الله صلى الله عليه وسلم عن الخير وأسأله عن الشر ، فقلت له : يا رسول الله ! إنا كنا في شر فجاءنا الله تعالى بالخير ، فهل بعد ذلك الخير من شر ؟ قال : نعم ، قلت : هل وراء الشر من خير قال : نعم ، قلت : هل وراء ذلك الخير من شر ؟ قال : نعم ، قلت : كيف يكون ؟ قال : سيكون بعدي أئمة لا يهتدون بهديي ، ولا يستنون بسنتي ، وسيقوم رجال قلوبهم قلوب شياطين في جثمان إنسان ، فقلت : كيف أصنع إن أدركني ذلك ؟ قال : اسمع للأمير الأعظم ، وإن ضرب ظهرك ، وأخذ مالك ' . . ( كر ) .(@)(@@)(@@)(@@) $ 14615 عن حذيفة رضي الله عنه قال :(@)(@@) | 30 ( أول الفتن : قتل عثمان رضي الله عنه ، وآخرها : خروج الدجال ) . ( ش ، كر ، وزاد : والذي نفسي بيده لا يموت رجل وفي قلبه مثقال حبة من حب قتل عثمان 
ms6740	 رضي الله عنه إلا تبع الدجال إن أدركه ، وإن لم يدركه افتتن به في قبره ) . )(@)(@@)(@@)(@@) $ 14616 عن حذيفة رضي الله عنه قال :(@)(@@) | 30 ( لو حدثتكم بكل ما أعلم ما رقدتم في الليل ) . ( نعيم بن حماد في الفتن ، وسنده ضعيف ) . )(@)(@@) PageV19P313(@)(@@)(@@)(@@) $ 14617 عن حذيفة رضي الله عنه قال :(@)(@@) | 30 ( ليأتين علاى الناس زمان لا ينجو فيه إلا من دعا بدعاء كدعاء الغرق ) . ( ش ) . )(@)(@@)(@@)(@@) $ 14618 عن حذيفة رضي الله عنه قال :(@)(@@) | 30 ( ما أنا إلاى طريق من طرقكم بأهداى مني بكل فتنة هي كائنة وسائقها وقائدها إلاى يوم القيامة ) . ( نعيم ) . )(@)(@@)(@@)(@@) $ 14619 عن حذيفة رضي الله عنه قال :(@)(@@) | 30 ( والله ما أنا بالطريق إلاى قرية من القراى ، ولا إلاى مصر من الأمصار بأعلم مني بما يكون من بعد عثمان بن عفان رضي الله عنه ) . ( نعيم ) . )(@)(@@)(@@)(@@) $ 14620 عن حذيفة رضي الله عنه قال :(@)(@@) | 30 ( خطب رسول الله في أربع جمع متواليات يقول في كل مرة : إذا استحلت الخمر بالنبيذ ، والربا بالبيع ، والسحت بالهدية ، واتجروا بالزكاة ، فعند ذالك هلاكهم ليزدادوا إثما ) . ( الديلمي ) . )(@)(@@)(@@)(@@) $ 14621 عن حذيفة رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : يأتي علاى الناس زمان أفضل أهل ذالك الزمان كل خفيف الحاذ قيل : يا رسول الله ومن خفيف الحاذ ؟ قال : قليل العيال ) . ( كر ) . )(@)(@@)(@@)(@@) $ 14622 عن نصر بن عاصم الليثي قال :(@)(@@) | 30 ( سمعت حذيفة رضي الله عنه يقول : كان رسول الله يسأله الناس عن الخير وكنت أسأله عن الشر ، وعرفت أن الخير لن يسبقني ، قال : قلت : يا رسول الله هل بعد هاذا الخير من شر ؟ قال : يا حذيفة تعلم كتاب الله واتبع ما فيه ثلاث مرات ، قال : قلت : يا رسول الله هل بعد هاذا الخير من شر ؟ قال : فتنة وشر ، قلت : يا رسول الله هل بعد هاذا الشر خير ؟ قال : يا حذيفة تعلم كتاب الله واتبع ما فيه ثلاث مرات ، قال : قلت : يا رسول الله هل بعد هاذا الخير شر ؟ قال : فتنة عمياء صماء ، عليها دعاة علاى أبواب النار ، فأن تموت يا حذيفة وأنت عاض 