ms241	 أنصاري عنه سعيد بن المسيب د(@)(@@)(@@)(@@) | 617- (@)(@@) بصرة بن أبي بصرة حميل الغفاري صحابي كأبيه عنه أبو هريرة د ت س(@)(@@)(@@)(@@) | 618- (@)(@@) بعجة بن عبد الله بن بدر الجهني عن أبيه وأبي هريرة وعنه ابناه ويحيى بن أبي كثير وعدة ثقة خ م ت س ق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 619- (@)(@@) بقية بن الوليد أبو يحمد الكلاعي الميتمي الحافظ عنبحير ومحمد بن زياد الالهاني وأمم وعنه بن جريج وشعبة وهما من شيوخه وكثير بن عبيد وأحمد بن الفرج الحجازي وخلق وثقه الجمهور فيما سمعه من الثقات وقال النسائي إذا قال حدثنا وأخبرنا فهو ثقة مات 197 م 4(@)(@@)(@@)(@@) | 620- (@)(@@) بكار بن عبد العزيز بن أبي بكرة عن أبيه وعنه أبو عاصم والتبوذكي وعدة فيه لين د ت ق علق له البخاري(@)(@@)(@@)(@@) | 621- (@)(@@) بكار بن يحيى عن جدته وعنه بن مهدي د(@)(@@)(@@)(@@) | 622- (@)(@@) بكر بن الحكم أبو بشر المزلق عن ثابت وغيره وعنه حبان بن هلال وجماعة لين س(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 623- (@)(@@) بكر بن خلف عنبن عيينة ومعتمر وعنه أبو داود وابن ماجة وعبد الله بن أحمد ثقة توفي 24 د ق(@)(@@)(@@)(@@) | 624- (@)(@@) بكر بن خنيس العابد عن ثابت ويزيد الرقاشي وعدة وعنه آدم وطالوت وعدة واه ت ق(@)(@@)(@@)(@@) | 625- (@)(@@) بكر بن زرعة الخولاني عن أبي عنبة وعنه إسماعيل بن عياش وآخر ق(@)(@@)(@@)(@@) | 626- (@)(@@) بكر بن سليم الصواف عن أبي طوالة وزيد بن أسلم وعنه إبراهيم الحزامي وابن السرح صدوق ق(@)(@@)(@@)(@@) | 627- (@)(@@) بكر بن سوادة الجذامي الفقيه عن عبد الله بن عمرو وأبي ثور الفهمي وخلق وعنه الليث وابن لهيعة وعدة ثقة توفي 128 ع(@)(@@)(@@)(@@) | 628- (@)(@@) بكر بن عبد الله المزني عن بن عباس وابن عمر وعنه سليمان التيمي ومبارك وخل ثقة إمام توفي 108 ع(@)(@@)(@@)(@@) | 629- (@)(@@) بكر بن عبد الرحمن ويقال بن عبيد الانصاري عن هريم بنسفيان وعدة وعنه بنو أبي شيبة والفسوي ثقة توفي 219 د س(@)(@@)(@@)(@@) | 630- (@)(@@) بكر بن عبد الوهاب عن خاله الواقدي ومحمد بن فليح وعنه بن ماجة وابن أبي حاتم(@)(@@) وعدة ق(@)(@@)(@@)(@@) | 631- (@)(@@) بكر بن عمرو المعافري عن عكرمة ومشرح بن هاعان وعنه يحيى بن أيوب 
ms242	 وطائفعابد قدوة خ م د ت س(@)(@@)(@@)(@@) | 632- (@)(@@) بكر بن عمرو أو بن قيس أبو الصديق الناجي عن عائشة وعنه قتادة وعاصم الاحول ثقة ع(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 633- (@)(@@) بكر بن عيسى عن شعبة وعنه أحمد وبندار مات 204 س(@)(@@)(@@)(@@) | 634- (@)(@@) بكر بن ماعز عن الربيع بن خثيم وغيره وعنه يونس بن أبي إسحاق وجماعة ثقة س(@)(@@)(@@)(@@) | 635- (@)(@@) بكر بن مبشر له صحبة عنه إسحاق بن سالم د(@)(@@)(@@)(@@) | 636- (@)(@@) بكر بن مضر عن أبي قبيل ويزيد بن أبي حبيب وعنه ابنه إسحاق وقتيبة وخلق ثقة مات 174 خ م د ت س(@)(@@)(@@)(@@) | 637- (@)(@@) بكر بن وائل التيمي عن نافع والزهري وعنه أبوه وشعبة وعدة صدوق م 4(@)(@@)(@@)(@@) | 638- (@)(@@) بكر بن يحيى البصري عن شعبة وعنه أبو قلابة وأبو أمية وثق ق(@)(@@)(@@)(@@) | 639- (@)(@@) بكر بن يونس بن بكير عن الليث وموسى بن علي وعنه بن نمير وابن أبي غرزة ضعفوه ت ق(@)(@@)(@@)(@@) | 640- (@)(@@) بكير بن الاخنس عن بن عباس وعدة وعنه مسعر وأبو عوانة ثقة م د س ق(@)(@@)(@@)(@@) | 641- (@)(@@) بكير بن أبي السميط عن بن سيرين وقتادة وعنه عفان وحبان صدوق س(@)(@@)(@@)(@@) | 642- (@)(@@) بكير بن شهاب عن سعيد بن جبير وعنه مبارك بن سعيد الثوري وغيره ليس بالدامغاني ت س(@)(@@)(@@)(@@) | 643- (@)(@@) بكير بن عامر البجلي عن الشعبي وأبي زرعة وعنه وكيع وأبو نعيم ضعف د(@)(@@)(@@)(@@) | 644- (@)(@@) بكير بن عبد الله بن الاشج عن أبي أمامة بن سهل وابن المسيب وعنه ابنه مخرمة والليث وأمم ثبت إمام توفي 127 ع(@)(@@)(@@)(@@) | 645- (@)(@@) بكير الطائي الضخمعن كريب وعنه سلمة بن كهيل وأشعث بن سوار م ق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 646- (@)(@@) بكير بن عطاء عن عبد الرحمن بن يعمر وعنه شعبة وسفيان ثقة 4(@)(@@)(@@)(@@) | 647- (@)(@@) بكير بن فيروز عن أبي هريرة والبراء وعنه زيد بن أبي أنيسة وأهل الرها ت(@)(@@)(@@)(@@) | 648- (@)(@@) بكير بن مسمارعن بن عمر وجمع وعنه أبو بكر الحنفي والواقدي فيه شئ توفي 153 م ت س(@)(@@) 649 بكير بن وهب الجزري عن أنس وعنه أبو الأسد علي س(@)(@@)(@@)(@@) | 650- (@)(@@) بهز بن أسد عن شعبة وطبقته وعنه بندار وعبد الله بن هاشم وخلق حجة إمام مات 
ms243	 قبيل القطان ع(@)(@@)(@@)(@@) | 651- (@)(@@) بهز بن حكيم بن معاوية بن حيدة أبو عبد الملك عن أبيه وزرارة بن أوفى وعنه القطان ومكي وثقه جماعة قال بن عدي لم أر له حديثا منكرا 4(@)(@@)(@@)(@@) | 652- (@)(@@) بهلول بن مورق عن ثور وموسى بن عبيدة وعنه الكوسج والكديمي صدوق ق(@)(@@)(@@)(@@) | 653- (@)(@@) بور بن أصرم أبو بكر المروزي عن بن المبارك وعنه البخاري وعبيد الله بن واصل مات 223 خ(@)(@@)(@@)(@@) | 654- (@)(@@) بلال بن أبي بردة أمير البصرة وقاضيها عن أبيه وعمه أبي بكر وعنه قتادة ومعاوية الضال وعدة ت(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 655- (@)(@@) بلال بن الحارث المزني المدني صحابي عنه ابنه الحارث وعلقمة بن وقاص مات 4 6(@)(@@)(@@)(@@) | 656- (@)(@@) بلال بن أبي الدرداء عنأبيه وعنه حريز بن عثمان وأبو بكر بن أبي مريم ولي قضاء دمشق مات 93 د(@)(@@)(@@)(@@) | 657- (@)(@@) بلال بن رباح وأمه حمامة مولاة بني جمح كان ممن سبق إلى الاسلام عنه قيس بن أبي حازم وابن أبي ليلى والنهدي مات على الصحيح بدمشق في سنة عشرين ع(@)(@@)(@@)(@@) | 658- (@)(@@) بلا لبن سعد القاص الواعظ المقرئ عن أبيه وجابر ومعاوية وعنه الاوزاعي وسعيد بن عبد العزيز وعدة ثقة توفي في حد 12 س(@)(@@)(@@)(@@) | 659- (@)(@@) بلال بن عبد الله بن عمر عن أبيه وعنه كعب بن علقمة وعبد الله بن هبيرة ثقة م(@)(@@)(@@)(@@) | 660- (@)(@@) بلال بن مرداس عن شهر وغيره وعنه ليث بن أبي سليم وأبو حنيفة وكان أميرا جوادا د ت س(@)(@@)(@@)(@@) | 661- (@)(@@) بلال بنيحيى بن طلحة عن أبيه وعنه سليمان بن سفيان ت(@)(@@)(@@)(@@) | 662- (@)(@@) بلال بن يحيى العبسي عن حذيفة وعلي وعنه حبيب بن سليم وجماعة صدوق 4(@)(@@)(@@)(@@) | 663- (@)(@@) بلال بن يسار عن أبيه وعنه عمرو بن مرة د ت(@)(@@)(@@)(@@) | 664- (@)(@@) بيان بن بشر المؤدب عن أنس وقيس بن أبي حازم وعنه شعبة وزائدة وعدة ع(@)(@@)(@@)(@@) | 665- (@)(@@) بيان بن عمرو البخاري العابد عن يحيى القطان ونحوه وعنه البخاري وأبو زرعة توفي 222 خ(@)(@@)(@@)(@@) | 666- (@)(@@) بيهس عن أبي شيخ الهنائي وعنه شعبة والنضر بن شميل ثقة س(@)(@@) PageV00P000(@)(@@)(@@)(@@) | حرف التاء(@)(@@)(@@)(@@) | 667- (@)(@@) تبيع بن سليمان أبوالعدبس عن أبي مرزوق وعنه أبو العنبس د ق(@)(@@)(@@)(@@) | 668- (@)(@@) تبيع 
ms244	 بن عامر الحميري أسلم زمن أبي بكر له عن كعب وأبي الدرداء وعنه مجاهد وأبو قبيل المعافري وعدة قرأ الكتب وأكثر عن زوج أمه كعب وعمر دهرا مات بالاسكندرية سنة 101 س(@)(@@)(@@)(@@) | 669- (@)(@@) التلب بن ثعلبة التميمي له صحبة عنه ابنه ملقامد س(@)(@@)(@@)(@@) | 670- (@)(@@) تليد بن سليمان الكوفي الشيعي عن عبد الملك بن عمير ونحوه وعنه أحمد وابن نمير ضعيف وقال أبو داود رافضي يشتم ت(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 671- (@)(@@) تمام بن نجيح عن الحسن وعطاء وعنه بقية ومبشر بن إسماعيل ضعيف د ت(@)(@@)(@@)(@@) | 672- (@)(@@) تميم بن أوس الداري الصحابي أسلم سنة تسع وعنه أنس وشهر وقبيصة بن ذؤيب وعدة كان صاحب ليل وتلاوة قال أنس اشترى حلة بألف ليخرج فيها إلى الصلاة قال السائب بن يزيد هو أول من قص بإذن عمر توفي سنة أربعين م 4(@)(@@)(@@)(@@) | 673- (@)(@@) متميم بن سلمة السلمي الكوفي عن عروة وجماعة وعنه منصور والاعمش توفي سنة مائة م د س ق(@)(@@)(@@)(@@) | 674- (@)(@@) تميم بن طرفة الطائي عن عدي بن حاتم وعدة وعنه عبد العزيز بن رفيع وعدة ثقة مات 94 م د س ق(@)(@@)(@@)(@@) | 675- (@)(@@) تميم بن عطية العنسي عن مكحول وعمير بن هانئ وعنه يحيى بن حمزة والوليد ثقة ت(@)(@@)(@@)(@@) | 676- (@)(@@) تميم بن محمود عبن شبل وعنه جعفر بن عبد الله قال البخاري في حديثه نظر د س ق(@)(@@)(@@)(@@) | 677- (@)(@@) تميم بن المنتصر الواسطي عن بن عيينة ونحوه وعنه أبو داود والنسائي وابن ماجة وسبطه بحشل وابن جرير توفي 244 د س ق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 678- (@)(@@) تميم عن مولاته فاطمة بنت قيس وعنه ومجاهد س(@)(@@)(@@)(@@) | 679- (@)(@@) توبة العنبري عن أنس وأبي العالية وعدة وعنه شعبة وسفيان ثقة مات 131 خ م د س(@)(@@)(@@)(@@) | 680- (@)(@@) توبة أبو صدقة عن مولاه أنس وعنه شعبة وأبو نعيم س(@)(@@) 0)(@)(@@) PageV00P000(@)(@@)(@@)(@@) | حرف الثاء(@)(@@)(@@)(@@) | 681- (@)(@@) ثابت بن أسلم البناني أبو محمد عن بن عمر وابن الزبير وخلق وعنه الحمادان وأمم وكان رأسا في العلم والعمل يلبس الثياب الفاخرة يقال لم يكن في وقته أعبد منه عاش ستا وثمانين سنة مات 127 ع(@)(@@)(@@)(@@) | 682- (@)(@@) ثابت بن ثوبان العنسي عن بن 
