ms454	 ك ق ) عن عبد الله بن حوالة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4297 ) قال النبي :(@)(@@) | 30 ( اللهم اسق بلادك وبهائمك ، وانشر رحمتك وأحيي بلدك الميت ، اللهم اسقنا غيثا مغيثا مريا مريعا طبقا واسعا عاجلا غير آجل ، نافعا غير ضار ، اللهم اسقنا سقيا رحمة لا سقيا عذاب ولا هدم ولا غرق ولا محق ، اللهم اسقنا الغيث وانصرنا على الأعداء ) )(@)(@@) ابن سعد عن أبي وجزة السعدي .(@)(@@)(@@)(@@) $ ( 4298 ) قال النبي :(@)(@@) | 30 ( اللهم صل على الأنصار وعلى ذرية الأنصار وعلى ذرية ذرية الأنصار ) )(@)(@@) ( ش ) و ابن السني عن قيس بن سعد بن عبادة رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4299 ) قال النبي :(@)(@@) | 30 ( اللهم متعني من الدنيا بسمعي وبصري وعقلي ) )(@)(@@) ( هب ) وضعفه عن جرير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4300 ) قال النبي :(@)(@@) | 30 ( اللهم أنت ربي لا إلاه إلا أنت عليك توكلت وأنت رب العرش الكريم ، ما شاء الله كان وما لم يشأ لم يكن ، لا حول ولا قوة إلا بالله العلي العظيم ، أعلم أن الله على كل شيء قدير وأن الله قد أحاط بكل شيء علما ، اللهم إني أعوذ بك من شر نفسي ومن شر كل دابة أنت آخد بناصيتها ، إن ربي على صراط مستقيم ، من قالها في أول النهار لم تصبه مصيبة حتى يمسي ، ومن قالها آخر النهار لم تصبه مصيبة حتى يصبح ) )(@)(@@) الديلمي عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4301 ) قال النبي :(@)(@@) | 30 ( اللهم أنت أمرت بالدعاء وتكفلت بالإجابة ، لبيك اللهم لبيك ، لبيك لا شريك لك لبيك ، إن الحمد والنعمة لك والملك ، لا شريك لك ، أشهد أنك فرد واحد صمد ، لم تلد ولم تولد ، ولم يكن له كفوا أحد ، وأشهد أن وعدك ولقاءك حق ، والجنة حق ، والنار حق ، وأن الساعة آتية لا ريب فيها ، وأنك تبعث من في القبور ) )(@)(@@) ابن أبي الدنيا في الدعاء وابن مردويه ( هق ) في الأسماء والصفات والأصبهاني في الترغيب عن جابر رضي الله عنه وسنده ضعيف .(@)(@@)(@@)(@@) $ ( 4302 ) قال النبي :(@)(@@) | 30 ( اللهم إنك أخذت مني عبيدة بن الحارث يوم بدر ، وحمزة بن عبد المطلب يوم 
ms455	 أحد ، وهاذا علي فلا تذرني فردا وأنت خير الوارثين ) )(@)(@@) الديلمي عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4303 ) قال النبي :(@)(@@) | 30 ( اللهم إنك رب عظيم لا يسعك شيء مما خلقت ، وأنت ترى ولا ترى وأنت بالمنظر الأعلى ، وأن لك الآخرة والأولى ولك الممات والمحيى وأن إليك المنتهى والرجعى ، نعوذ بك أن نذل ونخزى ، اللهم إنك سألتنا من أنفسنا ما لا نملكه إلا بك فأعطنا منها ما يرضيك عنا ) )(@)(@@) الديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4304 ) قال النبي :(@)(@@) | 30 ( اللهم إني أسألك بأسمائك الحسنى ما علمت منها وما لم أعلم ، وباسمك العظيم الأعظم وباسمك الكبير الأكبر ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4305 ) قال النبي :(@)(@@) | 30 ( اللهم إني أسألك بنعمتك السابغة علي ، وبلائك الحسن الذي ابتليتني به وفضلك الذي أفضلت علي أن تدخلني الجنة بمنك وفضلك ورحمتك ) )(@)(@@) الديلمي عن ابن مسعود رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4306 ) قال النبي :(@)(@@) | 30 ( اللهم إني أسألك بوجهك الكريم ، وأمرك العظيم ، أن تجيرني من النار والكفر والفقر ) )(@)(@@) الديلمي عن أبي بكرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4307 ) قال النبي :(@)(@@) | 30 ( اللهم العن فلانا واجعل قلبه قلب سوء وامءلا جوفه من رضف جهنم ) )(@)(@@) الديلمي عن عبد الله بن شبل رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4308 ) قال النبي :(@)(@@) | 30 ( اللهم إني أعوذ بك من موت الفجاءة ، ومن لدغ PageV02P119 الحية ومن السبع ، ومن الحرق ومن الغرق ومن أن أخر على شيء أو يخر علي شيء ، ومن القتل عند فرار الزحف ) )(@)(@@) ( حم ) عن ابن عمرو رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4309 ) قال النبي :(@)(@@) | 30 ( اللهم إني أسألك علما نافعا وعملا متقبلا ) )(@)(@@) ( طس ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4310 ) قال النبي :(@)(@@) | 30 ( اللهم انفعني بما علمتني ، وعلمني ما ينفعني ) )(@)(@@) ( طس ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4311 ) قال النبي :(@)(@@) | 30 ( اللهم إني أسألك إيمانا دائما ، وهديا قيما ، وعلما نافعا ) )(@)(@@) ( حل ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4312 ) قال النبي :(@)(@@) | 30 ( اللهم إني أعوذ بك من شر من يمشي على بطنه ، ومن شر من يمشي على رجلين ، ومن شر من يمشي على 
ms456	 أربع ) )(@)(@@) ( طس ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4313 ) قال النبي :(@)(@@) | 30 ( اللهم اغفر لي ما قدمت وما أخرت ، وما أسررت وما أعلنت ، وما أنت أعلم به مني ، أنت المقدم وأنت المؤخر ، لا إلاه إلا أنت ) )(@)(@@) ( حم ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4314 ) قال النبي :(@)(@@) | 30 ( اللهم إني أعوذ بك أن أموت هما أو غما ، وأن أموت غرقا ، وأن يتخبطني الشيطان عند الموت ، وأن أموت لديغا ) )(@)(@@) ( حم ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4315 ) قال النبي :(@)(@@) | 30 ( اللهم إن ناسا يتبعوني وإني لا يعجبني أن يتبعوني ، PageV02P120 اللهم فمن ضربت أو سببت فاجعلها له كفارة وأجرا ) )(@)(@@) ( حم ) عن خال أبي السوار العدوي .(@)(@@)(@@)(@@) $ ( 4316 ) قال النبي :(@)(@@) | 30 ( اللهم إن إبراهيم كان عبدك وخليلك ، دعاك لأهل مكة بالبركة ، وأنا محمد عبدك ورسولك أدعوك لأهل المدينة أن تبارك لهم في مدهم وصاعهم مثلي ما باركت لأهل مكة مع البركة بركتين ) )(@)(@@) ( حم ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4317 ) قال النبي :(@)(@@) | 30 ( اللهم اجعلني من عبادك المنتخبين الغر المحجلين ، الوفد المتقبلين ، قيل : ما المنتخبون ؟ قال : عباد الله الصالحون ، قيل : فما الغر المحجلون ؟ قال : الذين تبيض منهم مواضع الطهور ، قيل : فما الوفد المتقبلون ؟ قال : وفد يفدون من هاذه الأمة مع نبيهم إلى ربهم عز وجل ) )(@)(@@) ( حم ) عن وفد وفد عبد القيس .(@)(@@)(@@)(@@) $ ( 4318 ) قال النبي :(@)(@@) | 30 ( اللهم اغفر لي ذنبي وخطئي وجهلي ) )(@)(@@) ( حم ) عن عجوز من بني تميم .(@)(@@)(@@)(@@) $ ( 4319 ) قال النبي :(@)(@@) | 30 ( اللهم اجعل أبا بكر معي في درجتي يوم القيامة ) )(@)(@@) ( حل ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4320 ) قال النبي :(@)(@@) | 30 ( اللهم إني أسألك حبك وحب من يحبك ، والعمل الذي يبلغني حبك ، اللهم اجعل حبك أحب إلي من نفسي وأهلي والماء البارد ) )(@)(@@) ( حل ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4321 ) قال النبي :(@)(@@) | 30 ( اللهم آمن روعتي ، واحفظ أمانتي ، واقض ديني ) )(@)(@@) الخرائطي في مكارم الأخلاق عن حنظلة بن علي .(@)(@@) PageV02P121(@)(@@)(@@)(@@) $ ( 4322 ) قال النبي :(@)(@@) | 30 ( اللهم ما أعطيتني مما أحب فاجعله قوة لي على ما تحب ، وما زويت عني مما 
ms457	 أحب فاجعله فراغا لي فيما تحب ، اللهم أعطني ما أحب واجعله خيرا ، واصرف عني ما أكره ، وحبب إلي طاعتك وكره إلي معصيتك ) )(@)(@@) الديلمي عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 4323 ) قال النبي :(@)(@@) | 30 ( اللهم هاذا عمي وصنو أبي وخير عمومة العرب ، اللهم أسكنه معي في السناء الأعلى ) )(@)(@@) الديلمي عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4324 ) قال النبي :(@)(@@) | 30 ( اللهم وفقني لما تحب وترضى من القول والعمل ، والفعل والنية والهدى إنك على كل شيء قدير ) )(@)(@@) الديلمي عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4325 ) قال النبي :(@)(@@) | 30 ( اللهم أشرب الإيمان قلبي ، كما أشربته روحي ، ولا تعذب شيئا من خلقي بشيء كتبت علي ، فإنك قادر علي ) )(@)(@@) الديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4326 ) قال النبي :(@)(@@) | 30 ( اللهم إني أعوذ بك من حال أهل النار ) )(@)(@@) الخرائطي في مكارم الأخلاق عن عمران بن حصين رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4327 ) قال النبي :(@)(@@) | 30 ( اللهم إني أعوذ بك من الكسل والهرم ، والمغرم والمأثم ، وأعوذ بك من فتنة الدجال ، وأعوذ بك من عذاب القبر ، وأعوذ بك من عذاب النار ) )(@)(@@) الخرائطي عن ابن عمرو رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4328 ) قال النبي :(@)(@@) | 30 ( اللهم اغفر لأولنا وآخرنا ، وحينا وميتنا ، وذكرنا وأنثانا ، وصغيرنا وكبيرنا ، وشاهدنا وغائبنا ، اللهم لا تحرمنا أجره ، اللهم لا تحرمنا أجره ، ولا تضلنا تفتنا بعده ) )(@)(@@) البغوي عن أبي إبراهيم الأشهلي عن أبيه أن رسول الله صلى على جنازة فقال فذكره .(@)(@@)(@@)(@@) $ ( 4329 ) قال النبي :(@)(@@) | 30 ( اللهم إنك لست بالاه استحدثناه ، ولا برب يبيد PageV02P122 ذكره ، ولا كان معك إلاه ندعوه ونتضرع إليه ولا أعانك على خلقك أحد فنشك فيك ) )(@)(@@) أبو الشيخ في العظمة عن صهيب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4330 ) قال النبي :(@)(@@) | 30 ( اللهم إني أعوذ بك من شر ما تجيء به الرسل ، وشر ما تجيء به الريح ) )(@)(@@) أبو الشيخ عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4331 ) قال النبي :(@)(@@) | 30 ( اللهم بارك لنا في مدنا وصاعنا واجعل مع البركة بركتين ) )(@)(@@) ( حب ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4332 ) قال النبي :(@)(@@) | 30 ( اللهم ارزقنا 
ms458	 من فضلك ، ولا تحرمنا رزقك ، وبارك لنا فيما رزقتنا ، واجعل غنانا في أنفسنا ورغبتنا فيما عندك ) )(@)(@@) ( حل ض ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4333 ) قال النبي :(@)(@@) | 30 ( اللهم لا تجعل قبري وثنا يصلى إليه ، فإنه اشتد غضب الله على قوم اتخذوا قبور أنبيائهم مساجد ) )(@)(@@) عبد الرزاق عن زيد بن أسلم مرسلا .(@)(@@)(@@)(@@) $ ( 4334 ) قال النبي :(@)(@@) | 30 ( اللهم لا تنس لعثمان ما عمل بعد هاذا ) )(@)(@@) أبو نعيم في فضائل الصحابة عن ابن عمر رضي الله عنهما قال : لما جهز النبي جيش العسرة جاء عثمان بألف دينار فصبها في حجر رسول الله قال فذكره .(@)(@@)(@@)(@@) $ ( 4335 ) قال النبي :(@)(@@) | 30 ( اللهم اغفر للصحابة ولمن رآني ، ولمن رأى من رآني ) )(@)(@@) أبو نعيم في المعرفة عن سهل بن سعد رضي الله عنه ورجاله ثقات .(@)(@@)(@@)(@@) $ ( 4336 ) قال النبي :(@)(@@) | 30 ( اللهم اجعل له لسانا ذاكرا ، وقلبا شاكرا ، وارزقه حبي وحب من يحبني ، وصير أمره إلى خير ) )(@)(@@) ( طب ) عن ابن عمر ( ابن عساكر ) عن أبي الدرداء رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4337 ) قال النبي :(@)(@@) | 30 ( اللهم إني أعوذ بك من شر الريح ) )(@)(@@) ( ك ) عن جابر رضي الله عنه .(@)(@@) PageV02P123(@)(@@)(@@)(@@) $ ( 4338 ) قال النبي :(@)(@@) | 30 ( اللهم اللهم اهد ثقيفا ) )(@)(@@) ( حم ) و سمويه ( ض ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4339 ) قال النبي :(@)(@@) | 30 ( اللهم اهد دوسا وأت بهم ) )(@)(@@) ( خ م ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4340 ) قال النبي :(@)(@@) | 30 ( اللهم باعد بيني وبين خطاياي كما باعدت بين المشرق والمغرب ، اللهم نقني من خطاياي كما ينقى الثوب الأبيض من الدنس ، اللهم اغسلني من خطاياي بالماء والثلج والبرد ) )(@)(@@) ( ش حم خ م د ن ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4341 ) قال النبي :(@)(@@) | 30 ( اللهم حبب إلينا المدينة كحبنا مكة أو أشد ، اللهم بارك لنا في صاعنا وفي مدنااوصححها لنا وانقل حماها إلى الجحفة ) )(@)(@@) ( حم م ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 4342 ) قال النبي :(@)(@@) | 30 ( اللهم أصح لي سمعي وبصري ) )(@)(@@) ( خ ) في الأدب عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4343 ) قال النبي :(@)(@@) | 30 ( اللهم اسقنا غيثا مغيثا 
ms459	 مريا مريعا طبقا غدقا عاجلا غير آجل ، نافعا غير ضار ) )(@)(@@) عن ابن حميد ( د ) وابن خزيمة وأبو عوانة ( ك هق ض ) عن جابر رضي الله عنه ( حم ) طب ه ك هق ) عن كعب بن مرة ( ه طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4344 ) قال النبي :(@)(@@) | 30 ( اللهم إني أسألك علما نافعا وأعوذ بك من علم لا PageV02P124 ينفع ) )(@)(@@) ( ه حب ض طس ) عن جابر ( طس ) عن عائشة رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4345 ) قال النبي :(@)(@@) | 30 ( اللهم اغفر لعبيد بن عامر ، اللهم اجعله يوم القيامة فوق كثير من خلقك ، اللهم اغفر لعبد الله بن قيس ذنبه ، وأدخله يوم القيامة مدخلا كريما ) )(@)(@@) ( خ م ) عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4346 ) قال النبي :(@)(@@) | 30 ( اللهم احفظ أبا قتادة كما حفظني منه الليل ) )(@)(@@) ( طب ) عن أبي قتادة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4347 ) قال النبي :(@)(@@) | 30 ( اللهم اغفر لحينا وميتنا ، وشاهدنا وغائبنا ، وصغيرنا وكبيرنا ، وذكرنا وأنثانا ، اللهم من أحييته منا فأحيه على الإسلام ، ومن توفيته منا فتوفه على الإيمان ، اللهم لا تحرمنا أجره ، ولا تضلنا بعده ) )(@)(@@) ( حم ع هق ض ) عن عبد الله بن أبي قتادة عن أبيه أنه شهد النبي على ميت قال فذكره .(@)(@@)(@@)(@@) $ ( 4348 ) قال النبي :(@)(@@) | 30 ( اللهم من حبسنا عن الصلاة الوسطى فاملأ بيوتهم نارا واملأ قبورهم نارا ) )(@)(@@) ( حم ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4349 ) قال النبي :(@)(@@) | 30 ( اللهم اغفر لي ذنبي كله ، دقه وجله ، سره وعلانيته ، أوله وآخره ) )(@)(@@) ( حل ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4350 ) قال النبي :(@)(@@) | 30 ( اللهم إنك أخرجتني من أحب البلاد إلي فأسكني أحب البلاد إليك ) )(@)(@@) ( ك ) وتعقب عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4351 ) قال النبي :(@)(@@) | 30 ( اللهم إن عبدك ونبيك يشهد أن هاؤلاء شهداء وإنه من زارهم وسلم عليهم إلى يوم القيامة ردوا عليه ) )(@)(@@) ( ك ) عن عبد الله بن أبي فروة .(@)(@@)(@@)(@@) $ ( 4352 ) قال النبي :(@)(@@) | 30 ( اللهم طهرني بالثلج والبرد والماء البارد ، اللهم PageV02P125 طهر قلبي من الخطايا كما طهرت الثوب الأبيض من الدنس ، وباعد بيني 
ms460	 وبين ذنوبي كما باعدت بين المشرق والمغرب ، اللهم إني أعوذ بك من قلب لا يخشع ونفس لا تشبع ، ودعاء لا يسمع ، وعلم لا ينفع ، اللهم إني أعوذ بك من هاؤلاء الأربع ، اللهم إني أسألك عيشة نقية ، وميتة سوية ، ومردا غير مخزي ) )(@)(@@) ( حم ) عن عبد الله بن أبي أوفى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4353 ) قال النبي :(@)(@@) | 30 ( اللهم إن قلوبنا وجوارحنا بيدك ، لم تملكنا منها شيئا فإذا فعلت ذالك بهما فكن أنت وليهما ) )(@)(@@) ( حل ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4354 ) قال النبي :(@)(@@) | 30 ( اللهم إني أستغفرك وأتوب إليك ، فتب علي إنك أنت التواب الغفور ) )(@)(@@) ( ط ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4355 ) قال النبي :(@)(@@) | 30 ( اللهم إني أعوذ بك من يوم السوء ، ومن ليلة السوء ، ومن ساعة السوء ، ومن صاحب السوء ، ومن جار السوء في دار المقامة ) )(@)(@@) ( طب ) عن عقبة بن عامر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4356 ) قال النبي :(@)(@@) | 30 ( اللهم ثبت لسانه واهد قلبه قاله لعلي ) )(@)(@@) ( ك ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4357 ) قال النبي :(@)(@@) | 30 ( اللهم أولعت قريشا بعمار ، قاتل عمار وسالبه في النار ) )(@)(@@) ( ك ) عن عمرو بن العاص رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4358 ) قال النبي :(@)(@@) | 30 ( اللهم هاذا عبدك خرج مهاجرا في سبيلك فقتل شهيدا فأنا عليه شهيد ) )(@)(@@) ( ك ) عن شداد بن الهادي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4359 ) قال النبي :(@)(@@) | 30 ( اللهم اغفر للأحنف بن قيس ) )(@)(@@) ( ك ) عن الحسن عن الأحنف بن قيس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4360 ) قال النبي :(@)(@@) | 30 ( اللهم اغفر لع ائشة بنت أيي بكر الصديق مغفرة واجبة ظاهرة باطنة ، أتعجبان هاذه دعوتي لمن شهد أن لا إلاه إلا الله وأني رسول الله ) PageV02P126 )(@)(@@) ( ك ) وتعقب عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 4361 ) قال النبي :(@)(@@) | 30 ( اللهم مطفىء الكبير ومكبر الصغير اطفئها عني ) )(@)(@@) ( حم ) عن بعض أمهات المؤمنين .(@)(@@)(@@)(@@) $ ( 4362 ) قال النبي :(@)(@@) | 30 ( اللهم عن محمد وأمته من شهد لك بالتوحيد ولي بالبلاغ ) )(@)(@@) ( ك ) عن عائشة وأبي هريرة رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4363 ) قال النبي :(@)(@@) | 30 ( اللهم عني وعمن لم يضح من أمتي 