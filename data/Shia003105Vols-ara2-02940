ms2937	 المعتمر بن عبد الله بن ربيعة، وقيل المعتمر ن عتاب حافظ ثقة ثبت مات سنة ١٣٢ ه‍ تهذيب التهذيب ١٠: ٢٧٧ - 279.(@)(١) أبو مسهر: هو عبد الأعلى بن مسهر الغساني الدمشقي، ويقال له ابن أبي دارمة. من حفاظ الحديث، كان شيخ الشام. وعالها، مات في سجن بغداد في فتنة خلق القرآن سنة ٢١٨ ه‍، تاريخ بغداد ١١: ٧٢، تهذيب التهذيب ١: ٩٠ - ٩٢. تذكرة الحفاظ ١: ٣٤٦، الأعلام للزركلي.(@)(@@) (٢) أبو الوليد هشام بن عمار بن نصير بن ميسرة السامي، قاض من القراء المشهورين من أهل دمشق - قال الذهبي:(@)(@@) خطيبها ومقرئها ومحدثها وعالمها - له كتاب فضائل القرآن، مات سنة ٢٤٥ ه‍. غاية النهاية ٢: ٣٥٤، ميزان الاعتدال ٣: ٣٥٥. الاعلام.(@)(@@) (٣) سعيد بن منصور بن شعبة حافظ حجة توفي سنة ٢٢٧ ه‍، تذكرة الحفاظ ٢: ٤١٦، شذرات الذهب 2: 62.(@)(١) مبشر بكر الشين بن إسماعيل الحلبي أبو إسماعيل الكلبي مولاهم، روى عنه الإمام أحمد بن حنبل، ذكره ابن حبان في الثقات مات سنة ٢٠٠ في حلب، تهذيب التهذيب ١٠: ٢٩.(@)(@@) (٢) هو معان بن رفاعة السلامي أبو محمد الدمشقي ويقال الحمصي، وثقه البعض وضعفه الآخرون، قال ابن حبان:(@)(@@) هو منكر الحديث يروي مراسيل. تهذيب التهذيب ١٠: ١٨١ - 182، المغني في الضعفاء 2: 665.(@)(١) عبد الله بن أحمد بن شبويه، تاريخ بغداد ٩: ٣٧١.(@)(@@) (٢) أبو عبيد: هو القاسم بن سلام البغدادي الفقيه القاضي صاحب التصانيف، قال ابن حبان في الثقات وهو أحد أئمة الدنيا، مات سنة ٢٢٤ ه‍، تاريخ بغداد ١٢: ٤٠٣. تهذيب التهذيب ٨: ٢٨٣ - ٢٨٥، طبقات الحنابلة ١: ٥٥٩.(@)(@@) (٣) كثير بن شنظير المازني أبو قرة البصري، تهذيب التهذيب ٨: ٣٧٤ - 375.(@)(١) علي بن عبد الله بن جعفر بن نجيح بن بكر السعدي البصري، المعروف بابن المديني، علم كبير في الجرح والتعديل، وله تصانيف عديدة، قال أبو حاتم: كان علما في معرفة الحديث، والعلل. توفي سنة ٢٣٤ ه‍. تاريخ بغداد ١١: ٤٨٥، تذكرة الحفاظ ٢: ٤٢٨. طبقات الحنابلة ١: ٢٢٥.(@)(@@) (٢) أبو بكر بن أبي شيبة الامام الحافظ عبد الله بن محمد بن إبراهيم بن عثمان العيسي الكوفي. مات سنة ٢٣٥ ه‍. الفهرست: ٣٣٤. تاريخ بغداد ١٠: ٦٦، تذكرة الحفاظ ٢: ٤٣٢، تهذيب التهذيب ٦: ٣ - ٤.(@)(@@) (٣) يزيد بن زريع التميمي أبو معاوية البصري حافظ ثقة اخرج حديثه الستة 
ms2938	 مات سنة ١٨٢ ه‍. له ترجمة في تذكرة الحفاظ ١: ٢٥٦، تهذيب التهذيب ١١: ٢٨٤ - ٢٨٦ تقدمت ترجمته.(@)(@@) (٤) الحافظ الثبت إسماعيل بن إبراهيم بن مقسم البصري، أبو بشر المعروف بابن علية (وعلية هي أمه)، اخرج حديثه الستة، مات سنة ه‍. تاريخ بغداد ٦: ٢٢٩، تذكرة الحفاظ ١: ٣٢٢، تهذيب التهذيب ١: ٢٤١ - 243.(@)(١) الحافظ العابد بشر بن المفضل بن لاحق البصري الرقاشي، أبو إسماعيل، قال أحمد: إليه المنتهى في التثبت بالبصرة، ثقة كثير الحديث، مات سنة ١٨٦ ه‍ أو بعدها، تذكرة الحفاظ ١: ٣٠٩، تهذيب التهذيب ١: ٤٠٢.(@)(@@) (٢) عبد الوارث بن سعيد بن ذكوان العنبري، أبو عبيدة البصري حافظ ثبت أخرج حديثه الستة، مات سنة ١٨٠ ه‍. تذكرة الحفاظ ١: ٢٥٧، تهذيب التهذيب ٦: ٣٩١ - ٣٩٢.(@)(@@) (٣) عبد العزيز بن محمد الدراوردي، أبو محمد المدني، ثقة ثبت كثير الحديث أخرج حديثه الستة مات سنة ١٨٧ ه‍. تهذيب التهذيب ٦: ٣١٥ - ٣١٦. تذكرة الحفاظ ١: ٢٤٨. الاعلام.(@)(@@) (٤) حديث: والامام ضامن، وراه الإمام أحمد في مسنده ٢: ٤١٩، ٤٢٤، وأبو داود في سننه ١: ٣٠٢، والترمذي ١: ٤٠٢ رقم ٢٠٧، ولزيادة الفائدة انظر تعليق الشيخ أحمد شاكر على الحديث: سنن الترمذي ١: ٤٠٢، 404، 405.(@)(@@) (5) حديث " لا تزال طائفة من أمتي " انظر الفتح الكبير 3: 321، 324.(@)(١) يحيى بن معين بن عون بن زياد، المري بالولاء، البغدادي، أبو زكريا، امام في الحديث، وصفه الذهبي بسيد الحفاظ، وقال ابن حنبل: هو أعلمنا بالرجال، وقال العسقلاني: إمام الجرح والتعديل، له تصانيف مات سنة ٢٣٣. تاريخ بغداد ١٤: ١٧٧. تهذيب التهذيب ١١: ٢٤٦ - 252، وفيات الأعيان 2: 214، الاعلام.(@)(1) من محلات بغداد.(@)(١) عبد المؤمن بن أحمد بن حوثرة الجرجاني أبو عمرو العطار كان ممن روى عنه: أبو أحمد بن عدي، الاكمال لابن مأكولا ٢: ٥٢٢.(@)(@@) (٢) عفان بن مسلم بن عبد الله الصفار الحافظ الثبت أبو عثمان البصري محدث بغداد، اخرج حديثه الستة، مات سنة ٢٢٠ ه‍. تاريخ بغداد ١٢: ٢٩٦، تذكرة الحفاظ ١: ٣٧٩، تهذيب التهذيب ٧: ٢٠٥ - ٢٠٩.(@)(@@) (٣) الحافظ سليمان بن حرب الأزدي، أبو أيوب البصري، سكن مكة، وصار قاضيها، قال أبو حاتم: كان إماما من الأئمة ويتكلم في الرجال والفقه، مات سنة ٢٢٤ ه‍. له ترجمة في تاريخ بغداد ٥: ٣٣، تذكرة الحفاظ ١: ٣٩٣.(@)(@@) (4) هو شعبة بن الحجاج بن الورد العتكي أبو بسطام، تقدمت ترجمته.(@)(١) رواه البيهقي 
ms2939	 من حديث زاهر بن نوح عن عبد الله بن جعفر والد ابن المديني عن العلاء عن أبيه عن أبي هريرة.(@)(@@) قال المناوي: وعبد الله مجمع على ضعفه. فيض القدير ٦: ٧٩.(@)(@@) (٢) عمر بن حفص بن غياث النخعي أبو عمر الكوفي قاضيها وقاضي بغداد اخرج حديثه الستة مات سنة ١٩٥ ه‍.(@)(@@) تاريخ بغداد ٨: ١٩٨. تذكرة الحفاظ ١: ٢٩٧.(@)(@@) (3) انظرها في معجم البلدان. فقد أتى على ذكرها.(@)(١) عبد الرحمن بن إبراهيم بن عمرو بن ميمون القرشي الأموي، مولى آل عثمان، أبو سعيد الدمشقي المعروف بدحيم بالتصغير كان في الفقه على مذهب الأوزاعي وهو ثقة ثبت شهد له بذلك أئمة المحدثين ومعهم ابن حبان مات سنة ٢٤٥ ه‍، تهذيب التهذيب ٦: ١١٩ - ١٢١، تاريخ بغداد ١٠: ٢٦٥.(@)(@@) (٢) خلف بن سالم المخرمي أبو محمد المهلبي السندي البغدادي الحافظ ذكره ابن حبان في الثقات مات سنة ٢٣١.(@)(@@) تهذيب التهذيب ٣: ١٣١ - ١٣٢، تذكرة الحفاظ ٢: ٢٨١.(@)(@@) (٣) إبراهيم بن محمد بن عرعرة أبو إسحاق البصري ذكره ابن حبان في الثقات مات سنة ٢٣١، تهذيب التهذيب ١: ١٣٥ - ١٣٦. شذرات الذهب ٢: ٧٠.(@)(@@) (٤) إسحاق بن إبراهيم الحنظلي مولاهم أبو يعقوب المروزي المعروف بابن راهويه عالم خراسان وأحد الحفاظ الكبار، أخذ عنه الإمام أحمد، والإمام الشافعي، والبخاري، ومسلم، والترمذي، والنسائي، وله تصانيف، توفي بنيسابور سنة ٢٣٨، تهذيب ابن عساكر ٢: ٤٠٩، وتهذيب التهذيب ١: ١٩٠ - 192، وطبقات الحنابلة 68، ووفيات الأعيان 1: 64. الأعلام للزركلي.(@)(١) الحافظ الثبت الجهبذ الناقد محمد بن عبد الله بن نمير الهمداني الكوفي الخارفي، قال أحمد: هو درة العراق، له كلام في الجرح والتعديل وقال ابن حبان: كان من الحفاظ المتقنين وأهل الورع والدين توفي سنة ٢١٤.(@)(@@) طبقات ابن سعد ٦: ٢٨٩، مقدمة الجرح والتعديل ٣٢٠، الوافي بالوافيات ٣: ٣٠٤. تذكرة الحفاظ ٢: ٤٣٩.(@)(@@) (٢) الحافظ أبو أيوب سليمان بن داود البصري الشاذكوني عالم ناقد عراف بالرجال، قال عمرو الناقد: قدم الشاذكوني بغداد، فقال لي أحمد بن حنبل: اذهب بنا نتعلم منه نقد الرجال، مات سنة ٢٣٤ ه‍ تاريخ بغداد ٩: ٤٠، تذكرة الحفاظ ٢: ٤٨٨، ميزان الاعتدال ٢: ٢٠٥.(@)(١) بلبل بن حرب أبو بكر البصري، تهذيب التهذيب ١: ٤٣٦، ميزان الاعتدال ١: ٣٥٢.(@)(@@) (٢) طارق بن عبد الرحمن البجلي الأحمسي الكوفي، تهذيب التهذيب ٥: ٥ - ٦.(@)(@@) (٣) إبراهيم بن مهاجر البجلي أبو إسحاق 
ms2940	 الكوفي، تهذيب التهذيب ١: ١٤٦.(@)(@@) (٤) رواه الترمذي: الاحكام ٤: ٧٨ رقم ١٤٨٦، وقال: حسن صحيح، وأبو داود: انظر الجامع الصغير ٢: ١٣٢.(@)(١) عبد الله بن محمد بن أبي شيبة إبراهيم بن عثمان بن خواستي العبسي، مولاهم، أبو بكر الحافظ الكوفي، ذكره ابن حبان في الثقات، روى مسلم أكثر أحاديثه. مات سنة ٢٣٥ ه‍، تاريخ بغداد ١٠: ٦٦. تهذيب التهذيب ٣٠٦ - ٤، الأعلام للزركلي.(@)(@@) (٢) عبدان الأهوازي أبو محمد بن عبد الله بن موسى بن زياد، حافظ ثقة صاحب التصانيف مات سنة ٣٠٦، تاريخ بغداد ٩: ٣٧٨.(@)(@@) (٣) عثمان بن أبي شيبة محمد بن إبراهيم الكوفي. تاريخ بغداد ١١: ٢٣٢. تذكرة ٢: ٤٤٤.(@)(@@) (٤) مشكدانة: هو عبد الله بن عمر بن أبان الأموي، ولاء أبو عبد الرحمن الكوفي، لقبه مشكدانة. مات سنة ٢٣٨، تهذيب التهذيب ٥: ٢٩٠ - ٢٩١.(@)(@@) (٥) عبد الله بن براد بن يوسف بن أبي بردة الأشعري، أبو عامر الكوفي، تهذيب التهذيب ٥: ١٣٧.(@)(@@) (٦) يحيى بن سعيد.(@)(@@) (٧) عبد الله بن مسعود الصحابي الجليل.(@)(@@) (٨) الامام علقمة بن قيس بن عبد الله النخعي الكوفي التابعي الكبير، ومن أعلم الناس بحديث عبد الله بن مسعود، مات سنة ٦١، أو بعدها. تذكرة الحفاظ ١: ٤٨، طبقات القراء للذهبي ١: ٢٩.(@)(@@) (٩) إبراهيم بن يزيد بن قيس أبو عمرا النخعي فقيه أهل الكوفة ومفتيها، قال الأعمش: كان صيرفيا في الحديث.(@)(@@) مات سنة ٩٥ ه‍. تذكرة الحفاظ ١: ٧٣، النهاية في طبقات القراء ١: ٢٩.(@)(@@) (١٠) منصور بن المعتمر، تقدمت ترجمته.(@)(@@) (١١) مطين. الحافظ الكبير أبو جعفر محمد بن عبد الله بن سليمان الحفري الكوفي مات سنة ٢٩٧ ه‍ الفهرست ٣٣٧.(@)(@@) تذكرة الحفاظ ٢: ٦٦٢.(@)(١) عمرو بن علي بن بحر بن كنيز أبو حفص الباهلي الصيرفي الفلاس ذكره ابن حبان في الثقات، تهذيب التهذيب ٨: ٧٠ - ٧١، شذرات الذهب ٢: ١٢٠، الاعلام.(@)(@@) (٢) عمر بن إبراهيم بن سليمان البغدادي الحافظ، والملقب بأبي الآذان، مات سنة ٢٨٦ ه‍، تهذيب التهذيب ٧: ٣٧٢ - 373.(@)(١) الإمام محمد بن إسماعيل بن إبراهيم بن المغيرة البخاري أبو عبد الله خير الاسلام والحافظ لحديث رسول الله صلى الله عليه وسلم، صاحب الجامع الصحيح المعروف بصحيح البخاري وغيره من الكتب ولد ببخارى ونشأ يتيما وانكب على العلم فسمع من ألف شيخ، وزار خراسان والعراق ومصر والشام مات سنة ٢٥٦ 