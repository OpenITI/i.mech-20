ms2501	 عن مكحول والزهري وعنه ابنه خالد والوليد بن مسلم.(@)(@@)(@@)(@@) | 3811 - (@)(@@) " عبد الرحمن " بن يزيد بن جابر الأزدي أبو عتبة الشامي الداراني عن أبيه وأخيه وعنه ابن المبارك.(@)(@@)(@@)(@@) | 3812 - (@)(@@) " عبد الرحمن " بن يونس بن هاشم العباسي مولاهم أبو مسلم المستملي الحافظ(@)(@@) PageV07P285(@)(@@) البغدادي مولى المنصور عن سفيان ابن عيينة وعنه البخاري.(@)(@@)(@@)(@@) | 3813 - (@)(@@) " عبد الرحمن " بن يونس بن محمد أبو محمد الرقي السراج عن ابن أبي حازم وغيره وعنه المحاملي وعدة قال الدارقطني لا بأس به وذكره ابن حبان في الثقات.(@)(@@)(@@)(@@) | 3814 - (@)(@@) " عبد الرحمن " المليكي هو ابن أبي بكر بن عبد الله بن أبي مليكة.(@)(@@)(@@)(@@) | 3815 - (@)(@@) " عبد الرحمن " الأزدي الجرمي البصري والد أشعث عن سمرة وعنه ابنه الأشعث وثقه بن حبان.(@)(@@)(@@)(@@) | 3816 - (@)(@@) " عبد الرحمن " مولى قيس بصري عن زياد النميري وعنه نوح بن قيس مجهول.(@)(@@)(@@)(@@) | 3817 - (@)(@@) " عبد الرحمن " القرشي التيمي بن أخي محمد بن المنكدر عن عمه محمد بن المنكدر وعنه عبد الله بن داود الواسطي.(@)(@@) PageV07P286(@)(@@)(@@)(@@) | من اسمه عبد الرحيم وعبد الرزاق(@)(@@)(@@)(@@) | 3818 - (@)(@@) " عبد الرحيم " بن داود وقيل اسمه عبد الرحمن عن صالح بن صهيب وعنه نصر بن القاسم لا يعرف.(@)(@@)(@@)(@@) | 3819 - (@)(@@) " عبد الرحيم " بن زيد العمي1 البصري أبو زيد عن أبيه وعنه مرحوم العطار.(@)(@@)(@@)(@@) | 3820 - (@)(@@) " عبد الرحيم " بن ميمون المعافري مولاهم المدني أبو مرحوم الزاهد نزيل مصر عن علي بن رباح2 وعنه سعيد بن أيوب.(@)(@@)(@@)(@@) | 3821 - (@)(@@) " عبد الرحيم " بن هارون الغساني أبو هشام الواسطي نزيل بغداد عن ابن عون وعنه عبد بن حميد. PageV07P286(@)(@@)(@@)(@@) | 3822 - (@)(@@) " عبد الرزاق " بن عمر الثقفي أبو بكر الدمشقي عن الزهري وعنه أبو مسهر وغيره ضعفوه.(@)(@@)(@@)(@@) | 3823 - (@)(@@) " عبد الرزاق" بن همام بن نافع الحميري مولاهم أبو بكر الصنعاني أحد الأئمة الاعلام الحفاظ عن ابن جريج وهشام عنه أحمد وإسحاق وابن المديني.(@)(@@) PageV07P287(@)(@@)(@@)(@@) | من اسمه عبد السلام وعبد الصمد وعبد العزيز(@)(@@) 3824 – " عبد السلام " بن أبي الجنوب1 المدني عن الحسن وعنه ابن إسحاق.(@)(@@) 3825 – " عبد السلام " بن حرب بن سلمة النهدي بالنون الملائي أبو بكر الكوفي الحافظ بصري عن أيوب وليث 
ms2502	 وعنه إسحاق السلولي.(@)(@@) 3826 – " عبد السلام " بن حفص2 أبو مصعب ويقال: ابن مصعب الليثي أو السلمي القرشي مولاهم أبو حفص المدني أو الطائفي وكأنهما اثنان عن عبد الله بن دينار وعنه أبو عامر العقدي.(@)(@@) 3827 – " عبد السلام " بن صالح بن سليمان العبشمي مولاهم أبو الصلت الهروي مولى قريش نزل نيسابور عن حماد بن زيد ومالك وعنه محمد بن رافع.(@)(@@) 3828 – " عبد السلام " بن عبد القدوس بن حبيب الكلاعي3 أبو محمد الدمشقي عن الأعمش وعنه نعيم بن حماد.(@)(@@) 3829 – " عبد الصمد " بن حبيب أو بن عبد الله بن حبيب الأزدي عن أبيه وعنه هاشم بن القاسم.(@)(@@) 3830 – " عبد الصمد " بن سليمان الأزرق عن خصيف بن مجدر وعنه سعيد بن سليمان وإبراهيم بن موسى قال الدارقطني: متروك. PageV07P287(@)(@@)(@@)(@@) | 3831 - (@)(@@) " عبد العزيز " بن أبان ابن محمد بن عبد الله بن سعيد بن العاص الأموي السعيدي أبو خالد الكوفي نزيل بغداد عن الثوري ضعفوه قيل روى عنه الترمذي.(@)(@@)(@@)(@@) | 3832 - (@)(@@) " عبد العزيز " بن أسيد1 الطاحي البصري عن ابن الزبير وعنه أبو مسلمة سعيد بن يزيد.(@)(@@)(@@)(@@) | 3833 - (@)(@@) " عبد العزيز " بن بشير2 بن كعب البصري عن سليمان ابن عامر وعنه أبو نعامة مجهول.(@)(@@)(@@)(@@) | 3834 - (@)(@@) " عبد العزيز3 " بن جريج المكي مولى قريش عن عائشة وعنه ابنه عبد الملك.(@)(@@)(@@)(@@) | 3835 - (@)(@@) " عبد العزيز " بن أبي حازم سلمة بن دينار المخزومي مولاهم المدني الفقيه عن أبيه وسهيل بن صالح وعنه قتيبة وعلي بن حجر.(@)(@@)(@@)(@@) | 3836 - (@)(@@) " عبد العزيز " بن ربيعة البناني4 أبو ربيعة البصري عن الأعمش وعنه محمد بن يحيى القطيعي.(@)(@@)(@@)(@@) | 3837 - (@)(@@) " عبد العزيز " بن أبي رواد قيل اسمه ميمون العتكي مولى المهلب بن أبي صفرة عن عكرمة وسالم عنه ابنه عبد المجيد ويحيى القطان.(@)(@@)(@@)(@@) | 3838 - (@)(@@) " عبد العزيز " بن عبد الله بن عبيد الله بن عمر العدوي والد عبد الله الزاهد العمري أبو محمد المدني عن عمه سالم وعنه ابن أبي ذئب.(@)(@@)(@@)(@@) | 3839 - (@)(@@) " عبد العزيز " بن عبد الله بن يحيى بن عمرو بن أويس بن سعد بن أبي سرح القرشي الأويسي أبو القاسم 
ms2503	 المدني الفقيه عن مالك ونافع وعنه محمد بن يحيى الذهلي. PageV07P288(@)(@@)(@@)(@@) | 3840 - (@)(@@) " عبد العزيز " بن عبد الملك.(@)(@@)(@@)(@@) | 3841 - (@)(@@) " عبد العزيز " بن عبيد الله بن حمزة بن صهيب بن سنان الحمصي عن شهر والقاسم وعنه إسماعيل بن عياش فقط.(@)(@@)(@@)(@@) | 3842 - (@)(@@) " عبد العزيز " بن عمر بن عبد العزيز بن مروان الأموي أبو محمد المدني نزيل الكوفة عن مجاهد ومكحول وعنه شعبة ومسعر.(@)(@@)(@@)(@@) | 3843 - (@)(@@) " عبد العزيز " بن عمران ابن عبد العزيز بن عمر بن عبد الرحمن بن عوف الزهري المدني الأعرج يعرف بابن أبي ثابت عارف بالأنساب عن أبيه وعنه أبو مصعب.(@)(@@)(@@)(@@) | 3844 - (@)(@@) " عبد العزيز " بن قيس العبدي البصري عن ابن عمر وابن عباس وعنه ابنه والمثنى بن دينار.(@)(@@)(@@)(@@) | 3845 - (@)(@@) " عبد العزيز " بن محمد بن عبيد الجهني أو القضاعي مولاهم أبو محمد المدني الدراوردي أحد الاعلام عن زيد بن اسلم وعنه ابن وهب.(@)(@@)(@@)(@@) | 3846 - (@)(@@) " عبد العزيز " بن المختار الأنصاري مولاهم أبو إسحاق البصري الدباغ عن ثابت وعنه معلى بن أسد ومسدد.(@)(@@)(@@)(@@) | 3847 - (@)(@@) " عبد العزيز " بن مروان بن الحكم الأموي أبو الاصبغ الأمير أخو الخليفة عبد الملك وهو والد عمر1 عن أبي هريرة وعنه علي بن رباح.(@)(@@)(@@)(@@) | 3848 - (@)(@@) " عبد العزيز " بن مسلم القسملي2 مولاهم أبو زيد المروزي ثم البصري كان من العابدين عن عبد الله بن دينار وعنه ابن مهدي والقعنبي.(@)(@@)(@@)(@@) | 3849 - (@)(@@) " عبد العزيز " بن المطلب بن عبد الله بن حنطب المخزومي أبو طالب المدني PageV07P289(@)(@@) القاضي عن أبيه وصفوان ابن سليم وعنه معن ابن عيسى.(@)(@@)(@@)(@@) | 3850 - (@)(@@) " عبد العزيز " بن يحيى المدني نزيل نيسابور عن مالك وعنه سلمة بن شبيب وابن زنجويه وغيرهما ضعيف.(@)(@@)(@@)(@@) | 3851 - (@)(@@) " عبد العزيز " بن يحيى بن يوسف البكائي مولاهم أبو الاصبغ الحراني عن ابن عيينة عنه أبو داود والذهلي1.(@)(@@)(@@)(@@) | 3852 - (@)(@@) " عبد العزيز " أخو حذيفة أو بن أخي حذيفة عن حذيفة وعنه حميد بن زياد. PageV07P290(@)(@@)(@@)(@@) | من اسمه عبد القاهر وعبد القدوس(@)(@@)(@@)(@@) | 3853 - (@)(@@) " عبد القاهر " بن السري السلمي أبو رفاعة أو أبو بشر البصري عن حميد الطويل وعنه أبو نعيم.(@)(@@)(@@)(@@) | 3854 - (@)(@@) " عبد القاهر " بن 
ms2504	 عبد الله عن خالد بن أبي عمران ما روى عنه سوى معاوية بن صالح.(@)(@@)(@@)(@@) | 3855 - (@)(@@) " عبد القدوس " بن الحجاج أبو المغيرة الخولاني الحمصي عن حريز بن عثمان والأوزاعي روى عنه البخاري وأحمد رحمهما الله تعالى.(@)(@@) PageV07P290(@)(@@)(@@)(@@) | من اسمه عبد الكريم(@)(@@)(@@)(@@) | 3856 - (@)(@@) " عبد الكريم " بن روح بن عنبسة الأموي مولاهم أبو سعيد البصري البزاز.(@)(@@)(@@)(@@) | 3857 - (@)(@@) " عبد الكريم " بن عبد الله بن شقيق العقيلي البصري عن أبيه وعنه بديل بن ميسرة.(@)(@@)(@@)(@@) | 3858 - (@)(@@) " عبد الكريم " بن مالك الجزري الأموي مولاهم أبو سعيد الأموي الخضرمي2 عن مقسم وعنه مالك. PageV07P290(@)(@@)(@@)(@@) | 3859 - (@)(@@) " عبد الكريم " بن محمد الجرجاني أبو سهل القاضي عن ابن جريج وروى عنه الشافعي رحمه الله تعالى.(@)(@@)(@@)(@@) | 3860 - (@)(@@) " عبد الكريم " بن أبي المخارق1 قيس البصري أبو أمية المعلم عن أنس. PageV07P291(@)(@@)(@@)(@@) | من اسمه عبد المتعال وعبد المجيد(@)(@@)(@@)(@@) | 3861 - (@)(@@) " عبد المتعال " بن طالب الأنصاري أبو محمد البغدادي أصله من بلخ عن أبي عوانة وروى عنه البخاري.(@)(@@)(@@)(@@) | 3862 - (@)(@@) " عبد المجيد " بن عبد العزيز بن أبي رواد الأزدي أبو عبد الحميد المكي.(@)(@@) PageV07P291(@)(@@)(@@)(@@) | من اسمه عبد الملك(@)(@@)(@@)(@@) | 3863 - (@)(@@) " عبد الملك " بن اعين الشيباني مولاهم الكوفي عن أبي وائل وعنه السفيانان.(@)(@@)(@@)(@@) | 3864 - (@)(@@) " عبد الملك " بن حسين أبو مالك النخعي الواسطي.(@)(@@)(@@)(@@) | 3865 - (@)(@@) " عبد الملك " بن الخطاب بن عبيد الله بن أبي بكرة الثقفي البصري عن حنظلة السدوسي وعنه محمد بن عبد العزيز الرملي.(@)(@@)(@@)(@@) | 3866 - (@)(@@) " عبد الملك " بن الربيع بن سبرة بن معبد الجهني عن أبيه وعنه ابن أخيه حرملة بن عبد العزيز.(@)(@@)(@@)(@@) | 3867 - (@)(@@) " عبد الملك " بن زيد بن سعيد بن زيد بن عمرو بن نفيل العدوي المدني.(@)(@@)(@@)(@@) | 3868 - (@)(@@) " عبد الملك " بن سعيد بن سويد الأنصاري المدني عن أبي اسيد وجابر وعنه بكير بن الأشج.(@)(@@)(@@)(@@) | 3869 - (@)(@@) " عبد الملك " بن أبي سليمان ميسرة العرزمي2 الفزاري أبو محمد الكوفي أحد الأئمة عن أنس وسعيد بن جبير وعنه شعبة والسفيانان. PageV07P291(@)(@@)(@@)(@@) | 3870 - (@)(@@) " عبد الملك " بن الصباح المسمعي أبو محمد الصنعاني ثم البصري عن ابن عون.(@)(@@)(@@)(@@) | 3871 - (@)(@@) " عبد الملك " بن الطفيل الجزري عن كتاب عمر بن عبد العزيز 
ms2505	 وعنه ابن المبارك رحمه الله تعالى.(@)(@@)(@@)(@@) | 3872 - (@)(@@) " عبد الملك " بن عبد الله بن محمد بن سيرين البصري عن ابن عون وعنه يحيى.(@)(@@)(@@)(@@) | 3873 - (@)(@@) " عبد الملك " بن عبد الرحمن الشامي نزيل البصرة أبو العباس.(@)(@@)(@@)(@@) | 3874 - (@)(@@) " عبد الملك " بن عبيد.(@)(@@)(@@)(@@) | 3875 - (@)(@@) " عبد الملك " بن عبد العزيز القشيري النسائي أبو نصر التمار الحافظ العابد.(@)(@@)(@@)(@@) | 3876 - (@)(@@) " عبد الملك " بن عبد العزيز بن عبد الله بن أبي سلمة بن الماجشون التيمي أبو مروان الفقيه مفتي أهل المدينة عن أبيه ومالك وعنه سليمان ابن داود.(@)(@@)(@@)(@@) | 3877 - (@)(@@) " عبد الملك " بن عبد العزيز بن جريج الأموي مولاهم أبو الوليد أو أبو خالد المكي الفقيه أحد الاعلام عن ابن أبي مليكة وعكرمة وعنه الأوزاعي.(@)(@@)(@@)(@@) | 3878 - (@)(@@) " عبد الملك " بن علاف1 عن أنس وعنه عنبسة بن عبد الرحمن.(@)(@@)(@@)(@@) | 3879 - (@)(@@) " عبد الملك " بن عمرو القيسي أبو عامر العقدي البصري الحافظ عن أفلح بن حميد وقرة بن خالد وعنه أحمد وإسحاق ويحيى بن معين.(@)(@@)(@@)(@@) | 3880 - (@)(@@) " عبد الملك " بن عمير بن سعيد اللخمي حليف بني عدي الكوفي الفرسي القبطي عن جرير وعنه شهر بن حوشب.(@)(@@)(@@)(@@) | 3881 - (@)(@@) " عبد الملك " بن قتادة أو بن قدامة أو بن ملحان أو بن منهال عن أبيه وعنه أنس بن سيرين فقط.(@)(@@)(@@)(@@) | 3882 - (@)(@@) " عبد الملك " بن قدامة بن إبراهيم بن محمد بن حاطب الجمحي المدني.(@)(@@)(@@)(@@) | 3883 - (@)(@@) " عبد الملك " بن قريب بن عبد الملك بن علي بن اصمع الباهلي أبو سعيد الأصمعي البصري أحد الاعلام عن مسعر ومالك وعنه يحيى بن معين. PageV07P292(@)(@@)(@@)(@@) | 3884 - (@)(@@) " عبد الملك " بن القعقاع.(@)(@@)(@@)(@@) | 3885 - (@)(@@) " عبد الملك " بن محمد الذماري.(@)(@@)(@@)(@@) | 3886 - (@)(@@) " عبد الملك " بن محمد بن عبد الله بن محمد بن عبد الملك الرقاشي أبو محمد أو أبو قلابة البصري الضرير الحافظ نزيل بغداد عن يزيد بن هارون وعنه ابن ماجة.(@)(@@)(@@)(@@) | 3887 - (@)(@@) " عبد الملك " بن مروان بن الحارث بن أبي ذباب الدوسي المدني عن سالم.(@)(@@)(@@)(@@) | 3888 - (@)(@@) " عبد الملك " بن مسلم الرقاشي جد أبي قلابة عن أبي جرو1 المازني وعلي وعنه حفيده عبد الله بن محمد بن عبد الملك 
ms2506	 لم يصح حديثه قاله البخاري.(@)(@@)(@@)(@@) | 3889 - (@)(@@) " عبد الملك " بن الوليد بن معدان الضبعي البصري عن عاصم بن بهدلة.(@)(@@)(@@)(@@) | 3890 - (@)(@@) " عبد الملك " بن يسار الهلالي المدني مولى ميمونة رضى الله عنهما عن أبي هريرة رضى الله عنه وعنه اخوه سليمان.(@)(@@)(@@)(@@) | 3891 - (@)(@@) " عبد الملك " الزبيري عن طلحة بن عبيد الله وعنه أبو سعيد مجهول.(@)(@@)(@@)(@@) | 3892 - (@)(@@) " عبد الملك " القيسي عن هند وعنه ابنه طود.(@)(@@)(@@)(@@) | 3893 - (@)(@@) " عبد الملك " أبو جعفر عن أبي نضرة وعنه حماد بن سلمة وثقه بن حبان.(@)(@@)(@@)(@@) | 3894 - (@)(@@) " عبد الملك " بن أخي عمرو بن حريث تابعي أرسل وعنه حصين بن عبد الرحمن. PageV07P293(@)(@@)(@@)(@@) | من اسمه عبد المنعم وعبد المؤمن وعبد المهيمن(@)(@@)(@@)(@@) | 3895 - (@)(@@) " عبد المنعم " بن نعيم الإسواري أبو سعيد البصري صاحب السقاء عن يحيى بن مسلم وعنه معلى بن أسد قال النسائي: ليس بثقة.(@)(@@)(@@)(@@) | 3896 - (@)(@@) " عبد المؤمن " بن خالد الحنفي أبو خالد المروزي القاضي عن أبي هريرة.(@)(@@)(@@)(@@) | 3897 - (@)(@@) " عبد المهيمن " بن عباس بن سهل بن سعد الساعدي الأنصاري المدني عن أبيه وعنه ابنه عباس.(@)(@@) PageV07P293(@)(@@)(@@)(@@) | من اسمه عبد الواحد وعبد الوارث وعبد الوهاب(@)(@@)(@@)(@@) | 3898 - (@)(@@) " عبد الواحد " بن زياد العبدي مولاهم البصري أبو بشر أحد الاعلام عن ليث وعنه ابن مهدي ومسدد.(@)(@@)(@@)(@@) | 3899 - (@)(@@) " عبد الواحد " بن سليم المالكي البصري عن عطاء وعنه أبو داود الطيالسي.(@)(@@)(@@)(@@) | 3900 - (@)(@@) " عبد الواحد " بن صالح عن إسحاق الأزرق وعنه علي بن ميمون العطار.(@)(@@)(@@)(@@) | 3901 - (@)(@@) " عبد الواحد " بن صفوان الأموي مولاهم المدني عن أبيه وعكرمة وعنه يحيى القطان وهدبة وقال يحيى بن معين ليس بشيء وقال مرة صالح.(@)(@@)(@@)(@@) | 3902 - (@)(@@) " عبد الواحد " بن عبد الله بن كعب بن عمير النصري بالنون أبو بسر1 الدمشقي عن أبيه عبد الله بن بسر وعنه عبد الوهاب بن بخت وثقه العجلي.(@)(@@)(@@)(@@) | 3903 - (@)(@@) " عبد الواحد " بن قيس السلمي أبو حمزة الدمشقي الأفطس النحوي عن عروة ونافع وعنه الأوزاعي.(@)(@@)(@@)(@@) | 3904 - (@)(@@) " عبد الواحد " بن واصل أبو عبيدة الحداد السدوسي مولاهم البصري نزيل بغداد عن بهز بن حكيم وعوف الأعرابي وعنه أحمد ويحيى بن معين وزياد بن أيوب.(@)(@@)(@@)(@@) | 3905 
ms2507	 - (@)(@@) " عبد الوارث " ويقال: عبد الأكبر ويقال: عبد الاكرم بن أبي حنيفة الكوفي شيخ لشعبة يروي عن إبراهيم النخعي.(@)(@@)(@@)(@@) | 3906 - (@)(@@) " عبد الوارث " بن سعيد بن ذكوان التميمي العنبري مولاهم أبو عبيدة التنوري2 البصري أحد الاعلام عن عبد العزيز بن صبيح وعنه ابنه PageV07P294(@)(@@) عبد الصمد.(@)(@@)(@@)(@@) | 3907 - (@)(@@) " عبد الوهاب " بن بخت1 الأموي مولاهم أبو عبيدة المكي سكن الشام عن ابن عمر وأنس وعنه مالك وزيد بن أبي أنيسة.(@)(@@)(@@)(@@) | 3908 - (@)(@@) " عبد الوهاب " بن الضحاك بن أبان العرضي2 أبو الحارث الحمصي نزيل سلمية3.(@)(@@)(@@)(@@) | 3909 - (@)(@@) " عبد الوهاب " بن عبد الحميد بن الصلت عبد الله بن الحكيم أبو محمد البصري أفرده بن أبي حاتم وهو الثقفي أحد الأئمة عن حميد وأيوب وخالد الحذاء وعنه أحمد وإسحاق ويحيى بن معين وابن المديني والشافعي.(@)(@@)(@@)(@@) | 3910 - (@)(@@) " عبد الوهاب " بن عطاء الخفاف أبو نصر العجلي مولاهم البصري نزيل بغداد عن حميد وسليمان التيمي وابن عون وعنه أحمد ويحيى وإسحاق.(@)(@@)(@@)(@@) | 3911 - (@)(@@) " عبد الوهاب " بن الورد المكي عن رجل وعنه ابن المبارك.(@)(@@)(@@)(@@) | 3912 - (@)(@@) " عبد الوهاب " بن مجاهد بن جبر المكي عن أبيه وعنه إسماعيل بن عياش. PageV07P295(@)(@@)(@@)(@@) | من اسمه عبيد الله(@)(@@)(@@)(@@) | 3913 - (@)(@@) " عبيد الله " بن أنس بن مالك الأنصاري البصري عن أبيه وعنه ابنه أبو بكر والصواب عبيد الله بن أبي بكر لا يعرف.(@)(@@)(@@)(@@) | 3914 - (@)(@@) " عبيد الله " بن اياد بن لقيط السدوسي أبو السليل الكوفي كان عريف قومه عن أبيه وعنه ابن مهدي وأحمد بن يونس.(@)(@@)(@@)(@@) | 3915 - (@)(@@) " عبيد الله " بن بسر حمصي قيل هو الحراني عن أبي أمامة وعنه صفوان ابن(@)(@@) PageV07P295(@)(@@) زيد بن الحباب.(@)(@@)(@@)(@@) | 3928 - (@)(@@) " عبيد الله " بن عبد الله بن ثعلبة الأنصاري المدني وقيل عبد الله بن عبيد الله شيخ الزهري عن عبد الرحمن بن يزيد بن جارية.(@)(@@)(@@)(@@) | 3929 - (@)(@@) " عبيد الله " بن عبد الله بن موهب أبو يحيى التيمي المدني عن أبي هريرة وعمرة وعنه ابنه يحيى وابن أخيه عبيد الله بن عبد الرحمن.(@)(@@)(@@)(@@) | 3930 - (@)(@@) " عبيد الله " بن عبد الرحمن بن عبد الله بن موهب التيمي المدني روى عن عمه عبيد الله بن 
ms2508	 عبد الله وعنه الثوري وابن المبارك والقعنبي.(@)(@@)(@@)(@@) | 3931 - (@)(@@) " عبيد الله " بن عبد المجيد الحنفي أبو علي البصري عن عبيد الله بن عبد الرحمن بن موهب وهشام الدستوائي وعنه محمد بن بشار.(@)(@@)(@@)(@@) | 3932 - (@)(@@) " عبيد الله " بن عكراش1 بن ذويب التميمي عن أبيه وعنه العلاء بن الفضل.(@)(@@)(@@)(@@) | 3933 - (@)(@@) " عبيد الله " بن علي بن أبي رافع المدني يعرف بعبادل الهاشمي مولاهم عن جدته أم رافع وعنه مولاه فائد وابن عجلان.(@)(@@)(@@)(@@) | 3934 - (@)(@@) " عبيد الله " بن علي بن عرفطة السلمي ويقال: له عبيد بلا إضافة عن خداش السلمي وعنه منصور بن المعتمر.(@)(@@)(@@)(@@) | 3935 - (@)(@@) " عبيد الله " بن مخول2.(@)(@@)(@@)(@@) | 3936 - (@)(@@) " عبيد الله " بن موسى بن أبي المختار باذام العبسي مولاهم الكوفي أبو محمد الحافظ صاحب المسند عن ابن جريج وعنه البخاري وإسحاق. PageV07P297(@)(@@)(@@)(@@) | 3937 - (@)(@@) " عبيد الله " بن أبي نهيك المخزومي عن سعد وعنه ابن أبي مليك وثقه بن حبان مر في عبد الله.(@)(@@)(@@)(@@) | 3938 - (@)(@@) " عبيد الله " بن هرير بن عبد الرحمن بن رافع بن خديج الأنصاري الحارثي المدني عن أبيه وعنه ابن أبي فديك.(@)(@@)(@@)(@@) | 3939 - (@)(@@) " عبيد الله " بن الوازع الكلابي البصري عن أيوب وعنه ابن ابنه أبو عاصم الكلابي.(@)(@@)(@@)(@@) | 3940 - (@)(@@) " عبيد الله " بن الوليد الوصافي1 أبو إسماعيل الكوفي العجلي وعنه ابنه سعيد والثوري.(@)(@@)(@@)(@@) | 3941 - (@)(@@) " عبيد الله" بن يزيد بن إبراهيم الحراني القردواني2 عن حديج وعنه ابنه محمد.(@)(@@)(@@)(@@) | 3942 - (@)(@@) " عبيد الله " الباهلي مولى باهلة عن الضحاك بن مزاحم وعنه ابن عبيد.(@)(@@)(@@)(@@) | 3943 - (@)(@@) " عبيد الله " عن موسى بن طلحة وعنه ليث بن أبي سليم وحده.(@)(@@)(@@)(@@) | 3944 - (@)(@@) " عبيد الله " وقيل عبيد عن أبي هريرة رضى الله عنه. PageV07P298(@)(@@)(@@)(@@) | من اسمه عبيد وعبيدة(@)(@@)(@@)(@@) | 3945 - (@)(@@) " عبيد " وقيل عتبة بن ثمامة المرادي المصري عن عبد الله بن الحارث وعنه عبد الملك بن أبي كريمة.(@)(@@)(@@)(@@) | 3946 - (@)(@@) " عبيد " بن جبير أو جبر الغفاري أبو حفص المصري عن مولاه أبي نضرة.(@)(@@)(@@)(@@) | 3947 - (@)(@@) " عبيد " بن الخشخاش3 عن أبي ذر وعنه أبو عمر والشيباني. PageV07P298(@)(@@)(@@)(@@) | 3948 - (@)(@@) " عبيد " بن زيد بن عقبة الفزاري عن سمرة وعنه ابنه سعيد.(@)(@@)(@@)(@@) | 3949 - (@)(@@) " عبيد " بن سلمان 
ms2509	 الكلبي والد البختري عن أبي ذر وعنه ابنه البختري ويزيد النوفلي.(@)(@@)(@@)(@@) | 3950 - (@)(@@) " عبيد " بن سلمان الأغر عن أبيه وعنه ابن أبي ذئب لينه البخاري.(@)(@@)(@@)(@@) | 3951 - (@)(@@) " عبيد " بن سلمان الباهلي شيخ لأبي تميلة يحيى بن واضح روى عنه عبدان قال السليمان فيه نظر.(@)(@@)(@@)(@@) | 3952 - (@)(@@) " عبيد " بن الطفيل المقري عن عبد الرحمن بن أبي بكر المليكي وعنه عمر بن شبة.(@)(@@)(@@)(@@) | 3953 - (@)(@@) " عبيد " بن عمير عن مولاه بن عباس وعنه ابن أبي ذيب.(@)(@@)(@@)(@@) | 3954 - (@)(@@) " عبيد " بن قاسم الاسيدي الكوفي يقال: هو ابن أخت الثوري.(@)(@@)(@@)(@@) | 3955 - (@)(@@) " عبيد " بن أبي مريم المكي عن عقبة بن الحرث وعنه ابن أبي مليكة.(@)(@@)(@@)(@@) | 3956 - (@)(@@) " عبيد " بن مهران الكوفي الوزان أبو الأشعث البصري عن الحسن وعنه حرمي بن حفص وحده.(@)(@@)(@@)(@@) | 3957 - (@)(@@) " عبيد " بن واقد القيسي أبو عباد البصري عن سعيد بن عطية وعنه عمرو بن علي.(@)(@@)(@@)(@@) | 3958 - (@)(@@) " عبيد " بن أبي الوزير الحلبي عن مبشر وعنه أبو داود.(@)(@@)(@@)(@@) | 3959 - (@)(@@) " عبيد " الكندي الكوفي عن علي وعنه ابنه محمد لا يعرف.(@)(@@)(@@)(@@) | 3960 - (@)(@@) " عبيد " مولى السائب المخزومي عن عبد الله بن السائب وعنه ابنه يحيى.(@)(@@)(@@)(@@) | 3961 - (@)(@@) " عبيدة " بن معتب الضبي أبو عبد الرحيم الكوفي الضرير عن إبراهيم النخعي.(@)(@@)(@@)(@@) | 3962 - (@)(@@) " عبيدة1 " بن بلال العمي بفتح المهملة وتشديد الميم البصري نزيل2 PageV07P299(@)(@@) بخارى عن فرقد السبخي وعنه عيسى غنجار.(@)(@@)(@@)(@@) | 3963 - (@)(@@) " عبيدة " بن حميد بن صهيب التيمي أو الليثي أبو عبد الرحمن الكوفي الحذاء الضبي عن الأسود وعنه أحمد بن حنبل وابن أبي شيبة.(@)(@@)(@@)(@@) | 3964 - (@)(@@) " عبيدة " بن مسافع1 الديلي المدني عن أبي سعيد وعنه ابنه مالك.(@)(@@)(@@)(@@) | 3965 - (@)(@@) " عبيدة "2 بن ميمون الرقاشي بالقاف أبو عبيدة الخزاز البصري العطار. PageV07P300(@)(@@)(@@)(@@) | من اسمه عتاب وعتبة وعتيك(@)(@@) 3966 – " عتاب " بن بشير الأموي مولاهم أبو الحسن أو أبو سهل الجزري.(@)(@@) 3967 – " عتاب " مولى هرمز أو بن هرمز بصري عن أنس وعنه شعبة.(@)(@@) 3968 – " عتبة " بن أبي حكيم الهمداني أو الشعباني3 أبو العباس الأردني.(@)(@@) 3969 – " عتبة " بن حميد الضبي أبو معاذ البصري عن عكرمة وعنه ابن نعيم.(@)(@@) 3970 – " عتبة " بن عبد الله عن 
ms2510	 أسماء بنت عميس وعنه عبد الحميد بن جعفر.(@)(@@) 3971 – " عتبة " بن يزيد بن أصرم سمع منه جعفر بن سليمان قال البخاري: فيه نظر.(@)(@@) 3972 – " عتيك " بن الحارث بن عتيك الأنصاري عن عمه جابر وعنه سبطه عبد الله بن عبد الله. PageV07P300(@)(@@)(@@)(@@) | من اسمه عثمان(@)(@@)(@@)(@@) | 3973 - (@)(@@) " عثمان " ابن إسحاق بن خرشة القرشي العامري المدني وعنه ابن شهاب.(@)(@@)(@@)(@@) | 3974 - (@)(@@) " عثمان " ابن جبير مولى أبي أيوب الأنصاري عن أبيه وعنه عبد الله بن عثمان ابن خثيم.(@)(@@)(@@)(@@) | 3975 - (@)(@@) " عثمان " ابن الجهم الهجري عن زر بن حبيش وعنه وكيع.(@)(@@) PageV07P300(@)(@@)(@@)(@@) | 3976 - (@)(@@) " عثمان " ابن أبي حازم بن صخر بن العيلة عن أبيه وعنه أبان ابن عبد الله البجلي.(@)(@@)(@@)(@@) | 3977 - (@)(@@) " عثمان " ابن الحارث أبو الرواع عن ابن عمر وعنه الثوري فقط.(@)(@@)(@@)(@@) | 3978 - (@)(@@) " عثمان " ابن الحكم الجذامي1 المصري عن يحيى وعنه ابن وهب.(@)(@@)(@@)(@@) | 3979 - (@)(@@) " عثمان " ابن خالد بن عمرو بن عبد الله بن الوليد بن عثمان ابن عفان أبو عفان المدني والد أبي مروان عنه ابنه محمد.(@)(@@)(@@)(@@) | 3980 - (@)(@@) " عثمان " ابن ربيعة بن عبد الله بن الهدير التيمي المدني عن شداد بن أوس وعنه كثير بن زيد الأسلمي.(@)(@@)(@@)(@@) | 3990 - (@)(@@) " عثمان " ابن زائدة الكوفي أبو محمد المقري العابد نزيل الري عنه حكام بن مسلم.(@)(@@)(@@)(@@) | 3991 - (@)(@@) " عثمان " ابن سعيد الكاتب أبو بكر البصري عن أنس والحسن وعنه شعبة وروح بن عبادة.(@)(@@)(@@)(@@) | 3992 - (@)(@@) " عثمان " ابن سهل عن جده رافع بن خديج وعنه أبو شجاع الإسكندراني.(@)(@@)(@@)(@@) | 3993 - (@)(@@) " عثمان " ابن أبي سودة المقدسي عن أبي هريرة وعنه اخوه زياد والأوزاعي.(@)(@@)(@@)(@@) | 3994 - (@)(@@) " عثمان " ابن أبي شيبة هو ابن محمد.(@)(@@)(@@)(@@) | 3995 - (@)(@@) " عثمان " ابن صالح بن صفوان السهمي مولاهم أبو يحيى البصري صح أنه رأى صحابيا من الجن عن مالك والليث.(@)(@@)(@@)(@@) | 3996 - (@)(@@) " عثمان " ابن الضحاك بن عثمان المدني يقال: هو الحزامي الحجازي عن أبيه وعنه أبو مودود.(@)(@@)(@@)(@@) | 3997 - (@)(@@) " عثمان " ابن أبي عاتكة سليمان الأزدي أبو حفص الدمشقي أو القاص عن عمرو بن هانئ وعنه الوليد بن مسلم. PageV07P301(@)(@@)(@@)(@@) | 3998 - (@)(@@) " عثمان " ابن عبد الله الغافقي.(@)(@@)(@@)(@@) | 3999 - (@)(@@) " عثمان " ابن عبد الله بن 
ms2511	 الحكم بن الحارث الحجازي عن عثمان ابن عفان وعنه إسماعيل بن عمرو الأموي.(@)(@@)(@@)(@@) | 4000 - (@)(@@) " عثمان " ابن عبد الرحمن القرشي.(@)(@@)(@@)(@@) | 4001 - (@)(@@) " عثمان " ابن عبد الرحمن بن عبد الله بن سالم الجمحي البصري أبو عمر البصري عنه ابن المديني.(@)(@@)(@@)(@@) | 4002 - (@)(@@) " عثمان " ابن عبد الرحمن الطائفي.(@)(@@)(@@)(@@) | 4003 - (@)(@@) " عثمان " ابن عبد الرحمن عن إبراهيم وعنه ابن مصفى لا يعرف.(@)(@@)(@@)(@@) | 4004 - (@)(@@) " عثمان " ابن عبد الملك هو مستقيم بن عبد الملك المكي مؤذن الحرم.(@)(@@)(@@)(@@) | 4005 - (@)(@@) " عثمان " ابن عثمان الغطفاني أبو عمرو القاضي الكلابي قاضي البصرة عن زيد بن اسلم وعنه أحمد ونعيم بن حماد.(@)(@@)(@@)(@@) | 4006 - (@)(@@) " عثمان " ابن عطاء بن أبي مسلم الخراساني أبو مسعود المقدسي عن أبيه وعنه ابن المبارك وابن وهب.(@)(@@)(@@)(@@) | 4007 - (@)(@@) " عثمان " ابن عمر بن فارس العبدي أبو محمد البخاري نزيل البصرة عن هشام بن حسان وابن جريج وعنه أحمد وإسحاق.(@)(@@)(@@)(@@) | 4008 - (@)(@@) " عثمان " ابن عمرو بن ساج الأموي مولاهم عن الزهري وعنه سعيد بن سالم.(@)(@@)(@@)(@@) | 4009 - (@)(@@) " عثمان " ابن عمير أو قيس أو بن أبي حميد البجلي أبو اليقظان الأعمى كوفي.(@)(@@)(@@)(@@) | 4010 - (@)(@@) " عثمان " ابن غياث الراسبي الزهراني البصري عن عكرمة عنه شعبة.(@)(@@)(@@)(@@) | 4011 - (@)(@@) " عثمان " ابن فائد القرشي أبو لبابة البصري عن جعفر بن برقان وعنه سليمان.(@)(@@)(@@)(@@) | 4012 - (@)(@@) " عثمان " ابن فرقد العطار أبو معاذ البصري عن الأعمش وعنه ابن المديني.(@)(@@) PageV07P302(@)(@@)(@@)(@@) | 4013 - (@)(@@) " عثمان " ابن محمد بن المغيرة بن الأخنس بن شريق الثقفي الاخنسي الحجازي.(@)(@@)(@@)(@@) | 4014 - (@)(@@) " عثمان " ابن مسلم بن هرمز المكي عن نافع بن جبير وعنه مسعر.(@)(@@)(@@)(@@) | 4015 - (@)(@@) " عثمان " ابن مطر الشيباني أبو الفضل أو أبو علي البصري يقال: اسم أبيه عبد الله عن أبي هارون وعنه مسلم بن إبراهيم.(@)(@@)(@@)(@@) | 4016 - (@)(@@) " عثمان " ابن المغيرة الثقفي مولاهم أبو المغيرة الكوفي الأعشى وهو عثمان ابن أبي زرعة عن زيد بن وهب عنه مسعر وشعبة والثوري.(@)(@@)(@@)(@@) | 4017 - (@)(@@) " عثمان " ابن نعيم بن قيس الرعيني المصري عن المغيرة بن نهيك وعنه ابن لهيعة.(@)(@@)(@@)(@@) | 4018 - (@)(@@) " عثمان " ابن الهيثم بن الجهم بن عيسى بن حسان العبدي أبو عمرو البصري المؤذن عنه البخاري.(@)(@@)(@@)(@@) | 4019 - (@)(@@) " عثمان 
ms2512	 " ابن واقد بن محمد بن زيد بن عبد الله بن عمر بن الخطاب العدوي البصري عن أبيه ونافع مولى بن عمر رضى الله عنهما.(@)(@@)(@@)(@@) | 4020 - (@)(@@) " عثمان " ابن يحيى الحضرمي عن ابن عباس رضى الله عنهما.(@)(@@)(@@)(@@) | 4021 - (@)(@@) " عثمان " ابن يعلى بن مرة الثقفي عن أبيه وعنه ابنه عمرو.(@)(@@)(@@)(@@) | 4022 - (@)(@@) " عثمان " البتي في ابن مسلم أبو عمرو البصري.(@)(@@)(@@)(@@) | 4023 - (@)(@@) " عثمان " الشحام العدوي أبو سلمة البصري يقال: اسم أبيه ميمون أو عبد الله.(@)(@@) PageV07P303(@)(@@)(@@)(@@) | من اسمه عدي وعراك وعرعرة(@)(@@)(@@)(@@) | 4024 - (@)(@@) " عدي " بن ثابت الأنصاري الكوفي عن أبيه وجده لامه عبد الله الخطمي وعنه الأعمش ومسعر.(@)(@@)(@@)(@@) | 4025 - (@)(@@) " عدي " بن الفضل التيمي أبو حاتم الجسري عن أيوب وعنه أبو عامر(@)(@@) PageV07P303(@)(@@) العقدي.(@)(@@)(@@)(@@) | 4026 - (@)(@@) " عراك1 " بن خالد بن يزيد بن صالح بن صبيح المري أبو الضحاك الدمشقي المقري عن عثمان ابن عطاء ليس بالقوي.(@)(@@)(@@)(@@) | 4027 - (@)(@@) " عراك " بن مالك الغفاري الكناني المدني فقيه أهل دهلك2 عن أبي هريرة وحفصة وعائشة رضى الله عنهم.(@)(@@)(@@)(@@) | 4028 - (@)(@@) " عرعرة3 " بن البرند السامي الناجي أبو عمرو البصري لقبه كزمان روى عن خاله عباد بن منصور وعنه حفيده إبراهيم بن محمد. PageV07P304(@)(@@)(@@)(@@) | من اسمه عروة وعسل وعصام(@)(@@)(@@)(@@) | 4029 - (@)(@@) " عروة " بن سعيد وقيل عزرة4 الأنصاري عن أبيه.(@)(@@)(@@)(@@) | 4030 - (@)(@@) " عروة " بن النزال5 كوفي عن معاذ بن جبل.(@)(@@)(@@)(@@) | 4031 - (@)(@@) " عروة " المزني شيخ لحبيب بن أبي ثابت.(@)(@@)(@@)(@@) | 4032 - (@)(@@) " عسل "6 بن سفيان التميمي اليربوعي أبو قرة البصري عن عطاء وعنه الحمادان.(@)(@@)(@@)(@@) | 4033 - (@)(@@) " عصام " بن زيد مدني عن ابن المنكدر وعنه عبد الله بن نافع الصائغ وحده. PageV07P304(@)(@@)(@@)(@@) | من اسمه عطاف وعطاء(@)(@@)(@@)(@@) | 4036 - (@)(@@) " عطاف "2 بن خالد بن عبد الله بن العاص المخزومي أبو صفوان المدني.(@)(@@)(@@)(@@) | 4037 - (@)(@@) " عطاء " بن دينار الهذلي مولاهم أبو الريان3 المصري وقيل أبو طلحة المصري.(@)(@@)(@@)(@@) | 4038 - (@)(@@) " عطاء " بن أبي رباح واسم أبي رباح اسلم القرشي مولاهم أبو محمد الجندي اليماني نزيل مكة أحد الفقهاء والائمة.(@)(@@)(@@)(@@) | 4039 - (@)(@@) " عطاء " بن أبي مسلم أبو عثمان أو أبو أيوب الخراساني واسم أبيه ميسرة مولى المهلب بن أبي صفرة نزيل الشام أحد الاعلام. 
ms2513	(@)(@@)(@@)(@@) | 4040 - (@)(@@) " عطاء " بن السائب الثقفي أبو محمد الكوفي أحد الأئمة عن أنس وغيره وعنه شعبة وغيره.(@)(@@)(@@)(@@) | 4041 - (@)(@@) " عطاء " بن عجلان الحنفي أبو محمد البصري العطار عن أنس وغيره عنه إبراهيم بن أدهم.(@)(@@)(@@)(@@) | 4042 - (@)(@@) " عطاء " بن مسلم الخفاف أبو مخلد الكوفي نزيل حلب عن الأعمش وعنه ابن المبارك. PageV07P305(@)(@@)(@@)(@@) | 4043 - (@)(@@) " عطاء " بن أبي ميمونة البصري أبو معاذ واسم أبي ميمونة منيع عن أنس وغيره وعنه ابناه روح وإبراهيم وغيرهما.(@)(@@)(@@)(@@) | 4044 - (@)(@@) " عطاء " الشامي أنصاري سكن الساحل.(@)(@@)(@@)(@@) | 4045 - (@)(@@) " عطاء " أبو الحسن السوائي1 عن ابن عباس وعنه ابنه يعلى.(@)(@@)(@@)(@@) | 4046 - (@)(@@) " عطاء " المدني مولى أم صبية2 عن أبي هريرة وعنه سعيد المقبري.(@)(@@)(@@)(@@) | 4047 - (@)(@@) " عطاء " مولى أبي أحمد بن جحش عن أبي هريرة وعنه سعيد المقبري.(@)(@@)(@@)(@@) | 4048 - (@)(@@) " عطاء " العامري الطائفي عن ابن عباس وعنه ابنه يعلى. PageV07P306(@)(@@)(@@)(@@) | من اسمه عطية وعفان وعفير وعفيف(@)(@@)(@@)(@@) | 4049 - (@)(@@) " عطية " بن سعد بن جنادة الجدلي أبو الحسن الكوفي عن أبي هريرة وأبي سعيد وابن عباس وعنه ابناه عمر والحسن وغيرهما.(@)(@@)(@@)(@@) | 4050 - (@)(@@) " عطية " بن سفيان ابن عبد الله بن ربيعة الثقفي.(@)(@@)(@@)(@@) | 4051 - (@)(@@) " عطية " بن عامر الجهني عنه زيد بن وهب.(@)(@@)(@@)(@@) | 4052 - (@)(@@) " عفان " ابن مسلم بن عبد الله الأنصاري الباهلي مولى عزرة بن ثابت أبو عثمان البصري.(@)(@@)(@@)(@@) | 4053 - (@)(@@) " عفير " بن معدان الحمصي المؤذن عن عطاء الليثي وعنه الوليد بن مسلم.(@)(@@)(@@)(@@) | 4054 - (@)(@@) " عفيف " بن سالم الموصلي البجلي مولاهم أبو عمرو الفقيه3 عن يونس بن أبي إسحاق وعنه علي بن حجر ربما أخطأ.(@)(@@)(@@)(@@) | 4055 - (@)(@@) " عفيف " بن عمرو بن المسيب السهمي. PageV07P306(@)(@@)(@@)(@@) | من اسمه عقبة وعقيل(@)(@@)(@@)(@@) | 4056 - (@)(@@) " عقبة " بن التوأم1 عن أبي كثير وعنه وكيع وعكرمة بن عمار.(@)(@@)(@@)(@@) | 4057 - (@)(@@) " عقبة " بن خالد بن عقبة السكوني أبو مسعود الكوفي المجدر وعنه أحمد وإسحاق وغيرهما.(@)(@@)(@@)(@@) | 4058 - (@)(@@) " عقبة " بن عبد الله الرفاعي البصري عن شهر وعطاء.(@)(@@)(@@)(@@) | 4059 - (@)(@@) " عقبة " بن عبد الرحمن بن أبي معمر الحجازي.(@)(@@)(@@)(@@) | 4060 - (@)(@@) " عقبة " بن عبيد أبو الرجال الطائي الكوفي.(@)(@@)(@@)(@@) | 4061 - (@)(@@) " عقبة " بن علقمة اليشكري أبو الجنوب الكوفي عن علي وعنه النضر بن منصور.(@)(@@)(@@)(@@) | 4062 - (@)(@@) " عقبة " بن علقمة بن 
ms2514	 جريج المعافري البيروتي عنه ابنه محمد وهارون بن معروف.(@)(@@)(@@)(@@) | 4063 - (@)(@@) " عقبة " بن وهب بن عقبة العامري الكوفي عن أبيه وعنه ابن عيينة وأبو نعيم.(@)(@@)(@@)(@@) | 4064 - (@)(@@) " عقبة " العقيلي عن أبي هريرة وعنه ابنه عامر.(@)(@@)(@@)(@@) | 4065 - (@)(@@) " عقبة " الشامي والد محمد روى عنه ابنه محمد بن عقبة القاضي.(@)(@@)(@@)(@@) | 4066 - (@)(@@) " عقيل " بن جابر بن عبد الله الأنصاري المدني عن أبيه وعنه صدقة بن يسار.(@)(@@)(@@)(@@) | 4067 - (@)(@@) " عقيل " بن شبيب وقيل سعيد.(@)(@@)(@@)(@@) | 4068 - (@)(@@) " عقيل " بالضم بن خالد بن عقيل بالفتح الأيلي أبو خالد الأموي مولاهم مولى عثمان رضى الله عنه. PageV07P307(@)(@@)(@@)(@@) | من اسمه عكرمة والعلاء(@)(@@)(@@)(@@) | 4069 - (@)(@@) " عكرمة " بن خالد بن سلمة بن العاص بن هشام المخزومي عن أبيه ضعيف.(@)(@@)(@@)(@@) | 4070 - (@)(@@) " عكرمة " بن خالد بن سعيد بن العاص بن هشام المخزومي المكي ثقة أخطأ في تضعيفه.(@)(@@)(@@)(@@) | 4071 - (@)(@@) " عكرمة " بن عمار الحنفي العجلي أبو عمار اليمامي البصري أحد الأئمة عن عطاء وطاوس وعنه شعبة والسفيانان.(@)(@@)(@@)(@@) | 4072 - (@)(@@) " عكرمة " بن عبد الله البربري مولى بن عباس أبو عبد الله أحد الأئمة الاعلام عن مولاه عائشة رضى الله عنهما وخلق وعنه الشعبي والنخعي.(@)(@@)(@@)(@@) | 4073 - (@)(@@) " العلاء " بن بشير المزني البصري عن أبي الصديق الناجي وعنه المعلى بن زياد.(@)(@@)(@@)(@@) | 4074 - (@)(@@) " العلاء " بن الحارث بن عبد الوارث الحضرمي أبو وهب أو أبو محمد الدمشقي أحد الأئمة الكبار.(@)(@@)(@@)(@@) | 4075 - (@)(@@) " العلاء " بن أبي حكيم يحيى الشامي سياف معاوية عن معاوية وعنه الوليد بن أبي الوليد.(@)(@@)(@@)(@@) | 4076 - (@)(@@) " العلاء " بن خالد الكاهلي الكوفي الأسدي عن أبي وائل وعنه الثوري.(@)(@@)(@@)(@@) | 4077 - (@)(@@) " العلاء " بن خالد الواسطي أو البصري القرشي أو الرياحي مولاهم الواسطي.(@)(@@)(@@)(@@) | 4078 - (@)(@@) " العلاء " بن زيد البصري هو العلاء بن زيدل1 وهو العلاء بن أبي محمد الثقفي أبو محمد عن أنس وعنه يحيى القطان.(@)(@@)(@@)(@@) | 4079 - (@)(@@) " العلاء " بن زهير بن عبد الله الأزدي أبو زهير الكوفي.(@)(@@)(@@)(@@) | 4080 - (@)(@@) " العلاء " ب