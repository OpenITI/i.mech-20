ms181	 الحريش(@)(@)(@@) [جش].(@)(@)(@@)(@@)(@@) $ الحسن بن علي بن زكريا(@)(@)(@@) البزوفري العدوي [غض].(@)(@)(@@)(@@)(@@) $ الحسين بن أحمد المنقري(@)(@)(@@) [جخ].(@)(@)(@@)(@@)(@@) $ حمدان أبو جعفر(@)(@)(@@)(@@)(@@) $ . خالد بن طهمان أبو العلاء(@)(@)(@@) الخفاف(@)(@)PageV01P543(@)(@)(@@) السلولي [جش].(@)(@)(@@)(@@)(@@) $ سالم بن مكرم أبو خديجة(@)(@)(@@) الجمال [جخ].(@)(@)(@@)(@@)(@@) $ سلمة بن الخطاب أبو الفضل(@)(@)(@@) البراوستاني [غض].(@)(@)(@@)(@@)(@@) $ سليمان بن داود المنقري(@)(@)(@@) [غض].(@)(@)(@@)(@@)(@@) $ صالح بن الحكم النيلي(@)(@)(@@) الأحول [جش].(@)(@)(@@)(@@)(@@) $ عبد الله بن أبي زيد الأنباري(@)(@)(@@) [جخ].(@)(@)(@@)(@@)(@@) $ عبد الله بن الحكم الأرمني(@)(@)(@@) [جش].(@)(@)(@@)(@@)(@@) $ عبد الله بن داهر بن يحيى(@)(@)(@@) الأحمري.(@)(@)(@@)(@@)(@@) $ عبيد الله بن الدهقان الواسطي(@)(@)(@@) [جش].(@)(@)(@@)(@@)(@@) $ عبد الله بن الهلقام(@)(@)(@@) [جخ].(@)(@)(@@)(@@)(@@) $ عبد العزيز بن أبي ذئب(@)(@)(@@) ، وهو عبد العزيز بن عمران ضعفه ابن نمير.(@)(@)(@@)(@@)(@@) $ عبد العزيز العبدي(@)(@)(@@) [جش].(@)(@)(@@)(@@)(@@) $ عبد الملك بن المنذر القمي(@)(@)(@@) [جش].(@)(@)(@@)(@@)(@@) $ عكرمة مولى ابن عباس(@)(@)(@@) [كش].(@)(@)(@@)(@@)(@@) $ علي بن حسان بن كثير(@)(@)(@@) الهاشمي [جش] ضعيف جدا [كش] واقفي [غض] مخلط.(@)(@)(@@)(@@)(@@) $ علي بن رميس البغدادي(@)(@)(@@) [جخ].(@)(@)PageV01P544(@)(@)(@@)(@@)(@@) $ علي بن محمد القاشاني(@)(@)(@@) [جخ].(@)(@)(@@)(@@)(@@) $ عمارة بن زيد أبو زيد(@)(@)(@@) الخيواني المدني [غض].(@)(@)(@@)(@@)(@@) $ عمرو بن شمر أبو عبد الله(@)(@)(@@) الجعفي [جش].(@)(@)(@@)(@@)(@@) $ القاسم بن الربيع الصحاف(@)(@)(@@) [غض].(@)(@)(@@)(@@)(@@) $ محمد بن أورمة(@)(@)(@@) [جخ، غض] اتهم بالغلو.(@)(@)(@@)(@@)(@@) $ محمد بن عبد الملك(@)(@)(@@) كوفي [جخ].(@)(@)(@@)(@@)(@@) $ محمد بن علي الهمداني(@)(@)(@@) [جخ].(@)(@)(@@)(@@)(@@) $ محمد بن الفضيل الأزدي(@)(@)(@@) كوفي [جخ].(@)(@)(@@)(@@)(@@) $ محمد بن هارون(@)(@)(@@) [جخ].(@)(@)(@@)(@@)(@@) $ محمد بن يحيى المعاذي(@)(@)(@@) [جخ].(@)(@)(@@)(@@)(@@) $ معلى بن خنيس(@)(@)(@@) مولى أبي عبد الله [جش].(@)(@)(@@)(@@)(@@) $ ممويه(@)(@)(@@) [جخ].(@)(@)(@@)(@@)(@@) $ موسى بن رنجويه أبو عمران(@)(@)(@@) الأرمني [جش].(@)(@)(@@)(@@)(@@) $ موسى بن سعدان الخياط(@)(@)(@@) [جش].(@)(@)(@@)(@@)(@@) $ مياح المدائني(@)(@)(@@) [جش].(@)(@)(@@)(@@)(@@) $ يوسف بن حماد(@)(@)(@@) كوفي [كش].(@)(@)(@@)(@@)(@@) $ يوسف بن السخت البصري(@)(@)(@@) [غض].(@)(@)(@@)(@@)(@@) $ يوسف بن يعقوب الجعفي(@)(@)(@@) [كش].(@)(@)PageV01P545(@)(@)(@@)(@@)(@@) || فصل فيمن قيل إنه مخلط أو مضطرب:(@)(@@)(@@)(@@) $ إسحاق بن محمد بن أحمد(@)(@)(@@) بن أبان [جش] هو معدن التخليط.(@)(@)(@@)(@@)(@@) $ إسماعيل بن علي بن رزين(@)(@)(@@) بن عثمان بن عبد الرحمن بن بديل بن ورقاء الخزاعي أبو القاسم، ابن أخي دعبل [جش].(@)(@)(@@)(@@)(@@) $ إسماعيل بن مهران بن محمد(@)(@)(@@) بن أبي نصر السكوني [غض].(@)(@)(@@)(@@)(@@) $ جابر بن يزيد الجعفي(@)(@)(@@) [جش].(@)(@)(@@)(@@)(@@) $ سلمة بن صالح الأحمر(@)(@)(@@) الواسطي [جخ].(@)(@)(@@)(@@)(@@) $ عطاء بن رباح(@)(@)(@@) [جخ].(@)(@)(@@)(@@)(@@) $ علي بن أحمد العقيقي(@)(@)(@@)(@@)(@@) $ . علي بن صالح بن محمد 
ms182	(@)(@)(@@) بن يزداد الرفاء [جش].(@)(@)(@@)(@@)(@@) $ علي بن محمد بن جعفر(@)(@)(@@) بن عنبسة الحداد العسكري [جش] مضطرب الحديث.(@)(@)(@@)(@@)(@@) $ عمرو بن عبد العزيز(@)(@)(@@) [جش].(@)(@)(@@)(@@)(@@) $ محمد بن أحمد بن محمد(@)(@)(@@) بن سنان [غض] نسبه وحديثه مضطرب.(@)(@)(@@)(@@)(@@) $ محمد بن جعفر بن بطة(@)(@)(@@) المؤدب(@)(@)PageV01P546(@)(@)(@@) القمي [جش].(@)(@)(@@)(@@)(@@) $ محمد بن جعفر بن عنبسة(@)(@)(@@) الأهوازي الحداد يعرف بابن ريذويه [جش].(@)(@)(@@)(@@)(@@) $ محمد بن عبد الله بن البهلول(@)(@)(@@) بن همام أبو الفضل [جش].(@)(@)(@@)(@@)(@@) $ محمد بن عمر الجرجاني(@)(@)(@@) [جش].(@)(@)(@@)(@@)(@@) $ محمد بن المظفر أبو دلف(@)(@)(@@) الأزدي [جش].(@)(@)(@@)(@@)(@@) $ معلى بن محمد البصري(@)(@)(@@) [جش].(@)(@)(@@)(@@)(@@) $ منصور بن العباس أبو الحسن(@)(@)(@@) الرازي [جش].(@)(@)(@@)(@@)(@@) $ يحيى بن زكريا النرماشيري(@)(@)(@@) أبو الحسن [جش].(@)(@)(@@)(@@)(@@) || فصل فيمن قيل يعرف حديثه تارة وينكر أخرى:(@)(@@)(@@)(@@) $ سهيل بن زياد الواسطي(@)(@)(@@) أبو يحيى [غض].(@)(@)(@@)(@@)(@@) $ صالح بن أبي حماد، أبو الحسين(@)(@)(@@) الرازي [جش].(@)(@)(@@)(@@)(@@) $ عبد الرحمن بن أحمد بن نهيك(@)(@)(@@) السمرقندي الملقب بدحمان [جش].(@)(@)(@@)(@@)(@@) $ علي بن جعفر الهماني(@)(@)(@@) [جش].(@)(@)(@@)(@@)(@@) $ محمد بن حسان الرازي(@)(@)(@@) أبو عبد الله الزيدي [جش].(@)(@)PageV01P547(@)(@)(@@)(@@)(@@) $ محمد بن خالد بن عبد الرحمن(@)(@)(@@) بن علي البرقي [غض].(@)(@)(@@)(@@)(@@) || فصل فيمن طعن عليه بفساد مذهبه:(@)(@@)(@@)(@@) $ أحمد بن محمد بن نوح(@)(@)(@@) البصري السيرافي [ست]: حكي عنه مذاهب فاسدة في الأصول كالرؤية وغيرها.(@)(@)(@@)(@@)(@@) $ الحسين بن أحمد بن المغيرة(@)(@)(@@) أبو عبد الله البوشنجي [غض].(@)(@)(@@)(@@)(@@) $ الحسين بن حمدان الخصيبي(@)(@)(@@) الجنبلاني أبو عبد الله [جش].(@)(@)(@@)(@@)(@@) $ الحسين بن قياما(@)(@)(@@) [كش].(@)(@)(@@)(@@)(@@) $ داود بن كثير الرقي(@)(@)(@@) [غض].(@)(@)(@@)(@@)(@@) $ علي بن عبد الله بن محمد(@)(@)(@@) بن عاصم المعروف بالخديجي [جش].(@)(@)(@@)(@@)(@@) $ علي بن محمد بن شيرة(@)(@)(@@) القاشاني أبو الحسن [جش].(@)(@)(@@)(@@)(@@) $ فارس بن حاتم بن ماهويه(@)(@)(@@) القزويني [غض].(@)(@)(@@)(@@)(@@) $ قعنب بن أعين(@)(@)(@@) [كش] كان مرجئا.(@)(@)(@@)(@@)(@@) $ المفضل بن عمر(@)(@)(@@) [جش].(@)(@)(@@)(@@)(@@) $ هارون بن مسلم بن سعدان(@)(@)(@@) الكاتب(@)(@)PageV01P548(@)(@)(@@) السرمنرآئي [جش].(@)(@)(@@)(@@)(@@) $ هشام بن إبراهيم العباسي(@)(@)(@@) [غض].(@)(@)(@@)(@@)(@@) || فصل فيمن قيل إنه ثقة لكنه يروي عن الضعفاء:(@)(@@)(@@)(@@) $ أحمد بن محمد بن خالد(@)(@)(@@) البرقي [جش، غض].(@)(@)(@@)(@@)(@@) $ أحمد بن محمد بن جعفر(@)(@)(@@) أبو علي الصولي [جش].(@)(@)(@@)(@@)(@@) $ حذيفة الخزاعي(@)(@)(@@) [غض].(@)(@)(@@)(@@)(@@) $ الحسن بن محمد بن جمهور(@)(@)(@@) العمي [جش].(@)(@)(@@)(@@)(@@) $ الحسين بن أسد البصري(@)(@)(@@) [غض].(@)(@)(@@)(@@)(@@) $ علي بن أبي سهل حاتم(@)(@)(@@) بن أبي حاتم القزويني 
ms183	 أبو الحسن [جش].(@)(@)(@@)(@@)(@@) $ محمد بن جعفر بن عون(@)(@)(@@) الأسدي أبو الحسن ساكن الري يقال له محمد بن أبي عبد الله [جش].(@)(@)(@@)(@@)(@@) $ نصر بن مزاحم المنقري(@)(@)(@@) العطار أبو الفضل [جش].(@)(@)(@@)(@@)(@@) || فصل فيمن قيل إنه يضع الحديث:(@)PageV01P549(@)(@)(@@)(@@)(@@) $ أبان بن أبي عياش(@)(@)(@@) [غض].(@)(@)(@@)(@@)(@@) $ الحسن بن محمد بن الحسن(@)(@)(@@)(@@)(@@) $ . جعفر بن عبيد الله بن الحسين(@)(@)(@@) بن علي بن الحسين بن علي بن أبي طالب صاحب النسب [غض].(@)(@)(@@)(@@)(@@) $ عبد الله بن محمد البلوي(@)(@)(@@) [غض].(@)(@)(@@)(@@)(@@) $ عبيد بن كثير بن محمد(@)(@)(@@) ، وقيل عبيد بن محمد بن كثير، المكاري الكلابي الوحيدي يكنى أبا المحجل [غض].(@)(@)(@@)(@@)(@@) $ عبد الرحمن بن كثير الهاشمي(@)(@)(@@) [جش].(@)(@)(@@)(@@)(@@) $ محمد بن عبد الله بن المطلب(@)(@)(@@) الشيباني يكنى أبا المفضل [غض].(@)(@)(@@)(@@)(@@) $ المفضل بن صالح أبو جميلة(@)(@)(@@) السكوني وقيل الأسدي النخاس [غض].(@)(@)(@@)(@@)(@@) $ يونس بن ظبيان(@)(@)(@@) [غض].(@)(@)(@@)(@@)(@@) $ وممن أطلق عليه الكذب:(@)(@)(@@)(@@)(@@) $ جعفر بن محمد بن مالك(@)(@)(@@) [غض].(@)(@)(@@)(@@)(@@) $ سليمان بن عمرو بن داود(@)(@)(@@) النخعي كذاب النخع [غض].(@)(@)(@@)(@@)(@@) $ عمر أخو عذافر(@)(@)(@@) [كش] كذبه الصادق.(@)(@)(@@)(@@)(@@) $ المغيرة بن سعيد(@)(@)(@@) [كش].(@)(@)PageV01P550(@)(@)(@@)(@@)(@@) || فصل فيمن وردت فيه اللعنة:(@)(@@)(@@)(@@) $ أبو هارون المكفوف(@)(@)(@@)(@@)(@@) $ . أحمد بن هلال أبو جعفر(@)(@)(@@) العبرتائي [كش].(@)(@)(@@)(@@)(@@) $ أشعث بن قيس أبو محمد(@)(@)(@@) [جخ].(@)(@)(@@)(@@)(@@) $ بسر بن أرطاة(@)(@)(@@) ، وقيل ابن أبي أرطاة القرشي [ست].(@)(@)(@@)(@@)(@@) $ بشار الشعيري الدهقان(@)(@)(@@) [كش].(@)(@)(@@)(@@)(@@) $ عبد الله بن الكواء(@)(@)(@@) [جخ].(@)(@)(@@)(@@)(@@) $ عبد الله بن ميمون القداح(@)(@)(@@) المكي [جخ].(@)(@)(@@)(@@)(@@) $ عبد الله بن وهب(@)(@)(@@) رأس الخوارج [جخ].(@)(@)(@@)(@@)(@@) $ عروة بن يحيى الدهقان(@)(@)(@@) النخاس [كش] لعنه أبو محمد (عليه السلام) وأمر شيعته بلعنة.(@)(@)(@@)(@@)(@@) $ عمرو بن حريث(@)(@)(@@) من رجال أمير المؤمنين، عدو الله ملعون [جخ].(@)(@)(@@)(@@)(@@) $ محمد بن أبي زينب(@)(@)(@@) وهو ابن مقلاس، لعنه أبو عبد الله (عليه السلام).(@)(@)(@@)(@@)(@@) $ المغيرة بن سعيد(@)(@)(@@) ، لعنه أبو عبد الله (عليه السلام).(@)(@)(@@)(@@)(@@) $ ميمون القداح(@)(@)(@@) [جخ].(@)(@)(@@)(@@)(@@) $ نوفل بن فروة الأشجعي(@)(@)(@@) [جخ].(@)(@)(@@)(@@)(@@) $ يونس بن ظبيان(@)(@)(@@) [كش] لعنه الكاظم (عليه السلام)(@)(@)PageV01P551(@)(@)(@@) ألف لعنة يتبعها ألف لعنة كل لعنة تبلغه قعر جهنم.(@)(@)(@@)(@@)(@@) $ من دعا عليه الإمام (عليه السلام):(@)(@)(@@)(@@)(@@) $ حجر بن زائدة الحضرمي(@)(@)(@@) [كش] ق: لا غفر الله له.(@)(@)(@@)(@@)(@@) $ الحكم بن عتيبة(@)(@)(@@) [كش] ق: اللهم لا تغفر ذنبه.(@)(@)(@@)(@@)(@@) $ عامر بن 
ms184	 جذاعة(@)(@)(@@) مع(@)(@)(@@)(@@)(@@) $ حجر بن زائدة(@)(@)(@@) ق: لا غفر الله لهما.(@)(@)(@@)(@@)(@@) || فصل فيمن قيل فيه إنه ليس بشيء:(@)(@@)(@@)(@@) $ جعفر بن محمد بن مفضل(@)(@)(@@) [غض].(@)(@)(@@)(@@)(@@) $ جماعة بن سعد الجعفي(@)(@)(@@) [غض].(@)(@)(@@)(@@)(@@) $ الحسين بن مسكان(@)(@)(@@) [غض].(@)(@)(@@)(@@)(@@) $ سعيد بن خيثم(@)(@)(@@) [غض] أبو معمر الهلالي.(@)(@)(@@)(@@)(@@) $ سليمان بن عبد الله الديلمي(@)(@)(@@) [غض].(@)(@)(@@)(@@)(@@) $ صالح بن سهيل الهمداني(@)(@)(@@) [غض].(@)(@)(@@)(@@)(@@) $ صالح بن عقبة بن سمعان(@)(@)(@@) مولى رسول الله (صلى الله عليه وآله وسلم) [غض].(@)(@)(@@)(@@)(@@) $ مصادف(@)(@)(@@) [غض].(@)(@)PageV01P552(@)(@)(@@)(@@)(@@) || فصل في ذكر من أطلق عليه بأنه مجهول:(@)(@@)(@@)(@@) $ إسماعيل بن قتيبة(@)(@)(@@) [جخ].(@)(@)(@@)(@@)(@@) $ أفلح بن يزيد(@)(@)(@@) [جخ].(@)(@)(@@)(@@)(@@) $ بشير المستنير الجعفي(@)(@)(@@) الأزرق بياع الطعام [جخ].(@)(@)(@@)(@@)(@@) $ الحسن بن بشير(@)(@)(@@)(@@)(@@) $ . خلف بن خلف(@)(@)(@@) [جخ].(@)(@)(@@)(@@)(@@) $ رزين الأبزاري(@)(@)(@@) [جخ].(@)(@)(@@)(@@)(@@) $ رزين الأنماطي(@)(@)(@@) [جخ].(@)(@)(@@)(@@)(@@) $ زياد بن الأسود النجار(@)(@)(@@) [جخ].(@)(@)(@@)(@@)(@@) $ زيد الآجري(@)(@)(@@) [جخ].(@)(@)(@@)(@@)(@@) $ سالم(@)(@)(@@) [جخ].(@)(@)(@@)(@@)(@@) $ سعد بن الحسن الكندي(@)(@)(@@) [جخ].(@)(@)(@@)(@@)(@@) $ سعيد بن حماد(@)(@)(@@) [جخ].(@)(@)(@@)(@@)(@@) $ صالح بن سعيد الأحول(@)(@)(@@) [جخ].(@)(@)(@@)(@@)(@@) $ عاصم بن الحسين(@)(@)(@@) [جخ].(@)(@)(@@)(@@)(@@) $ عامر بن مسلم(@)(@)(@@) [جخ].(@)(@)(@@)(@@)(@@) $ عبد الله بن زرعة(@)(@)(@@) [جخ].(@)(@)(@@)(@@)(@@) $ عبد الله بن عمرو(@)(@)(@@) [جخ].(@)(@)(@@)(@@)(@@) $ عطية بن ذكوان(@)(@)(@@) [جخ].(@)(@)PageV01P553(@)(@)(@@)(@@)(@@) $ عطية بن رستم(@)(@)(@@) [جخ].(@)(@)(@@)(@@)(@@) $ علي بن أحمد بن أشيم(@)(@)(@@) [جخ].(@)(@)(@@)(@@)(@@) $ عمرو بن هلال(@)(@)(@@) [جخ].(@)(@)(@@)(@@)(@@) $ عمر بن يحيى(@)(@)(@@) [جخ].(@)(@)(@@)(@@)(@@) $ الفضل بن غياث(@)(@)(@@) [جخ].(@)(@)(@@)(@@)(@@) $ القاسم بن أسباط(@)(@)(@@) [جخ].(@)(@)(@@)(@@)(@@) $ القافي خادم أبي الحسن (عليه السلام)(@)(@)(@@) [جخ].(@)(@)(@@)(@@)(@@) $ كامل الرصافي(@)(@)(@@) [جخ].(@)(@)(@@)(@@)(@@) $ ليث بن أبي سليم(@)(@)(@@)(@@)(@@) $ . محمد بن ثابت(@)(@)(@@) [جخ].(@)(@)(@@)(@@)(@@) $ محمد بن مسكان(@)(@)(@@) [كش].(@)(@)(@@)(@@)(@@) $ محمد بن منصور الأسقف(@)(@)(@@) الأشعري [جخ].(@)(@)(@@)(@@)(@@) $ مروان بن يحيى(@)(@)(@@) [جخ].(@)(@)(@@)(@@)(@@) $ منذر بن أبي طريفة(@)(@)(@@) (@@)(@@) $ منذر السراج(@)(@)(@@) [جخ].(@)(@)(@@)(@@)(@@) $ الوليد بن بشير(@)(@)(@@) [كش].(@)(@)(@@)(@@)(@@) $ هارون الجبلي(@)(@)(@@) [جخ].(@)(@)(@@)(@@)(@@) $ هاشم بن أبي هاشم(@)(@)(@@) [جخ، كش].(@)(@)(@@)(@@)(@@) $ هاشم الرماني(@)(@)(@@) [جخ].(@)(@)(@@)(@@)(@@) $ يحيى بن عباس(@)(@)(@@)(@@)(@@) $ . يونس بن خباب(@)(@)(@@) .(@)(@)PageV01P554(@)(@)(@@)(@@)(@@) || تنبيهات(@)(@)(@@) منها: إذا وردت رواية عن محمد بن يعقوب عن محمد بن إسماعيل بلا واسطة ففي صحتها قول لأن في لقائه له إشكالا فيقف الرواية لجهالة الواسطة بينهما، وإن كانا مرضيين معظمين. وكذا ما يأتي عن الحسن بن محبوب عن أبي حمزة. ومنها: إذا وردت رواية عن موسى بن القاسم عن عبد الرحمن قال بعض أصحابنا: إنها في الصحيح، لأن عبد الرحمن متعين أن يكون 
ms185	 ابن أبي نجران وهو ثقة، لأن موسى بن القاسم معاصر علي بن جعفر وهو يروي عن الكاظم (عليه السلام) وعبد الرحمن بن أبي نجران من أصحاب الرضا (عليه السلام). أقول: وفي هذا نظر، لأن عبد الرحمن بن الحجاج من رجال الرضا (عليه السلام) وقد رمي بالكيسانية، على أن ابن الحجاج قد ورد رجوعه إلى الحق وترحم عليه الرضا (عليه السلام). ومنها: إذا وردت رواية يروي فيها موسى بن القاسم عن حماد فلا تتوهمها مرسلة لكون حماد من رجال الصادق (عليه السلام) لأن حماد إما ابن عثمان وقد بقي إلى زمن الرضا (عليه السلام) وروى عن الصادق والكاظم(@)(@)PageV01P555(@)(@)(@@) والرضا (عليهم السلام) وإما ابن عيسى فقد عمر مذ زمن الصادق (عليه السلام) إلى زمن أبي جعفر الثاني (عليه السلام) لكنه لم يرو عن الرضا ولا عن أبي جعفر (عليهما السلام) شيئا، وعندي في أنه روى عن الكاظم تردد لأني لم أقف له على ذلك. مات سنة تسع ومائتين غريقا عن نيف وسبعين سنة. ومنها: إذا وردت عليك الإسناد من إبراهيم بن هاشم إلى حماد فلا يتوهم أنه حماد بن عثمان، فإن إبراهيم بن هاشم لم يلق حماد بن عثمان بل حماد بن عيسى. ومنها: أن كل رواية يرويها محمد بن يعقوب وأبو جعفر ابن بابويه عن جميل بن دراج، أو جميل بن صالح، أو معاوية بن عمار فهي صحيحة إذا كان ما بعد ذلك من الرجال مستقيمين، فإن كان عن جميل أو معاوية بغير تقييد فيها فهي محتملة للصحة وعدمها، فإن كان معاوية بن وهب، فإن كان يروي عن أبي عبد الله (عليه السلام) بلا فصل فهي صحيحة لأنه البجلي، وإن كان بينهما آخر أشكل حالها لعدم تحتمه. ومنها: كل رواية رواها شيخنا أبو(@)(@)PageV01P556(@)(@)(@@) جعفر (رحمه الله) عن ابن محبوب، أو عن محمد بن علي بن محبوب أو عن أحمد بن محمد بن عيسى، أو عن علي بن جعفر، أو عن محمد بن أبي عمير، أو الصفار فطريق الشيخ إلى كل واحد 
ms186	 منهم واحد. ومنها: كل رواية يروي فيها سعد بن عبد الله عن أبي جعفر فالمراد بأبي جعفر هذا أحمد بن محمد بن عيسى. ومنها: أن كل رواية يروي فيها الحسن بن محبوب عن أبي القاسم فالمراد بأبي القاسم هذا معاوية بن عمار. ومنها: أن كلا من الشيخ أبي جعفر محمد بن الحسن الطوسي والشيخ الصدوق أبي جعفر محمد بن بابويه روى عن رجال لم يلقهم لكنه بينه وبينهم رجال فمنهم الثقات المستقيمون مذهبا فذاك السند صحيح. ومنهم الموثقون مع فساد مذهبهم فذاك عنده قوي، ومنهم المجروحون فذاك السند ضعيف وقد أوردت كلا من الأنواع الثلاثة إجمالا ليضبطوا ويراعى: أما الصحيح مما يتعلق بالشيخ أبي جعفر محمد بن الحسن الطوسي فما رواه(@)(@)PageV01P557(@)(@)(@@) في التهذيب والاستبصار عن محمد بن يعقوب الكليني. وعن علي بن إبراهيم بن هاشم. وعن محمد بن يحيى العطار. وعن أحمد بن إدريس. وعن الحسين بن محمد. وعن محمد بن إسماعيل. وعن حميد بن زياد وعن أحمد بن محمد بن عيسى. وعن أحمد بن محمد بن خالد. وعن الفضل بن شاذان. وعن الحسين بن سعيد. وعن محمد بن أحمد بن يحيى الأشعري. وعن محمد بن علي بن محبوب. وعن سعد بن عبد الله. وعن محمد بن الحسن بن الوليد. وعن أبي جعفر محمد بن علي بن بابويه. وعن أبي القاسم جعفر بن محمد بن قولويه. وعن موسى بن القاسم. وعن يونس بن عبد الرحمن. وعن علي بن مهزيار. وعن أحمد بن أبي عبد الله البرقي. وعن أبي عبد الله الحسين بن سفيان البزوفري. وعن أبي طالب الأنباري. وأما الحسن: فما رواه في الكتابين عن الحسن بن محبوب. وأما القوي: فما رواه عن الحسن بن محمد بن سماعه، لأن حميد بن زياد في الطريق إليه وهو واقفي إلا أنه ثقة.(@)(@)PageV01P558(@)(@)(@@) وأما الصحيح: مما يتعلق بالشيخ أبي جعفر محمد بن بابويه (رحمه الله) فما رواه عن كردويه. وعن سعد بن عبد الله بن أبي خلف. وهشام بن سالم الجواليقي. وعمر بن 
