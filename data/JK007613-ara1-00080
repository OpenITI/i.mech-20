ms61	(@)(@@) % رمتاه روحا ومن مثل روح % حين جف الثرى وقل السحاب % 46(@)(@@) % أنزلته ذرى المكارم نفس % حرة ، في بيانها إطناب % 47(@)(@@) % وإذا عدت المساعي كفاه % حاتم والمهلب الوهاب % 48(@)(@@) % وله من ندى قبيصة بحر % حضرمي لجانبيه عباب % 49(@)(@@) % حمدته القرى ، وسر به الجا % % ر وعاشت في فضله الأحباب % 50(@)(@@) % قل لروح بن حاتم بن قبيص % % المجد فينا وفيكم إعجاب % PageV01P209 51(@)(@@) % كيف لم تأتني الكرامة منكم % % بعد ود وأنتم الأرباب % 52(@)(@@) % عش حميدا وأنعم أبا خلف أن % % ت فتى الناس ليس فيك معاب % 53(@)(@@) % قد كفيت المهدي هما وشا % % غبت عدوا فالمحرب الشغاب % 54(@)(@@) % وعلى ورزن هجمت المنايا % % والمنايا في دورهم أسراب % 55(@)(@@) % ومن القوم ذو غناء ووعد % كمخاط الشيطان فيه اضطراب % 56(@)(@@) % زعم الأقرب المقابل في الح % ي معيدا وتزعم النساب % 57(@)(@@) % أن روح بن حاتم ورد الب % % حر فأضحى ينتابه الطلاب % 58(@)(@@) % ذاك داود ما عصبت به الح % % اجة إلا انقضت وهاب الغناب % 59(@)(@@) % ولباب من المهالبة الشو % % س تسامى العلى ، كذاك اللباب % 60(@)(@@) % يحسد السيد الجواد عليه % % شيم دونها يهيم الشباب % % PageV01P210 61(@)(@@) % وإذا ما داود حل بأرض % طاب ريحانها وطاب التراب % 62(@)(@@) % شم أبا مسمع سيكفيك داو % د بن روح بن حاتم ما تهاب % 63(@)(@@) % يا بن روح أشبهت روحا ومن % % يشبه أباه تتمم له الأنساب % PageV01P211 البحر : طويل 1(@)(@@) % أصفراء ما في العيش بعدك مرغب % ولا للصبى ملهى فألهو وألعب % 2(@)(@@) % أصفراء إن أهلك فأنت قتلتني % % وإن طال بي سقم فذنبك أذنب % 3(@)(@@) % أصفراء أيام النعيم لذيذة % وأنت مع البؤسى ألذ وأطيب % 4(@)(@@) % أصفراء في قلبي عليك حرارة % وفي كبدي الهيماء نار تلهب % 5(@)(@@) % أصفراء مالي في المعازف سلوة % فأسلو ولا في الغانيات معقب % 6(@)(@@) % أصفراء لي نفس إليك مشوقة % وعين على ما فات منك تصبب % 7(@)(@@) % أصفراء لم أعرفك يوما وإنني % % إليك لمشتاق أحن وأنصب % 8(@)(@@) % لقد كنت عن عض الصبابة والهوى % % غنيا ولكن المقادير تغلب % 9(@)(@@) % بعيني من صفراء باد عجابه % وما بالحشا من حب صفراء أعجب 
ms62	 % 10(@)(@@) % وقد زادني شوقا هديل حمامة % على إلفها تبكي له وتطرب % PageV01P212 11(@)(@@) % فقلت لندماني طربت فغنني % % بصفراء لا يصفو مع الشوق مشرب % 12(@)(@@) % وما كان اغرامي بها عن مراسل % جرت بيننا بك كاعب لا تحوب % 13(@)(@@) % فيا حزنا لا أنا غر مشبب % نعمت ولا في الشوق إذ أنا أشيب % 14(@)(@@) % وما ذاك إلا حب صفراء مسني % % فيومي به مر وليلي موصب % 15(@)(@@) % وما بال قلبي لا يزول عن الصبى % % وقد زعموا أن القلوب تقلب % 16(@)(@@) % سأرمي بصولان المفاوز إنه % خروج من أبواب المفاوز منغب % % 17(@)(@@) % معوج إذا أمسى طروب إذا غدا % % مجدا كما غنى على الأيك أخطب % 18(@)(@@) % لعل ارتحالي بالعشي وبالضحى % % يقربني والنازح الدار يقرب % 19(@)(@@) % عتبت على خنزير كلب وإنني % % بذاك على الكلب التميمي أعتب % 20(@)(@@) % هما أنباني أن نعمت ببدرة % وما منهما إلا لئيم مؤنب % PageV01P213 21(@)(@@) % إذا شبعا احتالا على صاحبيهما % % كما احتال برذون الأمير المرطب % 22(@)(@@) % يهران آباء لئاما وفيهما % % حقوق لزوار الندى وتحلب % 23(@)(@@) % وطالب عرف يستعين عليهما % % فقلت له : أخطأت ما كنت تطلب % 24(@)(@@) % على الكلب أهوال إذا ما رأيته % وخنزير كلب بالمخازي مدرب % 25(@)(@@) % تعر فلا تخلطهما بمودة % ولا قربا ما في السماوات أقرب % 26(@)(@@) % إذا لم تر الذهلي أنوك فالتمس % % له نسبا غير الذي يتنسب % 27(@)(@@) % وأما بنو قيس فإن نبيذهم % كثير وأما خيرهم فمغيب % 28(@)(@@) % وفي جحدر لؤم ، وفي آل مسمع % صلاح ولكن درهم القوم كوكب % 29(@)(@@) % وسيد تيم اللات عند غدائه % % هزبر وأما في اللقاء فثعلب % 30(@)(@@) % وقد كان في ( شيبان ) عز فحلقت % به في قديم الدهر عنقاء مغرب % PageV01P214 31(@)(@@) % وحيا ' لجيم ' قسوران تنزعت % % شباتهما لم يبق ناب ومخلب % 32(@)(@@) % وأنذل من يمشي ' ضبيعة ' إنهم % % زعانف لم يخطب إليهم محجب % 33(@)(@@) % و ' يشكر ' خصيان عليهم غضارة % وهل يدرك المجد الخصي المجبب % 34(@)(@@) % وأبلج مسهاء كأن لسانه % % إذا راح ذو النونين بل هو أقرب % 35(@)(@@) % يجلى العمى عنا بفصل إذا قضى % % ضريبته صافي الحديدة مقضب % 36(@)(@@) % إذا شئت نادى في الأنام 
ms63	 بصوته % % لأرفع ما أدى عريب ومعرب % 37(@)(@@) % لقد ساد أشراف العراق ابن ' حاتم ' % كما ساد أهل المشرقين ( المهلب ) % 38(@)(@@) % له فضلات من ( قبيصة ) في الندى % % وأكرومة من ( حاتم ) لا تعطب % 39(@)(@@) % ومن إرث ( سراق ) عليه مهابة % تظل قلوب القوم منها توجب % 40(@)(@@) % ويغدو بأخلاق ( المهلب ) مولعا % كما شمرت عن ساقها الحرب تطرب % PageV01P215 41(@)(@@) % ويعطف ( كندي ) عليه و ( ظالم % مآثر أيام تطيب وترحب % 42(@)(@@) % وتعرف منه من شمائل ( ظالم % مناقب مفضال تعود وتشعب % 43(@)(@@) % وكم من أب غمر ل ' روح بن حاتم ' % يزين آباء وزينه أب % 44(@)(@@) % إذا ذكروا في مأقط أطرق العدى % % ورنح فحل القريتين المقبقب % 45(@)(@@) % هم ذببوا عن عظم دين ' محمد ' % بأسيافهم إذ ليس فينا مذبب % 46(@)(@@) % حدا بأبي أم الريال فأجفلت % % نعامته عن عارض يتلهب % 47(@)(@@) % ولاحت وماء الأزرقين عشية % أناقيع تعفوها نسور وأذؤب % 48(@)(@@) % صفت لي يد الفياض ' روح بن حاتم ' % فتلك يد كالماء تصفو وتعذب % PageV01P216 49(@)(@@) % وما ولدوا إلا أغر متوجا % له راحة تبكي وأخرى تحلب % 50(@)(@@) % وأيام أبطال عليها بسالة % وجود كما جاد الفراتي أغلب % 51(@)(@@) % ملوك إذا هاب العطاء معاشر % وضرب الطلى سنوهما وتعجبوا % % 52(@)(@@) % سيخبر عن ' روح ' ثنائي وفعله % % وما منهما إلا رضى لا يكذب % 53(@)(@@) % تعصب ( روح ) والمكارم تابعا % لأشياخه والسابق المتعصب % 54(@)(@@) % له حكم لقمان وجزم موفق % وللموت منه مخرج حين يغضب % 55(@)(@@) % من الواردين الروع كل عشية % إذا هي قامت حاسرا لا تنقب % 56(@)(@@) % وأصيد نرجوه لكل ملمة % علينا ويرجوه الهمام المحجب % 57(@)(@@) % من الغر منعام كأن جبينه % % هلال بدا في ظلمة متنصب % 58(@)(@@) % يطيب ذفراء الدروع بجلده % ويثنى بمسك كأسه حين يشرب % PageV01P217 59(@)(@@) % طلوب ومطلوب إليه إذا غدا % % وخير خليليك الطلوب المطلب % 60(@)(@@) % وما زال في آل المهلب قائل % وخيل تسرى للطعان وتجلب % 61(@)(@@) % ولما رأى الحساد روح بن حاتم % أميرا عليه بيت ملك مطنب % 62(@)(@@) % أصاخوا كأن الطير فوق رؤوسهم % يشيمون موتا فوقهم يتقلب % 63(@)(@@) % فدام لهم غم بروح بن حاتم % ودام لروح ملكه المترقب % PageV01P218 البحر : رمل 
ms64	 تام 1(@)(@@) % آب ليلي ليت ليلي لم يؤب % إنما الليل عناء للوصب % % 2(@)(@@) % أرقب الليل كأني واجد % راحة في الصبح من جهد التعب % % 3(@)(@@) % ولقد أعلم أني مصبح % مثلما أمسيت إن لم تحتسب % % 4(@)(@@) % فأرتني ثم شطت شطة % تركت قلبي إليها يضطرب % 5(@)(@@) % ما أقل الصبر عنها بعدما % % كثرت فينا أحاديث العرب % % 6(@)(@@) % قر عينا بحبيب نظرة % لا يقر العين إلا ما تحب % 7(@)(@@) % وكلت بي جارتي أسهودة % شر ما وكل بالجار الجنب % % 8(@)(@@) % ونصيحين ألما باكر % بطبيب وطبيبي المجتنب % % 9(@)(@@) % سألاني وصف ما ألقى ولا % % أستطيع الوصف ، إني مكتئب % 10(@)(@@) % غير أني قلت في قولهما % % قولة أخفيتها كالمنتيب % PageV01P219 11(@)(@@) % بينا من قربه لي حاجة % ثم لا يقرب والدار صقب % % 12(@)(@@) % يا خليلي ألما بي بها % % نظرة ثم سلاني عن وصب % % 13(@)(@@) % شغلت نفسي عن وصف الهوى % % باشتياقي أن أراها وطرب % 14(@)(@@) % فاتركا لومي فإني عاشق % كتب الله عليه ما كتب % 15(@)(@@) % ولقد قلت لقلبي خاليا % حين لم يلق هواها ودأب % % 16(@)(@@) % أيها الناصب في تطلابها % % بعد هذا ما تبالي ما نصب % 17(@)(@@) % لا يريد الرشد إلا ناصح % ويلي قتلك إلا من تعب % 18(@)(@@) % كل لمن يقصيك مثلا صاعه % وإذا قارب ودا فاقترب % 19(@)(@@) % والق من قد ذاق فيما لم يذق % % لا يداوي الس قم إلا من يطب % 20(@)(@@) % قتلتني فأبى قلبي وقد % آن ما كلفني حتى أحب % PageV01P220 21(@)(@@) % فهي عجزاء إذا ما أدبرت % % وإذا ما أقبلت فيها قبب % 22(@)(@@) % لم تر العين لعين فتنة % مثلها بين جمادى ورجب % 23(@)(@@) % تيمتني بقوام خرعب % وبدل عجب يا للعجب ! % 24(@)(@@) % صورة الشمس جلت عن وجهها % % بعد عيني جؤذر في المنتقب % 25(@)(@@) % حلوة المنظر ريا رخصة % بعث الحسن عليها أن تسب % 26(@)(@@) % تأمن الدهر ولا ترجو لنا % % فرجا مما بنا ذاك الكذب % % 27(@)(@@) % كم رأينا مثلها في مأمن % قلب الدهر عليه فانقلب % % 28(@)(@@) % لا يغرنك يوم من غد % صاح إن الدهر يغفي ويهب % 29(@)(@@) % صاد ذا ضغن إلى غرته % وإذا درت لبون فاحتلب 
ms65	 % % 30(@)(@@) % ليس بالصافي وإن صفيته % % عيش من يصبح نهبا للرتب % % PageV01P221 31(@)(@@) % ما أبو العباس في أثباته % لعب الدهر به تلك اللعب % % 32(@)(@@) % أقبلت أيامه حتى إذا % % جاءه الموت تولى فذهب % % PageV01P222 البحر : خفيف تام 1(@)(@@) % أصبح القلب بالنحيلة صبا % % بعد ما قد صحا وراجع لبا % % 2(@)(@@) % زاده مدخل الوليد عليه % وخيال سرى بعبدة عجبا % % 3(@)(@@) % ومقال الفتاة إذ هتك الست % % ر لها عن مقال ما كان عبا : % 4(@)(@@) % أيها المستجير من حب عبا % % دة إذ راعه خيال فهبا % % 5(@)(@@) % ليس من حبها مجير سواها % % بعد ما سار في الفؤاد ودبا % % 6(@)(@@) % يا خليلي اخرجاني من الحب % ب سويا ولا تلوما محبا % % 7(@)(@@) % فاتركا لومه ولوما خليلا % يتجنى ذنبا ولم يدر ذنبا % 8(@)(@@) % كل يوم تعتب الود منه % ليت شعري : أيحسب الود عتبا % % 9(@)(@@) % تلك عبادة التي لم تنله % غير ما أصبحت لعينيه نصبا % % 10(@)(@@) % شربت سلوة عبيدة عني % % وكأني شربت بالحب طبا % % PageV01P223 11(@)(@@) % فتقضى الرجاء منها لقد صد % طبيبي عني وقضيت نحبا % % 12(@)(@@) % أنا إن لم أمت بذاك فإني % % ميت من مخافتي ذاك رعبا % % 13(@)(@@) % ليتها تاق قلبها فاستوينا % % أو رزقنا كقلب عبدة قلبا % % 14(@)(@@) % فصبرنا عنها كما صبرت % % عنا ولم نتخذ عبيدة ربا % % 15(@)(@@) % فاكشفي ما بنا وعودي علينا % % قد لقينا إليك في الحب حسبا % % PageV01P224 البحر : بسيط تام 1(@)(@@) % لا تبغ شر امرىء شرا من الداء % % واقدح بحلم ولا تقدح بشحناء % % 2(@)(@@) % مالي وأنت ضعيف غير مرتقب % أبقي عليك وتفري غير إبقاء % % 3(@)(@@) % مهلا فإن حياض الحرب مترعة % من الذعاف مرار تحت حلواء % % 4(@)(@@) % أحين طلت على من قال قافية % وطال شعري بحي بعد أحياء % % 5(@)(@@) % ألزمت عينك من بغضائنا حولا % لو قد وسمتك عادت غير حولاء % % 6(@)(@@) % اطلب رضاي ولا تطلب مشاغبتي % % لا يحمل الضرع المقور أعبائي % % 7(@)(@@) % أنا المرعث لا أخفى على أحد % ذرت بي الشمس للداني وللنائي % % 8(@)(@@) % يغدو الخليفة مثلي في محاسنه % ولست مثلي فنم يا ماضغ الماء % % 9(@)(@@) % إني إذا شغلت قوما فقاحهم % رحب المسالك 
ms66	 نهاض ببزلاء % % 10(@)(@@) % يثوي الوفود وأدعى قبل يومهم % إلى الحباء ولم أحضر برقاء % % PageV01P225 11(@)(@@) % لو كان ( يحيى ) تميميا أسأت به % لكنه قرشي فرخ بطحاء % % 12(@)(@@) % ( يحيى ) فتى هاشمي عز جانبه % فلا يلام وإن أجرى مع الشاء % % 13(@)(@@) % نعم الفتى من قريش لا ندافعه % عن النبي وإن كان ابن كلاء % % 14(@)(@@) % ما زال في سرة البطحاء منبته % مقابلا بين بردي وحلفاء % % 15(@)(@@) % يا آسد الحي إن راحوا لمأدبة % وثعلب الحي إن ذافوا لأعداء % % 16(@)(@@) % لا تحسبني كأير بت تمسحه % كيما يقوم ويأبى غير إغفاء % % 17(@)(@@) % قد سبح الناس من وسمي ( أبا عمر % فهل ربعت على تسبيح قراء % % 18(@)(@@) % كويت قوما بمكواتي فما صبروا % % على العقاب وقد دبوا بدهياء % % 19(@)(@@) % وربما أغرق الأدنى فقلت له % إن كان من نفري أو نجل آبائي % % PageV01P226 20(@)(@@) % قل ما بدا لك من زور ومن كذب % % حلمي أصم وأذني غير صماء % % 21(@)(@@) % ينزو اللئيم ولو ألقيت مئزره % لاحت بوجعائه آثار كواء % % 22(@)(@@) % ما زلت تطعن بالملعون في دبر % حتى اشتريت حلاقا في است خراء % % 23(@)(@@) % هلا منعتم ( بني وادان ) أمكم % من الموسم إذ يسري بقنفاء % % 24(@)(@@) % بتم نياما وبات العلج ينفضها % % في ليلة مثل ضوء الصبح قمراء % % 25(@)(@@) % ويل مه نبطيا فض خاتمها % % بفيشة مثل رأس الكلب جوفاء % % PageV01P227 البحر : خفيف تام 1(@)(@@) % يا لقوم للزائر المنتاب % ولما قد لقيت حين المتاب % % 2(@)(@@) % أزهقت مهجتي ولم تدن إلا % % وقعة عندنا وقوع القراب % % 3(@)(@@) % يوم قامت مختالة في حقاب % ليتني كنت بعض تلك الحقاب % % 4(@)(@@) % ولقد قلت للنطاسي لما % % جئته واشتكيت داء الحباب % 5(@)(@@) % كيف لي بالسلو عمن جفاني % % وفؤادي كالطائر المستجاب % % 6(@)(@@) % أنا منه ومن جوى الحب أمسي % % في عذاب قد ناء فوق العذاب ! % 7(@)(@@) % قال : هجر الحبيب يسليك عنها % % لن تنال السلو قبل اجتناب % % 8(@)(@@) % قلت : يأبى الهوى علي ونفسي % % لا تطيع العدو في الأحباب % % 9(@)(@@) % كيف يسلو عن الرباب فؤادي % % وهواها ينوب عن كل ناب % 10(@)(@@) % ويكن النساء بيضا وأدما % % صيغة بعد صيغة الأتراب % PageV01P228 11(@)(@@) % ككعوب 
ms67	 القناة مشتبهات % وكأن الرباب أم الكتاب % 12(@)(@@) % خلقت . . . وحدها . . . خلقا % ضاع بيني وبينها في الحساب % % 13(@)(@@) % هي برد الشراب % % لا أطيق اجتناب برد الشراب % % 14(@)(@@) % غبطت نفسها % % فكأني أمد في كلاب % % PageV01P229 البحر : بسيط تام 1(@)(@@) % يا شوق من بات مشغوفا ومجتنبا % % ويا صبابته إن صد أو قربا % % 2(@)(@@) % نام اللواتي عدمن الحب من مرح % وبت أقرض في الظلماء مكتئبا % % 3(@)(@@) % وقائل صح من دائي تجنبه % لم يلق عجبا وإن حدثته عجبا % % 4(@)(@@) % ما لي رأيتك لا تصبو إلى لعب % فقلت : من قر عينا بالهوى لعبا % % 6(@)(@@) % لا تعجل القدر المكتوب موقته % فاستأن لا يسبق العجلان ما طلبا % % 7(@)(@@) % قد ضارع الحب قلبي ثم أدركه % % وهن المحب فأمسى القلب قد غلبا % % 8(@)(@@) % كيف السبيل إلى لهو وقد تركت % سعدى على كبدي من حبها ندبا % % 9(@)(@@) % غزالة غصبت ليثا بمقلتها % % لم أر كاليوم مغصوبا ومغتصبا % % 10(@)(@@) % يا نظرة عقلت سلمى بمقلته % فما يزال قذى في عينه نشبا % % 11(@)(@@) % تدنو مع الذكر تشبيها إذا نزحت % % حتى أرى شخصها في العين م قتربا % % PageV01P230 12(@)(@@) % إن الغواني لا يغنين مسألة % ولا ترى مثل ما يسلبننا سلبا % % 13(@)(@@) % دعهن للمسهب الضليل مورده % يا قلب كل امرئ رهن بما اكتسبا % % 14(@)(@@) % قد حصحص الحق وانجابت دجنته % وعرض الدهر شطريه لمن حلبا % % 15(@)(@@) % وجاثم الهم قد سدت مطالعه % جليت عن وجهه التشبيه والريبا % % 16(@)(@@) % حتى غدا عب عباس ولا سبق % يتلو يدا قدحت عن وجهه الحجبا % % 17(@)(@@) % أولى لعاص وزلت عن أبي كرب % كأنما لم يكن ما كان إذ ذهبا % % 18(@)(@@) % وقد هممت بيحيى ثم أدركني % % حلمي فأمسكتها محمرة لهبا % % 19(@)(@@) % وخالد عند ذنب سوف يدركه % إذا خطبت له يوما كما خطبا % % 20(@)(@@) % قد أنضج العير كيا تحت فائله % وربما ناله حلمي وقد شعبا % % PageV01P231 البحر : مجزوء الكامل 1(@)(@@) % يا بان ضاق المذهب % وطريد أهلك أجنب % 2(@)(@@) % وذهبت في غير السبي % % ل لكل غاو مذهب % 3(@)(@@) % لا تخش قتلي حين شبت % وهل يخاف الأشيب % 4(@)(@@) % هيهات أفرخ روع با 
ms68	 % % نة لا يحول المغرب % 5(@)(@@) % ما زلت عنك وقد أرى % % أن القلوب تقلب % 6(@)(@@) % أيام أطعم كل ما % % ئلة الحمان وأشرب % 7(@)(@@) % ثم انقضى ذاك الزما % % ن وغاب دهر أنكب % 8(@)(@@) % يا بان طبك لا ينا % % م وقد ينام القطرب % 9(@)(@@) % عودي علي فإنها % % نفس تسيء وتعتب % 10(@)(@@) % ما كل زلة صاحب % أغدو لها أتوثب % PageV01P232 11(@)(@@) % حلمي أصم وراحتي % % للطالبين تحلب % 12(@)(@@) % ضعضعت جنة خالد % بعزيمة لا تقرب % 13(@)(@@) % وأطرت جنة عجرد % وأنا المغن المشغب % 14(@)(@@) % يخشى الأسود عرامتي % % ويبول مني التولب % 15(@)(@@) % ولقد وضعت على سهي % % ل ميسما لا يذهب % 16(@)(@@) % وإذا هربت من الصبا % % بة لم يكن لي مهرب % 17(@)(@@) % يا بان كدرب النعي % % م فلا ألذ وألعب % 18(@)(@@) % يا بان لي نفس علي % ك إذا ذكرت تصبب % 19(@)(@@) % والله رب محمد % إني ببانة معجب % 20(@)(@@) % ولقد أتاني أنها % % باتت علي تلهب % PageV01P233 21(@)(@@) % قالت : أتركب تاركا % أمري وما لك تركب % 22(@)(@@) % قول النساء علا بها % % ولكل فج عقرب % 23(@)(@@) % يا بان بعض اللاطف % ات من الحواسد أكذب % 24(@)(@@) % يغررن من أصغى له % ن كما يغر المذهب % 25(@)(@@) % في الناس عائلة علي % ك وبعض أهلك يثرب % 26(@)(@@) % إن كان حقا ما زعم % ن فلا صفا لي مشرب % 27(@)(@@) % أبرأت صدرك إنني % % قلق بسخطك متعب % 28(@)(@@) % يا بان إني بالرضى % % أبلى إليك وأنصب % 29(@)(@@) % وأتوب مما تعلمين % % كما يتوب المذنب % 30(@)(@@) % أنت الأميرة في الهوى % % وأنا المسيء المذنب % PageV01P234 31(@)(@@) % يكفيك أني لا أعو % % د ، وهل وراءك مطلب % PageV01P235 البحر : طويل 1(@)(@@) % يولون : في أنثى من أنثى خليفة % وقد كذبوا ، بعض الأوانس نيرب % 2(@)(@@) % وقد كان لي فيهن داعي قرابة % ولكن ذوات الود أدنى وأقرب % PageV01P236 البحر : سريع 1(@)(@@) % يا ليت لي قلبا بقلب يثيب % أو ليت لي حبا بحبي ينيب % 2(@)(@@) % ملك قلبي لا يمل الهوى % % ياطول إغرامي بمن لا يجيب % 3(@)(@@) % قلبي وهمي أذهبا راحتي % % فالنفس حرى ولعيني غروب % 4(@)(@@) % لم تر مثلي بين مثليهما % % هذا به داء وهذا كذوب % 5 
ms69	(@)(@@) % قد كلفاني عملا خائبا % وعامل الله الذي لا يخيب % 6(@)(@@) % لله دري ليس لي منزع % عن حب سلمى وهواها مريب % 7(@)(@@) % لقد أرى سلمى لنا جارة % يا بن سهيل بين حاب ولوب % 8(@)(@@) % كالبدر في العين إذا عطلت % وفي المحلى كالمحل القشيب % 9(@)(@@) % أراجع أنت لنا مجلسا % % بين مدام وسماع منيب % % 10(@)(@@) % يا حبذا ذاك على نأيه % % وحبذا ليلتنا بالكثيب % % PageV01P237 البحر : كامل تام 1(@)(@@) % وكأن نكهتها إذا نبهتها % % طفل يلوك بدردريه سخابا % % PageV01P238 البحر : رمل تام 1(@)(@@) % قمر الليل إذا ما انتقبت % % وهي كالشمس إذا لم تنتقب % 2(@)(@@) % ربما بت لها م ستبشرا % في نعيم وتصاب ولعب % PageV01P239 البحر : طويل 1(@)(@@) % ذكرت شبابي اللذ غير قريب % ومجلس لهو طاب بين شروب % % 2(@)(@@) % وبالحرة البضاء أذكرني الصبا % % خيال وتغريد الحمام نكوب % 3(@)(@@) % فأرسلت دمعي واستترت من الفتى % % مخافة نمام علي كذوب % 4(@)(@@) % وقد يذكر المشتاق بعض زمانه % % فيبكي ولا يبكي لموت حبيب % % 5(@)(@@) % وكنت إذا راحت علي صبابة % بكيت بها عيني برد نحيب % 6(@)(@@) % فلله در الرائحات عشية % يزفن لقد فجعنني بطليب % % 7(@)(@@) % أخي مريحنا هل فجعت بغادة % كعاب وهل ناهزت مثل نصيبي % % 8(@)(@@) % ليالي أسراب النساء يزدنني % % جنى بين ريحان أغر وكوب % % 9(@)(@@) % إذا شئت غنتني فتاة بمزهر % % على الراح أو غنيتها بقضيب % % 10(@)(@@) % فما دعاني الهاشمي أجبته % ولا خير في المملوك غير مجيب % % PageV01P240 11(@)(@@) % فأصبحت خدنا للجواري من الجوى % % فأصبح واديهن غير عشيب % 12(@)(@@) % حسرت الهوى عني زمانا وربما % % لهوت وما لهو الفتى بغريب % % 13(@)(@@) % فيا لك أياما سلبت نعيمها % % ويا لك دهرا فاتني بلغيب % 14(@)(@@) % على زينب مني السلام ومثله % على شجن بين الصبا وجنوب % % 15(@)(@@) % فهذا أوان لا أعوج على الصبى % % سمعت لعذالي ونام رقيبي % % 16(@)(@@) % وقد جاءني من باهلي يسبني % % فأعرضت إن الباهلي جنيبي % % 17(@)(@@) % وقلت بدعوى عامر : يال عامر % أيشتمني الزنجي غير دبيب % % 18(@)(@@) % دعوني وإني من ورائي معضد % كفيتكم راي استه بذنوب % % 19(@)(@@) % إذا شبع الزنجي سب إلهه % وألب من زنج علي ونوب % % 20(@)(@@) % أوائل قد 
ms70	 قربت غير مقرب % وناسبت كلبا كان غير نسيب % % PageV01P241 21(@)(@@) % بني وائل إن الصغير بمثله % % كبير فلا تستعجلوا بمهيب % % 22(@)(@@) % على أهلها تجني براقش فاتق وا % % جناية عبد واسعدوا بقلوب % 23(@)(@@) % صغير الأذى يدعو كبيرا لأهله % % وتفتضح القربى بذنب غريب % 24(@)(@@) % أرى خلقا قد شاب قبل جناية % % فهلا وهبتم قلبه لمشيب % % 25(@)(@@) % لحا الله قوما وسطوا الكلب فيهم % شتيم المحيا عاش غير أديب % % 26(@)(@@) % سروقا لما لاقى طروبا إلى الزبى % % وهل تجد الزنجي غير طروب % % 27(@)(@@) % إذا حز فيه النصل حز عجانه % فراح بأير للفضوح مثيبش % % 28(@)(@@) % فيا عجبا لا يتقي الزنج شره % ولا يذكرون الله عند هبوب % % 29(@)(@@) % أقول وقد ناك الخليق بناته % % وأحفى بنوه أمهم بركوب % % 30(@)(@@) % بني خلق ما أحلم الله عنكم % على خبثات فيكم وذنوب % PageV01P242 31(@)(@@) % أراكم أناسا سمنكم في أديمكم % % مجنتم فلا تستغفرون لحوب % % 32(@)(@@) % كأنكم لم تسمعوا بقيامة % ولم تشعروا في دينكم بحسيب % % 33(@)(@@) % أفيقوا بني الزنجي إن سبيلكم % سبيل أبيكم لحمه لكلوب % % 34(@)(@@) % ومولى أبيكم فاطرحوه لأكلب % ولا يدفن الزنجي بين ربوب % % 35(@)(@@) % ونبئت فزرا قلطبان نسائه % % ضروبا على أستاههن بطيب % 36(@)(@@) % وقد ناك فزر كلثما غير مرة % ولكنه قد قاءها بشبيب % % 37(@)(@@) % لحا الله فزرا ما أظل مكانه % وأعجبه قد فاق كل عجيب % % 38(@)(@@) % إذا قلت : من فزر ؟ أجابك قائل : % شريك أبيه في است أم حبيب % % 39(@)(@@) % ألا أيها الفادي ولم أقض نسختي % % يعاتبني في الجود غير مصيب % % 40(@)(@@) % قعيدك أن تنهى امرأ عن طباعه % % يجود ويغدو ناصبا بعتيب % % PageV01P243 41(@)(@@) % بدأت بنوك وانثنيت بجهلة % وما طاعتي إلا لكل لبيب % % 42(@)(@@) % سأرعى الذي يرعى من الذنب غاديا % وأكرم نفسي عن دسيس مريب % % 43(@)(@@) % لفزر صنيع القلطبان بأخته % % فليس بمأمون بظهر مغيب % % 44(@)(@@) % كسوب بأختيه وقينة تاجر % وما كان في كتابه بكسوب % % 45(@)(@@) % إذا هو لاقى أمه دبر استها % % تولى بأير للواط خضيب % PageV01P244 البحر : طويل 1(@)(@@) % لقد ودعت حبى وهام رقيبي % % وأصبح وادي اللهو غير عشيب % % 2(@)(@@) % تركت لوجه الله فزرا فقل له : % عتقت ولكن 
ms71	 كيف أم حبيب ؟ % 3(@)(@@) % وجن فريخ الزنج بل جنت استه % فأصبحت دلاقا له بطبيب % % 4(@)(@@) % شتمت فريخ الزنج عرضي خسارة % فإن كنت كعبيا وكنت حبيبي % % 5(@)(@@) % لقد وقع الكعبي نارا بميسم % على است أبيك العبد بعد شبيب % % 6(@)(@@) % رأى ابن خليق طعنتي في است أمه % % فراح يغطيها وذم قضيبي % % 7(@)(@@) % فقلت له : قد فارقت وحمدتها % % فلا تشتمني باست أمك حوبي % % 8(@)(@@) % رويد ابن زنجي العشيرة إنما % % دعاك إلى شتمي خيانة حيب % % 9(@)(@@) % فخرت برأس من أبيك مفلفل % علينا وبرصاء العجان لعوب % % 10(@)(@@) % فيا عجبا من باهلي يسبني % % مطية كندير قرى وأريب % PageV01P245 11(@)(@@) % لقد مات كندير فأبكاك موته % فجعت بأير كالشواظ صليب % % 12(@)(@@) % تسرقت شعري فاكتسبت به الغنى % % وما كان لقاط النوى بكسوب % 13(@)(@@) % ألا قل لعزاب البصيرة : أقبلوا % % بحاجتكم من نازح وقريب % % 14(@)(@@) % بنات خليق ملجمات معدة % إذا القوم راحوا سرجت لركوب % % 15(@)(@@) % لعمري لقد أعطيت عرسا مريبة % وقد يقطع الهم الفتى بمريب % % 16(@)(@@) % فأما فريخ الزنج حين عرفتها % % صديقا لزنح القريتين ونوب % % 17(@)(@@) % أخذت لإخوان الصفاء من استها % % نصيبا فخذ لي في استها بنصيب % % 18(@)(@@) % سأعطيك ما يعطى الفتى من تلاده % % بعضد وإن كانت فضوح ذنوبي % % 19(@)(@@) % بني خلق يخزيكم اليوم والد % دعي أحم اللون غير نجيب % % 20(@)(@@) % مواريثه معروفة في وجوهكم % % مناخره والرأس غير كذوب % % PageV01P246 21(@)(@@) % تعز لها يا بن الخيلق فإنها % % مواريث زنجي جرت بعيوب % % 22(@)(@@) % لحا الله أبناء الخليق فإنهم % % خنازير حش سخرت لسروب % % PageV01P247 البحر : سريع 1(@)(@@) % يا ويح حماد أمن نظرة % راح أسيرا غير مجنوب % % 2(@)(@@) % لله ما ران على قلبه % % من ساحر المقلة مشبوب % % 3(@)(@@) % كأنه هاروت يوم اغتدا % % يدير عينيه بتقليب % % 4(@)(@@) % أغن أحوى لان في رقة % % يختال في الخز وفي الطيب % % 5(@)(@@) % بدا لحماد فأبدى له % شغلا عن الدرياق والكوب % % 6(@)(@@) % قاد النباطي إلى حتفه % % نظرة عين شطر محبوب % % 7(@)(@@) % لما رأى ما عنده معجبا % حن إليه غير تعييب % % 8(@)(@@) % يهذى بخشف مؤنق مشرق % مقابل الجدين منسوب % % 9(@)(@@) % يختلس القلب بإبرامه % % منه 
ms72	 وإطماع وتجنيب % % 10(@)(@@) % مبتل الخلق هضيم الحشا % % ذو شعر كالكرم غربيب % % PageV01P248 11(@)(@@) % أمرد كالمأثور حين استوى % % لم تره عين على حوب % % 12(@)(@@) % يمشي إذا راح برماغة % لجت بإصعاد وتصويب % % 13(@)(@@) % وخصية في حسن ياقوتة % سيقت إلى أصيد محجوب % % 14(@)(@@) % يقول حماد إذا ما نأى : % يا رب فرج كرب مكروب % % 15(@)(@@) % حملتني الشوق وباعدتني % % ما هكذا الرب لمربوب % % 16(@)(@@) % رضيت ميعادك يا سيدي % % إن لم يكن ميعاد عرقوب % % PageV01P249 البحر : كامل تام 1(@)(@@) % ما بال عينك دمعها مسكوب % حربت وأنت بدمعها محروب % 2(@)(@@) % وكذاك من صحب الحوادث لم تزل % % تأتي عليه سلامة ونكوب % % 3(@)(@@) % إن الرزية لا رزية مثلها % % يوم ابن حفص في الدماء خضيب % % 4(@)(@@) % لا يستجيب ولا يحير لسانه % ولقد يحير لسانه ويجيب % % 5(@)(@@) % غلب العزاء على ابن حفص والأسى % % إن العزاء بمثله مغلوب % % 6(@)(@@) % يا أرض ويحك أكرميه فإنه % % لم يبق للعتكي فيك ضريب % 7(@)(@@) % أبهى على خشب المنابر قائما % يوما وأحرب إذ تشب حروب % % 8(@)(@@) % إذ قيل أصبح في المقابر ثاويا % عمر وشق لواؤه المنصوب % % 9(@)(@@) % وبكيت إذ بكت العتيك لبدرها % % أودى فبدر سمائها مسلوب % % 10(@)(@@) % يا ويح فاطمة التي فجعت به % % وتشققت منها عليه جيوب % PageV01P250 11(@)(@@) % إني لأعلم إذ تضمنه الثرى % % أن سوف تكمد بعده وتذوب % 12(@)(@@) % وظللت أندب سيف آل محمد % عمرا وجل هنالك المندوب % 13(@)(@@) % فعليك يا عمر السلام فإننا % % باكوك ما هبت صبا وجنوب % PageV01P251 البحر : بسيط تام 1(@)(@@) % لا تحمدن أبا حرب بأسرته % % قد يثبت الليث والخنزير في الغاب % % 2(@)(@@) % محمد تائه من فرط جنته % مفتاح غي لقوم أهل أحساب % % 3(@)(@@) % قد كان سبني من جنبه أسدا % على المهلب صفايا بأنياب % % 4(@)(@@) % أف له واليا ما كان أحمقه % يوم استخف بإخواني وأصحابي % % 5(@)(@@) % لا نبوتي رشده إلا تخونه % % غمدا لأير غوي باست منجاب % % 6(@)(@@) % يحب أزواج منجاب ويكرمهم % % ولا يجازوهم بابا إلى باب % % 7(@)(@@) % كأنه ضمن من داء صاحبه % % ومشته بعض ما يأتي من العاب % % 8(@)(@@) % قل للضغيط أبي حرب مجاهرة % قول امرئ مغرب 
ms73	 بالذم أغراب : % 9(@)(@@) % إن كنت جانبت مهديا فإن لنا % . . . . . فما بالنا نخفى على الناب % 10(@)(@@) % يسعى بنا زوج منجاب فنعتبه % ولا يهم لنا يوما بإعتاب % PageV01P252 11(@)(@@) % قال الخبير بمنجابس وسوءته % لما رأى دأبي سرا وإدآبي : % 12(@)(@@) % إذا طلبت إلى المنجاب نافلة % فاطلب بأيرك لا تطلب بكراب % % 13(@)(@@) % وقائل في الغواني جل حاجته % % يلقى . . . . من شوق وأتعاب : % 14(@)(@@) % يا ليت جردان منجاب وخصيته % كانا حرا فاشتفينا من حر راب % % 15(@)(@@) % فخم غليظ يطيف المنعظون به % % إذا تجمر من حاد ومنتاب % % 16(@)(@@) % نعم الشفيع است منجاب إذا غسلت % لمنعظ غير معتل ولا آب % % PageV01P253 البحر : كامل تام 1(@)(@@) % كثر الحمير وقد أرى في صحبتي % % منهن أقمر منعجا بالراكب % % 2(@)(@@) % يعدو فيضرط من نشاط عارم % % سبعين أو مائة حساب الحاسب % % 3(@)(@@) % وإذا تمرغ عد ألفا كاملا % يدع المراغة مثل أمس الذاهب % 4(@)(@@) % أشر ببطنته يرامح من دنا % % ضخم المقد شديد شغب الشاغب % 5(@)(@@) % يلقاك إن لقي اللجام بسحرة % % يكفيك من حزم الأجير الحاطب % % 6(@)(@@) % إن قام يسرجه الغلام زجرته % % لزيادة منه وحق واجب % % 7(@)(@@) % خليت مركبه ورحت لحاجتي % % مشيا يكلفني لغوب اللاغب % % 8(@)(@@) % وأرى الصحابة شيعتين : فمنهما % % أنس وبعضهم غبورة حالب % % 9(@)(@@) % ولقد مشيت عن الحمار تكرما % والمشي أكرم من ركوب الصاحب % % PageV01P254 البحر : وافر تام 1(@)(@@) % أخي أنت النصيح فلا تلمني % % فما دوني من النصحاء ناب % 2(@)(@@) % ولكن غبت في بلد بعيد % % وبعد الجهد ما كان الإياب % 3(@)(@@) % فلما جئت روعني غريم % يحاول ما كرهت ولا يهاب % 4(@)(@@) % أخاف غدوه يمشي بصك % % كحر النار ليس له انقلاب % % 5(@)(@@) % فرغت وأنت من همي وبالي % % وما كل الرواغ له عقاب % % 6(@)(@@) % فلا تعجل بلوم أخ تمطى % % عليه الخوف والزمن العجاب % % 7(@)(@@) % وكنت تزورني دهرا طويلا % ولا ستر علي ولا حجاب % 8(@)(@@) % فهذي خبئتي ودخيل أمري % % كما أحببت ليس له معاب % % 9(@)(@@) % سوى شوق أظل أظل منه % على طرب وأضعفه الكتاب % % PageV01P255 البحر : طويل 1(@)(@@) % أبا مالك طال النهار ، وطولهأبا مالك طال النهار ، وطوله % إذا ما الهوى بالنفس 
ms74	 داء يصيبها % % 2(@)(@@) % أرى حاجتي عند الأمير مريضة % فهلا تداويها وأنت طبيبها % % PageV01P256 البحر : رجز تام 1(@)(@@) % هل من رسول مخبر % عني جميع العرب % 2(@)(@@) % من كان حيا منهم % ومن ثوى في الترب % 3(@)(@@) % جدي الذي أسموا به % كسرى ، وساسان أبي % % 4(@)(@@) % وقيصر خالي إذا % % عددت يوما نسبي % % 5(@)(@@) % كم لي وكم لي من أب % بتاجه معتصب % 6(@)(@@) % أشوس في مجلسه % يجثى له بالركب % % 7(@)(@@) % يغدو إلى مجلسه % % يجثى له بالركب % % 8(@)(@@) % يغدو إلى مجلسه % % في الجوهر الملتهب % 9(@)(@@) % مستفضل في فنك % % وقائم في الحجب % 10(@)(@@) % يسعى الهبانيق له % بآنيات الذهب % PageV01P257 11(@)(@@) % لم يسق أقطاب سقى % % يشربها في العلب % 12(@)(@@) % ولا حدا قط أبي % % خلف بعير جرب % % 13(@)(@@) % ولا أتى حنظلة % يثقبها من سغب % % 14(@)(@@) % ولا أتى عرفطة % يخبطهابالخشب % 15(@)(@@) % ولا شوينا ورلا % منضنضا بالذنب % 16(@)(@@) % ولا تقصعت ولا % أكلت ضب الحزب % % 17(@)(@@) % ولا اصطلى قط أبي % % مفحجا للهب % 18(@)(@@) % ولم بايد نسيا % % ولا هوى للنصب % % 19(@)(@@) % كلا ولا كان أبي % % يركب شرجي قتب % 20(@)(@@) % إنا ملوك لم نزل % في سالفات الحقب % % PageV01P258 21(@)(@@) % نحن جلبنا الخيل من % % بلخ بغير الكذب % % 22(@)(@@) % حتى سقيناها وما % % نبده نهري حلب % 23(@)(@@) % حتى إذا ما دوخت % بالشام أرض الصلب % % 24(@)(@@) % سرنا إلى مصر بها % % في جحفل ذي لجب % % 25(@)(@@) % حتى استلبنا ملكها % % بملكنا المستلب % 26(@)(@@) % وجادت الخيل بنا % % طنجة ذات العجب % 27(@)(@@) % حتى رددنا الملك في % % أهل النبي العربي % % 28(@)(@@) % يهز أبا الفضل بها % % أولى قريش بالنبي % % 29(@)(@@) % من ذا الذي عادى الهدى % % والدين لم يستلب % % 30(@)(@@) % ومن ومن عانده % % أو جار لم ينتهب % PageV01P259 31(@)(@@) % نغضب لله ولل % إسلام أسرى الغضب % 32(@)(@@) % أنا ابن فرعي فارس % عنها المحامي العصب % 33(@)(@@) % نحن ذوو التيجان وال % ملك الأشم الأغلب % PageV01P260 البحر : خفيف تام 1(@)(@@) % أرسلت خلتي من الدمع غربا % % ثم قالت : صبوت بل كنت صبا % % 2(@)(@@) % قلت : كلا لا بل صفا لك حتى % % زادك الله يا عبيدة حبا % % 3(@)(@@) % ما تعرضت للكوانس في الستر % % ولا العارضات سربا فسربا 
ms75	 % % 4(@)(@@) % أنت كدرت شربهن فأصبح % ن غضابا علي يذممن شربا % % 5(@)(@@) % وتلافيتني بذلك عنهن % % وأنس يصب للحب صبا % % 6(@)(@@) % فلهن الطلاق مني ، ومني % % لك طول الصفاء والود عذبا % % 7(@)(@@) % فاطمئني ملكت نفسي وقلبي % % وهمومي فما يجاوزن وصبا % % 8(@)(@@) % لا تخافي على مكانك عندي % % عوض ما هلل الحجيج ولبى % % 9(@)(@@) % إن قلبي ملآن من حبك المح % ض فحسبي من حبي ثنتين حسبا % % 10(@)(@@) % ضقت عن كربة العتاب فحسبي % % لا تزيدي حبيب نفسك كربا % % PageV01P261 11(@)(@@) % ويح نفسي ، أكلما دب واش % بحديث وثبت للهجر وثبا % % 12(@)(@@) % ما كذا يصنع المحب فقري % % أين منا من لا يقارف ذنبا % % 13(@)(@@) % لم يكن لي رب سوى الله يا عبد % % فما لي اتخذت وجهك ربا % % 14(@)(@@) % إنني واهب لوجهك نفسي % % فاقبلي ما وهبت نفسا وقلبا % % 15(@)(@@) % ولقد قلت للذي لامني في % % ك جهارا وما تقنعت خبا % % 16(@)(@@) % رحت صلبا ولو شربت من الحب % بكأسي لما تروحت صلبا % % 17(@)(@@) % فاترك اللوم في عبيدة إني % % تارك من يلوم في تلك جنبا % % 18(@)(@@) % حدثتني العيون عنها فحالف % ت المصلى أدعو إلهي مكبا % % 19(@)(@@) % كدعاء المكروب في لجة البح % ر ينادي الرحمن رغبا ورهبا % % 20(@)(@@) % فاستجاب الدعاء واستوجب الشك % ر إله قريب ازداد قربا % % PageV01P262 21(@)(@@) % كان ما كان بي من الوصف عنها % % ثم عاينت ذاك فازددت عجبا % % 22(@)(@@) % هي رود الشباب فاترة الطر % % ف تدرى مثل العريش اسلحبا % % 23(@)(@@) % عقب المنكبين عن مسبح القر % ب برود اللثات يبرقن شنبا % % 24(@)(@@) % يشبع الحجل والدماليج والسو % % ر بجم يلبسن بالعين طبا % % 25(@)(@@) % وثقال الأرداف مهضومة الكش % % ح كغصن الريحان يهتز رطبا % % 26(@)(@@) % إن أمتع بها فيا نعمة الل % % ه ! وإن ينحرم فويلي محبا ! % PageV01P263 البحر : كامل تام 1(@)(@@) % أعددت لي عتبا بحبكم % % يا عبد طال بحبكم عتبي % % 2(@)(@@) % ولقد تعرض لي خيالكم % % في القرط والخلخال والقلب % % 3(@)(@@) % فشربت غير مباشر حرجا % % برضاب أشنب بارد عذب % % PageV01P264 البحر : طويل 1(@)(@@) % رويدا تصاهل بالعراق جيادنا % % كأنك بالضحاك قد قام نادبه % % PageV01P265 البحر : طويل 1(@)(@@) % وللموت خير من حياة 
ms76	 على أذى % % يضيمك فيه صاحب وتراقبه % % 2(@)(@@) % كأن حياة الناس حين ضمنتها % % قذى في حقوق العين مني أواربه % 3(@)(@@) % يخونك ذو القربى مرارا وربما % % وفى لك عند الجهل من لا تقاربه % % 4(@)(@@) % وقد رابني قلب يكلفني الصبا % % وما كل حين يتبع القلب صاحبه % % 5(@)(@@) % وما قادني في الدهر إلا غلبته % % وكيف يلام المرء والحب غالبه % % 6(@)(@@) % وأحور محسود على حسن وجهه % % يزين السموط نحره وترائبه % PageV01P266 البحر : طويل 1(@)(@@) % أخوك الذي لا ينقض الدهر عهده % ولا عند صرف الدهر يزور جانبه % % 2(@)(@@) % فخذ من أخيك العفو واغفر ذنوبه % % ولا تك في كل الأمور تجانبه % % PageV01P267 البحر : طويل 1(@)(@@) % يزهدني في حب عبدة معشر % قلوبهم فيها مخالفة قلبي % % 2(@)(@@) % فقلت دعوا قلبي بما اختار وارتضى % % فبالقلب لا بالعين يبصر ذو اللب % 3(@)(@@) % وما تبصر العينان في موضع الهوى % % ولا تسمع الأذنان إلا من القلب % % 4(@)(@@) % وما الحسن إلا كل حسن دعا الصبا % % وألف بين العشق والعاشق الصب % PageV01P268 البحر : طويل 1(@)(@@) % لعمري لقد غالبت نفسي على الهوى % % لتسلى فكانت شهوة النفس أغلبا % % PageV01P269 البحر : بسيط تام 1(@)(@@) % تكلفوا القول والأقوام قد حفلوا % % وحبروا خطبا ناهيك بالخطب % 2(@)(@@) % فقام مرتجلا تغلي بداهته % % كمرجل القين لما حف باللهب % 3(@)(@@) % وجانب الراء لم يشعر به أحد % قبل التصفح والإغراق في الطلب % PageV01P270 البحر : كامل تام 1(@)(@@) % وإذا عريت فلا تكن جشعا % تسمو لغث الكسب تكسبه % PageV01P271 البحر : بسيط تام 1(@)(@@) % قل للأمير جزاك الله صالحة % لا يجمع الدهر بين السخل والطيب % 2(@)(@@) % السخل غر وهم الذئب غفلته % والذئب يعلم ما في السخل من طيب % PageV01P272 البحر : طويل 1(@)(@@) % شفى النفس ما يلقى بعبدة مغرما % % وما كان يلقى قلبه وضرائبه % % 2(@)(@@) % فأقصر عن رامي الفؤاد وإنما % % يميل به أمسى اعتراض يطالبه % % PageV01P273 البحر : طويل 1(@)(@@) % لألقى بني عيلان إن فعالهم % % تزيد على كل الفعال مراتبه % % 2(@)(@@) % أولاك الألى شقوا العمى يسوفهم % % من العين حتى أبصر الحق طالبه % % PageV01P274 البحر : طويل 1(@)(@@) % فبتنا كأنا لو تراق زجاجة % % من الماء فيما بيننا لم تسرب % % PageV01P275 البحر : كامل 
ms77	 تام 1(@)(@@) % ورضيت من طول العناء بيأسه % واليأس أيسر من عدات الكاذب % PageV01P276 البحر : طويل 1(@)(@@) % أصيب بني حين أورق غصنه % وألقى علي الهم كل قريب % PageV01P277 البحر : طويل 1(@)(@@) % عدوي الذي آخا عدوي ومن يكن % % صديق صديقي فهو لي الدهر صاحبا % % PageV01P278 البحر : كامل تام 1(@)(@@) % إني مدحتك كاذبا فأثبتني % % لما مدحتك ما يثاب الكاذب % PageV01P279 البحر : كامل تام 1(@)(@@) % الصدق أفضل ما حضرت به % % ولربما ضر الفتى كذبه % PageV01P280 البحر : كامل تام 1(@)(@@) % زين الملابس حين يلبسها % % وإذا تسلب زانه سلبه % % PageV01P281 البحر : - 1(@)(@@) % يا عبد هل للقاء من سبب % % أو لا فأعود بالويل والحرب % PageV01P282 البحر : كامل تام 1(@)(@@) % والخيل شائلة تشق غبارها % % كعقارب قد رفعت أذنابها % % PageV01P283 البحر : مجتث 1(@)(@@) % ذات الثنايا العذاب % من دونهن عذابي % % PageV01P284 البحر : طويل 1(@)(@@) % وفي العبرات الغر صبر على الندى % % أولئك حي من حزيمة أغلب % PageV01P285 البحر : وافر تام 1(@)(@@) % إذا حسر الشباب فمت جميلا % فما اللذات إلا في الشباب % % PageV01P286 البحر : طويل 1(@)(@@) % تأخذه عند المكارم لذة % كما اهتز تحت البارح الغصن الرطب % PageV01P287 البحر : طويل 1(@)(@@) % و جد على مولاك في الفقر والغنى % % ولا تقرب الخلق الذي أنت عائبه % % PageV01P288 البحر : طويل 1(@)(@@) % ولا أشرب الماء الذي يحمل القذى % % أجل لا ولا أسقي به من نصاحبه % % PageV01P289 البحر : طويل 1(@)(@@) % تزل القوافي عن لساني كأنها % % حمات الأفاعي ريقهن تصبب % 2(@)(@@) % فكم من أخ قد كان يأمل نفعكم % % شجاع له ناب حديد ومخلب % % 3(@)(@@) % أخ لو شكرتم فضله وعضضتم % رؤوس الأفاعي عض لا يتهيب % PageV01P290 البحر : طويل 1(@)(@@) % فلا يسر بمال لا يجود به % % وليس يقنع إلا بالذي يهب % PageV01P291 البحر : طويل 1(@)(@@) % وما الناس إلا حافظ ومضيع % وما العيش إلا ما تطيب عواقبه % % PageV01P292 البحر : طويل 1(@)(@@) % وقد شذبتك الحادثات وإنما % % يفرع غصن الدوح حين يشذب % PageV01P293 البحر : طويل 1(@)(@@) % أحلت له أم المنايا بناتها % % بأسيافنا إنا ردى من نحاربه % % PageV01P294 البحر : كامل تام 1(@)(@@) % وقضيت من ورق الشباب حجا % من كل أحوز راجع قصبه % % PageV01P295 البحر : كامل تام 1(@)(@@) % يا عبد إني قد ظلمت وإنني % % مبد مقالة 
ms78	 راغب أو راهب % % 2(@)(@@) % وأتوب مما تكرهين لتقبلي % % والله يقبل حسن فعل التائب % % PageV01P296 البحر : منسرح 1(@)(@@) % يا عبد بالله فرجي كربي % % فقد براني وشفني نصبي % % 2(@)(@@) % وضقت ذرعا بما كلفت به % % من حبكم والمحب في تعب % 3(@)(@@) % ففرجي كربة شجيت بها % % وحر حزن في الصدر كاللهب % % 4(@)(@@) % ولا تظني ما أشتكي لعبا % هيهات قد جل ذا عن اللعب % PageV01P297 البحر : مجزوء الكامل 1(@)(@@) % يا عبد حي عن قريب % وتأملي عين الرقيب % % 2(@)(@@) % وارعي ودادي غائبا % فلقد رعيتك في المغيب % % 3(@)(@@) % أشكو إليك وإنما % % يشكو المحب إلى الحبيب % % 4(@)(@@) % غرضا إليك من الهوى % % غرض المريض إلى الطبيب % % PageV01P298 البحر : - 1(@)(@@) % يا عبد جلي كروبي % % وأسعفي وأثيبي % % 2(@)(@@) % فقد تطاول همي % % وزفرتي نحيبي % % PageV01P299 البحر : طويل 1(@)(@@) % تود عدوي ثم تزعم أنني % % صديقك ليس النوك عنك بعازب % % 2(@)(@@) % عدوي الذي آخى عدوي ومن يكن % % صديق صديقي فهو لي الدهر صاحبي % % 3(@)(@@) % وليس أخي من ودني رأي عينه % % ولكن أخي من ودني في المصائب % % 4(@)(@@) % ومن ماله مالي إذا كنت معدما % وما لي له إن عض دهر بغارب % % 5(@)(@@) % فلا تحمدن عند الرخاء مؤاخيا % فقد يذكر الأخوان عند النوائب % % 6(@)(@@) % فما أنت إلا كيف أنت ومرحبا % وبالبذل رواغ كروغ الثعالب % % PageV01P300 البحر : خفيف تام 1(@)(@@) % عبد إني اعترفت بذنبي % % فاغفري واعدلي خطائي بحبي % % 2(@)(@@) % عبد لا صبر لي ولست فمهلا % قائلا قد عتبت في غير عتب % 3(@)(@@) % ولقد قلت حين أنصبني الحب % % ب فأبلى جسمي وعذب قلبي % % 4(@)(@@) % رب لا صبر لي على الهجر حسبي % % قأقلني حسبي لك الحمد حسبي % % PageV01P301 البحر : - 1(@)(@@) % طرقتني صبا فحركت البا % % ب هدوا فارتعت منه ارتيابا % % 2(@)(@@) % فكأني سمعت حس حبيب % نقر الباب نقرة ثم غابا % % PageV01P302 البحر : طويل 1(@)(@@) % وما كل ذي رأي بمؤتيك نصحه % % ولا كل مؤت نصحه بلبيب % % 2(@)(@@) % ولكن إذا ما استجمعا عند واحد % % فحق له من طاعة بنصيب % PageV01P303 البحر : كامل تام 1(@)(@@) % لا تجعلن أحدا عليك إذا % % أحببته وهويته ربا % % 2(@)(@@) % وصل الخليل إذا شغفت به % % واطو الزيارة 
ms79	 دونه غبا % % 3(@)(@@) % فلذاك خير من مواصلة % % ليست تزيدك عنده قربا % % 4(@)(@@) % لكن يمل ثم تدعو باسمه % % فيقول هاه وطالما لبى % % PageV01P304 البحر : مخلع البسيط 1(@)(@@) % هم قعدوا فانتقوا لهم حسبا % % يدخل بعد العشاء في العرب % % 2(@)(@@) % حتى إذا ما الصباح لاح لهم % % بين ستوقهم من الذهب % % PageV01P305 البحر : خفيف تام 1(@)(@@) % قل ' لحباء ' : إن تعيشي فموتي % % سوف نرضى لك الذي قد رضيت % 2(@)(@@) % قد قبلنا ما كان منك إلينا % % وبرينا من عيبه إن بريت % 3(@)(@@) % حدثيني فقد وقعت بشك : % أتعمدت سخطنا أم غبيت % 4(@)(@@) % يوم تعصين عزمتي في أمور % لو تمنيت مثلها ما عصيت % 5(@)(@@) % هل تنقمت غير قولي إذا % % كان عثار وروعة لا شقيت % 6(@)(@@) % إن تكوني غنيت عنا فإنا % % عنك أغنى ، فيممي حيث شيت % 7(@)(@@) % من يرجيك بعد بيع محب % % كان يهوى بجهده ما هويت % 8(@)(@@) % لم تكوني لتصلحي لوداد % لكريم كحلة العنكبوت % 9(@)(@@) % قد شبعنا من ودك المر طعما % وروينا إن كنت منا رويت % 10(@)(@@) % ليس بيني وبين من كان وخما % لا يفي للخليل غير السكوت % PageV01P306 11(@)(@@) % ما عتابي أصم لا يسمع الصو % % ت وشوقي إلى البغيض المقيت % 12(@)(@@) % يابنة العامري قد كان عهد % بيننا في الهوى ، ولكن نسيت % 13(@)(@@) % فاذكري ودنا وذوقي سوانا % % تذكرينا وتندمي ما بقيت % % 14(@)(@@) % أو أفيقي من داء ما يصنع الحب % بص فطالما قد دويت % % 15(@)(@@) % لن تنالي بود هذا وهذا % % سهمة في ودادنا ما حييت % % 16(@)(@@) % كيف صبري وأنت عندي كنفسي % % بمكان المباعد الممقوت % 17(@)(@@) % % فصليني بالصبر عمن لقيت % 18(@)(@@) % أنت ياقوتة قدرت عليها % % لا أحب الشريك في الياقوت % PageV01P307 البحر : وافر تام 1(@)(@@) % أعاذل قد نهيت فما انتهيت % وقد طال العتاب فما انثنيت % 2(@)(@@) % أعاذل ما ملكت فأقسريني % % وما اللذات إلا ما اشتهيت % 3(@)(@@) % أطيعك ما عطفت علي برا % وإن حاولت معصيتي عصيت % 4(@)(@@) % أعاذل قد كبرت وفي ملهى % ولو أجريت غايتك ارعويت % 5(@)(@@) % لقد نظر الوشاة إلي شزرا % ومن نظري إليها ما اشتفيت % 6(@)(@@) % وقالوا : قد تعرض كي يراها % % وماذا ضرهم 
ms80	 مما رأيت % % 7(@)(@@) % وما كلفتها إلا جميلا % ولا عاهدتها إلا وفيت % 8(@)(@@) % ويوم ذكرتها في الشرب إني % % إذا عرض الحديث بها اعتديت % % 9(@)(@@) % شربت زجاجة وبكيت أخرى % % فراحوا منتشين وما انتشيت % 10(@)(@@) % وما يخفى على الندماء أني % % أجيد بها الغناء وإن كنيت % PageV01P308 11(@)(@@) % وأتبعت المنى بنجاد ' ليت ' % وما يغني عن الطربات ' ليت ' % 12(@)(@@) % وجارية يسور بنا هواها % % كما سارت مشعشعة كميت % 13(@)(@@) % يزين وجهها خلقا عميما % وزين وجهها حسب وبيت % 14(@)(@@) % إذا قربت شفيت بها سقاما % % على كبدي وإن شحطت بكيت % 15(@)(@@) % نسجت لها القريض بماء ودي % % لتلبسه وتشرب ما سقيت % % 16(@)(@@) % ودست في الكتاب إلي : إني % - وقيتك - لو أرى خللا مضيت % 17(@)(@@) % على ما قد علمت جنون أمي % % وأعين إخوتي منذ ارتديت % 18(@)(@@) % يقولون : انعمي ، ويرون عارا % خروجي إن ركبت وإن مشيت % 19(@)(@@) % ومن طربي إليك خشعت فيهم % كما يتخشع الفرس السكيت % 20(@)(@@) % وقد قامت وليدتها تغني % % عشية جاءها أني اشتكيت % PageV01P309 21(@)(@@) % تقول ودفها زجل النواحي % % إذا أمي أبت صلتي أبيت % 22(@)(@@) % دعاني من هويت فلم أجبه % ولو أسطيع حين دعا سعيت % 23(@)(@@) % ألا يا أمتا لا كنت أما % أأمنع ما أحب وقد غليت % 24(@)(@@) % أمن حجر فؤادك أم حديد % وما يدري العشير بما دريت % 25(@)(@@) % وما ترثين لي مما ألاقي % % وإنك لو عشقت إذا رثيت % PageV01P310 البحر : طويل 1(@)(@@) % تخليت من صفراء ، لا بل تخلت % وكنا حليفي خلة فاضمحلت % 2(@)(@@) % تغيب أعداء الهوى عن حبيبها % % وكان لها رأي النساء فضلت % % 3(@)(@@) % رأتني ترفعت الشباب فأعرضت % بشق فما أدري : طغت أم أدلت % 4(@)(@@) % وما سمتها هونا فتأبى قبوله % ولكنما طال الصفاء فملت % 5(@)(@@) % فيا عجبا زينت نفسي بحبها % % وزانت بهجري نفسها وتحلت % 6(@)(@@) % لوت حاجتي عند اللقاء وأنكرت % مواعيد قد صامت بهن وصلت % % 7(@)(@@) % ولولا أمير المؤمنين سقيتها % % أواما يناجينا لها حيث حلت % 8(@)(@@) % وما واهن البزلاء مثل مشيع % إذا قام بالجلى علت وتجلت % % 9(@)(@@) % قعيدك أخرى لا تبيع مودتي % % بود ولا تخشى إذا ما تولت % % 10(@)(@@) % فبيني كما بان 