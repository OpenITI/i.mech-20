ms2221	 بن أبي خيثمة فيما كتب إلي قال سمعت يحيى بن معين يقول محمد بن ثابت اخو على بن ثابت ثقة مأمون، نا عبد الرحمن قال سمعت ابى يقول محمد بن PageV07P216(@)(@@) ثابت المروزى ليس به بأس.(@)(@@)(@@)(@@) $ 1203 -(@)(@@) محمد بن ثابت بن اسلم البنانى روى عن أبيه وجعفر بن محمد وعبيد الله بن عبد الله (1) بن الحارث بن نوفل، روى عنه أبو عبيدة الحداد وابو داود وعبد الصمد بن عبد الوراث وحلبس الضبعى وبشار بن محمد البناني سمعت أبي يقول ذلك، نا عبد الرحمن قال قرئ على العباس بن محمد الدوري عن يحيى بن معين (أنه قال محمد بن ثابت ليس بشئ، نا عبد الرحمن أنا ابن أبي خيثمة فيما كتب إلي قال سمعت يحيى بن معين - 2) يقول محمد بن ثابت ليس بقوى، كان عفان يقول (محمد بن ثابت البنانى رجل ضعيف الحديث، نا عبد الرحمن قال سمعت ابى يقول - 2) محمد بن ثابت البنانى يكتب حديثه ولا يحتج به منكر الحديث، حدثنا عبد الرحمن قال سئل أبو زرعة عن محمد بن ثابت البنانى فقال لين.(@)(@@)(@@)(@@) $ 1204 -(@)(@@) محمد بن ثابت بن ثوبان روى عن.. (3) روى عنه.. (3) نا عبد الرحمن قال سئل أبي عنه فقال لا يسوى شيئا.(@)(@@)(@@)(@@) $ 1205 -(@)(@@) محمد بن ثابت العصرى روى عن.. (3) روى عنه عبيد الله ابن عمر القواريرى وعمرو بن علي، نا عبد الرحمن قال سمعت أبا زرعة وسئل عن محمد بن ثابت العصرى فقال ليس بقوي، حدثنا عبد الرحمن قال سألت ابى عن محمد بن ثابت العصرى فقال هو بصرى يكتب حديثه وليس بقوى.(@)(@@)(@@)(@@) $ 1206 -(@)(@@) (محمد بن ثابت روى عن أنس روى عنه أبو رجاء روح بن المسيب الكليبي سمعت ابى يقول ذلك - 4) .(@)(@@)(@@)(@@) $ 1207 -(@)(@@) محمد بن ثابت بن مهران أبو ذر نزيل دمشق روى عن عبد الله ابن بكر السهمى وعبد الوهاب بن عطاء سمع منه أبي بدمشق في الرحلة الاولى، نا عبد الرحمن قال سئل ابى عنه فقال صدوق.(@)(@@)(@@)(@@) $ 1208 -(@)(@@) محمد بن ثور الصنعانى أبو عبد الله روى 
ms2222	 عن ابن جريج ومعمر PageV07P217(@)(@@) روى عنه فضيل بن عياض ونعيم بن حماد وإبراهيم بن موسى ومحمد بن عبيد بن حساب ومحمد بن عبد الاعلى الصنعانى وحماد بن زاذان سمعت أبى يقول ذلك، قال أبو محمد وروى عنه المؤمل بن اسمعيل وعبد الرزاق، نا عبد الرحمن نا الحسين بن الحسن قال قلت ليحيى بن معين محمد بن ثور؟ فقال ثقة، نا عبد الرحمن قال سمعت أبا زرعة يقول وسألته عن محمد بن ثور وهشام بن يوسف وعبد الرزاق فقال ابن ثور افضلهم، نا عبد الرحمن قال سألت ابى قلت ابن ثور ما حاله؟ قال الفضل والعبادة والصدق، قلت عبد الله بن معاذ احب اليك أو ابن ثور؟ قال ابن ثور احب إلى.(@)(@@)(@@)(@@) $ 1209 -(@)(@@) محمد بن ثعلبة أبو الاصبغ الازدي روى عن ضمرة كتب عنه ابى بدمشق وروى عنه.(@)(@@)(@@)(@@) $ 1210 -(@)(@@) محمد بن ثعلبة بن سواء السدوسى بصرى روى عن عمه محمد ابن سواء روى عنه أبو زرعة رحمه الله وعلى بن الحسين بن الجنيد سمعت أبي يقول أدركته ولم اكبت عنه.(@)(@@)(@@)(@@) $ 1211 -(@)(@@) محمد بن ثواب الهباري كوفى وهو ابن ثواب بن سعيد أبو عبد الله (1) روى عن مصعب بن المقدام وحيان بن سدير وابى اسامة واسباط(@)(@@) ابن محمد كتبت عنه مع أبي وهو صدوق.(@)(@@)(@@)(@@) ||||| باب من روى عنه العلم ممن يسمى محمد أو ابتداء اسم ابيه على الجيم(@)(@@)(@@)(@@) $ 1212 - محمد بن جبير بن مطعم بن عدي بن نوفل بن عبد مناف القرشى أبو سعيد روى عن أبيه ومعاوية روى عنه بنوه عمر وسعيد وجبير والزهرى وعمرو بن دينار وسعد بن ابراهيم توفى بالمدينة زمن عمر بن عبد العزيز سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 1213 -(@)(@@) محمد بن جبير بن حية الثقفي روى عن أنس بن سيرين وعثمان PageV07P218(@)(@@) الكاتب وابيه روى عنه موسى بن اسمعيل المنقرى، نا عبد الرحمن قال سمعت أبي يقول ذلك، وسمعته يقول هو مجهول.(@)(@@)(@@)(@@) $ 1214 -(@)(@@) محمد بن جابر بن عبد الله الانصاري السلمى وهو ابن عبد الله ابن عمرو بن حرام 
ms2223	 روى عن أبيه روى عنه ابن ابى ذرة السلمى ويحيى بن عبد الله ابن يزيد بن عبد الله بن انيس ومحمد بن كليب وعبد الرحمن بن عطاء سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1215 -(@)(@@) محمد بن جابر الحنفي اليمامى روى عن عمير (1) بن سعيد النخعي وعطية العوفى وابى اسحاق الهمداني وحماد بن ابى سليمان وسماك بن حرب ويحي ابن ابى كثير وقيس بن طلق روى عنه هشام بن حسان وسفيان الثوري وشعبة وزهير بن معاوية وجرير بن عبد الحميد وابن عيينة ووكيع واخوه أيوب بن جابر سمعت أبي يقول ذلك، نا عبد الرحمن حدثنى ابى نا عون بن جرير بن عبد الحميد قال سمعت ابى يقول كان المغيرة يعنى ابن مقسم الضبى ربما سأل محمد بن جابر(@)(@@) عن حديث حماد.(@)(@@) نا عبد الرحمن أنا عبد الله بن أحمد بن محمد بن حنبل فيما كتب إلي قال سمعت أبي يقول كان محمد بن جابر ربما الحق في كتابه أو يلحق في كتابه - يعني الحديث، نا عبد الرحمن قال قرئ على العباس بن محمد الدوري قال سمعت يحيى ابن معين يقول محمد بن جابر كان اعمى واختلط عليه حديثه وكان كوفيا فانتقل إلى اليمامة وهو ضعيف، نا عبد الرحمن نا محمد بن إبراهيم نا عمرو بن على بان محمد بن جابر الحنفي صدوق كثير الوهم.(@)(@@) نا عبد الرحمن قال سألت ابى عن محمد بن جابر فقال ذهب كتبه في آخر عمره وساء حفظه وكان يلقن وكان عبد الرحمن بن مهدي يحدث عنه ثم تركه بعد وكان يروى احاديث مناكير وهو معروف بالسماع جيد اللقاء رأوا في كتبه لحقا وحديثه عن حماد فيه اضطراب روى عنه عشرة من الثقات، نا عبد الرحمن قال وسئل ابى عن محمد بن جابر وابن لهيعة فقال محلهما الصدق ومحمد بن جابر PageV07P219(@)(@@) احب إلى من ابن لهيعة.(@)(@@) قال أبو محمد سمعت أبي وابا زرعة يقولان محمد بن جابر يمامى الاصل ومن كتب عنه كتب عنه باليمامة وبمكة وهو صدوق إلا 
ms2224	 أن في حديثه تخاليط واما اصوله فهى صحاح، وقال أبو زرعة محمد بن جابر ساقط الحديث عند أهل العلم، نا عبد الرحمن نا محمد بن يحيى قال سمعت أبا الوليد الطيالسي وذكر محمد بن جابر فقال نحن نظلم ابن جابر بامتناعنا التحديث عنه (1) .(@)(@@)(@@)(@@) $ 1216 -(@)(@@) محمد بن جابر بن جلاس بن عمرو الكلبى روى عن ابيه عن ابر عمر أنه رأى عمر رضى الله عنه يمسح على الجوربين روى عنه.. (2) سمعت(@)(@@) أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1217 -(@)(@@) محمد بن جابر بن بجير المحاربي أبو بجير كوفي روى عن عبد الرحمن ابن محمد المحاربي ووكيع بن الجراح وعبد الله بن نمير وعبد الرحيم بن عبد الرحمن المحاربي وابى اسامة وأسباط بن محمد كتبت عنه مع ابى بالكوفة وهو صدوق.(@)(@@)(@@)(@@) $ 1218 -(@)(@@) محمد بن جعفر بن محمد بن علي بن الحسين بن علي بن أبي طالب روى عن ابيه روى عنه عتيق بن يعقوب الزبيري وابراهيم بن المنذر الحزامى ويعقوب بن حميد بن كاسب وأحمد بن محمد بن الوليد بن برد الانطاكي ومحمد بن أبي عمر العدني سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 1219 -(@)(@@) محمد بن جعفر بن أبي كثير مولى بنى زريق اخو اسمعيل بن جعفر صاحب القراآت واخوه كثير بن جعفر واخوه عبد الله بن جعفر، روى عن زيد بن اسلم وحميد الطويل وابى حازم المدينى وسهيل بن ابى صالح والعلاء بن عبد الرحمن وموسى بن عقبة روى عنه معتمر بن سليمان وسعيد بن الحكم بن أبي مريم وعبد العزيز الاويسى سمعت أبي يقول ذلك، قال أبو محمد روى عن يحيى بن سعيد الانصاري وحميد الطويل روى عنه عبد الله بن نافع الصائغ،.(@)(@@) نا عبد الرحمن نا محمد بن أحمد بن البراء قال قال على بن المدينى محمد بن PageV07P220(@)(@@) جعفر بن ابى كثير معروف، نا عبد الرحمن قال قرئ على العباس بن محمد الدوري قال سمعت يحيى بن معين يقول محمد بن جعفر ثقة.(@)(@@)(@@)(@@) $ 1220 -(@)(@@) محمد بن جعفر المخزومى روى عن محمد بن علي ابن الحنفية 
ms2225	 روى عنه اسحاق بن الحارث والد عبد الرحمن بن إسحاق وروى عنه عبد الرحمن بن(@)(@@) اسحاق المعروف بعباد بن إسحاق سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1221 -(@)(@@) محمد بن جعفر بن الزبير بن العوام روى عن عروة بن الزبير روى عنه عبيد الله بن أبي جعفر ويحيى بن سعيد الأنصاري وابن جريج وعبد الرحمن بن الحارث المخزومى ومحمد بن إسحاق والوليد بن كثير سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 1222 -(@)(@@) محمد بن جعفر ليس بأخى اسمعيل بن جعفر ولا ابن جعفر بن محمد ابن على هو آخر غير هؤلاء الثلاثة (1) سمعت أبي يقول هو مجهول.(@)(@@)(@@)(@@) $ 1223 -(@)(@@) محمد بن جعفر غندر البصري أبو عبد الله روى عن شعبة وابن أبي عروبة وعبد الله بن سعيد بن ابى هند وابن جريج وعثمان بن غياث سمعت أبي يقول ذلك، قال أبو محمد روى عنه مسدد وأحمد بن حنبل ومحمد بن بشار ومحمد بن المثنى وخلف بن سالم والقواريري وأبو بكر وعثمان ابنا أبي شيبة وعمرو بن علي نا عبد الرحمن نا أحمد بن منصور بن راشد المروزي قال سمعت سلمة ابن سليمان يقول قال عبد الله يعني ابن المبارك إذا اختلف الناس في حديث شعبة فكتاب غندر حكما (1) فيما بينهم.(@)(@@) نا عبد الرحمن نا أبي نا محمد بن أبان البلخي الوكيعى قال قال ابن مهدى غندر في شعبة اثبت مني، نا عبد الرحمن أنا يعقوب بن إسحاق فيما كتب إلى قال نا عثمان ابن سعيد قال قلت ليحيى بن معين عبد الاعلى اثبت عندك في سعيد أو غندر؟ فقال كل ثقة، قلت فعبد الاعلى (2) أحب إليك أو محمد بن ابى عدى؟ فقال ثقتان.(@)(@@) نا عبد الرحمن قال سألت ابى عن محمد بن جعفر غندر فقال كان صدوقا PageV07P221(@)(@@) وكان مؤديا وفى حديث شعبة ثقة.(@)(@@)(@@)(@@) $ 1224 -(@)(@@) محمد بن جعفر المدائني روى عن شعبة وورقاء والبغداديين سمعت أبي يقول ذلك وسألته عنه فقال يكتب حديثه ولا يحتج به.(@)(@@)(@@)(@@) $ 1225 -(@)(@@) محمد بن جعفر أبو عمران الوركانى روى عن شريك وابراهيم ابن 
ms2226	 سعد وابى شهاب والمعافى بن عمران الموصلي مات سنة نيف وعشرين ومائتين سمعت أبي يقول ذلك، روى عنه أبو زرعة وموسى بن اسحاق القاضى.(@)(@@) نا عبد الرحمن نا أبو زرعة نا محمد بن جعفر أبو عمران الوركانى جار احمد ابن حنبل وكان احمد يرضاه، نا عبد الرحمن قال سمعت أبا زرعة يقول كان صدوقا ما علمته.(@)(@@)(@@)(@@) $ 1226 -(@)(@@) محمد بن جعفر بن عبد الله بن جعفر (بن عبد الله - 1) بن خباب بن الأرت روى عن ابيه عن القاسم العرفطى عن رجل عن عمر بن عبد العزيز بخطبة طويلة، يكنى ابا عبد الرحمن كان يسمع منه هذه الخطبة لعمر بن عبد العزيز ويسأل عنها سمعت أبي يقول ذلك وسمعته يقول هو مجهول.(@)(@@)(@@)(@@) $ 1227 -(@)(@@) محمد بن جحادة الاودى الكوفى روى عن ابى صالح باذان وابى حازم الاشجعى والحسن البصري والحكم بن عتيبة وطلحة بن مصرف والزبير بن عدى وعبد الرحمن بن ثروان وزياد بن علاقة وابى حصين وابى سعيد عقيصا روى عنه مسعر وسفيان الثوري وشعبة وهمام وعمران القطان وعبد الوارث وابو محصن والحسن بن أبي جعفر سمعت أبي يقول ذلك.(@)(@@) نا عبد الرحمن حدثنا محمد بن حمويه بن الحسن قال سمعت أبا طالب أحمد ابن حميد قال قال أحمد بن حنبل محمد بن جحادة من الثقات، نا عبد الرحمن انا يعقوب ابن إسحاق فيما كتب إلى قال نا عثمان بن سعيد قال سألت يحيى بن معين عن محمد ابن جحادة ما حاله؟ قال ثقة، نا عبد الرحمن قال سألت ابى عن محمد بن جحادة فقال ثقة(@)(@@) صدوق محله محل عمرو بن قيس الملائى وابى خالد الدالانى وزيد بن ابى انيسة.(@)(@@)(@@)(@@) $ 1228 -(@)(@@) محمد بن جميع بن عمير الليثي روى عن أبيه روى عنه على بن هاشم(@)(@@) PageV07P222(@)(@@) ابن البريد، نا عبد الرحمن قال سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 1229 -(@)(@@) محمد بن جهضم الخراساني روى عن اسمعيل بن جعفر ويزيد ابن عطاء وأزهر بن سنان روى عنه محمد بن المثنى ومحمد بن مهدى الايلى سمعت أبي 
ms2227	 يقول ذلك، نا عبد الرحمن قال سألت أبا زرعة عن محمد بن جهضم فقال صدوق لا بأس به، قال أبو محمد.(@)(@@)(@@)(@@) $ 1230 -(@)(@@) محمد بن الجعد يقال له القرشى روى عن الزهري وعلى بن زيد ابن جدعان روى عنه محمد بن عيسى بن الطباع وعباس بن بكار أبو الوليد الضبى، نا عبد الرحمن قال سألت أبي عنه فقال هو شيخ بصرى ليس بمشهور.(@)(@@)(@@)(@@) $ 1231 -(@)(@@) محمد بن جامع العطار البصري أبو عبد الله روى عن حماد بن زيد ومعتمر بن سليمان وخالد بن الحارث وسعيد بن عبد الجبار وحصين بن نمير ومروان بن معاوية، نا عبد الرحمن قال سمعت أبي يقول كتبت عنه وهو ضعيف الحديث - وكان يحدث باحاديث كبار فامتنع ابى من الرواية عنه، نا عبد الرحمن قال سئل أبو زرعة عن محمد بن جامع العطار فقال ليس بصدوق ما حدثت عنه شيئا ولم يقرأ علينا حديثه.(@)(@@)(@@)(@@) $ 1232 -(@)(@@) محمد بن جميل الهروي روى عن.. (1) روى عنه.. (1) سمعت ابى يقول هو مجهول.(@)(@@)(@@)(@@) $ 1233 -(@)(@@) محمد بن جنيد الكوفى سمع عبد الله بن عبد الملك بن أبي عبيدة بن عبد الله بن مسعود سمعت أبي يقول ذلك، قال أبو محمد بن جنيد الحجام روى عن أبي عبد الرحمن المسعودي وعبد الله بن عبد الملك بن أبي عبيدة بن عبد الله(@)(@@) ابن مسعود، قال أبو محمد روى عنه أبو بكر محمد بن خلف الحدادى، قال أبو محمد.(@)(@@)(@@)(@@) $ 1234 -(@)(@@) محمد بن الجنيد الصيد نانى شيخ بجرجان روى عن محمد بن سعيد ابن الاصبهاني وغيره، نا عبد الرحمن قال سئل أبو زرعة عنه فقال هو عندي صدوق.(@)(@@)(@@)(@@) $ 1235 -(@)(@@) محمد بن أبي الجعد روى عن الشعبى وعطاء روى عنه الثوري ووكيع وأبو نعيم سمعت أبي يقول ذلك، وسألته عنه فقال شيخ يكتب حديثه. PageV07P223(@)(@@)(@@)(@@) $ 1236 -(@)(@@) محمد بن ابى الجهم بن حذيفة العدوى قتل يوم الحرة سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 1237 -(@)(@@) محمد بن أبي جعفر روى عن سالم بن عبد الله بن عمر عن أبيه عن النبي صلى الله عليه 
ms2228	 وسلم في رفع اليدين روى عنه هشيم سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1238 -(@)(@@) محمد بن الجراح (الطوسى - 1) نا عبد الرحمن قال سألت أبي عنه فقال هو مجهول (2) .(@)(@@)(@@)(@@) $ 1239 -(@)(@@) محمد بن ابى جميلة روى عن نافع روى عنه بقية سألت أبي عنه فقال هو مجهول.(@)(@@)(@@)(@@) $ 1240 -(@)(@@) محمد بن جبلة الرافقى روى عن إسحاق بن إبراهيم الحنينى ومحمد ابن موسى بن اعين وحجاج بن ابى منيع وعبد الرحيم بن مطرف وابن ابى اسامة الرقى كتب إلى أبي وأبي زرعة والى باحاديث من فوائده.(@)(@@)(@@)(@@) $ 1241 -(@)(@@) محمد بن جدعان روى عن الحسن روى عنه حريث بن ابى مطر سعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 1242 -(@)(@@) محمد بن جهم بن عثمان بن ابى جهمة وكان جده على سياقة غنم خيبر يوم استفتحها رسول الله صلى الله عليه وسلم روى عن أبيه عن جده عن(@)(@@) عمر بن الخطاب رضي الله عنه حديث نصر بن الحجاج روى عنه محمد بن سعيد ابن زياد الاثرم.(@)(@@)(@@)(@@) ||||| باب تسمية من روى عنه العلم ممن يسمى محمد أو ابتداء اسم ابيه على الحاء(@)(@@)(@@)(@@) $ 1243 - محمد بن حاطب القرشى الجمحي أدرك النبي صلى الله عليه وسلم (وهو غلام اتت به امه إلى النبي صلى الله عليه وسلم - 1) وقد احترقت يده فنفث عليه، وروى عن على رضي الله عنه، وامه ام جميل بنت المجلل روى عنه ابوبلج PageV07P224(@)(@@) وسماك بن حرب وابو عون الثقفى وابن ابنه عثمان بن إبراهيم بن محمد بن حاطب سمعت أبي يقول بعض ذلك وبعضه من قبلي.(@)(@@)(@@)(@@) $ 1244 -(@)(@@) محمد بن حويطب القرشى روى عن النبي صلى الله عليه وسلم فيما رواه عتاب بن بشير عن خصيف عنه سمعت أبي يقول لا اعرفه.(@)(@@)(@@)(@@) $ 1245 -(@)(@@) محمد بن حبيب المصرى قال أتيت النبي صلى الله عليه وسلم وسألته عن الهجرة روى عنه عبد الله بن السعدى وابو إدريس الخولاني سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1246 -(@)(@@) محمد بن حبيب (بن أبي حبيب - 1) روى عن.. (2) روى عنه ابنه عبد الرحمن بن محمد سمعت أبي يقول ذلك وسألته عنه فقال 
ms2229	 لا اعرفه.(@)(@@)(@@)(@@) $ 1247 -(@)(@@) محمد بن حبيب الجدى روى عن وهيب بن خالد وحماد بن سلمة روى عنه أحمد بن شيبان الرملي وغيره.(@)(@@)(@@)(@@) $ 1248 -(@)(@@) محمد بن الحسن بن أبي يزيد الهمداني روى عن عمرو بن قيس الملائى وهشام بن عروة روى عنه ابن نفيل الحرانى وشهاب بن عباد والحسين(@)(@@) ابن عبد الاول واسحاق بن عمر المؤدب سمعت أبي يقول ذلك.(@)(@@) نا عبد الرحمن أنا عبد الله بن أحمد بن محمد بن حنبل فيما كتب إلي قال سمعت ابى يقول محمد بن الحسن الهمداني ضعيف الحديث ما ارى يسوي شيئا، حدثنا عبد الرحمن قال قرئ على العباس بن محمد الدوري عن يحيى بن معين انه قال محمد بن الحسن بن أبي يزيد الهمداني ليس بثقة كان يكذب، نا عبد الرحمن قال سألت ابى عن محمد بن الحسن بن ابى يزيد الهمداني فقال ليس بالقوى.(@)(@@)(@@)(@@) $ 1249 -(@)(@@) محمد بن الحسن بن الزبير الاسدي المعروف بالتل روى عن سفيان الثوري وشيبان النحوي وأبي هلال الراسبي روى عنه أبو بكر بن أبي شيبة وابنه عمر، نا عبد الرحمن سمعت أبي يقول ذلك.(@)(@@) نا عبد الرحمن قال قرئ على العباس بن محمد الدوري قال سئل يحيى بن معين عن محمد بن الحسن الأسدي فقال ليس بشئ (3) نا عبد الرحمن قال سألت ابى PageV07P225(@)(@@) عن محمد بن الحسن المعروف بالتل فقال شيخ، قال أبو محمد.(@)(@@)(@@)(@@) $ 1250 -(@)(@@) محمد بن الحسن الواسطي المزني اصله من الشام ولى القضاء بواسط روى عن اسمعيل بن ابى خالد والاصبغ بن يزيد والعوام بن حوشب ومستلم بن سعيد وداود بن يزيد الاودى والمسعودي وعبد الملك بن أبي سليمان وسعيد بن ابى عروبة ويونس بن أبي إسحاق وفضيل بن غزوان ومبارك بن فضالة وعوف الاعرابي ومحمد بن إسحاق روى عنه محمد بن عيسى ابن الطباع واحمد ابن حنبل وعمرو بن عون ووهب بن بقية وإبراهيم بن موسى ومحمد بن مهران الجمال وعمار بن خالد ومحمد بن سلام الجمحى سمعت بعض ذلك من أبي وبعضه من قبلي. 
ms2230	(@)(@@) ثنا عبد الرحمن أنا عبد الله بن أحمد فيما كتب إلي قال سألت ابى عن محمد ابن الحسن الواسطي المزني قال ليس به بأس.(@)(@@) نا عبد الرحمن أنا أبو بكر بن أبي خيثمة فيما كتب إلي قال سمعت يحيى بن معين يقول محمد بن الحسن الواسطي ثقة، نا عبد الرحمن قال سألت ابى عن محمد بن الحسن الواسطي فقال لا بأس به.(@)(@@)(@@)(@@) $ 1251 -(@)(@@) محمد بن الحسن بن عطية بن سعد العوفى روى عن ابيه وعن محمد بن عبد الرحمن عن أبي هريرة روى عنه محمد بن ربيعة سمعت أبي يقول ذلك، نا عبد الرحمن أنا الحسين بن الحسن قال سألت يحيى بن معين عن محمد بن الحسن بن عطية العوفى قال هو كوفى ليس بمتين.(@)(@@) نا عبد الرحمن قال سألت ابى عن محمد بن الحسن بن عطية فقال هو ضعيف الحديث، نا عبد الرحمن قال سئل أبو زرعة عن محمد بن الحسن بن عطية فقال لين الحديث.(@)(@@)(@@)(@@) $ 1252 -(@)(@@) محمد بن الحسن بن اتش الصنعانى روى عن منذر بن النعمان وعبد الرحمن والنعمان ابني الزبير ورباح بن زيد وسليمان بن وهب وابى بكر ابن ابى سبرة روى عنه إبراهيم بن موسى ونوح بن حبيب وعلى بن صالح بن(@)(@@) PageV07P226(@)(@@) وسيم ومحمد بن رافع وأبو زياد حماد بن زاذان سمعت أبي يقول ذلك، قال أبو محمد روى عن همام (1) بن منبه، حدثنا عبد الرحمن قال سألت أبا زرعة عن محمد بن الحسن بن اتش فقال ثقة.(@)(@@)(@@)(@@) $ 1253 -(@)(@@) محمد بن الحسن الشيباني مولى لهم صاحب الرأى أبو عبد الله اصله من دمشق من اهل حرستا قدم ابوه العراق فولد محمد بواسط ونشأ بالكوفة وخرج مع هارون فمات بالرى روى عن زمعة والثوري وبكير بن(@)(@@) عامر وابى يوسف يعقوب روى عنه أبو سليمان الجوزجانى وهشام الرازي والعلاء بن زهير واسمعيل بن توبة سمعت أبي يقول ذلك، قال أبو محمد روى عن مسعر والثوري والاوزاعي ومالك وابراهيم الخوزى ومحمد بن ابان.(@)(@@) نا عبد الرحمن أنا عبد 
ms2231	 الله بن أحمد بن محمد بن حنبل فيما كتب إلي قال سألت ابى عن محمد بن الحسن صاحب الرأى قال لا اروى عنه شيئا.(@)(@@) ثنا عبد الرحمن قال قرئ على العباس بن محمد الدوري قال سئل يحيى بن معين عن محمد بن الحسن الشيباني فقال ليس بشئ.(@)(@@) نا عبد الرحمن سمعت أبي يقول وجدت في كتاب السير لمحمد بن الحسن صاحب الرأى عن الواقدي احاديث فلم يضبطوا عن محمد بن الحسن (فرووا عن محمد بن الحسن عن الواقدي احاديث ورووا الباقي عن محمد بن الحسن - 2) عن مشايخ الواقدي مثل خارجة بن عبد الله بن سليمان بن زيد بن ثابت وعن محمد بن هلال وعن الضحاك بن عثمان وهذا كله عن الواقدي فجعلوه عن محمد بن الحسن عن هؤلاء المشايخ.(@)(@@)(@@)(@@) $ 1254 -(@)(@@) محمد بن الحسن بن زبالة المخزومى روى عن مالك بن أنس وسليمان بن بلال وعبد العزيز الدراوردى روى عنه أحمد بن صالح وهارون بن عبد الله الحمال وعمر بن شبة وسليمان القزاز (3) سمعت أبي يقول ذلك، قال PageV07P227(@)(@@) أبو محمد وروى عن موسى بن يعقوب الزمعى روى عنه إسحاق بن موسى الخطمى.(@)(@@) نا عبد الرحمن قال قرئ على العباس بن محمد الدوري قال سئل يحيى بن(@)(@@) معين عن محمد بن الحسن بن زبالة فقال ليس بثقة كان يسرق الحديث.(@)(@@) حدثنا عبد الرحمن حدثني أبي نا معاوية بن صالح بن عبيد الله الدمشقي قال قال يحيى بن معين محمد بن الحسن الزبالى والله ما هو بثقة حدث عد والله عن مالك عن هشام بن عروة عن أبيه عن عائشة عن النبي صلى الله عليه وسلم قال فتحت المدينة بالقرآن وفتحت سائر المدن بالسيوف.(@)(@@) نا عبد الرحمن قال سألت ابى عن محمد بن الحسن بن زبالة المدينى فقال ما اشبه حديثه بحديث عمر بن ابى بكر المؤملى والواقدى ويعقوب الزهري والعباس بن ابى شملة وعبد العزيز بن عمران الزهري وهم ضعفاء مشايخ أهل المدينة.(@)(@@) نا عبد الرحمن قال سألت أبي عن ابن زبالة 
ms2232	 فقال واهي الحديث (ضعيف الحديث - 1) ذاهب الحديث منكر الحديث عنده مناكير وليس بمتروك (الحديث، سئل أبو زرعة عن محمد بن الحسن بن أبي الحسن فقال هو ابن زبالة وهو واهى الحديث - 1) .(@)(@@)(@@)(@@) $ 1255 -(@)(@@) محمد بن الحسن البصري ولقبه محبوب روى عن يونس بن عبيد وخالد الحذاء وعمرو بن عبيد روى عنه خلف بن هشام وابنه الحسن بن محبوب ومحمد بن بشار سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1256 -(@)(@@) محمد بن الحسن اليماني روى عن.. (2) روى عنه.. (2) سمعت أبي يقول هو مجهول.(@)(@@) قال أبو محمد.(@)(@@)(@@)(@@) $ 1257 -(@)(@@) محمد بن الحسن بن المختار التميمي الكوفى نزيل الرى ابن عم عبد المؤمن بن على روى عن على بن مسهر ومسلم بن خالد الزنجي وعبد الحميد بن سليمان المدينى اخى فليح ويونس بن ابى يعفور وعمرو بن عطية العوفى وعمرو ابن ابى المقدام وعلى بن هاشم بن البريد والعلاء بن حصين قاضى الرى روى عنه PageV07P228(@)(@@) أبي وأبو زرعة، حدثنا عبد الرحمن قال سألت أبي عنه فقال كان ثبتا حسن الحديث وقدمت من العراق وكان أبو زرعة قد كتب عنه الكثير فنظرت في كتبه وانتخبت فكان أبو زرعة يكتب لى بعضا وأكتب انا بعضا وكان الشيخ يوجب وكان يقرأ علينا ولا يقرأ الا من اصله، نا عبد الرحمن قال سئل أبو زرعة عن محمد بن الحسن بن المختار فقال صدوق.(@)(@@)(@@)(@@) $ 1258 -(@)(@@) محمد بن الحسن بن فلان بن أسامة بن زيد روى عن حسين بن ابى حسين المازنى عن يزيد بن عبد الله بن قسيط روى (1) عن عيسى بن النعمان الزرقى عن عبد العزيز بن على بن هبار عن ابن ام - كلاب عن عمر بن الخطاب رضي الله عنه روى ابراهيم بن المنذر عن عباس بن ابى شملة عنه سمعت أبي يقول ذلك، ويقول هو مجهول.(@)(@@) قال أبو محمد.(@)(@@)(@@)(@@) $ 1259 -(@)(@@) محمد بن الحسن بن طريف أبو بكر الاعين البغدادي روى عن الأسود بن عامر وزيد بن حباب ومؤمل بن اسمعيل وعبد الصمد بن النعمان وابى اسحاق الطالقاني روى عنه أبي 
ms2233	 وأبو زرعة.(@)(@@) قال أبو محمد.(@)(@@)(@@)(@@) $ 1260 -(@)(@@) محمد بن الحسن الفراء الرازي روى عن محمد بن القاسم الاسدي والقاسم بن الحكم العرنى وقبيصة واسمعيل بن حماد بن أبي حنيفة سمع منه أبي.(@)(@@) قال أبو محمد.(@)(@@)(@@)(@@) $ 1261 -(@)(@@) محمد بن الحسين البرجلاني صاحب كتب (2) الزهد روى عن الهيثم بن عبيد الصيد ومالك بن ضعيغم والحسين بن على الجعفي وسعيد بن عامر وزيد بن حباب وازهر بن سعد السمان وطلق بن غنام روى عنه محمد بن يحيى ابن عمر الواسطي وابراهيم بن الجنيد وابو بكر بن أبي الدنيا، نا عبد الرحمن قال(@)(@@) سمعت أبي يقول ذكر لى ان رجلا سأل احمد بن حنبل عن شئ من حديث الزهد فقال عليك بمحمد بن الحسين البرجلانى.(@)(@@)(@@)(@@) $ 1262 -(@)(@@) محمد بن الحسين بن إبراهيم بن الحر المعروف بابن اشكاب PageV07P229(@)(@@) الصغير روى عن مصعب بن المقدام ومحمد بن ابى عبيدة المسعودي ومعاوية بن هشام وابى المنذر اسمعيل بن عمر وعبد الصمد بن عبد الوارث وأبي النضر هاشم بن القاسم واسحاق بن سليمان الرازي سمعت منه مع أبي وهو ثقة، نا عبد الرحمن قال سئل أبي عنه فقال صدوق.(@)(@@)(@@)(@@) $ 1263 -(@)(@@) محمد بن الحسين بن موسى بن ابى حنين الكوفي روى عن عبيد الله بن موسى (واحمد بن مفضل - 1) وابى غسان مالك بن اسمعيل كتبنا بعض فوائده سنة ست وخمسين ومائتين ولم يقدر لنا السماع منه وعمر بعدنا وهو صدوق.(@)(@@)(@@)(@@) $ 1264 -(@)(@@) محمد بن الحسين أبو جعفر السمنانى روى عن إسحاق بن إبراهيم الحنينى والمعلى بن اسد وابى نعيم ونعيم بن حماد وكان اجتمع مع ابى في الرحلة بالبصرة ايام الانصاري روى عنه أبو زرعة ويوسف بن اسحاق بن الحجاج.(@)(@@)(@@)(@@) $ 1265 -(@)(@@) محمد بن الحارث بن سفيان بن عبد الاسد المخزومى المكى روى عن على (2) الازدي وابى علقمة روى عنه ابن جريج وابن أبي حسين وعبد الله بن عثمان بن خثيم وابن عيينة سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1266 -(@)(@@) محمد بن الحارث بن زهدم روى عن مالك بن ابى عامر روى عنه جويرية بن 
ms2234	 أسماء سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 1267 -(@)(@@) محمد بن الحارث الثقفى روى عن الحسن وابن سيرين روى(@)(@@) عنه محمد بن أبي بكر المقدمي وعبيد الله القواريري سمعت أبي يقول ذلك، نا عبد الرحمن قال قرئ على العباس بن محمد الدوري قال سئل يحيى بن معين عن محمد بن الحارث الذى روى عنه عفان فقال ليس بثقة، نا عبد الرحمن قال سألت أبي عن محمد بن الحارث الثقفى فقال شيخ يكتب حديثه، قال أبو محمد.(@)(@@)(@@)(@@) $ 1268 -(@)(@@) محمد بن الحارث بن الوليد اليحصبى أبو الوليد روى عن بقية روى عنه يزيد بن سنان البصري نزيل مصر سألت أبي عنه فقال شيخ مجهول لا يعرف.(@)(@@) قال أبو محمد. PageV07P230(@)(@@)(@@)(@@) $ 1269 -(@)(@@) محمد بن الحارث العتكى روى عن.. (1) روى عنه.. (1) سمعت ابى يقول هو مجهول.(@)(@@)(@@)(@@) $ 1270 -(@)(@@) محمد بن الحارث الحارثى أبو عبد الله بصري روى عن محمد بن عبد الرحمن البيلمانى والزناد روى عنه عبيد الله بن محمد القرشى المعروف بابن عائشة وعبيد الله القوارير ومحمد بن بشار وعمر بن شبة سمعت أبي يقول ذلك، قال أبو محمد روى عنه زيد بن حباب، نا عبد الرحمن نا محمد بن ابراهيم ناعمرو بن على قال محمد بن الحارث الذى روى عن ابن البيلماني روى احاديث منكرة وهو متروك الحديث.(@)(@@) نا عبد الرحمن قال قرئ على العباس بن محمد الدوري قال سئل يحيى ابن معين عن محمد بن الحارث الحارثى فقال بصرى ليس بشئ، حدثنا عبد الرحمن قال سئل ابى عن محمد بن الحارث الذى يحدث عن ابن البيلمانى فقال ضعيف الحديث، قال أبو محمد ترك أبو زرعة حديث محمد بن الحارث الحارثى ولم يقرأ(@)(@@) علينا في كتاب الشفعة.(@)(@@) قال أبو محمد.(@)(@@)(@@)(@@) $ 1271 -(@)(@@) محمد بن الحارث المخزومى أبو عبد الله المديني روى عن عبد الله ابن معاوية بن موسى بن نشيط وابراهيم بن محمد التيمى كتبت عنه بالمدينة وهو صدوق.(@)(@@)(@@)(@@) $ 1272 -(@)(@@) محمد بن حميد أبو سفيان المعمرى اليشكرى بغدادي روى عن معمر والثوري روى عنه محمد بن عيسى ابن 
ms2235	 الطباع والنفيلي وعمرو الناقد ومحمد ابن عبد الله بن نمير وأبو سعيد الأشج سمعت أبي يقول ذلك، نا عبد الرحمن نا ابى ناعمرو الناقد قال سألت عبد الرزاق قلت أتعرف ابا سفيان المعمرى؟ قال نعم قد سمع من معمر معنا وعرفه، نا عبد الرحمن أنا أبو بكر بن أبي خيثمة فيما كتب إلي قال سمعت يحيى بن معين يقول أبو سفيان المعمرى ثقة، نا عبد الرحمن قال سألت أبي عنه فقال صالح الحديث قال أبو محمد.(@)(@@)(@@)(@@) $ 1273 -(@)(@@) محمد بن حميد أبو عبد الرحمن الاصباعى (2) روى عن ابى العلاء PageV07P231(@)(@@) خالد بن طهمان روى عنه أبو زرعة.(@)(@@)(@@)(@@) $ 1274 -(@)(@@) محمد بن حميد بن الاسود وهو محمد بن ابى الاسود البصري روى عن أبيه روى عنه ابنه عبد الله سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 1275 -(@)(@@) محمد بن حميد الرازي أبو عبد الله روى عن ابن المبارك ويعقوب ابن عبد الله الاشعري وجرير بن عبد الحميد وابراهيم بن المختار ومهران ومحمد بن المعلى وحكام بن سلم وهارون بن المغيرة وعبد الله بن عبد القدوس روى عنه.(@)(@@) (1) نا عبد الرحمن أنا أبو بكر بن أبي خيثمة فيما كتب إلي قال سئل يحيى بن معين عن محمد بن حميد الرازي فقال ثقة ليس به بأس رازى كيس، حدثنا عبد الرحمن نا علي(@)(@@) بن الحسين بن الجنيد قال سمعت يحيى بن معين يقول ابن حميد ثقة وهذه الاحاديث التى يحدث بها ليس هو من قبله انما هو من قبل الشيوخ الذى يحدث به عنهم.(@)(@@) نا عبد الرحمن قال سمعت أبي يقول سألني يحيى بن معين عن ابن حميد من قبل ان يظهر منه ما ظهر فقال أي شئ تنقمون عليه؟ فقلت يكون في كتابه الشئ فنقول ليس هذا هكذا انما هو كذا وكذا فيأخذ القلم فيغيره على ما نقول، قال بئس هذه الخصلة قدم علينا بغداد فأخذنا منه كتاب يعقوب القمى ففرقنا الاوراق بيننا ومعنا احمد بن حنبل فسمعناه ولم نر الاخيرا.(@)(@@) نا عبد الرحمن سمعت أبي يقول حضرت 
ms2236	 محمد بن حميد وحضره عون ابن جرير فجعل ابن حميد يحدث بحديث عن جرير فيه شعر فقال عون ليس هذا الشعر في الحديث انما هو من كلام ابى فتغافل ابن حميد ومر فيه.(@)(@@) نا عبد الرحمن قال سمعت ابى يقول حضرت حانوت عبدك ختن ابى عمران الصوفى انا واحمد بن السندي وعنده جزءان فقلت هذان الجزءان لك؟ قال نعم قلت ممن سمعت؟ قال من أبي زهير عبد الرحمن بن مغراء، فإذا مكتوب في اول الجزء احاديث لمحمد بن اسحاق ثم على اثر ذلك شيوخ على بن مجاهد والآخر احاديث (2) سلمة بن الفضل فقلت احد الجزئين من هو حديث على بن مجاهد والآخر من حديث سلمة بن الفضل، فقال لا حدثنا به أبو زهير، فعلمت على احاديث PageV07P232(@)(@@) منها غرائب حسان فلما رأيته قد لج تركت الجزئين عنده وخرجت ثم دخلت انا وابن السندي بعد ايام على ابن حميد فقال ههنا احاديث لم ننظر فيه، فأخرج إلى جزئين (1) فإذا احاديث قد كتبه وقرأ مشاهير مما مر بى في ذينك الجزئين وإذا قد كتب تلك الغرائب وإذا هو يحدث بما كان في الجزء الذى ذكرت انا لعبدك(@)(@@) انه من حديث على بن مجاهد عن على بن مجاهد، والذى ذكرت انه عن سلمة بن الفضل يحدث به عن سلمة على الاستواء فقلت لابن السندي ترى هذه الاحاديث هي الاحاديث التى رأيت في الجزئين اللذين كانا عند عبدك، فلما خرجنا من عند ابن حميد وقد كتبت تلك الاحاديث الغرائب التى كنت اشتهيت ان اسمعه من عبدك سمعته من ابن حميد ومررت على عبدك فقلت هات ذلك الجزئين لاطالعه فقال مر بى ابن حميد ورأهما في حانوتي فأخذهما وذهب بهما.(@)(@@) نا عبد الرحمن نا علي بن الحسين بن الجنيد قال سمعت أبا زرعة يقول كتب إلى من بغداد بنحو من خمسين حديثا من حديث ابن حميد منكرة فيه احاديث رواه شبابة عن شعبة حدث به عن ابراهيم بن المختار عن شعبة، نا عبد الرحمن حدثني جعفر 
ms2237	 بن محمد بن حماد العطار قال سمعت محمد بن عيسى ابن الدامغاني قال لما مات هارون بن المغيرة سألت محمد بن حميد أن يخرج إلى جميع ما سمع منه فاخرج إلى جزازات فأحصيت جميع ما فيه ثلثمائة ونيفا وستين حديثا، قال جعفر بن محمد بن حماد واخرج ابن حميد عن هارون بعد بضعة عشر الف حديث.(@)(@@)(@@)(@@) $ 1276 -(@)(@@) محمد بن ابى حميد أبو ابراهيم الزرقى الضرير ويقال حماد بن ابى حميد روى عن محمد بن كعب القرظى والعباس بن سهل بن سعد الساعدي وموسى بن وردان واسمعيل بن محمد بن سعد ومحمد بن المنكدر روى عنه عبد العزيز ابن محمد وابن أبي فديك وأبو عامر العقدي وابو بكر بن ابى اويس أبو داود الطيالسي وعبد الله بن وهب ومحمد بن بشر العبدى وعبد الله بن مسلمة القعنبي سمعت أبي يقول ذلك، نا عبد الرحمن أنا عبد الله بن أحمد بن محمد بن حنبل فيما كتب إلي قال سمعت ابى يقول محمد بن ابى حميد احاديثه احاديث مناكير. PageV07P233(@)(@@) نا عبد الرحمن قال قرئ على العباس بن محمد الدوري قال سمعت يحيى بن معين يقول محمد بن ابى حميد وهو حماد بن ابى حميد مدينى ضعيف ليس حديثه بشئ، نا عبد الرحمن قال سألت ابى عن محمد بن ابى حميد فقال كان رجلا ضرير البصر وهو منكر الحديث ضعيف الحديث مثل ابن ابى سبرة ويزيد بن عياض يروى عن الثقات بالمناكير، نا عبد الرحمن قال سئل أبو زرعة عن محمد بن ابى حميد فقال ضعيف الحديث.(@)(@@)(@@)(@@) $ 1277 -(@)(@@) محمد بن الحجاج من ولد ابى لبابة الأنصاري مديني روى عن أبيه روى يعقوب بن محمد الزهري عن عاصم بن سويد عنه، نا عبد الرحمن قال سألت أبي عنه فقال هو مجهول.(@)(@@)(@@)(@@) $ 1278 -(@)(@@) محمد بن الحجاج اللخمى الواسطي روى عن مجالد وعبد الملك ابن عمير روى عنه سريج بن يونس ومحمد بن سفيان الأسدي سمعت أبي يقول ذلك، نا عبد الرحمن قال قرئ على العباس بن 
ms2238	 محمد الدوري قال سئل يحيى بن معين عن محمد بن الحجاج الواسطي فقال ليس بثقة كان يحدث بحديث اطعمني جبرئيل عليه السلام الهريسة، نا عبد الرحمن أنا يعقوب بن إسحاق فيما كتب إلى قال نا عثمان ابن سعيد قال قلت ليحيى بن معين محمد بن الحجاج اللخمى الواسطي كيف هو؟ قال كذاب، نا عبد الرحمن قال سألت ابى عن محمد بن الحجاج الواسطي اللخمى فقال هو كذاب ذاهب الحديث.(@)(@@)(@@)(@@) $ 1279 -(@)(@@) محمد بن الحجاج من بني عبد الدار روى عن.(@)(@@) (1) روى عنه مروان الفزاري ومحمد بن وهب بن عطية، نا عبد الرحمن قال سمعت أبي يقول ذلك، وسألته عنه فقال هو شيخ.(@)(@@)(@@)(@@) $ 1280 -(@)(@@) محمد بن الحجاج المصفر روى عن شعبة وعبد العزيز بن محمد الدراوردي روى عنه عمرو الناقد ومحمد بن الحسن بن طريف الأعين سمعت أبى(@)(@@) يقول ذلك، نا عبد الرحمن أنا عبد الله بن أحمد بن محمد بن حنبل فيما كتب إلي قال سألت ابى عن محمد بن الحجاج المصفر فقال قد تركت حديثه أو قال تركنا PageV07P234(@)(@@) حديثه، نا عبد الرحمن نا أبي قال قال علي بن المدينى محمد بن الحجاج المصفر ذهب حديثه، نا عبد الرحمن قال سألت ابى عن محمد بن الحجاج المصفر فقال رأيته ببغداد ولم اكتب عنه وقيل لى انه اخرج احاديث ابى مريم عن عمرو بن مرة فرواه عن شعبة عن عمرو بن مرة فذهب حديثه وتركوه.(@)(@@)(@@)(@@) $ 1281 -(@)(@@) محمد بن الحجاج وهو ابن الحجاج بن يوسف القرشى الدمشقي روى عن عروة بن رويم ويونس بن ميسرة بن حلبس واسمعيل بن عبيد الله وخالد ابن دهقان روى عنه اسمعيل بن عياش وبقية وسليمان بن عبد الرحمن الدمشقي والهيثم بن خارجة سمعت أبي يقول ذلك، وسألته عنه فقال شيخ.(@)(@@)(@@)(@@) $ 1282 -(@)(@@) محمد بن الحجاج المصرى روى عن أبي موسى روى خالد بن حميد الاسكندرانى عن سلام عن حرب ابى رجاء عنه، نا عبد الرحمن سمعت أبي يقول ذلك، وسألته عنه فقال (هو مجهول وسلام مجهول وحرب مجهول 
ms2239	 وابو موسى مجهول.(@)(@@)(@@)(@@) $ 1283 -(@)(@@) محمد بن الحجاج البجلى روى عن القاسم بن الوليد سمعت أبي يقول ذلك، وسألته عنه فقال - 1) روى عنه بعض الضعفاء وهو مجهول لين الحديث.(@)(@@)(@@)(@@) $ 1284 -(@)(@@) محمد بن الحجاج الحضرمي المصري روى عن الخصيب بن ناصح وأسد بن موسى وعبد الرحمن بن زياد الرصاصي ويعقوب بن ابى عباد القلزمى وصاعد بن عبيد كتبت عنه بمصر وهو صدوق ثقة.(@)(@@)(@@)(@@) $ 1285 -(@)(@@) محمد بن حصين التميمي وقال بعضهم ايوب بن حصين، ومحمد بن حصين اصح روى عن أبي علقمة مولى ابن عباس روى عنه قدامة بن موسى وسليمان بن بلال والدراوردى وعمر بن علي بن مقدم سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 1286 -(@)(@@) محمد بن حصين بن عبد الرحمن بن عمرو بن سعد بن معاذ روى عن أبيه روى عنه محمد بن طلحة الطويل التيمي سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 1287 -(@)(@@) محمد بن حصين بن سياه روى عن جدته أم سنبلة روى عنه PageV07P235(@)(@@) عمرو بن قيظى سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1288 -(@)(@@) محمد بن حمزة بن عمرو الأسلمي روى عن ابيه روى عنه أسامة بن زيد الليثى وكثير بن زيد سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1289 -(@)(@@) محمد بن حمزة بن محمد بن يوسف بن عبد الله بن سلام الخزرجي الأنصاري روى عن أبيه روى عنه عبد الله بن سالم والوليد بن مسلم سمعت أبي يقول ذلك وسألته عنه فقال لا بأس به.(@)(@@)(@@)(@@) $ 1290 -(@)(@@) محمد بن حمزة الأسدي الرقي روى عن جعفر بن برقان روى عنه يحيى بن صالح الوحاظي سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1291 -(@)(@@) محمد بن الحكم الكاهلى الأسدي روى عن أبي وائل شقيق بن سلمة ونوف، روى عنه العلاء بن المسيب وقيس بن الربيع سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1292 -(@)(@@) محمد بن الحكم أبو عبد الله الاحول المروزى روى عن النضر ابن شميل سمعت أبي يقول ذلك وسمعته يقول هو مجهول.(@)(@@)(@@)(@@) $ 1293 -(@)(@@) محمد بن أبي الحكم روى عن.. (1) روى عنه عطاء بن مسلم سمعت أبي يقول ذلك.(@)(@@) ويقول هو مجهول.(@)(@@)(@@)(@@) $ 1294 -(@)(@@) محمد بن حفص ابن 
ms2240	 عائشة روعن عمه عبيد الله بن عمر بن موسى روى عنه ابنه عبيد الله بن محمد بن حفص سمعت أبي يقول ذلك.(@)(@@) قال أبو محمد.(@)(@@)(@@)(@@) $ 1295 -(@)(@@) محمد بن حفص الحصى موضعا بين رقة وحلب روى عن معمر وابى حنيفة النعمان بن ثابت روى عنه.. (1) نا عبد الرحمن قال سألت أبا زرعة عنه فقال صدوق.(@)(@@) قال أبو محمد.(@)(@@)(@@)(@@) $ 1266 -(@)(@@) محمد بن حفص التميمي القزويني روى عن روح بن عبادة وابى احمد الزبيري والوليد بن القاسم سمع منه أبي بقزوين، قال أبو محمد،(@)(@@)(@@)(@@) $ 1297 - محمد بن حفص بن عمر الدوري المعروف والده بابى عمر الدوري المقرى سكن سامراء روى عن الأسود بن عامر واحمد بن اسحاق الحضرمي ومحمد بن مصعب القرقسانى كتبنا من حديثه لنسمع منه فلم يتفق لنا PageV07P236(@)(@@) لسماع ووجه إليه (1) ابى بطبقة من حديثه كتب الينا بها، قال أبو محمد.(@)(@@)(@@)(@@) $ 1298 -(@)(@@) محمد بن حفص الوصابى الحمصى أبو عبيد روى عن محمد بن حمير وأبي حيوة شريح بن يزيد ادركته واردت قصده والسماع منه فقال لى بعض اهل حمص ليس بصدوق ولم يدرك محمد بن حمير فتركته وكتب عنه سعيد بن عمرو البرذعي.(@)(@@)(@@)(@@) $ 1299 -(@)(@@) محمد بن حرب أبو عبد الله الحمصى الابرش الخولانى روى عن محمد بن الوليد الزبيدى ومحمد بن زياد الالهانى والاوزاعي وعمر بن روبة روى عنه حيوة بن شريح الحمصى ويزيد بن عبد ربه والربيع بن روح وعمرو بن عثمان وهشام بن عمار سمعت أبي يقول ذلك،.(@)(@@) نا عبد الرحمن نا يعقوب بن إسحاق فيما كتب إلى قال أنا عثمان بن سعيد(@)(@@) قال سألت يحيى بن معين قلت محمد بن حرب احب اليك ام بقية بن الوليد؟ فقال ثقة وثقة، نا عبد الرحمن قال سئل ابى عن محمد بن حرب فقال صالح الحديث.(@)(@@)(@@)(@@) $ 1300 -(@)(@@) محمد بن حرب المكى اصله بصرى نزل مكة ومات بها سنة عشر ومائتين ويقال اصله خراساني روى عن مالك والليث بن سعد وابن لهيعة وحزام بن هشام الكعبي روى عنه أبو بشر بكر بن 