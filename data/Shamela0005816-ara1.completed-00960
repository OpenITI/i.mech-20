ms941	 داود الطيالسي وأهل البصرة مات سنة ثلاث وسبعين ومائة(@)(@@)(@@)(@@) $ 7130 - جميع بن عبد المقرإى يروي عن أهل الشام روى عنه عبد الله بن المبارك PageV06P153(@)(@@)(@@)(@@) $ 7131 - جبر بن سعيد بن أبيض بن حمال المأربي يروي عن عبد الله بن جريع بن حمال عن بن عمر في صلاة المسافر روى عنه بن أخيه فرج بن سعيد بن علقمة بن سعيد بن أبيض بن حمال(@)(@@)(@@)(@@) $ 7132 - جرى بن عبد العزيز بن مروان بن الحكم الأموي القرشي يروي عن أخيه زياد بن عبد العزيز روى عنه موسى بن علي بن رباح(@)(@@)(@@)(@@) $ 7133 - جراد بن مجالد الضبي يروي عن رجاء بن حيوة روى عنه شعبة وأبو بكر بن عياش(@)(@@)(@@)(@@) $ 7134 - جراد بن طارق بن شبيط التيمي من أهل البصرة روى PageV06P154 عن أهل بلده روى عنه فيل بن عرادة(@)(@@)(@@)(@@) $ 7135 - جناح النجار المدني مولى ليلى بنت سهيل القرشية يروي عن عائشة بنت سعد بن أبي وقاص روى عنه عمر بن زياد(@)(@@)(@@)(@@) $ 7136 - جندل السدوسي يروي عن شريح روى عنه عبد الله بن شقيق العقيلي(@)(@@)(@@)(@@) $ 7137 - جسر بن الحسن الفزاري شيخ يروي عن نافع روى عنه الأوزاعي وليس هذا بجسر بن فرقد القصاب ذاك ضعيف وهذا صدوق(@)(@@)(@@)(@@) $ 7138 - جواب بن عبيد الله التيمي تيم الرباب الأعور من أهل الكوفة PageV06P155 يروى عن يزيد بن شريك التيمى والد إبراهيم التيمي روى عنه الشيباني ومسعر بن كدام وكان مرجئا(@)(@@)(@@)(@@) $ 7139 - جواب بن عثمان الأسدي يروي عن العراقيين روى عنه إسماعيل بن سالم(@)(@@)(@@)(@@) $ 7140 - جهضم بن عبد الرحمن التيمي يروي عن عكرمة روى عنه المعافى بن عمران وأحسبه جهضما أبا معاذ الذي روى عنه عباد بن العوام(@)(@@)(@@)(@@) $ 7141 - الجارود شيخ من أهل مرو قال سمعت عكرمة يقرأ الر كتب احكمت ايته ثم فصلت قال وسمعته يقول وبرزت الجحيم لمن يرى روى عنه أبو تميلة يحيى بن واضح(@)(@@)(@@)(@@) $ 7142 - جروة بن جميل شيخ يروي عن أبيه عن عمر روى عنه PageV06P156 أهل الكوفة(@)(@@)(@@)(@@) $ 7143 - الجراح بن الضحاك يروي عن كريب الكندي عن علي 
ms942	 بن الحسين روى عنه إسحاق بن سليمان الرازي(@)(@@)(@@)(@@) $ 7144 - جحش بن زياد الضبي من أهل الكوفة يروي عن الأحنف بن قيس روى عنه سفيان الثوري(@)(@@)(@@)(@@) $ 7145 - جعونة شيخ يروي الحكايات عن عمر بن عبد العزيز روى عنه عمرو بن ميمون وأهل الشام(@)(@@)(@@)(@@) $ 7146 - جدار العذري قوله روى عنه حسان بن عطية(@)(@@)(@@)(@@) $ 7147 - جحشة بن علاء يروي عن زفر بن الحارث عن معاوية روى بن المبارك عن رجل عنه PageV06P157(@)(@@)(@@)(@@) $ 7148 - جبرائيل بن أحمر أبو بكر الجملي يروي عن عبد الله بن بريدة روى عنه شريك بن عبد الله النخعي(@)(@@)(@@)(@@) $ 7149 - الجلاح أبو كثير مولى عمر بن عبد العزيز يروي عن حنش الصنعاني عن فضالة بن عبيد أن النبي صلى الله عليه وسلم قال لا تبيعوا الذهب بالذهب إلا وزنا بوزن روى عنه عبيد الله بن أبي جعفر وعمرو بن الحارث(@)(@@)(@@)(@@) $ 7150 - جهير بن يزيد العبدي من عبد القيس بصري كنيته أبو حفص الزاهد يروى عن بن سيرين روى عنه النضر بن ظاهر القيسي(@)(@@)(@@)(@@) $ 7151 - جخدب بن جرعب التيمي يروي عن عطاء بن أبي رباح روى عنه سفيان الثوري PageV06P158(@)(@@)(@@)(@@) $ 7152 - جهور بن سفيان بن الحارث الأزدي أبو الحارث من أهل البصرة يروي عن أبيه روى عنه أهل بلده(@)(@@)(@@)(@@) || (باب الحاء)(@)(@@) قال أبو حاتم رضي الله عنه وممن روى عن التابعين من هذه الطبقة مما ابتدأ اسمه على الحاء(@)(@@)(@@)(@@) $ 7153 - الحسن بن الحسن بن الحسن بن علي بن أبي طالب رضي الله عنهم يروي عن أبيه روى عنه أهل بلده أمه فاطمة بنت الحسين بن علي مات في الحبس بالهاشمية مع أخيه عبد الله بن الحسن(@)(@@)(@@)(@@) $ 7154 - الحسن بن علي بن الحسن بن علي بن أبي طالب رضي الله عنهم الهاشمي من أهل المدينة يروي عن أبيه روى عنه محمد بن أبي سارة PageV06P159(@)(@@)(@@)(@@) $ 7155 - الحسن بن زيد بن الحسن بن علي بن أبي طالب يروي عن أبيه وعكرمة روى عنه مالك بن أنس ومحمد بن إسحاق وأهل المدينة كنيته أبو محمد أمه أم 
ms943	 ولد مات بالحاجر وهو يريد مكة من العراق في السنة التي رجع فيها المهدى سنة ثمان وستين مائة(@)(@@)(@@)(@@) $ 7156 - الحسن بن الفضل بن الحسن بن عمرو بن أمية الضمري من أهل المدينة يروي عن أبيه روى عنه محمد بن إسحاق(@)(@@)(@@)(@@) $ 7157 - الحسن بن عبد الله بن مالك بن الحويرث يروي عن أبيه عن جده روى عنه عمران بن أبان الواسطي(@)(@@)(@@)(@@) $ 7158 - الحسن بن عبيد الله النخعي من أهل الكوفة كنيته أبو عروة يروي عن الشعبي وإبراهيم روى عنه الثوري وابن عيينة مات سنة تسع وثلاثين ومائة وقد قيل سنة اثنتين وأربعين PageV06P160(@)(@@)(@@)(@@) $ 7159 - الحسن بن الحر الكوفي خال حسين بن علي الجعفي يروي عن الشعبي ونافع روى عنه بن عجلان وزهير بن معاوية وقد قيل إنه سمع أبا الطفيل وما أراه بصحيح مات في أول ولاية أبي العباس(@)(@@)(@@)(@@) $ 7160 - الحسن بن أبي الحسناء أبو سهل القواس العنزي من أهل البصرة يروي عن الحسن وأبي العالية روى عنه أبو قتيبة مسلم بن قتيبة وأهل بلده(@)(@@)(@@)(@@) $ 7161 - الحسن بن عبد الله القصاب يروي عن نافع عن بن عمر قال وقت لنا رسول الله صلى الله عليه وسلم في المسح على الخفين يوما وليلة وللمسافر ثلاثة أيام رواه مليح بن وكيع بن الجراح عن أبيه عنه(@)(@@)(@@)(@@) $ 7162 - الحسن بن حصين بن أبي الحر بن الخشخاش العنبري والد عبيد الله بن الحسن الفقيه من أهل البصرة يروي عن سعيد بن جبير وعلي بن حسين روى عنه معاذ بن معاذ العنبري PageV06P161(@)(@@)(@@)(@@) $ 7163 - الحسن بن ثابت الثعلبي كنيته أبو على الأحول يروي عن إسماعيل بن أبي خالد والأعمش عداده في أهل الكوفة روى عنه يحيى بن آدم وهو الحسن أبو على الذي يروي عن أبيه عن جدته عن علي الذي روى عنه الثوري وسويد بن عبد العزيز(@)(@@)(@@)(@@) $ 7164 - الحسن بن حكيم بن الحارث نسيب بن سيرين يروي عن أبيه روى عنه موسى بن إسماعيل(@)(@@)(@@)(@@) $ 7165 - الحسن بن أبي الجعد أبو محمد اليربوعي من أهل البصرة يروي عن 
ms944	 الحسن روى عنه أهل بلده(@)(@@)(@@)(@@) $ 7166 - الحسن بن ثوبان الهاشمي يروي عن موسى بن وردان روى عنه الليث بن سعد ويحيى بن أيوب(@)(@@)(@@)(@@) $ 7167 - الحسن بن عمران أبو عبد الله العسقلاني يروي عن مكحول وعطية بن قيس وابن عبد الرحمن بن أبزى روى عنه شعبة وأهل الشام PageV06P162(@)(@@)(@@)(@@) $ 7168 - الحسن بن حكيم الثقفي كنيته أبو حكيم وأمه مولاة أبي برزة الأسلمي يروي عن أبيه عن أبي برزة روى عنه وكيع بن الجراح(@)(@@)(@@)(@@) $ 7169 - الحسن بن ذكوان المعلم يروي عن عطاء وسليمان الأحول روى عنه بن المبارك(@)(@@)(@@)(@@) $ 7170 - الحسن بن حميد يروي عن أبي سعيد الأسدي صاحب الفساطيط عن سمرة بن جندب روى عنه وهب بن إسماعيل الأسدي(@)(@@)(@@)(@@) $ 7171 - الحسن بن عبد الرحمن شيخ يروي عن كثير بن مرة روى عنه قتادة(@)(@@)(@@)(@@) $ 7172 - الحسن بن الحسين الجحدري من أهل الكوفة يروي عن الأعمش روى عنه يحيى بن المنذر الحجري والد أحمد بن يحيى بن المنذر PageV06P163(@)(@@)(@@)(@@) $ 7173 - الحسن بن سالم بن أبي الجعد الأشجعي مولى غطفان من أهل الكوفة يروي عن نعيم بن أبي هند روى عنه عيسى بن يونس(@)(@@)(@@)(@@) $ 7174 - الحسن بن عبد الرحمن الكاتب من أهل الكوفة يروي عن الشعبي روى عنه عبد الواحد بن زياد وعيسى بن يونس(@)(@@)(@@)(@@) $ 7175 - الحسن بن عميرة يروي عن مسلم بن يسار روى عنه حكام بن سلم الرازي(@)(@@)(@@)(@@) $ 7176 - الحسن بن عمرو الفقيمي من أهل الكوفة أخو فضيل بن عمرو يروي عن إبراهيم النخعي روى عنه سفيان الثوري وأهل الكوفة مات سنة اثنتين وأربعين ومائة(@)(@@)(@@)(@@) $ 7177 - الحسن بن صالح بن حي الهمداني الثوري من أهل الكوفة PageV06P164 كنيته أبو عبد الله يروي عن الشعبي وسماك بن حرب روى عنه أهل الكوفة كان مولده سنة مائة ومات سنة سبع وستين ومائة وهو مختف من القوم وكان فقيها ورعا من المتقشفة الخشن وممن تجرد للعبادة ورفض الرئاسة على تشيع فيه(@)(@@)(@@)(@@) $ 7178 - الحسن بن علي الهزاني من أهل البصرة يروي عن الصهباء بنت كريم عن عائشة روى عنه عبد 
ms945	 الصمد بن عبد الوارث(@)(@@)(@@)(@@) $ 7179 - الحسن بن الفرات بن أبي عبد الرحمن القزاز التميمي من أهل الكوفة يروي عن بن أبي مليكة وأبيه روى عنه وكيع بن الجراح(@)(@@)(@@)(@@) $ 7180 - الحسن بن أبي فاطمة يروي عن الزهري روى عنه معن بن عيسى القزاز PageV06P165(@)(@@)(@@)(@@) $ 7181 - الحسن بن عطاء المدني يروي عن الحسن وأبيه روى عنه موسى بن إسماعيل(@)(@@)(@@)(@@) $ 7182 - الحسن بن ميسرة يروي عن نافع روى عنه الفضل بن موسى السيناني(@)(@@)(@@)(@@) $ 7183 - الحسن بن عقبة أبو كيران كوفي يروي عن الشعبي روى عنه أهل الكوفة(@)(@@)(@@)(@@) $ 7184 - الحسن القردوسي يروي عن الحسن روى عنه عكرمة بن عمار لا أدري من هو ولا بن من هو(@)(@@)(@@)(@@) $ 7185 - الحسن بن كثير شيخ يروي عن عكرمة بن خالد روى عنه عبد الوهاب بن الورد(@)(@@)(@@)(@@) $ 7186 - الحسن بن محمد الأنصاري يروي عن رجل عن صهيب روى عنه عبد الحميد بن جعفر(@)(@@)(@@)(@@) $ 7187 - أبو المليح الرقى اسمه الحسن بن عمرو بن عبد الله بن يحيى PageV06P166 الفزاري كنيته أبو عبد الله مولى فزارة ولقبه أبو المليح مولى لعمر بن هبيرة يروي عن الزهري وميمون بن مهران روى عنه بن المبارك وأهل بلده مات سنة إحدى وثمانين بعد عبيد الله بن عمرو بسنة وكان له يوم مات تسعة وتسعين سنة(@)(@@)(@@)(@@) $ 7188 - الحسن بن كثير الأحمسي البجلي من أهل الكوفة يروي عن أبيه عن علي روى عنه بن المبارك(@)(@@)(@@)(@@) $ 7189 - الحسن بن وهب شيخ يروي عن عطاء روى عنه سفيان الثوري(@)(@@)(@@)(@@) $ 7190 - الحسن بن حاتم الألهاني حمصي يروي عن عمير بن خالد الوهبي عن أنس بن مالك روى عنه أحمد بن إبراهيم اليحصبي(@)(@@)(@@)(@@) $ 7191 - الحسن بن مسلم بن يناق المكي يروي عن مجاهد وطاوس روى عنه بن أبي نجيح وابن جريج يقال إنه مات قبل طاوس وقد سمع شعبة من مسلم بن يناق ولم يسمع من ابنه الحسن لأن الحسن مات قبل أبيه(@)(@@)(@@)(@@) $ 7192 - الحسن بن محمد المروزي يروي عن عبد الله بن بريدة روى عنه نعيم بن حماد المروزي PageV06P167(@)(@@)(@@)(@@) $ 7193 
ms946	 - الحسن بن همام شيخ من أهل الشام يروي عن سعيد بن زرعة روى عنه محمد بن الوليد الزبيدي(@)(@@)(@@)(@@) $ 7194 - الحسن بن رستم من أهل أيلة يروي عن جماعة من التابعين روى عنه أهل الشام والحجاز(@)(@@)(@@)(@@) $ 7195 - الحسن بن مسلم الهذلي يروي عن مكحول روى عنه شعبة إن لم يكن بن عمران فلا أدري من هو(@)(@@)(@@)(@@) $ 7196 - الحسن بن شقيق بن محمد بن دينار بن مشعب العبدي من أنفسهم من أهل مرو وقال رأيت عبد الله بن بريدة يبول في الماء الجاري روى عنه ابنه علي بن الحسن بن شقيق صاحب بن المبارك PageV06P168(@)(@@)(@@)(@@) $ 7197 - الحسن بن عياش أخو أبي بكر بن عياش يروي عن جعفر بن محمد روى عنه يحيى بن آدم والكوفيون(@)(@@)(@@)(@@) $ 7198 - الحسن بن الأعمش القاضي يروي عن يحيى بن سعيد الأنصاري روى عنه سعيد بن جناح الزاهد النجاري(@)(@@)(@@)(@@) $ 7199 - الحسن بن وقاص الأنصاري يروي عن أبيه ومولاته عن عائشة روى عنه أبو معشر البراء(@)(@@)(@@)(@@) $ 7200 - أبو يونس القوي اسمه الحسن بن يزيد الضمري يروي عن سعيد بن جبير وأبي سلمة ومجاهد روى عنه الثوري وإنما سمي أبو يونس القوي لقوته على العبادة وذلك أنه قدم مكة فطاف في يوم واحد سبعين أسبوعا فسمي القوي وكان من عباد أهل الكوفة وقرائهم(@)(@@)(@@)(@@) $ 7201 - الحسن بن أبي يزيد الهمداني من أهل الكوفة يروي عن الشعبي روى عنه وكيع ومالك بن إسماعيل PageV06P169(@)(@@)(@@)(@@) $ 7202 - الحسن بن عطية العوفي يروي عن أبيه روى عنه ابنه الحسين بن الحسن وأحاديث الحسن بن عطية ليست بنقية(@)(@@)(@@)(@@) $ 7203 - الحسن بن يزيد الأصم القرشي أبو على يروي عن السدي روى عنه أهل العراق(@)(@@)(@@)(@@) $ 7204 - الحسن العبدي شيخ يروي عن زيد بن وهب روى عنه ليث بن أبي سليم(@)(@@)(@@)(@@) $ 7205 - الحسن أبو عبد الله شيخ يروي المراسيل روى عنه أيوب بن النجار لا أدرى من هو ولا بن من هو(@)(@@)(@@)(@@) $ 7206 - الحارث بن نوفل بن عروة بن المغيرة بن شعبة من أشراف أهل الكوفة روى عن الشعبي روى عنه 
ms947	 بن عيينة(@)(@@)(@@)(@@) $ 7207 - الحارث بن يزيد العكلي من أهل الكوفة يروي عن الشعبي والنخعي روى عنه المغيرة بن مقسم PageV06P170(@)(@@)(@@)(@@) $ 7208 - الحارث بن يزيد الحضرمي من أهل مصر يروي عن علي بن رباح اللخمي روى عنه يحيى بن سعيد الأنصاري(@)(@@)(@@)(@@) $ 7209 - الحارث بن أبي بكر بن عبد الرحمن بن الحارث بن هشام المخزومي المدني يروي عن أبيه روى عنه بن إسحاق(@)(@@)(@@)(@@) $ 7210 - الحارث بن عبد الملك شيخ يروي عن نافع بن جبير بن مطعم عن أبي هريرة روى عنه بن جريج(@)(@@)(@@)(@@) $ 7211 - الحارث بن عمير أبو الجودى من أهل الشام يروي عن أهل بلده روى عنه شعبة وأبو عوانة(@)(@@)(@@)(@@) $ 7212 - الحارث بن عبيد الله الأنصاري من أهل الشام يروي عن أم الدرداء روى عنه الوليد بن مسلم(@)(@@)(@@)(@@) $ 7213 - الحارث بن النعمان الفراسي يروي المراسيل روى عنه نوح بن قيس الطاحى PageV06P171(@)(@@)(@@)(@@) $ 7214 - الحارث بن عبد الرحمن بن المغيرة بن أبي ذباب الدوسي من أهل المدينة يروي عن أبي سلمة وعطاء بن ميناء كان ينزل الأعوص بالمدينة روى عنه صفوان بن عيسى ومحمد بن إسحاق وأهل المدينة مات سنة ست وأربعين ومائة(@)(@@)(@@)(@@) $ 7215 - الحارث بن عبد الرحمن خال بن أبي ذئب من أهل المدينة يروي عن محمد بن جبير بن مطعم روى عنه بن أبي ذئب مات سنة تسع وعشرين ومائة كنيته أبو عبد الرحمن وأمه أم ولد ولم يرو عنه إلا بن أبي ذئب وهو من قريش(@)(@@)(@@)(@@) $ 7216 - الحارث بن الحكم الضمري يروي عن أبي عمرو بن حماس عداده في أهل المدينة روى عنه بن أبي ذئب(@)(@@)(@@)(@@) $ 7217 - الحارث بن رحيل يروي عن أبيه روى عنه عبد الملك بن الحارث(@)(@@)(@@)(@@) $ 7218 - الحارث بن يعقوب المصري والد عمرو بن الحارث يروي عن جماعة من التابعين روى عنه ابنه عمرو بن الحارث PageV06P172(@)(@@)(@@)(@@) $ 7219 - الحارث بن عمرو بن أخي المغيرة بن شعبة يروي عن أصحاب معاذ روى عنه أبو عون الثقفي(@)(@@)(@@)(@@) $ 7220 - الحارث بن حصيرة من أهل الكوفة يروي عن زيد بن وهب وعكرمة روى 
ms948	 عنه أهل بلده وعبد الواحد بن زياد(@)(@@)(@@)(@@) $ 7221 - الحارث بن شبيل من أهل الكوفة يروي عن أبي عمرو الشيباني عن زيد بن أرقم روى عنه إسماعيل بن أبي خالد(@)(@@)(@@)(@@) $ 7222 - الحارث بن أنعم يروي عن شرحبيل بن أيمن روى عنه زهير بن معاوية(@)(@@)(@@)(@@) $ 7223 - الحارث الأزدي شيخ يروى عن بن الحنفية روى عنه سفيان الثوري(@)(@@)(@@)(@@) $ 7224 - الحارث بن بدل النصري يروي عن عمرو بن سفيان عن رجل شهد النبي صلى الله عليه وسلم روى عنه محمد بن عبد الله الشعيثي(@)(@@)(@@)(@@) $ 7225 - الحارث بن ثقف يروي عن الحسن روى عنه يحيى بن PageV06P173 يمان العجلي(@)(@@)(@@)(@@) $ 7226 - الحارث بن الجارود يروي عن إبراهيم النخعي روى عنه أبو عوانة(@)(@@)(@@)(@@) $ 7227 - الحارث بن عبيد مكي يروي عن محمد بن عبد الملك بن أبي محذورة عن أبيه عبد الملك روى عنه مسدد(@)(@@)(@@)(@@) $ 7228 - الحارث بن سليمان الكندي يروي عن كردوس بن عباس التغلبي روى عنه وكيع وطلق بن غنام والكوفيون(@)(@@)(@@)(@@) $ 7229 - الحارث بن شبل يروي عن أم النعمان عن عائشة روى عنه شاذ بن الفياض اسمه هلال ولقبه شاذ(@)(@@)(@@)(@@) $ 7230 - الحارث بن عتبة الحمصي يروي عن عبد الرحمن بن سلم PageV06P174 روى عنه الوليد بن مسلم(@)(@@)(@@)(@@) $ 7231 - الحارث بن عنبسة وقيل عتبة يروي عن عمر بن عبد العزيز روى عنه صدقة بن عبيد الله(@)(@@)(@@)(@@) $ 7232 - الحارث بن عبد الرحمن يروي عن أبي الجلاس عن علي روى عنه هارون بن صالح(@)(@@)(@@)(@@) $ 7233 - الحارث بن غسان المزني يروي عن أبي عمران الجوني روى عنه عبد الله بن عبد الوهاب الحجبي(@)(@@)(@@)(@@) $ 7234 - الحارث بن فضيل الأنصاري الخطمي من أهل المدينة كنيته أبو عبد الله يروي عن سفيان بن أبي العوجاء روى عنه محمد بن إسحاق وابنه عبد الله بن الحارث(@)(@@)(@@)(@@) $ 7235 - الحارث بن قيس يروي عن أزهر الحرازي روى ثور بن يزيد عن أبي عون عنه PageV06P175(@)(@@)(@@)(@@) $ 7236 - الحارث بن مسلم بن الحارث التميمي يروي عن أبيه روى عنه عبد الرحمن بن حسان(@)(@@)(@@)(@@) $ 7237 - الحارث بن أبي منصور يروي عن مجاهد 
ms949	 روى عنه موسى الصغير(@)(@@)(@@)(@@) $ 7238 - الحارث بن يزيد السكوني من أهل حمص يروي عن عمرو بن قيس روى عنه الوليد بن مسلم والوليد بن قحذم بن سليمان(@)(@@)(@@)(@@) $ 7239 - الحارث بن عبيدة المصري كنيته أبو وهب الساوي يروي عن هشام بن عروة وأهل بلده روى عنه عمرو بن عثمان الحمصي وأهل مصر مات في ذي القعدة سنة ست وثمانين ومائة وهو الذي يقال له الحارث بن عميرة الكلاعي عداده في أهل الشام سكن مصر(@)(@@)(@@)(@@) $ 7240 - الحارث بن مقسم يروي المراسيل روى عنه الحكم بن أبان(@)(@@)(@@)(@@) $ 7241 - الحارث بن منقذ من أهل البصرة يروي عن الحسن وابن سيرين روى عنه حماد بن سلمة PageV06P176(@)(@@)(@@)(@@) $ 7242 - أبو العنبس الذي روى عنه مسعر بن كدام عن أبي العدبس واسم أبي العنبس الحارث واسم أبي العدبس منيع ومدار ما روياه عن أبي غالب وهو لا شيء(@)(@@)(@@)(@@) $ 7243 - حبيب بن هند بن أسماء بن هند بن حارثة الأسلمي يروي عن أبيه وعروة بن الزبير روى عنه عبد الله بن أبي بكر وأهل المدينة(@)(@@)(@@)(@@) $ 7244 - حبيب بن أبي عمرة القصاب كنيته أبو عبد الله من أهل الكوفة يروي عن سعيد بن جبير روى عنه الثوري مات سنة اثنتين وأربعين ومائة PageV06P177(@)(@@)(@@)(@@) $ 7245 - حبيب بن النعمان يروي عن عمرو بن راشد روى عنه عمرو بن دينار(@)(@@)(@@)(@@) $ 7246 - حبيب بن قيس روى عن بن أبي محذورة عن أبيه روى عنه سليمان التيمى(@)(@@)(@@)(@@) $ 7247 - حبيب الأعور يروي عن عروة بن الزبير روى عنه الزهري إن لم يكن بن هند بن أسماء فلا أدري من هو(@)(@@)(@@)(@@) $ 7248 - حبيب بن أبي حبيب الجرمي صاحب الأنماط من أهل البصرة يروي عن الحسن وابن سيرين وهو جد عبد الرحمن بن محمد بن حبيب بن أبي حبيب الذي روى عنه قتيبة بن سعيد حديث قتل الجعد بن درهم روى عنه موسى بن إسماعيل(@)(@@)(@@)(@@) $ 7249 - حبيب بن أبي جبيرة عن يعلى بن سيابة روى عنه عاصم بن أبي النجود(@)(@@)(@@)(@@) $ 7250 - حبيب بن جرى النهدي من أهل الكوفة يروي 
ms950	 عن أبى جعفر PageV06P178 محمد بن علي روى عنه أهل العراق وأحسبه بن جرى بن كليب(@)(@@)(@@)(@@) $ 7251 - حبيب بن أبي جزيرة يروي عن جدته روى عنه مسلم بن إبراهيم والتبوذكي ومن زعم أنه حبيب بن أبي جرير فقد وهم(@)(@@)(@@)(@@) $ 7252 - حبيب أبو الأشعث شيخ يروي عن بن سيرين روى عنه همام بن يحيى(@)(@@)(@@)(@@) $ 7253 - حبيب بن حجر شيخ يروي عن ثابت البناني روى عنه روح بن عبادة(@)(@@)(@@)(@@) $ 7254 - حبيب مولى حبة بنت المطلب يروي عن جده روى عنه عمار بن أبي عمار PageV06P179(@)(@@)(@@)(@@) $ 7255 - حبيب بن سليم الرقى يروي عن شريح روى عنه الشيباني والأعمش(@)(@@)(@@)(@@) $ 7256 - حبيب بن شهاب العنبري من أهل البصرة يروي عن أبيه روى عنه يحيى القطان(@)(@@)(@@)(@@) $ 7257 - حبيب مولى عروة بن الزبير يروي عن عروة روى عنه أهل المدينة مات في ولاية مروان بن محمد يخطىء(@)(@@)(@@)(@@) $ 7258 - حبيب بن عيسى أبو محمد العجمي أصله من فارس سكن البصرة يروي عن الحسن قال الأواه الذي قلبه معلق عند الله روى عن أهل البصرة وكان عابدا فاضلا ورعا تقيا من المجابين الدعوة في الأوقات أخباره في التقشف والعبادة مشهورة يغنى عن الإغراق في ذكرها حدثني عمر بن محمد الهمداني ثنا زكريا بن يحيى الوقار قال ثنا الخصيب بن ناصح الحارثي عن صالح المري عن حبيب أبي محمد الفارسي عن الفرزدق قال لقيت أبا هريرة PageV06P180 بالشام فقال لي أنت الفرزدق الشاعر قلت نعم قال أما إنه إن طال بك عمر ستلقى أقواما يقولون لا توبة لك فلا يقطعن رجاءك من الله(@)(@@)(@@)(@@) $ 7259 - حبيب أبو الحسن يروي عن أبي البختري روى عنه عمرو بن حسين(@)(@@)(@@)(@@) $ 7260 - حبيب بن سيارة شيخ يروي المراسيل روى عنه سليمان الأعمش(@)(@@)(@@)(@@) $ 7261 - حبيب بن خالد الأسدي يروي عن أبي إسحاق السبيعي روى عنه محمد بن مقاتل المروزي(@)(@@)(@@)(@@) $ 7262 - حبيب بن زيد الأنصاري يروي عن عباد بن تميم روى عنه شعبة بن الحجاج(@)(@@)(@@)(@@) $ 7263 - حبيب بن الزبير مولى لبني هلال يروي عن عبد الله بن أبي الهذيل وعكرمة 
ms951	 روى عنه شعبة وأهل العراق PageV06P181(@)(@@)(@@)(@@) $ 7264 - حبيب بن سليم العبسي من أهل الكوفة يروى عن بلال بن يحيى روى عنه عبد الله بن موسى وأبو نعيم(@)(@@)(@@)(@@) $ 7265 - حبيب بن سليم الباهلي أبو محمد من أهل البصرة يروي عن بكر بن عبد الله المزني روى عنه المعتمر بن سليمان(@)(@@)(@@)(@@) $ 7266 - حبيب بن سندر يروي عن عبد الله بن ضمعج روى عنه خالد بن يزيد(@)(@@)(@@)(@@) $ 7267 - حبيب بن الشهيد مولى الأزد كنيته أبو شهيد ويقال أبو مرزوق وقد قيل أبو محمد يروي عن الحسن وابن سيرين روى عنه أهل العراق مات سنة خمس وأربعين ومائة في آخرها بعد الهزيمة وصلى عليه سوار وذلك في أوسط أيام التشريق(@)(@@)(@@)(@@) $ 7268 - حبيب بن صالح الطائي يروي عن يزيد بن شريح كنيته PageV06P182 أبو موسى عداده في أهل الشام روى عنه حريز بن عثمان(@)(@@)(@@)(@@) $ 7269 - حبيب بن عمر الأنصاري المدني روى عن أبيه روى عنه بقية بن الوليد(@)(@@)(@@)(@@) $ 7270 - حبيب بن أبي قريبة أبو محمد المعلم يروي عن عطاء وابن سيرين روى عنه يزيد بن زريع والحمادان مات سنة ثلاثين ومائة(@)(@@)(@@)(@@) $ 7271 - حبيب القناد شيخ من أهل البصرة يروي عن أهل بلده روى عنه أيوب السختياني(@)(@@)(@@)(@@) $ 7272 - حبيب بن عمرو يروي عن أبي جعفر روى عنه قتادة وقد قيل عمرو بن حبيب(@)(@@)(@@)(@@) $ 7273 - حبيب أبو عمر يروي عن امرأة عن عائشة روى عنه عثمان بن عمر بن فارس PageV06P183(@)(@@)(@@)(@@) $ 7274 - حبيب بن عائذ الكوفي والد عائذ بن حبيب يروي عن أهل العراق روى عنه أهل بلده(@)(@@)(@@)(@@) $ 7275 - حبيب بن عيسى يروي عن مكحول عداده في أهل مصر روى عنه سعيد بن أبي أيوب(@)(@@)(@@)(@@) $ 7276 - حبيب بن أبي العالية يروي المراسيل روى عنه يحيى بن سعيد القطان(@)(@@)(@@)(@@) $ 7277 - حبيب بن أبي مرزوق مولى بني أسد يروي عن نافع روى عنه جعفر بن برقان مات سنة ثمان وثلاثين ومائة(@)(@@)(@@)(@@) $ 7278 - حبيب بن مهاجر يروي عن عطاء روى عنه منصور بن زاذان(@)(@@)(@@)(@@) $ 7279 - حبيب بن نجيح يروي عن عبد الرحمن بن 
ms952	 غنم روى عنه الجراح بن المنهال(@)(@@)(@@)(@@) $ 7280 - حبيب بن هارون يروي عن زيد بن أسلم روى عنه سليمان التيمي(@)(@@)(@@)(@@) $ 7281 - حبيب شيخ يروي عن مورق العجلي روى عنه قتادة PageV06P184(@)(@@)(@@)(@@) $ 7282 - الحكم بن سنان بن سلمة بن المحبق الهذلي عداده في أهل البصرة يروي المقاطيع روى عنه أبو عاصم عن ابنه حفص بن الحكم عنه(@)(@@)(@@)(@@) $ 7283 - الحكم بن أبي إسحاق يروي عن بن المسيب والحسن وأبي سلمة روى عنه أبو هلال الراسبي(@)(@@)(@@)(@@) $ 7284 - الحكم بن المطلب بن عبد الله بن حنطب المخزومي القرشي من أهل المدينة يروي عن أبيه روى عنه أخوه عبد العزيز بن المطلب(@)(@@)(@@)(@@) $ 7285 - الحكم بن الصلت المؤذن من أهل المدينة يروي عن أبيه عن أبي هريرة روى عنه عبد الملك بن المغيرة والقعنبي(@)(@@)(@@)(@@) $ 7286 - الحكم بن جحل الأزدي من أهل البصرة يروي عن عطاء روى عنه ديلم بن غزوان وأبو عاصم العباداني(@)(@@)(@@)(@@) $ 7287 - الحكم بن مسلم بن الحكم السالمي يروي عن الأعرج روى عنه بن أبي ذئب(@)(@@)(@@)(@@) $ 7288 - الحكم بن أبان المدني سكن اليمن كنيته أبو عيسى يروى PageV06P185 عن طاوس وعكرمة روى عنه بن جريج ويزيد بن أبي حكيم مات سنة أربع وخمسين ومائة وهو بن أربع وثمانين سنة وربما أخطأ وإنما وقع المناكير في روايته من رواية ابنه إبراهيم بن الحكم عنه وإبراهيم ضعيف(@)(@@)(@@)(@@) $ 7289 - الحكم بن أبي الصلت المخزومي كنيته أبو محمد من أهل المدينة يروي عن أبيه قال رأيت عثمان بن عفان يخطب على المنبر مخضوب الرأس بالحمرة روى عنه يونس بن محمد المؤدب(@)(@@)(@@)(@@) $ 7290 - الحكم بن عبد الله البصري يروي عن الحسن روى عنه الثوري وابن عيينة(@)(@@)(@@)(@@) $ 7291 - الحكم بن الأعرج يروي عن الأشعث بن ثرملة عن أبي بكرة روى عنه يونس بن عبيد PageV06P186(@)(@@)(@@)(@@) $ 7292 - الحكم بن فروخ أبو بكار الغزال بصري يروي عن عكرمة روى عنه حماد بن زيد ويحيى بن سعيد القطان(@)(@@)(@@)(@@) $ 7293 - الحكم بن مسلمة السعدي يروي عن عمر بن نصر روى عنه جرير بن عبد الحميد(@)(@@)(@@)(@@) $ 7294 - الحكم بن 
ms953	 عبد الرحمن بن أبي نعم البجلي يروي عن أبيه روى عنه أبو نعيم الفضل بن دكين وأهل الكوفة(@)(@@)(@@)(@@) $ 7295 - الحكم بن مصعب القرشي يروي عن محمد بن علي بن عبد الله بن عباس روى عنه الوليد بن مسلم يخطىء(@)(@@)(@@)(@@) $ 7296 - الحكم بن هشام الثقفي من أهل الكوفة يروي عن عبد الملك بن عمير وقتادة روى عنه يحيى بن اليمان(@)(@@)(@@)(@@) $ 7297 - الحكم بن الخزرج يروي عن جدته عن أبي موسى روى عنه حجاج بن المنهال وموسى بن إسماعيل(@)(@@)(@@)(@@) $ 7298 - الحكم الثقفي يروي عن عمرو بن خالد عن أنس روى عنه PageV06P187 عكرمة بن عمار(@)(@@)(@@)(@@) $ 7299 - الحكم أبو سعيد يروي عن رجل من أهل الشام روى عنه هشام الدستوائي(@)(@@)(@@)(@@) $ 7300 - الحكم بن أبي خالد المكي مولى فزارة يروي عن عمر بن أبي ليلى عن الحسن بن علي روى عنه عبد الله بن المبارك(@)(@@)(@@)(@@) $ 7301 - الحكم بن دينار القرشي يروي عن عمرو بن دينار عن بن الزبير روى عنه الفضل بن موسى الشيباني(@)(@@)(@@)(@@) $ 7302 - حميد بن نافع من أهل المدينة يروي عن زيد بن أسلم روى عنه يحيى بن سعيد الأنصاري وأيوب بن موسى وليس هذا بحميد صفيرا ذاك تابعي يروى عن بن عمر وقد ذكرناه في كتاب التابعين(@)(@@)(@@)(@@) $ 7303 - حميد بن زياد أبو صخر الخراط من أهل المدينة مولى بنى PageV06P188 هاشم يروي عن نافع ومحمد بن كعب روى عنه حيوة بن شريح وهو الذي يروي عنه حاتم بن إسماعيل ويقول حميد بن صخر وإنما هو حميد بن زياد أبو صخر لا حميد بن صخر(@)(@@)(@@)(@@) $ 7304 - حميد الأوزاعي شيخ يروي المراسيل روى عنه شعبة بن الحجاج(@)(@@)(@@)(@@) $ 7305 - حميد الفزاري شيخ يروي المراسيل روى عنه عمرو بن مرة(@)(@@)(@@)(@@) $ 7306 - حميد بن يعقوب بن يسار المدني يروي عن سعيد بن المسيب روى عنه بن إسحاق وأتاه بن عيينة وهو مريض(@)(@@)(@@)(@@) $ 7307 - حميد بن قيس الأعرج من أهل مكة مولى بني أسد بن عبد العزى القرشي كنيته أبو صفوان يروي عن عطاء ومجاهد والزهري روى عنه الثوري 
ms954	 ومالك والناس وهو أخو عمر بن قيس سندل مات بمكة سنة ثلاثين ومائة(@)(@@)(@@)(@@) $ 7308 - حميد بن عبيد الأنصاري يروي عن أبيه عن عمر روى عنه PageV06P189 ابنه عبد الرحمن بن حميد(@)(@@)(@@)(@@) $ 7309 - حميد بن أبي حكيم الأعرج من أهل مرو يروي عن يحيى بن يعمر روى عنه بن المبارك وأبو تميلة(@)(@@)(@@)(@@) $ 7310 - حميد بن الأسود أبو الأسود يروي عن هشام بن عروة وهو جد أبي بكر بن أبي الأسود روى عنه أهل البصرة(@)(@@)(@@)(@@) $ 7311 - حميد بن علي الرقاشي يروي عن عمران بن حيان الأنصاري عن أبيه روى عنه أهل البصرة(@)(@@)(@@)(@@) $ 7312 - حميد بن مسلم القرشي من أهل دمشق كنيته أبو عبد الله يروي عن مكحول روى عنه سعيد بن أبي أيوب(@)(@@)(@@)(@@) $ 7313 - حميد بن طرخان يروي عن عبد الله بن شقيق روى عنه حماد بن زيد PageV06P190(@)(@@)(@@)(@@) $ 7314 - حميد بن مهران الخياط وهو حميد بن أبي حميد الكندي المالكي كنيته أبو عبد الله يروى عن بن سيرين وقتادة روى عنه أبو داود الطيالسي ومسلم بن إبراهيم(@)(@@)(@@)(@@) $ 7315 - حميد بن أبي حميد الخياط بصري يروي عن الحسن روى عنه مرزوق بن ميمون الناجي(@)(@@)(@@)(@@) $ 7316 - حميد بن بكر يروي عن محمد بن كعب القرظي روى عنه يزيد بن خصيفة يعتبر بحديثه إذا لم يكن في إسناده إنسان ضعيف(@)(@@)(@@)(@@) $ 7317 - حميد بن زياد اليمامي يروي عن عبد العزيز بن اليمان أخي حذيفة عن حذيفة لتركبن سنن من قبلكم حذو النعل بالنعل رواه موسى بن إسماعيل عن أبي عبد الله صاحب الصدقة عن حميد(@)(@@)(@@)(@@) $ 7318 - حميد أبو سفيان يروي عن مسلم بن أبي بكرة عن أبي بكرة روى عنه أبو بحر البكراوي(@)(@@)(@@)(@@) $ 7319 - حميد أبو عبد الله العبدي يروي عن خالد الربعي عن أبي هريرة PageV06P191 أوصانى خليلي بثلاث روى عنه محمد بن بكر البرساني(@)(@@)(@@)(@@) $ 7320 - حميد بن عبد الله الأصم من أهل الكوفة يروي عن الوليد بن عتبة عن علي روى عنه محمد بن بشر العبدي(@)(@@)(@@)(@@) $ 7321 - حميد بن عبد الله يروي عن عبد الرحمن بن 
ms955	 أبي عوف الجرشي روى عنه الزبيدي وصفوان بن عمرو(@)(@@)(@@)(@@) $ 7322 - حميد أبو المليح الفارسي سكن المدينة يروي عن أبي صالح عن أبي هريرة روى عنه وكيع بن الجراح وأبو عاصم النبيل(@)(@@)(@@)(@@) $ 7323 - حميد مولى بني عجل يروي عن إبراهيم النخعي روى عنه عمارة بن القعقاع(@)(@@)(@@)(@@) $ 7324 - حميد الكندي شيخ يروي عن عبادة بن نسي روى عنه أبو بكر بن عياش PageV06P192(@)(@@)(@@)(@@) $ 7325 - حميد بن سويد أبو سويد من أهل مصر يروي عن عبد الرحمن بن حجيرة روى عنه عمرو بن الحارث المصري ومن قال أبو سوية فقد وهم(@)(@@)(@@)(@@) $ 7326 - حميد بن أبي غنية الأصبهاني سكن الكوفة والد عبد الملك بن حميد بن أبي غنية يروي المراسيل روى عنه سفيان بن عيينة(@)(@@)(@@)(@@) $ 7327 - حميد بن جابر الراسبي من أهل البصرة يروي عن كبشة بنت طهمان روى عنه التبوذكي(@)(@@)(@@)(@@) $ 7328 - حميد بن حبان بن أبي زيد الجعفري من أهل الحجاز يروي عن سالم بن عبد الله روى عنه بن عيينة(@)(@@)(@@)(@@) $ 7329 - حميد بن أبي الصعبة يروي عن عبد الله بن زرير الغافقي عن PageV06P193 علي روى عنه عمارة بن غزية وأهل مصر(@)(@@)(@@)(@@) $ 7330 - حميد بن عبد الرحمن بن حميد الرؤاسي من أهل الكوفة كنيته أبو عوف يروي عن إسماعيل بن أبي خالد روى عنه قتيبة بن سعيد ومحمد بن سلام البيكندي وأهل بلده مات في آخر سنة تسع وثمانين ومائة وقد قيل سنة ثنتين وتسعين ومائة سمعت عمر بن حفص البزاز يقول سمعت محمد بن زياد الزيادي يقول سمعت سفيان بن عيينة يقول قدم حميد الرؤاسي من سفر فرأى أمه تصلى فلما رآها قائمة تصلى قام فلما فطنت طولت الصلاة لتؤجر(@)(@@)(@@)(@@) $ 7331 - حفص بن عمر بن سعد بن أبي وقاص الزهري القرشي من أهل العراق يروي عن أبيه روى عنه أهل العراق قتله المختار بن أبي عبيد مع أبيه عمر بن سعد PageV06P194(@)(@@)(@@)(@@) $ 7332 - حفص بن سليمان البصري المنقري يروي عن الحسن روى عنه حماد بن زيد مات سنة ثلاثين ومائة قبل الطاعون بقليل وليس 
ms956	 هذا بحفص بن سليمان البزاز أبو عمر القاري ذاك ضعيف وهذا ثبت(@)(@@)(@@)(@@) $ 7333 - حفص بن الفرافصة يروي عن عروة بن الزبير روى عنه يحيى بن أبي كثير(@)(@@)(@@)(@@) $ 7334 - حفص بن عبد الله بن صيفي يروي عن عبد الرحمن بن المطلب بن أبي وداعة عن أبيه وهو أخو يحيى بن عبد الله بن صيفي روى عنه أهل الحجاز السائب بن عمر المخزومي وغيره(@)(@@)(@@)(@@) $ 7335 - حفص بن أبي الصعبة يروي عن سعيد بن جبير روى عنه عبيدة بن حسان(@)(@@)(@@)(@@) $ 7336 - حفص بن جابر يروي عن القاسم بن محمد روى عنه عكرمة بن عمارة(@)(@@)(@@)(@@) $ 7337 - حفص بن عامر يروي عن سعيد بن المسيب روى عنه واصل PageV06P195(@)(@@)(@@)(@@) $ 7338 - حفص بن عمر بن ذكوان كان نازلا في الأنصار بالمدينة يروي عن سالم بن عبد الله روى عنه بكير بن عبد الله بن الأشج(@)(@@)(@@)(@@) $ 7339 - حفص بن حميد يروي عن عكرمة روى عنه يعقوب القمي(@)(@@)(@@)(@@) $ 7340 - حفص بن عثمان بن محمد بن عرادة يروي عن عكرمة روى عنه أبو عقيل(@)(@@)(@@)(@@) $ 7341 - حفص بن خالد بن جابر يروي عن أبيه روى عنه سكين بن عبد العزيز(@)(@@)(@@)(@@) $ 7342 - حفص بن خرزاذ يروي عن الحر بن الصباح روى عنه إبراهيم بن طهمان(@)(@@)(@@)(@@) $ 7343 - حفص بن قيس يروي عن نافع عن بن عمر روى عنه شبابة بن سوار قال حدثنا مكحول بيروت قال ثنا الحسن بن أبي أمية الأنماطي قال ثنا شبابة بن سوار قال PageV06P196 ثنا حفص بن قيس عن نافع عن بن عمر قال قال رسول الله صلى الله عليه وسلم لا يحل لامرىء مسلم أن يبيت ليلتين وعنده شيء يوصي فيه إلا ووصيته مكتوبة عند رأسه(@)(@@)(@@)(@@) $ 7344 - حفص بن سليمان الأزدي يروي المراسيل روى عنه خليد بن حسان(@)(@@)(@@)(@@) $ 7345 - حفص بن عمر يروي عن رجل من آل زيد بن الخطاب عن حفصة روى عنه أرطأة بن المنذر(@)(@@)(@@)(@@) $ 7346 - حفص بن عمر بن عبد الرحمن بن عوف مدني يروي عن عمر بن عبد الرحمن بن عوف روى عنه يوسف 
ms957	 بن الحكم(@)(@@)(@@)(@@) $ 7347 - حفص شيخ يروي عن أبي رافع عن أبي بكر روى عنه موسى بن أبي عائشة PageV06P197(@)(@@)(@@)(@@) $ 7348 - حفص بن عمر بن كيسان الصنعاني وهو الذي يقال له حفص بن عمر بن أبي يزيد يروي عن أبي الزبير روى عنه ابن أخيه عبد الله بن إبراهيم بن عمر بن كيسان(@)(@@)(@@)(@@) $ 7349 - حفص بن غيلان الهمداني أبو معيد الشامي من أهل دمشق يروي عن مكحول ونافع روى عنه الوضين بن عطاء وأهل بلده(@)(@@)(@@)(@@) $ 7350 - حفص بن عمر الأنصاري الحلبي من أهل الشام يروي عن خالد بن معدان روى عنه ابنه أبو سعيد بن حفص(@)(@@)(@@)(@@) $ 7351 - حفص بن المعتمر ويقال بن أبي المعتمر يروي عن التابعين روى عنه زيد بن الحباب(@)(@@)(@@)(@@) $ 7352 - حفص بن أبي منصور أبو الخطاب يروي عن الشعبي روى عنه عيسى بن يونس ووكيع بن الجراح(@)(@@)(@@)(@@) $ 7353 - حفص بن أبي حفص السراج يروي عن شهر بن حوشب PageV06P198 روى عنه العقدي وأبو الوليد وهو الذي يقال له حفص التميمي(@)(@@)(@@)(@@) $ 7354 - حفص بن الوليد الحضرمي من أهل مصر يروي عن الزهري روى عنه الليث بن سعد ويزيد بن أبي حبيب(@)(@@)(@@)(@@) $ 7355 - حفص بن سعيد القرشي شيخ يروي عن جدته روى عنه أبو نعيم الفضل بن دكين(@)(@@)(@@)(@@) $ 7356 - حفص بن ميمون يروي عن الشعبي روى عنه مروان بن معاوية الفزاري(@)(@@)(@@)(@@) $ 7357 - حفص بن خشخاش رجل من بني ربيعة يروي عن عطاء روى عنه محمد بن حمران البصري(@)(@@)(@@)(@@) $ 7358 - حفص بن أبي زينب يروي عن أبي جعفر محمد بن علي روى عنه مروان بن معاوية الفزاري(@)(@@)(@@)(@@) $ 7359 - حفص بن صبيح يروي عن أبي سعيد روى عنه محمد بن الفضيل بن غزوان(@)(@@)(@@)(@@) $ 7360 - حفص بن أبي الصهباء شيخ يروي عن أبي غالب عن أبي أمامة روى عنه المعلى بن أسد PageV06P199(@)(@@)(@@)(@@) $ 7361 - حفص بن خالد الأحمسي من أهل الكوفة كنيته أبو محمد يروي عن إسماعيل بن أبي خالد روى عنه محمد بن سلام البيكندي مات سنة إحدى وثمانين ومائة(@)(@@)(@@)(@@) $ 7362 - حفص الطائفي قوله روى 
ms958	 عنه سفيان الثوري(@)(@@)(@@)(@@) $ 7363 - حفص بن ميسرة أبو عمر الصنعاني من صنعاء الشام يروي عن زيد بن أسلم روى عنه سويد بن سعيد الأنباري ومخلد بن مالك(@)(@@)(@@)(@@) $ 7364 - حفص بن غياث بن طلق بن معاوية أبو عمر النخعي قاضي الكوفة يروي عن إسماعيل بن أبي خالد والأعمش روى عنه ابنه عمر بن حفص وأهل العراق مات سنة خمس أو ست وتسعين ومائة في عشر ذي الحجة PageV06P200(@)(@@)(@@)(@@) $ 7365 - حجاج بن أبي عيينة المهلبي أخو محمد بن أبي عيينة من أهل البصرة يروي عن جابر بن زيد وهند بنت المهلب روى عنه حماد بن زيد وسعيد بن عامر(@)(@@)(@@)(@@) $ 7366 - حجاج بن مهاجر يروي عن شيخ له عن أبي أيوب الأنصاري روى عنه أبو بشر جعفر بن أبي وحشية(@)(@@)(@@)(@@) $ 7367 - حجاج بن عثمان السكسكي من أهل الشام يروي المراسيل روى عنه صفوان بن عمرو السكسكي(@)(@@)(@@)(@@) $ 7368 - حجاج بن الحجاج الباهلي الأحول من أهل البصرة يروي عن قتادة روى عنه إبراهيم بن طهمان ويزيد بن زريع ومحمد بن جحادة(@)(@@)(@@)(@@) $ 7369 - حجاج بن زيد السامي القرشي البصري يروي عن أبي المتوكل PageV06P201 الناجي روى عنه عرعرة بن البرند(@)(@@)(@@)(@@) $ 7370 - حجاج بن أبي زياد الأسود من أهل البصرة كان ينزل القسامل بها يروي عن أبي نضرة وجابر بن زيد روى عنه عيسى بن يونس وجرير بن حازم وهو الذي يحدث عنه حماد بن سلمة ويقول حدثنا حجاج الأسود(@)(@@)(@@)(@@) $ 7371 - حجاج بن أبي عثمان الصواف كنيته أبو الصلت مولى التوأمة بنت أمية بن خلف واسم أبي عثمان ميسرة وقد قيل إن اسم أبي عثمان سالم يروي عن أبي الزبير ويحيى بن أبى كثير روى عنه حماد بن سلمة والبصريون مات سنة ثلاث وأربعين ومائة وكان متقنا(@)(@@)(@@)(@@) $ 7372 - حجاج بن أبي يزيد يروي عن مجاهد روى عنه سفيان الثوري(@)(@@)(@@)(@@) $ 7373 - حجاج بن أبي زينب السلمي يروي عن أبي سفيان عن جابر PageV06P202 يروي عنه يزيد بن هارون كنيته أبو يوسف من أهل واسط(@)(@@)(@@)(@@) $ 7374 - حجاج بن أبي يونس يروي عن 
ms959	 طاوس روى عنه هشام بن حسان(@)(@@)(@@)(@@) $ 7375 - حجاج بن فروخ التميمي من أهل واسط يروي عن العوام بن حوشب عن بن أبي أوفى روى عنه أهل البصرة(@)(@@)(@@)(@@) $ 7376 - حجاج بن شداد الصنعاني من صنعاء الشام يروي عن سعيد أبي صالح الغفاري روى عنه حيوة بن شريح(@)(@@)(@@)(@@) $ 7377 - حجاج بن عتاب العبدي أبو خليفة من أهل البصرة يروي عن عبد الله بن معبد الزماني روى عنه أبو هلال الراسبي وقيل إن هذا والد عمر بن أبي خليفة(@)(@@)(@@)(@@) $ 7378 - حجاج الوراق شيخ يروي المراسيل روى عنه المعتمر بن سليمان(@)(@@)(@@)(@@) $ 7379 - حجاج بن فرافصة كوفي يروي عن جماعة من التابعين روى عنه الثوري وقال بت عند الحجاج بن فرافصة ثلاث عشرة ليلة فما رأيته أكل ولا شرب ولا نام يخطىء ويهم PageV06P203(@)(@@)(@@)(@@) $ 7380 - حجاج بن حسان التيمي من تيم الله بن ثعلبة بن ربيعة وهو الذي يقال له العائشي والعيشي من أهل البصرة يروي عن عكرمة وعبد الله بن بريدة روى عنه يحيى بن سعيد القطان ويزيد بن هارون وأهل البصرة حدثنا بن قتيبة ثنا بن أبي السري قال ثنا معتمر بن سليمان قال ثنا حجاج بن حسان التيمي قال سئل أبو مجلز عن طول الصلاة بالليل والنهار فقال أما الليل فطول القيام وأما النهار فكثرة الركوع والسجود(@)(@@)(@@)(@@) $ 7381 - حجاج بن صفوان المدني يروي عن أسيد بن أبي أسيد روى عنه أهل بلده(@)(@@)(@@)(@@) $ 7382 - حجاج بن أبي مخلد قوله روى عنه قتادة(@)(@@)(@@)(@@) $ 7383 - حجاج بن تميم يروي عن ميمون بن مهران أن عمر كبر على أبي بكر أربعا روى عنه أبو معاوية الضرير PageV06P204(@)(@@)(@@)(@@) $ 7384 - حجاج بن دينار الواسطي الأشجعي يروي عن أبي غالب روى عنه شعبة وإسماعيل بن زكريا وهو الذي يقال له حجاج البطيخي(@)(@@)(@@)(@@) $ 7385 - حجاج بن عاصم المحاربي من أهل الكوفة يروي عن العراقيين وكان قاضيا بالكوفة روى عنه أهل الكوفة(@)(@@)(@@)(@@) $ 7386 - حجاج شيخ يروي عن الشعبي روى عنه إسماعيل بن أبي خالد(@)(@@)(@@)(@@) $ 7387 - حجاج بن محمد بن سليمان بن فرادس الخولاني 
ms960	 كنيته أبو مسلم من أهل الشام يروي عن عمر بن بلال قال سمعت عبد الله بن بسر يقول سمعت رسول الله صلى الله عليه وسلم يقول كيف أنت إذا جارت عليكم الولاة روى عنه يعقوب بن سفيان الفارسي آخر الأول من كتاب تبع التابعين وأول الثاني منه(@)(@@)(@@)(@@) $ 7388 - حسين بن علي بن الحسين بن على بن أبي طالب PageV06P205 رضي الله عنهم من أهل المدينة أخو عمر ومحمد يروي عن وهب بن كيسان روى عنه بن المبارك(@)(@@)(@@)(@@) $ 7389 - حسين بن بشير بن سلمان مولى صفية بنت عبد الرحمن من أهل المدينة يروي عن أبيه عن جابر روى عنه خارجة بن عبد الله(@)(@@)(@@)(@@) $ 7390 - حسين بن ذكوان المعلم العوذي من أهل البصرة يروي عن عبد الله بن بريدة روى عنه شعبة وابن المبارك وهو الذي يقول بعض الرواة حسين بن ذكوان وبعضهم حسين المكتب(@)(@@)(@@)(@@) $ 7391 - حسين بن حسين الواسطي أبو سفيان السلمي وقد قيل حسين بن حسن يروي عن الحسن روى عنه شعبة وهاشم بن البريد ومن زعم إنه سمع أنس بن مالك فقد وهم PageV06P206(@)(@@)(@@)(@@) $ 7392 - حسين بن عثمان بن بشر المحتفز من أهل مرو يروي عن سالم بن عبد الله أنه قال في ألم والمر وحم ون كلها اسم من أسماء الله وهي مقطعة روى عنه عيسى بن عبيد الكندي وهو أخو حسن بن عثمان(@)(@@)(@@)(@@) $ 7393 - حسين بن عمران الجهني يروي عن الشيباني والزهري روى عنه شعبة وروح وعطاء بن أبي ميمونة(@)(@@)(@@)(@@) $ 7394 - حسين بن الحسن الكندي قاضي الكوفة يروي عن عبد الله بن بريدة روى عنه شريك بن عبد الله النخعي(@)(@@)(@@)(@@) $ 7395 - حسين بن حازم يروي عن أهل المدينة وعمر بن عبد العزيز روى عنه صالح بن عمر PageV06P207(@)(@@)(@@)(@@) $ 7396 - حسين بن أبي عائشة يروي عن أبي خالد الوالبي روى عنه عمران بن أبي زائدة(@)(@@)(@@)(@@) $ 7397 - حسين بن رستم الأيلي يروي عن الزهري روى عنه سعيد بن أبي أيوب وابن أبي ذئب(@)(@@)(@@)(@@) $ 7398 - حسين بن عبد الله العنزي يروي عن الشعبي 