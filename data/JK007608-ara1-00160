ms141	 عنك إلى الرضى % % كما نشط المأسور من حلق القد % % 30(@)(@@) % وقد ضمني محض الصفاء وصدقه % % اليك كما ضمت ذراع إلى عضد % % PageV01P484 31(@)(@@) % وكنت على ما بيننا من عيابه % % اعدك جدي حين اسطو على ضدي % % PageV01P485 البحر : طويل 1(@)(@@) % تكشف ظل العتب عن غرة العهد % % وأعدى اقتراب الوصل منا على البعد % 2(@)(@@) % تجنبني من لست عن بعض هجره % % صفوحا ولا في قسوة عنه بالجلد % % 3(@)(@@) % نضته يد الإعتاب عما سخطته % كما ينتضى العضب الجراز من الغمد % 4(@)(@@) % وكنت على ما جره الهجر ممسكا % % بحبل وفاء غير منفصم العقد % 5(@)(@@) % امين نواحي السر لم تسر غدرة % % ببالي ولم أحفل بداعية الصد % 6(@)(@@) % تلين على مس الاخاء مضاربي % % وان كنت في الاقوام مستحسن الجد % % 7(@)(@@) % ولما استمر الببين في عدوائه % % تغول عفوي أو ترقى إلى جهدي % % 8(@)(@@) % اصاحب حسن الظن والشك مقبل % % بوجهي إلى حيث استرثت عرا الود % 9(@)(@@) % اذا اتسعت في خطة الصد فكرتي % % تجللني هم يضيق به جلدي % % 10(@)(@@) % وان ناكرتني خلة من خلاله % % تعرض قلبي يفتديها من الحقد % PageV01P486 11(@)(@@) % يخال رجال ما رأوا لضلالة % % ولن تستشف الشمس بالاعين الرمد % % 12(@)(@@) % وكم مظهر سيما الوداد يرونه % حميدا وما يخفي بعيد من الحمد % 13(@)(@@) % وحوشيت ان القاك سبطا تظاهري % % وان كنت مطويا على باطن جعد % % 14(@)(@@) % إذا تركت يمنى يديك تعلقي % % فيا ليت شعري من تمسك من بعدي ؟ % 15(@)(@@) % إيابا فلم نشرف على غاية النوى % % ولم تنأ كل النأي عن سنن القصد % % 16(@)(@@) % فللدر نثر ليس يدفع حسنه % وليس كما ضمته ناحية العقد % % 17(@)(@@) % ولو لم يلاق القدح زندا بمثله % لما انبعث شهب الشرار من الزند % % 18(@)(@@) % وقد غاض سخطانا فهل من صبابة % برأيك اني قد تصرم ما عندي % % 19(@)(@@) % هلم نعد صفو الوداد كما بدا % % اعادة من لم يلف عن ذاك من بد % % 20(@)(@@) % ونغتنم الأيام وهي طوائش % تؤاتي بلا قصد وتأبى بلا عمد % PageV01P487 21(@)(@@) % ومثلك أهدى أن يعاد إلى الهدى % % وأرشد أن ينحاز عن جهة القصد % PageV01P488 البحر : كامل تام 1(@)(@@) % يا 
ms142	 دار من قتل الهوى بعدي % % وجدوا ولا مثل الذي عندي % % 2(@)(@@) % لا تعجبي ، يا دار ، أنهم % ابدوا ومن يك واجدا يبدي % % 3(@)(@@) % ربع قريب العهد أحسبه % بالظاعنين وقد مضى عهدي % % 4(@)(@@) % لو حركت ذاك الرماد يد % لرأت بقايا الجمر والوقد % % 5(@)(@@) % إني ليعجبني حماك ، إذا % % نشر النسيم ذوائب الرند % 6(@)(@@) % والماء تصقله الرياح كما % % ابدى العياب مضاعف السرد % % 7(@)(@@) % حيا مريض ثراك غادية % تعطيه ريح العنبر الورد % % 8(@)(@@) % أو ذات نهد بين سارية % % يتلويان تلوي القد % % 9(@)(@@) % يتشقق البرق اللموع بها % % وتروعه بتهزم الرعد % % 10(@)(@@) % لي مقلة ما تستفيق جوى % % تدمى ويقرع ماؤها خدي % % PageV01P489 11(@)(@@) % والعيس ما وجدت تحن ، ولا % % تخفى واكتم دائما وجدي % % 12(@)(@@) % وملام ايام وليس لها % % عطف وبعض اللوم لا يجدي % % 13(@)(@@) % لا خير في دنيا نوائبها % % تدوي ، وداء منونها يعدي % % 14(@)(@@) % لا تحسبن الرزق مطرحا % فالرزق بين مواضع الاسد % % 15(@)(@@) % ولرب مصحوب غرضت به % غرض الخوامس من قذى الورد % 16(@)(@@) % داني يدي فنفضتها حذرا % % من ان يدنس هزله جدي % % 17(@)(@@) % ومبخل إن جاد بعد مدى % % فالمتاء يطلع من صفا صلد % % 18(@)(@@) % كيف السبيل إلى بلهنية % في ذا الزمان وعيشة رغد % % 19(@)(@@) % في كل ليل لي وقود منى % % ومطامع وسدتها عضدي % % 20(@)(@@) % والمرء ما أرضى أمانيه % ينقاد من لعب إلى جد % % PageV01P490 21(@)(@@) % وجهي مجال للطعان ، فما % % خوفي لقاء الحر والبرد % 22(@)(@@) % فلاشربن مناقبا بدمي % % ولانقبن على العلى جهدي % % 23(@)(@@) % ولارحلن العيس مرحلة % % عوجاء بين القور والوهد % % 24(@)(@@) % علي ألاقي من أسر به % ويفل عند لقائه كدي % % 25(@)(@@) % وأتوب من ذم الزمان ، إذا % % علقت يداي يدي أبي سعدي % % 26(@)(@@) % خلي ، وإن بعد الزمان به % يوما ، وماطلني به وعدي % % 27(@)(@@) % ومطالعي في الأنس إن لويت % عني الرقاب ولج في صدي % % 28(@)(@@) % لا تحسبوا ذا البعد غيرني % % فالبعد غير مغير ودي % % 29(@)(@@) % وإذا الفتى حسنت رعايته % في القرب ضاعفها على البعد % % 30(@)(@@) % لو تسألون دمي سمحت به % من غير معصية ، ولا رد % PageV01P491 31(@)(@@) % أو كان جلد يستعار اذا % يوم الطعان 
ms143	 ، لعرتكم جلدي % % 32(@)(@@) % أو ان خطوا يستراب به % % منكم سحبت ورائكم بردي % % 33(@)(@@) % كانت غيابة حادث فجلا % % ديجورها قمر من السعد % % 34(@)(@@) % ونهصت منها غير مكترث % مثل الحسام نزا من الغمد % % 35(@)(@@) % الله جارك ما رمتك نوى % % تذري الركائب أو قطا الجرد % % 36(@)(@@) % وانا الذي ان تدج نائبة % % يصبح أمامك موريا زندي % % PageV01P492 البحر : طويل 1(@)(@@) % أسائل سيفي : أي بارقة تجدي % % ولي رغبة عمن يعلل بالوعد % 2(@)(@@) % وأطلب في الدنيا العلى ، وركائبي % % مقلقلة ما بين غور إلى نجد % 3(@)(@@) % يشتت ترب القاع وسم اكفها % % واخفافها في حيز النص والوخد % % 4(@)(@@) % وخطة ضيم خادعتني ، ففتها % % إلى مطلع بين المذمة والحمد % % 5(@)(@@) % ويوم من الشعرى خرقت وشمسه % تساقط من هام الإكام إلى الوهد % 6(@)(@@) % وليل دجوجي كأن ظلامه % سماوة ملوي الذراعين بالقد % % 7(@)(@@) % خطوت ، وفي كفي خطام نجيبة % مدفعة من كل قرب إلى بعد % 8(@)(@@) % اذا لحظت ماء جذبت زمامها % % وقلت : ارغبي بالعز عن مورد ثمد % 9(@)(@@) % تؤمين خير الأرض أهلا وتربة % يحط بها رحل المكارم والمجد % % 10(@)(@@) % وفي الأرض قوم يلطمون جباههم % % اذا هجمت اعلى المنازل بالوفد % % PageV01P493 11(@)(@@) % وتنبو أكف العيس عن عرصاتهم % من البخل حتى تستغيث إلى الطرد % % 12(@)(@@) % فما خدعتها روضة عن مسيرها % % ولا لمع معسول تطلع من ورد % 13(@)(@@) % اكف بني عدنان تستمطر الظبى % % وتأنف من جود الغمائم بالعهد % % 14(@)(@@) % وتلقى الوغى ، واليوم ينصر بيضه % على البيض في مجرى من الجد والجد % % 15(@)(@@) % منازلهم عقر المطايا ، وإنما % % تعقلها بالبشر والنائل الجعد % % 16(@)(@@) % جذبتم بضبع المجد يا آل غالب % % وغادرتم الاعدام منعقر الخد % % 17(@)(@@) % على حين سدت ثلمة العار عنكم % صدور العوالي والمطهمة الجرد % % 18(@)(@@) % وكم غارة أقبلتموها مواقرا % من الاسل الذيال والبيض والسرد % % 19(@)(@@) % كما قاد علوي السحاب غمامة % وجلجلها ملء من البرق والرعد % 20(@)(@@) % كفى أملي في ذا الزمان وأهله % علي مجيرا من يد الدهر أو معدي % % PageV01P494 21(@)(@@) % فتى ما مشى في سمعه شدو قينة % % ولا جذبت أحشاءه سورة الوجد % % 22(@)(@@) % ولا هجر السمر العوالي للذة % ولا عاتب 
ms144	 البيض الغواني على الصد % % 23(@)(@@) % اذا اظلمت آمال قوم بردها % % أضاء سنا معروفه ظلمة الرد % 24(@)(@@) % وان شام يوما ناره خلت انها % % تطلع نحو الواردين من الزند % 25(@)(@@) % وكم بين كفيه اذا احتدم الردى % % وبين العوالي من زمام ومن عقد % 26(@)(@@) % ليهنك يا بن الاكرمين بن حرة % % تمزق عنه النحس عن غرة السعد % % 27(@)(@@) % فرب له خيل الوغى ، فلمثله % تربي اللليالي كاهل الفرس النهد % % 28(@)(@@) % وبشر به البيض الصوارم والقنا % % وبشره عن قول النوائب بالجلد % % 29(@)(@@) % ستذكره والحرب ينكحها الردى % % وقد طلقت أغمادها قضب الهند % 30(@)(@@) % كاني به جار على حكم سيفه % % يعاهده ان لا يبيت على حقد % % PageV01P495 31(@)(@@) % إذا أنهضته للنزال حفيظة % وأنهض مستن الحسام من الغمد % 32(@)(@@) % وارخي بعطفيه حواشي نجاده % % وجر على اعقابه فاضل البرد % % 33(@)(@@) % وعطف خرصان الرماح كأنها % % من الدم في أطرافها شجر الورد % 34(@)(@@) % وزعزع نظم الرمح حتى برده % % نثارا على الأعداء بالحطم والقصد % 35(@)(@@) % وشايح عن احسابه بحسامه % % وذب عن العرض الممنع بالرفد % % 36(@)(@@) % رأيت فتى في كفه سمة الندى % % وفي وجهه شبه من الاب والجد % % 37(@)(@@) % اذا ما اجتبى في الحي وامتد باعه % % رأيت اباه حين يحكم أو يجدي % % 38(@)(@@) % إلى جده تنمى شمائل مجده % وهل ترجع الاشبال الا إلى الاسد % % 39(@)(@@) % وليد همى ماء العلى في جبينه % وقد شمت منه بارق الحسب العد % % 40(@)(@@) % فلو قيل يوما اين صفوة يعرب % % رأيت العلى تومي إلى ذلك المهد % PageV01P496 41(@)(@@) % إلى ربعك المألوف مني تطلعت % رقاب القوافي تحت أدعج مزبد % 42(@)(@@) % ولما بعثت الشعر نحوك قال لي : % الان فعق الا إلى بابه قصدي % % 43(@)(@@) % سقيت الندى شعري ، فأنبت حمده % ولو صاب في جسمي لأنبته جلدي % % 44(@)(@@) % وإني لأستحيي العلى فيك أن أرى % % ضنينا من الشعر المصون بما عندي % % 45(@)(@@) % كبت الحسود الندب حتى كببته % % فمن عاذري يوما من الحاسد الوغد % 46(@)(@@) % اذا الشمس غاضت كل عين صحيحة % % فكيف بها في هذه المقل الرمد % % PageV01P497 البحر : كامل تام 1(@)(@@) % هو سيف دولتنا الذي يوم الوغى % % يفرى 
ms145	 قلوب عداته بفرنده % % 2(@)(@@) % يعدو بطرف ان جرى سبق الردى % % وبصارم يسم الطلى في غمده % % 3(@)(@@) % جار ، ولكن رأيه في جريه % ماض ولكن عزمه في حده % % PageV01P498 البحر : رجز تام 1(@)(@@) % أبارق طالعنا من نجد % يضيء في عارضه المربد % 2(@)(@@) % مستعبرا عن زفرات الرعد % ماء كما ارتجت شعاب العد % 3(@)(@@) % يقرن أعناق الربى بالوهد % ومنهل مبرقع بالثمد % 4(@)(@@) % هتكته باليعملات الجرد % ملثمات باللغام الجعد % 5(@)(@@) % يفقأن بالمصدر عين الورد % وليلة صدية الفرند % 6(@)(@@) % بيض النجوم واحمرار الوقد % % مثل سماطي نرجس وورد % 7(@)(@@) % أو مقل صحائح ورمد % تنازع اللحظ وليس تعدي % % 8(@)(@@) % يقول لي الدهر الا تستجدي % % اين ضياء المطلب المسود % % 9(@)(@@) % ارى الليالي يشتهين بعدي % % ولا يقربن يدا من زندي % % 10(@)(@@) % يلجن بين صارمي وغمدي % % كأن صمصامي بغير حد % PageV01P499 11(@)(@@) % وحاجتي تصلى بنار لرد % ألاحظ الغي بعين الرشد % 12(@)(@@) % ولا أبالي من تمادي بعدي % % أعوذ من رزق بغير كد % 13(@)(@@) % في ذا الورى قلب بغير حقد % % من ذا الذي على الزمان يعدي % % 14(@)(@@) % كل جواد كاذب في الوعد % و كل خل خائن في الود % % 15(@)(@@) % يحل بالعذر نطاق العهد % لا عانقت هوج الرياح بردي % % 16(@)(@@) % إلا على ظهر أقب نهد % يخطو على ململمات ملذ % % 17(@)(@@) % كأنه في سرعان الوخذ % يلعب في ارساغه بالنرد % % 18(@)(@@) % يا أيها المخوفي بسعد % طرحتني بين النيوب الدرد % 19(@)(@@) % ولو أتاك النصر من معد % جلجلت من لحمى زئير الاسد % % 20(@)(@@) % أها لنفس حبست في جلدي % % ان الاسير غرض بالقد % % PageV01P500 21(@)(@@) % اشرف ذخري صارم في الغمد % % إن العلى نشو سيوف الهند % 22(@)(@@) % لا بد أن أطرق باب الجد % و اجعل الخلة عرس الرفد % % 23(@)(@@) % و يطرد الليل لسان زندي % % حتى أقاس بأبي وجدي % % 24(@)(@@) % هنئت يا مالك رق المجد % و متعبي دون الورى بالحمد % % 25(@)(@@) % منك العطايا والمنى من عندي % % PageV01P501 البحر : وافر تام 1(@)(@@) % لحيا عهدهن حيا العهاد % ندى يغتص منه كل ناد % % 2(@)(@@) % و اطلالا يطل الدمع فيها % % إذا بدت الحواضر والبوادي % % 3(@)(@@) % رواء لا تريح الريح 
ms146	 فيها % % من الادلاج انتاج الغوادي % % 4(@)(@@) % إذا مات الحيا بين السواري % % أتاها بالغوادي في معاد % 5(@)(@@) % مجاهل منزل كانت زمانا % معالم كل مكرمة وآد % % 6(@)(@@) % تكف ربوعها ايدي الاماني % % وقد عانقن أعناق الأيادي % % 7(@)(@@) % إذا حل الحبى أمل طريف % حبته مهجة المال التلاد % % 8(@)(@@) % فما لي واللقاء وكل يوم % % تهددني الركائب بالبعاد % % 9(@)(@@) % دعى عذلي فليس العذل يجني % % به ما أثمرت شيمي وعادي % % 10(@)(@@) % ولي عزم تعوذ به العوالي % % إذا فزعت إلى مهج الاعادي % % PageV01P502 11(@)(@@) % يضم شعاعه قلب ولكن % % تضيق به حيازيم البلاد % 12(@)(@@) % وكم قلب أسر علي حقدا % فأفشى سره سر النجاد % 13(@)(@@) % ويوم تعثر الخرصان عمدا % به في كل نحر أو فؤاده % % 14(@)(@@) % يشق الروع عن ضاحي بدور % % برزن من العجاجة في دآد % 15(@)(@@) % تريهم فيه مرآة المنايا % % بصدق يقينهم وجه المعاد % % 16(@)(@@) % وحشو أكفهم سمر رواء % بورد الموت من مهج صواد % 17(@)(@@) % تهديها إلى الطعن المنايا % % بحيث تضل في طرق الهوادي % % 18(@)(@@) % وقد نشأت سحاب من عجاج % تعط صدورها أيدي الجياد % 19(@)(@@) % بارماح خلقن من المنايا % % و اسياف طبعن على الجلاد % % 20(@)(@@) % زرعت اسنتي في كل قلب % % بها والهام تزرع بالحصاد % % PageV01P503 21(@)(@@) % وبحر دم تعوم الطير فيه % و ترقى بين امواج الطراد % % 22(@)(@@) % تراها في فروج النقع حمرا % كما طار الشرار عن الزناد % 23(@)(@@) % و ليل بات يصلت لي هموما % يطل بغربهن دم الرقاد % % 24(@)(@@) % و كيف يحب اغمار الليالي % % أسير الطرف في أيدي السهاد % 25(@)(@@) % فلو حل المؤمل عقد همي % % شددت بمقلتي عرى الرقاد % % 26(@)(@@) % و اني وهو في خيشوم مجد % % تنفس عن نسيم من وداد % 27(@)(@@) % كأن عهودنا كانت قلوبا % تربي بين احشاء العهاد % % 28(@)(@@) % اينسبني له ظن غوي % % وكان الغي يمكر بالرشاد % 29(@)(@@) % إذا فثكلت سابحثي وسيفي % % غداة وغى ، وراحلتي وزادي % % 30(@)(@@) % اتخلع حليك الاشعار عنها % % اذا كسيت من المعنى المعاد % % PageV01P504 31(@)(@@) % ومن هذا يقوم مقام فضل % قعدن له ذرى الصم الصلاد % 32(@)(@@) % أأترك ضيغما في ظهر طود % وآخذ تتفلا في بطن واد % 33 
ms147	(@)(@@) % وألفظ صفو أحشاء الغوادي % % و اجرع رنق احشاء الثماد % % 34(@)(@@) % وقد علمت ربيعة أن بيتي % % لغير الغدر ، مرفوع العماد % 35(@)(@@) % أتتك قلادة لم يخل منها % % صليف الجود أو جيد الجواد % % 36(@)(@@) % فمن لم يجر دمعته عليها % % فخاطره افظ من الجماد % % 37(@)(@@) % وما أجني بها عذرا ولكن % محافظة على ثمر الوداد % % PageV01P505 البحر : خفيف تام 1(@)(@@) % مرضت بعدكم صدور الصعاد % % لا دواء الا قلوب الاعادي % % 2(@)(@@) % ان خير الرماح ما شرقت با % % طعن منها معاقد الأكباد % 3(@)(@@) % اي خطب ارخى ذؤابة ليل % % لم أجبه من عزمتي بزناد % 4(@)(@@) % حكم الدهر أن صاحب ذا العي % % عيش قتيل المنى بغير مراد % % 5(@)(@@) % وقصير الغنى طويل يد الجو % % د ثقيل الحجى خفيف العتاد % % 6(@)(@@) % كلما قلت روحتني الليالي % % ضربت بي آفاق هذي البلاد % 7(@)(@@) % وتلقت بي الظلام ، رديف ال % % جم بين الاتهام والانجاد % % 8(@)(@@) % وعتاب الزمان مثل عتاب العين % % عين تنهى ، ودمعها بازدياد % 9(@)(@@) % ضجت الخيل من سراياي حتى % % لحسدن البطاء قب الجياد % % 10(@)(@@) % كل يوم اقودها شائمات % % بارق الموت من سماء الجلاد % % PageV01P506 11(@)(@@) % بليوث تقري الهجير وجوها % تقطر المجد بين قار وباد % % 12(@)(@@) % شرقت غرة القريض بندب % % اشرقت عنده وجوه الايادي % % PageV01P507 البحر : طويل 1(@)(@@) % لاي حبيب يحسن الرأي والود % وأكثر هذا الناس ليس له عهد % 2(@)(@@) % ارى ذمي الايام ما لا يضرها % % فهل دافع عني نوائبها الحمد % 3(@)(@@) % وما هذه الدنيا لنا بمطيعة % % وليس لخلق من مداراتها بد % 4(@)(@@) % تحوز المعالي والعبيد لعاجز % % ويخدم فيها نفسه البطل الفرد % 5(@)(@@) % اكل قريب لي بعيد بوده % % وكل صديق بين اضلعه حقد % 6(@)(@@) % ولله قلب لا يبل غليله % وصال ، ولا يلهيه عن خله وعد % 7(@)(@@) % يكلفني أن أطلب العز بالمنى % % واين العلى ان لم يساعدني الجد % % 8(@)(@@) % احن وما اهواه رمح وصارم % % وسابغة زغف ، وذو ميعة نهد % 9(@)(@@) % فيا لي من قلب معنى به الحشا % % ويا لي من دمع قريح به الخد % 10(@)(@@) % أريد من الأيام كل عظيمة % ومابين اضلاعي لها اسد ورد % % PageV01P508 11(@)(@@) % وليس فتى من 
ms148	 عاق عن حمل سيفه % % إسار ، وحلاه عن الطلب القد % 12(@)(@@) % اذا كان لا يمضي الحسام بنفسه % % فللضارب الماضي بقائمة الحد % % 13(@)(@@) % وحولي من هذا الأنام عصابة % توددها يخفى واضغانها تبدو % % 14(@)(@@) % ي سر الفتى دهر ، وقد كان ساءه % % وتخدمه الأيام ، وهو لها عبد % 15(@)(@@) % ولا مال إلا ما كسبت بنيله % ثناء ولا مال لمن لا له مجد % % 16(@)(@@) % وما العيش الا تصاحب فتية % % طواعن لا يعنيهم النحس والسعد % % 17(@)(@@) % إذا طربوا يوما إلى العز شمروا % % وان ندبوا يوما إلى غارة جدوا % % 18(@)(@@) % وكم لي في يوم الثوية رقدة % يضاجعني فيها المهند والغمد % % 19(@)(@@) % إذا طلب الأعداء إثري ببلدة % نجوت وقد غطى على أثري البرد % 20(@)(@@) % ولو شاء رمحي سد كل ثنية % تطالعني فيها المغاوير والجرد % PageV01P509 21(@)(@@) % نصلنا على الاكوار من عجز ليلة % % ترامى بنا في صدرها القور والوهد % 22(@)(@@) % طردنا إليها خف كل نجيبة % عليها غلام لا يمارسه الوجد % % 23(@)(@@) % ودسنا بأيدي العيس ليلا ، كأنما % % تشابه في ظلمائه الشيب والمرد % % 24(@)(@@) % الا ليت شعري هل تبلغني المنى % % وتلقى بي الاعداء احصنة جرد % % 25(@)(@@) % جواد وقد سد الغبار فروجها % % تروح إلى طعن القبائل أو تغدوا % % 26(@)(@@) % خفاف على إثر الطريدة في الفلا % % إذا ماجت الرمضاء واختلط الطرد % 27(@)(@@) % كأن نجوم الليل ، تحت سروجها % % تهاوى على الظلماء والليل مسود % 27(@)(@@) % يعيد عليها الطعن كل بن همة % % كأن دم الاعداء في فمه شهد % % 28(@)(@@) % يضارب حتى ما لصارمه قوى % % ويطعن حتى ما لذابله جهد % % 29(@)(@@) % تغرب لا مستحقبا غير قوته % ولا قائلا إلا لما يهب المجد % PageV01P510 30(@)(@@) % ولا خائفا إلا جريرة رمحه % ولا طالبا إلا الذي تطلب الأسد % 31(@)(@@) % إذا عربي لم يكن مثل سيفه % مضاء على الأعداء أنكره الجد % 32(@)(@@) % وما ضاق عنه كل شرق ومغرب % من الأرض الا ضاق عن نفسه الجلد % % 33(@)(@@) % إذا قل مال المرء قل صديقه % وفارقه ذاك التحنن والود % 34(@)(@@) % واصبح يغضي الطرف عن كل منظر % % أنيق وبلهيه التغرب والبعد % 35(@)(@@) % فمالي وللايام ارضى بجورها % % وتعلم اني 
ms149	 لا جبان ولا وغد % % 36(@)(@@) % تغاضى عيون الناس عني مهابة % % كما تتقي شمس الضحى الاعين الرمد % % 37(@)(@@) % تخطت بي الكثبان جرداء شطبة % فلا الرعي دان من خطاها ولا الورد % 38(@)(@@) % تدافع رجلاها يديها عن الفلا % % إلى حيث ينمى العز والجد والجد % 39(@)(@@) % فجاءتك ورهاء العنان بفارس % % تلفت حتى غاب عن عينه نجد % PageV01P511 40(@)(@@) % ومثلك من لا توحش الركب داره % % ولا نازل عنها إذا نزل الوفد % 41(@)(@@) % فيا لآخذا من مجده ما استحقه % % نصيبك هذا العز والحسب العد % % 42(@)(@@) % أب أنت أعلى منه في الفضل والعلى % % وامضى يدا والنار والدها زند % % 43(@)(@@) % وما عارض عنوانه البيض والقنا % % أخو عارض عنوانه البرق والرعد % 44(@)(@@) % وكم لك في صدر العدو مرشة % % يخضب منه الرمح منبعق ورد % 45(@)(@@) % وفوق شواة الذمر ضربة ثائر % يكاد له السيف اليماني ينقد % 46(@)(@@) % يود رجال انني كنت مفحما % ولولا خصامي لم يودوا الذي ودوا % % 47(@)(@@) % مدحتهم فاستقبح القول فيهم % ألا رب عنق لا يليق به عقد % 48(@)(@@) % زهدت وزهدي في الحياة لعلة % % وحجة من لا يبلغ الامل الزهد % % 49(@)(@@) % وهان على قلبي الزمان واهله % % ووجداننا ، والموت يطلبنا ، فقد % PageV01P512 50(@)(@@) % وأرضى من الأيام أن لا تميتني % % وبي دون أقراني نوائبها النكد % PageV01P513 البحر : كامل تام 1(@)(@@) % ليت الخيال فريسة لرقادي % % يدنو بطيفك عن نوى وبعاد % % 2(@)(@@) % ولقد اطلت إلى سلوك شقتي % % وجعلت هجرك والتجنب زادي % % 3(@)(@@) % أهون بما حملتنيه من الضنى % % لو أن طيفك كان من عوادي % % 4(@)(@@) % ولقلما نزل الخيال بمقلة % روعاء نافرة بغير رقاد % % 5(@)(@@) % ما تلتقي الأجفان منها ساعة % وإذا التقت فلغض دمع باد % 6(@)(@@) % لا يبعدن قلبي الذي خلفته % وقفا على الإتهام والإنجاد % 7(@)(@@) % إن الذي عمر الرقاد وسادة % لم يدر كيف بنا علي وساد % % 8(@)(@@) % لا زال جيب الليل منفصم العرى % % عن كل اوطف مبرق مرعاد % % 9(@)(@@) % يسقى منازل عاث فيهن البلى % % من أن يراق على يدي بأباد % 10(@)(@@) % وإذا الرياح تبوعت ، فصدورها % % لعناق حاضر ارضكم والبادي % % PageV01P514 11(@)(@@) % ولقد بعثت من الدموع اليكم % % بركائب ومن 
ms150	 الزفير بحاد % % 12(@)(@@) % إني متى استنجدت سرب مدامع % خذلته اسراب الفراق العادي % % 13(@)(@@) % لولا هواك لما ذللت وانما % % عزي يعيرني بذل فؤادي % % 14(@)(@@) % ما للزمان يذودني عن مطلبي % % ويريغني عن طارفي وتلادي % % 15(@)(@@) % يحنو علي اذا اقمت كانني % % الاسرار في احشاء كل بلاد % % 16(@)(@@) % عادات هذا الناس ذم مفضل % % وملام مقدام وعذل جواد % % 17(@)(@@) % ولقد عجبت ، ولا عجيب أنه % كل الورى للفاضلين اعادي % % 18(@)(@@) % وارى زماني يستلين عريكتي % % وارى عدوي يستحر عنادي % % 19(@)(@@) % اتظنني القي اليك يدا وما % % بيني وبينك غير ضرب الهادي % % 20(@)(@@) % اسعى لكل عظيمة فانالها % % عزما يفوت هواجس الحساد % PageV01P515 21(@)(@@) % عزما قويا لا يشاور رقبة % للخطب في الاصدار والايراد % % 22(@)(@@) % ما زال يشهد لي إذا استنطقته % بالجود في ليلي ، لسان زنادي % % 23(@)(@@) % إني لتحقن ماء وجهي همتي % % من ان يراق على يدي باياد % % 24(@)(@@) % مما يقلل رغبتي أني أرى % % صفدي ببذل المال مثل صفادي % % 25(@)(@@) % والمال اهون مطلبا من ان ارى % % ضرعا أرامي دونه وأرادي % % 26(@)(@@) % ومناضل عثرت به احسابه % % في مسلك وعر من الاجداد % % 27(@)(@@) % خلقت عرف جواده بنجيعه % والسبق في طلق الردى لجوادي % % 28(@)(@@) % ولرب يوم غضة أطرافه % صقلت بخطو روائح وغوادي % % 29(@)(@@) % يوم اراق دم الغمام على السرى % % بظبى من الإيماض غير حداد % 30(@)(@@) % ولغرة الجو الرقيق أسرة % يلمعن من قطع السحاب الغادي % % PageV01P516 31(@)(@@) % جاذبته صافي اديم هجيره % % واليعملات شواحب الأعضاد % 32(@)(@@) % في فتية سلبوا النهار ضياءه % ورموا بياض جبينه بسواد % 33(@)(@@) % وحشوا حشا الظلماء ملء جنانها % % حتى تصدع بالصديع البادي % % 34(@)(@@) % وكانما بيض النجوم فواقع % % في زاخر متتابع الإزباد % 35(@)(@@) % نالوا على قدر الرجاء وانما % % يروى على قدر الاوام الصادي % % 36(@)(@@) % قوم إذا قرعوا زنودا للقرى % % ستروا فروج النار بالوراد % 37(@)(@@) % ما ضل في قلب امرء امل سرى % % إلا وجودهم الهدى والهادي % % 38(@)(@@) % طنب يعثرن الخطوب ، وباحة % ممنوعة إلا من الرواد % 39(@)(@@) % سحبوا أنابيب القنا ، فكأنما % % سحبوا بهن حواشي الأبراد % 40(@)(@@) % يزجرن جردا لا تقر على الثرى % % مرحا كان الترب شوك قتاد % % PageV01P517 41 
ms151	(@)(@@) % من كل تلعاء المناكب جيدها % % 42(@)(@@) % ضربوا قباب البيض فوق مفارق % اطنابها شرع القنا المياد % % 43(@)(@@) % ذبل يهذ بها الطعان وانها % % تزداد جهلا كل يوم جلاد % 44(@)(@@) % يحملن عبء الموت وهي خفايف % في الطعن بين جناجن وهواد % % 45(@)(@@) % هم أنشبوا قصد القنا من وائل % من حيث نار الحقد في ايقاد % % 46(@)(@@) % ولغوا بوقع حوافر في مأزق % ملأوا بهن مسامع الأصلاد % 47(@)(@@) % نجب نفضن له الفرائص خيفة % تحت العرين ، براثن الآساد % 48(@)(@@) % لبست له الحرب المشوبة قبلة % وتعودت منه صدور صعاد % % 49(@)(@@) % ولدت وجوههم العجاجة طلعة % وظبى السيوف ثواكل الاغماد % % 50(@)(@@) % من كل نصل أضمرت أحشاؤه ال % % أرواح وهو حشى بغير فؤاد % PageV01P518 51(@)(@@) % الخيل ترتشف الصعيد بسورها % % طردا ، وتلفظه على الأكتاد % 52(@)(@@) % اقبلن مثل السيل صوب عنقه % % نشز العقاب إلى قرار الوادي % % 53(@)(@@) % وتكاد تمسح من دماء جراحها % % اثار ما نقشت على الاطواد % % 54(@)(@@) % ترجيع قعقعة الشكيم اذا سرت % % لعداتها ، بدل من الإيعاد % 55(@)(@@) % يوم كأن الأرض فيه عانقت % صدر السماء بعارض منقاد % 56(@)(@@) % ويكاد جامحه يثقف في الطلى % % بالطعن اطراف القنا المنآد % % 57(@)(@@) % وكأنهن ، إذا انحنين ، رواكع % صلت إلى قبل من الاكباد % % 58(@)(@@) % وشققن اردية الضغائن بالردى % % من بعد ما شملت قلوب إياد % 59(@)(@@) % ان يسلبوا ضافي الدروع فانهم % % كاسون من علق دروع جساد % % 60(@)(@@) % رجع الضراب رجالهم بعمائم % محمرة ونساهم بحداد % % PageV01P519 61(@)(@@) % لا ينقضون بنى الحقود كأنما % % شيدت طلوعهم على الاحقاد % % 62(@)(@@) % مهج كأنبوب اليراع ، إذا عدا % % روع وعند المطمعات عوادي % % 63(@)(@@) % كادت تطير مخافة لو لم تكن % من شرع الأرماح في أسداد % 64(@)(@@) % بلغت لنا الأرماح كل طماعة % وحوت لنا الاسياف كل مراد % % 65(@)(@@) % انا خل كل فتى اذا ايقظته % % ايقظت كالنضاض أو كالعادي % % 66(@)(@@) % ألف الحسام ، فلو دعاه لغارة % عجلان صاحبه بغير نجاد % % 67(@)(@@) % كفاه تصديها الدماء من القنا % % طورا ، ويصقلها الندى في النادي % % 68(@)(@@) % ان جاد اقنى المعسرين وان سطى % % افنى القنى بمواير الفرصاد % % 69(@)(@@) % من مبلغ الشعراء عني ان لي % % قول الفحول ونجدة الانجاد % % 70 
ms152	(@)(@@) % قد كان هذا الشعر ينزع في الدنا % % عنهم فكان عقالة ميلادي % % PageV01P520 البحر : متقارب تام 1(@)(@@) % أراك ستحدث للقلب وجدا % % اذا ما الظعائن ودعن نجدا % % 2(@)(@@) % بواكر يطلعن نقب الغوير % % شأون النواظر نأبا وبعدا % % 3(@)(@@) % تتبعهم نظرات الصقور % ن هفهفة الطير جدا % % 4(@)(@@) % على قنوين ، ألا من رأى % % ظعائن بالطعن والضرب نجدا % % 5(@)(@@) % نخالسها من خلال القنا % % سلاما ، ونعلم أن لا تردا % % 6(@)(@@) % كأن هوادجها والقباب % يثنين منهن بانا ورندا % % 7(@)(@@) % فما شئت تنسم بالقلب نشرا % وما شئت تقطف بالعين وردا % % 8(@)(@@) % كان قواني انماطها % % قطوع رياض من الطل تندى % % 9(@)(@@) % يصدون عنا بلمع الخدود % ويمنعنا وجدنا أن نصدا % % 10(@)(@@) % كأنا بنجد غداة الوداع % نصادي عيونا من الدمع رمدا % % PageV01P521 11(@)(@@) % وايسر ما نال منا الغليل ان % % لا نحس من الماء بردا % % 12(@)(@@) % اثاروا زفيرا يلف الضلوع % % لف الرياح انابيب ملدا % % 13(@)(@@) % فكل حرارة انفاسه % % تدل على أن في القلب وقدا % % 14(@)(@@) % واني للشوق من بعدهم % % أراعي الجنوب رواحا ومغدى % % 15(@)(@@) % وأفرح من نحو أوطانهم % بغيث يجلجل برقا ورعدا % % 16(@)(@@) % إذا طلع الركب يممته % احيي الوجوه كهولا ومردا % % 17(@)(@@) % وأسألهم عن جنوب الحمى % % وعن أرض نجد ومن حل نجدا % % 18(@)(@@) % نشدتكم الله ، فليخبرن % من كان أقرب بالرمل عهدا % % 19(@)(@@) % هل الدار بالجزع مأهولة % % انار الربيع عليها واسدى % % 20(@)(@@) % وهل حلب الغيث أخلافه % أأحصيتم رمل يبرين عدا % % PageV01P522 21(@)(@@) % وهل أهله عن تنائي الديار % يراعون عهدا ويرعون ودا ؟ % 22(@)(@@) % لئن اقرض الله ذاك النعيم % % فيهم ، لقد كان فرضا مؤدى % % 23(@)(@@) % اعار الزمان ولكنه % % تعقب اعطاؤه فاستردا % % 24(@)(@@) % انا ابن العرانين من هاشم % % ارق القبائل راحا واندى % % 25(@)(@@) % اكنهم للمراميل ظلا % وأثقبهم للمطاريق زندا % % 26(@)(@@) % سراع إلى نزوات الخطوب % % يهزون سمرا ويمرون جردا % % 27(@)(@@) % كان الصريخ يهاهي بهم % % أسودا تهب من الغيل ربدا % % 28(@)(@@) % اذا اغرقوا بيضهم في الطلى % % وساموا القنا من دم الطعن وردا % % 29(@)(@@) % على القب تشغلهن السياط % امام الرعيل عنيفا وشدا % % 30(@)(@@) % رمين السخال ، وقين النفوس % حتى بلغن لغوبا وجهدا % % PageV01P523 31(@)(@@) % فما 
ms153	 اومؤا بصدور الرماح % % يوما إلى القرن إلا تردى % % 32(@)(@@) % سيوف تطيل قراعا وقرعا % % وخيل تعيد طرادا وطردا % % 33(@)(@@) % % قتلا بيوم طعان وصفدا % % 34(@)(@@) % وكم صاف من دارهم سيد % % وقاظ يعالج في الجيد قدا % % 35(@)(@@) % كان الفتى منهم في النزال % % يرى اكبر الغنم ان قيل اودى % % 36(@)(@@) % ولا يحمد العيش في يومه % % اذا لم يلاق من السيف هدا % % 37(@)(@@) % يبيت على ظبتي همة % % يجاثي خصوما من النوم لدا % % 38(@)(@@) % إذا غل أيدي الرجال النعاس % شد على العضب باعا اشدا % % 39(@)(@@) % واصبح تزفيه ريح العجاج % % غضبان اعجل ان يستعدا % % 40(@)(@@) % وسيان من جر عزماته % % وحيدا إلى الروع أو جر جندا % % PageV01P524 41(@)(@@) % يرى مهربا فيلاقي الردى % % لقاء امرىء لا يرى منه بدا % % 42(@)(@@) % مضيء المحيا كأن الجمال % اذا هب منه جبينا وخدا % % 43(@)(@@) % ترى وجهه في حضور الندى % % كالعضب رقرقت فيه الفرندا % % 44(@)(@@) % ينير ويلحم في خفية % إلى أن يحوك من الرأي بردا % % 45(@)(@@) % بني عمنا أين قحطانكم % إذا عب بحر نزار ومدا % % 46(@)(@@) % مضغناكم اذا عددنا قريشا % % ونلهمكم إذ بلغنا معدا % % 47(@)(@@) % هم ألدغوكم حماة الرماح % ولدوكم بظبى البيض لدا % % 48(@)(@@) % حموكم منابت عشب البلاد % تحلوا من النور سبطا وجعدا % % 49(@)(@@) % وساموا بنجد مطاياكم % لما نشطت منه بالغور ردا % % 50(@)(@@) % لنا من تعج الورى باسمه % إلى الله ندعوه في المجد جدا % % PageV01P525 51(@)(@@) % وبيت تهاوى إليه المطي % تهز الدلاء ذميلا ووخدا % % 52(@)(@@) % بنا أنقذ الله هذا العريب % حتى استقام إلى الدين قصدا % % 53(@)(@@) % وذل غواشيه من بعد ما % % سعى في الذلالة سعيا مجدا % % 54(@)(@@) % واخفت زمجرة المشركين % % يفري الجماجم قطا وقدا % % 55(@)(@@) % فاكثر بما طل تلك الدماء % % واعظم بما جر بدرا واحدا % % 56(@)(@@) % وان لنابض تلك العروق % % إذا عدن ينبضن كيا معدا % % 57(@)(@@) % فلا تشمخن يابن أم الضلال % % بجدي وجدت من النار بردا % % 58(@)(@@) % أجار على عجل أخمصيك % زلق الغي اذ كدت تردا % % 59(@)(@@) % واعتق عنقك من سيفه % % فأصبح رأسك حرا وعبدا % % 60(@)(@@) % يزيد على مشتهى الجود جودا % % ويبني على غاية المجد مجدا 
ms154	 % % PageV01P526 61(@)(@@) % نلين عطائفنا للقريب % % ونولي المجانب قربا اجدا % % 62(@)(@@) % وليس لنا شبخ الراحتين % إذا جاد أعطى قليلا وأكدى % % 63(@)(@@) % لقد زجر المجد حتى اصاب % % بنا مطلع النجم لا بل تعدى % % 64(@)(@@) % كذاك مناقبنا فانظروا % % 65(@)(@@) % سبقنا إلى المجد من كان قبلا % % فكيف نقاس بمن جاء بعدا % % PageV01P527 البحر : سريع 1(@)(@@) % لو علمت اي فتى ماجد % % ذات اللمى والشنب البارد % 2(@)(@@) % لما وفى لي موعدي بالنوى % % من غير ذنب ووفى واعدي % % 3(@)(@@) % كالغصن مهزوزا ، ولكنه % يفعل فعل الخطل المائد % 4(@)(@@) % أضللت قلبي فيك عمدا وقد % تعين الثأر على العامد % 5(@)(@@) % فهل لما اضللت من ناشد % % وهل لما ضيعت من واجد % % 6(@)(@@) % قلوبنا عندك معقودة % بطرف ذاك الشادن العاقد % % 7(@)(@@) % افلتنا ثم ثنى طرفه % % تلفت الظبي إلى الصائد % 8(@)(@@) % ما انصف الفاسق في لحظه % % لما أرانا عفة العابد % 9(@)(@@) % تعزز الحب له ذلة % % وناقص الحب إلى زائد % % 10(@)(@@) % والمرء محسود بلذاته % والحب ملذوذ بلا حاسد % % PageV01P528 11(@)(@@) % يا عذبة المبسم بلي الجوى % % بنهلة من ريقك الصارد % % 12(@)(@@) % ارى غديرا شبما ماؤه % % فهل لذاك الماء من وارد % % 13(@)(@@) % من لي به من عسل ذائب % % يجري خلال البرد الجامد % % 14(@)(@@) % انا ابن من ليس بجد له % % من لم يكن بالماجد الجائد % 15(@)(@@) % ولم يكن في سلك آبائه % غير طويل الباع والساعد % 16(@)(@@) % قد حلب الدهر أفاويقه % واتبع الشارد بالطارد % % 17(@)(@@) % لنا الجبال القود مرفوعة % تزل عنها قدم الصاعد % % 18(@)(@@) % لنا الجياد القب أخاذة % على العدى بالامد الزائد % % 19(@)(@@) % لنا القنا والبيض مطواعة % في الضرب يعصين يد الغامد % % 20(@)(@@) % لنا الأسود الغلب في غيلها % % من ثائر باسا ومن لابد % % PageV01P529 21(@)(@@) % من أسد طال به عمره % ومن قريب العمر مستاسد % % 22(@)(@@) % يا أيها العائب لي جهلة % حذار من ارقمي الراصد % % 23(@)(@@) % أقدم النذر ، ولي سطوة % تنفر النوم عن الراقد % % 24(@)(@@) % كلمعة البارق مجتازة % % تقضي على زمجرة الراعد % % 25(@)(@@) % إن كنت ما جربتني ضاربا % فاصبر لما جاءك من ساعدي % % 26(@)(@@) % وهاك من كفي مفروجة % فرج القبا موسية العائد % % 27 
ms155	(@)(@@) % رب نعيم زال ريعانة % % بلسعة من عقرب الحاسد % % 28(@)(@@) % انا الذي ابذل من طارفي % % مثل الذي ابذل من تالدي % % 29(@)(@@) % ما مروتي للناحت المنتحي % % يوما ولا غصني للعاضد % % 30(@)(@@) % اسعى لقوم قعدوا في العلى % % ما أكثر الساعي إلى القاعد % PageV01P530 31(@)(@@) % انا الذي يوطيء اكتافها % % ما رن رمح بيدي مارد % 32(@)(@@) % انا الذي يضرم افاقها % % كأنها معمعة الواقد % 33(@)(@@) % انا الذي يوجر ابطالها % % ضربا كخبط الجمل الوارد % 34(@)(@@) % ما انا للعلياء ان لم يكن % % من ولدي ما كان من والدي % % 35(@)(@@) % ولا مشت بي الخيل إن لم أطأ % % سرير هذا الأغلب الماجد % 36(@)(@@) % فان انلها فكما رمته % % أولا ، فقد يكذبني رائدي % % 37(@)(@@) % والغاية الموت فما فكرتي % % أسائقي أصبح أم قائدي % % PageV01P531 البحر : كامل تام 1(@)(@@) % هل ريع قلبك للخليط المنجد % % بلوى البراق تزايلوا عن موعدي % % 2(@)(@@) % قالوا غدا يوم النوى فتسلفوا % % عضا لأطراف البنان على غد % 3(@)(@@) % رفعوا القباب ، وبينهن لبانة % لم تقضها عدة الغزال الاغيد % % 4(@)(@@) % وغدوا غدو الروض ألبسه الحيا % % نسجين بين مسرد ومعضد % 5(@)(@@) % ووراهم قلب يشاق ومهجة % بردت ردى وغليلها لم يبرد % % 6(@)(@@) % لاثوا خدودهم على عين النقا % % ودمى النمارق والغصون الميد % 7(@)(@@) % وأهلة بتنا نضل بضوئها % % ولقد ترانا بالأهلة نهتدي % % 8(@)(@@) % فسقى ثرى تلك الغصون نباته % ما شاء من سبل الغمام المزبد % % 9(@)(@@) % و لقد مررت على الديار فعزني % % جلدي وكان اعز منه تجلدي % % 10(@)(@@) % لولا مكاثرة الدموع عشية % لعرفت رسم المنزل المتابد % % PageV01P532 11(@)(@@) % لهفي لأيام الشباب على ندى % % أطرافهن وظلهن الأبرد % 12(@)(@@) % أيام أنفض للمراح ذوائبي % % و اروح بين معذل ومفند % % 13(@)(@@) % ومرجلين من الحمام غرانق % مثل الغصون ثيابها الورق الندي % % 14(@)(@@) % متمليين من الشباب كأنهم % أقمار غاشية الظلام الأربد % 15(@)(@@) % صقلت نصول خدودهم بيد الصبا % % مرد العوارض في زمان أمرد % 16(@)(@@) % تستنبط الألحاظ ماء وجوههم % فيكاد ينقع من غضارتها الصدي % % 17(@)(@@) % لا تنفر الحسناء من مسي ، ولا % % تثنى إذا مدت إلى أرب يدي % % 18(@)(@@) % و بياض ما بيني وبين احبتي % % يوم اللقاء من الغراب الاسود 
ms156	 % % 19(@)(@@) % فالان اذ قرع النوائب مروتي % % و ألن معجم عودي المتشدد % % 20(@)(@@) % وقصرن خطوي عن مراهنة الصبا % % فخطوت للذات خطو مقيد % % PageV01P533 21(@)(@@) % البستني برد الوقار ضرورة % % وارينني جدد الطريق الاقصد % % 22(@)(@@) % فاليوم اسلس في القياد وطالما % % منعت فضول عزامتي من مقودي % % 23(@)(@@) % مالي اذل وصارمي لم ينثلم % % بطلى العدى وقناي لم يتقصد % 24(@)(@@) % قد طال في ثوب الهموم تزملي % % فلآخذن لنهضتي من مقعدي % % 25(@)(@@) % و لا ظعنن دجى الظلام بجسرة % % هوجاء تسئل موردا عن موارد % % 26(@)(@@) % في غلمة هدموا ذرى عبدية % % أنضاء خمس للنجاء عمرد % 27(@)(@@) % تصل الدؤوب كأن طالي أنيق % نضح الذفارى بالكحيل المعقد % 28(@)(@@) % مشق الهجير لحومها وتناضلت % % أخفافها بالأمعز المتوقد % 29(@)(@@) % لو عيد من داء الفهاهة واحد % صاحت بها الاعراق دونك فازدد % % 30(@)(@@) % حتى اذا ركبوا الروس من الكرى % % و تصوب العيون بعد تصعد % % PageV01P534 31(@)(@@) % جعلوا الخدود على أزمة ضمر % فتل الكلال قيودهن بلا يد % 32(@)(@@) % مثل الصوارم والدجى أغمادها % % حتى تسل إلى المغار الابعد % % 33(@)(@@) % انافي الضحى سرج الحصان وفي الدجى % % كور على ظهر الأمون الجلعد % 34(@)(@@) % بيدي من الهندي فضل عمامة % % لا بد أعصبها برأس مسود % 35(@)(@@) % إني لأغلط آنفا بمواسي % % وأقيم من عنق الأبي الأصيد % 36(@)(@@) % قل للعدى ان بت اوقد نارها % % ما بيننا أبدا ، إذا لم تخمد % 37(@)(@@) % فدعوا مصاولة الضراغم وانبحوا % % نبح الكلاب على نجوم الأسعد % 38(@)(@@) % لا يغررنكم تناوم ضيغم % % وتناذروا وثبات أغلب ملبد % 39(@)(@@) % الصارم المشهور ينذر نفسه % % فخذوا الحذار من الحسام المغمد % % 40(@)(@@) % وأقارب جعلوا العقوق سجية % يتوارثون سفاهة عن قعدد % PageV01P535 41(@)(@@) % لبسوا لنا زرد النفاق فاصبحوا % % في ذمة الخلق اللئيم الأوغد % 42(@)(@@) % وكانما تلك الضلوع قساوة % % تثنى على قطع الصفاء الجلمد % 43(@)(@@) % قالوا : الصفاح ! فقلت : إن ألية % أن لا أمد يدي بغير مهند % 44(@)(@@) % من كل منجوب الجنان كانه % % في الروع مطرود وان لم يطرد % % 45(@)(@@) % ان عاين النقعين انكر قلبه % % ونجا بناصية الطمر الأجرد % 46(@)(@@) % % عادوه من عي إذا حضر الندي % % 47(@)(@@) % متقدم في لؤمه ميلاده % ومن 
ms157	 الخمول كانه لم يولد % % 48(@)(@@) % قل للذي بالغي سوى بيننا : % اين الغبار من الجبال الركد % % 49(@)(@@) % لا تدنين مواربين دعوتهم % % يوم الطعان فسوفوك إلى الغد % 50(@)(@@) % تركوا القنا تهفو إليك صدوره % والقوم بين مهلل ومغرد % % PageV01P536 51(@)(@@) % حتى اتقوا بك ثم فاغرة الردى % % فنجوا وانت على طريق المزرد % % 52(@)(@@) % قذفوك في غمائها وتباعدوا % % عنها ، وقالوا : قم لنفسك واقعد % 53(@)(@@) % قطع الزمان قبال نعلك ، فانتعل % أخرى تقيك من العثار وجدد % 54(@)(@@) % يصل الذليل إلى العزيز بكيده % % والشمس تظلم من دخان الموقد % % 55(@)(@@) % واشدد يديك إلى الوغى بمغامر % ندب ، لعادات الطعان معود % 56(@)(@@) % لم ينقتش شوك القنا من جلده % % في الروع الا بالقنا المتقصد % % 57(@)(@@) % من كل مربدة النجيع إذا علت % نغراتها قطعت حضور العود % 58(@)(@@) % إن سوموه إلى الرهان ، فإنما % % مسحوا جبين مقلد لمقلد % % 59(@)(@@) % ما عذر من ضربت به اعراقه % % حتى بلغن إلى النبي محمد % 60(@)(@@) % أن لا يمد إلى المكارم باعه % وينال منقطع العلا والسؤدد % % PageV01P537 61(@)(@@) % متحلقا حتى تكون ذيوله % أبد الزمان عمائما للفرقد % 62(@)(@@) % أعن المقادر لا تكن هبابة % وتأزر اليوم العصبصب وارتد % 63(@)(@@) % لا تغبطن على البقاء معمرا % فلقرب يوم منية من مولد % % PageV01P538 البحر : مجزوء الرجز 1(@)(@@) % يا قلب جدد كمدا % % فموعد البين غدا % % 2(@)(@@) % لم أر فرقا بعدهم % بين الفراق والردى % % 3(@)(@@) % يا زفرة هيجها % % حاد من الغور حدا % % 4(@)(@@) % أغنى زفير العاشقي % % عيسه عن الحدا % % 5(@)(@@) % ارعى الحمول ناظرا % مزاحم يقذف في % % 6(@)(@@) % واطرد الطرف على % % اثارهم ما انطردا % % 7(@)(@@) % ومذ أذابوا ماء عي % جمر الغضا ما خمدا % % 8(@)(@@) % % بالاسى ما جمدا % % 9(@)(@@) % يا هل ارى من حاجة % % حقف النقا والجمدا % % 10(@)(@@) % أنا الغلام القرشي % جرعائه وانعقدا % % PageV01P539 11(@)(@@) % وهل أعيد ناظرا % يتبع سربا منجدا % 12(@)(@@) % يمشين هزات القنا % % مال وما تحصدا % % 13(@)(@@) % هل ناشد ينشد لي % % ذاك الغزال الاغيدا % % 14(@)(@@) % ما ضل عني انما % % ضل بقلبي كمدا % % 15(@)(@@) % رهنته قلبي ، ومن % يرهن قلبا أبدا % % 16(@)(@@) % يا منجزا وعيده % % وماطلا ما وعدا % % 17(@)(@@) % أراك مني أقربا % وان 
ms158	 غدوت ابعدا % % 18(@)(@@) % عذبت قلبي عنتا % % والطرف لا القلب بدا % % 19(@)(@@) % رب ثنايا بردت % % لذي جوى ما بردا % % 20(@)(@@) % يا حر قلبي ! من سقي % % رضابهن الابردا % % PageV01P540 21(@)(@@) % لم يدر هل ذاق بها % % جمر غضا أو بردا % % 22(@)(@@) % يا كبدي تجلدا % فما اطيق الجلدا % % 23(@)(@@) % عسى فؤاد يرعوي % % رب مضل وجدا % % 24(@)(@@) % وحمل الحاج الرما % % ح لا الأمون الجلعدا % % 25(@)(@@) % اني اذا ما لم اجد % % إلا الهوان موردا % % 26(@)(@@) % كنت اداوي كبدي % % لو غادروا لي كبدا % % 27(@)(@@) % دع للمشيب ذمة % إن له عندي يدا % % 28(@)(@@) % اعتق من رق الهوى % % مذللا معبدا % % 29(@)(@@) % لكن هوى لي أن أرى % % لون عذاري اسودا % % 30(@)(@@) % % شائبا وامردا % % PageV01P541 31(@)(@@) % ما اخلق البرد فلم % % بدل لي وجددا % % 32(@)(@@) % لولا تكاليفك لم % % أعط الزمان مقودا % % 33(@)(@@) % ولا ثنيت عنقي % % إلى الليالي صيدا % % 34(@)(@@) % سجية من بطل % % لازم ما تعودا % % 35(@)(@@) % بايع اطراف القنا % % وعاقد المهندا % % 36(@)(@@) % شاورت قلبا آبيا % فقال لي لاتردا % % 37(@)(@@) % إني لقوم بعدوا % % في المجد والجود مدى % % 38(@)(@@) % شوس اذا الباغي بغى % % سمح ، إذا الجادي جدا % % 39(@)(@@) % تفرعوا طود العلى % % والجبل العطودا % % 40(@)(@@) % مجدهم أقدم من % هضب القنان مولدا % % PageV01P542 41(@)(@@) % اصادق في الخطب % % للسيف وللمال عدا % % 42(@)(@@) % إذا اهتدى بنارهم % طارق ليل ما اهتدى % % 43(@)(@@) % تقارعوا على القرى % % واقترعوا على الجدا % % 44(@)(@@) % وغارة في سدفة % توقظ حيا رقدا % % 45(@)(@@) % بضمر أسقطها % % عليهم مع الندا % % 46(@)(@@) % تلهب نضا زعزعا % % أو قربا عمردا % % 47(@)(@@) % كانني ابعثها % % فيهم ثنى وموحدا % % 48(@)(@@) % % يوم الحصاب جلمدا % % 49(@)(@@) % من كل محبوك كما % % أمر لاو مسدا % % 50(@)(@@) % يغني الفتى عنانه % عن سوطه اذا عدا % % PageV01P543 51(@)(@@) % كأنما فارسه % يقدع ذئبا أصردا % % 52(@)(@@) % أنزع عن صفحته % شوك القنا مقصدا % % 53(@)(@@) % لو شمته ببارق % ماء الكلاب اوردا % % 54(@)(@@) % وكل صل لامظ % % يطلب ريا للصدى % % 55(@)(@@) % أقدم من سنانه % اذا الجبان عردا % % 56(@)(@@) % ماض ، فإن شم طرو % % ق الضيم زاغ حيدا % % 57(@)(@@) % يلقى الطراد جذلا % كما يلاقي الطردا % % 58(@)(@@) % انا الغلام تالقرشي % % منجبا ما ولدا % % 59 
ms159	(@)(@@) % أنزعت دلوي قبلكم % إلى العراق سؤددا % % 60(@)(@@) % ما زال عزمي لي عن % % دار الهوان مبعدا % % PageV01P544 61(@)(@@) % مرحلي عن بلد % وراجما بي بلدا % % 62(@)(@@) % إن لم يكن نيل منى % % فابغ اذا ورد ردا % % PageV01P545 البحر : طويل 1(@)(@@) % ابر على الانواء فضلي ونائلي % % وطال على الجوزاء قدري ومحتدي % % 2(@)(@@) % يدي ألفت بذل النوال فلو نبت % عن الجود يوما قلت ما هذه يدي % % PageV01P546 البحر : مجزوء الكامل 1(@)(@@) % قل للعدى موتوا بغيظكم % % الغيظ مردي % % 2(@)(@@) % ودعوا على أحرزتها % % يا وادعين بطول جهد % 3(@)(@@) % كم بين ايديكم وبي % % ن النجم من قرب وبعد % % 4(@)(@@) % ولي النقابة خال امي % % قبل ثم أبي وجدي % % 5(@)(@@) % وليتها طفلا ، فهل % مجد يعدد مثل مجدي % % 6(@)(@@) % وأظن نفسي سوف تح % ني على الامر الاشد % % 7(@)(@@) % حتى ارى متملكا % شرق العلى والغرب وحدي % % PageV01P547 البحر : طويل 1(@)(@@) % يفاخرنا قوم بمن لم يلدهم % % بتيم اذا عد السوابق اوعدي % % 2(@)(@@) % وينسون من لو قدموه لقدموا % % عذار جواد في الجياد مقلد % 3(@)(@@) % فتى هاشم بعد النبي وباعها % % لمرمى على أو نيل مجد وسؤدد % % 4(@)(@@) % ولولا علي ما علوا سرواتها % % ولا جعجعوا منها بمرعى ومورد % % 5(@)(@@) % أخذنا عليهم بالنبي وفاطم % طلاع المساعي من مقام ومقعد % 6(@)(@@) % وطلنا بسبطي أحمد ووصيه % % رقاب الورى من متهمين ومنجد % 7(@)(@@) % وحزنا عتيقا وهو غاية فخركم % % بمولد بنت القاسم بن محمد % % 8(@)(@@) % فجد نبي ثم جد خليفة % فما بعد جدينا علي وأحمد % 9(@)(@@) % وما افتخرت بعد النبي بغيره % يد صفقت يوم البياع على يد % PageV01P548 البحر : طويل 1(@)(@@) % نزلنا بمستن المكارم والعلى % % فلم نبق فضلا للرجال ولا مجدا % % 2(@)(@@) % وليس نرى للفضل والمجد دوننا % % على حالة قصدا ولا خلفنا مغدى % % 3(@)(@@) % نماني قروم من ذوائب غالب % % يمدون بي في كل طود على مدا % % 4(@)(@@) % لئن جحدوا اني ابن خير الورى أبا % % فلن يجحدوا أني ابن خير الورى جدا % % PageV01P549 البحر : كامل تام 1(@)(@@) % هذي المنازل بالغميم فنادها % % واسكب سخي العين بعد جمادها % % 2(@)(@@) % إن كان دين للمعالم ، فاقضه % أو مهجة عند الطلول ففادها % % 3 
ms160	(@)(@@) % يا هل تبل من الغليل اليهم % % اشرافة للركب فوق نجادها % % 4(@)(@@) % نؤي كمنعطف الحنية دونه % سحم الخدود لهن ارث رمادها % % 5(@)(@@) % ومناط اطناب ومقعد فتية % % تخبو زناد الحي غير زنادها % % 6(@)(@@) % ومجر أرسان الجياد لغلمة % سجفوا البيوت بشقرها وورادها % % 7(@)(@@) % ولقد حبست على الديار عصابة % % مضمومة الايدي إلى اكبادها % % 8(@)(@@) % حسرى تجاوب بالبكاء عيونها % % وتعط بالزفرات في أبرادها % % 9(@)(@@) % وقفوا بها حتى كان مطيهم % % كانت قوائمهن من اوتادها % % 10(@)(@@) % ثم انثنت والدمع ماء مزادها % % ولواعج الأشجان من أزوادها % % PageV01P550 11(@)(@@) % من كل مشتمل حمايل رنة % % قطر المدامع من حلي نجادها % % 12(@)(@@) % حيتك بل حيت طلولك ديمة % يشفي سقيم الربع نفث عهادها % % 13(@)(@@) % وغدت عليك من الخمايل يمنة % % تستام نافقة على روادها % % 14(@)(@@) % هل تطلبون من النواظر بعدكم % % شيئا سوى عبراتها وسهادها % % 15(@)(@@) % لم يبق ذخر للمدامع عنكم % % كلا ولا عين جرى لرقادها % % 16(@)(@@) % شغل الدموع عن الديار بكاؤنا % % لبكاء فاطمة على أولادها % % 17(@)(@@) % لم يخلفوها في الشهيد وقد رأى % % دفع الفرات يذاد عن أورادها % % 18(@)(@@) % اترى درت ان الحسين طريدة % % لقنا بني الطرداء عند ولادها % % 19(@)(@@) % كانت مآتم بالعراق تعدها % % أموية بالشام من أعيادها % % 20(@)(@@) % ما راقبت غضب النبي وقد غدا % % زرع النبي مظنة لحصادها % % PageV01P551 21(@)(@@) % باعت بصائر دينها بضلالها % % وشرت معاطب غيها برشادها % % 22(@)(@@) % جعلت رسول الله من خصمائها % % فلبئس ما ذخرت ليوم معادها % % 23(@)(@@) % نسل النبي على صعاب مطيها % % ودم النبي على رؤوس صعادها % % 24(@)(@@) % والهفتاه لعصبة علوية % % تبعت امية بعد عز قيادها % % 25(@)(@@) % جعلت عران الذل في آنافها % % وعلاط وسم الضيم في اجيادها % % 26(@)(@@) % زعمت بان الدين سوغ قتلها % % أوليس هذا الدين عن أجدادها % % 27(@)(@@) % طلبت تراث الجاهلية عندها % % وشفت قديم الغل من أحقادها % % 28(@)(@@) % واستأثرت بالامر عن غيابها % % وقضت بما شاءت علي شهادها % % 29(@)(@@) % الله سابقكم إلى أرواحها % % وكسبتم الآثام في أجسادها % % 30(@)(@@) % إن قوضت تلك القباب ، فإنما % % خرت عماد الدين قبل عمادها % % PageV01P552 31(@)(@@) % ان الخلافة اصبحت مزوية % % عن شعبها ببياضها وسوادها % % 32(@)(@@) % طمست منابرها علوج أمية 