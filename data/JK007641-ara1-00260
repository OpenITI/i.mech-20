ms241	 طرا قل كذا % % حكمها شرعا لمن قد سألك % % 5(@)(@@) % يا ابنة العز إلى كم شغفي % % أي يوم يعدم النور الحلك % % 6(@)(@@) % وأنا تلك كما تلك أنا % % وهما الواحد والاثنان لك % % 7(@)(@@) % وكل الكون في الدنيا حجاب % % وفي الأخرى عن الوجه الملاقي % % 7(@)(@@) % قلت لما هي قالت لي وقد % % غلقت أبوابها لي هيت لك % % 8(@)(@@) % وأنت الكأس والأسرار خمر % % ومجلسك التقى والله ساقي % % 8(@)(@@) % ومعاذ الله قولي عندما % % ظهرت لي غيرها خذ أملك % % PageV01P1115 9(@)(@@) % وبدا برهان ربي ظاهرا % % واختفت أغياره عمن سلك % % 9(@)(@@) % فما لك لا تطير هوى وسكرا % % وقد حييت بالكاس الدهاق % % 10(@)(@@) % جل ربي وتعالى فز به % % يا رفيقي وتدارك من هلك % % 10(@)(@@) % أزل نومي بشدوك يا نديمي % % وابدل لي خلافك بالوفاق % % 11(@)(@@) % وحي على المنى يا ابن المعاني % % ولا تفتن بألفاظ رقاق % % 11(@)(@@) % هذه الغفلة نار أوقدت % % فاطفها بالذكر واسبق أجلك % % 12(@)(@@) % وخذ مني وناولني إلى أن % % تراني قد وصلت إلى التراقي % % 13(@)(@@) % ومن بالحق يقذف لاح جهرا % % وما التفت له ساق بساق % % 14(@)(@@) % هناك تضمحل به رسومي % % وأذهب بانسحاق وانمحاق % % 15(@)(@@) % ويبطل كل شيء كان حتى % % مقالي ذا وفهمي مع مذاقي % % PageV01P1116 16(@)(@@) % ويبقى مثل ما قد كان ربي % % على ما كان وهو أجل واقي % % 17(@)(@@) % ويخفى الكون من غير اختفاء % % ويبدو النور من غير انفهاق % % PageV01P1117 البحر : - 1(@)(@@) % كل شيء فيه وفي كل شيء % % هو فاعلم وكل شيء هالك % % 2(@)(@@) % فهو لا غيره وضلت أناس % % جهلوه وهو المليك المالك % % 3(@)(@@) % فارفع الشيء عنه وانظر إليه % % تلقه ناظر إليك كذلك % % 18(@)(@@) % ودنسناه بالافهام حينا % % وبالأقوال والبحث المساق % % 19(@)(@@) % إلى إن جاد غيث الفيض منه % % بماء القدس وانفتحت سواقي % % 20(@)(@@) % إذا قلنا عرفناه جهلنا % % وهل فرع لأوج الأصل راقي % % PageV01P1118 البحر : - 1(@)(@@) % لم أزل في الحب يا أملي % % اخلط التوحيد بالغزل % % 2(@)(@@) % وعيوني فيك ساهرة % % دمعها كالصيب الهطل % % 3(@)(@@) % ليت لي من نور طلعتكم % % لمحة كي تنطفى غللي % % 4(@)(@@) % إن أحشائي بكم تلفت % % بل وجسمي في الغرام بلى % % 5(@)(@@) % واصطباري يوم 
ms242	 جفوتكم % % زال والتهيام لم يزل % % 21(@)(@@) % وريح المسك في الصندوق يفشو % % ويعرف منه قدر الانتشاق % % 22(@)(@@) % وهل نور النجوم يلوح إلا % % على مقدار إدراك المآقي % % 23(@)(@@) % هو الحق المبين وكل شيء % % سواه باطل بالاتفاق % % 24(@)(@@) % قديم لا بمعنى فهم كون % % وباق لا كقول الخلق باقي % % PageV01P1119 البحر : - 1(@)(@@) % إن كنت تدري الرزق في بلدة % % أو في مكان فاطلب الرزقا % % 2(@)(@@) % وإن علمت الحق ينساك من % % رزقك يوما ذكر الحقا % % 3(@)(@@) % وإن دخلت البيت تبغى به % % توكلا كيلا ترى الخلقا % % 4(@)(@@) % فإنها تجربة وهي في % % ربك شك يمنع الصدقا % % 5(@)(@@) % وإنما الحيلة في تركك ال % % حيلة فاتركها لكي ترقى % % 6(@)(@@) % جد لعيني باللقاء ولو % % في الكرى يا غاية الأمل % % 7(@)(@@) % وتلطف بالمشوق ودع % % ذا الجفا واعطف وجد وصل % % 8(@)(@@) % وأبح مضناك بعض لقا % % يا شفا قلبي من العلل % % 9(@)(@@) % يا منى هذا الفؤاد ويا % % بغيتي يا كل متكلي % % 10(@)(@@) % يا ضيا شمسي إذ طلعت % % في الضحى مني وفي الطفل % % PageV01P1120 البحر : - 1(@)(@@) % إنني جمع وفرق % % إنني أمر وخلق % % 2(@)(@@) % إنني عال ودون % % إنني فتق ورتق % % 3(@)(@@) % إنني خير وشر % % إنن كذب وصدق % % 4(@)(@@) % إنني علم وجهل % % وثبوت بل ومحق % % 5(@)(@@) % وأنا الشمس وللشم % % س أنا غرب وشرق % % 6(@)(@@) % وتباهى بي زماني % % وتسامت بي دمشق % % 7(@)(@@) % وعلى أهل زماني % % كلهم سرى يدق % % 8(@)(@@) % إن حقي باطل بل % % باطلي عندي حق % % 9(@)(@@) % وتأمل إنني عن % % نور ذاك الغيب برق % % 10(@)(@@) % ولحسادي مني % % دائما قتل وحرق % % PageV01P1121 11(@)(@@) % وأنا السيف الذي لا % % ينتضى إلا يشق % % 11(@)(@@) % يا مرادي حين قلت ويا % % جل قصدي حين لم أقل % % 12(@)(@@) % دع ضفادع أرضنا في % % أجن الماء تنق % % 12(@)(@@) % خذ أمانا من قلاك لنا % % إننا منه على وجل % % 13(@)(@@) % وكلاب الحق قد أو % % جعلها الليث المشق % % 13(@)(@@) % ثم كن فيما يكون كما % % كنت في أيامك الأول % % 14(@)(@@) % ذا التجافي كم أكابده % % آه قلت في الهوى حيلي % % 14(@)(@@) % فتسلت بنباح % % غيره لا تستحق % % 15(@)(@@) % والذي أهواه ومشتمل % % من ملاح الكون في حلل 
ms243	 % % 15(@)(@@) % وعلى الجملة ما ث % % م سوى الحق محق % % PageV01P1122 16(@)(@@) % وسرت من نحو كاظمة % % نسمة فيها انمحى طللي % % 17(@)(@@) % وبروق الحي لامعة % % حان لما أومضت أجلي % % 18(@)(@@) % هذه الأكوان أجمعها % % شمة من وردة الأزل % % 19(@)(@@) % عطرتني عند ما نفحت % % ما أنا عنها بمشتغل % % 20(@)(@@) % طيب أثواب المليح بدا % % فائحا من جانب الكلل % % 21(@)(@@) % وثغور الزهر قد بسمت % % من روابي أشرف الرسل % % 22(@)(@@) % يا عذولا لا مني سفها % % أنا لا أصغي إلى العذل % % 23(@)(@@) % قلبي المضنى حليف جوى % % عن هوى الغزلانلم يحل % % 24(@)(@@) % مغرم صب بذي عظم % % جل عن علمي وعن عملي % % 25(@)(@@) % ماله في الخلق من شبه % % ماله في الأمر من مثل % % PageV01P1123 البحر : - 1(@)(@@) % إلا أن ذاتي ذات كل الخلائق % % وسل عنه ذا علم كريم الخلائق % % 2(@)(@@) % ولا صفة إلا ومني تعينت % % لموصوفها إذ كنت أصل الرقائق % % 3(@)(@@) % أنا الجوهر الساري بغير سراية % % ألوح وأخفي في جميع الحقائق % % 4(@)(@@) % أنا مركز الأدوار حيث طريقتي % % يؤول إليها أمر كل الطرائق % % 5(@)(@@) % أنا الظاهر المعروف في كل رتبة % % أنا الباطن المخفي بين الخلائق % % 6(@)(@@) % أنا القطب بوابي أنا الغوث خادمي % % أنا الفرد يخشى من دخول مضايقي % % 7(@)(@@) % أنا النور نور العين مني تكونت % % عيون البرايا من مشوق وشائق % % 8(@)(@@) % أنا العلم علم الحق في كل كائن % % ولم يدر قولي في الملا غير ذائق % % 9(@)(@@) % لنا المجلس العالي على أيمن الحمى % % يدار علينا بالكؤوس الروائق % % 10(@)(@@) % لنا الأعين اللاتي بها الحق قد رعى % % رياض التجلي لا رياض الشقائق % % PageV01P1124 11(@)(@@) % مقالة حق انكرتها بصيرة % % سوى الغي منها والردى غير لائق % % 26(@)(@@) % جل عن قولي أجل وعن % % كل خاف لي وكل جلي % % 27(@)(@@) % ذو اتصال غير متصل % % وانفصال غير منفصل % % 28(@)(@@) % لم يمل عن أمره أحد % % دائما في سائر الملل % % 29(@)(@@) % غير أن الأمر منقسم % % للصواب المحض والزلل % % 30(@)(@@) % وانقسام الأمر يظهر في % % مقتضى أشخاصه السفل % % 31(@)(@@) % وهو في العلياء واحدة % % قبل أن يبدو لذي مقل % % 32(@)(@@) % هذه بهى أ ملابسنا % % حلة زرت على بطل 
ms244	 % % 33(@)(@@) % لم نفصلها لغير فتى % % عزمه خالي من الكسل % % 34(@)(@@) % خمرة منها النهى سكرت % % شربة أحلى من العسل % % PageV01P1125 35(@)(@@) % فاقبلونا يا أحبتنا % % وابشروا بالمنزل الجلل % % PageV01P1126 البحر : - 1(@)(@@) % الكل حق والكل باطل % % والكل مستعمل وعاطل % % 2(@)(@@) % والكل ينبوع ماء عين % % والكل غيث المغيث هاطل % % 3(@)(@@) % وعدتنا أن نراك يا من % % في وعده الحق غير ماطل % % 4(@)(@@) % وقد رأيناك بين حق % % سما وجودا وبين باطل % % 5(@)(@@) % ذواتنا فيك حاليات % % وما الحوالي مثل العواطل % % 6(@)(@@) % وكل من لم يكنك خاطي % % وكل من لم تكنه خاطل % % 12(@)(@@) % فقل لنفوس قيدتها عقولها % % إلى كم قيام في ظلام البوائق % % 13(@)(@@) % أمحجوبة عنكم خريدة توبة % % تلوح بوجه كاشف الغيب فائق % % 14(@)(@@) % مشايخكم أطفالنا وكهولكم % % أجنة جهل في بطون العوائق % % 15(@)(@@) % قفوا عند ما تدرونه من ظواهر % % رمتكم بأمر للمهالك سائق % % PageV01P1127 16(@)(@@) % ولا تتعدوا طوركم إن ههنا % % صقي حسام في يد الحق حائق % % PageV01P1128 البحر : - 1(@)(@@) % كشف ألحجب عن عيني % % ونور الوجه قد أشرق % % 2(@)(@@) % وبيني زال من بيني % % ولاح البرق بالأبرق % % 3(@)(@@) % فلا كيفي ولا أيني % % ومن يعلق بنا يغرق % % 7(@)(@@) % وأنت أنت الوجود حقا % % ولا مماري ولا مماطل % % 8(@)(@@) % ونحن لا نحن غير أنا % % لماء إيجادنا قساطل % % PageV01P1129 البحر : - 1(@)(@@) % دمعي لخوفك يا مولاي صار دما % % 2(@)(@@) % والقلب مما به قد شارف العدما % % 3(@)(@@) % فاغفر ذنوب امرئ يرجوك مكتتما % % 4(@)(@@) % وحبي قد وفى في ديني % % بزاهي ثغره الأفرق % % 4(@)(@@) % يا من علا فرأى ما في الغيوب وما % % تحت الثرى وظلام الليل منسدل % % 5(@)(@@) % عبد ذليل فقير الصبر ذاهبه % % 5(@)(@@) % دور % % 6(@)(@@) % جور الزمان وفرط البين ناهبه % % 6(@)(@@) % بدا بالجانب الغربي % % جمال الوجه من سلمى % % 7(@)(@@) % وزال البعد بالقرب % % وطاب المبسم الألمي % % PageV01P1130 7(@)(@@) % يا من على الخلق لا تحصى مواهبه % % 8(@)(@@) % أنت الغياث لمن ضاقت مذاهبه % % أنت الدليل لمن حارت به الحيل % % 8(@)(@@) % ولاح السر في قلبي % % وربى زادني علما % % 9(@)(@@) % فيا بدري ويا زيني % % تجافيك الشجى احرق % % 9(@)(@@) % يرجوك حيث خطوب الدهر طارقة % % 10(@)(@@) % وحيث ألسننا بالحمد ناطفة 
ms245	 % % 10(@)(@@) % دور % % 11(@)(@@) % فالطف فعادات خير منك سابقة % % 11(@)(@@) % سقاني الكاس من نفسي % % وفيه خمرة الأرواح % % 12(@)(@@) % أنا قصدناك والآمال واثقة % % والكل يدعوك ملهوف ومبتهل % % PageV01P1131 12(@)(@@) % فسكري كان عن حسي % % وعن عقلي وعن ما لاح % % 13(@)(@@) % كن غافر يا إلهي ذنب مجترم % % 13(@)(@@) % وقد أخرجت من حبسي % % إلا إطلاق ساقي الراح % % 14(@)(@@) % وصدقي بان من ميني % % وعود الحظ قد أورق % % 14(@)(@@) % يقضي الليالي بدمع فيك منسجم % % 15(@)(@@) % وقد أتيتك والأوزار في عظم % % 15(@)(@@) % دور % % 16(@)(@@) % فإن غفرت فذو من وذو كرم % % وإن سطوت فأنت الحاكم العدل % % 16(@)(@@) % لنا الألحان قد رقت % % وراق الجنك والطنبور % % 17(@)(@@) % وأسراري لقد حقت % % وقلبي بالمنى مسرور % % PageV01P1132 17(@)(@@) % عبد الغني له الأيام رائمة % % 18(@)(@@) % من الصبي وعيون الحظ نائمة % % 18(@)(@@) % وأستارا الحجى انشقت % % وناري بدلت بالنور % % 19(@)(@@) % وعن عيني انمحى غيني % % فكيف الصب لا يأرق % % 19(@)(@@) % فاسعفه يا من به الألباب هائمة % % 20(@)(@@) % دور % % 20(@)(@@) % ثم الصلاة على المختار دائمة % % ما عطر الروض صوب الديمة الهطل % % 21(@)(@@) % لحاك الله يا لاحي % % إلى كم منك هذا اللوم % % 22(@)(@@) % فإني المثيب الماحي % % وإني من رجال اليوم % % 23(@)(@@) % مني ماذقت من راحي % % عرفت العذر عند القوم % % PageV01P1133 البحر : - 1(@)(@@) % جسد في هوى المليح عليل % % وفؤاد للشوق فيه غليل % % 2(@)(@@) % وظهور كما ترى وبطون % % يحصل النقص منه والتكميل % % 3(@)(@@) % وستور تماط عن وجه حق % % فيحق الرجاء والتأميل % % 4(@)(@@) % وبروق بها الظلام ضياء % % ورعود بها العلوم تسيل % % 5(@)(@@) % أيها الركب هذه دار سلمى % % فانزلوها ما خاب فيها التنزيل % % 6(@)(@@) % واسمعوا من فم الوجود كلاما % % لا اعوجاج به ولا تحويل % % 7(@)(@@) % واشربوه عتيقة جددوهما % % بكؤس مزاجها زنجبيل % % 8(@)(@@) % واقرأوه الكتاب لا ريب فيه % % نازل دائما به جبريل % % 9(@)(@@) % وإذا شئتموه فهو مليح % % أغيد زان طرفه التكحيل % % 10(@)(@@) % ملك الحسن وجهه الحق نور % % فوقه التاج لاح والإكليل % % PageV01P1134 11(@)(@@) % وهو في الكون عندنا قرآن % % لا زبور بقى ولا إنجيل % % 12(@)(@@) % وفهوم جميعها أسرار % % وعلوم أتى بها التنزيل % % 24(@)(@@) % تعال ادخل بلا شين % % إلى تيار ذا 
ms246	 المغرق % % 25(@)(@@) % دور % % 26(@)(@@) % جعلت الشرع معقولك % % وربك مقتضى الأفكار % % 27(@)(@@) % فراجع فيه منقولك % % فقبلك عاندت كفار % % 28(@)(@@) % ألم تسلم على قولك % % لربك أنت في إنكار % % 29(@)(@@) % وما بالهين اللين % % مقامي للدما اهرق % % 30(@)(@@) % دور % % 31(@)(@@) % صلاة الله مولانا % % على نور الهدى أحمد % % PageV01P1135 32(@)(@@) % ومن بالحق أولانا % % لنيران العدى أخمد % % 33(@)(@@) % به عبد الغني الآنا % % ذوي الكتذيب قد أكمد % % 34(@)(@@) % جلا بالجمع للرين % % عن القلب الذي أفرق % % PageV01P1136 البحر : - 1(@)(@@) % وجهي بنور الحق في إشراق % % والقيد مني في الهوى إطلاقي % % 2(@)(@@) % فاعطف علينا بالفنا يا باقي % % واكشف لنا أستار وجه الساقي % % 3(@)(@@) % دور % % 4(@)(@@) % عندي جميع الخلق عين الأمر % % مذ راق في الكاسات صرف الخمر % % 5(@)(@@) % والحب فيه طاب طول العمر % % فافخر به في موكب العشاق % % 6(@)(@@) % دور % % 7(@)(@@) % يا لائمي بالله دع من لومي % % وافتح عيون القلب من ذا النوم % % 8(@)(@@) % واحذر من الأغراق كن في عوم % % بحر الهوى يخشى من الأغراق % % 9(@)(@@) % دور % % 10(@)(@@) % للعين أنواع الورى أجفان % % والناظر الرائي هو الإنسان % % PageV01P1137 11(@)(@@) % والفرد لا تلوى به الأكوان % % عن ذلك الفرد الأجل الوافي % % 12(@)(@@) % دور % % 13(@)(@@) % ملة للموحدين نهار % % وعلى المشركين ليل طويل % % 13(@)(@@) % قلبي لأسرار التجلي بيت % % والوصف في مصباح ذاتي زيت % % 14(@)(@@) % والحي من كل البرايا ميت % % في كل أطوار التدلي راقي % % 14(@)(@@) % هجموا بالعقول فاغترفوها % % فإذا في كفوفهم تخييل % % 15(@)(@@) % وأرادوا أن يظفروا فأتاهم % % من هداها الحرمان والتضليل % % 16(@)(@@) % قصدوها تكون طبق هواهم % % فأبت واختفى إليها السبيل % % 17(@)(@@) % فغدوا ينكرون مالم ينالوا % % ولهم بادعائهم تعليل % % 18(@)(@@) % حظهم ثلم حظهم من سواها % % ليس إلا الوسواس والتسويل % % PageV01P1138 19(@)(@@) % هذه الحضرة التي أهلها قد % % منعوها عمن به تطفيل % % 20(@)(@@) % ولتفصيلها بهم إجمال % % ولا جمالها بهم تفصيل % % 21(@)(@@) % وقف القوم حائرين لديها % % وجريح منهم بها وقتيل % % 22(@)(@@) % كلما أومأت إليهم بشيء % % كان للشيء عندهم تفضيل % % 23(@)(@@) % تارة بالجمال فيهم تجلت % % وعليهم فكل شيء جميل % % 24(@)(@@) % وإذا بالجلال كان التجلي % % طال قال من الجهول وقيل % % 25(@)(@@) % يا بني هذه الطريقة أنتم 
ms247	 % % في جنان وماؤكم سلسبيل % % 26(@)(@@) % ولكم رزقكم من الله يأ % % تيكم به منه بكرة وأصيل % % PageV01P1139 البحر : - 1(@)(@@) % عشق ذات الخال عشقي % % وأنا السيف الدمشقي % % 2(@)(@@) % مطلق الحدين صلتا % % بيد الحق المشق % % 3(@)(@@) % اقطع الأعداء للحا % % ل مدى غرب وشرق % % 4(@)(@@) % وبمن عندي تجلى % % أسعد القوم وأشقى % % 5(@)(@@) % فادخل الحضرة يا من % % قصده يزكو بنشق % % 6(@)(@@) % واغترف من بحر علمي % % واقتطف من زهر عشقي % % 7(@)(@@) % وامشقوا يا أيها القو % % م على آثار مشقي % % 8(@)(@@) % واحذروا فالقوس موتو % % ر بتصويب ورشق % % 9(@)(@@) % والقنا السمر استقامت % % لي على طعن وشق % % 27(@)(@@) % فاعبدوه به على الكشف منكم % % وليراع التحريم والتحليل % % PageV01P1140 28(@)(@@) % ثم كونوه بالفنا وليكنكم % % بالبقاء فهو أصل فرع أصيل % % 29(@)(@@) % هي سلمى وكلهم طالبوها % % وإليها كل القلوب تميل % % 30(@)(@@) % ظهرت بالقدود ومنعطفات % % وبوجه كأنه قنديل % % 31(@)(@@) % فرأينا الهدى ولا تشبيه % % قد بقى عندنا ولا تعطيل % % 32(@)(@@) % صاح خفض عليك ليس يريك الح % % ق ذا الانقطاع والتبتيل % % 33(@)(@@) % لمتى الجهل فيك هاهي لاحت % % أين منك التكبير والتهليل % % 34(@)(@@) % لا ترمها إن كنت تبخل بالنف % % س عليها هيهات يحظى البخيل % % 35(@)(@@) % وادخل الدار دارها بخضوع % % لتراها بها وأنت ذليل % % PageV01P1141 البحر : - 1(@)(@@) % عشق المليح الغالي % % أفنى وجود العاشق % % 2(@)(@@) % ما عنه قلبي سالي % % لعرف حسنه ناشق % % 3(@)(@@) % هذا علينا والي % % بالسهم قلبي راشق % % 4(@)(@@) % غيبت عن أخوالي % % ما الصعو مثل الباشق % % 5(@)(@@) % دور % % 6(@)(@@) % لما بدا يتجلى % % بحسن وجه زاهي % % 7(@)(@@) % إليه قلبي صلى % % وما أنا باللاهي % % 8(@)(@@) % وفي هواة كلا % % عنه تراني ساهي % % 9(@)(@@) % وكاتب الأمالي % % في لوح قلبي ماشق % % 10(@)(@@) % دور % % PageV01P1142 36(@)(@@) % وتقرب بما حويت إليها % % فعساها لما طلبت تنيل % % 37(@)(@@) % كم فتى عنه أسفرت وتبدت % % لكن الطرف عمن سناها كليل % % 38(@)(@@) % وهي في الكل تنجلي بثياب ال % % كل لولا التصوير والتمثيل % % 39(@)(@@) % شمس ذات لها النفوس شعاع % % في البرايا والجسم ظل ظليل % % 40(@)(@@) % كل شيء بها لقد صار شيئا % % ولتحقيره بها تبجيل % % 41(@)(@@) % فهي لا غيرها وإن راح جيل % % قد تجلت به وأقبل 
ms248	 جيل % % 42(@)(@@) % والمعاني كثيرة من ضلال % % وهدى لكن الصواب قليل % % 43(@)(@@) % والذي نحن فيه لا يتعتريه النس % % خ طول المدى ولا التبديل % % 44(@)(@@) % فتمسك فقد نصحتك والزم % % وعلى ما أقول ربي الوكيل % % PageV01P1143 البحر : - 1(@)(@@) % العلم والمال عدوان لم % % يجتمعا إلا اقتضى الحال % % 2(@)(@@) % فساد وصف منهما ذلك الآ % % خر فليستيقظ البال % % 3(@)(@@) % فالعلم إن لم يفسد المال في % % وجه الهدى أفسده المال % % 11(@)(@@) % صلى وسلم ربي % % على كثير الأنوار % % 12(@)(@@) % طه نبي القرب % % ومن حبي بالأسرار % % 13(@)(@@) % عبد الغني بالحب % % فيه كثير الأطوار % % PageV01P1144 البحر : - 1(@)(@@) % من يعرف الله فليس يسأل % % والله لا يسأل عما يفعل % % 2(@)(@@) % كما أتى سبعون ألفا تدخل % % لجنة بلا حساب يحصل % % 14(@)(@@) % ما لاح نجم عالي % % في جنح ليل واسق % % PageV01P1145 البحر : - 1(@)(@@) % يا فاضلا فضله يسمو على الفضلا % % 2(@)(@@) % ومن على كل مجد في الأنام علا % % 3(@)(@@) % وعارف ربه لا يجهل % % وهو به لأمره يمتثل % % 3(@)(@@) % أصبحت أهواك لا أبغي السوى بدلا % % 4(@)(@@) % هم يسألون عنه حيث انفصلوا % % بالنفس قاموا إلا به اتصلوا % % 4(@)(@@) % بالله اقسم لا بالعادلات ولا % % بالذرايات ولا بالنجم والفلق % % 5(@)(@@) % والعارف الذي به يتصل % % وجاهل عنه هو المنفصل % % 5(@)(@@) % صبت عليك ولو بالروح ما بخلا % % 6(@)(@@) % وقلبه لم يزل بالشوق مشتعلا % % 6(@)(@@) % معنى انفصاله الحجاب يسدل % % عليه وهو النفس معنى يبطل % % PageV01P1146 7(@)(@@) % في نفسه يقول نفسي يبخل % % بها على الله لها لا يبذل % % 7(@)(@@) % وقد جبتأ الذي عن حالتي سألا % % 8(@)(@@) % إني أحبك لا أرجو نداك ولا % % أخشى أذاك ولا ألقاك بالملق % % 8(@)(@@) % والاتصال ربه لا يعزل % % عنه يوليه عليه فاعقلوا % % 9(@)(@@) % لا ربه في النفس منه يحلل % % أو باتحاد فيه عنه يجلل % % 9(@)(@@) % عيشي برؤياك عيش لم يزل رغدا % % 10(@)(@@) % معبوده به عليه مقبل % % لاذاك معنى في الخيال يافل % % 10(@)(@@) % وصدق حالي لا يخفى وفيك بدا % % 11(@)(@@) % ونفسه بالله قامت تعمل % % فهو الإمام الكامل المكمل % % 11(@)(@@) % وهل أحبك عمري ساعتي وغدا % % PageV01P1147 12(@)(@@) % لا يدعي أمر أفلا التحول % % له ولا القوة فيما 
ms249	 يجعل % % 12(@)(@@) % إلا محبة عبد يرتجى أبدا % % أن لا يفارق معنى وجهك الطلق % % 13(@)(@@) % وكل ذي ذوق له مفصل % % لا أن هذا عنده تخيل % % 14(@)(@@) % والله للخير هو المؤملوالنفس منها كل شيء يفعل وهي وما منها إليه يوكل % والشر لا إليه ينقلسقط بيت ص % % PageV01P1148 البحر : - 1(@)(@@) % هو الحب سهم البعد في القلب راشق % % 2(@)(@@) % وأنفي به عرف المعارف ناشق % % 3(@)(@@) % وقوم رأوا أني على الصيد باشق % % 4(@)(@@) % يقولون لي بالله هل أنت عاشق % % فقلت وهل يوما خلوت من العشق % % 5(@)(@@) % بمحو السوى كم فرج الله كربة % % 6(@)(@@) % وكل في قلب المحقق قربة % % 7(@)(@@) % ومذ عاينت في الغيب عيني أحبة % % 8(@)(@@) % شربته بكاس الحب في المهد شربة % % حلاوتها حتى القيامة في حلقي % % 15(@)(@@) % وفعله لكل فعل يشمل % % لأنه الآخر وهو الأول % % 16(@)(@@) % فالصادق الذي إليه يصل % % بالصدق في التوحيد ذوقا يكمل % % PageV01P1149 17(@)(@@) % عن نفسه بربه مشتغل % % وربه كما يقول المرسل % % 18(@)(@@) % سمع له وبصر وأرجل % % يعنى به ينشط ليس يكسل % % 19(@)(@@) % يصعد بالقرب له لا يسفل % % والرب بالذكر عليه ينزل % % 20(@)(@@) % ثم لديه كل شيء يبطل % % والحق حق فيزول المشكل % % 21(@)(@@) % والله حيث الشر عنه يهمل % % يهمل عن عارفه لا يحمل % % 22(@)(@@) % لأنه مصور ممثل % % يظهر فيه علمه والعمل % % PageV01P1150 البحر : - 1(@)(@@) % ما الغير إلا بابه المغلق % % وكلنا مفعوله المطلق % % 2(@)(@@) % وليس مفعولا به عندنا % % لأننا للفعل لا نسبق % % 3(@)(@@) % وأننا المعنى الذي فعله % % جاء به لما لنا يخلق % % 4(@)(@@) % وليس مفعول به ظاهرا % % بالفعل والسبق له حققوا % % 5(@)(@@) % وقولهم ذا ليس شرطا له % % يرده بالصدر من يصدق % % 6(@)(@@) % بل لك مفعول به سابق % % للفعل قطعا عند من يفرق % % 7(@)(@@) % وكل من يجحد قولوا له % % هات مثالا عندنا يطبق % % 8(@)(@@) % يكون مفعولا به ماله % % سبق على الفعل الذي يلحق % % 9(@)(@@) % فإن يكن حاول في لفظة % % جاء بها في النطق إذ ينطق % % 10(@)(@@) % فأخبروه ليس مقصودنا % % لفظ لنا يأتي به المنطق % % PageV01P1151 11(@)(@@) % وإنما المعنى مردا الذي % % يقول والحق به مشرق % % 23(@)(@@) % وهو لسره 
ms250	 النزيه هيكل % % يروق للوارد منه المنهل % % 24(@)(@@) % طينته للشر ليس تقبل % % وهو على الخير به منجبل % % 25(@)(@@) % فما ترى يصدر منه الزلل % % وبالتقى يضرب فيه المثل % % 26(@)(@@) % تحرسه عين الهدى وتكفل % % والله يعطيه الذي يؤمل % % 27(@)(@@) % وربه حافظه لا يخذل % % في عمره حتى يحل الأجل % % 28(@)(@@) % بعزمه صعب الأمور يسهل % % وهو الذي يقال فيه الرجل % % 29(@)(@@) % شهم همام لوذعي بطل % % يفعل ما يقصر عنه الأسل % % 30(@)(@@) % بدعوة يندك منها الجبل % % ودعوة غيث المنى ينهمل % % 31(@)(@@) % لأن له صم الحصى والجندل % % وانقادت الشم الأنوف الطول % % PageV01P1152 32(@)(@@) % فاسمع مقالا فاح منه المندل % % وفيه قد رق الصبا والشمأل % % 33(@)(@@) % وانكشف الأمر وهان المعضل % % لدى أناس ليس فيهم جدل % % PageV01P1153 البحر : - 1(@)(@@) % إذا كان كلي دائما يشبه البرقا % % فقل لي هنا من ذا يدوم ومن يبقى % % 2(@)(@@) % وما ذلك الباقي سوى الله وحده % % فما بال أقوامي يسمونني خلقا % % 3(@)(@@) % تجددت عن أمر قديم وإنني % % أنا الحادث الموهوم والشبح الملقى % % 4(@)(@@) % وعقلي وروحي للوجود مراتبأنا الشمس في وصف الكمال وما السوى سوى الظل فاستيقن عليه لي السبقا % % ونفسي وجسمي تصحب الجمع والفرقاسقط بيت ص % % 5(@)(@@) % وإن شئتني فاعرف جميع منازلي % % ردع عنك مني الغرب واستقبل الشرقا % % 34(@)(@@) % وخذ بما قال الإمام الأفضل % % وخل عنك ما تقول العذل % % 35(@)(@@) % فإنهم لكل قلب علل % % ويكثر الخطا بهم والخطل % % 36(@)(@@) % وقولهم تقطع فيه السبل % % ويذهب الخير وتمضى الدول % % 37(@)(@@) % لأنهم على الفساد انجبلوا % % فحقهم أن يتركوا أو يهملوا % % PageV01P1154 البحر : - 1(@)(@@) % خلت الأكوان ممنهو في قلبي مقيم % % لا يغيبوبه نلت الكمال % % 2(@)(@@) % فانقلوا يا قوم عمنلي في ليلى نديم % % ذا الحبيبأنا منه كالظلال % % 3(@)(@@) % دور % % 4(@)(@@) % واحد لما تثنى هام فيه ذو الغرام % % والظنونتجعل الفرد الكثير % % 5(@)(@@) % نال منه ما تمنى عاشق البدر التمام % % والعيونكم لها فينا قتال % % 6(@)(@@) % دور % % 6(@)(@@) % ولا زالت الأرواح تسمو بهمتي % % وسر مجالي الغيب لازال بي يرقى % % 7(@)(@@) % لنا الحضرة الزلقى على أيمن الحمى % % وفي لجة الأسما لنا الدرة الفرقا % % 7(@)(@@) % ما على ذا الوجه 
ms251	 حاجبوهو ظاهر لا سواه % % عندناجل من غير شبيه % % 8(@)(@@) % هي الذات عن ذات وعن ألف علت % % وتاء فلا تدري الحروف لها مرقى % % PageV01P1155 8(@)(@@) % فعلينا الموت واجبإنما الموت حياه % % مذ دنابجلال وجمال % % 9(@)(@@) % دور % % 9(@)(@@) % وقد قصرت عنها تراكيب فعلها % % واطلاقها يستوجب الفتق والرتقا % % 10(@)(@@) % هي الاسم وهي الوسم والرسم للورى % % فأيان ما وليت اشهدها تلقا % % 10(@)(@@) % لم يزل ربي يحييللنبي المصطفى % % والصحابكل وقت وزمان % % 11(@)(@@) % ما ورى عبد الغنيعن نبا أهل الوفا % % ذا الكتابوتهنى بالعيال % % 11(@)(@@) % هي الرفرف الأعلى هي المستوى الذي % % يحق له الدعوى هي العروة الوثقى % % 12(@)(@@) % هي الحسن وجها والجمال حقيقة % % فلا بدع إن ذاب الأنام بها عشقا % % 13(@)(@@) % إذا احتجبت متنا وعشنا إذا بدت % % وإن أفرطت في الهجر قلنا لها رفقا % % 14(@)(@@) % يهيم بها قلبي إذا هبت الصبا % % وأسكر شوقا كلما غنت الورقا % % PageV01P1156 15(@)(@@) % حجازية شامية ذات طلعة % % علت من رآها لا يضل ولا يشقى % % 16(@)(@@) % سجدنا إليها وهي راكعة لنا % % بميل مريد ناشق طيبنا نشقا % % PageV01P1157 البحر : - 1(@)(@@) % وجودي جل عن جسمي % % وعن روحي وعن عقلي % % 2(@)(@@) % وعن شرعي وتكليفي % % وعن حكمي وعن نقلي % % 3(@)(@@) % وأمري مطلق حتى % % عن الإطلاق يستعلي % % 4(@)(@@) % وعن ذات وعن وصف % % وعن بعض وعن كل % % 17(@)(@@) % ولاحب إلا حبها عند عاشق % % لها في سواها كذبه لم يزل صدقا % % 18(@)(@@) % وجود بها قامت مراتب ذاته % % لأسمائه بالأمر دافقة دفقا % % 19(@)(@@) % تنزه نع تلك المراتب كلها % % فسحقا لعبد ليس يعرفه سحقا % % PageV01P1158 البحر : - 1(@)(@@) % ألا أيها النور الحقيقي % % على لمعانه مزقت زيقي % % 2(@)(@@) % وملت به أعربد عن طريقي % % فدع عنك الملامة يا رفيقي % % 3(@)(@@) % دور % % 4(@)(@@) % هو الحادي ترنم للمطايا % % وأظهر من جوانحها خبايا % % 5(@)(@@) % وعلمي ليس يدريه % % سوى من لم يزل مثلي % % 5(@)(@@) % وذكرها المباسم والثنايا % % وأسكرها بكاسات الرحيق % % 6(@)(@@) % ولو زال الخطا عن عل % % م أهل العقد والحل % 6(@)(@@) % دور % % 7(@)(@@) % سقى الله الشعاب شعاب نجد % % وإن كان التعلل ليس يجدي % % 7(@)(@@) % لا ضحى علمهم من بح % % ر على قطرة الطل % PageV01P1159 8 
ms252	(@)(@@) % وعلم الخضر في علمي % % وموسى رشحة البل % % 8(@)(@@) % فإني ذبت من شوقي ووجدي % % إلى الأحباب في وادي العقيق % % 9(@)(@@) % دور % % 9(@)(@@) % وإني هدهد الأخبا % % ر للقوم الأولى قبلي % % 10(@)(@@) % ومن قولي أنا أملي % % وإني فوق ما أملي % % 10(@)(@@) % عسى النسمات بالأخبار تاتي % % وتحييني بهم بعد الممات % % 11(@)(@@) % وأحظى من شذاهم بالهبات % % وأفرح في لقا ذاك الفريق % % 11(@)(@@) % على الله قيوم % % بلا شبه ولا مثل % % 12(@)(@@) % وإني ذلك القيو % % م لما قمت عن حملي % % 12(@)(@@) % دور % % PageV01P1160 13(@)(@@) % وقد جردت عن ملكي % % وعن علمي وعن جهلي % % 13(@)(@@) % وصلي الله ربي كل حين % % على خير الورى طه الأمين % % 14(@)(@@) % ومن عبد الغني علي اليقين % % بنصرته له في كل ضيق % % 14(@)(@@) % وعن كيفي وعن إيني % % وعن فوقي وعن سفلي % % 15(@)(@@) % وحقي زال عنه با % % طلي ذو المحق والمحل % % 16(@)(@@) % ووجهي قد غسلت الكو % % ن عنه أيما غسل % % 17(@)(@@) % وإني لست مخلوقا % % ولا شربي ولا أكلي % % 18(@)(@@) % ولا إني أنا الخلا % % ق ذو صنع وذو فعل % % PageV01P1161 البحر : - 1(@)(@@) % كل شيء لنا على التحقيق % % من عدو ومخالف وصديق % % 2(@)(@@) % ومضر ونافع وهو أما % % خادم حال وسعة أو ضيق % % 3(@)(@@) % حكم كلها جميع أموري % % وأمور الورى بحكم دقيق % % 4(@)(@@) % يا ابن ودي هي الشئون تجلت % % فتحلت بها صفات رفيقي % % 5(@)(@@) % تقتضي دورة الشقاء لقوم % % ولقوم سعادة التوفيق % % 6(@)(@@) % طبق ما يعلم الإله قديما % % نفسه في نفوس كل فريق % % 7(@)(@@) % حيرة بل هداية أنتجتها % % صبغة الغيب عند أهل الطريق % % 8(@)(@@) % فاعلمونا أو وفاجهلونا هنا لا % % جهل والكل علم حق حقيقي % % 9(@)(@@) % هو جمع وإن تفرق قومي % % فأنا لا أقول بالتفريق % % 10(@)(@@) % يا لأمر مقدس غاب عنا % % يقذف الخلق من مكان سحيق % % PageV01P1162 11(@)(@@) % نتفانى به فتبقى % % منه نشتم طيب مسك فتيق % % 12(@)(@@) % قيدتنا التوجهات علينا % % منه كيف اقتضت بحكم طليق % % 13(@)(@@) % وهدانا إليه برق التجلي % % في دياجي إمكاننا بالبريق % % 14(@)(@@) % فشربنا هواه ممن وجدنا % % عنده بالدنان والإبريق % % 15(@)(@@) % وأقمنا على المحبة نلقى ال % % غير عنها بحفظ عهد وثيق % % 19 
ms253	(@)(@@) % ولا من أنبياء الل % % ه إني أو من الرسل % % 20(@)(@@) % وإني ما أنا عيسى % % ولا المهدي إلى السبل % % 21(@)(@@) % أنا حارت بي الألبا % % ب لا يدرون ما أصلي % % 22(@)(@@) % أنا الشامي أنا الهندي % % أنا الرومي أنا الصقلي % % 23(@)(@@) % أنا الأكوان بي قامت % % أنا الأفلاك من أجلي % % PageV01P1163 24(@)(@@) % أنا الأملاك تدري بي % % ومني ترتجي بذلي % % 25(@)(@@) % أنا المعروف في الدنيا % % وفي الأخرى بذي الفضل % % 26(@)(@@) % وإني لست إنسانا % % ولا من ذلك النسل % % 27(@)(@@) % ولا بالجن والأملا % % ك والحيوان فاعرف لي % % 28(@)(@@) % ولا من والد لي بل % % ولا أم ولا نجل % % 29(@)(@@) % ولا قومي أرى قومي % % ولا أهلي أرى أهلي % % 30(@)(@@) % وإني ما أنا شيخ % % ولا بالشاب والكهل % % 31(@)(@@) % ولا إني جنين أو % % بمولود ولا طفل % % 32(@)(@@) % وإني مطلق والكل % % في قيد وفي غل % % 33(@)(@@) % ولا يدري جنيد بال % % ذي عندي ولا الشبلي % % PageV01P1164 البحر : - 1(@)(@@) % كيف يا قوم يوصف المخلوق % % بوجود وأصله ممحوق % % 2(@)(@@) % عدم كله وقد قدرته % % أزلا قدرة عليه تحوق % % 3(@)(@@) % فهو شأن مقدر من قديم % % لم يكن للوجود فيه طريق % % 4(@)(@@) % ولقد جاءت النصوص بهذا % % في كتاب وسنة ذا مسوق % % 5(@)(@@) % وإذا كان هكذا الأمر قل لي % % كيف وصف الوجود فيه يليق % % 6(@)(@@) % والذي بالوجود يوصف ماذافإذا الخلق قيل نفس وجود لا بوصف الوجود ذا مرموق % أين يا عقل أنت والتحقيقسقط بيت ص % % 7(@)(@@) % قلت إن الوجود في كل شيء % % واحد كلهم به مطروق % % 8(@)(@@) % طبق ما قيل إنه هو جنس % % وهو للاشتراك فيه يسوق % % 9(@)(@@) % وليك الفرق ظاهرا بذوات % % وشخوص سوى الوجود تروق % % 10(@)(@@) % وإذا كانت الذوات وجودا % % وكذا الشخوص زالت فروق % % PageV01P1165 11(@)(@@) % وغدا الكل واحدا ومحال % % ذاك في العقل ليس فيه وثوق % % 12(@)(@@) % فافهموا يا عقول ذا القول وأدروا % % وادركوا ما ترونه واستفيقوا % % 34(@)(@@) % وما في عالمي غيري % % فخفض عنك يا خلي % % 35(@)(@@) % وما عبد الغني اسمي % % وهذا مقتضى الشكل % % 36(@)(@@) % ولكن عالم الأوها % % م يمشي بي على مهل % % 37(@)(@@) % فيا من رام في الدنيا % % يراني طالبا 
ms254	 وصلى % % 38(@)(@@) % تجرد وانتزع واخرج % % عن الأثواب والنعل % % 39(@)(@@) % وكن صرفا بلا مزج % % وكن روضا بلا بقل % % 40(@)(@@) % وكن خمرا بلا كأس % % وكن شمسا بلا ظل % % 41(@)(@@) % وحقق واقطع الأحبال % % وأمسك دونها حبلي % % PageV01P1166 42(@)(@@) % وصابر واصطبر واعلم % % فليس المسك كالزبل % % 43(@)(@@) % ولا حق اليقين الصر % % ف في الأقساط والعدل % % 44(@)(@@) % كعين أو كعلم لل % % يقين الصائب النبل % % 45(@)(@@) % وسد الباب من غيري % % وعالج وافتتح قفلي % % PageV01P1167 البحر : - 1(@)(@@) % له الغرب من أوج العلى ولنا الشرق % % وما بيننا في مقتضى ذاتنا فرق % % 2(@)(@@) % وهل باسم محيي الدين يمتاز في الورى % % وعبد الغنى إلا من الشجر العرق % % 3(@)(@@) % كلانا وجود واحد وهو ذات من % % لها أنني برق كما إنه برق % % 4(@)(@@) % وما النور إلا النار في نظر السوى % % وللنار إطفاء به ولها حرق % % 46(@)(@@) % صلاة الله من قلبي % % على قلبي بلا فصل % % 47(@)(@@) % على طه رسول الل % % ه نور الفرض والنفل % % 48(@)(@@) % مدى الأيام ماسح ال % % سحاب الجون بالهطل % % PageV01P1168 البحر : - 1(@)(@@) % هذه أثوابهم والحلل % % ليت شعري أين قومي نزلوا % % 2(@)(@@) % نزلوا بالشعب من كاظمة % % هي قلبي والحشى والمقل % % 3(@)(@@) % فانمحت من ذكرهم آثارنا % % وبدا ذاك الغرام الأول % % 4(@)(@@) % بربا نجد وقد ذاب الربا % % وانمحى نجد إذا ما أقبلوا % % 5(@)(@@) % هي الشمس من خلف الجدار تطلعت % % إذا سد خرق منه أظهرها خرق % % 6(@)(@@) % طرقت بها ما خصني من شئونها % % كما كان من تلك الشئون له طرق % % 7(@)(@@) % على سره منه الرضى وهو سرنا % % فمنا علينا ذاك ما غنت الورق % % PageV01P1169 البحر : - 1(@)(@@) % يا من تجلى حتى تملابه الفتى المشتاق % % 2(@)(@@) % ما ثم إلاوجه تجلى بزائد الإشراق % % 3(@)(@@) % كلي اضمحلافصرت ظلالقدرة الخلاق % % 4(@)(@@) % ما ملت كلاوالغير ضلاعن حالة العشاق % % 5(@)(@@) % دور % % 5(@)(@@) % ونسيم الروض لولاهم لما % % نقل الأخبار عمن ينقل % % 6(@)(@@) % يا برق واديربا جيادهيجت للركبان % % 6(@)(@@) % جيرة جاروا على أشواقنا % % وإذا جاروا فمن ذا يعدل % % 7(@)(@@) % شجى فؤاديغناء حادييسوق بالأظعان % % 7(@)(@@) % كل شمس إن رأتهم كسفت % % كل بدر من سناهم يأفل % % PageV01P1170 8(@)(@@) % بالله ناديوالليل هاديمن 
ms255	 للشجي الولهان % % 8(@)(@@) % هذه طلعتهم في كوننا % % مالنا كون ولكن علل % % 9(@)(@@) % لبسونا أو لبسناهم فمن % % هو منا اللابس المشتمل % % 10(@)(@@) % حالة يعرفها العارف قد % % غاب عن إدراكها من يعقل % % 11(@)(@@) % وبها عنها البرايا اشتغلت % % وعجيب فارغ مشتغل % % PageV01P1171 البحر : - 1(@)(@@) % مليح كلنا مظهر % % إلى وجهه الجميل % % 2(@)(@@) % وما يخفى به يظهر % % لأبناء السبيل % % 3(@)(@@) % دور % % 4(@)(@@) % سقاني كاسه الساقي % % على طيب اللحون % % 5(@)(@@) % فزادت منه أشواقي % % ولي صبر قليل % % 6(@)(@@) % دور % % 7(@)(@@) % ألا أيها الحادي % % رويدا بالحمول % % 9(@)(@@) % لقا سعاديأجل زادفي قسمة الأرزاق % % 10(@)(@@) % دور % % 11(@)(@@) % أوفى سلاميعلى التهامى من خص بالمعراج % % PageV01P1172 12(@)(@@) % مع الكرامأهل المقاموسائل الإنتاج % % 13(@)(@@) % آل عظامصحب مراميبهم فلا أحتاج % % 14(@)(@@) % وصرت ساميفي القدر شاميعبد الغني قد فاق % % PageV01P1173 البحر : - 1(@)(@@) % أهملوني من جهلهم بي وهذا % % وصف قومي ما بينهم متناسق % % 2(@)(@@) % وهو إهمال ربهم لهمو فل % % ستعيذوا بالله من شر غاسق % % 3(@)(@@) % وأنا ناظر لهم فكأني % % مصحف قد أقيم في بيت فاسق % % 8(@)(@@) % انخ في يمنة الوادي % % إلى كم ذا الرحيل % % 9(@)(@@) % دور % % 10(@)(@@) % بروق الحي قد لاحت % % على بعد المزار % % PageV01P1174 البحر : - 1(@)(@@) % أيا ساكنين الشرق قد شرقت بكم % % عيوني بدمع حين شامت سنا البرق % % 2(@)(@@) % فقوموا بعذري عندكم إن مبتدا % % غرامي بكم قد كان من أقرب الطرق % % 3(@)(@@) % وما ذاك إلا أنني كنت غافلا % % أظن جداري ليس يؤذن بالخرق % % 4(@)(@@) % فدت يد شرقية قادرية % % بها نشأتي خضراء طيبة العرق % % 5(@)(@@) % فقلت لأهل الغرب لا تعتبونني % % بكم إنني في الجمع من غير ما فرق % % 6(@)(@@) % صعدت بكم أوج العلى وترنمت % % بألحانكم في القلب ساجعة الورق % % 7(@)(@@) % ألا فاعذروا طرف المحب فإنه % % رأى البرق شرقيا فحن إلى الشرق % % 11(@)(@@) % وأزهار الربا فاحت % % بها يشفى العليل % % 12(@)(@@) % دور % % 13(@)(@@) % دعاني منيتي ليلا % % وقد زال الحجاب % % PageV01P1175 14(@)(@@) % وقلبي زاده ميلا % % له لما يميل % % 15(@)(@@) % دور % % 16(@)(@@) % صلاة الله مولانا % % على خير الأنام % % 17(@)(@@) % ومن الله أدنانا % % على نهج الخليل % % PageV01P1176 البحر : - 1(@)(@@) % أسقى نداماى من كاسي وأشرب ما % % أبقوه في الكاس 
ms256	 لي من خمري الباقي % % 2(@)(@@) % فكنت آخرهم شربا وأولهم % % سكرا بما تركوا من بهجة الساقي % % 3(@)(@@) % بقية الله خير قال خالقنا % % فحققوا القول يا قومي وأرفاقي % % 4(@)(@@) % وهذه يد من أهواه وهي يدي % % بلمسها نال كلى عهد خلاقي % % 18(@)(@@) % دور % % 19(@)(@@) % له عبد الغني أهدى % % نظاما كالعقود % % 20(@)(@@) % مدى الأيام ما أهدى % % إلى الحق الدليل % % PageV01P1177 البحر : - 1(@)(@@) % يا قلب أحبانا جسمي بهم بالي % % 2(@)(@@) % بغيرهم لا تبالي بل بهم بالي % % 3(@)(@@) % ويا كراما سواهم زال من بالي % % 4(@)(@@) % لا تحسبوا أنني عن حبكم سالي % % وحقكم لم يزل حالي بكم حالي % % 5(@)(@@) % لحسنكم لا أرى بين الورى شبها % % 5(@)(@@) % قولوا لمن قد أبى عن مجلسي ونبا % % من ذا يوقيك في العقبى من الواقي % % 6(@)(@@) % والعاذلون لقد زادوا بكم عمها % % 6(@)(@@) % هذا المدام وهذا الكاس ممتلئ % % من المدام إلى أطراف أطواقي % % 7(@)(@@) % ترقى وتسقط من أعلى مقامك فيعطشان يحمل ماء في إدواته وليس يدري به من سوء أخلاق % حضيض جهلك بي يا خيبة الراقيسقط بيت ص % % 8(@)(@@) % إن الكرام بحسن الظن قد شربوا % % وسوء ظنك حرمان لرقراق % % PageV01P1178 9(@)(@@) % لابد أن تغلق الباب الذي فتحت % % يد الإله فتبقى خارج الطاق % % PageV01P1179 البحر : - 1(@)(@@) % قطع الجهول زمانه بتغزل % % 2(@)(@@) % إن الجهول عن الجمال بمعزل % % 3(@)(@@) % أنا لا أميل إلى كلام العذل % % 4(@)(@@) % سهري لتنقيح العلوم ألذ لي % % من وصل غانية وطيب عناق % % 5(@)(@@) % إن كنت جئت لدى العدى بنقيصة % % 6(@)(@@) % فهي الكمال وذاك عن خصيصة % % 7(@)(@@) % رفقا بقلبي الذي فيكم قضى ولها % % 7(@)(@@) % طلبي لغالية يبذل رخيصة % % 8(@)(@@) % أرخصتمو في هواكم مدمعي سفها % % وهو العزيز الذي عهدي به غالي % % 8(@)(@@) % وتمايلي طربا بالحل عويصة % % في الذهن أبلغ من مدامة ساقي % % PageV01P1180 9(@)(@@) % من ذا الذي في معاني الفضل يعدلكم % % 9(@)(@@) % سم الجهالة زال من ترياقها % % 10(@)(@@) % وكل شيء من الأشياء فهو لكم % % 10(@)(@@) % وهو العلوم بمقتضى إشراقها % % 11(@)(@@) % حررتها في الطرس باستحقاقها % % 11(@)(@@) % ليس سمواتكم والأرض تشملكم % % 12(@)(@@) % وصرير أقلامي على أوراقها % % أشهى من الدوكاة والعشاق 
ms257	 % % 12(@)(@@) % يا ساكنين فؤادي وهو منزلكم % % لا عشت يوما أراه منكمو خالي % % 13(@)(@@) % عنكم بدا الكون يزهو في لوائحه % % 13(@)(@@) % فانهض لتحصيل العلوم ووفها % % PageV01P1181 14(@)(@@) % حقا بأشرف حالة وأعفها % % 14(@)(@@) % والروض ينفح من ذاكي روائحه % % 15(@)(@@) % وحرمة العهد منكم في سوانحه % % 15(@)(@@) % أني كففت عن السوى بأكفها % % 16(@)(@@) % أنتم بقلبي أدنى من جوانحه % % حقا على رغم حسادي وعذالي % % 16(@)(@@) % وألذ من نقر الفتاة لدفها % % نقري لألقي الرمل عن أوراقي % % 17(@)(@@) % محبكم صادق في طيب مشربه % % 17(@)(@@) % تعلو على أوج المعالي همتي % % 18(@)(@@) % في نيل مقصودي وقرب أحبتي % % 18(@)(@@) % وأفق طلعتكم يزهو بكوكبه % % PageV01P1182 19(@)(@@) % وسر ثبيتت قلبي في تقلبه % % 19(@)(@@) % وأنا الذي عزمي كسيف مصلت % % 20(@)(@@) % يا من يبالغ بالأماني رتبتي % % كم بين منسفل وآخر راقي % % 20(@)(@@) % ما يلتقى مثلكم مثلي يهيم به % % وكم يهيم بكم في الحي أمثالي % % 21(@)(@@) % بكاسنا كلما ذقنا رحيقكمو % % 21(@)(@@) % أصبحت موصوف العلى منعوتة % % 22(@)(@@) % لا أختشي من جانب تفويته % % 22(@)(@@) % ملنا سكارى فشاهدنا بريقكمو % % 23(@)(@@) % يا قاصرا فينا يحاول صيته % % 23(@)(@@) % أحبابنا ليت انقذتكم غريقكمو % % PageV01P1183 24(@)(@@) % أأبيت سهران الدجى وتبيته % % نوما وتبغى بعد ذاك لحاقي % % 24(@)(@@) % أوضحتمو لمحبيكم طريقكمو % % حاشاكمو تهجروني بعد إيصالي % % 25(@)(@@) % إلى اللقا بعثتني كل باعثه % % 26(@)(@@) % لجملتي بحجاب العز وارثة % % 27(@)(@@) % وليلة الفوز منكم في محادثة % % 28(@)(@@) % وحدت حبكمو عن كل حادثة % % وصنته عن دواعي القيل والقال % % 29(@)(@@) % روض الجمال بأزهار الجلال هنى % % 30(@)(@@) % في كل وجه لكم بين الورى حسن % % PageV01P1184 البحر : - 1(@)(@@) % نحن في وادي وغيب الغيب في وادي عميق % % والذي يدخل وادي الغيب منه لا يفيق % % 2(@)(@@) % إنه الوادي الذي كلم موسى ربه % % فيه والتقديس منه بان في أهل الطريق % % 3(@)(@@) % وانطواء الكون فيه أنه وادي طوى % % كل من يسلك فيه فهو من خير فريق % % 31(@)(@@) % والله مذ جئتكم بالفقر رحت غنى % % 32(@)(@@) % وما حدا باسمكم حاد فأطربني % % إلا وجدت له بالروح والمال % % PageV01P1185 البحر : - 1(@)(@@) % خذ الروح عني فاتحا منك دنها % % 2(@)(@@) % وحول عن الصرف السلافة كنها % % 3(@)(@@) % فإن 
ms258	 لم تكن أهلا ولا كنت ذا نهى % % 4(@)(@@) % تأمل سطور الكائنات فإنها % % من الملأ الأعلى إليك رسائل % % 4(@)(@@) % قف معي يا ابن مقامي ههنا دون الحمى % % وتيامن وتياسر واشهد البيت العتيق % % 5(@)(@@) % بحار المعاني ليس تدرك شطها % % 5(@)(@@) % إن أنوار سليمى ليس تختفي في الورى % % إنما المزكوم لا يعرف ما المسك الفتيق % % 6(@)(@@) % هذه لا هذه من يفهم المعنى الذي % % عندنا ينجو من البحر الذي فيه غريق % % 7(@)(@@) % لا تلم مثلي على كشف الغطا كشف الغطاسرت نسمة أم تلك لمعة بارق أم الغيب مدت منه أيدي الرقائقبدا فاختفت آثار كل حقيقة لهذا نكني عنه سر الحقائقهو النور إلا أنه هو ظلمة وضدان أمر مستحيل لذائقهو الحرف في غيب الغيو % % إن مثلي إن مثلي صاحب العهد الوثيقسقط أبيات ص % % PageV01P1186 البحر : - 1(@)(@@) % شعورك والإدراك فعل الذي خلق % % وقد خلق الإنسان أي أنت من علق % % 2(@)(@@) % فكن فعله كن لا تكن شاعرا ولا % % بشيء من الأشياء وارفع به القلق % % 3(@)(@@) % وفق من خمار النفس وابق به له % % تصر صاحيا صحو شديدا على طلق % % 4(@)(@@) % وتنكشف الأشياء عندك كلها % % ويشرق سر الله كالصبح والفلق % % 6(@)(@@) % وحم فوقها بالسبح إن كنت بطها % % 7(@)(@@) % وإياك رفع الكائنات وحطها % % 8(@)(@@) % لقد خط فيها لو تأملت خطها % % إلا كل شيء ما خلال الله باطل % % PageV01P1187 البحر : - 1(@)(@@) % إن قولي مؤبد بالنقول % % وبما تقتضيه كل العقول % % 2(@)(@@) % عند من يعرف اصطلاحي ويدري % % شرح حالي بقصدي المقبول % % 3(@)(@@) % لست ممن يقول عن كل شيء % % إنه الله قول كل جهول % % 4(@)(@@) % قصده يدرأ التكاليف عنه % % مستبيحا أحكام شرع الرسول % % 5(@)(@@) % وتكسف شمس الروح منك فتختفي % % ويخسف بدر النفس من غير ما ملق % % 6(@)(@@) % ويبقى ولا تبقى إلهك وحده % % له الخلق والأمر الجميع به انفلق % % 7(@)(@@) % هناك للإلهام وحي محقق % % فسبحان من للحب قل والنوى فلق % % PageV01P1188 البحر : - 1(@)(@@) % يا صاحبي في الرخا وفي الضيق % % دم حافظا لي على المواثيق % % 2(@)(@@) % هذي يدي قد مددتها لك خذ % % عهدي سريعا بغير تعويق % % 3(@)(@@) % وجود مثلي 
ms259	 وجود تقدير % % وليس هذا وجود تحقيق % % 4(@)(@@) % وهكذا الحادثات أجمعها % % من حين تغريبها لتشريق % % 5(@)(@@) % تصورت كلها لنا صورا % % في الحس والعقل للتزاويق % % 5(@)(@@) % إنني منه كل حين بريء % % بل أنا العبد طالب للقبول % % 6(@)(@@) % وكل هذا له وليس لنا % % شيء من الأمر حكم تحليق % % 6(@)(@@) % وإذا قلت ذاك كان مرادي % % صانع الشيء فاعل المفعول % % 7(@)(@@) % حيث لا شيء جامد هو عندي % % بل كبرق يلوح بين الطلول % % 7(@)(@@) % أما وجود الإله خالقنا % % فهو الحقيقي لأهل توفيق % % PageV01P1189 8(@)(@@) % والذي عنه ذلك الشيء يبدو % % هو رب الفروع رب الأصول % % 8(@)(@@) % وجود حق محقق أبدا % % يعرف لكن بمحض تصديق % % 9(@)(@@) % عن دركه العقل عاجز وكذا % % عن وصفه في مقام تفريق % % 9(@)(@@) % مثل قول الخليل وقت التجلي % % إن هذا ربي بصدق المقول % % 10(@)(@@) % وهو نجم بدا وبدر وشمس % % ثم كان امتيازه بالأفول % % 10(@)(@@) % نراه لكن برؤية حدثت % % لنا غدا لا بوهم تحديق % % 11(@)(@@) % نغيب عنا وعن سواه إذا % % نحن رأيناه حال تشويق % % 11(@)(@@) % أخذ الجاهلون أقوال مثلي % % ثم قالوا بها على المجهول % % 12(@)(@@) % محبة منه والمحب بها % % يكاد منها يغص بالريق % % 12(@)(@@) % لم يذوقوا منها الذي نحن ذقنا % % لا ولم يعرفوا حقيق النزول % % PageV01P1190 13(@)(@@) % هذا اعتقاد الهداة سادتنا % % لا عقد غاو غوى وزنديق % % 13(@)(@@) % إنما قلدوا بحفظ كلام % % وادعاء له بغير حصول % % 14(@)(@@) % كم أعرض السامري عنه وكم % % أباه في الدين كل بطريق % % 14(@)(@@) % وقصاراهم التخيل فهما % % وهو فيهم من غاية المأمول % % 15(@)(@@) % هم عوام لا يعملون وهذا % % هو سر أعيا جميع الفحول % % 15(@)(@@) % تعلقوا كلهم بما عبدوا % % من خلقه فيه أي تعليق % % 16(@)(@@) % حاولته الفحول أن يدركوه % % فأبى من حجابه المسدول % % 16(@)(@@) % وأعرضوا عن سنا عبادته % % جل فنالوا ظلام تحريق % % 17(@)(@@) % وأصبحوا مالهم لديه سوى % % لعنتهم عنه ضمن تسحيق % % 17(@)(@@) % فأزالوا نفوسهم وأتوه % % بافتقار ونائل مبذول % % PageV01P1191 18(@)(@@) % وسعوا نحوه به وأقاموا % % حكمه تاركين قول العذول % % 19(@)(@@) % فتجلى لهم فأفنى هواهم % % ثم أفنى منهم شخوص النحول % % 20(@)(@@) % طحنتهم منه الرحى حين دارت % % ثم جاءت 
ms260	 بهم مجيئ السيول % % 21(@)(@@) % وعليهم تكرر الأمر حتى % % وقعوا في اللقا وأمر مهول % % PageV01P1192 البحر : - 1(@)(@@) % شف ثوب الكائنات % % عن وجود الحق % % 2(@)(@@) % فوجود الحق ذات % % من وراء الخلق % % 3(@)(@@) % فانزعوا الثوب الرفات % % قبل أن ينشق % % 4(@)(@@) % واشربوا ماء الحيات % % إنه قد رق % % 5(@)(@@) % دور % % 6(@)(@@) % حسبت كل العقول % % معه ثاني % % 7(@)(@@) % بتآويل النقول % % دون إيمان % % 8(@)(@@) % وعليها وهم غول % % فهم شيطاني % % 9(@)(@@) % فاثبتوا إن الثبات % % كاشف ما دق % % 10(@)(@@) % دور % % PageV01P1193 11(@)(@@) % كل من رام الشهود % % يرفع الإلباس % % 22(@)(@@) % فهم الفعل منه في كل حال % % وهم الغائبون غيبة غول % % 23(@)(@@) % لهم الاسم فيه من دون رسم % % عن عيان محقق ووصول % % 24(@)(@@) % وعليهم شواهد الصدق لاحت % % ليس تخفى إلا على المخذول % % 25(@)(@@) % هذه أعين إليه صحاح % % انفت من نواظر عنه حول % % 26(@)(@@) % أين منها مقال أهل اتحاد % % بدعاوي الفنا وأهل حلول % % 27(@)(@@) % اعقل الأمر تارك الشرع أعمى % % عن طريق الهدى وتحصيل رسول % % 28(@)(@@) % فهو إن كان مؤمنا فاسق أو % % جاحدا فهو كافر ذو فضول % % 29(@)(@@) % كيف يرقى مالم يتب من خطاه % % محكما قتل حبله المحلول % % 30(@)(@@) % ذاك هيهات لا يكون وإن قد % % كان وقع النصول فوق النصول % % PageV01P1194 31(@)(@@) % أين فهم الشمول والشرب منها % % بافتكار وأين ذوق الشمول % % PageV01P1195 البحر : - 1(@)(@@) % العبد يلهو ويغفل % % والرب أعلى وأسفل % % 2(@)(@@) % بكل شيء محيط % % ويح الذي عنه أجفل % % 3(@)(@@) % فانظر إليه تجده % % بكل شيء تكفل % % 4(@)(@@) % وفي الجهات البواقي % % تشيطنت أم زنفل % % 5(@)(@@) % وساعدتها طباع % % على الجهول المغفل % % 6(@)(@@) % فكلما رام يرقى % % ألهته حتى تسفل % % 7(@)(@@) % ما فاز بالقرب إلا % % لربه من تنفل % % 8(@)(@@) % حتى له صار سمعا % % وناظرا ليس يغفل % % 9(@)(@@) % وقابل الباب فتحا % % من بعد ما كان مقفل % % 12(@)(@@) % تاركا دعوى الوجود % % زائل الإحساس % % PageV01P1196 13(@)(@@) % حافظا شرع الحدود % % ما له وسواس % % 14(@)(@@) % والذي فيه التفات % % بالسوى ملحق % % 15(@)(@@) % دور % % 16(@)(@@) % وعلى طه السني % % صلوات غر % 17(@)(@@) % وعلى آل عني % % ثم صحب طر % 18(@)(@@) % ما شدا عبد الغني % % بنظام الدر % 19(@)(@@) % وحباه بالهبات % % ربه المطلق % % PageV01P1197 البحر 