ms241	 .(@)(@@)(@@)(@@) $ * وأبو حفص عمر بن هرمز .(@)(@@)(@@)(@@) $ * وأبو حفص عمر بن قيس سندل .(@)(@@)(@@)(@@) $ * وأبو حفص عمر بن سليط .(@)(@@)(@@)(@@) $ * وأبو حفص عمر بن سليمان .(@)(@@)(@@)(@@) $ * وأبو حفص عمر بن سهل .(@)(@@)(@@)(@@) $ * وأبو حفص عمر بن نبيل . PageV02P470(@)(@@)(@@)(@@) $ * وأبو حفص عمر بن أيوب موصلي .(@)(@@)(@@)(@@) $ * وأبو حفص عمر بن رياح .(@)(@@)(@@)(@@) $ * وأبو حفص عمر الحمصي .(@)(@@)(@@)(@@) $ * وأبو حفص عمر ، خال ابن أبي يحيى ، مدني .(@)(@@)(@@)(@@) $ * وأبو حفص عمر بن حجاج ( 1 / 152 ) .(@)(@@) سمعت العباس بن محمد قال : سمعت يحيى بن معين يقول : كنية عمر ابن عبد العزيز أبو حفص .(@)(@@)(@@)(@@) $ * وأبو حفص الأبار عمر بن عبد الرحمن .(@)(@@) وقال : قلت ليحيى : لم سمي الأبار ؟ قال : كان يعمل الإبر يضرب بمطرقة ، وكان كوفيا ، وعمي بعد .(@)(@@) والقاسم بن مالك المزني أبو حفص .(@)(@@) قال عباس : وقال لي غير يحيى : إن كنيته القاسم بن مالك أبو جعفر .(@)(@@) 848 - حدثنا عبد الله بن أحمد بن حنبل قال : حدثنا أبي ، قال : حدثنا أبو حفص المعيطي عمر بن حفص ، قال : حدثنا هشام بن عروة ، عن أبيه ، عن عائشة قالت : قال النبي [ صلى الله عليه وسلم ] : ألا تكتنين ؟ قلت : بمن أكتني ؟ قال : اكتني بابنك عبد الله بن الزبير ، قال : فكانت تكنى بأم عبد الله . PageV02P471(@)(@@) 849 - حدثنا علي بن سعيد النسائي ، قال : حدثنا بكر بن بكار ، قال : ثنا عبد الحميد بن جعفر ، عن أمه مندوس بنت علي ، أن أبا بكر بن حزم ، ومحمد بن المنكدر في ناس من أهل المسجد عادوا عمر بن الحكم بن رافع الأنصاري ، قالوا : يا أبا حفص حدثنا ؟ قال : سمعت جابر بن عبد الله يقول : سمعت رسول الله [ صلى الله عليه وسلم ] يقول : من عاد مريضا خاض في الرحمة حتى إذا قعد استنقع [ فيها ] .(@)(@@) 850 - حدثنا أبو عامر بن أبي الهيدام ، قال : حدثنا عمر بن عبد الواحد أبو حفص السلمي ، عن الأوزاعي .(@)(@@) قال : وثنا عبدة بن عبد الله الصفار ، قال : حدثنا عمر بن عامر أبو حفص التمار ، قال : حدثنا عبيد الله بن الحسن العنبري ، قال : أنبأ سعيد الجريري ، عن أبي عثمان النهدي ، قال : سمعت عمر بن الخطاب يقول 
ms242	 : سمعت رسول الله [ صلى الله عليه وسلم ] يقول : إذا التقى الرجلان المسلمان ، فسلم أحدهما على صاحبه ، كان أحبهما إلى الله أحسنهما بشرا بصاحبه .(@)(@@) 851 - حدثنا أحمد بن عبد الله بن عبد الرحيم ، قال : ثنا عمرو بن أبي سلمة ، [ قال : حدثنا أبو حفص عمر بن سليمان ] ، قال : جاءنا كتاب عمر ابن عبد العزيز يقول : إني وجدت المكس وبخسا ، وأن الله عز وجل يقول : ^ ( ولا تبخسوا الناس أشياءهم ولا تعثوا في الأرض مفسدين ) ^ .(@)(@@) 852 - حدثنا محمد بن عوف ، قال : حدثنا إبراهيم بن العلاء قال : حدثنا عمر بن حفص أبو حفص ، قال : رأيت عبد الله بن بشر صاحب النبي [ صلى الله عليه وسلم ] . PageV02P472(@)(@@) 853 - حدثنا أبو بكر بن أبي الدنيا ، قال أخبرني محمد بن الحسين ، قال : حدثنا داود بن المحبر ، قال : حدثنا عمر الخياط أبو حفص ، قال : سمعت مالك بن دينار يقول : رأيت أبا عبد الله مسلم بن يسار في منامي بعد موته ، فسلمت عليه ، فلم يرد علي السلام ، فقلت : ما يمنعك أن ترد علي السلام ؟ قال : أنا ميت ، فكيف أرد السلام عليك ، قلت له : فماذا لقيت يوم الموت ؟ فعدمت عينا مالك عند ذلك ، وقال : لقد لقيت والله أهوالا وزلازل عظاما شدادا قلت : فما كان بعد ذلك ؟ قال : وما تراه يكون من الكريم ، قبل منا الحسنات ، وضمن منا التبعات ، ثم شهق مالك شهقة خر مغشيا عليه .(@)(@@) حدثنا العباس بن محمد ، قال : حدثنا يحيى بن معين ، قال : عثمان بن أبي عاتكة كنيته أبو حفص ، وكان قاص دمشق ، وليس بالقوي .(@)(@@) قال يحيى : وأبو حفص العبدي ليس بشيء .(@)(@@) 854 - حدثنا أبو بكر محمد بن بشار ، قال : أخبرني عمر بن علي أبو حفص المقدمي .(@)(@@) قال : وحدثنا أحمد بن يحيى الصوفي ، وأبو شيبة إبراهيم بن بكر بن أبي شيبة ، قالا : حدثنا عمر بن حفص بن غياث أو حفص .(@)(@@) 855 - أخبرني أحمد بن شعيب ، قال : أنبأ بشر بن الحكم النيسابوري ، قال : حدثنا أبو حفص عمر بن أبي خليفة العبدي ، عن زياد بن مخراق ، [ عن معاوية بن قرة ] ، عن ابن 
ms243	 عمر قال : أرسل رسول [ صلى الله عليه وسلم ] PageV02P473 معاذا وأبا موسى الأشعري إلى اليمن ، فقال : تطاوعا ويسرا ولا تنفرا .(@)(@@) 856 - قال : وأخبرني أحمد بن شعيب ، قال : أنبأ محمد بن يحيى بن أيوب ، قال : ثنا عمر بن هرمز أبو حفص ، قال : ثنا الربيع بن ( 1 / 153 ) أنس ، عن أبي العالية ، قال : كان عمر بن الخطاب يجلس إلي وكنت صائغا أعمل الأواني من الفضة ، وكنت أرى من دخان النخالة يصيبه ، قال : فرفع آنية منها ، فقلت يا أمير المؤمنين ! إني أعمل هذه الأواني ، وأحمل عليها عمالة يدي ، فأبيعه قال : أتجد أحدا يشتريه ، قلت : نعم ، فقال : كلا وزنا بوزن مثلا بمثل .(@)(@@) 857 - حدثنا محمد بن جعفر ، قال : حدثنا شعبة ، عن أبي الفيض ، قال : سمعت أبا حفص الخمصي ، قال : أعطي معاوية المقداد بن الأسود حمارا ، فقبله ، فقال له عرباض بن سارية : مالك أن تاخذه وماله أن يعطيك ، كأني أنظر إليك تحمله على عنقك أعلاه أسفله .(@)(@@)(@@)(@@) $ * وأبو حفص عمر بن أبي سلمة(@)(@@)(@@)(@@) $ * وأبو حفص عمرو بن محمد بن الغاز ، يحدث عنه : الوليد بن مسلم .(@)(@@)(@@)(@@) $ * وأبو حفص عامر بن سعيد خرساني يحدث عنه : عثمان بن خرزاذ .(@)(@@)(@@)(@@) $ * وأبو حفص عبد الرحمن بن الأسود بن يزيد .(@)(@@)(@@)(@@) $ * وأبو حفص عون بن أبي جحيفة .(@)(@@)(@@)(@@) $ * وأبو حفص عثمان بن أبي العاتكة .(@)(@@)(@@)(@@) $ * وأبو حفص حرملة بن عمران المصري .(@)(@@)(@@)(@@) $ * وأبو حفص خالد بن جابر .(@)(@@)(@@)(@@) $ * وأبو حفص أعين ، روى عنه : ابن مهدي . PageV02P474(@)(@@)(@@)(@@) $ * وأبو حفص سعيد بن جهمان .(@)(@@)(@@)(@@) $ * وأبو حفص أغلب بن تميم .(@)(@@)(@@)(@@) $ * وأبو حفص الصائغ .(@)(@@)(@@)(@@) $ * [ وأبو حفص عمرو بن الربيع بن طارق الهلالي ] .(@)(@@) حدثنا العباس بن محمد قال : سمعت يحيى [ بن معين ] يقول : عمرو ابن الرببع بن طارق ، أبو حفص الهلالي ، وكان كوفيا نزل مصر .(@)(@@) 858 - حدثني عثمان بن خرزاذ ، قال : حدثنا عامر بن سعيد أبو حفص الخرساني ، قال : حدثنا هشام بن يوسف ، عن معمر ، عن الزهري ، عن عروة ، عن عائشة ، قالت : قال رسول الله [ صلى الله عليه وسلم ] : سدوا هذه الأبواب الشوارع إلى المسجد ، إلا باب أبي بكر فإني لا أعلم رجلا أحسن يدا 
ms244	 عندي في الصحابة من أبي بكر .(@)(@@) 859 - أخبرني أحمد بن شعيب ، قال : أنبأ عمرو بن علي ، قال : حدثنا عبد الرحمن بن مهدي ، قال : حدثنا أعين أبو حفص ، قال : كنت أخيط كفن أبي العلاء ، فقال أبو المليح : اجعل إزاره مثل إزار الحي .(@)(@@) 860 - حدثنا الحسن بن علي بن عفان ، قال : حدثنا أبو حفص الصائغ ، قال : صليت خلف جعفر بن محمد على جنازة ، فكبر عليها أربعا .(@)(@@) 861 - حدثنا الحسن بن علي بن عفان ، قال : حدثنا معاوية بن هشام القصار ، عن علي بن صالح ، عن أبي حفص الموصلي ، قال : كان ابن عمر وابن عباس وعبد الرحمن بن عوف في سفر فواقع ابن عباس امرأته ، وهو PageV02P475 لا يقدر على الماء ، فعاب عليه ابن عمر ، وعبد الرحمن بن عوف ذلك .(@)(@@)(@@)(@@) $ * وأبو حفص ميسرة .(@)(@@)(@@)(@@) $ * وأبو حفصة الحبشي ، روى عن : عبادة بن الصامت ، روى عنه : علي بن أبي حملة .(@)(@@) حدثني العباس بن محمد ، قال : حدثنا يحيى بن معين ، قال : حدثنا محمد بن أبي حفصة ، هو محمد بن ميسرة أبو حفصة هو ميسرة .(@)(@@) 862 - أخبرنا أبو يعقوب إسحاق بن سويد ، قال : حدثنا حسان بن جبير ، مولى الحبشة ، قال : حدثني خالي أجلح بن أشقر ، أنه حدثه عمه حسان بن أبي مطير ، أنه سمع حبيش بن شريح أبا حفصة الحبشي ، يحدث عن : أبي رويحة الفرعي ، قال : أتيت النبي [ صلى الله عليه وسلم ] ، وهو يؤاخي بين الناس ، فآخى بينهم وبقيت ، فقدم رجل من الحبشة فآخى بيني وبينه ، وقال : أنت أخوه وهو أخوك ( 1 / 154 ) . PageV02P476(@)(@@)(@@)(@@) ||| ( من كنيته أبو الحكم )(@)(@@)(@@)(@@) $ * أبو الحكم زيد بن أبي الشعثاء ، عن : البراء ، حدث عنه : أبو بلج .(@)(@@)(@@)(@@) $ * وأبو الحكم عمران بن الحارثي السلمي .(@)(@@)(@@)(@@) $ * وأبو الحكم عبد الحميد بن حريث بن أبي حريث .(@)(@@)(@@)(@@) $ * وأبو الحكم عبد الله بن فروخ العطار بصري .(@)(@@)(@@)(@@) $ * وأبو الحكم علي بن الحكم البناني ، حدث عنه : أبو الأشهب .(@)(@@)(@@)(@@) $ * وأبو الحكم بشار بن وردان ، عن طارق بن شهاب ، حدث عنه : بشير أبو إسماعيل .(@)(@@)(@@)(@@) $ * وأبو الحكم يزيد بن عياض بن جعدية .(@)(@@)(@@)(@@) $ * وأبو الحكم يوسف بن الحكم .(@)(@@)(@@)(@@) $ * وأبو الحكم 
ms245	 المطلب بن عبد الله بن حنطب .(@)(@@)(@@)(@@) $ * وأبو الحكم معتمر بن نافع الباهلي ، يروي عنه : زيد بن الحباب .(@)(@@)(@@)(@@) $ * وأبو الحكم مخلد بن حازم الجهضمي .(@)(@@)(@@)(@@) $ * وأبو الحكم مروان ، عن : الحسن المجاشعي ، حدث عنه : ابن المبارك .(@)(@@)(@@)(@@) $ * وأبو الحكم الحسن ، يحدث عن : رباح بن الحارث ، يحدث عنه : يزيد ابن هارون .(@)(@@)(@@)(@@) $ * وأبو الحكم جنادة بن رستم الكوفي .(@)(@@)(@@)(@@) $ * وأبو الحكم حوط . PageV02P477(@)(@@) 863 - حدثني أبو عون محمد بن عمرو بن عون الواسطي ، قال : حدثنا أبي ، قال : حدثنا هشيم بن أبي بلج ، عن زيد أبي الحكم العنزي ، عن البراء ابن عازب ، قال : قال رسول الله [ صلى الله عليه وسلم ] : إذا التقى المسلمان فتصافحا وحمدا الله واستغفرا ، غفر لهما .(@)(@@) حدثنا العباس بن محمد الدوري قال : حدثنا يحيى [ بن معين ] قال : حدثنا محمد بن الحسن الواسطي ، قال : حدثنا أبو الحكم بن عبد الرحمن بن فروخ العطار ، قال : كان ابن سيرين يذكر أوزانه كيلا تنقص إذا احتكت .(@)(@@) قال يحيى : وعبد الرحمن أبي نعم أبو الحكم .(@)(@@) 864 - حدثنا يزيد بن سنان ، قال : حدثنا موسى بن إسماعيل ، قال : حدثنا حماد بن سلمة ، عن علي بن الحكم أبي الحكم ، عن أبي الحسن ، أن عمرو بن مرة الجهني قال لمعاوية : إني سمعت رسول الله [ صلى الله عليه وسلم ] يقول : ما من وال يغلق بابه عن ذوي الحاجة والخلة والمسكنة إلا أغلق الله أبواب السماء عن خلته وحاجته ومسكنته .(@)(@@) حدثنا العباس بن محمد الدوري قال : حدثنا يحيى بن معين قال : سيار أبو الحكم ، هو : سيار بن أبي سيار ، وكان مساور الوراق أخاه لأمه .(@)(@@) قال : وسيار أبو الحكم سمع منه : شعبة ، ولم يسمع منه : سفيان الثوري . PageV02P478(@)(@@) حدثني عبد الله بن أحمد ، قال : سئل أبي ، عن سيار أبي الحكم ، فقال : هو سيار بن أبي سيار ، روى عنه : شعبة وهشيم .(@)(@@) وأبو سيار أظنه قال : [ هو ] ابن وردان .(@)(@@) 865 - حدثنا محمد بن عبد الرحمن بن أشعث ، ويزيد بن عبد الصمد ، قالا : حدثنا أبو مسهر ، عن سعيد بن عبد العزيز ، قال : قال يونس بن ميسرة ابن حلبس : لعبد الحميد بن حريث 
ms246	 بن أبي حريث : يا أبا الحكم ! إنك قد كنت عودتنا عادة : كنت لا تزال تصنع الخبيص وتدعونا إليه ، ثم تركت ذلك ، فقال : يا أبا حلبس ! أما القدر التي كان يعمل فيها عندنا ، وأما الجارية التي كانت تعمله ، فهي صافية ، فقد عرفتها ، فعوك بسمن وعسل ، ثم ادع بمن شئت ، فقال ابن حلبس : إنا لله وإنا إليه راجعون ، أما والله لولا مودة كانت بيني وبين أبيك ، لما كلمتك أبدا ، إنه ذهب أهل الجود ، وبقينا في السفارين .(@)(@@) اللفظ لابن أشعث ، وقال يزيد : القسقارين .(@)(@@) 866 - حدثنا عمرو بن علي ، قال : حدثنا عبد الرحمن بن مهدي ، قال : حدثنا ابن الأشعث ، عن علي أبي الحكم ، عن أبي هريرة ، عن النبي [ صلى الله عليه وسلم ] PageV02P479 قال : إن مما أخشى عليكم شهوات الغي في بطونكم وفروجكم ومضلات الأهواء .(@)(@@) 867 - حدثنا محمد بن بشار ، قال : حدثنا محمد بن جعفر ، قال : حدثنا شعبة ، عن يعلى بن عطاء ، قال : سمعت يوسف بن ( 1 / 155 ) الحكم أبا الحكم ، يقول : سمعت عبد الله بن عمر يسأل عن الصوم في السفر ؟ فقال : أرأيت لو تصدقت ، فردت عليك أكنت تكره ذلك ؟ قال : نعم ، قال : فإن الإفطار في السفر صدقة تصدق الله بها عليكم .(@)(@@) 868 - أخبرني أحمد بن شعيب ، قال : أنبأ عبد الحميد بن محمد ، قال : حدثنا مخلد ، قال : حدثنا بشير أبو إسماعيل ، عن سيار أبي الحكم ، عن طارق عن ابن مسعود ، قال : قال رسول الله [ صلى الله عليه وسلم ] : اقتربت الساعة ، ولا يزداد الناس على الدنيا إلا حرصا .(@)(@@) 869 - قال : [ و ] أخبرني أحمد بن شعيب ، قال : حدثنا العباس بن عبد العظيم ، قال : أخبرني عبد الله بن سنان ، قال : حدثنا ابن المبارك ، قال : حدثنا مروان أبو الحكم عن الحسن المجاشعي ، قال : قيل لعامر بن عبد قيس : أتحدث نفسك في الصلاة ؟ قال : نعم ، أحدث نفسي بالوقوف بين يدي الرب عز وجل ومنصرفي من بين يديه .(@)(@@) 870 - حدثنا أحمد بن منصور أبو بكر ، قال : حدثنا يزيد بن هارون ، قال : أنبأ الحكم بن الحكم ، قال : حدثنا رياح بن الحارث 
ms247	 ، قال : كنت إلى جنب عمار بن ياسر بصفين وركبتي تمس ركبته ، فقال له رجل : كفر أهل الشام ، فقال عمار : لا تقل ذاك : ديننا ودينهم واحد وقبلتنا وقبلتهم واحدة ، PageV02P480 ولكنهم قوم مفتونون جاوزوا عن الحق ، حق علينا أن نقاتلهم حتى يرجعوا .(@)(@@) 871 - حدثنا عبد الله بن أحمد بن أبي ميسرة ، قال : حدثنا خلاد بن يحيى ، قال : حدثنا الحسن بن عمارة ، عن حوط أبي الحكم ، عن أبي الضحى ، عن مسروق ، عن عبد الله بن مسعود قال : ما نسيت من الأشياء فلم أنس تسليم رسول الله [ صلى الله عليه وسلم ] عن يمينه وعن شماله السلام عليكم ورحمة الله .(@)(@@)(@@)(@@) ||| ( من كنيته أبو حكيم )(@)(@@)(@@)(@@) $ * أبو حكيم الحسن بن حكيم ، روى عنه : وكيع .(@)(@@)(@@)(@@) $ * وأبو حكيم يوسف بن أبي حكيم .(@)(@@)(@@)(@@) ||| ( من كنيته أبو حكيمة )(@)(@@)(@@)(@@) $ * أبو حكيمة عصمة البصري .(@)(@@)(@@)(@@) $ * وأبو حكيمة روى عن : علي بن أبي طالب .(@)(@@) 872 - حدثنا محمد بن بشار ، قال : حدثنا حماد بن مسعدة ، قال : حدثنا قرة ، عن عصمة أبي حكيمة ، قال : سمعت أبا عثمان النهدي يقول : سمعت عمر بن الخطاب يقول : [ وهو ] يطوف بالبيت ، يقول : اللهم إني كنت PageV02P481 كتبت علي ذنبا أو إثما فاغفر لي وامحه عني فإنك تمحو ما تشاء وتثبت وعندك أم الكتاب .(@)(@@) 873 - حدثنا أبو محمد الحسن بن علي بن عفان ، قال : ثنا حسين بن علي الجعفي ، قال : ثنا عبد الرحمن بن الأصبغ الحضرمي ، عن أبي الضحاك الحضرمي ، عن أبي حكيمة ، قال : كنا في المسجد فجاء رجل فتنقص أبا بكر رضي الله عنه وعمر رضي الله عنه ، وأظهر لعثمان رضي الله عنه الشتيمة ، قال : فدخلت على علي رضي الله عنه ، فقلت : يا أمير المؤمنين هذا رجل في المسجد تنقص أبا بكر وعمر وأظهر لعثمان الشتيمة ، فقال : علي به ، فقال : من يشهد على هذا ؟ قال : فشهدت ومن كان معي ، فأمر به فديس ، ثم قال : أخرجوا هذا إلى السوق حتى يراه الناس فيعرفونه ، ثم أخرجوه فلا يساكنني ، ثم قام وقمنا معه حتى صعد المنبر فحمد الله وأثنى عليه ، ثم قال : إن خير هذه 
ms248	 الأمة بعد نبيها أبو بكر وعمر ، ولشئت أن أسمي الثالث لسميته .(@)(@@) 874 - حدثنا ابن أبي بزة ، قال : حدثنا أبو جابر ، قال : حدثنا عبد الله ابن شداد الجزائري ولم أسمع منه غيره ، عن عبيد الله بن سليمان ، قال : سمعت أبا حكيمة ( 1 / 156 ) يقول : كنت أكتب المصاحف بالكوفة فمر بي علي ابن أبي طالب ، فنظر إلى كتابتي ، ثم قال لي : قط من قلمك فقططت من قلمي ، ثم كتبت أجلي من ذلك ، فقال : هكذا نوره كما نوره الله ، والله أعلم . PageV02P482(@)(@@)(@@)(@@) ||| ( من كنيته أبو حلبس وغيره )(@)(@@)(@@)(@@) $ * أبو حلبس يزيد بن ميسرة .(@)(@@)(@@)(@@) $ * وأبو حلال العتكي .(@)(@@)(@@)(@@) $ * وأبو حليمة معاذ بن الحارث .(@)(@@)(@@)(@@) $ * وأبو حلبس خليد بن دعلج .(@)(@@) حدثنا العباس بن محمد ، قال : سمعت يحيى بن معين يقول : أبو حلال العتكي اسمه ربيعة .(@)(@@) 875 - حدثنا العباس بن محمد قال : سمعت يحيى [ بن معين ] يقول : حدثنا عبيد الله بن ثور بن أبي الحلال ، قال : حدثنا الحلال بن ثور ، عن عبد المجيد بن وهب ، عن أبي الحلال ، قال : سألت عثمان بن عفان ، عن جائزة السلطان ، فقال : لحم ظبي ذكي .(@)(@@) قال يحيى : وأبو الحلال اسمه ربيعة بن زرارة .(@)(@@) قال : وحدثنا العباس ، قال : سمعت يحيى يقول : حدثنا عبيد الله بن أبي الحلال ، قال : حدثتني أمي ، عن عمتها قالت : كان لأبي الحلال يوم مات مائة وعشرون سنة .(@)(@@) 876 - حدثنا ابن أبي ميسرة ، قال : حدثنا أبو عبد الرحمن المقرئ ، PageV02P483 قال : حدثنا جرير بن حازم ، قال : حدثنا غيلان بن جرير ، عن أبي الحلال العتكي ، قال : سألت عثمان بن عفان ، عن رجل جعل أمر امرأته بيدها ، قال : فأمرها بيدها .(@)(@@) حدثني عبد الله بن أحمد ، قال : أخبرني أبي ، قال : حدثنا عبيد الله بن ثور بن عون بن أبي الحلال ، قال : أخبرني الحلال بن ثور يعني أخاه ، عن عبد المجيد بن وهب ، عن أبي الحلال ربيعة بن زرارة .(@)(@@) قال : وحدثني عبد الله ، قال أخبرني أبي ، قال : ثنا عبيد الله بن ثور ، قال : حدثتني أمي ، عن العيناء بنت أبي الحلال ، قال عبيد الله : وحدثتنا زينة بنت أبي الحلال 
ms249	 ، أن أبا الحلال مات يوم مات وهو ابن مائة وعشرين سنة .(@)(@@) قال : وحدثني موسى بن سهل ، قال : حدثنا آدم بن أبي إياس ، قال : حدثنا الليث بن سعد ، عن معاوية بن صالح ، عن أبي حلبس يزيد بن ميسرة ، قال : سمعت أم الدرداء تقول : سمعت أبا الدرداء يقول : سمعت أبا القاسم يقول : ما سمعته قبلها ولا بعدها يكنيه .(@)(@@) 877 - وروى أبو صالح الراسبي ، قال : حدثنا موسى بن مروان ، قال : حدثنا بقية ، عن أبي حلبس خليد بن دعلج ، عن معاوية بن قرة ، عن أبيه ، قال : قال رسول الله [ صلى الله عليه وسلم ] : من حضرته الوفاة فكانت وصيته على كتاب الله كانت كفارة لما نزل [ به ] خير زكاته في حياته .(@)(@@) قال أبو بشر : هذا حديث معضل يكاد أن يكون باطلا . PageV02P484(@)(@@)(@@)(@@) ||| ( من كنيته أبو حمزة )(@)(@@)(@@)(@@) $ * أبو حمزة أنس بن سيرين .(@)(@@)(@@)(@@) $ * وأبو حمزة أخضر بن سحيط ، روى عنه : صدقة بن يزيد .(@)(@@)(@@)(@@) $ * وأبو حمزة عبد الله بن سليمان ، يحدث عنه : الفضل بن فضالة .(@)(@@)(@@)(@@) $ * وأبو حمزة عبد الله بن جابر ، حدث عنه : حكام بن سلم .(@)(@@)(@@)(@@) $ * وأبو حمزة إسحاق بن الربيع ، يروي عن : الحسن بصري .(@)(@@)(@@)(@@) $ * وأبو حمزة عبد الرحمن بن أبي عبد الله ، حدث عنه : شعبة .(@)(@@)(@@)(@@) $ * وأبو حمزة عبد العزيز الحبطي .(@)(@@)(@@)(@@) $ * وأبو حمزة عبد الواحد بن ميمون ، روى عن : عروة بن الزبير .(@)(@@)(@@)(@@) $ * وأبو حمزة عمران بن أبي عطاء القصاب واسطي ، روي عنه : سعيد ، وهشيم .(@)(@@)(@@)(@@) $ * وأبو حمزة صبيح الثعلبي .(@)(@@)(@@)(@@) $ * وأبو حمزة خالد بن يزيد الهدادي ، روى عن : قتادة .(@)(@@)(@@)(@@) $ * وأبو حمزة طلحة بن يزيد كوفي .(@)(@@)(@@)(@@) $ * وأبو حمزة محمد بن كعب القرظي .(@)(@@)(@@)(@@) $ * وأبو حمزة محمد بن ميمون السكري .(@)(@@)(@@)(@@) $ * ( 1 / 157 ) وأبو حمزة ميمون ، عن أبي صالح ، مولى أم سلمة ، روى عنه : عبد الوارث .(@)(@@)(@@)(@@) $ * وأبو حمزة هارون بن المغيرة الرازي .(@)(@@)(@@)(@@) $ * وأبو حمزة سوار بن داود حدث عنه : وكيع . PageV02P485(@)(@@)(@@)(@@) $ * وأبو حمزة سوار ، يروي عن : طارق بن شهاب .(@)(@@)(@@)(@@) $ * وأبو حمزة سوار ، يروي عن : عبد الرحمن بن أبي بكرة .(@)(@@)(@@)(@@) $ * وأبو حمزة سعد بن عبيدة .(@)(@@)(@@)(@@) $ * وأبو حمزة ثابت بن أبي صفية .(@)(@@)(@@)(@@) $ * وأبو حمزة يزيد التمار .(@)(@@) 878 - حدثني 
ms250	 محمد بن يعقوب بن الفرجي ، قال : حدثنا شباك بن عمرو القيسي بن عمر بهدبة ، قال : حدثنا سعيد بن عامر ، قال : حدثنا [ أسماء ] بن عبيد ، عن أنس بن سيرين ، قال : لما ولدت ذهب بي أبي إلى أنس بن مالك فسماني أنسا وكناني بأبي حمزة .(@)(@@) سمعت العباس [ بن محمد ] يقول : [ سمعت يحيى بن معين يقول ] : أبو حمزة [ ثابت ] ، هو ختن أبي عبد الرحمن السلمي ، يروي عن : أبي حمزة هذا إسماعيل بن أبي خالد .(@)(@@) سمعت العباس بن محمد قال : سمعت يحيى بن معين يقول : إسماعيل ابن أبي خالد ، يروي عن أبي حمزة ، عن علي في الفجر ، فقال يحيى : أبو حمزة هذا سعد بن عبيدة . PageV02P486(@)(@@) في موضع آخر : قد روى إسماعيل بن أبي خالد ، عن أبي حمزة ، وهو سعد بن عبيدة ، قلت ليحيى : سمع إسماعيل ، عن سعد بن عبيدة ، قال : لم لا يسمع منه ؟ .(@)(@@) قال : وأبو حمزة صاحب إبراهيم اسمه ميمون .(@)(@@) قال : وأبو حمزة الثمالي ثابت ، قلت : أيهما أحب إليك ؟ قال : لاذا ولاذاك .(@)(@@) وأبو حمزة الذي يروي عنه : عمرو بن مرة ، هو طلحة بن يزيد .(@)(@@) وقال يحيى : سيار أبو حمزة كوفي ، روى سيار هذا عن : قيس بن أبي حازم ، وهو غير سيار صاحب الشعبي ، ذاك يقال له : سيار بن أبي سيار ، ويقال له : سيار العنزي ، وهو سيار أبو الحكم .(@)(@@) 879 - حدثنا العباس ، قال : حدثنا يحيى ، قال : حدثنا وكيع ، عن سفيان ، عن الحسن بن عمرو ، عن أبي حمزة القرشي ، عن ابن عباس ، أنه أحرم من الشام في شتاء شديد .(@)(@@) قال يحيى : عن وكيع يقول : عن حمزة القرشي ، ولم يقل عن أبي حمزة ، وكان يحيى الزمن قال : عن حمزة القرشي أميل منه إلى حديث وكيع ، عن أبي حمزة ، ويقول : حمزة هو الصواب . PageV02P487(@)(@@) حدثني عبد الله بن أحمد ، عن أبيه ، قال : أبو حمزة جار شعبة أراه يقال : يحدث عنه شعبة ، وسيار بن أبي سيار أبو الحكم ، ويقال : ابن وردان يحدث عنه : شعبة .(@)(@@) حدثني عبد الله [ بن أحمد ] ، عن أبيه ، قال : حدثنا عمرو بن مجمع ، قال : حدثنا يونس 
ms251	 بن خباب أبو حمزة ، قال : سمعت أبي يقول : أبو حمزة عبد الله بن جابر .(@)(@@)(@@)(@@) $ * وأبو حمزة السكري .(@)(@@)(@@)(@@) $ * وأبو حمزة هارون بن المغيرة من أهل الري .(@)(@@)(@@)(@@) $ * وأبو حمزة صاحب إبراهيم : متروك الحديث .(@)(@@) 880 - أخبرني عبد الله بن أحمد قال : حدثنا يحيى ، قال : حدثنا هشيم ، عن أبي حمزة عمران بن أبي عطاء ، قال : ثنا عمران بن بكار البراد ، قال : ثنا أبو المغيرة ، قال : حدثنا صفوان بن عمرو ، قال : حدثني أبو حمزة مولى أبي مريم الغساني ، قال : كان طلحة بن عبيد الله مع رسول الله [ صلى الله عليه وسلم ] يوم أحد في الصف فأقبل سهم يهوي فأصابه في أصبعه ، فقال : حس ، فقال رسول الله [ صلى الله عليه وسلم ] : ألا قلت بسم الله ؟ لو قلت بسم الله لدخلت الجنة .(@)(@@) 881 - حدثنا النضر بن سلمة ، قال : حدثنا عمر بن سهل المازني ، قال : حدثنا إسحاق بن الربيع أبو حمزة العطار ، عن الحسن ، عن أنس بن مالك ، قال : ما أعرف من الناس اليوم شيئا كنا عليه على عهد رسول الله PageV02P488 [ صلى الله عليه وسلم ] ( 1 / 158 ) : إلا قول لا إله إلا الله ، فقال له رجل : إلا الصلاة يا أبا حمزة ، فقال : أو لستم قد أحدثتم في الصلاة .(@)(@@) 882 - حدثنا بكار بن قتيبة ، قال : حدثنا ابن عمر الضرير ، قال : ثنا هشيم بن بشير ، عن أبي حمزة ، قال أبو عمر ، واسمه عمران بن أبي عطاء ، قال : رأيت عبد الله بن عباس يصلي في نعليه ولا يخلعهما .(@)(@@) 883 - حدثنا بكار بن قتيبة ، قال : حدثنا هلال بن يحيى ، قال : حدثنا أبو عوانة ، عن أبي حمزة ، قال : رأيت ابن عباس إذا صلى خلع نعليه ، وأخذهما الغلام بيده حتى يصلي .(@)(@@) سمعت العباس يقول : سمعت يحيى يقول : أبو حمزة صاحب ابن عباس عمران بن أبي عطاء .(@)(@@) قال يحيى : شعبة يروي عن أبي حمزة جارهم وهو أبو حمزة المازني .(@)(@@) قال يحيى : وأبو حمزة السكري محمد بن ميمون ، يحدث عنه : ابن المبارك ، وعلي بن الحسن بن شقيق ، وهارون بن المغيرة الرازي أبو حمزة ، وشعيب بن أبي 
ms252	 حمزة ، هو مولى زياد ، واسم أبي حمزة دينار ، ومحمد بن كعب القرظي أبو حمزة .(@)(@@) 884 - حدثني إبراهيم بن الجنيد الختلي ، قال : أخبرني محمد بن نجيح ، قال : أنبأنا أبو معشر ، عن بكار بن مرة ، قال : سألت محمد بن كعب القرظي ، فقلت : يا أبا حمزة ! ما ترى في لعب الشطرنج ، والنرد والأربعة PageV02P489 عشر ؟ قال : أدني ما في هذا أن تعرض تلك الساعة التي لعبت فيها مع أهل الباطل .(@)(@@) 885 - أخبرني أحمد بن شعيب ، قال : أنبأ علي بن حجر ، قال : حدثنا حكام بن سلم ، عن أبي حمزة عبد الله بن جابر ، عن الحسن ، قال : إني لفي حلقة علي إذا جاءت الصيحة من دار عثمان فرأيته رافعا يديه إلى السماء ، وهو يقول : اللهم إني أبرأ إليك من دم عثمان .(@)(@@) 886 - أخبرني أحمد بن شعيب ، قال : أخبرني عبد الله بن الهيثم ، قال : حدثنا أبو داود ، قال : حدثنا شعبة ، قال : أخبرني عبد الرحمن بن أبي عبد الله ، وكان يكنى أبا حمزة ، وكان لنا جارا ، قال : سمعت هلالا المازني يحدث ، عن سويد بن صفوان ، قال : أتيت النبي [ صلى الله عليه وسلم ] بجرة أستأذنه أن أنتبذ فيها ، فنهاني عنها ، فكسرتها .(@)(@@) أخبرني أبو عبد الرحمن قال : أخبرني أبو بكر بن علي ، قال : حدثنا أحمد بن إبراهيم ، قال : قال وكيع : اسم أبي حمزة عبد الرحمن بن كيسان .(@)(@@) 887 - قال : وثنا الحسن بن علي بن عفان ، قال : ثنا زيد بن الحباب ، عن محمد بن طلحة بن مصرف ، قال : أخبرني ميمون أبو حمزة ، قال : قال إبراهيم النخعي : تكلمت ولو وجدت بدا لم أتكلم ، وإن زمانا أنا فيه فقيه لزمان سوء .(@)(@@) 888 - حدثنا أحمد بن شعيب ، قال : أنبأ حميد بن مسعدة ، قال : ثنا عبد الوارث ، قال : حدثنا ميمون أبو حمزة ، عن أبي صالح مولى أم سلمة ، قال : دخل على أم سلمة شاب من أهلها فدخل المسجد يصلي ، فنفخ حيث أراد PageV02P490 أن يسجد ، فقالت : مه سمعت رسول الله [ صلى الله عليه وسلم ] يقول لغلام لنا : يقال له : [ رباح ] ، ترب وجهك .(@)(@@) 889 - الحسن بن علي 
ms253	 بن عفان ، قال : حدثنا أبو أسامة ، عن إسماعيل ابن أبي خالد ، عن سعد بن عبيدة أبي حمزة ، عن أبي عبد الرحمن السلمي ، قال : كانت لا تفوتني الصلوات مع علي فخرج [ يوما ] قبل صلاة الفجر ، فصفق بإحدى يديه على الأخرى ، ثم قال : نعم ساعة الوتر ، نعم ساعة الوتر .(@)(@@) 890 - حدثنا الحسن بن علي بن عفان ، قال : حدثنا أبو أسامة ، قال سالم بن أبي الجعد : قال : حدثنا أبو القاسم الأنصاري ، قال : قال رسول الله [ صلى الله عليه وسلم ] : دخلت الجنة فرأيت جعفرا ذا الجناحين مضرجا بالدماء .(@)(@@) 891 - حدثنا أبو موسى محمد بن المثنى ، قال : حدثنا عبيد الله بن عبد المجيد ، قال : حدثنا سوار أبو حمزة ، قال : حدثني عبد الرحمن بن أبي بكرة ، عن أبيه ( 1 / 159 ) قال : قال رسول الله [ صلى الله عليه وسلم ] : لا يقيم الرجل الرجل من مكانه ، ولكن يوسع لأخيه المسلم .(@)(@@) 892 - حدثنا زياد بن أيوب أبو هاشم ، قال : حدثنا وكيع بن الجراح ، قال : أخبرني أبو حمزة داود بن سوار ، عن عمرو بن شعيب ، عن أبيه ، عن جده قال : قال رسول الله [ صلى الله عليه وسلم ] : مروا أولادكم بالصلاة إذا بلغوا سبع سنين ، واضربوهم عليها إذا بلغوا عشرا ، وفرقوا بينهم في المضاجع . PageV02P491(@)(@@) 893 - أخبرني أحمد بن شعيب ، قال : أنبأ يحيى بن مخلد ، قال : حدثنا معافى ، عن سفيان ، عن بشير أبي إسماعيل ، عن سيار أبي حمزة ، عن طارق بن شهاب ، عن ابن مسعود ، أن رسول الله [ صلى الله عليه وسلم ] قال : من نزلت به فاقة فأنزلها بالناس لم تسد الناس فاقته ، ومن أنزلها بالله أوشك له بأجل عاجل أو رزق حاضر . PageV02P492(@)(@@)(@@)(@@) ||| ( من كنيته أبو حماد [ وأبو حمدان ] )(@)(@@)(@@)(@@) $ * أبو حماد سالم عن السدي ، روى عنه : عبيد الله بن موسى .(@)(@@)(@@)(@@) $ * وأبو حماد مفضل بن صدقة .(@)(@@)(@@)(@@) $ * وأبو حمدان [ حكم بن عبد الله ] .(@)(@@) سمعت العباس بن محمد يقول : سمعت يحيى بن معين يقول : أبو حماد الكوفي ، يروي عنه : يحيى بن آدم وغيره ، ليس بشيء .(@)(@@) قال : وسمعت يحيى يقول : ما كان في كتاب أبي إسحاق 
ms254	 الفزاري ، عن أبي حماد ، فهو أبو حماد الحنفي .(@)(@@) 894 - حدثنا أبو الحسن أحمد بن عبد الله بن أبي برزة ، قال : حدثنا الحكم بن عبد الله أبو حمدان البصري ، وكان قدريا ، قال : حدثنا سعيد بن أبي عروبة ، عن قتادة ، عن الحسن ، عن أنس بن مالك ، قال : قال رسول الله [ صلى الله عليه وسلم ] : من لقي أخاه المسلم بما يحب ليسره ، سره الله يوم القيامة . PageV02P493(@)(@@)(@@)(@@) ||| ( من كنيته أبو حميد )(@)(@@)(@@)(@@) $ * أبو حميد قتادة بن الفضيل ، حدث عنه : أبو الحسين أحمد بن سليمان الرهاوي .(@)(@@)(@@)(@@) $ * وأبو حميد عصام بن عمرو بغدادي ، حدث عنه : محمد بن عبد الله بن المبارك المخرمي .(@)(@@) 895 - أخبرني أحمد بن شعيب ، قال : أنبأ أحمد بن سليمان ، قال : حدثنا قتادة بن الفضيل أبو حميد ، قال : سمعت بكير بن فيروز ، قال : سمعت ابن عباس : ينهى عن بيع الحب حتى يبلغ الفرك .(@)(@@) 896 - قال : وأخبرني أحمد بن شعيب ، قال : حدثنا محمد بن عبد الله ابن المبارك ، قال : حدثنا أبو حميد عصام بن عمرو بغدادي ، قال : حدثنا يحيى بن الوليد الطائي ، عن [ محل ] بن خليفة ، قال : قال عدي بن حاتم : ما أقيمت الصلاة منذ أسلمت إلا وأنا على وضوء . PageV02P494(@)(@@)(@@)(@@) ||| ( من كنيته أبو حنيفة وأبو حنظلة )(@)(@@)(@@)(@@) $ * أبو حنيفة النعمان بن ثابت الفقيه .(@)(@@)(@@)(@@) $ * وأبو حنيفة العدوي سليمان بن حبان ، روى عنهما جميعا : إسماعيل ابن عياش الشامي الحمصي .(@)(@@)(@@)(@@) $ * وأبو حنيفة سعيد بن بيان سابق الحاج .(@)(@@)(@@)(@@) $ * وأبو حنيفة محمد بن [ حنفية بن ] ماهان الواسطي .(@)(@@)(@@)(@@) $ * وأبو حنيفة بن سماك بن الفضل ، روى عنه : الشافعي .(@)(@@) حدثني شعيب بن أيوب أبو بكر القاضي ، قال : حدثنا عبد الحميد بن عبد الرحمن الحماني ، قال : حدثنا أبو حنيفة النعمان بن ثابت .(@)(@@) 897 - قال : وأخبرني أحمد بن شعيب ، عن يعقوب بن سفيان ، قال : أخبرني سليمان بن حرب ، قال : ( 1 / 160 ) حدثنا معاذ [ بن معاذ ] ، عن بشر بن المفضل ، قال : سمعت أبا حنيفة وسئل عن امرأة من الحي لها غلام فجامعها من دون الفرج ، فشاع الماء في فرجها فحملت ، ما حيلته ؟ قال : لها عمة ؟ قالوا : نعم ، قال 
ms255	 : فلتهبه لعمتها ، ثم تزوجها منه ، فإذا افترعها ردته عليها ، وقد فارقها .(@)(@@) 898 - حدثنا أبو جعفر محمد بن عبد الملك الدقيقي ، قال : حدثنا محمد PageV02P495 ابن ماهان أبو حنيفة الواسطي قال : حدثنا نافع بن عمر الجمحي ، عن ابن أبي مليكة ، عن عبد الله بن الزبير ، قال : قال رسول الله [ صلى الله عليه وسلم ] : ليس منا من لم يتغن بالقرآن ، قال : وأنتم فتغنوا به إن استطعتم .(@)(@@) 899 - حدثنا خلف بن عيسى الشاهياني الواسطي ، قال : حدثنا أبو حنيفة محمد بن ماهان ، قال : حدثنا وهيب ، عن ابن حازم ، عن سهل بن سعد ، قال : قال رسول الله [ صلى الله عليه وسلم ] : إن في الجنة شجرة يسير الراكب في ظلها مائة عام لا يقطعها ، قال : فحدثت بهذا الحديث النعمان بن أبي عياش ، فقال : أخبرني أبو سعيد الخدري ، عن النبي [ صلى الله عليه وسلم ] بمثل هذا وزاد فيه : الجواد المشمر السريع .(@)(@@) 900 - حدثني أحمد بن يحيى الصوفي ، قال : حدثنا إبراهيم بن محمد ابن ميمون ، قال : حدثنا أبو حنيفة سعيد بن بيان سابق الحاج ، عن أبي إسحاق السبيعي ، عن البراء بن عازب ، قال : قال رسول الله [ صلى الله عليه وسلم ] : من كنت مولاه فعلي مولاه .(@)(@@) 901 - حدثنا عبد الله بن هاشم أبو عبد الرحمن الطوسي ، قال : حدثنا يحيى بن سعيد ، عن إسماعيل بن أبي خالد ، عن أبي حنظلة ، قال : سألت ابن عمر عن الصلاة في السفر ؟ فقال : الصلاة في السفر ركعتان ، قال : قلنا : إنا آمنون ، قال : سنة النبي [ صلى الله عليه وسلم ] .(@)(@@) 902 - حدثنا محمد بن خلف الكوفي ، قال : حدثنا يعلى بن عبيد ، قال : حدثنا إسماعيل بن أبي خالد ، عن أبي حنظلة ، قال سألت ابن عمر ، عن صلاة المسافر ؟ فقال : ركعتان ، قلت : إنا آمنون لا نخاف إلا الله عز وجل ، فقال : سنة النبي [ صلى الله عليه وسلم ] .(@)(@@) 903 - حدثنا أبو بكر بن علي ، قال : حدثنا خالد بن مرداس أبو PageV02P496 الهيثم ، قال : ثنا إسماعيل بن عياش ، عن أبي حنيفة سليمان بن حيان العدوي ، قال : سمعت سوارة بن هانئ يقول : قال 
ms256	 عمر بن الخطاب : إذا خرج الرجلان جميعا لإراقة الماء ، فليتنح أحدهما عن صاحبه ، فإن الرجل يتنفس .(@)(@@) 904 - حدثنا الربيع بن سليمان الشافعي ، قال : أنبأ محمد بن إدريس الشافعي ، قال : حدثنا أبو حنيفة بن سماك بن الفضل الشهابي ، قال : أخبرني ابن أبي ذئب ، عن المقبري ، عن أبي شريح ، أن النبي [ صلى الله عليه وسلم ] قال عام الفتح : من قتل له قتيل فهو بخير النظرين إن أحب أخذ العقل ، وإن أحب فله القود . PageV02P497(@)(@@)(@@)(@@) ||| ( من كنيته أبو الحواري ، وأبو الحويرث ، [ وأبو حوالة ] )(@)(@@)(@@)(@@) $ * أبو الحويرث أبو عبد الرحمن بن معاوية .(@)(@@)(@@)(@@) $ * وأبو الحواري عبد القدوس بن الحواري ، يحدث عنه : محمد بن المثنى .(@)(@@)(@@)(@@) $ * وأبو الحواري بزيع بن عبيد الله ؟ .(@)(@@)(@@)(@@) $ * وأبو الحواري زيد بن الحواري ، عن أبي الصديق .(@)(@@)(@@)(@@) $ * وأبو حوالة عبد الله بن حوالة الأزدي .(@)(@@) حدثنا العباس بن محمد قال : قيل ليحيى بن معين : زيد العمي ، هو زيد الحواري ؟ قال : ما أشبه أن تكون هذه كنيته .(@)(@@) وفي موضع آخر : زيد بن الحواري ، هو زيد أبو الحواري ، وهو زيد العمي .(@)(@@) قال : وحدثنا العباس ( 1 / 161 ) قال : [ و ] سمعت يحيى يقول : أبو الحويرث هو عبد الرحمن بن معاوية ، روى عنه : سفيان الثوري ، وسفيان بن عيينة فقالا : أبو الحويرث ، وشعبة يقول : أبو الحويرثة .(@)(@@) 905 - قال يحيى : وحدثنا حجاج ، عن أبي معشر ، عن أبي الحويرث عبد الرحمن بن معاوية ، قال : مكث موسى بعد ما كلمه الله أربعين ليلة لا يراه أحد إلا مات . PageV02P498(@)(@@) 906 - أخبرنا محمد بن المثنى ، قال : حدثنا عبد القدوس بن الحواري أبو الحواري ، قال : حدثنا هشام ، قال : اغتم ابن سيرين ، فقيل له : يا أبا بكر ما هذا الغم ؟ قال : هذا الغم لذنب أصبته منذ أربعين سنة .(@)(@@) 907 - قال : وأخبرني أحمد بن شعيب ، قال : حدثنا محمد بن عبد الأعلى ، قال : حدثنا المعتمر بن سليمان ، قال : سمعت المعلى بن جابر ، يقول : حدثني أبو الحواري زيد العمي ، عن أبي الصديق الناجي ، عن أبي سعيد ، قال : سمعت رسول الله [ صلى الله عليه وسلم ] يقول : يقوم في أمتي سبعا أو ثماني أو تسعا 
ms257	 ، قلت : ما هن ؟ قال : سنين يريد المهدي .(@)(@@) حدث المنهال بن بحر ، قال : حدثنا بزيع أبو الحواري بن عبيد الله ، مولى ابن شقيق ، عن أنس بن مالك . PageV02P499(@)(@@)(@@)(@@) ||| ( من كنيته أبو الحوراء ، وأبو حرمل )(@)(@@)(@@)(@@) $ * أبو الحوراء ربيعة بن شيبان(@)(@@) 908 - حدثنا محمد بن بشار ، ومحمد بن المثنى ، قالا : حدثنا محمد ابن جعفر ، قال : حدثنا شعبة ، قال : وحدثنا يوسف بن سعيد ، قال : حدثنا حجاج ، قال : سمعت سعيدا ، قال : سمعت بريد بن أبي مريم ، يحدث عن أبي الحوراء السعدي ، قال : قلت للحسن بن علي : ما تذكر من رسول الله [ صلى الله عليه وسلم ] ؟ قال : أذكر من رسول الله [ صلى الله عليه وسلم ] أني أخذت تمرة من تمر الصدقة فجعلتها في في ، فنزعها بلعابها فألقاها في التمر ، فقيل : يا رسول الله ! ما كان عليك من هذه التمرة لهذا الصبي ؟ فقال : إنا آل محمد لا تحل لنا الصدقة ، مختصر .(@)(@@) وقال لنا أبو بشر : سمعت العباس يقول : سمعت يحيى يقول : قد روى أحسبه ، قال : عن أبي حرمل . PageV02P500(@)(@@)(@@)(@@) ||| ( من كنيته أبو حيان ، [ وأبو حيوة )(@)(@@)(@@)(@@) $ * أبو حيان يحيى بن سعيد بن حيان التيمي .(@)(@@)(@@)(@@) $ * وأبو حيان سحيم بن نوفل .(@)(@@)(@@)(@@) $ * [ وأبو حيان الأشجعي منذر .(@)(@@)(@@)(@@) $ * وأبو حيوة شريح بن أبي يزيد الحضرمي ] .(@)(@@) 909 - حدثنا العباس بن محمد قال : حدثنا يحيى بن معين قال : حدثنا إبراهيم بن عيينة ، عن أبي حيان ، قال : دعي الشعبي إلى وليمة ، [ قال ] : فذهب بي معه ، [ قال ] : فأطعمونا لحم بقر .(@)(@@) قال يحيى : ولم يرو عن أبي حيان هذا أحد غير إبراهيم بن عيينة .(@)(@@) قال : وسمعت يحيى يقول : أبو حيان الأشجعي من أصحاب ابن مسعود ، وسمعته يقول : أبو حيان الأشجعي منذر .(@)(@@) 910 - أخبرني أحمد بن شعيب ، قال : أنبأ إسحاق بن إبراهيم ، قال : أنبأ عيسى بن [ يونس ] ، وعبد الله بن إدريس ، ويحيى بن عبد الملك ، عن أبي حيان يحيى بن سعيد ، عن الشعبي ، عن ابن عمر ، قال : سمعت عمر يقول : أما بعد : أيها الناس إنه نزل تحريم الخمر ، وهي من خمسة : من العنب ، PageV02P501 والتمر ، والعسل ، والحنطة ، والشعير ، والخمر : ما خامر العقل 
ms258	 .(@)(@@) قال : وحدثني أبو إسحاق إبراهيم بن يعقوب ، قال : حدثنا سعيد بن منصور ، قال : حدثنا ابن عيينة ، أن سحيم بن نوفل يكنى أبا حيان ، وأبو حيوة شريح بن أبي يزيد الحضرمي ( 1 / 162 ) . PageV02P502(@)(@@)(@@)(@@) || ( حرف الخاء من الكنى )(@)(@@)(@@)(@@) ||| ( من كنيته أبو خالد )(@)(@@)(@@)(@@) $ * أبو خالد أسلم مولى عمر بن الخطاب .(@)(@@)(@@)(@@) $ * وأبو خالد سعد البجلي ، والد إسماعيل بن أبي خالد . وأبو خالد عياض ، سمع منه : شعبة .(@)(@@)(@@)(@@) $ * وأبو خالد الوالبي ، [ و ] اسمه : هرمز .(@)(@@)(@@)(@@) $ * وأبو خالد مهاجر ، عن رفيع أبي العالية ، [ روى ] عوف عنه .(@)(@@)(@@)(@@) $ * وأبو خالد مطر بن ميمون .(@)(@@)(@@)(@@) $ * وأبو خالد محمد بن عمر [ المحري ] .(@)(@@)(@@)(@@) $ * وأبو خالد عبد الرحمن بن زياد بن أنعم الأفريقي .(@)(@@)(@@)(@@) $ * وأبو خالد عبد العزيز بن أبان القرشي .(@)(@@)(@@)(@@) $ * وأبو خالد عبد الملك بن عبد العزيز بن جريج ، ويقال : أبو الوليد .(@)(@@)(@@)(@@) $ * وأبو خالد بن خالد الحميري وهب الحمصي ، روى عنه : أبو عاصم [ النبيل ] . PageV02P503(@)(@@)(@@)(@@) $ * وأبو خالد الأحمر سليمان بن حيان .(@)(@@)(@@)(@@) $ * وأبو خالد بحير بن سعد الشامي .(@)(@@)(@@)(@@) $ * وأبو خالد ثور بن يزيد بن محمد الرحبي .(@)(@@)(@@)(@@) $ * وأبو خالد يوسف بن خالد السمتي البصري .(@)(@@)(@@)(@@) $ * وأبو خالد يونس بن خالد القرشي .(@)(@@)(@@)(@@) $ * وأبو خالد يزيد الأسدي ، عن عون بن أبي جحيفة ، روى عنه : زهير ابن معاوية .(@)(@@)(@@)(@@) $ * وأبو خالد الدالاني يزيد بن عبد الرحمن .(@)(@@)(@@)(@@) $ * وأبو خالد وليس الدالاني ، روى عنه : ابن جريج .(@)(@@)(@@)(@@) $ * وأبو خالد يزيد بن خالد بن يزيد بن موهب .(@)(@@)(@@)(@@) $ * وأبو خالد ابن المشاطة يزيد المؤذن ، روى عنه : سفيان بن عيينة .(@)(@@)(@@)(@@) $ * وأبو خالد يزيد بن المغلس ، روى عنه : عمرو بن عاصم .(@)(@@)(@@)(@@) $ * وأبو خالد يزيد بن هارون .(@)(@@)(@@)(@@) $ * وأبو خالد يزيد بن يحيى ، يحدث عنه : الهيثم بن خارجة .(@)(@@)(@@)(@@) $ * وأبو خالد يزيد بن أبي جعفر .(@)(@@)(@@)(@@) $ * وأبو خالد زياد بن عبد الله الصائغ ، روى عن : مكحول .(@)(@@)(@@)(@@) $ * وأبو خالد الزبير ، روى عنه : حماد بن سلمة .(@)(@@)(@@)(@@) $ * وأبو خالد الحسن ، روى عنه : سويد بن نصر .(@)(@@) 911 - قال : أخبرنا . . . عبد الله بن المبارك ، عن سكين بن عبد العزيز ابن قيس ، قال : حدثنا الحسن أبو خالد ، عن عبد العزيز بن قيس ، قال : سمعت ابن عمر يقول : الماشي أولى با 
ms259	 لجادة من الراكب .(@)(@@)(@@)(@@) $ * وأبو خالد أوس ، حدث عنه : أبو هاشم الرماني . PageV02P504(@)(@@)(@@)(@@) $ * وأبو خالد يزيد بن سنان البصري ، سكن مصر ، روى عن : يحيى بن سعيد ، وعبد الرحمن بن مهدي ، وأيوب بن عبد الله القرشي .(@)(@@)(@@)(@@) $ * وأبو خالد ، روى عنه : معلى بن أسد .(@)(@@)(@@)(@@) $ * وأبو حازم عبد الغفار بن الحسن بن دينار ، حدث عنه : محمد بن عبد الله بن عبد الحكم .(@)(@@) حدثنا العباس بن محمد ، قال : سمعت يحيى بن معين يقول : أسلم مولى عمر بن الخطاب كنيته أبو خالد .(@)(@@) حدثنا العباس بن محمد ، عن يحيى بن معين قال : عوف يروي عن : أبي خالد ، وهو أبو مخلد ، يروي عنه : عبد الوهاب الثقفي ، وحماد بن زيد يقولون : مهاجر أبو مخلد ، وهو أبو خالد الذي يروي عنه عوف .(@)(@@) حدثنا العباس قال : سمعت يحيى يقول : أبو خالد الوالبي اسمه : هرمز .(@)(@@) قال : وإسماعيل بن أبي خالد أبو خالد ، اسمه هرمز .(@)(@@) قال غيره اسمه : سعد .(@)(@@) سمعت عبد الله بن أحمد ، يقول : سمعت أبي يقول : ابن جريج له كنيتان أبو خالد ، وأبو الوليد .(@)(@@) قال : وأبو خالد عياض يروي عنه : شعبة ، قال : ويزيد أبو خالد ، وليس PageV02P505 هو الدالاني ، يروي عنه : شعبة .(@)(@@) قال : وقرة بن خالد كنيته أبو خالد ثقة .(@)(@@) 912 - حدثنا الحسن بن علي بن عفان ، قال : حدثنا الحسن بن عطية ، قال : سمعت أبا خالد جدي أبا أمي بزيع يذكر قال : كنا نمر ونحن غلمان في زمن خالد ، نمر على رجل جالس في الطريق أبرص الجسد أسود الوجه ( 1 / 163 ) فكان الناس يقولون : خرج على الحسين .(@)(@@) 913 - حدثني أبو بكر بن أبي الدنيا ، قال : حدثني محمد بن الحسين ، قال أخبرني الحميدي ، عن سفيان ، قال : كان أبو خالد المؤذن يزيد بن الماشطة إذا أذن بكى ، وربما صرخ الصرخة في أثر الأذان ، فقال له بعض أولئك : ما هذا الذي يغشاك عند النداء ؟ قال : فبكى ، وقال : إني لأشبهه بالنفخة ، ثم غشي عليه .(@)(@@) 914 - حدثنا أبو شيبة إبراهيم بن عبد الله بن أبي شيبة ، قال : حدثنا أحمد بن عبد الله بن يونس ، قال : ثنا زهير ، قال 
ms260	 : حدثنا أبو خالد يزيد الأسدي ، قال : حدثنا عون بن أبي جحيفة السوائي ، عن عبد الرحمن بن علقمة الثقفي ، عن عبد الرحمن بن أبي عقيل ، عن رسول الله [ صلى الله عليه وسلم ] ، قال : إن الله لم يبعث نبيا إلا أعطاه دعوة ، وإن الله أعطاني دعوة فخبأتها عند ربي شفاعة لأمتي يوم القيامة .(@)(@@) 915 - حدثنا محمد بن بشار ، قال : حدثنا يحيى بن سعيد ، ومحمد بن جعفر ، قالا : حدثنا شعبة ، قال : سمعت عياضا أبا خالد ، قال : رأيت رجلين PageV02P506 يختصمان عند معقل بن يسار ، فقال معقل : سمعت رسول الله [ صلى الله عليه وسلم ] يقول : من حلف على يمين ليقتطع بها مال رجل لقي الله وهو عليه غضبان .(@)(@@) 916 - حدثنا الحسن بن علي بن عفان ، قال : حدثنا عثمان بن سعيد ابن كثير ، قال : حدثنا أبو خالد محمد بن عمر [ المحري ] ، عن ثابت بن سعد الطائي ، عن جبير بن نفير ، قال : قام أبو بكر الصديق إلى جنب منبر رسول الله [ صلى الله عليه وسلم ] فذكر رسول الله [ صلى الله عليه وسلم ] فبكى ، ثم قال : إن رسول الله [ صلى الله عليه وسلم ] قام في مقامي هذا عام أول ، فقال : أيها الناس سلوا الله العافية ، فإنه لم يؤت أحد مثل العافية بعد يقين .(@)(@@) 917 - حدثنا إسحاق بن سيار النصيبي ، قال : حدثنا أبو عاصم الضحاك بن مخلد ، عن وهب أبي خالد ، عن بنت حبيبة بنت العرباض بن سارية ، عن أبيها أن النبي [ صلى الله عليه وسلم ] نهى عن الخليسة والمحنتمة ، وعن كل ذي ناب من السبع .(@)(@@) 918 - حدثنا موسى بن سهل الرملي ، قال : حدثنا عمران بن هارون ، قال : أنبأ سليمان بن حيان أبو خالد الأحمر ، قال : حدثنا داود بن أبي هند ، قال : حدثنا عمران بن بكار البراد ، قال : حدثنا خطاب بن عثمان ، قال : حدثنا يونس بن خالد أبو خالد القرشي ، قال : حدثنا جعفر بن برقان ، عن ميمون بن مهران ، عن أنس بن مالك ، قال : خدمت رسول الله [ صلى الله عليه وسلم ] عشر سنين ، فما أمرني بأمر فتوانيت فيه ، أو 