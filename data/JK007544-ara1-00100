ms81	 الكلب تطلب دارما % لتدركه ، لا تفتإ الدهر عانيا % % 4(@)(@@) % أتطلب عاديا بني الله بيته % عزيزا ، ولم يجعل لك الله بانيا % % 5(@)(@@) % سعيت شباب الدهر ، لم تستطعهم % أفالآن ، لما أصبح الدهر فانيا % % 6(@)(@@) % أصخ يا بن ثفر الكلب عن آل دارم % فإنك لن تسطيع تلك الروابيا % % 7(@)(@@) % وإنك لو أسريت ليلك كله % من القوم ، لم تصبح من القوم دانيا % % 8(@)(@@) % بخست بيربوع لتدرك دارما % ضلالا لمن مناك تلك الأمانيا % % 9(@)(@@) % أتشتم قوما أثلوك بنهشل % ولولاهم كنتم كعكل مواليا % % 10(@)(@@) % موالي حداجي الروايا ، وساسة % الحمير ، وتباعين تلك التواليا % % PageV01P304 11(@)(@@) % إذا احتضر الناس المياه نفيتم % عن الماء ، حتى يصبح الحوض خاليا % % 12(@)(@@) % أجحاف ما من كاشح ذاق حربنا % % فيفلت إلا ازداد عنا تناهيا % % 13(@)(@@) % وما تمنع الأعداء منا هوادة % ولكنهم يلقون منا الدواهيا % % 14(@)(@@) % ويوم بني الصمعاء ، خاضت جيادنا % % دماء بني ذكوان رنقا وصافيا % % 15(@)(@@) % فقد تركتهم في هوازن حربنا % % وما يأخذون الحق إلا تلافيا % % 16(@)(@@) % قتلنا غنيا بالموالي ، فلم نجد % لقتلى غني للحرارة شافيا % % 17(@)(@@) % ونصرا ، ولولا رغبة عن محارب % لأشبع قتلاها الضباع العوافيا % % 18(@)(@@) % وغضوا بني عبس لها من عيونكم % % ولما تصبكم نفحة من هجائيا % % 19(@)(@@) % فقد كلتموني بالسوابق قبلها % % فبرزت منها ثانيا من عنانيا % % 20(@)(@@) % هجاني بنو الصمعاء ، والبيد دونها % % وما كان يلقى غبطة من هجانيا % % PageV01P305 21(@)(@@) % وما كانت الصمعاء إلا تعلة % لمن كان يعتس الإماء الزوانيا % % PageV01P306 
