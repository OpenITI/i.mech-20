ms101	 منه ببغداد.(@)(@@)(@@)(@@) $ 2517 - عبد الرحيم بن عمر: عن الزهري، وعنه الزنجي، له حديث وهو منكر.(@)(@@)(@@)(@@) $ 2518 - عبد الرحيم بن كروم بن أرطبان: مجهول.(@)(@@)(@@)(@@) $ 2519 - عبد الرحيم بن موسى: يروي عن هشيم، مجهول.(@)(@@)(@@)(@@) $ 2520 - عبد الرحيم بن ميمون: عن سهل بن معاذ، ضعفه يحيى بن معين. -د، ت، ق-(@)(@@)(@@)(@@) $ 2521 - عبد الرحيم بن هارون الغساني: عن شعبة، كذبه الدارقطني. -ت-(@)(@@)(@@)(@@) $ 2522 - عبد الرحيم بن واقد: شيخ للحارث بن أبي أسامة، ضعفه الخطيب.(@)(@@)(@@)(@@) || عبد الرزاق(@)PageV01P248(@)(@@)(@@)(@@) $ 2523 - عبد الرزاق بن عمر: عن ابن المبارك، قال ابن حبان: لا يجوز أن يحتج به.(@)(@@)(@@)(@@) $ 2524 - عبد الرزاق بن همام: ثقة حافظ، قال النسائي: فيه نظر لمن كتب عنه بآخرة، وقال ابن عدي: حدث بأحاديث في [ص: 249]الفضائل لم يوافق عليها، وقال عباس العنبري: هو كذاب. -ع-(@)(@@)(@@)(@@) || عبد السلام(@)PageV01P249(@)(@@)(@@)(@@) $ 2525 - عبد السلام بن أبي الجنوب: عن الزهري، قال أبو حاتم: متروك. -ق-(@)(@@)(@@)(@@) $ 2526 - عبد السلام بن حفص: عن عبد الله بن دينار، صدوق، يغرب. -د، ت، س-(@)(@@)(@@)(@@) $ 2527 - عبد السلام بن صالح: روى عنه يزيد بن هارون، لينه الدارقطني.(@)(@@)(@@)(@@) $ 2528 - عبد السلام بن صالح، أبو الصلت الهروي: اتهمه بالكذب غير واحد، قال أبو زرعة: لم يكن بثقة، وقال ابن عدي: متهم، وقال غيره: رافضي. -ق-(@)(@@)(@@)(@@) $ 2529 - عبد السلام بن عبد الله المذحجي: عن أبي عمرو، عن أنس، إسناد مظلم.(@)(@@)(@@)(@@) $ 2530 - عبد السلام بن عبد الحميد: إمام مسجد حران، قال الأزدي: تركوه، وأما ابن عدي فقال: لا أعلم بحديثه بأسا.(@)(@@)(@@)(@@) $ 2531 - عبد السلام بن عبد القدوس: متهم، قال أبو حاتم: ضعيف كأبيه. -ق-(@)(@@)(@@)(@@) $ 2532 - عبد السلام بن أبي فروة النصيبي: عن ابن عيينة، قبله بعضهم، وقال ابن حبان: كان يسرق الحديث.(@)(@@)(@@)(@@) $ 2533 - عبد السلام بن علي: شيخ للوليد بن مسلم، له حديث وهو منكر.(@)(@@)(@@)(@@) $ 2534 - عبد السلام بن محمد الحضرمي: عن الأعرج، تفرد عنه الليث.(@)(@@)(@@)(@@) $ 2535 - عبد السلام بن محمد، أبو يوسف القزويني: صاحب التفسير الكبير، له سماع عال من أبي عمر بن مهدي، لكنه داعية إلى الاعتزال.(@)(@@)(@@)(@@) $ 2536 - عبد السلام بن هاشم البزاز: 
ms102	 قال الفلاس: أقطع بأنه كذاب.(@)(@@)(@@)(@@) $ 2537 - عبد السلام البجلي، وعبد السلام العدني، وعبد السلام ابن أبي مطر: قال أبو حاتم: هؤلاء مجاهيل.(@)(@@)(@@)(@@) || عبد الصمد(@)PageV01P250(@)(@@)(@@)(@@) $ 2538 - عبد الصمد بن جابر الضبي: شيخ لأبي نعيم، ضعفه ابن معين.(@)(@@)(@@)(@@) $ 2539 - عبد الصمد بن حبيب الأزدي: قال أحمد: هو لين الحديث. -د-(@)(@@)(@@)(@@) $ 2540 - عبد الصمد بن حسان المروزي: تركه أحمد بن حنبل.(@)(@@)(@@)(@@) $ 2541 - عبد الصمد بن سليمان: شيخ سعدويه، قال الدارقطني: متروك.(@)(@@)(@@)(@@) $ 2542 - عبد الصمد بن عبد الأعلى: شامي، مجهول.(@)(@@)(@@)(@@) $ 2543 - عبد الصمد بن علي الهاشمي الأمير: لا يصح حديثه «أكرموا الشهود».(@)(@@)(@@)(@@) $ 2544 - عبد الصمد بن الفضل: عن ابن وهب في دبر النساء، لا يصح.(@)(@@)(@@)(@@) $ 2545 - عبد الصمد بن مطير: عن ابن وهب، تركه غير واحد.(@)(@@)(@@)(@@) $ 2546 - عبد الصمد بن موسى الهاشمي: والد إبراهيم، قال الخطيب: ضعفوه.(@)(@@)(@@)(@@) $ 2547 - عبد الصمد بن أبي معمر: عن بكر المزني، قال أبو حاتم: منكر الحديث.(@)(@@)(@@)(@@) || عبد العزيز(@)PageV01P251(@)(@@)(@@)(@@) $ 2548 - عبد العزيز بن أبان، أبو خالد: عن الثوري، متروك متهم. -ت-(@)(@@)(@@)(@@) $ 2549 - عبد العزيز بن بشير(@)(@@) بن كعب: قال علي بن المديني: مجهول.(@)(@@)(@@)(@@) $ 2550 - عبد العزيز بن بشير: عن ابن عيينة، قال أبو حاتم: لا يصدق.(@)(@@)(@@)(@@) $ 2551 - عبد العزيز بن بكار بن عبد العزيز بن أبي بكرة: حديثه نكرة.(@)(@@)(@@)(@@) $ 2552 - عبد العزيز بن جريج: عن عائشة في الوتر، تفرد عنه ابنه. -عه-(@)(@@)(@@)(@@) $ 2553 - عبد العزيز بن جوران الصنعاني: أشار ابن عدي إلى ضعف فيه.(@)(@@)(@@)(@@) $ 2554 - عبد العزيز بن الحصيني بن الترجمان: ضعفه ابن معين، والناس.(@)(@@)(@@)(@@) $ 2555 - عبد العزيز بن حكيم: عن زيد بن أرقم، صدوق، قال أبو حاتم: ليس بقوي.(@)(@@)(@@)(@@) $ 2556 - عبد العزيز بن ربيعة البناني: بصري، ضعف. -ت-(@)(@@)(@@)(@@) $ 2557 - عبد العزيز بن زياد القمي. وعبد العزيز بن سلمة: مجهولان.(@)(@@)(@@)(@@) $ 2558 - عبد العزيز بن صالح: عن عبد الله بن لهيعة، كذلك.(@)(@@)(@@)(@@) $ 2559 - عبد العزيز بن عبد الله، أبو يحيى: قال أبو حاتم: منكر الحديث. -ت، ق-(@)(@@)(@@)(@@) $ 2560 - عبد العزيز بن عبد الله، أبو وهب: عن هشام بن حسان، جرحه ابن عدي.(@)(@@)(@@)(@@) $ 2561 - عبد العزيز بن 
ms103	 عبد الله الأويسي: ثقة، قال أبو داود: ضعيف. -خ، د، ت، ق-(@)(@@)(@@)(@@) $ 2562 - عبد العزيز بن عبد الله الحمصي: عن وهب بن كيسان، ضعفوه.(@)(@@)(@@)(@@) $ 2563 - عبد العزيز بن عبد الرحمن البالسي: عن خصيف، اتهمه أحمد بن حنبل.(@)(@@)(@@)(@@) $ 2564 - عبد العزيز بن عبد الملك الدمشقي: لقي التابعين، قال الأزدي: متروك. -د-(@)(@@)(@@)(@@) $ 2565 - عبد العزيز بن عبيد الله بن حمزة بن صهيب: ضعفه ابن معين. -ق-(@)(@@)(@@)(@@) $ 2566 - عبد العزيز بن عقبة بن سلمة بن الأكوع: ما روى عنه إلا إسماعيل بن عياش، قال البخاري: لا يصح حديثه.(@)(@@)(@@)(@@) $ 2567 - عبد العزيز بن عمر بن عبد العزيز: ثقة، ضعفه أبو مسهر. -ع-(@)(@@)(@@)(@@) $ 2568 - عبد العزيز بن عمران، أبو ثابت الزهري: مدني، مجمع على ضعفه. -ت-(@)(@@)(@@)(@@) $ 2569 - عبد العزيز بن عياش: مدني معاصر لابن جريج، لا يعرف.(@)(@@)(@@)(@@) $ 2570 - عبد العزيز بن فائد. وعبد العزيزي بن أبي معاذ: مجهولان.(@)(@@)(@@)(@@) $ 2571 - عبد العزيز بن أبي رواد ميمون: صالح الحديث، ضعفه علي بن الجنيد، وقال ابن حبان: روى عن نافع عن ابن عمر رضي الله عنهم نسخة موضوعة. -عه-(@)(@@)(@@)(@@) $ 2572 - عبد العزيز بن محمد بن زبالة: عن أهل المدينة، جرحه ابن حبان وغيره.(@)(@@)(@@)(@@) $ 2573 - عبد العزيز بن النعمان: مجهول.(@)(@@)(@@)(@@) $ 2574 - عبد العزيز بن يحيى المدني: قال إبراهيم بن المنذر: كذاب، وقال أبو حاتم: ضعيف، وقال الحاكم: يتهم في مالك، وهو صدوق.(@)(@@)(@@)(@@) $ 2575 - عبد العزيز بن يزيد بن رمانة: حديثه واه.(@)(@@)(@@)(@@) $ 2576 - عبد العزيز بن العنبري: مجهول.(@)(@@)(@@)(@@) $ 2577 - عبد العزيز: عن حذيفة، كذلك.(@)(@@)(@@)(@@) $ 2578 - عبد العزيز بن يحيى: شيخ مجهول، لقي التابعين، معاصر لشعبة.(@)(@@)(@@)(@@) $ 2579 - عبد العزيز بن يحيى، أبو الأصبع الحراني: عن عيسى بن يونس، قال أبو حاتم: صدوق، وقال البخاري: لا يتابع على حديثه. -د، س-(@)(@@)(@@)(@@) || عبد العظيم(@)PageV01P254(@)(@@)(@@)(@@) $ 2580 - عبد العظيم بن حبيب: عن الزبيدي، قال الدارقطني: ليس بثقة.(@)(@@)(@@)(@@) || عبد الغفار(@)PageV01P254(@)(@@)(@@)(@@) $ 2581 - عبد الغفار بن الحسن، أبو حازم: عن الثوري، كذبه الأزدي.(@)(@@)(@@)(@@) $ 2582 - عبد الغفار بن القاسم، أبو مريم: عن عطاء، تركوه.