ms5501	 رزين.(@)(@@) * وروى عن علي بن محمد النوفلي، وروى عنه علي ماجيلويه.(@)(@@) مشيخة الفقيه: في طريقه إلى علي بن محمد النوفلي.(@)(@@) * وروى عن علي بن النعمان، وروى عنه أحمد ابنه.(@)(@@) الكافي: ج 2، ك 1، ب 47، ح 6.(@)(@@) وروى عنه أحمد بن محمد.(@)(@@) التهذيب: ج 6، ح 774 (الاستبصار:(@)(@@) ج 3، ح 81).(@)(@@) وروى عن غياث، وروى عنه أحمد ابنه.(@)(@@) الكافي: ج 6، ك 7، ب 35، ح 7.(@)(@@) * وروى عن فضالة، وروى عنه أحمد ابنه.(@)(@@) الكافي: ج 2، ك 1، ب 123، ح 6، وك 2، ب 14، ح 4، و ج 6، ك 6، ب 92، ح 3.(@)(@@) * وروى عن فضالة بن أيوب، وروى عنه أحمد ابنه.(@)(@@) الكافي: ج، ك 2، ب 9، ح 9. وك 3، ب 25، ح 1، وب 27، ح 2، و ج 2، ك 1، ب 37، ح 5، وب 72، ح 2، وب 75، ح 9، وب 81، ح 1، وب 101، ح 5، و ك 2، ب 2، ح 1، و 2، و 3، وب 6، ح 19، و ج 4، ك 1، ب 2، ح 11.(@)(@@) وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 6، ك 8، ب 30، ح 10.(@)(@@) وروى عنه أحمد بن محمد بن عيسى.(@)(@@) الكافي: ج 1، ك 3، ب 25، ح 1. ومشيخة الفقيه: في طريقه إلى كليب الأسدي.(@)(@@) وروى عنه محمد بن عبد الجبار.(@)(@@) الكافي: ج 1، ك 4، ب 11، ح 5.(@)(@@) * وروى عن الفضل النوفلي.(@)(@@) التهذيب: ج 7، ح 36.(@)(@@) * وروى عن الفضيل بن غزوان، وروى عنه أحمد بن محمد.(@)(@@) التهذيب: ج 6، ح 1187.(@)(@@) * وروى عن القاسم بن عروة، وروى عنه أحمد ابنه.(@)(@@) الكافي: ج 2، ك 1، ب 124، ح 6، و ب 163، ح 15، وك 2، ب 13، ح 2، و ج 3، ك 4، ب 32، ح 17، و ج 6، ك 8، ب 11، ح 10. والتهذيب: ج 2، ح 428. PageV17P385(@)(@@) وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 1، ك 3، ب 21، ح 3، و ج 3، ك 1، ب 37، ح 4، وك 4، ب 6، ح 2، و ب 12، ح 4، وب 69، ح 4، و ج 4، ك 2، ب 65، ح 1، و ج 5، ك 3، ب 118، ح 3، و ج 6، ك 2، ب 28، ح 11، و 13، وب 46، ح 12، وك 3، ب 19، ح 1، وك 6، ب 31، ح 4، و ج 7، ك 5، ب 12، ح 2. والروضة: ح 530.(@)(@@) والتهذيب: ج 1، ح 772 (الاستبصار:(@)(@@) ج 1، ح 626، و ج 2، ح 84 (الاستبصار:(@)(@@) ج 1، ح 956)، و 1225 (الاستبصار:(@)(@@) ج 1، ح 1241)، و ج 8، ح 454 (الاستبصار: ج 3، ح 1255)، و 459 (الاستبصار: ج 
ms5502	 3، ح 1255).(@)(@@) وروى عنه أحمد بن محمد بن عيسى.(@)(@@) الكافي: ج 2، ك 2، ب 49، ح 6، وب 53، ح 1، و ج 3، ك 4، ب 27، ح 1، و ج 5، ك 3، ب 160، ح 3، و ج 6، ك 8، ب 42، ح 2، و ج 7، ك 4، ب 27، ح 6.(@)(@@) * وروى عن القاسم بن محمد.(@)(@@) التهذيب: ج 10، ح 737 (الاستبصار:(@)(@@) ج 4، ح 1019).(@)(@@) وروى عنه أحمد ابنه.(@)(@@) الكافي: ج 1، ك 4، ب 82، ح 3.(@)(@@) وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 2، ك 4، ب 1، ح 3، و ج 3، ك 2، ب 4، ح 4، وك 3، ب 5، ح 3، و ب 13، ح 12.(@)(@@) والروضة: ح 392.(@)(@@) وروى عنه أحمد بن محمد بن عيسى.(@)(@@) الكافي: ج 3، ك 3، ب 91، ح 6، و ج 5، ك 2، ب 46، ح 8.(@)(@@) * وروى عن القاسم بن محمد الجوهري، وروى عنه أحمد ابنه.(@)(@@) الكافي: ج 5، ك 3، ب 86، ح 9، و ب 177، ح 2، و ج 7، ك 2، ب 54، ذيل ح 1.(@)(@@) وروى عنه أحمد بن محمد بن عيسى.(@)(@@) الكافي: ج 6، ك 8، ب 65، ح 1.(@)(@@) * وروى عن محمد بن أبي عمير، وروى عنه أحمد ابنه.(@)(@@) مشيخة الفقيه: في طريقه إلى أبي بصير.(@)(@@) * وروى عن محمد بن سليمان، وروى عنه أحمد ابنه.(@)(@@) الكافي: ج 1، ك 4، ب 108، ح 47.(@)(@@) * وروى عن محمد بن سنان، وروى عنه أحمد ابنه.(@)(@@) الكافي: ج 1، ك 2، ب 5، ح 6، وب 12، ح 1، و ج 2، ك 2، ب 28، ح 4، و ج 5، PageV17P386(@)(@@) ك 2، ب 32، ح 5، وك 3، ب 155، ح 1، و ج 6، ك 1، ب 9، ح 1، وك 8، ب 12، ح 8، و 13، وب 69، ح 5، و 6.(@)(@@) والروضة: ح 485. ومشيخة الفقيه: في طريقه إلى عبد الله بن فضالة، وإلى إسماعيل الجعفي، وإلى صالح بن عقبة، وإلى القاسم بن بريد. والتهذيب: ج 6، ح 369، و ج 7، ح 1734.(@)(@@) وروى عنه أحمد بن محمد.(@)(@@) الروضة: ح 437.(@)(@@) * وروى عن علي بن محمد عمن ذكره عنه.(@)(@@) الكافي: ج 3، ك 5، ب 1، ح 13.(@)(@@) * وروى محمد بن الحسن عمن ذكره عنه.(@)(@@) الكافي: ج 1، ك 4، ب 2، ح 2.(@)(@@) * وروى عن محمد بن عمر، وروى عنه أحمد ابنه.(@)(@@) الكافي: ج 2، ك 4، ب 6، ح 1.(@)(@@) * وروى عن محمد بن القاسم، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 1، ك 4، ب 97، ح 2.(@)(@@) * وروى عن محمد بن يحيى، وروى عنه 
ms5503	 أحمد بن محمد.(@)(@@) الروضة: ح 229.(@)(@@) * وروى عن مروك، وروى عنه سهل ابن زياد.(@)(@@) الكافي: ج 6، ك 7، ب 15، ح 17).(@)(@@) * وروى عن النضر بن سويد، وروى عنه أحمد ابنه.(@)(@@) الكافي: ج 1، ك 2، ب 22، ح 3، وك 2، ب 28، ح 3، و ج 2، ك 1، ب 18، ح 5، و ب 66، ح 6، وب 111، ح 3، وب 121.(@)(@@) ح 4، وب 170، ح 4، و ج 6، ك 8، ب 12، ح 11، وك 9، ب 12، ح 5.(@)(@@) والروضة: ح 62 و 206. والتهذيب:(@)(@@) ج 9، ح 467.(@)(@@) وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 2، ك 1، ب 92، ح 3، و ج 2، ك 1، ب 12، ح 2، و ج 3، ك 3، ب 18، ح 2، وك 4، ب 66، ح 9، وب 93، ح 1، و ج 6، ك 6، ب 66، ح 7، وك 7، وك 7، ب 23، ح 5، وب 37، ح 2. والروضة: ح 119، و 498، و 572. والتهذيب: ج 1، ح 282، و 875، و ج 3، ح 6، و 407.(@)(@@) وروى عنه أحمد بن محمد بن عيسى.(@)(@@) الكافي: ج 1، ك 4، ب 64، ذيل ح 1، و ب 89، ح 3، و ج 2، ك 1، ب 77، ح 9، و ب 97، ح 4، وك 2، ب 14، ح 3، و ب 49، ح 15، وك 3، ب 3، ح 6، وب 5، PageV17P387(@)(@@) ح 2، وب 6، ح 5، و ج 3، ك 3، ب 64، ح 2، وب 73، ح 4. والروضة: ح 349، و 350. والتهذيب: ج 1، ح 924.(@)(@@) وروى عنه محمد بن أحمد.(@)(@@) الكافي: ج 1، ك 4، ب 99، ح 4.(@)(@@) * وروى عن وهب، وروى عنه أحمد ابنه.(@)(@@) الكافي: ج 3، ك 3، ب 71، ح 2، وب 83، ح 4، و ج 5، ك 2، ب 157، ح 2.(@)(@@) * وروى عن وهب بن وهب أبي البختري، وروى عنه أحمد ابنه.(@)(@@) مشيخة الفقيه: في طريقه إلى وهب بن وهب.(@)(@@) وروى عنه أحمد بن محمد.(@)(@@) التهذيب: ج 2، ح 1173 (الاستبصار:(@)(@@) ج 1، ح 1190).(@)(@@) * وروى عن وهب بن وهب أبي البختري القاضي القرشي، وروى عنه أحمد ابنه.(@)(@@) التهذيب: ج 1، ح 1008.(@)(@@) * وروى عن هارون بن الجهم، وروى عنه أحمد ابنه.(@)(@@) الكافي: ج 2، ك 1، ب 83، ح 5، و ب 136، ح 1، وب 185، ح 2، و ج 7، ك 3، ب 24، ح 1.(@)(@@) وروى أحمد ابنه عنه عن هارون ابن الجهم أو غيره.(@)(@@) الكافي: ج 2، ك 1، ب 26، ح 4.(@)(@@) * وروى عن يونس بن عبد الرحمان، وروى عنه أحمد ابنه.(@)(@@) الروضة: ح 334. ومشيخة الفقيه: في طريقه إلى صالح بن عقبة.(@)(@@) * وروى عن بعض 
ms5504	 أصحابنا، عن أبي عبد الله عليه السلام، وروى عنه أحمد ابنه.(@)(@@) الكافي: ج 1، ك 1، ب 0، ح 3 2.(@)(@@) * وروى عن بعض أصحابنا، عن عبد الله بن سنان، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 2، ك 1، ب 4، ح 2.(@)(@@) * وروى عن بعض أصحابنا، عن يونس بن يعقوب، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 1، ك 4، ب 70، ح 5.(@)(@@) * وروى عن بعض أصحابه، عن أبي عبد الله عليه السلام، وروى عنه أحمد ابنه.(@)(@@) الكافي: ج 3، ك 3، ب 70، ح 4، وب 76، ح 3.(@)(@@) * وروى عن بعض أصحابه، عن أبي PageV17P388(@)(@@) عمارة، وروى عنه أحمد ابنه.(@)(@@) الكافي: ج 2، ك 1، ب 84، ح 11.(@)(@@) * وروى مرسلا، وروى عنه أحمد ابنه.(@)(@@) الكافي: ج 6، ك 8، ب 37، ح 9.(@)(@@) * وروى مرسلا عن أبي جعفر عليه السلام، وروى عنه أحمد ابنه.(@)(@@) الكافي: ج 1، ك 2، ب 19، ح 22.(@)(@@) والروضة: ح 335.(@)(@@) * وروى مرسلا عن أبي عبد الله عليه السلام، وروى عنه أحمد ابنه.(@)(@@) الكافي: ج 6، ك 1، ب 1، ح 6.(@)(@@) * وروى مرفوعا عن أبي عبد الله عليه السلام، وروى عنه أحمد ابنه.(@)(@@) الكافي: ج 7، ك 6، ب 2، ح 1. والروضة:(@)(@@) ح 410. والتهذيب: ج 6، ح 513.(@)(@@) * وروى مرفوعا عن أمير المؤمنين عليه السلام، وروى عنه أحمد ابنه.(@)(@@) الكافي: ج 1، ك 2، ب 13، ح 6، وك 3، ب 6، ح 4.(@)(@@) * وروى مرفوعا عن محمد بن داود الغنوي، وروى عنه أحمد ابنه.(@)(@@) الكافي: ج 2، ك 1، ب 112، ح 16.(@)(@@) * وروى مرفوعة ومضمرة، وروى عنه أحمد ابنه.(@)(@@) الكافي: ج 2، ك 2، ب 53، ح 3.(@)(@@) * وروى عمن حدثه، عن الحسين ابن المختار، وروى عنه أحمد ابنه.(@)(@@) الكافي: ج 2، ك 1، ب 152، ح 3.(@)(@@) * وروى عمن حدثه، عن زيد بن الجهم الهلالي، وروى عنه أحمد ابنه.(@)(@@) الكافي: ج 2، ك 1، ب 78، ح 13.(@)(@@) * وروى عمن حدثه، عن عبد الرحمان العزرمي، وروى عنه أحمد ابنه.(@)(@@) الكافي: ج 4، ك 1، ب 37، ح 7.(@)(@@) * وروى عمن حدثه، عن المفضل ابن عمر، وروى عنه إبراهيم بن هاشم.(@)(@@) الكافي: ج 1، ك 3، ب 79، ح 1.(@)(@@) * وروى عمن ذكره، عن أبي جعفر عليه السلام، وروى عنه أحمد ابنه.(@)(@@) الكافي: ج 2، ك 1، ب 127، ح 2.(@)(@@) * وروى عمن ذكره، عن أبي الحسن موسى عليه السلام، وروى عنه 
ms5505	 أحمد ابنه.(@)(@@) الكافي: ج 5، ك 3، ب 141، ح 3.(@)(@@) والروضة: ح 465. والتهذيب: ج 7، ح 1644.(@)(@@) * وروى عمن ذكره، عن أبي عبد الله عليه السلام، وروى عنه أحمد PageV17P389(@)(@@) ابن محمد.(@)(@@) التهذيب: ج 1، ح 987.(@)(@@) * وروى عمن ذكره، عن الرضا عليه السلام، وروى عنه أحمد ابنه.(@)(@@) الكافي: ج 5، ك 1، ب 24، ح 5.(@)(@@) * وروى عمن ذكره، عن زيد الشحام، وروى عنه أحمد ابنه.(@)(@@) الكافي: ج 1، ك 2، ب 16، ح 8.(@)(@@) * وروى عمن ذكره، عن محمد بن عبد الرحمان بن أبي ليلى، وروى عنه أحمد ابنه.(@)(@@) الكافي: ج 1، ك 2، ب 13، ح 7، وك 4، ب 7، ح 6، و ج 2، ك 1، ب 23، ح 3، و ب 58، ح 1، و 2، وب 139، ح 4.(@)(@@) * وروى عمن ذكره، عن المفضل الجعفي، وروى عنه أحمد ابنه.(@)(@@) الكافي: ج 5، ك 3، ب 189، ح 3.(@)(@@) * وروى أحمد ابنه عنه أو غيره، عن سعد بن سعد.(@)(@@) الكافي: ج 5، ك 3، ب 190، ح 50.(@)(@@) وروى أحمد ابنه عنه أو غيره، عن محمد بن أسلم الجبلي.(@)(@@) الكافي: ج 6، ك 8، ب 43، ح 1.(@)(@@) * وروى أحمد ابنه عنه أو غيره، عن هارون بن خارجة.(@)(@@) الكافي: ج 2، ك 2، ب 14، ح 5.(@)(@@) محمد بن خالد البرقي * روى عن أبي جعفر الثاني عليه السلام.(@)(@@) الفقيه: ج 2، ح 52.(@)(@@) وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 3، ك 5، ب 42، ح 1.(@)(@@) * وروى عن أبي البختري، وروى عنه أحمد بن محمد.(@)(@@) التهذيب: ج 3، ح 879 (الاستبصار:(@)(@@) ج 1، ح 1753).(@)(@@) * وروى عن ابن أبي عمير، وروى عنه محمد بن علي بن محبوب.(@)(@@) التهذيب: ج 3، ح 325.(@)(@@) * وروى عن أحمد بن محمد، وروى عنه أحمد بن محمد بن عيسى.(@)(@@) التهذيب: ج 1، ح 908.(@)(@@) * وروى عن أحمد بن النضر الخزاز، وروى عنه أحمد بن محمد بن عيسى.(@)(@@) التهذيب: ج 3، ح 981 (الاستبصار:(@)(@@) ج 1، ح 1838).(@)(@@) * وروى عن إسماعيل بن سهل، وروى عنه أبو جعفر. PageV17P390(@)(@@) التهذيب: ج 4، ح 372.(@)(@@) * وروى عن إسماعيل بن مهران، وروى عنه أحمد ابنه.(@)(@@) مشيخة الفقيه: في طريقه إلى إسماعيل ابن مهران.(@)(@@) * وروى عن جعفر بن بشير، وروى عنه أحمد بن محمد.(@)(@@) التهذيب: ج 3، ح 585.(@)(@@) * وروى عن الحسن بن علي بن فضال، وروى عنه أبو جعفر.(@)(@@) التهذيب: ج 
