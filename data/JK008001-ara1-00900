ms881	 ) عن أبي هريرة .(@)(@@) 6333 - إذا كان في آخر الزمان لابد للناس فيها من الدراهم والدنانير يقيم الرجل بها دينه ودنياه .(@)(@@) % ( طب ) عن المقدام .(@)(@@) 6334 - ليس بخيركم من ترك دنياه لآخرته ولا آخرته لدنياه حتى يصيب منهما جميعا ، فإن الدنيا بلاغ إلى الآخرة ، ولا تكونوا كلا على الناس .(@)(@@) % ابن عساكر عن أنس .(@)(@@) 6335 - نعم العون على الدين قوت سنة .(@)(@@) % ( ذكر العجلوني في كشف الخفاء برقم ( 2819 ) . وقال : رواه الديلمي عن معاوية بن حيدة وفي المنتخب يعزوه ( فر ) يعني للديلمي في الفردوس . ص ) عن معاوية ابن حيدة .(@)(@@) 6336 - خيركم من لم يترك آخرته لدنياه ، ولا دنياه لآخرته ، ولم يكن كلا على الناس .(@)(@@) % ( ك ( عن أنس .(@)(@@) 6337 - من استطاع منكم أن يقي دينه وعرضه بماله فليفعل .(@)(@@) % ( د ) عن أبي سعيد .(@)(@@) | 1 ( الإكمال من تتمة في فوائد المال والدنيا المحمودة ) 1(@)(@@) 6338 - إن الفاقة لأصحابي سعادة ، وإن الغنى للمؤمن في آخر الزمان سعادة .(@)(@@) % الرافعي عن أنس عن ابن مسعود .(@)(@@) 6339 - إن هذا المال حلوة خضرة ، فمن أخذه بحقه فنعم المعونة هو .(@)(@@) % سمويه وابن خزيمة ( طس ص ) عن أبي سعيد .(@)(@@) 6340 - إن هذا المال خضرة حلوة ، فمن يأخذه بحقه يبارك له فيه .(@)(@@) % ( حم طب هب ) عن معاوية .(@)(@@) 6341 - نعمت الدار الدنيا لمن تزود منها لآخرته حتى يرضي ربه وبئست الدار الدنيا لمن صدته عن آخرته ، وقصرت به عن رضا ربه وإذا قال العبد : قبح الله الدنيا ، قالت الدنيا : قبح الله أعصانا لربه .(@)(@@) % ( ك ) وتعقب وابن لال والرامهرمزي في الأمثال عن طارق بن أشيم ( ذكره في الإصابة وفي تهذيب التهذيب ( 5 / 2 ) لابن حجر : وقال الخطيب في كتاب القنوت في صحبته نظر . ص ) .(@)(@@) 6342 - نعم العون على تقوى الله المال .(@)(@@) % ابن لال والديلمي عن جابر .(@)(@@) 6343 - لا تسبوا الدنيا ، فلنعم المطية للمؤمن ، عليها يبلغ الخير وعليها ينجو من الشر .(@)(@@) % الديلمي وابن النجار عن ابن مسعود .(@)(@@) 6344 - لما أهبط الله آدم من الجنة إلى الأرض حزن عليه كل شيء جاوره إلا الذهب والفضة ، فأوحى الله تعالى إليهما 
ms882	 جاورتكما بعبد من عبيدي ثم أهبطته من جواركما ، فحزن عليه كل شيء جاوره إلا أنتما ، فقالا : إلهنا وسيدنا أنت أعلم إنك جاورتنا(@)(@@) PageV03P098 به وهو لك مطيع فلما عصاك لم نحب أن نحزن عليه ، فأوحى الله تعالى إليهما : وعزتي وجلالي لأعزنكما حتى لا ينال كل شيء إلا بكما .(@)(@@) % الديلمي وابن النجار عن أنس .(@)(@@) 6345 - لا خير فيمن لا يحب المال يصل به رحمه ، ويؤدي به أمانته ويستغنى به عن خلق ربه .(@)(@@) % ( حب ) في الضعفاء وابن المبارك وابن لال ( ك ) في تاريخه ( حب ) عن أنس قال حب : لا أصل له وأورده ابن الجوزي في الموضوعات وقال هب : وإنما يروى عن سعيد بن المسيب قوله .(@)(@@) 6346 - ياتي على الناس زمان : من لم يكن معه أصفر ولا أبيض لم يتهن بالعيش .(@)(@@) % ( طب حل ) عن المقدام بن معد يكرب .(@)(@@) 6347 - يأتي على الناس زمان لا ينفع فيه إلا الدينار والدرهم .(@)(@@) % نعيم بن حماد في الفتن عن المقدام بن معد يكرب .(@)(@@) 6348 - يا جابر لا عليك أن تمسك عليك مالك فإن لهذا الأمر مدة .(@)(@@) % ( طب ) عن جابر .(@)(@@) | 1 ( زهده صلى الله عليه وسلم من الإكمال ) 1(@)(@@) 6349 - أما إني لا أحرمه ، ولكني أتركه تواضعا لله ، فإن من تواضع لله رفعه الله ، ومن اقتصد أغناه الله ، ومن بذر أفقره الله .(@)(@@) % الحكيم عن محمد بن علي أن رسول الله صلى الله عليه وسلم أتاه أوس ( قال في القاموس : أوس بن خولي محركة - يعني الواو من خولي وقد تسكن . ح ) بن خولي بقدح فيه لبن وعسل فوضعه وقال فذكره .(@)(@@) 6350 - شربتان في شربة وأدمان في قدح ، لا حاجة لي فيه ، أما إني لا أزعم أنه حرام ، ولكني أكره أن يسألني الله عن فضول الدنيا يوم القيامة ، أتواضع لله ، فمن تواضع لله رفعه الله ، ومن تكبر وضعه الله ، ومن استغنى أغناه الله ، ومن أكثر ذكر الله أحبه الله .(@)(@@) % ( قط ) في الأفراد ( طس ) عن عائشة قال : أتي رسول الله صلى الله عليه وسلم بقدح فيه لبن وعسل قال : فذكره .(@)(@@) 6351 - رديه 
ms883	 فيه ثم اعجنيه ( عجن : في القاموس : عجن يعجن بضم جيم المضارع وكسر يعني من باب الأول الثلالي المجرد ومن باب الثاني الخ . ح ) .(@)(@@) % ( ه ) عن أم أيمن .(@)(@@) 6352 - إنزعيه فإنه يذكرني الدنيا .(@)(@@) % ( ت ) حسن ( ن ) عن عائشة قالت : كان لنا قرام ستر فيه تماثيل ، فقال النبي صلى الله عليه وسلم : فذكره ( رواه الترمذي كتاب صفة القيامة رقم ( 2470 ) وقال : حديث حسن(@)(@@) قرام ستر : بكسر القاق وتخفيف الراء وهو الستر الرقيق من صوف ذو ألوان . تحفة الأحوذي ( 7 / 167 ) . ص ) .(@)(@@) 6353 - حولي هذا فإني كلما دخلت فرأيته ذكرت الدنيا .(@)(@@) % ( م ) عن عائشة قالت : كان لنا ستر فيه تمثال طائر فقال النبي صلى الله عليه وسلم : فذكره ( رواه مسلم في صحيحه كتاب اللباس والزينة باب تحريم تصوير الحيوان رقم ( 88 ) عن عائشة رضي الله عنها . ص ) .(@)(@@) 6354 - يا عائشة حولي هذا فإني كلما دخلت فرأيته ذكرت الدنيا .(@)(@@) % ابن المبارك ( حم ن ) عن عائشة .(@)(@@) PageV03P099(@)(@@) 6355 - إنه ليس لي ولا لنبي أن يدخل بيتا مزوقا .(@)(@@) % ( حل ) عن سفينة عن علي .(@)(@@) 6356 - لا ينبغي لنبي أن يدخل بيتا مزوقا .(@)(@@) % ( هب ) عن أم سلمة .(@)(@@) 6357 - لا ينبغي لرجل أن يدخل بيتا مزوقا .(@)(@@) % ( هب ) عن أم سلمة .(@)(@@) 6358 - إن ما جئت به غير مغن عنا شيئا إلا ما أغنت حجارة الحرة ، ولكنه متاع الحياة الدنيا .(@)(@@) % ( حم حب ص ) عن أبي سعيد أن رجلا قدم بحلي من البحرين ، فقال رسول الله صلى الله عليه وسلم : فذكره .(@)(@@) 6359 - إني والله ما يسرني أن لي أحدا ذهبا كله ثم أورثه .(@)(@@) % ( طب ) عن سمرة .(@)(@@) 6360 - ذكرت وأنا في الصلاة تبرا عندنا فكرهت أن يمسي أو يبيت عندنا فأمرت بقسمته .(@)(@@) % ( حم ) عن عقبة بن الحارث .(@)(@@) 6361 - مالي وللدنيا ؟ وما للدنيا وما لي ؟ والذي نفسي بيده ما مثلي ومثل الدنيا إلا كراكب سار في يوم صائف ، فاستظل تحت شجرة ساعة من نهار ، ثم راح وتركها .(@)(@@) % ( حم طب حب ك هب ) عن ابن عباس قال : دخل عمر على رسول الله صلى الله عليه وسلم 
ms884	 وهو على حصير قد أثر في جنبه ، فقال : يا رسول الله لو اتخذت فراشا أوثر من هذا ، قال : فذكره .(@)(@@) 6362 - لو أن لي مثل أحد ذهبا ما سرني أن يأتي علي ثلاث ليال وعندي منه شيء ، إلا شيء أرصده لدين .(@)(@@) % ( ق ) وابن عساكر عن أبي هريرة .(@)(@@) 6363 - ما أحب أن لي أحدا ذهبا أموت يوم أموت وعندي منه دينار أو نصف دينار ، إلا أن أرصده لغريم .(@)(@@) % ( حم ) والدارمي عن أبي ذر .(@)(@@) 6364 - ما أحب أن أحدا عندي ذهبا ، فيأتي علي ثلاث وعندي منه شيء ، إلا شيء أرصده في قضاء دين .(@)(@@) % ( ه ) عن أبي هريرة .(@)(@@) 6365 - ما أحب أن لي هذا الجبل ذهبا أنفقه ويتقبل مني ، أذر خلفي منه شيئا .(@)(@@) % ( حم ) عن أبي ذر وعثمان معا .(@)(@@) 6366 - والذي نفسي بيده ما يسرني أن أحدا تحول لآل محمد ذهبا أنفقه في سبيل الله أموت يوم أموت وأدع منه دينارين ، إلا دينارين أعدهما لدين إن كان علي .(@)(@@) % ( حم طب ) عن ابن عباس .(@)(@@) 6367 - والذي نفس محمد بيده لو كان أحد عندي ذهبا لأحببت أن لا يأتي علي ثلاث وعندي منه دينار أجد من يقبله مني ليس شيئا أرصده في دين علي .(@)(@@) % ( حم ) عن أبي هريرة .(@)(@@) 6368 - إني لألج هذه الغرفة ما ألجها حينئذ إلا خشية أن يكون فيها مال فأتوفى ولم أنفقه .(@)(@@) % ( طب ص ) عن سمرة .(@)(@@) PageV03P100(@)(@@) 6369 - ما ظن محمد بربه لو لقي الله وهذه الدنانير عنده .(@)(@@) % ( حم ) وهناد وابن عساكر عن عائشة .(@)(@@) 6370 - ما كان محمد قائلا لربه لو مات وهذه عنده .(@)(@@) % ( طب حل ) عن ابن عباس ) قال خرج رسول الله صلى الله عليه وسلم على أصحابه وفي يده قطعة من ذهب فقسمها فقال فذكره .(@)(@@) 6371 - من سأل عني أو سره أن ينظر إلي فلينظر إلى أشعث شاحب مشمر لم يضع لبنة على لبنة ، ولا قصبة على قصبة رفع له علم فشمر إليه ، اليوم مضمار ( اليوم مضمار قال في النهاية : أي اليوم العمل في الدنيا للاستباق في الجنة والمضمار الموضع الذي تضمر 
ms885	 فيه الخيل . انتهى . ح ) وغدا السباق والغاية الجنة أو النار .(@)(@@) % ( حل ) عن عائشة .(@)(@@) 6372 - لا تبك يا عمر فلو شئت أن تصير الجبال ذهبا لصارت ، ولو أن الدنيا تعدل عند الله جناح ذباب ما أعطى كافرا منها شيئا .(@)(@@) % ابن سعد عن عطاء مرسلا .(@)(@@) 6373 - أولئك عجلت لهم طيباتهم ، وهي وشيكة الانقطاع ، وإنا قوم أخرت لنا طيباتنا في آخرتنا .(@)(@@) % ( ك ) عن عمر رضي الله عنه .(@)(@@) 6374 - ما أوحي إلي أن أكون تاجرا ولا أن أجمع المال مكاثرا ، ولكن أوحي إلي أن سبح بحمد ربك وكن من الساجدين واعبد ربك حتى يأتيك اليقين .(@)(@@) % ( ك ) في تاريخه عن أبي ذر .(@)(@@) 6375 - ما أوحي إلي أن أكون من التاجرين ولكن أوحي إلي أن سبح بحمد ربك وكن من الساجدين واعبد ربك حتى يأتيك اليقين .(@)(@@) % ( حل ) عن أبي مسلم الخولاني ( الحلية ( 2 / 131 ) رواه جبير بن نفير عن أبي مسلم الخولاني مرسلا .(@)(@@) وأبو مسلم الخولاني هو : عبد الله بن ثوب اليماني الزاهد الشامي رحل يطلب النبي صلى الله عليه وسلم وتوفي النبي صلى الله عليه وسلم وهو في الطريق فلقي أبا بكر الصديق رضي الله عنه .(@)(@@) وذكره ابن سعد في الطبقة الثانية من تابعي أهل الشام وقال كان ثقة وتوفي ( 62 ) زمن يزيد بن معاوية .(@)(@@) راجع تهذيب التهذيب ( 12 / 235 ) الإكمال في أسماء الرجال لصاحب المشكاة ( 3 / 768 ) .(@)(@@) والمراد هنا باليقين : الموت ، خلافا للملاحدة الذين يقولون : أن المراد باليقين المعرفة . راجع تفسير ابن كثير ( 4 / 176 ) عند آخر سورة الحجر آية ( 99 ) . ص ) .(@)(@@) | 1 ( حرف السين ) 1(@)(@@)(@)(@@) | 1 ( فضائل السخاء ذكر في كتاب الزكاة ) 1(@)(@@)(@)(@@) | 1 ( السمت الحسن والهدي الصالح ) 1(@)(@@) 6376 - السمت الحسن والتؤدة والاقتصاد جزء من أربعة وعشرين جزءا من النبوة .(@)(@@) % ( ت ) عن عبد الله بن سرجس . مر برقم [ 5672 ] .(@)(@@) 6377 - السمت الحسن جزء من خمسة وسبعين جزءا من النبوة .(@)(@@) % الضياء عن أنس ( مر باب التؤدة والتبين في ( ص 100 ) من هذا الجزء . ص ) .(@)(@@) 6378 - إن الهدي الصالح والسمت الحسن جزء من سبعين 
ms886	 جزءا من النبوة .(@)(@@) % ( طب ) عن ابن عباس .(@)(@@) | 1 ( ستر العيب ) 1(@)(@@) 6379 - من رأى عورة فسترها كان كمن أحيا موؤدة من قبرها .(@)(@@) % ( خد د ك ) عن عقبة بن عامر .(@)(@@) PageV03P101(@)(@@) 6380 - من أطفأ عن مؤمن سيئة كان خيرا ممن أحيا موؤدة .(@)(@@) % ( هب ) عن أبي هريرة .(@)(@@) 6381 - من ستر عورة أخيه المسلم ستر الله عورته يوم القيامة ، ومن كشف عورة أخيه المسلم كشف الله عورته حتى يفضحه بها في بيته .(@)(@@) % ( ه ) عن ابن عباس .(@)(@@) 6382 - من ستر أخاه المسلم في الدنيا ستره الله يوم القيامة .(@)(@@) % ( حم ) عن رجل .(@)(@@) 6383 - لا يستر عبد عبدا في الدنيا إلا ستره الله يوم القيامة .(@)(@@) % ( م ) عن أبي هريرة ( صحيح مسلم في كتاب البر والصلة باب بشارة من ستر الله تعالى . . . رقم ( 2590 ) . ص ) .(@)(@@) 6384 - من أراد منكم أن يستر أخاه المؤمن بطرف ثوبه فليفعل .(@)(@@) % ( فر ) عن جابر .(@)(@@) | 1 ( الإكمال من ستر العيب ) 1(@)(@@) 6385 - من ستر على مؤمن عورة فإنما أحيا موؤدة من قبرها .(@)(@@) % ابن مردويه ( هب ) والخرائطي في مكارم الأخلاق ( كر ) وابن النجار عن جابر ( طس ) عن سلمة بن مخلد ( هو : مسلمة بن مخلد الأنصاري الزرقي سكن مصر وكان واليا عليها أيام معاوية وولد حين قدم النبي صلى الله عليه وسلم المدينة .(@)(@@) ويوم توفي وأنا ابن عشر سنين وتوفي سنة ( 62 ) .(@)(@@) قال البخاري : له صحبة وقال العسكري : له رؤية .(@)(@@) وقال ابن عبد البر : كانت مدة ولايته على مصر وإفريقيا ( 16 ) سنة .(@)(@@) قال ابن حجر في التقريب : مخلد بتشديد اللام وبفتح المعجمة يعني الخاء . انتهى . تهذيب التهذيب ( 10 / 148 ) . ص ) ( حم ق ) عن عقبة بن عامر .(@)(@@) 6386 - من ستر عورة مؤمن فكأنما استحيا موؤدة من قبرها .(@)(@@) % ( حب هب ) عن عقبة بن عامر .(@)(@@) 6387 - من ستر على مؤمن خزية فكأنما أحيا موؤدة من قبرها .(@)(@@) % الخرائطي عن عقبة بن عامر .(@)(@@) 6388 - من ستر على مؤمن فاحشة فكأنما أحيا موؤدة .(@)(@@) % ( هب ) عن أبي هريرة .(@)(@@) 6389 - من ستر مؤمنا في الدنيا على عورة ستره الله يوم القيامة .(@)(@@) % . . . عن عقبة بن 
ms887	 عامر ( يورد العجلوني في كشف الخفاء برقم ( 2497 ) حديث من ستر مسلما : ويعزوه لعقبة بن عامر رواه أحمد والبيهقي . ص ) .(@)(@@) 6390 - من ستر مسلما ستره الله يوم القيامة .(@)(@@) % الخرائطي في مكارم الأخلاق عن عقبة بن عامر .(@)(@@) 6391 - من علم من أخيه سيئة فسترها عليه ستر الله عليه يوم القيامة .(@)(@@) % ( طب ) عن عقبة بن عامر ومسلمة بن مخلد .(@)(@@) 6392 - من ستر أخاه في فاحشة رآها عليه ستره الله في الدنيا والآخرة .(@)(@@) % ( حب ) عن عقبة بن عامر .(@)(@@) 6393 - من ستر مسلما ستره الله في الدنيا والآخرة .(@)(@@) % أبو نعيم عن ثابت بن مخلد .(@)(@@) 6394 - من ستر مسلما ستره الله في الدنيا والآخرة ، ومن فك عن مكروب فك الله عنه كربة من كرب يوم القيامة ، ومن كان في حاجة أخيه كان الله في حاجته .(@)(@@) % ( عب حم ) وابن أبي الدنيا في قضاء الحوائج وأبو نعيم والخطيب عن مسلمة بن مخلد .(@)(@@) PageV03P102(@)(@@) 6395 - من وجد مسلما على عورة فسترها فكأنما أحيا موؤدة ( وأد : فيه : أنه نهي عن وأد البنات أي قتلهن ، كان إذا ولد لأحدهم في الجاهلية بنت دفنها في التراب وهي حية يقال : وأدها يئدها وأدا فهي موؤدة وهي التي ذكر الله تعالى في كتابه : { وإذا الموؤدة سئلت } سورة التكوير آية 8 .(@)(@@) النهاية في غريب الحديث ( 5 / 143 ) . ص ) من قبرها .(@)(@@) % ( طب ) عن عقبة بن عامر .(@)(@@) 6396 - من ستر أخاه المسلم بما يرضيه أرضاه الله تعالى في الدنيا والآخرة .(@)(@@) % ابن النجار عن أبي هريرة .(@)(@@) 6397 - لا يرى امرؤ من أخيه سيئة فيسترها عليه إلا أدخل الجنة .(@)(@@) % عبد بن حميد والخرائطي في مكارم الأخلاق عن أبي سعيد ، ابن النجار عن عقبة بن عامر بلفظ أدخله الله .(@)(@@) | 1 ( السكينة والوقار ) 1(@)(@@) 6398 - السكينة عباد الله السكينة .(@)(@@) % أبو عوانة عن جابر .(@)(@@) 6399 - السكينة مغنم وتركها مغرم .(@)(@@) % ( ك ) في تاريخه والإسماعيلي في معجمه عن أبي هريرة .(@)(@@) 6400 - السكينة في أهل الشاء والبقر .(@)(@@) % البزار عن أبي هريرة .(@)(@@) 6401 - ليس البر في حسن اللباس والزي ولكن البر في السكينة والوقار .(@)(@@) % ( فر ) عن 
ms888	 أبي سعيد .(@)(@@) 6402 - يا أيها الناس عليكم بالسكينة والوقار ، فإن البر ليس في إيضاع ( إيضاع قال في النهاية : وضع البعير يضع وضعا وأوضعه راكبه إيضاعا إذا حمله على سرعة السير . انتهى . والمعنى ليس البر في كثرة الإبل التي يملكها ويركبها . ح ) الإبل .(@)(@@) % ( حم د ك ) عن أسامة بن زيد .(@)(@@) | 1 ( الإكمال من السكينة والوقار ) 1(@)(@@) 6403 - يا مسكينة عليك بالسكينة .(@)(@@) % ( طب ) عن قيلة بنت مخرمة .(@)(@@) | 1 ( حرف الشين ) 1(@)(@@)(@)(@@) | 1 ( الشكر ) 1(@)(@@) 6404 - ما أنعم الله تعالى على عبد نعمة فقال : الحمد لله إلا كان الذي أعطي أفضل مما أخذ .(@)(@@) % ( ه ) عن أنس .(@)(@@) 6405 - ما أنعم الله على عبد نعمة فحمد الله عليها إلا كان ذلك الحمد أفضل من تلك النعمة وإن عظمت .(@)(@@) % ( طب ) عن أبي أمامة .(@)(@@) 6406 - لو أن الدنيا كلها بحذافيرها بيد رجل من أمتي ، ثم قال : الحمد لله لكان الحمد لله أفضل من ذلك كله .(@)(@@) % ابن عساكر عن أنس .(@)(@@) 6407 - ما أنعم الله على عبد من نعمة فقال : الحمد لله ، إلا أدى شكرها ، فإن قالها ثانية جدد الله له ثوابها ، فإن قالها ثالثة غفر الله له ذنوبه .(@)(@@) % ( ك هب ) عن جابر .(@)(@@) PageV03P103(@)(@@) 6408 - ما أنعم الله على عبد نعمة على أهل ومال وولد فيقول : ما شاء الله لا قوة إلا بالله فيرى فيه آفة دون الموت .(@)(@@) % ( هب ع ) عن أنس .(@)(@@) 6409 - إن الله تعالى يحب أن يحمد .(@)(@@) % ( طب ) عن الأسود بن سريع .(@)(@@) 6410 - أول من يدعى إلى الجنة الحمادون الذين يحمدون الله في السراء والضراء .(@)(@@) % ( طب ك هب ) عن ابن عباس .(@)(@@) 6411 - أحسنوا جوار نعم الله ، لا تنفروها فقل ما زالت عن قوم فعادت إليهم .(@)(@@) % ( ع عد ) عن أنس ( هب ) عن عائشة .(@)(@@) 6412 - إذا أراد الله بقوم خيرا أمد لهم في العمر وألهمهم الشكر .(@)(@@) % ( فر ) عن أبي هريرة .(@)(@@) 6413 - أشكر الناس لله أشكرهم للناس .(@)(@@) % ( حم طب هب ) والضياء عن الأشعث بن قيس ( طب هب ) عن أسامة بن زيد عن ابن مسعود .(@)(@@) 6414 - إن أفضل عباد الله يوم القيامة 
ms889	 الحمادون .(@)(@@) % ( طب ) عن عمران بن حصين .(@)(@@) 6415 - إن للطاعم الشاكر من الأجر مثل ما للصائم الصابر .(@)(@@) % ( ك ) عن أبي هريرة .(@)(@@) 6416 - إن أول ما يسأل عنه العبد يوم القيامة من النعيم أن يقال له : ألم نصح جسمك ؟ ونروك من الماء البارد ؟(@)(@@) % ( د ت ) عن أبي هريرة .(@)(@@) 6417 - الإشرة ( الإشرة : بكسر الهمزة وسكون الشين اسم للحالة التي عليها الإنسان البطر ، وفعلة لمرة كجلسه وفعلة لهيئة كجلسه ، فالمعنى أن حالة البطر للإنسان شر . انتهى . ح ) شر .(@)(@@) % ( خد ع ) عن البراء .(@)(@@) 6418 - التحدث بنعمة الله شكر ، وتركها كفر ، ومن لا يشكر القليل لا يشكر الكثير ، ومن لا يشكر الناس لا يشكر الله ، والجماعة بركة والفرقة عذاب .(@)(@@) % ( هب ) عن النعمان بن بشير .(@)(@@) 6419 - الحمد رأس الشكر ، ما يشكر الله عبد لا يحمده .(@)(@@) % ( عب هب ) عن ابن عمر .(@)(@@) 6420 - رب طاعم شاكر أعظم أجرا من صائم صابر .(@)(@@) % القضاعي عن أبي هريرة .(@)(@@) 6421 - الحمد على النعمة أمان لزوالها .(@)(@@) % ( هب ) عن عمر .(@)(@@) 6422 - إذا نظر أحدكم إلى من فضل عليه في المال والخلق فلينظر إلى من هو أسفل منه .(@)(@@) % ( حم ق ) عن أبي هريرة . مر برقم [ 6093 ] .(@)(@@) 6423 - خصلتان من كانتا فيه كتبه الله شاكرا صابرا ، ومن لم تكونا فيه لم يكتبه الله شاكر ولا صابرا ، من نظر في دينه إلى من هو فوقه فاقتدى به ، ونظر في دنياه إلى من هو دونه فحمد الله على ما فضله به عليه كتبه الله شاكرا صابرا ، ومن نظر في دينه إلى(@)(@@) PageV03P104 من هو دونه ، ونظر في دنياه إلى من هو فوقه فأسف على ما فاته منه لم يكتبه الله لا شاكرا ولا صابرا .(@)(@@) % ( ت ) عن ابن عمر ( في كتاب صفة القيامة رقم ( 2514 ) عن عبد الله بن عمر وقال : هذا حديث حسن غريب . وفي سنده المثنى بن الصباح وهو ضعيف . ص ) .(@)(@@) 6424 - أنظروا إلى من هو أسفل منكم ولا تنظروا إلى من هو فوقكم فهو أجدر ألا تزدروا نعمة الله عليكم .(@)(@@) % ( حم هب ) عن أبي هريرة ( رواه مسلم في 
ms890	 صحيحه كتاب الزهد والرقائق عن أبي هريرة بهذا اللفظ المذكور برقم ( 9 ) .(@)(@@) ورواه الترمذي في كتاب صفة القيامة رقم ( 2515 ) وقال هذا حديث صحيح وأخرجه أحمد ومسلم وابن ماجه ) .(@)(@@) تحفة الأحوذي ( 7 / 216 ) وبهذا اللفظ . ص ) .(@)(@@) 6425 - الطاعم الشاكر بمنزلة الصائم الصابر .(@)(@@) % ( حم ت د ك ) عن أبي هريرة .(@)(@@) 6426 - الطاعم الشاكر له أجر الصائم الصابر .(@)(@@) % ( حم ه ) عن سنان بن سنة .(@)(@@) 6427 - قال الله تعالى : يا ابن آدم إنك ما ذكرتني شكرتني وإذا ما نسيتني كفرتني .(@)(@@) % ( طس ) عن أبي هريرة .(@)(@@) 6428 - قال موسى : يا رب كيف شكرك ابن آدم ؟ فقال : علم أن ذلك مني ، فكان ذلك شكره .(@)(@@) % الحكيم عن الحسن مرسلا .(@)(@@) 6429 - قلب شاكر ولسان ذاكر وزوجة صالحة تعينك على أمور دنياك ودينك خير ما اكتنز الناس .(@)(@@) % ( هب ) عن أبي أمامة .(@)(@@) 6430 - لأنا أشد عليكم خوفا من النعم مني من الذنوب ، ألا إن النعم التي لا تشكر هي الحتف القاضي .(@)(@@) % ابن عساكر عن المنذر بن محمد بن المنذر بلاغا .(@)(@@) 6431 - لأنا من فتنة السراء أخوف عليكم من فتنة الضراء ، إنكم ابتليتم بفتنة الضراء فصبرتم ، وإن الدنيا حلوة خضرة .(@)(@@) % ( البزار ( حل هب ) عن سعد .(@)(@@) 6432 - ليتخذ أحدكم قلبا شاكرا ولسانا ذاكرا وزوجة مؤمنة تعينه على أمر الآخرة .(@)(@@) % ( حم ن ه ) عن ثوبان .(@)(@@) 6433 - ما شئت أن أرى جبريل متعلقا بأستار الكعبة وهو يقول : يا واحد يا ماجد لا تزل عني نعمة أنعمت بها علي إلا رأيته .(@)(@@) % ابن عساكر عن علي .(@)(@@) 6434 - أيما عبد جاءته موعظة من الله تعالى من دينه فإنها نعمة من الله سيقت إليه فإن قبلها بشكر وإلا كانت حجة من الله عليه ليزداد بها إثما ويزداد الله عليه بها سخطا .(@)(@@) % ابن عساكر عن عطية بن قيس .(@)(@@) 6435 - من شكر النعمة افشاؤها .(@)(@@) % ( عب ) عن قتادة مرسلا .(@)(@@) 6436 - من أبلى بلاء فذكره فقد شكره ، وإن كتمه فقد كفره .(@)(@@) % ( د ) والضياء عن جابر .(@)(@@) 6437 - إن الله ليدخل العبد الجنة بالأكلة أو الشربة يحمد الله عليها .(@)(@@) % ابن عساكر عن أنس .(@)(@@) PageV03P105(@)(@@) 6438 
ms891	 - هذا والذي نفسي بيده ، من النعيم الذي تسألون عنه يوم القيامة : ظل بارد ، ورطب طيب ، وماء بارد .(@)(@@) % ( ت ) عن أبي هريرة ( في كتاب الزهد باب ما جاء في معيشة أصحاب النبي صلى الله عليه وسلم وبرقم ( 2370 )(@)(@@) وقال الترمذي : هذا حديث حسن صحيح غريب . ص ) .(@)(@@) 6439 - والذي نفسي بيده ، لتسألن عن هذا النعيم يوم القيامة أخرجكم من بيوتكم الجوع ، ثم لم ترجعوا حتى أصابكم هذا النعيم .(@)(@@) % ( حم ) عن أبي هريرة ( وأخرجه مسلم في صحيحه كتاب الأشربة باب جواز استتباعه غيره إلى دار من يثق برضاه بذلك وبرقم ( 2038 ) . ص ) .(@)(@@) 6440 - لا يشكر الله من لا يشكر الناس .(@)(@@) % ( حم د حب ) عن أبي هريرة .(@)(@@) 6441 - إن عبدا من عباد الله قال : يا رب لك الحمد كما ينبغي لجلال وجهك ولعظيم سلطانك ، فأعضلت بالملكين ، فلم يدريا كيف يكتبانها ؟ فصعدا إلى السماء ، فقالا : يا ربنا إن عبدك قد قال مقالة لا ندري كيف نكتبها ؟ فقال الله عز وجل وهو أعلم بما قاله عبده : ماذا قال عبدي ؟ قالا : يا رب إنه قد قال : يا رب لك الحمد كما ينبغي لجلال وجهك ولعظيم سلطانك ، فقال الله لهما : اكتباها كما قال عبدي حتى يلقاني عبدي فأجزيه بها .(@)(@@) % ( ه ) عن ابن عمر .(@)(@@) 6442 - من أنعم الله عليه نعمة فليحمد الله ، ومن استبطأ الرزق فليستغفر الله ومن حزبه أمر فليقل : لا حول ولا قوة إلا بالله .(@)(@@) % ( هب ) عن علي .(@)(@@) 6443 - من لم يشكر الناس لا يشكر الله .(@)(@@) % ( حم ت ) عن أبي هريرة .(@)(@@) 6444 - نعمتان مغبون فيهما كثير من الناس : الصحة والفراغ .(@)(@@) % ( خ ت ه ) عن ابن عباس .(@)(@@) 6445 - لا بأس بالغنى لمن اتقى ، والصحة لمن اتقى خير من الغنى وطيب النفس من النعيم .(@)(@@) % ( حم ه ك ) عن يسار بن عبد .(@)(@@) 6446 - ثلاث من نعيم الدنيا ، وإن كان لا نعيم لها ، مركب وطيء ، والمرأة الصالحة ، والمنزل الواسع .(@)(@@) % ( ش ) عن أبي قرة أو قرة .(@)(@@) 6447 - فإن من تمام النعمة دخول الجنة والفوز من النار .(@)(@@) % ( ت ) عن معاذ ( رواه الترمذي في 
ms892	 كتاب الدعوات رقم ( 3524 ) وسبب ورود الحديث : عن معاذ بن جبل رضي الله عنه : قال سمع النبي صلى الله عليه وسلم رجلا يدعو يقول : اللهم إني أسألك تمام النعمة ، فقال : أي شيء تمام النعمة ؟ قال دعوة دعوت بها أرجو بها الخير قال : فإن من تمام النعمة دخول الجنة . . . . ص ) .(@)(@@) 6448 - خمس من أعطيهن لم يعذر على ترك عمل الآخرة : زوجة صالحة ، وبنون أبرار ، وحسن مخالطة الناس ، ومعيشة في بلده وحب آل محمد صلى الله عليه وسلم .(@)(@@) % ( فر ) عن زيد بن أرقم .(@)(@@) 6449 - من أسدى إلى قوم نعمة فلم يشكروها له فدعا عليهم استجيب له .(@)(@@) % الشيرازي عن ابن عباس .(@)(@@) | 1 ( الإكمال من الشكر ) 1(@)(@@) 6450 - أكثروا من الحمد لله ، فإن لها عينين وجناحين تطير في الجنة تستغفر لقائلها إلى القيامة .(@)(@@) % الديلمي عن ابن عمر .(@)(@@) PageV03P106(@)(@@) 6451 - أما إن ربك يحب المدح وفي لفظ : الحمد .(@)(@@) % ( حم خ ) في الأدب ( ن ) وابن سعد والطحاوي وابن قانع ( طب ك هب ص ) عن الأسود بن سريع .(@)(@@) 6452 - إن الله عز وجل يحب أن يحمد .(@)(@@) % ( طب ) عن الأسود بن سريع .(@)(@@) 6453 - إذا قلت : الحمد لله رب العالمين فقد شكرت الله فزادك .(@)(@@) % ابن جرير في تفسيره عن الحكم بن عمير الثمالي .(@)(@@) 6454 - أحسنوا جوار نعم الله ، فإنها قل ما نفرت عن أهل بيت فكادت ترجع إليهم .(@)(@@) % ( هب ) وضعفه ( خط ) عن الأسود بن سريع في رواة مالك وابن النجار عن عائشة .(@)(@@) 6455 - يا عائشة أحسني جوار نعم الله ، فإنها قل ما نفرت عن أهل بيت فكادت ترجع إليهم .(@)(@@) % الحكيم ( هب ) وضعفه والخطيب في رواة مالك عن عائشة .(@)(@@) 6456 - يا عائشة أكرمي كريما ، فإنها ما نفرت عن قوم قط فعادت إليهم .(@)(@@) % ( ه ) عن عائشة .(@)(@@) 6457 - إن الصحة والفراغ نعمتان من نعم الله مغبون فيهما كثير من الناس .(@)(@@) % ( حم ) عن ابن عباس .(@)(@@) 6458 - غنيمتان غبنهما كثير من الناس : الصحة والفراغ .(@)(@@) % الديلمي عن أنس .(@)(@@) 6459 - إذا رأى أحدكم من فضل عليه في الخلق والرزق فلينظر إلى من هو أسفل منه ممن فضل 
ms893	 هو عليه .(@)(@@) % ( هب ) عن أبي هريرة ( رواه مسلم في صحيحه كتاب الزهد والرقائق برقم ( 2963 ) وأوله : إذا نظر . ومر برقمي ( 6093 و 6422 ) . ص ) .(@)(@@) 6460 - أولم أقل : اللهم لك الحمد شكرا ولك المن فضلا ؟(@)(@@) % ( طب ) عن سعد بن إسحاق بن كعب بن عجرة عن أبيه عن جده قال : بعث رسول الله صلى الله عليه وسلم سرية ، فقال : علي إن سلمهم الله أن أشكره فغنموا وسلموا فاتنظره الناس يصنع شيئا فقيل له ؟ فقال : فذكره .(@)(@@) 6461 - قل ما أنعم الله على قوم نعمة إلا أصبح كثير منهم بها كافرين .(@)(@@) % ( طب ) عن أبي الدرداء .(@)(@@) 6462 - كل أمر ذي بال لا يبدأ فيه بحمد الله فهو أقطع ( أقطع أي ناقص وقليل النفع والجدوى بل لا خير فيه البتة . ح ) .(@)(@@) % ( طب ) والعسكري عن أبي هريرة .(@)(@@) 6463 - كل كلام لا يذكر الله فيه فيبدأ به ويصلي علي فيه فهو أقطع أكتع ممحوق من كل بركة .(@)(@@) % أبو الحسين أحمد بن محمد بن ميمون في فضائل علي عن أبي هريرة .(@)(@@) 6464 - كل أمر ذي بال لا يبدأ فيه بالحمد فهو أقطع .(@)(@@) % ( ق ) عن أبي هريرة ( طب ) والرهاوي عن عبد الله بن كعب بن مالك عن أبيه .(@)(@@) 6465 - للطاعم الشاكر من الأجر ما للصائم الصابر .(@)(@@) % ( ق ) عن أبي هريرة .(@)(@@) PageV03P107(@)(@@) 6466 - ما أنعم الله على عبد نعمة فعلم أنها من الله إلا كتب الله له شكرها قبل أن يحمده عليها ، وما أذنب عبد ذنبا فندم عليه إلا كتب الله تعالى له مغفرة قبل أن يستغفره ، وما اشترى عبد ثوبا بدينار أو نصف دينار فلبسه فحمد الله عليه ألا لم يبلغ ركبتيه حتى يغفر له .(@)(@@) % ( ك ) وتعقب ( هب ) عن عائشة .(@)(@@) 6467 - ما أنعم الله على عبد نعمة فحمد الله عليها إلا كان حمد الله أعظم منها كائنة ما كانت .(@)(@@) % ( عب هب ) عن الحسن مرسلا .(@)(@@) 6468 - ما أنعم الله على عبد نعمة فقال : الحمد لله رب العالمين إلا كان الذي يعطى أفضل مما أخذ .(@)(@@) % ( ه ) وابن السني ( طس هب ص ) عن أنس 
ms894	 .(@)(@@) 6469 - ما أنعم الله على عبد من نعمة صغيرة ولا كبيرة فحمد الله عليها إلا كان قد أعطي خيرا مما أخذ .(@)(@@) % هناد والحكيم عن الحسن مرسلا .(@)(@@) 6470 - ما من عبد ينعم الله عليه نعمة ؛ فيحمد الله إلا كان الحمد أفضل منها .(@)(@@) % ( طب ) عن جابر .(@)(@@) 6471 - ما من نعمة وإن تقادم عهدها فيجددها العبد بالحمد إلا جدد الله له ثوابها ، وما من مصيبة وإن تقادم عهدها فيجدد لها العبد الاسترجاع إلا جدد الله ثوابها وأجرها .(@)(@@) % الحكيم عن أنس .(@)(@@) 6472 - من أبلي بلاء فلم يجد إلا الثناء فقد شكر ، ومن كتم فقد كفر .(@)(@@) % ابن عساكر عن ابن عمر .(@)(@@) 6473 - من أبلي خيرا فلا يجد إلا الثناء فقد شكره ، ومن كتمه فقد كفره ، ومن تحلى بباطل فهو كلابس ثوبي زور .(@)(@@) % ( ح ) عن جابر .(@)(@@) 6474 - من أزلفت إليه يد فإن عليه من الحق أن يجزي بها ، فإن لم يفعل فليظهر الثناء ، فإن لم يفعل فقد كفر النعمة .(@)(@@) % ابن أبي الدنيا في قضاء الحوائج عن يحيى بن صيفي مرسلا .(@)(@@) 6475 - من أنعم على أخيه نعمة فلم يشكرها فدعا عليه استجيب له .(@)(@@) % ( عق ) وابن لال والشيرازي في الألقاب عن . . . ( مر برقم ( 6449 ) . ص ) والخطيب عن ابن عباس .(@)(@@) 6476 - من أنعم الله عليه نعمة فأراد بقاءها فليكثر من قول : لا حول ولا قوة إلا بالله ، ثم قرأ : { ولولا إذ دخلت جنتك قلت ما شاء الله لا قوة إلا بالله } .(@)(@@) % ( طب ) عن عقبة بن عامر .(@)(@@) PageV03P108(@)(@@) 6477 - من لم يعرف فضل نعمة الله تعالى عليه إلا في مطعمه ومشربه فقد قصر عمله ودنا عذابه .(@)(@@) % الخطيب عن عائشة .(@)(@@) 6478 - من لم يحمد الله على ما عمل من عمل صالح وحمد نفسه قل شكره وحبط عمله ، ومن زعم أن الله جعل للعباد من الأمر شيئا فقد كفر بما أنزل الله على الأنبياء ، ألا له الخلق والأمر .(@)(@@) % ابن جرير عن عبد العزيز الشامي عن أبيه . وكانت له صحبة .(@)(@@) 6479 - من لم يشكر القليل لم يشكر الكثير ، ومن لم يشكر الناس لم يشكر 
ms895	 الله ، والتحدث بنعمة الله شكر ، وتركها كفر ، والجماعة رحمة والفرقة عذاب .(@)(@@) % ( عم هب خط ) في المتفق والمفترق عن النعمان بن بشير .(@)(@@) 6480 - من لم يشكر القليل لم يشكر الكثير ، ومن لم يشكر الناس لم يشكر الله ، وما تكرهون في الجماعة خير مما تحبون في الفرقة ، في الجماعة رحمة وفي الفرقة عذاب .(@)(@@) % الديلمي عن جابر .(@)(@@) 6481 - أشكركم لله أشكركم للناس .(@)(@@) % ( طب هب ) عن الأشعث بن قيس .(@)(@@) 6482 - من لا يشكر الناس لا يشكر الله عز وجل ومن لا يشكر القليل لا يشكر الكثير .(@)(@@) % الخطيب وابن عساكر عن ابن عباس ، ابن أبي الدنيا عن النعمان بن بشير .(@)(@@) 6483 - من أشكر الناس لله أشكرهم للناس .(@)(@@) % ابن جرير في تهذيبه عن الأشعث بن قيس .(@)(@@) 6484 - لا بأس بالغنى لمن اتقى ، والصحة لمن اتقى خير من الغنى وطيب النفس من النعيم .(@)(@@) % ( حم ه ) والحكيم والبغوي ( ك ه ) عن معاذ بن عبد الله بن خبيب عن أبيه عن يسار بن عبيد الجهني .(@)(@@) 6485 - لا يشكر الله عز وجل من لا يشكر الناس ، والتحدث بنعمة الله شكر وتركها كفر ، والجماعة رحمة ، والفرقة عذاب .(@)(@@) % ( طب ) عن النعمان بن بشير .(@)(@@) 6486 - يقول الله تعالى لعبده يوم القيامة : يا ابن آدم ألم أحملك على الخيل والإبل وأزوجك النساء وأجعلك تربع ( تربع فيها ثلاث لغات من باب الأول الثلاثي المجرد ، ومن باب الثاني ، ومن باب الثالث ، ولها عدة معان والمعنى الموافق هنا أخذ ربع أموال القوم ، والجيش أخذ منهم ربع الغنيمة . انتهى . قاموس . ح ) وترأس ؟ فيقول : بلى أي رب ، فيقول : أين شكر ذلك ؟(@)(@@) % ( هب ) عن أبي هريرة .(@)(@@) 6487 - يقول الله تعالى للعبد يوم القيامة : ألم تدعني لمرض كذا وكذا فعافيتك ؟ ألم تدعني أن أزوجك كريمة قومها فزوجتك ؟ ألم ألم .(@)(@@) % ( هب ) أبو الشيخ عن عبد الله بن سلام .(@)(@@) PageV03P109(@)(@@) 6488 - يقول الله عز وجل ثلاث من النعم لا أسأل عبدي عن شكرها ، وأسأله عما سوى ذلك ، بيت يكنه ، وما يقيم به صلبه من الطعام وما يواري به عورته من اللباس .(@)(@@) % هناد عن الضحاك 
ms896	 مرسلا .(@)(@@) | 1 ( الشفاعة ) 1(@)(@@) 6489 - إشفعوا تؤجروا .(@)(@@) % ابن عساكر عن معاوية .(@)(@@) 6490 - إشفعوا تؤجروا ، وليقض الله على لسان نبيه ما شاء .(@)(@@) % ( ق 3 ) عن أبي موسى .(@)(@@) 6491 - إن الرجل ليسألني الشيء فأمنعه حتى تشفعوا فتؤجروا .(@)(@@) % ( طب ) عن معاوية .(@)(@@) 6492 - أفضل الشفاعة أن تشفع بين اثنين في النكاح .(@)(@@) % ( ه ) عن أبي رهم ( أحزاب بن أسيد ( يفتح الهمزة ويقال بالضم ) قاله البخاري أبو رهم السماعي ويقال السمعي مختلف في صحبته .(@)(@@) وذكره ابن حبان في ثقات التابعين وليست له صحبة وقال البخاري تابعي .(@)(@@) أبو رهم السمعي : بضم الراء بفتح السين والميم وقيل بكسر المهملة .(@)(@@) تهذيب التهذيب ( 1 / 190 ) . ص ) .(@)(@@) 6493 - أفضل الصدقة صدقة اللسان ، الشفاعة تفك بها الأسير ، وتحقن بها الدم ، وتجر المعروف والإحسان إلى أخيك ، وتدفع عنه الكريهة .(@)(@@) % ( طب هب ) عن سمرة .(@)(@@) | 1 ( محظور الشفاعة ) 1(@)(@@) 6494 - يا أسامة أتشفع في حد من حدود الله ؟(@)(@@) % ( ق د ) عن عائشة ( عن عائشة رضي الله عنها أن قريشا أهمتهم شأن المرأة المخزومية التي سرقت فقالوا : من يكلم فيها رسول الله صلى الله عليه وسلم فقالوا : من يجترئ عليه إلا أسامة بن زيد حب رسول الله صلى الله عليه وسلم فكلمه أسامة فقال رسول الله صلى الله عليه وسلم : أتشفع في حد من حدود الله ، ثم قام فاختطب فقال : أيها الناس إنما أهلك الذين قبلكم أنهم كانوا إذا سرق فيهم الشريف تركوه ، وإذا سرق فيهم الضعيف أقاموا عليه الحد وايم والله لو أن فاطمة بنت محمد سرقت لقطعت يدها رواه البخاري في صحيحه كتاب الحدود باب إقامة الحدود على الشريف ( 8 / 199 ) .(@)(@@) ورواه مسلم في صحيحه كتاب الحدود باب قطع السارق الشريف وغيره رقم ( 1688 ) .(@)(@@) والترمذي أبواب الحدود باب ما جاء في كراهية أن يشفع في الحدود وبرقم ( 1430 ) وقال الترمذي حديث حسن صحيح .(@)(@@) وأخرجه النسائي وأبو داود وابن ماجه .(@)(@@) راجع تحفة الأحوذي ( 4 / 697 ) .(@)(@@) وإنما سردت النص بكامله ليتضح فقه الإيجاز وظهور المعنى . ص ) .(@)(@@) | 1 ( الإكمال من محظور الشفاعة ) 1(@)(@@) 6495 - إني أوتي فأسأل 
ms897	 ، وتطلب إلي الحاجة ، وأنتم عندي فاشفعوا تؤجروا ويقضي الله على يدي نبيه ما أحب .(@)(@@) % الخرائطي في مكارم الأخلاق ( حب ) عن أبي موسى .(@)(@@) 6496 - من شفع شفاعة يدفع بها مغرما أو يحي بها مغنما ثبت الله تعالى قدميه حين تدحض الأقدام .(@)(@@) % ( عق ) عن جابر ( شرح الكلمات اللغوية : النهاية في غريب الحديث ( 3 / 363 ) .(@)(@@) - 1 - الغارم : الذي يلتزم ما ضمنه وتكفل به ويؤديه ، والغرم : أداء شيء لازم .(@)(@@) - 2 - الغانم : آخذ الغنيمة والمغنم والغنائم : وهو ما أصيب من أموال أهل الحرب ( 3 / 389 ) .(@)(@@) - 3 - دحض ، الدحض : جمع داحض وهم الذين لا ثبات لهم ولا عزيمة في الأمور . والمراد هنا حين تنزلق الأقدام يثبتها الله يوم القيامة .(@)(@@) النهاية في غريب الحديث ( 2 / 104 ) . ص ) .(@)(@@) 6497 - يا أسامة لا تشفع في حد .(@)(@@) % ابن سعد عن جعفر بن محمد عن أبيه .(@)(@@) | 1 ( حرف الصاد ) 1(@)(@@)(@)(@@) | 1 ( الصبر على البلايا والأمراض والمصائب والشدائد ) 1(@)(@@)(@)(@@) | 1 ( فضيلة الصبر ) 1(@)(@@) 6498 - الصبر نصف الإيمان ، واليقين الإيمان كله .(@)(@@) % ( حل هب ) عن ابن مسعود .(@)(@@) 6499 - الصبر رضا .(@)(@@) % الحكيم وابن عساكر عن أبي موسى .(@)(@@) 6500 - الصبر والإحتساب هن عتق الرقاب ، ويدخل الله صاحبهن الجنة بغير حساب .(@)(@@) % ( طب ) عن الحكم بن عمير الثمالي .(@)(@@) PageV03P110(@)(@@) 6501 - الصبر من الإيمان بمنزلة الرأس من الجسد .(@)(@@) % ( فر ) عن أنس ( حب ) عن علي ( هب ) عن علي موقوفا .(@)(@@) 6502 - ما رزق عبد خيرا له ، ولا أوسع من الصبر .(@)(@@) % ( ك ) عن أبي هريرة .(@)(@@) 6503 - أفضل الإيمان الصبر والسماحة .(@)(@@) % ( فر ) عن معقل بن يسار ( تخ ) عن عمير الليثي .(@)(@@) 6504 - لو كان الصبر رجلا لكان رجلا كريما .(@)(@@) % ( حل ) عن عائشة .(@)(@@) 6505 - نعم سلاح المؤمن الصبر والدعاء .(@)(@@) % ( فر ) عن ابن عباس .(@)(@@) 6506 - النصر مع الصبر ، والفرج مع الكرب ، وأن مع العسر يسرا .(@)(@@) % ( خط ) عن أنس ( أول الحديث : احفظ الله تجده أمامك تعرف إلى الله في الرخاء يعرفك في الشدة . وهذا الحديث رواه عبد بن حميد في مسنده لكن إسناده ضعيف .(@)(@@) وقد رواه أحمد بإسنادين منقطعين ولفظه أتم من حديث عبد بن حميد .(@)(@@) راجع دليل 
ms898	 الفالحين شرح رياض الصالحين ( 1 / 232 ) باب المراقبة . ص ) .(@)(@@) 6507 - انتظار الفرج بالصبر عبادة .(@)(@@) % القضاعي عن ابن عمر وعن ابن عباس .(@)(@@) 6508 - انتظار الفرج من الله عبادة ، ومن رضي بالقليل من الرزق رضي الله تعالى منه بالقليل من العمل .(@)(@@) % ابن أبي الدنيا في الفرج وابن عساكر عن علي .(@)(@@) 6509 - انتظار الفرج عبادة .(@)(@@) % ( عد خط ) عن أنس .(@)(@@) 6510 - إن الصبر عند الصدمة الأولى .(@)(@@) % ( حم ق 4 ) عن أنس .(@)(@@) 6511 - الصبر عند الصدمة الأولى .(@)(@@) % البزار ( ع ) عن أبي هريرة .(@)(@@) 6512 - الصبر عند أول صدمة .(@)(@@) % البزار عن ابن عباس .(@)(@@) 6513 - الصبر عند الصدمة الأولى ، والعبرة ( العبرة : بفتح العين وسكون الباء الدمعة قبل أن تفيض أو تردد البكاء في الصدر أو الحزن بلا بكاء ، والصبابة بفتح الصاد هي الشوق أو رقته أو رقة الهوى انتهى . قاموس ) لا يملكها أحد صبابة المرء إلى أخيه .(@)(@@) % ( ص ) عن الحسن مرسلا .(@)(@@) 6514 - الصابر ، الصابر عند الصدمة الأولى .(@)(@@) % ( تخ ) عن أنس .(@)(@@) 6515 - الصبر ثلاثة : فصبر على المصيبة ، وصبر على الطاعة ، وصبر عن المعصية ، فمن صبر على المصيبة حتى يردها بحسن عزائها كتب الله له ثلثمائة درجة ، ما بين الدرجتين كما بين السماء والأرض ، ومن صبر على الطاعة كتب الله له ستمائة درجة ، ما بين الدرجتين كما بين تخوم الأرض إلى منتهى الأرضين ، ومن صبر عن المعصية كتب الله له تسعمائة درجة ما بين الدرجتين كما بين تخوم الأرض إلى منتهى العرش مرتين .(@)(@@) % ابن أبي الدنيا في الصبر وأبو الشيخ في الثواب عن علي .(@)(@@) 6516 - من ابتلي فصبر ، وأعطي فشكر ، وظلم فغفر ، وظلم فاستغفر ، أولئك لهم الأمن وهم مهتدون .(@)(@@) % ( طب هب ) عن سخبرة ( سخبرة : يقال له صحبة ، روى حديثه أبو داود الأعمى عن عبد الله بن سخبرة وليس بالأزدي عن النبي صلى الله عليه وسلم : من ابتلى فصبر . . .(@)(@@) وروى الترمذي بعضه وهو : من طلب العلم كان كفارة لما مضى وقال ضعيف الإسناد لا يعرف لعبد الله ولا لأبيه كبير شيء قلت جزم به ابن أبي خيثمة وابن حبان وغيرهم .(@)(@@) تهذيب 
ms899	 التهذيب ( 3 / 454 ) .(@)(@@) وسخبرة : بفتح أوله وسكون المعجمة وفتح الموحدة .(@)(@@) وضبط مكررا في النسخة المصرية لسنن الترمذي برقم ( 2648 ) بكسر السين خطأ فصحح نسختك ولكن شرح الترمذي المسمى بتحفة الأحوذي نوه كذلك عن ضبط الكلمة فقال بفتح السين ( 7 / 406 ) . ص ) .(@)(@@) 6517 - اشتدي أزمة تنفرجي .(@)(@@) % القضاعي ( فر ) عن علي ( ذكر العجلوني في كتاب كشف الخفاء برقم ( 366 ) : ' اشتدي أزمة تنفرجي ' قال : رواه العسكري والديلمي والقضاعي عن علي بسند فيه كذاب وهو : ( الحسين بن عبد الله بن ضميرة ) كذبه مالك ، وقال أبو زرعة : ليس بشيء أضرب على حديثه .(@)(@@) وسرده الذهبي في ميزان الاعتدال ( 1 / 538 ) .(@)(@@) فالحديث موضوع ومعناه : ' أبلغي يا شدة في الشدة النهاية حتى تنفرجي '(@)(@@) وقد عمل : أبو الفضل يوسف بن محمد المعروف بابن النحوي لفظ هذا الحديث مطلع قصيدة في الفرج بديعة في معناها . انتهى . ملخصا . ص ) .(@)(@@) PageV03P111(@)(@@) | 1 ( الإكمال من فضيلة الصبر ) 1(@)(@@) 6518 - الصبر الرضا .(@)(@@) % الحكيم وابن عساكر والديلمي عن أبي موسى .(@)(@@) 6519 - النصر مع الصبر ، والفرج مع الكرب ، وأن مع العسر يسرا .(@)(@@) % أبو نعيم والخطيب وابن النجار عن أنس . مر برقم [ 6506 ] .(@)(@@) 6520 - ثلاث من كنوز البر : كتمان الشكوى ، وكتمان المصيبة ، وكتمان الصدقة .(@)(@@) % ( طب ) عن أنس .(@)(@@) 6521 - سلوا الله من فضله ، فإنه يحب أن يسأل ، وإن من أفضل العبادة انتظار الفرج .(@)(@@) % ابن جرير عن حكيم بن جبير عن رجل لم يسم اسمه .(@)(@@) 6522 - من يتصبر يصبره الله ، ومن يستعفف يعفه الله ، ومن يستغن يغنه الله ، وما أعطي عبد عطاء هو خير وأوسع من الصبر .(@)(@@) % الحكيم عن أبي سعيد .(@)(@@) 6523 - من يتصبر يصبره الله ، ومن يستغن يغنه الله عز وجل ومن يسألنا نعطه ، وما أعطي أحد رزقا أوسع من الصبر .(@)(@@) % ( حل ) عن أبي سعد .(@)(@@) 6524 - لا أحد أصبر على أذى يسمعه من الله ، إنه يشرك به ويجعل له ولد وهو يعافيهم ويدفع عنهم ويرزقهم .(@)(@@) % ( حم ) عن أبي موسى .(@)(@@) | 1 ( الصبر على ذهاب البصر ) 1(@)(@@) 6525 - قال الله تعالى : إذا ابتليت عبدي بحبيبتيه يريد عينيه ثم صبر عوضته منهما 
ms900	 الجنة .(@)(@@) % ( حم خ ) عن أنس .(@)(@@) 6526 - لن يبتلى عبد بشيء أشد من الشرك ، ولن يبتلى بشيء بعد الشرك أشد من ذهاب البصر ، ولن يبتلى عبد بذهاب بصره فيصبر إلا غفر الله له .(@)(@@) % البزار عن بريدة .(@)(@@) 6527 - ما أصيب عبد بعد ذهاب دينه بأشد من ذهاب بصره ، وما ذهب بصر عبد فصبر إلا دخل الجنة .(@)(@@) % ( خط ) عن بريدة .(@)(@@) 6528 - إن الله تعالى يقول : إذا أخذت كريمتي عبدي في الدنيا لم يكن له جزاء عندي إلا الجنة .(@)(@@) % ( ت ) عن أنس ( رواه الترمذي في كتاب الزهد باب ما جاء في ذهاب البصر رقم ( 2402 ) وقال هذا حديث حسن غريب . ص ) .(@)(@@) 6529 - من ذهب بصره في الدنيا جعل الله له نورا يوم القيامة إن كان صالحا .(@)(@@) % ( طس ) عن ابن مسعود .(@)(@@) 6530 - عزيز على الله تعالى أن يأخذ كريمتي عبد مسلم ثم يدخله النار .(@)(@@) % ( حم طب ) عن عائشة بنت قدامة .(@)(@@) PageV03P112(@)(@@) 6531 - قال الله تعالى : إذا سلبت من عبدي كريمتيه وهو بهما ضنين لم أرض له بهما ثوابا دون الجنة إذا حمدني عليهما .(@)(@@) % ( طب حل ) عن العرباض .(@)(@@) 6532 - ذهاب البصر مغفرة للذنوب ، وذهاب السمع مغفرة للذنوب ، وما نقص من الجسد فعلى قدر ذلك .(@)(@@) % ( خط عد ) عن ابن مسعود .(@)(@@) 6533 - يقول الله عز وجل : من أذهبت حبيبتيه فصبر واحتسب لم أرض له ثوابا دون الجنة .(@)(@@) % ( ت ) عن أبي هريرة ( رواه الترمذي في كتاب الزهد باب ما جاء في ذهاب البصر ( 2403 ) وقال : هذا حديث حسن صحيح . ص ) .(@)(@@) 6534 - يقول الله تعالى : يا ابن آدم إذا أخذت كريمتيك فصبرت واحتسبت عند الصدمة ( الصدمة الأولى : معناه أن كل مصيبة سوف ينساها ويسلوها صاحبها على مر الزمن ، وإنما يحمد ويؤجر عليها عند جدتها وأول وقوعها . انتهى . من مختار الصحاح بالمعنى . ح ) الأولى لم أرض لك ثوابا دون الجنة .(@)(@@) % ( حم ه ) عن أبي امامة .(@)(@@) | 1 ( الإكمال من الصبر على ذهاب البصر ) 1(@)(@@) 6535 - إن الله تعالى يقول : يا ابن آدم إني أخذت منك كريمتيك فصبرت واحتسبت عند الصدمة الأولى لم أرض 