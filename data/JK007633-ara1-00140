ms121	 سرائرنا % % فيه ويظهر للعاصين ما ستروا % % 10(@)(@@) % فيا له مصدرا ما كان أعظمه % % الناس من هوله سكرى وما سكروا % % PageV01P362 11(@)(@@) % فكن أخي عابرا لا عامرا فلقد % % رأيت مصرع من شادوا ومن عمروا % % 12(@)(@@) % استزلوا بعد عز عن معاقلهم % % كأنهم ما نهوا فيها ولا أمروا % % 13(@)(@@) % تغل أيديهم يوم القيامة إن % % بروا تفك وفي الأغلال إن فجروا % % 14(@)(@@) % ونح على العلم نوح الثاكلات وقل % % والهف نفسي على أهل له قبروا % % 15(@)(@@) % الثابتين على الإيمان جهدهم % % والصادقين فما مانوا ولا خثروا % % 16(@)(@@) % الصادعين بأمر الله لو سخطوا % % أهل البسيطة وما بالوا ولو كثروا % % 17(@)(@@) % والسالكين على نهج الرسول على % % ما قررت محكم الآيات والسور % % 18(@)(@@) % والعادلين عن الدنيا وزهرتها % % والآمرين بخير بعدما ائتمروا % % 19(@)(@@) % لم يجعلوا سلما لمال علمهم % % بل نزهوه فلم يعلق به وخز % % 20(@)(@@) % فحى أهلا بهم أهلا بذكرهم % % الطيبين ثناء أينما ذكروا % % PageV01P363 21(@)(@@) % أشخاصهم تحت أطياف الثرى وهم % % كأنهم بين أهل العلم قد نشروا % % 22(@)(@@) % هذي المكارم لا تزويق أبنية % % ولا الشفوف التي تكس بها الجدر % % 23(@)(@@) % وابك على العلم الغرد الذي حسنت % % بذكر أفعاله الأخبار والسير % % 24(@)(@@) % من لم يبال بحق الله لائمة % % ولا يجابي امرأ في خده صعر % % 25(@)(@@) % بحر من العلم قد فاضت جداوله % % أضحى وقد ضمه في بطنه الدر % % 26(@)(@@) % فليت شعري من للمشكلات إذا % % حارت بغامضها الأفهام والفكر % % 27(@)(@@) % من للمدارس بالتعليم يعمرها % % ينتابها زمر من بعدها زمر % % 28(@)(@@) % هذي رسوم علوم الدين تندبه % % ثكلى عليه ولكن عزها القدر % % 29(@)(@@) % طوتك يا سعد أيام طوت أمما % % كانوا فباتوا وفي الماضي معتبر % % 30(@)(@@) % إن كان شخصك قد واراه ملحده % % فعلمك الجم في الآفاق منتشر % % PageV01P364 31(@)(@@) % والأسوة المصطفى نفسي الفداء له % % بموته يتأسى البدو والحضر % % 32(@)(@@) % بنى لكم حمد يا للعتيق علا % % لم يبنها لكم مال ولا خطر % % 33(@)(@@) % لكنه العلم يسمو من يسود به % % على الجهول ولو من جده مفر % % 34(@)(@@) % والعلم إن كان أقوالا بلا عمل % % فليت صاحبه بالجهل منغمر % % 35(@)(@@) % يا حامل العلم 
ms122	 والقرآن إن لنا % % يوما تضم به الماضون والأخر % % 36(@)(@@) % فيسأل الله كلا عن وظيفته % % فليت شعري بماذا منه تعتذر % % 37(@)(@@) % وما الجواب إذا قال العليم إذا % % قال الرسول أو الصديق أو عمر % % 38(@)(@@) % والكل يأتيه مفلول اليدين فمن % % ناج ومن هالك قد لوحت سقر % % 39(@)(@@) % فجددوا نية لله خالصة % % قوموا أفرادى ومثنى واصبر وامروا % % 40(@)(@@) % وناصحوا وانصحوا من ولي أمركم % % فالصفو لابد يأتي بعده كدر % % PageV01P365 41(@)(@@) % والله يلطف في الدنيا بنا وبكم % % ويوم يشخص من أهواله البصر % % 42(@)(@@) % وصل رب على المختار سيدنا % % شفيعنا يوم نار الكرب تستعر % % 43(@)(@@) % محمد خير مبعوث وشيعته % % وصحبه ما بدا من أفقه قمر % % PageV01P366 البحر : بسيط تام 1(@)(@@) % لمثل ذا الخطب فلتبك العيون دما % % فما يماثله خطب وإن عظما % % 2(@)(@@) % كانت مصائبنا من قبله جللا % % ما لآن جب سنام المجد وانهدما % % 3(@)(@@) % سقر ثرى حله شيخ الهدى سحب % % من واسع العفو يهمي وبلها ديما % % 4(@)(@@) % شيخ مضى طاهر الأخلاق متبعا % % طريقه المصطفى بالله معتصما % % 5(@)(@@) % بحر من العلم فاضت جداوله % % لكنه سائغ من ذوق من طعما % % 6(@)(@@) % تنشق أصدافه من البحث عن درر % % تهدي إلى الحق مفهوما وملتزما % % 7(@)(@@) % فكم قواعد فقه قد أبان وكم % % أشاد رسما من العليا قد انثلما % % 8(@)(@@) % نص إلينا العلا والبر مصرعه % % والعلم والفضل والإحسان والكرما % % 9(@)(@@) % هذي الخصال التي كانت تفضله % % على الرجال فأضحى فيهم علما % % 10(@)(@@) % فليت شعري من للمشكلات إذا % % ما حل منها عويص يبهم الفهما % % PageV01P367 11(@)(@@) % وللعلوم التي تخفى غوامضها % % على الفحول من الأحبار والعلما % % 12(@)(@@) % ومن للأرامل والأيتام إن كلحت % % غبر السنين وأبدت ناجزا خدما % % 13(@)(@@) % لو كنت أملك إذ حانت منيته % % دفعتها عنه لكن حم ما حتما % % 14(@)(@@) % فقل لمن غره من دهره مهل % % فظل يمري بحال الصحة النعما % % 15(@)(@@) % لا تستظل غفوة الأيام أن لها % % وشك انتباه يرى موجودها عدما % % 16(@)(@@) % إن الحياة وإن طال السرور بها % % لابد يلقى الفتى من مسها ألما % % 17(@)(@@) % فخذ لنقلتك الآتي المصير لها % % زادا فما الحق الباقي 
ms123	 بمن قدما % % 18(@)(@@) % لابد من ساعة يبكي عليك بها % % تدري بمن قد بكى أو شق أو لطما % % 19(@)(@@) % أما ترى الشيخ عبد الله كيف مضى % % وكان عقدا نفيسا يفضل القيما % % 20(@)(@@) % عشنا به حقبة في غبطة فأتى % % عليه ما قد أتى عادا أخا أرما % % PageV01P368 21(@)(@@) % وقبله اختلست ساما وإخوته % % أيدي المنون وأفنت بعدهم أمما % % 22(@)(@@) % لهفي عليه ولهف المسلمين معي % % لو أن لهفا من لاهف سدما % % 23(@)(@@) % ولهف مدرسة بالذكر يعمرها % % ومسجد كان فيه ينثر الحكما % % 24(@)(@@) % الله أكبر كم باك وباكية % % وحائر كاظم للقيظ قد وجما % % 25(@)(@@) % وفجعة الدين والدنيا لمصرعه % % وفرحة الناس والإسلام لو سلما % % 26(@)(@@) % لكنه مورد لا بد وارده % % من يعتبط شارخا أو من وهى هرما % % 27(@)(@@) % عمري لقد غرنا من دهرنا خدع % % من حيث لا يعلم المخدوع أو علما % % 28(@)(@@) % يقودنا نحوها التسويق أو طمع % % من مضمحل قليل مغضب ندما % % 29(@)(@@) % والعمر والعيش في الدنيا له مثل % % كالظل أو من يرى في نومه حلما % % 30(@)(@@) % كل يزول سريعا ولا ثبات له % % فكن لوقتك يا مسكين مغتنما % % PageV01P369 31(@)(@@) % ليس البكاء وإن طال العناء به % % بمرجع فائتا أو مطفىء حزما % % 32(@)(@@) % فالله ينزله عفوا ويرحمه % % فإنه جل قدرا أرحم الرحما % % 33(@)(@@) % ثم الصلاة على من في مصيبته % % لنا العزاء إذا ما حادث عظما % % 34(@)(@@) % محمد خير مبعوث وشيعته % % وصحبه ما أضاء البرق مبتسما % % PageV01P370 البحر : طويل 1(@)(@@) % هو الموت ما منه ملاذ ومهرب % % متى حط ذا عن نعشه ذاك يركب % % 2(@)(@@) % نشاهد ذا عين اليقين حقيقة % % عليه مضى طفل وكهل وأشيب % % 3(@)(@@) % ولكن على السران القلوب كأننا % % بما قد علمناه يقينا تكذب % % 4(@)(@@) % نؤمل آمالا ونرجو نتاجها % % وعل الردى مما نرجيه أقرب % % 5(@)(@@) % ونبني القصور المشجرات في الهواء % % وفي علمنا أنا نموت وتخرب % % 6(@)(@@) % ونسعى لجمع المال حلا ومأتما % % وبالرغم يحويه البعيد وأقرب % % 7(@)(@@) % نحاسب عنه داخلا ثم خارجا % % وفيم صرفناه ومن أين يكسب % % 8(@)(@@) % ويسعد فيه وارث متعفف % % تقي ويشقى فيه آخر يلعب % % 9(@)(@@) % وأول ما شيدوا 
ms124	 ندامة مسرف % % إذا اشتد فيه الكرب والروح تجذب % % 10(@)(@@) % ويشفق من وضع الكتاب ويمتن % % لو أن رد للدنيا وهيهات مطلب % % PageV01P371 11(@)(@@) % ويشهد منا كل عضو بفعله % % وليس على الجبار يخفى المغيب % % 12(@)(@@) % إذا قيل أنتم قد علمتم فما الذي % % علمتم وكل في الكتاب مرتب % % 13(@)(@@) % وماذا كسبتم في شباب وصحة % % وفي عمر أنفاسكم فيه تحسب % % 14(@)(@@) % فيا ليت شعري ما تقول وما الذي % % نجيب به والأمر إذ ذاك أصعب % % 15(@)(@@) % إلى الله نشكو قسوة في قلوبنا % % وفي كل يوم واعظا لموت يندب % % 16(@)(@@) % ولله كم غاد حبيب ورائح % % نشيعه للقبر والدمع يسكب % % 17(@)(@@) % أخ أو حميم أو تقي مهذب % % يواصل في نصح الصبا ويدأب % % 18(@)(@@) % نهيل عليه الترب حتى كأنه % % عدو وفي الأحشاء نار تلهب % % 19(@)(@@) % سقى جدشا وأرى ابن أحمد وابل % % من العفو رجاس العشيات صيب % % 20(@)(@@) % وانزله الغفران والفوز والرضى % % يطاف عليه بالرحيق ويشرب % % PageV01P372 21(@)(@@) % فقد كان في صدر المجالس بهجة % % به تحدق الأبصار والقلب يرهب % % 22(@)(@@) % فطورا تراه منذرا ومحذرا % % عواقب ما تجني الذنوب وتجلب % % 23(@)(@@) % وطورا بآلاء الإله مذكرا % % وطورا إلى دار النعيم يرغب % % 24(@)(@@) % ولم يشتغل عن ذا ببيع ولا شرا % % نعم في ابتناء المجد للبذل يطرب % % 25(@)(@@) % فلو كان يفدى بالنفوس وما غلا % % لطبنا نفوسا بالذي كان يطلب % % 26(@)(@@) % ولكن إذا تم المدى نفذ القضا % % وما لامرىء عما قضى الله مهرب % % 27(@)(@@) % أخ كان لي نعم المعين على التقى % % به تنجلي عني الهموم وتذهب % % 28(@)(@@) % فطورا بأخبار الرسول وصحبه % % وطورا بآداب تلذ وتعذب % % 29(@)(@@) % على ذا مضى عمري كذاك وعمره % % صفين لا تجفو ولا نتعب % % 30(@)(@@) % وما الحال إلا مثل ما قال من مضى % % وبالجملة الأمثال للناس تضرب % % PageV01P373 31(@)(@@) % لكل اجتماع من خليلين فرقة % % ولو بينهم قد طاب عيش ومشرب % % 32(@)(@@) % ومن بعد ذا حشر ونشر وموقف % % ويوم به يكسي المذلة مذنب % % 33(@)(@@) % إذا فر كل من أبيه وأمه % % كذا الأم لم تنظر إليه ولا الأب % % 34(@)(@@) % وكم ظالم يندي من العض كفه % % مقالته 
ms125	 يا ويلتي أين أذهب % % 35(@)(@@) % إذا اقتسموا أعماله غرماؤه % % وقيل له هذا بما كنت تكسب % % 36(@)(@@) % وصك له صك إلى النار بعدما % % يحمل من أوزارهم ويعذب % % 37(@)(@@) % وكم قائل واحسرتا ليت أننا % % نرد إلى الدنيا ننيب ونرهب % % 38(@)(@@) % فما نحن في دار المنى غير أننا % % شغفنا بدنيا تضمحل وتذهب % % 39(@)(@@) % فحثوا مطايا الإرتحال وشمروا % % إلى الله والدار التي ليس تخرب % % 40(@)(@@) % فما اقرب الاتى وأبعد ما مضى % % وهذا غراب البين في الدار ينصب % % PageV01P374 41(@)(@@) % وصل إلهي ما همي الورق أو شدا % % على الأيك سجاع الحمام المطرب % % 42(@)(@@) % على سيد السادات والآل كلهم % % وأصحابه ما لاح في الأفق كوكب % % PageV01P375 
