ms137	 حبيب يكنى أبا صالح عن مقاتل بن سهر(@)(@@)(@@)(@@) $ 3169 - (@)(@@) الدوانيقي(@)(@@) أبو جعفر المنصور الخليفة(@)(@@)(@@)(@@) $ 3170 - (@)(@@) ولقب بها(@)(@@) محمد بن علي بن الحسن المزكي(@)(@@)(@@)(@@) $ 3171 - (@)(@@) الدورقي(@)PageV00P000(@)(@@) أحمد ويعقوب ابناء إبراهيم نسبا إلى بيع القلانس الدورقية وهما بغداديان وغلط من زعم أنهما منسوبان إلى دورق مكان من خوزستان نبه على ذلك ابن طاهر(@)(@@)(@@)(@@) || - الراء(@)(@@)(@@)(@@) $ 3172 - (@)(@@) الرواسبي(@)(@@) أبو هلال محمد بن سليم البصري نزل في بني راسب(@)(@@)(@@)(@@) $ 3173 - (@)(@@) الرواسي(@)(@@) أحمد بن إسماعيل البغدادي كان كبير الرأس(@)PageV00P000(@)(@@)(@@)(@@) $ 3174 - (@)(@@) الرشيدي محمد بن محمود كان محظوظا في أموره فلقب بذلك(@)(@@)(@@)(@@) $ 3175 - (@)(@@) الرملي(@)(@@) يحيى بن عيسى الكوفي نزل الرملة فحدث بها فنسب إليها(@)(@@)(@@)(@@) $ 3176 - (@)(@@) الرقاعي(@)(@@) عبد الملك بن مهران الموصلي كان يلبس الرقاع زهدا فنسب إليها(@)(@@)(@@)(@@) $ 3177 - (@)(@@) الروحي(@)(@@) عبد الله بن محمد بن سنان البصري الحافظ نسب إلى روح ابن القاسم(@)(@@)(@@)(@@) $ 3178 - (@)(@@) الرياضي(@)(@@) إبراهيم بن أحمد الشيباني كان يلزم الرياض فنسب إليها(@)PageV00P000(@)(@@)(@@)(@@) || (@)(@@)(@@)(@@) $ 3179 - (@)(@@) الزجاجي(@)(@@) عبد الرحمن بن إسحاق النهاوندي صحب أبا إسحاق الزجاج فنسب إليه(@)(@@)(@@)(@@) $ 3180 - (@)(@@) الزنجي(@)(@@) مسلم بن خالد المكي الفقيه لقب بذلك لسواده وقيل لبياضه على العكس(@)(@@)(@@)(@@) $ 3181 - (@)(@@) الزيدي(@)(@@) حامد بن أحمد بن محمد المروزي أبو أحمد الحافظ جمع حديث زيد بن أبي أنيسة(@)(@@)(@@)(@@) $ 3182 - (@)(@@) الزقوي بنان بفتح الموحدة وتشديد النون ابن يعقوب(@)PageV00P000(@)(@@) النحوي الكندي(@)(@@)(@@)(@@) $ 3183 - (@)(@@) الزهري(@)(@@) محمد بن يحيى الذهلي جمع حديث الزهري(@)(@@)(@@)(@@) || - السين(@)(@@)(@@)(@@) $ 3184 - (@)(@@) السبتي(@)(@@) هو أحمد بن الخليفة هارون الرشيد بن المهدي العباسي كان يقال له السبتي لأنه كان ينقطع للعبادة يوم السبت(@)(@@)(@@)(@@) $ 3185 - (@)(@@) السدي(@)(@@) إسماعيل بن عبد الرحمن البصري(@)(@@)(@@)(@@) $ 3186 - (@)(@@) السبيعي(@)PageV00P000(@)(@@) أبو إسحاق عمرو بن عبد الله الهمداني نزل في السبيع(@)(@@)(@@)(@@) $ 3187 - (@)(@@) السحيمي(@)(@@) أحمد بن محمد قاضي همذان عن علي بن عبد العزيز(@)(@@)(@@)(@@) $ 3188 - (@)(@@) السكري(@)(@@) أبو حمزة محمد بن ميمون المروزي قيل له ذلك لحلاوة كلامه(@)(@@)(@@)(@@) $ 3189 - (@)(@@) السندي(@)(@@) سهل بن عبدويه واسم عبدويه عبد الرحمن الرازي(@)(@@)(@@)(@@) $ 3190 - (@)(@@) السني(@)(@@) هشام بن عبيد الله الرازي مشهور(@)PageV00P000(@)(@@)(@@)(@@) $ 3191 - (@)(@@) وجعفر بن أحمد بن يوسف أبو محمد عن أحمد بن بديل ذكرهما ابن منده(@)(@@)(@@)(@@) $ 3192 - (@)(@@) السويدي 
ms138	(@)(@@) محمد بن النوشجان رحل إلى سويد بن عبد العزيز(@)(@@)(@@)(@@) || الشين(@)(@@)(@@)(@@) $ 3193 - (@)(@@) الشاذكوني(@)(@@) سليمان بن داود البصري نسب إلى بيع المضربات(@)(@@)(@@)(@@) $ 3194 - (@)(@@) الشقري بفتحتين(@)(@@) إسحاق بن حاتم بن بنان المدائني(@)(@@)(@@)(@@) $ 3195 - (@)(@@) الشعراني(@)(@@) الفضل بن محمد كان يرسل شعره(@)(@@)(@@)(@@) $ 3196 - (@)(@@) وعبد الله بن أحمد بن جعفر الشيباني ذكرهما الحاكم(@)PageV00P000(@)(@@)(@@)(@@) $ 3197 - (@)(@@) الشيني(@)(@@) هو إدريس بن بسام العبدري من شعراء الأندلس في المائة الخامسة لقب باسم المركب(@)(@@)(@@)(@@) || - الصاد(@)(@@)(@@)(@@) $ 3198 - (@)(@@) الصيرفي علي بن بندار الصوفي الزاهد(@)(@@)(@@)(@@) $ 3199 - (@)(@@) الصيني(@)(@@) إبراهيم بن إسحاق الكوفي عن مالك وطبقته ذكره ابن منده(@)(@@)(@@)(@@) || - الضاد(@)(@@)(@@)(@@) $ 3200 - (@)(@@) الضبعي(@)PageV00P000(@)(@@) جعفر بن سليمان الحرشي نزل في بني ضبيعة(@)(@@)(@@)(@@) || - الطاء(@)(@@)(@@)(@@) $ 3201 - (@)(@@) الطاهري(@)(@@) أحمد بن الحسن بن عزون الهمداني يكنى أبا عمرو عن علي بن حرب(@)(@@)(@@)(@@) $ 3202 - (@)(@@) الطبري(@)(@@) هو أبو الحسن علي بن الحسين بن سلم المقرىء الكوفي كان يلقب الطبري(@)(@@)(@@)(@@) $ 3203 - (@)(@@) الطرائفي(@)(@@) عثمان بن عبد الرحمن الحراني كان يأتي بالطرف في حديثه(@)(@@)(@@)(@@) $ 3204 - (@)(@@) الطهماني(@)(@@) محمد بن حموية بن عباد جمع حديث إبراهيم بن طهمان(@)(@@)(@@)(@@) $ 3205 - (@)(@@) الطوسي(@)(@@) لقب أحمد بن عبد الكريم القومسي يكنى أبا عبد الله عن يحيى ابن يحي ذكره ابن منده(@)PageV00P000(@)(@@)(@@)(@@) || - العين(@)(@@)(@@)(@@) $ 3206 - (@)(@@) عبسي بفتح العين والموحدة ثم مهملة وبعدها ياء ثقيلة بلفظ النسبة اسمه(@)(@@) عيسى كاسم المسيح كان من جلساء أحمد بن حنبل ضبطه عبد الغني بن سعيد(@)(@@)(@@)(@@) $ 3207 - (@)(@@) العشاري(@)(@@) أبو طالب محمد بن علي بن الفتح بن محمد بن علي الحربي البغدادي كان جده الفتح طويلا جدا فلقب بذلك(@)(@@)(@@)(@@) $ 3208 - (@)(@@) العجلي(@)(@@) محمد بن مروان(@)(@@)(@@)(@@) $ 3209 - (@)(@@) العدني(@)(@@) عبد الله بن الوليد المكي قيل له العدني(@)(@@)(@@)(@@) $ 3210 - (@)(@@) العرجي بسكون الراء(@)PageV00P000(@)(@@) عبد الله بن عمر بن عمرو بن عثمان بن عفان الشاعر الذي قيل له العرجي لنزوله العرج وهو موضع بالطائف(@)(@@)(@@)(@@) $ 3211 - (@)(@@) العرزمي(@)(@@) عبد الملك بن أبي سليمان نزل فيهم(@)(@@)(@@)(@@) $ 3212 - (@)(@@) العريني(@)(@@) أحمد بن هلال الحربي(@)(@@)(@@)(@@) $ 3213 - (@)(@@) العطار(@)(@@) هو عبد الله بن همام السلولي الشاعر في دولة أبي سفيان قال المرزباني لقب بذلك لحسن شعره(@)(@@)(@@)(@@) $ 3214 - (@)(@@) العكي(@)(@@) محمد بن عبيد المرزوي شيخ لأبي سعيد 
ms139	 بن الأعرابي(@)PageV00P000(@)(@@)(@@)(@@) $ 3215 - (@)(@@) العماني الراجز(@)(@@) محمد بن ذؤيب البصري لقبه بذلك دكين الراجز لأنه كان ذميما مطحولا وهي صفة أهل عمان وقيل أفاق من علة فرآه رجل فقال كأنه جمل عماني وجمال عمان تحمل الورس فتصفر(@)(@@)(@@)(@@) $ 3216 - (@)(@@) العمي(@)(@@) زيد بن أبي الحواري كان يقول في كل شيء حتى أسأل عمي(@)(@@)(@@)(@@) $ 3217 - (@)(@@) العوفي(@)(@@) عبد الرحمن بن أحمد المطرز(@)(@@)(@@)(@@) $ 3218 - (@)(@@) العوفني(@)(@@) عبد الله بن بكير النخعي نزل في بني عون(@)(@@)(@@)(@@) || (@)(@@)(@@)(@@) $ 3219 - (@)(@@) الغريبي الحسين بن عبد الرحمن الكوفي يكنى أبا علي قال المرزباني غلب عليه طلب الغريب فنسب إليه(@)PageV00P000(@)(@@)(@@)(@@) || - الفاء(@)(@@)(@@)(@@) $ 3220 - (@)(@@) الفاتني(@)(@@) أحمد بن إبراهيم القصار أصبهاني ذكره أبو نعيم(@)(@@)(@@)(@@) $ 3221 - (@)(@@) الفقطرسي ويقال(@)(@@) الفقرطسي معاوية بن عبد الرحمن(@)(@@)(@@)(@@) $ 3222 - (@)(@@) الفصيحي(@)(@@) علي بن محمد بن علي الإستراباذي النحوي(@)(@@)(@@)(@@) $ 3223 - (@)(@@) الفلكي(@)(@@) هو أبو بكر أحمد بن الحسن بن القاسم بن الحسن بن علي كان عالما بالأدب والحساب فلقب الفلكي ذكره ياقوت عن شيرويه وقال مات سنة أربع وثمانين وثلاثمائة وهو جد الحافظ أبي الفضل بن الفلكي الهمذاني(@)(@@)(@@)(@@) || - القاف(@)(@@)(@@)(@@) $ 3224 - (@)(@@) القباني(@)PageV00P000(@)(@@) حسين بن محمد بن زياد النيسابوري لقب بذلك لقلة كلامه(@)(@@)(@@)(@@) $ 3225 - (@)(@@) القبي(@)(@@) محمد بن مفرح المعافري(@)(@@)(@@)(@@) $ 3226 - (@)(@@) القدسي(@)(@@) محمد بن محمد الصوفي(@)(@@)(@@)(@@) $ 3227 - (@)(@@) وأحمد بن إبراهيم الزعفراني(@)(@@)(@@)(@@) $ 3228 - (@)(@@) القبطي(@)(@@) عبد الملك بن عمير كان له فرس يقال له القبطي فلقب به(@)(@@)(@@)(@@) $ 3229 - (@)(@@) القرنجلي أحمد بن يعقوب الأنباري(@)(@@)(@@)(@@) $ 3230 - (@)(@@) القرمطي(@)(@@) عامر بن ربيعة العدوي قال الطبراني رآه النبي صلى الله عليه وسلم يمشي فقال إنه ليقرمط في مشيته فلقب بذلك(@)PageV00P000(@)(@@)(@@)(@@) $ 3231 - (@)(@@) القصري(@)(@@) عبد الجليل بن موسى(@)(@@)(@@)(@@) $ 3232 - (@)(@@) القرطبي(@)(@@) صاحب شعب الإيمان نزل قصر بني بني كنانة ومات سنة ثمان وستمائة(@)(@@)(@@)(@@) $ 3233 - (@)(@@) قطامي الشاعر عمرو ويقال عمير بن شييم التغلبي قال أبو الفرج الأصبهاني القطامي لقبه(@)(@@)(@@)(@@) $ 3234 - (@)(@@) القلوري(@)(@@) أبو العباس أحمد وقيل لقب عمرو(@)(@@)(@@)(@@) || (@)(@@)(@@)(@@) $ 3235 - (@)(@@) الكابلي(@)(@@) محمد بن الحسين قال أبو القاسم بن منده لقبه الكابلي(@)(@@)(@@)(@@) $ 3236 - (@)(@@) الكتباني(@)(@@) محدث من أهل بخارى اسمه محمد بن محمد بن عتبة بن السكن الأسدي يكنى أبا الفضل وهو من أهل 
ms140	 بخارى روى عن عبيد الله بن موسى وطبقته وعنه سهل بن شاذويه وغيره قال ابن ماكولا كان يلقب الكتباني(@)PageV00P000(@)(@@) ا ا(@)(@@)(@@)(@@) $ 3237 لكزبراني(@)(@@) أحمد بن عبد الرحمن الحراني عن مسكين بن بكير وغيره(@)(@@)(@@)(@@) $ 3238 - (@)(@@) الكراكيسي(@)(@@) علي بن عيسى(@)(@@)(@@)(@@) $ 3239 - (@)(@@) الكسائي(@)(@@) علي بن حمزة المقرىء المشهور أبو الحسن الكوفي النحوي الإمام(@)(@@) ولقب به جماعة منهم(@)(@@)(@@)(@@) $ 3240 - (@)(@@) زهير الفرقوبي النحوي(@)(@@)(@@)(@@) $ 3241 - (@)(@@) وأبو الحسن علي بن الحسن التميمي الكوفي ذكرهما الداني(@)(@@)(@@)(@@) $ 3242 - (@)(@@) وآخر له تصنيف في قصص الأنبياء لا يحضرني اسمه(@)PageV00P000(@)(@@)(@@)(@@) $ 3243 - (@)(@@) ومن القراء المجودين محمد بن يحيى(@)(@@)(@@)(@@) $ 3244 - (@)(@@) ومحمد بن أحمد بن الحسن بن عمر الأصبهاني من طبقة ابن مجاهد(@)(@@)(@@)(@@) $ 3245 - (@)(@@) الكشي(@)(@@) محمد بن يوسف الجرجاني لم يكن من كش وإنما كان يلقب بها(@)(@@)(@@)(@@) $ 3246 - (@)(@@) الكلنكي(@)(@@) أحمد بن الحسين الأنصاري يكنى أبا جعفر(@)(@@)(@@)(@@) || - اللام(@)(@@)(@@)(@@) $ 3247 - (@)(@@) اللبني(@)(@@) بفتح اللام والموحدة ثم نون أبو المكارم عرفة بن علي البندنيجي قيل له ذلك لأنه كان يجتزىء باللبن عن الخبز وكان على رأس الستمائة(@)(@@)(@@)(@@) $ 3248 - (@)(@@) الليفي بكسر اللام(@)(@@) هو محمد بن العباس المؤدب كان يلقب لحية الليف فنسب إليها فقيل له الليفي(@)PageV00P000(@)(@@)(@@)(@@) || - الميم(@)(@@)(@@)(@@) $ 3249 - (@)(@@) المتنبيء الشاعر(@)(@@) أحمد بن الحسين بن الحسن الكندي يكنى أبا الطيب(@)(@@)(@@)(@@) $ 3250 - (@)(@@) الماندائي(@)(@@) أبو الفتح محمد بن أحمد بن بختيار القاضي الواسطي مات سنة خمس وستمائة(@)(@@)(@@)(@@) $ 3251 - (@)(@@) المسعري(@)(@@) محمد بن وهب صاحب أبي عبيدة قيل له ذلك لأنه كن يحرك المسائل والمسعر هو العود الذي تحرك به النار(@)(@@)(@@)(@@) $ 3252 - (@)(@@) المسندي بفتح النون(@)(@@) عبد الله بن محمد الجعفي شيخ البخاري(@)(@@)(@@)(@@) $ 3253 - (@)(@@) المسكي(@)(@@) هو علي بن أحمد بن محمد بن زياد الطرسوسي(@)(@@)(@@)(@@) $ 3254 - (@)(@@) المعمري(@)(@@) محمد بن حميد أبو سفيان البصري رحل إلى معمر فعرف به(@)PageV00P000(@)(@@)(@@)(@@) $ 3255 - (@)(@@) المغربي(@)(@@) محمد بن يوسف بن بحر بن بهرام المصري جد أبي القاسم الوزير أصله فارسي وكان إليه نظر ديوان المغرب فقيل له المغربي(@)(@@)(@@)(@@) $ 3256 - (@)(@@) المقابري(@)(@@) يحي بن أيوب كان ينزل المقابر(@)(@@)(@@)(@@) $ 3257 - (@)(@@) المقبري(@)(@@) أبو سعيد كيسان وابنه سعيد(@)(@@)(@@)(@@) $ 3258 - (@)(@@) وعبد الله بن سعيد نزل أبو سعيد المقبرة فنسب 