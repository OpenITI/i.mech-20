ms6641	 ) . )(@)(@@)(@@)(@@) $ 14013 عن الحسن ، عن جابر بن عبد الله رضي الله عنه قال :(@)(@@) | 30 ( الإيمان : الصبر والسماحة ، الصبر عن محارم الله ، وأداء فرائض الله ) . ( هب ) . )(@)(@@)(@@)(@@) $ 14014 عن جابر بن عبد الله رضي الله عنه قال :(@)(@@) | 30 ( جاء رجل إلاى النبي فقال : يا رسول الله ما الموجبات ؟ قال : من مات لا يشرك بالله شيئا دخل الجنة ، ومن مات يشرك بالله شيئا دخل النار ) . ( الديلمي ) . )(@)(@@)(@@)(@@) $ 14015 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( إنما كانت بيعة الشجرة في عثمان بن عفان رضي الله عنه خاصة ، قال رسول الله : إن قتلوه لانابذهم ، فبايعناه ، ولم نبايعه علاى الموت ، ولاكن بايعناه علاى أن لا نفر ونحن ألف وثلاثمائة ) . ( عق ، كر ) . )(@)(@@)(@@)(@@) $ 14016 عن عمرو بن دينار قال :(@)(@@) | 30 ( رأيت جابر بن عبد الله رضي الله عنه وبيده السيف والمصحف وهو يقول : أمرنا رسول الله ن نضرب بهاذا من خالف ما في هاذا ) . ( كر ) . )(@)(@@)(@@)(@@) $ 14017 عن جابر بن عبد الله ، عن الزبير رضي الله عنه قال :(@)(@@) | 30 ( سألت جابرا عن الورود ؟ قال جابر : سمعت رسول الله يقول : يتجلى لهم ضاحكا ) . ( ت ، ط في الصفات ) . )(@)(@@)(@@)(@@) $ 14018 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( كان رسول الله يكثر أن يقول : PageV19P184 يا مقلب القلوب ثبت قلبي علاى دينك ، فقال له بعض أهله : يا رسول الله أتخاف علينا وقد آمنا بك وبما جئت به ؟ فقال : إن القلب بين أصبعين من أصابع الرحمان يقول بهما ، وحرك أصبعيه ) . ( قط ، كر في الصفات ) . )(@)(@@)(@@)(@@) $ 14019 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( كنا مع رسول الله ، فكسع رجل من المهاجرين رجلا من الأنصار ، فقال الأنصاري : يا للاءنصار وقال المهاجر : يا للمهاجرين فسمع رسول الله فقال : ما بال دعواى الجاهلية ؟ فأخبروه بالذي كان ، فقال النبي : دعوها فإنها منتنة ، وكان المهاجرون لما قدم رسول الله أقل من الأنصار ، ثم إن المهاجرين كثروا بعد ، فسمع ذالك عبد الله بن أبي فقال : أقد فعلوها ؟ لئن رجعنا إلاى المدينة ليخرجن الأعز منها الأذل ، فقال عمر رضي الله عنه : دعني يا رسول 
ms6642	 الله أضرب عنق هاذا المنافق ، فقال : دعه ، لا يتحدث الناس أن محمدا يقتل أصحابه ) . ( عب ) . )(@)(@@)(@@)(@@) $ 14020 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( خرج علينا رسول الله ونحن نقرأ القرآن ، وفينا العجمي والأعرابي ، فاستمع فقال : اقرءوا ، فكل حسن ، سيأتي قوم يقيمونه كما يقيم القداح ، يتعجلونه ولا يتأجلونه ) . ( ابن النجار ) . )(@)(@@)(@@)(@@) $ 14021 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( قرأ رسول الله : { الرحمان } حتى ختمها ، فقال : ما لي أراكم سكوتا ، للجن كانوا أحسن ردا منكم ، ما قرأت عليهم هاذه الآية من مرة : { فبأي آلاء ربكما تكذبان } إلا قالوا : ولا بشيء من نعمك ربنا نكذب فلك الحمد ) . ( الحسن بن سفيان ) . )(@)(@@) PageV19P185(@)(@@)(@@)(@@) $ 14022 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( أقبلت عير بتجارة يوم جمعة ، ورسول الله يخطب ، فانصرف الناس ينظرون ، وبقي رسول الله في اثني عشر رجلا ، فنزلت هاذه الآية : { وإذا رأوا تجارة أو لهوا انفضوا إليها وتركوك قائما } ) . ( ش ) . )(@)(@@)(@@)(@@) $ 14023 عن جابر بن عبد الله رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : اللهم أعني علاى ديني بدنياي ، وعلاى آخرتي بتقواي ، اللهم أوسع علي من الدنيا ، وزهدني فيها ، ولا تزوها عني ، وأقر عيني فيها ، اللهم إنك سألتني من نفسي ما لا أملك إلا بك ، فأعطني منها ما يرضيك منها ، اللهم أنت ثقتي حين ينقطع رجائي ، وحين يسوء ظني بنفسي ، اللهم لا تخيب طمعي ، ولا تحقق حذري ، اللهم إن عزيمتك عزيمة لا ترد ، وقولك قول لا يكذب ، فأمر طاعتك فلتحل في كل شيء مني أبدا ما بقيت ، وأمر معاصيك فلتخرج من كل شيء مني ، ثم حرم عليها الدخول في كل شيء مني أبدا ما أبقيتني يا أرحم الراحمين ) . ( طب في الدعاء ، والديلمي ، وفيه عبد الرحمان بن إبراهيم المدني ، قال ن : ليس بالقوي ) . )(@)(@@)(@@)(@@) $ 14024 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( دخلت علاى رسول الله فقال : ياجبير هاؤلاء الأعنز الإحداى عشرة في الدار أحب إليك من كلمات علمنيهن جبريل آنفا تجمع لك خير الدنيا والآخرة ؟ قلت : يا رسول الله والله إني محتاج ، وهاؤلاء الكلمات أحب 
ms6643	 إلي ، قال قل : اللهم أنت الخلاق العظيم ، اللهم إنك سميع عليم ، اللهم إنك غفور رحيم ، اللهم إنك رب العرش العظيم ، اللهم إنك أنت الجواد الكريم ، فاغفر لي وارحمني ، وعافني وارزقني ، واسترني واجبرني وارفعني ، واهدني ولا تضلني ، وأدخلني الجنة برحمتك يا أرحم PageV19P186 الراحمين ، تعلمهن ، وعلمهن عقبك من بعدك ) . ( الديلمي ) . )(@)(@@)(@@)(@@) $ 14025 عن جابر بن عبد الله رضي الله عنه قال :(@)(@@) | 30 ( قيل : يا رسول الله أي الأعمال أفضل ؟ قال : الصبر والسماحة ، قيل : فأي المؤمنين أكمل إيمانا ؟ قال : أحسنهم خلقا ) . ( ش ) . )(@)(@@)(@@)(@@) $ 14026 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : أحبكم وأقربكم مني مجلسا في الجنة أحاسنكم أخلاقا ، وأبغضكم إلي الثرثارون المتشدقون المتفيهقون قال : المتكبرون ) . ( كر ) . )(@)(@@)(@@)(@@) $ 14027 عن محمود بن لبيد ، عن جابر بن عبد الله رضي الله عنه قال :(@)(@@) | 30 ( سمعت رسول الله يقول : من مات له ثلاثة من الولد ، فاحتسبهم دخل الجنة ، قلت : يا رسول الله واثنان ؟ قال : واثنان ، قال محمود : فقلت لجابر بن عبد الله : والله إني لاءراكم لو قلتم واحدا ، لقال : واحدا ، قال : أنا والله أظن ذالك ) . ( هب ) . )(@)(@@)(@@)(@@) $ 14028 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : لرجل من ثقيف : يا أخا ثقيف ما المروءة فيكم ؟ قال : يا رسول الله الإنصاف والإصلاح ، قال : وكذالك هي فينا ) . ( ابن النجار ) . )(@)(@@)(@@)(@@) $ 14029 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( لما كان يوم الأحزاب وردهم الله بغيظهم لم ينالوا خيرا ، قال رسول الله : من يحمي أعراض المؤمنين ؟ قال كعب : أنا يا رسول الله فقال : إنك تحسن الشعر ؟ فقال حسان بن ثابت رضي الله عنه : أنا يا رسول الله قال : نعم ، اهجهم أنت فسيعينك روح القدس ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 14030 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( كنت أمشي مع النبي فارتفعت ريح جيفة ، فقال : هاذه ريح الذين يغتابون المؤمنين ) . ( ابن النجار ) . )(@)(@@) PageV19P187(@)(@@)(@@)(@@) $ 14031 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( لا ألوم أحدا ينتمي عند خصلتين : عند إجرائه فرسه ، وعند قتاله ، وذالك أني رأيت رسول الله أجراى فرسه فسبق ، فقال : إنه 
ms6644	 لبحر ، ورأيته يوما يضرب بسيف في سبيل الله ، فقال : خذها وأنا ابن العواتك انتماى إلاى جداته من سليم ) . ( كر ) . )(@)(@@)(@@)(@@) $ 14032 عن جابر رضي الله عنه :(@)(@@) | 30 ( أنه سئل عن الرجل يكون له الدين ، أفيبتاع به عبدا ؟ قال : لا بأس به ) . ( عب ) . )(@)(@@)(@@)(@@) $ 14033 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( نهاى النبي عن بيع الثمرة حتى يبدو صلاحها ) . ( ش ) . )(@)(@@)(@@)(@@) $ 14034 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( قضاني رسول الله وزادني ) . ( عب ) . )(@)(@@)(@@)(@@) $ 14035 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( سمعت رسول الله عام الفتح يقول : إن الله ورسوله حرم بيع الخمر والخنازير والميتة ، والأصنام ، فقال رجل : يا رسول الله ما تراى في شحوم الميتة ، فإنه يدهن به السفن والجلود ؟ ويستصبح بها ؟ فقال : قاتل الله اليهود ، إن الله تعالاى لما حرم عليهم شحومها ، أخذوها فجملوها ، ثم باعوها وأكلوا أثمانها ) . ( ش ، خ ، م ، د ، ت ، ن ، ه ) . )(@)(@@)(@@)(@@) $ 14036 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( لعن رسول الله آكل الربا ، ومؤكله ، وشاهديه ، وكاتبه ، وقال : هم سواء ) . ( ابن جرير ، كر ، وابن النجار ) . )(@)(@@)(@@)(@@) $ 14037 عن جابر رضي الله عنه :(@)(@@) | 30 ( أن النبي لم يصل علاى قتلاى أحد ، ولم يغسلوا ) . ( ش ) . )(@)(@@)(@@)(@@) $ 14038 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( كان النبي يجمع بين الرجلين PageV19P188 من قتلاى أحد في قبر واحد ، وأمر بدفنهم بدمائهم ولم يصل عليهم ، ولم يغسلوا ) . ( ش ) . )(@)(@@)(@@)(@@) $ 14039 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( قدم علاى النبي قوم غزاة ، فقال : قدمتم خير مقدم ، قدمتم من الجهاد الأصغر إلاى الجهاد الأكبر : مجاهدة العبد هواه ) . ( الديلمي ) . )(@)(@@)(@@)(@@) $ 14040 عن جابر رضي الله عنه :(@)(@@) | 30 ( أن النبي كان يجمع بين الرجلين من قتلاى أحد في الثوب الواحد ثم يقول : أيهم أكثر أخذا للقرآن ؟ فإذا أشير إلاى أحدهما قدمه في اللحد ، وقال : أنا شهيد علاى هاؤلاء يوم القيامة ، وأمر بدفنهم بدمائهم ، ولم يصل عليهم ، ولم يغسلوا ) . ( ش ) . )(@)(@@)(@@)(@@) $ 14041 عن جابر رضي الله عنه :(@)(@@) | 30 ( أن النبي أمر بالقتلاى يوم أحد فزملوا بدمائهم ، وأن يقدم أكثرهم قرآنا أخذا 
ms6645	 للقرآن ، وأن يدفن اثنان في قبر ، قال : فدفنت أبي وعمي في قبر ) . ( ش ) . )(@)(@@)(@@)(@@) $ 14042 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( قتل أبي وخالي يوم أحد ، فحملتهما علاى بعير ، فأتيت بهما المدينة ، فناداى منادي رسول الله : ردوا القتلاى إلاى مصارعهم ) . ( ابن النجار ) . )(@)(@@)(@@)(@@) $ 14043 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( أهل النبي بحج ليس معه عمرة ) . ( كر ) . )(@)(@@)(@@)(@@) $ 14044 عن جابر رضي الله عنه :(@)(@@) | 30 ( أن النبي استلم الحجر فقبله ، واستلم الركن اليماني فقبل يده ) . ( كر ) . )(@)(@@)(@@)(@@) $ 14045 عن جابر رضي الله عنه :(@)(@@) | 30 ( أن النبي رمل من الحجر إلاى الحجر ) . ( كر ) . )(@)(@@) PageV19P189(@)(@@)(@@)(@@) $ 14046 عن جابر رضي الله عنه :(@)(@@) | 30 ( أن رسول الله رماى الجمرة يوم النحر ، ثم قعد للناس فقال : كل عرفة موقف ، وكل مزدلفة موقف ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 14047 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( الإفاضة من عرفة بعد غروب الشمس ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 14048 عن أبي الزبير ، عن جابر رضي الله عنه :(@)(@@) | 30 ( أن النبي لما أفاض من عرفة جعل يقول : السكينة عباد الله ، ويقول بيده هاكذا ، وأشار ببطن كفه إلاى الأرض ) . ( . . . ) . )(@)(@@)(@@)(@@) $ 14049 عن أبي الزبير ، عن جابر رضي الله عنه قال :(@)(@@) | 30 ( أفاض رسول الله من جمع وعليه السكينة ، وأمرهم بالسكينة ، وأوضع في وادي محسر ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 14050 عن أبي الزبير ، عن جابر رضي الله عنه قال :(@)(@@) | 30 ( أفاض النبي كافا بعيره ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 14051 عن عطاء ، عن جابر رضي الله عنه :(@)(@@) | 30 ( أن النبي قال حيث أفاض من عرفات : يا أيها الناس عليكم بالسكينة والوقار ، ولا يقتل بعضكم بعضا ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 14052 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( صلى رسول الله بالمزدلفة المغرب والعشاء بنداء واحد وإقامتين ، ولم يصل بينهما شيئا ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 14053 عن جابر رضي الله عنه :(@)(@@) | 30 ( أن رجلا قال : يا رسول الله ذبحت PageV19P190 قبل أن أرمي ؟ قال : ارم ولا حرج ، وقال آخر : يا رسول الله طفت بالبيت قبل أن أذبح ؟ قال : اذبح ولا حرج ، قال آخر : حلقت قبل أن أذبح ؟ قال : اذبح ولا حرج 
ms6646	 ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 14054 عن جابر رضي الله عنه :(@)(@@) | 30 ( أن النبي ضحى بكبشين يوم النحر ) . ( ن ) . )(@)(@@)(@@)(@@) $ 14055 عن جابر رضي الله عنه :(@)(@@) | 30 ( أن النبي نحر هديه بيده ، ونحر بعضه غيره ) . ( ابن النجار ) . )(@)(@@)(@@)(@@) $ 14056 عن جابر بن عبد الله رضي الله عنه قال :(@)(@@) | 30 ( قال رجل : يا رسول الله حلقت قبل أن أنحر ؟ قال : لا حرج ) . ( ش ) . )(@)(@@)(@@)(@@) $ 14057 عن جابر رضي الله عنه :(@)(@@) | 30 ( أن رسول الله رماى الجمرة يوم النحر ، ثم قعد للناس ، فجاءه رجل فقال : يا رسول الله إني حلقت قبل أن أنحر ؟ قال : لا حرج ، ثم جاء آخر فقال : حلقت قبل أن أرمي ؟ قال : لا حرج ، فما سئل عن شيء ؟ إلا قال : لا حرج ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 14058 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( بينما النبي مع أصحابه إذ شق قميصه حتى خرج منه ، فقيل له ، فقال : إني واعدتهم أن يقلدوا هديي اليوم فنسينا ) . ( ابن النجار ) . )(@)(@@)(@@)(@@) $ 14059 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( اطلعت امرأة من هودج لها ومعها صبهي ، فقالت : يا رسول الله ألهاذا حج ؟ قال : نعم ولك أجر ) . ( كر ) . )(@)(@@)(@@)(@@) $ 14060 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( كنا مع رسول الله في المسير بعرفة ، فأخرجت امرأة صبيا لها من هودج ، فقالت : يا رسول الله ألهاذا من حج ؟ قال : نعم ، ولك أجر ) . ( ن ) . )(@)(@@) PageV19P191(@)(@@)(@@)(@@) $ 14061 عن جابر بن عبد الله رضي الله عنه قال :(@)(@@) | 30 ( قال النبي في حجته : أتدرون أي يوم أعظم حرمة ؟ قلنا : يومنا هاذا ، قال : أفتدرون أي بلد أعظم حرمة ؟ قلنا : بلدنا هاذا ، قال : فأي شهر أعظم حرمة ؟ قلنا : شهرنا هاذا ، قال : فإن دماءكم وأموالكم وأعراضكم حرام عليكم كحرمة يومكم هاذا ، في شهركم هذاا ، في بلدكم هاذا ) . ( ابن أبي عاصم في الديات ) . )(@)(@@)(@@)(@@) $ 14062 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( قال النبي في حجته : أتدرون أي يوم أعظم حرمة ؟ فقلنا : يومنا هاذا ، قال : فأي بلد أعظم حرمة ؟ فقلنا : بلدنا هاذا ، قال : فأي شهر أعظم حرمة ؟ قلنا : شهرنا هاذا ، قال : فإن دماءكم وأموالكم حرام 
ms6647	 عليكم ، كحرمة يومكم هاذا ، في بلدكم هاذا ، في شهركم هاذا ) . ( ش ) . )(@)(@@)(@@)(@@) $ 14063 عن جابر بن عبد الله رضي الله عنه :(@)(@@) | 30 ( أن رسول الله رجم يهوديا ويهودية ) . ( ش ) . )(@)(@@)(@@)(@@) $ ( 14064 ) عن جابر بن عبد الله رضي الله عنه في البكر ينكح ثم يزني قبل أن يجمع مع امرأته قال : الجلد عليه ولا رجم ' . ( عب ) .(@)(@@)(@@)(@@) $ 14065 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( رجم رسول الله رجلا من أسلم ، ورجلا من اليهود وامرأة ) . ( عب ) . )(@)(@@)(@@)(@@) $ 14066 عن ابن جريج ، أخبرني ابن شهاب ، عن أبي سلمة بن عبد الرحمان ، عن جابر بن عبد الله رضي الله عنه :(@)(@@) | 30 ( أن رجلا من أسلم أتاى النبي فحدثه أنه زناى ، شهد علاى نفسه أربع شهادات ، فأمر به رسول الله فرجم ، وكان قد أحصن ، زعموا أنه ماعز بن مالك ، قال ابن جريج : فأخبرني سعيد عن عبد الله بن دينار مولاى ابن عمر رضي الله عنهما : ( أن النبي قام بعد أن رجم الأسلمي ، فقال : اجتنبوا هاذه القاذورة التي نهاى الله تعالاى عنها ، PageV19P192 فمن ألم بشيء منها فليستتر ) . ( عب ) . )(@)(@@)(@@)(@@) $ 14067 عن معمر ، عن الزهري ، عن أبي سلمة بن عبد الرحمان ، عن جابر بن عبد الله رضي الله عنه :(@)(@@) | 30 ( أن رجلا من أسلم جاء النبي فاعترف بالزنا ، فأعرض عنه ، ثم اعترف ، فأعرض عنه ، حتى شهد علاى نفسه أربع مرات ، فقال النبي : أبك جنون ؟ قال : لا ، قال : أحصنت ؟ قال : نعم ، فأمر به النبي فرجم بالمصلى ، فلما أذلقته الحجارة فر ، فأدرك فرجم حتى مات ، فقال له النبي خيرا ولم يصل عليه ، قال معمر : فأخبرني ابن طاوس ، عن أبيه قال : لما أخبر رسول الله أنه فر ، فقال : هلا تركتموه قال معمر : وأخبرني أيوب بن حميد ، عن هلال قال : لما رجم النبي الأسلمي قال : واروا عني عوراتكم ما واراى الله عني منها ، ومن أصاب شيئا منها فليستتر ، قال معمر : وأخبرني يحى بن أبي كثير ، عن عكرمة : أن النبي قال لماعز حين اعترف بالزنا : أقبلت ؟ أباشرت ؟ ) . ( عب ) . )(@)(@@)(@@)(@@) $ 14068 عن جابر رضي الله عنه قال :(@)(@@) | 30 
ms6648	 ( كنت فيمن رجم ماعزا ، فلم يجلده رسول الله ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 14069 عن جابر رضي الله عنه :(@)(@@) | 30 ( أن رجلا زناى فأمر به رسول الله فجلد الحد ، ثم أخبر أنه كان قد أحصن ، فأمر به فرجم ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 14070 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : لا تدخلوا علاى هاؤلاء المغيبات ، فإن الشيطان يجري من ابن آدم مجراى الدم ، قيل : يا رسول الله ومنك ؟ قال : ومني ، ألا أن الله أعانني عليه فأسلم ) . ( ابن النجار ) . )(@)(@@)(@@)(@@) $ 14071 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( نهاى رسول الله أن ينبذ التمر والزبيب جميعا ، والبر والتمر جميعا ) . ( ش ، خ ، م ، ن ) . )(@)(@@) PageV19P193(@)(@@)(@@)(@@) $ 14072 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( نهاى رسول الله عن الجر والمزفت والنقير ، وكان رسول الله إذا لم يجد سقاء ينبذ فيه ، نبذ له في تور من حجارة ) . ( عب ) . )(@)(@@)(@@)(@@) $ 14073 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( نهاى رسول الله عن التمر والزبيب والبسر والرطب يعني أن ينبذا جميعا ) . ( عب ) . )(@)(@@)(@@)(@@) $ 14074 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( البسر ، والرطب خمر يعني : إذا جمعا ) . ( عب ) . )(@)(@@)(@@)(@@) $ ( 14075 ) عن ابن جريج قال : قال لي عطاء : سمعت جابر بن عبد الله رضي الله عنه يقول : لا تجمعوا بين الرطب والبسر ، وبين التمر والزبيب نبيذا ، قال ابن جريج : وأخبرني أبو الزبير عن جابر مثل قول عطاء ، عن النبي & ، قال ابن جريج : قلت لعطاء : أذكر جابر أن النبي & نهى أن يجمع بين نبيذين غير ما ذكرت : غير البسر والرطب ، والزبيب والتمر ؟ قال : لا إلا أن أكون نسيت ' . ( عب ) .(@)(@@)(@@)(@@) $ 14076 عن جابر رضي الله عنه قال : $ 30 ( قال العباس بن عبد المطلب : يا رسول الله أسقيك نبيذ خاصة أو نبيذ عامة ؟ ) . ( كر ، ن ) .(@)(@@)(@@)(@@) $ 14077 عن جابر رضي الله عنه :(@)(@@) | 30 ( أن النبي كان ينبذ له في تور من حجارة ) . ( كر ) . )(@)(@@)(@@)(@@) $ 14078 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( كان النبي لا يصلي علاى رجل عليه دين ، فأتي بميت ، فسأل : هل عليه دين ؟ قالوا : نعم ، ديناران 
ms6649	 ، قال : فصلوا علاى صاحبكم ، قال أبو قتادة : هما علي يا رسول الله فصلى عليه ، فلما PageV19P194 فتح الله علاى رسوله قال : أنا أولاى بكل مؤمن من نفسه ، من ترك دينا فعلي ، ومن ترك مالا فلورثته ) . ( عب ) . )(@)(@@)(@@)(@@) $ 14079 عن الزهري وقتادة عن جابر رضي الله عنهما قال :(@)(@@) | 30 ( في كل خمس من البقر شاة ، وفي عشر شاتان ، وفي خمس عشرة ثلاث شياه ، وفي عشرين أربع شياه ، فإذا كانت خمسا وعشرين ففيها بقرة إلاى خمس وسبعين ، فإذا زادت علاى خمس وسبعين ففيها بقرتان إلاى عشرين ومائة ، فإذا زادت علاى عشرين ومائة ففي كل أربعين بقرة ، قال الزهري : وبلغنا أن قولهم قال النبي : في كل ثلاثين بقرة تبيع ، أن ذالك كان تخفيفا لأهل اليمن ، ثم كان هاذا بعد ذالك ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 14080 عن أيوب ، عن جابر رضي الله عنه قال :(@)(@@) | 30 ( كنت أسمع زمانا من الناس أنهم يقولون : خذوا منا ما أخذ النبي ، فكنت أعجب حين لم يقبلوا منهم ذالك حتى حدثني الزهري أن النبي كتب كتابا فيه هاذه الفرائض ، فقبض رسول الله قبل أن يكتب به إلاى العمال ، فأخذ به أبو بكر بعده فأمضاه علاى ما كتب ، لا أعلمه إلا ذكر البقرة أيضا ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 14081 عن الزهري ، عن جابر رضي الله عنه قال :(@)(@@) | 30 ( فرائض البقر مثل فرائض الإبل ، غير أنه لا أسنان فيها ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 14082 عن قتادة ، عن سعيد بن المسيب وأبي قلابة ، عن جابر رضي الله عنه قالوا :(@)(@@) | 30 ( صدقات البقر كنحو صدقات الإبل : في خمس شاة ، وفي عشر شاتان ، وفي خمس عشرة ثلاث شياه ، وفي عشرين أربع شياه ، وفي خمس وعشرين بقرة مسنة إلاى خمس وسبعين ، فإذا زادت فبقرتان إلاى عشرين ومائة ، فإذا زادت ففي كل أربعين بقرة بقرة مسنة ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 14083 عن عكرمة بن خالد عن جابر رضي الله عنه قال :(@)(@@) | 30 ( استعملت علاى PageV19P195 صدقات عك ، فسألت أشياخي ممن صدق علاى عهد رسول الله فاختلفوا ، فقال بعضهم : في كل ثلاثين بقرة تبيع ، وفي كل أربعين مسنة 
ms6650	 ، وقال بعضهم : في خمس شاة ، وفي عشر شاتان مثل صدقة الإبل ) . ( ابن جرير ، عب ) . )(@)(@@)(@@)(@@) $ 14084 أنبأنا معمر قال :(@)(@@) | 30 ( أعطاني سماك بن الفضل كتابا من النبي إلاى مالك بن كفلانس والمصعبين فقرأته فإذا هو فيه : فيما سقت الأنهار والسماء العشر ، وفيما سقي بالرشاء نصف العشر ، وفي البقر مثل الإبل ) . ( ابن جرير ، وقال جماعة بهاذا ، وقالوا : إن الخبر الذي روي فيها عن معاذ منسوخ بكتاب النبي إلاى عماله بخلافه ) . )(@)(@@)(@@)(@@) $ 14085 عن جابر رضي الله عنه :(@)(@@) | 30 ( أن رجلا أتاى النبي فسأله فأعطاه ، ثم أتاه آخر فسأله فوعده ، ثم أتاه آخر فسأله فوعده ، فقام عمر بن الخطاب رضي الله عنه فقال : يا رسول الله سئلت فأعطيت ، ثم سئلت فأعطيت ، ثم سئلت فأعطيت ، ثم سئلت فوعدت ، ثم سئلت فوعدت ، فكأن رسول الله كرهه ، فقام عبد الله بن حذافة السهمي فقال : أنفق يا رسول الله ولا تخش من ذي العرش إقلالا ، فقال : بذالك أمرت ) . ( ابن جرير وسنده صحيح علاى شرط الشيخين ، فإنه قال : حدثني محمد بن عبد الله بن عبد الحكم المصري ، حدثنا أبي وشعيب بن الليث ، عن الليث بن سعد ، عن خالد بن يزيد ، عن ابن أبي هلال ، عن أبي سعيد : أن جابر بن عبد الله أخبرهم فذكره ) . )(@)(@@)(@@)(@@) $ 14086 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : اليد العليا خير من اليد السفلاى ، وابدأ بمن تعول ، وخير الصدقة ما كان عن ظهر غنى ) . ( ابن جرير في تهذيبه ) . )(@)(@@)(@@)(@@) $ 14087 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : ( من أعطي عطاء فوجد فليجز به ، فمن لم يجد فليثن ، فمن أثنى به فقد شكره ، ومن كتمه PageV19P196 فقد كفره ، والمتشبع بما لم يعط كلابس ثوبي زور ) . ( هب ) . )(@)(@@)(@@)(@@) $ 14088 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( كنا إذا صعدنا كبرنا ، وإذا نزلنا سبحنا ) . ( كر ) . )(@)(@@)(@@)(@@) $ 14089 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( كنا مع النبي في سفر ، فلما قدمنا المدينة قال : يا جابر ادخل المسجد فصل ركعتين ) . ( ش ) . )(@)(@@)(@@)(@@) $ 14090 عن جابر رضي الله عنه 
ms6651	 ، عن النبي :(@)(@@) | 30 ( كان إذا رجع من غزوته قال : آيبون ، إن شاء الله لربنا حامدون ) . ( ابن أبي عاصم ، والمحاملي في الدعاء ، كر ، ص ) . )(@)(@@)(@@)(@@) $ 14091 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( لما قدمنا مع رسول الله قال لي : يا جابر هل صليت ؟ قلت : لا ، قال : فصل ركعتين ) . ( ش ) . )(@)(@@)(@@)(@@) $ 14092 عن جابر بن عبد الله رضي الله عنه قال :(@)(@@) | 30 ( ما رأيت أحسن من رسول الله في حلة حمراء ) . ( ابن شاهين في الأفراد ، كر ) . )(@)(@@)(@@)(@@) $ 14093 عن جابر رضي الله عنه :(@)(@@) | 30 ( أن رسول الله لم يسأل عن شيء فقال : لا ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 14094 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( ما سئل رسول الله شيئا قط ، فقال : لا ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 14095 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( كانت راية النبي سوداء ) . ( طب ) . )(@)(@@)(@@)(@@) $ 14096 عن طلحة بن نافع قال :(@)(@@) | 30 ( حدثني أنس بن مالك ، وجابر بن PageV19P197 عبد الله رضي الله عنهما قالا : خرجنا مع النبي وبيده قضيب ، فضرب به ، فجعل ورقه يتناثر ، فقال : هل تدرون ما مثل هاذا ؟ قالوا : الله ورسوله أعلم ، قال : إن مثل هاذا مثل أحدكم ، إذا قام إلاى صلاته جعلت خطاياه فوق رأسه ، فإذا خر ساجدا تناثرت عنه كما يتناثر ورق هاذا العذق ) . ( ابن زنجويه ) . )(@)(@@)(@@)(@@) $ 14097 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : إن الله عز وجل يقول : قسمت الصلاة بيني وبين عبدي ، فإذا قال : { مالك يوم الدين } ، قال : مجدني عبدي ، فهاذا لي ، وله ما بقي ) . ( هق في كتاب القراءة في الصلاة ) . )(@)(@@)(@@)(@@) $ 14098 عن جابر بن عبد الله رضي الله عنه قال :(@)(@@) | 30 ( رأيت رسول الله يصلي في ثوب واحد متوشحا به ) . ( عب ، زاد كر : خلف أبي بكر رضي الله عنه ) . )(@)(@@)(@@)(@@) $ 14099 عن جابر بن عبد الله رضي الله عنه قال :(@)(@@) | 30 ( رأيت رسول الله يصلي في قميص ) . ( عب ، ش ) . )(@)(@@)(@@)(@@) $ 14100 عن جابر رضي الله عنه :(@)(@@) | 30 ( أن النبي صلى خلف أبي بكر رضي الله عنه في ثوب واحد ) . ( ن ) . )(@)(@@)(@@)(@@) $ 14101 عن جابر رضي الله 
ms6652	 عنه قال :(@)(@@) | 30 ( صلى رسول الله الظهر حين كان الظل مثل الشراك ، ثم صلى بنا العصر حين كان الظل مثله ، ومثل الشراك ، ثم صلى بنا المغرب حين غابت الشمس ، ثم صلى بنا العشاء حين ذهب ثلث الليل ، ثم صلى بنا الفجر فأسفر ) . ( ش ) . )(@)(@@)(@@)(@@) $ 14102 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( الظهر كاسمها يقول بالظهيرة ، PageV19P198 والعصر والشمس بيضاء حية ، والمغرب كاسمها ، كنا نصلي مع رسول الله المغرب ، ثم نأتي منازلنا علاى قدر ميل ، فنراى مواقع نبلنا ، وكان يعجل بالعشجء ويؤخر ، والفجر كاسمها ، وكان يغلس بها ) . ( عب ، ش : وهو صحيح ) . )(@)(@@)(@@)(@@) $ 14103 عن جابر رضي الله عنه :(@)(@@) | 30 ( أن رجلا أتاى النبي ، فسأله عن وقت الصلاة ؟ فسكت عنه رسول الله ، فأذن بلال رضي الله عنه بصلاة الظهر حين زالت الشمس ، فأمره رسول الله ، فأقام الصلاة فصلى ، ثم أذن بلال بالعصر حين ظننا أن ظل الرجل قد كان أطول منه ، فأمره رسول الله فأقام الصلاة ، ثم أذن بلال بالمغرب حين غابت الشمس وأفطر الصائم فأمره فأقام الصلاة ، ثم أذن بلال بالعشاء وهي العتمة حين ذهب بياض النهار ، وهو الشفق فيما يراى ، فأمره فأقام الصلاة فصلى ، ثم أذن بلال بالفجر حين تبين الفجر ، فأمره فأقام الصلاة فصلى ، ثم أذن بلال الغد بصلاة الظهر حين دلكت الشمس ، فأخرها رسول الله ، حتى ظننا أن ظل الرجل قد صار مثله ، فأمره فأقام فصلى ، ثم أذن بالعصر فأخرها رسول الله ، حتى ظننا أن ظل الرجل قد صار مثليه ، فأقام الصلاة فصلى ، ثم أذن بالمغرب فأخرها ، حتى كاد يذهب بياض النهار ، وهو الشفق فيما يراى ، فأمره فأقام الصلاة ، ثم أذن بالعشاء وهي العتمة حين ذهب بياض النهار فنمنا ، ثم قمنا مرارا ، ثم خرج إلينا رسول الله فقال : إن الناس قد صلوا ورقدوا ، وإنكم لن تزالوا في صلاة ما انتظرتم الصلاة ، ولولا أن أشق علاى أمتي لأخرت الصلاة إلاى هاذا الحين ، ثم صلى قريبا من نصف الليل ، أو قبل أن ينتصف الليل ، ثم أذن بلال بالفجر ، فأخرها رسول الله حتى 
ms6653	 أسفر الصبح ، ورأى الرامي موقع نبله ، ثم صلى ، ثم التفت إلاى الناس فقال : أين سائلي عن وقت الصلاة ؟ فقال : ها أنا ذا يا رسول الله ، قال رسول الله :(@)(@@) $ 30 ( ما بين هاذين الوقتين وقت الصلاة ) . ( ص ، كر ) . ) $(@)(@@) ( تكرار :(@)(@@)(@@)(@@) $ 14103 عن جابر رضي الله عنه :(@)(@@) | 30 ( أن رجلا أتاى النبي ، فسأله عن وقت الصلاة ؟ فسكت عنه رسول الله ، فأذن بلال رضي الله عنه بصلاة الظهر حين زالت الشمس ، فأمره رسول الله ، فأقام الصلاة فصلى ، ثم أذن بلال بالعصر حين ظننا أن ظل الرجل قد كان أطول منه ، فأمره رسول الله فأقام الصلاة ، ثم أذن بلال بالمغرب حين غابت الشمس وأفطر الصائم فأمره فأقام الصلاة ، ثم أذن بلال بالعشاء وهي العتمة حين ذهب بياض النهار ، وهو الشفق فيما يراى ، فأمره فأقام الصلاة فصلى ، ثم أذن بلال بالفجر حين تبين الفجر ، فأمره فأقام الصلاة فصلى ، ثم أذن بلال الغد بصلاة الظهر حين دلكت الشمس ، فأخرها رسول الله ، حتى ظننا أن ظل الرجل قد صار مثله ، فأمره فأقام فصلى ، ثم أذن بالعصر فأخرها رسول الله ، حتى ظننا أن ظل الرجل قد صار مثليه ، فأقام الصلاة فصلى ، ثم أذن بالمغرب فأخرها ، حتى كاد يذهب بياض النهار ، وهو الشفق فيما يراى ، فأمره فأقام الصلاة ، ثم أذن بالعشاء وهي العتمة حين ذهب بياض النهار فنمنا ، ثم قمنا مرارا ، ثم خرج إلينا رسول الله فقال : إن الناس قد صلوا ورقدوا ، وإنكم لن تزالوا في صلاة ما انتظرتم الصلاة ، ولولا أن أشق علاى أمتي لأخرت الصلاة إلاى هاذا الحين ، ثم صلى قريبا من نصف الليل ، أو قبل أن ينتصف الليل ، ثم أذن بلال بالفجر ، فأخرها رسول الله حتى أسفر الصبح ، ورأى الرامي موقع نبله ، ثم صلى ، ثم التفت إلاى الناس فقال : أين سائلي عن وقت الصلاة ؟ فقال : ها أنا ذا يا رسول الله ، قال رسول الله :(@)(@@) $ 30 ( ما بين هاذين الوقتين وقت الصلاة ) . ( ص ، كر ) . ) $(@)(@@) )(@)(@@)(@@)(@@) $ 14104 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( كان النبي يصلي الظهر حين PageV19P199 تزول 
ms6654	 الشمس ، والعصر والشمس بيضاء نقية حية ، والمغرب حين تجب الشمس ، والعشاء ربما عجل ، وربما أخر ، إذا اجتمع الناس عجل ، وإذا تأخروا أخر ، والصبح كان يصليها بغلس ) . ( ض ) . )(@)(@@)(@@)(@@) $ 14105 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( كنت أصلي مع النبي الظهر ، فآخذ قبضة من الحصى فأجعلها في كفي ، ثم أحولها إلاى الكف الاخراى حتى تبرد ، ثم أضعها لجبيني حتى أسجد من شدة الحر ) . ( ش ) . )(@)(@@)(@@)(@@) $ 14106 عن جابر رضي الله عنه :(@)(@@) | 30 ( أن النبي غربت له الشمس وهو بسرف فلم يصل المغرب حتى دخل مكة ) . ( عب ) . )(@)(@@)(@@)(@@) $ 14107 عن جابر بن عبد الله رضي الله عنه قال :(@)(@@) | 30 ( خرج النبي وأصحابه ينتظرونه لصلاة العشاء الآخرة ، فقال : صلى الناس ورقدوا وأنتم تنتظرون الصلاة ، أما إنكم في صلاة ما انتظرتموها ، ولولا ضعف الضعيف ، وكبر الكبير لأخرت العشاء إلاى شطر الليل ) . ( ش ، وابن جرير ) . )(@)(@@)(@@)(@@) $ 14108 عن جابر بن عبد الله رضي الله عنه قال :(@)(@@) | 30 ( جهز رسول الله جيشا حتى انتصف الليل ، أو بلغ ذالك ، ثم خرج إلينا فقال : صلى الناس ورقدوا وأنتم تنتظرون الصلاة ، أما إنكم لن تزالوا في صلاة منذ انتظرتموها ) . ( ش ، وابن جرير ) . )(@)(@@)(@@)(@@) $ 14109 عن عبد الله بن محمد بن عقيل ، عن جابر رضي الله عنه قال :(@)(@@) | 30 ( قال النبي لأبي بكر رضي الله عنه : أي حين توتر ؟ فقال : أول الليل بعد العتمة ، قال : فأنت يا عمر ؟ فقال : آخر الليل ، فقال النبي :(@)(@@) $ 30 ( أما أنت يا PageV19P200 أبا بكر فإنك أخذت بالوثقاى ، وأما أنت يا عمر فأخذت بالقوة ) . ( ابن جرير ) . ) $(@)(@@)(@@)(@@) $ 14110 عن جابر رضي الله عنه :(@)(@@) | 30 ( أن رسول الله صلى الفجر فلما قضاى صلاته بصر برجل يصلي فرقبه حتى قضاى صلاته ، فأرسل إليه فقال : ما صلاتك هاذه بعد المكتوبة ؟ فقال : يا رسول الله دخلت المسجد وأنت في الصلاة ولم أكن صليت ركعتي الفجر ، فدخلت في صلاتك وآثرتها علاى الركعتين ، فلما سلمت صليت الركعتين ، قال جابر : ولم ينكر ذالك عليه رسول الله ولم يغير ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 14111 عن جابر رضي الله عنه قال :(@)(@@) | 30 
ms6655	 ( أما أنا فأقرأ في الركعتين الاوليين من الظهر والعصر بفاتحة الكتاب وسورة ، وفي الاخريين بفاتحة الكتاب ) . ( عب ) . )(@)(@@)(@@)(@@) $ 14112 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( قال لي النبي : كيف تفتتح الصلاة يا جابر ؟ قلت : ب { الحمد لله رب العالمين } ، قال لي : قل : { بسم الله الرحمان الرحيم } ) . ( ابن النجار ) . )(@)(@@)(@@)(@@) $ 14113 عن جابر بن عبد الله رضي الله عنه قال :(@)(@@) | 30 ( كان رسول الله إذا سجد جافاى حتى يراى بياض إبطيه ) . ( عب ) . )(@)(@@)(@@)(@@) $ 14114 عن جابر بن عبد الله رضي الله عنه قال :(@)(@@) | 30 ( سمعت رسول الله يأمر بأن يعتدل في السجود ، ولا يسجد الرجل باسطا ذراعيه كالكلب ) . ( عب ) . )(@)(@@)(@@)(@@) $ 14115 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( التسبيح في الصلاة للرجال ، PageV19P201 والتصفيق للنساء ) . ( ش ) . )(@)(@@)(@@)(@@) $ 14116 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( إذا ضحك الرجل في الصلاة ، فإنه يعيد الصلاة ولا يعيد الوضوء ) . ( عب ) . )(@)(@@)(@@)(@@) $ 14117 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( إذا كان أحدكم علاى عشائه ونودي بالصلاة فلا يعجل عنه حتى يفرغ ) . ( عب ) . )(@)(@@)(@@)(@@) $ 14118 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( لا يقطع صلاة المسلم شيء ، وادرءوا ما استطعتم ) . ( عب ) . )(@)(@@)(@@)(@@) $ 14119 عن جابر بن عبد الله رضي الله عنه قال :(@)(@@) | 30 ( كنا ندعو قياما وقعودا ، ونسبح ركوعا وسجودا ) . ( ش ) . )(@)(@@)(@@)(@@) $ ( 14120 ) عن جابر رضي الله عنه قال : ' أقام رسول الله صلى الله عليه وسلم بتبوك عشرين ليلة يقصر الصلاة ' . ( عب ) .(@)(@@)(@@)(@@) $ 14121 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( أقمت مع رسول الله عام الفتح بمكة ، فأقام ثماني عشرة لا يصلي إلا ركعتين ، ثم يقول لأهل البلد : صلوا أربعا فإنا قوم سفر ) . ( ش ) . )(@)(@@)(@@)(@@) $ 14122 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( كنا مع رسول الله في سفر ، وإنا سرينا ليلة ، حتى إذا كان آخر الليل وقفنا تلك الوقفة ، ولا وقفة عند المسافر أحلاى منها ، فما أيقظنا إلا حر الشمس ، فجعل عمر رضي الله عنه يكبر ، فلما استيقظ النبي شكا الناس إليه ما أصابهم ، فقال : لا ضير فارتحلوا ، فساروا غير بعيد ، ثم نزل فنودي 
ms6656	 بالناس فصلى بالناس ) . ( ش ) . )(@)(@@)(@@)(@@) $ 14123 عن جابر رضي الله عنه :(@)(@@) | 30 ( أن النبي جمع بين الصلاتين في السفر : الظهر والعصر ) . ( ابن جري ) . )(@)(@@) PageV19P202(@)(@@)(@@)(@@) $ 14124 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( جمع النبي في غزوة تبوك بين الظهر والعصر ، وبين المغرب والعشاء ) . ( ش ) . )(@)(@@)(@@)(@@) $ 14125 عن جابر رضي الله عنه :(@)(@@) | 30 ( أن رسول الله غربت له الشمس بمكة فجمع بينهما بسرف ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 14126 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( خرج رسول الله من مكة عند غروب الشمس حتى أتاى سرف ، وهي بتسعة أميال من مكة ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 14127 عن جابر رضي الله عنه :(@)(@@) | 30 ( أن النبي جمع بين الظهر والعصر بأذان وإقامتين ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 14128 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( تخلف قوم عن صلاة العشاء الآخرة ، فقال رسول الله : ما خلفكم ؟ فسكتوا ، فأعاد عليهم ، فقالوا : يا رسول الله يقع بيننا لحاء وكلام ، فقال رسول الله : لا صلاة لمن سمع النداء ولم يأته إلا من علة ) . ( ابن النجار ) . )(@)(@@)(@@)(@@) $ 14129 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( كان النبي يصلي بنا المكتوبة صلاة لا يطيل فيها ولا يخفف وسطا من ذالك ، وكان يؤخر العتمة ) . ( ابن النجار ) . )(@)(@@)(@@)(@@) $ 14130 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( كان رسول الله أشد الناس تخفيفا في صلاته ) . ( ابن النجار ) . )(@)(@@)(@@)(@@) $ 14131 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( نهاى رسول الله أن يكون الإمام مؤذنا ) . ( أبو الشيخ في الأذان ) . )(@)(@@) PageV19P203(@)(@@)(@@)(@@) $ 14132 عن جابر بن عبد الله رضي الله عنه قال :(@)(@@) | 30 ( سرنا مع رسول الله في غزوة بطن بواط ، فقال رسول الله : من رجل يتقدم فيمدر لنا الحوض ويشرب ويسقينا ؟ قال جابر : فقلت : هاذا رجل يا رسول الله ، فقال رسول الله : من رجل مع جابر ؟ فقام جبار بن صخر رضي الله عنه ، فأتينا الحوض ، ثم مدرناه فكان أول طالع علينا رسول الله ، ثم جاء إلاى الحوض فتوضأ منه وقام يصلي ، فجئت فقمت عن يسار رسول الله فأخذ بيدي فأدارني حتى أقامني عن يمينه ، وجاء جبار فأقام عن 
ms6657	 يساره ، فدفعنا بيده جميعا حتى جعلنا وراءه ) . ( أبو نعيم ، عب ) . )(@)(@@)(@@)(@@) $ ( 14133 ) عن جابر رضي الله عنه قال : ' كان رسول الله صلى الله عليه وسلم يقرأ الركعتين الأوليين بفاتحة الكتاب وسورة ، وفي الأخريين بفاتحة الكتاب ، وكنا نتحدث أنه لا صلاة إلا بفاتحة الكتاب فما زاد ' . ( ش ، هق في كتاب القراءة في الصلاة ) .(@)(@@)(@@)(@@) $ 14134 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( صلى رسول الله الظهر والعصر ، فلما انصرف قال : من قرأ خلفي ب { سبح اسم ربك الأعلى } ؟ فلم يكلمه أحد ، فردد ذالك ثلاثا ، فقال رجل : أنا يا رسول الله فقال : لقد رأيتك تخالجني ، أو قال : تنازعني القرآن من صلى منكم خلف إمامه فقراءته له قراءة ) . ( هق في كتاب القراءة ) . )(@)(@@)(@@)(@@) $ 14135 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( صلى رسول الله ورجل خلفه يقرأ ، فنهاه رجل ، فلما انصرف تنازعا ، حتى بلغ رسول الله ، فقال PageV19P204 رسول الله : من صلى خلف إمام ، فإن قراءة الإمام له قراءة ) . ( هق في كتاب القراءة ) . )(@)(@@)(@@)(@@) $ ( 14136 ) عن جابر رضي الله عنه قال : سمعت رسول الله صلى الله عليه وسلم يقول : من صلى صلاة لا يقرأ فيها بأم القرآن فهى خداج ، إلا وراء الإمام ' . ( هق في كتاب القراءة وضعفه ) .(@)(@@)(@@)(@@) $ 14137 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : لا تجزىء صلاة لا يقرأ فيها بفاتحة الكتاب إلا أن يكون وراء الإمام ) . ( هق في كتاب القراءة وضعفه ) . )(@)(@@)(@@)(@@) $ 14138 عن جابر بن عبد الله رضي الله عنه قال :(@)(@@) | 30 ( خرجنا مع رسول الله في سفر فمطرنا ، فقال : ليصل من شاء منكم في رحله ) . ( حب ، ز ) . )(@)(@@)(@@)(@@) $ 14139 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( كان رسول الله إذا كانت ليلة ريح شديدة كان مفزعه إلاى المسجد حتى تسكن الريح ، وإذا حدث في السماء حدث من كسوف شمس أو قمر كان مفزعه إلاى المصلى حتى تنجلي ) . ( ابن أبي الدنيا ، كر وسنده حسن ) . )(@)(@@)(@@)(@@) $ 14140 عن جابر بن عبد الله رضي الله عنه قال :(@)(@@) | 30 ( صرع رسول الله عن فرس له ، فوقع علاى جذع 
ms6658	 فانفكت قدمه ، فدخلنا عليه نعوده وهو يصلي في مشربة لعائشة رضي الله عنها جالسا ، فصلينا بصلاته ونحن قيام ، ثم دخلنا عليه مرة أخراى وهو يصلي جالسا فصلينا بصلاته ونحن قيام ، فأومأ إلينا أن اجلسوا ، فلما صلى قال : إنما جعل الإمام ليؤتم به ، فإذا صلى قائما فصلوا قياما ، وإذا صلى جالسا فصلوا جلوسا ، ولا تقوموا وهو جالس كما يفعل أهل فارس بعظمائها ) . ( ش ) . )(@)(@@) PageV19P205(@)(@@)(@@)(@@) $ 14141 عن جابر بن عبد الله رضي الله عنه قال :(@)(@@) | 30 ( أتيت النبي وهو في المسجد فقال : صل ركعتين ) . ( ش ) . )(@)(@@)(@@)(@@) $ 14142 عن جابر بن عبد الله رضي الله عنه قال :(@)(@@) | 30 ( جاء سليك الغطفاني والنبي يخطب يوم الجمعة ، فقال له : صليت ؟ قال : لا ، قال : صل ركعتين تجوز فيهما ) . ( ش ) . )(@)(@@)(@@)(@@) $ 14143 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( أحدنا يمر في المسجد جنبا مجتازا ) . ( ص ) . )(@)(@@)(@@)(@@) $ 14144 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( كان الجنب يمر في المسجد مجتازا ) . ( ش ) . )(@)(@@)(@@)(@@) $ 14145 عن سليمان بن موساى قال :(@)(@@) | 30 ( سئل جابر بن عبد الله رضي الله عنه عن سل السيف في المسجد ؟ فقال : قد كنا نكره ذالك ، وقد كان رجل يتصدق بالنبل في المسجد ، فأمره النبي أن لا يمر بها في المسجد إلا وهو قابض علاى نصالها جميعا ) . ( عب ) . )(@)(@@)(@@)(@@) $ 14146 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( قيل : يا رسول الله من أول الناس دخولا الجنة ؟ قال : الأنبياء ، ثم الشهداء ، ثم مؤذنوا الكعبة ، ثم مؤذنوا بيت المقدس ، ثم مؤذنوا مسجدي ، ثم سائر المؤذنين علاى قدر أعمالهم ) . ( أبو الشيخ في الأذان ) . )(@)(@@)(@@)(@@) $ 14147 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( كنا نصلي مع رسول الله الجمعة ، ثم نرجع فنريح نواضحنا ) . ( ش ) . )(@)(@@)(@@)(@@) $ 14148 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( نظر رسول الله إلاى الناس يوم PageV19P206 الجمعة باذة هيئتهم ، فقال : ما ضر رجلا لو اتخذ لهاذا اليوم ثوبين يروح فيهما ) . ( ش ) . )(@)(@@)(@@)(@@) $ 14149 عن جابر بن عبد الله رضي الله عنه قال :(@)(@@) | 30 ( كان رسول الله يصلي علاى راحلته تطوعا حيث توجهت به ، وإذا أراد 
ms6659	 أن يصلي المكتوبة نزل عن راحلته واستقبل القبلة ) . ( عب ) . )(@)(@@)(@@)(@@) $ 14150 عن جابر رضي الله عنهق قال :(@)(@@) | 30 ( كان رسول الله يصلي علاى راحلته تطوعا حيث توجهت به ، ويجعل السجود أخفض من الركوع ) . ( عب ) . )(@)(@@)(@@)(@@) $ 14151 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( رأيت رسول الله يصلي وهو علاى راحلته النوافل في كل جهة ، ولاكنه يخفض السجود من الركعة يومىء إيماء ) . ( عب ) . )(@)(@@)(@@)(@@) $ 14152 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( بعثني رسول الله لحاجة ، فجئت وهو يصلي نحو المشرق ، ويومىء برأسه إيماء علاى راحلته ، السجود أخفض من الركوع ، فسلمت فلم يرد علي ، فلما قضاى صلاته ، قال : ما فعلت في حاجة كذا وكذا ؟ إني كنت أصلي ) . ( عب ) . )(@)(@@)(@@)(@@) $ 14153 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( رأيت النبي في غزوة تبوك يصلي علاى راحلته حيث توجهت به صلاة الليل ) . ( خط ) . )(@)(@@)(@@)(@@) $ 14154 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( صلاة الخوف ركعة ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 14155 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( صلى بنا رسول الله صلاة الخوف ركعة ، وكان رسول الله بيننا وبين الورد ) . ( ابن النجار ) . )(@)(@@) PageV19P207(@)(@@)(@@)(@@) $ 14156 عن الثوري ، عن أبي الزبير ، عن جابر رضي الله عنه :(@)(@@) | 30 ( أن النبي صلى بهم مثل هاذه الصلاة ، غير أنه لم يذكر نزول جبريل ) . ( عب ) . )(@)(@@)(@@)(@@) $ 14157 عن جابر بن عبد الله رضي الله عنه قال :(@)(@@) | 30 ( انكسفت الشمس علاى عهد رسول الله يوم مات إبراهيم ، فقام النبي فصلى ست ركعات وأربع سجدات ، فاقترأ فأطال القراءة ، ثم ركع نحوا مما قام ، ثم رفع رأسه فاقترأ قراءة هي دون القراءة الاولاى ، ثم ركع نحوا مما قام ، ثم رفع رأسه فقرأ قراءة دون الثانية ، ثم ركع نحوا مما قام ، ثم رفع رأسه فانحدر بالسجود فسجد سجدتين ، ثم قام فركع ثلاث ركعات كل ركعة دون التي قبلها ، ثم انحدر بالسجود وقد كان تأخر في صلاته ، فتأخرت الصفوف خلفه حتى انتهاى إلاى النساء ، ثم تقدم حتى كان في مقامه ، فقضاى الصلاة حين قضاها وقد أضاءت الشمس فقال : يا أيها الناس إن الشمس 
ms6660	 والقمر آيتان من آيات الله ، وإنهما لا ينكسفان لموت بشر ، فإذا رأيتم من ذالك شيئا فصلوا حتى تنجلي ، ثم قال : ما من شيء توعدونه إلا وقد رأيته في صلاتي هاذه ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 14158 عن جابر بن عبد الله رضي الله عنه قال :(@)(@@) | 30 ( كسفت الشمس علاى عهد رسول الله في يوم شديد الحر ، فصلى رسول الله بأصحابه فأطال القيام حتى جعلوا يخرون ، ثم ركع فأطال ، ثم رفع فأطال ، ثم ركع فأطال ، ثم رفع فأطال ، ثم سجد سجدتين ، ثم قام فصنع نحوا من ذالك ، فكانت أربع ركعات وأربع سجدات ، ثم قال : إنه عرض علي كل شيء توعدونه ، فعرضت علي الجنة حتى لو تناولت منها قطفا لأخذته أو قال : تناولت منها قطفا ، فقصرت يدي عنه ، وعرضت علي النار فرأيت فيها امرأة من بني إسرائيل تعذب في هرة لها ربطتها فلم تطعمها ، ولم تدعها تأكل من خشاش الأرض ، ورأيت أبا ثمامة PageV19P208 عمرو بن مالك يجر قصبه في النار ، وإنهم كانوا يقولون : إن الشمس والقمر لا ينخسفان إلا لموت عظيم ، وإنهما آيتان من آيات الله يريكموهما ، فإذا كسفت فصلوا حتى تنجلي ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 14159 عن جابر رضي الله عنه :(@)(@@) | 30 ( أن رسول الله إذا كانت ليلة ريح شديدة كان مفزعه إلاى المسجد حتى تسكن الريح ، وإذا حدث في السماء حدث من كسوف شمس أو قمر كان مفزعه إلاى المصلى ) . ( ابن أبي الدنيا وسنده حسن ) . )(@)(@@)(@@)(@@) $ 14160 عن عبيد الله ، عن جابر رضي الله عنه قال :(@)(@@) | 30 ( إنما قال النبي : أفطر الحاجم والمحجوم لاءنه مر بهما وهما يغتابان رجلا في رمضان ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 14161 عن جابر رضي الله عنه قال :(@)(@@) | 30 ( كان رسول الله لا يكاد يدع أحدا من أهله في يوم عيد إلا أخرجه ) . ( كر ) . )(@)(@@)(@@)(@@) $ 14162 عن جابر رضي الله عنه :(@)(@@) | 30 ( أن النبي خرج يوم العيد فبدأ بالصلاة من غير أذان ولا إقامة ، ثم خطب ) . ( ابن النجار ) . )(@)(@@)(@@)(@@) $ 14163 عن جابر بن عبد الله رضي الله عنه قال :(@)(@@) | 30 ( مر النبي بحمار قد وسم في 