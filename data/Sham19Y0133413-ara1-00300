@)(@@)(@@) || AUTO ن(@)(@)(@@)(@@)(@@) || AUTO ي(@)(@)(@@) ة- ال(@)(@)(@@)(@@)(@@) || AUTO ي(@)(@)(@@)(@@)(@@) || AUTO و(@)(@)(@@)(@@)(@@) || AUTO ن(@)(@)(@@) س(@)(@)(@@)(@@)(@@) || AUTO ي(@)(@)(@@) ة.(@)(@)PageV02P624(@)(@)(@@) كتاب الفرائض(@)(@)PageV02P625(@)(@)(@@)(@@)(@@) | AUTO كتاب الفرائض(@)(@)(@@)(@@)(@@) || AUTO أسباب التوارث(@)(@)(@@) ثلاثة: رحم ونكاح وولاء.(@)(@@) والوراث ثلاثة: ذو فرض، وعصبة، وذو رحم.(@)(@@) والوراث المجمع عليهم من الذكور عشرة: الابن وابنة وإن نزل والأب وأبوه وإن علا، والأخ من كل جهة وابنه إن لم يكن من أم، والعم وابنه كذلك، والزوج، ومولى النعمة.(@)(@@) ومن الإناث سبع: البنت، وبنت الابن، والأم، والجدة، والأخت، والمرأة، ومولاة النعمة.(@)(@)PageV02P627(@)(@)(@@) ويسقط الجد بالأب، والجدات بالأم. وولد الابن بالابن .. وكل جد أو عم، أو ابن ابن بمن هو أقرب.(@)(@@) وولد الأبوين يسقط بالابن وابنه، والأب، وكذلك يسقط بهم ولد الأب وبولد الأبوين. وولد الأم بالولد مطلقا، وولد الابن، والأب، والجد والابن.(@)(@@) ذوو الفرض عشرة: الزوجان والأبوان والجد والجدة والبنت وبنت الابن، والأخت من كل جهة.(@)(@@) والأخ من الأم(@)(@)PageV02P628(@)(@)(@@)(@@)(@@) || AUTO والفروض(@)(@)(@@) سبعة:(@)(@@) الثمن: فرض الزوجة مع الولد واحدة كانت أو أكثر.(@)(@@) والربع: فرض الزوج مع الولد، والزوجة مع عدمه واحدة أو أكثر.(@)(@@) والنصف: فرض الزوج 
ms298	 مع عدم الولد، والبنت الواحدة، والأخت الواحدة.(@)(@@) والسدس: فرض (الأبوين) مع الولد: والأم مع الإخوة، والجد مع الولد والجدة واحدة كانت أو أكثر.(@)(@@) وبنت الابن مع البنت واحدة كانت أو أكثر .. والأخوات لأب مع الأخت من الأبوين واحدة كانت أو أكثر .. والواحد من ولد الأم PageV02P629 (@@) والثلث: فرض. الأم مع عدم الولد، وللإخوة الاثنان فصاعدا من ولد الأم، والثلثان فرض البنتين والأختين.(@)(@@) وثلث الباقي: فرض الأم في العمريتين، والجد مع الإخوة.(@)(@@) وإذا استكمل الفروض المال سقط من سواهم، وإن لم يستكملوه، ولم يكن غيرهم رد الفاضل عليهم على قدر فروضهم إلا الزوج والزوجة.(@)(@@) وإن كان غيرهم من العصبات أخذ الباقي وهم عشرة: (الابن ثم ابنه، ثم الأب، ثم أبوه .. ثم الأخ ثم ابنه إلا من الأم، ثم العم ثم ابنه إلا من الأم. ثم مولى النعمة، ومولاة النعمة .. ويقدم الأقرب فالأقرب فإن كان واحدا أخذ المال كله.(@)(@)PageV02P630(@)(@)(@@) أو الباقي بعد ذوي الفروض .. وإن كانوا جماعة كان بينهم، وليس في العصبات أنثى غير مولاة النعمة، والبنات، وبنات الابن والأخوات من الأبويين، أو من الأب إذا كان معهن أخ ذكر لهن. والأخوات مع البنات ومن عداهن لا يأخذ الميراث الذكور دون الإناث.(@)(@@) فإن لم يكن ذو فرض ولا عصبة ورث ذوو الأرحام.(@)(@@) وهم أحد عشر صنفا: ولد البنات. وولد الأخوات. وبنات الإخوة .. وبنات الأعمام .. وبنو الإخوة من الأم. والعم من الأم .. والعمات .. والأخوال .. والخالات وأبو الأم .. وكل جدة أدلت بأب بين أمين، أو بأب أعلى من الجد ويجعل كل شخص منهم بمنزلة من أدلى به.(@)(@@) والفروض. نوعان منها ما لا يعول، فالنصف من اثنين، والثلث وحده، أو مع الثلثين، أو هما مع ثلاثة .. والربع وحده أو مع النصف من أربعة، والثمن وحده أو مع النصف من ثمانية؟ ؟ .(@)(@@) وأما التي تعول فما فيها فرضان أو فروض من نوعين، فإذا اجتمع مع النصف سدس أو ثلث أو ثلثان فهي من ستة وتعول إلى عشرة .. وإن اجتمع مع PageV02P631 (@@) الربع أحد الثلاثة فهي من اثني عشر وتعول 
ms299	 على الانفراد إلى سبعة عشر وإن اجتمع مع الثمن سدس أو ثلثان فمن أربعة وعشرين وتعول إلى سبعة وعشرين وإذا لم ينقسم سهم فريق عليهم قسمة صحيحة فاضرب عددهم في أصل المسألة وعولها ثم يصير لكل واحد منهم ما كان لجماعتهم. فإن وافق عددهم سهامهم بجزء من الأجزاء أجزأك ضرب وفق عددهم ثم يصير لكل واحد وفق ما كان لجماعتهم. وإذا انكسر على فريقين فأكث وكانت متماثلة اجتزأت بأحدهما .. وإن كانت متناسبة وهو أن ينسب الأقل إلى الأكثر بجزء من أجزائه اجتزأت بأكثرهما، وضربته في المسألة وعولها وإن كانت متباينة ضربت بعضها في بعض فما بلغ ضربته في المسألة وعولها.(@)(@@) وإن كانت متوافقة ضربت وفق أحدهما في الآخر ثم وافقت بين ما بلغ وبين الثالث.(@)(@@) وإذا مات بعض الورثة قبل قسمة التركة، فإن كان ورثة الثاني يرثونه كالأول، فاقسمه عليهم- وإن كان ما بعد الأول لا يرث بعضهم بعضا فاقسم PageV02P632 (@@) ميراث كل ميت على ورثته وإن كانوا يتوارثون فإن أردت أن تصحح كل مسألة على انفرادها فهو أسهل.(@)(@@) وإذا استهل المولود صارخا ورث وورث وإذا مات عن حمل وقف له نصيب الأكثر من ذكرين أو أنثيين ولا يعطى من يحجبه، ومن فقد في مهلكة انتظر أربع سنين وقسم ميراثه، وفي أمر سلامة ينتظر تسعين سنة والخنثى المشكل ترث نصف ميراث ذكر ونصف ميراث أنثى. ولا يرث مسلم كافرا. ولا كافر مسلما. ولا قاتل، ولا عبد، ومن أقر بوارث يشاركه دفع إليه القدر الزائد على إرثه وإن كان يحجبه دفع إليه كل ما في يده ولا يقبل إقراره على وارث غيره.(@)(@)PageV02P633(@)(@)(@@) كتاب الحساب(@)(@)PageV02P635(@)(@)(@@)(@@)(@@) | AUTO كتاب الحساب(@)(@)(@@) اعلم أن العدد إما أن يكون آحادا وهو من واحد إلى تسعة، وعشرات وهي من عشرة إلى تسعين، ومئين وهي من مائة إلى ألف، وألوف وهي من ألف إلى تسعة آلاف، فالآحاد في أي مرتبة ضربت كان للواحد مما يرتفع واحدا فثلاثة في ثلاثة يجعل لكل فرد من أفراد الثلاثة المضروب وهو ثلاثة تكن تسعة، والعشرات 
ms300	 في العشرات مئين لكل واحد مائة، وفي المئيين ألوف، وفي الألوف عشرات ألوف، والمئين في المئيين عشرت ألوف، وفي الألوف مئات ألوف، والألوف في الألوف ألوف ألوف، وإذا ضربت عددا متركبا في عدد متركب فإن كانا من أحد عشر إلى تسعة عشر فإنك تضم آحاد أحدهما إلى جميع الآخر، وتأخذ لكل واحد عشرة، وتضم إلى ذلك المرتفع منه، ضرب الآحاد في الآحاد، وإن كانا من واحد وعشرين إلى تسعة وتسعين فإن تساوت عشراتهما فالعمل كما تقدم، لكن إذا ضممت آحاد أحدهما إلى الآخر فإنك تضعفه بعدد عشرات أحدهما، وتأخذ لكل واحد عشرة، وتضيف إليه ضرب الآحاد في الآحاد، وإن كانت عشراتهما مختلفة كررت أحد المضروبين بعدد عشرات الآخر. وكررت آحاد الآخر بعدد عشرات المكررة، وهذا يكفي الطالب من هذا الفن.(@)(@)PageV02P637(@)(@)(@@) كتاب الفتن والملاحم(@)(@@) مرتب على الحروف(@)(@)PageV02P639(@)(@)(@@)(@@)(@@) | CHECK كتاب الفتن والملاحم (مرتب على الحروف)(@)(@)(@@) ك(@)(@)(@@)(@@)(@@) || AUTO ت(@)(@)(@@) ا(@)(@)(@@)(@@)(@@) || AUTO ب(@)(@)(@@) الف(@)(@)(@@)(@@)(@@) || AUTO ت(@)(@)(@@) ن والملا(@)(@)(@@)(@@)(@@) || AUTO ح(@)(@)(@@) م (م(@)(@)(@@)(@@)(@@) || AUTO ر(@)(@)(@@)(@@)(@@) || AUTO ت(@)(@)(@@)(@@)(@@) || AUTO ب(@)(@)(@@) على ال(@)(@)(@@)(@@)(@@) || AUTO ح(@)(@)(@@)(@@)(@@) || AUTO ر(@)(@)(@@) وف)(@)(@)(@@)(@@)(@@) || AUTO أ(@)(@)(@@) - إ(@)(@)(@@)(@@)(@@) || AUTO خ(@)(@)(@@)(@@)(@@) || AUTO ر(@)(@)(@@) ا(@)(@)(@@)(@@)(@@) || AUTO ج(@)(@)(@@) ال(@)(@)(@@)(@@)(@@) || AUTO أ(@)(@)(@@)(@@)(@@) || AUTO ر(@)(@)(@@) ض كنو(@)(@)(@@)(@@)(@@) || AUTO ز(@)(@)(@@) ها, انف(@)(@)(@@)(@@)(@@) || AUTO ت(@)(@)(@@) ا(@)(@)(@@)(@@)(@@) || AUTO ح(@)(@)(@@) كنو(@)(@)(@@)(@@)(@@) || AUTO ز(@)(@)(@@) كس(@)(@)(@@)(@@)(@@) || AUTO ر(@)(@)(@@) ى, ال(@)(@)(@@)(@@)(@@) || AUTO أ(@)(@)(@@) ئمة المضلون.(@)(@)(@@)(@@)(@@) || AUTO ب(@)(@)(@@) -(@)(@)(@@)(@@)(@@) || AUTO ب(@)(@)(@@) يع ال(@)(@)(@@)(@@)(@@) || AUTO د(@)(@)(@@) ين(@)(@)(@@)(@@)(@@) || AUTO ب(@)(@)(@@) ال(@)(@)(@@)(@@)(@@) || AUTO د(@)(@)(@@) نيا,(@)(@)(@@)(@@)(@@) || AUTO ب(@)(@)(@@) يع ال(@)(@)(@@)(@@)(@@) || AUTO ح(@)(@)(@@) كم.(@)(@)(@@)(@@)(@@) || AUTO ت(@)(@)(@@) -(@)(@)(@@)(@@)(