ms61	(@)(@@) % وأتت صفوف المرسلين فكنت في % % عظمائهم جبل الكمال الراسي % % 10(@)(@@) % وعلت شمائلك الكريمة مطلقا % % أبدا شمائلهم بكل قياس % % PageV01P211 11(@)(@@) % روحي فداء تراب نعلك إنه % % شرفا يفوق عصائم الألماس % % 12(@)(@@) % يجري بقلبي ذكرك العالي فيغتيني % % عن الخلان والجلاس % % 13(@)(@@) % ويمر بي معناك يا علم الهدى % % فأغيب بالاشواق عن إحساسي % % 14(@)(@@) % وإذا تكاثفت الهموم فذكر وجهك % % يا حبيبي باعث إيناسي % % 15(@)(@@) % كم هز مدحك عاشقا فغدا يميل % % له كغصن البانة المياس % % 16(@)(@@) % يا سيدا هو في الظهور وفي الخفا % % للأنبياء الزهر تاج الراس % % 17(@)(@@) % حبيك لليوم المهول ذخيرتي % % ووسيلتي للعز بين الناس % % 18(@)(@@) % وإذا مدحتك فارقا أو جامعا % % أنسا يرنحني شميم الآس % % 19(@)(@@) % أنا من علاقات الورى عار ومن % % أمراط حبك بالمفاخر كاس % % 20(@)(@@) % إني قصدتك وافدا بقصيدة % % درية وتجارتي إفلاسي % % PageV01P212 21(@)(@@) % صلى عليك الله والآل الذين % % الله طهركم من الأرجاس % % PageV01P213 البحر : طويل 1(@)(@@) % كثمت غرامي عن هواجس خاطري % % بزاوية مكنونة السر في الحشا % % 2(@)(@@) % فغالبني وجدي وشوقي ولوعتي % % ودمعي على السر المكتم قد وشى % % 3(@)(@@) % فشاعت شؤني في البريات كلها % % وسر غرامي بين أهل الهوى فشا % % 4(@)(@@) % أحبك يا طه وحبك مذهبي % % وديني وكم بالوجد قلبي أنعشا % % 5(@)(@@) % يقلبني شوقي إليك على لظى % % وسري بكاسات الهيام قد انتشى % % 6(@)(@@) % شكوت إليك الهجر والبعد بعد أن % % قعدت وركب القوم نحوك قد مشى % % 7(@)(@@) % هو الحب مضن والزمان مخاتل % % ولله تصريف الأمور كما يشا % % PageV01P214 البحر : طويل 1(@)(@@) % إليك رسول الله شكواي إنني % % عبيد دهاني من فنون الهوى غمص % % 2(@)(@@) % وغوثك يا بحر النوال مجرب % % لإكمال مبعود تناهبه النقص % % 3(@)(@@) % وأني مختص بكل رديئة % % وأنت بكل المجد والعز مختص % % 4(@)(@@) % وأنك يا مولاي للخلق رحمة % % بذا في كتاب الله جاء لنا النص % % 5(@)(@@) % تدارك بسر الله لله جانيا % % غدت منه أهوال الحوادث تقتص % % 6(@)(@@) % وقد جذبته النفس طيشا إلى الهوى % % بخدعتها والنفس يا سيدي لص % % 7(@)(@@) % ألا يا إمام المرسلين أغث أغث % % ضعيفا على خوض الذنوب له حرص % % 8(@)(@@) % فإن أنت يا غوثاه داركته 
ms62	 نجا % % وما ضره في ذنبه الخوض والغوص % % 9(@)(@@) % يحل محل البدر عبد قبلته % % غلا ثمنا أو حط قيمته رخص % % 10(@)(@@) % إليك أبا الزهراء وجهت وجهتي % % ونوق المساعي فاترات القوى خمص % % PageV01P215 11(@)(@@) % يراني سميري ضاحك السن لو درى % % يرى الطير مذبوحا ويعجبه الرقص % % PageV01P216 البحر : طويل 1(@)(@@) % رسول الرضا خذ عرض حالي تفضلا % % وأنك يا طه غني عن العرض % % 2(@)(@@) % جعلتك لي درعا وذخرا وموئلا % % وغوثا بهذي الدار يحمى وفي العرض % % 3(@)(@@) % عرفنا بك الامر الإلهي والذي % % بسنتك الغراء صين وبالفرض % % 4(@)(@@) % فقم يا إمام المرسلين بحالنا % % لنحسب ضمن الواردين على الحوض % % 5(@)(@@) % عليك صلاة الله ما ميط مسدل % % على كنزي الإبرام في الأمر والنقض % % PageV01P217 البحر : رمل تام 1(@)(@@) % أعجز المنقبض المنبسط % % بمعان شط منها الخطط % % 2(@)(@@) % وبدا من جامع الشأنين في % % طالع الكونين طور وسط % % 3(@)(@@) % وانجلى في الأفق البحث سنا % % صحف صفت عليها النقط % % 4(@)(@@) % وبدوح الغيب قامت حكم % % صحة ما قام فيها الغلط % % 5(@)(@@) % وبآيات المثاني جوهر % % بأكف الوهم لا تلتقط % % 6(@)(@@) % فوقها منك حبيبي أسدلت % % حجب للحشر لا تنكشط % % 7(@)(@@) % أنت سر الكل والكل له % % منك حبل عاصم مرتبط % % 8(@)(@@) % حار في درك معانيك الورى % % والمدى المقصود عنهم شطط % % 9(@)(@@) % شأنك السيار في درر % % لمعانيها البرايا سفط % % 10(@)(@@) % جل من جلل مجلاك ضيا % % بحواشيه البها يختبط % % PageV01P218 11(@)(@@) % جمع هذا الفرق فرق جمعه % % منه قد دل عليك النمط % % PageV01P219 البحر : طويل 1(@)(@@) % لكل امرء حظ يطيب بحاله % % وحب رسول الله سر الورى حظي % % 2(@)(@@) % يترجم حبيه الفؤاد برمزه % % فيحلو ويكفى في المقام عن اللفظ % % PageV01P220 البحر : كامل تام 1(@)(@@) % ما بين روضة لعلع والأجرع % % ضيعت قلبي من صدود مضيعي % % 2(@)(@@) % وأخذت أندبه فؤادا طالما % % أزعجته بتأوهي وتوجعي % % 3(@)(@@) % وأإن ولهانا بلا قلب وقد % % وقدت لظى ضلعي وفاضت أدمعي % % 4(@)(@@) % يا ريم لعلع قد أضعت متيما % % لسواك نقطة سره لم تفزع % % 5(@)(@@) % بشرا سويا إذ يرى لكنه % % فتت حشاشته بتلك الأربع % % 6(@)(@@) % تدعوه داعية الغرام إلى الحمى % % جذبا بحبل تشوق لم يقطع 
ms63	 % % 7(@)(@@) % فيحن كالخنساء يخطفه النوى % % من مصرع ويحطه في مصرع % % 8(@)(@@) % جبل عليه أنزلت آي الهوى % % يا سعد من للخاشع المتصدع % % 9(@)(@@) % ولقد محت منه الرسوم دموعه % % لهفا لريم في ملاعب لعلع % % 10(@)(@@) % بكت الحجارة رأفة لأنينه % % ما حال ما يبكيه من لم يسمع % % PageV01P221 11(@)(@@) % اهذيم هل من عهد سلع والنقا % % خبر وهل ببدورها من مطمع % % 12(@)(@@) % ظلت تراقب مقلتي من أفقهم % % طرق البروز فغم نسج المطلع % % 13(@)(@@) % اشكو وأحوال الزمان عجيبة % % من هجرهم وشكايتي لم تنفع % % 14(@)(@@) % وعجبت مني كيف أشكو للظبا % % والظبي شيء لا يرق ولا يعي % % 15(@)(@@) % حال يذوب له الحديد تحيرا % % والدهر يلبس حلية المتفجع % % 16(@)(@@) % وعلى معاركه ومر كؤسه الصبر % % الجميل لذوق ما لم يجرع % % 17(@)(@@) % الله حسبي والنبي وسيلتي % % أنعم بأشرف شافع ومشفع % % 18(@)(@@) % غوث الذي انقطعت وسائل أمره % % وذريعة المتوسل المتضرع % % 19(@)(@@) % ألمدح يقصر كيف طال بشأنه % % فاذكره مبتهجا ببيت وأقنع % % 20(@)(@@) % صلى عليه الله ما لمع الضحى % % والبدر غص مقنعا في برقع % % PageV01P222 21(@)(@@) % وعلى بنيه وصحبه ورجالهم % % ما قال ملهوف أبا الزهرا أفزع % % PageV01P223 البحر : طويل 1(@)(@@) % فؤادي إلا عن هواك تفرغا % % ووجهي على باب الجناب تمرغا % % 2(@)(@@) % فدارك حنيني بالقبول فإنني % % أرى الشوق واناري على لوعتي طغى % % 3(@)(@@) % وخذ بيدي يا من نراه تفضلا % % على الناس طرا نعمة الغوث أسبغا % % PageV01P224 البحر : بسيط تام 1(@)(@@) % لله أشكو ذنوبا سودت صحفى % % واقلقتني فيا خوفي ويا لهفي % % 2(@)(@@) % اشكو إلى الله إسرافي على فقد % % اصبحت تحت قيود الذنب والسرف % % 3(@)(@@) % أبكى لحالي إذا راجعت دفتره % % بفكرتي وأراني أي مقترف % % 4(@)(@@) % يطمني الهم حتى لا أرى سبلا % % إلى النجاة وأغدو لقمة التلف % % 5(@)(@@) % أقوم من بطن حوت الوزر ملتجئا % % لجاه روح البرايا كوكب الشرف % % 6(@)(@@) % ذريعتي لجناب الله أجعله % % لأنه علة الاخلاف والسلف % % 7(@)(@@) % ورحمة الله لا وزر يكدرها % % وهمة المصطفى بحر بلا طرف % % PageV01P225 البحر : طويل 1(@)(@@) % محب بأقصى الغرب والقلب في الشرق % % ولم يذر الوجد الملح ولم يبق % % 2(@)(@@) % فيا ليت لا غابت وجوه أحبتي 
ms64	 % % ولا سكن الخفاق من ذلك البرق % % 3(@)(@@) % تناجيهم الروح الولوهة والهوى % % يثير دواعي الحب واللهف والشوق % % 4(@)(@@) % وأين مناجاتي وبيني وبينهم % % حصون تراب والمسالك في غلق % % 5(@)(@@) % يخيلهم فكري لعيني كأنهم % % تجاهي ولكن مثلما الشمس في الأفق % % 6(@)(@@) % أحبة قلبي والفراق بلية % % أغيثوا بلطف الجمع ذبت من الفرق % % 7(@)(@@) % وأنت ايا قلباه أفرطت فاصطبر % % وسلم بما تجري المقادير للحق % % 8(@)(@@) % وإن ضقت ذرعا فأصلح العزم والتجيء % % لأعتاب طه المصطفى علة الخلق % % 9(@)(@@) % إمام النبيين الأعاظم تاجهم % % وسيدهم في طوري الفتق والرتق % % 10(@)(@@) % تقدم كل المرسلين حقيقة % % وفي الحضرة الكبرى له قدم السبق % % PageV01P226 11(@)(@@) % وكان هو المندوب في دولة العلى % % لأعلاء حكم الدين والعدل والصدق % % 12(@)(@@) % تخيره الرحمن من خير خلقه % % فكان كريم الأصل والذات والخلق % % 13(@)(@@) % وأعطاه عزا لا يزول ودولة % % علت وعليها رونق البأس والرفق % % 14(@)(@@) % وقام بسلطان الجمال وطرزه % % فكادت تموت العاشقون من العشق % % 15(@)(@@) % ولما تجلى في نظام جلاله % % غدا القوم مذهولا وآخر في صعق % % 16(@)(@@) % وذياك في دهش الهوى ضمن حيرة % % وذياك مبهوتا تراه بلا نطق % % 17(@)(@@) % عريق صنوف المجد من عهد آدم % % ولله كم سرى طوى الله في العرق % % 18(@)(@@) % نحاضر معناه الكريم فنهتدي % % ونذكر ذاك الوجه طورا فنستسقي % % 19(@)(@@) % ونحيى به من موت كل قطيعة % % ونشهد نور القرب من حضرة الحق % % 20(@)(@@) % نبياه يا غوث المساكين نظرة % % لعبدك والسادات ترأف بالرق % % PageV01P227 21(@)(@@) % عليك صلاة الله والآل كلهم % % وصحبك أهل الجد والوجد والذوق % % 22(@)(@@) % وشبلك جدي ابن الرفاعي أحمد % % أبي العلمين المرتضي علم الشرق % % 23(@)(@@) % بحرمتهم يرجوك غوثا أبو الهدى % % فأنت غياث الخلق من عالم الخلق % % PageV01P228 البحر : متقارب تام 1(@)(@@) % برونق سوح العلى المطلق % % رفعت سما قبة الرونق % % 2(@)(@@) % وأيدت شأن معاني الغيوب % % بجعفر برهانك الأوثق % % 3(@)(@@) % فلولاك قيد بطون الهدى % % لأهل المظاهر لم يطلق % % 4(@)(@@) % ولولاك يا سيد المرسلين % % حديث الحقائق لم يصدق % % 5(@)(@@) % ولولاك مطموس مضمونها % % ببحت العناية لم يشرق % % 6(@)(@@) % ولولاك دائرة البارزات % % بذيل التكون لم تغلق % % 7(@)(@@) % ولولاك مضمار مكنوزها % % اقام 
ms65	 مع العدم المحرق % % 8(@)(@@) % ولولاك أنواع ذراتها % % مع العين في النشيء لم تخلق % % 9(@)(@@) % ولولاك جسم منيع الكمال % % بنبل الإصابة لم يرشق % % 10(@)(@@) % ولولاك عسكرا علم الشؤن % % بألبابنا قط لم يحدق % % PageV01P229 11(@)(@@) % ولولاك ألسن أهل القبول % % بزمزمة الشكر لم تنطق % % 12(@)(@@) % ولولاك مسك معاني الفتوح % % لأهل الحظائر لم يعبق % % 13(@)(@@) % ولولاك موج بحار الرضا % % على حامل الوزر لم يدفق % % 14(@)(@@) % ولولاك نسمة شكل الوجود % % بأنف المظاهر لم تنشق % % 15(@)(@@) % ولولاك ثوب لوا المعجزات % % لدى ساحة الكون لم يخفق % % 16(@)(@@) % ولولاك باب الكريم الرحيم % % بأيدي العواجز لم يطرق % % 17(@)(@@) % ولولاك ذكر الآله العظيم % % وحقك ما دار في منطق % % 18(@)(@@) % ولولاك ما جال معنى الفيوض % % على طارق قط في مطرق % % 19(@)(@@) % ولولاك في بطن نسج الخفا % % بنات المعارف لم تعلق % % 20(@)(@@) % ولولاك طم منار الهدى % % من الجهل والغي في خندق % % PageV01P230 21(@)(@@) % ولولاك بارق صدر العلوم % % بأفق الفهومات لم يبرق % % 22(@)(@@) % ولولاك فجر نظام الظهور % % ووجهك ما لاح في الأبرق % % 23(@)(@@) % ولولاك ما صاح طير القبول % % على غصن بان الحمى المورق % % 24(@)(@@) % ولولاك ظل مدار الوصول % % بفيفاء سينا الخفا المغلق % % 25(@)(@@) % ولولاك ما قام في الكائنات % % مقام لمعنى الهدى الأصدق % % 26(@)(@@) % ولولاك بما حن نحو الحجاز % % قلوب فطارت على الأينق % % 27(@)(@@) % ولولاك ما قر طور الرقو % % بطور على المشهد الأبلق % % 28(@)(@@) % ولولاك أمر الحكيم العليم % % بسبق الإرادة لم يفرق % % 29(@)(@@) % ولولاك يا علة الحادثات % % بها سابق الأمر لم يسبق % % 30(@)(@@) % ولولاك وجه صنوف الفهوم % % بماء حيا العلم لم يعرق % % PageV01P231 31(@)(@@) % ولولاك فتق صحاف العقول % % بخيط المعارف لم يرتق % % 32(@)(@@) % لك العظم المحض قبل الوجود % % فقمت بنمط البها الأشرق % % 33(@)(@@) % ونورك يا شمس كون الأنام % % يشعشع في الغرب والمشرق % % 34(@)(@@) % وخيل عزائمك الطائرات % % إلى حضرة القدس لم تلحق % % 35(@)(@@) % وأنت سبرت ببحر الغموض % % عقود حمى قعره الاعمق % % 36(@)(@@) % وأنت بمشهد جمع الشهود % % فرقت وجمعك لم يفرق % % 37(@)(@@) % وفي موج وحدة أنس الوصال % % غرقت من الرجل للمفرق % % 38(@)(@@) % وحدقت سابح طرف العيان % % فطال سماء العمى 
ms66	 المطلق % % 39(@)(@@) % وحليت رمز معاني الكتاب % % بشكل وفضلك لم يسبق % % 40(@)(@@) % ونسقت آيات مجلى البيان % % بحال لوقتك لم ينسق % % PageV01P232 41(@)(@@) % ومن ماء علمك روض الجلال % % ونبت جمال التجلي سقي % % 42(@)(@@) % واقبل منك مليك الجمال % % يميس بحلة إستبرق % % 43(@)(@@) % ومنك استفاض الندا المرسلون % % وكل ولي تقي نقي % % 44(@)(@@) % نعم أنت علة خلق الورى % % ولولاك ذا الخلق لم يخلق % % 45(@)(@@) % تنظم في آدم العالمون % % فكنت لهم سلك نظم وقي % % 46(@)(@@) % تحدرت من طيهم ناشرا % % لمن جاء منهم ومن قد بقي % % 47(@)(@@) % وقمت على رفرف الإرتقا % % بدرع سنا المظهر الاليق % % 48(@)(@@) % وأطلعت ضمن الهبوط الصعود % % بإنسان آدمها المحدق % % 49(@)(@@) % تخيرك الله من آدم % % فما زلت منحدرا ترتقي % % PageV01P233 البحر : وافر تام 1(@)(@@) % الا يا خير خلق الله إني % % أتيت وصرت في الأعتاب ضيفك % % 2(@)(@@) % فإن هجم العدو علي يوما % % تقلد يا أبا الزهراء سيفك % % PageV01P234 البحر : طويل 1(@)(@@) % بفضلك يا شمس النبيين لا تدع % % رجائي وحاجاتي على ساحل الترك % % 2(@)(@@) % ولا تلوعني نظرة العطف إنني اعتمادا % % على علياك لاو عن الملك % % 3(@)(@@) % وحقق بعطف منك ظني بجودك العظيم % % الذي استولى على العرب والترك % % 4(@)(@@) % فبابك باب الله والفضل واحد % % وإني بهذا الشأن خال من الشك % % 5(@)(@@) % فقل لعدوي مت مع الهم والأسى % % وقل لي بفضل الله أدخلت في سلكي % % PageV01P235 البحر : خفيف تام 1(@)(@@) % يا رسول الرضا بفضلك دارك % % عبد رق يلوذ في ظل دارك % % 2(@)(@@) % غاب من كربه عن الناس طرا % % ووهى منه فكره والمدارك % % 3(@)(@@) % فأغثه بسر قدسك يا من % % أرشد العالمون من إنذارك % % 4(@)(@@) % ولك الجاه والجلالة والعزم % % وأنت الحامي عصابة جارك % % 5(@)(@@) % ولك القوة التي لا تضاهى % % ولك البأس في جميع المعارك % % 6(@)(@@) % لألأ الكون من ضيا نورك المحض % % وخاف الأكوان جذوة نارك % % 7(@)(@@) % أضعف الناس أعظم الناس يدعى % % إن يلاحظه لطف طرف انتصارك % % 8(@)(@@) % أغرق الكائنات بحرك جودا % % والوجود استمد من أنهارك % % 9(@)(@@) % والنبيون والعوالم طرا % % فرع فضل من اصل فيض بحارك % % 10(@)(@@) % وعلوم العرفان في كل طور % % ومقام من منطوى 
ms67	 أسرارك % % PageV01P236 11(@)(@@) % ورسوم الورى ومن حل فيها % % عند كشف الغطاء من آثارك % % 12(@)(@@) % والمعاني التي عن الكشف جلت % % نكتة تستفيض من أطوارك % % 13(@)(@@) % وصدور الأملاك في الملإ الأعلى % % جنود إلى أمير فخارك % % 14(@)(@@) % وجمان البحر الإلهي معنى % % فصلته يد الخفا من نجارك % % 15(@)(@@) % وكنوز الغيب المقدس في طي % % التجلي القدسي في بطن غارك % % 16(@)(@@) % ولك الدولة التي بك دامت % % حيث لله تم محض افتقارك % % 17(@)(@@) % فأغثني وارحم بفضلك فقري % % وتحنن قد ذبت مما أعارك % % 18(@)(@@) % وعليك الصلاة في كل آن % % وسلام يحف روض مزارك % % 19(@)(@@) % وعلى آلك الكرام وصحب % % وعلى التابعين من أنصارك % % PageV01P237 البحر : بسيط تام 1(@)(@@) % يا رب حرت بتفصيلي وإجمالي % % وأوهن الخصم بالبهتان أفعالي % % 2(@)(@@) % صار جسمي بنار اللهم مشتعلا % % وصار خلاني الأحباب أفعى لي % % 3(@)(@@) % يا رب يا سامع الشكوى إليك على % % نقصي ووزري أشكو سؤه أحوالي % % 4(@)(@@) % فرج بلطفك كربي وأحمني كرما % % وأرفع بفضلك مقداري وأقوالي % % 5(@)(@@) % واكشف هموما دهتني ما لها أحد % % سواك يا خالقي يا عالم الحال % % 6(@)(@@) % يسر أموري وكن عوني على زمني % % واحلل عقالي وسهل كل آمالي % % 7(@)(@@) % وألطف بحالي بأسرار الكتاب وبالأملاك % % والمصطفى والرسل والآل % % PageV01P238 البحر : رجز تام 1(@)(@@) % تحركي يا همة الرسول % % بكشف هم الحادث المهول % % 2(@)(@@) % وساعدينا إننا في وجل % % والفرع راجع إلى الأصول % % 3(@)(@@) % ولاحظينا كرما بنفحة % % توصلنا باللطف للمأمول % % 4(@)(@@) % وقابلي حاسدنا بصدمة % % ماحية لشخصه المخذول % % 5(@)(@@) % ودمر به بسهام جردت % % من قلب طه القائل الفعول % % 6(@)(@@) % وأورد به كأس بطش أحمد % % ذي الغيرة العظمى على الدخيل % % 7(@)(@@) % يا همة الرسول لا تنحرفي % % عن حفظنا لطفا ولا تحولي % % 8(@)(@@) % يا همة الرسول جودي رحمة % % لحزبنا بالنصر والقبول % % 9(@)(@@) % يا همة الرسول مدي رأفة % % باع انتصار المصطفى الطويل % % 10(@)(@@) % وداركينا بالحنان والرضا % % تفضلا يا همة الرسول % % PageV01P239 البحر : خفيف تام 1(@)(@@) % كل مدح به تناهى العقول % % وارتضاه المعقول والمنقول % % 2(@)(@@) % وانتهت دونه معالي المعاني % % ذيل مرط به الحري الرسول % % 3(@)(@@) % علم الأنبياء روح البرايا % % أسد الله سيفه المسلول % % 4 
ms68	(@)(@@) % هيكل العلم لوح محفوظ سرا الغيب % % وجه العناية المقبول % % 5(@)(@@) % كنز آيات حكمة ضل عنها % % من له في الورى سواه دليل % % 6(@)(@@) % تبعت هديه النبيون قدما % % ومشى في ركابه جبريل % % PageV01P240 البحر : بسيط تام 1(@)(@@) % أشكو إليك أغث يا سيد الرسل % % يا اشرف الأنبيا يا منتهى الأمل % % 2(@)(@@) % أشكو إليك هموما أوهنت جلدي % % وكربة زاد من أثقالها ذهلي % % 3(@)(@@) % أشكو إليك ذنوبا سودت صحفي % % وصيرتني أسير الخوف والخجل % % 4(@)(@@) % أشكو إليك عيوبا لي فشت ولها % % قيدت يا حسرتي بالوزر والزلل % % 5(@)(@@) % أشكو إليك وقد ضاق الخناق ولا % % يرجى سواك لكشف الخطب والثقل % % 6(@)(@@) % أشكو إليك وأوزاري علي عدت % % غوثاه يا سيد الآتين والأول % % 7(@)(@@) % أشكو إليك وذرعي ضاق وانفصمت % % عرى أصطباري وقلت سيدي حيلي % % 8(@)(@@) % أشكو إليك وهل للمستجير سوى % % علياك يا ركن ظهر الخائف الوجل % % 9(@)(@@) % أشكو إليك ولا أشكو إلى بشر % % سواك ضري وقلبي عنك لم يحل % % 10(@)(@@) % أشكو إليك بأقلام العيوب عنا % % هم الذنوب وشؤم الوهن والكسل % % PageV01P241 11(@)(@@) % أشكو إليك أبا الزهراء داهية % % من الخطايا بشأني ضيقت سبلي % % 12(@)(@@) % أشكو إليك زمانا سأني وعدا % % علي لله يا علامة الازل % % 13(@)(@@) % أشكو إليك وأنت المصطفى وعلى % % أعتاب عزك إني طارح أملي % % 14(@)(@@) % أشكو إليك أعز الله شأنك يا % % خير الأنام على التفصيل والجمل % % 15(@)(@@) % أشكو إليك وما لي من أحط به % % همي ولا من إليه ينتهي سؤلي % % 16(@)(@@) % إشكوو إليك وثوب العيب قنعني % % وقد تجردت عن علمى وعن عملي % % 17(@)(@@) % أشكو إليك ختام المرسلين أعن % % عبدا قطيعا وأحكم حبله وصل % % 18(@)(@@) % أشكو إليك بأفكار مشتتة % % وأدمع بسوى الآثام لم تسل % % 19(@)(@@) % أشكو إليك وفي علياك قد جمعت % % خلال مجد بها معراج كل ولي % % 20(@)(@@) % أشكو إليك وشكوى كل ذي فزع % % لباب عزك أمن قطد لم يزل % % PageV01P242 21(@)(@@) % أشكو إليك وظني سيدي حسن % % ببحر فضلك مأمون من العلل % % 22(@)(@@) % أشكو إليك تداركني فقد بطلت % % مني وسائل قصدي فاصلحن خللي % % 23(@)(@@) % أشكو إليك بعزم كله كسل % % عند الصلاح وفي الآثام كالبطل 
ms69	 % % 24(@)(@@) % أشكو إليك شؤنا أنت تعلمها % % يردني خجلي عنها فلم اقل % % 25(@)(@@) % أشكو إليك بليل طال طائله % % وأسود وجه كحالي جد على ولي % % 26(@)(@@) % أشكو إليك وهذا ما قدرت على % % إيضاحه ولساني ظل في كلل % % 27(@)(@@) % أشكو إليك عليك الله يا أملي % % صلي وسلم ملء السهل والجبل % % 28(@)(@@) % أشكو إليك ورضوان الإله على % % أسباطك الزهر أبناء الإمام على % % 29(@)(@@) % أشكو إليك تحيات الكريم إلى % % أصحابك الغر ما ناداك ذو أمل % % 30(@)(@@) % أشكو إليك أطال الله ركنك في % % حظائر القدس مرفوعا عن المثل % % PageV01P243 31(@)(@@) % أشكو إليك وأهديك السلام فقل % % بشراك نلت الذي ترجو وقل وطل % % PageV01P244 البحر : رجز تام 1(@)(@@) % محمد سر سرارة الأزل % % على فؤاده الكتاب قد نزل % % 2(@)(@@) % محمد هيكل إنسان الهدى % % ومظهر الرحمة والأمر الأجل % % 3(@)(@@) % محمد برهان آيات العما % % وملجأ العانى إذا خاب الأمل % % 4(@)(@@) % محمد سورة فرقان الرضا % % إذ يصرخ الملهوف واسوء العمل % % 5(@)(@@) % محمد مشكاة مصباح العلى % % وبحر فضل كافل لمن سأل % % 6(@)(@@) % محمد حقيقة الأمر الذي % % بالحق للخلق من الحق نزل % % 7(@)(@@) % محمد حمى اللهيف غوثه % % ذخر الضعيف سيد الرسل الأول % % 8(@)(@@) % محمد شمس صفوف الأنبيا % % وتاجهم في كل عصر ومحل % % 9(@)(@@) % محمد سلطان ذرات الورى % % وحصن عبد طم رأسه الزلل % % 10(@)(@@) % محمد لكل كرب فادح % % في هذه الدنيا ومن بعد لأجل % % PageV01P245 11(@)(@@) % محمد هو الحمى لصارخ % % ناداه يا روح الوجودات العجل % % PageV01P246 البحر : طويل 1(@)(@@) % ذنوبي طمت والعفو أولى وأجمل % % ومن ذا الذي يرجى سواك ويسأل % % 2(@)(@@) % بذيلك ذرات الوجود تعلقت % % لأنك يا طه تقول وتفعل % % 3(@)(@@) % ففي هذه الدنيا وفي الحشر واللقا % % على فضلك العالي المنار المعول % % 4(@)(@@) % مقامك محمود وقدرك شامخ % % وشأنك في نشء الحقائق أول % % 5(@)(@@) % وبابك مفتوح لكل مؤمل % % وأنت على كر الدهور المؤمل % % 6(@)(@@) % لك الرفرف المرفوع في حضرة الرضا % % ومن أنت تؤويه فحاشاه يخذل % % 7(@)(@@) % لواؤك منصور وأمرك نافذ % % وتاجك بالنص المضيء مكلل % % 8(@)(@@) % فيا نقطة الجمع التي ضمن فرقها % % شموس براهين الهدى تتهلل % % 9(@)(@@) % بروزك في عين المثال 
ms70	 حقيقة % % وفي طورك الشيطان لا يتمثل % % 10(@)(@@) % منحت وأوضحت المعاني تفضلا % % وأنك نعم المانح المتفضل % % PageV01P247 11(@)(@@) % على طولك السامي الجناح وجاهك العريض % % اعتمادي إذ أروح وأقفل % % 12(@)(@@) % وأنت حمى جاهي ووجهي وموئلي % % وعزي وفي الدارين مجدي المؤثل % % 13(@)(@@) % بذلي إلى أطراف ذيلك التجي % % وأبسط كفي خاشعا أتململ % % 14(@)(@@) % لئن ردني الأغيار بغيا فإنني % % ببابك مقبول الجناب مبجل % % 15(@)(@@) % ولي نسب ينمى إليك عقوده % % بها أهل ميراث العبا تتسلسل % % 16(@)(@@) % تنظم فيه من قريش حجاجح % % بهم قامت العليا تميس وترفل % % 17(@)(@@) % أيهدم بيت أنت أس بنائه % % وتخزى وجوه طورها بك يجمل % % 18(@)(@@) % وحقك حاشا أن يساء عصابة % % محاسنهم عن جفر قلبك تنقل % % 19(@)(@@) % إليك أبا الزهراء طارت سرائر % % وزمت قلوبا بيضها ليس تعقل % % 20(@)(@@) % وناجتك من كن الضمائر ألسن % % فصاح بآيات الضراعة تزجل % % PageV01P248 21(@)(@@) % وقد رفعت بالإنكسار عرائضا % % تصان لها الأعراض فيك وتقبل % % 22(@)(@@) % أبا الطيب الغوث الغياث تكرما % % وعونا فداء القلب بالكرب معضل % % 23(@)(@@) % وأنك يا جد الحسين برمشة % % تقد حبال الكرب والأمر يفصل % % 24(@)(@@) % تدارك رسول الله فضلا فإننا % % بجاهك يا خير الورى نتوسل % % 25(@)(@@) % أتيناك يا سر الوجود خواشعا % % وعن بابك المعمور لا نتحول % % 26(@)(@@) % نناجيك نجوى المستجير أغث أغث % % فطرفك حاشا عن مناجيك يغفل % % 27(@)(@@) % رفعت شراع الحادثات بهمة % % إلهية تعلوا ولا تتنزل % % 28(@)(@@) % وبدرك يا شمس الوجودات لم يزل % % باشرف أبراج العلى يتنقل % % 29(@)(@@) % لك الدولة الأولى لك الصدمة التي % % لها الأرض من أكنافها تتزلزل % % 30(@)(@@) % لك الأمر في حزب النبيين كلهم % % وأنك أعلاهم جنابا وأفضل % % PageV01P249 31(@)(@@) % مقامك ما حاذاه في قبة العما % % برفعته العظمى نبي ومرسل % % 32(@)(@@) % فيا سند العليا ويا عين أهلها % % ويا من إلى أعتابه الفسح يرحل % % 33(@)(@@) % بجاهك عند الله يا سيد الورى % % بما لك من شأن به الخصم يفشل % % 34(@)(@@) % بسر علوم أنت خازن سرها % % حباك معانيها الكتاب المنزل % % 35(@)(@@) % أغثنا وأدركنا فإن قلوبنا % % لها بحمى أبوابك البيض محفل % % 36(@)(@@) % عليك صلاة الله ما انهل صيب % % ولا مس ريحان الرياض القرنفل 
ms71	 % % 37(@)(@@) % وآلك والصحب الكرام جميعهم % % نجوم الهدى من عنهم الدين ينقل % % PageV01P250 البحر : وافر تام 1(@)(@@) % رسول الله عبدك ضاق ذرعا % % وأنت السيد البر الوصول % % 2(@)(@@) % فحاشا أن يسوم الضيم عبدا % % قصير يد وسيلته الرسول % % PageV01P251 البحر : متقارب تام 1(@)(@@) % إلهي ذنوبي بكرب ثقيل % % أتتني وزاد العنا والعويل % % 2(@)(@@) % ففرج كروبي بلطف جميل % % فأنت الإله القوي الجليل % % 3(@)(@@) % وأني العبيد الضعيف الذليل % % 4(@)(@@) % بحرمة خير الورى المجتبى % % وساداتنا الآل أهل العبا % % 5(@)(@@) % وصحب كرام علوا منصبا % % صحاب الحبيب المغيث الدخيل % % 6(@)(@@) % وكل رسول عظيم نبيل % % 7(@)(@@) % بسر معاني الكلام % % القديم وكل ولي نقي كريم % % 8(@)(@@) % بفضل التجلي بليل بهيم % % بحبل التدلي الخفي الطويل % % 9(@)(@@) % بما فيه يشفى غليل العليل % % 10(@)(@@) % بأهل الشهود غياث الطريد % % وكل قريب يقود البعيد % % PageV01P252 11(@)(@@) % بكل مصاب قتيل شهيد % % بسادات بدر حماة النزيل % % 12(@)(@@) % وأهل حنين كنوز الجميل % % 13(@)(@@) % بأهل الركوع وأهل السجود % % وأهل الصيام الكرام الجدود % % 14(@)(@@) % بأهل التصرف في ذا الوجود % % أغثني بلطفك من ذا المهيل % % 15(@)(@@) % فوزري كثير وصبري قليل % % 16(@)(@@) % بهذا العلي العلي الجناب % % أبي الغوث تاج الرجال المهاب % % 17(@)(@@) % رفاعي أهل القبول المجاب % % وسيع الرحاب الشريف الفضيل % % 18(@)(@@) % سلالة طه وآل الخليل % % 19(@)(@@) % إلهي بذنبي رجوعي إليك وشكواي ردت بذلي لديك % % 20(@)(@@) % وكل اتكالي بأمري عليك % % فسامح فجودك جم جزيل % % PageV01P253 21(@)(@@) % وأني فقير وآهي طويل % % 22(@)(@@) % فقد عاقتني الاوزار حتى % % غدوت بطيء مثقلة القفول % % 23(@)(@@) % وأن الوزر منه أسود وجهي % % ومني الحيل أصبح في نحول % % 24(@)(@@) % وقد طم الخطا والإثم رأسي % % وبعد النبل صرت أخا خمول % % 25(@)(@@) % ومن كل الأنام قطعت حبلى % % وصح تعلقي بأبى البتول % % 26(@)(@@) % رسول كله كرم وجود % % وعزم علاه ينهض بالحمول % % 27(@)(@@) % شفاعته تقوم بجبر كسري % % وبعد القطع تثبت لي وصولي % % 28(@)(@@) % الوذ ببابه العالي ومثلي % % يلوذ ببابه زمر الفحول % % 29(@)(@@) % يجار بظله إن جاس خصم % % حمى والحي سور بالنصول % % 30(@)(@@) % وتحصل من عنايته الأماني % % إذا انقطع الظنون من الحصول % % PageV01P254 31(@)(@@) % وكم جعلت خوارقه سلاما % % لظى الأكدار في اليوم 
ms72	 المهول % % 32(@)(@@) % حبيب جاهه جاه عريض % % وسيف قواه يشرف عن فلول % % 33(@)(@@) % له في حضرة الإطلاق جيش % % طلائعه مسومة الخيول % % 34(@)(@@) % تسير به الملائك وهو يعلو % % منارا في الصعود وفي النزول % % 35(@)(@@) % ألا يا رحمة الرحمن يا من % % برى مثلي به نور القبول % % 36(@)(@@) % تداركني عليك الله صلى % % وصحح بالرضا كرما نقولي % % 37(@)(@@) % وأسعفني غدا ببياض وجهي % % وجد بالعفويا أصل الأصول % % 38(@)(@@) % وقل يا نفحة الرحمن زوري % % وقل يا غصة الأحزان زولي % % 39(@)(@@) % إلهي إذا كنت للمحسنين % % فمن لعبيد أتوا مذنبين % % 40(@)(@@) % إلهي بيا ارحم الراحمين % % دعوتك فارحم نداء الخجيل % % PageV01P255 41(@)(@@) % فريد وعنه تنحى الخليل % % 42(@)(@@) % إلهي دعوتك أرجو القبول % % بصدق التوسل فيما أقول % % 43(@)(@@) % ففي حسن ظني وجاه الرسول % % أناجيك نجوى فقير كليل % % 44(@)(@@) % كثير الخطا ما له من مقيل % % 45(@)(@@) % إلهي تصرف بكرب ألم % % بلطفك واصرفه فالهم عم % % 46(@)(@@) % بلوحك يا سيدي والقلم % % وعرشك والمرتضى جبرئيل % % 47(@)(@@) % بتنزيهك خالقي عن مثيل % % 48(@)(@@) % إلهي تفضل بحسن الختام % % ورد القضا بالرضا والسلام % % 49(@)(@@) % وأنعم بقربك يوم القيام % % بمقعد صدق وظل ظليل % % 50(@)(@@) % وتحت لواء الرسول الجليل % % PageV01P256 البحر : وافر تام 1(@)(@@) % إلى كرم الرسول أمد كفى % % وأطلب فضل إحسان الرسول % % 2(@)(@@) % يالائمي في الهوى العذري معذرة % % من ذي وجود تردى بردة العدم % % 3(@)(@@) % مكتوبة بمداد الدمع مرسلة % % مني إليك ولو أنصفت لم تلم % % 4(@)(@@) % عدتك حالي لا سري بمستتر % % لدى الفريق ولا السلوان من شيمي % % 5(@)(@@) % عجزت لا لوعتي تخفى بوارقها % % عن الوشاة ولا دائي بمنحسم % % 6(@)(@@) % محضتني النصح لكن لست أسمعه % % وقد شددت على عهد الهوى حزمي % % 7(@)(@@) % وكيف أصغى لعذالي وإن نصحوا % % إن المحب عن العذال في صمم % % 8(@)(@@) % إني اتهمت نصيح الشيب في عذل % % وانحط حيلي ولكني علت هممي % % 9(@)(@@) % والحيل شاهد حال لا دفاع له % % والشيب أبعد في نصح عن التهم % % 10(@)(@@) % فإن أمارتي بالسوء ما اتعظت % % يا حسرتا بصنوف الوعظ والحكم % % PageV01P257 11(@)(@@) % نفس لقد شطحت طيشا وما انتذرت % % من جهلها بنذير الشيب والهرم % % 12(@)(@@) % ولا أعدت 
ms73	 من الفعل الجميل قرى % % طلائع بسوى الإنذار لم تقم % % 13(@)(@@) % منها تخلل وجهي لو دريت سنا % % ضيف ألم برأسي غير محتشم % % 14(@)(@@) % لو كنت اعلم أني ما أوقره % % بالعلم والحلم والإخلاص والكرم % % 15(@)(@@) % سترته بردا الحناء أو بيدي % % كتمت سرا بدالي منه بالكتم % % 16(@)(@@) % من لي برد جماح من غوايتها % % بجاذب من شؤن الزاجر العزم % % 17(@)(@@) % يردها لطريق الرشد خاشعة % % كما يرد جماح الخيل باللجم % % 18(@)(@@) % فلا ترم بالمعاصي كسر شهوتها % % إذ المعالي بطوع النفس لم ترم % % 19(@)(@@) % عليك سلام ربك ما تهادت % % قوافل قاصديك مع الطلول % % 20(@)(@@) % وما استدعى نداك كسير قلب % % ونال الجبر منك لدى المثول % % PageV01P258 21(@)(@@) % فإنك أنت باب الله حقا % % وأعظم من يؤمل من رسول % % PageV01P259 البحر : بسيط تام 1(@)(@@) % بيني وبين الحمى النجدي أهوال % % ولي بذاك الحمى قصد وآمال % % 2(@)(@@) % مثلي كثير بذياك المقام لهم % % وجد وليس له في الكون تمثال % % 3(@)(@@) % مقام أنس به نور الجلال على % % لوح الجمال انجلى من رقمه حال % % 4(@)(@@) % مطلسم أشرقت من طي رونقه % % شموس علم لها الأبراج أقفال % % 5(@)(@@) % قامت على كثب العرفان ترصدها % % قلوب قوم لهم في الله أفعال % % 6(@)(@@) % معربدون على خيل العزائم في % % بر السلوك لهم رعد وازجال % % 7(@)(@@) % يستعرضون المنايا في كتائبهم % % جحاجح من أسود الله أبطال % % 8(@)(@@) % محجبون رسول الله قائدهم % % إلى المعالي فكم صالوا وكم طالوا % % 9(@)(@@) % يا نعم قوم أبو الزهراء سيدهم % % طه الذي بحره المسجور سيال % % 10(@)(@@) % محمد الأنبيا كنز الحقائق من % % له على الخلق إحسان وأفضال % % PageV01P260 11(@)(@@) % محيي الأنام بروح العدل سيف هدى % % بقاطع الحق فتاك وقتال % % 12(@)(@@) % آيات حكمته في العالمين لها % % فوق المحجة تفصيل وإجمال % % 13(@)(@@) % زهت ببعثته الدنيا فبعثته % % للدين وجه وفي وجه العلى خال % % 14(@)(@@) % محكم فوق كرسي الفخار له % % بأس وفي الكون قوال وفعال % % 15(@)(@@) % أعطاه مولاه طولا لا يزول ففي % % دور الليالي له عز وإجلال % % 16(@)(@@) % يعطي ويمنع والأقدار تسعفه % % رغم الزمان وأن الدهر ختال % % 17(@)(@@) % مبارك الوجه ميمون النقيبة لم % % يبرح به لقطيع 
ms74	 الحظ إيصال % % 18(@)(@@) % يخشى الزمان عبيدا في اريكته % % وللزمان انقلابات وأحوال % % 19(@)(@@) % والفتح يشمل محجوبا دعاه وقد % % أعياه من حجب الأوزار اوحال % % 20(@)(@@) % والنصر يكنف ذل المستجير به % % فلا يناويه إرغام وإذلال % % PageV01P261 21(@)(@@) % صلى عليه إله العرش ما طلعت % % شمس ونال الرضا الأصحاب والآل % % PageV01P262 البحر : طويل 1(@)(@@) % على كل حال لذت والقلب رابض % % بباب إمام المرسلين الاعاظم % % 2(@)(@@) % وصيرت عنوان الخطايا وسيلتي % % لأعتابه مأوى الندى والمكارم % % 3(@)(@@) % فمن بره الإحسان والخير والرضا % % ومن جوده الفياض نيل الغنائم % % PageV01P263 البحر : كامل تام 1(@)(@@) % أخفيت عن قومي لجهلي زلتي % % فبدت لعصياني بحلقي علتي % % 2(@)(@@) % ناديت منكسر الفؤاد بذلتي % % حلقي مسحت بموطئ القدم التي ب % % 3(@)(@@) % شرفت بها الأرض الذلول على السما % % 4(@)(@@) % ولأنت يا جسمي عناك إلى متى % % إني وجدت لك الشفا وأنا الفتى % % 5(@)(@@) % برقعت بالسر المصون بهل أتى % % وبملمس الكف التي فيها أتى % % 6(@)(@@) % إن الذين يبايعونك إنما % % PageV01P264 البحر : بسيط تام 1(@)(@@) % يا سيدي يا إمام المرسلين ومن % % طافت بأعتابه الأعراب والعجم % % 2(@)(@@) % عطفا على وقل أصبحت في دركي % % فإنني بك يا مولاي محترم % % 3(@)(@@) % وصل حبالي ولاحظ بالرضا رحمى % % فأنت أعظم من يرعى له رحم % % PageV01P265 البحر : بسيط تام 1(@)(@@) % مولاي صل وسلم دائما أبدا % % على نبيك رب التاج والعلم % % 2(@)(@@) % مولاي جد بتحيات مباركة % % على حبيبك خير الخلق كلهم % % 3(@)(@@) % أمن تذكر جيران بذي سلم % % أضعت قلبا بغير الحي لم يهم % % 4(@)(@@) % أم من فراق النقا والساكنين به % % مزجت دمعا جرى من مقلة بدم % % 5(@)(@@) % أم هبت الريح من تلقاء كاظمة % % عليلة حملت آثار عطرهم % % 6(@)(@@) % وضج من حاجر رعد بسيرتهم % % وأومض البرق في الظلماء من إضم % % 7(@)(@@) % فما لعينيك إن قلت أكففاهمتا % % لهم وأبرزتا أسرار حبهم % % 8(@)(@@) % وما لهمك إن قلت الفراغ طغى % % وما لقلبك إن قلت استفق يهم % % 9(@)(@@) % أيحسب الصب أن الحب منكتم % % والحب في الصب طور غير منكتم % % 10(@)(@@) % أنى يصح له كتمان لوعته % % ما بين منسجم منه ومضطرم % % PageV01P266 11(@)(@@) % لولا الهوى لم ترق دمعا على 
ms75	 طلل % % معندما رش منك المرط للقدم % % 12(@)(@@) % ولا علقت بأخبار اللوى ولها % % ولا أرقت لذكر البان والعلم % % 13(@)(@@) % فكيف تنكر حبا بعدما شهدت % % أطواره فيك أصناف من الأمم % % 14(@)(@@) % ويوم رمت جحودا قام بينة % % به عليك عدول الدمع والسقم % % 15(@)(@@) % وأثبت الوجد خطى عبرة وضنى % % موشحين من الأشجان بالرقم % % 16(@)(@@) % تفرقا بطراز النعت واجتمعا % % مثل البهار على خديك والعنم % % 17(@)(@@) % نعم سرى طيف من أهوى فأرقني % % وأن عينا كواها البعد لم تنم % % 18(@)(@@) % آنست معنى اللقا من نار فرقته % % والحب يعترض اللذات بالألم % % 19(@)(@@) % ولا توال الهوى ترجو إزالته % % إن الطعام يقوي شهوة النهم % % 20(@)(@@) % والنفس كالطفل إن تهمله شب على % % إهماله باعوجاج غير ذي قوم % % PageV01P267 21(@)(@@) % مثل الرضيع فإن تتركه رعرع في % % حب الرضاع وإن تفطمه ينفطم % % 22(@)(@@) % فاصرف هواها وحاذر أن توليه % % زمام نفسك واصرعها وعظ ولم % % 23(@)(@@) % واجعل جنود الهوى منها مقيدة % % إن الهوى ما تولى يصم أو يصم % % 24(@)(@@) % وراعها وهي في الأعمال سائمة % % وانهض بها إن تراخى عزمها وقم % % 25(@)(@@) % وروحنها على منوال طاقتها % % وإن هي استحلت المرعى فلا تسم % % 26(@)(@@) % كم حسنت لذة للمرء قاتلة % % وأبلعته الزؤام المحض في اللقم % % 27(@)(@@) % تقريه بالدسم المسموم شهوتها % % من حيث لم يدر أن السم في الدسم % % 28(@)(@@) % واخش الدسائس من جوع ومن شبع % % وكن فتى وسطا كالمبصر الحزم % % 29(@)(@@) % وخذ لصلبك لقمات يقمن به % % فرب مخمصة شر من التخم % % 30(@)(@@) % واستفرغ الدمع من عين قد امتلأت % % من رؤية الغير إن الغير كالصنم % % PageV01P268 31(@)(@@) % وارفق بذاتك واشكمها فقد شبعت % % من المحارم والزم حمية الندم % % 32(@)(@@) % وخالف النفس والشيطان واعصهما % % لله وامسك بحبل الله واعتصم % % 33(@)(@@) % واصرع هواك وما أغواك من أمل % % وإن هما محضاك النصح فاتهم % % 34(@)(@@) % ولا تطع منهما خصما ولا حكما % % في زي محتكم أو طور مختصم % % 35(@)(@@) % وحكم الشرع واقمع فيه كيدهما % % فأنت تعرف كيد الخصم والحكم % % 36(@)(@@) % أستغفر الله من قول بلا عمل % % ومن زخارف أقوال بلا شيم % % 37(@)(@@) % نصحت غيري ونصحي عنه بي 
ms76	 عوج % % لقد نسبت به نسلا لذي عقم % % 38(@)(@@) % أمرتك الخير لكن ما ائتمرت به % % وما سعت بي إلى ما قلته قدمي % % 39(@)(@@) % وما تهذب طبعي من كثافته % % وما استقمت فما قولي لك استقم % % 40(@)(@@) % ولا تزودت قبل الموت نافلة % % تعلو بها بين ركبان الحمى هممي % % PageV01P269 41(@)(@@) % ولم اقم سنة من بعد أن طمست % % ولم اصل سوى فرض ولم أصم % % 42(@)(@@) % ظلمت سنة من أحيي الظلام إلى % % أن اقبل الفجر يجلو وجه مبتسم % % 43(@)(@@) % ورأفة قيل طه بالكتاب على % % أن اشتكت قدماه الضر من ورم % % 44(@)(@@) % وشد من سغب أحشاءه وطوى % % عزيمة لسوى الرحمن لم تقم % % 45(@)(@@) % وقام يحمل في قدسي بردته % % تحت الحجارة كشحا مترف الأدم % % 46(@)(@@) % وراودته الجبال الشم من ذهب % % بلابتيها تجاه البيت والحرم % % 47(@)(@@) % كما تراود ذات الخدر سيدها % % عن نفسه فأراها ايما شمم % % 48(@)(@@) % وأكدت زهده فيها ضرورته % % وهو العليم بأن الكرب لم يدم % % 49(@)(@@) % أين الضرورة من سلطان عصمته % % إن الضرورة لا تعدو على العصم % % 50(@)(@@) % فكيف تدعو إلى الدنيا ضرورة من % % له انجلى شكلها من مهمة القدم % % PageV01P270 51(@)(@@) % قامت به وهو قبل الكون علتها % % لولاه لم تخرج الدنيا من العدم % % 52(@)(@@) % محمد سيد الكونين والثقلين % % والقبيلين موصول ومنصرم % % 53(@)(@@) % نبراس باصرة النوعين في الملأين % % والفريقين من عرب ومن عجم % % 54(@)(@@) % نبينا الآمر الناهي فلا أحد % % إلا ومنه له سهم من النعم % % 55(@)(@@) % بدا بحاليه محفوظ الجناب ولا % % أبر في قول لا منه ولا نعم % % 56(@)(@@) % هو الحبيب الذي ترجى شفاعته % % لذي فؤاد كشأني بالذنوب عمى % % 57(@)(@@) % وهو الذي يرقب الملهوف غارته % % لكل هول من الأهوال مقتحم % % 58(@)(@@) % دعا إلى الله فالمستمسكون به % % وافى بهم حضرة الإحسان كلهم % % 59(@)(@@) % رعى لهم ذمة استمساكهم ولهم % % مستمسكون بحبل غير منفصم % % 60(@)(@@) % فاق النبيين في خلق وفي خلق % % في عالم الخلق مذ قاموا بكونهم % % PageV01P271 61(@)(@@) % فلم يساوره في فضل ولا مدد % % ولم يدانوه في علم ولا كرم % % 62(@)(@@) % وكلهم من رسول الله ملتمس % % وبحره العذب ممدود لحزبهم % % 63 
ms77	(@)(@@) % على مراتبهم يعطون نائله % % غرفا من البحر أو رشفا من الديم % % 64(@)(@@) % وواقفون لديه عند حدهم % % ومطرقون لعز فوق علمهم % % 65(@)(@@) % تلوى الأعنة منهم دون رتبته % % من نقطة العلم أو من شكلة الحكم % % 66(@)(@@) % فهو الذي تم معناه وصورته % % فوصفه بانتقاص قط لم يسم % % 67(@)(@@) % والشمس أطلعها وضاع طلعته % % ثم اصطفاه حبيبا بارىء النسم % % 68(@)(@@) % منزه عن شريك في محاسنه % % والخلق فيه حيارى طول دهرهم % % 69(@)(@@) % فرد تعزز عن ند يماثله % % فجوهر الحسن فيه غير منقسم % % 70(@)(@@) % دع ما ادعته النصارى في نبيهم % % ونزه الله حقا عن غلوهم % % PageV01P272 71(@)(@@) % واذكر نبيك أعلى الله منبره % % واحكم بما شئت مدحا فيه واحتكم % % 72(@)(@@) % وانسب إلى ذاته ما شئت من شرف % % ومن فخار ومن فضل ومن همم % % 73(@)(@@) % وانسب إلى يده ما شئت من منن % % وأنسب إلى قدره ما شئت من عظم % % 74(@)(@@) % فإن فضل رسول الله ليس له % % ند ونادبه في الخطب لم يضم % % 75(@)(@@) % ولا لسلطانه الوهاج طالعه % % حد فيعرب عنه ناطق بفم % % 76(@)(@@) % لو ناسبت قدره آياته عظما % % وجانسته على منواله الفخم % % 77(@)(@@) % ومر ذكر اسمه في دارس رمم % % أحى اسمه حين يدعى دارس الرمم % % 78(@)(@@) % لم يمتحنا بما تعي العقول به % % 79(@)(@@) % جلا بحكمته ليل الظنون لنا % % حرصا علينا فلم نرتب ولم نهم % % 80(@)(@@) % أعي الورى كنه معناه فليس يرى % % إلا بعيدا بقرب غير ذي فصم % % PageV01P273 81(@)(@@) % ولم يكن لعلو في حقيقته % % للقرب والبعد فيه غير منفحم % % 82(@)(@@) % كالشمس تظهر للعينين من بعد % % قريبة لشعاع بالعيون رمي % % 83(@)(@@) % تجلى على كبر فيها بمطلعها % % 84(@)(@@) % صغيرة وتكل الطرف من أمم % % 85(@)(@@) % وكيف يدرك في الدنيا حقيقته % % من لم تكن ساعة الأخرى بهمهم % % 86(@)(@@) % وهل يداني معاريج الدنو له % % قوم نيام تسلوا عنه بالحلم % % 87(@)(@@) % فمبلغ العلم فيه أنه بشر % % أقيم من سبحات النور في القدم % % 88(@)(@@) % وأنه علة الأكوان أشرفها % % وأنه خير خلق الله كلهم % % 89(@)(@@) % وكل آي أتى الرسل الكرام بها % % وكل معجزة منهم لقومهم % % 90(@)(@@) % وكل لمعة نور 
ms78	 في حقائقهم % % فإنما اتصلت من نوره بهم % % PageV01P274 91(@)(@@) % فإنه شمس فضل هم كواكبها % % لدى بروج جلت طمطامة العتم % % 92(@)(@@) % اشرقن في النوبة الاولى برونقها % % يظهرن أنوارها للناس في الظلم % % 93(@)(@@) % أكرم بخلق نبي زانه خلق % % مبارك حسن الأوصاف والشيم % % 94(@)(@@) % بمظهر ظهرت آي الجمال به % % بالحسن مشتمل بالبشر متسم % % 95(@)(@@) % كالزهر في ترف والبدر في شرف % % والفجر في مستهل المنظر الوسم % % 96(@)(@@) % والروح في اللطف والأقدار سلطنة % % والبحر في كرم والدهر في همم % % 97(@)(@@) % كأنه وهو فرد من جلالته % % بين الجيوش من الأجناد والخدم % % 98(@)(@@) % تظنه وهو في محراب خشيته % % في عسكر حين تلقاه وفي حشم % % 99(@)(@@) % كأنما اللؤلؤ المكنون في صدف % % والدر منتسق في سلكه النظم % % 100(@)(@@) % يبز ما بين منثور ومنتظم % % من معدني منطق منه ومبتسم % % PageV01P275 101(@)(@@) % لا طيب يعدل تربا ضم اعظمه % % قل للمحبين موتوا في حبيبكم % % 102(@)(@@) % واستنشقوا مسك قبر حل روضته % % طوبى لمنتشق منه وملتثم % % 103(@)(@@) % ابان مولده عن طيب عنصره % % والناس أنموذج عن نوع أصلهم % % 104(@)(@@) % به بدايات أسرار الهدى اختتمت % % يا طيب مبتداء منه ومختتم % % 105(@)(@@) % يوم تفرس فيه الفرس أنهم % % مبدلون بأسر بعد ملكهم % % 106(@)(@@) % وكل قوم طغوا منهم بنعمتهم % % قد أنذروا بحلول البؤس والنقم % % 107(@)(@@) % وبات إيوان كسرى وهو منصدع % % ونار أشياعه أجت بفودهم % % 108(@)(@@) % وكسر دوله كسرى بعد شوكته % % كشمل أصحاب كسرى غير ملتئم % % 109(@)(@@) % والنار خامدة الأنفاس من اسف % % حزنا على أنها شبت لشركهم % % 110(@)(@@) % طم اللهيب بها من عظم ما لطمت % % عليه والنهر ساهى العين من سدم % % PageV01P276 111(@)(@@) % وساء ساوة أن غاضت بحيرتها % % وأهلها خاب منهم حسن ظنهم % % 112(@)(@@) % فشد صادرها إزرا على عطش % % ورد واردها بالغيظ حين ظمى % % 113(@)(@@) % كأن بالنار ما بالماء من بلل % % وفي الهواء أجيج زم من سجم % % 114(@)(@@) % وفي التراب انقلاب عن خميرته % % حزنا وبالماء ما بالنار من ضرم % % 115(@)(@@) % والجن تهتف والانوار ساطعة % % رغما لكل كفور بالضلال عمى % % 116(@)(@@) % والصدق يبرز من بطن الخفا علنا % % والحق يظهر من معنى ومن كلم % % 117 
ms79	(@)(@@) % عموا وصموا فإعلان البشائر لم % % يفدهموا غير محض الطمس والصمم % % 118(@)(@@) % كأن ضجة آيات البشارة لم % % تسمع وبارقة الإنذار لم تشم % % 119(@)(@@) % من بعدما أخبر الأقوام كاهنهم % % وقال عرافهم في قطع حبلهم % % 120(@)(@@) % وراح يجزم منهم كل ذي نظر % % بان دينهم المعوج لم يقم % % PageV01P277 121(@)(@@) % وبعد ما عاينوا في الأفق من شهب % % تنحط ما بين مغموم ومضطرم % % 122(@)(@@) % من ثابتات رأوها في بصائرهم % % منقضة وفق ما في الأرض من صنم % % 123(@)(@@) % حتى غدا عن طريق الوحى منهزم % % يتلوه منقصم من بعد منقصم % % 124(@)(@@) % من كل مسترق للسمع منخذل % % من الشياطين يقفوا إثر منهزم % % 125(@)(@@) % كأنهم هربا أبطال أبرهة % % مذ شتت الشمل منهم صرع فيلهم % % 126(@)(@@) % أو جحفل بتراب كف اعينهم % % أو عسكر بالحصى من راحتيه رمي % % 127(@)(@@) % نبذا به بعد تسبيح ببطنهما % % كالسر ينبذ فيه نطق مكتتم % % 128(@)(@@) % حكى الحصى حينما ذرته راحته % % نبذ المسبح من أحشاء ملتقم % % 129(@)(@@) % جاءت لدعوته الأشجار ساجدة % % سجود معتكف للركن ملتزم % % 130(@)(@@) % وأقبلت ويد الاقدار تجذبها % % تمشى إليه على ساق بلا قدم % % PageV01P278 131(@)(@@) % كأنما سطرت سطرا لما كتبت % % اصولها من معاني بأسه العزم % % 132(@)(@@) % كأنما الأرض لوح زان أسطره % % فروعها من بديع الخط باللقم % % 133(@)(@@) % مثل الغمامة أنى سار سائرة % % بخيمة فوقه من أبهج الخيم % % 134(@)(@@) % تمد ظلا رقيقا فوق منظره % % تقيه حر وطيس للهجير حمي % % 135(@)(@@) % أقسمت بالقمر المنشق إن له % % معنى تضيق له الأرقام بالقلم % % 136(@)(@@) % ونسبة بانشقاق البدر مد لها % % من قلبه نسبة مبرورة القسم % % 137(@)(@@) % وما حوى الغار من خير ومن كرم % % ومن علوم ومن فضل له عمم % % 138(@)(@@) % وما أحاط به من لطف بارئه % % وكل طرف من الكفار عنه عمي % % 139(@)(@@) % فالصدق في الغار والصديق لم يرما % % وليس من صانه الرحمن بالوجم % % 140(@)(@@) % هما بمهد أمان ضمن غارهما % % وهم يقولون ما بالغار من ارم % % PageV01P279 141(@)(@@) % ظنوا الحمام وظنوا العنكبوت على % % حكم الطبيعة لم تبرح لغيهم % % 142(@)(@@) % نعم على غير غار الطهر سيدنا % % خير البرية لم تنسج ولم تحم % % 143 
ms80	(@)(@@) % وقاية الله أغنت عن مضاعفة % % من مثلهم وجيوش فوق جيشهم % % 144(@)(@@) % كفت يد العون عن زرق مصفحة % % من الدروع وعن عال من الأطم % % 145(@)(@@) % ما سامني الدهر ضيما واستجرت به % % إلا وقام بحق الحب والرحم % % 146(@)(@@) % ولا فزعت له من ضيم نائبة % % إلا ونلت جوارا منه لم يضم % % 147(@)(@@) % ولا التمست غنى الدارين من يده % % إلا ورحت ندي الكف بالنعم % % 148(@)(@@) % ولا تشبثت في أذيال دولته % % إلا استلمت الندى من خير مستلم % % 149(@)(@@) % لا تنكروا الوحي من رؤياه إن له % % في الحالتين انطلاق البرق في الظلم % % 150(@)(@@) % يسري بروح حوت في طي قالبها % % قلبا إذا نامت العينان لم ينم % % PageV01P280 151(@)(@@) % فذاك حين بلوغ من نبوته % % وللنبيين هذا في بلوغهم % % 152(@)(@@) % وفي البلوغ رأوه شيخ موكبهم % % فكيف ينكر منه حال محتلم % % 153(@)(@@) % تبارك الله ما وحي بمكتسب % % لكنه محض سر الفضل والكرم % % 154(@)(@@) % فلا رسول مريب في رسالته % % ولا نبي على غيب بمتهم % % 155(@)(@@) % كم أبرأت وصبا باللمس راحته % % أبو البتول وأحيت ميت السقم % % 156(@)(@@) % وقيدت شاردات المجد همته % % وأطلقت اربا من ربقة اللمم % % 157(@)(@@) % وأحيت السنة الشهباء دعوته % % من بعد أن سقطت في وهدة العدم % % 158(@)(@@) % أفاض من نوره فيها فنورها % % حتى حكت غرة في الأعصر الدهم % % 159(@)(@@) % بعارض جاد أو خلت البطاح بها % % هدارة بعريض النيل منسجم % % 160(@)(@@) % كأنما بحجون والصفا ومنى % % سيب من اليم أو سيل من العرم % % PageV01P281 161(@)(@@) % دعني ووصفي آيات له ظهرت % % فضاء للرسل فيها أفق سعدهم % % 162(@)(@@) % جلت بمظهرها للناس يوم بدت % % ظهور نار القرى ليلا على علم % % 163(@)(@@) % فالدر يزداد حسنا وهو منتظم % % وإن تساوى مع المنثور بالقيم % % 164(@)(@@) % لا النظم يعليه قدرا عن حقيقته % % وليس ينقص قدرا غير منتظم % % 165(@)(@@) % فما تطاول آمال المديح إلى % % نعوت سر الوجود الثابت القدم % % 166(@)(@@) % من بعد أن نص آيات الكتاب على % % ما فيه من كرم الأخلاق والشيم % % 167(@)(@@) % آيات حق من الرحمن محدثة % % كالدر نظم في سمط من الكلم % % 168(@)(@@) % مواهب قبل كون الكون بارزة % % قديمة 