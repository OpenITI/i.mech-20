ms141	 غصن اليراع بالتغريد % % 13(@)(@@) % و قريض سلابه كل راو % عن حبيب وشاب رأس الوليد % % 14(@)(@@) % خص في وصف لفظه وبهاه % % بأمين على الورى ورشيد % % 15(@)(@@) % و حمته سطوره بصفوف % زحفت من طروسه ببنود % % 16(@)(@@) % فاذا جرد اليراع فحدث % % عن سطا كفه حديث الجنود % % 17(@)(@@) % يا اخا الفضل لا يعطل في با % % بك جيد ومسمع من عقود % % 18(@)(@@) % أصبح الدهر جنة بك زهرا % % ء فعش في الأنام عيش الخلود % % 19(@)(@@) % لو تصدى عبد الحميد لعليا % % ك للجت أسبابها في الصعود % % 20(@)(@@) % وربا كل ساعة فضلك الج % % م وعبد الحميد عبد الحميد % % PageV01P620 21(@)(@@) % بك فازت يدي وأنجب ظني % % وزكا مقصدي وسار قصيدي % % 22(@)(@@) % كن موتى بنات فكري ولكن % % بعثت من مقامك المحمود % % PageV01P621 البحر : - 1(@)(@@) % حمدت دموعي إذ وفت بوعودها % % فكأن ما في مقلتي في جيدها % % 2(@)(@@) % وتأودت تدعو للذة ضمها % % ما دامت الرقباء طوع هجودها % % 3(@)(@@) % وهممت فامتنعت علي نهودها % % واحسرتا حتى رقيب نهودها % % 4(@)(@@) % سمراء تطعن بالقوام وربما % % نظرت فصالت بيضها مع سودها % % 5(@)(@@) % وقفت عليها لوعتي وصبابتي % % ومدامعي تجري على معهودها % % 6(@)(@@) % لم يبق في زمن الوزير بقية % في الظلم الا ظلمها لعميدها % % 7(@)(@@) % هذا وقد أصبحت في أبوابه % % أدعى وأحسب من عديد عبيدها % % 8(@)(@@) % لاغرو ان نفحت مدائح ناظم % والخضر سار في خلال نشيدها % % 9(@)(@@) % ذو همة رأت المكارم في الورى % % ضيعا فأعجبها افتراع نجودها % % 10(@)(@@) % ومواهب مثل السحائب برة % % يوم الندى لقريبها وبعيدها % % PageV01P622 11(@)(@@) % ومنازل ما بين كفك والغنى % % يا مشتكي الاقتار غير ورودها % % 12(@)(@@) % يتواضع العلماء فيها هيبة % لأعز ممدوح الفعال سديدها % % 13(@)(@@) % ومبشر بالقاصدين كأنه % % وأبيك قاصدها وطالب جودها % % 14(@)(@@) % يلقى العدى وذوي المقاصد والنهى % % بمميتها ومغيثها ومفيدها % % 15(@)(@@) % يا بهجة العليا ونسر صفيها % % وملاذ عاديها وغيظ حسودها % % 16(@)(@@) % أما نفوس عداك من غيظ فقد % % كادت تكون جسومها كلحودها % % 17(@)(@@) % فافخر بنفسك إنها النفس التي % % كملت فما تبغي سوى تأبيدها % % 18(@)(@@) % وتهن بالاعوام نزع خليقها % % مستأنف النعمى ولبس جديدها % % 19(@)(@@) % تجلى أهلتها اليك محبة % فكأنها أهوت 
ms142	 لشكر سجودها % % 20(@)(@@) % و لقد قصدتك شاكيا حر الظما % % فكرعت في عذب الصلات برودها % % PageV01P623 21(@)(@@) % و تقلدت عنقي عطاياك التي % % حكمت في الأيام عن تقليدها % % 22(@)(@@) % فلأ سمعنك ما ترنم صادح % % مدحا يصغر ماضيات وليدها % % 23(@)(@@) % لا ينبغي حر المقال فريده % % إلا على حر الكرام فريدها % % PageV01P624 البحر : - 1(@)(@@) % أهلا بها صحف الامام المسند % % في اليوم مشرقة الثناء وفي غد % % 2(@)(@@) % تختال في ملك البيان حروفها % % وحروفنا من حولها كالأعبد % % 3(@)(@@) % يا نظمها المخدوم بعد نظيمها % % كم خادم لك من صواب مرشد % % 4(@)(@@) % كم في حروفك من عيون فرائد % لكنها لعيوننا كالإثمد % % 5(@)(@@) % أضواؤها وسناؤها ووفاؤها % % للمجتني والمجتلي والمجتدي % % 6(@)(@@) % ورقيمة الالفاظ باكر بابها % % كهف يروح له الثناء ويغتدي % % 7(@)(@@) % من كل قافية لفاغرها فم % عذب اذا ماذقته قلت ازدد % % 8(@)(@@) % وكأن أسماء الذين تجمعوا % % فيها مصابيح تضيء بمسجد % % 9(@)(@@) % فأذن لناظمها وابراهيمها % % تصفى قعودهما بفضل محمد % % 10(@)(@@) % سئلت أجازتنا لهم ولمثلهم % % يروي الاجازة سيد عن سيد % % PageV01P625 11(@)(@@) % ونعم أجزت لهم رواية ما اقتضوا % % بالشرط من لفظ أجزت ومسند % % 12(@)(@@) % ومصنفات لست عنها راضيا % فمسود منها وغير مسود % % 13(@)(@@) % أهملت منها ما أردت وبعضها % % ناديت لا تهلك أسى وتجلد % % 14(@)(@@) % خذها إجازة طائع لك منشد % % للمدح فأعجب للمجيز المنشد % % 15(@)(@@) % واسبقه بالعذر البسيط فإن لي % % هما مديدا إن أقل قال اقصد % % 16(@)(@@) % قلمي ولفظي معرضان كلاهما % % لامن لساني إن نطقت ولا يدي % % PageV01P626 البحر : - 1(@)(@@) % وا وحشتي لمقام منك محمود % % واحسرتي لوداد فيك معهود % % 2(@)(@@) % لو شام طرفك ما ألقاه من حرب % لم تدر من هو منا الهالك المودي % % 3(@)(@@) % إناإلى الله من رزء دنا فرمى % % دمعي وشجوي باطلاق وتقييد % % 4(@)(@@) % يا معرضا عن لقاء الصحب منقطعا % وكان أكرم مصحوب ومودود % % 5(@)(@@) % بالرغم أن أنشد الألفاظ عاطلة % من حلي مدحك أثناء الأناشيد % % 6(@)(@@) % وأن أعوض منثور المدامع عن % % سماع در من الأقوال منضود % % 7(@)(@@) % لم يبق بعدك ذو سجع أعارضه % % الا الحمائم في نوح وتعديد % % 8(@)(@@) % لم يبق بعدك من تدعو بديهته 
ms143	 % % لحج بيت من الأشعار مقصود % % 9(@)(@@) % من للدواوين يقضي بالتأمل في % % مخرج من معانيها ومردود % % 10(@)(@@) % كنا نعدك فردا في موازنها % % لقد رزئنا بموزون ومعدود % % PageV01P627 11(@)(@@) % من للرسائل في لامات أحرفها % % تغزو العداة بألفاظ صناديد % % 12(@)(@@) % من للتصانيف ضمت كل شاردة % % وصححت بعد تبديل وتبديد % % 13(@)(@@) % لله ماذا لجدواها وأحرفها % % من القلائد في سمع وفي جيد % % 14(@)(@@) % سقيا لعهدك من سحاب ذيل تقى % مضى وليس الأذى منه بمعهود % % 15(@)(@@) % عضب اذا رمت زهدا أو حذرت وغى % % أرضاك في ذا وفي هذا بتجريد % % 16(@)(@@) % هي المنية لا تنفك صائدة % نفوسنا بين مسموع ومشهود % % 17(@)(@@) % أين الملوك الأولى كانت منازلهم % % تزاحم البحر في عز وتسييد % % 18(@)(@@) % لم يحمهم سرد داود الذي ملكوا % % من المنون ولا جند ابن داود % % 19(@)(@@) % ايه سقاك شهاب الدين صوب حيا % يكاد يعشب أطراف الجلاميد % % 20(@)(@@) % لو لم تكن بوفاء القصد تسعفنا % % كانت بنوك وفا عن كل مقصود % % PageV01P628 21(@)(@@) % في كل معنى أرى حسناك واضحة % فحسرتي كل وقت ذات تجديد % % PageV01P629 البحر : - 1(@)(@@) % أسكنت قلبي لحدك % % لا خير في العيش بعدك % % 2(@)(@@) % مالدار بعدك عندي % % أرى وإلا فعندك % % 3(@)(@@) % يسيل أحمر دمعي % % لما تذكرت خدك % % 4(@)(@@) % وقد بالهم قلبي % % لما تذكرت قدك % % 5(@)(@@) % ياسائل الدمع إيه % فما أجوز ردك % % 6(@)(@@) % أقصدتني يازماني % % كأنني كنت قصدك % % 7(@)(@@) % وكان ماخفت منه % % فأجهد الآن جهدك % % 8(@)(@@) % لا لينك اليوم أرجو % % ولست أرهب شدك % % 9(@)(@@) % قيضت كف مرادي % % فاقدح بقلبي زندك % % 10(@)(@@) % و راح دينار خد % % عليه كم خفت نقدك % % PageV01P630 11(@)(@@) % عبد الرحيم برغمي % % أن تسقي العين عهدك % % 12(@)(@@) % فأجعل النوم وردي % % في الليل والدمع وردك % % 13(@)(@@) % أشقيت جدي بشكل % بني يا ثكل جدك % % 14(@)(@@) % أبكي فيبكي كأنا % % حمائم النوح بعدك % % 15(@)(@@) % ما كنت أحمل هجرا % فكيف أحمل فقدك % % 16(@)(@@) % و ما تخيلت أني % % أشكو صداك وصدك % % 17(@)(@@) % لهفي عليك لحسن % قد كان أسبل بردك % % 18(@)(@@) % لهفي عليك لعقل % قد كان أحسن عقدك % % 19(@)(@@) % لهفي عليك لثغر % قد كان يفضل عقدك % % 20(@)(@@) % لم 
ms144	 أنس لثمك لما % % أحسست بالموت بعدك % % PageV01P631 21(@)(@@) % و الله لاسمت صبري % % من بعد ما سمت شهدك % % 22(@)(@@) % أف لقلبي إن لم % % يوف بالحزن ودك % % 23(@)(@@) % وقوع بيتي لسن % لم يوف في العمر عدك % % 24(@)(@@) % كنت الهلال لأفق % فعارض الأفق سعدك % % 25(@)(@@) % وكنت فرع نبات % فأذبل الموت وردك % % 26(@)(@@) % و كنت نهر بحار % لو عشت أحييت مجدك % % 27(@)(@@) % و آها لأقلام علم % عدمن يانهر مدك % % 28(@)(@@) % لاغرو إن بات دمعي % % بالري ينجز وعدك % % 29(@)(@@) % أصبحت في الحزن وحدي % % اذ كنت في الحسن وحدك % % 30(@)(@@) % فيا أساي تمرد % % و يا سلوي تمردك % % PageV01P632 31(@)(@@) % و يا حيا الغيث أجزل % % لذابل العطف رفدك % % 32(@)(@@) % و اجعل بكاك عليه % نداك والنوح رعدك % % 33(@)(@@) % فأنت صاحب عهد % فوف للحسن عهدك % % 34(@)(@@) % ويا رحيما دعاه % واصل برحماك عبدك % % PageV01P633 البحر : - 1(@)(@@) % حيت سفرتي من نداك المديد % % وخيل البريد مني المستزيد % % 2(@)(@@) % فيا لك خانية بابها % % إلى الشام يفضي لباب البريد % % 3(@)(@@) % يقول بني إذا ما منحت % % أسيدنا دم لهذي العبيد % % 4(@)(@@) % بوالدنا غيبة ياله % % حبيبا لهم غائبا عن وليد % % 5(@)(@@) % ويشتاق أبناؤه والبنات % % وصاحبة البيت بيت القصيد % % 6(@)(@@) % نأى بيتها ونأى ذهنه % % كما قد نأى عنه بيت النشيد % % 7(@)(@@) % فغث وأغث مغرما وابق ذا % % نوال بسيط وفضل مديد % % PageV01P634 البحر : - 1(@)(@@) % تركت التغزل من أول % % وصيرته بعد مدح مرادي % % 2(@)(@@) % وقالت لي العين ذاك الطعام % % ما كان أبهجه في سوادي % % 3(@)(@@) % أيامن أياديه مشهورة % لدى كل واد وفي كل ناد % % 4(@)(@@) % وما سرق القول فيه الثنا % % فحاشاه من قطع تلك الأيادي % % 5(@)(@@) % أذكر مولاي ما قلت في % % مقاطيع شعر تجوب البوادي % % 6(@)(@@) % عهدت فؤادي ملآن من % % شجون ولا موضع لازدياد % % 7(@)(@@) % إلى أن تعشقت حلو الكنافا % % ت للحلو زاوية في فؤادي % % PageV01P635 البحر : - 1(@)(@@) % خير عيد بكل خير يعود % % لك يا من لقاه للعيد عيد % % 2(@)(@@) % قم لنحر العدى ونحر العطايا % % وابق تسعى إلى حماك الوفود % % 3(@)(@@) % وعدى الفضل ناقصون ولكن % % نحرهم جائز الضحايا مفيد % % 4(@)(@@) % يا إماما له علوم 
ms145	 وجدوى % % كامل بحرها سريع مديد % % 5(@)(@@) % وجوادا الاعيب فيه سوى نع % % مى تعيد الأحرار وهي عبيد % % 6(@)(@@) % لا عدمنا أطواق نعماك فيها % % كل وقت بمدحك التغريد % % 7(@)(@@) % كلنا في محبة ابن علي % يتوالى والجود منه يزيد % % PageV01P636 البحر : - 1(@)(@@) % جميعنا في عشقك البادي % % سواء العاكف والبادي % % 2(@)(@@) % ياقمرا قد سام عشاقه % % خسفا بهجران وابعاد % % 3(@)(@@) % أضلنا الحب ولكن لنا % % نعم الامام الراشد الهادي % % 4(@)(@@) % بهاء دين الله نجل الاولى % % سموا بأنصار وانجاد % % 5(@)(@@) % ذو العلم ألقوه إلى نجلهم % % لا نجل صباغ وحداد % % 6(@)(@@) % في الدين والدنيا لنا بره % % من قبل انشاء وانشاد % % 7(@)(@@) % أنجدنا جودا فأمداحنا % % ما بين إتهام وإنجاد % % PageV01P637 البحر : - 1(@)(@@) % دانت لك الدنيا وملت لأرغد % % دارين في يوم تزف وفي غد % % 2(@)(@@) % يا تاج دين الله والدنيا الذي % % لاقت مكانته بفرق الفرقد % % 3(@)(@@) % لله مالغز به غزلية % سجدت لها الدالات نوع تعبد % % 4(@)(@@) % شهد اللسان بها لفاتحة فما % عذبا اذا ماذقته قلت ازدد % % 5(@)(@@) % من كل قافية تقوم لكل ذي % % ديوان نظم قبلنا بمجلد % % 6(@)(@@) % هل دافع همي فأنشد بحرها % % يا نيل مصر قد أتيت بمفرد % % 7(@)(@@) % هل غير قولي قائم بصفات ما % % قد قلت يا ابن علي لا ومحمد % % PageV01P638 البحر : - 1(@)(@@) % تنهدت لما أذكرتني النواهد % زمان الصبى والعيش ريان مائد % % 2(@)(@@) % وغيداء أما عيبها ردفها % % ثقيل وأما ثغرها فهو بارد % % 3(@)(@@) % بأغزال شعري في بديع صفاتها % % ومدح رئيس الشام تسري القصائد % % 4(@)(@@) % رئيس وفى حق المعالي فحبذا % % مهيب وهوب شامل الجود زاهد % % 5(@)(@@) % له قلم في صدر محراب درجه % % لباريه في كل المقاصد ماجد % % 6(@)(@@) % كريم الورى يا ابن الكرام اذا انتمى % % ليهنك عيد للسعود معاود % % 7(@)(@@) % كذا ألف عيد شرف اسمك زينه % % وهنئت الدنيا بأنك خالد % % PageV01P639 البحر : - 1(@)(@@) % قف بالحمى بعد البدور وناد % % أرأيت كيف خبا ضياء النادي % % 2(@)(@@) % ومحامل ظعنت بمهجة ناحل % % أرأيت من حملوا على الأعواد % % 3(@)(@@) % لو رمت أن أفدي الحبيب بمهجتي % % وهو الأصح وفاد كنت الفادي % % 4(@)(@@) % هيهات يعدل ما ضيا ماقر لي 
ms146	 % % طرف وجنة مهجتي بسواد % % 5(@)(@@) % أما سواد الليل فهو كما ترى % % طرف المنام على الدوام سهادي % % 6(@)(@@) % بكرت على مثواك أدمع نائح % % كالنيل ذات وفا وذات منادي % % 7(@)(@@) % سخنت كحمام عليك مدامعي % % لما رزئت بكوكب وقاد % % PageV01P640 البحر : - 1(@)(@@) % الكاس في كف غادة رود % % قم يا أخا النسك غير مطرود % % 2(@)(@@) % تحثها بالغناء غانية % تعرب فيه عن لحن داود % % 3(@)(@@) % ان شئت كالغصن ذات منعطف % % أو شئت كالطير ذات تغريد % % 4(@)(@@) % تكاد ان مس عودها يدها % % تجري مياه الدلال في العود % % 5(@)(@@) % سادت بحسن ونعمة فلذا % % قد صح قول الورى لها سودي % % 6(@)(@@) % يا حبذا كأسها وروض حمى % % بأنعم القطر حالي الجيد % % 7(@)(@@) % كلتاهما جملة الجمال فما % % بدر الدجى عندها بمعدود % % 8(@)(@@) % بل حبذا غادة وغانية % % في الحسن كالحرف ذات تشديد % % 9(@)(@@) % تثني شذاه على الغمام كما % % تثني على سادتي أناشيدي % % PageV01P641 البحر : - 1(@)(@@) % حاشاك يا عارض المكارم من % % عارض بأس يضني وتنكيد % % 2(@)(@@) % قم للعلى والعلوم مشتملا % ثياب سراء ذات تجديد % % 3(@)(@@) % يعتل عنك النسيم سائره % % وتحمل السقم أعين الغيد % % 4(@)(@@) % أنت الذي خبره ومنظره % % آذن أمداحنا بتسديد % % 5(@)(@@) % سرت لمغناك من مآربنا % % نجائب فاستوت على الجودي % % PageV01P642 البحر : - 1(@)(@@) % ألا في سبيل الله فرع كتابة % ثنته المنايا وهو ريان مائد % % 2(@)(@@) % وكوكب فضل قدره قد سما به % % إلى أن بكى حزنا عليه عطارد % % 3(@)(@@) % ودينار وجه غاله صرف دهره % % سريعا كأن الصرف للباس ناقد % % 4(@)(@@) % وعيشك يا يحيى لوانك تفتدي % % لهنئت الدنيا بأنك خالد % PageV01P643 البحر : - 1(@)(@@) % رحلت اليك ركائب ومدائح % فإليك يقصد راغب ويقصد % % 2(@)(@@) % سعدت بك الأرض التي وليتها % % من بعد ما أمست بغيرك تكمد % % 3(@)(@@) % واذا نظرت إلى البقاع وجدتها % % تشقى كما تشقى الرجال وتسعد % % PageV01P644 البحر : - 1(@)(@@) % الا لله ما أزكى فعالا % وأقوالا وما أجدى وأندى % % 2(@)(@@) % رقيت إلى النجوم فجئت منها % % بأحسن صورة تهدي وتهدى % % 3(@)(@@) % ولما أن بعثت بها نثارا % نظمنا من حلاها المدح عقدا % % PageV01P645 البحر : - 1(@)(@@) % يا سيدي قل لي ما طائفة % يثني عليها غائب وشاهد 
ms147	 % % 2(@)(@@) % لله ما أيمنها في غربة % % ترجى وما أبركها ياقاصد % % 3(@)(@@) % تنوع القول فقيل أربع % حروفها وقيل حرف واحد % % PageV01P646 البحر : - 1(@)(@@) % وما صامت يمضي ويرجع حائرا % ويقضي على أوصاله الوصل والصد % 2(@)(@@) % كأن الأسى آلى عليه ألية % فما فيه إلا النفس والعظم والجلد % % 3(@)(@@) % وأحرفه خمس على أن شطره % % ثلاثة أخماس الحروف التي تبدو % % PageV01P647 البحر : - 1(@)(@@) % أهلتني للعتب حتى لقد % % لذ لسمعي وهوصعب شديد % % 2(@)(@@) % ورحت لو زادت دموعي عسى % % عتابك الحلو لسمعي يزيد % % 3(@)(@@) % هذا ولو قطعتني لذ لي % % وسرني أني ببدر شهيد % % PageV01P648 البحر : - 1(@)(@@) % أمولاي شمس الدين دمت مهنئا % ودمت كريما شاهد الذكر سائدا % % 2(@)(@@) % نرى الفضل يغنى عن أناس وإنما % % لك الفضل يحيى يا ابن جعفر خالدا % % PageV01P649 البحر : - 1(@)(@@) % شكرا لمولانا الذي قال في % % ثنائه الواصف قولا سديد % % 2(@)(@@) % أقسم أن الوقت وقت صفا % % وان هذا النشو نشو سعيد % % PageV01P650 البحر : - 1(@)(@@) % أتيتك يا أزكى البرية جامعا % لأمرين في يوم من الدهر وافد % % 2(@)(@@) % هنى وعزا لا عتب فيه لأنني % % أهني بعشر إذ أعزي بواحد % % PageV01P651 البحر : - 1(@)(@@) % أفديه أعمى مغمدا لحظه % % ليرتعي في خده الوردي % % 2(@)(@@) % تمكنت عيناي من وجهه % % فقلت هذي جنة الخلد % % PageV01P652 البحر : - 1(@)(@@) % وافت أصابع نيلنا % % وطمت فأكمدت الأعادي % % 2(@)(@@) % وأتت بكل جميلة % % ماذي أصابع ذي أياد % % PageV01P653 البحر : - 1(@)(@@) % قل للكرام الكاتبين من الورى % % مالي أجرب عهدكم وأعود % % 2(@)(@@) % مالي مرضت فلم يعدني عائد % منكم ويمرض كلبكم فأعود % % PageV01P654 البحر : - 1(@)(@@) % عذلوني في هوى أغيد قد % % زاد أشجاني وفي تركي لغاده % % 2(@)(@@) % ثم قالوا عن سليمى لا تحل % % قلت محبوبي سليمى وزياده % % PageV01P655 البحر : - 1(@)(@@) % سقى الله جسما منك أودى به الضنى % % فأودى بعيني البكى والتسهد % % 2(@)(@@) % وقد كان مسلولا يهيج حسرتي % % فكيف به تحت الثرى وهو مغمد % % PageV01P656 البحر : - 1(@)(@@) % وصلتنا ديوك برك تزهو % % بوجوه جميلة مستجاده % % 2(@)(@@) % كل عرف يروق حسنا واني % % أرتجي أن تكون عرفا وعاده % % PageV01P657 البحر : - 1(@)(@@) % أهلا بأوفى الورى وأقوى % % أياديا في الندى وأندى % % 2(@)(@@) % نحب بيروت إذ نراه % % وإن يغب لا نحب 
ms148	 صيدا % % PageV01P658 البحر : - 1(@)(@@) % نعم الدواة حكت بيض الظبا فلها % % بين الممالك تمهيد وتشييد % % 2(@)(@@) % كأن أقلامها منها منضلة % فلم يفتها إلى الأغراض تسديد % % PageV01P659 البحر : - 1(@)(@@) % بلد بعد الذكاء ذهني % % تشتت الرزق في البلاد % % 2(@)(@@) % فغير مستنكر حمار % أهدى حزاما إلى جواد % % PageV01P660 البحر : - 1(@)(@@) % برغم العدى إنا فقدناك أوحدا % اذا اجتمعت أرباب فضل وسؤدد % % 2(@)(@@) % دعتك المنايا فاقتفيت سبيلها % % وتلك سبيل لست فيها بأوحد % % PageV01P661 البحر : - 1(@)(@@) % تركتني بالوعود أسعى % % وما على حالتي سعاده % % 2(@)(@@) % وكل قود سألت منه % % يقول لي رح بلا قياده % % PageV01P662 البحر : - 1(@)(@@) % مضيت وقد كانت لمن أنت عنده % % مصائد نرجو نفعها ونطارد % % 2(@)(@@) % فأصبح يبكي والمجر الذي خلا % % ومثلك من تبكي عليه المقاود % % PageV01P663 البحر : - 1(@)(@@) % معنى الفضائل والندى والبأس لي % % والسيف مشتهر بمعنى واحد % % 2(@)(@@) % بالنفس أضرب في نضار ذائب % والسيف يضرب في حديد بارد % % PageV01P664 البحر : - 1(@)(@@) % أرى الشعراء مضوا سوقة % % ولابن سنا الملك ملك عتيد % % 2(@)(@@) % وقد طوبقوا باسمه في القريض % % فمنهم شقي ومنهم سعيد % % PageV01P665 البحر : - 1(@)(@@) % روت عيني التسهد عن قتاده % % ومن لوني وسقمي عن جراده % % 2(@)(@@) % ومن عذل العذول عن انتقاص % % ولكن من هواكم عن زياده % % 3(@)(@@) % حماه لحيكم وثنا ابن يحيى % % كلا السندين يروى عن حماده % % 4(@)(@@) % بليغ مع وزارته وقاض % % بأعناق الانام له شهاده % % 5(@)(@@) % حمى العليا بفضل فاضلي % زكا وذكا وأوغل في السياده % % 6(@)(@@) % يسابق كل يوم قاصديه % % بعادي خيره والخير عاده % % 7(@)(@@) % دعونا بره شاما ومصرا % % فواصل في الافاءة والافادة % % PageV01P666 البحر : - 1(@)(@@) % أعد لنا السمر الاشهى نجدده % % دار النحاس ونادي الشط والنادي % % 2(@)(@@) % ترى سفائنه كالعيس سائرة % % والضب والنون والملاح والحادي % % 3(@)(@@) % و روضة العيش في العلياء آنفة % % ما واصلت بين إتهام وإنجاد % % 4(@)(@@) % ثلاثة تعطف الدنيا علي بها % % أوطان أنسي وأحبابي وأعيادي % % 5(@)(@@) % ليهنك العيد يا عيدا ويا سندا % % للعالمين رووا في الحمد إسنادي % % 6(@)(@@) % مفطرا فم وفد أو كبود عدى % % يا بعد ما بين أفواه وأكباد % % 7(@)(@@) % نعم بدا فضل مولانا وعارضه % % جهد الثناء وكان الفضل للبادي % % PageV01P667 البحر : - 1 
ms149	(@)(@@) % كذا أبدا نلتقي كل عيد % % بسعد جديد وجد سعيد % % 2(@)(@@) % لك الله من وافر بحره % % بفضل بسيط وظل مديد % % 3(@)(@@) % و خير عماد أعادت علاه % % وأعلت قواعد بيت مشيد % % 4(@)(@@) % لو ان بيوت العلى نظمت % % لأصبح بيتك بيت القصيد % % 5(@)(@@) % يقول الثنا فيه إما سجعت % % فانك طوقت بالجود جيدي % % 6(@)(@@) % فيالك من عيد نحر هناه % % يقول لأبيات مدح أعيدي % % 7(@)(@@) % تنظم فيه عقود الثناء % % وفي البحر يحسن نظم العقود % % PageV01P668 البحر : - 1(@)(@@) % رب عيش واصلتنا فيه غيد % % أنا عبد عربي فيها سعيد % % 2(@)(@@) % تعمر الأبيات حسنا إذ به % % وثنا الممدوح قد شيد القصيد % % 3(@)(@@) % يا أمينا بالتقى معتضدا % فهو مهدي وهاد ورشيد % % 4(@)(@@) % هكذا كل الليالي موسم % في حماك الرحب والأيام عيد % % 5(@)(@@) % من نداك الجم والعلم معا % لك بحران بسيط ومديد % % 6(@)(@@) % و لقد أشكو لبعض الناس في % % ليلة النصف كما يشكوالوحيد % % 7(@)(@@) % قاسموني خطيتها عنتا % فيهم الحلوى وفي قلبي الوقود % % PageV01P669 البحر : - 1(@)(@@) % جرى دمعي إلى ولدي وأهلي % % فقالت مصر نيلي في الزياده % % 2(@)(@@) % فكف دموع عينك عن بلادي % % والا كن فتى يمضي بلاده % % 3(@)(@@) % فقلت أريد تسفيرا وزادا % فقالت لي بزائدها وزاده % % 4(@)(@@) % أليس علاء دين الله أعطى % % فقلت وصبحة يعطي وعاده % % 5(@)(@@) % و جاها فاتحا بابي مزيد % % سرى ومجاورا باب السعادة % % 6(@)(@@) % بفضلك يا ابن فضل الله عادت % % وعاد حديثها أهل السيادة % % 7(@)(@@) % روت عن قرة عين تراكم % % وعين الضد تروي عن قتاده % % 8(@)(@@) % تذكر أهله وبنيه صب % نوى سفرا ولله الإرادة % % 9(@)(@@) % و صور فكره للبين ركبا % فبادر جفن عينيه المزاده % % 10(@)(@@) % و مثلي من بكى لفراق باب % علائي الفعال المستجاده % % PageV01P670 11(@)(@@) % جواري الأفق تخدم زائريه % % بتوفيق وتتبعهم سعاده % % 12(@)(@@) % فيامن لم أزل أحظى لديه % % بفضل جامع باب الزياده % % 13(@)(@@) % بقيت ممدحا في كل ناد % مدائح كلها وسطى القلاده % % 14(@)(@@) % فما ذكري حبيب لها بباك % % ولا عبث الوليد أبا عباده % % 15(@)(@@) % وزير الملك دمت لنا ملاذا % مديد الظل مبسوط السعاده % % 16(@)(@@) % عوائد جاهه وعطاه تأتي % % فيالك صبحة 
ms150	 تأتي وعاده % % 17(@)(@@) % و يالك عادة من بيت جود % ومنا في مدائحهم شهاده % % 18(@)(@@) % إذا سفرا قصدنا أو مقاما % فإن قرى الفتى منه وزاده % % 19(@)(@@) % فيا فخر الوزارة يا ختاما % لها ياذا المحاسن والإفاده % % 20(@)(@@) % فهذا البيت جامع عين بر % وباب صلاته باب الزياده % % PageV01P671 21(@)(@@) % بقيت لعادة في الجود منكم % % ومنا في مدائحكم شهاده % % PageV01P672 البحر : - 1(@)(@@) % عسى لعليل الجسم طيفك عائد % % كريم اللقا والمكرمات عوائد % % 2(@)(@@) % لقد حج في الطيف بالوصل مرة % % فهل هو في حج الوصال معاود % % 3(@)(@@) % ألا إنني في الحب يا ظبية النقا % % كما في العلا بن القيس اني واحد % % 4(@)(@@) % شريف مسماه الممدح واسمه % % وشائد بيت المدح والمنح سائد % % 5(@)(@@) % تهن به حج القبول ودعوة % % عليها لأنوار القبول شواهد % % 6(@)(@@) % تقول لهاتيك المناسك مرحبا % بكم يا بني مخزوم حين تشاهد % % 7(@)(@@) % لقد شرفت ناس وبادت وانما % % لكم شرف في سائر الناس خالد % % PageV01P673 البحر : - 1(@)(@@) % روحي فدآء مهفهف مياد % % حلو قد استعذبت فيه سهادي % % 2(@)(@@) % قالت محاسنه لكل متيم % للحلو زاوية بكل فؤاد % % 3(@)(@@) % هنئت بالعيد الرضى يا عيده % % يا واحد العلماء والزهاد % % 4(@)(@@) % في ري صاد بالندى لك فكرة % وسرى لأفصح ناطق بالضاد % % 5(@)(@@) % و العبد قد وافى الشتاء وجسمه % % قد سابق الإبراق بالإرعاد % % 6(@)(@@) % ان أخرت بيروت عود جوادها % % فنداك يدعونا لخير جواد % % PageV01P674 البحر : - 1(@)(@@) % بفيت بقا الايام للفضل خالدا % وهن الورى في العلم والجود واحدا % % 2(@)(@@) % ولا عدم الحال الضعيف موافيا % لديك بأنواع اللهى وعوائدا % % 3(@)(@@) % و لا زلت بالأقلام والحلم زائدا % تظل بها عن حوزة الدين ذائدا % % 4(@)(@@) % و حقك لو جاء الغمام بشامة % يساجل كفيك الندى جاء واردا % % 5(@)(@@) % و لو أن فيض النيل باراك في العطا % % بمصر لما استحلت له الناس زائدا % % PageV01P675 البحر : - 1(@)(@@) % عاد الركاب لراجيه وقد خطرت % % ذكرى الغمام وذكرى النيل في الجود % % 2(@)(@@) % فقلت يا نيل حمل غير مطرد % ويا غمام تفضل غير مطرود % % 3(@)(@@) % هذا ابن إسحاق تنجينا براحته % % أقلامه الحمر في أحوالنا السود % % 4(@)(@@) % تفاحة العرف 
ms151	 نجنيها وتطربنا % % فيا أثيلاتها بوركت من عود % % PageV01P676 البحر : - 1(@)(@@) % أشكو إلى الله لا إلى أحد % % فما عدا قتل لوعتي أحدا % % 2(@)(@@) % أغيد لو مزق الضنى جسدي % % ما حال بي عن غرامه أبدا % % 3(@)(@@) % منفرد الحسن لا نظير له % % صيرني في الغرام منفردا % % 4(@)(@@) % يا ليته بالصدود يوعدني % % لأنه لا يفي بما وعدا % % PageV01P677 البحر : - 1(@)(@@) % يا خاتم الوزراء الأكرمين ويا % % أوفى ذوي الفخر في العلياء توكيدا % % 2(@)(@@) % و يا مؤيد في قول وفي عمل % توقيع عبدك يرجو منك تأييدا % % 3(@)(@@) % عسى تقلده برا ومكرمة % فيغتدي ذلك التوقيع تقليدا % % PageV01P678 البحر : - 1(@)(@@) % هناء بالصيام وما يليه % % من الأعياد في رتب السعاده % % 2(@)(@@) % تزاوج بين أجر أو ثناء % % بوارد ما تشاء من السياده % % 3(@)(@@) % و أرجو أن يعاد سقيم حظي % % لدرجي فهو محتاج العياده % % PageV01P679 البحر : - 1(@)(@@) % برغمي بنات الروم حزنا رقابها % % وحال الهوى بالشيب والهم فاسد % % 2(@)(@@) % تبكي عليهن البطاريق في الدجى % % وهن لدينا ملقيات كواسد % % 3(@)(@@) % أما والصبى إني أعف بفقده % % وإن ضجيع الجود مني لماجد % % PageV01P680 البحر : - 1(@)(@@) % تهن بشهر مضيء الليال % % بلغك الله اسعادها % % 2(@)(@@) % ترود بمغناك فيه العفاة % % وتلقى العدى منك أنكادها % % 3(@)(@@) % فهذي تفطر افواهها % % وهذي تفطر أكبادها % % PageV01P681 البحر : - 1(@)(@@) % سر على اليمن والهنا حيثما سر % % ت ليلقاك فيه وجه سعيد % % 2(@)(@@) % أنت نعم المأمون للملك تحمي % % سرجه كاتبا ونعم الرشيد % % 3(@)(@@) % ان يكن بيتك الطويل فخارا % إن بيت الثنا عليك مديد % % PageV01P682 البحر : - 1(@)(@@) % إليك أخا العلياء دعوة لائذ % بمعروفك المعروف قد راح واغتدى % % 2(@)(@@) % نباتي حمد ذا بنين وذا أب % % جميعا يرجى من أياديك موعدا % % 3(@)(@@) % فقل في نبات أصله وفروعه % % مواثل ترجو من سحائبك الندى % % PageV01P683 البحر : - 1(@)(@@) % قد آثر القوم من بيروت همهم % وضاعفت سكراتي وقفة النقد % % 2(@)(@@) % لي سكرتان وللندمان واحدة % % شيء خصصت به من دونهم وحدي % % 3(@)(@@) % الغوث يا من اليه قد مددت يدي % % ثم اقتدحت فاورى بالثنا زندي % % PageV01P684 البحر : - 1(@)(@@) % هنئت بالصوم السعي % % د وألف صوم بعده % % 2(@)(@@) % في نعمة وسيادة % % تسع الولي وضده % % 3 
ms152	(@)(@@) % هذا يفطر فاه أو % % هذا يفطر كبده % % PageV01P685 البحر : - 1(@)(@@) % شكر الله أياديك التي % % كل يوم أتلقى رفدها % % 2(@)(@@) % سر أولادي حتى أمهم % % مثلما سر أبوهم بعدها % % 3(@)(@@) % و أقيمت عندها الحرمة بل % % قام مني كل شيء عندها % % PageV01P686 البحر : - 1(@)(@@) % صديقي بل سيدي لا برحت % % مفيد الصداقة وافى السياده % % 2(@)(@@) % و لا زلت للجامع المجتبي % % تفتح للخير باب الزياده % % 3(@)(@@) % فمنك العمالة مشهودة % % بفعل الجميل ومنا الشهاده % % PageV01P687 البحر : - 1(@)(@@) % تكفل لي جود أندى الورى % % وشاع به الذكر في كل واد % % 2(@)(@@) % و والله ماخفت تغيير ما % % تعودت من بره المستفاد % % 3(@)(@@) % إذا غير الدهر حسن الذوات % % فحاشا محاسن ذات العماد % % PageV01P688 البحر : - 1(@)(@@) % لك الله ما أزكى وأشرف همة % % وأحمد صنعا حيث تتلى المحامد % % 2(@)(@@) % لعمري لقد خلدتها شرفية % % تضيء وتبقى حين تبلى الفراقد % % 3(@)(@@) % و أنت الذي قرت برؤيته العلى % % وهنئت الدنيا بأنك خالد % % PageV01P689 البحر : - 1(@)(@@) % لي في الأصادق خائن % % في المال مني والوداد % % 2(@)(@@) % فمتى أراه وخلفه % % عات من الأقوام عاد % % 3(@)(@@) % و نداؤه هذا جزا % فأقول قد صدق المنادي % % PageV01P690 البحر : - 1(@)(@@) % أيا ملكا من بعض أوصاف مجده % % كريم السجايا عادل الحكم زاهد % % 2(@)(@@) % تهن بعيد النحر وابق ممتعا % بأمثاله ما طاف بالبيت وافد % % 3(@)(@@) % تقلدنا فيه قلائد أنعم % % وفي النحر أولى ما تكون القلائد % % PageV01P691 البحر : - 1(@)(@@) % و أدهم رهوال بقرية أربد % % شلت له الأحمال بالرجل واليد % % 2(@)(@@) % و فارقته أبكي عليه حقيقة % % بكاء لبيد يوم فرقة أربد % % PageV01P692 البحر : - 1(@)(@@) % شكت وقد سارقتها قبلة % يا بردها في كبدي الواقده % % 2(@)(@@) % و قال قوم رشفة أغضبت % % فقلت هذي غضبة بارده % % PageV01P693 البحر : - 1(@)(@@) % نبي الهدى في موقف الحشر شافعي % % وهذا الأمير اليوم في العام منجد % % 2(@)(@@) % فيافوز آمالي وفوزي إذا غدا % % شفيعي في هذا وهذا محمد % % PageV01P694 البحر : - 1(@)(@@) % ياذا الندى السعدي دمت مهنئا % ببسيط مدح كامل ومديد % % 2(@)(@@) % جمع اهتمامك في صحابة مصرنا % % تذكار سعد صحابة وسعيد % % PageV01P695 البحر : - 1(@)(@@) % يا دولة الحسن كم بدا بشر % منعم القلب فيك والجسد % % 2(@)(@@) % و عادل 
ms153	 القد في تعانقنا % % يجمع بين الغزال والأسد % % PageV01P696 البحر : - 1(@)(@@) % و الله ما عجبي لقدرك انه % % قدر على باغي مداه بعيد % % 2(@)(@@) % الا لكونك لست تشكو وحشة % % في هذه الدنيا وأنت وحيد % % PageV01P697 البحر : - 1(@)(@@) % رعى الله من جاورت في مصر بابه % % فقابلني بالمال والجاه والود % 2(@)(@@) % هو العلم الفرد الذي شاع فضله % فبشراكم يا جيرة العلم الفرد % % PageV01P698 البحر : - 1(@)(@@) % فديتك سيفي اللواحظ كاتبا % ومثلك من يفدى ومثلي من يفدي % % 2(@)(@@) % بنانك بالقبطي في اللوح كاتب % ولحظك في الأكباد يكتب بالهندي % % PageV01P699 البحر : - 1(@)(@@) % قالوا ذقون الملاح باردة % % منكرات قلت اهدر وانكدي % % 2(@)(@@) % يا حر قلبي إذ لا يقبلها % % فمي ويا بردها على كبدي % % PageV01P700 البحر : - 1(@)(@@) % رب أديب رأى كتابا % فقال ماذا المليح عندك % % 2(@)(@@) % فقلت في الحال يا كتابي % % غيب والا سلخت جلدك % % PageV01P701 البحر : - 1(@)(@@) % يقول الامام الفاضل ابن دريهم % % عدمنا على المعلوم خلا مساعدا % % 2(@)(@@) % بديوان عشر الشام هل بالتقى أخ % % فقلت ولا تلقى من العشر واحدا % % PageV01P702 البحر : - 1(@)(@@) % عش تهنا بك أعياد لها % % بحمى السعد العمادي اعتماد % % 2(@)(@@) % يا رئيسا يقسم الساري له % % ما يرى أرفع من ذات العماد % % PageV01P703 البحر : - 1(@)(@@) % شيخ النقا والهنا بهاه % % رونقه دائما جديد % % 2(@)(@@) % العلم والزهد والعطايا % % فكلنا طالب مريد % % PageV01P704 البحر : - 1(@)(@@) % أنساني الهم حتى % % عادات بر الرشيد % % 2(@)(@@) % لا زال بين عتيق % من عيده وجديد % % PageV01P705 البحر : - 1(@)(@@) % رويت بالمنهل السعدي بعد ظما % % أضنى من الحال معدومي وموجودي % % 2(@)(@@) % حتى يغني الرجا بشراك يا ظمإي % % سعد السعود ومجري الماء في العود % % PageV01P706 البحر : - 1(@)(@@) % هيهات بين ذوي الهوى لا يستوي % % دمعي ودمعك أيها المتواجد % % 2(@)(@@) % فحديث دمعي عن تلهب مهجتي % % ذاكي اللظى وحديث دمعك بارد % % PageV01P707 البحر : - 1(@)(@@) % هنئت يا ملك السماحة والندى % % شهرا يزورك بالهنا معتادا % % 2(@)(@@) % تسدي به مننا وتكبت حسدا % % فتفطر الأفواه والأكبادا % % PageV01P708 البحر : - 1(@)(@@) % يفديك من لك في حشاه مودة % فإذن أجل العالمين لك الفدى % % 2(@)(@@) % و عداك أرضى أن تعيش فإنها % % ببقاك في عيش أمر من الردى % % PageV01P709 البحر : - 1(@)(@@) % فديت من آل 
ms154	 أيوب لنا ملكا % سار عن الشيم العليا على جدد % % 2(@)(@@) % حدثت عن فضله ثم استندت له % % فلا عدمت أسانيدي ولا سندي % % PageV01P710 البحر : - 1(@)(@@) % رعى الله بحرا فوق أرجا بحيرة % تكاد تحاكي بسط يمناه بالندى % % 2(@)(@@) % و تبدو إذا هب النسيم كمبرد % % فلا غرو أن تجلي عن المهج الصدا % % PageV01P711 البحر : - 1(@)(@@) % ألا ليت شعري هل أفوز بحافظ % لي الود من هذا البريد المردد % % 2(@)(@@) % فيرفع أخبار السلام لمالك % ويسمعني في الرد مسند أحمد % % PageV01P712 البحر : - 1(@)(@@) % لله تصنيف له رونق % كرونق الحبات في عقدها % % 2(@)(@@) % كادت تصانيف الورى عنده % % تموت للهيبة في جلدها % % PageV01P713 البحر : - 1(@)(@@) % تدانيت من عمرو فلما صرفته % % بنعماك أضحى عمرو نحوي راصدا % % 2(@)(@@) % و ما ضرني دين وفعلك سالم % يصرف لي زيدا وعمرا وخالدا % % PageV01P714 البحر : - 1(@)(@@) % لم أنس موقفنا بكاظمة % والعيش مثل الدار مسود % 2(@)(@@) % والدمع ينشد في مسائله % % هل بالطلول لسائل رد % PageV01P715 البحر : - 1(@)(@@) % قد لقبوا الراح بالعجوز وما % % تخرج ألقابهم عن العاده % % 2(@)(@@) % ألا نت الغادة التي امتنعت % % فصح أن العجوز قواده % % PageV01P716 البحر : - 1(@)(@@) % وردت على الباب الجمالي قاصدا % فجاد ولاقى مقصدي بأياد % % 2(@)(@@) % و لي فرس قد بات ضيفا لطرفه % % فبات كلانا وهو بيت جواد % % PageV01P717 البحر : - 1(@)(@@) % مرضت فعادني أزكى البرايا % % وأغنى عن مراض الود حادوا % % 2(@)(@@) % رأوا أني إلى الأجداث ماض % % فقالوا كل ماض لا يعاد % % PageV01P718 البحر : - 1(@)(@@) % يا سيدي ذكر بحالي صاحبا % تدري كما يدرى طريق السؤدد % % 2(@)(@@) % فما أظن حال عبد مخلص % % يضيع بين صاحب وسيد % % PageV01P719 البحر : - 1(@)(@@) % نجوم حسن أكراد أرضكم % % قد مات فيها المحب أوكادا % % 2(@)(@@) % فيالها عشقة دهيت بها % % حتى رأيت النجوم أكرادا % % PageV01P720 البحر : - 1(@)(@@) % يا ابن الأئمة كابرا عن كابر % دارك ببيت الظاهرية فاقدا % % 2(@)(@@) % لي ألف بيت في مدائح بيتكم % % فاردد على المملوك بيتا واحدا % % PageV01P721 البحر : - 1(@)(@@) % لا تذكروا معن بن زائدة لدى % % قاضي القضاة ولا لهاه الجائده % % 2(@)(@@) % كم قد رأينا من معاني فضله % % جدوى يديه في معان زائده % % PageV01P722 البحر : - 1(@)(@@) % و لما بعثت المال عفوا مهنا 
ms155	 % تزيد هذا الشعر حسنا مجددا % % 2(@)(@@) % و ما الشعر الا روضة راق حسنها % % ولا سيما ان كان قد وقع الندى % % PageV01P723 البحر : - 1(@)(@@) % سألت النقا والبان أن يحكيا لنا % % روادف أو أعطاف من زاد صدها % % 2(@)(@@) % فقال كثيب الرمل ما أنا حملها % % وقال قضيب البان ما أنا قدها % % PageV01P724 البحر : - 1(@)(@@) % نظرت وقد قام الخطيب وراقني % % على درج بدر العلى وهو صاعد % % 2(@)(@@) % و لما رأيت الناس دون محله % % تيقنت أن الدهر للناس ناقد % % PageV01P725 البحر : - 1(@)(@@) % يا رب أسألك الغنى عن معشر % غضبوا وكافوا بالجفاء ترددي % % 2(@)(@@) % قالوا كرهنا منه مد لسانه % % والله ما كرهوا سوى مد اليد % % PageV01P726 البحر : - 1(@)(@@) % رعى الله للعلياء قطب سيادة % يدور عليه كل علم وسؤدد % % 2(@)(@@) % متى جئت موسى شائما نار ذهنه % % تجد خير نار عندها خير موقد % % PageV01P727 البحر : - 1(@)(@@) % أولاد مولانا بهم % % تزهو المحافل والمشاهد % % 2(@)(@@) % مثل السيوف مهيبة % لكن لسيف الله خالد % % PageV01P728 البحر : - 1(@)(@@) % رشا بالصالحية سفح عيني % % سريع في محبته مديد % % 2(@)(@@) % له قلب ولي دمع عليه % % فهذا قاسيون وذا يزيد % % PageV01P729 البحر : - 1(@)(@@) % يا أميرا زادت يداه لعاف % وأجادت يوم الحروب جهادا % % 2(@)(@@) % صدق القائلون في كل وقت % % لا يكون الجواد إلا جوادا % % PageV01P730 البحر : - 1(@)(@@) % ما ضر احسانك يا سيدي % % لو حاد في أمري عن الاقتصاد % % 2(@)(@@) % يا عين آمالي إذا استجمعت % % اني إلى مورد لقياك صاد % % PageV01P731 البحر : - 1(@)(@@) % صديقي من قديم إن فكرتي % % بما أبديت لي فكر جديد % % 2(@)(@@) % و عدت بيسرتي فازددت عسرا % % فلا أدري أوعد أو وعيد % % PageV01P732 البحر : - 1(@)(@@) % قل لوزير الشآم يامن % % مد يد الجود للعباد % % 2(@)(@@) % ماسرق المادحون وصفا % فيك فلا تقطع الأيادي % % PageV01P733 البحر : - 1(@)(@@) % مليك بدا في أحمر من ملابس % % كذاك بدت من حوله الخيل والجند % % 2(@)(@@) % بدوا كلهم في حلة الورد ملبسا % فقال الورى هذا هو الأسد الورد % % PageV01P734 البحر : - 1(@)(@@) % قالوا أضاءت سماء الشام قلت لهم % % بدر التقى والعلى والجود موجود % % 2(@)(@@) % و للسعادة معنى شاهد ابدا % بأن طالع أفق الشام مسعود % % PageV01P735 البحر : - 1(@)(@@) % عليك بساحة الملك 
ms156	 المرجى % % اذا خفت الجوائح والاعادي % % 2(@)(@@) % تجد أندى يد وخيول حرب % فما ينفك يروي عن جواد % % PageV01P736 البحر : - 1(@)(@@) % و شاهد أعجبني حسنه % % وكنت في آخر كالواحد % % 2(@)(@@) % فحار في هذا وذا خاطري مولاي لا هدت اللياليكثيب علياكم عمادا ولا طلبنا ربيع بر وكان جودكم جمادى % % وقلت بالغائب والشاهدسقط بيتين ص % % PageV01P737 البحر : - 1(@)(@@) % روت عنك أخبار المعالي محاسن % % كفت بلسان الحال عن ألسن الحمد % % 2(@)(@@) % فوجهك عن بشر وكفك عن عطا % % وخلقك عن سعد ورأيك عن سعد % % PageV01P738 البحر : - 1(@)(@@) % كم قلت باللثم وبرد اللمى % % إيه برغم العاذل الحاسد % % 2(@)(@@) % رو صدى قلبي ودع عذلي % % في الحب تغتاظ على البارد % % PageV01P739 البحر : - 1(@)(@@) % قال لي إذ رأى انكساري حبيبي % % ما الذي قد دعا لهذي العياده % % 2(@)(@@) % قلت زادوا رفاق شغلي دوني % % قال أخشى عليك من ذي الزياده % % PageV01P740 البحر : - 1(@)(@@) % أيا سائلي عن مذهب العتب والولا % % لأهل زمان انه لشديد % % 2(@)(@@) % أوالي عليا خلد الله مجده % % وأشكو أذى عثمان وهو يزيد % % PageV01P741 البحر : - 1(@)(@@) % لما رأيت نهودها قد أقبلت % % ورأت لوجهي عشقة تتجدد % % 2(@)(@@) % قالت وقد رأت اصفراري من به % % وتنهدت فأجبتها المتنهد % % PageV01P742 البحر : - 1(@)(@@) % جنيت بالتقبيل من خده % % وردا وعاتبت على الصد % % 2(@)(@@) % فافتر من عجب وقال انظروا % % لعاشق يجني ويستعدي % % PageV01P743 البحر : - 1(@)(@@) % أهدي إلى القرم الشريف هدية % % عبد يود مكانها من خده % % 2(@)(@@) % ماعد مذ ملكت يمينك رقه % % عيبا عليه فلا سبيل لرده % % PageV01P744 البحر : - 1(@)(@@) % قالت لي النفس اذا أهديت نحوكم % % جديا حكى القطعة العلياء من كبدي % % 2(@)(@@) % أرسله مع تاجر الكتب الفلاني وقل % % هذا أخي حين أدعوه وذا ولدي % % PageV01P745 البحر : - 1(@)(@@) % أهيف ذو خصر وردف فكم % % في غوره أصبو وفي نجده % % 2(@)(@@) % ياليته لي بالجفا موعدا % فانه يكذب في وعده % % PageV01P746 البحر : - 1(@)(@@) % يالهف قلبي على لقاء رشاء % شيب مني الفؤاد والفودا % % 2(@)(@@) % لي مقلة منه قد جننت بها % % وهكذا حال من به سودا % % PageV01P747 البحر : - 1(@)(@@) % يا مجزل الرفد للنزيل به % % جائزة جمة وزواده % % 2(@)(@@) % منحتي المال صبحة فعسى % % تكون يا أكرم الورى 
ms157	 عاده % % PageV01P748 البحر : - 1(@)(@@) % قاضي القضاة المرتجى دمت ذا % % نعماه للصادر والوارد % % 2(@)(@@) % بعض الورى يطلبني شاهدا % مع أنه ذو ورع زائد % % 3(@)(@@) % فاعجب له من ورع ناسك % من مثلي بالشاهد % % PageV01P749 البحر : - 1(@)(@@) % أهلا بها بيضاء عاطرة اذا % % وصلت ينم بها شذاها والشذى % % 2(@)(@@) % سحارة الجفن الكحيل اذا رنت % % عقدت لسان معوذ ان عوذا % % 3(@)(@@) % تلك التي حكمت سهام لحاظها % % حكما تأمله الجمال فنفذا % % 4(@)(@@) % تجري الدماء وسيفها في جفنه % % نظرا وليس السحر الا هكذا % % 5(@)(@@) % آها لرشق سهامها في هدبها % % و السهم أبعد ما يكون معذذا % % 6(@)(@@) % و لحاجبين اذا تعرض ناظر % % متأمل قالت لقوسيها خذا % % 7(@)(@@) % ولذلك الخد الخليلي اللظى % % لو ينتحي الصنم الأصم لجذذا % % 8(@)(@@) % قالت اذا غمضت جفونك فارتقب % % طيفي فقلت لها نعم لكن اذا % % 9(@)(@@) % و سمعت عن سيف ورمح قبلها % % حتى انثنت ورنت فقلت هما اللذا % % 10(@)(@@) % عشقي كمدح جمال دين الله لا % % ينفك مشتغل الضمير بذا وذا % % PageV01P750 11(@)(@@) % المرتقي درجات مجد جل أن % % يجذو سواه وجل عن أن يحتذى % % 12(@)(@@) % مترفع الأوصاف عن مدح الورى % % فكأنما قول المديح له بذا % % 13(@)(@@) % جزل الندى والبأس لو لمس الصفا % % لجرى ولو لمس الحديد لفلذا % % 14(@)(@@) % عرف الحيا كفيه لما أخجلا % % بالبرق وجنته وقال هما اللذا % % 15(@)(@@) % عال على شرف النجوم كأنما % % قدم الثريا في القياس له حذا % % 16(@)(@@) % وجد الأنام على قريحته هدى % % فرأوا ليوسف نار موسى تحتذى % % 17(@)(@@) % كم مقتر عان يلذذ أمره % % وافى إلى أبوابه فتلذذا % % 18(@)(@@) % و معاود منه اقتباس فوائد % لو شامها الاعشى الكبير تتلمذا % % 19(@)(@@) % يمم حماه تجد سحابا مشبما % يهنى الندى وتلطفا متبغذذا % % 20(@)(@@) % و أناملا خلقت لضم يراعة % تجري ببسط الرزق أو كف الاذى % % PageV01P751 21(@)(@@) % و فضائلا فخرت على كأس الطلا % في الذوق فهي خليقة أن تنبذا % % 22(@)(@@) % كم من معاني مشرق في لفظه % % راحت فلا كدر يشين ولا قذى % % 23(@)(@@) % كالنجم في صافي الغدير تظنه % % أدنى منالا وهو أبعد مأخذا % % 24(@)(@@) % ياآل حماد الكرام بذكركم % % نعش الزمان كأن 
ms158	 ذكركمو غذا % % 25(@)(@@) % أما الزمان بكم فأفصح إذ رجا % % نطقا وأما بالأنام فقد هذا % % 26(@)(@@) % خلفتم للمكرمات ممدحا % أعدى على رتب الزمان وانفذا % % 27(@)(@@) % لله أنت لقد أجرت حشاي من % % هم تحكم أمره واستحوذا % % 28(@)(@@) % جان علي اذا اجتهدت كواقع % % في الفخ زاد عناه حين تجبذا % % 29(@)(@@) % حتى لجأت إلى جنابك شاكيا % فأجرت من ألقى الرجا وتعوذا % % 30(@)(@@) % كرما كما نبع الزلال ومرحبا % وهدى كما لمع الصباح فحبذا % % PageV01P752 31(@)(@@) % الغيث أنت وأنت أكرم ديمة % والسهم أنت وأنت أسرع منفذا % % PageV01P753 البحر : - 1(@)(@@) % لي رفقة تعجب إقبالهم % % حوارنا يصقل أفخاذا % % 2(@)(@@) % عادوا ببطيخ وقرع لهم % % وعدت لا هذا ولا هذا % % 3(@)(@@) % قد نبذوا الانصاف فاعجب لمن % % غدا بشهر الصوم نباذا % % PageV01P754 البحر : - 1(@)(@@) % بعثت لكم يا سادة أنا عبدهم % % قليلا من المن الذي طاب مأخذا % % 2(@)(@@) % فلا تقرنوه بالخليلي آكلا % فحاشكم أن تقرنوا المن بالأذى % % PageV01P755 البحر : - 1(@)(@@) % لما رأى الظبي طرف حبي % % شكا إلى الحسن واستعاذا % % 2(@)(@@) % وقال جفن له سقيم % ياليتني مت قبل هذا % % PageV01P756 البحر : - 1(@)(@@) % مولاي دعوة معجب % يدعى به متلذذ % % 2(@)(@@) % أنا كالذي هو قائل % في شعره أنا كالذي % % PageV01P757 البحر : - 1(@)(@@) % أفدي غزالا من الأتراك مقلته % % في صنعة السحر أعيت كل أستاذ % % 2(@)(@@) % نباذ عهد بذاك اللحظ يسحرني % % يا حسرتي بين سحار ونباذ % % 3(@)(@@) % كأن الفاظ فخر الدين منه حوت % % مدام ساق عليها سحر نفاذ % % 4(@)(@@) % ذو النظم والنثر كم قالت حلاوة ذا % % وذا لعمرك ماذي حاجة الماذي % % 5(@)(@@) % والفضل في الناس كم لذت له شيم % وكم عطفت على لهفان لواذ % % 6(@)(@@) % يا كاتبا خلت أقلاما بمهرقه % % عقائلا رقمت طرزا على لاذ % % 7(@)(@@) % تهنها نعم الوهاب قائلة % ياعيده اهنأ بهذي واقمع الهاذي % % PageV01P758 البحر : - 1(@)(@@) % قالت إشارة فاتك لمروع % قل لي لمن يستنجد المنبوذ % % 2(@)(@@) % ما أنت الا في الحصار معي فلا % % تتعب فكل محاصر مأخوذ % % 3(@)(@@) % فأجابها بالله ثم رسوله % يستنجد المنبوذ حين يلوذ % % 4(@)(@@) % هي نقطة تروى فعند نفوذها % % تحتال إذ عند الرجاء نفوذ % % PageV01P759 البحر : - 1(@)(@@) % كذا أبدا تلقى 
ms159	 الأهلة طالعا % عليك بأنوار السعود فحبذا % % 2(@)(@@) % ويصنع فينا الجود صفوا مهنئا % ولا حظرا فيه عليك ولا قذى % % 3(@)(@@) % ومهما وضعت المن في مستحقه % % فوالله ما مدت اليك يد الأذى % % PageV01P760 البحر : - 1(@)(@@) % بروحي معسول اللمى متحجب % % إذا لم يزر لم يهن عيشي ولا إذا % % 2(@)(@@) % وان ذقت منا من حلاوة ريقه % % أتانا رقيب يتبع المن بالأذى % % PageV01P761 البحر : - 1(@)(@@) % أفدي بديع الجمال محتكما % بناظر في القلوب نفاذ % % 2(@)(@@) % إذا تبينت ما صناعته % % رنا بلحظ وقال فولاذي % % PageV01P762 البحر : - 1(@)(@@) % لسقيا لمشمش بستانكم % % فنعم الشراب ونعم الغذا % % 2(@)(@@) % وأعجب كل فتى حبه % % فقال الفتى حبذا حب ذا % % PageV01P763 البحر : - 1(@)(@@) % يا سيدا مازال لي من منه % % نعم الحلاوة والعشا ثم الغذا % % 2(@)(@@) % منا بعثت اليك إلا أنه % من من بالتقبيل يتبعه أذى % % PageV01P764 البحر : - 1(@)(@@) % صحا القلب لولا نسمة تتخطر % % ولمعة برق بالغضا تتسعر % % 2(@)(@@) % وذكر جبين البابلية إذ بدا % % هلال الدجى والشيء بالشيء يذكر % % 3(@)(@@) % سقى الله أكناف الغضا سائل الحيا % % وإن كنت أسقى أدمعا تتحدر % % 4(@)(@@) % وعيشا نضا عنه الزمان بياضه % % وخلفه في الرأس يزهو ويزهر % % 5(@)(@@) % تغير ذاك اللون مع من أحبه % % ومن ذا الذي يا عز لا يتغير % % 6(@)(@@) % و كان الصبي ليلا وكنت كحالم % فيا أسفي والشيب كالصبح يسفر % % 7(@)(@@) % يعللني تحت العمامة كتمه % % فيعتاد قلبي حسرة حين أحسر % % 8(@)(@@) % و ينكرني ليلي وما خلت أنه % % إذا وضع المرء العمامة ينكر % % 9(@)(@@) % ألا في سبيل الله صوم عن الصبي % % وقلب على عهد الحسان مفطر % % 10(@)(@@) % تذكرت أوطان الوصال فأشهب % من الدمع في ميدان خدي وأحمر % % PageV01P765 11(@)(@@) % إذا لم تفض عيني العقيق فلا رأت % % منازله بالوصل تبهى وتبهر % % 12(@)(@@) % و إن لم تواصل غادة السفح مقلتي % % فلا عادها عيش بمغناه أخضر % % 13(@)(@@) % ليالي تجني الحسن في أوجه الدمى % % وتجني على أجسامها حين تنظر % % 14(@)(@@) % يؤثر في خد المليحة لحظها % % وإن كان في ميثاقها لا يؤثر % % 15(@)(@@) % رأيت الصبي مما يكفر للفتى % % ذنوبا اذا كان المشيب يكفر % % 16(@)(@@) % إذا حل مبيض المشيب 
ms160	 بعارض % فما هو الا للمدامع ممطر % % 17(@)(@@) % كأني لم أتبع صبي وصبابة % % خليع عذار حيثما همت أعذر % % 18(@)(@@) % و لم أطرق الحي الخصيب زمانه % % يقابلني زهر لديه ومزهر % % 19(@)(@@) % و غيداء أما جفنها فمونث % % كليل وأما لحظها فمذكر % % 20(@)(@@) % يروقك جمع الحسن في لحظاتها % % على أنه بالجفن جمع مكسر % % PageV01P766 21(@)(@@) % من الغيد تحتف الظبا بحجابها % % ولكنها كالبدر في الماء يظهر % % 22(@)(@@) % يشف وراء المشرفية خدها % % كما شف من دون الزجاجة مسكر % % 23(@)(@@) % و لا عيب فيها غير سحر جفونها % % وأحبب بها سحارة حين تسحر % % 24(@)(@@) % إذا جردت من بردها فهي عبلة % وان جردت ألحاظها فهي عنبر % % 25(@)(@@) % إذا خطرت في الروض طاب كلاهما % % فلم يذر من أزهى وأشهى وأعطر % % 26(@)(@@) % خليلي كم روض نزلت فناءه % % وفيه ربيع للنزيل وجعفر % % 27(@)(@@) % و فارقته والطير صافرة به % % وكم مثلها فارقتها وهي تصفر % % 28(@)(@@) % إلى أعين بالماء نضاخة الصفا % % اذا سد منها مسخر جاش منخر % % 29(@)(@@) % نداماي من خود وراح وقينة % % ثلاث شخوص كاعبات ومعصر % % 30(@)(@@) % قضيت لبانات الشبيبة والهوى % % وطولت حتى آن أني أقصر % % PageV01P767 31(@)(@@) % و رب طموح العزم ادماء جسرة % % يظل بها عزمي على البيد يجسر % % 32(@)(@@) % طوت بذراعي وخدها شقة الفلا % % وكف الثريا في دجى الليل يشبر % % 33(@)(@@) % ومد جناحي ظلها آلق الضحى % % فشدت كما شد النعام المنفر % % 34(@)(@@) % بصم الحصى ترمي الحداة كأنما % % تغار على محبوبها حين يذكر % % 35(@)(@@) % إذا ما حروف العيس خطت بقفرة % غدت موضع العنوان والعيس أسطر % % 36(@)(@@) % فلله حرف لاترام كأنها % % لوشك السرى حرف لدى البيد مضمر % % 37(@)(@@) % تخطت بنا أرض الشام إلى حمى % % به روضة ريا الجنان ومنبر % % 38(@)(@@) % إلى حرم الأمن المنيع جواره % % اذا ظلت الأصوات بالروع تجأر % % 39(@)(@@) % إلى من هو التبر الخلاص لناقد % غداة الثنا والصفوة المتخير % % 40(@)(@@) % نبي أتم الله صورة فخره % % وآدم في فخاره يتصور % % PageV01P768 41(@)(@@) % نظيم العلى والافق ما مد طرسه % % ولا الزهر الا والكواكب تنثر % % 42(@)(@@) % و لا لعصا الجوزاء في الشهب آية % % مجر الدجى من تحتها 