ms81	 أنا ميت % وإن ألحقوني عندهم بلحودي % % 8(@)(@@) % ولست بأعمى لا ولا أنا مبصر % إذا كان قربي منه قرب وريدي % % 9(@)(@@) % ولست بذي نطق وإن كنت مفصحا % بأخبار ما عاينت دون مزيد % 10(@)(@@) % فذاتي ذات الحق إذ هي عيننا % % كما جاء في الشرع المبين فعودي % % PageV01P312 11(@)(@@) % إلى الحق يا نفسي ولا تجزعي لما % % أتيت بما أودعته بقصيدي % % PageV01P313 البحر : بسيط تام 1(@)(@@) % ما إن علمت بأمر فيه من عدد % إلا وقامت به حقيقة الأحد % 2(@)(@@) % عين توحد والأسماء تكثرها % % والكثر لا ينتهي فيها إلى أمد % 3(@)(@@) % لما علمت بهذا واتصفت به % % علمت أن وجود الفرد في العدد % % 4(@)(@@) % فخبروني عن أمر لا شبيه له % % وما هو الله ذو الآلاء والرفد % % 5(@)(@@) % إن الغني الذي غناه عن عرض % هو الفقير إلى الآلات والعدد % % 6(@)(@@) % وليس في الكون إلا من تكون له % % هذي الصفات فما في الكون من أحد % % 7(@)(@@) % يقال فيه غني لا افتقار له % وذلك الحكم في الأدنى وفي البعد % % 8(@)(@@) % وذلك الحكم ساري إن علمت به % % في كل ذي روح أو في كل ذي جسد % % 9(@)(@@) % إن الوجود الذي تدري به بلد % وإنه واحد من ساكني البلد % % 10(@)(@@) % أقول فيه مقالا لا لا أقول به % حتى أعاينه في كل مستند % % PageV01P314 11(@)(@@) % هو الوجود الذي الأعيان صورته % % وإن صاحبه مشاركث النكد % 12(@)(@@) % لولا الوجود ولولا حسن صورته % % ما كان لي أمل في كل ذي حيد % 13(@)(@@) % عن من لي من وفي من فاستعد له % إن الإمام الذي يهدي إلى الرشد % 14(@)(@@) % إن الإله دعانا أن نلاقيه % بالموت عند فراق الروح للجسد % 15(@)(@@) % لذاك أسرعت الأرواح طائرة % % ولم تعرج على أهل ولا ولد % 16(@)(@@) % ليس التعجب من تعجيل رحلتها % % إن التعجب من نوح ومن لبد % % PageV01P315 البحر : كامل تام 1(@)(@@) % لولا شهودي ما عرفت وجودي % % فامنن علي به فأنت شهيدي % % 2(@)(@@) % وعلامتي اني جهلت وجودكم % % من حيث ما هو هو بغير مزيد % 3(@)(@@) % ودليل ما قد قلته من جهلنا % % من ذاتكم أني جهلت وجودي 
ms82	 % % PageV01P316 البحر : بسيط تام 1(@)(@@) % إني سألتك أسماء وحصرتها % % تسع وتسعون لم تنقص ولم تزد % 2(@)(@@) % بأن يكون لنا في كل حادثة % عين استناد وأنتم خير مستندي % % 3(@)(@@) % جاء الجواب لنا من فوق أرقعة % % سبع من الدخ قامت لا على عمد % 4(@)(@@) % يرونها وأنا عين العماد لها % % لذا تزول إذا زلنا من البلد % % 5(@)(@@) % فإنها لي ولوا عبني ما بينت % والحق يبعد عن مراتب العدد % % 6(@)(@@) % لذا يكفر بالتثليث قائله % أين الثلاث من المنعوت بالأحد % 7(@)(@@) % الله أعظم أن يلقاه من أحد % في عين كثرته فاعمل به وقد % % 8(@)(@@) % ينجو إذا صاحب الأعداد يهلك في % % تعداده وهو الحيران في كبد % % 9(@)(@@) % وكل عين من الأعداد تطلبه % % ولا سبيل إلى فوز بلا سند % 10(@)(@@) % قل للذي رام أن يحظى بموجده % % هيهات هيهات لا تعدل عن الرشد % PageV01P317 11(@)(@@) % فليس يحظى به من ليس يشبهه % وليس يشبهه في العين من أحد % 12(@)(@@) % إذا تجلى لكم في عين وحدته % لن تدركوه لأن الروح ذو جسد % 13(@)(@@) % والعين ذو جسد فأين وحدته % فارجع وراك ولا تكرع ولا ترد % % 14(@)(@@) % إن المهيمن بالأسماء نعرفه % % والاسم يظهره لصاحب الرصد % 15(@)(@@) % لذاك قال لهم سموهم فإذا % % سموهم بان من أسمائهم رشدي % % 16(@)(@@) % فواحد العين مجهول بلا صفة % فاعمل عليه فإن الناس في حيد % 17(@)(@@) % عن الذي رمت منه إن تحصله % % لو لم يكن فيه إلا الوصف بالجسد % 18(@)(@@) % لذاك يطلبه حتى يكون كهو % ولا يكن فاقتصر عليك لا تزد % % 19(@)(@@) % لو أن إبليس علام بخالقه % % كان الإله له من أعظم العدد % % 20(@)(@@) % لو أن آدم لم يخذل طبيعته % % ما كان في الملأ الذري من لدد % % PageV01P318 البحر : طويل 1(@)(@@) % مطوت متون الصافنات جيادي % % بقبة أجياد ومهبط واد % 2(@)(@@) % أزاحم فيه كل ملك متوج % وأنفق فيه طارفي وتلادي % % 3(@)(@@) % وأظهر فيه كل يوم بصورة % % إلى أن نزلت الأرض أرض إياد % 4(@)(@@) % فعاينت قسا في عكاظ وعنده % بمجلسه المهدي وهو ينادي % % 5(@)(@@) % أظلكم وقت عليه مهابة % بإظهار مهدي شريعة هاد % % PageV01P319 البحر : بسيط 
ms83	 تام 1(@)(@@) % لما رأيت وجودي ما رأيت عمى % ولم أزل في عمى منه إلى الأبد % 2(@)(@@) % إذا يحددني في كل آونة % % فلا أزال مع الأنفاس في كبد % 3(@)(@@) % كذا أتتنا به الآيات ناطقة % % بقاف وأنزلها في سورة البلد % % 4(@)(@@) % من فوق سبع سموات منزلة % على حقيقة ذي روح وذي جسد % 5(@)(@@) % أتى بها تبلغ الأسماع دعوته % % عن اذن منزلها ألواحد الصمد % % 6(@)(@@) % فعندما سمعت أذني تلاوته % بالوهم في قبة قامت على عمد % 7(@)(@@) % مربع الشكل والأملاك تحرسه % من كل ذي حسد والكل ذو حسد % 8(@)(@@) % من جنسه فجميع الخلق تحسده % من الملائكة العالين بالسند % % 9(@)(@@) % إن الذي تحت أرض الأرض منزله % لمحرقون بنور النجم للرصد % % 10(@)(@@) % لأنه نسخة من كلهم فله % هذا السفوف فقل خيرا ولا تزد % PageV01P320 11(@)(@@) % لما رأيت له حكما على جسدي % % علمت منه الذي ألقاه في خلدي % % 12(@)(@@) % لولا تطابق ألفاظ الكتاب على % % عين المعاني لكان الخلق في حيد % % 13(@)(@@) % فليس إعجازه إلا نزاهته % % عن الأباطل هذا سره وقد % % 14(@)(@@) % وما سواه فأقوال مزخرفة % % ليست من الخلاق في شيء فلا تعد % 15(@)(@@) % إن القرآن لنور يستضاء به % % يهدي مع السنة المثلى إلى الرشد % % 16(@)(@@) % فخذ به صعدا إن كنت في سفل % % وخذ به سفلا إن كنت في صعد % PageV01P321 البحر : مجزوء الرجز 1(@)(@@) % لحدت بنتي بيدي % % لأنها ذو جسدي % % 2(@)(@@) % أنا على حكم النوى % % فليس شيء بيدي % % 3(@)(@@) % مقيد في وقتنا % % ما بين أمس وغد % 4(@)(@@) % جسمي لجين خالص % حقيقتي من عسجد % 5(@)(@@) % كالقوس نشئي ولذا % % عين قوامي حيدي % % 6(@)(@@) % يقول ربي إنه % % خلقني في كبد % 7(@)(@@) % فكيف أرجو راحة % % ما دمت في ذا البلد % % 8(@)(@@) % لولاه ما كنت أنا % % ذا والد وولد % 9(@)(@@) % ولم يكن لي كفؤا % كخالقي من أحد % 10(@)(@@) % فالنعت نعت واحد % في عين ذات العدد % % PageV01P322 11(@)(@@) % فحل إلهي بيننا % % في الكون لا المتعقد % 12(@)(@@) % بنشأة ثابتة % % يصح منها سندي % % 13(@)(@@) % في أنني مثلكم % وأنت لي مستندي % % 14(@)(@@) % بالفرض لا إني أنا % % مثل وهذا رشدي 
ms84	 % % 15(@)(@@) % نفيت عني المثل في % % مثل وهذا رشدي % % 16(@)(@@) % وجنتي عالية % مع الحسان الخرد % 17(@)(@@) % وإنما قال به % كما لنا في المقصد % % 18(@)(@@) % طبيعة الكون له % % أهل وعين الأحد % % 19(@)(@@) % بعل لها فاجتمعا % % على وجودي وقد % 20(@)(@@) % ما قلت ذا عن نظر % قد قام بي في خلدي % % PageV01P323 21(@)(@@) % وإنما قرره % عندي رسول الصمد % 22(@)(@@) % فكان يملي وأنا % % أكتب عنه بيدي % % 23(@)(@@) % وهكذا الأمر ولا % % يعرفه من أحد % 24(@)(@@) % غير إمام سابق % % بالخير أو مقتصد % 25(@)(@@) % والغير لا يعرفه % في الحال بل في الأبد % % 26(@)(@@) % وكل فرع راجع % لأصله لم يزد % % PageV01P324 البحر : طويل 1(@)(@@) % أقول بأني واحد بوجودي % % وإني كثير في الوجود بجودي % % 2(@)(@@) % لنا ألسن بالجود والكرم الذي % % ورثناه من آبائنا وجدودي % % 3(@)(@@) % تميز ربي عن وجودي بحدنا % % وجد إلهي إن نظرت جدودي % % 4(@)(@@) % ولا حد لله العظيم فإنه % % نزيه وتنزيه الإله حدودي % % 5(@)(@@) % وإني في خلق جديد بصورتي % % ولست بخلق للحديث جديد % 6(@)(@@) % تفكرت في قول جديد فلم أجد % % سواه وإن الله غير جديد % 7(@)(@@) % وأعلم أني في مزيد بجوده % % لأني شكور لا بشكر مزيد % 8(@)(@@) % ولولا امتثال الأمر ما قلت هكذا % % فعين دعائي للوفا بعهودي % % 9(@)(@@) % عقدت مع الله الكريم بأنه % هو الرب لي في غيبتي وشهودي % % 10(@)(@@) % وما زال هذا حالتي وعقيدتي % % فميزني فيمن وفى بعهودي % % PageV01P325 11(@)(@@) % لساني كلام الحق فالقول قوله % أنوب به عن أمره وشهيدي % % 12(@)(@@) % عليه كلام جاء من عنده بنا % % أنا قائم في قومتي وسجودي % % 13(@)(@@) % تنزهت من ربي وجودا مكملا % فقال : وجود الكون عين وجودي % % 14(@)(@@) % أقسم ما بين المراد حقيقته % % لمن ليس يدريها وبين مريد % 15(@)(@@) % وما وقع التقسيم فيها وإنه % % لمعنى يراه الناظرون سديد % 16(@)(@@) % كما قسم الله الصلاة بحكمة % % لنا بين سادات وبين عبيد % PageV01P326 البحر : وافر تام 1(@)(@@) % وقال أيضا : يدل الجزؤ من مضمون كوني % % على ما دل كلي من وجوده % 2(@)(@@) % فيشهدني وأشهده بنفسي % % فأفنى عن وجودي من شهوده % 3(@)(@@) % ولولا أن يقال صبا لأمر % % لقلت صدورنا من 
ms85	 عين جوده % 4(@)(@@) % يراه العارف الخريت ليلا % بأجواز المفازة عين بيذه % % 5(@)(@@) % يراه النائم اليقظان كشفا % كرؤية ذي التهجد في هجوده % % 6(@)(@@) % يراه الحائرون بلا دليل % كرؤية ذي المقاصد في قصوده % % 7(@)(@@) % يراه ناظم المرجان فيه % من أسماء له سلكا بجيده % 8(@)(@@) % يراه ناظم الألفاظ بيتا % هو الروح المؤيد في قصيده % 9(@)(@@) % يراه ناظم الأحجار عقدا % % وذاك العقد من اسنى عقوده % % 10(@)(@@) % قرأت بعقده أجياد دهر % به أخذ الشهادة في عقوده % PageV01P327 11(@)(@@) % له التسبيح والفرقان فيه % % يميزه ركوعك مع سجوده % % 12(@)(@@) % وحاذر أن تمازج بين رب % وبين من اصطفاهم من عبيده % % 13(@)(@@) % يراه مطلقا من كان أعمى % % كرؤية ذي البصيرة في قيوده % % 14(@)(@@) % فذاك الفيلسوف بغير حد % وهذا الأشعري على حدوده % 15(@)(@@) % وكلهم رهين الحبس فيه % بجعل العقل ذلك من صيوده % % 16(@)(@@) % على الإنصاف آمنهم شخيص % طليق ليس يرسف في قيوده % 17(@)(@@) % وهم أجناده وظهور ملك % مطاع إنما هو من جنوده % 18(@)(@@) % بذا سعدوا وحازوا الأمن منه % وإن تعبوا المآل إلى سعوده % 19(@)(@@) % لذا سبقت إلى الغايات رحمتي % وحازتها بمنزلتي سعوده % 20(@)(@@) % فحلت في الجنان وفي جحيم % وإن كانا لنا داري خلوده % % PageV01P328 21(@)(@@) % فاخبئه ليستر في جحيم % من الآلام أنسى من جحوده % % 22(@)(@@) % فلو لزموا الحقائق لم يكونوا % % كمنكر ما رآه لذي وروده % 23(@)(@@) % تجلى للبصائر من بعيد % % تجليه كمن هو في وريده % % 24(@)(@@) % وأطلعه على ما كان منه % % من الشكر العميم على مزيده % % 25(@)(@@) % تراه عند وصل العين منه % % بذاك مثل فصلك في شروده % 26(@)(@@) % فلا تطلب من الرحمن عهدا % فيسألك المهيمن عن عهوده % 27(@)(@@) % وسالمه تكن عبدا سؤوما % وتظفر بالزيادة في شهوده % PageV01P329 البحر : طويل 1(@)(@@) % إذا ما نعت الحق يوما فقيد % ولا تطلقن النعت إن كنت تهتدي % % 2(@)(@@) % إذا أنت أرسلت النعوت ولم تكن % تقيدها فيه فما أنت مهتدي % % 3(@)(@@) % إذا كنت علاما بما أنت ظاهر % علمت بأن السر بالعبد مرتدي % % 4(@)(@@) % وإن كنت لا تدري ولست بطالب % ولا باحث فاعلم بأنك معتدي % % 5(@)(@@) % إذا لم يقع نفع 
ms86	 لنفسك ههنا % % فأنت إذا بعثرت أخسر في غد % 6(@)(@@) % لو أنك مطلوب بكل جريمة % ومت على التوحيد علما كان كان قد % 7(@)(@@) % ولست بأهل للخلود بناره % % ولست بمحروم ولست بمفسد % 8(@)(@@) % كذا أنت عند الله في عين علمه % بقبضة اليمنى تروح وتعتدي % % 9(@)(@@) % دليلي عليه ذو السجلات فاعلموا % % وذلك عين الحكم في غير مشهد % % 10(@)(@@) % وإن كنت سباقا لكل فضيلة % تفوز إذا جاؤوا بأصدق مقعد % PageV01P330 البحر : كامل تام 1(@)(@@) % إني رأيت وما رأيت وجودي % % ورأيته ذخري ليوم شهودي % % 2(@)(@@) % عطفت علي صفات من أنا ذاته % فرأيته مني كحبل وريدي % % PageV01P331 البحر : طويل 1(@)(@@) % عجبت لمن قد كان عين هويتي % % ويشهد لي بالنقص عين مزيدي % % 2(@)(@@) % فما أدري ما هذا ولست بجاهل % وقد عرفتني بالأمور حدودي % % PageV01P332 البحر : طويل 1(@)(@@) % ولولا حدود الشيء ما امتاز عينه % ولولا حدودي ما عرفت حدودي % % 2(@)(@@) % لقد عشت أياما بغير منازع % ولم أك محسودا لغير حسود % % PageV01P333 البحر : طويل 1(@)(@@) % لي الملك لا بل نحن للملك آلة % فإن كنت ذا علم بما قلت فاهتدي % % 2(@)(@@) % تخيل لي السلطان ان كنت حاكما % بصورة مهدي وسنة مهتدي % % 3(@)(@@) % فإن بالاستحقاق قد نال ملكه % ويغفل عما في الرداء لمرتد % 4(@)(@@) % وليس بالاستحقاق ما نال آية % ليسأل عنه في القيامة في غد % 5(@)(@@) % يقابل من يلقى بدرع حصينة % % ويقتل أعداء بكل مهند % PageV01P334 البحر : مجتث 1(@)(@@) % الحمد لله حمدا % يربى على كل حمد % % 2(@)(@@) % بأنه يتعالى % % حال النزول لوعد % 3(@)(@@) % نزول ربي علو % منه إلى كل عبد % % 4(@)(@@) % وإنما جاء عندي % % لما تقدم عهدي % % 5(@)(@@) % وفيت لله عهدا % لذاك وفي بعهدي % % 6(@)(@@) % حد الإله تعالى % % مجدا على كل حد % 7(@)(@@) % وكل حد فمنه % فلست في ذاك وحدي % % 8(@)(@@) % لما أتيت إليه % % سعيا لصدر وورد % 9(@)(@@) % أتى بضعف مجيئي % % إليه من غير حد % 10(@)(@@) % سبحانه وتعالى % % عن كل معنى مؤدي % % PageV01P335 11(@)(@@) % إلى حدوث وحد % وذاك علمي وعقدي % % 12(@)(@@) % إن الحدود التي في % % كلامه المتعدي % % 13(@)(@@) % بكل نفع إلينا % % فإن ذلك عندي % % PageV01P336 البحر : مجزوء البسيط 
ms87	 1(@)(@@) % الحمد لله حق حمده % حمدا يوافيه دون وعده % 2(@)(@@) % عينا فلا يعتريه نقص % يجيئه من وراء حده % 3(@)(@@) % الحد أمر يعم حتى % % يسال فيه عن حد عده % 4(@)(@@) % ولم أقل فيه ذاك إلا % % من أجل من لم ينل بضده % % PageV01P337 البحر : وافر تام 1(@)(@@) % وملكني الصفات فكنت مثلا ألا فارجع إلى أصل الوجود % لما تدريه من كرم وجود % 2(@)(@@) % لقد من الإله على فؤادي % % بما أعطاه في حال السجود % 3(@)(@@) % سجود القلب إن فكرت فيه % على التحقيق يوذن بالشهود % 4(@)(@@) % إلى الأبد الذي ما فيه حد % % تعالى عن مصاحبة الحدود % % 5(@)(@@) % جهلت وما جحدت سبيل كوني % % فإن الأصل في من الصعيد % % 6(@)(@@) % صعدت به إلى شرف المعالي % % فانزلني إلى سعد السعود % % 7(@)(@@) % وناداني وقد خلفت قومي % % ورآئي بالمقرب والبعيد % % 8(@)(@@) % وآثرت الجناب جناب ربي % % فالحقني بمنزلة العبيد % % 9(@)(@@) % وملكني الصفات فكنت مثلا % % ونزهه عن المثل الوجودي % % 10(@)(@@) % وأي فضيلة أسنى وأعلى % % يقاومها بجنات الخلود % PageV01P338 11(@)(@@) % فضلت بها على الآباء حقا % يقينا صادقا وعلى الجدود % 12(@)(@@) % وأعلمني المهيمن أن جدي % % من أكرم ما يكون من الجدود % % 13(@)(@@) % سوى جد الإله فقد تعالى % % عن الكفوء المصاحب والوليد % PageV01P339 البحر : بسيط تام 1(@)(@@) % والله ليس بمعلوم فليس لنا إن التكاليف مجراها إلى أمد % % والعلم بالله لا يجري إلى الأمد % % 2(@)(@@) % في كل حين يزيد المرء معرفة % بربه وبأحوال إلى الأبد % 3(@)(@@) % فما يمر عليه اليوم من نفس % إلا ويأتي بعلم لم يزل يرد % 4(@)(@@) % فإذ ولا بد من علم فأحسنه % % العلم بالله لا بالكون فاستزد % 5(@)(@@) % كما أتاك به أمر المهيمن في % % طه وفي خبر فاعمل به تزد % 6(@)(@@) % العلم بالله في علمي بأنفسنا % % ذا أحال عليه المصطفى وقد % 7(@)(@@) % والله ليس بمعلوم فليس لنا % % علم بنا فاعتبر ما قلته تجد % % 8(@)(@@) % العجز غايتنا فيه فحاصله % % لا علم بي وبه يدور في خلدي % % 9(@)(@@) % فراقب الله يا هذا على حذر % والعلم بالله عين العلم بالرصد % % 10(@)(@@) % في سورة الفجر قال الله يعلمنا % % بأن ربك 
ms88	 بالمرصاد فاعتمد % % PageV01P340 11(@)(@@) % عليه إن له علما يجدده % % فإنه لكثير الخير والرفد % 12(@)(@@) % يعطي العطاء وما يعطيه عن كرم % لو كان ذا كرم لكان علته % % 13(@)(@@) % لو } كان ضا كرم لكان علته % وليس ذا علة تهدي إلى الرشد % % 14(@)(@@) % لما انفردت مع الملعوم في خلدي % % سألت من ذا فقالوا بيضة البلد % 15(@)(@@) % فقلت لما رأيت الأمر في كما % % ذكرت بالحكم في الأدنى وفي البعد % % 16(@)(@@) % وقال لي خاطري ما أنت واحده % الكل مثلك فاسمع هدى منتقد % 17(@)(@@) % إني حكمت له فيما نطقت به % % من المعارف فيه حكم مجتهد % 18(@)(@@) % فإن أصبت قذاك الظن بي وبه % أو لم أصب فهو مني لا من الأحد % % 19(@)(@@) % ولم أقل ذاك عن سوء يخالجني % % بل قلته أدبا مع سيد صمد % % 20(@)(@@) % ظننت بالله خيرا إذ حكمت به % من ظن بالله سوءا كان في حيد % PageV01P341 21(@)(@@) % عن الصواب الذي ما زال يطلبه % % مني فإن لم يكن أصبحت ذا فند % 22(@)(@@) % أخذت عن واحد جلت عوارفه % هذي المعارف لم آخذ عن العدد % 23(@)(@@) % حصلت عنه علوما في مشاهدة % ما لا يحصله النظار في مدد % 24(@)(@@) % بل لا تحصله النظار عن مدد % % أخرى الليالي ولا من قال بالسند % 25(@)(@@) % العلم ذوق ضروري لذائقه % فاعمل عليه فما في الربع من أحد % PageV01P342 البحر : بسيط تام 1(@)(@@) % تبارك الله لا أبغي به بدلا % % ولا أراه سوى في الأهل والولد % 2(@)(@@) % عجبت من غفلتي به وأنا % % منه كما قد علمتم بيضة البلد % 3(@)(@@) % اعلم بأن الذي بالعقل أطلبه % % لو فات عن بصري ما فات عن خلدي % % 4(@)(@@) % قد صح بالنقل أن العين واحدة % مني ومنه فلا يحجبك بالجسد % 5(@)(@@) % فإنه عين كلي هكذا وردت % ظهرا وبطنا وما بالربع من أحد % % 6(@)(@@) % غيري وصورته في الحس صورتنا % % بكل وجه وإن الأمر في حيد % 7(@)(@@) % قد قال عني أمورا لست أعرفها % % فيه فما جاء من غي ومن رشد % % 8(@)(@@) % وقتا يميزني عنه ويجمعني % % وقتا عليه به لا بد من عدد % % 9(@)(@@) % قد حرت 
ms89	 فيه فلا أدري أيثبت لي % % عين افتقاري أو استغناي في الأبد % % 10(@)(@@) % من أعجب الأمر أني حادث وأنا % % عين القديم بما قد جاء بالسند % % PageV01P343 11(@)(@@) % بأنه في عين السمع والبصر % وأنه عين ما أسعى به ويدي % % 12(@)(@@) % لأنه صح أن العين حادثة % مني وكيف يكون الأمر يا سندي % % 13(@)(@@) % تقابل الأمر فينا والوجود لنا % % حقا يقينا بلا ريب ولا فند % 14(@)(@@) % إن كنته فلماذا قلت فيه بأن % الحق سبحانه ركني ومعتمدي % % 15(@)(@@) % لولا أنا لم بليس النفي تتبعه % % ولا بنفي أب عنه ولا ولد % % 16(@)(@@) % والكاف عيني بلا شك وزائدة % % في قول أكثرهم فاقرأ ولا تزد % 17(@)(@@) % في اللحن يثبت ما قلناه من شبه % ولم يكن كفؤ الله من أحد % % 18(@)(@@) % لذا أتت سورة الإخلاص عن سبب % % من يهتدي فيه بالهدي الصحيح هدي % % 19(@)(@@) % إني أنزهك عن تنزيه أكثرهم % % بما أتت فيه أرسال لكم وقد % % 20(@)(@@) % كما فديتك من تقديس عالمهم % في زعمه وهو في التقديس ذو عند % PageV01P344 21(@)(@@) % كيف الفداء وما شيء يعادله % لو افتدى أحد بما فديت فدي % % PageV01P345 البحر : رمل تام 1(@)(@@) % صير الأعيان عينا واحدا % فوجود الحق في نفي العدد % PageV01P346 البحر : سريع 1(@)(@@) % إن لنا في سبأ آية % يعرفها السابق والمقتصد % 2(@)(@@) % إذ تصعق الأرواح من وحيه % % ولم تجد شيئا له يستند % 3(@)(@@) % حتى إذا فزع عن قلبهم % فقيل ماذا قيل قالوا الأحد % 4(@)(@@) % فابحث على حكمتها جاهدا % بالذكر لا بالفكر حتى تجد % % 5(@)(@@) % من الذي أجلى إليك الذي % % أصعق منك الروح قبل الجسد % % 6(@)(@@) % كمثل موسى حين أبدى له % في ذاته الرب الذي لم يلد % 7(@)(@@) % لذاك لم ينتج له قصده % فابحث على حكمته واتئد % 8(@)(@@) % ولا تكن فيما ترى طالبا % بعقلكم دون الهدى تستند % % 9(@)(@@) % فإنما الشرع سبيل الهدى % % عليه عول غيره لا ترد % % 10(@)(@@) % من يعرف المعنى الذي صغته % % من نظمنا هذا هو المقصد % PageV01P347 11(@)(@@) % فإنه الأفضل في حكمنا % % يجري على حكمته لم يزد % 12(@)(@@) % يدور بالحكمة دولابه % % فماؤه يسقي جميع البلد % % 13(@)(@@) % لذا 
ms90	 أتى في وسط ذكره % % والوسط الأفضل في المتعقد % 14(@)(@@) % به أتى القرآن في فضلنا % % وهو لمن يطلب أقوى سند % 15(@)(@@) % فمن يقل سكن لنا صاده % أقل له هذا وهذا ورد % % PageV01P348 البحر : بسيط تام 1(@)(@@) % الأمر أعظم أن يخطيء به أحد % فما له في وجود العلم مستند % 2(@)(@@) % جاء الحديث فما تدرى حقيقته % % ولا يعينها فكر ولا سند % 3(@)(@@) % والكشف ليس لهث فيها مداخلة % لأنه بوجود الصور ينفرد % % 4(@)(@@) % أمر الإله كما قد جاء واحدة % % والعبد من سره بالحق متحد % % 5(@)(@@) % فما ترى جسدا إلا ويعقبه % % إذا مضى عليه من حينه جسد % PageV01P349 البحر : مجزوء الخفيف 1(@)(@@) % أنا في الأمر مثلكم % ترجمان على الولد % 2(@)(@@) % فليكن خيرا ملجإ % إنكم خير مستند % 3(@)(@@) % إن خير الأنام من % % عجل الخير إن قصد % 4(@)(@@) % فإنا منكم كما % % أنتم بيضة البلد % 5(@)(@@) % أنت عز لدين من % % شرع الخير واجتهد % % 6(@)(@@) % النبي الذي بهم % % ته حلت العقد % 7(@)(@@) % كيف تحصى مآثر % ما لها عندنا عدد % 8(@)(@@) % فاحمد الله يا أخي % % فالسعيد الذي حمد % % 9(@)(@@) % فبه دهره نجا % % وبه اليوم قد سعد % PageV01P350 البحر : طويل 1(@)(@@) % ألا إن كشفي مثبت كل معتقد % إذا كان إثباتا ولست بمنتقد % % 2(@)(@@) % فمن كان ينوي الخير فالخير حاصل % ومن كان ينوي الشر فالشر قد فقد % % 3(@)(@@) % ولو كان عقد الأمر عقدا معينا % % لضاق نطاق الأمر فاقدح عسى تقد % 4(@)(@@) % فقد وسم الحق اعتقادات خلقه % % وحسبك ما قد قلت في حقه وقد % % 5(@)(@@) % ويأبى جناب الحق إلا اتساعه % % لتشهده الأبصار في كل معتقد % 6(@)(@@) % وما تدرك الأبصار منه سوى الذي % % تراه وما يخفى عن العين يعتقد % % 7(@)(@@) % وإن اللبيب الحبر يصمت عندما % % يرى شاهد التحويل في الحق قد وجد % PageV01P351 البحر : - 1(@)(@@) % وعجلت إليك رب لترضى موسى % % ولسوف يعطيك ربك فترضى محمد % % PageV01P352 البحر : مجزوء الرجز 1(@)(@@) % يا من إذا أبصرته % أبصرت نفسي وإذا % % 2(@)(@@) % أبصرني أبصر أي % % ضا نفسه معوذا % % 3(@)(@@) % منه به فليتني % % لم أك إذ كنت كذا % % 4(@)(@@) % فكل ما أسأله % % فيه يقول 
ms91	 حبذا % % 5(@)(@@) % هذا هو الجود الذي % % صير قلبي جهبذا % % 6(@)(@@) % لذا تراني كلما % % أذكره منبذا % % 7(@)(@@) % فالحمد لله الذي % % أقامني في ذا وذا % % PageV01P353 البحر : - 1(@)(@@) % ذلل وجودك لا تكن ذا عزة % حتى تصير نشأتيك جذاذا % % 2(@)(@@) % ذنبا عظيما قد أتى وكبيرة % % من يتخذ غير الإله ملاذا % % 3(@)(@@) % ذنب ولا تعد التأخر واتضع % % إن المذنب يثبت الأستاذا % % 4(@)(@@) % ذابت حشاشته وعم بلاؤه % % لما سقاه وابلا ورذاذا % % 5(@)(@@) % ذهبت به أيامه في غفلة % إذ لم تكن عين الثبوت معاذا % % 6(@)(@@) % ذهب الذين يشاهدون ذواتهم % % وتسللوا منه إليه لواذا % % 7(@)(@@) % ذبوا إلى العلم الغريب بظاهر % لم يبرحوا في ذاتهم أفذاذا % % 8(@)(@@) % ذكرهم بوجودهم في بهتهم % حتى يروه ملجأ وعياذا % % 9(@)(@@) % ذاك الإمام وما سواه فسوقة % فإذا رأوه فيه قالوا ماذا % % 10(@)(@@) % ذهلوا بمجلاه ولم يك غيرهم % ليس القديم مع الحديث يحاذى % % PageV01P354 البحر : طويل 1(@)(@@) % أرى نشأة الدنيا تشير إلى البلى % % بما حملته من سرور ومن أذى % % 2(@)(@@) % إذا ما رأيت الله أنشأ خلقه % % من أعماله فرقت ما بين ذا وذا % % 3(@)(@@) % وتعلم عند الفقء أنك واحد % ولا تعتبر من قال فشرا ومن هذى % % 4(@)(@@) % وكن بكتاب الله معتصما ولا % % تحرف كلام الله عن نصه إذا % % 5(@)(@@) % أتتك به الأرسال تترى وكن به % % على كل حال تتقيه معوذا % % 6(@)(@@) % تكن عند أهل العلم شخصا مقدسا % وعند أولي الألباب حبرا وجهبذا % % PageV01P355 البحر : بسيط تام 1(@)(@@) % القلب منزل من سواه واتخذه % % بيتا يكون به جودا وما نبذه % 2(@)(@@) % وكيف ينبذه والحق يسكنه % % إذا قلوب لأهل الزور منتبذه % 3(@)(@@) % إن القلوب التي بالعلم زينها % % هي القلوب التي للحق متخذه % 4(@)(@@) % فكل قلب تعالى عن أكنته % % وقفله فهو قلب للهوى اتخذه % % 5(@)(@@) % قد اصطفاه لما قلناه عامره % % وعن سواه من أحوال العمى انتبذه % 6(@)(@@) % فلو رماه بسهم من رمايته % رام العمى وأصاب العين ما نقذه % PageV01P356 البحر : كامل تام 1(@)(@@) % من قالت الأملاك فيه ماذا % % الحكم فيه أن يكون ملاذا % % 2(@)(@@) % لا بل يكون لمن تعوذ باسمه % % من كل 
ms92	 ما تخشى النفوس معاذا % % 3(@)(@@) % أقوى الورى واشدهم في عقده % % من صير الأصنام فيه جذاذا % % 4(@)(@@) % لم يتخذ غير الإله مهيمنا % إذ قيل أنت فقال : لا بل هذا % % 5(@)(@@) % من غرة قامت به في ربه % فأتته سحا انعم ورذاذا % % 6(@)(@@) % فلذاك ولاه الأمانة ربه % وأقامه في خلقه أستاذا % % 7(@)(@@) % يدعو إلى الإسلام لا يلوي على % % من قال فيمن قد دعاه ماذا % % 8(@)(@@) % هجر الورى متفردا مع ربه % لم يتخذ إلا الإله عياذا % % 9(@)(@@) % فأتوا زرافات إليه إجابة % % لما دعاهم ما أتوا أقذاذا % % 10(@)(@@) % فتنزل الخير الكثير عناية % من ربهم بقلوبهم أفلاذا % % PageV01P357 البحر : مجزوء الرمل 1(@)(@@) % إنهم كانوا إذا % % قيل لهم قولوا كذا % % 2(@)(@@) % من أمور ليس في % % قولها شرعا أذى % % 3(@)(@@) % بادروا من فورهم : % أمر من قال بذا % % 4(@)(@@) % ولقدر نتجوا % % للمعالي ولذا % % 5(@)(@@) % أصغر القوم الذي % % عن هواه انتبذا % % 6(@)(@@) % فتراه علما % ذا علوم جهبذا % % 7(@)(@@) % لهداه صاحبا % للهوى منتبذا % % 8(@)(@@) % كل من ساعده الس % عد فيه اتخذا % % 9(@)(@@) % عزمه ناصره % وعليه استحوذا % % 10(@)(@@) % ما يصيخون لمن % % قال فشرا وهذى % % PageV01P358 11(@)(@@) % وبذا قد عرفوا % % فاستخصوا وبذا % % 12(@)(@@) % وكبير القوم في % % حظره قد أخذا % % 13(@)(@@) % فلذا تبصره % % أبدا متخذا % % 14(@)(@@) % هكذا شأن الذي % % عينوه هكذا % % PageV01P359 البحر : سريع 1(@)(@@) % قد طهر الله الإمام الرضى % % من كل سوء يقتضيه الأذى % % 2(@)(@@) % فإنه سبحانه قد قضى % % أن لا يكون الأمر إلا كذا % % 3(@)(@@) % ولم يؤاخذه بما قد مضى % % إذا يتوب العبد عنه إذا % % 4(@)(@@) % وجاء بالفعل الذي يرتضى % % ومثل هذا العبد لن ينبذا % % 5(@)(@@) % ووجهه من نوره ما أضا % % لأنه حذو الإله حذا % % 6(@)(@@) % ليس تراه عين من غمضا % % عينا إذا أنزله بالحذا % % 7(@)(@@) % فأشبهت صورته فالقضا % % مطلوبه فلم يكن غير ذا % % PageV01P360 البحر : كامل تام 1(@)(@@) % العبد سيده عليه ثناؤه % % وثناؤه أيضا على أستاذه % 2(@)(@@) % أستاذه الحق المبين لأنه % % عين التجاء عبيده وملاذه % 3(@)(@@) % يأتيه منه عوارف معروفة % ما بين هطال وبين رذاذه % 4(@)(@@) % متقلبا في كل خير شامل % من الإله عليه في 
ms93	 إنقاذه % PageV01P361 البحر : كامل تام 1(@)(@@) % هذا المقام وهذه أسراره % % رفع الحجاب فأشرقت أنواره % % 2(@)(@@) % وبدا هلال التم يسطع نوره % % للناظرين وزال عنه سراره % % 3(@)(@@) % فأنار روض القلب في ملكوته % % وأتت بكل حقيقة أشجاره % 4(@)(@@) % عند التنزل صح ما يختاره % % قلب أحاطت بالردى أستاره % % 5(@)(@@) % وبدا النسيم ملاعبا أغصانه % فهفت بأسرار العلى أطياره % 6(@)(@@) % جادت على أهل الروائح منة % % منه بريا طيبها أزهاره % 7(@)(@@) % هام الفؤاد بحبه فتقدست % أوصافه وتنزهت أفكاره % % 8(@)(@@) % وتنزل الروح الأمين لقلبه % يوم العروبة فانقضت أوطاره % 9(@)(@@) % إن الفؤاد مع التنزل واقف % ما لم يصح إلى النزيل مطاره % % 10(@)(@@) % من كان يشغله التكاثر لم يكن % بعثته يوم وروده اكثاره % % PageV01P362 11(@)(@@) % من فتيء لحقيقة يصبر على % % 12(@)(@@) % من يدعي أن الحبيب أنيسه % في حاله فدليله استبشاره % 13(@)(@@) % من يدعي حكم الكيان فإنه % % قد تيمته بحبها أغياره % 14(@)(@@) % من كان يزعم أنه من آله % % سبحانه فشهوده أذكاره % % 15(@)(@@) % شهداء من نال الوجود شعاره % أمر يعرف شرعه ودثاره % % 16(@)(@@) % وأنينه مما يجن وصمته % عنه وعبرة وجده وأواره % % 17(@)(@@) % ما نال من جعل الشريعة جانبا % شيا ولو بلغ السماء مناره % % 18(@)(@@) % الحال إما شاهد أو وارد % تجري على حكم الهوى آثاره % % 19(@)(@@) % والناس إما مؤمن أو جاحد % أو مدع ثوب النفاق شعاره % % 20(@)(@@) % المنزل العالي المنيف بناؤه % % واه متى ما لم تقم عماره % % PageV01P363 21(@)(@@) % لأوائها حتى يرى مقداره % % فلك على نيل المقام مداره % % 22(@)(@@) % لو كان تسعده النفوس وإنما % % حجبته عن نيل العلى أوزاره % 23(@)(@@) % فإذا أتته عناية من ربه % % في الحال حف ببابه زواره % % 24(@)(@@) % ورأيته لما تخلص روحه % % من سجنه أسرى به جباره % 25(@)(@@) % وقد امتطى رحب اللبان مدبرا % يدعى الباق قما يشق غباره % 26(@)(@@) % تهوى به الهوج الشداد فيرتمي % % نحو الطباق وشهبهن شفاره % 27(@)(@@) % ما زال ينزل كل نور لائح % من جانبيه فما يقر قراره % % 28(@)(@@) % حتى بدت شمس الوجود لقلبه % % وبدا لعين فؤاده إضماره % 29(@)(@@) % وتلاقت الأرواح في ملكوته % فتواصلت ببحاره أنهاره % 30(@)(@@) % مد اليمين لبيعة مخصوصة 
ms94	 % أبدى لها وجه الرضى مختاره % PageV01P364 31(@)(@@) % لما بدا حسن المقام لعينه % عقدت عليه خلاقة أزراره % 32(@)(@@) % ثم التوى يطوي الطريق لجسمه % % ليلا حذار أن يبوح نهاره % 33(@)(@@) % وأتت ركائبه لحضرة ملكه % بودائع يعتادها أبراره % % 34(@)(@@) % وتوجهت سفراؤه بقضائه % في كل قلب لم يزل يختاره % 35(@)(@@) % وحمت جوانبه سيوف عزائم % % منه وطاف ببابه سماره % % 36(@)(@@) % أين الذين تحققوا بصفاته % % هذه العداة فأين هم أنصاره % 37(@)(@@) % من يدعي حب الإمام فإنما % % قذفت به نحو المنون بحاره % 38(@)(@@) % وسطا على جيش الكيان بصارم % غضب المضارب لا يفل غراره % 39(@)(@@) % من يهتدي أهل النهى بمناره % % ذاك الخليفة تقتفى أثاره % % 40(@)(@@) % إن الذين يبايعونك إنهم % % ليبايعون من اعتلت أسراره % PageV01P365 41(@)(@@) % فيمينك الحجر المكرم فيهم % يا نصبة خضعت له أخياره % % 42(@)(@@) % يا بيعة الرضوان دمت سعيدة % % حتى تعطل للإمام عشاره % 43(@)(@@) % إن الديار بلاقع ما لم يكن % صفوا للجين نزيلها ونضاره % 44(@)(@@) % المال يصلح كل شيء فاسد % وبه يزول عن الجواد عثاره % PageV01P366 البحر : كامل تام 1(@)(@@) % من ظن أن طريق أرباب العلى % % قول فجهل حائل وتعذر % 2(@)(@@) % إن السبيل إلى الإله عناية % منه بمن قد شاءه وتعزر % 3(@)(@@) % لا يرتضي لحقيقة وعزة % إلا إذا ضم السنابل بيدر % 4(@)(@@) % الحال يطلبه بشرط مقامه % فإذا ادعاه فحاله لك يشهر % 5(@)(@@) % يتخيل المسكين أن علومها % % ما بين أوراق الكتاب تسطر % 6(@)(@@) % هيهات بل ما أودعوا في كتبهم % % إلا يسيرا من أمور تعسر % 7(@)(@@) % لا يقرأ الأقوام غير نفوسهم % % في حالهم مع ربهم هل يحصر % 8(@)(@@) % فترى الدخيل يقيس فيه برأيه % % ليقال هذا منهم فيكبر % % 9(@)(@@) % وتناقضت أقواله إن لم يكن % % عن حاله فيما تقدم يخبر % 10(@)(@@) % علم الطريقة لا ينال براحة % ومقايس فاجهد لعلك تظفر % % PageV01P367 11(@)(@@) % غرت علوم القوم عن إدراك من % % لا يعتريه صبابة وتحير % % 12(@)(@@) % وتنفس مما يجن وأنة % % وجوى يزيد وعبرة لا تفتر % % 13(@)(@@) % وتذلل وتوله في غيبة % وتلذذ بمشاهد لا تظهر % % 14(@)(@@) % وتقبض عند الشهود وغيرة % إن قام شخص بالشريعة يسخر % 15(@)(@@) % وتخشع وتفجع وتشرع 
ms95	 % بتشرع لله لا يتيغير % 16(@)(@@) % هذا مقام القوم في أحوالهم % ليسوا كمن قال الشريعة مزجر % % 17(@)(@@) % ثم ادعى أن الحقيقة خالفت % ما الشرع جاء به ولكن تستر % % 18(@)(@@) % تبا لها من قالة من جاحد % % ويل له يوم الجحيم يسعر % 19(@)(@@) % أو من يشاهد في المشاهد مطرقا % ليقال هذا عابد متفكر % % 20(@)(@@) % هذا مرائي لا يلذ براحة % في نفسه إلا سويعة يتطر % PageV01P368 21(@)(@@) % لكنه من ذاك أسعد حالة % % وله النعيم إذا الجهول يفطر % PageV01P369 البحر : سريع 1(@)(@@) % عجبت من بحر بلا ساحل % وساحل ليس له بحر % 2(@)(@@) % وضحوة ليس لها ظلمة % وليلة ليس لها فجر % 3(@)(@@) % وكرة ليس لها موضع % يعرفها الجاهل والحبر % % 4(@)(@@) % وقبة خضراء منصوبة % جارية نقطتها القهر % 5(@)(@@) % وعمد ليس لها قبة % ولا مكان خفي السر % 6(@)(@@) % خطبت سرا لم يغيره كن % % فقيل هل هيمك الفكر % 7(@)(@@) % فقلت ما لي قدرة فارفقوا % % عليه في الكون ولا صبر % % 8(@)(@@) % فإن بالفكر إذا ما استوى % % في خلدي يتقد الجمر % 9(@)(@@) % فيصبح الكل حريقا فلا % % شفع يرى فيه ولا وتر % 10(@)(@@) % فقيل لي ما يجتنى زهره % من قال رفقا إنني حر % PageV01P370 11(@)(@@) % من خطب الخنساء في خدرهها % % متيما له يغله المهر % 12(@)(@@) % أعطيتها المهر وأنكحتها % % في ليلتي حتى بدا الفجر % 13(@)(@@) % فلم أجد غيري فمن ذا الذي % % أنكحته فلينظر الأمر % % 14(@)(@@) % فالشمس قد أدرج في ضوئها % % القمر الساطع والزهر % 15(@)(@@) % كالدهر مذموم وقد قال من % صلى عليه ربك الدهر % % PageV01P371 البحر : مخلع البسيط 1(@)(@@) % قد تاه غلماننا علينا % % فما لنا في الوجود قدر % 2(@)(@@) % أذنابنا صيرت رؤوسا % ما لي على ما أراه صبر % 3(@)(@@) % قد أوذي الله مثل هذا % % فالوقت حلو وقتا ومر % 4(@)(@@) % هذا هو الدهر يا خليلي % % فمن يقاسيه فهو دهر % PageV01P372 البحر : طويل 1(@)(@@) % ألم تدر أني واحد وكثير % % وإني بما أدري به لبصير % % 2(@)(@@) % وإني شكور بالذي أنا أهله % % وأني كما قال الإله كفور % 3(@)(@@) % ولكن لما عندي من العلم بالذي % % إذا أنا لم أذكره قيل غيور % 4(@)(@@) % تسترت عن 
ms96	 دهري بدهري فلم يكن % % لي الدهر إلا صاحب ووزير % 5(@)(@@) % كذا جاء في القرآن لإياك نستعين % ولم يأت إلا والمقام حظير % 6(@)(@@) % روائح دعوى واشتراك فكيف بي % % بتوحيد فعل والسميع بصير % 7(@)(@@) % بما قاله والأمر فيه محقق % كما قاله وإنه لعسير % % PageV01P373 البحر : بسيط تام 1(@)(@@) % مالي استناد ولا ركن ولا وزر % إلا إلي وإني العين والخبر % 2(@)(@@) % لي التحكم في عيني يحققه % علمي وكشفي فمني النفع والضرر % % 3(@)(@@) % لولاي ما كان للأسماء من أثر % أنا المسمى فلي الأسماء والأثر % 4(@)(@@) % انظر إليه بنا تجده عين أنا % % فالناظر الحق والمنظور والنظر % 5(@)(@@) % ولا تفرق فإن الفرق مجهلة % فلا يفرق إلا الحق والصور % % 6(@)(@@) % ألا ترى ليديه إذ توجهتا % % على خميرة من تدعونه بشر % 7(@)(@@) % قد فرق الله أعيانا فقال لنا % % هذا المقام وهذا الركن والحجر % % PageV01P374 البحر : مجزوء المديد 1(@)(@@) % ما لمن أبصرني % % غير ما أبصره % 2(@)(@@) % فله مني الذي % % بعد ذا أذكره % 3(@)(@@) % شجي قام به % وأنا أستره % % 4(@)(@@) % بل هو المعنى الذي % % لم أزل أظهره % 5(@)(@@) % وبدا منه لهم % % خبر أكبره % 6(@)(@@) % وأبى العقل الذي % % ما إلي مخبره % % 7(@)(@@) % وإن إيمان الورى % % في الورى معبره % 8(@)(@@) % فبه أسمعه % وبه أبصره % 9(@)(@@) % قدمي ساعية % وهي بي تظهره % % 10(@)(@@) % ويدي باطشة % % فأنا مصدره % % PageV01P375 11(@)(@@) % فأكتم الأمر الذي % % قلت لا تشهره % % 12(@)(@@) % طاب ذوقا عندنا % % جملة مخبره % % 13(@)(@@) % مثل ما طاب لنا % % خبرا أكبره % 14(@)(@@) % أنه ليس بهو % % والهو لا يحصره % 15(@)(@@) % فإذا قلت أنا % % فأنا أشعره % 16(@)(@@) % أنني لست أنا % % وأنا مظهره % 17(@)(@@) % إن ذا الهو المقا % % م الذي يبهره % 18(@)(@@) % إن تجلى بأنا % % فأنا أفقره % 19(@)(@@) % أو تجليت به % % وهو لا ينكره % % 20(@)(@@) % قام بي نعت الغنى % % وأنا أنكره % % PageV01P376 21(@)(@@) % ثم عن هذا أو ذا % % علمنا يكبره % PageV01P377 البحر : بسيط تام 1(@)(@@) % يا أيها الناس خافوا الله واعتمدوا % % عليه في كل حال إنكم صبر % 2(@)(@@) % ولا يزال وجود الحق الحق عينكم % في هذه الدار حتى ينقضي العمر % 3(@)(@@) % إذا نقلتم إلى الآخرى 
ms97	 فإن لكم % فيها شؤونا يراها من له نظر % % 4(@)(@@) % هناك والمؤمنون العالمون بها % % يرونها بعيون ما لها بصر % % 5(@)(@@) % فيها الكمال الذي بالنشء أطلبه % فيها المنافع ما فيها لنا ضرر % 6(@)(@@) % قدزء خص بالضر أقوام ذووا عمه % في دار خزي لهم فيها بما كفروا % % 7(@)(@@) % جاءت سعادتهم تمشي على قدم % فيما اتبلاهم به لو أنهم صبروا % % 8(@)(@@) % أعماهم الله عن أمر له خلفوا % % حتى يكون الذي يأتي به القدر % % 9(@)(@@) % أشقاهم الله في أشياء تسرهم % قد زينت لهم فيهم وما شحروا % % 10(@)(@@) % لو أنهم صبروا ما كان حالهم % إلا السعادة والإسعاد والظفر % PageV01P378 البحر : طويل 1(@)(@@) % إذا غار عبد للإله وقد رأى % % من الله انعاما لمن هو كافر % 2(@)(@@) % على رغمه والله يعلم أمره % وما الله فيما يقصد العبد جائر % % 3(@)(@@) % وتحجبه العادات إذ كان حكمها % % على بابه يجري وما الحق ظاهر % 4(@)(@@) % يعاقبه بالقبر في أرض غربة % % نهارا وليلا والمهيمن ساتر % PageV01P379 البحر : بسيط تام 1(@)(@@) % هنيت بالشهر بل هني بي الشهر % وما له بالذي يجري به أمر % 2(@)(@@) % له التصرف في الأركان أجمعها % % والحكم في يده والنفع والضر % 3(@)(@@) % وما له خبر بما يكونه % % عنه الإله العليم الواحد البر % 4(@)(@@) % لو أن يونس والحيتان تطلبه % % يكون من مكة لم يدر ما البحر % % 5(@)(@@) % لعلمنا بالذي أعطت معالمها % % من الذي أخبرت بكونه الزهر % 6(@)(@@) % فإن ربك أوحى أمرها بكذا % % فيها وما عندها ذوق ولا خبر % % 7(@)(@@) % مسخرات بأمر الله ليس لها % % إلا الشهادة والتسبيح والذكر % 8(@)(@@) % بألسن ما لنا فقه بما نطقت % لأن حاجبها ألحكم والفقر % 9(@)(@@) % تثني عليه بطبع فيه قد جبلت % % وما لها في الذي تثني به فكر % % 10(@)(@@) % بالله عالمة لله قائمة % في الله جاهدة في أمره الأمر % PageV01P380 11(@)(@@) % قال الخليل بها سترا لحكمته % وحجة للذي أودى به الفكر % 12(@)(@@) % وقد أتاها رسول الله وهو بها % % أدرى وأعلم فهو العالم البحر % % 13(@)(@@) % وما له في الذي يدريه من حكم % % مثل يعادله عبد ولا حر % 14(@)(@@) % القل دان له 
ms98	 والكثر دان له % % فليس يعجزه قل ولا كثر % 15(@)(@@) % الله أعظم أن يحظى به أحد % وكيف يحظى بمن رداوه الكبر % 16(@)(@@) % الكبرياء وما تحصى عوارفه % وليس يدري لها بجهلهم قدر % 17(@)(@@) % إن العوارف أستار المعارف لا % % يدخلك في ذاك إشكال ولا نكر % % 18(@)(@@) % فعندها العجز عن إحصائها عددا % وعندها أنها النائل النزر % 19(@)(@@) % خزائن الجود ما انسدت مغالقها % % لو انتهت لانتهى في العالم الفقر % % 20(@)(@@) % وفقره دائم لا ينتهي أبدا % كذاك نائله لا ينقضي عمر % PageV01P381 21(@)(@@) % الفقر بالذات ذاتي لصاحبه % ولو يدوم له من ربه اليسر % 22(@)(@@) % ما قلت إلا الذي قال الإله لنا % % فينا ففي كل يسر مدرج عسر % 23(@)(@@) % إن الإله بلا حد يحددنا % % مع الزمان لذا كان اسمه الدهر % 24(@)(@@) % لله قوم ذوو أعلم مقامهم % الشمس والتين والأحقاف والفجر % 25(@)(@@) % هم النجوم التي الأفلاك مركبها % % لا بل أقول هم الأحجار والتبر % % 26(@)(@@) % حازوا الكمال فلم يظفر بهم أحد % % غيري لأنهم الأشفاع والوتر % % 27(@)(@@) % سكرى حيارى تراهم في محاربهم % % وما لهم في سوى مطلوبهم فكر % 28(@)(@@) % قد استوى عندهم من ليس يعرفهم % % مع العليم بهم والسر والجهر % % 29(@)(@@) % هم الوجود ولكن لا وجود لهم % فليس يحجبهم نفع ولا ضر % 30(@)(@@) % لهم من الفلك العلوي صورته % ومن ثرى الأرض ما يأتي به الزهر % PageV01P382 31(@)(@@) % من المطاعم والأنهار شربهم % الماء والعسل النحلي والخمر % 32(@)(@@) % وشربهم لبن يأتي به بقر % هذا شرابهم مما له در % 33(@)(@@) % ويأكلون طعاما ما له صفة % منزه الطعم لا حلو ولا مر % 34(@)(@@) % مقامهم ما هم فيه وحالهم % ما يشتهون فهم بهالل غر % 35(@)(@@) % لا يجهلون ولا تدري مقاصدهم % سكناهم المجلس المعمور والقبر % 36(@)(@@) % خرس إذا نطقوا عمي إذا نظروا % % صم إذا سمعوا إيمانهم كفر % 37(@)(@@) % لا يهتدون ولا يهدون صاحبهم % % عمار أندية كثبانها حمر % PageV01P383 البحر : طويل 1(@)(@@) % رأيت وجود الدور يعطي الدوائر % % ويعطي وجود الدور فيه الدوائر % 2(@)(@@) % رميت بأمر لم ير العقل مثله % % بما أنا علام به أنا حائر % % 3(@)(@@) % رمى بي وجوه القوم 
ms99	 ثم يقول لي % % رميت وجوه القوم هل أنت ناظر % % 4(@)(@@) % رأى نظري بالحق ما لم يكن يرى % % إلا أنه الرائي لما هو ساتر % % 5(@)(@@) % رعى الله من يرعاه في كل حالة % وإن لم يكن ما قلته فهو خاسر % 6(@)(@@) % رقيت به حتى ظهرت لمستوى % % وجودي فقال الكشف ما هو حاضر % 7(@)(@@) % ربابة سهم الذم صير ذاتنا % % ونحن إشارات السهام الغوائر % % 8(@)(@@) % ربا بفؤادي عين إيمانه بنا % % وذلك كفر ما هو كافر % 9(@)(@@) % رأى الأمر من قبل الوقوع لأنه % % يرى في ثبوت العين ما هو ظاهر % 10(@)(@@) % رقيبا عليه غائبا ثم شاهدا % فما أنا مقهور ولا السر قاهر % PageV01P384 البحر : بسيط تام 1(@)(@@) % إني أرى صورا فيما يرى البصر % في كل جسم صقيل ما به صور % 2(@)(@@) % ولست أنكر ما أبصرت من صور % % والجسم خال كذا أعطاني النظر % % 3(@)(@@) % فما محل الذي أدركت من صور % إلا الخيال ومن أزماننا السحر % % 4(@)(@@) % وانظر بخاتمة الحشر التي وردت % أسماؤه فزهت بذكرها السور % PageV01P385 البحر : كامل تام 1(@)(@@) % كبر إلهك فالإله كبير % والخلق إن حقرته فكبير % 2(@)(@@) % ولذاك جاء بوزن أفعل فاعتبر % في لفظ أكبر فالمقام خطير % 3(@)(@@) % لا تحقرن الخلق إن مقامه الت % % عظيم والتعزيز والتوقير % 4(@)(@@) % فهو الدليل على مكون ذاته % فله التصور ما له التصوير % 5(@)(@@) % فإذا ذكرت الله وحد ذاته % فمقامها التوحيد لا التكثير % % 6(@)(@@) % ولتكثير النسب التي ثبتت له % فهو الوحيد وإنه لكثير % % 7(@)(@@) % فهو المريد وجودنا من عينه % % وإذا أراد وجودنا فقدير % % 8(@)(@@) % وهو المكلم والمناجي عبده % % بالطور في النيران وهو النور % 9(@)(@@) % وهو السميع هو البصير بخلقه % وهو العليم بما علمت خبير % 10(@)(@@) % إني رأيت قصيدتي ديباجة % فيها نضار رقمها وحرير % PageV01P386 11(@)(@@) % أولتها أسماءه ونعوته % % فلها على كل الوجوه ظهور % PageV01P387 البحر : مديد تام 1(@)(@@) % قد جرى في مثلنا مثل % علم في رأسه نار % 2(@)(@@) % بيننا وبين كن نسب % % فلنا في الكون آثار % 3(@)(@@) % إنه لمن تحققه % نقص حظ فيه أضرار % 4(@)(@@) % فرددناه لصاحبه % ما أنا في الرد مختار % % 5 
ms100	(@)(@@) % إنما الدنيا له ولنا % % في التي تليها أخبار % 6(@)(@@) % إنما يدري بصحة ذا % % من له في العلم مقدار % % 7(@)(@@) % والذي يلهو بعبرته % % ما له في القلب أبصار % % 8(@)(@@) % هذه الدنيا لهم تعب % ولنا عون وأنصار % 9(@)(@@) % للذي أرجوه من منح % % جلها أني لها جار % % 10(@)(@@) % هكذا قال الجليل لنا % % وأتى في ذاك أخبار % PageV01P388 البحر : بسيط تام 1(@)(@@) % إني رأيت وجودا لا يقيده % نعت ولا هو محدود فينحصر % 2(@)(@@) % في الحد وهو الذي في الحد يعرفه % % وما له في الذي يدري به خبر % 3(@)(@@) % تنزهت ذات من قد حار طالبها % % سبحانه جل أن تحظى به الفكر % % 4(@)(@@) % أقامني مثلا مثلا ونزهني % % عن كل شيء فلم يظفر بي النظر % 5(@)(@@) % هو الوجود الذي في كونه سند % لخلقه وله سمع هو البصر % 6(@)(@@) % إني لعبد لمن كانت هويته % % عيني وما أنا عين الحق فاعتبروا % % 7(@)(@@) % لو كنته لم أكن بالعجز متصفا % عن كون ما تظهر الأسباب والقدر % 8(@)(@@) % ولم يكن حاكما على تصرفنا % % سر يقال له في علمنا القدر % % 9(@)(@@) % إني عبيد فقير في تقلبه % % هذي نعوتي وأما اسمي هو البشر % % 10(@)(@@) % ووالدي آدم والكحل متصف % بعجزه للذي إليه يفتقر % PageV01P389 11(@)(@@) % فغايتي الفقر والتنزيه غايته % عن غايتي والغني عني هو الوزر % 12(@)(@@) % أعطيته الوصف من ذاتي فلي شرف % به تنزلت الآيات والسور % 13(@)(@@) % لولاي ما ظهرت في الصور نفخته % فالروح من نفس الرحمن فادكروا % % 14(@)(@@) % هذا الذي قلته الوحي يعضدن % فيه فقد جاءكم ما فيه معتبر % % 15(@)(@@) % لو كنت ذا بصر لكنت معتبرا % كذا يقول الإله الحق فافتكروا % % PageV01P390 البحر : طويل 1(@)(@@) % إذا ما ذكرت الله بالذكر نفسه % فما هو مذكور ولا أنا ذاكر % 2(@)(@@) % وذاك أتم الذكر في كل ذاكر % إذا أنت لم تعلمه ما أنت خابر % 3(@)(@@) % فكن عين ذكر الذكر لا تك ذاكرا % بوجه سوى هذا فإنك ظاهر % 4(@)(@@) % وكن واحدا من كل وجه تفز به % وتجلهك الأعداد واللثر حاضر % 5(@)(@@) % فمن شاء فليثبت ومن شاء فليزل % فهذا الذي ساقت إليه 