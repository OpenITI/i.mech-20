ms1421	 الظهر وتعجلي العصر فتغتسلي وتجمعين بين الصلاتين الظهر والعصر ، وتؤخرين المغرب وتعجلين العشاء ثم تغتسلين وتجمعين بين الصلاتين فافعلي وتغتسلين مع الفجر فافعلي وصومي إن قدرت على ذالك ، وهاذا أعجب الأمرين إلي ) )(@)(@@) ( حم ( 4 ) ك ) عن حمنة بنت جحش رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 12770 ) قال النبي :(@)(@@) | 30 ( ساب المؤمن كالمشرق على الهلكة ) )(@)(@@) البزار عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12771 ) قال النبي :(@)(@@) | 30 ( ساب الموتى كالمشرف على الهلكة ) )(@)(@@) ( طب ) عن ابن عمرو رضي الله عنه .(@)(@@) PageV04P456(@)(@@)(@@)(@@) $ ( 12772 ) قال النبي :(@)(@@) | 30 ( سابقنا سابق ، ومقتصدنا ناج ، وظالمنا مغفور له ) )(@)(@@) ابن مردويه والبيهقي في البعث عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 12773 ) قال النبي :(@)(@@) | 30 ( سأحدثكم بأمور الناس وأخلاقهم : الرجل يكون سريع الغضب سريع الفيء فلا له ولا عليه كفافا ، والرجل يكون بعيد الغضب سريع الفيء فذاك له ولا عليه ، والرجل يقتضي الذي له ويقضي الذي عليه فذاك لا له ولا عليه ، والرجل يقتضي الذي له ويمطل الناس الذي عليه فذاك عليه ولا له ) )(@)(@@) البزار عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12774 ) قال النبي :(@)(@@) | 30 ( الذي له ويمطل الناس الذي عليه فذاك عليه ولا له ) )(@)(@@) البزار عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12774 ) قال النبي :(@)(@@) | 30 ( سادة السودان أربعة : لقمان الحبشي ، والنجاشي ، وبلال ، ومهجع ) )(@)(@@) ابن عساكر عن عبد الرحمان بن يزيد بن جابر مرسلا .(@)(@@)(@@)(@@) $ ( 12775 ) قال النبي :(@)(@@) | 30 ( سارعوا في طلب العلم ، فالحديث من صادق خير من الدنيا وما عليها من ذهب وفضة ) )(@)(@@) الرافعي في تاريخه عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12776 ) قال النبي :(@)(@@) | 30 ( ساعة السبحة حين تزول عن كبد السماء ، وهي صلاة المخبتين ، وأفضلها في شدة الحر ) )(@)(@@) ابن عساكر عن عوف بن مالك رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12777 ) قال النبي :(@)(@@) | 30 ( ساعة في سبيل الله خير من خمسين حجة ) )(@)(@@) ( فر ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 12778 ) قال النبي :(@)(@@) | 30 ( ساعة من عالم متكىء على فراشه ينظر في علمه خير من عبادة العابد سبعين عاما ) )(@)(@@) ( فر ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12779 ) قال 
ms1422	 النبي :(@)(@@) | 30 ( ساعتان تفتح فيهما أبواب السماء ، وقلما ترد على داع دعوته : لحضور الصلاة ، والصف في سبيل الله ) )(@)(@@) ( طب ) عن سهل بن سعد رضي الله عنه .(@)(@@) PageV04P457(@)(@@)(@@)(@@) $ ( 12780 ) قال النبي :(@)(@@) | 30 ( ساعات الأذى في الدنيا يذهبن ساعات الأذى في الآخرة ) )(@)(@@) ( هب ) عن الحسن مرسلا ( فر ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12781 ) قال النبي :(@)(@@) | 30 ( ساعات الأذى يذهبن ساعات الخطايا ) )(@)(@@) ابن أبي الدنيا أبو بكر في الفرح عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 12782 ) قال النبي :(@)(@@) | 30 ( ساعات الأمراض يذهبن ساعات الخطايا ) )(@)(@@) ( هب ) عن أبي أيوب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12783 ) قال النبي :(@)(@@) | 30 ( سافروا تصحوا ) )(@)(@@) ابن السني وأبو نعيم في الطب عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12784 ) قال النبي :(@)(@@) | 30 ( سافروا تصحوا ، واغزوا تستغنوا ) )(@)(@@) ( حم ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12785 ) قال النبي :(@)(@@) | 30 ( سافروا تصحوا وترزقوا ) )(@)(@@) ( عب ) عن محمد بن عبد الرحمان مرسلا .(@)(@@)(@@)(@@) $ ( 12786 ) قال النبي :(@)(@@) | 30 ( سافروا تصحوا وتغنموا ) )(@)(@@) ( هق ) عن ابن عباس ، الشيرازي في الألقاب ( طس ) وأبو نعيم في الطب والقضاعي عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 12787 ) قال النبي :(@)(@@) | 30 ( سافروا مع ذوي الجدود وذوي الميسرة ) )(@)(@@) ( فر ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12788 ) قال النبي :(@)(@@) | 30 ( ساقي القوم آخرهم ) )(@)(@@) ( حم تخ د ) عن عبد الله بن أبي أوفى ا رضي الله عنه .(@)(@@) PageV04P458(@)(@@)(@@)(@@) $ ( 12789 ) قال النبي :(@)(@@) | 30 ( ساقي القوم آخرهم شربا ) )(@)(@@) ( ت ه ) عن أبي قتادة ( طس ) والقضاعي عن المغيرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12790 ) قال النبي :(@)(@@) | 30 ( سألت الله الشفاعة لأمتي فقال : لك سبعون ألفا يدخلون الجنة بغير حساب ولا عذاب ، قلت : رب زذني ، فحثا لي بيديه مرتين وعن يمينه وعن شماله ) )(@)(@@) ( هناد ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12791 ) قال النبي :(@)(@@) | 30 ( سألت الله أن يجعل حساب أمتي إلي لئلا تفتضح عند الأمم ، فأوحى الله عز وجل إلي : يا محمد بل أحاسبهم ، فإن كان منهم زلة سترتها عنك لئلا تفتضح عندك ) )(@)(@@) ( فر ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12792 ) قال النبي :(@)(@@) | 30 ( سألت الله في أبناء الأربعين من أمتي 
ms1423	 فقال : يا محمد قد غفرت لهم ، قلت : فأبناء الخمسين ؟ قال : إني قد غفرت لهم ، قلت : فأبناء الستين ؟ قال : قد غفرت لهم ، قلت : فأبناء السبعين ؟ قال : يا محمد إني لأستحيي من عبدي أن أعمره سبعين سنة يعبدني لا يشرك بي شيئا أن أعدبه بالنار ، فأما أبناء الأحقاب أبناء الثمانين والتسعين فإني واقف يوم القيامة فقائل لهم : أدخلوا من أحببتم الجنة ) )(@)(@@) أبو الشيخ عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 12793 ) قال النبي :(@)(@@) | 30 ( سألت جبريل أي الأجلين قضى موسى ؟ قال : أكملهما وأتمهما ؟ ( ع ك ) عن ا$ بن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 12794 ) قال النبي :(@)(@@) | 30 ( سألت جبريل عن هاذه الآية { ونفخ في الصور فصعق من في السماوات ومن في الأرض إلا من شاء الله } من الذين لم يشإ الله أن يصعقهم ؟ قال : هم الشهداء ثنية الله تعالى متقلدون أسيافهم حول عرشه ) )(@)(@@) ( ع قط ) في الأفراد ( ك ) و ابن مردويه والبيهقي في الشعب عن أبي هريرة رضي الله عنه .(@)(@@) PageV04P459(@)(@@)(@@)(@@) $ ( 12795 ) قال النبي :(@)(@@) | 30 ( سألت جبريل : هل ترى ربك ؟ قال : إن بيني وبينه سبعين حجابا من نور ، لو رأيت أدناها لاحترقت ) )(@)(@@) ( طس ) عن أنس رضي الله عنه . |(@)(@@)(@@)(@@) $ 12796 - قال النبي صلى الله عليه وسلم : ' سألت ربي أبناء العشرين من أمتي فوهبهم لي ' | ابن أبي الدنيا عن أبي هريرة رضي الله عنه . |(@)(@@)(@@)(@@) $ 12797 - قال النبي صلى الله عليه وسلم : ' سألت ربي أن لا أتزوج إلى أحد من أمتي ، ولا | يتزوج إلي أحد من أمتي إلا كان معي في الجنة ، فأعطاني ذلك ' ( طب ك ) عن | عبد الله بن أبي أوفى رضي الله عنه . |(@)(@@)(@@)(@@) $ 12798 - قال النبي صلى الله عليه وسلم : ' سألت ربي أن لا أزوج إلا من أهل الجنة ، ولا | أتزوج إلا من أهل الجنة ' الشيرازي في الألقاب عن ابن عباس رضي الله عنهما . |(@)(@@)(@@)(@@) $ 12799 - قال النبي صلى الله عليه وسلم : ' سألت ربي أن لا يدخل أحدا من أهل بيتي النار | فأعطانيها ' أبو القاسم بن بشران في أماليه عن عمران بن حصين رضي الله عنه . |(@)(@@)(@@)(@@) $ 12800 - قال 
ms1424	 النبي صلى الله عليه وسلم : ' سألت ربي أن لا يعذب اللاهين من ذرية البشر | فأعطانيهم ' ( ش قط ) في الأفراد والضياء عن أنس رضي الله عنه . |(@)(@@)(@@)(@@) $ 12801 - قال النبي صلى الله عليه وسلم : ' سألت ربي أن يكتب على أمتي سبحة الضحى ، | فقال : تلك صلاة الملائكة ، من شاء صلاها ، ومن شاء تركها ، ومن صلاها فلا | يصلها حتى ترتفع ' ( فر ) عن عبد الله بن يزيد رضي الله عنه . |(@)(@@)(@@)(@@) $ 12802 - قال النبي صلى الله عليه وسلم : ' سألت ربي ثلاثا ، فأعطاني اثنتين ومنعني واحدة : | سألت ربي أن لا يهلك أمتي بالسنة فأعطانيها ، وسألته أن لا يهلك أمتي بالغرق | PageV04P460 | فأعطانيها ، وسألته أن لا يجعل بأسهم بينهم فمنعنيها ' ( حم هق ) عن سعد رضي | الله عنه ( ز ) |(@)(@@)(@@)(@@) $ 12803 - قال النبي صلى الله عليه وسلم : ' سألت ربي فأعطاني أولاد المشركين خدما لأهل | الجنة ، وذلك لأنهم لم يدركوا ما أدرك آباؤهم من الشرك ، ولأنهم في الميثاق | الأول ' أبو الحسن ابن ملة في أماليه عن أنس رضي الله عنه . |(@)(@@)(@@)(@@) $ 12804 - قال النبي صلى الله عليه وسلم : ' سألت ربي فيما تختلف فيه أصحابي من بعدي ، | فأوحى إلي : يا محمد ، إن أصحابك عندي بمنزلة النجوم في السماء ، بعضها أضوأ من بعض ، فمن أخذ بشيء مما هم عليه من اختلافهم فهو عندي على | هدى ' السجزي في الإبانة وابن عساكر عن عمر رضي الله عنه . |(@)(@@)(@@)(@@) $ 12805 - قال النبي صلى الله عليه وسلم : ' سأل موسى ربه فقال : يا رب ! ما أدنى أهل الجنة | منزلة ؟ قال : هو رجل يجيء بعد ما يدخل أهل الجنة الجنة ، فيقال له : ادخل | الجنة ، فيقول : أي رب ، كيف وقد نزل الناس منازلهم وأخذوا أخذاتهم ، فيقال | له : أترضى أن يكون لك مثل ملك ملك من ملوك الدنيا ؟ فيقول : رضيت رب ، | فيقول : هذا لك وعشرة أمثاله ولك ما اشتهت نفسك ولذت عينك ، فيقول : | رضيت رب ، قال : رب فأعلاهم منزلة ، قال : أولئك الذين أردت غرست | كرامتهم بيدي وختمت عليها ، فلم تر عين ، ولم تسمع أذن ، ولم يخطر على قلب | بشر ' ( حم م ت ) عن المغيرة 
ms1425	 بن شعبة رضي الله عنه ( ز ) |(@)(@@)(@@)(@@) $ 12806 - قال النبي صلى الله عليه وسلم : ' سام أبو العرب ، وحام أبو الحبش ، ويافث أبو | الروم ' ( حم ت ك ) عن سمرة رضي الله عنه . |(@)(@@)(@@)(@@) $ 12807 - قال النبي صلى الله عليه وسلم : ' ساووا بين أولادكم في العطية ، فلو كنت مفضلا | PageV04P461 | أحدا لفضلت النساء ' ( طب خط ) وابن عساكر عن ابن عباس رضي الله عنهما(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 12808 ) قال النبي :(@)(@@) | 30 ( سألت ربي مسألة ووددت أني لم أكن سألته إياها ، قلت : يا رب إنه كان قبلي رسل : منهم من كان يحيي الموتى ، ومنهم من سخرت له الريح ، فقال : ألم أجدك يتيما فآويتك ؟ قلت : بلى يا رب ، قال : ألم أجدك ضالا فهديتك ؟ قلت : بلى يا رب ، قال : ألم أجدك عائلا فأغنيتك ؟ قلت : بلى يا رب ، قال : ألم أشرح لك صدرك ؟ ألم أضع عنك وزرك الذي أنقض ظهرك ، ألم أرفع لك ذكرك ؟ قلت : بلى يا رب ، فودت أني لم أسأله ) )(@)(@@) ( هق كر ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 12809 ) قال النبي :(@)(@@) | 30 ( سألت الله يا علي فيك خمسا فمنعني واحدة وأعطاني أربعا : سألت الله أن يجمع عليك أمتي فأبى علي ، وأعطاني فيك أن أول من تنشق عنه الأرض يوم القيامة أنا وأنت معي ، معك لواء الحمد وأنت تحمله بين يدي تسبق به الأولين والآخرين ، وأعطاني أنك ولي المؤمنين بعدي ) )(@)(@@) ( خط ) و الرافعي عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12810 ) قال النبي :(@)(@@) | 30 ( سألت الله عز وجل أن يقدمك ثلاثا فأبى علي إلا أن يقدم أبا بكر قاله لعلي ) )(@)(@@) ( خط كر ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12811 ) قال النبي :(@)(@@) | 30 ( سألت ربي أربعا ، فأعطاني ثلاثا ومنعني واحدة : سألته أن لا يجمع أمتي على ضلالة فأعطانيها ، وسألته أن لا يهلكهم بالسنين كما أهلك الأمم قبلهم فأعطانيها ، وسألته أن لا يظهر عليهم عددا من غيرهم فأعطانيها ، وسألته أن لا يلبسهم شيعا ولا يذيق بعضهم بأس بعض فمنعنيها ) )(@)(@@) ( حم PageV04P462 طب ) عن أبي نصرة الغفاري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12812 ) قال النبي :(@)(@@) | 30 ( سألت 
ms1426	 ربي عز وجل ثلاث خصال لأمتي ، فأعطاني اثنتين ومنعني واحدة : قلت : يا رب لا تهلك أمتي جوعا ، قال : هاذه ، قلت : يا رب لا تسلط عليهم عدوا من غيرهم يعني أهل الشرك فيجتاحهم قال : لك ذاك ، قلت : يا رب لا تجعل بأسهم بينهم ، فمنعني هاذه ) )(@)(@@) ( طب ) عن جابر بن سمرة عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12813 ) قال النبي :(@)(@@) | 30 ( سألت جبريل عن هاذه الآية { ونفخ في الصور فصعق من في السماوات ومن في الأرض إلا من شاء الله } من الذين لم يشإ الله أن يصعقهم ؟ قال : هم شهداء الله عز وجل ) )(@)(@@) ( ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12814 ) قال النبي :(@)(@@) | 30 ( سألت ربي عز وجل فوعدني أن يدخل من أمتي سبعين ألفا على صورة القمر ليلة البدر ، فاستزدت ربي ، فزادني مع كل ألف سبعين ألفا ، فقلت : أي رب إن لم يكن هاؤلاء مهاجري أمتي ، قال : إذن أكملهم لك من الأعراب ) )(@)(@@) ( حم ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12815 ) قال النبي :(@)(@@) | 30 ( سألت ربي عز وجل ، هل لقاتل مؤمن من توبة ؟ فأبى علي ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12816 ) قال النبي :(@)(@@) | 30 ( سألت ربي لأصهاري الجنة فأعطانيها البتة ) )(@)(@@) أبو الخير الحاكمي القزويني عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 12817 ) قال النبي :(@)(@@) | 30 ( سألت الله البلاء ، فسله العافية ) )(@)(@@) ( ت ) حسن عن معاذ قال : سمع النبي رجلا يقول : اللهم إني أسألك الصبر قال فذكره .(@)(@@) PageV04P463(@)(@@)(@@)(@@) $ ( 12818 ) قال النبي :(@)(@@) | 30 ( سأل موسى ربه عن ست خصال كان يظن أنها له خاصة ، والسابعة لم يكن موسى يحبها قال : يا رب أي عبادك أتقى ؟ قال : الذي يذكر الله ولا ينسى ، قال : فأي عبادك أهدى ؟ قال : الذي يتبع الهدى ، قال : فأي عبادك أحكم ؟ قال : الذي يحكم للناس كما يحكم لنفسه ، قال : فأي عبادك أعلم ؟ قال : عالم لا يشبع من العلم يجمع علم الناس إلى علمه ، قال : فأي عبادك أعز ؟ قال : الذي إذا قدر عفا ، قال : فأي عبادك أعبد ، قال : الذي يرضى بما أوتي ، قال : فأي عبادك أفقر 
ms1427	 ؟ قال : صاحب سفر ، فقال رسول الله في الحديث : ليس الغني عن ظهر مال ، إنما الغني غني النفس ، فإذا أراد الله بعبد خيرا جعل غناه في نفسه ، وتقاه في قلبه ؛ وإذا أراد الله بعبد شرا ، جعل فقره بين عينيه ) )(@)(@@) الروياني وأبو بكر بن المقري في فوائده وابن كلال ( كر ) عن أبي هريرة رضي الله عنه وروى ( خب ) بعضه .(@)(@@)(@@)(@@) $ ( 12819 ) قال النبي :(@)(@@) | 30 ( سأل موسى ربه تعالى حين أعطاه التوراة أن يعلمه دعوة يدعو بها ، فأمره أن يدعو بلا إلاه إلا الله ، فقال موسى : يا رب كل عبادك يدعو بها ، وأنا أريد أن تخصني بدعوة أدعوك بها ، فقال تعالى : يا موسى لو أن السماوات وساكنها ، والأرض وساكنها ، والبحار وما فيها وضعوا في كفة ، ووضعت لا إلاه إلا الله في كفة لوزنت لا إلاه إلا الله ) )(@)(@@) ( ع ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12820 ) قال النبي :(@)(@@) | 30 ( سألت عن شيء ما سألني عنه أحد من أمتي ، مدة أمتي من الرخاء مائة سنة ، قيل : فهل لذالك من آية ؟ قال : نعم ، الخسف والرجف وإرسال الشياطين المخبلة على الناس ) )(@)(@@) ( حم ك ) عن عبادة بن الصامت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12821 ) قال النبي :(@)(@@) | 30 ( سئلت اليهود عن موسى فأكثروا فيه وزادوا ونقصوا حتى كفروا ، وسئلت النصارى عن عيسى فأكثروا فيه وزادوا ونقصوا حتى كفروا ، PageV04P464 وإنه سيفشو عني أحاديث ، فما أتاكم من حديثي فاقرؤوا كتاب الله واعتبروه ، فما وافق كتاب الله فأنا قلته ، وما لم يوافق كتاب الله فلم أقله ) )(@)(@@) ( طب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 12822 ) قال النبي :(@)(@@) | 30 ( سائل العلماء ، وخالل الحكماء ، وجالس الكبراء ) )(@)(@@) الحكيم عن أبي جحيفة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12823 ) قال النبي :(@)(@@) | 30 ( سائلكم بشيء يجمع ذالك كله ، تقولون : اللهم إنا نسألك مما سألك نبيك محمد عبدك ورسولك ، ونستعيذك مما استعاذ به منك محمد عبدك ورسولك ، أنت المستعان وعليك البلاغ ، ولا حول ولا قوة إلا بالله ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12824 ) قال النبي :(@)(@@) | 30 ( ساعات الأذى في الدنيا يذهبن ساعات الأذى 
ms1428	 في الآخرة ) )(@)(@@) ابن شاهين عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12825 ) قال النبي :(@)(@@) | 30 ( سؤال الغني شين في وجهه ، إن أعطي قليلا فقليل ، وإن أعطي كثيرا فكثير ) )(@)(@@) ابن النجار عن عمران بن حصين رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12826 ) قال النبي :(@)(@@) | 30 ( ساعة في سبيل الله خير من خمسين حجة ) )(@)(@@) الديلمي عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 12827 ) قال النبي :(@)(@@) | 30 ( سام أبو العرب ، وحام أبو الحبش ، ويافث أبو الروم ) )(@)(@@) ( حم ت ) حسن و ابن سعد ( ع طب ك ض ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12828 ) قال النبي :(@)(@@) | 30 ( سافروا تصحوا ، واغنموا تحلوا ) )(@)(@@) أبو عبد الله في معجمه ابن وضاح في فضل الناس العمائم عن أبي المليح الهذلي عن أبيه .(@)(@@) PageV04P465(@)(@@)(@@)(@@) ||| ( السين مع الباء(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 12829 ) قال النبي :(@)(@@) | 30 ( سباب المسلم فسوق ، وقتاله كفر ) )(@)(@@) ( حم ق ت ن ه ) عن ابن مسعود ( ه ) عن أبي هريرة وعن سعد ( طب ) عن عبد الله بن مغفل ، وعن عمرو بن النعمان بن مقرن ( قط ) في الأفراد عن جابر رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 12830 ) قال النبي :(@)(@@) | 30 ( سباب المسلم فسوق ، وقتاله كفر ، وحرمة ماله كحرمة دمه ) )(@)(@@) ( طب ) عن ابن مسعزد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12831 ) قال النبي :(@)(@@) | 30 ( سبحانك لا إلاه إلا أنت يا ذا الجلال والإكرام ) )(@)(@@) ( طب ) عن ابن عمر أن سعدا دعا بهاذا الدعاء على كلب فأهلكه الله .(@)(@@)(@@)(@@) $ ( 12832 ) قال النبي :(@)(@@) | 30 ( سبحان الله إنك لا تطيقه ولا تستطيعه ، هل قلت : اللهم آتنا في الدنيا حسنة وفي الآخرة حسنة وقنا عذاب النار ) )(@)(@@) ( حم خد م ت ن ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 12833 ) قال النبي :(@)(@@) | 30 ( سبحان الله ، أين الليل إذا جاء النهار ؟ ) )(@)(@@) ( حم ) عن التنوخي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12834 ) قال النبي :(@)(@@) | 30 ( سبحان الله بئسما جزتها ، نذرت لله إن نجاها الله عليها لتنحرنها ، لا وفاء لنذر في معصية الله ، ولا فيما لا يملك العبد ) )(@)(@@) ( حم م د ) عن عمران بن حصين رضي الله عنه ( ز ) .(@)(@@) PageV04P466(@)(@@)(@@)(@@) $ ( 12835 ) قال النبي :(@)(@@) | 30 ( سبحان الله ماذا 
ms1429	 أنزل الليلة من الفتن ، وماذا فتح من الخزائن ، أيقظوا صواحب الحجر ، فرب كاسية في الدنيا عارية في الآخرة ) )(@)(@@) ( حم خ ت ) عن أم سلمة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 12836 ) قال النبي :(@)(@@) | 30 ( سبحان الله ماذا أنزل من التشديد في الدين ، والذي نفسي بيده ، لو أن رجلا قتل في سبيل اللبه ثم أحيي ، ثم قتل ثم أحيي ، ثم قتل وعليه دين ما دخل الجنة حتى يقضى عنه دينه ) )(@)(@@) ( حم ن ك ) عن محمد بن جحش رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 12837 ) قال النبي :(@)(@@) | 30 ( سبحان الله نصف الميزان ، والحمد لله تملأ الميزان ، والله أكبر تملأ ما بين السماء والأرض والطهور نصف الإيمان ، والصوم نصف الصبر ) )(@)(@@) ( حم هب ) عن رجل من بني سليم .(@)(@@)(@@)(@@) $ ( 12838 ) قال النبي :(@)(@@) | 30 ( سبحان الله نصف الميزان ، والحمد لله ملء الميزان ، والله أكبر ملء ما بين السماء والأرض ، ولا إلاه إلا الله ليس دونها ستر ولا حجاب حتى تخلص إلى ربها عز وجل ) )(@)(@@) السجزي في الإبانة عن ابن عمر وابن عساكر عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12839 ) قال النبي :(@)(@@) | 30 ( سبحان الله والحمد لله ولا إلاه إلا الله والله أكبر في ذنب المسلم مثل الآكلة في جنب ابن آدم ) )(@)(@@) ابن السني عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 12840 ) قال النبي :(@)(@@) | 30 ( سبحان الله هاذا كما قال قوم موسى اجعل لنا إلاها كما لهم آلهة ، والذي نفسي بيده لتركبن سنن من كان قبلكم ) )(@)(@@) ( ت ) عن أبي واقد رضي الله عنه ( ز ) .(@)(@@) PageV04P467(@)(@@)(@@)(@@) $ ( 12841 ) قال النبي :(@)(@@) | 30 ( سبحان الله لا بأس أن يؤجر ويحمد ) )(@)(@@) ( حم د ) عن سهل بن الحنظلية رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 12842 ) قال النبي :(@)(@@) | 30 ( سبحي الله عشرا ، واحمدي الله عشرا ، وكبري الله عشرا ، ثم سلي الله ما شئت ، فإنه يقول قد فعلت قد فعلت ) )(@)(@@) ( حم ن ت حب ك ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12843 ) قال النبي :(@)(@@) | 30 ( سبحي الله مائة تسبيحة فإنها تعدل لك مائة رقبة من ولد إسماعيل ، واحمدي الله مائة تحميدة ، فإنها تعدل لك مائة 
ms1430	 فرس مسرجة ملجمة تحملين عليها في سبيل الله ، وكبري الله مائة تكبيرة فإنها تعدل لك مائة بدنة مقلدة متقبلة ، وهللي الله مائة تهليلة فإنها تملأ ما بين السماء والأرض ، ولا يرفع يومئد لأحد عمل أفضل منها إلا أن يأتي بمثل ما أتيت ) )(@)(@@) ( حم طب ك ) عن أم هانىء رضي الله عنها .(@)(@@)(@@)(@@) $ ( 12844 ) قال النبي :(@)(@@) | 30 ( سبحوا ثلاث تسبيحات ركوعا وثلاث تسبيحات سجودا ) )(@)(@@) ( هق ) عن محمد بن علي مرسلا .(@)(@@)(@@)(@@) $ ( 12845 ) قال النبي :(@)(@@) | 30 ( سبع مواطن لا تجوز فيها الصلاة : ظاهر بيت الله ، والمقبرة ، والمزبلة ، والمجزرة ، والحمام ، وعطن الإبل ، ومحجة الطريق ) )(@)(@@) ( ه ) عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12846 ) قال النبي :(@)(@@) | 30 ( سبع يجري للعبد أجرهن وهو في قبره بعد موته : من علم علما ، أو أجرى نهرا ، أو حفر بئرا ، أو غرس نخلا ، أو بنى مسجدا ، أو ورث مصحفا ، أو ترك ولدا يستغفر له بعد موته ) )(@)(@@) البزار وسمويه عن أنس رضي الله عنه .(@)(@@) PageV04P468(@)(@@)(@@)(@@) $ ( 12847 ) قال النبي :(@)(@@) | 30 ( سبعة في ظل العرش يوم لا ظل إلا ظله : رجل ذكر الله ففاضت عيناه ، ورجل يحب عبدا لا يحبه إلا لله ، ورجل قلبه معلق بالمساجد من شدة حبه إياها ، ورجل يعطي الصدقة بيمينه فيكاد يخفيها عن شماله ، وإمام مقسط في رعيته ، ورجل عرضت عليه امرأة نفسها ذات منصب وجمال فتركها لجلال الله ، ورجل كان في سرية مع قوم فلقوا العدو فانكشفوا فحمى آثارهم حتى نجا ونجوا أو استشهد ) )(@)(@@) ابن زنجويه عن الحسن مرسلا ، ابن عساكر عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12848 ) قال النبي :(@)(@@) | 30 ( سبعة لعنتهم وكل نبي مجاب : الزائد في كتاب الله ، والمكذب بقدر الله ، والمستحل حرمة الله ، والمستحل من عترتي ما حرم الله ، والتارك لسنتي ، والمستأثر بالفيء ، والمتجبر بسلطانه ليعز من أذل الله ويذل من أعز الله ) )(@)(@@) ( طب ) عن عمرو بن شغوى رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12849 ) قال النبي :(@)(@@) | 30 ( سبعة يظلهم الله تحت ظل عرشه يوم لا ظل إلا ظله : رجل قلبه معلق بالمساجد ، ورجل دعته امرأة ذات منصب فقال : إني والله أخاف 
ms1431	 الله وعين حرست في سبيل الله ، وعين بكت من خشية الله ) )(@)(@@) البيهقي في الأسماء عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12850 ) قال النبي :(@)(@@) | 30 ( سبعة يظلهم الله في ظله يوم لا ظل إلا ظله : إمام عادل ، وشاب نشأ في عبادة الله ، ورجل قلبه معلق بالمسجد إذا خرج منه حتى يعود إليه ، ورجلان تحابا الله فاجتمعا على ذالك وافترقا عليه ، ورجل ذكر الله خاليا ففاضت عيناه ، ورجل دعته امرأة ذات منصب وجمال فقال : إني أخاف الله رب العالمين ، ورجل تصدق بصدقة فأخفاها حتى لا تعلم شماله ما تنفق يمينه ) )(@)(@@) مالك PageV04P469 ( ت ) عن أبي هريرة وأبي سعيد ( حم ق ن ) عن أبي هريرة ( م ) عن أبي هريرة وأبي سعيد رضي الله عنهم معا .(@)(@@)(@@)(@@) $ ( 12851 ) قال النبي :(@)(@@) | 30 ( سبعون ألفا من أمتي يدخلون الجنة بغير حساب هم الذين لا يكتوون ولا يكوون ولا يسترقون ولا يتطيرون وعلى ربهم يتوكلون ) )(@)(@@) البزار عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12852 ) قال النبي :(@)(@@) | 30 ( سبق الكتاب أجله ، اخطبها إلى نفسها ) )(@)(@@) ( ه ) عن الزبير رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 12853 ) قال النبي :(@)(@@) | 30 ( سبق المفردون المستهترون في ذكر الله ، يضع الذكر عنهم أثقالهم فيأتون يوم القيامة خفاقا ) )(@)(@@) ( ت ك ) عن أبي هريرة ( طب ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12854 ) قال النبي :(@)(@@) | 30 ( سبق المهاجرون الناس بأربعين خريفا إلى الجنة ، يتنعمون فيها والناس محبوسون للحساب ، ثم تكون الزمرة الثانية مائة خريف ) )(@)(@@) ( طب ) عن مسلمة بن مخلد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12855 ) قال النبي :(@)(@@) | 30 ( سبق درهم مائة ألف درهم ، رجل له درهمان أخذ أحدهما فتصدق به ، ورجل له مال كثير فأخذ من عرضه مائة ألف فتصدق بها ) )(@)(@@) ( ن ) عن أبي ذر ( ن حب ك ) عن أبي هريرة رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 12856 ) قال النبي :(@)(@@) | 30 ( سبقكما بها الدوسي ) )(@)(@@) ( ك ) عن زيد بن ثابت رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 12857 ) قال النبي :(@)(@@) | 30 ( سبقكن يتامى بدر ، ولاكن سأدلكن على ما هو خير لكن من ذالك : تكبرن الله على إثر كل صلاة ثلاثا وثلاثين تكبيرة 
ms1432	 ، وثلاثا وثلاثين PageV04P470 تسبيحة ، وثلاثا وثلاثين تحميدة ، ولا إلاه إلا الله وحده لا شريك له ، له الملك وله الحمد وهو على كل شيء قدير ) )(@)(@@) ( د ) عن أم الحكم بنت الزبير رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 12858 ) قال النبي :(@)(@@) | 30 ( سبحانك اللهم ، وبحمدك ، وتبارك اسمك ، وتعالى جدك ، ولا إلاه غيرك ) )(@)(@@) ( حب قط ) عن أنس رضي الله عنه ، قال ( قط ) : هاذا الحديث غير محفوظ .(@)(@@)(@@)(@@) $ ( 12859 ) قال النبي :(@)(@@) | 30 ( سبحانك رب العالمين ) )(@)(@@) ( طب ) عن معاوية رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12860 ) قال النبي :(@)(@@) | 30 ( سبحان الله ، خمس من الغيب لا يعلمهن إلا الله : { إن الله عنده علم الساعة ، وينزل الغيث ، ويعلم ما في الأرحام ، وما تدري نفس ماذا تكسب غدا ، وما تدري نفس بأي أرض تموت ، إن الله عليم خبير } . ولاكن إن شئت حدثتك بمعالم لها دون ذالك : إذا رأيت الأمة ولدت ربها ورأيت أصحاب البنيان يتطاولون بالبنيان ، ورأيت الحفاة الجياع العالة كانوا رؤوس الناس فذالك من معالم الساعة ومن أشراطها ) )(@)(@@) ( حم بز ) عن ابن عباس رضي الله عنهما أن جبريل قال : يا رسول الله حدثني متى الساعة ؟ قال فذكره ( حم ) عن أبي عامر أو أبي مالك ( كر ) عن ابن غنم رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12861 ) قال النبي :(@)(@@) | 30 ( سبحان الله الذي يرسل عليهم الفتن إرسال القطر ) )(@)(@@) ( طب ض ) عن بلال رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12862 ) قال النبي صلى الله عليه وسلم سبحان الله ، ترسل الفتن عليهم إرسال القطر PageV04P471 البغوي و أبو نعيم عن عبد الله بن سيلان رضي الله عنه )(@)(@@)(@@)(@@) $ ( 12863 ) قال النبي :(@)(@@) | 30 ( سبحان الله ، ماذا يرسل عليهم من الفتن كإرسال القطر ) )(@)(@@) ( طب ) عن جرير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12864 ) قال النبي :(@)(@@) | 30 ( سبحان الله إن هي إلا من مكارم الأخلاق أخذ الصغير وإعطاء الكبير ، وأخذ الكبير وإعطاء الصغير ، وخيركم أحسنكم قضاء ) )(@)(@@) ( طب ) عن معاذ رضي الله عنه قال سئل رسول الله عن استقراض الخمير والخبز ؟ قال فذكره .(@)(@@)(@@)(@@) $ ( 12865 ) قال النبي :(@)(@@) | 30 ( سبحان الله ، هاذا من الشيطان فيجلس في مركن ، فإذا رأت الصفرة فوق 
ms1433	 الماء فلتغتسل للظهر والعصر غسلا واحدا ، وتغتسل للمغرب والعشاء غسلا واحدا ، وتغتسل للفجر غسلا وتتوضأ فيما بين ذالك ) )(@)(@@) ( ك ) عن أسماء بنت عميس قالت : قلت لرسول الله إن فاطمة بنت أبي حبيش استحيضت منذ كذا وكذا فلم تصل قال فذكره .(@)(@@)(@@)(@@) $ ( 12866 ) قال النبي :(@)(@@) | 30 ( سبحان الله ، وهل أنزل الله من داء في الأرض إلا جعل له شفاء ) )(@)(@@) ( حم ) عن رجل من الأنصار .(@)(@@)(@@)(@@) $ ( 12867 ) قال النبي :(@)(@@) | 30 ( سبحان الله ، أين الليل إذا جاء النهار ) )(@)(@@) عن التنوخي رسول هرقل أن هرقل كتب إلى النبي : يدعوني إلى جنة عرضها السماوات والأرض فأين النار ؟ قال فذكره .(@)(@@)(@@)(@@) $ ( 12868 ) قال النبي :(@)(@@) | 30 ( سبحان الله ، لا يعلم ما في غد إلا الله ، لا تقولوا هاذا ، وقولوا : أتيناكم أتيناكم ، فحيانا وحياكم ) )(@)(@@) ( هق ) عن عمرة بنت عبد الرحمان مرسلا .(@)(@@) PageV04P472(@)(@@)(@@)(@@) $ ( 12869 ) قال النبي :(@)(@@) | 30 ( سبحان الله الذي لا إلاه غيره ، الإلاه العالم الدائم الذي لا ينفد ، القائم الذي لا يغفل ، بديع السماوات والأرض ، المبدغ غير المبتدع ، خالق ما يرى وما لا يرى ، عالم كل علم بغير تعلم ) )(@)(@@) أبو الشيخ في العظمة عن أسامة بن زيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12870 ) قال النبي :(@)(@@) | 30 ( سبحان الله ، تنزيه الله من كل سوء ) )(@)(@@) الديلمي عن طلحة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12871 ) قال النبي :(@)(@@) | 30 ( سبحان ذي الملك والملكوت سبحان رب العزة والجبروت ، سبحان الحي الذي لا يموت ) )(@)(@@) الديلمي عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12872 ) قال النبي :(@)(@@) | 30 ( سبحان الله نصف الميزان ، والحمد لله تملأ الميزان ، ولا إلاه إلا الله تملأ ما بين السماء والأرض ، والطهور نصف الإيمان ، والصلاة نور ، والزكاة برهان ، والصبر ضياء ، والقرآن حجة لك أو عليك ، كل الناس يغدو ، فمبتاع فمعتقها ، أو بائعها فموبقها ) )(@)(@@) ( هب ) عن أبي سلمة بن عبد الرحمان مرسلا .(@)(@@)(@@)(@@) $ ( 12873 ) قال النبي :(@)(@@) | 30 ( سبحان الله ما تستقبلون وماذا يستقبلكم ، شهر رمضان يغفر الله في أول ليلة لكل أهل هاذه القبلة ، قيل : يا رسول الله ، المنافق ؟ قال : المنافق كافر ، وليس للكافر في ذا شيء ) )(@)(@@) ( هب ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12874 
ms1434	 ) قال النبي :(@)(@@) | 30 ( سبعة لا ينظر الله إليهم يوم القيامة ولا يزكيهم ، ولا يجمعهم مع العالمين ، يدخلهم النار أول الداخلين إلا أن يتوبوا ، إلا أن يتوبوا ، إلا أن يتوبوا ، فمن تاب تاب الله عليه : الناكح يده ، والفاعل والمفعول به ، ومدمن الخمر ، والضارب أبويه حتى يستغيثا ، والمؤذي جيرانه حتى يلعنوه ، والناكح حليلة جاره ) )(@)(@@) الحسن بن عرفة في جزئه ( هب ) عن أنس رضي الله عنه .(@)(@@) PageV04P473(@)(@@)(@@)(@@) $ ( 12875 ) قال النبي :(@)(@@) | 30 ( سبعة يظلهم الله في ظل عرشه يوم لا ظل إلا ظله : الإمام العادل ، وشاب نشأ في عبادة الله ، ورجل قلبه معلق في المساجد ، ورجلان تحابا في الله ، اجتمعا عليه وتفرقا عليه ، ورجل دعته امرأة ذات منصب وجمال فقال : إني أخاف الله رب العالمين ، ورجل تصدق بصدقة فأخفاها حتى لا تعلم شماله ما تنفق يمينه ، ورجل ذكر الله خاليا ففاضت عيناه ) )(@)(@@) ( حم خ م ن حب ) عن أبي هريرة رضي الله عنه ( ت ) حسن صحيح عن أبي هريرة عن أبي سعيد ( م ) عن أبي سعيد وأبي هريرة رضي الله عنهما معا .(@)(@@)(@@)(@@) $ ( 12876 ) قال النبي :(@)(@@) | 30 ( سبعة يظلهم الله تحت ظله يوم لا ظل إلا ظله : إمام مقسط ، ورجل لقيته امرأة ذات جمال ومنصب فعرضت نفسها عليه فقال : إني أخاف الله رب العالمين ورجل قلبه متعلق بالمساجد ، ورجل تعلم القرآن في صغره فهو يتلوه في كبره ، ورجل تصدق بيمينه فأخفاها عن شماله ، ورجل ذكر الله في برية ففاضت عيناه خشية من الله ، ورجل لقي رجلا فقال : إني أحبك في الله ، فقال له الرجل : وأنا أحبك في الله ) )(@)(@@) ( هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12877 ) قال النبي :(@)(@@) | 30 ( سبع خصال هن جوامع الخير : حب الإسلام وأهله ، والفقراء ومجالستهم ، ولا تأمن من رجل يكون على شر فيرجع إلى خير فيموت عليه ، ولا تأمن رجلا يكون على خير فيرجع إلى شر فيموت عليه ، ليشغلك عن الناس ما تعلم من نفسك ) )(@)(@@) ابن السني والديلمي عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12878 ) قال النبي :(@)(@@) | 30 ( سبع للبكر وثلاث للثيب 
