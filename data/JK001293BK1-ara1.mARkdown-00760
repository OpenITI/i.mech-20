ms741	 أبي عن صالح مولى التوءمة فقال صالح الحديث(@)(@@) علي بن الجعد حدثنا ابن أبي ذئب عن صالح مولى التوءمة عن أبي هريرة - مرفوعا من صلى على الميت في المسجد فلا شيء له(@)(@@) قال ابن حبان هذا باطل(@)(@@) عاصم بن علي حدثنا ابن أبي ذئب عن صالح عن أبي هريرة أنه كان ينعت النبي صلى الله عليه وسلم قال كان شبح الذراعين أهدب العينين بعيد ما بين المنكبين إذا أقبل أقبل معا وإذا أدبر أدبر جميعا بأبي وأمي لم يكن فاحشا ولا متفحشا ولا سخابا في الأسواق(@)(@@) يحيى بن أبي زائدة عن ابن أبي ذئب عن صالح مولى التوءمة عن أبي هريرة - مرفوعا من أنشد ضالة في المسجد فقولوا لا وجدت(@)(@@) فهذه الأحاديث صحيحة عند ابن معين على ما قال(@)(@@)(@@)(@@) $ 3839 ( 4235 ) - صالح بن واقد الليثي(@)(@@) قال أبو حاتم ليس بالقوي وبيض فلعله صالح بن محمد أبو واقد(@)(@@)(@@)(@@) $ 3840 ( 4236 ) - صالح بن الوليد(@)(@@) عن جدته وعنه أبو سلمة التبوذكي مجهول(@)(@@)(@@)(@@) $ 3841 [ 3344 ت ] - صالح بن يحيى ( د س ق ) بن المقدام عن أبيه عن جده(@)(@@) قال البخاري فيه نظر(@)(@@) وقال موسى بن هارون لا يعرف(@)(@@) قلت روى عنه ثور ويحيى بن جابر وسليمان بن سليم وقد وثق(@)(@@)(@@)(@@) $ 3842 [ 4237 ] - صالح العبدي(@)(@@) عن ابن سيرين PageV03P417(@)(@@)(@@)(@@) $ 3843 [ 4238 ] - وصال السلمي عن أبي الشعثاء مجهولان(@)(@@)(@@)(@@) $ 3844 [ 4239 ] - وصالح الشيباني(@)(@@) وقال ابن المديني مجهول(@)(@@)(@@)(@@) $ 3845 [ 4240 ] - وصالح القيراطي(@)(@@) قال الدارقطني كذاب دجال(@)(@@)(@@)(@@) $ 3846 [ 000 ] - وصالح بياع الأكسية(@)(@@) عن جدته ما روى عنه سوى علي بن هاشم بن البريد(@)(@@)(@@)(@@) || صامت صباح(@)(@@)(@@)(@@) $ 3847 [ 4243 ] - صامت بن المخبل اليشكري(@)(@@) عن رؤبه بن العجاج مجهول(@)(@@)(@@)(@@) $ 3848 ( 4245 ) - صباح بن سهيل(@)(@@) عن حصين بن عبد الرحمن ومحمد بن عمرو(@)(@@) قال البخاري أبو سهل منكر الحديث(@)(@@) وقال غيره كوفي(@)(@@) وقال أبو زرعة منكر الحديث(@)(@@) وقال الدارقطني ضعيف(@)(@@) وقال ابن حبان لا يجوز الاحتجاج بخبره(@)(@@) وقال ابن عدي أبو سهل الواسطي قال ابن معين لا أعرفه(@)(@@) قال ابن عدي ما يبلغ حديثه 
ms742	 عشرة وهي لا يتابعه عليها أحد(@)(@@) القواريري حدثنا صباح الواسطي عن حصين سمع جابر بن سمرة يقول قال رسول الله صلى الله عليه وسلم أهل الدرجات العلا يراهم من أسفل منهم كما ترون الكوكب الدري وإن أبا بكر وعمر منهم وأنعما PageV03P418(@)(@@)(@@)(@@) $ 3849 [ 000 ] - صباح بن عبدالله العبدي(@)(@@) من بعض التابعين لا يعرف(@)(@@) وقد وثق روى عنه التبوذكي فقط وروى الكوسج عن ابن معين توثيقه(@)(@@)(@@)(@@) $ 3850 [ 000 ] - [ الصباح بن عبدالله زعم العدوي أنه لقيه بالبصرة وحدثه عن شعبة والعدوي كذاب وهذا لا يعرف قاله بن عساكر ](@)(@@)(@@)(@@) $ 3851 [ 4248 ] - صباح بن مجالد شيخ لبقية(@)(@@) لا يدرى من هو والخبر باطل رواه ثقتان عن بقية عن الصباح بن مجالد حدثني عطية عن أبي سعيد الخدري - مرفوعا قال إذا كانت سنة خمس وثلاثين ومائة خرجت شياطين كان حبسهم سليمان في البحر فتذهب تسعة أعشارهم إلى العراق يجادلونهم بالقرآن وعشر بالشام(@)(@@) قلت المتهم بوضعه صباح هذا(@)(@@)(@@)(@@) $ 3852 [ 3345 ت ] - صباح بن محارب ( ق ) [ التيمي ] الكوفي سكن الري(@)(@@) صالح الحديث أثنى عليه أبو زرعة وأبو حاتم فقالا صدوق(@)(@@) روى عن هشام بن عروة وأقرانه وعنه سهل بن زنجلة وطائفة وذكره العقيلي فقال يخالف في بعض حديثه(@)(@@) قلت هكذا سائر الثقات ينفردون وقد وقع لي من عوالي صباح أخبرنا عمر الطائي أخبرنا أبو القاسم بن الحرستاني حضورا أخبرنا أبو الحسين السلمي أخبرنا الحسين بن طلاب أخبرنا ابن جميع أخبرنا أحمد بن علي الرازي ببغداد حدثنا موسى بن نصر حدثنا الصباح بن محارب عن هشام بن عروة عن أبيه عن عبدالله بن عمرو قال قال رسول الله صلى الله عليه وسلم إن الله لا يقبض العلم انتزاعا ينتزعه من الناس ولكن يقبضه بقبض العلماء PageV03P419(@)(@@) فإذا لم يبق عالما اتخذ الناس رؤساء جهالا فسئلوا فأفتوا بغير علم فضلوا وأضلوا(@)(@@)(@@)(@@) $ 3853 [ 3346 ت ] - صباح بن محمد ( ت ) البجلي(@)(@@) عن مرة الطيب عن ابن مسعود فرفع حديثين هما من قول عبدالله(@)(@@) قال ابن حبان يروي الموضوعات وقد ذكره ابن أبي حاتم 
ms743	 فقال روى عنه أبان بن إسحاق الأسدي لم يزد ولا تعرض بجرح ولا تعديل(@)(@@)(@@)(@@) $ 3854 [ 4249 ] - صباح بن موسى(@)(@@) عن أبي داود السبيعي وعنه محمد بن ربيعة وإسحاق بن موسى الخطمي ليس بذاك القوي مشاه بعضهم(@)(@@)(@@)(@@) $ 3855 [ 4250 ] - صباح بن يحيى(@)(@@) عن الحارث بن حصيرة(@)(@@) متروك بل متهم(@)(@@) روى علي بن هاشم عن صباح بن يحيى عن الحارث بن حصيرة عن جميع بن عناق عن ابن عمر - أن رسول الله صلى الله عليه وسلم قال كان الناس من شجر شتى وكنت أنا وعلي من شجرة واحدة أورده له العقيلي(@)(@@)(@@)(@@) $ 3856 [ 000 ] - صباح العبدي(@)(@@) هو ابن عبدالله قد مر وقد وثقه يحيى بن معين وقال أبو حاتم مجهول(@)(@@)(@@)(@@) || صبيح(@)(@@)(@@)(@@) $ 3857 [ 4251 ] - صبيح بن بزيع(@)(@@) عن الأوزاعي وعنه ابن الطباع(@)(@@) وقال أبو حاتم ليس بشيء PageV03P420(@)(@@)(@@)(@@) $ 3858 [ 4252 ] - صبيح بن دينار(@)(@@) ذكره العقيلي وأنه خالف في إسناد حديث حدث عنه البغوي(@)(@@)(@@)(@@) $ 3859 [ 4253 ] - صبيح بن سعيد(@)(@@) عن عثمان وعائشة قال أبو خيثمة وابن معين كان ينزل الخلد كذاب خبيث وقال أبو داود ليس بشيء(@)(@@)(@@)(@@) $ 3860 [ 4254 ] - صبيح بن عبدالله شيخ لأحمد بن أبي خيثمة(@)(@@) قال عبدالغني المصري منكر الحديث(@)(@@) وقال الخطيب في التلخيص صاحب مناكير(@)(@@)(@@)(@@) $ 3861 ( 4255 ) - صبيح بن عبدالله(@)(@@) وقيل ابن القاسم أبو الجهم الإيادي عنه هشيم(@)(@@) يأتي بالكنية(@)(@@) له حديث إمرؤ القيس قائد الشعراء إلى النار(@)(@@)(@@)(@@) $ 3862 ( 000 ) - صبيح بن عبد الله الفرغاني من شيوخ أحمد بن أبي خيثمة(@)(@@) قال الخطيب في كتاب التلخيص صاحب مناكير(@)(@@)(@@)(@@) $ 3863 ( 4256 ) - صبيح بن عمير(@)(@@) عن تمام بن بزيع(@)(@@) قال الأزدي فيه لين(@)(@@)(@@)(@@) $ 3864 ( 3347 ت ) - صبيح بن محرز ( د ) المقرائي(@)(@@) ضم أوله ابن ماكولا وخولف له عن أبي مصبح المقرائي تفرد عنه محمد بن يوسف الفريابي PageV03P421(@)(@@)(@@)(@@) $ 3865 ( 3348 ت ) - صبيح - بالضم ( ت ق ) مولى أم سلمة(@)(@@) عن زيد بن أرقم - مرفوعا أنه قال لعلي وإبنيه وفاطمة أنا حرب لمن حاربكم رواه عنه السدي(@)(@@) قال الترمذي صبيح غير معروف(@)(@@)(@@)(@@) || الصبي صخر(@)(@@)(@@)(@@) $ 3866 ( 4257 ) - الصبي بن 
ms744	 الأشعث السلولي(@)(@@) عن عطية له مناكير وفيه ضعف يحتمل ذكره ابن عدي حدث عنه أحمد بن إبراهيم الموصلي(@)(@@) قال أبو حاتم شيخ يكتب حديثه(@)(@@)(@@)(@@) $ 3867 ( 3349 ت ) - صخر بن إسحاق ( د ) حجازي(@)(@@) ما روى عنه سوى أبي الغصن ثابت(@)(@@)(@@)(@@) $ 3868 ( 3350 ت ) - صخر بن بدر ( د ) ما روى عنه سوى أبي التياح الضبعي(@)(@@)(@@)(@@) $ 3869 ( 3351 ت ) - صح صخر بن جويرية ( خ م ) عن أبي رجاء العطاردي ونافع وعنه عفان وعلي بن الجعد والناس PageV03P422(@)(@@) وثقه أحمد وجماعة(@)(@@) وقال ابن معين صالح(@)(@@) وقال أبو داود تكلم فيه(@)(@@)(@@)(@@) $ 3870 ( 3352 ت ) - صخر بن عبد الله ( ت ) بن حرملة شيخ حجازي قليل الحديث(@)(@@) أبو حاجب عن الليث بن سعد متهم بالوضع(@)(@@) ولا يكاد يعرف وله في سنن الدارقطني(@)(@@) قال ابن القطان مجهول الحال لايعرف ما روى عنه غير بكر بن مضر(@)(@@) قلت له عن أبي سلمة بن عبد الرحمن وقد حسن النسائي حاله(@)(@@) قلت أخاف أن يكون اثنين فيحرر هذا(@)(@@)(@@)(@@) $ 3871 ( 4256 ) - صخر بن أبي غليظ(@)(@@) عن أبي سلمة بن عبد الرحمن ضعفه أبو حاتم لحقه الليث بن سعد(@)(@@)(@@)(@@) $ 3872 ( 4260 ) - صخر بن محمد المنقري الحاجبي المروزي عن مالك(@)(@@) قال ابن طاهر كذاب(@)(@@) قلت هو أبو حاجب وهو صخر بن عبد الله كوفي نزل مرو وهو صخر بن حاجب لحقه عبد الله بن محمود المروزي(@)(@@) قال الدارقطني ضعيف(@)(@@) وقال ابن عدي حدث عن الثقات بالبواطيل فمن ذلك عن مالك عن زيد بن أسلم عن أنس - مرفوعا - قال لا عقل كالتدبير PageV03P423(@)(@@) وبه اللهم بارك لأمتي في بكورها(@)(@@) وله عن الليث عن الزهري عن أنس - رفعه تبجيل المشايخ من إجلال الله(@)(@@) وله عن ابن لهيعة عن ابن المنكدر عن جابر بخبر باطل(@)(@@) قال ابن عدي صخر بن عبد الله الحاجبي كان على المظالم ب جرجان عامة ما يرويه من موضوعاته(@)(@@) قلت له عن أبي سلمة بن عبد الرحمن وقد حسنه النسائي(@)(@@) وقد خبط ابن الجوزي في ترجمة صخر بن عبد الله بن حرملة فقال وقيل ابن 
ms745	 محمد المدلجي الكوفي سكن مرو(@)(@@) قال وقال ابن عدي كنوه فقالوا أبو حاجب الضرير(@)(@@) يروي عن الليث وعمر بن عبد العزيز وزياد بن حبيب وعامر بن عبد الله بن الزبير وأبي سلمة روى عنه بكر بن مضر(@)(@@) قال ابن المديني هالك(@)(@@) قال المصنف هكذا نقلت من خط الضياء في هذه الترجمة وهو غير مستقيم فإن صخر بن عبد الله بن حرملة حجازي كان في حدود الثلاثين ومائة يروي عن أبي سلمة بن عبد الرحمن وعامر بن عبد الله وعمر بن عبد العزيز روى عنه بكر بن مضر وهو المدني الذي قال فيه النسائي صالح وذكره ابن حبان في الثقات(@)(@@) والآخر فصخر بن عبد الله ويقال صخر بن محمد المدلجي كوفي نزل مرو وروى عن الليث ومالك بقي إلى حدود الثلاثين ومائتين(@)(@@) قال الحاكم صخر بن محمد أبو حاجب الحاجبي من أهل مرو روى عن مالك والليث وابن لهيعة أحاديث موضوعة حدثونا عن عبد الله بن محمود وغيره من الثقات عنه(@)(@@)(@@)(@@) || صدقة(@)(@@)(@@)(@@) $ 3873 ( 4261 ) - صدقة بن الحسين البغدادي الحنبلي الناسخ(@)(@@) متأخر سيء الاعتقاد PageV03P424(@)(@@)(@@)(@@) $ 3874 [ 4262 ] - صدقة بن رستم الإسكاف(@)(@@) عن المسيب بن رافع وعنه الفضل بن موسى ومحمد بن فضيل وجماعة(@)(@@) قال أبو حاتم ما به بأس صدوق(@)(@@) وقال ابن حبان يروي عن الأثبات ما لا يشبه حديث الثقات وهما(@)(@@) وقال البخاري لم يصح حديثه(@)(@@)(@@)(@@) $ 3875 [ 3353 ت ] - صدقة بن سعيد ( د س ق ) الحنفي والد المفضل بن صدقة(@)(@@) عن مصعب بن شيبة وجميع بن عمير وعنه زائدة وأبو بكر بن عياش وجماعة(@)(@@) قال أبو حاتم شيخ(@)(@@) وقال الساجي ليس بشيء(@)(@@) وقال البخاري عنده عجائب وقال محمد بن وضاح ضعيف وذكره ابن حبان في الثقات(@)(@@)(@@)(@@) $ 3876 [ 4263 ] - صدقة بن سهل أبو سهل الهنائي(@)(@@) عن ابن سيرين وأبي عمرو الجملي وعنه محمد بن معاذ العنبري وموسى بن إسماعيل(@)(@@) روى الكوسج عن ابن معين ثقة وإنما ذكرته لأن النباتي استدركه ونقل بلا إسناد عن ابن معين أنه قال ليس بشي والله أعلم(@)(@@)(@@)(@@) $ 3877 
ms746	 [ 3354 ت ] - صدقة بن عبدالله ( س ق ت ) السمين أبو معاوية الدمشقي PageV03P425(@)(@@) عن ابن المنكدر والعلاء بن الحارث وجماعة وعنه وكيع والوليد والفريابي ضعفه أحمد والبخاري(@)(@@) وقال أبو زرعة كان قدريا لينا(@)(@@) وقال ابن نمير ضعيف(@)(@@) وقال أبو حاتم محله الصدق أنكر عليه القدر فقط وروى عثمان بن سعيد عن يحيى ضعيف وكذا ضعفه النسائي والدارقطني(@)(@@) وقال أبو حاتم نظرت في مصنفات صدقة بن عبدالله السمين عند عبدالله بن يزيد بن راشد المقرىء وقلت لدحيم عنه فقال محله الصدق غير أنه كان يشوبه القدر(@)(@@) وقد حدثنا بكتب عن ابن جريج وسعيد بن أبي عروبة وكتب عن الأوزاعي ألفا وخمسمائة حديث وكان صاحب حديث كتب إليه الأوزاعي في رسالة القدر يعظه فيها(@)(@@) قلت قوله ( وقد حدثنا ) خطأ ولم يلقه دحيم وخطأ آخر في تاريخ ابن عساكر وهو أنه ذكر في الرواة عنه أبو عامر موسى بن عامر وإنما يروي موسى عن الوليد عنه(@)(@@) قال عمر بن عبد الواحد حدثنا صدقة بن عبدالله قال قدمت الكوفة فأتيت الأعمش فإذا رجل غليظ ممتنع فجعلت أتعجرف عليه تعجرف أهل الشام فأنكر لغتي فقال أين يكون أهلك قلت بالشام قال وأي الشام قلت دمشق قال ما أقدمك الكوفة قلت لأسمع منك ومن مثلك قال أما إنك لا تلقي فيها إلا كذابا حتى تخرج منها(@)(@@) عمرو بن أبي سلمة سمعت سعيد بن عبد العزيز يقول جاءني الأوزاعي فقال لي من حدثك بذاك الحديث قلت الثقة عندي وعندك صدقة بن عبدالله(@)(@@) قال الوليد مات سنة ست وستين ومائة(@)(@@) الوليد بن مسلم عن صدقة بن عبدالله عن موسى بن عقبة عن الأعرج عن أبي PageV03P426(@)(@@) هريرة مرفوعا قال أتاني ملك برساله من الله ثم رفع رجله فوضعها فوق السماء والأخرى ثابتة في الأرض لم يرفعها(@)(@@) قال ابن عدي أكثر أحاديثه مما لا يتابع عليه وهو إلى الضعف أقرب(@)(@@) قال صدقة بن عبد الله عن زهير بن محمد عن عاصم الأحول عن عبد الله بن سرجس أن رسول الله صلى 
ms747	 الله عليه وسلم قال إذا أتى أحدكم أهله فليلق على عجيزته وعجيزتها شيئا(@)(@@) وزهير أيضا ذو مناكير(@)(@@)(@@)(@@) $ 3878 ( 3355 ت ) - صح صدقة بن أبي عمران ( م ق ) الكوفي قاضي الأهواز عن أبي يعفور وأبي إسحاق(@)(@@) وعنه أبو أسامة صدوق(@)(@@) وقال أبو حاتم شيخ صالح وليس بذاك(@)(@@) وقال أبو داود عن ابن معين ليس بشيء(@)(@@) ولصدقة عن قيس بن مسلم عن طارق بن مسلم عن أبي موسى كان يوم عاشوراء يصومه أهل خيبر ويلبسون فيه نساءهم حليهم وشارتهم فسئل النبي صلى الله عليه وسلم عن صومه فقال صوموا(@)(@@) فهذا من غرائب مسلم(@)(@@)(@@)(@@) $ 3879 ( 3356 ت ) - صدقة بن عمرو الغساني(@)(@@) عن تابعي PageV03P427(@)(@@)(@@)(@@) $ 3880 ( 3357 ت ) - وصدقة بن عمرو المكي عن عطاء مجهولان(@)(@@) قلت أما الغساني فما روى عنه سوى هشام بن عمار ولا حدث عنه المكي سوى الوليد بن مسلم(@)(@@)(@@)(@@) $ 3881 ( 3358 ت ) - صدقة بن عيسى الحنفي والد الفضل عن أنس وعنه أبو بكر بن عياش وعبيد الله بن موسى(@)(@@) والصواب عيسى بن صدقة يأتي ضعيف(@)(@@)(@@)(@@) $ 3882 ( 000 ) - صدقة بن المثنى الكعبي(@)(@@) عن كعب بن مالك بن زيد لا يعرف(@)(@@)(@@)(@@) $ 3883 ( 4267 ) - صدقة بن مهلهل(@)(@@) متروك الحديث(@)(@@) قاله الأزدي(@)(@@) قلت ولم يذكره ابن أبي حاتم(@)(@@)(@@)(@@) $ 3884 ( 3359 ت ) - صدقة بن موسى ( د ت ) الدقيقي البصري أبو المغيرة(@)(@@) ضعفه ابن معين والنسائي وغيرهما(@)(@@) يروي عن أبي عمران الجوني وثابت وعنه مسلم والتبوذكي وعلي بن الجعد وخلق PageV03P428(@)(@@) وقال أبو حاتم يكتب حديثه وليس بقوي(@)(@@) قال عبد في مسنده حدثنا سليمان بن داود حدثنا صدقة بن موسى حدثنا محمد بن واسع عن بشير بن نهار العبدي عن أبي هريرة قال قال رسول الله صلى الله عليه وسلم إنكم لو أن الناس أطاعوني لما أسمعتم صوت الرعد(@)(@@) وبه قال رسول الله صلى الله عليه وسلم جددوا إيمانكم وأكثروا من قول لا إله إلا الله(@)(@@) وله عن مالك بن دينار عن عبد الله بن غالب عن أبي سعيد الخدري مرفوعا خصلتان لا تجتمعان في مسلم البخل وسوء 
ms748	 الخلق(@)(@@)(@@)(@@) $ 3885 ( 4268 ) - صدقة بن موسى بن تميم(@)(@@) عن أبيه عن حميد الطويل بخبر باطل ولكن هذا الشيخ ما روى عنه سوى أحمد بن عبد الله الذارع ذاك الكذاب وأكثر عنه(@)(@@)(@@)(@@) $ 3886 ( 4269 ) - صدقة بن هرمز الزماني(@)(@@) عن عاصم بن بهدلة(@)(@@) ضعفه ابن معين وعنه مسلم والتبوذكي(@)(@@) فرق البخاري بين صدقة بن هرمز عن الجريري وبين صدقة بن أبي محمد الزماني عن عاصم بن بهدله فتحقق(@)(@@)(@@)(@@) $ 3887 ( 4271 ) - صدقة بن يزيد الخراساني ثم الشامي(@)(@@) نزل الرملة عن حماد بن أبي سليمان والعلاء بن عبد الرحمن وإبراهيم الصائغ(@)(@@) وعنه الوليد بن مسلم ورواد بن الجراح(@)(@@) ضعفه أحمد PageV03P429(@)(@@) وقال أبو حاتم صالح(@)(@@) وقال أبو زرعة الدمشقي ثقة(@)(@@) وقال ابن عدي هو إلى الضعف أقرب(@)(@@) وقال ابن حبان لا يجوز الإشتغال بحديثه ولا الإحتجاج به(@)(@@) وقال البخاري منكر الحديث(@)(@@) وقال أحمد صدقة بن يزيد كان يكون بناحية بيت المقدس ضعيف(@)(@@) وقال الوليد بن مسلم حدثنا صدقة بن يزيد الخراساني حدثنا العلاء بن عبد الرحمن عن أبيه عن أبي هريرة عن النبي صلى الله عليه وسلم قال قال الله عز وجل إن عبدا أصححته ووسعت عليه لم يزرني في كل خمسة أعوام لمحروم(@)(@@)(@@)(@@) $ 3888 ( 4273 ) - صح صدقة بن يسار ( م س ) ثقة(@)(@@) نزل مكة وحدث عن طاوس وجماعة وعنه شعبة ومالك والسفيانان(@)(@@) وثقه أحمد ويحيى(@)(@@) وقال أبو حاتم صالح(@)(@@) ونقل النباتي في ترجمته أن سفيان بن عيينة قال كان يقول المختار أحب إلي من أبوي(@)(@@) وذكره العقيلي PageV03P430(@)(@@) قلت قد صح أن أحمد بن حنبل قال حدثنا سفيان قال قلت لصدقة بن يسار إن ناسا يزعمون أنكم خوارج قال كنت منهم ثم إن الله عافاني(@)(@@) قال أبو داود ثقة متوحش كان يصلي جمعة بمكة وجمعة بالمدينة(@)(@@) قلت يقال إنه روى عن ابن عمر(@)(@@)(@@)(@@) $ 3889 - ( . . . ) صدقة الرماني هو ابن هرمز مر حدث عنه أبو داود الطياسي وغيره لين(@)(@@)(@@)(@@) || صديق(@)(@@)(@@)(@@) $ 3890 [ 4274 ] - صديق بن سعيد الصوناخي التركي(@)(@@) عن محمد بن نصر المروزي عن يحيى عن مالك عن 
ms749	 نافع عن ابن عمر مرفوعا شفاعتي لأهل الكبائر من أمتي(@)(@@) وهذا لم يروه هؤلاء قط ولكن رواه عن صديق من يجهل حاله وهو أحمد بن عبدالله بن محمد الزينبي فما أدري من وضعه(@)(@@)(@@)(@@) $ 3891 ( 4275 ) صديق بن موسى بن عبدالله بن الزبير(@)(@@) حدث عنه ابن جريج ليس بالحجة(@)(@@) قلت قال ابن عيينة كان شريفا مهنأ(@)(@@)(@@)(@@) || صرد الصعب صعصعة(@)(@@)(@@)(@@) $ 3892 ( ت 3361 ) صرد بن أبي المنازل ( د )(@)(@@) عن بعض التابعين بصري فيه جهالة روى عنه الأنصاري(@)(@@)(@@)(@@) $ 3893 ( ت 3362 ) الصعب بن حكيم بن شريك بن نملة الكوفي(@)(@@) لا يعرف لكن PageV03P431 ذكره ابن حبان في الثقات وروى البخاري في كتاب الأدب له عن أبيه قال أتيت عمر فجعل يقول يا بن أخي ثم سألني فانتسبت له فعرف أن أبي لم يدرك الإسلام فجعل يقول يا بني يا بني(@)(@@)(@@)(@@) $ 3894 ( 4276 ) - الصعب بن زيد(@)(@@) عن أبيه وعنه جرير بن حازم وحماد بن زيد مجهول(@)(@@) قلت شيخ(@)(@@)(@@)(@@) $ 3895 ( 4277 ) - الصعب بن عثمان لايعرف تفرد عنه مغيرة(@)(@@)(@@)(@@) $ 3896 ( 3363 ت ) - صعصعة بن صوحان ( س ) عن عثمان ثقة معروف ذكره الجوزجاني في الضعفاء وعده من جملة الخوارج ولم يصح وقد وثقه ابن سعد والنسائي(@)(@@)(@@)(@@) || الصعق(@)(@@)(@@)(@@) $ 3897 ( 4280 ) الصعق بن حبيب ( م س ) وقيل الصقر(@)(@@) عن أبي رجاء العطاردي تكلم فيه ابن حبان فقال يأتي عن الأثبات بالمقلوبات(@)(@@)(@@)(@@) $ 3898 ( 3364 ت ) الصعق بن حزن ( م س ) بن قيس البكري بصري(@)(@@) عن الحسن وقتادة وعنه عارم وشيبان وعدة PageV03P432(@)(@@) وثقة يحيى وأبو زرعة وأبو داود(@)(@@) وقال أبو حاتم ما به بأس(@)(@@) وقال الدارقطني الصعق ومطر ليسا قويين(@)(@@) وقال عارم كانوا يرونه من الأبدال(@)(@@)(@@)(@@) || صغدي(@)(@@)(@@)(@@) $ 3899 [ 4281 ] - صغدي بن سنان أبو معاوية البصري(@)(@@) قال أبو حاتم ضعيف الحديث وروى عباس عن ابن معين ليس بشيء يروي عن خالد الحذاء وطبقته فأما(@)(@@)(@@)(@@) $ 3900 [ 4282 ] - صغدي الكوفي(@)(@@) شيخ لأبي نعيم - فوثقه يحيى بن معين فرقهما ابن أبي حاتم(@)(@@)(@@)(@@) $ 3901 [ 4283 ] - صغدي بن عبدالله(@)(@@) عن قتادة له حديث منكر(@)(@@) قال العقيلي لا يعرف 
ms750	 إلا به(@)(@@) قلت رواه عنه عنبسة بن عبدالرحمن متنه الشاة بركة(@)(@@)(@@)(@@) || صفوان(@)(@@)(@@)(@@) $ 3902 [ 4284 ] - صفوان بن رستم(@)(@@) عن روح بن القاسم مجهول(@)(@@) قال الأزدي منكر الحديث(@)(@@)(@@)(@@) $ 3903 [ 000 ] - صفوان بن أبي الصهباء(@)(@@) عن بكير بن عتيق PageV03P433(@)(@@) ضعفه ابن حبان وقال يروي ما لا أصل له لا يجوز الإحتجاج بما انفرد به ثم ذكره في الثقات أيضا(@)(@@)(@@)(@@) $ 3904 [ 4285 ] - صفوان بن عمران الأصم(@)(@@) عن بعض الصحابة في طلاق المكره(@)(@@) قال أبو حاتم ليس بقوي(@)(@@) وقال البخاري حديثه منكر لا يتابع عليه(@)(@@)(@@)(@@) $ 3905 [ 4286 ] - صفوان بن قبيصة(@)(@@) عن طارق بن شهاب وعنه أمي الصيرفي وآخران مجهول(@)(@@)(@@)(@@) $ 3906 [ 3365 ت ] - صفوان بن هبيرة ( ق ) بصري(@)(@@) عن أبي مكين بخبر منكر وعنه الحسن الحلواني(@)(@@) قال العقيلي لا يتابع على حديثه ولا يعرف إلا به(@)(@@) وقال أبو حاتم شيخ(@)(@@) قلت [ و ] روى عنه محمد بن يحيى الذهلي(@)(@@)(@@)(@@) || الصقر(@)(@@)(@@)(@@) $ 3907 [ 4288 ] - الصقر بن حبيب(@)(@@) عن أبي رجاء العطاردي(@)(@@) قال ابن حبان يأتي عن الأثبات بالمقلوبات وغمزه الدارقطني في الزكاة ولا يكاد يعرف [ مر في الصعق ](@)(@@)(@@)(@@) $ 3908 [ 4289 ] - الصقر بن عبدالرحمن أبو بهز سبط مالك بن مغول حدث عن PageV03P434(@)(@@) عبدالله بن إدريس عن مختار بن فلفل عن أنس بحديث كذب قم يا أنس فافتح لأبي بكر وبشره بالخلافة من بعدي وكذا في عمر وعثمان رضي الله عنهما(@)(@@) قال ابن عدي كان أبو يعلى إذا حدثنا عنه ضعفه(@)(@@) وقال أبو بكر بن شيبة كان يضع الحديث(@)(@@) وقال أبو علي جزرة كذاب(@)(@@) وقال ابن أبي حاتم صقر بن عبد الرحمن بن مالك بن مغول عن شريك وخالد الطحان سألت أبي عنه فقال هو أحسن حالا من أبيه وسئل أبي عنه فقال هو صدوق(@)(@@) قلت من أين جاءه الصدق(@)(@@)(@@)(@@) || الصلت(@)(@@)(@@)(@@) $ 3909 ( 4290 ) - الصلت بن بهرام(@)(@@) عن أبي وائل وزيد بن وهب وعنه مروان بن معاوية وابن عيينة(@)(@@) قال أحمد كوفي ثقة(@)(@@) وقال ابن عيينة كان أصدق أهل الكوفة(@)(@@) وقال ابن أبي خيثمة عن يحيى ثقة(@)(@@) وقال أبو حاتم لا عيب 
ms751	 له إلا الإرجاء وكذا تكلم فيه أبو زرعة للإرجاء(@)(@@)(@@)(@@) $ 3910 ( 4291 ) - الصلت بن حجاج 3 عن محمد بن جحادة(@)(@@) قال ابن عدي عامة حديثه منكر(@)(@@) وقال في مكان آخر في حديثه بعض النكرة(@)(@@) الزهراني حدثنا الصلت بن الحجاج حدثنا ثور عن خالد بن معدان أن عبادة بن الصامت قال جاء رجل إلى النبي صلى الله عليه وسلم فشكا إليه الوحشة فأمره أن يتخذ زوج حمام(@)(@@) موسى بن مروان حدثنا يحيى بن سعيد عن الصلت بن الحجاج عن عاصم الأحول PageV03P435 عن أنس قال رسول الله صلى الله عليه وسلم لعائشة ما أكثر بياض عينيك(@)(@@)(@@)(@@) $ 3911 ( 3366 ت ) - الصلت بن دينار ( ت ق ) أبو شعيب المجنون(@)(@@) بصري لين عن أبي عثمان النهدي وغيره(@)(@@) قال ابن معين - في جواب سؤال عبد الله بن أحمد ليس بشيء(@)(@@) وقال أحمد متروك(@)(@@) وقال الفلاس كان يحيى وابن مهدي لا يحدثان عنه(@)(@@) وقال البخاري كان شعبة تكلم فيه(@)(@@) وقال الجوزجاني ليس بقوي(@)(@@) وكذا قال الدارقطني وقال النسائي ليس بثقة(@)(@@) وقال الفلاس سمعت يحيى يقول ذهبت أنا وعوف نعود الصلت بن دينار فذكر الصلت عليا رضي الله عنه فنال منه فقال عوف مالك يا أبا شعيب لا رفع الله صرعتك(@)(@@) علي بن ثابت الجزري عن الصلت عن شهر عن أبي أمامة - أن النبي صلى الله عليه وسلم توضأ بنصف مد(@)(@@) شبابة عن شعبة قال إذا حدثكم سفيان عن رجل لا تعرفونه فلا تقبلوا منه فإنما يحدثكم عن مثل أبي شعيب المجنون(@)(@@)(@@)(@@) $ 3912 ( 4293 ) - الصلت بن سالم عن زيد بن أسلم(@)(@@) قال أبو حاتم ليس بشيء روى عنه موسى بن يعقوب(@)(@@) وقال البخاري لا يصح حديثه(@)(@@)(@@)(@@) $ 3913 ( 000 ) - الصلت بن طريف شيخ بصري حدث عنه ابن عجلان مجهول PageV03P436(@)(@@)(@@)(@@) $ 3914 [ 4294 ] - الصلت بن طريف المعولي شيخ بصري(@)(@@) عن الحسن وعن أبي شمر وعنه أبو سلمة وسهل بن بكار وغيرهما(@)(@@) مستور خرج له الدارقطني قال سلم بن قتيبة عنه عن رجال عن بن أبي مليكة عن يوسف بن عبدالله بن سلام 
ms752	 عن أبيه - يرفعه لاصلاة لملتفت(@)(@@) وقال سهل بن بكار عنه عن أبي شمر حدثني رجل عن ابن أبي مليكة عن يوسف عن أبي الدرداء(@)(@@) وقال شعبة عن أبي شمر عن رجل عن رجل عن آخر قال الدارقطني والحديث مضطرب(@)(@@) قال ابن القطان والصلت لا يعرف حاله(@)(@@)(@@)(@@) $ 3915 [ 4297 ] - الصلت بن عبدالرحمن الأنصاري(@)(@@) شيخ حدث عن ابن عجلان مجهول(@)(@@)(@@)(@@) $ 3916 [ 4294 ] - الصلت بن عبد الرحمن(@)(@@) الزبيدي(@)(@@) فال أبو الفتح الأزدي لا تقوم به حجة(@)(@@) قلت لم يذكره ابن أبي حاتم(@)(@@)(@@)(@@) $ 3917 [ 4296 ] - الصلت بن عبدالرحمن(@)(@@) عن سفيان الثوري(@)(@@) قال العقيلي مجهول لا يتابع على حديثه ثم روى عن ثقتين عن سليمان ابن بنت شرحبيل حدثنا الصلت حدثنا سفيان عن ابن عون عن الحسن عن عمران بن حصين قال بعث عياض بن حمار المجاشعي إلى رسول الله صلى الله عليه وسلم - بفرس - فقال إني أكره زبد المشركين(@)(@@) وقال أشعث بن سوار وأبو بكر الهذلي عن الحسن عن عياض بن حمار وكذا روى PageV03P437(@)(@@) جرير بن حازم عن قتادة عن مطرف عن عياض(@)(@@)(@@)(@@) $ 3918 [ 4297 ] - الصلت بن قويد(@)(@@) عن أبي هريرة(@)(@@) قال النسائي لا أدري كيف هو حديثه منكر ثم ذكر له الحديث الذي في جزء ابن عرفة لا تقوم الساعة حتى لا تنطح ذات قرن جماء(@)(@@) رواه عنه عمار بن محمد هكذا واختلف فيه على عمار فقال عبدالله بن أحمد بن حنبل حدثناه إبراهيم بن عبدالله الهروي حدثنا عمار حدثنا الصلت بن قويد الحنفي عن أبي أحمر عن أبي هريرة ورواه الإمام أحمد وابن عرفة عن عمار بدون أبي أحمر(@)(@@)(@@)(@@) $ 3919 [ 3267 ت ] - [ صح ] الصلت بن مسعود ( م ) الجحدري أحد شيوخ مسلم(@)(@@) قال عبدان نظر عباس العنبري في جزء لي عن الصلت فقال يا بني اتقه(@)(@@) قال ابن عدي لم أجد لأحد في الصلت كلاما ينسبه إلى ضعف وقد اعتبرت حديثه فلم أجد ما ينكر وهو عندي لا بأس به وهو أخو إسماعيل(@)(@@) وثقه صالح جزرة وغيره ولمسلم عنه حديث واحد(@)(@@)(@@)(@@) $ 3920 [ 4301 
ms753	 ] - الصلت بن مهران(@)(@@) عن شهر بن حوشب وابن أبي مليكة والحسن وعنه محمد بن بكر البرساني وسهل بن حماد مستور(@)(@@) قال ابن القطان مجهول الحال(@)(@@) وقال عبد الحق - في أحكامه روى الصلت بن مهران عن ابن أبي مليكة عن يوسف بن عبد الله بن سلام عن أبيه - مرفوعا لا صلاة لملتفت وهذا لا يثبت ورواه البزار في أماليه لا في مسنده(@)(@@)(@@)(@@) $ 3921 ( 4302 ) - صلت بن يحيى عن ابن أبي مليكة(@)(@@) قال الأزدي ضعيف لا يصح حديثه(@)(@@)(@@)(@@) $ 3922 ( 3368 ت ) - الصلت السدوسي تابعي أرسل ذبيحة المسلم حلال وإن PageV03P438 لم يسم روى عنه ثور بن يزيد وحده(@)(@@)(@@)(@@) || صلة(@)(@@)(@@)(@@) $ 3923 ( 4304 ) - صلة بن سليمان العطار أبو زيد الواسطي(@)(@@) عن ابن جريج وغيره(@)(@@) روى عباس عن يحيى ليس بثقة وروى معاوية بن صالح عن يحيى ضعيف وقال النسائي متروك(@)(@@) وقال الدارقطني يترك حديثه عن ابن جريج وشعبة ويعتبر بحديثه عن أشعث الحمراني(@)(@@) ومن مناكيره عن ابن جريج وشعبة عن عطاء عن ابن عباس - مرفوعا من حج عن والديه أو قضى عنهما مغرما بعثه الله مع الأبرار(@)(@@) أحمد بن ملاعب حدثنا سليمان بن أحمد حدثنا صلة بن سليمان حدثنا ابن جريج عن عطاء عن جابر أخبرني معاذ أنه سمع رسول الله - صلى الله عليه وسلم يقول من أمن رجلا ثم قتله وجبت له النار وإن كان المقتول كافرا(@)(@@)(@@)(@@) || صهيب(@)(@@)(@@)(@@) $ 3924 ( 4306 ) - صهيب بن مهران(@)(@@) حدث عنه عمرو بن صالح PageV03P439(@)(@@)(@@)(@@) $ 3925 ( 4307 ) - وصهيب عن الحسن - مجهولان(@)(@@)(@@)(@@) $ 3926 ( 3370 ت ) - صهيب العتواري(@)(@@) عن أبي هريرة لا يكاد يعرف روى عنه نعيم المجمر(@)(@@)(@@)(@@) $ 3927 ( 3369 ت ) - صهيب المكي ( س ) الحذاء(@)(@@) عن عبد الله بن عمرو وعنه عمرو بن دينار فقط وبعضهم قواه حديثه من قتل عصفورا سأله الله تعالى عنه(@)(@@)(@@)(@@) $ 3928 ( 3371 ت ) - صهيب أبو الصهباء ( د س م ) البكري عن علي وابن عباس وعنه طاوس وسعيد بن جبير وأبو نضرة(@)(@@) وثقه أبو زرعة(@)(@@) وقال النسائي بصري ضعيف(@)(@@)(@@)(@@) $ 3929 ( 3372 ت ) - صهيب عن مولاه العباس وعنه أبو صالح 
ms754	 السمان فقط(@)(@@)(@@)(@@) | حرف الضاد(@)(@@) - *(@)(@@)(@@)(@@) || ضبارة(@)(@@)(@@)(@@) $ 3930 ( 000 ) - ضبارة بن عبد الله ( د س ق ) بن أبي السليل شامي عن دويد بن نافع وعنه بقية بن الوليد وغيره ساق له ابن عدي ستة أحاديث في كامله فيه لين(@)(@@)(@@)(@@) $ 3931 ( 4308 ) - ضبارة بن مالك(@)(@@) قيل هو ابن عبد الله فنسب إلى جده شيخ لبقية وإلى جهالة شيوخه المنتهى لكن هذا ذكره صاحب الكامل فقال له حديث عن أبيه وعنه ابنه محمد وبقية(@)(@@)(@@)(@@) || ضبيعة(@)(@@)(@@)(@@) $ 3932 ( 3374 ت ) - ضبيعة بن حصين ( د ) ما روى عنه سوى أبي بردة(@)(@@)(@@)(@@) || الضحاك(@)(@@)(@@)(@@) $ 3933 ( 3375 ت ) - الضحاك بن أيمن الكلبي ( د )(@)(@@) شيخ لابن لهيعة لايدرى من ذا له في ليلة نصف شعبان(@)(@@)(@@)(@@) $ 3934 ( 3376 ت ) - الضحاك بن حمرة ( ت ) عن عمرو بن شعيب PageV03P440(@)(@@) قال النسائي ليس بثقة(@)(@@) وقال البخاري منكر الحديث مجهول(@)(@@) بقية حدثني الضحاك بن حمرة واسطي عن أبي نصير الواسطي عن أبي رجاء العطاردي عن عمران بن حصين وأبي بكر الصديق قالا قال رسول الله صلى الله عليه وسلم من اغتسل يوم الجمعة كفرت عنه ذنوبه وخطاياه وإذا أخذ في المشي إلى الجمعة كان له بكل خطوة عمل عشرين سنة فإذا فرغ من الجمعة أجيز بعمل مائتي سنة(@)(@@) أخرجه البخاري في الضعفاء تعليقا من رواية إسحاق بن راهويه عن بقية(@)(@@) وقد روى عنه أيضا أبو سفيان سعيد بن يحيى الحميري وأبو المغيرة ومحمد بن حرب ومحمد بن حمير ويمان بن عدي الحمصيون(@)(@@) وله أحاديث عن قتادة ومنصور بن زاذان وغير واحد(@)(@@) وقال ابن معين ليس بشيء(@)(@@) أنبأتنا فاطمة بنت علي أخبرنا خضر بن كامل أخبرنا نصر الله بن محمد أنبأنا أبو منصور بن شكرويه أنبأنا الحسن بن علي البغدادي حدثنا الفضل بن الخطيب حدثنا محمد بن الوزير الواسطي حدثنا أبو سفيان الحميري عن الضحاك بن حمرة عن عمرو بن شعيب عن أبيه عن جده قال قال رسول الله - صلى الله عليه وسلم - من سبح مائة بالغداة ومائة بالعشي كان كمن حج مائة حجة ومن حمد الله 
ms755	 مائة بالغداة ومائة بالعشي كان كمن حمل على مائة فرس 000 الحديث رواه الترمذي عن محمد بن وزير وحسنه فلم يضع شيئا(@)(@@) بقية عن الضحاك عن حمرة عن أبان عن حطان بن عبد الله عن أبي الدرداء مرفوعا الزكاة قنطرة الإسلام PageV03P442(@)(@@)(@@)(@@) $ 3935 ( 3409 ) - الضحاك بن حجوة(@)(@@) عن سفيان بن عيينة(@)(@@) قال الدارقطني كان يضع الحديث(@)(@@) وقال ابن عدي هو أبو عبد الله المنبجي كل رواياته مناكير إما متنا وإما إسنادا(@)(@@) ومن مصائبه حدثنا الفريابي حدثنا الثوري عن ابن المنكدر عن جابر - مرفوعا من أكرم العلماء فقد أكرم الله ورسوله(@)(@@)(@@)(@@) $ 3936 ( 4311 ) - الضحاك بن زيد الأهوازي(@)(@@) عن إسماعيل بن أبي خالد(@)(@@) قال ابن حبان يرفع المراسيل ويسند الموقوف لا يجوز الاحتجاج به وقال(@)(@@) العقيلي يخالف في حديثه(@)(@@)(@@)(@@) $ 3937 ( 4312 ) - الضحاك بن شرحبيل ( ق ) عن زيد بن أسلم ضعفه أحمد بن حنبل أما(@)(@@)(@@)(@@) $ 3938 ( 3377 ت ) - الضحاك بن شرحبيل ( د ) المصري الغافقي(@)(@@) عن أبي هريرة فصدوق(@)(@@)(@@)(@@) $ 3939 ( 4312 ) - والضحاك بن شراحبيل ( خ م ) ويقال ابن شرحبيل المشرقي - ومشرق من همدان روى عن أبي سعيد الخدري وعنه الأزهري والأعمش وجماعة حجة مقل وكذا PageV03P443(@)(@@)(@@)(@@) $ 3940 ( 000 ) - الضحاك بن عبد الرحمن ( ت ق ) بن عرزب الشامي(@)(@@) قال العجلي تابعي ثقة(@)(@@)(@@)(@@) $ 3941 ( 000 ) - والضحاك بن عبد الرحمن ( س ) بن حوشب النصري الدمشقي(@)(@@) عن مكحول وعطاء الخراساني(@)(@@) قال دحيم ثقة ثبت(@)(@@)(@@)(@@) $ 3942 ( 4313 ) - الضحاك بن عبد الرحمن ( س ) بن حوشب النصري الدمشقي(@)(@@) عن مكحول وعطاء الخراساني(@)(@@) قال دحيم ثقة ثبت(@)(@@)(@@)(@@) $ 3943 ( 3378 ) - الضحاك بن عثمان ( م عو ) الحزامي المدني(@)(@@) عن التابعين صدوق(@)(@@) وقال يعقوب بن شيبة صدوق في حديثه ضعف(@)(@@) لينه يحيى القطان مع أنه قد روى عنه(@)(@@) وقال أبو حاتم لا يحتج به(@)(@@) وقال أبو زرعة ليس بقوي وروى عثمان بن سعيد عن يحيى ثقة(@)(@@) قلت روى عنه ابن وهب وابن أبي فديك وعدة فأما حفيده(@)(@@)(@@)(@@) $ 3944 ( 000 ) - الضحاك بن عثمان الضحاك بن عثمان بن عبد الله بن خالد أخي PageV03P444 حكيم ابن حزام الأسدي الحزامي المدني 
ms756	 فصدوق روى عن جده وعن مالك وعنه ابنه محمد وإبراهيم بن المنذر الحزامي وغيرهما(@)(@@) قال الخطيب كان علامة قريش بالمدينة بأخبار العرب وأشعارها من كبراء أصحاب مالك(@)(@@)(@@)(@@) $ 3945 ( 3379 ت ) - والضحاك بن عثمان شيخ لا يعرف(@)(@@) قال محمد بن المنذر الهروي حدثنا محمد بن حماد قال حدثني الضحاك بن عثمان من أهل زربة عن خادم الثوري حكاية(@)(@@)(@@)(@@) $ 3946 ( 3380 ت ) - ( صح ) الضحاك بن مخلد ( ع ) أبو عاصم النبيل أحد الأثبات تناكر العقيلي وذكره في كتابه وساق له حديثا خولف في سنده هكذا زعم أبو العباس النباتي وأنا فلم أجده في كتاب العقيلي(@)(@@) وقال النباتي ذكر لأبي عاصم أن يحيى بن سعيد يتكلم فيك فقال لست بحي ولا ميت إذا لم أذكر PageV03P445(@)(@@) قلت أجمعوا على توثيق أبي عاصم وقد قال عمر بن شبة والله ما رأيت مثله(@)(@@)(@@)(@@) $ 3947 ( 3381 ت ) - الضحاك بن مزاحم البلخي المفسر أبو القاسم(@)(@@) كناه ابن معين وأما الفلاس فكناه أبا محمد وكان يؤدب فيقال كان في مكتبه ثلاثة آلاف صبي وكان يطوف عليهم على حمار(@)(@@) ويروى أن الضحاك حملت به أمه عامين(@)(@@) قال يحيى القطان كان شعبة ينكر أن يكون الضحاك لقي ابن عباس قط(@)(@@) وقال الطيالسي حدثنا شعبة سمعت عبد الملك بن ميسرة يقول الضحاك لم يلق ابن عباس إنما لقي سعيد بن جبير بالري فأخذ عنه التفسير(@)(@@) سلم بن قتيبة حدثنا شعبة قال قلت لمشاش سمع الضحاك من ابن عباس قال ما رآه قط(@)(@@) وقال يحيى بن سعيد الضحاك ضعيف عندنا(@)(@@) ووثقه أحمد وابن معين وأبو زرعة وكان ابن معين يقول الضحاك المشرقي هو ابن مزاحم وتبعه على هذا يعقوب الفسوي وإنما الضحاك المشرقي ابن شراحيل حدث عن أبي سعيد الخدري ومشرق فخذ من همدان(@)(@@) قال ابن عدي الضحاك بن مزاحم إنما عرف بالتفسير فأما رواياته عن ابن عباس وأبي هريرة وجميع من روى عنه ففي ذلك كله نظر(@)(@@) وأما عبد الله بن أحمد فقال سمعت أبي يقول الضحاك بن مزاحم ثقة مأمون(@)(@@) قيل مات 
ms757	 سنة خمس ومائة وقيل سنة ست(@)(@@)(@@)(@@) $ 3948 ( 4315 ) - الضحاك بن مسافر شيخ يحدث عنه الوليد الموقري(@)(@@) لا يعرف مع ضعف الوليد PageV03P446(@)(@@)(@@)(@@) $ 3949 ( 4315 ) - الضحاك بن ميمون الثقفي(@)(@@) قال الأزدي يعرف وينكر(@)(@@)(@@)(@@) $ 3950 ( 3382 ت ) - الضحاك بن نبراس بصري(@)(@@) عن ثابت وغيره(@)(@@) قال ابن معين ليس بشيء(@)(@@) وقال النسائي متروك(@)(@@) وقال الدارقطني وغيره ضعيف وخرج له البخاري في كتاب الأدب(@)(@@) عبيد الله بن موسى حدثنا الضحاك بن نبراس عن ثابت عن أنس عن زيد بن ثابت قال أقيمت الصلاة فخرج رسول الله صلى الله عليه وسلم وأنا معه فقارب في الخطا وقال إنما فعلت ذلك ليكثر عدد خطاي في طلب الصلاة(@)(@@) أسد بن موسى حدثنا الضحاك بن نبراس عن يحيى بن أبي كثير عن أبي سلمة عن أبي هريرة مرفوعا اقرءوا القرآن ولا تأكلوا به ولا تستكثروا به ولا تغلوا فيه ولا تجفوا عنه PageV03P447(@)(@@)(@@)(@@) $ 3951 ( 4317 ) - الضحاك بن يربوع(@)(@@) قال الأزدي حديثه ليس بالقائم(@)(@@) الضحاك بن يسار بصري عن أبي عثمان النهدي ويزيد بن الشخير وجماعة وعنه مسلم وأبو الوليد والحوضي(@)(@@) قال ابن معين يضعفه البصريون(@)(@@) وقال أبو حاتم لابأس به وذكره ابن عدي فقال لاأعرف له إلا الشيء اليسير(@)(@@)(@@)(@@) $ 3952 ( 4319 ) - الضحاك الضبي عن أبيه مجهول(@)(@@) قاله أبو زرعة(@)(@@)(@@)(@@) $ 3953 ( 3383 ت ) - الضحاك المعافري ( ق )(@)(@@) عن سليمان بن موسى لا يعرف ما روى عنه سوى محمد بن مهاجر الأنصاري ذكره ابن حبان في ثقاته له حديث واحد في البعث(@)(@@)(@@)(@@) || ضرار(@)(@@)(@@)(@@) $ 3954 ( 4321 ) - ضرار بن سهل(@)(@@) عن الحسن بن عرفة بخبر باطل ولا يدرى من ذا الحيوان والحديث عن ابن عرفة حدثنا الأبار عن حميد عن أنس قال علي قال لي النبي صلى الله عليه وسلم يا علي إن الله أمرني أن أتخذ أبا بكر والدا وعمر مشيرا وعثمان سندا وأنت ظهيرا أنتم قد أخذ الله لكم الميثاق لا يحبكم إلا مؤمن تقي أنتم خلفاء أمتي وعقد ذمتي PageV03P448(@)(@@) رواه أخو تبوك عبد الوهاب الكلابي عن عبد الله بن أحمد الغباغبي أحد 
ms758	 المجهولين عن ضرار(@)(@@)(@@)(@@) $ 3955 ( 3384 ت ) - ضرار بن صرد أبو نعيم الطحان عن إبراهيم بن سعد(@)(@@) قال أبو عبد الله البخاري وغيره متروك(@)(@@) وقال يحيى بن معين كذابان بالكوفة هذا وأبو نعيم النخعي(@)(@@) ابن عدي حدثنا أحمد بن حمدون النيسابوري حدثنا جعفر بن الهذيل حدثنا ضرار بن صرد حدثنا يحيى بن عيسى الرملي عن الأعمش عن عباية عن ابن عباس - مرفوعا علي عيبة علمي(@)(@@) ابن حبان حدثنا محمد بن سليمان بن فارس حدثنا زكريا بن يحيى بن عاصم الكوفي حدثنا ضرار بن صرد حدثنا معتمر عن أبيه عن الحسن عن أنس أنه صلى الله عليه وسلم قال لعلي أنت تبين لأمتي ما اختلفوا فيه من بعدي(@)(@@) مات أبو نعيم الطحان سنة تسع وعشرين ومائتين(@)(@@) يروي عنه مطين وجماعة(@)(@@) قال النسائي ليس بثقة(@)(@@) وقال أبو حاتم صدوق لا يحتج به(@)(@@) وقال الدارقطني ضعيف(@)(@@)(@@)(@@) $ 3957 ( 4322 ) - ضرار بن عمرو الملطي(@)(@@) عن يزيد الرقاشي وغيره روى أحمد بن سعد بن أبي مريم عن يحيى لا شيء وقال الدولابي فيه نظر(@)(@@) ومن مناكيره عن محارب بن دثار عن ابن بريدة عن أبيه عن النبي صلى الله عليه وسلم أهل الجنة عشرون ومائة صف هذه الأمة ثمانون صفا PageV03P449(@)(@@) المعافي بن عمران عن ضرار بن عمرو عن الرقاشي عن أنس - مرفوعا لو أن آدم ومن دونه اشتركوا في دم مؤمن أكبهم الله في النار(@)(@@) ابن عدي حدثنا ابن أبي داود حدثنا حسين بن علي بن مهران حدثنا السميدع بن صبيح العتكي حدثنا ضرار عن الحسن عن أنس عن النبي - صلى الله عليه وسلم من قال أنا في النار فهو في النار ومن قال أنا في الجنة فهو في النار(@)(@@)(@@)(@@) $ 3958 ( 4323 ) - ضرار بن عمرو القاضي معتزلي جلد له مقالات خبيثة قال يمكن أن يكون جميع من يظهر الإسلام كفارا في الباطن لجواز ذلك على كل فرد منهم في نفسه(@)(@@) قال المروزي قال أحمد بن حنبل شهدت على ضرار عند سعيد بن عبد الرحمن القاضي فأمر بضرب 
ms759	 عنقه فهرب(@)(@@) وقيل إن يحيى بن خالد البرمكي أخفاه(@)(@@) قال ابن حزم كان ضرار ينكر عذاب القبر(@)(@@) قلت هذا المدبر لم يرو شيئا(@)(@@)(@@)(@@) $ 3959 ( 4324 ) - ضرار بن علي القاضي أبو المرجي لا يعرف حدث عنه لاحق بن الحسين ساقط(@)(@@)(@@)(@@) $ 3960 ( 4326 ) - ضرار بن مسعود جاء في إسناد مظلم بخبر باطل في فضل خوارزم(@)(@@)(@@)(@@) || ضمام(@)(@@)(@@)(@@) $ 3961 ( 3385 ت ) ضمام بن إسماعيل المصري(@)(@@) صالح الحديث PageV03P450 لينه بعضهم بلا حجة حدث عن أبي قبيل وموسى بن وردان وعنه ابن وهب وسويد بن سعيد وطائفة(@)(@@) وقال ابن معين لا بأس به وقال أبو حاتم كان صدوقا متعبدا(@)(@@) قلت مات ب ( الإسكندرية ) سنة خمس وثمانين ومائة(@)(@@) وقد أورده ابن عدي في ( كامله ) وسرد له أحاديث حسنة(@)(@@) وقال أحمد بن حنبل ضمام صالح الحديث كتبت عن سويد أحاديث ضمام(@)(@@) سويد حدثنا ضمام عن أبي قبيل قال عبدالله بن عمرو كنا نقول في الجاهلية زر غبا تزدد حبا حتى قال لنا رسول الله صلى الله عليه وسلم ذلك(@)(@@) سويد حدثنا ضمام ختن أبي قبيل على ابنته سمعت أبا قبيل يخبر عن معاوية أنه صعد المنبر يوم الجمعة فقال عند خطبته أيها الناس إن المال مالنا والفيء فيئنا من شئنا أعطينا PageV03P451(@)(@@) ومن شئنا منعنا فلم يجبه أحد فلما كانت الجمعة الثانية قال مثل ذلك فلم يجبه أحد فلما كانت الجمعة الثالثة قال ذلك فقام إليه رجل فقال يا معاوية كلا إنما المال مالنا والفيء فيئنا من حال بيننا وبينه حاكمناه إلى الله بأسيافنا فنزل معاوية فأرسل إلى الرجل فأدخل عليه فقال القوم هلكت ففتح معاوية الأبواب فدخل عليه الناس فوجدوا الرجل معه على السرير فقال معاوية إن هذا أحياني أحياه الله سمعت رسول الله صلى الله عليه وسلم يقول سيكون أئمة من بعدي يقولون فلا يرد عليهم يتقاحمون في النار كما تقاحم القردة وإني تكلمت أول جمعة فلم يرد علي أحد فخشيت أن أكون منهم ثم تكلمت الثانية فلم يرد علي أحد فقلت في نفسي إني من القوم 
ms760	 ثم تكلمت الجمعة الثالثة فقام هذا الرجل فرد علي فأحياني فرجوت أن يخرجني الله منهم ثم أعطاه وأجازه(@)(@@) رواه ابن عدي عن بهلول بن إسحاق عنه(@)(@@) قرأت بخط الضياء الحافظ ضمام بن إسماعيل عن موسى بن وردان متروك قاله الدارقطني(@)(@@)(@@)(@@) || ضمرة(@)(@@)(@@)(@@) $ 3962 [ 3386 ت ] - ضمرة بن حبيب المقدسي(@)(@@) لا يدرى من هو جاء في إسناد مجهول بمتن باطل(@)(@@) روى محمد بن علي بن عطية الحارثي حدثنا علي بن الحسن الجهضمي عن ضمرة بن حبيب عن أبيه عن العلاء بن زياد عن عبدالله بن حسن بن حسن بن علي عن أبيه عن جده عن علي - مرفوعا يجتمع ب عرفة جبرائيل وميكائيل والخضر فيقول جبرائيل ما شاء الله فذكر خبرا طويلا فأما(@)(@@)(@@)(@@) $ 3963 [ 000 ] - ضمرة بن حبيب ( عو ) الحمصي فتابعي ثقة(@)(@@) روى عن شداد بن أوس وأبي أمامة وجماعة(@)(@@)(@@)(@@) $ 3964 [ 000 ] - ضمرة بن ربيعة الرملي مشهور ما فيه مغمز PageV03P452(@)(@@) وثقه أحمد ويحيى بن معين(@)(@@) وقال أبو حاتم صالح الحديث تفرد ضمرة عن الثوري عن عبدالله بن دينار عن عبدالله بن عمر - مرفوعا من ملك ذا رحم محرم عتق أخرجه النسائي $ (@)(@@)(@@)(@@) || ضمضم(@)(@@)(@@)(@@) $ 3965 [ 3387 ت ] ضمضم بن زرعة ( د ) عن شريح بن عبيد(@)(@@) وثقه يحيى بن معين وضعفه أبو حاتم روى عنه جماعة(@)(@@)(@@)(@@) $ 3966 [ 3388 ت ] - ضمضم بن عمرو [ بخ ] شيخ للتبوذكي(@)(@@) قال أبو حاتم شيخ وقال الأزدي لين له عن كليب بن منفعة ويزيد الرقاشي بصري(@)(@@)(@@)(@@) || ضوء(@)(@@)(@@)(@@) $ 3967 [ 4326 ] - ضوء بن ضوء(@)(@@) قال الأزدي حديثه ذاهب ثم أخرج له من حديث أحمد بن الحارث حدثنا ضوء عن أبيه عن ابن عمر في الذي رآه خرج من قبره يلتهب نارا قال فوقعت مغشيا علي فأخبرت النبي صلى الله عليه وسلم فقال يا بن عمر وعظت فاتعظ ثم أمر ألا يسافر أحد وحده(@)(@@) قلت وأحمد بن الحارث الغساني متروك PageV03P453(@)(@@)(@@)(@@) | حرف الطاء(@)(@@)(@)(@@)(@@)(@@) || طارق(@)(@@)(@@)(@@) $ 3968 [ 3389 ت ] - طارق بن أبي الحسناء(@)(@@) عن الحسن البصري وعنه الأعمش مجهول(@)(@@)(@@)(@@) $ 3969 [ 000 ] - طارق بن زياد عن علي في الخوارج 