ms5511	 بن محمد بن سماعة. PageV17P397(@)(@@) التهذيب: ج 7، ح 639 (الاستبصار:(@)(@@) ج 3، ح 394)، و 723 (الاستبصار:(@)(@@) ج 3، ح 419)، و 781.(@)(@@) * وروى عن يونس بن ظبيان، وروى عنه عبد الله بن المغيرة.(@)(@@) الكافي: ج 1، ك 3، ب 11، ح 6.(@)(@@) * وروى عن الكاهلي، وروى عنه الحسن بن محمد بن سماعة.(@)(@@) التهذيب: ج 7، ح 569، و 743.(@)(@@) وروى عنه صالح بن أبي حماد.(@)(@@) الكافي: ج 6، ك 1، ب 18، ح 2.(@)(@@) محمد بن سالم * روى عن أبي جعفر عليه السلام، وروى عنه الحسين بن ميمون.(@)(@@) الكافي: ج 2، ك 1، ب 17، ح 1.(@)(@@) * وروى عن أبان بن تغلب، وروى عنه أبو المغراء.(@)(@@) الكافي: ج 1، ك 4، ب 19، ح 5.(@)(@@) * وروى عن أحمد بن النضر، وروى عنه أبو علي الأشعري.(@)(@@) الكافي: ج 2، ك 1، ب 26، ح 1، وب 36، ح 3، وب 69، ح 10، وب 75، ح 11، و ب 114، ح 2، وب 131، ح 5، و ب 151، ح 5، وك 2، ب 57، ح 14، و ك 3، ب 0، ح 11، وب 13، ح 10، و ك 4، ب 15، ح 8، و 15، و ج 3، ك 3، ب 3، ح 1، وب 15، ح 1، وب 50، ح 2، وب 80، ح 2، وك 4، ب 75، ح 8، و ج 5، ك 1، ب 18، ح 3، و ج 6، ك 6، ب 75، ح 2، وب 129، ح 2، وك 7، ب 35، ح 4، وك 8، ب 2، ح 2، وب 9، ح 9، وب 65، ح 13، و ج 7، ك 3، ب 31، ح 15، وب 61، ح 9. والروضة:(@)(@@) ح 27، و 89. والتهذيب: ج 1، ح 1359، و ج 3، ح 660، و 1018، و ج 10، ح 545.(@)(@@) وروى عنه أحمد بن إدريس.(@)(@@) الكافي: ج 3، ك 1، ب 4، ح 5. والتهذيب:(@)(@@) ج 1، ح 1427 (الاستبصار: ج 1، ح 712)، و ج 3، ح 434 (الاستبصار:(@)(@@) ج 1، ح 1819)، و 984 (الاستبصار:(@)(@@) ج 1، ح 1841)، و 995 (الاستبصار:(@)(@@) ج 1، ح 1812).(@)(@@) وروى عنه محمد بن عبد الجبار.(@)(@@) الكافي: ج 6، ك 6، ب 21، ح 1، وب 23، ح 6، وب 101، ح 6، وك 7، ب 6، ح 2.(@)(@@) * وروى عن أحمد بن النضر الخزاز، وروى عنه أبو علي الأشعري. PageV17P398(@)(@@) الكافي: ج 2، ك 1، ب 51، ح 8.(@)(@@) * وروى عن عبد الله بن سنان، وروى عنه علي بن الحسن.(@)(@@) التهذيب: ج 1، ح 1254.(@)(@@) وروى عنه علي بن الحسن بن فضال.(@)(@@) التهذيب: ج 4، ح 369.(@)(@@) * وروى عن محمد بن سنان، وروى أحمد بن أبي عبد الله، عن أبيه، عنه.(@)(@@) مشيخة الفقيه: في طريقه 
ms5512	 إلى النعمان الرازي.(@)(@@) * وروى عن موسى بن عبد الله بن موسى، وروى عنه علي بن محمد بن سعد.(@)(@@) الكافي: ج 6، ك 8، ب 43، ح 38.(@)(@@) * وروى عن بعض أصحابنا، عن الحكم بن مسكين، وروى عنه علي بن إبراهيم.(@)(@@) الكافي: ج 7، ك 3، ب 11، ح 5.(@)(@@) * وروى عن بعض أصحابه، عن الحكم بن مسكين، وروى عنه علي بن إبراهيم.(@)(@@) الكافي: ج 5، ك 3، ب 166، ح 3.(@)(@@) * وروى مرفوعا عن أمير المؤمنين عليه السلام، وروى عنه عمرو بن عثمان.(@)(@@) الكافي: ج 2، ك 1، ب 139، ح 14.(@)(@@) محمد بن سعيد * روى عن إسماعيل بن أبي زياد، وروى عنه محمد بن عيسى.(@)(@@) التهذيب: ج 1، ح 1406 (الاستبصار:(@)(@@) ج 1، ح 743).(@)(@@) وروى عنه موسى بن القاسم.(@)(@@) التهذيب: ج 5، ح 1224.(@)(@@) * وروى عن إسماعيل بن مسلم، وروى عنه موسى بن عيسى.(@)(@@) التهذيب: ج 1، ح 1307، و ج 2، ح 940.(@)(@@) * وروى عن زكريا بن محمد، وروى عنه أحمد بن أبي عبد الله.(@)(@@) الكافي: ج 5، ك 3، ب 187، ح 8.(@)(@@) وروى عنه أحمد بن محمد بن خالد.(@)(@@) الكافي: ج 5، ك 3، ب 186، ح 5.(@)(@@) * وروى عن القاسم بن عروة.(@)(@@) الروضة: ح 315.(@)(@@) * وروى عن السكوني، وروى عنه أبو همام.(@)(@@) الكافي: ج 7، ك 3، ب 49، ح 3.(@)(@@) والتهذيب: ج 1، ح 585 (الاستبصار: PageV17P399(@)(@@) ج 1، ح 567، وفيه محمد بن سعيد بن غزوان)، و ج 10، ح 110 (الاستبصار:(@)(@@) ج 4، ح 788).(@)(@@) محمد بن سليمان * روى عن الرضا عليه السلام، وروى عنه محمد بن أبي الصهبان.(@)(@@) التهذيب: ج 3، ح 217 (الاستبصار:(@)(@@) ج 1، ح 1801).(@)(@@) * وروى عن أبي جعفر عليه السلام، وروى عنه محمد بن أسلم.(@)(@@) الكافي: ج 4، ك 3، ب 235، ح 2.(@)(@@) والتهذيب: ج 6، ح 166.(@)(@@) * وروى عن أبي جعفر الثاني عليه السلام، وروى عنه الحسين بن سيف.(@)(@@) الكافي: ج 6، ك 2، ب 44، ح 1، و ج 7، ك 5، ب 23، ح 6. والتهذيب: ج 8، ح 495.(@)(@@) * وروى عن أبي حمزة الثمالي، وروى عنه زكريا المؤمن.(@)(@@) التهذيب: ج 6، ح 911.(@)(@@) * وروى عن أبي محمد، وروى عنه محمد بن الحسين.(@)(@@) الكافي: ج 5، ك 2، ب 19، ح 5.(@)(@@) والتهذيب: ج 6، ح 385.(@)(@@) * وروى عن أبيه، وروى عنه سهل ابن زياد.(@)(@@) الكافي: ج 3، ك 3، ب 12، ح 2، والروضة: ح 6، و 18.(@)(@@) وروى 
ms5513	 عنه عباد بن سليمان.(@)(@@) الكافي: ج 1، ك 4، ب 45، ح 3.(@)(@@) وروى عنه علي بن الحكم.(@)(@@) الكافي: ج 3، ك 4، ب 25، ح 19.(@)(@@) والتهذيب: ج 2، ح 418.(@)(@@) * وروى علي بن محمد، عن بعض أصحابنا، عنه.(@)(@@) التهذيب: ج 4، ح 927 (الاستبصار:(@)(@@) ج 2، ح 452).(@)(@@) * وروى علي بن محمد، عن بعض أصحابه، عنه.(@)(@@) الكافي: ج 4، ك 2، ب 13، ح 5.(@)(@@) وروى عنه غياث.(@)(@@) التهذيب: ج 8، ح 9 2.(@)(@@) وروى عنه محمد بن خالد.(@)(@@) الكافي: ج 1، ك 4، ب 108، ح 47.(@)(@@) وروى عنه المختار بن زياد.(@)(@@) الكافي: ج 1، ك 4، ب 93، ذيل ح 1.(@)(@@) * وروى عن ابن مسكان، وروى عنه الهيثم بن واقد. PageV17P400(@)(@@) الكافي: ج 2، ك 1، ب 168، ح 3.(@)(@@) * وروى عن إبراهيم بن أبي البلاد، وروى عن يوسف بن سخت البصري.(@)(@@) الكافي: ج 6، ك 8، ب 46، ح 5.(@)(@@) * وروى عن إبراهيم بن عبد الله الصوفي، وروى عنه علي بن محمد بن سعيد.(@)(@@) الروضة: ح 290.(@)(@@) * وروى عن إبراهيم بن الفضل، وروى عنه الحسين بن سيف.(@)(@@) التهذيب: ج 3، ح 251.(@)(@@) * وروى عن إسحاق بن عمار، وروى عنه محمد بن علي بن عدي.(@)(@@) الكافي: ج 2، ك 1، ب 88، ح 9.(@)(@@) * وروى عن إسماعيل بن إبراهيم، وروى عنه علي بن محمد.(@)(@@) الكافي: ج 2، ك 2، ب 30، ح 5.(@)(@@) * وروى عن داود، وروى عنه محمد ابن القاسم.(@)(@@) الكافي: ج 2، ك 3، ب 13، ح 6.(@)(@@) * وروى عن سماعة بن مهران، وروى عنه محمد بن أبي الصهبان.(@)(@@) التهذيب: ج 3، ح 217 (الاستبصار:(@)(@@) ج 1، ح 1801).(@)(@@) * وروى عن سيف بن عميرة، وروى علي بن محمد عن بعض أصحابه، عنه.(@)(@@) الكافي: ج 7، ك 4، ب 56، ح 7.(@)(@@) * وروى عن الصباح الحذاء، وروى عنه محمد بن أبي الصهبان.(@)(@@) التهذيب: ج 3، ح 217 (الاستبصار:(@)(@@) ج 1، ح 1801).(@)(@@) * وروى عن عبد الرحمان بن الحجاج، وروى عنه أحمد بن محمد.(@)(@@) التهذيب: ج 3، ح 680.(@)(@@) * وروى عن عبد الله بن سنان، وروى عنه إبراهيم بن إسحاق.(@)(@@) الكافي: ج 3، ك 5، ب 32، ح 3.(@)(@@) والتهذيب: ج 4، ح 286.(@)(@@) وروى عنه إبراهيم بن هاشم.(@)(@@) الكافي: ج 7، ك 3، ب 63، ح 10.(@)(@@) والتهذيب: ج 10، ح 235.(@)(@@) وروى عنه محمد بن عيسى القمي.(@)(@@) الكافي: ج 1، ك 4، ب 108، ح 22.(@)(@@) * وروى عن عبد الله بن لطيف التفليسي، 
ms5514	 وروى علي بن محمد عمن ذكره، عنه.(@)(@@) الكافي: ج 4، ك 2، ب 74، ح 3.(@)(@@) * وروى عن علي بن إبراهيم، وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 1، ك 1، ب 0، ح 22. PageV17P401(@)(@@) * وروى سهل بن زياد أو غيره عنه.(@)(@@) الكافي: ج 1، ك 3، ب 10، ح 12.(@)(@@) * وروى عن علي بن أبي حمزة، وروى عنه الحسن بن علي.(@)(@@) الكافي: ج 3، ك 4، ب 60، ح 3.(@)(@@) والتهذيب: ج 2، ح 797.(@)(@@) * وروى عن علي بن أيوب، وروى عنه محمد بن أحمد بن يحيى.(@)(@@) التهذيب: ج 7، ح 78 (الاستبصار: ج 3، ح 238).(@)(@@) * وروى عن عيثم بن أسلم، وروى عنه بكر بن صالح.(@)(@@) الكافي: ج 1، ك 4، ب 61، ح 3.(@)(@@) * وروى عيسى بن عبد الله، وروى عنه ابنه علي.(@)(@@) الكافي: ج 5، ك 2، ب 20، ح 7.(@)(@@) * وروى عن الفضل بن إسماعيل الهاشمي، وروى عنه إبراهيم بن هاشم.(@)(@@) الروضة: ح 42.(@)(@@) * وروى عن محمد بن محفوظ، وروى عنه علي بن محمد بن سعد.(@)(@@) الكافي: ج 2، ك 1، ب 81، ح 7.(@)(@@) * وروى عن مروان بن مسلم، وروى عنه الأصبغ بن الأصبغ.(@)(@@) الكافي: ج 7، ك 3، ب 45، ح 7.(@)(@@) والتهذيب: ج 10، ح 86.(@)(@@) * وروى عن موسى بن القادم، وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 3، ك 3، ب 6، ح 4.(@)(@@) * وروى عن ميمون ألبان، وروى عنه عثمان بن سعيد.(@)(@@) الكافي: ج 5، ك 3، ب 186، ح 9.(@)(@@) * وروى عن هارون بن الجهم، وروى عنه سهل.(@)(@@) الكافي: ج 1، ك 4، ب 67، ح 3.(@)(@@) * وروى عن يونس بن عبد الرحمن، وروى عنه محمد بن أبي الصهبان.(@)(@@) التهذيب: ج 3، ح 217 (الاستبصار:(@)(@@) ج 1، ح 1801).(@)(@@) * وروى عن بعض أصحابه، عن أبي الحسن عليه السلام، وروى عنه سهل ابن زياد.(@)(@@) الكافي: ج 2، ك 3، ب 11، ح 2.(@)(@@) محمد بن سليمان الديلمي * روى عن أبي عبد الله عليه السلام، وروى عنه يوسف أبو عاصم.(@)(@@) التهذيب: ج 2، ح 412. PageV17P402(@)(@@) * وروى عن أبيه.(@)(@@) الفقيه: ج 4، ح 644.(@)(@@) وروى عنه إبراهيم بن إسحاق.(@)(@@) الكافي: ج 3، ك 3، ب 32، ح 1.(@)(@@) والتهذيب: ج 1، ح 1292، و ج 2، ح 462، و ج 7، ح 138، و 195.(@)(@@) وروى عنه إبراهيم بن إسحاق الأحمر.(@)(@@) الكافي: ج 1، ك 1، ب 0، ح 8.(@)(@@) وروى عنه إبراهيم بن هاشم.(@)(@@) التهذيب: ج 9، ح 606.(@)(@@) وروى عنه 
ms5515	 عباد بن سليمان.(@)(@@) مشيخة الفقيه: في طريقه إلى سليمان الديلمي أبيه.(@)(@@) * وروى عن عبيد الله المدائني، وروى عنه جعفر بن محمد بن عبيد الله.(@)(@@) التهذيب: ج 10، ح 523 (الاستبصار:(@)(@@) ج 4، ح 969).(@)(@@) * وروى عن علي بن إبراهيم الهاشمي، وروى أحمد بن أبي عبد الله، عن أبيه، عنه.(@)(@@) الكافي: ج 1، ك 3، ب 26، ح 1.(@)(@@) * وروى عن علي بن أبي حمزة، وروى عنه محمد بن زيد الرزامي.(@)(@@) الكافي: ج 1، ك 4، ب 93، ح 1.(@)(@@) * وروى عن عيثم بن أسلم النجاشي، وروى عنه الحسن بن علي.(@)(@@) الكافي: ج 3، ك 4، ب 60، ح 2.(@)(@@) والتهذيب: ج 2، ح 796.(@)(@@) * وروى عن فريت (قريب)، وروى عنه الحسن بن علي.(@)(@@) الكافي: ج 3، ك 4، ب 60، ح 11.(@)(@@) والتهذيب: ج 2، ح 828.(@)(@@) * وروى عن هارون بن الجهم، وروى عنه ابن زياد.(@)(@@) الكافي: ج 1، ك 4، ب 67، ح 1.(@)(@@) وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 7، ك 3، ب 63، ح 31.(@)(@@) والتهذيب: ج 10، ح 502.(@)(@@) * وروى عن بعض أصحابنا، عن المفضل بن عمر، وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 1، ك 4، ب 67، ح 2.(@)(@@) محمد بن سماعة * روى عن أبي عبد الله عليه السلام، وروى عنه محمد بن يحيى.(@)(@@) الكافي: ج 1، ك 3، ب 6، ح 6.(@)(@@) * وروى عن أبي بصير، وروى عنه PageV17P403(@)(@@) أحمد.(@)(@@) الكافي: ج 6، ك 2، ب 3، ح 4.(@)(@@) وروى عنه أحمد بن محمد بن أبي نصر.(@)(@@) الكافي: ج 4، ك 1، ب 15، ح 3.(@)(@@) * وروى عن الحكم الحناط، وروى عنه محمد بن الوليد الخزاز.(@)(@@) التهذيب: ج 6، ح 272.(@)(@@) * وروى عن زرارة، وروى عنه ابن أبي نصر.(@)(@@) الكافي: ج 6، ك 2، ب 59، ح 1.(@)(@@) والتهذيب: ج 8، ح 124.(@)(@@) وروى عنه أحمد بن محمد بن أبي نصر البزنطي.(@)(@@) الفقيه: ج 3، ح 1703.(@)(@@) * وروى عن عبد الحميد، وروى عنه أحمد بن محمد.(@)(@@) التهذيب: ج 7، ح 1692، و 1696 (الاستبصار: ج 3، ح 883)، و 1733.(@)(@@) وروى عنه أحمد بن محمد بن أبي نصر.(@)(@@) الكافي: ج 5، ك 3، ب 67، ح 4.(@)(@@) * وروى عن عبد الحميد بن عواض، وروى عنه ابن أبي نصر.(@)(@@) التهذيب: ج 7، ح 184.(@)(@@) * وروى عن عمر بن معمر بن عطاء ابن وشيكة، وروى عنه أحمد بن محمد ابن أبي نصر.(@)(@@) الكافي: ج 6، ك 
