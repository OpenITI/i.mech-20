ms1181	(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 10390 ) قال النبي :(@)(@@) | 30 ( تطوع الرجل في بيته يزيد على تطوعه عند الناس كفضل صلاة الرجل في جماعة على صلاته وحده ) )(@)(@@) ( ش ) عن رجل .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 10391 ) قال النبي :(@)(@@) | 30 ( تطلق الأمة تطليقتين ، وقرؤها حيضتان ) )(@)(@@) ( هق ) عن عائشة رضي الله عنها .(@)(@@) PageV04P093(@)(@@)(@@)(@@) $ ( 10392 ) قال النبي :(@)(@@) | 30 ( تطلق الأمة تطليقتين وتعتد حيضتين ) )(@)(@@) ( هق ) وضعفه ( كر ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 10393 ) قال النبي :(@)(@@) | 30 ( تطعم الطعام وتقرىء السلام على من عرفت ومن لم تعرف ) )(@)(@@) ( حم خ م د ن ه ) عن ابن عمرو رضي الله عنه أن رجلا سأل رسول الله أي الإسلام خير ؟ قال : فذكره .(@)(@@)(@@)(@@) $ ( 10394 ) قال النبي :(@)(@@) | 30 ( تطلع عليكم قبل الساعة سحابة سوداء من قبل المغرب مثل الترس ، فما تزال ترتفع في السماء حتى تملأ السماء ، ثم ينادي مناد : يا أيها الناس فيقبل الناس بعضهم على بعض ، هل سمعتم ؟ فمنهم من يقول : نعم ، ومنهم من يشك ، ثم ينادي الثانية : يا أيها الناس فيقول للناس : هل سمعتم ؟ فيقولون : نعم ، ثم ينادي : يا أيها الناس أتى أمر الله فلا تستعجلوه ، فوالذي نفسي بيده إن الرجلين لينشران الثوب فما يطويانه ، وإن الرجل ليملا حوضه فما يسقي منه شيئا ، وإن الرجل ليجلب ناقته فما يشربه وتشغل الناس ) )(@)(@@) ك ) عن عقبة بن عامر رضي الله عنه .(@)(@@)(@@)(@@) ||| ( التاء مع العين(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 10395 ) قال النبي :(@)(@@) | 30 ( تعاد الصلاة من قدر الدرهم من الدم ) )(@)(@@) ( عد هق ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10396 ) قال النبي :(@)(@@) | 30 ( تعافوا الحدود فيما بينكم فما بلغني من حد فقد وجب ) )(@)(@@) ( د ن ك ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10397 ) قال النبي :(@)(@@) | 30 ( تعافوا تسقط الضغائن بينكم ) )(@)(@@) ( البزار ) عن ابن عمر PageV04P094 رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 10398 ) قال النبي :(@)(@@) | 30 ( تعالوا بايعوني على أن لا تشركوا بالله شيئا ولا تسرقوا ولا تزنوا ولا تقتلوا أولادكم ولا تأتوا ببهتان تفترونه بين أيديكم وأرجلكم ولا تعصوني في معروف ، فمن وفى منكم فأجره على الله ، ومن أصاب 
ms1182	 من ذالك شيئا فعوقب به في الدنيا فهو له كفارة ، ومن أصاب من ذالك شيئا فستره الله فأمره إلى الله إن شاء عاقبه وإن شاء عفا عنه ) )(@)(@@) ( خ ) عن عبادة بن الصامت رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 10399 ) قال النبي :(@)(@@) | 30 ( تعاهدوا القرآن ، فوالذي نفسي بيده لهو أشد تفصيا من قلوب الرجال من الإبل من عقلها ) )(@)(@@) ( حم ق ) عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10400 ) قال النبي :(@)(@@) | 30 ( تعاهدوا نعالكم عند أبواب المساجد ) )(@)(@@) ( قط ) في الأفراد ( خط ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 10401 ) قال النبي :(@)(@@) | 30 ( تعتري الحدة خيار أمتي ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 10402 ) قال النبي :(@)(@@) | 30 ( تعجلوا إلى الحج فإن أحدكم لا يدري ما يعرض له ) )(@)(@@) ( حم ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 10403 ) قال النبي :(@)(@@) | 30 ( تعرض أعمال الناس في كل جمعة مرتين : يوم الاثنين ويوم الخميس ، فيغفر لكل عبد مؤمن إلا عبدا بينه وبين أخيه شحناء فيقال : اتركوا هاذين حتى يفيئا ) )(@)(@@) ( م ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10404 ) قال النبي :(@)(@@) | 30 ( تعرض الأعمال على الله تعالى يوم الاثنين والخميس فيغفر الله إلا ما كان من متشاحنين أو قاطع رحم ) )(@)(@@) ( طب ) عن أسامة بن زيد PageV04P095 رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10405 ) قال النبي :(@)(@@) | 30 ( تعرض الأعمال يوم الاثنين والخميس على الله تعالى ، وتعرض على الأنبياء وعلى الآباء والأمهات يوم الجمعة فيفرحون بحسناتهم وتزداد وجوههم بياضا وإشراقا فاتقوا الله ولا تؤذوا موتاكم ) )(@)(@@) ( الحكيم ) عن والد عبد العزيز .(@)(@@)(@@)(@@) $ ( 10406 ) قال النبي :(@)(@@) | 30 ( تعرض الأعمال يوم الاثنين والخميس ، فاحب أن يعرض عملي وأنا صائم ) )(@)(@@) ( ن ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 10407 ) قال النبي :(@)(@@) | 30 ( تعرض الفتن على القلوب عرض الحصير عودا عودا ، فأي قلب أشربها نكتت فيه نكتة سوداء ، وأي قلب أنكرها نكتت فيه نكتة بيضاء حتى تصير على قلبين على أبيض مثل الصفا ، لا تضره فتنة ما دامت السماوات والأرض ، والآخر أسود مربدا كالكوز مجخيا لا يعرف معروفا وعلا ينكر منكرا إلا ما أشرب 
ms1183	 من هواه ) )(@)(@@) ( حم م ) عن حذيفة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 10408 ) قال النبي :(@)(@@) | 30 ( تعرف إلى الله في الرخاء يعرفك في الشدة ) )(@)(@@) ( أبو القاسم بن بشران في أماليه ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10409 ) قال النبي :(@)(@@) | 30 ( تعس عبد الدينار وعبد الدرهم وعبد الخميصة ، إن أعطي رضي ، وإن لم يعط سخط ، تعس وانتكس وإذا شيك فلا انتقش ، طوبى لعبد أخذ بعنان فرسه في سبيل الله ، أشعث رأسه ، مغبرة قدماه ، إن كان في الحراسة كان في الحراسة ، وإن كان في الساقة كان في الساقة ، إن استأذن لم يؤذن له ، وإن شفع لم يشفع ) )(@)(@@) ( خ ه ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@) PageV04P096(@)(@@)(@@)(@@) $ ( 10410 ) قال النبي :(@)(@@) | 30 ( تعشوا ولو بكف من حشف ، فإن ترك العشاء مهرمة ) )(@)(@@) ( ت ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10411 ) قال النبي :(@)(@@) | 30 ( تعلموا العلم وتعلموا للعلم السكينة والوقار ، وتواضعوا لمن تعلمون منه ) )(@)(@@) ( طس عد ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10412 ) قال النبي :(@)(@@) | 30 ( تعلموا العلم وتعلموا للعلم الوقار ) )(@)(@@) ( حل ) عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10413 ) قال النبي :(@)(@@) | 30 ( تعلموا الفرائض والقرآن وعلموا الناس فإني مقبوض ) )(@)(@@) ( ت ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10414 ) قال النبي :(@)(@@) | 30 ( تعلموا الفرائض وعلموه الناس فإنه نصف العلم وهو ينسى وهو أول شيء ينزع من أمتي ) )(@)(@@) ( ه ، ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10415 ) قال النبي :(@)(@@) | 30 ( تعلموا القرآن واقرؤوه وارقدوا فإن مثل القرآن لمن تعلمه فقرأه وقام به كمثل جراب محشو مسكا يفوح ريحه في كل مكان ، ومثل من تعلمه فيرقد وهو في جوفه كمثل جراب أوكىء على مسك ) )(@)(@@) ( ت ن ه حب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10416 ) قال النبي :(@)(@@) | 30 ( تعلموا أنه لن يرى أحد منكم ربه حتى يموت ) )(@)(@@) ( م ن ) عن رجل ( ز ) .(@)(@@)(@@)(@@) $ ( 10417 ) قال النبي :(@)(@@) | 30 ( تعلموا كتاب الله وتعاهدوه وتغنوا به ، فوالذي نفسي بيده لهو أشد تفلتا من المخاض في العقل ) )(@)(@@) ( حم ) عن عقبة بن عامر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10418 ) قال النبي :(@)(@@) | 30 
ms1184	 ( تعلموا ما شئتم أن تعلموا فلن ينفعكم الله حتى PageV04P097 تعملوا بما تعلمون ) )(@)(@@) ( عد خط ) عن معاذ ( وابن عساكر ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10419 ) قال النبي :(@)(@@) | 30 ( تعلموا مناسككم فإنها من دينكم ) )(@)(@@) ( ابن عساكر ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10420 ) قال النبي :(@)(@@) | 30 ( تعلموا من العلم ما شئتم فوالله لا تؤجروا بجمع العلم حتى تعملوا ) )(@)(@@) ( أبو الحسن بن الأخرم المديني ) في أماليه عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10421 ) قال النبي :(@)(@@) | 30 ( تعلموا من النجوم ما تهتدون به في ظلمات البر والبحر ثم انتهوا ) )(@)(@@) ( ابن مردويه ) في كتاب النجوم عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 10422 ) قال النبي :(@)(@@) | 30 ( تعلموا من أنسابكم ما تصلون به أرحامكم ، فإن صلة الرحم محبة في الأهل مثراة في المال ، منسأة في الأثر ) )(@)(@@) ( حم ت ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10423 ) قال النبي :(@)(@@) | 30 ( تعلموا من قريش ولا تعلموها ، وقدموا قريشا ولا تؤخروها فإن للقرشي قوة الرجلين من غير قريي ) )(@)(@@) ( ش ) عن سهل بن أبي خيثمة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10424 ) قال النبي :(@)(@@) | 30 ( تعمل هاذه الأمة برهة بكتاب الله ، ثم تعمل برهة بسنة رسول الله ، ثم تعمل بالرأي ، فإذا عملوا بالرأي فقد ضلوا وأضلوا ) )(@)(@@) ( ع ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10425 ) قال النبي :(@)(@@) | 30 ( تعوذوا بالله تعالى من الرغب ) )(@)(@@) ( الحكيم ) عن PageV04P098 أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10426 ) قال النبي :(@)(@@) | 30 ( تعوذوا بالله من ثلاث فواقر : جار سوء إن رأى خيرا كتمه ، وإن رأى شرا أذاعه ، وزوجة سوء إن دخلت عليها لسنتك ، وإن غبت عنها خانتك ، وإمام سوء إن أحسنت لم يقبل ، وإن أسأت لم يغفر ) )(@)(@@) ( هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10427 ) قال النبي :(@)(@@) | 30 ( تعوذوا بالله من جار السوء في دار المقام ، فإن الجار البادي يتحول عنك ) )(@)(@@) ( ن ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10428 ) قال النبي :(@)(@@) | 30 ( تعوذوا بالله من جب الحزن واد في جهنم تعوذ منه جهنم كل يوم أربعمائة مرة ، يدخله القراء المراءون بأعمالهم ، وإن من 
ms1185	 أبغض القراء إلى الله الذين يزورون الأمراء ) )(@)(@@) ( تخ ت ه ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 10429 ) قال النبي :(@)(@@) | 30 ( تعوذوا بالله من جهد البلاء ، ودرك الشقاء ، وسوء القضاء ، وشماتة الأعداء ) )(@)(@@) ( خ ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10430 ) قال النبي :(@)(@@) | 30 ( تعوذوا بالله من رأس الستين ومن إمارة الصبيان ) )(@)(@@) ( حم ع ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10431 ) قال النبي :(@)(@@) | 30 ( تعوذوا بالله من وسوسة الوضوء ) )(@)(@@) ( ابن أبي داود في ذم الوسوسة ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 10432 ) قال النبي :(@)(@@) | 30 ( تعال ادن مني حتى أخبرك عن المسافر ، إن الله عز PageV04P099 وجل وضع عنه الصيام ونصف الصلاة ) )(@)(@@) ( ن ) عن عمرو بن أمية الضمري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10433 ) قال النبي :(@)(@@) | 30 ( تعال فاستفد ) )(@)(@@) ( حم ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10434 ) قال النبي :(@)(@@) | 30 ( تعالوا بايعوني على أن لا تشركوا بالله شيئا ، ولا تسرقوا ، ولا تزنوا ، ولا تقتلوا أولادكم ، ولا تأتوا ببهتان تفترونه بين أيديكم وأرجلكم ، ولا تعصوني في معروف ، فمن وفى منكم فأجره على الله ، ومن أصاب من ذالك شيئا فعوقب به في الدنيا فهو له كفارة ، ومن أصاب من ذالك شيئا فستره الله فأمره إلى الله إن شاء عاقبه وإن شاء عفا عنه ) )(@)(@@) ( خ ) عن عبادة بن الصامت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10435 ) قال النبي :(@)(@@) | 30 ( تعال ، إن جبريل سارني الساعة فقال : إلا الدين فإنه يؤخذ منك ) )(@)(@@) ( هب ) عن ابن عمرو رضي الله عنهما أن رجلا قال : يا رسول الله ماذا لي إن قتلت في سبيل الله ؟ قال : الجنة ، فلما أدبر قال : فذكره .(@)(@@)(@@)(@@) $ ( 10436 ) قال النبي :(@)(@@) | 30 ( تعاهدوا القرآن ، فوالذي نفسي بيده لهو أشد تفصيامن صدور الرجال من الإبل النوازع إلى أوطانها ) )(@)(@@) ( طب ) و الخطيب عن ابن مسعود ( ش ) عنه موقوفا .(@)(@@)(@@)(@@) $ ( 10437 ) قال النبي :(@)(@@) | 30 ( تعاهدوا هاذا القرآن فإنه وحشي ، فلهو أسرع تفصيا من صدور الرجال من الإبل من عقلها ، ولا يقولن أحدكم نسيت آية كيت وكيت بل نسي ) )(@)(@@) محمد بن نصر 
ms1186	 ( طب ك ) عن ابن مسعود ( ش ) عن ابن مسعود رضي الله عنه موقوفا .(@)(@@) PageV04P100(@)(@@)(@@)(@@) $ ( 10438 ) قال النبي :(@)(@@) | 30 ( تعاهدوا هاذا القرآن فوالذي نفس محمد بيده لهو أشد تفلتا من قلوب الرجال من النعم من عقلها ) )(@)(@@) ( طب ) عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10439 ) قال النبي :(@)(@@) | 30 ( تعاهدوا نساءكم تناكحوا به أكفاءكم ، وتصلوا به أرحامكم ) )(@)(@@) البغوي عن ابن حسان عن أبيه وقال : لا أدري له صحبة أم لا .(@)(@@)(@@)(@@) $ ( 10440 ) قال النبي :(@)(@@) | 30 ( تعاهدوا الناس بالتذكرة واتبعوا الموعظة وهو أقوى للعالمين بما يحب الله ولا تخافوا في الله لومة لائم ، واتقوا الله الذي إليه تحشرون ) )(@)(@@) أبو نعيم والديلمي عن عبيد بن صخر بن لودان .(@)(@@)(@@)(@@) $ ( 10441 ) قال النبي :(@)(@@) | 30 ( تعاهدوا هاذه الصفوف فإني أراكم من خلفي ) )(@)(@@) عبد الرزاق وعبد بن حميد عن أنس رضي الله عنه وهو صحيح .(@)(@@)(@@)(@@) $ ( 10442 ) قال النبي :(@)(@@) | 30 ( تعبد الله لا تشرك به شيئا ، وتقيم الصلاة المكتوبة ، وتؤدي الزكاة المفروضة ، وتصوم رمضان ) )(@)(@@) ( حم خ م ) عن أبي هريرة أن أعرابيا أتى النبي فقال : دلني على عمل إذا عملته دخلت الجنة قال : فذكره ( حم خ م ن حب ) عن أيوب وزاد وتصل الرحم .(@)(@@)(@@)(@@) $ ( 10443 ) قال النبي :(@)(@@) | 30 ( تعبد الله وحده لا تشرك به شيئا ، وتقيم الصلاة المكتوبة ، وتؤتي الزكاة المفروضة ، وصيام شهر رمضان كما كتبه الله على الأمم من قبلكم ، وتحج البيت إتمامهن ، وما كرهت أن تأتيه إليك فلا تأته إليهم ) )(@)(@@) ابن أبي عمرو ورجاله ثقات .(@)(@@)(@@)(@@) $ ( 10444 ) قال النبي :(@)(@@) | 30 ( تعبد الله ولا تشرك به شيئا وتقيم الصلاة المكتوبة ، وتؤتي الزكاة ، وتصوم رمضان ، وتحج البيت ، وتأتي إلى الناس ما تحب أن يؤتى PageV04P101 إليك ، وتكره للناس ما تكره أن يؤتى إليك ) )(@)(@@) ابن سعد ( خ ) في التاريخ عن المغيرة بن عبد الله الشكري عن أبيه قال : قلت : يا رسول الله نبئني بعمل يدخلني الجنة ويباعدني من النار قال فذكره ( ش ) والعدني ( حم ) والبغوي وابن قانع ( طب ) عن المغيرة بن سعد بن الأحزم عن أبيه .(@)(@@)(@@)(@@) $ ( 10445 ) قال النبي :(@)(@@) | 30 ( تعبد الله تعالى لا 
ms1187	 تشرك به شيئا ، وتقيم الصلاة ، وتؤتي الزكاة ، وتصوم شهر رمضان ، وتحج وتعت مر ، وتسمع وتطيع ) )(@)(@@) ( ك ) عن عمر رضي الله عنه أن رجلا قال : يا رسول الله أوصني قال : فذكره .(@)(@@)(@@)(@@) $ ( 10446 ) قال النبي :(@)(@@) | 30 ( تعبد عابد من بني إسرائيل فعبد الله في صومعته ستين عاما ، فامطرت الأرض فاخضرت ، فأشرف الراهب من صومعته فقال : لو نزلت فذكرت الله لازددت خيرا ، فنزل ومعه رغيف أو رغيفان ، فبينما هو في الأرض لقيته امرأة ، فلم يزل يكلمها وتكلمه حتى غشيها ثم أغمي عليه ، فنزل الغدير يستحم ، فجاءه سائل فأومأ إليه أن يأخذ الرغيف أو الرغيفين ثم مات ، فوزنت عبادة ستين سنة بتلك الزنية فرجحت الزنية بحسناته ، ثم وضع الرغيف أو الرغيفان مع حسناته فرجحت حسناته فغفر له ) )(@)(@@) ( حب ) عن أبي ذر ، قال الحافظ بن حجر في اطرافه رواه ( حم ) في الزهد عن مغيث بن موسى مقطوعا وهو أشبه ومغيث تابعي أخذ عن كعب الأحبار وغيره .(@)(@@)(@@)(@@) $ ( 10447 ) قال النبي :(@)(@@) | 30 ( تعتد أيام أقرائها ثم تغتسل في كل يوم عند كل طهر وتصلي ) )(@)(@@) الشاشي ( قط ض ) عن جابر أن فاطمة بنت أبي حبيش سألت النبي عن المستحاضة كيف تصنع قال : فذكره .(@)(@@)(@@)(@@) $ ( 10448 ) قال النبي :(@)(@@) | 30 ( تعتق في عتقك ، وترقى في رقك ) )(@)(@@) ( حم ) PageV04P102 و البغوي عن إسماعيل بن أمية بن سعد بن العاصي عن أبيه عن جده قال : كان لنا غلام فأعتق نصفه فأتى النبي فذكر ذالك له قال : فذكره .(@)(@@)(@@)(@@) $ ( 10449 ) قال النبي :(@)(@@) | 30 ( تعجلوا الخروج إلى مكة فإن أحدكم لا يدري ما يعرض له من مرض أو حاجة ) )(@)(@@) الديلمي عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 10450 ) قال النبي :(@)(@@) | 30 ( تعرض أعمال بني آدم كل يوم اثنين وخميس ، فيرحم المترحمين ويستغفر للمستغفرين ثم يذر أهل الحقد بحقدهم ) )(@)(@@) ابن زنجويه ( طب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10451 ) قال النبي :(@)(@@) | 30 ( تعرضوا لله في أيامكم ، فإن لله عز وجل نفحات عسى أن تصيبكم منها واحدة لا تشقون بعدها أبدا ) )(@)(@@) ابن النجار عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 10452 
ms1188	 ) قال النبي :(@)(@@) | 30 ( تعرضوا للرزق ، فإن غلب أحدكم فليستدن على الله وعلى رسوله ) )(@)(@@) الديلمي عن بكر بن عبد الله بن عمرو المزني عن أبيه .(@)(@@)(@@)(@@) $ ( 10453 ) قال النبي :(@)(@@) | 30 ( تعرف ولا تغيب ولا تكتم فإن جاء صاحبها وإلا فهو مال الله تعالى يؤتيه من يشاء ) )(@)(@@) ( ك ) عن أبي هريرة رضي الله عنه أن رسول الله سئل عن اللقطة قال : فذكره .(@)(@@)(@@)(@@) $ ( 10454 ) قال النبي :(@)(@@) | 30 ( تعسير نزع الصبي تمحيص للوالدين ) )(@)(@@) ( ك ) في تاريخه و الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10455 ) قال النبي :(@)(@@) | 30 ( تعظه وتدفعه ) )(@)(@@) ابن قانع عن قابوس بن الحجاج عن أبيه أن رجلا قال : يا رسول الله أرأيت رجلا يأخذ مالي ما تأمرني قال : فذكره .(@)(@@)(@@)(@@) $ ( 10456 ) قال النبي :(@)(@@) | 30 ( تعفو فإن عاقبت فعاقب بقدر الذنب واتق الوجه ) )(@)(@@) ( طب ) عن جري رضي الله عنه .(@)(@@) PageV04P103(@)(@@)(@@)(@@) $ ( 10457 ) قال النبي :(@)(@@) | 30 ( تعفو عنهم كل يوم سبعين مرة يعني المماليك ) )(@)(@@) ( طب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 10458 ) قال النبي :(@)(@@) | 30 ( تعلمون أني رحمة مهداة بعثت برفع قوم ووضع آخرين ) )(@)(@@) ابن سعد عن معبد بن خالد مرسلا .(@)(@@)(@@)(@@) $ ( 10459 ) قال النبي :(@)(@@) | 30 ( تعلمن أن الله لم ينزل داء إلا أنزل له دواء غير واحد : الهرم ) )(@)(@@) ( ك ) عن صفوان بن عسال رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10460 ) قال النبي :(@)(@@) | 30 ( تعلموا القرآن ، فوالذي نفسي بيده إن الشيطان ليخرج من البيت تقرأ فيه سوررة البقرة ) )(@)(@@) ( عد ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10461 ) قال النبي :(@)(@@) | 30 ( تعلموا العلم وعلموه الناس ، وتعلموا الفرائض وعلموها الناس ) )(@)(@@) ( قط ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10462 ) قال النبي :(@)(@@) | 30 ( تعلموا القرآن وعلموه الناس ، وتعلموا الفرائض وعلموه الناس ، فإن أمره مقبوض ، وإن العلم سيقبض وتظهر الفتن حتى يختلف الاثنان في الفريضة لا يجدان من يقضي بها ) )(@)(@@) ( ك ق ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10463 ) قال النبي :(@)(@@) | 30 ( تعلموا سيد الاستغفار : اللهم أنت ربي ، لا إلاه إلا أنت ، خلقتني وأنا عبدك ، وأنا على عهدك ووعدك ما استطعت ، أعوذ بك من شر ما صنعت ، أبوء 
ms1189	 لك بنعمتك علي وأبوء بذنبي فاغفر لي ذنبي إنه لا يغفر الذنوب إلا أنت ) )(@)(@@) عبد بن حميد وابن السني في عمل يوم وليلة ( ض ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10464 ) قال النبي :(@)(@@) | 30 ( تعلموا القرآن واتلوه فإن الله جازيكم على تلاوته بكل حرف عشر حسنات ، أما إني لا أقول الم حرف ) )(@)(@@) ابن الضريس عن ابن مسعود رضي الله عنه .(@)(@@) PageV04P104(@)(@@)(@@)(@@) $ ( 10465 ) قال النبي :(@)(@@) | 30 ( تعلموا القرآن وسلوا الله به الجنة قبل أن يتعلمه قوم يسألون به الدنيا ، فإن القرآن يتعلمه ثلاثة نفر : رجل يباهي به ، ورجل يستأكل به ، ورجل يقرؤه لله ) )(@)(@@) ابن نصر ( هب ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10466 ) قال النبي :(@)(@@) | 30 ( تعلموا القرآن وأقرئوه واقرأوا منه ما تيسر ، فوالذي نفس محمد بيده لهو أشد تفصيا من الإبل المعقلة ، تعلمن أنه من قرأ خمسين آية في ليلة لم يكتب من الغافلين ، ومن قرأ بمائة آية في ليلة كتب من القانتين ، ومن قرأ بمائتي آية في ليلة لم يحاجه القرآن تلك الليلة ومن قرأ بخمسمائة آية إلى ألف آية أصبح وله قنطار من الجنة ) )(@)(@@) ابن الضريس عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10467 ) قال النبي :(@)(@@) | 30 ( تعلموا اليقين كما تعلموا القرآن حتى تعرفوه فإني أتعلمه ) )(@)(@@) ( حل ) عن ثور بن يزيد مرسلا .(@)(@@)(@@)(@@) $ ( 10468 ) قال النبي :(@)(@@) | 30 ( تعلموا من أنسابكم ما تصلون به أرحامكم ثم انتهوا ، وتعلموا من العربية ما تعربون به كتاب الله ثم انتهوا ، وتعلموا من النجوم ما تهتدون به في ظلمات البر والبحر ثم انتهوا ) )(@)(@@) ( هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10469 ) قال النبي :(@)(@@) | 30 ( تعلموا العلم وعلموه الناس ) )(@)(@@) ( هب ) عن أبي بكر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10470 ) قال النبي :(@)(@@) | 30 ( تعلموا القرآن والتمسوا غرائبه ، وغرائبه فرائضه ، وفرائضه حدوده ، وحدوده حلال وحرام ومحكم ومتشابه وأمثال ، فأحلوا حلاله وحرموا حرامه واعملوا بمحكمه ، وآمنوا بمتشابهه ، واعتبروا بأمثاله ) )(@)(@@) الديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10471 ) قال النبي :(@)(@@) | 30 ( تعلموا الرمي والقرآن ، وخير ساعات المؤمن حين يذكر الله عز وجل ) )(@)(@@) الديلمي عن أبي 
ms1190	 سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10472 ) قال النبي :(@)(@@) | 30 ( تعلموا الرمي فإن ما بين الهدفين روضة من رياض PageV04P105 الجنة ) )(@)(@@) الديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10473 ) قال النبي :(@)(@@) | 30 ( تعلموا من أمر النجوم ما تهتدون به في ظلمات البر والبحر ثم انتهوا ، ومن أمر النساء ما يحل لكم وما يحرم عليكم ثم انتهوا ، ومن الأنساب ما تصلون به أرحامكم ثم انتهوا ) )(@)(@@) ابن السني والديلمي عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 10474 ) قال النبي :(@)(@@) | 30 ( تعلموا اللحن فيه كما تعلمون حفظه ) )(@)(@@) الديلمي عن أبي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10475 ) قال النبي :(@)(@@) | 30 ( تعلموا فإنه لا صلاة إلا يتشهد ) )(@)(@@) البزار ( طس ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10476 ) قال النبي :(@)(@@) | 30 ( تعلموا الزهراوين : البقرة وآل عمران ، فإنهما يجيئان يوم القيامة كأنهما غمامتان أو كأنهما غيابتان ، أو كأنهما فرقان من طير صواف تحاجان عن صاحبهما ، تعلموا البقرة فإن أخذها بركة وتركها حسرة ولا تستطيعها البطلة ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 10477 ) قال النبي :(@)(@@) | 30 ( تعلموا العلم قبل أن يرفع ، فإن أحدكم لا يدري ما يفتقر إلى ما عنده ، وعليكم بالعلم ، وإياكم والتنطع والتبدع والتعمق ، وعليكم بالعتيق ) )(@)(@@) الديلمي عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10478 ) قال النبي :(@)(@@) | 30 ( تعلموا العلم قبل أن يرفع ، فإن أحدكم لا يدري متى يفتقر إلى ما عنده ) )(@)(@@) الديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10479 ) قال النبي :(@)(@@) | 30 ( تعلموا العلم فإن تعليمه لله خشية ، وطلبه عبادة ، ومذاكرته تسبيح ، والبحث عنه جهاد ) )(@)(@@) الخطيب في المتفق والمفترق عن معاذ وفيه كنانة بن جبلة قال ابن معين : كذاب ، وقال أبو حاتم : محله الصدق ، وقال PageV04P106 السعدي : ضعيف جدا ، ورواه الديلمي وزاد : ( وتعليمه لمن لا يعلمه صدقة ، وبذله لأهله قربة لأنه معالم الحلال والحرام ، ومنار سبيل الجنة ، والأنيس في الوحشة ، والصاحب في الوحدة ، والمحدث في الخلوة ، والدليل على السراء والضراء ، والسلاح على الأعداء ، والدين عند الأخلاء ، والقرب عند الغرباء ، يرفع الله به أقواما فيجعلهم في الخير قادة ) ) $ ورواه بطوله ابن لال وأبو نعيم 
ms1191	 عن معاذ رضي الله عنه موقوفا .(@)(@@)(@@)(@@) $ ( 10480 ) قال النبي :(@)(@@) | 30 ( تعلموا سورة البقرة فإن أخذها بركة وتركها حسرة ، ولا تستطيعها البطلة ، تعلموا سورة البقرة وآل عمران فإنهما الزهراوان يظلان صاحبهما يوم القيامة كأنهما غمامتان أو غيابتان أو فرقان من طير صواف ، وإن القرآن يلقى صاحبه يوم القيامة حين ينشق عنه قبره كالرجل المشاجر الشاحب فيقول له : هل تعرفني ؟ فيقول : ما أعرفك ، فيقول : أنا صاحبك القرآن الذي أظمأتك في الهواجر ، وأسهرت ليلك ، وإن كل تاجر من وراء تجارته ، وإنك اليوم من وراء كل تجارة فيعطى الملك بيمينه والخلد بشماله ، ويوضع على رأسه تاج الوقار ، ويكسى والداه حلتين لا تقوم لهما الدنيا فيقولان : بم كسينا هاذا ؟ فيقال : بأخذ ولدكما القرآن ، ثم يقال : اقرأ واصعد في درج الجنة وغرفها ، فهو في صعود ما دام يقرأ هاذا كان أو ترتيلا ) )(@)(@@) ( حم ) و الدارمي والروياني ( عق ك هب ) عن عبد الله بن بريدة عن أبيه وروى ا ( ه ) بعضه مختصرا .(@)(@@)(@@)(@@) $ ( 10481 ) قال النبي :(@)(@@) | 30 ( تعوذوا بالله من الفقر والقلة والذلة ، وأن تظلم أو تظلم ) )(@)(@@) ( ن ك حب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10482 ) قال النبي :(@)(@@) | 30 ( تعوذوا من خشوع النفاق : خشوع البدن ونفاق القلب ) )(@)(@@) ( هب ) عن أبي بكر ( ك ) في تاريخه عن ابن عمر رضي الله عنهم .(@)(@@) PageV04P107(@)(@@)(@@)(@@) $ ( 10483 ) قال النبي :(@)(@@) | 30 ( تعوذوا بالله من ثلاث : من طمع حيث لا مطمع ومن طمع يرد إلى طبع ، ومن طمع يرد إلاى مطمع ) )(@)(@@) ( طب ) عن عوف بن مالك رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10484 ) قال النبي :(@)(@@) | 30 ( تعوذوا بالله من طمع يهدي إلاى طبع ، ومن طبع يهدى إلاى غير مطمع ) )(@)(@@) ( طب ) عن المقدام بن معدى كرب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10485 ) قال النبي :(@)(@@) | 30 ( تعوذوا بالله من شر جار المقام فإن الجار المسافر إذا شاء ذايل ) )(@)(@@) الخرائطي في مساوىء الأخلاق عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10486 ) قال النبي :(@)(@@) | 30 ( تعوذوا بالله من فخرالقراء فهم أشد فخرا من الجبابرة ، ولا شيء أبغض إلاى الله من قارىء فخور ) )(@)(@@) الديلمي عن أنس 
ms1192	 رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10487 ) قال النبي :(@)(@@) | 30 ( تعوذوا بالله من جهنم ، تعوذوا بالله من عذاب القبر ، تعوذوا بالله من فتنة المسيح الدجال ، تعوذوا بالله من فتنة المحيا والممات ) )(@)(@@) ( ش ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10488 ) قال النبي :(@)(@@) | 30 ( تعوذوا بالله من الفتن ما ظهر منها وما بطن ) )(@)(@@) ( ش ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) ||| ( التاء مع الغين(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 10489 ) قال النبي :(@)(@@) | 30 ( تغزون جزيرة العرب فيفتحها الله ، ثم فارس فيفتحها الله ، ثم تغزون الروم فيفتحها الله ، ثم تغزون الدجال فيفتحها الله ) )(@)(@@) PageV04P108 ( حم م ه ) عن نافع بن عتبة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 10490 ) قال النبي :(@)(@@) | 30 ( تغطية الرأس بالنهار فقة وبالليل ريبة ) )(@)(@@) ( عد ) عن واثلة رضي الله عنه .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 10491 ) قال النبي :(@)(@@) | 30 ( تغيب الشمس تحت العرش فيؤذن لها فترجع ، فإذا كانت تلك الليلة التي تطلع صبيحتها من المغرب لم يؤذن لها ) )(@)(@@) ( حم ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) ||| ( التاء مع الفاء(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 10492 ) قال النبي :(@)(@@) | 30 ( تفتح أبواب الجنة يوم الإثنين ويوم الخميس فيغفر فيها لكل عبد لا يشرك بالله شيئا إلا رجلا كانت بينه وبين أخيه شحناء فيقال انظروا هاذين حتى يصطلحا ) )(@)(@@) ( خد م د ت ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10493 ) قال النبي :(@)(@@) | 30 ( تفتح أبواب السماء لخمس لقراءة القرآن ، وللقاء الزحفين ، ولنزول القطر ، ولدعوة المظلوم ، وللأذان ) )(@)(@@) ( طس ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 10494 ) قال النبي :(@)(@@) | 30 ( تفتح أبواب السماء نصف الليل فينادي مناد هل من داع فيستجاب له ، هل من سائل فيعطى ، هل من مكروب فيفرج عنه ، فلا يبقى PageV04P109 مسلم يدعو بدعوة إلا استجاب الله تعالى له الا زانية تسعى بفرجها أو عشار ) )(@)(@@) ( طب ) عن عثمان بن أبي العاص رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10495 ) قال النبي :(@)(@@) | 30 ( تفتح أبواب السماء ويستجاب الدعاء في أربعة مواطن : عند التقاء الصفوف في سبيل الله ، وعند نزول الغيث ، وعند إقامة الصلاة ، وعند رؤية الكعبة ) )(@)(@@) ( طب ) عن أبي أمامة رضي 
ms1193	 الله عنه .(@)(@@)(@@)(@@) $ ( 10496 ) قال النبي :(@)(@@) | 30 ( تفتح اليمن فيأتي قوم يبسون فيتحملون بأهليهم ومن أطاعهم والمدينة خير لهم لو كانوا يعلمون ، وتفتح الشام فيأتي قوم يبسون فيتحملون بأهليهم ومن أطاعهم والمدينة خير لهم لو كانوا يعلمون ، وتفتح العراق فيأتي قوم يبسون فيتحملون بأهليهم ومن أطاعهم والمدينة خير لهم لو كانوا يعلمون ) )(@)(@@) ( مالك ق ) عن سفيان بن أبي زهير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10497 ) قال النبي :(@)(@@) | 30 ( تفتح لكم أرض الأعاجم وستجدون فيها بيوتا يقال لها الحمامات فلا يدخلها الرجال إلا بازار ، وامنعوا النساء أن يدخلنها إلا مريضة أو نفساء ) )(@)(@@) ( ه ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 10498 ) قال النبي :(@)(@@) | 30 ( تفتح يأجوج ومأجوج فيخرجوننعلى الناس كما قال الله عز وجل : من كل حدب ينسلون فيغشون الناس وينحاز المسلمون عنهم إلى مدائنهم وحصونهم ويضمون إليهم مواشيهم ويشربون مياه الأرض حتى إن بعضهم ليمر بالنهر فيشربون ما فيه حتى يتركوه يبسا ، حتى إن من يمر من بعدهم ليمر بذالك النهر فيقول : قد كان هاهنا ماء مرة حتى إذا لم يبق من الناس أحد إلا أحد في حصن أو مدينة قال قائلهم : هاؤلاء أهل الأرض قد فرغنا منهم بقي أهل السماء ، ثم يهز أحدهم حربته ثم يرمي بها إلى السماء فترجع إليه مختضبة دما للبلاء والفتنة ، فبينما هم على ذالك إذ بعث الله عز وجل دودا في أعناقهم كنغف الجراد الذي يخرج في أعناقه ، فيصبحون موتى لا يسمع لهم حس فيقول المسلمون : ألا رجل يشري لنا PageV04P110 نفسه فينظر ما فعل هاذا العدو ، فيتجرد رجل منهم محتسبا نفسه قد أوطنها على أنه مقتول ، فينزل فيجدهم موتى بعضهم على بعض ، فينادي : يا معشر المسلمين ألا أبشروا إن الله عز وجل قد كفاكم عدوكم فيخرجون من مدائنهم وحصونهم ويسرحون مواشيهم ، فما يكون لهم مرعى إلا لحومهم فتشكر عنه كأحسن ما شكرت عن شيء من النبات أصابته قط ) )(@)(@@) ( حم ه حب ك ) عن أبي سعيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 10499 ) قال النبي :(@)(@@) | 30 ( تفرغوا من هموم الدنيا ما 
ms1194	 استطعتم ، فإنه من كانت الدنيا أكبر همه أفشى الله ضيعته وجعل فقره بين عينيه ، ومن كانت الآخرة أكبر همه جمع الله تعالى له أمره وجعل غناه في قلبه ، وما أقبل عبد بقلبه إلى الله تعالى إلا جعل الله قلوب المؤمنين تفد إليه بالود والرحمة وكان الله تعالى بكل خير إليه أسرع ) )(@)(@@) ( طب ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10500 ) قال النبي :(@)(@@) | 30 ( تفضل صلاة الجمع صلاة أحدكم وحده بخمس وعشرين جزءا ، وتجتمع ملائكة الليل وملائكة النهار في صلاة الفجر ) )(@)(@@) ( خ ن ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 10501 ) قال النبي :(@)(@@) | 30 ( تفقدوا نعالكم عند أبواب المساجد ) )(@)(@@) ( حل ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 10502 ) قال النبي :(@)(@@) | 30 ( تفقه وتوقه ) ( حب حل ) عن ا$ بن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 10503 ) قال النبي :(@)(@@) | 30 ( تفكروا في آلاء الله ولا تفكروا في الله ) )(@)(@@) ( أبو الشيخ طس عد هب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 10504 ) قال النبي :(@)(@@) | 30 ( تفكروا في خلق الله ولا تفكروا في الله ) )(@)(@@) ( حل ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 10505 ) قال النبي :(@)(@@) | 30 ( تفكروا في الخلق ولا تفكروا في الخالق فإنكم لا PageV04P111 تقدرون قدره ) )(@)(@@) ( أبو الشيخ ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 10506 ) قال النبي :(@)(@@) | 30 ( تفكروا في خلق الله ولا تفكروا في الله فتهلكوا ) )(@)(@@) ( أبو الشيخ ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10507 ) قال النبي :(@)(@@) | 30 ( تفكروا في كل شيء ولا تفكروا في ذات الله تعالى ، فإن بين السماء السابعة إلى كرسيه سبعة آلاف نور وهو فوق ذالك ) )(@)(@@) ( أبو الشيخ في العظمة ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 10508 ) قال النبي :(@)(@@) | 30 ( تفتح البلاد والأمصار فيقول الرجال لاخوانهم : هلم إلى الريف ، والمدينة خير لهم لو كانوا يعلمون : لا يصبر على لأوائها وشدتها أحد إلا كنت له يوم القيامة شهيدا أو شفيعا ) )(@)(@@) ( حم ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10509 ) قال النبي :(@)(@@) | 30 ( تفتح فيه يعني في رمضان أبواب 