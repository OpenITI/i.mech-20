ms41	 بالغبار % % 9(@)(@@) % لئن جهل الزمان فأنت عذر % % له فامح الإساءة باغتفار % % 10(@)(@@) % فإنك من رداء الفخر كاس % % وإنك من لباس العار عار % % PageV01P165 11(@)(@@) % وليك في بلاد اليمن وال % % وجارك في رياض الأمن حجار % % PageV01P166 البحر : - 1(@)(@@) % وزائرة وليس بها حياء % % وليس تزور إلا في النهار % % 2(@)(@@) % ولو رهبت لدى الإقدام جوري % % لما رغبت جهارا في جواري % % 3(@)(@@) % أتت والقلب في وهج اشتياق % % لتظهر ما أواري من أواري % % 4(@)(@@) % ولو عرفت لظى سطوات عزمي % % لكانت من سطاي على حذار % % 5(@)(@@) % تقيم فحين تبصر من أناتي % % ثبات الطود تسرع في الفرار % % 6(@)(@@) % تفارقني على غير اغتسال % % فلم أحلل لزورتها إزاري % % 7(@)(@@) % أيا شمس الملوك بقيت شمسا % % تنير على الممالك والديار % % 8(@)(@@) % يجد إلى العلى أبدا بدارا % % فلا عبر الأذى منه بدار % % 9(@)(@@) % لئن حمي المزاج فغير بدع % % فنار ذكاك تقذف بالشرار % % 10(@)(@@) % أحماك استعارت لفح نار % % لعزمك لم تزل ذات استعار % % PageV01P167 11(@)(@@) % فقد نهضت إليك بلا احتشام % % وقد جسرت عليك بلا اعتذار % % 12(@)(@@) % وما إن حم ليث الغاب إلا % % ليوقد ناره عند الغوار % % 13(@)(@@) % ولفح العارض الساري دليل % % من الغيث الملث على انهمار % % 14(@)(@@) % وما أحمى مزاجك غير لطف % % لخلقك سالب لطف العقار % % PageV01P168 البحر : هزج 1(@)(@@) % أهني الملك الناصر % % بالملك وبالنصر % % 2(@)(@@) % وما مهد من بنيان % % دين الحق في مصر % % 3(@)(@@) % وما أسداه من بر % % بلا عد ولا حصر % % 4(@)(@@) % وما أحياه من عدل % % وما خفف من إصر % % 5(@)(@@) % وإعلاء سنا السنة % % في بحبوحة القصر % % 6(@)(@@) % قد استولى على مصر % % بحق يوسف العصر % % 7(@)(@@) % وأحيا سنة الإحسان % % في البدو وفي الحضر % % PageV01P169 البحر : خفيف تام 1(@)(@@) % قد خطبنا للمستضيء بمصر % % نائب المصطفى إمام العصر % % 2(@)(@@) % وخذلنا لنصرة العضد العاضد % % والقاصر الذي بالقصر % % 3(@)(@@) % وأشعنا بها شعار بني العباس % % ماستشرت وجوه النصر % % 4(@)(@@) % ووضعنا للمستضيء بأمر الله % % عن أوليائه كل إصر % % 5(@)(@@) % وتركنا الدعي يدعو ثبورا % % وهو بالذل تحت حجر وحصر % % 6(@)(@@) % وتباهت منابر الدين بالخطبة % % للهاشمي في أرض مصر % % 7(@)(@@) % وجرى من نداه دجلة 
ms42	 بغداد % % بشطر ونيل مصر بشطر % % 8(@)(@@) % وقد اهتز للهدى كل عطف % % مثلما افتر بالمنى كل ثغر % % 9(@)(@@) % فبجدواه زائل كل فقر % % وبنعماه آهل كل فقر % % 10(@)(@@) % ونداء الهدى أزال من الأسماع % % ماع في كل خطة كل وقر % % PageV01P170 11(@)(@@) % نشكر الله إذ أتم لنا النصر % % ونرجو مزيد أهل الشكر % % 12(@)(@@) % ولدينا تضاعفت نعم الله % % وجلت عن كل عد وحصر % % 13(@)(@@) % فاغتدى الدين ثابت الركن في مصر % % محوط الحمى مصون الثغر % % 14(@)(@@) % واستنارت عزائم الملك العادل % % نور الدين الكريم الأغر % % 15(@)(@@) % وبنو الأصفر القوامص منه % % بوجوه من المخافة صفر % % 16(@)(@@) % عرف الحق أهل مصر وكانوا % % قبله بين منكر ومقر % % 17(@)(@@) % هو فتح بكر ودون البرايا % % خصنا الله بافتراع البكر % % 18(@)(@@) % وحصلنا بالحمد والأجر والنصر % % وطيب الثنا وحسن الذكر % % 19(@)(@@) % ونشرنا أعلامنا السود مهرا % % للعدى الزرق بالمنايا الحمر % % 20(@)(@@) % واستعدنا من أدعياء حقوقا % % تدعى بينهم لزيد وعمرو % % PageV01P171 21(@)(@@) % والذي يدعي الإمامة بالقاهرة % % انحط في حضيض القهر % % 22(@)(@@) % خانه الدهر في مناه ولا يطمع % % ذو اللب في وفاء الدهر % % 23(@)(@@) % ما يقام الإمام إلا بحق % % ما تحاز الحسناء إلا بمهر % % 24(@)(@@) % خلفاء الهدى سراة بني العباس % % والطيبون أهل الطهر % % 25(@)(@@) % بهم الدين ظافر مستقيم % % ظاهر قوة قوي الظهر % % 26(@)(@@) % كشموس الضحى كمثل بدور الثم % % كالسحب كالنجوم الزهر % % 27(@)(@@) % قد بلغنا بالصبر كل مراد % % وبلوغ المراد عقبى الصبر % % 28(@)(@@) % وتمام الحبور ما تم من خطبة % % خير الخلائف ابن الحبر % % 29(@)(@@) % مهبط الوحي بيته منزل الذكر % % بشفع من المثاني ووتر % % 30(@)(@@) % ليس مثري الرجال من ملك المال % % ولكنما أخو اللب مثر % % PageV01P172 31(@)(@@) % ولهذا لم ينتفع صاحب القصر % % وقد شارف الدثور بدثر % % 32(@)(@@) % لسوى نظم مدحه أهجر النظم % % فما مدح غيره غير هجر % % 33(@)(@@) % وأرتنا له قلائد من % % وبر ليست بجيد ونحر % % 34(@)(@@) % وبإنعامه تزايد شكري % % وبتشريفه تضاعف فخري % % 35(@)(@@) % كم ثراء وقوة وانشراح % % منه في راحتي وقلبي وصدري % % 36(@)(@@) % وعلي النذور في مثل ذا اليوم % % وهذا يوم الوفاء بنذري % % 37(@)(@@) % واستهلت بوارق الأنعم الغر % % به في 
ms43	 حيا الأيادي الغزر % % 38(@)(@@) % نعش الحق بعد طول عثار % % جبر الحق بعد وهن وكسر % % 39(@)(@@) % دام نصر الهدى بملك بني العباس % % حتى يكون يوم الحشر % % PageV01P173 البحر : طويل 1(@)(@@) % هجرتكم لا عن ملال ولا عذر % % ولكن لمقدور أتيح من الأمر % % PageV01P174 البحر : خفيف تام 1(@)(@@) % قيل في مصر نائل عدد الرمل % % ووفر كنيلها الموفور % % 2(@)(@@) % فاغتررنا بها وسرنا إليها % % ووقعنا كما ترى في الغرور % % 3(@)(@@) % وحظينا بالرمل والسير فيه % % ومنعنا من نيلها الميسور % % 4(@)(@@) % وبرزنا إلى المبرز نشكو % % سدرا من نزولنا بالسدير % % 5(@)(@@) % وعددنا في الرعاع فلا في العير % % ندعى ولا في النفير % % 6(@)(@@) % قيل لي سر إلى الجهاد وماذا % % بالغ في الجهاد جهد مسيري % % 7(@)(@@) % ليس يقوى في الجيش جأشي ولا قوسي % % يرى موتورا إلى موتور % % 8(@)(@@) % أنا للكتب لا للكتائب إقدامي % % وللصحف لا الصفاح حضوري % % 9(@)(@@) % كاد فضلي يضيع لولا اهتمام الفاضل % % الفائض الندى بأموري % % 10(@)(@@) % وأنا منه في ملابس جاه % % رافلا منه في حبير حبور % % PageV01P175 11(@)(@@) % فهو رقى من الحضيض حظوظي % % وسما بي إلى سرير السرور % % PageV01P176 البحر : سريع 1(@)(@@) % يا ملكا أيامه لم تزل % % بفصله فاضلة فاخره % % 2(@)(@@) % غاصت بحار الجود مذ غيبت % % أنملك الفائضة الزاخره % % 3(@)(@@) % ملكت دنياك وخلفتها % % وسرت حتى تملك الآخرة % % PageV01P177 البحر : سريع 1(@)(@@) % ما صورة ما مثلها صوره % % كأنها في العمق مطموره % % 2(@)(@@) % تمطر للري ومن ذا رأى % % مطمورة للري ممطوره % % 3(@)(@@) % منكوحة ما لم تضع حملها % % مسدودة الأنفاس محصوره % % 4(@)(@@) % محرورة القلب ولكنها % % مضروبة بالبرد مقروره % % 5(@)(@@) % كأنما النار بأحشائها % % على اشتداد البرد مسجوره % % 6(@)(@@) % تظل ملقاة على رأسها % % خمارة تحسب مخموره % % 7(@)(@@) % معارة الهامة من غيرها % % قصيرة القامة ممكوره % % 8(@)(@@) % كأنها رأس بلا جثة % % موصولة إن شئت مبتوره % % 9(@)(@@) % كهامة صلعاء محلوقة % % ما استعملت موسى ولا نوره % % 10(@)(@@) % زامرة في فمها زمرها % % وهي بغير الزمر مشهوره % % PageV01P178 11(@)(@@) % دوارة إن أنت أرسلتها % % مهتوكة الأستار مستوره % % 12(@)(@@) % من فضها تبصق في وجهه % % كأنها بالفحش مأموره % % 13(@)(@@) % تورث تعبيسا لمن باسها % % وهي على ذلك مشكوره % % 14 
ms44	(@)(@@) % معسولة ريقتها مزة % % وهي على اللذة مقصوره % % 15(@)(@@) % وهي على ما هي في إثره % % مرسلة بالهضم منصوره % % 16(@)(@@) % إن عقلت قرت وإن أنشطت % % فرت وثارت مثل مذعوره % % 17(@)(@@) % كم عسل ذاقت وكم سكر % % وأنعم ليست بمكفوره % % 18(@)(@@) % ملمومة من صخرة صلدة % % فاجرة بالماء مفجوره % % 19(@)(@@) % من الصفا جسم ولكن ترى % % على صفاء الماء تاموره % % 20(@)(@@) % فيا حليف المأثرات التي % % أضحت لأهل الفضل مشهوره % % PageV01P179 21(@)(@@) % أنعم وعجل حل إشكالها % % فهي لدى فضلك مأسوره % % PageV01P180 البحر : كامل تام 1(@)(@@) % لهفي على من كان صبحي وجهه % % فعدمت حين عدمته أنواره % % 2(@)(@@) % سكن التراب وغاض ماء حياته % % مذ أطفأت ريح المنية ناره % % PageV01P181 البحر : كامل تام 1(@)(@@) % الدين في ظلم لغيبة نوره % % والدهر في غم لفقد أميره % % 2(@)(@@) % فليندب الإسلام حامي أهله % % والشام حافظ ملكه وثغوره % % 3(@)(@@) % ما أعظم المقدار في أخطاره % % إذ كان هذا الخطب في مقدوره % % 4(@)(@@) % ما أكثر المتأسفين لفقد من % % قرت نواظرهم بفقد نظيره % % 5(@)(@@) % ما أعوص الإنسان في نسيانه % % أو ما كفاه الموت في تذكيره % % 6(@)(@@) % من للمساجد والمدارس بانيا % % لله طوعا عن خلوص ضميره % % 7(@)(@@) % ومن ينصر الإسلام في غزواته % % فلقد أصيب بركنه وظهيره % % 8(@)(@@) % من للفرنج من لأسر ملوكها % % من للهدى يبغي فكاك أسيره % % 9(@)(@@) % من للخطوب مذللا لجماحها % % من للزمان مسهلا لوعوره % % 10(@)(@@) % من كاشف للمعضلات برأيه % % من مشرق في الداجيات بنوره % % PageV01P182 11(@)(@@) % من للكريم ومن لنعش عثاره % % من لليتيم ومن لجبر كسيره % % 12(@)(@@) % من للبلاد ومن لنصر جيوشها % % من للجهاد ومن لحفظ أموره % % 13(@)(@@) % من للفتوح محاولا أبكارها % % برواحه في غزوه وبكوره % % 14(@)(@@) % من للعلى وعهودها من للندى % % ووفوده من للحجا ووفوره % % 15(@)(@@) % ما كنت أحسب نور دين محمد % % يخبو وليل الشرك في ديجوره % % 16(@)(@@) % أعزز عل بليث غاب للهدى % % يخلو الشرى من زوره وزئيره % % 17(@)(@@) % أعزز علي بان أراه مغيبا % % عن محفل متشرف بحضوره % % 18(@)(@@) % لهفي على تلك الأنامل إنها % % مذ غيبت غاض الندى ببحوره % % 19(@)(@@) % ولقد أتى من كنت تجري رسمه % % فضع العلامة منك في 
ms45	 منشوره % % 20(@)(@@) % ولقد أتى من كنت تكشف كربه % % فارفع ظلامته بنصر عشيره % % PageV01P183 21(@)(@@) % ولقد أتى من كنت تؤمن سربه % % وقع له بالأمن من محذوره % % 22(@)(@@) % ولقد أتى من كنت تؤثر قربه % % فأدم له التقريب في تقريره % % 23(@)(@@) % والجيش قد ركب الغداة لعرضه % % فاركب لتبصره أوان عبوره % % 24(@)(@@) % أنت الذي أحييت شرع محمد % % وقضيت بعد وفاته بنشوره % % 25(@)(@@) % كم قد أقمت من الشريعة معلما % % هو منذ غبت معرض لدثوره % % 26(@)(@@) % ولبست رضوان المهيمن ساحبا % % أذيال سندس خزه وحريره % % 27(@)(@@) % وسكنت عليين في فردوسه % % حلف المسرة ظافرا بأجوره % % PageV01P184 البحر : طويل 1(@)(@@) % تذاكر من وراد مصر عصابة % % حديث فتى طاب الندي بذكره % % 2(@)(@@) % وقالوا رأينا فاضلا ذا نباهة % % أديبا يفوق الفاضلين بفخره % % 3(@)(@@) % يدين حبيب والوليد لنظمه % % ويحمده عبد الحميد لنثره % % 4(@)(@@) % ولو عاش قس في زمان بيانه % % لكان مشيدا في البيان بشكره % % 5(@)(@@) % فضائله كالشمس نورا ولم تزل % % مناقبه في الدهر أعداد زهره % % 6(@)(@@) % بيان هو السحر الحلال وإننا % % نرى معجزا من فضله حل سحره % % 7(@)(@@) % ذوو الفضل هم عند الحقيقة أبحر % % ولكنهم أضحوا جداول بحره % % 8(@)(@@) % يضوع مهب الحمد من عرف عرفه % % وتأرج أرجاء الرجاء بنشره % % 9(@)(@@) % فقلت لهم هذا الذي تصفونه % % أبو اليمن تاج الدين أوجه عصره % % PageV01P185 البحر : طويل 1(@)(@@) % أعيذكم أن تغفلوا عن أموره % % وأن تتركوه نهبة لمغيره % % 2(@)(@@) % عفا الله عنكم قد عفا رسم ودكم % % خلعتم على عهدي دثار دثوره % % 3(@)(@@) % بما بيننا يا صاحبي من مودة % % وفاءك إني قانع بيسيره % % 4(@)(@@) % وهذا أوان النصح إن كنت ناصحا % % أخا فقبيح تركه بغروره % % 5(@)(@@) % وإني أرى الأري المشور مشورة % % حلت موقعا عند امرئ من مشيره % % 6(@)(@@) % تحملت عبء الوجد غير مطيقه % % وعلمت صبر القلب غير صبوره % % 7(@)(@@) % صلوا من قضى من وحشة البين نحبه % % ونشر مطاوي أنسه في نشوره % % 8(@)(@@) % رعى الله نجدا إذ شكرنا بقربكم % % قصار ليالي العيش بين قصوره % % 9(@)(@@) % وإذ راقت الأبصار حسنى حسانه % % وأطربت الأسماع نجوى سميره % % 10(@)(@@) % وإذ بكرات الروض ألسنة الصبا % % تعبر في 
ms46	 انفاسها عن عبيره % % PageV01P186 11(@)(@@) % وإذ تكتب الأنداء في شجراته % % وأوراقها إملاء ورق طيوره % % 12(@)(@@) % أيا نجد حياك الحيا بأحبتي % % بهم كنت كالفردوس زين نحوره % % 13(@)(@@) % وما طاب عرف الريح إلا لأنه % % أصاب عبيرا منك عند عبوره % % 14(@)(@@) % ومطلقة لما رأتني موثقا % % أعنة دمع أنزعت من غديره % % 15(@)(@@) % تناشدني بالله من لي ومن ترى % % يقوم لبيت شدته بأموره % % 16(@)(@@) % فقلت لها بالله عودي فإنما % % هو الكافل الكافي بجبر كسيره % % 17(@)(@@) % هو الفلك الدوار لكن على الورى % % مقدرة أحداثه من مديره % % 18(@)(@@) % عذري أضحى عاذلي في خطوبه % % فيا من عذير المبتلى من عذيره % % 19(@)(@@) % يجرعني من كأسه صرف صرفه % % فعيش مرير ذوقه في مروره % % 20(@)(@@) % ولست أرى عاما من العمر ينقصني % % حميدا ولم أفرح بمر شهوره % % PageV01P187 21(@)(@@) % لحى الله دهرا ضاق بي إذ وسعته % % بفضلي كما ضاقت صدور صدوره % % 22(@)(@@) % فلم أر فيها واحدا غير واعد % % يخيل لي زور الخيال بزروه % % 23(@)(@@) % وما كنت أدري أن فضلي ناقصي % % وأن ظلام الحظ من فيض نوره % % 24(@)(@@) % كذلك طول الليل من ذي صبابه % % يخبره عن عيشه بقصوره % % 25(@)(@@) % وما كنت أدري أن عقلي عاقلي % % وأن سراري حادث من سفوره % % 26(@)(@@) % وكان كتاب الفضل باسمي معنونا % % فحاول حظي محوه من سطوره % % 27(@)(@@) % فيا ليت فضلي ألآسري قد عدمته % % فأضحى فداء في فكاك أسيره % % 28(@)(@@) % أرى الفضل معتاد له خسف أهله % % كما الأفق معتاد خسوف بدوره % % 29(@)(@@) % أقول لعزمي إن للمجد منهجا % % سهول الأماني في سلوك وعوره % % 30(@)(@@) % فهون عليك الصعب فيه فإنما % % بأخطاره تحظى بوصل خطيره % % PageV01P188 31(@)(@@) % ومالي يا فكري سواك مظاهر % % وقد يستعين المبتلى بظهيره % % 32(@)(@@) % فخل معنى خاض في غمراته % % وحسبك معنى خضت لي في بحوره % % 33(@)(@@) % وكن لي سفير الخير تسفر مطالبي % % فحظ الفتى إسفاره بسفيره % % 34(@)(@@) % وقل للذي في الجدب أطلق جده % % سبيل الحيا حتى همى بدروره % % 35(@)(@@) % لماذا حبستم مخلصا في ولائكم % % وما الله ملقي مؤمن في سعيره % % 36(@)(@@) % وكم فدفد جاوزت أجوازه سرى % % كأني وشاح جائل في خضوره % % 37 
ms47	(@)(@@) % بمهرية تحكي بكفي زمامها % % وأحكي لكد السير بعض سيوره % % 38(@)(@@) % وخاطب أبكار الفدافد جاعل % % بكار المهارى في السرى من مهوره % % 39(@)(@@) % وإن رجاء بالإمام أنوطه % % حقيق بآمالي ابتسام ثغوره % % 40(@)(@@) % تقر بعلياه الخلافة عينها % % فناظرها لم يكتحل بنظيره % % PageV01P189 41(@)(@@) % أرى الله أعطى يوسفا حسن يوسف % % ومكنه في العالمين لخيره % % 42(@)(@@) % برتني صروف الحادثات فآوني % % تضع مني الإنعام عند شكوره % % 43(@)(@@) % كذا القلم المبري آوته أنمل % % فقام يؤدي شكرها بصريره % % 44(@)(@@) % وما زهر هامي الرباب يحوكه % % تعمم هامات الربى بحريره % % 45(@)(@@) % كأن سقيط الطل في صفحاته % % سحيرا نظيم الدر بين نثيره % % 46(@)(@@) % يقابل منه النرجس الورد مثلما % % رأت وجنة المعشوق عين غيوره % % 47(@)(@@) % وللورد خد بالبنفسج معذر % % ونرجسه طرف رنا بفتوره % % 48(@)(@@) % بأبهج من شعر مدحتكم به % % ومعناكم مستودع في ضميره % % 49(@)(@@) % وماحق هذا الشعر لا لجريره % % وقد سار في الآفاق جيش جريره % % PageV01P190 البحر : دو بيت 1(@)(@@) % لا راحة في العيش سوى أن أغزو % % سيفي طربا إلى الطلى يهتز % % 2(@)(@@) % في ذل ذوي الكفر يكون العز % % والقدرة في غير جهاد عجز % % PageV01P191 البحر : خفيف تام 1(@)(@@) % شادن كالقضيب لدن المهزه % % سلبت مقلتاه قلبي بغمزه % % 2(@)(@@) % كلما رمت وصله رام هجري % % وإذا زدت ذلة زاد عزه % % 3(@)(@@) % للصبا من عذاره نسج حسن % % رقم المسك في الشقائق طرزه % % 4(@)(@@) % وعزيز علي أن اصطباري % % فيه قد عزه الغرام وبزه % % 5(@)(@@) % ما رأى ما رأيت مجنون ليلى % % في هواه ولا كثير عزه % % 6(@)(@@) % ما ذكرنا الفسطاط إلا نسينا % % ما رأينا بالنير بين والأرزه % % 7(@)(@@) % فمها الجيزة الجوازي لها الميزة % % حسنا على ظباء المزة % % 8(@)(@@) % ونصيري عليه نائل عز الدين % % ذي الفضل خلد الله عزه % % 9(@)(@@) % فرغ الكنز من ذخائر مال % % مالئا من نفائس الحمد كنزه % % 10(@)(@@) % همة مستهامة بالمعالي % % للدنايا أبية مشمئزه % % PageV01P192 البحر : رجز تام 1(@)(@@) % سلطت المطل على نجازها % % وضيعت حقي في مجازها % % 2(@)(@@) % وصالها من الحياة منيتي % % من لي بالفرصة في انتهازها % % 3(@)(@@) % وجنتها الوردة في احمرارها % % وقدها البانة في اهتزازها % % 4(@)(@@) % شمس الضحى 
ms48	 في الحسن لم تضاهها % % بدر الدجى في التم لم يوازها % % 5(@)(@@) % أعطاه رب العالمين دولة % % عزة أهل الدين في إعززها % % 6(@)(@@) % حاز العلى ببأسه وجوده % % وهو أحق الخلق باحتيازها % % 7(@)(@@) % بجده أفنى كنوزا فني المملوك % % في الجد على اكتنازها % % 8(@)(@@) % مهلك أهل الشرك طرا روحها % % أرمنها إفرنجها إنجازها % % 9(@)(@@) % تفاخر الإسلام من سلطانه % % تفاخر الفرس بأبراوازها % % 10(@)(@@) % تهن من فتح عزاز نصرة % % أوقعت العداة في اعتزازها % % PageV01P193 11(@)(@@) % واليوم ذلت حلب فإنها % % كانت تنال العز من عزازها % % 12(@)(@@) % وحلب تنفي كمشتكينها % % كما انتفت بغداد عن قيمازها % % 13(@)(@@) % برزت في نصر الهدى بحجة % % وضوح نهج الحق في إبرازها % % 14(@)(@@) % كم حامل للرمح عاد مبديا % % عجز عجوز الحي عن عكازها % % 15(@)(@@) % ارفع حظوظي من حضيض نقصها % % وعد عن همازها لمازها % % 16(@)(@@) % والشعر لا بد له من باعث % % كحاجة الخيل إلى مهمازها % % PageV01P194 البحر : بسيط تام 1(@)(@@) % استوحش القلب مذ غبتم فما أنسا % % وأظلم اليوم مذ بنتم فما شمسا % % 2(@)(@@) % ما طبت نفسا ولا استحسنت بعدكم % % شيئا نفيسا ولا استعذبت لي نفسا % % 3(@)(@@) % قلبي وصبري وغمضي والشباب وما % % ألفتم من نشاطي كله خلسا % % 4(@)(@@) % وكيف يصبح أو يمسي محبكم % % وشوقكم يتولاه صباح مسا % % 5(@)(@@) % عادت معاهدكم بالجزع دراسة % % وإن معهدكم في القلب ما درسا % % 6(@)(@@) % وكنت أحدس منكم كل داهية % % وما دهانا من الهجران ما حدسا % % 7(@)(@@) % لما هدت نار شوقي ضيف طيفكم % % قريته بالكرى أذرار مقتبسا % % 8(@)(@@) % ورمت تأنيسه حتى وهبت له % % إنسان عيني أفديه فما أنسا % % 9(@)(@@) % أنا الخيال نحولا فالخيال إذا % % ما زارني كيف يلقى من به التبسا % % 10(@)(@@) % لهفي على زمن قضيته طربا % % إذ لم أكن من صروف الدهر محترسا % % PageV01P195 11(@)(@@) % عسى يعود شبابي ناضرا ومتى % % أرجو نضارة عود للشباب عسى % % 12(@)(@@) % وشادن يغرس الآساد ناظره % % فديته شادنا للأسد مفترسا % % 13(@)(@@) % في العطف لين وفي أخلاقه شوس % % يا لين عطفيه جنب خلقه الشوسا % % 14(@)(@@) % إن بان لبس مضينا لاجئين إلى الفتى % % الحسام بن لاجين بنابلسا % % 15(@)(@@) % يميت أعداءه بأسا ونائله % % يحيي 
ms49	 رجاء الذي من نجمه أيسا % % 16(@)(@@) % ممزق المازق المنسوج عثيره % % وقد محا اليوم ليل النقع فانطمسا % % 17(@)(@@) % لا زلت مستويا فوق الحصان وفي % % حصن الحفاظ ومن عاداك منتكسا % % 18(@)(@@) % قل للمليك صلاح الدين أكرم من % % يمشي على الأرض أو من يركب الفرسا % % 19(@)(@@) % من بعد فتحك بيت القدس ليس سوى % % صور فإن فتحت فاقصد طرابلسا % % 20(@)(@@) % أثر على يوم انطرسوس ذا لجب % % وابعث إلى ليل أنطاكية العسسا % % PageV01P196 21(@)(@@) % وأخل ساحل هذا الشام أجمعه % % من العداة ومن في دينه وكسا % % 22(@)(@@) % ولا تدع منهم نفسا ولا نفسا % % فإنهم يأخذون النفس والنفسا % % 23(@)(@@) % نزلت بالقدس فاستفتحه ومتى % % تقصد طرابلسا فانزل على قدسا % % 24(@)(@@) % يا يوم حطين والأبطال عابسة % % وبالعجاجة وجه الشمس قد عبسا % % 25(@)(@@) % رأيت فيه عظيم الكفر محتقرا % % معفرا خده والأنف قد تعسا % % 26(@)(@@) % يا طهر سيف برى رأس البرنس فقد % % أصاب أعظم من بالشرك قد نجسا % % 27(@)(@@) % وغاص إذ طار ذاك الرأس في دمه % % كأنه ضفدع في الماء قد عطسا % % 28(@)(@@) % ما زال يعطس مزكوما بغدرته % % والقتل تشميت من بالغدر قد عطسا % % 29(@)(@@) % عرى ظباه من الأغماد مهرقة % % أدما من الشرك رداها به وكسا % % 30(@)(@@) % من سيفه في دماء القوم منغمس % % من كل من لم يزل في الكفر منغمسا % % PageV01P197 31(@)(@@) % أفناهم قتلهم والأسر فانتكوا % % وبيت كفرهم من خبثهم كنسا % % PageV01P198 البحر : طويل 1(@)(@@) % أطيب بأنفاس تطيب لكم نفسا % % وتعتاض من ذكراكم وحشتي أنسا % % 2(@)(@@) % وأسأل عنكم عافيات دوارس % % غدت بلسان الحال ناطقة خرسا % % 3(@)(@@) % معاهدكم ما بالها كعهودكم % % وقد كررت من درس آثارها درسا % % 4(@)(@@) % وقد كان في حدسي لكم كل طارق % % وما جئتم من هجركم خالف الحدسا % % 5(@)(@@) % أرى حدثان الدهر ينسى حديثه % % وأما حديث الغدر منكم فلا ينسى % % 6(@)(@@) % تزول الجبال الراسبات وثابت % % رسيس غرام في فؤادي لكم أرسى % % 7(@)(@@) % حسبت حبيبي قاسي القلب وحده % % وقلب الذي يهوى بحمل الهوى أقسى % % 8(@)(@@) % أما لكم يا مالكي الرق رقة % % يطيب بها مملوككم منكم نفسا % % 9(@)(@@) % وإن سروري كنت أسمع حسه 
ms50	 % % فمذ سرت عنكم ما سمعت له حسا % % 10(@)(@@) % وإن نهاري صار ليلا لبعدكم % % فما أبصرت عيني صباحا ولا شمسا % % PageV01P199 11(@)(@@) % بكيت على مستودعات قلوبكم % % كما قد بكت قدما على صخرها الخنسا % % 12(@)(@@) % فلا تحبسوا عني الجميل فإنني % % جعلت على حبي لكم مهجتي حبسا % % 13(@)(@@) % رأيت صلاح الدين أفضل من غدا % % وأشرف من أضحى وأكرم من أمسى % % 14(@)(@@) % وقيل لنا في الأرض سبعة أبحر % % ولسنا نرى إلا أنامله الخمسا % % 15(@)(@@) % سجيته الحسنى وشيمته الرضا % % وبطشته الكبرى وعزمته القعسا % % 16(@)(@@) % فلا عدمت أيامنا منه مشرقا % % ينير بما يولي ليالينا الدمسا % % 17(@)(@@) % جنودك أملاك السماء وظنهم % % عداتك جن الأرض في الفتك لا الإنسا % % 18(@)(@@) % فلا يستحق القدس غيرك في الورى % % فأنت الذي من دونهم فتح القدسا % % 19(@)(@@) % ومن قبل فتح القدس كنت مقدسا % % فلا عدمت أخلاقك الطهر والقدسا % % 20(@)(@@) % وطهرته من رجسهم بدمائهم % % فأذهبت بالرجس الذي ذهب الرجسا % % PageV01P200 21(@)(@@) % نزعت لباس الكفر عن قدس أرضها % % وألبستها الدين الذي كشف اللبسا % % 22(@)(@@) % وعادت ببيت الله أحكام دينه % % فلا بطركا أبقيت فيها ولا قسا % % 23(@)(@@) % وقد شاع في الآفاق عنك بشارة % % بأن أذان القدس قد أبطل النقسا % % 24(@)(@@) % جرى بالذي تهوى القضاء وظاهرت % % ملائكة الرحمن أجنادك الحمسا % % 25(@)(@@) % وكم لبني أيوب عبد كعنتر % % فإن ذكروا بالبأس لا يذكروا عبسا % % 26(@)(@@) % وقد طاب ريانا على طبرية % % فيا طيبها مغنى ويا حسنها مرسى % % 27(@)(@@) % وعكا وما عكا فقد كان فتحها % % لإجلائهم عن مدن ساحلهم كنسا % % 28(@)(@@) % وصيدا وبيروت وتبنين كلها % % بسيفك ألفى أنفه الرغم والتعسا % % 29(@)(@@) % ويافا وأرسوف وتبنى وغزة % % تخذت بها بين الطلى والظبى عرسا % % 30(@)(@@) % وفي عسقلان الكفر ذل بملككم % % فمنظره بل أمره اربد وارجسا % % PageV01P201 31(@)(@@) % وصار بصور عصبة يرقبونكم % % فلا تبطئوا عنها وحسوهم حسا % % 32(@)(@@) % توكل على الله الذي لك أصبحت % % كلاءته درعا وعصمته ترسا % % 33(@)(@@) % ودمر على الباقين واجتث أصلهم % % فإنك قد صيرت دينارهم فلسا % % 34(@)(@@) % ولا تنس شرك الشرق غربك مرويا % % بماء الطلى من صاديات الظبى الخمسا % % 35(@)(@@) % وإن بلاد الشرق مظلمة 
ms51	 فخذ % % خراسان والنهرين والترك والفرسا % % 36(@)(@@) % وبعد الفرنج الكرك فاقصد بلادهم % % بعزمك واملأ من دمائهم الرمسا % % 37(@)(@@) % أقامت بغاب الساحلين جنودكم % % وقد طردت عنه ذئابهم الطلسا % % 38(@)(@@) % سحبت على الأردن ردنا من القنا % % ردينية ملدا وخطية ملسا % % 39(@)(@@) % حططت على حطين قدر ملوكهم % % ولم تبق من أجناس كفرهم جنسا % % 40(@)(@@) % ونعم مجال الخيل حطين لم تكن % % معاركها للجرد ضرسا ولا دهسا % % PageV01P202 41(@)(@@) % غداة أسود الحرب معتقلوا القنا % % أساود تبغي من نحور العدا نهسا % % 42(@)(@@) % أتوا شكس الأخلاق خشنا فلينت % % حدود الرقاق الخشن أخلاقها الشكسا % % 43(@)(@@) % طردتهم في الملتقى وعكستهم % % مجيدا بحكم العزم طردك والعكسا % % 44(@)(@@) % فكيف مكست المشركين رؤوسهم % % ودأبك في الإحسان أن تطلق المكسا % % 45(@)(@@) % كسرتهم إذ صح عزمك فيهم % % ونكستهم إذ صار سهمهم نكسا % % 46(@)(@@) % بواقعة رجت بها الأرض جيشهم % % دمارا كما بست جبالهم بسا % % 47(@)(@@) % بطون ذئاب الأرض صارت قبورهم % % ولم ترض أرض أن تكون لهم رمسا % % 48(@)(@@) % وطارت على نار المواضي فراشهم % % صلاء فزادت من خمودهم قبسا % % 49(@)(@@) % وقد خشعت أصوات أبطالها فما % % يعي السمع إلا من صليل الظبى همسا % % 50(@)(@@) % تقاد بدأ ماء الدماء ملوكهم % % أسارى كسفن اليم نطت بها القلسا % % PageV01P203 51(@)(@@) % سبايا بلاد الله مملوءة بها % % وقد شريت بخسا وقد عرضت نخسا % % 52(@)(@@) % يطاف بها الأسواق لا راغب لها % % لكثرتها كم كثرة توجب الوكسا % % 53(@)(@@) % شكا يبسا رأس البرنس الذي به % % تندى حسام حاسم ذلك اليبسا % % 54(@)(@@) % حسا دمه ماضي الغرار لقدره % % وما كان لولا غدره دمه يحسى % % 55(@)(@@) % فلله ما أهدى فتكت به % % وأطهر سيفا معدما رجسه النجسا % % 56(@)(@@) % نسفت به رأس البرنس بضربة % % فاشبه رأسي رأسه العهن والبرسا % % 57(@)(@@) % تبوغ في أوداجه دم بغيه % % فصال عليه السيف يلحسه لحسا % % 58(@)(@@) % وليس لقلبي في السرور تصرف % % فقلبي على الأحزان وقف محبس % % 59(@)(@@) % لفتك محبيه تيقظ طرفه % % وتحسبه من سقم عينيه ينعس % % 60(@)(@@) % له ناظر عند الخلاف مناظر % % يقول دليل الدل عندي أقيس % % PageV01P204 61(@)(@@) % إذا درست ألحاظه السحر أصبحت % % رسوم اصطباري درسا حين تدرس 
ms52	 % % 62(@)(@@) % ولم أنس أنسي بالحمى رعى الحمى % % عشية لي مجنى ومجلى ومجلس % % 63(@)(@@) % لحى الله أبناء الزمان فكلهم % % صحيفته أودى بها المتلمس % % 64(@)(@@) % ولولا ابتسامات المظفر بالندى % % لما راق نفسي صبحه المتنفس % % 65(@)(@@) % جلت شمس لقياه الحنادس بعدما % % عرتنا وهل يبقى مع الشمس حندس % % 66(@)(@@) % وصار به هذا الزمان جميعه % % نهارا فما للناس ليل معسعس % % 67(@)(@@) % إذا صال فالمغلول ألف مدرع % % وإن جاد فالمبذول ألف مكيس % % 68(@)(@@) % وليس بمغبون على فضل رأيه % % ويغبن في الأموال منه ويبخس % % 69(@)(@@) % إذا أطلق الملك المظفر في الوغى % % أعنته فالشمس بالنقع تحبس % % 70(@)(@@) % فداك ملوك لا يلبون داعيا % % وكلهم عن دعوة الحق يخنس % % PageV01P205 71(@)(@@) % تشكى إليك الغرب جور ملوكه % % فأشكيته والجور بالعدل يعكس % % 72(@)(@@) % سيهدي إلى المهدية النصر والهدى % % بهديكم فيها وتونس تؤنس % % 73(@)(@@) % رددت كراديس الفرنج وكلهم % % لدى الأسر في غل الصغار مكردس % % 74(@)(@@) % وبيضت وجه الدين يوم لقيتهم % % وأبيضكم من أسود القصر أشوس % % 75(@)(@@) % أفاد دم الأنجاس طهر سيوفكم % % وما يستفاد الطهر لولا التنجس % % 76(@)(@@) % شموس ظبى تغدو لها الهام سجدا % % فلله نصرانية تتمجس % % 77(@)(@@) % وكم كفي الإسلام سوءا بملككم % % كفيتم على رغم المعادين كل سو % % 78(@)(@@) % ولا يفتح البيت المقدس غيركم % % وبيتكم من كل عاب مقدس % % 79(@)(@@) % لهم كل يوم في جهاد مثلث % % إذا نصروا التوحيد فيء مخمس % % 80(@)(@@) % إذا ما تقي الدين صال تساقطت % % لأقدامه من عصبة الشرك أرؤس % % PageV01P206 81(@)(@@) % وما عمر إلا شبيه سميه % % شديد على الأعداء ثبت عمرس % % PageV01P207 البحر : طويل 1(@)(@@) % يؤمل المملوك مملوكه % % تبدل الوحشة بالأنس % % 2(@)(@@) % تخرجه من ليل وسواسه % % بطلعة تشرق كالشمس % % 3(@)(@@) % فوحدة الغربة قد حركت % % سواكن البلبال والمس % % 4(@)(@@) % فلا تدع يهدم شيطانه % % ما أحكم التقوى من الأس % % 5(@)(@@) % فوقع اليوم بمطلوبه % % مما سبى الأسطول بالأمس % % 6(@)(@@) % لا زلت وهابا لما حازه % % سيفك من حور ومن لعس % % 7(@)(@@) % وإنني آمل من بعدها % % كرائم السبي من القدس % % PageV01P208 البحر : دو بيت 1(@)(@@) % هبت سحرا فنبهت وسواسي % % نشوى خطرت عليلة الأنفاس % % 2(@)(@@) % أهدت أرج الرجاء بعد 
ms53	 اليأس % % ما أطيب بعد وحشتي إيناسي % % PageV01P209 البحر : سريع 1(@)(@@) % اقنع ولا تطمع فإن الفتى % % كما له في عزة النفس % % 2(@)(@@) % وإنما ينقص بدر الدجى % % لأخذه الضوء من الشمس % % PageV01P210 البحر : رمل تام 1(@)(@@) % اسم من قد ركب الأبلق % % كي يتعدى ظاهر في فرسه % % 2(@)(@@) % وهو قلب القلب أبغى قلبه % % فأنا من أجل ذا في هوسه % % 3(@)(@@) % ومتى أسكن في جنته % % مستمدا ريحها من نفسه % % PageV01P211 البحر : متقارب تام 1(@)(@@) % سواك لسهم العلى لن يريشا % % فنسأل رب العلى أن تعيشا % % 2(@)(@@) % من الناس بالبر صدت الكرام % % وبالبأس في البر صدت الوحوشا % % 3(@)(@@) % وكم سرت من مصر نحو العريش % % فهدمت للمشركين العروشا % % 4(@)(@@) % سراياك تبعث قدامها % % من الرعب نحو الأعادي جيوشا % % 5(@)(@@) % ويوم حماة تركت العداة % % كما طيرت بالفلا الريح ريشا % % PageV01P212 البحر : خفيف تام 1(@)(@@) % أسأل الله ذا العلى أن تعيشا % % ألف عام لنصره مستجيشا % % 2(@)(@@) % رعبكم يقلع القلاع ويضحي الوعن % % عنها من بأسكم منفوشا % % 3(@)(@@) % ما أكدي شيئا سوى فروة منك % % وأبغي لسفرتي إكديشا % % 4(@)(@@) % كيف يخلو من دف ظهر وظهر % % سالك طرق أيلة والعريشا % % PageV01P213 البحر : مجزوء الرجز 1(@)(@@) % نفسي فداء شادن % % كان على الدل نشا % % 2(@)(@@) % وافى نزيف قهوة % % يحملها مرتعشا % % 3(@)(@@) % وخده من أثر السلثم % % كأن قد خدشا % % 4(@)(@@) % وكاد يمحو لثمه % % عذاره المنقشا % % 5(@)(@@) % كأنما وجنته % % ورد بطل رششا % % 6(@)(@@) % رأيته فكدت من % % عجبي به أن أدهشا % % 7(@)(@@) % همت أحيانا به % % لولا التقى أن أبطشا % % PageV01P214 البحر : مجزوء الكامل 1(@)(@@) % يا حبذا مصر وبركتها % % وصدر والعريش % % 2(@)(@@) % فهناك أملاكي الذين % % سمت بعزهم العروش % % PageV01P215 البحر : خفيف تام 1(@)(@@) % أصبحت بغلتي تشكى من العري % % وأسراجها بلا كنبوش % % 2(@)(@@) % قلت كفي فخير يومك عندي % % أن تفوزي بالتبن أو بالحشيش % % 3(@)(@@) % وافرحي ليلة الشعير كما يفرح % % قوم بليلة الماشوش % % 4(@)(@@) % لو تبصرت حالتي لتصبرت % % فإياك عندها أن تطيشي % % 5(@)(@@) % أو ما مات في الشتاء من البرد % % ومن فرط جوعه إكديشي % % 6(@)(@@) % فثقي واسكني بجود صلاح الدين % % غرس الملوك ملك الجيوش % % 7(@)(@@) % فهو يجلوك للعيون بكنبوش 
ms54	 % % جديد مستحسن منقوش % % 8(@)(@@) % كم عدو من بأسه في عثار % % وولي بجوده منعوش % % 9(@)(@@) % والموالي على الأسرة والأعداء % % تحت الهوان فوق النعوش % % PageV01P216 البحر : متقارب تام 1(@)(@@) % كتابي فديتك من مرعش % % وخوف نوائبها مرعشي % % 2(@)(@@) % وما مر في طرقها مبصر % % صحيح النواظر إلا عشي % % 3(@)(@@) % وما حل في أرضها آمن % % من الضيم والضر إلا خشي % % 4(@)(@@) % ترنحني نشوات الغرام % % كأني من كأسه منتشي % % 5(@)(@@) % أبيت ونار الأسى مضجعي % % وأمسي وجمر الغضا مفرشي % % 6(@)(@@) % وأصبح ولهان وجدا بكم % % كأني مصاب عليه غشي % % 7(@)(@@) % أسر وأعلن برح الجوى % % فقلبي يسر ودمعي يشي % % 8(@)(@@) % وليلي من طول ما أشتكي % % كليل اللديغ من الحربش % % 9(@)(@@) % وليس سوى ذكركم مؤنسي % % ولكن بعدكم موحشي % % 10(@)(@@) % بدلت لكم مهجتي رشوة % % فحاكم حبكم مرتش % % PageV01P217 11(@)(@@) % وكيف إلى وصلكم أهتدي % % وخطب فراقكم مدهشي % % 12(@)(@@) % وكيف يلذ الكرى مغرم % % بنار الغرام حشاه حشي % % 13(@)(@@) % بمرعش أبغي وبلوطها % % مضاهاة جلق والمشمش % % 14(@)(@@) % وبالملك العادل استأنست % % نجاحا منى كل مستوحش % % 15(@)(@@) % وما في الأنام كريم سواه % % فإن كنت تنكرني فتش % % PageV01P218 البحر : خفيف تام 1(@)(@@) % يا لحى الله ليلة قرصتني % % في دياجيرها البراغيث قرصا % % 2(@)(@@) % شربت بقها دمي فتغنت % % وبراغيثها تواجدن رقصا % % 3(@)(@@) % قد تعريت من ثيابي لكربي % % غير أني لبست منهن قمصا % % 4(@)(@@) % كلما ازددت منعهن بحرص % % عن فراشي شرهن فازددن حرصا % % 5(@)(@@) % من براغيث خلتها طافرات % % طائرات جناحها قد حصا % % 6(@)(@@) % عرضت جيشها الفريقان حولي % % وهي أوفى من أن تعد وتحصى % % 7(@)(@@) % لو غزا سنجر بها الغز يوما % % لم يدع منهم على الأرض شخصا % % PageV01P219 البحر : بسيط تام 1(@)(@@) % أطاع دمعي وصبري في الغرام عصى % % والقلب جرع من كأس الهوى غصصا % % 2(@)(@@) % وإن صفو حياتي ما يكدره % % إلا اشتياقي إلى أحبابي الخلصا % % 3(@)(@@) % ما أطيب العيش بالأحباب لو وصلوا % % وأسعد القلب من بلواه لو خللصا % % 4(@)(@@) % زموا فؤادي وصبري والكرى معهم % % غداة بانوا وزموا للنوى القلصا % % 5(@)(@@) % وقفت أتبعهم قلبي يسايرهم % % وأرسل الدمع في آثارهم قصصا % % 6(@)(@@) % ومقلة طالما قرت برؤيتهم % % أضحى السهاد 
ms55	 لها من بعدهم رمصا % % 7(@)(@@) % لم تحدر الدمع إلا أنها رفعت % % إلى الأحبة من كرب الهوى قصصا % % 8(@)(@@) % رخصت بعد غلائي في محبتكم % % ورب غال عزيز هان إذ رخصا % % 9(@)(@@) % أرى أماني منكم غير صادقة % % كذا حديث المنى ما زال مخترصا % % 10(@)(@@) % يا هل تعود ظلال العيش سابغة % % وكيف يرجع عيش ظله قلصا % % PageV01P220 11(@)(@@) % وحبذا فرص للدهر ممكنة % % والدهر من لم تزل أوقاته فرصا % % 12(@)(@@) % لهفي على عنفوان العمر كيف مضى % % عني وشيكا ولما تم لي نقصا % % 13(@)(@@) % ما كنت أعلم ريعان الصبا حلما % % إذا انقضى أصبحت لذاته نغصا % % 14(@)(@@) % أيام أخلع في اللهو العذار كما % % أهوى وألبس من أطرابه قمصا % % 15(@)(@@) % أيام لا رشئي يعتاده ملل % % ولا رشاء الصبا من قبضتي ملصا % % 16(@)(@@) % إذ الليالي بما أهوى مساعفتي % % تدني إلى النجح آمالا إلي قصى % % 17(@)(@@) % أروح ذا مرح بالوصل مبتهجا % % أناله سؤله من دهره الحصصا % % 18(@)(@@) % أطاعت الغانيات الغيد منه فتى % % إذا لحى في هواهن العذول عصى % % 19(@)(@@) % ما بالهن زهدن اليوم فيه وقد % % أفاده الشيب تجريبا وثقل حصى % % 20(@)(@@) % كرهن بعد سواد شيب لمته % % لما رأين بياضا خلنه برصا % % PageV01P221 21(@)(@@) % بمهجتي رشأ قلبي له قنص % % فيا له رشأ للأسد مقنتصا % % 22(@)(@@) % تمضي عزائمه في قتل عاشقه % % عمدا ويطلب في تعذيبه الرخصا % % 23(@)(@@) % يا لائما بشباك العذل يقنصني % % ولست إلا لأشراك الهوى قنصا % % 24(@)(@@) % بغيت راحة من تعتاص سلوته % % وأتعب الناس من يبغي الذي عوصا % % 25(@)(@@) % لا تحرصن على ما أنت طالبه % % فربما حرم المطلوب من حرصا % % 26(@)(@@) % تبغي بقرع عصا التقريع لي رشدا % % كما ينبأ ذو حلم بقرع عصا % % 27(@)(@@) % أقصر فلي شعف بالمجد طال له % % باعي وطرف حسودي دونه بخصا % % 28(@)(@@) % وأنصف الدهر كان الفضل في دعة % % منه وعائر حظ الفضل منتعصا % % 29(@)(@@) % ربى الزمان بنيه شر تربية % % فالجهل ذو بطنة والفضل قد خمصا % % 30(@)(@@) % ولا زمان الإمام المستضيئ لنا % % لما امتحى ذنب أيامي ولا محصا % % PageV01P222 31(@)(@@) % من ألزم الله كل الخلق طاعته % % مخوفا منه عصيانا وشق 
ms56	 عصا % % 32(@)(@@) % من لا خمائل لولا سحبه هطلت % % ولا مخايل لولا برقه وبصا % % 33(@)(@@) % قد عاش في العزة القعساء حامده % % ومات جاحده من ذلة قعصا % % 34(@)(@@) % مولى لراحة أهل الأرض راحته % % وكم يفرج عنا الحادث اللحصا % % 35(@)(@@) % بالجود للمعتفي حلو الجنى سلسا % % بالبأس للمعتدي مر الإبا عفصا % % 36(@)(@@) % يا سيد الخلفاء الأوصياء ومن % % نبت المنى منه في روض النجاح وصى % % 37(@)(@@) % يا محكا كل نظم للزمان وهي % % وجابرا كل عظم للمنى وهصا % % 38(@)(@@) % بالحق إن دانت الدنيا له ودنا % % سحاب معروفه الهامي إذا نشصا % % 39(@)(@@) % أنمت عدلا عيون العالمين بما % % أذهبت عنها القذى والرين والغمصا % % 40(@)(@@) % عدوكم واقع في الرعب طائره % % حتى لقد حسب الدنيا له قفصا % % PageV01P223 41(@)(@@) % وحسب كل حسود أن ناظره % % إلى مهالكه من حيرة شخصا % % 42(@)(@@) % يا خير من حج وفد الله كعبته % % على المطي الذي في سيره قمصا % % 43(@)(@@) % وما توجه ذو عزم إلى أمل % % إلالدى بابه عن حجه فحصا % % 44(@)(@@) % سأجتدي وابلا من جوده غدقا % % وأمتري حافلا من خلفه لخصا % % 45(@)(@@) % وإن عندي ذا التوحيد من شكر النعمى % % لديك وذا الإشراك من غمصا % % 46(@)(@@) % من ذا الذي سار سيري في ولائكم % % غداة قال العدا لا سير عند عصا % % 47(@)(@@) % بعثي على الحق أصفى مصر من رنق % % به وأخرس منها باطلا نبصا % % 48(@)(@@) % ونال عبدك محمود بها ظفرا % % ما زال يرقبه من قبل مرتبصا % % 49(@)(@@) % كلب الفرنج عوى من خوف صولته % % وقيصر الروم من إقدامه معصا % % 50(@)(@@) % سطا فكم فقرة للكفر قد وقمت % % وكم وكم عيق للشرك قد وقصا % % PageV01P224 51(@)(@@) % من خوف سطوته أن العدو إذا % % أم الثغور على أعقابه نكصا % % 52(@)(@@) % ورب معترك رحب الفضاء به % % أضحى على مسعريه ضيقا لقصا % % 53(@)(@@) % لما انتشى الهام من كأس النجيع به % % غنى المهند والخطي قد رقصا % % 54(@)(@@) % وللكماة على أهوالها نهم % % نام كأن بها نحو الردى لعصا % % 55(@)(@@) % وللحرب عضت بأنياب لها عصل % % والصف أحكم من أضراسها لصصا % % 56(@)(@@) % والبيض فيه بقد البيض ماضية % % والسمر تخترق الماذية 
ms57	 الدلصا % % 57(@)(@@) % وكل نفس مشيح رهن ما كسبت % % والسامري رهين بالذي قبصا % % 58(@)(@@) % ومن دماء مساعير الهياج نرى % % على سوابغها من نضحها نفصا % % 59(@)(@@) % أعاد عبدك نور الدين منتصرا % % ما كان يغلو من الأرواح مرتخصا % % 60(@)(@@) % وكم أخاف العدا بالأولياء كما % % أخافت الأسد في إصحارها النحصا % % PageV01P225 61(@)(@@) % والمبطلون متى طالت رقابهم % % أبدى من الهون في أعناقها الوقصا % % 62(@)(@@) % أعدى نداك أمير المؤمنين على % % حظ تعدى ودهر ريبه قرصا % % 63(@)(@@) % نعشت فضلي بافضال حللت به % % من عقده ما لواه الحظ أو عقصا % % 64(@)(@@) % تمل مدح ولي فخر ناظمه % % أن القريض إلى تقريظكم خلصا % % 65(@)(@@) % لا يصدق الشعر إلا حين أمدحكم % % وكل مدح سوى مدحيكم خرصا % % 66(@)(@@) % وكيف أحصي بنطقي فضل منتسب % % إلى الذي في يديه نطق كل حصى % % PageV01P226 البحر : كامل تام 1(@)(@@) % أقسمت لا جزت الكمال مودة % % إن الذي جاز الكمال لناقص % % 2(@)(@@) % أختصه بالود من دون الورى % % فله عليهم ميزة وخصائص % % 3(@)(@@) % صدقت عقيدته وعقدة صدقه % % لما تحل وسره لي خالص % % 4(@)(@@) % عز الصديق فإن قنصت صداقة % % صنها فإن الأصدقاء قنائص % % 5(@)(@@) % تفديك أشخاص وجوه ودادهم % % سفرت وأحداق الحقود شواخص % % 6(@)(@@) % هجرت في ظل السكون إليهم % % في الحادثات وكل ظل قالص % % 7(@)(@@) % أقرضتهم حسنى فجازوني بها % % سوأى وكل قارض أو قارص % % 8(@)(@@) % كالماء بان الظل معكوسا به % % فبدت مكان الروس منه أخامص % % 9(@)(@@) % قل للثعالب لا تغرك خلوة % % في الغاب لما غاب عنه فرافص % % 10(@)(@@) % سيعود في طلب الفرائس ضيغم % % ذو سطوة وستقشعر فرائص % % PageV01P227 11(@)(@@) % كل لعقد يمينه لي ناكث % % كل على عقب المودة ناكص % % 12(@)(@@) % ولهم عقائد ملؤهن حقائد % % عقد النفاق كأنهم عقائص % % 13(@)(@@) % فرع المعيب الأصل يحكي أصله % % وله معايب مثله ونقائص % % 14(@)(@@) % جهم محياه خبيث عرضه % % لؤما وعارصه جهام ناشص % % 15(@)(@@) % أنت الذي أنجدتني بنصيحة % % إذ صرف دهري عارق لي واهص % % 16(@)(@@) % ما خبت حين فحصت عن مكنونه % % ظنا ألا إن الصديق لفاحص % % 17(@)(@@) % وأفاض لي سجلا رشاء وفائه % % كرما وأرشية الجميع موالص % % 18(@)(@@) % كم غصت حتى 
ms58	 حزت ودك أبحرا % % ولربما حاز اليتمية غائص % % 19(@)(@@) % سأزم نحوك للقاء قلائصا % % يا خير من زمت إليه قلائص % % PageV01P228 البحر : كامل تام 1(@)(@@) % هل عائد زمن الوصال المنقضي % % أم عائد لي في الصباية ممرضي % % 2(@)(@@) % لا أشتكي إلا الغرام فإنه % % بلوى علي من السماء بها قضي % % 3(@)(@@) % لا لاح حالي في الهوى مشهورة % % حاولت تسليتي وأنت محرضي % % 4(@)(@@) % خفض عليك فما الملام بناجع % % فيمن يقول لكل لاح خفض % % 5(@)(@@) % كان التعرض لي بنصحك نافعي % % لو كان يمكن للسلو تعرضي % % 6(@)(@@) % عرضت وجدي للسلو ومتعب % % كتمان سر للوشاة معرض % % 7(@)(@@) % أنفقت ذخر الصبر من كلفي فهل % % من واهب للصبر أو من مقرض % % 8(@)(@@) % أيبل مضنى قلبه متهدف % % لسهام رام للواحظ منبض % % 9(@)(@@) % شغفي بأغيد مقبل بوداده % % لمحبه ويصد صد المعرض % % 10(@)(@@) % شكواي من دل يزيد محبب % % وضناي من صد يدوم مبغض % % PageV01P229 11(@)(@@) % يا حبذا ماء العذيب وحبذا % % بنطافه الغزر العذاب تمضمضي % % 12(@)(@@) % لهفي على زمن الشباب فإنني % % بسوى التأسف عنه لم أتعوض % % 13(@)(@@) % نفضت عهود الغانيات وإنها % % لولا انقضاء شيبتي لم تنقض % % 14(@)(@@) % كان الصبا أضفى الثياب وإنما % % ذهبت نضارة عيشتي لما نضي % % 15(@)(@@) % يا حسن أيام الصبا وكأنها % % أيام مولانا الإمام المستضي % % 16(@)(@@) % ذو البهجة الزهراء يشرق نورها % % والطلعة الغراء والوجه الوضي % % 17(@)(@@) % قسم السعادة والشقاوة ربنا % % في الخلق بين محبه والمبغض % % 18(@)(@@) % أضفى ظلال العدل بعد تقلص % % وبنى أساس العدل بعد تقوض % % 19(@)(@@) % فضل الخلائف والخلائق بالتقى % % والفضل والإفضال والخلق الرضي % % 20(@)(@@) % فانعم أمير المؤمنين بدولة % % ما تنتهي وسعادة ما تنقضي % % PageV01P230 البحر : طويل 1(@)(@@) % لقد بسط الإحسان والعدل في الأرض % % إمام بحكم الله في خلقه يقضي % % 2(@)(@@) % أفاد المنايا والمنى فوليه % % غدا للمنى يقضي وحاسده يقضي % % 3(@)(@@) % مهيب يغض الطرف دون لقائه % % يغض حياء وهو في الحق لا يغضي % % 4(@)(@@) % أفي يوسف المستنجد الله قوله % % كذلك مكنا ليوسف في الأرض % % 5(@)(@@) % ألا إن أمرا ليس يبرم باسمه % % فإبرامه يفضي سريعا إلى النقض % % 6(@)(@@) % وختم دوام الملك فيه فللتقى % % على ملكه 
ms59	 ختم يجل عن الفض % % 7(@)(@@) % لسيب وسيف كفه حالتي ندى % % وبأس فما تخلو من البسط والقبض % % 8(@)(@@) % صرائمه في الحادثات صوارم % % إذا نبت الآراء عن كشفها تمضي % % 9(@)(@@) % بحزم لأسرار المقادير مقتض % % وعزم لأبكار الحوادث مفتض % % 10(@)(@@) % إمام له ما يسخط الله مسخط % % وما غير ما يرضي الإله له مرض % % PageV01P231 11(@)(@@) % لك النور موصولا بنور محمد % % أضاءت به الأنساب عن شرف محض % % 12(@)(@@) % وظلك في شرق البلاد وغربها % % مديد على طول البسيطة والعرض % % 13(@)(@@) % أنمت عباد الله أمنا فلم تدع % % عيون العدى رعبا تكحل بالغمض % % 14(@)(@@) % فعهد الأعادي قالص الظل منقض % % ونجم الموالي طالع غير منقض % % 15(@)(@@) % لقد فرضت منك النوافل شكرها % % على الناس حتى قابلوا النفل بالغرض % % 16(@)(@@) % وما الفرق بين الرشد والغي في الورى % % سوى حبكم في طاعة الله والبغض % % 17(@)(@@) % رفعت منار الدين عدلا فأهله % % من العز في رفع وبالعيش في خفض % % 18(@)(@@) % بخيل كمثل العارض السح كثرة % % تضيق صدور البيد عنها لدى العرض % % 19(@)(@@) % معودة خوض النجيع من العدى % % إذا انتجعته ألسن السمر بالوخض % % 20(@)(@@) % إذا حفيت منها النعال تنعلت % % بهام عدي رضت بها أيما رض % % PageV01P232 21(@)(@@) % حوافر خيل ودت الصيد أنها % % تكحل منها بالغبار لدى النفض % % 22(@)(@@) % عوارضكم نابت عن العارض الروي % % وآراؤكم أغنت عن الجحفل العرض % % 23(@)(@@) % عدوك مرفوض بمجهل حيرة % % لقى كل سيل من عقابك مرفض % % 24(@)(@@) % عقابك أوهاه فأصبح ناكصا % % على عقبيه ماله منة النكض % % 25(@)(@@) % لشانئكم قلب من الرعب خافق % % ومن وهج الحمى ترى سرعة النبض % % 26(@)(@@) % وما صدقت إلا بوارق عدلكم % % أوان بروق الظلم صادقة الومض % % 27(@)(@@) % ويحيا ليحيى كل حق قضى وهل % % قضى غيركم ما كان للدين من قرض % % 28(@)(@@) % وزير بأعباء الممالك ناهض % % إذا عجزت شم الرواسي عن النهض % % 29(@)(@@) % مشتت شمل للهى غير منفض % % وجامع شمل للعلى غير منفض % % 30(@)(@@) % وعزم كحد الصارم السيف منتضى % % نضوت به ثوب الغبار الذي ينضي % % PageV01P233 31(@)(@@) % رجوت أمير المؤمنين رجاء من % % إلى كل مقصود به قصده يفضي % % 32(@)(@@) % وأشكو إليه نائبات 
ms60	 نيوبها % % نوابت في عظمي ثوابت في نحضي % % 33(@)(@@) % ومنكرة إن عضني ناب نائب % % أما عرفت عودي صليبا على العض % % 34(@)(@@) % تحض على نشدان حظ فقدته % % إذا الحظ لم ينفع فلا نفع في الحض % % 35(@)(@@) % يكلفها حب السلامة أنها % % تكلفني حب القناعة والغض % % 36(@)(@@) % لقد صدقت إن القناعة والتقى % % لأصون في الحالين للدين والعرض % % 37(@)(@@) % تقول إلام السعي في الرزق راكضا % % ورزقك محتوم وعمرك في ركض % % 38(@)(@@) % ولو كانت الأرزاق بالسعي لم يكن % % غنى العز معقولا ولا فاقة العض % % 39(@)(@@) % إن كان هذا البحر جما نميره % % ففيم اقتناعي عنه بالوشل البرض % % 40(@)(@@) % كفى شرفا في عصر يوسف أنني % % لبست جديد العز في الزمن الغض % % PageV01P234 41(@)(@@) % لساني وقلبي في ولائك والثنا % % عليك فها بعضي يغار من البعض % % 42(@)(@@) % لسودني تسويد مدحك في الورى % % فإضت بوجه من ولائك مبيض % % 43(@)(@@) % وما كل شعر مثل شعري فيكم % % ومن ذا يقيس البازل العود بالنقض % % 44(@)(@@) % وما عز حتى هان شعر ابن هانئ % % وللسنة الغراء عز على الرفض % % PageV01P235 البحر : بسيط تام 1(@)(@@) % مشط ومنشفة فيه حسدتهما % % دمعي لذا بهما فياض عارضه % % 2(@)(@@) % فتلك حاظية من مس أخمصه % % وذاك مستغرق في مسك عارضه % % PageV01P236 البحر : طويل 1(@)(@@) % أصح عيون الغانيات مريضها % % وافتك ألحافظ الحسان غضيضها % % 2(@)(@@) % تهز قدود السمر للفتك سحرها % % وتشهر من أجفانها البيض بيضها % % 3(@)(@@) % وقد طال فكري في خصور ضعيفة % % بأعباء ما في الأزر كيف نهوضها % % 4(@)(@@) % غرضن بشيبي والشبيبة إنما % % يغز الغريرات الحسان غريضها % % 5(@)(@@) % سوافر غر عن وجوه لحسنها % % معان على فهمي يدق غموضها % % 6(@)(@@) % نوافر مسود الشباب أليفها % % حبائب مبيض المشيب بغيضها % % 7(@)(@@) % عن المقتر البادي القتير نفارها % % وعند الفتى الحالي الثراء ربوضها % % 8(@)(@@) % كأن قلوب العاشقين بدينها % % رهون غرام ما تؤدى قروضها % % 9(@)(@@) % وقد غر في ميعادها وهو خلب % % كما غر من شيم البروق وميضها % % 10(@)(@@) % أجرني بصبر إن فيض مدامعي % % سيول هموم في فؤادي مغيضها % % PageV01P237 11(@)(@@) % وهل مطفئات أدمعي نار لوعة % % توقد في أرجاء قلبي مضيضها % % 12(@)(@@) % تكلفني نقض العهود 