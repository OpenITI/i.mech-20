ms3601	 / 32948(@)(@@) | 30 قال النبي : ( من صلى في يوم وليلة ثنتي عشرة ركعة سوى الفريضة بنى الله له بيتا في الجنة ) )(@)(@@) . ( حم ، طكس ، عن أبي موساى رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3924 / 32949(@)(@@) | 30 قال النبي : ( من صلى في يوم اثنتي عشرة ركعة حرم لحمه علاى النار ) )(@)(@@) . ( ع ، عن أنس رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3925 / 32950(@)(@@) | 30 قال النبي : ( من صلى صلاة الصبح في جماعة ثم مكث حتى يسبح سبحة الضحاى كان له كأجر حاج ومعتمر تام له حجته وعمرته ) )(@)(@@) . ( طك ، عن أبي أمامة وعتبة بن عبد رضي الله عنهما معا ) .(@)(@@)(@@)(@@) $ 3926 / 32951(@)(@@) | 30 قال النبي : ( من صلى الصبح ثم جلس بجلسة حتى مكنه PageV11P202 الصلاة كانت بمنزلة عمرة وحجة متقبلتين ) )(@)(@@) . ( طس ، عن ابن عمر رضي الله عنهما ) .(@)(@@)(@@)(@@) $ 3927 / 32952(@)(@@) | 30 قال النبي : ( من صلى الفجر أو قال : الغداة فقعد في مقعده فلم يلغ بشيء من أمر الدنيا ويذكر الله حتى يصلي الضحاى أربع ركعات خرج من ذنوبه كيوم ولدته أمه لا ذنب له ) )(@)(@@) . ( ع ، طس ، عن عائشة رضي الله عنها ) .(@)(@@)(@@)(@@) $ 3928 / 32953(@)(@@) | 30 قال النبي : ( من صلى صلاة الغداة في جماعة ثم جلس يذكر الله حتى تطلع الشمس ثم قام فصلى ركعتين انقلب بأجر حجة وعمرة ) )(@)(@@) . ( طك ، عن أبي أمامة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3929 / 32954(@)(@@) | 30 قال النبي : ( من صلى صلاة الفجر ثم قعد يذكر الله حتى تطلع الشمس وجبت له الجنة ) )(@)(@@) . ( ع ، عن معاذ بن أنس رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3930 / 32955(@)(@@) | 30 قال النبي : ( من صلى الغداة فأصيب من ذمته فقد استبيح حماى الله وأخفرت ذمته ، وأنا طالب بذمته ) )(@)(@@) . ( ع ، عن أنس رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3931 / 32956(@)(@@) | 30 قال النبي : ( من صلى بعد المغرب ست ركعات غفرت له ذنوبه وإن كانت مثل زبد البحر ) )(@)(@@) . ( طكسص ، عن عمار بن ياسر رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3932 / 32957(@)(@@) | 30 قال النبي : ( من صلى عليه مائة شفعوا في أحبتهم ، والأمة أربعون إلاى مائة ، والعصبة عشرة إلاى أربعين ، والنفر ثلاثة إلاى عشرة ) )(@)(@@) . ( طك ، عن أبي المليح رضي الله عنه 
ms3602	 ) .(@)(@@)(@@)(@@) $ 3933 / 32958(@)(@@) | 30 قال النبي : ( من صلى معنا صلاة الفجر بجمع ووقف معنا حتى نفيض منه وقد أفاض قبل ذالك من عرفات ليلا أو نهارا فقد تم حجه وقضاى تفثه ) )(@)(@@) . ( حم ، عن عروة بن مضرس بن حارثة بن لاءم رضي الله عنه ) .(@)(@@) PageV11P203(@)(@@)(@@)(@@) $ 3934 / 32959(@)(@@) | 30 قال النبي : ( من صلى صلاتنا واستقبل قبلتنا ، وأكل ذبيحتنا فذاك المسلم ، له ذمة الله وذمة رسول الله ) )(@)(@@) . ( طك ، عن جندب رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3935 / 32960(@)(@@) | 30 قال النبي : ( من صلى منكم بالليل فليجهر بقراءته ، فإن الملائكة تصلي بصلاته ، وتستمع لقراءته وإن مؤمني الجن يكونوا في الهواء وجيرانه معه في ستر الله يصلون بصلاته ويستمعون قراءته ، وإنه يطرد بجهره بقراءته عن داره وعن الدور التي حوله فساق الجن ومردة الشياطين ، وإن البيت الذي يقرأ فيه القرآن عليه خيمة من نور يهتداى بها كالغفر ( 1 ) ، فإذا مات صاحب القرآن رفعت تلك الخيمة ، فتنظر الملائكة من السماء فلا ينظرون ذالك النور ، فتلقاه ملك الملائكة من سماء إلاى سماء فتصلي الملائكة علاى روحه في الأرواح ثم يستقبل الملائكة الحافظين الذين كانوا معه ، ثم تستغفر له الملائكة إلاى يوم يبعث ، وما من رجل يعلم كتاب الله ثم صلى ساعة من الليل أوجبت به الليلة الماضية المستأنفة أن تثبته كساعة وأن تكون عليه خفيفة ، فإذا مات وكان أهله في جهازه وجاء القرآن في صورة حسنة حمله فوقف عند رأسه حتى يدرج في أكفانه ، فيكون القرآن علاى صدره دون الكفن ، فإذا وضع في قبره فيجيء القرآن حتى يكون بينه وبينهما فيقولان له : إليك حتى نسأله ، فيقول : لا ورب الكعبة إنه لصاحبي وخليلي ، ولست آخذ له علاى حال ، فإن كنتما أمرتما بشيء فامضيا إلاى ما أمرتما به ودعا مكاني ، فإني لست أفارقه حتى أدخله الجنة ، ثم ينظر القرآن إلاى صاحبه فيقول له : أنا القرآن الذي كنت تجهر بي وتجفيني وتحبني فأنا أحبك ، ومن أحببته أحبه الله ، وليس عليك بعد مسألة منكر ونكير هم ولا حزن ، فيسأله منكر ونكير ويصعدان ، ويبقاى هو والقرآن فيقول 
ms3603	 له : لافرشنك فراشا لينا ، ولادثرنك دثارا حسنا جميلا بما أسهرت ليلك وأنصبت نهارك ، قال : فيصعد القرآن إلاى السماء أسرع من الطرف فيسأل الله ذالك فيعطيه ذالك فينزل PageV11P204 به ألف ألف من مقرئي السماء السادسة فيجيء القرآن فيجيبه فيقول : هل استوحشت ؟ ما زدت منذ فارقتك أن كلمت الله حتى أحدث لك فراشا ودثارا ومفتاحا وقد جئتك به فقم حتى تفرشك الملائكة ، قال : فتنهضه الملائكة إنهاضا لطيفا ثم يفسح له في قبره مسيرة أربعمائة عام ثم يوضع علاى فراش بطائنه من حرير أخضر حشوه المسك الأذفر ، ويوضع له مرافق عند رجليه ورأسه من السندس والاستبرق ، ويسرج له سراجان من نور الجنة عند رأسه ورجليه مزهران إلاى يوم القيامة ، ثم تضجعه الملائكة علاى شقه الأيمن مستقبل القبلة ، ثم يؤتاى بياسمين الجنة وتصعد عنه ويبقاى هو والقرآن ، فيأخذ القرآن الياسمين فيضعه علاى أنفه غطاء فينشقه ، ويرجع القرآن إلاى أهله فيخبرهم كل يوم وليلة وتبعا هاذه كما تبعا هاذا الوالد الشفيق ولده بالخير ، فإن تعلم أحد من ولده القرآن بشره بذالك وإن كان عقبه سوء دعا لهم بالصلاح والإقبال ، أو كما ذكر ) )(@)(@@) . ( بز ، عن معاذ بن جبل رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3936 / 32961(@)(@@) | 30 قال النبي : ( من ضم يتيما من بين أبوين مسلمين إلاى طعامه وشرابه حتى يغنيه الله وجبت له الجنة ) )(@)(@@) . ( د ، حم ، طك ، عن عمرو بن مالك القشيري رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3937 / 32962(@)(@@) | 30 قال النبي : ( من ضمن لي ما بين لحييه ورجليه ضمنت له الجنة ) )(@)(@@) . ( طصس ، عن جابر رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3938 / 32963(@)(@@) | 30 قال النبي : ( من طاف أسبوعا بخمصته وصلى ركعتين كان له كعدل رقبة ) )(@)(@@) . ( حم ، عن ابن عمر رضي الله عنهما ) .(@)(@@)(@@)(@@) $ 3939 / 32964(@)(@@) | 30 قال النبي : ( من طاف بهاذا البيت أسبوعا وصلى خلف مقام إبراهيم ركعتين فهو عدل محرر ) )(@)(@@) . ( طك ، عن ابن عمرو رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3940 / 32965(@)(@@) | 30 قال النبي : ( من طلب محامد الناس بمعاصي الله عاد PageV11P205 حامده ذاما ) )(@)(@@) . ( طك ، عن عائشة رضي الله عنها ) .(@)(@@)(@@)(@@) $ 3941 / 32966(@)(@@) | 30 قال النبي 
ms3604	 : ( من ظلم شبرا من الأرض جاء يوم القيامة مطوقا من سبع أرضين في عنقه ) )(@)(@@) . ( طس ، عن أنس رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3942 / 32967(@)(@@) | 30 قال النبي : ( من ظلم شبرا من الأرض طوقه من سبع أرضين ، ومن قتل دون ماله فهو شهيد ) )(@)(@@) . ( طك ، عن شداد بن أوس رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3943 / 32968(@)(@@) | 30 قال النبي : ( من علم ابنه القرآن نظرا غفر الله له ما تقدم من ذنبه وما تأخر ، ومن علمه إياه ظاهرا بعثه الله تعالاى يوم القيامة علاى صورة القمر ليلة البدر ويقال لابنه : اقرأ ، فكلما قرأ آية رفع الله عز وجل للأب درجة ، حتى ينتهي إلاى آخر ما معه من القرآن ) )(@)(@@) . ( طس ، عن أنس رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3944 / 32969(@)(@@) | 30 قال النبي : ( من علم من أخيه سيئة فسترها ستر الله عليه يوم القيامة ) )(@)(@@) . ( طك ، عن مكحول رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3945 / 32970(@)(@@) | 30 قال النبي : ( من عمره الله تبارك وتعالاى أربعين سنة في الإسلام صرف الله عنه أنواعا من البلاء منها : الجذام ، والبرص ، وحنق الشيطان ، ومن عمره الله تعالاى خمسين سنة في الإسلام لين الله عليه الحساب ، وفي رواية : هون الله عليه الحساب يوم القيامة ، ومن عمره ستين سنة في الإسلام رزقه الله الإنابة إليه بما يحب ، ومن عمره سبعين سنة في الإسلام أحبه أهل السماء وأهل الأرض ، ومن عمره الله تعالاى ثمانين سنة في الإسلام محى الله سيئاته وكتب حسناته ، ومن عمره الله تسعين سنة في الإسلام غفر الله له ذنوبه وكان أسير الله في أرضه وشفيعا لأهل بيته يوم القيامة ) )(@)(@@) . ( بز ، عن أنس رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3946 / 32971(@)(@@) | 30 قال النبي : ( من غسل يوم الجمعة واغتسل ، واغتدا وابتكر ، ودنا فاستمع ونصت كان له كفلان من الأجر ) )(@)(@@) . ( طك ، عن أبي أمامة رضي الله عنه ) .(@)(@@) PageV11P206(@)(@@)(@@)(@@) $ 3947 / 32972(@)(@@) | 30 قال النبي : ( من غسل واغتسل ، ودنا وابتكر ، فاقترب واستمع كان له بكل خطوة يخطوها قيام سنة وصيامها ) )(@)(@@) . ( حم ، عن عبد الله بن عمرو رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3948 / 32973(@)(@@) | 30 قال النبي : ( من غسل 
ms3605	 ميتا وكفنه وتبعه وولي جنبه رجع مغفورا له ) )(@)(@@) . ( حم ، عن معاذ بن خديج رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3949 / 32974(@)(@@) | 30 قال النبي : ( من غسل ميتا فكتم عليه غفر له أربعون كبيرة ، ومن كفن ميتا كساه الله من سندس واستبرق الجنة ، ومن حفر لميت قبرا فأجنبه فيه أجري له من الأجر كأجر مسكن أسكنه إلاى يوم القيامة ) )(@)(@@) . ( طك ، عن أبي رافع رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3950 / 32975(@)(@@) | 30 قال النبي : ( من غش المسلمين فليس منهم ) )(@)(@@) . ( طك ، عن قيس بن أبي عروة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3951 / 32976(@)(@@) | 30 قال النبي : ( من فاته الغزو معي فليغز في البحر ) )(@)(@@) . ( طس ، عن واثلة بن الأسقع رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3952 / 32977(@)(@@) | 30 قال النبي : ( من فارق المسلمين قيد شبر فقد خلع ربقة الإسلام من عنقه ، ومن مات فليس عليه إمام فميتته ميتة جاهلية ، ومن مات تحت راية عصبية فقتلته قتلة جاهلية ) )(@)(@@) . ( طس ، عن ابن عباس رضي الله عنهما ) .(@)(@@)(@@)(@@) $ 3953 / 32978(@)(@@) | 30 قال النبي : ( من فارق الجماعة شبرا فقد فارق الإسلام ) )(@)(@@) . ( بز ، عن جبلة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3954 / 32979(@)(@@) | 30 قال النبي : ( من فرج عن مسلم كربة جعل الله له يوم القيامة شعبتين من نور علاى الصراط يستضيء بضوئهما عالم لا يحصيهم إلا رب PageV11P207 العزة ) )(@)(@@) . ( طس ، عن أبي هريرة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3955 / 32980(@)(@@) | 30 قال النبي : ( من فرج عن مؤمن كربة في الدنيا فرج الله عنه كربة من كرب يوم القيامة ، ومن ستر عورة مسلم ستر الله عورته يوم القيامة ، والله في حاجته ما كان العبد في حاجة أخيه ) )(@)(@@) . ( طك ، عن أبي هريرة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3956 / 32981(@)(@@) | 30 قال النبي : ( من فدا أسيرا من أيدي العدو فأنا ذالك الأسير ) )(@)(@@) . ( طص ، عن ابن عباس رضي الله عنهما ) .(@)(@@)(@@)(@@) $ 3957 / 32982(@)(@@) | 30 قال النبي : ( من قاتل تحت راية يقاتل عصبة أو ينصر عصبة فقتلته جاهلية ) )(@)(@@) . ( طس ، عن أنس رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3958 / 32983(@)(@@) | 30 قال النبي : ( من قال حين يتحرك من الليل : بسم الله عشر مرات ، وسبحان الله عشر مرات 
ms3606	 ، آمنت بالله وكفرت بالطاغوت عشرا كفي كل شيء يتخوفه ، ولم ينبغ لذنب أن يدركه إلاى مثلها ) )(@)(@@) . ( طس ، عن عبد الله بن عمر رضي الله عنهما ) .(@)(@@)(@@)(@@) $ 3959 / 32984(@)(@@) | 30 قال النبي : ( من قال حين تغيب الشمس : أعوذ بكلمات الله التامات من شر ما خلق ، لم يضره شيء في ليلته ) )(@)(@@) . ( طس ، عن أبي هريرة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3960 / 32985(@)(@@) | 30 قال النبي : ( من قال حين يصبح وحين يمسي : أعوذ بكلمات الله التامات من شر ما خلق ، لم يضره شيء ) )(@)(@@) . ( طس ، عن أبي هريرة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3961 / 32986(@)(@@) | 30 قال النبي : ( من قال دبر كل صلاة : سبحان الله وبحمده ، لا حول ولا قوة إلا بالله قام مغفورا له ) )(@)(@@) . ( بز ، عن أنس من رواية أبي الزهراء عن أنس رضي الله عنه ) .(@)(@@) PageV11P208(@)(@@)(@@)(@@) $ 3962 / 32987(@)(@@) | 30 قال النبي : ( من قال دبر كل صلاة : أستغفر الله وأتوب إليه ، غفر له وإن كان فر من الزحف ) )(@)(@@) . ( طصس ، عن البراء بن عازب رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3963 / 32988(@)(@@) | 30 قال النبي : ( من قال : لا إلاه إلا الله والله أكبر أعتق الله ربعه من النار ، ولا يقولها اثنتين إلا أعتق الله شطره من النار ، وإن قالها أربعا : أعتق الله شطره من النار ) )(@)(@@) . ( طكس ، عن أبي الدرداء رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3964 / 32989(@)(@@) | 30 قال النبي : ( من قال : اللهم إني أشهدك ، وأشهد ملائكتك ، وحملة عرشك ، والسماوات ومن فيهن ، والأرضين ومن فيهن ، وأشهد جميع خلقك بأنك أنت الله ، لا إلاه إلا أنت ، وأكفر من أبى ذالك من الأولين والآخرين وأشهد أن محمدا عبدك ورسولك عتق ثلثه من النار ، ومن قالها مرتين عتق ثلثاه من النار ، ومن قالها ثلاثا عتق من النار ) )(@)(@@) . ( طك ، عن سلمان الفارسي رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3965 / 32990(@)(@@) | 30 قال النبي : ( من قال قبل أن ينصرف ويثني رجليه من صلاة المغرب والصبح : لا إلاه إلا الله ، وحده لا شريك له ، له الملك وله الحمد ، يحيي ويميت وهو علاى كل شيء قدير عشر مرات كتب الله له بكل واحدة عشر حسنات ومحيت 
ms3607	 عنه عشر سيئات ، ورفع له عشر درجات ، وكانت حرزا من كل مكروه وحرزا من الشيطان الرجيم ، ولم يدركه الذنب إلا أن يدركه الشرك ، وكان من أفضل الناس عملا إلا رجلا يفضله يقول أفضل مما قال ) )(@)(@@) . ( حم ، عن عبد الرحمان بن غنم رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3966 / 32991(@)(@@) | 30 قال النبي : ( من قال مثل مقالته وشهد مثل شهادته فله الجنة ) )(@)(@@) . ( ع ، عن أنس رضي الله عنه ) .(@)(@@) PageV11P209(@)(@@)(@@)(@@) $ 3967 / 32992(@)(@@) | 30 قال النبي : ( من قال : سبحان الله وبحمده كتب له مائة ألف حسنة وأربعة وعشرون ألف حسنة ، ومن قال : لا إلاه إلا الله كان له بها عهد عند الله يوم القيامة ) )(@)(@@) . ( طك ، عن ابن عمر رضي الله عنهما ) .(@)(@@)(@@)(@@) $ 3968 / 32993(@)(@@) | 30 قال النبي : ( من قال : سبحان الله والحمد لله ، ولا إلاه إلا الله ، والله أكبر ، كتبت له بكل حرف عشر حسنات ، ومن أعان في خصومة باطل لم يزل في سخط الله تعالاى حتى يفرغ ، ومن حالت شفاعته دون حد من حدود الله فقد حاد الله في أمره ، ومن بهت مؤمنا أو مؤمنة حبسه الله تعالاى في ردغة الخبال يوم القيامة حتى يخرج مما قال وليس بخارج ) )(@)(@@) . ( طك ، عن ابن عمر رضي الله عنهما ) .(@)(@@)(@@)(@@) $ 3969 / 32994(@)(@@) | 30 قال النبي : ( من قال في دبر كل صلاة الغداة : لا إلاه إلا الله وحده لا شريك له ، له الملك وله الحمد ، يحيي ويميت ، بيده الخير وهو علاى كل شيء قدير مائة مرة قبل أن يثني رجليه كان يومئذ أفضل أهل الأرض عملا إلا من قال أو زاد علاى ما قال ) )(@)(@@) . ( طك ، عن أبي أمامة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3970 / 32995(@)(@@) | 30 قال النبي : ( من قال قبل صلاة الغداة يوم الجمعة ثلاث مرات : أستغفر الله العظيم الذي لا إلاه إلا هو الحي القيوم وأتوب إليه ، غفرت ذنوبه وإن كانت مثل زبد البحر ) )(@)(@@) . ( طس ، عن أنس رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3971 / 32996(@)(@@) | 30 قال النبي : ( من قال : الحمد لله قبل كل أحد ، والحمد لله بعد كل أحد ، والحمد لله علاى كل حال 
ms3608	 ، أعطي من الأجر كعبادة من عبد الله عز وجل ) )(@)(@@) . ( طس ، عن ابن عباس رضي الله عنهما ) .(@)(@@)(@@)(@@) $ 3972 / 32997(@)(@@) | 30 قال النبي : ( من قال : لا إلاه إلا الله ابتغاء وجه الله ختم له بها دخول الجنة ) )(@)(@@) . ( حم ، عن حذيفة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3973 / 32998(@)(@@) | 30 قال النبي : ( من قال لا إلاه إلا الله كتب له بها عهد عند الله ، ومن قال : سبحان الله وبحمده كتب له مائة ألف حسنة وأربعة وعشرون ألف PageV11P210 حسنة ، قيل إن هلك بعد هاذا ، قال : إن الرجل ليأتي يوم القيامة بالعمل الصالح لو وضع علاى جبل لأثقله ، فتقوم النعمة من نعم الله فتكاد تستنفد ذالك كله إلا أن يتطاول الله برحمته ونزلت : { هل أتاى علاى الإنسان حين من الدهر لم يكن شيئا مذكورا . . إلاى قوله : نعيما وملكا كبيرا ) )(@)(@@) . ( طك ، عن ابن عمر رضي الله عنهما ) .(@)(@@)(@@)(@@) $ 3974 / 32999(@)(@@) | 30 قال النبي : ( من قال : لا إلاه إلا الله كان له بها عهد عند الله ، ومن قال : سبحان الله كتب له بها مائة ألف حسنة ، قيل : كيف نهلك بعد هاذا ؟ قال : والذي نفسي بيده إن الرجل ليجيء يوم القيامة بعمل لو وضع علاى جبل لأثقله ، فتقوم النعم من نعم الله فتكاد تستنفد ذالك كله لولا ما يتفضل الله من رحمته ، ثم نزلت : { هل أتاى علاى الإنسان حين من الدهر لم يكن شيئا مذكورا . . . إلاى قوله : وإذا رأيت ثم رأيت نعيما وملكا كبيرا } ( 1 ) فقيل : هل تراى عيني في الجنة مثل ما تراى عينك ؟ فقال : نعم ) )(@)(@@) . ( طس ، عن ابن عمر رضي الله عنهما ) .(@)(@@)(@@)(@@) $ 3975 / 33000(@)(@@) | 30 قال النبي : ( من قال : سبحان الله وبحمده ، سبحانك اللهم وبحمدك ، أشهد أن لا إلاه إلا أنت أستغفرك وأتوب إليك ، فقالها في مجلس ذكر كان كالطبائع يطبع عليه ، ومن قالها في مجلس لغو كانت كفارة له ) )(@)(@@) . ( طك ، عن جبير بن مطعم رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3976 / 33001(@)(@@) | 30 قال النبي : ( من قال : لا إلاه إلا الله وحده لا شريك له ، كتب له كذا وكذا حسنة ) )(@)(@@) . ( طك ، عن 
ms3609	 أم سلمة رضي الله عنها ) .(@)(@@)(@@)(@@) $ 3977 / 33002(@)(@@) | 30 قال النبي : ( من قال : إني أشهدك وأشهد ملائكتك وحملة عرشك ، وأشهد من في الأرض أنك أنت الله لا إلاه إلا أنت وحدك لا شريك لك ، وأكفر من أباى ذالك من الأولين والآخرين ، وأشهد أن محمدا عبدك ورسولك ، PageV11P211 من قالها مرة أعتق الله ثلثه من النار ، ومن قالها مرتين أعتق الله ثلثيه من النار ، ومن قالها ثلاثا أعتق الله كله من النار ) )(@)(@@) . ( طك ، عن أبي هريرة عن سلمان رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3978 / 33003(@)(@@) | 30 قال النبي : ( من قال إذا أصبح : اللهم أنت ربي لا إلاه إلا أنت ، خلقتني وأنا عبدك ، وأنا علاى عهدك ووعدك ما استطعت ، أعوذ بك من شر ما صنعت ، أبوء لك بنعمتك علي وأبوء بذنبي فاغفر لي فإنه لا يغفر الذنوب إلا أنت ، فإن قالها نهارا فمات من يومه ذالك مات شهيدا ، وإن قالها ليلا فمات من ليلته تلك مات شهيدا ) )(@)(@@) . ( ع ، عن سلمان بن بريدة عن أبيه ) .(@)(@@)(@@)(@@) $ 3979 / 33004(@)(@@) | 30 قال النبي : ( من قال إذا أواى إلاى فراشه : الحمد لله الذي علا فقهر ، ونظر فجبر ، وملك فعدل ، الحمد لله الذي يحيي ويميت وهو علاى كل شيء قدير خرج من ذنوبه كيوم ولدته أمه ) )(@)(@@) . ( طس ، عن أبي الدرداء رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3980 / 33005(@)(@@) | 30 قال النبي : ( من قال إذا أصبح : سبحان الله وبحمده ألف مرة فقد اشتراى نفسه من الله وكان آخر يومه عتيق الله ) )(@)(@@) . ( طس ، عن ابن عباس رضي الله عنهما ) .(@)(@@)(@@)(@@) $ 3981 / 33006(@)(@@) | 30 قال النبي : ( من قال إذا أصبح : رضيت بالله ربا ، وبالإسلام دينا ، وبمحمد نبيا ، فأنا الزعيم لآخذن بيده حتى أدخله الجنة ) )(@)(@@) . ( طك ، عن المنذر صاحب رسول الله ) .(@)(@@)(@@)(@@) $ 3982 / 33007(@)(@@) | 30 قال النبي : ( من قال : اللهم رب السماوات والأرض عالم الغيب والشهادة إني أعهد إليك في هاذه الحياة الدنيا أني أشهد أن لا إلاه إلا أنت وحدك لا شريك لك وأن محمدا عبدك ورسولك ، فإنك إن تكلني إلاى نفسي تقربني من الشر وتباعدني من الخير ، وإني لن 
ms3610	 أثق إلا برحمتك فاجعل لي عندك عهدا توفنيه يوم القيامة إنك لا تخلف الميعاد ، إلا قال الله عز وجل يوم القيامة لملائكته : إن PageV11P212 عبدي عهد عندي عهدا فأوفوه إياه ، فأدخله الله عز وجل الجنة ) )(@)(@@) . ( حم ، عن ابن مسعود رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3983 / 33008(@)(@@) | 30 قال النبي : ( من قال إذا أصبح وإذا أمساى : اللهم أنت خلقتني وأنت تهديني ، وأنت تطعمني وأنت تسقيني ، وأنت تميتني وأنت تحييني لم يسأل الله شيئا إلا أعطاه إياه ) )(@)(@@) . ( طس ، عن سمرة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3984 / 33009(@)(@@) | 30 قال النبي : ( من قال : السلام عليكم كتب له عشر حسنات ، ومن قال : السلام عليكم ورحمة الله وبركاته كتبت له ثلاثون حسنة ) )(@)(@@) . ( طك ، عن سهل بن حنيف رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3985 / 33010(@)(@@) | 30 قال النبي : ( من قال : لا إلاه إلا الله قبل كل شيء ، ولا إلاه إلا الله بعد كل شيء ، ولا إلاه إلا الله تبقاى ويفنى كل شيء ، عوفي من الهم والحزن ) )(@)(@@) . ( طك ، عن ابن عباس رضي الله عنهما ) .(@)(@@)(@@)(@@) $ 3986 / 33011(@)(@@) | 30 قال النبي : ( من قال حين يصبح : لا إلاه إلا الله والله أكبر ، وسبحان الله وبحمده ، وأستغفر الله ولا حول ولا قوة إلا بالله هو ، الأول والآخر ، والظاهر والباطن ، وبيده الخير ، ويحي ويميت وهو علاى كل شيء قدير ، أعطي عشر خصال ، أما أولهن فيحرز من إبليس وجنوده ، وأما الثانية فيعطاى قنطارا من الأجر ، وأما الثالثة فيرفع له درجة في الجنة ، وأما الرابعة فيتزوج من الحور العين ، وأما الخامسة فيحضر تشييعه اثنا عشر ألفا من الملائكة ، وأما السادسة فله من الأجر كمن قرأ القرآن والتوراة والإنجيل والزبور ، وله مع هاذا كمن حج واعتمر فقبلت حجته وعمرته ، وإن مات من يومه طبع بطابع الشهداء ) )(@)(@@) . ( ع ، عن عثمان رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3987 / 33012(@)(@@) | 30 قال النبي : ( من قال حين يصبح : الحمد لله الذي تواضع كل شيء لعظمته كتبت له عشر حسنات ) )(@)(@@) . ( طك ، عن أم سلمة رضي الله عنها ) .(@)(@@) PageV11P213(@)(@@)(@@)(@@) $ 3988 / 33013(@)(@@) | 30 قال النبي : ( من قال كل يوم : اللهم اغفر لي وللمؤمنين 
ms3611	 والمؤمنات ألحق به من كل مؤمن حسنة ) )(@)(@@) . ( طك ، عن أم سلمة رضي الله عنها ) .(@)(@@)(@@)(@@) $ 3989 / 33014(@)(@@) | 30 قال النبي : ( من قال : لا إلاه إلا الله وحده لا شريك له ، له الملك وله الحمد وهو علاى كل شيء قدير مائتي مرة في يوم لم يسبقه أحد كان قبله ، ولا يدركه أحد كان بعده إلا من عمل عملا أفضل من عمله ) )(@)(@@) . ( حم ، عن ابن عمر رضي الله عنهما ) .(@)(@@)(@@)(@@) $ 3990 / 33015(@)(@@) | 30 قال النبي : ( من قال : اللهم فاطر السماوات والأرض ، عالم الغيب والشهادة ، إني أعهد إليك في هاذه الحياة الدنيا أني أشهد أن لا إلاه إلا أنت وحدك لا شريك لك وأن محمدا عبدك ورسولك ، فإنك إن تكلني إلاى نفسي تقربني إلاى الشر وتباعدني من الخير ، وإني لا أثق إلا برحمتك فاجعل لي عندك عهدا توفينيه يوم القيامة إنك لا تخلف الميعاد ) )(@)(@@) . ( حم ، عن ابن مسعود رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3991 / 33016(@)(@@) | 30 قال النبي : ( من قال : سبحان الله وبحمده مائة مرة ، وأستغفر الله وأتوب إليه كتبت كما قالها ثم علقت بالعرش لا يمحوها ذنب عمله صاحبها حتى يلقاى الله يوم القيامة وهي مختومة كما قالها ) )(@)(@@) . ( طك ، عن ابن عباس ، بز ، عن ابن عباس رضي الله عنهما ) .(@)(@@)(@@)(@@) $ 3992 / 33017(@)(@@) | 30 قال النبي : ( من قال : سبحان الله والحمد لله ، ولا إلاه إلا الله ، والله أكبر ، ولا حول ولا قوة إلا بالله ضم عليهن ملك بجناحه ، فلا ينتهي حتى يبلغ بهن العرش ، فلا يمر بشيء إلا صلى عليهن وعلاى قائلهن ، والتسبيح تنزيه الله من كل سوء ، ومن قال لا حول ولا قوة إلا بالله العلي العظيم قال : أسلم عبدي واستسلم ) )(@)(@@) . ( طك ، عن أبي هريرة رضي الله عنه ) .(@)(@@) PageV11P214(@)(@@)(@@)(@@) $ 3993 / 33018(@)(@@) | 30 قال النبي : ( من قال : سبحان الله وبحمده غرست له شجرة في الجنة ) )(@)(@@) . ( بز ، عن ابن عمرو رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3994 / 33019(@)(@@) | 30 قال النبي : ( من قال سبحان الله العظيم نبتت له شجرة في الجنة ، ومن قرأ القرآن فأكمله وعمل بما فيه ألبس الله والديه يوم القيامة 
ms3612	 تاجا هو أحسن من ضوء الشمس في بيت من بيوت الدنيا لو كانت فيه ، فما ظنكم بالذي عمل به ) )(@)(@@) . ( حم ، عن معاذ بن أنس رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3995 / 33020(@)(@@) | 30 قال النبي : ( من قال سبحان الله العظيم نبتت بدله غرس في الجنة ) )(@)(@@) . ( حم ، عن معاذ بن أنس رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3996 / 33021(@)(@@) | 30 قال النبي : ( من قال : لا إلاه إلا الله ، وحده لا شريك له ، له الملك وله الحمد وهو علاى كل شيء قدير عشر مرات ، كن له كعدل رقبات أو رقبة ) )(@)(@@) . ( حم ، عن أبي أيوب رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3997 / 33022(@)(@@) | 30 قال النبي : ( من قال : لا إلاه إلا الله وجبت له الجنة ) )(@)(@@) . ( بز ، عن أبي سعيد رضي الله عنه ) .(@)(@@)(@@)(@@) $ 3998 / 33023(@)(@@) | 30 قال النبي : ( من قال ليلة عرفة هاذه العشر كلمات ألف مرة لم يسأل الله شيئا إلا أعطاه إلا قطيعة رحم أو مأثما : سبحان الذي في السماء عرشه ، سبحان الذي في الأرض موطئه ، سبحان الذي في البحر سبيله ، سبحان الذي في النار سلطانه ، سبحان الذي في الجنة رحمته ، سبحان الذي في القبور قضاؤه ، سبحان الذي في الهواء روحه ، سبحان الذي رفع السماء ، سبحان الذي وضع الأرض ، سبحان الذي لا ملجأ ولا منجا منه إلا إليه ) )(@)(@@) . ( ع ، طك ، عن ابن مسعود رضي الله عنه ) .(@)(@@) PageV11P215(@)(@@)(@@)(@@) $ 3999 / 33024(@)(@@) | 30 قال النبي : ( من قال : لا إلاه إلا الله وحده لا شريك له ، له الملك وله الحمد ، يحي ويميت وهو علاى كل شيء قدير كان كمن أعتق أربعة رقاب من ولد إسماعيل ) )(@)(@@) . ( طك ، عن أيوب رضي الله عنه ) .(@)(@@)(@@)(@@) $ 4000 / 33025(@)(@@) | 30 قال النبي : ( من قال : لا إلاه إلا الله ، وحده لا شريك له ، له الملك وله الحمد ، وهو علاى كل شيء قدير مرة أو عشر مرات كان له ذالك بعدل رقبة أو عشر رقاب ) )(@)(@@) . ( حم ، طك ، عن أبي أيوب رضي الله عنه ) .(@)(@@)(@@)(@@) $ 4001 / 33026(@)(@@) | 30 قال النبي : ( من قال : لا إلاه إلا الله ، وحده لا شريك له ، له الملك وله الحمد ، وهو علاى 
