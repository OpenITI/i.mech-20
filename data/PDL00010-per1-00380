ms378	 مفاعیل مفاعیل فعولان PageV1P192(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای شده مفتون به قول‌های فلاطون %~% حال جهان باز چون شده است دگرگون(@)(@@) 2 پاره که کرد و به زعفران که فرو زد %~% قرطه گلبن به باغ و مفرش هامون(@)(@@) 3 گر نه هوا خشمناک و تافته گشته است %~% گرم چرا شد چنین چو تافته کانون(@)(@@) 4 گرم شود شخص هر که تافته گردد %~% تافته زی شد هوای تافته ایدون(@)(@@) 5 هرچه برآمد زخاک تیره به نوروز %~% مخنقه دارد کنون ز لولوی مکنون(@)(@@) 6 سیب و بهی را درخت و بارش بنگر %~% چفده و پر زر همچو چتر فریدون(@)(@@) 7 گوئی کز زیر خاک تیره برآمد %~% گنج به سر برنهاده صورت قارون(@)(@@) 8 بر سر قارون به باغ گوهر و زرست %~% گوهر و زری به مشک و شکر معجون(@)(@@) 9 هرچه که دارد همی به خلق ببخشد %~% نیست چو قارون بخیل و سفله و وارون(@)(@@) 10 خانه دهقان چو گنج‌خانه بیاگند %~% چون به رز و باغ برد باد شبیخون(@)(@@) 11 رنگ و مژه و بوی و شکل هست در این خاک %~% یا همی اینجا درآورند ز بیرون(@)(@@) 12 خاک به سیب اندرون به عنبر و شکر %~% از که سرشته شد و ز بهر چه و چون(@)(@@) 13 نیست در این هر چهارطبع ازین هیچ %~% ای شده مفتون به قول‌های فلاطون(@)(@@) 14 معدن این چیزها که نیست در این جای %~% جز که ز بیرون این فلک نبود نون(@)(@@) 15 وین همه بی‌شک لطایفند که این خاک %~% مرکب ایشان شده‌است و مایه و قانون(@)(@@) 16 خاک سیه را به شاخ سیب و بهی بر %~% گرد که کرد و خوش و معنبر و گلگون(@)(@@) 17 گوئی کاین فعل در چهار طبایع %~% هست رونده به طبع از انجم و گردون(@)(@@) 18 ویشان را نیز همچو سیب و بهی را %~% هست بر افلاک شکل و رنگ همیدون(@)(@@) 19 زرد چو زهره است عارض بهی و سیب %~% سرخ چو مریخ 
ms379	 روی نار و طبرخون(@)(@@) 20 چون نشناسی که از نخست به ابداع %~% فعل نخستین ز کاف رفت سوی نون(@)(@@) 21 فاعل آن زرد و سرخ کیست چه گوئی %~% ای شده بر قول خویش معجب و مفتون!(@)(@@) 22 اول اکنون نهان شد آن و ازان گشت %~% نام زد امروز و دی و آنگه و اکنون(@)(@@) 23 گشت طبایع پدید ازان و ازان شد %~% روی زحل سرخ و روی زهره چون زریون(@)(@@) 24 در به نبات اندرون فریشتگانند %~% هریک در بیخ و دانه‌ای شده مفتون(@)(@@) 25 دانه مراین را به خوشه‌ها در خانه است %~% بیخ مر آن را به زیر خاک در آهون(@)(@@) 26 پیشه‌ورانند پاک و هست در ایشان %~% کاهل و بشکول و هست مایه‌ور و دون(@)(@@) 27 هر یک بر پیشه‌ای نشسته مقیم است %~% هرگز ناید ز عمرو کار فریغون(@)(@@) 28 سیب گر اندر درخت و دانه سیب است %~% ناید بیرون ازو به خواندن افسون(@)(@@) 29 اینت هپیون گرست و آنت شکرگر %~% هر دو به خاک اندرون برابر و مقرون(@)(@@) 30 مایه هر دوست آب و خاک ولیکن %~% ملعون نبود هگرز همبر میمون(@)(@@) 31 گرچه ز پشم‌اند هر دو هرگز بوده‌است %~% سوی تو ای دوربین پلاس چو پرنون(@)(@@) 32 سنگ ترازو به سیم کس نستاند %~% گر چه بود همچو سیم سنگ تو موزون(@)(@@) 33 یوشع‌بن نون اگرچه نیز وصی بود %~% همبر هارون نبود یوشع‌بن نون(@)(@@) 34 کارکنان‌اند تخمها همه لیکن %~% جغد پدید است از همای همایون(@)(@@) 35 سیرت و کار فریشته همی دیدی %~% گر نکنی خویشتن مخبل و مجنون(@)(@@) 36 کارکنان خدای را چو ببینی %~% دل نکنی زان سپس به فلسفه مرهون(@)(@@) 37 گر به دلت رغبت علوم الهی است %~% راه بگردان ز دیو ناکس ملعون(@)(@@) 38 دل ز بدی‌ها به دین بشوی ازیرا %~% پاک شود دل به دین چو جامه به صابون(@)(@@) 39 مر طلب دین حق را به حقیقت %~% پاک دلی باید و فراخ چو جیحون(@)(@@) 40 روی 
