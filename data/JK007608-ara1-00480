ms461	 % % يصان الهوى في قلب من ضاع حزمه % 14(@)(@@) % وطيف حبيب راع نومي خياله % % وعرفني طول الليالي ملمه % % 15(@)(@@) % وما زارني إلا ليخجل طيبه % % نسيم الصبا أو يفضح الليل ظلمه % 16(@)(@@) % تطلع من أرجاء عيني دمعها % % وما كاد لولا الوجد ينقاد سجمه % 17(@)(@@) % ألا هل لحب فات أولاه رجعة % % وإن زاد عندي أو تضاعف اسمه % 18(@)(@@) % ليالي أسري في أصيحاب لذة % % ومخ الدجا رار وقد دق عظمه % % 19(@)(@@) % وأغدوا على ريعان خيل تلفها % % صدور القنا والنقع عال احمه % % 20(@)(@@) % رأيت الفتى يهوى الثراء ، وعمره % % يرى كل يوم زائدا منه عدمه % % PageV01P1636 21(@)(@@) % عقيب شباب المرء شيب يخصه % إذا طال عمر أو فناء يعمه % 22(@)(@@) % طليعة شيب بعدها فيلق الردى % % برأسي له نقع وبالقلب كلمه % % 23(@)(@@) % أغالط عن نفسي حمامي ، وإنما % % أداري عدوا مارقا في سهمه % 24(@)(@@) % وليس يقوم المرء يوما بحجة % إذا حضر المقدار والموت خصمه % % 25(@)(@@) % وأولى بمن يستخلف الدهر بعده % % على صرمه أن يودع الأرض صرمه % 26(@)(@@) % فوا عجبا للمرء ، والداء خلفه % % ومن حوله الأقدار والموت أمه % % 27(@)(@@) % يسر بماضي يومه ، وهو حتفه % % ويلتذ ما يغذى به ، وهو سمه % 28(@)(@@) % ورود من لآجال لا يستجمنا % % وورد من الآمال لا نستجمه % 29(@)(@@) % إلى كم أذود السيف عن هام عصبة % أما فيهم من يطعم السيف لحمه % % 30(@)(@@) % وعندي عال من دم الجوف شربه % % وماضي الظبا من أسود القلب طعمه % % PageV01P1637 31(@)(@@) % أقول لغر بي : لففت بضيغم % يؤد الأعادي خطفه ثم حطمه % 32(@)(@@) % فدع هضبة منا بنى الله سمكها % % فإن بناء الله يعييك هدمه % 33(@)(@@) % ومن عجب الأيام إني محسد % % أعادى على ما يوجب الود حكمه % 34(@)(@@) % وليس الفتى من يعجب الناس ماله % % ولكنه من يعجب الناس علمه % 35(@)(@@) % تشف خلال المرء لي قبل نطقه % % وقبل سؤالي عنه في القوم ما اسمه % % 36(@)(@@) % أرى آخر الخلان ودا يسوءني % % إذا هم واطى بين رأييه همه % % 37(@)(@@) % ولو غير قلبي ضم ذا العزم شقه % % ولكنه لا يقتل الصل سمه % % 38(@)(@@) % وأبلج لا يرضى عن العجز رأيه 
ms462	 % % تمد على أضوى من البدر لثمه % % 39(@)(@@) % إذا خلع الليل النهار سمت به % مآرب مضاء على ما يهمه % % 40(@)(@@) % وكم في نزار من نهيض نجيبة % % إذا سل عضبا سابق الضرب عزمه % % PageV01P1638 41(@)(@@) % أنيس بلقيان الحروب كأنما % % تمطت به في ناشر النقع أمه % % 42(@)(@@) % إذا ضرع الأقوام من سوء نكبة % جلاها قويم الأنف فيها أشمه % % 43(@)(@@) % رفيع بيوت المجد كالجد جده % فخارا وفي العلياء كالخال عمه % % 44(@)(@@) % مهيب وقار الجانبين أبيه % % ومخول مجد الوالدين معمه % 45(@)(@@) % فمن خائف عند الليالي نجيره % ومن شعث بين المعالي نلمه % % 46(@)(@@) % وإني لدفاع بي العزم والمنى % % إلى كل ليل يعقد الطرف نجمه % 47(@)(@@) % وما تستدل النجم عيناي في الدجا % % ضلالا ولكن مثل عيني جرمه % % 48(@)(@@) % شددنا بأيدي العيس كل ثنية % % ومن دونها جون القرا مدلهمه % 49(@)(@@) % ومنخرق لا يقطع الطرف عرضه % % ولا ينزوي عن أعين الركب خرمه % % 50(@)(@@) % توهمت عصف الريح بين فروجه % % يسر إلى سمعي مقالا يصمه % PageV01P1639 51(@)(@@) % وجيش يسامي كل طود عجاجه % % ويفتر عنه كل واد يضمه % % 52(@)(@@) % تخطف أبصار الأعادي سيوفه % % وتملأ أسماع القبائل لجمه % 53(@)(@@) % إذا سار صبحا طارد الشمس نقعه % % وإن سار ليلا طبق الأرض دهمه % % 54(@)(@@) % تراجع حمرا من دم الضرب بيضه % % وتنجاب شقرا من دم الطعن دهمه % 55(@)(@@) % صدمنا به الجبار في أم رأسه % % وكان شفاء الرأس ذي الداء صدمه % 56(@)(@@) % وما ضاقت الأقطار من دون فوته % ظبانا ولكن أوبق العبد ظلمه % % 57(@)(@@) % عذيري ممن ذم عهدي ، وقد نبا % % مرارا ، وقلبي وادع لا يذمه % 58(@)(@@) % تجرم لما لم يجد لي زلة % % وأقصدني باللوم والجرم جرمه % % 59(@)(@@) % تعمدت بعدي عنه من غير سلوة % ليعلمني يوم النوى كيف طعمه % % 60(@)(@@) % وأجممته لا عن غناء ، وإنما % % لأشربه في حر خطب أجمه % % PageV01P1640 61(@)(@@) % وإني ، وإن والى على القلب حربه % % لمنتظر أن يعقب الحرب سلمه % % 62(@)(@@) % ولا تيأسن من عفو حر ، فإنما % % تحلمه باق ، إذا ضاع حلمه % 63(@)(@@) % أأطمع أن أنساك يوما ، وإنما % % هواك ضجيع القلب مني وحلمه % % 64(@)(@@) % يقر بعيني منظر أنت 
ms463	 قيده % % 65(@)(@@) % وأنت الفتى لا عاجز عن فضيلة % وغير قليل من معاليه قسمه % 66(@)(@@) % تجاوز بعمد واعف ، فالعتب إن يدم % على الخل يفسد ظن قلب ووهمه % % 67(@)(@@) % أرى آخر الخلان ودا يسؤني % % ويمدح عندي أولا طال ذمه % % 68(@)(@@) % على أنني راض بما جر هجره % % وهل أنا إلا القلب يلتاث جسمه % % PageV01P1641 البحر : طويل 1(@)(@@) % بعادا لمن صاحبت غير المقوم % وبعدا لكل الري إلا من الدم % 2(@)(@@) % إذا ظلم لم أمض فيها عزيمة % فساعة ليلي مثل حول مجرم % % 3(@)(@@) % ومن شغفي بالطعن أغدو وذابلي % % إذا قل جرم مال بي في التجرم % 4(@)(@@) % وما أنا ممن يقبل الطعم قلبا % % ولم تعلم الأرماح من أين مطعمي % % 5(@)(@@) % سأقدم لا مستعظما ما لقيته % توسع لي في الروع أو ضاق مقدمي % % 6(@)(@@) % فقد فجع الماضي لبيدا بأربد % وعزي قبلي مالك من متمم % 7(@)(@@) % وعزم أعاطيه العوالي وحاجة % % رميت بها ما بين أرض ومنسم % 8(@)(@@) % وليس الفتى إلا الذي إن رأيته % رأيت غني النفس في ثوب معدم % 9(@)(@@) % قليل مقام بين أهل وثروة % كثير طلوع بين واد ومخرم % % 10(@)(@@) % أمطلع يومي علي ولم أخض % % دماء الأعادي بالوشيج المقوم % % PageV01P1642 11(@)(@@) % ولم أجهد السيف الطويل نجاده % % أمام الظبى ، والنقع بالنقع يرتمي % % 12(@)(@@) % وليس شفاء النفس إلا مثقف % % يعد ليوم بالغبار ملثم % % 13(@)(@@) % وكم لي من رماحة تزعج الحصى % % بوابلها في معلم بعد معلم % 14(@)(@@) % إذا الله لم ينصر حسامي على العدا % % فما أنا إلا عرضة المتهضم % % 15(@)(@@) % وإن هو نجى من فم الموت مهجتي % % نجوت ، وإلا كنت أول مطعم % 16(@)(@@) % أبيت ولي في كل أرض عزيمة % % تزعزع أعناق المطي المحزم % 17(@)(@@) % ومستوصيات بالذميل كأنما % % يدارس إذآب الجديل وشدقم % % 18(@)(@@) % ترى كل حمراء الملاط كأنما % % تخلج في آماقها عرق عندم % 19(@)(@@) % بخف كشدق الأعلم استصعبت به % % على ظل عنق ذي عثانين مرجم % 20(@)(@@) % كان الغلام الضرب في الرحل ريشة % % خفت فوق زور من ظليم مصلم % % PageV01P1643 21(@)(@@) % إذا أوجست حس القطيع وراءها % % ألاحت بخيشوم كريم وملطم % % 22(@)(@@) % تخيل من فضل الزمام 
ms464	 ابن رملة % له نهشات في مكان المخطم % 23(@)(@@) % طلعن على ليل بنا ووصلنه % بأبلج لماع الجواشن معلم % 24(@)(@@) % ومن جعل القلب الجري دليله % % فكل ظلام عنده غير مظلم % 25(@)(@@) % بليت وأبلاني زماني بعصبة % % يخوضون بي في كل غيب مرجم % 26(@)(@@) % مذاييع للسر المصون ، وليتهم % أذاعوه طلق البرد لما ينمنم % 27(@)(@@) % قليل حديث مارق غير مكثر % وبدء مقال وارد من متمم % % 28(@)(@@) % زمان الأذى عش فيه تشج بأهله % % وتغض على ذل ومت فيه تعظم % % 29(@)(@@) % على أنني لا غالب الرأي بالهوى % % ولا قائل للشوق إن ضل يمم % 30(@)(@@) % ولا قاطع بالظن ما كنت واصلا % ورب مغيظ قاطع بالتوهم % % PageV01P1644 31(@)(@@) % وإني مماآلف بالجد باخل % % بثغري فما يدري امرؤ أين مبسمي % % 32(@)(@@) % فراق من الأحباب أمضى من الردى % % وأقطع للأقران من غرب مخذم % 33(@)(@@) % لك الله من واد توركن عرضه % % ونقبن فيه عن عرار وعظلم % 34(@)(@@) % يبارين نفاح الخزامى عشية % بأطيب من ريح الخزامى وأنعم % 35(@)(@@) % أغالب دمعي ثم يغلب جاريا % ومن لم يسل دمعا على الحب يظلم % % 36(@)(@@) % وما ذكرتك النفس إلا وضمها % % إلى القلب باع الموجع المتألم % % 37(@)(@@) % خليلي ليس الدمع عني بدافع % ولوع غرام كالحريق المضرم % 38(@)(@@) % وهل أنا إلا رب نفس معارة % % وقلب معار للجوى والتألم % 39(@)(@@) % إذا ما جوادي مر بي في ديارها % % تقاضى زفيري دائبا بالتحمحم % % 40(@)(@@) % أحن ، ولا يرمى حنيني بتهمة % وأدنو ولا يعزى دنوي بمأثم % % PageV01P1645 41(@)(@@) % وما منظر الحسناء عندي برائق % ولا نيلها والقرب عندي بمغنم % 42(@)(@@) % إلى كم تصباني الغواني ، وبينها % % وبيني عفاف مثل طود يلملم % % 43(@)(@@) % وإني لمأمون على كل خلوة % أمين الهوى والقلب والعين والفم % % 44(@)(@@) % وغيري إلى الفحشاء إن عرضت له % % أشد من الذؤبان عدوا على الدم % 45(@)(@@) % ومن كان إنعام الوزير حبيبه % أغار الغواني بين بكر وأيم % % 46(@)(@@) % أبيت بها هادي الحشا في نوائب % يبيت لها غير بقلب مقسم % % 47(@)(@@) % وحيد العلى لا ينتجي غير نفسه % إذا عن خطب أو دنا يوم مغرم % % 48(@)(@@) % ومنتصر يرعى بحلم حقوده % ويطرد أضغان 
ms465	 العدا بالتكرم % % 49(@)(@@) % إذا عظم الطلاب لم يثن كفه % وإن طال نطق القوم لم يتجهم % 50(@)(@@) % يزم إلى العافين أعناق ماله % % ومال رجال مقرم لم يخطم % PageV01P1646 51(@)(@@) % كثير ارتياح القلب في عقب جوده % % إذا جائد ألقى يدا في التندم % 52(@)(@@) % سريع ، إذا داعي الطعان دعا به % غدا طاعنا قبل العدا في التلوم % 53(@)(@@) % وما هم إلا قعقع البيض بالظبا % % ورد القنا يجري على كل معصم % 54(@)(@@) % ولا ركز إلا أن تمير زجاجها % % عواملها فضل النجيع المحرم % 55(@)(@@) % وكل صباح شاحب من عجاجة % وشائع برد بالعوالي مسهم % % 56(@)(@@) % إذا عن جود قيل دفاع وابل % % وإن عن روع قيل : تقحيم ضيغم % 57(@)(@@) % يشن وجوه البيد في كل مسلك % % بجر العوالي والرعيل المسوم % % 58(@)(@@) % فعال جري لا يزال مدافعا % إلى المجد طلاعا إلى كل معظم % % 59(@)(@@) % ولكنه بالعز والمجد والعلى % % أحق وأولى من سماء بأنجم % 60(@)(@@) % أتته ولم يمدد يدا في طلابها % % وما انقاد من قاد العوالي بمخطم % PageV01P1647 61(@)(@@) % ولو لم يقر الغابطون بمجده % % أقروا على رغم بفضل التقدم % % 62(@)(@@) % وما كذب الحساد للبدر ضائرا % وليس يضر الذم غير المذمم % 63(@)(@@) % وحي حلال قد ذعرت بكبة % من الخيل لا ترعى ذماما لمحرم % % 64(@)(@@) % على حين حاصرت الظلام إليهم % بأرعن يردي في الحديد المنظم % % 65(@)(@@) % وما افتر يوم قط إلا لقيته % بوجه جلي ، أو بكف مغيم % 66(@)(@@) % إذا مارق لاقاك غض عنانه % ورد أظافير القنا لم تقلم % 67(@)(@@) % ورب نسيب للرماح مغامر % % حفيف الشوى عاري الجناحين أعلم % % 68(@)(@@) % ذا هز يوما للغوار رأيته % أنم إلى الأرواح من كل لهذم % 69(@)(@@) % يسرك في فل الصوارم والقنا % % ويرضيك في رد اللهام العرمرم % % 70(@)(@@) % له ريقة تجري بما شاء ربه % كما حال سم بين أنياب أرقم % PageV01P1648 71(@)(@@) % أماليء أيام الندى كل عارض % % وماليء أيام الوغى كل ملجم % % 72(@)(@@) % تهن قدوم المهرجان ، فإنه % إليك على الأيام ينمى وينتمي % % 73(@)(@@) % وما زار هذا العيد إلا صبابة % % إليك بقلب طامح الوجد مغرم % % 74(@)(@@) % أتى يستفيد الجود منك ويجتلي % % محاسنه من 
ms466	 ثغرك المتبسم % % 75(@)(@@) % فلا عار أن تستنجد الكأس راحة % أضر بها حمل الجراز المصمم % % 76(@)(@@) % أراك بعين لا يسوءك لحظها % % وأرعاك بالود الذي لم يذمم % 77(@)(@@) % وفي نظري عنوان ما بين أضلعي % % ورب لحاظ نائب عن تكلم % 78(@)(@@) % وكم نظرة تستوهب القول من فمي % % تكلف نطقي في جواب المكلم % 79(@)(@@) % ولست ولو خادعتني عن مطالبي % % مطاوع عذالي عليك ولومي % % 80(@)(@@) % وأكرم مأمول وأشرف ماجد % جواد متى يندب إلى الجود يقدم % % PageV01P1649 81(@)(@@) % أعيذك أن تظمي فتى كان طرفه % عقيدا لبرق العارض المترنم % 82(@)(@@) % ومن غره مال رضي ببشاشة % % وعادم ماء قانع بالتيمم % 83(@)(@@) % ألا إن شعري فيك يبقى وغيره % تطير به أيدي الليالي وترتمي % % 84(@)(@@) % وتعقد طرفي منك في كل نظرة % % طلاقة بدر بالمعالي معمم % 85(@)(@@) % ولولاك ما فاقت ببغداد ناقتي % % ولا كنت إلا لاحقا بالمقطم % 86(@)(@@) % وأولى بلاد بالمقام من الدنا % % بلاد متى ينزل بها الحر يغنيم % 87(@)(@@) % مدحت أمير المؤمنين ، وإنه % لأشرف مأمول وأعلى مؤمم % % 88(@)(@@) % فأوسعني قبل العطاء كرامة % % ولا مرحبا بالمال إن لم أكرم % 89(@)(@@) % وإني إذا ما قلت في غير ماجد % % مديحا كأني لائك طعم علقم % % 90(@)(@@) % وإن رجائي زين ملة هاشم % لنعمى ، وحسبي من جواد ومنعم % PageV01P1650 91(@)(@@) % فكن شافعي يوما إليه لعله % يريش العواري من نبالي وأسهمي % % 92(@)(@@) % أغار على عليائه من مقصر % يقول ولم يرزق مقالي ولا فمي % % 93(@)(@@) % فإن شاء فالوسم الذي قد عرفته % % مبين لعين الناظر المتوسم % PageV01P1651 البحر : وافر تام 1(@)(@@) % أرى نفسي تتوق إلى النجوم % سأحملها على الخطر العظيم % 2(@)(@@) % وإن أذى الهموم على فؤادي % % أضر من النصول على أديمي % % 3(@)(@@) % وإني ، إن صبرت ثنيت قلبي % % على طرف من البلوى اليم % % 4(@)(@@) % ولي أمل كصدر الرمح ماض % سوى أن الليالي من خصومي % % 5(@)(@@) % ويمنعني المدام طروق همي % % فما يحظى بها إلا نديمي % % 6(@)(@@) % وما أوفت على العشرين سني % % وقد أوفى على الدنيا غريمي % % 7(@)(@@) % ونجوى قد شهدت وعدت ألقي % % عنان فمي إلى قلب كتوم % % 8(@)(@@) % وهول يرعد النسيان منه % % ركبت معارض 
ms467	 الجد المروم % % 9(@)(@@) % إذا ما حاجة قضيت بسيفي % % شكرت لها يد الليل البهيم % % 10(@)(@@) % ويعرفني العدو بوقع رمحي % % إذا ما الوجه موه بالسهوم % PageV01P1652 11(@)(@@) % وما لي همة إلا المعالي % % وذب الضيم عن نسب صميم % 12(@)(@@) % وقود الخيل تركع من وجاها % % وقد غلب النجيع على الكلوم % 13(@)(@@) % تصبح في الطلى بدراك طعن % % كرمح الشول زغن عن المسيم % 14(@)(@@) % ويذهلها إذا التقت العوالي % % ضرام الطعن عن مضغ الشكيم % 15(@)(@@) % وكل نحيلة كالسهم تصمي % % عرانين الأماعز والخروم % % 16(@)(@@) % تريني الشمس أول من يراها % % وآخر شأوها طلق الظليم % % 17(@)(@@) % وحث العيس تستلب الفيافي % % بإملاء الذميل على الرسيم % 18(@)(@@) % جزعن الليل ، والآفاق خلس % كأن نجومها نغل الأديم % % 19(@)(@@) % وأبلج مثل فرق الرأس نهج % % قطعن وما قلقن من السؤوم % 20(@)(@@) % وماء قد تخفر بالدياجي % % عن الطراق والسلم المقيم % PageV01P1653 21(@)(@@) % وردن ولا دلاء لهن إلا % مشافرهن في الورد الجموم % % 22(@)(@@) % وعدن ، وقد وهى سلك الثريا % % وكر الصبح في طلب النجوم % 23(@)(@@) % وقد لاحت لأعيننا ذكاء % وراء الفجر كالخد اللطيم % 24(@)(@@) % ومختلط الندى أرج الخزامى % % رطيب ذوائب الكلإ العميم % 25(@)(@@) % أبحت حريمه إبلي ، فأمست % تغير شفاههن على الجميم % 26(@)(@@) % ألا هل أطرق السمرات يوما % بريء القلب من عنت الهموم % % 27(@)(@@) % وألصق عقلها بربى تراها % % من الأنواء ضاحكة الوشوم % 28(@)(@@) % أرى الأيام عادية علينا % % ببيض من نوائبها وشيم % % 29(@)(@@) % يضل نفوسنا داء عقام % % فيسلمنا إلى أرض عقيم % 30(@)(@@) % ونتبع بالدموع ، وأي دمع % يجير ، ولو أقام على السجوم % PageV01P1654 31(@)(@@) % ويفردنا الزمان ، بلا قريب % يذم من الزمان ولا حميم % 32(@)(@@) % ونلقى قبل لقيان المنايا % % رماح الداء تطعن في الجسوم % 33(@)(@@) % فلو كانت خصوصا سر قوم % ولكن العناء على العموم % 34(@)(@@) % ويكثر مطلي الغرماء ، إلا % إذا راح الردى ، وغدا غريمي % % 35(@)(@@) % رأيت المال يرفع من سفيه % وعدم المال ينقص من حليم % 36(@)(@@) % فليت كريم قوم نال عرضي % % ولم يدنس بذم من لئيم % 37(@)(@@) % يلوم وقد ألام وشر شيء % % إذا لاقاك لوم من مليم % 38(@)(@@) % أشب ، لأحرق الأعداء ، لحظي % % فيرجعني إلى الإغضاء خيمي 
ms468	 % % 39(@)(@@) % أبى لي الدم آباء تساموا % % إلى عنقاء طيبة الأروم % % 40(@)(@@) % إذا اشتملوا على الأعداء عادوا % % وقد غمروا الضغائن بالحلوم % PageV01P1655 41(@)(@@) % ألا من مبلغ الأحياء أني % % قطعت قرائن الزمن القديم % 42(@)(@@) % وأني قد أبيت مقام رحلي % % بوادي الرمث أو جبل الغميم % 43(@)(@@) % وعن قرب سيشغلني زماني % % برعي الناس عن رعي القروم % % 44(@)(@@) % وما لي من لقاء الموت بد % فمالي لا أشد له حزيمي % % 45(@)(@@) % سألتمس العلى إما بعرب % يروون اللهاذم أو بروم % 46(@)(@@) % ولو أني أعنت بآل عكل % رغبت عن الذوائب من تميم % 47(@)(@@) % حذاركم بني الضحاك إني % % إلى الأمر الذي تومون أومي % % 48(@)(@@) % فلا تتعرضوا بذراع عاد % مدل عند خيسته شتيم % 49(@)(@@) % فإن تك مدحة سبقت فإني % % بضد نظامها عين الزعيم % % 50(@)(@@) % وقافية تخضخض ما ترامت % % به الأيام في عرض اللئيم % PageV01P1656 51(@)(@@) % تردد ما لها ممن يعيها % % سوى الإطراق منها والوجوم % 52(@)(@@) % لها في الرأس سورات يطاطي % % لها الإنسان كالرجل الأميم % 53(@)(@@) % ليعلم من أناضل أن شعري % % يطالع بالشقاء وبالنعيم % % PageV01P1657 البحر : طويل 1(@)(@@) % رأت شعرات في عذاري طلقة % كما افتر طفل الروض عن أول الوسم % 2(@)(@@) % فقلت لها : ما الشعر سال بعارضي % % ولكنه نبت السيادة والحلم % 3(@)(@@) % يزيد به وجهي ضياء وبهجة % وما تنقص الظلماء من بهجة النجم % PageV01P1658 البحر : بسيط تام 1(@)(@@) % هل كان يومك إلا بعد أيام % سبقت فيها بإنعام وإرغام % % 2(@)(@@) % وهل أزالك عن هذا سوى قدر % % تناول الأسد من غيل وآجام % 3(@)(@@) % إن المنايا مغرات لأنفسنا % % وإن أمدت بأعوام وأعوام % % 4(@)(@@) % نسعى بأقدامنا عنها فتدركنا % % سبق الجياد وما تسعى باقدام % % 5(@)(@@) % مالي بطي الليالي غير مكترث % وما ورائي منها كان قدامي % % 6(@)(@@) % أظن شخص الردى فردا فأحذره % والموت أكبر من ظني وأوهامي % % 7(@)(@@) % إن الحياة ، وإن غرت مخائلها % % ظل وإن المنى أضغاث أحلام % % 8(@)(@@) % تامي البقاء إلى الذاوي تراجعه % % كلا ولا يرجع الذاوي إلى النامي % % 9(@)(@@) % أبا الفوارس ما أعلى يدا عصفت % % من المنون بأعلى عزك السامي % % 10(@)(@@) % إن المنية ما زالت مفوقة % حتى رمتك ، ولا 
ms469	 عدوى على الرامي % % PageV01P1659 11(@)(@@) % كرت ، فلم تثنها بالسمر مشرعة % ولم ترعها بإسراج وإلجام % % 12(@)(@@) % إلا اتقيت بما سومت من عدد % % وما تعلمت من نقض وإبرام % % 13(@)(@@) % هيهات ألقى حمام كل مارنة % تدمى وأبطل موت كل إقدام % % 14(@)(@@) % تملي المقادير أعمارا ، وتنسخها % % ويضرب الدهر أياما بأيام % 15(@)(@@) % فمن كمين ردى تسري عقاربه % % ومن طلوع برايات وأعلام % 16(@)(@@) % أين السرير وقد قام السماط له % إجلال أروع عالي القد بسام % 17(@)(@@) % أين الجياد تنزى في أعنتها % % يطلبن يوما قطوبا وجهه دام % 18(@)(@@) % أين الفيول كأن الممتطين لها % % على ذوائب أطواد وأعلام % 19(@)(@@) % أين الوفود على الأبواب مذكرة % % بالفرط من مجد أخوال وأعمام % 20(@)(@@) % أين المراتب والدنيا على قدم % موقوفة بين أرماح وأقلام % PageV01P1660 21(@)(@@) % مضى ولم يغن ما عددت عنه ، ولا % % كسب العلى واجتناب اللوم والذام % 22(@)(@@) % وعاد أعظم من في جيشه جرة % % وليس يملك إلا عض إبهام % 23(@)(@@) % وكان أقطع من صمصامة ظبة % % فينا وأمضى مضاء منه في الهام % 24(@)(@@) % لم يجر يوما بأطراف العراق دما % إلا وراع دماء القوم بالشام % 25(@)(@@) % وكان أن حاف عدم ثم عذت به % % ملأت أرضك من خيل وأنعام % 26(@)(@@) % يحنو على رحم مجفوة ويرى % % قطع الرقاب ولا قطعا لأرحام % 27(@)(@@) % تبكي الركاب وقد ردت أزمتها % % فالركب ما بين أعوال وأرزام % 28(@)(@@) % اليوم يرتاح من كانت أضالعه % على قوادم أحقاد وأوغام % 29(@)(@@) % يموت قوم ، فلا يأسى لهم أحد % وواحد موته حزن لأقوام % 30(@)(@@) % سقى الحيا منك أوصالا مفرقة % % فيها مجامع إجلال وإعظام % PageV01P1661 31(@)(@@) % غيثان : ذا جامد تخفى مخائله % عن العيون وذا بادي الذرى هامي % % 32(@)(@@) % لله درك من غراء أحرزها % % موسومة قلب ضرغام لضرغام % % 33(@)(@@) % قد كدت أعقلها لولا محافظة % % على يد سلفت منه وإنعام % 34(@)(@@) % أعاد عز أبي غضا وخوله % ما شاء من بذل إعزاز وإكرام % % 35(@)(@@) % وكنت أجممته للعز أطلبه % وإنما كان للمقدور إجمامي % % 36(@)(@@) % ودون ما تشتهيه النفس متعبة % % إن اللألي وارء الأخضر الطامي % % 37(@)(@@) % فاذهب كما ذهب البدر استبد به % % برغم أعيننا جلباب إظلام 
ms470	 % % 38(@)(@@) % فما لدارك منا غير مقلية % % ولا لقربك منا غير إلمام % PageV01P1662 البحر : وافر تام 1(@)(@@) % متى أنا قائم أعلى مقام % % ولاق نور وجهك بالسلام % 2(@)(@@) % ومنصرف وقد أثقلت عطفي % % من النعماء والمنن الجسام % 3(@)(@@) % ولي أمل أطلت الصبر فيه % لو أن الصبر ينقع من أوامي % % 4(@)(@@) % وما خفت النوائب ترتمي بي % % وقد أقعى بجامحها لجامي % % 5(@)(@@) % أيعرقني الطوى والروض حال % ويغلبني الظما والبحر طام % % 6(@)(@@) % ولي قربى رؤوم كنت أرجو % % يمينك أن تقرب لي مرامي % % 7(@)(@@) % وباب الإذن مني كل يوم % % يقعقع بالقوافي والنظام % % 8(@)(@@) % لكم أرجاء زمزم والمصلى % % وبطحاء المشاعر والمقام % % 9(@)(@@) % وأنتم أطول العظماء طولا % وأندى في المحول من الغمام % 10(@)(@@) % وأبعد موطنا من كل عار % وأمنع جانبا من كل ذام % % PageV01P1663 11(@)(@@) % وأجرى عند مختلف العوالي % % وأفلج عند معترك الخصام % 12(@)(@@) % بآباء مضوا ، وهم عوار % من القول المهجن والملام % % 13(@)(@@) % وأمات درجن على الليالي % % وهن أصح من بيض النعام % 14(@)(@@) % وعز لا يزعزع بالرزايا % % وطود لا يضعضع بالزحام % 15(@)(@@) % وفخر شامخ العرنين عال % ومجد طائر العزبات سام % 16(@)(@@) % تسيل إليهم أيدي المطايا % % بكل أشم معروق العظام % 17(@)(@@) % يغلبن البعاد على التداني % % ويؤثرن المسير على المقام % 18(@)(@@) % ويعلفن الذميل ولا سبيل % % إلى الغدران والنطف الطوامي % % 19(@)(@@) % وينصل ليلها عن كل عنس % غضيض الطرف فاترة البغام % 20(@)(@@) % أحفت من جوانبها الفيافي % % وساقط نحضها خوض الظلام % PageV01P1664 21(@)(@@) % تناخ بمالئ الدنيا نوالا % وصادع بيضة الملك الهمام % % 22(@)(@@) % ببأس مثل غرب السيف ماض % وجود مثل ماء المزن هام % 23(@)(@@) % وصولات أمر من المنايا % % على بشر ألذ من المدام % 24(@)(@@) % أمير المؤمنين ، وأنت أولى % % بغايات الفخار من الأنام % 25(@)(@@) % وأنت مملك شرقا وغربا % حريم الأرض والبلد الحرام % 26(@)(@@) % أجب صوتي إليك فكل ملك % يلذ على مسامعه كلامي % % 27(@)(@@) % وجردني تلاق الدهر مني % % بمسموم مضاربه حسام % 28(@)(@@) % ولا تتغاضين عن القوافي % % فقد أربت على طول الجمام % % 29(@)(@@) % وإني نعم دامغ كل قرن % يرادي بالعداوة ، أو يرامي % % 30(@)(@@) % ودافع كل داهية نآد % وقائد كل ذي لجب 
ms471	 لهام % PageV01P1665 31(@)(@@) % لعلي بالغ أمري ولاق % منى نفسي من النعم العظام % 32(@)(@@) % وأمرا منك يحذره الأعادي % % فيلحظه بأجفان دوام % 33(@)(@@) % فأعينهم لبغضته غواض % % وهن لعظم منظره سوام % % 34(@)(@@) % تهن قدوم صومك ، يا إماما % يصوم على الزمان من الأثام % 35(@)(@@) % إذا ما المرء صام من الدنايا % % فكل شهوره شهر الصيام % 36(@)(@@) % ألان جذبت من أيدي الليالي % % عناني واشتملت على زمامي % % 37(@)(@@) % فما أخشى الزمان ولو تلاقت % % يداه من ورائي أو أمامي % % 38(@)(@@) % ولا سيما وقد أمسى علي % ظهيري والسفير إلى إمامي % % PageV01P1666 البحر : طويل 1(@)(@@) % حلفت بها صيد الرؤوس سوام % طوال الذرى يمددن كل زمام % 2(@)(@@) % بكل غلام حرم النوم هزة % % إلى بلد نائي المزار حرام % 3(@)(@@) % لأستمطرن العزنفا مريغة % % ورود علاء أو ورود حمام % 4(@)(@@) % وأستنزلن المجد من قذفاته % ولو كان أعلى يذبل وشمام % 5(@)(@@) % مللت مقامي غير شكوى خصاصة % % وإني لأمر ما أمل مقامي % % 6(@)(@@) % نزاعا عن الدار التي أنا عندها % % كثير لبانات طويل غرام % 7(@)(@@) % صريع هموم يحسب الناس أنني % % لما أخذت مني صريع مدام % 8(@)(@@) % نوائب أيام نسرن خصائلي % % مغالبة ، حتى عرقن عظامي % % 9(@)(@@) % ودون ولوج الضيم في ذوابلي % % طوال بأيدي منجبين كرام % % 10(@)(@@) % وإن زماني يوم يحرق نابه % أعاذمه حتى يمد عذامي % % PageV01P1667 11(@)(@@) % وكم يستفز الذل قلب ابن همة % له أمل نائي المدى مترام % 12(@)(@@) % يذاد عن الماء الذي فيه ريه % % ويرمي إلى الغدران مقلة ظامي % % 13(@)(@@) % وتعرض غرات العلى وهو كانع % % فيلحظها شزرا بعين قطامي % % 14(@)(@@) % ولست براض عن منازل جمة % % أمر بها في الأرض مر لمام % 15(@)(@@) % سوى منزل حصباء أرضي بجوه % % نجوم وأظلال الغمام خيامي % % 16(@)(@@) % فذاك مكاني إن أقمت بمنزل % % وإلا ففي أيدي الطلاب زمامي % % 17(@)(@@) % خفيف على ظهر الجواد تسرعي % % ثقيل على هام الرجال قيامي % % 18(@)(@@) % خليلي رودا باليفاع ، فأشرفا % % على قلل بالأبرقين سوام % 19(@)(@@) % لبرق كتلويح الرداء يشبه % % تضايق مرنان الرعود ركام % 20(@)(@@) % تربص إن يلقى بنجد بعاعه % % وساق إلى البيضاء عير غمام % PageV01P1668 21(@)(@@) % زفته النعامى ، فاستمر جمامه % % تجفل سربي ربرب 
ms472	 ونعام % % 22(@)(@@) % يضيء إلى الربع الذي كنت آلفا % به برء أسقامي وبل أوامي % % 23(@)(@@) % منازل كان الطرف يرتاح بينها % % لخضر جميم أو لزرق جمام % 24(@)(@@) % سقى تربها حتى استثار خبيئه % % سقيط رذاذ دائم ورهام % % 25(@)(@@) % وراقت بها الأنواء كل صبيحة % % ورقت بها الأرواح كل ظلام % 26(@)(@@) % تضم رجالا كالرماح ، إذا دعوا % % إلى الحرب لفوا نارها بضرام % 27(@)(@@) % لهم عدد جم من البيض والقنا % % وذافرة بالليل ذات بغام % % 28(@)(@@) % إذا غضبوا جاشت ربى الأرض منهم % % ببيض وبيض كالنجوم ولام % 29(@)(@@) % بأي سراة أحمل الخطب إن عرا % % وقد جب منهم غاربي وسنامي % % 30(@)(@@) % وكانوا دروعي إن رمتني ملمة % ونبلي إن رامى العدا وسهامي % % PageV01P1669 31(@)(@@) % ولولا ابن موسى ما اعتصمت بجنة % % ولا علقت كفي بعقد ذمام % 32(@)(@@) % ملاذي إن أعطي الرمان مقادتي % % معاذي إن جر العدو خطامي % % 33(@)(@@) % من القوم ما زروا الجيوب على الخنا % % ولا قرعت أسماعهم بملام % % 34(@)(@@) % سريعون إن نودوا ليوم كريهة % جريئون إن قيدوا ليوم خصام % % 35(@)(@@) % لهم شرف آب على الناس اقعس % وفضل عديد للعدو لهام % % 36(@)(@@) % نجومهم في العز غير غوارب % % وأجدادهم في المجد غير نيام % % 37(@)(@@) % يهاب بهم مستلئمين إلى الردى % % على عارفات بالطعان دوام % % 38(@)(@@) % عناجيج قد طوحن كل حقيبة % % من الركض واستهلكن كل لجام % 39(@)(@@) % نزائع ما تنفك تفرى صدورها % % جيوب ظلام ، أو ذيول قتام % 40(@)(@@) % يخالطن بالفرسان كل طريدة % % ويبلغن بالأرماح كل مرام % % PageV01P1670 41(@)(@@) % أحاسد ذا الضرغام دونك فاجتنب % % بوادر مقدام الجنان محامي % % 42(@)(@@) % حذارك من ليث ترى حول غيله % % سواقط أيد للرجال ، وهام % 43(@)(@@) % له العدوة الأولى التي تحطم القنا % % وتجلي الأعادي كل يوم مقام % % 44(@)(@@) % هنيئا لك العيد الجديد ولا تزل % % تخلص من عام يمر وعام % 45(@)(@@) % تلثمت من فضل العفاف عن الهوى % % نجاء من الدنيا أعز لثام % 46(@)(@@) % وخالفت في ذا لصوم سنة معشر % % صيام ، عن العوراء غير صيام % 47(@)(@@) % ألا إنني غرب الحسام الذي ترى % % وغارب هذا الأرعن المتسامي % % 48(@)(@@) % كلانا له السبق المبر إلى العلى % % وإن كان في 
ms473	 نيل العلاء إمامي % % 49(@)(@@) % وما بيننا يوم الجزاء تفاوت % % سوى انه خاض الطريق أمامي % % PageV01P1671 البحر : كامل تام 1(@)(@@) % ما إن رأيت كمعشر صبروا % % لقوارع اللزبات والأزم % 2(@)(@@) % بسطوا الوجوه وفي ضلوعهم % حرق الجوى ومآلم الكلم % % 3(@)(@@) % جمحت بهم خيل الأسى فتنوا % % أعناقها بأعنة الحزم % % PageV01P1672 البحر : رمل تام 1(@)(@@) % قعد الراضون بالذل فقم % إنما الماضي إذا هم عزم % % 2(@)(@@) % ما مقامي غير ممضي نية % % دائبا أهدر كالفحل السدم % 3(@)(@@) % أعرض الآمال مشغوفا بها % % ثم انساها إذا الخطب ألم % % 4(@)(@@) % طال لبثي سادرا في غمة % وقديما كنت فراج الغمم % % 5(@)(@@) % لا ألوم الهم إن لازمني % % فهموم المرء يبعثن الهمم % % 6(@)(@@) % لست بالواني ولكني فتى % % ظلمته نائبات فانظلم % % 7(@)(@@) % وزمان شرع أنيابه % أبدا ، يعرقنا عرق السلم % 8(@)(@@) % المعازيل كرام عنده % % والمناجيب كملفوظ العجم % 9(@)(@@) % خضع الدهر لنا ثم نبا % % وكذا الدهر إذا ساف عذم % % 10(@)(@@) % أنا من أبنائه في معشر % يتواصون بإخفار الذمم % PageV01P1673 11(@)(@@) % إن طواني الغيب عن ألحاظهم % % مزقوا عرضي تمزيق الأدم % 12(@)(@@) % لا يلاقوني إلا خائضا % أخطم الأقوال منهم وأزم % 13(@)(@@) % إن تراني مطرقا عن سورة % كقبوع الصل أغضي وأرم % 14(@)(@@) % فهمومي ساعيات جهدها % % ليس كل السعي يوما بالقدم % % 15(@)(@@) % قد يجيب العز من أقعده % % عن طلاب العز خوف وعدم % 16(@)(@@) % ويجيب الطالب المثري وقد % % يدرك الشأو أخو العجز الهرم % 17(@)(@@) % أبقت الأيام مني صعدة % تذبن العاجم عنها إن عجم % % 18(@)(@@) % وإذا زعزعها الدهر سمت % % لدنة تنمى على طول القدم % % 19(@)(@@) % لست للزهراء إن لم ترها % % كوعول الهضب يعجمن اللجم % % 20(@)(@@) % تستجن البيد من فرسانها % % بين بغداد إلى أرض الحرام % % PageV01P1674 21(@)(@@) % بعجاج يملأ الأفق دجى % % وطعان يخضب الأرض بدم % % 22(@)(@@) % شرعا تفتر عن أعناقها % % قلل القور وغيطان الأكم % 23(@)(@@) % كالردى أقدم والغيث همى % % والدجا طبق والسيل هجم % % 24(@)(@@) % حاملات كل غضبان به % من لمام الغيظ مس ولمم % % 25(@)(@@) % كالصقور الغلب ألحاظهم % كالجذى يلمعن من خلف اللثم % 26(@)(@@) % بددوا ما جمع البأس لهم % % بأنابيب العوالي في الكرم % 27(@)(@@) % لست بالعاذر جدي إن 
ms474	 هوى % % وجدودي في العلى أعلى الأمم % 28(@)(@@) % وبناني خلقت أطرافها % % عقبا للرمح ، طورا ، والقلم % 29(@)(@@) % يرى مثلي إلا طالبا % ذروة المنبر أو قعر الرجم % 30(@)(@@) % طامح الرأس على أعواده % % أو على عالية الرمح الأصم % PageV01P1675 31(@)(@@) % خطة : إما علاء ، أو ردى % % معجليأ أقرع السن الندم % % 32(@)(@@) % بن من الناس بعز وعلى % ستساويهم غدا بين الرمم % 33(@)(@@) % هبني الرمح بكفي فارس % بطل أكرهه حتى انحطم % 34(@)(@@) % هبني العضب ذليقا حده % ثلم البيض ضرابا وانثلم % 35(@)(@@) % أتراني دون من رام العلى % % في الليالي منذ عاد وإرم % 36(@)(@@) % ودني ضارع عن أمره % أخذ العرب بتيجان العجم % 37(@)(@@) % كم أب لي جد في إحرازها % % يحرق الناب عليها وابن عم % % 38(@)(@@) % طلبوها فهوى بعضهم % ورمى بعض إليها فغنم % % 39(@)(@@) % صبروا فيها على كل أذى % % ولقوا من دونها كل ألم % % 40(@)(@@) % إن يكن ملك ، فمثلي ناله % أو يكن حتف ، فإني لم ألم % PageV01P1676 41(@)(@@) % إنما يهلك مني ماجد % % يولغ السيف عراقيب النعم % % 42(@)(@@) % ناقص الأموال في بذل الندى % % زائد الخطو إلى ضرب القمم % % 43(@)(@@) % نحن قوم قسم الله لنا % % بالرزايا ورضينا بالقسم % 44(@)(@@) % إنما قصر من آجالنا % % إننا نأنف من موت الهرم % % 45(@)(@@) % نصف عيش المرء حلم ، والذي % % يعقل العاقل منه كالحلم % PageV01P1677 البحر : مجزوء الكامل 1(@)(@@) % تأبى الليالي أن تديما % % بؤسا لخلق أو نعيما % % 2(@)(@@) % ونوائب الأيام يطرق % الورى بيضا وشيما % % 3(@)(@@) % والدهر يوجف فيه معو % الطريق ومستقيما % % 4(@)(@@) % والمرء بالإقبال يبلغ % % وادعا خطرا جسيما % % 5(@)(@@) % وينال بغيته وما % % أنضى الذميل ولا الرسيما % % 6(@)(@@) % وإذا انقضى إقباله % رجع الشفيع له خصيما % % 7(@)(@@) % بينا يسيغ شرابه % % حتى يغص به وجوما % % 8(@)(@@) % وهو الزمان إذا نبا % % سلب الذي أعطى قديما % % 9(@)(@@) % كالريح ترجع عاصفا % من بعد ما بدأت نسيما % % 10(@)(@@) % يستهكم العضب القطو % % ع ويزلق الرمح القويما % % PageV01P1678 11(@)(@@) % ويعود بالرأس الطمو % % ح العين مطراقا أميما % % 12(@)(@@) % كم ذابل قاد الجيا % % د القب يعلكن الشكيما % % 13(@)(@@) % كعواسل الذؤبان يذرعن % % الأماعز والخروما % % 14(@)(@@) % ومجمر للجيش قد % نسيت ضوامره الجموما % % 15(@)(@@) % قلق على 
ms475	 الأنماط ح % تى يدرك الثار المنيما % % 16(@)(@@) % لا يصدر الرايات حتى % % 17(@)(@@) % عصف الحمام به وفرق % % رق ذلك الجمع العميما % % 18(@)(@@) % ورمى به غرض الردى % % عريان قد خلع النعيما % % 19(@)(@@) % زال الوزير وكان لي % % وزرا أجر به الخصوما % % 20(@)(@@) % فالآن أغدو للعدا % % ونبالها غرضا رجيما % % PageV01P1679 21(@)(@@) % سد العلى ، وأنار لا % % فظ القضاء ولا ظلوما % % 22(@)(@@) % حتى ، إذا لم يبق إ % % يلام وأن يليما % % 23(@)(@@) % طرح العناء على اللئا % % م مجانبا ومضى كريما % % 25(@)(@@) % أفنى العدا ، وقضى المنى % % وبنى العلى ، ونجا سليما % % 26(@)(@@) % الحامل العبء الذي % % أعيا المصاعب والقروما % % 27(@)(@@) % سئموه ، فاحتمل المغا % % رم لا ألف ولا سؤما % % 28(@)(@@) % أنقاهم جيبا إذا % % عدوا وأملسهم أديما % % 29(@)(@@) % وجه كأن البدر شا % % طره الضياء أو النجوما % % 30(@)(@@) % لو قابل الليل البهي % % لمزق الليل البهيما % % 31(@)(@@) % يجلو الهموم ورب وجه % % إن بدا جلب الهموما % % PageV01P1680 32(@)(@@) % خلص النجي مشاورا % قلبا على النجوى كتوما % % 33(@)(@@) % ومنبها عزما إذا % % ما هز لم يوجد نؤما % % 34(@)(@@) % % عليه والخل الحميما % % 35(@)(@@) % حتى سما ، فحدا بها % % بزلاء ناجية سعوما % % 36(@)(@@) % كان العظيم وغير بد % % ع منه إن ركب العظيما % % 37(@)(@@) % خطط يجبن المشجع % % أو يسفهن الحليما % % 38(@)(@@) % والحر من حذر الهوا % % ن يزايل الأمر الجسيما % % 39(@)(@@) % ويليح من خوف الأذى % % فرقا ، ويدرع الكلوما % % 40(@)(@@) % والضيم أروح منه مط % الظبى بلغ الصميما % % 41(@)(@@) % بعثوا سواك لها فكا % % ن مبلدا عنها مليما % % PageV01P1681 42(@)(@@) % والعاجز المأفون أقعد % % ما يكون إذا أقيما % % 43(@)(@@) % فسقى بلادك حيث كن % المزن منبعقا هزيما % % 44(@)(@@) % فلقد سقى خدي ذك % دمع عيني السجوما % % 45(@)(@@) % ورعتك عين الله مقلاق % % لاق الركائب ، أو مقيما % % PageV01P1682 البحر : طويل 1(@)(@@) % من الركب ما بين النقا والأناعم % نشاوى من الإدلاج ميل العمائم % % 2(@)(@@) % وجوه كتخطيط الدنانير لاحها % % مع البيد أضباب الهموم اللوازم % % 3(@)(@@) % كأن القطاميات فوق رحالهم % % سوى أنها تأبى دني المطاعم % 4(@)(@@) % على مصغيات للأزمة ساقطت % من الني ما بين الذرى والمناسم % % 5(@)(@@) % ذكرناكم ، والعيس تهوي رقابها % % وأيماننا مبلولة بالقوائم % 6(@)(@@) % فأضعفنا عن حمل 
ms476	 أسيافنا الهوى % % ونقض منا مبرمات العزائم % % 7(@)(@@) % إذا هزنا الشوق اضطربنا لهزه % على شعب الرحل اضطراب الأراقم % 8(@)(@@) % وخفت قلوب من رجال كما هفت % % نزائع طير غدوة بالقوادم % 9(@)(@@) % فمن صبوات تستقيم لمائل % ومن أريحيات تهب بنائم % 10(@)(@@) % وفي الجيرة الغادين كل ممنع % يشير إلينا عن بروق المباسم % PageV01P1683 11(@)(@@) % ويجلو لنا لمع الغمام وبشره % وأين لنا منه بجود الغمائم % % 12(@)(@@) % صفحن إلينا عن خدود أسيلة % دنو العواطي من ظباء الصرائم % 13(@)(@@) % ورفعن أطراف السجوف فصرحت % % عن الوجد أدواء القلوب الكواتم % % 14(@)(@@) % وكيف تراهن العيون ، وإنما % % شغلن المأقي بالدموع السواجم % % 15(@)(@@) % يعاطين إعطاء الذلول طماعة % ويصددن صدات الجياد القوادم % 16(@)(@@) % زودن منا كل قلب ومهجة % % وزودننا للوجد عض الأباهم % 17(@)(@@) % خليلي هل زال الأراك وقد عفت % % مغارز أعناق اللوى والمخارم % 18(@)(@@) % وكيف أعالي الرمل منذ تحدبت % عليها الزباني بالغمام الروائم % 19(@)(@@) % أحب ثرى أرض أقام بجوها % % حبيب إلى قلبي ، وإن لم يلائم % 20(@)(@@) % وأستشرف الأعلام حتى تدلني % % على طيبها مر الرياح الهواجم % PageV01P1684 21(@)(@@) % وما أنسم الأرواح إلا لأنها % % تجوز على تلك الربى والمعالم % 22(@)(@@) % برغمي أنزلت الهوى عند مانع % ودمت على عهد امرىء غير دائم % 23(@)(@@) % كأني أداري مهرة عربية % تحايد عني من مناط الشكائم % 24(@)(@@) % وهذا ، وما ابيض السواد ، فكيف بي % % إذا الشيب أمسى ليلة من عمائمي % % 25(@)(@@) % وكنت أرى أن الشباب وسيلة % لمثلى إلى بيض الخدود النواعم % % 26(@)(@@) % أنا ابن الألى إن ما دعوا يوم معرك % % أمدوا أنابيب القنا بالمعاصم % 27(@)(@@) % من القوم تعلو في المجامع منهم % مناصب أعناق رزان الجماجم % % 28(@)(@@) % مليئون في يوم القضاء إذا انتدوا % % بجدع القضايا من أنوف المظالم % % 29(@)(@@) % وإن منعوا النصف اقتضوه وأفضلوا % % على النصف بالأيدي الطوال الغواشم % 30(@)(@@) % إذا نزلوا بالماحل استنبتوا الربى % % وكانوا نتاجا للبطون العقائم % % PageV01P1685 31(@)(@@) % قروا في حياض المجد واستدرعوا القنا % % إلى نيل أعناق الملوك القماقم % 32(@)(@@) % يسيرون بالمسعاة لا السعي بالخطى % % ويرقون بالعلياء لا بالسلالم % 33(@)(@@) % وما منهم إلا امرؤ شب ناشئا % على نمطي بيضاء من آل هاشم 
ms477	 % 34(@)(@@) % فتى لم توركه الإماء لوم تكن % % أعاريبه مدخولة بالأعاجم % 35(@)(@@) % إذا هم أعطى نفسه كل منية % % وقعقع أبواب الأمور العظائم % % 36(@)(@@) % وما اتخذوا إلا الرماح سرادقا % ولا استنوروا إلا بضوء اللهاذم % % 37(@)(@@) % وما فيهم من يقسم القوم أمره % ولا ضارع ينقاد طوع الخزائم % 38(@)(@@) % ولا واهن إن عضه الأمر هابه % % وألقى مقاليد الذليل المسالم % 39(@)(@@) % يبيت على خور الحشايا وغيره % % على ظهر جماح من الليل عارم % 40(@)(@@) % لنا عفوات الماء من كل منهل % موارد آساد العرين الضراغم % PageV01P1686 41(@)(@@) % أبى العزم إلا وثبة في ظهورها % % إذا أثقلت أعناقها بالمغارم % 42(@)(@@) % عوابس إن قلقن يوما لغاية % % هتمن بنا روق الربى والمخارم % 43(@)(@@) % وكيف أخاف الليل أنى ركبته % وبيني وبين الليل بيض الصوارم % % 44(@)(@@) % وجمع إذا هزوا اللواء تجاوبت % % جوانبه من أزمل وزمازم % 45(@)(@@) % له لغط من اصطكاك رماحه % % تنق عواليها نقيق العلاجم % % 46(@)(@@) % وتحسبه مما تضايق واقفا % وما رد من غرب الجياد الصلادم % 47(@)(@@) % به كل هفاف القميص شمردل % % تفرج عن وجه نقي المقادم % 48(@)(@@) % بطعن كما انعط الأديم أرقه % % تعاور أيدي الخارزات الخوازم % 49(@)(@@) % وتعرف في عرنينه المجد ساهما % على عقب الإدلاج ، أو غير ساهم % 50(@)(@@) % لويت إلى ود العشيرة جانبي % % على عظم داء بيننا متفاقم % PageV01P1687 51(@)(@@) % ونمت عن الأضغان حتى تلاحمت % % جوائف هاتيك الندوب القدائم % 52(@)(@@) % وقلمت أظفاري ، وكنت أعدها % % لتمزيق قربى بيننا والمحارم % % 53(@)(@@) % وروحت حلمي بعدما غربت به % ذنوب بني عمي غروب السوائم % 54(@)(@@) % وأوطأت أقوال الوشاة أخامصي % % وقد كان سمعي مدرجا للنمائم % 55(@)(@@) % وسالمت لما طالت الحرب بيننا % % إذا لم تظفرك الحروب فسالم % % 56(@)(@@) % وقد كنت أصميهم بعور نوافذ % تئن لها الأعراض يوم الخصائم % 57(@)(@@) % صوائب من نبل العداوة لم تزل % تعط قلوبا من وراء الحيازم % % 58(@)(@@) % سيرضون مني عن إياد كوامل % % ومن قبل ما نيلوا بأيد كوالم % % 59(@)(@@) % قضيت بهم حق الحفائظ مدة % % ولا بد أن أقضي حقوق المكارم % 60(@)(@@) % فإن عاودوا رجمي بغيب فإنها % % جنادل عندي ملء كف المراجم % % PageV01P1688 61(@)(@@) % وكم عجموني ، فانسللت مهذبا 
ms478	 % أثر عودي في النيوب العواجم % % 62(@)(@@) % وبي يستسيغ الريق قوم وإنني % % إذا شئت ، من قوم شجا في الحلاقم % 63(@)(@@) % إذا لم يكن إلا الحمام فإنني % % سأكرم سمعي عن مقال اللوائم % % 64(@)(@@) % وألبسها حمراء تضفو ذيولها % % من الدم بعدا عن لباس الملاوم % % 65(@)(@@) % فمن قبل ما اختار ابن الأشعث عيشه % % على شرف باق رفيع الدعائم % % 66(@)(@@) % فطار ذميما قد تقلد عارها % % بشر جناح يوم دير الجماجم % % 67(@)(@@) % وجاءهم يجري البريد برأسه % ولم يغن إيغال به في الهزائم % 68(@)(@@) % وقد حاص من خوف الردى كل حيصة % فلم ينج والأقدار ضربة لازم % % 69(@)(@@) % وهذا يزيد بن المهلب نافرت % به الذل أعراق الجدود الأكارم % 70(@)(@@) % وقال ، وقد عن الفرار أو الردى % % لحى الله أخزى ذكرة في المواسم % PageV01P1689 71(@)(@@) % وما غمرات الموت إلا انغماسة % % ولا ذي المنايا غير تهويم نائم % % 72(@)(@@) % رأى أن هذا السيف أهون محملا % من العار يبقى وسمه في المخاطم % 73(@)(@@) % وما قلد البيض المباتير عنقه % سوى الخوف من تقليدها بالأداهم % 74(@)(@@) % فعاف الدنايا وامتطى الموت شامخا % بمارن عز لا يذل لخاطم % 75(@)(@@) % وقد حلقت خوف الهوان بمصعب % % قوادم أباء كريم المقاوم % 76(@)(@@) % على حين أعطوه الأمان ، فعافه % % وخير فاختار الردى غير نادم % % 77(@)(@@) % وفي خدره غراء من آل طلحة % علاقة قلب للنديم المخالم % 78(@)(@@) % تحسب أيام الحياة ، وإنها % % لأعذب من طعم الخلود لطاعم % % 79(@)(@@) % ففارقها والملك لما رآهما % % يجران إذلال النفوس الكرائم % 80(@)(@@) % ولما ألاح الحوفزان من الردى % % حداه المخازي رمح قيس ابن عاصم % % PageV01P1690 81(@)(@@) % وغادرها شنعاء إن ذكرت له % من العار طاطا رأس خزيان واجم % 82(@)(@@) % لذاك مني بعد الفرار أمية % % بشقشقة لوثاء من آل دارم % 83(@)(@@) % وسل لها سل الحسام ابن معمر % فكر على أعقاب ناب بصارم % 84(@)(@@) % تورد ذكري كل نجد وغائر % % والجم خوفي كل باغ وظالم % 85(@)(@@) % وهدد بي الأعداء في المهد لم يحن % % نهوضي ، ولم أقطع عقود تمائمي % % 86(@)(@@) % وعندي يوم لو يزيد ومسلم % % بدا لهما لاستصغرا يوم واقم % 87(@)(@@) % على العز مت لا ميتة مستكينة 
ms479	 % % تزيل عن الدنيا بشم المراغم % 88(@)(@@) % وخاطر على الجلى خطار ابن حرة % وإن زاحم الأمر العظيم ، فزاحم % PageV01P1691 البحر : رجز تام 1(@)(@@) % تأمل أن تفرح في دار الحزن % % وتوطن المنزل في دار الظعن % 2(@)(@@) % هيهات يأبى لك جوال الردى % % لبث المقيمين وخوان الزمن % % 3(@)(@@) % لا تصحبن دهرك ، إلا خائفا % فراق ألف ونبوا عن وطن % % 4(@)(@@) % وكن إلى نبأة كل حادث % % كالفرس الأروع صرار الأذن % % 5(@)(@@) % قام به الخوف ولم يرض بأن % % قام على أربعة حتى صفن % 6(@)(@@) % خف شرها آمن ما كنت لها % % إن الضنين لمكان للظنن % % 7(@)(@@) % نحن مع الأيام في وقائع % من المقادير وغارات تشن % % 8(@)(@@) % إن رماح الدهر يلقين الفتى % % بغير عرفان الدروع والجنن % % 9(@)(@@) % داخلة بين القرينين ، وإن % لزا على الدهر بإمرار القرن % % 10(@)(@@) % ما استأخرت شداتها عن معشر % % بعد قطين الله ، أو آل قطن % PageV01P1692 11(@)(@@) % ولا نبت أطرافها عن حجر % من مضر ذات القوى ولا اليمن % % 12(@)(@@) % رمت بني ساسان عن مربعهم % رمي المغالي أمن الطير الثكن % % 13(@)(@@) % واستلبت تاج بني محرق % % بعد قياد الصعب من آل يزن % 14(@)(@@) % وصدعت غمدان عن مرضومة % جوبك بالمقراض أثواب الردن % 15(@)(@@) % وآل مروان غطاهم موجها % % لما نزت بآل مراوان البطن % % 16(@)(@@) % ثم بنو القرم العتيكي ، وقد % ردوا يزيد العار مخلوع الرسن % 17(@)(@@) % لاقى خبيب ويزيد روقها % % من غيبة ماطرها القنا اللدن % % 18(@)(@@) % أبوا إباء البزل فاقتادتهم % من المقادير مطاعات الشطن % % 19(@)(@@) % ألا ذكرت ، إن طلبت أسوة % ما يضمن الأسوة للقلب الضمن % 20(@)(@@) % يوم بني الصمة في عرض اللوى % % ويوم بسطام بن قيس بالحسن % PageV01P1693 21(@)(@@) % ويوم خو أسلمت عتيبة % % خصاصة الدرع الذي كان أمن % 22(@)(@@) % أوجره رمح ذؤاب طعنة % تلغط لغط الأعجمي لم يبن % 23(@)(@@) % وبالكديد ملتقى ربيعة % تحمي بعيد الموت آبار الظعن % 24(@)(@@) % كأنني لم تبك قبلي فارسا % عين ، ولا حن فتى قبلي وأن % 25(@)(@@) % هل كان كل الناس إلا هكذا % % ذو شجن باك لباك ذو شجن % % 26(@)(@@) % سائل بقومي لم نبا الدهر بهم % % عن غير ضغن ورماهم عن 
ms480	 شزن % % 27(@)(@@) % لم راشهم ريش السهام للعدا % % ثم براهم بالردى بري السفن % 28(@)(@@) % وكيف أمسوا حفنات من ثرى % % من بعد ما كانوا رعانا وقنن % 29(@)(@@) % سوم السفا طاحت به في مرها % % زفازف الريح وبوغاء الدمن % % 30(@)(@@) % هم أجلسوا على الصفاح والذرى % % إذ رضي القوم بما تحت الثفن % PageV01P1694 31(@)(@@) % لهم على الناس ، وما زال لهم % مشارف الرأس على جمع البدن % % 32(@)(@@) % عما عم لما تزل أسيافهم % % عمائم الصيد وأقياد البدن % % 33(@)(@@) % بالقدم الأولى إلى شأو العلى % % والأذرع الطولى إلى عقد المنن % % 34(@)(@@) % كيف أماني للمرامي بعدهم % % من نوب الدهر ، وقد زال المجن % 35(@)(@@) % الداخلين البيت باباه القنا % % على الخناذيذ الطوال والحصن % % 36(@)(@@) % والفالقين الصبح عن مغيرة % % لها من النقع ظلام مرجحن % 37(@)(@@) % والضاربين الهام في مشعلة % لها بلا نار ضرام ودخن % % 38(@)(@@) % كم فاض في أبياتهم منتجع % يقرن بالنعمى وقرن في قرن % 39(@)(@@) % إذا تنادوا للقاء فيلق % % تداولوا الأعناق من أسر ومن % 40(@)(@@) % ما درنت أعراضهم من الخنا % % ولا انجلت أسيافهم من الدرن % % PageV01P1695 41(@)(@@) % كل عظيم منهم معجب % % تأذن أبواب الغنى إذا أذن % 42(@)(@@) % ذو نسب تستخجل الشمس به % أصفى على السائغ من ماء المزن % 43(@)(@@) % له القدور الضامنات للقرى % % مبارك البزل الجرار بالعطن % 44(@)(@@) % من كل دهماء لها هماهم % % تلقم البازل جمعا كالفدن % % 45(@)(@@) % إن العشار لا تقي من سيفه % دماءها عام الجدوب باللبن % % 46(@)(@@) % أما ترى هذا الصفيح المجتلى % % يدرجنا درج الرميل الممتهن % 47(@)(@@) % كأنما الناس به من ذاهب % % وواهب يجري على ذاك السنن % 48(@)(@@) % مزبورة تطوى على أشطارها % % يبطن باديها ويبدو ما بطن % % 49(@)(@@) % ما أعجب الناس الذي نسكنه % يجمع ما بين الوهاد والقنن % % 50(@)(@@) % بين عظامي ملك وسوقة % % لم يدر ما العز ونام ويفن % % PageV01P1696 51(@)(@@) % لو علم الناظر يوما ما هما % % أفظعه الخطب ، وقال : من ومن % 52(@)(@@) % أقسمت لا أنساهم ما طلعت % % حمراء من خدر ظلام ودجن % % 53(@)(@@) % أما بكاء بالدموع ما جرت % % أو بالفؤاد إن أبى الدمع وضن % % 54(@)(@@) % أنكرت أفراح الزمان بعدهم % من طول بلواي 