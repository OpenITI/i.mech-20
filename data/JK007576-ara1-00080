ms61	 تندى % % 13(@)(@@) % تجمعت الأحزان في عقر داره % % وفرقت الأزمان عن بابه الوفدا % % 14(@)(@@) % وسد عن العافين مهيعهم إلى % % مكارم كانت من أنامله تسدى % % 15(@)(@@) % فقل لبني أخفق سعيكم % % فقد حسر البحر الذي لكم مدا % % 16(@)(@@) % وكم من ظباء بعدما غار عزه % حوائم في الآفاق تلتقط الوردا % % 17(@)(@@) % لتبك عليا همة كرمية % ثنى قاصدوا الركبان عن ربعها القصدا % % 18(@)(@@) % وملتحف بالأثر أصبح عاريا % من الفخر يوم الضرب إذ لبس الغمدا % % 19(@)(@@) % وأسمر خطي أمام كعوبه % % سنان ذليق ينفذ الحلق السردا % % 20(@)(@@) % وحصداء فولاذية النسج لم تزل % من اللهذم الوقاد مطفئة وقدا % % PageV01P218 21(@)(@@) % وأجرد يبكي الجرد يوم صهيله % % غدا مرجلا عنه فلم يسد الجردا % % 22(@)(@@) % وداع دعا للمعضلات ابن أحمد % فلين في كفيه منهن ما اشتدا % % 23(@)(@@) % وناهيك في الإعظام من ماجد به % % على الزمن العادي على الناس يستعدى % % 24(@)(@@) % حياة تعم الأولياء هنيئة % وموت زؤام في مقارعة الأعدا % % 25(@)(@@) % وقسورة الحرب الذي يرجع القنا % % رواعف تكسو الأرض من علق وردا % % 26(@)(@@) % وفي بنصح الملك ما ذم رأيه % ولا حل ذو كيد لإبرامه عقدا % % 27(@)(@@) % وما يستطير الحلم في حلمه ولا % % يجاوز هزل في سجيته الجدا % % 28(@)(@@) % إذا علم بالنار أعلم رأسه % رأيت عليا منه في ليلة أهدى % % 29(@)(@@) % ألا فجعت أبناء فهر بأروع % % إذا انتسبوا عدوا له الحسب العدا % % 30(@)(@@) % فلا قابل هجرا ، ولا مضمر أذى ، % ولا مخلف وعدا ، ولا مانع رفدا % % PageV01P219 31(@)(@@) % إذا ما عدا مع قرح السبق فاتها % % وجاء بفضل الشد ينتهب المعدى % % 32(@)(@@) % وما قصر الله المدى إذ جرى به % % ولا مد فيه للسوابق فامتدا % % 33(@)(@@) % ولكن حدود العتق تجري بسابق % فلا طلق إلا أعد له حدا % % 34(@)(@@) % نماه من الأشراف أهل مفاخر % يديرون في الأفواه ألسنة لدا % % 35(@)(@@) % إذا وقف الأبطال عن غمرة الردى % % مشى بأسهم نحو الحتوف بهم أسدا % % 36(@)(@@) % وتحسبهم قد سربلوا من عيابهم % سيوفا ، وسلوا من سيوفهم الهندا % % 37(@)(@@) % فما عد أهل الرأي والبأس والندى % % وإن كثروا إلا ووفى بهم عدا % % 38(@)(@@) % إذا جمعت 
ms62	 هذي السجايا لأوحد % فما الحق إلا أن يراه الورى فردا % % 39(@)(@@) % فما ظنكم في وصفنا بمملك % % يكون علي ذو المعالي له عبدا % % 40(@)(@@) % عزيز علينا أن بكته كرائم % تذيب قلوبا في مدامعها وجدا % % PageV01P220 41(@)(@@) % ينحن مع الأشجار نوح حمائم % تهز بها الأحزان أغصانها الملدا % % 42(@)(@@) % وكم في مديمات الأسى من خبيئة % مع الصون أبقى الدمع في خدها خدا % % 43(@)(@@) % فلو رد من كف المنية هالك % بنوح بنات كان أول من ردا % % 44(@)(@@) % مضى بمضاء السيف جرب حده % % فأبفي في أفعاله جاوز الحدا % % 45(@)(@@) % وما مات مبقي أحمد ومحمد % فإنهما سدا المكان الذي سدا % % 46(@)(@@) % بنى لهما مجدين يحيى بعزة % وإن كان مجد واحد لهما هدا % % 47(@)(@@) % بدا منهما حزم يسير تمامه % وقد يثقب النار الذي يقدح الزندا % % 48(@)(@@) % ومن لحظته عين يحيى برفعة % فقد ركب الأيام واستخدم السعدا % % 49(@)(@@) % فيا ساكن القبر الذي ضم تربه % شهيدا كأن الموت كان له شهدا % % 50(@)(@@) % لئن فاح طيب من ثراه لناشق % ففخرك فيه فتق المسك والندا % % PageV01P221 51(@)(@@) % وقيت جلال الخطب ، ما جل خطبه ، % وقمت كريم النفس من دونه سدا % % 52(@)(@@) % ورحت ببعض الروح فيك مودعا % بمؤنسة العواد زرت بها اللحدا % % 53(@)(@@) % رثيتك حزنا بالقوافي التي بها % % مدحتك ودا ، فاعتقدت لي الودا % % 54(@)(@@) % وما المدح إلا كالثوي نسامع % ولكن بذكر الموت عاد له ضدا % % 55(@)(@@) % ودنياك كالحرباء ذات تلون % ومبيضها في العين أصبح مسودا % % 56(@)(@@) % أردنا لك الدنيا القليل بقاؤها % % وربك في الأخرى أراد لك الخلدا % % 57(@)(@@) % فلا برحت ، من رحمة الله دائبا % تزور ندى كفيك ، في قبرك الأندا % % PageV01P222 البحر : بسيط تام 1(@)(@@) % لا تخرج الشيء عن شيء يوافقه % واقصد بأمرك في التدبير مقصده % 2(@)(@@) % فالدمن فيه لنبت الأرض مصلحة % ولو خلطت به الكافور أفسده % PageV01P223 البحر : كامل تام 1(@)(@@) % إني لأبسط للقبول إذا سرت % خدي وألقاها بتقبيل اليد % % 2(@)(@@) % وأضم أحنائي على أنفاسها % % كيما تبرد حر قلب مكمد % % 3(@)(@@) % مسحت كراقية علي بكفها % % ونقابها ند من الزهر الندي % % 4(@)(@@) % وعرفت في الأرواح مسراها كما 
ms63	 % % عرف المريض طبيبه في العود % % 5(@)(@@) % ما لي أطيل عن الديار تغربا % أفبالتغرب كان طالع مولدي % % 6(@)(@@) % أبدا أبدد بالنوى عزمي إلى % % أمل بأطراف البلاد مبدد % 7(@)(@@) % كم من فلاة جبتها بنجيبة % عن منسم دام وخطم مزبد % % 8(@)(@@) % أبقى الجزيل لها جميل ثنائه % % في العيس موصولا بقطع الفدفد % % 9(@)(@@) % ضربت مع الأعناق أعناق الفلا % % بحسام ماء في حشاها مغمد % PageV01P224 البحر : متقارب تام 1(@)(@@) % وجدت النوى إذ فقدت الشباب % فيا ليتني لم أكن فاقده % 2(@)(@@) % فصرت أحاول صيد الحسان % وأتعب فيه بلا فائده % 3(@)(@@) % وحال أثافيك مختلة % إذا ما عدمت لها واحده % PageV01P225 البحر : بسيط تام 1(@)(@@) % جلا محياك عن أبصارنا الرمدا % % وقرب الله من مرآك ما بعدا % % 2(@)(@@) % وجاء يحمل منك الطرف أربعة : % البدر والطود والدأماء والأسدا % % 3(@)(@@) % تكاد تبذل عين المرء أسودها % % في نظرة منك تنفي الهم والكمدا % % 4(@)(@@) % كل مسر بوجه في أسرته % % نور إذا ما رماه أكبر سجدا % % 5(@)(@@) % ظباك بالرد عن دين الهدى انفردت % % وأنت ما زلت بالإنعام منفردا % % 6(@)(@@) % ليث تخال سيوفا في براثنه % % وتحسب الزعف منه الشعر واللبدا % % 7(@)(@@) % كأن أجفانه في الحرب قد وردت % % مع الدماء من الهندي ما وردا % % 8(@)(@@) % لشدة البأس في يمناه ، ضربته % % إن أسكر السيف منها بالنجيع شدا % % 9(@)(@@) % وللرديني يوم الطعن عالية % تلوك بين حشا الضرغامة الكبدا % % 10(@)(@@) % فالدين معتمد منه على ملك % % يمسي ويضحي على الرحمن معتمدا % % PageV01P226 11(@)(@@) % كأن شهب رجوم في أسنته % % يردي بها من طغاة الكفر من وردا % % 12(@)(@@) % وكلما عقد الرايات معتزما % حلجت أياديه من آرائه عقدا % % 13(@)(@@) % شهم صبور إذا ما القرم زاحمه % % مزاحما في كفاح ظنه أحدا % % 14(@)(@@) % وقرح بكماة الروع مقدمة % كأنهن سعال تحمل الأسدا % % 15(@)(@@) % إذا تبين سماء عن عجاجتها % % كانت لهم سهريات القنا عمدا % % 16(@)(@@) % من كل ذمر من الفولاذ غاص به % % يجمد القر منه فوقه زبدا % % 17(@)(@@) % يسطو بعضب إذا ما هز مضربه % يوم الضراب لعيني ساهد رقدا % % 18(@)(@@) % لا يشرب الروح من جثمان ذي زرد % حتى يرى الحد 
ms64	 منه يأكل الزردا % % 19(@)(@@) % أسلت سيل نجيع من عداك بهم % % في الأرض منهم فغادرت الثرى عمدا % % 20(@)(@@) % يا من عليه مدار المكرمات ومن % بعدله كل مضطر له سندا % % PageV01P227 21(@)(@@) % طارت إليك بنو الآمال وانتشقت % % من ذكرك الند واستشفين منك يدا % % 22(@)(@@) % فما انحرفت براج عن بلوغ منى % ولا تركت لصاد بالعطاء صدا % % 23(@)(@@) % لا نأي لي بتنائي السير عن بلدي % % فقد رضيت بحمص بعده بلدا % % 24(@)(@@) % بدلت من معشري الأدنين معشرها % % لا فرق الله فيما بيننا أبدا % % 25(@)(@@) % وكم حوى الترب دوني من ذوي رحمي % % وما مقلت لبعدي منهم أحدا % % 26(@)(@@) % ولم يسرني من مثواك موت أبي % % وقد يقلقل موت الوالد الولدا % % 27(@)(@@) % وما سددت سبيلي عن لقائهم % لكن جعلت صفادي عنهم الصفدا % % 28(@)(@@) % وحسن بر إذا فاضت حلاوته % على فؤادي من حر الأسى بردا % % PageV01P228 البحر : كامل تام 1(@)(@@) % الآن أفرخ روع كل مهيد % وأعز دين محمد بمحمد % 2(@)(@@) % إن كان نصرالله فتح بابه % فأبوك بادر قرعه بمهند % 3(@)(@@) % واقتاد حزب الله نحو عدوه % % فالحرب تجدع معطس المتمرد % % 4(@)(@@) % في جحفل يعلو عليه قتامه % كبخار أخضر بالعواصف مزبد % % 5(@)(@@) % صدمت جفون الفنش منه بمفعم % بالأسد في غيل القنا المتأود % % 6(@)(@@) % وكأنما احتطب العلوج وساقهم % % بحريق ضرب بالصوارم موقد % % 7(@)(@@) % صدعت كتائبه الظبا حتى إذا % % همت به أعطى فذال معرد % 8(@)(@@) % في ليلة لبست لتستر شخصه % عنا فلم تلحظه عين الفرقد % % 9(@)(@@) % أمسى يكذب مائنا في ظلمة % خفرته فهي لديه بيضاء اليد % % 10(@)(@@) % ولى ، يحاكي البرق لمع مجرد % والرعد في حذر تحمحم أجرد % PageV01P229 11(@)(@@) % يعدو الجواد به على فرسانه % % صرعى كأنهم نشاوى مرقد % 12(@)(@@) % من كل ذي سكرين من خمر ومن % % حد لذي فتك عليه معربد % % 13(@)(@@) % تبنى الصوامع من رؤوسهم بها % % كانت على هدم الصوامع تغتدي % % 14(@)(@@) % والحرب من بيض الذكور كأنما % % باضت بهن رقائد في الفدفد % % PageV01P230 البحر : طويل 1(@)(@@) % بكى فقدك العز المؤيد والمجد % % وناحت عليك الحرف والضمر الجرد % % 2(@)(@@) % وقد ندبتك البيض والسمر في الوغى % % وعددك التأييد والحسب 
ms65	 العد % 3(@)(@@) % وما فقدت إلا عظيما وفقده % به بين أحشاء العلى يوجد الوجد % % 4(@)(@@) % وكنت أمين الملك حقا وسيفه % ومن حسنات البر كان لك الغمد % % 5(@)(@@) % وأنت ابن حمدون الذي كان حمده % % يعبر عن ناديه في عرفه الند % 6(@)(@@) % همام إليه كان تقريب غربتي % % ببزل خفيف بين أخفافها الوخد % 7(@)(@@) % بأرض فلاة تنكر الأسد وحشها % % ويرتد في اللحظ العيون بها الرمد % % 8(@)(@@) % وناجية تنجو بهم همومهم % % تولى بها جسمها اللحم والجلد % % 9(@)(@@) % قتلت الأماني من علي ولم أزل % مفدى لديه ، حيث يعذب لي الورد % % 10(@)(@@) % بكيت عليه والدموع سواكب % تخدد من طول البكاء بها الخد % % PageV01P231 11(@)(@@) % وذاك قليل قدره في معظم % له حسب ما إن يعد له عد % 12(@)(@@) % فلو صح في الدنيا الخلود لماجد % لأبقي فيها ثم صح له الخلد % % 13(@)(@@) % ومختلف الطعمين من طبع عادل % فطعم له سم وطعم له شهد % % 14(@)(@@) % وقد كان في عليائه مترفعا % يلين به الدهر الذي كان يشتد % % 15(@)(@@) % وكان أبيا ذا أياد غمامنها % % ندى ماجد في قبره قبر المجد % % 16(@)(@@) % وحل الردى من كفه عقد راية % ومن كف ميمون لها جدد العقد % % 17(@)(@@) % وما هو إلا حازم ذو كفاية % % يناقض هزل الروع من بأسه الجد % 18(@)(@@) % تقدم من صنهاجة كل مقدم % فريسته من قرنه أسد ورد % % 19(@)(@@) % بأيديهم نور البنفسج في ظبا % ينور من نار ، لها حطب الهند % % 20(@)(@@) % وقد لبسوا من نسج داود أعينا % مداخلة خوصا هي الحلق السرد % % PageV01P232 21(@)(@@) % يسدون خلات الحروب إذا طمت % بشوك الردى حتى كأنهم السد % % 22(@)(@@) % ويقتادهم منه شهامة قائد % به جملة الجيش العرمرم تعتد % % 23(@)(@@) % جواد عميم الجود ، بيت عطائه % % لقاصده بالنيل طيبه القصد % % 24(@)(@@) % له همة في أفقها فرقدية % % كواكبها زهر أحاط بها السعد % % 25(@)(@@) % وأثبت للعلياء منهم قواعدا % % لأعدائه منها قواعد تنهد % % 26(@)(@@) % أرى يمن ميمون تعاظم في العلى % % بنيل معال لا يحد لها حد % 27(@)(@@) % وهمة يحيى شرفته بخلة % بها يسعف المولى ويبتهج العبد % % 28(@)(@@) % كأن نضارا ذائبا عم جسمها % % وإن رام 
ms66	 حسنا في العيون له حمد % % 29(@)(@@) % وما مطرف إلا أبي بحرمة % عباب خضم حل عن حسره المد % % 30(@)(@@) % إذا أعمل الآراء عن له الهدى % % سداد هو الفتح الذي ما له سد % % PageV01P233 31(@)(@@) % يروح ويغدو في المنى ، وحسوده % بعيد رشاد ، لا يروح ولا يغدو % % 32(@)(@@) % ومن حيث ما ساورته خفت بأسه % وللنار من حيث انثنيت لها وقد % % 33(@)(@@) % وإن جاد كان الجود منه مهنأ % كغيث همى ، ما فيه برق ولا رعد % 34(@)(@@) % ولله في الإجلال ذكر محمد % بكل لسان في الثناء له حمد % % 35(@)(@@) % هم السادة الأمجاد والقادة الألى % % تعد المعالي منهم كلما عدوا % % 36(@)(@@) % ويأمرهم بالصبر والحزم خاذل % لهم صبر . . . . . ووجدانه فقد % 37(@)(@@) % وأي اصطبار فيه للنفس رحمة % عن القائد الأعلى الذي ضمه اللحد % PageV01P234 البحر : كامل أحذ 1(@)(@@) % بأبي منطقة القوام مشت % كالغصن ، بين الحقف ، والقمر % % 2(@)(@@) % لمياء تنطق عن مؤشرة % ختم العقيق بها على الدرر % % 3(@)(@@) % كيف السلو وسحر مقلتها % % قيد الحياة ومقود النظر % % PageV01P235 البحر : بسيط تام 1(@)(@@) % كم تعجب الناس من صيد ولا شرك % يصيد رئم به قلبي سوى نظري % % 2(@)(@@) % وكم يقولون : مجنون ، وما علموا % % أن الجنون الذي بي من هوى بشر % % 3(@)(@@) % لا عذب الله من أجلي معذبة % تشرد النوم عن عيني بالسهر % % 4(@)(@@) % يبيت في ثغرها برد الشباب كما % % بات الندى من أقاحي الروض في زهر % % 5(@)(@@) % يا ليتني ، والأماني ربما بلغت % نقعت حرج غليلي منه في الخصر % % PageV01P236 البحر : طويل 1(@)(@@) % وسامية الألحاظ للصيد قربت % وقد نام عنا الليل وانتبه الفجر % 2(@)(@@) % بكرنا على أكتادها ندري بها % % طرائد معمورا بها البلد القفر % % 3(@)(@@) % تسائل عنها السحب والترب جرأة % % جوارح فوق الراح أعينها خزر % % 4(@)(@@) % فوارس أفد أقبلت في جواشن % من الرقم ، لم تخلق لها البيض والسمر % % 5(@)(@@) % وغضف ترى آذانهن لواحظا % بهن صرور ، وهي من هبوة غبر % 6(@)(@@) % ومرو علا عند النتاج حديدة % نتائجها منه إذا وضعت شقر % 7(@)(@@) % هفا بيننا منها جناح بويزة % كقادمة العصفور طار بها الذعر % % 8(@)(@@) % أقام عليها موقد كير سحره 
ms67	 % ليصلى لها حرا ، وقد ثلج الصدر % % 9(@)(@@) % رددنا بها روحا على شلو أورق % يبلبله ريح ويضربه قطر % 10(@)(@@) % أقامت أثافيه من الدهر برهة % عواري لم تركب رواحلها قدر % % PageV01P237 11(@)(@@) % ولما تلظى جمرها وتجدلت % وقصت بأيدينا ذوائبها الحمر % % PageV01P238 البحر : مجزوء الكامل 1(@)(@@) % شوقي إليك مجدد % يبلي جديد تصبري % % 2(@)(@@) % وجوانحي يجنحن من % حرق الهوى المتعسر % 3(@)(@@) % نقلت من الدرر الدموع % إلى العقيق الأحمر % % 4(@)(@@) % ولبست فيه من الضنى % % عرضا يلازم جوهري % % 5(@)(@@) % كحل الهوى والسحر من % % ك جفون رئم أحور % 6(@)(@@) % فجوارحي مجروحة % منها بسيف مضمر % % 7(@)(@@) % كم ذا يغيرني هوا % % ك بخلقك المتغير % % 8(@)(@@) % نقضت حلاوة موردي % % منه مرارة مصدري % % 9(@)(@@) % ومنعتني من لثم فيك % % جنى الرضاب المسكر % % 10(@)(@@) % أبجنة الفردوس أحرم % شرب ماء الكوثر % PageV01P239 البحر : متقارب تام 1(@)(@@) % وناهدة تربت كفها % % ترائبها بسحيق العبير % 2(@)(@@) % تصون على القطف رمانة % من النهد في غصن بان نضير % % 3(@)(@@) % لها وجنة صقلت بالنعيم % وناظرة كحلت بالفتور % 4(@)(@@) % وتبسم عن أقحوان تريك % على نوره الشمس إشراق نور % % 5(@)(@@) % كأن غدائرها المرسلات % أساود سابحة في غدير % 6(@)(@@) % فبت ألاطف أخلاقها % % كما رمت تأنيس ظبي نفور % % 7(@)(@@) % وما قهوة صفقت للصبوح % % بمسك ذكي وشهد مشور % % 8(@)(@@) % بأطيب من فمها ريقة % إذا برد الدر فوق النحور % PageV01P240 البحر : كامل أحذ 1(@)(@@) % لله در عصابة نزلوا % % بين الرياض مجالسا خضرا % % 2(@)(@@) % شربوا بكاسات معتقة % شربت عقولهم بها سكرا % % 3(@)(@@) % وكأنما الأقمار تلثم من % % أيدي السقاة كواكبا زهرا % % 4(@)(@@) % وكأنما صور القنان وقد % % ملئت إلى لهواتها خمرا % % 5(@)(@@) % بيض الحسان وقفن في عرس % لما لبسن غلائلا حمرا % % PageV01P241 البحر : متقارب تام 1(@)(@@) % قضت في الصبا النفس أوطارها % % وأبلغها الشيب إنذارها % % 2(@)(@@) % نعم وأجيلت قداح الهوى % % عليها فتقسمن أعشارها % % 3(@)(@@) % وما غرس الدهر في تربة % غراسا ولم يجن أثمارها % % 4(@)(@@) % فأفنيت في الحرب آلاتها % % وأعددت للسلم أوزارها % % 5(@)(@@) % كميتا لها مرح بالفتى % % إذا حث باللهو أدوارها % % 6(@)(@@) % تناولها الكوب من دنها % % فتحسبه كان مضمارها % % 7(@)(@@) % وساقية زررت كفها % % على عنق الظبي 
ms68	 أزرارها % % 8(@)(@@) % تدير بياقوتة درة % فتغمس في مائها نارها % % 9(@)(@@) % وفتيان صدق كزهر النجوم % % كرام النحائز أحرارها % % 10(@)(@@) % يديرون راحا تفيض الكؤوس % % على ظلم الليل أنوارها % % PageV01P242 11(@)(@@) % كأن لها من نسيج الحباب % % شباكا تعقل أطيارها % % 12(@)(@@) % وراهبة أغلقت دبرها % % فكنا مع الليل زوارها % % 13(@)(@@) % هدانا إليها شذا قهوة % تذيع لأنفك أسرارها % % 14(@)(@@) % فما فاز بالمسك إلا فتى % تيمم دارين أو دارها % % 15(@)(@@) % كأن نوافجه عندها % % دنان مضمنة قارها % % 16(@)(@@) % طرحت بميزانها درهمي % % فأجرت من الدن دينارها % % 17(@)(@@) % خطبنا بنات لها أربعا % ليفترع اللهو أبكارها % % 18(@)(@@) % من اللائي أعصار زهر النجوم % % تكاد تطاول أعمارها % % 19(@)(@@) % تريك عرائسها أيديا % طوالا تصافح أخصارها % % 20(@)(@@) % تفرس في شمه طيبها % % مجيد الفراسة فاختارها % % PageV01P243 21(@)(@@) % فتى دارس الخمر حتى درى % % عصير الخمور وأعصارها % % 22(@)(@@) % يعد لما شئت من قهوة % سنيها ويعرف خمارها % % 23(@)(@@) % وعدنا إلى هالة أطلعت % على قضب البان أقمارها % % 24(@)(@@) % يرى ملك اللهو فيها الهموم % تثور فيقتل ثوارها % % 25(@)(@@) % وقد سكنت حركات الأسى % % قيان تحرك أوتارها % % 26(@)(@@) % فهذي تعانق لي عودها % % وتلك تقبل مزمارها % % 27(@)(@@) % وراقصة لقطت رجلها % % حساب يد نقرت طارها % % 28(@)(@@) % وقضب من الشمع مصفرة % تريك من النار نوارها % % 29(@)(@@) % كأن لها عمدا صففت % وقد وزن العدل أقطارها % % 30(@)(@@) % تقل الدياجي على هامها % % وتهتك بالنور أستارها % % PageV01P244 31(@)(@@) % كأنا نسلط آجالها % % عليها فتمحق أعمارها % % 32(@)(@@) % ذكرت صقلية والأسى % % يهيج للنفس تذكارها % % 33(@)(@@) % ومنزلة للتصابي خلت % وكان بنو الظرف عمارها % % 34(@)(@@) % فإن كنت أخرجت من جنة % فإني أحدث أخبارها % % 35(@)(@@) % ولولا ملوحة ماء البكا % % حسبت دموعي أنهارها % % 36(@)(@@) % ضحكت ابن عشرين من صبوة % بكيت ابن ستين أوزارها % % 37(@)(@@) % فلا تعظمن لديك الذنوب % % فما زال ربك غفارها % % PageV01P245 البحر : متقارب تام 1(@)(@@) % وصفراء كالشمس تبدو لنا % % من الكأس في هالة مستديره % % 2(@)(@@) % يلاعبها الماء في مزجها % % فيضحكها عن نجوم منيره % 3(@)(@@) % إذا جار هم الفتى واعتدى % % رأيت بها نفسه مستجيره % % 4(@)(@@) % فتروي صداه ، وتدني مناه % % وتردي أساه ، وتحيي سروره % 5(@)(@@) % زجاج وخمر وماء كما % % تقول هيولى 
ms69	 ونفس وصوره % 6(@)(@@) % أطر عنك نعومك وانظر إلى % % نهار أفاض على الليل نوره % % 7(@)(@@) % كأن دجى الليل لما استرق % نموم من الصبح يفشي سريره % % 8(@)(@@) % شربنا على وجه بدر السماء % % ونسقي على وجه شمس الظهيره % 9(@)(@@) % بفواحة النور ، مكاؤها % % يرجع في كل غصن صفيره % % 10(@)(@@) % مرت فوقها حلب المعصرات % % رياح لكل سحاب مثيره % % PageV01P246 11(@)(@@) % كأن الفرزدق في طيرها % % يجيب على كل شعر جريره % 12(@)(@@) % قصرنا بها طول ليل التمام % بعيش هنيء عدمنا نظيره % % 13(@)(@@) % كأن الكؤوس بأيدي السقاة % % خيول على الهم منا مغيره % % 14(@)(@@) % وطيب النعيم له ساعة % تعد ، وإن هي طالت ، قصيره % PageV01P247 البحر : خفيف تام 1(@)(@@) % غشيت حجرها دموعي حمرا % % وهي من لوعة الهوى تتحدر % 2(@)(@@) % فانزوت بالشهيق خوفا وظنت % حب رمان صدرها قد تنثر % % 3(@)(@@) % قلت عند اختبارها بيديها % % ثمرا صانهن جيب مزرر % % 4(@)(@@) % لم يكن ما ظننت حقا ولكن % % PageV01P248 البحر : طويل 1(@)(@@) % ونيلوفر أوراقه مستديرة % تفتح فيما بينهن له زهر % 2(@)(@@) % كما اعترضت التراس وبينها % % عوامل أرماح أسنتها حمر % % 3(@)(@@) % هو ابن بلادي كاغترابي اغترابه % كلانا عن الأوطان أزعجه الدهر % PageV01P249 البحر : طويل 1(@)(@@) % ومطرد الأجزاء يصقل متنه % صبا أعلنت للعين ما في ضميره % 2(@)(@@) % جريح بأطراف الحصى كلما جرى % % عليها شكا أوجاعه بخريره % % 3(@)(@@) % كأن حبابا ريع تحت حبابه % % فأقبل يلقي نفسه في غديره % % 4(@)(@@) % شربنا على خافاته دور سكرة % % وأقتل سكرا منه لحظ مديره % % 5(@)(@@) % كأن الدجى خط المجرة بيننا % % وقد كللت حافاته ببدوره % % 6(@)(@@) % وقد لاح نجم الصبح حتى كأنه % % مطرق جيش مؤدن بأميره % % 7(@)(@@) % كلفت بكاسات الصبوح مبكرا % % وكم بركات للفتى في بكوره % % 8(@)(@@) % هو العيش فاغنم من زمانك صفوه % وصد قنص اللذات قبل مثيره % % PageV01P250 البحر : طويل 1(@)(@@) % وزرقاء في لون السماء تنبهت % % لتحبيكها ريح تهب مع الفجر % 2(@)(@@) % يشق حشاها جدول متكفل % بسقي ألبست حلل الزهر % % 3(@)(@@) % كما طعن المقدام في الحرب دارعا % بغضب فشق الخصر منه إلى الخصر % % 4(@)(@@) % يريك رؤوسا منه في جسم حية % سعت من حياة في حدائقه الخضر % % 5 
ms70	(@)(@@) % فلا روضة إلا استعارت لشكره % % لسان صبا تسري مطيبة النشر % % PageV01P251 البحر : بسيط تام 1(@)(@@) % ورب صبح رقبناه وقد طلعت % بقية البدر في أولى بشائره % 2(@)(@@) % كأنما أدهم الظلماء حين نجا % % من أشهب الصبح ألقى نعل حافره % PageV01P252 البحر : طويل 1(@)(@@) % نظرت إلى حسن الرياض ، وغيمها % % جرى دمعه منهن في أعين الزهر % 2(@)(@@) % فلم تر عيني بينهما كشقائق % تبلبلها الأرواح في القضب الخضر % % 3(@)(@@) % كما مشطت غيد القيان شعورها % % وقامت لرقص في غلائلها الحمر % % PageV01P253 البحر : طويل 1(@)(@@) % وساقية تسقي الندامى بمدها % % كؤوسا من الصهباء طاغية السكر % % 2(@)(@@) % يعوم فيها كل جام كأنما % % تضمن روح الشمس في جسد البدر % % 3(@)(@@) % إذا قصدت منا نديما زجاجة % % تناولها رفقا بأنمله العشر % % 4(@)(@@) % فيشرب منها سكرة عنبية % تنوم عين الصحو منه وما يدري % % 5(@)(@@) % ويرسلها في مائها فيعيدها % % إلى راحتي ساق على حكمه تجري % % 6(@)(@@) % جعلنا على شرب العقار سماعنا % % لحونا تغنيها الطيور بلا شعر % % 7(@)(@@) % وساقينا ماء ينيل بلا يد % ومشروبنا نارا تضيء بلا جمر % % 8(@)(@@) % سقانا مسرات فكان جزاؤه % % عليها لدينا أن سقيناه للبحر % % 9(@)(@@) % كأنا على شط الخليج مدائن % % تسافر فيما بيننا سفن الخمر % % 10(@)(@@) % وما العيش إلا في تطرف لذة % وخلع عذار فيه مستحسن العذر % % PageV01P254 البحر : كامل تام 1(@)(@@) % في كنه قدرك للعقول تحير % فلذاك عنه النيرات تقصر % % 2(@)(@@) % والواصفون علاك منا قربوا % % ما ترجموا للناس عنه وعبروا % % 3(@)(@@) % ألقيت عزمك بين عيني ضيغم % وأبات طيفك كل شيء يذعر % % 4(@)(@@) % ورحلت في جون القتام عرمرم % وكأنه ليل بوجهك مقمر % % 5(@)(@@) % ولئن قدمت وفي اعتقادك عودة % فالبحر من عظم يمد ويجزر % % 6(@)(@@) % والفتح من فضل الإله ، ويومه % متقدم بالنصر أو متأخر % % 7(@)(@@) % لولا اقتراب الوقت عن قدر لما % % فتحت على حال لأحمد خيبر % % 8(@)(@@) % وفوارس يحمر من ضرب الطلا % % بأكفهم ورق الحديد الأخضر % % 9(@)(@@) % لا غش جبن فيهم فكأنهم % % سبكوا بنيران الحروب وسجروا % % 10(@)(@@) % ومن الرجال مروع ومشجع % % ومن السيوف مؤنث ومذكر % % PageV01P255 11(@)(@@) % ألفت قلوبهم الخضوع لربهم % % والأس في أسيافهم متكبر % % 12(@)(@@) % يرمون 
ms71	 أغراض الحتوف بأنفس % ووجوهها لعيونهم تتنمر % % 13(@)(@@) % وتغور في هام العلوج جداول % للضرب من أغمادهم تتفجر % % 14(@)(@@) % من كل وحشي الطباع كأنه % % بين القنا الخطي ليث مخدر % % 15(@)(@@) % متقدم من صبره ، ولثامه % يوم القراع أضاته والمغفر % % 16(@)(@@) % صبحت جيوشهم جيوشا يا لها % % من أبحر زخرت عليها أبحر % % 17(@)(@@) % ويل لحصن ليبط من يوم على % % جنباته يجري النجيع الأحمر % % 18(@)(@@) % والروع تثقل بالردى ساعاته % وتخف بالأبطال فيه الضمر % % 19(@)(@@) % يثنى النهار به على أعقابه % % حتى كأن الشمس فيه تكور % % 20(@)(@@) % والنقع فيه دجنة لا تنجلي % % والصبح منه ملاءة لا تنشر % % PageV01P256 21(@)(@@) % ولقد شددت على خناق علوجهم % % وأدار رأيك فيهم مستبصر % % 22(@)(@@) % واستعصموا بذرى أشم كأنهم % % عصم أتيح لها هزبر قسور % % 23(@)(@@) % قلوا لديك غنيمة فكأنما % % أبقتهم الأيام فيه ليكثروا % % 24(@)(@@) % ولقلما يبقى رمادهم إذا % % طارت به في الجو ريح صرصر % 25(@)(@@) % قام الدليل ، وما الدليل بكاذب % أن النصارى يخذلون وتنصر % 26(@)(@@) % سكنت في الآفاق من حركاتهم % % والنبض من خور الطبيعة يفتر % 27(@)(@@) % هلا أطاق الكفر جر قناته % % لما تركت كعوبها تتكسر % % 28(@)(@@) % يوم العروبة ، والعراب لواعب % تكبو على هام العلوج وتعثر % % 29(@)(@@) % والفنش يحصب ناظريه وقلبه % بقوارع الأحزان يوم معور % 30(@)(@@) % ركب الغواية واستبد برأيه % % جهلا ليعبر خضرما لا يعبر % % PageV01P257 31(@)(@@) % خذ في عزائمك التي تركتهم % % خبرا مع الأيام لا يتغير % % 32(@)(@@) % بالخيل تحت الليل يسرج حولها % % في كل ذابلة سنان أزهر % % 33(@)(@@) % وتلوك من فقد القضيم شكائما % تنهى بها أفواههن وتؤمر % % 34(@)(@@) % عركت أديم الأرض تحت حوافر % صخر البلاد بوطئهن مسخر % % 35(@)(@@) % حتى تغنيهم ظباك من الردى % % نغما ، وتسقيهم كؤوسا تسكر % % 36(@)(@@) % جاهدت في الرحمن حق جهاده % % وجرى الملوك كما جريت فقصروا % % 37(@)(@@) % فيبيت ناجود وعود حولهم % % ويبيت حولك شزب وسنور % % 38(@)(@@) % وتفوح غالية بهم وذريرة % وهما دم في برديتك وعثير % % 39(@)(@@) % أعطتك ريحان الثناء حديقة % ظمئت ولكن قلما تستمطر % % 40(@)(@@) % وأنا العليم بأن طولك شامل % وذراك رحراح وجودك كوثر % PageV01P258 البحر : رمل تام 1(@)(@@) % حبذا فتيان صدق أعرسوا % % بعذارى من 
ms72	 سلافات الخمور % 2(@)(@@) % عربد الصحو عليهم بالأسى % % فاتقاه السكر عنهم بالسرور % % 3(@)(@@) % عمروا ربع الصبا من قبل أن % يتمشى فيه بالشيب دثور % % 4(@)(@@) % إن للأعمار أعجازا إذا % % بلغت لم تثن منهن صدور % % 5(@)(@@) % كل نافي العمر ، في شرته % للصبا نار ، وفي الوجنة نور % % 6(@)(@@) % يقتنون العيش من قانية % ذات عمر كثرت فيها الدهور % % 7(@)(@@) % أطلع الساقي عشاء منهم % أنجم الكاسات في أيدي البدور % % 8(@)(@@) % عد بالأكواب عني إن لي % % في يد الآنس عنهن نفور % % 9(@)(@@) % غمر الشيب الدجى من لمتي % % بنجوم طلع ليست تغور % % 10(@)(@@) % لا نشور لشبابي بعد ما % % مات من عمري إلى يوم النشور % % PageV01P259 11(@)(@@) % وخضاب الشيب لا أقبله % % إنه في شعري شاهد زور % % 12(@)(@@) % أنا من وجدي بأيام الصبا % % أذرف الدمع رواحا وبكور % % 13(@)(@@) % فكأني ذو غليل تلتظي % % لوعة منه إلى ماء الثغور % % 14(@)(@@) % أصف الراح ولا أشربها % % وهي بالشدو على الشرب تدور % % 15(@)(@@) % كالذي يأمر بالكر ولا % % يصطلي نار الوغى حيث تفور % % 16(@)(@@) % فسواء بين إخوان الصفا % % وذوي اللهو ، مغيبي والحضور % % 17(@)(@@) % أنا من كسب ذنوبي وجل % وإن استغفرت فالله غفور % % PageV01P260 البحر : خفيف تام 1(@)(@@) % يا قليل الوفاء ضاع وداد % أنت ضيعته بكثرة غدرك % 2(@)(@@) % أنا أشكو صبابة لذعتني % % برد الله حر نحري بنحرك % % 3(@)(@@) % وجنى لي ، فإن قلبي عليل ، % منا اشتهى من جني رمان صدرك % % 4(@)(@@) % وتداويت من خماري بخمر % نابعات بها جواهر ثغرك % 5(@)(@@) % هذه كلها أماني وصال % حيل بيني وبينهن بهجرك % % PageV01P261 البحر : كامل أحذ 1(@)(@@) % هن الحسان وحربها الهجر % % فلذاك يجبن عندها الذمر % 2(@)(@@) % أصليت تلك الحرب تجربة % أن أنت عن فتكاتها غمر % 3(@)(@@) % من كل ناشئة ، إذا اتصلت % % من عمرها بالأربع العشر % 4(@)(@@) % وكم اشتهى منها عليل هوى % % ثمرا بهن تفلك الصدر % % 5(@)(@@) % خلقي مطية وهما % % سهل يدير عنانه وعر % 6(@)(@@) % يا ظبية إن مرضت نظرا % فلكل قسورة به قسر % % 7(@)(@@) % كرب هواك وما له فرج % ومتى يفارق لذعه الجمر % 8(@)(@@) % حتى الأراكة منك ظالمة % درا بفيك ، أيظلم الدر ؟ % 9(@)(@@) % وكأن برقا 
ms73	 في تبسمه % % وكأنما دمعي له قطر % % 10(@)(@@) % أشكو خمارا ما شربت له % % خمرا بفيك ، فريقك الخمر % % PageV01P262 11(@)(@@) % ويهيج بي وجع وعلته % سقم بطرفك ، إن ذا سحر % % 12(@)(@@) % وأرى الذي تجدين فيك له % % نفعا فمنه مسني الضر % 13(@)(@@) % من وجهك الحسن اقتنى ملحا % فكأنها في وجهه بشر % % 14(@)(@@) % ليست تنال الشمس منزلة % منها ، فكيف ينالها البدر ؟ % 15(@)(@@) % وأارك قد حاولت نقل خطى % فقصرتها وعلا بك البهر % % 16(@)(@@) % وعذرت منك الخصر مرحمة % ولحمل ردفك يعذر الخصر % % 17(@)(@@) % عذلت على دنف أخا مقة % لا يستقل ببعضها الصبر % % 18(@)(@@) % فرثت لذلته وربتما % % لان الصفا وتواضع الكبر % % 19(@)(@@) % بعثت لواحظها بعطفتها % % سرا إليه فليتها جهر % % 20(@)(@@) % قتلته وهي تريد عشته % ذنب ، بعيشك ، ذاك أم أجر % PageV01P263 البحر : بسيط تام 1(@)(@@) % أشكو إلى الله ما قاسيت من رمد % مواصل كرب آصالي بأسحاري % % 2(@)(@@) % كأن حشو جفوني عند سورته % % جيش من النمل في جنح الدجى ساري % % 3(@)(@@) % كأنه للقذى والدمع في وحل % فخلعه أرجلا منه بإضرار % % 4(@)(@@) % كأن أوجاع قلبي من مطاعنة % بالشوك ما بين أشفاري وأشفاري % % 5(@)(@@) % كأنما لجة في العين زاخرة % ترمي سواحل جفنيها بعوار % % 6(@)(@@) % تفجر الماء منها كلما وضعت % لهجعة منهما نارا على نار % % 7(@)(@@) % كم ليلة بت صفرا من كراي بها % % ومن مخيلة صبح ذات إسفار % 8(@)(@@) % إذ بات جفني رضيع ابني يقاسمه % لبان أسحم يغدوه بمقدار % % 9(@)(@@) % في حلقة من ظلام لا ترى طرفا % يبدو بها من سنا صبح لأبصار % % 10(@)(@@) % كأنما الشرق دهقان يرى غبنا % في دفعه منهما الكافور بالقار % % PageV01P264 11(@)(@@) % كأنما الشمس قد ردت إلى فلك % % على الخلائق ثبت غير دوار % 12(@)(@@) % كأنما الليل ذو جهل فليس يرى % % في درهم البدر منها أخذ دينار % % 13(@)(@@) % يشكو لجفني جفني مثل علته % كالضيم يقسم بين الجار والجار % % 14(@)(@@) % فالحمد لله مجري النور من غسق % وجاعل الليل في تلطيف أحجار % 15(@)(@@) % كم أبعد الناس في أمر ظنونهم % فكان دائي قريب البرء بالباري % % PageV01P265 البحر : بسيط تام 1(@)(@@) % وجدول جامد في الكف تحمله % يغوص فيه 
ms74	 على در النهى النظر % 2(@)(@@) % يكسو السطور ضياء عند ظلمتها % % كأن ينبوع نور منه ينفجر % % 3(@)(@@) % يشف للعين عن خط الكتاب كما % % شف الهواء ، ولكن جسمه حجر % 4(@)(@@) % يبدي الحروف بجرح نالها عرق % % فيه ، وقر عليها جامدا نهر % 5(@)(@@) % كحلت عيني إذ كلت بجوهره % % أما يحد بكحل الجوهر البصر ؟ % 6(@)(@@) % كأنه ذهن ذي حذق يفك به % % من المعمى عويصا فكه عسر % 7(@)(@@) % نعم المعين لشيخ كل ناظره % وصغر الخط في ألحاظه الكبر % % 8(@)(@@) % يرى به صور الأسطار قد عظمت % كعنصل الماء فيه يعظم الوبر % % PageV01P266 البحر : خفيف تام 1(@)(@@) % زن بديع الكلام وزنا محرر % مثل ما يوزن النضار المشجر % 2(@)(@@) % وتكلم بما يزينك في الحف % % ل وتقنى به علاء ومفخر % 3(@)(@@) % إن حسن الثناء بعدك يبقى % % لك بالذكر منه عيش مكرر % 4(@)(@@) % روح معناك جسمه منك لفظ % وعلى كل صورة يتصور % % 5(@)(@@) % فإذا ما مقال غيرك أضحى % % عرضا فليكن مقالك جوهر % % PageV01P267 البحر : بسيط تام 1(@)(@@) % لم نؤت ليلتنا الغراء من قصر % لولا وصال ذوات الدل والخفر % % 2(@)(@@) % السافرات شموسا كلما انتقبت % تبرجت مشبهات الأنجم الزهر % 3(@)(@@) % من كل حوراء لم تخذل لواحظها % % في الفتك مذ نصرتها فتكة النظر % % 4(@)(@@) % أو كل لمياء لو جادت بريق فم % نقعت حر غليلي منه في الخصر % % 5(@)(@@) % محسودة الحسن لا تنفك في شغف % منها بصبح صقيل الليل في الشعر % % 6(@)(@@) % لا تأمنن الردى من سيف مقلتها % % فإنه عرض في جوهر الحور % 7(@)(@@) % إني امرؤ لا أرى خلع العذار على % % من لا يقوم عليه في الهوى عذري % % 8(@)(@@) % فما فتنت بردف غير مرتدف % ولا جننت بخصر غير مختصر % 9(@)(@@) % وشربة من دم العنقود لو عدمت % لم تلف عيشا له صفو بلا كدر % % 10(@)(@@) % إذا أدير سناها في الدجى غمست % دهم الحنادس في التحجيل والغرر % PageV01P268 11(@)(@@) % تزداد ضعفا قواها بلغت % بها الليالي حدود الضعف والكبر % % 12(@)(@@) % لا يسمع الأنف من نجوى تأرجها % % إلا دعاوي بين الطيب والزهر % % 13(@)(@@) % إذا النديم حساها خلت جريتها % % نجما تصوب حتى غار 
ms75	 في قمر % 14(@)(@@) % تصافح الراح من كاساتها شعل % ترمي مخافة لمس الماء بالشرر % 15(@)(@@) % تعلو كراسي أيدينا عرائسها % % تجلى عليهن بين الناي والوتر % % 16(@)(@@) % حتى تمزق ستر الليل عن فلق % تقلص العرمض الطامي على النهر % % 17(@)(@@) % والصبح يرفع كفا من لاقطة % ما للدراري على الآفاق من درر % 18(@)(@@) % عيش خلعت على عمري تنعمه % % ليت الليالي لم تخلعه عن عمري % % 19(@)(@@) % ولى وما كنت أدري ما حقيقته % % كأنما كان ظل طائر الحذر % % 20(@)(@@) % بالله يا سمرات الحي هل هجعت % في ظل أغصانك الغزلان عن سهري % % PageV01P269 21(@)(@@) % وهل يراجع وكرا فيك مغترب % عزت جناحيه أشراك من القدر % % 22(@)(@@) % ففيك قلبي ولو أسطيع من وله % طارت إليك بجسمي لمحة البصر % % 23(@)(@@) % قولي لمنزلة الشوق التي نقلت % عنها الليالي إلى دار النوى أثري % % 24(@)(@@) % نلت المنى بابن عباد فقيدني % % عن البدور التي لي فيك بالبدر % % 25(@)(@@) % حطت إليه حداة العيس أرحلنا % % فالعزم صفر بمثواه من السفر % % 26(@)(@@) % كان ابتدائي إليه عاطلا فغدا % % منه بحلي الأماني حالي الخبر % 27(@)(@@) % مملك قصر أعمار العداة به % % وقع السيوف على الهامات والقصر % % 28(@)(@@) % عدل السياسة لا يرضى له سيرا % إلا بما أنزل الرحمن في السور % % 29(@)(@@) % يسدي بيمناه من معروفه مننا % تكسو الصنائع صنعانية الحبر % 30(@)(@@) % لو أضحت الأرض يوما كف سائله % لم تفتقر بعد جواه إلى مطر % % PageV01P270 31(@)(@@) % يأوي إلى عزة قعساء مرغمة % أنف الزمان على ما فيه من أشر % % 32(@)(@@) % لا يفلت الجري من أيدي عزائمه % % أو يجعل الهام أجفان الظبا البتر % % 33(@)(@@) % جار له شأو آباء غطارفة % أسد على الخيل أقمار على السرر % % 34(@)(@@) % لا تستلين المنايا عجم عودهم % والنبع ليس بمنسوب إلى الخور % % 35(@)(@@) % يقطب الموت خوفا من لقائهم % % ويضحك الثغر منهم عن سنا ثغر % % 36(@)(@@) % يا مروي الرمح والأرماح ظامئة % من الأسود الضواري بالدم الهدر % % 37(@)(@@) % لولا تعشقك الهيجاء ما ركبت % بك العزيمة فيها صهوة الخطر % % 38(@)(@@) % إذا التظت شعل الأرماح وانغمست % % من الدروع على الأرواح في غدر % 39(@)(@@) % وفي اصطبارك فيها والردى 
ms76	 جزع % % ما دل أنك عنها غير مصطبر % % 40(@)(@@) % ومأزق مزقت بيض السيوف به % % ما لا يرقعه الآسون بالإبر % % PageV01P271 41(@)(@@) % من جحفل ضمن الفتح المبين له % % ذل الأعادي بعز النصر والظفر % % 42(@)(@@) % تحدو عذابك فيه للوغى عذب % تهفو كأيدي الثكالى طشن من حرر % % 43(@)(@@) % جاءت صدور العوالي فيه حاقدة % يفتر منها دخان النقع عن شرر % % 44(@)(@@) % فكم قلوب لها جاشت مراجلها % % لما تساقط جمر الطعن في النقر % % 45(@)(@@) % كأنما كل أرض من نجيعهم % رخو الأسنة منها ميت الشعر % % 46(@)(@@) % وخائض في عباب الموت منصلت % مقارع الأسد بين البيض والسمر % 47(@)(@@) % خلقت بالضرب منه في القذال فما % % أنطقت فيه لسان الصارم الذكر % % 48(@)(@@) % يا معليا بعلاه كل منخفض % ومغنيا بنداه كل مفتقر % % 49(@)(@@) % هل كان جودك في الأموال مقتفيا % آثار بأسك في أسد الوغى الهصر % % 50(@)(@@) % نادى نداك بني الآمال فازدحموا % % بالواخدات على الروحات والبكر % % PageV01P272 51(@)(@@) % كما دعا الروض إذ فاحت نواسمه % رواده بنسيم النور في السحر % % 52(@)(@@) % يهدي لك البحر مما فيه معظمه % والبحر لا شك فيه معدن الدرر % % 53(@)(@@) % إنا لنخجل في الانشاد بين يدي % % رب القوافي التي حلين بالفقر % % 54(@)(@@) % من ملك الله حسن القول مقوله % فلو رآه ابن حجر عاد كالحجر % % PageV01P273 البحر : كامل تام 1(@)(@@) % هجر الخيال فزرته بالخاطر % % ولقد يكون ، زمان هجرك ، زائري % % 2(@)(@@) % أسددت مسراه فلم يطق السرى % % أم بات عندك نائما عن ساهر % % 3(@)(@@) % طعمت مصافحتي له إذ زرته % % فقبضت من ظل الخيال النافر % % 4(@)(@@) % إني اقتنعت بزورة زورية % ألفيت باطنها خلاف الظاهر % % 5(@)(@@) % وإذا أردت بأن تصور للمنى % % صورا فسلمها لفكرة شاعر % % 6(@)(@@) % يا من لها بالسحر طرف قاتل % أسمعت بالفتيا التي في الساحر % % 7(@)(@@) % إني نظرت فلم أجد لك فتكة % إلا بحد حسام لحظ فاتر % % 8(@)(@@) % أثبت حبك في فؤاد خافق % أوما عجبت لواقع في طائر % % PageV01P274 البحر : كامل تام 1(@)(@@) % وأشم من بيت الرئاسة أكبر % ينمى إلى شم الأنوف أكابر % 2(@)(@@) % يردي المدجج ، وهو غير مدجج % كم دارع أرداه رمح الحاسر % 3(@)(@@) % ويشب 
ms77	 نيران الحروب بمرهف % كصبيب ماء في الجماجم غائر % % 4(@)(@@) % في جحفل يغشى الوقائع زاحفا % بسماء أجنحة وأرض حوافر % 5(@)(@@) % وعجاجة كسحابة ملتفة % فوق الرؤوس على بروق بواتر % % 6(@)(@@) % ضحكت تقهقه والكماة عوابس % بالضرب فوق قوانس ومغافر % % 7(@)(@@) % وكأن جرد الخيل تحت حماتها % % عقبان جو جنح بقساور % % 8(@)(@@) % والسابغات إلى الكماة حبائك % كحباب ماء أو نثير غدائر % % 9(@)(@@) % وكأن أطراف السيوف نواجذ % يحرقن في شدق الحمام الكاشر % % 10(@)(@@) % ما قست نجدته بحدة محرب % إلا قضيت له بفضل قاهر % % PageV01P275 11(@)(@@) % إن الشجاعة في الحماة وإنها % % لأشد منها في الأبي الصابر % 12(@)(@@) % فتخاف أذمار الكريهة فتكه % خوف البغاث من العقاب الكاسر % % 13(@)(@@) % بسنان أسمر للحيازم ناظم % وغرار أبيض للجماجم ناثر % 14(@)(@@) % تبدو من المنصور فيه شمائل % تلك السجايا من سجايا الناصر % % 15(@)(@@) % إن الفروع على الأصول شواهد % تقضي بطيب مناقب وعناصر % 16(@)(@@) % من كل أروع من ذؤابة حمير % ناه بألسنة القواضب آمر % % PageV01P276 البحر : بسيط تام 1(@)(@@) % أضحت أيادي يديه وهي تؤنسه % إذ أوحشته معاليه من النظرا % % 2(@)(@@) % مؤيد بمضاء الرأي يحمده % % لا يحمد السيف إلا ماضيا ذكرا % % 3(@)(@@) % يمضي الأمور بآراء مسددة % كأنهن سهام تقصد الثغرا % % 4(@)(@@) % من العوارف آلاف مجددة % للناس في كل معلما دثرا % % 5(@)(@@) % لو كان ينظم حبا في مدائحه % % حب القلوب نظمناها له فقرا % % 6(@)(@@) % . . . ردت زمان الجهل همته % وغيرت فيه من عاداتها الغيرا % % 7(@)(@@) % يا من أياديه في الأنعام - لاعقلت % أطلقن بالمدح فيه ألسن الشعرا % % 8(@)(@@) % دم في جلالة قدر بالعلى قرنت % وحالف السعد فيما تأمل القدرا % % PageV01P277 البحر : بسيط تام 1(@)(@@) % أيا رشاقة غصن البان ما هصرك % ويا تألف نظم الشمل من نثرك ؟ % 2(@)(@@) % ويا شؤوني ، وشأني كله حزن % فضي يواقيت دمعي واحبسي دررك % 3(@)(@@) % ما خلت قلبي وتبريحي يقلبه % إلا جناح قطاة في اعتقال شرك % 4(@)(@@) % لا صبر عنك وكيف الصبر عنك وقد % % طواك عن عيني الموج الذي نشرك % 5(@)(@@) % هلا ، وروضة ذاك الحسن ناضرة ، % لا تلحظ العين فيها ذابلا زهرك % % 6(@)(@@) % أماتك البحر ذو التيار من 
ms78	 حسد % لما درى الدر منه حاسدا ثغرك % 7(@)(@@) % وقعت في الدمع إذ أغرقت في لجج % قد كاد يغمرني منه الذي غمرك % % 8(@)(@@) % أي الثلاثة أبكى فقده بدم % عميم خلقك أم معناك أم صغرك % 9(@)(@@) % من أين يقبح أن أفنى عليك أسى % % والحسن في كل فن يقتفي أثرك % 10(@)(@@) % كنت الشبيبة إذ ولت ولا عوض % منها ولو ربح الدنيا الذي خسرك % PageV01P278 11(@)(@@) % ما كنت عنك مطيلا بالهوى سفري % % وقد أطلت لحيني في البلى سفرك % % 12(@)(@@) % هل واصلي منك إلا طيف ميتة % تهدي لعيني من ذاك السكون حرك % % 13(@)(@@) % أعانق القبر شوقا وهو مشتمل % عليك لو كنت فيه عالما خبرك % 14(@)(@@) % وددت يا نور عيني لو وقى بصري % % جنادلا وترابا لاصقا بشرك % % 15(@)(@@) % أقول للبحر إذ أغشيته نظري % % ما كدر العيش إلا شربها كدرك % 16(@)(@@) % هلا كففت أجاجا منك عن أشر % من ثغر لمياء لولا ضعفها أسرك % 17(@)(@@) % هلا نظرت إلى تفتير مقلتها % % إني لأعجب منه كيف ما سحرك % % 18(@)(@@) % يا وجه جوهرة المحجوب عن بصري % % من ذا يقيك كسوفا قد علا قمرك % % 19(@)(@@) % يا جسمها كيف أخلو من جوى حزني % % وأنت خال من الروح الذي عمرك % % 20(@)(@@) % ليلي أطالك بالأحزان معقبة % علي من كان بالأفراح قد قصرك % % PageV01P279 21(@)(@@) % ما أغفل النائم المرموس في جدث % عما يلاقي من التبريح من سهرك % % 22(@)(@@) % يا دولة الوصل إن وليت عن بصري % % فالقلب يقرأ في صحف الأسى سمرك % % 23(@)(@@) % لئن وجدتك عني غير نابية % فإن نفسي منها ربها فطرك % % 24(@)(@@) % إن كان أسلمك المضطر عن قدر % فلم يخنك على حال ولا غدرك % % 25(@)(@@) % هل كان إلا غريقا رافعا يده % نهاه عن شرب كاس من بها أمرك % % 26(@)(@@) % وارحمتا لولوع بالبكاء فما % % ينسيه ذكر . . . . . . . . . . . . . . . % 27(@)(@@) % أما عداك حمام عن زيارته % % فكيف أطمع فيك النفس وانتظرك % % 28(@)(@@) % إن كان للدمع في أرجاء وجنته % % تبرج فهو يبكي بالأسى خفرك % 29(@)(@@) % وما نجوت بنفسي عنك راغبة % وإنما مد عمري قاصر عمرك % PageV01P280 البحر : طويل 1(@)(@@) % تغنت قيان الورق في الورق 
ms79	 الخضر % ففجر ينابيع المدام مع الفجر % % 2(@)(@@) % وخذ من فتاة الغيد راحا سبيئة % لها قدم في السبق من قدم العمر % % 3(@)(@@) % ولا تشربن في كبوة الكوب بالفتى % % كذلك يجري في مدى السكر من يجري % % 4(@)(@@) % وإن الندى ما زال يدعو رياضه % % إليها الندامى وهي في حلل الزهر % % 5(@)(@@) % فتجلوهم أيدي السقاة عرائسا % ترى الدر أزرارا لأثوابها الحمر % % 6(@)(@@) % وتحسب إبريق الزجاجة مغزلا % يشوف في الارضاع منه إلى غفر % 7(@)(@@) % ومشمولة في كأسها اشتملت على % % نجوم سرور بين شرابها تسري % % 8(@)(@@) % تريك إذا ما الماء لاوذ صرفها % % تواثب نمل في زجاجاتها شقر % % 9(@)(@@) % يفر الأسى عن كل عضو تحله % فرار الجبان القلب عن مركز الذمر % % 10(@)(@@) % وأشمط خضنا نحوه الليل بالسرى % % وقد خاط منه النوم شفرا على شفر % % PageV01P281 11(@)(@@) % له بيعة ما زال فيها محللا % حرام الربا في بيعه التبر بالتبر % % 12(@)(@@) % بسطنا له الآمال عند انقباضه % لأخذ عجوز من بنيانه بكر % % 13(@)(@@) % معتقة حمراء تنشر فضلها % % لخطابها في اللون والطعم والنشر % % 14(@)(@@) % إذا شمها أعطاك جملة وصفها % % ففي أنفه علم الفراسة بالخمر % % 15(@)(@@) % لها قسوة من قبله مستملة % لعنف نداماها كذا قسوة الكفر % % 16(@)(@@) % ولله ما ينساغ منها لشربها % % بتسهيل خلق الماء من خلقها الوعر % % 17(@)(@@) % وقد عقدت أيمانه العذر دونها % % فحل ندى أيماننا عقد العذر % % 18(@)(@@) % وأبرز منها في الزجاجة جوهرا % نسائله بالشم عن عرض السكر % % 19(@)(@@) % تميع منها كالنضار مشجرا % % وإن كان في رياه كالعنبر الشحري % % 20(@)(@@) % أدرنا شعاع الشمس منها بأنجم % نبادرها مملوءة من يد البدر % % PageV01P282 21(@)(@@) % على حين شابت لمة الليل بالسنا % % ونفر عنا نومنا العود بالنقر % % 22(@)(@@) % كأن الثريا في انقضاض أفولها % % وشاح من الظلماء حل عن الخصر % % 23(@)(@@) % كأن انهزام الليل بعد اقتحامه % % تموج بحر ناقض المد بالجزر % % 24(@)(@@) % كأن عصا موسى النبي بضربها % % تريك من الأظلام منفلق البحر % 25(@)(@@) % كأن عمود الصبح يبدي ضياؤه % % لعينيك ما في وجه يحيى من البشر % % 26(@)(@@) % رحيب ذرى المعروف مستهدف الندى % % تندى الأماني في حدائقه الخضر % % 27 
ms80	(@)(@@) % تحلب من يمناه ثجاجة الندى % % وتنبت من ذكراه ريحانة الفخر % % 28(@)(@@) % له سيرة في ملكه عمرية % وكف من الإعدام جابرة الكسر % % 29(@)(@@) % بعيد كذات الشمس دان كنورها % % وإن لم تنل ما نال من شرف القدر % 30(@)(@@) % تكفكف عنه سورة اللحظ هيبة % فلله منها ما تصور في الفكر % PageV01P283 31(@)(@@) % كأن الزمان الرحب من ذكره فم % ونحن لسان فيه ينطق بالشكر % % 32(@)(@@) % تعود منه المال بالجود بذلة % لإيسار ذي عسر وإغناء ذي فقر % % 33(@)(@@) % فإن أنت لم تنفقه أنفق نفسه % وصار إلى ما كان تدري ولم تدر % % 34(@)(@@) % كأن عطاياه وهن بداية % بحور وإن كانت مكاثرة القطر % % 35(@)(@@) % همام إذا ما هم أمضى عزائما % بواتر للأعمار بالقضب البتر % % 36(@)(@@) % وصير في إقحامه مهج العدى % % تسيل على مذلوقة الأسل السمر % % 37(@)(@@) % ينوب مناب السيف في الروع ذكره % % فما ذكر ماض يسيل من الذكر % % 38(@)(@@) % ويختط بالخطي أرض كريهة % يجرر فيها ذيل جحفله المجر % % 39(@)(@@) % ومقتحم الأبطال يبرق بالردى % % وتخفق في آفاقه عذب النصر % % 40(@)(@@) % محلقة في الجو منه قشاعم % كأن شرارا حشو أعينها الخزر % % PageV01P284 41(@)(@@) % تروح بطانا من لحوم عداته % % فما لقتيل خر في الأرض من قبر % % 42(@)(@@) % ويثني عن الضرب الوجيع سيوفه % من الدم حمرا في عجاجاته الكدر % 43(@)(@@) % وكم ردها مفلولة حد صبره % % إذا جزع الهيجاء فل شبا الصبر % % 44(@)(@@) % فلا تأمن الأعداء إملاء حلمه % بتأخير نزع السهم يصدع في الصخر % % 45(@)(@@) % إذا لبد الليث الغضنفر فارتقب % % له وثبة فراسة الناب والظفر % % 46(@)(@@) % ورب شرار للعيون مواقع % تحرك للإحراق عن ساكن الجمر % % 47(@)(@@) % فيا ابن تميم والعلى مستجيبة % لكل امرىء ناداك يا ملك العصر % % 48(@)(@@) % ومن ماله بالجود يسرح في الورى % % طليقا ، وكم مال من البخل في أسر % % 49(@)(@@) % حللنا بمغناك الذي ينبت الغنى % % ويجري حياة اليسر في ميت العسر % % 50(@)(@@) % وكم عزمة خضنا بها هول لجة % كصارمك الماضي ، ونائللك الغمر % % PageV01P285 51(@)(@@) % وجدنا المنى والأمن بعد شدائد % % تقلب أفلاذ القلوب من الذعر % % 52(@)(@@) % فمدحك في الإحسان أطلق مقولي % % وعندك أفني ما 