ms6441	 فبها ونعمت وقبل الله عذرها وأفلج حجتها ولا إثم عليها ، وإن هو أبى يرضى ؟ ؟ عنها فقد أبلغت عند الله عذرها .(@)(@@) % ( طب ، ك ، ق - عن معاذ ) .(@)(@@) 45118 - لا تصفن المرأة لزوجها المرأة كأنه ينظر إليها .(@)(@@) % ( طب عن ابن مسعود ) .(@)(@@) 45119 - لا تسأل المرأة طلاق أختيها لتكتفيء ما في صفحتها فإنما رزقها على الله عز وجل .(@)(@@) % ( طب - عن أم سلمة ) .(@)(@@) 45120 - ألا ! اختضبي ، تترك إحداكن الخضاب حتى تكون يدها كيد الرجل .(@)(@@) % ( حم - عن امرأة ) .(@)(@@) 45121 - ما على إحداكن أن تغير أظفارها وتعضد يدها ولو بسير ( السير : القد . النهاية 2 / 433 . ب . السير : الذي يعد من الجلد . وجمعه سيور . الصحاح 325 . ب ) .(@)(@@) % ( ابن سعد - عن بثينة بنت حنظلة عن أمها سنان الأسلمية ) .(@)(@@) | 1 ( الفصل الثاني في ترغيبات تختص بالنساء ) 1(@)(@@) 45122 - أما ترضى إحداكن أنها إذا كانت حاملا من زوجها وهو عنها راض أن لها مثل أجر الصائم القائم في سبيل الله ، وإذا أصابها الطلق لم يعلم أهل السماء والأرض ما أخفي لها من قرة أعين فإذا وضعت لم يخرج من لبنها جرعة ولم يمص من ثديها مصة إلا كان لها بكل جرعة وبكل مصة حسنة ، فإن أسهرها ليلة كان لها مثل أجر سبعين رقبة تعتقهم في سبيل الله سلامة ، أتدرين من أعني بهذا ! المتنعمات الصالحات المطيعات لأزواجهن اللاتي لا يكفرن العشير .(@)(@@) % ( الحسن بن سفيان ، طس ، وابن عساكر - عن سلامة حاضنة السيد إبراهيم ) .(@)(@@) PageV16P168(@)(@@) 45123 - إذا أنفقت المرأة من بيت زوجها غير مفسدة كان لها أجرها بما أنفقت ، ولزوجها أجره بما اكتسب ، وللخازن مثل ذلك ، لا ينقص بعضهم من أجر بعض شيئا .(@)(@@) % ( ق ، ( أخرجه مسلم كتاب الزكاة رقم 81 . ص ) 4 - عن عائشة ) .(@)(@@) 45124 - إذا أنفقت المرأة من بيت زوجها عن غير أمره فلها نصف أجره .(@)(@@) % ( ق ، د - عن أبي هريرة ) .(@)(@@) 45125 - إذا صلت المرأة خمسها وصامت شهرها ، وحفظت فرجها وأطاعت زوجها دخلت الجنة .(@)(@@) % ( البزار - عن أنس عن عبد الرحمن بن عوف ؛ طب - عن عبد الرحمن بن حسنة ) .(@)(@@) 45126 - إذا صلت المرأة خمسها ، وصامت 
ms6442	 شهرها ، وحصنت فرجها ، وأطاعت زوجها ، قيل لها : ادخلي الجنة من أي أبواب الجنة شئت .(@)(@@) % ( حب - عن أبي هريرة ) .(@)(@@) 45127 - جهادكن الحج .(@)(@@) % ( خ - ( أخرجه البخاري كتاب الجهاد باب جهاد النساء 4 / 39 . ص ) عن عائشة ) .(@)(@@) 45128 - ليس على النساء غزو ولا جمعة ولا تشييع جنازة .(@)(@@) % ( ط ، ص - عن أبي قتادة ) .(@)(@@) 45129 - هذه ثم ظهور الحصر .(@)(@@) % ( حم - 5 / 218 عن أبي واقد ) .(@)(@@) 45130 - إن الله يحب المرأة الملقة البزعة ( البزعة : البزيع : الظريف من الناس . النهاية 1 / 125 . ب . بزع الصبي بزاعة : صار ظريفا كيسا . وصار متناهي الجمال . المعجم الوسيط . 1 / 54 . ب ) مع زوجها الحصان عن غيره .(@)(@@) % ( فر - عن علي ) .(@)(@@) 45131 - إن النساء شقائق الرجال .(@)(@@) % ( حم - عن عائشة ) .(@)(@@) 45132 - إنما النساء شقائق الرجال .(@)(@@) % ( حم ، د ، ( أخرجه أبو داود كتاب الطهارة رقم 236 . ص ) ت - عن عائشة ؛ البزار - عن أنس ) .(@)(@@) 45133 - حاملات مرضعات رحيمات لأولادهن لولا ما يأتين إلى أزواجهن دخل مصلياتهن الجنة .(@)(@@) % ( حم ، ه ، طب ، ك - عن أبي أمامة ) .(@)(@@) 45134 - إن الله كتب الغيرة على النساء والجهاد على الرجال ، فمن صبر منهن إيمانا واحتسابا كان لها مثل أجر الشهيد .(@)(@@) % ( طب - عن ابن مسعود ) .(@)(@@) 45135 - أيما امرأة ماتت وزوجها عنها راض دخلت الجنة .(@)(@@) % ( ت ، ه ، ك - عن أم سلمة ) .(@)(@@) 45136 - أيما امرأة مات لها ثلاثة من الولد كن لها حجابا من النار .(@)(@@) % ( خ - كتاب الجنائز عن أبي سعيد ) .(@)(@@) 45137 - أيما امرأة قعدت على بيت أولادها فهي معي في الجنة .(@)(@@) % ( ابن بشران - عن أنس ) .(@)(@@) 45138 - خدمتك زوجتك صدقة .(@)(@@) % ( فر - عن ابن عمر ) .(@)(@@) PageV16P169(@)(@@) 45139 - خير النساء التي تسره إذا نظر ، وتطيعه إذا أمر ، ولا تخالفه في نفسها ولا مالها بما يكره .(@)(@@) % ( حم ، ن ، ك - عن أبي هريرة ) .(@)(@@) 45140 - خير النساء من تسرك إذا أبصرت ، وتطيعك إذا أمرت ، وتحفظ غيبتك في نفسها ومالك .(@)(@@) % ( طب - عن عبد الله ابن سلام ) .(@)(@@) 45141 - رحم الله المتسرولات من النساء .(@)(@@) % ( قط في الأفراد ، ك في تاريخه ، هب - عن أبي هريرة ؛ خط في المتفق والمفترق - عن سعد بن طريف ؛ هق - عن مجاهد 
ms6443	 بلاغا ) .(@)(@@) 45142 - فجور المرأة الفاجرة كفجور ألف فاجر ، وبر المرأة الصالحة كعمل سبعين صديقا .(@)(@@) % ( أبو الشيخ - عن ابن عمر ) .(@)(@@) 45143 - للمرأة ستران : القبر والزوج .(@)(@@) % ( عد - عن ابن عباس ) .(@)(@@) 45144 - رحم ؟ ؟ امرأة قامت من الليل فصلت وأيقظت زوجها فصلى ، فإن أبى نضحت في وجهه الماء .(@)(@@) % ( حم ، د ، ( أخرجه أبو داود كتاب الصلاة رقم 1308 . ص ) ن ، ه ، حب ك - عن أبي هريرة ) .(@)(@@) 45145 - مثل المرأة الصالحة في النساء كمثل الغراب الأعصم الذي إحدى رجليه بيضاء .(@)(@@) % ( طب - عن أبي أمامة ) .(@)(@@) 45146 - مهنة إحداكن في بيتها تدرك جهاد المجاهدين إن شاء الله تعالى .(@)(@@) % ( ع - عن أنس ) .(@)(@@) 45147 - اللهم اغفر للمتسرولات من أمتي .(@)(@@) % ( البيهقي في الأدب عن علي ) .(@)(@@) 45148 - خير نساءكم العفيفة الغلمة ( الغلمة : الغلمة : هيجان شهوة النكاح من المرأة والرجل وغيرهما يقال : غلم غلمة . واغتلم اغتلاما . النهاية 3 / 382 . ب ) ، عفيفة في فرجها غلمة على زوجها .(@)(@@) % ( فر - عن أنس ) .(@)(@@) 45149 - قد أذن الله لكن أن تخرجن لحوائجكن .(@)(@@) % ( ن - عن عائشة ) .(@)(@@) | 1 ( الإكمال من الفصل الثاني في ترغيبات تختص بالنساء ) 1(@)(@@) 45150 - أخبرها أنها عاملة من عمال الله ولها نصف أجر المجاهد .(@)(@@) % ( الخرائطي في مكارم الأخلاق من طريق زافر بن سليمان - عن عبد الله الوضاحي أن رجلا قال : يا رسول الله ! إن لي امرأة إذا دخلت عليها قالت لي : مرحبا بسيدي وسيد أهل بيتي ! وإذا رأتني حزينا قالت : ما يحزنك الدنيا وقد كفيت أمر الآخرة ! قال النبي صلى الله عليه وسلم - فذكره ) .(@)(@@) 45151 - إنما هي هذه ، ثم ألزمن ظهور الحصر .(@)(@@) % ( حم - عن أبي هريرة أن رسول الله صلى الله عليه وسلم لما حج بنسائه قال - فذكره ) .(@)(@@) 45152 - جهادكن الحج المبرور هو لكن جهاد .(@)(@@) % ( حم - عن عائشة ) .(@)(@@) 45153 - لكن أحسن الجهاد وأجمله حج مبرور .(@)(@@) % ( ن - عن عائشة ) .(@)(@@) PageV16P170(@)(@@) 45154 - يا أم سلمة ! إنه لم يكتب على النساء الجهاد .(@)(@@) % ( طب ، حل - عن أنس ) .(@)(@@) 45155 - إذا تصدقت المرأة من بيت زوجها غير مفسدة فلها أجرها ، ولزوجها أجر ما اكتسب ، ولها أجر ما نوت ، وللخازن مثل ذلك .(@)(@@) % ( حب ، ك 
ms6444	 - عن عائشة ) .(@)(@@) 45156 - أيما امرأة ماتت وزوجها عنها راض دخلت الجنة .(@)(@@) % ( ت : حسن غريب ؛ طب ، ك - عن أم سلمة ) .(@)(@@) 45157 - انصرفي أيتها المرأة وأعلمي من وراءك من النساء أن حسن تبعل إحداكن لزوجها وطلبها مرضاته واتباعها موافقته يعدل ذلك كله .(@)(@@) % ( كر - عن أسماء بنت يزيد الأنصارية أنها قالت : يا رسول الله ! أنا وافدة النساء إليك أن الرجال فضلوا علينا بالجمع والجماعات وعيادة المرضى وشهود الجنائز والحج والعمرة والرباط ، قال - فذكره ) .(@)(@@) 45158 - المرأة عورة ، وإنها إذا خرجت استشرفها الشيطان ، وإنها أقرب ما تكون إلى الله وهي في قعر بيتها .(@)(@@) % ( طب ، حب - عن ابن مسعود ) .(@)(@@) 45159 - المرأة في حملها إلى وضعها إلى فصالها كالمرابط في سبيل الله ، وإن ماتت فيما بين ذلك فإنها ؟ ؟ أجر شهيد .(@)(@@) % ( طب - عن ابن عمر ) .(@)(@@) 45160 - المرأة إذا حملت كان لها أجر الصائم القائم المخبت المجاهد في سبيل الله ، وإذا ضربها الطلق فلا تدري الخلائق ، ما لها من الأجر ، فإذا وضعت كان لها بكل مصة أو رضعة أجر نفس تحييها ، فإذا فطمت ضرب الملك على منكبيها وقال : استأنفي العمل .(@)(@@) % ( أبو الشيخ - عبد الرحمن بن عوف ) .(@)(@@) 45161 - المرأة لا تؤدي حق الله حتى تؤدي حق زوجها كله ، ولو سألها وهي على ظهر قتب لم تمنعه حقها .(@)(@@) % ( طب - عن زيد بن أرقم ) .(@)(@@) 45162 - تحدثن عند إحداكن ما بدا لكن ، فإذا أردتن النوم فلتأت كل امرأة منكن إلى بيتها .(@)(@@) % ( الشافعي ، ق - عن مجاهد مرسلا ) .(@)(@@) 45163 - يا معشر النسوان ! أما ! إن خياركن يدخلن الجنة قبل خيار الرجال ، فليغسلن ويطببن فيدفعن إلى أزواجهن على براذين ( براذين : البرذون : الدابة . وقال الكسائي : الأنثى من البراذين : برذونة أ ه . الصحاح 47 . ص ) الحمر والصفر ، معهن الولدان كأنهن اللؤلؤ المنثور .(@)(@@) % ( أبو الشيخ - عن أبي أمامة ) .(@)(@@) 45164 - نعم لهو المرأة مغزلها .(@)(@@) % ( الديلمي - عن أنس ) .(@)(@@) 45165 - خير نسائكم العفيفة الغلمة .(@)(@@) % ( عد - عن أنس ) .(@)(@@) 45166 - للمرأة ستران : القبر والزوج ، قيل : فأيهما أفضل ؟ قال : القبر .(@)(@@) % ( عد وقال : منكر ؛ كر - عن ابن عباس ) .(@)(@@) 45167 - هما ستران : القبر والزوج .(@)(@@) % ( عد - عن ابن عباس 
ms6445	 ) .(@)(@@) PageV16P171(@)(@@) | 1 ( فرع في خروج النساء للصلاة الأذن عند وجود الشرائط ) 1(@)(@@) 45168 - ائذنوا للنساء يصلين بالليل في المسجد .(@)(@@) % ( الطيالسي - عن ابن عمر ) .(@)(@@) 45169 - ائذنوا للنساء بالليل إلى المساجد .(@)(@@) % ( حم ، م ( أخرجه مسلم كتاب الصلاة رقم 134 - 135 - 136 - 139 . ص ) ، د ، ت - عن ابن عمر ) .(@)(@@) 45170 - إذا استأذنت أحدكم امرأته إلى المسجد فلا يمنعها .(@)(@@) % ( حم ( أخرجه مسلم كتاب الصلاة رقم 134 - 135 - 136 - 139 . ص ) ، ق ، ن - عن ابن عمر ) .(@)(@@) 45171 - لا تمنعوا إماء الله مساجد الله أن يصلين في المسجد .(@)(@@) % ( ه - عن ابن عمر ) .(@)(@@) 45172 - لا تمنعوا النساء حظوظهن من المساجد إذا استأذنكم .(@)(@@) % ( م ( أخرجه مسلم كتاب الصلاة رقم 134 - 135 - 136 - 139 . ص ) - عن ابن عمر ) .(@)(@@) 45173 - لا تمنعوا إماء الله مساجد الله .(@)(@@) % ( حم ، م ( أخرجه مسلم كتاب الصلاة رقم 134 - 135 - 136 - 139 . ص ) - عن ابن عمر ) .(@)(@@) 45174 - لا تمنعوا نساءكم المساجد وبيوتهن خير لهن .(@)(@@) % ( حم ، د ، ك - عن ابن عمر ) .(@)(@@) 45175 - لا تمنعوا إماء الله المساجد ، ولكن ليخرجن وهن تفلات ( تفلات : تاركات للطيب . النهاية 1 / 191 . ب ) .(@)(@@) % ( حم ، د - عن أبي هريرة ) .(@)(@@) 45176 - لو تركنا هذا الباب للنساء .(@)(@@) % ( د - عن ابن عمر ) .(@)(@@) 45177 - إذا خرجت إحداكن إلى المسجد فلا تقربن طيبا .(@)(@@) % ( حم - عن زينب الثقفية ) .(@)(@@) 45178 - أيتكن أرادت المسجد فلا تقربن طيبا .(@)(@@) % ( ن - عن زينب الثقفية ) .(@)(@@) 45179 - لا تقبل صلاة لامرأة تطيبت لهذا المسجد حتى ترجع فتغتسل غسلها من الجنابة .(@)(@@) % ( د - عن أبي هريرة ) .(@)(@@) 45180 إذا خرجت المرأة إلى المسجد فلتغتسل من الطيب كما تغتسل من الجنابة .(@)(@@) % ( د - عن أبي هريرة ) .(@)(@@) 45181 - أيما امرأة أصابت بخورا فلا تشهد معنا العشاء الأخيرة .(@)(@@) % ( حم ، ( أخرجه مسلم كتاب الصلاة رقم 143 . ص ) م ، د ، ت - عن أبي هريرة ) .(@)(@@) 45182 - إذا شهدت إحداكن العشاء فلا تمس طيبا .(@)(@@) % ( حم ( أخرجه مسلم كتاب الصلاة رقم 142 . ص ) م ، ن - عن زينب الثقفية ) .(@)(@@) 45183 - أيما امرأة تطيبت ثم خرجت إلى المسجد لم تقبل لها صلاة حتى تغتسل .(@)(@@) % (