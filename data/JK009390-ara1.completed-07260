ms7241	 ددعتكم ، وقد وهبت ذنوبكم لحبكم أبا بكر وعمر ) . ( كر ) . )(@)(@@)(@@)(@@) $ 17156 عن ابن عمر رضي الله عنهما :(@)(@@) | 30 ( أن رسول الله دخل المسجد وعن يمينه أبو بكر ، وعن يساره عمر رضي الله عنه ، فقال : هاكذا نبعث يوم القيامة ) . ( كر ) . )(@)(@@)(@@)(@@) $ 17157 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( خرج رسول الله بين أبي بكر وعمر رضي الله عنهما ثم قال : هاكذا نموت ، وهاكذا ندفن ، وهاكذا ندخل الجنة ) . ( كر ) . )(@)(@@)(@@)(@@) $ 17158 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( كنت شاهد النبي في حائط نخل ، فاستأذن أبو بكر رضي الله عنه فقال النبي : ائذنوا له وبشروه بالجنة ، ثم استأذن عمر رضي الله عنه فقال : ائذنوا له وبشروه بالجنة ، ثم استأذن عثمان رضي الله PageV20P358 عنه فقال : ائذنوا له وبشروه بالجنة علاى بلواى تصيبه ، فدخل يبكي ويضحك ، قال عبد الله : فأنا يا نبي الله قال : أنت مع أبيك ) . ( كر ) . )(@)(@@)(@@)(@@) $ 17159 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( ذكر عثمان بن عفان رضي الله عنه عند النبي ، فقال رسول الله : ذاك النور ، فقيل له : ما النور ؟ قال : النور شمس في السماء والجنان ، والنور يفضل علاى الحور العين ، وإني زوجته ابنتي ، فذالك سماه الله عند الملائكة ذا النور ، وسماه في الجنان ذا النورين ، فمن شتم عثمان فقد شتمني ) . ( كر ) . )(@)(@@)(@@)(@@) $ 17160 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( رأيت رسول الله في جيش العسرة يقول : ما ضر عثمان ما فعل بعد هذاا ) . ( كر ) . )(@)(@@)(@@)(@@) $ 17161 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( قال رسول الله من يشتري لنا بئر رومة فيجعلها صدقة للمسلمين سقاه الله يوم القيامة من العطش ؟ فاشتراها عثمان بن عفان رضي الله عنه فجعلها صدقة للمسلمين ، قال ابن عمر رضي الله عنهما : لما جهز عثمان جيش العسرة ، قال رسول الله : اللهم لا تنساها لعثمان ) . ( عد ، كر ) . )(@)(@@)(@@)(@@) $ 17162 عن ابن عمر رضي الله عنهما :(@)(@@) | 30 ( أنه ذكر رسول الله عثمان رضي الله عنه فقال : فعل كذا وفعل كذا ، وجهز جيش العسرة ) . ( كر ) . )(@)(@@)(@@)(@@) $ 17163 عن 
ms7242	 ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( بينا رسول الله جالس وعائشة رضي الله عنها وراءه ، إذ استأذن أبو بكر رضي الله عنه فدخل ، ثم استأذن عمر رضي الله عنه فدخل ، ثم استأذن علي رضي الله عنه فدخل ، ثم استأذن سعد بن مالك رضي الله عنه فدخل ، ثم استأذن عثمان بن عفان رضي الله عنه فدخل ، ورسول الله يتحدث كاشفا عن ركبتيه ، فمد ثوبه علاى ركبتيه ، وقال لامرأته : استأخري عني ، فتحدثوا ساعة ثم خرجوا ، قالت عائشة : فقلت : يا رسول الله دخل عليك أصحابك ، فلم تصلح ثوبك علاى ركبتيك ولم تؤخرني عنك ، حتى دخل عثمان PageV20P359 فقال : يا عائشة ألا أستحي من رجل تستحي منه الملائكة ؟ والذي نفس محمد بيده إن الملائكة لتستحي من عثمان كما تستحي من الله ورسوله ، ولو دخل وأنت قريبة مني لم يرفع رأسه ولم يتحدث وخرج ) . ( ع ، كر ) . )(@)(@@)(@@)(@@) $ 17164 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( كنت مع رسول الله ، إذ أتاى رجل فصافحه ، فلم ينزع يده من يد الرجل حتى انتزع الرجل يده ، ثم قال له : يا رسول الله ؟ ما عثمان ؟ قال : ذاك امرؤ من أهل الجنة ) . ( طب ، كر ) . )(@)(@@)(@@)(@@) $ 17165 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( قال رسول الله : يا علي أنت في الجنة ) . ( ابن النجار ) . )(@)(@@)(@@)(@@) $ 17166 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( كان رسول الله إذا صلى بالناس الغداة ، أقبل عليهم بوجهه فقال : هل فيكم مريض أعوده ؟ فإن قالوا : لا ، قال : هل فيكم جنازة أتبعها ؟ فإن قالوا : لا ، قال : من رأى منكم رؤيا يقصها علينا ؟ فقال رجل : رأيت البارحة كأنه نزل ميزان من السماء ، فوضعت في إحداى الكفتين ، ووضع أبو بكر رضي الله عنه في الكفة الأخراى فشلت به ، ثم وضع أبو بكر في كفة ، وجيء بعمر رضي الله عنه فوضع في الكفة الأخراى فشال به أبو بكر ، ثم جيء بعثمان رضي الله عنه فوضع في الكفة ، فشال به عمر ، ثم رفع الميزان ، فما كان رسول الله يسألهم عن الرؤيا 
ms7243	 بعد ) . ( . . . ) . )(@)(@@)(@@)(@@) $ 17167 عن عمرو بن ميمون بن مهران :(@)(@@) | 30 ( أن عبد الله ابن عامر حين مرض مرضه الذي مات فيه ، دخل عليه أصحاب النبي وفيهم ابن عمر رضي الله عنه فقال : ما ترون في حالي ؟ فقالوا : ما نشك لك في النجاة ، قد كنت تقرى الضيف ، وتعطي المختبط ) . ( هب ) . )(@)(@@) PageV20P360(@)(@@)(@@)(@@) $ 17168 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( لما جاء بي أبي يوم أحد إلاى رسول الله وأنا ابن أربعة عشر ، فلم يجزني النبي ، ثم جاء بي يوم الخندق وإنا ابن خمسة عشر سنة ، ففرض لي رسول الله ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17169 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( عرضت علاى النبي يوم أحد وأنا ابن أربعة عشر سنة فلم يجزني ، ولم يرني بلغت ، وعرضت عليه يوم الخندق وأنا ابن خمسة عشر فأجازني ) . ( عب ، ش ) . )(@)(@@)(@@)(@@) $ 17170 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( عرضت علاى النبي يوم أحد وأنا ابن عشرة سنة فاستصغرني ، وعرضت عليه يوم الخندق وأنا ابن خمسة عشر فأجازني ) . ( ش ) . )(@)(@@)(@@)(@@) $ 17171 عن ابن شوذب قال :(@)(@@) | 30 ( بلغ ابن عمر رضي الله عنهما أن زيادا يريد الحجاز ، فكره أن يكون في سلطانه ، فقال : اللهم إنك تجعل في القتل كفارة لمن شئت من خلقك ، فموتا لابن سمية لاقتل ، فخرج في إبهامه طاعون ، فما أتت عليه جمعة حتى مات ) . ( كر ) . )(@)(@@)(@@)(@@) $ 17172 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 عرضت علاى النبي يوم بدر وأنا ابن ثلاثة عشر سنة فردني ، ثم عرضت عليه يوم أحد وأنا ابن أربعة عشر سنة فردني ، ثم عرضت عليه يوم الخندق وأنا ابن خمس عشرة سنة فأجازني ) . ( ابن سعد ) . )(@)(@@)(@@)(@@) $ 17173 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 عرضت يوم الخندق أنا ورافع بن خديج علاى النبي أنا وهو ابنا خمسة عشر سنة ، فقبلنا ) . ( كر ) . )(@)(@@)(@@)(@@) $ 17174 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( بايعت رسول الله يوم أحد وأنا ابن ثلاثة عشر سنة فاستصغرني فردني ، ثم تخلفت عنه في غزوة غزاها ) . ( كر ) . )(@)(@@)(@@)(@@) $ 17175 عن ابن 
ms7244	 عمر رضي الله عنهما قال :(@)(@@) | 30 ( عرضت علاى رسول الله يوم بدر فاستصغرني فلم يقبلني ، فما أتت علي ليلة قط مثلها من السهر والحزن والبكاء ، إذ لم يقبلني رسول الله ، فلما كان من العام المقبل عرضت عليه فقبلني ، فحمدت PageV20P361 الله علاى ذالك ، قال رجل : يا أبا عبد الرحمان توليتم يوم التقاى الجمعان ؟ قال : نعم ، فعفا الله عنا جميعا فله الحمد كثيرا ) . ( كر ) . )(@)(@@)(@@)(@@) $ 17176 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( شهدت الفتح وأنا ابن عشرين سنة ) . ( ابن منده ، كر ) . )(@)(@@)(@@)(@@) $ 17177 عن ابن مجاهد قال :(@)(@@) | 30 ( شهد ابن عمر رضي الله عنهما الفتح وهو ابن عشرين سنة ، ومعه فرس حرون ، ورمح ثقيل ، فذهب ابن عمر يختلي لفرسه ، فقال رسول الله : إن عبد الله عبد الله ) . ( كر ) . )(@)(@@)(@@)(@@) $ 17178 عن نافع :(@)(@@) | 30 ( أن ابن عمر رضي الله عنهما كان يتبع آثار رسول الله كل مكان صلى فيه ، حتى أن النبي نزل تحت شجرة ، فكان ابن عمر رضي الله عنهما يتعاهد تلك الشجرة فيصب في أصلها الماء لكيلا تيبس ) . ( كر ) . )(@)(@@)(@@)(@@) $ 17179 عن نافع قال :(@)(@@) | 30 ( كنا مع ابن عمر رضي الله عنهما في سفر ، فقيل : إن السبع في الطريق قد حبس الناس ، فاستخف ابن عمر راحلته ، فلما بلغ إليه نزل فعرك أذنه ونفذه وقال : سمعت النبي يقول : لو أن ابن آدم لم يخف إلا الله لم يسلط عليه غيره ، ولو أن ابن آدم لم يرج إلا الله ، لم يكله إلاى سواه ) . ( كر ) . . )(@)(@@)(@@)(@@) $ 17180 عن وهب بن أبان القرشي ، عن ابن عمر رضي الله عنهما :(@)(@@) | 30 ( أنه خرج في سفر ، فبينا هو يسير إذا قوم وقوف ، فقال : ما بال هاؤلاء ؟ قالوا : أسد علاى الطريق قد أخافهم ، فنزل عن دابته ، ثم مشاى إليه حتى أخذ بأذنيه فعركها ، ثممفذ قفاه ونحاه عن الطريق ، ثم قال : ما كذب عليك رسول الله ، سمعت رسول الله يقول : إنما يسلط علاى ابن آدم ما خافه ابن آدم ، ولو أن ابن آدم لم يخف إلا الله لم يسلط عليه غيره ، وإنما 
ms7245	 وكل ابن آدم لمن رجا ابن آدم ، ولو أن ابن آدم لم يرج إلا الله لم PageV20P362 يكله إلاى غيره ) . ( كر ) . )(@)(@@)(@@)(@@) $ 17181(@)(@@) | 30 عن عبد الله بن دينار ، عن ابن عمر رضي الله عنهما قال :(@)(@@) $ 30 ( يا آل عمر إنا كنا نتحدث أن هاذا الأمر لا ينقضي حتى يلي رجل من آل عمر يسير مسيرة عمر رضي الله عنه ، ويكون بوجهه علامة ، قال : فكان بلال بن عبد الله بن عمر بوجهه شامة ، فكانوا يرون أنه هو ، حتى جاء الله بعمر بن عبد العزيز ، وأمه أم عاصم ابنه عاصم بن عمر بن الخطاب ) . ( ت في التاريخ ، كر ) . ) $(@)(@@)(@@)(@@) $ 17181(@)(@@) | 30 عن عبد الله بن دينار ، عن ابن عمر رضي الله عنهما قال :(@)(@@) $ 30 ( يا آل عمر إنا كنا نتحدث أن هاذا الأمر لا ينقضي حتى يلي رجل من آل عمر يسير مسيرة عمر رضي الله عنه ، ويكون بوجهه علامة ، قال : فكان بلال بن عبد الله بن عمر بوجهه شامة ، فكانوا يرون أنه هو ، حتى جاء الله بعمر بن عبد العزيز ، وأمه أم عاصم ابنه عاصم بن عمر بن الخطاب ) . ( ت في التاريخ ، كر ) . ) $(@)(@@)(@@)(@@) $ 17182 عن نافع قال :(@)(@@) | 30 ( كان ابن عمر رضي الله عنهما يقول كثيرا : ليت شعري من هاذا الذي من ولد عمر بن الخطاب في وجهه علامة يملأ الأرض عدلا ) . ( كر ) . )(@)(@@)(@@)(@@) $ 17183 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( ذكر حاتم طيء عند النبي ، قال : ذاك رجل أراد أمرا ، وفي لفظ : طلب شيئا فأدركه ) . ( قط في الأفراد ، كر ) . )(@)(@@)(@@)(@@) $ 17184 عن نوفل بن سليمان الهنائي ، عن عبد الله بن عمر ، عن نافع ، عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( سمعت رسول الله يقول : ( حقا لم يكن لقمان نبيا ولكن عبدا صمصامة ، كثير التفكر ، حسن الظن ، أحب الله تعالاى فأحبه ، وضمن عليه بالحكمة ، كان نائما نصف النهار ، إذ جاءه نداء : يا لقمان هل لك أن يجعلك الله خليفة في الأرض ، تحكم بين الناس بالحق ؟ فانتبه فأجاب الصوت ، فقال : إن يخترني ربي 
ms7246	 قبلت ، فإني أعلم إن فعل ذالك بهي أعانني وعلمني وعصمني وإن خيرني ربي قبلت العافية ولم أقبل البلاء ، فقالت الملائكة بصوت لا يزاحم ، لم يالقمان ؟ قال : لأن الحاكم بأشد المنازل وأكبدها يغشاه الظلم من كل مكان ينجوا أو يعان ، وبالحري أن ينجوا ، وإن أخطأ أخطأ طريق الجنة ، ومن يكن في الدنيا ذليلا خير من أن يكون شريفا ، ومن يختر الدنيا علاى الآخرة فتنته الدنيا ، ولا يصيب ملك الآخرة ، PageV20P363 فتعجبت الملائكة من حسن منطقه ، فنام نومة ، فغط بالحكمة غطا ، فانتبه فتكلم بها ، ثم نودي داود بعده فقبلها ولم يشترط شرط لقمان ، فهوى في الخطيئة غير مرة ، وكل ذالك يصفح الله ويتجاوز ويغفر له ، وكان لقمان يؤازره بالحكمة ويعلمه ، فقال له داود : طوباى لك يا لقمان أوتيت الحكمة وصرفت عنك البلية ، وأوتي داود الخلافة ، وابتلي بالرزية والفتنة ) . ( الديلمي ، كر ) . )(@)(@@)(@@)(@@) $ 17185 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( قال النبي : إن الله تعالاى لا يجمع أمتي علاى ضلالة ، ويد الله علاى الجماعة ، ومن شذ شذ إلاى النار ) . ( ت : غريب ) . )(@)(@@)(@@)(@@) $ 17186 عن ابن عمر ، وعن ابن مسعود رضي الله عنهم :(@)(@@) | 30 ( قال رسول الله : اتقوا الله واصبروا ، حتى يستريح بر ، أو يستراح من فاجر ، وعليكم بالجماعة ، فإن الله لا يجمع أمة محمد علاى ضلالة ) . ( ش ، وإسناده صحيح ) . )(@)(@@)(@@)(@@) $ 17187 عن ابن عمر ، عن النبي قال :(@)(@@) | 30 ( خيار أمتي خمسمائة ، والأبدال أربعون ، فلا الخمسمائة ينقصون ، ولا الأربعون ينقصون ، كلما مات بدل أبدل الله من الخمسمائة مكانه ، وأدخل في الأربعين مكانهم ، فلا الخمسمائة ينقصون ، ولا الأربعون ينقصون ، فقالوا يا رسول الله دلنا علاى أعمال هاؤلاء ، فقال : هاؤلاء يعفون عمن ظلمهم ، ويحسنون إلاى من أساء إليهم ، ويواسون مما آتاهم الله وتصديق ذالك في كتاب الله : { والكاظمين الغيظ والعافين عن الناس والله يحب المحسنين } ) . ( كر ) . )(@)(@@)(@@)(@@) $ 17188 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( كنا عند رسول الله يوما حين طلعت الشمس فقال : سيأتي ناس من أمتي يوم القيامة ، نورهم كضوء الشمس ، قلنا : من أولائك يا رسول الله 
ms7247	 ؟ فقال : فقراء المهاجرين الذين تتقاى بهم المكاره ، يموت PageV20P364 أحدهم وحاجته في صدره ، يحشرون من أقطار الأرض ) . ( ابن النجار ) . )(@)(@@)(@@)(@@) $ 17189 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( قال النبي : أتعلم أول زمرة تدخل الجنة من أمتي ؟ فقراء المهاجرين ، يأتون يوم القيامة إلاى باب الجنة ويستفتحون ، فتقول لهم الخزنة : أوقد حوسبتم ؟ قالوا : بأي شيء نحاسب ؟ وإنما كانت أسيافنا علاى عواتقنا في سبيل الله حتى متنا علاى ذالك فيفتح لهم فيقيلون فيها أربعين عاما قبل أن يدخلها الناس ) . ( ك ، هب ) . )(@)(@@)(@@)(@@) $ 17190 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( ما طلع النبي علاى المدينة قافلا من سفر إلا قال : يا طيبة يا سيدة البلدان ) . ( الديلمي ) . )(@)(@@)(@@)(@@) $ 17191 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( سمعت رسول الله يقول : من صلى في هاذا المسجد يعني : مسجد قباء كان كقدر عمرة ) . ( ابن النجار ) . )(@)(@@)(@@)(@@) $ 17192 عن عبد الله بن مساحق ، عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( سمعت رسول الله يقول : تجندون أجنادا فقال رجل : خر لي يا رسول الله قال : عليك بالشام ، فإنها صفوة الله من بلاده ، فيها خيرته من عباده ، فمن رغب عن ذالك فليلحق بيمه ، وليسق من غدره ، فإن الله قد تكفل لي بالشام وأهله ) . ( كر ) . )(@)(@@)(@@)(@@) $ 17193 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( قال رسول الله : تجندون أجنادا قال رجل : يا رسول الله خرلي قال : عليك بالشام ، فإنها صفوة الله من بلاده ، وفيها خيرته من عباده ، فمن رغب عن ذالك فليلحق بيمنه ، وليسق بغدره ، فإن الله قد تكفل لي بالشام وأهله ) . ( كر ) . )(@)(@@)(@@)(@@) $ 17194 عن الضحاك قال :(@)(@@) | 30 ( أتيت ابن عمر رضي الله عنهما فسألته : أين أنزل ؟ فقال : إن الناصية الأولاى من أصحاب رسول الله ، ساروا بأمر رسول الله حتى نزلوا الشام ، ثم نزلوا حمص خاصة ، فانظر ما كانوا عليه فأته ) . ( كر ) . )(@)(@@)(@@)(@@) $ 17195 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( صلى رسول الله صلاة PageV20P365 الفجر ، ثم انفتل فأقبل علاى القوم ، فقال : اللهم بارك لنا في مدينتنا ، وبارك لنا في 
ms7248	 مدنا وصاعنا ، اللهم بارك لنا في حرمنا ، وبارك لنا في شامنا ويمننا ، فقال رجل : والعراق يا رسول الله ؟ فسكت ، ثم أعاد ، فقال : اللهم بارك لنا في مدينتنا ، وبارك لنا في مدنا وصاعنا ، اللهم بارك لنا في حرمنا ، وبارك لنا في شامنا ويمننا ، فقال رجل : والعراق يا رسول الله ؟ فسكت ، ثم أعاد ، فقال : اللهم بارك لنا في مدينتنا ، وبارك لنا في مدنا وصاعنا ، اللهم بارك لنا في حرمنا ، وبارك لنا في شامنا ويمننا ، فقال رجل : والعراق يا رسول الله ؟ قال : من ثم يطلع قرن الشيطان ، وتهيج الفتن ) . ( كر ) . )(@)(@@)(@@)(@@) $ 17196 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( قال رسول الله : دللهم بارك في شامنا ويمننا مرتين فقال رجل : وفي مشرقنا يا رسول الله فقال رسول الله : من هناك يطلع قرن الشيطان ، وبها تسعة أعشار الشر ) . ( كر ) . )(@)(@@)(@@)(@@) $ 17197 عن ابن عمر رضي الله عنهما :(@)(@@) | 30 ( أن مولاة له أتته ، فقالت : إني قد اشتد علي الزمان ، وأنا أريد أن أخرج إلاى العراق فقال : فهلا إلاى الشام ، أرض المحشر ؟ اصبري لكاع فإني سمعت رسول الله يقول : من صبر علاى شدتها ولاءوائها كنت له شفيعا أو : شهيدا يوم القيامة ، وفي لفظ : لا يصبر علاى لاءوائها وشدتها أحد إلا كنت له شهيدا أو : شفيعا ي وم القيامة ) . ( كر ) . )(@)(@@)(@@)(@@) $ 17198 عن ابن عمر رضي الله عنهما ، عن رسول الله قال :(@)(@@) | 30 ( إذا هلك أهل الشام فلا خير في أمتي ، ولا تزال طائفة من أمتي يقاتلون علاى الحق ظاهرين ، لا يبالون خلاف من خالفهم ، أو خذلان من خذلهم ، حتى يأتي أمر الله وهم علاى ذالك وهو يشير إلاى الشام ) . ( كر ) . )(@)(@@)(@@)(@@) $ 17199 عن عطاء ، عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( ليأتين علاى الناس زمان ، لا يبقاى علاى الأرض مؤمن إلا لحق بالشام ) . ( يعقوب بن سفيان ، كر ، ثم رواه ( كر ) من وجه آخر عن ابن عمر رضي الله عنهما وقال : ليس بالمحفوظ ، والمحفوظ الموقوف ) . )(@)(@@) PageV20P366(@)(@@)(@@)(@@) $ 17200 عن عبد الله بن عمر رضي الله عنهما قال :(@)(@@) | 30 ( قال رسول الله 
ms7249	 : سيخرج نار قبل يوم القيامة من بحر عدن من حضرموت يحشر الناس قالوا : يا رسول الله فما تأمرنا ؟ قال : عليكم بالشام ) . ( ش ) . )(@)(@@)(@@)(@@) $ 17201 عن ابن عمر رضي الله عنهما :(@)(@@) | 30 ( إن الله وملائكته يصلون في كل يوم علاى موتاى قزوين والتجار وشهدائهم مائة صلاة ) . ( الرافعي عن ابن مسعود ) . )(@)(@@)(@@)(@@) $ 17202 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( لما مر رسول الله بالحجر قال : لا تدخلوا مساكن الذين ظلموا أنفسهم إلا أن تكونوا باكين أن يصيبكم مثل الذي أصابهم ، ثم قنع رسول 2 الله رأسه وأسرع السير حتى جاز الوادي ) . ( عب ، م كتاب الزهد ) . )(@)(@@)(@@)(@@) $ 17203 عن عبد الله بن عمر رضي الله عنهما قال :(@)(@@) | 30 ( قسم الشر سبعين جزءا ، فجعل تسعة وستون جزءا في البربر ، وجزء واحد في سائر الناس ) . ( نعيم ) . )(@)(@@)(@@)(@@) $ 17204 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( كنت عند رسول الله ، فذكرت الأعمال ، فقال : ما من أيام أفضل فيهن العمل من هاذه العشر قالوا : يا رسول الله ولا الجهاد فأكبره ؟ قال : ولا الجهاد إلا أن يخرج رجل بنفسه وماله في سبيل الله ثم يكون مهجة نفسه فيه ) . ( ابن النجار ) . )(@)(@@)(@@)(@@) $ 17205 عن ابن عمر رضي الله عنهما :(@)(@@) | 30 ( أن النبي قال : لا بد من خسف ومسخ وقذف ، قال : يا رسول الله في هاذه الأمة ؟ قال : نعم ، إذا اتخذوا القيان ، واستحلوا الزنا ، وأكلوا الربا ، واستحلوا الصيد في الحرم ، ولبس الحرير ، واكتفاى الرجال بالرجال ، والنساء بالنساء ) . ( ابن النجار ) . )(@)(@@)(@@)(@@) $ 17206 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( لقيت ابن صياد في طريق من طرق المدينة ، فانتفخ حتى ملأ الطريق ، فقلت : اخسأ فإنك لن تعدو قدرك ، فانضم بعضه إلاى بعض ومررت ) . ( ش ) . )(@)(@@) PageV20P367(@)(@@)(@@)(@@) $ 17207 عن عبد الله بن عمر رضي الله عنهما قال :(@)(@@) | 30 ( ينزل عيساى ابن مريم عليه السلام ، فإذا رآه الدجال ذاب كما تذوب الشحمة ، فيقتل الدجال ، ويتفرق عنه اليهود فيقتلون ، حتى أن الحجر يقول : يا عبد الله للمسلم هاذا يهودي فتعال فاقتله ) . ( ش ) . )(@)(@@)(@@)(@@) $ 17208 عن عبد الله بن عمر رضي 
ms7250	 الله عنهما قال :(@)(@@) | 30 ( تخرج معادن مختلفة قريب يقال لها : فرعون ذهب ، يذهب إليه شرار الناس وبينما هم يعملون فيه إذ حسر لهم عن الذهب ، فأعجبهم معتملة إذ خسف به وبهم ) . ( نعيم ) . )(@)(@@)(@@)(@@) $ 17209 عن عبد الله بن عمر رضي الله عنهما قال :(@)(@@) | 30 ( ليخسفن بالدار الاى جنب الدار ، وبالدار الاى جنب الدار ) . ( ش ) . )(@)(@@)(@@)(@@) $ 17210 عن ابن عمر رضي الله عنهما ، عن النبي قال :(@)(@@) | 30 ( لا بد من خسف ومسخ ورجف قالوا : يا رسول الله في هاذه الأمة ؟ قال : نعم ، إذا اتخذوا القيان ، واستحلوا الزنا ، وأكلوا الربا ، واستحلوا الصيد في الحرم ، ولبس الحرير ، واكتفاى الرجال بالرجال ، والنساء بالنساء ) . ( ابن النجار ) . )(@)(@@)(@@)(@@) $ 17211 عن ابن عمر رضي الله عنهما :(@)(@@) | 30 ( أن رجلا مسلما قتل رجلا ذميا عمدا ، فرفع إلاى عثمان رضي الله عنه فلم يقتله ، وغلظ عليه الدية مثل دية المسلم ) . ( عب ، قط ، لق ) . )(@)(@@)(@@)(@@) $ 17212 عن جابر ، عن ابن عباس رضي الله عنهما قال :(@)(@@) | 30 ( إذا طلقها واحدة أو اثنتين ثم قذفها جلد ، ولا ملاعنة بينهما ، وقال ابن عمر رضي الله عنهما : يلاعن إذا كان يملك الرجعة ) . ( عب ) . )(@)(@@) PageV20P368(@)(@@)(@@)(@@) $ 17213 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( فرق رسول الله بين أخوي بني العجلان وقال : والله إن أحدكما لكاذب ، فهل منكما تائب ؟ فلم يعترف واحد منهما ، فتلاعنا ، ثم قرت امرأة بينهما ، قال : يا رسول الله صداقي ، فقال له النبي : إن كنت صادقا فهو لها بما استحللت منها ، وإن كنت كاذبا فذاك أوجب لها ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17214 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( قال رسول الله للمتلاعنين : حسابكما علاى الله ، أحدكما كاذب ، لا سبيل لك عليها ، فقال : يا رسول الله مالي ، قال : لا مال لك ، إن كنت صادقا فهو بما استحللت من فرجها ، وإن كنت كاذبا فهو أبعد لك منها ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17215 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( لاعن النبي بين رجل من الأنصار وامرأته وفرق بينهما ) . ( ش ) . )(@)(@@)(@@)(@@) $ 17216 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( إن رجلا لاعن امرأته 
ms7251	 في زمن رسول الله فانتفاى من ولدها ، ففرق النبي بينهما وألحق الولد بأمه ) . ( خط في المتفق ) . )(@)(@@)(@@)(@@) $ 17217 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( ابن الملاعنة يدعى لامه ، ومن قذف أمه يقول : ( يا ابن الزانية ) ضرب الحد ، وأمه عصبته ، يرثها وترثه ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17218 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( أربع لا لعان بينهن وبين أزواجهن : اليهودية ، والنصرانية تحت المسلم ، والحرة عند العبد ، والأمة عند الحر ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17219 عن نافع قال :(@)(@@) | 30 ( كنت أسير مع ابن عمر رضي الله عنها فسمعت صوت زامر رعاء ، فعدل عن الطريق ، ثم قال : يا نافع هل تسمع شيئا ؟ قلت : لا ، ثم رجع الاى الطريق ، ثم قال : هاكذا رأيت رسول الله فعل ) . ( كر ) . )(@)(@@)(@@)(@@) $ 17220 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( كنا علاى عهد النبي نأكل PageV20P369 ونحن نمشي ، ونشرب ونحن قيام ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 17221 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( جيء بالأرنب إلاى رسول الله وأنا قاعد عنده ، فلم يأمر بأكلها ولم ينه ، وزعم أنها تحيض ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 17222 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( كان ناس من أصحاب النبي فيهم سعد رضي الله عنه فذهبوا يأكلون من لحم ، فنادتهم امرأة أنه لحم ضب ، فأمسكوا ، فقال لهم النبي : كلوا أو : اطعموا فإنه حلال ، أو قال : لا بأس به ، ولاكنه ليس من طعامي ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 17223 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( أتي النبي بضب ؛ فقال : لا آمر به ولا أنهاى عنه أو قال : لا آكله ولا احرمه ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 17224 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( كان ناس من أصحاب النبي عنده يأكلون ضبا ، منهم سعد بن مالك رضي الله عنه ، فنادتهم امرأة من أزواج النبي أنه ضب ، فأمسكوا ، فقال النبي : كلوا ، فإنه حلال ولا بأس به ، ولاكن ليس من طعام قومي ) . ( كر ) . )(@)(@@)(@@)(@@) $ 17225 عن عتبة بن رباح :(@)(@@) | 30 ( أنه سأل ابن عمر رضي الله عنهما عن الذهب والحرير ؟ فقال : يكرهان للرجال ولا يكرهان 
ms7252	 للنساء ) . ( ابن جرير في تهذيبه ) . )(@)(@@)(@@)(@@) $ 17226 عن خالد بن الدريك :(@)(@@) | 30 ( أن بنتا لعبد الله بن عمر رضي الله عنهما خرجت وعليها قميص من حرير ، فقالوا لابن عمر : تنهون عن الحرير وتلبسونه ؟ فقال : إني لأرجو أن يتجاوز الله لنا عما هو أعظم من هاذا ) . ( ابن جرير في تهذيبه ) . )(@)(@@)(@@)(@@) $ 17227 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( أهداى أكيدر دومة إلاى رسول الله حلة سيراء فبعث بها إلاى عمر رضي الله عنه ) . ( أبو نعيم ) . )(@)(@@)(@@)(@@) $ 17228 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( خرجت ليلة ورسول الله بفناء حفصة رضي الله عنها ، فأقبلت من خلفه ، فسمع قعقعة الإزار ، فقال : ارفع الأزار PageV20P370 قلت : يا نبي الله إنه مرتفع ، قال : ارفع إزارك ثلاثا ، فإنه من جر ثوبه خيلاء ، لم ينظر الله إليه يوم القيامة ) . ( الخطيب في المتفق والمفترق ) . )(@)(@@)(@@)(@@) $ 17229 عن ابن عمر رضي الله عنهما :(@)(@@) | 30 ( أن النبي كان يكسو بناته خمر القز والإبريسم ) . ( ابن النجار ) . )(@)(@@)(@@)(@@) $ 17230 عن ابن عمر رضي الله عنهما :(@)(@@) | 30 ( أن النبي لحد له ولأبي بكر وعمر رضي الله عنهما ) . ( ابن النجار ) . )(@)(@@)(@@)(@@) $ 17231 عن إبان :(@)(@@) | 30 ( أن عبد الله بن عمر رضي الله عنهما : كان يدفن أهله في مكان ، فكان إذا شهد جنازة مر علاى أهله فدعا لهم واستغفر لهم ) . ( ابن إبي الدنيا ، هب ) . )(@)(@@)(@@)(@@) $ 17232 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( جاء رجل إلاى النبي قال : أوصني ، قال : تعبد الله ولا تشرك به شيئا ، وتقيم الصلاة ، وتؤتي الزكاة ، وتصوم ، وتحج ، وتعتمر ، وتسمع وتطيع ، وعليك بالعلانية ، وإياك والسرائر ) . ( ابن جرير ، ك ) . )(@)(@@)(@@)(@@) $ 17233 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( إن أهل البيت يتتابعون في النار حتى ما يبقاى منهم حر ولا عبد ولا أمة ) . ( عب ، عن أبي جحيفة ) . )(@)(@@)(@@)(@@) $ 17234 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( البر شيء هين ، وجه طليق ، ولسان لين ) . ( كر ) . )(@)(@@)(@@)(@@) $ 17235 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( خطبنا رسول الله في مسجد الخيف بمنى ، فقال : نضر الله عبدا سمع 
ms7253	 مقالتي فعمد بها يحدث بها أخاه : ثلاثة لا يغل عليهن قلب مسلم : إخلاص العمل لله ، ومناصحة ولاة الأمر ، ولزوم جماعة المسلمين ، فإن دعوتهم تحيط من ورائهم ) . ( ابن النجار ) . )(@)(@@)(@@)(@@) $ 17236 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( أتاى النبي رجل فقال : يا رسول الله حدثني حديثا واجعله موجزا لعلي أعيه ، فقال له النبي : صل صلاة PageV20P371 مودع كأنك لا تصلي بعد ، واعبد الله تعالاى كأنك تراه ، فإن كنت لا تراه فإنه يراك ، وايأس مما في أيدي الناس تعش غنيا ، وإياك وما يعتذر منه ) . ( العسكري في الأمثال ، وابن النجار ) . )(@)(@@)(@@)(@@) $ 17237 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( قال لي عمر عليك بخصال الإيمان : الصوم في شدة الصيف ، وضرب الأعداء بالسيف ، وتعجيل الصلاة في يوم الغيم ، وإبلاغ الوضوء في اليوم الشاتي ، والصبر علاى المصيبات ، وترك ردعة الخبال ، قلت : وما ردعة الخبال ؟ قال : الخمر ) . ( ابن سعد ، هب ) . )(@)(@@)(@@)(@@) $ 17238 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( فروا من الشر ما استطعتم ) . ( هب ) . )(@)(@@)(@@)(@@) $ 17239 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( قال رسول الله : ليلة عرج بي كنت من ربي كقاب قوسين أو أدناى ، فقال : يا أحمد فيم يختصم الملا الأعلاى ؟ فقلت : في الدرجات والكفارات ، قال : وذكر الحديث بطوله ) . ( ابن النجار ) . )(@)(@@)(@@)(@@) $ 17240 عن عمرو بن دينار قال :(@)(@@) | 30 ( أراد ابن عمر رضي الله عنهما أن لا يتزوج ، فقالت له حفصة رضي الله عنها : يا أخي لا تفعل ، تزوج . فإن ولد لك ولد كانوا لك أجرا ، وإن عاشوا دعوا الله لك ) . ( ص ) . )(@)(@@)(@@)(@@) $ 17241 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( إن الله تعالاى لا يؤخر نفسا إذا جاء أجلها ، وإنما زيادة العمر ذرية صالحة يرزقها العبد ، فيدعون له بعد موته ، فيلحقه دعاؤهم في قبره ، فذالك زيادة العمر ) . ( طب عن أبي الدرداء رضي الله عنه ) . )(@)(@@)(@@)(@@) $ 17242 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( إن غيلان بن سلمة أسلم وعنده ثماني عشرة نسوة ، فأمره رسول الله أن يختار منهن أربعا ) . ( عب ، ش ) . )(@)(@@)(@@)(@@) $ 17243 عن 
ms7254	 ابن عمر رضي الله عنهما :(@)(@@) | 30 ( أن غيلان بن سلمة الثقفي أسلم PageV20P372 وتحته عشر نسوة ، فقال له رسول الله : أختر منهن أربعا ، فلما كان في عهد عمر رضي الله عنه طلق نساءه وقسم ماله بين بنيه ، فلقيه ، فقال : إني أظن الشيطان فيما يسترق السمع سمع بموتك فقذفه في نفسك ، ولعلك أن لا تمكث إلا قليلا ، وايم الله لترجعن نساءك ، ولترجعن في مالك ، أو لاورثنهن منك إذا مت ، ثم لامرن بقبرك فيرجم كما يرجم قبر أبي رغال قال نافع : فما مكث إلا سبعا حتى مات ) ( ع ، كر ) . )(@)(@@)(@@)(@@) $ 17244 عن ابن عمر رضي الله عنهما(@)(@@) | 30 أنه سئل عن الأمة يطؤها سيدها ، ثم يريد أن يطأ أختها ؟ قال : ( لا حتى يخرجها من ملكه ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17245 عن سالم :(@)(@@) | 30 ( أن رجلا سأل ابن عمر رضي الله عنهما عن المتعة ؟ فقال : حرام ، فقال : إن فلانا يفتاى بها ، فقال : والله لقد علم أن رسول الله حرمها يوم خيبر ، وما كنا سامحين ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 17246 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( نهاى رسول الله عن متعة النساء يوم خيبر ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 17247 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( لكل مطلقة متعة إلا التي تطلق قبل أن يدخل بها وقد فرض لها ، فلها نصف الصداق ولا متعة لها ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17248 عن نافع قال :(@)(@@) | 30 ( تزوج ابن عمر رضي الله عنهما صفية علاى أربعمائة درهم ، فأرسلت إليه : إن هذاا لا يكفينا ، فزادها مائتين سرا من عمر رضي الله عنه ) . ( ش ) . )(@)(@@)(@@)(@@) $ 17249 عن ابن عمر رضي الله عنهما :(@)(@@) | 30 ( أن رجلا زوج ابنته بكرا فكرهت ، فرد النبي نكاحه ) . ( كر ) . )(@)(@@)(@@)(@@) $ 17250 عن ابن عمر رضي الله عنهما :(@)(@@) | 30 ( أنه سئل عن امرأة لها أمة تزوجها ؟ PageV20P373 قال : لا ، ولاكن لتأمر وليها فليزوجها ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17251 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( إذا أتيت أهلك ثم أردت أن تعود فتوضأ بينهما وضوءا ) . ( ش ، وابن جرير ) . )(@)(@@)(@@)(@@) $ 17252 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( قال رسول الله 
ms7255	 : زوجوا أبناءكم وبناتكم ، قيل : يا رسول الله هذاا أبناؤنا ، فكيف بناتنا ؟ قال : حلوهن الذهب والفضة ، وأجيدوا لهن الكسوة ، وأحسنوا إليهن بالنحلة ليرغب فيهن ) . ( ك ، في تاريخه ، والديلمي ) . )(@)(@@)(@@)(@@) $ 17253 عن ابن عمر رضي الله عنهما :(@)(@@) | 30 ( أن كثير بن الصامت كان اسمه قليلا ، فسماه النبي كثيرا ، وأن مطيع بن الأسود كان اسمه العاص ، فسماه النبي مطيعا ، وأ أم عاصم بن عمر كان اسمها عاصية ، فسماها رسول الله سهلة ، وكان يتفاءل بالاسم ) . ( ابن منده ، كر ) . )(@)(@@)(@@)(@@) $ 17254 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( قال رسول الله : لعن الله الواشمة والمستوشمة ، والواصلة والمستوصلة ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 17255 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( توشك المنايا أن تسبق الوصايا ) . ( ك ) . )(@)(@@)(@@)(@@) $ 17256 عن ابن عمر رضي الله عنهما أنه كان يقول في الوصية :(@)(@@) | 30 ( إذا عجزت عن الثلث قال : يبدأ بالعتاقة ) . ( ض ) . )(@)(@@)(@@)(@@) $ 17257 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( الثلث وسط ، لا بخس ولا شطط ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17258 عن ابن عمر رضي الله عنهما :(@)(@@) | 30 ( أن عمر أصاب أرضا بخيبر ، وقال يا رسول الله ما تأمرني ؟ قال : فذكره ) . ( إن شئت حبست أصلها وتصدقت بها ) . ( حم ، خ ، ت ، ن ، ه )(@)(@@) PageV20P374(@)(@@)(@@)(@@) $ 17259 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( من أعطاى شيئا ولم يسأله ، فليس ثواب من هبته ، وإن سئل فأعطاى فهو أحق بهبته حتى يثاب ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17260 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( سألت رسول الله عن أرض من ثمغ ؟ فقال : احبس أصلها وسبل ثمرتها ، قال ابن عمر : فإنها لأول صدقة تصدق بها في الإسلام ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 17261 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( أصاب عمر أرضا فأتاى النبي فقال : يا رسول الله إني أصبت أرضا بخيبر والله ما أصبت مالا قط هو أنفس عندي منه ، فما تأمرني ؟ قال : إن شئت تصدقت بها وحبست أصلها ، فجعلها بن عمر رضي الله عنه صدقة لا تباع ولا توهب ولا تورث ، وتصدق بها علاى الفقراء والمساكين وابن السبيل والغزاة في سبيل 
ms7256	 الله والضعيف ، لا جناح علاى من وليها أن يأكل منها ويطعم صديقا غير متمول فيه ، وأوصاى بها إلاى حفصة أم المؤمنين رضي الله عنها ، ثم إلاى الأكابر من ولد عمر ) . ( ش ، والعدني ) . )(@)(@@)(@@)(@@) $ 17262 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( قال عمر للنبي : يا رسول الله إن المائة سهم التي بخيبر ، لم أصب مالا قط هو أعجب إلي منها ، وقد أردت أن أتقرب بها إلاى الله تعالاى ، فقال النبي : احبس أصلها ، وسبل ثمرها ) . ( العدني ) . )(@)(@@)(@@)(@@) $ 17263 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( إذا قال : أقسمت عليك بالله فينبغي له أن لا يحنثه ، فإن فعل كفر الذي حلف ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17264 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( قال أهل المدينة لرسول الله : ادخل المدينة راشدا مهديا ، فدخل رسول الله المدينة ، فخرج الناس فجعلوا ينظرون إلاى رسول الله ، كلما مر علاى قوم قالوا : يا رسول الله هاهنا فقال رسول الله : دعوها فإنها مأمورة يعني ناقته حتى بركت علاى باب أبي أيوب PageV20P375 الأنصاري رضي الله عنه ) . ( عد ، كر ) . )(@)(@@)(@@)(@@) $ 17265 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( إذا لم يجد ما يطعم في كفارة اليمين صام ثلاثة أيام ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17266 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( إذا أقسمت مرارا فكفارة واحدة ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17267 عن ابن عمر ، وزيد بن ثابت رضي الله عنهم في كفارة اليمين قالا :(@)(@@) | 30 ( مدين من حنطة لكل مسكين ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17268 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( من حلف فقال : والله إن شاء الله فليس عليه كفارة ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17269 عن عبد الله بن عمر رضي الله عنهما قال :(@)(@@) | 30 ( نهانا رسول الله عن النذر وقال : إنه لا يقدم شيئا ، وإنما يستخرج به من الشحيح ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17270 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( ليس للنذر إلا الوفاء به ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17271 عن ابن عمر رضي الله عنهما(@)(@@) | 30 أنه سئل عن النذر ؟ فقال : ( أفضل الإيمان ، فإن لم تجد فالتي تليها ، فإن لم تجد 
ms7257	 فالتي تليها يقول : الرقبة والكسوة والطعام ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17272 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( نهينا أن نصلي في مسجد مشرف ) . ( ش ) . )(@)(@@)(@@)(@@) $ 17273 عن ابن عمر رضي الله عنهما :(@)(@@) | 30 ( أن رسول الله كان يصلي إلاى بعيره ) . ( ش ) . )(@)(@@)(@@)(@@) $ 17274 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( إن المهاجرين حين أقبلوا من مكة نزلوا إلاى جنب قباء فأمهم سالم مولاى أبي حذيفة رضي الله عنه لأنه كان أكثرهم قرآنا ، PageV20P376 فيهم أبو سلمة بن عبد الأسد وعمر بن الخطاب رضي الله عنهم ) . ( ش ) . )(@)(@@)(@@)(@@) $ 17275 عن عيسى بن حفص ، عن أبيه قال :(@)(@@) | 30 ( خرجنا مع ابن عمر رضي الله عنهما فصلينا الفريضة ، فرأى بعض ولده يتطوع ، فقال ابن عمر رضي الله عنهما : صليت مع رسول الله وأبي بكر وعمر وعثمان رضي الله عنهم ، فلا صلاة قبلها ولا بعدها في السفر ، ولو تطوعت لأتممت ) . ( عب ، ش ) . )(@)(@@)(@@)(@@) $ 17276 عن عطية ، عن ابن عمر رضي الله عنهما ، عن النبي :(@)(@@) | 30 ( أنه كان يتطوع في السفر ) . ( ش ) . )(@)(@@)(@@)(@@) $ 17277 عن ابن عمر رضي الله عنهما ، عن سالم :(@)(@@) | 30 ( أن النبي وعمر رضي الله عنه كانا يتطوعان في السفر ) . ( ش ) . )(@)(@@)(@@)(@@) $ 17278 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( نهاى رسول الله عن إخصاء الخيل والبهائم ) . ( ش ) . )(@)(@@)(@@)(@@) $ 17279 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( كان رسول الله يأتي قباء راكبا وماشيا ) . ( ش ) . )(@)(@@)(@@)(@@) $ 17280 عن ابن عمر رضي الله عنهما :(@)(@@) | 30 ( أن النبي كان يخرج بالعنزة معه يوم الفطر والأضحاى لأن يركزها فيصلي إليها ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17281 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( كانت تحمل مع النبي عنزة يوم العيد فيصلي إليها ، وإذا سافر حملت معه فيصلي إليها ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17282 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( إن عمر رأى حلة عطارد التميمي من حرير سبراء تباع ، فقال : يا رسول الله اشتر هاذه الحلة فالبسها يوم الجمعة وللوفود إذا جاءك ، فقال رسول الله : إنما يلبس هاذه من لا خلاق له في الآخرة ، PageV20P377 ثم أتي 
ms7258	 رسول الله بحلل منها بعد ذالك ، فأرسل إلاى عمر منها بحلة ، فأتاه عمر فقال : يا رسول الله أرسلت إلي اليوم بحلة ، وقد قلت في حلة عطارد ما قلت ، فقال : تستنفقها ، أو تكسوها نساءك ) . ( ط ) . )(@)(@@)(@@)(@@) $ 17283 عن يونس بن جبير قال :(@)(@@) | 30 ( سألت ابن عمر رضي الله عنهما عن رجل طلق امرأته وهي حائض ، فقال : تعرف ابن عمر ، فإنه طلق امرأته وهي حائض ، فذكر عمر رضي الله عنه ذالك للنبي فقال : ليراجعها ) . ( ط ) . )(@)(@@)(@@)(@@) $ 17284 عن جعفر ، عن أبيه قال :(@)(@@) | 30 ( كان ابن عمر رضي الله عنهما إذا عصفت الريح فدارت يقول : شددوا التكبير فإنه مذهبها ) . ( ش ) . )(@)(@@)(@@)(@@) $ 17285 عن محارب بن دثار ، عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( إذا سجد أحدكم فليقل : رب ظلمت نفسي فاغفر لي ، قال محارب : فإنه أقرب ما يكون إلاى الله عز وجل ) . ( ش ) . )(@)(@@)(@@)(@@) $ 17286 عن نافع قال :(@)(@@) | 30 ( تربع عمر رضي الله عنه في صلاته فقال : إنها ليست من سنة الصلاة ، ولاكني أشتكي رجلي ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17287 عن عبد الله بن عبد الله بن عمر رضي الله عنهما قال :(@)(@@) | 30 ( صلى ابن عمر رضي الله عنهما فتربع ، ففعلت ذالك وأنا حديث السن ، فقال : ولم تفعل ذالك ؟ قلت : فإنك تفعله ، قال : إنها ليست من سنة الصلاة ، ولاكن سنة الصلاة أن يثني اليسراى وينصب اليمناى ، وإني لا تحملني رجلاي ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17288 عن مغيرة بن حيكم :(@)(@@) | 30 ( أنه رأى ابن عمر رضي الله عنهما تربع في سجدتين من الصلاة علاى صدور قدميه ، فذكر ذالك له فقال : إنها ليست من سنة الصلاة ، ولاكني أفعل ذالك من أجل أني أشتكي ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17289 عن علي بن عبد الرحمان الأنصاري قال :(@)(@@) | 30 ( صليت إلاى جنب ابن عمر رضي الله عنهما فرآني أقلب بالحصاى في الصلاة ، فلما فرغ قال : إن تقليب الحصاى PageV20P378 في الصلاة من الشيطان ، ولاكن كما كان رسول الله يصنع : إذا جلس في الصلاة كفه اليسراى علاى فخذه اليسراى باسطها عليها ووضع كفه اليمناى على فخذه المناى ، وقبض أصابعه ، وأشار بأصبعه التي 
ms7259	 تلي الإبهام ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17290 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( كان عمر يحلف : وأباى ، فنهاه رسول الله ، وقال : من حلف بشيء من دون الله تعالاى فقد أشرك أو قال : ألا هو شرك ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17291 حدثنا مالك ، عن نافع ، عن بن عمر رضي الله عنهما :(@)(@@) | 30 ( أنه قال لرجل سأله عن القتال مع الحجاج أو ابن الزبير ؟ فقال له ابن عمر : مع أي الفريقين قاتلت فقتلت ففي لظى ) . ( نعيم بن حماد في الفتن ) . )(@)(@@)(@@)(@@) $ 17292 عن ابن عمر رضي الله عنهما(@)(@@) | 30 أنه قال يوم قتل عثمان رضي الله عنه : ( والله لئن قتلتموه لا تصلوا جميعا أبدا ، ولا تجاهدوا جميعا أبدا ، ولا تحجوا جميعا أبدا ، إلا أن تحضر الأبدان والأهواء مختلفة ) . ( نعيم ) . )(@)(@@)(@@)(@@) $ 17293 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( كنت عند النبي وهو يأكل جهارا ، فقال : ( إن من الشجر كالرجل المؤمن ، فأردت أن أقول : هي النخلة ، فنظرت في وجوه القوم فإذا أنا أحدثهم ، فقال رسول الله : هي النخلة ) . ( الرامهرمزي ) . )(@)(@@)(@@)(@@) $ 17294 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( قال رسول الله : أخبروني بشجرة كالرجل المسلم ، تؤتي أكلها كل حين بإذن ربها ، لا يتحات ورقها ؟ ثم قال : هي النخلة ) . ( الرامهرمزي ) . )(@)(@@)(@@)(@@) $ 17295 عن ابن عمر رضي الله عنهما :(@)(@@) | 30 ( أن النبي ذكر الخيل فقال : أعرافها أدفاؤها ، وأذنابها مذابها ) . ( الرامهرمزي في الأمثال ، وفيه محمد بن عبد الملك الكوفي ضعيف ) . )(@)(@@) PageV20P379(@)(@@)(@@)(@@) $ 17296 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( ذكر النبي الدجال ، وذكر من علاماته وأماراته ومعربات أمره ، حتى ظن الملا أنه ثائر عليهم من النخل ، ثم قام ليغير ثيابه ، ثم عاد ، وقد اشتد تخوف من حضره وبكاؤهم ، فقال : مهيم ما الذي أبكاكم ؟ قالوا : ذكرت الدجال ، وقربت أمره ، حتى ظننا أنه ثائر علينا ، أو خارج من النخل علينا ، فقال رسول الله : إن يخرج وأنا فيكم فأنا حجيجه ، وإن يخرج ولست فيكم ، فالمرء حجيج نفسه ، والله خليفتي علاى كل مؤمن ، أحد عينيه مطموسة ، والأخراى ممزوجة بالدم كأنها البعرة ) . ( نعيم بن حماد في الفتن 
ms7260	 ) . )(@)(@@)(@@)(@@) $ 17297 عن حبيب بن أبي ثابت قال :(@)(@@) | 30 ( كان ابن عمر رضي الله عنهما يستنجي بالأحجار ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17298 عن عبد الله بن دينار قال :(@)(@@) | 30 ( رأيت ابن عمر رضي الله عنهما يبول قائما ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17299 عن نافع ، عن ابن عمر رضي الله عنهما :(@)(@@) | 30 ( أنه كان يغسل يده قبل أن يدخلها في الوضوء ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17300 عن نافع قال :(@)(@@) | 30 ( كان ابن عمر رضي الله عنهما لا يبول إلا غسل وجهه ويديه ، وما أراه ذكر الله قط إلا كذالك ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17301 عن عطاء بن أبي رباح ، عن ابن عمر رضي الله عنهما :(@)(@@) | 30 ( أنه جاءه رجل من أهل البصرة ، فسأله عن إرسال العمامة خلفه ؟ فقال ابن عمر : سأخبرك ذالك حتى تعلم ، كنت عاشر عشرة في مسجد رسول الله : أبو بكر . وعمر ، وعثمان ، وعلي ، وابن مسعود ، ومعاذ ، وحذيفة ، وعبد الرحمان بن عوف ، وأبو سعيد وابن عمر رضي الله عنهم ، فأمر رسول الله ابن عوف أن يتجهز بسرية يبعثه عليها ، فأصبح وقد اعتم بعمامة كرابيس سود ، فأدناه النبي ثم نقضها ، فعممه ، فأرسل من خلفه PageV20P380 أربع أصابع أو نحو ذالك ، ثم قال : هاكذا ياابن عوف فاعتم فإنها أعرب وأحسن ، ثم أمر بلالا رضي الله عنه أن يدفع إليه اللواء ، فحمد الله وأثناى عليه وصلى علاى النبي ؛ ثم قال : خذ ياابن عوف ، فاغز في سبيل الله ، وقاتل من كفر بالله ، لا تغلوا ولا تغدروا ، ولا تقتلوا وليدا ، فهاذا عهد الله وسنة نبيه فيكم ) . ( أبو نعيم في المعرفة ، وفيه خالدبن يزيدبن أبي مالك ضعيف ) . )(@)(@@)(@@)(@@) $ 17302 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( إن كنا لنتحدث أن أبواب السماء تفتح عند أذان كل صلاة ) . ( أبو الشيخ ) . )(@)(@@)(@@)(@@) $ 17303 عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( إذا كان المريض لا يقدر علاى الركوع أومأ برأسه ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17304 عن نافع :(@)(@@) | 30 ( أن ابن عمر رضي الله عنهما أغمي عليه شهرا فلم يقض ما فاته وصلى يومه الذي أفاق منه ) . ( عب ) . )(@)(@@)(@@)(@@) $ 17305 عن نافع :(@)(@@) | 30 ( أن ابن عمر رضي 