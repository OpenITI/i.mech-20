ms681	(@)(@@) يروي عن: ابن عمر، روى عنه: الأخضر بن عجلان، وهو الذي يقال له: ابن الأصبغ.(@)(@@)(@@)(@@) ||| AUTO عطاء بن إبراهيم(@)(@@) مولى الزبير بن العوام، يروي عن: علي، ومعقل بن يسار، روى عنه: علي بن صالح، وابنه عبد الله بن عطاء.(@)(@@) عطاء(@)(@@) مولى ابن أبي أحمد، يروي عن: أبي هريرة، بعث رسول الله صلى الله عليه وسلم بعثا، روى عنه: سعيد المقبري، من حديث عبد الحميد بن جعفر.(@)(@@)(@@)(@@) ||| AUTO عطاء بن عطاء البزاز(@)(@@) مولى بني يشكر، وهو والد يزيد بن عطاء الكندي، يروي عن: أنس بن مالك، روى عنه: عبد الله بن عون، والشيباني.(@)(@@)(@@)(@@) ||| AUTO عطاء أبو محمد(@)(@@) مولى أبي طلحة، شيخ، يروي عن: علي بن أبي طالب، روى عنه: علي بن صالح، ووكيع بن الجراح.(@)PageV01P002(@)(@@) [ج 2: ص 386](@)(@@)(@@)(@@) ||| AUTO عطاء بن زياد(@)(@@) يروي عن: أبي هريرة، روى محمد بن الذيال، عن أبي يعقوب البصري عنه.(@)(@@)(@@)(@@) ||| AUTO عطاء بن كنود(@)(@@) من الأبناء، وهو أول من جمع القرآن باليمن زمانا، روى عنه: أهلها.(@)(@@)(@@)(@@) ||| AUTO عطاء النهدي(@)(@@) من أهل البصرة، يروي عن: ابن عمر، روى عنه: مجزأة بن زاهر.(@)(@@)(@@)(@@) ||| AUTO عطاء بن ميسرة، كنيته أبو أيوب(@)(@@) يروي عن: عمر، روى عنه: عروة بن رويم، وأشرس.(@)(@@)(@@)(@@) ||| AUTO عطاء بن أبي سلمة، ويقال: ابن سلمة(@)(@@) يروي عن: أم سلمة، روى عنه: أبو بكر مولى بني تميم.(@)(@@)(@@)(@@) ||| AUTO عطاء بن عمرو بن سعيد(@)(@@) يروي عن: ابن عمر، روى عنه: ابن جريج.(@)(@@)(@@)(@@) ||| AUTO عطاء أبو عبد الله(@)(@@) يروي عن: ابن عباس، روى عنه: فطر بن خليفة.(@)(@@)(@@)(@@) ||| AUTO عطاء بن حنين، وقد قيل: ابن جرير(@)(@@) من أهل الشام، يروي عن: عمر، وعثمان، روى عنه: عمرو بن دينار، وقيس بن عبد الملك بن مخرمة.(@)(@@)(@@)(@@) ||| AUTO عطاء بن خليفة(@)(@@) يروي عن: أبي هريرة، إن كان سمع منه، روى عنه: أبو النصر مولى محمد بن عبيد الله.(@)(@@)(@@)(@@) ||| AUTO عطاء المدني(@)(@@) يروي عن: أبي هريرة في صلاة الجمع، لا أدرى من هو ولا ابن من هو.(@)(@@)(@@)(@@) ||| AUTO علقمة بن قيس بن عبد الله بن 
ms682	 مالك بن علقمة بن سلامان بن كهيل بن بكر بن عوف بن النخع الكوفي، كنيته أبو شبل PageV01P002 [ج 2: ص 387](@)(@@) يروي عن: عمر، وعلي، روى عنه: الشعبي، والنخعي، وكان راهب أهل الكوفة عبادة وعلما وفضلا وفقها، وكان من أشبههم بعبد الله بن مسعود هديا ودلا، وهو عم الأسود بن يزيد، وخال إبراهيم النخعي، لأن أم إبراهيم النخعي كانت أخت الأسود بن يزيد، مات علقمة سنة ثنتين وستين، ولم يولد له قط، وكان قد غزا خراسان، وأقام بخوارزم سنتين، ودخل مرو فأقام بها مدة يصلي ركعتين ركعتين،(@)(@@) (198) -[2: 387] ثنا الحسن بن سفيان، قال: ثنا أبو بكر بن أبي شيبة، قال: ثنا حريز، عن منصور، عن إبراهيم، قال: " قرأ علقمة القرآن في ليلة وطاف بالبيت أسبوعا، ثم أتى المقام فصلى عنده، ثم قرأ بالمئين ثم طاف أسبوعا، ثم أتى المقام، فصلى عنده، ثم قرأ بالمثاني، ثم طاف أسبوعا، ثم أتى المقام فصلى عنده، ثم قرأ بقية القرآن "(@)(@@)(@@)(@@) ||| AUTO علقمة بن وقاص الليثي(@)(@@) من أهل المدينة، يروي عن: عمر، وعائشة، روى عنه: الزهري، وابناه عمرو، وعبد الله، وهو جد محمد بن عمرو بن علقمة، مات في ولاية عبد الملك بن مروان بالمدينة، وهو علقمة بن وقاص بن محصن بن كلدة بن عبد ياليل بن طريف.(@)(@@)(@@)(@@) ||| AUTO علقمة بن وائل بن حجر الحضرمي الكندي(@)(@@) عداده في أهل الكوفة، وهو أخو عبد الجبار بن وائل، علقمة سمع أباه، وعبد الجبار لم يره، مات أبوه وأمه حامل به، يروي عن: أبيه، روى عنه: حصين، وسماك، وأهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO علقمة بن عبد الله بن هلال المزني(@)(@@) أخو بكر بن عبد الله، يروي PageV01P002 [ج 2: ص 388] عن: ابن عمر، ومعقل بن يسار، روى عنه: عبد الملك بن حبيب، وأبو عمران الجوني، وأهل البصرة، مات سنة مائة في خلافة عمر بن عبد العزيز.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO علقمة بن سفيان بن عبد الله الثقفي الطائفي(@)(@@) يروي عن: أبي أيوب، وعقبة بن عامر، روى عنه: أبو الزبير، وقد روى الليث، عن أبي الزبير، فقال: عن 
ms683	 سفيان بن عبد الرحمن، عن عاصم بن سفيان الثقفي، عن أبي أيوب في الوضوء.(@)(@@)(@@)(@@) ||| AUTO علقمة بن بجالة بن الزبرقان(@)(@@) من أهل اليمن، يروي عن: أبي هريرة، روى عنه: عكرمة بن عمار.(@)(@@) علقمة(@)(@@) والد نافع، يروي عن: كعب بن مالك، روى عنه: ابن القاري.(@)(@@)(@@)(@@) ||| AUTO علقمة بن الغرق(@)(@@) يروي عن: ابن عباس، وأبي هريرة، روى عنه: سعيد بن زياد الشيباني.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO علقمة بن يزيد(@)(@@) كتب إليه عمر بن الخطاب، روى عنه: زيد بن رفيع.(@)(@@)(@@)(@@) ||| AUTO علقمة بن أبي علقمة(@)(@@) مولى عائشة، واسم أبيه: بلال، سمع أنس بن مالك، ويروي عن: أمه، عن عائشة، واسم أمه: مرجانة، عداده في أهل المدينة، روى عنه: مالك بن أنس، وسليمان بن بلال.(@)(@@)(@@)(@@) ||| AUTO علقمة بن شهاب القشيري(@)(@@) والد محفوظ بن علقمة، روى عن: أصحاب رسول الله صلى الله عليه وسلم عداده في أهل الشام، روى عنه: ابنه محفوظ بن علقمة.(@)(@@) علقمة بن يزيد(@)(@@) يروي عن: عمر، روى عنه: زيد بن أبي أنيسة.(@)PageV01P002(@)(@@) [ج 2: ص 389](@)(@@)(@@)(@@) ||| AUTO عيسى بن طلحة بن عبيد الله التيمي القرشي(@)(@@) يروي عن: أبيه، وعبد الله بن عمر، وابن عمرو، كان من أفاضل أهل المدينة، وعقلائهم، وأسخيائهم، روى عنه: الزهري، وطلحة بن يحيى، مات سنة مائة، وأمه: سعدى بنت عوف بن حارثة بن سنان المري.(@)(@@)(@@)(@@) ||| AUTO عيسى بن هلال الصدفي(@)(@@) من أهل مصر، يروي عن: عبد الله بن عمرو، روى عنه: كعب بن علقمة، وعياش بن عباس.(@)(@@)(@@)(@@) ||| AUTO عيسى بن سهل بن رافع بن خديج الأنصاري(@)(@@) من أهل المدينة، يروي عن: جده رافع بن خديج، روى عنه: سعيد بن يزيد أبو شجاع.(@)(@@)(@@)(@@) ||| AUTO عيسى بن حطان الرقاشي(@)(@@) يروي عن: عبد الله بن عمرو، عداده في أهل البصرة، روى عنه: محمد بن جحادة، وعلي بن زيد بن جدعان.(@)(@@)(@@)(@@) ||| AUTO عيسى بن معقل بن أبي معقل(@)(@@) من أسد خزيمة، يروي عن: جدته أم معقل، ولها صحبة، روى عنه: موسى بن عقبة، ومحمد بن إسحاق.(@)(@@)(@@)(@@) ||| AUTO عيسى بن عبد الله بن أنيس الأنصاري(@)(@@) عن: 
ms684	 أبيه، ولأبيه صحبة، روى عنه: عبيد الله بن عمر العمري.(@)(@@)(@@)(@@) ||| AUTO عيسى بن جارية الأنصاري(@)(@@) من أهل المدينة، يروي عن: جابر بن عبد الله، روى عنه: يعقوب القمي، وعنبسة.(@)PageV01P002(@)(@@) [ج 2: ص 390](@)(@@)(@@)(@@) ||| AUTO عيسى بن حطان العائذي(@)(@@) يروي عن: علي، روى عنه: عبد الملك بن مسلم.(@)(@@)(@@)(@@) ||| AUTO عيسى بن أبي رقبة المدني(@)(@@) يروي عن: ابن عمر، روى عنه: عطاء بن السائب.(@)(@@)(@@)(@@) ||| AUTO عيسى بن النعمان بن رفاعة بن رافع الزرقي الأنصاري(@)(@@) يروي عن: خولة، عداده في أهل المدينة، روى عنه ابنه: محمد بن عيسى، وأحسبه الذي روى عنه: زيد بن حباب.(@)(@@)(@@)(@@) ||| AUTO عيسى بن خثيم الحنفي(@)(@@) من أهل اليمامة، يروي عن: ابن عمر، روى عنه: يحيى بن أبي كثير، وحاجب بن قدامة.(@)(@@)(@@)(@@) ||| AUTO عيسى القرشي(@)(@@) من آل عمار بن ياسر، يروي عن: عثمان بن عفان، روى عنه: ابنه الوليد بن عيسى.(@)(@@)(@@)(@@) ||| AUTO عيسى البزاز(@)(@@) مولى حذيفة بن اليمان، يروي عن: حذيفة بن اليمان، روى عنه: يحيى الجابر.(@)(@@)(@@)(@@) ||| AUTO عيسى بن موسى بن محمد بن إياس بن البكير(@)(@@) يروي عن: أسامة بن زيد، روى عنه: عياش بن عباس.(@)(@@)(@@)(@@) ||| AUTO عيسى بن يزداد بن فساة(@)(@@) يروي عن: أبيه، روى عنه: زمعة بن صالح.(@)(@@)(@@)(@@) ||| AUTO عمران بن ملحان، أبو رجاء العطاردي، ويقال: عمران بن تيم PageV01P002 [ج 2: ص 391](@)(@@) وقد قيل: عمران بن عبد الله، ويقال: عطارد بن برز، أدرك النبي صلى الله عليه وسلم وهو شاب ثم أسلم بعد أن قبض رسول الله صلى الله عليه وسلم يروي عن: جماعة من أصحاب رسول الله صلى الله عليه وسلم روى عنه: الناس، مات وله نيف وعشرون ومائة سنة سبع عشرة ومائة.(@)(@@)(@@)(@@) ||| AUTO عمران بن طلحة بن عبيد الله التيمي القرشي(@)(@@) أخو عيسى، وموسى، ومحمد، ويحيى، يروي عن: علي، روى عنه: إبراهيم بن محمد بن طلحة، وهو الذي يروي عن: أمه حمنة بنت جحش قصة الاستحاضة، وأمه حمنة بنت جحش بن رياب بن يعمر بن صبرة.(@)(@@) (199) -[2: 391] ثنا عمر بن محمد الهمداني، قال: ثنا مسلم بن قتيبة، قال: 
ms685	 ثنا منصور بن دينار، عن معاوية بن إسحاق، عن عمران بن طلحة بن عبد الله، قال: دخلت على علي فقرب مجلسي، وقال: " إني لأرجو أن أكون أنا وطلحة ممن قال الله عز وجل {ونزعنا ما في صدورهم من غل إخوانا على سرر متقابلين} ". فقال الحارث: الله أعلى وأجل، فقال: لا أم لك(@)(@@)(@@)(@@) ||| AUTO أبو حمزة القصاب اسمه عمران بن أبي عطاء(@)(@@) مولى بني أسد، عداده في أهل واسط، يروي عن: ابن عباس، وأنس، روى عنه: الثوري، وشعبة.(@)(@@)(@@)(@@) ||| AUTO عمران بن بشر الحضرمي(@)(@@) من أهل الشام، يروي عن: عبد الله بن بشر، روى عنه: أبو حيوة شريح بن يزيد.(@)(@@)(@@)(@@) ||| AUTO عمران بن سوادة(@)(@@) يروي عن: عمر، عداده في أهل الحجاز، روى عنه: عبد الرحمن بن أبي زيد، وهو الذي يقال له: عمران بن سودة، ويقال له أيضا: عمران بن أبي سبرة، مات سنة عشرة ومائة، وهو ابن اثنتين وسبعين سنة، وقد قيل: عمران بن أبي سودة.(@)(@@)(@@)(@@) ||| AUTO عمران بن سليم الحضرمي(@)(@@) يروي عن: ابن عمر، عداده في أهل مصر، روى عنه: عمران بن الحارث، وعياش بن عباس.(@)(@@)(@@)(@@) ||| AUTO عمران بن سليم الكلاعي(@)(@@) قاضي حمص، يروي عن: أبي هريرة، روى عنه: معاوية بن صالح، وحريز بن عثمان، وأهل حمص، وكان مكحول، يقول: ما نزل الشام قاض PageV01P002 [ج 2: ص 392] مثله.(@)(@@) (200) -[2: 392] ثنا أحمد بن عمر بن يوسف بدمشق، قال: ثنا محمد بن عوف، قال: ثنا عثمان بن سعيد، قال: ثنا إسماعيل بن عياش، ثنا عمر بن سعد، قال: ثنا عمران بن سليم، عن أبي هريرة، قال: قال رسول الله صلى الله عليه وسلم: " المطل ظلم الغريم إذا كان معك حقه، ثم قلت: اصبر حتى تذهب إلى البيت فقد مطلته وإذا مطلته فقد ظلمته "(@)(@@)(@@)(@@) ||| AUTO عمران بن نمران أبو سليمان(@)(@@) أدرك عمر وفتح حمص، روى عنه: يزيد بن خمير.(@)(@@)(@@)(@@) ||| AUTO عمران بن الحارث السلمي، أبو الحكم(@)(@@) من أهل الكوفة، يروي عن: ابن عباس، روى عنه: سلمة بن كهيل وحصين.(@)(@@)(@@)(@@) ||| AUTO عمران بن عوف الغافقي(@)(@@) من 
ms686	 أهل مصر، يروي عن: ابن عمر، روى عنه: موسى بن أبي حملة، وسليمان بن زياد.(@)(@@)(@@)(@@) ||| AUTO عمران بن سعيد(@)(@@) يروي عن: ابن عباس وابن الزبير، روى عنه الأجلح.(@)(@@)(@@)(@@) ||| AUTO عمران بن عبد المعافري(@)(@@) يروي عن: عبد الله بن عمرو، روى عنه: المصريون، يعتبر بحديثه من غير حديث عبد الرحمن بن زياد الإفريقي عنه.(@)(@@)(@@)(@@) ||| AUTO عمران بن أبي أنس(@)(@@) وهو عمران بن عبد العزيز بن شرحبيل بن حسنة، أحد بني عامر بن لؤي، من أهل المدينة، يروي عن: أبي خراش السلمي، وله صحبة، سمع النبي صلى الله عليه وسلم يقول: " من هجر أخاه سنة فهو كسفك دمه "، روى عنه: ابن إسحاق، والوليد بن أبي الوليد، مات سنة سبع عشرة ومائة.(@)PageV01P002(@)(@@) [ج 2: ص 393](@)(@@)(@@)(@@) ||| AUTO عمران بن وهب(@)(@@) شيخ، يروي عن: أنس بن مالك، روى عنه: إسحاق بن سليم.(@)(@@)(@@)(@@) ||| AUTO عمران بن حذيفة(@)(@@) يروي عن: ميمونة، روى عنه: زياد بن عمرو بن هند.(@)(@@)(@@)(@@) ||| AUTO عمران بن سريع(@)(@@) يروي عن: حذيفة، روى عنه: علقمة بن مرثد.(@)(@@)(@@)(@@) ||| AUTO عمران بن عصام الضبعي(@)(@@) كان على قضاء البصرة، يروي عن: عمران بن حصين، وأبيه، ولأبيه صحبة، روى عنه: قتادة، وأبو التياح، كان مع ابن الأشعث، فلما غلب الحجاج على ابن الأشعث، أسر عمران بن عصام، فضرب عنقه صبرا، وذلك في يوم الزاوية.(@)(@@)(@@)(@@) ||| AUTO عمران بن حطان السدوسي(@)(@@) عن: عائشة، وابن عمر، وابن عباس كان يميل إلى مذهب الشراة، روى عنه: محمد ابن سيرين، ويحيى بن أبي كثير، وصالح بن سرج.(@)(@@)(@@)(@@) ||| AUTO عمران بن أبي الجعد(@)(@@) يروي عن: ابن عمر، روى عنه: إسماعيل بن أبي خالد.(@)(@@)(@@)(@@) ||| AUTO عمران النخلي(@)(@@) من أهل الكوفة، يروي عن: ابن عمر، روى عنه: شريك النخعي، وابنه حماد بن عمران.(@)(@@)(@@)(@@) ||| AUTO عمران بن قيس(@)(@@) يروي عن: ابن عمر، روى عنه: حريث بن أبي مطر.(@)PageV01P002(@)(@@) [ج 2: ص 394](@)(@@)(@@)(@@) ||| AUTO عمران بن مسلم بن رياح الثقفي(@)(@@) من أهل الكوفة، يروي عن: عبد الله بن مغفل، روى عنه: الثوري.(@)(@@)(@@)(@@) ||| AUTO عمران بن حميري الجعفي(@)(@@) يروي عن: عمار بن 
ms687	 ياسر، روى عنه: نعيم بن جهضم، ويقال: ابن ضمعج.(@)(@@)(@@)(@@) ||| AUTO عمران العمي(@)(@@) يروي عن: أنس بن مالك، عداده في أهل البصرة، روى عنه: جعفر بن برقان، وحرب بن ميمون، يخطئ.(@)(@@)(@@)(@@) ||| AUTO عمران بن عمار(@)(@@) شيخ كوفي، يروي المراسيل، روى عنه: محمد بن جحادة.(@)(@@)(@@)(@@) ||| AUTO عمران بن عبد الله الأنصاري(@)(@@) يروي عن: ابن عمر، روى عنه: ابنه محمد بن عمران.(@)(@@)(@@)(@@) ||| AUTO عقبة بن عبد الغافر الأزدي العوذي، كنيته أبو نهار، ويقال: أبو عمار(@)(@@) يروي عن: أبي سعيد الخدري، روى عنه: يحيى بن أبي كثير، وقتادة، والبصريون، قتل في الجماجم سنة ثلاث وثمانين.(@)(@@)(@@)(@@) ||| AUTO عقبة بن أوس السدوسي(@)(@@) من أهل البصرة، يروي عن: عبد الله بن عمرو، روى عنه: القاسم بن ربيعة.(@)(@@)(@@)(@@) ||| AUTO عقبة بن ميسرة(@)(@@) يروي عن: معقل بن يسار، روى عنه: حميد الطويل.(@)(@@)(@@)(@@) ||| AUTO عقبة بن صهبان الأزدي الحداني الراسبي(@)(@@) من أهل البصرة، PageV01P002 [ج 2: ص 395] يروي عن: عبد الله بن مغفل، روى عنه: قتادة، مات في أول ولاية الحجاج.(@)(@@)(@@)(@@) ||| AUTO عقبة بن أبي الحسناء اليماني(@)(@@) يروي عن: أبي هريرة، روى عنه: فرقد السبخي.(@)(@@)(@@)(@@) ||| AUTO عقبة بن وساج بن حصن الأزدي البرساني(@)(@@) نزل على عبد الله بن عمرو بالشام، وقد رأى أنسا، وهو الذي يروي عن: أبي الأحوص، عن عبد الله، روى عنه: قتادة، قتل في الجماجم سنة ثلاث وثمانين.(@)(@@)(@@)(@@) ||| AUTO عقبة بن حريث التغلبي(@)(@@) من أهل الكوفة، يروي عن: ابن عمر، روى عنه: شعبة بن الحجاج.(@)(@@)(@@)(@@) ||| AUTO عقبة أبو الأخضر الضبعي(@)(@@) من أهل البصرة، يروي عن: ابن عمر، روى عنه: الشيباني.(@)(@@)(@@)(@@) ||| AUTO عقبة بن جبار(@)(@@) يروي عن: ابن مسعود، روى عنه: ربعي بن خراش.(@)(@@)(@@)(@@) ||| AUTO عقبة بن ربيعة(@)(@@) يروي عن: أبي هريرة، روى عنه: داود بن عبد الله.(@)(@@)(@@)(@@) ||| AUTO عقبة بن زرعة الشيباني(@)(@@) من أهل الشام، يروي عن: علي، ومعاوية، روى عنه: عبد الوارث بن صخر.(@)(@@)(@@)(@@) ||| AUTO عقبة بن ظبيان(@)(@@) يروي عن: علي، روى عنه: عاصم الجحدري.(@)PageV01P002(@)(@@) [ج 2: ص 396](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO عقبة بن نافع الفهري(@)(@@) يروي عن: ابن عمر، روى 
ms688	 جعفر بن برقان، عن راشد الأزرق عنه، وقد روى عنه: ليث بن سعد الحكايات، كان مستجاب الدعوة، له آثار في العبادة ومقامات في الزهادة.(@)(@@)(@@)(@@) ||| AUTO عقبة بن عبد الرحمن بن جابر(@)(@@) من أهل المدينة، يروي عن: جابر بن عبد الله جده، روى عنه: عبد الحميد بن يزيد.(@)(@@)(@@)(@@) ||| AUTO عقبة بن أبي عائشة(@)(@@) مولى بني ليث، يروي عن: عبد الله بن جابر البياضي، روى عنه: عبد الله بن سفيان بن عقبة.(@)(@@) (201) -[2: 396] ثنا أبو خليفة، قال: ثنا علي بن المدني، قال: ثنا عبد الله بن سفيان بن عقبة، قال: سمعت جدي عقبة بن أبي عائشة، يقول: رأيت عبد الله بن جابر البياضي صاحب رسول الله صلى الله عليه وسلم " يضع إحدى يديه على ذراعه في الصلاة "(@)(@@)(@@)(@@) ||| AUTO عقبة بن مسلم التجيبي(@)(@@) من أهل مصر، يروي عن: ابن عمر، وعقبة بن عامر، روى عنه: حيوة بن شريح.(@)(@@)(@@)(@@) ||| AUTO عقبة بن أبي عتاب المدني، ويقال: ابن أبي غياث(@)(@@) يروي عن: أبي هريرة، روى عنه: ابنه محمد بن عقبة.(@)(@@)(@@)(@@) ||| AUTO عقبة بن يريم(@)(@@) يروي عن: أبي ثعلبة الخشني، عداده في أهل الشام، روى عنه: عروة بن رويم اللخمي.(@)(@@) عقبة(@)(@@) مولى أدلم بن ناعمة الحضرمي، يروي عن: الحسين بن علي، عداده في أهل الكوفة، روى عنه: عبد الملك بن الحارث.(@)(@@)(@@)(@@) ||| AUTO عقبة بن ميسرة، أبو إسماعيل(@)(@@) يروي عن: رجل من أصحاب النبي صلى الله عليه وسلم روى عنه: أبو عاصم النبيل.(@)PageV01P002(@)(@@) [ج 2: ص 397](@)(@@)(@@)(@@) ||| AUTO عقبة الرفاعي(@)(@@) يروي عن: عبد الله بن الزبير، روى عنه: ابنه محمد بن عقبة، إن لم يكن ابن أبي عتاب فلا أدرى من هو.(@)(@@)(@@)(@@) ||| AUTO عقبة بن معبد(@)(@@) يروي المراسيل، روى عنه: بكر بن سوادة.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO عكرمة(@)(@@) مولى ابن عباس، كنيته أبو عبد الله، يروي عن: ابن عباس، وأبي سعيد الخدري، وعائشة، وأبي هريرة، روى عنه: الشعبي، وجابر بن زيد، والناس، كان عكرمة من علماء الناس في زمانه بالقرآن والفقه، وكان جابر بن زيد يقول: عكرمة من أعلم الناس، ومن زعم 
ms689	 إنا كنا نتقي حديث عكرمة فلم ينصف إذ لم نتقي الرواية عن إبراهيم بن أبي يحيى وذويه، ولا يجب على من شم رائحة العلم أن يعرج على قول يزيد بن أبي زياد، حيث يقول: دخلت على علي بن عبد الله بن عباس، وعكرمة مقيد على باب الحش، قلت: من هذا، قال: إن هذا يكذب على أبي، ومن أمحل المحال أن يجرح العدل بكلام المجروح لأن يزيد بن أبي زياد ليس ممن يحتج بنقل حديثه، ولا بشيء يقوله أيوب بن رزين، عن نافع، قال: سمعت ابن عمر، يقول: يا نافع لا تكذب علي كما يكذب عكرمة على ابن عباس، قلت: أما عكرمة فحمل أهل العلم عنه الحديث والفقه في الأقاليم كلها وما أعلم أحدا ذمه بشيء إلا بدعابة كانت فيه، مات سنة سبع ومائة، وقد قيل: سنة خمس ومائة، مات هو وكثير عزة في يوم واحد، فأخرج جنازتهما، وقال الناس: مات أفقه الناس وأشعر الناس، وكان لعكرمة يوم مات أربع وثمانون سنة، وكان متزوجا بأم سعيد بن جبير.(@)(@@) عكرمة(@)(@@) مولى ابن عباس، يروي عن: ابن عباس، روى عنه: العوام بن حوشب، وليس هذا بعكرمة الأول، هذا يروي الحكايات وما أعلم له راويا إلا العوام بن حوشب.(@)(@@)(@@)(@@) ||| AUTO عكرمة بن خالد بن العاص بن هشام بن المغيرة بن عبد الله بن عمر بن مخزوم بن يقظة بن مرة بن كعب بن لؤي بن غالب بن فهر المخزومي القرشي PageV01P002 [ج 2: ص 398] يروي عن: ابن عمر، وهو الذي يروي عن: سعيد بن جبير، عداده في أهل مكة، روى عنه: حنظلة بن أبي سفيان، وابن جريج، مات بعد عطاء بن أبي رباح، وعطاء مات سنة خمس عشرة ومائة، وأمه أم معبد بنت كليب بن حرب بن معاوية بن زيد.(@)(@@)(@@)(@@) ||| AUTO عكرمة بن يعلى بن أمية الثقفي(@)(@@) يروي عن: ابن عمر، ومعاوية بن أبي سفيان، روى عنه: نافع بن جبير.(@)(@@)(@@)(@@) ||| AUTO عكرمة بن محمد الدؤلي(@)(@@) يروي عن: أبي هريرة، روى عنه: الزهري.(@)(@@)(@@)(@@) ||| AUTO عكرمة بن حصن 
ms690	(@)(@@) شيخ، يروي عن: علي، روى عنه: عبد الأعلى.(@)(@@)(@@)(@@) ||| AUTO عكرمة بن عبد الرحمن بن الحارث بن هشام المخزومي(@)(@@) أخو أبي بكر بن عبد الرحمن بن الحارث بن هشام، يروي عن: عمر، وأم سلمة، وجماعة من أصحاب النبي صلى الله عليه وسلم روى عنه: الزهري، ويحيى بن عبد الله بن صيفى، مات سنة ثلاث ومائة، وأمه فاختة بنت عتبة بن سهل بن عمرو بن عبد شمس بن عبد ود، وهى أم أبي بكر، ومحمد، وعمر، وعكرمة بني عبد الرحمن بن الحارث.(@)(@@)(@@)(@@) ||| AUTO عكرمة بن عمار العجلي(@)(@@) من أهل اليمامة، كنيته أبو عمار، يروي عن: الهرماس بن زياد، وله صحبة، روى عنه: الثوري، وأبو الوليد الطيالسي، مات سنة تسع وخمسين ومائة، أدخلناه في هذه الطبقة لأن له لقيا وسماعا من الصحابي، ومتى صح ذلك دخل في جملة التابعين، سواء قلت روايته أو كثرت، وأما روايته عن يحيى بن أبي كثير ففيه اضطراب، كان يحدث من غير كتابة.(@)PageV01P002(@)(@@) [ج 2: ص 399](@)(@@)(@@)(@@) ||| AUTO عاصم بن عمر بن الخطاب(@)(@@) يروي عن: أبيه، روى عنه: ابنه حفص بن عاصم، وأهل المدينة، مات سنة سبعين بالربذة قبل عبد الله بن عمر، كنيته أبو عمر، وأمه جميلة بنت ثابت بن أبي الأفلح قيس بن عصمة بن مالك.(@)(@@)(@@)(@@) ||| AUTO عاصم بن لقيط بن صبرة العقيلي(@)(@@) من أهل الطائف، وهو الذي يقال له: عاصم بن أبي رزين، يروي عن: أبيه، روى عنه: إسماعيل بن كثير.(@)(@@)(@@)(@@) ||| AUTO عاصم بن عمر بن قتادة بن النعمان الظفري الأنصاري الأوسي(@)(@@) من أهل المدينة، يروي عن: أنس بن مالك، وجابر بن عبد الله، وهو الذي يروي عن: محمود بن لبيد، روى عنه: بكر بن الأشج، وأبو إسحاق، وابن عجلان، مات سنة تسع عشرة ومائة، وقد قيل: سنة عشرين، كنيته أبو محمد.(@)(@@)(@@)(@@) ||| AUTO عاصم بن لاحق(@)(@@) يروي عن: ابن مسعود، روى عنه: سماك بن حرب.(@)(@@)(@@)(@@) ||| AUTO عاصم بن حميد السكوني(@)(@@) من أهل اليمن، يروي عن: معاذ بن جبل، وعوف بن مالك، وعائشة، عداده في أهل الشام، روى 
ms691	 عنه: أهلها، وأزهر بن سعيد، ومالك بن دينار.(@)(@@)(@@)(@@) ||| AUTO عمرو(@)(@@) من أهل المدينة، يروي عن: علي، روى عنه: عمرو بن سليم الزرقي.(@)PageV01P002(@)(@@) [ج 2: ص 400](@)(@@)(@@)(@@) ||| AUTO عاصم بن سفيان بن عبد الله بن ربيعة بن معتب بن مالك بن عمرو بن كعب بن سعيد بن عوف بن ثقيف الثقفي(@)(@@) أخو عبد الله بن سفيان، يروي عن: أبي أيوب الأنصاري، وعقبة بن عامر، روى عنه: ابنه بشر بن عاصم، وسفيان بن عبد الرحمن.(@)(@@)(@@)(@@) ||| AUTO عاصم بن بشر السلولي(@)(@@) أدرك جماعة من أصحاب رسول الله صلى الله عليه وسلم روى عنه: أهل العراق، مات في ولاية بشر بن مروان على العراق.(@)(@@)(@@)(@@) ||| AUTO عاصم بن روبة،(@)(@@) يروي عن: أبي هريرة، روى عنه: أبو الجهم.(@)(@@)(@@)(@@) ||| AUTO عاصم العنبري(@)(@@) يروي عن: عمر بن الخطاب، روى عنه: أهل البصرة.(@)(@@)(@@)(@@) ||| AUTO عاصم بن عمرو البجلي(@)(@@) من أهل الشام، يروي عن: أبي أمامة، قدم العراق زمن خالد بن عبد الله القسري، فكتب عنه العراقيون: أهل الكوفة، وأهل البصرة، وهو الذي يروي عنه: فرقد السنجي، ويقول: ثنا عاصم بن عمرو النخعي، عن أبي أمامة.(@)(@@)(@@)(@@) ||| AUTO عاصم بن حبتر، أبو قدامة(@)(@@) العدوي، من أهل البصرة، يروي عن: أنس بن مالك، روى عنه: سليمان التيمي، وحميد الطويل.(@)(@@)(@@)(@@) ||| AUTO عاصم بن سليمان الأحول(@)(@@) مولى بني تميم، وقد قيل: مولى لآل زياد، كنيته أبو عبد الرحمن، وقد قيل: أبو عبد الله، عداده في أهل البصرة، يروي عن: أنس بن مالك، روى عنه: الثوري، وشعبة، والناس، مات سنة إحدى أو اثنتين وأربعين ومائة، وكان قاضيا على المدائن، كان يحيى القطان قليل الميل إليه.(@)PageV01P002(@)(@@) [ج 2: ص 401](@)(@@)(@@)(@@) ||| AUTO عاصم بن أبي عبيد(@)(@@) يروي عن: أم سلمة، روى عنه: موسى بن عقبة.(@)(@@)(@@)(@@) ||| AUTO عاصم العدوي(@)(@@) يروي عن: كعب بن عجرة، روى عنه: الشعبي.(@)(@@)(@@)(@@) ||| AUTO عاصم بن عمير العنزي(@)(@@) يروي عن: أنس، روى عنه: محمد بن أبي إسماعيل، وعمرو بن مرة.(@)(@@)(@@)(@@) ||| AUTO عاصم السلمي(@)(@@) يروي عن: أبي ذر، روى عنه: رزيق بن كريم.(@)(@@)(@@)(@@) ||| AUTO عاصم بن شميخ الغيلاني(@)(@@) أحد 
ms692	 بني تميم، يروي عن: أبي سعيد الخدري، روى عنه: عكرمة بن عمار.(@)(@@) (202) -[2: 401] أخبرنا إبراهيم بن خزيم، قال: ثنا عبد الله بن حميد، قال: ثنا يعقوب بن إسحاق الحضرمي، قال: ثنا عكرمة بن عمار، قال: حدثني عاصم بن شميخ الغيلاني، قال: أتيت المدينة في طلب عبد لي أبق، فانطلقوا بي إلى أبي سعيد الخدري فأدخلوني عليه، فإذا شيخ كبير " يصلي حين زالت الشمس معتمدا على جريدة إذا قام اعتمد عليها وإذا ركع أسندها إلى القبلة، وإذا سجد اعتمد عليها "(@)(@@)(@@)(@@) ||| AUTO عاصم بن شريب الزبيدي(@)(@@) من أهل الكوفة، يروي عن: علي، روى عنه: الزبيدي.(@)(@@)(@@)(@@) ||| AUTO عاصم أبو إسماعيل بن عاصم(@)(@@) من أهل الكوفة، يروي عن: ابن عباس، روى عنه: ابنه إسماعيل بن عاصم.(@)(@@)(@@)(@@) ||| AUTO عاصم بن العجاج الجحدري(@)(@@) من عباد أهل البصرة وقرائهم، يروي عن: أبي بكرة إن كان سمع منه، وقد رأى أنسا، روى عنه: هارون النحوي، مات سنة تسع وعشرين ومائة، وكنيته أبو المجشر.(@)PageV01P002(@)(@@) [ج 2: ص 402](@)(@@)(@@)(@@) ||| AUTO عاصم بن رزين(@)(@@) يروي عن: ابن عمر قوله، روى عنه: صالح بن راشد، وقد وهم من أطلق الضعف على العواصم كلهم حيث قال: ما في الدنيا عاصم إلا وهو ضعيف من غير دلالة ثبتت على صحة ما قاله.(@)(@@)(@@)(@@) ||| AUTO عمارة بن خزيمة بن ثابت الأنصاري(@)(@@) من أهل المدينة، من بلحارث بن كعب، كنيته أبو محمد، يروي عن: أبيه، وابن عباس، روى عنه: هشام بن عروة، والزهري، مات سنة خمس ومائة وهو ابن خمس وسبعين سنة.(@)(@@)(@@)(@@) ||| AUTO عمارة بن عمرو بن حزم النجاري الأنصاري(@)(@@) من أهل المدينة، يروي عن: أبيه، روى عنه: يحيى بن عبد الله بن عبد الرحمن بن سعد.(@)(@@)(@@)(@@) ||| AUTO عمارة بن حديد البجلي الكوفي(@)(@@) يروي عن: صخر الغامدي، روى عنه: يعلى بن عطاء.(@)(@@)(@@)(@@) ||| AUTO عمارة بن حزم(@)(@@) يروي عن: أبي بن كعب، روى ابن إسحاق، عن أبي بكر بن عبد الله بن محمد بن عمرو بن حزم عنه.(@)(@@)(@@)(@@) ||| AUTO عمارة بن ربيعة الجرمي(@)(@@) يروي عن: علي، روى عنه: يونس بن عبيد. 
ms693	(@)(@@)(@@)(@@) ||| AUTO عمارة بن عبد(@)(@@) يروي عن: ابن مسعود، روى عنه: أهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO عمارة بن قيس(@)(@@) مولى ابن الزبير، يروي عن: أبي هريرة، روى عنه: علي بن زيد بن جدعان.(@)(@@)(@@)(@@) ||| AUTO عمارة الداري(@)(@@) يروي عن: عائشة، روى عنه: عبيد بن مسلم.(@)PageV01P002(@)(@@) [ج 2: ص 403](@)(@@)(@@)(@@) ||| AUTO ابن أكيمة الليثي، كنيته أبو الوليد(@)(@@) من أهل الحجاز، اسمه: عمارة بن أكيمة، وقد قيل: عمرو بن مسلم بن أكيمة، ويقال: عمار بن أكيمة، يروي عن: أبي هريرة، روى عنه: الزهري، وسعيد بن أبي هلال، مات سنة إحدى ومائة وهو ابن تسع وسبعين سنة، ويشبه أن يكون المحفوظ عمار بن أكيمة وهو تابعي، روى عنه: الزهري، وابن ابنه عمرو بن مسلم بن عمار بن أكيمة من أتباع التابعين، يروي عن: سعيد بن المسيب، روى عنه: محمد بن عمرو، وأهل المدينة.(@)(@@)(@@)(@@) ||| AUTO عمارة بن عمير الليثي(@)(@@) من تيم الله بن ثعلبة، التيمي، من أهل الكوفة، يروي عن: عبد الله بن عمر، وهو الذي يروي عن: أبي معمر، روى عنه: سعد بن عبيدة، والأعمش، مات في ولاية سليمان بن عبد الملك.(@)(@@)(@@)(@@) ||| AUTO عمارة بن غزية(@)(@@) شيخ، يروي عن: أنس بن مالك، إن كان سمع منه، روى عنه: إسماعيل بن عياش.(@)(@@)(@@)(@@) ||| AUTO عمارة بن رباح الأنصاري(@)(@@) يروي عن: جماعة من الصحابة، روى عنه: البصريون.(@)(@@)(@@)(@@) ||| AUTO عمارة بن حارثة الضمري(@)(@@) يروي عن: عمرو بن يثربى وله صحبة، روى عنه: عبد الرحمن بن أبي سعيد.(@)(@@)(@@)(@@) ||| AUTO عمارة بن يحيى بن عرفطة(@)(@@) عن: خالد بن عرفطة، روى عنه: شقيق بن أبي عبد الله.(@)(@@)(@@)(@@) ||| AUTO عمارة بن عبد الكوفي(@)(@@) يروي عن: علي، روى عنه: أبو إسحاق السبيعي.(@)PageV01P002(@)(@@) [ج 2: ص 404](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO عمارة بن راشد بن مسلم بن كنانة(@)(@@) يروي عن: أبي هريرة، روى عنه: أهل الشام، ومصر.(@)(@@)(@@)(@@) ||| AUTO عمارة بن ثوبان(@)(@@) يروي عن: أبي الطفيل، روى عنه: جعفر بن يحيى بن ثوبان.(@)(@@) عمارة(@)(@@) شيخ من بلحارث بن كعب، يروي عن: ابن عباس، روى عنه: ابنه عبد الله، إن لم يكن ابن خزيمة بن 
ms694	 ثابت فلا أدرى من هو.(@)(@@)(@@)(@@) ||| AUTO عمارة بن عامر(@)(@@) يروي عن: أم الطفيل امرأة أبي بن كعب، عن النبي صلى الله عليه وسلم قال: " رأيت ربي " حديثا منكرا لم يسمع عمارة من أم الطفيل، وإنما ذكرته لكي لا يغر الناظر فيه فيحتج به من حديث أهل مصر.(@)(@@)(@@)(@@) ||| AUTO العلاء بن اللجلاج(@)(@@) يروي عن: عبد الله بن عمرو، وعبد الله بن عمر، روى عنه: ابناه عبد الرحمن بن العلاء، وعبد الله بن العلاء، روى عنهما: مبشر بن إسماعيل.(@)(@@)(@@)(@@) ||| AUTO العلاء بن زياد بن مطر العدوي(@)(@@) يروي عن: عمران بن حصين، عداده في أهل البصرة، روى عنه: قتادة، وأهل الشام، مات بالشام في آخر ولاية الحجاج بن يوسف سنة أربع وتسعين، وكان من العباد، كنيته أبو نصر.(@)(@@)(@@)(@@) ||| AUTO العلاء بن سفيان الحضرمي(@)(@@) يروي عن: عمر، روى عنه: أبو بكر بن أبي مريم، ويحيى بن خالد الحضرمي.(@)(@@)(@@)(@@) ||| AUTO العلاء بن أبي حكيم(@)(@@) كان يعمل لمعاوية، يروي عن: معاوية بن أبي سفيان، PageV01P002 [ج 2: ص 405] روى عنه: الوليد بن أبي الوليد، وهو الذي يقال له: العلاء بن حكيم.(@)(@@)(@@)(@@) ||| AUTO العلاء بن أبي عائشة الجزري(@)(@@) يروي عن: عمر بن الخطاب، روى عنه: محمد بن قيس الأسدي، وحصين بن عبد الرحمن.(@)(@@)(@@)(@@) ||| AUTO العلاء بن عراز الخارقي(@)(@@) يروي عن: ابن عمر، روى عنه: أبو إسحاق السبيعي.(@)(@@)(@@)(@@) ||| AUTO العلاء بن عبد الرحمن بن يعقوب(@)(@@) مولى الحرقة، وحرقة من جهينة، كان جده مكاتبا لمالك بن أوس بن الحدثان البصري، وكانت أمه مولاة لرجل من الحرقة من الجهينة، يروي عن: أنس بن مالك، وعبد الله بن عمرو، وأبيه، عداده في أهل المدينة، روى عنه: مالك، وشعبة، والثوري، مات سنة ثنتين وثلاثين ومائة، في ولاية أبي جعفر.(@)(@@)(@@)(@@) ||| AUTO العلاء بن سهيل بن عمرو(@)(@@) ابن أخي بشير بن عمرو، يروي عن: ابن عمر، روى عنه: العوام بن حوشب.(@)(@@)(@@)(@@) ||| AUTO العلاء بن المهلب الشيباني(@)(@@) يروي عن: عمر، روى عنه: نوح بن قيس الطاحي.(@)(@@)(@@)(@@) ||| AUTO العلاء بن الحارث الرمادي(@)(@@) يروي عن: جماعة من الصحابة، روى 
ms695	 عنه: أهل الشام، مات سنة ست وثلاثين ومائة.(@)(@@)(@@)(@@) ||| AUTO العلاء بن عمر(@)(@@) شيخ، يروي عن: ابن أبي أوفى إن كان سمع منه، روى عنه: معاوية بن صالح.(@)PageV01P002(@)(@@) [ج 2: ص 406](@)(@@)(@@)(@@) ||| AUTO العلاء بن صفوان(@)(@@) يروي عن: عمر، روى عنه: عبيد الله بن زحر.(@)(@@)(@@)(@@) ||| AUTO العلاء بن سعد بن مسعود الشامي(@)(@@) سكن مصر، يروي عن: عبد الله بن عمر، روى عنه: عمرو بن الحارث.(@)(@@)(@@)(@@) ||| AUTO العلاء بن ثعلبة(@)(@@) يروي عن: عائشة، روى عنه: جامع بن عمرو.(@)(@@)(@@)(@@) ||| AUTO العلاء الثقفي(@)(@@) يروي عن: أبي هريرة، روى عنه: ابنه عمر بن العلاء.(@)(@@)(@@)(@@) ||| AUTO العلاء بن عمار بن ياسر(@)(@@) يروي عن: أبيه، روى عنه: ابنه معاذ بن العلاء.(@)(@@)(@@)(@@) ||| AUTO عتبة بن إبراهيم بن عتبة بن غزوان السلمي(@)(@@) من بني مازن بن منصور، يروي عن: جده عتبة بن غزوان، روى عنه: البصريون.(@)(@@)(@@)(@@) ||| AUTO عتبة بن محمد بن الحارث بن نوفل(@)(@@) يروي عن: ابن عباس، وعبد الله بن جعفر، روى عنه: ابن جريج، ومصعب بن شيبة.(@)(@@)(@@)(@@) ||| AUTO عتبة بن صعصعة السعدي(@)(@@) ابن عم الأحنف بن قيس، يروي عن: عكراش بن ذؤيب، روى عنه: شريك بن الخطاب.(@)(@@)(@@)(@@) ||| AUTO عتبة بن عمرو بن عياش بن علقمة المدني(@)(@@) يروي عن: أبي هريرة، روى عنه: ابن أبي ذئب.(@)(@@)(@@)(@@) ||| AUTO عتبة بن مسلم(@)(@@) يروي عن: عثمان بن عفان، روى عنه: يوسف بن الماجشون.(@)PageV01P002(@)(@@) [ج 2: ص 407](@)(@@)(@@)(@@) ||| AUTO عتبة العدوي(@)(@@) قال: دخلت على أم حبيبة زوج النبي صلى الله عليه وسلم روى عنه: صدقة أبو إسماعيل.(@)(@@)(@@)(@@) ||| AUTO عتبة بن المنذر العبادي(@)(@@) يروي عن: أبي أمامة الباهلي، روى عنه: يحيى بن صالح الوحاظي.(@)(@@)(@@)(@@) ||| AUTO عتبة بن غزوان(@)(@@) قال: قال أبو موسى الأشعري: " ما لي أرى عينك نافرة، قال: التفت التفاتة فإذا جارية منكشفة فلحظتها لحظة، فصككت عيني صكة، فصارت إلى ما ترى، فقال أبو موسى: استغفر ربك فإنك ظلمت عينك، لك أول نظرة وعليك ما بعدها ". روى عنه: هارون بن رئاب.(@)(@@)(@@)(@@) ||| AUTO عمير(@)(@@) مولى أم الفضل، ويقال: مولى ابن عباس، كنيته أبو عبد الله، عن: أم 
ms696	 الفضل وأبي جهيم، روى عنه: عبد الرحمن الأعرج، عداده في أهل المدينة، مات سنة أربع ومائة، وهو والد عبد الله بن عمير، ومات عبد الله بن عمير سنة عشر ومائة، وأم الفضل هذه ابنة الحارث بن حزن الهلالية.(@)(@@)(@@)(@@) ||| AUTO عمير بن سعيد، أبو يحيى النخعي(@)(@@) من أهل الكوفة، يروي عن: سعد بن أبي وقاص، وعمار بن ياسر، روى عنه: مطرف بن طريف، مات سنة سبع ومائة في إمارة عمر بن هبيرة، وقد قيل: عمير بن سعد.(@)(@@)(@@)(@@) ||| AUTO عمير بن سلمة البكري(@)(@@) يروي عن: عمر بن الخطاب، روى عنه: أبو الأسود.(@)PageV01P002(@)(@@) [ج 2: ص 408](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO عمير بن سلمة الضمري(@)(@@) يروي عن: البهزي، عداده في أهل المدينة، روى عنه: أهلها.(@)(@@)(@@)(@@) ||| AUTO عمير بن سعيد الضمري(@)(@@) يروي عن: عمه أبي بردة بن نيار، روى عنه: محمد بن قيس الأسدي.(@)(@@)(@@)(@@) ||| AUTO عمير بن الأسود العنسي(@)(@@) من أهل الشام، يروي عن: عبادة بن الصامت، وأبي الدرداء، روى عنه: خالد بن معدان، وكان من العباد.(@)(@@)(@@)(@@) ||| AUTO عمير بن تميم بن يريم التغلبي، كنيته أبو هلال(@)(@@) عداده في أهل الكوفة، يروي عن: ابن عباس، روى عنه: السبيعي أبو إسحاق.(@)(@@)(@@)(@@) ||| AUTO عمير بن إسحاق(@)(@@) مولى بني هاشم، كنيته أبو محمد، يروي عن: أبي هريرة، وعمرو بن العاص، روى عنه: عبد الله بن عون، وهو من أهل المدينة، قد رأى الحسن بن علي بن أبي طالب.(@)(@@)(@@)(@@) ||| AUTO عمير المهري(@)(@@) مولى عثمان بن عفان، يروي عن: عثمان بن عفان، روى عنه: فضيل بن أبي عبد الله.(@)(@@) عمير(@)(@@) مولى عبد الله بن مسعود، يروي عن: عبد الله بن مسعود، عداده في(@)PageV01P002(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO [ج 2: ص 409] أهل الكوفة، روى عنه: ابنه عمران بن عمير.(@)(@@) عمير(@)(@@) يروي عن: عمر بن الخطاب، روى عنه: ابنه عبد الملك بن عمير.(@)(@@)(@@)(@@) ||| AUTO عمير بن حبيب(@)(@@) جد أبي جعفر الخطمي، يروي عن: جماعة من الصحابة، روى عنه: أبو جعفر الخطمي، وكان من العباد الخشن ممن صام النهار وقام الليل وحث الناس على الجهد الكثير.(@)(@@)(@@)(@@) ||| AUTO عمير 
ms697	 بن هانئ العنسي(@)(@@) من أهل الشام، كنيته أبو الوليد، أدرك ثلاثين من أصحاب رسول الله صلى الله عليه وسلم منهم ابن عمر، روى عنه: الأوزاعي، وابن جابر، وكان عاملا لعمرو بن عبد العزيز على البثنية، وحوران، قتله الصفر بن حبيب المري بداريا سنة سبع وعشرين ومائة، وكان يسجد كل يوم ألف سجدة ويسبح مائة ألف تسبيحة، وكان يسأل الله عز وجل دائبا الشهادة حتى قتل على فراشه على ما وصفنا قبل دخول عبد الله بن علي دمشق بثلاثة أشهر.(@)(@@)(@@)(@@) ||| AUTO عمير بن المأمون التيمي(@)(@@) يروي عن: الحسن بن علي، روى عنه: سعيد بن طريف الأسكاف، وسعد، الله المستعان على أخباره.(@)(@@)(@@)(@@) ||| AUTO عمير بن جودان(@)(@@) يروي عن: أبيه، روى عنه: ابنه أشعث بن عمير.(@)(@@) عمير(@)(@@) مولى بني يربوع، يروي عن: سعد، روى عنه: عطاء.(@)(@@) عمير(@)(@@) مولى ابن عباس، يروي عن: ابن عباس، روى عنه: إسماعيل بن رجاء.(@)PageV01P002(@)(@@) [ج 2: ص 410](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO عمير بن نمير، أبو وبرة الهمداني(@)(@@) من أهل الكوفة، يروي عن: ابن عمر، روى عنه: إسماعيل بن أبي خالد، وموسى الصغير.(@)(@@)(@@)(@@) ||| AUTO عمير الأنصاري(@)(@@) يروي عن: الحسين بن علي، روى عنه: ابنه موسى بن عمير.(@)(@@)(@@)(@@) ||| AUTO عمير أبو صالح(@)(@@) يروي عن: أبي هريرة، روى عنه: بكير بن الأشج.(@)(@@)(@@)(@@) ||| AUTO عمير بن ربيعة(@)(@@) يروي عن: ابن مسعود، روى عنه: مغيث بن سمى.(@)(@@)(@@)(@@) ||| AUTO عمير بن الفيض اللخمي(@)(@@) يروي عن: أبي ذر، وعمرو بن العاص، روى عنه: الحارث بن يزيد، وابنه عتبة بن عمير.(@)(@@)(@@)(@@) ||| AUTO عمير أو بن عمير(@)(@@) يروي عن: عمر بن الخطاب، روى عنه: عاصم بن عمرو.(@)(@@)(@@)(@@) ||| AUTO عمير أبو المغلس(@)(@@) يروي عن: ابن أبي نجيح، وله صحبة فيما يقال، روى عنه: ابن جريج، وقد قيل: إن اسم أبي المغلس ميمون.(@)(@@) عمير(@)(@@) مولى آل فديد، يروي المراسيل، روى عنه: عبد العزيز بن أبي سلمة الماجشون.(@)(@@)(@@)(@@) ||| AUTO عباس بن عبيد بن عباس بن عبد المطلب بن هاشم(@)(@@) يروي عن: الفضل بن عباس، روى عنه: أيوب، وقد روى ابن جريج، عن محمد 
ms698	 بن عمر بن علي عنه.(@)(@@)(@@)(@@) ||| AUTO عباس بن عبد الله بن عباس بن عبد المطلب بن هاشم الهاشمي(@)(@@) يروي عن: الفضل بن عباس، روى عنه: أيوب.(@)PageV01P002(@)(@@) [ج 2: ص 411](@)(@@)(@@)(@@) ||| AUTO عباس بن سهل بن سعد الساعدي(@)(@@) يروي عن: أبيه، وأبي حميد، روى عنه: محمد بن إسحاق، وفليح بن سليمان، مات سنة خمس وسبعين، وأدرك عثمان بن عفان، وهو ابن خمس عشرة سنة.(@)(@@)(@@)(@@) ||| AUTO عباس بن جليد الحجري(@)(@@) يروي عن: عبد الله بن عمرو وأبي الدرداء، روى عنه: أبو هانئ حميد بن هانئ.(@)(@@)(@@)(@@) ||| AUTO عباس بن عبد الله الجشمي(@)(@@) يروي عن: عثمان بن عفان، وأبي هريرة، روى عنه: الجريري، وقتادة.(@)(@@)(@@)(@@) ||| AUTO عباس بن عبد الرحمن بن ميناء الأشجعي(@)(@@) يروي عن: ابن عباس، وجودان، روى عنه: ابن جريج محمد بن إسحاق.(@)(@@)(@@)(@@) ||| AUTO عباس بن نافع(@)(@@) أخو أبو مرحب، يروي عن: ابن عمر، روى عنه: نافع بن سرجس.(@)(@@)(@@)(@@) ||| AUTO عباس بن جمهان(@)(@@) يروي المراسيل، روى عنه: إسماعيل بن رافع.(@)(@@)(@@)(@@) ||| AUTO عطية بن قيس الكلابي(@)(@@) من أهل الشام، كنيته أبو يحيى، مولى لأبي بكر بن كلاب، يروي عن: معاوية، روى عنه: الشاميون، وابنه سعد بن عطية، مات سنة إحدى وعشرين ومائة وهو ابن أربع ومائة سنة، وكان مولده سنة سبع عشرة، ومات قبل مكحول.(@)(@@)(@@)(@@) ||| AUTO عطية الطفاوي البصري، أبو المعذل(@)(@@) من أهل البصرة، يروي عن: ابن PageV01P002 [ج 2: ص 412] عمر، روى عنه: سليمان التيمي، وخالد الحذاء، وعوف الأعرابي.(@)(@@)(@@)(@@) ||| AUTO عطية بن رافع(@)(@@) من أهل الشام، كنيته أبو هزان، يروي عن: حذيفة، ومعاوية، روى عنه: صفوان بن عمرو السكسكي، وأهل الشام.(@)(@@)(@@)(@@) ||| AUTO عطية بن سفيان بن عبد الله بن ربيعة الثقفي(@)(@@) يروي عن: عثمان، وعلي، روى عنه: عيسى بن عبد الله بن مالك.(@)(@@)(@@)(@@) ||| AUTO عطية بن بسر(@)(@@) شيخ من أهل الشام، حديثه عند أهلها، روى عنه: مكحول في التزويج متن منكر وإسناد مقلوب.(@)(@@)(@@)(@@) ||| AUTO أبو هزان الشامي، اسمه عطية بن أبي جميلة(@)(@@) يروي عن: جماعة من التابعين، وأدرك واثلة بن الأسقع، روى عنه: أهل الشام، وليس هذا 
ms699	 بأبي هزان الصغير ذاك اسمه يزيد بن سمرة.(@)(@@)(@@)(@@) ||| AUTO عطية بن عامر الجهني(@)(@@) يروي عن: سلمان، روى عنه: عبد الله بن وهب.(@)(@@)(@@)(@@) ||| AUTO عطية بن عارض(@)(@@) يروي عن: ابن عباس، روى عنه: أبو خالد الدالاني.(@)(@@)(@@)(@@) ||| AUTO عطية بن عبد الله بن أنيس الجهني(@)(@@) يروي عن: أبيه، وله صحبة، روى عنه: أخوه عيسى بن عبد الله.(@)(@@)(@@)(@@) ||| AUTO عطية بن الأسود، أبو الأسود(@)(@@) يروي عن: ابن عمر، روى عنه: مغيرة بن مالك.(@)(@@)(@@)(@@) ||| AUTO عطية بن أبي عطية(@)(@@) يروي عن: ابن أم مكتوم، روى عنه: علي بن زيد بن جدعان.(@)PageV01P002(@)(@@) [ج 2: ص 413](@)(@@)(@@)(@@) ||| AUTO عطية أبو عبد الكريم(@)(@@) مولى سليمان بن زياد، يروي عن: حذيفة، روى عنه: برد بن سنان.(@)(@@)(@@)(@@) ||| AUTO عطية بن سعد الدعاء(@)(@@) يروي عن: الحكم بن أيوب، وله صحبة، روى عنه: كهمس بن الحسن.(@)(@@)(@@)(@@) ||| AUTO عون بن عبد الله بن عتبة بن مسعود الهذلي(@)(@@) أخو عبيد الله بن عبد الله، من عباد أهل الكوفة وقرائهم، يروي عن: أبي هريرة إن كان سمع منه، وقد أدرك ابن أبي أوفى، وأبا جحيفة، روى عنه: المسعودي، ومسعر بن كدام.(@)(@@)(@@)(@@) ||| AUTO عون بن أبي جحيفة(@)(@@) واسم أبي جحيفة: وهب السوائي، من أهل الكوفة، يروي عن: أبيه، روى عنه: الثوري، وشعبة، مات في ولاية خالد على العراق.(@)(@@)(@@)(@@) ||| AUTO عون أبو معمر العقيلي(@)(@@) يروي عن: أنس، روى عنه: البصريون، وهشام الدستوائي، وسليمان بن المغيرة، وذووهما.(@)(@@)(@@)(@@) ||| AUTO عون بن عبد الله الأزدي(@)(@@) يروي عن: ابن عمر، روى عنه: أبو فروة.(@)(@@)(@@)(@@) ||| AUTO عون السهمي(@)(@@) يروي عن: أبي أمامة الباهلي، روى عنه: حاتم بن أبي صغيرة.(@)(@@)(@@)(@@) ||| AUTO عياض بن عبد الله بن سعد بن أبي سرح العامري(@)(@@) يروي عن: أبي سعيد الخدري، عداده في أهل المدينة، روى عنه: زيد بن أسلم، والناس.(@)PageV01P002(@)(@@) [ج 2: ص 414](@)(@@)(@@)(@@) ||| AUTO عياض الأشعري(@)(@@) يروي عن: عمر بن الخطاب، وأبي عبيدة بن الجراح، وأبي موسى، روى عنه: سماك بن حرب، وقد قيل: إنه له صحبة، وليس يصح ذلك عندي.(@)(@@)(@@)(@@) ||| AUTO عياض بن خليفة(@)(@@) يروي عن: علي، وعمر، 
ms700	 روى عنه: الزهري، والناس.(@)(@@)(@@)(@@) ||| AUTO عياض بن ضمري الكلبي(@)(@@) ابن عم أسامة بن زيد، وكان ختنه على ابنته، يروي عن: أسامة بن زيد، روى عنه: الزهري، وقد قيل: عياض بن ضبرى.(@)(@@)(@@)(@@) ||| AUTO عياض بن مسلم(@)(@@) يروي عن: ابن عمر، روى عنه: يحيى بن سعيد الأنصاري.(@)(@@)(@@)(@@) ||| AUTO عياض بن نضلة(@)(@@) يروي عن: علي، وأبي موسى، روى عنه: ابنه عباس بن عياض.(@)(@@)(@@)(@@) ||| AUTO عياض بن هلال الأنصاري(@)(@@) يروي عن: أبي سعيد الخدري، روى عنه: يحيى بن أبي كثير، ومن زعم أنه هلال بن عياض فقد وهم.(@)(@@)(@@)(@@) ||| AUTO عياض بن غطيف(@)(@@) يروي عن: أبي عبيدة بن الجراح، عداده في أهل الشام، وهو الذي يقول له: سليم بن عامر: غضيف بن الحارث، عن أبي عبيدة، ولم يضبطه.(@)(@@)(@@)(@@) ||| AUTO عياض أبو خالد(@)(@@) يروي عن: معقل بن يسار، عداده في أهل البصرة، روى عنه: شعبة.(@)PageV01P002(@)(@@) [ج 2: ص 415](@)(@@)(@@)(@@) ||| AUTO عياض بن مسافع(@)(@@) يروي عن: أبي بكرة، روى عنه: طلحة بن عبد الله بن عوف من حديث الزهري عنه.(@)(@@)(@@)(@@) ||| AUTO عياض بن أبي زهير(@)(@@) يروي عن: أبي سعيد الخدري، روى عنه: يحيى بن أبي كثير.(@)(@@) (203) -[2: 415] ثنا عمر بن محمد الهمداني، قال: ثنا عمرو بن عثمان، قال: ثنا بقية بن الوليد، قال: ثنا الأوزاعي، عن يحيى بن أبي كثير، عن عياض بن أبي زهير، قال: سمعت أبا سعيد الخدري، يقول: قال رسول الله صلى الله عليه وسلم: " إذا سهى أحدكم في صلاته فلا يدري زاد أو نقص، فليسجد سجدتين وهو جالس "(@)(@@)(@@)(@@) ||| AUTO عياض بن فراس(@)(@@) يروي عن: أبي سعيد الخدري، روى عنه: يحيى بن أبي كثير.(@)(@@)(@@)(@@) ||| AUTO عياض بن عياض(@)(@@) يروي عن: أبي مسعود الأنصاري، روى عنه: الثوري، وابنه عياض بن عياض بن عياض.(@)(@@)(@@)(@@) ||| AUTO عياض بن دينار الليثي(@)(@@) من أهل المدينة، يروي عن: أبي هريرة، روى عنه: محمد بن إسحاق بن يسار.(@)(@@)(@@)(@@) ||| AUTO عياض بن يزيد الكلابي(@)(@@) يروي عن: أبي أمامة الباهلي، روى عنه: عاصم بن كليب.(@)(@@)(@@)(@@) ||| AUTO عمار بن سعد القرظ المؤذن(@)(@@) مولى بني مخزوم، يروي عن: 