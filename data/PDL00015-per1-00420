ms401	 خم اندر خم(@)(@@) 48 دیدم آنجا نشسته اسعد را %~% بامی و بانگ زیر و ناله بم(@)(@@) 49 بود با او نشسته قصابی %~% کودکی چون یکی بدیع صنم(@)(@@) 50 هر دو مست از نبید سوسن بوی %~% برو عارض چو سوسن و چو پرم(@)(@@) 51 هر دو کردند عرضه بر من می %~% گفتم از شرم هر دو را که نعم(@)(@@) 52 یک دو سیکی ز شرم خوردم و خفت %~% به یکی گوشه‌ای ندیم ندم(@)(@@) 53 هر دو خفتند مست و در راندند %~% پیش من مست‌وار خر بکرم(@)(@@) 54 ژرف کردم نگه که زیرین کیست %~% دست و انگشت کیست با خاتم(@)(@@) 55 دیدم آن کودک قصاب %~% بر زبر همچو قبه اعظم(@)(@@) 56 یا یکی خیمه‌ای ز دیبه سرخ %~% قصاب چون ستون خیم(@)(@@) 57 گاه بیرون کشید همچو زریر %~% گاه اندر سپوخت چون عندم(@)(@@) 58 گفتم: احسنت ای امام که نیست %~% چون تو اندر همه دیار عجم(@)(@@) 59 گفت: مفزای ای سنایی هیچ %~% که تو هستی به نزد ما محرم(@)(@@) 60 غزلی گوی حسب ما که بود %~% این دل ریش هر دو را مرهم(@)(@@) 61 غزلی حسب حالشان گفتم %~% صلتی یافتم نه بس معظم(@)(@@) 62 خویشتن را جز این ندانم جرم %~% ور جز اینست باد ما ابکم(@)(@@) 63 بارکی چند نیز شیخک را %~% دیده‌ام من به کنجها برکم(@)(@@) 64 گاه گنگی درشت از پس پشت %~% گاه با ساده‌ای نشسته بهم(@)(@@) 65 گر بپرسند این ز من روزی %~% بخورم صدهزار بار قسم(@)(@@) 66 خواجه اوحد زمان ز کی حمزه %~% ای بلند اختر و بلند همم(@)(@@) 67 حال من شرح ده چو قصه خویش %~% پیش آن صدر مکرم مکرم(@)(@@) 68 سید عالم و امام رییس %~% آن بهین طلعت و بزرگ شیم(@)(@@) 69 نبوی جوهری که عرض ورا %~% کس نداند بجز خدای قیم(@)(@@) 70 عاجز اندر فصاحت و خطش %~% روز دیدار شاعر مفخم(@)(@@) 71 خاک غزنین و بلخ و نیشابور %~% وز در روم تا حد جیلم(@)(@@) 72 
ms402	 به قلم چند گونه سحر حلال %~% می‌نماید چو در ادب اسلم(@)(@@) 73 نکته اصمعی و جاحظ و قیس %~% هست در پیش لفظ او اخرم(@)(@@) 74 بوالمعالی که همت عالیش %~% برگذشت از حدوث همچو قدم(@)(@@) 75 قابل فیض و لطف و فضل الاه %~% وز همه فاضلان هم او اعلم(@)(@@) 76 خاک صدرش نظیف چون کعبه %~% آب قدرش لطیف چون زمزم(@)(@@) 77 حکم و فرمانش چون صباح و مسا %~% روز و شب را دهد ضیا و ظلم(@)(@@) 78 خیل خیر از خیال طلعت اوست %~% چون سخن را گذر ز حقه فم(@)(@@) 79 باز گردم کنون به قصه خویش %~% چند باشد ز مضمر و مدغم(@)(@@) 80 ای به بخشش هزار چون حاتم %~% ای به کوشش هزار چون رستم(@)(@@) 81 مپسند اینکه آن لعین خبیث %~% بجهاند کمیت چون ادهم(@)(@@) 82 تو پسندی فسان خاطر من %~% زو شو چون فسانه شولم(@)(@@) 83 بر سر من گماشت رندی چند %~% همچو او ناکس و ذمیم شیم(@)(@@) 84 نشنودند هر چه من گفتم %~% علم نحو و عروض و شعر و حکم(@)(@@) 85 از همه مال و منصب دنیا %~% بر تن و من نه رنگ بود نه شم(@)(@@) 86 زان که از جامه کسان بودم %~% مانده چون حرف معرب و معجم(@)(@@) 87 جامه‌ها بستدند و گفتندم %~% نیز ستار کن برین سر ضم(@)(@@) 88 گر تو هستی به پاکی عیسی %~% نیست دستار ریشه مریم(@)(@@) 89 من ز بلخ آنچنان شدم به سرخس %~% با بلا و عنا و حسرت و هم(@)(@@) 90 که گنهکار یونس‌بن متی %~% به سوی نینوا به ساحل یم(@)(@@) 91 تا فزونست باز از صعوه %~% تا پدیدست روبه از ضیغم(@)(@@) 92 باد عاجز چو صعوه و روباه %~% آن خبیث از شباب تا بهرم(@)(@@) 93 آنکه بدخواه او همیشه براو %~% چیره چون باز باد و شیر اجم(@)(@@) 94 دوستانش حریق در دوزخ %~% نیکخواهش غریق در قلزم(@)(@@) 95 خر در زن پدرش %~% گرچه زینهم نباید او را غم PageV1P0543(@)(@@)(@@)(@@) || [genre: Q] 
ms403	(@)(@@) 1 کجایی ای همه هوشت به سوی طبل و علم %~% چرا نباری بر رخ ز دیده آب ندم(@)(@@) 2 چرا غرور دهی تنت را به مال و به ملک %~% چرا فروشی دین را به ساز و اسب و درم(@)(@@) 3 تمام شد که ترا خواجگی لقب دادند %~% کمال یافت همه کار تو به باد و بدم(@)(@@) 4 به ذات ایزد اگر دست گیردت فردا %~% غلام و اسب و سلاح و سوار و خیل و حشم(@)(@@) 5 چو بر زنند بر آن طبل عزل خواجه دوال %~% تو خواه میر عرب باش و خواه شام عجم(@)(@@) 6 به گوش خواجه فرو گوید زان زمان معنی %~% کجا شد آنهمه دعوی و لاف تو هر دم(@)(@@) 7 ازین غرور تو تا کی ایا زبون قضا %~% وزین نشاط تو تا کی ایا سرشته به غم(@)(@@) 8 کمر به دست تو آید همی سلیمان‌وار %~% ترا طمع که در انگشت تو کند خاتم(@)(@@) 9 ز کردگار نترسی و پس خراب کنی %~% هزار خانه درویش را به نوک قلم(@)(@@) 10 امین دینت لقب گشت پس چرا دزدی %~% گلیم موسی عمران و چادر مریم(@)(@@) 11 ز بهر ده درم قلب را نداری باک %~% که بر کنی و بسوزی هزار بیت حرم(@)(@@) 12 شراب جنت و حور و قصور می طلبی %~% بدین مروت و حلم و بدین سخا و کرم(@)(@@) 13 بدین عمل که تو داری مگر ترا ندهند %~% به حشر هیچی و ز هیچ نیز چیزی کم(@)(@@) 14 بدین قصیده ز من خواجگان بپرهیزند %~% چنانکه اهل شیاطین ز توبه آدم(@)(@@) 15 سنایی ار تو خدا ترسی و خدای شناس %~% ترا ز میر چه باک و ترا ز شاه چه غم PageV1P0544(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 مرحبا ای رایت تحقیق رایت را حشم %~% رای تو باشد حشم توفیق به فرزاد علم(@)(@@) 2 گر نبودی بود تو موجود کلی را وجود %~% حق به جان تو نکردی یاد در قرآن قسم(@)(@@) 3 گر نخواندی 
ms404	 «رحمةللعالمین» یزدان ترا %~% در همه عالم که دانستی صمد را از صنم(@)(@@) 4 چون «لعمرک» گفت اینجا جای دیگر «والضحی» %~% گشتمان روشن که تو بوالقاسمی نه بوالحکم(@)(@@) 5 تا نسیم روی و مویت پرده از رخ بر نداشت %~% نه ظلم از نور پیدا بود نه نور از ظلم(@)(@@) 6 عالمی بیمار غفلت بود اندر راه لا %~% حق ترا از حقه تحقیق فرمودش: نعم(@)(@@) 7 کای محمد رو طبیب حاذق و صادق تویی %~% خلق کن با خلق و بر نه درد ایشان را مرم(@)(@@) 8 هر کرا شربت بود شافی بده آنک قدح %~% هر کرا حجت بود حاجت بخواه اینک کرم(@)(@@) 9 منبر و اسرار تو هردم تمام و مطلع %~% گر کنندت کافران از روی غیرت متهم(@)(@@) 10 هر کجا مهر تو آمد بهره برگیرد مراد %~% هر کجا داد تو آمد رخت بر بندد ستم(@)(@@) 11 زان بتو دادست یزدان این سرای و آن سرای %~% تا هم اینجا محترم باشی هم آنجا محتشم(@)(@@) 12 مدتی بگذشت تا قومی ز فراشان روح %~% برده‌اند بر بام عالم رخت از بیت‌الحرام(@)(@@) 13 «طرقوا» گویان همه در انتظارت سوختند %~% آب از سر گذشت ای مهتر عالی همم(@)(@@) 14 ای جبین هر جنین را مهر مهر تو نگار %~% مهر مهرت را مگر اندک شکستی داد جم(@)(@@) 15 ناگهان خاتم برون شد چند روز از دست او %~% ملکت از دستش برون شد همچو خاتم لاجرم(@)(@@) 16 کحل حجت بود آن در چشم هر بیننده‌ای %~% یعنی از مهر تو نتوان دور بودن یک دو دم(@)(@@) 17 جام مالامال دادی عاشقان را زان قبل %~% نعره‌های خون چکان برخاست آنجا از امم(@)(@@) 18 صدهزاران جان فدای خاک نعلین تو باد %~% کو به خدمت بر سر کوی تو آمد یک قدم(@)(@@) 19 هر کرا در بر گرفتی «لاتخافوا» ملک اوست %~% هر کرا بر در نهادی شد ز «لاشری» به غم(@)(@@) 20 آن چه دولت بد که شاگرد تو دید اندر ازل 
ms405	 %~% و آن چه حرمت بد که مولای تو دید اندر عجم(@)(@@) 21 گر سنایی را سنایی باشد اندر انس تو %~% عمر او همچون شکر گردد نبیند طعم سم PageV1P0545(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 روحی فداک ای محتشم لبیک لبیک ای صنم %~% ای رای تو شمس‌الضحی وی روی تو بدرالظلم(@)(@@) 2 مایه ده آدم تویی میوه دل مریم تویی %~% همشهری زمزم تویی یا قبلة الله فی العجم(@)(@@) 3 دانم که از بیت‌اللهی شیری بگو یا روبهی %~% در حضرت شاهنشهی بوالقاسمی یا بوالحکم(@)(@@) 4 نی نی پیت فرخ بود خلقت شکر پاسخ بود %~% آنرا که چونین رخ بود نبود حدیثش بیش و کم(@)(@@) 5 ای جان جانها روی تو آشوب دلهای موی تو %~% وندر خم گیسوی تو پنهان هزاران صبحدم(@)(@@) 6 رو رو که از چشم و دهان خواهی عیان خواهی نهان %~% خلق جهان را از جهان هم کعبه‌ای و هم صنم(@)(@@) 7 رویت بنامیزد چو مه زلفت بنامیزد سیه %~% هم عذر با تو هم گنه هم نور با تو هم ظلم(@)(@@) 8 هر چینت از مشکین کله دارد کلیمی در تله %~% هر بوست از لب حامله دارد مسیحی در شکم(@)(@@) 9 از باد و آتش نیستی تو آب و خاکی چیستی %~% جم را بگو تا کیستی او را روانی ده ز شم(@)(@@) 10 چون عشق را ذات آمدی نفی قرابات آمدی %~% چون در خرابات آمدی کم کن حدیث خال و عم(@)(@@) 11 بر رویت از بهر شرف با ما گه قهر و لطف %~% گه لعل گوید «لا تخف» گه جزع گوید «لا تنم»(@)(@@) 12 رویت بهی تریاقفا بالا سهی تریاقبا %~% منعت غنی‌تر یا عطا ذاتت هنی تر یا شیم(@)(@@) 13 گیرم کرم وقت کرب ز اهل عجم باشد عجب %~% باری تو هستی از عرب این الوفا این الکرم(@)(@@) 14 ما را شرابی یار کن یا چیزکی در کار کن %~% گر نور نبود نار کن آخر نباشد کم ز کم(@)(@@) 15 از دستت ار 
ms406	 آتش بود ما را ز گل مفرش بود %~% هرچ آید از تو خوش بود خواهی شفا خواهی الم(@)(@@) 16 ان لم یکن طود فتل ان لم یکن وبل فطل %~% ان لم یکن خمر فخل ان لم یکن شهد فسم(@)(@@) 17 گر طاق نبود کم ز پل گر طوق نبود کم ز غل %~% ور عز نبود کم ز ذل ور مدح نبود کم ز ذم(@)(@@) 18 صحرای مغرب چارسو بگرفت زاغ تنگخو %~% سیمرغ مشرق را بگو تا بال بگشاید ز هم(@)(@@) 19 هم گنج داری هم خدم بیرون چه از کتم عدم %~% بر فرق آدم نه قدم بر بال عالم زن علم(@)(@@) 20 انجم فرو روب از فلک عصمت فرو شو از ملک %~% بر زن سما را بر سمک انداز در کتم عدم(@)(@@) 21 کم کن ز کیوان نام را بستان ز زهره جام را %~% جوشن بدر بهرام را بشکن عطارد را قلم(@)(@@) 22 نه چرخ‌مان نه قدر او نه عقل نه صدر او %~% نه جان‌مان نه غدر او نه خیل‌مان و نه حشم(@)(@@) 23 بیرون خرام و برنشین بر شهپر روح‌الامین %~% آخر گزافست این چنین تو محتشم او محتشم(@)(@@) 24 تا کی ز کاس ذوالیزن گاهی عسل گاهی لبن %~% می مکش بسان تهمتن اندر عجم در جام جم(@)(@@) 25 می‌کش که غمها می‌کشد اندوه مردان وی کشد %~% در راه رستم کی کشد جز رخش رخت روستم(@)(@@) 26 بستان الاهی جام را بردار از آدم دام را %~% در باز ننگ و نام را اندر خرابات قدم(@)(@@) 27 از عشق کانی کن دگر وز باده جانی کن دگر %~% وز جان جهانی کن دگر بنشین درو شاد و خرم(@)(@@) 28 یک دم بکش قندیل را بیرون کن اسرافیل را %~% دفتر بدر جبریل را نه لا گذار آنجا نه لم(@)(@@) 29 تو بر زمین آن مهتری کز آسمانها برتری %~% ای نور ماه و مشتری قسام را هستی قسم(@)(@@) 30 نور فلک را مایه‌ای روح 
ms407	 ملک را دایه‌ای %~% بر فرق عالم سایه‌ای شد فوق و تحت از تو خرم(@)(@@) 31 امروز و فردا از آن تست اصل دو عالم جان تست %~% رضوان کنون مهمان تست ارواح را داری خدم(@)(@@) 32 کونین را افسر تویی بر مهتران مهتر تویی %~% بر بازوان شهپر تویی بنوشت چون نامت قلم(@)(@@) 33 هر کو ز شوقت مست شد گر نیستی بد هست شد %~% خوبی به چشمت گست شد شد ایمن از جور و ستم(@)(@@) 34 ای چرخ را رفعت ز تو ای ملک را دولت ز تو %~% ای خلد را نعمت ز تو قلب‌ست بی‌نامت درم(@)(@@) 35 در کعبه مردان بوده‌اند کز دل وفا افزوده‌اند %~% در کوی صدق آسوده‌اند محرم تویی اندر حرم(@)(@@) 36 از دور آدم تا به ما از انبیا تا اولیا %~% نی بر زمین نی بر سما نامد چو تو یک محترم(@)(@@) 37 در حسرت دیدار تو در حکمت گفتار تو %~% هر ساعت از اخبار تو بر زعفران بارم به قم(@)(@@) 38 فردوس زان خرم شدست وز خرمی مفخم شدست %~% جای نبی آدم شدست کز نام تو دارد رقم(@)(@@) 39 چون تو برفتی از جهان گشت از جهان حکمت نهان %~% آمد کنون مردی چنان کز علم تو دار علم(@)(@@) 40 دارد حدیثش ذوق تو از کارخانه شوق تو %~% نوشید شرب ذوق تو زان بست بر مهرت سلم(@)(@@) 41 هر جا که او منزل کند از مرده جان حاصل کند %~% زیرا که کار از دل کند فارغ شد از کار شکم(@)(@@) 42 در خواب جانش داده‌ای آب روانش داده‌ای %~% بر خود نشانش داده‌ای چون گشت موجود از عدم(@)(@@) 43 چون بر سر منبر شود شهری پر از گوهر شود %~% بر چرخ نطقش بر شود روح‌الامین گوید نعم(@)(@@) 44 بگشای کوی آنک قدم بر بای عقل آنک عدم %~% بفزای عشق آنک حرم بنمای روی آنک ارم(@)(@@) 45 جان کن فدای عاشقان اندر هوای عاشقان %~% بر تکیه جای عاشقان شعر 
ms408	 سنایی کن رقم PageV1P0546(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 نماز شام من و دوست خوش نشسته بهم %~% گرفته دامن شادی شکسته گردن غم(@)(@@) 2 سپرده لاله به پای و بسوده زلف به دست %~% گرفته دوست به دام و کشیده رطل به دم(@)(@@) 3 ز چرخ زهره به زیر آمده به زاری زیر %~% ز کوه کبک به بانگ آمده به ناله بم(@)(@@) 4 نشانده شعله ز انگشتها به باده خام %~% فشانده حلقه ز انگشتها ز زلف به خم(@)(@@) 5 نه از رفیق گریغ و نه از فراق دریغ %~% نه در میانه تکلف نه از زمانه ستم(@)(@@) 6 مر بر آمده ناگاه شوق از دل و جان %~% که زخم آن به دلم زد هزار شوق صنم(@)(@@) 7 خجسته شوقی با صدهزار جوق نشاط %~% گزیده و جدی با صدهزار فوج نغم(@)(@@) 8 زمین و چرخ خبر یافته ز حال دلم %~% بمانده خیره و پوشیده جامه ماتم(@)(@@) 9 همی گشاده هوا بر زمین شراع گهر %~% همی کشیده فلک بر هوا بساط ظلم(@)(@@) 10 ظلام مشرق بر چهر روز مستولی %~% سواد مغرب در طبع چرخ مستحکم(@)(@@) 11 مرا دل اندر راه و دو دیده در حرکات %~% بجسته از بر یار و نشسته بر ادهم(@)(@@) 12 سیاه رنگ ولیکن جهان بدو روشن %~% برین صفت رود آری مه چهارده هم(@)(@@) 13 چگونه ادهمی آن ادهمی که من ز برش %~% چنان نشستم و چون بر فراز دیوان جم(@)(@@) 14 بسهم شیر و بتن زنده پیل و چشم چراغ %~% چو عزم بر سر کوه چو وال در دل یم(@)(@@) 15 قوی قوایم و فربه سرین و چیده میان %~% دراز گردن و آهخته گوش و گرد شکم(@)(@@) 16 به پیشم اندر راهی و وادی و دشتی %~% درشت و صعب و سیه چون شعار کفر و ظلم(@)(@@) 17 اگر چه کوه و بیابان و بیشه بود به پیش %~% همی زدم شب تاریک هر سه را بر هم(@)(@@) 18 برین صفت همه شب تا ز 
ms409	 لاجورد هوا %~% هزار شعله برآمد چو صد هزار علم(@)(@@) 19 به مرغزاری کان روشنایی اندر وی %~% هزار قصر بدیدم چو قصر فخرامم(@)(@@) 20 به شعر اوست همه افتخار و ناز عرب %~% به ذکر اوست همه اصل احتشام عجم(@)(@@) 21 تفاخری که کند او ز روی تحقیقی %~% تفاخریست مسلم چو نصرت آدم PageV1P0547(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1(@)(@)(@@) زهی پشت و پناه هر دو عالم(@)(@)(@@) %~%(@)(@)(@@) سر و سالار فرزندان آدم(@)(@)(@@)(@)(@@) 2(@)(@)(@@) دلیل راهت ابراهیم آزر(@)(@)(@@) %~%(@)(@)(@@) منادی ملتت عیسی مریم(@)(@)(@@)(@)(@@) 3(@)(@)(@@) شبستان مقامت قاب قوسین(@)(@)(@@) %~%(@)(@)(@@) در درگاه تو بطحا و زمزم(@)(@)(@@)(@)(@@) 4(@)(@)(@@) ملایک را نشان از چون تو مهتر(@)(@)(@@) %~%(@)(@)(@@) رسل را فخر از چون تو مقدم(@)(@)(@@)(@)(@@) 5(@)(@)(@@) نبودی گر برایت گفت ایزد(@)(@)(@@) %~%(@)(@)(@@) نه آدم آفریدی و نه عالم(@)(@)(@@)(@)(@@) 6(@)(@)(@@) کلاه و تخت کسرا از تو نابود(@)(@)(@@) %~%(@)(@)(@@) سپاه و ملک قیصر از تو درهم(@)(@)(@@)(@)(@@) 7(@)(@)(@@) میان اولیا صدری و بدری(@)(@)(@@) %~%(@)(@)(@@) میان انبیا مهری و خاتم(@)(@)(@@)(@)(@@) 8(@)(@)(@@) بوقت راز گفتن با خداوند(@)(@)(@@) %~%(@)(@)(@@) نیامد مر ترا یک مرد محرم(@)(@)(@@)(@)(@@) 9(@)(@)(@@) تویی زی اقربا درویش ایمن(@)(@)(@@) %~%(@)(@)(@@) تویی زی انبیا سلطان اعظم(@)(@)(@@)(@)(@@) 10(@)(@)(@@) نگیری خشم از دندان شکستن(@)(@)(@@) %~%(@)(@)(@@) شفاعت مر ترا باشد مسلم(@)(@)(@@)(@)(@@) 11(@)(@)(@@) ترا دانند زیف و ضال و مجنون(@)(@)(@@) %~%(@)(@)(@@) گهی ساحر گهی کاهن منجم(@)(@)(@@)(@)(@@) 12(@)(@)(@@) تو آن بودی که بودی و نگشتی(@)(@)(@@) %~%(@)(@)(@@) ز مدحت شادمان رنجور از ذم(@)(@)(@@)(@)(@@) 13(@)(@)(@@) ندانم در عرب یک خانه کو را(@)(@)(@@) %~%(@)(@)(@@) نبودست از برای دینت ماتم(@)(@)(@@)(@)(@@) 14(@)(@)(@@) روانت را همه جام پیاپی(@)(@)(@@) %~%(@)(@)(@@) سپاهت را همه فتح دمادم(@)(@)(@@)(@)(@@) 15(@)(@)(@@) تو آن مردی که در میدان مردان(@)(@)(@@) %~%(@)(@)(@@) تو داری پهلوانی چون غشمشم(@)(@)(@@)(@)(@@) 16(@)(@)(@@) تو آن شمسی که بر گردون دو نیمه(@)(@)(@@) %~%(@)(@)(@@) کنی مه را زهی برهانت محکم(@)(@)(@@)(@)(@@) 17(@)(@)(@@) بنوک تازیانه بر فگندی(@)(@)(@@) %~%(@)(@)(@@) نهاده گرز افریدون و رستم(@)(@)(@@)(@)(@@) 18(@)(@)(@@) به زنجیر اندر آرند و فروشند(@)(@)(@@) %~%(@)(@)(@@) هر آنکو هست عاصی از تو یکدم(@)(@)(@@)(@)(@@) 19(@)(@)(@@) ترا در صومعه بود ار شفاعت(@)(@)(@@) %~%(@)(@)(@@) بدیدی تا به ساق عرش بلغم(@)(@)(@@)(@)(@@) 20(@)(@)(@@) سپاه و تخت و ملک و گنج بگذاشت(@)(@)(@@) %~%(@)(@)(@@) ز عشق 
ms410	 راهت ابراهیم ادهم(@)(@)(@@)(@)(@@) 21(@)(@)(@@) مرا یاد تو باید بر زبان بس(@)(@)(@@) %~%(@)(@)(@@) سنایی گردد از یاد تو خرم(@)(@)(@@) PageV1P0548(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ز باده بده ساقیا زود دادم %~% که من خرمت خویش بر باد دادم(@)(@@) 2 ز بیداد عشقت به فریاد آیم %~% نیاید بجز باده تلخ یادم(@)(@@) 3 به آتش کنندم همی بیم آن جا %~% من این جا ز عشق اندر آتش فتادم(@)(@@) 4 بدان آتش آنجا مبادا که سوزم %~% درین آتش اینجا رهایی مبادم(@)(@@) 5 من از آتش عشق هم نرم گردم %~% اگرچه ز پولاد سختست لادم(@)(@@) 6 مرا توبه و پارسایی نسازد %~% شبانگاه می‌باید و بامدادم(@)(@@) 7 همی تا میان عاشقی را ببستم %~% بلا را سوی خویشتن ره گشادم(@)(@@) 8 دو چشمم بر آبست و پر آتشم دل %~% سر آورده بر خاک و در دست بادم(@)(@@) 9 منم بنده عشق تا زنده باشم %~% اگر چه ز مادر من آزاد زادم(@)(@@) 10 بجز عشق تا عمر دارم نورزم %~% اگر بیش باشد ز صد سال زادم(@)(@@) 11 دل از باده عشق خوبان نتابم %~% چنین باد تا باد رسم و نهادم(@)(@@) 12 ز نیک و بد این و آن فارغم من %~% برین نعمت ایزد زیادت کنادم(@)(@@) 13 نه آویزم از کس نه بگریزم از کس %~% نه گیرنده بازم نه بی‌مهر خادم(@)(@@) 14 مرا عشق فرمانروا اوستادست %~% من استاده فرمانبر اوستادم(@)(@@) 15 ببردم به تن رنج در کنج محنت %~% که گنج خرد بر دل خود نهادم(@)(@@) 16 هوارانیم همنشین من چو خود من %~% به شاگردی استاد عقل ایستادم(@)(@@) 17 کم آزار و بی‌رنج و پاکیزه عرضم %~% که پاکست الحمدلله نژادم(@)(@@) 18 مرا برتن خویش حکمیست نافذ %~% من استاده فرمانبر آن نفاذم(@)(@@) 19 بهر حال و هر کار آید به پیشم %~% خداوند باشد در آن حال یادم(@)(@@) 20 ز کس خیر و خوبی نباشد نخواهم %~% بدانچم بود با همه خلق رادم(@)(@@) 21 خدایست در هر عنایی معینم %~% خدایست در هر بلایی ملاذم(@)(@@) 22 شب و 
