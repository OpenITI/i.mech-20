ms1085	 مرفوعا وموقوفا ، وقال : الوقوف أصح .(@)(@@)(@@)(@@) $ ( 9509 ) قال النبي :(@)(@@) | 30 ( إياكم أن تخلطوا طاعة الله تعالى بحب ثناء العباد فتحبط أعمالكم ) )(@)(@@) الديلمي عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 9510 ) قال النبي :(@)(@@) | 30 ( إياكم والظلم فإنه يخرب قبلكم قلوبكم ) )(@)(@@) الديلمي عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9511 ) قال النبي :(@)(@@) | 30 ( إياكم والبول في المقابر فإنه يورث البرص ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9512 ) قال النبي :(@)(@@) | 30 ( إياكم والبطنة من الطعام ، فإن العبد لن يهلك حتى يؤثر شهوته على آخرته ) )(@)(@@) الديلمي عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 9513 ) قال النبي :(@)(@@) | 30 ( إياكم والبغضاء فإنها الحالقة ) )(@)(@@) الخرائطي في مساوىء الأخلاق عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9514 ) قال النبي :(@)(@@) | 30 ( إياكم والبدع فإن كل بدعة ضلالة ، وكل ضلالة تصير إلى النار ) )(@)(@@) ( ك ) عن رجل .(@)(@@) PageV03P419(@)(@@)(@@)(@@) $ ( 9515 ) قال النبي :(@)(@@) | 30 ( إياكم والشح فإنه أهلك من كان قبلكم من الأمم ، دعاهم فسفكوا دماءهم ، ودعاهم فقتلوا أولادهم ) )(@)(@@) ابن جرير عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9516 ) قال النبي :(@)(@@) | 30 ( إياكم والبخل ، فإن البخل دعا قوما فمنعوا زكاتهم ، ودعاهم فقطعوا أرحامهم ، ودعاهم فسفكوا دماءهم ) )(@)(@@) ابن جرير عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9517 ) قال النبي :(@)(@@) | 30 ( إياكم والشح فإنما أهلك من كان قبلكم الشح ، أمرهم بالكذب فكذبوا ، وأمرهم بالظلم فظلموا ، وأمرهم بالقطيعة فقطعوا ) )(@)(@@) ابن جرير عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9518 ) قال النبي :(@)(@@) | 30 ( إياكن وكفر المنعمين ، قيل : وما كفر المنعمين ، قال : لعل إحداكن أن تطول أيمتها ، أو تعنس عند أبويها ، ثم يرزقها الله زوجا ، ثم يرزقها الله منه ولدا ، ثم تغضب الغضبة فتكفره فتقول : والله ما رأيت خيرا منك قط ) )(@)(@@) ( طب ) و ابن عساكر عن أسماء بنت يزيد رضي الله عنها .(@)(@@)(@@)(@@) $ ( 9519 ) قال النبي :(@)(@@) | 30 ( إياكن وكفر المنعمين ، إن إحداكن تطول أيمتها ثم يرزقها الله البعل ، وتفيد المولد وقرة العين ، ثم تغضب الغضبة فتقسم بالله ما رأت منه ساعة خيرا قط ، من كفران نعم الله ، وذالك من كفران نعم الله ، وذالك من كفران نعم الله ) )(@)(@@) ( طب ) عن 
ms1086	 أسماء بنت يزيد رضي الله عنها .(@)(@@)(@@)(@@) $ ( 9520 ) قال النبي :(@)(@@) | 30 ( أيام التشريق أيام أكل وشرب وذكر الله عز وجل ) )(@)(@@) ( طب ) عن عبد الله بن حذافة ( طب ) عن معمر بن عبد اللله العدوي ( حم م ) عن نبيشة الهذلي رضي الله عنه .(@)(@@) PageV03P420(@)(@@)(@@)(@@) $ ( 9521 ) قال النبي :(@)(@@) | 30 ( أيام التشريق أيام أكل وشرب فلا يصومنها أحد ) )(@)(@@) ( طب ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9522 ) قال النبي :(@)(@@) | 30 ( أيام التشريق كلها ذبح ) )(@)(@@) ( ق ) عن جبير بن مطعم رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9523 ) قال النبي :(@)(@@) | 30 ( إياي والغلول ، الرجل ينكح المرأة قبل أن يقسم الفيء ثم يردها إلى القسم ، ويلبس الثوب حتى يخلق ثم يرده إلى القسم ) )(@)(@@) ( طب ) عن رويفع بن ثابت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9524 ) قال النبي :(@)(@@) | 30 ( إياي وأن يتلعب بكم الشيطان في صلاتكم ، من صلى منكم فلم يدر أشفع أم وتر فليسجد سجدتين فإنهما تمام صلاته ) )(@)(@@) ( حم ) عن عثمان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9525 ) قال النبي :(@)(@@) | 30 ( إياي والذنب الذي لا يغفر أن يغل الرجل ، ومن غل شيئا أتى به ، وآكل الربا ، فإن آكل الربا لا يقوم إلا كما يقوم الذي يتخبطه الشيطان من المس ) )(@)(@@) الديلمي عن عوف بن مالك رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9526 ) قال النبي :(@)(@@) | 30 ( إياي وربا الغلول ، أن يركب الرجل الدابة حتى تحسر قبل أن تؤدى إلى المغنم ، أو يلبس الثوب حتى يخلق قبل أن يؤدى إلى المغنم ) )(@)(@@) ( ش ) عن الأوزاعي عن بعض أصحابه .(@)(@@)(@@)(@@) $ ( 9527 ) قال النبي :(@)(@@) | 30 ( أيكم المتكلم الكلمات فإنه لم يقل بأسا ، لقد رأيت اثنى عشر ملكا ابتدرها أيهم يرفعها ) )(@)(@@) ( حب ) عن أنس أن رجلا قال : الحمد لله كثيرا طيبا مباركا فيه ، فلما قضى النبي صلاته قال : فذكره .(@)(@@)(@@)(@@) $ ( 9528 ) قال النبي :(@)(@@) | 30 ( أيكم يحب أن يصح فلا يسقم ؟ قالوا : كلنا PageV03P421 يا رسول الله ، قال : أتحبون أن تكونوا كالحمير الصيالة ، ألا تحبون أن تكونوا أصحاب بلاء وأصحاب كفارات ؟ والذي نفسي بيده ، إن الله ليبتلي المؤمن بالبلاء وما يبتليه به إلا لكرامته عليه ، وفي لفظ : إن العبد لتكون له الدرجة في 
ms1087	 الجنة فما يبلغها بشيء من عمله ، فيبتليه الله بالبلاء ليبلغ تلك الدرجة وما يبلغها بشيء من عملله ) )(@)(@@) ( حب ) و البغوي وأبو نعيم ( هب ) عن أبي فاطمة الضمري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9529 ) قال النبي :(@)(@@) | 30 ( أيكم يحب أن يعرض الله عنه ، فإن أحدكم إذا قام يصلي فإن الله تعالى قبل وجهه فلا يبصقن قبل وججهه ولا عن يمينه ، وليبصق عن يساره تحت رجله اليسرى ، فإن عجلت به بادرة فليتفل بثوبه هاكذا ، ثم طوى بعضه على بعض ) )(@)(@@) ( م د حب ك ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9530 ) قال النبي :(@)(@@) | 30 ( أيكم صنع طعاما غير ما يكفي رجلين فإنه يكفي ثلاثة ، أو صنع لثلاثة فإنه يكفي أربعة ، أو لأربعة فإنه يكفي خمسة فكنحو ذالك العدد ) )(@)(@@) ( طب ) عن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9531 ) قال النبي :(@)(@@) | 30 ( أيكم وجد ألما فليضع يده اليمنى عليه وليذكر اسم الله ثلاث مرات وليقل : أعوذ بعزة الله وقدرته من شر ما أجد وأحاذر سبع مرات ) )(@)(@@) ( طب ) عن عثمان بن أبي العاص رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9532 ) قال النبي :(@)(@@) | 30 ( أيكم بايعني على هاؤلاء الآيات الثلاث : قل تعالوا أتل ما حرم ربكم عليكم إلى ثلاث آيات فمن وفى بهن فأجره على الله ، ومن انتقص منهن شيئا فأدركه الله في الدنيا كان عقوبته ، ومن أخره إلى الآخرة كان أمره إلى الله إن شاء أخذه وإن شاء عفى عنه ) )(@)(@@) عبد بن حميد في تفسيره وابن أبي حاتم وأبو الشيخ وابن مردويه ( ك ) عن عبادة بن الصامت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9533 ) قال النبي :(@)(@@) | 30 ( أيكم المقلب الحصى بيدده إنه حظك من صلاتك ) )(@)(@@) ( طب ) عن ابن عمر رضي الله عنهما .(@)(@@) PageV03P422(@)(@@)(@@)(@@) $ ( 9534 ) قال النبي :(@)(@@) | 30 ( أيكم مال وارثه أحب إليه من ماله ، اعلموا أنه ليس منكم أحد مال وارثه أحب إليه من ماله ما لك من مالك إلا ما قدمت ، وما لوارثك إلا ما أخرت ) )(@)(@@) ( حم خ مع ) و هناد عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9535 ) قال النبي :(@)(@@) | 30 ( أيكم قرأ سبح اسم ربك الأعلى 
ms1088	 ، قد عرفت أن بعضكم خالجنيها ) )(@)(@@) عبد الرزاق عن عمران بن حصين رضي الله عنه صحيح .(@)(@@)(@@)(@@) $ ( 9536 ) قال النبي :(@)(@@) | 30 ( أيتكن اتقت الله ولم تأت بفاحشة مبينة ولزمت ظهر حصيرها فهي زوجتي في الآخرة ) )(@)(@@) ابن سعد عن عطاء بن يسار أن النبي قال لأزواجه فذكره .(@)(@@)(@@)(@@) $ ( 9537 ) قال النبي :(@)(@@) | 30 ( أيما رجل قتل فأهله بخير النظرين ، إن شاءوا أخذوا العقل ، وإن شاءوا القتل ) )(@)(@@) ( عب ت ) عن ابن المسيب مرسلا .(@)(@@)(@@)(@@) $ ( 9538 ) قال النبي :(@)(@@) | 30 ( أيما رجل أفلس وعنده سلعة بعينها فصاحبها أحق بها دون الغرماء ) )(@)(@@) ( عب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9539 ) قال النبي :(@)(@@) | 30 ( أيما امرأة خرجت من بيت زوجها بغير إذنه لعنها كل شيء طلعت عليه الشمس والقمر ، إلى أن يرضى عنها زوجها ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9540 ) قال النبي :(@)(@@) | 30 ( أيما رجل تطوع في يوم اثنتي عشرة ركعة سوى المكتوبة كان له على الله حقا واجبا بيتا في الجنة ) )(@)(@@) ابن جرير عن أم حبيبة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 9541 ) قال النبي :(@)(@@) | 30 ( أيما قوم عمل فيهم بالمعاصي هم أعز وأكثر لم يغيروا إلا عمهم بعقابه ) )(@)(@@) ابن أبي الدنيا في كتاب الأمر بالمعروف والنهي عن المنكر عن جرير رضي الله عنه .(@)(@@) PageV03P423(@)(@@)(@@)(@@) $ ( 9542 ) قال النبي :(@)(@@) | 30 ( أيما رجل أطعم جائعا أطعمه الله من طعام الجنة ، وأيما رجل آمن خائفا آمنه الله يوم القيامة من الفزع الأكبر ) )(@)(@@) الرافعي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9543 ) قال النبي :(@)(@@) | 30 ( أيما رجل حلف على مال رجل كاذبا فاقتطعه بيمينه فقد برئت منه الجنة ووجبت له النار وإن كان عود أراك ) )(@)(@@) البغوي عن أبي أمامة بن سهل ويقال ابن ثعلبة البياضي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9544 ) قال النبي :(@)(@@) | 30 ( أيما امرىء من المسلمين حلف عند منبري هاذا على يمين كاذبة يستحق بها حق مسلم أدخله الله النار وإن حلف على سواك أخضر ) )(@)(@@) ( حم ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9545 ) قال النبي :(@)(@@) | 30 ( أيما امرىء اقتطع حق امرىء مسلم بيمين كاذبة ، كانت له نكتة سوداء من نفاق 
ms1089	 في قلبه ، لا يغيرها شيء إلى يوم القيامة ) )(@)(@@) الحسن بن سفيان واللخمي وبقي بن مخلد وأبو أحمد الحاكم في الكنى والبغوي والباوردي وابن قانع ( طب ) وأبو نعيم ( ك ض ) عن ثعلبة بن عبيد الله الأنصاري رضي الله عنه ويقال اسم أبيه سهيل .(@)(@@)(@@)(@@) $ ( 9546 ) قال النبي :(@)(@@) | 30 ( أيما عبد أبق فقد برئت منه الذمة ) )(@)(@@) ( حم م ) عن جرير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9547 ) قال النبي :(@)(@@) | 30 ( أيما رجل طلق امرأته ثلاثا عند الإقراء أو ثلاثة مبهمة ، لم تحل له حتى تنكح زوجا غيره ) )(@)(@@) ( قط ) عن السيد الحسن وابن عساكر عن أبي موسى ا رضي الله عنه عن أبيه .(@)(@@) PageV03P424(@)(@@)(@@)(@@) $ ( 9548 ) قال النبي :(@)(@@) | 30 ( أيما رجل عرف ابنه فأخذه ففكاكه رقبة ) )(@)(@@) . بقي بن مخلد وابن جرير في التهذيب والباوردي .(@)(@@)(@@)(@@) $ ( 9549 ) قال النبي :(@)(@@) | 30 ( أيما رجل ضاف قوما فلم يقروه فإن له أن يطلبهم بمثل قراه ) )(@)(@@) ( طب ) عن المقدام رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9550 ) قال النبي :(@)(@@) | 30 ( أيما شجرة أظلت على قوم فصاحبه بالخيار من قطع ما أظل منها وأكل ثمرها ) )(@)(@@) ابن عساكر عن مكحول رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9551 ) قال النبي :(@)(@@) | 30 ( أيما ذهب أو فضة أوكي عليه فهو جمر على صاحبه حتى يفرغه في سبيل الله إفراغا ) )(@)(@@) ( حم طب حل ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9552 ) قال النبي :(@)(@@) | 30 ( أيما امرأة مات لها ثلاثة من الولد كن لها حجابا من النار ، قالت امرأة : واثنان ، قال : واثنان ) )(@)(@@) ( خ ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9553 ) قال النبي :(@)(@@) | 30 ( أيما رجل مسلم أعتق امرأ مسلما استنقذ الله بكل عضو منه عضوا من النار ) )(@)(@@) ( خ ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9554 ) قال النبي :(@)(@@) | 30 ( أيما امرأة تقلدت قلادة من ذهب قلدت في عنقها مثله من النار يوم القيامة ، وأيما امرأة جعلت في أذنها خرصا من ذهب جعل في أذنها مثله من النار يوم القيامة ) )(@)(@@) ( حم د ) عن أسماء بنت يزيد رضي الله عنها .(@)(@@)(@@)(@@) $ ( 9555 ) قال النبي :(@)(@@) | 30 ( أيما مسلم يصافح أخاه ليس في صدر واحد منهما 
ms1090	 على أخيه حنة لم يفرق أيديهما حتى يغفر الله عز وجل لهما ما مضى من ذنوبهما ، ومن نظر إلى أخيه نظر مودة ليس في صدره أو قلبه حنة لم يرجع إليه طرفه حتى PageV03P425 يغفر الله عز وجل لهما ما مضى من ذنوبهما ) )(@)(@@) ابن النجار عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 9556 ) قال النبي :(@)(@@) | 30 ( أيما ناشىء نشأ على عبادة الله حتى يموت أعطاه الله أجر تسعة وتسعين صديقا ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9557 ) قال النبي :(@)(@@) | 30 ( أيما امرىء مات وعنده مال امرىء بعينه ، اقتضى منه شيئا أو لم يقتص فهو أسوة الغرماء ) )(@)(@@) ( ه ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9558 ) قال النبي :(@)(@@) | 30 ( أيما أمة ولدت من سيدها فإنها حرة إذا مات إلا أن يعتقها قبل موته ) )(@)(@@) ( ه ) و ابن سعد ( ك ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 9559 ) قال النبي :(@)(@@) | 30 ( أيما رجل أصدق امرأة صداقا والله عز وجل يعلم منه أنه لا يريد أداءه إليها فغرها بالله واستحل فرجها بالباطل لقي الله يوم يلقاه وهو زان ، وأيما رجل أدان من رجل دينا والله يعلم منه أنه لا يريد أداءه فغره بالله واستحل ماله بالباطل لقي الله يوم يلقاه وهو سارق ) )(@)(@@) ( حم ق حل ص ) عن صهيب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9560 ) قال النبي :(@)(@@) | 30 ( أيما امرأة زوجها وليان فهي للأول منهما ) )(@)(@@) ( طب ) عن عقبة بن عامر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9561 ) قال النبي :(@)(@@) | 30 ( أيما أهل بيت من العرب والعجم أراد الله تعالى بهم خيرا أدخل عليهم الإسلام ، ثم تكون فتن كأنها الظلل ، والذي نفسي بيده لتعودن فيها أساود صبا يضرب بعضكم رقاب بعض ، أفضل الناس يومئذ مؤمن معتزل في شعب من الشعاب يتقي ربه ويدع الناس من شره ) )(@)(@@) ( حم طب ك ) عن كوز بن علقمة الخزاعي رضي الله عنه .(@)(@@) PageV03P426(@)(@@)(@@)(@@) $ ( 9562 ) قال النبي :(@)(@@) | 30 ( أيما رجل ارتد عن الإسلام فادعه ، فإن تاب فاقبل منه ، وإن لم يتب فاضرب عنقه ، وأيما امرأة ارتدت عن الإسلام فادعها ، فإن 
ms1091	 تابت فاقبل منها وإن أبت فاستتبها ) )(@)(@@) ( طب ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9563 ) قال النبي :(@)(@@) | 30 ( أيما مؤمن آمن مؤمنا على دمه فقتله فأنا من القاتل بريء ) )(@)(@@) ( حم ) عن عمرو بن الحمق رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9564 ) قال النبي :(@)(@@) | 30 ( أيما رجل ابتاع من رجل بيعة فإن كل واحد منهما بالخيار حتى يتفرقا من مكانهما إلا أن تكون صفقة خيار ، ولا يحل لأحد أن يفارق صاحبه مخافة أن يقيله ) )(@)(@@) ( هق ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9565 ) قال النبي :(@)(@@) | 30 ( أيما قرية افتتحها الله ورسوله فهي لله ولرسوله ، وأيما قرية افتتحها المسلمون عنوة فخمسها لله ولرسوله ، وبقيتها لمن قاتل عليها ) )(@)(@@) ( هق ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9566 ) قال النبي :(@)(@@) | 30 ( أيما عبد كان فيه شرك ، فأعتق رجل نصيبه فقام عليه القيمة يوم يعتق وليس ذاك عند الموت ) )(@)(@@) ( هق ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 9567 ) قال النبي :(@)(@@) | 30 ( أيما رجل ولدت منه أمته فهي معتقة عن دبر منه ) )(@)(@@) ( عب هق ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 9568 ) قال النبي :(@)(@@) | 30 ( أيما رجل دعا رجلا إلى شيء كان موقوفا يوم القيامة ، ملازما لعاديه لا يفارقه ، ثم قرأ : وقفوهم إنهم مسؤولون ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9569 ) قال النبي :(@)(@@) | 30 ( أيما رجل طلق امرأته ثلاثا عند كل طهر تطليقة ، أو PageV03P427 عند رأس كل شهر تطليقة ، أو طلقها ثلاثا لم تحل له حتى تنكح زوجا غيره ) )(@)(@@) ( قط ) في الأفراد و الديلمي عن الحسن بن علي رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 9570 ) قال النبي :(@)(@@) | 30 ( أيما رجل نتف شعرة بيضاء متعمدا صارت رمحا يوم القيامة يطعن به ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9571 ) قال النبي :(@)(@@) | 30 ( أيما امرىء غسل أخا له مسلما فلم يقذره ولم ينظر إلى عورته ولم يذكر منه سوءا ثم شيعه وصلى عليه ثم جلس حتى يدلى في حفرته ، خرج عطلا من ذنوبه ) )(@)(@@) ابن شاهين والديلمي عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9572 ) قال النبي :(@)(@@) | 30 ( أيما امرىء اشتهى شهوة فرد شهوته 
ms1092	 وآثر على نفسه غفر الله له ) )(@)(@@) ( قط ) في الأفراد و أبو الشيخ في الثواب عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 9573 ) قال النبي :(@)(@@) | 30 ( أيما عبد قال لا إلاه إلا الله الكريم الحليم سبحان الله رب العرش العظيم والحمد لله رب العالمين ، حق على الله تعالى أن يحرمه على النار ) )(@)(@@) الديلمي عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9574 ) قال النبي :(@)(@@) | 30 ( أيما جنازة لم يتبعها خلق ولا ناس شيعها سبعون ألف ملك ) )(@)(@@) أبو الشيخ والديلمي عن عتير البدري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9575 ) قال النبي :(@)(@@) | 30 ( أيما امرأة من المهاجرات اختطت فلها خطتها ) )(@)(@@) الديلمي عن أم سلمة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 9576 ) قال النبي :(@)(@@) | 30 ( أيما زائر زار أخاه وهو صائم فأفطر إلا كتب الله له تعالى صوم ذالك اليوم ) )(@)(@@) الديلمي عن سلمان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9577 ) قال النبي :(@)(@@) | 30 ( أيما رجل رأى امرأة فأعجبته فليقم إلى أهله فإن معها PageV03P428 مثل الذي معها ) )(@)(@@) ( هب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9578 ) قال النبي :(@)(@@) | 30 ( أيما لحم نبت من حرام فالنار أولى به ) )(@)(@@) ( هب ) عن أبي بكر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9579 ) قال النبي :(@)(@@) | 30 ( أيما رجل أتاه ابن عمه يسأله من فضله فمنعه منع الله فضله يوم القيامة ) )(@)(@@) ( طس ) عن عمرو بن شعيب عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 9580 ) قال النبي :(@)(@@) | 30 ( أيها الناس إن الله تعالى يقول : مروا بالمعروف وانهوا عن المنكر من قبل أن تدعوني فلا أجيبكم ، وتسألوني فلا أعطيكم ، وتستنصروني فلا أنصركم ) )(@)(@@) ( هق ) و الديلمي عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 9581 ) قال النبي :(@)(@@) | 30 ( أيها الناس إن النساء عندكم عوان ، أخذتموهن بأمانة الله ، واستحللتم فروجهن بكلمة الله ، ولكم عليهن حق ، ولهن عليكم حق ، ومن حقكم عليهن أن لا يوطئن فرشكم أحدا ، ولا يعصينكم في معروف ، فإذا فعلن ذالك فلهن رزقهن وكسوتهن بالمعروف ) )(@)(@@) ابن جرير عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 9582 ) قال النبي :(@)(@@) | 30 ( أيها الناس إنما خلعت نعلي راحة لرجلي ، فمن أراد أن يخلعها فليخلعها ، ومن أراد أن يصلي فيها فليصل 
ms1093	 فيها ) )(@)(@@) الديلمي عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 9583 ) قال النبي :(@)(@@) | 30 ( أيها الناس إن الله تعالى يقول : مروا بالمعروف وانهوا عن المنكر قبل أن تدعوني فلا أجيبكم ، وتسألوني فلا أعطيكم ، وتستغفروني فلا أغفر لكم ) )(@)(@@) الديلمي عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 9584 ) قال النبي :(@)(@@) | 30 ( أيها الناس إني إمامكم فلا تسبقوني بالركوع ولا بالسجود ولا بالقيام ولا بالانصراف فإني أراكم أمامي ومن خلفي ) )(@)(@@) ( ش ) عن أنس رضي الله عنه .(@)(@@) PageV03P429(@)(@@)(@@)(@@) $ ( 9585 ) قال النبي :(@)(@@) | 30 ( أيها الناس من أصيب منكم بمصيبة من بعدي فليتعز بمصيبته بي عن مصيبته التي تصيبه فإنه لن يصاب أحد من أمتي من بعدي بمصيبة بمثل مصيبته بي ) )(@)(@@) ( طس ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 9586 ) قال النبي :(@)(@@) | 30 ( أيها الناس توبوا إلى ربكم ، فوالله إني لأتوب إلى ربي في اليوم مائة مرة ) )(@)(@@) ( ش طب ) عن الأغر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9587 ) قال النبي :(@)(@@) | 30 ( أينهانا الله عن الربا ويقبله منا ، إنما التفريط في اليقظة ) )(@)(@@) عبد الرزاق ( طب ) عن عمران بن حصين رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9588 ) قال النبي :(@)(@@) | 30 ( أيها الملك ارفق بصاحبي فإنه مؤمن ) )(@)(@@) ابن قانع عن الحارث بن الخزرج الأنصاري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9589 ) قال النبي :(@)(@@) | 30 ( أيها الناس الحلال بين والحرام بين ، وبين ذالك أمور مشتبهات فمن تركهن سلم دينه وعرضه ، ومن أوضع فيهن يوشك أن يقع فيه ، ولكل ملك حمى وإن حمى الله في أرضه محارمه ) )(@)(@@) ( قط ) في الأفراد و ابن عساكر عن بشير بن النعمان بن بشير عن أبيه قال ( قط ) : لا أعلم لبشير بن النعمان رضي الله عنه حديثا مسندا غيره .(@)(@@)(@@)(@@) $ ( 9590 ) قال النبي :(@)(@@) | 30 ( أيها الناس إني تارك فيكم ما إن أخذتم به بعدي لن تضلوا ، أمرين أحدهما أكبر من الآخر : كتاب الله حبل ممدود ما بين السماء والأرض ، وعترتي أهل بيتي ، وإنهما لن يتفرقا حتى يردا علي الحوض ) )(@)(@@) ( ع طب ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9591 ) قال النبي :(@)(@@) | 30 ( أيها الناس إني تارك فيكم أمرين لن تضلوا إن اتبعتوهما : كتاب الله 
ms1094	 وأهل بيتي عترتي ، تعلمون أني أولى بالمؤمنين من أنفسهم ، من كنت مولاه فعلي مولاه ) )(@)(@@) ( ك ) عن زيد بن أرقم رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9592 ) قال النبي :(@)(@@) | 30 ( أيها الناس كأن الموت فيها على غيرنا كتب ، وكأن PageV03P430 الحق فيها على غيرنا وجب ، وكأن الذي نشيع من الأموات سفر عما قليل إلينا راجعون ، نبوئهم أجداثهم ، ونأكل تراثهم كأننا مخلدون بعدهم ، قد نسينا كل واعظة ، وأمنا كل جائحة ، وطوبى لمن شغله عيبه عن عيوب الناس ، طوبى لمن طاب مكسبه ، وصلحت سريرته ، وحسنت علانيته ، واستقامت طريقته ، طوبى لمن تواضع لله من غير منقصة ، وأنفق مما جمعه من غير معصية ، وخالط أهل الفققه والحكمة ، ورحم أهل الذل والمسكنة ، وطوبى لمن أنفق الفاضل من ماله ، وأمسك الفضل من قوله ، ووسعته السنة ، ولم يعدل عنها إلى بدعة ، ثم نزل ) )(@)(@@) الحكيم عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9593 ) قال النبي :(@)(@@) | 30 ( أيها الناس ألا تسمعون ؟ أطيعوا ربكم ، وصلوا خمسكم ، وأدوا زكاة أموالكم ، وأطيعوا أمراءكم تدخلوا جنة ربكم ) )(@)(@@) ( حب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9594 ) قال النبي :(@)(@@) | 30 ( أيها الناس إن الله قد افترض عليكم الحج ، فقال رجل : أكل عام ؟ قال : لو قلت نعم لوجبت ، ولو وجبت ما قمتم بها ، ذروني ما تركتكم ، فإنما هلك الذين من قبلكم بكثرة سؤالهم واختلافهم على أنبيائهم ، فإذا نهيتكم عن شيء فاجتنبوه ، وإذا أمرتكم بشيء فأتوا منه ما استطعتم ) )(@)(@@) ( حب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9595 ) قال النبي :(@)(@@) | 30 ( أيها الناس إن الشمس والقمر آيتان من آيات الله ، فإذا انكسف أحدهما فافزعوا إلى المساجد ) )(@)(@@) ( حب ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9596 ) قال النبي :(@)(@@) | 30 ( أيها الناس سلوا الله المعافاة . فإنه لم يعط أحد مثل اليقين بعد المعافاة ، ولا أشد من الريبة بعد الكفر ، وعليكم بالصدق فإنه يهدي إلى البر وهما في الجنة ، وإياكم والكذب فإنه يهدي إلى الفجور وهما في النار ) )(@)(@@) ( حب ) عن أبي بكر رضي الله عنه .(@)(@@) PageV03P431(@)(@@)(@@)(@@) $ ( 9597 ) قال النبي :(@)(@@) | 30 ( أيها الناس قد آن لكم أن تستعفوا عن المسألة فإنه 
ms1095	 من يستعف يعفه الله ، ومن يستغن يغنه الله ، والذي نفس محمد بيده ما رزق عبد من رزق أوسع من الصبر ، ولئن أبيتم إلا أن تسألوني لاعطينكم ما وجدت ) )(@)(@@) ( حل ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9598 ) قال النبي :(@)(@@) | 30 ( أيها الناس يوشك أن تكونوا أجنادا مجندة ، جند بالشام ، وجند بالعراق ، وجند باليمن ، قال ابن خوالة : اختر لي يا رسول الله ، قال : إني أختار لك الشام ، فإنه خيرة المسلمين ، وصفوة الله من بلاده ، يجتبي إليها صفوته من خلقه ، فمن أبى فليلحق بيمنه وليسق من غدره ، فإن الله تعالى قد تكفل لي بالشام وأهله ) )(@)(@@) ( طب ) عن العرباض .(@)(@@)(@@)(@@) $ ( 9599 ) قال النبي :(@)(@@) | 30 ( أيها الناس من كان عنده شيء فليرده ولا يقل : فضوح الدنيا ، ألا وإن فضوح الدنيا أيسر من فضوح الآخرة ) )(@)(@@) ( طب ) عن الفضل بن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 9600 ) قال النبي :(@)(@@) | 30 ( أيها الناس إنما العلم بالتعلم والفقه بالتفقه ، ومن يرد الله به خيرا يفقهه في الدين ، وإنما يخشى الله من عباده العلماء ) )(@)(@@) ( طب ) عن معاوية رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9601 ) قال النبي :(@)(@@) | 30 ( أيها الناس إن من العنب خمرا ، وإن من التمر خمرا ، وإن من البسر خمرا ، وإن من الشعير خمرا ، وإن من العسل خمرا ، وأنا أنهى عن كل مسكر ) )(@)(@@) ( طب ) عن النعمان بن بشير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9602 ) قال النبي :(@)(@@) | 30 ( أيها الناس إن الشمس والقمر آيتان من آيات الله ، لا ينخسفان لموت أحد ولا لحياته ، فاذا رأيتم ذالك فافزعوا إلى الصلاة والصدقة وإلى ذكر الله ، وقد رأيت منكم سبعين ألفا يدخلون الجنة بغير حساب مثل صورة القمر ليلة البدر ) )(@)(@@) ( طب ) عن أسماء بنت أبي بكر رضي الله عنها .(@)(@@) PageV03P432(@)(@@)(@@)(@@) $ ( 9603 ) قال النبي :(@)(@@) | 30 ( أيها الناس إن قريشا أهل أمانة ، من بغاها العواثر كبه الله تعالى لمنخريه قالها ثلاثا ) )(@)(@@) الشافعي والبغوي ( طب هق ) في المعرفة عن إسماعيل بن عبيد بن رفاعة الأنصاري عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 9604 ) قال النبي :(@)(@@) | 30 ( أيها الناس إني قد بدنت فلا تسبقوني بالركوع والسجود ، ولاكن أسبقكم إنكم 
ms1096	 تذرون ما فاتكم ) )(@)(@@) ( هق ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9605 ) قال النبي :(@)(@@) | 30 ( أيها الناس إني لكم فرط ، وإني أوصيكم بعترتي خيرا ، موعدكم الحوض ) )(@)(@@) ( ك ) عن عبد الرحمان بن عوف رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9606 ) قال النبي :(@)(@@) | 30 ( أيها الناس إياكم وشرك السرائر ، يقوم الرجل فيصلي فيزين صلاته جاهدا لما يرى من نظر الناس إليه فذالك شرك السرائر ) )(@)(@@) ( هق ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9607 ) قال النبي :(@)(@@) | 30 ( أيها الناس عليكم بالجماعة وإياكم والفرقة ) )(@)(@@) ( حم ) عن رجل .(@)(@@)(@@)(@@) $ ( 9608 ) قال النبي :(@)(@@) | 30 ( أيها الناس أظلتكم الفتن كقطع الليل المظلم ، أيها الناس لو تعلمون ما أعلم لبكيتم كثيرا ولضحكتم قليلا ، أيها الناس استعيذوا بالله من عذاب القبر فإن عذاب القبر حق ) )(@)(@@) ( حم ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 9609 ) قال النبي :(@)(@@) | 30 ( أيها الناس أي شهر أحرم ؟ قالوا : هاذا ، قال : أيها الناس فأي بلد أحرم ؟ قالوا : هاذا ، قال : فإن دماءكم وأموالكم وأعراضكم محرمة عليكم كحرمة يومكم هاذا ، في شهركم هاذا ، في بلدكم هاذا إلى يوم تلقون ربكم ، هل بلغت ، اللهم اشهد ، أيها الناس ليبلغ منكم الشاهد الغائب ) )(@)(@@) ( بز ) PageV03P433 عن وابصة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9610 ) قال النبي :(@)(@@) | 30 ( أيها الناس أما بعد ، فإن أصدق الحديث كتاب الله ، وأوثق العرى كلمة التقوى ، وخير الملل ملة إبراهيم ، وخير السنن سنة محمد ، وأشرف الحديث ذكر الله ، وأحسن القصص هاذا القرآن ، وخير الأمور عوارفها ، وشر الأمور محدثاتها ، وأحسن الهدي هدي الأنبياء ، وأشرف الموت قتل الشهداء ، وأعمى العمى الضلالة بعد الهدي ، وخير الأعمال ما نفع ، وخير الهدى ما اتبع ، وشر العمى عمى القلب ، واليد العليا خير من اليد السفلى ، وما قل وكفى خير مما كثر وألهى ، وشر المعذرة حتى يحضر الموت ، وشر الندامة ندامة يوم القيامة ، ومن الناس من لا يأتي الجمعة إلا دبرا ، ومن الناس من لا يذكر الله إلا هجرا ، وأعظم الخطايا اللسان الكذوب ، وخير الغنى غنى النفس ، وخير الزاد التقوى ، ورأس الحكمة مخافة الله ، وخير ما وقر في القلب اليقين ، والارتياب من الكفر ، والنياحة من عمل 
ms1097	 الجاهلية ، والغلول من جثاء جهنم ، والمسكر نير من النار ، والشعر مزامير إبليس ، والخمر جماع الإثم ، والنساء حبالة الشيطان ، والشباب شعبة من الجنون ، وشر المكاسب كسب الربا ، وشر المأكل مال اليتيم ، والسعيد من وعظ بغيره ، والشقي من شقي في بطن أمه ، وإنما يصير أحدكم إلى موضع أربع أذرع ، والأمر إلى آخره ، وملاك العمل خواتمه ، وشر الروايات رواية الكذب ، وكل ما هو آت قريب ، وسباب المؤمن فسوق ، وقتال المؤمن كفر ، وأكل لحمه من معصية الله ، وحرمة ماله كحرمة دمه ، ومن يتأول على الله يكذبه ، ومن يغفر يغفر الله له ، ومن يعف يعف الله عنه ، ومن يكظم الغيظ يؤجره الله ، ومن يصبر على الرزية يعوضه الله ، ومن يبتغ السمعة يسمع الله به ، ومن يصبر يضعف الله له ، ومن يعص الله يعذبه الله ، اللهم اغفر لي ولأمتي ثلاثا ، أستغفر الله لي ولكم ) )(@)(@@) ( هق ) في الدلائل و الديلمي وابن عساكر عن عقبة بن عامر الجهني أبو نصر السجزي في الإبانة عن أبي الدرداء ( ش حل ) عن ابن مسعود PageV03P434 رضي الله عنه موقوفا .(@)(@@)(@@)(@@) $ ( 9611 ) قال النبي :(@)(@@) | 30 ( أيها الناس إن أحدكم إذا قام في الصلاة فإنه في مقام عظيم بين يدي رب عظيم يسأل أمرا عظيما ، الفوز بالجنة والنجاة من النار ، وإن أحدكم إذا قام في الصلاة فإنه يقوم بين يدي الله عز وجل مستقبلا ربه ، وملكه عن يمينه وقرينه عن يساره ، فلا يتفلن أحدكم بين يديه ولا عن يمينه ، ولاكن عن يساره أو تحت قدمه اليسرى ثم ليعرك فليشدد عركه ، فإنما يعرك أذني الشيطان ، والذي بعثني بالحق لو تكشفت بينكم وبينه الحجب أو يؤذن في الكلام لشكى ما يلقى من ذالك ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9612 ) قال النبي :(@)(@@) | 30 ( أيها الناس هاجروا وتمسكوا بالإسلام ، فإن الهجرة لا تنقطع ما دام الجهاد ) )(@)(@@) ( طب ) عن أبي قرصافة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9613 ) قال النبي :(@)(@@) | 30 ( أيها الناس إني والله ما آمركم إلا بما أمركم الله به ، ولا أنهاكم إلا عما نهاكم الله عنه ، فأجملوا في 
ms1098	 الطلب ، فوالذي نفس أبي القاسم بيده إن أحدكم ليطلبه رزقه كما يطلبه أجله ، فإن تعسر عليكم شيء منه فاطلبوه بطاعة الله عز وجل ) )(@)(@@) ( طب ) عن السيد الحسن بن علي رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 9614 ) قال النبي :(@)(@@) | 30 ( أيها الناس لا يحولن بين أحدكم وبين الجنة ملء كف من دم اهراقه ظلما ، من صلى الغداة فهو في ذمة الله ، يا ابن آدم ولا يطلبنك الله بشيء من ذمته ) )(@)(@@) ( طب ) عن جندب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9615 ) قال النبي :(@)(@@) | 30 ( أيها الناس اسمعوا واعقلوا واعلموا أن لله عبادا ليسوا بأنبياء ولا شهداء ، يغبطهم النبيون والشهداء على مجالسهم وقربهم من الله عز وجل ، هم ناس من أفناء الناس ونوازع القبائل لم تتصل بهم أرحام متقاربة ، تحابوا بجلال الله وتصافوا فيه وتزاوروا فيه وتبادلوا فيه ، يضع الله لهم يوم القيامة منابر من نور فيجلسون عليها ، وإن ثيابهم لنور ووجوههم نور لا يخافون إذا خاف PageV03P435 الناس ، ولا يفزعون إذا فزع الناس ، أولائك أولياء الله الذين لا خوف عليهم ولا هم يحزنون ) )(@)(@@) ( حم ) و ابن أبي الدنيا في كتاب الإخوان والحكيم وابن عساكر عن أبي مالك الأشعري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9616 ) قال النبي :(@)(@@) | 30 ( أيها الناس زوروهم وأتوهم وسلموا عليهم ، فوالذي نفسي بيده لا يسلم عليهم مسلم إلى يوم القيامة إلا ردوا عليه السلام يعني شهداء أحد ) )(@)(@@) ابن سعد عن عبيد بن عمير رضي الله عنه مرسلا .(@)(@@)(@@)(@@) $ ( 9617 ) قال النبي :(@)(@@) | 30 ( أيها الناس إنما الدنيا عرض حاضر يصيب منها البر والفاجر ، وإن الآخرة وعد صادق يحكم فيها ملك قادر يحق بها الحق ويبطل الباطل ، أيها الناس فكونوا من أبناء الآخرة ولا تكونوا من أبناء الدنيا ، فإن كل أم يتبعها ولدها ، اعملوا وأنتم من الله على حذر ، واعلموا أنكم معروضون على أعمالكم ، وأنكم ملاقو الله لا بد منه ، فمن يعمل مثقال ذرة خيرا يره ، ومن يعمل مثقال ذرة شرا يره ) )(@)(@@) الحسن بن سفيان ( طب ) وابن مردويه ( حل ) عن شداد بن أوس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9618 ) قال النبي :(@)(@@) | 30 ( أيها 
ms1099	 الناس احفظوني في هاذا الحي من الأنصار فإنهم كرشي الذي آكل فيها وعيبتي ، اقبلوا من محسنهم ، وتجاوزوا عن مسيئهم ) )(@)(@@) ( طب ) عن سعد بن زيد الأشهلي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9619 ) قال النبي :(@)(@@) | 30 ( أيها الناس ألا أنبئكم بخياركم ، الذين إذا رؤوا ذكر الله ، ألا أنبئكم بشراركم ، فإن شراركم المشاؤون بالنميمة ، المفسدون بين الأحبة ، الباغون البرآء العنت ) )(@)(@@) ( حم طب ) عن أسماء بنت يزيد رضي الله عنها .(@)(@@)(@@)(@@) $ ( 9620 ) قال النبي :(@)(@@) | 30 ( أيها الناس سلوا الله إلى موتاكم ، ولا تؤذنوا بهم الناس ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنها .(@)(@@) PageV03P436(@)(@@)(@@)(@@) $ ( 9621 ) قال النبي :(@)(@@) | 30 ( أيها الناس اتقوا الشرك فإنه أخفى من دبيب النمل ، قالوا : وكيف نتقيه يا رسول الله ؟ قال : قولوا : اللهم إنا نعوذ بك أن نشرك بك شيئا نعلمه ، ونستغفرك لما لا نعلمه ) )(@)(@@) ( حم طب ) عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9622 ) قال النبي :(@)(@@) | 30 ( أيها الناس لا يحل لي ولا لأحد من مغانم المسلمين ما يزن هاذه الوبرة بعد الذي فرض الله لي ) )(@)(@@) ( طب ) عن عمرو بن خارجة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9623 ) قال النبي :(@)(@@) | 30 ( أيها الناس إنكم قد أسرعتم في حظائر يهود ، ألا لا تحل أموال المعاهدين إلا بحقها ، وحرام عليكم لحوم الحمر الأهلية وخيلها وبغالها وكل ذي ناب من السباع وكل ذي مخلب من الطير ) )(@)(@@) ( حم د ) و الباوردي عن خالد بن الوليد رضي الله عنه وزاد ألا يقول رجل متكىء على أريكته ما وجدنا في كتاب الله من حلال أحللناه ، وما وجدنا في كتاب الله من حرام حرمناه ، وإني حرمت عليكم أموال المعاهدين بغير حقها .(@)(@@)(@@)(@@) $ ( 9624 ) قال النبي :(@)(@@) | 30 ( أيها الناس اتقوا الله واصبروا فوالله إن كان الرجل من المؤمنين قبلكم ليوضع المنشار على رأسه فيشق باثنين وما يرتدد عن دينه ، اتقوا الله فإن الله عز وجل فاتح لكم وصانع ) )(@)(@@) ( طب ك ) عن خباب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9625 ) قال النبي :(@)(@@) | 30 ( أيها الناس من كان منكم أكل فلا يأكل بقية يومه ، ومن نوى منكم الصوم فليصمه ، قاله يوم عاشوراء 
ms1100	 ) )(@)(@@) ( طب ) عن خباب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9626 ) قال النبي :(@)(@@) | 30 ( أيها الناس إذا كان هاذا اليوم فاغتسلوا وليمس PageV03P437 أفضل ما يجد من دهنه وطيبه ) )(@)(@@) ( د ك طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 9627 ) قال النبي :(@)(@@) | 30 ( أيها الناس أي أهل الأرض تعلمون أكرم على الله ؟ قالوا : أنت ، قال : فإن العباس مني وأنا منه ، لا تؤذوا العباس فتؤذوني ، من سب العباس فقد سبني ، لا تسبوا فتؤذوا أحياءنا ) )(@)(@@) ( حم ن ) و ابن سعد ( طب ) والخطيب عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 9628 ) قال النبي :(@)(@@) | 30 ( أيها الناس إنما أنا رحمة مهداة ) )(@)(@@) ابن سعد والحكم ( هب ) عن أبي صالح مرسلا ابن النجار عنه عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9629 ) قال النبي :(@)(@@) | 30 ( أيها الناس إن دين الله يسر ) )(@)(@@) ( حم ) و ابن سعد عن غاضر بن عروة الفقيمي عن أبيه .(@)(@@)(@@)(@@) $ ( 9630 ) قال النبي :(@)(@@) | 30 ( أيها الناس إني فرطكم ، وإنكم واردون على حوضي ، عرضه ما بين بصرى وصنعاء ، فيه أكواب عدد النجوم ) )(@)(@@) ( سمويه ) عن حذيفة بن أسيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9631 ) قال النبي :(@)(@@) | 30 ( أيها الناس إني قد رأيت ليلة القدر ثم أنسيتها ، ورأيت في ذراعي سوارين من ذهب فكرهتهما فنفختهما فطارا ، فأولتهما هاذان الكذابان : صاحب اليمامة وصاحب اليمن ) )(@)(@@) ( حم ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9632 ) قال النبي :(@)(@@) | 30 ( لا تشكوا عليا فوالله إنه لاخيشن في ذات الله عز وجل وفي سبيل الله ) )(@)(@@) ( حم ك ض ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9633 ) قال النبي :(@)(@@) | 30 ( أيها الناس إن الله عز وجل قد تطول عليكم في يومكم هاذا ، فوهب مسيئكم لمحسنكم ، وأعطى محسنكم ما سأل ، وغفر لكم ما PageV03P438 كان منكم ) )(@)(@@) ابن منده عن عبد الرحمان بن عبد الله بن زيد عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 9634 ) قال النبي :(@)(@@) | 30 ( أيها الناس لا غش بين المسلمين ، من غشنا فليس منا ) )(@)(@@) ابن النجار عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 9635 ) قال النبي :(@)(@@) | 30 ( أيها الناس لا صلاة إلا بوضوء ، ولا وضوء لمن لم يذكر اسم 