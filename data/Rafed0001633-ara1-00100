ms81	 %~% سلمت أنت من أجاب الغزالا(@)46 أنت مهدي آل أحمد حقا %~% ضل من كان غير ما قلت قالا(@)47 سعد الزبرقان حين تمنى %~% لنعاليك أن يكون قبالا(@)48 ذي بطون الوهاد ملأى جسوما %~% منكم كلهن رحن إغتيالا(@)49 بين سم وبين قتل إلى أن %~% سئم القتل منهم وإستقالا(@)50 أنت من هاشم وهاشم ممن %~% لا يملون للثقال إحتمالا(@)51 بأبي أنت لا ترعني بخطب %~% أنا وألله أضعف الناس حالا(@)52 جد بما أرتجيه أنت لعمري %~% أكرم الناس للعفاة نوالا(@)53 وأعني على زماني إني %~% لا أرى غيركم لنفسي ثمالا(@)54 وسلامي عليك يترى مدى الدهر %~% وما هاجت الرياح الرمالا(@)(@)(@@)(@@)(@@) ||| ** التعليقات :(@)(@@) في نسخة : بيته (الناشر).(@)(@@) 41 44 تشبيه المهدي عليه السلام بألأنبياء إعتمادا على قصصهم في القرآن الكريم.(@)(@@) 45 يشير إلى خبر مشهور وقع لأمير المؤمنين علي عليه السلام في خروجه إلى الخوارج حيث غابت الشمس ولم يصل العصر فتكلم بكلام ردت فيه الشمس وسلمت عليه ثم صلى العصر.(@)(@@) 47 الزبرقان : يعني القمر وهو أيضا لقب الصحابي الحسين بن بدر التميمي لجماله وشكله.(@)(@)(@@)(@@)(@@) || (56)(@)(@)(@@)(@@)(@@) || ساقي عطاشى كربلاء(@)(@@) من الطويل ألأول :(@)(@)(@@)(@@)(@@) ||| ** قالها في رثاء العباس بن علي عليهما السلام :(@)1 إذا كان ساقي الناس في الحشر حيدر %~% فساقى عطاشى كربلاء أبو الفضل(@)PageV01P124 2 على أن ساقي الناس في الحشر قلبه %~% مريع وهذا بالظما قلبه يغلي(@)3 وقفت على ماء الفرات ولم أزل %~% أقول له والقول يحسنه مثلي(@)4 علامك تجري لا جريت لوارد %~% وأدركت يوما بعض عارك بالغسل(@)5 أما نشفت أكباد آل محمد %~% لهيبا وما إبتلت بعل ولا نهل(@)6 من الحق أن تذوي غصونك ذبلا %~% أسى وحياء من شفاههم الذبل(@)7 فقال إستمع للقول إن كنت سامعا %~% وكن قابلا عذري ولا تكثرن عذلي(@)8 ألا أن دمعي الذي أنت ناظر %~% غداة جعلت النوح بعدهم شغلي(@)9 برغمي ارى مائي يلذ سواهم %~% به وهم صرعى على عطش حولي(@)10 جزى ألله عنهم في المؤاساة عمهم %~% أبا الفضل خيرا لو شهدت أبا الفضل 
ms82	(@)11 لقد كان سيفه صاغه ليمينه %~% علي فلم يجنح شباه إلى الصقل(@)12 أخو إبن رسول الله وإبن وصيه %~% على أن كلا جده سيد الرسل(@)13 إذا عدأبناء النبي محمد %~% رآه أخاهم من رآه بلا فصل(@)14 شفا كبدا من آل أحمد وإشتفت %~% به أكبد من كل ذي حسب وغل(@)15 ترى النبل يحكي النحل رشا بجسمه %~% غداة حكى جثمانه كورة النحل(@)16 لما رأيت الماء غير محرم %~% على أحد إلا على أهلك النبل(@)17 وأحدق فيه للضلال كتائب %~% تحجبه بالبيض وألأسل الذبل(@)18 تقحمته حتى إذا ما ملكته %~% بسطت له كفا معودة البذل(@)19 ولما ذكرت السبط مع أهل بيته %~% قذفت به قذف الحنية للنبل(@)20 فلم ير ظام حوله الماء قبله %~% ولم يرو منه وهو ذو مهجة تغلي(@)21 وما خطبه إلا الوفاء وقل ما %~% ترى هكذا خلا وفيا مع الخل(@)22 يعد ببذل المال في حيه الفتى %~% سخيا وذا بالمال والنفس وألأهل(@)23 يمينا بيمناك القطيعة والتي %~% تسمى شمالا وهي جامعة الشمل(@)24 لصبرك دون إبن النبي بكربلا %~% على الهول أمر لا يحيط به عقلي(@)25 ووافاك لا يدري أفقدك راعه %~% أم العرش غالته المقادير بالشل(@)26 اخي كنت لي درعا ونصلا كلاهما %~% فقدت فلا درعي لدي ولا نصلي(@)27 لي الله فردا كل حزب محاربي %~% ولا صحبتي دوني تذب ولا أهلي(@)28 مضى كلهم عني سراعا إلى الفنى %~% فهاهم بلا دفن أراهم ولا غسل(@)29 أخي أنجم السعد التي أنت بدرها %~% تهاوت أفولا في بروج من الرمل(@)30 فلا نجم للساري ولا نار للقرى %~% ولا كهف للاجي ولا خصب للمحل(@)PageV01P125 31 أخي قاتلي وجدي بكم غير أنني %~% ارى دون ما ألقاه من ما بكم قبلي(@)32 لئن كان سهل ما لقيت من الردى %~% عليك فما حملي فراقك بالسهل(@)33 أخي لم تنل ما رمت في مدها يدي %~% ولا بلغت بي ما أحاوله رجلي(@)34 فها أنا كالمرمي في البحر موثقا %~% تقلبه ألأمواج مقلا على مقل(@)35 
ms83	 كفى الطير وهنا بعد حص جناحه %~% إذا إغتال يوما ريشه الدهر بالنسل(@)(@)(@@)(@@)(@@) ||| ** التعليقات :(@)(@@) وردت هذه القصيدة في كتاب عن أبي الفضل العباس بن علي بن أبي طالب مؤلفه عبدالرزاق المقرم.(@)(@@) 3 11 : تذكرني مخاطبة الشاعر لنهر الفرات بمخاطبة أخت الفجاءة لنهر الخابور وقد زاد شاعرنا هنا إعتذار الفرات وما رواه لما حدث للعباس عليه السلام .(@)(@@) 34 المقل : الغمس بالماء وقوله مقلا على مقل أي غطسة على أثر غطسة.(@)(@@) 35 حص جناحه أي قليل الريش.(@)(@)(@@)(@@)(@@) || (57)(@)(@)(@@)(@@)(@@) || أسد ألأسود(@)(@@) من الكامل ألأول :(@)(@@) أنشأها في نصب الرسول صلى الله عليه وآله وسلم وآله لعلي عليه السلام خليفة على المسلمين :(@)(@@) 1 يا صاح ما هذا الكتاب المنزل %~% يا صاح ما هذا النبي المرسل(@)2 ما هذه ألآيات تتلى بيننا %~% فمفصل منها ومنها مجمل(@)3 هل غير طه كان عنها مخبرا %~% أم غير خالقنا لهن منزل(@)4 أترى المبلغ كان فيها كاذبا %~% أم هذه ألأنباء غير تقول(@)5 أم قال مختارون أنتم فأنصبوا %~% من شئتم بعدي إماما وإعزلوا(@)6 فغدوا شعوبا بعده وقبائلا %~% فمحرف ومغير ومبدل(@)7 كل يحاول أن يكون خليفة %~% حتى إبن آكلة الذباب ألأرذل(@)PageV01P126 8 فأصاب منها ما أصاب وبعده %~% ذهبت سفالا يدعيها ألأسفل(@)9 ماذا ترى في أمة لعبت بها %~% تيم وراحت إثر تيم نعثل(@)10 وبها علي وهو أولى من بها %~% بألأمر لو أن المخاصم يعدل(@)11 أو لم يكن يوم الغدير الم يكن %~% جبريل فيه بالزواجر ينزل(@)12 أو لم يقل من كنت مولاه فذا %~% مولاه بعدي ويلكم لا تجهلوا(@)13 هذا هو الباب الذي من قبل ذا %~% كلفتم أن تدخلوه فإدخلوا(@)14 ألأنبياء جميعهم قبلي كذا %~% فعلوا فما لي بعدهم لا أفعل(@)15 ولكل بيت في ألأنام دعامة %~% ودعامة ألإسلام هذا فإعقلوا(@)16 وألله ما انا بالذي أمرته %~% ألله أمره عليكم فإقبلوا(@)17 وأنا المدينة وإبن عمي بابها %~% هل من سوى الباب المدينة تدخل(@)18 أنا من علي وهو مني مثلما %~% هارون من موسى فلا تتعللوا(@)19 يا قوم 
ms84	 إن نبوتي ما لم تكن %~% فيها ولاية حيدر لا تكمل(@)20 إن تسعدوه تسعدوا أو %~% تنصروه تنصروا أو تخذلوه تخذلوا(@)21 واقول هذا والقلوب كأنها %~% تغلي علي من الحرارة مرجل(@)22 إياكم أن تجحدوا إياكم %~% أن تخذلوا إياكم أن تنكلوا(@)23 هذا الكتاب وعترتي فتمسكوا %~% بهما وإن لم تفعلوا لم تقبلوا(@)24 ويل لمن ناواهما وقلاهما %~% ويل لمن هو فيهما لا يحفل(@)25 إن الخلافة لا تحل لغيره %~% هذا أخي فيها المعم المخول(@)26 إن الخلافة لا تليق لغيره %~% من حبتر من أدلم من نعثل(@)27 إن الخلافة كالنبوة رتبة %~% تلك ألأخيرة والنبوة أول(@)28 إن النبي معلم من ربه %~% وكذا خليفته فلا تتبدلوا(@)29 ليس الخليفة من يحير ويجهل %~% ليس الخليفة من يشح ويبخل(@)30 ليس الخليفة من يقول لدى الوغى %~% حيدي حياد وقلبه يتزلزل(@)31 ليس الخليفة كائن مثلي انا %~% ما ناب يوما معضل أو مشكل(@)32 فكأنني بكم غدا تأتونني %~% وسيوفكم منه تعل وتنهل(@)33 تردون حوضي وهو غير محلل %~% لمن إعتدى ودمي لديه محلل(@)34 ومضى بأبراد الثناء مزملا %~% نفسي فداؤك أيها المزمل(@)35 فهنالكم عما دعاهم أدبروا %~% وعلى علي بالضغائن أقبلوا(@)36 فعلوا وما أدراك ما فعلوا فسل %~% أخبرك سألت أم لا تسأل(@)PageV01P127 37 فكأنهم لم يسمعوا وكأنهم %~% لم يبصروا وكأنهم لم يعقلوا(@)38 أتراك تذكر ما احل بفاطم %~% مما يخر له السماك ألأعزل(@)39 إن قيل حوا قلت فاطم فخرها %~% أو قيل مريم قلت فاطم أفضل(@)40 افهل لمريم والد كمحمد %~% أم هل لمريم مثل فاطم أشبل(@)41 كل لها حين الولادة حالة %~% منها عقول ذوي البصائر تذهل(@)42 هذي لنخلتها إلتجت فتساقطت %~% رطبا جنيا وهي منه تأكل(@)43 وضعت بعيسى وهي غير مروعة %~% أنى وحارسها السري ألأبسل(@)44 وإلى الجدار وصفحة الباب إلتجت %~% خير النساء فاسقطت ما تحمل(@)45 سقطت وأسقطت الجنين وحولها %~% من كل ذي حسب لئيم جحفل(@)46 هذا يعنفها وذاك يدعها %~% ويسبها هذا وهذا يركل(@)47 وأمامها أسد الأسود يقوده 
ms85	 %~% بالحبل قنفذ هل كهذا معضل(@)48 وبعين رب العرش يلطم خدها %~% أشقى البرية ثم لا يتوجل(@)49 لا تدعي بعد الشهامة هاشم %~% ما للشهامة عند هاشم منزل(@)50 نال إبن حنتم ما يؤمل منهم %~% حسب إبن حنتم نيله ما يأمل(@)51 أو يهجعون وطفل فاطم مسقط %~% أو يبصرون ودمع فاطم مرسل(@)52 وتراهم لا يغضبون لمثلها %~% وهم على غير ألإبا لم يجبلوا(@)53 لكنما العباس لم يعبس لها %~% وعقيل أمسى في عقال يعقل(@)54 واقول ماذا والسياط بمتنها %~% حتى القيامة ما لهن تحول(@)55 ولسوف تأتي في القيامة هكذا %~% تشكو إلى رب السماء وتعول(@)56 ولترفعن جنينها وحنينها %~% بشكاية منها السماء تزلزل(@)57 رباه ميراثي وبعلي حقه %~% غصبوا وابنائي جميعا قتلوا(@)58 فرخاي ذا بالسم أمسى قلبه %~% قطعا وهذا بالدماء مزمل(@)59 لم يبق سيف من سيوف أمية %~% إلا وعاد بلحمه يتأكل(@)60 لم يبق رمح من رماح أمية %~% إلا وعاد بصدره يترسل(@)61 لم يبق سهم من سهام أمية %~% إلا وصار لقلبه يتوصل(@)62 وتقوم بعد صوارخا من حولها %~% فتياتها والكل منهن ثكل(@)63 فتقوم ثم قيامة أخرى لها %~% كل ألأنام عن القيامة تشغل(@)64 ما عذر تيم عندها وعديها %~% وعليهما تلك الجرائم تحمل(@)65 فهناك يعلم من على أثريهما %~% أمسى واصبح في الضلال يهرول(@)PageV01P128 66 إذ ليس تنفعه شفاعة شافع %~% هيهات ليس له هناك معول(@)67 فليعرف ألأشهاد أن ولاهما %~% اجن وبغضهما الرحيق السلسل(@)68 أسراج ليل الوحى شمس نهاره %~% يا كوكب السعد الذي لا يأفل(@)69 زعموا بأنك رابع الخلفاء لا %~% وألله أنت أخيرهم وألأول(@)70 ما من سواك خليفة هيهات %~% أنت خليفة ألله الذي لا يعزل(@)71 خذها أمير المؤمنين قصيدة %~% وافتك في حلل الصبابة ترفل(@)72 إن كنت تقبلها فعبدك محسن %~% أو لا فإني ما تدوس ألأرجل(@)73 لكنما بك يرحم ألله الورى %~% وعليهم بركاته تتنزل(@)74 أنتم أئمتنا ونحن عبيدكم %~% وعليكم فيما ينوب نعول(@)75 أنا لم أزل بك سيدي مستشفعا %~% عند ألإله ولم 
ms86	 أزل أتوسل(@)76 حتى أراك مخلصي من كل ما %~% أخشاه في الدارين يا متفضل(@)77 لا سيما العظمى التي تدري بها %~% مما بها أعيا ثبير ويذبل(@)78 وعليك صلى الله ما لاحت ضحى %~% شمس النهار وجاء ليل أليل(@)(@)(@@)(@@)(@@) ||| ** التعليقات :(@)(@@) هذه ثالث أطول قصيدة في الديوان.(@)(@@) المعلومات مستقاة من مصدرين :(@)(@@) أمجلة التوحيد 72 : 144 السنة الثلثة عشرة ، تاريخ آب 1994 ، تنشرها منظمة ألإعلام ألإسلامي ، معاونية العلاقات الدولية ، طهران.(@)(@@) ب مجلة الكوثر في 23 / 6 / 2000 النجف ألأشرف.(@)(@@) 4 ألأصل : أم هذه ألأنباء ليست غير تقول ، ولكن حذفت (ليست) لظهور معناها إذ أن الشاعر يعجب من هذه ألآراء.(@)(@@) 22 في النسخة الثانية «أن تخذلوا» جاءت «أن تلحدوا».(@)(@@) 25 المعم الكثير ألأعمام والعمومة.(@)(@@) 36 في النسخة الثانية جاءت هكذا :(@)(@@) (فعلوا وما أدراك ما فعلوا فسل %~% أخبرك عنه تسأل أو لاتسأل)(@)(@@) ولكن الصواب هو ما أثبتناه في القصيدة.(@)PageV01P129(@)(@@) 39 40 ليس الشاعر هو الوحيد الذي يفضل الزهراء عليها السلام ، فإن شاعر الهند الكبير أقبال هو ألآخر يقول :(@)(@@) نسب المسيح لمريم سيرة %~% بقيت على طول المدى ذكراها(@)والمجد يشرف في ثلاث طلايع %~% في مهد فاطمة فما أعلاها(@)هي بنت من هي زوج من هي أم من %~% من ذا يداني في الفخار أباها(@)هي ومضة من نور عين المصطفى %~% هادي الشعوب إذا تروم هداها(@)(@@) 67 أجن أي ألآجن وهو الماء الذي تغير لونه وطعمه.(@)(@@) 69 أخيرهم على رأس مدرسة الخلفاء من المسلمين ، أولهم على رأي مدرسة ألإمامة من المسلمين.(@)(@@) 72 يشير الشاعر إلى إسمه وهو محسن.(@)(@)(@@)(@@)(@@) || (58)(@)(@)(@@)(@@)(@@) || كيف الصبر بعدك(@)(@@) من الطويل الثاني :(@)(@)(@@)(@@)(@@) ||| ** أنشأها في رثاء علي ألأكبر بن الحسين عليه السلام :(@)1 فديتك كيف الصبر بعدك يحمل %~% وأنت قتيل ثم مثلك يقتل(@)2 عجبت وما ألأيام إلا عجائب %~% وأولى جميع الناس بالناس يخذل(@)3 ينادي فلم يسمع ويدعو فلم يجب %~% وتلغى وصايا ألله فيه وتهمل(@)4 ألا لعن الجيل الذي بقتاله %~% تولع ما أشقاه لو كان يعقل(@)5 عجبت لقوم قابلوك بعزمعهم %~% وعزمك منه كل طود 
ms87	 يزلزل(@)6 وأسياف قوم قابلتك بعيد ما %~% درت أنك السيف الذي لا يفلل(@)7 أللشمس نور مثل نورك واضح %~% أللبحر كف مثل كفك تسبل(@)8 ذكرت علي بن الحسين وما جرى %~% له في إقتحام الحرب والحرب تشعل(@)9 فأقدم لما أن رأى الموت قائما %~% تقاصر عنه للمناجيد أرجل(@)10 فقال إرتقبني سوف آتيك لابسا %~% من الحزم ثوبا لا يرث ويسمل(@)11 وجاء أباه طالبا منه رخصة %~% غداة رآه مفردا ليس يوصل(@)12 وعاينه مستعبرا منه آيسا %~% يقول بعين ألله ما نتحمل(@)PageV01P130 13 أترضى إلهي عن معاشر أجمعوا %~% على قطع رحمي ثم قتلي حللوا(@)14 فكن شاهدي أني بعثت إليهم %~% شبيه رسول ألله من ليس يجهل(@)15 شبيه رسول الله ربي بعثته %~% فكن شاهدي يا من عليه أعول(@)16 وقابل حزب الغي مرتجزا إلا %~% أنا إبن رسول الله من لست أجهل(@)17 ساحمي أبي حتى أجدل بعدما %~% يرعبكم مني الضراب المرعبل(@)18 ولا ضير إنا للرماح موارد %~% ولا غرو أنا للمباتير مأكل(@)19 ما ضرنا إنا نموت وفخرنا %~% مدى الدهر لا يفنى ولا يتحول(@)20 شرى ألله منا أنفسا لا نبيعها %~% على غيره كلا ولا نتبدل(@)21 ولا تحسبوا إنا نراع برائع %~% وما هو منا من عن الموت ينكل(@)22 وما الموت إلا للكرام كرامة %~% إذا ما نبا فيهم عن العز منزل(@)23 أصاغرنا في المكرمات أكابر %~% وآخرنا في كسبه الحمد أول(@)24 أبى ألله إلا مجدنا الدهر خالد %~% ومجد أعادينا يبيد ويخمل(@)25 وعاد وقد اودى بمهجته الظما %~% أقيه بنفسي وهو بالدرع مثقل(@)26 ونادى أباه هل من الماء شربة %~% بها كبدي مما بها يتعلل(@)27 فقال بني إصبر فإنك وارد %~% وما الصعب إلا ساعة ثم يسهل(@)28 ستشرب كأسا من علي روية %~% تعل بها حتى القيام وتنهل(@)29 وعز علي أن أراك ولا أرى %~% لك اليوم غوثا ويلتا كيف أفعل(@)30 وما هي إلا غمة ثم تنجلي %~% وما بعدها إلا النعيم المعجل(@)31 فكر وكر الموت يعدو أمامه %~% على 
ms88	 عجل والموت إذ ذاك يعجل(@)32 وناهيك قرم عمه وأبوه من %~% علمت فقلت في أمره كيف يعمل(@)33 وما هو إلا أن رماه إبن مرة %~% فخر وما عن منهل الموت معدل(@)34 بنفسي أقيه حين يدعو وجسمه %~% به كل مشحوذ الشبا يتأكل(@)35 سقاني أبي جدي بكأس روية %~% وهالك أخرى مثلها تتسلسل(@)36 فعجل لتسقاها كما قد سقيتها %~% ومالك لا تعجل وها أنت معجل(@)37 ووافاه ولم يعبأ بكل عظيمة %~% عرته وحتى لو تزلزل يذبل(@)38 بني على الدنيا العفاء وويل من %~% عليك إجترى ويل أمه ما يأمل(@)39 ولا تنس بنت الوحي زينب إذ هوت %~% تعانقه طورا وطورا تقبل(@)40 ولا تنس دعوى السبط فتيانه إحملوا %~% أخاكم وما حملتموه تحملوا(@)41 فنحن أناس يملك ألله أمرنا %~% فيحكم فينا ما يريد ويفعل(@)PageV01P131 42 ألا أن حربا أخمدتها سيوفكم %~% بفيض دماكم أصبحت تتشعل(@)43 كأن لها زيتا دماء نحوركم %~% وأشلاؤكم جزل به تتأكل(@)44 فما بعد هذا اليوم خطب يريعكم %~% فشأنكم والصبر فالصبر أجمل(@)45 سنلقى جميعا جدنا خير مرسل %~% فيحنو علينا عاطف ويظلل(@)46 فنشكوا إليه ما جرى من معاشر %~% على قتله من قبل ذاك تحملوا(@)47 ولا تحسبني بعد قتلك لابثا %~% بني وأني حيث ترحل أرحل(@)48 وما كنت أدري أن للخيل أرجلا %~% إلى فلك ألأفلاك تعلو وتسفل(@)49 تدوس جسوما زين ألله عرشه %~% بها وبها أهل السما تتوسل(@)50 فما تركوا منا رضيعا ويافعا %~% ولا تركوا منا كبيرا يبجل(@)51 لعز على أشراف قومي موقفي %~% وحولي مما حارب ألله جحفل(@)52 أدافعهم كي لا يبوؤا بمقتلي %~% فلم يعبأوا والناس للكفر أميل(@)35 ألا من رأى تحت الصفاح فوارسا %~% وجوههم من بشرها تتهلل(@)54 كأن القنا راح بها متشبب %~% بطوف من الولدان أو متغزل(@)55 فخروا بها سكرى تخال جسومهم %~% على ألأرض مما شاقها تتململ(@)56 وباتوا وبات الوحي يبكي عليهم %~% وأضحوا واضحى الدين عنهم يسأل(@)57 فجاوبه عنهم محامل ملؤها %~% مقاصير طه جدها فهي تشكل(@)58 فمن مبلغ 
ms89	 الزهراء إن حشاشتي %~% لما نيل من ابنائها تتقلقل(@)59 بنفسي قروما من غرانيق ولدها %~% دماؤهم مثل الحيا تتسلسل(@)60 على غير شيء غير أنهم أبوا %~% على الضيم يوما أن يحلوا وينزلوا(@)61 كذاك بنو العلياء أهون هين %~% عليهم إذا سيموا ألأذى أن يقتلوا(@)(@)(@@)(@@)(@@) ||| ** التعليقات :(@)(@@) 51 في نسخة وحولي ممن (الناشر).(@)(@)(@@)(@@)(@@) || (59)(@)(@)(@@)(@@)(@@) || إبن هند وحزبه(@)(@@) من الطويل الثاني :(@)(@)(@@)(@@)(@@) ||| ** قالها في هجاء يزيد بن معاوية لقتله سبط الرسول وأهل بيته عليهم السلام :(@)1 أميم ذريني والبكاء فإنني %~% عن العيد واللبس الجديد بمعزل(@)PageV01P132 2 أميم أقلي من ملامك وأتركي %~% مقالة لا تهلك أسى وتجمل(@)3 لئن سرك العيد الذي فيه زينة %~% لبعض أناس من ثياب وحلي(@)4 فقد عاد لي العيد الحداد بعوده %~% ألا فإعذريني يا أميم أو إعذلي(@)5 يذكرني فعل إبن هند وحزبه %~% يزيد وقد أنسى الورى فعل هرقل(@)6 لكم قد أطلوا من دم بمحرم %~% وكم حللوا ما لم يكن بمحلل(@)7 ولم يقنعوا حتى أصابوا إبن فاطم %~% بسهم أصاب الدين فإنقض من عل(@)8 وخر على وجه الثرى متبتلا %~% إلى ربه أفديه من متبتل(@)9 ومذ كان للإيجاد في الكون علة %~% بكته البرايا آخرا بعد أول(@)10 وخضبت السبع السموات وجهها %~% بقاني دم من نحره المتسلسل(@)11 وذا العالم العلوي زلزل إذ قضى %~% كما العالم السفلي أي تزلزل(@)12 بنفسي وبي ملقى ثلاثا على الثرى %~% تهب عليه من جنوب وشمأل(@)13 أبى رأسه إلا العلا فسما على %~% ذرى ذابل يسمو على هام يذبل(@)14 بنفسي أباة الضيم من آل هاشم %~% تؤم الوغى ما بين لدن وفيصل(@)15 أداروا على قطب الفناء رحى القضا %~% فخاضوا المنايا أشبلا بعد أشبل(@)16 فبين طريح في الصعيد مجدل %~% وبين ذبيح بالدماء مرمل(@)17 ونادبة تدعو أبا الفضل تارة %~% وأخرى حسينا ندب ولهاء معول(@)18 أخي يا حسين كنت غوثا وعصمة %~% كما كنت غيثا ثر في كل ممحل(@)19 اخي كنت للرواد أخصب مرتع %~% كما كنت للوراد أعذب منهل(@)20 خليلي بيت الوحي شط حبيبه 
ms90	 %~% قفا نبكي من ذكرى حبيب ومنزل(@)21 وما قد جرى في كربلاء قضية %~% وليس لها إلا أبو حسن علي(@)(@)(@@)(@@)(@@) ||| ** التعليقات :(@)(@@) أأن تاثير ومحاكاة بعض مقاطع قصيدة إمرؤ القيس واضحة على القصيدة (قفا نبكي من ذكرى حبيب ومنزل).(@)(@@) ب في كتابه أدب الطف أو شعراء الحسين عليه السلام ذكر السيد جواد شبر في الجزء السابع ، الصفحة 34 35 أن هذه القصيدة للسيد حيدر العطار ، جد ألأسرة الحيدرية في الكاظمية والمتوفى عام 1265. كما أنها لم تكن موجودة في النسخة ألأم التي فقدناها. تظهر أول مرة في النسخة الثانية بقلم مرزا صادق واعظ.(@)(@@) 15 في السخة الثانية العجز هو : فخاضوا المنايا أمثلا بعد أمثل.(@)PageV01P133(@)(@@)(@@)(@@) || (60)(@)(@)(@@)(@@)(@@) || يوم محرم(@)(@@) من الكامل الثاني :(@)(@)(@@)(@@)(@@) ||| ** أنشأها في رثاء من إستشهد على أرض الطف :(@)1 إني خشيت بواثق العذال %~% فكتمت عنهم في المحبة حالي(@)2 وأبيك ما إطلعوا علي وإنما %~% جنت دموع العين بألإهمال(@)3 فهنالكم علموا بأني عاشق %~% والعشق تعلم عرضة العذال(@)4 هب أنهم عذلوا وإني سامع %~% هذيان جهلهم فهل أنا سال(@)5 هيهات أن هوى تعرض مهجتي %~% لهوى علي وأن اضر غالي(@)6 أهوى العذيب لأجل من نزلوا به %~% والنازلين به لأجل غزال(@)7 أسر القلوب وقل ما يحنو لها %~% وسبا محبيه بنقطة خال(@)8 بدر ولكن لا يلوح لناظر %~% ظبي ولكن لم يقع بحبال(@)9 منه إليه شكايتي لو انه %~% ممن يرق إذا شكوت لحالي(@)10 لو شئت فزت به ولكني أرى %~% ذلي بذاك الفوز غير حلال(@)11 تأبى الغواني الغيد إلا عاشقا %~% يبدي الخضوع لهن غير مبال(@)12 والحر يأبى أن يرى في عيشه %~% ذلا وإن هو كالحنية بال(@)13 ما الغيد إلا كالسراب وويل من %~% كان السراب به من ألإمثال(@)14 خاب إمرئ طلب الوفا منها كما %~% قد خاب طالبه من ألأنذال(@)15 ما في الرجال من الوفاء بقية %~% حتى يؤمل من ذوات حجال(@)16 الناقصات عقولها وحظوظها %~% والقاعدات بكل يوم نزال(@)17 ولقد أقول لصاحبي لما بدا %~% صبح هدايتي وغاب ليل ضلالي(@)18 
ms91	 دع عنك ذكر الغانيات وما جرى %~% للعاشقين بحبها وجرى لي(@)19 وهلم أسمعني الذي أنجو به %~% من سوء أعمالي وقبح فعالي(@)20 إذ لا نجاة بغير آل محمد %~% من كل ما يخشى من ألأهوال(@)21 ما أن نفسي وألأسى متنفر %~% عنها بعار الصعبة الشملال(@)22 أن تضح يضحى الحزن أكبر همها %~% أو تمس تمسي كثيرة ألإعوال(@)23 لم يبق فيها ذكر يوم محرم %~% للبشر ربعا غير ذي إضمحلال(@)PageV01P134 24 لا مرحبا بك يا محرم طالما %~% أغريت دمع المجد بألإسبال(@)25 وتدعي حراما ثم أنت محلل %~% حرمات آل الله للأنذال(@)26 هلا حلالا كنت تعرف قبلها %~% لنرى حلالك بعد غير حلال(@)27 وأرى الفرات أصاب مثلك خزية %~% جرت عليه عقائم ألأقوال(@)28 نكلتما من حائرين كليكما %~% قابلتما طه بكل نكال(@)29 جرعتما أبناءه جرع الردى %~% عوض الفرات البارد السلسال(@)30 هند تفوز بثارها من أحمد %~% وتفوز فاطم بالصراخ العالي(@)31 تبكي بنيها حين لم تر منهم %~% إلا قتيلا أو نحيفا بالي(@)32 تبكي الحسين بعبرة أنست بها %~% طوفان نوح سيلة المتعالي(@)33 تبكي العليل وما به من علة %~% أنسته ثقل سلاسل ألأغلال(@)34 تبكي النساء وما أضر بحالها %~% من سلب أثواب ونهب رحال(@)35 أو ينعش الرحمن هاشم بعدها %~% ما لم تجئ بصواعق الزلزال(@)36 ويقيم يوم مثارها بسحائب %~% حمر تعوض وابلا بوبال(@)37 حتى تعود بها ديار أمية %~% مملوءة خسفا وهن خوالي(@)38 ماذا الذي أغراك حرب بهاشم %~% أغراك مغري الكلب بالرئبال(@)40 ولكنت أهون من طنين ذبابة %~% طنت بجانب ذي هضاب عالي(@)41 لكنها لما رأت أن هكذا %~% الدنيا يغيب بها الرخيص الغالي(@)42 خلعت ثياب حياتها وتجلببت %~% أكفانها هربا من ألأذلال(@)43 بأبي ونفسي عصبة علوية %~% ركبت ظهور العز غير هزال(@)44 حتى مضوا صرعى فتلك جسومهم %~% شهب وأرؤسهم بدور كمال(@)45 أحماة بيت ألله ما لبيوتكم %~% عاثت بهن عوائب ألأوغال(@)46 قامت نوائحها تعج بعولة %~% كادت تذيب جوامد ألأجبال(@)47 لم تبك عين المزن إلا رحمة %~% لبكائها 
ms92	 بالمدمع الهطال(@)48 تبكي وحق لها البكاء لأنها %~% فقدت رجال وفى وأي رجال(@)49 قوموا لها قبل إنتشار ظعونها %~% في البيد فوق مصاعب ألأحمال(@)50 وإنضوا صوارم يوم بدر دونها %~% وأسقوا أواخرها بكأس أوال(@)51 هذي رحاب البيد غص فضاءها %~% بحنينها وتضور ألأطفال(@)52 يا ويح نفسي حين لم أك باذلا %~% نفسي أمامهم وأنفس مالي(@)PageV01P135 53 وأكون أول من دعي فأجابهم %~% لقتال من ناواهم بقتال(@)54 وأصول صولة مستميت دونهم %~% حتى تقطع فيهم أوصالي(@)55 فهنالكم أديت بعض حقوقهم %~% وهنالكم أدركت خير منال(@)56 ما حاجتي في هذه الدنيا وقد %~% أذنت ثوابت عزها بزوال(@)57 لولا إنتظاري يوم ثأرهم الذي %~% فيه بلوغ مطالب ألآمال(@)58 يارب إن قصرت يميني دون ما %~% حاولت من نصرهم وشمالي(@)59 فاجعل نصيبي بعدما أنا خائف %~% أن لا يفوز بمثلها أمثالي(@)60 مع ثائر لهم يثور بعصبة %~% تلهو ألأسود بها عن ألأشبال(@)61 حرى القلوب لثأر قتلى لم تنخ %~% فيها إلى أمد الزمان وصالي(@)62 حتى تعود بها إليه جواريا %~% بدم الضلال وحزبه الضلال(@)(@)(@@)(@@)(@@) ||| ** التعليقات :(@)(@@) 6 بيت جميل وأنه لأجمل يضاهي قول مجنون ليلى : (أمر على الديار ديار ليلى ...).(@)(@@) 35 في نسخة : تدعى.(@)(@@) 36 في نسخة : ونعيم يوم مثارها بسحائب حر (الناشر).(@)(@@) 38 الرئبال : كقرطاس ألأسد والذئب.(@)(@@) 45 ألأوغال : ألأنذال جمع وغل.(@)(@@) 58 الشملال : الصعبة الشملال : الفاقة السريعة.(@)(@@) 61 وصالي : القطرات والمراد هنا قطرات الدموع.(@)(@@) وفي نسخة :(@)(@@) حرى القلوب لثار قتلى لم تنح %~% فيها إلى أمد الزمان مصالي(@)(@@) (الناشر)(@)PageV01P136(@)(@@)(@@)(@@) || (61)(@)(@)(@@)(@@)(@@) || خزينا من النظار(@)(@@) من الطويل الثاني :(@)(@)(@@)(@@)(@@) ||| ** قالها عن سبي آل الحسين عليهم السلام :(@)1 وأعظم شيء إن ربة خدرها %~% تمد إلى أعدائها كف سائل(@)2 تقول لشمر والرؤوس أمامها %~% وقد احدقت بالسبي أهل المنازل(@)3 فلو شئت تأخير الرؤوس عن النسا %~% وإخراجها من بين تلك المحامل(@)4 ليشتغل النظار عنا فإننا %~% خزينا من النظار بين القبائل(@)(@)(@@)(@@)(@@) ||| ** التعليقات :(@)(@@) هذه القصيدة أو جزء من قصيدة ليست موجودة في الديوان وقد أخذتها من أدب الطف أو شعراء الحسين 1397 
ms93	 ه الموافق 1977 م للسيد جواد شبر ، 8 : 56 وقد جاء في المصدر أيضا ما يلي :(@)(@@) وقال في قصيدة مضمنا للرواية التي تقول أن سبايا الحسين عليه السلام لما قاربوا دخول الشام دنت أم كلثوم بنت علي عليه السلام من شمر بن ذي جوشن وقالت : يابن ذي جوشن لي إليك حاجة.(@)(@@) قال ما حاجتك : قالت إذا دخلت بنا البلد فإحملنا في طريق قليل نظاره ، وتقدم إلى حاملي الرؤوس إن يخرجوها من بين المحامل فقد خزينا من كثرة النظر إلينا فأمر بعكس سؤالها بأن تحمل الرؤوس في أوساط المحامل ويسلكهم بين النظارة ، وكذا فعل ألأدنياء.(@)(@)(@@)(@@)(@@) || (62)(@)(@)(@@)(@@)(@@) || خير العرس(@)(@@) من السريع ألأول :(@)(@)(@@)(@@)(@@) ||| ** من قصيدة قالها في زفاف السيد أحمد نجل السيد كاظم الرشتي عام 1279 ه :(@)1 أما ترى القمري في سجعه %~% أجج نيران الهوى والغرام(@)PageV01P137 2 وعندليب اليمن في لحنه %~% أنعش نفسي بل وأحيا الرمام(@)3 ولخير عرس يومه مقمر %~% فلا ظلام بعد هذا يشام(@)4 وساعة رب الورى شاء أن %~% تقترن الشمس ببدر التمام(@)(@)(@@)(@@)(@@) ||| ** التعليقات :(@)(@@) المصدر أو التخريج : تراث كربلاء ، سلمان هادي آل طعمة ، ط 1.(@)(@)(@@)(@@)(@@) || (63)(@)(@)(@@)(@@)(@@) || ردوا ألأمانات(@)(@@) من السريع الثاني :(@)(@)(@@)(@@)(@@) ||| ** تهنئة السادن العباسي بالسدانة :(@)يا آخذي المفتاح من شبلها %~% ردوا ألأمانات إلى أهلها(@)(@)(@@)(@@)(@@) ||| ** التعليقات :(@)(@@) أول بيت في قصيدة قالها الشيخ مهنئا السيد مرتضى سادن الروضة العباسية بعدما أعيدت له السدانة عام 1298 ه.(@)(@@) بيت الشعر والمعلومات من العم المرحوم الشيخ عباس أبو الحب.(@)(@)(@@)(@@)(@@) || (64)(@)(@)(@@)(@@)(@@) || طيف زارني(@)(@@) من الوافر ألأول :(@)(@)(@@)(@@)(@@) ||| ** يستنهض ألإمام المهدي عليه السلام ويذكره بمصائب جده الحسين عليه السلام وأنصاره :(@)1 أتحكي النار مهجتي إضطراما %~% أم ألأنوار مقلتي إنسجاما(@)2 أم الورقاء صادحة سحيرا %~% يشابه قلبها قلبي هياما(@)3 هداك ألله قلبا مستهاما %~% يجدد كل يوم لي غراما(@)4 يشوق وكلما سنحت مهاة %~% فيمنع شوقه عني المناما(@)PageV01P138 5 وطيف زارني وهنا فلما %~% إنتبهت له إستقل وما أقاما(@)6 وذكرني الخيام وحي سلمى %~% ولا حيا رأيت ولا خياما(@)7 أجبنا يا هوى داعيك لما %~% دعا وإقتاد أصعبنا زماما(@)8 رويدك بالقلوب فما 
ms94	 نراها %~% تطيق بما تحملها قياما(@)9 أراني كلما زادت همومي %~% بحرب الدهر زادتني إهتماما(@)10 يكلفني بصحبة كل وغد %~% ويمنع صحبتي القرم الهماما(@)11 رجال كنت أحسبها ليوثا %~% أراني اليوم اسرحها نعاما(@)12 صحبتهم وكلهم طغام %~% فعذرا أن يرى صحبي طغاما(@)13 إذا نطقوا حسبتهم بهاما %~% وإن صمتوا حسبتهم رخاما(@)14 أو إنتسبوا فأعلاهم محلا %~% أشدهم على الظلم إقتحاما(@)15 أحن إلى الكرام ولا أراهم %~% كأن ألله لم يخلق كراما(@)16 بلى خلقوا ولكن غادرتهم %~% يد ألأيام أشلاء رماما(@)17 متى يا أيها المحجوب عنا %~% تزيل بضوء طلعتك الظلاما(@)18 أغثنا بالذي سواك شرعا %~% فقد بلغ العدو بنا المراما(@)19 أما وأبيك لا يرضى وترضى %~% إذا ما قمت منتضيا حساما(@)20 طغت حتى الكلاب الجرب لما %~% أطلت فداك أنفسنا المقاما(@)21 لقد شابت نواصينا إنتظارا %~% ولم نشدد لنصركم جزاما(@)22 بنفسي غائبا عن كل عين %~% تمنى أن تراك ولو مناما(@)23 ليهدي ألله عميانا ويعمي %~% بها من كل بعد هدى تعامى(@)24 ولم يعهد سواك أبي ضيم %~% فما لك بت موتورا مضاما(@)25 صبرت وأنت أقدر من عليها %~% إذا رمت إنتظارا وإنتقاما(@)26 على نوب تكاد ألأرض منها %~% تسيخ وتسقط السبع إنهداما(@)27 هوت أفلاكها وأبيك لو لم %~% تكن يابن الكرام لها قواما(@)28 حرام لذة الدنيا علينا %~% كأن ألله كونها حراما(@)29 وحاشا بل لأنكم حرمتم %~% جناها فإجتنبناها إحتراما(@)30 رزيتم بالحسين وأين مثل %~% الحسين إذا عقاب الفخر حاما(@)31 فلا وألله لا أنسى رجالا %~% لكم في الطف جرعت الحماما(@)32 نجوم كلهم كملت بدورا %~% فما منها ترى إلا تماما(@)33 وما زادوا على السبعين لكن %~% ترى كلا بمركزه لهاما(@)PageV01P139 34 وفوا لله فيما عاهدوه %~% فوفاهم أجورهم تماما(@)35 ولا وألله لا أنسى رضيعا %~% لكم في الطف تعفوها اليتاما(@)36 فهذي غير واجدة خمارا %~% وهذي غير واجدة لثاما(@)37 كل تشتكي وجدا ولكن %~% سياط القوم تمنعها الكلاما(@)38 كفاها سب والدها إحتراقا %~% وقد بلغ المسير بها الشئاما(@)39 عدا 
ms95	 ما عاينت يوم إستقلت %~% بها ألأنضاء إخوتها نياما(@)40 عدا ما كان من خيل ألأعادي %~% تهشم من أحبتها عظاما(@)41 عدا ما كان من سلب ألأعادي %~% ملابسها وادمعها تهاما(@)42 عدا ما كان من قرع بن هند %~% ثنايا من به الدين إستقاما(@)43 كذا بلغت بكم أرجاس حرب %~% ولم تهلك جموعهم إصطلاما(@)44 سعى فيها الذين بقتل طه %~% سعوا حتى أذاقوه الحماما(@)45 وراعوا بنته حتى سقوها %~% برغم الوحي من غدر سهاما(@)46 وآلوا أن يبقوا من بنيه %~% على الغبراء كهلا أو غلاما(@)47 إلى أن لم يكن يبقى عليها %~% سواك اليوم فإملأها صداما(@)48 أعدها مثل مبدئها لتحيي %~% بها من ثأرك الميت الرماما(@)49 إلى أن ينجلي بك مستنيرا %~% عمود الحق يبتسم إبتساما(@)50 هناك أقول يا نفس إستقري %~% بعيشك وإكرعي للبشر جاما(@)51 أنا العبد الذي طوقتموه %~% من ألإحسان أطواقا جساما(@)52 أسمى محسنا بكم وإني %~% لشر الناس للذنب إجتراما(@)53 فخذ بيدي فقد ثقلت ذنوبي %~% علي فلم أطق منها القياما(@)54 وكن لي ملجأ من كل خطب %~% وكن لي من يد البلوى عصاما(@)55 وكن بي راضيا في الحشر عبدا %~% فإني قد رضيتك لي إماما(@)56 وبلغك المهيمن كل يوم %~% صلاتي والتحية والسلاما(@)(@)(@@)(@@)(@@) ||| ** التعليقات :(@)(@@) 50 الجام : إناء من فضة.(@)PageV01P140(@)(@@)(@@)(@@) || (65)(@)(@)(@@)(@@)(@@) || التعفف(@)(@@) من الكامل ألأول :(@)(@)(@@)(@@)(@@) ||| ** قال متغزلا :(@)1 لا تحسبوا إني كففت تعففا %~% نظري إليها أو مخافة لائم(@)2 لكنني عاينت أسهم لحظها %~% تترى فخفت على حشاي الهائم(@)(@)(@@)(@@)(@@) || (66)(@)(@)(@@)(@@)(@@) || لا انسى رضيع الطف(@)(@@) من الوافر ألأول :(@)(@)(@@)(@@)(@@) ||| ** قالها في رثاء من قتل في معركة الكرامة بكربلاء :(@)1 إلي إلي خالعة الزمام %~% كلانا في الهوى صعب المرام(@)2 نفرت وما عليك بذاك بأس %~% نفاري من أعاجيب ألأنام(@)3 وجانبت الموارد والمراعي %~% كما جانبت أفنية اللئام(@)4 فرارا من بني الدنيا فإني %~% رايتهم أضل من النعام(@)5 وكم جربتهم آنا فآنا %~% فكانوا كالسراب لذي أوام(@)6 سآنس بالوحوش بكل قفر %~% وأهجر كل سامية الدعام(@)7 وأطلب في ديار العز مثوى %~% وإلا لا أرى 
ms96	 سفر اللئام(@)8 رأيت العز أهون كل شيء %~% طلابا إن شددت له حزامي(@)9 أبن يا دهر عذرك لي فإني %~% رأيتك غير بر بالكرام(@)10 كغدرك في بني الهادي علي %~% غياث الناس في ألأزم العظام(@)11 رميتهم بسهم الغدر بغيا %~% كرمي الصيد في البلد الحرام(@)12 فبعض بالسجون قضى وبعض %~% بحد السيف دام إثر دام(@)13 فؤادي كل يوم في إلتهاب %~% ودمعي كل يوم في إنسجام(@)14 عليهم لا على طلل محيل %~% أصاب بأهله داعي الحمام(@)15 سأبكيهم وإن لم تسعديني %~% بثينة في البكا خلي ملامي(@)16 إذا ذكر الحسين فأي عين %~% تصون دموعها صون إحتشام(@)PageV01P141 17 بكته ألأنبياء وغير بدع %~% بأن تبكي الكرام على الكرام(@)18 دعا فأجابه نفر يسير %~% قليلهم كثير في الزحام(@)19 أولئك صفوة الجبار حقا %~% بهم سمت العلا أعلى مقام(@)20 ضحى في ملتقى الهيجاء أسد %~% وليلا هم مصابيح الظلام(@)21 سقوا الموت الزؤام وليت نفسي %~% فداؤهم من الموت الزؤام(@)22 وأعجب ما أراه بنو زياد %~% ولاة ألأمر من دون ألأنام(@)23 وآل محمد تهمي عليهم %~% رزايا الدهر هاما بعد هام(@)24 وثوبا يا ضباع إلى إفتراس %~% ونوما يا سباع على إغترام(@)25 رؤوس بني النبي معليات %~% على ألأرماح تهدى للشآم(@)26 وظام لم يذق للماء بردا %~% ومن كفيه ماء البحر طامي(@)27 وطفل بالسهام له فطام %~% وكيف فطام طفل بالسهام(@)28 لقد عجبت له ألأملاك حتى %~% خدود الحور تدمى باللطام(@)29 لذا موسى هوى صعقا وعاف %~% إبن مريم نطقه بعد الكلام(@)30 ولم ير باسما يحيى إلى ان %~% سقاه الحزن أكواب الحمام(@)31 فهل وجدت كزينب أم موسى %~% وهل باتت كزينب في إهتضام(@)32 عشية بات منزلها خليا %~% ولم تر من كفيل أو محام(@)33 تناديهم وهم صرعى دوامي %~% وتدعوهم وهم فوق الرغام(@)34 بني أمي لقد طال إنتظاري %~% قيامكم لنصري وإحترامي(@)35 بني أمي متى كنتم بعادا %~% عن الشاكي المروع المستضام(@)36 بني أمي أنا المنهوب رحلي %~% خلافكم أنا الواهي قوامي(@)37 بني 
ms97	 أمي أنا المنهوك جسمي %~% خلافكم أنا البادي سقامي(@)38 بني أمي لقد سلبوا قناعي %~% بني أمي لقد حرقوا خيامي(@)39 بني أمي متى كنتم ضعافا %~% لبيض مقارع وسهام رامي(@)40 أراكم عازمين على فراقي %~% كأن لم تعرفوا فيكم مقامي(@)41 لي الخدر الذي حجبتموه %~% ببيض الهند وألأسل الدوامي(@)42 لي البيت الذي شيدتموه %~% على العيوق مرفوع الدعام(@)43 فمالي والسياط لها صرير %~% بمتني غير مخفور ذمامي(@)44 فلا وألله لايشفي غليلي %~% سوى قرع الحسام على الحسام(@)45 بيوم تزعق ألأملاك فيه %~% ألا ظهر الكريم إبن الكرام(@)PageV01P142 46 طلوب الثأر ليس لها ولي %~% سواك فقم بسيف ألإنتقام(@)47 على الدنيا العفاء إذا تشفت %~% بكم أكباد أبناء الطغام(@)48 عساك تعيد روض الدين غضا %~% بغيث من ندى كفيك هامي(@)49 نجاتي منك أطلبها فجد لي %~% بها يا من به أمسى إعتصامي(@)50 سلامي يا بني الهادي عليكم %~% عليكم يا بني الهادي سلامي(@)(@)(@@)(@@)(@@) ||| ** التعليقات :(@)(@@) 2 في نسخة : نفادى (الناشر).(@)(@@) 24 إغترام : الغرامة / أوجب على نفسه.(@)(@@) 26 طامي : البحر المملوء.(@)(@@) في نسخة : لذاك (الناشر).(@)(@@) 33 الرغام : التراب.(@)(@@) 42 العيوق : نجم أحمر مضيء في طرف المجرة ألأيمن يتلو الثريا.(@)(@@) 47 الطغام : أوغاد الناس الواحد فيه والجمع سواء.(@)(@)(@@)(@@)(@@) || (67)(@)(@)(@@)(@@)(@@) || سيف الشرك يعبث(@)(@@) من الكامل الثاني :(@)(@)(@@)(@@)(@@) ||| ** قالها في ألأحداث التي ألمت بألأمة بعد وفاة الرسول صلى الله عليه وآله وسلم وآله وينتهي بأحداث عام 61 ه :(@)1 لو كنت صاحب لوعتي وغرامي %~% لعلمت كيف بذكرهن هيامي(@)2 ما مر ذكر زمانهن بصارخ %~% ألا أبحت حشاي للأسقام(@)3 زمن لو أن الدهر جدده لنا %~% صحت برغم عواذلي أحلامي(@)4 ومروع باللوم قلبي لو درى %~% ما بي من ألأشواق كف ملامي(@)5 ما زال يلقاني بقبح كلامه %~% زجرا وألقاه بلين كلامي(@)6 أنا كنت أدري مذ ألفت هواهم %~% أن سوف يكثر فيهم لوامي(@)PageV01P143 7 لكنني وأبيك لست بسامع %~% طاشت إذا دون المرام سهامي(@)8 وألله لم أر بعد يوم فراقهم %~% يوما له أجفو لذيذ منامي(@)9 إلا إذا ذكر المحرم 
ms98	 قال لي %~% قلبي إتخذ للحزن دار مقام(@)10 حقا على أهل الوفا أن يسأموا %~% طيب الكرى ولذيذ كل طعام(@)11 حزنا لما نال النبي محمدا %~% من مفردات مصائب وتؤام(@)12 أما عزيزته البتول فلم تزل %~% حلف الضنا وفضاضة ألآلام(@)13 قاست مصائب لو تقاسي بعضها %~% شم الجبال لسخن بعد قوام(@)14 في كل يوم تستجد مآتما %~% عظمت مواقفها على ألإسلام(@)15 أسفي لعترتها ألأطايب أصبحوا %~% نهبا لكل مثقف وحسام(@)16 متباعدون عن الديار كأنهم %~% سرب يوكله الردى بهيام(@)17 ما زال سيف الشرك يعبث فيهم %~% ويبعدهم من مقصد ومقام(@)18 حتى قضت وطرا أمية فيهم %~% ومضت فقام لها بنو ألأعمام(@)19 يتسابقون على إنتهاب تراثهم %~% سبق الجياد الضمر للإقدام(@)20 أما أمية لم تهج أضغانها %~% إلا تراث الشرك وألأصنام(@)21 فعلام هاجت للسما أضغانها %~% وهم ذوو ألأنساب وألأرحام(@)22 هذا وما إرتكبت أمية قبلهم %~% معشار ما إرتكبوا من ألآثام(@)23 لو كان حقا قربهم من هاشم %~% ما ضيعوا لبنيه عهد ذمام(@)24 لم يتركوا لبني النبي حشاشة %~% ألا أشبوا برها بضرام(@)25 في كل سجن للنبي لديهم %~% ثاو وفي قفراء آخر دام(@)26 ولقد عجبت وكيف لم أعجب وقد %~% أضحى الرشاد مضيع ألأحكام(@)27 وخلافة ألله التي لم ينخفض %~% لسوى بني الهادي ذراها السامي(@)28 كانت أعز من الثريا منعة %~% واليوم صارت موطئ ألأقدام(@)29 يدعى الرشيد بها إماما حكمه %~% ماض وخير الخلق غير إمام(@)30 من ناشد عني بني العباس لا %~% جفت برقم هجائهم أقلامي(@)31 أنى إدعوها ملكهم واراهم %~% لم يسعدوا فيها بشد حزام(@)32 أيام باع الشرك أرسل كفه %~% وإقتاد شامسها بغير زمام(@)33 أسوى علي كان يوضح للورى %~% ما كان منها طامس ألأعلام(@)34 حتى إنجلت كالصبح أسفر بعدما %~% غشى الظلام سفوره بظلام(@)35 من ذا يقابل ذا بمن إسلامه %~% ما كان لولا خيفة الصمصام(@)PageV01P144 36 لا تفرحوا ياقوم إن أيامكم %~% طالت بطول مسرة ودوام(@)37 فكأن قد إنقلبت بكم وكأنكم %~% لم تظفروا منها بنيل مرام 
ms99	(@)38 إن الذين ولعتم في ظلمهم %~% لهم معادن كل فضل نام(@)39 وهم الذين بوصف بعض علاهم %~% ضلت تحير خواطر ألأوهام(@)40 لو أنهم راموا تملك جيد ما %~% رمتم لكان لهم أذل مرام(@)41 لكنهم نظروا عليها ذلة %~% ألأدنى فعافوها إجتناب الذامي(@)42 فلذاك أصبح عارها ينمى لكم %~% باق مدى ألأيام وألأعوام(@)43 قد كان في يوم الغدير كفاية %~% في هولهم عن سائر ألأيام(@)44 يوم به الجبار أكمل دينه %~% وأتمه في أحسن ألإتمام(@)45 عقد النبي به ولاءهم على %~% من كان في ألأصلاب وألأرحام(@)46 فتعاقدوا أهل الغوى أن ينكثوا %~% ما كان أبرم غاية ألإبرام(@)47 وعدوا عليهم يخضمون تراثهم %~% خضم السوائم نبتة الرمرام(@)48 إني لأقسم بالنبي وآله %~% قسما على رب السما العلام(@)49 أن لا يغيرني على ما في من %~% حب النبي وآله ألأعلام(@)50 يا رب كن أنت الشهيد علي %~% أني عبدهم وإسمع بها أقسامي(@)(@)(@@)(@@)(@@) ||| ** التعليقات :(@)(@@) 11 تؤام : توائم.(@)(@@) 12 في نسخة : ومصاحة (الناشر).(@)(@@) 16 هيام : بالضم العطش الشديد والجنون من العشق.(@)(@@) 18 بنو ألأعمام : بنو العباس.(@)(@@) 19 في نسخة : في ألإقدام (الناشر).(@)(@@) 31 بشد حزام : لم يحاربوا من أجل ألإسلام أيام الرسول صلى الله عليه وآله وسلم وآله.(@)(@@) 32 شامسها : الشامس والشموس الفرس الذي يمنع ظهره ويصعب مقاده.(@)(@@) 35 بمن إسلامه خيفة الصمصام : هو العباس جد بني العباس.(@)(@@) 41 الذام : إسم فاعل من ذم فهو ذام.(@)PageV01P145(@)(@@) 45 من كان في ألأصلاب وألأرحام : أي على ألأجيال القادمة أيضا.(@)(@@) 47 يخضمون : يقضمون.(@)(@@) 47 الرمرام : حشيش الربيع.(@)(@)(@@)(@@)(@@) || (68)(@)(@)(@@)(@@)(@@) || معروف المناقب(@)(@@) من الطويل الثاني :(@)(@)(@@)(@@)(@@) ||| ** أنشأها في رثاء السيد حسين المجاهد الحائري :(@)1 متى لم تكن يا دهر بالمجد مغرما %~% متى لم تمل منه العماد المقوما(@)2 نسيت الذي أرديت بألأمس في الثرى %~% وكان شهابا لا يرى الدهر مظلما(@)3 وما قد أحل ألله كان محللا %~% وما حرم الرحمن كان محرما(@)4 قضى ما عليه من فرائض حجه %~% فلما لواه الشوق بالطف أحرما(@)5 وجاور بحرا لا يزال مغطمطا %~% ولا يشتكي 
ms100	 يوما مجاوره الظما(@)6 لأنسى بأدني جوده العرب حاتما %~% وأنسى بأدنى بأسه العجم رستما(@)7 ألا حرمة العلم العزيز رعيتها %~% إلا ما أفاد الطالبين تكرما(@)8 ولما رأى ما قد أعد إلهه %~% لمن جاء قبر إبن النبي ميمما(@)9 دعا ربه أن لا يبارح قبره %~% فمات ولم يترك على المجد قيما(@)10 سوى الصالحين الرابحين كلاهما %~% على كل من حاز الفخار تقدما(@)11 أخوه ومعروف المناقب شبله %~% إذا قيل من للمجد قلت هما هما(@)12 أعزيهما عنه وكيف وهل ترى %~% يعزي عن البدر الكواكب في السما(@)13 وكم كان أبيات الرشاد مشيدا %~% وكم كان أبيات الضلال مهدما(@)14 أقامك زين العابدين وصيه %~% لأنك عنه كنت بالفضل معلما(@)15 بكته عيون المكرمات ولم تر %~% تصب عليه أعين الفضل عندما(@)16 وما هو إلا الشمس غابت وكل من %~% نرى بعده تشكوا نواظره العمى(@)17 وكم من نفوس اتلف السقم حالها %~% شفاها بجدواه ومذ مات أسقما(@)18 تمنيت أني كنت قبلا أتيته %~% بما جئت فيه من قريض منظما(@)PageV01P146 19 لأحظى بما فيه حظى من نواله %~% سواي ولم يفتح ليسأله فما(@)20 سامدحه حيا وميت لأنني %~% أرى مدحه حقا علي محتما(@)21 لقد كان أعلى العالمين مآثرا %~% واسماهم قدرا وأحماهم حمى(@)22 عمود الهدى بعد الحسين إذا هوى %~% تراه بزين العابدين مقوما(@)23 أصلي عليه ما حييت مسلما %~% وكان عليه ألله صلى وسلما(@)(@)(@@)(@@)(@@) ||| ** التعليقات :(@)(@@) المرثي هو السيد حسين إبن السيد محمد المجاهد الطباطبائي ويظهر أنه كان مصاحبا لوالده في جهاده ضد روسيا القيصرية بدلالة العجز في البيت السادس أخوه هو السيد حسن والد أبو القاسم وشبله هو زين العابدين المتوفى 1291 البيت 17 يدل على أنه كان يتعاطى الطب إنسانيا.(@)(@)(@@)(@@)(@@) || (69)(@)(@)(@@)(@@)(@@) || هذا علي فإعرفوه(@)(@@) من البسيط ألأول :(@)(@)(@@)(@@)(@@) ||| ** قالها في نصب الرسول صلى الله عليه وآله وسلم وآله عليا عليه السلام في مؤتمر الغدير :(@)1 ما أنكر القوم من يوم الغدير وما %~% على نبي الهدى من فعله نقموا(@)2 في يوم قام يناديهم وما سمعوا %~% وما 