ms61	(@)(@@) % ثم عد لي إذا أضي % % ف إلينا كان اعتدا % % 3(@)(@@) % الولي الذي إذا % % بلغ الغاية ابتدا % % 4(@)(@@) % والحكيم الذي إذا % % بلغ المقصد اهتدى % % 5(@)(@@) % إن تجلى له الذي % % كان مطلوبه اقتدى % % 6(@)(@@) % ثم إن زاد علمه % % ضل فيه وما اهتدى % % 7(@)(@@) % لم يقل عالم إذا % % نسخ الحكم بالبدا % % 8(@)(@@) % مثل ما قيل في ذكا % % رجعت وهي في المدى % % 9(@)(@@) % الإمام الذي إذا % % أبصر العين أسندا % % 10(@)(@@) % اقتداء بمن إذا % % أصلح الأمر أفسدا % % PageV01P240 11(@)(@@) % بفسادهم الصلاح % لمن ظل مرشدا % % 12(@)(@@) % لم يدع ربنا الذي % % لم يزل مصطفى سدى % % 13(@)(@@) % إنما قال إنه % % علم بل هم الهدى % % 14(@)(@@) % لا تقل غير ذا فمن % ضل في القول ما هدى % % 15(@)(@@) % وتحفظ من عصبة % لم يكونوا ذوي ندى % % 16(@)(@@) % إنما الشح مهلك % وهو من أعظم العدى % % 17(@)(@@) % لا يغرنك كونه % مانعا منعه جدى % % 18(@)(@@) % إنما الشح للنفو % % س التي تقبل الردى % % 19(@)(@@) % فإذا أنا تخلصت % فهي للحق كالردا % % 20(@)(@@) % فاحمد الله يا أخي % % على ما به هدى % % PageV01P241 البحر : طويل 1(@)(@@) % ألم تر أن الله أكرم أحمدا % ونادى به حتى إذا بلغ المدى % % 2(@)(@@) % تلقاه بالقرآن وحيا منزلا % فكان له روحا كريما مؤيدا % % 3(@)(@@) % وأعطاه ما أبقى عليه مهابة % فأورثه علما وحلما وسؤددا % % 4(@)(@@) % وأعلى به الدين الحنفي والهدى % % وصيره يوم القيامة سيدا % % 5(@)(@@) % وهيأ يوم الفصل عند وروده % له فوق أدنى في التقرب مقعدا % % 6(@)(@@) % وعين يوم الزور في كل حضرة % له في كثيب المسك نزلا ومشهدا % % 7(@)(@@) % فيا خير خلق الله بل خير مرسل % لقد طبت في الأعراق نشأ ومحتدا % % 8(@)(@@) % تحليت للإرسال في كل شرعة % يظهرن آيات ويقدحن أزندا % % 9(@)(@@) % ففي قولكم لما دعيت مذمما % وقد كان سماك الإله محمدا % % 10(@)(@@) % لقد عضم الرحمن بالرحمة اسمنا % % كعصمتنا من سب من كان ألحدا % % PageV01P242 11(@)(@@) % علوم وأسرار لمن كان ذا حجى % % تدل على خلق كريم من العدى % % 12(@)(@@) % فيا خير مبعوث إلى خير أمة % لو أنك في ضيق لكنت لك الفدا % % 13(@)(@@) % ولما دعوت 
ms62	 الله غيرة مؤمن % على من تعدى في الشريعة واعتدى % % 14(@)(@@) % أتاك عتاب الله فيه ولم تكن % أردت به إلا التعصب للهدى % % 15(@)(@@) % بأنك قد أرسلت للخلق رحمة % ومن كان هذا أصله طاب مولدا % % 16(@)(@@) % مدحتك للأسماع مدح معرف % % وقمت به في موقف العدل منشدا % % 17(@)(@@) % وها أنا أتلو في مديحك السنا % % تعز على من كان في العلم قد شدا % % 18(@)(@@) % ولم أغل بل قلت الذي قال ربنا % % وجئت به فضلا مبينا لأرشدا % % 19(@)(@@) % مدحتك بالأسماء أسماء ربنا % % ولم ألتفت عقلا ورأيا مسددا % % 20(@)(@@) % بأنك عبد الله بل أنت كونه % وأنت مضاف الكاف شرعا وما عدا % % PageV01P243 21(@)(@@) % فعينك عين السر والسمع سمعه % % وأنت الكبير الكل للعين إن بدا % % 22(@)(@@) % وأنت الذي أكني إذا قلت كنية % % وأنت الذي أعني إذا ما تمجدا % % 23(@)(@@) % لقد خصك الرحمن بالصورة التي % % روينا ولم ينزل لنا ذكرها سدى % % 24(@)(@@) % وأنت مقال العبد عند قيامه % % من الركعة الزلفى ليهوي فيسجدا % % 25(@)(@@) % وأنت وجود الهاء مهما تعبدت % وأنت وجود الواو مهما تعبدا % % 26(@)(@@) % فقل إنه هو أو فقل ليس هو بهو % وإياك أن تبغي لنفسك موعدا % % 27(@)(@@) % ولا تأخذ إلا لقاء زورا فإنه % % حقيقتكم إن راح عنكم وإن غدا % % 28(@)(@@) % ولما اصطفاك الله عبدا مقربا % أراك الذي أعطى عليك وأشهدا % % 29(@)(@@) % فمن كان يدريه يكون موحدا % ومن كان لا يدري يكون موحدا % % 30(@)(@@) % إذا ما مدحت العبد فامدحه هكذا % % وكن في الذي تلقيه عبدا موحدا % % PageV01P244 31(@)(@@) % فإنك لم تمدحه إلا به فكن % % لمن جاء يستفتيك ركنا ومقصدا % % 32(@)(@@) % فوالله لولا الله ما كنت مصلحا % ووالله لولا الكون ما كنت مفسدا % % 33(@)(@@) % فمن كان مشهودا به كان مؤمنا % ومن كان معلوما له كان ملحدا % % 34(@)(@@) % فكن من علا في الأمر بالأمر نفسه % ولا تك ممن قال قولا فأخلدا % % 35(@)(@@) % فهذا مديح الاختصاص مبين % جمعت لكم بين الندا فيه والندى % % 36(@)(@@) % وأجريت فيه الخمر نهر الشارب % % إذا ما تحسى جرعة منه عربدا % % 37(@)(@@) % ألا إنني أرجو من الله أن أرى 
ms63	 % % بمشهده الأعلى عبيدا مؤيدا % % 38(@)(@@) % بأسمائه الحسنى وأنفاس جوده % % أكون بها بين الأنام مسودا % % PageV01P245 البحر : كامل تام 1(@)(@@) % يا لأهل يثرب لا مقام لعارف % ورث النبي الهاشمي محمدا % % 2(@)(@@) % عم المقامات الجسام عروجه % % وبذاك أضحى في القيامة سيدا % % 3(@)(@@) % صلى عليه الله من رحموته % % ومن أجله الروح المطهر أسجدا % % 4(@)(@@) % لأبيه آدم والحقائق نوم % عن قولنا وعن انشقاق قد هدى % % 5(@)(@@) % فجوامع الكلم التي أسماؤها % % في آدم هي للمقرب أحمدا % % 6(@)(@@) % جمع الإناث إلى الذكور كلامه % % بأخص أوصاف الثناء وقيدا % % 7(@)(@@) % إن الأنوثة عارض متحقق % مثل الذكور لا تكن مترددا % % 8(@)(@@) % الحد يجمعنا إذا أنصفتني % % هن الشقائق لا تجب من فندا % % 9(@)(@@) % لا تحجبن بالانفعال فإنه % % قد كان عيسى قبلها فتأبدا % % 10(@)(@@) % قولي وعيسى لا يشك بكونه % روح الإله مقدسا ومؤيدا % % PageV01P246 11(@)(@@) % الله يعلم صدق ما قد قلته % % والوسط الأفضل في المعتقد % % 12(@)(@@) % مثل أتاك ولا أسميه لما % % قد جاء في نص الشريعة مسندا % % 13(@)(@@) % أدبا مع الله العظيم جلاله % فالدهر للذات النزيهة كالردا % % 14(@)(@@) % الكاف في التشبيه يعمل حكمها % % وتكون زائدة إذا أمر بدا % % 15(@)(@@) % مثل الذي قد جاء ليس كمثله % في سورة الشورى وخاب من اعتدى % % PageV01P247 البحر : بسيط تام 1(@)(@@) % ما في الوجود اختيار عند من شهدا % % وكيف ينكر ما في الكون قد وجدا % % 2(@)(@@) % وقد أتاك به القرآن في سور % يدري بها عندما تتلى الذي جحدا % % 3(@)(@@) % لذاك قيدته بذي الشهود فلا % % تزد عليه ولا تشرك به أحدا % % 4(@)(@@) % فمن أجوز وما في العلم من أحد % سوى الإله الذي في خلقه شهدا % % 5(@)(@@) % الصور صورهم والخلق عينهم % نعم وصورتهم حقا كما وردا % % 6(@)(@@) % لأنه سمعنا بل كان نشأتنا % % روحا وصورة جسم لا تقل جسدا % % 7(@)(@@) % فما يخاطبه إلا حقيقته % مقصودة عينه وهو الذي قصدا % % 8(@)(@@) % ما ثم غير فتفنيه هويته % % لذاك جاء بأن الحق ما ولدا % % 9(@)(@@) % ولا تولد عن شيء تقدمه % % فبالوجود القديم الحادث انفردا % % PageV01P248 البحر : بسيط تام 1(@)(@@) % من يعبد الله إن الله قد عبدا 
ms64	 من يعبد الله إن الله قد عبدا % % ذاك الوحيد فلا تشرك به أحدا % % 2(@)(@@) % كما أتاك بآي الكهف آخرها % % وقد أضاف إليه ذاك فاستندا % % 3(@)(@@) % ذا الفعل كلف والأفعال أجمعها % % لله ليس لكون فعله أبدا % % 4(@)(@@) % وقد أضيف إليه وهو فاعله % لكي يميز من أقر أو جحدا % % 5(@)(@@) % إن الحقائق لم تترك لنا سبدا % بما أتينا به فيه ولا لبدا % % 6(@)(@@) % فكل فعل فإن الله خالقه % % وقد جعلت له من دونه سندا % % 7(@)(@@) % لكي يصيب فلا تحظى إضافته % % إذا أضاف إليه فعل ما شهدا % % 8(@)(@@) % ولا يحاسب إلا من عقيدته % هذا الذي قلته عدلا كما وردا % % 9(@)(@@) % إلا الذي قالها في الله من أدب % لا باعتقاد فيجزيه بما قصدا % % 10(@)(@@) % وتلك مسألة حار الأنام لها % % وليس يعرفها إلا الذي شهدا % % PageV01P249 البحر : طويل 1(@)(@@) % إذا ما ذكرت الله في غسق الدجى % % دجى الجسم لو عند الصباح إذا بدا % % 2(@)(@@) % صباح الذي يحيى به الجسم عندما % % هو الروح لكن بالمزاج تبلدا % % 3(@)(@@) % فلا يأخذ الأشياء من غير نفسه % ولكن بآلات بها سره اهتدى % % 4(@)(@@) % فأمسى فقيرا بعد أن كان ذا غنى % % وأصبح عبدا بعد أن كان سيدا % % 5(@)(@@) % لقد خلته روحا كريما منزها % فأصبح ريحا عنصريا مجسدا % % 6(@)(@@) % وكان جليسا للخضارمة العلى % % بمقعد صدق للنفوس مؤيدا % % 7(@)(@@) % لقد كان فيهم ذا وقار وهيبة % فلما ارتدى الجسم الترابي ألحدا % % 8(@)(@@) % وأجرى له نهرا من الخمر سائغا % فلما تحسى شربة منه عربدا % % 9(@)(@@) % وكان له فوق السموات مشهد % فلما رأى الأرض الأريضة أخلدا % % 10(@)(@@) % وكان لما يلقاه بالذات قائلا % وكان إذا ما جاءه الوحي أسجدا % % PageV01P250 11(@)(@@) % وقد كان موصوفا فأصبح واصفا % كما كان ذا قصد فأصبح مقصدا % % 12(@)(@@) % كما كان فيما نال منه موحدا % فأصبح فيما نيل منه موحدا % % 13(@)(@@) % وفي عالم البعد الذي قد رأيته % رأيت له في حضرة القرب مقعدا % % 14(@)(@@) % ولما تجلى من تجلى بنعتهم % % رأيتهم خروا بكيا وسجدا % % 15(@)(@@) % وأصعقهم وحي من الله جاءهم % فلما أفاقوا قلت : ماذا فقال : دا 
ms65	 % % 16(@)(@@) % أصابهم في حال نشأة ذاتهم % % ولن يصلح العطار ما الدهر أفسدا % % 17(@)(@@) % فقلت : وهل ميزتني في رعيلهم % % فقال : وهل عبد يصير مسودا % % 18(@)(@@) % جعلتكم في أرض كوني خليفة % وأبلست من ناداك فيها وفندا % % 19(@)(@@) % وأسجدت أملاكي وكانوا أئمة % % لرتبتك العليا فأمسيت معبدا % % 20(@)(@@) % نهيتك عن أمر فقاربته ولم % % نجد لك عزما إذ نرى منك ما بدا % % PageV01P251 21(@)(@@) % وقمت لكم فيه بعذر مبين % % بوئت دارا خالدا ومخلدا % % 22(@)(@@) % كما قال من أغواكم غير عالم % % بما قاله إذ قال قولا مسددا % % 23(@)(@@) % وحار بخسران إلى أصل خلقه % % كنور سراج في ظلام توقدا % % 24(@)(@@) % يضيء لإبصار ويحرق ذاته % % عن أمر إلهي أتاه فما اعتدى % % PageV01P252 البحر : طويل 1(@)(@@) % يريد قوله تعالى آمرا : { و استفزز من استطعت منهم بصوتك وأجلب عليهم بخيلك ورجلك وشاركهم في الأموال والأولاد وعدهم } . فيا ليت شعري هل يرى الناس ما أرى % % من العلم في القرآن والنور والهدى % % 2(@)(@@) % لقد جمع الله الكريم بفضله % % ورحمته بين الأوداء والعدى % % 3(@)(@@) % وما كل قرب كائن عن قرابة % كمثلي وإن الحق بالكامل ارتدى % % 4(@)(@@) % وكان كمالي فيه بالصورة التي % % خصصت بها فانظره في باطن الردا % % 5(@)(@@) % وفي سورة الشورى إبان وجودها % % بدي لمن قد فاز فيها إذا ابتدا % % 6(@)(@@) % وأنزلنا في عالم الخلق قدوة % أئمتها وأسوة لمن اقتدى % % 7(@)(@@) % فلله ما يبقي ولله ما مضى % % فلم يوجد الأشياء خلاقها سدى % % 8(@)(@@) % وإني لعلام بما جئتكم به % % وما أنا ممن حار فيه وقلدا % % 9(@)(@@) % وإن لنا في كل حال مواقفا % ومقعد صدق في الغيوب ومشهدا % % 10(@)(@@) % وإني ممن أسلم الأمر فيكم % إليه وممن بالإمامة قلدا % % PageV01P253 11(@)(@@) % أنا خاتم للأولياء كما أتى % % بأن ختام الأنبياء محمدا % % 12(@)(@@) % ختام خصوص لا ختام ولا ية % % تعم فإن الختم عيسى المؤيدا % % 13(@)(@@) % لقد منح الله العبيد قصيدة % يقوم بها يوم القيامة منشدا % % 14(@)(@@) % على رأس مبعوث إلى خير أمة % لقد طاب أصلاها شميا ومولدا % % PageV01P254 البحر : وافر تام 1(@)(@@) % إليك أتيت يا مولاي قصدا % على شدنية سبتا ووجدا % % 2 
ms66	(@)(@@) % وفيك تركت ما لا كنت فيه % % أصرفه وأحبابا وولدا % % 3(@)(@@) % تميزت الأمور إذا أبينت % لذي عينين برهانا وحدا % % 4(@)(@@) % إذا ما البعد آل إلى اقتراب % فبعد الحد ما ينفك بعدا % % 5(@)(@@) % نظمت قوافي الألفاظ لما % % أردت مديحكم عقدا فعقدا % % 6(@)(@@) % فقامت نشأة حسنا لعين % وزهرا في الرياض شذا وملدا % % PageV01P255 البحر : بسيط تام 1(@)(@@) % الحمد لله لا أشرك به أحدا % % إذ لم يجد أحد سواه ملتحدا % % 2(@)(@@) % لم يتخذ كفؤا من خلقه سندا % ولم يلده أب حقا ولا ولدا % % 3(@)(@@) % جل الإله فما تحصى عوارفه % الواهب الأكرم المحسان والصمدا % % 4(@)(@@) % الحق مفتقر إليه أن له % نعت الغنى وبهذا كله انفردا % % 5(@)(@@) % والعبد مفتقر إليه متكل % % عليه مستند لذاته أبدا % % 6(@)(@@) % إن افتقاري ذات لي إلى عدم % وليس يعرفه إلا الذي وردا % % 7(@)(@@) % من عنده بالذي أعطاه من حكم % % بأن معبوده من ذاته عبدا % % 8(@)(@@) % وإن أعمالنا عن أمره ظهرت % % وإن عابده جبر ولا كره وما عبدا % % 9(@)(@@) % بل كان متصفا بالعجز معترفا % بأنه ربه حقا وما عبدا % % 10(@)(@@) % بل كان مفتخرا إليه مفتقرا % لذاته وبهذا الأمر قد سعدا % % PageV01P256 البحر : مديد تام 1(@)(@@) % ما رأينا من عنايته % % يأخذ الأموال والولدا % % 2(@)(@@) % غير رب لم يزل أبدا % % بكمال الوصف منفردا % % 3(@)(@@) % أبصر المغرور جنته % % ثم لم يدر الذي شهدا % % 4(@)(@@) % قال ما أظن في خلدي % % أن تبيد هذه أبدا % % 5(@)(@@) % لم تكن كما تخيله % أنها تبقى له أمدا % % 6(@)(@@) % وهي عند الله باقية % للذي قد كان معتقدا % % 7(@)(@@) % قأراه الظن خيبته % وأرى العلم الذي انتقدا % % 8(@)(@@) % فأراه ما توعده % وأراه ما به وعدا % % 9(@)(@@) % لم يزل في قدس جنته % طالع العلى منتقدا % % 10(@)(@@) % حامدا لله خالقه % % حيث لم يترك له سندا % % PageV01P257 11(@)(@@) % كل من طابت سريرته % % بالذي في سره اتحدا % % 12(@)(@@) % لم يجد من دون خالقه % % أحدا يكون ملتحدا % % 13(@)(@@) % إن لي مولى أسر به % ما يرى شيئا يكون سدى % % 14(@)(@@) % عين كون الشيء حكمته % % ما لها حكم عليه بدا % % 15(@)(@@) % الذي ترجى 
ms67	 عوارفه % كان لي ركنا ومستندا % % 16(@)(@@) % عز لم يعرف وما عرفوا % % غير من أضلهم بهدى % % 17(@)(@@) % فهو المعلوم عندهم % والذي لا يعلمن أبدا % % PageV01P258 البحر : مجزوء الرمل 1(@)(@@) % حدث الشيخ أبونا % % عن أبيه عن قتاده % 2(@)(@@) % عن عطاء بن يسار % عن سعيد بن عباده % 3(@)(@@) % إن من مات محبا % فله أجر الشهاده % % 4(@)(@@) % ثم قد جاء بأخرى % % مثل هذا وزياده % % 5(@)(@@) % عن فضيل بن عياض % وهو من أهل الزياده % 6(@)(@@) % إن من مات خليا % % كانت النار مهاده % PageV01P259 البحر : وافر تام 1(@)(@@) % لقد حار الذي سبر الوجودا % % ليسلك فيه مسلكه البعيدا % % 2(@)(@@) % فما وفى بذاك فحاد عنه % % إلى علم يورثه السفودا % % 3(@)(@@) % عن الكشف الأتم فكان فيه % إذا أنصفته فردا وحيدا % % 4(@)(@@) % فلا تنو الصعيد إذا عدمتم % طهورا للصلاة تكن سعيدا % % 5(@)(@@) % فإن اسم الصعيد يريك علوا % % لهذا الحق أودعك اللحودا % % 6(@)(@@) % ويمم ترب من جعلت ذلولا % % تحز خيرا تكون به رشيدا % % 7(@)(@@) % وتعطيك الأمانة مستواها % % وتحذوك المشاهد والشهودا % % 8(@)(@@) % وتحميك العناية في حماها % % وتكسي ثوبك الغض الجديدا % % 9(@)(@@) % وتأتيك العوارف مسرعات % على ترتيبها بيضا وسودا % % 10(@)(@@) % فتأكلها به لحما طريا % إذا ما المدعي أكل القديدا % % PageV01P260 11(@)(@@) % إذا ما خضت في الآيات تشقى % % وتحرم أن تكون لها شهيدا % % 12(@)(@@) % إذا جد العلي اسمي اعتلا % على العظماء أورثهم حدودا % % 13(@)(@@) % سمعت له وقد أصغى إليه % % لما قالوه بينهم فديدا % % 14(@)(@@) % رأيتهم وقد خروا إليه % % وبين يديه من أدب سجودا % % 15(@)(@@) % ولنت لصونه المخزون لما % % ألان به الجلامد والحديدا % % 16(@)(@@) % وقد وافى على قوم قيام % فصيرهم بهمته قعودا % % PageV01P261 البحر : بسيط تام 1(@)(@@) % لا ذنب أعظم من ذنب يقاوم عف % % و الله الذي يأتيه معتقدا % % 2(@)(@@) % وكل ذنب بجنب العفو محتقر % عفو الإله ولا يخصص به أحدا % % 3(@)(@@) % ورحمة الله خلق وهي قد وسعت % من أوجد الله من خلق وإن جحدا % % 4(@)(@@) % وكيف لا تسع الأكوان رحمته % وهو الذي وسع الأكوان وانفردا % % 5(@)(@@) % عن الكيان به فلم يجد أحد % من دون خالقه مولى وملتحدا % % 6 
ms68	(@)(@@) % هو الوجود الذي بالجود تعرفه % % نفوسنا ولهذا الأمر قد عبدا % % 7(@)(@@) % فلو عرضت على من كان يجهله % % عبادة الله في الأشياء ما عبدا % % 8(@)(@@) % كما هو الأمر لكن فيه ملحمة % بين العقول فكن بالشرع متحدا % % 9(@)(@@) % قد أخبر الله عن سلطان رحمته % بأنه مثل علم الله واعتقدا % % PageV01P262 البحر : بسيط تام 1(@)(@@) % ما لي وإياك غير الله من سند % وفاز من يتخذ رب الورى سندا % % 2(@)(@@) % هو المهيمن فوق العرش مسكنه % % كما يليق به دينا ومعتقدا % % 3(@)(@@) % يأتي وينزل والألباب تطلبه % % كما روينا على المعنى الذي قصدا % % 4(@)(@@) % ومن يكون على ما قلت فيه فقد % وفى بما كلف الإنسان واقتصدا % % 5(@)(@@) % ودع مقالة قوم قال عالمهم % بأنه بالإله الواحد اتحدا % % 6(@)(@@) % الإتحاد محال لا يقول به % إلا جهول به عن عقله شردا % % 7(@)(@@) % وعن حقيقته وعن شريعته % % فاعبد إلهك لا تشرك به أحدا % % 8(@)(@@) % وانهض إلى واهب الأسرار تحظ به % % ولتتخذ عنده قبل القدوم يدا % % 9(@)(@@) % عليه من دارك الدنيا ومن فكر % % تظل من أجلها في حيرة أبدا % % 10(@)(@@) % وكن إماما ولا تسعى لمفسدة % % بكل وجه وكن في الحكم مجتهدا % % PageV01P263 11(@)(@@) % ولا تغالط بتعليل وأقيسة % وكن عن الرأي والتقليد منفردا % % 12(@)(@@) % إني نصحتك والرحمن يشهد لي % % كما أمرت وهذا كله وردا % % PageV01P264 البحر : خفيف تام 1(@)(@@) % إن لله في الوجود عبيدا % % لم ينالوا الصعود إلا سعودا % % 2(@)(@@) % لم يزالوا بباب من كان منهم % عينهم عاكفين فيه قعودا % % 3(@)(@@) % يطلبون الوصال منه ابتداء % منة ثم يطلبون الصدودا % % 4(@)(@@) % ليروا حكمة التقابل منه % % فيهم ثم يطلبون الشهودا % % 5(@)(@@) % ما سمعنا منهم حنين اشتياق % حين حلوا ولا سمعنا فديدا % % 6(@)(@@) % ليت شعري كيف الوصول إليهم % حين خروا عند التجلي سجودا % % 7(@)(@@) % بعدوا بالسجود عنه اقترابا % % لا اغترابا إذ كان عنهم بغيدا % % 8(@)(@@) % إن تسبيحهم يدل عليه % ولذا يسألون منه حدودا % % 9(@)(@@) % طلبوا منه ما يعود عليهم % % حكمه فاستفاد وأمنه الحدودا % % PageV01P265 البحر : مخلع البسيط 1(@)(@@) % يا بدر بادر إلى المنادي % % كفيت فاشكر ضر الأعادي % % 2(@)(@@) % قد 
ms69	 جاءك النور فاقتبسه % % ولا تعرج على السواد % 3(@)(@@) % فمن أتاه النضار يوما % يزهد في الخط بالمداد % 4(@)(@@) % فقم بوصف الإله وانظر % % إليه فردا على انفراد % 5(@)(@@) % وحصن السمع إذ تنادي % % وخلص القول إذ تنادي % % 6(@)(@@) % والبس لمولاك ثوب فقر % كي تحظى بالواهب الجواد % 7(@)(@@) % وقل إذا جئته فقيرا % يا سيدا وده اعتمادي % % 8(@)(@@) % اسق شراب الوصال صبا % ما زال يشكو صدى البعاد % % 9(@)(@@) % تاه زمانا بغير قوت % إذ لم يشاهد سوى العباد % % 10(@)(@@) % فكن له القوت ما استمرت % أيامه الغر باقتصاد % PageV01P266 11(@)(@@) % حتى يموت العذول صبرا % وتنطفي جمرة البعاد % 12(@)(@@) % ويعجب الناس من شخيص % يكون بعد الضلال هادي % % 13(@)(@@) % من كان ميتا فصار حيا % فقد تعالى عن النفاد % % 14(@)(@@) % ما خلع النعل غير موسى % % بشرطها عند بطن واد % 15(@)(@@) % من خلعت نعله تناهت % % رتبة أقواله السداد % 16(@)(@@) % فإن تكن هاشمي ورث % فاسلك بها منهج السداد % 17(@)(@@) % والبس نعاليك إن من لم % % يلبس نعاله في وهاد % 18(@)(@@) % فهل يساوي المحيط حالا % من لم ير العين في الرماد % 19(@)(@@) % فميز الحال إذ تراه % % في مركب القدس في الغوادي % % 20(@)(@@) % ورتب العلم إذ يناجي % % سرك بالسر في الهوادي % % PageV01P267 21(@)(@@) % وارقبه في وهم كل سير % في ساتر إن أتى وبادي % % 22(@)(@@) % ولا تشتت ولا تفرق % عبديه من حاضر وبادي % % 23(@)(@@) % فإن وهبت الرجوع فرق % بين الحواضر والبوادي % % 24(@)(@@) % واحذر بأن تركب المهارى % % إذ تقرن العير بالجواد % 25(@)(@@) % لا يحجبنك الشخوص واصبر % % على مهماته الشداد % 26(@)(@@) % وانظر إلى واهب المعاني % % وقارن العين بالفؤاد % % 27(@)(@@) % وأسند الأمر في التلقي % % له تكن صاحب استناد % 28(@)(@@) % ولا يغرنك قول عبدي % % فالحق في الجمع لا ينادي % % 29(@)(@@) % وإن هذا المقام أخفى % % من عدم المثل للجواد % 30(@)(@@) % فكنه علما وكنه حالا % مع رائح إن أتى وغادي % % PageV01P268 31(@)(@@) % وكنه نعتا ولا تكنه % ذاتا فعين المحال بادي % % 32(@)(@@) % ولا تكن ذا هوى وحب % فيه فقلب المحب صادي % % 33(@)(@@) % من بات ذا لوعة محبا % شكا له حرقة الجواد % % 34(@)(@@) % وانظر بعين الفراق أيضا 
ms70	 % فيه ترى حكمة العناد % % 35(@)(@@) % وحكمة الحزم والتواني % % وحكمة السلم والجلاد % % 36(@)(@@) % فحكمة الصد لا يراها % % سوى حكيم لها وسادي % % 37(@)(@@) % وانظر إلى ضارب بعود % % صفاة يبس فانساب وادي % % 38(@)(@@) % واعجب له واتخذه حالا % تجده كالنار في الزناد % % 39(@)(@@) % فالماء للروح قوت علم % % والجسم للنار كالمزاد % 40(@)(@@) % فإن مضى الماء لم تجده % % بدار دنياك في المعاد % PageV01P269 41(@)(@@) % وإن خبت ناره عشاء % فسو من مات في المهاد % % 42(@)(@@) % أوضحت سرا إن كنت حرا % كنت به واري الزناد % % 43(@)(@@) % من علم الحق علم ذوق % لم يقرن الغي بالرشاد % 44(@)(@@) % فمن أتاه الحبيب كشفا % لم يدر ما لذة الرقاد % 45(@)(@@) % مثل رسول الإله إذ لم % يسكن له النوم في فؤاد % % 46(@)(@@) % لو بلغ الزرع منتهاه % اشتغل القوم بالحصاد % 47(@)(@@) % أو نازل الحصن قوم حرب % لبادر الناس للجهاد % 48(@)(@@) % ناشدتك الله يا خليلي % % هل فرش الخز كالقتاد % 49(@)(@@) % لا والذي أمرنا إليه % ما عنده الخير كالفساد % PageV01P270 البحر : كامل تام 1(@)(@@) % إن وافق النجم السعيد هلاله % % كان الوجود على ساق واحد % 2(@)(@@) % فإن انتفى عين التواصل منهما % % نقص الوجود عن الوجود الراشد % 3(@)(@@) % فانظر بقلبك أين حظك منهما % % في الرزق أو في العالم المتباعد % PageV01P271 البحر : بسيط تام 1(@)(@@) % النار تضرم في قلبي وفي كبدي % % شوقا إلى نور ذات الواحد الصمد % 2(@)(@@) % فجد علي بنور الذات منفردا % حتى أغيب عن التوحيد بالأحد % % 3(@)(@@) % جاد الإله به في الحال فارتسمت % % حقيقة غيبت قلبي عن الجسد % 4(@)(@@) % فصرت أشهده في كل نازلة % % عناية منه في الأدنا وفي البعد % % PageV01P272 البحر : وافر تام 1(@)(@@) % فمن شرف النبي على الوجود % ختام الأولياء من العقود % % 2(@)(@@) % من البيت الرفيع وساكنيه % % من الجنس المعظم في الوجود % 3(@)(@@) % وتبيين الحقائق في ذراها % % وفضل الله فيه من الشهود % 5(@)(@@) % لو أن البيت يبقى دون ختم % لجاء اللص يفتك بالوليد % 6(@)(@@) % فحقق يا أخي نظرا إلى من % % حمى بيت الولاية من بعيد % 7(@)(@@) % فلولا ما تكون من أبينا % % لما أمرت ملائكة السجود % 8(@)(@@) % فذاك الأقدسي أمام 
ms71	 نفسي % % يسمى وهو حي بالشهيد % % 9(@)(@@) % وحيد الوقت ليس له نظير % فريد الذات من بيت فريد % 10(@)(@@) % لقد أبصرته حتما كريما % بمشهده على رغم الحسود % 11(@)(@@) % كما أبصرت شمس البيت منه % % مكان الحلق من حبل الوريد % % PageV01P273 12(@)(@@) % لو أن النور يشرق من سناه % % على الجسم المغيب في اللحود % % 13(@)(@@) % لأصبح عالما حيا كليما % طليق الوجه يرفل في البرود % 14(@)(@@) % فمن فهم الإشارة فليصنها % % وإلا سوف يحلق بالصعيد % 15(@)(@@) % فنور الحق ليس به خفاء % على الأفلاك من سعد السعود % 16(@)(@@) % رأيت الأمر ليس به توان % سواء في هبوط أو صعود % 17(@)(@@) % نطقت به وعنه وليس إلا % % وإن الأمر فيه على المزيد % % 18(@)(@@) % وكوني في الوجود بلا مكان % دليل أنني ثوب الشهيد % % 19(@)(@@) % فما وسع الوجود جلال ربي % % ولكن كان في قلب العميد % 20(@)(@@) % أردت تكتما لما تجارى % % إليه النكر من بيض وسود % 21(@)(@@) % وهل يخشى الذئاب عليه من قد % مشى في القفر من خفر الأسود % PageV01P274 22(@)(@@) % وخاطبت النفيسة من وجودي % % على الكشف المحقق والوجود % 23(@)(@@) % أبعد الكشف عنه لكل عين % جحدت وكيف ينفعني جحودي % % 24(@)(@@) % فردت في الجواب علي صدقا % تضرع للمهيمن والشهيد % 25(@)(@@) % وسله الحفظ ما دام التلقي % % وسله العيش للزمن السعيد % % 26(@)(@@) % سألتك يا عليم السر مني % % عصا ما في المودة بالودود % 27(@)(@@) % وأن تبقي علي رداء جسمي % % بكعبتكم إلى يوم الصعود % 28(@)(@@) % وأن تخفي مكاني في مكاني % % كما أخفيت بأسك في الحديد % 29(@)(@@) % وتستر ما بدا مني اضطرارا % كسترك نور ذاتك في العبيد % 30(@)(@@) % وأن تبدي علي شهود عجزي % % بتوفيتي مواثيق العهود % PageV01P275 البحر : مخلع البسيط 1(@)(@@) % إذا تجردت عن وجودي % % كنت أنا الهو على الشهود % 2(@)(@@) % وكان كوني لأن عيني % % عين شهودي بلا مزيد % PageV01P276 البحر : سريع 1(@)(@@) % يا حبذا المسجد من مسجد % وحبذا الروضة من مشهد % 2(@)(@@) % وحبذا طيبة من بلدة % فها ضريح المصطفى أحمد % 3(@)(@@) % صلى عليه الله من سيد % لولاه لم نعلم ولم نهتد % 4(@)(@@) % قد قرن الله بهش ذكره % في كل يوم فاعتبر ترشد % 5 
ms72	(@)(@@) % عشر خفيات وعشر إذا % % أعلن بالتأذين في المسجد % 6(@)(@@) % فهذه عشرون مقرونة % بأفضل الذكر إلى الموعد % % PageV01P277 البحر : كامل تام 1(@)(@@) % إن الذي فتح الخزائن جوده % لم يبد للأبصار غير وجوده % 2(@)(@@) % والحكم للأعيان ليس لذاته % % إلا القبول له بحكم شهوده % 3(@)(@@) % هو مظهر أحكامهم في عينه % لما تعين مظهرا لعبيده % 4(@)(@@) % لا وجه أعظم من غنى في نعته % بغنى تقيد عندنا بحدوده % % 5(@)(@@) % وإذا يكون الأمر هذا لم يزل % % سلك القلادة ثابتا في جيده % % 6(@)(@@) % إنا لنبصره ونعلم أنه % % حال بنا وحليه من جوده % 7(@)(@@) % إنا جعلنا ما علينا زينة % لوجوده بعقوده وعقوده % % 8(@)(@@) % فإذا أنا أوفيته ألزمته % ذاك الوفاء بعينه لعهوده % PageV01P278 البحر : خفيف تام 1(@)(@@) % أنا في العالم الذي لا أراكم % كمسيح النصارى بين اليهود % 2(@)(@@) % فإذا ما رأيتكم نصب عيني % % أنا والله في جنان الخلود % PageV01P279 البحر : خفيف تام 1(@)(@@) % ما مقامي بأرض نخلة إلا % % كمقام المسيح بين اليهود % PageV01P280 البحر : سريع 1(@)(@@) % أسبح الله بأسمائه % % من كل مذموم ومحمود % % 2(@)(@@) % إن نطقت بحمده ألسن % فبين مفقود وموجود % % 3(@)(@@) % فحامد يجري بإطلاقه % وحامد يجري بتقييد % 4(@)(@@) % وكلهم في حمده محسن % وإن أتوا فيه بتحديد % % 5(@)(@@) % وليس في الوسع سوى ما بدا % % فإنه جمع بتبديد % 6(@)(@@) % لو كان في الوسع لقنا به % ولم نقل فيه بتجريد % 7(@)(@@) % والله إني عابد للهوى % % ليس له فأين توحيدي % % 8(@)(@@) % حكم الهوى صيرني عابدا % لربه فذاك معبودي % % 9(@)(@@) % إني لما جئت به منصف % لست كمن قد ضل في البيد % % 10(@)(@@) % ولم أقل عجل لنا قطنا % سخرية يا خير مشهود % PageV01P281 11(@)(@@) % لا بد من يوم لنا جامع % ما بين منحوس ومسعود % PageV01P282 البحر : متقارب تام 1(@)(@@) % تولدت عني وعن واحد % فسميت بالغائب الشاهد % 2(@)(@@) % فلولا قبولي وأسماؤه % لما كنت عني وعن واحد % % 3(@)(@@) % فيا من هو النعت في عينه % ومن نعته ليس بالزائد % 4(@)(@@) % لقد رمت أمرا فلم أستطع % % كما رامه الصيد بالصائد % 5(@)(@@) % تراوغ عن سهمه قاصدا % وأين الفرار من القاصد % 6(@)(@@) % ومن أعجب الأمر أني 
ms73	 به % صدرت ولم يك عن وارد % 7(@)(@@) % وكيف الصدور وما في الصدور % سوى مقبل عنه أو شارد % % 8(@)(@@) % تعاليت لما تعاليتم % % وما أنت بالواحد الواجد % % 9(@)(@@) % أنا واحد واجد كونكم % ولست لعيني بالفاقد % % 10(@)(@@) % أنا ثابت لست عن مثبت % % كما أنا عن موجد ماجد % PageV01P283 11(@)(@@) % فإن غناه وإن افتقاري % % دليل لذي النظر الفاسد % % 12(@)(@@) % وكيف الغنى والذي عندنا % % من أسمائه بالغنى شاهدي % % 13(@)(@@) % فإن غناه بأعياننا % % محال عليه لدى الناشد % 14(@)(@@) % ولكنه مثل ما قاله % % غني عن العالم الراصد % % 15(@)(@@) % وذاك الغني بلا مرية % % وإياك من نفثة العاقد % 16(@)(@@) % تعالى عن الفقر في ذاته % % علو الحفيظ على الراقد % % 17(@)(@@) % تعوذت منه به مثل ما % % تعوذت من غاسق حاسد % 18(@)(@@) % فنعتي الإقامة في موطني % % كما نعته عنه بالوافد % 19(@)(@@) % فينزل ربي إلى خلقه % % ولا وصف للخلق بالصاعد % % 20(@)(@@) % إليه ولكن لآياته % كما جاء في المحكم النافد % PageV01P284 21(@)(@@) % يقر ويجحد إقراره % % وأين المقر من الجاحد % 22(@)(@@) % أزينه وهو لي زينة % كما زين القلب بالساعد % 23(@)(@@) % طردت الذي لم ترد قربه % % وسميت عبدك بالطارد % 24(@)(@@) % إذا امتحن الله عباده % % نفوز بمعرفة العابد % 25(@)(@@) % كما الأم تضرب أولادها % % لتظهر مرتبة الوالد % 26(@)(@@) % دعاني إلى رفده جوده % وما كل من سار كالقاعد % 27(@)(@@) % فسيري به مثل سيري له % % فأنعت بالسائق القائد % % 28(@)(@@) % أذود الردى عن جناب الهدى % % لا علم في الناس بالذائد % 29(@)(@@) % وما ذدته عنه إلا به % % فيا خيبة العالم الحائد % PageV01P285 البحر : بسيط تام 1(@)(@@) % أسماء أسمائه الحسنى التي تبدي % % هي الكثيرة بالأوتار والعدد % 2(@)(@@) % وما بأسمائه الحسنى التي خفيت % عن العقول سوى حقيقة الأحد % 3(@)(@@) % وإن أسماءه الحسنى التي بقيت % لنا وإن جهلت من أعظم العدد % % 4(@)(@@) % ولاظهور لها فإنها نسب % فكيف أجعلها في الدفع معتمدي % % 5(@)(@@) % والناس في غفلة عما ذكرت لهم % فيها وعن سبل التحقيق في حيد % 6(@)(@@) % فليس يفقدها وليس يوجدها % % والفقد والوجد في سلم وفي لدد % % 7(@)(@@) % فليت شعري إذا مر الزمان بها % % هل يبقى للكون من خلد ومن 
ms74	 أبد % % 8(@)(@@) % وكيف يبقى ولا دور يعد به % والدهر يعرف بالأدوار والمدد % % 9(@)(@@) % وما تسمى به الحق العليم سدى % إلا من أجل الذي يعطيه من مدد % 10(@)(@@) % ها إن ذي حكمة تجري بصورتها % % مع الزمان ولكن لا إلى أمد % PageV01P286 11(@)(@@) % لا بل إلى أبد الآباد جريتها % % هل في الزمان زمان فاعتبر تجد % 12(@)(@@) % والله لو علمت نفسي بما سمحت % % من العلوم التي أعطتك في الرفد % % 13(@)(@@) % بذاتها وهي لم تشعر بما وهبت % من العطايا لماتت وهي لم تجد % % 14(@)(@@) % فاشكر إلهك لا تشكر عطيتنا % % إن العطايا لمن لو شاء لم تفد % % 15(@)(@@) % هذا من الجهة المقصود جانبها % % كما الوفود لمن لو شاء لم يفد % % 16(@)(@@) % إن الورود الذي في الكون صورته % من النفوس التي لو شاء لم ترد % % 17(@)(@@) % هذا هو الأدب المشروع ليس له % إلا أداة امتناع الشيء لم يرد % % 18(@)(@@) % قد قلت فيه مقالا لست أنكره % إذ النفوس عن التحقيق لم تحد % % 19(@)(@@) % إن العلوم التي التحقيق جاء بها % % هي العلوم التي تهدي إلى الرشد % 20(@)(@@) % رشد المعارف لا رشد السعادة و % % الإيمان يسعد أهل الصور والجسد % PageV01P287 21(@)(@@) % فاحمد إلهك لا تحمد سواه فما % % يعطي السعادة إلا حمده وقد % 22(@)(@@) % لا تنكروا الطبع إن الطبع يغلبني % % والحق يغلبه إن كان ذا فند % % 23(@)(@@) % دين العجائز مأوانا ومذهبنا % % وهو الظهور به في كل معتقد % 24(@)(@@) % به أدين فإن الله رجحه % % على التفكر في كشف وفي سند % 25(@)(@@) % في كل طالعة عليا ونازلة % سفلى مع القول بالتوحيد للأحد % % 26(@)(@@) % سكن إلهي روعاتي فإن لها % % ميلا شديدا إلى ما ليس مستندي % % 27(@)(@@) % إن الركون إلى الأدنى من السبب % الأعلى تجد طعمه أحلى من الشهد % % 28(@)(@@) % ولا أخص به أنثى ولا ذكرا % ولا جهولا ولا من قال بالرصد % 29(@)(@@) % بل حكمه لم يزل في كل طائفة % من كل صاحب برهان ومعتقد % % 30(@)(@@) % لولا مسامحة الرحمن فيك لما % % رأيت شخصا سعيدا آخر الأبد % PageV01P288 31(@)(@@) % هو الإله الذي عمت عوارفه % لما سرى الجود في 
ms75	 الأدنى وفي البعد % % 32(@)(@@) % ألا ترى الجود بالإيجاد عم فلم % % يظهر به أحد فضلا على أحد % % PageV01P289 البحر : - 1(@)(@@) % ألف لام ميم وذلك ما أردنا % % من إنزال الكتاب على وجود % 2(@)(@@) % ألف لام ميم بحي ليس يفنى % % لما يعطى الفناء من الجحود % 3(@)(@@) % ألف لام ميم بصاد عند صاد % لوارد علمه عند الشهود % 4(@)(@@) % ألف لام را لسابقة أتثنا % % بصدق الوعد لا صدق الوعيد % 5(@)(@@) % ألف لام را لقد عظمت أمرا % يشيب لهوله رأس الوليد % 6(@)(@@) % ألف لام را مبشرة تجلت % طلبت وجوده من غير حد % 7(@)(@@) % ألف لام ميم ورا لوميض برق % يبشرني بإقبال الرعود % 8(@)(@@) % ألف لام را أنست به خليلا % إلى يوم النشور من الصعيد % 9(@)(@@) % ألف لام را بميزان صدوق % فصلت به المراد من المريد % 10(@)(@@) % وكاف ها يا يربعهن عين % % إلى صاد تطأطأ للسجود % % PageV01P290 11(@)(@@) % وطاها ما رأيت له نظيرا % إذا حضر المشاهد بالشهيد % 12(@)(@@) % وطاسين ميم يضيق لها صدور % وروح الشعر في بيت القصيد % % 13(@)(@@) % وطاسين جاء مقتبسا لنار % وكلمه المهيمن بالوجود % % 14(@)(@@) % وطاسين ميم قتلت به قتيلا % لينقله إلى ضيق اللحود % % 15(@)(@@) % ألف لام ميم لأوهن بيت شخص % تولع بالذباب من الصيود % 16(@)(@@) % ألف لام ميم غلبت الروم فيه % % ليغلبني بآيات المزيد % 17(@)(@@) % ألف لام ميم ليحفظ بي وصايا % % سرت في الكون من بيض وسود % PageV01P291 البحر : وافر تام 1(@)(@@) % فبيني إن نظرت وبين ربي تعالى جد ربي عن وجودي % % فأعجب إذ دعاني للسجود % 2(@)(@@) % فذلك لي فإن الله أعلى % % وأعظم أن يضاف إلى العبيد % 3(@)(@@) % لقد جاهدت أن ألقى رشيدا % وما في القوم من شخص رشيد % % 4(@)(@@) % فبني إن نظرت وبين ربي % % كما بين الشهادة والشهيد % 5(@)(@@) % علا من قد علا والخلق حق % وأين على السماء من الصعيد % 6(@)(@@) % وقيده لنا الإطلاق فيه % ونقصه لنا طلب المزيد % 7(@)(@@) % لأن له الكمال بغير شك % فيظهر في القريب وفي البعيد % 8(@)(@@) % فنحن به فأثبتني فقيرا % ونحن له فأين وجود جودي % % 9(@)(@@) % تنزه لي فلم أقدر عليه 
ms76	 % فلما أن تحصل في القيود % 10(@)(@@) % ظفرت به فلم أر غير ذاتي % % فقلت أنا فقال أبى وجودي % % PageV01P292 البحر : بسيط تام 1(@)(@@) % الحق في شاهد يبدو ومشهود % والخلق ما بين مفقود وموجود % 2(@)(@@) % إن قلت هذا هو المخلوق قيل أنا % % الحق باطنه من غير تقييد % 3(@)(@@) % أو قلت هذا هو الحق الذي شهدت % له دلالته في عين توحيد % 4(@)(@@) % يقال لي بل هو الحق الذي عرفوا % % وجوده أنه من حضرة الجود % PageV01P293 البحر : بسيط تام 1(@)(@@) % قد أقسم الله لي في سورة البلد % % بأنه خلق الإنسان في كبد % 2(@)(@@) % وما أراد بهذا الخلق من أحد % % من نشأتي سوى روحي مع الجسد % 3(@)(@@) % وإنها حضرة الأسماء حضرته % تسع وتسعون لم تنقص ولم تزد % % 4(@)(@@) % وإنها درجات في الجنان على % % أعدادها نزلت بحكمها وقد % % 5(@)(@@) % وما لنا سند في ذاك أسرده % % للسامعين وإن الأمر في سند % PageV01P294 البحر : بسيط تام 1(@)(@@) % ولا أزال كذا ما دام مسكننا إني تعوذت بي مني فإن لنا % % النور بالروح والإظلام بالجسد % 2(@)(@@) % ولا أزال كذا ما دام مسكننا % % فلو ترحلت عن أهل وعن بلد % % 3(@)(@@) % وجدت فيه ضياء لا ظلام به % يغني عن الأهل والأموال والولد % 4(@)(@@) % لكن له الظل ذاك الظل راحتنا % % في صورة الجسم لا في صورة الجسد % % 5(@)(@@) % منزه العين من تأثير ما ظهرت % به الطبيعة في الأركان من مدد % 6(@)(@@) % لي التقاء بها ما دمت أسكنها % % واللبث لا ينتهي فيها إلى أمد % % 7(@)(@@) % لو لم يكن فيه من خير ومن دعة % إلا تخلصنا من باعث الحسد % PageV01P295 البحر : مخلع البسيط 1(@)(@@) % فالأول الحق بالوجود % والآخر الحق بالشهود % 2(@)(@@) % إليه عادت أمور كوني % % فإنما الرب بالعبيد % 3(@)(@@) % فكل ما أنت فيه حق % ولم تزل فيه في مزيد % % PageV01P296 البحر : وافر تام 1(@)(@@) % إذا أشهدت أنك في شهود % % خلي عن مقاومة الشهيد % 2(@)(@@) % وإنك ناظر فيه إليه % % به من كونه رب العبيد % 3(@)(@@) % وإنك مبتغ طلبا مزيدا % فقد شرع السؤال من المزيد % % 4(@)(@@) % رأيت العين ليس لها نظير % يقاوم 
ms77	 من مراد أو مريد % 5(@)(@@) % إذا ما الحق جلاه إلينا % % تعين في السيادة والمسود % 6(@)(@@) % فما في الكون من يدري كلامي % % سوى من عينه حبل الوريد % 7(@)(@@) % فيظهرني فأظهره فيخفى % % فأخفيه بآداب السجود % 8(@)(@@) % سجدت له سجود هوى بحق % فأكرم بالسلام وبالشهود % 9(@)(@@) % رفعت به فلم أر غير ذاتي % % تصرف في القيام وفي القعود % 10(@)(@@) % ليشهد في جميع الأمر منه % % وفيه فينطفي غيظا حسودي % % PageV01P297 البحر : مجزوء الرمل 1(@)(@@) % إن سري هو قولي % % إنني عين وجوده % 2(@)(@@) % وإذا أبصر عيني % % أنني عين شهوده % 3(@)(@@) % وبذا يكون شكري % % إن شكرت من مزيده % % 4(@)(@@) % أقرب الأمر لكوني % % من يكن حبل وريده % 5(@)(@@) % فأنا بين مراد % لحبيبي ومريده % 6(@)(@@) % عدم لست وجودا % مع كوني من عبيده % 7(@)(@@) % بوجودي أثبت النا % % ظر عندي عين جوده % % PageV01P298 البحر : طويل 1(@)(@@) % دنا وتدلى عبد رب وربه % فلما التقينا لم أجد غير واحد % 2(@)(@@) % دواما مع الدنيا على كل حالة % وفي الساحة الأخرى بأعدل شاهد % % 3(@)(@@) % دعوت به حتى إذا ما استجاب لي % % رأيت الصدى يجري فكنت كفاقد % 4(@)(@@) % دووا بي عليه كي أرى غير موجدي % % لذاك أرى بين السهى والفراقد % 5(@)(@@) % دعاني إليه بالسجود فعندما % % سجدت له خابت لديه مقاصدي % % 6(@)(@@) % ولا لك يا هذا حجابك فلتقم % بعزة معبود وذلة عابد % 7(@)(@@) % دعيت فلما جئت أكرم مجلسي % % وقال لنا أهلا بأكرم وارد % 8(@)(@@) % ومشيت لما قد جاءني من خطابه % % وأطعمي ذوقا لذيذ المواعد % 9(@)(@@) % دوام شهود الذات فيه لمن درى % % إذا ما ابتلاه الله سم الأساود % 10(@)(@@) % دع الأمر يجري منه لا منك واتئد % % تكن في عداد المحصنات الفرائد % PageV01P299 البحر : طويل 1(@)(@@) % غزال من الفردوس بات معانقي % % فقبلني ودا فتم مرادي % % 2(@)(@@) % له زينة الأسماء أسماء خالقي % % عليه من الأثواب ثوب حداد % 3(@)(@@) % من أجل الذي قد بات فيه مهيما % ضحوكا للقياه صحيح وداد % % 4(@)(@@) % تراه مع الأنفاس يتلو كتابه % % بعبرة محزون حليف سهاد % 5(@)(@@) % يقوم بأمر الله إذا قال قم به % بطاعة مهدي وسنة هادي % % PageV01P300 البحر : طويل 
ms78	 1(@)(@@) % تبارك رب لم يزل عالي الجد % نزيها عن الفصل المقوم والحد % 2(@)(@@) % تعالى فلا كون يقاوم كونه % % يعبر عنه الكشف بالعلم الفرد % 3(@)(@@) % تميز في خلق جديد مميز % بأسمائه الحسنى وبالأخذ للعهد % % 4(@)(@@) % فقلت له من أنت يا من جهلته % % فقال المنادي ذو الثناء وذو المجد % % 5(@)(@@) % كمثل الصدى كان الحديث فمن يقل % % خلاف الذي قد قلته خاب في القصد % 6(@)(@@) % فمن يدر سر الفرد لم يجهل الذي % % يجىء به الفرد الوحيد من العد % 7(@)(@@) % وليس سواه والعيون كثيرة % وتخلتف الألقاب فيه مع الفقد % PageV01P301 البحر : بسيط تام 1(@)(@@) % إني وليت أمور الخلق أجمعها % % شرقا وغربا وإني بيضة البلد % 2(@)(@@) % وما أنفذ أمرا في الوجود فما % % يبدو مقامي فما يدريه من أحد % % 3(@)(@@) % وما أغالط نفسي حين أسمع ما % % أدعى به من أمام سيد سند % 4(@)(@@) % أتابع الحق فيما شاءه وقضى % % قبل الوقوع عن اذن السيد الصمد % % 5(@)(@@) % فينفذ الأمر بي في كل آونة % ولا ترى الخلق إلا صورة الجسد % % 6(@)(@@) % عجزا وفقرا وكتما لا يزايلني % % وإنني أحدي الذات بالأحد % % 7(@)(@@) % وعين ذكر مقامي ستره ولذا % % صرحت إذ قبل الأقوام مستندي % % 8(@)(@@) % فقال قائلهم دعواه قد عريت % عن الدليل وهذا عين معتقدي % % PageV01P302 البحر : كامل تام 1(@)(@@) % لولا قبولي ما رأيت وجودي % % وبه مننت علي حال شهودي % % 2(@)(@@) % إياي فانظر في معالم حكمتي % % يدري بها من كان أصل وجودي % % 3(@)(@@) % وربها تميز من كتابي كونه % ولما قضى في علمه بمزيد % 4(@)(@@) % وهو الغني ولست أعرف ذاته % إلا به وتجل عن تحديدي % % 5(@)(@@) % لما علمنا جوده بوجوده % % بالافتراق خرجت عن توحيدي % % 6(@)(@@) % الله يعلم أنني ما كنته % % أو كانني إلا بخط جدودي % % 7(@)(@@) % جردت عن أسمائه وصفاته % ووجوده ووجوهه بحدودي % % 8(@)(@@) % لولا اعترافي بالذي هو نشأتي % % ما قلت بالتثليث والتفريد % PageV01P303 البحر : بسيط تام 1(@)(@@) % إذا ذكرت الذي بالذكر يحجبني % % عنه ويحصره ذكراه في خلدي % % 2(@)(@@) % الذكر باللفظ عين الذكر منه بنا % % فنحن نذكره في حالة الرصد % 3(@)(@@) % لولا تحوله في العين في 
ms79	 صور % ما صح ذكر على الوجهين من أحد % 4(@)(@@) % والذكر بالقلب ذكر لا حروف له % لأنه واحد من ساكني البلد % 5(@)(@@) % إني أرى نشأة الديهور قائمة % وهي التي خلقت بالطبع في كبد % 6(@)(@@) % هو النزيه الذي لا شيء يشبهه % % وإن تقيد لي بالجسم والجسد % % 7(@)(@@) % هو المقيد في الإطلاق صورته % فهو الكثير بكثر ليس عن عدد % % 8(@)(@@) % لكنها نسب والعين واحدة % هوية دعيت بالواحد الصمد % % 9(@)(@@) % ألفيت أسماءه الحسنى بحضرتنا % % تسعا وتسعين لم تنقص ولم تزد % % 10(@)(@@) % فكملت مائة فيها حقائقنا % % وغبت فيه مغيب الشفع في الأحد % PageV01P304 البحر : بسيط تام 1(@)(@@) % الله أكبر ما بالدار من أحد % وما خلت وهي عندي عين مستندي % % 2(@)(@@) % دار الوجود تسمى وهو مظهرها % % وما الوجود سواها عندها وقد % 3(@)(@@) % ما إن ذكرتك باسم لست أعرفه % إلا ويوجد لي معناه في خلدي % % 4(@)(@@) % وكان في ولم أشعر بموضعه % كموضع الروح لا يدري به جسدي % % 5(@)(@@) % شواهد الحال في الاشياء تعلمني % % بها فأصبح في معلومة جدد % 6(@)(@@) % يمسي عليها رجال ما لهم عدد % يغني الأمان الذي فيها عن العدد % % 7(@)(@@) % هي السبيل إليها فهي غايتها % % مثل الترادف في الأسماء بالعدد % % 8(@)(@@) % علمت منها علوما لم يكن أحد % يدري بها غير أهل العلم بالرصد % 9(@)(@@) % لهم رقيت عليهم من نفوسهم % لا يعلمون به يهدي إلى الرشد % 10(@)(@@) % ضخم الدسيعة وهاب أخو كرم % رب الجزور ورب الوهب والرفد % PageV01P305 11(@)(@@) % إذا تحركه الأنواء تحسبه % كأنه البحر يرمي السيف بالزبد % % 12(@)(@@) % إن كان ينصره من كان يخذله % % فلا تناقض بين الفرد والأحد % 13(@)(@@) % أنهى إليكم كتابا فيه ذكركم % لتعقلوا عنه ما يلقى بلا سند % % 14(@)(@@) % من الأقاول من فقر ومن بخل % من أجل قرض وإمساك عن المدد % % PageV01P306 البحر : بسيط تام 1(@)(@@) % الحمد لله حمدا لا يقاومه % تحميد حمد ولا تحميد حماد % 2(@)(@@) % لا حمد يعلو كحمد الحمد فاحظ به % % إن كنت تحمده قصدقه باد % 3(@)(@@) % فهو الثناء الذي لا مين يصحبه % ولا يجوز عليه خرق معتاد % PageV01P307 البحر : وافر تام 1 
ms80	(@)(@@) % إذا ما المرء غاب عن الوجود % بمتا تلقاه من غط الشهود % 2(@)(@@) % إذا نزل الأمين عليه يلقي % % إليه الوحي من عين المزيد % % 3(@)(@@) % فيفنيه الفناء عن الوجود % وما يفنيه إلا بالوجود % 4(@)(@@) % ففيه به فناء العين منه % % وإن يقصد يستر بالجحود % % 5(@)(@@) % رأيت أهله طلعت بدورا % مكملة بمنزلة السعود % PageV01P308 البحر : بسيط تام 1(@)(@@) % إني أفاديك يا من عز مطلبه إني أفاديك يا من عز مطلبه % % بالنفس والمال والأهلين والولد % 2(@)(@@) % قل المساعد إذ عزت مطالبكم % % على الشهود وما بالربع من أحد % % 3(@)(@@) % سواك فانظر فما أبصرت من أحد % % إلا وأنت له ظل بلا جد % PageV01P309 البحر : طويل 1(@)(@@) % ألا إنه الفرقان عين وجودي % % وإن كان قرآنا فذاك شهودي % % 2(@)(@@) % زبور وتوراة وإنجيل مهتد % مسيح وقرآن صريح وجودي % % 3(@)(@@) % تعاليت أنت الله في كل صورة % تجلت بلا ستر لعين مريد % 4(@)(@@) % وقد شهدت عندي بذاك مسامعي % % من ألفاظ معصوم بحبل وريد % 5(@)(@@) % فما العالم المنعوت بالنقص كائن % ولكنه نقص بغير مزيد % % 6(@)(@@) % فما نظرت عيني مليكا مسودا % تجلى لمملوك بنعت مسود % % 7(@)(@@) % سواه ولكن فيه للقلب نظرة % % إذا هو حلاه بنعت عبيد % 8(@)(@@) % فأخبرت عن قرب بما أنا شاهد % % وإن كنت فيما قلته ببعيد % 9(@)(@@) % فبعدي به قرب إليه وقربنا % % هو البعد إذ كان الوجود شهيدي % % 10(@)(@@) % وما أنا معصوم ولست بعاصم % إذا طلعت شمسي بنجم سعودي % % PageV01P310 11(@)(@@) % ولو كنت معصوما لما كنت عارفا % وإني لعلام به وبجودي % % 12(@)(@@) % كما جاءنا نص الكتاب مخبرا % بغفران ذنب المصطفى بقيود % PageV01P311 البحر : طويل 1(@)(@@) % يقولون أنت الحق بل أنا خلقه % % ولو كنت حقا لم يكن ببعيد % 2(@)(@@) % فإني مشهود وحكمي قاصر % وإن كان عين الحق عين وجودي % % 3(@)(@@) % وحكمي عليه نافذ غير قاصر % وعين وجود الحق عين شهودي % % 4(@)(@@) % ولست بخلاق ولست بفاجر % إذا كان لي كن واستمر قصودي % % 5(@)(@@) % ومهما يفو سمعي فإني سامع % لما أوردوه فالورود ورودي % % 6(@)(@@) % وما أنا علام ولست بجاهل % إذا كان مشهودي بحيث شهودي % % 7(@)(@@) % وما أنا حي ولا 