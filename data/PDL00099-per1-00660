ms641	 عاجزی از مالش موری اگرچه قادری %~% کز دو تار مو نمایی بر سر شیران لجام(@)(@@) 31 برگها با نظم می‌رویند از اطراف شاخ %~% نوبهار عدلت از بس داده‌گیتی را نظام(@)(@@) 32 مهر تو در هیچ دل نگذاشت جای آرزو %~% بسکه شادی بر س شادی همی جست ازدحام(@)(@@) 33 زر ز جودت خوار شد چندانکه زال زر ز خشم %~% زانزجار این لقب نفرین‌کند بر جان سام(@)(@@) 34 صاحبا صدرا حدیثی طرفه دارم‌گوش‌کن %~% زار و پژمان زال زر را دوش دیدم در منام(@)(@@) 35 گفتمش زار از چه‌ای‌‌گفتا شنیدستم‌که زر %~% از سخای خواجه شد چون خاک ره بی‌احترام(@)(@@) 36 وینک اندر دخمه تاری ز ننگ این لقب %~% هر زمان از خشم نفرینها کنم بر جان سام(@)(@@) 37 بر کمال قدرت یزدان بس این برهان تو %~% بر یکی مسندکنی جا با دو عالم احتشام(@)(@@) 38 فقر را زافراط جودت بر گلو گیرد فواق %~% خلق را از بوی خلقت در مشام افتد زکام(@)(@@) 39 تا حکیمان را حکایت از حدوثست و قدم %~% تا فقیهان را روایت از حلالست و حرام(@)(@@) 40 ناصرت بادا شهنشه یاورت بادا خدای %~% کشورت بادا به فرمان اخترت بادا به ‌کام PageV1P308(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای رخش ره‌نورد من ای اسب تیزگام %~% تا چند بند آخوری آخر برون خرام(@)(@@) 2 کاه خسان چه می‌خوری ای رخش ره‌نورد %~% بار خران چه می‌بری ای اسب تیزگام(@)(@@) 3 هرگز نبوده آب تو از منهل خسان %~% هرگز نبوده‌ کاه تو از آخور لئام(@)(@@) 4 ده ماه شد که خوی‌ گرفتی به نای و نوش %~% وندر طویله خوردی و خفتی علی‌الدوام(@)(@@) 5 هر شام داده‌ کاه و جوت را به امتنان %~% هر روز شسته یال و دمت را به احترام(@)(@@) 6 ای بس‌که آب دادم و تیمارکردمت %~% نه زبن زدم به پیشت و نه بر بستمت لجام(@)(@@) 7 آبت ‌گهی ز چاه ‌کشیدم‌ گهی ز جوی %~% کاهت ‌گهی به نقد گرفتم‌ گهی به وام(@)(@@) 8 هرگز 
ms642	 به تازیانه بنشخودمت سرین %~% وز چنبر چدار نیفکدمت به دام(@)(@@) 9 گاهت به‌گاه دادم و آب و علف به وقت %~% غافل نبودم از تو به یک عمر صبح و شام(@)(@@) 10 یک‌یک حقوق رفته اگر بازگویمت %~% حالی فروچکد عرق شرمت از مسام(@)(@@) 11 تازی نژاد اسب من آخر حمیتی %~% یک ره چو تازیان به حمیت برآر نام(@)(@@) 12 چون شد حمیت عربی‌کت ز پیش بود %~% ز اصطبل سر برآر چو شمشیر از نیام(@)(@@) 13 خیز ای سیاه‌روی ترا ز رخش روستهم %~% از سم بسای مردمک دیده خصام(@)(@@) 14 اسبا حقوق من به عقوق ار بدل ‌کنی %~% ترسم ‌که روزگار کشد از تو انتقام(@)(@@) 15 اسبا زمان یاری و هنگام یاوریست %~% لختی برون خرام و مکن رنج من حرام(@)(@@) 16 از سم ره‌نورد بجنبان همی زمین %~% وز نعل خاره‌کوب بسنبان همی رخام(@)(@@) 17 برزن خروش تا بمرد مار در شکفت %~% برکش صهیل تا برمد شیر درکنام(@)(@@) 18 از دم به چشم شیر فلک در فکن غبار %~% از سم به جسم ‌گاو زمین برشکن عظام(@)(@@) 19 اسباگرم ز پارس رسانی به ملک ری %~% زرین‌ کنم رکابت و سیمین‌ کنم ستام(@)(@@) 20 از حلقه ستاره همی سازمت رکیب %~% وز رشته مجره همی آرمت لجام(@)(@@) 21 میخت‌کنم ستاره و نعلت‌کنم هلال %~% زینت ز زر پخته ستامت ز سیم خام(@)(@@) 22 هم پای‌بند بافمت از ریش ابلهان %~% هم پاردم نمایمت از سبلت عوام(@)(@@) 23 تو زیر رانم آیی چون زیر ابرکوه %~% من بر تو خود نشینم چون بر سمند سام(@)(@@) 24 از پارس بهر کسب معالی سفرکنم %~% راحت ‌کنم حرام‌ که حاصل شود مرام(@)(@@) 25 هم چهره ستاره برندم به نوک تیر %~% هم‌گردن زمانه ببندم به خم خام(@)(@@) 26 گه چون‌ عجم به‌دست همی چین کنم‌کمند %~% گه چون عرب به چهره همی برنهم لثام(@)(@@) 27 اقبال و بخت و عز و معالی به‌گرد من %~% از چارسو بجهد همی جوید ازدحام(@)(@@) 28 حیرت ‌کند ز جنبش 
ms643	 من در هوا عقاب %~% غیرت برد به رحمت من در زمین هوام(@)(@@) 29 قانع شوم به بیش وکمی‌کم دهد خدای %~% راضی شوم به خیر و شری ‌کاید از انام(@)(@@) 30 بر دهر سخره رانم چون رند بر فقیه %~% بر مرگ حمله آرم چون باز بر حمام(@)(@@) 31 نفرین‌ کنم به پارس‌ که از ساکنان او %~% واصل نگشت نعمت و حاصل نگشت کام(@)(@@) 32 نه ریش‌ کس ز مرهمشان جسته اندمال %~% نه زخم ‌کس ز داروشان دیده التیام(@)(@@) 33 همواره در شقاق و ستمشان مدار سیر %~% پیوسته در نفاق و جفاکرده اقتحام(@)(@@) 34 چون‌ من ‌کسی به ‌ساحت آن‌خوار و مستمند %~% چون من ‌کسی به عرصه آن زار و مستهام(@)(@@) 35 میران آن به‌ گاه تواضع چنان ثقیل %~% کز جا قیامشان ندهد دست تا قیام(@)(@@) 36 جز باد عجبشان ندمد هیچ در دماغ %~% جز بوی‌ کبرشان نرسد هیچ بر مشام(@)(@@) 37 جز چند تنگه از گهر پاک زاده‌اند %~% از دوده مکارم و از دوحه‌ کرام(@)(@@) 38 چون‌ لاله روز و شب همه با عیش و انبساط %~% چون غنچه دمبدم همه با وجد و ابتسام(@)(@@) 39 ژاژی ز هیچکس نشنیدم بجز مدیح %~% لغوی ز هیچیک نشنیدم بجز سلام(@)(@@) 40 بر من زحام آنان چون عام بر امیر %~% بر من هجوم ایشان چون خاص بر امام(@)(@@) 41 زان چند تن‌گذشته ملولم ز شیخ و شاب %~% زان چند تن‌‌ گذشته خمولم ز خاص و عام(@)(@@) 42 رنجی مرا کز ایشان ‌گر زانکه بشمرم %~% آن رنج ناشمرده سخن می‌شود تمام PageV1P309(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 بامدادان ‌کآ‌فتاب خاوری سر زد ز بام %~% ماهرویم بام را از عکس ‌گیسو کرد شام(@)(@@) 2 گه رخش دیدم به زیر زلف و گفتم این دمست %~% کآفتاب عالم‌آرا برکشد تیغ از نیام(@)(@@) 3 گه پریشان دیدمش زلفین و گفتم این زمان %~% چون شب تاریک عالم را فروگیرد ظلام(@)(@@) 4 نور صبح و نور رویش بسکه با هم بد قرین %~% من ‌ندانستم به 
ms644	 تحقیقی‌این کدامست آن کدام(@)(@@) 5 روی او بر قد او چون لاله‌یی بر شاخ‌ گل %~% خال او در زلف او چون دانه‌یی در زیر دام(@)(@@) 6 طره طرار او بر طرف خط مشکسای %~% طرفه‌ طوماریست‌ کز مشک ختن دارد ختام(@)(@@) 7 نام دلها کرده گویی ثبت در طومار زلف %~% کز سواد زلف‌ مشکینش جهان شد مشکفام(@)(@@) 8 نی خطا گفتم دلی را کاو به زلف اندر کشد %~% زو چو بدخواه شهنشه نی نشان ماند نه نام(@)(@@) 9 الغرض شادان رسید آن‌ماه و جان از خرمی %~% چون‌قدح‌خواری‌که‌ نو شدباده درعید صیام(@)(@@) 10 گفت ای راوی‌که شخص آفرینش سربسر %~% گوش گردد چون ‌صدف ‌هرگه گهر ریزی ز کام(@)(@@) 11 هیچ دانی‌ کز برای شهریار ملک جم %~% پیکی از شاه عجم هم خلعت آرد هم پیام(@)(@@) 12 قیمت هر تار از آن خلعت منال هندوچین %~% ارزش هر پود از آن کسوت خراج مصر و شام(@)(@@) 13 گفتم‌آری چون‌ندانم من ‌که در هرروز و شب %~% فکر شه بر جای فکرت بر ضمیرم مستدام(@)(@@) 14 گفت برگو خدمتی شایسته از طبع سلیم %~% تا برای تهنیت‌خوانی به هنگام سلام(@)(@@) 15 گفتم‌اینک گوش بگشا بشنو این شیوا سخن %~% کز شمیم نغز او مغز خردگیرد زکام(@)(@@) 16 زان سپس خواندم برش این شعر را کز شرم او %~% خون‌به‌جای‌خون‌چکد اهل‌خرد را از مسام PageV1P310(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 حبذا زین جشن فرخ مرحبا زین عید عام %~% کاندرو شادی حلالست ‌اندرو اندوه حرام(@)(@@) 2 لوحش ‌الله ‌جان ‌به ‌وجد آید همی ‌زین ‌جشن خاص %~% بارک‌الله دل به‌رقص آید همی زین عید عام(@)(@@) 3 مقدم این جشن فرخ باد یارب بر امم %~% غره این عید میمون باد یارب بر انام(@)(@@) 4 نام این جشن همایون می‌بماند جاودان %~% رسم این عید مبارک می‌بپاید مستدام(@)(@@) 5 ازکجا این جشن ‌دلکش ‌را به ‌چگ ‌آمد عنان %~% و زکجا این عید فرخ را به‌دست آمد زمام(@)(@@) 6 عامی‌از یکسو به‌وجد و عارف از یکسو به رقص %~% عشرت 
ms645	 این برقرار و شادی آن بر دوام(@)(@@) 7 خصم نافر غم مسافر عیش وافر رنج کم %~% شادی‌افزون فال‌میمون ملک‌مامو‌ن بخت‌رام(@)(@@) 8 هر تنی از خوشدلی چون شاخ گل در اهتزاز %~% هر لبی از خرمی چون جام مل در ابتسام(@)(@@) 9 هرکجا دلداده‌یی با دلبری ‌گوید حدیث %~% هرکجا آزاده‌یی با بیدلی راندکلام(@)(@@) 10 آن به نزد این نیاز آرد چو بلبل پیش‌ گل %~% وین به نزد آن نماز آرد چو مینا پیش جام(@)(@@) 11 از طرب هر بنده‌ای‌را خنده‌ای‌بینی‌به لب %~% وز فرح هر زاهدی را شاهدی یابی به‌کام(@)(@@) 12 خرمی در هردلی‌مضمر چو شادی‌در شراب %~% خوشدلی‌درهر تنی‌مدغم‌چومستی‌از مدام(@)(@@) 13 از نثار لعل و گوهر دشت چون دست‌ کریم %~% وز بخور عود و عنبرکوی‌چون خوی‌کرام(@)(@@) 14 نسپری‌جز فرش دیبا نشنو‌ی‌جز بانگ‌چنگ %~% ننگری جز روی زیبا نشمری جز سیم خام(@)(@@) 15 رنجهاشدجمله‌گنج‌و عسرهاشدجملهسر %~% جنگهاشد جمله‌صلح‌و ننگها شدجمله نام(@)(@@) 16 عشرت‌آمد جای‌عسرت‌تازه‌شد بخت‌کهن %~% رحمت‌آمد جای‌زحمت پخته‌گشت‌امید خام(@)(@@) 17 درخروشندی ‌وحوش ‌و در سماعندی‌ سباع %~% در خیروندی طور و در سرودندی هوام(@)(@@) 18 شیخ و شاهد شوخ و زاهد رند و واعظ مرد و زن %~% زشت‌وزیبا پیر و برنا میر ومولا خاص ‌و عام(@)(@@) 19 جمله‌را در سر سرور و جمله‌را در تن‌سماع %~% جمله را دردم درود و جمله را بر لب سلام(@)(@@) 20 این اشارت‌ گوید آن‌ کامروز بختت‌ شد جوان %~% آن بشارت را بدین ‌کامروز کارت شد به‌کام(@)(@@) 21 خیلها چون سیلها افکند در هرسو خروش %~% فوجها چون موجها آورده از هر سو زحام(@)(@@) 22 سنجهای سنجری هرسو زشادی درخروش‌ %~% پیلهای هندوی هر سو ز عشرت در خرام(@)(@@) 23 جامهای‌خسروی‌در خنده‌چ‌رن‌برن‌از سحاب %~% کوسهای‌ کسروی در ناله چون رعد از غمام(@)(@@) 24 از خروش چنگ و مزهر گوش گردون را صمم %~% وز شمیم عود و عنبر مغزکیوان را زکام(@)(@@) 25 گو‌یی از شادی به رقص آمد همی ایوان و کوه %~% گو‌یی از عشرت به وجد آمد همی دیو‌ار و بام(@)(@@) 26 تا شهی را 
ms646	 تهنیت‌ گویندکز روی شرف %~% آسمان جوید به ذیل اصطناعش‌ اعتصام(@)(@@) 27 شاه‌فرخ‌رخ‌فریدون‌ماه‌شیر اوژن که هست %~% ملک هستی را ز حزم پیش‌بینش انتظام(@)(@@) 28 تهنیت رانند او را بر همایون خلعتی %~% کش عنایت‌کرد شاهنشاه ‌گردون احتشام(@)(@@) 29 بارک‌الله از مبارک پیکرش‌کاینک بر او %~% خلعت شه طلعت مه را همی‌داند ظلام(@)(@@) 30 خلعت دیبای او را اطلس چرخ آستر %~% طلعت زببای او را خواجه‌گردون غلام(@)(@@) 31 خلعتش شنعت فرستد بر که بر بدر منیر %~% طلعتش طیبت نماید بر که بر ماه تمام(@)(@@) 32 هم همایون خلعتش را لازم آمد اعتزاز %~% هم مبارک‌طلعتش را واجب آمد احترام(@)(@@) 33 ای فریدون‌فر خدیو راد کز اقبال تو %~% فارس شد دارالامان و دهر شد دارالسلام(@)(@@) 34 شیر را در عهد تو بیم هزالست از غزال %~% باز را در عصر تو خوف‌جمامست از حمام(@)(@@) 35 یازده ماهست شاها تا شهنشاه عجم %~% در هری از بدسگال خوبش جوید انتقام(@)(@@) 36 صارمش ‌در خون‌اعدا چون‌هلال اندر شفق %~% اشهبش ‌در گرد هیجا چون‌ سهیل اندر ظلام(@)(@@) 37 کفته داردکتف گردان هردم از خطی سنان %~% سفته‌دارد سفت نیوان هردم از تو زی سهام(@)(@@) 38 می‌نگوید ناله‌کوس است ای‌ن یا بانگ چنگ %~% می‌نپرسد زلف دلدارست این یا خم خام(@)(@@) 39 گه به یاد قامت شوخیش توصیف از سنان %~% گه به یاد ابروی ترکیش تعریف از حسام(@)(@@) 40 بسکه‌دشت‌از دود توپ‌باره‌کوبش تیره‌گون %~% بسکه راغ ازگرد خنگ ره‌نوردش قیرفام(@)(@@) 41 ای بسا روزاکه او را بازنشناسد ز شب %~% ای ‌بسا صبحاکه او را فرق نگذارد ز شام(@)(@@) 42 با چنین‌حالت‌که شخص‌از نام‌خودغافل شود %~% نامت آرد بر زبان پیوسته شاه نیکنام(@)(@@) 43 روز و شب چهر تو‌ گر‌دد در خیالش‌ مرتسم %~% سال و مه مهر تو جوید در ضمیرش ارتسام(@)(@@) 44 مر ترا بیند مشاهد هرکجا گردد مقیم %~% مر ترا بیند مقابل هرکجا سازد مقام(@)(@@) 45 نست ماهی‌کت به تشریفی نسازدکامران %~% نیست روزی ‌کت به تعریفی ندارد شادکام(@)(@@) 46 از هنرهای تو می گوید هرچه 
ms647	 می‌گوید حدیث %~% وز ظفرهای تو راند هرچه می‌راندکلام(@)(@@) 47 هم تواش الا به طاعت می‌نبردستی سجود %~% هم تواش الا به خدمت می‌نکردستی قیام(@)(@@) 48 صبح‌چون‌خیزی نیاری جز جمالش در ضمیر %~% شام چون خسبی نبینی جز خیالش در منام(@)(@@) 49 گر نظام لشکری خواهد نمایی امتثال %~% ور خراج‌ کشوری جوید فزایی اهتمام(@)(@@) 50 گه امیر لشکری‌ گه مرزبان‌ کشوری %~% گاه لشکر را نظامی‌ گاه‌کشور را قوام(@)(@@) 51 گاه بی‌سعی وزیری ملک را سازی قویم %~% گاه بی‌عون امیری جیش را بخشی نظام(@)(@@) 52 در بر پیلان به نوک تیغ بگسستی عروق %~% در بر شیران به زخم‌گرز بشکستی عظام(@)(@@) 53 ای بسا دشتا که در وی شیر ننهادی قدم %~% ای بسا کوها که در وی باز نگرفتی‌ کنام(@)(@@) 54 رفتی و نیوان سرکش را گلو خستی به تیغ %~% رفتی‌و دیوان ناخوش را فروبستی به دام(@)(@@) 55 ترکمانان سپاهت ترکمانان را ز بیم %~% کرده‌پیکرهمچودال‌وکرده‌قامت‌همچو لام(@)(@@) 56 تا صفت باشد خدای لاینام و لایزال %~% باد ملک لایزال و باد بختت لاینام PageV1P311(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 پگاه بام چو برشد غریو کوس از بام %~% شدم به جانب حمام با شتاب تمام(@)(@@) 2 پس از ورود به حمام عرصه‌یی دیدم %~% وسیع‌تر ز بیابان نجد و وادی شام(@)(@@) 3 نعوذ بالله حمام نه بیابانی %~% تهی ز امن و سلامت لبالب از دد و دام(@)(@@) 4 ز هرطرف متراکم درو وحوش و طیور %~% ز هرطرف متراخم درو سوام و هوام(@)(@@) 5 فضای تیره‌اش از بسکه پرنشیب و فراز %~% محال بود در آن بی‌عصا نهادن‌ گام(@)(@@) 6 خزینه چون ره مازندران پر ازگل و لای %~% جماعتی چو خراطین درو گزیده مقام(@)(@@) 7 ز گند آب‌که باج از براز می‌طلبید %~% تمام جسته صداع و تمام‌کرده ز کام(@)(@@) 8 تمام نیت غسل جماع‌کرده بدل %~% به غسل توبه‌که ننهند پا در آن حمام(@)(@@) 9 به صحن او که بدی پر ز شیر و ببر و پلنگ %~% ز خوف ‌جان ‌نشدی ‌شخص‌ بی‌سنان ‌و حسام 
ms648	(@)(@@) 10 زکثرت وزغ و سوسمار دیوارش %~% به دیدگان متحرک همی نمود مدام(@)(@@) 11 به نور خانه‌اش اندر جماعی همه عور %~% چو کودکی‌که برون آید از مشیمه مام(@)(@@) 12 قضیب در کف و از غایب برودتشان %~% بسان خایه حلاج رعشه در اندام(@)(@@) 13 ز بس که پرده ز عیب کسان برافکندی %~% کسی نیافت‌ که حمام بود یا نمام(@)(@@) 14 ستاده زنگیکی بدقواره تیغ به دست %~% به هم ‌کشیده جبن از غضب چوکف لئام(@)(@@) 15 به طرز صفحه مسطر کشیده تن لاغر %~% پدید چون خط مسطر همه عروق و عظام(@)(@@) 16 به دستش اندر طاسی به شکل‌کون و در او %~% چو قطره‌های منی برف می‌چکید از بام(@)(@@) 17 جبین‌ چو ریشه‌ حنظل سرین ‌چو شلغم خشک %~% بدن چو شیشه قطران لبان چو بلغم خام(@)(@@) 18 ز غبغب سیهش رسته مویهای سپید %~% چو بر دوات مرکب تراشه اقلام(@)(@@) 19 چو پنبه‌یی که به سوراخ است مرده نهند %~% پدید رسته دندانش از میانه کام(@)(@@) 20 ز فوطه نرم قضیبش عیان به شکل زلو %~% ولی به ‌گاه شبق سخت‌تر ز سنگ رخام(@)(@@) 21 به هرکجا که پریچهره دلبری دیدی %~% همی ز بهر تواضع ز جا نمود قیام(@)(@@) 22 سرش چو خواجه منعم فراز بالش نرم %~% ولی به خود چو مساکین نموده خواب حرام(@)(@@) 23 دو خایه از مرض فتق چون دو بادنجان %~% به زیر آن دو سیه‌چشمه‌یی چو شام ظلام(@)(@@) 24 ستاده بودم حیران‌که ناگه از طرفی %~% نگار من به ادب مر مرا نمود سلام(@)(@@) 25 پرند نیلی بربسته بر میان‌ گفتی %~% به چرخ نیلی مأوا گزیده ماه تمام(@)(@@) 26 ز پشت فوطه شده آشکار شق سرین %~% چو بدر کز دو طرف جلوه‌گر شود ز غمام(@)(@@) 27 بدیدم آنچه بسی سال عمر نشنیدم %~% که آفتاب نماید به زمهریر مقام(@)(@@) 28 خزینه شد ز تنش زنده‌رود آب زلال %~% ز لای و گل نه نشان ماند در خزینه نه نام(@)(@@) 29 چون جرم ماه ‌که روشن شود 
ms649	 ز تابش مهر %~% ز عکس رویش رومی شد آن سیاه غلام(@)(@@) 30 همه قبایح زنگی به حسن گشت بدل %~% شبان تیره بدل شد به صبح آینه‌فام(@)(@@) 31 فرشته‌گشت مگر زنگیک‌که عورت او %~% نهفته ماند ز ابصار بلکه از اوهام(@)(@@) 32 بلی چه مایه امور شنیعه در عالم %~% که ‌نغز و دلکش ‌و مستحسن است در فرجام(@)(@@) 33 مگر نه رجس و پلیدست نطفه در اصلاب %~% مگر نه زشت و کثیفست مضغه در ارحام(@)(@@) 34 یکی شود صنمی جانفزای در پایان %~% یکی شود قمری دلربای در انجام(@)(@@) 35 مگر نه فتنه طوفان به امن گشت بدل %~% چو برکمبنه جودی سفعنه جست آرام(@)(@@) 36 مگر ‌نه آدم خاکی چو در وجود آمد %~% تهی ز فرقت جن ‌گشت ساحت ایام(@)(@@) 37 مگر نه‌ دوست چو بخشد عسل‌ شود حنظل %~% مگرنه یار چو گوید شکر شود دشنام(@)(@@) 38 مگرنه نور وجودات بزم عالم را %~% خلاص‌کرد ز چنگال ظلمت اعدام(@)(@@) 39 مگر نه ‌گشت همه رسم جاهلیت طی %~% ز کردگار چو مبعوث شد رسول انام(@)(@@) 40 سحر چو گشت پدیدار روز گردد شب %~% شفق چو گشت نمودار صبح گردد شام(@)(@@) 41 گر این قصیده دلکش به‌ کوه برخوانی %~% صدا برآید کاحسنت ازین بدیع ‌کلام PageV1P312(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 بود مبارک هر عید خاصه عید صیام %~% به غوث ملت اسلام تا به روز قیام(@)(@@) 2 خجسته خواجه ایام حاجی آقاسی %~% که مبتدای وجودست و مقتدای انام(@)(@@) 3 محققی ‌که ضمیرش به حزم پیش نگر %~% همه ضمایر اطفال دیده در ارحام(@)(@@) 4 مداد خامه او چشم جود را سرمه %~% سطور نامه او شخص فضل را اندام(@)(@@) 5 رسیده است به جایی نفوذ قدرت او %~% که جاکند عوض مغز در درون عظام(@)(@@) 6 ز امن عهدش آهو همی به ‌گاه چرا %~% ز لاله باز نداند دو دیده ضرغام(@)(@@) 7 به‌گاه هیبت او آفریدگان همه را %~% روان و زهره برآید به جای خون ز مسام(@)(@@) 8 بساط جود بدانگونه همش‌گسترد 
ms650	 %~% که منقبض نشود عرق بر جبین لئام(@)(@@) 9 هر آنچه از دو لب پاک او برون آمد %~% همان بود که بدو کرده کردگار الهام(@)(@@) 10 سلام و نفرین درگفت ‌کردگار بسیست %~% سخن چو هست بحق چه دعا و چه دشنام(@)(@@) 11 بسا رضا که هم از خشم او پدید آید %~% چنانکه چشمه شیرین برون جهد ز رخام(@)(@@) 12 ثنای او نبود حد ما که نشناسد %~% مقام روح قدس را عوام ‌کالانعام(@)(@@) 13 کنون به آنکه سرایم حدیث قصه دوش %~% در آن زمان‌ که سپردم به دست عقل زمام(@)(@@) 14 به عقل ‌گفتم ‌کای اولین نتیجه عشق %~% که بادپای سخن راست درکف تو لگام(@)(@@) 15 تو دانی آنکه بود عید و خواجه را شعرا %~% برند مدح بهر عید خاصه عید صیام(@)(@@) 16 مرا که آتش دل مرده ز آب ‌کید حسود %~% حدیث پخته چسان خیزد از قریحه خام(@)(@@) 17 به خنده گفت بلی دانمت ز نشتر غم %~% دلیست ممتلی از خون چو شیشه حجام(@)(@@) 18 ولی به دفتر شعرت قصده‌ ییست بدیع %~% که‌گفته‌یی به مدیح رسول و آل‌کرام(@)(@@) 19 ز دیرباز بود ناتمام و همت تو %~% پی تمامی او هیچگه نکرد اقدام(@)(@@) 20 به عون حواجه چه باشد گرش تمام‌ کنی %~% که شد نقایص هستی همه ز خواجه تمام(@)(@@) 21 بگفتم ‌آن‌ چه قصده‌است ‌و چیست‌ مطلع او %~% چه وزن دارد و او را روی و ردف ‌کدام(@)(@@) 22 بگفت بر نمط این قصده است درست %~% خجسته مطلعش این است ای ادیب همام PageV1P313(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 به‌ گاه بام‌ که خورشید چرخ آینه‌ فام %~% زدود زاینه روزگار زنگ ظلام(@)(@@) 2 درآمد از درم آن‌گلعذار وز رخ و زلف %~% نهفته طلعت خورشید را به ظلمت شام(@)(@@) 3 نهاده سلسله بر دوش کاین مرا طره %~% نهفته سیم در آغوش کاین مرا اندام(@)(@@) 4 گسسته رشته ‌گوهر که این مراست سخن %~% فشانده خرمن شکر که این مراست ‌کلام(@)(@@) 5 ز جزع‌ گشته بلاخیز کاین 
