ms103	 المتوفى ١٤٥. تهذيب التهذيب ١: ١٨٩، ميزان الاعتدال ١: ٧٨، شذرات الذهب ١: ٢١٦.(@)(@@) (٢) مسند أحمد ١: ٩١، المستدرك ٢: ١٤٥، حلية الأولياء 4: 186.(@)(@@) (١) أسد الغابة ٢: ١٤٠، البداية والنهاية ٧: ٢٨٩.(@)(@@) (2) في رواية: وهو حرقوص بن زهير أصل الخوارج.(@)(@@) (3) في نسخة: وآية ذلك أن فيهم رجلا أسود مخدج اليد.(@)(@@) (١) ميزان الاعتدال ٢: ٢٦٣، أسد الغابة ٢: ١٤٠، مسند أحمد ٣: ٥٦.(@)(@@) (٢) الحرورية وهم الخوارج صاروا إلى قرية يقال لها حروراء بينها وبين الكوفة نصف فرسخ وبها سموا الحرورية، ورئيسهم عبد الله بن وهب الراسبي وابن الكوا وشبث بن ربعي. تاريخ اليعقوبي ٢: ١٦٧، مروج الذهب ٢: ٣٩٥ وكانوا اثنا عشر ألفا من القراء وغيرهم وذلك بعد وقعة صفين والتحكيم.(@)(@@) (٣) البداية والنهاية ٧: ٢٩١، وفيه: زاد يونس في روايته قال بكير، وحدثني رجل عن ابن حنين أنه قال: رأيت ذلك الأسود.(@)(@@) (١) المستدرك ٢: ١٤٨، مسند أحمد ٤: ٣٥٧، البداية والنهاية ٧: ٢٩٠.(@)(@@) (٢) تاريخ بغداد ١٣: ١٨٦.(@)(١) كنز العمال ٦، ٧٢. مجمع الزوائد ٩: ٢٣٥ وفيه: رواه البزار والطبراني في الأوسط، المستدرك ٢: ١٤٧.(@)(@@) (٢) أبو خداس مخلد بن يزيد القرشي الحراني. تهذيب التهذيب ١٠: ٧٧، رجال الصحيحين ٢: ٥٠٧، تقريب التهذيب ٢: ٢٣٥ (٣) المخدج: بضم الميم وسكون الخاء ثم الدال المهملة المفتوحة ثم الجيم، هو ناقص اليد، قال ابن الأثير في النهاية: ومنه حديث ذي الثدية أنه مخدج اليد.(@)(@@) (٤) في رواية: شعرات بيض، وفي غيرها: حوله سبع هليات.(@)(@@) (٥) مسند أحمد ١: ٨٨، ٩١، سنن البيهقي ٨: ١٧٠.(@)(@@) (٦) زيد بن وهب الجهني الكوفي مات ٩٦. تهذيب التهذيب ٣: ٤٢٧، أعيان الشيعة 33: 154.(@)(@@) (١) بياض في الأصل.(@)(@@) (٢) تاريخ بغداد ٧: ٢٣٧، المناقب لابن شهرآشوب ٣: ١٩١، أعيان الشيعة ٣٣، ١٥٦، البداية والنهاية ٧: ٢٨٩.(@)(@@) (١) مسند أحمد ١: ٩١، فضائل الخمسة ٢: ٤٠٣ وفيه: فقام إليه عبيدة السلماني فقال: يا أمير المؤمنين الله الذي لا إله إلا هو لسمعت هذا الحديث من رسول الله صلى الله عليه وآله، قال: إي والله الذي لا إله إلا هو، حتى استحلفه ثلاثا وهو يحلف له.(@)(@@) (٢) تاريخ بغداد ١: ١٦٠ بصورة مفصلة، مسند أحمد 1: 88.(@)(@@) (١) تاريخ بغداد ٧: ٢٣٧ رواه عن جابر أبو خالد التابعي الكوفي وأنه شهد وقعة النهروان مع الإمام أمير المؤمنين ع وفي ج 1: 159 روى بسنده عن نبيط بن شريط الأشجعي قال الحديث.(@)(@@) (١) الصحيح: عبيدة بن عمرو ويقال ابن قيس بن عمرو السلماني مات سنة ٧٢ / ٧٣ / ٧٤. تهذيب التهذيب ٧: ٨٤، اللباب ١: ٥٥٢، رجال الصحيحين ١: ٣٣٦، أسد 
ms104	 الغابة ٣: ٣٥٦.(@)(@@) (٢) مسند أحمد ١: ٨٨، ٩١، سنن البيهقي ٨: ١٧٠، صحيح أبو داود:(@)(@@) ٣٠ باب قتال الخوارج صحيح مسلم البداية والنهاية ٧: ٢٩٠.(@)(@@) (3) مسند أحمد 1: 78، ورواه أئمة الحديث بطرق مختلفة في باب التحريض على قتل الخوارج.(@)(@@) (١) في رواية صحيح مسلم، بما وعد الله الذين يقتلونهم على لسان محمد صلى الله عليه وآله.(@)(@@) (٢) فضائل الخمسة ٢: ٤٠٢ نقلا عن صحيح مسلم في كتاب الزكاة باب التحريض على قتل الخوارج.(@)(@@) (٣) في رواية: لأنبأتكم.(@)(@@) (٤) حلية الأولياء ٤: ١٨٦ بسنده عن زر بن حبيش، وقد جمع ابن كثير في البداية والنهاية طرق هذا الحديث مفصلة وأوردها على التفصيل كما في ج 7:(@)(@@) (289 - 294).(@)(@@) (١) سماك بن الوليد الحنفي اليماني سكن الكوفة. تهذيب التهذيب ٤: ٢٣٥، الكنى ١: ١٨٣.(@)(@@) (٢) سورة الأنعام: ٥٧.(@)(@@) (3) في رواية: من إمرة المؤمنين.(@)(@@) (١) سورة المائدة: ٩٥.(@)(@@) (٢) سورة النساء: ٣٥.(@)(@@) (٣) سورة الأحزاب: ٦.(@)(@@) (١) المناقب لابن شهر أشوب ١: ٢٦٧، البداية والنهاية ٧: ٢٧٦، ٢٨١، تاريخ اليعقوبي ٢: ١٦٧.(@)(@@) (٢) كانت عمرة الحديبية سنة ٦ في ذي القعدة، فخرج النبي صلى الله عليه وآله معتمرا لا يريد حربا، الكامل ٢: ١٣٥، المناقب لابن شهرآشوب ١: ٢٢.(@)(@@) (٣) الكامل ٢: ١٣٨، البداية والنهاية ٤: ١٦٤.(@)(@@) (١) البداية والنهاية ٤: ١٦٨، سيرة ابن هشام 3: 331 وفيه: ثم دعا رسول الله صلى الله عليه وآله علي بن أبي طالب رضوان الله عليه، فقال: اكتب: بسم الله الرحمن الرحيم الحديث.(@)(@@) (2) في رواية: فقال: أنا والله محمد بن عبد الله، وأنا والله رسول الله.(@)(@@) (3) في رواية البخاري هكذا: قال صلى الله عليه وآله: فأرنيه، قال: فأراه إياه فمحاه النبي صلى الله عليه وآله بيده.(@)(@@) (١) في رواية: فقالوا: مر صاحبك فليرتحل، فذكر ذلك لرسول الله صلى الله عليه وآله فقال: نعم ثم ارتحل.(@)(@@) (٢) تاريخ بغداد ٤: ١٤٠، سنن البيهقي ٨: ٥، مسند أحمد ١: ٩٨، المستدرك ٣: ١٢٠، مشكل الآثار 4: 173، الرياض النضرة 2: 191، فضائل الخمسة 2: 333 - 336.(@)(@@) وقد رواه أيضا القاسم بن يزيد المخزومي، عن إسرائيل، عن أبي إسحاق عن هبيرة بن مريم وهانئ بن هانئ، عن علي ع قال: لما صدرنا من مكة إذا ابنة حمزة تنادي الحديث، وقد مرت الإشارة إليه ص 88 - 89 وترجمنا رجاله وصححنا سنده على اختلاف الروايات.(@)(@@) (١) المستدرك ٣: ٢١١، وذكره الذهبي في التلخيص عن الدراوردي، عن ابن الهاد، عن محمد بن نافع بن 
ms105	 عجير، عن أبيه، عن علي الحديث، وجاء ذكر الحديث أيضا في 3: 120 من المستدرك وفيه: هذا حديث صحيح الإسناد ولم يخرجاه بهذا اللفظ إنما اتفقا على حديث أبي إسحاق عن البراء مختصرا.(@)(@@) وقد أجمعت المصادر على أن عليا " ع " كان كاتب الصحيفة يوم الحديبية وفي الرياض النضرة 2: 191، قال معمر: سألت عنه الزهري فضحك أو تبسم وقال: علي، ولو سألت هؤلاء لقالوا: هو عثمان - يعني بني أمية - مع العلم أن النبي صلى الله عليه وآله لم يشهده حتى على الصلح كما في سيرة ابن هشام 3: 333.(@@) 
ms106	