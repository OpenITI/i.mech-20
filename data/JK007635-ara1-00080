ms61	 طواويس % 6(@)(@@) % على كل فتلاء المرافق هودج % تقيس به في حسنه عرش بلقيس % % 7(@)(@@) % حوى قمرا من دونه ليل عثير % وظبي كناس دونه ليث عريس % % 8(@)(@@) % إذا رق لي مما أقاسي صبابة % تنمر لي من قومه كل غطريس % 9(@)(@@) % وإن قلت عج بي قال عجبي يصدني % % فيبدي بديع الحسن أحسن تجنيس % 10(@)(@@) % وكم عاذل فيه ينمق عذله % % وواش يشي تنميس إفك بتدليس % PageV01P216 11(@)(@@) % فلله قلب لا يزال معذبا % بتنميق عذل في الغرام وتنميس % % 12(@)(@@) % ولم أنس أياما نعمت بقربه % % وغيسان عمري منه في نعم عيس % % 13(@)(@@) % وليلة أنس للوصال كأنما % % تزين ثغر الدهر منها بتلعيس % % 14(@)(@@) % تجلى فجلى للندامى ظلامها % % ببكر مدام لا تعاب بتعنيس % 15(@)(@@) % سلاف كست ضوء البدور كؤوسها % % وبزت ضياء الشمس في حال تشميس % 16(@)(@@) % إذا افتر للندمان ثغر حبابها % % يقابل منها البشر كل بتعبيس % 17(@)(@@) % عمرنا بها ربع السرور ولم نزل % نؤسس بنيان الهوي أي تأسيس % % PageV01P217 البحر : طويل 1(@)(@@) % أما والشفاه اللعس والأعين النعس % % لقد جبلت طبعا على حبها نفسي % % 2(@)(@@) % يؤنبني اللوام فيها سفاهة % ولا وحشتي للائمين ولا أنسي % % 3(@)(@@) % يقولون قد غاليت في عشقك الدمى % % وهل مشتر للحسن بالثمن البخس % 4(@)(@@) % وبي من إذا ما رنحت عطف قدها % % فما رنحت إلا قضيبا على دعس % % 5(@)(@@) % وإن نشرت يوما ذوائب فرعها % % فما نشرت إلا ظلاما على شمس % 6(@)(@@) % تقول إذا ما جردت سيف لحظها % % خذوا حذركم يا معشر الجن والانس % % 7(@)(@@) % جنيت ثمار الوصل من روض حسنها % % ففزت بحلو المجتنى طيب الغرس % 8(@)(@@) % وكم ليلة عرست فيها بربعها % % ففاقت بطيب الملتقى ليلة العرس % % 9(@)(@@) % ونادمتها قبل المزاج وبعده % % بحمراء مثل الورد صفراء كالورس % % PageV01P218 البحر : كامل تام 1(@)(@@) % وافاك نشوان المعاطف ناشي % % في الحسن مسكي الأديم نجاشي % % 2(@)(@@) % وسرى إليك مع الهوى متأنسا % من غير ما فرق ولا استيحاش % 3(@)(@@) % وأتاك في جنح الظلام تحرجا % من أن يساير ظله ويماشي % % 4(@)(@@) % والأفق قد نظم النجوم قلائدا % وكسا الدجى بردا رقيق حواش % 5(@)(@@) % في ليلة بسنى الوصال 
ms62	 منيرة % حسد الصباح لها الظلام الغاشي % % 6(@)(@@) % قصرت ورق أديمها حتى لقد % % أربت نواشيها على الأغباش % % 7(@)(@@) % أسررت زورته ولولا نشره % % ما كان سر للنسائم فاش % 8(@)(@@) % حتى إذا طاب اللقاء وسكنت % % أنفاسه نفسي وروعة جاشي % % 9(@)(@@) % وسدته زندي وأفرش زنده % % خدي وبتنا في ألذ معاش % % 10(@)(@@) % لولا خفوق جوانحي لفرشتها % % لمبيته وطويت عنه فراشي % % PageV01P219 11(@)(@@) % وغدا يعاتبني عتابا زانه % % دل بلا هجر ولا إفحاش % % 12(@)(@@) % ورشفت من فيه البرود سلافة % أروت بنشوتها غليل عطاشي % % 13(@)(@@) % وبدا الصباح فقام ينقض ذيله % % أسفا ويجهش أيما إجهاش % % 14(@)(@@) % ودعته والدمع من جفني ومن % % جفنيه يمزج وابلا برشاش % 15(@)(@@) % ما كان أشرق ضوءها من ليلة % حضر الحبيب بها وغاب الواشي % % PageV01P220 البحر : بسيط تام 1(@)(@@) % للريح في وجنات الورد تخميش % وللصبا بغصون البان تحريش % % 2(@)(@@) % والنهر قد نقشته السحب من طرب % كأنه معصم بالدر منقوش % % 3(@)(@@) % والروض بالزهر منضود يروق لنا % % كأنه مجلس للصحب مفروش % % 4(@)(@@) % وثغر نور الأقاحي فيه مبتسم % وطرف نرجسه للهو مدهوش % 5(@)(@@) % وطرة الآس ما بين الرياض لها % % لما تلاعبت الأغصان تشويش % % 6(@)(@@) % والورود تنشره ريح الصبا سحرا % كأنه عارض باللثم مخدوش % % 7(@)(@@) % والطير فوق غصون البان عاكفة % كأنما خانها خوف النوى ريش % 8(@)(@@) % والدهر يضحك من ضحك الكؤوس به % % وللمدام به لعب وتجميش % % 9(@)(@@) % وأفقنا بلآلي الغيث متشح % وقطرنا بمياه القطر مرشوش % 10(@)(@@) % ونحن في مجلس راقت محاسنه % % فيه الرقيب عم والواشي أطروش % % PageV01P221 11(@)(@@) % فلا تسل عن لبانات به قضيت % % فليس يحسن عنها اليوم تفتيش % % PageV01P222 البحر : كامل تام 1(@)(@@) % أما الصبوح فإنه فرض % فالام يكحل جفنك الغمض % % 2(@)(@@) % هذا الصباح بدت بشائره % % ولخيله في ليله ركض % % 3(@)(@@) % والليل قد شابت ذوائبه % % وعذاره بالفجر مبيض % % 4(@)(@@) % فانهض إلى حمراء صافية % قد كاد يشرب بعضها البعض % 5(@)(@@) % يسقيكها من كفه رشأ % لدن القوام مهفهف بض % % 6(@)(@@) % سيان خمرته وريقته % % كلتاهما عنبية محض % 7(@)(@@) % تدمي اللواحظ خده نظرا % فاللحظ وجناته عض % % 8(@)(@@) % من ضمه فتح السرور له % % بابا وكان لعيشه الخفض % 9 
ms63	(@)(@@) % باهت - وقد أبدى محاسنه - % بدر السماء بحسنه الأرض % % 10(@)(@@) % يسعى بها كالشمس مشرقة % للعين عن إشراقها غض % PageV01P223 11(@)(@@) % والكأس إذ تهوي بها يده % نجم بجنح الليل منقض % % 12(@)(@@) % بات الندامى لا حراك بهم % % إلا كما يتحرك النبض % % 13(@)(@@) % في روضة يهدي لنا شقها % % أرج الحبائب زهرها الغض % 14(@)(@@) % ختم الحيا أزهارها فغدا % % بيد النسيم لختمها فض % 15(@)(@@) % فاشرب على حافاتها طربا % وانهض لها إن أمكن النهض % % 16(@)(@@) % لا تنكرن لهوي على كبري % % فعلي من عصر الصبا قرض % 17(@)(@@) % أغرى العذول بلومه شغفي % % فكأنما إبرامه نقض % % 18(@)(@@) % خالفته والرأي مختلف % شأني الوداد وشأنه البغض % 19(@)(@@) % مهلا فليس على الفتى دنس % في الحب ما لم يدنس العرض % PageV01P224 البحر : طويل 1(@)(@@) % سرت موهنا والنجم في أذنها قرط % % وعقد الثريا في مقلدها سمط % 2(@)(@@) % هلالية يعلو الهلال جبينها % % وعليا هلال حين تعزى لها رهط % 3(@)(@@) % ألمت بنا والليل مرخ سدوله % فضاء بصبح ميط عن نوره المرط % % 4(@)(@@) % وأرج أرجاء الحمى نشر طيبها % % قلم يدر مسك ما تضوع أم قسط % % 5(@)(@@) % وقد أقبلت ترنو بمقلة مغزل % أضلت بجرعاء الحمى شادنا ت % % 6(@)(@@) % ميل كما مال النزيف كأنما % % يرنحها من راح صرخد إسفنط % 7(@)(@@) % وتخطر تيها حين تخطو تأودا % بأسمر مما أنبت الله لا الخط % 8(@)(@@) % تجل عن التشبيه في الحسن غادة % إذا قيس في أوج بها البدر ينحط % % 9(@)(@@) % وأنى يضاهيها الحسان وإنما % % لها تسع أقساط البها ولم قسط % % 10(@)(@@) % وإن قيل إن الريم يحكي لحاظها % % فأين القوام اللدن والشعر السبط % PageV01P225 11(@)(@@) % على أن مرعاها وما صوح الكلا % % حشاشة نفس لا الأراك ولا الخمط % 12(@)(@@) % وتسطو أسود الغاب بالريم جهرة % وهذي بآساد الشرى أبدا تسطو % % 13(@)(@@) % بنفسي فتاة تغبط الشمس حسنها % % وفي مثل هذا الحسن يستحسن الغبط % 14(@)(@@) % لها طرة تضفو على صبح غرة % % يساقط مسكا من غدائرها المشط % % 15(@)(@@) % شفعت بها ليلا تقاصر وهنه % % فطال وللآمال في طوله بسط % 16(@)(@@) % وبتنا على رغم الحسود وبيننا % % حديث رضا بالوصل ما شابه سخط % % 17(@)(@@) % تعللني من 
ms64	 دلها ورضا بها % % بخمرين لم أسكر بمثلهما قط % % 18(@)(@@) % وعاطيتها صرفا حكت دم عاشق % مراقا عليه من مدامعه نقط % 19(@)(@@) % فمالت ولم تسطع حراكا كأنما % % أتيح لها من عقد أحبولة نشط % 20(@)(@@) % هناك جنيت الوصل من ثمر المنى % % وبت ولا عهد علي ولا شرط % % PageV01P226 21(@)(@@) % أمزق جلباب العفاف ولم أزل % % أقلبها حتى التقى الحجل والقرط % 22(@)(@@) % فلم تصح إلا والنجوم خوافق % وفرع الدجى جعد ذوائبه شمط % % 23(@)(@@) % وقد ضاء مسود الظلام بشمعة % من الصبح لم يعوز ذبالتها قط % % 24(@)(@@) % فقامت لتوديعي بوجد مروعة % وللوجد في جنبي من لوعة فرط % 25(@)(@@) % وأذرت دموعا من لحاظ سقيمة % هي الدر لكن ما لمنثوره لقط % 26(@)(@@) % وسارت على اسم الله تنقل أرجلا % إذا ما استقلت لا تكاد بها تخطو % % 27(@)(@@) % وشطت بقلبي في هواها ولم يزل % % ببحر غرام لا يرام له شط % 28(@)(@@) % وقد قدح التفريق بين جوانحي % % له كل آن في أجارعها سقط % 29(@)(@@) % نعم قد حلت تلك الليالي وقد خلت % وأي دنو لا يقارنه شخط % % 30(@)(@@) % لعمري لقد ألوت بأيام وصلنا % % حوادث أيام أساودها رقط % PageV01P227 31(@)(@@) % وبدلت عن قرب الوصال بخطة % من البين لا يمحى بدمعي لها خط % % 32(@)(@@) % تؤرقني الذكرى إذا لاح بارق % يلوح بفود الليل من لمعه وخط % 33(@)(@@) % وتوقظ مني الوجد ورق حمائم % % إذا هدأ السمار بات لها لغط % 34(@)(@@) % أبيت على مثل القتاد مسهدا % ومن دون ما أرجو القتادة والخرط % 35(@)(@@) % لئن جار دهري بالتنائي ولم يزل % % يجور علينا كل آن ويشتط % % 36(@)(@@) % فإني لها باق على العهد والوفا % % ولي من هيامي في الهوى شاهد قسط % 37(@)(@@) % وأصبو إلى دار بها حط أهلها % % عل أنهم من أجلها في الحشا حطوا % % 38(@)(@@) % ولو لم يكن سقط العقيق محلها % % لما شاقني وادي العقيق ولا السقط % % 39(@)(@@) % فيا ليت شعري هل رباها مريعة % كما هي أم ألوى بمخصبها قحط % 40(@)(@@) % وهل سربها يرعى بأكناف حاجر % مروجا عليها من نسيج الحيا بسط % % PageV01P228 41(@)(@@) % وه رتعت أترابها ولداتها % % بمرتعها حيث المسرة والغبط % % 42 
ms65	(@)(@@) % فعهدي بهاتيك المعاهد لم تزل % % شوادنها تعطو وأغصانها تغطو % % 43(@)(@@) % فلاغبها غاد من المزن رائح % له كل آن في أرجاعها سقط % % PageV01P229 البحر : طويل 1(@)(@@) % ظبى وسهام أم رنا ولحاظ % % عليها نفوس العاشقين تفاظ % 2(@)(@@) % وتلك رماح أم قدود موائس % وهيهات أعطاف الرماح غلاظ % 3(@)(@@) % وما عميت عن لينها عين كاشح % ولكن قلوب الكاشحين فظاظ % 4(@)(@@) % لعمري لو لم ترض نفسي بحبها % % لما كنت أرضى في الهوى وأغاظ % 5(@)(@@) % وإن فؤادي وهو شاك من الهوى % % ليثنيه عن نهج السلو حفاظ % 6(@)(@@) % وما جهلت نفسي بأن شرابه % % سراب وبرد العيش منه شواظ % 7(@)(@@) % وهل عن مقامات الهوى متحول % وفيها شتا أهل الغرام وقاظوا % % 8(@)(@@) % بنفسي من أطمعت نفسي بنيلها % % وما عندها للمستميح لماظ % 9(@)(@@) % معاطفها نشوى وما ذقن خمرة % وأجفانها وسنى وهن يقاظ % % 10(@)(@@) % كأن عيونا أغريت بجمالها % % لشدة ما ترنو إليه جحاظ % % PageV01P230 11(@)(@@) % برعت على أهل الغرام بوصفها % % كأني قس والغرام عكاظ % PageV01P231 البحر : طويل 1(@)(@@) % سريرة شوق في الهوى من أذاعها % % ومهجة صب بالنوى من أضاعها % % 2(@)(@@) % أفي كل يوم للعباد ملمة % تلم بنا لا نستطيع دفاعها % % 3(@)(@@) % فلله جمع فرق البين شمله % % وإلفة صحب قد أباد اجتماعها % % 4(@)(@@) % وساعات أنس كان لهوا حديثها % % سقى الله هاتيك الليالي وساعها % % 5(@)(@@) % ولا مثل ليلى إن تبدت عشية % مددت لها كفي أريد وداعها % % 6(@)(@@) % وقد أقبلت تذري الدموع تلهفا % إذا هتف الداعي إلى البين راعها % % 7(@)(@@) % أشاعت بنا أيدي الفراق فأصبحت % % تؤم بنا شم الذرى وتلاعها % % 8(@)(@@) % نجوب قفارا ما وقفنا بقاعها % % ونقطع بيدا ما حللنا بقاعها % % 9(@)(@@) % تميل بنا الأكوار ليلا كأننا % % نشاوى سلاف قد أدمنا ارتضاعها % % 10(@)(@@) % إذا نفحتنا نسمة حاجرية % أجدت وهاجت للنفوس التياعها % % PageV01P232 11(@)(@@) % فمن مهجة لا يستقر قرارها % % ومن كبد نخشى عليها انصداعها % % 12(@)(@@) % تجاذبنا فضل الأزمة ضمر % أهاج نزاع البين وجدا نزاعها % % 13(@)(@@) % نقيس بها طول الفلاة وعرضها % % عشيا إذا مدت لخطو ذراعها % % 14(@)(@@) % يقول أصيحابي وقد جدت السرى % % وأوفتهم أيدي الركائب صاعها % % 15(@)(@@) % أفيقوا فقد شط 
ms66	 المرام ولا نرى % % سوى تلعات قد سئمنا افتراعها % % 16(@)(@@) % فقلت لهم سيروا سراعا وقلقلوا % % عراب المطايا واستحثوا سراعها % % 17(@)(@@) % لنحظى من الدنيا بأوفر حظها % % ونشهد أوصافا عشقنا استماعها % % 18(@)(@@) % وننزل عن أيدي الركاب نريحها % % ونشكر فينا ما بقينا اصطناعها % % 19(@)(@@) % بأرحب أرض لا يسامى علاؤها % % وأسمى ربوع لا نمل ارتباعها % % 20(@)(@@) % بسوح نظام الدين وابن نظامه % % كريم به مدت يد المجد باعها % % PageV01P233 21(@)(@@) % همام إليه الدهر ألقى زمامه % % إذا عصي الأقوام كان مطاعها % % 22(@)(@@) % أنارت شموس المكرمات بأفقه % % فألقت على كل الأنام شعاعها % % 23(@)(@@) % له يد فضل لا تبارى سماحة % إذا ما نباغيث رجونا اندفاعها % % 24(@)(@@) % مواهب لا تنفك تحدو مواهبا % تنال غمار البحر منها اتساعها % % 25(@)(@@) % إذا انقطعت يوما شآبيب مزنة % فأيدي نداه لا تخاف انقطاعها % % 26(@)(@@) % به أينعت روض المكارم والندى % % وشادت مباني كل عز رباعها % % 27(@)(@@) % أعز ذوي الإفضال والبأس فضله % % فقل لليالي لا تغر رعاعها % % 28(@)(@@) % له أذعنت شمس العداة مهابة % ولم يخش لو لم تستذل امتناعها % % 29(@)(@@) % وذلت له الدنيا فألقت قيادها % % لطاعته حتى أمنا خداعها % % 30(@)(@@) % تباري النجوم الزهر زهر نصاله % % إذا راح يحمي وقعها وقراعها % % PageV01P234 31(@)(@@) % وتهزأ بالخطي أقلام خطه % % إذا ما حوت يمناه يوما يراعها % % 32(@)(@@) % أرب الندى والفضل والمجد والحجا % % وناظم أشتات العلى وجماعها % % 33(@)(@@) % لانت الذي أحرزت في الخلق رتبة % تود الدراري لو تنال ارتفاعها % % 34(@)(@@) % إليك حثثنا كل كوماء بازل % وجبنا القفار البيد نبسر قاعها % % 35(@)(@@) % فلا غرو فالآمال أنت محطها % % ونحوك أزجت عزمها وزماعها % % 36(@)(@@) % وفيك حكينا الدر نظما فهاكها % % خريدة فكر قد أمطت قناعها % % 37(@)(@@) % بمدحك قد نضدت جوهر عقدها % % وأبدعت في فن القريض ابتداعها % % 38(@)(@@) % فمن لابن هاني لو يهنى بمثلها % % وهيهات لو أن رامها ما استطاعها % % 39(@)(@@) % إذا ما حدا الحادي بها قال قائل % ألا فاشكراها نغمة وسماعها % % PageV01P235 البحر : طويل 1(@)(@@) % سلام على بدر له السعد مطلع % % وشمس سناها بالمناقب يسطع % 2(@)(@@) % على غرة العليا على هامة العلى % % على من له المجد المؤثل أجمع % 3 
ms67	(@)(@@) % على من حوى در المكارم يافعا % على من أوى حجر العلى وهو يرضع % % 4(@)(@@) % سلام محب كلما عن ذكره % % تكاد حشاه بالاسى تتصدع % 5(@)(@@) % يذكره ضوء الصباح جبينه % % ونشر الصبا رياه إذ يتضوع % % 6(@)(@@) % ألا ليت شعري هل درى من وداده % % له مهجتي دون الأحبة مربع % 7(@)(@@) % بأني على عهدي له الدهر ثابت % وإن راح صبري بعده يتضعضع % % 8(@)(@@) % أمر على ربع به كان نازلا % فيخطر لي ذاك الجناب الممنع % % 9(@)(@@) % إذا اكتحلت عيني بآثار ربعه % % تحدر منها أربعون وأربع % 10(@)(@@) % ألا أيها الندب الهمام السميدع ال % % أغر التقي الأروع المتورع % % PageV01P236 11(@)(@@) % لك الله إني للأذمة حافظ % فلا تر أني غادر أو مضيع % 12(@)(@@) % لئن غبت عن عيني فشخصك حاضر % ببالي لم أبرح أراك وأسمع % 13(@)(@@) % وإن شب في قلبي الغضا بعدك الفضا % % فبالمنحنى من أضلعي لك موضع % 14(@)(@@) % أتاني كتاب منك يشرق نوره % كأن على أعطافه الشمس تلمع % % 15(@)(@@) % تنوع من نظم ونثر كأنه % % رياض غدت أزهارها تتنوع % % 16(@)(@@) % ففي كل سطر منه وشي منمنم % وفي كل فصل منه عقد مرصع % % 17(@)(@@) % طربت به لفظا ومعنى كأنما % % أدير علي البابلي المشعشع % % PageV01P237 البحر : طويل 1(@)(@@) % خليلي هل عهدي بمكة راجع % % فقد قليت بالهند مني المضاجع % % 2(@)(@@) % وهل شربة من ماء زمزم ترتوي % % بها كبد قد أظمأتها الوقائع % % 3(@)(@@) % وهل عامر ربع الهوى بسويقة % فعهدي بذاك الربع للشمل جامع % 4(@)(@@) % وهل من صفا من سالف العيش بالصفا % % يعود لنا يوما فتصفو المشارع % 5(@)(@@) % سقى الله ما بين الحجون إلى الصفا % % مرابع فيها للظباء مراتع % % 6(@)(@@) % وجاد بأجياد منازل جيرة % بهن حمام الأبطحين سواجع % % 7(@)(@@) % وحيا الحيا بالمأزمين معاهدا % فما عهدها عندي مدى الدهر ضائع % % PageV01P238 البحر : خفيف تام 1(@)(@@) % من لشملي لو فاز منكم بجمع % % في ليالي منى وأيام جمع % % 2(@)(@@) % يا رعى الله عهدنا بالمصلى % % وسقى عصرنا بكثبان سلع % 3(@)(@@) % وليال خلت فعوضت عنها % % بليال تمر من غير نفع % % 4(@)(@@) % يا عريبا لولاهم لم يشقني % % ذكر دار ولا تذكر ربع % % 5 
ms68	(@)(@@) % وإذا ما سمعت عنهم حديثا % حسدت مقلتي لذلك سمعي % % 6(@)(@@) % ليت شعري هل يسمح الدهر يوما % بالتداني وهل يعود برجع % % 7(@)(@@) % ضقت ذرعا بالبعد فيكم ولولا % % حبكم لم يضق من البين ذرعي % % 8(@)(@@) % أرجف العاذلون أني سال % وأرادوا منكم بذلك قطعي % % 9(@)(@@) % كيف أسلو وحبكم لي طبع % وسلوي سجية غير طبعي % % 10(@)(@@) % آد جهدي هواكم ونواكم % % حملتني من الجوى غير وسعي % % PageV01P239 11(@)(@@) % قربوا لا نأيتم الدار مني % % واسمحوا بالعطاء من بعد منع % 12(@)(@@) % ومتى شئتم الغضا ففؤادي % % أو أردتم سفح العقيق فدمعي % % PageV01P240 البحر : كامل تام 1(@)(@@) % يا دارمية باللوى فالأجرع % حياك منهل الحيا من أدمعي % % 2(@)(@@) % وسرى نسيم الروض يسحب ذيله % % بمصيف أنس في حماك ومربع % % 3(@)(@@) % لو لم تبيتي من أنيسك بلقعا % ما بت أندب كل دار بلقع % % 4(@)(@@) % لم أنس عهدك والأحبة جيرة % والعيش صفو في ثراك الممرع % 5(@)(@@) % أيام لا أصغي للومة لائم % سمعا وإن ثغر الصبابة أسمع % 6(@)(@@) % حيث الربى تسري برياها الصبا % % والروض زاهي النور عذب المشرع % % 7(@)(@@) % تحنو علي عواطفا أفنانه % % عند المبيت به حنو المرضع % 8(@)(@@) % والورق في عذب الغصون سواجع % تشد وبمرأى من سعاد ومسمع % % 9(@)(@@) % كم بت فيه صريع كأس مدامة % حلف البطالة لا أفيق ولا أعي % % 10(@)(@@) % أصبو بقلب لا يزال موزعا % في الحب بين معمم ومقنع % PageV01P241 11(@)(@@) % مستهترا طوع الصبابة في هوى % % قمري جمال مسفر ومبرقع % 12(@)(@@) % ما ساءني أن كنت أول مغرم % بجمال رب ردا وربة برقع % 13(@)(@@) % يقتادني زهر الشباب وعفتي % % فيه عفاف الناسك المتورع % 14(@)(@@) % لله أيامي بمنعرج اللوى % % حيث الهوى طوعي ومن أهوى معي % % 15(@)(@@) % لم أنسه والبين ينعق بيننا % % متصاعد الزفرات وهو مودعي % % 16(@)(@@) % إن شب في قلبي الغضا بفراقه % % فلقد ثوى بالمنحنى من أضلعي % % 17(@)(@@) % أتجشم السلوان عنه تكلفا % والطبع يغلب شيمة المتطبع % PageV01P242 البحر : طويل 1(@)(@@) % بنفسي من قد حاز لون الدجى فرعا % % ولم يكفه حتى تقمصه درعا % % 2(@)(@@) % بدا فكأن البدر في جنح ليلة % أو الشمس وافت في ظلام الدجى تسعى % % 3 
ms69	(@)(@@) % نمته لنا عشر المحرم جهرة % يطارح أترابا تكنفه سبعا % % 4(@)(@@) % تبدي على رزء الحسين مسودا % وما زال يولي في الهوى كرب لا منعا % % 5(@)(@@) % وقد سل من جفنيه غضبا مهندا % كأن له في كل جارحة وقعا % % 6(@)(@@) % هناك رأيت الموت تندى صفاحه % % وناعي الأسى ينعي وأهل الهوى صرعا % % PageV01P243 البحر : وافر تام 1(@)(@@) % دعت ريحانة الأدباء لبي % % فلبى وهو ممتثل مطيع % % 2(@)(@@) % وقال وقد أجاب بغير ريث % أمن ريحانة الداعي السميع % % PageV01P244 البحر : طويل 1(@)(@@) % أشمس سناها في الدجنة بازغ % % عليها برود للجمال سوابغ % 2(@)(@@) % ممنعة أما الرضا فمحرم % % لديها وأما السخط منها فسائغ % % 3(@)(@@) % تروغ إذا رام المحب وصالها % % كما رام من آرام وجرة رائغ % % 4(@)(@@) % ولم يثنها عني سلو ولا قلى % ولكن شيطان الملامة نازغ % % 5(@)(@@) % يروم عذولي أن أروم سلوها % % وما القلب عن نهج المحبين زائغ % 6(@)(@@) % ولو كان قلبي فارغا لأطعته % % ولكنه بالحب ملآن فارغ % 7(@)(@@) % لي الله من لاح يؤنب في الهوى % % يراوغني في حبها وأراوغ % 8(@)(@@) % ولو ذاق طعم الحب من لام لم يكن % % ليمضغ أعراض المحبين ماضغ % % 9(@)(@@) % يقولون لا تشغل فؤادك بالهوى % % وأقبح شيء عاشق متفارغ % 10(@)(@@) % وهيهات لو أوف الغرام حقوقه % % وإن ظن أني في الغرام مبالغ % % PageV01P245 11(@)(@@) % وبي طفلة ريا المعاطف حسنها % % لأقصى نهايات المحاسن بالغ % 12(@)(@@) % تجلت فجلت أن يقاس بضوئها % % بدور تمام أو شموس بوزاغ % % 13(@)(@@) % كأن احمرار الخد من وجناتها % % له حسنها من مهجة الصب صابغ % 14(@)(@@) % كأن اسوداد الخال في صحن خدها % % له حبها من حبة القلب صائغ % 15(@)(@@) % نبغت بشعري في محاسن وصفها % % فأذعن عن رغم بسبقي النوابغ % % 16(@)(@@) % لعمري لولا دارها بتهامة % لما شاقني منها خليص ورابغ % % 17(@)(@@) % ولو أسعفت قلبي بدرياق ريقها % % لما ضره أصل من الشعر لاذع % % 18(@)(@@) % لئن غص من عين الرقيب محبها % % فمشربه من منهل الحب سائغ % % PageV01P246 البحر : سريع 1(@)(@@) % يا ملكا عم نداه الورى % % وألحق البادي بالعاكف % 2(@)(@@) % لما حللت الطائف المشتهى % % وصرت فيه مأمن الخائف % 3(@)(@@) % طاف بك الخلق جميعا 
ms70	 فها % % بيتك أضحى كعبة الطائف % % PageV01P247 البحر : كامل تام 1(@)(@@) % لله در معاشر آلفتهم % % فحويت خصل المجد في إيلافهم % 2(@)(@@) % ذهبوا فأخلفت الليالي عنهم % % قوما يرون الجود في إخلافهم % 3(@)(@@) % عش عائلا فالدهر أنشد قائلا % ذهب الذين يعاش في أكنافهم % % PageV01P248 البحر : بسيط تام 1(@)(@@) % جلا الكؤوس فجلى ظلمة السدف % % بدر كلفت به حاشاه من كلف % 2(@)(@@) % سمت وقد أشرقت راح براحته % كأنها الشمس حلت منزل الشرف % 3(@)(@@) % وضاع نشر شذاها وهي في يده % % كأنها وردة في كف مقتطف % % 4(@)(@@) % بكر تحلت بدر من فواقعها % % وأقبلت وهي في وشح وفي شنف % % 5(@)(@@) % يا سحب نيسان روي الكرم من كرم % % ففي الحباب غنى عن لؤلؤ الصدف % 6(@)(@@) % شتان ما بين در راح مرتشفا % رشف الثغور ودر غير مرتشف % 7(@)(@@) % لم أنس ليلة أنس بت معتنقا % فيها الحبيب اعتناق اللام للألف % % 8(@)(@@) % أمنت من ريب دهري في خفارته % % ومن يبت في ضمان الحب لم يخف % % 9(@)(@@) % ورحت فيها من الهجران منصفا % من بعد ما كنت منه غير منتصف % % 10(@)(@@) % أسطو عليه برمح من معاطفه % وصارم من ظبى أجفانه الوطف % % PageV01P249 11(@)(@@) % لله طيب وصال نلت من رشأ % % بالحسن متسم بالطيب متصف % 12(@)(@@) % إذا ضممت إلى صدري ترائبه % % كادت تذوب تراقيه من الترف % 13(@)(@@) % يا محسن الوصف إن رمت النسيب فصف % لنا محاسن هذا الشادن الصلف % % 14(@)(@@) % أو رمت تنسب يوما سيدا لعلا % % فانسب إلى منتهاها سادة النجف % % 15(@)(@@) % واخصص بني شرف الدين الأولى شرفت % % بهم بيوت العلى والمجد والشرف % 16(@)(@@) % قوم يحلون دون الناس قاطبة % بحبوحة المجد والباقون في طرف % 17(@)(@@) % القائلون لدى المعروف لا سرف % في الخير يوما كما لا خير في السرف % 18(@)(@@) % رووا حديث المعالي عن أب فأب % وساقه خلف يرويه عن سلف % % 19(@)(@@) % هم نجوم الهدى ليلا لمدلج % وهم بحار الندى نيلا لمغترف % 20(@)(@@) % منهم حسين أدام الله بهجته % % وأي وصف باحسان الحسين يفي % % PageV01P250 21(@)(@@) % هو الشريف الذي فاق الورى شرفا % سل عن مفاخره من شئت يعترف % % 22(@)(@@) % كم من جميل 
ms71	 له في الخلق مجمله % % يلوح كالكوكب الدري في السدف % % 23(@)(@@) % فالخلق من خلقه في نزهة عجب % ومن خلائقه في روضة أنف % % 24(@)(@@) % أمسى الندى والهدى والمجد مكتنفا % به وأصبح منه الدين في كنف % % 25(@)(@@) % سعى إلى الغاية القصوى التي وقفت % % عنها الورى فتعداها ولم يقف % 26(@)(@@) % فحاز ما حازه أقرانه وحوى % % ما شذ عن سلف منهم وعن خلف % PageV01P251 البحر : طويل 1(@)(@@) % أفي كل ربع للمطي بنا وقف % وفي كل دار من مدامعنا وكف % % 2(@)(@@) % نسائل عن أحبابنا كل دارس % ونقفو من الآثار بالبيد ما نقفو % % 3(@)(@@) % أخلاي إن تعف الديار ففي الحشا % % رسيس جوى لم يعف يوما ولا يعفو % % 4(@)(@@) % حنيني إلى دار قضيت بها الصبا % % وما عاقني للدهر منع ولا صرف % 5(@)(@@) % وعهدي بهاتيك المعاهد والربى % % أواهل لا ينفك يعطوبها خشف % % 6(@)(@@) % تطالعنا أقمار تم بأفقها % % ويهفو علينا من شذا نشرها عرف % % 7(@)(@@) % ورب صموت القلب خمصانة الحشا % % لهوت بها والنجم في أذنها شنف % % 8(@)(@@) % لعوب إذا عاطتك لهو حديثها % % ثملت وما دارت معتقة صرف % % 9(@)(@@) % يؤودها مر النسيم فتنثني % % تثني غصن البان ما شانه قصف % 10(@)(@@) % سل الظبية الغناء إذ قيل مثلها % % أساعفها الكشح المهفهف والردف % % PageV01P252 11(@)(@@) % ثقيلة غض الطرف وسنى كأنما % % سبت سنة العشاق أجفانها الوطف % % 12(@)(@@) % قضيت بها عمر الشبيبة لاهيا % ولم ينتبه للبين في شملنا طرف % % 13(@)(@@) % ليالي لا يصفو ورودي لمنهل % ولي من حمياها ومن ثغرها رشف % 14(@)(@@) % وكم ليلة رام الصباح نزالها % % أمد الدجى من فرعها الشعر الوحف % % 15(@)(@@) % لك الله هل بعد التباعد عطفة % وهل لغصون قد عبست بعدنا عطف % % 16(@)(@@) % أجد النوى ما زلت أكدح دائبا % أمام الرجا خلف وصدق المنى خلف % % 17(@)(@@) % لعمري ما الآمال من شيم الفتى % % إذا لم تصدقه الظنون أو الكشف % % 18(@)(@@) % وما كل مرجو ينال وإنما % % على المرء أن لا يستذل ولا يهفو % % 19(@)(@@) % هدى للأماني قد تبلج نجحها % % بجود نظام الدين وانبلج العرف % 20(@)(@@) % كريم إذا ما انهل وابل كفه % % وصوب الحيا لم تدر أيهما 
ms72	 الكف % % PageV01P253 21(@)(@@) % حليف ندى لم تأو مالا بنانه % % لوفر ولم يألف براحته ألف % 22(@)(@@) % له خلق كالروض غب بها الندى % % وكف سماح لا يشام لها كف % 23(@)(@@) % فتى المجد وثاب إلى رتب العلى % % وما عاقه عنها خمول ولا ضعف % 24(@)(@@) % رقى مرتقى لولا تأخر عصره % % لجاءت به الآيات والرسل والصحف % % 25(@)(@@) % يروقك مقداما إذ الصيد أحجمت % % بحيث القنا الخطار من فوقه سقف % % 26(@)(@@) % ويسمو الحسام المشرفي بكفه % % إذا ما التقى الجمعان واقترب الزحف % 27(@)(@@) % أليف العلى لم يصب إلا إلى العلى % % إذا ما صبا يوما إلى إلفه إلف % % 28(@)(@@) % تقصت عداه من مدى البين غاية % فلا دنت القصوى ولا بعد الحتف % % 29(@)(@@) % رويدا فإن دانت رجال بسلمها % % وإلا فهذي البيض واليلب الزعف % 30(@)(@@) % كأن المذاكي القربات يقودها % % عرائس تجلى إذ يراد لها زف % PageV01P254 31(@)(@@) % وقد أسدلت من ثائر النقع دونها % % ستور ولم يرفع لمسدلها سجف % 32(@)(@@) % وما أينعت يوما رؤوس عداته % % بروض الوغى إلا وحان لها قطف % 33(@)(@@) % أرب العلى والمجد والبأس والندى % % إليك فلولا أنت ما استغرق الوصف % 34(@)(@@) % شهدت لأنت الواحد الفرد في العلى % % وقد أنكر الإنكار أو عرف العرف % % 35(@)(@@) % إليك الهدى ألقى مقاليد أمره % % فأيقظته من بعد ما كاد أن يغفو % % 36(@)(@@) % فأنت لهذا الخلق إن دان موئل % وللدين والدنيا إذا نكبا كهف % 37(@)(@@) % رقيت من العلياء أرفع رتبة % ففقت الورى قدما وكلهم خلف % % 38(@)(@@) % فلا برحت علياؤك الدهر عضة % غلائلها تضفو ومشربها يصفو % % 39(@)(@@) % وأمك عيد النحر بالسعد مقبلا % وأم عداك النحر والذل والخسف % % 40(@)(@@) % ودونكها عذراء بكرا زففتها % % إليك ودادا حليها النظم والرصف % PageV01P255 41(@)(@@) % ودم وابق واسلم آمر الدهر ناهيا % مدى الدهر إجلالا عليك العلى وقف % % PageV01P256 البحر : كامل تام 1(@)(@@) % أتركتني دنفا ورحت معافى % % مهلا فديتك ما كذا من صافى % % 2(@)(@@) % هلا ذكرت لياليا بتنا بها % % نرعى النجوم ونذكر الألافا % % 3(@)(@@) % كيف انفرادك بعد أن كنا معا % حاشا لمثلك ينقض الأحلافا % % 4(@)(@@) % أنسيت لا أنسيت فضل صبابة % كنا بها نستسعف استسعافا % % 5(@)(@@) % فاليوم رحت 
ms73	 وقد قويت على الهوى % % وجوانحي أمست عليه ضعافا % % 6(@)(@@) % وألفت آنس مضجع متبوأ % % ومضاجعي لا تعرف الإيلافا % % 7(@)(@@) % لو كنت تحفظ في الهوى أنصفتني % % أو كنت تعرف في الهوى إنصافا % % 8(@)(@@) % أتظل تسقى في الغرام سلافة % وأظل أسقى في الغرام ذعافا % % 9(@)(@@) % وأبيت في حر الغرام مقاطعا % وتبيت في برد الوصال موافى % % 10(@)(@@) % ما جار من منع الحبيب وإنما % % جار الذي أخذ الحبيب وحافا % % PageV01P257 11(@)(@@) % ناصفتني حمل الهوى وتركتني % % حتى حملت من الهوى اضعافا % 12(@)(@@) % فليهنك اليوم الوصال فإنني % % باق وإن أخلفتني إخلافا % % PageV01P258 البحر : طويل 1(@)(@@) % بكيت أسى لورد عنك البكا حتفا % % وأعولت وجدا لو شفت عولة لهفا % % 2(@)(@@) % أغالب فيك الوجد والوجد غالب % وأيد اصطباري لم يزل واهيا ضعفا % % 27(@)(@@) % وهل لامرىء أودى الردى بجنانه % % عزاء وكف الدهر جذت له كفا % % 28(@)(@@) % لك الله من يمنى طوتها يد البلى % % وعين رمت عين الردى نحوها طرفا % % 29(@)(@@) % ودوحة مجد بالمعالي وريقة % % ألمت بها الأقدار حتى ذوت عصفا % % 30(@)(@@) % وشمس علا بالمكرمات منيرة % أتاحت لها الأيام من خطبها كسفا % % 31(@)(@@) % وذات حجاب بالعوالي منيعة % يمد عليها المجد من صونها سقفا % % 32(@)(@@) % نعاني لها الناعون حزنا وإنما % % سقاني بها الناعون كأس الأسى صرفا % % 33(@)(@@) % أأختي إن أمسيت رهن مقابر % فقلبي قد أمسى على حزنه وقفا % % 34(@)(@@) % تكاثرني الأشجان فيك وانما % % تكاثر مضنى شف بالوجد أو أشفى % % PageV01P259 35(@)(@@) % لئن كان أخفى القلب يوما تجملا % جواه فقد أبدى لرزئك ما أخفى % % 36(@)(@@) % ولي كربة قد باين الصبر لهفها % % فها أنا أنزو في حبائلها رجفا % % 37(@)(@@) % أبيت بهاجا في المبيت وقد ورت % بجنبي نار من جناني لا تطفا % % 38(@)(@@) % أرواح ما بين اليدين على الحشا % % وأسبل من جفني لها مدمعا وكفا % % 39(@)(@@) % ولو وعيت أذناك كثر تأوهي % % علمت إخائي ما أبر وما أصفى % % 40(@)(@@) % وكم عبرة لا تملك العين ردها % % وجأت بها مقروح جفني إذ أغفى % % 41(@)(@@) % وزفرة وجد رمت بالصبر كظمها % % فما كدت حتى أعقبتني الأسى ضعفا % % 42(@)(@@) % فلله دهر لا تزال صروفه % % إذا 
ms74	 ما نقضى صرف أتاحت لنا صرفا % % 43(@)(@@) % علي لأصناف الرزايا تناوب % أساور منها كل آوانة صنفا % % 44(@)(@@) % أفي كل عام لي قريب يروعني % % برزء وإلف يخلف الحزن لي ألفا % % PageV01P260 45(@)(@@) % إلى الله أشكوها نوائب جمة % وصرف زمان لا أطيق له صرفا % % 46(@)(@@) % كذاك خطوب الدهر تعدو على الورى % % فكم أسبلت طرفا وكم سلبت طرفا % % 47(@)(@@) % وكم أنزلت من شامخ المجد ماجدا % تشيد له العلياء من عزه كهفا % % 48(@)(@@) % إذا رام أمرا هز أسمر عاسلا % وإن سئل المعروف هز له عطفا % % 49(@)(@@) % أناخت عليه لم تراقب له علا % فألوت به خسفا وأزرت به عسفا % % 50(@)(@@) % ولم ترع إذ أمته جرداء سابحا % وأجرد يحموما وناجية حرفا % % 51(@)(@@) % وكم قد سبت من معقل العز حرة % تود الثريا أن تكون لها شنفا % % 52(@)(@@) % تخطت إليها مرهفات بواترا % وخطية سمرا وماذية زغفا % % 53(@)(@@) % فأخنت عليها لا تهاب جموعها % % ولم تخش سترا قد أذيل ولا سجفا % % 54(@)(@@) % وها أنا قد حاولت صبري تأسيا % وكيف التأسي والأسى لم يزل حلفا % % PageV01P261 55(@)(@@) % أبى الوجد إلا أن أريق مدامعا % تبادرني لا أستطيع لها كفا % % 56(@)(@@) % فيا قبرها لا زلت أشرف حفرة % تشبث أذيال النسيم بها عرفا % % 57(@)(@@) % يؤمك رضوان من الله واسع % يقرب من ضمنت من ربها زلفا % % 58(@)(@@) % ولست بمستسق لك المزن ما همى % % لجفني دمع لا أبالي له نزفا % % 59(@)(@@) % لؤمت إذا لم أسقك الدمع هاطلا % وأصبحت أستسقي لك الديم الوطفا % % PageV01P262 البحر : كامل تام 1(@)(@@) % ليس احمرار لحاظه عن علة % لكن دم القتلى على الأسياف % % 2(@)(@@) % قالوا تشابه طرفه وبنانه % % ومن البديع تشابه الأطراف % PageV01P263 البحر : كامل تام 1(@)(@@) % هد الحمام لآل عبد مناف % % جبلا أناف علاه أي مناف % 2(@)(@@) % أودى بأبلج من ذؤابة هاشم % يجلو بغرته دجى الأسداف % % 3(@)(@@) % بالضيغم الفتاك بل بالصارم ال % بتاك بل بالجوهر الشفاف % 4(@)(@@) % من لم يزل من بأسه ونواله % % مردي العداة ومورد الأضياف % 5(@)(@@) % من لم يزل للواردين حياضه % % ذا ماء يرويهم بعذب صاف % 6(@)(@@) % من لم يزل للقاصدين جنابه % % رحب 
ms75	 الفناء موطأ الأكناف % % 7(@)(@@) % من لم يزل للطالبين علومه % % بالكشف يغنيهم عن الكشاف % % 8(@)(@@) % من لم يزل يملي جليل جميله % % أوصافه العليا على الوصاف % 9(@)(@@) % من كان يطرب من سؤال عفاته % % طرب النشاوى من كؤوس سلاف % % 10(@)(@@) % لله أي رزية رزئت به % % لا يستقال تلافها بتلاف % % PageV01P264 11(@)(@@) % رغمت أنوف السمهرية والظبى % % لما أصبن بمرغم الآناف % % 12(@)(@@) % بالمورد السمر العطاش من الكلى % % يوم النزال ومطعم الأسياف % 13(@)(@@) % وتقوضت عمد المواهب والندى % % لما رزئن بواهب الآلاف % % 14(@)(@@) % ومطوق الأعناق من أفضاله % % بثقال أطواق عليه خفاف % 15(@)(@@) % أقريش قد ذهب الإلاف فمن لكم % % من بعد أحمد في الورى بإلاف % % 16(@)(@@) % أبني الهواشم إن طودكم هوى % % وأرى النفوس على هواه هوافي % % 17(@)(@@) % ذهب الذي أحيا وجدد فضله % % لبني النبي مآثر الأسلاف % % 18(@)(@@) % وطوى الردى من كان ينشر في الوغى % % حلل الردى قسرا على الأعطاف % 19(@)(@@) % إني لأقسم عن يمين برة % قسم المحق ولست بالحلاف % % 20(@)(@@) % ما خص رزؤك يا ابن فاطم عصبة % لكنه عم الورى بتلاف % % PageV01P265 21(@)(@@) % هذي جموع المكرمات بأسرها % % فصم المنون وفاقها بخلاف % 22(@)(@@) % عادت بحار المجد بعدك والعلى % % يبسا وآذن ماؤها بجفاف % % 23(@)(@@) % وغدت نفوس أولي العلى معتلة % لما ذهبت ولم تجد من شاف % % 24(@)(@@) % وبنو الرجاء تبدلت أنوارها % % بغياهب وشهادها بذعاف % 25(@)(@@) % وتضعضعت أركان كل قبيلة % وتشبه الأذناب بالأعراف % % 26(@)(@@) % والأسد قد فقدت لأجلك بأسها % % فغدت براثنهن كالأظلاف % 27(@)(@@) % من يرتجى للجود بعدك والندى % % والفضل والإسعاد والإسعاف % 28(@)(@@) % هيهات إن المكرمات جميعها % % طارت بهن قوادم وخواف % % 29(@)(@@) % يا درة سمح الزمان لنا بها % % حينا وأرجعها إلى الأصداف % % 30(@)(@@) % لا كان رزؤك في الرزايا إنه % % شرق الكرام وغصة الأشراف % % PageV01P266 31(@)(@@) % عجبا لوجهك كيف إذ غشوه لم % % يغش العيون بنوره الخطاف % 32(@)(@@) % عجبا لنعشك كيف لم يوه الطلى % % لما غدا يعلو على الأكتاف % % 33(@)(@@) % عجبا لمودعك المقابر كيف لم % % يودعك بين جوانح وشغاف % % 34(@)(@@) % عجبا لقبرك كيف لا يعلو على % % القمرين في الإشراق والإشراف % 35(@)(@@) % فجىء الأنام عشا بنعشك سائرا % فتبادروا أركانه 
ms76	 بطواف % % 36(@)(@@) % وفروا من جيوبهم عليك وبادروا % % من حسرة عضا على الأطراف % % 37(@)(@@) % ومروا من الأجفان سحب مدامع % تبكي عليك بهاطل وكاف % % 38(@)(@@) % لا غرو إذ كانوا بسوحك في غنى % عن مربع نضر وعن مصطاف % 39(@)(@@) % إن كفنوك فإن جسمك لم يزل % % يختال في بردي تقى وعفاف % 40(@)(@@) % أو غسلوك فلن تزال مطهر % % الأقوال والأفعال والأوصاف % % PageV01P267 41(@)(@@) % أو حنطوك فلا تزال مطيبا % طيبا تضوع به قرى وفيافي % % 42(@)(@@) % صلى عليك الله قبل صلاتهم % % وحباك بالرضوان والألطاف % % 43(@)(@@) % يا سيد الآباء سمعا لابنك % % المضنى فقد أضناه طول تجاف % % 44(@)(@@) % قد كنت بي برا وكنت مواصلا % وجميل برك كافل لي كاف % 45(@)(@@) % فاليوم مالك قد أطلت تجنبي % % وهجرتني هجر الحبيب الجافي % % 46(@)(@@) % أجفا وما عودتني منك الجفا % % وعظيم حزني ليس عنك بخاف % % 47(@)(@@) % لا بل طوتك يد البلى ومنعت عن % % رد الجواب لسائل ولعاف % % 48(@)(@@) % ولو استطعت لك الفداء لكنته % % ووقيت جسمك من ثرى الأجداف % 49(@)(@@) % لكنني باق على حسن الوفا % % حتى أراك به على الأعراف % 50(@)(@@) % لا زال يتحفك الاله برحمة % من فضله بلطائف الاتحاف % PageV01P268 51(@)(@@) % وعليك مني ما حييت تحية % تغشى ضريحك دائما وتوافي % % PageV01P269 البحر : بسيط تام 1(@)(@@) % قم هاتها وحسام الفجر منذلق % صهباء منها ضياء الصبح ينفلق % 2(@)(@@) % لم تدر حين توافيها أصبغتها % % تلوح أم وجنة الساقي أم الشفق % % 3(@)(@@) % كأنها في الدجى شمس تضيء لنا % % فينجلي عن سنى أنوارها الغسق % 4(@)(@@) % ألقت على الصبح نورا من أشعتها % % فاحمر من خجل من نورها الأفق % % 5(@)(@@) % عذراء تغضي حياء من ملامسها % % فيستحيل حبابا فوقها العرق % 6(@)(@@) % إذا تجلى لنا من أفقها قدح % دارت نطاقا على حافاته الحدق % 7(@)(@@) % وإن جلاها بلا مزج مشعشعها % % يكاد من لهب اللألاء يحترق % 8(@)(@@) % تخالها شفقا حتى إذا لمعت % % حسبتها البرق في الظلماء يأتلق % 9(@)(@@) % من كف أغيد في خلخاله حرج % إذا تثنى وفي أجراسه قلق % % 10(@)(@@) % يديرها وهو مهتز لها طربا % كأنما هزه من روعة فرق % PageV01P270 11(@)(@@) % في خده ومحياه ومبسمه % % نار ونور ونور 
ms77	 نشره عبق % 12(@)(@@) % يجلو دجى فرعه لألاء غرته % % كأنما انشق عن أزراه الفلق % % 13(@)(@@) % ترى الندامى سكارى حين تلحظه % % كأنهم من حميا لحظه اغتبقوا % % 14(@)(@@) % يغضي بذي كحل بالسحر مكتحل % وسنان ما راعه سهد ولا أرق % % 15(@)(@@) % ظبي ولكنه بالدر متشح % بدر ولكنه بالتبر منتطق % 16(@)(@@) % تطيب ريا شذاه كلما نسمت % % كالمسك يزداد طيبا حين ينتشق % % 17(@)(@@) % كم من أحاديث أبداها تعتبه % % كأنها درر قد ضمها نسق % 18(@)(@@) % فود كاشحنا لو ناله صمم % إذ بات من كثب للسمع يسترق % PageV01P271 البحر : خفيف تام 1(@)(@@) % مزجت كأسها بخمر وريق % % وتثنت كغصن بان وريق % 2(@)(@@) % وأماطت لثامها عن محيا % لو تجلى للبدر قال شقيقي % % 3(@)(@@) % وأدارت على الندامى مداما % أذكرتنا ليالي التشريق % % 4(@)(@@) % وجلت إذ تبسمت من لماها % % خمر ريق في أكؤس من شقيق % 5(@)(@@) % كم رشيق بأسهم اللحظ منها % % وطعين برمح قد رشيق % % 6(@)(@@) % غادة كلما نظرت إليها % % بسمت لي عن لؤلؤ في عقيق % % 7(@)(@@) % ومهاة أسكنتها من ضلوعي % % ودموعي بالمنحنى والعقيق % % 8(@)(@@) % رق شعري لخصرها الرق فاعجب % % للآل بيعت بسوق الرقيق % 9(@)(@@) % كم غدونا نجر ذيل التصابي % % بصبوح من كأسها وغبوق % 10(@)(@@) % والليالي ولا أذم الليالي % % جمعت بين شائق ومشوق % PageV01P272 11(@)(@@) % مع خل من الملام خلي % ورفيق مهذب بي رفيق % % PageV01P273 البحر : طويل 1(@)(@@) % ولما التقينا بالغوير عشية % وفاز بما يرجو مشوق وشائق % 2(@)(@@) % تبسم من أهوى فقلت لصاحبي % % بلغت المنى هذا العذيب وبارق % 3(@)(@@) % ولاح فقال الصبح هذا تبلجي % % أيكذب هذا الصبح والصبح صادق % 4(@)(@@) % وفاح فقال الروض نافح عبقتي % % وهل نفحت بالمسك قط حدائق % 5(@)(@@) % وماس فقال الرمح تلك معاطفي % % متى أزهرت فوق الرماح الشقائق % % 6(@)(@@) % وفاه بنطق خاله الدر نظمه % % وهل لفظ الدر المنظم ناطق % % 7(@)(@@) % وأرخى أثيثا أوهم الليل لونه % % ومن أين للون البهيم مفارق % 8(@)(@@) % وأبدى لحاظا أقسم الريم أنها % % لواحظه لولا السهام الرواشق % % 9(@)(@@) % وكلهم قد كاد يحكيه مشبها % ولكن من أهوى على الكل فائق % % PageV01P274 البحر : منسرح 1(@)(@@) % لا تقل البدر لاح في الغسق % % هذا سواد 
ms78	 القلوب والحدق % % 2(@)(@@) % إنسان عيني بدا بأسودها % % فعاد لي إذ رمقته رمقي % % 3(@)(@@) % يا لابسا للسواد طبت شذا % ما المسك إلا من نشرك العبق % % 4(@)(@@) % لبست لون الدجى فسر وقد % % أغرت ضوء الصباح في الأفق % % 5(@)(@@) % حتى بدا فيه وهو منفلق % يشق ثوب الظلام من حنق % % PageV01P275 البحر : سريع 1(@)(@@) % ورب ساق قلبه قلبه % % أفديه من قاس ومن ساق % 2(@)(@@) % تحارب العشاق في حسنه % % وقامت الحرب على ساق % PageV01P276 البحر : بسيط تام 1(@)(@@) % ذكرتكم والدجى شالت نعامته % % والأفق يستن فيه ساطع الفلق % 2(@)(@@) % وللصباح نسيم قد تأرج من % % ريحانة الفجر أو من وردة الشفق % % PageV01P277 البحر : سريع 1(@)(@@) % قلت له والدمع في وجنتي % % من لوعة الأشجان مدفوق % 2(@)(@@) % ليس كمثلي في الورى عاشق % قال : ولا مثلي معشوق % % PageV01P278 البحر : طويل 1(@)(@@) % عسى ما عسى من عود شملي يكتسي % % بعودهم بعد التسلب أوراقا % % 2(@)(@@) % فلم يصف لي من بعدهم قط مورد % ولا لذ لي عيش وإن طاب أوراقا % % PageV01P279 البحر : كامل تام 1(@)(@@) % يا كوكبا لم تحوه الأفلاك % % وبعارضيه مرزم وسماك % 2(@)(@@) % يحيي بطلعته النفوس ولحظه % % لدماء أرباب الهوى سفاك % 3(@)(@@) % إغمد شباك عن القلوب وصد بأه % % بأهداب الجفون فإنهن شباك % % 4(@)(@@) % أسر الغرام لك النفوس بأسرها % % قسرا فما يرجى لهن فكاك % % 5(@)(@@) % أنى يرجى من هواك فكاكها % % من بعد ما علقت بها الأشراك % % 6(@)(@@) % خفقت عليك قلوب أرباب الهوى % % حتى غدون وما بهن حراك % % 7(@)(@@) % لك في القبائل نسبة بجمالها % % تسمو الحبوش وتفخر الأتراك % 8(@)(@@) % ما كنت أحسب للدموع بوارقا % حتى تلألأ ثغرك الضحاك % 9(@)(@@) % بشفاته ماء الحياة لأنفس % % أودى بهن من الصدود هلاك % % 10(@)(@@) % ما ذقت موردها ولكن هكذا % % نقل الأراك وحدث المسواك % PageV01P280 11(@)(@@) % قل للأراك أراك تلثم مبسما % ما راح لاثمه سواك سواك % % 12(@)(@@) % لو أبصر النساك بارق ثغره % % ضلت سبيل رشادها النساك % % 13(@)(@@) % سيان في نهب النفوس وسفكها % % حد الحسام وطرفه البتاك % % 14(@)(@@) % ظبي الصريم إذا تلفت أو رنا % % وإذا سطا فالضغيم الفتاك % % 15(@)(@@) % وأنا الذي في الحب مذ وحدته % % ما شان 
ms79	 توحيدي له إشراك % % 16(@)(@@) % وعلى التفنن في محاسن وصفه % ما حام حول أقلها الإدراك % 17(@)(@@) % لولا أبي وأبي الرضي المرتضى % % لم يثنني عن وصفه استدراك % 18(@)(@@) % السيد الندب الهمام أخو العلى % % من أذعنت لجلاله الأملاك % % 19(@)(@@) % هو شمس مجد أشرقت بضيائها % % ظلم الدجى وأنارت الأحلاك % 20(@)(@@) % طافت بكعبة جوده يوم الندى % % عصب الوفود ولاذت الهلاك % PageV01P281 21(@)(@@) % الألمعي إذا ادلهمت طخية % عمياء فهو لسترها هتاك % % 22(@)(@@) % واللوذعي إذا تسامت رتبة % قعساء فهو لنيلها دراك % 23(@)(@@) % والهبرزي إذا تغالت خصلة % علياء فهو لرقها ملاك % 24(@)(@@) % فلجيده درر المدائح تنتقى % % ولجوده برد الثناء يحاك % 25(@)(@@) % سمعا أخا العلياء مدحة ناظم % % نثرت لآلئها له الأسلاك % % 26(@)(@@) % يدعوك بعد أبيه في الدنيا أبا % فكلاكما للمكرمات ملاك % 27(@)(@@) % يا ليت شعري كيف رأيك بعدما % % حال الزمان ودارت الأفلاك % 28(@)(@@) % هل قائم عذري لديك بما مضى % % مني وقلبي بالخطوب يشاك % % 29(@)(@@) % أم آخذ في العتب أنت وتاركي % % حرضا وأنت الآخذ التراك % % 30(@)(@@) % ما كان إهمالي الجواب لجفوة % لا والذي دانت له الأملاك % % PageV01P282 31(@)(@@) % لكن مخافة أن يقول ويفتري % % عني المحال الكاذب الأفاك % % 32(@)(@@) % وإليكها مني عروسا لم يكن % % لسوى ودادك عندها إملاك % 33(@)(@@) % لا زلت مقصود الجناب ممجدا % ما لاح برق واستهل سماك % % PageV01P283 البحر : رمل تام 1(@)(@@) % آه يا حبل النوى ما أطولك % % قطع الله زمانا وصلك % 2(@)(@@) % حكم الدهر بأسباب النوى % % وقضى فينا بما شاء الفلك % % 3(@)(@@) % ذبت والله غراما وأسى % من فراق لاك قلبي وعللك % % 4(@)(@@) % عجل الدهر ولم يرفق بنا % % آه يا دهر النوى ما أعجلك % % 5(@)(@@) % ذبت يا قلب غليلا بعدهم % % وبهم ما كان أروى غللك % 6(@)(@@) % كم وكم أمل نلت بهم % % حيث لم تقض الليالي أملك % % 7(@)(@@) % ليت دهرا كان أغرك هوى % بهم قد كان يوما عذلك % % 8(@)(@@) % هل ترى بعد التنائي لهم % رجعة يحيا بها من قد هلك % 9(@)(@@) % أيها النائي على وجد بنا % % بعدما جاز فؤادي وملك % % 10(@)(@@) % إن تعد يوما على رغم النوى % % تجد القلب كما قد كان لك 
ms80	 % % PageV01P284 البحر : كامل تام 1(@)(@@) % بين العذيب وبين برقة ضاحك % غراء تبسم عن شتيت ضاحك % % 2(@)(@@) % في حيها للعاشقين مصارع % من هالك فيها ومن متهالك % 3(@)(@@) % تسطو معاطفها وسود لحاظها % % بمثقف لدن وأبيض باتك % 4(@)(@@) % لا تستطب يوما موارد حبها % % ما هن للعشاق غير مهالك % 5(@)(@@) % فتكت بألباب الرجال ولم تصل % بسوى فواتن للقلوب فواتك % 6(@)(@@) % يرديك ناظرها ويغضي فاعجبن % % من فاسق يحكي تعفف ناسك % % 7(@)(@@) % هجرت وما اتسعت مسالك هجرها % % إلا وضاقت في الغرام مسالكي % % 8(@)(@@) % ولقد أبيت على القتاد مسهدا % وتبيت وسنى في مهاد أرائك % % 9(@)(@@) % لا تستعر جلدا على هجرانها % % إن كنت في دعوى الغرام مشاركي % % 10(@)(@@) % واترك حديث المعرضين عن الهوى % % يا صاحبي إن كنت لست بتاركي % % PageV01P285 11(@)(@@) % وإذا دعاك لبيع نفسك سائم % في حبها يوما فبعه وبارك % % 12(@)(@@) % ان التي فتنتك ليلة أشرقت % % إشراق شمس في دجنة حلك % % 13(@)(@@) % لا تصطفي خلا سوى كل امرىء % صب لأستار التنسك هاتك % % 14(@)(@@) % فاخلع ثياب النسك فيها واسترح % % من إفك لاح في الصبابة آفك % % 15(@)(@@) % أولا فدع دعوى المحبة واجتنب % % نهج الغرام فلست فيه بسالك % 16(@)(@@) % وإذا بدا منها المحيا فاستعذ % من سافر لدم الأحبة سافك % % 17(@)(@@) % كم من محب قد قضى في حبها % % وجدا عليه فكان أهون هالك % % 18(@)(@@) % ملكت نفوس أولي الغرام بأسرها % % علا اتقيت الله يا ابنة مالك % % 19(@)(@@) % حسبي ولوعا في هواك ولوعة % إن تطلبي قتلي ظفرت بذلك % % PageV01P286 البحر : طويل 1(@)(@@) % ألا هل درت من أقصدت أسهم الهلك % % فأصبح عقد المجد منفصم السلك % 2(@)(@@) % وهل علمت ماذا جنته يد الردى % % لقد فتكت ويل أمها أيما فتك % % 3(@)(@@) % أباحت حمى ما راعه قط حادث % وأردت فتى للأخذ يدعى وللترك % 4(@)(@@) % أصمت برزء عم فادحه الورى % % وخص به بيت النبوة والملك % % 5(@)(@@) % فأي فؤاد لا يذوب من الأسى % % وأية عين لا تفيض ولا تبكي % % 6(@)(@@) % أصمت بزين العابدين نعاته % % فكم ثم من سمع بمنعاه مستك % 7(@)(@@) % سرى نعيه قبل اليقين ولم أكن % % لأحسبه إلا مقالا من الإفك 