ms130	 ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1186 ) قال النبي :(@)(@@) | 30 ( إذا تناول أحدكم عن أخيه شيئا فليره إياه ) )(@)(@@) ( د ) في مراسيله عن ابن شهاب ( قط ) في الأفراد عنه عن أنس رضي الله عنه بلفظ : ( إذا نزع ) .(@)(@@)(@@)(@@) $ ( 1187 ) قال النبي :(@)(@@) | 30 ( إذا تنخم أحدكم فلا يتنخمن قبل وجهه ولا عن يمينه ، وليبصقن عن يساره أو تحت قدمه اليسرى ) )(@)(@@) ( فر ه ) عن أبي هريرة وأبي سعيد رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1188 ) قال النبي :(@)(@@) | 30 ( إذا تنخم أحدكم وهو في المسجد فليغيب نخامته لا تصيب جلد مؤمن أو ثوبه فتؤذيه ) )(@)(@@) ( حم ع ) و ابن خزيمة ( هب ) والضياء عن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1189 ) قال النبي :(@)(@@) | 30 ( إذا تواضع العبد رفعه الله إلى السماء السابعة ) )(@)(@@) ( الخرائطي ) في مكارم الأخلاق عن ابن عباس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1190 ) قال النبي :(@)(@@) | 30 ( إذا توضأ أحدكم فأحسن الوضوء ثم خرج إلى الصلاة لم يرفع قدمه اليمنى إلا كتب الله عز وجل له حسنة ، ولم يضع قدمه اليسرى إلا حط الله عنه سيئة ، فليقرب أحدكم أو ليبعد ، فإن أتى المسجد فصلى في جماعة غفر له ، فإن أتى المسجد وقد صلوا بعضا وبقي بعض صلى ما أدرك وأتم ما بقي ، فإن أتى المسجد وقد صلوا فأتم الصلاة كان كذالك ) )(@)(@@) ( د هق ) عن رجل من الأنصار ( ز ) .(@)(@@)(@@)(@@) $ ( 1191 ) قال النبي :(@)(@@) | 30 ( إذا توضأ أحدكم فأحسن الوضوء ثم خرج إلى المسجد لا ينزعه إلا الصلاة ، لم تزل رجله اليسرى تمحو عنه سيئة وتكتب له اليمنى حسنة حتى يدخل المسجد ، ولو يعلم الناس ما في العتمة والصبح لأتوهما ولو حبوا ) )(@)(@@) ( طب ك هب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 1192 ) قال النبي :(@)(@@) | 30 ( إذا توضأ أحدكم فأحسن وضوءه ثم خرج عامدا إلى المسجد فلا يشبكن بين يديه فإنه في صلاة ) )(@)(@@) ( حم د ت ) عن كعب بن عجرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1193 ) قال النبي :(@)(@@) | 30 ( إذا توضأ أحدكم فليجعل في أنفه ماء ثم يستنثر وإذا PageV01P186 استجمر فليوتر ) )(@)(@@) ( مالك حم ق د ن ) عن 
ms131	 أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1194 ) قال النبي :(@)(@@) | 30 ( إذا توضأ أحدكم فليجعل في أنفه ماء ثم لينتثر ، وإذا استنثر فليستنثر وترا ) )(@)(@@) ( أبو نعيم في المستخرج ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1195 ) قال النبي :(@)(@@) | 30 ( إذا توضأ أحدكم فلا يغسل أسفل رجليه بيده اليمنى ) )(@)(@@) ( عد ) عن أبي هريرة رضي الله عنه وهو مما بيض له الديلمي .(@)(@@)(@@)(@@) $ ( 1196 ) قال النبي :(@)(@@) | 30 ( إذا توضأ أحدكم في بيته ثم أتى المسجد كان في صلاة حتى يرجع فلا يقل هاكذا وشبك بين أصابعه ) )(@)(@@) ( ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1197 ) قال النبي :(@)(@@) | 30 ( إذا توضأ أحدكم للصلاة فلا يشبك بين أصابعه ) )(@)(@@) ( طص ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1198 ) قال النبي :(@)(@@) | 30 ( إذا توضأ أحدكم ولبس خفيه فليصل فيهما وليمسح عليهما ثم لا يخلعهما إن شاء إلا من جنابة ) )(@)(@@) ( قط ك ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1199 ) قال النبي :(@)(@@) | 30 ( إذا توضأ الرجل المسلم خرجت خطاياه من سمعه وبصره ويديه ورجليه ، فإن قعد قعد مغفورا له ) )(@)(@@) ( حم طب ) عن أبي أمامة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1200 ) قال النبي :(@)(@@) | 30 ( إذا توضأ العبد المؤمن فتمضمض خرجت الخطايا من فيه ، فإذا استنثر خرجت الخطايا من أنفه ، فإذا غسل وجهه خرجت الخطايا من وجهه حتى تخرج من تحت أشفار عينيه ، فإذا غسلليديه خرجت الخطايا من يديه PageV01P187 حتى تخرج من تحت أظفار يديه فإذا مسح برأسه خرجت الخطايا من رأسه حتى تخرج من أذنيه ، فإذا غسل رجليه خرجت الخطايا من رجليه حتى تخرج من تحت أظفار رجليه ، ثم كان مشيه إلى المسجد وصلاته له نافلة ) )(@)(@@) ( مالك حم ن ه ك ) عن عبد الله الصنابحي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1201 ) قال النبي :(@)(@@) | 30 ( إذا توضأ العبد المسلم أو المؤمن فغسل وجهه خرج من وجهه كل خطيئة نظر إليها بعينيه مع الماء أو مع آخر قطر الماء ، فإذا غسل يديه خرجت من يديه كل خطيئة كان بطشتها يداه مع الماء أو مع آخر قطر الماء 
ms132	 ، فإذا غسل رجليه خرجت كل خطيئة مشتها رجلاه مع الماء أو مع آخر قطر الماء حتى يخرج نقيا من الذنوب ) )(@)(@@) مالك والشافعي ( م ت ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1202 ) قال النبي :(@)(@@) | 30 ( إذا توضأ العبد تحات عنه ذنوبه كما تحات ورق هاذه الشجرة ) )(@)(@@) ( هب ) عن سل مان رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1203 ) قال النبي :(@)(@@) | 30 ( إذا توضأت فانتثر ، وإذا استجمرت فأوتر ) )(@)(@@) ( حم ت ن ه حب ) عن مسلمة بن قيس الأشجعي ( ز ) .(@)(@@)(@@)(@@) $ ( 1204 ) قال النبي :(@)(@@) | 30 ( إذا توضأت فإنتضح ) )(@)(@@) ( ه ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1205 ) قال النبي :(@)(@@) | 30 ( إذا توضأت فخلل أصابع يديك ورجليك ) )(@)(@@) ( ت ك ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1206 ) قال النبي :(@)(@@) | 30 ( إذا توضأت خلل الأصابع ) )(@)(@@) ( ت ك ) عن لقيط بن صبرة رضي الله عنه ( ز ) .(@)(@@) PageV01P188(@)(@@)(@@)(@@) $ ( 1207 ) قال النبي :(@)(@@) | 30 ( إذا توضأتم فابدؤوا بميامنكم ) )(@)(@@) ( ه ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1208 ) قال النبي :(@)(@@) | 30 ( إذا توفي أحدكم فوجد شيئا فليكفن في ثوب حبرة ) )(@)(@@) ( د والضياء ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1209 ) قال النبي :(@)(@@) | 30 ( إذا ثوب للصلاة فلا تأتوها وأنتم تسعون وأتوها وعليكم السكينة فما أدركتم فصلوا وما فاتكم فأتموا ، فإن أحدكم إذا كان يعمد إلى الصلاة فهو في صلاة ) )(@)(@@) ( م ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1210 ) قال النبي :(@)(@@) | 30 ( إذا جاء أحدكم الجمعة فلا يقيمن أحدا من مقعده ثم يقعد فيه ) )(@)(@@) ( الخرائطي في مكارم الأخلاق ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1211 ) قال النبي :(@)(@@) | 30 ( إذا جاء أحدكم الجمعة فليغتسل ) )(@)(@@) ( مالك ق ن ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 1212 ) قال النبي :(@)(@@) | 30 ( إذا جاء أحدكم الجمعة فليغتسل وليستنظف ) )(@)(@@) ( ابن عساكر ) عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1213 ) قال النبي :(@)(@@) | 30 ( إذا جاء أحدكم إلى الصلاة فليمش على هينة فليصل ما أدرك وليقض ما سبقه ) )(@)(@@) ( حم د هق ) و الضياء عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1214 ) قال النبي :(@)(@@) | 30 ( إذا جاء أحدكم إلى المسجد 
ms133	 فليصل سجدتين من قبل أن يجلس ثم ليقعد بعد إن شاء أو ليذهب لحاجته ) )(@)(@@) ( د ) عن أبي قتادة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1215 ) قال النبي :(@)(@@) | 30 ( إذا جاء أحدكم إلى المسجد فلينظر فإن رأى في نعليه قذرا أو أذى فليمسحه وليصل فيهما ) )(@)(@@) ( د ) عن أبي سعيد رضي الله عنه ( ز ) .(@)(@@) PageV01P189(@)(@@)(@@)(@@) $ ( 1216 ) قال النبي :(@)(@@) | 30 ( إذا جاء أحدكم إلى مجلس فاوسع له فليجلس فإنها كرامة أكرمه الله بها وأخوه المسلم ، فإن لم يوسع فلينظر أوسع موضع فليجلس فيه ) )(@)(@@) ( خط ) عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1217 ) قال النبي :(@)(@@) | 30 ( إذا جاء أحدكم فأوسع له أخوه فإنما هي كرامة أكرمه الله بها ) )(@)(@@) ( تخ هب ) عن مصعب بن شيبة .(@)(@@)(@@)(@@) $ ( 1218 ) قال النبي :(@)(@@) | 30 ( إذا جاء أحدكم يوم الجمعة والإمام يخطب فليصل ركعتين وليتجوز فيهما ) )(@)(@@) ( حم ق د ن ه ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1219 ) قال النبي :(@)(@@) | 30 ( إذا جاء أحد يطلب ثمن الكلب فاملأ كفه ترابا ) )(@)(@@) ( د هق ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1220 ) قال النبي :(@)(@@) | 30 ( إذا جاء الرجل يعود مريضا فليقل : اللهم اشف عبدك فلانا ينكأ لك عدوا أو يمش لك إلى الصلاة ) )(@)(@@) ( حم د ) و ابن السنى ( طب ك ) عن ابن عمرو رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1221 ) قال النبي :(@)(@@) | 30 ( إذا جاء الموت لطالب العلم وهو على هاذه الحالة مات وهو شهيد ) )(@)(@@) ( البزار ) عن أبي ذر وأبي هريرة رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 1222 ) قال النبي :(@)(@@) | 30 ( إذا جئت إلى الصلاة فوجدت الناس يصلون فصل معهم ، وإن كنت قد صليت تكن لك نافلة وهاذه مكتوبة ) )(@)(@@) ( د هق ) عن يزيد بن عامر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1223 ) قال النبي :(@)(@@) | 30 ( إذا جئت فصل مع الناس وإن كنت قد صليت ) )(@)(@@) مالك والشافعي ( ن حب ) عن محجن رضي الله عنه ( ز ) .(@)(@@) PageV01P190(@)(@@)(@@)(@@) $ ( 1224 ) قال النبي :(@)(@@) | 30 ( إذا جئتم الصلاة ونحن سجود فاسجدوا ولا تعدوها شيئا ، ومن أدرك الركعة فقد أدرك الصلاة ) )(@)(@@) ( د ك هق ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1225 
ms134	 ) قال النبي :(@)(@@) | 30 ( إذا جاء خادم أحدكم بطعامه فليقعده معه أو ليناوله منه فإنه هو الذي ولي حره ودخانه ) )(@)(@@) ( حم ه ) عن ابن مسعود رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1226 ) قال النبي :(@)(@@) | 30 ( إذا جاء رمضان فتحت أبواب الجنة وغلقت أبواب النار وصفدت الشياطين ) )(@)(@@) ( ن ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1227 ) قال النبي :(@)(@@) | 30 ( إذا جاء رمضان فتحت أبواب الرحمة ، وغلقت أبواب جهنم ، وسلسلت الشياطين ) )(@)(@@) ( ن ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1228 ) قال النبي :(@)(@@) | 30 ( إذا جاء رمضان فصم ثلاثين إلا أن ترى الهلال قبل ذالك ) )(@)(@@) ( طب ) عن عدي بن حاتم رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1229 ) قال النبي :(@)(@@) | 30 ( إذا جاءكم الأكفاء فأنكحوهن ولا تربصوا بهن الحدثان ) )(@)(@@) ( فر ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 1230 ) قال النبي :(@)(@@) | 30 ( إذا جاءكم الزائر فأكرموه ) )(@)(@@) ( الخرائطي في مكارم الأخلاق فر ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1231 ) قال النبي :(@)(@@) | 30 ( إذا جاءك من هاذا المال شيء وأنت غير مستشرف ولا سائل فخذه ، وما لا فلا تتبعه نفسك ) )(@)(@@) ( خ ) عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1232 ) ق ال النبي :(@)(@@) | 30 ( إذا جامع أحدكم امرأته فلا يتنح حتى تقضي حاجتها كما يحب أن تقضى حاجته ) )(@)(@@) ( عد ) عن طلق رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1233 ) قال النبي :(@)(@@) | 30 ( إذا جامع أحدكم أهله فليصدقها ، ثم أذا قضى PageV01P191 حاجته قبل أن تقضي حاجتها فلا يعجلها حتى تقضي حاجتها ) )(@)(@@) ( عب ع ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1234 ) قال النبي :(@)(@@) | 30 ( إذا جامع أحدكم أهله فليصدقها فإن سبقها فلا يعجلها ) )(@)(@@) ( ع ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1235 ) قال النبي :(@)(@@) | 30 ( إذا جامع أحدكم زوجته أو جاريته فلا ينظر إلى فرجها فإن ذالك يورث العمى ) )(@)(@@) ( بقي بن مخلد عد ) عن ابن عباس رضي الله عنهما قال ابن الصلاح : جيد الإسناد .(@)(@@)(@@)(@@) $ ( 1236 ) قال النبي :(@)(@@) | 30 ( إذا جامع أحدكم فلا ينظر إلى الفرج فإنه يورث العمى ولا يكثر الكلام فإنه يورث الخرس ) )(@)(@@) ( الأزدي في الضعفاء والخليلي في مشيخته فر ) عن أبي هريرة رضي 
ms135	 الله عنه .(@)(@@)(@@)(@@) $ ( 1237 ) قال النبي :(@)(@@) | 30 ( إذا جامع الرجل امرأته ثم أكسل فليغسل ما أصاب المرأة منه ثم ليتوضأ ) )(@)(@@) ( حم ق ) عن أبي بن كعب رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1238 ) قال النبي :(@)(@@) | 30 ( إذا جاوز الختان الختان فقد وجب الغسل ) )(@)(@@) ( حم ت ) عن عائشة ( طب ) عن أبي أمامة وعن رافع بن خديج ( الشيرازي ) في الألقاب عن معاذ رضي الله عنهم ( ز ) .(@)(@@)(@@)(@@) $ ( 1239 ) قال النبي :(@)(@@) | 30 ( إذا جعلت إصبعيك في أذنيك سمعت خرير الكوثر ) ( قط ) عن ع$ ائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 1240 ) قال النبي :(@)(@@) | 30 ( إذا جعلت بين يديك مثل مؤخرة الرحل فلا يضرك من مر بين يديك ) )(@)(@@) ( د ) عن طل حة بن عبيد الله ( ز ) .(@)(@@) PageV01P192(@)(@@)(@@)(@@) $ ( 1241 ) قال النبي :(@)(@@) | 30 ( إذا جلس أحدكم على حاجته فلا يستقبل القبلة ولا يستدبرها ) )(@)(@@) ( م ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1242 ) قال النبي :(@)(@@) | 30 ( إذا جلس القاضي في مجلسه هبط عليه ملكان يسددانه ويوفقانه ويرشدانه ما لم يجر ، فإذا جار عرجا وتركاه ) )(@)(@@) ( هق ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1243 ) قال النبي :(@)(@@) | 30 ( إذا جلس إليك الخصمان فسمعت من أحدهما فلا تقض لأحدهما حتى تسمع من الآخر كما سمعت من الأول ، فإنك إذا فعلت ذالك تبين لك القضاء ) )(@)(@@) ( حم ك هق ) عن علي رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1244 ) قال النبي :(@)(@@) | 30 ( إذا جلس بين شعبها الأربع ثم جهدها فقد وجب عليه الغسل وإن لم ينزل ) )(@)(@@) ( حم ق ن ه ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1245 ) قال النبي :(@)(@@) | 30 ( إذا جلس بين شعبها الأربع ومس الختان الختان فقد وجب الغسل ) )(@)(@@) ( م ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 1246 ) قال النبي :(@)(@@) | 30 ( إذا جلست في صلاتك فلا تتركن الصلاة علي فإنها زكاة الصلاة ) )(@)(@@) ( قط ) عن بريدة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1247 ) قال النبي :(@)(@@) | 30 ( إذا جلستم فاخلعوا نعالكم تسترح أقدامكم ) )(@)(@@) ( البزار ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1248 ) قال النبي :(@)(@@) | 30 ( إذا جمرتم الميت فأوتروا ) )(@)(@@) ( حب ك ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1249 ) قال النبي 
ms136	 :(@)(@@) | 30 ( إذا جمع الله الأولين والآخرين ليوم لا ريب فيه PageV01P193 نادى مناد : من كان أشرك في عمل عمله لله أحدا فليطلب ثوابه من عنده ، فإن الله أغنى الشركاء عن الشرك ) )(@)(@@) ( حم ت ه ) عن أبي سعيد بن أبي فضالة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1250 ) قال النبي :(@)(@@) | 30 ( إذا جمع الأولين والآخرين يوم القيامة يرفع لكل غادر لواء ، فقيل : هاذه غدرة فلان بن فلان ) )(@)(@@) ( م ) عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1251 ) قال النبي :(@)(@@) | 30 ( إذا جمع الله الخلائق يوم القيامة أذن لامة محمد في السجود فيسجدون له طويلا ثم يقال لهم : ارفعوا رؤوسكم فقد جعلنا عدتكم من الكفار فداء لكم من النار ) )(@)(@@) ( ه طب ) عن أبي موسى ا رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1252 ) قال النبي :(@)(@@) | 30 ( إذا جهل على أحدكم وهو صائم فليقل : أعوذ بالله منك إني صائم ) )(@)(@@) ( ابن السنى ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1253 ) قال النبي :(@)(@@) | 30 ( إذا حاك في نفسك شيء فدعه ) )(@)(@@) ( حم حب ك ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1254 ) قال النبي :(@)(@@) | 30 ( إذا حج الرجل بمال من غير حله فقال : لبيك اللهم لبيك ، قال الله : لا لبيك ولا سعديك هاذا مردود عليك ) )(@)(@@) ( عد فر ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 1255 ) قال النبي :(@)(@@) | 30 ( إذا حج الرجل عن والديه تقبل منه ومنهما واستبشر به أرواحهما في السماء ) )(@)(@@) ( قط ) عن زيد بن أرقم رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1256 ) قال النبي :(@)(@@) | 30 ( إذا حج الصبي فهي له حجة حتى يعقل ، فإذا عقل عليه حجة أخرى ، وإذا حج الأعرابي فهي له حجة فإذا هاجر فعليه حجة أخرى ) )(@)(@@) ( ك ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@) PageV01P194(@)(@@)(@@)(@@) $ ( 1257 ) قال النبي :(@)(@@) | 30 ( إذا حدث الرجل بحديث ثم التفت فهي أمانة ) )(@)(@@) ( حم د ت ) و الضياء عن جابر ( 4 ) عن أنس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 1258 ) قال النبي :(@)(@@) | 30 ( إذا حدثتم الناس عن ربهم فلا تحدثوهم بما يفزعهم ويشق عليهم ) )(@)(@@) ( الحسن بن سفيان طس عد هب ) عن المقدام بن معدي كرب 
ms137	 رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1259 ) قال النبي :(@)(@@) | 30 ( إذا حدثكم أهل الكتاب حديثا فقولوا آمنا بالله وملائكته وكتبه ورسله ) )(@)(@@) ( ك ) عن عامر بن ربيعة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1260 ) قال النبي :(@)(@@) | 30 ( إذا حرم أحدكم الزوجة والولد فعليه بالجهاد ) )(@)(@@) ( طب ) عن محمد بن حاطب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1261 ) قال النبي :(@)(@@) | 30 ( إذا حسدتم فلا تبغوا ، وإذا ظننتم فلا تحققوا ، وإذا تطيرتم فامضوا وعلى الله فتوكلوا ) )(@)(@@) ( عد ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1262 ) قال النبي :(@)(@@) | 30 ( إذا حضر أحدكم الأمر يخشى فوته فليصل هاذه الصلاة يعني الجمع بين الصلاتين ) )(@)(@@) ( ن ) عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1263 ) قال النبي :(@)(@@) | 30 ( إذا حضر أحدكم الصلاة في مسجده فليجعل لبيته نصيبا من صلاته ، فإن الله جاعل في بيته من صلاته خيرا ) )(@)(@@) ( حم م ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1264 ) قال النبي :(@)(@@) | 30 ( إذا حضر العلماء ربهم يوم القيامة كان معاذ بن جبل بين أيديهم بقذفة حجر ) )(@)(@@) ( ابن عساكر ) عن عمر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1265 ) قال النبي :(@)(@@) | 30 ( إذا حضر المؤمن أتته ملائكة الرحمة بحريرة بيضاء PageV01P195 فيقولون اخرجي راضية مرضيا عنك إلى روح وريحان ورب غير غضبان فيخرج كأطيب ريح المسك حتى إنه ليناوله بعضهم بعضا حتى يأتوا به باب السماء فيقولون : ما أطيب هاذا الريح التي جاءتكم من الأرض فيأتون به أرواح المؤمنين فلهم أشد فرحا به من أحدكم بغائبه يقدم عليه ، فيسألونه : ماذا فعل فلان ، ماذا فعل فلان ؟ فيقولون : دعوه فإنه كان في غم الدنيا ، فإذا قال : أما أتاكم ؟ قالوا : ذهب به إلى أمه الهاوية ، وإن الكافر إذا حضر أتته ملائكة العذاب بمسح فيقولون : اخرجي ساخطة مسخوطا عليك إلى عذاب الله ، فيخرج كأنتن ريح جيفة حتى يأتوا بها باب الأرض ، فيقولون : ما أنتن هاذه الريح حتى يأتوا بها أرواح الكفار ) )(@)(@@) ( ن ك ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1266 ) قال النبي :(@)(@@) | 30 ( إذا حضرتم الميت فقولوا خيرا فإن الملائكة يؤمنون على ما تقولون ) )(@)(@@) ( حم ( 4 ) حب ك 
