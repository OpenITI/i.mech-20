ms118	 بی گزند و بی آزار PageV1P101(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 با من امروز که بوده ست بدین دشت اندر %~% تا بگوید که چه کرد آن ملک شیر شکر(@)(@@) 2 هر که او صید گه شاه ندیده ست امروز %~% بنداند به عیان تاش نگویی به خبر(@)(@@) 3 چون توان گفت که امروز چه کرد و چه نمود %~% آن خداوند سخا گستر بسیار هنر(@)(@@) 4 که توانستی آن صید بسر برد جز او %~% که توانستی آن شغل جز او برد بسر(@)(@@) 5 هیچ خاطر نتوان کرد مر این حال صفت %~% کی بود خاطر کس را بچنین جای خطر(@)(@@) 6 صید گاه ملک دادگر عالم را %~% باز نشناختم امروز همی از محشر(@)(@@) 7 از غلامان حصاری چو حصاری پره کرد %~% گرد دشتی که بصد ره نپرد مرغ بپر(@)(@@) 8 از دد و دام همه دشت چنان گشت روان %~% که همی تیره شد از دیدن آن دشت بصر(@)(@@) 9 مرغ از آن پره برون رفت ندانست همی %~% ز استواری که همی پره زدند آن لشکر(@)(@@) 10 ملک عالم عادل پسر شاه جهان %~% میر ابو احمد محمود سر افراز گهر(@)(@@) 11 در میان پره در تاخت کمان کرده بزه %~% جفت باعزت و بادولت و با فتح و ظفر(@)(@@) 12 از چپ و راست شکاری همی افکند بتیر %~% تا بیفکند شکاری بی اندازه و مر(@)(@@) 13 ناوک او چو برون جستی از پهلوی رنگ %~% سفری کردی چندان که کند چشم سفر(@)(@@) 14 عزم دیدم چو خسک کرده ز بس پیکان پشت %~% کرگ دیدم چو سغر کرده ز بس ناوک بر(@)(@@) 15 این همی رفت و همه روی پر از خون دو چشم %~% وان همی گفت وهمه سینه پر از خون جگر(@)(@@) 16 راست گفتی که شکسته سپه خانندی %~% پیش محمود شه ایران در دشت کتر(@)(@@) 17 گور خر بودهمه دشت در افکنده بهم %~% همه را دوخته پهلو وبر و سینه و سر(@)(@@) 18 هیچ شه را بجهان صید 
ms119	 گهی بود چنین %~% هیچ شه کرد چنین صید بآفاق اندر(@)(@@) 19 راست گفتی که بدین روز همی در نگرم %~% کوبر آهیخته بد پیش صف اندر خنجر(@)(@@) 20 همچنان کاین گله گور درین دشت فراخ %~% لشکر دشمن او خسته و افکنده سپر(@)(@@) 21 این ز کوپال گران خوردن مغفر همه پست %~% وان ز خون دل و از خون جگر جوشن تر(@)(@@) 22 در دل هر یک از ناوک او سیصد راه %~% دربر هر یک از نیزه او سیصد در(@)(@@) 23 لشکر دشمن او مویه گر و لشکر او %~% لب پر از خنده ودلها همه پر ناز و بطر(@)(@@) 24 من در آن فتح یکی مدح برو خوانده بدیع %~% مدح او خوانده وزو یافته بسیاری زر(@)(@@) 25 فال نیکو زدم «ارجو» که چنین باشد راست %~% تا زنم او راهر روز یکی فال دگر(@)(@@) 26 تا بتلخی نبود شهد شهی همچو شرنگ %~% تا بخوشی نبود صبر سقوطر چو شکر(@)(@@) 27 نابتابش نبود نجم سها همچو سهیل %~% تا بخوبی نبود هیچ ستاره چو قمر(@)(@@) 28 کامران باش و به نهمت رس و بی انده زی %~% شادمان باش و ز جان و ز جوانی برخور PageV1P102(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 نبود عاشقی امسال مر مرا در خور %~% کنون که آمد بر خط نهاد باید سر(@)(@@) 2 مرا تو گویی کز عشق چون حذر نکنی %~% کسی نمای مرا کو کند ز عشق حذر(@)(@@) 3 اگر بدست منستی حذر چنان کنمی %~% که رفته بود می از دست او به روم و خزر(@)(@@) 4 بر آسمان ز غم عاشقیست اختر من %~% بر آن گری که مر او را چنین بود اختر(@)(@@) 5 تو گویی این دل من جایگاه عشق شده ست %~% نه جایگاه که لشکرگهی پر از لشکر(@)(@@) 6 هنوز عشق کهن خانه باز داده نبود %~% که عشق تازه بدر باز کوفت حلقه در(@)(@@) 7 خدای جز دل من عشق را پدید کناد %~% دری اگر بجهان اندرون دریست دگر(@)(@@) 8 
ms120	 اگر بشهد و شکر ماند آن حلاوت عشق %~% ملول گشتم و سیر آمدم ز شهد و شکر(@)(@@) 9 دلم تباه شدستی ز عشق اگر شب و روز %~% زمدح خسرو جزوی نکرد می از بر(@)(@@) 10 امیر عالم عادل محمد محمود %~% که روزگار بدو باز یافت عدل عمر(@)(@@) 11 بزرگواری کز روزگار آدم باز %~% چو او و چون پدر او ملک نبود دگر(@)(@@) 12 چو علم خواهد گفتن سپند باید سوخت %~% که بیم چشم بدان دور باد از ان مهتر(@)(@@) 13 بخوب سیرتیش گر بخواهدی کندی %~% مصنفی بزمانی دو صد کتاب سیر(@)(@@) 14 خدای در سراو همتی نهاد بزرگ %~% چنانکه گنج به رنجست از آن و دل به فکر(@)(@@) 15 هر آنکه همت داده ست طاقتی بدهاد %~% چنانکه باشد باهمتی چنان درخور(@)(@@) 16 بیابد آخر سلطان زیاد اونظرش %~% بکام خویش رسد میر و ماهمه یکسر(@)(@@) 17 یکان یکان هم از اکنون همی پدید آید %~% بر این حدیث گواهی دهد دوات گهر(@)(@@) 18 ایا بمرتبت وقدر و جاه افریدون %~% ایا بمنزلت و نام نیک اسکندر(@)(@@) 19 چرا دوات گهر داد شاه شرق بتو %~% در این حدیث تأمل کن و نکو بنگر(@)(@@) 20 دوات را غرض آن بودکاندر و قلمست %~% قلم برابر تیغست بلکه فاضل تر(@)(@@) 21 نیامد آنچه ز نوک قلم پدید آمد %~% ز تیغ و خنجر افراسیاب و رستم زر(@)(@@) 22 قلم بساعتی آن کارها تواند کرد %~% که عاجز آید از آن کارها قضا و قدر(@)(@@) 23 قلم بود که ز جایی بتو سخن گوید %~% که مرغ اگر زبرش بگذرد بریزد پر(@)(@@) 24 ملوک را گه و بیگاه پیش دشمن خویش %~% قلم بمنزلت لشکری بود بیمر(@)(@@) 25 بسا سپاه گرانا که پی سپار شدند %~% ز جنبش قلمی تار و مار وزیر و زبر(@)(@@) 26 ملوک را قلم و تیغ برترین سپهیست %~% بترسد از قلم و تیغ شیر شرزه نر(@)(@@) 27 بنای ملک به تیغ و قلم کنند قوی %~% بدین دو چیز 