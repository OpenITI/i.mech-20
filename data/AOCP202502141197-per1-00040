ms31	 هم آنجا بمرد %~% کس از وی به حله نشانی نبرد(@)(@@) (@@) چو بر کرد سر مهر تابان ز شرق %~% ز خون روی آوردگه داد برق(@)(@@) (@@) بیامد یکی دختر نورسید %~% چو آنجا فگنده پدر را بدید(@)(@@) (@@) 7 دریده بر سیمگونش به تیغ %~% شدش هر دو دیده چو بارنده میغ PageV01P030(@)(@@) ![image filename](./0550Anonymous.HumayNama_0096.jpg)(@)(@)(@@) (@@) ز سر موی برکند و زد جامه چاک %~% پراگند بر سر دو سد راه خاک(@)(@@) (@@) همای گزین را بر او دل بسوخت %~% به شرمش ز گفتار دو لب بدوخت(@)(@@) (@@) بشد دختر و با سلاح و ستور %~% بیامد بیستاد و بفزود شور(@)(@@) (@@) همای گزین را به دشنام زشت %~% برآورد و بردش همه نام زشت(@)(@@) (@@) 24ورا گفت با من بیا سوی جنگ %~% که خواهد شد از منت پرگار تنگ4 210(@)(@@) (@@) منم دختر این هنرور جوان %~% که او را تهی کردی از تن تو جان(@)(@@) (@@) کنون گر نجویم ز تو کین او %~% یله کرده باشم من آیین او(@)(@@) (@@) همای دلاور ورا گفت من %~% نکشتم بیامد یکی اهرمن(@)(@@) (@@) چو آورده بودم بزیرش بکشت %~% ز من وی نخوردست زخم درشت(@)(@@) (@@) ز من خواست زنهار و من خواستم %~% ورا داد زنهار و برخاستم(@)(@@) (@@) دوید و برش دیؤزادی درید %~% ببایست کشتن ورا کین سزید(@)(@@) (@@) مرا با زنان کین و پیگار نیست %~% که از زن مرا هیچ آزار نیست(@)(@@) (@@) بویژه ز چون تو بتی خوب چهر %~% که رشکت برد بر دو رخ ماه و مهر(@)(@@) (@@) دگرباره دخترش گفت این بتر %~% که چندان یلان را بریدی تو سر(@)(@@) (@@) 35پیاده کنون زنده خواهی شدن %~% میندیش کین خود نشاید بدن(@)(@@) (@@) همای دلاور بخندید و گفت %~% نماند ز کس زور و مردی نهفت(@)(@@) (@@) پیاده فگندم من این را به خاک %~% که از بهر او جامه کردی تو چاک(@)(@@) (@@) ستور وی و هرچه هست آن ماست %~% بنگذاریم گر تو فرمان تراست(@)(@@) (@@) بیا تا ترا نیز پیچان کنم %~% چو دیگر جوانانت بیجان کنم(@)(@@) جنگ همای و دختر عرابی(@)(@@) ~~240چو این گفت دختر درامد به کین 
ms32	(@)(@@) ~~برانکیخت کردی که شد هور تار(@)(@@) ~~چنان زدش یک تیغ بر تار و ترگ PageV01P031(@)(@@) ![image filename](./0550Anonymous.HumayNama_0097.jpg)(@)(@)(@@) (@@) نه بس زخمی اندک به تارش رسید %~% ولیکن چو خانی ازو خون دوید(@)(@@) (@@) چو خون دید شهزاده جوشان زتار %~% بغرید مانند رعد بهار(@)(@@) (@@) 2یکی زخم زد هر دو پای ستور %~% بیفگند و چون شیر بفزود شور(@)(@@) (@@) بیاده دگرباره دختر دوید %~% یکی تیغ سیمابگون برکشید(@)(@@) (@@) کجا بر زند بر سر شهریار %~% سپر در سر آورد پس نامدار(@)(@@) (@@) زدش بر سپر نیمی افگند از اوی %~% یکی درقه افتاده بد نامجوی(@)(@@) (@@) ربود از زمین و بدو روی داد %~% ورا گفت ای دختر دیؤزاد(@)(@@) (@@) 25 بلا را ز خواب خوش انگیختی %~% به دام بلا اندرآویختی(@)(@@) (@@) ببینی کنون زخم مردان مرد %~% برآرم به تیغ از تن و جانت گرد(@)(@@) (@@) بدو در شد و تیغ را برکشید %~% زمانی همی گرد دختر دوید(@)(@@) (@@) همی گفت با خود دریغی بود %~% که با دلبری زخم تیغی بود(@)(@@) (@@) ولیکن چو او را مدارا کنم %~% همه نام خود را به خاک افگنم(@)(@@) (@@) 5دگرکم به جنگست از او بیم جان %~% ندیدم چنین جنگیئ در جهان(@)(@@) (@@) ببایدم لابد یکی زخم زد %~% به یک زخم جان از تن او ستد(@)(@@) (@@) همی چند زد زخمهای درشت %~% که شاید از آن زخم سد شیر کشت(@)(@@) (@@) نشد کارگر زخم بر دخترش %~% همی رفت خود خون ز تار سرش(@)(@@) (@@) ز بس خون که رفت از همای دلیر %~% همی خواست گشتن بر او مرگ چیر(@)(@@) (@@) ز خونست زنده تن و جان مرد %~% چو شد خونش از تن برآیدش گرد 220(@)(@@) (@@) درین بد که برخاست گردی ز راه %~% شد آن گرد همراز با مهر و ماه(@)(@@) (@@) شواری همی تاخت مانند باد %~% تو گفتی مگر بود پیوند باد(@)(@@) (@@) بترسید شهزاده و گفت آه %~% کند این که آمد مرا تن تباه(@)(@@) (@@) به یاری این مردمان آید این %~% بکردار شیر دمان آید این(@)(@@) (@@) وگرنه مرا نیست کس یارگر %~% بجز ایزد داور دادگر(@)(@@) (@@) همی گفت دختر به دل 
ms33	 کاین سوار %~% ندانم که تازان ز بهر چه کار(@)(@@) (@@) ز هامون به آوردگه داد روی %~% مگر هست یاریگر نامجوی(@)(@@) (@@) در اندیشهآ این دو کینهآ سگال %~% ز هر دو رسیده شده هوش و هال PageV01P032(@)(@@) ![image filename](./0550Anonymous.HumayNama_0098.jpg)(@)(@)(@@) (@@) که آمد سوار و چر اندر رسید %~% بزد دست و تیغ از میان بردشیا.(@)(@@) (@@) 3 به شهزاده گفت گل ک مکر %~% من آسوده تو رنجه در کارنا(@)(@@) (@@) کجا شاید این چوت یزد دوستی %~% چگونه سزد این ز هم پوستی(@)(@@) (@@) توای زخم خورده به جنگ تذرزن %~% برآسای تا من کشم کین کنون(@)(@@) (@@) همای این چو بشتید ز دنربی %~% کندش بینداخت کین کش همای(@)(@@) (@@) درافگند در گردت دختر ز %~% پس آنگاه زد باز یک خنجر او(@)(@@) (@@) کتف دختر آخت و فگته پست %~% بء خم کمندش فرو بست دست(@)(@@) (@@) بیفگتد بر خک خر رش تژزن %~% دو دستش فرو بسته سخت از کمند(@)(@@) (@@) گل کامکار آمد و زدتر تیغ %~% برافشاند از مغز خونش به میغ(@)(@@) (@@) همی گفت این کثته به کر بذی %~% هگرزش نبد رایزن بخردی3a 4(@)(@@) (@@) شنیدم که چه مرده ین کتته ست %~% چه تنها به خون اندر آغشته است(@)(@@) (@@) نهیب شه شه ز یت بیش بزد %~% که گفتار او بر جگر نیش بود(@)(@@) (@@) بیامد ه تگه گرک مکر %~% بر یار و زخمش ببست استوار(@)(@@) (@@) ستوری ینه دی ی تن ز سز %~% گرفت و بیاورد زی سرفراز(@)(@@) (@@) پس آنگه زر گقت تز خته ی %~% اگر چند بدخواه را بستهای(@)(@@) (@@) همه شب یه بیگر در یرده ی %~% یکی چشم زد هیچ ناسودهای(@)(@@) (@@) نه ماند عرابی نه رن از %~% نه خویشان و نه غمگساران او(@)(@@) (@@) سر یکیک از تیغ تو پست شد %~% کنون کارت ای شاه از دست شد(@)(@@) (@@) ز بس خون که رقتت از تن به رزم %~% برآمد همه کارت آخر به جزم(@)(@@) (@@) یکی کودک اکنون ترا بشکرد %~% ترا این ستور از سوی دز برد(@)(@@) (@@) گل کامکار این چو با وی بگفت %~% برون آمدش رازها از نهفت(@)(@@) (@@) بدان اسپ 
ms34	 شهزاد را برنشاند %~% هوا گرم شد شاهزاده براند(@)(@@) (@@) ز پس ماند لختی گل کامکار %~% بدان تا ببیند ز شه دستکار(@)(@@) (@@) به راه اندرون تشنه شد شاهزاد %~% تنش سست گشت و ز اسپ اوفتاد(@)(@@) (@@) ستورش ز بس تازنان رفت تیز %~% چو آهو که جسته بود از نخیز(@)(@@) (@@) چو از دور دیدش گل کامکار %~% بدانست کاو را فتادست کار PageV01P033(@)(@@) ![image filename](./0550Anonymous.HumayNama_0099.jpg)(@)(@)(@@) (@@) 5عنان سوی ره داد و تازید اسپ %~% چه اسپی بکردار آذرگشسپ(@)(@@) (@@) بیامد همه راه خایندهآ دست %~% نگه کرد شهزاده را دید پست23b 1(@)(@@) (@@) شده بیهش افتاده بر خاک خوار %~% بدریدجامهگل کامکار(@)(@@) (@@) فرود آمد و کرد زاری بروی %~% سترد آن زمان خاک و گردش ز روی(@)(@@) (@@) زبان کردش اندر دهن یک زمان %~% بدان تا گشاید مر او را زبان(@)(@@) (@@) 00چو تر شد زبان همای گزین %~% ورا گفت بربندم ای بت به زین(@)(@@) (@@) مگر جان شیرین سوی دز برم %~% یکی شربت آب ای سمن برخورم(@)(@@) (@@) وگرنه مرا جان برآید ز تن %~% چو خشکم شود باز کام و دهن(@)(@@) (@@) مکن زاری و برنشانم بر اسپ %~% برآن اسپ مانند آذرگشسپ(@)(@@) (@@) تو در پس نشین و مرا پیشدار %~% وگرنه شوم مرده ایدر بزار(@)(@@) (@@) 85 گل کامکار از دو نرگس به در %~% سمن برگ رخسارگان کرد پر(@)(@@) (@@) بر اسپش نشاند و نشست از پسش %~% نبد یارمندی چو دیگر کسش(@)(@@) (@@) همی راند در برگرفته ورا %~% که از پس سواری چو تند اژدها(@)(@@) (@@) به گردون برآورد گرد و دوان %~% ستوری چو بادش بزیر دو ران(@)(@@) (@@) سلاحی تمام از در کارزار %~% بپوشیدهوتیز تازان سوار(@)(@@) (@@) 1ز پس چون گل کامکارش بدید %~% یکی باد سرد از جگر برکشید(@)(@@) (@@) فرود آمد از اسپ وهم در زمان %~% شه نامور را نژند و نوان(@)(@@) (@@) فرود آورید و یکی سایه کرد %~% ورا گفت بر دردم افزود درد(@)(@@) (@@) که آمد ز پس دشمنی سهمناک %~% همی برفشاند به خورشید خاک(@)(@@) (@@) تو خسته روانی و من خستهدل %~% شدستم به تیمار تو بسته دل 24a(@)(@@) (@@) 815بدین سایه در یک زمان 
ms35	 تو غنو %~% که بد خواهی از پس رسیدست نو(@)(@@) (@@) روم من به کین جستنش باز [باز]1 %~% ببینم که تا کیست این سرفراز(@)(@@) (@@) نبرد ار بجوید نبرد آورم %~% سر او به گردون به گرد آورم(@)(@@) (@@) نپیچم به رزم اندرون زو عنان %~% وگر زو به چشمم درآید سنان PageV01P034(@)(@@) ![image filename](./0550Anonymous.HumayNama_0100.jpg)(@)(@)(@@) (@@) تو پژمان مشو هوش برجای دار %~% تن از جان پاکیزه بر پایدار(@)(@@) (@@) نگر تا نیاری به دل در هراس %~% نداری جز از پاک یزدان سپاس(@)(@@) (@@) کزو زور بازو و توش تنست %~% پناه تو اینجا و پشت منست(@)(@@) (@@) پناهد هرآن کو به یزدان پاک %~% ز بدخواه ریمن مر او را چه باک(@)(@@) (@@) به یزدان پناهد چو یزدان پرست %~% نیابد برو هیچ بدخواه دست(@)(@@) (@@) بگفت این و زیر اندر آورد بور %~% فرو ریخت از دیدگان آب شور(@)(@@) (@@) دو دیده بکردار دو رود کرد %~% شه خسته را ماند و بدرود کرد(@)(@@) (@@) براند اسپ را از پس و رفت تیز %~% زنان نعره هزمان به خشم و ستیز(@)(@@) (@@) همیدون هماورد او تازنان %~% به تازش1 درون گشته نعرهزنان(@)(@@) (@@) چو زی یکدگر در رسیدند تنگ %~% کشیدند شمشیر سیماب رنگ(@)(@@) (@@) سخنشان نبد در میان جز به تیغ %~% نخوردند از جان سپردن دریغ(@)(@@) (@@) گه این زد برآن تیغ و گاه آن برین %~% نشد کارگر تیغ گردان کین(@)(@@) (@@) سنان راست کردند بر سینه بر %~% شکستند چون نیزهآ یکدگر(@)(@@) (@@) به گرز گران دست بردند زود %~% بگشتند با هم چو باد و چو دود* 240(@)(@@) (@@) سپر پاره شد لخت شد لخت لخت %~% چو شد لخت لخت اندر آورد لخت(@)(@@) (@@) ز اسپان جنگی فرود آمدند %~% دهنده روان را درود آمدند(@)(@@) (@@) کمرگاه یکدیگران را به زور %~% کشیدند تا شب در آن شر و شور(@)(@@) (@@) نگشتند چون چیره بر یکدگر %~% نشستند دلخسته بر اسپ بر(@)(@@) (@@) برفتند هر دو طلبکار آب %~% که از تشنگیشان جگر شد کباب(@)(@@) (@@) هوازی گل کامکار آن زمان %~% همی راند زی شاه روشن روان(@)(@@) (@@) که یک دم ز آهو به یک آبخور %~% گه آنکه 
ms36	 از شب نهان گشت خور(@)(@@) (@@) گراینده بودند و خوش خورده آب %~% سم هر یکی دیده تر کرده آب(@)(@@) (@@) بنزدیک ایشان شد و آب یافت %~% بخورد و سوی شاهزاده شتافت(@)(@@) (@@) بیاورد وی را و سیراب کرد %~% سخن گفت با او پس از هم نبرد PageV01P035(@)(@@) ![image filename](./0550Anonymous.HumayNama_0101.jpg)(@)(@)(@@) (@@) که چون گشت با او و چون ساخت جنگ %~% به جنگش همه روز چون بد درنگ(@)(@@) (@@) ببخشود بر وی همای گزین %~% بر او از دل پاک کرد آفرین(@)(@@) (@@) 84 ورا گفت جانم تویی داده باز %~% مرا تو رهاندی ازین سرفراز(@)(@@) (@@) وگرنه مرا خسته بودی ز پس %~% نبودی کسم هیچ فریادرس(@)(@@) (@@) کنون جهد آن کن که زی دز شویم %~% ازین جای پیگار بیرون رویم(@)(@@) (@@) که دوری ازینجا تو خسته شوی %~% درین جنگ و پیگار بسته شوی(@)(@@) (@@) من و تو شویم اندرین سهمناک %~% بیابان ازین مرد جنگی هلاک(@)(@@) (@@) 85 نگفت او ترا کز کجا آمدم %~% چرا هم چو تند اژدها آمدم 25a(@)(@@) (@@) ورا گفت شاها گل کامکار %~% نباشد به گیتی چنین یک شوار(@)(@@) (@@) نگوید سخن هیچ با من همی %~% نه در چید از جنگ دامن همی(@)(@@) (@@) اگر شب نبودی طلبکار آب %~% نگشتی درنگش گه شب شتاب(@)(@@) (@@) همین آب جوید که من یافتم %~% تو گویی که از ذوالمنن یافتم(@)(@@) (@@) 8 همانا نیابد وی این آبخور %~% که شد تیره گیتی فرو رفت خور(@)(@@) (@@) هماورد دخت شه نامدار %~% بجست آب هر سو چو از هر کنار(@)(@@) (@@) نیامد چو آب روانش به دست %~% فرود آمد از اسپ و بفتاد پست(@)(@@) (@@) شب تیره روی هوا کرد تار %~% چنان شد بیابان که دریای قار(@)(@@) (@@) نبد هیچ پیدا فراز از نشیب %~% ز بس تیرگی در دل آمد نهیب(@)(@@) (@@) بدانست هنجار دز دخت شاه %~% ستاره بدش رهبر و سیر ماه(@)(@@) (@@) ببرد او شه خسته را شب به دز %~% نزد هیچ سان آب بر لب به دز(@)(@@) (@@) به دز در فرستاد شه را و راند %~% ز پس باز و جان آفرین را بخواند(@)(@@) (@@) ورا گفت تو 
ms37	 بغنو امشب که من %~% روم باز پس تا به هر انجمن(@)(@@) (@@) نگویند کو از سواری گریخت %~% به تیره شب از نامداری گریخت(@)(@@) (@@) بسی لابه کردند و نشنود هیچ %~% به دز در زمانی نیاسود هیچ(@)(@@) (@@) بیامد بیابان بگشتن گرفت %~% به هر گوشهای ره نوشتن گرفت(@)(@@) (@@) هماورد را تا مگر یابد او %~% به جان بردن از تنش بشتابد او(@)(@@) (@@) به گردش درون سوی کوهی فتاد %~% کز آن برز تر کس ندارد به یاد 25b PageV01P036(@)(@@) ![image filename](./0550Anonymous.HumayNama_0102.jpg)(@)(@)(@@) (@@) گهی تیغ او برتر از برج گاو %~% نپریده بر سر مر او را چکاو(@)(@@) (@@) به بالای بررفته چرخ کیان %~% به گردش بیابان و که در میان(@)(@@) (@@) برو بر یکی غار و دیوی در اوی %~% چو میشان به موی و چوگاوان به روی(@)(@@) (@@) سرش چون سرکپی و پای و دست %~% دهانش دهاری همه پر کبست(@)(@@) (@@) به تن مر ورا کاسموی درشت %~% همان بر سر وساق و پهلو وپشت(@)(@@) (@@) دو چشمش بکردار دو چشم غوک %~% ازو آب ریزنده بی درد و سوک(@)(@@) (@@) دو ابروش مانند خارپشتی1 %~% که یکیک به آب بقم بر کشی(@)(@@) (@@) دهان پر ز دندان کژ چپ و راست %~% که از دیدتش جان به تن در بکاست(@)(@@) (@@) سر هر یکی همچو الماس بود %~% بن هر یکی همچو انقاس بود(@)(@@) (@@) دو بینی ورا چون ز دوزخ نمود %~% به دو چشم چون دو گذرگاه دود(@)(@@) (@@) هرش دست مانندهآ یک درخت %~% بر و ناخنش راست چون سنگ سخت(@)(@@) (@@) بکردار یک داس هر ناخنی %~% چو الماس و خارا سری و بنی(@)(@@) (@@) دو لب همچو دوپاره ابر سیاه %~% که گشتی چو خندان همی گاه گاه(@)(@@) (@@) نمودیش دندان ازو هم چنان %~% چو از ابر برق و شرار از دخان(@)(@@) (@@) نخوردی بجز آدمی هیچ چیز %~% نرفتی از آن کوه جایی بنیز(@)(@@) (@@) به پیرامن که به سد میل راه %~% کرا یافتی کردی از بن تباه(@)(@@) (@@) 8بخوردی ز مردم کرا یافتی %~% بسوی دد و دام نشتافتی(@)(@@) (@@) همه روز خفتی به غار اندرون %~% بدی سخت کاهل 
