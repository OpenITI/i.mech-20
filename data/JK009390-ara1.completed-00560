ms555	 مسكا موضوعا ، مثل القرآن إن قرأته وإلا فهو في صدرك ) )(@)(@@) ( الحكيم ) عن عثمان رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5189 ) قال النبي :(@)(@@) | 30 ( إن القلوب بين إصبعين من أصابع الله يقلبها ) )(@)(@@) ( حم ت ك ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5190 ) قال النبي :(@)(@@) | 30 ( إن الكافر ليسحب لسانه يوم القيامة وراءه الفرسخ أو PageV02P250 الفرسخين يتوطؤه الناس ) )(@)(@@) ( حم ت ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 5191 ) قال النبي :(@)(@@) | 30 ( إن الكافر ليعظم حتى إن ضرسه لأعظم من أحد ، وفضيلة جسده على ضرسه كفضيلة جسد أحدكم على ضرسه ) )(@)(@@) ( ه ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5192 ) قال النبي :(@)(@@) | 30 ( إن الكذب باب من أبواب النفاق ) )(@)(@@) ( الخرائطي في مساوىء الأخلاق ) عن أبي أمامة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5193 ) قال النبي :(@)(@@) | 30 ( إن الكذب يكتب كذبا حتى إن الكذيبة تكتب كذيبة ) )(@)(@@) ( حم طب ) عن أسماء بنت عميس رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 5194 ) قال النبي :(@)(@@) | 30 ( إن الكريم ابن الكريم ابن الكريم ابن الكريم يوسف بن يعقوب بن أسحاق بن إبراهيم ولو لبثت في السجن ما لبث ثم أتاني الرسول لأجبت . ورحمة الله على لوط إن كان ليأوي إلى ركن شديد ، قال : لو أن لي بكم قوة أو آوي إلى ركن شديد ، فما بعث الله بعده نبيا إلا في ذروة من قومه ) )(@)(@@) ( ت ك ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5195 ) قال النبي :(@)(@@) | 30 ( إن التي تورث المال غير أهله عليها نصف عذاب الأمة ) )(@)(@@) ( عب ) عن ثوبان رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5196 ) قال النبي :(@)(@@) | 30 ( إن الذي أمشاهم على أرجلهم في الدنيا قادر على أن يمشيهم على وجوههم يوم القيامة ) )(@)(@@) ( حم ق ن ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5197 ) قال النبي :(@)(@@) | 30 ( إن الذي أنزل الداء أنزل الشفاء ) )(@)(@@) ( ك ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5198 ) قال النبي :(@)(@@) | 30 ( إن الذي أنزل الدواء أنزل الدواء ، فجعل شفاء ما PageV02P251 شاء فيما شاء ) )(@)(@@) ( أبو نعيم في الطب ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5199 ) قال النبي 
