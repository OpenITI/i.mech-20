ms721	(@)(@@) % هبك الفرات الذي بالروم مطلعه % أليس والدجلة والعوراء تقطعه % % 2(@)(@@) % من أنت يا من أبوه نصف ساقية % من ياشكوتي وكيف الأرض ترضعه % 3(@)(@@) % أما رضيت بأن تحظى ببيدرة % % من كوخ مصلحة بالقلس تذرعه % % 4(@)(@@) % حتى وليت رقاب الناس كلهم % من شئت تخفضه منهم وترفعه % % PageV01P2847 البحر : - 1(@)(@@) % ضراط ابن ميمون فيه سعه % % وضرط أبي صالح فيه دعه % 2(@)(@@) % فيضرط هذا على رجله % ويضرط هذا على أربعه % 3(@)(@@) % إذا ما تضارط هذا وذا % % سمعت رعودا لها قعقعه % PageV01P2848 البحر : - 1(@)(@@) % إذا كنت لا تستطيع الجما % % ع وأنت لأهل الزنا مجمع % 2(@)(@@) % فإنك في ذاك مثل المسن % % ن يحد الحديد ولا يقطع % PageV01P2849 البحر : - 1(@)(@@) % ادعني يا أخا العلا وادع عوا % % سا ولو كان قبل موتي بساعه % 2(@)(@@) % ولك الله والنبي وأهلو % % ه شهودا والمسلمون جماعه % 3(@)(@@) % أنني لا أروع قلبك بالأك % ل لما فيه عندكم من بشاعه % % 4(@)(@@) % فإذا جاءني رسولك أحكم % % ت أموري بالأكل قبل المجاعه % % 5(@)(@@) % وتزودت عند ذاك من الما % % ء بحسب الإمكان والاستطاعه % 6(@)(@@) % فإذا البول لطني لم يكن قص % دي إلى المستراح والبلاعه % 7(@)(@@) % وتوجهت في الخفاء إلى الشط % ط ففي مثله لمثلي قناعه % % 8(@)(@@) % وفرشت المنديل تحتي وصير % ت تكاي خفي مع الدراعه % % 9(@)(@@) % فارض مني بذاك اليمين وإن % % كان يمينا عليك فيها شناعه % % PageV01P2850 البحر : - 1(@)(@@) % ولحية يحملها مائق % مثل الشراعين إذا أشرعا % % 2(@)(@@) % تقوده الريح بها صاغرا % قودا عنيفا يتعب الأخدعا % % 3(@)(@@) % فإن عدا والريح في وجهه % % لم ينبعث في وجهه إصبعا % % 4(@)(@@) % لو غاص في البحر بها غوصة % صاد بها حيتانه أجمعا % % PageV01P2851 البحر : - 1(@)(@@) % لما تؤذن الدنيا به من شرورها % % يكون بكاء الطفل ساعة يوضع % 2(@)(@@) % وإلا فما يبكيه منها وإنها % % لأفسح مما كان فيه وأوسع % 3(@)(@@) % إذا أبصر الدنيا استهل كأنه % % يرى ما سيلقى من أذاها ويسمع % % 4(@)(@@) % كأني إذا استهللت بين قوابلي % % بدا لي ما ألقى ببابك أجمع % % 5(@)(@@) % وفي بعض أحوال النفوس كأنها % % ترى خلف ستر الغيب ما تتوقع % % 6(@)(@@) % أقول لوجه حال 
ms722	 بعد بياضه % % وإسفاره واللون أسود أسفع % 7(@)(@@) % ألا أيها الوجه الذي غاض ماؤه % % وقد كان فيه مرة يتريع % 8(@)(@@) % ذق الهون والذل الطويل عقوبة % كذا كل وجه لا يعف ويقنع % 9(@)(@@) % وفرت عليه الماء عشرين حجة % % ففرق منه الحرص ما كنت أجمع % 10(@)(@@) % فلا تحم أنفا إن ضرعت فإنه % % كذا كل من يستشعر الحرص يضرع % % PageV01P2852 11(@)(@@) % سعيت لإيقاظ المقادير ضلة % وما كانت الأقدار لو نمت تهجع % % 12(@)(@@) % ولو جهد الساعون في الرزق جهدهم % % لما وقعت إلا بما هي وقع % 13(@)(@@) % أكنت حسبت الله ويحك لم يكن % % تعالى اسمه إلا بصنعك يصنع % % PageV01P2853 البحر : - 1(@)(@@) % كيف يزهو من رجيعه % أبد الدهر ضجيعه % 2(@)(@@) % هو منه وإليه % % وأخوه ورضيعه % 3(@)(@@) % ليس يخلو منه إلا % وقت ما لا يستطيعه % 4(@)(@@) % ثم يلجيه إلى ال % % حش بصغر فيطعيه % % 5(@)(@@) % فإن استعصى عليه % % فهو لا شك صريعه % % 6(@)(@@) % ثم يبدي منه صوتا % ود لو صم سميعه % % 7(@)(@@) % لبحسب المرء عارا % يوجع القلب وجيعه % % 8(@)(@@) % أنه عبد لجعس % يشتريه ويبيعه % PageV01P2854 البحر : - 1(@)(@@) % إذا ما أغاروا فاحتووا مال معشر % أغارت عليهم فاحتوته الصنائع % PageV01P2855 البحر : - 1(@)(@@) % وأما نومكم عن كل خير % كنوم الفهد لا يخشى دفاعا % % PageV01P2856 البحر : - 1(@)(@@) % لئن أخطأت في مدحي % % ك ما أخطأت في منعي % % 2(@)(@@) % لقد أنزلت حاجاتي % % بواد غير ذي زرع % PageV01P2857 البحر : - 1(@)(@@) % قالوا هجاك أبو المزاق قلت لهم % % ولم هجاني فقالوا للذي بلغه % 2(@)(@@) % أنهى إليه نصيح غير متهم % أن قد تركت مغيضي عرسه ردغه % 3(@)(@@) % فقلت ما ناك مثلي مثل زوجته % % لكن إخال عدوا كاشحا نزغه % 4(@)(@@) % وما أراه على حال تعف له % % أنثى ولو حمقت حتى تكون دغه % % 5(@)(@@) % تالله تغنى بذاك القرد غانية % وإن أجد لها ثوبا وإن صبغه % 6(@)(@@) % لا يهجوني فإني لست هاجيه % % ولا يرى ذاك مني أو يرى صدغه % 7(@)(@@) % وما امتهاني به شعري وخلقته % تهجوه عني وعن غيري بكل لغة % % 8(@)(@@) % سيان عندي أنالتني عضيهته % % أم مص بظر التي أدته أم مضغه % 9(@)(@@) % لا تعجبوا أن طول 
ms723	 الصفع هوسه % بل اعجبوا أن طول الصفع ما دمغه % 10(@)(@@) % أبيهقي تقول الشعر في زمني % % أولى له ما لمثلي تنبع النبغه % PageV01P2858 11(@)(@@) % لئن تصدى لنابي حية ذكر % نضناضة لا يبل الدهر من لدغه % 12(@)(@@) % لما أدل بمجلود ولا كرم % لكن بعرض طويل الهون قد دبغه % 13(@)(@@) % هاجيك يا نائك الحولاء في حرج % ما قتله وزغا يأوي إلى وزغه % % 14(@)(@@) % أراه حيا وإن طال النقيق به % % أقل منه إذا ما فادغ فدغه % % 15(@)(@@) % يحمي من القتل أوزاغا تنق لنا % % دم لهن يعاف الكلب أن يلغه % PageV01P2859 البحر : - 1(@)(@@) % قبلته فمج في جوف فيها % % ذرق باز من ناطف ممضوغ % 2(@)(@@) % يا لها ريقة لقد رشفتها % % من فم شدقم رحيب الفروغ % 3(@)(@@) % ريقة لو تمج مجا على الأف % % عى لباتت بليلة الملدوغ % 4(@)(@@) % كرهة الريح تزهق النفس منها % % مرة الطعم فهي سلح بدوغ % 5(@)(@@) % جشمتها المرين من حب أير % بالغ كل مبلغ مبلوغ % % 6(@)(@@) % حدثتني به كنيزة عنه % % غير إفك من الحديث مضوغ % 7(@)(@@) % قلت هل يبلغ اللهاة فقالت % % أي لعمر الإله أي بلوغ % 8(@)(@@) % أوقح الناس كلهم ليس يخفى % % ذاك في جلد وجهها المدبوغ % % 9(@)(@@) % لست أربي بقدرها عن تالل % ه ولكن بثوبها المصبوغ % 10(@)(@@) % وبقدرالغناء إذا تدعيه % % لا بحق بل باطل مدموغ % % PageV01P2860 11(@)(@@) % قد مججناك يا كنيزة ريا % فانبغي في زناك كل نبوغ % % 12(@)(@@) % وأديمي لي الصدود وروغي % % عن وصالي فمنيتي أن تروغي % % 13(@)(@@) % أنا في نعمة بصدك عني % % أكد الله نعمتي بالسبوغ % % 14(@)(@@) % لو تسوغت في الحلوق بشهد % أو رحيق مشعشع لم تسوغي % % 15(@)(@@) % لم تروغي عن المحجة في وص % لك بل أنت شكلة لم تروغي % % 16(@)(@@) % أنت والعبد جيفة صادفتها % % كلبة في الدماء ذات ولوغ % % PageV01P2861 البحر : - 1(@)(@@) % يا راميا غرض القطي % % عة بالجفاء مبلغا % % 2(@)(@@) % قد قلت إذا حاولتها % % بلغ المحاول ما ابتغى % % 3(@)(@@) % ما كان ود خنته % % حظا فخنه مسوغا % % 4(@)(@@) % لهفي لأيام مضت % % مشغولة بك فرغا % % PageV01P2862 البحر : - 1(@)(@@) % قال يوما لأسود % ناكه وسط ممرغه % 2(@)(@@) % حك درزي بخصتيتي 
ms724	 % ك قليلا بنغنغه % % 3(@)(@@) % ثم قف بضرطة % ذات هول مترغه % % 4(@)(@@) % قال % % والله بيغه % % 5(@)(@@) % قلتنكها فإنها % % فقحة تعرف اللغه % % PageV01P2863 البحر : - 1(@)(@@) % وبديع من البدائع يسبي % % كل عقل ويطبي كل طرف % 2(@)(@@) % وفي الحسن والملاحة حتى % % ما يوفيه واصف حق وصف % 3(@)(@@) % قدح كان للرشيد اصطفاه % % خلف من ذكوره غير خلف % 4(@)(@@) % كفم الحب في الحلاوة بل أح % % لى وإن لا يناغي بحرف % % 5(@)(@@) % صيغ من جوهر مصفى طباعا % لا علاجا بكيمياء مصف % 6(@)(@@) % تنفذ العين فيه حتى تراها % % أخطأته من رقة المستشف % % 7(@)(@@) % كهواء بلا هباء مشوب % بضياء أرقق بذاك وأصف % % 8(@)(@@) % وسط القدر لم يكبر لجرع % % متوال ولم يصغر لرشف % % 9(@)(@@) % لا عجول على العقول جهول % بل حليم عنهن في غير ضعف % 10(@)(@@) % يمتع الشاربين بالشرب فيه % % وبلذات كل قصف وعزف % PageV01P2864 11(@)(@@) % ما رأى الناظرون قدا وشكلا % فارسا مثله على بطن كف % % 12(@)(@@) % ليس يخلو إذا تعاطاه قوم % من أكف يمسحنه بتحفي % % 13(@)(@@) % ما رأوه إلا استخف حليم % لم يكن قبل ذاك بالمستخف % 14(@)(@@) % تؤثر العين أن تنزه فيه % % عند قول الكرى لذي العين أغفي % % 15(@)(@@) % فيه نون معقرب عطفته % حكماء القيون أحسن عطف % % 16(@)(@@) % مثل عطف الأصداغ في وجنات % من غزال يزهى بحسن وطرف % % 17(@)(@@) % ذخرته لك العواقب عندي % % يتخطاه كل حين وحتف % % 18(@)(@@) % فتمتع به وعش في سرور % ألف عام ولست أرضى بألف % % 19(@)(@@) % ثم إني مشمر من ثيابي % % فملاقيك من عتابي بزحف % % 20(@)(@@) % أمن العدل أن حرمت وغيري % % من عطاياك بين غرف وجرف % % PageV01P2865 21(@)(@@) % عم من عم مدحه الناس طرا % منك جود سماؤه ذات وكف % % 22(@)(@@) % وعداني أن أستخصك مدحي % % يابن يحيى وتلك خطة خسف % % 23(@)(@@) % ليس ترضى بما فعلت قواف % أنت منها مصدر ومقفي % % 24(@)(@@) % مدح فيك صنتها كل صون % تحت عرض ظلفته كل ظلف % 25(@)(@@) % بعضها قد بدا وبعض يراعي % % أن يرى للعطاء موضع كشف % 26(@)(@@) % لا تكذب مخيلة لك أضحت % يخطف الطرف لمعها كل خطف % 27(@)(@@) % لهوة أو فإسوة يابن يحيى % % أتأسى 
ms725	 بها فتبرد لهفي % % 28(@)(@@) % رش جناحي أو سم لي مستريشا % % لك أضحى وريشه غير وحف % 29(@)(@@) % وعلي فارط العتاب فإني % % واطىء من معاتبي كل رضف % % 30(@)(@@) % قائل فيك للعدو مقالا % فيه كبت له وإرغام أنف % % PageV01P2866 31(@)(@@) % أيهذا المسائلي بعلي % أنا طب به فسائل وأحف % 32(@)(@@) % لعلي في ذروة المجد بيت % لم يسقف سوى المساء بسقف % % 33(@)(@@) % شاد بنيانه إلى النجم جود % يهدم المال باعتداء وعسف % 34(@)(@@) % يا لقوم لجوده كيف يبني % % وهو سيل وكل سيل معفي % % 35(@)(@@) % لو تكون الجبال مالا أو البح % % ر لغاداهما بنسف ونزف % % 36(@)(@@) % هل تراه وماله غير نهب % أم تراه وجاهه غير وقف % % 37(@)(@@) % ما يرى نهزة من العرف إلا % % ثقفتها يد امرىء منه ثقف % % 38(@)(@@) % قذفت خيفة الملامة منه % % في فؤاد مشيع كل قذف % % 39(@)(@@) % فهو ما شئت من جبان شجاع % آمن راجف الحشا كل رجف % 40(@)(@@) % حاسر للسلاح مجتاب درع % دون أدنى قوارص القول زعف % PageV01P2867 41(@)(@@) % يتقي نفحة اللسان ويغشى % % كل طعن وكل ضرب طلخف % 42(@)(@@) % يقبل البخس في الثناء علي % ويكيل الجزاء كيل موفي % % 43(@)(@@) % ما أفترينا في مدحه بل وصفنا % % بعض أخلاقه وذلك يكفي % % 44(@)(@@) % لو مدحناه بالذي ليس فيه % % وقع المدح منه موقع قرف % 45(@)(@@) % ولكنا كناحلي المسك عرفا % % من سواه مكان أطيب عرف % 46(@)(@@) % ما لنا في مديحه غير نظم % للمساعي التي سعاها ووصف % 47(@)(@@) % هذه غيبتي برغم عدو % يغضف الأذن دونها كل غضف % 48(@)(@@) % وبرغم اللهى التي راغمتني % % فهي عني مصروفة كل صرف % 49(@)(@@) % من يكن كهفه سواك فحسبي % % بك في النائبات من كل كهف % PageV01P2868 البحر : - 1(@)(@@) % حاجتي أيها الأمير كتاب % لا يخل التوكيد منه بحرف % 2(@)(@@) % ساحر ماهر لو استعطف البي % % ض لشيب الرجال جدن بعطف % 3(@)(@@) % فيه من نجحه رقى نافذات % آخذات بكل سمع وطرف % 4(@)(@@) % ينزل القطر من ذرى المزن عفوا % ويحط الوعول من كل كهف % 5(@)(@@) % زل عن نية فساعد فيه % % حسن معناه حسن لفظ ورصف % 6(@)(@@) % وأتى من وفائه بغية النف % % س يمس 
ms726	 العليل مسا فيشفي % % 7(@)(@@) % واصف حرمتي وواجب حقي % % ومكاني لديك أبلغ وصف % 8(@)(@@) % شافع لي إلى سميك في إج % % راء ألف له حقيقة ألف % % 9(@)(@@) % واختيار المكان ما استطاع لآسمي % % مع تعجيله سراحي وصرفي % % 10(@)(@@) % وليضف ذلك الأمير إلى ما % % هو مجد من سيب أفضل كف % PageV01P2869 11(@)(@@) % فقديما ما جاد بالمال والجا % % ه وأنف العدو أرغم أنف % % 12(@)(@@) % ليس ممن يسد دون ولي % باب عرف لفتحه باب عرف % % 13(@)(@@) % ولئن أصبحت أياديك شفعا % كل إلف منها مقارن إلف % 14(@)(@@) % فاليمينان يفعلان جميعا % فوق ما تفعل اليمين بضعف % 15(@)(@@) % ولهذا أداهما ذو اليميني % % ن تراثا إليك يا خير خلف % PageV01P2870 البحر : - 1(@)(@@) % وصاحب لم يكن ليصحبه % مثلي لولا صباي أو خرفي % % 2(@)(@@) % ظلمت نفسي به فأنصفني % % بصونه عن سفاله شرفي % % 3(@)(@@) % دابرني فانصرفت عنه فأح % % مدت بحمد الإله منصرفي % % 4(@)(@@) % وكنت أعطي مودتي سرفا % فقد تركت القبيح من سرفي % % PageV01P2871 البحر : - 1(@)(@@) % يا أبا إسحاق وآقلب % نظم إسحاق وصحف % 2(@)(@@) % واترك الحاء على حا % % ل فما للحاء مصرف % 3(@)(@@) % يشهد الله لقد أص % % بحت عين المتخلف % 4(@)(@@) % لا عزيزا تظلم النا % % س ولا حرا فتنصف % 5(@)(@@) % يا مرجى غير مجد % وظنينا غير مخلف % % 6(@)(@@) % يا عذاب المجتديه % % وغرور المتعفف % % 7(@)(@@) % يا فقيد المثل والحا % % مد موجود المعنف % % 8(@)(@@) % لك في الناس نثا ذك % % ر كثير المتأفف % 9(@)(@@) % إن من ضيع مدحا % فيك والمسرف مسرف % 10(@)(@@) % لكمن ألقى ثمين الد % در في حش مجيف % % PageV01P2872 11(@)(@@) % لم أجد عذرك للمح % % تال فيه المتلطف % % 12(@)(@@) % غير بطن لك سأ % آل إذا أصبحت ملحف % % 13(@)(@@) % ليس في مالك عن بط % % نك من فضل فيردف % % 14(@)(@@) % يا عدو الزاد يا ثع % % بان موسى المتلقف % % PageV01P2873 البحر : - 1(@)(@@) % مدحت سليمان الذي قيل إنه % % كريم وبعض القول زور وزخرف % 2(@)(@@) % مديحا إذا ما الطير مرت رعالها % % بمنشده ظلت هنالك تعكف % % 3(@)(@@) % فما نلت منه نائلا غير أنني % % عرفت بشأو العبد كيف التخلف % 4(@)(@@) % وما كان مدحي من طريد هزيمة % % على عقبيه 
ms727	 سلحه بعد ينظف % 5(@)(@@) % حديث بأطراف الأسنة عهده % % فأحشاؤه من شدة الخوف ترجف % % 6(@)(@@) % فيا أسفي أن نيط مدحي بمثله % % ويا أسفي أن كان حظي التأسف % PageV01P2874 البحر : - 1(@)(@@) % قرن سليمان قد أضر به % % شوق إلى وجهه سيدنفه % 2(@)(@@) % أعرض عن قرنه وصد فما % % أصبح شيء عليه يعطفه % 3(@)(@@) % كم يعد القرن باللقاء وكم % % يكذب في وعده ويخلفه % % 4(@)(@@) % لا يعرف القرن وجهه ويرى % % قفاه من فرسخ فيعرفه % PageV01P2875 البحر : - 1(@)(@@) % ما القلب في إثرهم بمختطف % ولا بذي صبوة ولا كلف % % 2(@)(@@) % سلوت عن خطة الخليط وعن % % مرتبع منهم ومخترف % 3(@)(@@) % إن محل الأنيس بعدهم % للمرء ذي السن شر معتكف % % 4(@)(@@) % وصل الغواني صبا الشباب وغش % % يان المعاني حقا صبا الخرف % % 5(@)(@@) % فعد عن ذكرهم وعن دمن % بمدرج للرياح منتسف % % 6(@)(@@) % ما رعينا عهد كل خائنة % قاسية غير ذات منعطف % % 7(@)(@@) % تحميك معروفها الممنع بال % % بخل ولين المرد بالصلف % % 8(@)(@@) % بيضاء قد شيف خلقها وأبى % % مذموم أخلاقها فلم يشف % 9(@)(@@) % تضمن عن وجهها ومخبرها % % حسن رواء وقبح منكشف % % 10(@)(@@) % مناعة نيلها المحب وما % % تنفك من صدها على خفف % PageV01P2876 11(@)(@@) % من اللواتي إذا ظفرن بنا % % أنزفن ألبابنا سوى نزف % % 12(@)(@@) % حكمن فينا فما عدلن وإن % % عدلن بين الجفاء والقضف % % 13(@)(@@) % كم من دموع سفحنها هدر % ومن دماء سفكنها ظلف % % 14(@)(@@) % بكل أحوى أحم في حور % وكل أقنى أشم في ذلف % % 15(@)(@@) % مضى أوان الصبا وحين البطا % % لات وهذا أوان مصطرف % 16(@)(@@) % ولائم أن حللت شاهقة % تزل منها الوعول عن قنف % % 17(@)(@@) % لم ير لي خلة تعاب سوى ال % % خلة أو رغبتي عن الحرف % % 18(@)(@@) % صدق يقين أن لا مقدر لل % % أرزاق إلا مخلق النطف % % 19(@)(@@) % قلت وقد لام في القناعة بال % % مجد وحلف المعاش ذي الشظف % % 20(@)(@@) % هم رجال العلا تنافسهم % % فيها وهم الحمير في العلف % % PageV01P2877 21(@)(@@) % ما سرني اللؤم والغضارة في ال % % عيش بديلا بالمجد والقشف % % 22(@)(@@) % لي عفة حسب من تكون له % % من الغنى غفة من الغفف % 23(@)(@@) % كأن كفي بها 
ms728	 مملكة % دجلة تسقي منابت السعف % % 24(@)(@@) % ما قصر العسر بازدلافي لل % % مجد مشيحا في كل مزدلف % % 25(@)(@@) % أرق مالي ولو أشاء لأص % % بحت وأمسيت منه في كثف % 26(@)(@@) % إني أعاف الخبيث يعلمه ال % % له إذا ما الخبيث لم يعف % 27(@)(@@) % أطمح كالنسر في السكاك ولا % % أخلد إخلاده إلى الجيف % % 28(@)(@@) % شاد لي السور بعد توطئة ال % % أس أب قال أنت للشرف % % 29(@)(@@) % وأبذل البلغة الكفاف من ال % % قوت إذا ما المستضيف لم يضف % % 30(@)(@@) % أبني البناء الذي يقيم على ال % % دهر ويودي خورنق النجف % % PageV01P2878 31(@)(@@) % وأرتجي أن تدوم لي ديم % من عارض في السماء ذي وطف % % 32(@)(@@) % أعني أبا الصقر أنه ملك % % في منصب للعيون مشترف % % 33(@)(@@) % من معشر فيهم السماحة وال % % حلم وفيهم قعاقع الحجف % % 34(@)(@@) % أركبه الله ذروة تمكت % من شرف من يكن بمرتدف % 35(@)(@@) % يا راكبا نحوه ليسأله % % يممه واحرف بكل محترف % % 36(@)(@@) % ولا تشحن أن تشارك في % % جدواه فالبحر غير منتزف % % 37(@)(@@) % بلغه مدحي فإنه كلم % يفعمه مسكه ولم يذف % % 38(@)(@@) % من قول علامة له لجج % يغرق فيهن صاحب النتف % % 39(@)(@@) % قل لأبي الصقر قول ذي سدد % قرطس بالحق غرة الهدف % % 40(@)(@@) % يا أيها السيد الذي اعترفت % له الصناديد كل معترف % % PageV01P2879 41(@)(@@) % أصبحت يطريك كل مضطغن % منحرف عنك كل منحرف % 42(@)(@@) % أنطقه فضلك المبرز بال % % حق فأداه غير معتنف % % 43(@)(@@) % وأصدق المدح مدح ذي حسد % % ملآن من بغضة ومن شنف % % 44(@)(@@) % أنت الذي أخصبت رعيته % % حتى شكا البدن صاحب العجف % % 45(@)(@@) % واتسق النظم في النظام به % % فائتلف الشمل كل مؤتلف % % 46(@)(@@) % وأنصف الظالم المظلم فال % % عصفور جار العقاب في لجف % 47(@)(@@) % تكد للمجد كدح مجتهد % أو لمحل النعيم والترف % % 48(@)(@@) % ما زلت تسعى لكل صالحة % وإن تكلفت أثقل الكلف % 49(@)(@@) % تجري إلى كل غاية شطط % وتنتوي كل نية قذف % 50(@)(@@) % يا محيي الشعر والسماح وقد % % كانا جميعا مضمني جدف % % PageV01P2880 51(@)(@@) % أدعى كتاب إلى الجميل وأو % عاه لما يشتهى من الخرف % % 52(@)(@@) % يا مبرىء الحسبة التي سقمت 
ms729	 % بل التي أشرفت على التلف % % 53(@)(@@) % دوايت أدواءها وقد دنفت % حينا من الدهر أيما دنف % 54(@)(@@) % براجح الوزن من سراة بني ال % % عباس يقفو مذاهب السلف % 55(@)(@@) % أبلج يجلو بضوء غرته % % ونور تقواه حالك السدف % 56(@)(@@) % إذا رأى وجهه ومنصبه % % ضن بذاك الجمال والشرف % % 57(@)(@@) % فعف عن كل ما يشينهما % % وكف أحكامه عن الجنف % % 58(@)(@@) % ينهاه عن مأثم تقى ورع % فيه وعن مدنس نهي أنف % 59(@)(@@) % له ذكاء الفتى وقد كملت % فيه على ذاك حنكة النصف % 60(@)(@@) % ممن إذا الغمر رام مغمزه % % لم يؤت من قسوة ولا قصف % PageV01P2881 61(@)(@@) % يغدو شديدا على المريب وتل % قاه لمن تاب لين الكنف % 62(@)(@@) % يذعر بالهيبة الهزبر ويس % % تنزل بالعدل أعصم الشعف % % 63(@)(@@) % فلو يرى هديه النبي أو ال % % عباس قالا بوركت من خلف % % 64(@)(@@) % كم قائل صادق وقائلة % لمن يخاف العداء لا تخف % % 65(@)(@@) % إن مقام المظلوم عند أبي ال % % عباس أضحى مقام منتصف % 66(@)(@@) % شمر للقوت وهو من ذهب % عزا وللنقد وهو من خزف % 67(@)(@@) % فأوسع الفاسدين مصلحة % في غير إثم هناك مقترف % 68(@)(@@) % ونكل الباعة التي عمرت % تجمع بين التطفيف والحشف % 69(@)(@@) % وأنكر النكر بعدما اكتنت ال % % فتنة في فتكها أبا دلف % 70(@)(@@) % يفديه آمين كل ملتحف % على الخيانات كل ملتحف % PageV01P2882 71(@)(@@) % واسعد به أيها الوزير فقد % % أعطيته طاهرا من النطف % % 72(@)(@@) % قلدك الله منه لؤلؤة % كم صانها عن سواك بالصدف % 73(@)(@@) % قلدته أمرنا فقام به % % غير أخي لوثة ولا لفف % % 74(@)(@@) % ومثلك اختار مثله وكذا % % من كان بالمسلمين ذا لطف % % 75(@)(@@) % أقسمت ما في الذي تسوس به الد % دين وملك الملوك من وكف % % 76(@)(@@) % كلأ ولا سرت بالرعية في ال % % وعث فأتعبتها ولا الظلف % % 77(@)(@@) % بل أنت ذو السيرة التي قصدت % % قدما وحادت عن كل معتسف % % 78(@)(@@) % وهكذا سيرة الجواد إذا % % لم يؤت من هجنة ولا قرف % % 79(@)(@@) % يختلف الناس في سواك وما % % توجدهم موقعا لمختلف % % 80(@)(@@) % أنت الذي أجمعت جماعتهم % % أنك من لا يشول في الكفف % % PageV01P2883 81(@)(@@) % جمعت ما 
ms730	 يجمع الوزير فما % % تنفك من حاسد على أسف % % 82(@)(@@) % إرب يكاد العدى به وندى % % يقرن بين القلوب بالألف % 83(@)(@@) % ذهبت بالدهى والسماح معا % والناس من ذاك وذاك في طرف % 84(@)(@@) % وأنت كالبحر لا كفاء له % % في بعد غور وقرب مغترف % 85(@)(@@) % وحلمك المنقذ النفوس إذا % % أشرفن من معطب على حفف % 86(@)(@@) % أنسيتنا جود حاتم وحجى % % عمرو الدواهي وحلم ذي الحنف % 87(@)(@@) % ولو تبذلت للحروب للأل % فيت شبيها بالليث ذي الغضف % 88(@)(@@) % لا سبط الخطو في المهارب حا % % شاك ولكن في كل مزدحف % % 89(@)(@@) % خذها مديحا كأنه وشح الد % در إذا ما جرت على الهيف % % 90(@)(@@) % أحلى مذاقا على اللسان من الش % هد بماء الغمام في الرصف % % PageV01P2884 91(@)(@@) % مدح رأى أنك الكفي له % % فلم يجد عنك وجه منصرف % % 92(@)(@@) % وكل مدح يقال فيك إلى الت % تقصير أدنى منه إلى السرف % % 93(@)(@@) % نهدي لك الشعر ثم نحقره % وإن غدا من نفائس التحف % % 94(@)(@@) % لأنه ليس فيك من بدع ال % % أشياء كلا ولا من الطرف % % 95(@)(@@) % ولا نرى أنه يزيدك في % % مجدك من متلد ومطرف % % 96(@)(@@) % ما يرفع الشعر أو يشرف من % % بدر بزهر النجوم مكتنف % % 97(@)(@@) % ينزل من مجده وسؤدده % % بين قديم وبين مؤتنف % % PageV01P2885 البحر : - 1(@)(@@) % دهر علا قدر الوضيع به % % وهوى الشريف يحطه شرفه % 2(@)(@@) % كالبحر يرسب فيه لؤلؤه % % سفلا وتطفو فوقه جيفه % % 3(@)(@@) % فاصبر على هول الخطوب لها % % قلب نماه إلى العلا سلفه % 4(@)(@@) % لا مظهرا في عقب نائبة % أسفا وليس يقوده شعفه % % 5(@)(@@) % طوع الصديق يقود ربقته % % لا بطؤه يخشى ولا عنفه % % 6(@)(@@) % نكل العدو يرى به أسفا % جهما عبوسا موحشا كنفه % % 7(@)(@@) % فلقل ما أنحت على أحد % بالجور إلا سوف تنتصفه % % PageV01P2886 البحر : - 1(@)(@@) % له شمالان حاز إرثهما % % عن ذي اليمينين شد ما اختلفا % % 2(@)(@@) % ما أبين اليمن في نقيبته % % على أعاديه حيث ما انصرفا % % 3(@)(@@) % بجود ما انقادت البلاد له % % حتى إذا ما استثارها ضعفا % % 4(@)(@@) % كأنه الدهر من هزائمه % % يلعنه الله أينما ثقفا % % PageV01P2887 البحر : - 1(@)(@@) % لا زلت 
ms731	 غوثا إذا ناداك ملهوف % بحيث أنت ومن والاك مكنوف % 2(@)(@@) % تا لله ما ضاع معروف نفحت به % % نحوي ولا بار مدح فيك موصوف % % 3(@)(@@) % قد قلت إذ طلعت نعماك تخبرني % % إني بفضلك ما عمرت ملحوف % 4(@)(@@) % لا يعتبد أحد شعري بنائله % % فإنه بأبي العباس مظلوف % 5(@)(@@) % أيقنت إذا وامضتني منك بارقة % أني بسيبك مربوع ومخروف % 6(@)(@@) % ما زلت أذكر معروفا بعثت به % % خلفي وقصرك بالمداح محفوف % 7(@)(@@) % والفلس رب يخر الساجدون له % % والشعر منصرف عنه ومصروف % 8(@)(@@) % وآمرين بغير الرشد قلت لهم % % لا ألفظ العذب إن العذب مرشوف % % 9(@)(@@) % تالله أبى قليلا طاب ملبسه % % وهل قليل مسوس الماء معيوف % % 10(@)(@@) % أليس قد جاءني والطير ساكنة % والنفس آمنة والوجه مكفوف % % PageV01P2888 11(@)(@@) % أني أرتب شعري فوق نافلة % عاجت علي ووجه الرزق مصروف % % 12(@)(@@) % لئن زهوت بشيء لا زمان له % % إني إذا لزهيد الرأي مضعوف % % 13(@)(@@) % لو كنتم من ذوي التمييز أعجبكم % % زو ج إلى زوجة تهواه مزفوف % % 14(@)(@@) % عرف يزف إلى كف مدفعة % طرف العيون بنور الله مطروف % % 15(@)(@@) % ما أستقل قليلا أنت باذله % % ذكراك إياي بالمعروف معروف % % 16(@)(@@) % أليس قد لاحظتني منك خاطرة % إن الشريف لمن دوني لمشروف % % 17(@)(@@) % وجهت نحوي معروفا تعاظمني % % إلا لقدرك إن الحق مكشوف % % 18(@)(@@) % والعود أحمد قول قد جرى مثلا % وعرف مثلك بالعودات موصوف % % 19(@)(@@) % فأجره لي إن النفس قد ألفت % آثار كفيك والمعروف مألوف % 20(@)(@@) % لا ينقطع وثنائي غير منقطع % كلا بل الحسي قبل البحر منزوف % PageV01P2889 21(@)(@@) % جدواك أكرم من أن لا أصادفها % % وقفا ومدحي عليك الدهر موقوف % 22(@)(@@) % قد سار باسمك مدح لم أوفكه % % وقد يبلغك الغايات محذوف % 23(@)(@@) % فاكمل بحيث ترى فيه نقيصته % % فالبدر واف بحيث الشهر منصوف % 24(@)(@@) % يا أحمد الخير يا من لا يعد له % % بدء جميل بسوء العود مخلوف % 25(@)(@@) % سلم من الريث والإقلاع جائزتي % % فالعرف بالريث والإقلاع مأووف % 26(@)(@@) % وما أزيدك إقبالا على كرم % وإن غدا وهو عند الناس مشنوف % % 27(@)(@@) % أنت الذي لو سكنا ظل يعطفه % لين المهز 
ms732	 إذا ما اكتز معطوف % % 28(@)(@@) % قد كان يحميك حمد لناس علمهم % بأن قلبك بالمعروف مشعوف % % 29(@)(@@) % وواضع قدما في المجد قلت له % % إن المقام الذي حاولت زحلوف % % 30(@)(@@) % خل العلا لأبي العباء يكفكها % % وألعب فحسب وليد الحي خذروف % % PageV01P2890 31(@)(@@) % فتى له عزمات في مذاهبه % % تمضي فتقضي وصف الزحف مصفوف % 32(@)(@@) % يا من يعاديه مهلا إنه رجل % مزلزل بأعاديه ومخسوف % 33(@)(@@) % يكيد فالسيف مقطوع هناك له % % والدرع مهتوكة والرمح مقصوف % 34(@)(@@) % فقرنه الدهر مغلوب وهاربه % % طلب ولو حملته الريح مثقوف % 35(@)(@@) % سالمه تسلم وإن خالفت موعظتي % % فأنت في مخلب العنقاء مخطوف % 36(@)(@@) % خذها فإنك أخاذ نظائرها % % منوه بك في العزاء مهتوف % % 37(@)(@@) % يا أجبن الناس من ذم وأجرأهم % % والجيش بالجيش في الهيجاء ملفوف % % 38(@)(@@) % يا راعيا أصبح القوم الخماص به % % في بطنة ما لمن ضافته شرسوف % 39(@)(@@) % وليت أمرا فلا المرعي أمانته % % فيها مخون ولا المرعي معسوف % 40(@)(@@) % يا من إذا اختبرت يوما مذاقته % % ففيه طعمان معسول ومذعوف % PageV01P2891 41(@)(@@) % يا من معاطفه لا الصم حاش له % % ولا مكاسره الخوارة الجوف % % 42(@)(@@) % أدعوك دعوة ملهوف معولة % وكم أجيب بغوث منك ملهوف % % 43(@)(@@) % وإنني لأرجي منك تلبية % وذاك في قلب من يدعوك مقذوف % % 44(@)(@@) % كأنني بك قد ألبستني نعما % كأنها الفوف لا بل دونها الفوف % 45(@)(@@) % ولان لي كل شيء بعد قسوته % % فالجذع جمارة والعظم غضروف % PageV01P2892 البحر : - 1(@)(@@) % أنا غيران ولا زوجة لي % % بل على النعمة عند ابن خلف % 2(@)(@@) % ويمين الله لو أن يدى % % ملكت تنكير نكر ما طرف % 3(@)(@@) % أسفي لو أن قولي أسفي % % كان يشفيني من حر الأسف % 4(@)(@@) % كيف لا يغضب حر ماجد % فاتك الهمة من أهل الأنف % % 5(@)(@@) % يا بني العباس أنتم عترة % % طهرت من كل رجس ونطف % % 6(@)(@@) % قد رمى الناس به أختكم % من سفيه وحليم مستخف % % 7(@)(@@) % زعموا لما رأوا أختكم % أسرفت في أمره كل السرف % % 8(@)(@@) % إن هذا الأمر أمر معور % دونه ستر رقيق المستشف % % 9(@)(@@) % ولقد مانوا وقالوا باطلا % غير أن السهم قد ناغى 
ms733	 الهدف % % 10(@)(@@) % فاغسلوا العار الذي ليط بكم % % بدم الخلال غسلا في لطف % % PageV01P2893 11(@)(@@) % لهف نفسي أن علجا مثله % % ناعم البال وأنتم في شظف % 12(@)(@@) % وله آنية من فضة % بعدما كانت رواقيد خزف % % 13(@)(@@) % لو تراه ثانيا من عطفه % % مائلا في السرج من فرط الصلف % 14(@)(@@) % شامخا بالأنف من نخوته % % فهو لم يسترعف الخل رعف % 15(@)(@@) % لرأت عيناك منه عجبا % منسيا كل عجيب مطرف % % 16(@)(@@) % نحن أحياء على الأرض وقد % % خسف الدهر بنا ثم خسف % % 17(@)(@@) % أصبح السافل منا عاليا % وهوى أهل المعالي والشرف % % 18(@)(@@) % رب أنصفني من الدهر فما % % لي إلا بك منه منتصف % % 19(@)(@@) % فاستجب يا رب وارحم دعوة % من لهيف القلب ذي دمع ذرف % % 20(@)(@@) % وأدلنا من زمان جائر % واسمعن يا رب منا وانتصف % % PageV01P2894 21(@)(@@) % من غشوم كلما لنا له % % زاد بغيا وتمادى في العنف % % 22(@)(@@) % كأخي الثأر الذي قد فاته % % طلب الثأر فأضحى ذا أسف % % 23(@)(@@) % يسفل الناس ويعلو معشر % قارفوا الأقراف من كل طرف % % 24(@)(@@) % ولعمري إن تأملناهم % ما علوا لكن طفوا مثل الجيف % % 25(@)(@@) % جيف تطفو على بحر الغنى % % حين لاتطفو خبيئات الصدف % % PageV01P2895 البحر : - 1(@)(@@) % ليوقن من يعارضني بأني % % سأرهق ما بنى مبنى منيفا % % 2(@)(@@) % فإن أربى علي بنيت قصرا % يطول بسوره الشرف الشريفا % % 3(@)(@@) % فإن أربى علي بنيت طودا % يجوز النجم والسقف المطيفا % % 4(@)(@@) % نظرت بعين إنصاف وعدل % فلم أر قط ميزاني خفيفا % % 5(@)(@@) % ولم أر هائبي إلا قويا % ولا مستضعفي إلا سخيفا % % 6(@)(@@) % فتى الكتاب لا تعرض لشعري % % فتظلم صاحبا مولى حليفا % % 7(@)(@@) % أعد نظرا وكن حكما فإني % % أراك فقيه طائفة حنيفا % % 8(@)(@@) % وقل في صاحب لم يلف إلا % % حكيما في مذاهبه ظريفا % % 9(@)(@@) % أريبا في مآربه أديبا % لبيبا في مخاطبه حصيفا % % 10(@)(@@) % نزيها في مطالبه نبيها % عفيفا في مكاسبه نظيفا % % PageV01P2896 11(@)(@@) % شريفا في مناسبه عريقا % خفيفا في ملاعبه ذفيفا % % 12(@)(@@) % تفرد بالكتابة ثم أضحى % % ينازعني القريض لكي يحيفا % % 13(@)(@@) % حوى دوني الحليلة ثم أنحى % % يريغ إلى حليلته اللطيفا % % 14(@)(@@) % كرب التسع والتسعين 
ms734	 أضحى % % ينازع رب واحدة صعيفا % % 15(@)(@@) % إخالك تؤنس العدوان منه % % وترضى بالملام له رديفا % % 16(@)(@@) % وأنت الخصم والحكم المنادى % % فقل سددا وأنجد مستضيفا % % 17(@)(@@) % وسدد في معاملتي وقارب % ولا تك في محاربتي عنيفا % % 18(@)(@@) % ولا تعرض لواحدتي وأقبل % % على الكبرى وكن رجلا عفيفا % % 19(@)(@@) % ولم أمنعك ورد البحر كلا % % ولا إلطافه اللطف الطريفا % % 20(@)(@@) % ولكن دع زحامي في طريقي % % فإنك واجد سعة وريفا % % PageV01P2897 21(@)(@@) % وإن لم تهو إلا السير فيه % % فإنك لن تصادفه مخيفا % % 22(@)(@@) % رضيت وإن قذيت بكل شيء % رضيت به ولم أخلق طفيفا % % 23(@)(@@) % فدونك طاعتي وصريح ودي % % وهبت لك الوصيفة والوصيفا % % 24(@)(@@) % ولو خصم سواك أراد ظلمي % % لأسمعت الأصم له حفيفا % % 25(@)(@@) % بأمثال من المثلات شنع % تسير فتخرق الأفق المطيفا % % PageV01P2898 البحر : - 1(@)(@@) % يا آل وهب ألا ينهى سماحكم % % إلحاح كل ملث الودق وكاف % 2(@)(@@) % أآنس الغيث ضعفا من أكفكم % بل ساجلته فاغرته بإسراف % 3(@)(@@) % شبهته بنداكم عند غتكم % % بفضلكم كل إسراف وإلحاف % 4(@)(@@) % تالله أجهل ما عقبى مؤملكم % علمي بفوز يديه علم عراف % % 5(@)(@@) % أصبحتم شأتكم إثبات أجنحة % % وشأن سابور قدما نزع أكتاف % 6(@)(@@) % من ذا يساويكم أمن يقاربكم % % في رحب أفنية أو لين أكناف % % 7(@)(@@) % أو حلم أندية أو خصب أودية % أو طيب أردية أو حسن أعطاف % % 8(@)(@@) % كفيتمونا خطوبا لا كفاء لها % % يا آل وهب كفانا فقدكم كافي % % 9(@)(@@) % فإن قدمت خوفا جر منا % وإن قدمت أمنا جر خوفا % % 9(@)(@@) % ولم نر قط أغدر من زمان % ولا بنذوره في الغدر أوفى % % PageV01P2899 9(@)(@@) % فكم عللن قبلي من قرون % إلى أن شافها الحدثان شوفا % % 9(@)(@@) % نذيري من عسى ولعل نسي % % ومن أختيهما حتى وسوفا % % 9(@)(@@) % ما نسأل الدهر إتحافا بغيركموافرنذيري من عسى ولعل نسيومن أختيهما حتى وسوفا فكم عللن قبلي من قرون إلى أن شافها الحدثان شوفا ولم نر قط أغدر من زمان ولا بنذوره في الغدر أوفى فإن قدمت خوفا جر منا وإن قدمت أمنا جر خوفا % % فأنتم كل إتحاف وإتراف % % PageV01P2900 البحر : - 1(@)(@@) % عسى ولعل طيبتا 
ms735	 حياتي % % وصاحبتاهما حتى وسوفا % % 2(@)(@@) % تبشرني بروح الله بشرى % % تشوف عن القلوب الهم شوفا % % 3(@)(@@) % ولولا أنها لي مستراح % ظللت محالفا حزنا وخوفا % % 4(@)(@@) % وذاف لي القنوط لذيذ عيش % % بمر الصاب والذيفان ذوفا % % 5(@)(@@) % إذا ولما جشمت ولا ركابي % % رجاء الخير تجوالا وطوفا % % 6(@)(@@) % أرى الشيطان يوعدني شرورا % ووعد الله بالخيرات أوفى % % PageV01P2901 البحر : - 1(@)(@@) % لا تلحيني في المنطق السخيف % فإنني في حالة اللهيف % % 2(@)(@@) % أصبحت أغنى الخلق عن كنيف % وأحوج الناس إلى رغيف % 3(@)(@@) % فجد على عبدك بالطفيف % % إلى مجيء الصفد الشريف % % 4(@)(@@) % فإنني في قبضتي عنيف % % وتحت وطء ليس بالخفيف % % PageV01P2902 البحر : - 1(@)(@@) % يدافع آناء الملالة وجهه % ويختدع العين اختداع الزخارف % 2(@)(@@) % إذا غبنتني طرفتي منه نظرتي % % تمنيت عينا جفنها غير طارف % 3(@)(@@) % فليت جفون العاشقين تغمدت % عيونهم من قبل جري المعارف % % PageV01P2903 البحر : - 1(@)(@@) % أبا علي طلبت عيبك ما اس % % طعت فألفيت عيبك السرفا % % 2(@)(@@) % وذاك عيب كأنه ذفر ال % % مسك إذا شم نشره رشفا % % 3(@)(@@) % أو ديمة الغيث كلما طمع الط % طامع في أن يكفها وكفا % % 4(@)(@@) % وحبذا أن يكون عيب فتى % عيبا إذا مر ذكره شغفا % % 5(@)(@@) % ولم يكن يا أخا العلا طلبي % % عيبك لا بغضة ولا شنفا % % 6(@)(@@) % لكن لإشفاق نفس ذي مقة % ما زال عن ودكم ولا انحرفا % % 7(@)(@@) % أبصر أشياء فيك منفسة % إذا رآها مذمم لهفا % % 8(@)(@@) % يصبح من أخطأته ذا أسف % ومن رأى الحظ فائتا أسفا % % 9(@)(@@) % وإنني خفت أن تصيبك بال % % عين عيون تقرطس الهدفا % % 10(@)(@@) % فارتدت عيبا يكون واقية % فلم أجده ألية حلفا % % PageV01P2904 11(@)(@@) % فقلت في الله ما وقى رجلا % إن ميح أعفى وإن أريب عفا % % 12(@)(@@) % كان له الله حيث كان ولا % % زالت يميناه حوله كنفا % % 13(@)(@@) % صدقت فيما صدقت من طلبي % % فيك معابا ولم أزد ألفا % % 14(@)(@@) % يا حسن الوجه والشمائل وال % % أخلاق والعقل كيفما انصرفا % % 15(@)(@@) % يا من إذا قلت فيه صالحة % عند عدو أقر واعترفا % % 16(@)(@@) % عندي عليل أرد منته % % بطيب الطيب كلما ضعفا % % 17(@)(@@) % فابعث بشيء من 
ms736	 البخور له % % كبعض معروفك الذي سلفا % % 18(@)(@@) % ولتك أنفاسه تشاكل ذك % % راك وحسبي بطيبها وكفى % % 19(@)(@@) % من ندك الفاخر المفضل في الن % ند على غيره إذا وصفا % % 20(@)(@@) % ذاك الذي لو غدا يفاخره % نسيم نور الرياض ما انتصفا % % PageV01P2905 21(@)(@@) % ولا يكن دخنة المعزم لل % % عفريت من شم نشرها رعفا % % 22(@)(@@) % لا تدخلن الجفاء في لطف % فربما ألطف امرؤ فجفا % % 23(@)(@@) % حاشاك من ذاك في ملاطفتي % % يا ألطف الناس كلهم لطفا % % 24(@)(@@) % أطب وأقلل فإن أطبت وأك % % ثرت نصيبي فيا له شرفا % % 25(@)(@@) % وليس يروي كثير مائك بل % % ما طاب منه لشارب وصفا % % 26(@)(@@) % إن الكثير الخبيث مقتحم % في العين والقلب يبعث الأنفا % % 27(@)(@@) % ولا تلمني على اشتطاطي في ال % % حكم ولا في سؤالك الترفا % % 28(@)(@@) % من حسن الله وجهه وسجا % % ياه وأعطاه كلف الكلفا % % 29(@)(@@) % وجهك ذاك الجميل سحبني % % عليك حتى سألتك التحفا % % 30(@)(@@) % وحسبنا أن كل ذي كرم % إذا ركبت المكارم ارتدفا % % PageV01P2906 31(@)(@@) % يا در العقد إن لي فكرا % تفلق عن در مدحك الصدفا % % 32(@)(@@) % فاسع لشكري تجده حينئذ % شكر قدير تعجل الخلفا % % PageV01P2907 البحر : - 1(@)(@@) % سقته ابنة العمري من خمر عينها % % ووجنتها كأسا تميت وتدنف % 2(@)(@@) % فقل أمزجيها بالرضاب لعله % % يسكن من سكر الهوى ويخفف % 3(@)(@@) % فصدت مليا ثم جادت بريقة % يزيد لها سكر المحب فيضعف % 4(@)(@@) % فراح بضعفي سكره من مزاجها % % وقد تسأل العدل الولاة فتعسف % 5(@)(@@) % فهل من مزاج زاد في سكر شارب % سوى ريق ذات الخال أم لست تعرف % PageV01P2908 البحر : - 1(@)(@@) % تكايدنا شنطف % وشعرتها تنطف % 2(@)(@@) % فتنثر أبعارها % % وترصف ما ترصف % 3(@)(@@) % تقول بلا كلفة % وتكلف ما تكلف % 4(@)(@@) % أعدوا إذا أندرت % سمادية تجرف % 5(@)(@@) % مشوهة قحبة % عنابلها تنقف % % 6(@)(@@) % يهملج تقحيبها % % وتكريعها يقطف % % 7(@)(@@) % إذا فقدت فسوها % % فأنفاسها تخلف % % 8(@)(@@) % تشرف بالموبقا % % ت لو أنها تشرف % % 9(@)(@@) % ولو أنها في القيو % % د تحجل أو ترسف % 10(@)(@@) % لهامت إلى مدمج % لها منه أحرف % PageV01P2909 11(@)(@@) % تظل إذا خاضها % % وأحشاؤها ترجف % 12(@)(@@) % وتقوى على دسه % % وعن سله تضعف 
ms737	 % % 13(@)(@@) % على أنها لا تنا % % ك بالغرم أو تلطف % % 14(@)(@@) % تراها إذا شوهدت % % وصفاعها يعنف % 15(@)(@@) % ومن ذا يرى قردة % % تغني فلا يسخف % 16(@)(@@) % أشنطف ما يشتهي % % جماعك من يظرف % 17(@)(@@) % ولا أنت ممن يرو % % ق عينا ولا يطرف % % 18(@)(@@) % نأى القبح عن يوسف % % وأنت له يوسف % PageV01P2910 البحر : - 1(@)(@@) % إن فطرا حيا الخليفة بالنر % % جس والعرس حق فطر ظريف % 2(@)(@@) % يلتقي فيه بالسعادة واليم % % ن شريف البنى وبنت شريف % % 3(@)(@@) % قمر العالمين تهدى إليه الش % مس في جلة من التتريف % 4(@)(@@) % بنت مولاه أخت مولاه لا شك % ك السديد الحصيف وابن الحصيف % PageV01P2911 البحر : - 1(@)(@@) % بات الأمير وبات بدر سمائنا % % هذا يودعنا وهذا يكسف % 2(@)(@@) % قمر رأى قمرا يجود بنفسه % % فبكى عليه بعبرة لا تذرف % 3(@)(@@) % لهفي لفقد محمد من هالك % ولمثله يتلهف المتلهف % % 4(@)(@@) % فتكت به الأيام وهي عليمة % أن سوف تتلف منه مالا تخلف % % 5(@)(@@) % ورمته إذ وضع السلاح وطال ما % % هابته وهو لنبلها مستهدف % % 6(@)(@@) % أجدر بمغتر بعيش خانه % % أن لا يزخرفه لديه مزخرف % PageV01P2912 البحر : - 1(@)(@@) % لم أر شيئا صادقا نفعه % % للمرء كالدرهم والسيف % 2(@)(@@) % يقضي له الدرهم حاجاته % % والسيف يحميه من الحيف % PageV01P2913 البحر : - 1(@)(@@) % الشيب أحلم والشبيبة أظرف % والرشد أسلم والغواية أترف % 2(@)(@@) % ذهب الشباب فبان ما لا يرتجى % % وأتى المشيب فجاء ما لا يصرف % 3(@)(@@) % وكلاهما لابد منه لمن نجا % % من أن يعاجله ردى مستسلف % 4(@)(@@) % والمرء أما من مخاوف دهره % % فحرى وأما بالمنى فمسوف % % 5(@)(@@) % ولربماعدلت عليك صروفه % فأصابك المأمول والمتخوف % % 6(@)(@@) % أصبحت أنظر في الأمور فأجتوي % % منها عيوب عواقب تتكشف % % 7(@)(@@) % والشيب أغراني بذاك ولم يزل % % يغري الغوي برشده ويعنف % % 8(@)(@@) % عجبا لذمي ما يزيد هدايتي % % غضبا لآخر كان بي يتعسف % % 9(@)(@@) % سقت الشباب سجال غيث وكف % % يروينه وسجال دمع ذرف % 10(@)(@@) % وأظل أزمانا خلت ومعاهدا % ورق تظل غصونه تتعطف % % PageV01P2914 11(@)(@@) % أيام ينسيني الخطوب وذكرها % % شرخ الشبيبة والصبا والقرقف % % PageV01P2915 البحر : - 1(@)(@@) % يا ليت شعري والحوداث جمة % أرضيت من بعد الندى بحليف % % 2(@)(@@) % لا يلف 
ms738	 وعدك والبنفسج كاسمه % % في حلية التنكير والتصحيف % % PageV01P2916 البحر : - 1(@)(@@) % وقف الهوى بك بعد طول وجيفه % % وأفاق من يلحاك من تعنيفه % % 2(@)(@@) % ولقد يروقك بارتجاج نبيله % % قمر النساء وباهتزاز قضيفه % % 3(@)(@@) % قبح الهوى ملك السماء فلم يزل % % دينا يدين قويه لضعيفه % % 4(@)(@@) % ولحا الصبا بعد المشيب فإنه % % شأو يريك الحر خلف وصيفه % % 5(@)(@@) % يا جارتي أودى بياض مسرحي % % وبريقه بسواده ورفيفه % % 6(@)(@@) % والشيب ضيف لا يزال موكلا % % بمعقة ومساءة لمضيفه % % 7(@)(@@) % وأرى قوامي لج في تقويسه % % ولقد يلج اللين في تعطيفه % % 8(@)(@@) % إن يحمني بيض المشيب وشيبه % % مرعاي من بيض الشباب وهيفه % % 9(@)(@@) % أو يقرني دهري مذيق حليبه % % فلقد قراني من وري سديفه % % 10(@)(@@) % ومنعم كالماء يشفي ذا الصدى % % كشفائه ويشف مثل شفيفه % % PageV01P2917 11(@)(@@) % ممن له حسن الرحيق وطيبه % % ومراح شاربه ومشي تريفه % % 12(@)(@@) % تلقى جنى التفاح في وجناته % % وترى جنى العناب في تطريفه % % 13(@)(@@) % متعت منه مسامعي ومراشفي % % بنثير لؤلئه وماء رصيفه % % 14(@)(@@) % رويت سامعتي من ترجيعه % % بيتي زياد في سقوط نصيفه % % 15(@)(@@) % وطفقت أرشف ريقه عن ثغره % % حتى شفيت جوى الهوى برشيفه % % 16(@)(@@) % فالآن بدل صحوه من لهوه % % لاه وطول عزوفه بعزيفه % % 17(@)(@@) % أنى لذي شيب نسيم نسيمه % % أنى له التتريف من تنريفه % % 18(@)(@@) % نسخ الزمان سخافة بحصافة % فأتى حصيف الرأي دون سخيفه % % 19(@)(@@) % وطوى المشيب تغزلي بتجملي % % فطوى لذيد تمتعي بعفيفه % % 20(@)(@@) % ما زال مرتاد الزمان مطوفا % حتى أصاب الرشد في تطويفه % % PageV01P2918 21(@)(@@) % عفى بإسماعيل في شيبانه % % ما كان من حجاجه وتثقيفه % % 22(@)(@@) % لبس الزمان من الوزير وعهده % % بردا تحار العين من تفويفه % % 23(@)(@@) % ناهيك من حسن الرواء جميله % % عف المغيب في الخلاء نظيفه % % 24(@)(@@) % أوليس تطريف الزمان بمثله % % ما شئت أو ما شاء من تطريفه % % 25(@)(@@) % خص الوزير ببيت مجد زاده % % بيديه تشريفا على تشريفه % % 26(@)(@@) % لو لم يسقف بالسماء بناؤه % % عجزت ظلال المزن عن تسقيفه % % 27(@)(@@) % يا حاسبا حسب الوزير وحقه % % أن يعجز الحساب عن تنصيفه % % 28(@)(@@) % أنى تروم يداك إحصاء الحصى % % ويداه دائبتان في تضعيفه 
ms739	 % % 29(@)(@@) % لم يخل دهر فيه إسماعيله % من أمن خائفه وخوف مخيفه % % 30(@)(@@) % منجاة هاربه محل طريده % % منهاة طالبه غياث لهيفه % % PageV01P2919 31(@)(@@) % قدر يبور المترفون بسيفه % % بحر يلوذ المعتفون بسفينه % % 32(@)(@@) % وهب الزمان له فضائل نفسه % % ورجاله فحكاه في تصريفه % % 33(@)(@@) % لا حزم قشعمه تراه يفوته % % في النائبات ولا شذى غطريفه % % 34(@)(@@) % وكأنما إشراقه وسماحه % % إغداق مشتاه وصحو مصيفه % % 35(@)(@@) % وترى له نعما كجو ربيعه % % وكروضه وكطيبات خريفه % % 36(@)(@@) % بسطت يداه العدل في سلطانه % % حتى استوى بدنيه وشريفه % % 37(@)(@@) % جزي الوزير عن الرعية صالحا % بنواله والرفق في تثقيفه % % 38(@)(@@) % يعد العقوبة فهي في تأخيره % % ويرى المثوبة فهي من تسليفه % % 39(@)(@@) % يا سائلي عن جوده بجزيله % % ورضاه من شكر امرىء بطفيفه % % 40(@)(@@) % أضحى حليفا للسماح ولم يكن % % ليراه ربك غادرا بحليفه % % PageV01P2920 41(@)(@@) % نغدو بمدح فيه أيسر حقه % % فنحوز كل تليده وطريفه % % 42(@)(@@) % واسوأتي والله من تطفيفه % % إذ لا تخاف هناك من تطفيفه % % 43(@)(@@) % نمتاحه والجور في توظيفنا % % ويسوسنا والعدل في توظيفه % % 44(@)(@@) % متطول نشتط في تكليفنا % % أبدا ولا يشتط في تكليفه % % 45(@)(@@) % أمواله وقف على تثقيلنا % % وثناؤنا وقف على تخفيفه % % 46(@)(@@) % وبه نحوك الشعر فيه لأننا % % تبع لمفتقر الفعال مقيفه % % 47(@)(@@) % يبني العلا ونقول فيه فإنما % % تأليفنا يحذى على تأليفه % % 48(@)(@@) % عجبا له أنى يشيب معاشرا % يتعلمون الشعر من توقيفه % % 49(@)(@@) % كم جاد فيه من مديح لم يجد % عن نحت شاعره ولا تحذيفه % % 50(@)(@@) % غيث نعيش بصوبه ونرى العدى % % ضعفين تحت لهيبه ورجيفه % PageV01P2921 51(@)(@@) % متبادرين قصيفه بوميضه % % متناذرين حريقه بقصيفه % % 52(@)(@@) % ليث تراعى الوحش حول حريمه % % وترى الأسود مجانبات غريفه % % 53(@)(@@) % متبادرات دليفه بزئيره % % متناذرات وثوبه بدليفه % 54(@)(@@) % كم قد نجا منه الرفيق وما نجا % % منه العنيف بلفه ولفيفه % % 55(@)(@@) % كالريح والزرع استكان لمرها % % وعتت فلم تقدر على تقصيفه % % 56(@)(@@) % وتماتن الجزع الأبي مهزه % % فأتت عليه ولم ترع بحفيفه % % 57(@)(@@) % ملك تضمن لي بلوغ محبتي % % عند اعتلال الدهر أوتخويفه % % 58(@)(@@) % فإذا رهبت أقلني في ربعه % % وإذا رغبت أحلني في ريفه % % 59(@)(@@) % ما 
ms740	 قلت فيه كأن إلا أعوزت % أشباهه فعجزت عن تكييفه % % 60(@)(@@) % لكنني استفرغت في تشبيهه % % جهد المطيق وحدث عن تحريفه % % PageV01P2922 61(@)(@@) % فأريت معناه العقول كما يرى % % معنى كلام المرء في تصحيفه % % 62(@)(@@) % ولواصف في جملة من وصفه % % شغل لعمر أبيك عن تصنيفه % % 63(@)(@@) % يا من إذا ناديته بصفاته % % دون اسمه بالغت في تعريفه % 64(@)(@@) % كم ظل يأس مطبق كشفته % % عند اعتقاد اليأس من تكشيفه % % 65(@)(@@) % بك طيف تدبير يكيف لطفه % % سدا صلاح الناس في تكييفه % % 66(@)(@@) % يبني الكثيف من اللطيف وإنما % % تكثيف ذي التحصين من تلطيفه % % 67(@)(@@) % متخصرا قلما نحيفا جسمه % % في وزن ضخم الشأن غير نحيفه % % 68(@)(@@) % لله أي مصدر ومردف % يهتز بين ثقيله وخفيفه % % 69(@)(@@) % ناهيك عن صدر ومن تسنينه % % ناهيك من ردف ومن تسنيفه % % 70(@)(@@) % كسي المهابة كلها بغنائه % % في كل نازل مضلع ومطيفه % % PageV01P2923 71(@)(@@) % فترى السنان يلوح في تصديره % % وترى الحسام يلوح في ترديفه % % 72(@)(@@) % وظليم أسفار إذا افترش الفلا % % بارى الظليم فزف مثل زفيفه % % 73(@)(@@) % كلفته حملي إليك فخف بي % % وابتاع خطوته بقرب أليفه % % 74(@)(@@) % يممت وجهك أهتدي بنجومه % % عند احتشاد الليل في تسجيفه % % 75(@)(@@) % وصدت عما قال فيك مجرب % لا عن مقالة عائف ومعيفه % % 76(@)(@@) % ومؤمل أغنيته ومؤمل % رجى غناك لججت في تسويفه % % 77(@)(@@) % لم تأل في تقديم مالك غائظا % لمسابق لم تأل في تخليفه % % 78(@)(@@) % فاسلم وكن أبدا أمام عنانه % % سبقا وكن عمرا وراء رديفه % % 79(@)(@@) % وأما وأشراف الرجال ألية % من مخلص يغنيك عن تحليفه % % 80(@)(@@) % ليشنفنهم بمدحك صائغ % لا تكبر الآذان عن تشنيفه % % PageV01P2924 البحر : - 1(@)(@@) % رأيت الدهر يرفع كل وغد % ويخفض كل ذي شيم شريفه % % 2(@)(@@) % كمثل البحر يغرق فيه حي % ولا ينفك تطفو فيه جيفه % 3(@)(@@) % أو الميزان يخفض كل واف % ويرفع كل ذي زنة خفيفه % 4(@)(@@) % كذلك دأبه فينا وإنا % % على ما كان في حصن منيفه % % 5(@)(@@) % بناها أولونا فاعتصمنا % % بها وبأنفس فينا عفيفه % % 6(@)(@@) % إذا ما جهله أربى علينا % % حملناه بألباب حصيفه % % 7(@)(@@) % وندرأ بؤسه بالصبر حتى % % نفرجه بأذهان لطيفه 