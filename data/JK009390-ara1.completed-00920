ms901	 من ثقات المسلمين .(@)(@@)(@@)(@@) $ ( 8057 ) قال النبي :(@)(@@) | 30 ( إنكم يا معاشر الأنصار لا تهاجرون إلى أحد ، ولاكن الناس يهاجرون إليكم ، والذي نفس محمد بيده ، لا يحب رجل الأنصار حتى يلقى الله إلا لقي الله تعالى وهو يحبه ، ولا يبغض رجل الأنصار حتى يلقى الله إلا لقي الله وهو يبغضه ) )(@)(@@) ( حم خ ) في التاريخ ( د ) في فضائل الأنصار وابن أبي خيثمة ( ع ) وأبو عوانة وابن منيع والبغوي والبارودي وابن قانع ( طب ض ) عن الحارث بن زياد الساعدي الأنصاري ، قال البغوي : ولا أعلم غيره .(@)(@@)(@@)(@@) $ ( 8058 ) قال النبي :(@)(@@) | 30 ( إنكم ستظفرون بالشام وتغلبون عليها ، وتصيبون على سيف بحرها حصنا يقال له : أنفة ، يبعث الله منه يوم القيامة اثني عشر ألف شهيد ) )(@)(@@) ( طب ) و ابن عساكر عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8059 ) قال النبي :(@)(@@) | 30 ( إنكم قد أصبحتم في زمان ، كثير فقهاؤه ، كثير خطباؤه ، كثير سواله ، قليل معطوه ، العلم فيه خير من العمل ) )(@)(@@) ( طب ) عن حزام بن حكيم بن حزام عن أبيه ( طب ) وابن عساكر عن حزام بن حكيم عن عمه عبد الله بن سعيد الأنصاري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8060 ) قال النبي :(@)(@@) | 30 ( إنكم ستجندون أجنادا ويكون لكم ذمة وخراج وأرض يمنحها الله لكم ، منها ما يكون على شفير البحر مدائن وقصور ، فمن أدركه ذالك منكم فاستطاع أن يحبس نفسه في مدينة من تلك المدائن أو قصر من تلك القصور حتى يدركه الموت فليفعل ) )(@)(@@) أبو حاتم في الوحدان والبغوي وابن عساكر عن عروة بن رويم PageV03P186 عن شيخ من جرش عن سليمان عن رجل من الصحابة .(@)(@@)(@@)(@@) $ ( 8061 ) قال النبي :(@)(@@) | 30 ( إنكم لعلى عمل صالح لولا أن تغلبوا عليه لنزلت فنزعته معكم ) )(@)(@@) ابن سعد عن مجاهد أن رسول الله أتى زمزم فقال : اسقوا لي منها دلوا ثم قال : فذكره .(@)(@@)(@@)(@@) $ ( 8062 ) قال النبي :(@)(@@) | 30 ( إنكم لتفعلون ذالك يعني العزل أو لم تعلموا ، أن الله لم يخلق نسمة هو بادئها إلا وهي كائنة ) )(@)(@@) ( طب ) عن حذيفة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8063 ) قال النبي :(@)(@@) | 30 ( إنكم في زمان علماؤه كثير 
ms902	 وخطباؤه قليل ، من ترك فيه عشر ما يعلم هوى ، وسيأتي على الناس زمان يقل علماؤه ويكثر خطباؤه ، من تمسك به بعشر ما يعلم نجا ) )(@)(@@) ( حم ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8064 ) قال النبي :(@)(@@) | 30 ( إنكم تحشرون إلى بيت المقدس ثم تجمعون إلى يوم القيامة ) )(@)(@@) ( طب ) عن سمرة بن جندب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8065 ) قال النبي :(@)(@@) | 30 ( إنكم أمة مرحومة معافاة فاستقيموا وخذوا طاقة الأمر ) )(@)(@@) ( طب ) عن أبي مالك الأشعري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8066 ) قال النبي :(@)(@@) | 30 ( إنكم ستحرصون على الإمارة وإنها ستكون ندامة وحسرة يوم القيامة ، فنعمت المرضعة وبئست الفاطمة ) )(@)(@@) ( حم ش خ ن ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8067 ) قال النبي :(@)(@@) | 30 ( إنكم منصورون ومصيبون ومفتوح لكم ، فمن أدرك ذالك منكم فليتق الله وليأمر بالمعروف ولينه عن المنكر ، وليصل الرحم ، ومن كذب PageV03P187 علي متعمدا فليتبوأ مقعده من النار ) )(@)(@@) ( حم ت ) حسن صحيح ( ق ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8068 ) قال النبي :(@)(@@) | 30 ( إنكم يا أهل اليمامة أحذق شيء باخلاط الطين ، فاخلط لنا الطين ) )(@)(@@) ( طب ) عن طل ق بن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8069 ) قال النبي :(@)(@@) | 30 ( إنكم أصبتم خيرا وإنا مجمعون ، فمن أراد أن يجلس في بيته ولا يحضر الجمعة في غير حرج ) )(@)(@@) الشيرازي في الألقاب عن أبي قتادة قال : اجتمع عيدان ، فصلى بنا رسول الله العيد ثم خطب فقال فذكره .(@)(@@)(@@)(@@) $ ( 8070 ) قال النبي :(@)(@@) | 30 ( إنكم قد أخذتم في شعبتين بعيدي الغور ، فيهما هلك أهل الكتاب من قبلكم ، هاذا كتاب من الرحمان الرحيم ، فيه تسمية أهل النار بأسمائهم وأسماء آبائهم وقبائلهم وعشائرهم ، مجمل على آخرهم لا ينقص منهم أحد ، فريق في الجنة وفريق في السعير ) )(@)(@@) ( قط ) في الأفراد عن ابن عباس رضي الله عنهما قال : خرج النبي يوما فسمع ناسا من أصحابه يذكرون القدر فقال فذكره .(@)(@@)(@@)(@@) $ ( 8071 ) قال النبي :(@)(@@) | 30 ( إنكم بعثتم هداة ولن تبعثوا مضلين ، كونوا معلمين ولا تكونوا معانتين ، أرشدوا الرجل ) )(@)(@@) ( حل ) عن الأعمش عن عمرو بن مرة الجملي عن أبي البحتري رضي الله 
ms903	 عنه .(@)(@@)(@@)(@@) $ ( 8072 ) قال النبي :(@)(@@) | 30 ( إنكم ستظهرون على الأعاجم فتجدون بيوتا تدعى الحمامات ، فلا يدخلها الرجل إلا بازار ، ولا يدخلها النساء إلا نفساء أو من مرض ) )(@)(@@) عن عبد الرزاق ( طب ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8073 ) قال النبي :(@)(@@) | 30 ( إنكم ستكونون أجنادا مجندة جندا بالشام ، وجندا بالعراق ، وجندا باليمن ، فعليكم بالشام فإنها صفوة الله من بلاده وفيها خيرته من عباده ، وفيها يربط الله نوره ، فمن أبى فليلحق بيمنه وليسق من غدره ، فإن الله قد PageV03P188 تكفل بالشام وأهله ) )(@)(@@) ( طب ك ) عن عبد الله بن حوالة .(@)(@@)(@@)(@@) $ ( 8074 ) قال النبي :(@)(@@) | 30 ( إنكم ستجندون أجنادا : جندا بالشام ومصر والعراق واليمن ، قالوا : فخر لنا يا رسول الله قال : عليكم بالشام ، فمن أبى فليلحق بيمنه ، وليسق من غدره ، فإن الله قد تكفل لي بالشام ) )(@)(@@) ( طب ) عن أبي الدرداء .(@)(@@)(@@)(@@) $ ( 8075 ) قال النبي :(@)(@@) | 30 ( إنكم تتحدثون أني من آخركم وفاة ، وإني من أولكم وفاة وتتبعوني أفنادا يفني بعضكم بعضا ) )(@)(@@) ( طب ) عن معاوية ( طب ) عن واثلة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8076 ) قال النبي :(@)(@@) | 30 ( إنكم كنتم أمواتا فرد الله إليكم أرواحكم ، فمن نام عن صلاة فليصلها إذا استيقظ ، ومن نسي صلاة فليصلها إذا ذكرها ) )(@)(@@) ( ع طب ) عن أبي جحيفة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8077 ) قال النبي :(@)(@@) | 30 ( إنكم سيكثر لكم من الخفاف قالوا : فما تأمرنا ؟ قال : تمسحون عليها ) )(@)(@@) ( طب ) عن معقل بن يسار رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8078 ) قال النبي :(@)(@@) | 30 ( إنكم ستفتحون أفقا فبها بيوت يقال لها : الحمامات ، حرام على أمتي دخولها ، قالوا : يا رسول الله إنها تذهب الوصب ، وتنقي الدرن ، قال : فإنها حلال لذكور أمتي في الأزر حرام على إناث أمتي ) )(@)(@@) ( طب ) عن المقدام بن معدي كرب رضي الله عنه .(@)(@@)(@@)(@@) $ 8079 قال النبي :(@)(@@) | 30 ( إنكم تقولون لا عدو ، ولا تزالون تقاتلون عدوا حتى تقاتلوا يأجوج ومأجوج ، عراض الوجوه ، صغار العيون ، صهب الشعور من كل حدب ينسلون ، كأن وجوههم المجان المطرقة ) )(@)(@@) ( حم طب ) عن خالد بن عبد الله بن حرملة عن خالته .(@)(@@) PageV03P189(@)(@@)(@@)(@@) $ ( 8080 ) قال النبي :(@)(@@) | 30 ( إنكم لن ترجعوا إلى 
ms904	 الله بشيء أحب إليه من شيء خرج منه يعني القرآن ) )(@)(@@) ( ك ) عن جبير بن نفير عن عقبة بن عامر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8081 ) قال النبي :(@)(@@) | 30 ( إنكم تفتنون في القبور كفتنة الدجال ) )(@)(@@) ( حم ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 8082 ) قال النبي :(@)(@@) | 30 ( إنكم أمة مرحومة فلا تنوحوا ولا تطغوا ) )(@)(@@) الخرائطي في مساوىء الأخلاق عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8083 ) قال النبي :(@)(@@) | 30 ( إنكم تعرضون علي بأسمائكم وسيماكم ، فأحسنوا الصلاة علي ) )(@)(@@) عبد الرزاق عن مجاهد مرسلا صحيحا .(@)(@@)(@@)(@@) $ ( 8084 ) قال النبي :(@)(@@) | 30 ( إنكم تكتسبون بعدي حتى تقولوا متى ، وستأتون أفنادا سنوات الزلازل ) )(@)(@@) نعيم بن حماد في الفتن عن سلمة بن نفيل رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8085 ) قال النبي :(@)(@@) | 30 ( إنما الأعمال بخواتيمها كالوعاء إذا طاب أعلاه طاب أسفله ، وإذا خبث أعلاه خبث أسفله ) )(@)(@@) ابن عساكر عن معاوية رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8086 ) قال النبي :(@)(@@) | 30 ( إنما الأعمال بالنيات ، وإنما لكل امرىء ما نوى ، فمن كانت هجرته إلى الله ورسوله فهجرته إلى الله ورسوله ، ومن كانت هجرته إلى دنيا يصيبها أو امرأة يتزوجها فهجرته إلى ما هاجر إليه ) )(@)(@@) مالك في رواية مالك بن الحسن ( حم خ م ت د ن ه ) عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8087 ) قال النبي :(@)(@@) | 30 ( إنما الإيمان بمنزلة القميص يقمصه الرجل مرة وينزعه مرة أخرى ) )(@)(@@) الحكيم وابن مردويه عن عتبة بن عبد الله بن خالد بن معدان عن PageV03P190 أبيه عن جده .(@)(@@)(@@)(@@) $ ( 8088 ) قال النبي :(@)(@@) | 30 ( إنما الحسد في اثنتين : رجل آتاه الله القرآن فأقام به ، فأحل حلاله وحرم حرامه ، ورجل آتاه الله مالا فوصل منه أقاربه ورحمه وعمل بطاعة الله ) )(@)(@@) ( طب ) عن ابن عمرو رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 8089 ) قال النبي :(@)(@@) | 30 ( إنما لامرىء ما كسب وعليه ما اكتسب ، والمرء مع من أحب ، ومن مات على ذنابى طريق فهو من أهله ) )(@)(@@) الحكيم عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8090 ) قال النبي :(@)(@@) | 30 ( إنما أنا مبلغ والله يهدي ، وإنما أنا قاسم والله يعطي ، فمن جاءه منا شيء بحسن هدي وحسن رعة 
ms905	 ، فذالك الذي يبارك له فيه ، ومن جاءه منا شيء بسوء هدي وسوء رعة فذالك الذي يأكل ولا يشبع ) )(@)(@@) ( طب ) عن معاوية رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8091 ) قال النبي :(@)(@@) | 30 ( إنما أنا بشر وإني كنت جنبا فنسيت أن أغتسل ) )(@)(@@) ( طس هق ) عن أبي هريرة رضي الله عنه ( حم ) عن أبي بكرة أن النبي كبر بهم في صلاة الصبح فأومأ إليهم ، ثم انطلق ورجع ورأسه يقطر فصلى بهم ثم قال فذكره .(@)(@@)(@@)(@@) $ ( 8092 ) قال النبي :(@)(@@) | 30 ( إنما أخاف عليكم شهوات الفيء في بطونكم وفروجكم ومضلات الهوى ) )(@)(@@) ( طس ) عن أبي برزة الأسلمي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8093 ) قال النبي :(@)(@@) | 30 ( إنما أخاف عليكم كل منافق عليم ، يتكلم بالحكمة ويعمل بالجور ) )(@)(@@) عبد بن حميد ( هب ) عن عمر رضي الله عنه .(@)(@@) PageV03P191(@)(@@)(@@)(@@) $ ( 8094 ) قال النبي :(@)(@@) | 30 ( إنما أنا لكم مثل الوالد للولد أعلمكم إذا أتيتم الغائط فلا تستقبلوا القبلة ولا تستدبروها ) )(@)(@@) عبد الرزاق عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8095 ) قال النبي :(@)(@@) | 30 ( إنما مثل صوم التطوع مثل الرجل يخرج من ماله الصدقة ، فإن شاء أمضاها ، وإن شاء حبسها ) )(@)(@@) ( ن ه ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 8096 ) قال النبي :(@)(@@) | 30 ( إنما منزلة من صام في غير رمضان ، أو في غير قضاء رمضان أو في التطوع بمنزلة رجل أخرج صدقة ماله فجاد منها بما شاء ، فأمضاه وبخل بما بقي فأمسكه ) )(@)(@@) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 8097 ) قال النبي :(@)(@@) | 30 ( إنما يفعل ذالك الذين لا يعلمون ) )(@)(@@) ( حم ) و البغوي وابن قانع ( ض ) عن دحية الكلبي قال : قلت : يا رسول الله ألا أحمل لك حمارا على فرس فتنتج لك بغلا ؟ قال فذكره ( د ن ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8098 ) قال النبي :(@)(@@) | 30 ( إنما العشور على اليهود والنصارى ، وليس على المسلمين عشور ) )(@)(@@) ابن سعد ( د ) والبغوي وابن قانع ( هق ) عن حرب بن عبيد الله عن جده أبي أمه عن أبيه قال البغوي : رواه جماعة عن عطاء بن السائب عن حرب عن جده ، ولم يقل فيه أحد عن أبيه غير أبي الأحوص ( حم 
ms906	 د هق ) عن رجل من بكر من وائل عن خاله البغوي عن حرب بن عبيد الله الثقفي عن خاله البغوي عن حرب بن هلال الثقفي عن رجل من بني ثعلب .(@)(@@)(@@)(@@) $ ( 8099 ) قال النبي :(@)(@@) | 30 ( إنما ذالك شيء كان يقوله العباس بن عبد المطلب وأبو سفيان بن حرب ليأمنا باليمن ، معاذ الله أن نزني أمنا أو نقفو أبانا ، نحن بنو النضير بن كنانة من قال غير ذالك فقد كذب ) )(@)(@@) ابن سعد عن ابن أبي ذئب عن أبيه أنه قيل لرسول الله أن هاهنا ناسا من كندة يزعمون أنك منهم قال فذكره .(@)(@@) PageV03P192(@)(@@)(@@)(@@) $ ( 8100 ) قال النبي :(@)(@@) | 30 ( إنما خرجت من نكاح ولم أخرج من سفاح من لدن آدم لم يصبني من سفاح أهل الجاهلية شيء ، لم أخرج إلا من طهرة ) )(@)(@@) ابن سعد عن محمد بن علي بن حسين مرسلا .(@)(@@)(@@)(@@) $ ( 8101 ) قال النبي :(@)(@@) | 30 ( إنما هاذا رحم ، وإن من لا يرحم لا يرحم ، إنما ينهى الناس عن النياحة ، وأن يندب الرجل بما ليس فيه ، ل| ولا أنه وعد جامع ، وسبيل منيتنا ، وأن آخرنا لاحق بأولنا لوجدنا عليه وجدا غير هاذا ، وإنا عليه لمحزونون ، تدمع العين ، ويحزن القلب ، ولا نقول ما يسخط الرب ، وفضل رضاعه في الجنة ) )(@)(@@) ابن سعد عن مكحول قال : دخل رسول الله وإبراهيم يجود بنفسه فدمعت عيناه فقال له عبد الرحمان بن عوف رضي الله عنه هاذا الذي تنهانا عنه قال فذكره .(@)(@@)(@@)(@@) $ ( 8102 ) قال النبي :(@)(@@) | 30 ( إني لم أنه عن البكاء ، إنما نهيت عن النوح عن صوتين أحمقين فاجرين ، صوت عند نغمة لهو ولعب ومزامير شيطان ، وصوت عند مصيبة ، خمم وجوه ، وشق جيوب ، ورنة شيطان ، إنما هاذا رحمة ومن لا يرحم لا يرحم ، يا إبراهيم لولا أنه أمر حق ووعد صدق ، وأنها سبيل مأتية ، وأن آخرنا سيلحق أولنا لحزنا عليك حزنا أشد من هاذا ، وإنا بك لمحزونون ، تدمع العين ويحزن القلب ولا نقول ما يسخط الرب عز وجل ) )(@)(@@) ابن سعد ( هق ) عن جابر وروى ( ت ) بعضه وحسنه عن عبد الرحمان بن عوف 
ms907	 رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8103 ) قال النبي :(@)(@@) | 30 ( إنما العباس صنو أبي ، فمن آذى العباس فقد آذاني ) )(@)(@@) ابن سعد عن أبي مجلز مرسلا .(@)(@@)(@@)(@@) $ ( 8104 ) قال النبي :(@)(@@) | 30 ( إنما جزاء السلف الحمد والوفاء ) )(@)(@@) ( حم ن ه ) و ابن سعد ( طب حل ص هق ) وابن السني في عمل يوم وليلة عن إسماعيل بن إبراهيم بن عبد الله ابن أبي ربيعة عن أبيه عن جده .(@)(@@) PageV03P193(@)(@@)(@@)(@@) $ ( 8105 ) قال النبي :(@)(@@) | 30 ( إنما بعثت لأتمم مكارم الأخلاق ) )(@)(@@) ( هق ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8106 ) قال النبي :(@)(@@) | 30 ( إنما بعثت لاتمم حسن الأخلاق ) )(@)(@@) ابن سعد عن مالك بن أنس رضي الله عنه بلاغا .(@)(@@)(@@)(@@) $ ( 8107 ) قال النبي :(@)(@@) | 30 ( إنما العينان وكاء السه ، فإذا نامت العين استطلق الوكاء ، فمن نام فليتوضأ ) )(@)(@@) الدارمي ( طب ) عن معاوية رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8108 ) قال النبي :(@)(@@) | 30 ( إنما العين وكاء السه ، فإذا نامت العين انطلق الوكاء ، فمن نام فليتوضأ ) )(@)(@@) الدارمي ( طب حل هق ) في المعرفة عن معاوية رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8109 ) قال النبي :(@)(@@) | 30 ( إنما أخاف على أمتي الأئمة المضلين ) )(@)(@@) ( ت ) صحيح عن ثوبان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8110 ) قال النبي :(@)(@@) | 30 ( إنما جعل الإمام ليؤتم به ، فإذا كبر فكبروا ، وإذا ركع فاركعوا ، وإذا رفع فارفعوا ، وإذا قال سمع الله لمن حمده ، فقولوا : اللهم ربنا ولك الحمد ، وإذا سجد فاسجدوا ، وإذا صلى جالسا فصلوا جلوسا أجمعون ) )(@)(@@) مالك ( ط حم م ش م خ م د ت ن ه حب ) عن أنس بن مالك ( حم ش خ م د ه حب ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 8111 ) قال النبي :(@)(@@) | 30 ( إنما هو فراش للزوج وفراش للمرأة ، وفراش للضيف ، وفراش للشيطان ) )(@)(@@) الهيثم بن كلب ( ض ) عن ثوبان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8112 ) قال النبي :(@)(@@) | 30 ( إنما ذالك سواد الليل وبياض النهار يعني قوله PageV03P194 تعالى : { الخيط الأبيض من الخيط الأسود } ) )(@)(@@) ( خ م ت ) عن عدي بن حاتم .(@)(@@)(@@)(@@) $ ( 8113 ) قال النبي :(@)(@@) | 30 ( إنما الخيط الأبيض من الخيط الأسود الذي في أفق السماء ) )(@)(@@) ( طب ) عن عدي بن حاتم رضي الله عنه 
ms908	 .(@)(@@)(@@)(@@) $ ( 8114 ) قال النبي :(@)(@@) | 30 ( إنما أمرت بالوضوء إذا قمت إلى الصلاة ) )(@)(@@) ( د ت ) حسن ( ن ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 8115 ) قال النبي :(@)(@@) | 30 ( إنما الإمام جنة ، فإذا صلى قائما فصلوا قياما ، وإن صلى جالسا فصلوا جلوسا ) )(@)(@@) ( قط ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8116 ) قال النبي :(@)(@@) | 30 ( إنما بقاؤكم فيما سلف قبلكم من الأمم كما بين صلاة العصر إلى غروب الشمس ، أوتي أهل التوراة التوراة فعملوا حتى إذا انتصف النهار ثم عجزوا فاعطوا قيراطا قيراطا ، ثم أوتي أهل الإنجيل الإنجيل فعملوا إلى صلاة العصر ثم عجزوا فاعطوا قيراطا قيراطا ، ثم أوتينا القرآن فعملنا إلى غروب الشمس فاعطينا قيراطين قيراطين ، فقال أهل الكتاب : أي ربنا أعطيت هاؤلاء قيراطين قيراطين وأعطيتنا قيراطا قيراطا ونحن كنا أكثر عملا ، قال الله عز وجل : هل ظلمتكم من أجركم من شيء ؟ قالوا : لا ، قال : فهو فضلي أوتيه من أشاء ) )(@)(@@) ( ط خ ) عن سالم بن عبد الله عن أبيه .(@)(@@)(@@)(@@) $ ( 8117 ) قال النبي :(@)(@@) | 30 ( إنما أهلك الذين من قبلكم أنهم كانوا إذا سرق فيهم الشريف تركوه ، وإذا سرق فيهم الضعيف أقاموا عليه الحد ، وايم الله لو أن فاطمة بنت محمد سرقت لقطعت يدها ) )(@)(@@) ( حم خ م د ت ن ه ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 8118 ) قال النبي :(@)(@@) | 30 ( إنما تفرقكم في الشعاب والأودية من الشيطان ) )(@)(@@) PageV03P195 ( حم د طب ك هق ) عن أبي ثعلبة الخشني قال : كان الناس إذا نزلوا منزلا مع رسول الله يقول فذكره .(@)(@@)(@@)(@@) $ ( 8119 ) قال النبي :(@)(@@) | 30 ( إنما للمرء ما طابت به نفس إمامه ) )(@)(@@) ( طب ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8120 ) قال النبي :(@)(@@) | 30 ( إنما مثل هاذا مثل الذي يصلي وهو مكتوف ) )(@)(@@) ( م د ن ) عن ابن عباس رضي الله عنه أنه رأى رجلا يصلي ورأسه معقوص من ورائه فقال : سمعت رسول الله يقول فذكره .(@)(@@)(@@)(@@) $ ( 8121 ) قال النبي :(@)(@@) | 30 ( إنما جعل الله الإذن من أجل البصر ) )(@)(@@) ( م ) عن سهل بن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8122 ) قال النبي :(@)(@@) | 30 ( إنما سمي شعبان : لأنه يتشعب فيه 
ms909	 خير كثير للصائم فيه حتى يدخل الجنة ) )(@)(@@) أبو الشيخ في الثواب والرافعي في تاريخه عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8123 ) قال النبي :(@)(@@) | 30 ( إنما سمي رمضان لأنه يرمض الذنوب ، وإن في رمضان ثلاث ليال ، من فاتته فاته خير كثير : ليلة تسع عشرة ، وليلة إحدى وعشرين وآخرها سوى ليلة القدر ، فمن لم يغفر له في شهر رمضان ، ففي أي شهر يغفر له ) )(@)(@@) محمد بن منصور السمعاني في أماليه والديلمي والرافعي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8124 ) قال النبي :(@)(@@) | 30 ( إنما يجزئك من ذالك الوضوء يعني المذي ) )(@)(@@) ( حم ) و الدارمي ( ه ع ) وابن خزيمة ( حب طب ض ) عن سهل بن حنيف رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8125 ) قال النبي :(@)(@@) | 30 ( إنما يكفيك أن تأخذ كفا من ماء فتنضح به ثوبك PageV03P196 حيث ترى أنه أصابه ) )(@)(@@) ( حم هق ) و الدارمي ( طب ) وابن خزيمة ( حب ض ) عن سهل بن حنيف رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8126 ) قال النبي :(@)(@@) | 30 ( إنما علي مني بمنزلة هارون من موسى ، إلا أنه لا نبي بعدي ) )(@)(@@) الخطيب عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8127 ) قال النبي :(@)(@@) | 30 ( إنما علينا الوضوء فيما يخرج ، وليس علينا فيما يدخل ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8128 ) قال النبي :(@)(@@) | 30 ( إنما هو بضعة منك يعني ذكره ) )(@)(@@) ( حم حب طب قط ض ) عن طلق بن علي ( طب ) عن ابن مسعود رضي الله عنه موقوفا .(@)(@@)(@@)(@@) $ ( 8129 ) قال النبي :(@)(@@) | 30 ( إن ما جئت به غير مغن عنا شيئا إلا ما أغنت حجارة الحرة ، ولاكنه متاع الحياة الدنيا ) )(@)(@@) ( حم حب ض ) عن أبي سعيد رضي الله عنه أن رجلا قدم بحلي من البحرين فقال رسول الله فذكره .(@)(@@)(@@)(@@) $ ( 8130 ) قال النبي :(@)(@@) | 30 ( إنما يغسل بول الجارية ، وينضح بول الغلام ) )(@)(@@) ( حم د ه طب ك هق ) عن أم الفضل لبابة بنت الحارث رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8131 ) قال النبي :(@)(@@) | 30 ( إنما الآيات تخويف يخوف الله بها عباده ، فإذا رأيتم ذالك فصلوا كأحدث صلاة صليتموها من المكتوبة ) )(@)(@@) ( هق ) عن قبيصة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8132 ) قال النبي 
ms910	 :(@)(@@) | 30 ( إنما أتخوف عليكم رجل قرأ القرآن حتى إذا رئي عليه بهجته وكان ردءا للاسلام اعتزل إلى ما شاء الله ، فانسلخ منه وخرج على جاره بسيفه ورماه بالشرك ) )(@)(@@) ( بر ) وحسنه ( ع حب ض ) عن جندب بن حذيفة رضي الله عنه .(@)(@@) PageV03P197(@)(@@)(@@)(@@) $ ( 8133 ) قال النبي :(@)(@@) | 30 ( إنما بعثت رحمة ولم أبعث عذابا ) )(@)(@@) ( ع هب ) و ابن عساكر عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8134 ) قال النبي :(@)(@@) | 30 ( إنما يختبر بهاذا المؤمن ) )(@)(@@) ( ع ) عن عائشة رضي الله عنها قالت : سئل رسول الله عن الوسوسة ؟ فكبر ثلاثا ثم قال فذكره .(@)(@@)(@@)(@@) $ ( 8135 ) قال النبي :(@)(@@) | 30 ( إنما الوضوء على من اضطجع ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8136 ) قال النبي :(@)(@@) | 30 ( إنما مثل الذي يتصدق بصدقة ثم يعود في صدقته كمثل الكلب يقيء ثم يأكل قيئه ) )(@)(@@) ( م ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 8137 ) قال النبي :(@)(@@) | 30 ( إنما ذالك عرق ، فإذا أقبلت الحيضة فدعي الصلاة ، وإذا أدبرت فاغسلي عنك الدم ثم صلي ) )(@)(@@) ( ك ) عن فاطمة بنت قيس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8138 ) قال النبي :(@)(@@) | 30 ( إنما مثلي ومثلكم ومثل الدنيا كمثل قوم سلكوا مفازة غبراء لا يدرون ما قطعوا منها أكثر أم ما بقي منها ؟ فحسر ظهرهم ، ونفذ زادهم ، وسقطوا بين ظهراني المفازة فأيقنوا بالهلكة ، فبينما هم كذالك ، إذ خرج عليهم رجل في حلة يقطر رأسه ، فقالوا : إن هاذا لحديث عهد بالريف ، فانتهى إليهم فقال : ما لكم ميا هاؤلاء ؟ قالوا : ما نرى حسر ظهرنا ، وفقد زادنا ، وسقطنا بين ظهراني المفازة لا ندري ما قطعنا منه أكثر أم ما بقي علينا ؟ قال : ما تجعلون لي إن أوردتكم ماء رواء ورياضا خضرا ؟ قالوا : نجعل لك حكمك علينا ، قال : تجعلون لي عهودكم ومواثيقكم أن لا تعصوني ، فجعلوا له عهودهم ومواثيقهم أن لا يعصوه ، فمال بهم فأوردهم رياضا خضرا وماء رواء ، فمكث يسيرا ثم قال لهم : هلموا إلى رياض أعشب من رياضكم ، وماء أروى من مائكم ، فقال جل القوم : ما قدرنا على هاذا حتى كدنا أن لا نقدر عليه ، وقالت 
ms911	 طائفة منهم : ألستم قد جعلتم PageV03P198 لهاذا الرجل عهودكم ومواثيقكم أن لا تعصوه ، وقد صدقكم في أول حديثه ، وآخر حديثه مثل أوله ، فراح وراحوا معه ، فأوردهم رياضا خضرا ، وماء رواء ، وأتى الآخرين العدو من تحت ليلتهم فأصبحوا ما بين قتيل وأسير ) )(@)(@@) الرامهرمزي في الأمثال ( كر ) عن ابن المبارك قال : بلغنا عن الحسن ، وقال ( كر ) هاذا مرسل وفيه انقطاع بين ابن المبارك والحسن .(@)(@@)(@@)(@@) $ ( 8139 ) قال النبي :(@)(@@) | 30 ( إنما أنا عبد آكل كما يأكل العبد ) )(@)(@@) ( قط ) في الأفراد و ابن عساكر عن البراء هناد عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 8140 ) قال النبي :(@)(@@) | 30 ( إنما قمنا للملائكة ) )(@)(@@) ( ن ك ) عن أنس رضي الله عنه أن جنازة مرت برسول الله فقام ، فقيل إنها جنازة يهودي قال فذكره .(@)(@@)(@@)(@@) $ ( 8141 ) قال النبي :(@)(@@) | 30 ( إنما العلم بالتعلم ، وإنما الحلم بالتحلم ، ومن يتحر الخير يعطه ، ومن يتق الشر يوقه ، ثلاث من كن فيه لم ينل الدرجات العلى ، ولا أقول لكم الجنة من تكهن ، أو استقسم ، أو رده من سفر تطير ) )(@)(@@) ( طس ) و الخطيب وابن عساكر عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8142 ) قال النبي :(@)(@@) | 30 ( إنما يفعل ذالك النصارى يعني الوصال ولاكن صوموا كما أمركم الله عز وجل ثم أتموا الصيام إلى الليل ، فإذا كان الليل فأفطروا ) )(@)(@@) ( حم طب ض ) عن ليلى امرأة بشير بن الخصاصية عن بشير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8143 ) قال النبي :(@)(@@) | 30 ( إنما الناس معادن ، خيارهم في الجاهلية خيارهم في الإسلام إذا فقهوا ، لا يؤذين مسلم بكافر ) )(@)(@@) ابن عساكر عن أم سلمة رضي الله عنها قالت : لما قدم عكرمة بن أبي جهل جعل يمر بالأنصار فيقولون : هاذا ابن عدو الله أبي جهل ، فشكى ذالك إلى النبي فخطب الناس فقال فذكره .(@)(@@)(@@)(@@) $ ( 8144 ) قال النبي :(@)(@@) | 30 ( إنما سمي البيت العتيق لأن الله أعتقه من الجبابرة فلم يظهر عليه جبار قط ) )(@)(@@) ( ت ) حسن غريب ( ك هب ) و ابن عساكر عن عبد الله بن PageV03P199 الزبير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8145 ) قال النبي :(@)(@@) | 30 ( إنما يستريح من غفر له ) )(@)(@@) ابن المبارك من طريق الزهري 
ms912	 عن محمد بن عروة ( حم ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 8146 ) قال النبي :(@)(@@) | 30 ( إنما يستريح من دخل الجنة ) )(@)(@@) ( حم ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 8147 ) قال النبي :(@)(@@) | 30 ( إنما يحسد من يحسد على خصلتين : رجل آتاه الله القرآن فهو يقوم به آناء الليل وآناء النهار ، ورجل آتاه الله مالا فهو ينفقه ) )(@)(@@) ( هق ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 8148 ) قال النبي :(@)(@@) | 30 ( إنما يشتريه من لا خلاق له يعني الحرير ) )(@)(@@) ( حم طب ) عن حفصة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8149 ) قال النبي :(@)(@@) | 30 ( إنما المرأة كالضلع إن أقمتها كسرتها ، فذرها تعع بها ) )(@)(@@) الروياني ( طب ض ) عن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8150 ) قال النبي :(@)(@@) | 30 ( إنما حملني على الرد عليك مخافة أن تذهب إلى قومك فتقول : إني سلمت على النبي فلم يرد علي ، فإذا رأيتني على هاذه الحال فلا تسلمن علي ، فإنك إن سلمت علي لم أرد عليك ) )(@)(@@) الشافعي ( هق ) في المعرفة والخطيب عن ابن عمر رضي الله عنهما أن رجلا مر على رسول الله وهو يبول فسلم عليه فرد وقال فذكره .(@)(@@)(@@)(@@) $ ( 8151 ) قال النبي :(@)(@@) | 30 ( إنما حرم من الميتة اللحم ، فأما الصوف والشعر والجلد فلا بأس به ) )(@)(@@) ( عد ) و ابن النجار عن ابن عباس رضي الله عنهما .(@)(@@) PageV03P200(@)(@@)(@@)(@@) $ ( 8152 ) قال النبي :(@)(@@) | 30 ( إنما أخاف على أمتي ثلاثا : شحا مطاعا ، وهوى متبعا ، وإماما ضالا ) )(@)(@@) ( طب ) و أبو النصر السجزي في الإبانة وقال : غريب عن أبي الأعور السلمي .(@)(@@)(@@)(@@) $ ( 8153 ) قال النبي :(@)(@@) | 30 ( إنما فرسي هاذا بحر ) )(@)(@@) ( طب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8154 ) قال النبي :(@)(@@) | 30 ( إنما يهدي أحسن الأخلاق وإنما يصرف سيئها هو ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 8155 ) قال النبي :(@)(@@) | 30 ( إنما هو بمنزلة البزاق أو المخاط ، أمطه عنك بخرقة أو باذخر ) )(@)(@@) ( طب هق ) عن ابن عباس رضي الله عنهما قال : سئل رسول الله عن المني يصيب الثوب قال فذكره .(@)(@@)(@@)(@@) $ ( 8156 ) قال النبي :(@)(@@) | 30 ( إنما أقنت بكم لتدعوا ربكم وتسألوه حوائحكم ) )(@)(@@) محمد بن نصر عن عروة مرسلا ( طس ) عنه 
ms913	 عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 8157 ) قال النبي :(@)(@@) | 30 ( إنما جعل الأذان الأول ليتيسر أهل الصلاة لصلاتهم ، فإذا سمعتم الأذان فأسبغوا الوضوء ، وإذا سمعتم الإقامة فبادروا التكبيرة الأولى فإنها فرع الصلاة وتمامها ، ولا تبادروا القارىء الركوع والسجود ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 8158 ) قال النبي :(@)(@@) | 30 ( إنما مثل المؤمن مثل شجرة لا يسقط ورقها : النخلة ) )(@)(@@) ( طب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 8159 ) قال النبي :(@)(@@) | 30 ( إنما هلك من كان قبلكم لسؤالهم أنبياءهم ، واختلافهم عليهم ، ولن يؤمن أحد حتى يؤمن بالقدر خيره وشره ) )(@)(@@) ( طب ) عن عمرو رضي الله عنه .(@)(@@) PageV03P201(@)(@@)(@@)(@@) $ ( 8160 ) قال النبي :(@)(@@) | 30 ( إنما تفسير حسن الخلق ما أصاب من الدنيا يرضى ، وإن لم يصبه لم يسخط ) )(@)(@@) ( حل ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8161 ) قال النبي :(@)(@@) | 30 ( إنما المرء بخليله ، فلينظر امرؤ من يخال ) )(@)(@@) الحارث ( حل ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8162 ) قال النبي :(@)(@@) | 30 ( إنما فاطمة شجنة مني ، يبسطني ما يبسطها ، ويقبضني ما يقبضها ) )(@)(@@) ( ك طب ) عن المسور رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8163 ) قال النبي :(@)(@@) | 30 ( إنما فاطمة بضعة مني ، فمن آذاها فقد آذاني ) )(@)(@@) ( ك ) عن أبي حنظلة مرسلا .(@)(@@)(@@)(@@) $ ( 8164 ) قال النبي :(@)(@@) | 30 ( إنما الشفاعة يوم القيامة لمن عمل الكبائر من أمتي ثم ماتوا عليها ، فهم في الباب الأول من جهنم ، لا تسود وجوههم ، ولا تزرق أعينهم ، ولا يغلون بالأغلال ، ولا يقرنون مع الشياطين ، ولا يضربون بالمقامع ولا يصرخون في الأدراك ، منهم من يمكث فيها ساعة ثم يخرج ومنهم من يمكث فيها يوما ثم يخرج ، ومنهم من يمكث فيها شهرا ثم يخرج ، ومنهم من يمكث فيها سنة ثم يخرج ، وأطولهم مكثا فيها من يمكث مثل الدنيا ، يوم خلقت إلى يوم أفنيت ، وذالك سبعة آلاف سنة ، ثم إن الله تعالى إذا أراد أن يخرج الموحدين منها ، قذف في قلوب أهل الأديان ، فقالوا لهم : كنا نحن وأنتم جميعا في الدنيا ، فآمنتم وكفرنا ، وصدقتم وكذبنا ، وأقررتم وجحدنا ، فما أغنى ذالك عنكم ، نحن وأنتم اليوم فيها جميعا سواء ، تعذبون كما 
ms914	 نعذب ، وتخلدون كما نخلد ، فيغضب الله عند ذالك غضبا لم يغضب من شيء فيما مضى ، ولا يغضب من شيء فيما بقي مثله ، فيخرج أهل التوحيد منها إلى عين بين الجنة والصراط يقال لها نهر الحياة ، فيرش عليهم من الماء ، فينبتون كما تنبت الحبة في حميل السيل ، فما يلي الظل منها أخضر ، وما يلي الشمس منها أصفر ، يدخلون الجنة ، يكتب في جباههم : عتقاء PageV03P202 الله من النار ، إلا رجلا واحدا فإنه يمكث فيها بعدهم ألف سنة ثم ينادي يا حنان يا منان ، فيبعث الله إليه ملكا ليخرجه من النار ، فيخوض في النار في طلبه سبعين عاما لا يقدر عليهم ، ثم يرجع فيقول : إنك أمرتني أن أخرج عبدك فلان من النار ، وإني طلبته منذ سبعين سنة فلم أقدر عليه ، فيقول الله تعالى : انطلق فهو في وادي كذا وكذا تحت صخرة فأخرجه ، فيذهب فيخرجه منها فيدخله الجنة ) )(@)(@@) الحكيم عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8165 ) قال النبي :(@)(@@) | 30 ( إنما خروج ابن صياد لغضبة يغضبها ) )(@)(@@) ( طب ) عن حفصة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 8166 ) قال النبي :(@)(@@) | 30 ( إنما حرم عليكم لحمها ورخص لكم في مسكها ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 8167 ) قال النبي :(@)(@@) | 30 ( إنما يكفي إحداكن أن تتخذ جمانا من فضة ثم تأخذ شيئا من زعفران فتذيفه ثم تلطخه عليه ، فإذا هو كأنه ذهب ) )(@)(@@) ( طب ) عن أسماء بنت يزيد رضي الله عنها .(@)(@@)(@@)(@@) $ ( 8168 ) قال النبي :(@)(@@) | 30 ( إنما أنا لكم مثل الوالد ، فإذا ذهب أحدكم إلى الغائط فلا يستقبل القبلة ولا يستدبرها لغائط ولا بول ، وليستنج بثلاثة أحجار ) )(@)(@@) الشافعي ( هق ) في المعرفة عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8169 ) قال النبي :(@)(@@) | 30 ( إنما أجرك في عمرتك على قدر نفقتك ) )(@)(@@) ( ك ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 8170 ) قال النبي :(@)(@@) | 30 ( إنما جعل الإمام ليؤتم به ، فإذا كبر فكبروا ، وإذا قرأ PageV03P203 فأنصتوا ) )(@)(@@) ( قط هق ) وضعفاه عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8171 ) قال النبي :(@)(@@) | 30 ( إنما أهلك من كان قبلكم الاختلاف ) )(@)(@@) ( حب ك ) عن ابن مسعود 
ms915	 رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8172 ) قال النبي :(@)(@@) | 30 ( إنما تركتك لنفسي أنت أخي وأنا أخوك ، فإن حاجك أحد فقل : أنا عبد الله وأخو رسوله ، لا يدعيها أحد بعدك إلا كذاب ) ( عد ) عن ع$ مر بن عبد الله بن يعلى بن مرة عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 8173 ) قال النبي :(@)(@@) | 30 ( إنما جعل الإمام ليؤتم به ، فإذا كبر فكبروا ولا تكبروا حتى يكبر ، فإذا ركع فاركعوا ولا تركعوا حتى يركع ، فإذا قال سمع الله لمن حمده فقولوا : اللهم ربنا لك الحمد ، وإذا سجد فاسجدوا ، ولا تسجدوا حتى يسجد ، وإذا صلى قائما فصلوا قياما ، وإذا صلى قاعدا فصلوا قعودا أجمعين ) )(@)(@@) ( د هق ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8174 ) قال النبي :(@)(@@) | 30 ( إنما هي هاذه ثم الزمن ظهور الحصر ) )(@)(@@) ( حم ) عن أبي هريرة رضي الله عنه أن رسول الله لما حج بنسائه قال فذكره .(@)(@@)(@@)(@@) $ ( 8175 ) قال النبي :(@)(@@) | 30 ( إنما الطيرة ما أمضاك أو ردك ) )(@)(@@) ( حم ) عن الفضل بن عباس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8176 ) قال النبي :(@)(@@) | 30 ( إنما الطواف صلاة ، فإذا طفتم فأقلوا الكلام ) )(@)(@@) ( حم ) عن رجل .(@)(@@)(@@)(@@) $ ( 8177 ) قال النبي :(@)(@@) | 30 ( إنما الشفاعة لأهل الكبائر ) )(@)(@@) ( هناد ) عن أنس رضي الله عنه .(@)(@@) PageV03P204(@)(@@)(@@)(@@) $ ( 8178 ) قال النبي :(@)(@@) | 30 ( إنما الشمس والقمر آيتان من آيات الله لا يخسفان لموت أحد ولا لحياته ، فإذا رأيتم شيئا منها خاسفا فليكن فزعكم إلى الله ) )(@)(@@) ( هق ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 8179 ) قال النبي :(@)(@@) | 30 ( إنما أتخوف على أمتي ضعف اليقين ) )(@)(@@) ابن المبارك عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8180 ) قال النبي :(@)(@@) | 30 ( إنما بقي من الدنيا بلاء وفتنة ، وإنما مثل عمل أحدكم كمثل الوعاء إذا طاب أعلاه طاب أسفله ، وإذا خبث أعلاه خبث أسفله ) )(@)(@@) ابن المبارك عن معاوية رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8181 ) قال النبي :(@)(@@) | 30 ( إنما يتجالس المتجالسان بأمانة الله تعالى ، فلا يحل لأحدهما أن يفشي على صاحبه ما يكره وأكرم الناس علي جليسي ) )(@)(@@) ابن المبارك والخرائطي في مكارم الأخلاق عن أبي بكر بن محمد بن عمرو حزم مرسلا .(@)(@@)(@@)(@@) $ ( 8182 ) قال 
ms916	 النبي :(@)(@@) | 30 ( إنما يسافر إلى ثلاثة مساجد : مسجد الكعبة ، ومسجدي ، ومسجد إيلا ، والصلاة في مسجدي هاذا أحب إلي من ألف صلاة في غيره إلا مسجد الكعبة ) )(@)(@@) ( هق ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8183 ) قال النبي :(@)(@@) | 30 ( إنما يفدى الحبيب بالحبيب ) )(@)(@@) ابن السني في عمل يوم وليلة عن رباح بن محمد عن أبيه بلاغا .(@)(@@)(@@)(@@) $ ( 8184 ) قال النبي :(@)(@@) | 30 ( إنما حبب إلي من دنياكم : ال| نس اء ، والطيب ، وجعلت قرة عيني في الصلاة ) )(@)(@@) ( هق ) عن انس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8185 ) قال النبي :(@)(@@) | 30 ( إنما تكون الصنيعة إلى ذي دين أو حسب ، وجهاد الضعفاء الحج ، وجهاد المرأة حسن التبعل لزوجها ، والتودد نصف الدين ، وما PageV03P205 عال امرؤ اقتصد ، واستنزلوا الرزق بالصدقة ، وأبى الله أن يجعل أرزاق عباده المؤمنين من حيث لا يحتسبون ) )(@)(@@) ( هب ) وضعفه عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8186 ) قال النبي :(@)(@@) | 30 ( إنما هلك من كان قبلكم بهاذا ، ضربوا كتاب الله بعضه ببعض ، وإنما نزل كتاب الله يصدق بعضه بعضا ، ما علمتم فيه فقولوا ، وما جهللتم فكلوه إلى عالمه ) )(@)(@@) ( هب ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8187 ) قال النبي :(@)(@@) | 30 ( إنما النذر ما ابتغى به وجه الله عز وجل ) )(@)(@@) ( هق كر ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8188 ) قال النبي :(@)(@@) | 30 ( إنما مثل الصلوات الخمس كمثل نهر جار على باب أحدكم ، يغتسل كل يوم خمس مرات ماذا يبقى من درنه ) )(@)(@@) ( هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8189 ) قال النبي :(@)(@@) | 30 ( إنما يكفي أحدكم ما قنعت به نفسه ، وإنما يصير إلى أربعة أذرع في سبع ، وإنما يرجع الأمر إلى آخره ) )(@)(@@) ابن لال في مكارم الأخلاق عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8190 ) قال النبي :(@)(@@) | 30 ( إنما يتجالس المتجالسان بأمانة الله ، فلا يحل لأحدهما أن يفشي على صاحبه ما يكره ، وأكرم الناس علي جليسي ) )(@)(@@) ابن لال من طريق سلمة بن كفيل عن أبيه عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8191 ) قال النبي :(@)(@@) | 30 ( إنما يكفيك أن تقرأ في المغرب بالشمس وضحاها وذواتها ) )(@)(@@) الديلمي 
ms917	 عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8192 ) قال النبي :(@)(@@) | 30 ( إنما سمي البيض لآدم ، لما أهبط إلى الأرض أحرقته الشمس فاسود ، فأوحى الله إليه أن صم البيض ، فصام أول يوم فابيض ثلث جسده ، فلما صام اليوم الثاني ابيض ثلثا جسده ، فلما صام اليوم الثالث ابيض PageV03P206 جسده كله ، فسمي البيض ) )(@)(@@) الديلمي عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 8193 ) قال النبي :(@)(@@) | 30 ( إنما هاذه الأخلاق بيد الله ، فمتى شاء أن يمنحه الله خلقا حسنا فعل ) )(@)(@@) الخرائطي في مكارم الأخلاق عن أبي المنهال .(@)(@@)(@@)(@@) $ ( 8194 ) قال النبي :(@)(@@) | 30 ( إنما بني هاذا المسجد لذكر الله والصلاة ، وإنه لا يبال فيه ) )(@)(@@) الخرائطي في مكارم الأخلاق عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8195 ) قال النبي :(@)(@@) | 30 ( إنما الخال والد ) )(@)(@@) الخرائطي عن وهب خال النبي .(@)(@@)(@@)(@@) $ ( 8196 ) قال النبي :(@)(@@) | 30 ( إنما يحرم على النار كل هين لين قريب سهل ) )(@)(@@) ( حب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8197 ) قال النبي :(@)(@@) | 30 ( إنما الوتر على أهل القرآن ) )(@)(@@) ( ش ) عن ابن مسعود وحذيفة رضي الله عنه موقوفا .(@)(@@)(@@)(@@) $ ( 8198 ) قال النبي :(@)(@@) | 30 ( إنما نهيتكم من أجل الدافة التي دفت عليكم ، فكلوا وتصدقوا وادخروا ) )(@)(@@) ( حب ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 8199 ) قال النبي :(@)(@@) | 30 ( إنما هي ريحانتك ) )(@)(@@) عبد الرزاق عن ابن جريج بلاغا .(@)(@@)(@@)(@@) $ ( 8200 ) قال النبي :(@)(@@) | 30 ( إنما هو عرق تترك الصلاة قدر حيضتها ثم تجمع الظهر والعصر بغسل واحد ، والمغرب والعشاء بغسل واحد ، وتغتسل للصبح غسلا ) )(@)(@@) عبد الرزاق عن ابن عيينة عن عبد الرحمان بن القاسم عن أبيه أن امرأة من المسلمين استحيضت ، فسألت النبي قال فذكره .(@)(@@)(@@)(@@) $ ( 8201 ) قال النبي :(@)(@@) | 30 ( إنما خلعتهما أن جبريل جاءني فأخبرني أن فيهما خبثا ، فإذا جئتم أبواب المساجد فتعاهدوها ، فإن كان بها خبث فحكوها ثم ادخلوا PageV03P207 فصلوا في نعالكم ) )(@)(@@) عبد الرزاق عن عطاء قال حدثت .(@)(@@)(@@)(@@) $ ( 8202 ) قال النبي :(@)(@@) | 30 ( إنما أسرعت لتفرغ أم الصبي إلى صبيها ) )(@)(@@) ( طس ) عن أنس رضي الله عنه قال : صلى بنا رسول الله الفجر بأقصر سورتين ثم قال : فذكره .(@)(@@)(@@)(@@) $ ( 8203 ) قال النبي :(@)(@@) | 30 ( إنما 
ms918	 الإمام ليؤتم به ، فإذا كبر فكبروا ، وإذا ركع فاركعوا ، وإذا سجد فاسجدوا ، وإذا صلى جالسا فصلوا جلوسا أجمعون ) )(@)(@@) الخطيب في المتفق والمفترق عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 8204 ) قال النبي :(@)(@@) | 30 ( إنما الإمام ليؤتم به ، إذا كبر فكبروا ، وإذا ركع فاركعوا ، وإذا قال سمع الله لمن حمده فقولوا : الحمد لله ) )(@)(@@) ( طس ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8205 ) قال النبي :(@)(@@) | 30 ( إنما فاطمة بضعة مني ، فمن أغضبها أغضبني ) )(@)(@@) الحاكم ( طب ) عن المسور بن مخرمة وعن أبي حنظلة مرسلا .(@)(@@)(@@)(@@) $ ( 8206 ) قال النبي :(@)(@@) | 30 ( إنما بقي من الدنيا بلاء وفتنة ، إنما مثل عمل أحدكم كمثل الوعاء إذا طاب أعلاه طاب أسفله ، وإذا خبث أعلاه خبث أسفله ) )(@)(@@) الرامهرمزي في الأمثال عن معاوية وهو صحيح .(@)(@@)(@@)(@@) $ ( 8207 ) قال النبي :(@)(@@) | 30 ( إنما مثل أمتي كمثل ما أنزل الله من السماء ، لا يدري البركة في أولها أو في آخرها ) )(@)(@@) الرامهرمزي عن أنس رضي الله عنه وهو حسن .(@)(@@)(@@)(@@) $ ( 8208 ) قال النبي :(@)(@@) | 30 ( إنما حر جهنم على أمتي مثل حر الحمام ) )(@)(@@) أبو نعيم في المعرفة عن أبي بكر وفيه الواقدي .(@)(@@)(@@)(@@) $ ( 8209 ) قال النبي :(@)(@@) | 30 ( إنما تنصرون بضعفائكم ) )(@)(@@) أبو نعيم عن أبي عبيدة رضي الله عنه .(@)(@@) PageV03P208(@)(@@)(@@)(@@) $ ( 8210 ) قال النبي :(@)(@@) | 30 ( إنما أنا بشر ، ولعل بعضكم أن يكون ألحن بحجته من بعض ، فمن قضيت له من حق أخيه فإنما أقطع له قطعة من النار ) )(@)(@@) ( ش ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8211 ) قال النبي :(@)(@@) | 30 ( إنما مثل أهل بيتي فيكم كمثل سفينة نوح من ركبها نجا ، ومن تخلف عنها هلك ) )(@)(@@) ابن جرير عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8212 ) قال النبي :(@)(@@) | 30 ( إنه لن يموت أحد حتى يستكمل رزقه ، فلا تستبطئوا الرزق واتقوا الله أيها الناس وأجملوا في الطلب ، وخذوا ما حل ودعوا ما حرم ) )(@)(@@) ابن الجارود ( ك ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8213 ) قال النبي :(@)(@@) | 30 ( إنه ليأتي الرجل العظيم السمين يوم القيامة لا يزن عند الله جناح بعوضة ) )(@)(@@) ( خ م ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8214 ) قال النبي 
ms919	 :(@)(@@) | 30 ( إنه عرضت علي الجنة بما فيها من الزهرة والنضرة فتناولت قطفا من عنبها لآتيكم به ، ولو أخذته لأكل منه من بين السماء والأرض لا ينقصونه ، فحيل بيني وبينه ، وعرضت علي النار فلما وجدت حر شعاعها تأخرت ، وأكثر من رأيت فيها النساء اللاتي إن اؤتمن أفشين وإن سئلن أخفين ، وإن أعطين لم يشكرن ، ورأيت فيها عمرو بن لحي يجر قصبه في النار ، وأشبه من رأيت به معبد بن أكثم ، فقال معبد : يا رسول الله أيخشى علي من شبهه ؟ قال : لا أنت مؤمن وهو كافر ، وهو أول من جمع العرب على الأصنام ) )(@)(@@) ( حم ك ض ) من طريق الطفيل بن أبي بن كعب عن أبيه .(@)(@@)(@@)(@@) $ ( 8215 ) قال النبي :(@)(@@) | 30 ( إنه ليس عليك بأس ، إنما هو أبوك وغلامك ) )(@)(@@) ( د ض ) عن أنس رضي الله عنه .(@)(@@) PageV03P209(@)(@@)(@@)(@@) $ ( 8216 ) قال النبي :(@)(@@) | 30 ( إنه لا يدخل الجنة إلا مؤمن ، وإن هاذه أيام أكل وشرب فلا تصمها ) )(@)(@@) ( طب ) عن بشر بن سحيم رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8217 ) قال النبي :(@)(@@) | 30 ( إنه من يسأل الناس فيعطى يكون كالذي يأكل ولا ينفعه ما أكل ، اليد العليا خير من اليد السفلى ، وخير الصدقة ما كان عن ظهر غنى ، وابدأ بمن تعول ) )(@)(@@) ( طب ) عن حكيم بن حزام رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8218 ) قال النبي :(@)(@@) | 30 ( إنه يأتي على الناس زمان يخرجون إلى الأرياف فيصيبون منها مطعما وملبسا ومركبا ، فيكتبون إلى أهليهم هلموا إلينا ، فإنكم بأرض حجاز جدوبة والمدينة خير لهم لو كانوا يعلمون ، لا يصبر على لأوائها وشدتها أحد إلا كنت له شفيعا أو شهيدا يوم القيامة ) )(@)(@@) ( طب ) عن أبي أسيد الساعدي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8219 ) قال النبي :(@)(@@) | 30 ( إنه لا يقتطع رجل مالا إلا لقي الله عز وجل يوم القيامة وهو أجذم ) )(@)(@@) ( طب ) عن الأشعث بن قيس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8220 ) قال النبي :(@)(@@) | 30 ( إنه ما من فرس عربي إلا يؤذن له مع كل فجر يدعو بدعوتين يقول : اللهم إنك خولتني من خولتني من بني آدم فاجعلني من أحب أهله وماله إليه ) )(@)(@@) ( حم 
ms920	 ن ) و الروياني وأبو الشيخ في العظمة ( حل ك ق ض ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8221 ) قال النبي :(@)(@@) | 30 ( إنه كائن بعدي سلطان فلا تذلوه ، فمن أراد أن يذله فقد خلع ربقة الإسلام من عنقه ، وليس بمقبول منه حتى يسد ثلمته التي ثلم ، ثم يعود فيكون فيمن يعزه ) )(@)(@@) ( حم هب ) عن أبي ذر رضي الله عنه .(@)(@@) PageV03P210(@)(@@)(@@)(@@) $ ( 8222 ) قال النبي :(@)(@@) | 30 ( إنه سيكون بعدي سلطان فأعزوه ، فإنه من أراد ذلة تعز بعزة في الإسلام ، وليست له توبة إلا أن يسدها ، وليس بسادها إلى يوم القيامة ) )(@)(@@) ( خ ) في تاريخه و الروياني عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8223 ) قال النبي :(@)(@@) | 30 ( إنه لم يدع ملك مقرب ، ولا نبي مرسل ، ولا عبد صالح إلا كان من دعائه : اللهم بعلمك الغيب ، وبقدرتك على الخلق ، أحيني ما علمت الحياة خيرا لي ، وتوفني إذا علمت الوفاة خيرا لي ، وأسألك خشيتك في الغيب والشهادة ، وكلمة الحكم في الغضب والرضى ، والقصد في الفقر والغنى ، وأسألك نعيما لا ينفذ ، وقرة عين لا تنقطع ، وبرد العيي بعد الموت ، وأسألك النظر إلى وجهك والشوق إلى لقائك في غير ضر أو مضرة ، ولا فتنة مضلة ، اللهم زينا بزينة الإيمان ، واجعلنا هداة مهتدين ) )(@)(@@) ابن عساكر عن عمار بن ياسر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8224 ) قال النبي :(@)(@@) | 30 ( إنه لا تفريط في النوم ، إنما التفريط في اليقظة ، فإذا سهى أحدكم عن صلاة فليصلها حين يذكرها ومن الغد للوقت ) )(@)(@@) ( د ن ) عن أبي قتادة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8225 ) قال النبي :(@)(@@) | 30 ( إنه اتبعنا رجل لم يكن معنا حين دعينا فإن أذنت له دخل ) )(@)(@@) ( ت ) حسن صحيح ( طب ) عن أم سلمة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 8226 ) قال النبي :(@)(@@) | 30 ( إنه لا يحبك إلا مؤمن ، ولا يبغضك إلا منافق قاله لعلي ) )(@)(@@) ( ت ) حسن صحيح ( ن ه ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8227 ) قال النبي :(@)(@@) | 30 ( إنه ليغضب على أن لا أجد ما أعطيه ، من سأل منكم وله أوقية أو عدلها فقد سأل إلحافا ) )(@)(@@) ( ن ) و البغوي عن 