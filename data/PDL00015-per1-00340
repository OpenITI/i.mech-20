ms321	 و سرگین استوار(@)(@@) 66 گرد دین بهر صلاح دین به بی‌دینی متن %~% تخم دنیا در قرار تن به مکاری مکار(@)(@@) 67 ای بسا غبنا کت اندر حشر خواهد بود از آنک %~% هست ناقد بس بصیر و نقدها بس کم عیار(@)(@@) 68 سخت سخت آید همی بر جان ز راه اعتقاد %~% زشت زشت آید همی در دین ز راه اعتبار(@)(@@) 69 بر در ماتم سرای دین و چندین نای و نوش %~% در ره رعناسرای دیو و چندان کار و بار(@)(@@) 70 گرد خود گردی همی چون گرد مرکز دایره %~% ای پی اینی بسان خشک مغزان در دوار(@)(@@) 71 از نگارستان نقاش طبیعی برتر آی %~% تا رهی از ننگ جبر و طمطراق اختیار(@)(@@) 72 چون ز دقیانوس خود رستند هست اندر رقیم %~% به ز بیداری شما خواب جوانمردان غار(@)(@@) 73 بازدان تایید دین را آخر از تلقین دیو %~% بازدان روح‌القدس را آخر از حبر نصار(@)(@@) 74 عقل اگر خواهی که ناگه در عقیله‌ت نفکند %~% گوش گیرش در دبیرستان «الرحمان» در آر(@)(@@) 75 عقل بی‌شرع آن جهانی نور ندهد مر ترا %~% شرع باید عقل را همچون معصفر را شخار(@)(@@) 76 عقل جزوی کی تواند گشت بر قرآن محیط %~% عنکبوتی کی تواند کرد سیمرغی شکار(@)(@@) 77 گر چه پیوستست بس دورست جان از کالبد %~% ور چه نزدیکست بس دورست گوش از گوشوار(@)(@@) 78 پیشگاه دوست را شایی چو بر درگاه عشق %~% عافیت را سرنگون سار اندر آویزی بدار(@)(@@) 79 عاشقان را خدمت معشوق تشریفست و بر %~% عاقلان را طاعت معبود تکلیف‌ست و بار(@)(@@) 80 زخم تیغ حکم را چه مصطفا چه بوالحکم %~% ذوالفقار عشق را چه مرتضا چه ذوالخمار(@)(@@) 81 هر چه دشوارست بر تو هم ز باد و بود تست %~% ورنه عمر آسان گذارد مردم آسان گذار(@)(@@) 82 از درون جان برآمد نخوت و حقد و حسد %~% تا که از سیمرغ رستم گشت بر اسفندیار(@)(@@) 83 تا ندانی کوشش خود بخشش حق دان 
ms322	 از آنک %~% در مصاف دین ز بود خود نگشتی دلفگار(@)(@@) 84 ورنه پیش ناوک اندازان غیرت کی بود %~% دست باف عنکبوتی زنده پیلی را حصار(@)(@@) 85 چند جویی بی حیاتی صحو و سکر و انبساط %~% چند جویی بی مماتی محو و شکر و افتقار(@)(@@) 86 جز به دستوری «قال الله» یا «قال الرسول» %~% ره مرو فرمان مده حاجت مگو حجت میار(@)(@@) 87 چار گوهر چارپایه عرش و شرع مصطفاست %~% صدق و علم و شرم و مردی کار این هر چار یار(@)(@@) 88 چار یار مصطفا را مقتدا دار و بدان %~% ملک او را هست نوبت پنج نوبت زن چهار(@)(@@) 89 پاس خود خود دار زیرا در بهار تر هوا %~% پاسبانت را تره کوکست و میوه کوکنار(@)(@@) 90 از زبان جاه جویان تا نداری طمع بر %~% وز دو دست نخل بندان تا نداری چشم بار(@)(@@) 91 کی توان آمد به راه حق ز راه جلق و حلق %~% درد باید حلق سوز و حلق دوز و حق گزار(@)(@@) 92 نی از آن دردی که رخ مجروح دارد چون ترنج %~% بل از آن دردی که دلها خون کند در بر چو نار(@)(@@) 93 نه چنان دردی که با جانان نگوید دردمند %~% بل از آن دردی که ناپرسا بگوید پیش یار(@)(@@) 94 بر چنین بالا مپر گستاخ کز مقراض لا %~% جبرئیل پر بریدست اندرین ره صد هزار(@)(@@) 95 هیزم دیگی که باشد شهپر روح‌القدس %~% خانه آرایان شیطانرا در آن مطبخ چه کار(@)(@@) 96 علم و دین در دست مشتی جاه جوی مال دوست %~% چون بدست مست و دیوانه‌ست دره و ذوالفقار(@)(@@) 97 زان که مشتی ناخلف هستند در خط خلاف %~% آب روی و باد ریش آتش دل و تن خاکسار(@)(@@) 98 کز برای نام داند مرد دنیا علم دین %~% وز برای دام دارد ناک ده مشک تتار(@)(@@) 99 ای نبوده جز گمان هرگز یقینت را مدد %~% وی نبوده جز حسد هرگز یمینت را یسار 
ms323	(@)(@@) 100 شاعران را از شمار راویان مشمر که هست %~% جای عیسی آسمان و جای طوطی شاخسار(@)(@@) 101 باد رنگین‌ست شعر و خاک رنگین‌ست زر %~% تو ز عشق این و آن چون آب و آتش بیقرار(@)(@@) 102 ز آنچنین بادی و خاکی چون سنایی بر سر آی %~% تا چنو در شهرها بی‌تاج باشی شهریار(@)(@@) 103 ورنه چون دیگر خسیسان زین خران عشوه خر %~% خاک رنگین می‌ستان و باد رنگین می‌سپار(@)(@@) 104 نی که بیمار حسد را با شره در قحط سال %~% گرش عیسی خوان نهد بر وی نباشد خوشگوار(@)(@@) 105 خاطر کژ را چه شعر من چه نظم ابلهی %~% کور عینین را چه نسناس و چه نقش قندهار(@)(@@) 106 نکته و نظم سنایی نزد نادان دان چنانک %~% پیش کر بر بط سرای و نزد کور آیینه دار PageV1P0509(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 آبرویی کان شود بی علم و بی عقل آشکار %~% آتش دوزخ بود آن آبرو از هر شمار(@)(@@) 2 پیشی آن تن را رسد کز علم باشد پیش دست %~% بیشی آن سر را رسد کز عقل باشد پایدار(@)(@@) 3 وای آن علمی که از بی عقل باشد منتشر %~% وای آن زهدی که از بی علم یابد انتشار(@)(@@) 4 ای که می قدر فلک جویی و نور آفتاب %~% یک شبه بیداریی چون چرخ و چون انجم بیار(@)(@@) 5 لاف پنهانی مزن بی علم هر جا بیهده %~% علم خوان خود پیش از آن پنهان کند علم آشکار(@)(@@) 6 مایه‌ای داری چو عمر از وی مدان جز علم سود %~% قوتی داری چو عقل از وی مکن جز جهد کار(@)(@@) 7 عهده فتوای دین بی علم در گردن مگیر %~% وعده شاهی و شادی بی‌خرد در دل مدار(@)(@@) 8 آلت رامش بگیر و جای آرامش مجوی %~% پرده غفلت مپوش و تخم بی‌فضلی مکار(@)(@@) 9 لابه هر خاصه منگر بند دل بر طبع نه %~% یاوه هر عامه مشنو پند من بر جان گمار(@)(@@) 10 یادگاری ده ز بیداری 
ms324	 شب خود را مگر %~% وقت رفتن نام بهروزیت ماند یادگار(@)(@@) 11 افسر و فرق ای پسر بی‌رنج کی گردد قرین %~% سیری و خواب ای فتا با علم کی گیرد قرار(@)(@@) 12 علم خواهی مرحله علم از مژه چشمت سپر %~% فضل جویی راه شب بر بحر بیداری گذار(@)(@@) 13 ماه گردی گر بیابی آتشی از نور علم %~% بحر گردی گر بیابی در علم آبدار(@)(@@) 14 در اگر خواهی چنین رو نزد آن دریای علم %~% نور اگر خواهی چنین شو سوی آن شمع تبار(@)(@@) 15 بوالمعالی احمد بن یوسف بن احمد آنک %~% آسمان دانشست و آفتاب روزگار(@)(@@) 16 نوربخشی چون سپهر و درفشانی چون سحاب %~% حقگزاری چون زمین و مایه‌داری چون بهار(@)(@@) 17 آن گهر باری که چون بیدار شد از کتم عدم %~% ماند بی‌چونان گهر بحر عدم تا حشر خوار(@)(@@) 18 لافگاه علم و دین از نجم پر کرد انجمن %~% دامن کتم عدم زین در تهی کردش کنار(@)(@@) 19 شمع گردون نزد جودش مایه بخلست بخل %~% اوج گردون پیش قدرش مایه عارست عار(@)(@@) 20 یار او گر چشم دارد روزگار اندر علوم %~% «لن ترانی» بانگ برخیزد ز خلق انتظار(@)(@@) 21 خار با خرما بگاه طعم کس کی کرد جفت %~% لعل با خر مهره اندر عقد کس کی کرد یار(@)(@@) 22 آب جویست آنکه جوید سوی هر ناجنس راه %~% جوهر آتش ز همت بر فلک باشد سوار(@)(@@) 23 لاجرم زین داده گردون و زاده چار طبع %~% این جهان در رامش ست و آن جهان در افتخار(@)(@@) 24 پایه پاییدن جان نزد لطفش یک به دست %~% مایه بالیدن تن پیش رایش یک شرار(@)(@@) 25 ای ز تاثیر مزاجت چارگوهر بر فزون %~% یافته قدر و بلندی صفوت و لطف و وقار(@)(@@) 26 میل دانش سوی تو چون میل اجزا سوی کل %~% آب دولت سوی تو چون آب سیل از کوهسار(@)(@@) 27 آتش طبع بی اصلان ز آب روی خود بکش %~% دود بی‌علمی ز خانه 
ms325	 مغز بی علمان برآر(@)(@@) 28 لاله دعوی ز کوه که دروغان نیست کن %~% آفت فتوی ببر از مفتیان جهل بار(@)(@@) 29 جاهلان را چاره نیست از نسبت پست دروغ %~% مار مهره جوی نادان نیست دور از زهر مار(@)(@@) 30 لنگی و رهواری اندر راه دین ناید نکو %~% اسب دانش باید ار نی دور شو زین رهگذار(@)(@@) 31 فقر از آن خواهی که پاکی از بیان فقه و شرع %~% لاله‌زان جویی که دوری از میان مرغزار(@)(@@) 32 قوت شرع از فقیهان می‌شناسم نز فقیر %~% لاف بوبکر از محمد می‌شناسم نه ز غار(@)(@@) 33 یادگار مصطفا در راه دین علمست علم %~% هیچ جاهل بی تعلم فقر کی کرد اختیار(@)(@@) 34 هول و خشم یوسفی باید درین ره بدرقه %~% فقه و فضل یوسفی باید درین ره غمگسار(@)(@@) 35 ای جمال ملک و دانش سرفراز از بهر آنک %~% یوسفی اصلی و احمد خلق و حدادی تبار(@)(@@) 36 لاله و کوهی بلون حلم بابویی و رنگ %~% آتش و آبی به قدر و لطف بی دود و بخار(@)(@@) 37 کان دین را مایه‌ای همچون بدن را پنج حس %~% لشکری مر ملک عز را چون نبی را چار یار(@)(@@) 38 تربیت یاب از پدر چون آفتاب از آسمان %~% علمها گیر از پدر چون بخردان از روزگار(@)(@@) 39 ابتدا این رنجها می‌کش که در باغ شرف %~% زود یابی صد گل خوشبوی از یک نوک خار(@)(@@) 40 صد هزاران چرخ بینی زین سپس برطرف کون %~% از تبرک نعل اسبت کرده چون مه گوشوار(@)(@@) 41 عاقلان بینی به شادی بهر آن در هر مکان %~% ناقدان بینی به رنج از بهر این در هر دیار(@)(@@) 42 دور مشتی جاهل ناشسته روی اندر گذشت %~% دور دور یوسف ست ای پادشا پاینده‌دار(@)(@@) 43 همچو جانی خالی از اعراض و اشباه جهان %~% آفتاب و آسمانی بی کسوف و بی غبار(@)(@@) 44 اینهمه ز اقبال و علم اوست ورنه در جهان %~% یوسفان بی خرد بسیار 
ms326	 بینم دلفگار(@)(@@) 45 لختکی چون چرخ بیداری گزین کز بهر تو %~% منبری کرد از شرف چون شمس گردون اختیار(@)(@@) 46 لک لک ناموخته گر مار می‌گیرد چسود %~% باز علم آموخته از قدر و عز جوید شکار(@)(@@) 47 هیبت و عز و بها با رنج تن باشد قرین %~% قدرت و قدر و شرف با علم دین دارد قرار(@)(@@) 48 قاید چشم و چراغ عالمی گردد چو شمع %~% آنکه پیماید به دیده قامت شبهای تار(@)(@@) 49 یافه کم گوی ای سنایی مدح گو کز روی عقل %~% هیچ پرخوابی نجستست از طبیبان کوکنار(@)(@@) 50 او امام پند گویانست پندش می‌دهی %~% ویحک از گستاخی و ژاژ تو یارب زینهار(@)(@@) 51 لولو اوصاف او بر صدر جاهش میفشان %~% گوهر افغال او بر یاد طبعش می شمار(@)(@@) 52 دور شو زین پند دادن زان که زشت آید شدن %~% بی حساب و بی سپر با حیدر اندر کارزار(@)(@@) 53 ابلهی باشد براختن تیغ چوبین بر کسی %~% کو به کمتر کس ببخشد در زمان صد ذوالفقار(@)(@@) 54 روز تا نبود چو ماه و ماه تا نبود چو سال %~% علم تا نبود چو جهل و آب تا نبود چو نار(@)(@@) 55 یمن بادت بر یسار و یسر بادت بر یمین %~% دانشت جفت یمین و دولتت جفت یسار(@)(@@) 56 نوبهارت با امام دین مبارک باد و باد %~% این چنین تان هر زمان با عافیت سیصد بهار(@)(@@) 57 باد نهصد سال عمرت روز از نهصد زمان %~% هر زمانی روز او چون روز محشر صد هزار PageV1P0510(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای خردمند موحد پاک دین هوشیار %~% ا زامام دین حق یک حجت از من گوش دار(@)(@@) 2 آن امامی کو ز حجت بیخ بدعت را بکند %~% نخل دین در بوستان علم زو آمد به بار(@)(@@) 3 آنک در پیش صحابان فضل او گفتی رسول %~% تا قیامت داد علمش کار خلقان را قرار(@)(@@) 4 شمع جنت خواند عمر را نبی یکبار و بس %~% بوحنیفه 
ms327	 را چراغ امتان گفت او سه بار(@)(@@) 5 گفت بوبکر: ای محمد زین دو فاضلتر کدام %~% گفت: عمر آنکه دین حق بدو شد آشکار(@)(@@) 6 چون پدید آمد به کوفه بوحنیفه تاج دین %~% آنکه شد از علم او دین محمد آشکار(@)(@@) 7 گفت گردد امتم هفتاد و سه فرقت بهم %~% اهل جنت زان یکی و مرجع دیگر به نار(@)(@@) 8 بوحنیفه سرور آن قوم اهل جنت‌ست %~% ملحد اهل هوا از وی شود مقهور و خوار(@)(@@) 9 معنی سه بار گفتن بوحنیفه را چراغ %~% ماضی و مستقبل و حال از علومش در حجار(@)(@@) 10 اینک رفت و اینکه آید و آنکه بیند روی او %~% هر سه را زو روشنایی هر سه را علمش حصار(@)(@@) 11 دهریی آمد به نزدیک خلیفه ناگهان %~% بغض دینی مبغضی شوخی پلیدی نابکار(@)(@@) 12 این چه بدست از شریعت بر تنت گفت ای امیر %~% یافتستی پادشاهی خوش خور و بی غم گذار(@)(@@) 13 روزه و عقد و نکاح و دور بودن از مراد %~% حج و غزو و عمره و این امرهای بی شمار(@)(@@) 14 خویشتن رنجه چه داری چون به عالم ننگری %~% تا بدانی کین قدیمست و ندارد کردگار(@)(@@) 15 گفت رسم شرع و سنت جمله تزویر و ریاست %~% سر به سر گیتی قدیمست و ندارد کردگار(@)(@@) 16 آمدی تو بی‌خبر و ز خویش رفتی بی خبر %~% نامد از رفته یکی از ما برفته صدهزار(@)(@@) 17 هست عالم چون چراگاهی و ما چون منزلی %~% چون برفت این منزلی گیرد دگر کس مرغزار(@)(@@) 18 طبع و اخشیج هیولا را شناسیم اصل کون %~% هر کرا این منکر آید عقل او گیرد غبار(@)(@@) 19 خانه‌ای دیدم به یونان در حجر کرده به نقش %~% صورت افلاک و تاریخ بنایش بر کنار(@)(@@) 20 نسر واقع در حمل کنده که تاریخ این به دست %~% کی بگوید این به دست کس شناسد این شمار(@)(@@) 21 کو منجم کو محاسب گو بیا معلوم کن %~% ابتدا 
ms328	 پیدا کن و مر انتها را حجت آر(@)(@@) 22 آنکه گفت از گاه آدم پنج و پانصد بیش نیست %~% نسر واقع در حمل چون کرده‌اند آنجا نگار(@)(@@) 23 اینهمه زرق و فسونست و دروغ و شعبده %~% حیلت و نیرنگ داند این سخن را هوشیار(@)(@@) 24 گفت امیرالمومنین ای مرد پر دعوی بباش %~% تا بیاید آن امام راستین فخر دیار(@)(@@) 25 گر بتابی روی از او گردی هزیمت از سخن %~% بر سر دارت کنم تا از تو گیرند اعتبار(@)(@@) 26 گر ز تو نعمان هزیمت گیرد و گردد خموش %~% معمتد گردی مرا و هم تو باشی میر و مار(@)(@@) 27 چاکری را نامزد کرد او که نعمان را بخوان %~% تا کند او این جدل در پیش تخت شهریار(@)(@@) 28 رفت قاصد چون بدید آن کان علم و فضل را %~% گفت: آمد ملحدی در پیش خسرو بادسار(@)(@@) 29 می چنین گوید که زرق‌ست این مسلمانی و فن %~% خود شریعت چون ردایی کش نه پودست و نه تار(@)(@@) 30 گفت امیرالمومنین: تا حاضر آید پیش او %~% دین ایزد را و شرع مصطفا را پشت و یار(@)(@@) 31 گفت قاصد را امام دین چو بگزارم نماز %~% پیش میرالمومنین آیم ورا گو: چشم دار(@)(@@) 32 تا نماز شما نامد بوحنیفه پیش شاه %~% چیره گشته دهری آنجا شاه بد در انتظار(@)(@@) 33 هر زمان گفتی به شه آن ملحد بطال شوم: %~% می بترسد از من او زان شد نهان از اضطرار(@)(@@) 34 کیست در گیتی که یارد گفت با من زین سخن %~% کیست در عالم که او از من ندارد الحذار(@)(@@) 35 گفت: شاها می بفرما تا بیارندم به پیش %~% مطربان خوش لقای خوب روی نامدار(@)(@@) 36 آنک می‌دارند روزه گوید ار او راست مزد %~% ساغری می‌بایدم معشوق زیبا در کنار(@)(@@) 37 او چه داند روزه و طاعات عید و حج و غزو %~% عید او هر روز باشد روزه او را در چه کار(@)(@@) 38 اندرین 
ms329	 بودند ناگاهی درآمد مرد دین %~% شاد گشت از وی خلیفه دهر یک درمانده‌وار(@)(@@) 39 گفتش از خجلت که: ای نعمان چرا دیر آمدی %~% داد نعمانش جوابی پر معانی مردوار(@)(@@) 40 گفت: حالی چو شنیدم امر شه برخاستم %~% رخ نهادم سوی قصر و تخت شاه تاج‌دار(@)(@@) 41 چون رسیدم بر کران دجله کشتی رفته بود %~% بود نخلی منکر آنجا تختهایش بر قطار(@)(@@) 42 درهم آمد کشتئی شد درزهایش ناپدید %~% از سر نخل آمدش لیف و درو شد صد مرار(@)(@@) 43 حلقه‌های آهنین دیدم ز سنگ آمد برون %~% اندر آمد دو مرار و کشتئی شد پایدار(@)(@@) 44 کشتی آن گه پیش آمد من نشستم اندرو %~% آمد و بنشست آن گه بر کران جویبار(@)(@@) 45 پیشم آمد تا بدو اندر نشستم دیر شد %~% زین سبب تا خیرم افتاد ای پسر معذور دار(@)(@@) 46 گفت ملحد: شرم داری بو حنیفه زین دروغ %~% حجتی آورده ای کین کس ندارد استوار(@)(@@) 47 گفت آن گه بو حنیفه آن امام دین حق %~% مر امیرالمومنین را که: ای امیر باوقار(@)(@@) 48 خصم می‌گوید که صانع نیست عالم بد قدیم %~% این ز طبعست و هیولا نیست این را کردگار(@)(@@) 49 آن گه منکر همی گردد که مصنوعات را %~% صانعی باید مگر دیوانه است این گوش دار(@)(@@) 50 تخته‌ای را منکری کت صانعی باید قدیم %~% می نداری استوارم من روا دارم مدار(@)(@@) 51 ای سگ زندیق کافر خربط میشوم دون %~% می نبینی فوق و تحت و کوه و صحرا و بحار(@)(@@) 52 گاه ابرو گه گشاده گاه خشک و گاه نم %~% گاه برف و گاه باران گاه روشن گاه تار(@)(@@) 53 می نبینی بر فلک این خسرو سیارگان %~% ماه و انجم را ازو روشن همی دارد چو نار(@)(@@) 54 هفت کوکب بر فلک گشته مبین در زمین %~% در ده و دو برج پیدا گشته در لیل و نهار(@)(@@) 55 ماه در افزایش و نقصان و خود بر حال خویش %~% سوی 
ms330	 مصنوعات شو آن گه صنایع کن نظار(@)(@@) 56 ای سگ کافر به خود اندر نگه کن ساعتی %~% تا ببینی قدرتش مومن شوی ای دلفگار(@)(@@) 57 قدرت حق عجز تو بر رنگ مویت ظاهرست %~% می کند آزادی موی سیه کافوروار(@)(@@) 58 قطره‌ای آب آمد اندر کوزه‌ای کش سرنگون %~% صورتی زیبا پدید آورد از وی بی‌عوار(@)(@@) 59 آدمی در روشنایی صنعتش پیدا کند %~% کار صانع بر خلاف این بود اندیشه دار(@)(@@) 60 در سه تاریکی نگارد صورتی چون آدمی %~% آن گه بر وی پدید آرد خط و زلف و عذار(@)(@@) 61 نطق گویایی و بینایی و سمع آرد پدید %~% هفت چشمه در بدستی استخوان باده بار(@)(@@) 62 آب چشمت شور کرد و آب گوشت تلخ و خوار %~% آب بینی منقبض و آب دهانت نوش بار(@)(@@) 63 آب چشمت شور از آن آمد که به گنده شود %~% گر نباشد تلخ زی وی راه یابد مور و مار(@)(@@) 64 در دهانت آب خوش آمد تا بدانی طعم چیست %~% چند گویم زین دلایل کن برین بر اختصار(@)(@@) 65 صانعی باید حکیم و قادر و قایم به ذات %~% تا پدید آید ز صنع وی بتان قندهار(@)(@@) 66 طبع نادان کی پدید آرد حکیم و فیلسوف %~% عقل از تو کی پذیرد این سخن را بر مدار(@)(@@) 67 این مخالف طبعها با یکدگر چون ساختند %~% آب و آتش خاک و باد ای ملحدک حجت بیار(@)(@@) 68 آنچه می‌گوید بدیدم من به یونان خانه‌ای %~% این چه حجت باشد آنجا صورتی کردست کار(@)(@@) 69 رو بگو ایزد یکی قایم به ذات و لم یزل %~% قادر معطی و دانا خالق بر و بحار(@)(@@) 70 ما نبودیم او پدید آوردمان از چار طبع %~% محدث آمد چار طبع و چار فصل روزگار(@)(@@) 71 بگرو ای ملحد به قرآن «قل هوالله» یادگیر %~% چند باشد بر سرت از جهل و کفر و شک فسار(@)(@@) 72 چون شنید این حجت از وی دهر یک خاموش گشت 
ms331	 %~% کرد هر یک خوار او را پس بکردندش به دار(@)(@@) 73 گفت نعمان ای خلیفه بعد ازین چونین مکن %~% ملحدان را پیش خود منشان ازین پس زینهار(@)(@@) 74 ابن عم مصطفایی تیغ ازو میراث تست %~% میزن اکنون بر سر ملحد چو حیدر ذوالفقار(@)(@@) 75 هر چه فرماید ترا قرآن و اخبار رسول %~% اندر آن آویز ملحد را ز مجلس دور دار(@)(@@) 76 گفت: پذرفتم ز تو ای حجت دین خدای %~% شاد باش ای بوحنیفه ای امام بردبار(@)(@@) 77 ای سنایی شکر این دانی که نتوانی گزارد %~% دین اسلام و امام عالم و پرهیزگار(@)(@@) 78 گر سنایی مستجب گردد به آتش بی گمان %~% زین مناقب رسته گردد ای برادر گوش دار PageV1P0511(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای گردن احرار به شکر تو گرانبار %~% تحقیق ترا همره و توفیق ترا یار(@)(@@) 2 ای خواجه فرزانه علی‌بن محمد %~% وی نایب عیسا به دو صد گونه نمودار(@)(@@) 3 چندان که ترا جود و معالی‌ست به دنیا %~% نه نقطه سکون دارد و نه دایره رفتار(@)(@@) 4 ذهن تو و سنگ تو به مقدار حقیقت %~% بر سخت همه فایده روح به معیار(@)(@@) 5 مر جاه تو و علم ترا از سر معنی %~% آبا و سطقسات غلامند و پرستار(@)(@@) 6 نخرید کسی جان بهایی به زر و سیم %~% تا نامدش اسراسر علوم تو پدیدار(@)(@@) 7 برگ اجل از شاخ امل پاک فرو ریخت %~% تا شاخ علومت عمل آورد چنین بار(@)(@@) 8 شد طبع جهان معتدل از تو که نیابی %~% در شهر یکی ذات گرانجان و سبکبار(@)(@@) 9 از غایت آزادگی و فر بزرگیت %~% گشتند غلامان ستانه درت احرار(@)(@@) 10 گفتار فزونست ز هر چیز ولیکن %~% جود تو و مدح تو فزونست ز گفتار(@)(@@) 11 عقلی که ز داروت مدد یافت به تحقیق %~% در تخته تقدیر بخواند همه اسرار(@)(@@) 12 شخصی که تر از شربت تو شد جگر او %~% لب خشک نماند به همه عمر چو سوفار(@)(@@) 13 از عقل 
ms332	 تو ای ناقد صراف طبیعت %~% شد عنصر ترکیب همه خلق چو طیار(@)(@@) 14 آنکس که یکی مسهل و داروی تو خوردست %~% مانند فرشته نشود هرگز بیمار(@)(@@) 15 هر چشم که از خاک درت سرمه او بود %~% ز آوردن هر آب که آرد نشود تار(@)(@@) 16 آنها که یکی حبه ز حب تو بخوردند %~% در دام اجل هیچ نگردند گرفتار(@)(@@) 17 حذق تو چنانست که بی‌نبض و دلیلی %~% می باز نمایی غرض روح به هنجار(@)(@@) 18 گر باد بفرخار بر دشمت داروت %~% از قوت او روح پذیرد بت فرخار(@)(@@) 19 بر کار ز داروی تو شد شخص معطل %~% مانده ملک الموت ز داروی تو بیکار(@)(@@) 20 ای طبع و علوم تو شفا بخش و سخاورز %~% وی دست و زبان تو درر پاش و گهربار(@)(@@) 21 از مال تو جز خانه تو کیست تهی‌دست %~% وز دست تو جز کیسه تو کیست زیان‌کار(@)(@@) 22 آراسته‌ای از شرف و جود همیشه %~% چون شاخ ز طیار و چو افلاک ز سیار(@)(@@) 23 فعل تو چنانست که دیگر ز معاصی %~% واجب نشود بر تو یکی روز ستغفار(@)(@@) 24 چون مردمک دیده عزیزی بر ما ز آنک %~% در چشم تو سیم و زر ما هست چنین خوار(@)(@@) 25 چون نقطه نقش‌ست دل آنکه ابا تو %~% دو روی و دو سر باشد چون کاغذ پرگار(@)(@@) 26 ادیان به علی راست شد ابدان به تو زیراک %~% تو نافع مومن شدی او قامع کفار(@)(@@) 27 تو دیگری و حاسد تو دیگر از آن کو %~% خار آمده بی‌گلبن تو گلبن بی‌خار(@)(@@) 28 کی گردد مه مردم بد اصل به دعوی %~% کی گردد نو پیرهن کهنه به آهار(@)(@@) 29 یک شهر طبیبند ولی از سر دعوی %~% کو چون تو یکی خواجه داننده هشیار(@)(@@) 30 عالم همه پر موسی و چوبست ولیکن %~% یک موسی از آن کو که ز چوبی بکند مار(@)(@@) 31 کار چو تو کس نیست شدن نزد هر ابله %~% تا 
