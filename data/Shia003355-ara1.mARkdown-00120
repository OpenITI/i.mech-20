ms117	 الردة والدار.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب حرب الأوس والخزرج.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب صفين.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب وفاة النبي عليه السلام.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب أمر الحبشة والفيل.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المناكح.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب السقيفة وبيعة أبى بكر.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب ذكر الاذان .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب سيرة أبى بكر ووفاته.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مداعى قريش والأنصار في القطاع ووضع عمر الدواوين وتصنيف القبائل ومراتبها وأنسابها.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الترغيب في علم المغازي وغلط الرجال .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مولد الحسن والحسين ومقتل الحسين عليه السلام.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب ضرب الدنانير والدراهم.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب تاريخ الفقهاء.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الآداب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب التاريخ الكبير.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب غلط الحديث.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب السنة والجماعة وذم الهوى وترك الخروج في الفتن.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الاختلاف ويحتوي على الاختلاف، أهل المدينة والكوفة في الشفعة والصدقة (والهبة) والعمرى والرقبى والوديعة والعارية و البضاعة والمضاربة والغصب والشركة والحدود والشهادات. وعلى نسق كتب الفقه ما بقى.(@)(@@)(@@)(@@) $BIO_MAN$ محمد بن سعد كاتب الواقدي(@)(@@) أبو عبد الله محمد بن سعد، من أصحاب الواقدي. روى عنه وألف كتبه من تصنيفات الواقدي. وكان ثقة مستورا عالما باخبار الصحابة والتابعين. وتوفى سنة ثلاثين ومائتين. وله من الكتب (المصنفة)، (كتاب اخبار النبي صلى الله عليه وسلم).(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب الطبقات الكبرى ويحتوي على: اخبار النبي وطبقات الصحابة من أهل المدينة.(@)(@@) طبقات أهل مكة. وبعد ذلك، طبقات الطائف. اليمن. اليمامة. البحرين. الكوفة. البصرة. الشام.(@)(@@) الجزيرة. مصر. الأندلس. واسط. المدائن. بغداد. خراسان. الري. همدان. قم. الأنبار. طبقات النساء.(@)PageV00P111(@)(@@) وهذا الكتاب الفه ابن سعد من كتب الواقدي والكلبي والهيثم بن عدي والمدائني. وله بعد ذلك، كتاب الطبقات الصغير.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الحيل).(@)(@@)~:section: (ومن أصحاب الواقدي أيضا)(@)(@@) (إسماعيل بن مجمع. وتوفى سنة سبع وعشرين ومائتين. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار النبي و مغازيه وسراياه).(@)(@@)(@@)(@@) $BIO_MAN$ اخبار الهيثم بن عدي(@)(@@) أبو عبد الرحمن الهيثم (بن عدي) الثعلي، عالم بالشعر والاخبار والمثالب والمناقب والمآثر والأنساب.(@)(@@) وكان يطعن في نسبه. وأنشد لدعبل يهجو ابن أبي دؤاد ويستطرد بهجاء الهيثم.(@)(@@) سئلت أبى وكان أبى عليما باخبار الحواضر والبوادي فقلت 
ms118	 له أهيثم من عدى فقال كأحمد بن أبي دؤاد فان يك هيثم منهم صميما فاحمد غير شك من أياد متى كانت أياد تروس قوما لقد غضب الاله على العباد وتوفى بفم الصلح عند الحسن بن سهل سنة سبع ومائتين. وله من الكتب المصنفة، كتاب المثالب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المعمرين.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب بيوتات قريش.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الدولة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب بيوتات العرب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب هبوط آدم وافتراق العرب ونزولها ومنازلها .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب نزول العرب بالسواد وخراسان.(@)(@@)(@@)(@@) $DIC_BIB$ كتابا نسب طي.(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب مديح أهل الشام).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب حلف كلب وتميم وحلف ذهل وحلف طي وأسد.(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب تاريخ العجم وبنى أمية).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المثالب الصغير.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المثالب الكبير.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مثالب ربيعة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار طي ونزولها الجبلين وحلف ذهل وثعل.(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب مداعى أهل الشام).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب النواقل .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار زياد بن أبية .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب من تزوج من الموالى في العرب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الشباب .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الجامع.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الوفود.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب أسماء بغايا قريش في الجاهلية وأسماء من ولدن.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب خطط الكوفة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب ولاة الكوفة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب النساء.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب النكد.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب فخر أهل الكوفة على (أهل) البصرة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب تاريخ الاشراف الكبير.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب تاريخ الاشراف الصغير.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب طبقات الفقهاء والمحدثين.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب (كنى) الاشراف.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب خواتيم الخلفاء.(@)(@@)(@@)(@@) $DIC_BIB$ (كتاب اشراف الكتاب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب حرس الخلفاء).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب شرط الخلفاء.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب قضاة الكوفة والبصرة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب عمال الشرط لأمراء العراق.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المواسم. (كتاب أمراء خراسان واليمن.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب تاريخ الخلفاء.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الخراج).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الصوايف.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الخوارج.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب النوادر.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب من روى عن النبي من أصحابه .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب تسمية الفقهاء والمحدثين.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب التاريخ على السنين.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب سجل الجواهر.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار الحسن (بن علي) ووفاته.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب السمير .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار الفرس.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب خطب المصرين(@)PageV00P112 مكة والمدينة .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مقطعات الاعراب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المحبر. 
ms119	(@)(@@)(@@)(@@) $DIC_BIB$ كتاب مقتل خالد بن عبد الله القسري والوليد بن يزيد (ويزيد) بن خلف بن عبد الله.(@)(@@) ومن اخذ عن الهيثم ممن له كتب مصنفه.(@)(@@)(@@)(@@) $BIO_MAN$ أبو عمر العمرى (@)(@@) واسمه حفص بن عمر وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الزناة الاشراف وذكر سباب العرب وما جرى بينها وذكر أدعياء الجاهلية.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب النساء. من خط السكري.(@)(@@)(@@)(@@) $BIO_MAN$ اخبار أبى البختري (القاضي)(@)(@@) وهو أبو البختري وهب بن وهب (بن وهب) بن كثير بن عبد الله بن زمعة بن الأسود ابن أسد بن عبد العزى بن قصي. ويقال ان جعفر بن محمد عليهما السلام كان متزوجا بأمه من أهل المدينة. وكان فقيها اخباريا ناسيا. وولاه هارون للقضاء بعسكر المهدى. ثم عزله وولاه مدينة الرسول (عليه السلام) بعد بكار بن عبد الله وجعل إليه حربها مع القضاء ثم عزل فقدم بغداد وتوفى بها. وكان ضعيفا في الحديث. وله من الكتب:(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الرايات.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب طسم وجديس.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب صفة النبي (صلى الله عليه وسلم).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب فضائل الأنصار.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الفضائل الكبير. ويحتوي على جميع الفضائل.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب نسب ولد إسماعيل بن إبراهيم (عليه السلام). ويحتوي على قطعة من الأحاديث والقصص.(@)(@@)(@@)(@@) $BIO_MAN$ اخبار المدائني(@)(@@) قال الحارث بن أبي أسامة. (قال) المدائني، أبو الحسن علي بن محمد بن عبد الله بن أبي سيف المدائني مولى (سمرة بن جندب ويقال سمرة بن حبيب بن عبد) شمس بن عبد مناف. ومولده، على ما رواه محمد بن يحيى عن الحسين ابن فهم عنه، انه قال: ولدت سنة خمس وثلاثين ومائة. ومات سنة خمس عشرة ومائتين. قرأت بخط أبى بكر بن الإخشيد، كان المدائني متكلما من غلمان معمر بن الأشعث. وقال: حفص الفرد: ومعمر وأبو شمر وأبو الحسن المدائني وأبو بكر الأصم وأبو عامر وعبد الكريم بن روح ستة كانوا غلمان معمر بن الأشعث وقد قيل و قرأته بخط ابن الكوفي، مات المدائني سنة خمس وعشرين ومائتين وله ثلاث وتسعون سنة، في منزل إسحاق بن إبراهيم الموصلي. وكان 
ms120	 منقطعا إليه. وله من الكتب على ما انا ذاكره من خط أبى الحسن بن الكوفي:(@)(@@)~:section: كتبه في اخبار النبي صلى الله عليه وسلم(@)(@@)(@@)(@@) $DIC_BIB$ كتاب أمهات النبي (صلى الله عليه وسلم).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب صفة النبي (صلى الله عليه وسلم).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار المنافقين.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب عهود النبي (صلى الله عليه وسلم).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب تسمية المنافقين ومن نزل فيه القرآن منهم ومن غيرهم.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب تسمية الذين يؤذون النبي وتسمية المستهزئين الذين جعلوا القرآن عضين.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب رسائل النبي عليه السلام .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب كتب النبي (صلى الله عليه وسلم) إلى الملوك.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب آيات النبي عليه السلام .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب أقطاع النبي (كتاب فتوح النبي عليه السلام).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب صلح النبي (صلى الله عليه وسلم).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب خطب(@)PageV00P113 النبي.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب عهود النبي (آخر).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب المغازي. وزعم أبو الحسن بن الكوفي انها عنده في ثمانية اجزاء، جلود بخط عباس اليابس . وزعم تحت هذا الفصل، وأخرى في جزئين تأليف أحمد بن الحارث الخراز.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب سرايا النبي (صلى الله عليه وسلم).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الوفود: ويحتوي على، وفود اليمن، وفود مضر، وفود ربيعه، كتاب دعاء النبي (صلى الله عليه وسلم).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب خبر الإفك.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب أزواج النبي (صلى الله عليه وسلم).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب السرايا.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب عمال النبي على الصدقات.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب ما نهى عنه النبي (صلى الله عليه وسلم).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب حجة أبى بكر (الصديق رضي الله عنه).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب خطب النبي (صلى الله عليه وسلم) (كتاب اخبار النبي).(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الخاتم والرسل.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب من كتب له النبي (صلى الله عليه وسلم) كتابا وأمانا.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب أموال النبي وكتابه ومن كان ترد عليه الصدقة من قريش العرب.(@)(@@)~:section: اخبار قريش(@)(@@)(@@)(@@) $DIC_BIB$ كتاب نسب قريش واخبارها.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب العباس بن عبد المطلب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب اخبار أبي طالب وولده.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب خطب علي عليه السلام .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب عبد الله بن العباس.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب علي بن عبد الله بن عباس.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب 