ms381	 لواذا} أي يخرجون من المسجد في الخطبة من غير استئذان خفية مستترين بشيء وقد للتحقيق {فليحذر الذين يخالفون عن أمره} أي الله ورسوله {أن تصيبهم فتنة} بلاء {أو يصيبهم عذاب أليم} في الآخرة(@)(@@) PageV01P469(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P470(@)(@@) {ألا إن لله ما في السماوات والأرض} ملكا وخلقا وعبيدا {قد يعلم ما أنتم} أيها المكلفون {عليه} من الإيمان والنفاق {و} يعلم {يوم يرجعون إليه} فيه التفات عن الخطاب أي متى يكون {فينبئهم} فيه {بما عملوا} من الخير والشر {والله بكل شيء} من أعمالهم وغيرها {عليم} = 25 سورة(@)(@@)(@@)(@@) | الفرقان(@)(@@) مكية إلا الآيات 68 و 69 و 7 فمدنية وآياتها 77 نزلت بعد يس بسم الله الرحمن الرحيم(@)(@@) PageV01P470(@)(@@) {تبارك} تعالى {الذي نزل(@)(@@)(@@)(@@) | الفرقان} (@)(@@) القرآن لأنه فرق بين الحق والباطل {على عبده} محمد {ليكون للعالمين} الإنس والجن دون الملائكة {نذيرا} مخوفا من عذاب الله(@)(@@) PageV01P470(@)(@@) {الذي له ملك السماوات والأرض ولم يتخذ ولدا ولم يكن له شريك في الملك وخلق كل شيء} من شأنه أن يخلق {فقدره تقديرا} سواه تسوية(@)(@@) PageV01P470(@)(@@) {واتخذوا} أي الكفار {من دونه} أي الله أي غيره {آلهة} هي الأصنام {لا يخلقون شيئا وهم يخلقون ولا يملكون لأنفسهم ضرا} أي دفعه {ولا نفعا} أي جره {ولا يملكون موتا ولا حياة} أي إماتة لأحد وإحياء لأحد {ولا نشورا} أي بعثا للأموات(@)(@@) PageV01P470(@)(@@) {وقال الذين كفروا إن هذا} أي ما القرآن {إلا إفك} كذب {افتراه} محمد {وأعانه عليه قوم آخرون} وهم من أهل الكتاب قال تعالى {فقد جاؤوا ظلما وزورا} كفرا وكذبا أي بهما(@)(@@) PageV01P470(@)(@@) {وقالوا} أيضا هو {أساطير الأولين} أكاذيبهم جمع أسطورة بالضم {اكتتبها} انتسخها من ذلك القوم بغيره {فهي تملى} تقرأ {عليه} ليحفظها {بكرة وأصيلا} غدوة وعشيا قال تعالى ردا عليهم(@)(@@) PageV01P470(@)(@@) {قل أنزله الذي يعلم السر} الغيب {في السماوات والأرض إنه كان غفورا} للمؤمنين {رحيما} بهم(@)(@@) PageV01P471(@)(@@) {وقالوا مال هذا الرسول يأكل الطعام ويمشي في الأسواق لولا} هلا {أنزل إليه ملك فيكون معه نذيرا} يصدقه(@)(@@) PageV01P471(@)(@@) {أو يلقى إليه كنز} من السماء ينفقه ولا يحتاج إلى المشي في الأسواق لطلب المعاش 
ms382	 {أو تكون له جنة} بستان {يأكل منها} أي من ثمارها فيكتفي بها وفي قراءة نأكل بالنون أي نحن فيكون له مزية علينا بها {وقال الظالمون} أي الكافرون للمؤمنين {إن} ما {تتبعون إلا رجلا مسحورا} مخدوعا مغلوبا على عقله قال تعالى(@)(@@) PageV01P471(@)(@@) {انظر كيف ضربوا لك الأمثال} بالمسحور والمحتاج إلى ما ينفقه وإلى ملك يقوم معه بالأمر {فضلوا} بذلك عن الهدى {فلا يستطيعون سبيلا} طريقا إليه(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P471(@)(@@) {تبارك} تكاثر خير {الذي إن شاء جعل لك خيرا من ذلك} الذي قالوه من الكنز والبستان {جنات تجري من تحتها الأنهار} أي في الدنيا لأنه شاء أن يعطيه إياها في الآخرة {ويجعل} بالجزم {لك قصورا} أيضا وفي قراءة بالرفع استئنافا(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P471(@)(@@) {بل كذبوا بالساعة} القيامة {وأعتدنا لمن كذب بالساعة سعيرا} نارا مسعرة أي مشتدة(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P471(@)(@@) {إذا رأتهم من مكان بعيد سمعوا لها تغيظا} غليانا كالغضبان إذا غلى صدره من الغضب {وزفيرا} صوتا شديدا أو سماع التغيظ رؤيته وعلمه(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P471(@)(@@) {وإذا ألقوا منها مكانا ضيقا} بالتشديد والتخفيف بأن يضيق عليهم ومنها حال من مكانا لأنه في الأصل صفة له {مقرنين} مصفدين قد قرنت أي جمعت أيديهم إلى أعناقهم في الأغلال والتشديد للتكثير {دعوا هنالك ثبورا} هلاكا فيقال لهم(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P471(@)(@@) {لا تدعوا اليوم ثبورا واحدا وادعوا ثبورا كثيرا} كعذابكم(@)(@@) PageV01P471(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P472(@)(@@) {قل أذلك} المذكور من الوعيد وصفة النار {خير أم جنة الخلد التي وعد} ها {المتقون كانت لهم} في علمه تعالى {جزاء} ثوابا {ومصيرا} مرجعا(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P472(@)(@@) {لهم فيها ما يشاءون خالدين} حال لازمة {كان} وعدهم ما ذكر {على ربك وعدا مسئولا} يسأله من وعد به {ربنا وآتنا ما وعدتنا على رسلك} أو تسأله لهم الملائكة {ربنا وأدخلهم جنات عدن التي وعدتهم}(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P472(@)(@@) {ويوم نحشرهم} بالنون والتحتانية {وما يعبدون من دون الله} أي غيره من الملائكة وعيسى وعزير والجن {فيقول} تعالى بالتحتانية والنون للمعبودين إثباتا للحجة على العابدين {أأنتم بتحقيق الهمزتين وإبدال الثانية ألفا وتسهيلها وإدخال ألف بين المسهلة والأخرى وتركه {أضللتم عبادي هؤلاء} أوقعتموهم في الضلال بأمركم إياهم 
ms383	 بعبادتكم {أم هم ضلوا السبيل} طريق الحق بأنفسهم(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P472(@)(@@) {قالوا سبحانك} تنزيها لك عما لا يليق بك {ما كان ينبغي} يستقيم {لنا أن نتخذ من دونك} أي غيرك {من أولياء} مفعول أول ومن زائدة لتأكيد النفي وما قبله الثاني فكيف نأمر بعبادتنا {ولكن متعتهم وآباءهم} من قبلهم بإطالة العمر وسعة الرزق {حتى نسوا الذكر} تركوا الموعظة والإيمان بالقرآن {وكانوا قوما بورا} هلكي قال تعالى(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P472(@)(@@) {فقد كذبوكم} أي كذب المعبودون العابدين {بما تقولون} بالفوقانية أنهم آلهة {فما يستطيعون} بالتحتانية والفوقانية أي لا هم ولا أنتم {صرفا} دفعا للعذاب عنكم {ولا نصرا} منعا لكم منه {ومن يظلم} يشرك {منكم نذقه عذابا كبيرا} شديدا في الآخرة(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P472(@)(@@) {وما أرسلنا قبلك من المرسلين إلا إنهم ليأكلون الطعام ويمشون في الأسواق} فأنت مثلهم في ذلك وقد قيل لهم مثل ما قيل لك {وجعلنا بعضكم لبعض فتنة} بلية ابتلي الغني بالفقير والصحيح بالمريض والشريف بالوضيع يقول الثاني في كل ما لي لا أكون كالأول في كل {أتصبرون} على ما تسمعون ممن ابتليتم بهم استفهام بمعنى الأمر أي اصبروا {وكان ربك بصيرا} بمن يصبر وبمن يجزع(@)(@@) PageV01P472(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P473(@)(@@) {وقال الذين لا يرجون لقاءنا} لا يخافون البعث {لولا} هلا {أنزل علينا الملائكة} فكانوا رسلا إلينا {أو نرى ربنا} فنخبر بأن محمدا رسوله قال تعالى {لقد استكبروا} تكبروا {في} شأن {أنفسهم وعتوا} طغوا {عتوا كبيرا} بطلبهم رؤية الله تعالى في الدنيا وعتوا بالواو على أصله بخلاف عتي بالإبدال في مريم(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P473(@)(@@) {يوم يرون الملائكة} في جملة الخلائق هو يوم القيامة ونصبه باذكر مقدرا {لا بشرى يومئذ للمجرمين} أي الكافرين بخلاف المؤمنين فلهم البشرى بالجنة {ويقولون حجرا محجورا} على عادتهم في الدنيا إذا نزلت بهم شدة أي عوذا معاذا يستعيذون من الملائكة قال تعالى(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P473(@)(@@) {وقدمنا} عمدنا {إلى ما عملوا من عمل} من الخير كصدقة وصلة رحم وقرى ضيف وإغاثة ملهوف في الدنيا {فجعلناه هباء منثورا} هو ما يرى في الكوى التي عليها الشمس كالغبار المفرق أي مثله في عدم 
ms384	 النفع به إذ لا ثواب فيه لعدم شرطه ويجازون عليه في الدنيا(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P473(@)(@@) {أصحاب الجنة يومئذ} يوم القيامة {خير مستقرا} من الكافرين في الدنيا {وأحسن مقيلا} منهم أي موضع قائلة فيها وهي الاستراحة نصف النهار في الحر وأخذ من ذلك انقضاء الحساب في نصف نهار كما ورد في حديث(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P473(@)(@@) {ويوم تشقق السماء} أي كل سماء {بالغمام} أي معه وهو غيم أبيض {ونزل الملائكة} من كل سماء {تنزيلا} هو يوم القيامة ونصبه باذكر مقدرا وفي قراءة بتشديد شين تشقق بإدغام التاء الثانية في الأصل فيها وفي أخرى ننزل بنونين الثانية ساكنة وضم اللام ونصب الملائكة(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P473(@)(@@) {الملك يومئذ الحق للرحمن} لا يشركه فيه أحد {وكان} اليوم {يوما على الكافرين عسيرا} بخلاف المؤمنين(@)(@@) PageV01P473(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P474(@)(@@) {ويوم يعض الظالم} المشرك عقبة بن أبي معيط كان نطق بالشهادتين ثم رجع إرضاء لأبي بن خلف {على يديه} ندما وتحسرا في يوم القيامة {يقول يا} للتنبيه {ليتني اتخذت مع الرسول} محمد {سبيلا} طريقا إلى الهدى(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P474(@)(@@) {يا ويلتى} ألفه عوض عن ياء الإضافة أي ويلتى ومعناه هلكتي {ليتني لم أتخذ فلانا} أي أبيا {خليلا}(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P474(@)(@@) {لقد أضلني عن الذكر} أي القرآن {بعد إذ جاءني} بأن ردني عن الإيمان به قال تعالى {وكان الشيطان للإنسان} الكافر {خذولا} بأن يتركه ويتبرأ منه عند البلاء(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P474(@)(@@) {وقال الرسول} محمد {يا رب إن قومي} قريشا {اتخذوا هذا القرآن مهجورا} متروكا قال تعالى(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P474(@)(@@) {وكذلك} كما جعلنا لك عدوا من مشركي قومك {جعلنا لكل نبي} قبلك {عدوا من المجرمين} المشركين فاصبر كما صبروا {وكفى بربك هاديا} لك {ونصيرا} ناصرا لك على أعدائك(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P474(@)(@@) {وقال الذين كفروا لولا} هلا {نزل عليه القرآن جملة واحدة} كالتوراة والإنجيل والزبور قال تعالى نزلناه {كذلك} متفرقا {لنثبت به فؤادك} نقوي قلبك {ورتلناه ترتيلا} أي أتينا به شيئا بعد شيء بتمهل وتؤدة لتيسير فهمه وحفظه(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P474(@)(@@) {ولا يأتونك بمثل} في إبطال أمرك {إلا جئناك بالحق} الدافع له {وأحسن تفسيرا} بيانا(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P474(@)(@@) هم {الذين يحشرون على وجوههم} أي 
ms385	 يساقون {إلى جهنم أولئك شر مكانا} هو جهنم {وأضل سبيلا} أخطأ طريقا من غيرهم وهو كفرهم(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P474(@)(@@) {ولقد آتينا موسى الكتاب} التوراة {وجعلنا معه أخاه هارون نذيرا} معينا(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P474(@)(@@) {فقلنا اذهبا إلى القوم الذين كذبوا بآياتنا} أي القبط فرعون وقومه فذهبا إليهم بالرسالة فكذبوهما {فدمرناهم تدميرا} أهلكناهم إهلاكا(@)(@@) PageV01P474(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P475(@)(@@) {و} اذكر {قوم نوح لما كذبوا الرسل} بتكذيبهم نوحا لطول لبثه فيهم فكأنه رسل أو لأن تكذيبه تكذيب لباقي الرسل لاشتراكهم في المجيء بالتوحيد {أغرقناهم} جواب لما {وجعلناهم للناس} بعدهم {آية} عبرة {وأعتدنا} في الآخرة {للظالمين} الكافرين {عذابا أليما} مؤلما سوى ما يحل بهم في الدنيا(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P475(@)(@@) {و} اذكر {عادا} قوم هود {وثمود} قوم صالح {وأصحاب الرس} اسم بئر ونبيهم قيل شعيب وقيل غيره كانوا قعودا حولها فانهارت بهم وبمنازلهم {وقرونا} أقواما {بين ذلك كثيرا} أي بين عاد وأصحاب الرس(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P475(@)(@@) {وكلا ضربنا له الأمثال} في إقامة الحجة عليهم فلا نهلكهم إلا بعد الإنذار {وكلا تبرنا تتبيرا} أهلكنا إهلاكا بتكذيبهم أنبياءهم(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P475(@)(@@) {ولقد أتوا} أي مر كفار مكة {على القرية التي أمطرت مطر السوء} مصدر ساء أي بالحجارة وهي عظمى قرى قوم لوط فأهلك الله أهلها لفعلهم الفاحشة {أفلم يكونوا يرونها} في سفرهم إلى الشام فيعتبرون والاستفهام للتقرير {بل كانوا لا يرجون} يخافون {نشورا} بعثا فلا يؤمنون(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P475(@)(@@) {وإذا رأوك إن} ما {يتخذونك إلا هزؤا} مهزوءا به يقولون {أهذا الذي بعث الله رسولا} في دعواه محتقرين له عن الرسالة(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P475(@)(@@) {إن} مخففة من الثقيلة واسمها محذوف أي إنه {كاد ليضلنا} يصرفنا {عن آلهتنا لولا أن صبرنا عليها} لصرفنا عنها قال تعالى {وسوف يعلمون حين يرون العذاب} عيانا في الآخرة {من أضل سبيلا} أخطأ طريقا أهم أم المؤمنون(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P475(@)(@@) {أرأيت} أخبرني {من اتخذ إلهه هواه} أي مهويه قدم المفعول الثاني لأنه أهم وجملة من اتخذ مفعول أول لرأيت والثاني {أفأنت تكون عليه وكيلا} حافظا تحفظه عن اتباع هواه لا(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P475(@)(@@) {أم تحسب أن أكثرهم يسمعون} سماع تفهم {أو يعقلون} ما تقول لهم 
ms386	 {إن} ما {هم إلا كالأنعام بل هم أضل سبيلا} أخطأ طريقا منها لأنها تنقاد لمن يتعهدها وهم لا يطيعون مولاهم المنعم عليهم(@)(@@) PageV01P475(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P476(@)(@@) {ألم تر} تنظر {إلى} فعل {ربك كيف مد الظل} من وقت الإسفار إلى وقت طلوع الشمس {ولو شاء} ربك {لجعله ساكنا} مقيما لا يزول بطلوع الشمس {ثم جعلنا الشمس عليه} أي الظل {دليلا} فلولا الشمس ما عرف الظل(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P476(@)(@@) {ثم قبضناه} أي الظل الممدود {إلينا قبضا يسيرا} خفيا بطلوع الشمس(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P476(@)(@@) {وهو الذي جعل لكم الليل لباسا} ساترا كاللباس {والنوم سباتا} راحة للأبدان بقطع الأعمال {وجعل النهار نشورا} منشورا فيه لابتغاء الرزق وغيره(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P476(@)(@@) {وهو الذي أرسل الرياح} وفي قراءة الريح {نشورا بين يدي رحمته} متفرقة قدام المطر وفي قراءة بسكون الشين تخفيفا وفي أخرى بسكونها ونون مفتوحة مصدر وفي أخرى بسكونها وضم الموحدة بدل النون أي مبشرات ومفرد الأولى نشور كرسول والأخيرة بشير {وأنزلنا من السماء ماء طهورا} مطهرا(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P476(@)(@@) {لنحيي به بلدة ميتا} بالتخفيف يستوي فيه المذكر والمؤنث ذكره باعتبار المكان {ونسقيه} أي الماء {مما خلقنا أنعاما} إبلا وبقرا وغنما {وأناسي كثيرا} جمع إنسان وأصله أناسين فأبدلت النون ياء وأدغمت فيها الياء أو جمع إنسي(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P476(@)(@@) {ولقد صرفناه} أي الماء {بينهم ليذكروا} أصله يتذكروا أدغمت التاء في الذال وفي قراءة ليذكروا بسكون الذال وضم الكاف أي نعمة الله به {فأبى أكثر الناس إلا كفورا} جحودا للنعمة حيث قالوا مطرنا بنوء كذا(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P476(@)(@@) {ولو شئنا لبعثنا في كل قرية نذيرا} يخوف أهلها ولكن بعثناك إلى أهل القرى كلها نذيرا ليعظم أجرك(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P476(@)(@@) {فلا تطع الكافرين} في هواهم {وجاهدهم به} أي القرآن {جهادا كبيرا(@)(@@) PageV01P476(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P477(@)(@@) {وهو الذي مرج البحرين} أرسلهما متجاورين {هذا عذب فرات} شديد العذوبة {وهذا ملح أجاج} شديد الملوحة {وجعل بينهما برزخا} حاجزا لا يختلط أحدهما بالآخر {وحجرا محجورا} سترا ممنوعا به اختلاطهما(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P477(@)(@@) {وهو الذي خلق من الماء بشرا} من المني إنسانا {فجعله نسبا} ذا نسب {وصهرا} ذا صهر بأن يتزوج ذكرا كان أو 
ms387	 أنثى طلبا للتناسل {وكان ربك قديرا} قادرا على ما يشاء(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P477(@)(@@) {ويعبدون} أي الكفار {من دون الله ما لا ينفعهم} بعبادته {ولا يضرهم} بتركها وهو الأصنام {وكان الكافر على ربه ظهيرا} معينا للشيطان بطاعته(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P477(@)(@@) {وما أرسلناك إلا مبشرا} بالجنة {ونذيرا} مخوفا من النار(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P477(@)(@@) {قل ما أسألكم عليه} أي على تبليغ ما أرسلت به {من أجر إلا} لكن {من شاء أن يتخذ إلى ربه سبيلا} طريقا بإنفاق ماله في مرضاته تعالى فلا أمنعه من ذلك(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P477(@)(@@) {وتوكل على الحي الذي لا يموت وسبح} متلبسا {بحمده} أي قل سبحان الله والحمد لله {وكفى به بذنوب عباده خبيرا} عالما تعلق به بذنوب(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P477(@)(@@) هو {الذي خلق السماوات والأرض وما بينهما في ستة أيام} من أيام الدنيا أي في قدرها لأنه لم يكن ثم شمس ولو شاء لخلقهن في لمحة والعدول عنه لتعليم خلقه التثبت {ثم استوى على العرش} هو في اللغة سرير الملك {الرحمن} بدل من ضمير استوى أي استواء يليق به {فاسأل} أيها الإنسان {به} بالرحمن {خبيرا} يخبرك بصفاته(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P477(@)(@@) {وإذا قيل لهم} لكفار مكة {اسجدوا للرحمن قالوا وما الرحمن أنسجد لما تأمرنا} بالفوقانية والتحتانية والآمر محمد ولا نعرفه لا {وزادهم} هذا القول لهم {نفورا} عن الإيمان قال تعالى(@)(@@) PageV01P477(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P478(@)(@@) {تبارك} تعاظم {الذي جعل في السماء بروجا} اثني عشر الحمل والثور والجوزاء والسرطان والأسد والسنبلة والميزان والعقرب والقوس والجدي والدلو والحوت وهي منازل الكواكب السبعة السيارة المريخ وله الحمل والعقرب والزهرة ولها الثور والميزان وعطارد وله الجوزاء والسنبلة والقمر وله السرطان والشمس ولها الأسد والمشترى وله القوس والحوت وزحل وله الجدي والدلو {وجعل فيها} أيضا {سراجا} هو الشمس {وقمرا منيرا} وفي قراءة سرجا بالجمع أي نيرات وخص القمر منها بالذكر لنوع فضيلة(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P478(@)(@@) {وهو الذي جعل الليل والنهار خلفة} أي يخلف كل منهما الآخر {لمن أراد أن يذكر} بالتشديد والتخفيف كما تقدم ما فاته في أحدهما من خير فيفعله في الآخر {أو أراد شكورا} أي شكرا لنعمة ربه عليه فيهما 
ms388	(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P478(@)(@@) {وعباد الرحمن} مبتدأ وما بعده صفات له إلى أولئك يجزون غير المعترض فيه {الذين يمشون على الأرض هونا} أي بسكينة وتواضع {وإذا خاطبهم الجاهلون} بما يكرهونه {قالوا سلاما} أي قولا يسلمون فيه من الإثم(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P478(@)(@@) {والذين يبيتون لربهم سجدا} جمع ساجد {وقياما} بمعنى قائمين يصلون بالليل(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P478(@)(@@) {والذين يقولون ربنا اصرف عنا عذاب جهنم إن عذابها كان غراما} أي لازما(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P478(@)(@@) {إنها ساءت} بئست {مستقرا ومقاما} هي أي موضع استقرار وإقامة(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P478(@)(@@) {والذين إذا أنفقوا} على عيالهم {لم يسرفوا ولم يقتروا} بفتح أوله وضمه أي يضيقوا {وكان} إنفاقهم {بين ذلك} الإسراف والإقتار {قواما} وسطا(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P478(@)(@@) {والذين لا يدعون مع الله إلها آخر ولا يقتلون النفس التي حرم الله} قتلها {إلا بالحق ولا يزنون ومن يفعل ذلك} أي واحدا من الثلاثة {يلق أثاما} أي عقوبة(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P478(@)(@@) {يضاعف} وفي قراءة يضعف بالتشديد {له العذاب يوم القيامة ويخلد فيه} بجزم الفعلين بدلا وبرفعهما استئنافا {مهانا} حال(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P478(@)(@@) {إلا من تاب وآمن وعمل عملا صالحا} منهم {فأولئك يبدل الله سيئاتهم} المذكورة {حسنات} في الآخرة {وكان الله غفورا رحيما} أي لم يزل متصفا بذلك(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P478(@)(@@) {ومن تاب} من ذنوبه غير من ذكر {وعمل صالحا فإنه يتوب إلى الله متابا} أي يرجع إليه رجوعا فيجازيه خيرا(@)(@@) PageV01P478(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P479(@)(@@) {والذين لا يشهدون الزور} أي الكذب والباطل {وإذا مروا باللغو} من الكلام القبيح وغيره {مروا كراما} معرضين عنه(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P479(@)(@@) {والذين إذا ذكروا} وعظوا {بآيات ربهم} أي القرآن {لم يخروا} يسقطوا {عليها صما وعميانا} بل خروا سامعين ناظرين منتفعين(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P479(@)(@@) {والذين يقولون ربنا هب لنا من أزواجنا وذرياتنا} بالجمع والإفراد {قرة أعين} لنا بأن نراهم مطيعين لك {واجعلنا للمتقين إماما} في الخير(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P479(@)(@@) {أولئك يجزون الغرفة} الدرجة العليا في الجنة {بما صبروا} على طاعة الله {ويلقون} بالتشديد والتخفيف مع فتح الياء {فيها} في الغرفة {تحية وسلاما} من الملائكة(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P479(@)(@@) {خالدين فيها حسنت مستقرا ومقاما} موضع إقامة لهم وأولئك وما بعده خبر عباد الرحمن المبتدإ(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P479(@)(@@) {قل} يا محمد لأهل 
ms389	 مكة {ما} نافية {يعبأ} يكترث {بكم ربي لولا دعاؤكم} إياه في الشدائد فيكشفها {فقد} أي فكيف يعبأ بكم وقد {كذبتم} الرسول والقرآن {فسوف يكون} العذاب {لزاما} ملازما لكم في الآخرة بعد ما يحل بكم في الدنيا فقتل منهم يوم بدر سبعون وجواب لولا دل عليه ما قبلها = 26 سورة(@)(@@)(@@)(@@) | الشعراء(@)(@@) مكية إلا آية 197 و 224 إلى آخر السورة فمدنية وآياتها 227 آية نزلت بعد الواقعة بسم الله الرحمن الرحيم(@)(@@) PageV01P479(@)(@@) {طسم} الله أعلم بمراده بذلك(@)(@@) PageV01P479(@)(@@) {تلك} أي هذه الآيات {آيات الكتاب} القرآن والإضافة بمعنى من {المبين} المظهر الحق من الباطل(@)(@@) PageV01P479(@)(@@) {لعلك} يا محمد {باخع نفسك} قاتلها غما من أجل {ألا يكونوا} أي أهل مكة {مؤمنين} ولعل هنا للإشفاق أي أشفق عليها بتخفيف هذا الغم(@)(@@) PageV01P479(@)(@@) {إن نشأ ننزل عليهم من السماء آية فظلت} بمعنى المضارع أي تظل أي تدوم {أعناقهم لها خاضعين} فيؤمنون ولما وصفت الأعناق بالخضوع الذي هو لأربابها جمعت الصفة منه جمع العقلاء(@)(@@) PageV01P480(@)(@@) {وما يأتيهم من ذكر} قرآن {من الرحمن محدث} صفة كاشفة {إلا كانوا عنه معرضين}(@)(@@) PageV01P480(@)(@@) {فقد كذبوا} به {فسيأتيهم أنباء} عواقب {ما كانوا به يستهزءون}(@)(@@) PageV01P480(@)(@@) {أولم يروا} ينظروا {إلى الأرض كم أنبتنا فيها} أي كثيرا {من كل زوج كريم} نوع حسن(@)(@@) PageV01P480(@)(@@) {إن في ذلك لآية} دلالة على كمال قدرته تعالى {وما كان أكثرهم مؤمنين} في علم الله وكان قال سيبويه زائدة(@)(@@) PageV01P480(@)(@@) {وإن ربك لهو العزيز} ذو العزة ينتقم من الكافرين {الرحيم} يرحم المؤمنين(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P480(@)(@@) {و} اذكر يا محمد لقومك {إذ نادى ربك موسى} ليلة رأى النار والشجرة {أن} أي بأن {ائت القوم الظالمين} رسولا(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P480(@)(@@) {قوم فرعون} معه ظلموا أنفسهم بالكفر بالله وبني إسرائيل باستعبادهم {ألا} الهمزة للاستفهام الإنكاري {يتقون} الله بطاعته فيوحدونه(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P480(@)(@@) {قال} موسى {رب إني أخاف أن يكذبون}(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P480(@)(@@) {ويضيق صدري} من تكذيبهم لي {ولا ينطلق لساني} بأداء الرسالة للعقدة التي فيه {فأرسل إلى} أخي {هارون} معي(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P480(@)(@@) {ولهم علي ذنب} بقتل القبطي منهم {فأخاف أن يقتلون} به(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P480(@)(@@) {قال} تعالى {كلا} لا يقتلونك 
ms390	 {فاذهبا} أي أنت وأخوك ففيه تغليب الحاضر على الغائب {بآياتنا إنا معكم مستمعون} ما تقولون وما يقال لكم أجريا مجرى الجماعة(@)(@@) PageV01P480(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P481(@)(@@) {فأتيا فرعون فقولا إنا} كلا منا {رسول رب العالمين} إليك(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P481(@)(@@) {أن} أي بأن {أرسل معنا} إلى الشام {بني إسرائيل} فأتياه فقالا له ما ذكر(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P481(@)(@@) {قال} فرعون لموسى {ألم نربك فينا} في منازلنا {وليدا} صغيرا قريبا من الولادة بعد فطامه {ولبثت فينا من عمرك سنين} ثلاثين سنة يلبس من ملابس فرعون ويركب من مراكبه وكان يسمى ابنه(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P481(@)(@@) {وفعلت فعلتك التي فعلت} هي قتله القبطي {وأنت من الكافرين} الجاحدين لنعمتي عليك بالتربية وعدم الاستعباد(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P481(@)(@@) {قال} موسى {فعلتها إذا} أي حينئذ {وأنا من الضالين} عما آتاني الله بعدها من العلم والرسالة(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P481(@)(@@) {ففررت منكم لما خفتكم فوهب لي ربي حكما} علما {وجعلني من المرسلين}(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P481(@)(@@) {وتلك نعمة تمنها علي} أصله تمن بها علي {أن عبدت بني إسرائيل} بيان لتلك أي اتخذتهم عبيدا ولم تستعبدني لا نعمة لك بذلك لظلمك باستعبادهم وقدر بعضهم أول الكلام همزة استفهام للإنكار(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P481(@)(@@) {قال فرعون} لموسى {وما رب العالمين} الذي قلت إنك رسوله أي أي شيء هو ولما لم يكن سبيل للخلق إلى معرفة حقيقته تعالى وإنما يعرفونه بصفاته أجابه موسى عليه الصلاة والسلام ببعضها(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P481(@)(@@) {قال رب السماوات والأرض وما بينهما} أي خالق ذلك {إن كنتم موقنين} بأنه تعالى خالقه فآمنوا به وحده(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P481(@)(@@) {قال} فرعون {لمن حوله} من أشراف قومه {ألا تستمعون} جوابه الذي لم يطابق السؤال(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P481(@)(@@) {قال} موسى {ربكم ورب آبائكم الأولين} وهذا وإن كان داخلا فيما قبله يغيظ فرعون ولذلك(@)(@@) PageV01P481(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P482(@)(@@) {قال إن رسولكم الذي أرسل إليكم لمجنون}(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P482(@)(@@) {قال} موسى {رب المشرق والمغرب وما بينهما إن كنتم تعقلون} أنه كذلك فآمنوا به وحده(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P482(@)(@@) {قال} فرعون لموسى {لئن اتخذت إلها غيري لأجعلنك من المسجونين} كان سجنه شديدا يحبس الشخص في مكان تحت الأرض وحده لا يبصر ولا يسمع فيه أحدا(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P482(@)(@@) {قال} له موسى {أولو} أي 
ms391	 أتفعل ذلك ولو {جئتك بشيء مبين} برهان بين على رسالتي(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P482(@)(@@) {قال} فرعون له {فأت به إن كنت من الصادقين} فيه(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P482(@)(@@) {فألقى عصاه فإذا هي ثعبان مبين} حية عظيمة(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P482(@)(@@) {ونزع يده} أخرجها من جيبه {فإذا هي بيضاء} ذات شعاع {للناظرين} خلاف ما كانت عليه من الأدمة(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P482(@)(@@) {قال} فرعون {للملإ حوله إن هذا لساحر عليم} فائق في علم السحر(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P482(@)(@@) {يريد أن يخرجكم من أرضكم بسحره فماذا تأمرون}(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P482(@)(@@) {قالوا أرجه وأخاه} أخر أمرهما {وابعث في المدائن حاشرين} جامعين(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P482(@)(@@) {يأتوك بكل سحار عليم} يفضل موسى في علم السحر(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P482(@)(@@) {فجمع السحرة لميقات يوم معلوم} وهو وقت الضحى من يوم الزينة(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P482(@)(@@) {وقيل للناس هل أنتم مجتمعون}(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P482(@)(@@) {لعلنا نتبع السحرة إن كانوا هم الغالبين} الاستفهام للحث على الاجتماع والترجي على تقدير غلبتهم ليستمروا على دينهم فلا يتبعوا موسى(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P482(@)(@@) {فلما جاء السحرة قالوا لفرعون أئن} بتحقيق الهمزتين وتسهيل الثانية وإدخال ألف بينهما على الوجهين {لنا لأجرا إن كنا نحن الغالبين(@)(@@) PageV01P482(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P483(@)(@@) {قال نعم وإنكم إذا} أي حينئذ {لمن المقربين}(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P483(@)(@@) {قال لهم موسى} بعد ما قالوا له {إما أن تلقي وإما أن نكون نحن الملقين} {ألقوا ما أنتم ملقون} فالأمر فيه للإذن بتقديم إلقائهم إلى إظهار الحق(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P483(@)(@@) {فألقوا حبالهم وعصيهم وقالوا بعزة فرعون إنا لنحن الغالبون}(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P483(@)(@@) {فألقى موسى عصاه فإذا هي تلقف} بحذف إحدى التاءين من الأصل تبتلع {ما يأفكون} يقلبونه بتمويههم فيخيلون حبالهم وعصيهم أنها حيات تسعى(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P483(@)(@@) {فألقى السحرة ساجدين}(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P483(@)(@@) {قالوا آمنا برب العالمين}(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P483(@)(@@) {رب موسى وهارون} لعلمهم بأن ما شاهدوه من العصا لا يتأتى بالسحر(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P483(@)(@@) {قال} فرعون {أآمنتم} بتحقيق الهمزتين وإبدال الثانية ألفا {له} لموسى {قبل أن آذن} أنا {لكم إنه لكبيركم الذي علمكم السحر} فعلمكم شيئا منه وغلبكم بآخر {فلسوف تعلمون} ما ينالكم مني {لأقطعن أيديكم وأرجلكم من خلاف} أي يد كل واحد اليمنى ورجله اليسرى {ولأصلبنكم أجمعين}(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P483(@)(@@) {قالوا لا ضير} لا ضرر علينا في ذلك {إنا 
ms392	 إلى ربنا} بعد موتنا بأي وجه كان {منقلبون} راجعون في الآخرة(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P483(@)(@@) {إنا نطمع} نرجو {أن يغفر لنا ربنا خطايانا أن} أي بأن {كنا أول المؤمنين} في زماننا(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P483(@)(@@) {وأوحينا إلى موسى} بعد سنين أقامها بينهم يدعوهم بآيات الله إلى الحق فلم يزيدوا إلا عتوا {أن أسر بعبادي} بني إسرائيل وفي قراءة بكسر النون ووصل همزة أسر من سرى لغة في أسرى أي سر بهم ليلا إلى البحر {إنكم متبعون} يتبعكم فرعون وجنوده فيلجون وراءكم البحر فأنجيكم وأغرقهم(@)(@@) PageV01P483(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P484(@)(@@) {فأرسل فرعون} حين أخبر بسيرهم {في المدائن} قيل كان له ألف مدينة واثنا عشر ألف قرية {حاشرين} جامعين الجيش قائلا(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P484(@)(@@) {إن هؤلاء لشرذمة} طائفة {قليلون} قيل كانوا ستمائة ألف وسبعين ألفا ومقدمة جيشه سبعمائة ألف فقللهم بالنظر إلى كثرة جيشه(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P484(@)(@@) {وإنهم لنا لغائظون} فاعلون ما يغيظنا(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P484(@)(@@) {وإنا لجميع حذرون} مستعدون وفي قراءة حاذرون متيقظون(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P484(@)(@@) قال تعالى {فأخرجناهم} أي فرعون وقومه من مصر ليلحقوا موسى وقومه {من جنات} بساتين كانت على جانبي النيل {وعيون} أنهار جارية في الدور من النيل(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P484(@)(@@) {وكنوز} أموال ظاهرة من الذهب والفضة وسميت كنوزا لأنه لم يعط حق الله تعالى منها {ومقام كريم} مجلس حسن للأمراء والوزراء يحفه أتباعهم(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P484(@)(@@) {كذلك} أي إخراجنا كما وصفنا {وأورثناها بني إسرائيل} بعد إغراق فرعون وقومه(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P484(@)(@@) {فأتبعوهم} لحقوهم {مشرقين} وقت شروق الشمس(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P484(@)(@@) {فلما تراءى الجمعان} رأى كل منهما الآخر {قال أصحاب موسى إنا لمدركون} يدركنا جمع فرعون ولا طاقة لنا به(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P484(@)(@@) {قال} موسى {كلا} أي لن يدركونا {إن معي ربي} بنصره {سيهدين} طريق النجاة(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P484(@)(@@) قال تعالى {فأوحينا إلى موسى أن اضرب بعصاك البحر} فضربه {فانفلق} فانشق اثني عشر فرقا {فكان كل فرق كالطود العظيم} الجبل الضخم بينهما مسالك سلكوها لم يبتل منها سرج الراكب ولا لبده(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P484(@)(@@) {وأزلفنا} قربنا {ثم} هناك {الآخرين} فرعون وقومه حتى سلكوا مسالكهم(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P484(@)(@@) {وأنجينا موسى ومن معه أجمعين} بإخراجهم من البحر على هيئته المذكورة(@)(@@) PageV01P484(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P485(@)(@@) {ثم أغرقنا الآخرين} 
ms393	 فرعون وقومه بإطباق البحر عليهم لما تم دخولهم في البحر وخروج بني إسرائيل منه(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P485(@)(@@) {إن في ذلك} إغراق فرعون وقومه {لآية} عبرة لمن بعدهم {وما كان أكثرهم مؤمنين} بالله لم يؤمن منهم غير آسية امرأة فرعون وحزقيل مؤمن آل فرعون ومريم بنت ناموصي التي دلت على عظام يوسف عليه السلام(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P485(@)(@@) {وإن ربك لهو العزيز} فانتقم من الكافرين بإغراقهم {الرحيم} بالمؤمنين فأنجاهم من الغرق(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P485(@)(@@) {واتل عليهم} أي كفار مكة {نبأ} خبر {إبراهيم} ويبدل منه(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P485(@)(@@) {إذ قال لأبيه وقومه ما تعبدون}(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P485(@)(@@) {قالوا نعبد أصناما} صرحوا بالفعل ليعطفوا عليه {فنظل لها عاكفين}(@)(@@) نقيم نهارا على عبادتها زادوه في الجواب افتخارا به(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P485(@)(@@) {قال هل يسمعونكم إذ} حين {تدعون}(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P485(@)(@@) {أو ينفعونكم} إن عبدتموهم {أو يضرون} كم إن لم تعبدوهم(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P485(@)(@@) {قالوا بل وجدنا آباءنا كذلك يفعلون} أي مثل فعلنا(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P485(@)(@@) {قال أفرأيتم ما كنتم تعبدون}(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P485(@)(@@) {أنتم ؤاباؤكم الأقدمون}(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P485(@)(@@) {فإنهم عدو لي} لا أعبدهم {إلا} لكن {رب العالمين} فإني أعبده(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P485(@)(@@) {الذي خلقني فهو يهدين} إلى الدين(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P485(@)(@@) {والذي هو يطعمني ويسقين}(@)(@@)(@@)(@@) | 8 - (@)(@@) PageV01P485(@)(@@) {وإذا مرضت فهو يشفين}(@)(@@)(@@)(@@) | 8 - (@)(@@) PageV01P485(@)(@@) {والذي يميتني ثم يحيين}(@)(@@)(@@)(@@) | 8 - (@)(@@) PageV01P485(@)(@@) {والذي أطمع} أرجو {أن يغفر لي خطيئتي يوم الدين} الجزاء(@)(@@)(@@)(@@) | 8 - (@)(@@) PageV01P485(@)(@@) {رب هب لي حكما} علما {وألحقني بالصالحين} النبيين(@)(@@)(@@)(@@) | 8 - (@)(@@) PageV01P485(@)(@@) {واجعل لي لسان صدق} ثناء حسنا {في الآخرين} الذين يأتون بعدي إلى يوم القيامة(@)(@@) PageV01P485(@)(@@)(@@)(@@) | 8 - (@)(@@) PageV01P486(@)(@@) {واجعلني من ورثة جنة النعيم} ممن يعطاها(@)(@@)(@@)(@@) | 8 - (@)(@@) PageV01P486(@)(@@) {واغفر لأبي إنه كان من الضالين} بأن تتوب عليه فتغفر له وهذا قبل أن يتبين له أنه عدو لله كما ذكر في سورة براءة(@)(@@)(@@)(@@) | 8 - (@)(@@) PageV01P486(@)(@@) {ولا تخزني} تفضحني {يوم يبعثون} الناس(@)(@@)(@@)(@@) | 8 - (@)(@@) PageV01P486(@)(@@) قال تعالى فيه {يوم لا ينفع مال ولا بنون} أحدا(@)(@@)(@@)(@@) | 8 - (@)(@@) PageV01P486(@)(@@) {إلا} لكن {من أتى الله بقلب سليم} من الشرك والنفاق وهو قلب المؤمن فإنه ينفعه ذلك(@)(@@)(@@)(@@) | 9 - (@)(@@) PageV01P486(@)(@@) {وأزلفت الجنة} قربت {للمتقين} فيرونها(@)(@@)(@@)(@@) | 9 - (@)(@@) PageV01P486(@)(@@) {وبرزت الجحيم} أظهرت {للغاوين} الكافرين(@)(@@)(@@)(@@) | 9 - (@)(@@) PageV01P486(@)(@@) {وقيل لهم أين ما كنتم تعبدون}(@)(@@)(@@)(@@) | 9 - (@)(@@) PageV01P486(@)(@@) {من دون 
ms394	 الله} أي غيره من الأصنام {هل ينصرونكم} بدفع العذاب عنكم {أو ينتصرون} بدفعه عن أنفسهم لا(@)(@@)(@@)(@@) | 9 - (@)(@@) PageV01P486(@)(@@) {فكبكبوا} ألقوا {فيها هم والغاوون}(@)(@@)(@@)(@@) | 9 - (@)(@@) PageV01P486(@)(@@) {وجنود إبليس} أتباعه ومن أطاعه من الجن والإنس {أجمعون}(@)(@@)(@@)(@@) | 9 - (@)(@@) PageV01P486(@)(@@) {قالوا} أي الغاوون {وهم فيها يختصمون} مع معبوديهم(@)(@@)(@@)(@@) | 9 - (@)(@@) PageV01P486(@)(@@) {تالله إن} مخففة من الثقيلة واسمها محذوف أي إنه {كنا لفي ضلال مبين} بين(@)(@@)(@@)(@@) | 9 - (@)(@@) PageV01P486(@)(@@) {إذ} حيث {نسويكم برب العالمين} في العبادة(@)(@@)(@@)(@@) | 9 - (@)(@@) PageV01P486(@)(@@) {وما أضلنا} عن الهدى {إلا المجرمون} أي الشياطين أو أولونا الذين اقتدينا بهم(@)(@@)(@@)(@@) | 10 - (@)(@@) PageV01P486(@)(@@) {فما لنا من شافعين} كما للمؤمنين من الملائكة والنبيين والمؤمنين(@)(@@)(@@)(@@) | 10 - (@)(@@) PageV01P486(@)(@@) {ولا صديق حميم} يهمه أمرنا(@)(@@) PageV01P486(@)(@@)(@@)(@@) | 10 - (@)(@@) PageV01P487(@)(@@) {فلو أن لنا كرة} رجعة إلى الدنيا {فنكون من المؤمنين} لو هنا للتمني ونكون جوابه(@)(@@)(@@)(@@) | 10 - (@)(@@) PageV01P487(@)(@@) {إن في ذلك} المذكور من قصة إبراهيم وقومه {لآية وما كان أكثرهم مؤمنين}(@)(@@)(@@)(@@) | 10 - (@)(@@) PageV01P487(@)(@@) {وإن ربك لهو العزيز الرحيم}(@)(@@)(@@)(@@) | 10 - (@)(@@) PageV01P487(@)(@@) {كذبت قوم نوح المرسلين} بتكذيبهم له لاشتراكهم في المجيء بالتوحيد أو لأنه لطول لبثه فيهم كأنه رسل وتأنيث قوم باعتبار معناه وتذكيره باعتبار لفظه(@)(@@)(@@)(@@) | 10 - (@)(@@) PageV01P487(@)(@@) {إذ قال لهم أخوهم} نسبا {نوح ألا تتقون} الله(@)(@@)(@@)(@@) | 10 - (@)(@@) PageV01P487(@)(@@) {إني لكم رسول أمين} على تبليغ ما أرسلت به(@)(@@)(@@)(@@) | 10 - (@)(@@) PageV01P487(@)(@@) {فاتقوا الله وأطيعون} فيما آمركم به من توحيد الله وطاعته(@)(@@)(@@)(@@) | 10 - (@)(@@) PageV01P487(@)(@@) {وما أسألكم عليه} على تبليغه {من أجر إن} ما {أجري} أي ثوابي {إلا على رب العالمين}(@)(@@)(@@)(@@) | 11 - (@)(@@) PageV01P487(@)(@@) {فاتقوا الله وأطيعون} كرره تأكيدا(@)(@@)(@@)(@@) | 11 - (@)(@@) PageV01P487(@)(@@) {قالوا أنؤمن} نصدق {لك} لقولك {واتبعك} وفي قراءة وأتباعك جمع تابع مبتدأ {الأرذلون} السفلة كالحاكة والأساكفة(@)(@@)(@@)(@@) | 11 - (@)(@@) PageV01P487(@)(@@) {قال وما علمي} أي علم لي {بما كانوا يعملون}(@)(@@)(@@)(@@) | 11 - (@)(@@) PageV01P487(@)(@@) {إن} ما {حسابهم إلا على ربي} فيجازيهم {لو تشعرون} تعلمون ذلك ما عبدتموهم(@)(@@)(@@)(@@) | 11 - (@)(@@) PageV01P487(@)(@@) {وما أنا بطارد المؤمنين}(@)(@@)(@@)(@@) | 11 - (@)(@@) PageV01P487(@)(@@) {إن} ما {أنا إلا نذير مبين} بين الإنذار(@)(@@)(@@)(@@) | 11 - (@)(@@) PageV01P487(@)(@@) {قالوا لئن لم تنته يا نوح} عما تقول لنا {لتكونن من المرجومين} بالحجارة أو بالشتم(@)(@@)(@@)(@@) | 11 - (@)(@@) PageV01P487(@)(@@) {قال} نوح {رب إن قومي كذبون}(@)(@@)(@@)(@@) | 11 - (@)(@@) PageV01P487(@)(@@) {فافتح بيني وبينهم فتحا} أي احكم {ونجني ومن معي من المؤمنين 
ms395	(@)(@@) PageV01P487(@)(@@)(@@)(@@) | 11 - (@)(@@) PageV01P488(@)(@@) قال تعالى {فأنجيناه ومن معه في الفلك المشحون} المملوء من الناس والحيوان والطير(@)(@@)(@@)(@@) | 12 - (@)(@@) PageV01P488(@)(@@) {ثم أغرقنا بعد} بعد إنجائهم {الباقين} من قومه(@)(@@)(@@)(@@) | 12 - (@)(@@) PageV01P488(@)(@@) {إن في ذلك لآية وما كان أكثرهم مؤمنين}(@)(@@)(@@)(@@) | 12 - (@)(@@) PageV01P488(@)(@@) {وإن ربك لهو العزيز الرحيم}(@)(@@)(@@)(@@) | 12 - (@)(@@) PageV01P488(@)(@@) {كذبت عاد المرسلين}(@)(@@)(@@)(@@) | 12 - (@)(@@) PageV01P488(@)(@@) {إذ قال لهم أخوهم هود ألا تتقون}(@)(@@)(@@)(@@) | 12 - (@)(@@) PageV01P488(@)(@@) {إني لكم رسول أمين}(@)(@@)(@@)(@@) | 12 - (@)(@@) PageV01P488(@)(@@) {فاتقوا الله وأطيعون}(@)(@@)(@@)(@@) | 12 - (@)(@@) PageV01P488(@)(@@) {وما أسألكم عليه من أجر إن} ما {أجري إلا على رب العالمين}(@)(@@)(@@)(@@) | 12 - (@)(@@) PageV01P488(@)(@@) {أتبنون بكل ريع} مكان مرتفع {آية} بناء علما للمارة {تعبثون}(@)(@@) بمن يمر بكم وتسخرون منهم والجملة حال من ضمير تبنون(@)(@@)(@@)(@@) | 12 - (@)(@@) PageV01P488(@)(@@) {وتتخذون مصانع} للماء تحت الأرض {لعلكم} كأنكم {تخلدون} فيها لا تموتون(@)(@@)(@@)(@@) | 13 - (@)(@@) PageV01P488(@)(@@) {وإذا بطشتم} بضرب أو قتل {بطشتم جبارين} من غير رأفة(@)(@@)(@@)(@@) | 13 - (@)(@@) PageV01P488(@)(@@) {فاتقوا الله} في ذلك {وأطيعون} فيما أمرتكم به(@)(@@)(@@)(@@) | 13 - (@)(@@) PageV01P488(@)(@@) {واتقوا الذي أمدكم} أنعم عليكم {بما تعلمون}(@)(@@)(@@)(@@) | 13 - (@)(@@) PageV01P488(@)(@@) {أمدكم بأنعام وبنين}(@)(@@)(@@)(@@) | 13 - (@)(@@) PageV01P488(@)(@@) {وجنات} بساتين {وعيون} أنهار(@)(@@)(@@)(@@) | 13 - (@)(@@) PageV01P488(@)(@@) {إني أخاف عليكم عذاب يوم عظيم} في الدنيا والآخرة إن عصيتموني(@)(@@)(@@)(@@) | 13 - (@)(@@) PageV01P488(@)(@@) {قالوا سواء علينا} مستو عندنا {أوعظت أم لم تكن من الواعظين} أصلا أي لا نرعوي لوعظك(@)(@@)(@@)(@@) | 13 - (@)(@@) PageV01P488(@)(@@) {إن} ما {هذا} الذي خوفتنا به {إلا خلق الأولين} اختلافهم وكذبهم وفي قراءة بضم الخاء واللام أي ما هذا الذي نحن عليه من إنكار البعث إلا خلق الأولين أي طبيعتهم وعادتهم(@)(@@)(@@)(@@) | 13 - (@)(@@) PageV01P488(@)(@@) {وما نحن بمعذبين(@)(@@) PageV01P488(@)(@@)(@@)(@@) | 13 - (@)(@@) PageV01P489(@)(@@) {فكذبوه} بالعذاب {فأهلكناهم} في الدنيا بالريح {إن في ذلك لآية وما كان أكثرهم مؤمنين}(@)(@@)(@@)(@@) | 14 - (@)(@@) PageV01P489(@)(@@) {وإن ربك لهو العزيز الرحيم}(@)(@@)(@@)(@@) | 14 - (@)(@@) PageV01P489(@)(@@) {كذبت ثمود المرسلين}(@)(@@)(@@)(@@) | 14 - (@)(@@) PageV01P489(@)(@@) {إذ قال لهم أخوهم صالح ألا تتقون}(@)(@@)(@@)(@@) | 143 - (@)(@@) {إني لكم رسول أمين}(@)(@@)(@@)(@@) | 144 - (@)(@@) {فاتقوا الله وأطيعون}(@)(@@)(@@)(@@) | 14 - (@)(@@) PageV01P489(@)(@@) {وما أسألكم عليه من أجر إن} ما {أجري إلا على رب العالمين}(@)(@@)(@@)(@@) | 14 - (@)(@@) PageV01P489(@)(@@) {أتتركون في ما ها هنا} من الخيرات {آمنين}(@)(@@)(@@)(@@) | 14 - (@)(@@) PageV01P489(@)(@@) {في جنات وعيون}(@)(@@)(@@)(@@) | 14 - (@)(@@) PageV01P489(@)(@@) {وزروع ونخل طلعها هضيم} لطيف لين(@)(@@)(@@)(@@) | 14 - (@)(@@) PageV01P489(@)(@@) {وتنحتون من الجبال بيوتا فرهين} بطرين وفي قراءة فارهين حاذقين(@)(@@)(@@)(@@) | 15 - (@)(@@) PageV01P489(@)(@@) {فاتقوا الله وأطيعون} فيما أمرتكم به 
ms396	(@)(@@)(@@)(@@) | 15 - (@)(@@) PageV01P489(@)(@@) {ولا تطيعوا أمر المسرفين}(@)(@@)(@@)(@@) | 15 - (@)(@@) PageV01P489(@)(@@) {الذين يفسدون في الأرض} بالمعاصي {ولا يصلحون} بطاعة الله(@)(@@)(@@)(@@) | 15 - (@)(@@) PageV01P489(@)(@@) {قالوا إنما أنت من المسحرين} الذين سحروا كثيرا حتى غلب على عقلهم(@)(@@)(@@)(@@) | 15 - (@)(@@) PageV01P489(@)(@@) {ما أنت} أيضا {إلا بشر مثلنا فأت بآية إن كنت من الصادقين} في رسالتك(@)(@@)(@@)(@@) | 15 - (@)(@@) PageV01P489(@)(@@) {قال هذه ناقة لها شرب} نصيب من الماء {ولكم شرب يوم معلوم}(@)(@@)(@@)(@@) | 15 - (@)(@@) PageV01P489(@)(@@) {ولا تمسوها بسوء فيأخذكم عذاب يوم عظيم} بعظم العذاب(@)(@@)(@@)(@@) | 15 - (@)(@@) PageV01P489(@)(@@) {فعقروها} عقرها بعضهم برضاهم {فأصبحوا نادمين} على عقرها(@)(@@)(@@)(@@) | 15 - (@)(@@) PageV01P489(@)(@@) {فأخذهم العذاب} الموعود به فهلكوا {إن في ذلك لآية وما كان أكثرهم مؤمنين}(@)(@@)(@@)(@@) | 15 - (@)(@@) PageV01P489(@)(@@) {وإن ربك لهو العزيز الرحيم}(@)(@@)(@@)(@@) | 16 - (@)(@@) PageV01P489(@)(@@) {كذبت قوم لوط المرسلين}(@)(@@)(@@)(@@) | 16 - (@)(@@) PageV01P489(@)(@@) {إذ قال لهم أخوهم لوط ألا تتقون}(@)(@@)(@@)(@@) | 16 - (@)(@@) PageV01P489(@)(@@) {إني لكم رسول أمين}(@)(@@)(@@)(@@) | 16 - (@)(@@) PageV01P489(@)(@@) {فاتقوا الله وأطيعون(@)(@@) PageV01P489(@)(@@)(@@)(@@) | 16 - (@)(@@) PageV01P490(@)(@@) {وما أسألكم عليه من أجر إن} ما {أجري إلا على رب العالمين}(@)(@@)(@@)(@@) | 16 - (@)(@@) PageV01P490(@)(@@) {أتأتون الذكران من العالمين} الناس(@)(@@)(@@)(@@) | 16 - (@)(@@) PageV01P490(@)(@@) {وتذرون ما خلق لكم ربكم من أزواجكم أقبالهن {بل أنتم قوم عادون} متجاوزون الحلال إلى الحرام(@)(@@)(@@)(@@) | 16 - (@)(@@) PageV01P490(@)(@@) {قالوا لئن لم تنته يا لوط} عن إنكارك علينا {لتكونن من المخرجين} من بلدتنا(@)(@@)(@@)(@@) | 16 - (@)(@@) PageV01P490(@)(@@) {قال} لوط {إني لعملكم من القالين} المبغضين(@)(@@)(@@)(@@) | 16 - (@)(@@) PageV01P490(@)(@@) {رب نجني وأهلي مما يعملون} أي من عذابه(@)(@@)(@@)(@@) | 17 - (@)(@@) PageV01P490(@)(@@) {فنجيناه وأهله أجمعين}(@)(@@)(@@)(@@) | 17 - (@)(@@) PageV01P490(@)(@@) {إلا عجوزا} امرأته {في الغابرين} الباقين أهلكناها(@)(@@)(@@)(@@) | 17 - (@)(@@) PageV01P490(@)(@@) {ثم دمرنا الآخرين} أهلكناهم(@)(@@)(@@)(@@) | 17 - (@)(@@) PageV01P490(@)(@@) {وأمطرنا عليهم مطرا} حجارة من جملة الإ هلاك {فساء مطر المنذرين} مطرهم(@)(@@)(@@)(@@) | 17 - (@)(@@) PageV01P490(@)(@@) {إن في ذلك لآية وما كان أكثرهم مؤمنين}(@)(@@)(@@)(@@) | 17 - (@)(@@) PageV01P490(@)(@@) {وإن ربك لهو العزيز الرحيم}(@)(@@)(@@)(@@) | 17 - (@)(@@) PageV01P490(@)(@@) {كذب أصحاب الأيكة} وفي قراءة بحذف الهمزة وإلقاء حركتها على اللام وفتح الهاء هي غيضة شجر قرب مدين {المرسلين}(@)(@@)(@@)(@@) | 17 - (@)(@@) PageV01P490(@)(@@) {إذ قال لهم شعيب} لم يقل لهم أخوهم لأنه لم يكن منهم {ألا تتقون}(@)(@@)(@@)(@@) | 17 - (@)(@@) PageV01P490(@)(@@) {إني لكم رسول أمين}(@)(@@)(@@)(@@) | 17 - (@)(@@) PageV01P490(@)(@@) {فاتقوا الله وأطيعون}(@)(@@)(@@)(@@) | 18 - (@)(@@) PageV01P490(@)(@@) {وما أسألكم عليه من أجر إن} ما {أجري إلا على رب العالمين}(@)(@@)(@@)(@@) | 18 - (@)(@@) PageV01P490(@)(@@) {أوفوا الكيل} أتموه {ولا تكونوا من المخسرين} الناقصين(@)(@@)(@@)(@@) | 18 - (@)(@@) PageV01P490(@)(@@) {وزنوا بالقسطاس المستقيم} 
ms397	 الميزان السوي(@)(@@) PageV01P490(@)(@@)(@@)(@@) | 18 - (@)(@@) PageV01P491(@)(@@) {ولا تبخسوا الناس أشياءهم} لا تنقصوهم من حقهم شيئا {ولا تعثوا في الأرض مفسدين} بالقتل وغيره من عثي بكسر المثلثة أفسد ومفسدين حال مؤكدة لمعنى عاملها(@)(@@)(@@)(@@) | 18 - (@)(@@) PageV01P491(@)(@@) {واتقوا الذي خلقكم والجبلة} الخليقة {الأولين}(@)(@@)(@@)(@@) | 18 - (@)(@@) PageV01P491(@)(@@) {قالوا إنما أنت من المسحرين}(@)(@@)(@@)(@@) | 18 - (@)(@@) PageV01P491(@)(@@) {وما أنت إلا بشر مثلنا وإن} مخففة من الثقيلة واسمها محذوف أي أنه {نظنك لمن الكاذبين}(@)(@@)(@@)(@@) | 18 - (@)(@@) PageV01P491(@)(@@) {فأسقط علينا كسفا} بسكون السين وفتحها قطعا {من السماء إن كنت من الصادقين} في رسالتك(@)(@@)(@@)(@@) | 18 - (@)(@@) PageV01P491(@)(@@) {قال ربي أعلم بما تعملون} فيجازيكم به(@)(@@)(@@)(@@) | 18 - (@)(@@) PageV01P491(@)(@@) {فكذبوه فأخذهم عذاب يوم الظلة} هي سحابة أظلتهم بعد حر شديد أصابهم فأمطرت عليهم نارا فاحترقوا {إنه كان عذاب يوم عظيم}(@)(@@)(@@)(@@) | 19 - (@)(@@) PageV01P491(@)(@@) {إن في ذلك لآية وما كان أكثرهم مؤمنين}(@)(@@)(@@)(@@) | 19 - (@)(@@) PageV01P491(@)(@@) {وإن ربك لهو العزيز الرحيم}(@)(@@)(@@)(@@) | 19 - (@)(@@) PageV01P491(@)(@@) {وإنه} أي القرآن {لتنزيل رب العالمين}(@)(@@)(@@)(@@) | 19 - (@)(@@) PageV01P491(@)(@@) {نزل به الروح الأمين} جبريل(@)(@@)(@@)(@@) | 19 - (@)(@@) PageV01P491(@)(@@) {على قلبك لتكون من المنذرين}(@)(@@)(@@)(@@) | 19 - (@)(@@) PageV01P491(@)(@@) {بلسان عربي مبين} بين وفي قراءة بتشديد نزل ونصب الروح والفاعل الله(@)(@@)(@@)(@@) | 19 - (@)(@@) PageV01P491(@)(@@) {وإنه} ذكر القرآن المنزل على محمد {لفي زبر} كتب {الأولين} كالتوراة والإنجيل(@)(@@)(@@)(@@) | 19 - (@)(@@) PageV01P491(@)(@@) {أو لم يكن لهم} لكفار مكة {آية} على ذلك {أن يعلمه علماء بني إسرائيل} كعبد الله بن سلام وأصحابه من الذين آمنوا فإنهم يخبرون بذلك ويكن بالتحتانية ونصب آية وبالفوقانية ورفع آية(@)(@@)(@@)(@@) | 19 - (@)(@@) PageV01P491(@)(@@) {ولو نزلناه على بعض الأعجمين} جمع أعجم(@)(@@)(@@)(@@) | 19 - (@)(@@) PageV01P491(@)(@@) {فقرأه عليهم} كفار مكة {ما كانوا به مؤمنين} أنفة من اتباعه(@)(@@) PageV01P491(@)(@@)(@@)(@@) | 20 - (@)(@@) PageV01P492(@)(@@) {كذلك} أي مثل إدخالنا التكذيب به بقراءة الأعجمي {سلكناه} أدخلنا التكذيب به {في قلوب المجرمين} كفار مكة بقراءة النبي(@)(@@)(@@)(@@) | 20 - (@)(@@) PageV01P492(@)(@@) {لا يؤمنون به حتى يروا العذاب الأليم}(@)(@@)(@@)(@@) | 20 - (@)(@@) PageV01P492(@)(@@) {فيأتيهم بغتة وهم لا يشعرون}(@)(@@)(@@)(@@) | 20 - (@)(@@) PageV01P492(@)(@@) {فيقولوا هل نحن منظرون} لنؤمن فيقال لهم لا فقالوا متى هذا العذاب قال تعالى(@)(@@)(@@)(@@) | 20 - (@)(@@) PageV01P492(@)(@@) {أفبعذابنا يستعجلون}(@)(@@)(@@)(@@) | 20 - (@)(@@) PageV01P492(@)(@@) {أفرأيت} أخبرني {إن متعناهم سنين}(@)(@@)(@@)(@@) | 20 - (@)(@@) PageV01P492(@)(@@) {ثم جاءهم ما كانوا يوعدون} من العذاب(@)(@@)(@@)(@@) | 20 - (@)(@@) PageV01P492(@)(@@) {ما} استفهامية بمعنى أي شيء {أغنى عنهم ما كانوا يمتعون} في دفع العذاب أو تخفيفه 
ms398	 أي لم يغن(@)(@@)(@@)(@@) | 20 - (@)(@@) PageV01P492(@)(@@) {وما أهلكنا من قرية إلا لها منذرون} رسل تنذر أهلها(@)(@@)(@@)(@@) | 20 - (@)(@@) PageV01P492(@)(@@) {ذكرى} عظة لهم {وما كنا ظالمين} في إهلاكهم بعد إنذارهم ونزل ردا لقول المشركين(@)(@@)(@@)(@@) | 21 - (@)(@@) PageV01P492(@)(@@) {وما تنزلت به} بالقرآن {الشياطين}(@)(@@)(@@)(@@) | 21 - (@)(@@) PageV01P492(@)(@@) {وما ينبغي} يصلح {لهم} أن ينزلوا به {وما يستطيعون} ذلك(@)(@@)(@@)(@@) | 21 - (@)(@@) PageV01P492(@)(@@) {إنهم عن السمع} لكلام الملائكة {لمعزولون} بالشهب(@)(@@)(@@)(@@) | 21 - (@)(@@) PageV01P492(@)(@@) {فلا تدع مع الله إلها آخر فتكون من المعذبين} إن فعلت ذلك الذي دعوك إليه(@)(@@)(@@)(@@) | 21 - (@)(@@) PageV01P492(@)(@@) {وأنذر عشيرتك الأقربين} وهم بنو هاشم وبنو المطلب وقد أنذرهم جهارا رواه البخاري ومسلم(@)(@@)(@@)(@@) | 21 - (@)(@@) PageV01P492(@)(@@) {واخفض جناحك} ألن جانبك {لمن اتبعك من المؤمنين} الموحدين(@)(@@)(@@)(@@) | 21 - (@)(@@) PageV01P492(@)(@@) {فإن عصوك} عشيرك {فقل} لهم {إني بريء مما تعملون} } من عبادة غير الله(@)(@@)(@@)(@@) | 21 - (@)(@@) PageV01P492(@)(@@) {وتوكل} بالواو والفاء {على العزيز الرحيم} الله أي فوض إليه جميع أمورك(@)(@@) PageV01P492(@)(@@)(@@)(@@) | 21 - (@)(@@) PageV01P493(@)(@@) {الذي يراك حين تقوم} إلى الصلاة(@)(@@)(@@)(@@) | 21 - (@)(@@) PageV01P493(@)(@@) {وتقلبك} في أركان الصلاة قائما وقاعدا وراكعا وساجدا {في الساجدين} المصلين(@)(@@)(@@)(@@) | 22 - (@)(@@) PageV01P493(@)(@@) {إنه هو السميع العليم}(@)(@@)(@@)(@@) | 22 - (@)(@@) PageV01P493(@)(@@) {هل أنبئكم} يا كفار مكة {على من تنزل الشياطين} بحذف إحدى التاءين من الأصل(@)(@@)(@@)(@@) | 22 - (@)(@@) PageV01P493(@)(@@) {تنزل على كل أفاك} كذاب {أثيم} فاجر مثل مسيلمة وغيره من الكهنة(@)(@@)(@@)(@@) | 22 - (@)(@@) PageV01P493(@)(@@) {يلقون} الشياطين {السمع} ما سمعوه من الملائكة إلى الكهنة {وأكثرهم كاذبون} يضمون إلى المسموع كذبا كثيرا وكان هذا قبل أن حجبت الشياطين عن السماء(@)(@@)(@@)(@@) | 22 - (@)(@@) PageV01P493(@)(@@) {والشعراء يتبعهم الغاوون} في شعرهم فيقولون به ويروونه عنهم فهم مذمومون(@)(@@)(@@)(@@) | 22 - (@)(@@) PageV01P493(@)(@@) {ألم تر} تعلم {أنهم في كل واد} من أودية الكلام وفنونه {يهيمون} يمضون فيجاوزون الحد مدحا وهجاء(@)(@@)(@@)(@@) | 22 - (@)(@@) PageV01P493(@)(@@) {وأنهم يقولون} فعلنا {ما لا يفعلون} يكذبون(@)(@@) PageV01P493(@)(@@)(@@)(@@) | 22 - (@)(@@) PageV01P494(@)(@@) {إلا الذين آمنوا وعملوا الصالحات} من الشعراء {وذكروا الله كثيرا} لم يشغلهم الشعر عن الذكر {وانتصروا} بهجوهم الكفار {من بعد ما ظلموا} بهجو الكفار لهم في جملة المؤمنين فليسوا مذمومين قال الله تعالى {لا يحب الله الجهر بالسوء من القول إلا من ظلم} وقال تعالى {فمن اعتدى عليكم فاعتدوا عليه بمثل ما اعتدى عليكم} {وسيعلم الذين ظلموا} من الشعراء وغيرهم {أي منقلب} 
ms399	 مرجع {ينقلبون} يرجعون بعد الموت = 27 سورة(@)(@@)(@@)(@@) | النمل(@)(@@) مكية وآياتها 93 أو 94 أو 95 آية نزلت بعد سورة الشعراء بسم الله الرحمن الرحيم(@)(@@) PageV01P494(@)(@@) {طس} الله أعلم بمراده بذلك {تلك} هذه الآيات {آيات القرآن} آيات منه {وكتاب مبين} مظهر للحق من الباطل عطف بزيادة صفة(@)(@@) PageV01P494(@)(@@) هو {هدى} هاد من الضلالة {وبشرى للمؤمنين} المصدقين به بالجنة(@)(@@) PageV01P494(@)(@@) {الذين يقيمون الصلاة} يأتون بها على وجهها {ويؤتون} يعطون {الزكاة وهم بالآخرة هم يوقنون} يعلمونها بالاستدلال وأعيد هم لما فصل بينه وبين الخبر(@)(@@) PageV01P494(@)(@@) {إن الذين لا يؤمنون بالآخرة زينا لهم أعمالهم} القبيحة بتركيب الشهوة حتى رأوها حسنة {فهم يعمهون} يتحيرون فيها لقبحها عندنا(@)(@@) PageV01P494(@)(@@) {أولئك الذين لهم سوء العذاب} أشده في الدنيا القتل والأسر {وهم في الآخرة هم الأخسرون} لمصيرهم إلى النار المؤبدة عليهم(@)(@@) PageV01P494(@)(@@) {وإنك} خطاب للنبي صلى الله عليه وسلم {لتلقى القرآن} يلقى عليك بشدة {من لدن} من عند {حكيم عليم} في ذلك(@)(@@) PageV01P494(@)(@@) اذكر {إذ قال موسى لأهله} زوجته عند مسيره من مدين إلى مصر {إني آنست} أبصرت من بعيد {نارا سآتيكم منها بخبر} عن حال الطريق وكان قد ضلها {أو آتيكم بشهاب قبس} بالإضافة للبيان وتركها أي شعلة نار في رأس فتيلة أو عود {لعلكم تصطلون} والطاء بدل من تاء الافتعال من صلي بالنار بكسر اللام وفتحها تستدفئون من البرد(@)(@@) PageV01P495(@)(@@) {فلما جاءها نودي} أي بأن {بورك} أي بارك الله {من في النار} أي موسى {ومن حولها} أي الملائكة أو العكس وبارك يتعدى بنفسه وبالحرف ويقدر بعد في مكان {وسبحان الله رب العالمين} من جملة ما نودي ومعناه تنزيه الله من السوء(@)(@@) PageV01P495(@)(@@) {يا موسى إنه} أي الشأن {أنا الله العزيز الحكيم}(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P495(@)(@@) {وألق عصاك} فألقاها {فلما رآها تهتز} تتحرك {كأنها جان} حية خفيفة {ولى مدبرا ولم يعقب} يرجع قال تعالى {يا موسى لا تخف} منها {إني لا يخاف لدي} عندي {المرسلون} من حية وغيرها(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P495(@)(@@) {إلا} لكن {من ظلم} نفسه {ثم بدل حسنا} أتاه {بعد سوء} أي تاب {فإني غفور رحيم} أقبل التوبة وأغفر له 
ms400	(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P495(@)(@@) {وأدخل يدك في جيبك} طوق قميصك {تخرج} خلاف لونها من الأدمة {بيضاء من غير سوء} برص لها شعاع يغشي البصر آية {في تسع آيات} مرسلا بها {إلى فرعون وقومه إنهم كانوا قوما فاسقين}(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P495(@)(@@) {فلما جاءتهم آياتنا مبصرة} مضيئة واضحة {قالوا هذا سحر مبين} بين ظاهر(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P495(@)(@@) {وجحدوا بها} لم يقروا {و} قد {استيقنتها أنفسهم} أي تيقنوا أنها من عند الله {ظلما وعلوا} تكبرا عن الإيمان بما جاء به موسى راجع إلى الجحد {فانظر} يا محمد {كيف كان عاقبة المفسدين} التي علمتها من إهلاكهم(@)(@@) PageV01P495(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P496(@)(@@) {ولقد آتينا داود وسليمان} ابنه {علما} بالقضاء بين الناس ومنطق الطير وغير ذلك {وقالا} شكرا لله {الحمد لله الذي فضلنا} بالنبوة وتسخير الجن والإنس والشياطين {على كثير من عباده المؤمنين}(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P496(@)(@@) {وورث سليمان داود} النبوة والعلم دون باقي أولاده {وقال يأيها الناس علمنا منطق الطير} أي فهم أصواته {وأوتينا من كل شيء} تؤتاه الأنبياء والملوك {إن هذا} المؤتى {لهو الفضل المبين} البين الظاهر(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P496(@)(@@) {وحشر} جمع {لسليمان جنوده من الجن والإنس والطير} في مسير له {فهو يوزعون} يجمعون ثم يساقون(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P496(@)(@@) {حتى إذا أتوا على واد النمل} هو بالطائف أو بالشام نملة صغار أو كبار {قالت نملة} ملكة النمل وقد رأت جند سليمان {يأيها النمل ادخلوا مساكنكم لا يحطمنكم} يكسرنكم {سليمان وجنوده وهم لا يشعرون} نزل النمل منزلة العقلاء في الخطاب بخطابهم(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P496(@)(@@) {فتبسم} سليمان ابتداء {ضاحكا} انتهاء {من قولها} وقد سمعه من ثلاثة أميال حملته إليه الريح فحبس جنده حين أشرف على واديهم حتى دخلوا بيوتهم وكان جنده ركبانا ومشاة في هذا السير {وقال رب أوزعني} ألهمني {أن أشكر نعمتك التي أنعمت} بها {علي وعلى والدي وأن أعمل صالحا ترضاه وأدخلني برحمتك في عبادك الصالحين} الأنبياء والأولياء(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P496(@)(@@) {وتفقد الطير} ليرى الهدهد الذي يرى الماء تحت الأرض ويدل عليه بنقره فيها فتستخرجه الشياطين لاحتياج سليمان إليه للصلاة فلم يره {فقال ما لي لا أرى الهدهد} أي أعرض لي ما منعني من رؤيته {أم 