ms1301	 الخليل إلى الخليل فناؤه % % ليكون مدفونا له أو دافنا % % 509(@)(@@) % ولربما اختطفا جميعا خطفة % والدهر أخطف ماتراه محاجنا % % 510(@)(@@) % ولما جلوت صفاح قلبك واعظا % % إني رأيت عليه رينا رائنا % % PageV01P4921 511(@)(@@) % لكنه التذكير يهديه الفتى % % لأخيه حين يرى أساه راحنا % % 512(@)(@@) % ولئن عبأت لك الأسى لعلى امرئ % أمسى الحزين عليه لا المتحازنا % % 513(@)(@@) % ولئن أمرتك بالتجلد ظاهرا % لقد امتلأت عليه شجوا باطنا % % 514(@)(@@) % ولقد أقول غداة قام نعيه % % هيجت لي شجنا لعمرك شاجنا % % 515(@)(@@) % صفن الجواد وقد يطول جراؤه % % ولتسمعن بكل جار صافنا % % 516(@)(@@) % وطوى العتيق جناحه في وكنه % % وقصار ذي الطيران يلقى واكنا % % 517(@)(@@) % والحي يرتع ثم يسرع برهة % فإذا قضى أربيه أمسى عاطنا % % 518(@)(@@) % مات الذي نال العلا متناولا % % من بعد مانال العلا متطامنا % % 519(@)(@@) % مات الذي كان النصيح مساترا % مات الذي كان النصير معالنا % % 520(@)(@@) % مات الذي فتح الفتوح ملاينا % لاعاجزا عن فتحهن مخاشنا % % PageV01P4922 521(@)(@@) % مات الذي أحيا النفوس بيمنه % % وأمات منها للملوك ضغائنا % % 522(@)(@@) % مات الذي صان الدماء ولم يزل % عن كل إثم للأئمة صائنا % % 523(@)(@@) % مات الذي أغناه لطف حويله % عن أن يهز صوارما وموارنا % % 524(@)(@@) % مات الذي رأب الثأي متعاليا % عن أن يصادف ضاربا أو طاعنا % % 525(@)(@@) % يا أحمد المحمود إن عيوننا % % أضحت كما أمست عليك سخائنا % % 526(@)(@@) % يا أصبغي الملك إن ظواهرا % أكسفتها منا وإن بواطنا % % 527(@)(@@) % تلك المفارح أصبحت % % قلبت هموما للعظام شوافنا % % 528(@)(@@) % لا تبعدن وإن نزلت بمنزل % أمسى بعيدا عن أودك شاطنا % % 529(@)(@@) % فلقد أصابتك الخطوب حواقدا % ولقد أشاطتك المنون ضواغنا % % 530(@)(@@) % كنت الذي تقتادهن على الوجى % % وتذلهن مخاطما ورواسنا % % PageV01P4923 531(@)(@@) % سقيت معونتك الوزير فلم تكن % % إلا معاون جمة ومعادنا % % 532(@)(@@) % وأثيب سعيك للإمام فلم تزل % % لثغوره بجنود رأيك شاحنا % % 533(@)(@@) % ما كانت العزاء تزحم منكم % % إلا جبالا لا تزول ركائنا % % 534(@)(@@) % ماكانت الللأواء تلقى منكم % % إلا مضابر نوبة ومماتنا % % 535(@)(@@) % لهفي أبا العباس لهفة آمل % كان ارتجاك على الزمان معاونا % % 536(@)(@@) % ولساسة الدنيا أحق بلهفتي % % مني وأولى بالغليل جناجنا % % 537 
ms1302	(@)(@@) % لهفي عليك لخطة مرهوبة % ما كنت فيها بالذميم مواطنا % % 538(@)(@@) % لهفي عليم لها إذا أزماتها % % ضاقت على الزول الرحيب معاطنا % % 539(@)(@@) % كم من أعاد قد رقيت فلم تدع % فيهم رقاك الشافيات مداهنا % % 540(@)(@@) % أطفأت نارهم وكن نوائرا % وأبحت حقدهم وكان دواجنا % % PageV01P4924 541(@)(@@) % متألفا لهم تألف حول % لو شاء سير بالقفار سفائنا % % 542(@)(@@) % متلطفا لهم تلطف قلب % لو شاء شاد على البحار مدائنا % % 543(@)(@@) % ماكان سعيك للخلائف كلها % % إلا معاقل تارة ومعادنا % % 544(@)(@@) % إن نابهم خطب درأت وإن بغوا % % مالا ملأت خزائنا وخزائنا % % 545(@)(@@) % كم قد فتحت لهم عدوا جامحا % كم قد حرثت لهم خراجا حارنا % % 546(@)(@@) % أنشرت آراء وكن هوامدا % وأثرت أموالا وكن دفائنا % % 547(@)(@@) % كانت فتوحك كلها ميمونة % تأتي وليست للحتوف قرائنا % % 548(@)(@@) % بالخيل لكن لاتزال صوافنا % والبيض لكن لاتزال كوامنا % % 549(@)(@@) % عجبا لفتحك بالسيوف كوامنا % تلك الفتوح وبالجياد صوافنا % % 550(@)(@@) % مازلت تجتنب الدماء وسفكها % % فإذا طغت وجدتك حينا حائنا % % PageV01P4925 551(@)(@@) % تضع السلاح تأثما وتكرما % وتظل بالرأي السديد مزابنا % % 552(@)(@@) % فكأنك المقدار يخفى شخصه % % ويحرك الأشياء طرا ساكنا % % 553(@)(@@) % ولئن وضعت القوس ثم لمعتد % إن شاء عبأ للرماء كنائنا % % 554(@)(@@) % ولئن وضعت الرمح ثم لمصدر % إن شاء هيأ للطعان مطاعنا % % 555(@)(@@) % ولئن وضعت السيف ثم لمنجد % إن شاء وطأ للضراب أماكنا % % 556(@)(@@) % يغدو المقاتل ماهنا لاماهرا % أبدا وتعدو ماهرا لاماهنا % % 557(@)(@@) % كم قد ظفرت مكاتبا ومخاطبا % % حتى خشيت مضاربا ومطاعنا % % 558(@)(@@) % كم قد غلبت ذوي الشقاق مسالما % لاسافكا لدم ولكن حاقنا % % 559(@)(@@) % فوقيت من دنس الدماء أئمة % ووقيت من قومت ركنا دائنا % % 560(@)(@@) % نفلتهم أموالهم ودماءهم % % ونساءهم فتركتهن حواضنا % % PageV01P4926 561(@)(@@) % ولو التووا لرميتهم بمكائد % أخفى من الأجل الحبيس مكامنا % % 562(@)(@@) % كم قسور قلمت منه أظافرا % تقليم من لم نخف منه براثنا % % 563(@)(@@) % ومنيع ظهر راح قد حملته % % تحميل من لم تدم منه سناسنا % % 564(@)(@@) % فغدا سليم القلب غير مضاغن % ولربما خنع العدو مضاغنا % % 565(@)(@@) % ملك الرقاب أخو القتال مخاشنا % وملكت أفئدة الرجال ملاينا % % 566(@)(@@) % أحسنت أدواء الأمور مفاحشا % بالسيف 
ms1303	 أن تلي الأمور محاسنا % % 567(@)(@@) % فغدوت تعتد القلوب مصافيا % % وسواك يعتد القلوب مشاجنا % % 568(@)(@@) % وأصح من ملك الرقاب لمالك % ملك القلوب بردهن أوامنا % % 569(@)(@@) % فليهنأ الأملاك أن ملكتهم % % ملك السلامة زائنا لا شائنا % % 570(@)(@@) % واسعد بمرضاة الملوك فلم تكن % % وسنان دونهم ولا متواسنا % % PageV01P4927 571(@)(@@) % مازلت تكلؤهم بعين نصيحة % وتبيت للفكر الطويل مثافنا % % 572(@)(@@) % متقدما متأخرا متصعدا % % متحدرا متياسرا متيامنا % % 573(@)(@@) % متجاسرا حتى لظنك جاهل % غمرا تخال الليث ظبيا شادنا % % 574(@)(@@) % متحرزا حتى لخالك خائل % رجلا شديد الجبن أو متجابنا % % 575(@)(@@) % والفتك إلقاء الدروع بأسرها % % والحزم تعلية الدروع جواشنا % % 576(@)(@@) % وكلاهما قد كان فيك وإنما % % بهما سبقت السابقين مراهنا % % 577(@)(@@) % ولذاك قدمك الملوك ولم تزل % بقديم مثلك للملوك ديادنا % % 578(@)(@@) % وجزوك أن أصبحت بين ضلوعهم % % قد بؤؤك من الصدور مدائنا % % 579(@)(@@) % ذكراك طولالدهر حشوا قلوبهم % % قد حاولوا منها ثويا قاطنا % % 580(@)(@@) % هذا لذاك أبا الحسين وبعده % % إجراء مدحك شأوه المتباطنا % % PageV01P4928 581(@)(@@) % ومسائل لي عنك قلت نفوسنا % % تفدي الجميل ظهائرا وبطائنا % % 582(@)(@@) % ساءلت عن متغابن في دينه % إذ لا يرى في دينه متغابنا % % 583(@)(@@) % مستأثر بالحمد قدما مؤثر % بالحمد مازال الخميص البادنا % % 584(@)(@@) % ممن ترى الأخلاق في هذا الورى % % هجنا وما يعدمن فيه هجائنا % % 585(@)(@@) % تلقاه بالعرف القريب مقاربا % وتراه بالشأو البعيد مباينا % % 586(@)(@@) % ألفته مجتبيا كريما راجحا % إذ لا نكاد نرى كريما وازنا % % 587(@)(@@) % نبلو فنحمد منه حلما ناسكا % % أبدا ونعذل منه جودا ماجنا % % 588(@)(@@) % وإذا جهلنا ما عواقب خطبة % ظلنا نسائل منه رأيا كاهنا % % 589(@)(@@) % سمع الدعاء وقد تصامم غيره % % ووعى الثناء وكان طبا طابنا % % 590(@)(@@) % وتحفظ المدح الذي أهديته % % كرما ودونه لديه دواونا % % PageV01P4929 591(@)(@@) % وأحب تعريفي تحفيه به % % فافتن فيه مسائلا ومفاطنا % % 592(@)(@@) % يعني معانيه ويلفظ لفظه % % لحنا بذلك كله لا لاحنا % % 593(@)(@@) % ومن السعادة أن تنادي سامعا % عند الدعاء وأن تقرظ لاقنا % % 594(@)(@@) % ولما مدحتك مائنا في مدحتي % % ومتى تلاقي مادحا لا مائنا % % 595(@)(@@) % ولقد غدا مدحي لقوم زائنا % ولقد غدوت له بنيلك زائنا % % 596(@)(@@) % وافخر بأنك لاتنازع 
ms1304	 مفخرا % يا أيها الرجل الكريم شناشنا % % 597(@)(@@) % ولأنت أسكت حين يفخر فاخر % ولأنت أنطق إذ سكت محاسنا % % 598(@)(@@) % والحر أحصر حين يفخر غيره % % أبدا وأحضر شاهدا وبراهنا % % 599(@)(@@) % أسهبت فيك وذاك ما كلفتني % % بمواهب لك لم يكن ملاعنا % % 600(@)(@@) % عجبي أطلت لك الرشاء ولم أجد % جدواك غورا بل معينا عائنا % % PageV01P4930 601(@)(@@) % وإخال أنك لا تمج إطالتي % % إلا كراهة أن تكون الغابنا % % 602(@)(@@) % ولما عنيت وكيف ذاك وإنماه ولع الزمان بأن يحرك ساكنا % وبأن يثير من الأوابد كامنا % % 603(@)(@@) % وهم الأحبة من أقام ترحلوا % % عنه فكلهم يودع ظاعنا % % 604(@)(@@) % أضحى الزمان مدائنا لك فيهم % ولعل رشدا إن قضيت مدائنا % % 605(@)(@@) % فأرى الليالي ما نقضن معاهدا % فيما أتين ولا هجمن مآمنا % % 606(@)(@@) % رحلن إلفك عن مساكن قلعة % كانت لقوم آخرين مساكنا % % 607(@)(@@) % فاقن الحياء أبا الحسين فلم يكن % % شيء فري لم تخله كائنا % % 608(@)(@@) % كان الذي قد كنت توقن أنه % % سيكون فاجزع واقنا لا واهنا % % 609(@)(@@) % هون عليك المقطعات ولا تكن % % بنصيحة من مخلص متهاونا % % 610(@)(@@) % إن الحوادث قد عدون فواجعا % فاشدد إزارك لا يكن فواتنا % % PageV01P4931 611(@)(@@) % لا تنكرن من المصائب منا أتى % % حتى كأنك كنت منها آمنا % % 612(@)(@@) % أنكره إنكار امرىء عرف الردى % % ورأى النفوس بأن يمتن رهائنا % % 613(@)(@@) % إني نكرت على الليالي أن أتت % ما قد أتته لم يكن ظنائنا % % 614(@)(@@) % هل كنت غرا بالنوائب قبلها % % أم خلتهن لما تحب ضوامنا % % 615(@)(@@) % بل كنت فيما قد لقيت مفكرا % % حتى كأنك كنت ثم معاينا % % 616(@)(@@) % فعلام تنفر نفرة وحشية % وتعد دهرك غائلا لك خائنا % % 617(@)(@@) % ماخان دهر مؤذن بصروفه % ما انفك يرسل بالمواعظ آذنا % % 618(@)(@@) % طامن حشاك أخا البقاء لدائه % فلتزجرن أشائما وأيامنا % % 619(@)(@@) % داء البقاء الرفء إما عاجلا % لا زلت توفاه وإما آينا % % 620(@)(@@) % من عاش أثكله الزمان خليله % وسقاه بعد الصفو رنقا آجنا % % PageV01P4932 621(@)(@@) % وكذا شرب العيش فيه تلون % بيناه عذب إذ تحول آسنا % % 622(@)(@@) % والمرء ماعدت الحوادث نفسه % يلقي الزمان محاربا ومهادنا % % 623(@)(@@) % دار الزمان بليله ونهاره % فأدار 
ms1305	 أرحاء المنون طواحنا % % 624(@)(@@) % فتأمل الدنيا ولاتعجب لها % % واعجب لمن أضحى إليها راكنا % % 625(@)(@@) % قضى أبو العباس خلك نحبه % فجعلت نحبك دمعك المتهاتنا % % 626(@)(@@) % وودت أنك منه أول لاحق % % أوكنت مضمونا إليه مقارنا % % 627(@)(@@) % لكن أبى ذاك الإله فلا ترد % مالم يرد لقضائه وارض العزاء مخادنا % % 628(@)(@@) % لاتسجنن الهم عندك إنه % % مازال مسجونا يعذب ساجنا % % 629(@)(@@) % واصبر كما أمر المليك فإنما % % يهدي المدين إذا أطاع الدائنا % % 630(@)(@@) % والله يمنحك الخلود مجاورا % أخيك في جناته ومساكنا % % PageV01P4933 631(@)(@@) % من بعد أن تحيا حياة ممتع % % لا كالمشيع علو بين ظعائنا % % 632(@)(@@) % مامات خلك يوم زار ضريحه % % بل يوم زار قوابلا وحواضنا % % 633(@)(@@) % بل منذ أودع من أبيه وأمه % مستودعيه فكن لذلك فاطنا % % 634(@)(@@) % بل قد يمت دون الألى فوق الثرى % % نطق البيان مكاتبا وملاسنا % % 635(@)(@@) % مازال خلك ميتا ولميت % في الميتين مصاهرا ومخاتنا % % 636(@)(@@) % مات الخلائق مذ نعاهم ربهم % % بل مذ رأت عين قرينا بائنا % % 637(@)(@@) % أفللتقدم والتأخر يمتري % % عينيك أسراب الدموع هواتنا % % 638(@)(@@) % ساق الخليل إلى الخليل فناؤه % % ليكون مدفونا له أو دافنا % % 639(@)(@@) % ولربما اختطفا جميعا خطفة % والدهر أخطف ماتراه محاجنا % % 640(@)(@@) % ولما جلوت صفاح قلبك واعظا % % إني رأيت عليه رينا رائنا % % PageV01P4934 641(@)(@@) % لكنه التذكير يهديه الفتى % % لأخيه حين يرى أساه راحنا % % 642(@)(@@) % ولئن عبأت لك الأسى لعلى امرئ % أمسى الحزين عليه لا المتحازنا % % 643(@)(@@) % ولئن أمرتك بالتجلد ظاهرا % لقد امتلأت عليه شجوا باطنا % % 644(@)(@@) % ولقد أقول غداة قام نعيه % % هيجت لي شجنا لعمرك شاجنا % % 645(@)(@@) % صفن الجواد وقد يطول جراؤه % % ولتسمعن بكل جار صافنا % % 646(@)(@@) % وطوى العتيق جناحه في وكنه % % وقصار ذي الطيران يلقى واكنا % % 647(@)(@@) % والحي يرتع ثم يسرع برهة % فإذا قضى أربيه أمسى عاطنا % % 648(@)(@@) % مات الذي نال العلا متناولا % % من بعد مانال العلا متطامنا % % 649(@)(@@) % مات الذي كان النصيح مساترا % مات الذي كان النصير معالنا % % 650(@)(@@) % مات الذي فتح الفتوح ملاينا % لاعاجزا عن فتحهن مخاشنا % % PageV01P4935 651(@)(@@) % مات الذي أحيا النفوس بيمنه % % وأمات منها للملوك ضغائنا % % 652(@)(@@) % مات 
ms1306	 الذي صان الدماء ولم يزل % عن كل إثم للأئمة صائنا % % 653(@)(@@) % مات الذي أغناه لطف حويله % عن أن يهز صوارما وموارنا % % 654(@)(@@) % مات الذي رأب الثأي متعاليا % عن أن يصادف ضاربا أو طاعنا % % 655(@)(@@) % يا أحمد المحمود إن عيوننا % % أضحت كما أمست عليك سخائنا % % 656(@)(@@) % يا أصبغي الملك إن ظواهرا % أكسفتها منا وإن بواطنا % % 657(@)(@@) % تلك المفارح أصبحت % % قلبت هموما للعظام شوافنا % % 658(@)(@@) % لا تبعدن وإن نزلت بمنزل % أمسى بعيدا عن أودك شاطنا % % 659(@)(@@) % فلقد أصابتك الخطوب حواقدا % ولقد أشاطتك المنون ضواغنا % % 660(@)(@@) % كنت الذي تقتادهن على الوجى % % وتذلهن مخاطما ورواسنا % % PageV01P4936 661(@)(@@) % سقيت معونتك الوزير فلم تكن % % إلا معاون جمة ومعادنا % % 662(@)(@@) % وأثيب سعيك للإمام فلم تزل % % لثغوره بجنود رأيك شاحنا % % 663(@)(@@) % ما كانت العزاء تزحم منكم % % إلا جبالا لا تزول ركائنا % % 664(@)(@@) % ماكانت اللأواء تلقى منكم % % إلا مضابر نوبة ومماتنا % % 665(@)(@@) % لهفي أبا العباس لهفة آمل % كان ارتجاك على الزمان معاونا % % 666(@)(@@) % ولساسة الدنيا أحق بلهفتي % % مني وأولى بالغليل جناجنا % % 667(@)(@@) % لهفي عليك لخطة مرهوبة % ما كنت فيها بالذميم مواطنا % % 668(@)(@@) % لهفي عليم لها إذا أزماتها % % ضاقت على الزول الرحيب معاطنا % % 669(@)(@@) % كم من أعاد قد رقيت فلم تدع % فيهم رقاك الشافيات مداهنا % % 670(@)(@@) % أطفأت نارهم وكن نوائرا % وأبحت حقدهم وكان دواجنا % % PageV01P4937 671(@)(@@) % متألفا لهم تألف حول % لو شاء سير بالقفار سفائنا % % 672(@)(@@) % متلطفا لهم تلطف قلب % لو شاء شاد على البحار مدائنا % % 673(@)(@@) % ماكان سعيك للخلائف كلها % % إلا معاقل تارة ومعادنا % % 674(@)(@@) % إن نابهم خطب درأت وإن بغوا % % مالا ملأت خزائنا وخزائنا % % 675(@)(@@) % كم قد فتحت لهم عدوا جامحا % كم قد حرثت لهم خراجا حارنا % % 676(@)(@@) % أنشرت آراء وكن هوامدا % وأثرت أموالا وكن دفائنا % % 677(@)(@@) % كانت فتوحك كلها ميمونة % تأتي وليست للحتوف قرائنا % % 678(@)(@@) % بالخيل لكن لاتزال صوافنا % والبيض لكن لاتزال كوامنا % % 679(@)(@@) % عجبا لفتحك بالسيوف كوامنا % تلك الفتوح وبالجياد صوافنا % % 680(@)(@@) % مازلت تجتنب الدماء وسفكها % % فإذا طغت وجدتك حينا حائنا % % PageV01P4938 681(@)(@@) % تضع السلاح تأثما وتكرما % وتظل بالرأي 
ms1307	 السديد مزابنا % % 682(@)(@@) % فكأنك المقدار يخفى شخصه % % ويحرك الأشياء طرا ساكنا % % 683(@)(@@) % ولئن وضعت القوس ثم لمعتد % إن شاء عبأ للرماء كنائنا % % 684(@)(@@) % ولئن وضعت الرمح ثم لمصدر % إن شاء هيأ للطعان مطاعنا % % 685(@)(@@) % ولئن وضعت السيف ثم لمنجد % إن شاء وطأ للضراب أماكنا % % 686(@)(@@) % يغدو المقاتل ماهنا لاماهرا % أبدا وتعدو ماهرا لاماهنا % % 687(@)(@@) % كم قد ظفرت مكاتبا ومخاطبا % % حتى خشيت مضاربا ومطاعنا % % 688(@)(@@) % كم قد غلبت ذوي الشقاق مسالما % لاسافكا لدم ولكن حاقنا % % 689(@)(@@) % فوقيت من دنس الدماء أئمة % ووقيت من قومت ركنا دائنا % % 690(@)(@@) % نفلتهم أموالهم ودماءهم % % ونساءهم فتركتهن حواضنا % % PageV01P4939 691(@)(@@) % ولو التووا لرميتهم بمكائد % أخفى من الأجل الحبيس مكامنا % % 692(@)(@@) % كم قسور قلمت منه أظافرا % تقليم من لم نخف منه براثنا % % 693(@)(@@) % ومنيع ظهر راح قد حملته % % تحميل من لم تدم منه سناسنا % % 694(@)(@@) % فغدا سليم القلب غير مضاغن % ولربما خنع العدو مضاغنا % % 695(@)(@@) % ملك الرقاب أخو القتال مخاشنا % وملكت أفئدة الرجال ملاينا % % 696(@)(@@) % أحسنت أدواء الأمور مفاحشا % بالسيف أن تلي الأمور محاسنا % % 697(@)(@@) % فغدوت تعتد القلوب مصافيا % % وسواك يعتد القلوب مشاجنا % % 698(@)(@@) % وأصح من ملك الرقاب لمالك % ملك القلوب بردهن أوامنا % % 699(@)(@@) % فليهنأ الأملاك أن ملكتهم % % ملك السلامة زائنا لا شائنا % % 700(@)(@@) % واسعد بمرضاة الملوك فلم تكن % % وسنان دونهم ولا متواسنا % % PageV01P4940 701(@)(@@) % مازلت تكلؤهم بعين نصيحة % وتبيت للفكر الطويل مثافنا % % 702(@)(@@) % متقدما متأخرا متصعدا % % متحدرا متياسرا متيامنا % % 703(@)(@@) % متجاسرا حتى لظنك جاهل % غمرا تخال الليث ظبيا شادنا % % 704(@)(@@) % متحرزا حتى لخالك خائل % رجلا شديد الجبن أو متجابنا % % 705(@)(@@) % والفتك إلقاء الدروع بأسرها % % والحزم تعلية الدروع جواشنا % % 706(@)(@@) % وكلاهما قد كان فيك وإنما % % بهما سبقت السابقين مراهنا % % 707(@)(@@) % ولذاك قدمك الملوك ولم تزل % بقديم مثلك للملوك ديادنا % % 708(@)(@@) % وجزوك أن أصبحت بين ضلوعهم % % قد بؤؤك من الصدور مدائنا % % 709(@)(@@) % ذكراك طولالدهر حشوا قلوبهم % % قد حاولوا منها ثويا قاطنا % % 710(@)(@@) % هذا لذاك أبا الحسين وبعده % % إجراء مدحك شأوه المتباطنا % % PageV01P4941 711(@)(@@) % ومسائل لي عنك قلت نفوسنا % % تفدي الجميل ظهائرا 
ms1308	 وبطائنا % % 712(@)(@@) % ساءلت عن متغابن في دينه % إذ لا يرى في دينه متغابنا % % 713(@)(@@) % مستأثر بالحمد قدما مؤثر % بالحمد مازال الخميص البادنا % % 714(@)(@@) % ممن ترى الأخلاق في هذا الورى % % هجنا وما يعدمن فيه هجائنا % % 715(@)(@@) % تلقاه بالعرف القريب مقاربا % وتراه بالشأو البعيد مباينا % % 716(@)(@@) % ألفته مجتبيا كريما راجحا % إذ لا نكاد نرى كريما وازنا % % 717(@)(@@) % نبلو فنحمد منه حلما ناسكا % % أبدا ونعذل منه جودا ماجنا % % 718(@)(@@) % وإذا جهلنا ما عواقب خطبة % ظلنا نسائل منه رأيا كاهنا % % 719(@)(@@) % سمع الدعاء وقد تصامم غيره % % ووعى الثناء وكان طبا طابنا % % 720(@)(@@) % وتحفظ المدح الذي أهديته % % كرما ودونه لديه دواونا % % PageV01P4942 721(@)(@@) % وأحب تعريفي تحفيه به % % فافتن فيه مسائلا ومفاطنا % % 722(@)(@@) % يعني معانيه ويلفظ لفظه % % لحنا بذلك كله لا لاحنا % % 723(@)(@@) % ومن السعادة أن تنادي سامعا % عند الدعاء وأن تقرظ لاقنا % % 724(@)(@@) % ولما مدحتك مائنا في مدحتي % % ومتى تلاقي مادحا لا مائنا % % 725(@)(@@) % ولقد غدا مدحي لقوم زائنا % ولقد غدوت له بنيلك زائنا % % 726(@)(@@) % وافخر بأنك لاتنازع مفخرا % يا أيها الرجل الكريم شناشنا % % 727(@)(@@) % ولأنت أسكت حين يفخر فاخر % ولأنت أنطق إذ سكت محاسنا % % 728(@)(@@) % والحر أحصر حين يفخر غيره % % أبدا وأحضر شاهدا وبراهنا % % 729(@)(@@) % أسهبت فيك وذاك ما كلفتني % % بمواهب لك لم يكن ملاعنا % % 730(@)(@@) % عجبي أطلت لك الرشاء ولم أجد % جدواك غورا بل معينا عائنا % % PageV01P4943 731(@)(@@) % وإخال أنك لا تمج إطالتي % % إلا كراهة أن تكون الغابنا % % 732(@)(@@) % ولما عنيت وكيف ذاك وإنما % % أثنى بما يغني الغناء الراهنا % % 733(@)(@@) % مازلت أستكفيك كل مصيبة % % فتزيلها حتى حسبتك ضامنا % % 734(@)(@@) % فانظر أأبلغ مابدلت مكافئا % واذكر أأعدل مافعلت موازنا % % 735(@)(@@) % وأمد كفي نحو كل رغيبة % فتنيلها حتى حسبتك خازنا % % 736(@)(@@) % أرني الغناء على الثناء ومن يرى % % عدل السنام من الجذور فراسنا % % 737(@)(@@) % صادفت قشفا فكنت جلاءه % ورأيت بي شعثا فكنت الداهنا % % 738(@)(@@) % وسألت أقواما فساء نوالهم % % ولقد رأوا زمني لعظمي سافنا % % 739(@)(@@) % وأبت إضافتي الخليقة كلها % % وأضفتني حتى أضفت ضيافنا % % 740(@)(@@) % ما أظهروا عذرا ولا حجبوا قرى 
ms1309	 % % إلا رأيتك تامرا لي لابنا % % PageV01P4944 741(@)(@@) % أنت الذي تضحي وبيتك كعبة % جعلت يداك الجود فيها سادنا % % 742(@)(@@) % وسع الأنام ربيع فضلك كلهم % % حتى لقد لحق الهزيل السامنا % % 743(@)(@@) % صادفت أعلام الثناء خسائسا % فجعلتها بالعارفات ثمائنا % % 744(@)(@@) % ووجدت أنفسنا بهن مذائلا % % فرددت أنفسنا بهن ضنائنا % % 745(@)(@@) % فضلا نعشت به جدود معاشر % وجنأت منه أجنة وجنائنا % % 746(@)(@@) % أعطيت حتى بات بين حلائل % صرد فرشت له فراشا ساخنا % 747(@)(@@) % فغدا يحب حياته ولقد يرى % % لحياته قبل امتنانك لاعنا % % 748(@)(@@) % لوكنت عين المجد كنت سوادها % % أو كنت أنف المجد كنت المارنا % % 749(@)(@@) % أو أن أفلاك المعالي سبعة % لخرقتها صعدا إليها ثامنا % % 750(@)(@@) % خذها إليك أبا الحسين كأنها % % قطع الرياض لبسن يوما داجنا % % PageV01P4945 751(@)(@@) % نثرت عليك ثناءها فكأنما % % نثرت من المسك الذكي مخازنا % % 752(@)(@@) % لاراعت الأيام سرحك بعدها % % أبدا ولانظرت إليك شوافنا % % 753(@)(@@) % وإذا الزمان أصاب فمنصفا % ومؤدبا ومقوما لا فاتنا % % PageV01P4946 البحر : - 1(@)(@@) % يافؤادي غلبتني عصيانا % % فأطعني فقد عصيت زمانا % % 2(@)(@@) % يافؤادي ماتحن إلى طو % بى إذا الريح هبت الأغصانا % % 3(@)(@@) % مثل الأولياء في جنة الخل % د إذا ما تقابلو إخوانا % % 4(@)(@@) % قد تعالوا على أسرة در % لابسين الحرير والأرجوانا % % 5(@)(@@) % وعليهم تيجانهم والأكالي % % ل تباهي بحسنها التيجانا % % 6(@)(@@) % يتعاطونها سلافا شمولا % في جنان مجازرات جنانا % % 7(@)(@@) % يتلقاهم بقول حفي % % مرحبا مرحبا بكم ركبانا % % 8(@)(@@) % وتجلت عن وجهه حجب الن % % ور فسبحان وجهه سبحانا % % 9(@)(@@) % واستفادوا بشاشة وسرورا % ينفيان الشرور والأحزانا % % 10(@)(@@) % ثم آبوا فاستقبلتهم حسان % من بنات النعيم فقن الحسانا % % PageV01P4947 11(@)(@@) % بوجوه مثل المصابيح لا يع % رفن إلا الظلال والأكنانا % % 12(@)(@@) % مرسلات على الروادف منهن % ن فروعا تمج مسكا وبانا % % 13(@)(@@) % لو رأى الدر بعضهن أو الشم % س لذلا لوجهها واستكانا % % 14(@)(@@) % فتلقينهم بأهلا وسهلا % رافعات إليهم الريحانا % % 15(@)(@@) % كن بالأولياء مفتنات % ثم زيدوا نورا فزدن افتتانا % % 16(@)(@@) % فتراهن مقبلات عليهم % % بابتهاج قد عصفروا الألوانا % % 17(@)(@@) % راشفات أفواههم رشفك الما % % ء إذا ما شربته ظمآنا % % 18(@)(@@) % قائلات عيل التصبر عنكم % % فانزلوا آن أن نراكم 
ms1310	 وحانا % % 19(@)(@@) % فتنوا أرجل النزول وحلوا % % في المقاصير لابسين أمانا % % 20(@)(@@) % تارة بعضهم يزورون بعضا % ويزورون ربهم أحيانا % % PageV01P4948 21(@)(@@) % ثم يخلون بعد ذلك بالحو % ر إذا ما تشوقوا الأوطانا % % 22(@)(@@) % فهم الدهر في سرور جديد % ليس يخلون من سرور أوانا % % PageV01P4949 البحر : - 1(@)(@@) % إني لأغضي عن الزلات أثبتها % % ذكرا إذا كان بعض الغض نسيانا % % 2(@)(@@) % أمض ماكنت من أقذاء معتبة % أغض ماكنت للإخوان أجفانا % % 3(@)(@@) % أغضي الجفون عن السوأى مراقبة % لما يكون من الحسنى وماكانا % % 4(@)(@@) % أجزي الأخلاء صفحا عن إساءتهم % % إذا أساءوا وبالإحسان إحسانا % % 5(@)(@@) % اذكر النفس مثنى من محاسنهم % % إذا ذكرت ذنوب القوم وحدانا % % 6(@)(@@) % وليس ذاك لآبائي ومجدهم % ولكن لأني اتخذت العدل ميزانا % % PageV01P4950 البحر : - 1(@)(@@) % سقني الأسكركع الصن % بر في جعضلفونه % 2(@)(@@) % واجعل الفيجن في الأف % واه منه بغضونه % % 3(@)(@@) % إنه مصفاة أعلا % % ه وعطر لبطونه % % 4(@)(@@) % وليكن من صنعة الكو % % في غريد زبونه % % 5(@)(@@) % واطبخ الدباء والحي % % راب لونا بمتونه % % 6(@)(@@) % إنه يستنقذ المج % نون من داء جنونه % % 7(@)(@@) % واطبخن لي اللبن الرا % % ئب لونا بلبونه % 8(@)(@@) % ومن السكباج فاطبخ % لي ثورا بقرونه % % PageV01P4951 البحر : - 1(@)(@@) % يامانعي باليأس من % إحسانه روح التمني % % 2(@)(@@) % ومروعي في كل يوم % % بالقطيعة والتجني % % 3(@)(@@) % ماهكذا بك كان حي % % ن بدأتني بالوصل ظني % % 4(@)(@@) % إني لأرحم من وصل % % ت وإن عدلت إليه عني % % PageV01P4952 البحر : - 1(@)(@@) % وباذنجان محشي تراه % يعوم كعنبر في دهن بان % PageV01P4953 البحر : - 1(@)(@@) % أيلتمس الناس الغنى فيصيبهم % % وألتمس القوت الطفيف فيلتوي % % 2(@)(@@) % ويمنعني ورد الشرائع أهلها % % ويسرع غيري في السحاب فيرتوي % % 3(@)(@@) % لما خلت هذا الجور للدهر يستوي % % وعينك تصفو لي ورأيك يستوي % % 4(@)(@@) % إلى أين بي إن خان حبلك قبضتي % % وأي النوى إن كان ذلك أنتوي % % PageV01P4954 البحر : - 1(@)(@@) % ياذا الذي منه التنك % كر والتغير والنبو % 2(@)(@@) % إن كان أدركك الملا % % ل فقد تدراكني السلو % % PageV01P4955 البحر : - 1(@)(@@) % مدحتك أكلأ النسرين ليلي % % فما أرعيتني عينا كلوا % % 2(@)(@@) % هدأت على الإساءة بي مصرا % % ونفسي قد أبت عنك الهدوا % % 3(@)(@@) % أسرك أن تكون طليق 
ms1311	 حلمي % % أم الأخرى فأجزي السوء سوا % % 4(@)(@@) % هما أمران مكروهان فاختر % طريق السهل واجتنب الدروا % % 5(@)(@@) % ولا تتطاولن علي إني % % أرد تطاول الطاغي لطوا % % 6(@)(@@) % سفكت دم الحياء فلا تتابع % لجاجا والتمس لدم رقوا % % 7(@)(@@) % وبؤ بالذنب والعتبى وإلا % % فليس بضائري ألا تبوا % % 8(@)(@@) % وكن متوقعا عودات ذمي % % كذات الحيض تنتظر القروا % % PageV01P4956 البحر : - 1(@)(@@) % أبلغ أباك إذا هلكت وقل له % يامقصي القوم الكرام إذا دنوا % % 2(@)(@@) % لله درك لو قصرت حجابة % جعلت عليك على العيال لما زنوا % % 3(@)(@@) % بل أيها الرجل المفوه في الورى % % والقامع المتشدقين إذا اكتنوا % % 4(@)(@@) % أقسمت لو ترمي العيال بأسهم % ترمي بهن الناس كفوا أو ونوا % % 5(@)(@@) % بل هم أحق بأن تقوم بشكرهم % % إذ صرحوا لك بالعهار وماكنوا % % 6(@)(@@) % قد نزهوك عن الخداع ونكبوا % % سبل النفاق وإن جنوا لك ماجنوا % % 7(@)(@@) % ولما غنوا مكروه نفسك عندها % % لكنهم محبوب أنفسهم عنوا % % 8(@)(@@) % فاعذر عيال أبيك في أفعالهم % % فلطال ماحدبوا عليك وما حنوا % % 9(@)(@@) % أثني عليهم بالجميل وإن بنوا % % لك من قرونك أو كشوخك مابنوا % % 10(@)(@@) % لوجدتهم مرضى القلوب إذا خلوا % % ورأيتهم مرضى العيون إذا رنوا % % PageV01P4957 11(@)(@@) % لايمنعون الماء عند وروده % % غلل السقاة ولا السناة إذا سنوا % % 12(@)(@@) % سقيا لهم وإن اجتويت فعالهم % % لقد اجتبوا لك مايقوتك واقتنوا % % 13(@)(@@) % فافخر بعيشك ياعيال عياله % % وبهم فكم بدأوا الجميل وكم ثنوا % % PageV01P4958 البحر : - 1(@)(@@) % سهاد أخي البلوى حقيق به السهو % ولم يلهه عن هجر أحبابه لهو % 2(@)(@@) % وبات ولما يطعم الغمض طرفه % % يكابد أحزانا وقد هجع الخلو % 3(@)(@@) % وأنى يرى ذو اللب مالك صبوة % % إذا لم ينله من أحبته العفو % 4(@)(@@) % أسالبتي حسن العزاء بصدها % % أما آن لي من طول ذي السقم البرو % 5(@)(@@) % فإن كان حقا مازعمت اجترمته % % فلا قل من أوجاعه بدني النضو % 6(@)(@@) % ولا استمتعت عيناي منك بنظرة % ولامح من قلبي لهجركم شجو % 7(@)(@@) % وكيف أمني النفس عنك تسليا % ومالي إلا أنتم في الهوى كفو % % 8(@)(@@) % حرمت إذن منك الوصال ونعمة % ولاعاد لي عيش بقربكم حلو % % 9(@)(@@) % وفارقني 
ms1312	 زير ومثنى ومثلث % وبم وسرى عني السكر الصحو % % PageV01P4959 البحر : - 1(@)(@@) % أذقتنا ودك حتى إذا % % قلنا لذيذ كدت أن تغلو % % 2(@)(@@) % خفت متى واصلت إملالنا % % فخف إذا هاجرت أن نسلو % % PageV01P4960 البحر : - 1(@)(@@) % سمتني جفوة فأظهرت سلوه % كل ذي جفوه حقيق بسلوه % 2(@)(@@) % قد سلونا إن كنت أعرضت عمدا % واعتقدنا الإعراض إن كان هفوه % % 3(@)(@@) % لاتجشم لي التخلق إن كن % ت ملولا إن التجشم شقوه % % PageV01P4961 البحر : - 1(@)(@@) % مغنية حقا بإسقاط نقطة % إذا ماشدت ظلت وأشداقها تلوى % % 2(@)(@@) % لها نكهة تحكي بها إن تكلمت % فأهدت إلى المشتم من ريحها الفسوى % % 3(@)(@@) % إذا شهدت للقوم في اللهو معرسا % غدا مأتما يمحو بأحزانه اللهوى % % 4(@)(@@) % وإن امرأ يقوى على لثم ثغرها % % على الضغط والتعذيب في قبره يقوى % % 5(@)(@@) % جفت هامة منها ودقق ساقها % % فماصلحت إلا لبنجقها ملوى % % PageV01P4962 البحر : - 1(@)(@@) % بادر غروس يديك بالسقيا % % وأغث بري قبل أن يذوى % % 2(@)(@@) % هذي صنائعك التي نطقت % بالشكر أخرسها عن الشكوى % % 3(@)(@@) % جاءتك تستعدي نداك على % % ريب الزمان فأعد بالجدوى % % 4(@)(@@) % أصبحت ذا نعمى علي فلا % % تك ملحقي بالعدوة القصوى % % 5(@)(@@) % فامنن بإنجاز لوعدك فال % % إنجاز فيه المن والسلوى % % 6(@)(@@) % وافكك من البلوى وثاق فتى % سلبته ثوب يساره البلوى % % PageV01P4963 البحر : - 1(@)(@@) % إن عبد القوي عبد قوي % في استه أخذ الكتاب بقوه % 2(@)(@@) % أشبه العالمين في أخذه الكت % % ب بيحيى النبي حاشا النبوه % % 3(@)(@@) % يكره الصوم والصلاة جميعا % ويرى الكفر والبغاء مروه % % PageV01P4964 البحر : - 1(@)(@@) % إذا ماشئت أن تعر % % ف يوما كذب الشهوه % 2(@)(@@) % فكل ماشئت يصددك % عن العذبة والحلوه % 3(@)(@@) % وطأ من شئت يصددك % عن الحسناء في الذروه % % 4(@)(@@) % وكم أسلاك ماتهوا % % ه نيل الشيء لم تهوه % PageV01P4965 البحر : - 1(@)(@@) % ما رأى الناس كابن هرثمة العا % % جز في فرط جبنه من شبيه % 2(@)(@@) % تفاحة في رأس سنبويه % تهواهما الحسناء عند الرويه % % 2(@)(@@) % عائذ دهره إذا سطع النقرجز تفاحة في رأس سنبويهتهواهما الحسناء عند الرويه % % ع بمعنى مصحف اسم أبيه % % PageV01P4966 البحر : - 1(@)(@@) % شهر نسك قرينه يوم لهو % % صار بعد البعاد مثل أخيه 
ms1313	 % 2(@)(@@) % ومن المنكر العجيب وفاق الضد % د ضدا منافرا ينفيه % % 3(@)(@@) % غير أن الأمير أصلح يبن الض % ضد لازال ضده يفديه % 4(@)(@@) % لم تزل ترشد الغوي من ال % أيام أفعاله الرشيدة فيه % % 5(@)(@@) % من صلاة ومن صيام ومن بذ % ل نوال ومن سدى يسديه % % 6(@)(@@) % وسوى ذاك من تقى الله حتى % % صار شهر الصيام لا يجتويه % % 7(@)(@@) % ولقد كان قبل ذلك ينفي % % ه فأضحى لرشده يجتبيه % % 8(@)(@@) % وعسى قائل يقول بجهل % قول حيران في ضلال وتيه % % 9(@)(@@) % أي صلح رأيته واتفاق % بين هذين يا أخا التمويه % % 10(@)(@@) % حاش لله بل هما في عناد % % غير مستبهم على مبصريه % % PageV01P4967 11(@)(@@) % شن هذا على الجلود من الما % % ء وهذا حماه من شاربيه % % 12(@)(@@) % إن هذين ماعلمت لضدا % % ن بعيدان عند ذي التشبيه % % 13(@)(@@) % فجوابي هناك للمجتديه % كجواب امرىء أخي تفويه % % 14(@)(@@) % لم يعاند أخ أخاه بأن خف % فف من ثقل محنة عن بنيه % % 15(@)(@@) % شن فيه على الجواد برودا % فأباخ الحرور عن صائميه % % 16(@)(@@) % وأمات الغليل منهم فأضحوا % % في نعيم به وفي ترفيه % % 17(@)(@@) % بل طهورا نفى به درن الآ % % ثام والسيئات عن مذنبيه % % 18(@)(@@) % وكذاك الذي حمى الماء لما % % يذهب المذهب الذي يعنيه % % 19(@)(@@) % من خلاف على أخيه ولكن % % رائض راض من يلي ويليه % % 20(@)(@@) % منع الماء والطعام ليحظوا % % بهما في ظلال عيش رفيه % % PageV01P4968 21(@)(@@) % وحماهم من المعاصي فأضحوا % % في عفاف به وفي تنزيه % % 22(@)(@@) % وبيمن الأمير أسعده الل % ه وأبقاه مرغما حاسديه % % 23(@)(@@) % وفق الله بين هذين حتى % % عاينا بالصلاح من يعنيه % % 24(@)(@@) % ولعا للأمير من عثرة الشك % و ونفسي وكل نفس تقيه % % 25(@)(@@) % محنة ضاعفت له الأجر في الصو % % م ويا رب خيرة في كريه % % PageV01P4969 البحر : - 1(@)(@@) % علي دين ثقيل أنت قاضيه % يامن يحملني ديني رجائيه % 2(@)(@@) % وقد حماني إخواني مواردهم % % ووكلتني إلى بحر سواقيه % % 3(@)(@@) % قالوا أنسقي من الطوفان مورده % % كما يقال لمولى أنت واليه % % 4(@)(@@) % وهل تنازعك المعروف في رجل % يد لتكفي أمرا أنت كافيه % % 5(@)(@@) % ماذاك قدر 
ms1314	 بني الدنيا وإن عظمت % أقدارهم غير مخصوص بحاشيه % % 6(@)(@@) % وما أحالوا على ضحل ولا ثمد % ولا تظنوا بغيب ظن تشبيه % % 7(@)(@@) % فلا تصعني وتجني لي إضاعتهم % إياي لاضاع أمر أنت راعيه % % 8(@)(@@) % يابن الوزيرين قد عمت صنائعكم % % غيري فقد ولهتني كل توليه % % 9(@)(@@) % لله موقع معروف أراه لكم % % نيلت أقاصيه واحتيزت أدانيه % 10(@)(@@) % كم من أناس رجوا بي ريع دولتكم % % حظوا وأوسعت حرمانا أشافيه % % PageV01P4970 11(@)(@@) % ومامن العدل أن يقضى نعيمهم % % ومصطلاي ببرح مبرح فيه % % 12(@)(@@) % لاتتركن وليا ذا محافظة % % ونار حسرة فوت الحظ تكويه % % 13(@)(@@) % لا تجعلنه كراجي الغيث أصعقه % وإنما أمل الإسقاء راجيه % % 14(@)(@@) % الحال مرهقة والنفس مشفقة % من دائها المتمادي أو تداويه % % 15(@)(@@) % وهو الإياس أو الإيناس من كثب % فلا تدعني من أمري في تيه % % PageV01P4971 البحر : - 1(@)(@@) % ياطول غلة نفسي المبلاه % بظباء بين أجارع وجلاه % 2(@)(@@) % من كل ريا لاتجود بشربة % وجنابها متدفق بمياه % % 3(@)(@@) % تضحي وتمسي يغب محبها % % ملهى كرى أو مأثم استنباه % % 4(@)(@@) % يحظى العميد بها ويسعد راقدا % ويظل عند النبه في إذلاه % % 5(@)(@@) % وأبى هواي لقد غدا مستفرها % أعداء عقلي أيما استفراه % % 6(@)(@@) % سقي الزمان إذا الحسان يصلنني % % وينلنني طوعا بلا إكراه % % 7(@)(@@) % وإذا المشيب شبيبة منضورة % وإذ المواعظ كلهن ملاه % % 8(@)(@@) % لا والذي لو شاء بدل صبوتي % % بلهى وطول صبابتي بتناه % % 9(@)(@@) % ماقيل إن مع السماك فضيلة % إلى تناولها عبيد الله % 10(@)(@@) % ملك حلا مخبوره ورواؤه % % فحلا على الأسماع والأفواه % % PageV01P4972 11(@)(@@) % عذب اللسان ولن تراه كليله % % عضب اللسان وليس بالعضاه % % 12(@)(@@) % ناهيك من صمت بلا عي به % % وكفاك من لسن بغير سفاه % % 13(@)(@@) % متيقظ أبدا لفعل كريمة % وعلى الطلاب لشكرها متساهي % % 14(@)(@@) % يهب الرغيب بشكره فعفاته % % متفاكهون وتلك حال فكاه % % 15(@)(@@) % لكنه مع ذلكم مستنزه % روض المحامد أيما استنزاه % % 16(@)(@@) % متظلل من طوله بحدائق % متمرس من حده بعضاه % % 17(@)(@@) % وكأن حبوته تلاث بشامخ % % ينحط عنه الصخر في دهداه % % 18(@)(@@) % ملكت سكينته عليه أمره % % فكأنه ساه وليس بساهي % % 19(@)(@@) % وعفا وعامل بالأناة عدوه % % فكأنه لاه 
ms1315	 وليس بلاهي % % 20(@)(@@) % ممن يراه الحق غبطة دولة % وسعود مملكة وفضل إله % % PageV01P4973 21(@)(@@) % فإذا الزمان غدا وراح معبسا % % فزمانه متضاحك متباه % % 22(@)(@@) % مازال يؤنسه جميل فعاله % % قدما ويوحشه من الأشباه % % 23(@)(@@) % تتعاور العرب الكرام وفارس % ذكراه بالبخباخ والبهباه % % 24(@)(@@) % شفع السماح إليه في سؤاله % % فمرى جداه لهم عريض الجاه % % 25(@)(@@) % يممه إنك منه بين مثوب % % بالمعطشين ومذود نداه % 26(@)(@@) % يشفي الصدى ويذود كل ملمة % عنا بحزم مفكر بداه % % 27(@)(@@) % قل للأمير حلت ليالي عمره % في غير منقطع ولا متناهي % % 28(@)(@@) % يامن أمر على الحلوق مذاقه % % وحلا وطاب لألسن وشفاه % % 29(@)(@@) % ليفز من الأمراء شاهنشاههم % بفتى من الوزراء شاهنشاه % % 30(@)(@@) % أضحى وماضاهاه خادم سيد % وكذاك مالك في الملوك مضاهي % % PageV01P4974 31(@)(@@) % انظر فإنك ناظر بجلية % هل في وزيرك عن وزيرك ناهي % % 32(@)(@@) % هل ملك الأعداء عند قيامه % % إلا تذلل آنف وجباه % % 33(@)(@@) % سجدوا ولو عندوا مكان سجودهم % لرماهم من كيده بدواهي % % 34(@)(@@) % إن الوزير إذا تأمل ناظر % لعتاد محتاط وتاج مباه % % 35(@)(@@) % نم كيف شئت فما البناء بخاشع % % كلا ولا أس البناء بواهي % % 36(@)(@@) % ظفرت يداك من الوزير بقيم % % تأتي نصيحته بلا استكراه % % 37(@)(@@) % أما ظهارته فسلطانية % وله بطانة مخبت أواه % % 38(@)(@@) % فاسدد يديك بخادم من شأنه % % عكس الرياء إذا تصنع داه % % 39(@)(@@) % نامت على الإنباه أعين معشر % ورعاك منتبها بلا إنباه % % 40(@)(@@) % ياصاحبي علا الوزير وأعصفت % % صعقاته بالنبح والوهواه % % PageV01P4975 41(@)(@@) % قوم على سنن الطريق وآذنا % في الصادرين وواردي الأمواه % % 42(@)(@@) % صان الوزارة أحمد عن معشر % خلقوا لكاسب القوت بالأستاه % % 43(@)(@@) % كانوا إذا قسطوا فأقسط واعظ % ظلوا هنالك منه في فهفاه % % 44(@)(@@) % صانته صائنة تكافيء سعيه % وزهته من شرف الفعال زواهي % % 45(@)(@@) % وجزت جوازي الخير صاحب أمره % % فهو النجاه أمام كل تجاه % % 46(@)(@@) % لا كابن بلبل الدعي وعصبة % عدموا خلال الخير غير هواه % % 47(@)(@@) % ياسائلي بابن اللبون وقد ثوى % % في النار تطهاه هناك طواهي % % 48(@)(@@) % كان المحين ذئب ردهة دهره % % ورجال دولته ذئاب رداه % 49(@)(@@) % ثم اعتدى فإذا هو ضيغم غابة % وزهاه 
ms1316	 من فرط الجهالة زاهي % % 50(@)(@@) % فعتا ويهيه في الكلام تعاربا % حتى كنيناه أبا اليهياه % % PageV01P4976 51(@)(@@) % متصامما متكامها عن ربه % % فرماه بالإصمام والإكماه % % 52(@)(@@) % غاب الموفق فاستراب بغيبه % وأتى فصادف منه مرجل طاهي % % 53(@)(@@) % ومعاند التقوى معد مغالة % لخلافة ووقاحة لو جاه % % 54(@)(@@) % قال الموفق إذ تبين غوله % % قسما لقد ساهيت غير مساهي % % 55(@)(@@) % وغدا أبو العباس يطلب ثأره % % فرمى الزمان مداهيا بدواهي % % 56(@)(@@) % كفء المخاتل والمبارز قسور % لاينثني للزجر والجهجاه % 57(@)(@@) % ركب الأمير قرا المحجة فاهتدى % % وطغى الدعي فتاه في أتواه % 58(@)(@@) % لا يعجبن أحد لخيبة وجهه % هل كان عبدا مقرنا بخذاه % % 59(@)(@@) % وجه كما للصالحين وما عنى % % للصالحين فشاه كل مشاه % % 60(@)(@@) % ولقد نهته لو أعين بنهيه % وحجى نواه بعدهن نواه % % PageV01P4977 61(@)(@@) % تجه الصنيعة والصنيعة حرة % فثنت أعنتها عن التجاه % % 62(@)(@@) % وأتت فتى ماسار سيرة تائه % في حفظ نعمته ولا تياه % % 63(@)(@@) % إن تائه جبه الوجوه ببشره % ولهى يديه فليس بالجباه % % 64(@)(@@) % وترشفته ولم تكن مكروهة % نكهات مسك عند ذي استنكاه % % 65(@)(@@) % كلأته نيته التي من سوسها % % صدق الكلاءة والقلوب سواهي % % 66(@)(@@) % ورعاه معروف يخامر نفسه % ويفيض عنها والنفوس لواهي % % PageV01P4978 البحر : - 1(@)(@@) % أضحى أبو الصقر وأفعاله % % كأنما تنتج من وجهه % 2(@)(@@) % عارض بالإحسان حسنا له % % لايبلغ الوصف مدى كنهه % % 3(@)(@@) % ليس له عيب سوى أنه % % لاتقع العين على شبهه % % 4(@)(@@) % يا واردا حوضا سوى حوضه % عد عن الغب إلى رفهه % % 5(@)(@@) % تلق فتى ترضى العلا فعله % % في عقب ما يأتي وفي بدهه % % 6(@)(@@) % تستضحك الآمال عن بشره % % وتذعر الأحداث عن نجهه % % 7(@)(@@) % لم تلهه عن سؤدد لذة % متى تغازل غيره تلهه % 8(@)(@@) % يقصر ما يعطيك في حلمه % % عن بعض مايعطيك في نبهه % 9(@)(@@) % يجبه بالآلاف سؤاله % % ياحبذا ذلك من جبهه % 10(@)(@@) % أكثر شكوى ضيفه أنه % % يغب بالبر على كرهه % PageV01P4979 البحر : - 1(@)(@@) % نزهة عندي كاسمها نزهه % لاشك في ذاك ولا شبهه % 2(@)(@@) % ياجاعل الليل لها طرة % وجاعل الصبح لها جبهه % 3(@)(@@) % وجاعل الدر لها مضحكا % وجاعل المسك لها نكهه % 4 
ms1317	(@)(@@) % دع حبها يحكم في مهجتي % % وأمره بالجور ولا تنهه % % PageV01P4980 البحر : - 1(@)(@@) % عين المحب إلى الحبيب سريعة % والعين تألف شخص من يهواها % % 2(@)(@@) % لاتجزعن من الصدود فإنما % % غرض المفدي أن يرى تياها % % 3(@)(@@) % حكما بأن النفس تبغي شكلها % % والشكل إلف لا يحب سواها % % PageV01P4981 البحر : - 1(@)(@@) % لو أن لي أختا فأنكحتها % % بني قضاة الأرض ماتهت % 2(@)(@@) % لأنني إن تهت في حيرتي % % بنائك أختي سفهت % 3(@)(@@) % يامن تحداني بتقصيره % % شبهت في عينيك شبهت % 4(@)(@@) % لهفي على شكريك فيمامضى % % طوعا كأني كنت أكرهت % % 5(@)(@@) % لو كنت نبهت لما قلته % % لكنني ماكنت نبهت % % PageV01P4982 البحر : - 1(@)(@@) % إن أبا حفص له % % هامة صدق نزهه % 2(@)(@@) % صنعها خالقها % % للصفع من كل جهه % % 3(@)(@@) % لو لم تجل فيها يدي % % يوما لظلت ولهه % % 4(@)(@@) % كأنها أمنية % أو حاجة متجهه % % 5(@)(@@) % تنزل فيها فترى % % صحاريا مشتبهه % % 6(@)(@@) % تظل كفي كلما % % نزلت فيها فكهه % % 7(@)(@@) % كأنما لمستها % % ثدي فتاة فرهه % % 8(@)(@@) % مالمت نفسا أصبحت % غرثى إليها شرهه % % 9(@)(@@) % تحلم في النوم بها % % بالليل بل منتبهه % % PageV01P4983 البحر : - 1(@)(@@) % ليعاقب وسمي جود وليه % من كريم رجا نداه وليه % 2(@)(@@) % إن تباطى لديه فالبر يزكو % % عنده أن يرى إليه مجيه % 3(@)(@@) % ياجواد إذا تأبى قريض % أسعد المادحين فيه أبيه % 4(@)(@@) % لايضع أمل لديك ولا يح % رم عطاء جزيلا وأنت سميه % % 5(@)(@@) % أنت زين لكل مدح وحلي % يتباهى به ويزهى رويه % PageV01P4984 البحر : - 1(@)(@@) % أبا حسن لم أمس من حال بالكم % وإن كنتم تمسون من حال باليا % % 2(@)(@@) % أتنسون من يرعى لكم كل ليلة % نجوم القوافي والنجوم التواليا % % 3(@)(@@) % تذيقوني حتى إذا ما تشوقت % مناي بدا لي منك ما بدا ليا % % 4(@)(@@) % فتذويق إشباع هذى الله سعيكم % وإلا فحسما يترك القلب ساليا % % 5(@)(@@) % أمبتورة عندي صنيعة كامل % وقد شهدت آراؤه بكماليا % % 6(@)(@@) % فتى زيد في الأخلاق والخلق بسطة % بأمثالها نال الرجال المعاليا % % 7(@)(@@) % أتم له الإحسان حسن روائه % وأضحى من الإحسان والحسن حاليا % % 8(@)(@@) % يقول لمن يلحاه في بذل ماله % أأنفق أيامي وأمسك ماليا % % 9(@)(@@) % نسبناه والقوم 
ms1318	 الكرام إلى العلى % % فكان صريحا والكرام مواليا % % 10(@)(@@) % لعمري لئن أضحى يسر زمانه % % سناء لقد ساء السنين الخواليا % % PageV01P4985 11(@)(@@) % ولم يخل من شوق إلى وجهه غد % فلا انصرف الأمس المودع تاليا % % 12(@)(@@) % فداه أناس أرخص الحمد بخلهم % % وأعلى عطاياهم فأضحت غواليا % % 13(@)(@@) % يجدون أثوابا وما يرتضونها % % ويرضون أعراضا رماما بواليا % % PageV01P4986 البحر : - 1(@)(@@) % رثت الأمانة للخيانة إذ رأت % بالشمس موقف أحمد بن علي % 2(@)(@@) % من ذا يؤمل للأمانة بعده % % لولي سلطان ثواب ولي % 3(@)(@@) % بدر ضحى للشمس يوما كاملا % فبكت هناك جلية لجلي % 4(@)(@@) % من يخل من جزع لضيعة حرمة % من مثله فالمجد غير خلي % 5(@)(@@) % ياشامتا أبدى الشماتة لاتزل % تصلى بمرمضة أشد صلي % % 6(@)(@@) % ستراك عيناه بمثل مقامه % وببعض ذاك يكون غير ملي % 7(@)(@@) % وقعت قوارع دهره بصفاته % % فتعللت عن مصدق سهلي % 8(@)(@@) % عن ذي الشهامة والصرامة والذي % % ماعيب قط بمذهب هزلي % % 9(@)(@@) % عن ذي المرارة والحلاوة والذي % % لم يؤت من خلق له مقلي % % 10(@)(@@) % وأبي الوزير بن الوزير أبى له % % إلا الحفاظ بمجده الأصلي % % PageV01P4987 11(@)(@@) % بل كاد من فرط الحمية أن يرى % % فيما تقلد رأي معتزلي % % 12(@)(@@) % وإذا أبو عيسى حمى متحرما % أضحى يحل بمعقل وعلي % % 13(@)(@@) % أبقى الإله لنا العلاء ممتعا % بعلائه القولي والفعلي % % 14(@)(@@) % فالله يعلم والبرية بعده % وكفى بعلم الواحد الأزلي % % 15(@)(@@) % ماضر دنيا كان فيها مثله % % ألا يحلى غيره بحلي % % 16(@)(@@) % ذو منظر صافي الجمال ومخبر % وافي الكمال ومنطق فصلي % % 17(@)(@@) % جمع الشبيبة والسداد فلم يبع % فوز الحكيم بلذة الغزلي % % PageV01P4988 البحر : - 1(@)(@@) % ومنزل الوحي علي نبيه % لأنزلن الشعر من حبيه % 2(@)(@@) % على الخزاعي وخطابيه % مدحا ترى الحكمة في صبيه % % 3(@)(@@) % ويونس الأسواق في عربيه % % وفي حضري الشعر أعرابيه % % 4(@)(@@) % ولا ومد الظل ولا وبيه % مكي بين المجد أخشبيه % % 5(@)(@@) % مهاجري النصر يثربيه % فرعي مجد بعد منصبيه % % 6(@)(@@) % سربي مرعى الوحش ربربيه % % بدري حسن الوجه كوكبيه % % 7(@)(@@) % مجالسي الشخص موكبيه % % فرزدقي الطرز أغلبيه % % 8(@)(@@) % ما شئت عجاجيه روبيه % لم يتقاصر عن مسيبيه % % 9(@)(@@) % ولا الزهيري ولا 
ms1319	 كعبيه % % بل الكليبي وتغلبيه % % 10(@)(@@) % موشي برد المدح شرعبيه % % سيفي وقع القدح نشابيه % % PageV01P4989 11(@)(@@) % كلاهما أذعن من سبيه % % بلملمي الحكم كبكبيه % 12(@)(@@) % غشمشمي السيل مأربيه % % سلميه أسعد من حربيه % % 13(@)(@@) % مسترجح العقل مهلبيه % % مفضل في العلم صقعبيه % % 14(@)(@@) % مقدم في النحو قطربيه % % رفعيه خفضيه نصبيه % % 15(@)(@@) % طريفه غير مودبيه % % تعليه عن رتبة مكتبيه % % 16(@)(@@) % مقفعي النثر عتابيه % % لامجتوي القرب ولا مابيه % 17(@)(@@) % لحق مولاه وأجنبيه % % ماشئت من مرأى ومن حبيه % % 18(@)(@@) % تجررا والدهر في غبيه % % جار من اللؤم على كلبيه % % 19(@)(@@) % ومن تعديه على ذئبيه % % ليجتني لي الصفو من مجنيه % % PageV01P4990 البحر : - 1(@)(@@) % أشهد مايكون على هجاء % هجيت به إذا عاقبت فيه % % 2(@)(@@) % وأبذأ ما تصادف من هجاء % % إذا وليت عفوك قاتليه % % 3(@)(@@) % ولا والله ما حبرت فيكم % % سوى مدح يزين لابسيه % % 4(@)(@@) % ففيم عددتم مدحي هجاء % وقد شجى القضاء بمنشديه % % 5(@)(@@) % فإن قلتم نراك أخا سفاه % فقد يقع السفيه على السفيه % % 6(@)(@@) % هجوت الظالمي ولست أهجو % % رئيسا أتقيه وأرتجيه % % 7(@)(@@) % أيهجو المرء من يضحي ويمسي % % وروح حياته فيما يليه % % 8(@)(@@) % شهدت بأن ذلك ليس حقا % ولا للحق أيضا بالشبيه % % 9(@)(@@) % دعوا أحدوثة حسنت يساري % % لكم أخواتها في كل تيه % % 10(@)(@@) % فإن الظلم من كل قبيح % وأقبح مايكون من النبيه % % PageV01P4991 11(@)(@@) % شفعت إليكم بالطول منكم % % وكم من شافع فيكم وجيه % % 12(@)(@@) % فردوني إلى ماكنت فيه % % من الإكرام والعيش الرفيه % % PageV01P4992 البحر : - 1(@)(@@) % ليس يستيقن العناية مشفو % % ع إليه حتى يذل عليها % % 2(@)(@@) % وليل العناية الحث والتح % ريك في الحاجة المشار إليها % % 3(@)(@@) % فتوخ الإعذار واعل عن التع % ذير لازلت للعلى ولديها % % 4(@)(@@) % وحقيق ألا تروع نفس % أعلقت في ذراك يوما يديها % % PageV01P4993 البحر : - 1(@)(@@) % أنا واش بسوء حالي إليكا % % طال تشنيعها برغمي عليكا % % 2(@)(@@) % كلما قلت فيك قولا جميلا % ناقضته وردعه في يديكا % % 3(@)(@@) % ولما ذاك بالعقاب ولكن % % بالثواب الذي يرجى لديكا % % 4(@)(@@) % قد تصرفت في نواح من الأر % ض فردتني النواحي إليكا % % PageV01P4994 البحر : - 1(@)(@@) % سبيلي إليك كتابي إليكا % % فلا تقطعن سبيلي إليكا 
ms1320	 % % 2(@)(@@) % أعيذك بالله من علة % يسد بها باب جدوى يديكا % % 3(@)(@@) % فأوص خليفتك المرتضى % % بكتبي وعرفه حالي لديكا % % 4(@)(@@) % ولولا احتراسي من المنسيا % % ت كفاني الكتاب اعتمادي عليكا % % PageV01P4995 البحر : - 1(@)(@@) % قد ذقت أنواع الطعوم فلم أجد % فيهن طعما مثل طعم العافيه % 2(@)(@@) % فاقصد وحاذر أن تمرر حلوه % مما تصيب وأن تكدر صافيه % % 3(@)(@@) % لا تشفين غليل صدرك بالتي % % تدوي فليست للغليل بشافيه % 4(@)(@@) % ومتى شرهت فإن أيسر لدة % % لك إن نظرت مع السلامة كافيه % 5(@)(@@) % فإذا جرت ريح فطاب نسيمها % % فاعدل مخافة يوم ريح سافيه % % 6(@)(@@) % أحسن فلرب يد لديك حقيرة % مهدت لحينك والمضاجع جافيه % % 7(@)(@@) % واعلم بأن يدا تقدم نفعها % % أجدى عليك من اليد المتلافيه % % 8(@)(@@) % وافزع إلى شورى الرجال فإنها % % أفساد رأيك حسن يفسد نافيه % % 9(@)(@@) % لا ترضين برأي نفسك وحدها % % فلرب خافية عليك وخافيه % % PageV01P4996 البحر : - 1(@)(@@) % إذا جددت نعمة لامرىء % % فتكميلها جدة العافية % 2(@)(@@) % وبالشكر قدر تجديدها % % ولله بعد يد شافيه % % 3(@)(@@) % ولو صفيت كان أصفى لها % % ولكن دنيا الفتى جافيه % % 4(@)(@@) % ولولا مكدرة رنقة % لما قدرت قدرها صافيه % % 5(@)(@@) % ولابد للمرء من محنة % لفتنة نعمائه نافيه % % 6(@)(@@) % ودولتكم قدجرت ريحها % % مسددة الجري لا هافيه % % 7(@)(@@) % ولابد للريح من أن تكو % % ن في بعض هباتها سافيه % % 8(@)(@@) % فصبرا وعافية غضة % وأمنا إلى مئة وافيه % % 9(@)(@@) % فداكم من السوء ضد لكم % % مخازيه بادية خافيه % % 10(@)(@@) % وليست بعالية حاله % % ولكنها جيفة طافيه % % PageV01P4997 11(@)(@@) % ولولا كراهة إملالكم % % خطبت إلى آخر القافيه % % PageV01P4998 البحر : - 1(@)(@@) % لعا من عاثر لك يابن يحيى % % يموت الكاشحون وأنت تحيا % % 2(@)(@@) % على أن الممات لكل حي % وقيت به من الحدثان محيا % % PageV01P4999 البحر : - 1(@)(@@) % قد طال بسطك آمالي قد ملأت % عرض الفضاء فخل الرفد يطويها % % 2(@)(@@) % خل الأمور بكفيه إذا اضطربت % فهن إذ ذاك قوس وهو باريها % % PageV01P5000 البحر : - 1(@)(@@) % ياقاصدا ليد جلت أياديها % % وذاق طعم الردى والبؤس شافيها % % 2(@)(@@) % يد الندى هي فارفق لاترق دمها % % فإن أرزاق طلاب الندى فيها % % PageV01P5001 البحر : - 1(@)(@@) % أرى ابن حريث لا يبالي عضيهتي 