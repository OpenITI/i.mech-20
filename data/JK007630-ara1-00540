ms521	 % 40(@)(@@) % وفتى من الأزد اغتمزت قناته % % لدنا فمال هواه حيث يميل % PageV01P1614 41(@)(@@) % أوليته في عنفوان شبابه % % خير الذي يولي الشباب كهول % 42(@)(@@) % فتركته وإذا سخطت أخا سلا % % أرضتك منه زفرة وغليل % 43(@)(@@) % وليعطينك حق سبقك قاضيا % % دين الوفاء ودينه ممطول % 44(@)(@@) % منى أخ إن ينأ عنك ولاده % % فوداده بك لاصق موصول % 45(@)(@@) % أسيان طابت نفسه لك بالفدى % % عن نفسه لو أنه مقبول % 46(@)(@@) % عقل السلو من العيون وإن لي % % عينا عليك وكاؤها محلول % 47(@)(@@) % تجد الدموع المقذيات جلاءها % % حتى كأن الدمع فيها الميل % 48(@)(@@) % قد صرحت بضميرها الدنيا لنا % % طلبا لفطنتنا ونحن غفول % 49(@)(@@) % ما ذا المطال لمقتض إملاؤه % % عجل وموعد صبره تعليل % 50(@)(@@) % ويسوءني جذلى بعاجل وقفة % عند اليقين بما إليه يؤول % % PageV01P1615 51(@)(@@) % أعمى وقد أبصرت كم من غائب % ما بعد رحلته إلي قفول % 52(@)(@@) % وأخ سبيلي في الحياة سبيله % % ملقى إلي وما إليه سبيل % 53(@)(@@) % أحثو عيونا بالتراب يروعني % % بالأمس فيها الإثمد المكحول % 54(@)(@@) % وأظل أسمح للصعيد بأوجه % قلبي بهن على الشحوب بخيل % 55(@)(@@) % بكرت على الزوراء من شرقيها % % سحماء خضراء الفعال هطول % 56(@)(@@) % ملء الشنان إذا أظلت ساحة % ألقت فراع فؤادها التحويل % 57(@)(@@) % تسقى أبا نصر ثراك حمية % للفضل إن ذم الحيا المفضول % 58(@)(@@) % وإذا احتشمت فلم أزر عرصاته % إذ هن بعد الخصب منك محول % 59(@)(@@) % وتشوقني آثار دارك ان أرى % % منها مغاني الفضل وهي طلول % 60(@)(@@) % قالوا طويل العمر قلت لذاكم % حزني عليه كما ترون طويل % PageV01P1616 61(@)(@@) % كثرت فضائله بقدر بقائه % % وقليل فضل من مداه قليل % 62(@)(@@) % أكل الزمان جماله شرها فلا % % شبع الزمان وشلوك المأكول % PageV01P1617 البحر : - 1(@)(@@) % دع بين جلدى والعظام مكانا % % يسع الغرام ويحمل الأحزانا % % 2(@)(@@) % واستبق طرفي ربما غلط الكرى % % بطروقه فسلكته وسنانا % % 3(@)(@@) % ما كان ما حمل الوشاة نصيحة % ممن يوثق ناقلا بهتانا % % 4(@)(@@) % عذلوك في فغيروك سريرة % ورأيت شيبا فاستحلت عيانا % % 5(@)(@@) % عذل يرى عدلا وجور ذوائب % سموه لي عزا فجر هوانا % % 6(@)(@@) % ما غيرت بالشيب لونا لمتي % % حتى تغير صاحبي 
ms522	 ألوانا % % 7(@)(@@) % بيضاء سودت الصحيفة عنده % % واستعجلته بوصلها الهجرانا % % 8(@)(@@) % إن يجتنب منها الهشيم مصوحا % % فبما اجتنى ريعانها ريحانا % % 9(@)(@@) % يا من يعير في الكرى ويلذه % لله أجفانا له أجفانا % % 10(@)(@@) % إن الذين نسوا برامة عهدنا % % سعدوا وأشقانا به أوفانا % % PageV01P1618 11(@)(@@) % ظعنوا فشبت وما كبرت وإنما % % راح الشباب يشيع الأظعانا % % 12(@)(@@) % أجد الديار كما عهدت وإنما % % شكواي أنى أفقد الجيرانا % % 13(@)(@@) % يا تاركي أنسى العناق فراقه % % أشكو إليك الريح والأغصانا % % 14(@)(@@) % لان الصفا يوم الوداع لرحمتي % % لو أن قلب الوادعية لانا % % 15(@)(@@) % يا وحدتي ما أكثر الإخوانا % % نظرا وأكثر فيهم الخوانا % % 16(@)(@@) % في كل مطرح لحظة حولي أخ % صفو إذا هز الغنى الأفنانا % % 17(@)(@@) % راع معي إبلي فإن هي أعجفت % إبلي تقلب أو يعدن سمانا % % 18(@)(@@) % إن عضني ريب الزمان أعانه % % وتراه يأبى ما أصبت زمانا % % 19(@)(@@) % أشريه في خفض المعيشة غاليا % % ويبيعني في ضنكها مجانا % % 20(@)(@@) % ألقاهم عدد الكواكب كثرة % حولي وألقى وحدي الحدثانا % % PageV01P1619 21(@)(@@) % كفر وكن مستثنيا إلا إذا % % أقسمت أنك لا ترى إنسانا % % 22(@)(@@) % كم أسمع الصم البلاغة مفهما % % وأرى عجائب فضلي العميانا % % 23(@)(@@) % فأن الزمان صحا وصح بواحد % فبطول حملي جهله سكرانا % % 24(@)(@@) % ولئن وجدت من المحاسن عينها % % فبفرط ركضي أطلب الأعيانا % % 25(@)(@@) % يفديك ضاغنة عليك ضلوعه % حسدا يغادر ماءها نيرانا % % 26(@)(@@) % حيران راشك منبتاك وحصه % % خور العروق ففته طيرانا % % 27(@)(@@) % أمسى الأذل بأرضه وبرغمه % % وعززت أنت بهجرك الأوطانا % % 28(@)(@@) % لم يستشرك لها وظن برأيه % % خيرا فخاب عن الشيار وخانا % % 29(@)(@@) % ومن العجائب أن يشلك قارحا % % عنها ويرجو ضمها قرحانا % % 30(@)(@@) % لا نام بعدك إن حلا نوم له % % طرف يفارق فضلك اليقظانا % % PageV01P1620 31(@)(@@) % وعلى التقارب والنوى فتملني % % خلا تسربه دنا أو بانا % % 32(@)(@@) % ترضاه ما شهد الندي وما خلا % % ودا وحمدانية ولسانا % % 33(@)(@@) % ممن يكون أشف عندك كلما اس % % تشففته وكشفت عنه بيانا % % 34(@)(@@) % إن أعجبتك اليوم منه خلة % أوفت خلال غد وبن حسانا % % 35(@)(@@) % واسمع لها عذراء بكرا كلما % % خطبت لديك فأردفتك عوانا % % 36(@)(@@) % هي 
ms523	 نفثة السحر التي قد أرخت الس % % ادات مثلك لي بها الأرسانا % % 37(@)(@@) % مما شريت هوى الملوك بمثله % % قدما فصاروا لي به إخوانا % % 38(@)(@@) % صيرتها ثمنا لمثلك إنني % % أبدا أغالي دونها الأثمانا % % 39(@)(@@) % وصداقها المقبوض وصلك أختها % % بعرى الوزير وزفها حملانا % % 40(@)(@@) % وجلاؤها في معرض الوصف الذي % % يجلو لها الأبصار والآذانا % % PageV01P1621 41(@)(@@) % فلرب مجلو مغطى حسنه % تجنيه بآستحسانك الإحسانا % % 42(@)(@@) % أختان فاحفظني بجهدك فيهما % % بكريم سوقهما لي الأحيانا % % 43(@)(@@) % بلغه أن الفضل في المعنى وإن % % أسموا فلانا عنده وفلانا % % 44(@)(@@) % فلعل يمنك أن يغادرني بها % % بعد الأسى مستبشرا جذلانا % % 45(@)(@@) % لولا أمانتك التي اشتهرت إذا اس % % تودعت سرا أو ضمنت ضمانا % % 46(@)(@@) % ما كنت أسمح أن أوليها أبا % % تلقى نظائر عنده أقرانا % % 47(@)(@@) % ولخفت غيرتهن في تنفيرها % % والحزم ألا آمن الغيرانا % % PageV01P1622 البحر : - 1(@)(@@) % تعالين نعالج نف % % رة الحي تعالينا % % 2(@)(@@) % نزود أذنا شكوى % % ونودع نظرة عينا % % 3(@)(@@) % ونبكي من يد البين % % عسانا نعطف البينا % % 4(@)(@@) % فما زاد النوى إلا % % لجاجا ما تباكينا % % 5(@)(@@) % أعقبان بهم طرن % % أم العيس تبارينا % % 6(@)(@@) % طوين البعد يكتمن ال % % وجى حتى تطوينا % % 7(@)(@@) % إلى أين أما تأل % % م يا سائقها الأينا % % 8(@)(@@) % إذا عرست بالجرعا % % ء وسطا بين ما بينا % % 9(@)(@@) % فحيا الله يبرين % وغير الرمل حيينا % % 10(@)(@@) % وما لي وأخي المسع % % د رد الله لبينا % % PageV01P1623 11(@)(@@) % وقفنا نقتضي النائ % % ل من يمطلنا الدينا % % 12(@)(@@) % ونشكو بارد الصدر % إذا استقدح قلبينا % % 13(@)(@@) % أيا عرب أليس الغد % % ر في دينكم شينا % % 14(@)(@@) % أحقا تستقيدون % % من الفرس بنفسينا % % 15(@)(@@) % كم الثأر أما ينسى % % دم بين قبيلينا % % 16(@)(@@) % ولمياء حذرناها % % فساق القدر الحينا % % 17(@)(@@) % فكم ضمت يد الليل ال % % منى تحت إزارينا % % 18(@)(@@) % إذا ما بدر الصبح % حسبناهن يسعينا % % 19(@)(@@) % جعلنا أعين الشهب % على شمس الضحى عينا % % 20(@)(@@) % ألا لله صدقي وال % % هوى يوسعني مينا % % PageV01P1624 21(@)(@@) % وصبري وأخي شوب % إذا قلت تصافينا % % 22(@)(@@) % أولي هجمة السود % % ذئابا يتعاوينا % % 23(@)(@@) % وأرعى ساهرا منهم % % عيونا ليس يرعينا % % 24(@)(@@) % ولو صح وفاء 
ms524	 لم % % يصب سيف وغى قينا % % 25(@)(@@) % ولله ابن أيوب % % إذا عد أخ زينا % % 26(@)(@@) % ودبت نائبات الده % % ر حيات تلوينا % % 27(@)(@@) % وعضت بضروس الجد % % بأعوام توالينا % % 28(@)(@@) % طلبنا لأبي طال % % ب مثلا فتغنينا % % 29(@)(@@) % ووحدناه في العد % فما والله تثنينا % % 30(@)(@@) % كريم ما توافقنا الس % % جايا أو تنافينا % % PageV01P1625 31(@)(@@) % رأيت الجانب الصعب % به والخلق اللينا % % 32(@)(@@) % من القوم المناجيز % إذا ما السحب منينا % % 33(@)(@@) % رأت أنفسهم قاصي % % ة المجد فأجرينا % % 34(@)(@@) % فلله نفوس بال % % معالي يتواصينا % % 35(@)(@@) % تخطتك يد الدهر % إذا الأحداث أصمينا % % 36(@)(@@) % وطاولت الليالي العم % % ر تبقى لي ويفنينا % % 37(@)(@@) % مدى الأعياد ما يفطر % % ن عيدا ويضحينا % % 38(@)(@@) % ترى فيك أماني ال % % حسان ما تمنينا % % PageV01P1626 البحر : - 1(@)(@@) % حسبوا العلا خفا وكن ثقالا % % فتكلفوها ظالعين هزالا % % 2(@)(@@) % جبناء شدوا الحزم لسن وثائقا % % فيها ومدوا البوع لسن طوالا % % 3(@)(@@) % لم يعقدوا للرأي فيها حبوة % يوما ولا اقتسموا عليها فالا % % 4(@)(@@) % فتطلعوا هجناء من أطرافها % % فخر الشواحج تنسب الأخوالا % % 5(@)(@@) % وسعى النجيب مقدما بشياتها % % عنقا وجسما تحتها وجمالا % % 6(@)(@@) % يقظان يستلب الكرى من عينه % % أنف حماه أن يرى الأمثالا % % 7(@)(@@) % فخرا بني عبد الرحيم بأنكم % % كنتم قبيلا للحسين وآلا % % 8(@)(@@) % ما زال حتى أوطئت أعقابكم % % قمم العدا وعددتم أقيالا % % 9(@)(@@) % فإذا توضح يوم أمر مشكل % % يتوزع الأقوال والأعمالا % % 10(@)(@@) % لقي الورى جبناء عن أقلامه % % وسيوفه ولقيتموه رجالا % % PageV01P1627 11(@)(@@) % يلوى لنصركم المخاوف وحده % % صلب الحصاة ويركب الأهوالا % % 12(@)(@@) % ما خيرت بين اثنتين ركابه % % إلا تخير منهما الترحالا % % 13(@)(@@) % لا يمنع البطل المشهر نفسه % % حتى يهب فيقنص الأبطالا % % 14(@)(@@) % والأسد لم تظفر بحاج أكفها % % حتى تجوب وتهجر الأغيالا % % 15(@)(@@) % كم يوم بين قد حمدنا آجلا % % منه ونحن نذمه استعجالا % % 16(@)(@@) % نجني الإياب الحلو من شجراته % % ثمرا ونسكن آمنين ظلالا % % 17(@)(@@) % كاليوم رد كرى وشد سواعدا % % وأعاش أفئدة وراش نبالا % % 18(@)(@@) % طلعت سعودك صارفات شمسه % % عنا ببدر غاب أمس هلالا % % 19(@)(@@) % وسط السماء وعاد غاية تمه % فأضاء لا كلفا ولا ميالا % % 20(@)(@@) % دل الملوك 
ms525	 عليك كونك رشدة % لهم وكون العالمين ضلالا % % PageV01P1628 21(@)(@@) % قد جربوا فرأوك أثقب منهم % زندا وأرجح فيهم مثقالا % % 22(@)(@@) % وإذا هم وجدوا السيوف قصيرة % في موطن وجدوا خطاك طوالا % % 23(@)(@@) % وسقيمة الأعضاء وكل طبها % % بك مذ تفاقم داؤها إعضالا % % 24(@)(@@) % ناطوا بها وقد التوت منشورة % من حسن رأيك ساعدا وقبالا % % 25(@)(@@) % وقليلة الخطاب عند نشوزها % % إن تستطيع لها الرجال بعالا % % 26(@)(@@) % لا يطمع الكفء الشريف بسعيه % % فيها ولو ساق المهور وغالى % % 27(@)(@@) % ما أبصرت جيبا يجاب لها ولا % % ذيلا على غير الملوك مذالا % % 28(@)(@@) % أعطيت عذرتها فكنت أبا لها % % عفت الحرام وقد أخذت حلالا % % 29(@)(@@) % أشعرت منها منكبيك خميلة % ما ضرها حبس السماء بلالا % % 30(@)(@@) % وسم الصوانع صدرها ومتونها % % وسم الطوابع رقة وصقالا % % PageV01P1629 31(@)(@@) % لا تثبت العينان فيها لحظة % إلا اختطاف الشمس تنصف آلا % % 32(@)(@@) % ما إن ملأت بها النواظر شارة % حتى ملأت بها القلوب جلالا % % 33(@)(@@) % مستبطنا من تحتها شفافة % جسما يخال من النحول خلالا % % 34(@)(@@) % وملوثة ما جربت من قبلها % % خرق العمائم تعصب الأجبالا % % 35(@)(@@) % أخذت من التاج النضار وزادها % % فخرا عليه لينها وجمالا % % 36(@)(@@) % جلت بأن لويت عليك وأنها % % من دقة حق يظن محالا % % 37(@)(@@) % ومقابل الأبوين ينسج عرقه % % عما إلى متن الوجيه وخالا % % 38(@)(@@) % مما يفدى بالبنين وتصطفى % % أزر البنات براقعا وجلالا % % 39(@)(@@) % ويحل بيع العرس وهو محرم % % يعتد في الفقر المبرح مالا % % 40(@)(@@) % فتق الغزالة غرة في وجهه % % وجرى الطراد به فكان غزالا % % PageV01P1630 41(@)(@@) % وضفا على مجرى العنان بعنقه % % قنوان قد ثقلا عليه فمالا % % 42(@)(@@) % ووراءه ذيل العروس حمى إذا ال % % أذناب أسلم بعضها الأكفالا % % 43(@)(@@) % يدجو فينظر من سراجى راهب % % فتلت شفارهما فكن ذبالا % % 44(@)(@@) % كالطود أتلع هاديا ورديفه % % حتى إذا اشتد انطوى فانهالا % % 45(@)(@@) % يسم الصخور فليس يبرح مطلعا % في كل واضحة أصاب هلالا % % 46(@)(@@) % يزهى بحق إن زهى متعطلا % % عريان يجلو نفسه واختالا % % 47(@)(@@) % فتراه كيف نظرته متحليا % % غرر الكواكب جامعا رئبالا % % 48(@)(@@) % سلب الثريا خده وعذاره % % وتوشح الشعرى وشاحا جالا % % 49(@)(@@) % وكأنما 
ms526	 الجوزاء تردف سرجه % % وتطول رسغيه إذا ما طالا % % 50(@)(@@) % أركبته وجنبت آخر مثله % % سهمى مصيب قارباك منالا % % PageV01P1631 51(@)(@@) % أعطاهما عن نية من صدره % % لا مكرها أعطى ولا مغتالا % % 52(@)(@@) % والأبيض الماضي وأخت الدرع مح % % مولين وابن الأسمر العسالا % % 53(@)(@@) % هذا تصيب إذا ركبت به وذا % % وزر يقيك إذا أردت نزالا % % 54(@)(@@) % نعم عوارف أين منك محلها % % ويقعن عند معاشر جهالا % % 55(@)(@@) % كانت تميل إليك عوج رقابها % % فالآن قمن سوية أعدالا % % 56(@)(@@) % متحدثات أنهن لقائح % ينتجن أضعافا لهاأمثالا % % 57(@)(@@) % جرى الأتي توسم الوادي به % % خيطا فخيطا ثم مد فسالا % % 58(@)(@@) % حتى ثنيت بحيث طول باعه % % حبل الرجاء ووسع الآمالا % % 59(@)(@@) % حسد الحسود فما عدا أنيابه % % نكتا عليك وقلبه بلبالا % % 60(@)(@@) % أسهرته ورقدت عن أشغاله % % بعض الفراغ يكثر الأشغالا % % PageV01P1632 61(@)(@@) % أبلغ بحظك قدر حقك تقسم ال % % أرزاق بين الناس والآجالا % % 62(@)(@@) % وامدد يمينك لي أقبل ظهرها % % فلعلها تعديني الإقبالا % % 63(@)(@@) % أنا من سمعت له وتسمع آنفا % % غررا رشاقا في الكلام جزالا % % 64(@)(@@) % عبقت بها أعراضكم منشورة % عبق الخزامى باكرته شمالا % % 65(@)(@@) % ما اجتزن بالآذان كن مفاتحا % % وعلى قلوب عداكم أقفالا % % 66(@)(@@) % تقتص وهي مقيمة أخباركم % % وتسير ترسل فيكم الأمثالا % % 67(@)(@@) % تلهى الحليم فتستقل وقاره % % وتجر حبل عرامه البطالا % % 68(@)(@@) % ما فقت فيها الناس فضل إصابة % ما شئت حتى فقتم أفضالا % % 69(@)(@@) % ساقيتني عنها الجزاء مودة % بيضاء صافية وزدت نوالا % % 70(@)(@@) % فحلفت لا أبصرت مثلي قائلا % % أبدا ومثلك فاعلا ما قالا % % PageV01P1633 71(@)(@@) % لا كالمخادع بشره عن لؤمه % % إن سر قول منها ساء فعالا % % 72(@)(@@) % ضحك كنار أبى الحباحب خدعة % % لا جذوة تعطى ولا إشعالا % % 73(@)(@@) % أوفى بنار أعجبته وما درى % % جهلا أيوقد مندلا أم ضالا % % 74(@)(@@) % يعطى على الغرض الخبيث وبخله % % عند الحقوق ويعذل البخالا % % 75(@)(@@) % داجاني الكلم العذاب وكدني % % وعدا تحنظل طعمه ومطالا % % 76(@)(@@) % وأرادني أن يستدر شفاعة % رزقي وآخذ ما لديه سؤالا % % 77(@)(@@) % هيهات إعدتني إذن أخلاقه % % سفها وكنت على الرجال عيالا % % 78(@)(@@) % ولقد نصحت له لو أن مكلفا % بالعجب أرعى 
ms527	 سمعه العذالا % % 79(@)(@@) % قلت انتهز بصنيعة إمكانها % % إن الزمان يحول الأحوالا % % 80(@)(@@) % لو كان بقي الشكر سر عطائه % % فمضى وبقى السوءة الأقوالا % % PageV01P1634 81(@)(@@) % جمح الغرور به فمتر برأسه % % فكأنه بالأمس ظل زالا % % 82(@)(@@) % بكرت عليك وروحت بقصائدي % % سحب الثناء مجدة إسبالا % % 83(@)(@@) % تجري التهانئ ماءها وهواءها % % عطر النسيم وباردا سلسالا % % 84(@)(@@) % ينبتن عرضك زهرة موشية % تبقى وأرضك روضة محلالا % % 85(@)(@@) % يمزجن إذ كارا بمدح شاكر % والماء يصلح مزجه الجريالا % % 86(@)(@@) % زدني كما قد زدت يزدد حسنها % % إن المكارم تبعث الأقوالا % % 87(@)(@@) % حتى تفوت الناس جدا صاعدا % وأفوتهم بندى يمينك حالا % % PageV01P1635 البحر : - 1(@)(@@) % أيا صاحبي بالخيف حييت مغضبا % نفرت ولكني نظرت لحيني % % 2(@)(@@) % رميت وسهم ربما مر خاطئا % % بسهمين من قارية نضلين % 3(@)(@@) % فإما ترى جرحي وتجهل طبه % % فخذ علمه من طبية العلمين % % 4(@)(@@) % فسل وتعجب كيف تعيا ببردها % % وتحمل مع ثقل الأمانة ديني % % 5(@)(@@) % أمالكة حلمي وتاركة دمي % % بغبني من قلبي يفيض وعيني % % 6(@)(@@) % هبي ذنب قلبي أنه يوم بينكم % % شكاك لوجد أو لروعة بين % 7(@)(@@) % فما بال عيني عوقبت وهي التي % % سعت بينكم حتى عشقت وبيني % % PageV01P1636 البحر : - 1(@)(@@) % بكرت عليه ضلة تعذلينه % متى كان دين الغدر قبلك دينه % 2(@)(@@) % ترى عينه وجها صديقا من الهوى % % ويلقى عدو السمع ما تأمرينه % 3(@)(@@) % أبى غير قلبي وابتغي السر مودع % أبى الله إلا أن أكون أمينه % 4(@)(@@) % مشى يومسلع للوداع فهل درى % % أراك بسلع فيم حنى غصونه % 5(@)(@@) % أذات الرضاب العذب هل من قضية % سوى المطل في الدين الذي تعدينه % 6(@)(@@) % وهل من عطاء والندى الغمر فيكم % لذى عسرة لم يعط ما تمنعينه % 7(@)(@@) % يعد نعيما ما تمنى وغبطة % بأن يرد الماء الذي تردينه % 8(@)(@@) % أداري بجمع طرف عين قضى البكا % % عليه انتشارا أن طوى البين عينه % 9(@)(@@) % وهبني أضم بالرداء دموعه % فمن ذا يضم بالرقاد جفونه % 10(@)(@@) % أحباي والوادي يسيل بأهله % % أما من يد في موقف تقفونه % PageV01P1637 11(@)(@@) % نفستم بلبنى واقتراحي كله % % حديث بلبنى أعلقتني شجونه % 12(@)(@@) % أمن حاجة في الدهر 
ms528	 ظوهر تم بها % % قلبتم ظهور الغدر لي وبطونه % 13(@)(@@) % عقدت بكم حبلي وإني لعالم % بأن الذي أبرمته تنقضونه % 14(@)(@@) % وكيف نزن بالغباوة فيكم % فنجزيكم صعب الزمان ولينه % 15(@)(@@) % ولكنكم ماء الطريق كددته % على برضه لما عدمت معينه % 16(@)(@@) % لبستكم بعد ابن عيسى ضرورة % وما جل لبس المرء حتى يزينه % 17(@)(@@) % تعوضتكم عنه تعلل مدنف % إذا خانه البرء استغاث أنينه % 18(@)(@@) % وفارقت منهيوم فارقت باذلا % % فؤادا برغم الجسم ألا يصونه % 19(@)(@@) % ولما رأيت السير دوني يصده % ولا دفع في صدر النوى لي دونه % 20(@)(@@) % حملت عليه الصبر مستقبحا له % % ويحمله قوم ويستجملونه % PageV01P1638 21(@)(@@) % أسائل قلبي كيف كان اشتياقه % % يميل حمام الدوح لي وحنينه % 22(@)(@@) % رعيت الفراق حلوه وهشيمه % وأورد كرها ملحه وأجونه % 23(@)(@@) % فإن غادرت أمسي نحولا صروفه % % فلليوم حتى أستعيد سمينه % 24(@)(@@) % ويستصعب الأمر الفتى من صدوره % % فتقضي له الأعجاز أن يستهينه % 25(@)(@@) % تبدلت من حر الأسى ونفوره % % على كبدي برد الغني وسكونه % 26(@)(@@) % وكنت مروعا من ذئاب تنوشني % % فأمنا فقد عاد الهزبر عرينه % 27(@)(@@) % بنفسيعلى قرب المزار وبعده % % فتى لم أكن بالشوق إلا ضمينه % 28(@)(@@) % وزاد بعيني قرة مذ وجدته % كهم المنى أنى عدمت قرينه % 29(@)(@@) % تردد في سر الوزارة ماجد % نسيب نفى العرق العتيق هجينه % 30(@)(@@) % إذا حقت الآمال ود عدوه % % على ما طوى من بغضه أن يكونه % PageV01P1639 31(@)(@@) % يضيق اتساع الدست عن ضم حلمه % وفي العين شخص دق أن يستبينه % 32(@)(@@) % إذا هز أبناء الوغى ذبل القنا % % خفافا إلى الضيم الذي يدفعونه % 33(@)(@@) % يدوسون ظهر الخطب خيفت وعوره % يسوقون أبكار الكلام وعونه % % 34(@)(@@) % فإنك من ملكته الود مرخصا % % فلم أك مع إرخاص بيعي غبينه % 35(@)(@@) % وأقسمتأني قد ظفرت ببغيتي % % لك الله من خل صدقت يمينه % 36(@)(@@) % وعندي لك المستغنيات بنشرها % % عن الطيب يكفين العلا ما ولينه % 37(@)(@@) % يجبن الملا حتى يخضن بحوره % بأحمالهن أويلجن حصونه % 38(@)(@@) % إذا وسمت بالعز عرضك ألبست % عدوك ذلا عم وسما جبينه % 39(@)(@@) % تخيلت عقل الدهر لي مذ كفلتني % % وأغفلتني شيئا فجن جنونه 
ms529	 % 40(@)(@@) % وحسبك عتب المهرجان شهادة % إذا كنت في النيروز تقضى ديونه % PageV01P1640 البحر : - 1(@)(@@) % آنسة لا تكتم القول الحسن % ولا تبالي أي سريها علن % 2(@)(@@) % طيبة المئزر رسل كلها % % سوى الحديث المشتهى بها بطن % 3(@)(@@) % لا تنكر الليلة من ضجيعها % % مع ريب الليل ومنها ما يجن % 4(@)(@@) % طرقتها والبدر يشكو وجهها % % والنجم يحكي قرطها لولا الأذن % 5(@)(@@) % فاستيقظت تعثر في لسانها % % ما علقت منه فضالات الوسن % 6(@)(@@) % تقول من وإنها عالمة % لولا اتباع عادة أني من % 7(@)(@@) % والرقباء أعين وألسن % قيدها خيط الكرى عني وعن % 8(@)(@@) % فكان ما أرضى العفاف كله % % وبعض ما أرضى الغرام لم يكن % 9(@)(@@) % معاتب نشر الصبا وبلغ % من التشاكي كسقاطات المزن % 10(@)(@@) % والنظرة الخلسة والقبلة لا % % تدري وراء الشفتين ما بطن % PageV01P1641 11(@)(@@) % وفي الحديث ذي الشجون بيننا % % ذكر الكرام كيف قلوا في الزمن % 12(@)(@@) % وضيعة الفضل وضعف أهله % % وكيف قد مات الوفاء ودفن % 13(@)(@@) % فلم نجد غير ابن أيوب فتى % لما تريد المكرمات قد فطن % 14(@)(@@) % ما نطفة تبرد في قرارة % تمسحها كف الصبا من الدرن % 15(@)(@@) % ما طرقتها شفة ولا يد % ما ودع السحاب فيها ما خزن % 16(@)(@@) % بنجوة عن القذى يحوطها % % حسا أصاب مسرقا على الفنن % 17(@)(@@) % أطيب من أخلاقه مشروبة % ولا جنا النحلة ديف باللبن % 18(@)(@@) % ولا حبال مسد متينة % معقولة من كل طود بركن % 19(@)(@@) % أوثق منه عروتي مودة % ما برز النفاق فيهم أو كمن % 20(@)(@@) % ولا الكمال ناطقا عن نفسه % % لو أعطي الكمال شخصا ولسن % PageV01P1642 21(@)(@@) % أجمع منه لصفات سؤدد % ظاهرة لو السبار يمتحن % 22(@)(@@) % يا ديمة الشكر الطويل ذيلها % % طال بها الماء الثقيل وارجحن % 23(@)(@@) % تهدلت حافلة ضروعها % % بالقولة العذبة والمعنى الحسن % 24(@)(@@) % تحدو بها ريح القريض رجزا % % كأنما قيل لحاديها نغن % 25(@)(@@) % حلى العياب فامطريمحمدا % % ملء شعاب الأرض حمدا لا يمن % 26(@)(@@) % جزاء ما أسلف من صالحة % إن الثناء للندى خير ثمن % 27(@)(@@) % تناوبي عراصه نائبة % عني في فرض التهاني والسنن % % 28(@)(@@) % ليعلم الحساد فيه أنني % % بعت به الناس 
ms530	 فلم أخش الغبن % 29(@)(@@) % وأنه أحرز مني صارما % % عليهم لا تتوقاه الجنن % 30(@)(@@) % ما رقصت قامصة برحلها % % إلى منى ليناء خشناء الرسن % PageV01P1643 31(@)(@@) % وما سعوا عارين أبدانا إلى ال % % حج وأضحوا عاقرين للبدن % 32(@)(@@) % كل دعاء يرفعون فله % % ما كان منه بالقبول مرتهن % PageV01P1644 البحر : - 1(@)(@@) % لمن طلل بلوى عاقل % عفا غير منتصب ماثل % 2(@)(@@) % تشرف يصغي لأمر الرياح % % وإما إلى واقف سائل % 3(@)(@@) % تنكرت العين ما لا تزا % % ل تعرف من ربعه الآهل % 4(@)(@@) % بدائد من قاطني الوحش فيه % % بدائل من أنسه الراحل % 5(@)(@@) % وقفت به ناحلا أجتدي % % شفاء سقامي من ناحل % % 6(@)(@@) % مشوقين لكنه لا يلام % % ولا يرتجى الجود من باخل % 7(@)(@@) % وأدرى ولم يدر ما نابه % % وتنجو الغباوة بالجاهل % 8(@)(@@) % أكنت مع الركب طاوين عنه % % مطا كل مطرد جائل % 9(@)(@@) % له من ثرى الأرض ما لا يمس % سوى مسحة الغالط الغافل % 10(@)(@@) % كأن يديه تبوعان شوطا % % ظليم أهبت به جافل % PageV01P1645 11(@)(@@) % ترى البدر راكبه قاطعا % % به فلك العقرب الشائل % 12(@)(@@) % وفي الحي مختلفات الغصو % % ن من مستو لك أو مائل % 13(@)(@@) % ومن جائر ليت ما قبله % % تعلم من قده العادل % 14(@)(@@) % تنابلن بالحدق الفاتنات % % وفي كبدي غرض النابل % 15(@)(@@) % أأصحو على النظر البابلي % والخمر والسحر في بابل % 16(@)(@@) % تعجلت يوم اللوى نظرة % ولم أتلفت إلى الآجل % 17(@)(@@) % فكنت القنيص لها لا الغزال % بعيني لا كفة الحابل % 18(@)(@@) % فيا رب قلد دمي مقلتي % % بما نظرت واعف عن قاتلي % % 19(@)(@@) % هنيئا لحبك ذات الوشاح % % دم طل فيه بلا عاقل % 20(@)(@@) % وشكواي منك إلى معرض % % وضنك مني على باذل % PageV01P1646 21(@)(@@) % وحبى لذكرك حتى لثم % % ت مسلكه من فم العاذل % 22(@)(@@) % وليل يطالب عند الصبا % % ح دين الغريم على الماطل % 23(@)(@@) % رددت أداهم ساعاته % أشاهب من دمعي السائل % 24(@)(@@) % وما عند صبري على طوله % % ولا فيض جفني من طائل % 25(@)(@@) % أرى صبغة العيش عند الحسا % % ن حالت مع الشعر الحائل % 26(@)(@@) % وأشمس شيبي فهل فيئة % % تعود بظل الصبا الزائل % 27(@)(@@) % عزفت سوى 
ms531	 علق بالوفا % % ء لم يك عنه النهي شاغلي % % 28(@)(@@) % وقمت على سرف الأربعي % % ن آخذ للحق من باطلي % % 29(@)(@@) % يعيب علي الرضا بالكفاف % سريع إلى زرقه الفاضل % 30(@)(@@) % وهان على عزتي ذله % هوان الفصيل على البازل % PageV01P1647 31(@)(@@) % ويحسدني وهو بي جاهل % ومن لك بالحاسد العاقل % 32(@)(@@) % نصحتك خالف فإن الخلاف % دليل ينوه بالخامل % 33(@)(@@) % وما لم تكن ذا يد بالعدو % فخالف عدوك أو خاتل % 34(@)(@@) % فإما كفى العام أو نم له % % وراقب به غدرة القابل % 35(@)(@@) % وإياك وابن العلاء الجديد % ونعمة مستحدث ناقل % 36(@)(@@) % إذا أبصر العقل في قسمة % تعجب من غلط الكائل % 37(@)(@@) % حريص على الزاد حرص الذئاب % % فيا خبث الطعم والآكل % 38(@)(@@) % رأى نزقة وادعى طربة % فلم يحتشم ذلة الواغل % 39(@)(@@) % يروم ابن عبد الرحيم الرجال % ولا يلحق الردف بالكاهل % 40(@)(@@) % ويرجون ما ناله والكعو % % ب منحدرات عن العامل % PageV01P1648 41(@)(@@) % ولما وزنت بأحسابهم % % وأحلامهم زنة العادل % 42(@)(@@) % رجحت وشالت موازينهم % % فثاقل بمجدك أو طاول % 43(@)(@@) % رأيت السماحة وهي الخلو % % د للذكر والعز في العاجل % 44(@)(@@) % فقلت لمالك لا مرحبا % % بميسرة في يدي باخل % 45(@)(@@) % ولولا سمو الندى ما علت % % يد المستماح يد السائل % % 46(@)(@@) % فمن كان يوما له ماله % % فأنت ومالك للآمل % 47(@)(@@) % ورثت الفخار فأعليت فيه % % وجاءوه من جانب نازل % 48(@)(@@) % وأن مماشيك في المكرمات % % لحاف يجعجع بالناعل % 49(@)(@@) % وكنت متى خار عرض فخا % % ف من قائل فيه أو قابل % 50(@)(@@) % نجوت بعرض عن المخزيا % % ت أملس من عارها ناصل % PageV01P1649 51(@)(@@) % ورب مغررة بالألد % لجوج على فقرة القائل % 52(@)(@@) % فلجت بها قاطعا للخصوم % % وقد فض عنها فم الفاصل % 53(@)(@@) % ويوم ترد الحكومات فيه % % إلى طاعة المخذم القاصل % 54(@)(@@) % وأزرق ظمآن لا يستشير % % إذا عرضت فرصة الناهل % 55(@)(@@) % يغادر نجلاء مفروجة % كمنفجة الفرس البائل % 56(@)(@@) % إذا لم يجار السنان اللسان % فما شرف المرء بالكامل % % 57(@)(@@) % وما ابنك في المجد إلا أبوه % % إذا نسب الشبل للباسل % % 58(@)(@@) % شبيهك حملته المكرمات % فلم يك عنهن بالناكل % 59(@)(@@) % وأبصرت فيه وليدا مناك 
ms532	 % % وقد يصدق الظن بالخائل % 60(@)(@@) % وقام بأمرك في الوافدين % % قيام وفي بهم كافل % PageV01P1650 61(@)(@@) % ولا تنجب الشمس ما طرقت % % بأنجب من قمر كامل % 62(@)(@@) % فبورك نسلا وأترابه % % بنوك وبوركت من ناسل % 63(@)(@@) % وخافتك فيهم عيون الزما % % ن من قاصد السهم أو جائل % 64(@)(@@) % وشر التحاسد فهو الذي % % أدب الضغائن في وائل % % 65(@)(@@) % وما دام يبقى أبو سعدهم % % فما نجم سعدك بالآفل % 66(@)(@@) % حملتم مناي على ثقلها % % وليس الكريم سوى الحامل % 67(@)(@@) % بأقوالكم وبأفعالكم % % وما كل من قال بالفاعل % 68(@)(@@) % وللود يخلطني بالنفو % % س أحظى لدي من النائل % PageV01P1651 البحر : - 1(@)(@@) % لمن ظعن سوائر لو % % صحوت عقلتها لمن % 2(@)(@@) % تخط الرمل من يبري % % ن خط الماء بالسفن % 3(@)(@@) % صواعد يبتدرن الحز % ن يا شوقي ويا حزني % % 4(@)(@@) % بفارغة الحقاب مشي % % ن مشي الذيل والردن % 5(@)(@@) % إذا قيس الغزال بها % % بكت شفقا من الغبن % 6(@)(@@) % تناشدنيي على يبري % % ن غض الطرف تتبعني % % 7(@)(@@) % فصن سري وسرك إن % % بقيت بمطرح الظنن % 8(@)(@@) % فإني عند أترابي % % بحيث الشمس لم ترني % % 9(@)(@@) % هبيني أستر النجوى % % أليس الدمع يفضحني % % 10(@)(@@) % لساني فيك أملكه % % ودمع العين يملكني % % PageV01P1652 11(@)(@@) % فما للدمع من عيني % % مكان السر من أذني % % 12(@)(@@) % نحلت نحول ربعكم % كأن عراصه بدني % % 13(@)(@@) % فما منى ومن أضغا % % ث داركم سوى الدمن % 14(@)(@@) % من الغادي ابتغاء الأج % % ر يضمن حاجة الضمن % 15(@)(@@) % فيوصل سالما وطرا % % عراقيا إلى اليمن % 16(@)(@@) % وأغنى الله غيبته % % جراء من بدور غني % % 17(@)(@@) % تداعس بالقنا الأقرا % % ن وافتقروا إلى الجنن % 18(@)(@@) % وعموا بيض أوجههم % % بأردية الوغى الدكن % 19(@)(@@) % وباعوا الحرب أنفسهم % % بما ارتخصت من الثمن % 20(@)(@@) % طلاب العز في الدنيا % % وطيب حديثها الحسن % PageV01P1653 21(@)(@@) % فباق نال حاجته % % وآخر قبل ذاك فني % % 22(@)(@@) % ونال المجد قانية % بلا ترة ولا إحن % 23(@)(@@) % فتى من آلأيوب % عن الحرب العوان غنى % % 24(@)(@@) % يداه له إذا خان ال % % يد اليزني لم تخن % 25(@)(@@) % نفى أبناؤها الصرحا % % ء أنساب القنا الهجن % 26(@)(@@) % يثقفها إذا انآدت % % مراس الرأى والفطن % 27(@)(@@) % وتنقص 
ms533	 وهي زائدة % ولولا النقص لم تبن % 28(@)(@@) % تمج دم القلوب ولم % % تلج جرحا على بدن % 29(@)(@@) % تحل بها عقود السح % % ر حللت عقدة الشطن % 30(@)(@@) % على بيضاء مصقول % عوارضها من الدرن % PageV01P1654 31(@)(@@) % إذا ما استودعت سرا % % فليس تعاب بالعلن % 32(@)(@@) % وما كل الرجال على % % ودائعها بمؤتمن % 33(@)(@@) % يقطر ظهرها الأبطا % % ل بين العي واللكن % 34(@)(@@) % سوى متمرس ذرب % بلى بطرادها ومني % % 35(@)(@@) % فما ركب ابن أيوب % % بلا فأس ولا رسن % 36(@)(@@) % سقى الود امرأ روى % % نمير وداده غصنى % % 37(@)(@@) % قنعت به من الدنيا % % وجل الشئ يقنعني % % 38(@)(@@) % ومن إخوان علات % جفوا بتخالف اللبن % 39(@)(@@) % ودادهم على الأيدي % % متى يتصافحوا يبن % 40(@)(@@) % خبرتهم فعفتهم % وكاثرني فوافقني % % PageV01P1655 41(@)(@@) % سكنت إلى خلائقه % % سكون الجفن للوسن % 42(@)(@@) % ولانت لي به الدنيا % % على أخلاقها الخشن % 43(@)(@@) % ودام على مضيق الشك % % ر متسعا له عطني % % 44(@)(@@) % بكل كثيرة النقلا % % ت من وطن إلى وطن % 45(@)(@@) % مع الحيتان في الغمرا % % ت والعقبان في القنن % 46(@)(@@) % محدثة بسؤدده % % حديث الروض بالمزن % 47(@)(@@) % كأن طريقها المرو % % ي مما لاق بالأذن % 48(@)(@@) % طوى درج السنين وجا % % ء في الآثار والسنن % 49(@)(@@) % يزرنك ما وفت منن الث % ناء بمثقل المنن % 50(@)(@@) % وما جلبت ثلاث منى % على العشاق من فتن % PageV01P1656 51(@)(@@) % وسنوا محرمي الأبدا % % ن عقر حلائل البدن % 52(@)(@@) % وإن كان امرؤ بلغ ال % % خلود بنفسه فكن % PageV01P1657 البحر : - 1(@)(@@) % تمنى رجال أن تزل بي النعل % ولم تمش في مجد بمثلي لهم رجل % 2(@)(@@) % وعابوا على هجر المطامع عفتي % % وللهجر خير حين يزري بك الوصل % 3(@)(@@) % وسموا إباي الضيم كبرا ولا أرى % % حطيطة نفسي وهي تنهض أن تعلو % % 4(@)(@@) % لئن أكلوا بالغيب لحمى فربما % % حضرت فخان المضغ واستؤني الأكل % 5(@)(@@) % وكم دونهم لي من خلائق مرة % إذا أنصفوها استثمروها جنى يحلو % % 6(@)(@@) % يقولون طامن بعض ما أنت شامخ % % بنفسك إن الرخص غاية ما يغلو % % 7(@)(@@) % إذا كان عزى طاردا عني الغنى % % فلله فقر لا يجاوره الذل % 8(@)(@@) % علي اجتناء الفضل من شجراته % % ولا 
ms534	 ذنب إن لم يجن حظا لي الفضل % 9(@)(@@) % خلقت وحيدا في ثياب نزاهتي % % غريبا وأهل الأرض لو شئت لي أهل % 10(@)(@@) % وفي الناس مثلي مقترون وإنما % % أزاد جوى أن ليس في الفضل لي مثل % PageV01P1658 11(@)(@@) % خفيت وقد أوضحت نهج شواكل % تريد عيونا وهي للعلم بي سبل % 12(@)(@@) % وعلقت بالأسماع كل غريبة % بأمثالها لم تفترع أذن قبل % 13(@)(@@) % ولم آل في إفهامهم أين موضعي % % ولكنهم دقوا عن الفهم أو قلوا % % 14(@)(@@) % يريدونني أن أشري المال سائلا % % بعرضي وطيب الفرع أن يحفظ الأصل % 15(@)(@@) % ويقبح عندي والفتى حيث نفسه % سؤال البخيل مثلما يقبح البخل % 16(@)(@@) % ولي منه إما المنع والعذر بعده % % يلفق مكذوبا أو المن والبذل % 17(@)(@@) % أرى الحلم أدواني وعوفي جاهل % وما العيش إلا ما رمى دونه الجهل % 18(@)(@@) % صعبت فلو ما كان شيء يردني % % إلى السهل ردتني له الأعين النجل % 19(@)(@@) % ويا قلما أعطي الهوى فضل مقودي % % فإن أعتلق حبا فيا قلما أسلو % % 20(@)(@@) % وكم تحت درعي باللوى من جراحة % لعجماء ما فيها قصاص ولا عقل % PageV01P1659 21(@)(@@) % وهيفاء يروى الخوط عنها اهتزازه % % ويسرق من ألحاظها لونه الكحل % 22(@)(@@) % أشارت وحولي في الظعائن أعين % محاجرها غيظ وأفئدة غل % 23(@)(@@) % تخفف بفيض الدمع من ثقل الجوى % % تجد راحة إن الدموع هي الثقل % 24(@)(@@) % أخوفها بالخيف ها أن دارنا % % حرام فمن أفتاك أن دمي حل % 25(@)(@@) % دعيني أعش قالت دع الوجد بي إذن % % فقلت لها أقررت أن الهوى قتل % 26(@)(@@) % وواش بها لم تخدع الشوق كامنا % رقاه ولم يخصم بإغوائه الخبل % 27(@)(@@) % تحبب في عذلي ليبرد لوعتي % % فبغضه أن الهوى جمره العذل % 28(@)(@@) % يلوم وسوى عنده الناس ظنه % % تبين على من لمتني إنها جمل % 29(@)(@@) % يجرب دهري كيف صبري وإنما % % يجرب ما لم يختبر حده النصل % 30(@)(@@) % تبلغ ببعض الرزق إن عز كله % % وتوصل رمات فيبلغك الحبل % PageV01P1660 31(@)(@@) % ولولا الفضول لم تكن غير حاجة % إذا الكثر لم يسنح لها سدها القل % 32(@)(@@) % وكنت متى استصرخت نصرة صاحب % على ساعة لا يرتجي غيثها المحل 
ms535	 % 33(@)(@@) % كفتني يداه في الندى كل طلقة % مقبلة على مكارمها كل % 34(@)(@@) % وأرفد ظهري أن تشل جوانبي % % أخ ما أخي منه لظهر أبي نسل % 35(@)(@@) % أخ لاحمت بيني الشكول وبينه % % لكل فتى من نسج شيمته شكل % % 36(@)(@@) % ذهبنا بها حيث الصفاء ولم نكن % % لنذهب فيها حيث يرسلنا الأصل % 37(@)(@@) % أذم ابن أيوب على ما عقدته % % به من جوار ذمة ليس تنحل % 38(@)(@@) % على اليسر والإعسار كيف احتلبته % ملأت وطابى ثم أخلافه حفل % 39(@)(@@) % ضمان عليه أن عيني قريرة % تنام وقلبي من وساوسه يخلو % % 40(@)(@@) % سليم الوفاء أملس العرض لو مشى % % ليدرج في أحسابه ما مشى النمل % PageV01P1661 41(@)(@@) % مفدى بأفراد الرجال مفضل % لمطريه من آثاره شاهد عدل % 42(@)(@@) % كأن فتي الأقحوان على الندى % % يشاب بمسك خلقه البارد السهل % 43(@)(@@) % بليل البنان يقبض الترب يابسا % % ويفرج عنه وهو أخضر مبتل % 44(@)(@@) % كأن سجاياه ونجح عداته % % خلقن ولم يخلق نفاق ولا مطل % 45(@)(@@) % من القوم لم يستنزلوا عن علائهم % % ولم تغتصب منهم ديات ولا ذحل % 46(@)(@@) % إذا فزعوا طاروا نفيرا فأكثروا % % عديدا وإن نودوا لمطعمة قلوا % % 47(@)(@@) % نديهم وهم جميع موقر % ويوم الخصام صوت فذهم يعلو % % 48(@)(@@) % ولا ينطقون الهجر إن أحرجوا له % % بأحلامهم عن فحش أقوالهم فضل % 49(@)(@@) % يروض الجياد والقراطيس منهم % فوارس لا ميل السروج ولا عزل % 50(@)(@@) % إذا طاعنوا كان الطعان بلاغة % وإن كاتبوا كان الكتاب هو القتل % PageV01P1662 51(@)(@@) % تكهل أبناء الرجال سنوهم % وطفلهم ما عد من سنة كهل % 52(@)(@@) % علقتك من دهري علوق مجرب % تعود لا يغلو هوى دون أن يبلو % % 53(@)(@@) % وأوجب نذري فيك أن صار بالغا % % تجمعنا ما تبلغ الكتب والرسل % 54(@)(@@) % فراق جنى ثم ارعوى فتفرقت % غيايته وانضم من بعده الشمل % 55(@)(@@) % جرى الماء لي مذ أبت بعد جفوفه % % وعاد كثيفا بعد ما انتقل الظل % 56(@)(@@) % فإن أنا لم أشكر زماني بالذي % % شكوت فلا عهد لدي ولا إل % 57(@)(@@) % وأن اليد البيضاء في عنق الفتى % % إذا هو لم يجز الثناء بها غل % 58(@)(@@) % وإن لم أعوذ 
ms536	 ودنا بتمائم % % لإيثاقها في عقد كل نوى حل % 59(@)(@@) % نوافذ ما لا ينفذ السحر والرقى % % قواطع ما لا يقطع السيل والرمل % 60(@)(@@) % ترى العرض منها ذا فرائد حاليا % % ولو أنه عريان من شرف عطل % PageV01P1663 61(@)(@@) % بداوتها تستصحب الجد كله % % وحاضرها طبع يرى أنه الهزل % 62(@)(@@) % تزورك منها كل يوم هدية % هدي متى تعدم فليس لها بعل % PageV01P1664 البحر : - 1(@)(@@) % ألطيمة حبست بكاظمة % أم أنت زرت رحالنا وهنا % % 2(@)(@@) % شعث بك ادكروا نعيمهم % ومروعون أزرتهم أمنا % % 3(@)(@@) % حطوا فكل حوية نمط % ولكل خد ساعد يثنى % % 4(@)(@@) % أحفيت غير ضنينة بهم % ولقد يكون سماحك الضنا % % 5(@)(@@) % يا مطبقا عينيه حين رأى % % ضوءا فخال البرق معتنا % % 6(@)(@@) % افتح جفونك إن زائرنا % % حسر القناع وأبرز السنا % % 7(@)(@@) % أعلى البعاد وأنت عاتبة % تطوين سهلا وحدك الحزنا % % 8(@)(@@) % وهبى الجفاء تركته كرما % % فعلام يترك دينك الجبنا % % 9(@)(@@) % ما زلت للأضداد جامعة % حتى جمعت الجور والحسنى % % 10(@)(@@) % شتان صدك بين أظهرنا % % بمنى ووصلك فيلوى الدهنا % % PageV01P1665 11(@)(@@) % يا ليلة للبدر منتها % % والشمس لو قد أبطأت عنا % % 12(@)(@@) % كا افتراقهما تجمعنا % % حتى إذا اجتمعا تفرقنا % % 13(@)(@@) % بتنا على الدهناء نشرب من % % ثمداء يأكل جدبها منا % % 14(@)(@@) % وعلى منىأبيات طاهرة % بالخصب تقري الشهد والسمنا % % 15(@)(@@) % لمياء ما للخمر خالطها % % مسك بغير رضابها معنى % % 16(@)(@@) % سبت القلوب ففي أناملها % % دمها يرينك إنه الحنا % % 17(@)(@@) % واحتد لحظاها وقامتها % % أفأنت علمت القنا الطعنا % % 18(@)(@@) % أخشى الأراقم أن أسميها % % فأقول موضعزينب لبنى % % 19(@)(@@) % ولقد أرى والعين ناسية % ربعابرامة يذكر الحزنا % % 20(@)(@@) % كنا به عام الهوى جذع % أيام لا شئ كما كنا % % PageV01P1666 21(@)(@@) % مغنى الشباب وكان من جسدي % % أخذ البلى من ذلك المغنى % % 22(@)(@@) % طلل تنكر بعد معرفة % وبكى الحمام به كما غنى % % 23(@)(@@) % نفرت تجنبه رواحلنا % % فكأن إنسك بدلوا جنا % % 24(@)(@@) % كنا نعوج مسلمين به % % فاليوم سلمنا وما عجنا % % 25(@)(@@) % أفتنكرين وأنت قاصية % صبا رعى لك رعية الأدنى % % 26(@)(@@) % إن زار دارك عن مراقبة % حيا وإن هو لم يزر حنا % % 27(@)(@@) % وخفية الأعلام مهملة % % بلهاء 
ms537	 ينكر ضبها المكنا % % 28(@)(@@) % لم يفترعها خف يعملة % أنهبت وجنتها يد الوجنا % % 29(@)(@@) % في ذمة البيضاء قد ثقلت % وقعا وخفت في يدي وزنا % % 30(@)(@@) % كالبقلة استبقى الزمان بها % % في غمدها دون الذي أفنى % % PageV01P1667 31(@)(@@) % خرساء تكتم جرسها فإذا % % طنت بمفرق هامة طنا % % 32(@)(@@) % يستاق أخرى الرأس قائمها % % ويغور فيه يظنه الجفنا % % 33(@)(@@) % وعميمة مرت السماء لها % % أخلاف مرضعة بها تغنى % % 34(@)(@@) % تمشي عليها الرجل ثابتة % مما يلاحم غصنها الغصنا % % 35(@)(@@) % جمت فطالت ما ابتغت ومضت % % عرضا فخلت نباتها تبنا % % 36(@)(@@) % تمضي الحجور بها تصاهلها % % منها شخوص تحسب الحصنا % % 37(@)(@@) % من دونها الحي الحلول حموا % % عنها فما ترعى ولا تجنى % % 38(@)(@@) % منعوا بأطراف القنا لدنا % من عشبها المتهدل اللدنا % % 39(@)(@@) % أطعمتها إبلي يرود بها % % راع بوسم علاطه يعنى % % 40(@)(@@) % وأخ لبثت على خلائقه % % وأجزتها صرحاء أو هجنا % % PageV01P1668 41(@)(@@) % مرآته وجهي إذا صفرت % يده ولقوته إذا استغنى % % 42(@)(@@) % ألقاه باردة جوارحه % وفؤاده متوهج ضغنا % % 43(@)(@@) % يبدي المودة لي ويغضبه % % فضلي عليه فيظهر الشحنا % % 44(@)(@@) % داريته وصبرت أنظره % أن يستعيد ببيعتي الغبنا % % 45(@)(@@) % اقرع ظنابيب القطيعة لي % % فلتقرعن من بعدي السنا % % 46(@)(@@) % لولا ابن أيوب لما ولدت % أم الوفاء على التمام ابنا % % 47(@)(@@) % لم يبق من تثنى عليه يد % عقدا ولكن جاء مستثنى % % 48(@)(@@) % قد كنت فردا لا أليق أخا % % زمنا فصرت بوده مثنى % % 49(@)(@@) % أثني على الدنيا بما وهبت % % لي منه ما أحلى وما أهنا % % 50(@)(@@) % وسواه قد عاركت خلته % % عرك المنقب جنبه يهنا % % PageV01P1669 51(@)(@@) % نغلا ألفقه كأن يدي % % رقعت على أخلاقه شنا % % 52(@)(@@) % وقلبت هذا الناس أوجههم % % ظهرا وسر قلوبهم بطنا % % 53(@)(@@) % فوجدته أوفاهم بندى % كفا وأغضى عن أذى جفنا % % 54(@)(@@) % وأحبهم نشرا لمنقبة % وأشدهم لغميزة دفنا % % 55(@)(@@) % لله منه وللصفاء أخ % عقل الزمان به وقد جنا % % 56(@)(@@) % بمحمد فتلت قوى أملي % % ورعين آمالي وأسمنا % % 57(@)(@@) % الراكب العليا على ترف % فيه يروض ظهورها الخشنا % % 58(@)(@@) % تعبا وراء المجد يجمعه % % ما شل من هنا ومن هنا % % 59(@)(@@) % عشق الكمال فما تبيت له 
ms538	 % % عين على هجرانه وسنى % % 60(@)(@@) % إن قال صدقه الفعال وإن % % أعطى على إقلاله أسنى % % PageV01P1670 61(@)(@@) % لا تعلق الفحشاء ما اجتهدت % % من ثوبه ذيلا ولا ردنا % % 62(@)(@@) % متقبل في المجد سالفة % سنت له العلياء فاستنا % % 63(@)(@@) % فكأنه لطلاب غايته % في الفضل أغلق دونها رهنا % % 64(@)(@@) % شجت أنامله بنافذة % في الصحف طبق لفظها المعنى % % 65(@)(@@) % فضاحة الفصحاء ما قنعت % % لبيانها أن تفضح اللكنا % % 66(@)(@@) % وجد التقدم والسلاح بها % % يوم النزال ولم يجد قرنا % % 67(@)(@@) % رجعت على الأعقاب ناكصة % نوب جعلتك دونها حصنا % % 68(@)(@@) % ووجدت ودك واستقامته % % بردا عليه أضالعي تحنى % % 69(@)(@@) % حملتني للرفد أقبله % % ولقد تراه نزاهتي أقنى % % 70(@)(@@) % وحملت لطفك بي على عنق % خوارة أن تحمل المنا % % PageV01P1671 71(@)(@@) % فلتجزينك كل سائرة % تسع البلاد وتظلع البدنا % % 72(@)(@@) % خراجة من كل مشكلة % ولاجة لا تسأل الإذنا % % 73(@)(@@) % من كل بيت في بيوتكم % عجز له لا تخذل المتنا % % 74(@)(@@) % تروى وليس ترى فسامعها % % للصوت تحسد عينه الأذنا % % 75(@)(@@) % موسوعة بكم غرائبها % % فلو استعرن لقد تعرفنا % % 76(@)(@@) % وأسىء ظنا وهي محسنة % لا كالمسئ ويحسن الظنا % % PageV01P1672 البحر : - 1(@)(@@) % اتمنى والمنى جهد المقل % وأقضي الدهر في ليت وهل % 2(@)(@@) % وأداوي كلف العيش إذا % % أظلمت لي بطلاوات الأمل % 3(@)(@@) % سلوة وهي الغرام بالمشتكى % % وتعاليل أسى هن العلل % 4(@)(@@) % وهوى أهون ما يسمى الضنا % % بمسيء بالإساءات مدل % 5(@)(@@) % لا ترى أعجب منى مشرفا % % أسأل الركبان عمن لم يسل % 6(@)(@@) % أحسب الظبية لاحت غمرة % والثفال النضو بالقاع الطلل % 7(@)(@@) % يا بنة السعدي ما جور لكم % % ووفاء عاد غدرا ونجل % 8(@)(@@) % أنزعت العرب عن دينهم % أم تفردت بدين منتحل % 9(@)(@@) % لي في كل قتيل قائل % ما ودى عني ومولى ما عقل % 10(@)(@@) % تعسل الأرماح من دونهم % وحماة النحل من دون العسل % PageV01P1673 11(@)(@@) % فمن المطلوب بيشاط دم % ثأره مقتسم بين الحلل % 12(@)(@@) % حال يا خنساء حول البين بي % % أفترعين لعهد لم يحل % 13(@)(@@) % قلت صبرا فهبيني فلقة % من أبان قد أذابتني المقل % 14(@)(@@) % أين بالبطحاء ميثاقكم % رب آل واسمه فيكن إل % 15 
ms539	(@)(@@) % وسعى الواشي بجمع بيننا % % لا مشت رجلك يا ذاك الرجل % 16(@)(@@) % ظنه حبا مريبا فوشى % % فرأى وصلا كريما فعدل % % 17(@)(@@) % لا تخل شرا وسل عن باطن % % عف عن قولك من يسمع يخل % 18(@)(@@) % لم يكن بعدك إلا نظر % جرح القلب ولو دام قتل % 19(@)(@@) % سافرات بمنى لولا التقى % % خمرتهن شفاه بالقبل % 20(@)(@@) % كل بيضاء تمنى الكحل لو % % أنه ما بين جفنيها الكحل % PageV01P1674 21(@)(@@) % نصفها الأعلى نشاط كله % % والذي يدنو من الأرض كسل % 22(@)(@@) % لم تعنها هزة في قدها % % إنه من صفة الرمح الخطل % 23(@)(@@) % ما على دين الغواني حكما % % يوم قاضيت إليه لو عدل % 24(@)(@@) % رشفت أنمله أن نصلت % وعذارى عيف لما أن نصل % 25(@)(@@) % قلن إذ أبصرنني أف له % % ضل شيخا وتعاطيه الغزل % 26(@)(@@) % ولقد كن متى استبطأنني % % قمن يسألن أخونا ما فعل % 27(@)(@@) % فإذا ريحانة العمر الصبا % % وسنوه وإذا الشيب الأجل % 28(@)(@@) % غالطوا وجدي وقالوا أكثر ال % % عمر في الشيب فمن لي بالأقل % 29(@)(@@) % غفلات كن حلما فانقضى % % وشباب كان ظلا فانتقل % 30(@)(@@) % لو أراني الدهر ما أخر لي % % لتعلقت بأيامي الأول % PageV01P1675 31(@)(@@) % يا لخال من مكاني قلبه % % بعد ودي كيف بالرأي أخل % 32(@)(@@) % ليت شعري عني اعتاض بمن % % هل لعين فارقت رأسا بدل % 33(@)(@@) % إن جيدا سقطت من عقده % % درة مثلي حقيق بالعطل % 34(@)(@@) % ولدخالين في الأمر معي % % بوجوه يتواصفن الدخل % 35(@)(@@) % حرموا الفضل فسدوا ملقا % % بفضول القول خلات العمل % 36(@)(@@) % كل ذي شدقين رحبين معي % % وفؤاد ضيق المسرى دغل % 37(@)(@@) % قال حسنى ونوى سيئة % ليت من لم ينو خيرا لم يقل % 38(@)(@@) % ساط شهدا لي في حنظلة % لست حلوا إنما خمرك خل % 39(@)(@@) % ناكروا حلمي فجاهلتهم % فإذا أحرج ذو الحلم جهل % 40(@)(@@) % ألمت من جلستي مستوطئا % % فرش الوحدة والوحدة ذل % PageV01P1676 41(@)(@@) % إنما أفردني مطرحا % % قدر مر بقومي فنزل % 42(@)(@@) % أكل الدهر فأفنى معشري % % ليته أشبع دهرا ما أكل % 43(@)(@@) % درجوا واستخلفوني واحدا % % وإذا قل عديد المرء قل % 44(@)(@@) % غرضا ما لي من سهم سوى % % كل رام 
ms540	 ينتحيني من ثعل % 45(@)(@@) % تعجب الأحداث من حملي لها % % وإذا أكره ذو العر حمل % 46(@)(@@) % كم ترى أعرك جنبي نافيا % % حصيات الأرض عن جلد نغل % 47(@)(@@) % غير نفسي همه شأن غد % وحديث الأمس تكرير يمل % 48(@)(@@) % أشك من يومك أو فاشكر له % % ما مضى كان وما يأتي لعل % 49(@)(@@) % ببني عبد الرحيم انفسحت % % طرق حاجاتي على ضيق السبل % 50(@)(@@) % تهت في الناس فوليتهم % وجه آمالي فيممت القبل % PageV01P1677 51(@)(@@) % أنجبي يا أرض لي مثلهم % إخوة أو قلديهم للهبل % 52(@)(@@) % أرتعونيوالأنابيب سفا % وسقوني والقرارات وشل % 53(@)(@@) % عدلوا الود ففيهم نصفه % % وإذا جادوا يزيدون فضل % 54(@)(@@) % كرماء حيثما كشفتهم % % سادة المكثر إخوان المقل % 55(@)(@@) % نقلوا السودد في أظهرهم % % كل ظهر مثلما طاب نسل % 56(@)(@@) % كابرا عن كابر يبتدر ال % % مجد منهم مقبل بعد مول % 57(@)(@@) % كالأنابيب اتصالا كلما % % قلت تم الفضل فيهم وكمل % 58(@)(@@) % أنبت الدهر غلاما منهم % عاقل الجود إذا قال فعل % 59(@)(@@) % ألمعيا لا يبالي عزة % وهو طفل أي عمريه اكتمل % 60(@)(@@) % أدرجت في القمط منه راحة % موضع الأقلام منها للأسل % PageV01P1678 61(@)(@@) % كلما أصحر في عليائه % % غار نفسا أن تصباه الظلل % 62(@)(@@) % طبعت شمس الضحى في وجهه % % سهمة لا تتلافاها الأصل % 63(@)(@@) % عقدت لي بأبي سعدهم % ذمة غير قواها ما يحل % 64(@)(@@) % الفتى العطاف ما ناب كفى % % والحيا الوكاف ما صاب هطل % 65(@)(@@) % والمحيا وجهه إن لعنت % أوجه لم تتلثم بالخجل % 66(@)(@@) % يملأ الصدر لسانا ويدا % % ويصيب الرأي ريثا وعجل % 67(@)(@@) % عف والسن له معذرة % ورأي العجز فراغا فاشتغل % 68(@)(@@) % تبلغ العجم به مسعاته % % فإذا استقربه الحق نزل % 69(@)(@@) % عازف الهم إذا عاشرته % يقمح الشربة والماء علل % 70(@)(@@) % كلما لز إلى أقرانه % % ظلعوا غير عجاف واستقل % PageV01P1679 71(@)(@@) % حسدوا فيه أباه خاب من % % يحسد الشمس على البدر وضل % 72(@)(@@) % إنها فارضوا لها أو فاغضبوا % % أيكة تطعم مجدا وتظل % 73(@)(@@) % هم وإن أنكرهم حاسدهم % % برة يعرفها أنف الجمل % 74(@)(@@) % ومنيع غابها مغلقة % % طرق المكر إليها والحيل % 75(@)(@@) % كلما أبرم بالرأي لها % % مرس أسحل 