ms179	(@)(@)(@@)(@@)(@@) $ سعد بن طريف الحنظلي(@)(@)(@@) الإسكاف، وقيل الدؤلي وقيل الخفاف [كش].(@)(@)(@@)(@@)(@@) $ عبد الله بن أحمد بن أبي زيد(@)(@)(@@) الأنباري أبو طالب [ست].(@)(@)(@@)(@@)(@@) || فصل في ذكر جماعة من الغلاة نسقا:(@)(@@)(@@)(@@) $ إبراهيم بن إسحاق أبو إسحاق(@)(@)(@@) الأحمري النهاوندي [غض].(@)(@)(@@)(@@)(@@) $ إبراهيم بن يزيد المكفوف(@)(@)(@@)(@@)(@@) $ . ابن أبي الزرقاء(@)(@)(@@)(@@)(@@) $ . أبو السمهري(@)(@)(@@)(@@)(@@) $ . أبو العباس الطرناني(@)(@)(@@)(@@)(@@) $ . أبو عبد الرحمن الكندي(@)(@)(@@) المعروف بشاه رئيس.(@)(@)(@@)(@@)(@@) $ أحمد بن الحسين بن سعيد(@)(@)(@@) بن حماد بن مهران.(@)(@)PageV01P538(@)(@)(@@)(@@)(@@) $ أحمد بن بشير الرقي(@)(@)(@@) [جش].(@)(@)(@@)(@@)(@@) $ أحمد بن علي أبو العباس(@)(@)(@@) الرازي الأيادي الخضيب [غض].(@)(@)(@@)(@@)(@@) $ أحمد بن علي بن كلثوم(@)(@)(@@) السرخسي [جخ].(@)(@)(@@)(@@)(@@) $ إسحاق بن محمد البصري(@)(@)(@@) أبو يعقوب.(@)(@)(@@)(@@)(@@) $ إسماعيل بن أبي سمال(@)(@)(@@) [كش].(@)(@)(@@)(@@)(@@) $ إسماعيل بن عمر بن أبان(@)(@)(@@) الكلبي [جش].(@)(@)(@@)(@@)(@@) $ الحسن بن خرزاد(@)(@)(@@) [جش].(@)(@)(@@)(@@)(@@) $ الحسين بن علي بن أبي عثمان(@)(@)(@@) سجادة [جخ].(@)(@)(@@)(@@)(@@) $ الحسين بن عبد الله القمي(@)(@)(@@) [جخ].(@)(@)(@@)(@@)(@@) $ الحسين بن عبد الله السعدي(@)(@)(@@) أبو عبد الله بن عبيد الله بن سهل القمي [كش].(@)(@)(@@)(@@)(@@) $ الحسين بن علي الخواتيمي(@)(@)(@@) [كش].(@)(@)(@@)(@@)(@@) $ الحسين بن محمد بن يايا(@)(@)(@@) [جخ].(@)(@)(@@)(@@)(@@) $ الحسين بن محمد بن سهل(@)(@)(@@) النوفلي.(@)(@)(@@)(@@)(@@) $ الحسين بن يزيد بن محمد(@)(@)(@@) عبد الملك النوفلي [كش].(@)(@)(@@)(@@)(@@) $ خيبري بن علي الطحان(@)(@)(@@) [جش].(@)(@)(@@)(@@)(@@) $ ربيع بن زكريا الوراق(@)(@)(@@) [جش].(@)(@)(@@)(@@)(@@) $ سهل بن زياد الآدمي(@)(@)(@@) [جش].(@)(@)PageV01P539(@)(@)(@@)(@@)(@@) $ طاهر بن حاتم بن ماهويه(@)(@)(@@) [ست].(@)(@)(@@)(@@)(@@) $ العباس بن صدقة(@)(@)(@@) [كش].(@)(@)(@@)(@@)(@@) $ عبد الله بن خداش أبو خداش(@)(@)(@@) المهري [جش].(@)(@)(@@)(@@)(@@) $ عبد الله بن سبإ(@)(@)(@@) [جخ].(@)(@)(@@)(@@)(@@) $ عبد الله بن