ms161	 قيس فحضر عند أبي جعفر (عليه السلام) فأخبره بذلك فقال: إني أجبته تقية.(@)(@)(@@)(@@)(@@) $ 357 عمرو بن سعيد المدائني(@)(@)(@@) [جش] ثقة [كش] فطحي.(@)(@)(@@)(@@)(@@) $ 358 عمرو بن شمر أبو عبد الله(@)(@)(@@) الجعفي ق [جش] عربي ضعيف جدا، زاد أحاديث في كتب جابر الجعفي ينسب بعضها إليه والأمر ملتبس [غض] ضعيف.(@)(@)(@@)(@@)(@@) $ 359 عمرو بن عبد العزيز، أبو حفص(@)(@)(@@) بن أبي بشار يلقب بزحل لم [جخ، ست، جش] عربي بصري مخلط.(@)(@)(@@)(@@)(@@) $ 360 عمر بن فرات الكاتب(@)(@)(@@) ضا [جخ] بغدادي غال [كش] ذو مناكير.(@)(@)(@@)(@@)(@@) $ 361 عمر بن قيس الماصر(@)(@)(@@) قر [جخ](@)(@)PageV01P489(@)(@)(@@) بتري ويقال عمرو.(@)(@)(@@)(@@)(@@) $ 362 عمرو بن قيس المشرقي(@)(@)(@@) [جخ] ن [كش] دعاه الحسين (عليه السلام) لنصرته فاعتذر بتجارته. وكفاه ذلك ذما.(@)(@)(@@)(@@)(@@) $ 363 عمر بن المختار الخزاعي(@)(@)(@@) ذكره الغلاة لا يعرف.(@)(@)(@@)(@@)(@@) $ 364 عمر بن موسى الوجيهي(@)(@)(@@) ، بالياء المثناة تحت بعد الجيم كذا ضبط الشيخ (رحمه الله) في الفهرست بخطه لم [ست] زيدي.(@)(@)(@@)(@@)(@@) $ 365 عمرو النبطي(@)(@)(@@) قر [كش] كان يضع عليه الحديث.(@)(@)(@@)(@@)(@@) $ 366 عمرو بن الهلال(@)(@)(@@) ، وقيل عمر، والأول بخط شيخنا أبي جعفر قر [جخ] مجهول.(@)(@)(@@)(@@)(@@) $ 367 عمر بن يحيى(@)(@)(@@) قر [جخ] مجهول.(@)(@)(@@)(@@)(@@) $ 368 عنبسة بن مصعب(@)(@)(@@) [كش] واقفي ناووسي.(@)(@)PageV01P490(@)(@)(@@)(@@)(@@) $ 369 عيسى بن عثمان(@)(@)(@@) ضا [جخ] مجهول.(@)(@)(@@)(@@)(@@) $ 370 عيسى بن عمر السنائي(@)(@)(@@) لم [جخ] عالم زيدي، ذكر بعض أصحابنا في تصنيفه أنه الشيباني والذي نقلته ضبط الشيخ بخطه.(@)(@)(@@)(@@)(@@) $ 371 عيسى بن عيسى الكلابي(@)(@)(@@) مولى بني عامر وليس بالرؤاسي ضا [جخ] كوفي واقفي.(@)(@)(@@)(@@)(@@) $ 372 عيسى بن المستفاد أبو موسى(@)(@)(@@) البجلي الضرير قر [جش] لم يكن بذاك.(@)(@)(@@)(@@)(@@) || باب الغين المعجمة(@)(@@)(@@)(@@) $ 373 غالب بن عثمان الهمداني(@)(@)(@@) الشاعر المشاعري يكنى أبا سلمة ق [جخ] مهمل [جش] زيدي.(@)(@)(@@)(@@)(@@) $ 374 غالب بن عثمان،(@)(@)(@@) م [جخ، ست] واقفي.(@)(@)(@@)(@@)(@@) $ 375 غياث بن إبراهيم أبو محمد(@)(@)(@@) التميمي الأسدي قر، ق [جخ] بتري فاسد العقيدة.(@)(@)PageV01P491(@)(@)(@@)(@@)(@@) || باب الفاء(@)(@@)(@@)(@@) $ 376 فارس بن حاتم القزويني(@)(@)(@@) ضا، دي غال ملعون [غض] فارس بن حاتم القزويني، نزيل العسكر، فسد مذهبه وبريء منه وقتله بعض أصحاب أبي محمد الحسن بالعسكر، لا يلتفت 
ms162	 إلى حديثه وله كتاب كلها تخليط [كش]: فارس بن محمد القزويني وفارس بن حاتم الفهري غاليان في زمن علي بن محمد العسكري.(@)(@)(@@)(@@)(@@) $ 377 الفتح بن يزيد(@)(@)(@@) ، بالياء المثناة تحت والزاء، الجرجاني صاحب المسائل لأبي الحسن (عليه السلام) واختلف [هل هو الرضا أم الثالث (عليهما السلام) والرجل مجهول.(@)(@)(@@)(@@)(@@) $ 378 فرات بن الأحنف] العبدي(@)(@)(@@) ين [جخ] يرمى بالغلو والتفويض في القول [غض] كوفي ين، قر، ق غال كذاب.(@)(@)(@@)(@@)(@@) $ 379 الفضل بن أبي قرة التميمي(@)(@)(@@) السمندي بلد من آذربيجان، انتقل إلى الإرمينية ق [جش] ضعيف لم يكن بذاك.(@)(@)PageV01P492(@)(@)(@@)(@@)(@@) $ 380 الفضل بن الحارث(@)(@)(@@) د [جخ] مجهول الحال.(@)(@)(@@)(@@)(@@) $ 381 الفضيل بن عياض(@)(@)(@@) ق [كش] بصري ثقة عظيم المنزلة لكنه عامي.(@)(@)(@@)(@@)(@@) $ 382 فضيل بن غياث(@)(@)(@@) قر [جخ] مجهول.(@)(@)(@@)(@@)(@@) $ 383 الفضل بن يونس الكاتب(@)(@)(@@) م [جخ] واقفي، وأصله كوفي، تحول إلى بغداد [جش] ثقة.(@)(@)(@@)(@@)(@@) || باب القاف(@)(@@)(@@)(@@) $ 384 القاسم بن أسباط(@)(@)(@@) ضا [جخ] مجهول.(@)(@)(@@)(@@)(@@) $ 385 القاسم بن الحسن بن علي(@)(@)(@@) بن يقطين بن موسى أبو محمد مولى بني أسد سكن قم [جش] كان ضعيفا [كش] كان غاليا [غض] حديثه يعرف وينكر، وذكر القميون أن في مذهبه ارتفاعا والأغلب عليه الخير.(@)(@)(@@)(@@)(@@) $ 386 القاسم بن الربيع الصحاف(@)(@)(@@) ،(@)(@)PageV01P493(@)(@)(@@) وفي تصنيف بعض الأصحاب: الصواف لم [غض] ضعيف جدا غال يروي عن محمد بن سنان.(@)(@)(@@)(@@)(@@) $ القاسم الشعراني اليقطيني(@)(@)(@@) دي [جخ] يرمى بالغلو يدعي أنه باب وأنه نبي.(@)(@)(@@)(@@)(@@) $ 387 القاسم بن عوف الشيباني(@)(@)(@@) ين [جخ] كان يختلف بين وعلي بن الحسين (عليه السلام) ومحمد بن الحنفية.(@)(@)(@@)(@@)(@@) $ 388 القاسم بن محمد الجوهري(@)(@)(@@) م [جخ] واقفي [كش]: قال نصر بن الصباح: إنه لم يلق أبا عبد الله (عليه السلام) وقيل كان واقفيا.(@)(@)(@@)(@@)(@@) $ 389 القاسم بن محمد القمي(@)(@)(@@) يعرف بكاسولا [جش] لم يكن بالمرضي [كش] غال [غض] حديثه يعرف وينكر.(@)(@)(@@)(@@)(@@) $ 390 القاسم بن الهروي(@)(@)(@@) مجهول.(@)(@)(@@)(@@)(@@) $ 391 القاسم بن يحيى بن الحسن(@)(@)(@@) بن راشد مولى المنصور ضا [جخ] روى عن [جده] ضعيف.(@)(@)PageV01P494(@)(@)(@@)(@@)(@@) $ 392 القافي خادم أبي الحسن (عليه السلام)(@)(@)(@@) م [جخ] مجهول.(@)(@)(@@)(@@)(@@) $ 393 قعنب بن أعين(@)(@)(@@) [كش] عن 
ms163	 علي بن الحسن بن فضال: كان مرجئا.(@)(@)(@@)(@@)(@@) $ 394 قيس بن الربيع(@)(@)(@@) [جخ] قر [كش] بتري.(@)(@)(@@)(@@)(@@) $ 395 قيس بن قرة(@)(@)(@@) وبعض أصحابنا قال في تصنيفه قيس بن مرة وهو اشتباه ى [جخ، كش] هرب إلى معاوية.(@)(@)(@@)(@@)(@@) || باب الكاف(@)(@@)(@@)(@@) $ 396 كامل الرصافي(@)(@)(@@) قر [جخ] مجهول.(@)(@)(@@)(@@)(@@) $ 397 كثير بن طارق القنبري(@)(@)(@@) من ولد قنبر مولى علي بن أبي طالب (عليه السلام) [جش] روى عن زيد، ففيه توقف.(@)(@)PageV01P495(@)(@)(@@)(@@)(@@) $ 398 كثير بن عياش(@)(@)(@@) ، بالياء المثناة تحت والشين المعجمة خرج أيام أبي السرايا وجرح، وكان قطانا.(@)(@)(@@)(@@)(@@) $ 399 كثير بن كاروند(@)(@)(@@) ، بالراء والواو المفتوحتين والنون الساكنة والدال المهملة، أبو إسماعيل، النواء قر، ق [جخ، كش] بتري [قي] عامي.(@)(@)(@@)(@@)(@@) $ 400 كرام بن عمرو بن، عبد الكريم(@)(@)(@@) [كش] واقفي.(@)(@)(@@)(@@)(@@) $ 401 الكلبي(@)(@)(@@) [كش] عامي وقيل مستو.(@)(@)(@@)(@@)(@@) $ 402 كلثوم بن سليم(@)(@)(@@) [كش] وقف على الرضا (عليه السلام).(@)(@)(@@)(@@)(@@) || باب اللام(@)(@@)(@@)(@@) $ 403 ليث بن أبي سليم(@)(@)(@@) قر [جخ] مجهول.(@)(@)PageV01P496(@)(@)(@@)(@@)(@@) || باب الميم(@)(@@)(@@)(@@) $ 404 مالك بن أعين(@)(@)(@@) قر، ق [كش] هو وأخوه قعنب ليسا من هذا الأمر في شيء [عق] كان مخالفا.(@)(@)(@@)(@@)(@@) $ 405 مبرور بن إسماعيل(@)(@)(@@) م [جخ] مجهول، وقيل: مسرور، بالسين المهملة، وبخط الشيخ الأول.(@)(@)(@@)(@@)(@@) $ 406 محبوب بن حكيم(@)(@)(@@) لم [غض] لا نعرفه.(@)(@)(@@)(@@)(@@) $ محمد بن أحمد بن خاقان(@)(@)(@@) النهدي وهو حمدان القلانسي [جش] مضطرب [كش] فقيه ثقة خير.(@)(@)(@@)(@@)(@@) $ 407 محمد بن أحمد بن قضاعة(@)(@)(@@) أبو عبد الله بن صفوان بن مهران، أبو عبد الله الصفواني [غض] ما أنكرت منه شيئا إلا ما يرويه [عن أبيه] عن جده عن(@)(@)PageV01P497(@)(@)(@@) الصادق (عليه السلام) فإنه شيء غير معروف، وقد رأيت فيه مناكير مكذوبة عليه، وأظن الكذب من قبل أبيه.(@)(@)(@@)(@@)(@@) $ 408 محمد بن أحمد بن محمد(@)(@)(@@) بن سنان أبو عيسى لم [غض] نسبه وحديثه مضطرب.(@)(@)(@@)(@@)(@@) $ 409 محمد بن أحمد الجاموراني(@)(@)(@@) ، بالجيم والراء والنون، الرازي ضعفه القميون في مذهبه ارتفاع.(@)(@)(@@)(@@)(@@) $ 410 محمد بن أحمد النطنزي(@)(@)(@@) ، بالنونين والطاء المهملة بينهما والزاي لم عامي.(@)(@)(@@)(@@)(@@) $ 411 محمد بن إدريس الحنظلي(@)(@)(@@) الرازي أبو حاتم لم [جخ] عامي المذهب.(@)(@)(@@)(@@)(@@) $ 412 محمد بن إدريس العجلي 
ms164	(@)(@)(@@) الحلي كان شيخ الفقهاء بالحلة متقنا في العلوم كثير التصانيف لكنه أعرض عن أخبار أهل البيت [بالكلية].(@)(@)PageV01P498(@)(@)(@@)(@@)(@@) $ 413 محمد بن إسحاق المدني(@)(@)(@@) صاحب السير قر، ق [جخ] عامي.(@)(@)(@@)(@@)(@@) $ 414 محمد بن إسحاق بن عمار(@)(@)(@@) بن حيان التغلبي م [جش] ثقة [يه] واقفي.(@)(@)(@@)(@@)(@@) $ 415 محمد بن إسحاق خاصف النعل(@)(@)(@@) [كش] عامي غير أن له محبة وميلا.(@)(@)(@@)(@@)(@@) $ 416 محمد بن أسلم الطبري(@)(@)(@@) الجبلي بالجيم والباء المفردة، وفي نسخة الحلبي، واختار الشيخ الأول، أبو جعفر أصله كوفي كان يتجر إلى طبرستان ضا [جش] يرمى بالغلو فاسد الحديث.(@)(@)(@@)(@@)(@@) $ 417 محمد بن أورمة(@)(@)(@@) ، بضم الهمزة وسكون الواو قبل الراء المضمومة، أبو جعفر القمي لم [جخ] ضعيف روى عنه الحسين بن الحسن بن أبان وهو ثقة [ست] في رواياته تخليط [يه] طعن عليه بالغلو، فكل ما كان في كتبه مما يوجد في كتب الحسين بن سعيد وغيره فإنه يعتمد عليه،(@)(@)PageV01P499(@)(@)(@@) وكل ما تفرد به لم يجز العمل عليه ولا يعتمد [غض]: اتهمه القميون بالغلو، وحديثه نقي لا فساد فيه، ولم أر شيئا ينسب إليه تضطرب فيه النفس إلا أوراقا في تفسير الباطن وأظنها موضوعة عليه، ورأيت كتابا خرج عن أبي الحسن (عليه السلام) إلى القميين في براءته مما قذف به [جش] غمز القميون عليه ورموه بالغلو حتى دس عليه من يفتك به فوجده يصلي من أول الليل إلى آخره فتوقفوا عنه.(@)(@)(@@)(@@)(@@) $ 418 محمد بن بحر الرهني(@)(@)(@@) ، وفي نسخة بالدال المهملة لم [جخ] يرمى بالغلو والتفويض [غض] ضعيف، في مذهبه ارتفاع [جش] قيل في مذهبه ارتفاع وحديثه قريب من السلامة ولا أدري من أين قيل ذلك.(@)(@)(@@)(@@)(@@) $ 419 محمد بن بشير(@)(@)(@@) م [جخ] غال ملعون [كش] كان واقفيا مشعبذا صاحب مخاريق روى [كش] عن ضا أنه كان يكذب على م فأذاقه الله حر الحديد.(@)(@)(@@)(@@)(@@) $ 420 محمد بن بكر بن جناح(@)(@)(@@) م [جخ] واقفي وبعض أصحابنا أثبته محمد بن بكران والحق الأول.(@)(@)PageV01P500(@)(@)(@@)(@@)(@@) $ 421 محمد بن جرير(@)(@)(@@) ، بالجيم والراءين المهملة، أبو جعفر الطبري صاحب التاريخ لم [ست جش] عامي أقول: 
ms165	 هذا غير الشيخ المعظم محمد بن جرير بن رستم الطبري الآملي مصنف كتاب المسترشد في الإمامة، ذاك من أعيان أصحابنا عظيم الشأن حسن التصنيف، (قدس الله روحه).(@)(@)(@@)(@@)(@@) $ 422 محمد بن جعفر بن بطة(@)(@)(@@) المؤدب أبو جعفر القمي [جش] كان كبير المنزلة بقم كثير الأدب والفضل، متشاغلا في الحديث ويعلق الأحاديث بالإجازات، وفي فهرست ما رواه غلط كثير. قال ابن الوليد: كان مخلطا ضعيفا.(@)(@)(@@)(@@)(@@) $ 423 محمد بن جعفر بن عون(@)(@)(@@) الأسدي أبو الحسين الكوفي ساكن الري يقال له محمد بن أبي عبد الله لم [جش] كان ثقة صحيح الحديث إلا أنه روى عن الضعفاء وكان يقول بالجبر والتشبيه.(@)(@)PageV01P501(@)(@)(@@)(@@)(@@) $ 424 محمد بن جعفر بن عنبسة(@)(@)(@@) الأهوازي الحداد يعرف بابن ريذويه، بالراء المهملة المكسورة فالياء المثناة تحت فالذال المعجمة، مولى بني هاشم لم [جش] يكنى أبا عبد الله مختلط الأمر.(@)(@)(@@)(@@)(@@) $ 425 محمد بن جمهور أبو عبد الله(@)(@)(@@) العمي ضا [كش] ضعيف الحديث فاسد المذهب [جش] قيل فيه أشياء الله أعلم بها من عظمها [جخ]. عربي بصري غال [غض] غال فاسد الحديث، رأيت له شعرا يحلل فيه حرمات الله تعالى.(@)(@)(@@)(@@)(@@) $ 426 محمد بن الحجاج المدني(@)(@)(@@) ق [جخ] منكر الحديث.(@)(@)(@@)(@@)(@@) $ 427 محمد بن حسان الرازي(@)(@)(@@) أبو عبد الله الزيدي [جش] يعرف وينكر بين بين، يروي عن الضعفاء كثيرا [غض] ضعيف جدا.(@)(@)(@@)(@@)(@@) $ محمد بن الحسن بن جمهور(@)(@)(@@) ضا [كش] كان ضعيفا في الحديث غاليا.(@)(@)(@@)(@@)(@@) $ 428 محمد بن الحسن بن شمون(@)(@)(@@) كر [جخ] غال [غض، كش] وقف ثم غلا،(@)(@)PageV01P502(@)(@)(@@) ضعيف مهافت لا يلتفت إلى مصنفاته وسائر ما ينسب إليه [جش] عاش مائة وأربع عشرة سنة ومات سنة ثمان وخمسين ومائتين.(@)(@)(@@)(@@)(@@) $ 429 محمد بن الحسين بن عبد الله(@)(@)(@@) الجعفري [جش] ذكره بعض أصحابنا وغمز عليه روى عنه البلوي، والبلوي ضعيف مطعون عليه.(@)(@)(@@)(@@)(@@) $ 430 محمد بن الحسين بن سعيد(@)(@)(@@) الصائغ لم [جش] كوفي نزل في بني ذهل أبو جعفر ضعيف جدا، قيل إنه غال.(@)(@)(@@)(@@)(@@) $ 431 محمد بن حصين الفهري(@)(@)(@@) بالفاء قبل الهاء دي [جخ] ملعون منسوب إلى فهر بن 
ms166	 مالك بن النضر بن كنانة.(@)(@)(@@)(@@)(@@) $ 432 محمد بن خالد بن عبد الرحمن(@)(@)(@@) بن علي البرقي أبو عبد الله مولى أبي موسى الأشعري ينسب إلى برقةرود من سواد قم على واد هناك لم [غض] حديثه يعرف وينكر، ويروي عن الضعفاء كثيرا [جش] ضعيف في الحديث مع أدبه وعلمه [كش](@)(@)PageV01P503(@)(@)(@@) قال نصر بن الصباح: لم يلق البرقي أبا بصير، بينهما القاسم بن حمزة، ولا إسحاق بن عمار، وينبغي أن يكون صفوان قد لقيه.(@)(@)(@@)(@@)(@@) $ 433 محمد بن زيد(@)(@)(@@) قر [جخ] بتري.(@)(@)(@@)(@@)(@@) $ 434 محمد بن سالم بن عبد الحميد(@)(@)(@@) لم [كش] فطحي.(@)(@)(@@)(@@)(@@) $ 435 محمد بن سالم بياع القصب(@)(@)(@@) زيدي.(@)(@)(@@)(@@)(@@) $ 436 محمد بن سالم الكندي(@)(@)(@@) السجستاني لم ضعيف.(@)(@)(@@)(@@)(@@) $ 437 محمد بن سليمان الديلمي(@)(@)(@@) أبو عبد الله ق، م، ضا [جخ] يرمى بالغلو [غض] ضعيف في حديثه [جش] ضعيف جدا لا يعول عليه في شيء.(@)(@)(@@)(@@)(@@) $ 438 محمد بن سليمان النصري(@)(@)(@@) ، بالنون م [جخ] يرمى بالغلو.(@)(@)(@@)(@@)(@@) $ 439 محمد بن السريعي(@)(@)(@@) كر [جخ] غال.(@)(@)(@@)(@@)(@@) $ 440 محمد بن سنان(@)(@)(@@) ين، م، ضا، د [جخ] ضعيف [غض] غال [ست] قد طعن(@)(@)PageV01P504(@)(@)(@@) عليه، ضعيف، وروى عنه أنه قال عند موته: لا ترووا عني مما حدثت شيئا فإنما هي كتب اشتريته من السوق والغالب على حديثه الفساد.(@)(@)(@@)(@@)(@@) $ 441 محمد بن شهاب الزهري(@)(@)(@@) ين [جخ] عدو.(@)(@)(@@)(@@)(@@) $ 442 محمد بن صدقة(@)(@)(@@) ضا [جخ] بصري غال.(@)(@)(@@)(@@)(@@) $ 443 محمد بن عبد الله الجعفري(@)(@)(@@) لم [غض] لا نعرفه إلا من جهة علي بن محمد صاحب الزنج ومن جهة عبد الله بن محمد البلوي وما يحمل عليه فسائره فاسد.(@)(@)(@@)(@@)(@@) $ 444 محمد بن عبد الله الجلاب(@)(@)(@@) ، بالجيم والباء البصري م [جخ] واقفي.(@)(@)(@@)(@@)(@@) $ 445 محمد بن عبيد(@)(@)(@@) ، بالضم، بن صاعد [جش] كوفي واقفي يكنى أبا عبد الله.(@)(@)(@@)(@@)(@@) $ 446 محمد بن عبد الله بن غالب(@)(@)(@@) أبو عبد الله الأنصاري البزاز [جش] ثقة في الرواية على مذهب الواقفة.(@)(@)(@@)(@@)(@@) $ 447 محمد بن عبد الله بن محمد(@)(@)(@@) بن(@)(@)PageV01P505(@)(@)(@@) عبد الله بن البهلول بن همام، أبو الفضل لم [جش] كان سافر في طلب الحديث عمره، 
ms167	 أصله كوفي كان أول عمره ثبتا ثم خلط، يغمزه جل أصحابنا ويضعفونه.(@)(@)(@@)(@@)(@@) $ 448 محمد بن عبد الله بن المطلب(@)(@)(@@) الشيباني يكنى أبا المفضل لم [جخ، ست] كثير الرواية إلا أنه ضعفه قوم من أصحابنا [غض] وضاع للحديث كثير المناكير رأيت كتبه وفيها الأسانيد من دون المتون والمتون من دون الأسانيد وأرى ترك ما تفرد به.(@)(@)(@@)(@@)(@@) $ 449 محمد بن عبد الله بن مهران(@)(@)(@@) د، دي [كش غض] ضعيف يرمى بالغلو وضاع للحديث.(@)(@)(@@)(@@)(@@) $ 450 محمد بن عبد العزيز الزهري(@)(@)(@@) [قد] منكر الحديث.(@)(@)(@@)(@@)(@@) $ 451 محمد بن عبد الملك الكوفي(@)(@)(@@) ق [جخ] نزل معه بغداد ضعيف.(@)(@)(@@)(@@)(@@) $ 452 محمد بن عطية الحناط(@)(@)(@@) ، بالحاء المهملة والنون(@)(@)PageV01P506(@)(@)(@@) ، أخو الحسن وجعفر ق [جخ] ضعيف كوفي.(@)(@)(@@)(@@)(@@) $ 453 محمد بن علي الهمداني(@)(@)(@@) كر [جخ] ضعيف، روى عنه محمد بن أحمد بن يحيى.(@)(@)(@@)(@@)(@@) $ 454 محمد بن علي بن إبراهيم(@)(@)(@@) بن موسى أبو جعفر القرشي مولاهم صيرفي ابن أخت خلاد بن عيسى المقري، لقبه أبو سمينة [جش] ضعيف جدا فاسد الاعتقاد لا يعتمد عليه في شيء، ورد قم وقد اشتهر [بالكذب بالكوفة، ونزل على أحمد بن محمد بن عيسى مدة ثم تشهر] بالغلو فخفي وأخرج من قم والله أعلم [كش] كان يرمى بالغلو. وذكر الفضل بن شاذان في بعض كتبه أن الكذابين المشهورين أربعة أبو الخطاب ويونس بن ظبيان ويزيد الصائغ وأبو سمينة أشهرهم [غض] غال يضع الحديث.(@)(@)PageV01P507(@)(@)(@@)(@@)(@@) $ 455 محمد بن علي بن بلال(@)(@)(@@) أبو طاهر لم [جخ] في كتاب الغيبة أنه من المذمومين.(@)(@)(@@)(@@)(@@) $ 456 محمد بن علي الشلمغاني(@)(@)(@@) يعرف بابن أبي العزاقر لم [ست] له كتب وروايات وكان مستقيم الطريقة ثم تغير وظهرت منه مقالات منكرة إلى أن أخذه السلطان فقتله وصلبه ببغداد وكان سبب تغييره الحسد لأبي القاسم ابن روح حتى خرجت فيه توقيعات أوجبت ما عمل به.(@)(@)(@@)(@@)(@@) $ 457 محمد بن عمر الجرجاني(@)(@)(@@) [جش] مختلط الأمر.(@)(@)(@@)(@@)(@@) $ 458 محمد بن عمرو(@)(@)(@@) م [جخ] واقفي.(@)(@)(@@)(@@)(@@) $ 459 محمد بن عيسى بن عبيد(@)(@)(@@) بن يقطين بن موسى مولى بني أسد بن خزيمة أبو جعفر 
ms168	 جليل في أصحابنا دي، كر [جخ] ضعيف [ست] استثناه [يو] من رجال نوادر(@)(@)PageV01P508(@)(@)(@@) الحكمة وقال: لا أروي ما يختص بروايته، وقد كان يذهب مذهب الغلاة وحكى عن ابن الوليد أنه قال: ما تفرد به محمد بن عيسى من كتب يونس وحديثه لا يعتمد عليه [جش] ورأيت أصحابنا ينكرون هذا ويقولون: من مثل أبي جعفر محمد بن عيسى [كش] إنه كان أصغر سنا من أن يروي عن ابن محبوب أقول: لا يستلزم عدم الاعتماد على ما تفرد به محمد بن عيسى عن يونس الطعن في محمد بن عيسى، لجواز أن يكون العلة في ذلك أمر آخر كصغر السن المقتضي للواسطة بينهما فلا تنافي بين قول ابن بابويه وقول من عداه.(@)(@)(@@)(@@)(@@) $ 460 محمد بن الفرات الجعفي(@)(@)(@@) [جش] كوفي ضعيف [كش] كان غاليا يشرب الخمر ويكذب على الرضا (عليه السلام) [غض] ضعيف ضعيف لا يكتب حديثه والله أعلم.(@)(@)(@@)(@@)(@@) $ 461 محمد بن قيس أبو أحمد(@)(@)(@@) قر ضعيف ذكره [جخ] ووصفه بالأنصاري وأهمله.(@)(@)PageV01P509(@)(@)(@@)(@@)(@@) $ 462 محمد بن الفضيل الأزدي(@)(@)(@@) الصيرفي ضا [جخ] يرمى بالغلو.(@)(@)(@@)(@@)(@@) $ 463 محمد بن القاسم(@)(@)(@@) ويقال ابن أبي القاسم المفسر الأسترآبادي لم روى عنه أبو جعفر ابن بابويه، كذاب.(@)(@)(@@)(@@)(@@) $ 464 محمد بن مسكان(@)(@)(@@) ق [كش] مجهول.(@)(@)(@@)(@@)(@@) $ 465 محمد بن مصادف(@)(@)(@@) مولى ق [غض]: ضعيف، ثقة، في موضعين.(@)(@)(@@)(@@)(@@) $ 466 محمد بن مظفر أبو دلف(@)(@)(@@) الأزدي [جش] كان سمع كثيرا ثم اضطرب عقله.(@)(@)(@@)(@@)(@@) $ 467 محمد بن مقلاس(@)(@)(@@) ، بالسين، وبعض أصحابنا أثبته بالصاد المهملة والأول اختار شيخنا أبو جعفر (رحمه الله)، الأسدي الكوفي ق [جخ] غال ملعون ويكنى مقلاس بأبي زينب الزراد [البزاز] البراد [غض]: محمد بن أبي زينب أبو الخطاب الأجدع البراد، وفي نسخة السراد، بالسين المهملة مولى بني أسد، لعنه الله، أمره مشهور [كش] يكنى أبا إسماعيل وأبا الظبيان كان يكذب(@)(@)PageV01P510(@)(@)(@@) على أبي عبد الله (عليه السلام) ويشنع عليه ما لم يقله ويخوفه، و(@@) روى عمران بن علي قال سمعت أبا عبد الله (عليه السلام) يقول : لعن الله أبا الخطاب، ولعن من يقتل معه، 
ms169	 ولعن من بقي منهم، ولعن من دخل في قلبه لهم رحمة(@)(@)(@@) وفي رواية كان أبو الخطاب أحمق فكنت أحدثه وكان لا يحفظ شيئا وكان يزيد من عنده.(@)(@)(@@)(@@)(@@) $ 468 محمد بن منصور الأسقف(@)(@)(@@) الأشعري ضا [جخ] مجهول.(@)(@)(@@)(@@)(@@) $ 469 محمد بن نصير(@)(@)(@@) ، بالنون المضمومة والصاد المهملة المفتوحة، النميري كر [جخ] غال [غض] إليه ينسب النصيرية.(@)(@)(@@)(@@)(@@) $ 470 محمد بن المنكدر(@)(@)(@@) [كش] عامي.(@)(@)(@@)(@@)(@@) $ 471 محمد بن موسى بن عيسى(@)(@)(@@) ، أبو جعفر الهمداني السمان [كش] ضعفه القميون بالغلو وكان [ابن الوليد يقول إنه(@)(@)PageV01P511(@)(@)(@@) كان] يضع الحديث [غض]: قريب القصة.(@)(@)(@@)(@@)(@@) $ 472 محمد بن ميمون أبو نصر(@)(@)(@@) الزعفراني ق [كش] عامي.(@)(@)(@@)(@@)(@@) $ 473 محمد بن الوليد الصيرفي(@)(@)(@@) [غض] ضعيف.(@)(@)(@@)(@@)(@@) $ 474 محمد بن هارون(@)(@)(@@) كر [جخ] ضعيف روى عن محمد بن يحيى.(@)(@)(@@)(@@)(@@) $ 475 محمد بن الوليد البجلي(@)(@)(@@) الخزاز، بالمعجمات، أبو جعفر الكوفي [جش] ثقة عين نقي الحديث روى عن يونس بن يعقوب وحماد بن عثمان ومن في طبقتهما، وعمر حتى لقيه محمد بن الحسن الصفار وسعيد لكن [كش] قال: إنه فطحي.(@)(@)(@@)(@@)(@@) $ 476 محمد بن يحيى الرهني(@)(@)(@@) ، بضم الراء وفتح الهاء وبالنون، يرمى بالتفويض.(@)(@)(@@)(@@)(@@) $ 477 محمد بن يحيى المعاذي(@)(@)(@@) بالميم المضمومة والذال المعجمة كر [جخ](@)(@)PageV01P512(@)(@)(@@) ضعيف روى عنه محمد بن أحمد بن يحيى.(@)(@)(@@)(@@)(@@) $ 478 المختار بن أبي عبيدة الثقفي(@)(@)(@@) ين [كش] غمز فيه بعض أصحابنا بالكيسانية واحتج على ذلك برد مولانا زين العابدين (عليه السلام) هديته وليس ذلك دليلا لما(@)(@)(@@) روي عن أبي جعفر الباقر (عليه السلام) أنه قال : لا تسبوا المختار فإنه قتل قتلتنا وطلب بثارنا وزوج أراملنا وقسم فينا المال على العسرة ولما أتاه أبو الحكم ولد المختار أكرمه وقربه حتى كاد يقعده في حجرة فسأله أبو الحكم عن أبيه وقال: إن الناس قد أكثروا في أبي والقول قولك، فمدحه وترحم عليه وقال: سبحان الله! أخبرني أبي والله إن مهر أمي كان مما بعث به المختار، رحم الله أباك، يكررها، ما ترك لنا حقا عند أحد إلا طلبه، قتل قتلتنا وطلب بدمائنا.(@)(@)(@@) أما أبو عبد الله (عليه السلام) 
ms170	 فروى عنه أنه قال : ما امتشطت فينا هاشمية ولا اختضبت حتى بعث المختار إلينا برءوس الذين قتلوا الحسين (عليه السلام).(@)(@)PageV01P513(@)(@)(@@) أما علي بن الحسين (عليه السلام) فروى عنه أنه قال لما أرسل المختار برأس عبيد الله بن زياد خر ساجدا وجزى المختار خيرا(@)(@)(@@) ، وما روي فيه مما ينافي ذلك قال الكشي نسبته إلى وضع العامة أشبه، فمنه(@)(@)(@@) أن الصادق (عليه السلام) قال : كان المختار يكذب على علي بن الحسين.(@)(@)(@@) ومنه(@)(@)(@@) أن علي بن الحسين (عليه السلام) رد هداياه وقال: لا أقبل هدايا الكذابين(@)(@)(@@) وأنه الذي دعا الناس إلى محمد بن الحنفية وسموا الكيسانية والمختارية وكان لقبه الكيسان، وهذا تشنيع العامة على المختار، وأما رد الهدية فقد روى الكشي عن محمد بن مسعود يرفعه إلى عمر بن علي أن المختار أرسل إلى زين العابدين بعشرة آلاف فقبلها وبنى بها دار عقيل بن أبي طالب ودارهم التي هدمت، ثم بعد ذلك بعث إليه بأربعين ألف دينار فردها، وهذا الإنفاذ يستلزم الاعتقاد وأما رد الثانية فلعله لعلة عارضة اقتضت ذلك وهو لا ينافي صحة عقيدة المختار وأما تعليل رده إياها بقوله لا يقبل هدايا الكذابين فبعيد، إذ هذه العلة موجودة في الأولى وحاشا الإمام (عليه السلام)(@)(@)PageV01P514(@)(@)(@@) من هذا القول بعد قبول الأولى. أما نسبة الكيسانية إلى المختار لأن ذلك لقبه، وقد روي أنهم نسبوا إلى كيسان مولى علي بن أبي طالب (عليه السلام) ولو سلمنا أن ذلك لقبه وأنهم بالخروج معه سموا الكيسانية فلا يلزم أن يكون كيسانيا.(@)(@)(@@)(@@)(@@) $ 479 المرداس بن أثبية(@)(@)(@@) ى [جخ] خارجي لحق بمعاوية.(@)(@)(@@)(@@)(@@) $ 480 المرقع بالقاف، بن قمامة الأسدي(@)(@)(@@) ى [جخ] كيساني.(@)(@)(@@)(@@)(@@) $ 481 مروان بن يحيى(@)(@)(@@) ضا [جخ] مجهول.(@)(@)(@@)(@@)(@@) $ 482 مسروق(@)(@)(@@) ى [كش] كان عشارا لمعاوية ومات بعمله ذلك في موضعه بأسفل واسط على دجلة، كان مرائيا.(@)(@)(@@)(@@)(@@) $ 483 مسعدة بن صدقة(@)(@)(@@) قر، ق [جخ] عامي [كش] بتري.(@)(@)(@@)(@@)(@@) $ 484 مسلم(@)(@)(@@) مولى الحسين (عليه السلام) سين [جخ] مجهول.(@)(@)(@@)(@@)(@@) $ 485 مصادف(@)(@)(@@) مولى أبي عبد الله (عليه السلام)(@)(@)PageV01P515(@)(@)(@@) ق [غض] ليس بشيء وابنه 
ms171	 محمد ثقة.(@)(@)(@@)(@@)(@@) $ 486 مصدق بن صدقة(@)(@)(@@) [كش] فطحي.(@)(@)(@@)(@@)(@@) $ 487 مصعب بن يزيد الأنصاري(@)(@)(@@) ى [جش] ليس بذلك.(@)(@)(@@)(@@)(@@) $ 488 مصقلة بن هبيرة(@)(@)(@@) ى [جخ] هرب إلى معاوية.(@)(@)(@@)(@@)(@@) $ 489 المعتقل بن عمر الجعفي(@)(@)(@@) أبو عبد الله لم [غض] هو عندي في نفسه ثقة لكن أحاديثه كلها مناكير وليس يخلص من حديثه شيء يجوز أن يعول عليه.(@)(@)(@@)(@@)(@@) $ 490 معلى بن خنيس(@)(@)(@@) ، بالضم الخاء وفتح النون وسكون الياء المثناة تحت والسين المهملة، أبو عبد الله مولى الصادق (عليه السلام) ومن قبله كان مولى بني أسد ق [جش] كوفي بزاز، بالمعجمتين، ضعيف جدا لا يعول عليه [كش] أن الصادق (عليه السلام) شهد له بالجنة، ولما قتله داود بن علي كان قد أشهد الناس قبل قتله أن جميع ما تركه لأبي عبد الله (عليه السلام)،(@)(@)PageV01P516(@)(@)(@@) وقيل قاتله إسماعيل ولد الصادق (عليه السلام) بأمره [غض] الغلاة يضيفون إليه كثيرا ولا أرى الاعتماد على شيء من حديثه ونزهة الشيخ في كتاب الغيبة.(@)(@)(@@)(@@)(@@) $ 491 معلى بن راشد العمي(@)(@)(@@) بصري ضعيف غال.(@)(@)(@@)(@@)(@@) $ 492 معلى بن محمد البصري(@)(@)(@@) ، بالباء المفردة لم [جش] مضطرب الحديث والمذهب [غض] يعرف حديثه وينكر ويروي عن الضعفاء.(@)(@)(@@)(@@)(@@) $ 493 معمر(@)(@)(@@) قر [كش] من دعاة زيد.(@)(@)(@@)(@@)(@@) $ 494 معاوية بن حكيم(@)(@)(@@) [كش] فطحي.(@)(@)(@@)(@@)(@@) $ 495 المغيرة بن سعيد(@)(@)(@@) قر [كش] كوفي مذموم، روي عن الرضا (عليه السلام) أنه قال: كان يكذب على أبي جعفر، و(@@) روى عن أبي عبد الله (عليه السلام) أنه قال : المغيرة بن سعيد، لعنه الله، دس في كتب أصحاب أبي أحاديث لم يحدث بها أبي، فاتقوا الله و(@)(@)PageV01P517(@)(@)(@@) لا تقبلوا علينا ما خالف قول ربنا وسنة نبينا (صلى الله عليه وآله وسلم) فإنا إذا حدثنا قلنا قال الله عز وجل، قال رسول الله (صلى الله عليه وآله وسلم) [غض] خرج عليه أبو جعفر أنه يكذب علينا، وكان يدعو إلى محمد بن عبد الله بن الحسن في أول أمره.(@)(@)(@@)(@@)(@@) $ 496 المفضل بن صالح أبو جميلة(@)(@)(@@) السكوني وقيل الأسدي مولاهم النخاس، بالخاء المعجمة والسين المهملة ق، م كان 
ms172	 يضع الحديث. حدثنا أحمد بن عبد الواحد، عن علي بن محمد بن الزبير، قال حدثنا علي بن الحسن بن فضال قال: سمعت أبا جميلة يقول: أنا وضعت رسالة معاوية إلى محمد بن أبي بكر [جخ] مات في حياة الرضا (عليه السلام) [ست] كان نخاسا يبيع الرقيق، يقال إنه كان حدادا.(@)(@)(@@)(@@)(@@) $ 497 المفضل بن عمر(@)(@)(@@) ق، م [غض] ضعيف متهافت خطابي [جش]: مفضل بن عمر أبو عبد الله وقيل أبو محمد الجعفي كوفي فاسد المذهب مضطرب الرواية لا يعبأ به، و(@)(@)PageV01P518(@)(@)(@@) قيل كان خطابيا [كش] روى عن أبي الحسن (عليه السلام) أنه الوالد بعد الوالد و(@@) روي عن الصادق (عليه السلام) الثناء عليه والدعاء على حجر بن زائدة وعامر بن جذاعة حيث عاباه عنده حتى قال (عليه السلام): لا غفر الله لهما! أما إني لو كرمت عليهما لكرم عليهما من يكرم علي، ولقد كان كثير عزة في مودته لها أصدق منهما في مودتهما لي حيث يقول:(@)(@)(@@) لقد علمت بالغيب أني أحبها %~% إذا أنا لم يكرم على كريمها(@)(@)(@@) ثم قال [كش]: إنه رجع خطابيا بعد استقامته وحمل ما ورد في مدحه على حال استقامته أولا والله أعلم.(@)(@)(@@)(@@)(@@) $ 498 مقاتل بن سليمان البجلي(@)(@)(@@) وقيل البلخي صاحب التفسير قر، ق [جخ، كش] بتري [قي] عامي.(@)(@)(@@)(@@)(@@) $ 499 مقاتل بن مقاتل بن قياما(@)(@)(@@) ضا [جخ] واقفي خبيث.(@)(@)PageV01P519(@)(@)(@@)(@@)(@@) $ 500 ممويه بن معروف(@)(@)(@@) كر [جخ] ضعيف روى عنه محمد بن أحمد بن يحيى.(@)(@)(@@)(@@)(@@) $ 501 منخل بن جميل الأسدي(@)(@)(@@) بياع الجواري ق، م [جش] ضعيف فاسد الرواية [كش] متهم بالغلو [غض] أضاف إليه الغلاة أحاديث كثيرة.(@)(@)(@@)(@@)(@@) $ 502 مندل بفتح الميم، بن علي العتري(@)(@)(@@) ، بالعين المهملة والتاء المثناة فوق الساكنة، وقال بعض أصحابنا المفتوحة والأقوى عندي السكون، منسوب إلى عتر بن جشم بن ودم بن ذبيان بن هميم بن ذهل بن هيئ بن بلى بطن من بلى ق [جش] ثقة [قي] عامي.(@)(@)(@@)(@@)(@@) $ 503- 504 منذر بن أبي طريفة ومنذر السراج(@)(@)(@@) قر [جخ] مجهولان.(@)(@)(@@)(@@)(@@) $ 505 منصور بن العباس أبو الحسن(@)(@)(@@) الرازي لم 
ms173	 [جش] سكن بغداد ومات بها، كان مضطرب الأمر.(@)(@)PageV01P520(@)(@)(@@)(@@)(@@) $ 506 منصور بن المعتمر(@)(@)(@@) قر [جخ] بتري.(@)(@)(@@)(@@)(@@) $ 507 منصور بن يونس القرشي(@)(@)(@@) مولاهم يكنى أبا يحيى، يقال له بزرج، بضم الباء والزاي وإسكان الراء بعدها جيم ق، م [جخ] واقفي [جش] ثقة وغمز فيه [كش].(@)(@)(@@)(@@)(@@) $ 508 موسى بن أشيم(@)(@)(@@) ، بالشين المعجمة والياء المثناة تحت قر [جخ] غال خبيث.(@)(@)(@@)(@@)(@@) $ 509 موسى بن جعفر الكمنداني(@)(@)(@@) ، بضم الكاف والميم وسكون النون والذال المعجمة والنون بعد الألف أبو علي [جش] من قرية من قرى قم، كان مرتفعا في القول ضعيفا في الحديث.(@)(@)(@@)(@@)(@@) $ 510 موسى بن حماد الطيالسي(@)(@)(@@) [كش] واقفي ذكره ابن نوح وقال ذكره محمد بن الحسين بن أبي الخطاب وقال هو موسى بن حماد الذراع.(@)(@)(@@)(@@)(@@) $ 511 موسى بن رنجويه(@)(@)(@@) ، بالراء والنون والجيم، أبو عمران الأرمني لم [جش] ضعيف له كتاب أكثره عن عبد الله بن الحكم.(@)(@)(@@)(@@)(@@) $ 512 موسى بن سعدان الحناط(@)(@)(@@) ، بالحاء المهملة والنون(@)(@)PageV01P521(@)(@)(@@) م [جش] ضعيف في الحديث كوفي.(@)(@)(@@)(@@)(@@) $ 513 موسى السواق(@)(@)(@@) [كش] غال.(@)(@)(@@)(@@)(@@) $ 514 موسى بن عمير الهذلي(@)(@)(@@) ق [جش] عامي.(@)(@)(@@)(@@)(@@) $ 515 مياح(@)(@)(@@) ، بالياء المثناة تحت وكسر الميم وقيل بفتحها المدائني [جش] ضعيف جدا، له رسالة طريقها أضعف منها.(@)(@)(@@)(@@)(@@) $ 516 ميمون القداح(@)(@)(@@) ين، ق [جخ] ملعون.(@)(@)(@@)(@@)(@@) || باب النون(@)(@@)(@@)(@@) $ 517 نصر بن الصباح أبو القاسم(@)(@)(@@) من أهل البلخ لم [كش، غض] غال.(@)(@)(@@)(@@)(@@) $ 518 نصر بن مزاحم المنقري(@)(@)(@@) العطار أبو الفضل [جش] كوفي مستقيم لكنه يروي عن الضعفاء.(@)(@)(@@)(@@)(@@) $ 519 النضر، بالضاد المعجمة، بن عثمان، النواء(@)(@)(@@) [عق] مات متحيرا.(@)(@)(@@)(@@)(@@) $ 520 نفيع بن الحارث أبو داود(@)(@)PageV01P522(@)(@)(@@) السبيعي الهمداني قر [غض] روى مناكيره وتوقف في حديثه.(@)(@)(@@)(@@)(@@) $ 521 نوفل بن فروة(@)(@)(@@) بالفاء والراء والواو الأشجعي ى [جخ] خارجي ملعون، ومن أصحابنا من قال: إنه ابن قرة وهو وهم.(@)(@)(@@)(@@)(@@) || باب الواو(@)(@@)(@@)(@@) $ 522 الوليد بن بشير(@)(@)(@@) قر [كش] مجهول.(@)(@)(@@)(@@)(@@) $ 523 وهب بن وهب بن عبد الله(@)(@)(@@) بن زمعة بن الأسود بن المطلب بن أسد بن عبد العزى، أبو البختري، بالخاء المعجمة قر، ق [ست] ضعيف عامي المذهب تزوج أبو عبد الله 
ms174	 (عليه السلام) بأمه، كان قاضي القضاة ببغداد [غض] كذاب عامي قضى لهارون [جش] كان كذابا له أحاديث مع الرشيد في الكذب [كش] عن الفضل بن [شاذان] أنه قال: كان أبو البختري من أكذب البرية.(@)(@)PageV01P523(@)(@)(@@)(@@)(@@) || باب الهاء(@)(@@)(@@)(@@) $ 524 هارون الجبلي(@)(@)(@@) ، بالجيم والباء المفردة قر [جخ] مجهول.(@)(@)(@@)(@@)(@@) $ 525 هارون بن سعد العجلي(@)(@)(@@) [كش] زيدي.(@)(@)(@@)(@@)(@@) $ 526 هارون بن مسلم بن سعدان(@)(@)(@@) الكاتب السرمنرآئي، كان نزلها وأصله الأنبار، ويكنى أبا القاسم [جش] ثقة وجه كان له مذهب في الجبر والتشبيه دي، كر.(@)(@)(@@)(@@)(@@) $ 527 هاشم بن أبي هاشم(@)(@)(@@) قر [جخ] مجهول [كش] ملعون.(@)(@)(@@)(@@)(@@) $ 528 هبة الله بن أحمد بن محمد(@)(@)(@@) الكاتب أبو نصر يعرف بابن برنية، بالباء المفردة والراء الساكنة والنون المكسورة والياء المثناة تحت المشددة لم زيدي يقول: إن الأئمة ثلاثة عشر مع زيد بن علي.(@)(@)(@@)(@@)(@@) $ 529 هشام بن إبراهيم العباسي(@)(@)(@@) ، بالباء المفردة والسين المهملة(@)(@)PageV01P524(@)(@)(@@) ، صاحب يونس [غض] طعن عليه، والطعن عندي في مذهبه لا في ثقته.(@)(@)(@@)(@@)(@@) $ 530 هشام الرماني(@)(@)(@@) قر [جخ] مجهول.(@)(@)(@@)(@@)(@@) $ 531 هشام بن الحكم(@)(@)(@@) ، لا مراء في جلالته لكن البرقي نقل فيه غمزا لمجرد كونه من تلاميذ أبي شاكر الزنديق، ولا اعتبار بذلك وإن كان قد وقع في ألفاظه شيء يؤول يخرجه عن الطعن لبعده عن الشبهة.(@)(@)(@@)(@@)(@@) || باب الياء(@)(@@)(@@)(@@) $ 532 يحيى بن الحسين بن زيد(@)(@)(@@) بن علي بن الحسين م [جخ] واقفي.(@)(@)(@@)(@@)(@@) $ 533 يحيى بن زكريا النرماشيري(@)(@)(@@) أبو الحسين [جش] كان مضطربا في مذهبه ارتفاع.(@)(@)(@@)(@@)(@@) $ 534 يحيى بن سالم الفراء(@)(@)(@@) [جش] كوفي زيدي ثقة.(@)(@)PageV01P525(@)(@)(@@)(@@)(@@) $ 535 يحيى بن سعيد القطان(@)(@)(@@) أبو زكريا ق [كش] عامي ثقة.(@)(@)(@@)(@@)(@@) $ 536 يحيى بن عباس الوراق(@)(@)(@@) ضا [جخ] مجهول، ومن أصحابنا من أثبته ابن مياس وهو تحريف.(@)(@)(@@)(@@)(@@) $ 537 يحيى بن أبي القاسم أبو بصير(@)(@)(@@) الأسدي وقيل أبو محمد الحذاء ق، م [جش] قر، ق [كش] واقفي [جش] ثقة وجه [فض]: أما الغلو فلا ولكن كان مخلطا. واسم أبي القاسم إسحاق.(@)(@)(@@)(@@)(@@) $ 538 يحيى بن يحيى التميمي(@)(@)(@@) ضا [جخ] عامي.(@)(@)(@@)(@@)(@@) $ 539 يزيد بن خليفة الحارثي(@)(@)(@@) ، وليس من بني الحارث 
ms175	 ولكنه من بني إخوة الحارث، وعدادهم فيهم [كش] أمه تحت بلحارث بن كعب.(@)(@)(@@)(@@)(@@) $ 540 يزيد الصائغ(@)(@)(@@) ، بالغين المعجمة(@)(@)PageV01P526(@)(@)(@@) ق، م [جخ] واقفي.(@)(@)(@@)(@@)(@@) $ 541 يعقوب بن شبيه(@)(@)(@@) ، بالباء المفردة والياء المثناة تحت، صاحب حديث، من العامة غير أنه صنف مسند أمير المؤمنين (عليه السلام).(@)(@)(@@)(@@)(@@) $ 542 يوسف بن الحارث(@)(@)(@@) يكنى أبا بصير قر [جخ، كش] بتري.(@)(@)(@@)(@@)(@@) $ 543 يوسف بن حماد قيراط(@)(@)(@@) [كش] كوفي ضعيف.(@)(@)(@@)(@@)(@@) $ 544 يوسف بن السخت(@)(@)(@@) ، بالسين المهملة والخاء المعجمة البصري لم [جخ، غض] ضعيف.(@)(@)(@@)(@@)(@@) $ 545 يوسف بن يعقوب الجعفي(@)(@)(@@) [جخ] م [كش] ق كوفي ضعيف [غض] مرتفع القول.(@)(@)(@@)(@@)(@@) $ 546 يونس بن بهمن(@)(@)(@@) ، بالباء المفردة [غض] ق غال كوفي يضع الحديث.(@)(@)(@@)(@@)(@@) $ 547 يونس بن خباب(@)(@)(@@) قر [جخ] مجهول.(@)(@)(@@)(@@)(@@) $ 548 يونس بن ظبيان(@)(@)(@@) ق [جخ، غض] كوفي كذاب وضاع الحديث [جش] مولى ضعيف جدا لا يلتفت إلى روايته، كل كتبه تخليط [كش] عن محمد بن مسعود: متهم(@)(@)PageV01P527(@)(@)(@@) غال. و(@@) روي أن الكاظم (عليه السلام) لعنه ألف لعنة يتبعها ألف لعنة، كل لعنة منها تبلغه قعر جهنم.(@)(@)(@@)(@@)(@@) $ 549 يونس بن عبد الله(@)(@)(@@) فطحي روي عن الكاظم (عليه السلام) في تعظيمه والترحم عليه والشهادة له بحسن الخاتمة ما ينافي ذلك.(@)(@)(@@)(@@)(@@) $ 550 يونس بن عبد الرحمن(@)(@)(@@) مولى علي بن يقطين م، ضا [جخ] طعن عليه القميون وهو عندي ثقة [يه] سمعت محمد بن الحسن بن الوليد يقول: كتب يونس التي هي بالروايات صحيحة، معتمد عليها إلا ما يتفرد به محمد بن عيسى بن عبيد عن يونس ولم يروه غيره فإنه لا يعتمد عليه ولا يفتي به [كش] فطحي.(@)(@)(@@)(@@)(@@) || فصل في ذكر جماعة من الواقفة ذكرتهم نسقا ليتحفظوا ويستحصروا.(@)(@@)(@@)(@@) $ إبراهيم بن أبي بكر بن الربيع بن أبي السمال وأخوه إسماعيل(@)(@)(@@) .(@)(@)PageV01P528(@)(@)(@@)(@@)(@@) $ إبراهيم بن شعيب(@)(@)(@@) [كش].(@)(@)(@@)(@@)(@@) $ إبراهيم بن صالح الأنماطي(@)(@)(@@) [جش].(@)(@)(@@)(@@)(@@) $ إبراهيم بن عبد الحميد(@)(@)(@@) [ست].(@)(@)(@@)(@@)(@@) $ أحمد بن أبي بشر السراج(@)(@)(@@) أبو جعفر.(@)(@)(@@)(@@)(@@) $ أحمد بن الحارث الأنماطي(@)(@)(@@)(@@)(@@) $ . أحمد بن الحسن بن إسماعيل(@)(@)(@@) بن شعيب بن ميثم التمار.(@)(@)(@@)(@@)(@@) $ أحمد بن الحسن القزاز(@)(@)(@@) البصري.(@)(@)(@@)(@@)(@@) $ أحمد بن زياد الخزاز(@)(@)(@@) بالمعجمات. 
