ms451	 %~% گر ندارد دیده زیر نعل اسب اوستان(@)(@@) 31 از برای کرد او را آید اندر چشم نور %~% از برای گفت او را آید اندر جسم جان(@)(@@) 32 تا ببام آسمانش برد بخت از راه علم %~% این نکوتر باز کآتش در زد اندر نردبان(@)(@@) 33 زیر سایه آفتاب دولت‌ست آن ماه روی %~% روشن آن ماهی که باشد آفتابش سایبان(@)(@@) 34 شاد باش ای منحنی پشت تو اندر راه دین %~% دیر زی ای ممتحن خصم تو اندر امتحان(@)(@@) 35 تا طبیعت زعفران را رنگ اعدای تو دید %~% مایه شادی جدا کرد از مزاج زعفران(@)(@@) 36 چون مسائل حل کنی شیری بوی دشمن شکار %~% چون به منبر بر شوی بحری بوی گوهر فشان(@)(@@) 37 منبر از تو زیب گیرد نه تو از منبر از آنک %~% کان ز گوهر سرفرازی یافت نه گوهر ز کان(@)(@@) 38 بود بتخانه گروهی ساحت بیت الحرام %~% بود بدعت جای قومی بقعت شالنکیان(@)(@@) 39 این دو موضع چون ز دیدار دو احمد نور یافت %~% قبله سنت شد این و کعبه خدمت شد آن(@)(@@) 40 قبله دین امامان خاندان تست و بس %~% دیر زی ای شاه خانه شاد باش ای خاندان(@)(@@) 41 هر که دین خواهد که دارد چون شما باید خطر %~% هر که در خواهد که دارد چون صدف باید دهان(@)(@@) 42 خاک و بادی کان نیابد خلعت و تایید حق %~% این عنای مغز باشد آن هلاک خاندان(@)(@@) 43 شیر اصلی معنی اندر سینه دارد همچو خاک %~% شیر رایت باشد آن کو باد دارد در میان(@)(@@) 44 لاجرم آنرا که بادی بود چون اینجا رسید %~% خاک این در کرد بیرون بادشان از بادبان(@)(@@) 45 تا جمال خانه حدادیان باشد به جای %~% هیچ دین دزدی نیارد گشت در گیتی عیان(@)(@@) 46 زان که ایشان شمسه دینند اندر عین شب %~% دزد متواری شود چون شمس باشد پاسبان(@)(@@) 47 من غلام آستانی ام که بویی خاک او %~% تا به پشت گاو ماهی 
ms452	 بوی دل آید از آن(@)(@@) 48 ای ترا پرورده ایزد بهر دین اندر ازل %~% بخت و اقبال ازل پرورد را نبود کران(@)(@@) 49 از پی بخت ازل را فرخی در شعر خویش %~% پیش ازین گفتست بیتی من همی گویم همان(@)(@@) 50 یک بختی هر کرا باشد همه زان سر بود %~% کار از آن سر نیک باید گر نمی‌دانی بدان»(@)(@@) 51 تا ببینی کز برای خدمتت گردد فلک %~% از پس کسب سنا را چون سنایی مدح خوان(@)(@@) 52 حرمتی‌یابی چنان گر فی‌المثل در صف حرب %~% تیر دشمن پیشت آید چفته گردد چون کمان(@)(@@) 53 آنچنان گردی ز دانش کز برای دین حق %~% فتوی از صدرت برد خورشید سوی قیروان(@)(@@) 54 این همه رتبت ز یک تاثیر صبح بخت تست %~% باش تا خورشید اقبالت بتابد ز آسمان(@)(@@) 55 کز برای خدمتت را ماه بگزیند زمین %~% وز برای حرمتت را حور در بازد جنان(@)(@@) 56 رو که تایید سپهر و دانش کلی‌تر است %~% با چنین تایید و دانش مقتدا بودن توان(@)(@@) 57 تا نباشد گاه کوشش تیغ شهلان چون رماح %~% تا نباشد وقت بخشش تیر گردون چون کمان(@)(@@) 58 چون طریقت کارخواه و چون حقیقت کارکن %~% چون شریعت کار جوی و چون طبیعت کامران(@)(@@) 59 باد همچون دور همنام تو دورت پایدار %~% باد همچون دین همنام تو عمرت جاودان PageV1P0573(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 بنه چوگان ز دست ای دل که گمشد گوی در میدان %~% چه خیزد گوی تنهایی زدن در پیش نامردان(@)(@@) 2 چو گویی در خم چوگان فگن خود را به حکم او %~% که چوگانی‌ست از تقدیر و میدانیست از ایمان(@)(@@) 3 بدین چوگان مدارا کن وز آن میدان مکافا بین %~% چو این کردی و آن دیدی شوی چون گوی سرگردان(@)(@@) 4 ز خود تا گم نگردی باز هرگز نیست این ممکن %~% که بینی از ره حکمت جمال حضرت سلطان(@)(@@) 5 نه سید بود کز هستی شبی گمشد درین منزل %~% رسید آنجا کزو 
ms453	 تا حق کمانی بود و کمتر زان(@)(@@) 6 تو تا از ذوق آب و نان رکاب اینجا گران داری %~% پی عیسی کجا یابی برون از هفت و چهار ارکان(@)(@@) 7 خبر بادیست پر پیمای اثر خاکیست دور از وی %~% نظر راهیست پر منزل عیان را باش چون اعیان(@)(@@) 8 تو موسی باش دین‌پرور که پیش مبغض و اعدا %~% پدید آید به رزم اندر ز چوب خشک صد ثعبان(@)(@@) 9 تو صاحب سر کاری شو که هرچت آرزو باشد %~% همه آراسته بینی چو یازی دست زی انبان(@)(@@) 10 نبینی هیچ ویرانی در اطراف جهان دل %~% چو کردی قبله دین را به زهد و ترس آبادان(@)(@@) 11 سلیم و بارکش می‌باش تا عارض بروز دین %~% کند عرضه ترا بر حق میان زمره نیکان(@)(@@) 12 کزین دریافت سر دل امین در کوی تاریکی %~% وزین بشنود بوی جان برون از آب و گل سلمان(@)(@@) 13 همه در دست کار دین همه خونست راه حق %~% ازین درد آسمان گردان وز آن خون حلقها قربان(@)(@@) 14 ز روی عقل اگر بینی گمانی کان یقین گردد %~% به معیار عیاری بر ببین تا چون بود میزان(@)(@@) 15 اگر بر عقل چرب آید یقین دان کان گمان باشد %~% وگر در شرع افزاید گمان بر کان بود فرمان(@)(@@) 16 خضر زین راه شد در کوی کابی یافت جان پرور %~% سکندر از ره دیگر برون آمد چو تابستان(@)(@@) 17 همه دادست بی دادی چو تو در کوی دین آیی %~% همه شادیست غم خوردن چو دانی زیست با هجران(@)(@@) 18 چو بوتیمار شو در عشق تا پیوسته ره جویی %~% چو بلبل بر امید وصل منشین هشت مه عریان(@)(@@) 19 اگر خواهی که تا دانی که از دریاچه می‌زاید %~% به همت راه بر می‌باش بر امید کشتیبان(@)(@@) 20 چو نور از طور می‌تابد تو از آهن کجا یابی %~% برو بر تجربت بر طور چون موسی‌بن عمران(@)(@@) 21 اگر سلمان همی خواهی که گردی 
ms454	 رو مسلمان شو %~% که بی رای مسلمانی بمیری در بن زندان(@)(@@) 22 مرو در راه هر کوری اگر مردی برین هامون %~% که گمراهی برون آیی بسی گمره‌تر از هامان(@)(@@) 23 نه هر آهو که پیش آید بود در ناف او نافه %~% نه هر زنده که تو بینی بود در قالب او جان(@)(@@) 24 بسی آهو در عالم که مشکش نیست در ظاهر %~% بسی شخصست در گیتی که جانش نیست در ابدان(@)(@@) 25 نه جان خود زندگی باشد غلط زینجاست غافل را %~% که جان دریست در خلقت ز بهر زینت جانان(@)(@@) 26 هر آنکو نور جان بیند شود سخته چو پروانه %~% هر آنکو مرز جان داند نباشد فارغ از احزان(@)(@@) 27 بپر عشق شو پران که عنقاوار خود بینی %~% ز ناجنسان جداییها و با جنسان بهم چسبان(@)(@@) 28 شراب شوق چندان خور که پای از ره برون ننهی %~% که چون از ره برون رفتی تا خمارت گیرد از شیطان(@)(@@) 29 تو بر ره چو اصحابی که خود میریست مر ره را %~% چه عیب آید اگر باشند آن اصحاب سگبانان(@)(@@) 30 هم از درد دل ایشان برون آمد سگی عابد %~% هم از خورشید تابانست لعل سرخ اندر کان(@)(@@) 31 شعاع روی مردی بود و شمع وقت بسطامی %~% نهاد بوی دردی بود و رنگ سالک گریان(@)(@@) 32 ز روی درد این رهرو مبین آلت کانون %~% ز نور روی آن مه بین مزین قامت کیوان(@)(@@) 33 همه اکرام و احسان‌ست سیلی خوردن اندر سر %~% چه باشد گر کنی در پیش جانان جان و تن قربان(@)(@@) 34 چو عالم جمله منکر شد چرا دارد خرد طرفه %~% اگر پیری خبر گوید که آید عاقبت طوفان(@)(@@) 35 کنون طوفان مردانست و آنک طرف گل در گل %~% کنون بازار شیطانست و آنک موعد دیوان(@)(@@) 36 زنی کو عده دین داشت آنجا مردوار آمد %~% تنی کو مده کین بود با وی کی رود یکسان(@)(@@) 37 حسن در بصره پر 
ms455	 بینند لیکن در بصر افزون %~% بدن در کعبه پر آیند لیکن در نظر نقصان(@)(@@) 38 ز یثرب علم دین خیزد عجب اینست در حکمت %~% که صاحب همتان آیند از بنیاد ترکستان(@)(@@) 39 صهیب از روم می‌پوید به عشق مصطفا صادق %~% هشام از مکه می‌جوید صلیب و آلت رهبان(@)(@@) 40 دلا آنجا که انصافست خود از روم دل خیزد %~% تنا آنجا که اعلامست از کعبه بود خذلان(@)(@@) 41 نه در کعبه مجاور بود چندین سالها بلعم %~% نه در کوی ضلالت بود چندین روزها عثمان(@)(@@) 42 نه از ترتیب عقل افتد سخن در خاطر عیسی %~% نه بر تقدیر حرف آید معانی ز آیت قرآن(@)(@@) 43 سماع روح عاشق را نه از نقل آورد ناقل %~% شعاع شمع حکمت را نه از عقل آورد یزدان(@)(@@) 44 هر آنک اندر سماع آید همه علمش هدر گردد %~% هر آنک اندر شعاع افتد شود دیوانه در گیهان(@)(@@) 45 ولیک از کار و بار این اثر یابد جهان دل %~% بلی در ذکر علم آن ثناخواند بسی حسان(@)(@@) 46 جگرها خون شد و پالود تا باشد کزین معنی %~% خبر یابد مگر یک دل شود در آسمان پران(@)(@@) 47 چه جای این هوس باشد که بگذشت اینهمه لشکر %~% پی مرکب رها کردند تا پیدا بود پنهان(@)(@@) 48 خرابی در ره نفست و در میل طریق تن %~% وگر در حصن جان آیی همه شهرست و شهرستان(@)(@@) 49 بهشت اینجا بنا کردست شداد از پی شادی %~% خبر زان خانه خرم که می‌آرد یک اشتربان(@)(@@) 50 ز هول سیل عالم بر شده ایمن لب کشتی %~% ز روح نوح پیغمبر شده بی قوت دین کنعان(@)(@@) 51 سواری می‌کند عیسی و بار حکم او بر خر %~% ز طعم منزل اندر دل نه خر آگاه و نه پالان(@)(@@) 52 چه راهست ای سنایی این که با مرغان خود یک دم %~% خبر گویی و جان جویی بلا خواهی تو بی امکان(@)(@@) 53 مگر ز آواز مرغانت نداند 
ms456	 کس جز این سید %~% که فخر اهل ری اویست و تاج صدر اصفاهان(@)(@@) 54 امینی رهروی کو را رضا گویند در دنیا %~% ازو راضی رضا در حشر و با او مصطفا همخوان PageV1P0574(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ویحک ای پرده پرده‌در در ما نگران %~% بیش از این پرده ما پیش هر ابله مدران(@)(@@) 2 یا مدر یا چو دریدی چو لئیمان بمدوز %~% یا مخوان یا چو بخواندی چو بخیلان بمران(@)(@@) 3 جای نوری تو و ما از تو چو تاریک دلان %~% آب گویی تو و ما از تو پر آتش جگران(@)(@@) 4 ماهت ار نور دهد تری آبست درو %~% مشک ار بوی دهد خشکی نارست در آن(@)(@@) 5 شیشه باده روشن ندهی تا نکنی %~% روز ما تیره‌تر از کارگه شیشه‌گران(@)(@@) 6 شرم دار ای فلک آخر مکن این بی رسمی %~% تا کی از پرورش و تربیت بد سیران(@)(@@) 7 از تو و گردش چرخت چه هنر باشد پس %~% چون تهی دست بوند از تو همه پر هنران(@)(@@) 8 عمر ما طعمه دوران تو شد بس باشد %~% نیز هر ساعتمان شربت هجران مخوران(@)(@@) 9 هر که یکشب ز بر زن بود از روی مراد %~% سالی از نو شود از جلمه زیر و زبران(@)(@@) 10 خواستم از پی راحت زنی آخر از تو %~% آن بدیدم که نبینند همه بی‌خبران(@)(@@) 11 این ز تو در خورد ای مادر زندانی زای %~% ما به زندان و تو از دور به ما در نگران(@)(@@) 12 مر پسر را به تو امید کجا ماند پس %~% همه چون فعل تو این باشد بر بی‌پدران(@)(@@) 13 چون به زن کردنی این رنج همی باید دید %~% اینت اقبال که دارند پس امروز غران(@)(@@) 14 ما غلام کف دستیم بس اکنون که ز عجز %~% مانده‌اند از پس یک ماده برینگونه بران(@)(@@) 15 نه تویی یوسف یعقوب مکن قصه دراز %~% یوسفان را نبود چاره ازین بد گهران(@)(@@) 16 یوسف مصری ده سال ز زن 
ms457	 زندان دید %~% پس ترا کی خطری دارند این بی‌خطران(@)(@@) 17 آنکه با یوسف صدیق چنین خواهد کرد %~% هیچ دانی چکند صحبت او با دگران(@)(@@) 18 حجره عقل ز سودای زنان خالی کن %~% تا به جان پند تو گیرند همه پر عبران(@)(@@) 19 بند یک ماده مشو تا بتوانی چو خروس %~% تا بوی تاجور و پیش رو تاجوران(@)(@@) 20 خاصه اکنون که جهان بی‌خردان بگرفتند %~% بی‌خرد وار بزی تا نبوی سرد و گران(@)(@@) 21 کار چون بی‌خردی دارد و بی‌اصلی و جهل %~% وای پس بر تو و آباد برین مختصران(@)(@@) 22 طالع فاجری و ماجری امروز قویست %~% هر که امروز بر آنست بر آنست برآن(@)(@@) 23 مر که پستان میان پای نداد او را شیر %~% نیست امروز میان جهلا او ز سران(@)(@@) 24 هر که لوزینه شهوت نچشیدست ز پس %~% نیست در مجلس این طایفه از پیشتران(@)(@@) 25 آنکه بودست چو گردون به گه خردی کوژ %~% لاجرم هست درین وقت ز گردون سپران(@)(@@) 26 بی‌نفیرست کسی کش نفر از جهل و خطاست %~% جهد کن تا نبوی از نفر بی‌نفران(@)(@@) 27 روزگاریست که جز جهل و خیانت نخرند %~% داری این مایه و گر نه خر ازین کلبه بران(@)(@@) 28 سپر تیر زمان دیده شوخست و فساد %~% جهد کن تات نبیند فلک از پی سپران(@)(@@) 29 شاید ار دیده آزاده گهر بار شود %~% چون شدستند همه بی‌گهران با گهران(@)(@@) 30 باز دانش چو همی صید نگیرد ز اقبال %~% پیشش از خشم در اطراف ممالک مپران(@)(@@) 31 معنی اصل و وفایش مجوی از همه کس %~% زان که هستند ز بستان وفا بی‌ثمران(@)(@@) 32 اندرین وقت ز کس راه صیانت مطلب %~% که سر راه برانند همه راهبران(@)(@@) 33 بی‌خبروار در این عصر بزی کز پی بخت %~% گوی اقبال ربودند همه بی‌خبران(@)(@@) 34 با چنین قول و چنین فعل که این دونان راست %~% رشک بر می‌آیدم ای خواجه ز کوران و کران(@)(@@) 35 چون سرشت همه 
