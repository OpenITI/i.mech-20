ms1121	 % 225(@)(@@) % ترفع كالمصباح في ذروة العلم % % سما عن سفال الأرض نحو سمائه % % 226(@)(@@) % فكشف عن أفاقها عاصب القتم % % ولم يره الراؤون من قبل موتها % % 227(@)(@@) % بحيث بدا لا المعربون ولا العجم % % وإني وقد زودتني منك لوعة % % 228(@)(@@) % محالفة للقلب ما أورق السلم % % لتسلينني الأيام لا أن لوعتي % % 229(@)(@@) % ولاحزني كالشيء يبلى على القدم % % سأنثو ثناك الخير لامتزيدا % 230(@)(@@) % على ماجرى بين الصحيفة والقلم % ومابي قرباك القريبة إنه % % PageV01P4266 231(@)(@@) % بعيد من الأحياء من سكن الرجم % % طوى الموت أسباب المحاباة بيننا % % 232(@)(@@) % فلست وإن أطنبت فيك بمتهم % % لعمري وعمري بعدك الآن هين % 233(@)(@@) % علي ولكن عادة عادها القسم % % لقد فجعت منك الليالي نفوسها % % 234(@)(@@) % بمحيية الأسحار حافظة العتم % % ولم تخطيء الأيام فيك فجيعة % 235(@)(@@) % بصوامة فيهن طيبة الطعم % % وفات بك الأيتام حصن كنافة % 236(@)(@@) % دفيء عليهم لية القر والشبم % % رجعنا وأفردناك غير فريدة % 237(@)(@@) % من البر والمعروف والخير والكرم % % فلا تعدمي أنس المحل فطالما % % 238(@)(@@) % عكفت وآنست المحاريب في الظلم % % كست قبرك الغر المباكير حلة % 239(@)(@@) % مفوفة من صنعة الوبل والديم % % لها أرج بعد الرقاد كأنما % % 240(@)(@@) % يحدث عما فيك من طيب الشيم % % ن % PageV01P4267 البحر : - 1(@)(@@) % كم جارع جرع المكاره عالما % أن المكاره يكتسين مكارما % % 2(@)(@@) % ياصاحبا رضي النذالة صاحبا % وغدا يعد مؤاكيله أراقما % % 3(@)(@@) % قد كان للجود المبين حاتم % وأراك للبخل المبين حاتما % % 4(@)(@@) % أبغضت من طعم الطعام فريقه % % سم لديك فما تجامل طاعما % 5(@)(@@) % أئن اصطبغت ولقمتي معضوضة % أنشأت تهجوني بذلك ظالما % % 6(@)(@@) % عيب لعمرك غير أن لم آته % % عمدا فهبني هافيا لاجارما % % 7(@)(@@) % ما زلت تنكح في شبابك غانما % والآن تنكح في مشيبك غارما % 7(@)(@@) % ولأنت إذا راعيت كف مؤاكل بعض النفار من البصاق فربما غذيت به استك باركا أو قائما ما زلت تنكح في شبابك غانما والآن تنكح في مشيبك غارما % أولى بأن تهجى وأكثر لائما % % 7(@)(@@) % بعض النفار من البصاق فربما % غذيت به استك باركا أو قائما % 8(@)(@@) % وكذا المؤاجر في الشبيبة لا يني % % أبدا له دبر 
ms1122	 يرد مظالما % % PageV01P4268 9(@)(@@) % رشفوا المني من الفياش وحرموا % % ريق الصديق مؤكلا ومنادما % % 9(@)(@@) % قبح الإله معاشرا لم يسلموارشفوا المني من الفياش وحرمواريق الصديق مؤكلا ومنادما بذيء % % مما يعيبهم فعابوا السالما % % 10(@)(@@) % اعلم ويأبى فرط جهلك أن ترى % % ما عشت إلا جاهلا لاعالما % % 11(@)(@@) % أن قد نزعت عن انبساطي نادما % ولتنزعن عن اعتدائك نادما % % 12(@)(@@) % لوكان ريقي مثل ريقك قاتلا % ألفيتني متنبها لانائما % 13(@)(@@) % وخشيت ربي أن أسم موحدا % ظلما فأكتسب العذاب الدائما % % 14(@)(@@) % لكنه ريق وثقت بطهره % ثقة سهوت لها فثرت مخاصما % 15(@)(@@) % هلا لفيتك عند أول زلة % مني كريم العفو أو متكارما % % 16(@)(@@) % لكن أبى كرم اللئام مدبر % منع الخوافي أن تكون قوادما % % 17(@)(@@) % فاسفل سفالك ماحييت فلم تكن % لتكون أعقاب الرجال جماجما % % PageV01P4269 البحر : - 1(@)(@@) % أمرتجع في كل يوم صنيعة % تجنى على مولاك فيها الجرائما % % 2(@)(@@) % حنانيك علقها عليك قلادة % وعلق عليها إن أثرت التمائما % % 3(@)(@@) % فلست بباك عهدها عند ذاكم % لشيء وإن أبكى الربيع الحمائما % % 4(@)(@@) % لعمري لقد سفهت بالأمس راتعا % % وضللت مرتادا وخطئت سائما % % 5(@)(@@) % لعمري لقد ذكرت مني ناسيا % وحركت ذا سهو وأيقظت نائما % % 6(@)(@@) % أنلت فكان المدح مني مثوبة % فنولت مقطوعا ونولت دائما % % 7(@)(@@) % أما لقد استثقلت يابن محمد % مغارم كانت لو فقهت غنائما % % PageV01P4270 البحر : - 1(@)(@@) % نحن ميامين على أننا % % على أعاديك مشائيم % 2(@)(@@) % لما دخلنا دخلت نعمة % كان لها حولك تحويم % % 3(@)(@@) % ولم يفخمك الذي نلته % بل للعطايا بك تفخيم % % 4(@)(@@) % قل لك الملك ولو أنه % مجموعة فيه الأقاليم % 5(@)(@@) % نعم المفاتيح وقد قدرت % مثل المفاتيح الخواتيم % 6(@)(@@) % والله يبقيك لنا سالما % برداك تبجيل وتعظيم % % PageV01P4271 البحر : - 1(@)(@@) % وسيد قد غمرتني أنعمه % يحلم عني وتحوم حومه % 2(@)(@@) % حولي وقد لظاه نقم ينقمه % لكنه ينهاه عني كرمه % % 3(@)(@@) % وإنني ممن حماه حرمه % وهم جرما ليس مثلي يجرمه % % 4(@)(@@) % وهم عني قد عزمت أشتمه % % وذاك عزم ليس مثلي يعزمه % % 5(@)(@@) % بل إنما يشتمه موهمه % % أقسمت إن أقدمت أني أظلمه % % 6(@)(@@) % يعفو كلومي دائبا فأكلمه % % أني لأخنى قائل 
ms1123	 وألأمه % % 7(@)(@@) % إن كان ذاك الثلم مما أثلمه % صبحني الله لغرم أغرمه % % 8(@)(@@) % إن كان ذاك الغيب غيبا يعلمه % % وهو الذي لا ينطوي ما أكتمه % % 9(@)(@@) % عنه ولا يغفل عني قلمه % % ولاتزال ثقتي تستعصمه % % 10(@)(@@) % فلا شفاني من سقام ألمه % % أو أجرع الموت مذوقا علقمه % % PageV01P4272 11(@)(@@) % بحسرتي على شفاء أعدمه % % بل أنا والله الذي أسترحمه % % 12(@)(@@) % مما يسدي كاشحي ويلحمه % % مبرأ المغمر لا متهمه % % 13(@)(@@) % عند همام ذبنته هممه % % في أفق تقصر عنه أنجمه % PageV01P4273 البحر : - 1(@)(@@) % بغضي لصاد أنني رجل % أصفي المودة مني للحواميم % % 2(@)(@@) % وليس بغضي لقرآن ولامقتي % % إياه تالله بل للصاد والميم % PageV01P4274 البحر : - 1(@)(@@) % كفى البدء منك العود في كل موطن % وجردت للجلى وكنت حساما % % 2(@)(@@) % فما لك تنبو في يدي عن ضريبتي % % ولم اوت من وهن ولست كهاما % % 3(@)(@@) % نوالك إني لم أشم بك خلبا % % كذوبا ولااستسقيت منك جهاما % % 4(@)(@@) % ودع ذكر حرماني فما أنت بالذي % % ترى قتل حرمان العفاة حراما % % 5(@)(@@) % ينام الذي استسعاك في الأمر إنه % % إذا أيقظ الملهوف مثلك ناما % % PageV01P4275 البحر : - 1(@)(@@) % يا أبا الفضل ريع شامطياقي % % بادىء عائد لكم كل عام % 2(@)(@@) % ولعودات ريع جودك للآ % % مل أولى من غيرها بالدوام % % 3(@)(@@) % ليس ينجيك من ملامة قرب % غير آلائك الحسان الجسام % % 4(@)(@@) % فتعوذ بحنطة الكشك منها % % عائدا بالجميل عود الكرام % % 5(@)(@@) % قسما يابن صالح بن علي % وابن عيسى بن جعفر القمقام % % 6(@)(@@) % إن عهدي إذا تنكر عهد % لجديد وإن حبي لنامي % % 7(@)(@@) % مقة خالطت فؤادي ودبت % في عروقي ومخخت في العظام % % 8(@)(@@) % فعلى قدر ذاك أسأل حاجا % % تي وأمتاحها بغير احتشام % % 9(@)(@@) % سائلا جلها لغير اشتطاط % سائلا دقها لغير اغتنام % % 10(@)(@@) % غير مستصغر قليل عطايا % % ك ولامكبر كبير اللئام % % PageV01P4276 11(@)(@@) % وقديما ما أظلموا كالليالي % % وأضأتم للناس كالأيام % % 12(@)(@@) % وعلوتم على الخليقة كالها % % م وكان الرجال كالأقدام % % 13(@)(@@) % وجريتم في كل ميت من المع % % روف جري الأرواح في الأجسام % % 14(@)(@@) % وهي قرب وإنما أنا في الشي % ء وكيل وأنت قاضي ذمام % % PageV01P4277 البحر : - 1(@)(@@) % أبا 
ms1124	 الفضل مامثلي يخالك راضيا % بأن يرزق الأوغاد حظا وأحرما % % 2(@)(@@) % أبى ذاك أن الله ولاك عصمة % ركبت بها نهجا من العدل معلما % % 3(@)(@@) % إذا مانبا عني الوزير وأنتم % عتادي فل م رجاكم من تحرما % % 4(@)(@@) % هززتك للحرمان فاقطع وتينه % فما زلت صمصاما إذا هز صمما % % PageV01P4278 البحر : - 1(@)(@@) % قصدت إليك لاأدلي بشيء % أرى حقي عليك به عظيما % % 2(@)(@@) % سوى الكرم الذي أعرقت فيه % % وحسبي أن تكون فتى كريما % % 3(@)(@@) % ولم أمدحك إتحافا بمدح % كفى مدح غذيت به فطيما % % 4(@)(@@) % ولكني دعوتك في سؤالي % % بأسماء دعيت بها قديما % % 5(@)(@@) % ولم أر كفء سمعك من كلامي % % سوى الموزون وزنا مستقيما % % 6(@)(@@) % ولست أرى ثواب الشعر دينا % عليك ولا أرى نفسي غريما % % 7(@)(@@) % ولكني أراك تراه حقا % لمجدك والوسيم يرى الوسيما % % 8(@)(@@) % فإن تك عند تأميلي وظني % % فكم صدقت بارقك المشيما % % 9(@)(@@) % وإن عاق القضاء نداك عني % % فلست أراك في منعي مليما % 10(@)(@@) % وما غيث إذا ما اجتاز أرضا % إلى أخرى بمعتد لئيما % % PageV01P4279 11(@)(@@) % بإذن الله يعري متن أرض % ويكسو أختها الزهر العميما % % PageV01P4280 البحر : - 1(@)(@@) % ضحك الربيع إلى بكا الديم % وغدا يسوي النبت بالقمم % 2(@)(@@) % من بين أخضر لابس كمما % خضرا وأزهر غير ذي كمم % % 3(@)(@@) % متلاحق الأطراف متسق % فكأنه قد طم بالجلم % % 4(@)(@@) % متبلج الضحوات مشرقها % % متأرج الأسحار والعتم % 5(@)(@@) % تجد الوحوش به كفايتها % % والطير فيه عتيدة الطعم % % 6(@)(@@) % فظباؤه تضحي بمنتطح % % وحمامه تضحي بمختصم % % 7(@)(@@) % أحذى الأمير ربيعنا خلقا % يهمي إذا ما البرق لم يشم % % 8(@)(@@) % فالقطر ضربة لازم قسما % % والصحو فيه تحلة القسم % % 9(@)(@@) % والروض في قطع الزبرجد وال % ياقوت تحت لآلىء تؤم % % 10(@)(@@) % طل يرقرقه على ورق % % فكأنه در على لمم % % PageV01P4281 11(@)(@@) % حشد الربيع مع الربيع له % فغدا يهز أثائث الجمم % % 12(@)(@@) % والدولة الزهراء والزمن ال % % مزهار حسبك شافي قزم % % 13(@)(@@) % إن الربيع لكالشباب وإن % ن الصيف يكسعه لكالهرم % % 14(@)(@@) % أشقائق النعمان بين ربى % % نعمان أنت محاسن النعم % % 15(@)(@@) % غدت الشقائق وهي واصفة % % آلاء ذي الجبروت والعظم % % 16(@)(@@) % ترف لأبصار 
ms1125	 يجلن بها % % ليرين كيف عجائب الحكم % % 17(@)(@@) % عبرة لأفكار بعثن لها % % ليرين كيف عجائب الحكم % % 18(@)(@@) % شعل تزيدك في النهار سنى % % وتضيء في محلولك الظلم % 19(@)(@@) % أعجب بها شعلا على فحم % لم تشتعل في ذلك الفحم % % 20(@)(@@) % تلك التي تهوي لتلثمها % % وتشمها بالأنف ذي الشمم % % PageV01P4282 21(@)(@@) % وكأنما لمع السواد إلى % % مااحمر منها في ضحى الرهم % % 22(@)(@@) % حدق العواشق وسطت مقلا % نهلت وعلت من دموع دم % 23(@)(@@) % هاتيك أو خيلان غالية % أضحت بها الوجنات في ذمم % % 24(@)(@@) % حذرت سهام العين حمرتها % % فغدت من التسويد في عصم % % 25(@)(@@) % هاتيك أو حلك مزرفنة % % عقربن في الصفحات كالحمم % % 26(@)(@@) % باحت بأطراف لها نقب % فبدت وسائرها بمكتتم % % 27(@)(@@) % هاتيك أو غنم على قضب % بيض يتيه بها على العنم % % 28(@)(@@) % لجأت إلى وجنات شاكية % ضيفين من ندم ومن سدم % % 29(@)(@@) % لا بل مقرعة بمنكرة % % صحت وقد كانت من التهم % % 30(@)(@@) % فحكت لجانيها وقاحته % بالنكت في الوجنات لا النغم % % PageV01P4283 31(@)(@@) % أو إثمد وسم البكاء به % % حمرا مضرمة بلا ضرم % % 32(@)(@@) % أجراه صد ثم حيره % عطف نهاه بعد منسجم % % 33(@)(@@) % فأقام بين محاجر سرقت % حدق الظباء وبين ملتثم % % 34(@)(@@) % من كل مكملة مجللة % بالحسن من قرن إلى قدم % 35(@)(@@) % شجى الإزار لها برابية % وجرى الوشاح لها على هضم % % 36(@)(@@) % منيت بخصم مثلها حكم % في كل قلب أيما حكم % % 37(@)(@@) % سيان قيمتها وقيمته % في الحسن عند تفاوت القيم % % 38(@)(@@) % ذي مردة توفيك سنته % نور الهلال وصورة الصنم % % 39(@)(@@) % لو مر بالأجداث آونة % لجرت به الأرواح في الرمم % % 40(@)(@@) % أو عرضت بهم الحروب له % % لرحمت ثم مصارع البهم % PageV01P4284 41(@)(@@) % أعجب به يهدي إلى رجم % حيا ويبعث صاحب الرجم % 42(@)(@@) % شعفت به فأذاقها طرفا % مما تذيق محالف الكتم % % 43(@)(@@) % فبكت بدمع لا يجاد به % % إلا لذي قدر من الألم % % 44(@)(@@) % من مقلة سقمت فغايتها % % إعداء مافيها من السقم % % 45(@)(@@) % مظلومة ظلامة أبدا % منيت بمتهم بمتهم % % 46(@)(@@) % يا للشقائق إنها قسم % تزهى بها الأبصار في القسم % % 47(@)(@@) % ما كان يهدي مثلها تحفا 
ms1126	 % إلا تطول باريء النسم % % 48(@)(@@) % وهو الذي أهدى لنا حسنا % ذا الحسن والإحسان في القحم % % 49(@)(@@) % ملك تريك من السدى يده % ما لا يصور منه في الوهم % % 50(@)(@@) % أعطى فأنطق كل ذي خرس % ودعا فأسمع كل ذي صمم % % PageV01P4285 51(@)(@@) % وأرى البليغ قصور مبلغه % % فطوى شقا شقه على وكم % % 52(@)(@@) % أعطى كما أعطاه خالقه % غرض المنى ونهاية الهمم % % 53(@)(@@) % فكأنما ضمنت فضائله % خرس البليغ ونطق ذي البكم % % 54(@)(@@) % يا أسفا إن بذه حسن % سبق القضاء ومرة الوذم % % 55(@)(@@) % لأبي محمد الحميد يد % خلقت لسح الوبل والديم % % 56(@)(@@) % لله تلك يدا لقد جعلت % وفقا لما فيه من الشيم % % 57(@)(@@) % ولقد تفاوت والمفاخره % كتفاوت الوجدان والعدم % % 58(@)(@@) % ما زال سائله وسائله % متيممي نار على علم % % 59(@)(@@) % من نور حكمته بمضطرم % وبحور نائله بملتطم % 60(@)(@@) % قصرت عليه كتابة بيد % وبهاجس وكتابة بفم % % PageV01P4286 61(@)(@@) % أخذ المعلى فاستبد به % % دون القداح وليس بالزلم % % 62(@)(@@) % لكنه قلم يسوس به % % جيلين من عرب ومن عجم % 63(@)(@@) % يمريه خاطره فيمطره % ما شاء من نعم ومن نقم % % 64(@)(@@) % نم يا أخا الحاجات إن له % % كرما إذا ما نمت لم ينم % % 65(@)(@@) % تتبسم الأشعار ضاحكة % عنه فما تفتر عن هتم % % 66(@)(@@) % لولا افتنان النطق في طرق % ما قال مقوله سوى نعم % % 67(@)(@@) % حلت خلائقه بمتسع % % فعفاة نائله بمزدحم % % 68(@)(@@) % يغدو جدا كفيه مقتسما % ليصون عرضا غير مقتسم % % 69(@)(@@) % أغنى فلولا أنه نفسي % % لم أغش عقوته سوى لمم % % 70(@)(@@) % لكنه الزاد الذي اغتفرت % فيه العقول فواحش النهم % % PageV01P4287 71(@)(@@) % لله كفك أي ملتمس % للسائلين وأي مستلم % % 72(@)(@@) % ما إن تزال الدهر فوق يد % تمتاح نائلها وتحت فم % % 73(@)(@@) % قل للخليفة فز بخدمته % % فلتغنين به عن الخدم % % 74(@)(@@) % ولينهضن بفتح ذي سدد % مما عناك وسد ذي ثلم % % 75(@)(@@) % يمنا وحزما غير ذي خلل % % وصريح نصح غير متهم % 76(@)(@@) % وكفاك يمن مرسح فرجت % بركاته في غمة الغمم % % 77(@)(@@) % من طرقت ديم السماء له % % نبذت إليه مقالد السلم % % 78(@)(@@) % قحطت فلما آن منهضه % جادت بغوث الناس 
ms1127	 والنعم % % 79(@)(@@) % وكأنما إطلاق عقدته % % أرضى الزمان وكان ذا أضم % % 80(@)(@@) % فغدت به الدنيا وما ظلمت % مفترة عن كل مبتسم % % PageV01P4288 81(@)(@@) % لله ذاك اليمن إن له % % في الملك حرفا غير مدغم % % 82(@)(@@) % فاسعد بذاك اليمن واحظ به % % واضمم عليه الكف من أمم % % 83(@)(@@) % مفتاح أبواب السماء يفي % % لك بافتتاح الأرض والأمم % % 84(@)(@@) % واعضد بذاك الرأي مملكة % تحتاج ظلتها إلى دعم % % 85(@)(@@) % فلتنصرن على الطغاة به % % ولتكفين السيف بالقلم % % 86(@)(@@) % ومظفر وعظ العدا بعدا % حانوا فأهداهم إلى أزم % % 87(@)(@@) % نظرت إليه عيونهم فغدت % تلك العيون مراتع الرخم % % 88(@)(@@) % هل من ولي غير منتعش % % هل من عدو غير مصطلم % % 89(@)(@@) % هل من مول غير مقتبل % هل من شتيت غير منتظم % % 90(@)(@@) % لبس الزمان به شبيبته % % من بعد ما أشفى على الهرم % % PageV01P4289 91(@)(@@) % أيرود رائدك الكفاة وفي % % أدنى ديارك عيمة العيم % 92(@)(@@) % في ابن الوزير كلال بادرة % ترضي النهى ومضاء معتزم % % 93(@)(@@) % أسد إذا أسرى لمقتنص % أسرى من الخطي في أجم % % 94(@)(@@) % فلمن يسالمه سلامته % ولمن يحارب عطسة اللجم % 95(@)(@@) % فوليه وعل على جبل % وعدوه جزر على وضم % % 96(@)(@@) % متغنم الضحكات مثمنها % % وله لقاء غير مغتنم % % 97(@)(@@) % زجرت بني وهب عقولهم % % أن يعرضوا لمغصة اللقم % 98(@)(@@) % ودعتهم عودا نزاهتهم % أن يعرضوا لمصارع التخم % % 99(@)(@@) % شدت بهم عقد الخلافة فاش % % تدت وحلت عقدة الكظم % % 100(@)(@@) % ما بات يدخل من باب لها وحد % حاشاه من كل جور إنه لوم % % PageV01P4290 100(@)(@@) % ولتذعننن لك الأمور بهسوار شكرا لأيري فضل نعمتهشكرا فإنك في الكفران مأثوم بذيء كم خاض أمك أيري وهي وادعة وإنه لشديد الوعك محموم بذيء ما بات يدخل من باب لها وحد حاشاه من كل جور إنه لوم % % حتى تقاد إليك بالرمم % % 100(@)(@@) % سوار شكرا لأيري فضل نعمته % شكرا فإنك في الكفران مأثوم % 100(@)(@@) % كم خاض أمك أيري وهي وادعة % وإنه لشديد الوعك محموم % PageV01P4291 البحر : - 1(@)(@@) % بل من ثلاثة أبواب مفتحة سقط أبيات وشطر % % ص يادهركم تسبك المصفى % % PageV01P4292 البحر : - 1(@)(@@) % ع لكل باب نصيب منه مقسوممن 
ms1128	 ثغرها وجعباها ومن فمها % % قسم السوية ما فيهن مظلوم % % PageV01P4293 البحر : - 1(@)(@@) % فإن ألظ بباب واحد هتفت % عدلا هديتفإن الظلم مذموم % % PageV01P4294 البحر : - 1(@)(@@) % يهدي إلى قلبها روحا بفيشلة % % كأنها حجر في الكف ملموم % % 2(@)(@@) % من أنفس الناس والجسوم % عليك بالأكدرين ماء % % 3(@)(@@) % فصفهم غير ما ملوم % % أولا فأنت الظلوم فيما % % 4(@)(@@) % تأتي ولا خير في الظلوم % % أنب إلى قاسم وإلا % % 5(@)(@@) % فالله عون على الغشوم % حرم على النائبات لحما % 6(@)(@@) % منه زكيا من اللحوم % أنت متى نلت منه أهل % 7(@)(@@) % لكل لوم وكل لوم % % فاقصد سواه ودع حماه % 8(@)(@@) % فهو حمى الجود والعلوم % % واصدف عن الشم آل وهب % 9(@)(@@) % أهل الندى الغمر والحلوم % ولا تدع من بغى عليهم % % 10(@)(@@) % إلا لقى دائم الكلوم % % ذوي العلاء الخصوص تبنى % % PageV01P4295 11(@)(@@) % بناه بالنائل العموم % % مصحون مستمطرون سحا % % 12(@)(@@) % فهم غيوث بلا غيوم % % جادوا وآفاقهم نقاء % 13(@)(@@) % ليس عليهن من قتوم % % ما شئت من أنجم وضاء % 14(@)(@@) % وممطرات ومن رجوم % % ن % PageV01P4296 البحر : - 1(@)(@@) % أعنيك يامن سواه تلحق التهم % يا واحد الفهم إذ للواهم الوهم % 2(@)(@@) % ومن له من يد كف وساعدها % % إذ ليس لي عنده ساق ولا قدم % % 3(@)(@@) % لغفلة المرء وصف غير متفق % % والذم مجتنب والحمد مغتنم % 4(@)(@@) % فغفلة المرء عن حق لصاحبه % % لؤم وغفلته عن حقه كرم % % 5(@)(@@) % ناشدتك الله في أشياء مسلفة % % لايمحها من كتابي عندك القدم % % 6(@)(@@) % أضحت عهودا وقد كانت مشاهدة % والمجد حيث يصان العهد والذمم % % 7(@)(@@) % قد يربع المرء في دار محافظة % % وليس إلا الأثافي السفع والحمم % % 8(@)(@@) % ولا ينهنه منه أن يخاطبها % % حلم ولا خرس فيها ولا صمم % % 9(@)(@@) % يانور علم تعالى في ذرى شرف % أنى تجور وأنت النار والعلم % % 10(@)(@@) % إن الكرائم ليست وحدها حرما % % دون المكارم لكن كلها حرم % % PageV01P4297 البحر : - 1(@)(@@) % لعمري لقد غاب الرضا فتطاولت % بغيبته البلوى فهل هو قادم % 2(@)(@@) % تعرفت في أهلي وصحبي وخادمي % % هواني عليهم مذ جفاني قاسم % % 3(@)(@@) % جفوني وعقوني وملوا ثوايتي % % فكل مليم ظالم وهو لائم % % 4(@)(@@) % فلو أبصرتني بينهم 
ms1129	 عين حاسدي % % لأضحى وأمسى حاسدي وهو راحم % 5(@)(@@) % أقاسم قد جاوزت بي كل غاية % وليس وراء الحيف إلا المآثم % 6(@)(@@) % كأنك قد أنسيت أنك سيد % له الفضل أو أنسيت أني خادم % % 7(@)(@@) % أقصرت في فرض فمثلي قصرت % به حاله عن كل ماهو لازم % 8(@)(@@) % هل العسر كل العسر مبق عزيمة % ألا إنما حيث اليسار العزائم % % 9(@)(@@) % حلفت بمن أرجو لعطفك لطفه % إذا أنت هزتك السجايا الكرائم % % 10(@)(@@) % لئن كنت في الإخلال بالفرض ظالما % لهنك في رفض الإقالة ظالم % % PageV01P4298 11(@)(@@) % ولم لا وقد صورت من خير طينة % وأنت بفضل الحلم والجود عالم % % 12(@)(@@) % حنانيك لا تظلم بي المجد إنه % صديق جليل تتقيه المظالم % 13(@)(@@) % وهبني عبدا مذنبا أو معطلا % سليبا من الآلات أين المكارم % % 14(@)(@@) % ألا فاضل يأوي لنقصان ناقص % فيلبسه من عفوه وهو ناقم % % 15(@)(@@) % ألا غارم صفحا ليغنم سؤددا % وحمدا وأجرا إن ذا الغنم غارم % % 16(@)(@@) % إلا غانم أحدوثة الصدق في الورى % % بغرم الأيادي إن ذا الغرم غانم % % 17(@)(@@) % ترفع إلى الطول العلي مكانه % فما تشبه النعمى عليك السخائم % % 18(@)(@@) % ولا يشبه البدء الذي قد بدأته % من العرف أن تشكى عليه النقائم % % 19(@)(@@) % وهبني جفاني الإذن منك عقوبة % على غير جرم لم جفتني الدراهم % % 20(@)(@@) % أتبلغ أقدار الدراهم أن ترى % % تباريك في هجر الذين تراغم % % PageV01P4299 21(@)(@@) % أبى ذاك أن الله أعلاك فوقها % % وأنك من آفات ذي البخل سالم % 22(@)(@@) % ومثلك لا يحتج والخصم ساغب % ولكنه يحتج والخصم طاعم % % 23(@)(@@) % فأشبع وأوجع بالبعاد مؤدبا % فقد يعدم التقريب والبر دائم % % 24(@)(@@) % وكم سفه الهجران والحلم صامت % وكم خرق الإقصار والجود كاظم % % 25(@)(@@) % فقوم بما دون المجاعة إنها % % سهام حداد بل سيوف صوارم % % 26(@)(@@) % وعاقب بمحمود العقاب فإنه % سيكفيك مذموم العقاب الألائم % % 27(@)(@@) % وأحسن من حسن العقاب اطراحه % % إذا قلب الرأي الرجال الأكارم % % 28(@)(@@) % وعز على مولاك صرف اهتمامه % % إلى القوت لكن أمره متفاقم % % 29(@)(@@) % له شاغل عن أن يسامي همه % رضاك وقد أعيته فيه المراوم % % 30(@)(@@) % على أنه لابد لي من 
ms1130	 طلابه % وإن قيل مغرور وإن قيل حالم % % PageV01P4300 31(@)(@@) % ألا فاستمع مني بأذن سميعة % فذاك سميع لؤمه متصامم % % 32(@)(@@) % أمستأثر بالحلم قيس بن عاصم % عليك ولم يعشرك قيس وعاصم % % 33(@)(@@) % ومنفرد بالجود دونك حاتم % وكعب ولم يعشرك كعب وحاتم % % 34(@)(@@) % معاذ الذي أعطاك ما أنت أهله % من الدين والدنيا وضدك راغم % 35(@)(@@) % تناومت عني بعد طول عناية % % وقد نهست مني الخطوب الأوازم % % 36(@)(@@) % فيا ليت شعري لا عدمت سلامة % ونعمى لها ظل من العيش ناعم % 37(@)(@@) % متى تنظر الدنيا إلي بنظرة % بعينك نحوي أيها المتناوم % % 38(@)(@@) % هنالك أغدو والسرور محالف % بنيات قلبي والزمان مسالم % % 39(@)(@@) % ويومي من إشراق وجهك شامس % مضيء ومن إغداق كفيك غائم % % 40(@)(@@) % ألا إن ثلما في السماح عقوبتي % % كأني نظير أو كفي مقاوم % % PageV01P4301 41(@)(@@) % أقلني عثار الظن منك فلم تزل % % تقيل التي فيها تحز الحلاقم % % 42(@)(@@) % وما قبلي حق وهبه فهبه لي % % فإنك للوهاب لا المتعاظم % % 43(@)(@@) % وأنت الفتى كل الفتى في فعاله % إذا ما وهبت الحق والحق قائم % % 44(@)(@@) % وأكرم بخصم باع بالطول حقه % % وآثر حق المجد وهو مخاصم % % 45(@)(@@) % ولاسيما والخصم قاض محكم % إليه القضايا والهبات الجسائم % % 46(@)(@@) % متى يهب الخصم المطالب حقه % إذا لم يهبه الخصم والخصم حاكم % % 47(@)(@@) % وأنى يكون المنكر الجرم عادلا % إذا ما استوت أحكامه والجرائم % 48(@)(@@) % أنا العبد ساقته إليك نوائب % شداد وقادته إليك الخزائم % % 49(@)(@@) % يراه الورى ضيفا ببابك صائما % وهل حسن ضيف ببابك صائم % % 50(@)(@@) % أمن بعدما ابيضت أياديك عنده % تريه التي تبيض منها المقادم % % PageV01P4302 51(@)(@@) % بحق الوزير بن الوزير وعيشه % تأمل مليا هل على العفو نادم % % 52(@)(@@) % وهب لي على ماكان مني مكانتي % % وحظي فإني سيىء الحال واجم % 53(@)(@@) % ولا تنس أن الله سماك قاسما % لأنك في النعمى شريك مقاسم % % 54(@)(@@) % تقسم في المعروف ما أنت مالك % وتجشم فيه كل ما أنت جاشم % % 55(@)(@@) % وحاشاك من تمويه ظن وشبهة % يقولان إن المانع العفو حازم % % 56(@)(@@) % فإن قلت لي دع وصل من أنت واصل % صددت بطرف العين والقلب 
ms1131	 دائم % % 57(@)(@@) % ولاحظته والخوف بيني وبينه % كما تلحظ الماء الظباء الحوائم % % 58(@)(@@) % كذلك لا أشري ولاءك طائعا % % بما ملكته عبد شمس وسيم % % 59(@)(@@) % ولو سامني ذاك الوزير أبيته % وأنكرته النكر الذي هو صارم % % 60(@)(@@) % أأنزع إحدى مقلتي لأختها % % كذا طائعا إني هناك لآثم % PageV01P4303 61(@)(@@) % أحبكما حبا مع القلب أصله % % وأطرافه حيث النجوم النواجم % % 62(@)(@@) % هو الخوف والتأميل والرأي والهوى % % فيا ليت شعر النفس كيف تصارم % % 63(@)(@@) % ولم لا وقد أوضحتما لي طريقتي % % فأضحى هداها مفصحا لا يكاتم % % 64(@)(@@) % وقفت بنور الفرقدين على الهدى % % فقلبي على هذا وهذاك هائم % % 65(@)(@@) % ومن ينكر الحرمان منك لواحد % ورب الغنى والفقر معط وحارم % % 66(@)(@@) % سيحميك أن تلقى لساني صارما % تذكر قلبي أن سيفك صارم % % 67(@)(@@) % وإني لأعفو عن رجال وأتقي % % رجالا وأدري أي قرن أصادم % 68(@)(@@) % فإن سد باب العذر فيما نقمته % % هواك فلي بالرأي فيه مخارم % % 69(@)(@@) % أنا المرء لا يشقى الوفاء بغدره % ولا شام مني ذلك البرق شائم % % 70(@)(@@) % ولن أتعدى الحق في كل حالة % وإن سنحت فيه ومنه الأشائم % % PageV01P4304 71(@)(@@) % تمسكت بالأمر الجميل مبرءا % من الغش إلا ما توهم واهم % % 72(@)(@@) % وأقسم أني لم أمت لك نعمة % علي ولا أحييت ما أنت كاتم % % 73(@)(@@) % ولا حاربت نفسي عليك ولا اصطفت % عداك ولا لاءمت من لا تلائم % % 74(@)(@@) % وسائل بما أخفيه عيني فإنها % % تترجم عني والعيون تراجم % % 75(@)(@@) % ألم ترها تسمو إليك كأنها % % تعانق في ألحاظها وتلاثم % % 76(@)(@@) % ستعلم ما قدري إذا رقد الهوى % % فإن الهوى يقظان والرأي نائم % % 77(@)(@@) % وللرأي هبات من النوم يجتلي % % أخو الرأي فيها ما تغم الغمائم % % 78(@)(@@) % ومازالت الأشباه وهي كثيرة % مجاهل فيها للبصير معالم % % 79(@)(@@) % وما قلت لي في ذاك قولا مصرحا % ولكنه قد يرجم الغيب راجم % % 80(@)(@@) % وإني لسكيت وعندي معارف % إذا ما استطال الجاهل المتعالم % % PageV01P4305 81(@)(@@) % وليس بشرير ضليع بحجة % رمى باطلا بالحق حين يخاصم % % 82(@)(@@) % ولا واسم عرض امرىء كان ناله % بسوء وإن لامته فيه اللوائم % 83(@)(@@) % وما بي زهد في التفضل إنه 
ms1132	 % % لفضل ولكن للرجال شكائم % % 84(@)(@@) % ولكنما الشرير من عم شره % وسولم بدءا فأتلى لا يسالم % % 85(@)(@@) % وعاذ بإذعان له وتودد % أخوه فلم تنفعه تلك التمائم % % 86(@)(@@) % وكافأ إحسانا بسوء ولم يزل % يراجم بالمكروه من لا يراجم % % 87(@)(@@) % ولست بشتام الملوك وإن حموا % % جداهم وهل لي في الملوك مشاتم % % 88(@)(@@) % وكيف بهدمي ما بنته سعادة % وليس لما تبني السعادة هادم % % 89(@)(@@) % عداني عن تلك العرامة أنني % % عليم بأن السيف مثلي عارم % % 90(@)(@@) % وأني شكور للأيادي التي غدت % لها في رقاب العالمين خواتم % % PageV01P4306 91(@)(@@) % أأشتم من لولاه لم يك للهدى % % صراط ولا للشمل بالعدل ناظم % % 92(@)(@@) % ومن بعطاياه تعيش نفوسنا % % وتقويمه الدنيا تموت الملاحم % % 93(@)(@@) % وإن امرأ يمسي ويصبح سالما % من الناس في دار البلاء لسالم % % 94(@)(@@) % ومن رام ثلمي وانتقاصي فإنني % % لمنتقص ما اسطعت منه وثالم % % 95(@)(@@) % أيوجب أني ذو سلاح مذلتي % % لأعزل تثنى عنه في العظائم % % 96(@)(@@) % علام إذا يستوجب الشعر حمده % علام حبانيه وحظي الهضائم % % 97(@)(@@) % أراني سترمي بي أقاصي همتي % % قلوصي ورحلي والفجاج القواتم % % 98(@)(@@) % ولله في حاوي يديه وأرضه % مناديح ترضاها القلاص الرواسم % % 99(@)(@@) % وما جلجل الوجناء بين قتودها % % كغضبة حر شيعتها عزائم % % PageV01P4307 البحر : - 1(@)(@@) % تظلم شعري إلى القاسم % % فأعدى على الزمن الغاشم % 2(@)(@@) % تطول حتى توهمته % يطاول بدر بني هاشم % % 3(@)(@@) % ونول حتى لقد خلته % يساجل في أبا القاسم % % 4(@)(@@) % فتى نال عافوه مرضاتهم % فجل على مرغم الراغم % % 5(@)(@@) % نطيف ببحر له زاخر % ونأوي إلى جبل عاصم % % 6(@)(@@) % بناه الإله لنا معقلا % بناء المخلد لا الهادم % % 7(@)(@@) % هو الدهر مصغ إلى سائل % وليس بمصغ إلى لائم % % 8(@)(@@) % تظل يداه يدي غارم % وبهجته بهجة الغانم % % 9(@)(@@) % وما غارم حصلت كفه % له الحمد والأجر بالغارم % % 10(@)(@@) % وما تستفيق يدا قاسم % كأن يديه يدا عائم % % PageV01P4308 11(@)(@@) % يحاذر إن ونتا طرفة % حذار امرىء حازم عازم % 12(@)(@@) % ويرهب أحدوثة الباخلي % % ن في أزمة الزمن الآزم % % 13(@)(@@) % ومن كف من زمن عارم % تسلم من زمن عارم % 14(@)(@@) % وليست بسيدنا خلة % تخوفه العذم 
ms1133	 من عاذم % % 15(@)(@@) % لقد نصه الله في منصب % سليم من الذام والذائم % % 16(@)(@@) % فلا عيب فيه سوى نائل % يراه المنول كالحام % % 17(@)(@@) % يظل يرى حقه باطلا % أطاف خيالا على نائم % % 18(@)(@@) % فلا انفك تالف أمواله % وقاء على عرضه السالم % % 19(@)(@@) % ولا زال غيثا على سائل % محق وغيظا على ناقم % % 20(@)(@@) % فما تاجر باعه حمده % بمحتقب حسرة النادم % % PageV01P4309 21(@)(@@) % وإني وقد آب لا خائبا % ولا حاملا ثقل الآثم % % 22(@)(@@) % فلا يتوهم أخو شبهة % فلم يبق وهم على واهم % % 23(@)(@@) % عجبت لمن حزمه حزمه % تكون يداه يدي حاتم % % 24(@)(@@) % عجبت لمن جوده جوده % تكون له عقدة الحارم % 25(@)(@@) % عجبت لمن حلمه حلمه % تكون له صولة الصارم % % 26(@)(@@) % عجبت لمن حده حده % % تكون له رأفة الراحم % % 27(@)(@@) % أرى كل ضد إلى ضده % من الخير في طبعه السالم % % 28(@)(@@) % إليكم جفاة العلى إنني % % دفعت إلى مفضل عالم % % 29(@)(@@) % يضيء بيوم له شامس % ويسقي بيوم له غائم % 30(@)(@@) % يقول فيروي صدى جاهل % ويعطي فيروي صدى حائم % % PageV01P4310 31(@)(@@) % قراني قرى غير ما عاتم % % وليس قرى السمح بالعاتم % % 32(@)(@@) % قراني لهى وقراني نهى % فلست لرفدين بالعادم % % 33(@)(@@) % فما لمديحي من خاتم % وما لعطاياه من خاتم % % 34(@)(@@) % فتى لا يذم بجود المضي % % ع كلا ولا بخل النادم % % 35(@)(@@) % ألا أجر مدحك في قاسم % % فما لحروفك من جازم % % 36(@)(@@) % أمستكتمي قاسم عرفه % أبيت على المحسن الظالم % % 37(@)(@@) % كريم أسر إلي الغنى % % وما أنا للعرف بالكاتم % % 38(@)(@@) % وهبني كتمت أتخفى له % % بروق نداه على الشائم % % 39(@)(@@) % ووسم اليسار على موسر % وسيما النعيم على ناعم % % 40(@)(@@) % أقاسم ياقاسم المنفسا % % ت لا زلت في جذل دائم % % PageV01P4311 41(@)(@@) % مدحتك مدحة لا باخس % ثناءك حقا ولا زاعم % % 42(@)(@@) % فساجلت شيخ بني تغلب % وساجلت شيخ بني دارم % % 43(@)(@@) % أجهز فيك جميل الثنا % % إلى حافظ وإلى آقم % % 44(@)(@@) % وحسبي معانيك من جوهر % وحسبك عبدك من ناظم % 45(@)(@@) % ولم أر مثلك من سيد % وكم لك مثلي من خادم % 46(@)(@@) % فلا زلت غيثا على سائل % ولا زلت غيظا 
ms1134	 على راغم % % 47(@)(@@) % وإن كنت أعقبتني جفوة % وما أنا والله بالجارم % % 48(@)(@@) % وراعيت غيري وأغفلتني % % خلافا لميزانك القائم % % 49(@)(@@) % وليست بحالي من مسكة % وإن جمجمت سكتة الكاظم % % 50(@)(@@) % أبى ذاك أنكم معشر % مناعيشللرازح الرازم % % PageV01P4312 51(@)(@@) % وأن ليس للداء داء الفقي % % ر غيركم الدهر من حاسم % 52(@)(@@) % ومن تسلموه لأيامه % ففي شظف لازب لازم % % 53(@)(@@) % أمن بعد منزلة المطعمي % % ن أعدمت منزلة الطاعم % % 54(@)(@@) % أمن بعد منعي حريم المضي % % م أسلمتموني إلى الضائم % % 55(@)(@@) % فلانت قناتي للغامزي % % ن وارفت عودي للعاجم % % 56(@)(@@) % ألم أك في أفق مسفر % فمالي في أفق قاتم % % 57(@)(@@) % ألم أك جذلان في ظلكم % % فمالي في مقعد الواجم % % 58(@)(@@) % إلى عدلك المشتكى كله % فحسبي بعدلك من حاكم % % 59(@)(@@) % وإني لأظلم إذ أشتكي % % وعدلك كالكوكب الناجم % % PageV01P4313 البحر : - 1(@)(@@) % يا سيدا يهب الأقدار مقتدرا % كما غدا يهب الأموال والنعما % % 2(@)(@@) % هب لي من القدر ما ألقى العدو به % مكذبا كل ما سدى وما زعما % % 3(@)(@@) % أرغمه في فقد أضحى يراغمني % % وزده رغما على رغم إذا رغما % % 4(@)(@@) % ولست مستوجبا حظا أنفله % من الكرامة لكن هبه لي كرما % % 5(@)(@@) % يا من رأى قدره يعلو مواهبه % فليس مستعظما شيئا وإن عظما % % PageV01P4314 البحر : - 1(@)(@@) % أيقتلني من ليس لي منه ناصر % عليه وأعواني عليه مكارمه % 2(@)(@@) % أبى ذاك أن الحلم بيني وبينه % % وأن علو القدر في يخاصمه % % PageV01P4315 البحر : - 1(@)(@@) % حبستنا السماء حبسا كريما % من كريم وعند حر كريم % % 2(@)(@@) % فظللنا بما ادعيناه من حل % % م وعلم ونائل ونعيم % % 3(@)(@@) % في أمان ومأمن بين غيث % وغياث لحادث وقديم % % 4(@)(@@) % قاسم قاسم العطايا الذي حا % % ز العلى وحده بغير قسيم % % 5(@)(@@) % فرأينا العلا أحظ من % ه بها في قضاء كل حكيم % % 6(@)(@@) % كسروي شرابه من رحيق % ومزاج الرحيق من تسنيم % % 7(@)(@@) % وغناء كأنه أريحيات الص % صبى تستخف حلم الحليم % % 8(@)(@@) % قيم كله وإن صيغ من أع % وج ذي عطفة ومن مستقيم % % 9(@)(@@) % في رباع مثل الرياض يحيي % % ك بأنفاسها رقيق النسيم % % 10(@)(@@) % من سقى ما سقى 
ms1135	 وأسمع ما أس % مع لم يبق غاية للنديم % % PageV01P4316 11(@)(@@) % جعل الله ريح دولته الده % % ر نسيما يفوق كل نسيم % % PageV01P4317 البحر : - 1(@)(@@) % لأبو الجهم ملصق % معتد في تجهمه % 2(@)(@@) % غير أني عذرته % في الخنا عند لومه % 3(@)(@@) % إن من يحفز الرجي % % ع بعنف إلى فمه % 4(@)(@@) % لحقيق بأن يرى % % جعره في تكلمه % PageV01P4318 البحر : - 1(@)(@@) % أرى بقر الإنس مني ترا % % ع أطيش ما كنت عنها سهاما % % 2(@)(@@) % وأنى تفرع رأسي المشي % ب ولم أتفرغ ثلاثين عاما % % PageV01P4319 البحر : - 1(@)(@@) % أدركت آخر ما أدركت أوله % يابن الخصيب وربت عندك النعم % 2(@)(@@) % قد قلت حين أهب الله ريحكم % الآن يعدل فينا السيف والقلم % % 3(@)(@@) % ما ضر أعداءكم ألا يكون لهم % إل تراعونه فيهم ولا ذمم % % 4(@)(@@) % وقد أساءوا وقد ساءت ظنونهم % فما ألم بهم من باسكم لمم % % 5(@)(@@) % وهبتم لعبيد الله موهبة % لا مثلها ولو اسودت له النعم % % 6(@)(@@) % والنفس علق نفيس لا كفاء له % إذا تكافأت الأعلاق والقيم % % 7(@)(@@) % ولا قعدتم على ضيم ولا ضمد % لكن عفوتم وفي أيديكم النقم % % 8(@)(@@) % وتلك أول بشرى إن دولتكم % غيث يريع عليه الحب والنسم % % 9(@)(@@) % تبارك الله إكبارا لمنتكم % ماذا يعفي عليه الطول والكرم % % PageV01P4320 البحر : - 1(@)(@@) % عطفا بني وهب علي % ي فأنتم في الفضل أنتم % 2(@)(@@) % قد جدتم لي بالرضا % % والله يشكر ما فعلتم % 3(@)(@@) % ووجدت أفعال الرجا % % ل عن التذمم والتكرم % % 4(@)(@@) % ورأيت ما يبني التذم % مم غير مأمون التهدم % % 5(@)(@@) % إن التجرم مسرع % في نقض ما يبني التذمم % % 6(@)(@@) % فصن الصنيعة أن يدن % نسها التذمم والتجرم % % 7(@)(@@) % إني أعيذك أن يرا % % ك المجد تكرم ثم تلؤم % % 8(@)(@@) % أو أن يراك يحل فض % % لك لي فواقا ثم يحرم % % 9(@)(@@) % فكن امرءا يعفو فيك % رم ثم يكرم ثم يكرم % 10(@)(@@) % ودع التغنم للسقاط % فللسقاط ذوو تغنم % PageV01P4321 11(@)(@@) % إن التلون فعل ذي % % خلقين يصغر حين يعظم % % 12(@)(@@) % وتراه يخطىء بعد قر % طسة وينكث حين يحذم % % 13(@)(@@) % فمتى جرى جعل التخل % % لف وكده بعد التقدم % % 14(@)(@@) % ولما أنم سوى 
ms1136	 جمي % % لك إنني آبى التنمم % % 15(@)(@@) % لكن لسان الحال بعد ال % % حاب ينطق حين أكتم % % 16(@)(@@) % ما حمد مثلك إن سلم % ت عليك في ظل التسلم % % 17(@)(@@) % لا حمد أو تولي السلا % % مة ذا التسلم والتقحم % % 18(@)(@@) % حكم الإله بأن تسو % % د وأن ترى زللا فتحلم % % 19(@)(@@) % واعذر فإن الشعر يخ % نع في معانيه ويعرم % % 20(@)(@@) % ويجيز جور قضائه % % أهل المكارم حين يحكم % % PageV01P4322 21(@)(@@) % ولفضلكم وقع القضا % % ء بأن تسودون ونخدم % % 22(@)(@@) % وانظر أبعد الجهل أم % % بعد النهى يقع التندم % % 23(@)(@@) % يا حسن قولي عند ظل % مي وآنتصافك بالتبسم % % 24(@)(@@) % أنت الذي صدق الترس % سم فيه إذ كذب التوسم % % 25(@)(@@) % وحكى التيقن أنه % رجل المكارم لا التوهم % % 26(@)(@@) % ولذاك مادحه يقول % % مصدقا وسواه يزعم % % 27(@)(@@) % طال التجهم والتنق % قم والتجرم والتبرم % % 28(@)(@@) % إن أنت لم تستحي من % وجهي ومن طول التظلم % % 29(@)(@@) % فاستحي من وجه حبيت % % به وصنه عن التجهم % % 30(@)(@@) % لا تشقني بعبوس وج % % هك والسعادة منه تنجم % % PageV01P4323 31(@)(@@) % عطفا علي أبا الحس % % ين فإن شافعي التحرم % % 32(@)(@@) % ودع التصرم إنه % % لا يشبه الكرم التصرم % % 33(@)(@@) % إن لم تكن لك كالتتو % وج صحبتيك فما التختم % % PageV01P4324 البحر : - 1(@)(@@) % أين من قال بأن لي % % س إلى الكرسي سلم % 2(@)(@@) % كان قدما يمص أير أبيه % % ويطيل الصدود عن ثدي أمه % % 2(@)(@@) % لم يزل خالد لدن كان طفلا % مرضعا والأيور أكبر همه % 2(@)(@@) % لو رأى قرن الحريثيلم يزل خالد لدن كان طفلا مرضعا والأيور أكبر همه كان قدما يمص أير أبيهويطيل الصدود عن ثدي أمه بذيء % % ي استحى أن يتكلم % % PageV01P4325 البحر : - 1(@)(@@) % ألم ترني استصبحت دون صحابتي % % إذا مالقيت المأزق المتلاحما % % 2(@)(@@) % حساما جراز الشفرتين كأنما % % يقط بأوساط الكماة معاصما % % 3(@)(@@) % توامض فيه الشائمين بوارق % لها لمحات يختطفن الجماجما % % 4(@)(@@) % به ما أسمى في الكريهة بهمة % وبي ما يسمى يوم ذلك صارما % % PageV01P4326 البحر : - 1(@)(@@) % لا تلح من يبكي شبيبته % % إلا إذا لم يبكها بدم % 2(@)(@@) % عيب الشبية غول سكرتها % % مقدار ما فيها من 
ms1137	 النعم % % 3(@)(@@) % لسنا نراها حق رؤيتها % % إلا زمان الشيب والهرم % 4(@)(@@) % كالشمس لاتبدو فضيلتها % % حتى تغشى الأرض بالظلم % % 5(@)(@@) % ولرب شيء لا يبينه % % وجدانه إلا مع العدم % % PageV01P4327 البحر : - 1(@)(@@) % وكم جاهل قد أبدأ الجهل مرة % فقلت أعده إنني عائد الحلم % % 2(@)(@@) % ألم تر أن الظلم يخسر ظالما % ويخسر مظلوما لدى كل ذي علم % % 3(@)(@@) % إذا ما تلاقى الحلم والجهل مرة % فيالك من أجر ويالك من إثم % % PageV01P4328 البحر : - 1(@)(@@) % لو هداك القصد فهم % أو أراك الرأي حزم % 2(@)(@@) % لاستوى عندك بيت % يتحداك وسهم % 3(@)(@@) % كان غثا أو سمينا % هو مهما كان شتم % 4(@)(@@) % بل أبى جهلك بل حي % نك بل عرضك هدم % % 5(@)(@@) % لا يبالي الشتم عرض % كله شتم وكلم % % 6(@)(@@) % أيها المسترحجوه % % إن بعض الظن إثم % 7(@)(@@) % ليس بالراجح من رج % حانه لحم وشحم % % 8(@)(@@) % لا وذاك البطن لا جا % % ور ذاك الترب علم % % 9(@)(@@) % من رأيتم بعد طالو % % ت له علم وجسم % % PageV01P4329 البحر : - 1(@)(@@) % آراؤكم ووجوهكم وسيوفكم % % في الحادثات إذا دجون نجوم % 2(@)(@@) % منها معالم للهدى ومصابح % تجلو الدجى والأخريات رجوم % % PageV01P4330 البحر : - 1(@)(@@) % قل لابن بوران ولا تأثم % يا عربيا أعجميا وافهم % % 2(@)(@@) % يدعسها عدس السنان اللهذم % % في دبرها وثفرها المفرم % % 2(@)(@@) % يفعل في مؤخرها والمقدم % كوصفنا في أمك المقدم % 2(@)(@@) % كما وصفنا قبله لم يخرم % % في نفقي عرسك شر مخرم % % 2(@)(@@) % يتركها لو ولدت قبله لم تعلم % وإير عير بعد ذاك مكدم % 2(@)(@@) % يتركها مشاعة لم تقسم % مراثها وبولها من مخرم % % 2(@)(@@) % في بطن بوران وأن لم ترغم % % ينظمها من دبر إلى فم % % 2(@)(@@) % وأير بغل بعد ذاك أدلم % % ذي عنق ريا ورأس فيلم % % 2(@)(@@) % يهدر في وجهك هدر المقرم % من تحت إست مثل رأس المحرم % % 2(@)(@@) % على سبال منك لم يكرم % % يجيش من فتق مبال سرطم % % PageV01P4331 2(@)(@@) % مخضا بالحيض مثل العندم % % يفيض من شر فم شر دم % % 2(@)(@@) % كدمت منن أمك شر مكدم % % زيادة البظر الذي أنت إليه تنتمي % % 2(@)(@@) % ويابن أم وابن كل مسلمكدمت منن أمك 
ms1138	 شر مكدمزيادة البظر الذي أنت إليه تنتمي مخضا بالحيض مثل العندميفيض من شر فم شر دمعلى سبال منك لم يكرميجيش من فتق مبال سرطميهدر في وجهك هدر المقرممن تحت إست مثل رأس المحرم وأ % % حاشا الذي أنت إليه تنتمي % % 2(@)(@@) % ينقض منها كل شيء مببرم % % ينحل منها ضيق كل مأرم % % 3(@)(@@) % أقسم بالله الأجل الأعظم % % لأرمين بالهجاء الأعرم % % 4(@)(@@) % دعي آباء عديد الأنجم % % لو يسروه بينهم بالأسهم % % 5(@)(@@) % ما صار للواحد وزن درهم % % ما بين ذي الحجة والمحرم % % 6(@)(@@) % يوما مضى غفلا بغير ميسم % % من فجرة لأمة أو مأثم % 7(@)(@@) % يابن البغايا قولة لم تزعم % % عجبت منك عجبا لم يظلم % % 8(@)(@@) % وكيف لم ترقط ولم توشم % % وأنت خلط من شعوب موسم % % PageV01P4332 9(@)(@@) % لأنت أولى بغشاء الأرقم % % بل كيف أضويت ولم تتمم % % 10(@)(@@) % كخلق عاد أو كخلق جرهم % % وفيك ماء ري رمل أهيم % % 11(@)(@@) % كم فيك من توأمة وتوأم % % كم من شقيق لك فيك مدغم % % 12(@)(@@) % لو زيلوا من حسمك المجسم % غدوت في جيش بهم عرمرم % % 13(@)(@@) % تكثر كل معرب ومعجم % % أمنع من جاد الهضاب الأعصم % % 14(@)(@@) % يابن الزنا منقطع التكلم % % وابن الزنا منحسر التوهم % % 15(@)(@@) % ما نظم الشعر وما لم ينظم % % فليكتب الكاتب أو فليسأم % 16(@)(@@) % أنت ابن بوران كفاك واختم % % يعهدها في اليوم ألفا قيم % % 17(@)(@@) % وتشتكي الخلة شكوى الأيم % % ليست لها أخت سوى جهنم % % 18(@)(@@) % متى تزدها حصبا تضرم % لم يخل في الأرض طباق منسم % % PageV01P4333 19(@)(@@) % من مبرك خوت به أو مجثم % % أخلقت نقيضة لمريم % % 20(@)(@@) % أم خلقت وقفا لكل معدم % % يا قاصدا بوران شاور تسلم % % 21(@)(@@) % فإنما تركب بحر القلزم % % حذار من أنفاسها تلثم % 21(@)(@@) % واستثبت الرأي ولا تقحم لا تأتها شائلة المخدمبل دان بين الفخذين واضمم واجعل ملاط الأير جلد شهيمواقبض على اعضادها واستعصم فإنما تركب بحر القلزمحذار من أنفاسها تلثم % قبل الندام لات حين مندم % 21(@)(@@) % لا تأتها شائلة المخدم % % بل دان بين الفخذين واضمم % % 21(@)(@@) % واجعل ملاط الأير جلد شهيم % % واقبض على اعضادها واستعصم 
ms1139	 % % 22(@)(@@) % فإنها إن لم تمتك تسقم % % عن نفس مثل الدخان أقتم % % 23(@)(@@) % ويل لأنف منه لم يكمم % % من نكهة تخرق أنف الأخشم % % 24(@)(@@) % لو عبقت بالريح لم تنسم % % فرط حياء من أنوف الشمم % % 25(@)(@@) % حذار من تقبيلها تقدم % % عن ريقة خضراء مثل العلقم % PageV01P4334 26(@)(@@) % وملثم يظلم باسم ملثم % % وملطم حق له اسم ملطم % % 27(@)(@@) % نعم العتاد لحضور المأتم % % دونكها كالجندل المسوم % % 28(@)(@@) % طهر بها بوران إذ لم ترجم % % هذا لها وابسط يديك واغنم % % 29(@)(@@) % من الهجاء مغما كمغرم % % فضيحة فصيحة للأعجم % 30(@)(@@) % أشهر من غرة وجه الأدهم % % أشين من مفتر ثغر الأهتم % % 31(@)(@@) % عجبت من مجلسك الميمم % % ومن رجال شيخهم لم يفطم % % 32(@)(@@) % يقتادهم تلقاءك الرأي العمي % % أتباع ظن لهم مرجم % % 33(@)(@@) % شاهت وجوهنا واطلت بعظلم % كأنهم ماسمعوا بالهيثم % % 34(@)(@@) % ولا الفحول في الزمان الأقدم % % يا رب يوم لهم مذمم % % 35(@)(@@) % شفيت منهم غلتي وقرمي % % وظلت بالنيك لم تنغم % PageV01P4335 36(@)(@@) % تهذي هذاء الرجل المبلسم % % يرمى المساكين بكل صيلم % % 37(@)(@@) % شدوك في شعرك غير المحكم % % يالك من مسدى به وملحم % 38(@)(@@) % لم ترض إلا بالعذاب المحكم % % أوهنت أمر النار عند المجرم % % 39(@)(@@) % وزعت بالجنة كل مغرم % % مستهتر بحورها متيم % % 40(@)(@@) % نحست مزكوما وإن لم تزكم % % من سدة في أنفك المورم % % 41(@)(@@) % محشرج الصدر برطلي بلغم % % إن لا تنخع مرة تنخم % % 42(@)(@@) % نخامة كالضفدع الموشم % % دكناء رقطاء بقيح أو دم % % 43(@)(@@) % ممتخطا بالكوع أو بالمعصم % % تضرط من أنف وتفسو من فم % % 44(@)(@@) % ذا نكهة من لم تمته يصدم % % حتى دعاك الملأ ارحم ترحم % % 45(@)(@@) % فقطعوا اليوم بغير منعم % % وانصرفوا عنك بغير مغنم % % PageV01P4336 46(@)(@@) % إلا ثواب الصابرين الكظم % % وما يفي ذاك بذاك المغرم % 47(@)(@@) % لا خير في الأسماع إن لم تصمم % % ألجمك الله لجام الأبكم % % 48(@)(@@) % يا شر مخلوع وشر ملجم % % هاك قرى مثلك لم يعتم % % 49(@)(@@) % من شاعر صدق اللقاء مرجم % % ليس بمغمور ولا بمفحم % % 50(@)(@@) % يرمي المرامين بلا تجشم % % بكل سيار أحد أدلم % % 51(@)(@@) % يكدح في وجه الصفاة الصلدم % % دونكها مثل 
ms1140	 عصا المكلم % % 52(@)(@@) % تلقف الإفك بشدق شدفم % % تهوي هوى الجندل المسوم % % 53(@)(@@) % وقعت مني في النآدالسلقم % % أو تتقي الشر بكوعي أجذم % % 54(@)(@@) % توقي المسترحم المستسلم % % حينئذ آوي إلى تكرمي % % 55(@)(@@) % لست بظلام ولا مظلم % % وكنت حلوالطعم صلب المعجم % % PageV01P4337 56(@)(@@) % ذا ملمسين مبشر ومؤدم % % فإن ترد عفوي بعد منقم % % 57(@)(@@) % أهبك لله وللتذمم % % وإن أبى حينك ذاك فاعزم % % 58(@)(@@) % وابق لعودا القوافي واسلم % % PageV01P4338 البحر : - 1(@)(@@) % إن عبد القوي ذاك المكنى % % بسويد أراه يمتار سمي % % 2(@)(@@) % عبد سوء مجاهر بالمعاصي % % لا يعمي الفحشاء فيمن يعمي % % 3(@)(@@) % ثم لو كان فاعلا لتسلي % ت ولكن لعكسه الفعل غمي % % 4(@)(@@) % لو يسمى بنصف كنيته الأع % لى ونصف اسمه أصاب المسمى % % PageV01P4339 البحر : - 1(@)(@@) % أتتني أبا العباس أخبار وقعة % منيت بها من صاحب لك لم يلم % 2(@)(@@) % ولو كنت أشركت الأوداء لم تصب % بسوء ولكن لم تدع أكلة النهم % % 3(@)(@@) % فبعدا وسحقا بالذي أنت أهله % أكلت خبيث الزاد وحدك فاتخم % 4(@)(@@) % كذاك انتقام الله من كل ظالم % ظلمت صديقا فابتليت بمنتقم % % 5(@)(@@) % شهدت بها يوم استثابتك بالعصا % % بحرية تأبى الهوان فتنتقم % % 6(@)(@@) % عفا الله عن ذنبيك عندي وعندها % % فإنهما ذنبا بذيء ومغتلم % 7(@)(@@) % ومن ساءني من بعد أو ساء حرة % مقالا وفعلا نكته غير محتشم % PageV01P4340 البحر : - 1(@)(@@) % يأبى لي الضيم فرعي السامي % % إلى المعالي وأصلي النامي % % 2(@)(@@) % إني إذا ما الصديق أكرمني % % ثم غدا يسترد إكرامي % % 3(@)(@@) % جعلت من لذتي مراغمتي % % إياه حتى يمل إرغامي % % 4(@)(@@) % وليس إلا بهجره أبدا % والضن عن بابه بإلمامي % % 5(@)(@@) % ورفع نفسي عن استماحته % % ببذل وجهي له وإعظامي % % 6(@)(@@) % ومنعه لذة التعتب بالع % % دل عليه في كل أحكامي % % 7(@)(@@) % ولا يراني هناك أندبه % بقرع سني وعض إبهامي % % 8(@)(@@) % وكنت لا أصنع الصنيع أرى % % في عقبه ذلتي للوامي % % 9(@)(@@) % أخرج من خاطري معاهده % بعد اشتغالي به وإغرامي % % 10(@)(@@) % حتى أراه لدى التذكر والتذ % % كير حلما من بعض أحلامي % % PageV01P4341 11(@)(@@) % وما من الحلم أن أقر على الظ % ظلم وأسبابه لظلامي % % 12(@)(@@) % أوصلني الحلم بالتشحط 