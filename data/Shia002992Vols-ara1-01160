ms1156	 إبراهيم بن أبي رجاء، وروى عنه أحمد بن محمد بن خالد.(@)(@@) الكافي: ج 2، ك 4، ب 24، ح 3.(@)(@@) * وروى عن إبراهيم بن الفضل، وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 5، ك 3، ب 98، ح 3.(@)(@@) * وروى عن أحمد بن محمد.(@)(@@) الفقيه: ج 3، ح 1754، * وروى عن أحمد بن محمد بن أبي نصر، وروى عنه علي بن الحسين بن فضال.(@)(@@) الكافي: ج 5، ك 3، ب 44، ذيل ح 7.(@)(@@) * وروى عن أحمد بن محمد الخزاعي، وروى عنه محمد بن خالد البرقي، الفقيه: المشيخة في طريقه إليه.(@)(@@) * وروى عن إسماعيل القصير، وروى عنه أبو عبد الله الرازي.(@)(@@) التهذيب: ج 4، ح 989.(@)(@@) * وروى عن أيمن بن محرز، وروى عنه أحمد بن أبي عبد الله، عن أبيه.(@)(@@) الكافي: ج 4، ك 1، ب 11، ح 5.(@)(@@) وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 5، ك 3، ب 44، ح 2.(@)(@@) وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 2، ك 1، ب 78، ح 15.(@)(@@) * وروى عن الحسن بن سيف بن عميرة، وروى عنه محمد بن حسان.(@)(@@) الكافي: ج 2، ك 3، ب 12، ح 11.(@)(@@) * وروى عن الحسن بن علي، وروى عنه محمد بن حسان.(@)(@@) التهذيب: ج 3، ح 261.(@)(@@) * وروى عن الحسن بن علي بن أبي حمزة، وروى عنه أحمد بن محمد بن خالد.(@)(@@) الكافي: ج 2، ك 2، ب 20، ح 6.(@)(@@) وروى عنه محمد بن حسان.(@)(@@) الكافي: ج 2، ك 3، ب 12، ح 3 و 10 PageV04P389(@)(@@) و 12.(@)(@@) * وروى عن الحسن بن علي بن أبي حمزة البطائني، وروى عنه محمد بن علي الصيرفي. الفقيه، المشيخة: في طريقه إلى الحسن بن علي بن أبي حمزة.(@)(@@) * وروى عن الحسن بن يوسف، وروى عنه أحمد بن محمد بن خالد.(@)(@@) الكافي: ج 2، ك 4، ب 14، ح 2.(@)(@@) * وروى عن الحسن القمي وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 1، ك 4، ب 108، ح 38.(@)(@@) * وروى عن حماد بن عثمان، وروى عنه أحمد بن محمد بن خالد.(@)(@@) الكافي: ج 2، ك 2، ب 48، ح 24، و ج 5، ك 2، ب 65، ح 1، و ج 6، ك 6، ب 77، ح 3. والتهذيب: ج 7، ح 709.(@)(@@) وروى عنه علي.(@)(@@) الروضة: ح 200.(@)(@@) * وروى عن درست.(@)(@@) التهذيب: ج 10، ح 732 (الاستبصار:(@)(@@) ج 4، ح 1014).(@)(@@) وروى عنه سهل بن زياد. 
ms1157	(@)(@@) الكافي: ج 7، ك 5، ب 21، ح 3.(@)(@@) والتهذيب: ج 6، ح 664.(@)(@@) * وروى عن درست بن أبي منصور، وروى عنه أحمد بن أبي عبد الله.(@)(@@) الكافي: ج 2، ك 1، ب 47، ح 13، وب 136، ح 5.(@)(@@) وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 3، ك 3، ب 91، ح 3.(@)(@@) * وروى عن درست الواسطي.(@)(@@) وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 3، ك 3، ب 86، ح 4.(@)(@@) * وروى عن زكريا بن آدم، وروى عنه أحمد بن أبي عبد الله.(@)(@@) الكافي: ج 5، ك 2، ب 13، ح 2.(@)(@@) وروى عنه جرير بن صالح.(@)(@@) الفقيه: المشيخة: في طريقه إلى داود الرقي.(@)(@@) * وروى عن سليمان الجعفري، وروى عنه أحمد بن محمد البرقي.(@)(@@) الكافي: ج 5، ك 3، ب 4، ح 5.(@)(@@) * وروى عن سيف بن عميرة، وروى عنه أحمد بن أبي عبد الله.(@)(@@) الكافي: ج 2، ك 1، ب 69، ح 12، و ج 6، ك 6، ب 32، ح 5.(@)(@@) وروى عنه أحمد بن محمد بن خالد.(@)(@@) الكافي: ج 1، ك 2، ب 20، ح 10، والكافي: ج 2، ك 1، ب 48، ح 12، وب 54، ح 6، وب 99، ح 31، و 32، PageV04P390(@)(@@) وب 121، ح 6، وب 129، ح 3، وب 139، ح 2، وب 143، ح 5، وب 161، ح 2، وك 2، ب 9، ح 4، وب 14، ح 1، وب 25، ح 2، والكافي:(@)(@@) ج 3، ك 3، ب 80، ح 5 و 6، وب 81، ح 3، والكافي: ج 4، ك 1، ب 21، ح 12، والكافي: ج 5، ك 1، ب 31، ح 1، وك 2، ب 50، ح 7، والكافي: ج 6، ك 9، ب 10، ح 1. والروضة: ح 490. والتهذيب: ج 6، ح 366.(@)(@@) وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 3، ك 3 ب 46، ح 2.(@)(@@) والتهذيب: ج 3، ح 491.(@)(@@) وروى عنه محمد بن عبد الله المسمعي ورجل آخر.(@)(@@) التهذيب: ج 1، ح 910.(@)(@@) * وروى عن صالح بن سعيد، وروى عنه أحمد بن محمد بن خالد.(@)(@@) الكافي: ج 1، ك 2، ب 22، ح 8.(@)(@@) * وروى عن صباح الحذاء، وروى أبو علي الأشعري، عن بعض أصحابه عنه.(@)(@@) الكافي: ج 3، ك 1، ب 46، ح 9.(@)(@@) * وروى عن صفوان بن يحيى، وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 2، ك 3، ب 12، ح 23.(@)(@@) وروى عن صفوان الجمال، وروى عنه أحمد بن محمد بن خالد.(@)(@@) الكافي: ج 2، ك 1، ب 86، ح 14.(@)(@@) * وروى عن عبد الله بن أبي الحارث الهمداني، وروى عنه أحمد بن محمد بن خالد.(@)(@@) الروضة: ح 193.(@)(@@) * وروى عن عبد 
ms1158	 الله بن الحارث، وروى عنه أحمد بن محمد بن خالد، وعلي بن الحسن التيمي.(@)(@@) الروضة: ح 550.(@)(@@) * وروى عن عبد الله بن عبد الرحمان، وروى عنه ابن مسعدة.(@)(@@) التهذيب: ج 6، ح 150.(@)(@@) * وروى عن عبد الله بن المغيرة، وروى عنه أحمد بن محمد بن خالد.(@)(@@) الكافي: ج 6، ك 8، ب 28، ح 7.(@)(@@) * وروى عن عبد الملك بن أبي الحارث، وروى عنه أحمد.(@)(@@) الكافي: ج 5، ك 3، ب 44، ح 3.(@)(@@) * وروى عن عبيد بن معاوية بن شريح، وروى عنه أحمد بن أبي عبد الله.(@)(@@) الكافي: ج 5، ك 3، ب 168، ح 5. PageV04P391(@)(@@) * وروى عن عبيس بن هشام، وروى عنه أحمد بن محمد بن خالد.(@)(@@) الكافي: ج 2، ك 3، ب 13، ح 1.(@)(@@) * وروى عن عثمان بن جبلة، وروى عنه أحمد بن محمد بن خالد.(@)(@@) الكافي: ج 2، ك 1، ب 66، ح 16.(@)(@@) * وروى عن عثمان بن عيسى.(@)(@@) الاستبصار: ج 4، ح 1015.(@)(@@) * وروى عن علي بن حمزة، وروى عنه أحمد بن خالد.(@)(@@) الكافي: ج 2، ك 2، ب 48، ح 25.(@)(@@) وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 3، ك 3، ب 26، ح 2.(@)(@@) والتهذيب: ج 1، ح 1006.(@)(@@) * وروى عن شمرو بن عمر، وروى عنه أحمد بن محمد بن خالد.(@)(@@) الكافي: ج 3، ك 3، ب 80، ح 7.(@)(@@) * وروى عن محمد بن أبي حمزة، وروى عنه أحمد بن محمد بن خالد.(@)(@@) الكافي: ج 6، ك 8، ب 43، ح 31.(@)(@@) * وروى عنه محمد بن أسلم، وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 5، ك 3، ب 102، ح 2.(@)(@@) والتهذيب: ج 7، ح 1153.(@)(@@) * وروى عن محمد بن حفص، وروى عنه أحمد بن أبي عبد الله.(@)(@@) الكافي: ج 2، ك 4، ب 24، ح 11، و ج 4، ك 3، ب 47، ح 4.(@)(@@) وروى عنه أحمد بن محمد بن خالد.(@)(@@) الكافي: ج 2، ك 4، ب 2، ح 2.(@)(@@) وروى عن محمد بن زياد، وروى عنه أحمد بن محمد بن خالد.(@)(@@) الكافي: ج 6، ك 6، ب 16، ح 8.(@)(@@) والتهذيب: ج 9، ح 367.(@)(@@) * وروى عن محمد بن منصور، وروى عنه محمد بن أحمد النهدي.(@)(@@) الروضة: ح 95.(@)(@@) * وروى عن محمد بن منصور الخزاعي وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 2، ك 1، ب 172، ح 11، و ج 7، ك 5، ب 3، ح 3، والروضة: ح 95.(@)(@@) والتهذيب: ج 6، ح 757.(@)(@@) وروى عنه 
ms1159	 محمد بن أحمد النهدي.(@)(@@) الكافي: ج 7، ك 5، ب 3، ذيل ح 3.(@)(@@) * وروى عن مخلد أبي الشكر، وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 2، ك 2، ب 34، ح 2.(@)(@@) * وروى عن مرازم، وروى عنه محمد ابن علي الكوفي.(@)(@@) الفقيه: ج 4، ح 897. PageV04P392(@)(@@) * وروى عن منذر بن جيفر، وروى عنه إبراهيم بن هاشم، وأحمد بن محمد ابن خالد، وعلي بن الحسن التيمي، ومحمد بن علي.(@)(@@) الروضة: ح 551.(@)(@@) وروى عنه أحمد بن محمد بن خالد.(@)(@@) الكافي: ج 2، ك 1، ب 99، ح 18.(@)(@@) * وروى عن منصور بن يونس، وروى عنه أحمد بن محمد بن خالد.(@)(@@) الكافي: ج 2، ك 2، ب 7، ح 3.(@)(@@) * وروى عن النضر بن سويد، وروى عنه منصور بن العباس.(@)(@@) الكافي: ج 4، ك 3، ب 85، ح 2.(@)(@@) والتهذيب: ج 5، ح 244 (الاستبصار:(@)(@@) ج 2، ح 1102).(@)(@@) * وروى عن يونس بن يعقوب، وروى عنه أحمد بن محمد بن خالد.(@)(@@) الكافي: ج 2، ك 1، ب 104، ح 3.(@)(@@) * وروى عن الكناسي، وروى عنه القاسم النهدي.(@)(@@) الكافي: ج 1، ك 4، ب 115، ح 4.(@)(@@) * وروى عن بعض رجاله، عن أبي عبد الله عليه السلام، وروى عنه سهل ابن زياد.(@)(@@) الكافي: ج 1، ك 1، ح 24.(@)(@@) * وروى عن رجل، عن إسحاق بن عمار، وروى عنه أحمد بن محمد بن خالد.(@)(@@) الكافي: ج 2، ك 2، ب 48، ح 33.(@)(@@) * وروى عمن حدثه، عن جابر بن يزيد، وروى عنه سهل بن زياد، وصالح ابن أبي حماد.(@)(@@) الروضة: ح 149.(@)(@@) إسماعيل بن همام * روى عن أبي الحسن عليه السلام، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 4، ك 3، ب 27، ح 5، وب 202، ح 8، و ج 7، ك 1، ب 13، ح 3. والتهذيب: ج 5، ح 949، و ج 9، ح 861 (الاستبصار: ج 4، ح 510).(@)(@@) وروى عنه العباس.(@)(@@) التهذيب: ج 2، ح 1080 (الاستبصار:(@)(@@) ج 1، ح 1056).(@)(@@) وروى عنه علي بن مهزيار.(@)(@@) التهذيب: ج 3، ح 983 (الاستبصار:(@)(@@) ج 1، ح 1840).(@)(@@) * وروى عن أبي الحسن الرضا عليه السلام، وروى عنه أحمد بن محمد. PageV04P393(@)(@@) الكافي: ج 4، ك 3، ب 158، ح 7، وب 174، ح 7.(@)(@@) وروى سهل بن زياد، عن بعض أصحابه، عنه.(@)(@@) التهذيب: ج 1، ح 1468.(@)(@@) وروى عن علي بن جعفر، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 5، ك 3، ب 140، ح 
