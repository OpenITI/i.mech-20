ms21	 وأخوهما محمد، وهم رسل النبي صلى الله عليه وآله إلى اليمن، قتلا بصفين معه عليه السلام.(@)(@@)(@@)(@@) $ 644 - عمرو بن الحمق الخزاعي.(@)(@@)(@@)(@@) $ 645 - عبد الله بن الحارث، أخو مالك الأشتر.(@)(@@)(@@)(@@) $ 646 - عامر بن واثلة، يكنى أبا الطفيل، أدرك ثمان سنين من حياة النبي صلى الله عليه وآله، ولد عام أحد.(@)(@@)(@@)(@@) $ 647 - عرفة الأزدي 1، كان رسول الله صلى الله عليه وآله دعا له وقال:(@)PageV00P070(@)(@@) (اللهم بارك له في صفقته).(@)(@@)(@@)(@@) $ 648 - عثمان بن حنيف الأنصاري، عربي.(@)(@@)(@@)(@@) $ 649 - عبادة بن الصامت ابن أخي أبي ذر، ممن أقام بالبصرة وكان شيعيا.(@)(@@)(@@)(@@) $ 650 - عبيد بن عبد، 1 يكنى أبا عبد الله الجدلي، وقيل: إنه كان تحت راية المختار.(@)(@@)(@@)(@@) $ 651 - عبد الله بن يحيي الحضرمي، 2 يكنى أبا الرضا.(@)(@@)(@@)(@@) $ 652 - عبيدة السلماني.(@)(@@)(@@)(@@) $ 653 - علي بن ربيعة الوالبي الأسدي، وكان من العباد.(@)(@@)(@@)(@@) $ 654 - عبيد الله بن أبي رافع، كاتبه عليه السلام.(@)(@@)(@@)(@@) $ 655 - عبد الله بن شداد بن الهاد الليثي، عربي كوفي.(@)(@@)(@@)(@@) $ 656 - عباية بن ربعي الأسدي.(@)(@@)(@@)(@@) $ 657 - عامر بن صخرة السكوني، 3 عربي كوفي.(@)(@@)(@@)(@@) $ 658 - عبيد بن أبي الجعد. 4(@)(@@)(@@)(@@) $ 659 - عبد الرحمان بن عوسجة.(@)PageV00P071(@)(@@)(@@)(@@) $ 660 - عبد خير بن ناجذ، يكنى أبا صادق الأزدي. 1(@)(@@)(@@)(@@) $ 661 - عبيد بن نضلة الخزاعي، قال ابن الأعمش لأبيه: على من قرأت القرآن؟ قال: على يحيي بن وثاب، وقرأ يحيي بن وثاب على عبيد بن نضلة، كان يقرأ كل يوم آية ففرغ من القرآن في سبع وأربعين سنة، ويحيي بن وثاب كان مستقيما، وذكر الأعمش انه كان إذا صلى كأنه يخاطب أحدا.(@)(@@)(@@)(@@) $ 662 - عبد الله بن خليفة، يكنى أبا الغريف، الهمداني. 2(@)(@@)(@@)(@@) $ 663 - عبد الله بن ربيعه السلمي.(@)(@@)(@@)(@@) $ 664 - عباية بن رفاعة بن رافع بن خديج الأنصاري. 3(@)(@@)(@@)(@@) $ 665 - عبد الرحمان بن أبي ليلي الأنصاري، شهد مع أمير المؤمنين عليه السلام، عربي كوفي.(@)(@@)(@@)(@@) $ 666 - عمرو ذومر الهمداني، عربي كوفي. 4(@)(@@)(@@)(@@) $ 667 - عقيل بن أبي طالب.(@)(@@)(@@)(@@) $ 668 - عمرو بن ثعلبة.(@)(@@)(@@)(@@) $ 669 - عقبة بن عمرو، بدري.(@)(@@