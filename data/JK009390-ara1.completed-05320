ms5301	 هق ) . )(@)(@@)(@@)(@@) $ 7016 عن علي رضي الله عنه قال :(@)(@@) | 30 ( من السنة أن يمشي الرجل إلاى المصلى قال : والخروج يوم العيدين من السنة ، ولا يخرج إلاى المسجد إلا ضعيف أو مريض ، لاكن اخرجوا إلاى الجبل ولا تحبسوا النساء ) . ( هق ) . )(@)(@@)(@@)(@@) $ 7017 عن علي رضي الله عنه قال :(@)(@@) | 30 ( من السنة أن تأتي العيد ماشيا ، ثم تركب إذا رجعت ) . ( هق ) . )(@)(@@)(@@)(@@) $ 7018 عن علي رضي الله عنه قال :(@)(@@) | 30 ( كان رسول الله يطعم يوم الفطر قبل أن يخرج إلاى المصلى ) . ( عق ، طس ) . )(@)(@@)(@@)(@@) $ 7019 عن علي رضي الله عنه قال :(@)(@@) | 30 ( من السنة أن يطعم الرجل يوم الفطر قبل أن يخرج إلاى المصلى ) . ( هق ) . )(@)(@@)(@@)(@@) $ 7020 عن هزيل :(@)(@@) | 30 ( أن عليا رضي الله عنه أمر رجلا يصلي بضعفة الناس في المسجد يوم فطر أو يوم أضحى ، وأمره أن يصلي أربعا ) . ( هق ، طس ) . )(@)(@@)(@@)(@@) $ 7021 عن أبي عثمان النهدي عن شيخ من أهل الكوفة(@)(@@) | 30 ( أن علي بن أبي طالب رضي الله عنه خرج يوم عيد فإذا الناس يصلون قبل خروج الامام ، فقال له رجل : ألا تنهى هاؤلأ عن الصلاة ؟ فقال : إذا أكون كما قال الله تعالاى : { الذي ينهى عبدا إذا صلى } ولاكن نحدثهم بما شهدنا مع رسول الله ، خرج فلم يصل قبلها ولا بعدها ) . ( زاهر في تحفة عيد الأضحى ) . )(@)(@@)(@@)(@@) $ 7022 عن جعفر بن محمد عن علي رضي الله عنه :(@)(@@) | 30 ( أنه جهر بالقراءة في PageV16P065 العيدين وصلاة الاستسقاء وصلى قبل الخطبة وكبر سبعا وخمسا ) . ( أبو العباس الأصم في حديثه ) . )(@)(@@)(@@)(@@) $ 7023 عن علي رضي الله عنه :(@)(@@) | 30 ( أنه صلى يوم عيد بغير أذان ولا إقامة ) . ( ش ) . )(@)(@@)(@@)(@@) $ 7024 عن ميسرة أبي جميلة قال :(@)(@@) | 30 ( شهدت العيد مع علي رضي الله عنه فلما صلى خطب قال : وكان عثمان يفعله ) . ( ش ) . )(@)(@@)(@@)(@@) $ 7025 عن يزيد عن ابن أبي ليلاى قال :(@)(@@) | 30 ( صلى بنا علي رضي الله عنه العيد ، ثم خطب علاى راحلته ) . ( ش ) . )(@)(@@)(@@)(@@) $ 7026 عن الحارث عن علي رضي الله عنه :(@)(@@) | 30 ( أنه كان يكبر في الفطر إحدى عشر ، ستا في الاولاى ، وخمسا 
ms5302	 في الآخرة يبدأ بالقراءة في الركعتين ) . ( ش ) . )(@)(@@)(@@)(@@) $ 7027 عن الأسود بن هلال قال :(@)(@@) | 30 ( خرجت مع علي رضي الله عنه فلما صلى الامام العيد قام فصلى بعدها أربعا ) . ( ش ) . )(@)(@@)(@@)(@@) $ 7028 عن الحارث قال :(@)(@@) | 30 ( كان علي رضي الله عنه إذا قرأ في العيدين أسمع من يليه ولا يجهر كل الجهر ) . ( ش ) . )(@)(@@)(@@)(@@) $ 7029 عن علي رضي الله عنه قال :(@)(@@) | 30 ( حق علاى كل ذات نطاق أن تخرج إلاى العيدين ولم يكن يرخص لهن في شيء من الخروج إلا العيدين ) . ( ش ) . )(@)(@@)(@@)(@@) $ 7030 عن علي رضي الله عنه قال :(@)(@@) | 30 ( الخروج إلاى الجبان في العيدين من السنة ) . ( طس ، هق ) . )(@)(@@)(@@)(@@) $ 7031 عن علي رضي الله عنه قال :(@)(@@) | 30 ( من السنة الصلاة في الجبان ) . ( طس ) . )(@)(@@) PageV16P066(@)(@@)(@@)(@@) $ 7032 عن علي رضي الله عنه قال :(@)(@@) | 30 ( الجهر في صلاة العيدين من السنة ) . ( طس ، هق ) . )(@)(@@)(@@)(@@) $ 7033 عن حنش :(@)(@@) | 30 ( أن عليا رضي الله عنه يوم الأضحى كبر حتى انتهى إلاى العيد ) . ( ش ) . )(@)(@@)(@@)(@@) $ 7034 عن الحارث عن علي رضي الله عنه عن النبي أنه قال في صدقة الفطر :(@)(@@) | 30 ( عن كل صغير وكبير ، حر وعبد نصف صاع من بر ، وصاع من تمر ) . ( قط ) . )(@)(@@)(@@)(@@) $ 7035 عن الحارث :(@)(@@) | 30 ( أن عليا رضي الله عنه كان يقول في صدقة الفطر صاعا من شعير ، فإن لم يجد فصاعا من تمر ، فإن لم يجد فصاعا من زبيب ) . ( أبو مسلم الكاتب في أماليه ) . )(@)(@@)(@@)(@@) $ 7036 عن علي رضي الله عنه قال :(@)(@@) | 30 ( فرض رسول الله علاى كل صغير أو كبير ، حر أو عبد ، ممن يمونون صاعا من شعير ، أو صاعا من تمر ، أو صاعا من زبيب عن كل إنسان ) . ( هق ) . )(@)(@@)(@@)(@@) $ 7037 عن علي رضي الله عنه قال :(@)(@@) | 30 ( من جرت عليه نفقتك فأطعم عنه نصف صاع من بر ، أو صاعا من تمر ) . ( هق ) . )(@)(@@)(@@)(@@) $ ( 7038 ) عن الحارث : : أنه سمع عليا رضي الله عنه يأمر بزكاة الفطر فيقول : هي صاع من تمر ، أو صاع من حنطة أو سلت أو زبيب ' . ( هق ) .(@)(@@)(@@)(@@) $ 7039 عن علي رضي الله عنه قال :(@)(@@) | 30 
ms5303	 ( كان داود عليه السلام ، يصوم يوما ويفطر يومين : يوما لقضائه ، ويوما لنسائه ) . ( كر ) . )(@)(@@) PageV16P067(@)(@@)(@@)(@@) $ 7040 عن الأسود بن يزيد قال :(@)(@@) | 30 ( ما رأيت أحدا كان أمر بصيام يوم عاشوراء ) . ( عن علي وأبي موسى رضي الله عنهما ابن جرير ق ) . )(@)(@@)(@@)(@@) $ 7041 عن جسرة بنت دجاجة قالت :(@)(@@) | 30 ( قيل لعائشة رضي الله عنها : إن عليا رضي الله عنه أمر بصيام يوم عاشوراء ، قالت : هو أعلم من بقي بالسنة ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 7042 عن أبي مارية قال :(@)(@@) | 30 ( سمعت عليا رضي الله عنه يقول يوم عاشوراء : يا أيها الناس من أكل منكم فليصم بقية يومه ، ومن لم يكن أكل فليتم صومه ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 7043 عن الاسود بن يزيد قال :(@)(@@) | 30 ( ما أدركت أحدا من أصحاب رسول الله كان آمر بصوم عاشوراء من علي وأبي موسى رضي الله عنهما ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 7044 عن علي رضي الله عنه قال :(@)(@@) | 30 ( صم رمضان والذي يليه ، وكل أربعاء وخميس ، فإذا أنت صمت الدهر كله وأفطرت ) . ( الديلمي عن مسلم القرشي ) . )(@)(@@)(@@)(@@) $ 7045 عن علي رضي الله عنه عن النبي :(@)(@@) | 30 ( صيام ثلاثة أيام من كل شهر ، صيام الدهر كل يوم عشرة أيام ) . { من جاء بالحسنة فله عشر أمثالها } . ( ابن مردويه ، خط ) . )(@)(@@)(@@)(@@) $ 7046 عن علي رضي الله عنه قال :(@)(@@) | 30 ( صوم ثلاثة أيام من كل شهر صوم الدهر ، وهو يذهب وحر الصدر ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 7047 عن علي رضي الله عنه قال :(@)(@@) | 30 ( صوم شهر الصبر ، وصوم ثلاثة أيام PageV16P068 من كل شهر صوم الدهر ، وهن يذهبن بلابل الصدر ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 7048 عن علي رضي الله عنه :(@)(@@) | 30 ( أن رجلا قال للنبي : الرجل يحب القوم ولا يستطيع أن يعمل بعملهم ؟ قال : المرء مع من أحب ) . ( ط ) . )(@)(@@)(@@)(@@) $ 7049 عن زيد بن أبي أوفى قال :(@)(@@) | 30 ( لما آخى النبي بين أصحابه ، قال علي رضي الله عنه : لقد ذهب روحي ، وانقطع ظهري حين رأيتك فعلت بأصحابك ما فعلت غيري ، فإن كان هاذا من سخط علي ، فلك العتبى والكرامة ، فقال رسول الله : والذي بعثني بالحق ما أخرتك إلا 
ms5304	 لنفسي ، وأنت مني بمنزلة هارون من موسى غير أنه لا نبي بعدي ، وأنت أخي ووارثي ، قال : وما أرث منك يا رسول الله ؟ قال : ما ورثت الأنبياء من قبلي ، قال : وما ورثت الأنبياء من قبلك ؟ قال : كتاب ربهم وسنة نبيهم ، وأنت معي في قصري في الجنة مع فاطمة بنتي ، وأنت أخي ورفيقي ) . ( حم في كتاب مناقب علي ، ابن عساكر ) . )(@)(@@)(@@)(@@) $ 7050 عن أبي الطفيل عن علي رضي الله عنه قال :(@)(@@) | 30 ( الأرواح جنود مجندة ، ما تعارف منها ائتلف ، وما تناكر منها اختلف ) . ( الخرائطي في اعتلال القلوب ) . )(@)(@@)(@@)(@@) $ 7051 عن شقيق بن سلمة قال :(@)(@@) | 30 ( جاء رجل إلاى علي رضي الله عنه وكلمه ، فقال في عرض الحديث : إني أحبك ، فقال له علي : كذبت ، قال : لم يا أمير المؤمنين ؟ قال : لأني لا أرى قلبي يحبك ، قال النبي : إن الأرواح كانت تلاقى في الهواء فتشام ، ما تعارف منها ائتلف ، وما تناكر منها اختلف ، فلما كان من أمر علي ما كان ، كان ممن خرج عليه ) . ( السلفي في انتخاب حديث الفراء ، ورجاله ثقات ) . )(@)(@@)(@@)(@@) $ 7052 عن علي رضي الله عنه قال :(@)(@@) | 30 ( أحبب حبيبك هونا ما ، عسى أن يكون بغيضك يوما ما ، وأبغض بغيضك هونا ما ، عسى أن يكون حبيبك يوما ما ) . ( مسدد PageV16P069 وابن جرير ، هب ، وقال : روي من أوجه ضعيفة مرفوعا ، والمحفوظ موقوف ) . )(@)(@@)(@@)(@@) $ 7053 عن المدائني قال :(@)(@@) | 30 ( قال علي بن أبي طالب رضي الله عنه : لا تؤاخ الفاجر فإنه يزين لك فعله ، ويحب لو أنك مثله ، ويزين لك أسوأ خصاله ، ومدخله عليك ومخرجه من عندك شين وعار ، ولا الأحمق فإنه يجهد نفسه لك ولا ينفعك ، وربما أراد أن ينفعك فيضرك ، فسكوته خير من نطقه ، وبعده خير من قربه ، وموته خير من حياته ، ولا الكذاب فإنه لا ينفعك معه عيش ، ينقل حديثك وينقل الحديث إليك ، وإن تحدث بالصدق فما يصدق ) . ( الدينوري ، كر ) . )(@)(@@)(@@)(@@) $ 7054 عن علي رضي الله عنه قال :(@)(@@) | 30 ( اعرف الحق لمن عرفه لك شريفا أو وضيعا ، واطرح عنك واردات الهموم بعزائم الصبر ) . ( ابن أبي الدنيا في 
ms5305	 الصبر والدينوري ) . )(@)(@@)(@@)(@@) $ 7055 عن علي رضي الله عنه قال :(@)(@@) | 30 ( من أراد أن ينصف الناس من نفسه ، فليحب لهم ما يحب لنفسه ) . ( كر ) . )(@)(@@)(@@)(@@) $ 7056 عن الشعبي قال : $ 30 قال علي بن أبي طالب رضي الله عنه لرجل ذكر له صحبة رجل به رهق : أي خفة وحده .(@)(@@) لا تصحب أخا الجهل %~% وإياك وإياه(@)(@@) فكم من جاهل أردى %~% حليما حين آخاه(@)(@@) يقاس المرء بالمرء %~% إذا ما هو ماشاه(@)(@@) وللشيء من الشيء %~% مقاييس وأشباه(@)(@@) وللقلب علاى القلب %~% دليل حين يلقاه ) $(@)(@@)(@@)(@@) $ 7057 عن علي رضي الله عنه قال :(@)(@@) | 30 ( من أنزل الناس منازلهم رفع المؤنة عن نفسه ، ومن رفع أخاه فوق قدره اجتر عداوته ) . ( النولسي في العلم ) . )(@)(@@) PageV16P070(@)(@@)(@@)(@@) $ 7058 عن نهار البحري قال : قال علي بن أبي طالب رضي الله عنه :(@)(@@) | 30 ( إياك وصحبة الفاجر ، والكذاب ، والأحمق ، والبخيل ، والجبان ، فأما الفاجر فيزرى فعله ود أنك مثله ، فدخوله عليك شين ، وخروجه من عندك شين ، وأما الكذاب فينقل حديثك إلاى الناس ، وحديث الناس إليك ، فيشب العداوة ، وينبت السخائم في صدور الناس ، وأما الأحمق فلا يهديك لرشد ، ولا يصرف السوء عن نفسه ، فبعده خير لك من قربه ، وسكوته خير لك من نطقه ، وموته خير لك من حياته ، وأما البخيل فأقرب ما تكون منه ، أبعد ما يكون إن احتجت ، وأما الجبان فحين ينزل بك أمر تحتاج إلاى عونه يفر ويدعك ) . ( وكيع ) . )(@)(@@)(@@)(@@) $ 7059 عن علي رضي الله عنه قال :(@)(@@) | 30 ( اتقوا أبواب السلطان ) . ( هب ) . )(@)(@@)(@@)(@@) $ 7060 عن ضمرة قال :(@)(@@) | 30 ( جاء رجل إلاى علي بن أبي طالب رضي الله عنه يشكو جاره فقال : الحجارة تجيئني في الليلا يرمى بها ، فقال : أعدها من حيث تجيئك ، ثم قال : إن الشر لا يصلحه إلا الشر ) . ( ابن السمعاني ) . )(@)(@@)(@@)(@@) $ 7061 عن علي رضي الله عنه قال :(@)(@@) | 30 ( أهديت لرسول الله بغلة فأعجبته فركبها ، فقلنا : يا رسول الله لو أنزينا الحمر علاى خيلنا فجاءت بمثل هاذه ، فقال رسول الله : إنما يفعل ذالك الذين لا يعلمون ) . ( ط ، وابن وهب حم ، د ، ن ، وابن جرير وصححه ، والطحاوي حب والدورقي 
ms5306	 ق ، ص ) . )(@)(@@)(@@)(@@) $ 7062 عن علي رضي الله عنه قال : $ 30 ( نهانا رسول الله أن ننزي حمارا علاى فرس ) . ( حم ، د ، والدورقي ) .(@)(@@)(@@)(@@) $ 7063 عن علي بن ربيعة قال :(@)(@@) | 30 ( رأيت عليا رضي الله عنه أتي بدابة ، فلما وضع رجله في الركاب قال : بسم الله ، فلما استوى عليها قال : الحمد لله { الذي PageV16P071 سخر لنا هاذا وما كنا له مقرنين وإنا إلاى ربنا لمنقلبون } ثم حمد الله ثلاثا ، وكبر ثلاثا وقال : سبحان الله ثلاثا ، ثم قال : سبحانك لا إلاه إلا أنت ، إني ظلمت نفسي فاغفر لي ذنوبي إنه لا يغفر الذنوب إلا أنت ، ثم ضحك ، فقلت : مم ضحكت يا أمير المؤمنين ؟ قال : كنت ردف النبي ففعل مثل ما فعلت ، ثم ضحك ، فقلت : مم ضحكت يا رسول الله ؟ قال : عجب الرب من عبده إذا قال : رب اغفر لي ، ويقول : علم عبدي أنه لا يغفر الذنوب غيري ، وفي لفظ : إن الله ليضحك إلاى العبد إذا قال : لا إلاه إلا أنت ، سبحانك إني ظلمت نفسي فاغفر لي ذنوبي إنه لا يغفر الذنوب إلا أنت ، قال : عبدي عرف أن له ربا يغفر ويعاقب ) . ( ط ، حم ، وعبد بن حميد ، ت ، وقال : حسن صحيح ، ن ، ع ، وابن خزيمة وابن شاهين في السنة وابن مردويه ك ، ق ، ض ) . )(@)(@@)(@@)(@@) $ 7064 عن زاذان قال :(@)(@@) | 30 ( رأى علي رضي الله عنه ثلاثة علاى بغل فقال : لينزل أحدكم فإن رسول الله لعن الثالث ) . ( د ، في مراسيله ) . )(@)(@@)(@@)(@@) $ 7065 عن علي رضي الله عنه :(@)(@@) | 30 ( نهى عن مياثر الارجوان ) . ( د ) . )(@)(@@)(@@)(@@) $ 7066 عن علي رضي الله عنه قال :(@)(@@) | 30 ( نهاني رسول الله عن لبس القسي المرجم ، وأن أفترش حلس دابتي الذي يلي ظهرها ، وأن أضع حلس دابتي علاى ظهرها حتى أذكر اسم الله ، فإن علاى كل ذروة شيطانا ، فإذا ذكر اسم الله خنس ) . ( الدورقي ) . )(@)(@@)(@@)(@@) $ 7067 عن هلال بن خباب :(@)(@@) | 30 ( أن عليا رضي الله عنه أتي بدابة فلما وضعع رجله في الركاب قال : بسم الله ، فلما استوى علاى ظهرها قال : الحمد لله الذي PageV16P072 هدانا للاسلام وعلمنا القرآن 
ms5307	 ، ومن علينا بمحمد وجعلنا في خير أمة أخرجت للناس ، اللهم لا طير إلا طيرك ، ولا خير إلا خيرك ، ولا إلاه إلا أنت ) . ( رسته ) . )(@)(@@)(@@)(@@) $ 7068 عن علي رضي الله عنه قال :(@)(@@) | 30 ( أمرني النبي أن آتيه بطبق يكتب عليه ما لا تضل أمته بعده ، خشيت أن يفوتني نفسه قلت : إني لأحفظ وأعي ، قال : أوصي بالصلاة والزكاة وما ملكت أيمانكم ) . ( حم ، ص ) . )(@)(@@)(@@)(@@) $ 7069 عن الحارث :(@)(@@) | 30 ( أن رجلا وسم غلاما له في وجهه فأعتقه علي رضي الله عنه ) . ( الخرائطي في اعتلال القلوب ) . )(@)(@@)(@@)(@@) $ 7070 عن علي رضي الله عنه قال :(@)(@@) | 30 ( كان رسول الله إذا دخل علاى المريض قال : أذهب البأس رب الناس ، واشف أنت الشافي لا شافي إلا أنت ) . ( ش ، ورواه حم ، ت وقال : حسن غريب ، والدورقي وابن جرير وصححه بلفظ : لا شفاء إلا شفاؤك ، شفاء لا يغادر سقما ) . )(@)(@@)(@@)(@@) $ 7071 عن علي رضي الله عنه قال :(@)(@@) | 30 ( اشتكيت فدخل علي النبي وأنا أقول : اللهم إن كان أجلي قد حضر فأرحني ، وإن كان متأخرا فاشفني ، وإن كان بلأ فصبرني ، فضربني برجله وقال : كيف قلت ؟ فقلت له ، فمسحني بيده ثم قال : اللهم اشفه ، أو قال : عافه ، فما اشتكيت ذالك الوجع بعد ) . ( ط ، ش ، حم ، ت وقال : حسن صحيح ، ن ، ع ، ض وابن جرير وصححه حب ، ك ، حل ) . )(@)(@@)(@@)(@@) $ 7072 عن الحكم عن عبد الله بن نافع قال :(@)(@@) | 30 ( عاد أبو موسى الحسن بن علي ، فقال علي رضي الله عنه : أما إنه ، ما من مسلم يعود مريضا إلا خرج معه سبعون ألف ملك يستغفرون له ، إن كان مريضا إلا خرج معه سبعون ألف ملك يستغفرون له ، إن كان مصبحا حتى يمسي وكان له خريف في الجنة ، وإن كان ممسيا خرج معه سبعون ألف ملك كلهم يستغفرون له وكان له خريف PageV16P073 في الجنة ) . ( ابن جرير ، هب ، وقال : هاكذا رواه أكثر أصحاب شعبة موقوفا ، وقد روي من غير وجه عن علي مرفوعا ) . )(@)(@@)(@@)(@@) $ 7073 عن علي رضي الله عنه قال :(@)(@@) | 30 ( كان رسول الله إذا عاد مريضا وضع يده 
ms5308	 اليمنى علاى خده اليمنى وقال : لا بأس ، أذهب البأس رب الناس ، اشف أنت الشافي ، لا يكشف الضر إلا أنت ) . ( ابن مردويه وأبو علي الحداد في معجمه ) . )(@)(@@)(@@)(@@) $ 7074 عن علي رضي الله عنه قال :(@)(@@) | 30 ( دعاني رسول الله فقال : ما من مريض لم يحضر أجله تعوذ بهاذه الكلمات إلا خف عنه : بسم الله العظيم ، أسأل الله العظيم ، رب العرش العظيم ، أن يشفيه ، سبع مرات ) . ( ابن النجار ) . )(@)(@@)(@@)(@@) $ 7075 عن علي رضي الله عنه قال :(@)(@@) | 30 ( كان رسول الله إذا عاد مريضا وضع يده علاى رأسه فقال : أذهب البأس رب الناس واشف أنت الشافي ، اللهم إني أسألك لفلان بن فلان شفاء لا يغادر سقما ) . ( الدورقي ) . )(@)(@@)(@@)(@@) $ 7076 عن علي رضي الله عنه قال :(@)(@@) | 30 ( ستة لا يسلم عليهم : اليهود والنصارى والمجوس ، والذينع من بين أيديهم الخمر ، والريحان والمتفكهون بالامهات ، وأصحاب الشطرنج ) . ( الخرائطي في مساوىء الأخلاق ) . )(@)(@@)(@@)(@@) $ 7077 قال الحافظ أبو بكر بن مسدي في مسلسلاته :(@)(@@) | 30 صافحت أبا عبد الله محمد بن عبد الله بن عبشوي النغزاوي بها قال : صافحت أبا الحسن علي بن سيف الحضري بالاسكندرية ( ح ) وصافحت أيضا أبا القاسم عبد الرحمان بن أبي الفضل المالكي بالإسكندرية ، قال : صافحت شبل بن أحمد بن شبل قدم علينا قال : كل واحد منهما صافحت أبا محمد عبد الله بن مقبل بن محمد العجيبي قال : صافحت PageV16P074 محمد بن الفرج بن الحجاج السكسكي قال : صافحت أبا مروان عبد الملك بن أبي ميسرة قال : صافحت أحمد بن محمد النغزي بها ، قال : صافحت أحمد الأسود قال : صافحت ممشاد الدينوري قال : صافحت علي بن الرزيني الخراساني قال : صافحت عيسى القصار قال : صافحت الحسن البصري قال : صافحت علي بن أبي طالب رضي الله عنه قال : صافحت رسول الله قال : صافحت كفي هاذه سرادقات عرش ربي عز وجل ) . قال ابن مسدى : غريب لا نعلمه إلا من هاذا الوجه وهاذا إسناد صوفي : انتهى . قلت : قال الشيخ جلال الدين السيوطي رحمه الله : أخبرني بهاذا الحديث نشوان بنت الجمال عبد الله الكتاني إجازة عن أحمد ابن 
ms5309	 أبي بكر بن عبد الحميد بن قدامة المقدسي عن عثمان بن محمد التوزري عن ابن مسدى . انتهى ) . )(@)(@@)(@@)(@@) $ 7078 عن علي رضي الله عنه :(@)(@@) | 30 ( أنه رأى رجلا في الشمس قاعدا فنهاه عن القعود وقال : قم عنها فإنها مبخرة مجعرة تنقل الريح ، وتبلي الثوب ، وتظهر الداء الدفين ) . ( الدينوري ) . )(@)(@@)(@@)(@@) $ 7079 عن علي رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : إذا عطس أحدكم فليقل : الحمد لله ، وليقل له : يرحمك الله ، وليقل : يهديكم الله ويصلح بالكم ) . ( هب ) . )(@)(@@)(@@)(@@) $ 7080 عن علي رضي الله عنه قال :(@)(@@) | 30 ( من قال عند كل عطسة سمعها : الحمد لله رب العالمين علاى كل حال ما كان : لم يجد وجع الضرس ولا أذن أبدا ) . ( ش ، خ في الأدب وابن السني وأبو نعيم في الطب ) . )(@)(@@)(@@)(@@) $ 7081 عن علي رضي الله عنه قال :(@)(@@) | 30 ( لأن أجمع ناسا من أصحابي علاى PageV16P075 صاع من طعام أحب إلي من أن أخرج إلاى السوق فأشتري نسمة فأعتقها ) . ( خ في الأدب وابن زنجويه في ترغيبه ) . )(@)(@@)(@@)(@@) $ 7082 عن حجر بن عدي قال :(@)(@@) | 30 ( حدثنا علي بن أبي طالب رضي الله عنه أن الطهور نصف الايمان ) . ( عب ، ش ورسته في الايمان واللالكائي في السنة ، عب ، كر ) . )(@)(@@)(@@)(@@) $ 7083 عن شريح بن هانىء قال :(@)(@@) | 30 سمعت عليا رضي الله عنه يقول : ( من أحسن الطهور ثم مشى إلاى المسجد كان في صلاة ما لم يحدث ) . ( عب ) . )(@)(@@)(@@)(@@) $ 7084 عن علي رضي الله عنه قال :(@)(@@) | 30 ( الطهور شطر الايمان ) . ( ش ) . )(@)(@@)(@@)(@@) $ 7085 عن علي رضي الله عنه :(@)(@@) | 30 ( أن رسول الله مسح رأسه مرة ) . ( ه ) . )(@)(@@)(@@)(@@) $ 7086 عن علي رضي الله عنه :(@)(@@) | 30 ( أنه توضأ فمسح رأسه مسحة واحدة ) . ( عب ) . )(@)(@@)(@@)(@@) $ 7087 عن علي رضي الله عنه عن النبي قال :(@)(@@) | 30 ( إذا توضأ الرجل فهو في صلاة ما لم يحدث ، وقال علي رضي الله عنه : أستحييكم مما لم يستحي منه رسول الله ، الحدث : أن يفسو أو يضرط ) . ( ابن جرير وصححه ) . )(@)(@@)(@@)(@@) $ 7088 عن الهزال بن سبرة :(@)(@@) | 30 ( أنه رأى عليا رضي الله عنه بال وهو قائم ، ثم دعا 
ms5310	 بماء فتوضأ ، ثم مسح علاى نعليه وقدميه ، ثم دخل المسجد فخلع نعليه ثم صلى ) . ( ص ) . )(@)(@@)(@@)(@@) $ 7089 عن أبي وائل قال :(@)(@@) | 30 ( رأيت عثمان وعليا رضي الله عنهما يتوضآن ثلاثا ثلاثا ويقولان : هاكذا كان وضوء رسول الله ) . ( ط ، ه ، والطحاوي ) . )(@)(@@)(@@)(@@) $ 7090 عن أبي حية قال :(@)(@@) | 30 ( رأيت عليا رضي الله عنه توضأ فغسل كفيه ثلاثا ، PageV16P076 ومضمض واستنشق ثلاثا ، ثم غسل وجهه ثلاثا ، وذراعيه ثلاثا ، ومسح برأسه ، ثم غسل قدميه إلاى الكعبين ثلاثا ، ثم قام فشرب فضل وضوئه قائما ، ثم قال : إن رسول الله فعل ، الذي رأيتموني فعلت ، فأحببت أن أريكم ) . ( عب ، ش ، حم ، د ، ت ، ن ، ع ، والطحاوي والهروي في مسند علي ، ض ، وروى ه بعضه ) . )(@)(@@)(@@)(@@) $ 7091 عن عبد خير قال :(@)(@@) | 30 ( توضأ علي رضي الله عنه فمضمض ثلاثا ، واستنشق ثلاثا من كف واحدة ، وغسل وجهه ثلاثا ، ثم أدخل يده في الركوة فمسح رأسه ، وغسل رجليه ، ثم قال : هاذا وضوء نبيكم محمد ) . ( عب ، ش ، ك ) . )(@)(@@)(@@)(@@) $ 7092 عن علي رضي الله عنه قال :(@)(@@) | 30 ( كان النبي يتوضأ ثلاثا ثلاثا إلا المسح مرة مرة ) . ( ش ) . )(@)(@@)(@@)(@@) $ 7093 عن عبد خير قال :(@)(@@) | 30 ( كنا مع علي رضي الله عنه يوما صلاة الغداة ، فلما انصرف دعا بالطست فتوضأ ، ثم أدخل أصبعيه في أذنيه ، ثم قال لنا : هاكذا رأيت رسول الله توضأ ) . ( ش ) . )(@)(@@)(@@)(@@) $ 7094 عن الحسين بن علي قال :(@)(@@) | 30 ( دعا علي رضي الله عنه بوضوء فقرب له ، فغسل كفيه ثلاث مرات قبل أنح يدخلهما في وضوئه ، ثم مضمض ثلاثا ، واستنشق ثلاثا ، ثم غسل وجهه ثلاثا ، ثم غسل يده اليمنى إلاى المرفق ثلاثا ، ثم اليسرى كذالك ، ثم مسح برأسه مسحة واحدة ، ثم غسل رجله اليمنى إلاى الكعبين ثلاثا ، ثم اليسرى كذالك ، ثم قام قائما فقال لي : ناولني فناولته الذي فيه فضل وضوئه فشربه قائما ، فعجبت فلما رأى عجبي قال : لا تعجب ، فإني رأيت أباك النبي يصنع مثل ما رأيتني ، يقول بوضوئه هاذا ، ويشرب فضل وضوئه قائما ) . ( ن ، والطحاوي وابن جرير ، وصححه ش ) . )(@)(@@) PageV16P077(@)(@@)(@@)(@@) $ 7095 عن سالم بن أبي 
ms5311	 الجعد عن علي رضي الله عنه قال :(@)(@@) | 30 ( إذا توضأ الرجل فليقل : أشهد أن لا إلاه إلا الله وأشهد أن محمدا عبده ورسوله ، اللهم اجعلني من التوابين واجعلني من المتطهرين ) . ( عب ، ص ) . )(@)(@@)(@@)(@@) $ 7096 عن علي رضي الله عنه :(@)(@@) | 30 ( أن النبي توضأ فمضمض ثلاثا ، واستنشق ثلاثا من كف واحدة ) . ( عب ، ه ) . )(@)(@@)(@@)(@@) $ 7097 عن الحارث قال :(@)(@@) | 30 ( دعا علي رضي الله عنه بماء فغسل يديه ثلاثا قبل أن يدخلهما الاناء ، ثم قال : هاكذا رأيت رسول الله صنع ) . ( ش ، ه ) . )(@)(@@)(@@)(@@) $ 7098 عن زر بن حبيش :(@)(@@) | 30 ( أن عليا رضي الله عنه سئل عن وضوء رسول الله فغسل يديه ثلاثا ، ووجهه ثلاثا ، وذراعيه ثلاثا ، ومسح علاى رأسه حتى رأيت الماء يقطر ، وغسل رجليه ثلاثا ، ثم قال : هاكذا كان وضوء رسول الله ) . ( حم ، د ، وسمويه ، ض ) . )(@)(@@)(@@)(@@) $ 7099 عن أبي النضر :(@)(@@) | 30 ( أن عثمان رضي الله عنه دعا بوضوء وعنده طلحة والزبير وعلي وسعد رضي الله عنهم ، ثم توضأ وهم ينظرون ، فغسل وجهه ثلاث مرات ، ثم أفرغ علاى يمينه ثلاث مرات ، ثم أفرغ علاى يساره ثلاث مرات ، ثم رش علاى رجله اليمنى ثم غسلها ثلاث مرات ، ثم رش علاى رجله اليسرى ثم غسلها ثلاث مرات ، ثم قال للذين حضروا : أنشدكم الله أتعلمون أن رسول الله كان يتوضأ كما توضأت الآن ؟ قالوا : نعم ، وذالك لشيء بلغه عن وضوء رجال ) . ( ابن منيع والحارث ، ع ، قال البوصيري : ورجاله ثقات إلا أنه منقطع أبو النضر سالم لم يسمعهم عن عثمان ) . )(@)(@@)(@@)(@@) $ 7100 عن عبد الرحمان قال :(@)(@@) | 30 ( رأيت عليا رضي الله عنه توضأ فغسلع وجهه ثلاثا ، وغسل ذراعيه ثلاثا ، ومسح برأسه واحدة ، ثم قال : هاكذا توضأ رسول الله ) . ( د ، ص ) . )(@)(@@) PageV16P078(@)(@@)(@@)(@@) $ 7101 عن أبي الغريف قال :(@)(@@) | 30 ( أتي علي رضي الله عنه بالوضوء فمضمض واستنشق ثلاثا ، ثم غسل وجهه ثلاثا ، وغسل يديه وذراعيه ثلاثا ، ثم مسح برأسه ، وغسل رجليه ، ثم قال : هاكذا رأيت رسول الله توضأ ، ثم قرأ شيئا من القرآن ، ثم قال : هاكذا لمن ليس بجنب ، فأما الجنب فلا ولا 
ms5312	 آية ) . ( حم ، ع ) . )(@)(@@)(@@)(@@) $ 7102 عن إبراهيم عن أبي هريرة :(@)(@@) | 30 ( أنه كان يبدأ بميامنه في الوضوء فبلغ ذالك عليا رضي الله عنه ، فدعا بماء فتوضأ فبدأ بمياسره ) . ( ص ) . )(@)(@@)(@@)(@@) $ 7103 عن الحارث :(@)(@@) | 30 ( أن عليا رضي الله عنه توضأ ، ثم قام فشرب فضل وضوئه قائما ، ثم قال : إني رأيت رسول الله يتوضأ ، ثم شرب فضل وضوئه قائما ) . ( ص وابن جرير ) . )(@)(@@)(@@)(@@) $ 7104 عن عبد خير قال :(@)(@@) | 30 ( سمعت عليا رضي الله عنه يذكر وضوء رسول الله فأمر الغلام فصب الماء علاى كفه ثلاث مرات ، ثم أدخل يده في الركوة فمضمض واستنشق ، ثم غسل وجهه ثلاثا ، وذراعيه إلاى المرفقين ثلاثا ثلاثا ، ثم أدخل يده في الركوة في أسفلها ، فمسح بطن كفه بأسفل الركوة ، ثم مسح بها يده الاخرى ، ثم مسح رأسه مرة واحدة ، ثم غسل رجليه إلاى الكعبين ثلاثا ثلاثا ، ثم اغترف بيده غرفة فشربها ، ثم قال : هاكذا كان رسول الله يتوضأ ) . ( ص ) . )(@)(@@)(@@)(@@) $ 7105 عن الحسن بن محمد بن علي قال :(@)(@@) | 30 ( كان علي بن أبي طالب رضي الله عنه إذا توضأ خلل لحيته ) . ( ص ) . )(@)(@@)(@@)(@@) $ 7106 عن إبراهيم قال :(@)(@@) | 30 ( كان علي رضي الله عنه إذا حضرت الصلاة دعا بماء ، فأخذ كفا من ماء فتمضمض منه واستنشق منه ، ومسح بفضله وجهه وذراعيه ورأسه ورجليه ، ثم قال : هاذا وضوء من لم يحدث ) . ( ص ) . )(@)(@@)(@@)(@@) $ 7107 عن علي رضي الله عنه قال :(@)(@@) | 30 ( وضأت رسول الله فنضح عانته PageV16P079 ثلاث مرات ) . ( أبو بكر وسنده ضعيف ) . )(@)(@@)(@@)(@@) $ 7108 عن علي رضي الله عنه :(@)(@@) | 30 ( أن رسول الله مسح علاى رأسه ثلاث مرات ) . ( أبو بكر رضي الله عنه ) . )(@)(@@)(@@)(@@) $ 7109 عن علي رضي الله عنه قال :(@)(@@) | 30 ( رأيت رسول الله توضأ ثلاثا ثلاثا ، ثم أخذ كفا من ماء فوضعه علاى رأسه ، فرأيت الماء ينحدر علاى وجهه ) . ( المخلص وسنده حسن ) . )(@)(@@)(@@)(@@) $ 7110 عن علي رضي الله عنه(@)(@@) | 30 أنه كان إذا توضأ سكب الماء علاى لحيته سكبا من فوقها ) . ( عب ) . )(@)(@@)(@@)(@@) $ 7111 عن علي رضي الله عنه :(@)(@@) | 30 ( أنه كان يتوضأ لكل صلاة ) . ( عب 
ms5313	 ) . )(@)(@@)(@@)(@@) $ 7112 عن علي رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : الطهور ثلاثا واجب ، ومسح الرأس واحدة ) . ( الديلمي ) . )(@)(@@)(@@)(@@) $ 7113 عن ابن عباس رضي الله عنهما قال :(@)(@@) | 30 ( دخل علي رضي الله عنه علاى بيتي ، فدعا بوضوء فقال : يا ابن عباس ألا أتوضأ لك وضوء رسول الله ؟ قلت : بلاى ، فوضع له إناء فغسل يديه ، ثم مضمض واستنشق واستنثر ، ثم أخذ بيديه فصك بهما وجهه ، وألقم إبهاميه ما أقبل من أذنيه ، وعاد في مثل ذالك ثلاثا ، ثم أخذ كفا من ماء بيده اليمنى فأفرغها علاى ناصيته ، ثم أرسلها تسيل علاى وجهه ، ثم غسل يده اليمنى إلاى المرفق ثلاثا ، ثم يده الاخرى مثل ذالك ، ثم مسح برأسه وأذنيه من ظهورهما ، ثم أخذ بكفيه من الماء فصك بهما علاى قدميه وفيهما النعل ، ثم قلبها بها ، ثم علاى الرجل الاخرى مثل ذالك ، قال : فقلت وفي النعلين ؟ قال : وفي النعلين ، قلت : وفي النعلين ؟ قال : وفي النعلين ، قلت : وفي النعلين ؟ قال : وفي النعلين ) . ( حم ، د ، ع ، وابن خزيمة والطحاوي حب ، ض ) . )(@)(@@) PageV16P080(@)(@@)(@@)(@@) $ 7114 عن عبد خير قال :(@)(@@) | 30 ( أتي علي رضي الله عنه بإناء فيه ماء وطست ، فأخذ بيمينه الاناء فأكفاه علاى يده اليسرى ، ثم غسل كفيه ، ثم أخذ بيده اليمنى الاناء فأفاض علاى يده اليسرى ، ثم غسل كفيه ، فعله ثلاث مرات ، كل ذالك لا يدخل يده في الاناء ، حتى غسلها ثلاث مرات ، ثم أدخل يده اليمنى في الإناء فمضمض واستنشق ، ونثره بيده اليسرى ، فعل ذالك ثلاث مرات ، ثم أدخل يده اليمنى في الاناء فغسل وجهه ثلاث مرات ثم غسل يده اليمنى ثلاث مرات إلاى المرفق ، ثم غسل يده اليسرى ثلاث مرات إلاى المرفق ، ثم أدخل يده اليمنى حتى أغمرها الماء ، ثم رفعها بما حملت من ماء ، ثم مسحها بيده اليسرى ، ثم مسح رأسه بيديه كلتيهما مرة ، ثم صب بيده اليمنى ثلاث مرات علاى قدمه اليمنى ، ثم غسلها بيده اليسرى ثلاث مرات ، ثم أدخل يده اليمنى فغرف بكفه فشرب ، ثم قال : هاذا طهور نبي الله ، من أحب أن 
ms5314	 ينظر إلاى طهور نبي الله فهاذا طهوره ) . ( ط ، حم ، صحيح وابن منيع والدارمي د ، ن ، وابن خزيمة ، ع ، وابن الجارود ، حب ، قط ، ض ) . )(@)(@@)(@@)(@@) $ 7115 عن عبد خير عن علي رضي الله عنه :(@)(@@) | 30 ( أنه توضأ فغسل يديه ثلاثا ، ومضمض واستنشق ثلاثا ، وغسل وجهه ثلاثا ، وذراعيه ثلاثا ، ومسح برأسه ثلاثا ، وغسل رجليه ثلاثا ، ثم قال : من أحب أن ينظر إلاى وضوء رسول الله كاملا فلينظر إلاى هاذا ) . ( الدارمي ، قط ، وقال : هاكذا رواه أبو حنيفة عن خالد بن علقمة فقال فيه : ومسح رأسه ثلاثا ، وخالفه جماعة من الحفاظ الثقات ، منهم زائدة بن قدامة ، وسفيان الثوري وشعبة وأبو عوانة وشريك وأبو الأشهب جعفر بن الحارث وهارون بن سعد وجعفر بن محمد وحجاج بن أرطأة وأبان بن تغلب وعلي بن صالح بن حي وحازم بن إبراهيم وحسن بن صالح وجعفر الأحمر ، فرووه عن خالد بن علقمة فقالوا فيه : ومسح رأسه مرة ، ولا نعلم أحدا منهم قال في حديثه : إنه PageV16P081 مسح رأسه ثلاثا غير أبي حنيفة انتهى ) . )(@)(@@)(@@)(@@) $ 7116 عن علي رضي الله عنه :(@)(@@) | 30 ( أن رسول الله توضأ ثلاثا ثلاثا ، وأخذ لرأسه ماء جديدا ) . ( عم ، قط ) . )(@)(@@)(@@)(@@) $ 7117 عن علي رضي الله عنه :(@)(@@) | 30 ( أنه توضأ ثلاثا ثلاثا ، ومسح برأسه وأذنيه ثلاثا وقال : هاكذا وضوء رسول الله أحببت أن أريكموه ) . ( قط ) . )(@)(@@)(@@)(@@) $ 7118 عن أبي عبد الرحمان السلمي قال :(@)(@@) | 30 ( أمر علي رضي الله عنه بالسواك وقال : قال رسول الله : إن العبد إذا تسوك ، ثم قام يصلي ، قام الملك خلفه يستمع القرآن ، فلا يزال عجبه بالقرآن يدنيه منه حتى يضع فاه علاى فيه ، فما يخرج من فيه شيء من القرآن إلا صار في جوف الملك ، فطهروا أفواهكم ) . ( ابن المبارك ) . )(@)(@@)(@@)(@@) $ 7119 عن علي رضي الله عنه قال :(@)(@@) | 30 ( سمعت رسول الله يقول : لولا أن أشق علاى أمتي لأمرتهم بالسواك عند كل صلاة ، ولأخرت العشاء إلاى ثلث الليل الأول ، فإنه إذا مضى ثلث الليل الأول هبط الله إلاى سماء الدنيا ، فلم يزل هنالك حتى يطلع الفجر ، فيقول : ألا سائل 
ms5315	 يعطى سؤله ؟ ألا داع يجاب ؟ ألا سقيم يستشفي ؟ ألا مذنب يستغفر فيغفر له ) . ( عثمان بن سعيد الدارمي في الرد علاى الجهمية ، قط ، في أحاديث النزول ) . )(@)(@@)(@@)(@@) $ 7120 عن أبي عبد الرحمان السلمي عن علي رضي الله عنه قال :(@)(@@) | 30 ( أمرنا بالسواك ، وقال : إن العبد إذا قام يصلي أتاه الملك فقام خلفه فيستمع القرآن ويدنو ، فلا يزال يسمع ويدنو ، حتى يضع فاه علاى فيه ، فلا يقرأ آية إلا وقعت في جوف الملك فطيبوا ما هنالك ) . ( ابن المبارك في الزهد والاخرى في أخلاق حملة القرآن عب ، هب ) . )(@)(@@) PageV16P082(@)(@@)(@@)(@@) $ 7121 عن علي رضي الله عنه :(@)(@@) | 30 ( أنه كان إذا فرغ من وضوئه قال : أشهد أن لا إلاه إلا الله وأشهد أن محمدا عبده ورسوله ، رب اجعلني من التوابين واجعلني من المتطهرين ) . ( ش ) . )(@)(@@)(@@)(@@) $ 7122 عن علي رضي الله عنه قال :(@)(@@) | 30 ( لا يضرك بأي يديك بدأت ، ولا بأي رجليك بدأت ، ولا علاى أي جانبك انصرفت ) . ( عب ) . )(@)(@@)(@@)(@@) $ 7123 عن عبد خير قال :(@)(@@) | 30 ( رأيت عليا رضي الله عنه دعا بالماء ليتوضأ ، فمسح يديه مسحا ، ومسح علاى قدميه وقال : هاذا وضوء من لم يحدث ، ثم قال : لولا أني رأيت رسول الله مسح علاى ظهر قدميه رأيت أن بطونهما أحق ، ثم شرب فضل وضوئه وهو قائم ، ثم قال : أين الذين يزعمون أنه لا ينبغي لأحد أن يشرب قائما ) . ( حم ) . )(@)(@@)(@@)(@@) $ 7124 عن النزال بن سبرة قال :(@)(@@) | 30 ( أتي علي رضي الله عنه بكوز من ماء وهو بالرحبة ، فأخذ كفا من ماء وتمضمض واستنشق ، ومسح وجهه وذراعيه ورجليه ، ثم شرب فضل الماء وهو قائم ، ثم قال : هاذا وضوء من لم يحدث ، هاكذا رأيت رسول الله فعل ) . ( ط ، حم ، خ ، د ، ت في الشمائل ، ن ، ع ، وابن جرير وابن خزيمة والطحاوي ق ) . )(@)(@@)(@@)(@@) $ 7125 عن الحارث :(@)(@@) | 30 ( أن عليا رضي الله عنه دعا بالوضوء فتوضأ ، ثم قام فشرب فضل وضوئه ، ثم قال : هاكذا رأيت رسول الله فعل حين جاءه الأعرابي يسأله ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 7126 عن علي رضي الله عنه قال :(@)(@@) | 30 ( سألت النبي 
ms5316	 عن المذي فقال : فيه الوضوء ، وفي المني الغسل ) . ( ص ، ش ، ت وقال : حسن صحيح ، ع ، والطحاوي ، ص ) . )(@)(@@) PageV16P083(@)(@@)(@@)(@@) $ 7127 عن علي رضي الله عنه قال :(@)(@@) | 30 ( كنت أجد مذيا ، فأمرت المقداد أن يسأل النبي عن ذالك لأن ابنته عندي ، فاستحييت أن أسأله لأن ابنته تحتي ، فسأله فقال : إن كل فحل يمذي ، فإذا كان المني ففيه الغسل ، وإذا كان المذي ففيه الوضوء ) . ( ش ، ص ) . )(@)(@@)(@@)(@@) $ 7128 عن علي رضي الله عنه قال :(@)(@@) | 30 ( كنت رجلا مذاء ، وكان تحتي بنت رسول الله ، فكنت أستحيي أن أسأله ، فأمرت رجلا ، فقال : إذا رأيت المذي فتوضأ واغسل ذكرك ، وإذا رأيت فضخ الماء فاغتسل ) . ( ط ، ش ، د ، ن ، وابن خزيمة حب ، والدورقي ص ) . )(@)(@@)(@@)(@@) $ 7129 عن علي رضي الله عنه قال :(@)(@@) | 30 ( كنت رجلا مذاء ، فكنت إذا رأيت شيئا من ذالك اغتسلت فبلغ ذالك النبي فأمرني أن أتوضأ ) . ( ش ) . )(@)(@@)(@@)(@@) $ 7130 عن علي رضي الله عنه قال :(@)(@@) | 30 ( كنت رجلا مذاء ، فكنت أستحيي أن أسأل رسول الله لمكان ابنته ، فأمرت المقداد ابن الأسود فسأله فقال : يغسل ذكره ويتوضأ ) . ( ط ، حم ، خ ، م ، ن ، وابن جرير وابن خزيمة والطحاوي والدورقي ، ق ) . )(@)(@@)(@@)(@@) $ 7131 عن علي رضي الله عنه قال :(@)(@@) | 30 ( جاء أعرابي إلاى النبي فقال : يا رسول الله إنا نكون بالبادية فيخرج من أحدنا الرويحة ؟ فقال رسول الله : إن الله لا يستحيي من الحق ، إذا فسا أحدكم فليتوضأ ، ولا تأتوا النساء في أعجازهن ، وقال مرة ، في أدبارهن ) . ( حم ، والعدني ورجاله ثقات ) . )(@)(@@)(@@)(@@) $ 7132 عن علي رضي الله عنه قال :(@)(@@) | 30 ( كنت غلاما مذاء ، فلما رأى رسول الله الماء قد آذاني ، قال : إنما الغسل من الماء الدافق ) . ( ق ) . )(@)(@@)(@@)(@@) $ 7133 عن علي رضي الله عنه قال :(@)(@@) | 30 ( كنت أجد من المذي شدة ، فأردا أن PageV16P084 أسأل رسول الله وكانت ابنته عندي ، فاستحييت أن أسأله ، فأمرت عمار بن ياسر فسأله ، فقال : إنما يكفي منه الوضوء ) . ( الحميدي والعدني ن ، والطحاوي ، عق ) . )(@)(@@)(@@)(@@) $ 7134 عن عروة :(@)(@@) | 30 ( أن علي بن أبي طالب رضي الله عنه قال للمقداد : سل رسول الله 
ms5317	 عن المذي ، فسأله المقداد ، فقال رسول الله : ليغسل ذكره وانثييه ويتوضأ وضوءه للصلاة ) . ( د ، ن ، ق ) . )(@)(@@)(@@)(@@) $ 7135 عن علي رضي الله عنه قال :(@)(@@) | 30 ( قلت للمقداد : سل رسول الله ، فإني لولا أن تحتي ابنته سألته عن أحدنا إذا اقترب من امرأته فأمذى ولم يملك ذالك ولم يمسها ؟ فسأل المقداد رسول الله ، فقال رسول الله : إذا أمذى أحدكم ولم يمسها فليغسل ذكره وأنثييه ، ثم ليتوضأ وليصل ) . ( عب ، طب ، وابن النجار ) . )(@)(@@)(@@)(@@) $ 7136 عن ابن عباس عن علي رضي الله عنهما قال :(@)(@@) | 30 ( كنت رجلا مذاء ، فكنت أكثر منه الاغتسال ، فسألت النبي فقال : يكفيك منه الوضوء ) . ( ابن النجار ) . )(@)(@@)(@@)(@@) $ 7137 عن علي رضي الله عنه :(@)(@@) | 30 ( أنه قال للمقداد : سل لي رسول الله عن الرجل يلاعب امرأته ويكلمها فيكون منه المذي ، فإنه لولا ابنته تحتي لسألته ، فسأله المقداد ، فقال : يغسل ذكره وأنثييه ، ثم لينضح فرجه ) . ( عق ، والطحاوي ) . )(@)(@@)(@@)(@@) $ 7138 عن عابس بن أنس أحد بني سعد بن ليث قال :(@)(@@) | 30 ( تذاكر علي بن أبي طالب وعمار بن ياسر والمقداد بن الأسود رضي الله عنهم المذي ، فقال علي : إني رجل مذاء ، فاسألوا عن ذالك رسول الله فإني أستحيي أن أسأله عن ذالك لمكان PageV16P085 ابنته مني ، فسأله أحد الرجلين ، فقال النبي : ذاكم المذي ، إذا وجده أحد منكم ، فليغسل ذالك منه ، ثم ليتوضأ فيحسن وضوءه ثم لينضح فرجه ) . ( عق ) . )(@)(@@)(@@)(@@) $ 7139 عن قيس بن السكن :(@)(@@) | 30 ( أن عليا وابن مسعود وحذيفة بن اليمان وأبا هريرة رضي الله عنهم لا يرون من مس الذكر وضوءا وقالوا : لا بأس به ) . ( عب ) . )(@)(@@)(@@)(@@) $ 7140 عن ابن عمرو الشيباني :(@)(@@) | 30 ( أن عليا رضي الله عنه استتاب المستورد العجلي وهو يريد الصلاة ، قال : إني أستعين بالله عليك ، فقال : إني أستعين بالمسيح عليك ، فأهوى علي بيده إلاى عنقه ، فإذا هو بصليب فقطعه ، فلما دخل في الصلاة قدم رجلا وذهب ، ثم أخبر الناس أنه لم يحدث ذالك لحدث أحدثه ، ولاكن من هاذه الأنجاس ، فأحب أن يحدث منها وضوءا ) . ( عب ) . )(@)(@@)(@@)(@@) $ 7141 عن عبد الكريم بن أبي أمية :(@)(@@) | 30 
ms5318	 ( أن عليا رضي الله عنه كان لا يتوضأ مما مست النار ) . ( عب ) وأخرجه جعفر بن محمد . )(@)(@@)(@@)(@@) $ 7142 عن حبان بن الحارث قال :(@)(@@) | 30 ( أتينا عليا رضي الله عنه وهو بعسكر أبي موسى فوجدته يطعم ، فقال : ادن فكل ، فقلت : إني أريد الصلاة ، فقال : وأنا أريد الصلاة ، فأكل حتى إذا فرغ ، قال لمؤذنه ابن التياح : أقم ) . ( الشافعي ومسدد والدورقي ق ) . )(@)(@@)(@@)(@@) $ 7143 عن علي رضي الله عنه قال :(@)(@@) | 30 ( كان رسول الله يأكل الثريد ، ويشرب اللبن ، ويصلي ولا يتوضأ ) . ( ع ، وابن جرير ص ) . )(@)(@@)(@@)(@@) $ 7144 عن علي رضي الله عنه قال :(@)(@@) | 30 ( ما أبالي أمسست ذكري أو طرف أذني ) . ( ص ) . )(@)(@@)(@@)(@@) $ 7145 عن الأصبغ بن نباتة قال :(@)(@@) | 30 ( كان علي رضي الله عنه إذا دخل الخلاء PageV16P086 قال : بسم الله الحافظ المؤذي ، وإذا خرج مسح بيديه بطنه وقال : يا لها نعمة لو يعلم الناس شكرها ) . ( ابن أبي الدنيا في الشكر ، هب ) . )(@)(@@)(@@)(@@) $ 7146 عن جعفر بن محمد عن آبائه عن علي رضي الله عنه قال :(@)(@@) | 30 ( خرج النبي للبراز ، فأخذت الركوة فخرجت في إثره ) . ( السلمي في الأربعين ) . )(@)(@@)(@@)(@@) $ 7147 عن أبي ظبيان قال :(@)(@@) | 30 ( رأيت عليا رضي الله عنه وعليه إزار أصفر وخميصة ، وفي يده عنزة ، أتى حائط السجن فبال قائما حتى رغا بوله ، ثم تنحى فتوضأ ثلاثا ، ومسح علاى نعليه وقدميه ، ثم أخذ كفا من ماء فصبه علاى صلعته ، فرأيت الماء متحادرا علاى منكبيه ، ثم دخل المسجد فخلع نعليه ثم صلى ) . ( ص ) . )(@)(@@)(@@)(@@) $ 7148 عن ابن سيرين قال :(@)(@@) | 30 ( خرج علي رضي الله عنه من الخلاء فشرب ماء قبل أن يتوضأ وقال : أطهر بطني أولا ) . ( ص ) . )(@)(@@)(@@)(@@) $ 7149 عن أبي ظبيان قال : $ 30 ( رأيت عليا رضي الله عنه بال وهو قائم ، ثم دعا بماء فتوضأ ومسح علاى خفيه ، ثم دخل المسجد فصلى ) . ( عب ومسدد والطحاوي ، ش ) .(@)(@@)(@@)(@@) $ 7150 عن النخعي :(@)(@@) | 30 ( أن عليا رضي الله عنه بال ثم توضأ فقام يصلي ، وما مس ذكره ) . ( عب ، هب ) . )(@)(@@)(@@)(@@) $ 7151 عن عبد الملك بن عمير قال : $ 30 ( قال علي رضي الله عنه إن 
ms5319	 من كان قبلكم كانوا يبعرون بعرا ، وأنتم تثلطون ثلطا ، فأتبعوا الحجارة بالماء ) . ( عب ، ص ) .(@)(@@)(@@)(@@) $ 7152 عن عبد الله بن محمد بن عمر بن علي عن أبيه عن جده عن علي بن أبي طالب رضي الله عنه قال :(@)(@@) | 30 ( مر رسول الله بقبرين يعذبان ، فقال : إنهما PageV16P087 يعذبان وما يعذبان في كبير أما أحدهما : فكان لا يتنزه عن بوله ، وأما الآخر : فكان يمشي بالنميمة ) . ( ك ) . )(@)(@@)(@@)(@@) $ 7153 حدثنا الحسن بن عمارة عن المنهال أبي عمرو صعصعة بن صوحان العبدي عن علي بن أبي طالب رضي الله عنه قال :(@)(@@) | 30 ( نهى رسول الله أن ينتفع من الخنزير بشيء ) . ( أبو عروبة الحراني في مسند القاضي أبي يوسف ) . )(@)(@@)(@@)(@@) $ 7154 عن علي رضي الله عنه :(@)(@@) | 30 ( أن النبي قال في بول الرضيع : ينضح بول الغلام ، ويغسل بول الجارية ) . ( حم ، خ ، د ، ت ، وقال : حسن ، ه ، وابن خزيمة والطحاوي قط ، ك ، ق ) . )(@)(@@)(@@)(@@) $ 7155 عن علي رضي الله عنه قال :(@)(@@) | 30 ( يغسل بول الجارية ، وينضح بول الغلام ما لم يطعم ) . ( د ، ق ) . )(@)(@@)(@@)(@@) $ 7156 عن علي رضي الله عنه قال :(@)(@@) | 30 ( إذا وقعت الفأره في السمن وهو جامد فماتت ، فخذها وما حولها من السمن فألقه وكل السمن ، وإذا وقعت في السمن وهو ذائب فخذوها وألقوها وانتفعوا بالسمن ولا تأكلوه ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 7157 عن علي رضي الله عنه في الرجل يخرج منه الشيء بعد الغسل ؟ قال :(@)(@@) | 30 ( إن كان بال قبل الغسل توضأ ، وإن لم يكن بال أعاد الغسل ) . ( ص ) . )(@)(@@)(@@)(@@) $ 7158 عن علي رضي الله عنه قال :(@)(@@) | 30 ( ما أوجب الحد أوجب الغسل ) . ( ص ) . )(@)(@@)(@@)(@@) $ 7159 عن علي رضي الله عنه قال :(@)(@@) | 30 ( إذا اختلف الختانان فقد وجب الغسل ) . ( عق ) . )(@)(@@)(@@)(@@) $ 7160 عن علي رضي الله عنه قال :(@)(@@) | 30 ( رآني النبي وقد شحبت ، فقال : يا علي لقد شحبت ، فقلت : شحبت من اغتسالي بالماء وأنا رجل مذاء ، فإذا رأيت PageV16P088 منه شيئا اغتسلت منه ، قال : لا تغتسل منه إلا من الخوف ، فإن رأيت شيئا منه فلا تعد أن تغسل ذكرك ، ولا تغتسل إلا من الخذف 
ms5320	 ) . ( ابن السني ) . )(@)(@@)(@@)(@@) $ 7161 عن خرشة بنت حبيب أن رجلا قال لعلي رضي الله عنه :(@)(@@) | 30 ( الرجل يأتي امرأته ولا ينزل ؟ قال : لو هزها حتى تهتز قرناها فليس عليه غسل ) . ( مسدد ) . )(@)(@@)(@@)(@@) $ 7162 عن علي رضي الله عنه قال في التقاء الختانين :(@)(@@) | 30 ( كما يجب الحد كذالك يجب الغسل ، أيوجب الحد ولا يوجب قدحا من ماء ) . ( طب ، هب ) . )(@)(@@)(@@)(@@) $ 7163 عن مجاهد قال :(@)(@@) | 30 ( اختلف المهاجرون والأنصار فيما يوجب الغسل ، فقالت الأنصار : الماء من الماء ، وقالت المهاجرون : إذا مس الختان الختان وجب الغسل ، فحكموا بينهم علي بن أبي طالب رضي الله عنه فاختصموا إليه ، فقال علي : أرأيتم ؟ لو رأيتم رجلا يدخل ويخرج ، أيجب عليه الحد ؟ قالوا : نعم ، قال : فيوجب الحد ، ولا يوجب الغسل صاعا من ماء ، فقضى للمهاجرين ، فبلغ ذالك عائشة ، فقالت : ربما فعلنا ذالك أنا ورسول الله فقمنا واغتسلنا ) . ( عب ) . )(@)(@@)(@@)(@@) $ 7164 عن علي رضي الله عنه قال :(@)(@@) | 30 ( جاء رجل إلاى النبي فقال : إني اغتسلت من الجنابة وصليت الفجر ، ثم أصبحت فرأيت قدر موضع الظفر لم يصبه الماء ، فقال رسول الله : لو كنت مسحت عليه بيدك أجزأك ) . ( ه ، والشاشي ، ص ) . )(@)(@@)(@@)(@@) $ 7165 عن علي رضي الله عنه قال :(@)(@@) | 30 ( من غسل رأسه بغسل وهو جنب فقد أبلغ ، ثم يغسل سائر جسده بعد ) . ( عب ، ص ) . )(@)(@@)(@@)(@@) $ 7166 عن علي رضي الله عنه قال :(@)(@@) | 30 ( كان رسول الله يغتسل هو وأهله من إناء واحد ، ولا يغتسل أحدهما بفضل صاحبه ) . ( ش ، حم ، والدورقي ) . )(@)(@@) PageV16P089(@)(@@)(@@)(@@) $ 7167 عن عامر بن ربيعة قال :(@)(@@) | 30 ( أتى علينا علي رضي الله عنه ونحن نغتسل يصب بعضنا علاى بعض فقال : أتغتسلون ولا تستترون ؟ والله إني لأخشى أن تكونوا أخلف الشر ) . ( عب ) . )(@)(@@)(@@)(@@) $ 7168 عن سرية علي بن أبي طالب رضي الله عنه قالت :(@)(@@) | 30 ( اغتسلت فأقعدت فلم أستطع أن أقوم ، فأخبر بذالك علي بن أبي طالب ، فجاء فوضع يده علاى رأسي ( فلم تزل يده علاى رأسي ) يدعو حتى قمت ، فقال : لا تغتسلي في الحش ، ولا في مكان يبال فيه ، ولا في قمر ) . ( الدينوري ، كر ) . )(@)(@@)(@@)(@@) $ 7169 