ms321	 على لسانك يسمع % % ن الصفا الصلد والفتى الموقورا % % 80(@)(@@) % فعلام استردك الدهر مني % % مكرها بعد خبرتي مقسورا % % PageV01P968 81(@)(@@) % نعمة نفرت ما كنت يوما % بالعطاء الهني منها كفورا % % 82(@)(@@) % وعذاري من القوافي تعوضت % بهن التعليل والتعذيرا % % 83(@)(@@) % لم يكن حجها وقد جهدت في % % ه إلى كعبة العلا مبرورا % % 84(@)(@@) % ألظن وربما كان إثما % كنت لو قد عصيته مأجورا % % 85(@)(@@) % لم تدنس عرضا ولم تؤت بالذن % % ب اعتمادا فيه ولا تقصيرا % % 86(@)(@@) % لم تكن صدقت بأول مدح % ضاق ملك عن وقته فاستعيرا % % 87(@)(@@) % لمتموني فيه ورب ملوم % كان في غيب أمره معذورا % % 88(@)(@@) % هو شعري وفيك قيل ابتداء % جاء أو كان راجعا مكرورا % % 89(@)(@@) % ولعمرو الواشي لقد كان ذنبا % هينا لو وهبتموه يسيرا % % 90(@)(@@) % واعترافي بالهفوة الآن يمحو % % من خبايا الصدور تلك الوغورا % % PageV01P969 91(@)(@@) % والقوافي عني عبيد منيبا % % ت فكن لي بالصفح ربا غفورا % % 92(@)(@@) % لك أبرزن بعد أن رد عنه % % ن بعول أسنوا إلي المهورا % % 93(@)(@@) % وأرى النزر من ودادك أو رف % % دك حظا في مهرهن خطيرا % % 94(@)(@@) % باقيات في الدهر ما بقى الده % % ر وناصى رضمى أخاه ثبيرا % % 95(@)(@@) % فاستمعها مختومة العذر أبكا % % را إلى اليوم ما برحن الخدورا % % 96(@)(@@) % تتلف المال لا تبالي إذا أح % % رزت في الأرض كنزها المذخورا % % 97(@)(@@) % وإذا ما وجدن عرضا بهيما % مدلهما طلعن فيه بدورا % % 98(@)(@@) % عوضا من عتابك المر حتى % % تشرب الشكر منك عذبا نميرا % % 99(@)(@@) % نعم ما تقتني مقيما وإن سا % % فرت كانت إلى النجاح سفيرا % % 100(@)(@@) % فاحتفظ قاطنا بها اسر مغبو % % طا على ملك مثلها محبورا % % PageV01P970 101(@)(@@) % وتزود منها على صحبة الل % % ه متاعا إذا عزمت المسيرا % % 102(@)(@@) % وكن القرم من ملوك بني مر % % وان لي أن أكون فيك جريرا % % PageV01P971 البحر : - 1(@)(@@) % طوى الليل راكب أخطاره % على شحط داري من داره % 2(@)(@@) % خيال وفى بضمان الهوى % % فجاء رسولا لغداره % 3(@)(@@) % سرى من ضنين لمعروفه % تعرض في لإنكاره % 4(@)(@@) % حبيب جبان بغير الوصال % شجاع بإهداء آثاره % 5(@)(@@) % طرقت بما زار من طيفه 
ms322	 % كأني طرقت بعطاره % 6(@)(@@) % تطلع يقصر ليل التمام % طلوع كواكب أسحاره % 7(@)(@@) % بأشنب يسمح للراشفين % بنهب ودائع خماره % 8(@)(@@) % إذا أسكرت دائرات الكئوس % صحا الشاربون بأدواره % 9(@)(@@) % أقام فوافى وجلى به % من الصبح أخبث أطياره % 10(@)(@@) % وبرق خشوعي من طيفه % وماء جفوني من ناره % PageV01P972 11(@)(@@) % تعرض لي شفق الأتحم % % ي تنزو الرياح بأشطاره % 12(@)(@@) % فطارحني من حديث العذيب % وفاكهني طيب أخباره % 13(@)(@@) % أراني مواقد نيرانه % بعيدا ومجلس سماره % 14(@)(@@) % وذكرني زمنا ما شربت % دموعي إلا لتذكاره % 15(@)(@@) % وليلا عدمت ضياء السرو % % ر منذ فجعت بأقماره % 16(@)(@@) % وهيفا غذاهن وادي النعيم % بجناته وبأنهاره % 17(@)(@@) % ملكن الهوى فأعرن القلو % % ب ما شئن منه سوى عاره % 18(@)(@@) % فهن ظواهر ما غاب منه % وهن بواطن أسراره % 19(@)(@@) % وأبله لا تجد العين في % % ه نهجا يقص بآثاره % 20(@)(@@) % يقل عليه انتفاع الدليل % بتجريبه وبتكراره % PageV01P973 21(@)(@@) % ندبت له يد طب الحساب % بأخماسه وبأعشاره % 22(@)(@@) % غني عن النجم أن يستدل % بواقعه وبطياره % 23(@)(@@) % ونبهت ذا رقدة حلوة % فقام لأمري وإمراره % 24(@)(@@) % يخال بخبرته بالفضا % % ء أعطى قسمة أقطاره % 25(@)(@@) % يداري إلى السوط جفنا خيوط ال % % كرى ممسكات لأشفاره % 26(@)(@@) % فملنا إلى جنح ليل يضيع % بياض الكواكب في قاره % 27(@)(@@) % لعز تركنا غراما به % سروج الطريق لأكواره % 28(@)(@@) % وأحرى به أن يجلى دجاه % بوجه الوزير وإسفاره % 29(@)(@@) % وأن يضع السير أثقاله % إذا رفعت حجب أستاره % 30(@)(@@) % إذا شرف الدين حطت به % قدرنا سراها بمقداره % PageV01P974 31(@)(@@) % فطاب المقام لقطانه % وقر المطي بسفاره % 32(@)(@@) % اليك افتضضنا عذارى ال % % سهوب بعون الرجاء وأبكاره % 33(@)(@@) % إلى خير من حل شوقا إليه % ركاب المطي لأسياره % 34(@)(@@) % فحرمها أن تشم الهوان % فتى لا يجار على جاره % 35(@)(@@) % كريم يعدك أغنيته % إذا أنت جئت لإفقاره % 36(@)(@@) % كأنك أول أحبابه % إذا كنت آخر زواره % 37(@)(@@) % دع الناس واعكف على بيته % فدر الندى تحت أحجاره % 38(@)(@@) % رواق ترى المجد في صدره % ورزقك ما بين أكساره % 39(@)(@@) % وهب عشب الأرض للرائدين % % إذا ما وليت بأقطاره % 40(@)(@@) % حمى الله 
ms323	 أبلج بدر التما % % م يطلع ما بين أزراره % PageV01P975 41(@)(@@) % وحيا على رغم زهر النجو % % م وجها يعم بأنواره % 42(@)(@@) % وأعدى أعاديه من ماله % إذا جاد قلة أعماره % 43(@)(@@) % همام ظواهر أسد الشرى % % تلاوذ في الغاب من زاره % 44(@)(@@) % يهيب بها بعد إصحاره % وترهبه قبل إصحاره % 45(@)(@@) % حليم السطا ينزل الذنب منه % بواهبه وبغفاره % 46(@)(@@) % تنام على الفرطات العظا % % م عيناه إلا على ثاره % 47(@)(@@) % نهيت عدوك لو أنه % بوعظي تارك إصراره % 48(@)(@@) % وقلت حذارك لا تغترر % بصل الحماطة في غاره % 49(@)(@@) % فبعد سكينة مجموعه % تسوءك وثبة ثواره % 50(@)(@@) % فلم ينتصحني ولم يعنني % % وقد حان كثرة إنذاره % PageV01P976 51(@)(@@) % ومر يجاري على الإغترا % % ر من ليس من خيل مضماره % 52(@)(@@) % أراد ليغمز صم القنا % % بجوف اليراع وخواره % 53(@)(@@) % وشاور في البغى شيطانه % فأطغته طاعة أماره % 54(@)(@@) % وعارض معجز آياتكم % بكذابه وبسحاره % 55(@)(@@) % توغل يدرس آثاركم % فأنغض من دون آثاره % 56(@)(@@) % ومد ليحمل ما تحملون % صليفا ضعيفا بأوقاره % 57(@)(@@) % وكان يلام فلما لجا % % إلى العجز قام بأعذاره % 58(@)(@@) % ألم يكفه غدر كراته % به وتقلب أطواره % 59(@)(@@) % وتجريبه معكم نفسه % فينهى اللجاج بإقصاره % 60(@)(@@) % ولما انتصرت بكافي المهم % أحس بخذلان أنصاره % PageV01P977 61(@)(@@) % ظفرت وها هو تحت الإسا % % ر يأكل زائد أظفاره % 62(@)(@@) % تعفى الخطايا بإقلاعه % وتمحو الذنوب بإقراره % 63(@)(@@) % رضيت بقلك حتى تعز % ويرضى الهوان بإكثاره % 64(@)(@@) % فقنطار مالك دون الأذى % % ومهجته قبل ديناره % 65(@)(@@) % تجلت بسعدك غماؤها % % فتوق الصباح بإسفاره % 66(@)(@@) % وغرم الذي فات في ذمةال % % قضاء وسابق أقداره % 67(@)(@@) % وقد جنب الدهر من نفعه % منائح في حبل إصراره % 68(@)(@@) % سيأتي تنصله آنفا % % فيسفر في حظ أوزاره % 69(@)(@@) % ودون جنا النحل وخازة % تشق على يد مشتاره % 70(@)(@@) % بقيت لملك إذا كنت فيه % فإثراؤه مع إصفاره % PageV01P978 71(@)(@@) % ويا رب بيت الندى لا أصي % % ب منك بسيد عماره % 72(@)(@@) % ودار بما شئت قطب النجو % % م تعطى سعادة أدواره % 73(@)(@@) % وزار جنابك هذا الربيع % بمنخرق الخلف دراره % 74(@)(@@) % تجارى سماحك أنواؤه % وخلقك زهرة أنواره % 75(@)(@@) % يؤديك 
ms324	 نيروزه سالما % % إلى صومه ثم إفطاره % 76(@)(@@) % وبقيت لي وزرا لا تدر % سحابي إلا بإعصاره % 77(@)(@@) % لمضطهد يسره ما اتسعت % وضيقك آية إعساره % 78(@)(@@) % رماني زماني بما نابكم % فأغرق في نزع أوتاره % 79(@)(@@) % وعمق يجرح ما لا تنا % % ل كف الطبيب بمسباره % 80(@)(@@) % فمن كلم قلبي وإحراقه % إلى فقر ربعي وإقفاره % PageV01P979 81(@)(@@) % فلا يعد منكم شريب لكم % على حلو دهر وإمراره % 82(@)(@@) % سليم الأديم على ودكم % إذا راب كثرة عواره % 83(@)(@@) % يمدكم ما استطاع الثناء % بقاطنه وبسياره % 84(@)(@@) % إذا لم يجد حبوة بالثراء % حباكم بصفوة أفكاره % 85(@)(@@) % فإن فاته بيد نصركم % أظلكم نصر أشعاره % PageV01P980 البحر : - 1(@)(@@) % ما ناشر ذو مخالي % % ب لم ينطن بظفره % 2(@)(@@) % يبغي فينشرمكرا % يطويه من بعد نشره % 3(@)(@@) % له مكايد شر % وخيره قبل شره % 4(@)(@@) % ينال بسط يديه % بضم ما تحت صدره % 5(@)(@@) % يعدو برق خبيث % لحله ولطهره % 6(@)(@@) % شطرين يمشي بشطر % وشطره فوق مهره % 7(@)(@@) % على أقب خفيف % محمل فوق وقره % 8(@)(@@) % طورا له هو ظهر % وتارة فوق ظهره % 9(@)(@@) % فيا لريان غض ال % % معاش مع طول ضره % PageV01P981 البحر : - 1(@)(@@) % وجارية بيضاء حمراء ربما % % تكون غدا سوداء إن شئت أو صفرا % % 2(@)(@@) % تعيش بخفض ما تمنت ونعمة % بحيث سواها لو يرى فارق العمرا % % 3(@)(@@) % سرت تقطع الخرق الوسيع وما مشت % ولا ركبت فيه سفينا ولا ظهرا % % 4(@)(@@) % مسربلة لم تدفع النبل درعها % % وعريانة لم تشك قيظا ولا قرا % % 5(@)(@@) % تطفل حتى زفها لك جاهرا % إذا صاعبته عد إعسارها يسرا % % 6(@)(@@) % وأعجبه مما يميز أنها % % إذا هي زادت كبرة زدته مهرا % % 7(@)(@@) % يحل له منها الحرام لمعشر % يكونون في جنس سوى جنسها بحرا % % PageV01P982 البحر : - 1(@)(@@) % أفاق بها من طول سكرته الدهر % وفكت أمان فيك ماطلها الأسر % 2(@)(@@) % وأسمحت الأيام بعد حرانها % % ونهنهها الوعظ المكرر والزجر % 3(@)(@@) % حملت تمادي غيها ولجاجها % % على غالب لم يدمه الندب والعقر % 4(@)(@@) % نهوض إذا خار الفقار نجت به % جوارح صم كلها في السرى ظهر % 5(@)(@@) % وأرعيتها الإهمال علما بأنها % % إليك وإن 
ms325	 طال التنازع تضطر % 6(@)(@@) % وما فات مطلوب سرى الجد خلفه % وضامنه العمر المؤخر والصبر % 7(@)(@@) % وقد كنت أستبطي القضاء وسعيه % وأعذله فيما ينوب وما يعرو % % 8(@)(@@) % ويقنطني مايستقيم ويلتوي % % ويقبل من أمر عليك ويزور % 9(@)(@@) % ولم أدر أن الله أخر آية % له بك في إظهار معجزها سر % 10(@)(@@) % وأنك مذخور لإحياء دولة % إذا هي ماتت كان في يدك النشر % PageV01P983 11(@)(@@) % تعاورها شل الغواة وطردهم % تساق على حكم الغوار وتجتر % 12(@)(@@) % لها جانب من خوفهم متسهل % وآخر يرجو أن تداركه وعر % 13(@)(@@) % مزعزعة أيدي سبا بين معشر % هم غمطوا النعمى وغمطهم كفر % 14(@)(@@) % ولم أر كالعبد الموسم آمنا % % يروع منه ربه الملك الحر % 15(@)(@@) % محافر أكدت في أكف تخاذلت % فكان عليها حثو ما فحص الحفر % 16(@)(@@) % ولما نبت بالملك دار قراره % ومال عليه منهم الفاجر الغر % 17(@)(@@) % وسرح من مكنونه الخوف حائما % عليه وأبدى من نواجذه الشر % 18(@)(@@) % وكوشف حتى لم تحصنه رقبة % ولم يبق باب للحياء ولا ستر % 19(@)(@@) % أتتك به الظلماء يركب ظهرها % % على ثقة من غيه أنك الفجر % 20(@)(@@) % يناديك قم هذا أوان انتهازها % % فشمر لها قد أمكن الخائض البحر % PageV01P984 21(@)(@@) % فما ضره خذل الذين وراءه % وقدامه منك الحمية والنصر % 22(@)(@@) % تلافيتها بالرأي شنعاء لم تجز % بظن ولم ينفق على مثلها فكر % 23(@)(@@) % دعاك لها يا واحد وهو واحد % فأصرخه من نصحك الحجفل المجر % 24(@)(@@) % وفي الناس من تسري له عزماته % بعيدا ولم يشكم حصان ولا مهر % 25(@)(@@) % وأعزل ما مد السلاح بنانه % تلاوذ من فتكاته البيض والسمر % 26(@)(@@) % وما كان إلا أن وفيت بعهده % وأسميت حتى مات من خوفك الغدر % 27(@)(@@) % فكنت عصا موسى هوت فتلقفت % بآيتها البيضاء ما أفك السحر % 28(@)(@@) % طلعت لنا بالملك شمسا جديدة % أعادت بياض الحق والحق مغبر % 29(@)(@@) % ترحل في يوم من الشر عابس % وعاد وقد أعداه من وجهك البشر % 30(@)(@@) % أضاءت لنا من بعد ظلمتها الدجى % % فقلنا الوزير القاسمي أو البدر % PageV01P985 31(@)(@@) % وكم مثلها من غمة قد فرجتم % ومن دولة هيضت 
ms326	 وأنتم لها جبر % 32(@)(@@) % دجت ما دجت ثم انجلت وسيوفكم % كواكب فيها أو وجوهكم الغر % 33(@)(@@) % بكم رب هذا الملك طفلا وناشئا % فما ضمه حصن سواكم ولا حجر % 34(@)(@@) % وفيكم نمت أعراقه وفروعه % ورفت على اغصانه الورق الخضر % 35(@)(@@) % لكم فيه أيام يزيد بياضها % % نصوعا وأيام الأعادي بها حمر % 36(@)(@@) % يداول منكم واحدا بعد واحد % فيرضيه ما تملي التجارب والخبر % 37(@)(@@) % وما تم امر لستم من ولاته % وليس لكم نهي عليه ولا أمر % 38(@)(@@) % لكم سورة المجد التليد وفيكم % طرائف من يفخر بها فهي الفخر % 39(@)(@@) % فيوما أميرا سيفه ويمينه % حمى جانبيه أو حبا الدم والقطر % 40(@)(@@) % ويوما وزيرا صدره ولسانه % كما اشترط القرطاس واقترح الصدر % PageV01P986 41(@)(@@) % هو الشرف العجلي يصدع فجره % وتغني عن الدنيا كواكبه الزهر % 42(@)(@@) % ويستوقف الأسماع منشور ذكره % إذا وصم الناس الأحاديث والذكر % 43(@)(@@) % فلا يعدم الدهر الفقير إليكم % فتى منكم في جوده ينسخ الفقر % 44(@)(@@) % ولا زال مغمور من الفضل دارس % يعود به غضا نوالكم الغمر % 45(@)(@@) % ومليت أنت ثوب عز سحبته % ولا يبله سحب عليك ولا جر % 46(@)(@@) % يطول إلى أن لا يرى ما يطوله % ويمتد فيه العمر ما حسن العمر % 47(@)(@@) % وعذراء بكرا من عوارف ربها % % حبيت بها ما كل عارفة بكر % 48(@)(@@) % رآك الإمام كفئها وقوامها % % فسيقت وما إلا علاك لها مهر % 49(@)(@@) % لبست بها تاجا وحصنا حصينة % وإن لم يصغها لا الحديد ولا التبر % 50(@)(@@) % تمنى رجال أن يكونوا مكانها % % ففاتت ولم يقدر على مثلها قدر % PageV01P987 51(@)(@@) % مشيت على بسط الخلافة واطئا % مكانا تمناه من الفلك النسر % 52(@)(@@) % مكانا زليقا لو سواك يقومه % هوت رجله أو ظن أن الثوى جمر % 53(@)(@@) % وقلب شجاع القلب والفم باسطا % لسانك حيث القول محتشم نزر % 54(@)(@@) % ولما وعدت بالطروق تشوف ال % % سرير إلى رؤياك واشتاقك القصر % 55(@)(@@) % وود ولي الأمر كل صبيحة % لعينيه عن إقبال وجهك تفتر % 56(@)(@@) % مزايا إذا خاف الكفور سراحها % % فعندك فيهاأن يقيدك الشكر % 57(@)(@@) % وقد كنت أرجوها وأزجر طيرها % % بفأل قضى 
ms327	 أن لا يخيب له زجر % 58(@)(@@) % وأنذر إن أدركتها فيك منسكا % أقوم به فاليوم قد وجب النذر % 59(@)(@@) % وفاء عصى أن يستحيل به النوى % % وعهدا تعالى أن يغيره الهجر % 60(@)(@@) % وشفعا لأسلاف لديك شفيعها % % مطاع وقاضيها له الحكم والأمر % PageV01P988 61(@)(@@) % وإن مسني لذع الجفاء وطال بي % % فرب جفاء في مدارجه عذر % 62(@)(@@) % وقد أمكن الإنصاف والجود فرصة % إذا أعوزت في العسر قام بها اليسر % 63(@)(@@) % وهل ضائع حقي ومجدك شاهد % بفضلي وسلطاني على مالك الشعر % 64(@)(@@) % اعد نظرة تشجي الزمان بريقه % يراش بها المحصوص أو يجبر الكسر % 65(@)(@@) % ووفر لها أعراض ما فات إنها % % غنيمة مجد يستقل بها الوفر % 66(@)(@@) % فما زلت ألقى العدم جذلان مهونا % بما جر علما أن رأيك لي ذخر % PageV01P989 البحر : - 1(@)(@@) % دل على الخير وأنبائه % ودل أحيانا على الشر % 2(@)(@@) % للطالبين الوتر عونا إذا % % ثاروا ومأخوذ بلا وتر % 3(@)(@@) % باح بما استودعته صدره % لا ضيق الباع ولا الصدر % 4(@)(@@) % تم بقد لم يطل وانطوى % % مجتمع الأعضاء بالنشر % 5(@)(@@) % غير ضعيف أبدا أسره % وهو طوال الدهر في الأسر % PageV01P990 البحر : - 1(@)(@@) % وما سائر بين الورى دائر % بآية سائرة دائره % % 2(@)(@@) % يجول في مستبهم ضيق % منه حذاء الحلق الوافره % % 3(@)(@@) % نتظر منه أبدا كلما % % ليست له عينك بالناظره % % 4(@)(@@) % يوجد منه ناحل مسمن % يحمل في واردة صادره % % 5(@)(@@) % ووادع يدئب أقرانه % % وغائب صورته حاضره % % 6(@)(@@) % قضت به خرقاء مضعوفة % قضية القادرة القاهره % % 7(@)(@@) % كأنما تعقد في نظمه % سحرا ولكن أختها الساحره % % 8(@)(@@) % تعطيك إما ظفرا أو ردى % سماته العادلة الجائره % % 9(@)(@@) % فساعة متجرها مربح % وساعة خائبة خاسره % % 10(@)(@@) % شواهد الإيمان في صمته % ودينه في أمة كافره % % PageV01P991 البحر : - 1(@)(@@) % أبكي عليها وما شط المزار بها % % ودمعة البين تجري دمعة الحذر % 2(@)(@@) % وأقتضى وصلها صدا يناوبه % خوفا من العين أو من فطنة الغير % 3(@)(@@) % غار المحبون من أبصار غيرهم % ضدا وغرت على لمياء من بصري % % 4(@)(@@) % فكل ذي شجن يشكو صبابته % يلقى من الشوق ما ألقى من النظر % 5(@)(@@) % في الغاديات 
ms328	 يردن الصيد ناصبة % لأنفس الصيد أشراكا من الحور % 6(@)(@@) % تهدي إلى حسنها في اليوم ليلتها % % وجها تولد بين الشمس والقمر % PageV01P992 البحر : - 1(@)(@@) % ذكرت وما وفاي بحيث أنسى % % بدجلة كم صباح لي وممسى % % 2(@)(@@) % بقلبي من مبانيها مغان % بنى فيها السرور فصار حلسا % % 3(@)(@@) % مغان تجتني منها نعيما % ولم نغرس بفعل الخير غرسا % % 4(@)(@@) % تركت خلالها ورحلت قلبي % % فلو عذبت قلبي ما أحسا % % 5(@)(@@) % شريت عراصها نقدا بدين % فلولا ما شريت شكوت وكسا % % 6(@)(@@) % وبكر من ذخائر رأس عين % تعود بمجلس الندمان عرسا % % 7(@)(@@) % يضن بها يهود أو نصارى % % وقد كرمت وإن لؤما وخسا % % 8(@)(@@) % خطبناها فقام القس عنها % % يخاطبنا فخلت القس قسا % % 9(@)(@@) % يحدث معربا ما شاء عنها % % ويعهد معجما لكنا وجنسا % % 10(@)(@@) % وصار بمهرها ثمنا يغالي % % به في ظنه ونراه بخسا % % PageV01P993 11(@)(@@) % أسل ذهبا تزن ذهبا فإنا % % نرى في حبها الدينار فلسا % % 12(@)(@@) % وخافقة الفؤاد مشين عجلى % % بها الأتراب وهي تدب همسا % % 13(@)(@@) % تعثر دهشة بالبين حتى % % يقلن لعا لها فتقول تعسا % % 14(@)(@@) % تغوث من نواي بمخطفات % حلين عواطلا ونطقن خرسا % % 15(@)(@@) % إذا فجع الفراق قبضن عشرا % % وإن فجأ اللقاء بسطن خمسا % % 16(@)(@@) % تقول عدمت مدعيا هواكم % وأصبح يوم بينكم فأمسى % % 17(@)(@@) % أقيمي غير جازعة فإني % % أراها وحشة ستجر أنسا % % 18(@)(@@) % ذريني والتطرح إن بيتا % إذا هو صار إلفا صار حبسا % % 19(@)(@@) % أجز جبلا وراء الرزق قالت % % وتتركنا فؤادك منه أق سى % % 20(@)(@@) % ألا من مبلغ الأيام عني % % وإن خجلت فما تستطيع نبسا % % PageV01P994 21(@)(@@) % متابي بعدها من كل ذنب % أناخ بساحتي ثقلا وأرسى % % 22(@)(@@) % وكانت سكرة أقلعت منها % % على صحو وذنب السكر ينسى % % 23(@)(@@) % وما اجتمعت بروجرد وفقر % % ولا أحد رأى سعدا ونحسا % % 24(@)(@@) % فتى أحيت به الأيام ذكري % % وكان موسدا منهن رمسا % % 25(@)(@@) % وقد ردت نيوب الدهر دردا % % يداه وقد فغرن إلي نهسا % % 26(@)(@@) % وذاد سماحه الفياض عني % % ذئابا من صروف الدهر طلسا % % 27(@)(@@) % وأعطى ظاهرا سرف العطايا % % فلما عوتب استخفى ودسا % % 28(@)(@@) % أيا سعد بن أحمد ما 
ms329	 تسمي % % ويا رضوى إذا انتسب ابن قدسا % % 29(@)(@@) % نمت أعراقه فنماك غصنا % فطبت الفرع لما طاب أسا % 30(@)(@@) % وأشرق فاستفدت النور منه % فكنت البدر لما كان شمسا % % PageV01P995 31(@)(@@) % عظمت ندى فلو لويت خطوب % بجودك لالتوين وكن شمسا % % 32(@)(@@) % وطبت يدا فلو لثمت شفاه % تقبل راحتيك لثمن لعسا % % 33(@)(@@) % بنائل آل إبراهيم عاش ال % % سماح وقد محاه الدهر درسا % % 34(@)(@@) % وهب الريح في روح المعالي % % فطرن وطالما رددن قعسا % % 35(@)(@@) % عرانين مع الجوزاء شم % تشم عداتها الإرغام فطسا % % 36(@)(@@) % وأعراض تصافح لامسيها % % غداة تضرس الأعراض ملسا % % 37(@)(@@) % يموت حسودها منها بداء % إذا استشفاه عاود منه نكسا % % 38(@)(@@) % دعاني الشوق يزأر بي إليكم % فسرت ملبيا والدهر يخسى % % 39(@)(@@) % لأدرك معجزاتكم بعيني % % فيصبح منظرا ما كان حسا % % 40(@)(@@) % وكم بمديحكم بددت درا % على القرطاس ما استمددت نقسا % % PageV01P996 41(@)(@@) % وقد كان البنان ينوب خطا % فقد حضر اللسان يهد درسا % % 42(@)(@@) % رعيت هشيم طرقكم لماظا % فردوني ألس الحمض لسا % % 43(@)(@@) % ورووا من نميركم غليلا % وردت به القذى خمسا فخمسا % % 44(@)(@@) % فإن الله أوجبها فروضا % عليكم لا تزال الدهر حبسا % % 45(@)(@@) % صلاح بلاده شرقا وغربا % ورزق عباده عربا وفرسا % % PageV01P997 البحر : - 1(@)(@@) % كالشمس من جمرة عبد شمس % غضبى سخت نفسي لها بنفسي % % 2(@)(@@) % ماطلة غريمها لا يقتضى % % ديونه ودينها لا ينسي % % 3(@)(@@) % في بلد يحرم صيد وحشه % وهي به تحل صيد الأنس % 4(@)(@@) % ترى دم العشاق في بنانها % % علامة قد موهت بالورس % 5(@)(@@) % تفسد خلقا لينا معتدلا % لها بأخلاق جعاد شمس % 6(@)(@@) % في طرفها تغزل وقلبها % % حماسة تنسبها للحمس % 7(@)(@@) % ذكرتها العهد على كاظمة % قالت نسيت والفراق ينسي % % 8(@)(@@) % أنكر منها حلية غريبة % تشوب لي معرفة بلبس % 9(@)(@@) % وشعرا مبدلا بشعر % بدل فيها بالنفار أنسي % % 10(@)(@@) % هل هو إلا الشيب أم مالك % لا بد أن يصبح ليل الممسي % % PageV01P998 11(@)(@@) % وما عليك والهوى مكانه % أن الثغام في مكان النقس % 12(@)(@@) % غال بها عند الغواني لمة % ما لم تبعها حددا بلبس % 13(@)(@@) % إن الكرام درست آثارهم % فلم أطق ضبطا 
ms330	 لها بدرس % 14(@)(@@) % إلا من البيت الذي خطته % يرشح فيها مجدها فيرسي % % 15(@)(@@) % شاد بنو عبد الرحيم في العلا % % خير بناء فوق خير أس % 16(@)(@@) % ادفع بهم غضبة كل لزبة % عمياء تدفع ربوة بقدس % 17(@)(@@) % والق بنجم منهم وسعده % تخلص نجيا كل يوم نحس % 18(@)(@@) % إني عجمت بالحسين زمني % % فلم يثلم وهو صلب ضرسي % % 19(@)(@@) % وذب عني فوفيت ناهضا % من الخطوب بذئاب طلس % 20(@)(@@) % انشر آمالي وكن رمما % % يا من رأى حياة ما في الرمس % PageV01P999 21(@)(@@) % ومد لي كفا فكانت رقية % والدهر أفعى فاغر لنهسي % % 22(@)(@@) % صافحتها فصفحت بلينها % % عني ضروس السنوات اليبس % 23(@)(@@) % ما استصبحت عين بمثل وجهه % واليوم عباس العشي ممسي % % 24(@)(@@) % ولا ورى زندي إلا رأيه % أبيض منه في الخطوب الغبس % 25(@)(@@) % من دوحة مظلة مطعمة % طاب جناها الحلو طيب الغرس % 26(@)(@@) % أدتهم يحذوك فرع أصله % لم يك دينارهم ابن الفلس % 27(@)(@@) % إن بليت أعراض قوم أو خبت % يوما فغطت صحة بلبس % 28(@)(@@) % باتوا بأعراض عراض في العلا % % يوم الفخار ووجوه ملس % 29(@)(@@) % مكارم معمة مخولة % تركبت من عرب وفرس % 30(@)(@@) % لم يتهجن غرها وشمها % % بالبهم من أمائها والفطس % PageV01P1000 31(@)(@@) % واليوم باق من حلي ما بكم % بقاء سطر ناحل في طرس % 32(@)(@@) % غير أخذ الحق من باطله % طلاوة فيه وفرط أنس % 33(@)(@@) % فراع من حفظهم في رسمه % ناسجة العرق وحق الجنس % 34(@)(@@) % واعمر بساعات السرور ساعة % تتبع برء سكرة بنكس % 35(@)(@@) % ما بين جور قدح وعدله % وبين حث مزهر وجس % 36(@)(@@) % هذا لحر فارس نسبته % وتلك من علج النصارى الجبس % 37(@)(@@) % عجبت منها خشبا من خشب % جاءت ومنه ناطقا عن خرس % 38(@)(@@) % فاشرب على ابن الموبذان خرقت % عذرته عذراء بنت القس % 39(@)(@@) % وخذ لأيام الشتاء أهبة % أخذ العروس أهبات العرس % 40(@)(@@) % عندي من جودك فيه عادة % يحبسها النسيان بعض الحبس % PageV01P1001 41(@)(@@) % تدركني وقد قضت رعيانه ال % % أوطار من تحششي ولسي % % 42(@)(@@) % والمجد فيما أنت مهد خالع % والنفع أن تلبس وقت اللبس % 43(@)(@@) % وحاجتي إذا اقترحت حاجة % في 
ms331	 لطف حس وبحسن مس % 44(@)(@@) % في أن يكون اليوم ما يأتي غدا % إذا كنت قد أجممتكم بالأمس % 45(@)(@@) % واعلم بنفسي وأنت خير عالم % أن الشتاء من عدو النفس % PageV01P1002 البحر : - 1(@)(@@) % مالي كأني مخبول ولست به % أشكو إلى الناس مع علمي من الناس % 2(@)(@@) % كنا إذا اعتلت الأذناب يجبرنا % % رجاؤنا الرأس حتى أودي الراس % 3(@)(@@) % لا بأس في كف نفسي عن سؤالهم % وليس عندهم جود ولا باس % 4(@)(@@) % نقل ركابك إلا في رحابهم % واستغن ما شئت عنهم فالغنى الياس % PageV01P1003 البحر : - 1(@)(@@) % خنساء همي وذكرها أنسي % % إذا أماني حدثت نفسي % % 2(@)(@@) % وساوس بين خاطري وفمي % % أصبح أهذي بها كما أمسي % % 3(@)(@@) % حتى لظن الأقوام أني مم % % سوس وما بي إلاك من مس % 4(@)(@@) % كم دعوة يشد الحفيظ على % % خلوص سري بها من اللبس % 5(@)(@@) % يا رب إما أن ضمني وصل خن % % ساء إليها أو ضمني رمسي % % PageV01P1004 البحر : - 1(@)(@@) % يا وحشة المجد ثقي بالأنس % قد عطت الشمس رداء الغلس % 2(@)(@@) % ويا حمى الزوراء أمنا حرمت % رعيك كف الأخدري الأشوس % 3(@)(@@) % من بعد ما كنت ببعد صوته % مهبط كل خابط ملسس % 4(@)(@@) % عاد الحيا مرقرقا على الثرى % % بمائه قبل كل يبس % 5(@)(@@) % وانتشرت خضراء دوحة العلا % % فالساق وحف والقضيب مكتسي % % 6(@)(@@) % ورد مجد الدين في أيامه % دين الندى كأنه لم يدرس % 7(@)(@@) % عز به الفضل كأن لم يهتضم % وقامت العليا كأن لم تجلس % 8(@)(@@) % ووضحت على ضلالات السرى % % طرق المنى للرائد الملتمس % 9(@)(@@) % فيا مثير العيس جعجعها ويا % % مرسل أفراس الرجاء أحبس % 10(@)(@@) % كفيتما تهجيرها مظهرة % وخوضها في الليل بحر الحندس % PageV01P1005 11(@)(@@) % جاءكما الحظ ولم تقامرا % % بناقة فيه ولا بفرس % 12(@)(@@) % لم تضربا أعناقها وسوقها % % حرصا لإدلاج ولا معرس % 13(@)(@@) % رد الكرى إلى العيون قرة % وعاد للأنفس روح الأنفس % 14(@)(@@) % بالحلو والمر على أعدائه % والطائش السرج الوقور المجلس % 15(@)(@@) % ببابلي ماله لم يمتنع % وسامري عرضه لم يمسس % 16(@)(@@) % أروع لا يعثر من آرائه % بمشكل هاف ولا ملتبس % 17(@)(@@) % إذا دجى الخطب سرى مستقدما % من 
ms332	 عزمه في قمر أو قبس % 18(@)(@@) % لا هاشم مغرر لم يعتبر % ولا حريص معجب لم يقس % 19(@)(@@) % نجذت الأيام منه قارحا % بفضله والسن لم تعنس % 20(@)(@@) % وطال أمات العضاة مشرفا % وهو قريب عنده بالمغرس % PageV01P1006 21(@)(@@) % تختمر الزهرة في لثامه % بصدغها حتى الدجى المعسعس % 22(@)(@@) % فإن غلت بصدره حمية % راعك وجه الضيغم المعبس % 23(@)(@@) % رمت به صحن السماء فسما % % مدارج البيت الأشم الأقعس % 24(@)(@@) % فأنت من أخلاقه في مغزل % ومن حمى غيرته في محمس % 25(@)(@@) % بيت يقول الله بيت مثله % عندي لم يبنى ولم يؤسس % 26(@)(@@) % سماحة الغيث وفي أرجائه % مهابط الوحي وروح القدس % 27(@)(@@) % ومنه فرعا مكة وطيبة % تشعبا ومنه بي المقدس % 28(@)(@@) % قوم بهم ثم ونحن فترة % فرج المضيق وانكشاف اللبس % 29(@)(@@) % هم حملوا على الصراط أرجلا % لولا هداهم عثرت بالأرؤس % 30(@)(@@) % وحطموا ودا وخلوا هبلا % مبدلين بالعتيق الأملس % PageV01P1007 31(@)(@@) % ديست من الشرك بهم جماجم % ترابها من عزة لم يدس % 32(@)(@@) % ساروا بتيجان الملوك عندنا % % معقودة على الرماح الدعس % 33(@)(@@) % آلك آل الحجرات أيقظوا % % للرشد أبصار القلوب النعس % 34(@)(@@) % وأخذوا إلى فسيح لاحب % بالناس من جهل المضيق الملبس % 35(@)(@@) % قالوا فجادوا فكأن الرعد لم % يرزم وماء المزن لم ينبجس % 36(@)(@@) % وحدك الناطق بالصدق له % طاعة كل ناطق وأخرس % 37(@)(@@) % وبأبيك حبه وبغضه % غدا يرى لمحسن خسران المسي % % 38(@)(@@) % وأنت ما أنتلحوقا بهم % زرارة تجري وراء عدس % 39(@)(@@) % يقديك مملوك عليه أمره % رخو البدادين ضعيف المرس % 40(@)(@@) % يأكله العيب فلا يميطه % بماله عن عرضه المضرس % PageV01P1008 41(@)(@@) % لو خنقته ذلة البخل لما % % قال بدينار لها تنفسي % % 42(@)(@@) % يغزو أباك ويظن مقنعا % عز الأصول مع ذل الأنفس % 43(@)(@@) % ضم إليك فعلوت ولطى % % سوم الأشم قسته بالأفطس % 44(@)(@@) % عاد بظل بيته وأصحرت % غر مساعيك بقاع مشمس % 45(@)(@@) % تأخذ حق العز قسرا وسطا % والأسد لا تعاب بالتغطرس % 46(@)(@@) % فاصدع بها دامية نحورها % % صدع فتى في نقعها منغمس % 47(@)(@@) % وقم بنا نطلبها عالية % أما لمرمى العز أو للمرمس % 48(@)(@@) % فالسيف مالم يمض قدما زبرة % والليث 
ms333	 كلب البيت مالم يفرس % 49(@)(@@) % نادى البشير وفؤادي جمرة % للشوق من يرفع له يقتبس % 50(@)(@@) % والبين قد أوحدني فليس لي % % بعدك غير وحشتي من مؤنس % PageV01P1009 51(@)(@@) % والبعد باستمراره يطلع لي % % كيف طمعت من ثنايا الموئس % 52(@)(@@) % دعا وقد ضعفت عن جوابه % كأن نفسي خلقت من نفسي % % 53(@)(@@) % هذا الزكي ابن التقي فطغى % % شيطان شوقي وهوى موسوسي % % 54(@)(@@) % وقيل ممسوس ولكن واجد % قلبا له ضل ولما يمسس % 55(@)(@@) % فيالها غنيمة سري بها % % لم يختلج وخاطري لم يهجس % 56(@)(@@) % أحلى على القرب وقد تملأت % عيني بها من نظرة المختلس % 57(@)(@@) % حبا غزيرا لا كما تسنيه لي % % من نزر ماء وقليب يبس % 58(@)(@@) % وشكر ماتوسع من خلائق % على البعاد ثوبها لم يدنس % 59(@)(@@) % طاهرة إذا عركت جانبي % % من ود قوم بالخبيث النجس % 60(@)(@@) % عرفتني والناس ينكرونني % % وجدك بالشفوف والتفرس % PageV01P1010 61(@)(@@) % أودعتك الفضل فلا حقوقه % عندك ضاعت ولا العهد نسي % % 62(@)(@@) % فقصر ما أوليت أن أجزيه % جزاءه في المطلقات الحبس % 63(@)(@@) % شوارد باسمك كل مطرح % ولم ترح عنك ولم تعرس % 64(@)(@@) % كالحور في خيامها مقصورة % وفي الفلا مع الظباء الكنس % 65(@)(@@) % مما حويت برقاي فسرى % % سحري في حياتهن النهس % 66(@)(@@) % يترك كل ماسح غير يدي % % دما على نيوبها والأضرس % 67(@)(@@) % تغشاك لا تحتشم الصبح ولا % % ترهب في الليل دبيب العسس % 68(@)(@@) % فأنت منها أبدا غواديا % ورائحات في ثياب العرس % 69(@)(@@) % فاسمع لها واسلم على اتصالها % % واتق أن تعيرها واحترس % 70(@)(@@) % واستغن بي واغنني عن معشر % سورة فضلي بينهم لم تدرس % PageV01P1011 71(@)(@@) % أعوذ من ليني لهم بجعدي % % ومن ذحولي بينهم ببلسي % % 72(@)(@@) % شفيت أعراضهم وعيشتي % % فيهم متى تبرا اختلالا تنكس % 73(@)(@@) % ود القريض قبل ما قال لهم % على لساني أن نطقي خرسي % % 74(@)(@@) % فإن تغر أو تكفني جانبهم % فلست من ذلك بالمبتئس % PageV01P1012 البحر : - 1(@)(@@) % سل بالغوير السائق المغلسا % % هل يستطيع ساعة أن يحبسا % % 2(@)(@@) % فإن في الدار رذايا لوعة % نوقا ضعافا وعيونا نعسا % % 3(@)(@@) % وثملين ماأداروا بينهم % إلا السهاد والدموع أكؤسا % % 4(@)(@@) % ما علمت نفوسهم 
ms334	 أن الردى % % ميقاته الصبح إذا تنفسا % % 5(@)(@@) % راخ لهم فإنهم وفد هوى % يرضيه أن ترود أو أن تسلسا % % 6(@)(@@) % تركت من خلفك أجسامهم % وسقت ما بين يديك الأنفسا % % 7(@)(@@) % اعطف لهم شيئا فلو لم ينفسوا % % على الشموس في الخدور منفسا % % 8(@)(@@) % لأغرقوك دمعة فدمعة % وحرقوك نفسا فنفسا % % 9(@)(@@) % أين تريد عن حياض حاجر % أن تستجيز الخضم والتلسسا % % 10(@)(@@) % وهل على ماء النخيل مطعن % إذا وردت مثلثا أو محمسا % % PageV01P1013 11(@)(@@) % وفي الحمول سمحة ضنينة % تبذل وجها وتصان ملمسا % % 12(@)(@@) % شنت على الكناس حتى لم تدع % للريم إلا حمشنا أو خنتسا % % 13(@)(@@) % تبسم عن أشنب في ضمانه % نطفة مزن لقبها اللعسا % % 14(@)(@@) % سلسالة إن لم أكن عرفتها % % رشفا فقد عرفتها تفرسا % % 15(@)(@@) % يا هل إلى ذاك اللمي وسيلة % تبل لي هذا الغليل اليبسا % % 16(@)(@@) % أم هل إلى ذاك الهلال نظرة % إما بملء العين أو مختلسا % % 17(@)(@@) % بل كل ما بعد المشيب مسمح % ماكس أو منجذب تشمسا % % 18(@)(@@) % ومن عناء اليد أن تبغي الجنا % % والساق خاو والقضيب قد عسا % % 19(@)(@@) % لامت على تعزلي إذ أبصرت % جحفل شيب هاجما ومحمسا % % 20(@)(@@) % تنكرته مذ رأته بلجة % ضاحية أن عرفته حندسا % % PageV01P1014 21(@)(@@) % بيضاء أعشت في السواد عينها % % فاشتبه الصبح عليها والمسا % % 22(@)(@@) % إذا تلفعت بها منصعا % ماكنت من صبغتها مورسا % % 23(@)(@@) % منتبذا نبذ الحصى يردني % % نقد العيون أخزرا وأشوسا % % 24(@)(@@) % فلم تكن أول حال غبطة % أحسن فيها زمني ثم أسا % % 25(@)(@@) % هو الذي ما جاد أو ضن ولا % % رق على مرة إلا قسا % % 26(@)(@@) % وقد ألفتث خلقه تمرنا % به على لونيه أو تمرسا % % 27(@)(@@) % حلفت بالحلق الطلاح صعبت % على الوجى سوقا ولانت أرؤسا % % 28(@)(@@) % مثل القسي كل ظهر فوقه % ظهر بإدمان السرى قد قوسا % % 29(@)(@@) % من كل فتلاء تطيع المرس ال % % مثنى عليها أو تعود مرسا % % 30(@)(@@) % تقامر الأخطار في نفوسها % % على لطلاب غن زكا وإن خسا % % PageV01P1015 31(@)(@@) % يخبطن يطرحن الربى عجرفة % في الوفد يطلبن العتيق الأملسا % % 32(@)(@@) % إذا فرقن الموت لم يفرقن ما % % ديث من 
ms335	 أرض وما توعسا % % 33(@)(@@) % حتى يؤدين الشخوص بمنى % % مكبرا لله أو مقدسا % % 34(@)(@@) % لاضاع من يعتمد الحظ به % من قسمة على عميد الرؤسا % % 35(@)(@@) % أروع لاترعى الخطوب ما رعى % % ولا تشل غارة ما حرسا % % 36(@)(@@) % أبلج بسام العشي ما غدا % % وجه الجدوب في الثرى معبسا % % 37(@)(@@) % مبارك الصفقة يهتز الغنى % % في كل ما صافح أو ما لمسا % % 38(@)(@@) % يفرج التقبيل عن أنامل % لو قارع الصخر بهن انبجسا % % 39(@)(@@) % جاد على اليسر فلما أفلست % به عطايا اليسر جاد مفلسا % % 40(@)(@@) % لا يحسب المال يغطي عورة % عارية ما غطت العرى الكسا % % PageV01P1016 41(@)(@@) % أرهف للأعراض من عزمته % أصمع ما أنبل إلا قرطسا % % 42(@)(@@) % إذا رمى غايته بظنه % كفى يقين غيره ما حدسا % % 43(@)(@@) % قال فأعدى الخرس بالنطقكما % % حسن عند الناطقين الخرسا % % 44(@)(@@) % وقام يبغي حقه من العلا % % حتى إذا جاز النجوم جلسا % % 45(@)(@@) % موقر المجلس إما هو في ال % % دست احتبى أو ركن ثهلان رسا % % 46(@)(@@) % إذا سطاه أوحشت جليسه % فاض عليها بشره فأنسا % % 47(@)(@@) % ذب على الخليفتين رأيه ال % % منصور ذؤبان الخلاف الطلسا % % 48(@)(@@) % أصحر في إثر العدو عنهما % % أغلب ما وافى إلا فرسا % 49(@)(@@) % خلافة الله رقى مشيدا % منها الذي كان أبوه أسسا % % 50(@)(@@) % طهرها تدبيره فلم يدع % إزاءها من العباد نجسا % % PageV01P1017 51(@)(@@) % رقى من الأعداء كل حية % أصم لو كان يحوه لنهسا % % 52(@)(@@) % كم قد جلوت الحق عن بصيرة % عمياء فيها وكشفت لبسا % % 53(@)(@@) % أنفقت ميراثك في طاعتها % % جناه أيوب الذي قد غرسا % % 54(@)(@@) % تمنع من قناتها من رامها % % بالعجم أو أدردت عنها الأضرسا % % 55(@)(@@) % أنت الذي أحيا الزمان راعيا % من سنن المجد به مادرسا % % 56(@)(@@) % قومك كنت في اقتفاء سعيهم % زرارة في الفخر تتلو عدسا % % 57(@)(@@) % قد كبرت لك العلا وشكرت % نشرك ذاك الكرم المرمسا % % 58(@)(@@) % بك اعتلت ناري وهبت عاصفا % % ريحي والتف قضيبي واكتسى % % 59(@)(@@) % وطمعت في زمني فضائلي % % وكنت من إنصافه مستيئسا % % 60(@)(@@) % إن أجدبت أرضي صبت مزنة % أو ادجنت حالي لحت قبسا % % PageV01P1018 61(@)(@@) % ساهمتني يسرك والعسر 
ms336	 ترى % % بخس العلا وغبنها أن أبخسا % % 62(@)(@@) % لا تذخر الأنزر تضطر له % ولا تضن ما وجدت الأنفسا % 63(@)(@@) % فلا تصبني فيك يد حادث % أومض أو بارق خطب أربسا % % 64(@)(@@) % ولا تزل تلين لي من عنق ال % % أيام فظا في مقادي شرسا % % 65(@)(@@) % وعاودتني بادئات نعم % منك إذا استوحشت كانت أنسا % % 66(@)(@@) % ضافية تفضل عن ذلاذلي % % لا أنزع الحلة حتى ألبسا % % 67(@)(@@) % قد راعني العام افتقاد رسمها % % وأن إرى مطلقه محتبسا % % 68(@)(@@) % حاشاك من تطيري على العدا % % من سطرها الثابت لي أن يطمسا % % 69(@)(@@) % ديني وفي الشتاء بعد فضلة % يوضح منها المشكل الملتبسا % % 70(@)(@@) % فسمح بها واسمع لها قواطنا % % شواردا ملاينات شمسا % % PageV01P1019 71(@)(@@) % تطوي الفجاج لم ترحل ناقة % لها ولم تسرج إليها فرسا % % 72(@)(@@) % لا ترهب الجنة في غريفها % % إن أعتمت لا تخاف العسسا % % 73(@)(@@) % عذائرا تكون ما شئت بها % % كل ضحى تهنئه معرسا % % 74(@)(@@) % قد أمنت بحصنها وصونها % % عند الرجال كل ما تخشى النسا % % 75(@)(@@) % ما كتبت أو قرئت لم تترك % % لغيرها مخطة أو مدرسا % % 76(@)(@@) % تشفع للنيروز فيما جاء من % قبولكم مبتغيا ملتمسا % % 77(@)(@@) % ثم يعود مثلها عليكم % بألف عيد عربا وفرسا % % 78(@)(@@) % في نعم يقينها وحقها % % يغني الليال عن لعل وعسى % % PageV01P1020 البحر : - 1(@)(@@) % وجار يجد بهش رائضا % % ن من مطلق منه أو حابس % 2(@)(@@) % إذا ما مضى في سواء الطري % % ق شق بذاك على الفارس % 3(@)(@@) % تبوع تهتز منه الضلو % % ع بين المرنح والجالس % 4(@)(@@) % له نسب في اغتراس الرجا % % ل وهو بلاء على الغارس % PageV01P1021 البحر : - 1(@)(@@) % أرأيت أم حبست لحاظك عبرة % طللا لسعدا بالمحصب أو قصا % % 2(@)(@@) % تبع الرياح وكان يسأل مفصحا % عن ساكنيه فصار ينطق معوصا % % 3(@)(@@) % دمن إذا شخصت لعينك أشرفت % نزوات قلبك يقتضيك مشخصا % % 4(@)(@@) % بعدت بآثار الأنيس عهودها % % فوحوشها في نجوة أن تقنصا % % 5(@)(@@) % وكأن جائمة الثغام بعقرها % % أشياخ حي جالسين القرفصا % % 6(@)(@@) % ولقد تعد فلا تعد بطالة % لك في ثراها بددت بدد الحصا % % 7(@)(@@) % أيام عيشك بارد متلوم % وسواك ينهش عيشه مستفرصا 
ms337	 % % 8(@)(@@) % وعليك من ظلل الشباب وقاية % ظل لعمرك حين أسبغ قلصا % % 9(@)(@@) % ندمان سافرة الجمال إذا احتمت % عينا تنقبت البنان الرخصا % % 10(@)(@@) % ريا إذا هزت لشغل غصنها % % أمر الكثيب وراءها أن تنكصا % % PageV01P1022 11(@)(@@) % سمجت فغودر كل ذنب عندها % % إلا الخيال تكذبا وتخرصا % 12(@)(@@) % وعجبت منها والموانع جمة % من أنها وجدت إلي تخلصا % % 13(@)(@@) % طرقت وشملتها الدجى فأسرها % % سيئا ونم بها الحلي فأوبصا % % 14(@)(@@) % مالي سمحت بحظ نفسي ذاهبا % في الغافلين وبعت حزمي مرخصا % % 15(@)(@@) % والدهر يوسعني إذا عاصيته % لحظا يسارقني التوعد أخوصا % % 16(@)(@@) % ولقد كفاني شيب رأسي عبرة % وعلى الفناء دلالة أن نقصا % % 17(@)(@@) % فلأركبن إلى السلامة غاربي % % عود إذا وخد المهاري أو قصا % % 18(@)(@@) % أنس بأشباح الفيافي طرفه % لا يطبيه منفر أن يقمصا % % 19(@)(@@) % يطس الثرى وردا وينصل أورقا % % مما ارتدى بغباره وتقمصا % % 20(@)(@@) % متحريا بهدايتي وأدائه % في حيث لاتجد القطاة المفحصا % % PageV01P1023 21(@)(@@) % في فتية يتبادلون نفوسهم % في الحق أين رأوه لاح محصحصا % % 22(@)(@@) % ومسومين ضوامرا أعرافها % % تفلى بأطراف الرماح وتنتصى % % 23(@)(@@) % تبعوا هواي مكلفا أو مؤثرا % وتعلقوا بي مازحا أو مخلصا % % 24(@)(@@) % وإذا بلغت بناصح أو مدهن % ما تبتغيه فقد أطاعك من عصى % % 25(@)(@@) % يشكو ملالي نافر خلقي به % ولقد اكون على التواصل أحرصا % % 26(@)(@@) % وتصب نفسي غير أني لم أجد % خلا سقاني الود إلا غصصا % % 27(@)(@@) % قد كنت أطلب من عدوي غرة % فالآن أطلب من صديقي مخلصا % % 28(@)(@@) % كم صاحب بالأمس صادف بطنة % فترت به لما رآني مخمصا % % 29(@)(@@) % لم يلف لي عيبا وطالع عرضه % فرنا إلي بعيبه وتخرصا % % 30(@)(@@) % عد بن أيوب ورض شيمي ترض % متراجعات عن سواه حيصا % % PageV01P1024 31(@)(@@) % أنفقت كل مودة أحرزتها % % سرفا ورحت بوده متربصا % % 32(@)(@@) % من معشر شرعوا إلى حاجاتهم % % أسلا كفته مداهم أن يخرصا % % 33(@)(@@) % من كل أرقش إن تأود ثقفت % منه البلاغة أو تسدد أقعصا % % 34(@)(@@) % يتوارثون به العلاء فسابق % يمضي وقاف إثره متقصصا % % 35(@)(@@) % ولدت حلومهم وهم لم يولدوا % % من قبل أن قرعت لذي الحلم العصا % % 36(@)(@@) % كرماء حببهم 
ms338	 إلي كريمهم % إن الهوى ما عم حتى خصصا % % 37(@)(@@) % بمحمد ردت على أعقابها % % عن ساحتي غشم الحوادث نكصا % % 38(@)(@@) % أعطى فأغنا مسرفا متعديا % ميسوره كرما وود فأخلصا % % 39(@)(@@) % وخبرت قوما قبله وخبرته % فعرفت مولى السيف من عبد العصا % % 40(@)(@@) % تفدي ثرى قدميك قمة ناقص % حزت العلا ملكا وطر تلصصا % % PageV01P1025 41(@)(@@) % حرم السيادة يافعا فاستامها % % شيخا فكان كناكح بعد الخصا % % 42(@)(@@) % لما جلست وقام ينشر باعه % جهد التطاول لم يجد لك أخمصا % % 43(@)(@@) % لو ذم ما ألم المذمة عرضه % ما ينقص العوراء من أن تبخصا % % 44(@)(@@) % وأنا الذي سر القلوب وساءها % % ما حكته لك مسهبا وملخصا % % 45(@)(@@) % وتناذر الشعراء مس لواذعي % % والجمر يحمي نفسه أن يقبصا % % 46(@)(@@) % واستمتني رقي فبعتك مرخصا % % عن رغبة وكواهب من أرخصا % % PageV01P1026 البحر : - 1(@)(@@) % روحها مخمسة خمائصا % % جبا من الإعياء أو وقائصا % % 2(@)(@@) % قرومها الجلة والقلائصا % % موبرة تحسبها قصائصا % % 3(@)(@@) % زاد الربيع وغدت نواقصا % % إذا مشت على الحصى حوائصا % % 4(@)(@@) % عاد بها لذاعه قوامصا % % تسأل بالماء القطا الفواحصا % % 5(@)(@@) % إذا السحاب اغترها مراقصا % % ردت عليه أعينا أخاوصا % % 6(@)(@@) % يغدو السفا لموقهن باخصا % % حتى لحقن طيعا وعائصا % % 7(@)(@@) % يفلين من روض الحمى العقائصا % % ويجتلبن اللمع النشائصا % % 8(@)(@@) % يالك ربعا بالنخيل شاخصا % % أين الظباء تقنص القوانصا % % 9(@)(@@) % بأوجه لم تعرف الوصاوصا % % وأنمل يبسطنها رواخصا % % 10(@)(@@) % إذا ضممن في الدجى القرابصا % % نم عليهن الحلي آبصا % % PageV01P1027 11(@)(@@) % أيام أرعيك الهوى مخالصا % % مناوئا غي الصبا مناوصا % % 12(@)(@@) % ذلك حتى عدت ظلا قالصا % % قل لامرئ نابلني القوارصا % % 13(@)(@@) % مستخفيا وذم فضلي ناقصا % % عمك جهل أتعب الخصائصا % % 14(@)(@@) % عش حاسدا ما شئت أو قل خارصا % % تعلق مني قلقلا محارصا % % 15(@)(@@) % مصابرا أقرانه مرابصا % % حتى يرد كل مخز ناكصا % % 16(@)(@@) % حرمت شربا ما رزقت خابصا % % يالك درا لو تكون خالصا % % 17(@)(@@) % إن ترد الجمر تجده قابصا % % قبلك أقذيت عدا أخاوصا % % 18(@)(@@) % تنص نحوي أعينا شواخصا % % تلفت العانة راعت قانصا % % 19(@)(@@) % ففتها بمهلي حرائصا % % فوت الرؤس أعيت الأخامصا % % 20(@)(@@) % فقل مطيلا في أو ملاخصا % % تشر المنايا 
ms339	 من فمي رخائصا % % PageV01P1028 21(@)(@@) % وربما عفوت عنك ماحصا % % جهد البعوض أن يكون قارصا % % PageV01P1029 البحر : - 1(@)(@@) % رضيت وما من طاعة كل من رضي % وفاء لغدار وحبا لمبغض % 2(@)(@@) % وراجعت قلبي أستر الصبر بعده % فلم أر إلا مقبلا نحو معرض % 3(@)(@@) % حفاظ ولكن لو وجدت جزاؤه % وود ولكن منه لم أتعوض % 4(@)(@@) % أكنت بصحراء الأبيرق صارفي % % بعذلك عن بث الهوى أم محرضي % % 5(@)(@@) % عشية لا يخفى جوى متجلد % ولا تسع الأجفان دمع مغيض % 6(@)(@@) % وأنت تمنيني بدمع سمعته % وما كان إلا قولة من ممرضي % % 7(@)(@@) % ألا في ضمان الله لب أطاره % أصيلا سنا برق بدجلة مومض % 8(@)(@@) % له من سحوق الغيم ردة غامد % وفي خفقان الريح سلة منتصي % % 9(@)(@@) % أضاء ويومي بالجزيرة مظلم % يذكرني من بابل ليلها المضي % % 10(@)(@@) % وحسناء لم ترج الإياب لغائب % فترعى ولم تنو القضاء لمقرض % PageV01P1030 11(@)(@@) % لها منزل بالغور بين معدن % مشيد ومنشور البساط مروض % 12(@)(@@) % حبست به أبغي الحياة لقاتلي % % غراما وأدعو بالشفاء لممرضي % % 13(@)(@@) % ولما توافقنا وفي العيس فضلة % بقدر الوقوف ساعة ثم تنقضي % % 14(@)(@@) % رأت شيبة ما لوحت بعوارضي % % فصرح بالهجران كل معرض % 15(@)(@@) % وقالت أشيخ قلت كهل فأطرقت % وقالت أمام السهم إنذار منبض % 16(@)(@@) % يناغيك بعد الشيب قلبي وناظري % % ومن أين يصفو أسودان لأبيض % 17(@)(@@) % قيالسني أيام يعطل مسحلي % % وصمتي في حلى اللجام المفضض % 18(@)(@@) % أنوام ليل قصر النوم عمره % سلوا ببقاء الليل من لم يغمض % 19(@)(@@) % وكنتم جناحي ثم هيض ببعدكم % فهل بعدكم عضو إذا طرت منهضي % % 20(@)(@@) % أأركض أبغي في البلاد معوضة % بكم طال تطوافي إذن فتركضي % % PageV01P1031 21(@)(@@) % بلى قبص من آل أيوب صاح بي % % سناه وقد اعتمت دونك فاستضي % % 22(@)(@@) % رعت نفسي الخلات قبل وداده % هشيما فلما عن لي قلت أحمضي % % 23(@)(@@) % أبا طالب والظن أنك شافع % لها في غنى عن باعث ومحضض % 24(@)(@@) % شكية مملوء من الوعد قلبه % تحدث عن داء من المطل مريض % 25(@)(@@) % غني بتسويف الأماني تقطعت % عرى صبره بين المجيء إلى المضي % % 26(@)(@@) % أحل بكم في الصوم 
ms340	 حاجة % وقد عبر الأضحى به وهو يقتضي % % 27(@)(@@) % أترضون أن تصفو لغيركم حياضكم % وأرضي تغذي جرعة المتبرض % % 28(@)(@@) % لعلكم ارتبتم بفضل تسهلي % % عليكم وإلمامي بكمئ وتعرضي % % 29(@)(@@) % فلا تحسبوا ذلا فما من ضراعة % بدا لكم ناب الشجاع المنضنض % 30(@)(@@) % وغيرك من يرمي القضاء بذنبه % إذا قيل قد فرطت قال كذا قضي % % PageV01P1032 31(@)(@@) % تسمع لها لم توف شكرك حقه % ولو قد وفت ما كنت بالشكر أرتضي % % 32(@)(@@) % جميلة وجه عاطل من كسى الغنى % % وإن وسمتها منك حلة معرض % 33(@)(@@) % وفي القلب مالا يبلغ الفم ثبه % وفي بقريض دونه الهم مجرضي % % 34(@)(@@) % فعذرا وفوزا بانبساطي فإنه % عزيز على ما اعتاد فرط تقبضي % % 35(@)(@@) % وأخذا من الأيام أوفى حظوظها % % بخير تجد ما شئت منهن وأرفض % 36(@)(@@) % تساق لك الدنيا بظهر مذلل % إذا وزعت قرما بنفرة ريض % PageV01P1033 البحر : - 1(@)(@@) % مطل الدين ولو شاء قضى % % فاسق الذمة ينسى ما مضى % % 2(@)(@@) % كيف يرجى النصح من محتكم % يكثر السخط ولا يرضي الرضا % % 3(@)(@@) % سرني يوم منى معترضا % % ملء عيني وشجاني معرضا % % 4(@)(@@) % وجد الوجد كما خلفه % بعد حول مابرا ما أمرضا % % 5(@)(@@) % أيها الرامي وما أجرى دما % لا تحصب قد بلغت الغرضا % % 6(@)(@@) % قسم الحب فما أنصفني % % جور ما نفل لي وافترضا % % 7(@)(@@) % ما على ساقي دمعي مغدقا % في رضاب لو سقاه مبرضا % % 8(@)(@@) % قد سلبتم حسدا جوهره % فاستحلوه وبقوا العرضا % % 9(@)(@@) % شقي السائق في تبليغه % أدرى أي طريق نفضا % % 10(@)(@@) % الغضا إن الحشا من ذكره % ربما استبردت منها بالغضا % % PageV01P1034 11(@)(@@) % اطلبوا للعين في أبياته % نظرة تكحلها أو غمضا % % 12(@)(@@) % وبنفسي هاجر لم يعتمد % قبضوا من أنسه فانقبضا % % 13(@)(@@) % لم فيه وقلتم رقبة % رمتم صعبا وقدتم ريضا % % 14(@)(@@) % إن تفتك اليوم شمس حجبت % فغدا ما كل يوم أبيضا % % 15(@)(@@) % من أمر الليل والصبح به % أظلم الحظ عليه وأضا % % 16(@)(@@) % خل يا دهر ابن أيوب وخذ % كل شيء إن فيه عوضا % % 17(@)(@@) % هب لي الواحد إني اخترته % وهنيئا لك ما ضم الفضا % % 18(@)(@@) % بك أفدي وبهم منك 