ms301	 تيه % % 5(@)(@@) % إن العقول لتجري وهي قاصرة % والشرع يظهره وقتا ويخفيه % PageV01P1165 البحر : بسيط تام 1(@)(@@) % مشيئة العبد من مشيئة الله % بل عينها عينها والحكم لله % 2(@)(@@) % من حيث ما هو رب العالمين ولا % % تعم واحكم به فيه من الله % % 3(@)(@@) % كما أتى في صريح الوحي في مللي % % إذا تمل يمل الله % 4(@)(@@) % لا يعرف الحق إلا من عقيدته % ونحن نعرف حق الله بالله % % PageV01P1166 البحر : بسيط تام 1(@)(@@) % هوية الحق أسراري وأعضائي % % فليس في الكون موجود سوى الله % % 2(@)(@@) % هذا الذي قلته الشرع جاء به % من عنده معلما وحيا من الباه % % 3(@)(@@) % هو الوجود الذي جلت عوارفه % % ستور أغطية عنه بأشباه % % 4(@)(@@) % ها إن ذي عبرة إن كنت معتبرا % ظهرت فيها بحكم المال والجاه % 5(@)(@@) % هي التي عين التوحيد مشهدها % % فلا تقل عندما تبدو لنا ما هي % % 6(@)(@@) % هي ليس يدركها عين سواها ولا % % تقول أهل النهى في مطلب ما هي % % 7(@)(@@) % هب أنه عين ذاتي كيف أفصله % % عني ولست بما قد قلت بالساهي % % 8(@)(@@) % هنيت يا طالب التحقيق من قدم % صدق بما حزته من عين أنباه % % 9(@)(@@) % هناك معطي وجود الكون من عدم % في عين حد وفي ساه وفي لاهي % % 10(@)(@@) % هو الذي حير الألباب واعتمدت % على براهينها من كل أواه % PageV01P1167 البحر : بسيط تام 1(@)(@@) % يا من يحيرني في ذاته أبدا % تنزيهه والذي قد جاء في الشبه % 2(@)(@@) % إن قلت ليس كذا قالت شريعته % % صدق بتنزيهه العالي وبالشبه % 3(@)(@@) % للحالتين معا الذات قابلة % فأنت لا أنت إذ يدعوك بالشبه % % 4(@)(@@) % وقد رأى كل ذي فكر وذي بصر % الفرق بين وجود التبر والشبه % PageV01P1168 البحر : بسيط تام 1(@)(@@) % % وليس من حيث ما تدعوه باللاهي % % 2(@)(@@) % الحمد لله % % بنعت سلب ولا بنعت أشباه % % 3(@)(@@) % سبحانه لا بتسبيح هويته % % ذات المسبح لكن لا تقل ما هي % % 4(@)(@@) % هوية ما لها في العين من خبر % ولا تنال بأموال ولا جاه % 5(@)(@@) % هي الغنية ما تنك طالبة % قرضا من الخلق من لاه ومن ساه % 6(@)(@@) % انظر 
ms302	 بإيمان عقل بل بفطرته % فجملة الأمر أن السر في الباه % 7(@)(@@) % هذا تولد عن هذا فوالده % هذا فيا حيرة المفتون في الله % % 8(@)(@@) % إني لأبصره في عين سادنه % % وهو المليك به الآمر الناهي % % PageV01P1169 البحر : بسيط تام 1(@)(@@) % الناس كلهمو أعداء ما جهلوا % % في مذهب الأشعريين بضدهم % % 2(@)(@@) % فيه بما ذكروه في حدودهم % لهم وغيرهم يأتي بضدهم % 3(@)(@@) % وهو الصحيح الذي اختاروه فاعتمدوا % % عليه وانظر إلى عقدي وعقدهم % PageV01P1170 البحر : بسيط تام 1(@)(@@) % الذات تشهد في المجلى وليس لنا % % حكم عليها بنعت لم يزل فيه % % 2(@)(@@) % إلا تحولها إلا تبدلها % % في كل مجلى وهذا فيه ما فيه % 3(@)(@@) % في العقل لا في نصوص الشرع فالتزموا % % قول المشرع إذ كان الهدى فيه % 4(@)(@@) % فليس من صور أدنى ولا صور % % عليا تشاهد إلا حكمها فيه % % 5(@)(@@) % فإن رأت حجرا وإن رأت شجرا % وإن رأت حيوانا كلها فيه % 6(@)(@@) % هو الوجود ولكن ما حكمت به % % فإنه عين أعيان بدت فيه % PageV01P1171 البحر : سريع 1(@)(@@) % يريد قوله تعالى : { وهو الله في السموات وفي الأرض } ، وقوله تعالى : { وهو الذي في السماء إله وفي الأرض إله } . أشهدنا من ذاتنا ذاته % % وذاك في موقفنا الأنبه % 2(@)(@@) % لو أنه يدركه خلقه % % لكان مخلوقا وأعزز به % 3(@)(@@) % مذهبنا مذهب أم لنا % % مذهب ابن العم اذهب به % % PageV01P1172 البحر : بسيط تام 1(@)(@@) % وقال أيضا : إني بليت بأمر لست أعرفه % % ولست أنكره والحكم لله % % 2(@)(@@) % جهلي به عين علمي والنعيم به % % مثل العذاب به كالمال والجاه % % 3(@)(@@) % إن قلت هو قال عين الكشف ليس بهو % % أو قلت ذا لم يوافقني سوى الله % 4(@)(@@) % فهذه حكم يدري بها حكم % % من أهملها مثل أهل الشرع في الباه % % 5(@)(@@) % فمن يوافقني فيها أوافقه % % ومن يوافق قل يا سيدي ما هي % % 6(@)(@@) % فيعتريه إذا ما قلت ذا خرس % % وهو الدليل عليه أنه ساهي % % 7(@)(@@) % فكل من في وجود الحق يعرفه % إلا الذي هو في مقصودنا لاهي % % PageV01P1173 البحر : بسيط تام 1(@)(@@) % إذا تحققت شيئا أنت تعلمه % ساويت فيه جميع العالمين 
ms303	 به % 2(@)(@@) % أقول هذا لأمر قد سمعت به % % عن واحد فطن للعلم منتبه % 3(@)(@@) % فقال ليس كما قالوه واعتقدوا % % فما لعالمنا العلام من شبه % 4(@)(@@) % وذا لجهل بما قلناه قام به % فليس في قولنا المذكور من شبه % % 5(@)(@@) % هل نسبة الذهب الإبريز في شبه % % ما صاغه الصائغ العلام من شبه % % PageV01P1174 البحر : بسيط تام 1(@)(@@) % عقلي به فوق عقل الناس كلهم % فلست أفكر في شيء أقضيه % 2(@)(@@) % تصرفي ليس عن فكر ولا نظر % لكن عن الله يوحيه فأمضيه % 3(@)(@@) % الأمر بيني وبين السر منقسم % بحاله فهو يرضني وأرضيه % 4(@)(@@) % فما يكون له من حادث قبلي % % يبغي تكونه إلا وأقضيه % % 5(@)(@@) % فليس يمكنه إلا سياستنا % % وليس يمكننا إلا ترضيه % % 6(@)(@@) % فكل ما هو فيه من مكانتنا % % وكل ما نحن فيه من مراضيه % % PageV01P1175 البحر : بسيط تام 1(@)(@@) % إني سمعت كلاما ليس يدريه % % إلا الذي سمع القرآن من فيه % 2(@)(@@) % هو الرسول الذي من جاء يطلبه % بعقله فبهذا القدر أكفيه % % 3(@)(@@) % إني رأيت له نورا يضي به % أهل السماء إذا عين توفيه % % 4(@)(@@) % من الضياء الذي فيها حقيقته % % وحقه وسوى هذا يعفيه % % 5(@)(@@) % من كان أمرضه فكر فإن له % ربا يعافيه إيمانا ويشفيه % % 6(@)(@@) % ما كان أثبته الإيمان من شبه % بالله جاء دليل الشرع ينفيه % % 7(@)(@@) % والعقل أيضا له ردء يصدقه % % في قوله فهو بر في تحفيه % 8(@)(@@) % الله يشقي فؤادي إذ رأى جسدي % % عين الصدى وهو يبكي في تشفيه % % 9(@)(@@) % لصحبة سلفت ما بين قالبه % % وبينه وهو أمر فيه ما فيه % 10(@)(@@) % لقد تنازع فيه الحاكمان معا % فالشرع يظهره والطبع يخفيه % % PageV01P1176 البحر : رمل تام 1(@)(@@) % ليس يدري ما هو الأمر سوى % % من هو الآن على صورته % 2(@)(@@) % فإذا تبصره تعلمه % % للذي يعلم من صورته % % 3(@)(@@) % إنما يبصره في ملكه % مثله يمشي على سيرته % % PageV01P1177 البحر : مخلع البسيط 1(@)(@@) % أشهد في خالقي بجوده % % ما شاءه من سنا وجوده % 2(@)(@@) % واختارني للعلوم قلبا % عناية بي على عبيده % 3(@)(@@) % وقال لي لا تكن محلا % لوارد الكون في 
ms304	 شهوده % 4(@)(@@) % فإنما جنتي وناري % % لكل رسم دارا خلوده % 5(@)(@@) % فاذكر وجودي بعين جودي % % يكن عطاء على حسوده % % PageV01P1178 البحر : طويل 1(@)(@@) % إذا كان أنهار المعارف أربعة % % على عدد الأخلاط والحكم إمعه % 2(@)(@@) % وذلك حكم الحق في حق خلقه % % فأين يكون الشخص قال أنا معه % PageV01P1179 البحر : طويل 1(@)(@@) % وليت أمور الخلق إذ صرت واحدا % عزيزا ولا فخر لدي ولا زهو % 2(@)(@@) % تركبت وجود الشفع يلزم بابه % فغيبتنا تو وحضرتنا تو % PageV01P1180 البحر : طويل 1(@)(@@) % وحق الهوى إن الهوى سبب الهوى % % ولولا الهوى في القلب ما عبد الهوى % % PageV01P1181 البحر : مجتث 1(@)(@@) % ألبست بنتي دنيا % % لباس دين وتقوى % % 2(@)(@@) % عسى أراها على ما % % قد كلف الله تقوى % % 3(@)(@@) % فإن دارك هذي % % دار اختبار وبلوى % % 4(@)(@@) % إذا شربت بنفس % ماء الحياة لتروى % % 5(@)(@@) % إن التنفس فيه % % أهنى وأمرى وأروى % % PageV01P1182 البحر : مجتث 1(@)(@@) % إن الإله الذي قد % علا وجل سموا % % 2(@)(@@) % هو الذي قلت عنه % يريد مني دنوا % % 3(@)(@@) % فلم يزل بي شفعا % ولم يزل في توا % % 4(@)(@@) % لما نفى المثل عني % % لذاك لم أك كفوا % % 5(@)(@@) % لم أتخذ قول ربي % % عند التلاوة هزوا % % 6(@)(@@) % سبحانه وتعالى % % عن الشبيه علوا % % 7(@)(@@) % ومع هذا التعالي % % قد قال يعمر حوا % % 8(@)(@@) % قد حرت في وفيه % % فلو أراد البنوا % % 9(@)(@@) % لم يستحل ذاك منه % يا رب غفرا وعفوا % % 10(@)(@@) % أنت القدير عليه % فكن بعقدي عفوا % % PageV01P1183 البحر : رمل تام 1(@)(@@) % ليس يدري الغير ما طعم الهوى % % إنما يدريه من ذاق الهوى % % 2(@)(@@) % والهوى لولا الهوى ما هويت % % نفس من ذاق الهوى غير الهوى % % 3(@)(@@) % ما هوى نجم إذا النجم هوى % % في هوى إلا من آثار الهوى % % 4(@)(@@) % أول الحب هوى نعلمه % عندنا فالعشق من حكم الهوى % % 5(@)(@@) % لا تذمن الهوى يا عاذلي % % إنما للمرء فيه ما نوى % % 6(@)(@@) % فبه كون كوني فبدا % % وبه قد فلق الحب النوى % % 7(@)(@@) % فيرى صاحبه في موصل % % ويرى عائده في نينوى % % 8(@)(@@) % فيرى الصاحب في وصلته % % ويرى العائد يشكو بالنوى % % 9(@)(@@) % وقف الحب على القلب 
ms305	 إذا % % ذاقه عند مقامات السوى % % 10(@)(@@) % وإذا خاطبه من ذاته % ما يرى خاطبه منه سوى % % PageV01P1184 11(@)(@@) % ليس للقلب اهتمام بالذي % % ناله عند المناجاة سوى % % 12(@)(@@) % قول من قال له في حكمه % % أنا في الحكم وإياك سوا % % 13(@)(@@) % ما له من خبر في علمه % % غير ما قد قاله ثم لوى % % 14(@)(@@) % عنه وجها لم يزل وجهته % % يطلب الوجه بها وأدى اللوى % % PageV01P1185 البحر : رمل تام 1(@)(@@) % إنما الماء من الماء روي % % والذي مذهبه ذا ما روي % % 2(@)(@@) % قد روت ناسخة عائشة % عند قوم جهلوا ما قد روي % % 3(@)(@@) % إنما زادت بما قد ذكرت % عين حكم وهو برهان قوي % % 4(@)(@@) % غرضي والله يوما أن أرى % % الذي بي من جواه يرتوي % % 5(@)(@@) % وإذا أبصرته لم أره % % وهو ذو شوق عليه يحتوي % % 6(@)(@@) % ما أنا في ظاهر الحرف به % % بل أنا عين الوجود المعنوي % % 7(@)(@@) % ما يرى ما قام بي من كلف % غير شخص عربي نبوي % % 8(@)(@@) % هو رمز فارسي غامض % وهو نص عند شخص علوي % PageV01P1186 البحر : طويل 1(@)(@@) % وددت بأني ما علوت كما علوا % % عليه وإني ما دنوت كما دنوا % % 2(@)(@@) % وعطلت ما عندي بما عندهم وما % % حصلت على ما حصلوه وما دروا % % 3(@)(@@) % وإنهم في كل حال ومشهد % على حكم ما ظنوه فيه وما نووا % % 4(@)(@@) % وليتهم لو قدموه وثابروا % % عليه تدلوا في النزول وما علوا % % 5(@)(@@) % ولكنهم لما تحقق جودهم % % وجودهم هدوا قواعد ما بنوا % % 6(@)(@@) % وما ذاك إلا أن في الصدق ثلمة % تخوفهم فيما رأوه وما رووا % % 7(@)(@@) % وليتهم لما تحقق كونهم % % لديهم وما اهتموا لذاك وما بلوا % % 8(@)(@@) % ولو كان غير الكون كون كونهم % % لما ابتاع أضداد الهوى ولما شروا % % 9(@)(@@) % ودادك مطلوبي وحبك مذهبي % % وعشقك صفو العيش هذا إذا صفوا % % 10(@)(@@) % وصيتهم حبل الإله تمسكوا % % به وتدانوا منهم عندما خلوا % % PageV01P1187 البحر : طويل 1(@)(@@) % وسارع إلى الخيرات سبقا فإن من % يسارع إلى الخيرات يحمد سعيه % % 2(@)(@@) % ونافس كما قد نافس الناس وارتق % رقي الذي ما زال يعصم وعيه % PageV01P1188 البحر : طويل 
ms306	 1(@)(@@) % لباسي لباس المتقين وإنني لباسي لباس المتقين وإنني % % عري من التقوى إذا كنت كاسيا % % 2(@)(@@) % دعاني منادي الحق من بين أضلعي % % فلو كان توفيق أجبت المناديا % % 3(@)(@@) % ولما رأى ترك الإجابة لم يقم % % وراح وخلى القلب في الحال خاليا % % 4(@)(@@) % ولو غير داعي الحق من الحشا % % أجاب فؤادي صوته إذ دعانيا % % PageV01P1189 البحر : طويل 1(@)(@@) % يلبي نداء الحق من كان داعيا % جزاء لما يدعو أجاب المناديا % % 2(@)(@@) % يقول تذكر ما أتى في خطابه % % وما أودع الله السنين الخواليا % % 3(@)(@@) % يرى حضرة لم تشهد العين مثلها % % يناديه أياما بها ولياليا % % 4(@)(@@) % يؤمل أمرا لم يزل قائلا به % % من الله لم يدعو له الله داعيا % % 5(@)(@@) % يحيى فيحيى من يشاء بنطقه % % لذاك تراه في المحاريب تاليا % % 6(@)(@@) % يمين له مدت لبيعة مالك % % هو العبد إلا أنه كان واليا % % 7(@)(@@) % يوليه أمر الكون فهو خليفة % وإقليده التقليد إن كنت واعيا % % 8(@)(@@) % ينزله في الأرض عبدا مسودا % سووسا عليما بالأمور وراعيا % % 9(@)(@@) % يكسر أصنام النفوس بعزمه % % من الهمة العيا خفيا وخافيا % % 10(@)(@@) % يناديه من ولاه أنت خليفتي % % على الكل مهدي المقام وهاديا % % PageV01P1190 البحر : مجتث 1(@)(@@) % إني رأيت بظني % % من كان كلبا ظبيا % % 2(@)(@@) % وكان شخصا كريما % من الأناسي سويا % % 3(@)(@@) % ولم أجيء بالذي قل % % ت فيه شيا فريا % % 4(@)(@@) % ولا تقل فيه مسخ % % تكن فتى عربيا % % PageV01P1191 البحر : مجتث 1(@)(@@) % جمعت همي عليا % % فما برحت لديا % % 2(@)(@@) % إلي يا من تعالى % % عن الكيان إليا % % 3(@)(@@) % فلم أجد غير ذاتي % % لما بسطت يديا % % 4(@)(@@) % فأسفل الكون يعلو % % وقتا بربي عليا % % 5(@)(@@) % انظر حديث هبوط % تجده فيه جليا % % 6(@)(@@) % ما جئت شيئا بقولي % % عن الإله فريا % % 7(@)(@@) % هذا حديث رسول % قد اصطفاه نبيا % % 8(@)(@@) % ولم أكن عند قولي % % إني بربي نسيا % % 9(@)(@@) % لما سريت إليه % % خرت المكان العليا % % 10(@)(@@) % ناديت مولى الموالي % % ربي نداء خفيا % % PageV01P1192 11(@)(@@) % إني ضعفت إلهي % % وصرت شيخا عتيا % % 12(@)(@@) % فلم أكن بدعائي % % إياك رب شقيا % % 13(@)(@@) % أنت الولي الذي قد % % صيرت قلبي وليا 
ms307	 % % 14(@)(@@) % فاجعلن ربي إماما % واجعلن ربي رضيا % % 15(@)(@@) % فقد ضعفت لما بي % % وذبت شيئا فشيئا % % 16(@)(@@) % سألت ربي أن لا % % يجعل لذاتي سميا % % 17(@)(@@) % قد كنت عبدا مطيعا % إذ كنت ملكا سريا % % 18(@)(@@) % أجرى لي الله جودا % من تحت عرشي سريا % % 19(@)(@@) % وأسقط الجذع قوتا % % علي رطبا جنيا % % 20(@)(@@) % فكان منه غذائي % % وعشت عيشا هنيا % % PageV01P1193 21(@)(@@) % وكان بي لطف ربي % % لذاك برا حفيا % % 22(@)(@@) % فهل رأيتم إلها % % يقوم شخصا سويا % % 23(@)(@@) % هذا محال ولكن % شاهدت أمرا نديا % % 24(@)(@@) % رأيته عين نفسي % % من حيث كنت صبيا % % 25(@)(@@) % ولم أقل بحلول % بل كنت منه بريا % % 26(@)(@@) % بل لم أجد منه بدا % لما هجرت مليا % % 27(@)(@@) % وخر جمعي إليه % % عند الشهود بكيا % % 28(@)(@@) % فكنت أولى بنار % للشوق فيها صليا % % 29(@)(@@) % إني خلصت إليه % لما اقتربت نجيا % % PageV01P1194 البحر : بسيط تام 1(@)(@@) % ذنبي عظيم وذنبي لا يزايلني % % وليس ذنبي سوى حبي لمولايا % % 2(@)(@@) % لولاي ما كنت في سر أسر به % عن الحبيب الذي يدرون لولايا % % 3(@)(@@) % هو النعيم لقلبي والعذاب له % % إذا تجلى لنا بدار دنيايا % % 4(@)(@@) % وهو النعيم الذي لا صد يعقبه % % إذا بدا لي في موتي وأحيايا % % 5(@)(@@) % وفي الكثيب وفي عدن وقد علمت % نفسي بأن كثيب الزور مثوايا % % 6(@)(@@) % إذا تحققت بالمعنى وكان لنا % % ملكا نصرفه فالحق معنايا % % 7(@)(@@) % به أكون عميدا خاضعا وبه % % أكون صاحب تمليك بعقبايا % % 8(@)(@@) % والله لو نظرت عيناي من أحد % % سواه ما برحت تبكيه عينايا % % 9(@)(@@) % إنا إلى الله بدءا عند نشأتنا % % وفي البرازخ مشهودا بأخرايا % % PageV01P1195 البحر : وافر تام 1(@)(@@) % جزاك الله خيرا من ولي % عليم بالخفي وبالجلي % 2(@)(@@) % رعاك الله من شخص تعالى % % عن الأمثال بالنعت العلي % 3(@)(@@) % صدوق الوعد أنزله كتابا % فإسماعيل ذو الخلق الرضي % PageV01P1196 البحر : وافر تام 1(@)(@@) % لكيوان الثبات بغير شك % كما للمشتري علم النبي % 2(@)(@@) % وللمريخ أرماح طوال % إذا اجتمع الكمي مع الكمي % 3(@)(@@) % وللشمس الأمانة في مكان % كما قال الإله لنا علي % 4(@)(@@) % وللزهراء ميل هوى وحب % % فويل للشجي من الخلي 
ms308	 % 5(@)(@@) % ونش عطارد مريخ لطف % % يضم به العي إلى الدني % 6(@)(@@) % بأمر البدر يكتب ما أردنا % % إلى الداني المقرب والقصي % 7(@)(@@) % ويقطع في بروج معلمات % يكن لسيرها حرف الروي % 8(@)(@@) % فمن حمل إلى ثور ويعلو % % إلى الجوزاء في الفلك البهي % % 9(@)(@@) % إلى السرطان من أسد تراه % بسنبلة لميزان الهوي % 10(@)(@@) % وعقرب صدغه يرمي بقوس % من النيران من أجل الجدي % PageV01P1197 11(@)(@@) % ليشويه فيطفيه بدلو % % كحوت دلالة العبد النجي % 12(@)(@@) % وليس لهذه الأبراج عين % من الأنوار في النظر الجلي % 13(@)(@@) % ولكن المنازل عينتها % % من الفلك المكوكب للخفي % 14(@)(@@) % فمنزلتان مع ثلث لبرج % كتقسيم المراتب في الندي % 15(@)(@@) % وبان لكل منزلة دليل % من الأسماء عن نظر خفي % 16(@)(@@) % كنطح في بطين في ثريا % % إلى الدبر إن هقعته تحي % 17(@)(@@) % ذراعا عند نثرة طرف شخص % بجبهته زبرت على بني % 18(@)(@@) % لتعلمه بصرفته فمالت % بعواء السماءك على ولي % 19(@)(@@) % غفرن له زبانات بأمر % من الإكليل عن قلب تقي % 20(@)(@@) % فجادت شولة صادت ناما % ببلدتها لكل فتى تقي % PageV01P1198 21(@)(@@) % وذابحها يخبرها بما قد % % بدا في العجل من سر الحلي % 22(@)(@@) % فتبلعها السعود على شهود % من أخيية وأدلاء الشقي % 23(@)(@@) % مقدمها مؤخرها لفرغ % يدليه الرشاء إلى الركي % 24(@)(@@) % ليسقي زرعه كرما وجودا % ليقري بالغداة وبالعشي % PageV01P1199 البحر : وافر تام 1(@)(@@) % وعيوقاتها تهدي إلينا % % إذا أخفيت لذي الرصد الذكي % 2(@)(@@) % نجوم الرجم أرسلها إلهي % % لتحرق كل شيطان غوي % 3(@)(@@) % وتظهر بالأثير من اشتعال % فتهوي بالهواء إلى الغبي % 4(@)(@@) % فتحرقه فيذهب ما لديه % من العلم المحقق بالهوي % 5(@)(@@) % هي النيران في الأبصار نور % كماء شراب ظمآن شقي % % 6(@)(@@) % فسبحان العليم بكل شيء % وموحيه إلى قلب الولي % PageV01P1200 البحر : مجزوء المديد 1(@)(@@) % نحن سر الأزلي % بالوجود الأبدي % 2(@)(@@) % إذ ورثنا خلق الظا % % هر فينا الهاشمي % 3(@)(@@) % واعتلينا واستوينا % % بالمقام القدسي % 4(@)(@@) % ووهبنا ما وهبنا % % سر بدر الحبشي % 5(@)(@@) % وبعثناه رسولا % للرئيس الندسي % 6(@)(@@) % بكتاب رقمته % % كف ذات الحكمي % 7(@)(@@) % بعلوم وسمتها % % ل الوجود العملي % 8(@)(@@) % ومطالع هلا % % 9(@)(@@) % حرض الناس على ني 
ms309	 % % 10(@)(@@) % ونهايات التلقي % % بالمقام الخلقي % PageV01P1201 11(@)(@@) % ومشت أسماء ذاتي % % في وضيع وعلي % 12(@)(@@) % فالذي آمن منهم % % لم يزل حيا بحي % 13(@)(@@) % والذي أعرض منهم % % لم يفز منا بشي % % PageV01P1202 البحر : مجزوء الرمل 1(@)(@@) % اختلسنا من كرامات % الكيان الأبدي % % 2(@)(@@) % وجينا بمقامات % العيان الأزلي % 3(@)(@@) % ورفعنا عن تكاليف % الوجود العملي % 4(@)(@@) % لمضاهاة استواء % % فوق عرش فلكي % 5(@)(@@) % فرأينا من تعالى % % بالوجود الخلقي % % 6(@)(@@) % في لطيف ملكي % وكثيف بشري % 7(@)(@@) % وسألناه بأسرار % ر المقام القدسي % PageV01P1203 البحر : بسيط تام 1(@)(@@) % سمعت من ليس يدري ما يقول به % % قد قال في الله إن الكل هو وإليه % % 2(@)(@@) % إن الإله بعين الحق أنطقه % بما هو الأمر فيما قال فيه عليه % PageV01P1204 البحر : رمل تام 1(@)(@@) % إن سري هو روح كل شيء % % وهو الظاهر في ميت وحي % 2(@)(@@) % فإذا قام بحي فأب % وإذا قام بميت فبني % % 3(@)(@@) % إنه جل عن إدراك الذي % % قال فيه إنه في كل شي % % 4(@)(@@) % إنما هو عينه فاعتبروا % % تجدوا ما قلت في نشر وطي % % 5(@)(@@) % ما تغالي كونه عن حالة % ظهرت في مد ظل ثم في % 6(@)(@@) % إنما الأمر الذي يسعدكم % % أو نقيض السعد في رشد وغي % % 7(@)(@@) % إنما خص بقوم للذي % % كان فيهم من ذكاء ثم عي % 8(@)(@@) % قد أكلناه طبيخا ولقد % % جاءني لحما طريا وهو ني % 9(@)(@@) % فأبينا أكله حين بدت % صورة الإيمان فيه من قصي % % 10(@)(@@) % يا أخي فاعلم الأمر الذي % % قلته فيه بحق يا أخي % % PageV01P1205 11(@)(@@) % فخذوه أسدا أو حملا % واتركوا السنبل يرعاه الجدي % % 12(@)(@@) % إنما الأمر عظيم قدره % % جل عندي حين جلاه إلي % 13(@)(@@) % قلت ضمني ذاتي وأنا % % أوصل المقدار مني وعلي % 14(@)(@@) % قال لا يمكن إلا هكذا % % هو فعل الشيخ لا فعل صبي % % 15(@)(@@) % لو أراد الأمر أن يخرجه % لم يكن هذا من يدي % % 16(@)(@@) % لي منه الشرب ما دام وما % % دمت ما عندي لشربي منه ري % % 17(@)(@@) % لست أدري إننى عبد هوى % % إذ تجلى لي في شكل رشي % 18(@)(@@) % فتغزلت وما أضمره % % وبدا يغشى سناه ناظري 
ms310	 % % PageV01P1206 البحر : بسيط تام 1(@)(@@) % إني رأيت وجودا لا أسميه % فكل شيء تراه فهو يحويه % 2(@)(@@) % له الإحاطة بالأشياء أجمعها % % فكل عين تراها أنها فيه % 3(@)(@@) % حصلت من فكرتي فيه على تعب % ولم أجد حجة تبدو فأبديه % 4(@)(@@) % حصلت منه على عمياء مجهلة % بهماء خالية في مهمه التيه % % 5(@)(@@) % أرنو إليه ولا أدريه فانبهمت % % علي حالته وكلها هو هي % % 6(@)(@@) % به خلوت وما بالدار من أحد % % إذ الوجود الذي ما زلت أبغيه % % 7(@)(@@) % إني أنا وصفه النفسي فاعتبروا % % إن زلت زال بهذا النعت أدريه % % 8(@)(@@) % كظل جسمي متى أن كنت ذا نظر % في نشأتي وهو مجلى من مجاليه % % PageV01P1207 البحر : بسيط تام 1(@)(@@) % من لم يزل بامتثال الشرع يطلبني % % ما زلت أطلبه شرعا وأبغيه % % 2(@)(@@) % حتى رأيت الذي طلبت منه على % % ترتيب ما لم أطق بالعقل ألغيه % % 3(@)(@@) % العبد لولا تجلي الحق في صور % % شتى لكان دليل العقل يطغيه % % 4(@)(@@) % لأنه بدليل العقل يطلبه % % والشرع ينقض ما الأفكار تبنيه % 5(@)(@@) % فكل عين بعلم الحق تعبده % % فإن ذلك فيهم من تحليه % PageV01P1208 البحر : بسيط تام 1(@)(@@) % لما رأيت وجودي في تجليه % رأيت ما كنت أبغيه وأنفيه % 2(@)(@@) % فما رأيت وجودا كنت أظهره % % إلا رأيت وجودا منه أخفيه % % 3(@)(@@) % إذا علمت بهذا واتصفت به % % علمت أن له عهدا يوفيه % % PageV01P1209 البحر : موشح 1(@)(@@) % عد عن جنات عدن % % وارتسم في الصدر الأول % 2(@)(@@) % تخفض القسط وترفع % وتولى ثم تعزل % 4(@)(@@) % بابي معنى شريف % % بابي معنى غريب % % 5(@)(@@) % بيته بيت كثيف % % حجبت فيه الغيوب % 6(@)(@@) % حكمه فيه لطيف % رأيه فيه مصيب % 7(@)(@@) % بطل خلف مجن % امتطى أغر أرجل % 8(@)(@@) % فترى المتلالي الأترع % % تحته السماك الأعزل % % 10(@)(@@) % أظهفر العقل النفيس % نفس غيب المتمنى % % 11(@)(@@) % فهو الملك الرئيس % % وهي ملك ليس يفنى % % 12(@)(@@) % وجد الجسم الخسيس % أحرفا جاءت لمعنى % % PageV01P1210 13(@)(@@) % وعنى بذاك غني % % وأنا لا أتبدل % % 14(@)(@@) % ثم أخفاه وأودع % أمره الإمام الأعدل % % 16(@)(@@) % أشرقت شمس المعاني % % بقلوب العارفينا % % 17(@)(@@) % أشرفت أرض المثاني % % فتنة للسالكينا % % 18(@)(@@) % وبدا سر المثاني % % لعيون 
ms311	 الناظرينا % % 19(@)(@@) % إذ خفى في نشر كوني % % نوره لما تنزل % 20(@)(@@) % لسراج ليس يسطع % بمثال ليس يهمل % 22(@)(@@) % حضرة العلي زين % % ومقام الوارثينا % % 23(@)(@@) % جدول بها معين % % لذة للشاربينا % % 24(@)(@@) % فهي الصبح المبين % % تجعل الشك يقينا % % PageV01P1211 25(@)(@@) % وهي تجلو كل دجن % % مع بقاء الوبل والطل % 26(@)(@@) % فسناها الوتر الأرفع % من سنا المهاة أجمل % % 28(@)(@@) % يا لطيفا بالعباد % % أرني أنظر إليكا % % 29(@)(@@) % قال زل عن كل واد % % يعقد الأمر عليكا % % 30(@)(@@) % ما أنا غير المنادي % % فالتفت لناظريكا % % 31(@)(@@) % كيف لا وأنت مني % % بمكان السر الأكمل % 32(@)(@@) % فبمع الحق تسمع % وبأمر الأمر ينزل % % PageV01P1212 البحر : - - 1(@)(@@) % تاهت على النفوس القلوب % فسر عاذل ورقيب % 2(@)(@@) % % % 3(@)(@@) % في سبح اسم ربك الأعلى % % 3(@)(@@) % في الفنا عن فنائي % % 4(@)(@@) % غصن زها فعز وجلا % % 5(@)(@@) % سواه كالحسام المحلى % % 6(@)(@@) % فيممت حماه الغيوب % وأشعلت هناك حروب % 6(@)(@@) % حقا أقول يا غافلين % % 8(@)(@@) % في الطور طار عني فؤادي % % 8(@)(@@) % لله ما أحلى % % PageV01P1213 9(@)(@@) % فلم أزل عليه أنادي % % 9(@)(@@) % بالمنظر الأعلى % % بقديم العنايه % 10(@)(@@) % أضنان هجرك المتمادي % % 11(@)(@@) % فقال لي الوصال قريب % يا أيها الصفي الحبيب % 13(@)(@@) % يبدو سر الردآء % % 13(@)(@@) % في النجم صح لي العرش ملكا % % 14(@)(@@) % عليله يوسى . . . ما مرضا % % 14(@)(@@) % وقيل خذه قهرا وملكا % % 15(@)(@@) % فقمت فيه عبدا وملكا % % 16(@)(@@) % فمن سماه زهر تصوب % ومن ثراه زهر يطيب % PageV01P1214 18(@)(@@) % في الحجر حجر عبد تولى % % 18(@)(@@) % من غدا لله برا تقيا % % 19(@)(@@) % عن سر نور علم تجلى % % 20(@)(@@) % فحاز سبعة ليس إلا % % 21(@)(@@) % منها بدا وفيها يغيب % يصاب تارة ويصيب % 23(@)(@@) % وغدا الروح حيا % % 23(@)(@@) % في لم يكن أتاني الرسول % % 24(@)(@@) % فلاح في المحيا السبيل % % 25(@)(@@) % وكان لي بذاك دليل % % 26(@)(@@) % إن الوجود سر عجيب % يدعو لنفسه ويجيب % PageV01P1215 البحر : موشح 1(@)(@@) % سألت جود فالق الإصباح % هل لي من سراح % % 3(@)(@@) % فقال لا فإنك معلول % % 4(@)(@@) % وعن أمور ملكك مسؤول % % 5(@)(@@) % ما كل قائل هو مقبول % % 6(@)(@@) % قد جاءت الجسوم والأرواح % تسعى في الرواح % % 8(@)(@@) % من قال بالتقابل يلقاه 
ms312	 % % 9(@)(@@) % وفي براعة الخصم لاقاه % % 10(@)(@@) % من كان مثله ما توقاه % % 11(@)(@@) % قلنا له فهذه الأشباح % ضيق وانفساح % 13(@)(@@) % ليس النديم من دان بالعقل % % PageV01P1216 14(@)(@@) % إن النديم من دان بالنقل % % 15(@)(@@) % أقول كلما قال لي قل لي % % 16(@)(@@) % إملا له وصفف الأقداح % في البيت الضراح % 18(@)(@@) % في الراح راحة الروح يا صاحي % % 19(@)(@@) % فقل بها مقالة إفصاح % % 20(@)(@@) % ما بين عاذلين ونصاح % % 21(@)(@@) % والله ما على شارب الراح % % فيه من جناح % % 23(@)(@@) % فاح الندى من عرف محبوبي % % 24(@)(@@) % إذ كان ما بدا منه مطلوبي % % 25(@)(@@) % فصحت يا مناي ومرغوبي % % PageV01P1217 26(@)(@@) % حبيبي إن أكلت التفاح % جيء واعمل لي آح % % PageV01P1218 البحر : موشح 1(@)(@@) % رأيت سما لاح بأفق مبين % % من العلم الفرد % 3(@)(@@) % ولما ارتدى % % بالبردة المثلى % % 4(@)(@@) % هلال بدا % % بالأفق الأعلى % % 5(@)(@@) % طعمت الهدى % % بالمورد الأحلى % % 6(@)(@@) % وما أنا فيما ذقته بالظنين % لعلمي بالقصد % 8(@)(@@) % سمعت الصدا % % من طور سيناء % 9(@)(@@) % وعندي صدا % % الماء زيراء % 10(@)(@@) % فقال الصدا % % ينبىء أبناء % % 11(@)(@@) % ليعلم ما جئت به بعد حين % من الصدق للوعد % 13(@)(@@) % تمنيت أن % % أشهد بالله % % PageV01P1219 14(@)(@@) % ولم أعلمن % % أن به جاهي % % 15(@)(@@) % فقلت لمن % % خص بانباهي % % 16(@)(@@) % لقد علم الروح الخبير الأمين % بما لكم عندي % % 18(@)(@@) % وفيت لكم % بالعهد أزمانا % % 19(@)(@@) % وكان بكم % ذاك الذي كانا % % 20(@)(@@) % وما قلتكم % % صدقا وإيمانا % 21(@)(@@) % إذا كان مثلي في هواكم يخون % % فمن يوفي بالعهد % % 23(@)(@@) % رجوت وصالا % والنوى يردي % % 24(@)(@@) % طلبت اتصالا % قال يا بعدي % % 25(@)(@@) % فأنشدت حالا % للذي عندي % % PageV01P1220 26(@)(@@) % أحين رجوت الوصل منكم أحين % % أعذب بالصد % PageV01P1221 البحر : موشح 1(@)(@@) % هذا الوجود العام % % علمي به أولى % % 2(@)(@@) % لأنه إنعام % % من سيد مولى % % 3(@)(@@) % ويومه من عام % % في الشمس إذ تجلى % % 4(@)(@@) % ترى البصير بلا نصير يعطي البشر % إذا عفا % % 5(@)(@@) % وحكمهم % % وما أنا % % 9(@)(@@) % أنشأت ناقوسا % % لذكره الزاهر % % 10(@)(@@) % ماوي الأولى % % ماذا ترى العبر % % 11(@)(@@) % ولم أكن عيسى % % بلا نصير % % 16(@)(@@) % أبدى لي الله % حصر إلى % % 17(@)(@@) % إن الفهوم % % من الصدا % % PageV01P1222 18(@)(@@) % قوم به 
ms313	 باهوا % % فانظر ترى % % 20(@)(@@) % بعلإني أنا % % 21(@)(@@) % عين المحفقل لمن يقول بالأولى % % 24(@)(@@) % هذا الذي قلنا % % الحق أبداه % 25(@)(@@) % إلا بكن % % ولم نقل ما هو % % 26(@)(@@) % هذي الرسوم % % فسالت أمواه % 27(@)(@@) % عين من كل ما يبلى ولا يبلى % % 32(@)(@@) % % في زعمهم % % 33(@)(@@) % ولي بذا عهد % الفقر والذنب % 34(@)(@@) % من قربه بعد % وبعده قرب % PageV01P1223 البحر : موشح 1(@)(@@) % السر مني % % كافي من أني % % 3(@)(@@) % رأيت ربي % % بالمنظر الأجلى % % 4(@)(@@) % دعوت صحبي % % للمورد الأحلى % % 5(@)(@@) % رآه قلبي % % في الصورة المثلى % % 6(@)(@@) % فما ثني % % فقال خدني % % 8(@)(@@) % إلى الكثيب % دعتني أشواقي % % 9(@)(@@) % نحو الحبيب % دعاء مشتاق % 10(@)(@@) % فيا طبيبي % % هل لي من راق % 13(@)(@@) % رأيت صوني % % يطلبه كوني % % 14(@)(@@) % وقال عيني % % إن به عوني % % PageV01P1224 15(@)(@@) % وليس بيني % % عنه سوى بيني % % 16(@)(@@) % فقال أين % قلت إذا تثنى % % 18(@)(@@) % من لي بذاتي % % من لي بإيلافي % % 19(@)(@@) % وفي مماتي % % حكم لإيلافي % % 20(@)(@@) % فقلت آتي % % قال بأوصافي % % 21(@)(@@) % إياك أعني % % بالذكر إذ أكني % % 23(@)(@@) % من كان مثلي % % يبلى ولا يبلي % % 24(@)(@@) % فقا كلي : % إنك من أهلي % % 25(@)(@@) % قد قال قبلي : % من ليس من شكلي % % 26(@)(@@) % أخلفت ظني % % يا كعبة الحسن % PageV01P1225 البحر : موشح 1(@)(@@) % كل شيء بقضاء وقدر % % هكذا المعلوم % 2(@)(@@) % والذي يقضي به حكم النظر % % سره مكتوم % 4(@)(@@) % كل من أشهده سر القدر % ربه يعلم % 5(@)(@@) % إن بالحكم الذي فيه ظهر % % عينه يحكم % 6(@)(@@) % عجبا فيمن له نعت البشر % % وهو لا يفهم % 7(@)(@@) % والذي يشهده نور القمر % % فهو المرحوم % 8(@)(@@) % والذي عيب عنه واستسر % ذلك المحروم % 10(@)(@@) % شاهد النقل الذي حيرني % % وبه أحيا % % 11(@)(@@) % ودليل العقل قد صيرني % % منكرا أشيا % % 12(@)(@@) % فتراني عندما خيرني % % أكره المحيا % % PageV01P1226 13(@)(@@) % فأنا ما بين عقل وخبر % % ظالم مظلوم % 14(@)(@@) % فإذا سرحت من سجن الفكر % % قمت بالقيوم % 16(@)(@@) % بالتجلي في التدلي قلت به % فأبى عقلي % % 17(@)(@@) % والتجلي في التحلي منه به % % قال لي قل لي % % 18(@)(@@) % انت مني عين ظلي فانتبه % % ما الهوى من لي % % 19(@)(@@) % إن جرى الأمر على حكم البصر % % قلت 
ms314	 بالمفهوم % 20(@)(@@) % أو جرى الأمر على حكم العبره % % ينتفي المرسوم % 22(@)(@@) % لو أن ما بي من شؤون العباد % وكل ما يجري % % 23(@)(@@) % يكون بالسبع الطباق الشداد % يسكن عن دور % 24(@)(@@) % إن الذي كان مسبي مراد % % لصاحب الأمر % % PageV01P1227 25(@)(@@) % الصبر أولى بي من أجل الظفر % % وإنه موهوم % 26(@)(@@) % فاشرب رحيقا عند وقت السحر % مزاجه تسنيم % % 28(@)(@@) % بساحل البحر رأيت التي % % ما زلت ألغيها % % 29(@)(@@) % فقلت للنفس ترى قبلتي % % بالله أبغيها % % 30(@)(@@) % فأنشدت تخبر عن جملتي % % وذاك يطعيها % % 31(@)(@@) % ليتني رمل على شط البحر % % يا ابني أو أطوم % 32(@)(@@) % وترى عيني مذ تطلع سحر % % لبلاد الروم % % PageV01P1228 البحر : موشح 1(@)(@@) % % فعالا % % 2(@)(@@) % كأنه الصبح المبين % % جوالا % % 2(@)(@@) % دور % % 3(@)(@@) % دور % % 4(@)(@@) % لما دعاه الهوى % % إلى الذي ذكرته % 5(@)(@@) % أوهن مني القوى % % ذاك الذي سمعته % % 6(@)(@@) % من ساكني نينوى % % وذوقهم قد ذقته % 9(@)(@@) % دور % % 10(@)(@@) % على قليب أمر % قلبي إليه ليرى % % 11(@)(@@) % أمرا إليه سعى % % يطلبه عند السرى % % PageV01P1229 12(@)(@@) % فكان نعم الوعا % % لما إليه قد سرى % % 15(@)(@@) % دور % % 16(@)(@@) % المورشان حكما % % عليهما النار التي % % 17(@)(@@) % تفنيهما إذ هما % % ضدان فانظر حكمتي % % 18(@)(@@) % سيلهما قد طما % % رؤيا من الوحي المبين % % 21(@)(@@) % دور % % 22(@)(@@) % لما أتى طالبا % وفي مجاري العبر % % 23(@)(@@) % ولى به هاربا % رب الندى والندا % % 24(@)(@@) % فجاءه غالبا % تاج على الراس بدا % % 27(@)(@@) % دور % % PageV01P1230 28(@)(@@) % بحر العمى في عمى % % يدري بذاك المرتدى % % 29(@)(@@) % وجاء مستفهما % فيما به الوحي بدى % % 30(@)(@@) % أوضحت ما أبهما % % في ناشد أو منشد % PageV01P1231 البحر : موشح 1(@)(@@) % % من غدا الله برا تقيا % % 6(@)(@@) % لاح شيئا فشيئا % % 9(@)(@@) % وفني عين نفسي % % 12(@)(@@) % % للكبير المتعالي نجيا % % 17(@)(@@) % تتوالى عليا % % 24(@)(@@) % في الفنا عن فنائي % % 37(@)(@@) % وأخذ من يديا % % يلوح من فوق الجبين % PageV01P1232 البحر : موشح 1(@)(@@) % ياطالب العلم بالأسرار % هيهات لا تكشف الأسرار % 3(@)(@@) % إلا لمن أخذ القزديرا % % 4(@)(@@) % ودس في ذاته الإكسيرا % % 5(@)(@@) % ليقلب العين والتصويرا % % 6(@)(@@) % شمسا تلوح لذي الأبصار % وليس تدركها الأبصار % % 8(@)(@@) % يا سائلي عن مقام الروح % % 9(@)(@@) % وهل تضاهي 
ms315	 لنور يوح % % 10(@)(@@) % أسلك هديت سبيل نوح % % 11(@)(@@) % ما زال يولع بالأنوار % حتى تجلت له الأنوار % 13(@)(@@) % لما رأيت بها إدريسا % % PageV01P1233 14(@)(@@) % شبهته بالنبي عيسى % % 15(@)(@@) % محبي الصدا وأخاه موسى % % 16(@)(@@) % يهدي إلى منزل الأبرار % % ما تشتهيه به الأبرار % 18(@)(@@) % لما تحققت بالإيثار % % 19(@)(@@) % وقد تلاعبت بالأهواء % % 20(@)(@@) % تلاعب الفعل بالأسماء % % 21(@)(@@) % % علمت ما أعطت الإيثار % % 23(@)(@@) % يا سائلي أين حظ الجسم % % 24(@)(@@) % وروحه من حظوظ الرسم % % 25(@)(@@) % فقال لي حظه في الإسم % % PageV01P1234 26(@)(@@) % من يبتغي العلم بالأفكار % حارت في مطلبه الأفكار % % PageV01P1235 البحر : موشح 1(@)(@@) % متيم بالجمال قد شغفا % % فيا إخوان % % 5(@)(@@) % دور % % PageV01P1236 البحر : موشح 1(@)(@@) % أطوالي المهيمن الطرقا % % عساك يوما نحوها ترقى % % 3(@)(@@) % عزيزة الإنسان قد ذلت % % 4(@)(@@) % أهلة الأسرار قد جلت % % 6(@)(@@) % وصيرت قلبي له شرقا % % وأضلعي لبدرها أفقا % % 8(@)(@@) % اخرق سفين الحس يا نائم % % 9(@)(@@) % واقتل غلاما إنك الحاكم % % 10(@)(@@) % ولا تكن للحائط الهادم % % 11(@)(@@) % وافتق سموات العلى فتقا % وارتق أراضي جسمها رتقا % % 13(@)(@@) % سفينة الإحساس أخرقها % % 14(@)(@@) % وعروة الشيطان أوثقها % % PageV01P1237 15(@)(@@) % وصورة الإنسان أطلقها % % 16(@)(@@) % وهم بها في ذاته عشقا % % وناده رفقا بها رفقا % % 18(@)(@@) % خليفة الرحمن قد جلا % % 19(@)(@@) % عن أن يرى بالسجن قد حلا % % 20(@)(@@) % أو مدبرا عنه إذا ولى % % 21(@)(@@) % قد أحكم الله به الخلقا % % فجل أن يحول أو يشقى % % 23(@)(@@) % يا سائل عن كنه ما أجمل % % 24(@)(@@) % من حب مولى لم يزل يحمل % % 25(@)(@@) % فقمت أشدوه كما أنزل % % 26(@)(@@) % ألقى الهوى بالقلب ما ألقى % % فلا تسل عن كنه ما ألقى % % PageV01P1238 البحر : - 1(@)(@@) % يا طالب التحقق انظر وجودك % ترى جميع الناس عبيد عبيدك % % 3(@)(@@) % قعدت في ساحل % البحر الأخضر % % 4(@)(@@) % أرمت لي أمواجه % % الدر الأزهر % 5(@)(@@) % فقلت لا تفعل % ما ليس % % 6(@)(@@) % وارم فيه تطلع إلى محيدك % % 8(@)(@@) % أرمات لي فالحين % % مع در أكهب % % 9(@)(@@) % فقلت أوفيني % % عنبرك الأشهب % 10(@)(@@) % قالت نعم إن كان % تعمل لي مركب % % 11(@)(@@) % من عودك الفواح وخذ نزيدك % % 11(@)(@@) % فجسمي فيكم جسم مكبوت % وروحي فيه روح مبخوت % PageV01P1239 13 
ms316	(@)(@@) % زبرجدك أخضر % ومسك أذفر % % 14(@)(@@) % ودرياق الأكبر % % الله أكبر % % 15(@)(@@) % فأنا والمطلوب % % وقال وعزر % % 16(@)(@@) % لمن تروني قل إليك نريدك % % 18(@)(@@) % وأمشي على الساحل % وأطلب وافتش % % 19(@)(@@) % ياقوتي الأحمر % % لعل تنعش % % 20(@)(@@) % فإن لقيت إنسان % % أعمى أو أعمش % % 21(@)(@@) % وقال : لمن تطلب فقل لسيدك % % 23(@)(@@) % يا طالب الصنعة % دبر حياتك % 24(@)(@@) % وانظر إلى الإكسير % % على صفاتك % PageV01P1240 25(@)(@@) % تجده من ذاتك % % يسري لذاتك % % 26(@)(@@) % مربع التركيب على وجودك % % 28(@)(@@) % كبريتك الأحمر % % لقد معلوم % % 29(@)(@@) % وهو على التحقيق % % أجل معدوم % % 30(@)(@@) % خفي ظهر للعين % % مرموز ومفهوم % % 33(@)(@@) % % لا بد يندم % % 34(@)(@@) % ويعمل الحيله % % ولا يفيد ثم % % 35(@)(@@) % فقلت قال قبلك % % من قد تقدم % % PageV01P1241 البحر : - - 1(@)(@@) % ألا بأبي من ضمه صدري % % وأدريه قطعا وهو لا يدري % % 3(@)(@@) % لقد أقسم الحق بما أقسم % % 4(@)(@@) % وعلمنا مالم تكن نعلم % % 5(@)(@@) % وأوضح لي ما كان قد أبهم % % 6(@)(@@) % فأقسم بالشفع وبالوتر % فأثبت عيني عند ذي حجر % 8(@)(@@) % لقد صح لي من كنت أبغيه % % 9(@)(@@) % وأثبته وقتا وأنفيه % % 10(@)(@@) % وقلت لمن قد جاء يطغيه % % 11(@)(@@) % لقد مر بي الليل إذا يسري % % بحالة عسر الكون في يسر % 13(@)(@@) % نظرت إليه نظر العين % % PageV01P1242 14(@)(@@) % بأكمل وصف يقتضي كوني % % 15(@)(@@) % وفي كشفه أردية الصون % % 16(@)(@@) % وقد خط بالأمر الذي تدري % % من قدر الذي سورة القدر % 18(@)(@@) % وليلة قدر ما لها صبح % % 19(@)(@@) % ينزل فيها النصر والفتح % % 20(@)(@@) % على قلب عبد نعته الشرح % % 21(@)(@@) % ينزل فيها عالم الأمر % % والروح إلى مطلع الفجر % 23(@)(@@) % لو أن الذي أشهدت في الجهر % % 24(@)(@@) % وأعطيته في الشأن والأمر % % 25(@)(@@) % يلوح لذي الطور من الستر % % PageV01P1243 26(@)(@@) % أكلم في النار الذي تدري % % وصيره فغي قبضة الأسر % 28(@)(@@) % وجارية باتت تغنيه % % 29(@)(@@) % وتومي إلى الغير وتعنيه % % 30(@)(@@) % وما تبتغي إلا تعنيه % % 31(@)(@@) % أجر ذيلي أيما جر % فأوصل منك السكر بالشكر % PageV01P1244 البحر : - - 1(@)(@@) % للإله الحق % % 4(@)(@@) % همتي في السبق % % 5(@)(@@) % بخيول الصدق % % 8(@)(@@) % من حلوم جلت % % 9(@)(@@) % في قلوب صلت % % 10(@)(@@) % عن هواها ولت % % 11(@)(@@) % لم تنل بالإملاق % إلا 
ms317	 الذي عندها من إشفاق % 13(@)(@@) % هو فضل منه % % 14(@)(@@) % قد أخذنا عنه % % 15(@)(@@) % إن يكن هو كره % % PageV01P1245 16(@)(@@) % واعتمد في الأرزاق % على الإله الكريم الخلاق % 18(@)(@@) % يا إله الخلق % % 19(@)(@@) % إن عدلت استبق % % 20(@)(@@) % فأنا في المحق % % 21(@)(@@) % فلتجد بالإنفاق % بقدر ما عندنا من إملاق % 23(@)(@@) % حكمته الديهور % % 24(@)(@@) % ظهرت من طور % % 25(@)(@@) % عند فقد النور % % 26(@)(@@) % لولا حكم الإشفاق % ما ظهرت حكمة للاشراق % % PageV01P1246 البحر : - - 1(@)(@@) % إن الذي سمت به الأرواح % نافث في الأرواح % % 4(@)(@@) % إن مت من يكون له بعدي % % 6(@)(@@) % % إذا الشوق باح % 9(@)(@@) % استغفر الله من ذنبي ومن سرفي % % 11(@)(@@) % عند الذي يجود بالأفراح % هل لها من أنس % % 12(@)(@@) % وللحوادث ساعات مصرفة % فيهن للحين إدناء وإقصاء % 13(@)(@@) % كل ينقل في ضيق وفي سعة % إن الذي سمت به الأرواح % 14(@)(@@) % فلتقل من أجلي % % 16(@)(@@) % يا صاح هل رأيت من ارتاح % % واردات الأفراح % % 21(@)(@@) % بنفخنا أنارت الأشباح % % إن روح القدس % % PageV01P1247 26(@)(@@) % صل يا منى المتيم من راح % % مقصوص الجناح % PageV01P1248 البحر : بسيط تام 1(@)(@@) % ما رحلوا يوم بانوا البزل العيسا % % إلا وقد حملوا فيها الطواويسا % % 2(@)(@@) % من كل فاتكة الألحاظ مالكة % تخالها فوق عرش الدر بلقيسا % % 3(@)(@@) % إذا تمشت على صرح الزجاج ترى % % شمسا على فلك في حجر أدريسا % % 4(@)(@@) % تحيى ، إذا قتلت باللحظ منطقها % % كأنها عندما تحيى به عيسى % % 5(@)(@@) % توراتها لوح ساقيها سنا وأنا % % أتلو وأدرسها كأنني موسى % % 6(@)(@@) % أسقفة من بنات الروم عاطلة % ترى عليها من الأنوار ناموسا % % 7(@)(@@) % وحشية ما بها أنس قد اتخذت % في بيت خلوتها للذكر ناووسا % % 8(@)(@@) % قد اعجزت كل علام بملتنا % % وداوديا ، وحبرا تم قسيسا % 9(@)(@@) % إن أومأت تطلب الإنجيل تحسبها % % أقسة أو بطاريقا شماميسا % % 10(@)(@@) % ناديت ، إذ رحلت للبين ناقتها : % يا حادي العيس لا تحدو بها العيسا % % PageV01P1249 11(@)(@@) % عبيت أجياد صبري يوم بينهم % على الطريق كراديسا كراديسا % % 12(@)(@@) % سألت إذ بلغت نفسي تراقيها % % ذاك الجمال وذاك اللطف تنفيسا % % 13(@)(@@) % فأسلمت ، ووقانا الله شرتها ، % وزحزح الملك المنصور إبليسا % % PageV01P1250 البحر : طويل 1(@)(@@) % خليلي 
ms318	 عوجا بالكثيب وعرجا % % على لعلع ، واطلب مياه يلملم % 2(@)(@@) % فإن بها من قد علمت ، ومن لهم % % صيامي وحجي واعتماري وموسمي % % 3(@)(@@) % فلم انس يوما بالمحصب من منى % وبالمنحر الأعلى أمورا وزمزم % 4(@)(@@) % محصبهم قلبي لرمي جمارهم % ومنحرهم نفسي ومشربهم دمي % % 5(@)(@@) % فيا حادي الأجمال إن جئت حاجرا % فقف بالمطايا ساعة ثم سلم % 6(@)(@@) % وناد القباب الحمر من جانب الحمى % % تحية مشتاق إليكم متيم % 7(@)(@@) % فإن سلموا فاهد السلام مع الصبا % % وإن سكتوا فارحل بها وتقدم % % 8(@)(@@) % إلى نهر عيسى حيث حلت ركابهم ، % وحيث الخيام البيض من جانب الفم % 9(@)(@@) % وناد بدعد والرباب وزينب % وهند وسلمى ثم لبنى وزمزم % 10(@)(@@) % وسلهن هل بالحلبة الغادة التي % % تريك سنا البيضاء عند التبسم % PageV01P1251 البحر : طويل 1(@)(@@) % سلام على سلمى ومن حل بالحمى % % وحق لمثلي رقة أن يسلما % % 2(@)(@@) % وماذا عليها أن ترد تحية % علينا ولكن لا احتكام على الدمى % % 3(@)(@@) % سروا وظلام الليل أرخى سدوله % فقلت لها صبا غريبا متيما % 4(@)(@@) % أحاطت به الأشواق شوقا وأرصدت % له راشقات النبل أيان يمما % % 5(@)(@@) % فأبدت ثناياها وأومض بارق % فلم أدر من شق الحنادس منهما % % 6(@)(@@) % وقالت : أما يكفيه أني بقلبه % يشاهدني في كل وقت أما أما % % PageV01P1252 البحر : رمل تام 1(@)(@@) % أنجد الشوق وأتهم العزاء % فأنا ما بين نجد وتهام % 2(@)(@@) % وهما ضدان لن يجتمعا % % فشتاتي ما له الدهر نظام % 3(@)(@@) % ما صنيعي ما احتيالي دلني % % يا عذولي لا ترعني بالملام % 4(@)(@@) % زفرات قد تعالت صعدا % ودموع فوق خدي سجام % 5(@)(@@) % حنت العيس إلى أوطانها % % من وجى السير حنين المستهام % 6(@)(@@) % ما حياتي بعدهم إلا الفنا % % فعليها وعلى الصبر سلام % PageV01P1253 البحر : بسيط تام 1(@)(@@) % بان العزاء وبان الصبر إذ بانوا % % بانوا وهم في سواد القلب سكان % 2(@)(@@) % سألتهم عن مقيل الركب قيل لنا : % مقيلهم حيث فاح الشيح والبان % 3(@)(@@) % فقلت للريح سيري والحقي بهم % فإنهم عند ظل الأيك قطان % 4(@)(@@) % وبلغيهم سلاما من أخي شجن % في قلبه من فراق القوم اشجان % PageV01P1254 البحر : طويل 1(@)(@@) % وزاحمني عند استلامي 
ms319	 أوانس % اتين إلى التطواف معتجرات % 2(@)(@@) % حسرن عن انوار الشموس ، وقلن لي : % تورع ، فموت النفس في اللحظات % 3(@)(@@) % وكم قد قتلنا ، بالمحصب من منى ، % نفوسا أبيات لدى الجمرات % 4(@)(@@) % وفي سرحة الوادي وأعلام رامة % وجمع عند النفر من عرفات % 5(@)(@@) % ألم ترأن الحسن يسلب من له % عفاف ، فيدعى سالب الحسنات % 6(@)(@@) % فموعدنا بعد الطواف بزمزم ، % لدى القبة الوسطى لدى الصخرات % 7(@)(@@) % هنالك من قد شفه الوجد يشتفي % % بما شاءه من نسوة عطرات % 8(@)(@@) % إذا خفن أسدلن الشعور فهن من % % غدائرها في الحف الظلمات % % PageV01P1255 البحر : كامل تام 1(@)(@@) % درست ربوعهم ، وإن هواهم % أبدا جديد بالحشا ما يدرس % 2(@)(@@) % هذي طلولهم وهذي الأدمع % ولذكرهم أبدا تذوب الأنفس % 3(@)(@@) % ناديت خلف ركابهم من حبهم : % يا من غناه الحسن ! ها أنا مفلس % 4(@)(@@) % مرغت خدي رقة وصبابة % فبحق حق هواكم لا تؤيسوا % % 5(@)(@@) % من ظل في عبراته غرقا وفي % % نار الأسى حرقا ولا يتنفس % 6(@)(@@) % يا موقد النار الرويدا هذه % % نار الصبابة شأنكم فلتقبسوا % % PageV01P1256 البحر : كامل تام 1(@)(@@) % لمعت لنا بالأبرقين بروق % % قصفت لها بين الضلوع رعود % 2(@)(@@) % وهمت سحائبها بكل خميلة % وبكل مياد عليك تميد % 3(@)(@@) % فجرت مدامعها ، وفاح نسيمها % % وهفت مطوقة وأورق عود % 4(@)(@@) % نصبوا القباب الحمر بين جداول % مثل الأساود ، بينهن قعود % 5(@)(@@) % بيض ، أوانس ، كالشموس طوالع % عين كريمات عقائل غيد % PageV01P1257 البحر : طويل 1(@)(@@) % ألا يا حمامات الأراكة والبان % ترفقن لا تضعفن بالشجو أشجاني % % 2(@)(@@) % ترفقن لا تظهرن بالنوح والبكا % % خفي صباباتي ومكنون أحزاني % % 3(@)(@@) % أطارحها عند الأصيل وبالضحى % % بحنة مشتاق وأنة هيمان % 4(@)(@@) % تناوحت الأرواح في غيضة الغضا % % فمالت بأفنان علي فأفناني % % 5(@)(@@) % وجاءت من الشوق المبرح والجوى % % ومن طرف البلوى إلي بأفنان % 6(@)(@@) % فمن لي بجمع والمحصب من منى % % ومن لي بذات الأثل من لي بنعمان % % 7(@)(@@) % تطوف بقلبي ساعة بعد ساعة % لوجد وتبريح وتلثم أركاني % % 8(@)(@@) % كما طاف خير الرسل بالكعبة التي % % يقول دليل العقل فيها بنقصان % 9(@)(@@) % وقبل أحجارا بها ، وهو ناطق % وأين مقام البيت من قدر 
ms320	 إنسان % 10(@)(@@) % فكم عهدت أن لا تحول وأقسمت % وليس لمخضوب وفاء بأيمان % PageV01P1258 11(@)(@@) % ومن أعجب الأشياء ظبى مبرقع % يشير بعناب ويومي بأجفان % 12(@)(@@) % ومرعاه ما بين الترائب والحشا % % ويا عجبا من روضة وسط نيران % 13(@)(@@) % لقد صار قلبي قابلا كل صورة % فمرعى لغزلان ودير لرهبان % 14(@)(@@) % وبيت لأوثان وكعبة طائف ، % وألواح توراة ومصحف قرآن % 15(@)(@@) % أدين بدين الحب أنى توجهت % ركائبه فالحب ديني وإيماني % % 16(@)(@@) % لنا أسوة في بشر هند وأختها % % وقيس وليلى ، ثم مي وغيلان % PageV01P1259 البحر : طويل 1(@)(@@) % بذي سلم ، والدير من حاضر الحمى % % ظباء تريك الشمس في صورة الدمى % % 2(@)(@@) % فأرقب أفلاكا ، وأخدم بيعة % وأحرس روضا بالربيع منمنما % % 3(@)(@@) % فوقتا أسمى راعي الظبي بالفلا ، % ووقتا أسمى راهبا ومنجما % 4(@)(@@) % تثلث محبوبي وقد كان واحدا % كما صيروا الأقنام بالذات أقنما % % 5(@)(@@) % فلا تنكرن يا صاح ، قولي غزالة % تضيء لغزلان يطفن على الدمى % % 6(@)(@@) % فللظبي أجيادا ، وللشمس أوجها % وللدمية البيضاء صدرا ومعصما % % 7(@)(@@) % كما قد أعرنا للغصون ملابسا ، % وللروض أخلاقا وللبرق مبسما % % PageV01P1260 البحر : كامل تام 1(@)(@@) % ناحت مطوقة فحن حزين % وشجاه ترجيع لها وحنين % 2(@)(@@) % جرت الدموع من العيون تفجعا % لحنينها فكأنهن عيون % 3(@)(@@) % طارحتهما ثكلا بفقد وحيدها % % والثكل من فقد الوحيد يكون % 5(@)(@@) % بي لاعج من حب رملة عالج % حيث الخيام بها وحيث العين % 6(@)(@@) % من كل فاتكة اللحاظ مريضة % أجفانها لظبا اللحاظ جفون % 7(@)(@@) % ما زلت أجرع دمعتي من غلتي % % أخفي الهوى عن عاذلي وأصون % 8(@)(@@) % حتى إذا صاح الغراب ببينهم % % فضح الفراق صبابة المحزون % % 9(@)(@@) % وصلوا السرى ، قطعوا البرى فلعسيهم % % تحت المحامل رنة وأنين % 10(@)(@@) % عاينت أسباب المنية عندما % % أرخوا أزمتها وشد وضين % 11(@)(@@) % إن الفراق مع الغرام لقاتلي % % صعب الغرام مع اللقاء يهون % PageV01P1261 12(@)(@@) % مالي عذول في هواها إنها % % معشوقة حسناء حيث تكون % PageV01P1262 البحر : طويل 1(@)(@@) % رأى البرق شرقيا ، فحن إلى الشرق ، % ولو لاح غربيا لحن إلى الغرب % 2(@)(@@) % فإن غرامي بالبريق ولمحه % وليس غرامي بالأماكن والترب % 3(@)(@@) % روته الصبا عنهم حديثا معنعنا % عن البث عن 