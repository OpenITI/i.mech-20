ms281	 گشته جانها(@)(@@) (@@) در روی تو روی خویش بینند %~% زینجاست تفاوت نشانها PageV01P362(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V01_0364.jpg)(@)(@)(@@) (@@) - ای از بنفشه ساخته گلبرگ را نقاب %~% وز شب طپانچهها زده بر روی آفتاب(@)(@@) (@@) دارم ز آب و آتش یاقوت و جزع تو %~% در آب دیده غرق و بر آتش جگر کباب 67a(@)(@@) (@@) گه دست عشق جامهآ صبرم کند قبا %~% گه آب چشم خانهآ زارم1 کند خراب(@)(@@) (@@) - غم عشق تو از غمها نجات است %~% مرا خاک درت آب حیات است(@)(@@) (@@) چنان پر شد دل از هجران که گویی1 %~% شب هجر توام روز وفات است(@)(@@) (@@) حسن را از وفا چه آزار است %~% که همه ساله با جفا یار است(@)(@@) (@@) عشق در خواب وعاشقان در خون %~% دایه بی شیر و طفل بیمار است(@)(@@) (@@) - یار ما را به هیچ بر نگرفت %~% هر چه اگفتیم هیچ در نگرفت(@)(@@) (@@) پردهآ از روی کار ما برداشت %~% پرده از روی خویش بر نگرفت(@)(@@) (@@) - هر شکن در زلف تو از مشک دالی دیگر است %~% هر نظر از چشم تو سحر حلالی دیگر است(@)(@@) (@@) ناید اندر وصف کس آن چشم و زلف از بهر آنک %~% در خیال هرکس از هریک خیالی دیگر است(@)(@@) (@@) من به حالی دیگرم از عشق او هر لحظهای %~% زانکه او در حسن هر ساعت به حالی دیگر است(@)(@@) (@@) - کارم ز غمت به جان رسیدهاست %~% فریاد بر آسمان رسیدهاست(@)(@@) (@@) نتوان گلهآ تو کرد اگر چه %~% از دل به سر زبان رسیدهاست(@)(@@) (@@) این آب ز فرق در گذشته است %~% وین کارد بر استخوان رسیدهاست(@)(@@) (@@) - معشوقه به رنگ روزگار است %~% با گردش روزگار یار است(@)(@@) (@@) برگشت چو روزگار و آن نیز %~% نوعی ز جفای روزگار است(@)(@@) (@@) - مهرت به دل و به جان دریغ است %~% عشق تو به این و آن دریغ است(@)(@@) (@@) با کس بمگوی نام تو چیست %~% کان نام به هر زبان دریغ است(@)(@@) (@@) وصل تو بدان جهان توان یافت %~% کان ملک بدین جهان دریغ است(@)(@@) (@@) - عشق تو بی روی تو درد دلی است 
ms282	 %~% مشکل عشق تو مشکل مشکلی است PageV01P363(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V01_0365.jpg)(@)(@)(@@) (@@) بی تو در هر خانه دستی بر سری است %~% وز تو در هر کوی پایی در گلی است(@)(@@) (@@) روز شادی چو راز گردون است %~% لاجرم آشکار مینشود(@)(@@) هیچ امسال دیدهای هرگز %~% که دگر سال یار مینشود(@)(@@) (@@) -گل حسن تو را چون دسته بستند %~% بهار و باغ در ماتم نشستند(@)(@@) (@@) - عشق تو را خرد نباید شمرد %~% عشق بزرگان نبود کار خرد(@)(@@) (@@) چون ز پی تست چه شادی چه غم %~% چون ز میتست چه صافی چه درد(@)(@@) (@@) - ز من مپرس که بی من زمانه چون گذرانی %~% از آن بپرس که بر من زمانه میگذراند(@)(@@) (@@) - زلفت چو به دلبری در آمد %~% بس کس که ز جان و دل بر آمد(@)(@@) (@@) هم رایت خوشدلی نگون شد %~% هم دولت بی غمی سر آمد(@)(@@) (@@) دست گرد جهان بر آوردم %~% پای اهلی به دست میباید(@)(@@) (@@) هیچکس نیست زیر دور فلک %~% که از آن بهترک نمییابد(@)(@@) (@@) اگر نقش رخت بر جان ندارم %~% به زلف کافرت ایمان ندارم(@)(@@) (@@) ز تو یک درد را درمان مبادم %~% اگر صد درد بی درمان ندارم(@)(@@) (@@) صبوری را مگر معذور داری %~% دلی میباید و من آن ندارم(@)(@@) (@@) - آب جمال جمله به جوی تو میرود %~% خورشید در جنیبت روی تو میرود(@)(@@) (@@) صبربا عشق در نمیآید %~% یار فریادرس نمی آید(@)(@@) (@@) بی غمی خوش ولایتی است ولی %~% زیر فرمان کس نمیآید(@)(@@) (@@) - دردم فزود و دست به دامان نمی رسد %~% صبرم رسید و هجر به پایان نمیرسد(@)(@@) (@@) در ظلمت نیاز به جهد سکندری %~% خضر طرب به چشمه حیوان نمیرسد(@)(@@) (@@) - عجب عجب که تو را یاد دوستان آمد %~% در آ در آکه ز تو کار ما به جان آمد(@)(@@) (@@) چه میکنی به چه مشغولی و چه می طلبی %~% چه گفتمت چه شنیدی چه در گمان آمد(@)(@@) - ماه را در بساط خوبی تو %~% عقل بر هیچ گوشه نشاند(@)(@@) شعلهآ آفتاب را بکشد %~% حسنت ار آب بر جهان راند(@)(@@) (@@) - آن روزگار کو که 
ms283	 مرا یار یار بود %~% من بر کنار از غم و او در کنار بود PageV01P364(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V01_0366.jpg)(@)(@)(@@) (@@) - در دور تو کم کسی امان یابد %~% در عشق تو کم دلی زبان یابد(@)(@@) (@@) تنها تو همه جهانی و آن کس %~% کو یافت تو را همه جهان یابد(@)(@@) (@@) در آینه گر جمال بنمایی %~% از نور رخت خیال جان یابد(@)(@@) (@@) - دوش تا صبح یار در بر بود %~% غم هجران چو حلقه بر در بود(@)(@@) (@@) دست من بود و دامنش1 همه شب %~% دی همه روز اگر چه بر سر بود(@)(@@) (@@) یا من از عشق زارتر بودم %~% یا ز هر شب رخش نکوتر بود(@)(@@) (@@) از فلک تا که صبح روی نمود %~% انوری با فلک برابر بود(@)(@@) (@@) - قبای عشق مجنون میبریدند %~% دلم را زان کلهواری بیفتاد 670(@)(@@) (@@) - ساقیا بادهآ صبوح بیار %~% دانهآ دام هر فتوح بیار(@)(@@) (@@) قبلهآ ملت مسیح بده %~% آفت توبهآ نصوح بیار(@)(@@) (@@) هین که طوفان غم جهان بگرفت %~% می همزاد عمر نوح بیار(@)(@@) (@@) - ای غم تو جسم را جانی دگر %~% جان نیابد چون تو جانانی دگر(@)(@@) (@@) گر ببیند روی خوبت اهرمن %~% نی گمان گوید که یزدانی دگر(@)(@@) (@@) - در آن دریا شدستم غرق کانجا %~% به جز غم مینبینم ساحل خویش(@)(@@) (@@) - پیراهن گل دریده شد بر تن گل %~% شلوار تو بی نما چو پیراهن گل(@)(@@) (@@) ای خرمن کون تو به از خرمن گل %~% جایی که بود کون تو، کون زن گل(@)(@@) (@@) - انوری را زنی است زانیه %~% که از او هر که در جهان زانی است(@)(@@) (@@) تا جهان باد کیر در کس او %~% ای دریغا که این جهان فانی است(@)(@@) (@@) - گویند ستی زنی عفیفه است %~% فافاک الله از آن عفیفه(@)(@@) (@@) از خصلتهاش یک دو و رسم است %~% سنت شده در جهان جیفه(@)(@@) آیین سماع در مصیبت %~% ترتیب جماع در وظیفه(@)(@@) وانگاه مع الغرابه او را %~% ا این همه خصلت شریفه(@)(@@) بی منع و جگر درون شلوار %~% کونی است ز پاچه تا به نیفه PageV01P365(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V01_0367.jpg)(@)(@)(@@) (@@) اشاء الله فراخ چون 
ms284	 چه %~% چون رخصتهای بو حنیفه(@)(@@) (@@) د تو کس خواجهای و هر که چو تو من کس کس نیم به نفس خودم %~% کس دیگر(@)(@@) کس است همچو خس است %~% لاجرم هر که چون من است کس است(@)(@@) (@@) - دلم از کار این فلک بگرفت نسبت ما درین به عیب و هنر %~% که نه(@)(@@) عقدش به موقع است و نه حل %~% گر همین هر دو بیش نیست بس است(@)(@@) (@@) خشک ریشت کند فلک بپذیر کیر در کون زهره و مریخ %~% تیز در ریش مشتری(@)(@@) و زحل %~% تا بود تر حوت و خشک حمل(@)(@@) (@@) واسطه عقدتین کاوردست %~% از هوای عدم به خاک امل(@)(@@) (@@) نیم کاران کارگاه وجود %~% خازنان خزانههای جعل(@)(@@) (@@) فرجه فرجه آدم وحوا %~% حشو معلول و علت اول(@)(@@) (@@) هر یکی روی و ریشی آورده %~% ه اجازت ز نقشبند ازل(@)(@@) (@@) آدم آدم همی زنند و یکی %~% نه به علم آدمند و نه به عمل(@)(@@) (@@) کارشان سال و مه منی و تویی %~% بیشه شان روز و شب جدال و جدل(@)(@@) (@@) بیطهارت چو سجده آرند %~% در میان دو صد خطا و زلل(@)(@@) (@@) وحشیان در رسد که نازل شد %~% شرف صد پیمبر مرسل(@)(@@) (@@) روی اگر بر زمین نهند از کبر %~% رکند آسمان زگند لعل(@)(@@) (@@) ور نمازی کنند بر دوزند %~% کیسهآ بر خدای عز و جل(@)(@@) (@@) ای دریغا که طینت آدم %~% ه سباع و بهیمه گشت بدل(@)(@@) (@@) شاد از آنم اگر چه نیست مرا %~% نزد اینها درین زمانه محل(@)(@@) (@@) زان یکی را همی نباید دید %~% در قیامت نه اکثر و نه اقل(@)(@@) (@@) - مدح گفتیم ناسزایی را %~% زو نیامد پدید هیچ فتوح(@)(@@) (@@) تیز در ریش این چنین مادح %~% کیر در کون این چنین ممدوح(@)(@@) (@@) من و این نفس که با قحبهآ رعنای جهان %~% چون چسان عشق نبازد نه به سهو و نه به عمد(@)(@@) (@@) قدرت دادن اگر نیست مرا باکی نیست %~% فمت ناستدن هست و لله الحمد PageV01P366(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V01_0368.jpg)(@)(@)(@@) (@@) - هر بلایی کز آسمان آید %~% گر چه بر دیگری قضا 
ms285	 باشد(@)(@@) بر زمین نارسیده میگوید %~% خانهآ انوری کجا باشد(@)(@@) (@@) - انوری نام هجو مینبرد %~% زانکه چشم از تو بر عطاست هنوز(@)(@@) (@@) دست جز نام میبرد لیکن %~% می نگوید که در کجاست هنوز(@)(@@) (@@) - دختران و پسرانی که فلک %~% آرد از نسل تو تا حشر برون(@)(@@) (@@) تا به حوا همه را دار به کس %~% تا به آدم همه را دار به کون(@)(@@) (@@) - ماه رویی هست مهمانم شرابم ده به لطف %~% زان شرابم ده که پنجه بار بیشم دادهای(@)(@@) (@@) از شراب تو اگر این ماه رو گاده شود %~% همچنان دان کین جماع از خاص خویشم دادهای(@)(@@) (@@) -چهار چیز است آیین مردم هنری %~% که مردم هنری زین چهار نیست بری682(@)(@@) (@@) یکی سخاوت طبعی چد دستگاه بود %~% به نیک نامی آن را ببخشی و بخوری(@)(@@) (@@) [دو دیگر آنکه دل دوستان نیازاری %~% که دوست آینه باشد چو اندرو نگری](@)(@@) (@@) سه دیگر آنکه زبان را به گاه گفتن زشت %~% نگاه داری تا وقت عذر غم نخوری(@)(@@) (@@) چهارم آنکه کسی کو به جای تو بد کرد %~% چو عذر خواهد نام گناه او نبری(@)(@@) (@@) - صفهای را نقش میکردند نقاشان چین %~% بشنو این معنی کزین خوشتر حدیتی نشنوی(@)(@@) (@@) اوستادی نیمهای را کرد همچون آینه %~% او ستادی نیمهای را کرد نقش مانوی(@)(@@) (@@) تا هر آن نقشی که حاصل باشد اندر نیمهای %~% بینی اندر نیمه دیگر چو اندر وی روی(@)(@@) (@@) ای برادر خویشتن را صفهای دان همچنان %~% هم به سقفی نیک عالی هم به بنیادی قوی(@)(@@) (@@) باری از آن نیمه پر نقش نتوانی شدن %~% جهد میکن تا مگر آن نیمهآ دیگر شوی(@)(@@) (@@) - عادت کن از جهان سه خصلت را %~% ای خواجه وقت مستی و هشیاری(@)(@@) زیرا که رستگار بدان گردی %~% امید رستگاری اگر داری(@)(@@) با هیچکس خرد نگشت همره %~% کان هر سه را نکرد خریداری(@)(@@) دانی که چیست آن بشنو از من %~% رادی و راستی و کم آزاری(@)(@@) - هفت مدبر مدبر فلکند %~% چون اجل جمله قاطعان امید(@)(@@) قمر قلتبان و نیر دو روی 
ms286	 %~% که رید بر سیه ز جیب سپید PageV01P367(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V01_0369.jpg)(@)(@)(@@) تیز کیوان به سبلت برجیس %~% کیر بهرام در کس ناهید(@)(@@) (@@) و نزد طبیب عقل مبارک قدم شدم %~% حال مزاج خویش بگفتم کما جرا(@)(@@) (@@) دل را چو از عفونت اخلاط آرزو %~% محموم دید و سرعت نبضم بر آن گوا(@)(@@) (@@) گفتا بدن ز فضلهآ آمال ممتلی است %~% سوء المزاج حرص ائر کرده در قوا(@)(@@) (@@) ای دل به عون مسهل سقمونیای صبر %~% وقت است اگر به تنقیه کوشی ز امتلا(@)(@@) (@@) مقصود از این میانه اگر خفت1 دل است %~% اول قدم ز اکل فضول است احتما(@)(@@) چون به کس بکر مدحت آوردم %~% کون خاطر دریدم از سودا(@)(@@) خایهای بر درت2 بیفشارم %~% گر نگایی مرا به کیر عطا(@)(@@) (@@) - من و نگار من امروز هر دو رگ زده ایم %~% من از حرارت عشق و وی از حرارت تب(@)(@@) (@@) بزرگ بار خدایی کنی و بفرستی %~% ورا شراب عتاب و مرا شراب عنب(@)(@@) ~~- آن شنیدستی که روزی زیرکی با ابلهی گفت چون باشد گدا آن کز کلاهش(@)(@@) تکمهای %~% گفت کین والی شهر ما گدایی بی حیاست %~% صد چو ما را روزها بل سالها برگ و نواست(@)(@@) (@@) گفت ای مسکین غلط اینک از اینجا کردهای %~% آن همه برگ و نوا دانی که او را از کجاست(@)(@@) (@@) در و مروارید طوقش اشک طفلان من است %~% لعل ویاقوت ستامش خون ایتام من است(@)(@@) (@@) او که تا آب سبو پیوسته از ما خواسته است %~% گر بجویی تا به مغز استخوانش زان ماست(@)(@@) (@@) خواستن کدیه است خواهی عشر خوان خواهی خراج %~% زانکه گرده نام باشد یکحقیقت را رواست(@)(@@) (@@) چون گدایی چیز دیگر نیست جز خواهندگی %~% هر که خواهد گر سلیمان است و گر قارون گداست(@)(@@) - آلوده منت کسان کم شو %~% تا یک شبه در وثاق تو نان است(@)(@@) راضی نشود به هیچ بد نفسی %~% هر نفس که از نفوس انسان است(@)(@@) ای نفس به رستهآ قناعت شو %~% کانجا همه چیز نیک ارزان است(@)(@@) تا 
ms287	 بتوانی حذر کن از منت %~% کاین منت خلق کاهش جان است(@)(@@) شک نیست که هر که چیزکی دارد %~% وان را بدهد طریق احسان است PageV01P368(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V01_0370.jpg)(@)(@)(@@) ~~عرصه آلفیه اعرفه متقدمین(@)(@@) لیکن چو کسی بود که نستاند %~% احسان آن است و سخت آساناست(@)(@@) چندانکه مروت است در دادن - ربع مسکون آدمی را بود دیو و دد گرفت %~%(@)(@@) در ناستدن هزار چندان است %~% مس نمیداند که در آفاق انسانی کجاست(@)(@@) (@@) خای را طوفان اگر غسلی دهد، وقت آمدست %~% ای دریغا داعی چون نوح طوفانی کجاست(@)(@@) (@@) اگر محول حال جهانیان نه قضاست %~% چرا مجاری احوال بر خلاف رضاست(@)(@@) (@@) بلی قضاست به هر نیک و بد عنانکش خلق %~% دان دلیل که تدبیرهای جمله خطاست(@)(@@) (@@) - هزار نقش بر آرد زمانه و نبود %~% کی چنانکه در آینه تصور ماست(@)(@@) (@@) کسی ز چون و چرا دم همی نیارد زد %~% که نقشبند حوادت ورای چون و چراست(@)(@@) (@@) به دست ما چو ازین حل و عقد چیزی نیست %~% به عیش ناخوش و خوش گر رضا دهیم سزاست(@)(@@) (@@) که زیر گنبد خضرا چنان توان بودن %~% که اقتضای قضاهای گنبد خضراست 680(@)(@@) (@@) کسی چه داند کین گوژپشت مینا رنگ %~% جگونه مولع آزار مردم داناست(@)(@@) (@@) نه هیچ عقل ز اشکال دور او واقف %~% نه هیچ دیده به اسرار حکم او بیناست(@)(@@) ~~مرا ز گردش این چرخ آن شکایت نیست ز دست حادثه بندی نهاده بر پایم(@)(@@) %~% که همچو حادئه گاهی نهان و گه پیداست %~% که شرح آن به همه عمر ممکن است و رواست(@)(@@) (@@) نظر به حیله ز اعضا جدا نمیکندش %~% کراست بند ز اعضا که آن هم از اعضاست(@)(@@) ~~ز روزگار خوشت این همه چرا به که کنم به درگه تو فلک را گذر به پای(@)(@@) ادب %~% ز دستبوس خداوند روزگار جداست %~% به جانب تو قضا را نظر به عین رضاست(@)(@@) ~~اگر فنا در هستی به کل برانداید1 غبار قد تو آن اوجها که بر گردون بنان دست تو را موج 
ms288	 بحر و بذل سحاب جهان به طبع گراید به خدمت تو که تو(@)(@@) %~% مسیر امر تو را بال برق و پای قضاست %~% عیال دست تو آن موجها که بر(@)(@@) دریاست %~% به ذات کل جهانی و کل او اجزاست %~% تو را چه باک نه ذات تو مستعد فناست(@)(@@) (@@) وگر بقا نبود در جهان تو را چه زیان %~% بقا به ذات تو قایم نه ذات تو بقاست(@)(@@) (@@) تبارک الله از آن آب سیر آتش فعل %~% که با رکاب تو آب است و با عنانت هواست PageV01P369(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V01_0371.jpg)(@)(@)(@@) (@@) بهوقت رفتن و طی کردن مسالک ملک %~% هواش فدفد و دریا سراب و که صحراست(@)(@@) جهاننوردی کامروزش ار بر انگیزی %~% به عالمیت رساند که اندرو فرداست(@)(@@) سپهر اگر بدل خویش صورتی سازد %~% برش چو صورت اسبی بود که بر دیباست(@)(@@) بوحامد اوحدالدین کرمانی](@)(@@) ~~عرفة عمدة المجاهدین، زبدة المشاهدین، مرشد العارفین، مرجع الموحدین، محرم حرم(@)(@@) ~~سراپردهآ یزدانی، محرم حریم کعبهآ سبحانی، صاحب حالات و کمالات انسانی، کاشف(@)(@@) ~~رموز کنوز معانی، وحید الزمان شیخ ابوحامد اوحدالدین کرمانی. از اکابر اولیا و اعظم(@)(@@) ~~اتقیاست. به غایت واصل وکامل است از مریدان شیخ الاسلام شهاب الدین ابی حفص(@)(@@) ~~عمر سهروردی بوده. گویند شبی حین سلوک در چهار رکعت عشا ختم قرآن کرده و در(@)(@@) ~~ارشاد مرتبهآ عالی داشته، چنانچه مستنصر عباسی به وی صدق ارادت آورده و وی با سید(@)(@@) ~~حسینی سادات و شیخ عراقی در هوتکان1 کرمان نوبتی اربعینی داشتهاند و حین استغراق(@)(@@) ~~محیط اتصال غواصوار هر یک گوهری در سفینهآ بحر چلهنشینی در آوردهاند و تحفهآ(@)(@@) ~~مجلس احباب نموده. شیخ اوحد ترجیعی گفته که مشهور است و شیخ عراقی لمعات به(@)(@@) ~~ظهور آورده و سید حسینی زادالمسافرین، و بعضی ترجیع وی را به شیخ او حدی مراغهای(@)(@@) ~~نسبت کنند و غالبا خطاست.(@)(@@) ~~شیخ اوحد الدین به کمال فضایل ظاهری و باطنی آراسته، همچون الف بر سر اوحد ذات(@)(@@) ~~واحدیت در ظهور احدیت گشته و همچو واو در 
ms289	 دود تو از غیر حق بر یک سو شده، همچو(@)(@@) ~~حا در توحید مرکز حقیقت آمده و همچو دال صمد بر کمال ظهور الهی دال گردیده، همچو(@)(@@) ~~عنقا در قاف حق به پرواز کمال جمال در آمده، پس در آشیانهآ عزلت پای به دامان قناعت(@)(@@) ~~کشیده، همچو قطرهآ عدم بحر وجود خود را به یک دم در کشیده. بسیاری از اشعار او به نام(@)(@@) ~~اکابر مشهور است و حالاتش نیز به حسب اشتباه به اسم هرکس معروف، کلامش مبنی بر PageV01P370(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V01_0372.jpg)(@)(@)(@@) ~~مغز معارف و بیانش معرا از تنگ زخارف است. آشیان مرغ روحش ذروهٔ‌ عرش توحید،(@)(@@) ~~جلوه گاه گوهر ذاتش قبلگاه تمجید است و وی به صحبت شیخ محیی الدین اعرابی نیز(@)(@@) ~~شرف قبول یافته. در شهر قونویه سنهآ 1635. و چهار صد رباعی از او به نظر رسیده. و له:(@)(@@) (@@) - اوحد در دل میزنی آخر دل کو؟ %~% عمریست که راه میروی منزل کو؟(@)(@@) (@@) تاکی گویی ز خلوت و خلوتیان %~% هفتاد و دو چله داشتی حاصل کو؟(@)(@@) (@@) رقص آن نبود که مر زمان برخیزی %~% بی درد چو گرد از میان برخیزی(@)(@@) (@@) رقص آن باشد کز دو جهان برخیزی %~% تن خرقه کنی و ز سر جان برخیزی(@)(@@) (@@) -حاشا که من ز خاک درت برخیزم %~% چون خاک ره از رهگذرت برخیزم 69a(@)(@@) (@@) هرچند که چون موی شدم بی مویت %~% آن موی نیم که از سر برخیزم(@)(@@) (@@) تا حاصل دردم سبب درمان شد %~% یستیم بلندی شد و کفر ایمان شد(@)(@@) (@@) جان و دل دین حجاب بودند کنون %~% تن دل شد و دل جان شد و جان جانان شد(@)(@@) ~~و این رباعی مذکور اگر چه در دیوان رباعیات وی هست، اما به اسم امامی اصح است.(@)(@@) (@@) - عشق تو که مونس دل ریش من است %~% بیگانه نمیشود مگر خویش من است(@)(@@) (@@) از من دل و صبر بازگشتند و هنوز %~% منزل منزل غم تو در پیش من است(@)(@@) (@@) -گر بیتو غمی خوردم از آن غم توبه 
ms290	 %~% وز هر چه نه از بهر تو کردم توبه(@)(@@) (@@) وان نیز که بعد ازین برای تو کنم %~% گر بهتر ازین نیز توان هم توبه(@)(@@) ~~اندر ره حق خواجه کم آید ز غلام - خواهی که رسی به کام بر گیر دو کام(@)(@@) %~% یک کام ز کونین و دگر کام ز کام %~% یک بندهآ پخته به ز صد خواجهآ خام(@)(@@) (@@) - ای دوست حجاب تو کسی نیست تویی %~% اندر ره تو خار و خسی نیست تویی(@)(@@) (@@) گفتی که به معشوق رسیم یا نرسیم %~% از تو بر معشوق بسی نیست تویی(@)(@@) (@@) - از پس منگر یکدم و در پیش مباش %~% با خویش مباش و خالی از خویش مباش(@)(@@) (@@) گر میخواهی که عین توحید شوی %~% مشنو، منگر، مبین، میندیش، مباش PageV01P371(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V01_0373.jpg)(@)(@)(@@) ~~این رباعی هم اگر چه در دیوان او حدی است به اسم خواجه افضل نوشته شده است و آما(@)(@@) ~~این رباعی که نوشته خواهد شد از اوست و به غلط در دیوان مولوی نوشتهاند. و له:(@)(@@) (@@) - ای زندگی تن و توانم همه تو %~% جانی و دلی ای دل و جانم همه تو(@)(@@) (@@) تو هستی من شدی از آنم همه من %~% من نیست شدم در تو از آنم همه تو(@)(@@) (@@) - چون سایه نه نیستم نه هستم بی تو %~% وز سایه خویشتن گسستم بی تو(@)(@@) (@@) تو سایه خویش بر گرفتی ز سرم %~% چون سایه به خاک در نشستم بی تو(@)(@@) ~~و این رباعی را به نام شیخ سعدالدین حمویی نیز نوشتهاند:(@)(@@) (@@) - دل وقت سماع سوی دلدار برد %~% حالت به سراپردهآ اسرار برد(@)(@@) (@@) این زمزمه مرکبی است پس روح تو را %~% بر دارد و خوش خوش به در یار برد(@)(@@) (@@) - ای دل تو بدین مفلسی و رسوایی %~% انصاف بده که عشق را جان شایی(@)(@@) (@@) عشق آتش تیز است و تو را آبی نه %~% خاکت بر سر که باد می پیمایی(@)(@@) ~~چندان خطا و سهو که مردم در رباعیات وی کردهاند در شعر کمتر کسی است، از جمله 
ms291	 این(@)(@@) ~~رباعی که مذکور میشود هم به اسم مولوی و هم به اسم افضل نوشتهاند:(@)(@@) (@@) - من من نیم آنکس که منم کیست بگو %~% گویا به تنم آنکه تنم کیست بگو(@)(@@) (@@) من پیرهنی بیش نیم سر تا پای %~% آن کس که منش پیرهنم کیست بگو(@)(@@) (@@) - چون نام توام در دل ناشاد آید %~% یا از تو حکایتی مرا یاد آید(@)(@@) (@@) از شوق تو در هر تن مویی که مراست %~% نالان نالان دلی به فریاد آید(@)(@@) (@@) - دل مغز حقیقتاست وتن پوست ببین %~% در کسوت دوست صورت دوست ببین(@)(@@) (@@) هر چیز که آن نشان هستی دارد %~% یا سایهآ نور اوست یا اوست ببین(@)(@@) (@@) افسوس که دیدهآ نکو بینت نیست %~% چشمی به عیوب خود فرو بینت نیست(@)(@@) (@@) در جملهآ ذرات وجود از بد و نیک %~% او هست ولی دیدهآ او بینت نیست PageV01P372(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V01_0374.jpg)(@)(@)(@@) (@@) - این هستی تو هستی هست دگر است %~% وین مستی تو مستی مست دگر است(@)(@@) (@@) رو سر به گریبان تفکر درکش %~% کاین دست تو آستین دست دگر است(@)(@@) (@@) -ای اطلس دعوی تو را معنی برد شرمت باد اگر چنین خواهی زیست %~% ننگت(@)(@@) بادا اگر چنین خواهی برد %~% آخر به قیامت عمل خواهی برد(@)(@@) (@@) - در راه نیاز منزلی را دریاب %~% در کوی امید مقبلی را دریاب(@)(@@) (@@) صد کعبهآ آب وگل چو یک دل نبود %~% در کعبه چه میروی، دلی را دریاب(@)(@@) (@@) - در مدرسهها مایهآ گفتارم نیست %~% در بتکدهها صلیب و زنارم نیست(@)(@@) (@@) سرتاسر بازار به هیچم نخرند %~% خر چه متاعم که خریدارم نیست(@)(@@) (@@) - در دیدهآ خویش اگر نکوهیده شوی %~% در دیدهآ هر کسی پسندیده شوی(@)(@@) (@@) پروانه صفت بسوز در آتش عشق %~% تا دیدهآ نور و نور هر دیده شوی(@)(@@) (@@) - دل در ازل آمدهاست آن غم تو من جان و دل خویش بدان دارم دوست %~%(@)(@@) حان تا باید بود مکان غم تو %~% کاین داغ تو دارد، آن نشان غم تو 690(@)(@@) (@@) - ای قبلهآ هر که مقبل آمد کویت %~% حراب دل شکستگان ابرویت(@)(@@) (@@) امروز کسی 
ms292	 کز تو بگرداند روی %~% ردا به کدام دیده بیند رویت(@)(@@) ~~- غم با لطف تو شادمانی گردد گر باد به دوزخ برد از کوی تو خاک - باز طربش نه هر شکاری گیرد دانی که که در کنار گیرد او را - اوحد دیدی(@)(@@) که هر چه دیدی هیچ است %~% عمر از نظر تو جاودانی گردد %~% آتش همه آب(@)(@@) زندگانی گردد %~% آن کس که ز غیر او کناری گیرد %~% سلطان غمش نه هر دیاری(@)(@@) گیرد %~% وین نیز که گفتی و شنیدی هیچ است(@)(@@) (@@) سرتاسر آفاق دویدی هیچ است %~% وان نیز که در گنج خزیدی هیچ است(@)(@@) (@@) - هر موی تو را هزار صاحب هوس است %~% با خود به وصال تو کرا دسترس است(@)(@@) (@@) آن کس که بیافت دولتی یافت عظیم %~% وان را که نیافت درد نایافت بس است(@)(@@) (@@) - آن روز که نور بر ثریا بستند %~% وین منطقه بر میان جوزا بستند PageV01P373(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V01_0375.jpg)(@)(@)(@@) (@@) در کتم عدم به سان آتش بر شمع %~% عشقت به هزار رشته بر پا بستند(@)(@@) ~~و این رباعی همه به اسم نجم الدین نوشتهاند:(@)(@@) (@@) د خاک سر کویت ای بت مشکین خال %~% می بوسیدم دوش به امید وصال(@)(@@) (@@) پنهان ز رقیب آمده در گوشم گفت %~% میخور غم ما و خاک بر لب میمال(@)(@@) (@@) - ای از ره لطف راعی هر رمه تو %~% مقصود جهانیان ز هر زمزمه تو(@)(@@) (@@) هر چیز که عمریست که تشویش ره است %~% از غیر تو ما را برهان ای همه تو(@)(@@) (@@) - سودای میان تهی ز سر بیرون کن %~% از ناز به کاه در نیاز افزون کن(@)(@@) (@@) استاد تو عشق است چو اینجا برسی %~% او خود به زبان حال گوید چون کن(@)(@@) (@@) زان مینگرم به چشم سر در صورت %~% زیرا که ز معنی است اثر در صورت(@)(@@) (@@) این عالم صورت است و ما بر صوریم %~% معنی نتوان یافت مگر در صورت(@)(@@) (@@) - ذاتش که به جز نهان و جز پیدا نیست %~% جای بنما به من که او آنجا نیست(@)(@@) (@@) اجزای 
ms293	 وجود او از آنجا که منم %~% کل اوست ولی مرکب از اجزا نیست(@)(@@) (@@) - در ذات تو صورت و هیولایی نیست %~% گردی و درازی نه و پهنایی نیست(@)(@@) (@@) چشم پس و پیش و زیروبالا، چپ وراست %~% جای تو نهای و بی تو خود جایی نیست(@)(@@) (@@) - مه در سفر از عشق نکورویی تست %~% شب تیرهدل از رشک سیه مویی تست(@)(@@) (@@) عالم همه بر حدیث نیکویی تست %~% بدگوی دشمنان ز بدخویی تست(@)(@@) (@@) - تا ظن نبری که هست این رشته دو تو %~% یکسو است خود اصل و فرع بنگر تو بگو(@)(@@) (@@) این اوست همه و لیک پیداست به من %~% شک نیست که این جمله منم لیک بدو(@)(@@)(@@)(@@) | (@)(@@) [شیخ اوحدی مراغهای](@)(@@) ~~زبان آوری، وید رمن، فرید دورهنی. ب ادر. هوری رحدی مراغه ای.(@)(@)PageV01P374(@)(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V01_0376.jpg)(@)(@)(@@) ~~فاضلی است کامل، کاملی عالم، عالمی عامل، عاملی واصل، واصلی متواصل. عنقای(@)(@@) ~~طبعش در فضای قاف سین و کاف در عین بلند پروازی و آرش ذهنش به امل آمال معانی(@)(@@) ~~در آن پرتاب اندازی. در جمیع اطوار و ادوار سایر و دایر گشته به مراتب تصوف بی تکلف(@)(@@) ~~رسیده. جامع کمالات و صاحب حالات عقلی و نقلی است. در اکثر علوم داخل و واصل(@)(@@) ~~است، خاصه در علوم ریاضی و غریبه سیما سیمیا و کیمیا که به غایت منفرد است.(@)(@@) ~~اصل ایشان از مراغهآ تبریز است، اما بیشتر اوقات رحل اقامت به صفاهان افکنده بود.(@)(@@) ~~ظهورش در زمان ارغون خان است. گویند در زمان ابو سعید خان به تبریز آمده، از آن(@)(@@) ~~پادشاه نوازشات یافته، از وزیر اعظم او خواجه غیاث الدین محمد بن خواجه رشید به(@)(@@) ~~عواطف ممتاز گردیده به انعامات وافی رسیده، باز به صفاهان مراجعت نموده و در بابا(@)(@@) ~~محمود بن1 به جوار رحمت ایزدی پیوست و بابا محمود بن مضجعش حوالی لنجان2 و(@)(@@) ~~النجان واقع است و آن قریه به اسم وی معروف شده و شیخ اوحدی به غایت عارف(@)(@@) ~~واقف مجرد موحد مکمل منفرد بوده. 
ms294	 مشهور است که به نسبت ارادت به خدمت شیخ(@)(@@) ~~اوحد کرمانی به غایت به این لقب ملقب گردیده. جام جم از مثنویات اوست 70a که در(@)(@@) ~~تتبع حدیقة الحقیقه ساحری نموده. دیوان قصیده و غزلش هشت هزار بیت معروف است(@)(@@) ~~و در نظر، از آنجاست:(@)(@@) (@@) - عرق چو از رخت، ای سرو بوستان4 بچکد %~% ز خاک لاله برآیده ز لاله جان بچکد(@)(@@) (@@) از آن حدیث لبت بر زبان نمی رانم %~% که نازی است مبادا که از دهان بچکد(@)(@@) (@@) مرا دلی است که گویی همین زمان برود %~% تو را رخی است که گویی همین زمان بچکد(@)(@@) (@@) هزار سال پس از مرگ زنده شاید بود %~% به بوی آب حیاتی کزان دهان بچکد PageV01P375(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V01_0377.jpg)(@)(@)(@@) ~~لب تو آب حیات است اگر به کوزه رسد زکوزه تا به ابد قطرههای جان بچکد1(@)(@@) (@@) ز شرم روی تو در باغ وقت گل چیدن %~% گل آب گردد و از دست یا عنان بچکد(@)(@@) (@@) ز حسرت رخ چون آفتابت اندر صبح %~% ستاره خون شود2 از چشم آسمان بچکد(@)(@@) (@@) نگاه داشتن3 خون اوحدی تا چند %~% بهل بهل که4 برین خاک آستان بچکد(@)(@@) (@@) - ای سر تو پیوسته با جان، ز که پرسیمت؟ %~% پیدا چو نمیگردی، پنهان ز که پرسیمت؟(@)(@@) (@@) از جمله بپرسیدم احوال نهان تو %~% ای جمله تو را از هم پرسان، ز که پرسیمت؟(@)(@@) (@@) در چشم نمی آیی وز جان نشوی5 بیرون %~% چشمی تو بدین خوبی، با جان ز که پرسیمت؟(@)(@@) (@@) - سایه جدا میکند صورت هامون زکوه %~% ورنه بر آفتاب کوه و بیابان یکی است(@)(@@) (@@) - همخانهایم، روی گرفتن حلال نیست %~% ناگفته پرسشی که سخن را مجال نیست(@)(@@) (@@) پرسیدهای که آنکه طلب میکنی کجاست؟ %~% از من خبر مپرس که جای سوال نیست(@)(@@) (@@) در پردهای و بر همه کس پرده میدری %~% با هر کسی و با تو کسی را وصال نیست(@)(@@) (@@) - پیداست حال مردم رند، آن چنان که هست %~% خرم کسی6 که فاش کند هر نهان که هست(@)(@@) (@@) آشفته را گواه نباید 
ms295	 به عاشقی %~% رنگ رخش ز دور ببین و بدان که هست(@)(@@) (@@) مؤمن ز دین برآمد و صوفی ز اعتقاد %~% ترسا محمدی شد و عاشق همان که هست(@)(@@) (@@) خلقی نشان دوست طلب میکنند و ما7 %~% از دوست غافلیم به چندین نشان که هست(@)(@@) (@@) - هر طرف باغی و هر گوشه بهشتی باشد %~% خانهای را که در او همچو تو رضوانی هست(@)(@@) (@@) هم تو باشی به تناسخ که دگر باز آیی %~% دیدن مثل تو را هیچ گر امکانی هست(@)(@@) - موی برست از کف امید ما %~% وز کف موی تو نخواهیم رست(@)(@@) (@@) - آن بت وفا نکرد که در دل وفای اوست %~% وان یار سر کشید که تن خاک پای اوست(@)(@@) (@@) بگذار تا چو شمع بسوزد وجود من %~% زیرا که روشنایی من در فنای اوست(@)(@@) (@@) - خلقی چو طرف بر کمرش بستهاند دل %~% این دولت از میانه ببینم تا که راست PageV01P376(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V01_0378.jpg)(@)(@)(@@) ~~خرکه اتیه 7کرشه مفا مین(@)(@@) (@@) زلف تو را بدیدم و مشکم ز یاد رفت %~% هر کو به دام زلف تو اندر فتاد رفت(@)(@@) (@@) گفتی که بامداد مراد تو میدهم %~% زان روز می شمارم و صد بامداد رفت(@)(@@) (@@) - از ما میرس که آتش دل تا چه غایت است %~% از آب دیده پرس که آن ترجمان ماست(@)(@@) (@@) مشکل رها کند که بگوییم حال خویش %~% بندی که از محنت او بر زبان ماست(@)(@@) ~~برای کاسه گرفتن سبو چو زانو زد(@)(@@) (@@) - گرد دهن چون شکرش گرد، که امروز %~% تنگی که ازو قند به خروار برند اوست(@)(@@) (@@) - عشق روی تو نه درخور دل خام من است %~% کاول حسن تو و آخر ایام من است(@)(@@) (@@) آفت سیل به همسایه رساند روزی %~% سخت باریدن این ابر که بر بام من است(@)(@@) (@@) نامه سهل است نوشتن به تو، لیکن پرسم1 %~% که تو آن نامه نخوانی که در او نام من است(@)(@@) (@@) - ز پاسبانی همسایه گرد بام و درت %~% بدان رسیده که در چشم جان کنم3 نظرت(@)(@@) (@@) درون خانه چو ره نیست، 
ms296	 چاره آن دانم %~% که آستانه پرستی کنم چو خای درت(@)(@@) (@@) - بنشستم که نویسم سخن عشق ز دل %~% آتشی در قلم افتاد که طومار بسوخت(@)(@@) (@@) - بوی آن درد که امسال به همسایه رسید %~% آتشی بود که در خرمن من بار گرفت(@)(@@) (@@) - دلم چوخال تو پرخون چو زلفت اندرتاب %~% ز بوی آن خط مشکین نو دمیدهآ تست(@)(@@) (@@) گزیدهآ دو جهانی به سان طالع سعد %~% غلام طالع آنم که بر گزیدهآ تست(@)(@@) (@@) - نوبهارست و چمن خرم و گلزار آنجاست %~% ارم دیده و آرام دل زار آنجاست(@)(@@) (@@) تنم اینجا4 نشکیبد دلم آنجا چو خوشاست %~% دلم اینجا چو مرا یار آنجاست(@)(@@) (@@) هر چه در جملهآ خوبان طلبیدی از حسن %~% به رخ دوست نظر کن که به یکبار آنجاست(@)(@@) (@@) - آن ستمگر که وفای منش از یاد برفت %~% آتشی در من مسکین زد و چون باد برفت(@)(@@) (@@) او چو برخاست غم خود به نیابت بنشاند %~% تا نگویی که سپهر از سر بیداد برفت(@)(@@) (@@) پیش ازین در دل من هر هوسی بگذشتی %~% دل بدو دادم و آنها5 همه از یاد برفت PageV01P377(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V01_0379.jpg)(@)(@)(@@) (@@) هر که از بیدق این عرصه بود شاد شود %~% وانکه دور افتد ازین دایره گمراه شود(@)(@@) (@@) راز خود با دل هر ذره همی گوید دوست %~% لیک تا جان که از تن واقعه آگاه شود 70b(@)(@@) (@@) - روزی که به قتل من شمشیر کشد دشمن %~% بر هم نزنم دیده گر در نظر او باشد(@)(@@) (@@) نامهآ درد دل و قصهآ اندوه فراقت %~% خود گرفتم بنویسم که به عرض تو رساند(@)(@@) - کتاب تجرد بیان بر نگیرد %~% صفات محبت نشان بر نگیرد(@)(@@) من آن خاکسارم که گر برگذاری %~% بیفتم، کسم رایگان بر نگیرد(@)(@@) -از عشق تو جان نمیتوان برد %~% وز وصل نشان نمیتوان برد(@)(@@) داری دهنی که از لطافت %~% ره بر سر آن نمیتوان برد(@)(@@) دارم به لب تو حاجتی لیک %~% نامش به زبان نمیتوان برد(@)(@@) (@@) عشق بی علت ترنج دوستی بار آورد %~% ور به علت عشق ورزی رنج و 
ms297	 تیمار آورد(@)(@@) (@@) جذب مغناطیس بین کآهن به خود چون میکشد؟ %~% کم ز سنگی نیستی کآهن به رفتار آورد(@)(@@) (@@) - دوشم فغان و ناله به هفت آسمان رسید %~% دودم ز دل برآمد و آتش به جان رسید(@)(@@) (@@) ما را مگر به پیش تو لطف تو آورد %~% ورنه به سعی ما به کجا میتوان رسید(@)(@@) (@@) - چون عشق درآمد قدم و سر بنماند %~% عشقت به بر آمد چو تو را بر بنماند(@)(@@) (@@) توحید به جایی برساند قدمت را %~% کاین نیک و بد و مؤمن و کافر بنماند 3(@)(@@) - چو دل شد زان او هرگز نمیرد %~% خورد از خوان او هرگز نمیرد(@)(@@) تن عاشق بمیرد در جدایی %~% و لیکن جان او هرگز نمیرد(@)(@@) (@@) - در آن شمایل موزون چو دل نگاه کند %~% هزار نامه به نقش هوس سیاه کند(@)(@@) (@@) برفت و من ز پیش آنقدر گریستهام %~% کز آب دیدهآ من کاروان شناه کند(@)(@@) (@@) - این چنین بیدل و بیچاره که ماییم امروز %~% کس ندانم که جفا داند و بر ما نکند(@)(@@) (@@) - هر که مشغول تو گشت از دگران باز آید %~% وانکه در پای تو افتاد سرافراز آید PageV01P378(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V01_0380.jpg)(@)(@)(@@) (@@) وقت جان دادن اگر بر رخت افتد نظرم %~% چشم من تا به لب گور نظر باز آید(@)(@@) (@@) - گر نقش روی خوب تو بر منظری کنند %~% آن را چو کعبه قبله1آ هر کشوری کنند(@)(@@) (@@) از حیرت جمال تو در چشم عاشقان %~% چندان نظر نماند که بر دیگری کنند(@)(@@) (@@) - خوبرویان جفا پیشه وفا نیز کنند %~% به کسان درد فرستند و دوا نیز کنند(@)(@@) (@@) پادشاهان ممالک2 چو به نخجیر روند %~% صید را پای ببندند و2 رها نیز کنند(@)(@@) (@@) بر زبان گر برود یاد منت عیبی نیست %~% یادشاهان به غلط یاد گدا نیز کنند(@)(@@) (@@) اوحدی گر نکند یار ز تو یاد، مرنج %~% ما که باشیم که اندیشهآ ما نیز کنند؟(@)(@@) (@@) - ز شرم چون عرق از روی آن به سر بچکد %~% هزار قطرهآ خونم ز چشم تر بچکد(@)(@@) (@@) سرشک چیست که در پای 
ms298	 تو شدن حیف است %~% سواد مردمک دیده کز بصر بچکد(@)(@@) (@@) - عاشق کسی بود که چو عشقش ندا کند %~% اول قدم به راه وفا جان فدا کند(@)(@@) (@@) بر کشتگان تیغ محبت کفن مپوش %~% آن به شهید عشق که از خون ردا کند(@)(@@) (@@) - آفتاب از سر هر کوچه که بیند رویت %~% شرمش آید که در آن کوچه دگر باز آید(@)(@@) (@@) - من کشتهٔ‌ عشقم خبرم هیچ مپرسید %~% گم شده اثر من اثرم هیچ مپرسید(@)(@@) (@@) گفتند که چونی؟ نتوانم که بگویم %~% این بود که گفتم دگرم هیچ مپرسید(@)(@@) (@@) - درون خویش بپرداختم ز هر نفسی %~% مگر وفای تو کاندر میان جانم بود(@)(@@) هزار بار مرا سوختی و دم نزدم %~% که مهر در جگر و مهر بر دهانم بود(@)(@@) (@@) -نه تنها آبرویم برد و در جانم فکند آتش %~% که خاکم کرد و خاکم نیز هم بر باد خواهد شد(@)(@@) - قیامت میکند بلبل سحرگاه %~% مگر گل فتنهآ آخر زمان شد؟(@)(@@) (@@) - خدنگ غمزهآ شوخت4 ز جوشن دل ما %~% گذار کرد چو سوزن که در حریر شود(@)(@@) (@@) - هزار قافله سرگشته شد زهر جانب %~% بدان امید که راهی به جانب تو برند(@)(@@) (@@) به بوی5 آنکه ببیند سایهآ تو ز دور %~% چو سایه کوی به کوی چو باد در به درند PageV01P379(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V01_0381.jpg)(@)(@)(@@) (@@) رخش روا بود ار اسب دلبری تازد %~% که گوی سیم به چوگان مشک میبازد(@)(@@) (@@) از ذره بیشترندش کنون وفا داران1 %~% سزا بود که دل از مهر ما بپردازد(@)(@@) (@@) - به سوی ما خبر او ز هیچ باب نیامد %~% هزار نامه نوشتم یکی جواب نیامد(@)(@@) (@@) خیال روی تو گفتم شبی به خواب ببینم %~% گذشت صدشب و در دیده هیچ خواب نیامد(@)(@@) (@@) سر نگردانم ازو، گر به سرم گرداند %~% بنهم گردن اگر خاک درم گرداند(@)(@@) (@@) روی بنمود و چو مشتاق شدم بار دگر %~% باز پوشید که مشتاقترم گرداند(@)(@@) گر کسی در عشق آهی میکند %~% تا نپنداری گناهی میکند(@)(@@) عشق را آن کز خرد سازد سپر1 %~% دفع کوهی را به کاهی میکند 
