ms2093	 بن صبيح، وروى عنه محمد بن أبي عمير.(@)(@@) الكافي: ج 4، ك 3، ب 151، ح 1.(@)(@@) * وروى عن علي بن رئاب، وروى عنه محمد بن أبي عمير.(@)(@@) الكافي: ج 4، ك 3، ب 151، ح 1.(@)(@@) * وروى عن عيسى شلقان، وروى عنه ابن عمير.(@)(@@) الكافي: ج 2، ك 1، ب 182، ح 3.(@)(@@) * وروى عن محمد بن مسلم، وروى عنه عبد الله بن سنان.(@)(@@) الكافي: ج 3، ك 4، ب 66، ح 2.(@)(@@) * وروى عن منصور، وروى عنه ابن أبي عمير.(@)(@@) الكافي: ج 4، ك 3، ب 191، ح 10، والتهذيب: ج 5، ح 116 (الاستبصار:(@)(@@) ج 2، ح 989) وفيه منصور بن حازم.(@)(@@) * وروى عن منصور بن حازم، وروى عنه ابن أبي عمير.(@)(@@) الكافي: ج 4، ك 3، ب 52، ح 3، وب 53، ح 1، وب 106، ح 2، وب 183، ح 8.(@)(@@) والتهذيب: ج 5، ح 106، 123، 1086 (الاستبصار: ج 2، ح 629) و 1218 (الاستبصار: ج 2، ح 629) و 1634 (الاستبصار: ج 2، ح 629).(@)(@@) وروى عنه محمد بن أبي عمير.(@)(@@) التهذيب: ج 4، ح 680، والتهذيب: ج 5، ح 739 (الاستبصار: ج 2، ح 963) وفيه ابن أبي عمير فقط.(@)(@@) * وروى عن رجل عن أبي عبد الله عليه السلام، وروى عنه ابن أبي عمير.(@)(@@) الكافي: ج 6، ك 9، ب 11، ح 1.(@)(@@) التهذيب: ج 5، ح 554 (الاستبصار:(@)(@@) ج 2، ح 859).(@)(@@) * وروى عن غير واحد عن أبي عبد الله عليه السلام، وروى عنه ابن أبي عمير.(@)(@@) الكافي: ج 4، ك 3، ب 147، ح 8.(@)(@@) التهذيب: ج 5، 532.(@)(@@) * وروى مرسلا، وروى عنه محمد بن PageV07P376(@)(@@) أبى عمير.(@)(@@) التهذيب: ج 6، ح 188.(@)(@@) * وروى مرفوعا عن أمير المؤمنين عليه السلام، وروى عنه بن أبي عمير.(@)(@@) الكافي: ج 1، ك 2، ب 16، ح 1.(@)(@@) * وروى عمن ذكره عن أبي جعفر عليه السلام، وروى عنه محمد بن عيسى.(@)(@@) الكافي: ج 1، ك 4، ب 116، ح 3.(@)(@@) * وروى عمن ذكره عن أبي عبد الله عليه السلام، وروى عنه ابن أبي عمير.(@)(@@) الكافي: ج 6، ك 7، ب 37، ح 4، والكافي:(@)(@@) ج 7، ك 3، ب 3، ح 2.(@)(@@) حفص بن غياث * روى عن أبي عبد الله عليه السلام.(@)(@@) الفقيه: ج 1، ح 1493، والفقيه: ج 2، ح 102.(@)(@@) وروى عنه جميل بن دراج.(@)(@@) الكافي: ج 6، ك 8، ب 26، ح 2.(@)(@@) وروى عنه داود.(@)(@@) الكافي: ج 2، ك 3، ب 13، ح 6.(@)(@@) وروى عنه سليمان.(@)(@@) التهذيب: ج 3، ح 78.(@)(@@) وروى 
ms2094	 عنه سليمان بن داود.(@)(@@) الكافي: ج 5، ك 4، ب 18، ح 2، والكافي:(@)(@@) ج 7، ك 5، ب 9، ح 1، وك 7، ب 17، ح 13. التهذيب: ج 8، ح 1141 (الاستبصار: ج 4، ح 186، وفيه سليمان ابن داود المنقري).(@)(@@) وروى عنه داود بن سليمان المنقري.(@)(@@) الكافي: ج 1، ك 2، ب 4، ح 6، والكافي:(@)(@@) ج 2، ك 1، ب 47، ح 3، وب 61، ح 2، وب 67، ح 2، وب 107، ح 12، وب 202، ح 4، والكافي: ج 3، ك 4، ب 75، ح 9.(@)(@@) والروضة: ح 98، 108. الفقيه: ج 1، ح 1235. والفقيه: ج 3، ح 92. والفقيه:(@)(@@) ج 4، ح 179، 748.(@)(@@) والتهذيب: ج 4، ح 336، والتهذيب: ج 6، ح 230، 255، 262، 695، 871، 1191 (الاستبصار: ج 3، ح 440، وفيه سليمان بن داود فقط)، والتهذيب: ج 7، ح 794 (الاستبصار: ج 3، ح 440، وفيه سليمان بن داود المنقري)، والتهذيب:(@)(@@) ج 8، ح 1175 (الاستبصار: ج 4، ح 186)، والتهذيب: ج 10، ح 621.(@)(@@) وروى عنه سليمان بن داود المنقري أبو أيوب. PageV07P377(@)(@@) التهذيب: ج 6، ح 242، 253 (الاستبصار: ج 3، ح 1، 3).(@)(@@) وروى عنه سليمان المنقري.(@)(@@) الكافي: ج 2، ك 1، ب 37، ح 8، وب 203، ح 15، والكافي: ج 5، ك 1، ب 10، ح 2.(@)(@@) وروى عنه علي بن شجرة.(@)(@@) الكافي: ج 5، ك 2، ب 136، ح 5.(@)(@@) وروى عنه المنقري.(@)(@@) الكافي: ج 1، ك 2، ب 14، ح 3، 4، وب 15، ح 1 و 2، والكافي: ج 2، ك 1، ب 126، ح 9، 13، والكافي: ج 5، ك 1، ب 3، ح 2، وب 8، ح 6.(@)(@@) وروى عنه سليمان بن داود المنقري أو غيره.(@)(@@) الفقيه: ج 3، ح 1303.(@)(@@) * وروى عن جعفر عن أبيه عليهما السلام.(@)(@@) الفقيه: ج 1، ح 1470.(@)(@@) وروى عنه أبو جعفر عن أبيه.(@)(@@) التهذيب: ج 1، ح 506 (الاستبصار:(@)(@@) ج 1، ح 526) و 669 (الاستبصار: ج 1، ح 67)، و 735، (الاستبصار: ج 1، ح 629)، والتهذيب: ج 3، ح 67، 448، 679 (الاستبصار: ج 1، ح 1618).(@)(@@) وروى عنه سليمان بن داود المنقري.(@)(@@) التهذيب: ج 9، ح 1364.(@)(@@) وروى عنه محمد بن يحيى الخزاز.(@)(@@) الكافي: ج 3، ك 4، ب 70، ح 5.(@)(@@) وروى عنه يونس بن هشام.(@)(@@) التهذيب: ج 4، ح 1045.(@)(@@) * وروى عن أبي الحسن الأول موسى بن جعفر عليهما السلام، وروى عنه سليمان بن داود المنقري.(@)(@@) التهذيب: ج 6، ح 1103.(@)(@@) * وروى عن الحجاج، وروى عنه ابن محبوب.(@)(@@) الكافي: ج 3، ك 3، ب 2، ح 8.(@)(@@) * وروى عن ليث، وروى عنه محمد ابن حفص.(@)(@@) التهذيب: ج 1، ح 880 (الاستبصار:(@)(@@) ج 1، ح 728).(@)(@@) * وروى عن الزهري، وروى عنه 
ms2095	 سليمان بن داود.(@)(@@) الكافي: ج 2، ك 3، ب 4، ح 2.(@)(@@) * وروى مضمرة، وروى عنه سليمان ابن داود المنقري.(@)(@@) التهذيب: ج 6، ح 246. PageV07P378(@)(@@) الحكم بن الأيمن * روى عن أبي بصير، وروى عنه علي بن عقبة.(@)(@@) الكافي: ج 1، ك 4، ب 94، ح 8.(@)(@@) * روى عن أبي خالد الكابلي، وروى عنه ابن أبي عمير.(@)(@@) التهذيب: ج 4، ح 412.(@)(@@) * وروى عن أبان بن تغلب، وروى عنه ابن أبي عمير.(@)(@@) الكافي: ج 2، ك 1، ب 83، ح 6.(@)(@@) * وروى عن داود الابزاري، وروى عنه ابن أبي عمير.(@)(@@) الكافي: ج 3، ك 3، ب 95، ح 19.(@)(@@) وروى عنه علي بن الحكم.(@)(@@) الكافي: ج 2، ك 1، ب 61، ح 14.(@)(@@) * وروى عن زيد الشحام أبى أسامة، وروى عنه ابن بقاح.(@)(@@) الكافي: ج 6، ك 6، ب 56، ح 3.(@)(@@) * وروى عن صدقة الأحدب، وروى عنه محمد بن زياد.(@)(@@) الكافي: ج 2، ك 1، ب 83، ح 3 وذيله.(@)(@@) * وروى عن غياث بن إبراهيم.(@)(@@) وروى عنه ابن أبي عمير.(@)(@@) الكافي: ج 5، ك 2، ب 136، ح 3، والتهذيب: ج 7، ح 619.(@)(@@) * وروى عن القاسم شريك مفضل، وروى عنه الحسين بن سعيد.(@)(@@) الكافي: ج 2، ك 1، ب 14، ح 6.(@)(@@) وروى عن القاسم الصيرفي شريك المفضل، وروى عن أبي عمير.(@)(@@) الكافي: ج 2، ك 1، ب 14، ح 1.(@)(@@) * وروى عن يوسف الطاطري، وروى عنه صفوان بن يحيى.(@)(@@) الكافي: ج 4، ك 3، ب 111، ح 3.(@)(@@) الحكم بن عتيبة.(@)(@@) روى عن الحسين بن علي عليه السلام، وروى عنه الحارث بن الحضيرة.(@)(@@) الكافي: ج 1، ك 4، ب 99، ح 2.(@)(@@) * وروى عن علي بن الحسين عليه السلام، وروى عنه زياد بن سوقة.(@)(@@) الكافي: ج 1، ك 4، ب 54، ح 2.(@)(@@) * وروى عن أبي جعفر عليه السلام، وروى عنه إسحاق بن عمار عن رجل من أصحابنا.(@)(@@) الروضة: ح 30.(@)(@@) وروى عنه زياد بن سوقه. PageV07P379(@)(@@) الكافي: ج 7، ك 4، ب 37، ح 1، 2، والفقيه: ج 4، ح 253، 351. التهذيب:(@)(@@) ج 10، ح 681، 1004، 1005، (الاستبصار: ج 4، ح 1089).(@)(@@) وروى عنه معاوية بن عمار.(@)(@@) التهذيب: ج 5، ح 1207، 1309 (الاستبصار: ج 2، ح 727).(@)(@@) وروى عنه معاوية بن ميسرة.(@)(@@) الكافي: ج 6، ك 8، ب 5، ح 1، وب 47، ح 2، والروضة: ح 404، والتهذيب: ج 7، ح 1887.(@)(@@) * وروى عن أبي عبد الله عليه السلام، وروى عنه إسماعيل بن إبراهيم.(@)(@@) الكافي: ج 2، ك 1، ب