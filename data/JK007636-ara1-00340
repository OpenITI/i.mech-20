ms321	 فكري عن هواه ولا لها % % 13(@)(@@) % بأبي مضيء الحسن ناء شخصه % % سلت الكواكب حسنها وجمالها % % 14(@)(@@) % متلون الأخلاق إلا أنها % % لشقاوتي ليست تمل ملالها % % 15(@)(@@) % لوذاق حالة مهجتي ما راعني % % دعه يروع ولا يقاسي حالها % % 16(@)(@@) % هي مهجة ليست يجاور صبرها % % كيد المؤيد لا يجاور مالها % % 17(@)(@@) % جادت يد الملك المؤيد جود من % % لم تخش بسطة كفه إقلالها % % 18(@)(@@) % يا عاذل الملك المؤيد في الندى % % هي صبوة قد أتعبت عذالها % % 19(@)(@@) % و شمائل مدت يمين مكارم % % لم ترض أن يدعى الغمام شمالها % % 20(@)(@@) % سبقت سؤال عفاتها وتعقمت % % في الجود حتى سابقت آمالها % % PageV01P1469 21(@)(@@) % مالابن شاد في العلى مثل فدع % % علياه تضرب في الورى أمثالها % % 22(@)(@@) % رقمت بنو أيوب نسخة أصلها % % وأتى فكان تمامها وكمالها % % 23(@)(@@) % ملك تطاولت المطالب نحوه % % لكنه بأقل طول طالها % % 24(@)(@@) % متطابق النعماء صانت كفه % % سرح القريض وشردت أموالها % % 25(@)(@@) % أخذت براءته العفاة بدهره % % مما تخاف وقسمت أنفالها % % 26(@)(@@) % نعماه في عصب قلائد حليها % % فاذا بغت عصب غدت أغلالها % % 27(@)(@@) % يارب مكرمة ورب كريهة % % أضحى معيد حياتها قتالها % % 28(@)(@@) % و مسائل في العلم أشكل أمرها % % حلا وحل لطالب أشكالها % % 29(@)(@@) % بيراع سيف أو بسيف يراعة % % فصل الامور جلادها وجدالها % % 30(@)(@@) % قل للمثل في البسيطة وصفه % % دع سحبها وبحارها وجبالها % % PageV01P1470 31(@)(@@) % هاتيك أمثلة دنت عن قدره % % فاطلب لهاتيك الصفات مثالها % % 32(@)(@@) % لحماك يا ابن المالكين ترقبت % % فكر الرجا رقبى العيون هلالها % % 33(@)(@@) % أما حماه فنعم دار سيادة % % نصبت بمدرجة الطريق جلالها % % 34(@)(@@) % يسعى لمكة وافد ولأرضها % % ولنعم أرضا وافد يسعى لها % % 35(@)(@@) % هاتيك قبلة من يروم رشادها % % وحماه قبلة من يروم نوالها % % 36(@)(@@) % في كل حال حولها لي معجب % لله ما أشهى إذا أحوالها % % 37(@)(@@) % شكرت لهاك فما أشك بأنني % % ثقلت وهي مطيقة أثقالها % % 38(@)(@@) % أغنيتني عن كل ذي مال فلم % % أفتح يدا لسوى نداك ولا لها % % 39(@)(@@) % و كفيتني حتى قفوت معاشرا % كثر النددى فاستكثرت أطفالها % % 40(@)(@@) % أيام مالي غير قصدك حيلة % % تنجي وتنجح في الورى نطالها 
ms322	 % % PageV01P1471 41(@)(@@) % لازلت مقصود الحمى بقصائد % % أصبحت عصمة أمرها وثمالها % % 42(@)(@@) % لولاك لم يخطر ببالي نظمها % % لا والذي يلقاك أنعم بالها % % 43(@)(@@) % سألت روايات الندى فتأخرت % % عنها الورى وأجزت أنت سؤالها % % PageV01P1472 البحر : - 1(@)(@@) % سلوت لكن قلبي يا سعاد سلي % % وأنت في الحل من قلبي ومن قبلي % % 2(@)(@@) % قد جاء ما جاء من رأي ومن رشد % وزال مازال من غي ومن زلل % % 3(@)(@@) % لا الرشد ساعدني من قبل ذاك ولا % % إصالة الرأي صانتني عن الخطل % % 4(@)(@@) % ولا الوجوه قناديل تخادعني % % في الحسن في طرر الاصداغ كالقبل % % 5(@)(@@) % حتى أضا الشيب في فودي فأرشدني % % إلى الهدى في سواد الرأس كالشعل % % 6(@)(@@) % فلا الخلاعة بعد اليوم من أربي % % ولا التغزل في الأشعار من شغلي % % 7(@)(@@) % و غاض ماء الشباب قد عصيت به % % رأي النصيح فلم أسمع ولم أخل % % 8(@)(@@) % و لا حصلت على دنيا وآخرة % % الا بدولة من أنشا ذوي الدول % % 9(@)(@@) % أنشي مدائح سلطان العباد بلا % % لغو وأتلو معانيها بلا خلل % % 10(@)(@@) % الناصر اسما وألقابا وأفعلة % فانظر لنصر على عطفيه مشتمل % % PageV01P1473 11(@)(@@) % ملك تنقل في مدح يلذ له % % يا لذة النقل أو يا لذة النقل % % 12(@)(@@) % سلطان مصر الرخا والأمن عم فما % % بها سوى النيل قطاع على السبل % % 13(@)(@@) % أسعى لأبوابه العليا يبشرني % % بشيرها بنجاح القصد والأمل % % 14(@)(@@) % و تنتهي بي إلى أبوابه مدح % % تخطو وتخطر بين الحلي والحلل % % 15(@)(@@) % من فضل جدواه أرجوها فيغرقني % % بحر لديه بحار الأرض كالوشل % % 16(@)(@@) % ينجي الغريق اذا أعطى وبعض مضا % % سيوفه تفرق الأعداء بالبدل % % 17(@)(@@) % جودا وبأسا كأن الأرض بينهما % % لم تبد عشبا سوى الأقلام والأسل % % 18(@)(@@) % مقسم السيف والأقلام يوم ندى % % ويوم هيجاء بين الرزق والأجل % % 19(@)(@@) % أوفى الملوك اذا عدوا لسابقة % تلو الزمان وتلو الأعصر الأول % % 20(@)(@@) % جاؤوا على عجل لا يلحقون مدا % % سبق كأنهم جاؤا على مهل % % PageV01P1474 21(@)(@@) % وشائد الملك مشغول بأربعة % % من العطا والسطا والعلم والعمل % % 22(@)(@@) % نجل الملوك اذا جروا عساكرهم % % ألهتهم الطعنة النجلا عن النجل % % 23(@)(@@) % وصرفوا الرأي في عدل 
ms323	 ومعرفة % حتى بكل طرير السن معتدل % % 24(@)(@@) % ذو الرأي والراية العلياء سيرته % % عمالة الجد بين الحيل والحيل % % 25(@)(@@) % ان لم تكن سيرة البطال فهي بما % % أذاقه للأعادي سيرة البطل % % 26(@)(@@) % يامن اذا شغل الاملاك لهوهم % % فنفسه بالتقى والملك في شغل % % 27(@)(@@) % تهن عاما مضيء السعد متصلا % بألف عام مضيء السعد متصل % % 28(@)(@@) % عام يقول على رأسي سعت قدمي % % لرأس عام بهذا العام محتفل % % 29(@)(@@) % و كالهلال حبي طهر السلام إلى % % بدر فيا حسن مهلول ومكتمل % % 30(@)(@@) % و العشر قبل من يمناك خمستها % % عشرا وعشرا ولا يروى من القبل % % PageV01P1475 31(@)(@@) % فدى لطلعتك الأقمار طالعة % % بعد الأهلة كالأخوال والخول % % 32(@)(@@) % متى يوفي مقال المدح ما عملت % % نعماك شتان بين القول والعمل % % 33(@)(@@) % فعش ودم للعلى والملك مطلعا % على المفاخر طلاعا على القلل % % 34(@)(@@) % نلنا المنى السهل يامن حلمه جبل % يا فائض الفضل بين السهل والجبل % % PageV01P1476 البحر : - 1(@)(@@) % إنسان عيني بتعجيل السهاد بلي % % عمري لقد خلق الانسان من عجل % % 2(@)(@@) % إن أكتم الحب لم تكتم دلائله % % وان أمل لطريق الصبر لم أمل % % 3(@)(@@) % شوقا لمحرسة العذال إن نظرت % % سباقة لسيوف اللحظ للعذل % % 4(@)(@@) % نشيطة العطف كحلا الطرف لو كحلت % % لم يرفع الميل جفنيها من الكسل % % 5(@)(@@) % عدمت صبري ولم أظفر بريقتها % % فما حصلت على صاب ولا عسل % % 6(@)(@@) % نالت برغم الغواني فوق ما وصفوا % % بالحيل حسنا ونالوا البعض بالحيل % % 7(@)(@@) % هذا وكم غزلت أجفان مقلتها % % ثوب السقام لجسم الباسل البطل % % 8(@)(@@) % غزالة الجفن من غزلان مصر لقد % % ملأت من غزلك الدنيا ومن غزل % % 9(@)(@@) % سقيا لعهد الصبا أيام أسبقها % % طورا وتسبقني للهو والجدل % % 10(@)(@@) % أصيدها في حبال الشعر عاثرة % % يا حبذا الظبي في إشراك محتبل % % PageV01P1477 11(@)(@@) % وقد أطارح ورق البان حين نأت % % منها النواح ومني دمع منهمل % % 12(@)(@@) % و استصح بمعتل الصبا جسدي % % وربما صحت الأجسام بالعلل % % 13(@)(@@) % لا الصبر ساعد قلبي في السلو ولا % % إصالة الرأي صانتني عن الخطل % % 14(@)(@@) % حتى أضا الشيب في فودي فأرشدني % % إلى الهدى في ظلام الفود بالشغل 
ms324	 % % 15(@)(@@) % فما الصبابة بعد اليوم من أربي % % ولا التغزل في الأمداح من شغلي % % 16(@)(@@) % يامن له تركع الأفلام مادحة % % كأنها من قبيل الطرس في قبل % % 17(@)(@@) % أنت الذي أنبتت ملك الجنان له % % دعوى مكاتبه في المحضر الجلل % % 18(@)(@@) % يامن رأى جوده العافون منشرحا % فوجهوا العيس تطوي الرمل بالرمل % % 19(@)(@@) % تهن عيدا سعيد الفضل حين فدى % % نعليك بالناس من حاف ومنتعل % % 20(@)(@@) % خير الممالك في خير المواسم يا % % خير السلاطين يأتي خيرة الدول % % PageV01P1478 21(@)(@@) % عداك من جملة الأنعام سارحة % % فصل وانحر ودم وافخر وصل وصل % % 22(@)(@@) % و الحظ مدائح عبد قد أجاد بما % % جادت يداك به من ماطر هطل % % 23(@)(@@) % لي في ذوي النظم روض يستطاب شذا % % ريحانه الغض أو نوارة الخضل % % 24(@)(@@) % تحمى البزاة بغاث الطير حوزته % % فالورق طيارة عنه مع الحجل % % 25(@)(@@) % و أنت غيث على ناء ومقترب % % فصانك الله في حل ومرتحل % % 26(@)(@@) % و لا تزل للورى جبرا لمنكسر % % وقرا لمفتقر ملكا لممتثل % % 27(@)(@@) % ربيع عدلك في الأقطار منتشر % فكل يوم حلول الشمس في الحمل % % PageV01P1479 البحر : - 1(@)(@@) % غازلتنا فأعيدي ماضي الغزل % % شواهر البيض من مسودة المقل % % 2(@)(@@) % إنا إلى الله تلهينا الأوانس عن % % مساجد النسك بالاصداع كالقبل % % 3(@)(@@) % غيد بدت فتولى الظبي من حنق % % يسعى وأطرق غصن البان من خجل % % 4(@)(@@) % بأوجه من بني بدر تناضلنا % % من دونها لحظات من بني ثعل % % 5(@)(@@) % من كل مسكرة الألحاظ مائسة % % يهزها الدل هز الشارب الثمل % % 6(@)(@@) % معسولة الثغر إلا أن قامتها % % منسوبة القد للعسالة الذبل % % 7(@)(@@) % يلذ لي هجرها مع بغضها بدلا % من البعاد ومن للعثور بالحول % % 8(@)(@@) % عدمت صبري ولم أظفر بريقتها % % فما حصلت على صاب ولا عسل % % 9(@)(@@) % و عاذلي ليس يدري أن ناظرها % % سيف إلى قتل مثلي سابق العذل % % 10(@)(@@) % خالي الحشا ان دعا فكري لشكواته % % أجاب دمعي وما دمعي سوى طلل % % PageV01P1480 11(@)(@@) % يامن تملك سكنى القلب معطفها % % أعلى الممالك ما يبنى على الأثل % % 12(@)(@@) % ماذا على العاذل الجهمي منظره % % إن الصبابة من كسبي ومن عملي % % 13 
ms325	(@)(@@) % و ماعلى ظاهري من محاسنها % % إني على الصبر فيها أي معتزل % % 14(@)(@@) % لم أنس اذ زارني طيف الخيال بها % % يخطو ويخطر بين الحلي والحلل % % 15(@)(@@) % مأمورة الوصل والهجران جائرة % % بالردف والعطف بين الريث والعجل % % 16(@)(@@) % سقيا لعطف على ردف ينوء به % % وحبذا جبل الريان من جبل % % 17(@)(@@) % و حبذا غزلي في الخصر قلت له % % يا خير منتحل في خير منتحل % % 18(@)(@@) % و حبذا العيش والأيام مسعفة % ومصر داري وأحبابي بها خولي % % 19(@)(@@) % يا بارقا من نواحي مصر مبتسما % بلغ تحية هامي الدمع منهمل % % 20(@)(@@) % واذكر اذا هب معتل الصبا جسدي % % فربما صحت الأجساد بالعلل % % PageV01P1481 21(@)(@@) % و الملك يصلح عقباها بصالحه % % والفضل يقسم من ساداتها بعلي % % 22(@)(@@) % رب العطا والنقا إن شمت برقهما % % علمت أن عليا كيف شاء ولي % % 23(@)(@@) % الباذل الوفر في بدو وفي حضر % % والجامع الحمد من سهل ومن جبل % % 24(@)(@@) % لله كم للعلى بكر محجبة % زفت اليه لقد زفت إلى رجل % % 25(@)(@@) % ثبت الجوانب والدنيا مزلزلة % % وصائل الرأي والقرضاب لم يصل % % 26(@)(@@) % و الكامل الذات يروي فضل سؤدده % % عوالي الفضل عن آبائه الكمل % % 27(@)(@@) % تجمعت فيه أقسام الفخار كما % % تجمعت قسم التفصيل في الجمل % % 28(@)(@@) % نوال عز أضافته الصفات إلى % % تدبير محتنك في عزم مكتهل % % 29(@)(@@) % إذا سقى ماله الظمآن أتبعه % % جاها فيا لك من عل على نهل % % 30(@)(@@) % في مصر والشام يرجى سحب ذي كرم % % بالجود مشتهر بالحمد مشتمل % % PageV01P1482 31(@)(@@) % مطابق الوصف فوق النجم موضعه % % والجود يدنيه قيس الكف للأمل % % 32(@)(@@) % لو قال طلت السهى قال الأنام نعم % % يا صادق القول والعلياء فقل وطل % % 33(@)(@@) % مازال يعدل حتى ما بمصر سوى % % من فائض النيل قطاع على السبل % % 34(@)(@@) % و منشئ اللفظ نبعا للقلاع فما % % يرى كنبعك طلاعا على القلل % % 35(@)(@@) % نعم الفتى أنت في السادات اكبر من % % مثل وأسير في الأوصاف من مثل % % 36(@)(@@) % و ابرع الناس نطقا ليس محتفلا % فكيف حين يراعى فكر محتفل % % 37(@)(@@) % في كفه قلم ناهيك من قلم % % ومن حسام ومن رزق ومن 
ms326	 أجل % % 38(@)(@@) % معدل بشهادات العلى وله % % جراح يوم سطا يقذفن بالقتل % % 39(@)(@@) % حكاه في قطعه حد الحسام وما % % حكاه في مقبل الأرزاق متصل % % 40(@)(@@) % سد يا علي فما أبقيت منقبة % % يمتاز عنك بها في الأعصر الأول % % PageV01P1483 41(@)(@@) % تحفى بمدحك أقلام مننت على % % آمالها وعلى الأسياف في الخلل % % 42(@)(@@) % يا باسط الجود في سيف وفي قلم % % لقد مننت على حاف ومنتعل % % 43(@)(@@) % يا ابن السراة إلى الفاروق نسبتهم % % وجمعهم لفخار القول والعمل % % 44(@)(@@) % البالغين مدى العليا ولو قعدوا % % والسابقين ولو ساروا على مهل % % 45(@)(@@) % من كل فاتح أرض غير طائعة % % مبارك الفتح أنى سار والقفل % % 46(@)(@@) % فكل مقترب الأقلام ساجدها % % بأشرف اللفظ يحمي أشرف الملل % % 47(@)(@@) % بلغتني يا ابن فضل الله مطلبا % لم أرجه من بني الدنيا ولم أخل % % 48(@)(@@) % نلت العلى وكبت الحاسدين على % % يد اغتنائك لا حيلي ولا حيلي % % 49(@)(@@) % وقد سموت لديوان الرسائل في % % طي ادكارك لا كتبي ولا رسلي % % 50(@)(@@) % مدا أخوك إلى مرقاه أوصلني % % ولو ترقى اليه النسر لم يصل % % PageV01P1484 51(@)(@@) % و إن تعذر معلومي عليه ففي % % معلوم جودك أو في مدحه شغلي % % 52(@)(@@) % ان مد قصدي في الدنيا لغيركم % % يد الرجا فرماها الله بالشلل % % 53(@)(@@) % بلغتم آل فضل الله منزلة % % تحول زهر الدراري وهي لم تحل % % 54(@)(@@) % يخف نظم المعاني في مدائحكم % % وفي سواكم فما يخلو من الثقل % % 55(@)(@@) % و يألف الناس عطفا من عوارفكم % % فما تميل أوانيهم إلى بدل % % 56(@)(@@) % أنتم رجائي الذي وحدت مقصده % % في العالمين ولم أعكف على هبل % % 57(@)(@@) % مالي وما للسرى قصدا لغيركم % % هيهات لا ناقتي فيها ولا جملي % % 58(@)(@@) % فما لإيضاح لفظي لا يضيئ بكم % % وقد بذلتم له الأموال بالجمل % % 59(@)(@@) % فدونكم من ثنائي كل سائرة % % مرخى لها في عنان القول بالطول % % 60(@)(@@) % سيارة في بسيط النظم مسرعة % % فياله من بسيط جاء في رمل % % PageV01P1485 61(@)(@@) % اسعى على درر المعنى بأبحرها % % وسعي غيري في مستفعلن فعل % % 62(@)(@@) % بقيتم يا بني العلياء في نعم % ملء الزمان وفي أمن وفي جذل % % 63 
ms327	(@)(@@) % تقاسم الناس في أيام سؤددكم % % يوما وليلا فمن مثن ومبتهل % % PageV01P1486 البحر : - 1(@)(@@) % في ثغرها الحلو أو في جيدها الحالي % % لا أرغم الله الا أنف عذالي % % 2(@)(@@) % ان يسل قلبي بنار في محبتها % % فلا وحق هواها لست بالسالي % % 3(@)(@@) % غزالة الحي إشراقا وملتفتا % ما كفؤ جيدك الا عقد أغزالي % % 4(@)(@@) % جملت بيتي من نظم ومن نسب % يا ابنة العم أو يا ربة الخال % % 5(@)(@@) % يا حبذا الخال اكسيرا على ذهب % ما مثله بسويدا مهجة غالي % % 6(@)(@@) % ولا بأسود عين ربما ربحت % % بلمحة الردف قنطارا بمثقال % % 7(@)(@@) % كحلت بالسهد جفنيها وقد وصلت % % مسافة النأي أميالا بأميال % % 8(@)(@@) % في كل ليل مديد مثل شعرك ما % % مددت للصبر فيها عزم محتال % % 9(@)(@@) % حبال شعرك يا لمياء صيرني % % إلى التصبر أمشي مشي حبالي % % 10(@)(@@) % و طول حبك قطاع عرى جلدي % % فليت طيفك وصى لي بوصال % % PageV01P1487 11(@)(@@) % يزور الوصل عن لمياء تحكم لا % % حكم الاذلة لكن حكم ادلال % % 12(@)(@@) % شامية بين جفنيها يمانية % % تقد بالسحر قلبا قبل أوصال % % 13(@)(@@) % ماضي الولاية في العشاق ناظرها % % وا حر قلباه من ذا الناظر الوالي % % 14(@)(@@) % مجانس الحسن من فيها ومعطفها % % فالحسن ما بين معسول وعسال % % 15(@)(@@) % و قيل أسماء في أفعالها عنت % فالحزن ما بين أسماء وأفعال % % 16(@)(@@) % بينا تروي بوصل أظمأت بجفا % % فخالطت رمضانا لي بشوال % % 17(@)(@@) % كانت عن المرتضى تملي أماليها % % واليوم تروي أماليها عن القالي % % 18(@)(@@) % و عاذلين عليها زلزت بهم % أرض التجلد عندي كل زلزال % % 19(@)(@@) % ان حدثتهم بأخبار الأسى فلما % % قد أخرجت لي منهم أي أثقال % % 20(@)(@@) % من كل داع وماجاوبته سقما % % كأنه واقف مني بأطلال % % PageV01P1488 21(@)(@@) % ان كل لي أمل في الصبر عنك فلا % % بلغت من نفحات القرب آمالي % % 22(@)(@@) % حبي جديد على مر الزمان فلا % % يخطر حديث سلوي منك في بال % % 23(@)(@@) % ودمع عيني مثل السحب جائدة % % بالدمع جود علاء الدين بالمال % % 24(@)(@@) % ذو الفضل إرثا وكسبا وابنه نسبا % وأكثر الناس إفضالا لأفضال % % 25(@)(@@) % و ذو الجبلة من أصفى جواهرها % % والناس من 
ms328	 حمإ فيها وصلصال % % 26(@)(@@) % و ابن الغطاريف أشخاص العلى ورثوا % % عصر السيادة في النآئي وفي الحال % % 27(@)(@@) % المرغمين بما تعطي الخلافة من % % درياق فاروقهم آناف أشكال % % 28(@)(@@) % و الصائنين بأقلام وحد ظبا % % مسارح الملك من اهواء أهوال % % 29(@)(@@) % خلاصة العرب العرباء من فصح % ان قاولوا أو مصابيح وأبطال % % 30(@)(@@) % تسري المطي اليهم أو تفوز بهم % % قدورهم فهي دأبا ذات أرقال % % PageV01P1489 31(@)(@@) % بطحاء مكة غرس المفرقين وفي % % أعلام مصر ظلال الدوح والضال % % 32(@)(@@) % أما علي فقد ضاءت مناسبه % % ونفسه في سراة الصحب والآل % % 33(@)(@@) % قد دبرت مصر والامصار فكرته % % يومي نزال بقطريها وإنزال % % 34(@)(@@) % هو الموفق في معنى رسائلها % % لكنه ابن وزير لا ابن خلال % % 35(@)(@@) % تقول مصر يحامي عن ممالكها % % أقوال هذا من الأطلال أقوى لي % % 36(@)(@@) % بالنصر يعلي سمائي عند مرتقب % % والعدل يخصب أرضي عند اقحالي % % 37(@)(@@) % فليفخر الملك بالكافي الذي انعقدت % % عليه آراء إجماع وإجمال % % 38(@)(@@) % و المودع السر في أحياء مقفله % % وحمده عند رحال وقفال % % 39(@)(@@) % و الباسط الأمن بالأقلام في أمم % % كأنهم من حماها بين أغيال % % 40(@)(@@) % بالمشبع الخمص حيث القاصدون له % % كالطير تتبع ارسالا بارسال % % PageV01P1490 41(@)(@@) % و المنشئ اللفظ تبرا طي أنعمه % % وكل جيد بها أو مسمع حالي % % 42(@)(@@) % نهدي له اللفظ أسمالا فيقبلها % % عواطف الخير من سحاب أذيال % % 43(@)(@@) % يا ساحب الذيل من لفظ وفضل علا % % هل أنت مصغ لما تمليه أسمالي % % 44(@)(@@) % عاثت يد الدهر في يومي وقد بليت % % أضعاف ما بليت بالهم أقوالي % % 45(@)(@@) % و نفر الكلم اللاتي أغازلها % % ما نفر الغيد من شيبي وإقلالي % % 46(@)(@@) % أقول للهم ذي التجديد لي جلد % ملآن يا هم فاطلب منزلا خالي % % 47(@)(@@) % و خلعة لا ارى لي من يروقها % % من حيلة مع أني مثل بطال % % 48(@)(@@) % لرفقتي من جياد الخيل أكملها % % ولي جواد ولكن ناقص الدال % % 49(@)(@@) % أمشي على قدمي والحال واقفة % % فيها فهلا يكون المشي في حالي % % 50(@)(@@) % فرغ بعطفك ذهني للثناء فقد % % سارت مثلي فيه غر أمثالي % % PageV01P1491 51(@)(@@) % واسمع مدائح لم يعجز تواصلها 
ms329	 % % وربما عجزت عن وقت إيصال % % 52(@)(@@) % إن لم تكن صنع وراق بمصر فقد % % جاء القريض بها من صنع لأ آل % % 53(@)(@@) % يامن تخير لفظا في مدائحه % % يبقى على مر أجيال وأحوال % % 54(@)(@@) % لا زال بابك مخدوما بأربعة % % يمن ونجح ومختار وإقبال % % PageV01P1492 البحر : - 1(@)(@@) % عيد يعود إلى هذا الثنا العال % % بخادمي أفقه يمن وإقبال % % 2(@)(@@) % مطالع بنجوم السعد حالية % على حمى ببدور الفضل محلال % % 3(@)(@@) % وحاجب من هلال العيد يقدمه % % فاهنأ به وبأمثال وأمثال % % 4(@)(@@) % كأن من رمضان النون قد مكثت % % وجدا بمرآك في آفاق شوال % % 5(@)(@@) % يشتاقك الشهر آتيه وذاهبه % % ذا قبل حل وهذا بعد ترحال % % 6(@)(@@) % كلاهما في طلاب القرب مستبق % يتلو الثناء فنعم السابق التالي % % 7(@)(@@) % يا ابن الخلافة جلي كل داجية % فزادك الله من عز وإجلال % % 8(@)(@@) % أما دمشق فقد هزت لمقدمكم % % من بعد عطف دليل عطف مختال % % 9(@)(@@) % أظل رأيك حتى صان ناديها % % ولو تأخر نادي رسم إطلال % % 10(@)(@@) % و عاضد السيف فيها السطر من قلم % % حتى أتاها بإطلاب وإبطال % % PageV01P1493 11(@)(@@) % فالآن عاد اليها خط بهجتها % % مما تعاهدها من خطك العالي % % 12(@)(@@) % غيداء وشحها ظل وخلخلها % % ماء فقد ظهرت في منظر حالي % % 13(@)(@@) % تكاد تسعى لكم بالروح خائضة % بساقها العبل في ماء وخلخال % % 14(@)(@@) % لاغرو إن بدلت من عمها بدلا % وقد أغاث حماها نجل إبدال % % 15(@)(@@) % و ناسب الصالح السلطان دولته % % بصالح يوم أقوال وأفعال % % 16(@)(@@) % كافي الممالك إن نادت براعته % % أجاب نصرتها نصبا على الحال % % 17(@)(@@) % و صاحب السر في مصر ابتدا وله % % في كل مصر مقام الحافظ الكالي % % 18(@)(@@) % و قاسم الرأي من طلاع شامخة % % ومن مشير على الأغراض نزال % % 19(@)(@@) % و معمل الخدع عند الحرب يعجز عن % % عمال ما قل منه ألف بطال % % 20(@)(@@) % و ناشر الدر فينا عند مستمع % نثر الدنانير فينا عند إقلال % % PageV01P1494 21(@)(@@) % اذا تثاقل عسر بات من يده % % تبر يصرف مثقالا بمثقال % % 22(@)(@@) % و ان دعوت به في منطق وندى % % دعوت طائي ألفاظ وإفضال % % 23(@)(@@) % دم للعلى يا ابن 
ms330	 فضل الله ذا رتب % % عزيزة يا عزيز المصر يا غالي % % 24(@)(@@) % يا بحر علم وجود فاخرن بهما % % فكل آل فخار بعد كالآل % % 25(@)(@@) % يا ملبسي عند احرام الأكابر لي % % زهرا كأن لها حجي وإحلالي % % 26(@)(@@) % شكرا لها خلعة فاءت غمامتها % % عبلي من يد هامي المزن هطال % % 27(@)(@@) % بيضاء بيض مرآها ومخبرها % % عيشي وعين حسودي زاد تسآلي % % 28(@)(@@) % و قلت جاءت من القاضي دليل رضى % % فكاد من غيظه يسعى إلى الوالي % % 29(@)(@@) % ورحت أخطر في ألفافها ألفا % وكنت من دخل في هيئة الدال % % 30(@)(@@) % ماكان يقرب ثوب القطن من قدمي % % فاليوم تسحب بالسنجاب أذيالي % % PageV01P1495 31(@)(@@) % و اليوم تنهض بالأمداح لي فكر % جدائد الحسن لم تخطر على بالي % % 32(@)(@@) % على علي معانيه واكتمها % % نعم الأمالي تلاقت نعم آمالي % % 33(@)(@@) % خذها ابن يحيى لك المحيا منظمة % نظم العقود على أجياد أحقال % % 34(@)(@@) % قدمت فيها الهنا تم المديح وما % % أخليتها بعد من عادات أغزال % % 35(@)(@@) % و قلت للرشاء الغضبان لا غمضت % % عيون قيل على عينيك يا قالي % % 36(@)(@@) % ملكت قلبا بنار الشوق ممتلئا % فما يضرك لو أحسنت يا مال % % 37(@)(@@) % لا تسأل الصب عن سلسال أدمعه % % ملذذا بتعاطيها وسل سالي % % 38(@)(@@) % من فوق خدك خال مثل غالية % % بعت السلو على أمثاله غالي % % 39(@)(@@) % يا مطلق الحسن أحشائي مفلفلة % % على محاسنه دعني وأغلالي % % 40(@)(@@) % و خل بال برجوى الطيف مشتغلا % ولا تبيتن إلا خالي البال % % PageV01P1496 41(@)(@@) % مابين غمضة عين وانتباهتها % % يقلب الهجر من حال إلى حال % % 42(@)(@@) % ان كنت اجريت دمعي في هواك بلا % % جريمة فلقد أوقفت أحوالي % % 43(@)(@@) % أوصنت عن نظري مرج العذار فلي % % هرج ومرج بأشجاني وعذالي % % 44(@)(@@) % أسكنتك القلب ياذا الخال محتكما % فيه فيا تعب المسكون بالخالي % % 45(@)(@@) % ها بهجة الشعر في وصف المليح وفي % % مدح العلاء مدى الأيام تروى لي % % 46(@)(@@) % أما وحق المعالي يا علي لقد % % بدلت إذلال أشعاري بأدلالي % % 47(@)(@@) % لا زلت كالنجم تنويرا لداجية % % زينا لمطلع رشدا لضلال % % 48(@)(@@) % ما خالفتك النجوم الزهر في شبه % إلا بتقصيرها عن 
ms331	 مجدك العالي % % PageV01P1497 البحر : - 1(@)(@@) % كل يوم سعادة مستهله % % جملة للوزير في إثر جمله % % 2(@)(@@) % كلما شدت الوزارة إزرا % حمل الجيش في المعاند حمله % % 3(@)(@@) % ودعا الخاص ثلث مرقاة والثل % % ث كثير على الذي كان قبله % % 4(@)(@@) % وأضيفت لذا وذا جمل الأنع % % أم يتلو جزيلها الحر جزله % % 5(@)(@@) % من تفاصيلها القماش رياض % مزهرات على الغيوث أدله % % 6(@)(@@) % فصلت قبلها له خلع من % % زخرف الطرز كل يوم مظله % % 7(@)(@@) % عوذتها كما ترى سور القرآ % % ن فضلا يلائم الشكل شكله % % 8(@)(@@) % هكذا هكذا تكون تفاصي % % ل عطايا يعوذها الملك بالله % % 9(@)(@@) % سايرتها خيل العطا مسرجات % % في حلاها ومسرجات الأهله % % 10(@)(@@) % كنسيم الصبا جنائب خطو % كل طرف يقبل البرق نعله % % PageV01P1498 11(@)(@@) % و بغال مثل البروج تحمل % % ن سعودا بعينها مستقله % % 12(@)(@@) % لا كبغل بمصر اذ قلت قدما % فيه أو في بغال صحبي الأذله % % 13(@)(@@) % لي بغل لا يعرف الأكل عندي % % غير أن المياه للشرب سهله % % 14(@)(@@) % ليس في بطنه سوى الماء صرفا % إن بغلي على الحقيقة قله % % 15(@)(@@) % خل هذا واذكر منازل قصر % % فاسمي قد قسم السعد نزله % % 16(@)(@@) % بوزير فخر اسمه وعلاه % % مثلما كان أهلها كن أهله % % 17(@)(@@) % خير دار حلت بها خير دار % % يا سعيد الدارين يا ركن مله % % 18(@)(@@) % و اهتمام قد شاع ذكرا وشكرا % ما روت مثله التواريخ قبله % % 19(@)(@@) % كل ربع سماطه كربيع % % صاح يا مربع الخصيب ووبله % % 20(@)(@@) % ليت عيني كشاجم عاينته % % فتولى فرض الصفات ونفله % % PageV01P1499 21(@)(@@) % و أغان ومادحون سوى العب % % د فلا لبسة ولا بعض أكله % % 22(@)(@@) % يا وزيرا أقلامنا ركع في % % مدح تجتلي محياه قبله % % 23(@)(@@) % يا مشيرا أشار خير السلاط % % ين إلى فضله فضاعف فضله % % 24(@)(@@) % حبذا الملك والوزير دعاه % % فخره فاقتفى تقاه وعدله % % 25(@)(@@) % ما ابن شكر وزير مصر كشكر % % لجواد حفت له الناس بغلة % % 26(@)(@@) % لاولا الفائزين فان بعليا % % ك ولو فسح التمكن سبله % % 27(@)(@@) % لا ولا خصبة ابن حنا كأفرا % % حك بل نصله له بعد نصله % % 28(@)(@@) % فابق وافي الهناء متصل 
ms332	 السع % % د علي الحمى سني الأكله % % 29(@)(@@) % و تهنى اقبال سيدة الوق % % ت وأزكى حمى وأيمن حله % % 30(@)(@@) % بالرفا والبنين في خدر بدر % % عن قريب يجلو علسك الأهله % % PageV01P1500 31(@)(@@) % و أحب لي الآن مدحة بنت يوم % % من طروس في حلة بعد حله % % 32(@)(@@) % قيل لي ما اسمها الذي يلسع الض % % د وتجني حلاوة قلت نحله % % PageV01P1501 البحر : - 1(@)(@@) % يجور كما شاء الدلال ويعدل % % ويتعب فيه من يلوم ويعذل % % 2(@)(@@) % هو الشمس إشراقا ولكنني أرى % % من الحزم إني عنه لا أتحول % % 3(@)(@@) % بروحي ربيع من عذاريه آخر % % نماه ربيع من أسيليه أول % % 4(@)(@@) % و ثغر يعير الجوهري صحاحه % % ووجه له من رائق الحسن مجمل % % 5(@)(@@) % لناظره الفتان بالسحر آية % % على مثلها دمعي من العين مرسل % % 6(@)(@@) % و من عجب إني بعادل قده % % أجن ودمع العين دوني المسلسل % % 7(@)(@@) % لئن جلبت شجوي كسالى جفونه % % لمثلك يا قلبي عن الصبر أكسل % % 8(@)(@@) % وان غزلت لي من ضنا الجسم حلة % % لما حلت عن أني بها أتغزل % % 9(@)(@@) % نعم في جفون الترك للنفس صبوة % % وللقلب في تلك المضائق مدخل % % 10(@)(@@) % تجرح قلبي تارة بعد تارة % % وتشهد أني عاشق فتعدل % % PageV01P1502 11(@)(@@) % ورب عذول لامني فتركته % % يقول وقلبي في الصبابة ينهل % % 12(@)(@@) % ولو أن عذالي على الحسن إخوتي % % لقلت لهم طوعي لدى الحسن أجمل % % 13(@)(@@) % أقيموا بني أمي صدور مطيكم % % فاني إلى قوم سواكم لأميل % % 14(@)(@@) % إلى كل غصن مال تيها على نقا % % تكاد به أردافه تتهيل % % 15(@)(@@) % و بدر مضى وقتي مضيئا بوصله % % فلا غرو أني بعد بدري مضلل % % 16(@)(@@) % تشرب ترب الأرض ماء مدامعي % % وبين ضلوعي جمرة تتأكل % % 17(@)(@@) % و أهتز للتذكار حتى كأنما % % يعاودني من بارح الذكر أفكل % % 18(@)(@@) % سقى الغيث أوقاتي اذا العيش ممكن % % وخدام أمري بالهنا تتعجل % % 19(@)(@@) % زماني مختار وقصدي منجح % و راحي ريحان وبدري مقبل % % 20(@)(@@) % مدا الليل فيه ناظري متعلل % إلى لثمه من ضمه أتنقل % % PageV01P1503 21(@)(@@) % فاحبب بذاك الحسن وهو مدا الدجى % % بلثمي مختوم وضمي مقفل % % 22(@)(@@) % إلى مثله يهدى 
ms333	 تغزل ناظم % % وللصاحب ابن الصاحب المدح يحمل % % 23(@)(@@) % اذا قال معنى في ابن يعقوب ناظم % فإن المعاني باسمه تتكمل % % 24(@)(@@) % اذا عد أهل العلم والحلم والتقى % % وصنع الأيادي فابن يعقوب أول % % 25(@)(@@) % اذا استمسكت منه الأماني بناصر % % فبشرى الاماني انها ليس تخذل % % 26(@)(@@) % اذا عدد المثني مناصب مجده % % فنصبا على التمييز لا يتبدل % % 27(@)(@@) % سري سراة قبل ما اكتمل الصبا % % وشيخ شيوخ قبل ما يتكهل % % 28(@)(@@) % و قاضي قضاة معرب بكماله % % تقى ليس يخفى أو لهى ليس يجهل % % 29(@)(@@) % و كافي كفاة ما ابن عباد صائد % % لديه ولا القاضي الملقب أفضل % % 30(@)(@@) % أقام بمغنى الشام صدرا لسره % % وأمداحه في الغرب والشرق ترحل % % PageV01P1504 31(@)(@@) % تنادي الورى نعماه واللفظ والسنا % % ألا فاجتدوا ثم اجتنوا ثم فاجتلوا % % 32(@)(@@) % و لا عيب فيه غير أن له ندى % % يجيب ندا العافين من قبل يسأل % % 33(@)(@@) % مواهب كفيه وألفاظ كتبه % % على اليمن ما بين الورى تترسل % % 34(@)(@@) % و للدرج بعد الدرس منه فوائد % % تفضل في أملاكها وتفصل % % 35(@)(@@) % علوم بآفاق المدارس تنتقى % % وسجع بافنان الدواوين تنقل % % 36(@)(@@) % و نطق به للمنطقي تأدب % ونحو به للفارسي ترجل % % 37(@)(@@) % و خط كما راقت سلاسل عسجد % ونظم كما راق الرحيق المسلسل % % 38(@)(@@) % و رأي على سمت السعود وهمة % % تظل على زهر الكواكب عسل % % 39(@)(@@) % لنعم الفتى دينا ودنيا بجمعنا % % وفي خطبة الدارين نعم المؤهل % % 40(@)(@@) % له الله ما أزكى وأشرف همة % % وأنجح ما يأتي وما يتأمل % % PageV01P1505 41(@)(@@) % درى مع دهري كيف حال تذللي % % فلاقاه حتى عاد وهو مذلل % % 42(@)(@@) % و جلى همومي جامع البر والتقى % % بنعماء من باب الزيادة تدخل % % 43(@)(@@) % و ما هو إلا حين بادر جيشهم % % فقاموا صفوفا للدعا وتبتلوا % % 44(@)(@@) % فنظمتها زهراء والشهب روضة % % على الأفق تجلى والمجرة جدول % % 45(@)(@@) % و طرق الدجى ذو غرة من هلاله % % إلى أن بدا بالفجر وهو محجل % % 46(@)(@@) % فدونكما جهد المحب وعش كما % % تحب لإلف مثلها تتمثل % % 47(@)(@@) % بودي لو أن الجوارح كلها % % لمدحك سمع في الأنام ومقول % % PageV01P1506 البحر : - 1 
ms334	(@)(@@) % فطمت ولآئي ثم أقبلت عاتبا % أفاطم مهلا بعض هذا التدلل % % 2(@)(@@) % بروحي ألفاظ تعرض عتبها % % تعرض أثناء الوشاح المفصل % % 3(@)(@@) % فأحيين ودا كان كالرسم عافيا % بسقط اللوى بين الدخول فحومل % % 4(@)(@@) % تعفى رياح العذر منك رقومه % % لما نسجتها من جنوب وشمأل % % 5(@)(@@) % نعم قوضت منك المودة وانقضت % % فيا عجبا من رحلها المتحمل % % 6(@)(@@) % و نامت على الباكي ولم يدر جفنها % % دراه ولم ينضح بماء فيغسل % % 7(@)(@@) % فداك سهادي في الدجى من مودة % % تؤم الضحى لم تنطبق عن تفصل % % 8(@)(@@) % أمولاي لا تسلك من الظلم والجفا % % بنا بطن خبت ذي قفاف عقنقل % % 9(@)(@@) % و لا تنس مني صحبة تصدع الدجى % % بصبح وما الإصباح منها بأمثل % % 10(@)(@@) % صحبتك لا ألوي على صاحب عطا % % يجيد معم في العشيرة مخول % % PageV01P1507 11(@)(@@) % و خافيت حتى من هوى أين مهجتي % % فألهيتها عن ذي تمائم محول % % 12(@)(@@) % و آنسة أعرضت عنها وقد جلت % % علي هضيم الكشح ريا المخلخل % % 13(@)(@@) % و حاولت من إدناء ودك ما نأى % % فأنزلت منه العصم من كل منزل % % 14(@)(@@) % يقلب لي وجدي به سوط سائق % % وإرخاء سرحان وتقريب تتفل % % 15(@)(@@) % فكم خدمة عجلتها ومحبة % % تمتعت من لهو بها غير معجل % % 16(@)(@@) % و كم أسطر مني ومنك كأنها % % عذارى دوار في ملاء مذيل % % 17(@)(@@) % و كم ناصح كذبت دعواه إذ غدت % % علي وآلت حلفة لم تحلل % % 18(@)(@@) % و لحية لاح غاظها ضحكي على % % أثيث كقنو النخلة المتعثكل % % 19(@)(@@) % ترى بعر الآرام في عرصاتها % % وقيعانها فكأنه حب فلفل % % 20(@)(@@) % نزعت سلوي ساحبا عن صبابتي % % على إثرها أذيال مرط مرحل % % PageV01P1508 21(@)(@@) % وقلت خليل ينشد الهم وده % % ألا أيها الليل الطويل ألا انجل % % 22(@)(@@) % و ساتر تقصير المكافين قد أبى % % لدى الستر الا لبسة المتفضل % % 23(@)(@@) % إلى أن تبدى عذره متمطيا % وأردف أعجازا ونآء بكلكل % % 24(@)(@@) % فلاطفته في الحالتين ولم أقل % % فسلي ثيابي من ثيابك تنسل % % 25(@)(@@) % و أقنعني منه المدجاة أعرضت % % بشق وشق عندنا لم يحول % % 26(@)(@@) % معللة ماذا يفيد بها الفتى % % تبايع كفيه بحبل موصل 
ms335	 % % 27(@)(@@) % يضن بأسطار كأن يراعها % % أساريع ظبي أو مساويك أسحل % % 28(@)(@@) % و يقرع سمعي من معاريض نظمه % % مداك عروس أو صلابة حنظل % % 29(@)(@@) % و يأبى جلوسي من مراتبه إلى % % كبير أناس في بجاد مزمل % % 30(@)(@@) % كأن دموعي في ثيابي بهجره % % عصارة حناء بشيب مرجل % % PageV01P1509 31(@)(@@) % و لما تجاذبنا العتاب موشعا % نزول اليماني بالعتاب المجمل % % 32(@)(@@) % بنينا الولا الواهي فلم يبق معهدا % ولا أطما الا مشيدا بجندل % % 33(@)(@@) % وعدنا لود يملأ القلب عوده % % بشحم كهداب الدمقس المفتل % % 34(@)(@@) % أعدت صلاح الدين عهد مودة % % بكل مغار الفتل شدت بيذبل % % 35(@)(@@) % فدونك عتبي اللفظ ليس بفاحش % % اذا هي نضته ولا بمعطل % % 36(@)(@@) % و عادات حب هن أشهر فيك من % % قفا نبك من ذكرى حبيب ومنزل % % PageV01P1510 البحر : - 1(@)(@@) % مالي إلى السلوان عنك سبيل % % فدع العذول وما عساه يقول % % 2(@)(@@) % مهما بعثت جوى وفيض مدامع % % فعلى حشاي ومقلتي محمول % % 3(@)(@@) % يا غصن بان قد تبين جوره % % إن أنت لم تعطف فكيف تميل % % 4(@)(@@) % كم ذا عليك القلب تلهب ناره % % هذا وذكرك للقلوب خليل % % 5(@)(@@) % أهفو إلى مر النسيم بمهجة % % ترجو شفاء منه وهو عليل % % 6(@)(@@) % و أبث جرح جوارح بيد الأسى % % لكن تجريح الاسى تعديل % % 7(@)(@@) % اما غرام القلب فهو كثير % % عندي ولكن ما السلو جميل % % 8(@)(@@) % مه يا عذول فقد جهلت صبابتي % % وبعيد شبه عالم وجهول % % 9(@)(@@) % أنا من يحول العاشقون وعشقه % % كندى بني ريان ليس يحول % % 10(@)(@@) % المعرقين مناسبا ومكارما % تدري بها الأوصاف كيف تجول % % PageV01P1511 11(@)(@@) % و الواضحين وفي البدور تكلف % % والثابتين وفي الحيا تبديل % % 12(@)(@@) % و التاركين لبيتهم فرعا به % % نشأت لهم بعد الدروس أصول % % 13(@)(@@) % ان يتزن بيت الفخار بذكره % % فبنانه للمكرمات فعول % % 14(@)(@@) % ثاو على حلب ولكن جوده % % ينهل منه على الفرات النيل % % 15(@)(@@) % عرفت مبايعة المحامد عنده % % ووفت فما في بيعها مجهول % % 16(@)(@@) % وزهت برؤيته الديار كأنما % % كل النسيم على الديار قبول % % 17(@)(@@) % و محت غثاثة دهره نعماؤه % % فكأن ذاك غثا وتلك سيول % % 18(@)(@@) % يسعى لمغناه المؤمل مادحا % ويعود 
ms336	 وهو ممدح مأمول % % 19(@)(@@) % لو أثر التقبيل في يد ماجد % % لمحا تواجد كفه التقبيل % % 20(@)(@@) % بعض الحديث اذا أعيد لواصف % % الا حديث صفاته مملول % % PageV01P1512 21(@)(@@) % ايضاح رأي قد حوى جمل العلى % % فيه لكل عريكة تسهيل % % 22(@)(@@) % و مواهب مقرونة بمناقب % % فالفضل حيث أقام والتفضيل % % 23(@)(@@) % و يراعة ألفاظها مشمولة % تشفى وجمع فخارها مشمول % % 24(@)(@@) % من خطرة العسال فيها نسبة % لا غرو أن كلامها معسول % % 25(@)(@@) % يا حبذا القلم الذي من دأبه % % حفظ الحمى وثراؤه مبذول % % 26(@)(@@) % يعلي الممالك وهو خافض رأسه % % ويسمن الأحوال وهو هزيل % % 27(@)(@@) % حمدتك يا ابن سعيد عنا أنعم % روض المحامد حولها مطلول % % 28(@)(@@) % طار الحديث بها عليلا محلقا % هذا وعطف جناحه مبلول % % 29(@)(@@) % لا أنس بشرك والزمان مقطب % % ونوال كفك والغمام نحيل % % 30(@)(@@) % كرم أشبب في ثناه لأنه % % أبدا بأنساب العلى موصول % % PageV01P1513 31(@)(@@) % يامن علاه عن الثناء غنية % والصبح أوضح أن يقام دليل % % 32(@)(@@) % خذ من وليك سامعا ومسامحا % جهد الثناء وانه لجليل % % 33(@)(@@) % ان لم يكن شعري ببابك مرقصا % فليهن مدحي انه مقبول % % PageV01P1514 البحر : - 1(@)(@@) % له كل يوم فيك واش وعاذل % وفي قلبه شغل من الحب شاغل % % 2(@)(@@) % أخو صبوة أثرى من السهد طرفه % % ولكن له دمع على الخد سائل % % 3(@)(@@) % مقيم ولو جد الرحيل على الولا % % ودان وان شطت عليه المنازل % % 4(@)(@@) % اذا غردت ورق الحمائم في الضحى % % على فنن هاجت عليه البلابل % % 5(@)(@@) % و أغيد في عليا دمشق محله % % وفي لحظه من صنعة السحر بابل % % 6(@)(@@) % و لحظ اذا حفته أصداغ شعره % % فما هو الا سيفه والحمائل % % 7(@)(@@) % تطاولت الأغصان تحكي قوامه % % وعند التناهي يقصر المتطاول % % 8(@)(@@) % و فضلت الجوزا على البدر وجهه % % وقال السهى للشمس لونك حائل % % 9(@)(@@) % و أعيا فصيح الوصف نبت عذاره % % وعير قسا بالفهاهة باقل % % 10(@)(@@) % و لما مشى فوق البسيطة زانها % % وفاخرت الشهب الحصا والجنادل % % PageV01P1515 11(@)(@@) % و ما خفت من جهل العذول وانما % % بغيض الي الجاهل المتعاقل % % 12(@)(@@) % و اني وان كنت الأخير غرامه % % لآت بما لم تستطعه 
ms337	 الأوائل % % 13(@)(@@) % تعشقته كالبدر في الطرق مشرقا % % فيا أسفي والبدر زاه وآفل % % 14(@)(@@) % و أسكنته كالضيف وسط جوانحي % % فيا حزني والضيف بالبيت داخل % % 15(@)(@@) % لقد اعقبت قلبي صنوفا كثيرة % % من الشجو أيام اللقاء القلائل % % 16(@)(@@) % سقى الله أيام اللقا سحب راحة % % وزيرية فهي الهوامي الهوامل % % 17(@)(@@) % وزير له في طالب الفضل راحة % % ولكنها قد أتعبتها الفواضل % % 18(@)(@@) % لقد قام عبد الله يدعو إلى الندى % % فأهوت شعوب للرجا وقبائل % % 19(@)(@@) % له الله ما أوفى وأوفر سؤددا % اذا نوهت بالسائدين المحافل % % 20(@)(@@) % تردد في أفق الوزارة شخصه % % كما رددت شهب السماء المنازل % % PageV01P1516 21(@)(@@) % و عطل مغناها اتباعا لزهده % % وإن محلا بان عنه لعاطل % % 22(@)(@@) % ألم تر شباك الوزارة كله % % عيبون تراعي عوده وتحاول % % 23(@)(@@) % سلوا عنه مصرا والشام ففيهما % % شواهد من آثاره ودلائل % % 24(@)(@@) % ألم يرض أرض الواديين بحفل % % من السحب الا أنهن أنامل % % 25(@)(@@) % كلا وادييها عاشق لنزوله % % على أنه في بلدة الأفق نازل % % 26(@)(@@) % تغامز من هذي أصابع نيلها % % وهذي برقراق العيون تغازل % % 27(@)(@@) % و كان عريقا في المناصب بيته % % مكينا اذا ما قيل كاف وكافل % % 28(@)(@@) % فلا واصلا حبلا لمن هو قاطع % ولا قاطعا حبلا لمن هو واصل % % 29(@)(@@) % له قلم كالغصن بالماء مثمر % ولكنه غصن إلى الجود مائل % % 30(@)(@@) % يسمن بيت المال وهو هزيله % % ويفعل أفعال الظبا وهو هازل % % PageV01P1517 31(@)(@@) % اذا هز في يوم الخطاب فعالم % وان هز في يوم الخطوب فعامل % % 32(@)(@@) % اذا قلت ياللصاحب ابتدرت إلى % % نداك معال كالنجوم موائل % % 33(@)(@@) % فقل فيه ما شئت المقال مهنئا % فانك في ظل السيادة قايل % % 34(@)(@@) % هنيئا لمولانا الوزير إيابه % % ومقفله في الذكر والأجر حاصل % % 35(@)(@@) % و لا برحت أوقاتنا ببقائه % % مواصلة أبكارها والأصائل % % 36(@)(@@) % يكف الأذى عن حالنا جود كفه % % ويروي لنا عنه عطاء وواصل % % PageV01P1518 البحر : - 1(@)(@@) % ما مثل قلبي ساليا عن مثله % % خد قرأت عليه سورة نمله % % 2(@)(@@) % وجلست من شغف أنزه ناظري % % في ماء رونقه وخضرة شكله % % 3(@)(@@) % أهوى العذار مبقلا ويسرني % % لقب العذول على هواه 
ms338	 بعذله % % 4(@)(@@) % ليس العذول وان تحاذق ذهنه % % من خل بقلك يا عذار فخله % % 5(@)(@@) % ماذا على العذال من عقل الفتى % % في هذه الأشواق أو في جهله % % 6(@)(@@) % من حكمة الله الخفية أن ترى % % كل البرية راضيا عن عقله % % 7(@)(@@) % هذا ببعض اللهو مشغول وذا % % كل المحامد والعلى من شغله % % 8(@)(@@) % كجمال دين الله إن له هوى % % بجميله وهوى سواه بحمله % % 9(@)(@@) % ذو العزم ما حكت الثريا راحه % % الا لتعلق في العلاء بحبله % % 10(@)(@@) % و السعي ما حكت المجرة مسلكا % الا لتحسب في السرى من سبله % % PageV01P1519 11(@)(@@) % ذاك الذي منعته من صرف العلى % % والمجد معرفة تناط بعدله % % 12(@)(@@) % و اعتاض عن سلف الاولى قصاده % % بذلا يقوم ببعضه عن كله % % 13(@)(@@) % لولا ابن محمود الممدح ما روى % % ذو النظم عن حزن النوال وسهله % % 14(@)(@@) % ندب يرى فرض التكرم قاصرا % % ان لم تقم جدوى يديه بنفله % % 15(@)(@@) % ما السهم أنفذ في الرمية من شبا % % قلم ينوب لنا منابة نصله % % 16(@)(@@) % يا حبذا في الطرس فرع سامق % تجري أحاديث الندى عن أصله % % 17(@)(@@) % عجبا لذاك الفرع أتلف ما يرى % % وحمى العواصم ساكن في ظله % % 18(@)(@@) % يزجي سحائبه بنان مؤمل % % في الخافقين نوافح من سجله % % 19(@)(@@) % لوأن مثل ربيعة في وائل % لم يخل موطئ ذرة من فضله % % 20(@)(@@) % يامن سريت إلى ذرا أبوابه % % سير الغريب إلى منازل أهله % % PageV01P1520 21(@)(@@) % شكرا لبرك لي على طول المدى % % ان كان يقضي الشكر حق أقله % % PageV01P1521 البحر : - 1(@)(@@) % قسما بغصن قوامه المتمايل % % إني لتعجبني عليه بلابلي % % 2(@)(@@) % ويطيب أفواه العواذل ذكره % % حتى أهم بلثم ثغرالعاذل % % 3(@)(@@) % رشأ سرفت مدامعي في حبه % % يا للقتيل بكى لحب القاتل % % 4(@)(@@) % ما ضر عامل قده لو كان ذا % % عطف فليس يضيع أجر العامل % % 5(@)(@@) % نزلت على جفنيه فينا آية % % نزلت على الملكين قبل ببابل % % 6(@)(@@) % و تناهت الأهوا إليه كما انتهى % % معنى السيادة للمليك الكامل % % 7(@)(@@) % ملك رأيت الشهب ثم رأيته % % فوجدته أعيى على المتطاول % % 8(@)(@@) % و قصدت عذب البحر ثم قصدته % % فوجدته أدنى 
ms339	 إلى المتناول % % 9(@)(@@) % نقلت شمائله صفات جدوده % % نقل الرياض عن الغمام الهاطل % % 10(@)(@@) % و تحدثت في الروع ألسن بيضه % % بين المقاصد بالحديث الفاصل % % PageV01P1522 11(@)(@@) % و سقى البنان يراعه حتى ارتوى % % فلذلك يهزأ بالوشيح الدابل % % 12(@)(@@) % يا ابن الملوك الشائدين حمى الهدى % % والرافعين قبابه بعوامل % % 13(@)(@@) % و الحاصدين عداته بقواضب % % صارت لطول ضرابها كمناجل % % 14(@)(@@) % أيديهم في الأرض نبع زلالها % % ومحط أرجلهم أمان زلازل % % 15(@)(@@) % من مبلغ الاهلين عني أنني % % في الشام فزت بفوق ظن الآمل % % 16(@)(@@) % و أخذت من ريب الزمان أمانه % % وقبضت حق مآربي بالكامل % % 17(@)(@@) % لا جور في دهر وفيه ممدح % وشحت منابته بنبت العادل % % PageV01P1523 البحر : - 1(@)(@@) % سري بشبيه البدر آل هلال % % وهان على أهل المليحة حالي % % 2(@)(@@) % خبي وجهها عني وأخلي ربعها % % فآها على وجه ذكرت وخال % % 3(@)(@@) % وأخفت لي الأسقام جسما كأنه % % خلال الأسى والبين عود خلال % % 4(@)(@@) % فما ضر هند لو طرقت خيامها % % على أنني بالسقم طيف خيال % % 5(@)(@@) % هي الشمس بعدا في المكان وبهجة % ولكنها في الفرع ذات ظلال % % 6(@)(@@) % أهيم بذكرى شعرها وعهودها % % لقد همت من شمس الضحى بحبال % % 7(@)(@@) % ولم أدر هل تسطو علي لحاظها % % بسود جفون أم ببيض نصال % % 8(@)(@@) % حرام على جفني المنام وحسبها % % اذا رضيت أن السهاد حلالي % % 9(@)(@@) % و أغيد قد خط العذار بخده % % حروفا نماها الحسن لابن هلال % % 10(@)(@@) % لعمرك ماخد الحبيب معذر % % و لكن بمسود النواظر جالي % % PageV01P1524 11(@)(@@) % سمت نحوه الأنظار حتى كأنها % % بناريه من هنا وهن صوالي % % 12(@)(@@) % أرى شعرات الشيب تؤذن بالردى % % و ينذرني منها طلوع هلال % % 13(@)(@@) % فما بال رأسي كلما ضاء شيبه % % تجدد في ذكر الحبيب ضلالي % % 14(@)(@@) % دع الرمح يسند عن قدود أحبتي % % فإن قدود المالكين عوالي % % 15(@)(@@) % و دعني والأيام ألقى صروفها % % بصبر على أيدي الحوادث عالي % % 16(@)(@@) % أرى لابن ريان اعتلاء سيادة % % تخلص حظ الشعر بعد مطال % % 17(@)(@@) % رئيس إلى علياه تسري مدائح % مواصلة ليست بذات كلال % % 18(@)(@@) % طربت إلى ضوء الجبين وإنما % % طربت لضوء البارق المتلالي % % 19(@)(@@) % و 
ms340	 قالت وقد زادت جمالا بنعته % % حمى الله من عين الزمان جمالي % % 20(@)(@@) % أخو العلم والنعمى يرجى ويختشى % % ليوم فعال أو ليوم مقال % % PageV01P1525 21(@)(@@) % له بركات تلوهن مكارم % فيالمعال أيدت بمعالي % % 22(@)(@@) % بكفيه يستسقى الحيا ودعائه % % فتهمي بماء حالتاه ومال % % 23(@)(@@) % و يندى وقد أندى الحياء جبينه % % فلم ندر من فينا طلوب نوال % % 24(@)(@@) % و لا عيب فيه غير سبق هباته % % فما يتهنى مفصح بسؤال % % 25(@)(@@) % له القلم الماضي الشباة كأنما % % يحادثه من فكره بصقال % % 26(@)(@@) % اذا وسع الأطراس حكت سطورها % % كواعب في الأوراق تحت حجال % % 27(@)(@@) % و ان جهز السمر الذوابل للوغى % % فقل في قصير شد أزر طوال % % 28(@)(@@) % براحة من هبت نوافح ذكره % % فأرخص في الآفاق نشر غوال % % 29(@)(@@) % حلت للورى جدوى يديه فأصبحت % % دعاة الرجا من حوله كنمال % % 30(@)(@@) % ووالى ندى قد سن سنة حاتم % فأهلا بسني الندى المتوالي % % PageV01P1526 31(@)(@@) % من القوم فرسان البلاغة والوغى % % على أنهم لله أي رجال % % 32(@)(@@) % يميتون أياما من المحل بالندى % % ويحيون من طول السجود ليالي % % 33(@)(@@) % أأزكى الورى نفسا وأكرم أسرة % وأرفعهم عن مشبه ومثال % % 34(@)(@@) % بقيت مدى الدنيا إلى الفضل سابقا % وكل امرئ فيها بمدحك تالي % % PageV01P1527 البحر : - 1(@)(@@) % أسائله يوم النوى كيف حاله % % أعيذك مما قل منه احتماله % % 2(@)(@@) % تقضت ليالي الوصل الا ادكارها % % وغاب حبيب القلب إلآ خياله % % 3(@)(@@) % بروحي ناء كنت أشكو ملاله % % فمن لي بأن يدنو ويبقى ملاله % % 4(@)(@@) % من الغيد إن تنسبه فهو كما ترى % % أخوا وجنتيه الشمس والمسك خاله % % 5(@)(@@) % عدا البدر أن يحكي جميع صفاته % % ولكن حكاها نوره وانتقاله % % 6(@)(@@) % وراح القنا من نيل عطفيه باهتا % فكان حقيقا حره واعتقاله % % 7(@)(@@) % خذ الحذر من لحظ له وذوائب % فما هو الا سحره وحباله % % 8(@)(@@) % و إياكما في الحب من لوم مبعد % وقولا له في الوصل كيف احتياله % % 9(@)(@@) % جعلت وفاء العهد زينة شيمتي % % كما زان أبناء الزمان جماله % % 10(@)(@@) % أخو العلم والنعماء يهدي رشاده % % ويجدي على داعي الرجاء نواله % % PageV01P1528 11(@)(@@) % جميل المحيا يملأ العين بهجة % % وأجمل 