ms661	 نواحط % % 55(@)(@@) % إذا القوم راموا سعيكم خلفتهم % % جدود لئام أو جدود هوابط % % 56(@)(@@) % لكم من مساعيكم قلائد جوهر % مساعي أبي عيسى لهن وسائط % % 57(@)(@@) % فتى خلقت كفاه للجود آلة % فأطلقتا منذ أطلقته القوامط % % 58(@)(@@) % وجدنا أبا عيسى العلاء بن صاعد % ربيعا مريعا ليس فيه خطائط % 59(@)(@@) % إذا وضعت أكوارنا بفنائه % فقد رفعت عنا السنون القواحط % 60(@)(@@) % دعت طالبي جدوى يدريه وشأوه % صنائع معلوط بهن المعالط % PageV01P2622 61(@)(@@) % نوال أبي عيسى قريب ومن بغى % % منال أبي عيسى فأدناه شاحط % 62(@)(@@) % سما فوق من يسمو وجاد بسيبه % % فزايل والمعروف منه مخالط % % 63(@)(@@) % هو النخلة الطولى أبت أن تنالها % % يدان ولكن ينعها متساقط % % 64(@)(@@) % أو المزن ينأى أن يمس وما يني % % على الأرض منه وابل أو قطاقط % % 65(@)(@@) % عجبت إذا كف العلاء تهللت % على مستميح كيف يقنط قانط % % 66(@)(@@) % لنأمن به سخط المليك فلم يكن % % يلينا نظير الغيث والله ساخط % % 67(@)(@@) % وإرقاد قوم قد تركت لرفده % وعند ورود اليم تنسى المطائط % % 68(@)(@@) % وقائلة هلا وأنت وليه % % غدوت وللأيدي إليك مباسط % % 69(@)(@@) % يد تبتغي عرفا وأخرى خفاءة % إذا ضافت الناس الهنات البطائط % % 70(@)(@@) % فقلت لها فيئي إليك ذميمة % فلن تبصر النور الجلي الوطاوط % % PageV01P2623 71(@)(@@) % ألم تعلمي أن العلاء على الهدى % % إذا ضل ثيران الفلاة النواشط % 72(@)(@@) % وأن ليس حظي ساقطا عند مثله % ولا حظه عن حمد مثلي ساقط % 73(@)(@@) % له في تدبير ولله قبله % سيثمر لي ما أثمر الطلع حائط % 74(@)(@@) % ومن يحتمل مطل الغراس بحملها % % يمتعنه بالخصب والعام قاحط % 75(@)(@@) % سيمطر عيداني جداه فأغتدي % % وفي ورقي للخابطين مخابط % % 76(@)(@@) % ولست وإن غالته عني واسط % بغائلة عني عطاياه واسط % % 77(@)(@@) % عطايا تزور المستنيل ولو غدا % % سرنديب أدنى داره وشلاهط % % 78(@)(@@) % فليس يرى مني سوى الصبر شيمة % ولو مسني جهد من العيش ضاغط % % 79(@)(@@) % متى لاح أني حين أحرم جازع % فقد بان أني حين أكرم غامط % 80(@)(@@) % تأمله مبسوط اليدين بفضله % فثمض يد الله التي هو باسط % PageV01P2624 81(@)(@@) % تأتت معاني المدح فيه كأنما % % عليها بإسعاف القوافي 
ms662	 شرائط % % 82(@)(@@) % وأطرب فيه الشعر حتى كأنما % % تجاوب قينات به وبرابط % % 83(@)(@@) % وما زاد مطر في نسيم خلاله % % بمدح ولكن حرك المسك سائط % 84(@)(@@) % فقل أيها المطري العلاء بن صاعد % وإن كثرت من حاسديه المساخط % 85(@)(@@) % نطقت بحق ساعدته بلاغة % وفي الناس هاد حين يسري وخابط % 86(@)(@@) % وغير عجيب أن أطاعك منطق % لأن الذي مجدت بحر غطامط % 87(@)(@@) % طفقت تحلي البحر درا ودره % % عتيد فلم تبعد عليك الملاقط % % 88(@)(@@) % نظمت له منه حليا تزينه % ونطت عليه خير ما ناط نائط % % 89(@)(@@) % ولم تشترط أجرا فأجرك واجب % وأوجب أجر أجر من لا يشارط % 90(@)(@@) % فثق بالذي ترجوه وأمن من الذي % % تحاذره قد أخطأتاك الموارط % PageV01P2625 البحر : - 1(@)(@@) % أحاط بحرمتي ما كان مني % % وعفوك واسع بهما محيط % 2(@)(@@) % فما لي أستقيل ولا مقيل % أضاق الرحب وانقبض البسيط % 3(@)(@@) % بغيت وأنت أولى من تغاضى % % لمعترف وقد يبغي الخليط % 4(@)(@@) % وكم من عثرة لجواد قوم % وما هو عندهم بئس الربيط % 5(@)(@@) % وإقراري بأن لا عذر عذر % يلوح كأنه الفلق الشميط % % 6(@)(@@) % ومن عجب ذليل مستكين % يطالبه عزيز مستشيط % 7(@)(@@) % أدل عليك إخلاص ونصح % وود لا يميل ولا يميط % 8(@)(@@) % فهب جرمي لتأميلي فقدما % % وهبت الجرم وهو دم عبيط % 9(@)(@@) % ولا تطل الفتور عن اصطناعي % % وأنت لكل مكرمة نشيط % % 10(@)(@@) % وما زلت الذي ريا نثاه % كريا الروض يثنيه السقيط % % PageV01P2626 11(@)(@@) % تيقظ للعلا والمدعوها % % لهم في نومهم عنها غطيط % 12(@)(@@) % فكم حقنت بصفحك من دماء % محللة وقد كادت تشيط % 13(@)(@@) % وكم نيلت بجودك من أحاظ % يبيت لرحل صاحبها أطيط % 14(@)(@@) % وكيف تحيد عن سنن المعالي % % وبيتك بينها البيت الوسيط % % PageV01P2627 البحر : - 1(@)(@@) % أعقب القرب من حبيبك شحط % ولأيدي الخطوب قبض وبسط % % 2(@)(@@) % خانك الدهر أسوة الناس كلا % % بل وفى إن ما ترى منه شرط % % 3(@)(@@) % شرط الدهر فجع كل محب % وهو فظ على المحبين سلط % % 4(@)(@@) % بعدت خطوة النوى بغزال % يقصر الدل خطوه حين يخطو % % 5(@)(@@) % أهيف الغصن أهيل الدعص لما % % يقتسم مثله وشاح ومرط % 6(@)(@@) % بختري كأنه 
ms663	 حين يمشي % % يتثنى به من البان سبط % % 7(@)(@@) % يجتني حبة الفؤاد بعين % ليس في حكمها على الصب قسط % % 8(@)(@@) % وبجيد كأنما نيط فيه % % من نجوم السماء عقد وسمط % % 9(@)(@@) % طيب ريقه إذا ذقت فاه % % والثريا بالجانب الغور قرط % % 10(@)(@@) % وكأن الأنفاس تصدر منه % % عن خزامى بها من النور وخط % % PageV01P2628 11(@)(@@) % لم تعوضك داره منه لما % % ظلت تبكي وللصبابة فرط % 12(@)(@@) % غير وحشية تزيدك شوقا % حين ترنو وتارة حين تعطو % % 13(@)(@@) % بدل بالحبيب وكس كما استب % % دل بالجنتين أثل وخمط % % 14(@)(@@) % بان بينونة الشباب حميدا % نحو أرض مزارها مستشط % 15(@)(@@) % فسقت أرضه سحائب دهم % أشعلتها بروقها فهي نبط % 16(@)(@@) % أيهذا الممارسي بيديه % % قدك لن يؤلم القتادة خرط % 17(@)(@@) % هل لقوم إلا بقومي حل % أم لقوم إلا بقومي ربط % 18(@)(@@) % إذ بنو يعرب كأصحاب موسى % % وإذ الجيش يوم ذلك قبط % 19(@)(@@) % قومي المنجدون قحطان بالخي % % ل لها في عجاجة النقع نحط % % 20(@)(@@) % جأروا بالدعاء يستصرخونا % % فأجبنا الدعاء والدار شحط % % PageV01P2629 21(@)(@@) % فكشطنا سماء ذل عليهم % % لم يكن يرتجى لها الدهر كشط % 22(@)(@@) % عمروا حقبة كثلة ضأن % خليت بينها سراحين معط % % 23(@)(@@) % فأوينا لهم وما عطفتنا % % رحم بيننا هناك تئط % 24(@)(@@) % بل حفاظ فينا إذا قيل حاموا % % وسماح فينا إذا قيل أعطو % % 25(@)(@@) % فسمت سموة لجمع أبي يك % % سوم غلب من أسد خفان ضبط % 26(@)(@@) % فاقتضيناهم الديون وقدما % لم يفتنا بها الغريم الملط % 27(@)(@@) % برماح مداعس وصفاح % مرهفات لهن قد وقط % % 28(@)(@@) % فحمينا نساء قحطان حتى % % عاد دون الفتاة ستر يلط % 29(@)(@@) % وأرى الأدعياء منكم غضابا % يا لقحطان أكد السخط سخط % 30(@)(@@) % غضبا فليصرم الغيظ في الأح % % شاء منكم ما ضرم النار نفط % PageV01P2630 31(@)(@@) % قل لقوم وسمتهم بهجاء % % لمكاويه في السوالف علط % 32(@)(@@) % ليكن بعضكم لبعض ظهيرا % ثم قوموا لسطوتي حين أسطو % % 33(@)(@@) % أنا كفء لكم ومالي عليكم % من ظهير وهل لأقرع مشط % % 34(@)(@@) % لسواء إن استمد ذليل % بذليل أو مد بالماء ثأط % % 35(@)(@@) % أبلغا خالدا بأنك لا الشت % % م ولا الكلم في أديمك 
ms664	 عبط % % 36(@)(@@) % قلت إذ قيل لي هجاك خليق % غير مستنكر لعشواء خبط % % 37(@)(@@) % مثله في السفاه من علقته % % عقدة لا يحلها عنه نشط % % 38(@)(@@) % أيمان وتشتم الفرس أولى % % لك لا يلتقي رقي وهبط % % 39(@)(@@) % لا لعمر الألى نفوك وقالوا % % قحطبي مدلس ما أشطوا % % 40(@)(@@) % بل أراهم إذا تدبرت رأيي % % ظلموا في مقالهم وألطوا % % PageV01P2631 41(@)(@@) % أنت لا شك قحطبي ولكن % لست حاشاك قحطبيا فقط % 42(@)(@@) % بل من الماء كله فيك شوب % ومن الناس كلهم لك رهط % 43(@)(@@) % ضرط في قفاك يحسبه السا % % مع ثوبا من الحرير يعط % % 44(@)(@@) % نسبة أوقعتك في بحر هزء % أنت فيه مدى الليالي تغط % % 45(@)(@@) % لك منها اسمها الشنيع ولكن % % دون محصولها زحام وضغط % % 46(@)(@@) % فاله عن نسبة نصيبك منها % % لفظة نصفها المقدم قحط % 47(@)(@@) % يا غريب التمام كيف أتمت % بك أم جنينها الدهر سقط % % 48(@)(@@) % لم تكن تلبث الأيور جنينا % فى حشاها إلا مدى ما يحط % % 49(@)(@@) % رب غرمول نائك لم تهله % % شعرات تلوح في استك شمط % % 50(@)(@@) % فانتحى منك في عجان كأن قد % % خط فيه تلك الغضون مخط % PageV01P2632 51(@)(@@) % يا بن تلك التي إذا ما استعفت % % هدرت في استها شقائق رقط % % 52(@)(@@) % تدفع الحاجة الخبيثين منها % % من مسيل فجعرها الدهر ثلط % % 53(@)(@@) % كلما حط رحله بك ضيف % باتت الليل رجلها لا تحط % % 54(@)(@@) % أم شيخ تناك بين يديه % % حين لا حاجب هناك يمط % 55(@)(@@) % ألزم اللؤم أنفك الذل حتى % % هو سيان ذلة والمقط % 56(@)(@@) % ذاك تحت المدى مذال وهذا % % دمل الذلة الذي لا يبط % % 57(@)(@@) % وإذا ما عراك ندمان كأس % لم يشبها القنديد والإسفنط % 58(@)(@@) % بت تيسا له قرون عوال % وهو تيس له نبيب وقفط % % 59(@)(@@) % نمت عن عرسك الحصان إلى الصب % % ح وباتت براكب النيك تمطو % % 60(@)(@@) % تسمعان الأصم صوتين شتى % % هي في نخرة وأنت تغط % % PageV01P2633 61(@)(@@) % فتبيتان في فضائح شنع % لم يكن ليلها عليك ليغطو % % 62(@)(@@) % هاكها مؤيدا هي الدهر في وج % % هك وسم وفي الصحائف خط % % PageV01P2634 البحر : - 1(@)(@@) % طلعت شنطف فقلنا جميعا 
ms665	 % كيف أصبحت يا فسا القنبيط % 2(@)(@@) % فأجابت بشر حال فقلنا % % لم فقالت ختنت نفسي بليط % PageV01P2635 البحر : - 1(@)(@@) % أتاني أن البيهقي يسبني % % هوت أمه في أي مورطة ورط % 2(@)(@@) % وأيتما بلوى جناها لنفسه % % وأيتما نعمى وعافية غمط % 3(@)(@@) % تعرض لي مغرى بخرط قتادتي % % وهل يؤلم الخرط القتاد إذا خرط % 4(@)(@@) % وما كان ذنبي غير أن سامني استه % وثفر التي يؤوي فقلت له أمط % % 5(@)(@@) % عليك بأير غير أيري فإنه % % جواد له من غير طرزك مرتبط % % 6(@)(@@) % أقول لجلاد عميرة ظالما % فإن بساط النيك للنيك قد بسط % % 7(@)(@@) % عليك أبا اسحاق فاجعله نجعة % فإن أبا اسحاق نجعة من قحط % % 8(@)(@@) % إذا شئت نيك البيهقي وعرسه % فلا تتوسل بالوسائل واختبط % % 9(@)(@@) % أباح الورى حولاءه لا بأجرة % % سوى أنه شيخ إذا خبطت خبط % % 10(@)(@@) % وإن الخفوق الطيز تحبو سباله % حباءين شتى من خفيق ومن ضرط % PageV01P2636 11(@)(@@) % فيقبض في عثنونه نفحاتها % % فيا لك من كبش على شكله ربط % % 12(@)(@@) % يصول علينا البيهقي بمذهب % يرى الظرف فيه بالشطارة قد خلط % % 13(@)(@@) % ويلقى إلى حوت آسته حوت يونس % وثعبان موسى في لزاز فتسترط % 14(@)(@@) % فيا سوأتا للظرف والفتك أصبحا % % يناكان في شيخ يناك لدن قمط % 15(@)(@@) % وإن ابتذالي فيه شعري لحادث % تكاد السموات العلا منه تنكشط % 16(@)(@@) % يعيب انقباضي معجبا بانبساطه % % ومن ينبسط للحر والعبد ينبسط % % 17(@)(@@) % ويزعمني صحفت في الشعر كاذبا % ملطا وكم نكلت من كاذب ملط % 18(@)(@@) % فقولا له بئس الجنى ما جنيته % % لنفسك يا ثلطا جنيا كما ثلط % 19(@)(@@) % غدا الأسل الريان همك وحده % إذا هو للوجعاء منك وقد ملط % % 20(@)(@@) % وأنت ترى ما يلفظ الناس كلهم % % به أسلا من حبك الأسل السبط % PageV01P2637 21(@)(@@) % أيا غلطا في الخلق لا من إلهه % % ولكن من الدهر الذي ربما غلط % % 22(@)(@@) % أأنت تغني بي وأنت معلم % أشيوه مخبول بكوعك تمتخط % % 23(@)(@@) % تراعي سقاط المنشدين ولا ترى % % سقاط التي أضحت لغيرك تمتشط % % 24(@)(@@) % حليلتك المشهور في الناس أنها % % عمول من الأعمال أحبط ما حبط % % 25(@)(@@) % حويلاء تزني لا 
ms666	 تراقب قبحها % % ولا نتن حشيها المجيفين والإبط % % 26(@)(@@) % ولا خبث ريح من مبال ملعن % ولا شعرا في السفل والعلو قد شمط % % 27(@)(@@) % ولا الله بل قد راقبت فتأولت % فريا من التأويل بول بل ثلط % 28(@)(@@) % رأت تركها اللذات من خوف ربها % % قنوطا وأن الله إن قنطت سخط % % 29(@)(@@) % فمالت مع الراجي الممتع نفسه % ولم تر أعمال القنوط مع القنط % % 30(@)(@@) % عتبت علينا أن عففنا عن التي % % تؤاجرها فاستنشق الغيظ وآستعط % % PageV01P2638 31(@)(@@) % لساني حسام قد أجدت اختراطه % عليك ولكن أير غيري فاخترط % % 32(@)(@@) % فقد سمت أيري نيك عرسك جاهدا % ونيكك يا بن الزانيين فما نشط % % 33(@)(@@) % ستضحك من شعري وأنت معبس % تميز من غيظ علي وتختلط % % 34(@)(@@) % كما ضحك البغل المزير إذ لوى % % جحافله بيطاره غير مغتبط % % 35(@)(@@) % ويعلم ذو التمييز أنك موجع % توقر باديه وخافيه يختلط % 36(@)(@@) % هجوتك وغدا يرفع الشتم قدره % فشعري مرحوم وأنت الذي غبط % PageV01P2639 البحر : - 1(@)(@@) % أحدث الصفع في دماغ أبي أح % مق لا شك خف واختلاطا % % 2(@)(@@) % فرأى حمله مؤونة حربي % % حمله النائكين شقرا سباطا % % 3(@)(@@) % إن لي مشية أغربل فيها % % آمنا أن أساقط الأسقاطا % % 4(@)(@@) % لا كمن لو مشى لظل يداني % % فقحة لا تفارق المسواطا % % 5(@)(@@) % وجل القلب أن تجيء هنات % من عجان لا يستفيق لواطا % % 6(@)(@@) % مشية لو مشيتها يا أبا أح % مق لم تملك الحتار ضراطا % % 7(@)(@@) % بل سلاحا فيه الأجنة والأغ % راس تحكي أمشاجهن المخاطا % % PageV01P2640 البحر : - 1(@)(@@) % رأيت جليسي لا يزال يروعه % بياض القذى في لحيتي فيميطه % 2(@)(@@) % فكيف به عما قليل إذا رأى % % قذى الشيب قد عفى عليها سقيطه % 3(@)(@@) % وخطت بألوان التكاليف وهيها % % وما الدهر أوهاه فمن ذا يخيطه % 4(@)(@@) % سلام على ليل الشباب تحية % إذا ما صباح الشيب لاح شميطه % PageV01P2641 البحر : - 1(@)(@@) % لشاعرنا خالد في استه % % مآرب أخرى سوى الغائط % 2(@)(@@) % يغني الندامى بها تارة % ويؤتى على شيبه الواخط % 3(@)(@@) % يقضي بها الشيخ أوطاره % برغم المعنف والساخط % 4(@)(@@) % ولم يهجر الشيخ لذاته % % ويجف المعاصي كالقانط % 5(@)(@@) % له زوجة شر 
ms667	 ما زوجة % تلقطها شر ما لاقط % 6(@)(@@) % مشهرة لو مشى خلفها % % نيي لقيل له شارط % % 7(@)(@@) % تناك وقرنانها حاضر % بمنزلة الغائب الشاحط % % 8(@)(@@) % فإن غار قالت له نفسه % تغافل كأنك في واسط % % 9(@)(@@) % أخالد كم لك من صافع % وكم في سبالك من ضارط % % 10(@)(@@) % وأنت صبور لعض الهوا % % ن كصبر البعير على الضاغط % % PageV01P2642 11(@)(@@) % أذلك حبك عجر الفيا % % ش يا آبن المقاول من ناعط % % 12(@)(@@) % حلفت لئن لم تكن ساقطا % فما في البرية من ساقط % % 13(@)(@@) % لئن لزك الجهل في عقدة % من الشر تأبى على الناشط % % 14(@)(@@) % لكم أهلك الجهل من جاهل % وكم أورط الليل من خابط % 15(@)(@@) % ومثلك في النوك قد كادني % % فأصبح ذا عمل حابط % PageV01P2643 البحر : - 1(@)(@@) % سألت يوما خالدا % ذا المجد والبيت الوسيط % 2(@)(@@) % لم ذل عزك للقمد % د فقال قول المستشيط % 3(@)(@@) % ميز بعقلك أينا ال % % مخنوق في بيت الضريط % 4(@)(@@) % حتى تراه في الخنا % % ق يغط أنواع الغطيط % % 5(@)(@@) % بل أينا مني ومن % % ه يغت في السلح العبيط % % 6(@)(@@) % قلت القمد فقال لي % % اسكت إذن يا بن النبيط % % 7(@)(@@) % لم لمتني متغطرسا % لا در درك من خليط % % 8(@)(@@) % صدق المفوه خالد % ذو المقول العضب البسيط % % 9(@)(@@) % إن المحاط به لأو % لى بالذليل من المحيط % PageV01P2644 البحر : - 1(@)(@@) % بؤسا لقوم تحدوني بجهلهم % والجهل يورط قوما شر إيراط % 2(@)(@@) % هبهم أدلوا على حلمي أما علموا % % أن القوافي لا ترضى بإسخاطي % % 3(@)(@@) % قالوا أتشتم مجنونا فقلت لهم % لا بد للمس من كي وإسعاط % % 4(@)(@@) % عندي دواء أبي حفص ورقيته % إن كان ذلك أعيا طب بقراط % 5(@)(@@) % كم مثله من شقي قد وصلت له % % في حلبة الكد أشواطا بأشواط % 6(@)(@@) % شغلته بالهواهي عن معيشته % % وذاك أني عليه غير محتاط % 7(@)(@@) % دعني وإيا أبي حفص سأتركه % % حجام ساباط بل وراق ساباط % 8(@)(@@) % قد كان أجدى عليه من مشاتمتي % % شغل يرد عليه فضل قيراط % % PageV01P2645 البحر : - 1(@)(@@) % يا رب بصري رصاصي الشمط % % عاندني فلو تنفست ضرط % 2(@)(@@) % في الرأس واللحية منه شهبة % زرقاء 
ms668	 والوجه لطرموس النبط % % 3(@)(@@) % كأنه جوزة هند أخذت % فقشرت أطرافها دون الوسط % 4(@)(@@) % ينتقد الشعر ولا يعرفه % أكثر من قولته هذا النمط % PageV01P2646 البحر : - 1(@)(@@) % هبت لوهب ريح سوء عاصف % بارى بها شهر الرياح شباطا % % 2(@)(@@) % من فقحة حق اتساع حتارها % % إذ لا تفارق دهرها مسواطا % % 3(@)(@@) % لو أنها هبت خلال معسكر % لم يبق فيه حفيفها فسطاطا % % 4(@)(@@) % مرت على آذاننا وأنوفنا % % فأساءت الأسماع والأسعاطا % % 5(@)(@@) % ونعت إلينا مفلحا سقيا له % من فارس منع الحريم وحاطا % % 6(@)(@@) % فكأنها وكأن مقتل مفلح % يوم القيامة قدم الأشراطا % % 7(@)(@@) % يا ضرطة سبق البريد بريدها % % ركضا وخلف شوطها أشواطا % % 8(@)(@@) % أصبحت أنبل ضرطة وأجلها % % إذا كان علمك بالغيوب أحاطا % % 9(@)(@@) % يا وهب إن تك قد ولدت صبية % فبحملهم شقرا عليك سباطا % % 10(@)(@@) % من كان لا ينفك ينكح دهره % ولد البنات وأسقط الأسقاطا % % PageV01P2647 11(@)(@@) % تلد النساء من الرجال وإنما % % يلد الرجال من الرجال ضراطا % % 12(@)(@@) % لو كنت مثلك ثم جئت بمثلها % % لضربت فاضحتي بها أسواطا % % 13(@)(@@) % ولما وطئت بساط دار خليفة % حتى الممات ولا اخترقت سماطا % % 14(@)(@@) % قد أعظمت جرما فعاقبها به % % واجعل لها غير الأيور سياطا % % 15(@)(@@) % إن العقوبة بالأيور تزيدها % % زللا إلى ما قدمت وسقاطا % % 16(@)(@@) % قال الوزير وقد رميت برأسها % % قم فالتمس مهدا لها وقماطا % % 17(@)(@@) % هذي عقوبة من يكد عبيده % % حتى يعرق منهم الآباطا % % 18(@)(@@) % ويلفق الأخبار لا متحرجا % فيها ولو بدم النبي أشاطا % % 19(@)(@@) % شهدت ولادتك الشهيرة أنها % % من فقحة لا تستفيق لواطا % % 20(@)(@@) % يا وهب ويحك قد علمت بوهيها % % أفلا دعوت لرتقتها خياطا % % PageV01P2648 21(@)(@@) % عطست وحق لها العطاس لأنها % % مزكومة أبدا تسيل مخاطا % % 22(@)(@@) % دع خدمة الخلفاء لا تعرض لها % % وتعاط ويحك غير ما تتعاطى % % 23(@)(@@) % يحتاط للخلفاء في سلطانهم % % من كان في أمر آسته محتاطا % % 24(@)(@@) % ما هذه النفخ التي أغفلتها % % يا من يفوق بطبه بقراطا % % 25(@)(@@) % كنا نقول إذا مررت مواكبا % لله درك كاتبا خطاطا % % 26(@)(@@) % فالآن صرت إذا مررت فقولنا % % لا در درك كاتبا ضراطا % % 27(@)(@@) % يا 
ms669	 آل وهب حدثوني عنكم % لم لا ترون العدل والإقساطا % % 28(@)(@@) % ما بال ضرطتكم يحل رباطها % % عفوا ودرهمكم يشد رباطا % % 29(@)(@@) % صروا ضراطكم المبذر صركم % % عند السؤال الفلس والقيراطا % % 30(@)(@@) % أو فاسمحوا بضراطكم ونوالكم % هيهلتلستم للنوال نشاطا % % PageV01P2649 31(@)(@@) % لو جدتم بهما معا فتواءما % % فرشا لكم عند الرحال بساطا % % 32(@)(@@) % لكنكم فرطتم في واحد % وهو الضراط فعدلوا الإفراطا % % 33(@)(@@) % فضحت كتابتكم وقنع مجدكم % % خزيا وأسقط جاهكم إسقاطا % % 34(@)(@@) % فاستأنفوا الأعمال إن ضراطكم % % بالأمس أحبط ما مضى إحباطا % % 35(@)(@@) % فإذا شهدتم مشهدا وأبوكم % لم تشبهوا يعقوب والأسباطا % % 36(@)(@@) % قبحتم ولدا وقبح والدا % لا تهتدون من الرشاد صراطا % % 37(@)(@@) % لا قدس الخلف المخلف منكم % % ولدا ولا فراطكم فراطا % % 38(@)(@@) % فلكونكم في صلب آدم نطفة % كانت محورة أمره إهباطا % % PageV01P2650 البحر : - 1(@)(@@) % أغلاء وبلاء % وبريدي ضروط % 2(@)(@@) % وأعاد قد أحاطوا % % لحق الناس القنوط % 3(@)(@@) % تخذ الأمة وهبا % عجبا أن قال طوط % 4(@)(@@) % كيف لا يضرط ألفا % واسته الدهر تلوط % 5(@)(@@) % حادث يا آل وهب % فيه للقدر سقوط % 6(@)(@@) % أكلوه فانتزعت به أسنانهم % % وتهشمت اقفاؤهم بالحائط % % 6(@)(@@) % يتناعرون كانهم قد أوثقوا % % خاقان أو هزموا كتائب ناعط % % 6(@)(@@) % بعثوا عليه بنينهم وبناتهم % من بين ناتفة وى خر سامط % % 6(@)(@@) % أسر المؤذن خالد وضيوفه % % أسر الكمي هفا خلال المآقط % % 6(@)(@@) % فضحت تلك البلاغا أسر المؤذن خالد وضيوفهأسر الكمي هفا خلال المآقط بعثوا عليه بنينهم وبناتهممن بين ناتفة وى خر سامط يتناعرون كانهم قد أوثقواخاقان أو هزموا كتائب ناعطأكلوه فانتزعت به أسنانهم وتهشمت اقفاؤهم بالحائط % % ت وهاتيك الخطوط % % PageV01P2651 البحر : - 1(@)(@@) % أشجتك منزلة بمرجي راهط % % كلا ولا دمن عفت بشلاهط % % 2(@)(@@) % بل معشر وعدتهم فجراتهم % بمغابط فإذا هم بمهابط % % 3(@)(@@) % ظلوا وقد أسروا المؤذن بينهم % وكأنما هزموا كتائب ناعط % % 4(@)(@@) % وخلو بشلو ذبيحهم فرأيتهم % % من ناتف ريشا وآخر مارط % 5(@)(@@) % مستعملين أكفهم في أمره % ببوادر سبقت أناة السامط % % 6(@)(@@) % طبخوه ثم أتوا به قد أبرمت % أوتاره لمنادف وبرابط % % 7(@)(@@) % متجملا لدجاجه متجلدا % كتجلد المجلود بين ربائط % % 8(@)(@@) % ولقد رمته يوم ذلك 
ms670	 قدرهم % % بغطامط من غليها وغطامط % % 9(@)(@@) % حملوا عليها كل ماء عندهم % % وفرات كوفتهم ودجلة واسط % % 10(@)(@@) % واها لذاك الديك بين مساقط % منه عهدناها وبين ملاقط % % PageV01P2652 11(@)(@@) % قوام أسحار مؤذن حارة % سفاد زوجات كمي مآقط % % 12(@)(@@) % ينفي مناعسه بنفس شهمة % ويشاهد الهيجا بجأش رابط % % 13(@)(@@) % وثبت عليه عصابة كوفية % ببوادر من بأسها وفوارط % % 14(@)(@@) % من ناشىء محض الحلاق وشيخة % شوهاء لائطة وشيخ لائط % % 15(@)(@@) % يعدو الأصاغر والأكابر خلفه % عدو الكلاب على الشبوب الناشط % 16(@)(@@) % قسطوا عليه قسوط غامط نعمة % والمؤبقات بمرصد للغامط % % 17(@)(@@) % ولرب مقسوط عليه بغرة % حلت بليته برأس القاسط % 18(@)(@@) % ومن الجرائم ما يكون عقابه % نقدا فكم ناب هنالك ساقط % 19(@)(@@) % أكلوه فانتثرت له أسنانهم % % وتهشمت أقفاؤهم بالحائط % % 20(@)(@@) % من بين ناب إنما هو بيرم % عظما وبين ثنية كالشاحط % % PageV01P2653 21(@)(@@) % وطواحن قد خرقت جنباتها % % فكأن أنكلها سلاح مرابط % % 22(@)(@@) % وكأن وقع مشارط من ريشه % % في تلكم الأحناك وقع مشارط % % 23(@)(@@) % مازال يشرطهم فمنه شرطة % ومن العكوف عليه ضرطة ضارط % % 24(@)(@@) % سقيا لمنتصر هناك لنفسه % % يفري فري مزايل ومخالط % % 25(@)(@@) % لقي الأنامل والمراضع مقدما % لم ينهزم عنها بأجر حابط % % 26(@)(@@) % وغدت تصيح عظامه وعروقه % ليفيق ذو جزع عليه فارط % % 27(@)(@@) % لا تبكين على قتادة خارط % وابك الدماء على بنان الخارط % % 28(@)(@@) % وغدت مشايخهم وقد كتبوا لنا % % بنواصح التوبات كتب شرائط % 29(@)(@@) % أكلوا مؤذنهم فأضحوا كلهم % فد عوجلوا بعقاب رب ساخط % 30(@)(@@) % يتزحرون بأنفس مجهودة % تبكي وتندر ندرة في الغائط % PageV01P2654 31(@)(@@) % أبصارهم نحو السماء كأنما % % بصروا بها تطوى بكفي كاشط % 32(@)(@@) % من باسط كف الدعاء وقابض % كف الدواء حذار موت ذاعط % % 33(@)(@@) % عسرت عليه لظلمه أنفاسه % فكأنه في لحد قبر ضاغط % 34(@)(@@) % يدعو بنية قانط لا شفعت % من دعوة وصلت بنية قانط % % 35(@)(@@) % يتنفسون لكل ضرطة ضارط % أسفا لها ولكل ثلطة ثالط % % 36(@)(@@) % يا لهف أنفسهم على ضرطاتهم % بالأمس من ذاك السلاح الواخط % % 37(@)(@@) % لو أنها وهبت لهم في يومهم % % أضحوا وهم من روحها بمغابط % % 38(@)(@@) % بعدا لهم بعدا لهم بعدا 
ms671	 لهم % % من قابض كفا وآخر باسط % % 39(@)(@@) % سخطوا مودتهم وخانوا جارهم % % لا فارق الأوداج مدية ساحط % % 40(@)(@@) % ديك تناوحت الديوك لفقده % مازال شيخ عشائر وأراهط % % PageV01P2655 41(@)(@@) % ومن العجائب أنهم ورطوا به % % في المهلكات أشد ورطة وارط % % 42(@)(@@) % ورأوا بقيته أصح معاذة % للطفل بين موازج وقوامط % % 43(@)(@@) % فمتى اشتكت أطفالهم من جنة % دلفوا لهم من ماله بمساعط % % 44(@)(@@) % ومتى رأوا ديكا ولو من فرسخ % أبصرتهم يعدون عدو مبالط % % 45(@)(@@) % لا مقبلين إليه لكن هربا % منه حذار معاطب وموارط % % 46(@)(@@) % فهم لغوغاء القبيلة لعبة % في عسكر متضاحك متضارط % 47(@)(@@) % ودت حديثهم الولاة فربما % % نفذت به في اليوم عشر خرائط % 48(@)(@@) % ما كان ديكا بل حديدا باردا % ولرب شيء للظنون مغالط % % 49(@)(@@) % لاقى هنالك كل ذلك لم يخم % % عنه وهم من ضارط أو ناحط % % 50(@)(@@) % وأقول موعظة لرائد منزل % تهديه معرفة وآخر خابط % % PageV01P2656 51(@)(@@) % لا تنزلن بمنزل متكوف % وتنح عنه إلى المحل الشاحط % % 52(@)(@@) % إن الغوائل في المقاحط جمة % فتوق غائلة المراد القاحط % % 53(@)(@@) % وآعمد إذا شئت الجوار إلى الذرى % % إن المكاره أولعت بالهابط % % 54(@)(@@) % جاورت في كوفان شر عصابة % % من صامت عيا وآخر لاغط % 55(@)(@@) % دقوا فلو أولجتهم لتولجوا % % من دقة في سم إبرة خائط % 56(@)(@@) % دلفوا لجارهم بشر لازم % وتجانفوا عنه بخير مائط % 57(@)(@@) % ألفيتهم من شر قنية مقتن % للمقتنين وشر لقطة لاقط % % 58(@)(@@) % وثبوا علي سفاهة فوسمتهم % وسم المسطع بعد وسم العالط % % 59(@)(@@) % قوم يبيت الرشد فيهم ضائعا % والغي بين دواهن ومواشط % % 60(@)(@@) % المشترين فياشلا لنسائهم % % بدراهم ووظائفا بقرارط % % PageV01P2657 61(@)(@@) % ما شئت من عقل ضعيف واهن % فيهم ومن خبل شديد ضابط % 62(@)(@@) % لو أن لؤم الناس قيس بلؤمهم % % ما كان فيه قيس نقطة ناقط % PageV01P2658 البحر : - 1(@)(@@) % أيا هنتاه هل لك في هريس % بلحمان النواهض والبطوط % 2(@)(@@) % وأضلاع الرخال مربيات % بكسب المرو والعجم اللقيط % 3(@)(@@) % صنيعة خابر صنع مجيد % أخي علم بصنعتها محيط % 4(@)(@@) % أمل الليل يعقدها بضرب % فجاء بها تمدد كالخيوط % 5(@)(@@) % وبين يديك من مري عتيق % توارثه القرون عن 
ms672	 النبيط % % 6(@)(@@) % فتبرك فوق صفحتها بروكا % كما برك البعير على الخبيط % % 7(@)(@@) % فيا لله من لقم هناكم % % تجاوب بالشحيج وبالغطيط % % PageV01P2659 البحر : - 1(@)(@@) % ترى الرعية إما راغيا وسطا % أو رابضا حجرة من مرتع وسط % 2(@)(@@) % فليس في الناس مغبوط بمغبطه % لأنه ليس فيهم غير مغتبط % 3(@)(@@) % يا طالب العرف أعيته وسائله % دع الوسائل والأسباب واختبط % 4(@)(@@) % اليوم تبلغ ما أملت من أمل % وما تمنيت من أمنية شطط % PageV01P2660 البحر : - 1(@)(@@) % ألذ من فائقة الإبهط % ومن شوا سمط نظيف السمط % 2(@)(@@) % ولحم طير وصدور البط % % خرطوم سلسال من الإسفنط % % 3(@)(@@) % في قرية من قريات القبط % بسر من را في نسيم الشط % % 4(@)(@@) % قبطية في حلل ومرط % % لعبة عاج صورة في خرط % % 5(@)(@@) % جاءت به مشددا بالشرط % خوادم يحملنه بضبط % 6(@)(@@) % كأنه بعض رجال الزط % قالت نحط الهدي قلنا حطي % % 7(@)(@@) % وكايلي واحتكمي وخطي % % وهذه نقودنا فاشتطي % % 8(@)(@@) % فاحتضنت حقويه تحت الإبط % % وانتزعت عنه شناق الربط % % 9(@)(@@) % فارفض ينهل بغير ضبط % % كأنه جرح عظيم البط % 10(@)(@@) % يكتال ما فيه بغير شرط % . . . . . . . . . . . . . زق النفط % PageV01P2661 11(@)(@@) % ما زلت أسقاها وأسقي رهطي % % حتى تنادى القوم قط قط % % PageV01P2662 البحر : - 1(@)(@@) % وقائل لم هجوت الورد معتمدا % فقلت من بغضه عندي ومن سخطه % 2(@)(@@) % يا مادح الورد لا ينفك عن غلطه % ألست تبصره في كف ملتقطه % 3(@)(@@) % كأنه سرم بغل حين يخرجه % % عند الرياث وباقي الروث في وسطه % PageV01P2663 البحر : - 1(@)(@@) % ألست ترى اليوم المليح المغايظا % % رعاك مليك لم يزل لك حافظا % % 2(@)(@@) % غدا الدجن فيه يقتضي اللهو أهله % % وقد يقتضيكالحق من ليس لافظا % % 3(@)(@@) % فطورا ترى للشمس فيه سيارة % وطورا ترى الشمس طرفا ملاحظا % % 4(@)(@@) % غدا بالذي أهداه خلا ملاطفا % وإن كان ضدا بالصيام مغالظا % % 5(@)(@@) % تحفى فقد أضحى الندى فيه فائضا % وأعفى فقد أضحى الأذى فيه فائظا % % 6(@)(@@) % وقد عدم المعصوم فيه رقيبه % % كما عدم القينات فيه الحوافظا % % 7(@)(@@) % ولكنه الشهر الذي غاب لهوه % فعادت ملاهي الناس فيه مواعظا % % 8(@)(@@) % أصامكموه الله في ظل غبطة % وأبقاكم غيظا لذي الغل 
ms673	 غائظا % % 9(@)(@@) % جزاء بما لقيتموه طلاقة % وخالفتم فيه الشهاوى اللعامظا % % 10(@)(@@) % ألا أيها المكني باسم محمد % فدتك نفوس اللاحظيك الملاحظا % % PageV01P2664 11(@)(@@) % حكى يومنا هذا نداك وحسنه % % إذا ما غدا يحمي نثاك محافظا % % 12(@)(@@) % على أنه لم يحك فعلك إنما % % حكى وعدك الغوث النفوس الفوائظا % % 13(@)(@@) % ولم يحك شيئا من ذكائك إنه % % إذا كنت فيه شاتيا كنت قائظا % % 14(@)(@@) % فعش لابن حاجات وصاحب دولة % % إذا الأمر أضحى فادح الثقل باهظا % % 15(@)(@@) % ولا زلت محمود البلاء جميله % % إذا استخرجت منك الهنات الحفائظا % % 16(@)(@@) % أراك إذا ما كنت صدرا لموكب % أثار عجاجا واستثرت مغائظا % % 17(@)(@@) % وظلت عيون الناس شتى شؤونها % % فغضت ومدت عند ذاك لواحظا % % 18(@)(@@) % يصادون من لولاه لاقت كفاتهم % % شدائد من شغب الخطوب غلائظا % % 19(@)(@@) % جللت فلم تعدم من الناس مغضيا % ورقت فلم تعدم من الناس لاحظا % % 20(@)(@@) % وإن كنت يوم الحفل صدرا لمجلس % % تركت خصيم الحق أخرس واعظا % % PageV01P2665 21(@)(@@) % تظل إذا نامت عقول ذوي العمى % % وإن حددوا زرقا إليك جواحظا % % 22(@)(@@) % تغاضى لهم وسنان بل متواسنا % وتوقظهم يقظان لا متياقظا % % 23(@)(@@) % وترمي الرمايا في المقاتل عادلا % إذا أكثرت نبل الرماة العظاعظا % % 24(@)(@@) % حلوت ولم تضعف فلم تك طعمة % ولا أنت مجتك الشفاه لوافظا % % 25(@)(@@) % بقيتم بني وهب فإن بقاءكم % % صلاح وإن ساء العدو المغايظا % % 26(@)(@@) % ومليتم للحظ ركنا موطدا % يمليكم للعز ركنا مدالظا % % 27(@)(@@) % مقايظنا فيكم مشات بجدكم % % وكانت مشاتينا بقوم مقايظا % % 28(@)(@@) % عجبت لقوم ينفسون حظوظكم % وأنتم أناس تحملون البواهظا % % 29(@)(@@) % وكنتم قدامى حين كانوا خوافيا % وكنتم صميما حين كانوا وشائظا % % 30(@)(@@) % يغيظهم استحقاقكم وحقوقكم % % فلا عدموا تلك الأمور الغوائظا % % PageV01P2666 31(@)(@@) % أيا حسنا أحسن فما زلت محسنا % تيقظ للحسنى فتشأى الأياقظا % % 32(@)(@@) % أفض من ندى لو حمل المزن بعضه % لراحت روايا المزن كظائظا % % 33(@)(@@) % أعيذك أن تغشاك في ونية % % ولست على مولى سواك مواكظا % % 34(@)(@@) % أجرني أن ألفي لغيرك سائلا % مكاتب أقوام وطورا ملافظا % % 35(@)(@@) % ولا تسرحني في اليبيس مشاتيا % كفاني لعمري باليبيس مقايظا % % 36(@)(@@) % ألم تجدوني آل وهب 
ms674	 لمدحكم % % بنظمي ونثري أخطلا ثم جاحظا % % 37(@)(@@) % نسجت لكم حتى توهمت ناسجا % وقرظتكم حتى توهمت قارظا % % 38(@)(@@) % وكنتم غيوثا خارقات شواتيا % روائع ثرات العزالي قوائظا % % 39(@)(@@) % فإن أنا لم تحظظ لديكم وسائلي % % فمن ذا الذي تلفى لديه حظائظا % % 40(@)(@@) % على أنه لا حمد لي إن منحتكم % % مسامح مجد جارني لا مناكظا % % PageV01P2667 41(@)(@@) % يسير على المداح أن يمدحوكم % أصابوا لألفاظ المديح ملافظا % % 42(@)(@@) % ولو حاولوه في سواكم لصادفوا % % مناكب دفع دون ذاك مدالظا % % 43(@)(@@) % منحتكها حولية بنت يومها % % عكاظية أشجي بها المتعاكظا % % 44(@)(@@) % ففوق قداحي واهدها بنصالها % % وريش ورعظ لا عدمتك راعظا % % PageV01P2668 البحر : - 1(@)(@@) % مذ صرت همي في النوم واليقظه % أتعبت مما أهذي بك الحفظه % 2(@)(@@) % وعظت نفسي فخالفت عظتي % % وخالف القلب فيك من وعظه % 3(@)(@@) % وكيف بالصبر عنك يا حسنا % % يأمر بالسيئات من لحظه % 4(@)(@@) % يا من حلا في الفؤاد منظره ال % % حلو فما مجه ولا لفظه % 5(@)(@@) % عذبني منك يا معذبتي % % ونزهتي في المنام واليقظه % 6(@)(@@) % وجه إلى كم تصيد رقته % قلبي وقلب كم أشتكي غلظه % % PageV01P2669 البحر : - 1(@)(@@) % ما يوفيك حقك التقريظ % كفء تقريظك العليم الحفيظ % 2(@)(@@) % فيك أشياء من يواليك مسرو % % ر بها والعدو منها مغيظ % 3(@)(@@) % لك فيها تيقظ غير محتا % % ج إلى أن يعينه تيقيظ % 4(@)(@@) % كم تحفظت من وصية مجد % لم ينفلك حفظها تحفيظ % % 5(@)(@@) % أنت غيث يقيظ فينا حياه % إذ حيا الغيث لا يكاد يقيظ % % 6(@)(@@) % إن يكن ما فعلت برا لطيفا % إن ميثاق شكره لغليظ % % 7(@)(@@) % منك قدحي ومنك نصلي والفو % ق ومنك الترييش والترعيظ % % 8(@)(@@) % أي شيء أقول يا من عداه % % في نداه التنكيد والتنكيظ % % 9(@)(@@) % أنت قبل التقريظ من كمل ال % % له فماذا يزيدك التقريظ % 10(@)(@@) % جهد الناس أن يدانوك في المج % % د فما قارب الصميم الوشيظ % PageV01P2670 11(@)(@@) % وجرى الشعر في مداك فلم يل % % حقك ترقيقه ولا التغليظ % 12(@)(@@) % أنت حلو وأنت مر وما تل % فظ كلا وكل مر لفيظ % % 13(@)(@@) % أريحي ملحظ في النوادي % % للأيادي يهزك التلحيظ % % 14(@)(@@) % هبزري موعظ 
ms675	 بذوي الذم % م فقد صان عرضك التوعيظ % % 15(@)(@@) % تحمل الثقل حمل غير بهيظ % وأخو شكر ما فعلت بهيظ % % 16(@)(@@) % فالبس العمر سابغا ومعادي % % ك حضيض وأنت عال حظيظ % % 17(@)(@@) % ذو ندى غامر يفيض فتضحى % % أنفس الحاسدين فيه تفيظ % 18(@)(@@) % بعطايا موفرات هي الإر % واء بعد الإشباع لا التلميظ % 19(@)(@@) % لا تزال يا أبا الحسين أخا الإح % % سان والحسن غائظا من تغيظ % % 20(@)(@@) % لك بطن من الفضول خميص % وولي من الفضول كظيظ % % PageV01P2671 البحر : - 1(@)(@@) % لا ترى نرجسا يشبه بالور % % د إذا ما أدرت فكرا ولحظا % % 2(@)(@@) % ومن الورد ما يشبه بالنر % % جس علما بأن في ذاك حظا % % PageV01P2672 البحر : - 1(@)(@@) % أول الشهر أول الأسبوع % طلع الطالعان خير طلوع % 2(@)(@@) % مقبل فيه مقبل بسعود % وقعا بالسواء خير وقوع % 3(@)(@@) % ضم صدريهما اتفاق ينادي % % يا له مسعفا برأب الصدوع % 4(@)(@@) % مثل ما ضم عاتبين اعتناق % عند وصل مجدد ورجوع % % 5(@)(@@) % جاء شهر تحبه يا بن يحيى % % لا لما فيه من سجايا المنوع % % 6(@)(@@) % بل لما فيه من وفاقك فيما % % يصحب الدين من تقى وخشوع % % 7(@)(@@) % وصلاة تقيمها كل إني % من سجود تطيله وركوع % % 8(@)(@@) % وعفاف في القلب والطرف والأط % % راف عن كل محرم ممنوع % 9(@)(@@) % رهبة للإله بل رغبة من % % ك بقدر عن الخنا مرفوع % 10(@)(@@) % أقبل الطائر المبارك محمو % % دا جميل المرئي والمسموع % PageV01P2673 11(@)(@@) % ولك الفضل يا بن يحيى عليه % % غير مستنكر ولا مدفوع % % 12(@)(@@) % إن يكن جاء خير باعث جوع % فسيلقاك خير قاتل جوع % % 13(@)(@@) % شكر الله ربه لك عنه % % خير صنع في مثله مصنوع % % 14(@)(@@) % لك نعمى عليه تخنع للحق % ق مقرا بها أشد الخنوع % 15(@)(@@) % جاء في الصيف فاغتدى وهو من ظل % لك بل من نداك كالمربوع % 16(@)(@@) % وقديما مددت ظلك في القي % % ظ عليه دون الحرور السفوع % 17(@)(@@) % ما عليه أن لا يرى فيه راء % آخر الدهر صوب غيث هموع % % 18(@)(@@) % قد كفاه ما يمتري منك فيه % % خوفك الله من ندى ودموع % % 19(@)(@@) % فابق حتى ترى لشهرك هذا % % ألف 
ms676	 مثل بمثله مشفوع % % 20(@)(@@) % ناعم البال ذا عدو شقي % آمن السرب ذا عدو مروع % % PageV01P2674 21(@)(@@) % سالم النفس ثاوي الوفر لاتع % دم حال المرزوء لا المفجوع % 22(@)(@@) % متلفا مخلفا مفتيا مفيدا % جذم مال مستهلك مرجوع % 23(@)(@@) % لا مغبا ندى ولا مدد اليس % ر من الله عنك بالمقطوع % 24(@)(@@) % ممجدا منجدا كأنك عد % دائم السقي زاخر الينبوع % % 25(@)(@@) % ذا ثراء مبذر في العطايا % % دون عرض موفر مجموع % % 26(@)(@@) % لا تصون الأموال بل تقتنيهن % ن لصون الأحساب مثل الدروع % % 27(@)(@@) % في سرور من شيمة الشاكر الصا % % بر لا شيمة الفروح الجزوع % % 28(@)(@@) % يا بن يحيى لينزع المتعاطي % % ما تعاطاه فهو شهر نزوع % % 29(@)(@@) % إن من ظن أنه لك ند % لشبيه المصدق المخدوع % 30(@)(@@) % لا يقارعك يا بن يحي عن السؤ % % دد شيء فلست بالمقروع % PageV01P2675 31(@)(@@) % أنت أصل الأصول في الفضل والخي % % ر إذا حصلا وفرع الفروع % % 32(@)(@@) % لو تسامي بمجدك البدر والشم % % س إذا أوطآك خدي خضوع % PageV01P2676 البحر : - 1(@)(@@) % قل للألى حرموني إذ مدحتهم % إما الثواب وإما ردكم خلعي % % 2(@)(@@) % تالله لكن زينا في الندى لكم % عار علي بما أبديت من ضرعي % % 3(@)(@@) % فإن أبيتم علي الخلتين معا % فلا يلوم مليم ناله قذعي % % 4(@)(@@) % لا قاتل الله رب الناس لؤمكم % % بل قاتل الكاذب المكذوب من طمعي % % 5(@)(@@) % أما لئن كثرت في مدحكم بدعي % % لتكثرن غدا في شتمكم بدعي % % 6(@)(@@) % إني حمدتكم والذم حقكم % لما جعلتم إلى الرحمن منقطعي % % 7(@)(@@) % أديتموني فأحسنتم ببخسكم % حق الأديب فهذا حين متزعي % % 8(@)(@@) % ولو جدعت على أني مدحتكم % ما شانني شين مدحي فيكم جدعي % % 9(@)(@@) % ما جاء من سوء بذري خبث ريعكم % عند ازدراعي بل من خبث مزدرعي % % PageV01P2677 البحر : - 1(@)(@@) % يا أبا المستهل حالفت جوعا % وخواء حتى تلذ الضريعا % % 2(@)(@@) % يا امرأ التيس يا حليف القوافي % % حلق الله رأسك المصفوعا % % 3(@)(@@) % سلحة في قفاك تنشق عنه % % ثم تبتد عارضيك جميعا % % PageV01P2678 البحر : - 1(@)(@@) % وهبت له عيني الهجوعا % % فأثابها منه الدموعا % % 2(@)(@@) % ظبي كأن بخصره % % من ضمره ظمأ وجوعا % % 3 
ms677	(@)(@@) % ومن البلية أنني % % علقت ممنوعا منوعا % % 4(@)(@@) % من سائل قمر الدجى % % ما باله ترك الطلوعا % % 5(@)(@@) % ويلي عليه بل على % % نفس أبت إلا خضوعا % % 6(@)(@@) % ما كنت قبل تعرضي % % لهواه أحسبني جزوعا % % PageV01P2679 البحر : - 1(@)(@@) % لئام كالخنازير % % خساس كاليرابيع % 2(@)(@@) % إذا ما امتدحوا قالوا % % وقعنا في النقاقيع % % 3(@)(@@) % رأيت المهدي الشعر % % إليهم فرط تضييع % % 4(@)(@@) % كمن دحرج در البح % % ر في بحر البلاليع % 5(@)(@@) % أشع عنهم خزاياهم % % وسمع كل تسميع % PageV01P2680 البحر : - 1(@)(@@) % طال المطال ولا خلود فحاجة % مقضية أو برد يأس ينقع % 2(@)(@@) % واعلم أني لا أسر بحاجة % إلا وفي عمري بها مستمتع % PageV01P2681 البحر : - 1(@)(@@) % تعممت إحصانا لرأسي برهة % من القر طورا والحرور إذا سفع % 2(@)(@@) % فلما دهى طول التعمم لمتي % % فأزرى بها بعد الجثالة والفرع % 3(@)(@@) % عزمت على لبس العمامة حيلة % لتستر ما جرت علي من الصلع % 4(@)(@@) % فيا لك من جان علي جناية % جعلت إليه من جنايته الفزع % % 5(@)(@@) % وأعجب بشيء كان دائي جعلته % % دوائي على عمد وأعجب بأن نفع % % PageV01P2682 البحر : - 1(@)(@@) % الأرض تنقص من أطرافها أبدا % لكن كنيزة طول الدهر تتسع % 2(@)(@@) % لها حر واسع لا شيء يشبعه % كحوت يونس مهما شاء يبتلع % 3(@)(@@) % تفسو لتقطع عنا نتن نكهتها % % عند الغناء ولكن ليس ينقطع % % 4(@)(@@) % وفي الفساء لعمر الله مقطعة % لكل نتن ولكن أمرها شنع % PageV01P2683 البحر : - 1(@)(@@) % أتتني عنك المؤيسات فلم ألم % وقلت سحاب جادني ثم أقلعا % % 2(@)(@@) % فلا يبعد الله السحاب وصوبه % ولا أعصفت ريح لكي يتقشعا % % 3(@)(@@) % هو الغيث يسقي بلدة بعد بلدة % من الأرض حتى يسقي الأرض أجمعا % % 4(@)(@@) % وليس بمبعوث لينصف مرتعا % فيرضيه السقيا ويظلم مرتعا % % 5(@)(@@) % وما ضرني من نافع أن يضرني % % وذاك لحبي أن يضر وتنفعا % % 6(@)(@@) % رضيت بما ترضى فإن شئت مرة % سواه فلا استنشقت إلا بأجدعا % % 7(@)(@@) % ولا خير لي فيما أحب وتجتوي % % لأنك من قلبي كنفسي موقعا % % 8(@)(@@) % على أنك الشيء الذي لا أرى له % % مثالا سوى الشمس المنيرة مطلعا % % 9(@)(@@) % لك المثل الأعلى على الناس كلهم % % وإن غيظت 
ms678	 الأكباد حتى تصدعا % % 10(@)(@@) % خضعت فإن خلت الخضوع خديعة % فما زلت خداعا وزلت مخدعا % % PageV01P2684 11(@)(@@) % على أنك المذكي على كل خطة % تضمنتها قلبا من الجمر أصنعا % % 12(@)(@@) % وأنك من ساس الأمور بحكمة % فما ريم ما أحمى ولا ضيم ما رعى % % 13(@)(@@) % ذكاء فتاء لا تجاريب كبرة % ترى الغيب عنه حاسرا لا مقنعا % % 14(@)(@@) % ولكنك المخدوع صفحا ونائلا % فتصفح وضاحا وتمنح أروعا % % 15(@)(@@) % ولا أنا من جدوى يديك بآيس % وإن هول الظن الكذوب وشنعا % % 16(@)(@@) % فإن كنت من جدواك لا بد مانعي % % فلا تمنعني أن أقول وتسمعا % % 17(@)(@@) % ولا تحميني أن أراك مطالعا % إذا كادت الأحشاء أن تتطلعا % % 18(@)(@@) % ومتعت بالعمر الطويل محكما % ولا زلت بالإنصاف منك ممتعا % % PageV01P2685 البحر : - 1(@)(@@) % عيد يطابق أول الأسبوع % % وقعت به الأقدار خير وقوع % 2(@)(@@) % للفأل بالإقبال فيه شاهد % عدل الشهادة ليس بالمدفوع % 3(@)(@@) % غابت نجوم النحس عنه وأصبحت % فيه نجوم السعد ذات طلوع % 4(@)(@@) % وأظله جود الأمير وقد ذكت % نار المصيف فظل كالمربوع % % 5(@)(@@) % يا أيها الملك الذي نهضت به % % للمجد خير محاتد وفروع % 6(@)(@@) % أنعم صباحا نعمة موصولة % بعرى نعيم ليس بالمقطوع % 7(@)(@@) % وافتح بعيدك ألف عيد بعده % % ألف برغم عدوك المقموع % % 8(@)(@@) % ولك الوفور فإن رزئت رزيئة % فرزيئة المرزوء لا المفجوع % % 9(@)(@@) % نفحات كفي ماجد متخادع % % عنهن للسؤال لا المخدوع % 10(@)(@@) % متلاف أموال صناعة كفه % % تفريق كل مؤثل مجموع % % PageV01P2686 11(@)(@@) % ما زال يبذلها ويعلم أنها % % لمقاتل الأعراض خير دروع % 12(@)(@@) % واها لمسلمها إذا هي أسلمت % من مانع للمحرم الممنوع % % 13(@)(@@) % جنن يقين إذا سلبن وما وقى % % عرض الكريم كملبس مخلوع % % 14(@)(@@) % يا رب ذي حسد يود لك الردى % % ولأنت واضع إصره الموضوع % 15(@)(@@) % لولاك مارس كل خطب مضلع % % يحمي جفون العين كل هجوع % 16(@)(@@) % إذ لا يكون لذي المراس غناؤه % إلا الدموع يحثها بدموع % % 17(@)(@@) % أخليت من تلك الهموم ضلوعه % % فشحنت بالشحناء شر ضلوع % % 18(@)(@@) % وغدا يود لك التي لو نالها % % ريم الصغار بمعطس مجدوع % 19(@)(@@) % وجبت جنوب عداك إن جنوبهم % % أولى الجنوب 
ms679	 بوجبة المصروع % 20(@)(@@) % بدلا من القربان عنك وإن غدا % % قربان سوء ليس بالمرفوع % % PageV01P2687 21(@)(@@) % وكفاهم شرفا لهم وصيانة % عن شقوة ومذلة وخضوع % % 22(@)(@@) % إن يقتلوا دون الأمير فدى له % % ومن المكاره نافع المرجوع % % 23(@)(@@) % أوليس موت الحاسديك وإن مضوا % % وبهم غليل ليس بالمنقوع % % 24(@)(@@) % خيرا لهم من أن يروا بك حادثا % مستشنع المرئي والمسموع % % 25(@)(@@) % لا كان ذاك فلو رأوه لأصبحوا % % حلفاء خوف لا ينام وجوع % % 26(@)(@@) % ووهت أمورهم هناك فعالجوا % % من وهيها ما ليس بالمرقوع % % 27(@)(@@) % وعلت وجوههم التي بيضتها % % قترات ذل قامع وخشوع % % 28(@)(@@) % فبكوا على الجبل الذي كان الذرى % % من هيج كل ملمة زعزوع % 29(@)(@@) % لا أخروا ليقدموك وقدموا % % برضى صبور أو بسخط جزوع % 30(@)(@@) % يا آل طاهر المطهر كاسمه % % كم فيكم للخير من ينبوع % % PageV01P2688 31(@)(@@) % ينبوع معروف ورأي ناجع % في معضل الأدواء أي نجوع % 32(@)(@@) % لم يخل نائله ولا آراؤه % % من سد خلات ورأب صدوع % 33(@)(@@) % آراء داهية بعيد غوره % ولهى قريب مستقاه نزوع % % 34(@)(@@) % منكم عبيد الله وتر زمانه % % ولرب وتر ليس بالمشفوع % % 35(@)(@@) % طلاع كل ثنية في باذخ % صعب المراتب ليس بالمطلوع % % 36(@)(@@) % وعلى يديه جرى صلاح شؤونكم % ورجوع إرث أبيكم المنزوع % % 37(@)(@@) % أثنت فضائله عليه من ندى % % يغشى العفاة ومن حجى مطبوع % % 38(@)(@@) % وتقى هلوع من وعيد إلهه % % من نائبات الدهر غير هلوع % % 39(@)(@@) % وفضائل أخر سواها لاترى % % في تابع أبدا ولا متبوع % % 40(@)(@@) % حتى استمال من العدو مودة % ما ألقيت لمقدر في روع % % PageV01P2689 41(@)(@@) % فتقبلوا لطف الإله وصنعه % % بقبول ملطوف له مصنوع % % 42(@)(@@) % ولقد أمرت بذاك منكم معشرا % خنعوا بشكر الله أي خنوع % % 43(@)(@@) % رجعت حقوقكم رجوع نزائع % نزعت إلى وطن أشد نزوع % % 44(@)(@@) % فرعيتموها رعية محمودة % معدومة المهزول والمسبوع % % 45(@)(@@) % وكفيتمونا ما أهم فكلنا % % يرعى مريع العيش غير مروع % % 46(@)(@@) % فجريتم جري النسيم بسحرة % منا ومجرى البارد المجروع % % PageV01P2690 البحر : - 1(@)(@@) % أبا الصقر من يشفع إليك بشافع % فمالي سوى شعري وجودك شافع % 2(@)(@@) % وجودك يكفي دون كل ذريعة % إذا لم تكن للطالبين 
ms680	 ذرائع % 3(@)(@@) % أتيتك في عرض مصون طويته % % ثلاثين عاما فهو أبيض ناصع % 4(@)(@@) % ومثلك من لم يلق في ثوب بذلة % ولا ملبس قد دنسته المطامع % % 5(@)(@@) % وحلأت نفسي عن شرائع جمة % لترويني مما لديك الشرائع % % 6(@)(@@) % وأنت الذي نادى المولين جوده % ودلت عليه الراغبين الصنائع % % 7(@)(@@) % وما قادني ظن إليك مشبه % ولكن يقين ثاقب النور ساطع % % 8(@)(@@) % فإن تفعل الحسنى فشكري راهن % % وإن تكن الأخرى فعذري واسع % % PageV01P2691 البحر : - 1(@)(@@) % ليهنك حق رده الله منعما % عليك به لا بل على الناس أجمعا % % 2(@)(@@) % ولاية بغداد التي بك أذعنت % لراكبها حتى أخب وأوضعا % % 3(@)(@@) % ولو لم تذللها له وهي صعبة % تشمس منها ظهرها وتمنعا % % 4(@)(@@) % وليت فوليت البلاد وأهلها % % صنائع لم تترك لغيرك مصنعا % % 5(@)(@@) % فعش سامي العرنين عيش محسد % ولا عطس الحساد إلا بأجدعا % % 6(@)(@@) % وعذري من التقصير في القول أنني % % حسير سقام عض جسمي فأوجعا % % 7(@)(@@) % وإني لبالمرصاد للقول بعدها % % إن الله عافاني وما زلت مصقعا % % PageV01P2692 البحر : - 1(@)(@@) % لهان على سليمى كم قتيل % يغادر في المكر وكم صريع % % 2(@)(@@) % إذا ما استبدلت ملكا بملك % وأمرع حيث ما نزلت ربيع % 3(@)(@@) % فأولى يا بني العباس أولى % % لكم منه وأمركم جميع % 4(@)(@@) % أراه يضيع ثغرا بعد ثغر % وذلك في فسادكم سريع % 5(@)(@@) % وليس بقوة الأعداء ذاكم % % ولكن عظم صاحبكم خريع % 6(@)(@@) % ترى العمل الجسيم إذا تولى % % سياسته كعبد يستبيع % % 7(@)(@@) % فإن هو بيع من أمم عليه % % وإلا فالإباق له شفيع % % 8(@)(@@) % يقول إذا عصته بلاد قوم % فجاوزها إلى أخرى تطيع % % 9(@)(@@) % إذا لم تستطع شيئا فدعه % وجاوزه إلى ما تستطيع % % PageV01P2693 البحر : - 1(@)(@@) % ولما أجمعوا بينا وشدت % حدوجهم بأثناء النسوع % 2(@)(@@) % وشجعنا على التوديع شوق % تحرق بين أثناء الضلوع % 3(@)(@@) % تلاقينا لقاء لافتراق % كلانا منه ذو قلب مروع % % 4(@)(@@) % فما افترت شفاه عن ثغور % بل افترت جفون عن دموع % % PageV01P2694 البحر : - 1(@)(@@) % من كان يبكي الشباب من جزع % % فلست أبكي عليه من جزع % 2(@)(@@) % لأن وجهي بقبح صورته % % ما زال لي كالمشيب والصلع % 3 