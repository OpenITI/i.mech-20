ms121	 مؤزرا % % PageV01P364 21(@)(@@) % حزني عليه دائم لا ينقضي % % وتصبري مني علي تعذرا % % 22(@)(@@) % وارحمتاه لصارخات حوله % تبكي له الأجل المتاح تقدرا % % 23(@)(@@) % لهفي على ذاك الذبح من القفا % % ظلما وظل ثلاثة لن يقبرا % % 24(@)(@@) % ملقى على وجه التراب تظنه % داود في المحراب حين تسورا % % 25(@)(@@) % لهفي على العاري السليب ثيابه % فكأنه ذو النون ينبذ بالعرا % % 26(@)(@@) % لهفي على الهاوي الصريع كأنه % قمر هوى من أوجه فتكورا % % 27(@)(@@) % لهفي على تلك البنان تقطعت % لو أنها اتصلت لكانت أبحرا % % 28(@)(@@) % لهفي على العباس وهو مجندل % عرضت منيته له فتعثرا % % 29(@)(@@) % لحق الغبار جبينه ولطالما % % في شأوه لحق الكرام وغبرا % % 30(@)(@@) % سلبته أبناء اللئام قميصه % وكسته ثوبا بالنجيع معصفرا % % PageV01P365 31(@)(@@) % فكأنما أثر الدماء بوجهه % شفق على وجه الصباح قد انبرى % % 32(@)(@@) % حر بنصر أخيه قام مجاهدا % فهوى الممات على الحياة وأثرا % % 33(@)(@@) % حفظ الإخاء وعهده فوفى له % حتى قضى تحت السيوف معفرا % % 34(@)(@@) % من لي بأن أفدي الحسين بمهجتي % % وأرى بأرض الطيف ذاك المحضرا % % 35(@)(@@) % فلو استطعت قذفت حبة مقلتي % % وجعلت مدفنه الشريف المحجرا % % 36(@)(@@) % روحي فدى الراس المفارق جسمه % % ينشى التلاوة ليلة مستغفرا % % 37(@)(@@) % ريحانه ذهبت نضارة عودها % % فكأنها بالترب مسكا أذفرا % % 38(@)(@@) % عضب يد الحدثان فلت غربه % ولطالما فلق الرؤوس وكسرا % % 39(@)(@@) % ومثقف حطم الحمام كعوبه % فبكى عليه كل لدن أسمرا % % 40(@)(@@) % عجبا له يشكو الظماء وإنه % لو لامس الصخر الأصم تفجرا % % PageV01P366 41(@)(@@) % بلح الغبار به جواد سابح % % فيخوض نقع الصافنات الأكدرا % % 42(@)(@@) % طلب الوصول إلى الورود فعاقه % ضرب يشب على النواصي مجمرا % % 43(@)(@@) % ويل لمن قتلوه ظمآنا أما % % علموا بأن أباه يسقي الكوثرا % % 44(@)(@@) % لم يقتلوه على اليقين وإنما % % عرضت لهم شبه اليهود تصورا % % 45(@)(@@) % لعن الإله بني أمية مثلما % % داود قد لعن اليهود وكفرا % % 46(@)(@@) % وسقاهم جرع الحميم كما سقوا % % جرع الحمام ابن النبي الأطهرا % % 47(@)(@@) % ياليت قومي يولدون بعصره % أو يسمعون دعاءه مستنصرا % % 48(@)(@@) % ولو انهم سمعوا إذا لأجابه % منهم أسود شرى مؤيده القرى % % 49(@)(@@) % من كل أنملة تجود 
ms122	 بعارض % وبكل جارحة يريك غضنفرا % % 50(@)(@@) % قوم يرون دم القرون مدامة % ورياض شربهم الحديد الأخضرا % % PageV01P367 51(@)(@@) % يا سادتي يا آل طه إن لي % % دمعا إذا يجري حديثكم جرى % % 52(@)(@@) % بي منكم كاسمي شهاب كلما % % أطفيته بالدمع في قلبي ورى % % 53(@)(@@) % شرفتموني في زكي نحاركم % فدعيت فيكم سيدا بين الورى % % 54(@)(@@) % أهوى مدائحكم فأننظم بعضها % % فأرى أجل المدح فيكم أصغرا % % 55(@)(@@) % ينحط مدحي عن حقيقة مدحكم % ولو أنني فيكم نظمت الجوهرا % % 56(@)(@@) % هيهات يستوفي القريض ثناءكم % لو كان في عدد النجوم وأكثرا % % 57(@)(@@) % يا صفوة الرحمن أبرأ من فتى % في حقكم جحد النصوص وأنكرا % % 58(@)(@@) % وأعوذ فيكم من ذنوب أثقلت % ظهري عسى بولائكم أن تغفرا % % 59(@)(@@) % فبكم نجاتي في الحياة من الأذى % % ومن الحجيم إذا وردت المحشرا % % 60(@)(@@) % فعليكم صلى المهيمن كلما % % كر الصباح على الدجى وتكورا % % PageV01P368 البحر : طويل 1(@)(@@) % مضى خلف الأبرار والسيد الطهر % فصدر العلى من قلبه بعده صفر % 2(@)(@@) % وغيب منه في الثرى نير الهدى % % فغادرت ذكاء الدين وانكسف البدر % 3(@)(@@) % ومات الندى فلترثه ألسن الثنا % % وليث الوغى فلتبكه البيض والسمر % 4(@)(@@) % فحق المعالي أن تشق جيوبها % % عليه وتنعاه المكارم والفخر % 5(@)(@@) % هو الماجد الوهاب ما في يمينه % هو العابد الأواب والشفع والوتر % 6(@)(@@) % هو الحر يوم الحرب تثني حرابه % عليه وفي المحراب يعرفه الذكر % 7(@)(@@) % فلا تحسبن الدهر أهلك شخصه % ولكنه في موته هلك الدهر % 8(@)(@@) % فلو دفنوه قومه عند قدره % لجل ولو أن السماك له قبر % 9(@)(@@) % وما دفنه في الأرض إلا لعلمنا % % به أنه كنز لها ولنا ذخر % 10(@)(@@) % وما غسله بالماء إلا تطوعا % وإلا فقولا لي متى نجس البحر % PageV01P369 11(@)(@@) % فتى يورد الهندي وهو حديدة % ويصدق فيه وهو من علق تبر % 12(@)(@@) % فهل لفروض الدين والنفل حرمة % وصاحبه المعروف والجود والبر % 13(@)(@@) % تعطلت الأحكام بعد وفاته % وضاعت حدود الله والنهي والأمر % 14(@)(@@) % يعز على المختار والصنو رزؤه % لعلمها في أنه الولد البر % 15(@)(@@) % فغير ملوم جازع لمصابه % ففي مثل هذاالخطب يسيتقبح الصبر % 16(@)(@@) % أجل 
ms123	 بني المهدي لو أنه ادعى % % وقال أنه المهدي وازره الخضر % 17(@)(@@) % كريم كأن الله أخر موته % ليكسب فيه الأجر من فاته بدر % 18(@)(@@) % فكيف رياض الحزن يبسم نورها % % وترجو حياة بعد ما هلك القطر % 19(@)(@@) % وكيف نرجي أن لليل آخرا % وفي ظلمات الأرض قد دفن الفجر % 20(@)(@@) % فأي عظام في ثراه عظيمة % تجل وعن إرثائها يصغر الشعر % PageV01P370 21(@)(@@) % نصلي عليها وهي عنا غنية % ولكننا فيها لنا يعظم الأجر % 22(@)(@@) % ونثني عليها رغبة في ثنائها % % ليعبق في الأفواه من طيبها عطر % 23(@)(@@) % ترفعن عن قدر المراثي جلالة % وعن أدمع الباكي ولو أنها در % 24(@)(@@) % فمن لليتامى والأرامل بعده % وممن نرجي النفع إن مسنا الضر % 25(@)(@@) % كأن الورى من حوله قبل بعثهم % دعاهم من الأجداث في يومه الحشر % 26(@)(@@) % لئن غدرت فيها الليالي فإنها % % بكل وفي العهد شيمتها الغدر % 27(@)(@@) % وما ضرها لو أنها في عبيده % من الخلق يفدى ذلك السيد الحر % 28(@)(@@) % سرت نسمة الرضوان نحوضريحه % ولا زال فيها من شذا طيبه نشر % 29(@)(@@) % وفي ذمة الرحمن خير مودع % أقام لدينا بعده الوجد والفكر % 30(@)(@@) % تناءى فللدنيا عليه وأهلها % % بكاء وحزن والجنان لها بشر % PageV01P371 31(@)(@@) % دعته لوصل الحورطوبى فزارها % % ولم يدر فيمن بعده قتل الهجر % 32(@)(@@) % فلا يشمت الحسد فيه فإنه % سترغمهم بالموت أبناؤه الغر % 33(@)(@@) % لئن سلمت أبناؤه وبنوهم % فويل العدا وليفرح الذئب والنسر % 34(@)(@@) % فر وع تسامت للعلا وهو أهلها % % فطابت وفي أفنانها أثر الشكر % 35(@)(@@) % ملوك زكت أخلاقهم فكأنهم % حدائق جنات وأخلاقهم زهر % 36(@)(@@) % كأن عليا بينهم بدر أربع % عشر أضاءت حوله أنجم زهر % 37(@)(@@) % إذا ما علي كان في المجد والعلا % سليما فلا زيد يقول ولا عمرو % % 38(@)(@@) % يهون علينا وقع كل ملمة % إذا كان موجودا وإن فدح الأمر % 39(@)(@@) % أمولاي هذا عادة الدهر في الورى % % وليس به خير يدوم ولا شر % 40(@)(@@) % فعذرا لما يجنيه فيكم فكم وكم % له عندكم من قبل فادحة وتر % PageV01P372 41(@)(@@) % عسى الله يجزيك الثواب مضاعفا % ويعقب عسر الأمر من بعده يسر 
ms124	 % 42(@)(@@) % ويلهمك الصبر الجميل بفضله % ويمتد في الحظ السعيد لك العمر % PageV01P373 البحر : طويل 1(@)(@@) % إلى الله نشكو فادحات النوائب % فقد فجعتنا في أجل المطالب % 2(@)(@@) % رمتنا برزء لو رمت فيه يذبلا % لزلزل منه راسخات الجوانب % 3(@)(@@) % فتبا لدهر لا تزال خطوبه % تطالب في أوتارها كل طالب % 4(@)(@@) % كأن الليالي فيه في بعضها لهم % قد اتصلت أرحامها بالنواصب % 5(@)(@@) % فإنا وإن ساءت إلينا صروفها % % فقد حسنت أخلاقنا بالتجارب % 6(@)(@@) % فيا ليتها فدت حسينا بما تشا % % من الوفد من ماش إليه وراكب % 6(@)(@@) % لقد شفعت يوم الصفوف بمثله % وثنت بليث من لؤي بن غالب % 7(@)(@@) % هزبر ترى بيض العطايا بكفه % وحمر المواضي بين حمر المخالب % 8(@)(@@) % صوارمه في أوجه الموت أعين % وأقوسه منها مكان الحواجب % 9(@)(@@) % فتى كان كالتوريد في وجنة العلى % % وكالعقد حسنا في نحور المراتب % PageV01P374 10(@)(@@) % فلا انطبقت عين العلا بعد فقده % ولا ابتسم الهندي في كف ضارب % 11(@)(@@) % عزيز ثوى تحت التراب بحفرة % فيا ليتها محفورة في الترائب % 12(@)(@@) % فلا تحسبوه من دجى القبر راهبا % أليس المحيا منه مصباح راهب % 13(@)(@@) % سقى الله مثواه بعفو ورحمة % وأولاه سترا يوم كشف المعايب % 14(@)(@@) % وما فقر مثواه الروي إلى الحيا % % وفيه انطوى بحر لذيذ المشارب % % 15(@)(@@) % وما في بنات النعش حاجة نعشه % كفى ما حوته من حسان المناقب % 16(@)(@@) % نعته السما والأرض حتى بكت له % جفون الغوادي بالدموع السواكب % 17(@)(@@) % ورق القنا حزنا عليه صدوره % وحنت إليه صاهلات السلاهب % 18(@)(@@) % وشقت عليه الأبعدون جيوبها % % من الوجد فصلا عن قلوب الأرقارب % 19(@)(@@) % قضى فقضى المعروف والبأس والرجا % % وضاقت علينا واسعات المذاهب % PageV01P375 20(@)(@@) % فليس عليه القلب من أسد قومه % بأجزع من خمص الذئاب السواغب % 21(@)(@@) % فقل لبني الحاجات كفوا عن السرى % % فواخيبة المسعى وفوت المآرب % 22(@)(@@) % أرى الأرض حالت دونه فتكسفت % لمرآه أقمار الدجى والملاعب % 23(@)(@@) % سنبكيه ما عشنا وإن قل دمعنا % % أزدناه منا بالقلوب الذوائب % 24(@)(@@) % فلا سلمت نفس من الوجد لم تذب % عليه ولا قلب غدا غير واجب % 25(@)(@@) % سل الأرض 
ms125	 عنه هل تصدى فرنده % فعهدي به نصل صقيل المضارب % 26(@)(@@) % وهل أقشعت مزن الندى من بنانه % فعلمي فيها وهي عشر سحائب % 27(@)(@@) % فلو لم يتم الله نور الهدى لنا % % فمركزها الأصلي بين الكواكب % 28(@)(@@) % فما للثنا من بعده بهجة ولو % % سرقنا المعاني من ثنايا الكواعب % 29(@)(@@) % متى بعده الأيام تطفي أوامنا % % وقد غورت بالأرض بحر المواهب % PageV01P376 30(@)(@@) % وأنى لنا منها نحاول راحة % وقد أوقعتنا في أشقش المتاعب % 31(@)(@@) % كريم غدت راحاته بعد موته % لعاداتها مبسوطة للرغائب % 32(@)(@@) % تمكن منه الموت في قبض روحه % ولم يتمكن عند قبض الرواجب % 33(@)(@@) % أدام علينا فقده الليل سرمدا % فلم نلق فجرا بعده غير كاذب % 34(@)(@@) % كأن قرون الحالقات لرزئه % لنا بوالده عشنا بسود الغياهب % 35(@)(@@) % أبي الجود والتقوى عليض أخي الندى % % ذكاء المعالي بدر شهب الكتائب % 36(@)(@@) % جواد بأرض الكرحتين مقامه % ومعروفه يسري إلى كل طالب % 37(@)(@@) % عسى الله يبقي عمره ويمده % ويكفيه في الدارين سوء العواقب % 38(@)(@@) % ولا شهدت عيناه بين أحبة % ولا سمعت أذناه صوت النوادب % 39(@)(@@) % ولا برحت أبناؤه وبنوهم % تحف به للنصر من كل جانب % PageV01P377 40(@)(@@) % أسود إذا شدت ثعالب لدنهم % تصيد أسود الصيد صيد الثعالب % 41(@)(@@) % رياض سقتها الفاطميات درها % % وأزكى فروع من أصول أطايب % 42(@)(@@) % سلالات أرحام من الرجس طهرت % ميامين أنجاب أتو من نجائب % 43(@)(@@) % وفاه وإياهم من السوء ربهم % وبلغهم أسنى المنى والمطالب % PageV01P378 البحر : طويل 1(@)(@@) % هوى الكوكب الدري من أفق المجد % فتبا لقلب لا يذوب من الوجد % 2(@)(@@) % وتعسا لعين لا تفيض دموعها % % فقد غاض بحر من ملوك بني المهدي % % 3(@)(@@) % تداركه كسف الردى بعد تمه % فحال وحالت دونه ظلمة اللحد % 4(@)(@@) % مضى فالنهى من بعده واجد الحشا % % وصدر العلى من بعده فاقد الخلد % 5(@)(@@) % برته المنايا وهو عضو من الندى % % فأصبح كف المكرمات بلا زند % 6(@)(@@) % ألا فاندبوا يا وافدون ابن محسن % فقد هد ركن الجود من كعبة الوفد % 7(@)(@@) % وعزوا بني السادات فيه فإنما % % به رفعت من ذكرهم سورة الحمد % 8(@)(@@) % توارى فأورى 
ms126	 في القلوب صبابة % فحيا وميتا لم يزل واري الزند % 9(@)(@@) % هو ابن رسول الله والجوهر الذي % % تكون من نور النبوة والرشد % 10(@)(@@) % لقد وهب الدنيا لأكرم والد % وآثر في طوبى القدوم على الجد % PageV01P379 11(@)(@@) % تنازع فيه الحور حبا وغيرة % وتغبطه الولدان في جنة الخلد % 12(@)(@@) % لو ان بنات النعش في سمك نعشه % لصارت لبدر التم من أكرم الولد % 13(@)(@@) % فحقا لملك الحوز يشكو فراقه % فعن غابه قد غاب خير بني الأسد % % 14(@)(@@) % وحقا لعين الحرب تبكي له دما % فقد فقدت في فقده سيفها الهندي % % 15(@)(@@) % وحق العلى أن تنبش الأرض بعده % فقد ضيعت في الترب واسطة العقد % 16(@)(@@) % سرى طيبه في الأرض حتى كأنما % % تبدل منها الطيب بالعنبر الوردي % % 17(@)(@@) % فحسبك يا أكفانه فيه مفخرا % فإنك من نصل العلا موضع الغمد % 18(@)(@@) % ويا نعشه بالله كيف حملته % ويا لحده كيف انطويت على أحد % 19(@)(@@) % جواد على آثار آبائه جرى % % وأجداده الغر الغطارفة اللد % 20(@)(@@) % ولو لم تعقه الحادثات عن المدى % % لأدرك من غاياتهم غاية القصد % PageV01P380 21(@)(@@) % ولو أن شق الحبيب قد رد فائتا % لقل وإني قد شققت لهم كبدي % % 22(@)(@@) % ولو قبل الموت الفداء فديته % ولكنه لن يعطي الحر بالعبد % 23(@)(@@) % بنو المجد لا أصمتكم أسهم الردى % % ولا شلت الأيام منكم يد الرفد % 24(@)(@@) % ولا امتحنت بالبين يوما عيونكم % ولا أحرقت أحشاءكم لوعة البعد % 25(@)(@@) % ولا برحت آراءكم وأكفكم % مصابيحها تهدي وراحاتها تجدي % % PageV01P381 
ms127	