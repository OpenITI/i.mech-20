ms141	 خلق‌گیتی از یمینت %~% ای یمین اهل دوران از یسارت(@)(@@) 11 بر تو چونان بر سلیمان پیمبر %~% کرده اقرار بزرگی مور و مارت(@)(@@) 12 شیرگردون روبهی پیشت نماید %~% تا چه پیش آید ز شیر مرغزارت(@)(@@) 13 بس که رستم بر برادر بذله خواند %~% گر ببیند چاه ویل‌ کارزارت(@)(@@) 14 بس‌که بر تیر گزین تحسین فرستد %~% گر به هیجا بنگرد اسفندیارت(@)(@@) 15 روح دارا زان دو محرم شاد گردد %~% گر بیند خنجر پهلو گذارت(@)(@@) 16 عزم نخجیر غزال چرخ می‌کن %~% غرم صحرایی نمی‌زیبد شکارت(@)(@@) 17 زینهار ار گیرد از بأس تو خوابش %~% تا نیاید آسمان در زینهارت(@)(@@) 18 خواست میزان فلک فهمت بسنجد %~% دید چون پیر خرد کامل عیارت(@)(@@) 19 آب تیغت آتش کین برفروزد %~% باد وش در جان خصم خاکسارت(@)(@@) 20 در بنای لاجوردی سقف‌گردون %~% بس خلل افتد ز حزم استوارت(@)(@@) 21 خسروا وصفت حبیب از جان سراید %~% تا فتد مقبول رای کامکارت(@)(@@) 22 لیک چون و صفت ندارد انحصاری %~% سازد اکنون از دعا رویین حصارت(@)(@@) 23 تا کند هر شام دامن پر ز گوهر %~% آسمان‌گوهری بهر نثارت(@)(@@) 24 بهر بذل سائلان خالی مبادا %~% ابر کف هرگز ز در شاهوارت PageV1P112(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 اگر نظام امور جهان به دست قضاست %~% چرا به هرچه‌کند امر شهریار رضاست(@)(@@) 2 شهی‌که قامت یکتای دهرگشته دوتا %~% به پیش‌گوهر او کز مثال بی‌همتاست(@)(@@) 3 ستوده فتحعلی‌شاه شهریار جهان %~% که‌اصل و فرع وجود است و مایه ی اشیاست(@)(@@) 4 مگر به نعل سمندش برابری‌کرده %~% که مه ز خجلت‌ گاهی نهان وگه پیداست(@)(@@) 5 زمانه نافه چین خواند مشک خلقش را %~% فکند چین به جبین ‌آسمان که عین خطاست(@)(@@) 6 شود ز تیغ کجش راست‌کار هفت اقلیم %~% زهی عجب که به صورت کجست و راست‌ نماست(@)(@@) 7 ز رشک طلعت او کور گشت دیده مهر %~% از آن ز خط شعاعی به دست مهر عصاست(@)(@@) 8 دگر قبول سخن بی‌ادله جایز نیست %~% مرا به صدق سخن اولین بدیهه‌گواست(@)(@@) 9 
ms142	 به باغ رزم سنانش نمو کند چون سرو %~% بلی ز اصل نباتست و مستعد نماست(@)(@@) 10 فلک نباشد چون او چرا که چاکر اوست %~% اگرچه پایه او ماورای چون و چراست(@)(@@) 11 جهان به صورت معنیست اندرو مد غم %~% عجب ‌مدارکه ‌او درجهان به‌صورت ماست(@)(@@) 12 یک آسمان و ازو آشکار صد خورشید %~% یک آفتاب و مر او را هزارگونه سناست(@)(@@) 13 اگرچه صدگهر از یک محیط برخیزد %~% نتیجه‌ گهر صلب او دو صد دریاست(@)(@@) 14 و گرچه این همه پهناورند و بی‌پایان %~% ولی ز جمله نکوتر دو بحر گوهر زاست(@)(@@) 15 یکی که هستی او هست بی‌بها گوهر %~% یکی که‌ گوهر او گوهر تمام بهاست(@)(@@) 16 یکی چو نور وجو دست و دیگری پرتو %~% یکی چو چشمه خورشید و دیگری چو ضیاست(@)(@@) 17 یکی حسینعلی میرزاست خسرو عهد %~% یکی حسن شه عادل ‌که معدلت فرماست(@)(@@) 18 مرآن بسان مسیحا شکسته قفل سپهر %~% مراین بسان سلیمان‌ کلید فتح سباست(@)(@@) 19 ز شور خدمت این در سر فلک سودا %~% ز تف ناچخ این در مزاج خور صفر است(@)(@@) 20 زگرد توسن آن تاکه بنگری‌کهسار %~% ز نعل ابرش این تا نظر کنی صحراست(@)(@@) 21 نطاق خدمت آن طوق ‌گردن ‌گردون %~% زمین درگه این فرق گنبد خضر است(@)(@@) 22 فنا ز رافت آن‌گشته همنشین بقا %~% بقا ز سطوت این درگذار سیل فناست(@)(@@) 23 جهان مسخر آن یک ز ماه تا ماهی %~% فضای مملکت این زارض تا به سماست(@)(@@) 24 مر آن نموده سبک سنگ خصم را چون کاه %~% مراین به‌ گوهر تیغش خواص‌ کاه ‌رباست(@)(@@) 25 نقوش نامه آن زیب پیکر طاووس %~% صریر خامه این صیت شهپر عنقاست(@)(@@) 26 به هرچه مخفی و غیبست ذات آن عالم %~% به هرچه مکمن ‌کونست رای این داناست(@)(@@) 27 به عرض لشکر آن مهر و مه بود داخل %~% ز دخل همت این فقر و فاقه مستثناست(@)(@@) 28 هم از تفقد آن یک ستم به جای ستم %~% هم 
ms143	 از تشدد این یک بلا به جان بلاست(@)(@@) 29 همه نتایج آن را فلک ز دل چاکر %~% همه سلاله این را جهان ز جان مولاست(@)(@@) 30 همه نتایج آن در جمال هشت بهشت %~% همه سلاله این از جلال هفت آباست(@)(@@) 31 مر آن به مملکت چرخ حاکم محکم %~% مر این به کشور آفاق والی والاست(@)(@@) 32 حسام صولت آن روز رزم‌کشورگیر %~% کمند سطوت این وقت عزم قلعه‌‌ گشاست(@)(@@) 33 ز سهم خنجر آن فتنه مختلف اوضاع %~% ز بیم ناوک این‌چرخ مرتعش‌اعضاست(@)(@@) 34 ز رشک طلعت آن آفتاب چون ذره %~% ز حسرت گهر این سهیل همچو سهاست(@)(@@) 35 ثنای این دو نیاری نمود قاآنی %~% اگرچه پایه شعر تو برتر از شعر است(@)(@@) 36 چگونه ‌گوهر توصیفشان توانی سفت %~% اگر چه حدت الماس فکرتت برجاست(@)(@@) 37 چه‌سان به بادیه مدحشان‌کنی جولان %~% اگرچه خنگ خیال تو آسمان پیماست(@)(@@) 38 ز مدح دست بدار و برآر دست دعا %~% اگرچه برتو ز عجز مدیح جای دعاست(@)(@@) 39 زمین درگهشان باد آسمان بلند %~% مدام تا که زمین زیر و آسمان بالاست PageV1P113(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 این خط بی‌خطا که به از نافه ختاست %~% گر مشک چین ز طیب همی خوانمش خطاست(@)(@@) 2 دارد ضیای اختر اگرچه سیاه‌روست %~% دارد بهای‌گوهر اگرچه شبه نماست(@)(@@) 3 در راستی بود الفش قامت نگار %~% نونش اگرچه برصفت پشت من دوتاست(@)(@@) 4 عینش هلال شکل و به معنی معاینه %~% عین عنایت ازل و عین مدعاست(@)(@@) 5 بر صفحه سپید سواد خطش چنانک %~% عکس سواد دیده به رخسار دلرباست(@)(@@) 6 یا عکس روی تیره زنگی در آینه %~% یا نقش پای شبهه به مرآت اهتداست(@)(@@) 7 یا بر بیاض روم نشان از سواد زنگ %~% یا برخد نکو اثر خط مشکساست(@)(@@) 8 یا بهر چشم زخم حوادث نشان نیل %~% از دیرگه به ناصیه بخت پادشاست(@)(@@) 9 پیروزگر حسن شه غازی‌ که از نخست %~% دندان سپیدکرده فرمان او قضاست(@)(@@) 10 گردنکشی که تیغ جهانسوز او به رزم 
ms144	 %~% هم‌ عهد بابلیه و همراز با فناست(@)(@@) 11 خاک درش اگر چه بودکیما ولی %~% در جذب بوسه لب احرار کهرباست(@)(@@) 12 تیغش اگرچه بلع ‌کند صدهزار جان %~% باز از گرسنگی مثل شخص ناشتاست(@)(@@) 13 هرچند جانور نه ولیکن به خوان رزم %~% از لقمه حیات مهیای اشتهاست(@)(@@) 14 ملکش چنان وسیع‌که در شهربند او %~% لفظی‌که نگذرد به زبان نام انتهاست(@)(@@) 15 ای خسروی‌که فتح و ظفر را به روزگار %~% بر بخت مقتدای تو همواره اقتداست(@)(@@) 16 از رشک روی ورای تو اعمی شد آفتاب %~% زانرویش ان خط‌وط شعاعی به‌کف عصاست(@)(@@) 17 راه فناگرفت بلا در زمان تو %~% گر برکسی بلا رسد آن هم یقین بلاست(@)(@@) 18 با ابر نسبت‌ کف راد تو کرد عقل %~% غافل ازینکه ابر نه دارای این عطاست(@)(@@) 19 از برق خنده سرزدکاین عین تهمتست %~% وز رعد غو برآمد کاین محض افتراست(@)(@@) 20 جولان زن است کوه تو آن خنگ توسنت %~% یا در نهادکوه‌ گران سرعت صباست(@)(@@) 21 با پرتو ضمیر تو روشن نشدکه مهر %~% سرچشمه ظلام و یا منبع ضیاست(@)(@@) 22 گر عقل نکته‌سنج سراید که جای تو %~% بیرون بود ز جا همه‌گویندکاین بجاست(@)(@@) 23 هر سنگ و گل که گشت لگدکوب رخش تو %~% از شوق چون نبات مهیای انتماست(@)(@@) 24 هر کس ‌که ملتجی به تو شد پایه ‌اش فزود %~% جز بحر و کان ‌کشان ‌کف راد تو ملتجاست(@)(@@) 25 کاری مکن‌که جود تو برکس ستم‌کند %~% آخر نه ابن دو را به سخای تو التجاست(@)(@@) 26 دوزخ‌ شوی به ‌دشمن و جنت ‌شوی به‌ دوست %~% کاین مر مرا عقوبت و این مر مرا بلاست(@)(@@) 27 چشمی به راه نیست به عهدت جز آنکه فتح %~% در ره ز انتظار تواش چشم بر قفاست(@)(@@) 28 بس‌گوهر ثمین‌که ز جود تو بی‌ثمن %~% بس در بی‌بهاکه ز بذل تو بی‌بهاست(@)(@@) 29 رو بند کرد مقدمت از دیده خسروان %~% شاها مگر غبار قدوم تو توتیاست(@)(@@) 30 ازکار بسته رافت عامت‌گره‌گشود %~% غیر 
ms145	 از دو زلف خوبان ‌کانهم گره‌ گشاست(@)(@@) 31 چون دست برفرازی و شمشیر برکشی %~% گویی هلال بر زبر خط استواست(@)(@@) 32 رمحت عصای موسی اگرنیست ازچه رو %~% در روز رزم درکف راد تو اژدهاست(@)(@@) 33 بر تو چه جای مدح و ثنا هست ‌کز نخست %~% شایسته از وجود تو هم مدح و هم ثناست(@)(@@) 34 آن به آن بر دعای تو ختم ثنا کنم %~% زیراکه حرز پیکر و تعویذ جان دعاست(@)(@@) 35 تا نقطه‌ای‌که سرخط تدویر دایره است %~% هم انتهای دایره هم عین ابتداست(@)(@@) 36 هرکس‌ که با تو چون خط پرگار کج رود %~% سرش‌بادا‌رچه هی نیزا اقتضاست PageV1P114(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای‌دل اقبال ‌و سعادت نه به سعی ‌و طلب است %~% این‌چنین‌کامروایی نه به عقل و ادب است(@)(@@) 2 جامه بخت به اندازه دانش نبرند %~% زانکه‌دوران‌را گردش به‌خلاف‌حسب است(@)(@@) 3 بختیاری نه به‌اصلست ونسب نی به‌حسب %~% کامگاری را چونان‌که ز اصل و نسب است(@)(@@) 4 تا به کی ناله و افغان کنی ای دل از چرخ %~% یا خود از دهرکه دورانش همی بوالعجب است(@)(@@) 5 چرخ راکینه بر ارباب خرد قدلزم است %~% دهر را حیله بر اصحاب هنر قد وجب است(@)(@@) 6 هنری نیست اگر هست هنر بی‌هنریست %~% خردی‌نیست‌وگرهست خردمحتجب است(@)(@@) 7 عقل فعال ندارد سر عالم زیراک %~% همه عالم را اسباب به لهو و لعب است(@)(@@) 8 دهر را نیست‌ کفافی به ‌کف عقل و ادب %~% ور بدی دیدم و دیدی که کرا روز و شب است(@)(@@) 9 چرخ را نیست مداری به سر فضل و هنر %~% ور بدی ‌گفتم و گفتی‌که در تاب و تب است(@)(@@) 10 استخوان زان هما آمد و شهد آن مگس %~% قسمت ما همه زهر و دگران را رطب است(@)(@@) 11 مثل مدعیان با من در حضرت شاه %~% نه چو در غالیه با عود گزاف حطب است(@)(@@) 12 جبرئیلست و عزازیل به مسندگه عرش %~% مصطفی را به حرم مشغله با بولهب است(@)(@@) 13 پس 
ms146	 من و مدعیان باشیم ار خود به مثل %~% هردو بردرگه سلطان زمان ‌کی عجب است(@)(@@) 14 ظل حق خسرو آفاق محمد شه آنک %~% دامن عهدش اندام ابد را سلب است(@)(@@) 15 ذات بیمانندش را نتوان هیچ ستود %~% که ستایش ببرش تابش ماه و قصب است(@)(@@) 16 شخص ‌بی‌چون ‌راچونی به‌ نیایش‌ غلط‌ است %~% با خداوند جهان چونی ترک ادب است(@)(@@) 17 سر این‌گونه سخن خواجه ما داند و بس %~% ورنه از مردم بیگانه نظر در عجب است(@)(@@) 18 حامی دین و دول ماحی ادیان و ملل %~% که ازو دولت و دین چونین زیبا سلب است(@)(@@) 19 این‌قدر بس به مدیحش ‌که ز ابنای زمان %~% حضرت‌شه را فردی به‌هنر منتخب است(@)(@@) 20 مدح دارای جهان را چو نماید اصغا %~% جانش ازفرط شعف‌بینی‌کاندرطرب است(@)(@@) 21 شاه شاهان جوانبخت ‌که از فضل خدای %~% فارس ملک عجم حارس دین عرب است(@)(@@) 22 مهر دلبندش اسرار بقا راست سبب %~% قهر جانسوزش چونانکه فنا را سبب است(@)(@@) 23 لطف‌جانبخشش سرمایه عیشست و نشاط %~% خشم‌جانسوزش دیباچه رنج وکرب است(@)(@@) 24 جنت ‌از دوحه لطفش به ‌مثل یک ‌ورق است %~% دوزخ از آتش قهرش به‌اثر یک لهب است(@)(@@) 25 هر کجا دولت او یارش ازان در فرح است %~% هر کجا صولت‌ او خصمش از ان‌ در تعب‌ است(@)(@@) 26 بخت جاوید وی و دولت جان‌پرور او %~% هست فردی ‌که ز دیوان‌ بقا منتخب است(@)(@@) 27 ملکا بار خدایا بود این سال چهار %~% کز غلامی شهم فخر به جد و به اب است(@)(@@) 28 پانصد و پنجاهم پار عنایت فرمود %~% شه‌مواجب‌که ترا زین‌پس‌این مکتسب است(@)(@@) 29 بختم اقبال نیاورد و نشد جاری از آن %~% که مرا بخت یکی دشمنک زن جلب است(@)(@@) 30 زانکه فهرستم مفقود شد از بخت نژند %~% گرچه‌ام‌محضری از مهر و خطش ماه و شب است(@)(@@) 31 این زمان باز به عرض آرم و جرات ورزم %~% زانکه شاهست به مهر ار فلکم در غضب است(@)(@@) 32 
ms147	 ژاژ تا چند سرایی بر شه قاآنی %~% عرض دانش بر شاهان نه طریق ادب است(@)(@@) 33 تا ز معشوق همی قسمت‌عاشق محن اش %~% تا ز مطلوب همی بهره طالب تعب است(@)(@@) 34 حاصل خصم تو جز فقر مبادا به جهان %~% که فنا را به جهان فقر قوی‌تر سبب است PageV1P115(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 این چه جشنست ‌کزو جان جهان در طرب است %~% در نه افلاک از او سور و سرور عجب است(@)(@@) 2 چرخ در رقن و زمی سرخوش ویتی سرمست %~% راست ‌پرسی طرب اندر طرب اندر طرب است(@)(@@) 3 ملک آباد و دل آزاد و خلایق دلشاد %~% روح بی‌رنج و روان بی‌غم و تن بی‌تعب است(@)(@@) 4 طلعت شاه مگر جلوه در آفاق نمود %~% کافرینش همه از وجد به شور و شغب است(@)(@@) 5 از ازل تا به ابد آنچه مقدر شده عیش %~% راست‌گویی‌که ازین سور همه مکتسب است(@)(@@) 6 شب ز انوار مشاعل همه روشن روزست %~% روز از دود مجامر همه تاریک شب است(@)(@@) 7 دلی ار نالد بی‌غم به محافل چنگست %~% تنی ار سوزد بی‌تب به مطابخ حطب است(@)(@@) 8 دود زنبوره‌که آمیخته با شعله سرخ %~% مشک شنگرف خور و زنگی چینی ضلب است(@)(@@) 9 شمع روشن به شب تیره تو گویی به مثل %~% پرتو مهر پیمبر به دل بولهب است(@)(@@) 10 متحرک شده خاک از طرب و وجد و سماع %~% جذبه خواجه مگر این حرکت را سبب است(@)(@@) 11 بس‌ که بر چرخ ز زنبوره جهد آتش و دود %~% خاک پنداری با چرخ برین در غضب است(@)(@@) 12 از پی رقص به بزم اندر هرجا نگری %~% شوخ سیماب سرین و مه سیمین غبب است(@)(@@) 13 کاخ‌ گردون شد و ماهش همه زنگار خطست %~% بزم بستان شد و سروش همه سنگرف لب است(@)(@@) 14 شاهدان را چو به رقص اندر بینی‌ گویی %~% بدر راکوه احد تعبیه اندر عقب است(@)(@@) 15 مجلس رقص به کهسار بدخشان ماند %~% زان سرین‌هاکه 
ms148	 چو مهتاب نهان در قصب است(@)(@@) 16 شوخ رقاص چو در چرخ درآید گویی %~% کاین همه جنبش افلاک بدو منتسب است(@)(@@) 17 گوش نه چرخ شد از بانگ دف و کوس اصم %~% ماه ذیحجه مگر تالی ماه رجب است(@)(@@) 18 آتشین تیر و شب تیره عجایب ماریست %~% که هوا چون جگر دوزخ ازو پر لهب است(@)(@@) 19 مار دیدی ‌که خورد نار و به ترکیب او را %~% دل ز باروت و سر از کاغذ و تن از خشب است(@)(@@) 20 مار دیدی به هوا رقص کند وز تف او %~% چون دل دشمن شه روی هوا ملتهب است(@)(@@) 21 ذو ذنب دایم از چرخ به خاک آون بود %~% واینک از خاک به چرخ آون بس ذو ذنب است(@)(@@) 22 زاهد خشک که می‌داد جهان را سه طلاق %~% تر دماغ اینک در حجله بنت‌العنب است(@)(@@) 23 دهر بدشوی و طبیعت زن و غم نسل ‌کنون %~% نسل غم نیست‌ که آن عنین شد این عزب است(@)(@@) 24 شب درین جشن فلک را ندهد راه قضا %~% زانکه از ثابت و سیاره تنش بر جرب است(@)(@@) 25 نایب‌ السلطنه را نوبت تطهیر رسید %~% زانکه طاهر دل و طاهر تن و طاهر حسب است(@)(@@) 26 پور شه نور دل و دیده خسرو عباس %~% که شهنشه را این است‌که همنام اب است(@)(@@) 27 گرچه او مردمک دیده شاهست ولی %~% نه چنان مردمکی‌ کز نظرش محتجب است(@)(@@) 28 تا همی زنده‌ کند نام نیا را به جهان %~% نایب‌السلطنه از شاه جهانش لقب است(@)(@@) 29 شعراگرچه ز تطهیر تراندند سخن %~% من بگویم ‌که بسی نادره و بوالعجب است(@)(@@) 30 شارع پاک چو بی‌پرده سخن‌گفت ازان %~% شاعر ار نیز بگوید نه ز لهو و لعب است(@)(@@) 31 باری استاد چو شد زی پسر شاه عجم %~% بهر تطهیرکه فرموده شاه عرب است(@)(@@) 32 شاخ مرجانش چو بگرفت مطهر در دست %~% به دهان برد و گمان‌ کرد که دانه رطب است(@)(@@) 33 
ms149	 خردش‌گفت ادب باش‌که این عضو لطیف %~% بهر تولید ز اعضای دگر منتخب است(@)(@@) 34 بوسه زد تیغش آنگه به همایون عضوی %~% که‌ کلید درگنجینه نسل و نسب است(@)(@@) 35 پسته از پوست برون آمد و بادام از مغز %~% پسته از پوست چو بادام تنش پر ثقب است(@)(@@) 36 زاده‌ی شه نخروشید و نجوشید ز درد %~% قامتش‌گویی نخلی است‌که بارش ادب است(@)(@@) 37 طفل نه ساله‌ که دیدست ‌که در پیکر او %~% مردمی خون و بزرگی رگ و دانش عصب است(@)(@@) 38 طفل نه ساله شنیدی ‌که هنوز از دهنش %~% بوی شیر آید و زو در بدن شیر تب است(@)(@@) 39 شه به هر سو که نظر کرد مر او را می‌دید %~% چون دل مرد خدا جوی‌که‌گرم طلب است(@)(@@) 40 از کرم بس‌ که به درویش و توانگر زر داد %~% کاخ و شادروان‌گفتی همه‌کان ذهب است(@)(@@) 41 نایب‌السلطنه را کیست اتابک دانی %~% آنکه صدگنج لآلیش نهان در دو لب است(@)(@@) 42 جوهر فضل هدایت‌که سراپای جهان %~% زآتش فکر فروزنده او ملتهب است(@)(@@) 43 تا دم صور بماناد ازین سور نشان %~% که تهی زو همه آفاق ز رنج و کرب است PageV1P116(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 در چشم منست آنچه به رخسار تو آب است %~% در جسم منست آنچه به ‌گیسوی تو تاب است(@)(@@) 2 دل بی‌تو بسی تنگتر از سنه چنگ است %~% جان بی‌تو بسی زارتر از زیر رباب است(@)(@@) 3 بر ما به تکبر نگری این چه غرورست %~% از ما به تغافل ‌گذری این چه عتاب است(@)(@@) 4 بی ‌موی تو چون موی توام روز سیاهست %~% بی‌ چشم تو چون چشم توام حال خراب است(@)(@@) 5 گویند که از نار بود مارگریزان %~% چون‌ است‌ که مار تو به نار تو حجاب است(@)(@@) 6 عمریست‌ که بی‌ نار تو و مار تو ما را %~% هم دل به شکنج اندرو هم جان به عذاب است(@)(@@) 7 بختت نه اگر دیده من بهرچه بیدار %~% چشمت 
ms150	 نه اگر طالع من از چه به خواب است(@)(@@) 8 از جان چه خبر گیری و از چشم چه پرسی %~% آن‌بی‌تو پر از آتش و این بی‌تو پر آب است(@)(@@) 9 مهر من و جور تو و بی‌مهری ‌گردون %~% این هر سه برون چون کرم شه ز حساب است(@)(@@) 10 دارای فلک قدر حسن‌شاه‌که‌گردون %~% با لطمه پر مگسش پر ذباب است(@)(@@) 11 رمحتث‌ن به چه ماند بسه بکس غمژمان تن‌ا %~% کاندر دمش از خون عدو سرخ لعاب است(@)(@@) 12 تیرش به چه ماند به ‌یکی پران شاهین %~% کز آن به بد اندیش جهان پر غراب است(@)(@@) 13 با سطوت اوگر همه‌گردنده سپهرشت %~% با صولت او گر همه پاینده تراب است(@)(@@) 14 ن‌ا خسته شکالیست‌که‌دراز هژبر اس %~% پربسته‌حمامیست‌که در چنگ عقاب است(@)(@@) 15 شاها ملکا دادگرا ملک ستانا %~% کت ملک‌ستان‌از ملک‌العرش خطاب‌است(@)(@@) 16 گر مهر نه از غیرت رای تو سقیمست %~% ور چرخ نه از حسرت‌کاخ تو مصاب است(@)(@@) 17 زرین ز چه رو آن را همواره عذارست %~% مشک ز چه رو این را پیوسته ثیاب است(@)(@@) 18 در بزم تو کاشوب سپهر از همه رویست %~% در کاخ تو کآزرم بهشت از همه باب است(@)(@@) 19 هرجاکه نهی پای خدود است و جباه است %~% هرجاکه‌کنی روی قلوبست و رقاب است(@)(@@) 20 تیغ‌ تو نهنگ و تن‌بدخواه تو بحرست %~% تیر تو هژبر و تن بدخواه تو غاب است(@)(@@) 21 با ابرکفت ابر یکی تیره دخانست %~% با بحر دلت بحر یکی خشک سراب است(@)(@@) 22 گاو زمی از جنبش جیش‌تو ستو هست %~% شیر فلک از آتش تیغ تو کباب است(@)(@@) 23 هر عرصه‌ که یکبار برو تاختن آری %~% تا شامگه حشر به خوناب خضاب است(@)(@@) 24 هر چشمه که یک روز درو چهره بشویی %~% تا شام ابد جاری ازان چشمه گلاب است(@)(@@) 25 هر پهنه ‌که یک روز درو تیغ بیازی %~% تا روز جزا معدن یاقوت مذاب است(@)(@@) 26 بخت تو یکی تازه 
ms151	 نهالست‌که طوبی %~% با نسبت او خردتر از برگ سداب است(@)(@@) 27 بی‌طاعت تو هر چه ‌ثوابست‌ گناهست %~% با خدمت تو هرچه‌‌گناهست ثواب است(@)(@@) 28 از قهر تو بر زانوی آمال عقال است %~% از مهر تو برگردن آجال طناب است(@)(@@) 29 شاها به دلم هست یکی راز نهانی %~% افسون‌که بر چهره‌ام از شرم نقاب است(@)(@@) 30 یک نیمه پنجاه شد از عمر و هنوزم %~% نز جفت نصبسب و نه ز اولاد نصاب است(@)(@@) 31 چیزی ‌که ز مردیم عیانست به مردم %~% ریشی‌است‌که آن‌نیز به‌خوناب خضاب است(@)(@@) 32 بس نیزه‌ که بر چهره ز پرچم بودش ریش %~% خوانی اگرش مرد نه آیین صواب است(@)(@@) 33 بت جوزی هندی‌که ود بر زنخثث‌ن موی %~% هرک آدمیش خواند از خیل دواب است(@)(@@) 34 آن راکه نه‌همسر نه خ‌رر وخ‌راب فرشه اس %~% وادم همه‌محتاج خورو همسر و خواب است(@)(@@) 35 هرکاو نکند زن‌کشدش سوی زنانفس %~% وز بار خدا بر تن و بر جانش عقاب است(@)(@@) 36 یزدان به نبی‌گفت و نبی‌گفت در آثار %~% تزویج نمایید که تزویج ثواب است(@)(@@) 37 دختی است پریچهره‌که تا دیده برویش %~% مانند پری دیده تنم در تب و تاب است(@)(@@) 38 بی‌جنت رویش ‌که بود آتش بغداد %~% چشمم‌همه‌شب تا به‌سحر دجله‌آب است(@)(@@) 39 گویند جگر گردد از آتش بریان %~% بی‌آتش رویش جگرم از چه‌کباب است(@)(@@) 40 چون سوی توام روی امید از همه سویست %~% چون باب توام اصل مراد از همه باب است(@)(@@) 41 در روی زمینم نه به‌غیر از تو مناص است %~% وز دور زمانم نه به غیر از تو مآب است(@)(@@) 42 مهر تو بود نقطه و من چون خط پرگار %~% هرجاکه روم‌ سوی توام باز ایاب است(@)(@@) 43 ناکامی من با چو تویی سخت عجیبست %~% بی‌مهری تو با چو منی سخت‌ عجاب است(@)(@@) 44 برتافته ماری همه شب تا به سحرگاه %~% در پنجه من همچو پکی سخت طناب است(@)(@@) 45 چون دیده وامق همه شب اشک فشانست %~% چون 
ms152	 طره عذرا همه‌دم در خم و تاب است(@)(@@) 46 گر بوته اکسیر گران نیست پس از چه %~% پر زیبق محلول و پر از سیم مذاب است(@)(@@) 47 ماننده خونی ‌که به تندی جهد از رگ %~% خونی‌جهد ازوی‌که نه‌خون نقره‌ناب است(@)(@@) 48 دیوانه صفت‌کف به دهان آرد گویی %~% از مستی شهوت چو یکی خم شراب است(@)(@@) 49 گر نفج ز هم باز کند چون شتر مست %~% جوشنده همی جوی کفش از بن ناب است(@)(@@) 50 مانند غریبی است قوی هیکل و اعور %~% کز یاد وطن‌گریان برسان سحاب است(@)(@@) 51 گاهی بخمدگاه سر از جیب برآرد %~% ماناکه دمی شیخ و دمی دیگر شاب است(@)(@@) 52 پستان نه و چون پستان پر شیر سفیدست %~% عمان نه و چون عمان پر در خوشاب است(@)(@@) 53 قاآنی اگر هزل سرا گشته عجب نیست %~% کاورا دل از اندیشه این‌ کار کباب است(@)(@@) 54 گو قافیه تکرار پذیرد چه توان‌ کرد %~% مقصد چو فزون از حد و بیرون ز حساب است(@)(@@) 55 تا شهوت پیری نه به مقدار جوانیست %~% تا قوت‌شیخی نه به معیار شباب است(@)(@@) 56 رای تو رزین باد بدانگونه‌که شیخ است %~% بخت تو جوان باد بدانگونه‌که شاب است PageV1P117(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 دارد اگرچه بر همه‌کس روزگار دست %~% دارد به پیش دست و دل شهریار دست(@)(@@) 2 شاه جهان بهادر دوران حسن شه آنک %~% دارد به خسروان جهان ز افتخار دست(@)(@@) 3 شاهنشهی‌ که بیرون نامد ز آستین %~% چون دست همتش یکی از صدهزار دست(@)(@@) 4 نگرفته است پیش کسی از ره سئوال %~% جز پیش ساقی از پس جام عقار دست(@)(@@) 5 ساید ز عز وکوکبه بر نه سپهر پای %~% دارد ز قدر و مرتبه بر هفت و چار دست(@)(@@) 6 ای داور زمانه‌ که خلق زمانه را %~% از جود تست پرگهر شاهوار دست(@)(@@) 7 گردون خورد یمین به یسارت که در جهان %~% دارم من از یمین تو اندر یسار دست(@)(@@) 8 هر کاو ز 
