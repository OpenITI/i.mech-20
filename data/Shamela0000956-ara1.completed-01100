ms1081	 عنه، مرسل، قال إسحاق عن عيسى عن ثور 4.(@)(@@)(@@)(@@) $ 2015 - عمر بن زرعة أبو حفص، روى عنه قتيبة 5، فيه نظر. PageV06P157(@)(@@)(@@)(@@) ||| باب س(@)(@@)(@@)(@@) $ 2016 - عمر بن سعد بن أبي وقاص القرشي الزهري 1 عن أبيه، سمع منه عيزار بن حريث.(@)(@@)(@@)(@@) $ 2017 - عمر بن سعد بن عائذ القرظ المؤذن أمهم 2 كانوا في عهد عمر رضى الله عنه، سمع منه عمر بن عاصم بن عمر، يقال هم موالى عمار(@)(@@) ابن ياسر مولى بني مخزوم القرشي المديني.(@)(@@)(@@)(@@) $ 2018 - عمر بن سعد النصري 3 عن عمر بن عبد الله الثقفي عن أبيه عن جده، سمع منه اسمعيل بن موسى، لم يصح حديثه.(@)(@@)(@@)(@@) $ 2019 - عمر بن سعد أبو داود الكوفي الحفري، وحفر موضع 4، قال أحمد بن أبي رجاء: مات سنة ثلاث ومائتين 5، سمع الثوري. PageV06P158(@)(@@)(@@)(@@) $ 2020 - عمر بن سعيد، (@)(@@) روى عنه أبو إسحاق الهمداني 1، منقطع، في الكوفيين.</span>(@)(@@)(@@)(@@) $ 2021 - عمر بن سعيد بن أبي حسين النوفلي القرشي المكي، سمع ابن أبي مليكة 2، سمع منه الثوري وابن المبارك والضحاك بن مخلد.(@)(@@)(@@)(@@) $ 2022 - عمر بن سعيد سمع إبراهيم - قاله يزيد بن هارون عن عروة أبي عبد الله سمع عمر بن سعيد، منقطع، كذا في العتيق 3.(@)(@@)(@@)(@@) $ 2023 - عمر بن سعيد بن شريج 4 عن الزهري وعبد الرحمن ابن حميد، روى عنه عبد الرحمن بن إسحاق، المدني، وفضيل بن سليمان 5.(@)(@@)(@@)(@@) $ 2024 - عمر بن سعيد 6 بن مسروق الثوري الكوفى عن PageV06P159(@)(@@) ابيه والاعمش، روى عنه ابن عيينة، هو أخو سفيان والمبارك.(@)(@@)(@@)(@@) $ 2025 - عمر بن سعيد 1 أبو حفص الدمشقي 2، قال أحمد: تركته أخرج لنا كتاب سعيد بن بشير فإذا احاديث ابن أبي عروبة 3.(@)(@@)(@@)(@@) $ 2026 - عمر بن سفينة مولى النبي صلى الله عليه وسلم عن أبيه، روى عنه ابنه برية 4، إسناده مجهول.(@)(@@)(@@)(@@) $ 2027 - عمر بن سليمان من ولد عمر بن الخطاب رضي الله عنه، سمع عبد الرحمن بن أبان 5، سمع منه شعبة، حديثه في أهل المدينة.(@)(@@)(@@)(@@) $ 2028 - 6 عمر بن سليمان بن زيد بن ثابت 6 عن أبي روح، روى عنه موسى بن عقبة، 
ms1082	 منقطع.(@)(@@)(@@)(@@) $ 2029 - عمر بن سليم البصري 7، قال أبو إسحاق حدثنا زيد ابن حباب حدثني عمر بن سليم البصري: حدثنا أبو غالب قلنا لأبي أمامة رضي الله عنه: حدثنا عن وضوء النبي صلى الله عليه وسلم فتوضأ ثلاثا PageV06P160(@)(@@) قال: هكذا رأيت النبي صلى الله عليه وسلم يتوضأ، وقال هارون ح أبو سعيد عبد الرحمن قال ح آدم أبو عباد: عن أبي غالب رأى ابا امامة رضى الله عنه يخلل لحيته وكانت رقيقة.(@)(@@)(@@)(@@) $ 2030 - عمر بن سيف عن المهلب بن أبي صفرة، روى عنه قتادة، منقطع، في البصريين، يقال المصري.(@)(@@)(@@)(@@) $ 2031 - عمر بن سيف الأسدي عن الشعبي وابن سيرين قولهما 1، روى عنه مروان بن معاوية.(@)(@@)(@@)(@@) $ 2032 - عمر بن سالم عن عبد الله بن عمر، وروى هشيم عن عبد الرحمن بن يحيى 2.(@)(@@)(@@)(@@) $ 2033 - عمر بن سالم بن عجلان الأفطس الجزري مولى محمد ابن مروان بن الحكم القرشي، سمع أباه عن سعيد بن جبير قوله، سمع(@)(@@) منه يحيى 3 بن واضح.(@)(@@)(@@)(@@) $ 2034 - عمر بن سالم 4 أبو عثمان الأنصاري مولى الأنصار قاضي مرو خراساني، ويقال عمرو بن سالم، روى عنه مطرف وليث PageV06P161(@)(@@) والربيع 1، وقال ابن فضيل عن مطرف: عن عمرو بن سالم، قال ابن أبي خلف حدثنا أبو أسامة ح مهدي: حدثنا أبو عثمان الأنصاري عمر بن سالم 2 من أهل المدينة: سمعت القاسم 3.(@)(@@)(@@)(@@) $ 2035 - عمر بن سويد العجلي، سمع سلامة التيمي، سمع منه أبو نعيم، في الكوفيين.(@)(@@)(@@)(@@) $ 2036 - عمر بن سويد الثقفي، سمع عائشة بنت طلحة، سمع منه ابن المبارك و 4 أبو نعيم ووكيع 4، الكوفي.(@)(@@)(@@)(@@) $ 2037 - عمر بن سويد العجلي السلمي عن عمرو بن الأسود ومعاوية، روى عنه الزبيدي، الشامي.(@)(@@)(@@)(@@) $ 2038 - عمر بن السائب (@)(@@) </span>عن القاسم بن أبي القاسم، روى عنه عمرو بن الحارث 5، المصري: منقطع.(@)(@@)(@@)(@@) $ 2039 - عمر بن السائب عن أسامة بن زيد، روى عنه الليث ابن سعد، منقطع.(@)(@@)(@@)(@@) $ 2040 - عمر بن سلام عن عبد الملك بن مروان والشعبى PageV06P162(@)(@@) قولهما، روى عنه معن بن عيسى.(@)(@@)(@@)(@@) $ 2041 - عمر بن سهل بن مروان 
ms1083	 المازني البصري أبو حفص سكن مكة، سمع الذيال بن عبيد 1، روى عنه الحميدى.(@)(@@)(@@)(@@) $ 2042 - عمر بن سليط 2 أبو حفص الهذلي، سمع عطاء، سمع منه أبو عبيدة الحداد.(@)(@@)(@@)(@@) $ 2043 - عمر بن ابى سحيم 3، [سمع] 4 ابى مغفل قوله، روى 5 يحيى ابن أبي إسحاق 5 سمع عمر، حديثه في البصريين.(@)(@@)(@@)(@@) ||| باب ش(@)(@@)(@@)(@@) $ 2044 - عمر بن شقيق الجرمي / البصري كانت تجارته إلى الري والد الحسن عن أبي جعفر الرازي 6، سمع منه روح بن عبد المؤمن. PageV06P163(@)(@@)(@@)(@@) $ 2045 - عمر بن شوذب بياع الأكسية عن عمرة بنت الطبيخ، سمع منه وكيع ومحمد بن عبيدة، قال عمرو بن علي: 1 كان يحيى القطان حدثني من رآه يرمي بالسكر 1، وقال عبد الصمد ح عمر بن شوذب: حدثني أبو عثيمة 2 سمع كعبا، منقطع، في الكوفيين.(@)(@@)(@@)(@@) $ 2046 - عمر بن شيبة 3 بن أبي كثير مولى أشجع 4، روى عنه أبو أويس المدني.(@)(@@)(@@)(@@) $ 2047 - عمر بن شيبة بن قارظ أخو قارظ حليف بني زهرة، روى عنه ابن أبي ذئب، المديني، قال ابن أبي ذئب عن قارظ بن شيبة عن أمه أم قارظ 5 بنت إبراهيم بن قارظ، وهو ابن ابى كنانة. PageV06P164(@)(@@)(@@)(@@) $ 2048 - عمر بن شيبة مولى معقل بن سنان، سمع عونا، روى عنه حيوة، كذا في العتيق 1.(@)(@@)(@@)(@@) $ 2049 - عمر بن الشعثاء 2 مولى ابن معمر، سمع ابن عباس رضى الله عنهما.(@)(@@)(@@)(@@) ||| باب ص(@)(@@)(@@)(@@) $ 2050 - عمر بن صهبان خال إبراهيم بن أبي يحيى، منكر الحديث، هو عمر بن محمد بن صهبان الأسلمي 3، حديثه في أهل المدينة.(@)(@@)(@@)(@@) ||| باب ط(@)(@@)(@@)(@@) $ 2051 - عمر بن طلحة بن علقمة بن وقاص الليثي المديني، سمع عبد الله بن علقمة 4، سمع منه على بن عبد الله ومحمد بن عبيد الله. PageV06P165(@)(@@)(@@)(@@) $ 2052 - عمر بن ظلحة أبو حفص الأزدي البصري 1 عن أبي(@)(@@) حمزة وسعيد بن أبي عروبة، منكر الحديث.(@)(@@)(@@)(@@) ||| باب ع(@)(@@)(@@)(@@) $ 2053 - عمر بن عبد الله بن جرهد الأسلمي حجازي، قال ابن أبي مريم أخبرنا يحيى بن أيوب عن ابن حرملة حدثني محمد بن عبد الله ابن الحضين: 
ms1084	 سمع عمر بن عبد الله بن جرهد سمعت رجلا يقول لجابر ابن عبد الله رضى الله عنهما: من بقي معك من أصحاب النبي صلى الله عليه وسلم؟ فقال: أنس بن مالك وسلمة بن الاكوع رضى الله عنهما، فقال رجل: أما سلمة فقد ارتد عن هجرته، فقال جابر: لا تقل سمعت رسول الله صلى الله عليه وسلم ابدوايا أسلم أنتم مهاجرون حيث كنتم.(@)(@@)(@@)(@@) $ 2054 - عمر بن عبد الله، وهو عمر بن أبي سلمة بن عبد الرحمن ابن عوف الزهري القرشي عن أبيه 2، روى عنه سعد بن إبراهيم وأبو عوانة وهشيم وموسى بن يعقوب، المدني هو أخو سلمة مدني الاصل، اراه قدم واسط. PageV06P166(@)(@@)(@@)(@@) $ 2055 - عمر بن عبد الله بن الزبير 1 عن ابن الزبير، روى عنه عبد الله بن مسلم.(@)(@@)(@@)(@@) $ 2056 - عمر بن عبد الله بن عروة بن الزبير بن العوام القرشي الأسدي 2، سمع جده 3 وسمع عمرو بن سليم يحدث عامر بن(@)(@@) عبد الله بن الزبير سمع أبا قتادة رضى الله عنه قال النبي صلى الله عليه وسلم: إذا دخل المسجد 4 فليركع - قاله يعقوب عن أبيه عن ابن إسحاق سمع عمر، حديثه في أهل المدينة، وقال ابن جريج حدثني يحيى بن عبد الله بن عروة عن أبيه قال النبي صلى الله عليه وسلم لحكيم.(@)(@@)(@@)(@@) $ 2057 - عمر بن عبد الله 5 بن عبد الله بن عمر بن الخطاب القرشي العدوي 6، روى عنه يزيد بن الهاد، وقال ابن تليد ح ابن وهب اخ ابن أبي الزناد عن أبيه أن عمر بن عبد الله بن عمر أخبره عن PageV06P167(@)(@@) عبد الله بن عمران عمر رضى الله عنه سأله: ما معك من القرآن؟ محمد ابن معمر حدثنا أبو عامر حدثنا عبد الرحمن بن أبي الزناد عن أبيه عن عمر بن عبد الله بن عبد الله بن عمر عن ابيه عن ابن عمران عمر رضى الله عنه سأل عبد الله - نحوه.(@)(@@)(@@)(@@) $ 2058 - عمر بن عبد الله بن ابى الواقد 1 رأى انسا رضى الله عنه، روى 
ms1085	 عنه الحارث بن أبي ذباب 2.(@)(@@)(@@)(@@) $ 2059 - عمر بن عبد الله بن عمر بن الخطاب القرشي العدوى قال عبد الرحمن بن شريك حدثنا أبي عن هشام بن عروة عن عمر بن عروة بن عمر بن عبد الله بن عمر عن أبيه عن جده عمر بن الخطاب رضي الله عنه: أنه تصدق فأبصر صاحبها يبيعه أو يبيعها بكسر فسأل النبي صلى الله عليه وسلم فقال: لاتبع صدقتك في أهل المدينة 3.(@)(@@)(@@)(@@) $ 2060 - عمر بن عبد الله بن أبي ربيعة، أراه المخزومي، روى PageV06P168(@)(@@) ابن جريج حدثنا مصعب بن شيبة سمع ابن عمر رضى الله عنهما: كنا نجمع 1 مع نافع بن عبد الحارث في الحجر، وروى عطاف 2 عن عمر بن عبد الله بن أبي ربيعة عن ابن المسيب قوله، في أهل الحجاز.(@)(@@)(@@)(@@) $ 2061 - عمر بن عبد الله مولى غفرة بنت رباح أخت بلال عن ثعلبة بن أبي مالك وعبد الله بن علي بن السائب 3، روى عنه الليث وسعيد بن أبي هلال، قال عيسى بن يونس: أدرك ابن عباس رضى الله عنهما، هو مديني 4.(@)(@@)(@@)(@@) $ 2062 - عمر بن عبد الله العبسي 5 عن عبد الرحمن بن حرملة عن(@)(@@) ابن المسيب، سمع منه سعيد بن أبي أيوب، حديثه عن أهل المدينة 6، منقطع.(@)(@@)(@@)(@@) $ 2063 - عمر بن عبد الله البكري، روى عنه ابن المبارك 7.(@)(@@)(@@)(@@) $ 2064 - عمر بن عبد الله بن عبد الرحمن الرومي عن ابيه PageV06P169(@)(@@) والحسن وقتادة وأسماء بن عبيد، هو البصري، سمع منه موسى بن اسمعيل وقتيبة 1، منقطع.(@)(@@)(@@)(@@) $ 2065 - عمر بن عبد الله بن / يعلى بن مرة الثقفي الكوفي عن أبيه 2 وحكيمة، ويقال حكيمة امرأة يعلى عن يعلى بن مرة 3، روى عنه المسعودي وسليمان بن حيان ومروان بن معاوية ومطلب بن زياد وإسرائيل، وروى هشام بن خالد عن الوليد بن مسلم عن سفيان عن 4 عمر بن يعلى 4 عن أبيه عن جده عن النبي صلى الله عليه وسلم في خاتم ذهب، قال علي قال جرير: كان عمر بن يعلى يحدث عن انس رضى الله عنه، 
ms1086	 وقال لي زائدة - وكان من رهطه -: أي شئ حدثك؟ قلت: عن أنس قال: أشهد أنه شرب كذا وكذا 5 فإن شئت فاكتب وأن شئت فدع. PageV06P170(@)(@@)(@@)(@@) $ 2066 - عمر بن عبد الرحمن بن عوف الزهري القرشي الحجازي 1، قال إبراهيم بن موسى أخبرنا هشام أن ابن جريج أخبرهم أخبرني يوسف بن الحكم بن أبي سفيان أن حفص بن عمر بن عبد الرحمن ابن عوف وعمرو بن حية أخبراه عن عمر بن عبد الرحمن بن عوف وعن رجال من أصحاب النبي صلى الله عليه وسلم من الأنصار: أن رجلا جاء النبي صلى الله عليه وسلم يوم الفتح قال لئن فتح الله مكة لأصلين في بيت المقدس قال صل هاهنا وقال محمد عن ابن المبارك عن ابن جريج - نحوه، وقال عمر بن عبد الرحمن: عن رجل من الأنصار.(@)(@@)(@@)(@@) $ 2067 - عمر بن عبد الرحمن عن عبادة، روى عنه ابن عقيل 2، في أهل الحجاز.(@)(@@)(@@)(@@) $ 2068 - عمر بن عبد الرحمن بن زيد بن الخطاب قال عمر رضي الله عنه لقاتل زيد: غيب عني وجهك - قاله ابن عيينة، نراه(@)(@@) أخا 3 عبد الحميد القرشي.(@)(@@)(@@)(@@) $ 2069 - عمر بن عبد الرحمن بن قيس العسقلاني عن ابى هريرة PageV06P171(@)(@@) رضى الله عنه، روى عنه داود بن قيس، في أهل المدينة، منقطع.(@)(@@)(@@)(@@) $ 2070 - عمر بن عبد الرحمن مولى عبد الله بن عمر 1، روى عنه موسى عن عبيدة، لا يصح، اراه ابن سعيد.(@)(@@)(@@)(@@) $ 2071 - عمر بن عبد الرحمن بن عطية بن دلاف المزني المديني 2، قال عبد الله بن صالح ثنا عبد العزيز بن أبي سلمة عن عمر بن عبد الرحمن ابن دلاف: عن ابى امامة رضي الله عنه عن النبي صلى الله عليه وسلم قال: تخرج الدابة فتسم 3 الناس، وسمع أباه - فذكر الحديث بطوله، قال مالك وغيره عن عمر عن أبيه: عن عمر رضي الله عنه في الافلاس، وزاد عبيد الله عن عمر عن أبيه عن بلال بن الحارث: عن عمر رضى الله عنه، ولا يتابع فيه بلال.(@)(@@)(@@)(@@) $ 2072 - عمر بن عبد الرحمن بن 
ms1087	 جرهد بن خويلد الاسلمي، PageV06P172(@)(@@) رأى جابرا، روى عنه عبد الرحمن بن حرملة وابن إسحاق، المدني، أراه أخا زرعة.(@)(@@)(@@)(@@) $ 2073 - عمر بن عبد الرحمن بن محيصن أبو حفص السهمي القرشي المكي عن عطاء عن صفية بنت شيبة عن حبيبة بنت أبي تجراة 1، روى عنه عبد الله بن مؤمل وابن عيينة 2، وقال ابن جريج: أخبرني عمر بن عبد الرحمن - وكانت أمه بنت المطلب بن ابى وداعة - عن جعفر ابن المطلب.(@)(@@)(@@)(@@) $ 2074 - عمر بن عبد الرحمن المديني عن أبي سلمة بن سفيان، روى عنه سفيان الثوري.(@)(@@)(@@)(@@) $ 2075 - عمر بن عبد الرحمن بن مهرب ويعرف بابن الدريه، سمع وهب بن منبه قوله، سمع منه ابن المبارك وعبد الرزاق 3، قال إبراهيم بن خالد: كان 4 دريه عمه مولى الاخنس بن شريق حليف لقريش في اهل اليمن. PageV06P173(@)(@@)(@@)(@@) $ 2076 - عمر بن عبد الرحمن أبو أمية الذماري عن أبيه وعكرمة، سمع منه عبد الملك بن عبد الرحمن 1.(@)(@@)(@@)(@@) $ 2077 - عمر بن عبد الرحمن أبو حفص الأبار، سمع منصورا والأعمش 2، سمع منه محمد بن محبوب، قال سعيد بن سليمان: هو القرشي، حديثه في الكوفيين.(@)(@@)(@@)(@@) $ 2078 - عمر بن عبد الرحمن بن أسيد 3 من ولد عمر بن الخطاب رضي الله عنه القرشي العدوي المديني عن محمد بن عمار 3، سمع منه أبو نعيم وعبد الله بن نافع الصائغ 4.(@)(@@)(@@)(@@) $ 2079 - عمر بن عبد العزيز بن مروان بن الحكم القرشي الأموي رضي الله عنه، 5 وأمه ابنة عاصم 5 بن عمر الخطاب رضى الله عنه، قال عبد العزيز بن عبد الله عن مالك: ملك عمر تسعة وعشرين شهرا مثل خلافة أبي بكر وولي عمر بن الخطاب مثل مقام النبي صلى الله PageV06P174(@)(@@) عليه وسلم بالمدينة عشر سنين، قال أحمد بن أبي الطيب عن جرير قال أخبرني رجل من ولد عمر بن عبد العزيز: مات عمر وهو ابن تسع(@)(@@) وثلاثين سنة، وقال أحمد بن أبي رجاء عن أبي أسامة عن ابن المبارك عن يونس عن الزهري قال أحمد: لا اعلمه الا رفعه قال: مامن أمة يعملون 
ms1088	 بطاعة الله فتأتي عليهم المائة وهم يعملون بطاعة الله إلا أكملوا مائة أخرى وإلا أهلكوا وأمروا 1 وكان مما رحم الله هذه الأمة بخلافة عمر بن عبد العزيز رضى الله عنه فاستخلف سنة تسع وتسعين ومات سنة إحدى ومائة، قال موسى حدثنا نوح بن قيس قال سمعت أيوب يقول: لا نعلم أحدا ممن أدركنا كان آخذ من نبي الله منه، قال إسحاق: كنيته أبو حفص، اصله مدينى، مات بالشام 2.(@)(@@)(@@)(@@) $ 2080 - عمر بن عبيد الله (@)(@@) بن عبد الله بن عمر بن الخطاب القرشي العدوي </span>عن سالم، / روى عنه عمر بن محمد ويزيد بن الهاد وأبو عقيل يحيى 3 وعبيد الله بن عمر.(@)(@@)(@@)(@@) $ 2081 - عمر بن عبيد الله بن معمر التيمي القرشي 4، أراه PageV06P175(@)(@@) أخا معاذ وعبيد الله، قال ابن عبادة حدثنا يعقوب بن محمد: كنيته أبو حفص.(@)(@@)(@@)(@@) $ 2082 - عمر بن عبيد الله 1 حدثنا موسى بن حكيم، سمع منه ابن عون.(@)(@@)(@@)(@@) $ 2083 - عمر بن عبد الواحد بن قيس الدمشقي، سمع(@)(@@) الأوزاعي 2، سمع منه دحيم.(@)(@@)(@@)(@@) $ 2084 - عمر بن عبد الوهاب أبو حفص الرياحي البصري 3، PageV06P176(@)(@@) مات سنة إحدى وعشرين ومائتين لأيام بقين من شعبان.(@)(@@)(@@)(@@) $ 2085 - عمر بن عبد الملك العبدي، سمع الحسن وابن سيرين قولهما في النكاح، سمع منه موسى 1.(@)(@@)(@@)(@@) $ 2086 - عمر بن عبد الملك الكناني قال عمر بن عبد العزيز: ما وجدنا الخير إلا في الموالي - قاله ضمرة 2.(@)(@@)(@@)(@@) $ 2087 - عمر بن عبيد الصنعاني، سمع عبد الصمد بن معقل،(@)(@@) روى عنه إبراهيم بن خالد 3.(@)(@@)(@@)(@@) $ 2088 - عمر بن عبيد 4 الطنافسي الحنفي الكوفي أبو حفص عن أبي إسحاق وسماك، سمع منه أخوه يعلى ومحمد بن سلام 5، هو أخو محمد.(@)(@@)(@@)(@@) $ 2089 - عمر بن عبيد أبو حفص الخزاز بياع [الخمر] 6 السابري البصري 7، سمع يونس بن عبيد، مرسل، سمع منه عبد الله بن يزيد المقرئ PageV06P177(@)(@@) والحميدي.(@)(@@)(@@)(@@) $ 2090 - عمر بن عبيدة بن سفيان الحضرمي عن أبيه، في أهل المدينة.(@)(@@)(@@)(@@) $ 2091 - عمر بن عثمان بن عفان القرشي الأموي 1 سمع عثمان رضى الله عنه - قاله ابراهيم بن عمر بن 
ms1089	 ابان عن ابيه، في اسناده شئ.(@)(@@)(@@)(@@) $ 2092 - عمر بن عثمان بن الهدير - أراه القرشي المدني - عن عروة عن عائشة رضي الله عنها عن النبي صلى الله عليه وسلم: مروا بالمعروف، حدثنا قتيبة حدثنا عبد الحميد بن سليمان عن عمر.(@)(@@)(@@)(@@) $ 2093 - عمر بن عثمان بن عبد الرحمن بن سعيد بن الصرم المخزومي عن جده 2، سمع منه زيد بن الحباب، هو أخو محمد، المدني القرشي.(@)(@@)(@@)(@@) $ 2094 - عمر بن عثمان بن عمر أبو حفص التيمي، سمع أباه عن الزهري، المدني، سمع منه ابراهيم بن منذر 3. PageV06P178(@)(@@)(@@)(@@) $ 2095 - عمر بن أبي عثمان، سمع طاوسا قوله، سمع منه يحيى القطان.(@)(@@)(@@)(@@) $ 2096 - عمر بن علي بن أبي طالب الهاشمي القرشى، اسحاق اخ.(@)(@@) عيسى بن يونس حدثنا ابن يسار حدثنا محمد بن عمر بن علي عن أبيه: رأى عليا رضى الله عنه شرب قائما، حديثه في أهل المدينة، ابن منذر حدثنا ابن أبي فديك عن عبد الله بن محمد بن عمر بن علي بن أبي طالب رضى الله عنه عن أبيه عن جده: مشى علي رضى الله عنه في نعل.(@)(@@)(@@)(@@) $ 2097 - عمر بن علي بن حسين عن أبيه عن سعيد بن مرجانة، قال الليث عن ابن الهاد المدني: هو ابن علي بن أبي طالب القرشي الهاشمي عم جعفر بن محمد، روى عنه فضيل بن مرزوق وابن إسحاق، محمد بن أبي مريم اخبرنا يحيى بن ايوب وغيره اخ ابن الهاد عن عمر بن محمد:(@)(@@) سمعت سعيد بن مرجانة يحدث أبي يقول سمعت ابا هريرة رضى الله عنه يقول سمع النبي صلى الله عليه وسلم: من أعتق، وعن النضر بن عبد الجبار اخ نافع عن ابن الهاد أن عمر 1 بن علي بن حسين بن علي بن أبي طالب حدثنا: سمع ابن مرجانة - مثله. PageV06P179(@)(@@)(@@)(@@) $ 2098 - عمر بن علي بن المقدم أبو حفص المقدمي البصري 1، سمع ابن أبي خالد 2، قال محمد بن ابى بكر ابن أخيه: مات سنة تسعين ومائة، قال محمد بن المثنى: مات سنة ثنتين وتسعين ومائة.(@)(@@)(@@)(@@) $ 2099 - عمر 
ms1090	 بن العلاء الثقفي، قال سعيد بن منصور حدثنا فليح عن عمر بن العلاء الثقفي: (@)(@@) عن أبيه عن أبي هريرة رضي الله عنه قال النبي صلى الله عليه سلم: المدينة ومكة محفوظتان 3 بالملائكة لا يدخلهما الدجال ولا الطاعون، إن لم يكن أخو الأسود فلا أدري، حديثه في أهل المدينة.(@)(@@)(@@)(@@) $ 2100 - عمر بن العلاء 4، رأى سهل بن سعد رضي الله عنه، سمع منه ابن مهدي.(@)(@@)(@@)(@@) $ 2101 - عمر بن عمران الأعمى، 5 سمع أبا رجاء ورأى الحسن وعن الحجاج عن أبي حمزة، سمع منه عبد الصمد، وعن ابى نضرة قوله 5. PageV06P180(@)(@@)(@@)(@@) $ 2102 - عمر بن عاصم بن عمر بن سعد القرظ المؤذن عن جده عمر بن سعد ومحمد، روى عنه محمد بن عجلان المديني، يقال مولى آل عمار بن ياسر مولى بني مخزوم، المديني.(@)(@@)(@@)(@@) $ 2103 - عمر بن عروة 1.(@)(@@)(@@)(@@) $ 2104 - عمر بن عامر السلمي أبو حفص البصري عن قتادة وحماد 2، روى عنه سالم بن نوح وابن أبي عروبة ويزيد بن زريع وعباد ابن العوام.(@)(@@)(@@)(@@) $ 2105 - عمر بن عطاء (@)(@@) بن أبي الخوار </span>عن عبيد بن جريج، سمع منه ابن جريج وإسمعيل بن أبي أمية، وسمع ابن عباس رضي الله عنهما والسائب بن يزيد ونافع بن جبير، حديثه في المكيين 3.(@)(@@)(@@)(@@) $ 2106 - عمر بن عطاء بن وراد 4 عن عكرمة، روى عنه / ابن جريج.(@)(@@)(@@)(@@) $ 2107 - عمر بن عطاء 5، عمرو بن علي حدثنا أبو قتيبة حدثنا PageV06P181(@)(@@) عمر بن عطاء بن أبي الحجار: حدثني أبو سلمة: سأل عائشة رضى الله عنها في الصوم، وقال الفضل بن يعقوب حدثنا الهيثم بن جميل حدثنا عمر بن حفص بن حجار: عن أبي سلمة سمعت عائشة رضى الله عنها سمعت النبي صلى الله عليه وسلم: إذا التقى الختانان، وقال أبو النضر ومحمد بن عمرو: عن أبي سلمة عن عائشة رضى الله عنها قولها.(@)(@@)(@@)(@@) $ 2108 - عمر بن عيسى 1 عن ابن جريج، روى عنه الليث، منكر الحديث.(@)(@@)(@@)(@@) $ 2109 - عمر بن عطية عن أبي جعفر في النفير قوله 2، روى عنه الثوري، في الكوفيين.(@)(@@)(@@)(@@) $ 2110 - عمر بن 
ms1091	 عمران 3، قال منذر الجارودي: حدثنا عمر ابن عمران أبو حفص السدوسي حدثنا سعيد بن مرزبان: رأيت على عبد الله بن أبي أوفى ضربة قال: أصابتني يوم حنين.(@)(@@)(@@)(@@) $ 2111 - عمر بن عمرو 4 عن أبي عون الأنصاري: بسط رجل PageV06P182(@)(@@) يده إلى طعام فقال: بسم الله والبركة، فقال أبو إدريس الخولاني قل: بسم الله وحده - قاله عبد الله عن معاوية.(@)(@@)(@@)(@@) $ 2112 - عمر بن أبي عمرو: أضفت أبا جعفر 1 فقال: أضافنا 2 عبد الله بن عمرو، حدثنا محمد اخبرنا عبد الله اخبرنا ابن أبي ذئب عن عمرو 3 بن أبي عمرو: كنت أذبح في جهينة فأتيت رجلا من سادتهم يقال له أبو جعفر - بهذا.(@)(@@)(@@)(@@) $ 2113 - عمر بن عمر بن محمد بن حاطب الجمحي القرشي، سمع جده محمد بن حاطب، روى عنه عبد الله بن الوليد 4، في الكوفيين.(@)(@@)(@@)(@@) $ 2114 - عمر بن عمير عن محدوج عن جسرة: سمعت ام سلمة رضى الله عنها قال النبي صلى الله عليه وسلم: لا يحل المسجد لجنب إلا لكذا - قاله يونس بن أرقم سمع منصور بن أبي الاسود، وروى PageV06P183(@)(@@) ابن أبي غنية 1: عن أبي الخطاب الهجري 2 عن محدوج الذهلي وقال 3 أفلت عن جسرة 4 عن عائشة رضي الله عنها عن النبي صلى الله عليه وسلم،(@)(@@) ولا يصح هذا عن النبي صلى الله عليه وسلم، وروى لى بن ميسر عن عمر بن عمير أبي الخطاب الهجري: عن عروة بن فيروز 4، في الكوفيين.(@)(@@)(@@)(@@) $ 2115 - عمر بن أبي حفص 5 المديني، اراه ابن أبي عتاب.(@)(@@)(@@)(@@) $ 2116 - عمر العنزي عن 6 عمر بن عبد العزيز في الأرض - قاله همام عن قتادة، منقطع. PageV06P184(@)(@@)(@@)(@@) ||| باب غ(@)(@@)(@@)(@@) $ 2117 - عمر بن غياث عن عاصم 1، منكر الحديث، ولم يذكر سماعا من عاصم، روى عنه معاوية بن هشام وأبو نعيم.(@)(@@)(@@)(@@) ||| باب ف(@)(@@)(@@)(@@) $ 2118 - عمر بن فروخ القتاب 2 العبدي عن بسطام بن النضر وحبيب بن الزبير، سمع منه أبو نعيم وحفص الحوضي البصري.(@)(@@)(@@)(@@) $ 2119 - عمر بن الفضل، إسحاق حدثنا حرمي حدثنا عمر بن الفضل الحرشي، سمع 
ms1092	 أبا العلاء بن الشخير وكعب بن جراد 3، سمع منه أبو نعيم، قال يحيى القطان: عمر بن الفضل أحب إلي من المختار بن عمرو، PageV06P185(@)(@@) البصري الحداني.(@)(@@)(@@)(@@) $ 2120 - عمر بن فرقد الباهلي أخو 1 رديعة الباهلية 1 عن عطاء ابن السائب، سمع منه موسى 2، فيه نظر، البصري.(@)(@@)(@@)(@@) ||| باب ق(@)(@@)(@@)(@@) $ 2121 - عمر بن قيس أبو الصباح الماصر 3، كناه وكيع،(@)(@@) عن مجاهد وزيد بن وهب، يقال مولى ثقيف، روى عنه الثوري وزائدة، وقال أحمد بن إسحاق عن أشهل 4: حدثنا ابن عون عن عمر ابن قيس الماصر عن أبي ميسرة عمرو بن شرحبيل - أو - شراحيل: دخلت 5 وثم حذيفة والأشعري فقال ابن مسعود: أقرأني النبي صلى الله عليه وسلم بضعا وسبعين سورة، وقال ابن المثنى في معاذ بن معاذ: حدثنا ابن عون حدثني عمر بن قيس 6 عن عمرو بن شرحبيل - أو - شراحيل أبي ميسرة الهمداني، وقال بعضهم: عمرو بن قيس، ولا يصح، PageV06P186(@)(@@) في الكوفيين، وقال ابن طهمان: عن عمرو بن قيس الماصر 1: خاصمت إلى شريح في برذون - بهذا.(@)(@@)(@@)(@@) $ 2122 - عمر بن قيس أخو حميد بن قيس المكي، منكر الحديث، قال يحيى القطان: كنت قاعدا في المسجد ليلة 2 وعمرو بن قيس يحدث 3 وما حفل يحيى به 3، قال يحيى: سمعته يحدث عن عطاء عن عبيد بن عمير في دية اليهودي والنصراني وأعاجيب 4، قال ابن معين: مولى منظور بن سيار الفزاري، أبو حفص المعروف 5 أنه مولى بنى اسد ابن عبد العزى.(@)(@@)(@@)(@@) $ 2123 - عمر بن قتادة بن النعمان الأنصاري المديني الظفري الأوسي عن أبيه، روى عنه ابنه عاصم.(@)(@@)(@@)(@@) $ 2124 - عمر بن قدامة عن شريح في البيع - قاله ابن المبارك عن معمر عن ايوب 6، منقطع. PageV06P187(@)(@@)(@@)(@@) ||| باب ك(@)(@@)(@@)(@@) $ 2125 - عمر بن كثير بن أفلح (@)(@@) مولى أبي أيوب الأنصاري رضى الله عنه </span>عن ابى محمد نافع 1 وابن سفينة وعبيد سنوطا، سمع منه يحيى بن سعيد الأنصاري وابن عون 2 وسعيد بن سعيد، وقد روى عثمان بن حكيم: حدثنا 3 محمد بن أفلح 3 مولى أبي أيوب عن 
ms1093	 أسامة.(@)(@@)(@@)(@@) $ 2126 - عمر بن كثير بن أفلح، سمع عبد الرحمن بن كيسان، وروى 4 ابن المثنى عن معاذ عن ابن عون: عمر بن كثير 4 بن أفلح بن عمر كان يكره أن يصلي إلى العود القائم.(@)(@@)(@@)(@@) $ 2127 - عمر بن كثير بن المطلب بن أبي وداعة السهمى PageV06P188(@)(@@) القرشى المكى، سمع منه العمرى، اراه أخا كثير بن كثير.(@)(@@)(@@)(@@) $ 2128 - عمر بن كثير الثقفي عن رجلين عن عمر، مرسل، روى عنه يزيد الدالاني، وروى مسعر عن عمر بن كثير عن الشعبي: اعترض به 1 الحدر - يعني الذكر 1، في الكوفيين.(@)(@@)(@@)(@@) $ 2129 - عمر بن كعب، قال أحمد بن عيسى حدثنا ابن وهب أخبرني مخرمة بن بكير 2 عن أبيه عن عمر بن كعب قال: أخبرتني أم طلحة: 3 ما رأيت عائشة رضى الله عنها تصلي في درع وخمار وليس عليها جلباب 3.(@)(@@)(@@)(@@) $ 2130 - عمر بن أبي كبشة 4، سمع مورقا، روى عنه سلام ابن أبي مطيع، البصري، منقطع.(@)(@@)(@@)(@@) $ 2131 - عمر بن كيسان، سمع وهب بن ابى مغيث، سمع منه ابنه إبراهيم 5.(@)(@@)(@@)(@@) ||| باب ل(@)(@@)(@@)(@@) $ 2132 - عمر بن ابى ليلى (@)(@@) </span>عن عامر 6. PageV06P189(@)(@@)(@@)(@@) $ 2133 - عمر بن أبي ليلى، روى عنه الحكم المكي، وقال بعضهم: عمر بن أبي ليلى 1 أخو بني عامر 1، سمع محمد بن كعب قوله.(@)(@@)(@@)(@@) ||| باب م(@)(@@)(@@)(@@) $ 2134 - عمر بن محمد بن زيد بن عبد الله بن عمر القرشي العدوي العسقلاني 2، سمع أباه وسالما، سمع منه يزيد بن زريع وأبو عاصم، روى عنه مالك والثوري، هو أخو واقد وعاصم وزيد وأبي بكر.(@)(@@)(@@)(@@) $ 2135 - عمر بن محمد بن معدان 3، يعد في البصريين، سمع عمران القصير، روى عنه أيوب بن سليمان 4. PageV06P190(@)(@@)(@@)(@@) $ 2136 - عمر بن محمد بن جبير بن مطعم بن عدي القرشي عن محمد بن جبير، سمع منه الزهري ولم يقم معمر عن الزهري، هو أخو جبير وسعيد.(@)(@@)(@@)(@@) $ 2137 - عمر بن محمد الاسلمي عن مليح 1، روى، 2 ابن أبي الفديك 2.(@)(@@)(@@)(@@) $ 2138 - عمر بن محمد بن علي 3، روى عنه أبو جعفر الرازي.(@)(@@)(@@)(@@) $ 2139 - عمر بن محمد بن يحيى بن سعيد بن 
ms1094	 العاص القرشي، سمع قيس بن محمد 4، سمع منه حماد بن سلمة، نسبه عفان وموسى، وقال إسحاق حدثنا أبو الوليد حدثنا حماد: عن عمرو بن يحيى بن سعيد بن العاص القرشي حدثني قيس بن محمد بن الأشعث: أن محمد بن الأشعث وهب له الأشهب.(@)(@@)(@@)(@@) $ 2140 - عمر بن محمد بن المنكدر التيمي القرشى 5، عداده في PageV06P191(@)(@@) أهل المدينة، قال علي بن حفص أخبرنا ابن المبارك قال اخ وهيب عن عمر بن محمد بن المنكدر: عن سمي عن أبي صالح عن أبي هريرة رضي الله عنه عن النبي صلى الله عليه وسلم قال: من مات ولم يغز ولم يحدث نفسه بغزو مات على شعبة من النفاق، روى عنه هشام بن حسان وعبد الله بن رجاء، يروي عن أبيه، قال ابن عيينة: رأيت عمر مع أبيه.(@)(@@)(@@)(@@) $ 2141 - عمر بن محمد بن الحسن 1 الأسدي الكوفي، سمع أباه، مات في شوال سنة خمسين ومائتين.(@)(@@)(@@)(@@) $ 2142 - عمر بن المرقع بن صيفي 2 التميمي، سمع منه عبد الله بن إدريس وأبو الوليد، في الكوفيين.(@)(@@)(@@)(@@) $ 2143 - عمر بن معتب عن أبي حسن مولى بني نوفل، روى عنه يحيى بن أبي كثير.(@)(@@)(@@)(@@) $ 2144 - عمر بن مغيث 3، في أهل المدينة، قال على ومسدد: PageV06P192(@)(@@) حدثنا يحيى 1 حدثنا علي حدثنا يحيى: حدثه عمر بن معتب حدثه أبو حنين مولى بني نوفل، وقال يحيى بن صالح حدثنا معاوية عن يحيى: عن عمر، وقال هشام وشيبان عن يحيى: عن عروة، إسحاق أخبرنا يحيى بن صالح ثنا معاوية عن يحيى: عن عمر 2 بن معتب سمع أبا حنين، يحيى ثنا عبد الرزاق عن معمر عن يحيى: عن عمر 2 بن معتب عن أبي الحسن 3 مولى بني نوفل - مثله.(@)(@@)(@@)(@@) $ 2145 - عمر بن أبي مغيث 4، سمع حصين بن أوس، روى عنه محمد بن أبي يحيى، وروى جابر عن محمد بن أبي يحيى: عن عمرو بن أبي مغيث قال عمر رضي الله عنه في الجد، في اهل المدينة. PageV06P193(@)(@@)(@@)(@@) $ 2146 - عمر بن ميمون البصري القيسي 1، سمع عدي بن 
ms1095	 أبي القلوص - أو - سفيان بن الحجاج، روى عنه محمد بن عقبة، كذا في العتيق 2.(@)(@@)(@@)(@@) $ 2147 - عمر بن محرز الأشجعي، مرسل، روى عنه الزهري - قاله الاويسى ح عبد العزيز بن محمد عن محمد بن عبد الله بن شهاب: قال ابن شهاب، وقال عبد الله حدثنى الليث حدثنا ابن مسافر عن ابن شهاب: عن عمر بن محرز الأشجعي، وقال ابن عفير حدثنا الليث عن ابن مسافر عن ابن شهاب: بلغه عن عمرو بن محرز الأشجعي، قال ابن عفير: وهو أول مولود ولد بحمص.(@)(@@)(@@)(@@) $ 2148 - عمر بن مالك 3 عن صفوان بن سليم، سمع منه ابن وهب. PageV06P194(@)(@@)(@@)(@@) $ 2149 - عمر بن أبي مالك 1 عن ابن شهاب وعبد الرحمن بن عثمان بن سعد بن أبي وقاص، روى عنه سعيد بن ابى أيوب.(@)(@@)(@@)(@@) $ 2150 - عمر بن مخراق عن رجل عن عائشة رضى الله عنها، مرسل، روى عنه أسامة بن زيد.(@)(@@)(@@)(@@) $ 2151 - عمر بن مجاشع المدائني عن عبد العزيز بن صهيب(@)(@@) عن انس رضى الله عنه في بيع الماء 2 - (@)(@@) قاله عمرو بن محمد: سمع الخضر بن محمد 3 سمع عمر، وقال عبد العزيز: حدثنا الخضر حدثنا عمر عن عبد الملك ابن أبي بشير 4 عن عكرمة عن ابن عباس رضي الله عنهما: كنا عند النبي صلى الله عليه وسلم فنزلت " إذا جاء 5 " فقال هم أهل اليمن.(@)(@@)(@@)(@@) $ 2152 - عمر بن معدان، سمع انسا رضى الله عنه وعن مطرف، روى عنه قتادة وسلام بن مسكين 6، قال مهدي بن ميمون: مات قبل محمد بن سيرين، في البصريين.(@)(@@)(@@)(@@) $ 2153 - عمر بن معن قال في يوسف بن ماهك 7، روى عنه ابن المبارك. PageV06P195(@)(@@)(@@)(@@) $ 2154 - عمر بن مصعب بن الزبير بن العوام القرشي، / روى عنه سعيد بن زيد 1 وعبد الله التوأم 2، قال ابراهيم بن موسى اخ محمد بن ربيعة عن روح بن غطيف الثقفي: عن عمرو 3 بن مصعب عن عروة بن الزبير عن عائشة رضي الله عنها: " وتأتون في ناديكم المنكر " قال: الضراط، وروى روح هذا الحديث وهو مقلوب، 
ms1096	 وروى موسى عن 4 سعيد بن زيد عن أبي هلال 4: عن عمرو 5 بن مصعب بن الزبير القرشي.(@)(@@)(@@)(@@) $ 2155 - عمر بن معروف 6 عن عكرمة، روى عنه جرير(@)(@@) ابن عبد الحميد PageV06P196(@)(@@)(@@)(@@) $ 2156 - عمر بن موسى بن عبد الله بن يزيد الخطمي الأنصاري الكوفي عن أبيه، سمع منه أبو نعيم.(@)(@@)(@@)(@@) $ 2157 - عمر بن موسى 1، هو الوجيهي عن القاسم عن أبي أمامة رضي الله عنه: تدلى أبو بكر رضى الله عنه، سمع منه عبد الرحمن بن إبراهيم، فيه نظر، وروى ابن إسحاق: عن عمرو 2 بن موسى بن وجيه عن أبي سفيان عن عبد الرحمن بن أبي بكرة في الدعاء، منكر الحديث.(@)(@@)(@@)(@@) $ 2158 - عمر بن مهاجر أبو حفص الأنصاري، قال ابن المبارك عن سفيان: هو البصري، قال أبو نعيم حدثنا سفيان عن عمر الأنصاري: رأى أنس بن مالك رضى الله عنه يصلي جالسا متربعا.(@)(@@)(@@)(@@) $ 2159 - عمر بن مزيد السعدى 3، في البصريين، روى يحيى ابن سعيد عن عمر بن مزيد: صليت مع سوار بن شبيب 4، وقال وكيع: عمر بن منبه السعدي - هذا الحديث بعينه.(@)(@@)(@@)(@@) $ 2160 - عمر بن مضرس بن عثمان الجهني عن أبيه 5 عن PageV06P197(@)(@@) النبي صلى الله عليه وسلم، روى عنه حرملة بن عبد العزيز، هو أخو عثمان.(@)(@@)(@@)(@@) $ 2161 - عمر بن مرة، سمع بلال بن يسار، روى عنه حفص ابن عمر الشني ابنه، حديثه عن البصريين.(@)(@@)(@@)(@@) $ 2162 - عمر بن مسلم بن سالم، هو عمر بن أبي فروة أبو حفص الجهني 1 الكوفي، سمع أباه مراسيل.(@)(@@)(@@)(@@) $ 2163 - عمر بن أبي مسلم 2 عن عروة قوله - قاله العقدي عن ابن أبي الموال.(@)(@@)(@@)(@@) $ 2164 - عمر بن مسكين المدني، روى عنه عبد الرحمن المحاربي، يروى عن نافع عن ابن عمر رضي الله عنهما في الجنازة، لا يتابع عليه.(@)(@@)(@@)(@@) $ 2165 - عمر بن مساور العجلي 3 عن الحسن البصري، روى عنه عبد الرحمن المحاربي. PageV06P198(@)(@@)(@@)(@@) $ 2166 - عمر بن مساور - أو - مسافر 1 عن أبي جمرة عن ابن عباس رضى الله عنهما عن النبي صلى الله عليه وسلم: بارك 2 
ms1097	 لأمتي في بكورها، منكر، وروى حبان حدثنا عمر بن مسافر المنقري: سمع الحسن قوله، وقال معلى حدثنا عمر بن مسافر العتكي: عن أبي جمرة، في البصريين، لا يتابع عليه.(@)(@@)(@@)(@@) $ 2167 - عمر بن ميسرة، قال ابن حمزة 3 حدثنا حاتم بن اسمعيل عن محمد بن عثمان بن سعيد بن يربوع: حدثني عمر بن ميسرة مولانا إذ 4 قامت الصلوة فجعلنا نسرع المشي فلقينا سعد بن أبي وقاص فدفع في صدري - أو - في صدر بعضنا فقال: على رسلك فإنك في صلاة ولك بكل خطوة اجر، في أهل المدينة، وأما محمد بن عثمان فهو 5 مجروح قريش 5.(@)(@@)(@@)(@@) ||| باب ن(@)(@@)(@@)(@@) $ 2168 - عمر بن نافع مولى عبد الله بن عمر بن الخطاب PageV06P199(@)(@@) رضى الله عنه القرشي العدوي المديني عن أبيه 1، روى عنه عبيد الله بن عمر 2 وزهير، قال علي قال سفيان قال لي زياد 3 حين أتينا ابن نافع: هذا احفظ ولد نافع - يعني - عمر بن نافع 4 حديثه صحيح عن نافع 4: كان أنس بن مالك رضي الله عنه يأتي من الزاوية 5 على فرسخين من البصرة يشهد الجمعة.(@)(@@) وعن عكرمة 6 وأبي بكر، سمع منه يحيى بن مصعب 7 وأبو PageV06P200(@)(@@) معاوية 1، يقال الثقفي 2.(@)(@@)(@@)(@@) $ 2169 - عمر بن نصر المحاربي 3 عن ابن الصفار، روى عنه مسعر، في الكوفيين.(@)(@@)(@@)(@@) $ 2170 - عمر بن نبيه الخزاعي الأزدي عن أبي عبد الله القراظ 4، روى عنه شريك بن أبي نمر وسليمان بن بلال وحاتم بن اسمعيل، في أهل المدينة.(@)(@@)(@@)(@@) $ 2171 - عمر بن نبهان (@)(@@) </span>5، قال سعيد بن يحيى حدثنا أبي حدثنا ابن جريج اخ أبو الزبير عن عمر بن نبهان: عن ابى ثعلبة الاشجعى رضى الله عنه قلت للنبي صلى الله عليه وسلم: مات لي ولدان، فقال: من مات له [ولدان] 6 في الاسلام ادخله الله الجنة 7. PageV06P201(@)(@@)(@@)(@@) $ 2172 - عمر بن نعيم، سمع أسامة بن سلمان 1، روى عنه مكحول، في الشاميين.(@)(@@)(@@)(@@) $ 2173 - عمر بن نبهان 2، قال يحيى بن موسى حدثنا عبد الزراق أخبرنا جعفر بن سليمان عن عمر بن نبهان: 
ms1098	 عن قتادة عن أنس رضي الله عنه أن النبي صلى الله عليه وسلم قال حين أسري به قال 3: مررت بقوم يقرض شفاههم بمقاريض من نار يقولون مالا يعلمون 4 - (@)(@@) فذكر الحديث بطوله، قال بشار ح عمر بن نبهان: سمع حميدا عن هلال، مرسل، وقال العنبري حدثنا سلم 5 بن قتيبة عن عمر بن نبهان: عن قتادة عن انس رضى الله عنه رأيت النبي صلى الله عليه وسلم يصلي في نعليه وخفيه ويدعو بظاهر كفيه وباطنهما 6، عمرو بن علي حدثنا سلم 5 بن قتيبة حدثنا عمر بن PageV06P202(@)(@@) نبهان الغبري 1: سمع سلاما أبا عيسى، قال عمرو بن علي: يقال له عمر(@)(@@) الدري 2، لا يتابع في حديثه.(@)(@@)(@@)(@@) ||| باب و(@)(@@)(@@)(@@) $ 2174 - عمر بن الوليد الشني، (@)(@@) سمع منه وكيع، قال يحيى بن معين: كنيته أبو سلمة، العبدي هو البصري من عبد القيس 3.(@)(@@)(@@)(@@) $ 2175 - عمر بن أبي وهب الخزاعي عن موسى بن وردان 4، سمع PageV06P203(@)(@@) منه ابن المبارك 1، قال عبد الصمد ح 2 عمر بن أبي وهب 3 - (@)(@@) وهو الذي أعتق سلام بن ابى مطيع وأباه - قال: ح موسى بن فروان، قال عبد الصمد: فقلت ابن محمد العطار قد لقي هذا الشيخ وهو يقول: ابن ثروان،(@)(@@) قال: لا، هو ابن فروان، وكان عبد الصمد قد حدث مرة فقال /: ثروان: يعد في البصريين.(@)(@@)(@@)(@@) ||| باب ه(@)(@@)(@@)(@@) $ 2176 - عمر بن هارون الأنصاري الزرقي 3 عن أبيه، روى عنه عمر بن حمزة، وروى موسى بن عبيدة حدثنا عمر بن هارون: عن ابى هريرة رضي الله عنه عن النبي صلى الله عليه وسلم، فلا أدري هو هذا أم لا.(@)(@@)(@@)(@@) $ 2177 - عمر بن أبي هوذة 4 الرازي البلخي عن ابن جريج، PageV06P204(@)(@@) تكلم فيه يحيى بن معين.(@)(@@)(@@)(@@) $ 2178 - عمر بن الهجنع 1 عن ابى بكرة رضى الله عنه، قال أبو نعيم حدثنا عبد الجبار بن عباس عن عطاء بن السائب: عن عمر بن الهجنع عن أبي بكرة رضي الله عنه قيل: ما يمنعك أن لا تكون قاتلت على بصيرتك يوم الجمل؟ قال: سمعت النبي 
ms1099	 صلى الله عليه وسلم يقول:(@)(@@) يخرج قوم هلكى لا يفلحون قائدهم امرأة قائدهم في الجنة.(@)(@@)(@@)(@@) $ 2179 - عمر بن هرمز المروي 2، سمع الربيع بن أنس، منقطع، سمع منه إسحاق، بن إبراهيم.(@)(@@)(@@)(@@) ||| باب ي(@)(@@)(@@)(@@) $ 2180 - عمر بن يزيد النصري عن ثميل 3 وعمرو بن مهاجر، روى عنه عبد الله بن سالم ومحمد بن شعيب الشامي. PageV06P205(@)(@@)(@@)(@@) $ 2181 - عمر بن يزيد خال أبي معاوية 1، رأى طاوسا، روى عنه محمد بن خازم.(@)(@@)(@@)(@@) $ 2182 - عمر بن يزيد العبدى 2 سمع الحسن " وتمت كلمة ربك الحسنى " - قاله حيان حدثنا حماد بن زيد حدثنا عمر، سليمان حدثنا حماد عن عمر بن يزيد: قال الحسن.(@)(@@)(@@)(@@) $ 2183 - عمر بن يعقوب 3.(@)(@@)(@@)(@@) $ 2184 - عمر بن يحيى الزرقي الأنصاري: أن أبا بكر وعمر رضى الله عنهما، روى عنه عبد الله بن عون، مرسل.(@)(@@)(@@)(@@) $ 2185 - عمر بن يونس بن القاسم أبو حفص الحنفي اليمامي، سمع عكرمة بن عمار 4.(@)(@@)(@@)(@@) ||| ومن أفناء الناس(@)(@@)(@@)(@@) $ 2186 - عمر الدمشقي عن أم الدرداء رضى الله عنها، روى عنه سعيد بن أبي هلال، منقطع.(@)(@@)(@@)(@@) $ 2187 - عمر مولى آل منظور بن سيار 5، سمع عاصم بن PageV06P206(@)(@@) عبيد الله، روى عنه عمر (@)(@@) بن علي.(@)(@@)(@@)(@@) $ 2188 - عمر التميمي عن الحسن بن على رضى الله عنهما قال: سألت هند بن أبي هالة رضى الله عنه - قاله 1 عمرو بن محمد القرشي عن جميع بن عمر عن يزيد بن عمر عن أبيه، لا أراه يصح 2.(@)(@@)(@@)(@@) $ 2189 - عمر، قال هشام الدستوائي عن يحيى بن أبي كثير: عن عمر عن رجل من الأنصار عن القاسم بن عبد الرحمن مولى يزيد بن معاوية عن النبي صلى الله عليه سلم: من قطع رحما أو حلف على يمين فاجرة 3 رأى وباله 3 قبل أن يموت، وقال سليمان بن بلال عن ابن علاثة عن هشام بن حسان عن يحيى بن أبي كثير: عن أبي سلمة بن عبد الرحمن عن أبيه عن النبي صلى الله عليه وسلم - نحوه، وقال النفيلي عن أبي(@)(@@) الدهماء عن محمد بن عمرو: عن أبي سلمة عن ابى هريرة 
ms1100	 رضي الله عنه عن النبي صلى الله عليه وسلم - نحوه. PageV06P207(@)(@@)(@@)(@@) $ 2190 - عمر، قال محمد بن المثنى حدثنا وهب بن جرير حدثنا أبي سمعت يحيى بن أيوب عن يزيد بن أبي حبيب عن عمر: عن سعد بن أبي وقاص رضي الله عنه عن النبي صلى الله عليه وسلم قال: لو أن ما يقل الظفر مما في الجنة برز لأهل الدنيا لتزخرف لهم مابين خوافق السماوات ولو أن رجلا من أهل الجنة اطلع يده 1 - (@)(@@) فذكره، وقال ابن وهب أخبرنا عمرو أن سليمان بن حميد حدثه: أن عامر بن سعد بن أبي وقاص - قال سليمان: لا أعلمه إلا عن أبيه عن النبي صلى الله عليه وسلم.(@)(@@)(@@)(@@) || باب عثمان(@)(@@)(@@)(@@) $ 2191 - عثمان بن عفان بن أبي العاص بن امية القرشى أبو عمرو PageV06P208(@)(@@) ويقال أيضا أبو عبد الله الأموي رضي الله عنه، قال ابن أبي أويس عن ابن وهب عن يونس عن ابن شهاب: ولي ثنتى عشرة سنة حجها كلها الاسنتين، مات سنة اربع وثلاثين، قال اسمعيل حدثني عبد الرحمن بن أبي الزناد عن أبي الزناد أن عامر بن سعد بن ابى وقاص اخبره سمع عثمان ابن عفان رضى الله عنه يقول: ما يمنعني أن أحدث عن النبي صلى الله عليه وسلم أن لا أكون من أوعى أصحابه عنه ولكني سمعت النبي صلى الله عليه وسلم يقول: من قال علي ما لم أقل فليتبوأ مقعده من النار، وهو ختن النبي صلى الله عليه وسلم على ابنتيه رقية وأم كلثوم رضى الله عنهما، وشهد له النبي صلى الله عليه وسلم بالجنة.(@)(@@)(@@)(@@) $ 2192 - عثمان بن حنيف الأنصاري رضي الله عنه، قال شهاب 1 حدثنا حماد بن سلمة: عن أبي جعفر الخطمي عن عمارة بن خزيمة بن ثابت 2: عن عثمان بن حنيف أتى أعمى النبي صلى الله عليه وسلم: فقال: ادع الله تعالى أن يرد بصري، قال: أو أدعك؟ قال: لا، بل ادع الله، قال ثلاثا، ثم قال: توضأ وصل ركعتين وقل: " اللهم إني أسألك وأتوجه إليك " ففعل 