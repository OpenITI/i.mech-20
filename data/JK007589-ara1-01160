ms1156	 % % عدى عن ذكر ما مضى واستمرت % 308(@)(@@) % دون مأتاه مرة الأوذام % % وفلاة قطعتها بفلاة % 309(@)(@@) % كاللياح الملمع الأعلام % % بات في لجة الظلام فريدا % 310(@)(@@) % تحت أهوال رائح مرزام % مطرقا يبحث الروي عن الظم % PageV01P4386 311(@)(@@) % آن عن عانك ركام هياه % % عطف الليل هيدبيه عليه % % 312(@)(@@) % وتداعت سماؤه بانهدام % % يقق اللون كالملاءة إلا % 313(@)(@@) % لمعا فيشواه مثل الوشام % % ينتمي كله إلى آل سام % 314(@)(@@) % غير هاتيك فهي من آل حام % % تلك أو سفعة بخديه تهدي % % 315(@)(@@) % جدة في سراته كالعصام % % هنة قومت وعوج منها % % 316(@)(@@) % فتراها كأنها خط لام % % حطها في القرا وفي الذنب الزا % % 317(@)(@@) % ئل قسمين أعدل القسام % % ذو إهاب يضاحك البرق مالا % % 318(@)(@@) % ح وطورا يضيء في الإظلام % % ضوعف الليل في الكثافة والطو % % 319(@)(@@) % ل عليه بمرحجن ركام % % وخريق تلفه في كناس % % 320(@)(@@) % عدملي بجانبيه حوامي % % دمنته الأرواح قدما فريا % % PageV01P4387 321(@)(@@) % ه كريا حرائر الأهضام % % رقرقته الشمال والرعد والبر % 322(@)(@@) % ق وفيقات وابل سجام % % حرجف لو عاداه منها أذى القر % 323(@)(@@) % ر كفاه دؤوبها في الموامي % % وسوار عليه لو كفت القط % 324(@)(@@) % ر أطارت كراه بالإرزام % % دأبه ذاك فحمة الليل حتى % % 325(@)(@@) % طلع الفجر ساطعا كالضرام % % أنقذ الصبح شلوه من شفا ال % 326(@)(@@) % موت فأضحى يعلو رؤوس الأكام % % فرحا بالنجاة ترمي به المي % 327(@)(@@) % عة رمي الوليد بالمهزام % % بينما الشاة ناصلا من هنات % 328(@)(@@) % بات يشقى بهن ليل التمام % % قد صحت شمسه وأقفر إلا % 329(@)(@@) % من نعاج خواذل ونعام % % يصطلي جمرة النهار ويلهو % % 330(@)(@@) % بالرخامى وخلفه العلام % % إذ أتيحت له ضوار وطمل % % PageV01P4388 331(@)(@@) % ماله غير صيدها من طعام % % ينتهبن المدى إليه ويضرم % 332(@)(@@) % ن له الشد أيما إضرام % % ولديه لهن إن فر أو كر % 333(@)(@@) % ر عتاد المفر والمقدام % % فترامت به الأجاري شأوا % 334(@)(@@) % ثم ثابت حفيظة من محامي % % كر فيها بمذوديه مشيحا % 335(@)(@@) % فسقاها كؤوس موت زؤام % % فارعوت من مرنح وصريع % % 336(@)(@@) % ومول مهتك النحر دامي % % ومضى يعسف النجاء كما زل % 337(@)(@@) % ل من المنجنيق مردي رجام % % أو 
ms1157	 كما انقض كوكب أو كما طا % % 338(@)(@@) % رت من البرق شقة في غمام % ذاك شبهت ناقتي حين راحت % % 339(@)(@@) % صخبا رحلها كتوم البغام % % ميلع الوخد تقذف المرو بالمر % 340(@)(@@) % و وترمي اللغام بعد اللغام % % كم أجازت إلى الأمير عبيد ال % PageV01P4389 341(@)(@@) % له حامي الحمى وراعي الذمام % % عبدلي مهذب طاهري % 342(@)(@@) % مصعبي يبد كل مسامي % % فيه جد الفتى وحلم المذكي % % 343(@)(@@) % وحجا الكهل وارتياح الغلام % % ملك حل من سماء المعالي % % 344(@)(@@) % فوق شمس الضحى وبدر الظلام % % حل منها محل أنجمها الزه % 345(@)(@@) % ر سواقي الغيوث والأعلام % % فهو فيها مغوثة وهدى للن % 346(@)(@@) % ناس عين الجواد والعلام % % وهو من بعد ذاك زينتها الحس % 347(@)(@@) % نى بذاك السنا وذاك الوسام % % وهو إن مارس الخطوب فناهي % % 348(@)(@@) % ك به أي واصل صرام % ذو هنات بهن يلتئم الصد % 349(@)(@@) % ع إذا قلت لات حين التئام % % ثاقب الفكر ما تمهل في الرأ % 350(@)(@@) % ي شديد الإسداء والإلحام % % فإذا باده الحوادث بالرأ % % PageV01P4390 351(@)(@@) % ي أصاب الصواب بالإلهام % % ألمعي موفق بهدي الل % 352(@)(@@) % ه لد الخطة الغياء العقام % % وإذا الشك خالج الرأي أمضى % % 353(@)(@@) % رأيه عزم عازم مجذام % % لا كإمضاء جاهل عجرفي % 354(@)(@@) % يركب الرأي قبل شد الحزام % % صاحب السيف والمكائد والنق % % 355(@)(@@) % ص لتلك الأمور والإجرام % لا تراه يخف للمستخفا % % 356(@)(@@) % ت ولا يستكين للآلام % % جبل الأرض ذو الشماريخ والأط % % 357(@)(@@) % واد والناس حوله كالرضام % % صاحب الدعوة التي ردت الحق % 358(@)(@@) % ق على أهله برغم الرغام % % والذي أسرع الإجابة واستع % 359(@)(@@) % جل قبل الإسراج والإلجام % % صاحب النصرة التي شفعت نص % 360(@)(@@) % رة أهل الفسيل والآطام % % صاحب الشرطة الذي انهزم الطا % % PageV01P4391 361(@)(@@) % غوت إذ كافحته أي انهزام % % صاحب الراية المظفرة السو % 362(@)(@@) % داء تهفو على الخميس اللهام % % صاحب الحرية التي تنفث المو % % 363(@)(@@) % ت كنفث الأفعى زعاف السمام % % لم يزل شامل المنافع للأم % 364(@)(@@) % مة طرا مأمومها والإمام % % حامل القلب واللسان إذا ما % % 365(@)(@@) % كهمت شفرة الجبان الكهام % % يغتدي من بني عطارد في السل % 366(@)(@@) % م وفي الحرب 
ms1158	 من بني بهرام % % ذو البيان المبين عن حجة الل % 367(@)(@@) % ه وليس المبين كالنمنام % % ذو اليد الثرة المقبلة الظه % 368(@)(@@) % ر وأفواه حاسديه دوامي % % باطنا راحتيه زمزم تمتا % % 369(@)(@@) % ح وظهراهما فركنا استلام % % ملك تمطر المواهب كفا % % 370(@)(@@) % ه كما انهل صيب الودق هامي % % لم يزل كل عاجل من عطا % % PageV01P4392 371(@)(@@) % ياه بشيرا بآجل مستدام % وكأن المؤملين يمتو % % 372(@)(@@) % ن إليه بأقرب الأرحام % % أمل الآملين إياه زلفى % % 373(@)(@@) % لهم عنده وحبل اعتصام % في يدي كل ذي رجاء وخوف % 374(@)(@@) % عروة منه غير ذات انفصام % % وهو كالكعبة المصلي إليها الن % % 375(@)(@@) % ناس من بني منجد وتهامي % % قبلة الآملين منتجع الرا % % 376(@)(@@) % جين مأوى الضعاف والأيتام % % معقل الخائفين عند اللتيا % % 377(@)(@@) % والتي بعدها وأزم أزام % % يتقي جوده صلول القناطي % % 378(@)(@@) % ر كما يتقى صلول اللحام % % والقناطير لا تصل ولكن % 379(@)(@@) % منعها الحق أيما استذمام % % وصلول اللحام يسقم لكن % % 380(@)(@@) % سقم البخل أبرح الأسقام % % وكذا الماء طيب ما استقوه % PageV01P4393 381(@)(@@) % آجن آسن على الإجمام % % يعذب المورد الذي يستقى من % % 382(@)(@@) % ه ولا تعذب المياه الطوامي % % يجتبي المال من مجابيه بالعد % 383(@)(@@) % ل ويعطيه غير ما ظلام % % أرخصت كفه العطيا وأغلت % 384(@)(@@) % حمد سوامها على السوام % % ليس ينفك من عطايا تباري % % 385(@)(@@) % سائرات خواطر الأفهام % % حاصلات وهن من عظم القد % 386(@)(@@) % ر كبعض المنى أو الأحلام % وعطايا كوامن في المواعي % % 387(@)(@@) % د كمون الثمار في الأكمام % % فعطاياه دانيات يد الده % % 388(@)(@@) % ر توالي كأنها في نظام % % ساعيات إلى رجال قعود % 389(@)(@@) % ساريات إلى أناس نيام % معفيات من السؤال مصفا % % 390(@)(@@) % ة ألا هكذا عطاء الكرام % % معفيات من الهوان وجوها % PageV01P4394 391(@)(@@) % عبدتها مطالبات اللئام % % أمسك السائلون عنه وكانوا % % 392(@)(@@) % قبله للملوك كالغرام % % نهنهتهم لهى له ليس تنفك % 393(@)(@@) % ك على المقترين ذات ازدحام % % ووفود السلام والشكر يغدو % % 394(@)(@@) % ن قياما إليه بعد قيام % % فوفود السوال عنه قعود % 395(@)(@@) % مقعد الحامين لا اللوام % % ساهر لا ينام عن حاجة السا % % 396(@)(@@) % هر حتى يذوق طعم المنام % % ويصون 
ms1159	 الولي بالجاه والما % % 397(@)(@@) % ل كصون الكمي نصل الحسام % % ما هما للولي إلا كغمدي % 398(@)(@@) % ن لديه كصارم صمصام % % وحقيق بذاك من أولوه % 399(@)(@@) % كالنواصي والناس كالأقدام % % ضربت تحته عروق نوام % % 400(@)(@@) % فتعالت به فروع سوامي % % نعمة الله عند من وصل الل % PageV01P4395 401(@)(@@) % ه به أخت نعمة الإسلام % % ذاك فيه الأمان من كبة النا % % 402(@)(@@) % ر وهذا جار من الأيام % % في ذراه يستبدل العز والثر % 403(@)(@@) % وة من ذلة ومن إعدام % % مستحق نعمى الإله عليه % % 404(@)(@@) % حق فضل المنعام للمنعام % إن من يرتجي سواه لكالذا % % 405(@)(@@) % هب عن ربه إلى الأصنام % % يظلم الحاسدون إذ حسدوه % 406(@)(@@) % وهو في ماله شريك الأنام % غير حساده على الشيم الغر % 407(@)(@@) % ر اللواتي سلمن من كل ذام % % فهم منصفون في ذاك لاشك % 408(@)(@@) % ك لدى المنصفين في الأحكام % % هل يعرى امرؤ من الحسد المح % 409(@)(@@) % ض على نيل أفضل الأقسام % % أنا من حاسديه لكنني لس % % 410(@)(@@) % ت بباغ نعماه غير الدوام % % حسدي أنني أريد لنفسي % % PageV01P4396 411(@)(@@) % بعض أخلاقه بغير اكتتام % % وإذا حاسد سفا من غليل % % 412(@)(@@) % فهو في وزن عاشق مستهام % لست تدري نثاه أحلى مذاقا % % 413(@)(@@) % أم سماعا من ألسن الأقوام % % رب نعمى له علي ونعمى % % 414(@)(@@) % وأياد له لدي جسام % % حط ثقل الخرج عني وقد كا % % 415(@)(@@) % ن كأركان يذبل وشمام % % وأراني الضياع مالا وقد كن % % 416(@)(@@) % ت أرى ملكها كبعض الغرام % % كف من سورة ابن بسطام عني % % 417(@)(@@) % وهي مشبوبة كحر الضرام % % وأراه بنوره حق مثلي % % 418(@)(@@) % وهو مذ كان موقظ الأفهام % % فقضى حاجتي وكان كسيف % 419(@)(@@) % هز فاهتز وهو غير كهام % % هزه ماجد يناصح في الهز % 420(@)(@@) % ز همام متوج لهمام % % ومحال ألا يقوم بما قل % PageV01P4397 421(@)(@@) % لده الأولياء كل القيام % وهو ممن تقدم الناس كالرأ % % 422(@)(@@) % س وممن علاهم كالسنام % % فجزاه الإله عني خلودا % 423(@)(@@) % ونعيما في ظل دار السلام % % بعدما يعم البقاء به الدن % 424(@)(@@) % يا صحيحا ممتعا ألف عام % ن % % PageV01P4398 البحر : - 1(@)(@@) % ذاد عن مقلتي لذيذ المنام 
ms1160	 % شغلها عنه بالدموع السجام % 2(@)(@@) % أي نوم من بعد ما حل بالبص % رة من تلكم الهنات العظام % % 3(@)(@@) % أي نوم من بعد ما انتهك الزن % ج جهارا محارم الإسلام % % 4(@)(@@) % إن هذا من الأمور لأمر % كاد أن لا يقوم في الأوهام % % 5(@)(@@) % لرأينا مستيقظين أمورا % حسبنا أن تكون رؤيا منام % % 6(@)(@@) % أقدم الخائن اللعين عليها % % وعلى الله أيما إقدام % % 7(@)(@@) % وتسمى بغير حق إماما % لا هدى الله سعيه من إمام % % 8(@)(@@) % لهف نفسي عليك أيتها البص % % رة لهفا كمثل لهب الضرام % % 9(@)(@@) % لهف نفسي عليك يا معدن الخي % % رات لهفا يعضني إبهامي % % 10(@)(@@) % لهف نفسي يا قبة الإس % % لام لهفا يطول منه غرامي % % PageV01P4399 11(@)(@@) % لهف نفسي عليك يا فرضة البل % % دان لهفا يبقى على الأعوام % % 12(@)(@@) % لهف نفسي لجمعك المتفاني % % لهف نفسي لعزك المستضام % % 13(@)(@@) % بينما أهلها بأحسن حال % إذ رماهم عبيدهم باصطلام % 14(@)(@@) % دخلوها كأنهم قطع اللي % % ل إذا راح مدلهم الظلام % % 15(@)(@@) % طلعوا بالمهندات جهرا فألقت % حملها الحاملات قبل التمام % % 16(@)(@@) % وحقيق بأن يراع أناس % غومضوا من عدوهم باقتحام % % 17(@)(@@) % أي هول رأوا بهم أي هول % حق منه تشيب رأس الغلام % % 18(@)(@@) % إذ رموهم بنارهم من يمين % وشمال وخلفهم وأمام % % 19(@)(@@) % كم أغصوا من شارب بشراب % % كم أغصوا من طاعم بطعام % % 20(@)(@@) % كم ضنين بنفسه رام منجى % % فتلقوا جبينه بالحسام % % PageV01P4400 21(@)(@@) % كم أخ قد رأى أخاه صريعا % ترب الخد بين صرعى كرام % 22(@)(@@) % كم أب قد رأى عزيز بنيه % % وهو يعلى بصارم صمصام % % 23(@)(@@) % كم مفدى في أهله أسلموه % % حين لم يحمه هنالك حامي % % 24(@)(@@) % كم رضيع هناك قد فطموه % % بشبا السيف قبل حين الفطام % % 25(@)(@@) % كم فتاة بخاتم الله بكر % % فضحوها جهر أبغير اكتتام % % 26(@)(@@) % كم فتاة مصونة قد سبوها % % بارزا وجهها بغير لثام % % 27(@)(@@) % صبحوهم فكابد القوم منهم % % طول يوم كأنه ألف عام % 28(@)(@@) % ألف ألف في ساعة قتلوهم % % ثم ساقوا السباء كالأغنام % % 29(@)(@@) % من رآهن في المساق سبايا % % داميات الوجوه للأقدام % % 30(@)(@@) % من رآهن في 