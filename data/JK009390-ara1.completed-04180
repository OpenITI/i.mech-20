ms4161	 فيقرأ فإذا سمع أبو بكر صوته من الليل قال : ما ليلك بليل سارق ، فلم يغب إلا قليلا حتى فقد آل أبي بكر رضي الله عنه حليا لهم ومتاعا ، فقال أبو بكر : طرق الحي الليلة ، فقام الأقطع فاستقبل القبلة ورفع يده الصحيحة والاخرى التي قطعت فقال : اللهم أظهر علاى من سرق أهل هاذا البيت الصالحين ، فما انتصف النهار حتى عثروا علاى المتاع عنده ، فقال أبو بكر : ويلك إنك لقليل العلم بالله ، فأمر به فقطعت رجله ، فكان أبو بكر يقول : لجرأته علاى الله أغيظ عندي من سرقته ) ( عب هق ) . )(@)(@@)(@@)(@@) $ ( 878 ) عن نافع عن ابن عمر رضي الله عنه نحوه ، إلا أنه قال :(@)(@@) | 30 ( كان إذا سمع أبو بكر رضي الله عنه صوته من الليل قال : ما ليلك بليل سارق ) ( عب ) . )(@)(@@)(@@)(@@) $ ( 879 ) عن عبد الرحمان بن القاسم عن أبيه :(@)(@@) | 30 ( أن رجلا من أهل اليمن أقطع اليد والرجل قدم علاى أبي بكر الصديق ، فشكا إليه أن عامل اليمن ظلمه ، وكان يصلي بالليل ، فيقول أبو بكر رضي الله عنه : وأبيك ما ليلك بليل سارق ، ثم إنهم فقدوا حليا لأسماء بنت عميس امرأة أبي بكر ، فجعل الرجل يطوف معهم ويقول : اللهم عليك بمن بيت أهل هاذا البيت الصالح ، فوجدوا الحلي عند صائغ ، PageV13P222 و ( زعم ) أن الأقطع جاء به ، فاعترف به الأقطع أو شهد عليه به ، فأمر به أبو بكر فقطعت يده اليسرى ، وقال أبو بكر : لدعاؤه علاى نفسه أشد عندي من سرقته ) ( مالك والشافعي هق ) . )(@)(@@)(@@)(@@) $ ( 880 ) عن الزهري قال :(@)(@@) | 30 ( أول من قطع الرجل أبو بكر رضي الله عنه ) ( ش ) . )(@)(@@)(@@)(@@) $ ( 881 ) عن الحسن :(@)(@@) | 30 ( أن أبا بكر رضي الله عنه قال في الرجل يقول للرجل : يا خبيث يا فاسق ، قد قال قولا سيئا وليس فيه عقوبة ولا حد ) ( ش ) . )(@)(@@)(@@)(@@) $ 882 عن عبد الله بن عامر بن ربيعة قال :(@)(@@) | 30 ( كان أبو بكر الصديق وعمر بن الخطاب وعثمان بن عفان رضي الله عنهم لا يجلدون العبد في القذف إلا أربعين ، ثم رأيتهم يزيدون علاى ذالك ) ( ش 
ms4162	 ) . )(@)(@@)(@@)(@@) $ ( 883 ) عن ابن جريج وابن أبي سبرة قالا :(@)(@@) | 30 ( تشاتم رجلان عند أبي بكر رضي الله عنه فلم يقل لهما شيئا ، وتشاتما عند عمر رضي الله عنه فأدبهما ) ( عب ق ) . )(@)(@@)(@@)(@@) $ ( 884 ) عن عبد الله بن عامر بن ربيعة قال :(@)(@@) | 30 ( أدركت أبا بكر وعمر وعثمان رضي الله عنهم ومن بعدهم من الخلفاء لا يضربون المملوك في القذف إلا أربعين ) ( عب وابن سعد عن سعيد ابن المسيب ) . )(@)(@@)(@@)(@@) $ ( 885 ) عن ابن جريج قال :(@)(@@) | 30 ( سمعت عطاء يقول : كان من مضى يؤتى أحدهم بالسارق فيقول : أسرقت ؟ قل : لا ، أسرقت ؟ قل : لا ، علمي أنه سمي أبو بكر وعمر ) ( عب ش ) . )(@)(@@)(@@)(@@) $ ( 886 ) عن محمد بن عبد الرحمان بن ثوبان قال :(@)(@@) | 30 ( قال أبو بكر الصديق رضي الله عنه : لو لم أجد للسارق والزاني وشارب الخمر إلا ثوبي لأحببت أن أستره عليه ) ( عب ش ) . )(@)(@@)(@@)(@@) $ ( 887 ) عن الزهري عن زبيد بن الصلت قال : قال أبو بكر الصديق رضي الله عنه :(@)(@@) | 30 ( لو وجدت رجلا علاى حد من حدود الله لم أحده أنا ، ولم أدع له أحدا حتى يكون معي غيري ) ( الخرائطي في مكارم الأخلاق ق ) . )(@)(@@) PageV13P223(@)(@@)(@@)(@@) $ ( 888 ) عن الأشياخ(@)(@@) | 30 أن المهاجر بن أبي أمية وكان أميرا علاى اليمامة رفع إليه امرأتان مغنيتان غنت إحداهما بشتم النبي فقطع يدها ونزع ثناياها ، وغنت الأخرى بهجاء المسلمين فقطع يدها ونزع ثنيتها ، فكتب إليه أبو بكر رضي الله عنه : ( بلغني التي فعلت بالمرأة التي تغنت بشتم النبي ، فلولا ما سبقتني فيها لأمرتك بقتلها ، لأن حد الأنبياء ليس يشبه الحدود ، فمن تعاطى ذالك من مسلم فهو مرتد ، أو معاهد فهو محارب غادر ، وأما التي تغنت بهجاء المسلمين فإن كانت ممن يدعي الإسلام فأدب دون المثلة ، وإن كانت ذمية فلعمري لما صفحت عنه من الشرك لأعظم ، ولو كنت تقدمت إليك في مثل هاذا لبلغت مكروها ، وإياك والمثلة في الناس ، فإنها مأثم ومنفرة إلا في القصاص ) ( سيف في الفتوح ) . )(@)(@@)(@@)(@@) $ ( 889 ) عن عمرو بن شعيب عن أبيه عن جده :(@)(@@) | 30 ( أن أبا بكر وعمر رضي 
ms4163	 الله عنه كانا لا يقتلان الحر بالعبد ) ( ش ، قط ، ق ) . )(@)(@@)(@@)(@@) $ ( 890 ) عن طارق بن شهاب قال :(@)(@@) | 30 ( لطم أبو بكر رضي الله عنه يوما رجلا لطمة ثم قال له : اقتص ، فعفا الرجل ) ( ش ) . )(@)(@@)(@@)(@@) $ ( 891 ) عن الحسن :(@)(@@) | 30 ( أن أبا بكر وعمر رضي الله عنهم والجماعة الأولاى لم يكونوا يقتلون بالقسامة ) ( ش ) . )(@)(@@)(@@)(@@) $ ( 892 ) عن أبي سعيد الخدري رضي الله عنه :(@)(@@) | 30 ( أن أبا بكر وعمر رضي الله عنهم قالا : من قتله حد فلا عقل له ) ( ش ) . )(@)(@@)(@@)(@@) $ ( 893 ) عن عمرو بن شعيب :(@)(@@) | 30 ( أن أبا بكر وعمر رضي الله عنهما كانا يقولان : لا يقتل المولاى بعبده ولاكن يضرب ويطال حبسه ويحرم سهمه ) ( ش ، ق ) . )(@)(@@)(@@)(@@) $ ( 894 ) عن علي بن ماجدة قال :(@)(@@) | 30 ( قاتلت غلاما فجدعت أنفه فأتي بي إلاى أبي بكر رضي الله عنه فقاسني فلم يجد في قصاصا فجعل علاى عاقلتي الدية ) ( ش ) . )(@)(@@) PageV13P224(@)(@@)(@@)(@@) $ ( 895 ) عن عكرمة :(@)(@@) | 30 ( أن أبا بكر رضي الله عنهما جعل في حلمة ثدي المرأة مائة دينار ، وجعل في حلمة الرجل خمسين دينارا ) ( عب ، ش ) . )(@)(@@)(@@)(@@) $ ( 896 ) عن عمرو بن شعيب قال :(@)(@@) | 30 ( قد كان مما وضع أبو بكر وعمر رضي الله عنهما من القضية أن الرجل إذا بسطها صاحبها فلم يقبضها ، أو قبضها فلم يبسطها ، أو قلصت عن الأرض فلم تبلغها فقد تم عقلها فما نقص فبحساب ، وكان فيما وضع أبو بكر وعمر رضي الله عنهما من القضية في جراحة اليد إذا لم يأكل بها صاحبها ولم يأتزر بها ولم يستطب بها فقد تم عقلها فما نقص فبحساب ) ( ش ، عب ) . )(@)(@@)(@@)(@@) $ ( 897 ) عن عمرو بن شعيب عن أبيه عن جده :(@)(@@) | 30 ( أن أبا بكر وعمر رضي الله عنه قالا : الموضحة في الرأس والوجه سواء ) ( ش ، ق ) . )(@)(@@)(@@)(@@) $ ( 898 ) عن ابن شهاب :(@)(@@) | 30 ( أن أبا بكر الصديق وعمر بن الخطاب وعثمان بن عفان رضي الله عنهم أعطوا القود من أنفسهم فلم يستقد منهم وهم سلاطين ) ( ق ) . )(@)(@@)(@@)(@@) $ ( 899 ) عن ماجدة قال :(@)(@@) | 30 ( عارضت غلاما بمكة فعض أذني فقطع منها ، أو عضضت أذنه فقطعت 
ms4164	 منها ، فلما قدم علينا أبو بكر رضي الله عنه حاجا رفعنا إليه فقال : انطلقوا بهما إلاى عمر فإن كان الجارح بلغ أن يقتص منه فليقتص ، فلما انتهى بنا إلاى عمر نظر إلينا فقال : نعم ، قد بلغ هاذا أن يقتص منه ، ادعوا لي حجاما ) ( حم . )(@)(@@)(@@)(@@) $ ( 900 ) عن قيس بن أبي حازم قال :(@)(@@) | 30 ( دخلت علاى أبي بكر الصديق رضي الله عنه مع أبي فقال : من هاذا ؟ فقال : ابني ، فقال : أما إنه لا يجني عليك ولا تجني عليه ) ( كر ) . )(@)(@@)(@@)(@@) $ ( 901 ) عن عمرو بن شعيب عن أبيه عن جده قال :(@)(@@) | 30 ( كان أبو بكر وعمر رضي الله عنهما لا يقتلان الرجل بعبده ، كانا يضربانه مائة ، ويسجنانه سنة ، ويحرمانه سهمه مع المسلمين سنة إذا قتله متعمدا ) ( عب ) . )(@)(@@)(@@)(@@) $ ( 902 ) عن ابن أبي مليكة :(@)(@@) | 30 ( أن رجلا عض يد رجل فأندر ثنيته ، فأهدرها أبو بكر رضي الله عنه ) ( عب ، ش ، خ ، د ، ق ) . )(@)(@@) PageV13P225(@)(@@)(@@)(@@) $ ( 903 ) عن ابن جرير :(@)(@@) | 30 ( أن أبا بكر وعمر رضي الله عنهما أبطلاها ) ( ش ) . )(@)(@@)(@@)(@@) $ ( 904 ) عن جعفر بن محمد عن أبيه قال :(@)(@@) | 30 ( أمر أبو بكر رضي الله عنه بقتل الكلاب ولعبد الله بن جعفر كلب تحت سرير أبي بكر فقال : يا أبت كلبي ، فقال : لا تقتلوا كلب ابني ، ثم أمر به فأخذ ، وكان أبو بكر قد خلف علاى أمه أسماء بنت عميس بعد جعفر ) ( ابن سعد ، ش ) . )(@)(@@)(@@)(@@) $ ( 905 ) عن أبي بكر رضي الله عنه قال :(@)(@@) | 30 ( من كان عقله في البقر فكل بعير ببقرتين ، ومن كان عقله في الشاء فكل بعير بعشرين شاة ) ( عب ، ش ) . )(@)(@@)(@@)(@@) $ ( 906 ) عن عكرمة رضي الله عنه قال :(@)(@@) | 30 ( قضى أبو بكر رضي الله عنه مكان كل بعير ببقرتين ) ( عب ) . )(@)(@@)(@@)(@@) $ ( 907 ) عن عمرو بن شعيب قال :(@)(@@) | 30 ( قضى أبو بكر رضي الله عنه في الحاجب إذا أصيب حتى يذهب شعره فقضى فيه بموضحتين عشر من الإبل ) ( عب ، ش ، ق ) . )(@)(@@)(@@)(@@) $ ( 908 ) عن عكرمة وطاوس :(@)(@@) | 30 ( أن أبا بكر رضي الله عنه قضى في الاذن بخمس عشرة من الابل وقال 
ms4165	 : إنما هو شين ، لا يضر سمعا ولا ينقص قوة ، ويغشاها الشعر والعمامة ) ( عب ، ش ، ق ) . )(@)(@@)(@@)(@@) $ ( 909 ) عن عمرو بن شعيب قال :(@)(@@) | 30 ( قضى أبو بكر رضي الله عنه في الشفتين بالدية مائة من الإبل ، وقضى في اللسان إذا قطع بالدية إذا نزع من أصله ، وإن قطعت أسلته فتكلم صاحبه ففيه نصف الدية ، وقضى في ثدي الرجل إذا ذهبت حلمته بخمس من الإبل ، وقضى في ثدي المرأة بعشر من الإبل إذا لم يصب إلا حلمة ثديها ، فإذا قطع من أصله فخمس عشرة ، وقضى في صلب الرجل إذا كسر ثم جبر بالدية كاملة إذا كان لا يحمل له ، وبنصف الدية إذا كان يحمل له ، وقضى في ذكر الرجل بديته مائة من الإبل ) ( عب ، ش ، ق ) . )(@)(@@)(@@)(@@) $ ( 910 ) عن أبي بكر رضي الله عنه قال :(@)(@@) | 30 ( إذا نفذت الجائفة فهي جائفتان ) ( عب ) . )(@)(@@) PageV13P226(@)(@@)(@@)(@@) $ ( 911 ) عن ابن المسيب :(@)(@@) | 30 ( أن أبا بكر رضي الله عنه قضى في الجائفة التي نفذت بثلثي الدية إذا نفذت الخصيتين كلتيهما وبرأ صاحبهما ) ( عب ، ش ، ض ، ق ) . )(@)(@@)(@@)(@@) $ ( 912 ) عن ابن جريج قال :(@)(@@) | 30 ( أخبرني إسماعيل بن مسلم أن أبا بكر الصديق رضي الله عنه قال في الخيانة : لا قطع فيها ) ( عب ) . )(@)(@@)(@@)(@@) $ ( 913 ) عن الزهري عن أبي بكر وعمر وعثمان رضي الله عنهم أنهم قالوا :(@)(@@) | 30 ( دية اليهودي والنصراني مثل دية الحر المسلم ) ( ابن خسرو في مسند أبي حنيفة ) . )(@)(@@)(@@)(@@) $ ( 914 ) عن علي بن ماجد قال :(@)(@@) | 30 ( قاتلت غلاما فجدعت أنفه ، فرفعت إلاى أبي بكر الصديق رضي الله عنه ، فنظر فلم أبلغ القصاص ، فقضى علاى عاقلتي بالدية ) ( ابن جرير ) . )(@)(@@)(@@)(@@) $ ( 915 ) عن المهاجر بن أبي أمية قال :(@)(@@) | 30 ( كتب إلي أبو بكر الصديق رضي الله عنه أن : ابعث إلي قيس بن مكشوج في وثاق ، فأحلفه خمسين يمينا عند منبر النبي ما قتل ذاذويه ) ( الشافعي ، ق ) . )(@)(@@)(@@)(@@) $ ( 916 ) عن أبي الضحى قال :(@)(@@) | 30 ( استشهد أبو بكر معدي كرب وقال : أما أنك أول من استشهدته في الإسلام ) ( ابن سعد ) . )(@)(@@)(@@)(@@) $ ( 917 ) عن علي رضي الله عنه قال :(@)(@@) | 30 
ms4166	 ( سمعت أبا بكر رضي الله عنه يقول : سمعت رسول الله يقول : ( ما من عبد أذنب ذنبا ، فقام فتوضأ ، فأحسن الوضوء ، ثم قام فصلى واستغفر من ذنبه إلا كان حقا علاى الله أن يغفر له ، لأن الله تعالاى يقول : { ومن يعمل سوءا أو يظلم نفسه ثم يستغفر الله يجد الله غفورا رحيما } ( ابن أبي حاتم وابن مردويه وابن السني في عمل يوم وليلة ) . )(@)(@@) PageV13P227(@)(@@)(@@)(@@) $ ( 918 ) عن أبي بكر رضي الله عنه قال :(@)(@@) | 30 ( جاء اليهود إلاى النبي فقالوا : يا محمد أخبرنا ما خلق الله من الخلق في هاذه الأيام الستة ، فقال : خلق الله الأرض يوم الأحد والاثنين ، وخلق الجبال يوم الثلاثاء ، وخلق المدائن والأقوات والأنهار وعمرانها وخرابها يوم الأربعاء ، وخلق السماوات والملائكة يوم الخميس إلاى ثلاث ساعات يعني من يوم الجمعة ، وخلق في أول ثلاث ساعات : الآجال ، وفي الثانية الالفة علاى كل شيء مما ينتفع به الناس ، وفي الثالثة ، آدم ، قالوا : صدقت إن تممت فعرف النبي ما يريدون فغضب ، فأنزل الله : { وما مسنا من لغوب فاصبر علاى ما يقولون } ( ابن جرير في التفسير ) . )(@)(@@)(@@)(@@) $ ( 919 ) عن ابن أبي مليكة رضي الله عنه قال :(@)(@@) | 30 ( كان ربما سقط الخطام من يد أبي بكر رضي الله عنه فيضرب بذراع ناقته فينيخها فيأخذه قال : فقالوا أفلا أمرتنا نناولكه ؟ قال : إن حبيبي رسول الله أمرني أن لا أسأل الناس شيئا ) ( حم قال الحافظ ابن حجر في الأطراف : هاذا منقطع ) . )(@)(@@)(@@)(@@) $ ( 920 ) عن عبد الرحمان بن القاسم عن أبيه :(@)(@@) | 30 ( أن أبا بكر رضي الله عنه مر بعبد الرحمان بن أبي بكر وهو يماظ جارا له ، فقال : لا تماظ جارك فإن هاذا يبقى ويذهب الناس ) ( ابن المبارك وأبو عبيد في الغريب والخرائطي في مكارم الأخلاق ، هب ) . )(@)(@@)(@@)(@@) $ ( 921 ) عن أبي بكر رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : لا يدخل الجنة سيء الملكة ، فقال رجل : يا رسول الله أليس أخبرتنا أن هاذه الأمة أكثر الأمم مملوكين وأيتاما ؟ قال : بلاى ، فأكرموهم كرامة أولادكم ، وأطعموهم مما تأكلون ، واكسوهم مما تلبسون ، قال 
ms4167	 : فرس صالح تقاتل عليه في سبيل الله ، ومملوك يكفيك فإذا صلى فهو أخوك ) ( ش ، حم ، ه ، ع ، حل والخرائطي في مكارم الأخلاق وهو ضعيف ) . )(@)(@@) PageV13P228(@)(@@)(@@)(@@) $ ( 922 ) عن عمر رضي الله عنه قال :(@)(@@) | 30 ( كنت رديف أبي بكر رضي الله عنه فيمر علاى القوم فيقول : السلام عليكم ، فيقولون : السلام عليكم ورحمة الله وبركاته ، فقال أبو بكر : فضلنا الناس اليوم بزيادة كثيرة ) ( خ في الأدب ) . )(@)(@@)(@@)(@@) $ ( 923 ) عن ابن عمر رضي الله عنه أن الأغر وهو الأغر وهو رجل من مزينة قال :(@)(@@) | 30 ( كانت له أوسق من التمر علاى رجل من بني عمرو بن عوف فاختلف إليه مرارا ، قال : فجئت النبي فأرسل معي أبا بكر الصديق رضي الله عنه قال : فكل من لقينا سلموا علينا ، فقال أبو بكر : ألا ترى الناس يبدؤونك بالسلام فيكون لهم الأجر ابدأهم بالسلام يكن لك الأجر ) ( خ في الأدب وابن جرير وأبو نعيم في المعرفة والخرائطي في مكارم الأخلاق ) . )(@)(@@)(@@)(@@) $ ( 924 ) عن ميمون بن مهران قال :(@)(@@) | 30 ( جاء رجل إلاى أبي بكر رضي الله عنهما فقال : السلام عليك يا خليفة رسول الله ، قال من بين هاؤلاء أجمعين ؟ ) ( حم في الزهد ، خط في الجامع ، ورواه خيثمة الأطرابلسي في فضائل الصحابة بلفظ : من بين هاؤلاء أجمعين ؟ ) ( حم في الزهد ، خط في الجامع ، ورواه خيثمة الأطرابلسي في فضائل الصحابة بلفظ : من بين هاؤلاء أجمعين سلمت علي ) . )(@)(@@)(@@)(@@) $ ( 925 ) عن زهرة بن خميصة قال :(@)(@@) | 30 ( ردفت أبا بكر رضي الله عنه فكنا نمر بالقوم فنسلم عليهم فيردون علينا أكثر مما نسلم ، فقال أبو بكر : ما زال الناس غالبين لنا منذ اليوم ، وفي لفظ : فضلنا الناس اليوم بخير كثير ) ( ش ) . )(@)(@@)(@@)(@@) $ ( 926 ) عن سعيد بن أبي الحسين :(@)(@@) | 30 ( أن أبا بكر رضي الله عنه دعي إلاى شهادة فقام له رجل عن مجلسه فقال : إن رسول الله نهانا إذا قام الرجل من مجلسه أن نقعد فيه ، وأن يمسح الرجل بثوب من لا يملك ) ( أبو عبيد الله البزري في حديثه وأخشى أن يكون تصحف بأبي بكر فإن الحديث معروف 
ms4168	 من روايته . )(@)(@@)(@@)(@@) $ ( 927 ) عن عبد الرحمان بن القاسم عن أبيه قال :(@)(@@) | 30 ( قدم علاى أبي بكر رضي الله عنه وفد من ثقيف فأتي بطعام فدنا القوم وتنحى رجل به هاذا الداء يعني الجذام فقال له أبو بكر : ادنه فدنا ، قال : كل فأكل ، وجعل أبو بكر يضع يده موضع يده PageV13P229 فيأكل مما يأكل منه المجذوم ) ( ش وابن جرير ) . )(@)(@@)(@@)(@@) $ ( 928 ) عن عمرة بنت عبد الرحمان :(@)(@@) | 30 ( أن أبا بكر الصديق رضي الله عنه دخل علاى عائشة وهي تشتكي ويهودية ترقيها فقال أبو بكر : ارقيها بكتاب الله عز وجل ) ( مالك ، ش وابن جرير والخرائطي في مكارم الاءخلاق ، ق ) . )(@)(@@)(@@)(@@) $ ( 929 ) عن عمرة :(@)(@@) | 30 ( أن عائشة رضي الله عنها كانت ترقيها يهودية فدخل عليها أبو بكر رضي الله عنه وكان يكره الرقي فقال : أرقيها بكتاب الله عز وجل ) ( ابن جرير ) . )(@)(@@)(@@)(@@) $ ( 930 ) عن عائشة رضي الله عنها قالت :(@)(@@) | 30 ( كان لأبي غلام يخرج له الخراج وكان أبي يأكل من خراجه ، فجاء يوما بشيء فأكل منه أبو بكر ، فقال الغلام : أتدري ما هاذا ؟ فقال أبو بكر : ما هو ؟ قال : كنت تكهنت لإنسان في الجاهلية وما أحسن الكهانة إلا أني خدعته فلقيني فأعطاني بذالك فهاذا الذي أكلت منه فأدخل أبو بكر يده فقاء كل شيء في بطنه ) ( خ ، هق ) . )(@)(@@)(@@)(@@) $ 931 عن عبد الله بن عمرو رضي الله عنه قال :(@)(@@) | 30 ( يكون علاى هاذه الأمة اثنتا عشرة خليفة : أبو بكر الصديق ، أصبتم اسمه ، عمر الفاروق ، قرن من حديد ، أصبتم اسمه ، عثمان بن عفان ذو النورين ، قتل مظلوما ، أوتي كفلين من الرحمة ، ملك الأرض المقدسة معاوية وابنه ، ثم يكون السفاح ومنصور وجابر والأمين وسلام وأمير العصب لا يرى مثله ولا يدرى مثله ، كلهم من بني كعب بن لؤي فيهم رجل من قحطان ، منهم من لا يكون إلا يومين ، منهم من يقال له : لتبايعنا أو لنقتلنك ، فإن لم يبايعهم قتلوه ) ( نعيم ) . )(@)(@@)(@@)(@@) $ ( 932 ) عن مرداس قال : قال أبو بكر رضي الله عنه :(@)(@@) | 30 ( يقبض الصالحون الأول فالأول حتى يبقى من الناس حثالة 
ms4169	 كحثالة التمر أو الشعير لا يبالي الله بهم ) ( حم في الزهد ) . )(@)(@@)(@@)(@@) $ ( 933 ) عن يزيد بن السمط عن محمد بن عبد الله التميمي عن أبي بكر الصديق رضي الله عنه عن رسول الله قال :(@)(@@) | 30 ( ستغربلون حتى تصيروا في حثالة PageV13P230 في قوم قد مرجت عهودهم ، وخربت أماناتهم ، قالوا : كيف بنا يا رسول الله قال : تعملون ما تعرفون وتتركون ما تنكرون ، وتقولون : أحد أحد ، انصرنا ممن ظلمنا واكفنا من بغاى علينا ) ( أبو الشيخ في الفتن ، ويزيد بن السمط ضعيف ) . )(@)(@@)(@@)(@@) $ ( 934 ) عن مجاهد أن ابن عمر رضي الله عنه مر علاى ابن الزبير فقال :(@)(@@) | 30 ( رحمك الله إن كنت ما علمت لصواما قواما وصالا للرحم ، أما والله إني لأرجو مع مساوىء ما قد عملت من الذنوب أن لا يعذبك الله بها . قال مجاهد : ثم التفت إلي فقال : حدثني أبو بكر الصديق رضي الله عنه أن رسول الله قال : من يعمل سوءا يجز به في الدنيا ) ( كر ) . )(@)(@@)(@@)(@@) $ ( 935 ) عن أبي بكر الصديق رضي الله عنه قال : قال رسول الله :(@)(@@) | 30 ( طوبى لمن مات في النأنأة ، قيل : وما النأنأة ؟ قال : حدة الاسلام وبدؤها ) ( قال الديلمي في مسند الفردوس : رواه ابن ماجه حدثنا علي بن محمد والحسين بن إسحاق قالا : حدثنا وكيع عن إسماعيل بن أبي خالد عن طارق بن شهاب عن أبي بكر انتهى . وليس في النسخ الموجودة الآن من سنن ابن ماجه ولا ذكره أصحاب الأطراف ، فلعله في بعض الروايات التي لم تصل إلاى هاذه البلاد أو في غير السنن من تصانيف ابن ماجه كالتفسير وغيره ) . )(@)(@@)(@@)(@@) $ ( 936 ) عن الزبير بن الخريت عن أبي لبيد قال :(@)(@@) | 30 ( خرج رجل من طاحية مهاجرا يقال له : بيرح بن أسد فقدم المدينة بعد وفاة رسول الله بأيام ، فرآه عمر بن الخطاب رضي الله عنه فعلم أنه غريب فقال له : من أين أنت ؟ قال : من أهل عمان ، قال : من أهل عمان ؟ قال : نعم ، فأخذ بيده فأدخله علاى أبي بكر رضي الله عنه فقال : هاذا من الأرض التي سمعت رسول 
ms4170	 الله يقول : إني لأعلم أرضا يقال لها عمان ينضح بناحيتها البحر ، بها حي من العرب ، لو أتاهم رسولي ما رموه بسهم ولا حجر ) ( حم وأبو نعيم وقال حم : إنما هو : سمعت يعني أبا بكر ، وقال يزيد بن هارون : سمعت بالرفع ، يعني عمر ، قال ابن كثير : رواية النصب وجعله في مسند الصديق أولاى ، فإن الإمام علي بن المديني رواه في مسند الصديق ثم قال : PageV13P231 هاذا إسناد منقطع من ناحية أبي بيد واسمه لمازة بن زبار الجهضمي فإنه لم يلق أبا بكر ولا عمر وإنما له رؤية لعلي وإنما يحدث عن كعب بن سور وضربه من الرجال ، قال ابن كثير : وهو من الثقات : ورواه ع أيضا في مسند الصديق رضي الله عنه ) . )(@)(@@)(@@)(@@) $ ( 937 ) عن سعيد بن المسيب قال : قال أبو بكر رضي الله عنه :(@)(@@) | 30 ( هل بالعراق أرض يقال لها خراسان ؟ قالوا : نعم ، قال : فإن الدجال يخرج منها ) ( ش ) . )(@)(@@)(@@)(@@) $ ( 938 ) عن أبي بكر الصديق رضي الله عنه قال :(@)(@@) | 30 ( يخرج الدجال من مرو من يهوديتها ) ( نعيم بن حماد دي الفتن ) . )(@)(@@)(@@)(@@) $ ( 939 ) عن عكرمة عن أبي بكر الصديق رضي الله عنه قال :(@)(@@) | 30 ( يخرج الدجال من قبل المشرق من أرض يقال لها خراسان ) ( نعيم ) . )(@)(@@)(@@)(@@) $ ( 940 ) عن أبي هنيدة البراء بن نوفل عن والان العدوي عن حذيفة عن أبي بكر رضي الله عنه قال :(@)(@@) | 30 ( أصبح رسول الله ذات يوم فصلى الغداة ثم جلس ، حتى إذا كان من الضحى ضحك ثم جلس مكانه حتى صلى الأولاى والعصر والمغرب كل ذالك لا يتكلم حتى صلى العشاء الآخرة ثم قام إلاى أهله ، فقال الناس لأبي بكر : ألا تسأل رسول الله ما شأنه صنع اليوم شيئا لم يصنعه قط ؟ فسأله فقال : نعم ، عرض علي ما هو كائن من أمر الدنيا وأمر الآخرة ، يجمع الأولون والآخرون بصعيد واحد ففزع الناس بذالك حتى انطلقوا إلاى آدم والعرق يكاد يلجمهم ، فقالوا : يا آدم أنت أبو البشر ، وأنت اصطفاك الله ، اشفع لنا إلاى ربك قال : لقد لقيت مثل الذي لقيتم فانطلقوا 
ms4171	 إلاى أبيكم بعد أبيكم إلاى نوح { إن الله اصطفى آدم ونوحا وآل إبراهيم وآل عمران علاى العالمين } فينطلقون إلاى نوح فيقولون : اشفع لنا إلاى ربك فأنت اصطفاك الله واستجاب لك دعاءك ولم يدع علاى الأرض من الكافرين ديارا ، فيقول : ليس ذاكم عندي ، انطلقوا إلاى إبراهيم فإن الله اتخذه خليلا فينطلقون إلاى إبراهيم فيقول : ليس ذاكم عندي ولاكن انطلقوا إلاى موسى فإن الله كلمه تكليما ، فيقول موسى : ليس ذاكم عندي ولاكن انطلقوا إلاى عيسى بن مريم ، PageV13P232 فإنه يبرىء الأكمه والأبرص ويحيي الموتى ، فيقول عيسى : ليس ذاكم عندي ولاكن انطلقوا إلاى سيد ولد آدم ، فإنه أول من تنشق الأرض عنه يوم القيامة ، انطلقوا إلاى محمد فيشفع لكم إلاى ربكم ، فينطلق ، فيأتي جبريل ربه عز وجل فيقول الله تعالاى : ائذن له وبشره بالجنة فينطلق به جبريل فيخر ساجدا قدر جمعة ، ويقول الله تعالاى : ارفع رأسك وقل تسمع ، واشفع تشفع ، فيرفع رأسه ، فإذا نظر إلاى ربه خر ساجدا قدر جمعة أخرى ، فيقول الله تعالاى له : ارفع رأسك وقل تسمع ، واشفع تشفع فيذهب ليقع ساجدا ، فيأخذ جبريل بضبعيه فيفتح الله عليه من الدعاء شيئا لم يفتحه علاى بشر قط ، فيقول : أي رب خلقتني سيد ولد آدم ولا فخر وأول من تنشق عنه الأرض يوم القيامة ولا فخر ، حتى أنه ليرد علاى الحوض أكثر مما بين صنعاء وأيلة ، ثم يقال : ادعوا الصديقين ، فيشفعون ، ثم يقال : ادعوا الأنبياء ، فيجيء النبي ومعه العصابة ، والنبي ومعه الخمسة والستة ، والنبي وليس معه أحد ، ثم يقال : ادعوا الشهداء ، فيشفعون لمن أرادوا ، فإذا فعلت الشهداء ذالك ، يقول الله : أنا أرحم الراحمين أدخلوا جنتي من كان لا يشرك بي شيئا فيدخلون الجنة ، ثم يقول الله عز وجل : انظروا في النار هل تلقون من أحد عمل خيرا قط ؟ فيجدون في النار رجلا ، فيقول له : هل عملت خيرا قط ؟ فيقول : لا ، غير أني كنت أسامح الناس في البيع ، فيقول الله : أسمحوا لعبدي كإسماحه إلاى عبيدي ثم يخرجون من النار رجلا ، فيقول له : هل عملت خيرا 
ms4172	 قط ؟ فيقول : لا ، غير أني قد أمرت ولدي : إذا مت فأحرقوني بالنار ثم اطحنوني حتى إذا كنت مثل الكحل فاذهبوا بي إلاى البحر فاذروني في الريح ، فوالله لا يقدر علي رب العالمين أبدا فقال الله : لم فعلت ذالك ؟ قال : من مخافتك ، فيقول الله تعالاى : انظر إلاى ملك أعظم ملك فإن لك مثله وشرة أمثاله فيقول : لم تستخر بي وأنت الملك وذالك الذي ضحكت منه من الضحى ) ( حم ، وإن المديني في كتابه تعليل الأحاديث المسندة والدارمي ، وابن راهويه ، والحارث ، والبزار وقال : تفرد به البراء بن نوفل عن والان ولا نعلمهما رويا إلا هاذا الحديث ، وابن أبي عاصم في السنة ، ع ، والشاشي ، وأبو عوانة ، وابن خزيمة وقال في أوله : إن صح الخبر ، ثم قال في آخره : إنما استثنيت PageV13P233 صحة الخبر في الباب لأني في الوقت الذي ترجمت الباب لم أكن أحفظ عن والان خبرا غير هاذا ولا راويا غير البراء ، ثم وجدت له خبرا ثانيا وراويا آخر قد روى عنه مالك ابن عمر الحنفي ، حب ، قط في العلل وقال : والان مجهول والحديث غير ثابت ، والاءصبهاني في الحجة ، ض ) . )(@)(@@)(@@)(@@) $ ( 941 ) عن أبي بكر الصديق رضي الله عنه قال :(@)(@@) | 30 ( ضرس الكافر مثل أحد وجلده أربعون ذراعا ) ( هناد ) . )(@)(@@)(@@)(@@) $ ( 942 ) عن أبي بكر رضي الله عنه قال :(@)(@@) | 30 ( أفضل ما يرى لي : رجل أسبغ وضوءه ، رؤيا صالحة أحب إلي من كذا وكذا ) ( الحكيم ) . )(@)(@@)(@@)(@@) $ ( 943 ) عن أبي قلابة أن رجلا أتى أبا بكر رضي الله عنه فقال :(@)(@@) | 30 ( إني رأيت في النوم كأني أبول دما فقال : أراك تأتي امرأتك وهي حائض ، قال : نعم ، قال : فاتق الله ولا تعد ) ( عب ، ش والدارمي ) . )(@)(@@)(@@)(@@) $ ( 944 ) عن الشعبي قال :(@)(@@) | 30 ( أتى رجل أبا بكر رضي الله عنه فقال : إني رأيت في المنام كأني أجري ثعلبا ، قال : أجريت ما لا يجري أنت رجل كذوب ، فاتق الله ولا تعد ) ( ش وأبو بكر في الغيلانيات ) . )(@)(@@)(@@)(@@) $ ( 945 ) عن سعيد بن المسيب قال :(@)(@@) | 30 ( رأت عائشة رضي الله عنها كأنه وقع في بيتها ثلاثة أقمار 
ms4173	 ، فقصصتها علاى أبي بكر رضي الله عنه وكان من أعبر الناس ، فقال : إن صدقت رؤياك ليدفنن في بيتك خير أهل الأرض ثلاثا ، فلما قبض النبي قال : يا عائشة هاذا خير أقمارك ) ( الحميدي ، ض ، ك ) . )(@)(@@)(@@)(@@) $ ( 946 ) عن محمد بن سيرين قال :(@)(@@) | 30 ( كان أعبر هاذه الأمة بعد نبيها أبو بكر رضي الله عنه ) ( ابن سعد ومسدد ) . )(@)(@@)(@@)(@@) $ ( 947 ) عن صالح بن كيسان قال : قال محرز بن نضلة :(@)(@@) | 30 ( رأيت سماء الدنيا أفرجت لي حتى دخلتها حتى انتهيت إلاى السماء السابعة ثم انتهيت إلاى سدرة المنتهى ، فقيل لي : هاذا منزلك ، فعرضتها علاى أبي بكر الصديق رضي الله عنه وكان أعبر الناس ، فقال : أبشر بالشهادة فقتل بعد ذالك بيوم خرج مع PageV13P234 رسول الله إلاى غزوة الغابة يوم السرح وهي غزوة ذي قرد سنة ست ، فقتله سعدة بن حكمة ) ( ابن سعد ) . )(@)(@@)(@@)(@@) $ ( 948 ) عن الحسن أن سمرة بن جندب(@)(@@) | 30 قال لأبي بكر الصديق رضي الله عنهم : ( إني رأيت في المنام كأني أفتل شريطا ثم أضعه إلاى جنبي ونفر خلفي يأكله ، فقال أبو بكر : إن صدقت رؤياك تزوجت امرأة ذات ولد ، يأكلون كسبك . قال : ورأيت كأن نورا خرج من حجر ثم ذهب يعود فيه فلم يستطع ، قال : تلك الكلمة العظيمة تخرج من الرجل ثم لا تعود فيه . قال : ورأيت كأنه قيل : خرج الدجال ، فجعلت أفتح جدارا ثم ألتفت خلفي فإذا هو قريب مني ، فانفرجت لي الأرض فدخلتها قال أبو بكر رضي الله عنه : إن صدقت رؤياك أصبت قحما في دينك ) ( أبو بكر في الغيلانيات ، ص ) . )(@)(@@)(@@)(@@) $ ( 949 ) عن عائشة قالت : قال أبو بكر رضي الله عنه :(@)(@@) | 30 ( يا رسول الله إني رأيت في المنام كأني أطأ في عذرة ، وأن في صدري خالين أو شامتين ، وعلي رداء حبرة ، فقال : لئن صدقت رؤياك لتلين أمر الناس ، ولتلين سنتين ) ( الديلمي ) . )(@)(@@)(@@)(@@) $ ( 950 ) عن عائشة رضي الله عنها قالت :(@)(@@) | 30 ( قال رسول الله : يا أبا بكر إني رأيت أتي آكل حيسا فعرضت لي نواة في حلقي فتبسم رسول الله ، فقال : هو ما 
ms4174	 تعلم يا رسول الله فقال : عبرها أنت ، فقال : تخان في غنيمتك ) ( الديلمي ) . )(@)(@@)(@@)(@@) $ ( 951 ) عن الشعبي قال :(@)(@@) | 30 قالت عائشة لأبي بكر رضي الله عنهما : ( إني رأيت بقرا تنحر حولي ، قال : إن صدقت رؤياك قتلت حولك فئة ) ( ش ونعيم بن حماد في الفتن وابن أبي الدنيا في كتاب الأشراف ) . )(@)(@@)(@@)(@@) $ ( 952 ) عن عمرو بن دينار قال :(@)(@@) | 30 ( خطب أبو بكر رضي الله عنه فقال : أوصيكم بالله لفقركم وفاقتكم أن تتقوه وأن تثنوا عليه بما هو أهله ، وأن تستغفروه إنه كان PageV13P235 غفارا ، واعلموا أنكم ما أخلصتم لله فربكم أطعتم ، وحقه وحقكم حفظتم ، فأعطوا ضرائبكم في أيام سلفكم واجعلوها نوافل بين أيديكم حتى تستوفوا سلفكم وضرائبكم حين فقركم وحاجتكم ، ثم تفكروا عباد الله فيمن قبلكم أين كانوا أمس وأين هم اليوم أين الملوك الذين كانوا أثاروا الأرض وعمروها قد نسوا ونسي ذكرهم فهم اليوم كلا شيء ، فتلك بيوتهم خاوية وهم في ظلمات القبور : { هل تحس منهم من أحد أو تسمع لهم ركزا } وأين من تعرفون من أصحابكم وإخوانكم قد وردوا علاى ما قدموا ، فجعلوا الشقاوة والسعادة ، إن الله عز وجل ليس بينه وبين أحد من خلقه نسب يعطيه به خيرا ، ولا يصرف عنه سوءا إلا بطاعته واتباع أمره ، وإنه لا خير بخير بعده النار ، ولا شر بشر بعده الجنة أقول قولي هاذا وأستغفر الله لي ولكم ) ( حل ) . )(@)(@@)(@@)(@@) $ ( 953 ) عن أنس رضي الله عنه قال :(@)(@@) | 30 ( كان أبو بكر رضي الله عنه يخطبنا فيذكر بدء خلق الإنسان فيقول : خلقع من مجرى البول مرتين فيذكر حتى يتقذر أحدنا نفسه ) ( ش ) . )(@)(@@)(@@)(@@) $ ( 954 ) عن نعيم بن قحمة قال :(@)(@@) | 30 كان في خطبة أبي بكر الصديق رضي الله عنه : ( أما تعلمون أنكم تغدون وتروحون لأجل معلوم ، فمن استطاع أن ينقضي الأجل وهو في عمل الله فليفعل ، ولن تنالوا ذالك إلا بالله ، إن أقواما جعلوا آجالهم لغيرهم ، فنهاكم الله أن تكونوا أمثالهم : { ولا تكونوا كالذين نسوا الله فأنساهم أنفسهم } ، أين من تعرفون من إخوانكم قدموا علاى ما قدموا في أيام 
ms4175	 سلفهم وحلوا فيه بالشقوة والسعادة . أين الجبارون الأولون الذين بنوا المدائن وحففوها بالحوائط قد صاروا تحت الصخر والآثار ، هاذا كتاب الله لا تفنى عجائبه ، فاستضيئوا منه ليوم ظلمة ، وانتصحوا بشفائه وبيانه . إن الله عز وجل أثنى علاى زكريا وأهل بيته فقال : { كانوا يسارعون في الخيرات ويدعوننا رغبا ورهبا وكانوا لنا PageV13P236 خاشعين } لا خير في قول لا يراد به وجه الله ، ولا خير في مال لا ينفق في سبيل الله ، ولا خير فيمن يغلب جهله حلمه ، ولا خير فيمن يخاف في الله لومة لائم ) ( طب ، حل ، قال ابن كثير : إسناده جيد ) . )(@)(@@)(@@)(@@) $ 955 عن عبد الله بن عكيم قال :(@)(@@) | 30 خطبنا أبو بكر رضي الله عنه فقال : ( أما بعد ، فإني أوصيكم بتقوى الله عز وجل ، وأن تثنوا عليه بما هو أهله ، وأن تخلطوا الرغبة بالرهبة ، وتجمعوا الإلحاف بالمسألة ، فإن الله عز وجل أثناى علاى زكريا وعلاى أهل بيته فقال : { إنهم كانوا يسارعون في الخيرات ويدعوننا رغبا ورهبا وكانوا لنا خاشعين } ثم اعلموا عباد الله إن الله عز وجل قد ارتهن بحقه أنفسكم ، وأخذ علاى ذالك مواثيقكم ، واشترى منكم القليل الفاني بالكثير الباقي ، وهاذا كتاب الله فيكم لا تفنى عجائبه ، ولا يطفأ نوره ، فصدقوا قوله ، وانتصحوا كتابه ، واستبصروا فيه ليوم الظلمة ، فإنما خلقكم للعبادة ، ووكل بكم الكرام الكاتبين يعلمون ما تفعلون ، ثم اعلموا عباد الله إنكم لتغدون وتروحون في أجل قد غيب عنكم علمه ، فإن استطعتم أن تنقضي الآجال وأنتم في عمل الله فافعلوا ، ولن تستطيعوا ذالك إلا بالله ، فسابقوا في مهل آجالكم قبل أن تنقضي فتردكم إلاى سوء أعمالكم ، فإن قوما جعلوا آجالهم لغيرهم فنسوا أنفسهم ، فنهاكم أن تكونوا أمثالهم ، الوحا الوحا النجا النجا إن وراءكم طالبا حثيثا ، أمره سريع ) ( ش ، وهناد ، حل ، ك ، ق ، وروى بعضه ابن أبي الدنيا في قصر الأمل ) . )(@)(@@)(@@)(@@) $ ( 956 ) عن ابن الزبير(@)(@@) | 30 أن أبا بكر رضي الله عنه قال وهو يخطب : ( يا معشر الناس استحيوا من الله ، فوالذي نفسي بيده إني لأظل حتى أذهب إلاى الغائط 
ms4176	 في الفضاء مغطيا رأسي وفي لفظ : مقنعا رأسي استحياء من ربي ) ( ابن المبارك ، ش ، ورسته ، والخرائطي في مكارم الأخلاق ) . )(@)(@@)(@@)(@@) $ ( 957 ) عن عمرو بن دينار قال :(@)(@@) | 30 قال أبو بكر رضي الله عنه : ( استحيوا من PageV13P237 الله ، فوالله إني لأدخل الكنيف فأسند ظهري إلاى الحائط وأغطي رأسي حياء من الله عز وجل ) ( عب ، وهناد ، والخرائطي ) . )(@)(@@)(@@)(@@) $ ( 958 ) عن محمد بن إبراهيم بن الحارث :(@)(@@) | 30 إن أبا بكر الصديق رضي الله عنه خطب الناس فقال : ( والذي نفسي بيده لئن اتقيتم وأحصنتم ليوشكن أن لا يأتي عليكم إلا يسير حتى تشبعوا من الخبز والسمن ) ( ابن أبي الدنيا ، والدينوري ) . )(@)(@@)(@@)(@@) $ ( 959 ) عن موسى بن عقبة أن أبا بكر الصديق رضي الله عنه كان يخطب فيقول :(@)(@@) | 30 ( الحمد لله رب العالمين ، أحمده وأستعينه ، ونسأله الكرامة فيما بعد الموت ، فإنه قد دنا أجلي وأجلكم ، وأشهد أن لا إلاه إلا الله وحده لا شريك له ، وأن محمدا عبده ورسوله ، أرسله بالحق بشيرا ونذيرا ، وسراجا منيرا ، لينذر من كان حيا ويحق القول علاى الكافرين ، ومن يطع الله ورسوله فقد رشد ، ومن يعصهما فقد ضل ضلالا مبينا ، أوصيكم بتقوى الله والاعتصام بأمر الله الذي شرع لكم وهداكم به ، فإنه جوامع هدى الإسلام بعد كلمة الإخلاص ، السمع والطاعة ، لمن ولاه الله أمركم فإنه من يطع والي الأمر بالمعروف والنهي عن المنكر فقد أفلح وأدى الذي عليه من الحق ، وإياكم واتباع الهوى وما فخر من خلق من تراب ثم إلاى التراب يعود ، ثم يأكله الدود ثم هو اليوم حي وغدا ميت فاعملوا يوما بيوم وساعة بساعة ، وتوقوا دعاء المظلوم ، وعدوا أنفسكم في الموتى ، واصبروا فإن العمل كله بالصبر ، واحذروا فالحذر ينفع ، واعملوا فالعمل يقبل ، واحذروا ما حذركم الله من عذابه ، وسارعوا فيما وعدكم الله من رحمته ، وافهموا تفهموا ، واتقوا توقوا ، فإن الله تعالاى قد بين لكم ما أهلك به من كان قبلكم ، وما نجا به من نجا قبلكم ، قد بين لكم في كتابه حلاله وحرامه وما يحب من الأعمال وما يكره ، فإني لا آلوكم 
ms4177	 ونفسي والله المستعان ولا حول ولا قوة إلا بالله واعلموا أنكم ما أخلصتم لله من أعمالكم فربكم أطعتم ، وحظكم حفظتم واغتبطتم ، وما تطوعتم به فاجعلوه نوافل بين أيديكم تستوفوا بسلفكم وتعطوا جزاءكم حين فقركم وحاجتكم إليها ، ثم تفكروا عباد الله في إخوانكم وصحابتكم الذين مضوا قد وردوا علاى ما قدموا فأقاموا عليه ، وحلوا في الشقاء والسعادة فيما بعد الموت ، إن الله ليس له شريك ، وليس بينه وبين أحد من PageV13P238 خلقه نسب يعطيه به خيرا ، ولا يصرف عنه سوءا إلا بطاعته واتباع أمره ، فإنه لا خير في خير بعده النار ، ولا شر في شر بعده الجنة أقول قولي هاذا وأستغفر الله لي ولكم ، وصلوا علاى نبيكم صلى الله عليه والسلام عليه ورحمة الله وبركاته ) ( ابن أبي الدنيا في كتاب الحذر ، كر ) . )(@)(@@)(@@)(@@) $ ( 960 ) عن القاسم بن محمد قال :(@)(@@) | 30 كتب أبو بكر رضي الله عنه إلاى عمرو والوليد بن عقبة وكان بعثهما علاى الصدقة ، وأوصى كل واحد منهما بوصية واحدة : ( اتق الله في السر والعلانية ، فإنه من يتق الله يجعل له مخرجا ويرزقه من حيث لا يحتسب ، ومن يتق الله يكفر عنه سيئاته ويعظم له أجرا ، فإن تقوى الله خير ما تواصى به عباد الله ، إنك في سبيل الله لا يسعك فيه الإدهان والتفريط ولا الغفلة عما فيه قوام دينكم وعصمة أمركم ، فلا تن ولا تفتر وقام أبو بكر رضي الله عنه في الناس خطيبا فحمد الله وصلى علاى رسوله وقال : ( ألا إن لكل أمر جوامع ، فمن بلغها فهو حسبه ، ومن عمل لله عز وجل كفاه الله ، عليكم بالجد والقصد ، فإن القصد أبلغ ، ألا إنه لا دين لاءحد لا إيمان له ، ولا أجر لمن لا حسبة له ، ولا عمل لمن لا نية له ، ألا وإن في كتاب الله من الثواب علاى الجهاد في سبيل الله ما ينبغي للمسلم أن يحب أن يحضره ، هي النجاة التي دل الله عليها ، ونجا بها من الخزي ، وألحق بها الكرامة في الدنيا والآخرة ) ( كر ) . )(@)(@@)(@@)(@@) $ ( 961 ) عن إسماعيل 
ms4178	 بن يحيى ، حدثنا فطر بن خليفة عن أبي الطفيل عن أبي بكر رضي الله عنهم قال :(@)(@@) | 30 ( سمعت النبي في حجة الوداع يقول : إن الله عز وجل وهب لكم ذنوبكم عند الاستغفار ، فمن استغفر بنية صادقة غفر له ، ومن قال : لا إلاه إلا الله ، رجح ميزانه ، ومن صلى علي كنت شفيعه يوم القيامة ) ( أبو بكر محمد بن عبد الباقي الأنصاري قاضي المارستان في مشيخته ) . )(@)(@@)(@@)(@@) $ ( 962 ) عن سلمان رضي الله عنه قال :(@)(@@) | 30 ( أتيت أبا بكر رضي الله عنه فقلت : اعهد إلي ، فقال : يا سلمان اتق الله ، واعلم أن سيكون فتوح فلا أعرفن ما كان حظك منها : ما جعلته في بطنك ، وألقيته علاى ظهرك ، واعلم أنه من صلى الصلوات PageV13P239 الخمس فإنه يصبح في ذمة الله ويمسي في ذمة الله ، فلا تقتلن أحدا من أهل الله فتخفر الله في ذمته ، فيكبك الله في النار علاى وجهك ) ( حم في الزهد وابن سعيد وحشيش بن أصرم في الاستقامة ) . )(@)(@@) PageV13P240(@)(@@)(@@)(@@) |||| ( مسند عمر بن الخطاب رضي الله عنه )(@)(@@)(@@)(@@) $ ( 963 ) عن أبي هريرة رضي الله عنه قال : $ 30 ( كان عمر بن الخطاب رضي الله عنهما ينشد قول زهير بن أبي سلماى في هرم بن سنان :(@)(@@) لو كنت في شي سوى بشر %~% كنت المضيء لليلة البدر(@)(@@) ثم يقول عمر وجلساؤه : كذالك كان رسول الله ولم يكن كذلك غيره ) ( أبو بكر ابن الأنباري في أماليه ) . ) $(@)(@@)(@@)(@@) $ ( 964 ) عن عمر بن الخطاب رضي الله عنه(@)(@@) | 30 أنه سئل عن صفة رسول الله فقال : ( كان أبيض اللون مشربا بحمرة ، أدعج العينين ، كث اللحية ذا وفرة ، رقيق المسربة ، كأن عنقه إبريق فضة ، كأنما يجري له شعر من لبته إلاى سرته ، كالقضيب لم يكن في بطنه ولا في جسده شعرة غيره ، شثن الأصابع ، شثن الكفين والقدمين ، إذا التفت التفت جميعا ، وإذا مشى كأنما يتقلع علاى صخر أو ينحط في صبب ، إذا جاء القوم غمرهم ، كأن ريح عرقه المسك ، بأبي وأمي لم أر قبله ولا بعده أحدا مثله ) ( كر ) . )(@)(@@)(@@)(@@) $ ( 965 ) عن عبد الرحمان بن أبي ليلاى 
ms4179	 قال :(@)(@@) | 30 ( كنت مع عمر ابن الخطاب رضي الله عنه فقال : رأيت أبا القاسم وعليه جبة شامية ضيقة الكمين ) ( ابن سعد وسنده صحيح ) . )(@)(@@)(@@)(@@) $ ( 966 ) عن عمر رضي الله عنه قال :(@)(@@) | 30 ( دخلت علاى رسول الله وهو مضطجع علاى خصفة ، وإن بعضه لعلاى التراب متوسد وسادة من أدم محشوة ليفا PageV13P241 وفوق رأسه إهاب معطوف معلق في سقف العلية وفي زاوية منها شيء من قرظ ) ( هناد ) . )(@)(@@)(@@)(@@) $ ( 967 ) عن الأسود(@)(@@) | 30 أن عمر بن الخطاب رضي الله عنه دخل علاى رسول الله وهو في شكاة شكاها ، فإذا هو علاى عباءة قطوانية ومرفقة من صوف حشوها الإذخر ، فقال : بأبي أنت وأمي يا رسول الله كسرى وقيصر علاى الديباج وأنت علاى هاذه ؟ فقال : يا عمر أما ترضى أن تكون لهم الدنيا ولنا الآخرة ، ثم إن عمر مسه فإذا هو شديد الحمى ، فقال : تحم هاكذا وأنت رسول الله ؟ فقال : إن أشد هاذه الأمة بلاء نبيها ، ثم الخير فالخير ، وكاذالك كانت الأنبياء عليهم السلام قبلكم والأمم ) ( ابن خسرو ) . )(@)(@@)(@@)(@@) $ ( 968 ) عن عمرو بن دينار وعبيد الله بن أبي يزيد قالا :(@)(@@) | 30 ( لم يكن علاى عهد النبي علاى بيت النبيا حائط ، كانوا يصلون حول البيت حتى كان عمر فبنى حوله حائطا ، قال عبيد الله بن أبي يزيد : كان جداره قصيرا ، ثم بناه عبد الله ابن الزبير بعده وزاد فيه ) ( ابن سعد ) . )(@)(@@)(@@)(@@) $ ( 969 ) عن الحسن قال :(@)(@@) | 30 ( دخل عمر بن الخطاب رضي الله عنه علاى النبي فرآه علاى حصير أو سرير قد أثر بجنبه ، وفي البيت أهب عطنة ، فبكى عمر ، فقال : ما يبكيك يا عمر ؟ قال : أنت نبي الله وكسرى وقيصر علاى أسرة الذهب ، قال : يا عمر أما ترضى أن تكون لهم الدنيا ولنا الآخرة ) ( ابن سعد ) . )(@)(@@)(@@)(@@) $ ( 970 ) عن عطاء قال :(@)(@@) | 30 ( دخل عمر بن الخطاب رضي الله عنه علاى النبي ذات يوم وهو مضطجع علاى ضجاع من أدم محشو ليفا ، وفي البيت أهبة ملقاة فبكى عمر ، فقال : ما يبكيك يا عمر ؟ قال : أبكي أن كسرى في الخز والقز والحرير 
ms4180	 والديباج وقيصر مثل ذالك ، وأنت حبيب الله وخيرته كما أرى ، قال : لا تبك يا عمر ، فلو أشاء أن تسير الجبال ذهبا لسارت ، ولو أن الدنيا تعدل عند الله جناح ذباب ما أعطي كافر منها شيئا ) ( ابن سعد ) . )(@)(@@)(@@)(@@) $ ( 971 ) عن أبي البختري عن علي رضي الله عنه قال :(@)(@@) | 30 ( قال عمر بن الخطاب PageV13P242 للناس : ما ترون في فضل فضل عندنا من هاذا المال ؟ فقال الناس : يا أمير المؤمنين قد شغلناك عن أهلك وضيعتك وتجارتك فهو لك ، فقال لي : ما تقول أنت ؟ فقلت : قد أشاروا عليك ، فقال لي : قل ، فقلت : لم تجعل يقينك ظنا ، فقال : لتخرجن مما قلت ، فقلت أجل والله لأخرجن منه ، أتذكر حين بعثك نبي الله ساعيا فأتيت العباس بن عبد المطلب فمنعك صدقته ، فكان بينكما شيء ، فقلت لي : انطلق معي إلاى النبي فلنخبره بالذي صنع ، فانطلقنا إلاى النبي فوجدناه خاثرا ، فرجعنا ثم غدونا عليه الغد ، فوجدناه طيب النفس ، فأخبرته بالذي صنع العباس ، فقال لك : أما علمت أن عم الرجل صنو أبيه ، وذكرنا له الذي رأينا من خثوره في اليوم الأول ، والذي رأينا من طيب نفسه في اليوم الثاني ، فقال : إنكما أتيتماني في اليوم الأول ، وقد بقي عندي من الصدقة ديناران فكان ذالك الذي رأيتما من خثوري لذالك وأتيتماني اليوم وقد وجهتهما فذالك الذي رأيتما من طيب نفسي ، فقال عمر : صدقت أما والله لأشكرن لك الاولاى والآخرة ) ( حم ع والدورقي هق وقال فيه إرسال بين أبي البختري وعلي ) . )(@)(@@)(@@)(@@) $ ( 972 ) عن عمر رضي الله عنه قال :(@)(@@) | 30 ( لقد رأيت رسول الله يظل اليوم يلتوي من الجوع ما يجد من الدقل ما يملأ به بطنه ) ( ط وابن سعد حم م ه وأبو عوانة ع حب وابن جرير ق في الدلائل ) . )(@)(@@)(@@)(@@) $ 973 عن ابن عباس رضي الله عنهما أنه سمع عمر بن الخطاب رضي الله عنه يقول :(@)(@@) | 30 ( خرج رسول الله عند الظهيرة فوجد أبا بكر في المسجد ، فقال : ما أخرجك في هاذه الساعة ؟ فقال : أخرجني الذي أخرجك يا رسول الله ، وجاء عمر 