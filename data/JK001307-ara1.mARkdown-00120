ms106	 أبو مكيت كوفي رأى أبو عمر قال جرير قذاف المحصنات(@)(@@)(@@)(@@) $ 2072 راشد بن معبد عن أنس(@)(@@) قال ابن حبان روى موضوعات وقال غيره واه(@)(@@)(@@)(@@) $ 2073 بخ ق(@)(@@) راشد أبو محمد الحماني صدوق تابعي(@)(@@) قال أبو حاتم صالح الحديث وقال ابن حبان ربما أخطأ(@)PageV01P226(@)(@@)(@@)(@@) $ 2074 راشد عن السائب بن خباب(@)(@@)(@@)(@@) $ 2075 وراشد مؤذن ابن الزبير(@)(@@)(@@)(@@) $ 2076 وراشد بن حفص(@)(@@)(@@)(@@) $ 2077 وراشد اليمامي عن خالد بن معدان مجهولون(@)(@@)(@@)(@@) $ 2078 رافع بن سلمان أو ابن سالم عن عمر وعنه محمد بن إبراهيم التيمي و(@)(@@)(@@)(@@) $ 2079 عس(@)(@@) رافع بن سلمة عن علي مجهولان أنا قلته(@)(@@)(@@)(@@) $ 2080 رباح بن صالح بن عبيد الله بن أبي رافع عن أبيه مجهول(@)(@@)(@@)(@@) $ 2081 رباح بن عبيد الله بن عمر العمري عن أبيه لينوه(@)(@@)(@@)(@@) $ 2082 رباح بن عثمان عن اسماعيل بن عياش مجهول(@)(@@)(@@)(@@) $ 2083 بخ م س ل(@)(@@) رباح بن أبي معروف عن عطاء(@)(@@) قال أبو حاتم صالح الحديث وقال ابن معين ضعيف وقال ابن عدي لم أجد له حديثا منكرا وضعفه أيضا س(@)(@@)(@@)(@@) $ 2084 رباح النوبي عن أسماء بنت أبي بكر(@)(@@) ضعفه بعضهم(@)(@@)(@@)(@@) $ 2085 د ق(@)(@@) ربيح بن عبد الرحمن بن أبي سعيد الخدري(@)(@@) عن أبيه عن جده قال أحمد ليس بمعروف وقال الترمذي قال خ منكر الحديث وقال ابن عدي لا بأس به(@)(@@)(@@)(@@) $ 2086 الربيع بن إسماعيل عن الجعدي(@)(@@) قال أبو حاتم منكر الحديث(@)(@@)(@@)(@@) $ 2087 ت ق(@)(@@) الربيع بن بدر عليلة السعدي عن ثابت(@)(@@) قال الدارقطني وغيره متروك وضعفه أبو داود(@)(@@)(@@)(@@) $ 2088 الربيع بن برة عن الحسن(@)(@@) قال العقيلي قدري داعية ولا مسند عنده PageV01P227(@)(@@)(@@)(@@) $ 2089 ق(@)(@@) الربيع بن حبيب الكوفي عن نوفل بن عبد الملك(@)(@@) ضعيف الحديث وقال أحمد و خ و س منكر الحديث(@)(@@)(@@)(@@) $ 2090 الربيع بن حظيان وقيل ابن حيظان عن الحسن(@)(@@) قال أبو زرعة منكر الحديث(@)(@@)(@@)(@@) $ 2091 الربيع بن خلف عن شعبة مجهول(@)(@@)(@@)(@@) $ 2092 الربيع بن زياد الهمداني عن التابعين(@)(@@) له غرائب وهو جائز الحديث فيه لين(@)(@@)(@@)(@@) $ 2093 الربيع بن سهل عن هشام بن 
ms107	 عروة(@)(@@) ضعفوه(@)(@@)(@@)(@@) $ 2094 د س(@)(@@) الربيع بن سليمان الجيزي لا المرادي(@)(@@) قال أبو عمر الكندي كان فقيها دينا رأى عبد الله بن وهب ولم يتقن السماع منه ووثقه غيره(@)(@@)(@@)(@@) $ 2095 الربيع بن سليمان الأزدي عن سالم(@)(@@) قال ابن معين ليس بشيء(@)(@@)(@@)(@@) $ 2096 خت ت ق(@)(@@) الربيع بن صبيح البصري عن الحسن(@)(@@) قال أبو زرعة صدوق ووضعفه النسائي وابن معين(@)(@@)(@@)(@@) $ 2097 الربيع بن عبد الله بن خطاف عن الحسن(@)(@@) وثقه أحمد وغيره ولينه بعضهم ووهاه القطان(@)(@@)(@@)(@@) $ 2098 الربيع بن مالك(@)(@@) يروي عنه حجاج بن أرطأة في الضعفاء لابن حبان PageV01P228(@)(@@)(@@)(@@) $ 2099 ربيع بن محمود المارديني(@)(@@) كذاب مفتر ادعى الصحبة والتعمير في سنة تسع وتسعين وخمسمائة من بابة رتن(@)(@@)(@@)(@@) $ 2100 الربيع بن مطرف شيخ لمروان بن معاوية(@)(@@) قال يحيى ضعيف(@)(@@)(@@)(@@) $ 2101 الربيع بن يحيى الأشناني عن شعبة صدوق(@)(@@) روى عنه البخاري وفيه بعض اللين والعجب أن أبا حاتم مع تعنته قال ثقة ثبت وقال الدارقطني ضعيف يخطئ كثيرا وقد اتى عن الثوري بخبر منكر عن ابن المنكدر عن جابر في جمع الصلاتين قال بعض الحفاظ هذا يسقط مائة ألف حديث(@)(@@)(@@)(@@) $ 2102 ربيعة بن ربيعة شيخ للوليد بن مسلم لا يعرف PageV01P229(@)(@@)(@@)(@@) $ 2103 د ت س(@)(@@) ربيعة بن سيف المعافري مصري تابعي(@)(@@) قال البخاري وابن يونس عنده مناكير(@)(@@)(@@)(@@) $ 2104 ع(@)(@@) ربيعة بن أبي عبد الرحمن فقيه المدينة ثقة(@)(@@) قال ابن الصلاح قيل إنه تغير في الآخر من عمره(@)(@@)(@@)(@@) $ 2105 م ق(@)(@@) ربيعة بن عثمان عن ابن المنكدر صدوق(@)(@@) وقال أبو حاتم منكر الحديث(@)(@@)(@@)(@@) $ 2106 م س(@)(@@) ربيعة بن كلثوم البصري عن الحسن ثقة(@)(@@) قال النسائي ليس بالقوي(@)(@@)(@@)(@@) $ 2107 ربيعة بن محمد أبو قضاعة الطائي عن ذي النون المصري بخبر باطل قال الجوزجاني متروك(@)(@@)(@@)(@@) $ 2108 ربيعة بن النابغة عن أبيه عن علي لم يصح حديثه في الأضاحي قاله خ(@)(@@)(@@)(@@) $ 2109 ص ق(@)(@@) ربيعة بن ناجد عن علي فيه جهالة(@)(@@)(@@)(@@) $ 2110 رتن الهندي أظنه لا وجود له بل هو اسم موضوع لأخبار مكذوبة أو هو شيطان تبدى 
ms108	 لهم في صورة إنسي زعم في حدود سنة ستمائة أنه صحب النبي صلى الله عليه وسلم فافتضح بتلك الأحاديث الموضوعة وبكل حال إبليس أسن منه PageV01P230(@)(@@)(@@)(@@) $ 2111 رجاء بن الحارث عن مجاهد(@)(@@) ضعفه ابن معين وهو أبو سعيد بن عوذ(@)(@@)(@@)(@@) $ 2112 رجاء بن سهل عن ابن علية(@)(@@) قال الأزدي كان يسرق الحديث(@)(@@)(@@)(@@) $ 2113 ت(@)(@@) رجاء بن صبيح أبو يحيى صاحب السقط(@)(@@) عن يحيى بن أبي كثير وابن سيرين قال ابن معين ضعيف وقال أبو حاتم وغيره ليس بالقوي ووثقه ابن حبان(@)(@@)(@@)(@@) $ 2114 رجاء بن أبي عطاء المصري عن واهب المعافري(@)(@@) قال ابن حبان يروي الموضوعات(@)(@@)(@@)(@@) $ 2115 الرجال بن سالم عن عطاء(@)(@@) لا يعرف روى خبرا منكرا(@)(@@)(@@)(@@) $ 2116 رحمة بن مصعب الواسطي عن عثمان بن سعد(@)(@@) قال ابن معين ليس بشيء(@)(@@)(@@)(@@) $ 2117 رزق الله بن الاسود عن ثابت(@)(@@) قال العقيلي حديثه منكر(@)(@@)(@@)(@@) $ 2118 رزق الله سلام الطبري(@)(@@) عن ابن عيينة في حديثه نكارة(@)(@@)(@@)(@@) $ 2119 س ق(@)(@@) رزق الله بن موسى بغدادي(@)(@@) صدوق وهم فرفع حديثا عن يحيى القطان(@)(@@)(@@)(@@) $ 2120 رزيق الأعمى عن أبي هريرة(@)(@@) قال الأزدي متروك(@)(@@)(@@)(@@) $ 2121 ق(@)(@@) رزيق أبو عبد الله الأبهاني عن أنس(@)(@@) صدوق قال ابن حبان لا يحتج به PageV01P231(@)(@@)(@@)(@@) $ 2122 س(@)(@@) رزين بن سليمان عن ابن عمر لا يعرف(@)(@@)(@@)(@@) $ 2123 ت ق(@)(@@) رشدين بن سعد المهري عن زهرة بن معبد(@)(@@) ضعفه أبو زرعة وغيره(@)(@@)(@@)(@@) $ 2124 ت ق(@)(@@) رشدين بن كريب مولى ابن عباس عن أبيه(@)(@@) ضعفه أبو زرعة والدارقطني وابن المديني(@)(@@)(@@)(@@) $ 2125 رشيد بن إبراهيم عن الحسن(@)(@@)(@@)(@@) $ 2126 ورشيد الزريري عن ثابت مجهولان(@)(@@)(@@)(@@) $ 2127 رشيد الهجري عن أبيه(@)(@@) قال الجوزجاني كذاب غير ثقة وقال س ليس بالقوي(@)(@@)(@@)(@@) $ 2128 رفاعة بن هرير بن عبد الرحمن بن رافع بن خديج(@)(@@) وهاه ابن حبان وقال خ فيه نظر سمع منه ابن أبي فديك(@)(@@)(@@)(@@) $ 2129 ق(@)(@@) رفدة بن قضاعة عن ثابت بن عجلان(@)(@@) قال البخاري لا يتابع على حديثه وقال الدارقطني متروك(@)(@@)(@@)(@@) $ 2130 ركن الشامي عن مكحول تركوا حديثه(@)(@@)(@@)(@@) $ 2131 ركين بن 
ms109	 عبد الأعلى شيخ للثوري(@)(@@) ضعفه أبو عبد الرحمن النسائي وغيره(@)(@@)(@@)(@@) $ 2132 رميح بن هلال عن ابن بريدة مجهول(@)(@@)(@@)(@@) $ 2133 ت(@)(@@) رميح عن أبي هريرة لا يعرف PageV01P232(@)(@@)(@@)(@@) $ 2134 ق(@)(@@) رواد بن الجراح العسقلاني(@)(@@) سمع الأوزاعي وثقه ابن معين بالشدة وضعفه الدارقطني وقال أبو حاتم محله الصدق(@)(@@) وله خبر منكر عن سفيان عن منصور عن ربعي عن حذيفة خيركم في المائتين الخفيف الحاذ(@)(@@)(@@)(@@) $ 2135 رؤبة بن رويبة(@)(@@) روى عن قتادة حديثا واهيا وعنه من لا يحتج به(@)(@@)(@@)(@@) $ 2136 ت(@)(@@) روح بن أسلم الباهلي عن حماد بن سلمة(@)(@@) ضعفوه ووثقه ابن حبان فقط(@)(@@)(@@)(@@) $ 2137 ت ق(@)(@@) روح بن جناح عن مجاهد(@)(@@) وثقه دحيم وقال النسائي ليس بالقوي وقال غيره له مناكير(@)(@@)(@@)(@@) $ 2138 روح بن حاتم عن هشيم من مشيخة أبي يعلى(@)(@@) قال ابن معين ليس بشيء(@)(@@)(@@)(@@) $ 2139 روح بن صلاح المصري عن ابن لهيعة(@)(@@) ضعفه ابن عدي يقال له ابن يسابة(@)(@@)(@@)(@@) $ 2140 ع(@)(@@) روح بن عبادة ثقة شهير(@)(@@) قال فيه النسائي مرة ليس بالقوي قاله في كتاب العتق وروى الكناني عن أبي حاتم PageV01P233 أنه قال يكتب حديثه ولا يحتج به(@)(@@)(@@)(@@) $ 2141 روح بن عبد الكريم عن حماد بن سلمة(@)(@@) قال أبو حاتم يتكلمون فيه(@)(@@)(@@)(@@) $ 2142 روح بن عبد الواحد عن موسى بن أعين(@)(@@) لين الحديث(@)(@@)(@@)(@@) $ 2143 روح بن عبيد شيخ لمحمد بن ربيعة الكلابي(@)(@@) قال البخاري منكر الحديث(@)(@@)(@@)(@@) $ 2144 روح بن عطاء بن أبي ميمونة(@)(@@) ضعفه النسائي وغيره(@)(@@)(@@)(@@) $ 2145 روح بن عيينة الطائي(@)(@@) عن أبيه عن جده مجهول(@)(@@)(@@)(@@) $ 2146 روح بن غطيف الثقفي(@)(@@) عن الزهري تركه النسائي وغيره(@)(@@)(@@)(@@) $ 2147 روح بن الفضل عن حماد بن سلمة(@)(@@) مجهول وقال خ معروف بالحديث(@)(@@)(@@)(@@) $ 2148 روح بن مسافر عن أبي اسحاق(@)(@@) قال أبو داود وغيره متروك(@)(@@)(@@)(@@) $ 2149 روح بن المسيب عن ثابت(@)(@@) قال ابن معين صويلح وقال ابن حبان يروي الموضوعات عن الثقات لا تحل الرواية عنه(@)(@@)(@@)(@@) $ 2150 رياح بن صالح مجهول(@)(@@)(@@)(@@) $ 2151 رياح بن عمرو القيسي(@)(@@) قال أبو داود رجل سوء(@)(@@)(@@)(@@) $ 2152 د س ريحان 
ms110	 بن سعيد الناجي عن عباد بن منصور(@)(@@) صدوق قال أبو حاتم ليس بحجة قلت ليس بالمتقن PageV01P234(@)(@@)(@@)(@@) $ 2153 د ت(@)(@@) ريحان بن يزيد عن عبد الله بن عمرو(@)(@@) وعنه سعد بن إبراهيم مجهول ووثقه ابن معين PageV01P235(@)(@@)(@@)(@@) | حرف الزاي(@)(@@)(@@)(@@) $ 2154 ت ق سي(@)(@@) زافر بن سليمان القهستاني سمع ابن جريج وثقه جماعة وضعفه آخرون(@)(@@)(@@)(@@) $ 2155 زامل بن زياد الطائي شيخ لعلي بن محمد المدائني مجهول(@)(@@)(@@)(@@) $ 2156 زاهر بن طاهر الشحامي صدوق في الرواية لكنه يخل بالصلوات علا سنده وتكاثروا عليه وروى عنه ابن عساكر الكثير(@)(@@)(@@)(@@) $ 2157 زائدة بن سليم مجهول(@)(@@)(@@)(@@) $ 2158 س زائده بن أبي الرقاد معاذ عن زياد النميري(@)(@@) قال البخاري منكر الحديث(@)(@@)(@@)(@@) $ 2159 زائدة بن سعد(@)(@@) قال أبو حاتم حديثه منكر(@)(@@)(@@)(@@) $ 2160 د ت ق(@)(@@) زبان بن فائد عن سهل بن معاذ(@)(@@) ضعف وقال أبو حاتم صالح الحديث(@)(@@)(@@)(@@) $ 2161 زبرقان بن عبد الله شيخ للثوري(@)(@@) فيه لين ما ذكره العقيلي(@)(@@)(@@)(@@) $ 2162 زبيد بن الحارث اليامي حجة فيه تشيع يسير PageV01P236(@)(@@)(@@)(@@) $ 2163 الزبير بن بكار صدوق غمزه السليماني(@)(@@)(@@)(@@) $ 2164 ت(@)(@@) زبير بن جنادة الهجري(@)(@@) عن عطاء فيه جهالة وذكره ابن حبان في الثقات(@)(@@)(@@)(@@) $ 2165 الزبير بن خبيب المدني عن بعض التابعين(@)(@@) ضعف(@)(@@)(@@)(@@) $ 2166 الزبير بن خربوذ(@)(@@) قال الأزدي ضعيف مجهول روى عنه عثمان الغطفاني(@)(@@)(@@)(@@) $ 2167 د(@)(@@) الزبير بن خريق عن أبي أمامة(@)(@@) صدوق قال الدارقطني ليس بالقوي ذكره ابن حبان في الثقات(@)(@@)(@@)(@@) $ 2168 الزبير بن الزبير الجهضمي مجهول(@)(@@)(@@)(@@) $ 2169 د ت ق(@)(@@) الزبير بن سعيد الهاشمي عن صفوان بن سليم(@)(@@) لين وثقه يحيى وقال س وغيره ضعيف(@)(@@)(@@)(@@) $ 2170 الزبير بن الشعشاع(@)(@@) عن علي في إباحة الحمر لم يصح حديثه(@)(@@)(@@)(@@) $ 2171 ق(@)(@@) الزبير بن سليم(@)(@@) لا يعرف عنه ابن لهيعة(@)(@@)(@@)(@@) $ 2172 قد(@)(@@) الزبير بن عبد الله المدني عن صفوان بن سليم(@)(@@) ليس بحجة(@)(@@)(@@)(@@) $ 2173 ق(@)(@@) الزبير بن عبيد(@)(@@) لا يعرف لقي عائشة(@)(@@)(@@)(@@) $ 2174 الزبير بن عيسى عن هشام بن عروة وهو والد الحميدي(@)(@@) قال العقيلي حديثه غير محفوظ(@)(@@)(@@)(@@) $ 2175 ق(@)(@@) الزبير بن المنذر 
ms111	 الساعدي تابعي لا يعرف PageV01P237(@)(@@)(@@)(@@) $ 2176 زحر بن حصن عن جده وعنه أبو السكين الطائي(@)(@@) لا يعرف(@)(@@)(@@)(@@) $ 2177 ت ق(@)(@@) زربي أبو عبد الله عن أنس(@)(@@) قال البخاري في حديثه نظر وقال الترمذي له مناكير(@)(@@)(@@)(@@) $ 2178 سي(@)(@@) زرارة(@)(@@) عن عائشة في فضائل الأعمال لا يدرى من هو(@)(@@)(@@)(@@) $ 2179 زرارة بن أعين أخو حمران(@)(@@) كوفي فيه رفض بين(@)(@@)(@@)(@@) $ 2180 زرزر المخزومي(@)(@@) حكى عن ابن عيينه لا يعرف من هو(@)(@@)(@@)(@@) $ 2181 زرعة بن إبراهيم عن عطاء(@)(@@) قال أبو حاتم الرازي ليس بالقوي(@)(@@)(@@)(@@) $ 2182 زرعة بن عبد الله شيخ لبقية(@)(@@) قال الأزدي متروك(@)(@@)(@@)(@@) $ 2183 زريق بن محمد الكوفي عن حماد بن زيد(@)(@@) ضعفه ابن ماكولا(@)(@@)(@@)(@@) $ 2184 س(@)(@@) زفر بن أوس بن الحدثان أخو مالك(@)(@@) لم يرو عنه غير عبيد الله بن عبد الله بن عتبة(@)(@@)(@@)(@@) $ 2185 زفر بن محمد الفهري مدني(@)(@@) عنه عثمان بن عبد الرحمن الحراني قال أبو حاتم يكتب حديثه(@)(@@)(@@)(@@) $ 2186 زفر بن الهذيل العنبري الفقيه صدوق(@)(@@) وثقه غير واحد وأما محمد بن سعد فقال لم يكن في الحديث بشيء PageV01P238(@)(@@)(@@)(@@) $ 2187 زكار عن علي مجهول(@)(@@)(@@)(@@) $ 2188 ع(@)(@@) زكريا بن اسحاق المكي عن عطاء(@)(@@) محتج به في الكتب قال أبو حاتم لا بأس به وقال أحمد ثقة وقال ابن معين ثقة قدري والصحيح أنه لم يسمع من عطاء(@)(@@)(@@)(@@) $ 2189 زكريا بن بدر مجهول(@)(@@)(@@)(@@) $ 2190 زكريا بن حكيم أبو يحيى الحبطي عن الحسن(@)(@@) قال ابن المديني هالك(@)(@@)(@@)(@@) $ 2191 زكريا بن دويد الكندي(@)(@@) كذاب ادعى السماع من مالك والثوري وأن له مائة وثلاثين سنة قال ابن حبان كان يضع الحديث(@)(@@)(@@)(@@) $ 2192 ع(@)(@@) زكريا بن أبي زائدة صدوق مشهور(@)(@@) قال أبو زرعة صويلح وقال أبو حاتم لين الحديث يدلس وثقه د وقال يدلس(@)(@@)(@@)(@@) $ 2193 زكريا بن زيد(@)(@@) مجهول شيخ للواقدي(@)(@@)(@@)(@@) $ 2194 زكريا بن صهيب عن أبي صالح مجهول(@)(@@)(@@)(@@) $ 2195 زكريا بن عبد الله شيخ لأبي علي الحنفي(@)(@@) قال ابن معين ليس حديثه بشيء(@)(@@)(@@)(@@) $ 2196 زكريا بن عبيدة عن بهز بن حكيم(@)(@@) لا يعرف(@)(@@)(@@)(@@) $ 2197 زكريا بن 
ms112	 عطية عن عثمان بن عطاء الخراساني(@)(@@) قال أبو حاتم منكر الحديث PageV01P239(@)(@@)(@@)(@@) $ 2198 زكريا بن أبي مريم شيخ لهشيم(@)(@@) قال النسائي ليس بالقوي(@)(@@)(@@)(@@) $ 2199 ق(@)(@@) زكريا بن منظور عن هشام بن عروة(@)(@@) ضعفه جماعة وقال ابن معين ليس بثقة(@)(@@)(@@)(@@) $ 2200 د س ق(@)(@@) زكريا بن يحيى بن عمارة عن ثابت(@)(@@) جائز الحديث ذكره ابن حبان في الثقات و قال أبو حاتم شيخ وحسن أمره أبو زرعة(@)(@@)(@@)(@@) $ 2201 زكريا بن يحيى الكندي عن الشعبي(@)(@@) قال يحيى ليس بشيء(@)(@@)(@@)(@@) $ 2202 زكريا بن يحيى البدي عن عكرمة(@)(@@) قال يحيى ليس بثقة(@)(@@)(@@)(@@) $ 2203 زكريا بن يحيى الكسائي(@)(@@) عن محمد بن فضيل رافضي هالك(@)(@@)(@@)(@@) $ 2204 زكريا بن يحي الوقار عن ابن وهب(@)(@@) وكان أحد الفقهاء اتهم بالكذب(@)(@@)(@@)(@@) $ 2205 زكريا بن يحيى السراج المقرئ(@)(@@) ضعفه أبو سعيد ابن يونس من طبقة الوقار(@)(@@)(@@)(@@) $ 2206 خ(@)(@@) زكريا بن يحيى أبو السكنين الطائي قال الدارقطني ليس بالقوي رمي بأحديث ليست بمضيئة(@)(@@)(@@)(@@) $ 2207 م متابعة ت ص د ق(@)(@@) زمعة بن صالح المكي(@)(@@) عن عمرو بن دينار صالح الحديث ضعفه أحمد وأبو حاتم ووثقه ابن معين PageV01P240(@)(@@)(@@)(@@) $ 2208 د س(@)(@@) زميل عن مولاه عروة بن الزبير(@)(@@) تكلم فيه لجهالته وقال خ لا تقوم به حجة ووثقه ابن حبان(@)(@@)(@@)(@@) $ 2209 ق(@)(@@) زنفل العرفي عن ابن أبي مليكة(@)(@@) ضعفه الدارقطني وغيره ومشاه غيره(@)(@@)(@@)(@@) $ 2210 زهدم بن الحارث الطائي عن بهز بن حكيم(@)(@@) لا يعرف(@)(@@)(@@)(@@) $ 2211 زهدم بن الحارث المكي عن حفص بن غياث(@)(@@) حديثه منكر(@)(@@)(@@)(@@) $ 2212 زهير بن اسحاق عن يونس بن عبيد(@)(@@) ضعف وقال ابن عدي أرجو أنه لا بأس به(@)(@@)(@@)(@@) $ 2213 زهير بن ثابت ضعفه ابن حزم(@)(@@)(@@)(@@) $ 2214 د ق(@)(@@) زهير بن سالم عن ثوبان(@)(@@) قال الدارقطني حمصي منكر لم يسمع ثوبان(@)(@@)(@@)(@@) $ 2215 زهير بن العلاء عن عطاء بن أبي ميمونة وعن أبو الأشعث(@)(@@) قال أبو حاتم أحاديثه موضوعة(@)(@@)(@@)(@@) $ 2216 زهير بن مالك أبو الوازع عن ابن عمر(@)(@@) قال أحمد كانت فيه غفلة شديدة(@)(@@)(@@)(@@) $ 2217 زهير بن محمد الأبلي لين(@)(@@) قاله الدارقطني 
ms113	 قلت كأنه أراد محمد بن زهير(@)(@@)(@@)(@@) $ 2218 ع(@)(@@) زهير بن محمد التميمي المروزي عن ابن المنكدر PageV01P241 ثقة له غرائب ضعفه ابن معين(@)(@@) وقال البخاري روى أهل الشام عنه مناكير(@)(@@)(@@)(@@) $ 2219 ق(@)(@@) زهير بن مرزوق عن علي بن جدعان(@)(@@) ضعف وقال ابن معين لا يعرف وقال خ مجهول(@)(@@)(@@)(@@) $ 2220 زهير بن منقذ عن ابن عمر مجهول(@)(@@)(@@)(@@) $ 2221 م ت ق(@)(@@) زياد بن اسماعيل عن محمد بن عباد(@)(@@) ضعفه ابن معين روى عنه ابن جريج وقواه س وأبو حاتم(@)(@@)(@@)(@@) $ 2222 د(@)(@@) زياد بن بيان(@)(@@) لم يصح خبره له في الكتابين حديث المهدي من ولد فاطمة(@)(@@)(@@)(@@) $ 2223 د(@)(@@) زياد بن جارية عن حبيب بن مسلمة(@)(@@)(@@)(@@) $ 2224 وزياد بن جبل عن ابن الزبير(@)(@@) مجهولان قلت بل زياد بن جارية صدوق روى عنه جماعة(@)(@@)(@@)(@@) $ 2225 زياد بن أبي حسان عن أنس تركوه(@)(@@)(@@)(@@) $ 2226 ت(@)(@@) زياد بن الحسن القزاز(@)(@@) مشهور منكر الحديث قاله أبو حاتم(@)(@@)(@@)(@@) $ 2227 زياد بن أبي حفصة عن عكرمة(@)(@@) لا يعرف وحديثه كالموضوع(@)(@@)(@@)(@@) $ 2228 خ ت ق(@)(@@) زياد بن الربيع(@)(@@) قال البخاري في إسناد حديثه نظر وثقه أبو داود PageV01P242(@)(@@)(@@)(@@) $ 2229 د زياد بن أبي زياد الجصاص عن أنس تركوه(@)(@@)(@@)(@@) $ 2230 د زياد بن سعد بن ضميرة تابعي لا يعرف(@)(@@)(@@)(@@) $ 2231 زياد بن طارق عن أبي جرول(@)(@@) ما روى عنه إلا عبيد الله بن رماحس(@)(@@)(@@)(@@) $ 2232 زياد بن عبد الله النميري ضعيف(@)(@@)(@@)(@@) $ 2233 زياد بن عبد الله النخعي عن علي(@)(@@) قال الدارقطني مجهول(@)(@@)(@@)(@@) $ 2234 زياد بن عبد الله أو ابن عبيد عن الشعبي(@)(@@) قال النسائي ليس بثقة(@)(@@)(@@)(@@) $ 2235 خ م ت ق(@)(@@) زياد بن عبد الله البكائي عن منصور(@)(@@) قال ابن معين لا بأس به في المغازي خاصة وقال أبو حاتم لا يحتج به وقال جزرة هو على ضعفه أثبت الناس في المغازي وقال أبو زرعة صدوق وقال عباس عن ابن معين ليس بشيء وقال الترمذي كثير المناكير وضعفه ابن المديني والنسائي(@)(@@)(@@)(@@) $ 2236 ق(@)(@@) زياد بن عبد الله عن عاصم بن محمد لا يعرف 
ms114	(@)(@@)(@@)(@@) $ 2237 د(@)(@@) زياد بن عبد الرحمن كذلك تابعي(@)(@@)(@@)(@@) $ 2238 زياد بن عباد عن كعب مجهول(@)(@@)(@@)(@@) $ 2239 زياد بن عبيدة عن أنس كذلك وخبره باطل(@)(@@)(@@)(@@) $ 2240 زياد بن عثمان تابعي مجهول PageV01P243(@)(@@)(@@)(@@) $ 2241 زياد بن أبي عمار عن أنس(@)(@@) يغفر لكل مسلم يوم الجمعة كذبه يزيد بن هارون(@)(@@)(@@)(@@) $ 2242 زياد بن كثير عن علي(@)(@@) مجهول(@)(@@)(@@)(@@) $ 2243 زياد بن مالك عن علي(@)(@@) ليس بمشهور(@)(@@)(@@)(@@) $ 2244 ق زياد بن أبي مريم الجزري(@)(@@) تابعي لا يعرف(@)(@@)(@@)(@@) $ 2245 مد زياد بن أبي مسلم(@)(@@) وثقه الناس وضعفه القطان روى عنه عبد الرحمن بن مهدي ووثقه ابن معين(@)(@@)(@@)(@@) $ 2246 زياد بن أبي المليح الهذلي عن أبيه(@)(@@) قال أبو حاتم ليس بالقوي(@)(@@)(@@)(@@) $ 2247 زياد بن المنذر أبو الجارود(@)(@@) عن أبي الطفيل متهم قال أحمد متروك وقيل كان يفرط في رفضه(@)(@@)(@@)(@@) $ 2248 زياد بن ميمون صاحب الفاكهة عن أنس(@)(@@) ويقال هل زياد بن أبي عمار وزياد بن أبي حسان اعترف بالكذب وتاب وقال عدوا أني كنت يهوديا ثم نكث وكذب أدركه يحيى بن يحيى وقال محمود بن غيلان حدثني أبو داود الطيالسي قال لقيت زياد بن ميمون أنا وعبد الرحمن بن مهدي فسألناه فقال عدوا أن الناس لا يعلمون أني لم ألق أنس بن مالك ألا تعلمان أنتما ثم بلغنا أنه يحدث عنه فأتيناه فقال إني أتوب إلى الله وكان بعد يبلغنا أنه يحدث عنه فتركناه وقال البخاري تركوه وقال النسائي وغيره متروك PageV01P244(@)(@@)(@@)(@@) $ 2249 زياد بن يزيد الزيادي عن عبد الله بن عمرو(@)(@@) مجهول(@)(@@)(@@)(@@) $ 2250 زياد أبو السكن عن الشعبي(@)(@@) قال النسائي ليس بثقة(@)(@@)(@@)(@@) $ 2251 زياد عن ابن مسعود مجهول يقال زياد بن سليخ ويقال زياد ابن أسلم(@)(@@)(@@)(@@) $ 2252 زياد مولى بني مخزوم عن عثمان(@)(@@) قال ابن معين لاشيء(@)(@@)(@@)(@@) $ 2253 زياد أبو عمرو بصري مقل عن أبي بشر الوليد(@)(@@) ضعفه ابن معين(@)(@@)(@@)(@@) $ 2254 زياد أبو بشير عن الحسن(@)(@@) مجهول(@)(@@)(@@)(@@) $ 2255 زياد مولى معيقب(@)(@@) مجهول(@)(@@)(@@)(@@) $ 2256 زياد والد أبي المقدام هشام(@)(@@) ضعيف الحديث كوفي(@)(@@)(@@)(@@) $ 2257 ت(@)(@@) زياد الطائي عن أبي هريرة 
ms115	(@)(@@) لا يعرف لين الترمذي حديثه(@)(@@)(@@)(@@) $ 2258 ت ق(@)(@@) زياد أبو الأوبر(@)(@@) مدني تابعي لا يعرف(@)(@@)(@@)(@@) $ 2259 زياد أبو عمار(@)(@@) قال أبو داود الطيالسي رأيته أقر بوضع الحديث(@)(@@)(@@)(@@) $ 2260 زياد شيخ روى عنه يحيى بن عبد الرحمن بن حاطب مجهول(@)(@@)(@@)(@@) $ 2261 د سي(@)(@@) زيادة بن محمد عن محمد بن كعب(@)(@@) قال البخاري وغيره منكر الحديث(@)(@@)(@@)(@@) $ 2262 ع(@)(@@) زيد بن أبي أنيسة ثقة نبيل(@)(@@) قال أحمد في حديثه بعض النكارة(@)(@@)(@@)(@@) $ 2263 زيد بن تغلب(@)(@@) عن أبي المنذر مجهول كشيخه(@)(@@)(@@)(@@) $ 2264 ت ق(@)(@@) زيد بن جبيرة عن أبيه وأبي طوالة(@)(@@) متروك الحديث من أهل المدينة PageV01P245(@)(@@)(@@)(@@) $ 2265 زيد بن جساس عن محمد بن الحنفية(@)(@@) مجهول وقيل ابن جستاس(@)(@@)(@@)(@@) $ 2266 س ق(@)(@@) زيد بن حبان الرقي عن الزهري(@)(@@) وثقه يحيى وقال أحمد تركنا حديثه وقال الدارقطني ضعيف(@)(@@)(@@)(@@) $ 2267 زيد بن الحسن(@)(@@) عن مالك صاحب مناكير وفيه جهالة(@)(@@)(@@)(@@) $ 2268 زيد بن الحسن بن زيد بن أميرك الحسيني(@)(@@) وضع أربعين حديثا في زمان طراد وكان يترك الجمعة فيما قيل وأكثر شيوخه مجاهيل مات بنيسابور(@)(@@)(@@)(@@) $ 2269 ت(@)(@@) زيد بن الحسن القرشي عن معروف بن خربوذ(@)(@@) قال أبو حاتم منكر الحديث وقال غيره حديثه غريب(@)(@@)(@@)(@@) $ 2270 زيد بن حماد بن سلمة(@)(@@) في خطبة الموضوعات لابن الجوزي أنه كان يدس في كتب أبيه الأحاديث(@)(@@)(@@)(@@) $ 2271 عه(@)(@@) زيد بن الحواري العمي عن أنس مقارب الحال قال ابن عدي لعل شعبة لم يرو عن أحد أضعف منه(@)(@@)(@@)(@@) $ 2272 زيد بن رفاعة الهاشمي(@)(@@) معروف بوضع الحديث لقي ابن دريد وكان يتفلسف قلت هو زيد بن عبد الله أبو الخير PageV01P246(@)(@@)(@@)(@@) $ 2273 زيد بن رفيع عن أبي عبيدة بن عبد الله بن مسعود ليس بالقوي(@)(@@)(@@)(@@) $ 2274 زيد بن سعيد الواسطي(@)(@@) عن أبي اسحاق الفزاري بخبر باطل من أدخل على مؤمن سرورا لن تمسه النار(@)(@@)(@@)(@@) $ 2275 زيد بن صالح(@)(@@) عن الوازع بن نافع مجهول(@)(@@)(@@)(@@) $ 2276 زيد بن صبح(@)(@@) عن مجهول(@)(@@)(@@)(@@) $ 2277 زيد بن عبد الرحمن بن زيد بن أسلم عن أبيه(@)(@@) قال البخاري منكر الحديث(@)(@@)(@@)(@@) $ 2278 
ms116	 زيد بن عبد الرحمن عن عمرو بن شعيب(@)(@@) مجهول(@)(@@)(@@)(@@) $ 2279 زيد بن عفيف كذلك(@)(@@)(@@)(@@) $ 2280 زيد بن عمر بن عاصم عن سهيل بن أبي صالح(@)(@@) حديثه منكر(@)(@@)(@@)(@@) $ 2281 زيد بن عوف أبو ربيعة ولقبه فهد عن حماد بن سلمة تركوه(@)(@@)(@@)(@@) $ 2282 عه(@)(@@) زيد بن أبي عياش مدني مشهور(@)(@@) قال ابن حزم مجهول ورد حديثه بذلك(@)(@@)(@@)(@@) $ 2283 زيد بن عياض البصري تابعي(@)(@@) تكلم فيه أيوب السختياني(@)(@@)(@@)(@@) $ 2284 زيد بن محمد بن خلف(@)(@@) مصري متأخر لين عن PageV01P247 أصحاب ابن وهب قال ابن يونس ليس بالقوي(@)(@@)(@@)(@@) $ 2285 زيد بن محمد بن اليابس أبو الحسين الكوفي(@)(@@) عن إبراهيم ابن عبد الله القصار قال الخطيب صدوق وقال محمد بن أحمد بن سفيان الحافظ كتبت عنه وهو صدوق اختلط عقله آخر عمره ووسوس(@)(@@)(@@)(@@) $ 2286 زيد بن واقد عن حميد(@)(@@) وثقه أبو حاتم وسمع منه بالري وقال أبو زرعة ليس بشيء(@)(@@)(@@)(@@) $ 2287 ع(@)(@@) زيد بن وهب(@)(@@) تابعي جليل ثبت وإنما أوردته لأن يعقوب الفسوي قال في تاريخه في حديثه خلل كثير ثم ذكر له قول عمر بالله يا حذيفة أنا من المنافقين قال وهذا محال أخاف أن يكون كذبا رواه الاعمش عنه قال ومما يستدل به على ضعف حديثه روايته عن حذيفة إن خرج الدجال تبعه من كان يحب عثمان ومن خلل روايته قوله ثنا والله أبو ذر بالربذة قال كنت مع النبي صلى الله عليه وسلم فاستقبلنا أحد الحديث(@)(@@) وهذا الذي استنكره الفسوي ما استنكره أحد ولو فتحنا هذه الوساوس علينا لرددنا السنن بالوهم(@)(@@)(@@)(@@) $ 2288 زيد بن يحيى البيع(@)(@@) ثنا عنه الابر قوهي قيل إنه ألحق اسمه في جزء لوين وفي نسخه محمد السري بن التمار فما نفقا عنه(@)(@@)(@@)(@@) $ 2289 زيد أبو عمر عن انس بن مالك(@)(@@) قال البخاري سكتوا عنه PageV01P248(@)(@@)(@@)(@@) $ 2290 زيد أبو أسامة عن عكرمة(@)(@@) قال الأزدي يتكلمون فيه(@)(@@)(@@)(@@) $ 2291 عخ(@)(@@) زيد النميري عن الحسن(@)(@@) لا يعرف وعنه حماد بن زيد(@)(@@)(@@)(@@) $ 2292 زيد عن عائشة مجهول(@)(@@)(@@)(@@) $ 2293 زيد السلمي عن أبي جعفر الباقر(@)(@@) مجهول 
ms117	(@)(@@)(@@)(@@) $ 2294 زينب السهمية عن عائشة وعنها عمرو بن شعيب(@)(@@) خبر وكان يقبل ولا يتوضأ قال الدارقطني مجهولة لا تقوم بها حجة PageV01P249(@)(@@)(@@)(@@) | حرف السين(@)(@@)(@@)(@@) $ 2295 سابق بن عبد الله الرقي عن أبي خلف(@)(@@) عن أنس إذا مدح الفاسق أهتز العرش رواه عنه المعافى بن عمران الموصلي والخبر منكر(@)(@@)(@@)(@@) $ 2296 سالم بن إبراهيم(@)(@@) قال الد ارقطني ليس بثبت أحسبه روى عن أبي بكر بن عياش(@)(@@)(@@)(@@) $ 2297 ع(@)(@@) سالم بن أبي الجعد(@)(@@) من ثقات التابعين لكنه يرسل قال أحمد لم يسمع من ثوبان(@)(@@)(@@)(@@) $ 2298 بخ ت(@)(@@) سالم بن أبي حفصة العجلي(@)(@@) وثقه ابن معين وضعفه الفلاس و س وهو شيعي جلد(@)(@@)(@@)(@@) $ 2299 س ق(@)(@@) سالم بن رزين(@)(@@) روى عنه علقمه حديثا شديد الأضطراب(@)(@@)(@@)(@@) $ 2300 سالم بن سلمة أبو سبرة الهذلي(@)(@@) يروي عنه ابن بريدة مجهول(@)(@@)(@@)(@@) $ 2301 سالم بن صالح الرازي لا يعرف PageV01P250(@)(@@)(@@)(@@) $ 2302 سالم بن عبد الله الكلابي(@)(@@) عن التابعين فذكر حديثا موضوعا في الخضاب(@)(@@)(@@)(@@) $ 2303 ت ق(@)(@@) سالم بن عبد الله الخياط عن الحسن(@)(@@) قال يحيى ابن معين ليس بشيء(@)(@@)(@@)(@@) $ 2304 سالم بن عبد الاعلى وقيل ابن عبد الرحمن وقيل ابن غيلان أبو الفيض عن نافع وعطاء قال البخاري تركوه(@)(@@)(@@)(@@) $ 2305 ت(@)(@@) سالم بن العلاء أبو العلاء المرادي وقيل ابن عبد الواحد(@)(@@) عن ربعي بن خراش شيعي قال أبو حاتم يكتب حديثه وقال النسائي ضعيف وضعفه ابن معين أيضا ووثقه ابن حبان(@)(@@)(@@)(@@) $ 2306 سالم بن غيلان شيخ لابن وهب(@)(@@) قال الدارقطني متروك(@)(@@)(@@)(@@) $ 2307 خ د س ق(@)(@@) سالم الأفطس هو ابن عجلان(@)(@@) تابعي مشهور وثقه بعضهم وخرج له البخاري قال الفسوي مرجئ معاند وقال ابن حبان يتفرد بالمعضلات(@)(@@)(@@)(@@) $ 2308 سالم بن مخراق شيخ لمروان بن معاوية مجهول(@)(@@)(@@)(@@) $ 2309 بخ م د ت س(@)(@@) سالم بن نوح العطار عن يونس بن عبيد PageV01P251 صالح الحديث قال أبو حاتم وغيره لا يحتج به وقال يحيى بن معين ليس بشيء ووثقه أبو زرعة وقال أحمد لا بأس به(@)(@@)(@@)(@@) $ 2310 سالم بن هلال(@)(@@)(@@)(@@) $ 2311 وسالم أبو حماد 
ms118	 صاحب السدي(@)(@@)(@@)(@@) $ 2312 وسالم مولى عكاشة شيخ لأبي عاصم(@)(@@)(@@)(@@) $ 2313 وسالم مولى ثابت شيخ للواقدي مجهولون(@)(@@)(@@)(@@) $ 2314 سالم أبو غياث عن انس وعنه النضر بن شميل(@)(@@) قال ابن معين لا شيء(@)(@@)(@@)(@@) $ 2315 سالم أبو العلاء مولى إبراهيم الطائي(@)(@@) تفرد عنه عبد الصمد ابن عبد الوارث(@)(@@)(@@)(@@) $ 2316 د(@)(@@) سالم أبو جميع القزاز عن ابن سيرين(@)(@@) وثقه ابن معين وغيره وقال أبو زرعة لين الحديث(@)(@@)(@@)(@@) $ 2317 السائب الخولاني عن عقبة بن عامر(@)(@@) مجهول(@)(@@)(@@)(@@) $ 2318 سبرة إنسان روى عنه إسماعيل السدي مجهول(@)(@@)(@@)(@@) $ 2319 ست العباد(@)(@@) التي روت بعض الخلعيات تكلم عبد العظيم في سماعها وقال هو بخط غير موثوق به(@)(@@)(@@)(@@) $ 2320 سديف بن ميمون المكي رافضي خرج مع ابن حسن فقتله المنصور له في كتاب العقيلي خبر كذب(@)(@@)(@@)(@@) $ 2321 سدير بن حكيم شيخ للثوري(@)(@@) وثقه ابن معين وقال الدارقطني متروك(@)(@@)(@@)(@@) $ 2322 ق(@)(@@) السري بن إسماعيل عن الشعبي(@)(@@) قال القطان PageV01P252 استبان لي كذبه في مجلس واحد وقال النسائي متروك وقال غيره ليس بشيء(@)(@@)(@@)(@@) $ 2323 السري بن عاصم بن سهل(@)(@@) وقد ينسب إلى جده عن ابن علية قال ابن عدي يسرق الحديث(@)(@@)(@@)(@@) $ 2324 السري بن عبد الله السلمي عن جعفر بن محمد(@)(@@) لا يعرف(@)(@@)(@@)(@@) $ 2325 السري بن عبد الحميد(@)(@@) شيخ لبقية متروك الحديث(@)(@@)(@@)(@@) $ 2326 سريع بن عبد الله مجهول(@)(@@)(@@)(@@) $ 2327 ق(@)(@@) سعاد بن عبد الرحمن وقيل ابن سليمان(@)(@@) عن عون بن أبي جحفية قال أبو حاتم شيعي ليس بقوي(@)(@@)(@@)(@@) $ 2328 خ د ق(@)(@@) سعدان بن بشر أبو مجالد(@)(@@) قال الدارقطني ليس بالقوي وقال أبو حاتم صالح الحديث(@)(@@)(@@)(@@) $ 2329 سعدان بن سعد الليثي عن . . . مجهول(@)(@@)(@@)(@@) $ 2330 سعدان بن يحيى اللخمي(@)(@@) قال الدارقطني ليس بذاك(@)(@@)(@@)(@@) $ 2331 سعدان بن يحيى اللخمي سعيد(@)(@@) قال الدارقطني لا بأس به قلت أراه الأول وللدارقطني فيه عبارتان PageV01P253(@)(@@)(@@)(@@) $ 2332 سعدان بن هشام مجهول(@)(@@) من أهل الرقة(@)(@@)(@@)(@@) $ 2333 سعدان الخلمي عن مقاتل كذلك(@)(@@)(@@)(@@) $ 2334 سعدان القداحي عن عبيد الله العتكي(@)(@@) لا يعرف(@)(@@)(@@)(@@) $ 2335 بخ عه(@)(@@) سعد بن أوس العبسي عن بلال بن يحيى(@)(@@) ضعفه 
ms119	 أبو الفتح الأزدي فقط ووثقه غيره(@)(@@)(@@)(@@) $ 2336 د ت س سعد بن أوس البصري عن مصدع المعرقب(@)(@@) ضعفه ابن معين ووثقه غيره وذكره ابن حبان في الثقات(@)(@@)(@@)(@@) $ 2337 سعد بن حبيب عن الحسن(@)(@@)(@@)(@@) $ 2338 وسعد بن زنبور مجهولان(@)(@@)(@@)(@@) $ 2339 سعد بن زياد أبو عاصم عن سالم(@)(@@) قال أبو حاتم ليس بالمتين(@)(@@)(@@)(@@) $ 2340 م عه خت(@)(@@) سعد بن سعيد الأنصاري أخو يحيى(@)(@@) حسن الحديث تابعي ضعفه أحمد وابن معين(@)(@@)(@@)(@@) $ 2341 ق(@)(@@) سعد بن سعيد المقبري عن أبيه(@)(@@) واه ورمي بالقدر أيضا(@)(@@)(@@)(@@) $ 2342 سعد بن سعيد الجرجاني عن نهشل(@)(@@) قال البخاري لا يصح حديثه(@)(@@)(@@)(@@) $ 2343 سعد بن سعيد الساعدي عن سفيان الثوري(@)(@@) وهاه أبو نعيم(@)(@@)(@@)(@@) $ 2344 د ت ق(@)(@@) سعد بن سنان ويقال ق بخ(@)(@@) سنان بن سعد عن أنس(@)(@@) ضعفوه ولم يترك(@)(@@)(@@)(@@) $ 2345 سعد بن طالب عن حماد(@)(@@) قال أبو حاتم في حديثه ضعف PageV01P254(@)(@@)(@@)(@@) $ 2346 ت ق(@)(@@) سعد بن طريف الاسكاف عن أبي وائل(@)(@@) مجمع على ضعفه واتهمه ابن حبان(@)(@@)(@@)(@@) $ 2347 ت س ق(@)(@@) سعد بن عبد الحميد بن جعفر الأنصاري(@)(@@) عن فليح صدوق قال ابن حبان كان ممن فحش خطؤه فلا يحتج به(@)(@@)(@@)(@@) $ 2348 سعد بن علي أبو الوفاء النسوي القاضي(@)(@@) حدث بالبخاري عن رجل عن الفربري في سنة تسعين وأربعمائة فاتهموه ليس بشيء وتمام المصيبة قال ثني إبراهيم الشرابي ثنا أمير المؤمنين علي وهذا إفك مبين(@)(@@)(@@)(@@) $ 2349 سعد أبو حبيب روى عن يزيد الرقاشي(@)(@@) قال أحمد ليس حديثه بشيء(@)(@@)(@@)(@@) $ 2350 سعيد بن إبراهيم عن قتادة وعنه طالوت شبه مجهول(@)(@@)(@@)(@@) $ 2351 سعيد بن إبراهيم عن ثور بن يزيد(@)(@@)(@@)(@@) $ 2352 وسعيد بن أبي ابيض عن أبي الزناد(@)(@@)(@@)(@@) $ 2353 وسعيد بن إسحاق عن الليث مجهولون وكذا(@)(@@)(@@)(@@) $ 2354 سعيد بن إبراهيم بن معقل اليماني(@)(@@)(@@)(@@) $ 2355 سعيد بن أحمد عن جده زكريا كاتب العمري(@)(@@) وعنه ابن المقرئ قال ابن يونس تعرف وتنكر(@)(@@)(@@)(@@) $ 2356 خ م(@)(@@) سعيد بن أشوع قاضي الكوفة(@)(@@) قال الجوزجاني PageV01P255 غال زائغ وقواه غيره وقال س ليس به بأس قلت وهو سعيد 
ms120	 بن عمرو بن أشوع تلميذ الشعبي(@)(@@)(@@)(@@) $ 2357 ع(@)(@@) سعيد بن إياس الجريري(@)(@@) ثقة مشهور تغير قليلا وضعفه القطان(@)(@@)(@@)(@@) $ 2358 عه(@)(@@) سعيد بن بشير صاحب قتادة(@)(@@) وثقه شعبة وقال البخاري يتكلمون في حفظه وقيل كان قدريا ضعفه أبو مسهر وابن المديني وابن معين و س(@)(@@)(@@)(@@) $ 2359 سعيد بن بشير النجاري عن ابن البيلماني وعنه الليث(@)(@@) لا يعرف له حديث في الذكر(@)(@@)(@@)(@@) $ 2360 سعيد بن بشير عن الحسن مجهول(@)(@@)(@@)(@@) $ 2361 سعيد بن بشير عن عبد الله بن حكيم الكناني(@)(@@) مجهول كشيخه كان بمصر(@)(@@)(@@)(@@) $ 2362 سعيد بن أبي بكر بن أبي موسى(@)(@@) لا يعرف روى حديثا منكرا الآفة ممن بعده(@)(@@)(@@)(@@) $ 2363 سعيد بن ثمامة عن معلى بن هلال(@)(@@) قال الأزدي متروك(@)(@@)(@@)(@@) $ 2364 عه(@)(@@) سعيد بن جمهان الأسلمي عن سفينة(@)(@@) قال أبو حاتم لا يحتج به ووثقه ابن معين وابن حبان PageV01P256(@)(@@)(@@)(@@) $ 2365 سعيد بن جندب تابعي عن أبيه عمر مجهول(@)(@@)(@@)(@@) $ 2366 سعيد بن حريث عن الحسن(@)(@@)(@@)(@@) $ 2367 وسعيد بن حماد من طبقة يزيد بن هارون(@)(@@)(@@)(@@) $ 2368 وسعيد بن حوشب عن الحسن(@)(@@) مجهولون(@)(@@)(@@)(@@) $ 2369 م س ت ق(@)(@@) سعيد بن حسان عن مجاهد(@)(@@) وثقه أبو داود ومرة توقف فيه ووثقه ابن معين(@)(@@)(@@)(@@) $ 2370 ق(@)(@@) سعيد بن خالد بن أبي طويل عن أنس(@)(@@) ضعفه أبو زرعة وغيره له في ابن ماجه حديث حرس ليلة على الساحل أفضل من عمل ألف سنة(@)(@@)(@@)(@@) $ 2371 د س ق(@)(@@) سعيد بن خالد القارظي(@)(@@) عن ابن المسيب صدوق ضعفه النسائي(@)(@@)(@@)(@@) $ 2372 د(@)(@@) سعيد بن خالد الخزاعي عن محمد بن المنكدر(@)(@@) ضعفه أبو زرعة أيضا وقال البخاري فيه نظر(@)(@@)(@@)(@@) $ 2373 ت س(@)(@@) سعيد بن خثيم الهلالي عن يزيد بن أبي زياد(@)(@@) وثقه ابن معين وقال الأزدي منكر الحديث وقال ابن عدي مقدار ما يرويه غير محفوظ PageV01P257(@)(@@)(@@)(@@) $ 2374 سعيد بن خداش عن الحسن مجهول(@)(@@)(@@)(@@) $ 2375 خت(@)(@@) سعيد بن داود الزنبري(@)(@@) عن مالك ضعفه أبو زرعة وغيره وقال ابن معين ليس بثقة(@)(@@)(@@)(@@) $ 2376 سعيد بن دهثم المقدسي(@)(@@) عنه نعيم بن حماد حديثا منكرا(@)(@@)(@@)(@@) $ 2377 