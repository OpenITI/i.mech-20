ms3561	 و من باشم و من باشم و من(@)(@@) (@@) - بودم همه روز غرق آتش چون داغ %~% می سوخت دلم شبهمه شب همچو چراغ(@)(@@) (@@) زنهار مردم پیشان مینشوند %~% گر کور به خانه افتم از خانه بباغ(@)(@@) (@@) - ای ریخته از ستیز کاری %~% خاکم به سر امیدواری(@)(@@) جور و ستم تو داده بر باد %~% ناموس وفا و عرض یاری PageV06P4062(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V06_0602.jpg)(@)(@)(@@) (@@) از لشکر صبر صد زره پوش %~% در چشم تو یک خدنگ کاری(@)(@@) (@@) تا چند کشی به ناکسان می %~% من آب شدم ز شرمساری(@)(@@) (@@) مرگ از غم سینه چاکی من %~% یراهن عافیت قبا کرد(@)(@@) (@@) - چون سرمه کشد ملک به دیده %~% دودی که بر آید از درونم(@)(@@) (@@) جان همچو فراز میکند رقص %~% بر تارک آه نیلگونم(@)(@@) (@@) -بر رهگذرت نهادهام چشم %~% پیوسته چو کاسهآ گدایی(@)(@@) (@@) عشقی که نظر به وصل دارد1 %~% ماند به عیادت زبانی(@)(@@) (@@) عضوی که ز عشق شد شکسته %~% حاجت نبرد به مومیایی(@)(@@) (@@) - در کشور عشق جا گرفتم %~% غم نیست اگر رعایتی نیست(@)(@@) (@@) - دل به راه بداشت و قوتم نیست %~% اوک دارم کمان ندارم(@)(@@) (@@) - بر سستی طالعم مزن طعن %~% من دست بر آسمان ندارم(@)(@@) (@@) - افکنده غمت مرا به بحری %~% کش هر موجیست چون نهنگی(@)(@@) (@@) جایی که عارض تو نقاب از قمر کشد %~% خورشید گردن از پی نظاره بر کشد 7865(@)(@@) (@@) - به کسی از آن نکردم گله تا به غایت از تو %~% که برم به خاک با خود دل پر شکایت از تو(@)(@@) (@@) دوزخ پی عقوبت ما کافران کم است %~% ما را مگر به آتش هجران سزا دهند(@)(@@) (@@) - بر آشیانهآ بلبل نسیم پا زد و گفت %~% که خان و مان اسیران خراب میباید(@)(@@) (@@) - نشان قاتل من والهی مپرس از من %~% به روز حشر ببین تا که شرمسار من است(@)(@@) (@@) - سوخت ما را تب هجران تو چنان کز حسرت %~% دوزخ انگشت کرد بر سر خاکستر ما(@)(@@) (@@) - وقت مردن چشم بگشا والهی سویش ببین %~% راه دوری میروی اندیشه زادی بکن(@)(@@) (@@) - خوش دمی کاندر لحد بی زحمت جان 
ms3562	 والهی %~% در بغل گیرد غمت را و کفن در سر کشد(@)(@@) (@@) - روزی که جهان زنده کند مردهآ خویش %~% جان گرم کند قالب2 افسردهآ خویش(@)(@@) (@@) من لب به شراب زندگی تر نکنم %~% عاقل نکند میل به قی کردهآ خویش(@)(@@) (@@) - در آن مجلس که چشمت فتنهآ اهل نظر باشد %~% بلا بالانشین و عافیت بیرون در باشد PageV06P4063(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V06_0603.jpg)(@)(@)(@@) (@@) از چاک تنم در دل خسته نظری کن %~% نظارهآ صدر بار ز من خستهتری کن(@)(@@) (@@) گر از گهر شگرگری آب از دهان جان چکد %~% ور از مژه به سر زنی خون از رگ ایمان چکد(@)(@@) (@@) ای خونی خونین دلان چندین مرو زین قتلگه %~% کز خون ما هم قطرهای بر خاک این میدان چکد(@)(@@) (@@) خیال قتل که امروز در دلت میگشت؟ %~% که میگذشتی و از غمزهآ تو خون میریخت(@)(@@) (@@) د آمدی بر سر خاک من و شرمنده شدم %~% کاین زمان از پی ایثار تو جان میبایست(@)(@@) (@@) د در این دیار چنان عشق گلرخان تنگ است %~% که بلبلی نکند ناله در گلستانی(@)(@@) (@@) - ز خون خویش بر آن قطره میبرم عشرت %~% که گاه قتل به دامان قاتل افتادهاست(@)(@@) (@@) - دل تسلی نشد از نامه فرستادن، کاش %~% خاک میگشتم و همراه صبا میرفتم(@)(@@) (@@) - چو بهر سوختن اندر شدم به دوزخ عشق %~% هزار شعله به تعظیم من ز جا برخاست(@)(@@) (@@) دعای من اثری داشت تا شدم عاشق %~% اثر به شومی بخت من از دعا برخاست(@)(@@) (@@) به عزم شعله چو آن شاخ گل ز جا برخاست %~% فغان و ناله ز دلهای مبتلا برخاست(@)(@@) (@@) چو ناامید ز کوی تو بار بربستم %~% فغان ز ناقه و فریاد از درا برخاست(@)(@@) (@@) فتاد کشتی من والهی به گردابی %~% که رنگ از رخ تدبیر ناخدا1 برخاست(@)(@@) (@@) -ای پرده ز رخ فکنده چون خور به صبوح %~% بر روی جهان گشوده درهای فتوح(@)(@@) (@@) در کوی تو از کثرت نظارهآ خلق %~% پهلوی نگاهم شده صد جا مجروح(@)(@@) (@@) - مرو ز دیده که یادم ز پیر کنعاناست %~% که روی دوست ندیدن 
ms3563	 به چشم نقصاناست(@)(@@) (@@) سر خیال تو گردم که در دل تنگم %~% هنوز نامده از آمدن پشیمان است(@)(@@) (@@) - در وصال تو نگشود طالع پستم %~% کلید سعی بر آورد زنگ در دستم(@)(@@) (@@) به زندانت رنج مبر، دراز حرمان است %~% گمان مبر که چو مردم ازین مرض جستم(@)(@@) (@@) شوم چو کشته ز من وا مگیر نعمت غم %~% کز اوست قوتم اگر نیستم اگر هستم(@)(@@) (@@) ز سینه بس که کشیدم خدنگ جور تو را %~% به جای آبله پیکان برآید از دستم(@)(@@) (@@) مسوز شمع صفت والهی ز مردن من %~% که گر ز یار بریدم به نور پیوستم(@)(@@) (@@) ز شمع عارضت مجلس چو نورایمن است امشب %~% چراغ چشمم از نور تجلی روشن است امشب PageV06P4064(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V06_0604.jpg)(@)(@)(@@) (@@) - موج اشکم رسیده تا کمر است %~% کشتیم در زیارت خطر است(@)(@@) دوستی را نهفته نتوان داشت %~% عشق رسوا و خسن پرده در است(@)(@@) (@@) سرشک از رخم پاک کردن چه حاصل؟ %~% علاجی بکن کز دلم خون نیاید(@)(@@) (@@) صبا را اگر پی کنی، نیست ممکن %~% که پیغام لیلی به مجنون نیاید(@)(@@) (@@) عجب برقی افروخت هجر تو ترسم %~% که وصل تو از عهده بیرون نیاید(@)(@@) (@@) سر مکش در کمان خدنگ نگه %~% که حریف تو کاغذین سپر است(@)(@@) (@@) از قفس بند آهنین بردار %~% والهی بلبل شکستهپر است(@)(@@) (@@) - خرد چون در سر مجنون نشیند %~% محیطی در حبابی چون نشیند(@)(@@) جراحتهای دل هرگه که بینم %~% نگاهم تا کمر در خون نشیند(@)(@@) (@@) گهی گر بر سرم دست خیالت %~% که مویی بر سر گردون نشیند(@)(@@) (@@) ز سنگ فتنه ایمن نیست علوی1 %~% شود گر کوه و در هامون نشیند(@)(@@) (@@) اگر به عهد قدیمت رسیده نقصانی %~% نیا که تازه2 کنم با تو عهد و پیمانی(@)(@@) (@@) درین دیار چنان عشق گلر خان تگ است %~% که بلبلی نکند ناله در گلستانی(@)(@@) (@@) گر حلقههای چشم ملایک کنیم دام %~% شهباز غمزهآ تو نگردد شکار ما(@)(@@) (@@) گردیم خاک چون به ره جستجوی تو %~% تا حشر بر زمین بنشیند غبار ما787a(@)(@@) (@@) ما کشتگان خنجر عشقیم والهی 
ms3564	 %~% دارد نشان ینجهآ خونین مزار ما(@)(@@) (@@) - گر بوی مرهم تو خورد بر دماغ ما %~% جان سر بر آورد ز گریبان داغ ما(@)(@@) (@@) جایی رسیده ضعف که گر دو کنیم چشم %~% میرد ز باد جنبش مژگان چراغ ما(@)(@@) (@@) - عشق نخلت سرافراخته از بیشهآ ما %~% رشته پیچیده ز هر برگ و ریشهآ ما(@)(@@) (@@) گره از بند نقابت نتوانست گشود %~% با همه سعی، سر ناخن اندیشهآ ما(@)(@@) (@@) بیستون در نظر همت ما خاشاک است %~% سر نیارد به همه سنگ فرو تیشهآ ما(@)(@@) (@@) اگرت حوصلهای هست چو دریای محیط %~% میتوانی که خوری جرعهای از شیشهآ ما(@)(@@) (@@) منع ما والهی از عشق و جنون ممکن نیست %~% عاشفانیم وبولا عشق و جنون پیشهآ ما PageV06P4065(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V06_0605.jpg)(@)(@)(@@) (@@) -کام دل جستن از تو دشوار است %~% گر تو مستی کرشمه هشیار است(@)(@@) (@@) رخ مگردان ز اولین نگهم %~% که غریب دیار دیدار است(@)(@@) (@@) دجور کم کن که عشق اگر این است والهی شکوه از رقیب مکن %~% لطف بر(@)(@@) جان عاشقان یار است %~% نوش با نیش و گنج با مار است(@)(@@) (@@) د برخاستی از خواب و شبم دم ز سحر زد %~% خورشید مگر سر ز گریبان تو بر زد(@)(@@) (@@) گفتم دهد اندیشهآ زلف تو قرارم %~% هر موی تو ماری شد و نیشم به جگر زد(@)(@@) (@@) جان دادم و نشنید کسی نالهآ زارم %~% مضراب من این نغمه به قانون دگر زد(@)(@@) (@@) شد سرخ گل از شرم، مگر باد به گوشش %~% حرفی ز گرفتاری مرغان سحر زد(@)(@@) (@@) هر لاله که زد والهی از دشت، بلا شد %~% دادم دل پر خون منش خنده به سر زد(@)(@@) (@@) - دمی گر با من حیران نشیند %~% نگاهم در سر مژگان نشیند(@)(@@) (@@) نیابد تشنهآ وصل تو تسکین1 %~% اگر در چشمهآ حیوان نشیند(@)(@@) به خود چون گردباد از رشک پیچم %~% اگر گردم بدان دامان نشیند(@)(@@) (@@) گزیند والهی چون با تو خلوت %~% به صد منزل جدا از جان نشیند(@)(@@) (@@) - منم که لعل تو نقل لب مقال من است %~% حدیث عشق تو 
ms3565	 ذکر زبان لال من است(@)(@@) (@@) به سر زدی چو گل ار باد شد شکفته و گفت %~% که آن نهال به صد خوبی نهال من است(@)(@@) ~~به هر غمی غم عشقت کشم به خانهآ دل - آنکه جز تلخی ندید از شکرت کام(@)(@@) من است %~% که هم غم تو تصور کند که مال من است %~% و آنچه هرگز بر زبانت نگذرد نام من است(@)(@@) (@@) شعله را در برگرفتش کار هر افسرده نیست %~% وین دلیری والهی با نشئهآ جام من است(@)(@@) (@@) - نگردم رنجه از دشمن اگر زوبین زند بر من %~% مرا آن گل به درد آرد که یار از کین زند بر من(@)(@@) (@@) ز نافرمانی طالع شود بر آتشم روغن %~% اگر یاری کف آبی پی تسکین زند بر من(@)(@@) (@@) چنان گشتم ضعیف از غم که ریزد پیکرم از هم %~% اگر باد صبا برگ گل نسرین زند بر من(@)(@@) ~~ز غم تلخست کامم، شکرین لب را اجازت ده - چند ریزی آبرویم دین و(@)(@@) ایمان نیستم %~% چند باشی در شکستم عهد و پیمان نیستم %~% که در شور آید و یک خندهآ شیرین زند بر من PageV06P4066(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V06_0606.jpg)(@)(@)(@@) (@@) نهمت آلود وصالم لیک در ایام عشق %~% شرمسار زخم خاری زان مغیلان نیستم(@)(@@) (@@) زان سبب سجادهآ اشک است دامانم که من %~% در نماز دوستی آلوده دامان نیستم(@)(@@) (@@) توش میبخشم به پش ای کعبه رو از من متاب %~% من زلال زمزمم خار مغیلان نیستم(@)(@@) (@@) والهی عهدی که با پیر مغان بستیم دوش %~% گر پشیمانی تو بشکن من پشیمان نیستم(@)(@@) (@@) دگر امروز از شست تغافل تیر میراند %~% به جای شعله آه از دلم شمشیر میراند(@)(@@) (@@) به صد لخت جگر آتش است این دیده گریان %~% که از لعلت چرا طفل تبسم دیر میراند(@)(@@) (@@) چنان عشق تو با هم داده الفت کفر و ایمان را %~% که بیخود از لب ناقوس من تکبیر میراند(@)(@@) (@@) دمتخواهی که باشد گرم در آتش فکن خود را %~% که از دلهای ناسوز آه بی تأثیر میراند(@)(@@) (@@) ببینم گر 
ms3566	 بسوزش1 والهی از شرم معذورم %~% که از چشمم نگاه افکنده سر در زیر میراند(@)(@@) (@@) - قبای گریه کند شب چو دیده در بر من %~% کلاه شعله نهد دلت آه بر سر من(@)(@@) (@@) دلم به گوشهآ ابرو بتر شدش احوال %~% اگر بساط دو عالم در آید از در من(@)(@@) (@@) از بس که داده غمم لقمههای زهر آلود %~% مگس ز بیم نگردد به گرد شکر من(@)(@@) (@@) - ما چو تیریم و زبان آتشین پیکان ما %~% مدعی خوش باشد ار داری سر میدان ما(@)(@@) (@@) همچو شیران شکاری برنگردیم از مصاف %~% تا بهخون رنگین نگردد ناخن و دندان ما(@)(@@) (@@) - به خاک حسرت آن غمزه خون برد دل ما %~% به جای لاله دمد زخم تازه از گل ما(@)(@@) (@@) ز کشته گشتن ما گر چه سوختند بسی %~% ولی نسوخت کسی بیشتر ز قاتل ما(@)(@@) (@@) مگو که شاد چرا آمدم، غمین رفتم %~% که نور، نار شود در هوای منزل ما(@)(@@)(@@)(@@) | 3352)(@)(@@) [محمد واصل بن جمال الدین تته](@)(@@) ~~عرفهآ زبدة الانام، محمد واصل بن جمال الدین تته. خالی از طبیعت درستی نیست، در سنهآ(@)(@@) ~~هزار و بیست و شش او را در منداو به اردوی جهانگیر پادشاهی دیدیم. او راست: 7520 PageV06P4067(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V06_0607.jpg)(@)(@)(@@) ~~ز راهت مشت خاکی در گریبان نفس ریزاگر آرد صبا دامان گل بر خار و خس ریزم(@)(@@) ~~جهان، فرسوده اجزای وجود بیثبات منه سر خاک عدم از سایهآ بال مگس ریزم(@)(@@) ~~هزاران کاروان اشک میخواهم که چون واصلگدازم آتش قلب و دل و از وی جرس ریزم(@)(@@) (@@) 5 هر گریه کز جفای تو مستانه سر کنم %~% اوراق کارنامهآ اعمال تر کنم(@)(@@) - هر چند بجویمش آلم افزاید هر گه چو نور صبح بیایی ز روزنم %~% چندان(@)(@@) که بخواهمش ستم افزاید %~% ببینم تو را و سجدهآ شکر سحر کنم(@)(@@) از خلوت سینهام خیال لب او %~% چون طایر دام دیدهام افزاید(@)(@@)(@@)(@@) | 3354](@)(@@) [نورالدین حسین واضحی در گزینی](@)(@@) ~~عرفهآ صاحب کمالی در آن واضحی و دلنشینی، نورالدین حسین ستانی واضحی درگزینی.(@)(@@) ~~ستان قریهای 
ms3567	 است از قرای درگزین مذکور، و وی را در اجمیر سنهآ 1025 دیدیم، این چند(@)(@@) ~~بیت از او گرفته نوشته شد، مردی درویش است1، هم ستانی و هم واضحی تخلص میکند.(@)(@@) ~~هشتاد و کسری از عمرش گذشته بود، هم در آنجا فوت شد. و له:(@)(@@) (@@) - غنچهآ سر بستهام، باد سحر گم کردهام %~% خشک لب گشتم که میگویی مطرگم کردهام(@)(@@) (@@) سرو در باغم ندارد آب و تاب خوشدلی %~% باغبانم سازگل پیرانه سر گم کردهام(@)(@@) (@@) استخوانم را بسی داغ جنون خاکستر است %~% بلبل سرگشتهام راه گذر گم کردهام(@)(@@) (@@) چاکها دارم به دل از مهر مه رویان بسی %~% سوزن الماس عیسی در جگرگم کردهام(@)(@@) پادشاها، خلیفهآ بر خلق واضحی هرگز ندیدم مهربانی در جهان %~% سردار(@)(@@) سجدهات به جا آرم %~% ناتوان مورم که راه دادگر گم کردهام(@)(@@) هر کسی تحفهای به سر دارد %~% ن به جان تحفهآ دعا آرم(@)(@@) شه ز مدح صفات مستغنی است %~% ه که بیتی به مدعا آرم PageV06P4068(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V06_0608.jpg)(@)(@)(@@) (@@) ز کرم شه زراعتم بچمید %~% گاو و تخم وی از کجا آرم(@)(@@) ~~و دو نیمه مثنوی گفته، از جمله در خاکنامه آورده:(@)(@@) (@@) آنکه بر شاهان عالم سرور است %~% شه جلال الدین محمد اکبر است(@)(@@) (@@) خاک آمد کیمیای هر وجود %~% در ظریف هر وجود خاک بود(@)(@@)(@@)(@@) | (3355)(@)(@@)(@@)(@@) | [والی هندی](@)(@@) ~~عرفهآ والی سپهر اعظم بی شعوری، [والی]. از تازه گویان هند بوده و در زمان اکبر پادشاه در(@)(@@) ~~گذشته. و له:(@)(@@) (@@) والی به بشکزن آشنا باش %~% کین داغ به پنبه به شدن نیست(@)(@@)(@@)(@@) | 3356)(@)(@@)(@@)(@@) | [واسع تتوی](@)(@@) ~~عرفهآ صاحب فطرت واسع، واسع تخلص. از تته است. وله:(@)(@@) (@@) - دلم ز عشق رخ دلبرست درگاهش %~% که آفتاب ازو نور میکند خواهش(@)(@@) (@@) - از درد فغانم چو به گوش چمن آید %~% بلبل نکند ناله چو آواز من آید(@)(@@)(@@)(@@) | 23357(@)(@@)(@@)(@@) | [وارشی اردبیلی](@)(@@) ~~عرفهآ وارث صفات جمیلی، وارثی اردبیلی. از شعرای مقرر زمان خود بوده. و له:(@)(@@) ~~وارنی را بارها کفم که ترک دونست کر پهد من نشنید چندان که دشمن کام 
ms3568	 شد PageV06P4069(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V06_0609.jpg)(@)(@)(@@) [ملا وارشی سبزواری](@)(@@) ~~عرفهآ باعث کمالات بیباعثی، ملا وارثی. از سبزوار است و برادر کامی سبزواری. شعر(@)(@@) ~~بسیاری گفته است و سخن استادان متقدم بسیار جمع نموده، بنده او را دیدهام با این همه(@)(@@) ~~تتبع قدما به روش خام شعر میگوید، اما بسیار میگوید، کیفیت را به کمیت افزوده. و له:(@)(@@) (@@) در دستم ساغر می ناب %~% خون گشت ز بخت وازگونم(@)(@@) (@@) بیماست که عالمی بسوزد %~% زین شعله که خاست از درونم(@)(@@) (@@) -گر با من نیست سر جنگ %~% چوناست بر ابروانت آژنگ(@)(@@) (@@) در خاک میفکنم که بستم %~% چون گوهر قیمتی گران سنگ(@)(@@) (@@) دل بی طرف است و جام لبریز %~% راهم دور است و مرکبم لنگ(@)(@@) (@@) - چه بی دردانه آهی میکشی ای وارثی هر دم %~% تو عاشق نیستی، بیهوده رسوا میکنی خود را(@)(@@)(@@)(@@) | 3355)(@)(@@)(@@)(@@) | (مولانا وامقی](@)(@@) ~~عرفهآ وامق عذرای عاشقی، مولانا وامقی. از عاشقان صادق زمان است. و له:(@)(@@) (@@) تا کی کنم رفو جگر پارهپاره را %~% مرهم چه سان نهم دل الماس خواره را(@)(@@)(@@)(@@) | [3360)(@)(@@) [خواجه وجیه الدین کجراتی](@)(@@) ~~عرفهآ جامع کمالات علمی و عینی، سالک مسالک دینی و یقینی، خواجه وجیهالدین در(@)(@@) ~~گجرات به سرکرده، بقعهآ شریف وی آنجاست، به غایت صاحب حال و طی کردهآ مراتب(@)(@@) ~~قال بوده. وله: PageV06P4070(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V06_0610.jpg)(@)(@)(@@) ~~سر بر آوردی به دولت پایمردی کن به لطفدسترس دادت خدا، افتادگان را دست گیر(@)(@@) (@@) کا ین همان چرخ است کزنوشیروان بربود تاج %~% و ین همان دهرست کز شاه اردوان بستد سریر(@)(@@)(@@)(@@) | 3361(@)(@@) [محمد امین وجدی کرمانی](@)(@@) ~~عرفهآ محمد امین وجدی کرمانی. از اهل این عصر و زمان است. و له:(@)(@@) (@@) - بیچاره1 دلم که درد فرقت دارد %~% در عشق بتان تاب مشقت دارد 788a(@)(@@) (@@) از هجر نشد کباب و از رشک نسوخت %~% یک قطرهآ چون این همه طاقت دارد(@)(@@) (@@) - از دیدنم مرنج که از ذوق باغبان %~% هر دم به گلستانش بود دیدن دگر(@)(@@)(@@)(@@) | 3362](@)(@@)(@@)(@@) | (وجیه حیدر آبادی](@)(@@) ~~عرفهآ رند مجردی در آن نامرادی، وجیه حیدر آبادی. جوانکی است، مدتها 
ms3569	 در گلکنده به(@)(@@) ~~ملازمت محمد قلی قطبشاه میبود، و بعد از وی قلندر شده، بسیارگشت. در سنهآ 1025(@)(@@) ~~در اجمیرش دیدم. وله:(@)(@@) ~~مردم ز زهر یار، دو زلفت سیاه دوست ای غم به زهر مهره حالش خبر بده(@)(@@) (@@) گر عاشقی ز هر دو جهان دست و دل بشوی %~% یا در طریق عشق نگهدار و سر بده(@)(@@)(@@)(@@) | 3363)(@)(@@)(@@)(@@) | [وجهی تفریشی](@)(@@) ~~عرفهآ سرمست رحیق بیغشی، وجهی تفریشی. در عهد اکبر شاه به هند آمده، مدتها PageV06P4071(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V06_0611.jpg)(@)(@)(@@) ~~احدی بوده، گویند مردی نامراد شکفته خاطر وجیه بوده. و که.(@)(@@) چو خویت خون من بر خاک ریزد %~% از آن خون قطرهای بر خاک ریزد(@)(@@) از آن خاک و از آن خون هر چه روید %~% ه تو درد دل من باز گوید(@)(@@) - یا رب ز می عیش ایاغت روشن %~% وز چشمهآ حیوان گل باغت روشن(@)(@@) از مهر سعادت و فروغ اقبال %~% چون نور دم صبح چراغت روشن(@)(@@)(@@)(@@) | 64(@)(@@)(@@)(@@) | [مولانا وجهی کرد](@)(@@) ~~عرفهآ الواصل الکامل، المدقق المحقق، مستجمع فضل دانشمندی وارجمندنی، مقبول(@)(@@) ~~خاطر بزرگ و خرد ملا و جهی کرد. از فضلای عظام و علمای کرام بود، و از جمله شاگردان(@)(@@) ~~خوب مولانا میرزا جان شیرازی است. در شیوهآ خوش طبعی و هزل و بذل سنجی به غایت(@)(@@) ~~خیره و طیره بوده، از جمله حماریه تصنیف کرده، چندین دستار بر دستار هم پیچیده بر سر(@)(@@) ~~میگذاشت1 و دو دندان دراز بر دهن از چوب میبست و بالشی بر پشت گذاشته قوز(@)(@@) ~~میگردید و با آن قد کوتاه وضعی مضحک ساخته به درس آن کتاب در تعلیم روش وطی(@)(@@) ~~حمار در مجالس اشتغال مینمود. در مطایبات بی مثل است، همیشه در شیراز با طلبه و(@)(@@) ~~اعزه به سر میکرد، و به غایت معزز و مکرم بود. رباعیات عالی با مزهآ بزرگانه گفته، تا(@)(@@) ~~قریب هزار و ده باقی بود. وجهی بروجردی نیز بوده است غیر وی و وجهی هروی هم(@)(@@) ~~هست. وله:(@)(@@) - ما آرزوی می دو ساله نکنیم 
ms3570	 %~% جز خون دو دیده در پیاله نکنیم(@)(@@) صد آه فرو خوریم و ناله نکنیم %~% تا قسمت خود به کس حواله نکنیم(@)(@@) - به کوی تو هرگز گذاری نکردم %~% که افغان تو بیاختیاری نکردم(@)(@@) شب وصل چندان حیا مانعم شد %~% که اظهار بوس و گناری نکردم PageV06P4072(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V06_0612.jpg)(@)(@)(@@) (@@) - دل گرگ و نگاه گرگ بازش گیرد %~% بند از پی امتحان درازش گیرد(@)(@@) (@@) گر جانب کس رود به خاکش بکشد %~% ور جانب او رود به نازش گیرد(@)(@@) (@@) - می گفتم عشق و میندانستم چیست %~% میگفتم یار و میندانستم کیست(@)(@@) (@@) گر عشق اینست چون توان با او بود %~% ور یار اینست چون توان بی او زیست(@)(@@) (@@) ای یاد تو از حشمت و جاه دگران %~% افتاده چو سایه در پناه دگران(@)(@@) (@@) سر گرم نمیکند کلاه دگران %~% کوتاه ببند خر ز کاه دگران(@)(@@) (@@) دی پیر مغان آتش وصحبت افروخت %~% ایمان مرا دید و دلش بر من سوخت(@)(@@) (@@) از خرقهآ کفر رقعهواری بشکافت %~% آورده بر آستین ایمان دوخت(@)(@@) ~~و در روز سه شنبه آخر رجب 996 در شیراز در شاه داعی بودم که هجومی عظیم در سیر(@)(@@) ~~آنجا شده بود، اتفاق صحبتی افتاد، گفت: دی روز از نزد مولانا مؤمن حسین رباعی فرستاده(@)(@@) ~~شده، جواب گفتهام و البته شما نیز فکری کنید چون به شنیدن هر دو رباعی مشرف شدم(@)(@@) ~~در همانجا گفتم که رباعی اولین از مولانا مؤمن حسین است و دویم از او که جواب گفته و(@)(@@) ~~سیوم از بنده که محاکمه است:(@)(@@) (@@) - نتوان به خدا رسیدن از علم کتاب در وادی معرفت براهین حکیم %~% حجت(@)(@@) نبرد راه به اقلیم صواب %~% چون جادههاست در چراگاه دواب(@)(@@) (@@) - هر چند که خرابست از روی حساب %~% از همچو منی یا چو تویی عرض جواب(@)(@@) (@@) خوش باش که عاقبت برد راه بدو %~% سرگشتهآ وادی ز چراگاه دواب(@)(@@) (@@) -تا مبدأ فیض اگر به راهست حساب %~% فارغ کندت زکسب تعلیم کتاب(@)(@@) (@@) فرق است میان کسب دوچندان چندان %~% کز دانش آدمی و ادراک دواب 
ms3571	(@)(@@)(@@)(@@) | 336(@)(@@) ~~آزر آوسست: PageV06P4073(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V06_0613.jpg)(@)(@)(@@) (@@) ای دل بیا که دست در آغوش هم کنیم %~% در خون نشستن از تو و از ما گریستن(@)(@@)(@@)(@@) | [وجهی هروی](@)(@@) ~~عرفهآ بریدهآ عرصهآ جریدهروی، وجهی هروی. مرد نامراد سیاحی است، مدتی شد که در(@)(@@) ~~هند است وبه خدمت ظفرخان ولد زین خان میباشد، درگجرات او را دیدیم، طبعی 7870(@)(@@) ~~روان دارد و شعر بسیاری میگوید، ابیات خوب بسیار از او سر میزند، اکنون در پتنه(@)(@@) ~~همچنان در ملازمت وی است. و له:(@)(@@) (@@) - به نیم چشم زدن آنچه کرد مژگانت %~% هزار سال به دل کاوش سنان نکند(@)(@@) (@@) - درد تو غلو کرد و دل از سینه گریخت %~% صبر از پی دل چو مهر از کینه گریخت(@)(@@) (@@) آن طفل محبتم که در مکتب عشق %~% از شومی من ز هفته آدینه گریخت(@)(@@) (@@) - وجهی قدح بادهآ نابی به کف آر %~% چون ساغر گل جام شرابی به کف آر(@)(@@) (@@) از ظلمت غم، روز امید تو شب است %~% در تیره شب غم، آفتابی به کف آر(@)(@@) (@@) - من دل به فریب چشم مستت ندهم %~% جان را به لب بادهپرستت ندهم(@)(@@) (@@) ای در پی دل فتاده، برگرد که من %~% صد پاره کنم دل و به دستت ندهم(@)(@@) (@@) - چو برق از جگر آتشین دهم خنده %~% چو صبح از نفس واپسین، برافروزم(@)(@@) (@@) - موافقت نپذیرد دو صوت و یک پرده %~% به غیر مطرب و ساقی که بریک آهنگند(@)(@@) (@@) - دور شو از سرم ای ابر، کهاین خشک گیا %~% قابل تربیت قطرهآ رحمت نبود(@)(@@) (@@) - شب جور توبه در قدح افکندهام ولی %~% امروز بین که روزه به می باز کردهام(@)(@@) (@@) - چهسان پرواز رفتن از سرکویت کند مرغی %~% که گر بر هم زند پر، سایه بر وی دام میگردد(@)(@@) (@@) - به مخموری که چون خمیازه برخمیازه میغلطد %~% بشارتگونهای از ساغرصهبا که خواهدگفت؟(@)(@@) (@@) فرامشکار خونریز مرا در عین بدمستی %~% ز بیدلان حرفی جز استغنا که خواهد گفت؟(@)(@)PageV06P4074(@)(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V06_0614.jpg)(@)(@)(@@) (@@) - به نزد همت ما هر دو کون کم ز خس است %~% حیات خضر و 
ms3572	 مسیح در حیات ما نفس است(@)(@@) (@@) - به کوی دوست به دریوزهآ لقا رفتم %~% چو عطر گل به هم آغوشی صبا رفتم(@)(@@) (@@) شکستهام قدم صدق را به پای طلب %~% نه چون کلیم به طور از پی دعا رفتم(@)(@@) (@@) - به خاطری که تویی شوق را غلویی هست %~% محبتی و امیدی و آرزویی هست(@)(@@) (@@) هزار زخم به دل خوردم و ندانستم %~% که چاک سینهآ عشاق را رفویی هست(@)(@@) (@@) - آتش ز جای میجهد و میکند فغان %~% سو زی مگرز عشق تو درجان آتش است؟(@)(@@) (@@) - وجهی رخ اندیشه به زانو چه نهی %~% هر آینه را به سوی خود رو چه نهی(@)(@@) (@@) از سلسلهآ زلف پری رخساران %~% صد بند بلا بر سر هر مو چه نهی(@)(@@) (@@) - هان وجهی اگر تو عاشقی دردت کو %~% سوز دل و آه دردپروردت کو(@)(@@) (@@) سیمای محبت به رخ زردت کو %~% گیرم که تهمتنی، هماوردت کو(@)(@@)(@@)(@@) | حکایت(@)(@@) ~~در شهور هزار و نوزده جمعی از شعرارا در گجرات، قادری پانیپتی به منزل برده بود، چون(@)(@@) ~~ملا محمد زاری1 و مثل مولانا محمد صوفی و وجهی هروی و غیره، وجهی در شعرهای او(@)(@@) ~~دخل کرده و حرفهای رکیک در میانه گفت و شنید شد، و خوش طبعیهای سرشار بی مزه از(@)(@@) ~~اعتدال بیرون از جانبین میرسید، پس قادری حب السلاطین به خورد وجهی داده، وجهی(@)(@@) ~~نیز دیوان شعر او را گرفته بر آن پرداخته ملوث کرد، لهذا من گفتم:(@)(@@) (@@) ای قادری دیو دل غول زبان %~% وجهی که زند سنگ رید2 گاه بیان(@)(@@) ~~دیوانه نشانه، خوش تو را بر دیوان(@)(@@)(@@)(@@) | 3367)(@)(@@) [مولانا کمال الدین وحشی بافقی](@)(@@) ~~عرقه افصح المکلمین، ابنع المتأخرین، املح البلغا، اشهر الفصحا، خلاصة الشعرا، PageV06P4075(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V06_0615.jpg)(@)(@)(@@) ~~کدخدای اقلیم سخنوری، استاد کارخانهآ معنی پروری، شیر بیشهآ سخن، نافهآ غزال ختن،(@)(@@) ~~ادیب دبستان عاشقی، شهیدی یا شاهد توفیق در عین موافقی، مولانا کمال الدین وحشی(@)(@@) ~~بافقی. ارشد انام و استاد کلام است، صاحب روش تازه و ملاحت بی اندازه است، در صید(@)(@@) ~~سخن چون شیر 
ms3573	 نخجیر انداز، و در هوای معانی چون عقاب در پرواز بوده است. سلیمان(@)(@@) ~~طبعش را جن و انس خیال مسخر، محیط فکرش را نا خس و خاشاک از گوهر، الحق از(@)(@@) ~~متأخرین تا غایت هیچ کسی به درست کلامی و جامعیت شاعری و تازه گویی او نبوده،(@)(@@) ~~اشعار او خصوص غزلیات هه حال اوست، هر چه از مطلوب می دیده به نظم میآورده،(@)(@@) ~~لهذا این قدر مؤثر است. کلیات او را بنده نه هزار بیت جمع کردهام، مبنی بر قصاید غرا و(@)(@@) ~~مغازلت و ترجیعات و ترکیبات از مدایح و اهاجی و مقطعات و رباعیات و مثنویات، چون(@)(@@) ~~ناظر و منظور و خلد برین که تمام کرده و فرهاد و شیرین که عالمگیر شده اما ناتمام است و(@)(@@) ~~یک هزار و صد و پنجاه بیت باشد.(@)(@@) ~~ملا1 وحشی برادر کو چک مرادی بافقی است و هر دو از شاگردان مولانا شرف الدین علی(@)(@@) ~~بافقی اند، وقتی که مولانا محتشم طنطنهآ شاعریش قاف تا قاف گرفته بود، او در برابر بر(@)(@@) ~~آمده و طرز نوی در عرصه آورده، هم در زمان حیات او طرز او را منسوح گردانید. بنده در(@)(@@) ~~بدایت حال تتبع روش او خصوص در غزل بسیار کردهام، و وی در دارالعبادهآ یزد رحل(@)(@@) ~~اقامت فکنده مداحی 789a اولاد شاه ولی بسیار کرده، و قاسم بیگ قسمی از شاگردان و(@)(@@) ~~مربی او بود. مضجع وی در یزد بر در پیر برج است قریب به حصار شهر، و وی عرقی تندی(@)(@@) ~~نوشید وخلعت نشئهآ بقا پوشید، لهذا به تاریخ فوت او من گفتهام در اوایل حال2:(@)(@@) ~~چو سر مستانه وحشی باده نوشید از خم وحدت(@)(@@)(@@)(@@) | روان شد روح پاک او به مستی سوی علیین(@)(@@) ~~من از پیر مغان تاریخ فوت او طلب کردم(@)(@@)(@@)(@@) | بگفتا هست تاریخش (وفات وحشی مسکین)91 PageV06P4076(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V06_0616.jpg)(@)(@)(@@) ~~عرصه واویه /غرفهآ متأخرین(@)(@@) (@@) و او راست: اثر شیوه منظور کند هر چه کند %~% مثل این فتنه نخست از 
ms3574	 طرف ناظر نیست(@)(@@) (@@) دیده گستاخ نگاهاست بر آن مست غرور %~% در کمینگاه نظر غمزه مگر حاضر نیست(@)(@@) (@@) همه جا جلوه حسن تو و مشتاق جمال1 %~% همه تن دیده و بر نیم نظر قادر نیست(@)(@@) (@@) خانه پر بود از متاع درد2 این دیوانه را %~% سوخت عشق خانه سوز اول متاع خانه را(@)(@@) (@@) خواه آتش گوی و خواهی قرب، معنی واحدت %~% وصل2 شمع است اینکه خاکستر کند پروانه را(@)(@@) (@@) هرچه بینی آخری دارد به غیر از حرف عشق %~% کاین همه گفتند و آخر نیست این افسانه را(@)(@@) (@@) گرد ننشیند به طرف دامن آزادگان %~% گر بر اندازد فلک بنیاد این ویرانه را(@)(@@) (@@) می ز جام4 عشق خوردن کار هر بی ظرف نیست %~% وحشیی باید که بر لب گیرد این پیمانه را(@)(@@) (@@) - دلیریی که دلم کرد و میزند در وصل5 %~% به اعتماد نگههای رغبت انگیز6 است(@)(@@) مریض طفل مزاجند عاشقان ورنه %~% علاج درد تغافل دو روز پرهیز است(@)(@@) (@@) - گر چه می دانم که میرنجی و مشکل میشود %~% گر نکوبی حلقه صد جا بر در دل میشود(@)(@@) (@@) - کاری مکن که رخصت آه سحر دهم %~% این تندباد را به چراغ تو سر دهم(@)(@@) آبم ز جوی تیغ تغافل مده، مباد %~% نخلی شوم که خنجر الماس بر دهم(@)(@@) (@@) - هرگز میان عاشق و معشوق بعد نیست %~% صدساله راه قافله گو در میانه باش(@)(@@) (@@) - نه گریهای در دل گره، نه نالهای نزدیک لب2 %~% یا رب نصیب من مکن این است اگر آسودگی(@)(@@) (@@) - دعاهای سحر گویند میدارد اثر، آری %~% اثر می دارد اما کی شب عاشق سحر دارد(@)(@@) (@@) - شب ما را به در صبح نه آن قفل زدند %~% گر به مفتاح دعاهای سحر بگشاید(@)(@@) (@@) همه را کشت، بگویید که با خاطر جمع %~% این زمان باز کند تیغ و کمر بگشاید(@)(@@) (@@) - گلش درهم شکفت آن بی مروت بین که میخواهد %~% چنین فصلی در بستان به روی دوستان بندد(@)(@@) (@@) - لازمهآ عاشقیست رفتن و دیدن زدور %~% ورنه ز نزدیک هم رخصت دیدار هست 
