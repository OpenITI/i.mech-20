ms101	(@)(@@) % أحمي بجهدي في الهوى جلدي % % واللحظ منه يبيح ما أحمي % % PageV01P396 21(@)(@@) % من منصفي من جور حاجبه % % ولحاظه عن قوسه ترمي % % 22(@)(@@) % وحلا ومر وتجنيا وجنى % % يا شهده لم شيب بالسم % % 23(@)(@@) % الخمر ريقته وقد عذبت % % ما كل خمر مزة الطعم % % 24(@)(@@) % وإذا شفت شفة غليل صد % % فالظلم صدكه عن الظلم % % 25(@)(@@) % أقنعت من برق الحمى سحرا % % ونسيمه بالشيم والشم % % 26(@)(@@) % ورضيت من نعم وإن مطلت % % بنعم ونعمى تلك من نعم % % 27(@)(@@) % وبلغت من عظم الشكاة مدى % % فيه المدى بلغت إلى العظم % % 28(@)(@@) % فإلام تشكو الظلم من زمن % % يتهضم الأحرار بالظلم % % 29(@)(@@) % تأتي نوائبه منبهة % % وتمر كالمرئي في الحلم % % 30(@)(@@) % لا تخفض اسمك وارتفع حذرا % % فعلا تصرفه يد الحزم % % PageV01P397 31(@)(@@) % سم نفسك العلياء واسم بها % % في بغية الدنيا عن الوسم % % 32(@)(@@) % حتى متى تظما إلى ثمد % % أيقنت أن وروده يظمي % % 33(@)(@@) % فدع التيمم بالصعيد ففي % % كنف الإمام شريعة اليم % % 34(@)(@@) % ملك ليالي النائبات به % % تجلى وتخضب أزمن الأزم % % 35(@)(@@) % ورأى الورى الوجدان من عدم % % في عصره والوجد من عدم % % 36(@)(@@) % أوصافه بالوحي نعرفها % % فصفاته جلت عن الوهم % % 37(@)(@@) % تسمو بلثم تراب موكبه % % فلقد سمت يده عن اللثم % % 38(@)(@@) % ما كنت تبصر نفع موكبه % % لولا تواضعه من العظم % % 39(@)(@@) % النجم منزله ومنزله % % للوحي منزل سورة النجم % % 40(@)(@@) % من معشر آساس ملكهم % % صينت قواعدها عن الهدم % % PageV01P398 41(@)(@@) % من كل سامي الأصل سامقه % % زاكي الخليقة طاهر الجذم % % 42(@)(@@) % شم المعاطس عزهم أبدا % % قمن بذل معاطس الشم % % 43(@)(@@) % المنهبون الوفد وفرهم % % والمشترون الشكر بالشكم % % 44(@)(@@) % قوم يرون إذا هم اجتمعوا % % تفريق ما غنموا من الغنم % % 45(@)(@@) % خفوا إلى فعل الجميل فما % % يستثقلون تحمل الغرم % % 46(@)(@@) % حمر النصال جلوا ببيضهم % % ظلمات ظلم الأزمن الدهم % % 47(@)(@@) % وخطابهم في كل داهية % % يقتاد أنف الخطب بالخطم % % 48(@)(@@) % إرث النوبة بل خلافتها % % في يوسف المستنجد القرم % % 49(@)(@@) % كالبدر نورا والهزبر سطا % % يوم الهياج وليلة التم % % 50(@)(@@) % لا بالجهام ولا الكهام إذا % % نوب الزمان عرت ولا الجهم % % PageV01P399 51(@)(@@) % لو للسيوف مضاء 
ms102	 عزمته % % ويراعه أمنت من الثلم % % 52(@)(@@) % وإذا المنى عقمت فنائله % % شافي العقام وناتج العقم % % 53(@)(@@) % الدين مرتبط بدولته % % والدهر تابع أمره الحزم % % 54(@)(@@) % لوليه من فيض نائله % % فيض الولي ونائل الوسمي % % 55(@)(@@) % قسما نصيب من الوفاء به % % أوفى النصيب وأوفر القسم % % 56(@)(@@) % للحق ما يرضيك من عمل % % والحكم ما تمضيه من حكم % % 57(@)(@@) % أما الطغاة فقد وسمتهم % % ووصمتهم بالذل والرغم % % 58(@)(@@) % بين الزجاج تصدعوا شعبا % % صدع الزجاج لوقعة الصدم % % 59(@)(@@) % للوقد أنفسهم وسمعهم % % للوقر والأعناق للوقم % % 60(@)(@@) % إغمد حسامك في رقابهم % % فالداء مفتقر إلى الحسم % % PageV01P400 61(@)(@@) % آزرت ملكك بالوزير فمن % % شروا كما في العزم والحزم % % 62(@)(@@) % يحيى الذي أضحى بسيرته % % حي المحامد ميت الذم % % 63(@)(@@) % كبرت وجلت فيك همته % % فله بنصحك أكبر الهم % % 64(@)(@@) % هو حاتمي الجود ليس يرى % % إسداء نائله سوى حتم % % 65(@)(@@) % فليهننا أنا لملكك في % % زمن يرد شبيبة الهم % % 66(@)(@@) % وهناك أنك بين أظهرنا % % خلف النبي ووارث العلم % % 67(@)(@@) % وكما وزنت عيار فضلك بالإفضال % % زنت العلم بالحلم % % 68(@)(@@) % بمكارم لك عرفها أبدا % % فينا ينم وعرفها ينمي % % 69(@)(@@) % ما روضة غناء حالية % % وشيا تحليه يد الرقم % % 70(@)(@@) % فعرائس الأغصان قد جليت % % في زهرها بالوشي والوسم % % PageV01P401 71(@)(@@) % وتمايلت أزهارها سحرا % % بنسيمه المتمارض النسم % % 72(@)(@@) % فلكل نور نور ثاقبه % % ولكل ناجمة سنا نجم % % 73(@)(@@) % دران من طل على زهر % % يا حسنه نثرا عملي نظم % % 74(@)(@@) % إذ كل هاتفة وهاتنة % % مشغولة بالسجع والسجم % % 75(@)(@@) % فالورق في نوح وفي طرب % % والوجد في بوح وفي كتم % % 76(@)(@@) % بأتم حسنا من صدائح لي % % فيكم منزهة عن الوصم % % 77(@)(@@) % درية الإشراق مشرفة الدري % % بل مسكية الختم % % 78(@)(@@) % تجري وتفتح من سلاستها % % صم الصفا ومسامع الصم % % 79(@)(@@) % يغنى الطروب عن الغناء بها % % وابن الكريم عن ابنة الكرم % % 80(@)(@@) % لطفت وطالت فهي جامعة % % عظم الحجا ولطافة الحجم % % PageV01P402 81(@)(@@) % ولكم سحبت الذيل مبتهجا % % حيث الرجاء مطرز الكم % % 82(@)(@@) % مستنزر جم الثنهاء إذا % % قابلته بعطائك الجم % % 83(@)(@@) % لم يخط منذ أصببت خدمتكم % % أغراض أغراضي بكم سهمي % % 84(@)(@@) % ولرب مجد 
ms103	 قد أضفت إلى % % ما نلت من خال ومن عم % % 85(@)(@@) % فالدهر يصرف صرفه بكم % % ويكف كف البسط عن غشم % % 86(@)(@@) % ولئن نطقت بكم وفوصفكم % % محيي الجماد ومنطق البكم % % PageV01P403 البحر : رمل تام 1(@)(@@) % اسم محبوبي سداسي إذا % % سقط الثلث فعكس الكلمه % % 2(@)(@@) % وإذا قدم ثاني شطره % % فهو سلطان لنا ذو عظمه % % 3(@)(@@) % ومتى ينقص ثانيه فلا % % نقص يبدو في بناه المحكمه % % 4(@)(@@) % عربي عجمي نصفه % % كله معنى لمن قد فهمه % % 5(@)(@@) % وإذا ساهم في تصحيفه % % لك باقيه فرم أن تفهمه % % 6(@)(@@) % وهو إن شاءهم لكنه % % فيه أيضاح لهذي المبهمه % % PageV01P404 البحر : طويل 1(@)(@@) % وأترجة صفراء لم أدر لونها % % أمن فرق السكين أم فرقة السكن % % 2(@)(@@) % بحق علتها صفرة بعد خضرة % % فمن شجر بانت وصارت إلى شجن % % PageV01P405 البحر : مجزوء الرجز 1(@)(@@) % أبصرني مبلبلا % % وفي الغرام ممتحن % % 2(@)(@@) % فقال من قاتله % % قلت له قائل من % % PageV01P406 البحر : متقارب تام 1(@)(@@) % تذكرت في جلق داركم % % بمصر فيا بعد ما بيننا % % 2(@)(@@) % وما أتمنى سوى قربكم % % وذلك والله كل المنى % % 3(@)(@@) % يدل نسيمكم بالأريج % % علكيم وبرقكم بالسنا % % 4(@)(@@) % لكم بالجناب وطيب المقام % % وحسن النعيم بمصر الهنا % % 5(@)(@@) % فحثوا النسيم لإبلاغه % % سلامكم في النوى لا ونى % % 6(@)(@@) % ودلوا على الدوح قلبي فقد % % عناني لأشواقكم ما عنا % % 7(@)(@@) % وإني فقير إلى وصلكم % % ومن نال ذلك نال الغنى % % PageV01P407 البحر : مجتث 1(@)(@@) % الحمد لله فزنا % % وللمطالب حزنا % % 2(@)(@@) % حزنا السرور ومات الحسود % % غما وحزنا % % 3(@)(@@) % وعاد سهلا من الأمر % % كل ما كان حزنا % % 4(@)(@@) % وأذعنت واستقادت % % منى لنا قد نشزنا % % 5(@)(@@) % مواعد الله في كل % % سؤل نفس نجزنا % % 6(@)(@@) % إن الأعادي ذلوا % % بنصرنا وعززنا % % 7(@)(@@) % كم ظهر شرك قصمنا % % وعطف عز هززنا % % 8(@)(@@) % وجيش باغ هزمنا % % ورأس عات همزنا % % 9(@)(@@) % وفرصة للأماني % % مع النجاح انتهزنا % % 10(@)(@@) % وكم مراكز ملك % % فيها الرماح ركزنا % % PageV01P408 11(@)(@@) % وكم عدو سلبناه % % ملكه وابتززنا % % 12(@)(@@) % نلنا الذي قد رجونا % % بالحوط مما احترزنا % % 13(@)(@@) % ولم يجز من أمور الدنيا % % سوى ما أجزنا % % 14(@)(@@) % ببأس محمود الملك % % للخطوب برزنا 
ms104	 % % 15(@)(@@) % وبين صرف العوادي % % وبيننا قد حجزنا % % 16(@)(@@) % لله جم أياد % % عن شكرها قد عجزنا % % 17(@)(@@) % بكل كنز سمحنا % % والحمد مما كنزنا % % 18(@)(@@) % إنا لأصفى وأجدى % % في الخير وردا ومزنا % % 19(@)(@@) % ما ساجل الناس إلا % % فتنا مداهم وجزنا % % 20(@)(@@) % لنا خلائق غر % % على الوفاء غرزنا % % PageV01P409 21(@)(@@) % نزهن عن كل سوء % % وبالخنا ما غمزنا % % 22(@)(@@) % تضيق بالحال ذرعا % % ونوسع العرض خزنا % % 23(@)(@@) % ولم ندع للأعادي % % في موقف الفخر وزنا % % PageV01P410 البحر : خفيف تام 1(@)(@@) % أيها الظاعنون عني وقلبي % % معهم لا يفارق الأضعانا % % 2(@)(@@) % ملكوا مصر مثل قلبي وفي هذا % % وهاتيك أصبحوا سكانا % % 3(@)(@@) % فاعدلوا فيهما فإنكم اليوم % % ملكتهم عليها سلطانا % % 4(@)(@@) % لا تروعوا بالهجر قلب محب % % أورثثه روعاته الخفقانا % % 5(@)(@@) % حبذا معهد قضينا به العيش % % فكنا بربعه جيرانا % % 6(@)(@@) % إذ وجدنا من الحوادث أمنا % % وأخذنا من الخطوب أمانا % % 7(@)(@@) % ورتعنا من المنى في رياض % % وسكنا من المغاني جنانا % % PageV01P411 البحر : خفيف تام 1(@)(@@) % يا صلاح الدين الذي أصلح الفاسد % % بالعدل من خطوب الزمان % % 2(@)(@@) % أنت أجريت نيل مصر إلى الشام % % نوالا أم سال نيل ثاني % % 3(@)(@@) % وعلى نيلها لكفيك فضل % % فهما بالنضار جاريتان % % 4(@)(@@) % وصلت أعطياتك الغر غزرا % % فتلقت آمالنا بالتهاني % % 5(@)(@@) % خلع راقت العيون ورقت % % وعلا وصفها عن الإمكان % % 6(@)(@@) % مذهبات كأنها خلع الرضوان % % قد أهديت لأهل الجنان % % 7(@)(@@) % مشرقات بطرزها الذهبيات % % الحسان الرفيعة الأثمان % % 8(@)(@@) % فالعمامات كالغمامات والطوز % % بروق كثيرة اللمعان % % 9(@)(@@) % والموالي بها من التيه والفخر % % على الدهر ساحبو الأردان % % 10(@)(@@) % كيف خص العماد بالأدون المخلق % % من دون عصبة الديوان % % PageV01P412 11(@)(@@) % أخليق من نسجه لك في المدح % % جديد بأمهن الخلقان % % 12(@)(@@) % وكذا عادة الليالي تخص الفاضل % % المستحق بالحرمان % % 13(@)(@@) % لم تزل سائرات جودك بالشام % % لديه غزيرة التهلان % % 14(@)(@@) % فإذا لم تزده مصر كمالا % % في المنى فاحمه من النقصان % % PageV01P413 البحر : كامل تام 1(@)(@@) % عقدت بنصرك راية الإيمان % % وبدت لعصرك آية الإحسان % % 2(@)(@@) % يا غالب الغلب الملوك وصائد الصيد % % الليوث وفارس الفرسان % % 3(@)(@@) % يا سالب التيجان من أربابها % % حزت الفخار على ذوي 
ms105	 التيجان % % 4(@)(@@) % محمود المحمود ما بين الورى % % في كل أقليم بكل لسان % % 5(@)(@@) % يا واحدا في الفضل غير مشارك % % أقسمت مالك في البسيطة ثان % % 6(@)(@@) % أحلى أمانيك الجهاد وإنه % % لك مؤذن أبدا بكل أمان % % 7(@)(@@) % كم بكر فتح ولدته ظباك من % % حرب لقمع المشركين عوان % % 8(@)(@@) % كم وقعة لك في الفرنج حديثها % % قد سار في الآفاق والبلدان % % 9(@)(@@) % كم مصعب عسر المقادة قدته % % نحو الردى بخزائم الخلان % % 10(@)(@@) % قمصت قومصهم رداء من ردى % % وقرنت رأس برنسهم بسنان % % PageV01P414 11(@)(@@) % وملكت رق ملوكهم وتركتهم % % بالذل في الأقياد والأسجان % % 12(@)(@@) % وجعلت في أعناقهم أغلالهم % % وسحبتهم هونا على الأذقان % % 13(@)(@@) % إذ في السوابغ تحطم السمر القنا % % والبيض تخضب بالنجيع القاني % % 14(@)(@@) % وعلى غناء المشرفية في الطلى % % والهام رقص عوامل المران % % 15(@)(@@) % وكأن بين النقع لمع حديدها % % نار تألق من خلال دخان % % 16(@)(@@) % في مأزق ورد الوريد مكفل % % فيه بري الصارم الظمآن % % 17(@)(@@) % غطى العجاج به نجوم سمائه % % لتنوب عنها أنجم الخرصان % % 18(@)(@@) % يمتاح من قلب القلوب دماءها % % بالسمر متح الماء بالأشطان % % 19(@)(@@) % أو ما كفاهم ذاك حتى عاودوا % % طرق الضلال ومركب الطغيان % % 20(@)(@@) % يا خيبة الإفرنج حين تجمعوا % % في حيرة وأتوا إلى حوران % % PageV01P415 21(@)(@@) % جاؤوا وظنهم يعجل ربحهم % % فأعدتهم بالخزي والخسران % % 22(@)(@@) % وظنونهم وقلوبهم قد أيقنت % % للرعب بالإخفاق والخفقان % % 23(@)(@@) % وجلوت نور االدين ظلمة كفرهم % % لما صدعت بواضح البرهان % % 24(@)(@@) % وهزمتهم بالرأي قبل لقائهم % % والرأي قبل شجاعة الشجعان % % 25(@)(@@) % راحوا فباتوا تحت كل مذلة % % وضربت منهم فوق كل بنان % % 26(@)(@@) % ما في النصارى الغتم إلا من له % % في الصلب بان الكسر والصلبان % % 27(@)(@@) % ولوا وقلب شجاعهم في صدره % % كالسيف يرعد في يمين جبان % % 28(@)(@@) % فاروا من الفوار عند فرارهم % % بالفور وامتدوا إلى المدان % % 29(@)(@@) % وأزراها الشلالة الشل الذي % % أهدى لهم شللا إلى الأيمان % % 30(@)(@@) % ولى وجوههم سواد وجوههم % % نحو السواد وآذنوا بهوان % % PageV01P416 31(@)(@@) % حملت عليهم من جنودك فتية % % لم تدر غير حمية الفتيان % % 32(@)(@@) % زخرت بهم أمواج آجك في الوغى % % غزرا وطم بهم عباب 
ms106	 طمان % % 33(@)(@@) % وتذمموا من حر باس محمد % % وتهيبوا الحملات من عثمان % % 34(@)(@@) % وبسيف جرديك المجرد غودروا % % بدماء أهل الغدر في غدران % % 35(@)(@@) % وبعين دولتك الذي قدمته % % فقئت عيون الكفر والكفران % % 36(@)(@@) % واليارقية أرقتهم في الدجى % % بسهام كل حنية مرنان % % 37(@)(@@) % أجفانهم نفت الغرار كما انتفى % % ماضي الغرار بهم من الأجفان % % 38(@)(@@) % بعلوا معسكر بعلبك وأبصروا % % من جند بصرى برك كل جران % % 39(@)(@@) % وكأنما الأكراد فوق جيادها % % عقبان ملحمة على عقبان % % 40(@)(@@) % ولطالما مهرت على نصر الهدى % % أنصارك الأبطال من مهران % % PageV01P417 41(@)(@@) % لم يترك الأتراك فيهم غاية % % بالفتك والإرهاق والإثخان % % 42(@)(@@) % من كل رام سهمه من وهمه % % أهدى إلى إنسان عين الراني % % 43(@)(@@) % ولك المماليك الذين بهم عنت % % أملاك مصر لمالكي بغدان % % 44(@)(@@) % هم كالصحابة يوم بدر حاولوا % % نصر النبي ونبت عن حسان % % 45(@)(@@) % الحائزون من السباق خصاله % % في ملتقى حرب وفي ميدان % % 46(@)(@@) % من كل مبسوط اليدين يمينه % % ما تمتلي إلا بقبض يمان % % 47(@)(@@) % لما رأى الداوي راونداءه % % ولى بطاعون بغير طعان % % 48(@)(@@) % طلب الفريري الفرار بطلبه % % متباعدا من هلكه المتداني % % 49(@)(@@) % والهنفرى مذهان فر مؤملا % % لسلامة والهون شأن الشاني % % 50(@)(@@) % باروا فبارونيهم بفنائه % % مود وسيدهم أسير عان % % PageV01P418 51(@)(@@) % أخلوا بلادهم فحل بأهلها % % منك الغداة طوارق الحدثان % % 52(@)(@@) % أنهضت حين خلت إليها عسكرا % % أخلى قواعدها من البنيان % % 53(@)(@@) % وشغلت جأشهم بجيش هدهم % % فجنى ثمار النصرة الجيشان % % 54(@)(@@) % وملأت بالنيران أربع أهلها % % فتعجلوا الإحراق بالنيران % % 55(@)(@@) % عادوا وحين رأوا خراب بيوتهم % % يئسوا من الأوطار والأوطان % % 56(@)(@@) % باؤوا بأحزان وخاضوا هولها % % مما لقوا بمخاضة الأحزان % % 57(@)(@@) % وقد استفاد المشركون تعازيا % % والمسلمون تهاديا بتهان % % 58(@)(@@) % أصبحت للإسلام ركنا ثابتا % % والكفر منك مضعضع الأركان % % 59(@)(@@) % قوضت آساس الضلال بعزمك الماضي % % وشدت مباني الإيمان % % 60(@)(@@) % قل أين مثلك في الملوك مجاهد % % لله في سر وفي إعلان % % PageV01P419 61(@)(@@) % لم تلقهم ثقة بقوة شوكة % % لكن وثقت بنصرة الرحمن % % 62(@)(@@) % ما زال عزمك مستقلا بالذي % % لا يستقل بثقله الثقلان % % 63(@)(@@) % وبلغت بالتأييد أقصى مبلغ % % ما كان في وسع 
ms107	 ولا إمكان % % 64(@)(@@) % دانت لك الدنيا فقاصيها إذا % % حققته لنفاذ أمرك دان % % 65(@)(@@) % فمن العراق إلى الشآم إلى ذرى % % مصر إلى قوص إلى أسوان % % 66(@)(@@) % لم تله عن باقي البلاد وإنما % % ألهاك فرض الغزو عن همذان % % 67(@)(@@) % للروم والإفرنج منك مصائب % % بالترك والأكراد والعربان % % 68(@)(@@) % إعزازك الدين الحنيف وحزبه % % قد خص أهل الشرك بالإهوان % % 69(@)(@@) % أذعنت لله المهيمن إذ عنت % % لك أوجه الأملاك بالإذعان % % 70(@)(@@) % أنت الذي دون الملوك وجدته % % ملآن من عرف ومن عرفان % % PageV01P420 71(@)(@@) % في بأس عمرو في بسالة حيدر % % في نطق قس وفي تقى سلمان % % 72(@)(@@) % عمران عدلك للبلاد كأنما % % قد عاش في أيامك العمران % % 73(@)(@@) % خلدت في الآفاق ذكرا باقيا % % أبد الزمان ببذل مال فان % % 74(@)(@@) % سير لو أن الوحي ينزل أنزلت % % في شأنها سور من القرآن % % 75(@)(@@) % فاسلم طويل العمر ممتد المدى % % صافي الحياة مخلد السلطان % % PageV01P421 البحر : مجزوء الكامل 1(@)(@@) % ما راقدات في صحون % % مستوطنات في سكون % % 2(@)(@@) % يجلين أمثال العرائس % % بين أبكار وعون % % 3(@)(@@) % أو كالعقائل في الخدور % % قد اعتقلن على ديون % % 4(@)(@@) % هن اللذيذات اللوائذ % % بالسهول من الحزون % % 5(@)(@@) % أو كالتمائم للصحاف % % وما نسبن إلى جنون % % 6(@)(@@) % السكريات الغريقات % % الغلائل والشوون % % 7(@)(@@) % صرعى وما درات لها % % يوما رحى الحرب الزبون % % 8(@)(@@) % لففن في أكفانهن % % على المنى لا للمنون % % 9(@)(@@) % يحيين بالتغريق بل % % يسمن في ضيق السجون % % 10(@)(@@) % المستطابات الظهور % % المستلذات البطون % % PageV01P422 11(@)(@@) % نضدن بالترصيع في الجامات % % كالدر المصون % % 12(@)(@@) % المستقيمات الصفوف % % وفقن كالخيل الصفون % % 13(@)(@@) % وقد اشتملن من اللطائف % % والصفات على فنون % % 14(@)(@@) % اسمع حديثي في انبساطي % % فالحديث أخو شجون % % PageV01P423 البحر : بسيط تام 1(@)(@@) % يوما يجيء ويوما في دمشق وبالفسطاط % % يوما ويوما بالعراقين % % 2(@)(@@) % كأن جسمي وقلبي الصب ما خلقا % % إلا ليقتسما بالشوق والبين % % PageV01P424 البحر : كامل تام 1(@)(@@) % بالمستضيء أبي محمد الحسن % % رجعت أمور المسلمين إلى السنن % % 2(@)(@@) % في أرص مصر دعا له خطباؤها % % وآتت لتخطب بكر خطبته عدن % % 3(@)(@@) % فالمغرب الأقصى بذلك مشرق % % وبنصر مصر محقق يمن اليمن % % 4(@)(@@) % ورأى الإله المستضيء 
ms108	 لشرعه % % وعباده نعم الأمين المؤتمن % % 5(@)(@@) % سر النبوة كامن فيه ومن % % فطر الإمامة مشرق نور الفطن % % 6(@)(@@) % تقوى أبي بكر ومن عمر الهدى % % وحياء عثمان وعلم أبي الحسن % % 7(@)(@@) % وبجده عرفت مقالة حيدر % % لا من دد أنا لا ولا مني الددن % % 8(@)(@@) % كم من عدو ميت في جلده % % رعبا وخوفا فهو حي في كفن % % 9(@)(@@) % هل مثل محمود بن زنكي مخلص % % متوحد يبغى رضاك بكل فن % % 10(@)(@@) % ورع لدى المحراب أروع محرب % % في حالتيه إن أقام وإن ظعن % % PageV01P425 11(@)(@@) % يمسي ويصبح في الجهاد وغيره % % يضحى رضيع سلافة وضجيع دن % % 12(@)(@@) % وبعره الإسلام منتصرا حر % % وبذلة الإشراك منتقما قمن % % PageV01P426 البحر : وافر تام 1(@)(@@) % جفون البيض أم بيض الجفون % % وسمر الخط أم هيف الغصون % % 2(@)(@@) % قيان ناظرت عن نصول % % أحدت غربها أيدي القيون % % 3(@)(@@) % مريضات المعاطف والتثني % % سقيمات اللواحظ والعيون % % 4(@)(@@) % سوافر مشرفيات التجلي % % سواحر مشرقيات الجفون % % 5(@)(@@) % حللن ببابل وحللن سحرا % % عقود عقولنا بيد الجفون % % 6(@)(@@) % سلبن القلب حين سكن فيه % % منحن غرامه بعد السكون % % 7(@)(@@) % ألا يا عاذلي دعني وشأني % % وما تجري المدامع من شؤوني % % 8(@)(@@) % فإن صبابتي داء دفين % % وكم أبقى على الداء الدفين % % 9(@)(@@) % حسبتك لي على وجدي معينا % % ألا ما للمعنى من معين % % 10(@)(@@) % جعلت ضمانتي لهم ضماني % % ومالي في الضمانة من ضمين % % PageV01P427 11(@)(@@) % أنا الصب الذي لهواي هانت % % على قلبي مصاعب كل هون % % 12(@)(@@) % بكل خدينة للحسن ما لي % % سوى بلوى هواها من خدين % % 13(@)(@@) % كريم أو كغصن أو كبدر % % بلحظ أو بقد أو جبين % % 14(@)(@@) % تبسم درها عن أقحوان % % وأزهر وردها في ياسمين % % 15(@)(@@) % غريم غرامها عسر التقاضي % % وقد علقت بحبيها رهوني % % 16(@)(@@) % لوت دين الوصال وما قضته % % ولو كانت وفت وفت ديوني % % 17(@)(@@) % سقى الله العراق وساكنيه % % وحياه حيا الغيث الهتون % % 18(@)(@@) % وجيرانا أمنت الجور منهم % % وما فيهم سوى واف أمين % % 19(@)(@@) % صفوا والدهر ذو كدر وقدما % % وفوا بالعهد في الزمن الخؤون % % 20(@)(@@) % ليالي أشرقت منها الدياجي % % بحور من جنان الخلد عين % % PageV01P428 21(@)(@@) % أرى 
ms109	 ربحي إذا أنفقت مالي % % وما أنا بالغبي ولا الغبين % % 22(@)(@@) % فلا عيش الإخاء بمستكن % % ولا عيش الرخاء بمستكين % % 23(@)(@@) % وقد طلعت شموس من كؤوس % % كما شهرت سيوف من جفون % % 24(@)(@@) % يطوف بها على الندماء ساق % % شمائله معشقة الفنون % % 25(@)(@@) % ويطفي جذوة منها بماء % % ويمزج شدة منها بلين % % 26(@)(@@) % كأن عذاره اللاهي لام % % وحاجبه المقوس حرف نون % % 27(@)(@@) % ولما سل عارضه حساما % % وفوق لحظه سهم المنون % % 28(@)(@@) % بدا زرد العذار فقلت هذا % % يدير لنا رحى الحرب الزبون % % 29(@)(@@) % وثقت إلى الزمان وغاب عني % % بأن الحادثات على كمين % % 30(@)(@@) % وشطت دار أحباب كرام % % تبدل وصلهم بنوى شطون % % PageV01P429 31(@)(@@) % فيا شوقا لكل أخ كريم % % ضنين بالمودة لا ظنين % % 32(@)(@@) % خلصت من الشباب إلى شبيب % % مشوب عند أحبابي مشين % % 33(@)(@@) % وقاربت البياض فجانبتني % % مودة بيضها السود القرون % % 34(@)(@@) % وجائلة الوشاح رأت جماحي % % على هوجاء جائلة الوضين % % 35(@)(@@) % عشية ودعت والعيش تخذي % % نواحل قد برين من البرين % % 36(@)(@@) % بكت شجوا وأرزمت المطايا % % وهاج أنينها الشاجي أنيني % % 37(@)(@@) % فلي ولها وللأنضاء شجو % % حنين في حنين في حنين % % 38(@)(@@) % تناشدني وتذكرني بعهدي % % وتبعثني على حفظ اليمين % % 39(@)(@@) % وقالت ما ظننتك قط تنوي % % مفارقتي لقد ساءت ظنوني % % 40(@)(@@) % قد استسهلت أحزاني ببين % % يرد بك السهول على الحزون % % PageV01P430 41(@)(@@) % فقلت سراي للعليا وإني % % تخذت لها أمينا من أمون % % 42(@)(@@) % إلى عمر بن شاهنشاه قصدي % % ثقي بغناي منه وارقبيني % % 43(@)(@@) % أسافر عنك أبغي العز منه % % مدل في الهدوء وفي الهدون % % 44(@)(@@) % حويت فضيلة العالي ولكن % % رأيت الدون يحوي الحظ دوني % % 45(@)(@@) % صفا ورد الزلال لوارديه % % ومثلي ليس يظفر بالأجون % % 46(@)(@@) % لقد جمحت حظوظي بي وماذا % % تفيد رياضة الحظ الحزون % % 47(@)(@@) % ولا لوم إذا لم ألق كفوا % % إذا أعنست أبكاري وعوني % % 48(@)(@@) % وليس سوى تقي الدين مولى % % زماني في ذراه يتقيني % % 49(@)(@@) % وإني بالمدائح أصطفيه % % كما هو بالمنائح يصطفيني % % 50(@)(@@) % بنيل ظماء أهل الفضل ريا % % خضم نواله الصافي المعين % % PageV01P431 51(@)(@@) % يبدل فضله رثا وغثا % % لحظي بالجديد وبالسمين % % 52(@)(@@) % ويوضح منهج العليا 
ms110	 بجود % % يجدد منهج الحمد المبين % % 53(@)(@@) % رحيب الصدر طلق الوجه ثبت الجنان % % ندي المحيا واليمين % % 54(@)(@@) % غزير الفضل جم الجود ملك % % عديم المثل مفقود القرين % % 55(@)(@@) % أخو العم المؤيد بالمساعي التي % % نجحت وذو الرأي المتين % % 56(@)(@@) % فعند الجود كالجود اندفاعا % % وعند الحلم كالطود الرصين % % 57(@)(@@) % له عرض لعافيه مذال % % يذود به عن العرض المصون % % 58(@)(@@) % له يوما ندى ووغى عطاء % % وكسر للألوف وللمئين % % 59(@)(@@) % صوارمه صوالجه إذا ما % % رؤوس عداه كانت كالكرين % % 60(@)(@@) % وما لطيور أسهمه المواضي % % سوى مقل الأعاد من وكون % % PageV01P432 61(@)(@@) % إذا اعتقل القنا الخطي سالت % % له أعنقاها بدم الوتين % % 62(@)(@@) % ويجمد منه بطن النسر ما قد % % شكته لبة الذمر الطعين % % 63(@)(@@) % بنو أيوب زانوا الملك منهم % % بحيلة سؤدد وتقى ودين % % 64(@)(@@) % ملوك أصبحوا خير البرايا % % لخير رعية في خير حين % % 65(@)(@@) % أسانيد السيادة عن علاهم % % معنعنة مصححة المتون % % 66(@)(@@) % كأن لدان سمرهم أفاع % % تصرفها القساور في العرين % % 67(@)(@@) % عزائمهم متى نهدوا لغزو % % مفاتيح المعاقل والحصون % % 68(@)(@@) % وتشرق في مثار النقع منهم % % إذا ركبوا شموس في دجون % % 69(@)(@@) % إذا ركبوا ظهور الخيل ردوا العداة % % من القشاعم في البطون % % 70(@)(@@) % بسطوة بأسهم في كل أرض % % جبال الشرك عادت كالعهون % % PageV01P433 71(@)(@@) % غدا الفضلاء منهم في مكان % % من الإكرام محروس مكين % % 72(@)(@@) % بكل مبجل لمؤمليه % % وللأعداء والدنيا مهين % % 73(@)(@@) % ضنين بالعلاء لمعتفيه % % ولكن باللها غير الضنين % % 74(@)(@@) % براه الله من طهر وطيب % % وكل الناس من حمأ وطين % % 75(@)(@@) % فزين أمر راجيه الموالي % % وشين شان شائنه اللعين % % 76(@)(@@) % بنو أيوب مثل قريش مجدا % % وأنت لهم كأنزعها البطين % % 77(@)(@@) % فقل لملوك هذا العصر طرا % % أروني مثله فيكم أروني % % 78(@)(@@) % بجد سام عالي كل فخر % % ومجانا طلبتم بالمجون % % 79(@)(@@) % إذا خف الملوك لكل خطب % % حلوما كنت ذا حلم رزين % % 80(@)(@@) % تزان بكل منقبة وفضل % % علاك فلا مزيد على المزين % % PageV01P434 81(@)(@@) % عدوك كالذباب له طنين % % وفيه ذباب سيفك ذو طنين % % 82(@)(@@) % أخفت الشرك حتى الذعر منهم % % يرى قبل الولادة في الجنين % % 83(@)(@@) % ويوم الرملة المرهوب 
ms111	 بأسا % % تركت الشرك منزعج القطين % % 84(@)(@@) % وقد غادرت أشلاء الفرنج % % كمحصود الزروع على الجرين % % 85(@)(@@) % وأضحى الدين منك قرير عين % % وظل الشرك ذا طرف سخين % % 86(@)(@@) % وكنت لعسكر الإسلام كهفا % % أوى منه إلى حصن حصين % % 87(@)(@@) % وقد عرف الفرنج سطاك لما % % رأوا آثارها عين اليقين % % 88(@)(@@) % وأنت ثبت دون الدين تحمي % % حماه أوان ولى كل دون % % 89(@)(@@) % ولو لبوا نداء الحزم درت % % عليهم لقحمة النصر اللبون % % 90(@)(@@) % وليك منك في ظل ظليل % % من الإعزاز في كن كنين % % PageV01P435 91(@)(@@) % وتهمي للموالي والمعادي % % بسحب للندى والباس جون % % 92(@)(@@) % أنهاب المحامد بالعطايا % % ووهاب المسرة للحزين % % 93(@)(@@) % ألا يا كعبة للفضل أضحى % % إلى أركان دولته ركوني % % 94(@)(@@) % حجاه وحجره لمساجليه % % مقام الحجر منه والحجون % % 95(@)(@@) % تقي الدين إن حديث فضلي % % لمن يصغي إليه لذو شجون % % 96(@)(@@) % فعتبى للزمان على اهتضامي % % وشكوى من جنون المنجنون % % 97(@)(@@) % ولست أرى سوى علياك تاجا % % تليق بدر مدحتي الثمين % % PageV01P436 البحر : - 1(@)(@@) % حي الداير على علياء جيرون % % مهوى الهوى ومغاني الخرد العين % % PageV01P437 البحر : بسيط تام 1(@)(@@) % أهدى النسيم لنا ريا الرياحين % % أم طيب أخلاق جيراني بجيرون % % 2(@)(@@) % هبت لنا نفحة في جلق سحرا % % باحت بسر من الفردوس مكنون % % 3(@)(@@) % وفاح بالعرف من أرجائها أرج % % نال المسرة منه كل محزون % % 4(@)(@@) % هبت تنبه أطرافي وتبعثها % % مني وتوجب للتهويم تهويني % % 5(@)(@@) % وما درينا أداريا لنا أرجت % % أم دار في دارنا عطار دارين % % 6(@)(@@) % نسري ونرتاح الاستنشاء رائحة % % هبت سحيرا على ورد ونسرين % % 7(@)(@@) % ورب هم فقدناه بربوتها % % ورب قلب أصبناه بقلبين % % 8(@)(@@) % لولا جسارة قلبي ما ثبت على العبور % % من طرب من جسر جسرين % % 9(@)(@@) % دمشق عندي لا تحصى فضائلها % % عدا وحصرا ويحصى رمل يبرين % % 10(@)(@@) % وما أرى بلدة أخرى تماثلها % % في الحسن من مصر حتى منتهى الصين % % PageV01P438 11(@)(@@) % في كل قطر بها وكر لمنكسر % % ومسكن غير مملول لمسكين % % 12(@)(@@) % وإن من باع كل العمر مقتنعا % % بساعة في ذراها غير مغبون % % 13(@)(@@) % لما علت همتي صيرتها وطني % % وليس يقنع غير الدون بالدون 
ms112	 % % 14(@)(@@) % يصيبك ميطورها طورا ونيربها % % طورا وتوليك إحسانا بتحسين % % 15(@)(@@) % ترى جواسقها في الجو شاهقة % % كأنهن قصور للسلاطين % % 16(@)(@@) % دار النعيم ومن أدنى محاسنها % % ثمار تموز في أيام كانون % % 17(@)(@@) % نعيمها غير ممنوع لساكنها % % كالخلد والمن فيها غير ممنون % % 18(@)(@@) % كأنما هي للأبرار قد فتحت % % من الفراديس أبواب البساتين % % 19(@)(@@) % أزهارها أبدا في الروض مونقة % % فحسن نسيان موصول بتشرين % % 20(@)(@@) % وأي عين إليها غير ناظرة % % وأي قلب عليها غير مفتون % % PageV01P439 21(@)(@@) % أهوى مقري بمقرى والرياض بها % % للزهر ما بين تفويف وتزيين % % 22(@)(@@) % هاجت بلابل قلبي المستهام بها % % بلابل اليك غنتنا بتلحين % % 23(@)(@@) % تتلو بسطرى أساطير الغرام على % % صوامع الدوح ورق كالرهابين % % 24(@)(@@) % قمريها مقريء يشدو بنغمته % % آيا تعلمها من غير تلقين % % 25(@)(@@) % وللحمائم في الأسحار أدعية % % مرفوعة شفعت منا بتأمين % % 26(@)(@@) % خافت على الروض من عين مطوقة % % أضحت تعوذه منها بياسين % % 27(@)(@@) % من كل مطرب صوت غير مضطرب % % وكل معرب لفظ غير ملحون % % 28(@)(@@) % وللبساتين أنهار جداولها % % تستن في الجري أمثال الثعابين % % 29(@)(@@) % وقد تراءت بها الأشجار تحسبها % % صفوف خيل صفون في الميادين % % 30(@)(@@) % كأنها شجر الرمان ذو نشب % % مثر دنانيره ملء الهمابين % % PageV01P440 31(@)(@@) % وللخلاف لإظهار الخلاف على % % أترابه ورق شبه السكاكين % % 32(@)(@@) % وكل غصن بعصف الريح ممتحن % % كأنه عاقل مبلى بمجنون % % 33(@)(@@) % للأقحوان ثغور الغانيات كما % % للنرجس الغض الحاظ المها العين % % 34(@)(@@) % وللبنفسج خال للعذار إذا % % ما الخط بالخال حاكى عطفة النون % % 35(@)(@@) % والورد خد من التوريد في خجل % % والغصن قد تثنيه من اللين % % 36(@)(@@) % وللنسيم ولوع بالغدير فما % % يزال ما بين تفريك وتغضين % % 37(@)(@@) % والماء من نكبة النكباء في زرد % % مضاعف السرد ضافي النسج موضون % % 38(@)(@@) % لكل جارية في كل ساقية % % على التواء بها إسراع تنين % % 39(@)(@@) % إن القلوب وألحاظ الحسان بها % % لكالعصافير في أيدي الشواهين % % 40(@)(@@) % من كل خاطفة للقلب مخطفة % % بالخصر تمطلني ديني وتكويني % % PageV01P441 41(@)(@@) % من شاذن متثني العطف معتدل القوام % % مستعذب الأخلاق موزون % % 42(@)(@@) % يا صاحبي أفيقا فالزمان صحا % % ولان من بعد تشديد وتخشين % % 43 
ms113	(@)(@@) % حرستما في حرستا العيش من شظف % % دوما بدوما على حفظ القوانين % % 44(@)(@@) % دار المقامة قد أضحت محلكما % % ونلتما العز في أمن من الهون % % 45(@)(@@) % وبالمنيبع ربع للولي غدا % % تأسيس بنيانه العالي على الدين % % PageV01P442 البحر : كامل تام 1(@)(@@) % نصر أنار لملككم برهانه % % وعلا لذلة شانئيكم شانه % % 2(@)(@@) % ما أسعد الإسلام وهو مظفر % % وأبو المظفر يوسف سلطانه % % 3(@)(@@) % الملك مرفوع لكم مقداره % % والعدل موضوع بكم ميزانه % % 4(@)(@@) % والدهر لا يأتي بغير مرادكم % % فهل القضاء لأجلكم جريانه % % 5(@)(@@) % وكأنما لله في أحكامه % % فلك على إيثاركم دورانه % % 6(@)(@@) % فخرا بنو أيوب إن فخاركم % % بذ الملوك السابقين رهانه % % 7(@)(@@) % يكفي حسودكم اعتقالا همة % % فكأنما أشجانه أسجانه % % 8(@)(@@) % الدين عز الدين عز بنصركم % % والكفر ذل بعونكم أعوانه % % 9(@)(@@) % قد كان جيشكم كبحر زاخر % % واللابسون جواشنا حيتانه % % 10(@)(@@) % فطمى لهلكهم عليهم بحركم % % بأسا وغرق فلكهم طوفانه % % PageV01P443 11(@)(@@) % فضل الملوك الأكرمين بفضله % % فعلا زمانهم البهيج زمانه % % 12(@)(@@) % في فضله في عدله في حلمه % % صديقه فاروقه عثمانه % % 13(@)(@@) % هو في السماح وفي اللقاء عليه % % هو في العفاف وفي التقى سلمانه % % 14(@)(@@) % من آل شاذي الشائدين لمجده % % ببنيه بيتا عاليا بنيانه % % 15(@)(@@) % بيت من العلياء سام ساحق % % يبني على كيوانها إيوانه % % 16(@)(@@) % يا سالب التيجان من أربابها % % ومن الثناء مصوغة تيجانه % % 17(@)(@@) % والحمد مال أنتم بذاله % % والمال حمد أنتم خزانه % % PageV01P444 البحر : مجزوء الرمل 1(@)(@@) % بأبي معتدل القامة % % في عطفيه نشوه % % 2(@)(@@) % حاكم في مهج العشاق % % لا يقبل رشوه % % 3(@)(@@) % متعد أو ما يخشى % % من المظلوم دعوه % % 4(@)(@@) % شبه رئم غصن بان % % بدر دجن شمس ضحوه % % 5(@)(@@) % فيه تيه ودلال % % وله لين وقسوه % % 6(@)(@@) % ثمل العطف وما دارت % % عليه كأس قهوه % % 7(@)(@@) % سل سيف اللحظ لما % % رام أخذ القلب عنوه % % 8(@)(@@) % وعلى ضعفي لسلطان % % هواه كل سطوه % % 9(@)(@@) % أتمنى ليلة من % % طيفه في النوم خلوه % % 10(@)(@@) % ومتى أطمع في الطيف % % وما للعين غفوه % % PageV01P445 11(@)(@@) % ومتى أسعد بالوصل % % فإن البين شقوه % % 12(@)(@@) % أيها المثبت باللوم % % هوى يقصد صحوه % % 13(@)(@@) % آه والهفي على 
ms114	 عيش % % مضى في دار علوه % % 14(@)(@@) % وزمان كدر الهجران % % بعد الوصل صفوه % % 15(@)(@@) % وكرام صيرتهم % % نسبة الآداب إخوه % % 16(@)(@@) % حين كان الدهر للغفلة % % عن قصدي بنجوه % % 17(@)(@@) % حين لم أعقد ولم أحلل % % لغير الحب حبوه % % 18(@)(@@) % أبذل الثروة للحمد % % فإن الحمد ثروه % % 19(@)(@@) % رافلا من ملبس العيشة % % في أبهج صفوه % % 20(@)(@@) % حق يا قلب على تذكارهم % % أن تتأوه % % PageV01P446 21(@)(@@) % يا أخلايب بغداد % % سقيتم كل غدوه % % 22(@)(@@) % وأمنتم نائب الدهر % % ونلتم كل حظوه % % 23(@)(@@) % ما تسليني عن دجلة % % جيرون وربوه % % 24(@)(@@) % لا ولا جلق تلهيني % % وفيها كل شهوه % % 25(@)(@@) % أيها المعرق يزجي % % بزمام الشوق نضوه % % 26(@)(@@) % نافذا كالسهم في السير % % إلى أبعد غلوه % % 27(@)(@@) % راكبا في درك البغية % % للصبوة صهوه % % 28(@)(@@) % جاز حد الوجد حتى % % صار ذكر الجزع حدوه % % 29(@)(@@) % عج على نهر المعلى % % واصرف الهمة نحوه % % 30(@)(@@) % لذ بأجوادهم أهل % % الندى في كل ندوه % % PageV01P447 31(@)(@@) % وعن المشتاق بلغ % % نبأ من غير نبوه % % 32(@)(@@) % ولإشفاقك من شجوهم % % لا تبد شجوه % % 33(@)(@@) % وإله عن عتبي فإذكارك % % بالجفوة جفوه % % 34(@)(@@) % وأنا المذنب فاطلب % % لي من المحسن عفوه % % 35(@)(@@) % يا أبا الفتح الذي أضحى % % لأهل الفضل قدوه % % 36(@)(@@) % والذي حل من العلياء % % في أسمق ذروه % % 37(@)(@@) % وهو في الشعر وفي العلم % % كحسان وعروه % % 38(@)(@@) % وهو من ودي له معتلق % % أوثق عروه % % 39(@)(@@) % لك في شكوى الليالي % % بالكرام الغر أسوه % % 40(@)(@@) % فلأحداث الليالي % % غزوة من بعد عزوه % % PageV01P448 41(@)(@@) % نفر الحظ فيد أوسع % % عن ذي الفضل خطوه % % 42(@)(@@) % وبنو الدهر رجال % % في معانيهم كنسوه % % 43(@)(@@) % ما ترى في أحد منهم % % لأهل الفضل نخوه % % 44(@)(@@) % هم عن الخير خمود % % ولهم في الشر نزوه % % 45(@)(@@) % صعر الأوجه في اللقى % % كأن الكبر لقوه % % 46(@)(@@) % ومرجيهم كباغي % % لبن من ضرع لبوه % % 47(@)(@@) % فتصبر فعسى المقدار % % أن يلفت صغوه % % 48(@)(@@) % أنت من يعتذر الدهر % % به من كل هفوه % % 49(@)(@@) % مشرق البهجة حسنا % % صادق اللهجة أفوه % % 50(@)(@@) % خطبتني منك عذراء % % لها بالمجد صبوه % % PageV01P449 51(@)(@@) % عرفت بالأنف المر % % لدنيا وهي حلوه % % 52(@)(@@) % وحوت 
ms115	 في حلبة السبق % % المدى من غير كبوه % % 53(@)(@@) % حصل العاري من العار % % على أفخر كسوه % % 54(@)(@@) % أنا في النظم كمن يهدي % % إلى البصرة عجوه % % 55(@)(@@) % ومتى تذكر في الحسن % % مع الطاووس صعوه % % 56(@)(@@) % لا تخف من شتوة جاءت % % فقد جاءتك فروه % % 57(@)(@@) % غير أني أسبق الشتوة % % من شعري بشتوه % % 58(@)(@@) % خالص الزبدة ما فيه % % من الكلفة رغوه % % 59(@)(@@) % إحم من خاطرك الوقاد % % معناه بجذوه % % 60(@)(@@) % وطريق الجد أن تقبل % % لي باللهو لهوه % % PageV01P450 61(@)(@@) % هبة ليس عليها % % من يد المنة هبوه % % PageV01P451 البحر : دو بيت 1(@)(@@) % قد صح أن صلاح الدين في الكسوه % % ومن سطاه رجال الروع كالنسوه % % 2(@)(@@) % ولي بمن أمه في جلق أسوه % % والآن يرفل عاري الحظ في كسوه % % PageV01P452 البحر : سريع 1(@)(@@) % مولاي عز الدين فرخشه % % الدهر من يرجك لا يخشه % % 2(@)(@@) % تلقاه سمح الكف دفاقها % % طلق المحيا كرما بشه % % 3(@)(@@) % إن شئت فوتا بالردى فألقه % % أو شئت فوزا بالعلى فاغشه % % 4(@)(@@) % يديم بالأيدي وبالأيد في % % خزي لهاه والعدا بطشه % % 5(@)(@@) % كم ملك عاداكم لم يبت % % إلا جعلتم عرشه نعشه % % 6(@)(@@) % خوفتم الشرك فلا قصمه % % أمنتم يوما ولا فنشه % % 7(@)(@@) % أورثك السؤدد يا ابن العلى % % والدك السيد شاهنشه % % PageV01P453 البحر : خفيف تام 1(@)(@@) % إن بيع الحصون من غير حرب % % سنة سنها ببيروت سامه % % 2(@)(@@) % لعن الله كل من باع ذا البيع % % وأخزى بخزيه من سامه % % PageV01P454 البحر : كامل تام 1(@)(@@) % جلت عن الأوصاف والأشباه % % أوصاف عز الدين فرخشاه % % PageV01P455 البحر : كامل تام 1(@)(@@) % أدركت من كل المعالي المشتهى % % وبلغت من نيل الأماني المنتهى % % PageV01P456 البحر : رمل تام 1(@)(@@) % كان عهدي بفلان شائبا % % قد فشت شيبته في شاربيه % % 2(@)(@@) % وأراه اليوم في صبغ الصبا % % لونه الحالك قد عاد إليه % % 3(@)(@@) % ما أراه خضب اللحية بل % % وجهه الأسود أعدى عارضيه % % PageV01P457 البحر : كامل تام 1(@)(@@) % بين أمر حلاوة العيش الشهي % % وهوى أحال غضارة الزمن البهي % % 2(@)(@@) % وصبابة لا استقل بشرحها % % عن حصرها حصر البليغ المدره % % 3(@)(@@) % أأحبتي إن غبت عنكم فالهوى % % دان لقلب بالغرام موله % % 4(@)(@@) % أنهي 
ms116	 إليكم أن صبري منتئ % % بل منته والشوق ليس بمنته % % 5(@)(@@) % أما عقود مدامعي فلقد وهت % % وأبت عقود الود مني أن تهي % % 6(@)(@@) % ولقد دهيت ببينكم فاشتقتكم % % يا من لمشتاق ببينكم دهي % % 7(@)(@@) % ما زلت عندكم بأرخى عيشة % % وبقيت بعدكم بعيش أكره % % 8(@)(@@) % أبدت دموعي منه ما لم أبده % % وبدهت منه أسى بما لم أبده % % 9(@)(@@) % أما الهوى فأنا مدل عندكم % % عوفيتم منه بقلب مدله % % 10(@)(@@) % أرعى نجوم الليل فيكم ساهرا % % بنجوم دمع أوجها في الأوجه % % PageV01P458 11(@)(@@) % خطب الفراق شدهت منه وإنني % % للنائبات أشدها لم أشده % % 12(@)(@@) % نظري إليكم كان إثمد ناظري % % وبقيت أمري خلف جفن أمره % % 13(@)(@@) % وإذا ألم خيالكم متأوبا % % لاقيته بتألم المتأوه % % 14(@)(@@) % في شوقكم أبد الزمان تفكري % % وبذكركم عند الكرام تفكهي % % 15(@)(@@) % لو قيل لي ما تشتهي من هذه الدنيا % % لقلت سواكم لا أشتهي % % 16(@)(@@) % ما كان أرفه عيشتي وألذها % % من ذا الذي يبقى بعيش أرفه % % 17(@)(@@) % ومن السفاهة أنني فارقتكم % % من أين ذو الحلم الذي لم يسفه % % 18(@)(@@) % وعقاب أيلة ما يفارق جلقا % % أحد إليها غير غر أبله % % 19(@)(@@) % خلبت غروب الشأن مني غربة % % في بلدة شأني بها لم ينبه % % 20(@)(@@) % مالي ومصر وللمطامع إنما % % ملكت قيادي حيث لم أتنزه % % PageV01P459 21(@)(@@) % لا تنهني يا عاذلي فأنا الذي % % تبع الهوى وأتى بما عنه نهي % % 22(@)(@@) % قد قلت للحادي وقد ناديته % % في مهمة أقصر وصلت مه مه % % 23(@)(@@) % حتام جذبك للزمام فأرخه % % فلقد أنخت إلى ذرى فرخشه % % 24(@)(@@) % قد لذت بالمتطول المتفضل المتكرم % % المتحلم المتنبه % % 25(@)(@@) % نجح الرجاء جواب قصدي بابه % % مهما هممت له بجوب المهمه % % 26(@)(@@) % ملك يجيب خطاب كل مؤمل % % ويجير من عض الخطوب العضه % % 27(@)(@@) % من لم يجب بسوى نعم سؤاله % % ولمعتفيه بلا ولن لم يجبه % % 28(@)(@@) % متكرم بالطبع لا متكره % % شتان بين تكرم وتكره % % 29(@)(@@) % بيديه نجح المرتجي وإليه قصد % % الملتجي ولديه رشد الأتيه % % 30(@)(@@) % إحسان ذي مجد وهمة محسن % % محد وتقوى عابد متأله % % PageV01P460 31(@)(@@) % ما بارق ذو عارض من ودقه % % ورعوده في نادب 
ms117	 ومقهقه % % 32(@)(@@) % هام يظل الروض من أمواهه % % في الزهر بين مذهب ومموه % % 33(@)(@@) % فالروض من حلل الربيع أنيقة % % والروض من حلي الشقائق مزده % % 34(@)(@@) % أجدى وأسمح من يديه فجودها % % عند الغيوث إذا انتهت لا ينتهي % % 35(@)(@@) % لا عز إلا عند عز الدين مولاي % % الأجل أخي الفخار الأنبه % % 36(@)(@@) % يهب الألوف لمجتديه وظنه % % أن قد حباهم بالأقل الأتفه % % 37(@)(@@) % أنتم بني أيوب أكرم عصبة % % هذا الزمان بفخر سؤددهم زهي % % 38(@)(@@) % وأولو وجوه بل صدور من ندى % % ماء البشاشة والسماحة موه % % 39(@)(@@) % عذبت مواردكم وطابت للورى % % وصفت فلم تأسن ولم تتسنه % % 40(@)(@@) % ما يدعي ملك بلوغ محلكم % % إلا تقول له مساعيكم صه % % PageV01P461 41(@)(@@) % والناصر الملك الصلاح هو الذي % % إلا به اللزبات لم تتنهنه % % 42(@)(@@) % لاه عن اللاهي بديناه وعن % % إعزاز دين الله يوما مالهي % % 43(@)(@@) % فاق الملوك على وإن لم يظفروا % % منها بغير تشبث وتشبه % % 44(@)(@@) % إن الملوك تخلفوا وسبقتم % % أين السوام من العتاق الفره % % 45(@)(@@) % راجيكم من داء كل ملمة % % يشفى وعد سماحكم لم يشفه % % 46(@)(@@) % وعدوكم في مهرب لم ينجه % % ووليكم في مطلب لم ينجه % % 47(@)(@@) % إن يجحد الشاني علاك فما ترى % % إشراق عين الشمس عين الأكمه % % 48(@)(@@) % ولرب مجر رائع حملاته % % وتخاله في الزحف سيل مدهده % % 49(@)(@@) % يقري العواسل من فرائس أسده % % لحما بنار البيض مشعلة طهي % % 50(@)(@@) % متحت به قلب القلوب ذوابل % % أشبهن أشطانا بأيدي مته % % PageV01P462 51(@)(@@) % فالأسمر العسال يحكي ناحلا % % متلوبا من سقمه لم ينقه % % 52(@)(@@) % والأبيض الرعاف يشبه مدنفا % % ألف الضنى وأصابه جرح صهي % % 53(@)(@@) % وهو الذي ترك العدى من رعبه % % يوم اللقاء بصدمه في وهره % % 54(@)(@@) % بك أصبحت راياته منصورة % % يا سيدا عنت الوجوه لوجهه % % 55(@)(@@) % لك في الشهامة والصرامة موقف % % لصفاته إعجاز كل مفوه % % 56(@)(@@) % ما الصارم الهندي غير مكهم % % والباسل الصنديد غير منفه % % 57(@)(@@) % وإذا عزمت تركت أعداء الهدى % % ما بين هلاك وحيرى عمه % % 58(@)(@@) % يا حلف جود للغيوث مخجل % % أبدا وبأس بالليوث مجهجه % % 59(@)(@@) % مولاي من مدحي سواك توجعي % % وإليك من دون 
ms118	 الملوك توجهي % % 60(@)(@@) % أهب الثناء لمجد بيتك طائعا % % وأبيعه لسواك بيع المكره % % PageV01P463 61(@)(@@) % مدح الجميع موجه ومديحكم % % في الصدق والإخلاص غير موجه % % 62(@)(@@) % يفديك مغرور الزمان بلهوه % % ولهاه غرار السراب بلهله % % 63(@)(@@) % مولاي مصر أخملت قدري فكن % % باسمي جزيت الخير خير منوه % % 64(@)(@@) % شرهي على العلياء جر معاطبي % % أمن المعاطب كل من لم يشره % % 65(@)(@@) % ولقد تملى بالسعادة ذو غنى % % عن شقوة المتطلب المتطله % % 66(@)(@@) % أين الكرامة للأفاضل عندكم % % إن لم تكن عند الكرام فأين هي % % 67(@)(@@) % لبى نداء نداك لب رجائه % % فازجر ملم اليأس عنه وانداه % % 68(@)(@@) % أعليت في مصر مكاني بعدما % % خفقت به ولقدره لم يؤبه % % 69(@)(@@) % طلعت نجومكم الثواقب للورى % % زهرا وإني كالسهى عنه سهي % % 70(@)(@@) % جبرت يد الإفضال منه كاسرا % % من فضلي المتكسر المتكده % % PageV01P464 71(@)(@@) % عرف بعرفك منه ما لم يعرفوا % % نبا وعن سنة التغافل نبه % % 72(@)(@@) % فضلي خلوت لأجله من حظوة % % هي للأديب كنبت مرت أجله % % 73(@)(@@) % الفضل مشتعل بنار بلائه % % والحظ مشتغل بأخرق أوره % % 74(@)(@@) % أعر التأمل فقه شعري منعما % % لا يشعر الإنسان ما لم يفقه % % 75(@)(@@) % وتملها غراء جامعة لكم % % في النعت بين تمدح وتمده % % 76(@)(@@) % يهتز ذو الحسنى لجلوة حسنها % % وتجل عن تحسين كل مزهزه % % 77(@)(@@) % أفواه أهل الفضل ناطقة لها % % بالفضل إن قيست بشعر الأفوه % % 78(@)(@@) % وإن العقول لهت لها فلأنها % % محمية عن كل معنى لهله % % 79(@)(@@) % صهباء تودع سامعيها نشوة % % وتعير عرف المسك للمستنكه % % 80(@)(@@) % فوليها بتشوق وتشوف % % وحسودها بتشور وتشوه % % PageV01P465 81(@)(@@) % دم يا ابن شاهنشاه ملكا سيدا % % متوشحا بالسؤدد الشاهنشهي % % 82(@)(@@) % متمليا بهرام شاه ممتعا % % منه بندب سيد شهم شهي % % 83(@)(@@) % لو شاهد اليمني جبهة يمنكم % % ما ظل مفتخرا بخيل الأجبه % % PageV01P466 البحر : كامل تام 1(@)(@@) % لو كان من شكوى الصبابة مشكيا % % لعدا على عدوى الصبابة معديا % % 2(@)(@@) % مات الرجاء فإن أردت حياته % % ونشوره فارج الإمام المحييا % % 3(@)(@@) % أقضى القضاة محمد بن محمد % % من لست منه للفاضل محصيا % % 4(@)(@@) % قاض به قضت المظالم نحبها % % وغدا على آثارهن معفيا % % 5(@)(@@) % يا 
ms119	 كاشفا للحق في أيامه % % غررا يدوم لها الزمان مغطيا % % 6(@)(@@) % لم تنعش الشهباء عند عثارها % % لو لم تجدك لطرد حلمك مرسيا % % 7(@)(@@) % رجفت لسطوتك التي أرسلتها % % نحو الطغاة لحد عزمك ممهيا % % 8(@)(@@) % وتظلمت من شرهم فتململت % % عجل أرجازتها عليها مبقيا % % 9(@)(@@) % أنفت من الثقلاء فيها إذ رمت % % أثقالها ورأتك منها ملجيا % % 10(@)(@@) % حلب لها حلب المدامع سيل % % أن لاقت الخطب الفظيع المبكيا % % PageV01P467 11(@)(@@) % وبعدل نور الدين عاود أفقها % % من بعد غيم الغم جوا مصحيا % % 12(@)(@@) % أضحى لبهجتها معيدا بعدما % % ذهبت وللمعروف فيها مبديا % % 13(@)(@@) % لأمورها متدبرا لشتاتها % % متألفا لصلاحها متوليا % % 14(@)(@@) % فالشرع عاد بعدله مستظهرا % % والحق عاد بظله مستذريا % % 15(@)(@@) % والدهر لاذ بعفوه مستغفرا % % مما جناه مطرقا مستحييا % % PageV01P468 البحر : وافر تام 1(@)(@@) % أحاط بورد وجنته الجني % % بنفسج خط عارضه الطري % % 2(@)(@@) % وجال وشاحه في الخصر منه % % مجال الوهم في السر الخفي % % 3(@)(@@) % وجاذب حقفه غصن قصيف % % فيا ويح الضعيف من القوي % % 4(@)(@@) % يؤاخذ طرفه بالذنب قلبي % % فيا جور السقيم على البري % % 5(@)(@@) % يفيد العاقل اليقظ التغابي % % ليدرك في الغنى حظ الغبي % % 6(@)(@@) % ولم تصب السهام على اعتدال % % بها لولا اعوجاج في القسي % % 7(@)(@@) % فقل للدهر يقصر عن عنادي % % أما هو يتقي بأس التقي % % 8(@)(@@) % حلفت برب مكة والمصلى % % وثاوي ترب طيبة والغري % % 9(@)(@@) % لأنتم يا بني أيوب خير الورى % % بعد الإمام المستضي % % 10(@)(@@) % العيش إذا وصلت ما أحلاه % % والأفق إذا طلعت ما أضواه % % PageV01P469 11(@)(@@) % صل ذا سقم رجاك أن تبراه % % إن أنت هديته فما أهداه % % 12(@)(@@) % في خدك يا مكتم الأهواء % % والريقة من سلافة الصهباء % % 13(@)(@@) % أشياء قد اجتمعن في أشياء % % خد وفم ومقلة نجلاء % % 14(@)(@@) % كم في طلب الراحة قلبي يتعب % % كم في حرم الأمن فؤادي يرعب % % 15(@)(@@) % بالجد أدين والهوى بي يلعب % % كل صعب وهجركم لي أصعب % % 16(@)(@@) % يا صبري حسن غلبة قد غلبك % % يا لبي سحر لحظة قد سلبك % % 17(@)(@@) % يا قلب على النار هواه قلبك % % أرداك فقل بأي ثأر طلبك % % 18(@)(@@) % كم يخلب سحر مقلتيه خلبك 
ms120	 % % ما أطيب في لعب هواه غلبك % % 19(@)(@@) % ما كنت معرضا لبلوى قلبقك % % لو كنت تطيق حفظه من غلبك % % 20(@)(@@) % يا لاح أما مللت من تهذيبي % % قد لاح العذر فكم تهذي بي % % PageV01P470 21(@)(@@) % صدقتك في النصح فدع تكذيبي % % ما أعذب في هواهم تعذيبي % % 22(@)(@@) % لا غرو إذا تنفس المكروب % % فالوجد على فؤاده مشبوب % % 23(@)(@@) % من ينجده وصبره مغلوب % % ما أسعد من يسعده المحبوب % % 24(@)(@@) % ناديت الراح قال قبل شفتي % % أفدي شفة لسقم قلبي شفت % % 25(@)(@@) % ناديت الجور قال هذي صفتي % % ما أطيب عيشتي به لو صفت % % 26(@)(@@) % زارت وتعطفت وبالوعد وفت % % بالوصل لمن أسقمه الهجر شفت % % 27(@)(@@) % أقررت لها بذنب وجدي فعفت % % ما أسعد ليلة بها لي سلفت % % 28(@)(@@) % لا أشرح ما فيك من الوجد لقيت % % لولا أمل الوصل لما كنت بقيت % % 29(@)(@@) % صلني لسعادتي فبالهجر شقيت % % يا حب كفيت شر ما بي ووقيت % % 30(@)(@@) % ما أشوقني إلى ليال سلفت % % نفسي أسفا على مناها تلفت % % PageV01P471 31(@)(@@) % وحشا مهجتي برغمي حلفت % % من بعدكم لأنسها لا ألفت % % 32(@)(@@) % عيني سعدت ومهدتي قد شقيت % % من يرحم مهجتي لما قد لقيت % % 33(@)(@@) % ما أسلمني لو أن نفسي وقيت % % روحي تلفت ولوعتي قد بقيت % % 34(@)(@@) % حتام إلى المحب لا تلتفت % % والسقم به تصعب عنه الصفة % % 35(@)(@@) % ما ضرك لو شفته تلك الشفة % % لا يحسن لا يجمل هذا العنت % % 36(@)(@@) % كم أصبر والعمر مع الدهر يفوت % % كم أعرض عن نطق عذولي بسكوت % % 37(@)(@@) % إن هب نسيمكم فللروح يقوت % % أحيا وأموت ثم أحيا وأموت % % 38(@)(@@) % مولاي إلى هواك أشكو بثي % % إرحم ضعفي وجد بعطف وارث % % 39(@)(@@) % ضدان هما سهولة في وعث % % برئي سقمي فيك وموتي بعثي % % 40(@)(@@) % كانوا حفظوا العهد فلم قد نكثوا % % ساروا عجلا وساعة ما مكثوا % % PageV01P472 41(@)(@@) % كم قد حلفوا لي وأراهم حنثوا % % كانوا بعثوني بسلام بعثوا % % 42(@)(@@) % كم قد حلفوا لي وأراهم حنثوا % % شبوا نارا وهم بقلبي شبثوا % % 43(@)(@@) % يا من بنسيم وصلهم أنبعث % % قد جد هواكم فماذا العبث % % 44(@)(@@) % قد جد هوام مذ بقلبي 