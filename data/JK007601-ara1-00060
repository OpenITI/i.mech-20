ms41	 الله % بالركن ، الصفا ، والمقام % 20(@)(@@) % إن خير القصور أصبح مزهوا % بكره العدى لخير الأنام % PageV01P142 21(@)(@@) % جاور الجعفري ، وانحاز شبدا % % زإليه كالراغب المعتام % 22(@)(@@) % حلل من منازل الملك كالأن % جم ، يلمعن في سواد الظلام % 23(@)(@@) % مفحمات تعيي الصفات فما تد % % رك إلا بالظن والأوهام % 24(@)(@@) % فكأنا نحسها في الأماني ، % أو نراها في طارق الأحلام % 25(@)(@@) % غرف من بناء دين ودنيا ، % يوجب الله فيه أجر الإمام % 26(@)(@@) % شوقتنا إلى الجنان فزدنا % % في اجتناب الذنوب والآثام % 27(@)(@@) % وبها تشرب الأوائل ملكا ، % وتباهي مكاثري الإسلام % 28(@)(@@) % بارك الله للخليفة في المج % % د المعلى ، والمأثرات العظام % % 29(@)(@@) % وأراه آماله في ولاة ال % عهد أهل الوفاء والإنعام % % 30(@)(@@) % لا يزالوا بغبطة وسرور ، % وبقاء ، من ملكه ، ودوام % PageV01P143 البحر : بسيط تام 1(@)(@@) % أعن جوار أبي إسحاق تطمع أن % تزيل رحلي ، يا بهل بن بهلانا % % 2(@)(@@) % غبينة سمتنيها ، لو سمحت بها % % يوما ، لأكفلتها لخما وغسانا % % 3(@)(@@) % اعتدت من قطرك الأقصى لتقمرني % % بني المدبر أنصارا ، وأعوانا % % 4(@)(@@) % يرضاهم الناس أربابا لسؤددهم ، % فكيف أسخطهم ، يا بهل إخوانا % % 5(@)(@@) % هبني غنيت بوفري عن نوالهم ، % فكيف أصنع بالإلف الذي كانا % % 6(@)(@@) % عهد من الأنس عاقرنا الكؤوس على % % بديئه ، وخبطنا فيه أزمانا % % 7(@)(@@) % نماز عنه كهولا ، بعد كبرتنا ، % وقد قطعنا به الأيام شبانا % % 8(@)(@@) % أصادق لم أكذبهم مودتهم ، % ولم أدعهم لشيء عز أوهانا % % 9(@)(@@) % ولم أكن بائعا بالرغب عبدهم ، % وأنت تطلبهم ، يا بهل ، مجانا % % 10(@)(@@) % إذهب إليك ، فلا محظى بعارفة ، % ولا مصيبا ، لما حاولت ، إمكانا % % PageV01P144 البحر : متقارب تام 1(@)(@@) % تعاط الصبابة ، أو عانها ، % لتعذر في برح أشجانها % % 2(@)(@@) % وما نقلت لوعتي لمة ، % تنقل في حدث ألوانها % % 3(@)(@@) % أوائل شيب يشير العذول % إليها ، ويكبر من شأنها % % 4(@)(@@) % إذا حرم االلهو من أجلها ، % غلا في مقادير أوزانها % % 5(@)(@@) % وإلا تجدني مطيعا لها ، % فلم أعصها كل عصيانها % % 6(@)(@@) % متى جئت بائقة في الهوى ، % فأسرارها دون إعلانها % % 7(@)(@@) % تعامى رجال عن المكرما % % ت ، وقد مثلت نصب أعيانها % % 8(@)(@@) % ولم تلتفت لوجوب الحقوق ، % وواجبها خلف آذانها % % 9(@)(@@) % فتحت يدي 
ms42	 ثاني العطف عن % كذوب المودة ، خوانها % % 10(@)(@@) % وقد علمت خلتي أنني % % أفارقها ، عند هجرانها % % PageV01P145 11(@)(@@) % وإني لأسكن جأشا إلى % % رباع الكرام ، وأوطانها % % 12(@)(@@) % وبعدت نفسي من مالها ، % وما أبعدت مال إخوانها % % 13(@)(@@) % رضيت خليلي أبا غالب ، % لكسر الخطوب ، وإيهانها % % 14(@)(@@) % تعد له فارس قربة ، % وزلفى بكسرى بن ساسانها % % 15(@)(@@) % إذا سئلت عنه عند الفخار ، % قالت بأصدق عرفانها % % 16(@)(@@) % يطولون منه بإنسانهم ، % وللعين طول بإنسانها % % 17(@)(@@) % هتكنا إليه حجاب الدجى ، % بخوص تباري بركبانها % % 18(@)(@@) % تكلفنا لنروم الوداع % مسافة قم وقاسانها % % 19(@)(@@) % وسن سميرة طيف الفتاة % تبسم عن ظلم أسنانها % % 20(@)(@@) % إذا استشرقت لمعان الثلوج % أطاعت له قبل إبانها % % PageV01P146 21(@)(@@) % فهالك أنجز أعوانها % % فوق السحاب وأعنانها % % 22(@)(@@) % إلى الملك غلقت عنده % رقاب المديح بأثمانها % % 23(@)(@@) % وقيت الحمام بمثنى النفوس % من الحاسدين ووحدانها % % 24(@)(@@) % تبوخ المعالي ، إذا لم يكن % بكفيك إذكاء نيرانها % % 25(@)(@@) % وتجزل في القوم حتى تكون % فعالك أنجز أعوانها % % 26(@)(@@) % حمت قضب المجد من أن تكون % % صلاء صلابة عيدانها % % 27(@)(@@) % وعافت بك الذم نفس جرت % إلى الحمد ، في طول ميدانها % % 28(@)(@@) % أخذت العطايا بتكرارها ، % وإبداء طول بثنيانها % % 29(@)(@@) % أرى بذلها ، عند إعوازها ، % سوى بذلها عند إمكانها % % 30(@)(@@) % وأحسن مأثرة للكرام ، % إحسانها عند إحسانها % % PageV01P147 31(@)(@@) % وما يتنمى إلى المكرمات % % فيفرعها ، غير فرسانها % % 32(@)(@@) % لمن عاد بعدي عن ساحتيك % بنقص حظوظي ، وخسرانها % % 33(@)(@@) % وكان اجتنابيك إحدى الذنوب ، % فقصديك أولى بغفرانها % % 34(@)(@@) % وما عوقبت عصبة ، أمنت % على كفرها ، بعد إيمانها % % 35(@)(@@) % فإن خواتيم أعمال ما % % تراه جوامع أديانها % % PageV01P148 البحر : خفيف تام 1(@)(@@) % ملنا ، أم نبا بنا ، أم جفانا ، % أم قلانا ، فاعتاض عنا سوانا % % 2(@)(@@) % ساخط نبتغي رضاه ولا يس % أل عن سخطنا ، ولا عن رضانا % % 3(@)(@@) % ونبالي ألا نرى ذا تجن % لا يبالي الزمان ، ألا يرانا % % 4(@)(@@) % صيق العذر في الضراعة ، إنا % % لو قنعنا بقسمنا لكفانا % % 5(@)(@@) % ما لنا نعبد العباد إذا كا % % ن ، إلى الله ، فقرنا وغنانا % % PageV01P149 البحر : خفيف تام 1(@)(@@) % إدمع قد أغرين بالهملان ، % وفؤاد قد لج في الخفقان % 2(@)(@@) % إن يوم 
ms43	 الكثيب أفقدنا نض % رة تلك القضبان والكثبان % 3(@)(@@) % بفراق ألم بعد اجتماع ، % وتناء أقام بعد تدان % 4(@)(@@) % إبكيا هذه المغاني التي أخ % لمقها بعد عهدها بالغواني % % 5(@)(@@) % أسعد الغيث إذ بكاها وإن كان % خليا من كل ما تجدان % 6(@)(@@) % جاد فيها بنفسه ، فاستجدت % حللا منه ، جمة الألوان % 7(@)(@@) % فهي تهتز بين إفرنده الأخ % ضر ، حسنا ، ووشيه الأرجواني % % 8(@)(@@) % في سماء من خضرة الروض فيها % % أنجم من شقائق النعمان % 9(@)(@@) % واصفرار من لونه ، وابيضاض % كاجتماع الحوذان والأقحوان % 10(@)(@@) % صاغ منها الربيع شكلا لأخلا % % ق حسين ذي الجود والإحسان % PageV01P150 11(@)(@@) % فكأن الصبا تردد فيها % % بنسيم الكافور ، والزعفران % 12(@)(@@) % قد تصابيت ، فاعذري ، أو فلومي ، % ليس شيء من الصبى من شاني % % 13(@)(@@) % وتذكرت وافد الشيب فاستع % % جلت حظي في الراح والريحان % 14(@)(@@) % عند عدل من الزمان إذا استق % بنثير الياقوت ، والمرجان % 15(@)(@@) % ولقد أمزج المدام بفتر ، % بل بسحر من مقلتي أرسلان % 16(@)(@@) % وأعاطي كؤوسها الملك الأب % % لخ ، فعل الندمان والندمان % 17(@)(@@) % فكأني أنادم القمر البد % ر عليها ، في ذلك الإيوان % 18(@)(@@) % يزدهيه من العلى كبرياء % فيه ، أن يزدهي على الإخوان % 19(@)(@@) % وعليه من الندى سيمياء ، % وصلت مدحه بكل لسان % 20(@)(@@) % غمرته جلالة الملك ، واستو % % لت عليه شمائل الفتيان % PageV01P151 21(@)(@@) % واصل مجده بعقد الثريا ، % ويداه بالجود موصولتان % 22(@)(@@) % يا أبا القاسم المقسم في المج % د ليوم الندى ويوم الطعان % 23(@)(@@) % قد ورثت العلياء عن أزدشير ، % وقباذ ، وعن أنوشروان % 24(@)(@@) % وأرى الليل والنهار سواء ، % حين تبدو بوجهك الإضحيان % PageV01P152 البحر : بسيط تام 1(@)(@@) % ليت الخليط الذي قد بان لم يبن % وليت ما كان من حبيك لم يكن % 2(@)(@@) % أحرى العيون بأن تجري مدامعها % % عين ، بكت شجوها من منظر حسن % 3(@)(@@) % يا نظرة لي من الشمس التي طلعت % في الرائحين ، بسرب الزبرب القطن % 4(@)(@@) % ما أحسن الصبر ، إلا عند فرقة من % ببثه صرت بين البث والحزن % 5(@)(@@) % كثيب رمل على عليائه فنن ، % وشمس دجن بأعلى ذلك الفنن % 6(@)(@@) % ما تقع العين منها حين تلحظها ، % إلا على فتنة من 
ms44	 أقتل الفتن % 7(@)(@@) % قامت تثنى ، فلانت في مجاسدها ، % حتى كأن قضيب البان لم يلن % 8(@)(@@) % لي عن قليل لا يلم به % وجد عليك ، وقلب غير مرتهن % 9(@)(@@) % إن الهموم ، إذا أوطن في خلد % للمرء ، سار ولم يربع على وطن % 10(@)(@@) % إلى المهذب إبراهيم أوصلنا % % آذي دجلة في عير من السفن % PageV01P153 11(@)(@@) % غرائب الريح تحدوها ، ويجنبها % % هاد من الماء ، منقاد بلا رسن % 12(@)(@@) % جئناك نحمل ألفاظا مدبجة ، % كأنما وشيها من يمنة اليمن % 13(@)(@@) % كأنها وهي تمشي البخترية في % % يدي أبي الفضل أو في نائل الحسن % 14(@)(@@) % نهدي القريض إلى رب القريض معا % كحامل العصب يهديه إلى عدن % 15(@)(@@) % من كل زهراء ، كالنوار ، مشرقة ، % أبقى على الزمن الباقي من الزمن % 16(@)(@@) % شكر امرىء ظل مشغولا بشكرك عن % % فرط البكاء على الأطلال ، والدمن % 17(@)(@@) % قد قلت إذ بسطت كفاك من أملي : % ما شاء من نائبات الدهر ، فليكن % 18(@)(@@) % رضيت منك بأخلاق قد امتزجت % بالمكرمات امتزاج الروح بالبدن % 19(@)(@@) % وزدتني رغبة في عقد ودك ، إذ % شفعت ذاك الندى بالفهم ، والفطن % 20(@)(@@) % من يصبه سكن ممن يحب ، ومن % % يهوى ، فما لك غير الجود من سكن % PageV01P154 21(@)(@@) % بدني إلى الجود كفا منك قد أنست % بالبذل والعرف أنس العين بالوسن % PageV01P155 البحر : خفيف تام 1(@)(@@) % أرق العين أن قرة عيني % % دخلت بينه الليالي ، وبيني % % 2(@)(@@) % إن يقدر لنا الزمان التقاء ، % فهو حكمي على الزمان ، وديني % % 3(@)(@@) % ما لشيء بشاشة ، يعد شيء ، % كتلاق مواشك ، بعد بين % PageV01P156 البحر : منسرح 1(@)(@@) % قل لأبي جعفر ، فإن له % يدا ينال البعيد نائلها % % 2(@)(@@) % تأبى يد الغيث أن تساجلها ، % ويقصر الدهر أن يطاولها % % 3(@)(@@) % بقيت في قاسط ، فحينئذ % تبقى ربى المجد والعلاء لها % % 4(@)(@@) % منعت بالمرهفات جارمها ، % وعلت بالمكرمات عائلها % % 5(@)(@@) % تعد أفعالك الحصينة ، إن % قبيلة عددت معاقلها % % 6(@)(@@) % كم لك فيها من نائل ويد ، % سدت به بكرها ووائلها % % 7(@)(@@) % أذيع جدواك أمأكون كمن % يكتم شؤبوبها ووابلها % % 8(@)(@@) % ها إنها نعمة ، إذا ذكرت ، % كانت عطاء ، وكنت باذلها % % 9(@)(@@) % لن يتولى إتمام آخرها ، % إلا كريم 
ms45	 أنشا أوائلها % % 10(@)(@@) % كنت ببدء الإحسان عاجلها ، % فكن بعود الإحسان آجلها % % PageV01P157 البحر : متقارب تام 1(@)(@@) % هجاني النغيل ، وما خلتني % % أخاف هجاء أبي حرمله % 2(@)(@@) % وقد كنت أطنب في وصفه ، % وتشبيت نسبته المشكله % 3(@)(@@) % أرجي تلونه بالصفا ، % وألقى قطيعته بالصله % 4(@)(@@) % أراه وفيا ، وأنى له % وفاء ، إذا كان لا أصل له % 5(@)(@@) % فلا تحمدان من أخ آخر % إذا أنت لم تختبر أوله % 6(@)(@@) % فإن يك أخلف ظني به ، % وحال عن العهد أو بدله % 7(@)(@@) % فما كنت أول من فاته ، % لدى صاحب ، بعض ما أمله % 8(@)(@@) % ألم أختصصك بما قد علم % % ت من الود ، والمقة المكمله % 9(@)(@@) % وأسأل فيك أبا صالح ، % وما كان حقك أن أسأله % % 10(@)(@@) % أخبر أنك مستوجب % للطف المحلة ، والمنزله % PageV01P158 11(@)(@@) % وكان جزائي ما قد علم % % ت وما لم يكن لك أن تفعله % 12(@)(@@) % أراك رجعت إلى جدك ال % % شريف ، وقصتك المعضله % 13(@)(@@) % ومسراه في بطن قوصره ، % مخرقة الخوص ، مستعمله % 14(@)(@@) % إذا اسود من خلف تشبيكها ، % توهمته الطن في الدوخله % 15(@)(@@) % فلله هيئته مصبحا ، % وقد وجدوه على المزبله % 16(@)(@@) % يعبي الذباب كراديسه ، % فتغشاه قنبلة قنبله % 17(@)(@@) % هنالك لو تدعيه قشير % لما خيلت أنها مبطله % PageV01P159 البحر : متقارب تام 1(@)(@@) % أبا جعفر ! ليس فضل الفتى % % إذا راح في فرط إعجابه % 2(@)(@@) % ولا في فراهة برذونه ، % ولا في نظافة أثوابه % 3(@)(@@) % ولكنه في الفعال الكريم % والخطر الأشرف النابه % 4(@)(@@) % رأيتك تهوى اقتناء المديح % وتجهل مقدار إيجابه % 5(@)(@@) % وكيف ترجي وصولا إليه % ولم تتوصل بأسبابه % 6(@)(@@) % وإن أتطلب به نائلا ، % فلست مليئا بإطلابه % 7(@)(@@) % وإن أتصدق به حسبة ، % فإن المساكين أولى به % PageV01P160 البحر : خفيف تام 1(@)(@@) % قصة التل ، فاسمعوها عجابه ، % إن في مثلها تطول الخطابه % 2(@)(@@) % لإدعى التل فرقتان تلاحوا : % آل عبد الأعلى ، وآل ثوابه % 3(@)(@@) % حكم العادل الجنيدي فيهم % % بصواب ، فلا عدمنا صوابه % 4(@)(@@) % إحفروا التل يا بني عبد الأع % لى ، وأثيروا صخوره وترابه % 5(@)(@@) % إن وجدتم فيه شباك أبيكم ، % كنتم دون غيركم أربابه % 6(@)(@@) % أو وجدتم محاجما ، إن حفرتم ، % زال شك 
ms46	 العصابة المرتابه % 7(@)(@@) % فبدت جونة من الخوص فيها % % آلة الشيخ ، وهو جد لبابه % PageV01P161 البحر : - 1(@)(@@) % ألا لله درك ، يا جللتا ، % وما أخرجت من أهل الكتابه % 2(@)(@@) % نقلت عن المشارط والمواسي % % إلى الأقلام ، حال بني ثوابه % PageV01P162 البحر : - 1(@)(@@) % إن الزمان سو ، % وجميع هذا الخلق بو % 2(@)(@@) % فإذا سألتهم ندى ، % فجوابهم عن ذاك وو % 3(@)(@@) % لو يمكلون الضوء بخ % % لا لم يكن للخلق ضو % 4(@)(@@) % ذهب الكرام بأسرهم ، % وبقي لنا ليت ولو % PageV01P163 البحر : - 1(@)(@@) % لنا أبدا يث نعانيه في أروى ، % وحزوى ، وكم أدنتك من لوعة حزوى % % 2(@)(@@) % وما كان دمعي قبل أروى بنهزة % لأدنى خليط بان أو منزل أقوى % % 3(@)(@@) % إذا ارتاح للإحسان ، أيهما أضوى % % تعلقها قلب مريض ، بها يدوى % % 4(@)(@@) % وأكثرت من شكوى هواها ، وإنما % % أمارة برح الحب أن تكثر الشكوى % % PageV01P164 البحر : خفيف تام 1(@)(@@) % باكرتنا بواكر الوسمي ، % ثم راحت ، وأقبلت بالولي % 2(@)(@@) % وأرى الغيث ليس ينفك يهمي % % في غداة مخضلة ، وعشي % 3(@)(@@) % فسقى الأرض ريها من نداه ، % فاسقني ، من سلافة الراح ، ريي % % 4(@)(@@) % أصبحت بهجة النعيم ، وأمست % بين قصر الصبيح والجعفري % 5(@)(@@) % في البناء العجيب ، والمنزل الآ % % نس ، والمنظر الجميل ، والبهي % 6(@)(@@) % ورياض تصبو النفوس إليها ، % وتحيا بنورهن الجني % 7(@)(@@) % دار ملك مختارة لإمام ، % أحرزت كفه تراث النبي % 8(@)(@@) % وهب الله للرعية منه % سيرة الفاضل ، التقي ، الذكي % 9(@)(@@) % فهي محبوة بإحسانه الضا % % في عليها ، وحكمة المرتضي % 10(@)(@@) % يا إمام الهدى ، ويا صاحب الحق ، % ويا ابن الرشيد ، والمهدي % PageV01P165 11(@)(@@) % ليدم دهرك المحبب في النا % % س بعمر باق ، عيش رضي % PageV01P166 
ms47	