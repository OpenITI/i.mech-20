ms3152	 بك ضر فدعوته كشفه عنك ، ومن إذا أصابك عام سنة فدعوته أنبت لك ، ومن إذا كنت في أرض قفر فأضللت فدعوته رد عليك ) )(@)(@@) . ( حم ، عن أبي تميمة المجمي عن رجل من قومه أتاى للنبي رجل فقال : أنت رسول الله ؟ قال : نعم ، قال : ما تدعو لي ؟ فذكره فأسلم ) . .(@)(@@)(@@)(@@) $ 153 / 29178 قال النبي :(@)(@@) | 30 ( ادعوا إلي بصحيفة ودواة أكتب لكم كتابا لا تضلوا بعدي أبدا ، فكرهنا ذالك أشد الكراهة ) )(@)(@@) . ( طس ، عن عمر رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 154 / 29179 قال النبي :(@)(@@) | 30 ( ادفع صدقة أموالك إلاى أبي بكر ، فإذا قبض فإلاى عثمان ) )(@)(@@) . ( طك ، عن عصمة رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 155 / 29180 قال النبي :(@)(@@) | 30 ( ادفعوها إليهم ما صلوا الخمس ) )(@)(@@) . ( طس ، عن سعد بن أبي وقاص رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 156 / 29181 قال النبي :(@)(@@) | 30 ( ادفنوهم بدمائهم وثيابهم يعني قتلاى أحد ) )(@)(@@) . ( حم ، عن ابن عباس رضي الله عنهما ) . .(@)(@@)(@@)(@@) $ 157 / 29182 قال النبي :(@)(@@) | 30 ( أدنه ! يا أمين الله وأمين في السماء علاى مالك بالحق ، أما إن لك عندي دعوة وقد أخرتها قاله لعبد الرحمان بن عوف ) )(@)(@@) . ( طك ، عن ابن أبي أوفاى رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 158 / 29183 قال النبي :(@)(@@) | 30 ( أدناى الناس عذابا رجل منتعل بنعلين من نار يغلي منهما دماغه مع إجراء العذاب ، ومنهم من يكون في النار إلاى صدره مع إجراء PageV10P034 العذاب ، ومنهم من يكون في النار إلاى ترقوته مع إجراء العذاب ، ( تكرار : ومنهم من يكون في النار إلاى ترقوته مع إجراء العذاب ، ) ومنهم من قد انغمس فيها ) )(@)(@@) . ( بز ، عن أبي سعيد رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 159 / 29184 قال النبي :(@)(@@) | 30 ( أدناى أهل الجنة حظا أو نصيبا قوم يخرجهم الله من النار فيرتاح لهم الرب جل وعلا أنهم كانوا لا يشركون بالله شيئا ، فينبذون بالعراء فينبتون كما تنبت البقل ، حتى إذا خرجت الأرواح في أجسادهم قالوا ربنا أنت الذي أخرجتنا من النار ورجعت الأرواح إلاى أجسادنا فاصرف وجوهنا عن النار ) )(@)(@@) . ( بز ، عن أبي هريرة رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 160 / 29185 قال النبي :(@)(@@) | 30 ( أدناى أهل الجنة منزلة من له 
ms3153	 خمس درجات وهو علاى السادسة وفوقه السابعة ، وإن له لثلاثمائة خادم ، ويغداى عليه كل يوم ويراح بثلاثمائة صحفة من ذهب ، في كل صحفة ما ليحس في الأخراى ، وإنه ليلذ بأوله كما يلذ بآخره ، وإنه ليقول يا رب لو أذنت لي لأطعمت أهل الجنة وسقيتهم لم ينقص مما عندي شيء ، وإن له من الحور العين لاثنين وسبعين زوجة من الدنيا وأن الواحدة لتأخذ مقعدها قدر ميل من الأرض ) )(@)(@@) . ( بز ، عن أبي هريرة رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 161 / 29186 قال النبي :(@)(@@) | 30 ( أدناى أهل النار عذابا الذي له نعلان من نار يغلي منها دماغه ) )(@)(@@) . ( طس ، عن أبي هريرة رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 162 / 29187 قال النبي :(@)(@@) | 30 ( أدوها أي زكاة الفطر عن الصغير والكبير والحر والعبد ، فإنها طهور لكم ) )(@)(@@) . ( طس ، عن أبي سعيد رضي الله عنه قال ناس : أو لو ماشية وإنا نخرج زكاتها فهل تجزىء عنا من زكاة رمضان فذكره ) . .(@)(@@)(@@)(@@) ||| ( الهمزة مع الذال )(@)(@@)(@@)(@@) $ 163 / 29188 قال النبي :(@)(@@) | 30 ( إذا ابتاع أحدكم الجارية فليكن أول ما يطعمها الحلو ، فإنها أطيب لنفسها ) )(@)(@@) . ( طس ، عن معاذ بن جبل رضي الله عنه ) . .(@)(@@) PageV10P035(@)(@@)(@@)(@@) $ 164 / 29189 قال النبي :(@)(@@) | 30 ( إذا أتاى حدكم أهله فأقحط فلا غسل ) )(@)(@@) . ( بز ، طك ، عن أبي هريرة رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 165 / 29190 قال النبي :(@)(@@) | 30 ( إذعا أتاى أحدكم خادمه بطعام فليدنه ، فليقعد عليه أو ليلقمه فإنه ولي حره ودخانه ) )(@)(@@) . ( حم ، عن ابن مسعود رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 166 / 29191 قال النبي :(@)(@@) | 30 ( إذا أتي أحدكم بالطيب فليصب منه ، وإذا أتي بالحلواء فليصب منها ) )(@)(@@) . ( طس ، عن أبي هريرة رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 167 / 29192 قال النبي :(@)(@@) | 30 ( إذا أتيت سلطانا مهيبا تخاف أن يسطو بك فقل : الله أكبر الله أكبر من خلقه جميعا ، الله أعز مما أخاف وأحذر ، أعوذ باالله الذي يمسك السماء أن تقع علاى الأرض إلا بإذنه من شر عبدك فلان وجنوده وأتباعه وأشياعه من الجن والإنس ، إلاهي كن لي جارا من شرهم جل ثناؤك وعز جارك وتبارك اسمك ولا إلاه غيرك ) )(@)(@@) . ( طك ، عن ابن عباس 
ms3154	 رضي الله عنهما ) . .(@)(@@)(@@)(@@) $ 168 / 29193 قال النبي :(@)(@@) | 30 ( إذا أتيتم الجمعة فادنوا من الإمام واستمعوا الخطبة ولا تلغوا ) )(@)(@@) . ( بز ، عن سمرة رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 169 / 29194 قال النبي :(@)(@@) | 30 ( إذا أحب الله عبدا حماه من الدنيا كما يحمي أحدكم مريضه الماء حتى يشفى ) )(@)(@@) . ( ع ، عن عقبة بن رافع رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 170 / 29195 قال النبي :(@)(@@) | 30 ( إذا أخذت مضجعك فقل : أعوذ بوجه الله الكريم وكلماته التامة من شر ما أنت آخذ بناصيته ، اللهم أنت تكشف المغرم والمأثم ، اللهم لا تهزم جندك ، ولا تخلف وعدك ، ولا ينفع ذا الجد منك الجد سبحانك وبحمدك ) )(@)(@@) . ( طس ، عن علي رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 171 / 29196 قال النبي :(@)(@@) | 30 ( إذا أراد الله أن يخلق نسمة قال ملك الأرحام معرضا : أي رب أذكر أم أنثاى ؟ فيقضي الله أمره ، ثم يكتب بين عينيه ما هو لاق حتى النكبة ينكبها ) )(@)(@@) . ( ع ، بز ، عن ابن عمر رضي الله عنهما ) . .(@)(@@) PageV10P036(@)(@@)(@@)(@@) $ 172 / 29197 ( الكلام مبدل : قال النبي :(@)(@@) | 30 ( إذا أتاى أحدكم أهله فأقحط فلا غسل ) )(@)(@@) . ( بز ، طك ، عن أبي هريرة رضي الله عنه ) . . )(@)(@@)(@@)(@@) $ 173 / 29198 قال النبي :(@)(@@) | 30 ( إذا أراد الله أن يؤثر عبدا أعماى عليه الحيل ) )(@)(@@) . ( طس ، عن عثمان رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 174 / 29199 قال النبي :(@)(@@) | 30 ( إذا أراد الله أن يوحي بأمره تكلم بالوحي ، فإذا تكلم بالوحي أخذت السماوات رجفة شديدة من خوف الله ، فإذا سمع بذالك أهل السماوات صعقوا وخروا سجدا ، فيكون أولهم يرفع رأسه جبريل فيكلمه الله من وحيه بما أراد ، فينتهي به جبريل علاى الملائكة كلما مر بسماء قال له أهلها ماذا قال ربنا يا جبريل ؟ فيقول جبريل : قال الحق وهو العلي الكبير ، فيقولون كلهم مثل ما قال جبريل فينتهي به جبريل حيث أمر من السماء والأرض ) )(@)(@@) . ( طك ، عن النواس بن سمعان رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 175 / 29200 قال النبي :(@)(@@) | 30 ( إذا أراد الله بعبده خيرا ابتلاه ، وإذا ابتلاه أضناه ، قالوا : يا رسول الله ! وما أضناه ؟ قال : لا يترك له أهلا ولا مالا ) )(@)(@@) . ( طك ، عن أبي عتيبة الخولاني 
ms3155	 رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 176 / 29201 قال النبي :(@)(@@) | 30 ( إذا أراد الله بعبده خيرا استعمله قبل موته ، قيل : وما استعمله ؟ قال : يفتح له عملا صالحا بين يدي موته حتى يرضى عنه من حوله ) )(@)(@@) . ( حم ، بز ، طكس ، عن عمرو بن الحمق رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 177 / 29202 قال النبي :(@)(@@) | 30 ( إذا أراد الله بعبده خيرا عجل له عقوبة ذنبه في الدنيا ، وإذا أراد الله بعبده شرا أمسك عليه عقوبة ذنبه حتى يوافيه يوم القيامة ) )(@)(@@) . ( حم ، طك ، عن عبد الله بن مغفل رضي الله عنه ) . .(@)(@@) PageV10P037(@)(@@)(@@)(@@) $ 178 / 29203 قال النبي :(@)(@@) | 30 ( إذا أراد الله بعبده خيرا غسله ، قيل : وكيف يغسله ؟ قال : يوفقه لعمل صالح قبل موته فيقبضه عليه ) )(@)(@@) . ( طس ، عن عائشة رضي الله عنها ) . .(@)(@@)(@@)(@@) $ 179 / 29204 قال النبي :(@)(@@) | 30 ( إذا أراد الله بقوم خيرا أدخل عليهم الرفق ) )(@)(@@) . ( بز ، عن جابر رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 180 / 29205 قال النبي :(@)(@@) | 30 ( إذا أراد الله قبض عبد بأرض جعل له إليها حاجة ، فإذا بلغها قبض فيها ) )(@)(@@) . ( بز ، عن أبي عزة رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 181 / 29206 قال النبي :(@)(@@) | 30 ( إذا أراد الجنب أن ينام يتوضأ وضوءه للصلاة ) )(@)(@@) . ( طك ، عن عدي بن حاتم رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 182 / 29207 قال النبي :(@)(@@) | 30 ( إذا أراد الرجل أن يزوج ابنته فليستأذنها ) )(@)(@@) . ( ع ، عن أبي موساى رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 183 / 29208 قال النبي :(@)(@@) | 30 ( إذا أراد العبد الصلاة من الليل أتاه ملك فقال له : قم فقد أصبحت فصل واذكر ربك ، فيأتيه الشيطان فيقول : عليك ليل طويل وسوف تقوم ، فإن قام وصلى أصبح نشيطا خفيف الجسم قرير العين ، وإن هو أطاع الشيطان حتى أصبح بال في أذنه ) )(@)(@@) . ( طس ، عن ابن مسعود رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 184 / 29209 قال النبي :(@)(@@) | 30 ( إذا أراد أحدكم أن يسأل ربه فليبدأ بالمدحة والثناء علاى الله بما هو أهله ، ثم ليصل علاى النبي ثم يدعو بعدها بما جدر أن ينجح ) )(@)(@@) . ( طك ، عن ابن مسعود رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 185 / 29210 قال النبي :(@)(@@) | 30 ( إذا أردت أن تكر فاشتر فرسا أغر محجلا مطلق اليمين 
