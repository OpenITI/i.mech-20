ms421	 قد تو جعد شمشاد %~% بر جبهت بوستان مبینام(@)(@@) 9 یک دانه آفتاب بی‌تو %~% بر گردن آسمان مبینام(@)(@@) 10 از دانه دل ز کشت شادی %~% یک خوشه به سالیان مبینام(@)(@@) 11 در آینه دل از خیالت %~% جز صورت جان عیان مبینام(@)(@@) 12 در آینه خیالت از خود %~% جز موی خیال سان مبینام(@)(@@) 13 تا وصل تو زان جهان نیاید %~% دل را سر این جهان مبینام(@)(@@) 14 جز اشک وداعی من و تو %~% طوفان جهان ستان مبینام(@)(@@) 15 چون حقه سینه برگشایم %~% جز نام تو در میان مبینام(@)(@@) 16 گر عمر کران کنم به سودات %~% سودای تو را کران مبینام(@)(@@) 17 گفتی دگری کنی مفرمای %~% کاین در ورق گمان مبینام(@)(@@) 18 بی‌تو من و عیش حاش‌لله %~% کز خواب خیال آن مبینام(@)(@@) 19 خاقانی را ز دل چه پرسی %~% کانست که کس چنان مبینام(@)(@@) 20 حالی که به دشمنان نخواهم %~% حسب دل دوستان مبینام(@)(@@) 21 غمخوار تو را به خاک تبریز %~% جز خاک تو غم نشان مبینام PageV1P0547(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 صبح وارم کآفتابی در نهان آورده‌ام %~% آفتابم کز دم عیسی نشان آورده‌ام(@)(@@) 2 عیسیم از بیت معمور آمده وز خوان خلد %~% خورده قوت وزله اخوان را ز خوان آورده‌ام(@)(@@) 3 هین صلای خشک ای پیران تر دامن که من %~% هر دو قرص گرم و سرد آسمان آورده‌ام(@)(@@) 4 طفل زی مکتب برد نان من ز مکتب آمده %~% بهر پیران ز افتاب و مه دو نان آورده‌ام(@)(@@) 5 گر چه عیسی‌وار ازینجا بار سوزن برده‌ام %~% گنج قارون بین کز آنجا سو زیان آورده‌ام(@)(@@) 6 رفته زینسو لاشه‌ای در زیر و ز آنس بین کنون %~% کابلق گیتی جنیبت زیر ران آورده‌ام(@)(@@) 7 از نظاره موی را جانی که هر مویی مرا %~% طوطی گویاست کز هندوستان آورده‌ام(@)(@@) 8 من نه پیل آورده‌ام بس‌بس نظاره کز سفر %~% پیل بالا طوطی شکرفشان آورده‌ام(@)(@@) 9 در گشاده دیده‌ام خرگاه ترکان فلک %~% ماه را بسته میان خرگان سان آورده‌ام(@)(@@) 10 
ms422	 از سفر می‌آیم و در راه صید افکنده‌ام %~% اینت صیدی چرب پهلو کارمغان آورده‌ام(@)(@@) 11 گر سواران خنگ توسن در کمند افکنده‌اند %~% من کمند افکنده و شیر ژیان آورده‌ام(@)(@@) 12 چشم بد دور از من و راهم که راه آورد عشق %~% رهروان را سرمه چشم روان آورده‌ام(@)(@@) 13 بس که در بحر طلب چون صبح شست افکنده‌ام %~% تا در آن شست سبک صید گران آورده‌ام(@)(@@) 14 نقد شش روز از خزانه هفت گردون برده‌ام %~% گرچه در نقب افکنی چل شب کران آورده‌ام(@)(@@) 15 خاک پای خاک بیزان بوده‌ام تا گنج زر %~% کرده‌ام سود ار بهین عمری زیان آورده‌ام(@)(@@) 16 خاک بیزی کن که من هم خاک بیزی کرده‌ام %~% تا ز خاک این مایه گنج شایگان آورده‌ام(@)(@@) 17 دیده‌ام عشاق ریزان اشک داود از طرب %~% آن همه چون سبحه در یک ریسمان آورده‌ام(@)(@@) 18 اشک من در رقص و دل در حال و ناله در سماع %~% من دریده خرقه صبر و فغان آورده‌ام(@)(@@) 19 زردی زر شادی دلهاست من دلشاد از آنک %~% سکه رخ را زر شادی‌رسان آورده‌ام(@)(@@) 20 شمع زرد است از نهیب سر منم هم زرد لیک %~% زرد روئی نز نهیب سر نشان آورده‌ام(@)(@@) 21 بل کز آن زردم که ترسم سر نبرندم چو شمع %~% کاین سر از بهر بریدن در میان آورده‌ام(@)(@@) 22 هان رفیقا نشره آبی یا زگالابی بساز %~% کز دل و چهره زگال و زعفران آورده‌ام(@)(@@) 23 شو نمک بر آتش افکن کز سر خوان بهشت %~% خوش نمک در طبع و شکر در زبان آورده‌ام(@)(@@) 24 وز پی دندان سپیدی همرهان از تف آه %~% دل چو عود سوخته دندان کنان آورده‌ام(@)(@@) 25 گرچه شب‌ها از سموم آه تب‌ها برده‌ام %~% از نسیم وصل مهر تب نشان آورده‌ام(@)(@@) 26 زان چهان می‌آیم از رنجی که دیدم زین جهان %~% لیک طغرای نجات آن جهان آورده‌ام(@)(@@) 27 دیده‌ام سرچشمه خضر و کبوتروار آب %~% خورده پس جرعه ریزی در دهان آورده‌ام 
ms423	(@)(@@) 28 چون کبوتر رفته بالا و آمده بر پای خویش %~% بسته زر تحفه و خط امان آورده‌ام(@)(@@) 29 من کبوتر قیمتم بر پای دارم سرب‌ها %~% آن‌قدر زری که سوی آشیان آورده‌ام(@)(@@) 30 زیوری آورده‌ام بهر عروسان بصر %~% گوئی از شعری شعار فرقدان آورده‌ام(@)(@@) 31 لعبتان دیده را کایشان دو طفل هندواند %~% هم مشاطه هم حلی هم دایگان آورده‌ام(@)(@@) 32 پیر عشق آنجا به عرسی پاره می‌کرد آسمان %~% من نصیبه شانه دانی بی‌گمان آورده‌ام(@)(@@) 33 این فراویزی و آن باز افکنی خواهد ز من %~% من زجیب آسمان یک شانه‌دان آورده‌ام(@)(@@) 34 دیده‌ام خلوت سرای دوست در مهمان‌سراش %~% تن طفیل و شاهد دل میهمان آورده‌ام(@)(@@) 35 میزبان در حجره خاص و برون افکنده خوان %~% من دل و جان پیش خوان میزبان آورده‌ام(@)(@@) 36 دل ملک طبع است قوت او ز بویی داده‌ام %~% جان پری‌وار است خوردش استخوان آورده‌ام(@)(@@) 37 نقل خاص آورده‌ام زانجا و یاران بی‌خبر %~% کاین چه میوه است از کدامین بوستان آورده‌ام(@)(@@) 38 تا خط بغداد ساغر دوستکانی خورده‌ام %~% دوستان را جله‌ای در جرعه‌دان آورده‌ام(@)(@@) 39 دشمنان را نیز هم بی‌بهره نگذارم چو خاک %~% گرچه جرعه خاص بهر دوستان آورده‌ام(@)(@@) 40 دوست خفته در شبستان است و دولت پاسبان %~% من به چشم و سر سجود پاسبان آورده‌ام(@)(@@) 41 پاسبان گفتا چه داری نورها گفتم شما %~% کان زر دارید و من جان نورهان آورده‌ام(@)(@@) 42 شیر مردان از شبستان گر نشان آورده‌اند %~% من سگ کهفم نشان از آستان آورده‌ام(@)(@@) 43 بر در او چون درش حلقه بگوشی رفته‌ام %~% تا پی تشریف سر تاج کیان آورده‌ام(@)(@@) 44 از نسیم یار گندم‌گون یکی جو سنگ مشک %~% با دل سوزان و چشم سیل‌ران آورده‌ام(@)(@@) 45 آب و آتش دشمن مشکند و من بر مشک دوست %~% آب و آتش را رقیبی مهربان آورده‌ام(@)(@@) 46 جز به بیاع جهان ندهم کزان جو سنگ مشک %~% صد شتربار تبت از بیع جان آورده‌ام(@)(@@) 47 دل به خدمت ساده 
ms424	 چون گور غریبان برده‌ام %~% همچو موسی‌زنده در تابوت از آن آورده‌ام(@)(@@) 48 رفته لرزان همچو خورشید فروزان آمده %~% شب زریری برده و روز ارغوان آورده‌ام(@)(@@) 49 هشت باغ خلد را دربسته بینی بر خسان %~% کان کلید هشت در در بادبان آورده‌ام(@)(@@) 50 بس طربناکم ندانید این طربناکی ز چیست %~% کز سعود چرخ بخت کامران آورده‌ام(@)(@@) 51 گوئی اندر جوی دل آبی ز کوثر رانده‌ام %~% یا به باغ جان نهالی از جنان آورده‌ام(@)(@@) 52 یا مگر اسفندیارم کان عروسان را همه %~% از دژ روئین به سعی هفت‌خوان آورده‌ام(@)(@@) 53 با شما گویم نیارم گفت با بیگانگان %~% کاین نهان گنج از کدامین دودمان آورده‌ام(@)(@@) 54 آشکارا برگرفتن گنج فرخ فال نیست %~% من به فرخ فال گنجی در نهان آورده‌ام(@)(@@) 55 از چنین گوهر زکاتی داد نتوان بهر آنک %~% تاج ترکستان به باج ترکمان آورده‌ام(@)(@@) 56 داده‌ام صد جان بهای گوهری در من یزید %~% ور دو عالم داده‌ام هم رایگان آورده‌ام(@)(@@) 57 کیست خاقانی که گویم خون بهای جان اوست %~% چون بهای جان صد خاقان و خان آورده‌ام(@)(@@) 58 این همه می‌گویمت کورده‌ام باری بپرس %~% تا چه گنج است و چه گوهر وز چه کان آورده‌ام(@)(@@) 59 بازپرسی شرط باشد تا بگویم کاین فتوح %~% در فلان مدت ز درگاه فلان آورده‌ام(@)(@@) 60 تو نپرسی من بگویم نز کسی دزدیده‌ام %~% کز در شاهنشهی گنج روان آورده‌ام(@)(@@) 61 یعنی امسال از سر بالین پاک مصطفی %~% خاک مشک آلود بهر حرز جان آورده‌ام(@)(@@) 62 وقف بازوی من است این حرز و نفروشم به کس %~% گرچه ز اول نام دادن بر زبان آورده‌ام(@)(@@) 63 خاک بالین رسول الله همه حرز شفاست %~% حرز شافی بهر جان ناتوان آورده‌ام(@)(@@) 64 گوهر دریای کاف و نون محمد کز ثناش %~% گوهر اندر کلک و دریا در بنان آورده‌ام(@)(@@) 65 چون زبان ملک سخن دارد من از صدر رسول %~% در سر دستار منشور زبان آورده‌ام(@)(@@) 66 بلکه در مدح رسول الله به 
