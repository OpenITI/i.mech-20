ms201	 سعد الأحول خالد الحسين بن سعيد " ج ".(@)(@@)(@@)(@@) $ 1992 - جلبة بن حنان الأبحر الكناني، له نوادر عنه عبد الله بن جلبة، وهو يروي عن جميل بن دراج كتابه، ولعله جبلة كما يأتي عن " ق " في التالية.(@)(@@)(@@)(@@) $ 1993 - جندب بن أيوب واقفي " صه " " ظم " فالترك أقوى فقاهة واجتهادا.(@)(@@)(@@)(@@) $ 1994 - الجواني حمدويه وإبراهيم قالا: حدثنا أبو جعفر محمد بن عيسى قال: كان الجواني خرج مع أبي الحسن عليه السلام إلى خراسان وكان من قرابته " كش " واسمه كما سيأتي علي بن إبراهيم بن محمد بن الحسن بن محمد.(@)(@@)(@@)(@@) $ 1995 - جهم بن أبي جهم " ظم " جهيم بن أبي جهم، ويقال: ابن أبي جهم، روى عنه سعدان بن مسلم نوادر " جش " والظاهر أنه من الطبقة التالية، إذ يروي PageV01P289(@)(@@) الراوي عنه عن " ق " و " ظم " عليهما السلام.(@)(@@)(@@)(@@) $ 1996 - جهم بن الحكم القمي البصري، له كتاب أحمد بن أبي عبد الله عن أبيه عنه " ست ".(@)(@@)(@@)(@@) $ 1997 - جهم بن الحكم المدائني، له كتاب أحمد بن أبي عبد الله عن أبيه عنه " ست " وكلاهما غير معلوم الحال، الا أن لهما كتاب، ولا يخلو من مدح.(@)(@@)(@@)(@@) $ 1998 - جهيم مصغرا ابن جعفر بن حيان واقفي " صه " " ظم ".(@)(@@)(@@)(@@) $ 1999 - حاتم بن الفرج " دي " غير معلوم الوصف من المدح والذم، فلا يقبل حديثه.(@)(@@)(@@)(@@) $ 2000 - حبشي بن جنادة، له كتاب رواه أحمد بن الحسن " صه " " ست " ولعله ابن الحسن بن علي بن فضال، والله أعلم.(@)(@@)(@@)(@@) $ 2001 - حبيب بن أوس أبو تمام الطائي، كان اماميا وله شعر كثير في أهل البيت عليهم السلام وذكر أحمد بن الحسين أنه رأى نسخة عتيقة لعلها كتبت في أيامه فيها قصيدة يذكر فيها الأئمة حتى انتهى إلى أبي جعفر الثاني، ونسبه الجاحظ إلى الرفضة.(@)(@@)(@@)(@@) $ 2002 - حرب بن الحسن الطحان، كوفي قريب الامر في الحديث، له كتاب عامي الرواية، عنه يحيى بن زكريا اللؤلوئي، ويحتمل كونه الحارث بن الحسن.(@)(@@)(@@)(@@) $ 2003 - الحسن بن أبي سعيد هاشم بن حيان المكاري أبو عبد الله، كان هو وأبوه وجهين في الواقفة، وكان هو ثقة الا 
ms202	 أن " كش " ذكر فيه ذموما كثيرة، وأبوه كما يأتي يروي عن " ق ".(@)(@@)(@@)(@@) $ 2004 - الحسن بن أبي عثمان الملقب بسجادة، ويأتي بعنوان الحسن بن علي بن أبي عثمان.(@)(@@)(@@)(@@) $ 2005 - الحسن بن أبي العرندس " ظم " الكندي الكوفي " ق " وهو في التالية أيضا.(@)(@@)(@@)(@@) $ 2006 - الحسن بن أبي قتادة علي بن محمد بن عبيد بن حفص بن حميد، PageV01P290(@)(@@) مولى السائب بن مالك الأشتر الأشعري، قتل حميد يوم المختار معه ويكنى أبا محمد، وكان شاعرا أديبا، روى أبوه عن " ق " و " ظم " عليهما السلام.(@)(@@)(@@)(@@) $ 2007 - الحسن بن أحمد بن إبراهيم، يظهر من ترجمة أحمد بن عامر أنه شيخ الإجازة " تعق " أقول: وفي تلك الترجمة تتضمن أن ابنه عبد الله قال فيما أجازنا الحسن بن أحمد بن إبراهيم، فعلى هذا يقبل قوله بناء على المختار.(@)(@@)(@@)(@@) $ 2008 - الحسن بن أسباط الكندي " ضا " لم أقف له على وصفه من مدح ولا ذم فيرد حديثه، والله أعلم.(@)(@@)(@@)(@@) $ 2009 - الحسن بن أسد بصري " ضا " وفي " ج " و " دي " مصغرا، وفي " ج " موثقا، ولا يخفى من تأمل.(@)(@@)(@@)(@@) $ 2010 - الحسن بن أيوب " ظم " له كتاب عنه أحمد بن ميثم " ست " محمد بن عبد الله بن غالب " جش " وحاله كنظائره غير مقبول الحديث.(@)(@@)(@@)(@@) $ 2011 - الحسن بن أيوب بن أبي غفيلة، له كتاب النوادر، عنه أحمد بن علي الصيدي الحميري " ست " وفي بعض النسخ الحموي.(@)(@@)(@@)(@@) $ 2012 - الحسن بن بشار المدائني " ظم " " ضا " " جخ " ثقة صحيح كان واقفيا ثم رجع " د " ويأتي مصغرا.(@)(@@)(@@)(@@) $ 2013 - الحسن بن بشير مجهول " ضا " وفي " صه " انه من أصحاب " ظم " عليه السلام.(@)(@@)(@@)(@@) $ 2014 - الحسن التفليسي يكنى أبا محمد " ضا ".(@)(@@)(@@)(@@) $ 2015 - الحسن بن جعفر المعروف بأبي طالب الفافائي بغدادي " دي ".(@)(@@)(@@)(@@) $ 2016 - الحسن بن الجهم بن بكير بن أعين أبو محمد الشيباني، ثقة روى عن " ظم " و " ضا " عليهما السلام " صه " " جش ".(@)(@@)(@@)(@@) $ 2017 - الحسن بن الجهم الرازي " ضا " لكن لا يبعد أن يكون الزراري، فيتحد مع السابق وأيضا يأتي الحسين عن " ظم " و " ضا " فهو: اما هذا فيتحد الكل، أو اخوة، فعلى 
ms203	 الأول يحتمل السهو من قلم النساخ. PageV01P291(@)(@@)(@@)(@@) $ 2018 - الحسن بن الحسن العلوي " ضا " " دي ".(@)(@@)(@@)(@@) $ 2019 - الحسن بن الحسين السكوني، عربي كوفي ثقة " صه " " جش " كتابه عن الرجال عنه جعفر بن عبد الله المحمدي " جش " والظاهر أنه في هذه الطبقة، وفي " مشكا " ابن الحسين السكوني الثقة عنه جعفر بن عبد الله.(@)(@@)(@@)(@@) $ 2020 - الحسن بن الحسين العلوي " دي ".(@)(@@)(@@)(@@) $ 2021 - الحسن بن الحسين اللؤلوئي، كوفي ثقة كثير الرواية، له كتاب " صه " " جش " روى عنه محمد بن أحمد بن يحيى، ضعفه " ق " واستثنى ابن الحسن بن الوليد من نوادر محمد بن أحمد بن يحيى ما تفرد بن الحسن واستصوبه ابن نوح.(@)(@@)(@@)(@@) $ 2022 - الحسن بن خالد البرقي أبو علي، أخو محمد بن خالد " ست " كان ثقة " صه " " جش " عنه أحمد البرقي " ست " وله كتاب نوادر في الثاني، وعن " ب " من كتبه تفسير العسكري مائة وعشرون مجلدا.(@)(@@)(@@)(@@) $ 2023 - الحسن بن خرزاذ قمي " دي " بالمعجمة والراء المشددة ثم الزاي والذال المعجمتين بعد الألف، عنه محمد بن أحمد بن يحيى ولم يستثن، ففيه شهادة على الاعتماد بل الوثاقة، وفي الوجيزة فيه مدح وذم وقيل: غلى، فالتوقف أحرى.(@)(@@)(@@)(@@) $ 2024 - الحسن بن دندان هو ابن سعيد الأهوازي الجليل " تعق " أقول: إن سعيدا يعرف بدندان ويأتي.(@)(@@)(@@)(@@) $ 2025 - الحسن بن راشد أبو علي بغدادي " دي " مولى آل المهلب، ثقة روى عن أبي جعفر الجواد عليه السلام " صه " " جخ ".(@)(@@)(@@)(@@) $ 2026 - الحسن الراوندي الدينوري يكنى أبا محمد، الأصل كوفي مولى بجيلة " ضا " ثم فيه الحسين الراوندي إلى آخره.(@)(@@)(@@)(@@) $ 2027 - الحسن بن الزبرقان أبو الخزرج قمي له كتاب، عنه أحمد بن محمد بن خالد " جش " وعن " لم " و " ست " الحسين كما يأتي.(@)(@@)(@@)(@@) $ 2028 - الحسن بن ظريف بن ناصح، كوفي يكنى أبا محمد ثقة سكن بغداد وأبوه قبل " صه " وعن " دي " الحسين، والظاهر أنه الحسن. PageV01P292(@)(@@)(@@)(@@) $ 2029 - الحسن بن شعيب المدائني " ضا ".(@)(@@)(@@)(@@) $ 2030 - الحسن بن سعيد الكوفي " ضا " هكذا ذكره الميرزا في التلخيص والظاهر أنه غير الأهوازي ولم يشر إليه فيه، وهو عجيب فلعله توهم الاتحاد أو سقط 
ms204	 من قلمه ولكن لم يوصف بالكوفي في لقبهم.(@)(@@)(@@)(@@) $ 2031 - الحسن بن سعيد بن حماد الأهوازي أخو الحسين، ثقة روى جميع ما صنفه أخوه عن جميع شيوخه مع زيادته الرواية عن زرعة وأخوه، يروي عن الحسن عن زرعة، وكذا قيل في فضالة بن أيوب، إذ يروي الحسين عنه بواسطة أخيه.(@)(@@)(@@)(@@) $ 2032 - الحسن بن زياد " ست " " ضا " له كتاب عنه إبراهيم بن سليمان " ست ".(@)(@@)(@@)(@@) $ 2033 - الحسن بن سهل أخو الفضل ذو الرياستين ويعرف بذي القلمين " ضا ".(@)(@@)(@@)(@@) $ 2034 - الحسن بن سفيان الكوفي " دي " ذكره في التلخيص.(@)(@@)(@@)(@@) $ 2035 - الحسن بن صالح " ظم " كأنه ابن الحي الآتي.(@)(@@)(@@)(@@) $ 2036 - الحسن بن صالح الأحول كوفي له كتاب مختلف روايته، عنه العباس بن عامر " جش ".(@)(@@)(@@)(@@) $ 2037 - الحسن بن عباد " ضا " هكذا في التلخيص.(@)(@@)(@@)(@@) $ 2038 - الحسن بن العباس بن حريش الرازي أبو علي، روى عن أبي جعفر الثاني عليه السلام ضعيف جدا. وقال " غض ": هو أبو محمد. وهذا الرجل لا يلتفت إليه.(@)(@@)(@@)(@@) $ 2039 - الحسن بن العباس الحريشي، له كتاب عنه البرقي أحمد. قال الميرزا: الظاهر أنه السابق وإن كان تكرار الشيخ يقتضي خلافه.(@)(@@)(@@)(@@) $ 2040 - الحسن بن العباس بن خراش " ج ".(@)(@@)(@@)(@@) $ 2041 - الحسن بن عبد الصمد بن محمد بن عبيد الله الأشعري، شيخ ثقة PageV01P293(@)(@@) من أصحابنا " صه " " د " " جش " الا أن عن بعض نسخه الحسين كما يأتي، ولا يبعد التعدد باحتمال الاخوة.(@)(@@)(@@)(@@) $ 2042 - الحسن بن عبد الله، في الارشاد أنه من العباد الأتقياء كذا في النقد " تعق " أقول: وقد نقل أنه أعبد أهل زمانه، ويتقيه السلطان لجده واجتهاده في الدين، وكان من أصحاب " ظم " عليه السلام واهتدي بهدايته ولزم منهاج الأئمة بتعليمه.(@)(@@)(@@)(@@) $ 2043 - الحسن بن عبيد الله القمي، يرمي بالغلو " صه " وفي " دي " الحسين ويأتي وفي " تعق " لم يذكره الا مصغرا وكذا في نقد ويأتي الحسين أيضا، والتعدد محتمل جدا.(@)(@@)(@@)(@@) $ 2044 الحسن بن عديس " ضا " كذا في التلخيص.(@)(@@)(@@)(@@) $ 2045 - الحسن بن عطية الحناط، له كتاب عنه أحمد بن ميثم كوفي مولى ثقة وأخواه أيضا محمد وعلي رووا عن أبي عبد 
ms205	 الله عليه السلام، وبهذا الاعتبار يدخل في الطبقة الآتية.(@)(@@)(@@)(@@) $ 2046 - الحسن بن علي ابن بنت الياس، يأتي بعنوان الحسن بن علي بن زياد الوشاء.(@)(@@)(@@)(@@) $ 2047 - الحسن بن علي بن زكريا البزوفري العدوي، من عدي الرباب ضعيف جدا. قال " غض ": وروى نسخة عن محمد بن صدقة عن موسى عليه السلام وروى عن خراش عن أنس، وأمره أشهر من أن يذكر.(@)(@@)(@@)(@@) $ 2048 - الحسن بن علي بن أبي عثمان يلقب سجادة، غال من أصحاب أبي جعفر الجواد عليه السلام ضعيف له كتاب، عنه الحسين بن عبيد الله بن سهل وأحمد البرقي " جش " " ست ".(@)(@@)(@@)(@@) $ 2049 - الحسن بن علي بن بقاح، كوفي ثقة مشهور صحيح الحديث، روى عن أصحاب " ق " وفي " ست " ترجمة معاذ بن ثابت بن علي بن يوسف المعروف بابن بقاح.(@)(@@)(@@)(@@) $ 2050 - الحسن بن علي بن زياد الوشاء، بجلي كوفي خزاز من أصحاب PageV01P294(@)(@@) " ضا " عليه السلام وكان من وجوه هذه الطائفة وعين من عيونها.(@)(@@)(@@)(@@) $ 2051 - الحسن بن علي بن سيرة، له كتاب عنه أحمد بن أبي عبد الله " ست " " جش " بغدادي في الأول.(@)(@@)(@@)(@@) $ 2052 - الحسن بن علي بن سفيان بن خالد، خاصي يكنى أبا عبد الله لم يرو عن الأئمة، وكان شيخا ثقة جليلا من أصحابنا " صه " وذكر في الحسين نحوه مصغرا، فهذا: اما أخوه، أو سهو. والله أعلم.(@)(@@)(@@)(@@) $ 2053 - الحسن بن علي الربعي مولى تيم الله بن ثعلبة كوفي " ضا ".(@)(@@)(@@)(@@) $ 2054 - الحسن بن علي بن أبي حمزة سالم البطائني مولى الأنصار أبو محمد، واقفي كذاب ملعون، وكان أبوه قائد أبي بصير، عنه أحمد بن ميثم ومحمد بن أبي الصهبان " ست ".(@)(@@)(@@)(@@) $ 2055 - الحسن بن علي بن عبد الله بن المغيرة أبو محمد، من أصحابنا الكوفيين ثقة ثقة له كتاب، عنه البرقي أحمد ومحمد بن علي بن محبوب.(@)(@@)(@@)(@@) $ 2056 - الحسن بن علي اللؤلوئي، له كتاب عنه محمد بن علي بن محبوب " ست ".(@)(@@)(@@)(@@) $ 2057 - الحسن بن علي بن فضال التيملي، مولى تيم الله بن ثعلبة أبو محمد، روى عن الرضا عليه السلام وكان خصيصا به 
ms206	 جليل القدر عظيم المنزلة زاهدا ورعا ثقة فطحيا عمره.(@)(@@)(@@)(@@) $ 2058 - الحسن بن علي بن مهران " ظم ".(@)(@@)(@@)(@@) $ 2059 - الحسن بن علي بن يقطين ثقة " ضا " ابن موسى مولى بني هاشم، وقيل: مولى بني أسد، كان ثقة فقيها متكلما روى عن الرضا عليه السلام.(@)(@@)(@@)(@@) $ 2060 - الحسن بن عمر بن سليمان، ذكره " د " وقال: " ق " " ظم " " كش " ممدوح ويأتي عن غيره مصغرا.(@)(@@)(@@)(@@) $ 2061 - الحسن بن عمرو بن منهال، كوفي ثقة هو وأبوه أيضا " صه " " جش " عنه أحمد بن ميثم " ست " " جش ". PageV01P295(@)(@@)(@@)(@@) $ 2062 - الحسن بن عمر بن يزيد " ضا " وقد يوجد بعده بياض بقدر كلمة، وفي " د " الحسن بن عمر بن يزيد وأخوه الحسين " ضا " " جخ " ثقتان وكان البياض موضع ثقة. كذا ذكره الميرزا.(@)(@@)(@@)(@@) $ 2063 - الحسن بن القاسم، فيه رواية تدل على حسن عقيدته ومعرفته للحق.(@)(@@)(@@)(@@) $ 2064 - الحسن بن كثير الكوفي البجلي. قال المفيد: حدثني أبو محمد الحسن بن محمد، قال: حدثني جدي أبو نصر، قال: حدثنا محمد بن الحسين، قال: حدثنا أسود بن عامر، قال: حدثنا حيان عن الحسن قال: شكوت إلى أبي جعفر عليه السلام الحديث.(@)(@@)(@@)(@@) $ 2065 - الحسن بن مالك القمي، من أصحاب أبي الحسن الثالث عليه السلام ثقة، وفي بعض النسخ الحسين واختاره " د " ونسب ما هنا إلى الاشتباه، والمنقول بخط ابن طاووس مكبرا وهو الأصح وهو في السابقة.(@)(@@)(@@)(@@) $ 2066 - الحسن بن محبوب السراد ويقال: الزراد مولى ثقة، روى عن " ضا " عليه السلام قال " كش " انه ممن أجمع أصحابنا على تصحيح ما يصح عنهم وقيل: مكانه الحسن بن علي، مات سنة أربع وعشرين بعد المائتين.(@)(@@)(@@)(@@) $ 2067 - الحسن بن محمد بن أبي طلحة " ضا " وعده بعض الأصحاب من رجال أبي الحسن موسى عليه السلام، والله أعلم.(@)(@@)(@@)(@@) $ 2068 - الحسن بن محمد أخي محمد بن رجا الخياط " دي ".(@)(@@)(@@)(@@) $ 2069 - الحسن بن محمد بن بابا القمي غال " صه " " دي " أبو محمد " فش " قال: إن من الكذابين المشهورين ابن بابا القمي " صه " " كش " وفيه في ذمه روايات كثيرة.(@)(@@)(@@)(@@) $ 2070 - الحسن بن محمد الحضرمي ابن أخت أبي 
ms207	 مالك الضحاك الحضرمي ثقة.(@)(@@)(@@)(@@) $ 2071 - الحسن بن محمد بن عمران، ربما يستفاد من " كش " أنه كان وصي PageV01P296(@)(@@) زكريا بن آدم، وهذا يدل على حسن حاله بل على وثاقته.(@)(@@)(@@)(@@) $ 2072 - الحسن بن محمد بن الفضل بن يعقوب بن سعيد بن نوفل بن الحارث بن عبد المطلب أبو محمد، ثقة جليل روى عن الرضا عليه السلام نسخة، وعمومته إسحاق ويعقوب وإسماعيل وأخوه الحسين.(@)(@@)(@@)(@@) $ 2073 - الحسن بن محمد المدائني " دي ".(@)(@@)(@@)(@@) $ 2074 - الحسن بن محمد بن يسار، روى " ق " في المجالس عن أبيه عن سعد بن عبد الله عن محمد بن عيسى اليقطيني عنه، قال: حدثني شيخ صدوق من أهل قطيعة الربيع من العامة ممن كان يقبل قوله - إلى أن قال قال الحسن: وكان هذا الشيخ من خيار العامة شيخ صدوق مقبول القول ثقة جدا عند الناس انتهى. ويظهر منه مضافا إلى تشيعه فضله وجلالته " تعق " وفيه نظر.(@)(@@)(@@)(@@) $ 2075 - الحسن بن معاوية، مر في إسماعيل بن محمد بن إسماعيل ما يظهر معروفيته بل نباهته " تعق " أقول: لم يذكر في تلك الترجمة الا رواية عنه ومجرد ذلك لا يظهر منه المعروفية والنباهة كما ذكره.(@)(@@)(@@)(@@) $ 2076 - الحسين بن إبراهيم بن موسى بن أحنف " ظم ".(@)(@@)(@@)(@@) $ 2077 - الحسين بن إبراهيم بن موسى بن جعفر " ضا ".(@)(@@)(@@)(@@) $ 2078 - الحسين أبو علي بن الفرج بن قتادة، روى عنه أحمد بن عبد الله البرقي.(@)(@@)(@@)(@@) $ 2079 - الحسين بن أبي الخطاب، ذكر عن محمد بن يحيى العطار أن محمد بن الحسين بن أبي الخطاب ذكر أنه يحفظ مولد الحسين وهو سنة أربعين ومائة.(@)(@@)(@@)(@@) $ 2080 - الحسين بن أبي سعيد هاشم بن حيان المكاري أبو عبد الله، كان هو وأبوه وجهين في الواقفة، ثقة في حديثه " كش " ذكر فيه ذموما، له كتاب نوادر كبير، عنه الحسن بن سماعة.(@)(@@)(@@)(@@) $ 2081 - الحسين بن الجهم بن بكير بن أعين، من أصحاب الكاظم عليه السلام ثقة " صه " " جخ ". PageV01P297(@)(@@)(@@)(@@) $ 2082 - الحسين بن بسطام بن سابور الزيات، له ولأخيه أبي عتاب كتاب جمعاه في الطب جمعاه في الأطعمة ومنافعها والرقى والعوذ كثير 
ms208	 الفوائد والمنافع " جش " (@)(@@)(@@)(@@) $ 2083 - الحسين بن بشار " ج " " ظم " مدائني مولى زياد، ثقة صحيح روى عن أبي الحسن موسى عليه السلام " ضا " قال " كش ": رجع عن القول بالوقف وقال بالحق ويعاضده نص الشيخ.(@)(@@)(@@)(@@) $ 2084 - الحسين بن أيوب، عنه الحسن بن محمد بن سماعة " ست " (@)(@@)(@@)(@@) $ 2085 - الحسين بن أسد، من أصحاب أبي جعفر الثاني، ثق صحيح بصري " صه " " ج " " دي " " ضا ".(@)(@@)(@@)(@@) $ 2086 - الحسين بن الحسن الفارسي، قمي له كتاب عنه أحمد بن أبي عبد الله " ست " لم يوجد له مدح الا أنه قمي، الا أن الظاهر كونه اماميا.(@)(@@)(@@)(@@) $ 2087 - الحسين بن خالد " ظم " " ضا " الصيرفي " ضا " هكذا ذكره الميرزا، وليس فيه شئ يعتمد على قبول روايته.(@)(@@)(@@)(@@) $ 2088 - الحسين بن داود اليعقوبي " ج " الظاهر أنه ابن داود بن يعقوب الهاشمي، ولا أرى العمل بحديثه.(@)(@@)(@@)(@@) $ 2089 - الحسين بن راشد مولى بني العباس بغدادي " ظم " والظاهر أنه الحسن الطوافي مكبرا، كما ذكره الميرزا، فيروي عنه علي بن السندي.(@)(@@)(@@)(@@) $ 2090 - الحسين الروندي الدينوري يكنى أبا محمد مولى بني بجيلة " ضا " وقيل: مكبرا الا أن فيه مولى البجيلة. والصواب التعدد لا الاتحاد، ويمكن كونهما أخوين أو مشتركين اسما.(@)(@@)(@@)(@@) $ 2091 - الحسين بن رباب " ضا ".(@)(@@)(@@)(@@) $ 2092 - الحسين بن زبرقان، روى عنه البرقي " لم " وفي " ست " الحسين بن الزبرقان يكنى أبا الخزرج، له كتاب عنه أحمد بن أبي عبد الله، وليس فيه ما يدل على قبول روايته.(@)(@@)(@@)(@@) $ 2093 - الحسين بن زياد " ضا " " ست " له كتاب الرضاع، رواه وليد بن حماد PageV01P298(@)(@@) " ست " التوقف فيه مجال.(@)(@@)(@@)(@@) $ 2094 - الحسين بن سعيد بن أبي الجهم، في أبيه أنهم بيت كبير في الكوفة، وفي منذر بن محمد بن منذر أنه بيت جليل " تعق ".(@)(@@)(@@)(@@) $ 2095 - الحسين بن سعيد بن حماد الأهوازي، مولى " ين " عليه السلام ثقة عين جليل القدر صاحب التصنيفات، روى عن " ضا " وابنه وابن ابنه عليهم السلام وتوفى بقم، عنه الاحمدان ومن في طبقتهما.(@)(@@)(@@)(@@) $ 2096 - الحسين بن سهل بن نوح " ج " الصواب هو التوقف في روايته.(@)(@@)(@@)(@@) $ 2097 - الحسين بن شعيب المدائني " ضا " وعندي 
ms209	 التأمل في روايته قوي.(@)(@@)(@@)(@@) $ 2098 - الحسين بن صالح الخثعمي " ضا " غير معروف الحال، فالأقرب عدم قبول روايته.(@)(@@)(@@)(@@) $ 2099 - الحسين بن صدقة من أصحاب " ظم " عليه السلام ثقة " صه " " جخ " يروي عنه كثير من في الطبقة السابقة.(@)(@@)(@@)(@@) $ 2100 - الحسين بن عبد ربه، روى " كش " عن محمد بن مسعود، قال: حدثني محمد بن نصير، قال: حدثني أحمد بن محمد بن عيسى أنه كان وكيلا، وهذا سند صحيح " صه " أقول: كونه وكيلا يشعر بوثاقته وجلالته ان ثبت.(@)(@@)(@@)(@@) $ 2101 - الحسين بن عبيد الله بن سهل أبو عبيد الله السعدي، ممن طعن عليه ورمي بالغلو، له كتب صحيحة الحديث " صه " " جش " وفي " دي " الحسين بن عبيد الله القمي يرمى بالغلو.(@)(@@)(@@)(@@) $ 2102 - الحسين بن عثمان بن زياد الرواسي، قال حمدوية: سمعت أشياخي يذكرون أن حمادا وجعفرا والحسين بن عثمان بن زياد الرواسي وحماد يلقب بالناب كلهم فاضلون ثقات.(@)(@@)(@@)(@@) $ 2103 - الحسين بن علي الخواتيمي، وهو متهم، قال نصر بن الصباح: ان الحسين هذا كان غاليا ملعونا، وكان قد أدرك " ضا " عليه السلام " كش ".(@)(@@)(@@)(@@) $ 2104 - الحسين بن علي بن يقطين، من أصحاب " ضا " عليه السلام ثقة PageV01P299(@)(@@) " صه " " جخ ".(@)(@@)(@@)(@@) $ 2105 - الحسين بن علي القمي " ج " لم أجد فيه ما يوجب على قبول روايته.(@)(@@)(@@)(@@) $ 2106 - الحسين بن عمر بن يزيد، من أصحاب أبي الحسن الرضا عليه السلام ثقة " صه " " جخ " وفي " كش " ما يدل على عدم وقفه.(@)(@@)(@@)(@@) $ 2107 - الحسين بن الفرج أبي قتادة أبو علي البغدادي، عنه أحمد البرقي " ست ".(@)(@@)(@@)(@@) $ 2108 - الحسين بن القاسم " ضا " العباسي " ظم ".(@)(@@)(@@)(@@) $ 2109 - الحسين بن قياما، من أصحاب " ظم " عليه السلام واقفي " صه " " جخ " وفي " كش " روايتان في ذمه أحدهما صحيح فلا يتكل على حديثه.(@)(@@)(@@)(@@) $ 2110 - الحسين بن كيسان، من أصحاب " ظم " عليه السلام واقفي " صه " " جخ ".(@)(@@)(@@)(@@) $ 2111 - الحسين بن المبارك له كتاب، أحمد. " شج " " تس " هنع هيبأ نع لله ا دبع يبأ بن ة (@)(@@)(@@)(@@) $ 2112 - الحسين بن محمد بن أبي طلحة " ضا " لم أقف له على مدح، فالتوقف في حديثه مجال.(@)(@@)(@@)(@@) $ 2113 - الحسين بن 
ms210	 محمد الأشناني الرازي أبو عبد الله العدل، كما وصفه ابن بابويه الصدوق في عيون أخبار الرضا عليه السلام، وتزكية مثله كافية.(@)(@@)(@@)(@@) $ 2114 - الحسين بن محمد بن حي " دي " لم أجد فيه مدحا ولا ذما، فلا يعبأ بحديثه، والله أعلم.(@)(@@)(@@)(@@) $ 2115 - الحسين بن محمد بن سليمان، له كتاب أحمد عن أبيه عنه " ست ".(@)(@@)(@@)(@@) $ 2116 - الحسين بن محمد بن الفضل بن يعقوب أبو محمد، شيخ من الهاشميين ثقة، روى أبوه عن " ق " و " ظم " عليهما السلام وعمومته كذلك إسحاق ويعقوب وإسماعيل، وكان ثقة صنف مجالس الرضا عليه السلام مع أهل الأديان " جش " وفي " تعق " جعل الكتاب للحسن لا له فتدبر. PageV01P300(@)(@@)(@@)(@@) $ 2117 - الحسين بن محمد القمي " ج " غير مقبول القول لعدم ما يوجب القبول.(@)(@@)(@@)(@@) $ 2118 - الحسين بن محمد المدائني " دي " وهو كسابقه.(@)(@@)(@@)(@@) $ 2119 - الحسين بن مخارق واقفي " ظم " له كتاب التفسير وجامع العلم، عنه الحسين بن سعيد " ست " وفي " ست " وفي نسخة من " ظم " الحضين.(@)(@@)(@@)(@@) $ 2120 - الحسين بن مسكان، قال " غض ": لا أعرفه الا أن جعفر بن محمد بن مالك روى عنه أحاديث فاسدة وما عند أصحابنا من هذا الرجل علم " صه ".(@)(@@)(@@)(@@) $ 2121 - الحسين بن مسلم " ج " غير مقبول الرواية.(@)(@@)(@@)(@@) $ 2122 - الحسين بن موسى " ضا " ويظهر من المنتهى اتحاده مع الآتي بعده، ولكن الظاهر تعدده، الا أن كليهما غير مقبولي الرواية، فان الآتي ضعيف وهذا مجهول على التعدد.(@)(@@)(@@)(@@) $ 2123 - الحسين بن موسى، من أصحاب الكاظم عليه السلام واقفي " صه " " د " " جخ " فحديثه ضعيف كما لا يخفى.(@)(@@)(@@)(@@) $ 2124 - الحسين بن مهران بن محمد أبي نصر السكوني، روى عن أبي الحسن موسى والرضا عليهما السلام واقفي " صه " " جش " ضعيف اليقين، له كتاب عن موسى عليه السلام والأقرب ضعفه، فلا أعتمد عليه.(@)(@@)(@@)(@@) $ 2125 - الحسين بن مياح المدائني، روى عن أبيه، قال " غض ": انه ضعيف غال " صه " الظاهر أنه في هذه الطبقة، والله أعلم.(@)(@@)(@@)(@@) $ 2126 - الحسين بن النضر أبو عون الأبرش " ري " وهو أيضا في الطبقة السابقة.(@)(@@)(@@)(@@) $ 2127 - الحسين بن هذيل، له روايات عنه ابن نهيك " ست 
ms211	 ".(@)(@@)(@@)(@@) $ 2128 - الحسين بن يزيد السوراني، هو ابن محمد بن يزيد " تعق " أقول:(@)(@@) ويأتي في الآتية أبوه عن قتاد في الألقاب ذكره كذلك، فيزيد جده لا أبوه.(@)(@@)(@@)(@@) $ 2129 - الحسين بن يزيد النوفلي نوفل النخع كوفي كان شاعرا أديبا وسكن PageV01P301(@)(@@) الري ومات بها، عنه إبراهيم بن هاشم وأحمد البرقي.(@)(@@)(@@)(@@) $ 2130 - الحصين بن الحصين، هو أبو الحصين بن الحصين، وقد وقع في " يب " اشتباه، ويدل عليه أن " في " روى تلك الرواية بعينها هكذا " تعق " أقول سيأتي في الكنى أنه ثقة من أصحاب أبي الحسن الثالث عليه السلام.(@)(@@)(@@)(@@) $ 2131 - الحضين بن المخارق بن عبد الرحمن بن ورقاء بن حبشي بن جنادة أبو جنادة السلولي، وحبش صاحب النبي صلى الله عليه وآله والظاهر ضعفه ووقفه.(@)(@@) وفي نسخة بالسين كما مر، ولعله في الآتية. وقال عقد: انه زيدي وفي " ضح " بالمهملة.(@)(@@)(@@)(@@) $ 2132 - حفص الجوهري " ج " روى عن الهادي عليه السلام أيضا عن الحسن بن زيد عن أبي عبد الله عليه السلام روى عنه عثمان بن يزيد بياع السابري وكني بأبي عبد الله كما في بعض الروايات.(@)(@@)(@@)(@@) $ 2133 - حفص بن سليمان، الظاهر أنه من أصحاب " ظم ".(@)(@@)(@@)(@@) $ 2134 - حفص المروزي " دي " غير مقبول الحديث.(@)(@@)(@@)(@@) $ 2135 - الحكم بن هشام بن الحكم أبو محمد مولى كندة سكن البصرة، وكان مشهورا بالكلام، كلم الناس وحكي عنه مجالس كثيرة، ذكر بعض أصحابنا أنه رأى له كتابا " جش " وفي الوجيزة " ح " وهو الصواب.(@)(@@)(@@)(@@) $ 2136 - الحكم بن يسار، غال لا شئ، وقد مضى في أحكم، والظاهر أنه ابن بشار بالموحدة والسين المعجمة لا المثناة والمهملة.(@)(@@)(@@)(@@) $ 2137 - حمدان بن إبراهيم الأهوازي كوفي " ضا ".(@)(@@)(@@)(@@) $ 2138 - حمدان بن المعافي أبو جعفر الصبيحي من قصر صبيح مولى جعفر بن محمد عليهما السلام روى عن " ظم " و " ضا " وبملاحظة تاريخ وفاته يكون في الطبقة السابقة أيضا.(@)(@@)(@@)(@@) $ 2139 - حمزة بن أحمد " ظم " لا يعتمد عليه والوجه ظاهر.(@)(@@)(@@)(@@) $ 2140 - حمزة بن بزيع، من صالح هذه الطائفة وثقاتهم كثير العمل " صه " PageV01P302(@)(@@) وقد صرح الشيخ (رحمه الله) بكونه واقفيا بل من رؤسائهم، وعن 
ms212	 الرضا عليه السلام رواية تدل على ذمه، فقال: ما فعل الشقي حمزة.(@)(@@)(@@)(@@) $ 2141 - حمزة مولى علي بن سليمان بن رشيد بغدادي " دي ".(@)(@@)(@@)(@@) $ 2142 - حمزة بن يعلى الأشعري أبو يعلى القمي، روى عن الرضا والجواد عليهما السلام ثقة وجه " صه " " جش " عنه الصفار " جش " فيكون في الطبقة السابقة كما لا يخفى.(@)(@@)(@@)(@@) $ 2143 - حميد بن راشد أبو غسان الذهلي، له كتاب عن مفضل عن " ق " عليه السلام عنه عبيس " جش " ويأتي عن " ق " في التالية حميد أبو غسان، والظاهر الاتحاد.(@)(@@)(@@)(@@) $ 2144 - حميد بن مسعود، قال حميد بن زياد: سمعت من أبي محمد القاسم بن إسماعيل القرشي كتاب حميد بن مسعود " جش ".(@)(@@)(@@)(@@) $ 2145 - خالد الحوار " كش " روى عن حمدوية قال الحسن بن موسى: كان نشيط وخالد يخدمان أبا الحسن عليه السلام، ثم ذكر حديثا لا يدل صريحا على عقيدة الرجلين، وقد وصف بالجواز والجوان، كما في ترجمة المفضل، والله أعلم.(@)(@@)(@@)(@@) $ 2146 - خالد بن يزيد بن جبل، كوفي ثقة روى عن " ظم " " صه " " جش " عنه يحيى بن زكريا اللؤلوئي " جش ".(@)(@@)(@@)(@@) $ 2147 - خزيمة بن يقطين " ظم " وفي " تعق " يروي عنه صفوان.(@)(@@)(@@)(@@) $ 2148 - خضر بن عيسى، رجل من أهل الجبل لا بأس به " جش " عنه " صه " له كتاب " ست " " جش " عنه محمد بن علي بن محبوب.(@)(@@)(@@)(@@) $ 2149 - خلف بن حماد الأسدي، له كتاب عنه محمد البرقي، ولعله ابن ناشر الآتي عن " جش " وفي " تعق " يلقب بالكاهلي، ويظهر من الاخبار حسن عقيدته.(@)(@@)(@@)(@@) $ 2150 - خلف بن خلف، من أصحاب الكاظم عليه السلام مجهول " صه " " جخ ".(@)(@@)(@@)(@@) $ 2151 - خلف بن حماد بن نافر بن المسيب، كوفي ثقة سمع " ظم " عليه PageV01P303(@)(@@) السلام قال " غض ": إن أمره مختلط يعرف حديثه تارة وننكره أخرى، ويجوز أن يخرج شاهدا " صه " عنه محمد بن الحسين، والصواب قبوله.(@)(@@)(@@)(@@) $ 2152 - خلف بن سلمة بصري " ضا " من أصحاب الرضا عليه السلام وموسى عليه السلام " ج ".(@)(@@)(@@)(@@) $ 2153 - خليل بن هشام الفارسي " دي " لم أقف على ما يوجب الوثوق بروايته.(@)(@@)(@@)(@@) $ 2154 - خيران بن إسحاق الزاكاني " دي ".(@)(@@)(@@)(@@) $ 2155 - خيران الخادم، من 
ms213	 أصحاب أبي الحسن الثالث عليه السلام ثقة " صه " " جخ " له كتاب عنه محمد بن عيسى " جش " أقول: هو من أصحاب " ضا " و " ج " و " دي " ومستودعي أسرارهم، وحكايته مع أحمد تنبئ عن علو مرتبته ونهاية جلالته.(@)(@@)(@@)(@@) $ 2156 - دارم بن قبيصة بن نهشل أبو الحسن الشايح روى عن الرضا عليه السلام " جش " التميمي الدارمي، له عنه كتاب الوجوه والنظائر وكتاب الناسخ والمنسوخ، عنه علي بن عنبسة، ضعفه " غض " بأنه لا يوثق به.(@)(@@)(@@)(@@) $ 2157 - داود بن سليمان، عده المفيد من خاصة " ضا " عليه السلام وثقاته ومن أهل الورع والعلم والفقه من الشيعة، ثم ذكر رواية عن أبي علي الخزاز عنه في تعيين " ظم " عليه السلام الامام من بعده " ضا " والظاهر أنه غير الآتي عن " جش " وان احتمله في النقد مع مناسبات للاتحاد، فإنه ثقة أي ثقة، والاتي (ح) بل احتمل عامية وجوده.(@)(@@)(@@)(@@) $ 2158 - داود بن سليمان بن جعفر أبو أحمد القزويني، ذكره ابن نوح في رجاله، له كتاب عن الرضا عليه السلام " جش " وفي " في " عنه " تعق " عن داود قال قلت لأبي إبراهيم: اني أخاف أن يحدث حدث فلا ألقاك فأخبرني من الامام بعدك؟(@)(@@) قال: ابني أبو الحسن.(@)(@@)(@@)(@@) $ 2159 - داود الصرمي، له مسائل عنه أحمد بن أبي عبد الله " ست " يكنى أبا سليمان " دي " والظاهر أنه ابن مافنة كما يأتي. PageV01P304(@)(@@)(@@)(@@) $ 2160 - داود بن علي اليعقوبي الهاشمي أبو علي روى عن " ظم " عليه السلام وقيل: عن " ضا " عليه السلام ثقة له كتاب، عنه جماعة منهم عيسى بن عبد الله العمري.(@)(@@)(@@)(@@) $ 2161 - داود بن القاسم بن إسحاق بن عبد الله بن جعفر بن أبي طالب أبو هاشم الجعفري (رحمه الله) من أهل بغداد، جليل القدر عظيم المنزلة عند الأئمة، قد شاهد الجواد والهادي والعسكري عليهم السلام عنه أحمد بن محمد بن عيسى.(@)(@@)(@@)(@@) $ 2162 - داود بن مافنة الصرمي مولى بني قرة ثم بني صرمة، روى عن " ضا " عليه السلام وبقي إلى أيام " ري " عليه السلام وله مسائل إليه، فهو في السابقة أيضا عنه أحمد بن 
ms214	 محمد.(@)(@@)(@@)(@@) $ 2163 - داود بن محمد النهدي ابن عم هيثم بن أبي مسروق، كوفي ثقة متأخر الموت " صه " " جش " عنه يحيى بن زكريا اللؤلوئي " جش " عنه الصفار " ست " " لم " وهو أيضا في الطبقة السابقة.(@)(@@)(@@)(@@) $ 2164 - داود بن النعمان " ضا " وهو أخو علي بن النعمان، ثقة عين، و " كش " عن أشياخه خير فاضل، وهو عم الحسن، وفي " جش " أخو علي وداود الأكبر، روى عن " ظم " عليه السلام وقيل: عن " ق " عليه السلام وفيه في ترجمة أخيه هو أعلى منه وهو ثقة عنده.(@)(@@)(@@)(@@) $ 2165 - داود بن مهزيار أخو علي " ج ".(@)(@@)(@@)(@@) $ 2166 - داود بن النعمان الأنباري مولى بني هاشم أخو علي بن النعمان وداود الأكبر روى عن أبي الحسن عليه السلام وقيل: عن أبي عبد الله عليه السلام ثقة عين خير فاضل، وأوصى بكتبه لمحمد بن سليمان.(@)(@@)(@@)(@@) $ 2167 - دعبل بن علي الخزاعي الشاعر، حاله مشهور في الايمان وعلو الشأن والمنزلة، قد صنف كتاب طبقات الشعراء. قال أبو عمرو: بلغني أن دعبل وفد على الرضا عليه السلام بخراسان، فلما دخل عليه قال: اني قلت قصيدة الحديث.(@)(@@)(@@)(@@) $ 2168 - رجاء بن يحيى بن سامان أبو الحسين العبرتائي الكاتب، روى عن PageV01P305(@)(@@) أبي الحسن علي بن محمد صاحب العسكري عليه السلام وكان اماميا، الا أنه لم أقف على توثيقه فحديثه حسن.(@)(@@)(@@)(@@) $ 2169 - رشد بن زيد الحنفي، روى عن حميد عنه بواسطة إبراهيم بن سليمان، وأكثر نسخ " ست " وفي بعضها رشيد بالياء الجعفي في الكل، ثقة كوفي قليل الحديث، وفي " صه " بفتح الراء.(@)(@@)(@@)(@@) $ 2170 - الريان بن شبيب خال المعتصم ثقة " صه " " جش " سكن قم وروى عنه أهلها وجمع مسائل الصباح بن نصر النهدي للرضا عليه السلام، عنه يحيى بن زكريا اللؤلوئي.(@)(@@)(@@)(@@) $ 2171 - الريان بن الصلت البغدادي، ثقة صدوق يكنى أبا علي الأشعري القمي الخراساني الأصل، عنه إبراهيم بن هاشم، قد ذكر أن له كتابا جمع فيه كلام الرضا عليه السلام ويروي عنه.(@)(@@)(@@)(@@) $ 2172 - زريق الخلقاني له كتاب، عنه القاسم بن إسماعيل " ست " لم أر له مدحا ولا ذما، فالتوقف في 
ms215	 حديثه قوي.(@)(@@)(@@)(@@) $ 2173 - زريق بن مرزوق، عنه إبراهيم بن سليمان، له كتاب " ست " وقد يورد بالمهملة وكذا سابقه ولكنه في الآتية.(@)(@@)(@@)(@@) $ 2174 - زكار بن الحسن الدينوري، شيخ من أصحابنا ثقة " صه " " جش " له كتاب الفضائل، عنه الحسين بن علي بن الحسين الدينوري " جش " ولعله في التالية أيضا.(@)(@@)(@@)(@@) $ 2175 - زكار بن يحيى الواسطي، له كتاب الفضائل وله أصل، عنه القاسم بن إسماعيل والحسن بن علي بن الحسن الدينوري العلوي " ست " قيل: الظاهر أن هذا غير الذي ذكره " جش " في عنوان ابن الحسن لأنه الحسين.(@)(@@)(@@)(@@) $ 2176 - زكريا بن آدم القمي الثقة جليل القدر، له كتاب وكتاب مسائله للرضا عليه السلام عنه محمد بن الحسن بن أبي خالد ومحمد بن الحسن سنبوله ومحمد بن خالد، وهو الذي قال في حقه الرضا عليه السلام: المأمون على الدين والدنيا. PageV01P306(@)(@@)(@@)(@@) $ 2177 - زكريا بن شيبان، روى الحديث عن ابن أبي العلاء وابني حمران وية وصفوان بن يحيى، وروى عنه ابنه يحيى " جش " في ابنه يحيى.(@)(@@)(@@)(@@) $ 2178 - زكريا بن عبد الصمد القمي يكنى أبا جرير، من أصحاب موسى ضا عليهما السلام ثقة " صه " " جخ ".(@)(@@)(@@)(@@) $ 2179 - زكريا بن يحيى التميمي كوفي ثقة " صه " " جش " عنه إبراهيم بن يمان " جش ".(@)(@@)(@@)(@@) $ 2180 - زيتون أبو محمد القمي " م " كما في المنتهى في الكنى.(@)(@@)(@@)(@@) $ 2181 - زياد بن الحسن الوشاء " ظم ".(@)(@@)(@@)(@@) $ 2182 - زياد بن سليمان البلخي " ظم ".(@)(@@)(@@)(@@) $ 2183 - زياد بن الهيثم الوشاء " ظم ".(@)(@@)(@@)(@@) $ 2184 - زيد بن علي بن الحسين بن زيد، روى محمد بن علي قال: أخبرني يد فقال: مرضت، فدخل الطبيب على أبي ووصف لي دواءا لم يمكني تحصيله في الليل خرج من الباب، فورد صاحب أبي الحسن عليه السلام في الحال ومعه جرة فيها ذلك لدواء إلى آخره.(@)(@@)(@@)(@@) $ 2185 - زيد بن موسى، من رجال " ظم " عليه السلام واقفي " صه " " جخ " وفي " ق " ابن موسى الجعفي الكوفي.(@)(@@)(@@)(@@) $ 2186 - سالم بن أبي سلمة الكندي السجستاني، حديثه ليس بالنقي وان كنا لا نعرف منه الا خيرا، له كتاب " جش " وفي " صه " عنه ابنه لا يعرف 
ms216	 وروى عنه غيره، وهو ضعيف وأحاديثه مختلطة، ولعل منشأ تضعيفه من " غض " ويظهر من " جش " حسن حاله، فتأمل.(@)(@@)(@@)(@@) $ 2187 - سجادة واسمه الحسن بن علي بن أبي عثمان.(@)(@@)(@@)(@@) $ 2188 - السري بن سلامة الأصبهاني " دي " " ست " عنه أحمد بن أبي عبد الله في " مشكا " و " ست " قيل: ويظهر من الشيخ كونه اماميا، ولكن في " مشكا " ابن سلمة. PageV01P307(@)(@@)(@@)(@@) $ 2189 - سعد بن أبي عمران، من أصحاب " ظم " عليه السلام واقفي أنصاري " صه " " جخ " وفي " د " ابن عمران الأنصاري " ظم " " جخ " واقفي.(@)(@@)(@@)(@@) $ 2190 - سعد بن الأحوص، له كتاب عنه البرقي " ست " ليس له مدح ولا ذم، ومجرد كونه صاحب الكتاب لا يفيد.(@)(@@)(@@)(@@) $ 2191 - سعد بن حماد، مجهول من أصحاب " ضا " عليه السلام وفي بعض النسخ سعيد كما يأتي.(@)(@@)(@@)(@@) $ 2192 - سعد خادم المكنى بأبي دلف بضم الأول ظاهرا، له مسائل عن الرضا عليه السلام، عنه أحمد بن أبي عبد الله " ست " " جش " وفي " د " سعيد.(@)(@@)(@@)(@@) $ 2193 - سعد بن خلف من أصحاب " ظم " عليه السلام واقفي " صه " " جخ " وزاد " صه " من أصحاب " ظم " عليه السلام.(@)(@@)(@@)(@@) $ 2194 - سعد بن سعد الأحوص بن سعد بن مالك الأشعري، ثقة روى عن الرضا وأبي جعفر عليهما السلام " ضا " " جش " " صه " وفي طرق الأصحاب عن عبد الله بن الصلت القمي أن أبا جعفر عليه السلام سأل الله أن يجزيه خيرا، عنه عباد ومحمد البرقي.(@)(@@)(@@)(@@) $ 2195 - سعد بن سعيد البلخي " ظم " لم يذكر له في الرجال مدحا أصلا، فالتوقف فيه أحرى.(@)(@@)(@@)(@@) $ 2196 - سعد بن مسلم، الذي روى عنه عمر بن توبة كتاب انا أنزلناه " صه " لا نعرفه " صه " " د " والظاهر أنه كضعف راويه كما يأتي.(@)(@@)(@@)(@@) $ 2197 - سعيد بن أخت صفوان بن يحيى، أخو فارس الغالي " ضا " هكذا وجدته منه وهو غير مشعر بالقبول.(@)(@@)(@@)(@@) $ 2198 - سعيد بن جناح، كوفي الأصل البغدادي منشأ ومضجعا مولى الأزد أو الجهينة، وهو وأخوه أبو عامر ثقتان، روى عن الرضا عليه السلام " ست " " جش " " صه " عنه أحمد بن محمد بن عيسى في الثاني، وعبد الله بن محمد البرقي في 
ms217	 الأول.(@)(@@)(@@)(@@) $ 2199 - سعيد بن جمهان بضم الأول واسكان الميم الأسلمي أبو حفص PageV01P308(@)(@@) البصري صدوق، كذا وجدته في بعض الحواشي، الا أني لم أقف على صاحبه.(@)(@@)(@@)(@@) $ 2200 - سعيد خادم أبي دلف العجلي " ضا " " جش " " د " تقدم عن " جش " و " ست " أنه سعد بدون الياء المثناة.(@)(@@)(@@)(@@) $ 2201 - سعيد بن سعيد " ج " القمي " ضا " ولا يبعد كونه سعدا كما مر في عنوانه وزيادة الياء غفلة من النساخ. ويحتمل العكس كما يحتمل التعدد بالاخوة، فحينئذ يلزم حصول الغفلة في الأب.(@)(@@)(@@)(@@) $ 2202 - سعيدة ومنة أختا محمد بن أبي عمير " ق " ولعلهما في التالية أيضا.(@)(@@)(@@)(@@) $ 2203 - سلمان بن أبي زيد " ظم " لم أقف في الرجال على مدح ولا ذم، فيترك حديثه، والله أعلم.(@)(@@)(@@)(@@) $ 2204 - سلمان بن ربعي بن عبد الله الهمداني " ظم " لم يكن له مدح يوجب الوثوق عليه.(@)(@@)(@@)(@@) $ 2205 - سلمة بن حيان، من أصحاب " ظم " عليه السلام واقفي " صه " " جخ " وفي كثير من نسخ الأول حنان بالنون.(@)(@@)(@@)(@@) $ 2206 - سلمة بن محمد أخو منصور، كوفي روى عن " ظم " عليه السلام ثقتان " جش " له كتاب عنه محمد بن بكير أو بكر بن جناح " ست " " جش " ويأتي في التالية.(@)(@@)(@@)(@@) $ 2207 - سليمان بن جرير، سيجئ في سند الروايات، وليس في كتب الرجال، والظاهر أنه في هذه الطبقة.(@)(@@)(@@)(@@) $ 2208 - سليمان بن جعفر بن إبراهيم بن محمد بن علي بن عبد الله بن جعفر الطيار أبو محمد الطيالسي الجعفري، روى عن الرضا عليه السلام وأبوه عن أبيه وجده عليهما السلام وكانا ثقتين " صه " " جش " " ست " " ضا " عنه البرقي أحمد وعبد الله.(@)(@@)(@@)(@@) $ 2209 - سليمان بن جعفر المروزي، قال جدي: يظهر من العيون أنه كان من علماء خراسان وأوحديهم، وباحث مع " ضا " عليه السلام ورجع إلى الحق، وله PageV01P309(@)(@@) مكاتبات إلى " ج " و " دي " وربما يخطر بالبال أنهما رجلان، لان له روايات عن " ظم " وان احتمل أن يكون معتقدا للحق سابقا وكانت المباحثة تقية، مع أن الظاهر أن " ق " يعتقد ثقته، إلى آخر ما ذكره " تعق ".(@)(@@)(@@)(@@) $ 2210 - سليمان بن حفصوية " دي " وفي " تعق " احتمل 
ms218	 كونه ابن حفص المذكور.(@)(@@)(@@)(@@) $ 2211 - سليمان بن خالد الخطاب " ظم ".(@)(@@)(@@)(@@) $ 2212 - سليمان بن داود الخفاف " ضا ".(@)(@@)(@@)(@@) $ 2213 - سليمان بن داود المروزي " دي ".(@)(@@)(@@)(@@) $ 2214 - سليمان بن ربعي بن عبد الله الهمداني " ظم " ويحتمل كونه سلمان وتقدم، ولكن الظاهر أنهما أخوان، وسليمان أشهرهما، فتدبر.(@)(@@)(@@)(@@) $ 2215 - سليمان بن سالم، قال " ز ": مجهول الحال.(@)(@@)(@@)(@@) $ 2216 - سليمان بن سفيان أبو داود المسترق، وهو المنشد ثقة يروي عنه الفضل بن شاذان وهو عن سفيان الشاعر العبدي وابن محبوب وعبد الرحمن بن أبي نجران، الا أن " كش " قال: مات سنة ثلاثين ومائة وهو بعيد بل سهو، إذ يصير من أصحاب " ق " بل " قر " عليهما السلام وما في " جش " مات سنة إحدى وثلاثين ومائتين وإن كان أصح، ولكنه أيضا بعيد محتاج إلى النظر، والله العالم.(@)(@@)(@@)(@@) $ 2217 - سليمان بن سماعة الضبي الكوزي، من بني الكوز، كوفي حذاء ثقة روى عن عمه عاصم وعن غيره، عنه سلمة بن الخطاب.(@)(@@)(@@)(@@) $ 2218 - سليمان بن عبد الله الهذلي " ظم ".(@)(@@)(@@)(@@) $ 2219 - سليمان بن محمد المؤمن " ظم ".(@)(@@)(@@)(@@) $ 2220 - سليمان المروزي " ضا " يحتمل ضعيفا كونه ابن داود المروزي وعمر إلى زمان مولانا أبي الحسن الثالث عليه السلام.(@)(@@)(@@)(@@) $ 2221 - سليمان بن المعلى بن خنيس، قال " غض ": انه ضعيف " صه " " د " وهو غير معلوم اجتهادا الا أنه مردود الحديث فقاهة، كما هو الرأي في كل نظرائه. PageV01P310(@)(@@)(@@)(@@) $ 2222 - سندي بن الربيع البغدادي " ست " " جش " روى عن " ظم " عليه السلام له كتاب عنه صفوان بن يحيى وغيره " جش " عنه الصفار " ست " وعن نسخة من " لم ".(@)(@@)(@@)(@@) $ 2223 - سندي بن محمد أخو علي، وهو ابن أخت صفوان، كان ثقة وجها في أصحابنا الكوفيين، عنه جماعة منهم أحمد البرقي وابن علي بن محبوب والصفار، فيسقط الواسطة على الأخير.(@)(@@)(@@)(@@) $ 2224 - سهل بن اليسع بن عبد الله بن سعد الأشعري، قمي ثقة ثقة، روى عن " ظم " و " ضا " عليهما السلام عنه بكتابه ابنه محمد " جش ".(@)(@@)(@@)(@@) $ 2225 - سيف بن عميرة النخعي الكوفي، عربي ثقة واقفي من أصحاب " ظم " وربما ضعفه بعضهم، والظاهر العدم، عنه علي بن 
ms219	 الحكم " ست " محمد بن خالد الطيالسي " جش " " صه " يروي عن الصادق عليه السلام أيضا.(@)(@@)(@@)(@@) $ 2226 - شاهوية بن عبد الله " دي " الجلاب وصالح أخوه " ري ".(@)(@@)(@@)(@@) $ 2227 - شاذان بن الخليل والد الفضل النيسابوري " ج " من أصحاب يونس " صه " وفي " تعق " في محمد بن سنان ما يؤمي على كونه من العدول والثقات من أهل العلم، وفي ابنه الفضل ما يؤمي إلى نباهته.(@)(@@)(@@)(@@) $ 2228 - شاه رئيس أبو عبد الله الكندي، كان من الغلاة الكبار الملعونين " كش " وفي " تعق " في النقد قال نصر: انه من الغلاة الكبار الملعونين في وقت علي بن محمد العسكري عليه السلام " كش "، وسيجئ ذلك في عباس بن صدقة.(@)(@@)(@@)(@@) $ 2229 - شريف بن سابق بالباء الموحدة التفليسي، عنه البرقي أحمد " لم " " ست " وعن أبيه عنه أيضا في الثاني، يكنى أبا محمد أصل كوفي انتقل إلى تفليس روى عن الفضل بن أبي قرة السندي، ضعيف مضطرب الامر " صه ".(@)(@@)(@@)(@@) $ 2230 - شعيب بن حماد، من أصحاب " ضا " لم أر العمل بروايته، والله أعلم،(@)(@@)(@@)(@@) $ 2231 - شعيب المحاملي، عنه البرقي " لم " له كتاب، أحمد بن أبي عبد الله عن أبيه عنه " ست " فعلى هذا يكون في الطبقة الآتية أيضا، وفي " مشكا " المحاملي عنه PageV01P311(@)(@@) محمد بن خالد البرقي.(@)(@@)(@@)(@@) $ 2232 - صالح المكنى بأبي محمد، له روايات عنه القاسم بن إسماعيل وأحمد بن ميثم " ست " " لم ".(@)(@@)(@@)(@@) $ 2233 - صالح الحذاء، له كتاب عنه القاسم بن إسماعيل " جش " وأحمد بن ميثم " ست " " لم ".(@)(@@)(@@)(@@) $ 2234 - صالح بن خالد أبو شعيب المحاملي الكناسي مولى علي بن الحكم بن الزبير مولى بني أسد، روى عن أبي الحسن موسى عليه السلام له كتاب، عنه جماعة منهم ابن معروف ثقة جليل.(@)(@@)(@@)(@@) $ 2235 - صالح بن خالد القماط، له كتاب عنه محمد بن سنان والقاسم بن إسماعيل وأحمد بن ميثم " جش " " ست " والظاهر أنه أبو خالد كما ذكره " د " وفي " تعق " فيه ما سيجئ في ابن خالد.(@)(@@)(@@)(@@) $ 2236 - صالح الخباز، كوفي من أصحاب " ضا " عليه السلام وفي نسخة ابن الخباز.(@)(@@)(@@)(@@) $ 2237 - صالح بن سعيد الأحول، من أصحاب أبي الحسن 
ms220	 موسى عليه السلام مجهول " صه " " جخ ".(@)(@@)(@@)(@@) $ 2238 - صالح بن سلمة الرازي أبو الخير " دي " " كش " وهو ابن أبي حماد، وقد تقدم في السابقة.(@)(@@)(@@)(@@) $ 2239 - صالح بن السندي، له كتاب عنه أحمد بن أبي عبد الله البرقي " ست " روى عن يونس بن عبد الرحمن، روى عن إبراهيم بن هاشم " لم ".(@)(@@) أقول: يجوز أن يكون في الطبقة الآتية.(@)(@@)(@@)(@@) $ 2240 - صالح بن سهل، من أهل همدان كوفي الأصل، من رجال " ج " كما ذكره الشيخ في كتاب الغيبة غال كذاب وضاع للحديث. قيل: روى عن أبي عبد الله عليه السلام فتأمل.(@)(@@)(@@)(@@) $ 2241 - صالح بن عبد الله الجلاب " ري " والظاهر أنه في الطبقة السابقة PageV01P312(@)(@@) كما مر.(@)(@@)(@@)(@@) $ 2242 - صالح بن عبد الله الخثعمي " ضا ".(@)(@@)(@@)(@@) $ 2243 - صالح بن علي بن عطية الأضخم أبو محمد بصري، كان أخباريا وهو ضعيف " صه " " د " ويحتمل اتحاده مع صالح أبي محمد المتقدم، كما احتمله الميرزا فتدبر.(@)(@@)(@@)(@@) $ 2244 - صالح بن علي بن عطية البغدادي " ضا " يمكن اتحاده مع الأضخم، وإن كان بعيدا إذ لم يحتمله أحد.(@)(@@)(@@)(@@) $ 2245 - صالح القماط، له كتاب عنه القاسم بن إسماعيل وأحمد بن ميثم " ست " حميد عن أحمد بن ميثم عنه " لم " والظاهر أنه ابن خالد المتقدم، كما استظهره الميرزا.(@)(@@)(@@)(@@) $ 2246 - صالح بن محمد بن سهل، ذكره الشيخ في الغيبة من المذمومين، وأشار إليه " مه " في ترجمة ابن سهل أنه هذا، وما ذكره " غض " في ترجمته كذاب وضاع لعله فاسد، إذ في " في " رواية صريحة في عدم غلوه واعتقاده الإمامة فيهم عليهم السلام فلاحظ وتأمل.(@)(@@)(@@)(@@) $ 2247 - صالح بن محمد الهمداني " ج " " دي " ثقة " ي " " صه ".(@)(@@)(@@)(@@) $ 2248 - صالح بن موسى بن عمر بن بزيع " دي " وابن عيسى نسخة غير صحيحة.(@)(@@)(@@)(@@) $ 2249 - صباح الحذاء الكوفي، له كتاب عنه عبيس " ست " وربما احتمل أن يكون ابن صبيح الحذاء الآتي الثقة، فيكون في الطبقة الآتية.(@)(@@)(@@)(@@) $ 2250 - صباح بن نصر الهندي له مسائل عن الرضا عليه السلام عنه الريان بن شبيب " جش " وبمجرده لا يدل على القبول.(@)(@@)(@@)(@@) $ 2251 - صدقة الخراساني " ضا ".(@)(@@)(@@)(@@) $ 2252 - صفوان 