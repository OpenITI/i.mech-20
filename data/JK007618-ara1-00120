ms101	 % 53(@)(@@) % فهن بما أوليتني من صنائع % عن الناس إلا عن نداك غواني % % PageV01P383 البحر : كامل تام 1(@)(@@) % إن كان دينك في الصبابة ديني % % فقف المطي برملتي يبرين % 2(@)(@@) % والثم ثرى لو شارفت بي هضبه % أيدي المطي لثمته بجفوني % % 3(@)(@@) % وانشد فؤادي في الظباء معرضا % فبغير غزلان الصريم جنوني % % 4(@)(@@) % ونشيدتي بين الخيام وإنما % % غالطت عنها بالظباء العين % 5(@)(@@) % لولا العدى لم أكن عن ألحاظها % % وقدودها بجوازىء وغصون % 6(@)(@@) % لله ما اشتملت عليه قبابهم % يومض النوى من لؤلوء مكنون % 7(@)(@@) % من كل تائهة على أترابها % % بالحسن غانية عن التحسين % 8(@)(@@) % خود تري قمر السماء إذا بدت % ما بين سالفة وبين جبين % 9(@)(@@) % غادين ما لمعت بروق ثغورهم % إلا استهلت بالدموع جفوني % % 10(@)(@@) % إن تنكروا نفس الصبا فلأنها % % مرت بزفرة قلبي المحزون % PageV01P384 11(@)(@@) % وإذا الركائب في الجبال تلفتت % فحنينها لتلفتي وحنيني % % 12(@)(@@) % يا سلم إن ضاعت عهودي عندكم % فأنا الذي استودعت غير أمين % 13(@)(@@) % أو عدت مغبونا فما أنا في الهوى % % لكم بأول عاشق مغبون % 14(@)(@@) % رفقا فقد عسف الغرام بمطلق العبرات في أسر الغرام رهين % عبرات في أسر الغرام رهين % 15(@)(@@) % ما لي ووصل الغانيات أرومه % ولقد بخلن علي بالماعون % 16(@)(@@) % وعلام أشكو والدماء مطاحة % بلحاظهن إذا لوين ديوني % % 17(@)(@@) % هيهات ما للبيض في ود مرىء % أرب وقد أربى على الخمسين % 18(@)(@@) % ومن البلية أن تكون مطالبي % % جدوى بخيل أو وفاء خؤون % 19(@)(@@) % ليت الضنين على المحب بوصله % لقن السماحة من صلاح الدين % 20(@)(@@) % ملك إذا علقت يد بذمامه % علقت بحبل في الوفاء متين % PageV01P385 21(@)(@@) % قاد الجياد معاقلا وإن اكتفى % % بمعاقل من رأيه وحصون % 22(@)(@@) % وأعد للأعداء كل مهند % ومثقف ومضاعف موضون % 23(@)(@@) % سهرت جفون عداه خيفة ماجد % خلقت صوارمه بغير جفون % 24(@)(@@) % لو أن لليث الهزبر سطاه لم % يلجأ إلى غاب له وعرين % 25(@)(@@) % والبحر لو مزجت به أخلاقه % عادت مياه البحر غير أجون % 26(@)(@@) % والأرض لو شيبت بطيب ثناه لم % تنبت سوى الخيري والنسرين % 27(@)(@@) % والدهر لو أعداه طيب طباعه 
ms102	 % ما شين من أبنائه بضنين % 28(@)(@@) % قسما لقد فضل ابن أيوب الحيا % % بسماح كف بالنضار هتون % 29(@)(@@) % مخلوقة من سودد وندى وقد % خلق الأنام سلالة من طين % 30(@)(@@) % يا من إذا نزل الوفود ببابه % نزلوا بجم من نداه معين % PageV01P386 31(@)(@@) % أضحت دمشق وقد حللت بربعها % % مأوى الطريد ومؤئل المسكين % 32(@)(@@) % وغدت بعدلك وهي أكرم منزل % تلقى الرحال به وخير قطين % 33(@)(@@) % يثني عليك المعتفون بها كما % % تثني الرياض على السحاب الجون % 34(@)(@@) % لك عفة في قدرة وتواضع % في عزة وشراسة في لين % 37(@)(@@) % وضمنت أن تحيي لنا أيامهم % وأريتنا بجميل صنعك ما روى ال % % 38(@)(@@) % كاد الأعادي أن يصيبك كيدها % % لو لم تكدك برأيها المأفون % 39(@)(@@) % تخفي عداوتها وراء بشاشة % فتشف عن نظر لها مشفون % 40(@)(@@) % دفنت حبائل مكرها فرددتها % % تدوى بغيظ صدورها المدفون % 41(@)(@@) % وعلمت ما أخفوا كأن قلوبهم % % أفضت إليك بسرها المخزون % 42(@)(@@) % كمنوا وكم لك من كمين سعادة % في الغيب يظهر من وراء كمين % PageV01P387 43(@)(@@) % فهوت نجوم سعودهم وقضى لهم % بالنحس طائر جدك الميمون % 45(@)(@@) % وإليك بكرا من ثنائك حرة % تختال في وشي القوافي العون % 46(@)(@@) % غراء ما دنست ملابسها على % % أيدي اللئام بنائل ممنون % 47(@)(@@) % أرج الثناء يفوح من أثنائها % % وكأنما جاءتك من دارين % 48(@)(@@) % كم سامني فيها البخيل ولم أكن % لأشين رونق حسنها بمشين % 49(@)(@@) % أتراه يطمع أن يصون ثراءه % عني ووجهي عنه غير مصون % 50(@)(@@) % فاجعل قبولك واهتزازك مهرها % % و ظفر بعلق في الثناء ثمين % 51(@)(@@) % وأبيك ما سامحت في إرسالها % % دوني لأني قانع بالدون % 52(@)(@@) % كلا ولا أني أراع لنية % قذف على أيدي المطي شطون % 53(@)(@@) % لكن أصيبية لوقع فراقهم % في القلب وقع اللهذم المسنون % PageV01P388 54(@)(@@) % لولاهم ما قادني أمل ولا % % ضمته مكة من صفا وحجون % 55(@)(@@) % وبكل أشعث كالحنية شاحب % يهوي به حرف كحرف النون % 56(@)(@@) % وبكل دامية الأظل شملة % وجناء فتلاء الذراع أمون % 58(@)(@@) % لولاك لم يشدد على ظهر المنى % % رحلي ولم يعلق عليه وضيني % % 59(@)(@@) % ولطالما عفت المطالب قبلها % % ونفضت 
ms103	 من جدوى الملوك يميني % % 60(@)(@@) % فإذا أنيخت في عراصك عيسها % % فاعلم أبيت اللعن علم يقين % 61(@)(@@) % أني امرؤ هجر المطامع مذهبي % % والصون عادي والقناعة ديني % % 62(@)(@@) % لا الفقر يلبسني لباس مذلة % ضرعا ولا ثوب الغنى يطغيني % % 63(@)(@@) % والبحر عندي حين أطمع نغبة % وإذا قنعت فبلغة تكفيني % % 64(@)(@@) % قد هذبتني للزمان تجارب % فأقاد صعبي و ستلان حروني % % PageV01P389 65(@)(@@) % شحذت لياليه غرار خلائقي % % بصياقل من صرفها وقيون % 66(@)(@@) % فاليوم لا أنا حاسد لثراء من % فوقي ولا زار على من دوني % % 67(@)(@@) % ولقد رقدت وللزمان قوارض % تعتادني وشوائب تصميني % % 68(@)(@@) % أغضي عليها والإباء يهب بي % ' قوض خيامك عن ديار الهون % 69(@)(@@) % واقصد حمى ملك عزيز جاره % سامي الذوائب شامخ العرنين % PageV01P390 البحر : رجز تام 1(@)(@@) % أثقل ظهري بالمنن % خدن العلى أبو الحسن % 2(@)(@@) % وصابني عن بذلة % لولاه عنها لم أصن % 4(@)(@@) % على العرف ثمن % سر الصديق مؤتمن % 7(@)(@@) % راهنة شكري بها % % إلى الممات مرتهن % 8(@)(@@) % يفديك من لقاؤه % يهدي إلى القلب الحزن % 9(@)(@@) % معدم وجوده % غضاضة على الزمن % 11(@)(@@) % قد جمع الخسة في % % طول القرون في قرن % 14(@)(@@) % من معشر قد رضعوا % % لؤم الطباع في اللبن % 15(@)(@@) % أصخ لها مدائحا % قد حكمت لي باللسن % 19(@)(@@) % فابق طريل العمر ما % % صاب غمام وهتن % PageV01P391 20(@)(@@) % وما سرى برق وما % % مال بغريد فنن % PageV01P392 البحر : خفيف تام 1(@)(@@) % جادك الواكف الهتن % من مغان ومن دمن % 2(@)(@@) % وسقتك الدموع إن % رقأت أدمع المزن % 3(@)(@@) % أين أقمارك الوضاء % وأغصانك اللدن % 5(@)(@@) % إذ رقيب الهوى غفو % % ل وأسراره علن % 6(@)(@@) % وسهام الملام ما % % سقاما على بدن % 7(@)(@@) % ومزار الأحباب لم % من الغل والدرن % 8(@)(@@) % كم بذاك الأراك من % وطر لي ومن وطن % 9(@)(@@) % في موطن تهن % شجو قلب ومن شجن % 11(@)(@@) % فوجيب الفؤاد مذ % وجناء كالفدن % 12(@)(@@) % بالمال قد غبن % وأقلت غوارب الم % PageV01P393 15(@)(@@) % ولعان يبكي المنا % % زل شوقا إلى السكن % 16(@)(@@) % المحض في اللبن % فسد الناس فالمودات % 17(@)(@@) % عذلوه وما دروا % % والوجد ما ظعن % 18(@)(@@) % ما على ذي صبابة % بهوى 
ms104	 الغيد ممتحن % 19(@)(@@) % فتنته أدماء سا % % حرة الطرف ف فتتن % 20(@)(@@) % غادة بت عاكفا % من هواها على وثن % 21(@)(@@) % تفضح الدعص والأرا % % كة والشادن الأغن % 22(@)(@@) % أنظروها كما نظر % ت فلوموا فيها إذن % 26(@)(@@) % غير مؤتمن % جاءك الغيث من زمن % 27(@)(@@) % أنت أظهرت من عيوب % أخي الشيب ما بطن % PageV01P394 28(@)(@@) % والحبيب الخوان لو % % لاك يا شيب لم يخن % 30(@)(@@) % فرماني مجاهرا % لي الهم والحزن % 31(@)(@@) % فمتى يا صروفه % تنقضي بيننا الإحن % 33(@)(@@) % فتوحد ولا تكن % ذا سكون إلى سكن % 35(@)(@@) % فأخو الفضل حيث كا % % ن غريبا عن الوطن % 36(@)(@@) % فهو كالماء ما أقا % % م بأرض إلا أجن % 37(@)(@@) % والفتى الحازم الذي % % سبر الدهر وامتحن % 38(@)(@@) % من دنت منه فرصة % فرأى فوتها غبن % 39(@)(@@) % وإذا ما تغافلت % عنه أيامه فطن % 40(@)(@@) % كالأجل الموفق ابن % ووداد مني بمن % PageV01P395 41(@)(@@) % شم سماء أبو علي % والرأي في قرن % 42(@)(@@) % يتقي الله في السريرة % تقواه في العلن % 43(@)(@@) % قائم بالفروض من % م السرابيل والجنن % 44(@)(@@) % فهو من سنة المكا % % رم جار على سنن % 45(@)(@@) % حل من ذروة العلى % % الودق ف رجحن % 46(@)(@@) % نهضت عنه منجب % زلة الروح في البدن % 50(@)(@@) % واعتزام ما خار يو % % م جلاد ولا وهن % 51(@)(@@) % وهو غيث إذا استلان % وليث إذا خشن % 52(@)(@@) % يزن الحمد عنده % ملك كسرى وذي يزن % 54(@)(@@) % فهو يستعظم المديح % ويستحقر الثمن % PageV01P396 55(@)(@@) % وإذا العرض لم يذل % دونه المال لم يصن % 57(@)(@@) % غادرتها النوى الشطون % من الأين كالشطن % 58(@)(@@) % فهي نسع في النسع أو % رسن قيد في رسن % 59(@)(@@) % يترامى به البلاد % وسحاب نداه ين % 61(@)(@@) % وتبدل لين المهاد % من المنزل الخشن % 62(@)(@@) % فهو لابن السبيل يأ % وي إليه نعم العطن % 63(@)(@@) % فنزيل الإحسان من % لست أولى عين جنيت % 66(@)(@@) % سلف المال في الثناء % إذا غيره حتجن % 67(@)(@@) % ويرى ما سخا به % صبح ورقاء في فنن % 69(@)(@@) % قد أتتك العذراء ما % % مس أثوابها درن % PageV01P397 71(@)(@@) % فهي أخت الآداب أم % المعالي بنت اللسن % 72(@)(@@) % وهي تبرا إليك من 
ms105	 % حصر القول واللحن % 74(@)(@@) % زفها محسن تقر % لإحسانه الفطن % 75(@)(@@) % راضها برهة وتأبى % % عليه إلا الحرن % 76(@)(@@) % ثم أعطى قياده % وزنها فيك فاتزن % 77(@)(@@) % بارك الله فيكما % % من عروس ومن ختن % 78(@)(@@) % كرمت محتدا وكل % كريم بها قمن % 79(@)(@@) % ودعاها إليك ما % % سار من ذكرك الحسن % 81(@)(@@) % أحكمته على مرور % الليالي يد الزمن % 82(@)(@@) % فهو بين الضلوع في % % حبة القلب مختزن % PageV01P398 83(@)(@@) % وسيطوى معي إذا % % ضمني اللحد في الكفن % PageV01P399 البحر : خفيف تام 1(@)(@@) % وخيال سرى إلي فأدنا % % ها على النأي والمزار شطون % 2(@)(@@) % سار يطوي الفلا وحيدا ومن دو % % ن سراه مهامه وحزون % 3(@)(@@) % زائر في الظلام يسمح بالوصل ومهديه بالسلام ضنين % السلام ضنين % 4(@)(@@) % لم يكد يهتدي لرحلي لولا % زفرات من دونه وأنين % 7(@)(@@) % وظباء من عامر ما رنت إ % % لا أرتنا أن الكناس عرين % % 8(@)(@@) % بثغور يشجى بهن الأقاحي % % وقدود تشقى بهن الغصون % 9(@)(@@) % إن يطاعن فالرماح قدود % أو يناضلن فالسهام عيون % 10(@)(@@) % يا ابنة القوم كيف ضاعت عهودي % % بينكم والوفاء في العرب دين % 11(@)(@@) % كيف أثسلمت فيكم إلى الأشجان % لولا الغرام جنون % 12(@)(@@) % قد تمادى هواك لي فسقامي % % فيك باد وداء قلبي دفين % PageV01P400 13(@)(@@) % وتقضى المدى وما أقصر العا % % كرم العد والمياه أجون % 14(@)(@@) % من تناسى عهد الشباب وأيا % % ملكتني لك الأيادي فإن أم % 16(@)(@@) % أنا من قد علمت عهدي على النأ % ي وثيق وحبل ودي متين % 18(@)(@@) % أنا ماء على التواصل رقرا % % ق وفي الهجر صخرة لا تلين % 19(@)(@@) % عدني مورد الهوان فلا صا % % دفت ريا يكون في الري هون % 20(@)(@@) % علمتني الآباء أخلاق قوم % أقسموا أن جارهم لا يهون % 21(@)(@@) % لا تخف في جوارهم نوب الأ % يام فالجار فيهم مضمون % 22(@)(@@) % ألمصيبون في دجى الخطب والمعطون في الجدب والسحاب ضنين % ب بوجه ينجاب عنه الدجون % 23(@)(@@) % يكتسي الترب عرفهم فمكان % وطئته نعالهم دارين % 24(@)(@@) % لكم يا بني المظفر آيا % % ت وفضل يوم الفخار متين % PageV01P401 25(@)(@@) % لا تساميكم القبائل فالنا % % س الدنايا وأنتم العرنين % 27(@)(@@) % والليالي 
ms106	 بيض لديكم إذا الأ % يام أمست بغيركم وهي جون % 29(@)(@@) % وغمار الفلا كأن مطايا % % ك سلوا إني إذا لخؤون % 30(@)(@@) % ينشد المكرمات في كل أرض % ليس فيها عما أضل مبين % 32(@)(@@) % حيث روض الندى جميم وماء % لجود غمر للسائلين معين % 33(@)(@@) % لا تؤمل سواه فهو كفيل % لمساعيك بالنجاح ضمين % 34(@)(@@) % تلق منه بحرا وطود حمى يأ % ك للشائمين وهو يمين % 38(@)(@@) % مصلت من مضائه سيف عزم % سلطته على النفوس المنون % 39(@)(@@) % سيفه من مضاء كفيه والدر % ع عليه من قلبه موضون % 40(@)(@@) % إن سخا أو سطا فلا الأسد الو % رد بضار ولا السحاب هتون % PageV01P402 41(@)(@@) % يشرق التاج منه فوق جبين % كسروي للتاج فيه غضون % 42(@)(@@) % قوله يفضل الفعال ويسرا % % ه إذا راح للعطاء يمين % 44(@)(@@) % صان قدري عن معشر يحرم السا % % ئل فيهم ويمنع الماعون % 46(@)(@@) % حاش لله أن تراني فيهم % ناء حرف مثل الهلال أمون % 47(@)(@@) % أرتجي فضل ناقص وأداري % % كل جنس ما في سجاياه لين % 50(@)(@@) % مستهام بالبخل صب كما ها % % م إلى الأخيلية المجنون % 51(@)(@@) % وكأن العافي يخاطب من جد % واه رسما برامة لا يبين % 52(@)(@@) % ففدت كفك التي جودها الكو % ثر كف عطاؤها غسلين % 53(@)(@@) % صدقت فيك يا محمد آما % % لي وخابت لدى سواك الظنون % 55(@)(@@) % عودتني النعمى يداك وعاد % % ت الأيادي على الكرام ديون % PageV01P403 56(@)(@@) % كل عام تجدها لك نعما % % ك فلا أخلفت علاك السنين % 60(@)(@@) % أكتسي رونقا بملبسها الضا % % في فتمسي صورا إلي العيون % 61(@)(@@) % زائر في الظلام يسمح بالوص % قر منها معاقل وحصون % 62(@)(@@) % فاستمعها عذراء تحمل أبكا % % ر المعاني منها قواف عون % 64(@)(@@) % ف فترع ذروة البقاء بملك % أخمصاه التأييد والتمكين % 65(@)(@@) % بالغا في أخيك ما ناله مو % % سى وقد شد إزره هارون % 66(@)(@@) % مذ دعوه تاجا تمنى هلال ال % أفق لو انه الغداة جبين % 67(@)(@@) % وابق وابناك ما أقام ثبير % لمني ناصري وقل المعين % 68(@)(@@) % فبهاء الدين الذي إن دعو % ناه لخطب فحده مسنون % 69(@)(@@) % أدعه للسماح والبأس يلقا % % ك مجيبا 
ms107	 منه القوي الأمين % PageV01P404 72(@)(@@) % ضع من حادث ولا أستكين % رضع الطفل واستهل الجنين % PageV01P405 البحر : مجزوء الكامل 1(@)(@@) % أترى تعود لنا كما % % سلفت ليالي الأبرقين % 3(@)(@@) % إن حالت الأيام بي % ي محمد بقرابتين % 5(@)(@@) % شعب تصدع ف ستطا % % ها الدهر في تعب وأين % 6(@)(@@) % يا دين قلبك من ظبا % % ء لا يرين قضاء دين % 7(@)(@@) % ألمخلفات كأنهن % خلقن من وعد ومين % 9(@)(@@) % مهلا فما شيبي بأ % ول غادر بغديرتين % 10(@)(@@) % وأغن معسول الرضا % % ب جني ورد الوجنتين % 11(@)(@@) % أمسى يحيني وقد % غفل الرقيب بقهوتين % 15(@)(@@) % فاليوم يفرق إن رأى % % مني بياض المفرقين % 16(@)(@@) % أنا من هوى لبنى ومن % فودي أسير لبانتين % PageV01P406 17(@)(@@) % ولقد نضا صبغ الشبا % % ب وكان خير الصبغتين % 18(@)(@@) % فسقى الحيا عهد الصبى % % وعهودهن برامتين % 20(@)(@@) % فتكر عاطفة بوص % ولوت على العلياء ديني % % 21(@)(@@) % ومضت بوفر كان من % ولينسفن حرى وهض % 22(@)(@@) % أو فل مني الدهر ذا % % شطب رقيق الشفرتين % 24(@)(@@) % وأصبت في عيني التي % % كانت هي الدنيا بعين % 25(@)(@@) % عين جنيت بنورها % % نور العلوم وأي عين % 26(@)(@@) % حالان مستني الحوا % % دث منهما بفجيعتين % 27(@)(@@) % إظلام عين في ضيا % % ء مشيب رأس سرمدين % 28(@)(@@) % صبح وإمساء معا % د غدا خلاف الحالتين % PageV01P407 30(@)(@@) % في برزخ منها أخا % % كمد حليف كآبتين % 31(@)(@@) % أسوان لا حي ولا % % ميت كهمزة بين بين % 34(@)(@@) % ولت فما لي طالبا % أثرا لها من بعد عين % 37(@)(@@) % أرسى على غمدان و % لإيوان منه بكلكلين % 38(@)(@@) % وأباد ذا يزن وأر % دى ذا الكلا وذا رعين % 40(@)(@@) % وسطا على بهرام جو % ر وأزدشير العادلين % 41(@)(@@) % لم يدفع الحدثان ما % % جمعوه من ورق وعين % 43(@)(@@) % فبدا برزء في أبي % % حسن وثنى بالحسين % 46(@)(@@) % ولرب أغلب من أسو % % د خفية ذي لبدتين % 48(@)(@@) % طرقت حوادثه وأ % ية غاية تردي وحين % PageV01P408 50(@)(@@) % ولسوف يرقى كيده % فيشت شمل الفرقدين % 51(@)(@@) % ولربما نالت دوا % % ئره مدار النيرين % 54(@)(@@) % وليلقين على أبان % ركنه وعلى جنين % 55(@)(@@) % فاحمل شدائده على % % ظهر شديد المنكبين % 57(@)(@@) % فالناس في 
ms108	 كف الحوا % % دث زبرة في كف قين % 58(@)(@@) % واصبر لما طرقت به ا % % لأحداث من صعب وهين % % PageV01P409 البحر : بسيط تام 1(@)(@@) % ما بعتكم مرخصا ما عن من عمري % % إلا لأني محتاج إلى الثمن % 2(@)(@@) % لو كنت مستغنيا عنكم ولي جدة % تعينني ما ملكتم طائعا رسني % % PageV01P410 البحر : كامل تام 1(@)(@@) % يا خير من لبس النعال وخير من % وطئ التراب وخير من سكن الدنا % % 2(@)(@@) % يا من إذ حل المؤمل جوده % بفنائه يوما فقد بلغ المنا % % 3(@)(@@) % يا ابن الذي خضعت لعزة بأسه % مضطرة بيض الصوارم والقنا % % 4(@)(@@) % أيجوز أن أغشى حماك فأنثني % % صفرا يدي ويداك ملأى بالثنا % % 5(@)(@@) % أو هل يليق بمثل جوده أن يرى % % حرمان من أمسى بشكرك معلنا % 6(@)(@@) % وإذا كتسيت مدائحي وعريت عن % ألطاف برك فالجواد إذا أنا % % 7(@)(@@) % ما لي غرست مدائحي وسقيتها % % ماء الولاء وما حصلت على جنا % % PageV01P411 البحر : وافر تام 1(@)(@@) % تأوبني فأرقني خيال % سرى للمالكية بعد وهن % 2(@)(@@) % دنا بمزارها من بعد شحط % وجاد بوصلها من بعد ضن % 3(@)(@@) % بإنفاذ حقير القد % وقالوا إنه أس % 3(@)(@@) % طوى الأهوال يركبها شجاعا % على ما فيه من خور وجبن % 4(@)(@@) % وبات يعلني منها رضابا % % كشهد النحل شيب بماء مزن % 5(@)(@@) % وذكرني بأيام الشباب الألى وملاعب الحي الأغن % ام الشباب الأ % 6(@)(@@) % وماء ما ظمئت إليه حتى % % شرقت من البكاء بماء جفني % % 6(@)(@@) % متى يسمح بالتبر % فتى يبخل بالتبن % 7(@)(@@) % وبدر من سراة بني هلال % تراءى بين دعص نقى وغصن % 8(@)(@@) % يجليني مراشفه عذابا % مواردها ولو شاءت سقتني % % PageV01P412 9(@)(@@) % بلحظ مثل نصل السيف ماض % وقد كاعتدال الغصن لدن % 10(@)(@@) % سقا أطلالا ساقيتي دموعي % % مواطر كل جون مرجحن % 11(@)(@@) % وحيا الله دارا أنحلتها % % على النأي الخطوب وأنحلتني % % 12(@)(@@) % وقفت بها أسائل دمنتيها % % على عي الرسوم فأفهمتني % % 13(@)(@@) % إذا ستنجدت في الأطلال دمعا % تخاذلت الشؤون وأسلمتني % % 14(@)(@@) % نأيت فأي برق لم يشقني % % إليك وأي دار ما شجتني % % 15(@)(@@) % وما خلفتك بانتها ولكن % حكت ذاك التعطف والتثني % % 16(@)(@@) % ويوحشني بها الآرام 
ms109	 حتى % % إذا وصفت نفارك آنستني % % 17(@)(@@) % وليس البين أول ما رمتني % % به أيدي الخطوب فأقصدتني % % 18(@)(@@) % وأي هوى نجا منه فؤادي % % وسهم عار منه لم يصبني % % PageV01P413 19(@)(@@) % فليت حوادث الأيام أغضت % مسالمة بما أخذته مني % % 20(@)(@@) % فتقنع لي ببيعي ماء وجهي % % بمنزور العطية بيع غبن % 21(@)(@@) % وتسآلي بخيلا لا يلبي % % دعاي ورسم دار لم يجبني % % 22(@)(@@) % وليت الدهر إذ لم يمس سلمي % % على أحداثه لم يمس قرني % % 23(@)(@@) % أعاتب ما جنت أيام دهري % % وما يغني التعتب والتجني % % 24(@)(@@) % سئمت من الثواء بدار ذل % أجرر ذيل منقصة ووهن % 25(@)(@@) % أرى من لا تشتاق إليه عيني % % وأسمع ما تصم عليه أذني % % 26(@)(@@) % وأمسي مضمرا ودا صحيحا % لمطوي على حنق وضغن % 27(@)(@@) % فأسهل جانبا وألين عطفا % لأجباس من المعروف خشن % 28(@)(@@) % أنافس في وداد أخ مشوب % بغل أو سماح يد بمن % PageV01P414 29(@)(@@) % فما ضرعي وليس بي نقياد % لإحسان ولا شعف بحسن % 30(@)(@@) % وما للحظ يحجبني أريبا % وقد دخل الغبي بغير إذن % 31(@)(@@) % ويا أسفي على فضلات عيش % سروري لا يفي فيها بحزني % % 32(@)(@@) % إذا نال الفتى شبعا بذل % أجعني واقيا عرضي أجعني % % 33(@)(@@) % ومهما شئت من خوف وحيف % فجدي فيه ما لم تطرحني % % 34(@)(@@) % تنقل إن في النقل اعتلاءا % وعزا والهوان مع المبن % 35(@)(@@) % لئن ضاقت بي الزوراء دارا % فما ضاقت بلاد الله عني % % 36(@)(@@) % ولي في الأرض مضطرب وسيع % ومرتكض إذا هي لم تسعني % % 37(@)(@@) % سأرهف من مضاء العزم عضبا % إذا نبت الصوارم لم تخني % % 38(@)(@@) % وأرحل نافضا عن حر وجهي % % غبار الذل منتحيا بردني % % PageV01P415 39(@)(@@) % وأستغني غناء السيف يوم ال % وغا بالفضل عن غمد وجفن % 40(@)(@@) % فأما أن أصادف يوم حظ % يسر أقاربي أو يوم دفن % 41(@)(@@) % عساها أن تطاوع مصحبات % مصاعبها فتسهل بعد حزن % 42(@)(@@) % لى وملاعب الحي الأغن % نهوض المضرحي برأس رعن % 43(@)(@@) % فيعلق بالمنى أملي وشيكا % ولما تغلق الأيام رهني % % PageV01P416 البحر : كامل تام 1(@)(@@) % يا من يهز قوامه % سكر الشباب فينتشي % % 2(@)(@@) % أرحم فديتك من له % جسد بحبك 
ms110	 قد ضني % % 3(@)(@@) % أنظر إلي بعين را % % ض في المحبة محسن % 4(@)(@@) % ألقلب رهن في يديك وقد ملكت فأحسن % كت فأحسن % 5(@)(@@) % ما لي شريتك غاليا % وزهدت في فبعتني % % 6(@)(@@) % أطمعتني حتى إذا % % ألقلب رهن في يدي % 8(@)(@@) % يا من جعلت فداءه % ما هكذا عاهدتني % % PageV01P417 البحر : بسيط تام 1(@)(@@) % فدا عيون على الزوراء راقدة % طرف على بابل لا يعرف الوسنا % % 2(@)(@@) % يكاد يقضى وما حانت منيته % شوقا إذا ذكر الأحباب والوطنا % % PageV01P418 البحر : بسيط تام 1(@)(@@) % قم فاغتنم غفلة الزمان % ما دمت منه على أمان % 2(@)(@@) % ما دام عود الشباب غضا % ترغب في وصلك الغواني % % 3(@)(@@) % تفتض عذراء بنت كرم % أنحلها المكث في الدنان % 4(@)(@@) % تضحك في كأسها سرورا % إذا بكت أعين القناني % % 5(@)(@@) % ما رقصت في الكؤوس إلا % نقطها المزج بالجمان % 6(@)(@@) % حتى تراها منا عقالا % لليد والرجل واللسان % PageV01P419 البحر : وافر تام 1(@)(@@) % تفكر في زمان نحن فيه % تجده لما تقدمه مباين % 2(@)(@@) % أليس مثالب الماضين فيها % % صلاح أن تكون لنا محاسن % PageV01P420 البحر : رمل تام 1(@)(@@) % أولعت بالغدر في أيمانها % % ووفت بالوعد في هجرانها % % 2(@)(@@) % أنجزت ما وعدت من نأيها % % ليتها دامت على ليانها % % 3(@)(@@) % غادة في ثغرها مشمولة % حرم الري على ظمآنها % % 4(@)(@@) % حلأت عاشقها عن وردها % % وحمتها بظبا أجفانها % % 5(@)(@@) % لا تحدث قلبك العاني بها % % بسلو فهو من أعوانها % % 6(@)(@@) % حملت ريح الصبى من أرضها % % نفحة تسندها عن بانها % % 7(@)(@@) % فتعرفنا بريا عرفها % % أنها مرت على أردانها % % 8(@)(@@) % أنت أشجاني وأوطاري فيا % % شجو نفس أنت من أشجانها % % 9(@)(@@) % يئس العائد من إبرائها % % وسلا العاذل عن سلوانها % % 10(@)(@@) % أخلقت جدة أثواب الصبي % % فيك والصبوة في ريعانها % % PageV01P421 11(@)(@@) % وبأحناء ضلوعي زفرة % ضاق باع الصبر عن كتامنها % % 12(@)(@@) % آه لي من كبد مقروحة % طويت فيك على أحزانها % % 13(@)(@@) % ولأيام شباب بعتها % % مرخصا بالنزر من أثمانها % % 14(@)(@@) % وبجرعاء الحمى جارية % تملك الحسن على أقرانها % % 15(@)(@@) % سمتها يوم التنائي ضمة % فأحالتني على قضبانها % % 16(@)(@@) % خلها يا حادي العيس على % % رسلها تمرح في أرسانها 
ms111	 % % 17(@)(@@) % تحمل الأقمار في أفلاكها % % وغصون البان في كثبانها % % 18(@)(@@) % ظعنا أستودع % الله على ال % % 19(@)(@@) % وعلى وادي أشي سرحة % تجتنى اللوعة من أغصانها % % 20(@)(@@) % فاحبس الركب عليها سائلا % كنس الغزلان عن غزلانها % % PageV01P422 21(@)(@@) % فلكم أجريت أفراس الصبى % % وخيول اللهو في ميدانها % % 22(@)(@@) % وتقنصت الدمى في جوها % % 23(@)(@@) % لا تعب فرط حنيني ربما % % حنت النيب إلى أعطانها % % 24(@)(@@) % أنا محتاج إلى عطفكم % حاجة الدنيا إلى سلطانها % % 25(@)(@@) % هو ظل الله في الأرض على % % أهلها والروح في جثمانها % % 26(@)(@@) % بث في أقطارها معدلة % تؤمن الظبية من سرحانها % % 27(@)(@@) % حجة الله في الخلق فما % % ينكر الجاهل من برهانها % % 28(@)(@@) % جمعت أيامه ما أثرت % خلفاء الله في أزمانها % % 29(@)(@@) % نظر الدنيا بعيني مشفق % أن يراه الله من أخدانها % % 30(@)(@@) % فأهان الجود في راحته % ما أعز الناس من عقيانها % % PageV01P423 31(@)(@@) % جمع السودد في تبديدها % % وأطاع الله في عصيانها % % 32(@)(@@) % دعوة أعلنها الله فما % % ينقم الحساد من إعلانها % % 33(@)(@@) % ردها الله إلى تدبيره % فاستقرت منه في أوطانها % % 34(@)(@@) % نال ما يبتغيه منها وادعا % وسيوف الهند في أجفانها % % 35(@)(@@) % أسد أخلى الشرى من أسدها % % وحمى الردهة من ذؤبانها % % 36(@)(@@) % فملوك الأرض تنقاد له % طاعة تخضع في تيجانها % % 37(@)(@@) % وإذا مرت على أبوابه % صيدها خرت على أذقانها % % 38(@)(@@) % يا إمام العصر هنئت بها % % دولة غراء في إبانها % % 39(@)(@@) % شدت منها معليا ما شاده % جدك المنصور من بنيانها % % 40(@)(@@) % لك في المحل يد هطالة % يخجل الأنواء من تهتانها % % PageV01P424 41(@)(@@) % سال وادي جودها حتى لقد % غرق الإعسار في طوفانها % % 42(@)(@@) % طلت أفلاك الدراري علا % ف سم بالفخر على كيوانها % % 43(@)(@@) % فرسول الله من جرثومة % عودك الناضر من عيدانها % % 44(@)(@@) % يا بني العباس أنتم نبعها % % وقريش بعد من شريانها % % 45(@)(@@) % أنتم الذروة من غاربها % % أنتم المقلة من إنسانها % % 46(@)(@@) % أنتم السادات من أجوادها % % والكماة الحمس من فرسانها % % 47(@)(@@) % أنتم للناس أعلام هدى % يلتجي الساري إلى نيرانها % % 48(@)(@@) % أنتم في الحشر ذخر يوم لا % % ينفع النفس سوى إيمانها % % 49(@)(@@) % يوم لا 
ms112	 تحبط أعمال فتى % % حبكم في كفتي ميزانها % % 50(@)(@@) % وذنوب أوبقتني كثرة % بكم أطمع في غفرانها % % PageV01P425 51(@)(@@) % كعبة الله التي حرمها % % أنتم الجيرة من جيرانها % % 52(@)(@@) % ينفد الدهر وكم من أثر % لكم باق على أركانها % % 53(@)(@@) % لكم الفضل على ساداتها % % شيبها والغر من شبانها % % 54(@)(@@) % أنفذ المبعوث منكم هاديا % عربها الضلال من طغيانها % % 55(@)(@@) % ذادها عن موقف الشرك وقد % عكفت جهلا على أوثانها % % 56(@)(@@) % رحض الله بكم أدناسها % % حيث كان الكفر من أديانها % % 57(@)(@@) % أنتم زحزحتم الأذواء عن % ملكها والفرس عن أيوانها % % 58(@)(@@) % يا لها من أسل سالت بها % % أنفس البغي على خرصانها % % 59(@)(@@) % وسقت من عبد شمس سمرها % % ما أثار الوتر من أضغانها % % 60(@)(@@) % عصبة من هاشم تأييدها % % يوقع الأعداء في خذلانها % % PageV01P426 61(@)(@@) % رفع الله لها ألوية % كتب النصر على عقبانها % % 62(@)(@@) % تؤمن الأبطال في الروع بها % % والسريجيات في أيمانها % % 63(@)(@@) % فإذا ما ركبت في مأزق % أسدها الغلب على عقبانها % % 64(@)(@@) % تسلب الأغماد عن روضاتها % % وعياب السرد عن غدرانها % % 65(@)(@@) % وغدت توطئ أعناق العدى % % فضل ما تسحب من مرانها % % 66(@)(@@) % فالكماة الصيد في يوم الوغى % % كومها والوحش من ضفانها % % 67(@)(@@) % بالإمام المستضيء اكتسبت % شرفا يربي على عدنانها % % 68(@)(@@) % قرمها ماجدها سيدها % % طودها مطعامها مطعانها % % 69(@)(@@) % خير من داس الثرى من رجلها % % و متضى الغارب من ركبانها % % 70(@)(@@) % يا أمير المؤمنين اجتلها % % حرة بالغت في إحصانها % % PageV01P427 71(@)(@@) % غررا تبقى بقاء الدهر ما % % سار في مدحك من ديوانها % % 72(@)(@@) % عربا أنسابها تعرفها % % من قوافيها ومن أوزانها % % 73(@)(@@) % بدويات إذا حاضرتها % % فاح عرف الشيح من أردانها % % 74(@)(@@) % رعت الآداب حينا تجتني % % من خزاماها ومن سعدانها % % 75(@)(@@) % طلب الناس لها عيبا فما % % عابها شيء سوى حدثانها % % 76(@)(@@) % أخرست كل فصيح فغدا % % يفصح الحاسد باستحسانها % % 77(@)(@@) % نشأت في ظلك السابغ لا % % في ربى نجد ولا غيطانها % % 78(@)(@@) % مدحها الوحي إذا ما استملت الشعراء الشعر من شيطانها % % شعراء الشعر من شيطانها % % 79(@)(@@) % تخذته قالة الشعر فلو % أنصفته كان من قرآنها % % 80(@)(@@) % لم تزل محسنة في مدحها 
ms113	 % % ف جزها الحسنى على إحسانها % % PageV01P428 81(@)(@@) % و قتنع منها بما في وسعها % % لا تكلفها سوى إمكانها % % 82(@)(@@) % وابق مرهوب السطا ما انتسبت % أسد خفان إلى خفانها % % 83(@)(@@) % وسطت جائرة في حكمها % % سورة الخمر على ندمانها % % PageV01P429 البحر : وافر تام 1(@)(@@) % صحبنا في بطالته سعيدا % وأخلصنا المودة واجتهدنا % % 2(@)(@@) % وقلنا نرتجيك إذا ارتضاه الخليفة للعلى سكنا وخدنا % % خليفة للعلى سكنا وخدنا % % 3(@)(@@) % وكم أمل بخدمته عدقنا % % وعقد بالولاء له عقدنا % % 4(@)(@@) % وكان لنا دنو و قتراب % لديه فمنذ قدمه بعدنا % % 5(@)(@@) % تجهم ما عهدنا منه طلقا % وأصبح عابسا ما كان لدنا % % 6(@)(@@) % وصرنا إن أردناه لأمر % ووافيناه خالف ما أردنا % % 7(@)(@@) % فيمنعنا العطاء إذا سألنا % % وينقصنا إذا نحن ستزدنا % % 8(@)(@@) % رمينا من سعادته بنحس % فلو قضي النحوس له سعدنا % % 9(@)(@@) % فكيف لنا بصرف وانقطاع % فنصدر مدبرين كما وردنا % % 10(@)(@@) % ولا عاد الزمان لنا بعطف % متى صح الخلاف لنا فعدنا % % PageV01P430 البحر : منسرح 1(@)(@@) % وجه سعيد إذا تأمله % ناظر راقت له محاسنه % 2(@)(@@) % وماء حمامه معين فما % % تنفك مملوءة خزائنه % 3(@)(@@) % أجاد وقاده الوقود له % فهو جحيم رضوان خازنه % PageV01P431 البحر : رجز تام 1(@)(@@) % قل لكريم الدين يا % % نجم العلى وخدنها % % 2(@)(@@) % قصائد المدح التي % % تشهت بها كأنها % % 3(@)(@@) % من قبحها والجهل في % % عينيك قد حسنها % % 4(@)(@@) % وازنة لا يستخف % السامعون وزنها % % 5(@)(@@) % فما أرى أبرد من % فنك إلا فنها % % 6(@)(@@) % دونتها عجبا بها % % والله قد دونها % % 7(@)(@@) % عينك إن قرت بها % % فالله قد سخنها % % PageV01P432 البحر : خفيف تام 1(@)(@@) % قد دخلنا حمامكم فرأينا % % عجبا من تجمع الضدين % 2(@)(@@) % بارد الماء والوقود جميعا % فهو للمستحم سخنة عين % 3(@)(@@) % وبه قيم بغيض غليظ % عابس الوجه قالص المنخرين % 4(@)(@@) % قيم غير قيم خشنت مد % يته وهو ناعم الكفين % 5(@)(@@) % بيد كالحرير لا يرفع الأو % ساخ تدليكها عن المنكبين % 6(@)(@@) % ويد كرها يغادر في النا % % س كلوما شلت إذا من يدين % 7(@)(@@) % فخذوا لي منه القصاص فقد أو % بقني بالجراح في الأخدعين % PageV01P433 البحر : سريع 1(@)(@@) % أبو علي قد تجافاني 
ms114	 % % وكان من أكبر خلاني % % 2(@)(@@) % وكان مشغوفا بذكري فقد % أعرض عني وتناساني % % 3(@)(@@) % واعتل رسمي عنده بعد ما % % صح له سري وإعلاني % % 4(@)(@@) % وقد مضى عام وقد كر بال % مطل على أعقابه ثاني % % 5(@)(@@) % وليس لي منه سوى أنه % يبعث لي أقراص برشان % 6(@)(@@) % كأنني راهب قلاية % من بعض قلايات نجران % 7(@)(@@) % فانصت لك الخير إلى شاعر % يبيعك الشعر برغفان % 8(@)(@@) % و فطر وعيد مع توانيك في % % إنفاذ رسمي ألف نيسان % 9(@)(@@) % فليس في الحلواء لي مطمع % فيك وفي البرشان قولان % PageV01P434 البحر : كامل تام 1(@)(@@) % لا شك أنك بعد ما فارقتني % % ووعدتني بالتمر والسيلان % 2(@)(@@) % فكرت في إنجاز وعدك لي وقل % ت التمر أنفع لي من الإخوان % 3(@)(@@) % وأمنت أن تسري إليك قوارض % مني تصك مسامع الآذان % 4(@)(@@) % فأصخ لهن فما إخالك جامعا % بين السكوت علي والحرمان % PageV01P435 البحر : خفيف تام 1(@)(@@) % يا علاء الدين المرجى أعني % % وأجرني مما دهاني أجرني % % 2(@)(@@) % من عجوز شمطاء ذات نصاب % تتجنى عدمت ذاك التجني % % 3(@)(@@) % بالغ الواصفون فيها وقالوا % % طفلة السن ذات مال وحسن % 4(@)(@@) % فتزوجتها وقد باعد الله % بقربي منها السعادة عني % % 5(@)(@@) % طمعا أن تقر عيني وأن ين % عم بالي فخيب الله ظني % % 6(@)(@@) % غير أني عوضت أحسن منها % % إن تأملت وهي أفقر مني % % 7(@)(@@) % فتوصل إلى خلاصي منها % % وأحني فقد حصلت برهني % % PageV01P436 البحر : بسيط تام 1(@)(@@) % أحق دار وأولى أن نهنيها % % دار على السعد قد شيدت مبانيها % % 2(@)(@@) % لها الهناء وللدنيا بملككم % يا من بهم تفخر الدنيا ومن فيها % % 3(@)(@@) % وهل يهنا بدار حلها ملك % دانت له الأرض قاصيها ودانيها % % 4(@)(@@) % حللتموها فحل الجود ساحتها % % وجاش بحر العطايا في نواحيها % % 5(@)(@@) % فلا خلت منكم أوطانها أبدا % فإنها صور أنتم معانيها % % 6(@)(@@) % زادت بكم شرفا تبقى مآثره % على الزمان وتعظيما وتنويها % % 7(@)(@@) % فلا الزمان على فخر ينازعها % % ولا الكواكب في مجد تدانيها % % 8(@)(@@) % تختال تيها على الجوزاء شرفتها % % وغير بدع أن اختالت بكم تيها % % 9(@)(@@) % إذا تفاخرت الآثار % ف حتبت الأهرام % 10 
ms115	(@)(@@) % فهل يعدان ملكا مثل مالكها % % أو يفخران ببان مثل بانيها % % PageV01P437 11(@)(@@) % بالمستضيء أمير المؤمنين علت % أركانها وسمت مجدا مراقيها % % 12(@)(@@) % للفخر والإيوان تاليها % % بحسن سيرته فيها وراعيها % % 13(@)(@@) % خير البرية ماشيها وراكبها % % نعم وحاضرها طرا وباديها % % 14(@)(@@) % أضحت به كعبة للجود يسعد را % % جيها وينعش بالإحسان عافيها % % 15(@)(@@) % ما صافحت كف بؤس كف آملها % % ولا رأى وجه بأس من يرجيها % % 16(@)(@@) % وقد عرفت يقينا مذ عرست بها % % مدائحي فيكم أن سوف أجنيها % % 17(@)(@@) % وهل تخيب يد مدت اناملها % % إلى يد تملأ الدنيا أياديها % % 18(@)(@@) % ردوا بنفحة جود من عطائكم % حياة نفسي فقد ماتت أمانيها % % 19(@)(@@) % وابقوا يدوم لكم فيها السرور ولا % % تزال آهلة منكم مضغانيها % % 20(@)(@@) % تمسي بأبوابها الآمال محدقة % حتى يغص بوفد الحمد ناديها % % PageV01P438 21(@)(@@) % وعشتم في نعيم لا انقضاء له % وغبطة ما حدا الأظعان حاديها % % 22(@)(@@) % في دولة لا يذل الدهر ناصرها % % ولا تروع الليالي من يواليها % % 23(@)(@@) % فالنجح رائدها فيما تحاوله % والنصر عادتها فيمن يعاديها % % PageV01P439 البحر : رمل تام 1(@)(@@) % و جتماع س % مح الوص % 2(@)(@@) % يا جوادا ما رأى ق % دين في الأجواد قدوه % 3(@)(@@) % شقوتي ما تنقضي في % % ب له شوقا وصبوه % 7(@)(@@) % ملكت قلبي وقد كا % % ن من الحب بنجوه % 8(@)(@@) % يا مليح الدل زد جو % عشق في حبك أسوه % 11(@)(@@) % وأما والثغر يصيبني لمى فيه وحوه % % 13(@)(@@) % تمزج القهوة لي من % ريقك العذب بقهوه % 15(@)(@@) % قسما إن عماد ال % % ونفسا وأبوه % 16(@)(@@) % وسما من مجده البا % % دنا في الود إخوه % 17(@)(@@) % وشأى حاتم في الجو % % ف فر عن جسمي أذاه % PageV01P440 23(@)(@@) % لم يحل عهدك ما % % أوتيت من حال وثروه % 24(@)(@@) % يا أتم الناس جودا % وحياء وفتوه % 27(@)(@@) % وادع الهمة لا يق % شتوة من بعد شتوه % 28(@)(@@) % فهو يغزونا مساء % في نواحيها وغدوه % 30(@)(@@) % فروة تكسبني حو % لا على البرد وقوه % 32(@)(@@) % سيد لكنه يعت % رائعا في كل ندوه % 39(@)(@@) % قل أن أضرع أو أر % ل به منك وخلوه % 40(@)(@@) % ذا إباء آخذ الرز % فهو 
ms116	 لا تجذب عطفي % 41(@)(@@) % أتعاطاه بكد % ويدي تملك عفوه % 42(@)(@@) % غير أن العيش قد كد % رت الأيام صفوه % PageV01P441 44(@)(@@) % بعد ما قد كنت ذا % % أمر عليهن وسطوه % 49(@)(@@) % فاستمعها عذبة الأ % % لفاظ في مدحك حلوه % 50(@)(@@) % تسأل الله بأن ير % ففرا جلق عند ال % % PageV01P442 البحر : وافر تام 1(@)(@@) % أرقت للمع برق حاجري % تألق كاليماني المشرفي % 2(@)(@@) % أضاء لنا الأجارع مسبطرا % % إليه بكل شيطان غوي % 3(@)(@@) % كأن وميضه لمع الثنايا % % إذا ابتسمت وإشراق الحلي % 4(@)(@@) % فأذكرني وجوه الغيد بيضا % سوالفها ولم أك بالنسي % 6(@)(@@) % وليلى بعد ما مطلت ديوني % % ولا حالت عن العهد الوفي % 7(@)(@@) % منعمة شقيت بها ولولا الهوى ما كنت ذا بال شقي % ملتم على ذي ال % 8(@)(@@) % قرابة للبعيد الأجنبي % إذا نظرت بطرف بابلي % 9(@)(@@) % أتيه صبابة وتتيه حسنا % فويل للشجي من الخلي % 10(@)(@@) % إذا استشفيتها وجدي رمتني % % 11(@)(@@) % ولولا حبها لم يصب قلبي % % سنا برق تألق في حبي % PageV01P443 12(@)(@@) % أجاب وقد دعاني الشوق دمعي % % وقدما كنت ذا دمع عيي % 13(@)(@@) % وقفت على الديار فما أصاخت % معالمها لمحترق بكي % 14(@)(@@) % أروي تربها الصادي كأني % % نزحت الدمع فيها من ركي % 15(@)(@@) % ولو أكرمت دمعك يا شؤوني % % بكيت على الإمام الفاطمي % 16(@)(@@) % على المقتول ظمآنا فجودي % % على الظمآن بالجفن الروي % 18(@)(@@) % فما عطف البغاة على الفتاة ال % حمى الإسلام والبطل الكمي % 19(@)(@@) % على الباع الرحيب إذا ألمت % به الأزمات والكف السخي % 20(@)(@@) % على أندى الأنام يدا ووجها % وأرجحهم وقارا في الندي % 21(@)(@@) % وخير العالمين أبا وأما % وأطهرهم ثرى عرق زكي % 23(@)(@@) % فما دفعوه عن حسب كريم % ولا ذادوه عن خلق رضي % PageV01P444 24(@)(@@) % لقد قصموا عرى الإسلام عودا % وبدءا في الحسين وفي علي % 25(@)(@@) % ويوم الطف قام ليوم بدر % بأخذ الثأر من آل النبي % 26(@)(@@) % فثنوا بالإمام أما كفاهم % ضلالا ما جنوه على الوصي % 27(@)(@@) % وأسرى عن قلوب قاسيات % بأطراف الأسنة والقسي % 28(@)(@@) % يبيعون الدماء على نتهاك % المحارم جد مقدام جري % 29(@)(@@) % أطافوا محدقين به وعاجوا % % عليه بكل طرف أعوجي % 30 
ms117	(@)(@@) % بكل مثقف لدن وعضب % سريجي ودرع سابري % 31(@)(@@) % فأنحوا بالصوارم مسرعات % على البر النقي ابن النقي % 32(@)(@@) % وجوه النار مظلمة أكبت % على الوجه الهلالي الوضي % 33(@)(@@) % فيا لك من إمام ضرجوه % من القاني بخرصان القني % PageV01P445 34(@)(@@) % بكته الأرض إجلالا وحزنا % لمصرعه وأملاك السمي % 35(@)(@@) % وغودرت الخيام بغير حام % يناضل دونهن ولا ولي % 37(@)(@@) % ولا بذلوا لخائفة أمانا % ولا سمحوا لظمآن بري % 38(@)(@@) % ولا سفروا لثاما عن حياء % ولا كرم ولا أنف حمي % 39(@)(@@) % وساقوا ذود أهل الحق ظلما % وعدوانا إلى الورد الوبي % 41(@)(@@) % وساروا بالكرائم من قريش % سبايا فوق أكوار المطي % 42(@)(@@) % فيالله يوم نعوه ماذا % % وعا سمع الرسول من النعي % 43(@)(@@) % ولو رام الحياة نجا إليها % % بعزمته نجاء المضرحي % 45(@)(@@) % فيا عصب الضلالة كيف جزتم % عنادا عن صراطكم السوي % 46(@)(@@) % فألقيتم وعهدكم قريب % وراء ظهوركم عهد النبي % PageV01P446 47(@)(@@) % وأخفيتم نفاقكم إلى أن % وثبتم وثبة الذئب الضري % 48(@)(@@) % وأبديتم حقودكم وعدتم % إلى الدين القديم الجاهلي % 51(@)(@@) % وبيعكم لأخراكم سفاها % بمنزور من الدنيا بلي % 52(@)(@@) % وحسبكم غدا بأبيه خصما % إذا عرف السقيم من البري % 53(@)(@@) % صليتم حزبه بغيا وأنتم % لنار الله أولى بالصلي % 54(@)(@@) % وحرمتم عليه الماء لؤما % وإشفاقا إلى الخلق الدني % 56(@)(@@) % وفي صفين عاندتم أباه % وأعرضتم عن الحق الجلي % 57(@)(@@) % وخادعتم إمامكم خداعا % أتيتم فيه بالأمر الفري % 58(@)(@@) % إماما كان ينصف في القضايا % % ويأخذ للضعيف من القوي % 59(@)(@@) % فأنكرتم حديث الشمس ردت % له وطويتم خبر الطوي % PageV01P447 60(@)(@@) % فجوزيتم لبغضكم عليا % % عذاب الخلد في الدرك القصي % 61(@)(@@) % سأهدي للأئمة من سلامي % % وغر مدائحي أزكى هدي % 62(@)(@@) % سلاما أتبع الوسمي منه % على تلك المشاهد بالولي % 63(@)(@@) % وأكسو عاتق الأيام منه % حبائر كالرداء العبقري % 64(@)(@@) % حسانا لا أريد بهن إلا % مساءة كل باغ خارجي % 65(@)(@@) % يضيع لها إذا نشرت أريج % كنشر لطائم المسك الذكي % 66(@)(@@) % كأنفاس النسيم سرى بليل % يهز ذوائب الورد الجني % 67(@)(@@) % وزوراء العراق وأرض طوس % سقاها الغيث من بلد قصي % 69(@)(@@) % وأسبل صوب رحمته دراكا % عليها بالغدو وبالعشي % 70 
ms118	(@)(@@) % فذخري للمعاد ولاء قوم % بهم عرف السعيد من الشقي % PageV01P448 71(@)(@@) % كفاني علمهم أني معاد % عدوهم موال للولي % PageV01P449 البحر : رجز تام 1(@)(@@) % يا قالة الشعر أما % % فيكم فتى ذو محميه % 2(@)(@@) % يأنف أن يغشى مقا % % مات السؤال المخزيه % 3(@)(@@) % إلى متى جفونكم % على قذاها مغضيه % 4(@)(@@) % وكم تموتون بأد % واء الهمومش المدويه % 5(@)(@@) % دعوا المديح وابردوا % % وهي رحاب الأقنيه % 6(@)(@@) % فذم أولاد الزنا % % ء فيه بعض التسليه % 7(@)(@@) % وربما شفا الهجاء % من قلوب مشفيه % 8(@)(@@) % وما على قاتل أعراض % اللئام من ديه % 9(@)(@@) % وعصبة صحبتهم % للفضلاء مضنيه % 10(@)(@@) % ما أمروا بطاعة % ولا نهوا عن معصيه % PageV01P450 11(@)(@@) % تمشي قوافي الشعر في % % مدحهم مستعصيه % 12(@)(@@) % وتصحب الأوزان في % % هجائهم والأبنيه % 13(@)(@@) % لهم نفوس ملئت % فقرا وأيد مثريه % 14(@)(@@) % وأوجه كالحة % أحسن منها الأقفيه % 15(@)(@@) % ناشفة الألوان من % ماء الحياء مكديه % 16(@)(@@) % ومنطق إفحاشه % تخبث منه الأنديه % 18(@)(@@) % قد قنعوا من العلى % % بأن تشاد الأبنيه % 19(@)(@@) % منازل أليق منها % % بالهناء التعزيه % 20(@)(@@) % يضيق بوعا أهلها % % وهي رحاب الأفنيه % 21(@)(@@) % كم خبأت من ريبة % بيوتهم والأخبيه % PageV01P451 22(@)(@@) % وخسة تحت الثياب % منهم والأرديه % 23(@)(@@) % ما جئتهم بمدحة % في موسم وتهنيه % 24(@)(@@) % إلا ولي أمامها % % شفاعة موطيه % 25(@)(@@) % وشربة المطبوخ لا % % بد لها من تقويه % 26(@)(@@) % تريك من اخلاقهم % كل صباح مثخزيه % 27(@)(@@) % لاق اللئ % ام معديه % 28(@)(@@) % يا رب جنبنا طما % % لوك غير التسميه % 29(@)(@@) % وهب لنا قناعة % تكون عنهم مغنيه % PageV01P452 البحر : سريع 1(@)(@@) % أفحمني النظم البديع الذي % % فاقت على الدر معانيه % 2(@)(@@) % شعر كنوار أقاح ند % مالت من الطل حواشيه % 3(@)(@@) % كالماء ألفاظا ولكنه % أقوى من الصخر قوافيه % 4(@)(@@) % فبت ضنا وسرورا به % أظهره طورا وأخفيه % 5(@)(@@) % نوه باسمي فيه من لم يزل % تغمرني قدما أياديه % PageV01P453 البحر : سريع 1(@)(@@) % قل لأثير الدين خدن العلى % % أخي الندى نجل أسود الشرى % % 2(@)(@@) % أنت شهاد الفضل بل شمسه % وهضبة المجد وطود الحجى % % 3(@)(@@) % يا أسبق الناس إلى غاية % ويا كريم الفرع والمنتمى % % 4(@)(@@) % يا مهدي الدر النظيم الذي 
ms119	 % % أحسن منه مسمعي ما وعى % % 5(@)(@@) % شعر كروض خضل نبته % باتت أقاحيه تمج الندى % % 6(@)(@@) % فهو على قوة ألفاظه % أرق من مر نسيم الصبا % % 7(@)(@@) % زدت سرورا و بتهاجا به % غادرنني في كسر بيتي لفا % % 8(@)(@@) % مثلك لا يفدي وهل تفتدى % % حصباء أرض بنجوم السما % % 9(@)(@@) % أنت حرى أن يصبح الناس من % كل ملم لعلاك الفدى % % 11(@)(@@) % ف سمع تخطتك الرزايا ولا % مرت بناديك صروف الردى % % PageV01P454 12(@)(@@) % شوائب الدهر وأحداثه % غادرتني في كسر بيتي لفا % % 13(@)(@@) % كسرن حاجاتي وقصرن من % خطوي وما كنت قصير الخطا % % 14(@)(@@) % سيان صبي ومسائي فجنح ال % % ليل عندي مثل رأد الضحى % % 15(@)(@@) % فمهد العذر لمستأخر % مشت به أيامه القهقرى % % 16(@)(@@) % فأنت لي ذخر إذا نابني % % دهر فنعم الذخر والمنتمى % % PageV01P455 البحر : طويل 1(@)(@@) % حلفت بمسراها بحربة بزلا % سراعا تعد الحزن من مرح سهلا % % 2(@)(@@) % نواحل أمثال القسي نواجيا % كما فوق الرامي إلى غرض نصلا % % 3(@)(@@) % حوامل شعثا في الرحال سواهم % لغير قلا ما فارقوا الدار والأهلا % 4(@)(@@) % أذلت لهم في طاعة الله أنفس % كرائم لا يعرفن بؤسا ولا ذلا % % 5(@)(@@) % يؤمون في أعلام مكة موقفا % يحطون من وقر الذنوب بها ثقلا % % 6(@)(@@) % يسوقهم من نحو طيبة تربة % تساق لها الأملاك في الملإ الأعلى % % 7(@)(@@) % يمينا لقد أحيا بجود يمينه % لنا عضد الدين السماحة والبذلا % 8(@)(@@) % وما زالت الأيام تظلم أهلها % % فعلمها من حسن سيرته العدلا % 9(@)(@@) % فأم نداه الركب من كل وجهة % فيوضح من أنواره لهم السبلا % 10(@)(@@) % وفى لهم بالخصب قبل لقائه % فما وطئوا في وطأة بلدا محلا % PageV01P456 11(@)(@@) % إذا صافحت أرضا سنابك خيله % تمنى الأعادي أن يكون لهم كحلا % 12(@)(@@) % كفاك العدى نصر من الله عاجل % خفي وما أعملت رأيا ولا نصلا % % 13(@)(@@) % وقد كان حلوا أن يذيقهم الردى % % ولكن مفاجاة القضاء لهم أحلى % % 14(@)(@@) % ليهن نظام الدين سابغ نعمة % رآه أمير المؤمنين لها أهلا % % 15(@)(@@) % هدايا أتت من خير خلق ووصلة % أتيحت ولم تخطب لها بادئا وصلا % % 16(@)(@@) % وما كانت الشمس المنيرة ترتضي 
ms120	 % % سوى البدر في أفق السماء لها بعلا % 17(@)(@@) % تخيره لدن المعاطف واضح ال % أسرة معسول الشمائل مستحلى % % 18(@)(@@) % حباها به من أكرم الناس نبعة % وأعلاهم فرعا وأزكاهم أصلا % 19(@)(@@) % بهاليل من قوم يعد وليدهم % إذا استصرخوا يوما لحادثة كهلا % % 20(@)(@@) % لهم معجزات في الندى فكأنهم % إذا درست أعلامه بعثوا رسلا % % PageV01P457 21(@)(@@) % إذا ركبوا في جحفل بددوا العدى % % وإن جلسوا في محفل جمعوا الفضلا % 22(@)(@@) % فلا وجدت أيدي الحوادث والعدى % % لما عقدت نعماؤه بينهم حلا % 23(@)(@@) % ولا وطئت غير الخطوب لكم حمى % % ولا بددت غير الليالي لكم شملا % 24(@)(@@) % ولا زلت تعطى فيه قاصية المنى % % إلى أن يريك الله من نجله نجلا % % 25(@)(@@) % وحتى ترى فيه النجابة يافعا % على أنه في المهد قد ناله طفلا % % 26(@)(@@) % كأني به عما قليل وقد سما % % يمد إلى نيل العلى ساعدا عبلا % % 27(@)(@@) % وسار أمام الجيش ليث كتيبة % يرد على أعقابها الخيل والرجلا % % 28(@)(@@) % يسود كما ساد الأنام % ويعطي كما أعطى ويبلي كما أبلى % % 29(@)(@@) % وعش مبليا ثوب البقاء مجددا % ملابس عز لا ترث ولا تبلى % % 30(@)(@@) % تعرس في ناديكم من مدائحي % % عرائس في أثواب إحسانكم تجلى % % PageV01P458 البحر : متقارب تام 1(@)(@@) % أيا عضد الدين يا من غدا % % لأرزاقنا ضامنا كافلا % 2(@)(@@) % ومن هو أعلى الورى همة % ورأيا وأثبتهم كاهلا % % 3(@)(@@) % يري الليث في سرجه راكبا % ويذبل في دسته مائلا % % 4(@)(@@) % أعار المهند من رأيه المضارب والصعدة العاملا % % ضارب والصعدة العاملا % 5(@)(@@) % أيحسن أني أرى واقفا % بأبواب غيركم سائلا % % 6(@)(@@) % ومن بعد مرعى نداك الخصيب % أنتجع البلد الماحلا % % 7(@)(@@) % وأمسي وقد خسرت صفقتي % % وقد ذهبت خدمتي باطلا % % 8(@)(@@) % وإن سأل الناس عن قصتي % % فماذا أكون لهم قائلا % % 9(@)(@@) % إذا قيل كيف تركت الجواد % ووافيت تمتدح الباخلا % % 10(@)(@@) % ومولاك أكرم أهل الزمان % نفسا وأوسعهم نائلا % % PageV01P459 11(@)(@@) % فحاشا لإنصافك الكسروي % يصبح ميزانه مائلا % % 12(@)(@@) % فأظلم دون الورى والأنام % بدعوتك الملك العادلا % % 13(@)(@@) % نعشت رفيقي فغادرته % غنيا وغادرتني عائلا % % 14(@)(@@) % فلا هو إن سمته الإرتفاق % كان لما سمته فاعلا 