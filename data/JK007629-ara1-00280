ms261	 موقوف على شعرة % تزال عن عين الغريم العديم % 6(@)(@@) % فيظهر الأمر بأحكامه % ظهور منعوت بنعت القسيم % PageV01P1015 البحر : رمل تام 1(@)(@@) % عم بالغفران أصحاب الذنوب % بعد أخذ وابتداء للعموم % 2(@)(@@) % غير أن الأمر قد قسمه % بين سكني في جنان وجحيم % 3(@)(@@) % وكلا الصنفين في رحمته % % في التذاذ دائم فيه مقيم % 4(@)(@@) % زمهرير عند محرور جدي % % وحرور عند مقرور نعيم % % 5(@)(@@) % ليكون الكل في رحمته % % إنه قال هو البر الرحيم % PageV01P1016 البحر : وافر تام 1(@)(@@) % صفات الأولياء تزول عنهم صفات الأولياء تزول عنهم % % ويأخذها الشقي هناك منهم % 2(@)(@@) % كما ناب السعيد هنا زمانا % تنوب الأشقياء هناك عنهم % % 3(@)(@@) % فما لجأوا إلى الراحات إلا % % وكان الأمر فيهم من لدنهم % % 4(@)(@@) % وإن طلبوا المعونة من إمام % به كفؤ هنالك لم يعنهم % 5(@)(@@) % بني إذ رأيتهم سكارى % % فمل معم وبشرهم وصنهم % 6(@)(@@) % إذا عجز الرجال بأن يكونوا % % على تحقيقهم منهم فكنهم % % PageV01P1017 البحر : مجزوء البسيط 1(@)(@@) % سافر عني تستقم % فأمركم قد علم % 2(@)(@@) % أين عفو اسمه % % من اسمه المنتقم % % PageV01P1018 البحر : رمل تام 1(@)(@@) % ما لقومي عن وجودي قد عموا % % أترى أدركهم فيه صمم % 2(@)(@@) % إنني عرفت هودا بالذي % % أنا فيه من سرور وألم % 3(@)(@@) % فالذي يدري الذي أقصده % % كلما قلت ألا قال ألم % 4(@)(@@) % ما لهم لم يعرفوا أو يسمعوا % % أنني أمشي على النهج الأمم % 5(@)(@@) % وهم يمشون بي في أثري % % فهم حيث أنا من غير لم % % 6(@)(@@) % والذي أخبر عني بالذي % % قلته ليس من أرباب التهم % % 7(@)(@@) % هو هود والذي أخبركم % % أحمد المبعوث في خير الأمم % 8(@)(@@) % لا تقولوا إنه من عرب % إن هودا ليس من أهل العجم % % 9(@)(@@) % إنني ترجمت عنه بالذي % % قاله للناس عني وحكم % % 10(@)(@@) % فاشكروا الله الذي أظهركم % % عن ثبوت هو في عين العدم % % PageV01P1019 11(@)(@@) % فأنا الظاهر لا أنت بما % % أنت في نفسك من حمد وذم % 12(@)(@@) % لا تبالي إنكم في عدم % % وأنا الكل حدوثا وقدم % 13(@)(@@) % ما لكم في عين كوني أثر % لا ولا عين وحكم وقدم % % 14(@)(@@) % إن أسمائي بكم 
ms262	 قد حكمت % % في وجودي فلنا كيف وكم % PageV01P1020 البحر : سريع 1(@)(@@) % علمي بالرحمن لا يثبت % لوصفه بالغضب القاصم % 2(@)(@@) % في حق من أهله للشقا % % وسخطه الدائم واللازم % 3(@)(@@) % إذا أتى الأمر بإنفاذه % % فما له في الأمر من عاصم % % 4(@)(@@) % لو لم يكن يغضب قلنا له % بذا أتت ترجمة الحاكم % % 5(@)(@@) % من يتجلى حكمه في الورى % % بصورة المظلوم والظالم % % 6(@)(@@) % عنه فلا يأمن من مكره % غير ظلوم نفسه غاشم % % 7(@)(@@) % وعينه كونها فانظروا % % فإنه القاسم في القاسم % 8(@)(@@) % كيف لنا بالأمن من مكر من % صيرني في حلقة الخاتم % 9(@)(@@) % من يعرف الأمر بفرقانه % % من عرضه يوصف بالعالم % 10(@)(@@) % لو لم يكلف عبده شرعه % لم يتصف بالأحد الراحم % % PageV01P1021 11(@)(@@) % ما حير العالم إلا الذي % % قد ضرب العالم بالعالم % 12(@)(@@) % إذا درى الشخص بعلم الذي % % حيره لم يك بالقادم % % 13(@)(@@) % إلا إذا أبصر معلومه % % أزال عنه حيرة الهائم % 14(@)(@@) % ويحذر الأمر ويخشى الذي % % يقوده للوصف بالنادم % 15(@)(@@) % لو أنه يعرف أحواله % % لم يتصف للدين بالعازم % % 16(@)(@@) % وكان ذا رأي وذا فطنة % فعل اللبيب الحذر الحازم % % PageV01P1022 البحر : سريع 1(@)(@@) % ما والدي إلا الذي يحكم % % وليس أمي غير من تعلم % % 2(@)(@@) % أصدقها الأسماء من جوده % وهو الصداق الأشهر المعلم % 3(@)(@@) % كوننا من نفس أنزه % بجوده رحماننا الأكرم % % 4(@)(@@) % فمن هنا كان لنا حكمة % % بالصورة المثلى التي تعلم % % 5(@)(@@) % جاد بها جودا على كوننا % % الهنا المفضل المنعم % 6(@)(@@) % صيره خاتم أرساله % حمدا على الخير لمن يفهم % 7(@)(@@) % ولم يكن في الصبر تحميده % % متقيدا باسم لمن يعلم % 8(@)(@@) % تأسيا بالوالد المرتضى % % فهو الذي ناداك يا مسلم % 9(@)(@@) % لو أنه ناداك يا مجرم % % ما كنت من خذلانه تعصم % % 10(@)(@@) % به وقاك الشر فاشكر له % % فالشمس والأزمم والأنجم % % PageV01P1023 11(@)(@@) % فكشره عند إله السما % % شكر به ظهر العدى يقصم % 12(@)(@@) % لأنه عرفها قدرها % % إذ جابها عابدها المحرم % 13(@)(@@) % إن عرى غير الهدى تفصم % % وعروة الإسلام لا تفصم % 14(@)(@@) % لأنها مذ كونت عروة % % وغيرها يجمع إذ ينظم % 15(@)(@@) % فتقبل التحليل من ذاتها 
ms263	 % % ردا إلى الصل ولو يحكم % 16(@)(@@) % يعرف قدر النور ذو فطنة % % إذا أتاه ليله المظلم % % PageV01P1024 البحر : كامل تام 1(@)(@@) % شذ الذين تفردوا عنهم بمن % قد قال فيهم إنه هو عينهم % % 2(@)(@@) % أفناهم عنهم به في نعتهم % % فبدا لهم لما دعاهم كونهم % 3(@)(@@) % فتحققوا إن الأمور خلابة % لما تقطع إذ دعاهم بينهم % 4(@)(@@) % وأتاهم عند الصلاة بقولهم % إياك نعبد بالعبادة عونهم % 5(@)(@@) % فتنبهوا وتثبتوا وتحققوا % % إن المراد من العبادة بينهم % % 6(@)(@@) % وتشهدوا إذ شهدوا بشهادة % % قد بان منها في القيامة بونهم % % 7(@)(@@) % ومحقق المطلوب لما جاءهم % % في صدقهم عند التلاوة بينهم % 8(@)(@@) % إن الذين رأوه منه عناية % % يهم تحقق بالعناية صونهم % 9(@)(@@) % قد حكموه على نفوسهم عسى % % يقضي به يوم التقاضي دينهم % PageV01P1025 البحر : بسيط تام 1(@)(@@) % قلبي بذكرك مسرور ومحزون % لما تملكه لمح وتلوين % 2(@)(@@) % فلو رقت في سماء الكشف همته % لما تملكه وجد وتكوين % 3(@)(@@) % لكنه حاد عن قصد السبيل فلم % يظفر به فهو بين الخلق مسكين % % 4(@)(@@) % حتى دعته من الأشواق داعية % همت لها نحو قلبي سحبه الجون % 5(@)(@@) % وأبرقت في نواحي الجو بارقة % أضحى بها وهو مغبوط ومفتون % % 6(@)(@@) % والسحب سارية والريح ذارية % % والبرق مختطف والماء مسنون % 7(@)(@@) % وأخرجت كل ما تحويه من حبس % أرض الجسوم وفاح الهند والصين % % 8(@)(@@) % فما ترى فوق أرض الجسم مرقبة % % إلا وفيها من النوار تزيين % % 9(@)(@@) % وكلما لاح في الأجسام من بدع % وفي السرائر معلوم وموزون % 10(@)(@@) % والقلب يلتذ في تقليب مشهده % بكل وجه من التزيين ضنين % PageV01P1026 11(@)(@@) % والجسم فلك ببحر الجود يزعجه % ريح من الغرب بالأسرار مشحون % 12(@)(@@) % وراكب الفلك ما دامت تسيره % ريح الشريعة محفوظ وممنون % % 13(@)(@@) % ألقى الرئيس إلى التوحيد مقدمه % وفيه للملإ العلوي تأمين % 14(@)(@@) % فلو تراه وريح الشوق تزعجه % % يجري وما فيه تحريك وتسكين % 15(@)(@@) % إن العناصر في الإنسان مودعة % % نار ونور وطين فيه مسنون % 16(@)(@@) % فأودع الوصل ما بيني على كثب % وبين ربي مفروض ومسنون % 17(@)(@@) % فالسر بالله من خلقي ومن خلقي % % إذا تحققت موصول وممنون 
ms264	 % 18(@)(@@) % يقول إني قلب الحق فاعتبروا % % فإن قلب كتاب الله ياسين % 19(@)(@@) % من بعد ما قد أتى من قبل نفحته % % علي من دهره في نشأتي حين % % 20(@)(@@) % لا يعرف الملك المعصوم ما سببي % % ولا اللعين الذي ينكيه تنين % % PageV01P1027 21(@)(@@) % لما تسترت عن صلصال مملكتي % % أخفان عن علمه في عينه الطين % % 22(@)(@@) % فكان بحجبه عني وعن صفتي % % غيم العمى وأنا في الغيب مخزون % 23(@)(@@) % فعندما قمت فيه صار مفتخرا % يمشي الهوينا وفي أعطافه لين % 24(@)(@@) % لما سرى القلب للأعلى وجاز على % % عدن وغازلنه حور بها عين % 25(@)(@@) % غض الجفون ولم يثن العنان لها % % لما مضى عن هواه القرض والدين % 26(@)(@@) % فعندما قام فوق العرش بايعه % اللوح والقلم والعلام والنون % 27(@)(@@) % فلو تراه وقد أخفى حقيقته % % له فويق استواء الحق تمكين % 28(@)(@@) % فإن تجلى على كون بحكمته % % له علا ظهر ذاك الكون تعيين % 29(@)(@@) % فلا يزال لمرح الملقيات به % يقول للكائنات في الورى كونوا % % 30(@)(@@) % فكل قلب سها عن سر حكمته % % في كل كون فذاك القلب مغبون % PageV01P1028 31(@)(@@) % فاعلم بأنك لا تدري الإله إذا % % مالم يكن فيك يرموك وصفين % 32(@)(@@) % فاعرف إلهك من قبل الممات فإن % % تمت فأنت على التقليد مسجون % 33(@)(@@) % وإن تجليت في شرقي مشهده % % علما تنزه فيك العال والدون % 34(@)(@@) % ولاح في كل ما يخفى ويظهره % % من التكاليف تقبيح وتحسين % 35(@)(@@) % فافهم فديتك سر الله فيك ولا % % تظهره فهو عن الأغيار مكنون % 36(@)(@@) % وغر عليه وصنه ما حييت به % % فالسر ميت بقلب الحر مدفون % PageV01P1029 البحر : وافر تام 1(@)(@@) % وبالجبل الأمين يمين ربي % % قد أودعه به الروح الأمين % % 2(@)(@@) % إلى أن جاء إبراهيم يبني % % مكان البيت ناداه الأمين % % 3(@)(@@) % لدي وديعة حبست زمانا % مطهرة يقال لها اليمين % 4(@)(@@) % فخذها يا خليل الله تربح % فهذا الشوق والثمن الثمين % 5(@)(@@) % وكبر واستلم واسجد وقبل % % ليشرق عن سجدتك الجبين % 6(@)(@@) % وقل هذي اليمين يمين ربي % % وإني الواله الدنف الحزين % 7(@)(@@) % ينادي من طباق القرب عبدي % % أتاك الجد والعز المكين % % 8(@)(@@) % ولبتك المشاعر والمساعي 
ms265	 % % وقال بفضلك البلد الأمين % % 9(@)(@@) % ألا يا أيها الحجر المعلى % % تغير وجهك الغض المصون % 10(@)(@@) % سوادك من سويدا كل قلب % ويبسك من قساوتها يكون % % PageV01P1030 11(@)(@@) % يهون علي فيك سواد عيني % % إذا بخلت بأسودها العيون % PageV01P1031 البحر : مجزوء الوافر 1(@)(@@) % حروف أوائل السور % يبينها تباينها % % 2(@)(@@) % إن اخفاها تماثلها % % لتبديها مساكنها % % 3(@)(@@) % فمفردها مثناها % % إذا ما جاء ساكنها % % 4(@)(@@) % يثلثها لتربيع % إلهي مساكنها % % 5(@)(@@) % ويحفظها لخمستها ال % % ذي منها يعاينها % % 6(@)(@@) % فيا عجبا لقد أبدت % % مازلنا أماكنها % % 7(@)(@@) % وبالإيمان يحجبها % % عن إدراكي مصاونها % % 8(@)(@@) % لها شطر من الفلك ال % % ذي تبدي ضنائنها % % 9(@)(@@) % تولدها إذا نكحت % بلا مهر كنائنها % % 10(@)(@@) % فلو زدات على خمس % فمن عندي بنائنها % % PageV01P1032 11(@)(@@) % لقد أعيت خبير القو % % م إعجازا معانيها % % 12(@)(@@) % وأين بيان معربها % % وعجمتها تراطنها % % 13(@)(@@) % لقد بانت لأعيان % % تحققها مواطنها % % 14(@)(@@) % صفت فينا مشاربها % % وعز عليك آسنها % % 15(@)(@@) % وما منعت من الزلفى % % إلى ربي معاطنها % % 16(@)(@@) % تحل بنا ملائكة % % إذا فرت شياطنها % % 17(@)(@@) % حروف كلها علم % أتتك بها محاسنها % % 18(@)(@@) % ولا يدريه إلا من % يكون به يحاسنها % % 19(@)(@@) % وما أبدت سوى شطر % وما أخفت ضنائنها % % 20(@)(@@) % فما أخفاه مضمرها % % لقد أبداه كائنها % % PageV01P1033 البحر : وافر تام 1(@)(@@) % أرى في التين علم الحق حقا % وعلمي أنه الحق المبين % 2(@)(@@) % وعلم المصطفى الأمي منه % به قد جاء في النبإ اليقين % 3(@)(@@) % يقول به الكليم بطور سينا % % وذلك عندنا البلد الأمين % 4(@)(@@) % يجول به العليم بكل شيء % بظاهره وباطنه مسكون % % 5(@)(@@) % لقد أيدت بالتحقيق فيه % % وقد أعطت معالمه الشؤون % % 6(@)(@@) % وعلم الزيت عن نظر صحيح % وفي تين الهدى العلم المتين % PageV01P1034 البحر : كامل تام 1(@)(@@) % إن القبول للاقتدار معين % % فيعان في حكم النهى ويعين % 2(@)(@@) % فالأمر ما بيني وبين مقسمي % % فهو المعين وإنني المعين % % 3(@)(@@) % الحق حق فالوجود وجوده % % وأنا الأمين وما لدي أمين % % 4(@)(@@) % دفع اليتيم محرم في شرعنا % % والشرع جانبه إليه يلين % PageV01P1035 البحر : سريع 1(@)(@@) % الحق توحيد ولكنه % كثره في بصري عينه % 2(@)(@@) % وعلة التكثير أحكامها % % لأعيننا فكوننا 
ms266	 كونه % 3(@)(@@) % لا كون للأعيان في ذاتها % % وإنما الكون له بينه % % PageV01P1036 البحر : بسيط تام 1(@)(@@) % ما في الوجود الذي تدريه من أحد % إلا له في الذي يدريه ميزان % 2(@)(@@) % يقضي به والذي بالعقل حصله % شخص يقال له بالحد إنسان % % 3(@)(@@) % له الكمال كما في الكون صورته % ولي عليه من التشريع برهان % 4(@)(@@) % فالوزن لا بد فيه إن وزنت له % % ما كان من عمل نقص ورجحان % 5(@)(@@) % فاعكف عليه ولا تفرح بصورته % فقد تملكه جحد ونسيان % 6(@)(@@) % يبدو إذا قسم التكليف بينهما % % نهي وأمر وإنسان وشيطان % 7(@)(@@) % فمن كمال وجودي أن يكون لنا % % من كل نعت نصيب فيه تبيان % % 8(@)(@@) % على الذي حزته من الكمال فلا % % تقل بأن وجود الجحد نقصان % 9(@)(@@) % لم ينقص النقص من عين الوجود لما % % كان الوجود كمالا وهو خسران % % 10(@)(@@) % الأمر أعظم أن يحظى به أحد % إلا الذي هو علام وديان % PageV01P1037 11(@)(@@) % لما أراد كمال الحكم منه أتى % % في شرع جبريل إسلام وإيمان % % 12(@)(@@) % فعم ظاهره الأعلى وباطنه الأ % % دنى وتممه بالكاف إحسان % % 13(@)(@@) % فثلث الأمر والتربيع نشأته % لذا أتاك به من بعد محسان % % 14(@)(@@) % فقال إن لم يكن كون به نزه % فأثبت على النفي ما في الكون أعيان % 15(@)(@@) % هو الوجود فما في الكون من عدد % % والقول بالكثر في الأكوان بهتان % 16(@)(@@) % فانظر إلى حكمة عرا أتيت بها % % بيضاء مثلي فقال : الناس عميان % % 17(@)(@@) % يا ليت شعري فما في الكون من بصر % يراه ناظره المدعو إنسان % % 18(@)(@@) % إن تتق الله كان النور يعضدكم % % يتلوه فيكم هدي منه وفرقان % 19(@)(@@) % ما حكمة الله في الأشياء بادية % إلا لمن هو في التحقيق إنسان % % 20(@)(@@) % فليس كونك إنسانا بصورتك الد % % نيا إذا لم تكن بالحق تزدان % % PageV01P1038 البحر : بسيط تام 1(@)(@@) % لله قوم لهم في كل حادثة % شان وصورتهم من لا له شان % 2(@)(@@) % فإن نظرت إليهم في تصرفهم % تقول ما هم كما قالوا وما كانوا % % 3(@)(@@) % يعم علمهم أحوال كونهم % الماض وآلات بالتصريف والآن % 4(@)(@@) % سبحان من خصهم 
ms267	 منه بصورته % % هم المقيمون في الوقت الذي بانوا % % 5(@)(@@) % مسافرون ولم تفقد ذواتهم % من المجالس والأعيان أعيان % % 6(@)(@@) % أجسامهم هي أجساد ممثلة % للناظرين وهم في العين إنسان % % 7(@)(@@) % بهم نراهم كما قلنا ويشهد لي % % من روية الله عرفان ونكران % 8(@)(@@) % أنت اعترفت بمن أنكرت صورته % % الأمر سوق فأرباح وخسران % 9(@)(@@) % وهم ذوو بصر لما يرون وهم % % عند الأكابر منا فيه عميان % 10(@)(@@) % لا يهتدون لما تعطى نواظرهم % وما لهم في الذي يرون برهان % PageV01P1039 11(@)(@@) % وكل ما انكروا منه أو اعترفوا % % به فذلك عند القوم عرفان % % 12(@)(@@) % هم في الكتاب الذي اخفته غيرته % % منهم ومن غيرهم في الصدر عنوان % 13(@)(@@) % ما في الوجود سوى جود خزائنه % لها إذا نزلت بالخلق ميزان % 14(@)(@@) % لكنه عنده لا عندهم ولذا % % يخيب في نظر الإنصاف أوزان % % 15(@)(@@) % وما يخيب ولكن هكذا اعتبرت % % بما يفصله حق وبهتان % 16(@)(@@) % لذاك أوجدهم طبعا وكلفهم % % شرعا فوزنهم نقص ورجحان % % 17(@)(@@) % ووزن ربك عدل جل عن غرض % يقيم ميزانه بر ومحسان % 18(@)(@@) % مع العليم بما تحويه جنته % % دون اشتراك ومن تحويه نيران % 19(@)(@@) % بالاشتراك ومن يخلص لمقعده % في النار ليس له في الحشر ميزان % 20(@)(@@) % بذا أتى خبر الأرسال قاطبة % وقد أتى بالذي ذكرت قرآن % PageV01P1040 البحر : طويل 1(@)(@@) % عليك بحفظ النفس فالأمر بين % فإن وجود القشر للب صائن % 2(@)(@@) % يصون بحكم الحال لا علم عنده % % فما يدري ما تحوي عليه المصاون % 3(@)(@@) % وإن وجودي صائن من علمته % % وبيني وبين الحق فيه تباين % 4(@)(@@) % فيحفظني وقتا ووقتا أصونه % % ويدري الذي قد قلته منء يعاين % 5(@)(@@) % فما ثم إلا الكشف ما ثم غيره % وما بعد علم العين علم يوازن % 6(@)(@@) % إذا كان مخدومي الذي قد تركته % % بسطام خلفي قل لمن أنا سادن % 7(@)(@@) % إذا كان مطلوبي ومن هو غايتي % % وبدئي فما في العالمين تغابن % 8(@)(@@) % أرى فتية عمياء جاءت لنصرتي % % تقول لنا بالحال أنت المفاتن % % 9(@)(@@) % فحصلت منها كل خير وإنني % % أسايف أوقاتا ووقتا أطاعن % 10(@)(@@) % وما أنت فيها ذو نواء نويته 
ms268	 % % ولا أنا عنها بالجماعة ظاعن % PageV01P1041 11(@)(@@) % فمن شاء فليرحل ومن شاء فليقم % فما الأمر إلا كائن وهو بائن % PageV01P1042 البحر : مجزوء الرمل 1(@)(@@) % كل ما يحويه ميزان % % فيه نقصان ورجحان % 2(@)(@@) % ودليلي قوله ثقلت % ثم خفت وهو برهان % 3(@)(@@) % والذي من أجله وضعت % % فاعتدالات وأوزان % 4(@)(@@) % وإذا أعماله عرضت % بان أرباح وخسران % 5(@)(@@) % من يزن أعماله ها هنا % % ما له في الحشر ميزان % % 6(@)(@@) % يرجح الوزن الخفيف إذا % % حل بالميزان كيوان % PageV01P1043 البحر : رمل تام 1(@)(@@) % نحن حزب الله من يلحقنا % % حدنا جد وجد هزلنا % % 2(@)(@@) % أشهد الأسرار من أحبابه % % من يشاء ولها أشهدنا % % 3(@)(@@) % فمتى أدرككم فينا عمى % سائلوا عنا الذي يعرفنا % % 4(@)(@@) % ذاكم الله عظيم جده % % يمنح الأسرار من شاء بنا % % 5(@)(@@) % ما أماكنا رجالا هتفت % بهم الورق بدوحات منهى % % 6(@)(@@) % فرمينا جمرة الكون بها % % فرمينا بمريشات الفنا % % 7(@)(@@) % وازدلفنا زلفة الجمع فهل % % أسمع القوم مناجاة المنى % % 8(@)(@@) % يا عبادي هل رأيتم ما أرى % % يا عبادي هل بنا أنتم أنا % % 9(@)(@@) % خرس القوم وقالوا : ربنا % % أنت مولانا ونحن القرنا % % 10(@)(@@) % يا عباد الله سمعا إنني % % روح مولاكم أمين الأمنا % % PageV01P1044 11(@)(@@) % أنا ماحي الكون من أسراركم % أنا سر الكنز ما الكنز أنا % % 12(@)(@@) % أنا جبريل هذي حكمتي % % فاقرأوها تكشفوا ما كمنا % % 13(@)(@@) % جئت بالتوحيد كي أرشدكم % % فاقتنوا أنفسكم من أجلنا % % 14(@)(@@) % وخذوا عني فيكم عجبا % تجدوا السر لديه علنا % % 15(@)(@@) % ميزوا الأحوال في أنفسكم % لا تكونوا كدعي فتنا % % 16(@)(@@) % إن صحو العبد سكران بدا % % عالم الأمر له فافتتنا % % 17(@)(@@) % كما أن المحو دعوى إن بدت % في محياه علامات الونا % % 18(@)(@@) % قل إلى المثبت في أحواله % طبت بالحق فكنت المأمنا % % 19(@)(@@) % ليست الهيبة خوفا إنها % % أدب يعربه العذب الجنى % % 20(@)(@@) % حالها الإطراف من غير بكا % % ووجود الجهد من غير عنا % % PageV01P1045 21(@)(@@) % وحليف الأنس طلق وجهه % إن تدلى لحبيب ودنا % % 22(@)(@@) % يرشد الخلق ويبدي رسمه % % شاكرا واستمعوا إن أذنا % % 23(@)(@@) % صاحب القبض غريب مفرد % إن رأى بسطا عليه حزنا % % 24(@)(@@) % وخليل البسط يخفي 
ms269	 غيرة % ضر باديه ويبدي المننا % % 25(@)(@@) % لا تراه الدهر إلا ضاحكا % تبصر الحسن به قد قرنا % % 26(@)(@@) % صاحب الهمة في إسرائه % سائر قد ذب عنه الوسنا % % 27(@)(@@) % صاحب التوحيد أعمى أخرس % لا أنا قال ولا أيضا أنا % % 28(@)(@@) % يا عبيد النفس ما هذا العمى % % لم تزالوا تعبدون الوثنا % % 29(@)(@@) % سقتم الظاهر من أحوالكم % ما لنا منكم سوى ما بطنا % % 30(@)(@@) % فاقتنوا للعلم من أعمالكم % % علم فتح واشربوه لبنا % % PageV01P1046 31(@)(@@) % واخرجوا بالموت عن أنفسكم % % تبصروا الحق بكم مقترنا % % 32(@)(@@) % وانظروا ما لاح في غيركم % % تجدوه فيكم قد ضمنا % % PageV01P1047 البحر : خفيف تام 1(@)(@@) % إن قلبي إلى الذي آب عنه % % فهو فرد وما سواه مثنى % % 2(@)(@@) % كل قلب يراك يا من تعالى % % فحقيق عليه أن يتجنى % % 3(@)(@@) % فإذا ما ونا إليك تعزى % % وإذا ما دنوت منه تهنى % % PageV01P1048 البحر : طويل 1(@)(@@) % عجبت لإنسان يراحم رحمانا % فأوسع أهل الأرض روحا وريحانا % 2(@)(@@) % فقام له الإيمان بالغيب ناصحا % فأرسل دمع العين للغيب طوفانا % % 3(@)(@@) % فعارضه علم الحقائق مفصحا % بصورة من سواه أصبح رحمانا % % 4(@)(@@) % وأنزله في الأرض وجها خليفة % على الملأ الأعلى وسماه إنسانا % % 5(@)(@@) % فلم يك هذا منه دعوى أتى بها % % ولكنه بالحال كون محانا % % 6(@)(@@) % وشرفه بالشح إذ كان مانعا % فكان النقصان فضلا وإحسانا % % 7(@)(@@) % فلو لم يكن في الكون نقص محقق % لكان أخي النقص يخسر ميزانا % % 8(@)(@@) % ولم يك مخلوقا على الصورة التي % % أقام بها عند التنازع برهانا % % 9(@)(@@) % فمن كان بالنقصان أصل كماله % فلا بد أن يعطيك ربحا وخسرانا % % 10(@)(@@) % إذا كان بالنقصان عين كماله % % فأصبح كالميزان بالحمد ملآنا % % PageV01P1049 11(@)(@@) % فإن عموم الحمد ليس كبيرة % % من أذكاره في كل شيء وإن هانا % % 12(@)(@@) % فما هان في الأذكار إلا لعزة % يميل بها عنهم مكانا وإمكانا % % 13(@)(@@) % وآخر دعوانا أن الحمد فاستمع % وما ثم قول بعد آخر دعوانا % % 14(@)(@@) % إذا جاءت الأذكار للعدل تبتغي % % مفاضلة يأتين رجلا وركبانا % % 15(@)(@@) % فيظهر فضل الحمد إذ كن سوقة % وكان وجود الحمد فيهن سلطانا % % 16(@)(@@) % تأمل فإني أعلم 
ms270	 الخلق بالذي % % أتيت به علما صحيحا وإيمانا % % PageV01P1050 البحر : طويل 1(@)(@@) % وجودي عن الأمر الإلهي لم يكن % عن الذات والتكوين لي فأعقل الشانا % % 2(@)(@@) % وهذا الذي قد قلته لم يقل به % سوانا فحقق من يكون إذا كانا % % 3(@)(@@) % توحدت سرا وهو أمر يخصني % % وإني كثير بالتأمل إعلانا % % 4(@)(@@) % فمن يرني مني يرى العين واحدا % ومن يرني منه يرى العين أعيانا % % 5(@)(@@) % وذلك من صدع يكون بعينه % يقيم به وزني فيخسر ميزانا % % 6(@)(@@) % وإن لنا في كل حال ومشهد % دليلا على علمي بنفسي وبرهانا % % 7(@)(@@) % وعلمي بنفسي عين علمي بربها % % يحققه كشفا جليا وإيمانا % % 8(@)(@@) % ألست تراني في مجالس علمنا % % أفتق أسماعا أبصر عميانا % % 9(@)(@@) % وأهدي إلى النهج القويم بوحيه % % قليب عبيد لم يزل فيه حيرانا % % 10(@)(@@) % إذا نحن نادينا نفوسا به أتت % من الملإ العلوي رجلا وفرسانا % % PageV01P1051 11(@)(@@) % يلبي منادي الحق من كل جانب % فيكتبن أنصارا ويثبتن أعوانا % % 12(@)(@@) % لقد علل الصديق إخفاء صوته % بما كان يتلوه من الليل قرآنا % % 13(@)(@@) % وعلله الفاروق إذ كان معلنا % % ليطرد شيطانا ويوقظ وسنانا % % 14(@)(@@) % وكل رأي خيرا ولم يك خارجا % عن الحكم بالميزان نقصا ورجحانا % % 15(@)(@@) % فجاء إمام الخير بالحكم فيهما % % وقد صاغه الرحمن روحا وريحانا % % 16(@)(@@) % فقال له ارفع ثم للآخر اتضع % يظهر حكم العدل عينا وسلطانا % % 17(@)(@@) % فكم بين من فيه ومنه ومن أتى % % بهذا وذا إذ كان بالكل رحمانا % % 18(@)(@@) % ألم ترني أدعى على كل حالة % % أكون عليها بالتقلب إنسانا % % 19(@)(@@) % وسواه شخصا قابلا كل صورة % فعدل أجزاء ورتب أركانا % % 20(@)(@@) % وأظهره جسما سويا معدلا % بتربيع أخلاط وسماه جثمانا % % PageV01P1052 21(@)(@@) % وأودع فيه النفخ روحا مقدسا % ليعصم أرواحا ويقصم شيطانا % % PageV01P1053 البحر : بسيط تام 1(@)(@@) % النظم أولى به إن كنت تعرفه % والنثر أولى بنا إن كنت تعرفنا % % 2(@)(@@) % فالوجه أولى بنا إن كنت تشهده % % ونحن أولى به إن كنت تشهدنا % % 3(@)(@@) % فما يعز عليه فهو بي وله % % وما يعز علينا قد يخص بنا % % 4(@)(@@) % فما لنا منه إلا ما يكون لنا % % مجلى فننظره 
ms271	 وليس تنظرنا % % 5(@)(@@) % ما إن ذكرتك في سر وفي علن % إلا رأيت الذي ما زال يذكرنا % % 6(@)(@@) % ولست أفرح بالذكرى على سخط % % لكن على كثب إن كنت تعلمنا % % 7(@)(@@) % والله يذكر قوما لا خلاق لهم % بقوله : اخسأوا فيها ويشهدنا % % 8(@)(@@) % مقامهم وهم عن عينهم حجبوا % % به وعنهم بما هم فيه يحجبنا % % 9(@)(@@) % لو عاين القلب منهم ما أعاينه % % لعاينوه بلا شك يعايننا % % PageV01P1054 البحر : بسيط تام 1(@)(@@) % الجود أولى به والفقر أولى بنا % % فكن به لا تكن إلا له ولنا % % 2(@)(@@) % ما في الوجود سوى فقر وليس له % ضد يسمونه في الاصطلاح غنى % % 3(@)(@@) % أين الغنى وأنا بالذات أقبل ما % % يريد تكوينه والكون مني أنا % % 4(@)(@@) % فالكون مني ومنه فاعتبر عجبا % هذا الذي قلته قد كان قبل بنا % % 5(@)(@@) % أنا به كالذي ضربته مثلا % وإنه بوجود المعتقين بنا % % 6(@)(@@) % قد ارتبطنا لأمر لا انفكاك لنا % % منه وما منه من نشأتي عنا % % 7(@)(@@) % مثل النتيجة كان الكون عن عدم % ولم يكن عن وجود تحمل الأمنا % % 8(@)(@@) % عين النكاح بدا بالكشف يشهده % بصورتيه ولكن الإله كنى % % 9(@)(@@) % قد أشرقت أرضنا بنور بارئها % % كالنفس منه إذا سوى لها البدنا % % 10(@)(@@) % والنفس في الكون عن جسم وعن نفس % جاد الإله به لذاك عللنا % % PageV01P1055 11(@)(@@) % فلم أزل لوجود الجود أطلبه % فعلة الفقر فينا علة الزمنا % % 12(@)(@@) % لو لم يكن لم أكن لو لم أر لم ير % فالكون مني به والعلم منه بنا % % 13(@)(@@) % لولا النبي صحيح ما أتاك به % % نص جلي حكاه في القرآن لنا % % 14(@)(@@) % في سورة الأنبياء الزهر في زمر % أتى بحرف امتناع واضحا علنا % % 15(@)(@@) % هذا الدليل على إمكانه ولذا % % لو شاء كان اصطفاء منه عنه لنا % % 16(@)(@@) % ولو يكون لصلب كان عن جسد % في ناظر العين لم يدرك به غبنا % % 17(@)(@@) % لقد تجلى لقوم في منامهم % فعاينوه شهودا منظرا حسنا % % 18(@)(@@) % مثل المعاني التي التجميل جسدها % % كالعلم يشربه في نومه لبنا % % PageV01P1056 البحر : بسيط تام 1(@)(@@) % إن الزمان الذي سميته بفنا % % هو الزمان 
ms272	 الذي سميته بفنا % % 2(@)(@@) % هذا الزمان إذا فكرت فيه ترى % % في شانه عجبا لم يتخذ سكنا % % 3(@)(@@) % مع طول صحبته لكل طائفة % من الخلائق روحا كان أو بدنا % % 4(@)(@@) % يذمه كل شخص إذ يشاهده % % وإن مضى كان ما قد ذمه حسنا % % 5(@)(@@) % ما أنصف الدهر خلق من بريته % وهو الذي يورث الأفراح والحزنا % % 6(@)(@@) % فينظرون الذي قد أساءهم أبدا % وينظرون وجود الخير والمننا % % 7(@)(@@) % فيسترون الذي قد سر أكثره % % ويجهرون بما قد ساءهم علنا % % 8(@)(@@) % فداه خالقه بنفسه فلذا % % يقول إني أنا الدهر الذي امتحنا % % PageV01P1057 البحر : مديد تام 1(@)(@@) % إن لي معنى أعيش به % هو مني مثل نا وأنا % % 2(@)(@@) % فيقول الشرع أنت هنا % % ويقول الكشف لست هنا % % 3(@)(@@) % كل من تعدوه حكمته % فهو في تعمى بها وهنا % % 4(@)(@@) % وجميع الخلق ليس لهم % % من غذاء غيرهم فبنا % % 5(@)(@@) % فبنا كانت عوارضنا % % وبه كنا له سكنا % % 6(@)(@@) % ويقول العقل فيه كما % % قاله مدبر الزمنا % % 7(@)(@@) % وهو لا يدري زمانتهم % % فتراه يعبد البدنا % % 8(@)(@@) % والذي أحواله هكذا % % هو إلا عابد وثنا % % 9(@)(@@) % فإذا قامت شواهده % عنده مضى لها وثنا % % 10(@)(@@) % عطفه عنها وغادرها % % عدما واستلزم السننا % % PageV01P1058 11(@)(@@) % وأتى لكل خافية % فأتى بها لهم علنا % % 12(@)(@@) % وأزال الابتداع ولم % % ير إلا الفرض والسننا % % 13(@)(@@) % كل ما في العلم يشهده % ليس شيء عنده بطنا % % 14(@)(@@) % فمتى ما قال قائلهم % % حكمة الإخفاء عنه بنى % % 15(@)(@@) % قل له جهلت صورته % % فانظروا ما ضمن اللسنا % % 16(@)(@@) % من يقل نحن به وله % فليقل أيضا بنا ولنا % % PageV01P1059 البحر : وافر تام 1(@)(@@) % أرى المطلوب يكبر أن يصانا % % ويعظم أن يقاوم أو يدانى % % 2(@)(@@) % عجبت لقربه الأدنى بذات % % منزهة تعالت أن تهانا % % 3(@)(@@) % تجلت والضياء لها حجاب % وجلت أن نراها كما ترانا % % 4(@)(@@) % فلا يحظى بها إلا حريص % % وأما من تكاسل أو توانى % % 5(@)(@@) % فينساها وتنساه وهذا % % جزاء قد تلوناه قرانا % % 6(@)(@@) % فمن يقريه لم يطعم سواها % % وقد حاز المكانة والمكانا % % 7(@)(@@) % كما أن العليل إذا أتاها % % يخص به الزمانة والزمانا 
ms273	 % % 8(@)(@@) % ظلام كيف يحجبه ونور % ونحن نراه دونهما عيانا % % 9(@)(@@) % فما أرجو سواه لكل أمر % مهم ليس يعرفه سوانا % % PageV01P1060 البحر : طويل 1(@)(@@) % وإخوان صدق جمل الله ذكرهم % معلمهم كلب وهم يزجرونه % 2(@)(@@) % يعرفهم بالحال والفعل قدرهم % فيعرفهم عينا وهم يجهلونه % % 3(@)(@@) % يلازم باب القوم يحمي ذمارهم % ويحفظهم طبعا ولا يحفظونه % 4(@)(@@) % يقول لهم بالحال إني منكم % وعلمي بكم علم بما تعلمونه % % 5(@)(@@) % فلم يفهموا ما قاله وتواطئوا % % على مسكه حفظا بما ينظرونه % % PageV01P1061 البحر : مجزوء الرجز 1(@)(@@) % الحمد لله الذي % % أذهب عنا الحزنا % % 2(@)(@@) % ولم نزل نعبده % % ينوب عنا مثل ما % % 3(@)(@@) % فما أتى من خطأ % % نفوسنا مكننا % % 4(@)(@@) % إضافة الفكر لنا % % نا جوده والمننا % % 5(@)(@@) % كفقرنا وذلنا % % وما بدا إلا بنا % % 6(@)(@@) % وإنما حجره % % ما بين ذم وثنا % % 8(@)(@@) % ولا أقول مثل ما % % برهان صحا بيننا % % 9(@)(@@) % فقهقهر المعلون يع % % دو معلما بي معلنا % % 10(@)(@@) % هذا عبيد جئته % بفتنة ما افتتنتا % % 11(@)(@@) % % فما التوى ولا ونى % % PageV01P1062 12(@)(@@) % قلبته لعلني % % أضله فقل أنا % % 15(@)(@@) % % غا للذي قام بنا % % 18(@)(@@) % فقال لي عاصمه : % به المهيمن اعتنى % % 19(@)(@@) % % ذا حجة مبرهنا % % 20(@)(@@) % % من درة لما دنا % % 21(@)(@@) % وقال لي خسا يا لعي % % ان لا تراه أعينا % % PageV01P1063 البحر : مجزوء الرجز 1(@)(@@) % أقول لما أن بدا % % للعين ما أشهدنا % % 2(@)(@@) % الحمد لله الذي % % بجوده أوجدنا % % 3(@)(@@) % من عينه فكان لي % % من ذاك ربا محسنا % % 4(@)(@@) % أثنى عليه مفصحا % به مسرا معلنا % % PageV01P1064 البحر : خفيف تام 1(@)(@@) % إن لله بالحجاز يمينا % ومقاما مؤمنا وأمينا % % PageV01P1065 البحر : خفيف تام 1(@)(@@) % يريد قوله عليه الصلاة والسلام : ( الحجر يمين الله ) ويريد قوله تعالى : { مقام إبراهيم ومن دخله كان آمنا } ويريد قوله تعالى : { وهذا البلد الأمين } حين أقسم به . بايعوها فإن فيها نجاة % واجعلوه لكم مصلى ودينا % % PageV01P1066 البحر : خفيف تام 1(@)(@@) % ولتقوموا إذا وصلتم إليه % ونزلتم به عليه سنينا % % 2(@)(@@) % فجوار الإله خير جوار % تعلموه يوم الورود يقينا % % 3(@)(@@) % وادخلوه إذا أتيتم إليه % دون هدى بعمرة محرمينا % % 4(@)(@@) % فهو الشرع لا تحيدون 
ms274	 عنه % % وهو نص الرسول فيهم وفينا % % 5(@)(@@) % مع هذا فقلت عبد تقي % وسع الحق بالنصوص المتينا % % 6(@)(@@) % حين ضاقت عنه سماء وأرض % نص فيه الرسول حيا مبينا % % 7(@)(@@) % فثقلنا كما ثقلنا بقول % حين كنا بما أتى مؤمنينا % % 8(@)(@@) % لم نكن في الذي ذكرناه عنه % ونسبنا لذاته مفترينا % % 9(@)(@@) % فاحمدوا الله إنني لنبي % لم يكن مثله نبي يقينا % % 10(@)(@@) % من عذاب الحجاب في دار بعد % حصل الغير فيه حزنا وهونا % % PageV01P1067 11(@)(@@) % ما مقامي بأرض شرق وغرب % وشمال إلا خسارا مبينا % % 12(@)(@@) % فاعملوا نحوه مطي الأماني % % لتكونوا لحكمه مسلمينا % % 13(@)(@@) % إنما أنتم عبيد دعاة % لتكونوا بذلكم آمنينا % % 14(@)(@@) % واتقوا الله في الدعاء إليه % % فبتقوى إلهكم تعملونا % % 15(@)(@@) % كل فرق يكون ما بين هدى % وضلال به يكون مصونا % % 16(@)(@@) % من أذى باطل وعصمة حق % ولأشبال أسده فعرينا % % 17(@)(@@) % من يكن هكذا يغز بمقام % حازه من أتاه من طورسينا % % 18(@)(@@) % لم يكن قصده فكان امتنانا % وجزاء لسعيه ليبينا % % 19(@)(@@) % عندنا جوده فنعلم حقا % أنه لم يكن بذاك ضنينا % % 20(@)(@@) % ولهذا الفقير يطمع فيه % % وإليه شد الحريص الوضينا % % PageV01P1068 21(@)(@@) % يبتغي الجود والوجود جميعا % لتكونوا لديه حينا فحينا % % 22(@)(@@) % إنه ذو جدى ورب وفاء % بعيد أضحى لديه مكينا % % 23(@)(@@) % فإذا ما ابتغاه جاء إليه % % ومن أسمائه أراه كمينا % % 24(@)(@@) % فيه حتى تراه عينا بعين % شافيا علة وداء دفينا % % 25(@)(@@) % إنه الداء والدواء جميعا % لتقوموا بحقه أجمعينا % % 26(@)(@@) % واطلبوا العدل حيث كنتم لديه % % واسكنوا من أماكنيه عرينا % % 27(@)(@@) % مثل زيتونة تمد بدهن % % نور مصباحنا به لترينا % % 28(@)(@@) % ما أتانا به لضرب مثال % نعلم الحق منه حقا يقينا % % PageV01P1069 البحر : طويل 1(@)(@@) % إذا أنت لم تعرف إلهك فاعتكف % % عليه بما تدري ولا تتخذ خدنا % % 2(@)(@@) % فإني لكل الاعتقادات قابل % وإني منكم مثل ما أنتم منا % % 3(@)(@@) % مننت عليكم بالذي جئتكم به % % على ألسن الأرسال حبا لكم منا % % 4(@)(@@) % بعثت إليكم واحدا واصطفيته % % لنا ولكم منكم فبنتم وما بنا % % 5(@)(@@) % وحلتم عن العهد الذي كان بيننا % % بمشهد قبض الذر فيه 
ms275	 وما حلنا % % 6(@)(@@) % أجازيك لي بالصوم إذ كان لي بكم % % فيا ليت شعري هل تدين كما دنا % % 7(@)(@@) % وزلتم بلا أمر ولا عين مبصر % % عن العين بي دون الأنام وما زلنا % % 8(@)(@@) % وكنا على أمر به قد عرفتم % ونحن عليه ما نزال وما زلنا % % 9(@)(@@) % ونعلم أنا إذ تجولون في بنا % % بميدان أشهاد جحاجحة جلنا % % 10(@)(@@) % فإن قمت لي فيما أمرتك طائعا % بأمرك يا عبدي إذا قمت لي قمنا % % PageV01P1070 11(@)(@@) % وما أبتغي في ذاك أجرا ولا أرى % % وفي النفي عرفاني فنحن كما كنا % % 12(@)(@@) % فما تبتغي نفسي سراحا لذاتها % % فقد ألفت من ذاتها القيد والسجنا % % 13(@)(@@) % وهذا مجال فكها وسراحها % % ولم ندر هذا الأمر إلا إذا صمنا % % 14(@)(@@) % ولكن بإذن الشرع لا بعقولنا % % ولو قال عقلي ما أعرت له أذنا % % 15(@)(@@) % خلاف الذي قال الحكيم بفكره % من الحكم بالتسريح جهلا بما فهنا % % 16(@)(@@) % فنحن على ما قد علمتم كذاته % إذا فارقت معنى يقيدها معنى % % 17(@)(@@) % فإطلاقه إن أنت أنصفت قيده % % فلا تنتظر فيه خطابا ولا إذنا % % 18(@)(@@) % فلم نخل عن مجلى يكون له بنا % % ولم يخل سر يرتقي نحوه منا % % 19(@)(@@) % رقي معان لارقي مسافة % على صور شتى تكون بنا عنا % % 20(@)(@@) % إذا كان هذا الأمر بيني وبينه % % فقد نال أيضا مثل ما نحن قد نلنا % % PageV01P1071 21(@)(@@) % قد انبهم الأمر الذي كان واضحا % لعقلي بشرعي فالأمور كما قلنا % % 22(@)(@@) % فقال لي : المطلوب لست بغيركم % إذا فزتم فزنا وإن عدتم عدنا % % 23(@)(@@) % كما جاء في الشرع المطهر أنه % يمل إذا مل العبيد فما فزنا % % 24(@)(@@) % بشيء لنا نمتاز عنه به ولم % يحز دوننا أمرا لديه ولا حزنا % % 25(@)(@@) % لقد جزت فيما قلته حد نشأتي % % فيا ليت شعري هل يجوز كما جزنا % % 26(@)(@@) % وهذا غريب إن يقع فهو مطلبي % % عليه رجال الله إن ساءلوا حلنا % % 27(@)(@@) % وما أحد منا إذا جاز حده % % إلى ضده يلتذ فيه فإن امنا % % 28(@)(@@) % فذلك أقصى ما يكون من المدى % % وقائله دون الأنام قد استغنى % % 29(@)(@@) % ومنه 
ms276	 يقول الحق عني بالغنى % % وفي عبده في نجم قرآنه أغنى % % 30(@)(@@) % وبالكسب نال العبد هذا الذي أتى % % إلى قوله أغنى قنى ما به أقنى % % PageV01P1072 31(@)(@@) % تقرب ما نادى الذبيح إلهه % طواعية منكم ولا تقرب البدنا % % 32(@)(@@) % وجل بمفازات المعارف تائها % تزاد بلا زاد ولا تدخل المدنا % % 33(@)(@@) % فإن عوام الناس قد ينكرونه % % إذا جاءكم فليتخذ بعدهم جنا % % 34(@)(@@) % فإن اتخاذ الستر فرض معين % كذا جاءنا فيما به الله قد دنا % % 35(@)(@@) % ولو لم يكن هذا لكانت دماؤنا % % تباح فيا أهل الوجود قد أعلمنا % % 36(@)(@@) % نصحناكم عن إذن ربي وما بقى % % سوى أن تعوا ما قلته حين أفهمنا % % 37(@)(@@) % أتينا بها بيضاء مثلي نقية % % عن الغرض النفسي حقا وبينا % % 38(@)(@@) % وراثة علم من شرائع رسله % % لنرجع فيه للإله إذا أبنا % % 39(@)(@@) % فمن كان ذا علم وكشف محقق % إذا كان يدعو فليتب مثل ما تبنا % % 40(@)(@@) % عليه مدار الأمر في كل مرسل % فقلت لهم فابنوا على مثل ذا يبنى % % PageV01P1073 41(@)(@@) % لقد صدقت نفسي لكم في مقالها % % ووالله ، خاضت ونحن فما خضنا % % 42(@)(@@) % عليك بصدق القول في كل حالة % ولا تتأول واتخذه لكم حصنا % % 43(@)(@@) % ولا تعجز الحق الذي هو قادر % % وكن كالذي قال الإله لهم عنا % % 44(@)(@@) % فقد بان في شخص جليل مقامه % وأثر فيه بالذي كان أعلمنا % % 45(@)(@@) % حياؤ وتعظيما له وترفقا % وعاد علينا قوله فتضررنا % % 46(@)(@@) % عليه صلاة الله ما ذر شارق % وما ناح للشرب الحمام وما غنى % % PageV01P1074 البحر : طويل 1(@)(@@) % عفا رسم من أهوى وليس سوانا % % وكنا له عند النزول مكانا % % 2(@)(@@) % لقد ضاق عنه أرضه وسماؤه % وبالسعة المثلى لديه حبانا % % 3(@)(@@) % وما وسع الرحمن إلا وجودنا % % كأنا على العرش العظيم بنانا % % 4(@)(@@) % ولما وسعنا الحق جل جلاله % % نعمنا به علما به وعيانا % % 5(@)(@@) % ولم نتخذ غير المهيمن ساكنا % % ولم يتخذ بيتا يكون سوانا % % 6(@)(@@) % لقد جاد لي ربي بكل فضيلة % وآتان منه بسطة وبيانا % % 7(@)(@@) % إذا نحن جئناه على كل حالة % بضعف الذي جئنا إليه أتانا % % 8(@)(@@) % إذا 
ms277	 نحن أثنينا عليه بذاتنا % % وكان لنا منك الشهود أمانا % % 9(@)(@@) % على كل ما قلناه فيك وعصمة % فما ثم عين في الوجود ترانا % % PageV01P1075 البحر : طويل 1(@)(@@) % ويفضل عنها مثلها وزيادة إذا الأمر لم يمكن فكنه فإنه % % قصارى حديثي أن أكون كأنه % 2(@)(@@) % بذا جاء نص الشرع في غير موضع % فمن لم يصدقني فيعلم أنه % 3(@)(@@) % عن الحق مصروف إلى غير وجهه % وعن مشهد التحقيق ربي أكنه % % 4(@)(@@) % وأعلم ما المعنى الذي قام واستوى % % على عرشه العلوي حين اجنه % % 5(@)(@@) % وما هو إلا قربه ليس غيره % ولو كان ذا بعد لأسمع أذنه % % 6(@)(@@) % خطابا بليغا يخرق السمع صوته % ويودع فيه من تكلم أذنه % % 7(@)(@@) % وديعة حق لا وديعة حيلة % فيضحى لما قد فات يقرع منه % % 8(@)(@@) % كما صنع الرامي الذي جاز سهمه % % فريسته فاستلزم القلب حزنه % 9(@)(@@) % فوسع مكان الضيق منك تخلقا % % فمن وسع الرحمن سهل حزنه % % 10(@)(@@) % ولا شطر الأشياء إلا بعنيها % % فقد يقلب الفرار وقتا مجنه % % PageV01P1076 11(@)(@@) % إذا كنت ذا خبر لما أنت صانع % له فعلمنا أن ستدرك حسنه % % 12(@)(@@) % تأمل إذا ما قرب الشخص بيضة % هي الكل من شخص يقرب بدنه % 13(@)(@@) % ويفضل عنها مثلها وزيادة % % وهذا دليل إن تحققت عينه % % 14(@)(@@) % فخذ بالوجود الحق ما دمت ههنا % % ولا تبق شيئا إن تحققت عينه % 15(@)(@@) % فمن سن خيرا حاز من كل معتد % به خيره بالفعل إذ كان سنه % % PageV01P1077 البحر : رمل تام 1(@)(@@) % كم رأيناك ولم تشعر بنا % % إذ أنا أنت وما أنت أنا % % 2(@)(@@) % يعلم الله بأني عبد من % كلما قال أنا كان أنا % % 3(@)(@@) % تاه فيه الفكر من عزته % % ليرى ما لا يرى إلا بنا % % 4(@)(@@) % فإذا ما قلت هب لي نظرة % قال لا أفعل ما دمت هنا % % 5(@)(@@) % زل ترى ذاك الذي تطلبه % من وجودي بك مرأى حسنا % 6(@)(@@) % إن قلبي عين قلبي فانظروا % % تبصروا ما قلت صبحا بينا % % 7(@)(@@) % لست ممن شرب العلم به % % عسلا بل كان ورشا لبنا % % 8(@)(@@) % فإذا أسند لي ما يدعي % % من 
ms278	 نصوص الوحي فيه عنعنا % % 9(@)(@@) % حدث القلب عن الروح كما % % حدث القلب عن الله لنا % % 10(@)(@@) % إنني عينك فانظر ما ترى % % فأتى بالنص فيه ما كنى % % PageV01P1078 البحر : وافر تام 1(@)(@@) % إذا ما الشخص أظهر ما يراه % وما سبر الفهوم ولا الزمانا % % 2(@)(@@) % فإن اللوم يلحقه عليه % % ويسلب من إذاعته الأمانا % % 3(@)(@@) % فمن شرط الأمانة أن يراه % بخيلا في أمانته عيانا % % 4(@)(@@) % فإن لها إذا فكرت أهلا % وإن لها المكانة والزمانا % % 5(@)(@@) % لقد جاء الرسول به صريحا % وقد كنا تلوناه قرانا % % 6(@)(@@) % وإن الذوق من هذا وهذا % % إذا كنا بحضرته قرانا % % 7(@)(@@) % أراه مع الزمان بكل وقت % يدور بحكمة وكذا يرانا % % 8(@)(@@) % فنزه عن معارضة الليالي % % كلامك إن حكم الدهر بانا % % 9(@)(@@) % به رب البرية قد تسمى % % لذلك قد علا مجدا وشانا % % 10(@)(@@) % لقد جاد الإله علي إذ لم % % أكن من أهله كرما ودانا % % PageV01P1079 البحر : كامل تام 1(@)(@@) % لله در عصابة سارت بهم % % نجب الفناء لحضرة الرحمان % 2(@)(@@) % قطعوا زمانهم بذكر إلههم % % وتحققوا بسرائر القرآن % 3(@)(@@) % ورثوا النبي الهاشمي المصطفى % % من أشراف الأعراب من عدنان % 4(@)(@@) % ركبوا براق الحب في حرم المنى % % وسروا لقدس النور والبرهان % 5(@)(@@) % وقفوا على ظهر الصفا فأتاهم % لبن الهدى من منزل الفرقان % 6(@)(@@) % قرعوا سماء جسومهم فتفتحت % % أبوابها فبدت لهم عينان % % 7(@)(@@) % عين تبسم ثغرها لما رأت % أبناءها في جنة الرضوان % 8(@)(@@) % وشمالها عين تحدر دمعها % % لما رأتهم في لظى النيران % 9(@)(@@) % قرعوا سماء الروح لما آنسوا % % جسما ترابيا بلا أركان % 10(@)(@@) % فبدا لهم لاهوت عيسى المجتبى % % روحا بلا جسم ولا جثمان % PageV01P1080 11(@)(@@) % كمل الجمال بيوسف فتطلعوا % % لمقام إدريس العلي الشان % 12(@)(@@) % ورثوا الخلافة عندما نالوا منى % % موسى كليم الراحم الرحمان % 13(@)(@@) % سجد الملائكة الكرام إليهم % % دون اعتقاد وجود رب ثاني % % 14(@)(@@) % طمحت بهم هماتهم فتحللوا % % في حضرة الزلفى قرى الضيفان % 15(@)(@@) % كملت صفاتهم العلية وارتقوا % % عن سدرة الإيمان والإحسان % 16(@)(@@) % للذات كان مصيرهم فحباهم % بشهوده عينا بلا أكوان % 17(@)(@@) % وصلوا إليه وعاينوا ما أضمروا % % من 
ms279	 غيب سر السر كالإعلان % % 18(@)(@@) % سبحانه وتقدست أسماؤه % % وعن الزيادة جل والنقصان % % PageV01P1081 البحر : خفيف تام 1(@)(@@) % قمر شاهد الغيوب عيانا % بين جسم وبين روح دفين % 2(@)(@@) % وحباه الإله منه بعلم % % لم ينله بعد المطاع المكين % 3(@)(@@) % غيره فانعموا بما لاح فيكم % % من سناه البهيج عند السكون % % PageV01P1082 البحر : خفيف تام 1(@)(@@) % سر سر الوجود فرد بعيد % عن نظير له بدار أمان % 2(@)(@@) % هو علم في أول الحال عار % وكذا كان في الوجود الثاني % % 3(@)(@@) % فانظر ذا في الكيان سر علاه % % ثم تنقيصه بآي المثاني % % 4(@)(@@) % يطلب الرشد والرشاد سناه % % وهو أصل للكائنات الحسان % 5(@)(@@) % وإن هذا لهو العجاب ممهد % عقلك القاضي لانقلاب العيان % 6(@)(@@) % لو توالى أصل الوجود على ما % % كان في الأصل ما التقى زوجان % % 7(@)(@@) % ثم لما شاء الحكيم أمورا % أيدتها حقائق البرهان % 8(@)(@@) % أظهر الضد والنظير جميعا % بالعلى والثرى فلاح إثنان % % 9(@)(@@) % فأمد العلو للسفل سرا % وكذا السفل للعلو الداني % % 10(@)(@@) % حكمة شاءها الحكيم فأبدت % كل سر بواضحات البيان % PageV01P1083 11(@)(@@) % فاشكر الله يا أخي على ما % % أودعته حقيقة الإنسان % % PageV01P1084 البحر : مجزوء الرمل 1(@)(@@) % أنا ورقاء المثاني % % مسكني روض المعاني % % 2(@)(@@) % أنا عين في العيان % ليس لي غير المثاني % % 3(@)(@@) % فيناديني يا ثاني % % وأنا لست بثاني % % 4(@)(@@) % ينتهي إلى وجودي % % كل شيء في الكيان % % 5(@)(@@) % أنا أتلو من تسامت % ذاته عن العيان % 6(@)(@@) % لي حكم مستفاد % في الأقاصي والأداني % % 7(@)(@@) % ليس لي مثل سوى من % شانه يشبه شاني % % 8(@)(@@) % فانتقد إن كنت تبغي % % ما أتى به لساني % % 9(@)(@@) % من رقائق تدلت % بحقائق حسان % 10(@)(@@) % لقلوب قد تولت % عن زخارف الجنان % PageV01P1085 11(@)(@@) % طالبات من تعالى % % عن تصاريف الزمان % 12(@)(@@) % فهو الفرد المعلى % % ما له في الحكم ثاني % % 13(@)(@@) % وهو الذي اجتباني % % وهو الذي اصطفاني % % 14(@)(@@) % وأقامني عديلا % بين دن ودنان % 15(@)(@@) % فأقاصي كل قاص % وأداني كل داني % % 16(@)(@@) % وأ , الي كل وال % وأعاني كل عاني % % 17(@)(@@) % فإذا هويت سفلا % فبروج السريان % 18(@)(@@) % وإذا صعدت علوا % فلتحليل المباني % % 19(@)(@@) % فأنا أعطي 
ms280	 المعاني % % وأنا أخلي المغاني % % PageV01P1086 البحر : مجزوء الرمل 1(@)(@@) % فأنا السر المسوى % % خلقه بلا بنان % 2(@)(@@) % رتب الأمور فيه % خالقي لما بناني % % 3(@)(@@) % فأنا صخر ومني % % تتفجر المعاني % % 4(@)(@@) % وأنا مع العوالي % % مثل أفراس الرهان % 5(@)(@@) % وأنا الذي توارى % % جسمه عن العيان % 6(@)(@@) % والذي أجبت ربي % % طائعا لما دعاني % % 7(@)(@@) % فالذي يرى وجودي % % لتصاريف الزمان % 8(@)(@@) % كفؤاد أم موسى % % فارغا من المعاني % % 9(@)(@@) % فهو الخلي حقا % من حقائق البيان % % 10(@)(@@) % فأنا أصل المعاني % % وأنا أس الأغاني % % PageV01P1087 11(@)(@@) % وأنا سر إمام % % فاضل سامي المكان % 12(@)(@@) % علمه أكمل علم % شانه أعظم شان % 13(@)(@@) % هام بي لما رآني % % في مقاصير الجنان % 14(@)(@@) % لا أسميه فإني % % خائف حد السنان % 15(@)(@@) % والذي يفهم قولي % % هو صخر بن سنان % 16(@)(@@) % أكرم الموجود كفا % ثابت عند الطعان % 17(@)(@@) % فأنا والأم والجد % ة والجد المعاني % % 18(@)(@@) % في وجودنا من الجو % % د معا بلا زمان % 19(@)(@@) % مثل ما لاح لعين % في الهوى برق يماني % % PageV01P1088 البحر : مجزوء الوافر 1(@)(@@) % حروف المد واللين % أتت في حال تسكين % 2(@)(@@) % لتلويني وتمكني % % لتعريني وتكسوني % % 3(@)(@@) % ولي منها وجود ما % % عليه الله يحييني % % 4(@)(@@) % ويفنيني فيقصيني % % ويبقيني فيدنيني % % 5(@)(@@) % وإن ضللت يهديني % % وإن مرضت يشفيني % % 6(@)(@@) % وإن جوعت أطعمني % % وإن ظمئت يسقيني % % 7(@)(@@) % وإن أقبلت يأتيني % % وإن أعرضت يدعوني % % 8(@)(@@) % فأوافي عالم النور % وإني في عالم الطين % % 9(@)(@@) % وأي للكامل البادي % % بحال العال والدون % PageV01P1089 البحر : خفيف تام 1(@)(@@) % كل وقت أراك ليلة قدري % % والتي للأنام في رمضان % 2(@)(@@) % هي خير من ألف شهر وإني % % أنا خير منها بغير زمان % 3(@)(@@) % فضلها راجع إلي وفضلي % % راجع للذي عليه يراني % % 4(@)(@@) % فانظروا الخلق كله تجدوه % أرضه وأسماؤه الملوان % 5(@)(@@) % جسدا ميتا يزول ويفنى % % يوم أمشي عنه لدار الجنان % 6(@)(@@) % فحياة الوجود حيث حللنا % % منه والموت عند من لا يراني % % 7(@)(@@) % كل فخر في كل شخص معار % غير فخري بصورة الرحمن % % 8(@)(@@) % وبأشياء جمة تتعالى % % كعلوم دليلها في عيان % 9(@)(@@) % وتخلى لله دنيا وأخرى % % في عياني وتارة في 