ms961	 روى عنه جرير بن عبد الحميد(@)(@@)(@@)(@@) $ 7399 - حسين بن صالح شيخ من أهل المدينة يروي عن جناح مولى ليلى روى عنه ابنه صالح بن حسين(@)(@@)(@@)(@@) $ 7400 - حسين أبو عبد الله جليس كعب الأحبار يروي عن كعب الأحبار روى عنه عتبة بن أبي حكيم الشامي(@)(@@)(@@)(@@) $ 7401 - حسين بن المنذر أبو المنذر من أهل البصرة يروي عن يزيد الرقاشي روى عنه المعتمر بن سليمان(@)(@@)(@@)(@@) $ 7402 - حسين بن رباح يروي عن عكرمة روى عنه جرير بن حازم(@)(@@)(@@)(@@) $ 7403 - حسين بن سليمان الرقاشي مولى الطلحيين يروى عن PageV06P208 عبد الملك بن عمير عن أنس نسخة دلسها عبد الملك بن عمير روى عنه هشام بن يونس اللؤلؤي(@)(@@)(@@)(@@) $ 7404 - حسين بن سعد الجهني البطين من أهل البصرة يروى عن بن أبي مليكة وعطاء روى عنه موسى بن إسماعيل(@)(@@)(@@)(@@) $ 7405 - حسين بن عطاء بن يسار من أهل المدينة يروي عن زيد بن أسلم روى عنه عبد الحميد بن جعفر يخطىء ويدلس(@)(@@)(@@)(@@) $ 7406 - حسين بن واقد مولى عبد الله بن عامر بن كريز القرشي كنيته أبو على يروي عن عبد الله بن بريدة روى عنه ابنه علي بن الحسين بن واقد وأهل مرو مات سنة تسع وخمسين ومائة وقد قيل سنة سبع وخمسين ومائة وكان على قضاء مرو وكان إذا قام من مجلس الحكم اشترى لحما وعلقه في إصبعه وحمله إلى أهله وكان من خيار الناس وقعت فتنة أبي مسلم فلم يسأل عنها أحدا إلى أن انجلت وربما أخطأ في الروايات وقد كتب عن أيوب PageV06P209 السختياني وأيوب بن خوط جميعا فكل حديث منكر عنده عن أيوب عن نافع عن بن عمر إنما هو أيوب بن خوط وليس بأيوب السختياني(@)(@@)(@@)(@@) $ 7407 - حسين شيخ يروي عن أبي عياش عن جابر روت عنه كريمة بنت حسين ابنته(@)(@@)(@@)(@@) $ 7408 - حصين بن عبد الرحمن السلمي من أهل الكوفة كنيته أبو الهذيل يروي عن زيد بن وهب والشعبي وكان أكبر من الأعمش بسنة يقال سنه سن النخعي روى عنه الثوري وشعبة وأهل العراق مات سنة 
ms962	 ست وثلاثين ومائة وكان ينزل المبارك قرية على الدجلة دخلتها أسفل من نهر سابس وقد قيل إنه سمع من عمارة بن رويبة ولعمارة صحبة فإن صح ذلك فهو من التابعين وقيل إنه مات في ولاية أبي جعفر وكان له يوم مات ثلاث وسبعون سنة PageV06P210(@)(@@)(@@)(@@) $ 7409 - حصين بن عبد الرحمن الحارثي يروي عن الشعبي وسرية بنت زيد بن أرقم روى عنه حجاج بن أرطأة عداده في أهل الكوفة وليس هذا بالأول مات سنة تسع وثلاثين ومائة(@)(@@)(@@)(@@) $ 7410 - حصين بن عبد الرحمن النخعي أخو سلم بن عبد الرحمن يروي عن الشعبي وأهل الكوفة روى عنه حفص بن غياث وليس هذا بالأولين هؤلاء الثلاثة من أهل الكوفة وقد رووا ثلاثتهم عن الشعبي روى عنهم أهل الكوفة وربما يتوهم المتوهم أنهم واحد وليس كذلك أحدهم سلمى والآخر حارثي والثالث نخعي(@)(@@)(@@)(@@) $ 7411 - حصين بن عبد الله الحبراني ويقال الحميري يروي عن أبي سعد الخير عن أبي هريرة وكنية حصين أبو سعيد روى عنه ثور بن يزيد PageV06P211(@)(@@)(@@)(@@) $ 7412 - حصين الثعلبي يروي عن سعيد بن المسيب روى عنه هارون الثقفي(@)(@@)(@@)(@@) $ 7413 - حصين السلمي شيخ يروي عن كعب الأحبار روى عنه عمير بن هانئ(@)(@@)(@@)(@@) $ 7414 - حصين بن عبد الرحمن بن عمرو بن سعد بن معاذ الأنصاري الأوسي المدني يروي عن أهل المدينة روى عنه ابنه محمد بن حصين(@)(@@)(@@)(@@) $ 7415 - حصين بن مالك أبى الحر العنبري من أهل البصرة يروي عن عامر بن عبد قيس روى عنه الوليد أبو بشر(@)(@@)(@@)(@@) $ 7416 - حصين بن محصن يروي عن هرمى عن خزيمة روى عنه عبد الله بن علي بن السائب PageV06P212(@)(@@)(@@)(@@) $ 7417 - حصين بن عبد الله الشيباني يروي عن معاوية بن قرة روى عنه سعيد بن مسروق والد الثوري(@)(@@)(@@)(@@) $ 7418 - حصين بن حرملة المهري يروي عن أبي مصبح المقرأى من أهل الشام روى عنه عتبة بن أبي حكيم(@)(@@)(@@)(@@) $ 7419 - حصين بن نافع العنبري التميمي الوراق من أهل البصرة يروي عن أبي رجاء العطاردي والحسن روى عنه النضر بن شميل وأبو الوليد(@)(@@)(@@)(@@) $ 7420 - حصين 
ms963	 بن حبيب يروي عن حريث بن أبي حريث وعكرمة روى عنه عبد الصمد بن عبد الوارث(@)(@@)(@@)(@@) $ 7421 - حصين بن نمير يروي عن حصين بن عبد الرحمن وحميد الطويل روى عنه مسدد بن مسرهد(@)(@@)(@@)(@@) $ 7422 - حصين بن سعيد بن سيار بن سلامة الرياحي من أهل البصرة PageV06P213 يروي عن سيار بن سلامة(@)(@@)(@@)(@@) $ 7423 - حكيم بن حكيم بن عباد بن حنيف الأنصاري من أهل المدينة أخو عثمان بن حكيم يروي عن نافع بن جبير روى عنه سهيل بن أبي صالح وأهل المدينة وحنيف هو بن واهب بن العكيم(@)(@@)(@@)(@@) $ 7424 - حكيم بن سلمة يروي عن الجشمي عن بن عمر روى عنه أيوب بن حبيب(@)(@@)(@@)(@@) $ 7425 - حكيم بن أبي حكيم يروي عن الزهري وعمر بن عبد العزيز روى عنه عبيد الله بن عمرو بن أبي ذئب(@)(@@)(@@)(@@) $ 7426 - حكيم بن شريك بن نملة يروي عن أبيه روى عنه ابنه الصعب بن حكيم PageV06P214(@)(@@)(@@)(@@) $ 7427 - حكيم بن شريك الهذلي من أهل مصر يروي عن يحيى بن ميمون روى عنه عطاء بن دينار(@)(@@)(@@)(@@) $ 7428 - حكيم بن أبي راشد يروي عن أبي سلمة بن عبد الرحمن روى عنه الليث بن سعد(@)(@@)(@@)(@@) $ 7429 - حكيم بن عمار الحنفي يروى عن بن خالته وكان صديقا لأبى هريرة روى عنه عكرمة بن عمار(@)(@@)(@@)(@@) $ 7430 - حكيم بن أبي يزيد يروي عن أبيه عمن سمع النبي صلى الله عليه وسلم روى عنه عطاء بن السائب(@)(@@)(@@)(@@) $ 7431 - حكيم بن الديلمي من أهل الكوفة يروي عن أبي بردة روى عنه سفيان الثوري(@)(@@)(@@)(@@) $ 7432 - حكيم بن حكيم الأثرم يروي عن الحسن وأبي تميمة الهجيمي عداده في أهل البصرة روى عنه حماد بن سلمة وعوف الأعرابي PageV06P215(@)(@@)(@@)(@@) $ 7433 - حكيم شيخ يروي عن الحسن روى عنه سعيد بن عبد الرحمن أخو أبى حرة(@)(@@)(@@)(@@) $ 7434 - حماد بن سلمة بن دينار الخزاز كنيته أبو سلمة من أهل البصرة وكنية سلمة أبو صخرة مولى حمير بن كنانة من تميم ويقال مولى قريش وقد قيل إنه حميري يروي عن ثابت وقتادة روى عنه شعبة والثوري وأهل 
ms964	 البصرة مات في ذي الحجة لإحدى عشرة ليلة بقيت منه سنة سبع وستين ومائة وكان من العباد المجابين الدعوة وكان بن أخت حميد الطويل حميد خاله ولم ينصف من جانب حديثه واحتج بأبي بكر بن عياش في كتابه وبابن أخي الزهري وبعبد الرحمن بن عبد الله بن دينار فإن كان تركه إياه لما كان يخطىء فغيره من أقرانه مثل الثوري وشعبة ودونهما وكانوا يخطؤن فإن زعم أن خطأه قد كثر من تغير حفظه فقد كان ذلك في أبي بكر بن عياش موجودا وأنى يبلغ أبو بكر حماد بن سلمة ولم يكن من أقران حماد PageV06P216 مثله بالبصرة في الفضل والدين والعلم والنسك والجمع والكتبة والصلابة في السنة والقمع لأهل البدعة ولم يكن يثلبه في أيامه إلا قدري أو مبتدع جهمي لما كان يظهر من السنن الصحيحة التي ينكرها المعتزلة وأنى يبلغ أبو بكر بن عياش حماد بن سلمة في إتقانه أو في جمعه أم في علمه أم في ضبطه وإنا نشيع الكلام في هذا الفصل في كتاب الفصل بين النقلة عند ذكرنا إياه إن شاء الله تعالى سمعت أحمد بن محمد بن عمرو بن بسطام يقول سمعت بن مهزاذ يقول حدثنا علي بن جرير قال سألت عبد الله بن المبارك بالبصرة عن مسائل فقال ائت معلمي قلت ومن هو قال حماد بن سلمة(@)(@@)(@@)(@@) $ 7435 - حماد بن زيد بن درهم الأزرق كنيته أبو إسماعيل مولى آل جرير بن حازم الجهضمي من أهل البصرة يروي عن ثابت البناني روى عنه أهل البصرة كان مولده في ولاية سليمان بن عبد الملك PageV06P217 سنة ثمان وتسعين ومات يوم الجمعة في شهر رمضان لسبع عشرة مضت منه سنة سبع وسبعين ومائة وقد قيل سنة تسع وسبعين ودفن يوم الجمعة بعد العصر وصلى عليه إسحاق بن سليمان وكان ضريرا يحفظ حديثه كله وكان درهم جده من سبى سجستان وما كان حماد بن زيد يحدث إلا من حفظه وقد وهم من زعم أن بينهما كما بين الدينار والدرهم لأن 
ms965	 حماد بن زيد كان أحفظ وأتقن وأضبط من حماد بن سلمة كان اللهم إلا أن يكون القائل بهذا أراد فضل ما بينهما في الفضل والدين لأن حماد بن سلمة كان أدين وأفضل وأورع من حماد بن زيد ولسنا ممن يطلق الكلام على أحد بالجزاف بل نعطى كل شيخ قسطه وكل راو حظه PageV06P218 والله الموفق لذلك المان بما يجب من القول والفعل معا(@)(@@)(@@)(@@) $ 7436 - حماد بن يزيد بن مسلم أبو يزيد من أهل البصرة يروي عن معاوية بن قرة روى عنه موسى بن إسماعيل(@)(@@)(@@)(@@) $ 7437 - حماد بن أبي الدرداء من أهل الكوفة يروي عن الشعبي روى عنه وكيع بن الجراح(@)(@@)(@@)(@@) $ 7438 - حماد بن عبد الصمد الأعمى من أهل البصرة يروي عن الحسن روى عنه التبوذكي(@)(@@)(@@)(@@) $ 7439 - حماد بن الحجاج مولى عتيك أخو شعبة بن الحجاج من أهل البصرة يروي عن سلمة بن كهيل روى عنه عثمان بن جبلة بن أبي رواد(@)(@@)(@@)(@@) $ 7440 - حماد الأقصم الرياحي بصري يروي عن الحسن روى PageV06P219 عنه سلام بن مسكين(@)(@@)(@@)(@@) $ 7441 - حماد بن أبي الخوار والد حميد بن حماد يروي عن عبد الملك بن ميسرة روى عنه نصير بن أبي الأشعث(@)(@@)(@@)(@@) $ 7442 - حماد بن عباد السدوسي الفسطاط بصري يروي عن الحسن روى عنه الأسود بن عامر شاذان(@)(@@)(@@)(@@) $ 7443 - حماد الرائض يروي عن الحسن وابن سيرين روى عنه بشر بن الحكم(@)(@@)(@@)(@@) $ 7444 - حماد السمان يروي عن شيخ عن علي روى عنه حماد بن سلمة(@)(@@)(@@)(@@) $ 7445 - حماد بن نجيح الإسكاف كنيته أبو عبد الله يروي عن أبي عمران الجوني روى عنه وكيع بن الجراح PageV06P220(@)(@@)(@@)(@@) $ 7446 - حماد بن سعيد بن أبي عطية المذبوح من أهل الشام يروي عن أبي عطية روى عنه أبو بكر بن أبي مريم الغساني(@)(@@)(@@)(@@) $ 7447 - حماد بن عثمان يروي عن عبد العزيز الأعمى عن أنس بن مالك روى عنه سعيد بن أبي أيوب(@)(@@)(@@)(@@) $ 7448 - حماد بن جعفر يروي عن شهر بن حوشب روى عنه أبو عاصم النبيل(@)(@@)(@@)(@@) $ 7449 - حماد بن بشير يروي عن الحسن روى عنه 
ms966	 سعيد بن أبي أيوب(@)(@@)(@@)(@@) $ 7450 - حماد بن رستم المزني من أهل البصرة يروي عن الحسن روى عنه موسى بن إسماعيل(@)(@@)(@@)(@@) $ 7451 - حماد بن يحيى الأبح أبو بكر السلمي من أهل البصرة يروى PageV06P221 عن ثابت البناني وعبد العزيز بن صهيب روى عنه قتيبة بن سعيد يخطىء ويهم(@)(@@)(@@)(@@) $ 7452 - حماد أبو يحيى يروي عن الحسن وابن سيرين عداده في أهل البصرة روى عنه التبوذكي والربيع بن صبيح لا أدري من هو(@)(@@)(@@)(@@) $ 7453 - حماد بن أسامة أبو أسامة الكوفي مولى بني هاشم يروي عن إسماعيل بن أبي خالد وهشام بن عروة روى عنه أهل العراق وخراسان مات سنة إحدى ومائتين وهو بن ثمانين سنة وإنما قلت إنه مولى لبني هاشم لأنه كان مولى للحسن بن سعد وكان الحسن بن سعد مولى الحسن بن علي بن أبي طالب(@)(@@)(@@)(@@) $ 7454 - حماد شيخ كان ينزل سكة الموالي بالبصرة يروي عن معاوية بن قرة روى عنه موسى بن إسماعيل(@)(@@)(@@)(@@) $ 7455 - حماد بن مسعدة مولى بني باهلة من أهل البصرة كنيته أبو سعيد يروي عن حميد بن الطويل وعبيد الله بن عمر روى عنه أهل العراق مات سنة ثنتين ومائتين PageV06P222(@)(@@)(@@)(@@) $ 7456 - حسان بن عطية من أهل الشام من أفاضل أهل زمانه يروي عن سعيد بن المسيب وابن المنذر ونافع روى عنه الأوزاعي وعبد الرحمن بن ثابت بن ثوبان(@)(@@)(@@)(@@) $ 7457 - حسان بن مخارق الشيباني وقد قيل حسان بن أبي المخارق كنيته أبو العوام يروي عن سعيد بن جبير أنه كان يقرأ هل تستطيع ربك روى عنه جابر بن يزيد الجعفي(@)(@@)(@@)(@@) $ 7458 - حسان بن القاسم بن حسان يروي عن أبيه عن بن مسعود روى عنه منصور بن المعتمر(@)(@@)(@@)(@@) $ 7459 - حسان بن زاهر يروي عن عبد الله بن الصامت وحصين بن حدير روى عنه يحيى بن أبي كثير(@)(@@)(@@)(@@) $ 7460 - حسان بن أبي الأشرس من أهل الكوفة يروي عن سعيد بن جبير ومغيث بن سمي روى عنه الأعمش(@)(@@)(@@)(@@) $ 7461 - حسان بن أبي حسان الكندي يروي المراسيل روى عنه PageV06P223 مروان بن معاوية ويحيى 
ms967	 بن سعيد القطان(@)(@@)(@@)(@@) $ 7462 - حسان بن ميمون السعدي من أهل البصرة يروي عن الحسن روى عنه التبوذكي(@)(@@)(@@)(@@) $ 7463 - حسان بن محرش شيخ يروي المقاطيع روى قتيبة عن عبيد بن عمرو عنه(@)(@@)(@@)(@@) $ 7464 - حسان بن إبراهيم الكرماني أبو هشام يروي عن سعيد بن مسروق وإسماعيل بن أبي خالد روى عنه الأزرق بن علي ومحمد بن أبي يعقوب الكرماني ربما أخطأ(@)(@@)(@@)(@@) $ 7465 - حسان بن جعدة يروي عن الحسن روى عنه بن عيينة(@)(@@)(@@)(@@) $ 7466 - حسان بن مالك يروي عن رجاء بن حيوة روى عنه أهل الشام(@)(@@)(@@)(@@) $ 7467 - حسان بن منصور الكلبي يروى عن بن عبد الله PageV06P224 بن عمر عن أبيه روى سعيد بن أبي أيوب عن حفص بن صالح عنه(@)(@@)(@@)(@@) $ 7468 - حسان بن أبي سنان العابد من أهل البصرة كنيته أبو عبد الله يروي عن أهل البصرة الحكايات والرقايق ولست أحفظ له حديثا مسندا روى عنه أهل البصرة(@)(@@)(@@)(@@) $ 7469 - حنظلة بن أبي سفيان الجمحي القرشي من أهل مكة واسم أبي سفيان الأسود يروي عن سالم والقاسم ونافع ومجاهد وطاوس روى عنه الثوري ووكيع والناس مات سنة إحدى وخمسين ومائة وهو الذي يروى عنه بن فضيل ويقول حنظلة بن الأسود وهو حنظلة بن أبي سفيان بن عبد الرحمن بن صفوان بن أمية بن خلف وأمه بنت عمرو بن أبي عقرب مات حنظلة سنة اثنين وخمسين ومائة (@)(@@)(@@)(@@) $ 7470 - حنظلة بن سبرة بن المسبب بن بحبة الفزاري يروي عن عمته PageV06P225 بنت المسيب وكانت تحت حذيفة بن اليمان روى عنه عمر بن ذر وشعيب بن خالد(@)(@@)(@@)(@@) $ 7471 - حنظلة بن سلمة يروي عن عمه منقذ بن حيان روى عنه موسى بن إسماعيل(@)(@@)(@@)(@@) $ 7472 - حنظلة بن عمرو الزرقي الأنصاري من أهل المدينة يروي عن أبي الحويرث روى عنه محمد بن مهران(@)(@@)(@@)(@@) $ 7473 - حنظلة شيخ يروي المراسيل لا أدري من هو روى بن المبارك عن إبراهيم بن حنظلة عن أبيه(@)(@@)(@@)(@@) $ 7474 - حمزة بن عبد الله القرشي يروي عن أبيه عن بن عباس روى عنه الحسن بن عمرو(@)(@@)(@@)(@@) $ 7475 - حمزة بن 
ms968	 سفينة يروي عن السائب بن يزيد عن عائشة روى PageV06P226 يحيى بن أبي كثير عن أبي سعيد مولى المهري عنه(@)(@@)(@@)(@@) $ 7476 - حمزة بن عبد الله الثقفي يروي عن القاسم بن حبيب روى عنه عبد الملك بن أبي زهير(@)(@@)(@@)(@@) $ 7477 - حمزة العبدي من أهل الكوفة يروي عن إبراهيم النخعي ومرة الهمداني روى عنه المسعودي(@)(@@)(@@)(@@) $ 7478 - حمزة بن عبد الله الدارمي يروي عن شهر بن حوشب روى عنه يعقوب بن إسحاق الحضرمي(@)(@@)(@@)(@@) $ 7479 - حمزة بن حمزة أبو عمارة الأعور يروي عن الشعبي روى عنه الأعمش وشعبة(@)(@@)(@@)(@@) $ 7480 - حمزة بن أبي جعفر يروي عن إبراهيم بن عبد الرحمن القاري روى عنه بن أبي ذئب PageV06P227(@)(@@)(@@)(@@) $ 7481 - حمزة بن عبد الحميد بن محمود المعولي بصري يروي عن أبيه عن أنس روى عنه موسى بن إسماعيل(@)(@@)(@@)(@@) $ 7482 - حمزة بن عبد الواحد مولى الزبير بن العوام يروى عن بن سيرين روى عنه عبد الله بن وهب المصري(@)(@@)(@@)(@@) $ 7483 - حمزة بن نجيح أبو عمارة من أهل البصرة يروي عن الحسن وكان قدريا روى عنه التبوذكي(@)(@@)(@@)(@@) $ 7484 - حمزة بن حبيب بن عمارة الزيات مولى تيم الله من أهل الكوفة كنيته أبو عمارة يروي عن حمران بن أعين عن أبي الطفيل روى عنه وكيع وأهل الكوفة وكان من علماء أهل زمانه بالقراءات وكان من خيار عباد الله عبادة وفضلا وورعا ونسكا مات سنة ست وخمسين ومائة بحلوان وكان يجلب الزيت من الكوفة إلى حلوان ويجلب من حلوان الجبن والجوز إلى الكوفة PageV06P228(@)(@@)(@@)(@@) $ 7485 - حمزة بن المغيرة العابد من أهل الكوفة يروي عن عاصم الأحول عن أبي العالية اهدنا الصراط المستقيم قال هو النبي صلى الله عليه وسلم وصاحباه روى عنه أبو النضر هاشم بن القاسم(@)(@@)(@@)(@@) $ 7486 - حمزة بن مسروق الثوري أخو سعيد بن مسروق يروي عن الضحاك بن مزاحم كنيته أبو المغيرة وهو عم سفيان الثوري روى عنه عمار بن أخت سفيان وهو عمار بن محمد(@)(@@)(@@)(@@) $ 7487 - حيان بن سلمان الجعفي من أهل الكوفة بياع الأنماط يروي عن سويد بن غفلة روى 
ms969	 عنه منصور بن المعتمر وسفيان الثوري(@)(@@)(@@)(@@) $ 7488 - حيان بن سريج كان عمر بن عبد العزيز يكاتبه ليس له PageV06P229 رواية يعتمد عليها(@)(@@)(@@)(@@) $ 7489 - حيان الأعرج يروي عن جابر بن زيد روى عنه منصور بن زاذان(@)(@@)(@@)(@@) $ 7490 - حيان بن مخارق أبو العلاء يروي عن قطن بن قبيصة بن المخارق عن أبيه روى عنه عوف الأعرابي(@)(@@)(@@)(@@) $ 7491 - حيان بن عبيد الله أبو زهير مولى بني عدي يروي عن أبي مجلز وأبيه روى عنه مسلم بن إبراهيم وموسى بن إسماعيل(@)(@@)(@@)(@@) $ 7492 - حرب بن خالد بن جابر بن سمرة السوائي من أهل الكوفة يروي عن أبيه عن جده جابر بن سمرة روى عنه زيد بن الحباب(@)(@@)(@@)(@@) $ 7493 - حرب بن قيس مولى يحيى بن طلحة من أهل المدينة يروي عن نافع روى عنه عمارة بن غزية(@)(@@)(@@)(@@) $ 7494 - حرب بن شداد العطار اليشكري من أهل البصرة كنيته PageV06P230 أبو الخطاب يروي عن الحسن وشهر بن حوشب روى عنه أبو داود الطيالسي وعبد الصمد بن عبد الوارث مات سنة إحدى وخمسين ومائة(@)(@@)(@@)(@@) $ 7495 - حرب بن أبي حرب يروي عن شريح روى عنه حصين أبو حبيب(@)(@@)(@@)(@@) $ 7496 - حرب بن أبي حرب أبو ثابت يروي عن إسحاق بن عبد الله بن أبي طلحة روى عنه عبد الصمد(@)(@@)(@@)(@@) $ 7497 - حرب بن قطن بن قبيصة بن المخارق يروي عن أبيه عن جده قبيصة أن النبي صلى الله عليه وسلم مر به وهو كاشف فخذه فقال يا قبيصة وار فخذك فإنها من عورتك روى عنه سوار أبو حمزة المزني(@)(@@)(@@)(@@) $ 7498 - حرب بن زهير المنقري أبو زهير يروي عن عبد الله بن PageV06P231 بريدة روى عنه عطاء بن السائب(@)(@@)(@@)(@@) $ 7499 - حرب بن عبد الملك بن مجاشع يروي عن أبيه أن أهل البصرة ضمروا خيولهم فنهاهم عتبة بن غزوان أن يجروها حتى كتب إلى عمر فكتب أن لا يركبها إلا أربابها روى عنه ابنه عبد الملك بن حرب رواه موسى بن إسماعيل عنه(@)(@@)(@@)(@@) $ 7500 - حرب بن ميسرة الخراساني يروي عن الحسن وابن سيرين أخرجه أبو مسلم من 
ms970	 خراسان فأتى قرية بالشام وليس بها إلا نصارى فسكنها فأسلموا على يديه روى عنه محمد بن يعلى زنبور وقال رأيته بتلك القرية(@)(@@)(@@)(@@) $ 7501 - حرب بن ثابت المنقري أبو ثابت من أهل البصرة يروي عن الحسن ومروان الأصفر روى عنه عبد الصمد كأنه حرب بن أبي حرب الذي ذكرناه(@)(@@)(@@)(@@) $ 7502 - حرب بن أبي العالية كنيته أبو معاذ يروي عن أبي الزبير PageV06P232 روى عنه أبو الوليد الطيالسي(@)(@@)(@@)(@@) $ 7503 - حرب شيخ يروى عن الحسن روى عنه عبد العزيز بن مسلم القسملي(@)(@@)(@@)(@@) $ 7504 - حرملة بن عمران التجيبي من أهل مصر كنيته أبو حفص يروي عن أبي الأسود وعتبة بن مسلم روى عنه بن المبارك والمقرئ عبد الله بن يزيد كان مولده سنة ثمان وسبعين ومات وهو بن ثنتين وثمانين سنة يوم الخميس في شهر شعبان سنة ستين ومائة ودفن يوم الجمعة وهو أبو جد حرملة بن يحيى التجيبي(@)(@@)(@@)(@@) $ 7505 - حرملة بن قيس النخعي من أهل الكوفة يروي عن أبي زرعة بن عمرو بن جرير روى عنه أبو نعيم الفضل بن دكين(@)(@@)(@@)(@@) $ 7506 - حرملة بن عبد العزيز بن الربيع بن سبرة يروي عن أبيه روى عنه أبو عتبة أحمد بن الفرح وهم إخوة ثلاثة حرملة وعبد الملك وسبرة بنو عبد العزيز PageV06P233(@)(@@)(@@)(@@) $ 7507 - حريث بن السائب الأسدي التميمي مؤذن بني أسد من أهل البصرة كنيته أبو عبد الله يروي عن الحسن وأبي نضرة روى عنه أهل بلده(@)(@@)(@@)(@@) $ 7508 - أبو نعامة العدوي اسمه حريث بن مالك من أهل البصرة يروي عن جماعة من التابعين روى عنه النضر بن شميل وروح بن عبادة(@)(@@)(@@)(@@) $ 7509 - حريث بن أبي عثمان يروي عن سماك بن حرب روى عنه أبو جعفر عبد الله بن محمد النفيلي(@)(@@)(@@)(@@) $ 7510 - حجر بن عنبس أبو العنبس من أهل الكوفة يروي عن علقمة بن وائل روى عنه سلمة بن كهيل(@)(@@)(@@)(@@) $ 7511 - حجر الهجري يروي عن سعيد بن جبير روى عنه عمارة بن أبي حفصة PageV06P234(@)(@@)(@@)(@@) $ 7512 - حجر بن عبد الجبار بن وائل بن حجر أخو سعيد بن عبد 
ms971	 الجبار يروي عن عبد الملك بن عمير أن عثمان بن عفان قال لمروان يا مروان ألعائشة حبل قال نعم قال إني رأيت كأنها ولدت غلاما فألبسته قميصي وعممته بعمامتي فولد عبد الملك بن مروان وهي عائشة بنت معاوية بن المغيرة بن أبي العاص بن أمية روى عن حجر بن عبد الجبار هشام بن محمد بن السائب(@)(@@)(@@)(@@) $ 7513 - حجر بن مالك الكندي يروي عن قبيصة بن ذؤيب روى عنه أبو بكر بن أبي مريم الغساني(@)(@@)(@@)(@@) $ 7514 - حجر بن راشد أبو سهل من أهل البصرة يروي عن أبي جمرة روى عنه موسى بن إسماعيل(@)(@@)(@@)(@@) $ 7515 - حيي بن عبد الله المعافري المصري يروي عن أبى عبد الرحمن PageV06P235 الحبلى روى عنه بن وهب والمصريون(@)(@@)(@@)(@@) $ 7516 - أبو عبيد حاجب سليمان بن عبد الملك اسمه حيي يروي عن عبادة بن نسي روى عنه الأوزاعي وابن عجلان وقد روى عنه عبد الحميد بن جعفر فقال حوى(@)(@@)(@@)(@@) $ 7517 - حيي بن ماتع المعافري من أهل مصر يروي المراسيل روى عنه خالد بن يزيد(@)(@@)(@@)(@@) $ 7518 - حاتم بن أبي صغيرة أبو يونس القشيري مولى بني قشير من أهل البصرة واسم أبيه مسلم يروي عن عمرو بن دينار وسماك بن حرب روى عنه شعبة ويحيى القطان وأبو صغيرة الذي نسب إليه حاتم أبو أمه(@)(@@)(@@)(@@) $ 7519 - حاتم بن أبي نصر القنسريني من أهل قنسرين يروي عن عبادة بن نسي روى عنه هشام بن سعد PageV06P236(@)(@@)(@@)(@@) $ 7520 - حاتم بن عدي الحمصي يروي المراسيل روى عنه سليمان بن أبى عثمان(@)(@@)(@@)(@@) $ 7521 - حاتم بن جبير يروي عن معاوية بن قرة روى عنه محمد بن عبد الله الأنصاري(@)(@@)(@@)(@@) $ 7522 - حاتم بن راشد الفحام من أهل البصرة يروي عن الحسن وابن سيرين روى عنه موسى بن إسماعيل(@)(@@)(@@)(@@) $ 7523 - حاتم بن وردان من أهل البصرة كنيته أبو صالح يروي عن جماعة من أهل بلده من التابعين روى عنه أهل البصرة وابنه صالح بن حاتم بن وردان مات سنة أربع وثمانين ومائة(@)(@@)(@@)(@@) $ 7524 - حاجب بن القعقاع الدارمي يروي عن سعيد بن 
ms972	 جبير عن بن عباس قال إن هذا الدين عربي فإذا رق رقت العرب رواه عمرو بن عاصم عن الطيب بن سليمان عنه(@)(@@)(@@)(@@) $ 7525 - حاجب بن قدامة الحنفي أخو عبد الحميد بن قدامة لأبيه وعبد الحميد أخو عبد الله بن سعد بن نوفل بن مساحق لأمه يروى PageV06P237 عن عيسى الحنفي روى عنه موسى بن يعقوب الزمعي(@)(@@)(@@)(@@) $ 7526 - حاجب بن المفضل بن المهلب عداده في أهل البصرة يروي عن أبيه عن النعمان بن بشير روى عنه حماد بن زيد(@)(@@)(@@)(@@) $ 7527 - حاجب بن أوس الكلابي يروي عن أبيه روى عنه ابنه معلى بن حاجب(@)(@@)(@@)(@@) $ 7528 - حاجب مولى أبي خطمة الأنصاري يروي المراسيل روى عنه مجمع بن يعقوب(@)(@@)(@@)(@@) $ 7529 - حاجب بن عمر أبو خشينة يروي عن الحكم بن عبد الله بن إسحاق عن بن عباس في صوم يوم عاشوراء روى عنه روح بن عبادة وأبو نعيم وهو أخو عيسى بن عمر النحوي الثقفي من أهل البصرة وهو حاجب بن عمر بن عبد الله بن إسحاق الثقفي عمه الحكم بن الأعرج(@)(@@)(@@)(@@) $ 7530 - حاجب يروي عن جابر بن زيد لا أدري من هو ولا بن من هو روى عنه الأسود بن شيبان PageV06P238(@)(@@)(@@)(@@) $ 7531 - حمران بن عبد العزيز أبو محمد العكلي وقد قيل أبو الحكم من أهل البصرة يروي عن الحسن وأم حفص أم ولد عمران بن حصين روى عنه وكيع بن الجراح وأبو داود وهو والد محمد بن حمران(@)(@@)(@@)(@@) $ 7532 - حمران بن يزيد الأعمى من أهل البصرة يروي عن الحسن روى عنه بن المبارك(@)(@@)(@@)(@@) $ 7533 - حر بن عبد الرحمن القاري يروي عن أبي الأسود الديلي روى عنه الحسين بن واقد وهو الذي يقال له حر النحوي(@)(@@)(@@)(@@) $ 7534 - حر أبو مسكين مولى النخع يروي عن هزيل بن شرحبيل من أهل الكوفة روى عنه الثوري(@)(@@)(@@)(@@) $ 7535 - حر بن جرموز من أهل الكوفة يروي عن عمرو بن مرة وأبيه روى عنه شعيب بن حرب وسلم بن قتيبة(@)(@@)(@@)(@@) $ 7536 - حبان بن يسار أبو روح الكلابي يروي عن العراقيين PageV06P239 روى عنه 
ms973	 مالك بن إسماعيل والتبوذكي(@)(@@)(@@)(@@) $ 7537 - حبان الصائغ يروي المراسيل روى عنه الربيع بن صبيح(@)(@@)(@@)(@@) $ 7538 - حبان أبو معمر يروي عن جابر بن زيد روى عنه أبو داود الطيالسي(@)(@@)(@@)(@@) $ 7539 - حبان يروي عن أبيه عن علي لست أعرفه ولا أباه روى عنه عبد الصمد بن عبد الوارث(@)(@@)(@@)(@@) $ 7540 - حبان العبدي أبو بكر من أهل البصرة يروي عن عطاء روى عنه التبوذكي(@)(@@)(@@)(@@) $ 7541 - حبان بن عاصم العنبري يروي عن جده حرملة روى عنه عبد الله بن حسان(@)(@@)(@@)(@@) $ 7542 - حبان بن علي العنزي من أهل الكوفة أخو مندل بن علي يروي عن الأعمش والكوفيين روى عنه أبو شيبة PageV06P240 وأهل العراق مات سنة إحدى وسبعين ومائة وكان يتشيع(@)(@@)(@@)(@@) $ 7543 - حوط بن عبد الله بن رافع العبدي يروي عن أبي الشعثاء وتميم بن سلمة روى عنه مسعر بن كدام(@)(@@)(@@)(@@) $ 7544 - حوط بن يزيد يروي عن تميم بن سلمة روى عنه عيسى بن عمر(@)(@@)(@@)(@@) $ 7545 - حوط شيخ كوفي يروي عن إبراهيم روى عنه الشيباني(@)(@@)(@@)(@@) $ 7546 - حطيط الزيات أدرك جماعة من التابعين روى عنه جعفر بن أبي المغيرة والكوفيون قتله الحجاج بن يوسف بأنواع العذاب حتى مات وعرض عليه الماء عند الموت فأبى وقال لا أشرب إلا من ماء الحياة إن شاء الله عز وجل(@)(@@)(@@)(@@) $ 7547 - حدير بن حصين العدوي قال قيل للحسن إن بن سيرين لا يلعن الحجاج قال لكني ألعنه لعنه الله لعنا كثيرا روى عنه PageV06P241 الفضل بن موسى السيناني هكذا قاله الفضل بن موسى وقال أبو تميلة ثنا حدير بن الخطاب العدوي(@)(@@)(@@)(@@) $ 7548 - حكيم بن رزيق بن حكيم مولى بني فزارة يروي عن أبيه روى عنه بن المبارك(@)(@@)(@@)(@@) $ 7549 - حكيم بن محمد من أهل المدينة يروي عن سعيد المقبري روى عنه علي بن عبد الرحمن بن عثمان(@)(@@)(@@)(@@) $ 7550 - حذيفة أبو اليمان الواسطي يروي عن الشعبي روى عنه شعبة وهشيم(@)(@@)(@@)(@@) $ 7551 - حذيفة المصيصي شيخ يروي المراسيل روى عنه محمد بن يوسف الفريابي(@)(@@)(@@)(@@) $ 7552 - حكام بن سلم الرازي يروي عن الأعمش روى عنه أهل بلده والعراقيون 
ms974	(@)(@@)(@@)(@@) $ 7553 - حنش بن الحارث بن لقيط النخعي من أهل الكوفة يروي عن سويد بن غفلة وأبيه روى عنه شريك وأبو نعيم PageV06P242(@)(@@)(@@)(@@) $ 7554 - حوشب أبو بشر وكان من العباد ممن يقص يروي عن الحسن عداده في أهل البصرة روى عنه جعفر بن سليمان الضبعي وغالب القطان(@)(@@)(@@)(@@) $ 7555 - حوشب بن مسلم الثقفي مولى الحجاج بن يوسف من أهل البصرة يروي عن الحسن روى عنه نوح بن قيس ومسلم بن إبراهيم أحسبه الأول وكان يبيع الطيالسة بالبصرة(@)(@@)(@@)(@@) $ 7556 - حوشب بن عقيل أبو دحية يروي عن أبيه عن عائشة روى عنه وكيع(@)(@@)(@@)(@@) $ 7557 - حوشب الشيباني من أهل واسط يروي عن سعيد بن جبير روى عنه ابنه العوام بن حوشب(@)(@@)(@@)(@@) $ 7558 - حميضة بن الشمردل الأسدي يروي عن جماعة من التابعين روى عنه أهل الكوفة(@)(@@)(@@)(@@) $ 7559 - حريز شيخ يروي عن أبي القماص روى عنه سلمة بن كهيل(@)(@@)(@@)(@@) $ 7560 - حنين بن أبي حكيم يروي عن علي بن رباح روى عنه الليث PageV06P243 بن سعد وعمرو بن الحارث عداده في أهل مصر(@)(@@)(@@)(@@) $ 7561 - حجير بن عبد الله يروي عن عبد الله بن بريدة روى عنه شيخ يقال له دلهم(@)(@@)(@@)(@@) $ 7562 - حمل بن بشير بن أبي حدرد الأسلمي يروي عن عمه عن أبي حدرد روى عنه سلم بن قتيبة(@)(@@)(@@)(@@) $ 7563 - حازم بن إبراهيم البجلي يروي عن سماك بن حرب من أهل الكوفة روى عنه سلم بن قتيبة ومسلم بن إبراهيم(@)(@@)(@@)(@@) $ 7564 - حازم بن حاتم يروي عن شيخ له عن عائشة روى عنه هشام بن حسان(@)(@@)(@@)(@@) $ 7565 - حبان بن واسع بن حبان المازني الأنصاري من أهل المدينة يروي عن أبيه عن عبد الله بن زيد روى عنه عمرو بن الحارث وأهل المدينة(@)(@@)(@@)(@@) $ 7566 - حزم بن أبي حزم القطعي من أهل البصرة واسم أبى حزم PageV06P244 مهران يروي عن الحسن وابن سيرين روى عنه بن المبارك وأهل بلده مات سنة خمس وسبعين ومائة وكان يخطىء حدثنا عمر بن محمد عن بحير الهمداني ثنا أحمد بن المقدام العجلي قال ثنا حزم بن أبي حزم 
ms975	 قال رأيت الحسن قدم مكة فقام خلف المقام فصلى فجاء عطاء وطاوس ومجاهد وعمرو بن شعيب فجلسوا بين يديه(@)(@@)(@@)(@@) $ 7567 - حاجز بن عبد الله المحاربي يروي عن التابعين عداده في أهل الكوفة روى عنه شريك بن عبد الله النخعي(@)(@@)(@@)(@@) $ 7568 - حنان الأسدي رجل من بني أسد يروي عن أبي عثمان النهدي روى عنه حجاج بن أبي عثمان الصواف(@)(@@)(@@)(@@) $ 7569 - حريش البجلي كوفي يروي عن أبيه عن علي روى عنه الثوري(@)(@@)(@@)(@@) $ 7570 - حريش بن قدامة الضبعي يروي عن أبي حبرة عن علي روى عنه النضر بن شميل(@)(@@)(@@)(@@) $ 7571 - حريش بن سليم أبو سعيد الجعفي من أهل الكوفة وهو PageV06P245 الذي يقال له حريش بن أبي حريش يروي عن طلحة بن مصرف روى عنه أبو داود الطيالسي حدثنا عبد الله بن محمد البغوي قال ثنا أحمد بن حنبل قال ثنا أبو داود قال ثنا حريش بن سليم قال ثنا طلحة بن مصرف عن أبي بردة عن أبي موسى عن النبي صلى الله عليه وسلم الله عليه وآله وسلم قال كل مسكر حرام(@)(@@)(@@)(@@) $ 7572 - حصن بن عبد الرحمن من أهل دمشق يروي عن أبي سلمة بن عبد الرحمن روى عنه الأوزاعي أخبرني رجل من ولد سلمة بن العيار بدمشق أنه سلمة بن العيار بن حصن بن عبد الرحمن الذي روى عنه الأوزاعي(@)(@@)(@@)(@@) $ 7573 - حويرث بن نمار يروي عن عبيد الله بن مروان روى عنه مسعر بن كدام(@)(@@)(@@)(@@) $ 7574 - حيوة بن شريح بن مسلم الحضرمي من أهل مصر كنيته PageV06P246 أبو زرعة يروي عن عقبة بن مسلم روى عنه بن المبارك وأهل بلده مات سنة تسع أو ثمان وخمسين ومائة وكان مستجاب الدعوة يقال إن الحصاة كانت تتحول في يده تمرة بدعائه وكان من المبرزين في العبادة والزهد بمصر سمعت إسحاق بن إبراهيم القاضي يقول سمعت سعيد بن يعقوب الطالقاني يقول سمعت بن المبارك يقول ما وصف لي أحد إلا وجدته عند اللقاء أقل مما وصف لي إلا حيوة بن شريح(@)(@@)(@@)(@@) $ 7575 - حزام بن هشام بن 
ms976	 حبيش الخزاعي من أهل الرقم موضع بالبادية يروي عن أبيه عن حبيش بن خالد وله صحبة قصة أم معبد روى عنه هاشم بن القاسم ومحرز بن المهدى وأبو مكرم(@)(@@)(@@)(@@) $ 7576 - حزام بن حكيم من أهل الشام يروي عن مكحول روى عنه زيد بن واقد الشامي PageV06P247(@)(@@)(@@)(@@) $ 7577 - حشرج بن زياد النخعي يروي عن جدته أم أبيه روى عنه رافع بن سلمة(@)(@@)(@@)(@@) $ 7578 - حلام بن صالح العبسي من أهل الكوفة يروي عن مسعود بن حراش قال أمنا عمر بن الخطاب رضي الله عنه في ثوب ليس عليه غيره روى عنه أهل الكوفة وعبد الواحد بن زياد(@)(@@)(@@)(@@) $ 7579 - حلو بن السرى من أهل الكوفة يروي عن أبي إسحاق السبيعي روى عنه الحارث بن محمد والكوفيون يخطىء ويغرب على قلة روايته(@)(@@)(@@)(@@) $ 7580 - حاضر بن المهاجر أبو عيسى الباهلي يروي عن سليمان بن يسار روى عنه شعبة بن الحجاج(@)(@@)(@@)(@@) $ 7581 - حنيف بن رستم المؤذن يروي عن أبي الرقاد روى عنه جرير بن عبد الحميد الضبي PageV06P248(@)(@@)(@@)(@@) $ 7582 - حضرمي بن عجلان مولى بني جذيمة بن عبيد العيشي ويقال هو مولى الجارود يروي عن نافع روى عنه زياد بن الربيع(@)(@@)(@@)(@@) $ 7583 - حضرمي بن لاحق التميمي الأعرج يروي عن سعيد بن المسيب ومغيث بن سمي روى عنه يحيى بن أبي كثير ومن قال إنه حضرمي بن إسحاق فقد وهم وروى يحيى بن أبي كثير عن الحضرمي بن لاحق عن أبي صالح عن عائشة قصة الدجال(@)(@@)(@@)(@@) $ 7584 - حضرمي شيخ يروي عن القاسم بن محمد روى عنه سليمان التيمي لا أدرى من هو ولا بن من هو(@)(@@)(@@)(@@) $ 7585 - حبحاب بن أبي الحبحاب يروي المراسيل روى عنه جعفر بن برقان(@)(@@)(@@)(@@) $ 7586 - حبيب بن حجر أبو يحيى العبسي من أهل البصرة يروي عن الأزرق بن قيس عن بن عمر روى عنه موسى بن إسماعيل PageV06P249(@)(@@)(@@)(@@) $$ 7587 - حمادة بنت محمد بن عبد الرحمن بن أبي ليلى تروي عن عمتها آمنة بنت عبد الرحمن بن أبي ليلى عن جدتها أم ليلى قالت بايعنا رسول الله صلى 
ms977	 الله عليه وسلم روى عنها محمد بن عمران بن محمد بن أبي ليلى(@)(@@)(@@)(@@) $$ 7588 - حميدة بنت ثابت البناني تروي عن أبيها روت عنها عفيرة بنت واقد(@)(@@)(@@)(@@) $$ 7589 - حفصة بنت أبي كثير تروي عن أبيها أبي كثير قال علمتني أم سلمة قالت علمني رسول الله صلى الله عليه وسلم قال قولي يا أم سلمة عند أذان المغرب اللهم عند إقبال ليلك وإدبار نهارك وأصوات دعاتك وحضور صلواتك أسألك أن تغفر لي حدثنا أبو يعلى ثنا حسين بن الأسود ثنا بن فضيل قال ثنا عبد الرحمن بن إسحاق عن حفصة بنت أبى كثير(@)(@@)(@@)(@@) $$ 7590 - حميدة بنت عبيد بن رفاعة يروي عن كبشة بنت كعب بن مالك روى عنها إسحاق بن عبد الله بن أبي طلحة PageV06P250(@)(@@)(@@)(@@) || (باب الخاء)(@)(@@) قال أبو حاتم رضي الله عنه وممن شافه التابعين وروى عنهم ممن ابتدأ اسمه على الخاء(@)(@@)(@@)(@@) $ 7591 - خالد بن سعيد بن عمرو بن سعيد بن العاص الأموي القرشي أخو إسحاق بن سعيد يروي عن أبيه روى عنه عبد الله بن المبارك(@)(@@)(@@)(@@) $ 7592 - خالد بن دينار الشيباني من أهل الكوفة كنيته أبو الوليد يروي عن الحسن ومعاوية بن قرة روى عنه يزيد بن زريع وهو الذي يقال له خالد النيلي كان يسكن النيل فينسب إليها والنيل قرية من قرى واسط(@)(@@)(@@)(@@) $ 7593 - خالد بن مضرس يروي عن أشياخ من الأنصار روى عنه إسماعيل بن أمية(@)(@@)(@@)(@@) $ 7594 - خالد بن سلمة بن هشام بن العاص المخزومي يروي عن أبيه روى عنه أهل الكوفة أمه أم ولد PageV06P251(@)(@@)(@@)(@@) $ 7595 - خالد بن أيمن يروي عن الشعبي روى عنه عبد الله بن حبيب(@)(@@)(@@)(@@) $ 7596 - خالد بن أيوب يروي عن أبيه روى عنه جرير بن حازم(@)(@@)(@@)(@@) $ 7597 - خالد بن باب الربعي يروي عن شهر بن حوشب روى عنه أبو الأشهب(@)(@@)(@@)(@@) $ 7598 - خالد بن أبي جنادة يروي عن مكحول روى عنه زيد بن أبي أنيسة(@)(@@)(@@)(@@) $ 7599 - خالد أبو إدريس كان ينزل في بني قيس بالبصرة يروي عن الأحنف بن قيس روى عنه أبو هلال الراسبي 
ms978	(@)(@@)(@@)(@@) $ 7600 - خالد بن برد يروي عن قتادة روى عنه عبد السلام بن هاشم(@)(@@)(@@)(@@) $ 7601 - خالد بن جميع المهري من أهل البصرة يروي عن الحسن روى عنه موسى بن إسماعيل(@)(@@)(@@)(@@) $ 7602 - خالد بن الصلت عامل عمر بن عبد العزيز من أهل المدينة يروي عن عراك بن مالك روى عنه خالد الحذاء والمبارك بن فضالة PageV06P252(@)(@@)(@@)(@@) $ 7603 - خالد بن حسان يروي عن محمد بن كعب ومكحول روى عنه أهل الحجاز(@)(@@)(@@)(@@) $ 7604 - خالد بن جابر يروي عن أبيه روى عنه هلال بن خباب وابنه حفص بن خالد(@)(@@)(@@)(@@) $ 7605 - خالد بن الخشخاش يروي عن شريح روى عنه زهير بن معاوية(@)(@@)(@@)(@@) $ 7606 - خالد شيخ يروي المراسيل روى عنه ابنه محمد بن خالد لست أعرفهما جميعا(@)(@@)(@@)(@@) $ 7607 - خالد بن مهران الحذاء مولى بني مجاشع من أهل البصرة كنيته أبو المنازل وقيل مولى لقريش كان يجلس إلى الحذائيين فنسب إليهم ولم يكن بحذاء يروي عن أبي قلابة والحسن وابن سيرين روى عنه أهل العراق مات سنة إحدى أو اثنتين وأربعين ومائة PageV06P253(@)(@@)(@@)(@@) $ 7608 - خالد بن أبي خالد الحنفي أبو الأعور يروي عن الشعبي وإبراهيم روى عنه الثوري ومروان بن معاوية الفزاري(@)(@@)(@@)(@@) $ 7609 - خالد بن أبي بكر بن عبيد الله بن عبد الله بن عمر بن الخطاب أمه أم الحسن بنت خالد بن المنذر بن أبي أسيد الساعدي مات سنة ثنتين وخمسين ومائة يخطىء(@)(@@)(@@)(@@) $ 7610 - خالد بن زيد شيخ يروي عن قزعة روى عنه المعتمر بن سليمان حدثنا بن قتيبة ثنا بن أبي السرى ثنا معتمر عن خالد بن زيد عن قزعة قال صحبت عبد الله بن عمر في سفر قال فتقدم ذات ليلة فجعل يقرأ ويركع ويسجد أينما كان وجهه فلما أصبح قلت صنعت شيئا لم تكن تصنعه على راحلتك جعلت تقرأ وتركع وتسجد حيث كان وجهك قال رأيت أبا القاسم صلى الله عليه وسلم يفعله PageV06P254(@)(@@)(@@)(@@) $ 7611 - خالد بن سلمة الفأفاء المخزومي القرشي يروي عن الشعبي وأبي بردة روى عنه الثوري وابن عيينة(@)(@@)(@@)(@@) $ 7612 - خالد بن دهقان من أهل 
ms979	 الشام يروي عن عبد الله بن أبي زكريا روى عنه صدقة بن خالد ومحمد بن شعيب بن شابور(@)(@@)(@@)(@@) $ 7613 - خالد بن سعيد يروي عن مالك بن الجون روى عنه عمرو بن قيس(@)(@@)(@@)(@@) $ 7614 - خالد بن دريك الشامي يروى عن بن محيريز روى عنه الأوزاعي وقتادة(@)(@@)(@@)(@@) $ 7615 - خالد بن سعيد بن أبي سعيد الخدري يروي عن أبيه روى عنه داود بن صالح(@)(@@)(@@)(@@) $ 7616 - خالد سبلان يروي عن كهيل بن حرملة السلمي روى عنه خالد بن دهقان PageV06P255(@)(@@)(@@)(@@) $ 7617 - خالد بن رخيم يروي عن مطرف بن عبد الله بن الشخير قوله روى عنه بكر الأعنق(@)(@@)(@@)(@@) $ 7618 - خالد بن سعيد يروي عن المطلب بن حنطب روى عنه محمد بن معن الغفاري(@)(@@)(@@)(@@) $ 7619 - خالد بن عبد الله القسري والى العراق أصله من اليمن يروي عن أبيه عن جده يزيد بن أسد روى عنه أهل العراق قتل بالكوفة سنة عشرين ومائة أو قريبا منها(@)(@@)(@@)(@@) $ 7620 - خالد بن زاذان يروي عن الحسن روى عنه شعبة بن الحجاج وهو أخو منصور بن زاذان قال سألت الحسن عن أمة زنت وقتلت نفسها قال صلوا عليها PageV06P256(@)(@@)(@@)(@@) $ 7621 - خالد بن صبيح الجبلاني من أهل الشام يروي عن نوف البكالي روى عنه صفوان بن عمرو السكسكي(@)(@@)(@@)(@@) $ 7622 - خالد بن طهمان أبو العلاء السلولي وهو الذي يقال له أبو العلاء الخفاف يروي عن حبيب بن أبي ثابت وعطية روى عنه وكيع والفريابي يخطىء ويهم(@)(@@)(@@)(@@) $ 7623 - خالد بن عبد الله بن أسيد أخو أمية بن عبد الله يروي عن قبيصة بن ذؤيب روى عنه الزهري(@)(@@)(@@)(@@) $ 7624 - خالد بن صفوان يروي عن زيد بن على عن بن عباس روى عنه هشيم بن بشير(@)(@@)(@@)(@@) $ 7625 - خالد بن الطفيل بن مدرك الغفاري من أهل المدينة يروي عن الحجازيين روى عنه كثير بن زيد(@)(@@)(@@)(@@) $ 7626 - خالد بن عبد الله بن حرملة المدلجي يروي عن الحارث بن خفاف بن إيماء بن رخصة الغفاري روى عنه محمد بن عمرو بن علقمة PageV06P257(@)(@@)(@@)(@@) $ 7627 - خالد بن عرفطة يروي عن أبي سفيان عن 
ms980	 جابر روى عنه واصل مولى أبي عيينة حدثنا إبراهيم بن حزيم بخرشكت قال ثنا عبد بن حميد قال ثنا عبد الصمد بن عبد الوارث قال ثنا أبي قال ثنا واصل مولى أبي عيينة قال حدثني خالد بن عرفطة عن طلحة بن نافع عن جابر بن عبد الله قال كنا عند رسول الله صلى الله عليه وسلم فهاجت ريح منتنة فقال أتدرون ما هذه الريح قلنا الله ورسوله أعلم قال هذه ريح الذين يغتابون المسلمين(@)(@@)(@@)(@@) $ 7628 - خالد بن طليق من أهل الشام يروي عن يزيد بن خمير اليزني عن عبد الرحمن بن شبل روى عنه الزبيدي(@)(@@)(@@)(@@) $ 7629 - خالد بن عبد الله بن سعيد العنبري يروي عن يزيد بن أبي مريم عن أنس بن مالك روى عنه عبد الصمد بن عبد الوارث PageV06P258(@)(@@)(@@)(@@) $ 7630 - خالد بن رباح أبو الفضل يروي عن الحسن روى عنه سعيد بن زيد(@)(@@)(@@)(@@) $ 7631 - خالد بن عبد الله الزيادي وقيل الزبادي يروي عن عراك بن مالك ومشكان أبي عمر روى عنه جعفر بن ربيعة وعمرو بن الحارث(@)(@@)(@@)(@@) $ 7632 - خالد بن قيس الحداني من أهل البصرة يروي عن قتادة روى عنه أخوه نوح بن قيس(@)(@@)(@@)(@@) $ 7633 - خالد بن الصفار يروي عن الحسن قال شاهد الزور لا تزول قدماه حتى تجب له النار روى عنه الحسين بن واقد(@)(@@)(@@)(@@) $ 7634 - خالد بن عبد الله بن الطفيل وكان عالم بني عامر بن صعصعة يروي عن ربيعة بن عامر بن مالك روى عنه الزهري PageV06P259(@)(@@)(@@)(@@) $ 7635 - خالد بن مهاجر يروي عن القاسم بن محمد روى عنه طلحة بن أبي سعيد(@)(@@)(@@)(@@) $ 7636 - خالد بن عبد الله المخزومي يروي عن سعيد بن المسيب روى عنه ابنه العطاف بن خالد المخزومي القرشي(@)(@@)(@@)(@@) $ 7637 - خالد بن عبد الرحمن بن بكير السلمي يروي عن نافع روى عنه وكيع وأبو الوليد الطيالسي(@)(@@)(@@)(@@) $ 7638 - خالد بن سعيد المدني يروي عن أبي حازم عن سهل بن سعد روى عنه حسان بن إبراهيم الكرماني(@)(@@)(@@)(@@) $ 7639 - خالد بن علقمة الهمداني من أهل الكوفة يروي عن 