ms296	 خمار ببندیم(@)(@@) 62 آن باده خوش آید که دود بر سر و بر گوش %~% راه سخن مردم هشیار ببندیم(@)(@@) 63 خواهم که شب جمعه‌ای از خانه خمار %~% آیم به در صومعه زاهد دین دار(@)(@@) 64 در بشکنم و از پس هر پرده زرقی %~% بیرون فکنم از دل او سد بت پندار(@)(@@) 65 بر تن درمش خرقه سالوس و از آن زیر %~% آرم به در صومعه سد حلقه زنار(@)(@@) 66 مردان خدا رخت کشیدند به یکبار %~% چیزی به میان نیست بجز جبه و دستار(@)(@@) 67 این صومعه داران ریایی همه زرقند %~% پس تجربه کردیم همان رند قدح خوار(@)(@@) 68 می خوردن ما عذر سخن کردن ما خواست %~% بر مست نگیرند سخن مردم هشیار(@)(@@) 69 رفتم به در مدرسه و گوش کشیدم %~% حرفی که به انجام برم پی نشیندم(@)(@@) 70 سد اصل سخن رفت و دلیلش همه مدخول %~% از شک و گمانی به یقینی نرسیدم(@)(@@) 71 بس عقده که حل گشت در او هیچ نبسته %~% یک در نگشودند ز سد قفل کلیدم(@)(@@) 72 گفتند درون آی و ببین ماحصل کار %~% غیر از ورقی چند سیه کرده ندیدم(@)(@@) 73 گفتند که در هیچ کتابی ننوشتند %~% هر مسأله عشق کز ایشان طلبیدم(@)(@@) 74 جستم می منصور ز سر حلقه مجلس %~% آن می‌طلبی گفت که هرگز نچشیدم(@)(@@) 75 دیدم که در او دردسری بود و دگر هیچ %~% با دردکشان باز به میخانه دویدم(@)(@@) 76 المنة لله که ندارم زر و سیمی %~% کز بخل خسیسی شوم از حرص لیمی(@)(@@) 77 شغلی نه که تا غیر برد مایده خلد %~% باید ز پی جان خود افروخت جحیمی(@)(@@) 78 نه عامل دیوان و نه پا در گل زندان %~% نی بسته امیدی و نی خسته بیمی(@)(@@) 79 ماییم و همین حلقی و پوشیدن دلقی %~% یک گوشه نان بس بود و پاره گلیمی(@)(@@) 80 بهر شکمی کاوست پی مزبله مزدور %~% دریوزه هر سفله بود عیب عظیمی(@)(@@) 81 ز آنجا که بود 
ms297	 سیری چشم و دل قانع %~% ده روز بسازم نه به قرصی که به نیمی(@)(@@) 82 گر روح غذا گیرد از آن باده که ماراست %~% سد سال توان زیست به تحریک نسیمی(@)(@@) 83 دارم ز زمان شکوه نه از اهل زمانه %~% کو مطرب و سازی که بگویم به ترانه(@)(@@) 84 خواهم که سر آوازه‌ای از تازه بسازم %~% کرند به بازار به آواز چغانه(@)(@@) 85 سر کندن و انداختنش را چه توان گفت %~% مرغی که نه آبی طلبیده‌ست و نه دانه(@)(@@) 86 در عهد که بوده ست که یک بار شنوده‌ست %~% تاریخ جهان هست فسانه به فسانه(@)(@@) 87 بلبل هدف تیر نمودن که پسندد %~% خاصه که بود بلبل مشهور زمانه(@)(@@) 88 جز عشق و محبت گنهم چیست چه کردم %~% ای تیر غمت را دل عشاق نشانه(@)(@@) 89 ساقی سخن مست دراز است بده می %~% تا درد سر شکوه کشد یا ز میانه(@)(@@) 90 گر شکوه‌ای آمد به زبان بزم شراب است %~% باید که بشویند ز دل عالم آب است(@)(@@) 91 زینش نتوان سوخت گر از خویش بنالد %~% آن مرغ که در روغن خود گشته کباب است(@)(@@) 92 ابری برسد روزی و جانش به تن آید %~% آن ماهی تفسیده که در آب سراب است(@)(@@) 93 گر قهقهه‌اش نیست مخوان مرغ به کویش %~% آن کبک که آرامگهش جای عقاب است(@)(@@) 94 پا در گلم و مقصد من دور حرم لیک %~% تا چون بر هم ز آنکه رهم جمله خلاب است(@)(@@) 95 وین طرفه که بارم همه شیشه ست پر از می %~% وقتی که شود شیشه تهی کار خراب است(@)(@@) 96 کو خضر که تا باز کند چشم و ببیند %~% خمخانه و خمها که پر از باده ناب است(@)(@@) 97 میخانه که پرورده‌ام از لای خم او %~% بادا سر من خاک ته پای خم او(@)(@@) 98 حیف است به زیر سر من بر سر من نه %~% آن خشت که بوده ست به بالای خم او 
