ms122	 أحدكم الناس فليخفف فإن فيهم الصغير والكبير والضعيف والمريض وذا الحاجة ، وإذا صلى لنفسه فليطول ما شاء ) )(@)(@@) ( حم ق ت ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1100 ) قال النبي :(@)(@@) | 30 ( إذا أم الرجل القوم فلا يقم في مكان أرفع من مقامهم ) )(@)(@@) ( د هق ) عن حذيفة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1101 ) قال النبي :(@)(@@) | 30 ( إذا أممت الناس فاقرأ بالشمس وضحاها ، وسبح اسم ربك الأعلى ، والليل إذا يغشى ) )(@)(@@) ( م ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1102 ) قال النبي :(@)(@@) | 30 ( إذا أممت قوما فأخف بهم الصلاة ) )(@)(@@) ( م ه ) عن عثمان بن أبي العاصي رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1103 ) قال النبي :(@)(@@) | 30 ( إذا أمن الإمام أمنوا فإنه من وافق تأمينه تأمين الملائكة غفر له ما تقدم من ذنبه ) )(@)(@@) ( مالك حم ق 4 ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1104 ) قال النبي :(@)(@@) | 30 ( إذا أمن القارىء فأمنوا فإن الملائكة تؤمن فمن وافق تأمينه تأمين الملائكة غفر له ما تقدم من ذنبه ) )(@)(@@) ( ن ه ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@) PageV01P175(@)(@@)(@@)(@@) $ ( 1105 ) قال النبي :(@)(@@) | 30 ( إذا أنا مت فاغسلوني بسبع قرب من بئر غرس ) )(@)(@@) ( ه ) عن علي رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1106 ) قال النبي :(@)(@@) | 30 ( إذا أنا مت وأبا بكر وعثمان وعمر فإن استطعت أن تموت فمت ) )(@)(@@) ( حل ) عن سهل بن أبي حثمة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1107 ) قال النبي :(@)(@@) | 30 ( إذا انتاط غزوكم وكثرت العزائم واستحلت الغنائم فخير جهادكم الرباط ) )(@)(@@) ( طب ) و ابن منده ( خط ) عن عتبة بن الندر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1108 ) قال النبي :(@)(@@) | 30 ( إذا أنت بايعت فقل : لا خلابة ثم أنت في كل سلعة ابتعتها بالخيار ثلاث ليال ، فإن رضيت فأمسك ، وإن سخطت فارددها على صاحبها ) )(@)(@@) ( ه هق ) عن محمد بن يحيى بن حماد مرسلا ( ز ) .(@)(@@)(@@)(@@) $ ( 1109 ) قال النبي :(@)(@@) | 30 ( إذا انتصف شعبان فلا تصوموا حتى يكون رمضان ) )(@)(@@) ( حم 4 ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1110 ) قال النبي :(@)(@@) | 30 ( إذا انتعل أحدكم فليبدأ باليمنى ، وإذا خلع فليبدأ باليسرى ، لتك