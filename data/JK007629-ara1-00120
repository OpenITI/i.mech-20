ms101	 المقادر % 6(@)(@@) % إذا أنت لم تدر الذي أنا قائل % به في جناب الحق ما أنت تاجر % 7(@)(@@) % لو أنك بالنعت الذي قلته تكن % % عليه لما دارت عليك الدوائر % 8(@)(@@) % فبرك لم يتفق ومالك راسخ % وريحك لم يحصل وحدك غامر % 9(@)(@@) % خليلي ما للريح يأتي جنوبها % % قبولا ويقصيني الحدود العواثر % % 10(@)(@@) % وإني من أهل البيت ما أنا بائن % ولا أنا حداد ولا أنا زافر % % PageV01P391 11(@)(@@) % فلست أبالي من رياح تقلبت % % علي مجاريها فإني آمر % % 12(@)(@@) % عن الأمر بالأمر الذي لا بضده % % سهام الأعادي يوم تبلى السرائر % % 13(@)(@@) % تبارك من شخص عن الحق ثابت % وما لك من أيد وما لك ناصر % 14(@)(@@) % وما علمت منك الأقارب والعدى % % إذا كنت صبارا بمن أنت صابر % 15(@)(@@) % يقولون إن الصدع للرجع لازم % وقد صدعوا لكنهم لم يثابروا % % 16(@)(@@) % على ما لنور الشمس في ذاك من جدى % ولولاه ما جاءتك سحب مواطر % PageV01P392 البحر : بسيط تام 1(@)(@@) % ما لي من العلم إلا ما نطقت به % وهو الصحيح الذي لا شرع ينكره % 2(@)(@@) % يقول من ليس يدريه استتر % وكيف أستره والحق يظهره % % 3(@)(@@) % الله ما زال للأسماع يسمعه % بما يقرره شرعا ويذكره % 4(@)(@@) % وليس شخص من أهل العلم ينكره % إلا تراه لدى الإنصاف يضمره % % 5(@)(@@) % الفكر ينفيه والإيمان يثبته % وكم شخيص قد أرداه تفكره % % 6(@)(@@) % إن السعادة بالإيمان قد قرنت % والسعد يسعد ما وهمي يصوره % % 7(@)(@@) % والله أقرب من حبل الوريد وما % % تراه حسا ولا الأعيان تبصره % 8(@)(@@) % يكفيك منه الذي الرحمن صوره % % 9(@)(@@) % النص عز لأن الله ذو كرم % بخلقه فلهذا لا يصدره % % 10(@)(@@) % لو جاء بالنص لم يقبله ذو نظر % إلا بإيمانه لذاك يستره % % PageV01P393 البحر : بسيط تام 1(@)(@@) % حكم الطبيعة في الأجسام معتبر % لأنها أصلها والأصل يعتبر % 2(@)(@@) % فانظر إليها إذا طال الزمان بها % % تبدد الشمل لا تبقي ولا تذر % 3(@)(@@) % في النار ينضجها وفي الجنان لها % % حكم علينا كما تدرون فادكروا % % 4(@)(@@) % إن العذاب لها مثل النعيم بها % % وذنبها عند أهل الكشف مغتفر % 5(@)(@@) % الله 
ms102	 حكمها فينا وأحكمها % % فما لها عن نفوذ حكمه وزر % 6(@)(@@) % بها يعذبنا بها ينعمنا % % وليس يخلص من أحكامها بشر % 7(@)(@@) % سبحان من أوسع الأشياء رحمته % % في الخير والشر علما هكذا الخبر % % 8(@)(@@) % جل الإله فما تحصى عوارفه % فالكل منه كما قد شاءه القدر % PageV01P394 البحر : بسيط تام 1(@)(@@) % أصبحت مثل بني يعقوب إذ دخلوا % % على العزيز فقالوا مسنا الضرر % 2(@)(@@) % وأهلنا معنا قد مس أكثرهم % % مثل الذي مسنا منه ولا وزر % 3(@)(@@) % إن الذي بجميل الصنع عودنا % % هو الإله الذي تعنو له البشر % 4(@)(@@) % إن الخلائق إن عزوا وإن كثرت % أموالهم هم على الحاجات قد فطروا % % 5(@)(@@) % فلا غنى سوى الرحمن فارض به % % ربا كريما هو المقصود فادكروا % % 6(@)(@@) % إنا جمعنا على توحيد رازقنا % % بلا خلاف على ما أعطت الفكر % % 7(@)(@@) % وجاء في الوحي منه ما يصدقنا % % فصح في العقل ما قد صحح الخبر % PageV01P395 البحر : بسيط تام 1(@)(@@) % شمر فإن صفات القوم تشمير % ولا لقول على ما فيه تشطير % 2(@)(@@) % ولتأت بالكل إن الكل مطلب من % أوحى إليك به فالأمر تشمير % 3(@)(@@) % من يأت بالنص والإجمال يطلبه % قد جاء بالنص لكن فيه تقصير % 4(@)(@@) % إذا أتيتم بما يرضي نفوسكم % دون الإله به فأنت مغرور % 5(@)(@@) % ما بين عدل وفصل حكم خالقنا % % فينا وللفصل دون العدل تقدير % % 6(@)(@@) % كذا أتتنا نصوص العدل مخبرة % % من الإله بما فيه التباشير % PageV01P396 البحر : بسيط تام 1(@)(@@) % إن الذي بوجودي اليوم أعرفه % هو الذي في غد بذاك أنكره % 2(@)(@@) % إن كان أخفاه في عيني تقلبه % فإن قلبي في التقليب يبصره % 3(@)(@@) % من أعجب الأمر أني حين أذكره % % أغيب عنه ويدنيني تذكره % 4(@)(@@) % رأيته ذاكرا لي حين أذكره % في كل حال وتخفيني فأظهره % % 5(@)(@@) % إياه أسأل عنه حين يسألني % % عني وينسى إذا أنسى فأذكره % 6(@)(@@) % لو أنه في وجودي حين يشهدني % % ما كنت أشهده ما كنت أبصره % PageV01P397 البحر : بسيط تام 1(@)(@@) % قلب المحقق مرآة فمن نظرا % % يرى الذي أوجد الأوراح والصورا % % 2(@)(@@) % إذا أزال صدى الأكوان واتحدت % صفاته 
ms103	 بصفات الحق فاعتبرا % % 3(@)(@@) % من شاهد الملأ الأعلى فغايته % % النور وهو مقام القلب إن شكرا % % 4(@)(@@) % ومن يشاهد صفات الحق فاعلة % لكل شيء يكن في الوقت مفتكرا % % 5(@)(@@) % ومن يشاهد مقام الذات يحظ بها % % في الوقت من سلب الأوصاف مفتقرا % % 6(@)(@@) % فكل قلب تعالى عن أكنته % % لم يدر في الملأ الأعلى ولا ذكرا % % 7(@)(@@) % وكيف يدرك قلب بات محتجبا % عن الوجود فما صلى ولا اعتمرا % % 8(@)(@@) % ما يعرف العين إلا العين فاستمعوا % % ما قلب عين كقلب قلد الخبرا % % PageV01P398 البحر : مجزوء الخفيف 1(@)(@@) % عمل الهمة اعتلى % % فوق رسم المزبره % % 2(@)(@@) % وكذا الرسم غاية % للبرود المدبره % 3(@)(@@) % غاية الرسم همة % مصطفاة مطهره % % 4(@)(@@) % ولها غاية علت % بالوجود المنظره % PageV01P399 البحر : طويل 1(@)(@@) % خرقت حجاب الغيب أطلب سره % % فلم ألف إلا بهتة وتحيرا % % 2(@)(@@) % فعدت إلى الأكوان أبغي شهوده % % فلم أر في الأكوان علما مقررا % % 3(@)(@@) % فيا مدعي علم الأكاسير ليته % % تقرر في الأوزان وزنا محررا % % 4(@)(@@) % يوافق أوزان الطبيعة كونه % % على الفعل لا يلقى عن الأمر مخبرا % % 5(@)(@@) % فيقلب عين البدر شمسا منيرة % وينشء بهراما شموسا وأقمرا % % 6(@)(@@) % فقال له الميزان لست بحاصل % لمن ظل طول الدهر في مفكرا % % 7(@)(@@) % ولكن حصولي اتفاقا فإنني % % عزيز عن الإدراك غيبا ومحضرا % PageV01P400 البحر : بسيط تام 1(@)(@@) % عجبت من رجم نار يحرق النارا % % والله يظهره في العين أنوارا % % 2(@)(@@) % لا بد منه له حفظا لشرعتنا % % ولو تسرب أنفاقا وأغوارا % 3(@)(@@) % يشوه الوجه منه عند رؤيته % وثم يخطف أسماعا وأبصارا % % PageV01P401 البحر : طويل 1(@)(@@) % إذا أخذ الفرقان من كان يتقي % % جزاء لتقواه وعفوا وتكفيرا % % 2(@)(@@) % فما بعد ذا من غاية يطلبونها % % سوى قربه الأعلى وجوبا وتقريرا % % 3(@)(@@) % ففي جنة المأوى وجودا محققا % وفي جنته المعنى جلالا وتوقيرا % % 4(@)(@@) % لأن اقتراب الذات قرب مسافة % % محال عليها فالتزم ذاك تعزيرا % % 5(@)(@@) % تباركت أنت الله في كل صورة % % كذا جاء في القرآن كبره تكبيرا % % 6(@)(@@) % وأنت شرعت الله أكبر من كذا % % فحير أهل الفكر قولك تحييرا % % 7(@)(@@) % لذاك ترى أهل الحقائق شمروا 
ms104	 % % ذيولهم عن أخذهم فيه تشميرا % % 8(@)(@@) % وأوله أهل العقول بفكرهم % % ولو سلموه مثلنا كان توفيرا % % 9(@)(@@) % لقد أطلق الله العليم مقالة % بزهراته فيها تدمره تدميرا % % PageV01P402 البحر : طويل 1(@)(@@) % تغيرت لما أن تغير لي المجرى % % لذا جئت شيئا خارقا عندكم أمرا % % 2(@)(@@) % فيا ليت شعري من يسير سيرنا % % إلى حضرة ذوقية شربها أمرا % % 3(@)(@@) % إذا رويت أكبادنا من شرابها % % وأحدث في الأكوان من شربها أمرا % % 4(@)(@@) % وصحت لنا في العالمين خلافة % % خلعت بها عن ذاته النهي والأمرا % % PageV01P403 البحر : مجزوء الخفيف 1(@)(@@) % إن قلبي وخاطري % % صيراني كما ترى % % 2(@)(@@) % أقطع الليل ساهرا % أهجر النوم والكرى % % 3(@)(@@) % وأنيسي من يعمر الس % % بيد لا يعمر القرى % % 4(@)(@@) % مذ تجلى لناظري % % في سماء وفي الثرى % % 5(@)(@@) % ما أرى غير سيدي % % دون شك ولا أمترا % % 6(@)(@@) % أعظم الناس فرية % من على ربه افترى % % 7(@)(@@) % أحضروه في كل ما % % يعلم الخلق أو يرى % % 8(@)(@@) % واحذروه فإنه % % عين من عينه يرى % % PageV01P404 البحر : سريع 1(@)(@@) % الحمد لله الذي صيرا % % وجودنا لفعله مظهرا % % 2(@)(@@) % لو أننا نعلم أرواحنا % % بالوجه في الصبح إذا أسفرا % % 3(@)(@@) % كما علمنا بالجسوم التي % % عينها الليل إذا أدبرا % % 4(@)(@@) % كنا به نعلم أعياننا % % لكن جهلناها لأمر طرا % % 5(@)(@@) % من ظلمة الطبع وأخلاطه % % فاعتم الليل وما أقمرا % % 6(@)(@@) % حين رمت بالرجم أرواح من % يسترق السمع كما أخبرا % % 7(@)(@@) % انظر إلى الأرض وخيراتها % % وما بها الرحمن قد أظهرا % % 8(@)(@@) % لا بد أن يصبح عمرانها % % كمثل ما أصبح وادي القرى % % 9(@)(@@) % عروشها خاوية حين لم % يغير الناس بها المنكرا % % 10(@)(@@) % عم بلاء الله سكانها % % فأهلك المقبل والمدبرا % % PageV01P405 11(@)(@@) % بذا أتانا النص من عنده % % في محكم الذكر كذا سطرا % % 12(@)(@@) % فقال فيه واتقوا فتنة % % وتمم القول به منظرا % % 13(@)(@@) % سبحان من أخبرنا أنه % % كان على الأخذ بنا أقدرا % % 14(@)(@@) % هذا الذي جئت به واضح % في سورة الأنفال قد حررا % % 15(@)(@@) % وبعد ذا ترجع أفكارها % % إلى أمام ما له من ورا % % 16(@)(@@) % لا فعل في العالم إلا له % فإن ما سميته 
ms105	 منكرا % % 17(@)(@@) % فحكمه ذلك لا عينه % فلتعتبر قولي حتى ترى % % 18(@)(@@) % به وإن شئت بأعياننا % % لتشهد الأسماء والمحضرا % % 19(@)(@@) % يبدو إليك الأمر من فصه % كما بدا لمن به أخبرا % % 20(@)(@@) % مثل رسول الله في وقته % والوارث المختار بين الورى % % PageV01P406 21(@)(@@) % فالحمد لله الذي قد وقى % % من شر ما يمكن أن يحذرا % % 22(@)(@@) % لولا كتاب سابق فيكم % نتبذتم لفعلكم بالعرا % % 23(@)(@@) % لما رأى عسكرها شمرا % % إلا لكي تعصمكم كالعرى % % 24(@)(@@) % لأنها أعصم ما يتقى % % لما بدا الرحمن قد قدرا % % 25(@)(@@) % تعوذوا منه به أسوة % بسيد يعلم ما قررا % % 26(@)(@@) % من يعرف الحق وأسراره % % يكن لما أذكره منكرا % % 27(@)(@@) % العمى لا تدرك أبصارنا % % إلا ظلاما وهي شيء يرى % % 28(@)(@@) % وليس يدري بالذي قلته % إلا الذي في غيبه أحضرا % % 29(@)(@@) % فالغيب لا يدركه غائب % % 30(@)(@@) % أوضحت أمرا ليس يدري به % إلا الذي في شأنه قد جرى % % PageV01P407 31(@)(@@) % أو سيد خص بأسراره % % مثل إمام نفسه قد درى % % 32(@)(@@) % يسري به قدما إلى ذاته % لا يعرف الخلف ولا القهقرى % % 33(@)(@@) % ما هو كالخنس في سيرها % % بل هو كالبدر الذي أزهرا % % 34(@)(@@) % أظهر عين الشمس في ذاته % وهو على ما هو لمن أبصرا % % PageV01P408 البحر : بسيط تام 1(@)(@@) % إن الفتى من يراعي حق خالقه % وثم حق رسول الله إيثارا % % 2(@)(@@) % والعارفون يرون الحق عينهم % ولا يرون بعين الحق أغيارا % % 3(@)(@@) % فهم يغارون أن يلقى بساحتهم % خيانة من نفو كن أغوارا % % 4(@)(@@) % فهم مع الله لا في حق أنفسهم % % لذا أقاموا من التنزيه أسوارا % % 5(@)(@@) % تنزيه تشبيه لا تنزيه ليس كذا % % بما أتاهم من الرحمن أخبارا % % 6(@)(@@) % يحكون ما قاله عن نفسه فإذا % % حكوه كانوا له جندا وأنصارا % % 7(@)(@@) % لا يعرفون سوى الرحمن من أحد % لم يألفوا فيه لا دارا ولا جارا % % 8(@)(@@) % لو أنهم وجدوا أمرا ينازعهم % % فيه لأدخلهم نزاعهم نارا % % 9(@)(@@) % ولم يكن مادح منهم له أبدا % بكل فن من الأمداح مكثارا % % 10(@)(@@) % هم الأقلون إن قلوا وإن كثروا % % حلاهم الحق أسرارا وأسرارا % % PageV01P409 البحر : بسيط تام 
ms106	 1(@)(@@) % إذا رأيت مسيئا يبتغي ضررا % فداره ثم لا تظهر له خبرا % % 2(@)(@@) % وادفع أذاه بما توليه من حسن % وامنن عليه ولا تعلم به بشرا % % 3(@)(@@) % فإن ذلك إكسير وقوته % إن تقلب العين والأجساد والصورا % % 4(@)(@@) % يرجع عدوك صديقا فتأمنه % ولا تخف منه إضرارا ولا ضررا % % 5(@)(@@) % وما يلقاها إلا صابر وله % % حظ من العلم لما أمعن النظرا % % PageV01P410 البحر : طويل 1(@)(@@) % ألا فاتبع من كان عبدا مخصصا % بعلم غريب لم ينل ذوقه خبرا % % 2(@)(@@) % ولا تعترض فيه عليه لأنه % % سيحدث في معناه منه لكم ذكرا % % 3(@)(@@) % ولا تك فيه موسويا فإنه % مع القول بالتعديل لم يستطع صبرا % % 4(@)(@@) % تزحزح ألباب الرجال إذا رأوا % % بأعينهم من غيرهم أحدثوا أمرا % % 5(@)(@@) % فينكرهم في الحين دينا وغيرة % % فيرهقها المتبوع من أمرها عسرا % % 6(@)(@@) % فإن عاد بالإعراض عنهم لنكرهم % تقيم له مما أتته به عذرا % % 7(@)(@@) % كذا سنة الرحمن في كل تابع % ومتبوعه فاحذر من العالم المكرا % % 8(@)(@@) % فمن يتق الله العليم بحاله % سيجعل له الرحمن من أمره يسرا % % 9(@)(@@) % ومن يتوكل في الأمور على الذي % % يكون بها أولى كما أنه يدرى % % 10(@)(@@) % وقد جعل الله العليم بأمره % لكل الذي يجريه في خلقه قدرا % % PageV01P411 11(@)(@@) % لقد جئتكم بالأمر من عند ربكم % كما جاءت الأرسال من عنده تترى % % 12(@)(@@) % وإني لهم في كل ما قلت وارث % ولم ألتمس منكم ثناء ولا أجرا % % 13(@)(@@) % وأجري على الله الكريم جعلته % % لديه إلى يوم الورود لنا ذخرا % % PageV01P412 البحر : بسيط تام 1(@)(@@) % إن الذي أظهر الأعيان لو ظهرا % % ما زاد حكما على الأمر الذي ظهرا % % 2(@)(@@) % هو الجلي الخفي في تصرفه % % فليس يظهر منه غير ما ظهرا % % 3(@)(@@) % مقدس الذات عن إدراك ما ظهرا % % لكنه يهب الأرواح والصورا % % 4(@)(@@) % فكل صورة روح عين صورته % % وهو الذي عين الأفلاك والبشرا % % 5(@)(@@) % من آدم خمرت يداه طينته % بذاك سمي في ما قد روى بشرا % % 6(@)(@@) % لما أتى من وراء الستر كلمني % % وما رأيت له عينا ولا خبرا % % 7(@)(@@) % علمت أن حجابي 
ms107	 لم يكن أحدا % غيري فلم أتعب الألباب والفكرا % % 8(@)(@@) % فما رأيت وجود الحق في أحد % % إلا رأيت له في كونه أثرا % % PageV01P413 البحر : بسيط تام 1(@)(@@) % من الحروف حروف هن كالعرض ال % % مجهول تغييره في سمعنا ظهرا % % 2(@)(@@) % تبدو لإشباعها في لفظ مشبعها % % حروف علتها بها الكلام جرى % % 3(@)(@@) % ضم وفتح وكسر للبناء أتت % أسماؤها وبهذا الحكم قد شهرا % % 4(@)(@@) % وثم رفع ونصب جاء بعدهما % % خفض لإعراب ما في لفظه ذكرا % % 5(@)(@@) % والجزم يذهبها مع السكون فلا % % تسمع لها منذ لفظ وارد خبرا % % 6(@)(@@) % وما تولد عنها حين تشبعها % % لكي يقضي منها اللافظ الوطرا % % 7(@)(@@) % كواو أو ياء أو ما جاء من ألف % % حروف مد ولين تشبه القدرا % % PageV01P414 البحر : بسيط تام 1(@)(@@) % الوحي بالشرع قد سدت مغالقه % وليس ينكر ذا إلا الذي كفرا % % 2(@)(@@) % لم يبق منه سوى الشخص يدركه % في نومه أو بكشف هكذا ظهرا % % 3(@)(@@) % وليس يدركه من غير صورته % إلا هنا ولهذا حاز من عبرا % % 4(@)(@@) % علما صحيحا من الرحمن بشره % به المهيمن في رؤياه إن شكرا % % 5(@)(@@) % وفيه مزج رقيق ليس يعرفه % إلا الذي يعرف الآيات والسورا % % 6(@)(@@) % فينزل الشيء في رؤياه منزلة % بآية فهي قرآن لمن نظرا % % 7(@)(@@) % في جمعها والذي تحويه من عبر % وحيا صحيحا لنا به القضاء جرى % % 8(@)(@@) % فاسلك طريقتنا إن كنت ذا نظر % ولاتعرج بنا إن كنت معتبرا % % 9(@)(@@) % قد يخطيء العابر الرؤيا يعبرها % % وقد يصيب كما رويته خبرا % % 10(@)(@@) % عن النبي رسول الله سيدنا % % فيما تأوله الصديق لو عثرا % % PageV01P415 11(@)(@@) % أصاب بعضا وأخطى بعضها وبذا % % أتى الحديث الذي رويته أثرا % % PageV01P416 البحر : بسيط تام 1(@)(@@) % العين واحدة والأمر واحدة % والكثر ما قام إلا بالذي أمرا % % 2(@)(@@) % والواحد الفرد قد قامت به نسب % % فصار من قيل فرد فيه قد كبرا % % 3(@)(@@) % لما تعددت الأسماء قيل لنا % % أين التوحد والتكثير قد شهرا % % 4(@)(@@) % وهذه نسب ولا وجود لها % % والحكم ليس لمعدوم وقد ظهرا % % PageV01P417 البحر : بسيط تام 1(@)(@@) % إن الحروف التي في الرقم تشهدها % % لها 
ms108	 معان وأسرار لمن نظرا % % 2(@)(@@) % فأول الأمر في مرقومنا ألف % واللفظ ينكره حرفا على ما ترى % % 3(@)(@@) % قال ابن حبان فيه في طريقته % بأنه نصف حرف هكذا ذكرا % % 4(@)(@@) % ونصفه همزة في عين كاتبها % % كذا رأيت له نصا وأين يرى % % 5(@)(@@) % كمثله في علوم أصل مأذخذها % % من جعفر وبهذا الفن قد شهرا % % 6(@)(@@) % واللفظ ينكر ما قد قال في ألف % % وما ابتغى جدلا ولا رآه مرا % % 7(@)(@@) % وإنه مذهبي إن كنت تبتغي % % لكنه ثبتها في الاعتبار قرا % % 8(@)(@@) % فيه جميع الذي قد صاد صائدكم % من الحروف لمن أعلمته قدرا % % 9(@)(@@) % فهمزة تقطع العشاق إن هجرت % % وإن في وصل من تهوى لها خبرا % % 10(@)(@@) % والباء تعمل في عقد النكاح إذا % % خطت على صفة قد ألبست حبرا % % PageV01P418 11(@)(@@) % والتاء تجمع شملا بالحبيب إذا % % محبوبه بان عنه أو نوى سفرا % % 12(@)(@@) % والثاء تثبت أحوال الرقيب إذا % % جاء الحبيب إليه بعد ما هجرا % % 13(@)(@@) % والجيم تعمل في أحوال منشئه % % حتما فتفرده إذا القضاء جرى % % 14(@)(@@) % والحاء تطلب بالتنزيه كاتبها % % يوما إذا صار تشبيه به وطرا % % 15(@)(@@) % جاءت إليك بأعيان الورى زمرا % % حتى يقضي منها الكاتب الوطرا % % 16(@)(@@) % والدال في كل ما ينويه فاعلة % له المضاء وجل الأمر أو صغرا % % 17(@)(@@) % والذال في حضرة الزلفى له قدم % فكلما رام تقديما يرى لورا % % 18(@)(@@) % والراء توصله وقتا وتفرحه % بكل ما يبتغي فزاحم القدرا % % 19(@)(@@) % وإن لاما إذا ما جاورت ألفا % كذا رأيناه في أعمالنا ظهرا % % 20(@)(@@) % والطاء تطلب تنفيذ الأمور له % % فانظر ترى عجبا إن كنت معتبرا % % PageV01P419 21(@)(@@) % والظاء تعطى حصول العبد في رتب % % تعنو الوجوه له والشمس والقمرا % % 22(@)(@@) % والكاف فيه لمهموم إذا كتبت % % تفريج كرب له في كل ما أمرا % % 23(@)(@@) % واللام درع له فيه يحصنه % % من كل سوء ومكروه من الأمرا % % 24(@)(@@) % والميم يروى به من كان ذا عطش % من العلوم بهذا القدر قد فخرا % % 25(@)(@@) % والنون تجري مع الأفلاك صورته % % لنيل صورة أنثى تشتهي ذكرا % % 26(@)(@@) % والصاد نور قوي في تشعشعه % بما 
ms109	 له منه في أحواله السرا % % 27(@)(@@) % والضاد كالصاد إلا أن منزله % % أدنى فتلحقه برتبة الوزرا % % 28(@)(@@) % والعين كالجيم إلا أن صورته % في الفعل أقوى ظهورا هكذا اعتبرا % % 29(@)(@@) % والغين كالعين إلا أن يقوم به % عين السحاب الذي لا يحمل المطرا % % 30(@)(@@) % والفاء كالباء في التصريف وهي به % أتم فعلا فقد جلت عن النظرا % % PageV01P420 31(@)(@@) % والقاف تعمل في الضدين إن كتبت % غربا وشرقا فكن للحال مدكرا % % 32(@)(@@) % والسين تعصم من سوء تخيله % % نفس الضعيف إذا شخص بذاك زرى % % PageV01P421 البحر : مجزوء الرجز 1(@)(@@) % ما نظرت عيني إلى % % شيء تراه فأرى % % 2(@)(@@) % إلا الذي قال لنا % % بأنه الخلق برى % % 3(@)(@@) % قلت فمن قيل لنا % % من المياه والثرى % % 4(@)(@@) % فليس في الكون الذي % % تراه من غير يرى % % 5(@)(@@) % سواه فانظر عجبا % يدري به من قد درى % % 6(@)(@@) % إن الوجود واحد % في عينه دون امترا % % 7(@)(@@) % وكل من قال به % % في حقه فما افترى % % 8(@)(@@) % فنحن فيه كلنا % % كأصيد في جوف الفرا % % 9(@)(@@) % والجوف منه فارغ % والحق ما فيه مرا % % 10(@)(@@) % قد قلن ما ذا بشرا % بل ملكا فيما نرى % % PageV01P422 11(@)(@@) % ولم يكن بملك % % ما كان إلا بشرا % % 12(@)(@@) % فهكذا أمر الإل % % ه في الوجود والورى % % PageV01P423 البحر : مجزوء الرجز 1(@)(@@) % شغلي بمن شرع لي الش % % غل به فحيرا % % 2(@)(@@) % خاطبني بأنني % % عبد له وما نرى % % 3(@)(@@) % لعينه من شاهد % % إلا العمى والأثرا % % 4(@)(@@) % وقال لي إن الذي % % تراه قد ظهرا % % 5(@)(@@) % ولولاك يا رب الورى % % ما كنت إلا الورى % % 6(@)(@@) % مثل الذي قال لنا % % من صحة قد انبرى % % 7(@)(@@) % ميراثنا من أحمد % خير الأنام والورى % % 8(@)(@@) % خير إمام طاهر % سليل أعراف الثرى % % 9(@)(@@) % صلى عليه الله من % % خليفة قد ظهرا % % 10(@)(@@) % بكل ما أمله % % من ربه ما افتخرا % % PageV01P424 11(@)(@@) % لأنه عبد وما % % للعبد أن يفتخرا % % 12(@)(@@) % إلا بمن كونه % % عبدا له فاشتهرا % % 13(@)(@@) % أنا الذي قلت أنا % % لذا يقينا خبرا % % 14(@)(@@) % لو أنني قلت أنا % % به رأينا عبرا % % 15(@)(@@) % فاحمد وزد في شكره % يزدكم ما 
ms110	 ذكرا % % 16(@)(@@) % في محكم الذكر لنا % % لشاكر إن شكرا % % PageV01P425 البحر : مخلع البسيط 1(@)(@@) % الحمد لله حمد من لم % يجد جزاء ولا شكورا % % 2(@)(@@) % وإنما العبد قيل له قل % % فقال ما قاله خبيرا % % 3(@)(@@) % بانه فيه عبد قن % ممتثلا امره الكثيرا % % 4(@)(@@) % لم يتخذ دونه وليا % في حمده لا ولا نصيرا % % 5(@)(@@) % من علم الحق علم ذوق % يعلمه ناقدا بصيرا % % 6(@)(@@) % من حكم العلم في هواه % % كان على نفسه قديرا % % 7(@)(@@) % يعرفه كل من رآه % بنعته سيدا حصورا % % PageV01P426 البحر : مجتث 1(@)(@@) % حسنت ظني بربي % % فاعقب الظن خيرا % % 2(@)(@@) % أعطاني الظن فيه % خيرا كثيرا وميرا % % 3(@)(@@) % به تعودت شرعا % من رده الكور حورا % % 4(@)(@@) % فأسرع الخير نحوي % % سيرا حثيثا فسيرا % % PageV01P427 البحر : بسيط تام 1(@)(@@) % هذا الذي قلته في الله من صفة % الله جاء به في الذكر مسطورا % % 2(@)(@@) % على لسان رسول سيد ندس % إذ طهر الله أهل البيت تطهيرا % % 3(@)(@@) % فلم ينلهم لذا في عرضهم دنس % إذ شمروا ذيلهم للنصر تشميرا % % PageV01P428 البحر : بسيط تام 1(@)(@@) % السر ما بين إقرار وإنكار % في المشتري وهم المدلج الساري % % 2(@)(@@) % لم لا يقول وقد أودعت سرهما % % أنا المعلم للأرواح أسراري % % 3(@)(@@) % أنا المكلم من نار حجبت بها % % نورا فخاطبت ذات النور في النار % 4(@)(@@) % أنا الذي أوجد الأكوان مظلمة % ولو أشاء لكانت ذات أنوار % % 5(@)(@@) % أنا الذي أوجد الأسرار في شج % مجموعة لم ينلها بوس أغيار % 6(@)(@@) % يا ضاربا بعصاه صلد رابية % % شمس وبدر وأرض ذات أحجار % % 7(@)(@@) % فاعجب إلى شجر قاص على حجر % وانظر إلى ضارب من خلف أستار % % 8(@)(@@) % لقد ظهرت فما تخفى على أحد % إلا على أحد لا يعرف الباري % % 9(@)(@@) % قطعت شرقا وغربا كي أنالهم % على نجائب في ليل وأسحار % 10(@)(@@) % فلم أجدكم ولم أسمع لكم خبرا % وكيف تسمع أذن خلف أسوار % % PageV01P429 11(@)(@@) % أم كيف أدرك من لا شيء يدركه % لقد جهلتك إذ جاوزت مقداري % % 12(@)(@@) % حجبت نفسك في إيجاد آنية % % فأنت كالسر في روح ابنة القاري % % 13(@)(@@) % أنت الوحيد الذي ضاق 
ms111	 الزمان به % % أنت المنزه عن كون وأقطار % % PageV01P430 البحر : خفيف تام 1(@)(@@) % يا هلال الدياج لح بالنهار % فلقد أنت نزهة الأبصار % 2(@)(@@) % أنت محو وأنت في العين بدر % بتجليك في الضياء المحار % 3(@)(@@) % فإذا ما بدا هلال المعاني % % طالعا من حديقة الأبصار % % 4(@)(@@) % قل له بالتواضع المتعالي % % لا بنفس الدعاء والإنكار % 5(@)(@@) % يا هلال بين الجوانح سار % لا تفارق حنادس الأغيار % % 6(@)(@@) % كن عبيدا بقصرها ومليكا % بعد محوينا لكم في السرار % 7(@)(@@) % حكمة قد تحير الخلق فيها % % وسراجان أسرجا بنهار % 8(@)(@@) % عجبا في سناهما كيف لاحا % % وسناء الشمس مذهب الأنوار % % 9(@)(@@) % كل نور في كل قلب محار % ما عدا قلت وارث المختار % 10(@)(@@) % فاشكر الله يا أخي على ما % % وهبته نتائج الأذكار % PageV01P431 البحر : خفيف تام 1(@)(@@) % هزم النور عسكر الأسحار % فأتى الليل طالبا للنهار % 2(@)(@@) % فمضى هاربا فرار خداع % والتوى راجعا على الأسحار % PageV01P432 البحر : بسيط تام 1(@)(@@) % إن اللسان رسول القلب للبشر % بما قد أودعه الرحمن من درر % 2(@)(@@) % فيرتدي الصدق أحيانا على حذر % % ويرتدي المين أحيانا على خطر % 3(@)(@@) % كلاهما علم في رأسه لهب % % لا يعقل الحكم فيه غير معتبر % 4(@)(@@) % وانظر إلى صادق طابت موارده % % وكاذب رائح غاد على سفر % % 5(@)(@@) % مع اتحادهما والكيف مجهلة % من سائل كيف حكم الحق في البشر % PageV01P433 البحر : منسرح 1(@)(@@) % كيف يكون الخلاف في بشر % تميزوا في العلى عن البشر % % 2(@)(@@) % فهم ذوو رحمة ذوو نظر % % مسدد في تخالف الصور % 3(@)(@@) % ونعمة لا تزال تصحبهم % ليسوا ذوي مرية ولا ضرر % % PageV01P434 البحر : كامل تام 1(@)(@@) % إن الغمام مطارح الأنوار % ولذاك أضحى أقرب الأستار % 2(@)(@@) % منه تفجرت العلوم على النهى % % وبه يكون الكشف للأبصار % 3(@)(@@) % فيه البروق وليس يذهب ضوؤها % % أبصارنا لتقدس الأبصار % % 4(@)(@@) % فيه الرعود وليس يذهب صوتها % % أسماعنا لتنزه الأسرار % 5(@)(@@) % فيه الصواعق ليس يذهب رسمنا % % إحراقها لعناية الآثار % % 6(@)(@@) % فيه الغيوم وليس يهلك سيلها % % أشجارنا لتحقق الإيثار % 7(@)(@@) % ما بعده شيء سوى مطلوبنا % % رب الأنام مع اسمه الغفار % 8(@)(@@) % فإذا انجلى ذاك الغمام 
ms112	 فذاته % % تبدو إلى الأنوار في الأنوار % % 9(@)(@@) % والنور يدرج مثله في ضوئه % % كالشمس لا تفني ضياء النار % % 10(@)(@@) % فترى البصائر والعيون جلاله % % وجماله في الشمس والأقمار % PageV01P435 11(@)(@@) % فافهم إشارتنا تفز بحقائق % % تخفى على العقلاء والنظار % PageV01P436 البحر : كامل تام 1(@)(@@) % هذي المنازل والفؤاد الساري % % فيها بحكم تصرف الأقدار % % 2(@)(@@) % دارت به الأفلاك في فسحاتها % % والكون في الأدوار بالأكوار % 3(@)(@@) % فإذا تحل بمنزل تهفو له % % شوقا إليه مطارح الأنوار % % 4(@)(@@) % فيمدها بالفيض في غسق الدجى % % حتى يشمر عسكر الأسحار % 5(@)(@@) % للانتقال من البسيطة قاصدا % جهة اليمين ومغرب الأسرار % 6(@)(@@) % ويحل إرديس العلي بوحه % في أثر ذاك العسكر الجرار % 7(@)(@@) % يخفى على عين المشاهد نوره % % كالشمس تنفي سطوة الأقمار % 8(@)(@@) % فالزمهرير مع الأثير تحكما % % بالبرد والتسخين في الأطوار % % PageV01P437 البحر : رجز تام 1(@)(@@) % يحكم كر الليل والنهار % على شخوص مزجة الأطوار % 2(@)(@@) % مثل التراب اليابس الثريار % % والمار والهواء ثم النار % 3(@)(@@) % بالإستحالات وبالتكوين % وبتناهي مدة الأعمار % 4(@)(@@) % وذاك بالأمر العزيز العالي % % أمر الإله الواحد القهار % PageV01P438 البحر : منسرح 1(@)(@@) % يطوف بالبيت من يدين له % لكنه خارج عن البشر % 2(@)(@@) % كأنه في طوافه جمل % يخبط لا يلتوي على الحجر % % 3(@)(@@) % مثل حنين وقد رآه فتى % من أعلم الناس من بني عمر % % 4(@)(@@) % فقال هذا الذي أقول به % % في حق هذا الأنيس فازدجر % 5(@)(@@) % لكنني قد وجدت معذرة % % كان عليها في سالف العمر % % 6(@)(@@) % كان له مقطع يطوف به % % ومن أتى عادة فلم يمر % % PageV01P439 البحر : بسيط تام 1(@)(@@) % ألبست من هو ذاتي خرقة الخضر % ما بين زمزم والركنين والحجر % 2(@)(@@) % على التزين بالمرضي من صفة % محمودة بين أهل الشرع والنظر % 3(@)(@@) % ولا تزال مع الأنفاس قائمة % به إلى منتهى الأوقات والعمر % 4(@)(@@) % وما تحللها من سيء فلنا % % عليه شرط صحيح جاء في الخبر % % PageV01P440 البحر : بسيط تام 1(@)(@@) % لما تأدبت بي يا منتهى ألمي % % وأحسن الناس في المعنى وفي الصور % 2(@)(@@) % وكان قد ملكت قلبي محاسنها % % خبرا محققه يربى على الخبر % 3(@)(@@) % ألبستها من سنى الأثواب ثوب تقى 
ms113	 % فخرا على جنسها من خرقة الخضر % 4(@)(@@) % وهي التأدب بالآداب أجمعها % % مع التخلق بالآيات والسور % 5(@)(@@) % والعهد ما بيننا أن لا تبوح بها % % ولا تعرفها شخصا من البشر % 6(@)(@@) % لكي تكون من الإخلاص نشأتها % % فليس يلحقها شيء من الغير % PageV01P441 البحر : بسيط تام 1(@)(@@) % ألبست جارية ثوبا من الخفر % في النوم ما بين باب البيت والحجر % 2(@)(@@) % وقبلته فقبلنا مقبلها % % وغبت فيه عن الإحساس بالبشر % 3(@)(@@) % واستصرخت في نيات الطواف وفد % حسرن عن أوجه من أحسن الصور % 4(@)(@@) % هذا إمام نبيل بين أظهرنا % % هذا قتيل الهوى واللثم والنظر % 5(@)(@@) % قالت لها قبليه الأم ثانية % عساه يحيى كمثل النفخ في الصور % % 6(@)(@@) % فالنفخ يخرج أرواح الورى وبه % يحيى إذا دعيت للنشر من حفر % % 7(@)(@@) % فعاودت فأزالت حكم غاشيتي % % وأدبرت وأنا منها على الأثر % 8(@)(@@) % أقبل الأرض إجلالا لوطأتها % % حباله وأنا منه على حذر % 9(@)(@@) % من أجل تقييده بصورة امرأة % عند التجلي فقلت النقص من بصري % % 10(@)(@@) % ونسوة كنجوم في مطالعها % % وأنت منهن عين الشمس والقمر % PageV01P442 11(@)(@@) % يا حسنها غادة كالشمس طالعة % تسبي العقول بذاك الغنج والحور % PageV01P443 البحر : بسيط تام 1(@)(@@) % لما شهدت الذي في الكون من صور % عين الذي كنت أبغيه بلا صور % 2(@)(@@) % علمت أن الذي أبغيه يطلبني % % بالعلم بي لا به فانهض على أثري % % 3(@)(@@) % ترى الذي قد رأينا من منازله % % في كل آية تنزيه من السور % 4(@)(@@) % وكل آية تشبيه ومحكمة % تتلى علينا من المكتوب في الزبر % % 5(@)(@@) % ومطلب الحق منا أن نوحده % % ربا كما هو في القرآن والنظر % 6(@)(@@) % ما مطلب الحق منا أن نكيفه % حتى نراه بمجلى الشمس والقمر % 7(@)(@@) % ولا تفكرت فيه ما بقيت ولا % % يزال من فكره عقلي على غرر % 8(@)(@@) % في آل عمران جاء النص يطلبني % % بما لديه من التخويف والخدر % % 9(@)(@@) % وذاك عن رأفة منه بنا ولذا % % يتلى علينا مع الآصال والبكر % 10(@)(@@) % الليل لله لا لي والنهار معا % لأنه الدهر فانظر فيه واعتبر % % PageV01P444 11(@)(@@) % لا تعتبر نفسه إن كنت ذا نظر % مسدد 
ms114	 ولتكن تمشي على قدر % 12(@)(@@) % إن المعارج والإسرا إليه به % على البراق الذي أنشأت من فكري % % 13(@)(@@) % حتى انتهيت إلى ماشاءه وقضى % % تركته وامتطينا رفرف الدرر % 14(@)(@@) % عند التفاتي به إذ كان ينزل بي % % إلى السماء يناجيني إلى السحر % 15(@)(@@) % ودعته ثم سرنا حيث قال لنا % % إذا به عن يميني طالبا أثري % % 16(@)(@@) % لما تأملته لم أدر صورته % % وعلمنا أنه هو غاية الخطر % 17(@)(@@) % غفلت عنه له إذ كان مقصده % مني التغافل بالتحويل في الصور % 18(@)(@@) % لأنه عالم أني أميزه % % لما تكفلني من حالة الصغر % 19(@)(@@) % له ولدت لهذا ما برحت له % % مشاهدا ناظرا فيه إلى كبري % % 20(@)(@@) % لذاك أخبرنا بأنه معنا % % على مكانتنا في بدو أو حضر % PageV01P445 البحر : بسيط تام 1(@)(@@) % رأيت بارقة كالنجم لامعة % بسقف بيتي على قرب من السحر % 2(@)(@@) % علمتها عين من أهوى تعرفني % % بما أنا منه في ورد وفي صدر % 3(@)(@@) % وكنت في حاضر الأبصار أرقبه % % لحادث كان لي فيهم من الخبر % % 4(@)(@@) % على لسان الذي ظني به حسن % يحيا الفؤاد بذاكره وبالنظر % 5(@)(@@) % عن الرسول رسول الله سيدنا % % المصطفى المجتبى المختار من مضر % 6(@)(@@) % فقلت أعرفكم حالا وأشهدكم % % عينا وأظهركم لأعين البشر % 7(@)(@@) % لأنهم جهلوا ما نحن نعلمه % من التجلي الذي لله في الصور % 8(@)(@@) % ما قلت فيكم ولا فهنا بذكركم % إلا بما جاء في الآيات والسور % 9(@)(@@) % أتلو وأسرد آيات علمت بها % % في شأنكم عنكم ما قلت عن نظر % 10(@)(@@) % ما لي التحكم في نفسي فكيف لنا % % فيه التحكم والرامي على خطر % PageV01P446 11(@)(@@) % من أن يصيب به من لا يجوز له % % فيه التصرف إلا حالة الضرر % 12(@)(@@) % مثل النبي الذي يوحى إليه به % % لكي يبلغه للسمع والبصر % PageV01P447 البحر : بسيط تام 1(@)(@@) % بالشم أدرك أحيانا وبالنظر % ما ليس يدركه غيري من النظر % 2(@)(@@) % ولست منه بلا شك على خطر % مثل المقلد للمعصوم في الخبر % 3(@)(@@) % من حاله الشم أعلى منه منزلة % % أعني المقلد لا الإدراك بالنظر % % 4(@)(@@) % للذوق أخذ شريف لا يكيفه % % في فعله 
ms115	 غير أهل الضرب والبصر % 5(@)(@@) % وليس يعرف من ذوق بجارحة % مذاق جارحة أخرى أبو البشر % % PageV01P448 البحر : بسيط تام 1(@)(@@) % استغفر الله من علم أفوه به % فإن قائله منهم على خطر % 2(@)(@@) % وهو الصحيح الذي لا شك يدخلني % % فيه ولكنني منه على حذر % % 3(@)(@@) % وقد أتيت به لحكمة حكمت % علي فيه على ما جاء في القدر % % 4(@)(@@) % من العلوم التي قد عز طالبها % % ولم ينلها لما في الأمر عن غرر % 5(@)(@@) % لولا وراثتنا خير الأنام لما % % حصلتها السيد المختار من مضر % 6(@)(@@) % وهو العليم بها من ضربة حصلت % له من الله ذي الآلاء في السمر % 7(@)(@@) % فاسمع فديتك إني قد عزمت على % % إبراز ما كان في الأصداف من درر % % 8(@)(@@) % إن قيل ما سبب التكبير والغير % فقل له ذاك مجلى الحق في الصور % 9(@)(@@) % فما ترى العين إلا واحدا أبدا % والكبر جاء من الإحكام في النظر % 10(@)(@@) % إن الوجود على الإيهام نشأته % مثل الشهادة حال الذر في الفطر % PageV01P449 11(@)(@@) % والحكم مني بهذا القول صورته % % ما قلته وكذا المشهود بالبصر % 12(@)(@@) % الغيب لله لا الأبصار تدركه % % وما ترى العين يكنى عنه بالبشر % 13(@)(@@) % من كل نجم وأفلاك يدور بها % % وما يولده من هذه الأكر % % 14(@)(@@) % إن لم تحققه برهانا ومعرفة % كما هو الأمر فاقنع فيه بالخبر % % 15(@)(@@) % من ذائق لم يقل ما قال عن نظر % ولا قياس ولا حدس ولا ضرر % % 16(@)(@@) % إن الوجود وجود الحق ليس له % فيه شريك كما قد جاء في الأثر % 17(@)(@@) % وأين مثل رسول الله سيدنا % % فيما يقال ففكر فيه واعتبر % % 18(@)(@@) % فيما يقول لبيد في جهالته % وليس يدري الذي قد قال فادكر % 19(@)(@@) % فإن ذا فطنة مثلي مخلفة % ترى الحقائق تأتيها على قدر % % 20(@)(@@) % ولا تقل إن ذا وهم وسفسطة % % القول ما قلته فانهض على أثري % % PageV01P450 21(@)(@@) % والله لولا شهود الحق ما نظرت % % عيني إلى أحد من عالم الغير % % 22(@)(@@) % إني يتمية دهري ما لها شبه % من الفرائد في نجر ولا بحر % % PageV01P451 البحر : سريع 1(@)(@@) % يا 
ms116	 أيها المشغوف بالذكر % % في حالة الإشفاع والوتر % 2(@)(@@) % لو كنت لي في عالم الخلق % لكنت لي في عالم الأمر % 3(@)(@@) % إن ضاق ظرف الدهر عن عينكم % % فلم يضق عن عينكم صدري % % 4(@)(@@) % ما أوسع القلب إذ آمنت % % جوارحي بكل ما يجري % % 5(@)(@@) % لم أدر أن للقلب ظرف لكم % % لولا الذي أخبرني سري % % 6(@)(@@) % عند تجليه لنا طالبا % في ليلة يعطى إلى الفجر % 7(@)(@@) % أنت الذي أخبرتني بالذي % % فهمت به في السر والجهر % % 8(@)(@@) % على لسان السيد المصطفى % % الطيب الأسلاف من فهر % 9(@)(@@) % ما جئتكم بالأمر من خارج % بل جئتكم بالأمر من بحر % 10(@)(@@) % تلتطم الأمواج فيه كما % % تأتي به الأنفاس في الذكر % PageV01P452 11(@)(@@) % فإن ذكرتم فاذكروه بما % % تلاه في القرآن ذي الذكر % % 12(@)(@@) % لا تذكروه بالذي تنظروا % % فالفرع يعطى قوة النجر % % 13(@)(@@) % ذكرته يوما على غفلة % بغير ما قلب من الأمر % 14(@)(@@) % فلم أجد عند مذاق الجنى % % طعم الذي أعلم بالخبر % % 15(@)(@@) % وجدته كالمن في طعمه % % والفارق الواضح بالسكر % 16(@)(@@) % بالصحو يأتي ذكره دائما % والقبض والبرد مع الوفر % 17(@)(@@) % والذكر من عندي على ضده % % يأتيك بالسكر وبالحر % 18(@)(@@) % فذكره ما بين أذكارنا % % بين الليالي ليلة القدر % 19(@)(@@) % سبحان من صيرني عالما % من بعد ما قد كنت كالغمر % % PageV01P453 البحر : طويل 1(@)(@@) % توهمت من أهواه خارج صورتي % % فقدرته في القرب بالباع والشبر % 2(@)(@@) % فيحيي فؤادي بالوصال وباللقا % % ويقتلني بالصد منه وبالهجر % 3(@)(@@) % يجرد عن غصن قويم وعن نقا % % ويبسم عن در ويسفر عن بدر % 4(@)(@@) % ويجري لنا نهرا من الضرع طيبا % ومن عسل أصفى وماء ومن خمر % 5(@)(@@) % يمد به كوني لأني من أربع % خلقت بها في النشأتين بلا أمر % % 6(@)(@@) % مع الأمر بالتكوين في كل حالة % ولا أدر معناه ولا أدر أدري % % 7(@)(@@) % أتيت إليه من طريق ذلولة % مسهلة لكن على مركب وعر % % 8(@)(@@) % بنقر بأوتار بأيدي كواعب % يملن علينا من هوى لا من السكر % % 9(@)(@@) % فلما تأملنا وجدنا وجودنا % % بأسمائه الحسنى فقمت بها أجري % % 10(@)(@@) % إلى عالم الأكوان أخبرهم بها 
ms117	 % % كما أخبر الرحمن في محكم الذكر % % PageV01P454 البحر : بسيط تام 1(@)(@@) % لا تعجلن فإن الأمر حاصله % % إليك مرجعه فانهض على قدر % 2(@)(@@) % واسلك سبيل إمام جل مقصده % % مصدق في الذي قد جاء من خبر % % 3(@)(@@) % وخذ به خلفه في الحال مقتديا % واركن إليه ولا تركن إلى النظر % 4(@)(@@) % واعلم بأن ذوي الأفكار في عمه % فكن من الفكر يا هذا على حذر % 5(@)(@@) % والعقل ليس له تقبيح ما قبحت % صفاته وله في التحكيم في العبر % 6(@)(@@) % وما له ذلك التحكيم في عبر % إلا إذا كان في التحكيم ذا بصر % % 7(@)(@@) % وليس يعرف سر الله في القدر % % إلا الذي علم الأعيان بالأثر % 8(@)(@@) % وما رأى أثر الأسماء في أحد % فقال في قبتيها هم على خطر % % 9(@)(@@) % لا نعت أشرف من علم يفوز به % % يقول من فاته يا خيبة العمر % 10(@)(@@) % يمشي به آمنا فالعلم محفظة % لمن يحصله من وقعة الغرر % PageV01P455 البحر : طويل 1(@)(@@) % ألا إنني أرجو عوارف فضل من % يكون له التحميد في اليسر والعسر % 2(@)(@@) % فإن كان عسر أطلق العبد حمده % % على كل حال منه في نفع أو ضر % 3(@)(@@) % وإن كان يسر قيد العبد حمده % % كما جاء في الأنعام والفضل في اليسر % 4(@)(@@) % بذا جاءت الأخبار في حمد سيد % رسول إمام مصطفى صادق بر % 5(@)(@@) % معلم أسباب السعادة كلها % % لكل لبيب عاقل ماجد حر % 6(@)(@@) % أنا أسوة فيه كما قال ربنا % % تلوناه في الأحزاب في محكم الذكر % % 7(@)(@@) % وفي غيرها فاعلم بأنك مقتد % به متأس مؤمن بالذي يجري % % 8(@)(@@) % نصحتك يا نفسي على كل حالة % % فقومي له فيها على قدم الشكر % % 9(@)(@@) % فإن الذي يدعى عن الخلق في غنى % % ونحن على ما نحن من حالة الفقر % % 10(@)(@@) % ولي منه في الأحوال صحو وسكرة % إذا ما بدا لي في تجل وفي ستر % PageV01P456 11(@)(@@) % فأصبحوا إذا عم التجلي وجوده % وإن خصه بالذات إني لفي سكر % % 12(@)(@@) % يخاطبني من كل ذات عناية % % بما شاءه في كل نظم وفي نثر % % 13(@)(@@) % فنثري الذي يدريه ما 
ms118	 هو من نثري % % وشعري الذي أبديه ما هو من شعري % % 14(@)(@@) % هويته من كل شيء وجوده % % وصحت به الآثار فانهض على أثري % % 15(@)(@@) % ترى الحق حقا فاتبعه ولا تقل % % إذا ما رأيت الحق إني في خسر % 16(@)(@@) % فما الناس إلا بين هاد ومهتد % فمنهم إلى شام ومنهم إلى مصر % 17(@)(@@) % وهذي إشارات لمن كان عالما % بما قلته في السر كان أو الجهر % 18(@)(@@) % إلهي لا تعدل بقلبي عن الذي % % شرعت من الإيمان بالنهي والأمر % % 19(@)(@@) % فما عندكم إلا وجود محقق % وما عندنا إلا التبري من الكفر % % 20(@)(@@) % لقد قرر الإيمان عندي حقائقا % تنافي براهين النهي من ذوي الفكر % PageV01P457 21(@)(@@) % فحزت به كشفا فعادت معارفا % مطالعها في القلب كالأنجم الزهر % 22(@)(@@) % فلا ريب عندي في الذي قد طعمته % % من العلم بالله المقرر في صدري % % 23(@)(@@) % حييت به علما وعقدا وحالة % % هنا في حياتي ثم موتي وفي النشر % % 24(@)(@@) % لقيت به ربا كريما بحضرة % منزهة علياء ماطرة النثر % % PageV01P458 البحر : طويل 1(@)(@@) % رأيت ذكورا في إناث سواجر % ترآأين لي ما بين سلع وحاجر % 2(@)(@@) % فخاطبت ذكرانا لأني رأيتهم % رجالا بكشف صادق متواتر % 3(@)(@@) % وكن إناثا قد حملن حقائقا % من الروح القاء لسورة غافر % % 4(@)(@@) % وبعلهم الروح الذي قد ذكرته % وأنهم ما بين ناه وآمر % 5(@)(@@) % هم العارفون الصم ردما ولا تقل % % بأن الذي قد جاء ليس بخابر % 6(@)(@@) % وما خص نوعا دون نوع لأنه % رأى الأمر يسري في صغير وكابر % % 7(@)(@@) % ولا تمتر فيما أقول فإنني % % وقفت على علم من البحر زاخر % 8(@)(@@) % تحسينه ماء فراتا وإنه % % لملح أجاج في السنين المواطر % 9(@)(@@) % فمن كان ذا فكر تراه محيرا % ومن كان ذا شرع فليس بحائر % % 10(@)(@@) % تمنيت أن أحظى برؤية مؤمن % صدوق من الفتيان ليس بكافر % PageV01P459 11(@)(@@) % وذاك الذي يأتي بصورة تاجر % % ملي من الأرباح ليس بخاسر % % 12(@)(@@) % فلم أر إلا خالعا ثوب ماجن % ولم أر لابسا زي شاطر % % 13(@)(@@) % تنوعت الأشياء والأمر واحد % وما غائب في الأخذ عنه كحاضر % % 14(@)(@@) % إذا صح 
ms119	 غيب الغيب ما لأمر حاضر % % يشاهده قلبي وعقلي وناظري % % 15(@)(@@) % تناولته منه على حين غفلة % من الكون لم يشعر به غير شاعر % 16(@)(@@) % فنظمته فيه مديحا منزها % ونثرا علا قدرا على كل ناثر % % PageV01P460 البحر : طويل 1(@)(@@) % إذا كانت الأشياء تبدو عن الأمر % % تساوى الدني الأصل والطيب النجر % 2(@)(@@) % لقد ضربوه قاطعين بأنه % إذا ضربوه لا يقوم من القر % % 3(@)(@@) % فأنطقه للقوم ثم أعاده % % إلى الحالة الأولى إلى مطلع الفجر % % 4(@)(@@) % كما سبح الحصباء في كف سيد % وأصحابه الأعلام كالأنجم الزهر % % 5(@)(@@) % فما كانت الآيات إلا سماعهم % % وهذا الذي قد جاء ضرب من النثر % 6(@)(@@) % وكل له حال ووقت معين % فحال إلى كشف ووقت إلى ستر % % 7(@)(@@) % فما كان من شام يراه ممثلا % فيبصره حيا إذا كان من مصر % 8(@)(@@) % وجاء الذي مثلي غريبا مقررا % يقول الذي قالاه ما فيه من نكر % 9(@)(@@) % فمن شاء فليكفر ومن شاء فليقل % بأني على حق يقين من الأمر % % 10(@)(@@) % لقوة إيماني بما قال خالقي % % وصدقي الذي قد قرر الله في صدري % % PageV01P461 البحر : طويل 1(@)(@@) % شهدت الذي تدعونه الغوث والذي % % له الملك بعد الغوث والغوث لا يدري % % 2(@)(@@) % بما هو غوث ثم إن كان عالما % به فاختصاص جاء في ليله يسري % % 3(@)(@@) % تبارك ملك الملك جل جلاله % وعز فلم يدرك بفكر ولا ذكر % 4(@)(@@) % تعالى عن الأمثال علو مكانة % تبارك حتى ضمه القلب في صدري % % 5(@)(@@) % ولم أدر ما هذا ولا ينجلي لنا % % مقالته فيه وبالشفع والوتر % 6(@)(@@) % عرفناه لما أن تلونا كتابه % % فللجهر ذاك الوتر والشفع للسر % 7(@)(@@) % وما عجبي من ماء مزن وإنما % % عجبت لماء سال من يابس الصخر % % 8(@)(@@) % كضربة موسى بالعصا الحجر الذي % % تفجر ماء في أناس له تجري % % 9(@)(@@) % وكل أناس شربه عالم به % % يميزه ذوقا وإن حل في النهر % % PageV01P462 البحر : طويل 1(@)(@@) % حنيني إلى الليل الذي جاءني يسري % % حينيني إلى الشمس المنيرة والفجر % 2(@)(@@) % فإني أحظى في النهار بشفعه % وأحظى إذا ما جاء في الليل بالوتر % 3(@)(@@) % لقد أقسم 
ms120	 الحق العلي بليله % وبالفجر والإتباع فيه لذي حجر % 4(@)(@@) % بأن الذي قد جاء في الذكر ذكره % مضافا إلينا ما له الأنس بالأجر % % 5(@)(@@) % إذا كنت في قوم ولم أك عينهم % % وسرهم سري وجهرهم جهري % % 6(@)(@@) % فما أنا فيهم ذو وفاء وإنني % % إذا حقق الأقوام شاني لفي خسر % % PageV01P463 البحر : وافر تام 1(@)(@@) % أرى الأنوار في شرح الصدور % عيانا في الورود وفي الصدور % 2(@)(@@) % وليس له امتنان فيه أني % % أرى أثر الأمور من الأمور % 3(@)(@@) % فإن الحكم للمعلوم عقلا % وكشفا في الجنان وفي السعير % 4(@)(@@) % فحكم الشيء مقصور عليه % % وما أداه ذاك إلى القصور % 5(@)(@@) % ولكن الأديب إذا رآه % يقول بذاك من خلف الستور % 6(@)(@@) % ويدخل محرما بلدا حراما % ويلبس للملابس ثوب زور % % 7(@)(@@) % فيأخذه العليم بما ذكرنا % % ويوصله إلى دهر الدهور % 8(@)(@@) % لقد دلت شواهده عليه % % بما دارت عليه رحى السرور % PageV01P464 البحر : طويل 1(@)(@@) % أرى ليلة القدر المعظم قدرها % % ترفع مني في الشهود ومن قدري % % 2(@)(@@) % وذلك شطر الدهر عندي لأنها % % تكون بما فيها إلى مطلع الفجر % % 3(@)(@@) % ترحل عني تبتغي عين موجدي % % وقد سترت أمري وقد شرحت صدري % % PageV01P465 البحر : طويل 1(@)(@@) % إذا طلعت شمس الفناء الذي حجى % % أكور بها حقا إذا هو لم يكر % % 2(@)(@@) % بكوني إذا ما كنت خلعا فإنه % % نزيه عن أحكام تكون عن الأكر % % 3(@)(@@) % إذا كان قد جاء الحديث بأنه % لأجل اختلاف الاعتقادات ذو غير % % 4(@)(@@) % ولكنه بالذات عند أولي النهى % % غني بنص الذكر في محكم السور % PageV01P466 البحر : بسيط تام 1(@)(@@) % إن التحكم في الأشياء للقدر إن التحكم في الأشياء للقدر % % وإن فيه مجال الفكر والعبر % % 2(@)(@@) % وقل به إنه على تحكمه % % لا حكم فيه على الأرواح والصور % 3(@)(@@) % إلا بأعيانها فاعلم طريقة % الحكم فيها لها إن كنت ذا نظر % PageV01P467 البحر : طويل 1(@)(@@) % هو الحق لكن قيدته حقائق تولد ما بين الطبيعة والأمر % % وجود يسمى عالم الخلق والأمر % 2(@)(@@) % أهيم به دهري لصورة خالقي % % ولولا وجود الدهر لم أفن في الدهر % 3(@)(@@) % أذوب وأفنى رقة وصبابة 