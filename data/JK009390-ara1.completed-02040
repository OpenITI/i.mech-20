ms2021	 أتى يوم القيامة ملجما بلجام من نار ) )(@)(@@) ( ه ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 18790 ) قال النبي :(@)(@@) | 30 ( ما من رجل يدرك له ابنتان فيحسن إليهما ما PageV06P283 صحبتاه أو صحبهما إلا أدخلتاه الجنة ) )(@)(@@) ( ه ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 18791 ) قال النبي :(@)(@@) | 30 ( ما من رجل يدعو بدعاء إلا استجيب له ، فإما أن يعجل له في الدنيا ، وإما أن يدخر له في الآخرة ، وإما أن يكفر عنه من ذنوبه بقدر ما دعا ، ما لم يدع بإثم أو قطيعة رحم أو يستعجل يقول : دعوت ربي فما استجاب لي ) )(@)(@@) ( ت ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 18792 ) قال النبي :(@)(@@) | 30 ( ما من رجل يسلك طريقا يطلب فيه علما إلا سهل الله له طريق الجنة ، ومن أبطأ به عمله لم يسرع به نسبه ) )(@)(@@) ( د ك ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 18793 ) قال النبي :(@)(@@) | 30 ( ما من رجل يصلي عليه مائة إلا غفر له ) )(@)(@@) ( طب حل ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 18794 ) قال النبي :(@)(@@) | 30 ( ما من رجل يعود مريضا ممسيا إلا خرج معه سبعون ألف ملك يستغفرون له حتى يصبح ومن أتاه مصبحا خرج معه سبعون ألف ملك يستغفرون له حتى يمسي ) )(@)(@@) ( د ك ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 18795 ) قال النبي :(@)(@@) | 30 ( ما من رجل يغبر وجهه في سبيل الله إلا أمنه الله النار يوم القيامة ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 18796 ) قال النبي :(@)(@@) | 30 ( ما من رجل يغرس غرسا إلا كتب الله له من الأجر قدر ما يخرج من ثمر ذالك الغرس ) )(@)(@@) ( حم ) عن أبي أيوب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 18797 ) قال النبي :(@)(@@) | 30 ( ما من رجل يلي أمر عشرة فما فوق ذالك إلا أتى PageV06P284 الله مغلولا يده إلى عنقه ، فكه بره ، أو أوثقه إثمه ، أولها ملامة ، وأوسطها ندامة ، وآخرها خزي يوم القيامة ) )(@)(@@) ( حم ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 18798 ) قال النبي :(@)(@@) | 30 ( ما من رجل ينظر إلى وجه والديه نظر 
ms2022	 رحمة إلا كتب الله له بها حجة مقبولة مبرورة ) )(@)(@@) الرافعي عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 18799 ) قال النبي :(@)(@@) | 30 ( ما من رجل ينعش بلسانه حقا فعمل به من بعده إلا أجرى عليه أجره إلى يوم القيامة ثم وفاه الله تعالى ثوابه يوم القيامة ) )(@)(@@) ( حم ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 18800 ) قال النبي :(@)(@@) | 30 ( ما من رجل لا يؤدي زكاة ماله إلا جعل الله يوم القيامة في عنقه شجاعا ، ومن اقتطع مال المسلم بيمين لقي الله وهو عليه غضبان ) )(@)(@@) ( ت ) عن ابن مسعود رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 18801 ) قال النبي :(@)(@@) | 30 ( ما من ساعة تمر بابن آدم لم يذكر الله فيها إلا حسر عليها يوم القيامة ) )(@)(@@) ( حل هب ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 18802 ) قال النبي :(@)(@@) | 30 ( ما من شيء أحب إلى الله تعالى من شاب تائب ، وما من شيء أبغض إلى الله تعالى من شيخ مقيم على معاصيه ، وما في الحسنات حسنة أحب إلى الله تعالى من حسنة تعمل في ليلة جمعة أو يوم جمعة ، وما من الذنوب ذنب أبغض إلى الله تعالى من ذنب يعمل في ليلة الجمعة ، أو يوم الجمعة ) )(@)(@@) أبو المظفر السمعاني في أماليه عن سلمان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 18803 ) قال النبي :(@)(@@) | 30 ( ما من شيء أقطع لظهر إبليس من عالم يخرج في قبيلة ) )(@)(@@) ( فر ) عن واثلة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 18804 ) قال النبي :(@)(@@) | 30 ( ما من شيء إلا يعلم أني رسول الله إلا كفرة الجن PageV06P285 والإنس ) )(@)(@@) ( طب ) عن يعلى بن مرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 18805 ) قال النبي :(@)(@@) | 30 ( ما من شيء إلا ينقص إلا الشر فإنه يزاد فيه ) )(@)(@@) ( طب ) عن أبي الدرداء رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 18806 ) قال النبي :(@)(@@) | 30 ( ما من شيء في الميزان أثقل من حسن الخلق ) )(@)(@@) ( حم د ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 18807 ) قال النبي :(@)(@@) | 30 ( ما من شيء لم أكن أريته إلا قد رأيته في مقامي هاذا حتى الجنة والنار ، وإنه قد أوحي إلي أنكم تفتنون في قبوركم مثل 
ms2023	 أو قريبا من فتنة المسيح الدجال ، يؤتى أحدكم فيقال له : ما علمك بهاذا الرجل ؟ فأما المؤمن أو الموقن فيقول : هو محمد رسول الله جاءنا بالبينات والهدى فأجبنا وآمنا وصدقنا هو محمد ثلاثا فيقال له : نم صالحا قد علمنا أن كنت لموقنا به ، وأما المنافق أو المرتاب فيقول : لا أدري سمعت الناس يقولون شيئا فقلته ) )(@)(@@) ( حم ف ) عن أسماء بنت أبي بكر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 18808 ) قال النبي :(@)(@@) | 30 ( ما من شيء يصيب المؤمن حتى الشوكة تصيبه إلا كتب الله له بها حسنة وحط عنه بها خطيئة ) )(@)(@@) ( م ) عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 18809 ) قال النبي :(@)(@@) | 30 ( ما من شيء يصيب المؤمن في جسده يؤذيه إلا كفر الله عنه به من سيئاته ) )(@)(@@) ( حم ك ) عن معاوية رضي الله عنه .(@)(@@)(@@)(@@) $ ( 18810 ) قال النبي :(@)(@@) | 30 ( ما من شيء يصيب المؤمن من نصب ولا حزن ولا وصب ، حتى الهم يهمه إلا يكفر الله به عنه من سيئاته ) )(@)(@@) ( ت ) عن أبي سعيد رضي الله عنه ( ز ) .(@)(@@) PageV06P286(@)(@@)(@@)(@@) $ ( 18811 ) قال النبي :(@)(@@) | 30 ( ما من شيء يوضع في الميزان أثقل من حسن الخلق ، وإن صاحب حسن الخلق ليبلغ به درجة صاحب الصوم والصلاة ) )(@)(@@) ( ت ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 18812 ) قال النبي :(@)(@@) | 30 ( ما من صاحب إبل ولا بقر ولا غنم لا يؤدي زكاتها إلا جاءت يوم القيامة أعظم ما كانت وأسمنه تنطحه بقرونها ، وتطؤه بأخفافها ، كلما نفذت أخراها عادت عليه أولاها حتى يقضى بين الناس ) )(@)(@@) ( ن ه حب ) عن أبي ذر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 18813 ) قال النبي :(@)(@@) | 30 ( ما من صاحب إبل لا يفعل فيها حقها إلا جاءت يوم القيامة أكثر ما كانت قط وأقعد لها بقاع قرقر تستن بقوائمها وأخفافها ، وما من صاحب بقر لا يفعل فيها حقها إلا جاءت يوم القيامة أكثر ما كانت وأقعد لها بقاع قرقر تنطحه بقرونها وتطؤه بقوائمها ، ولا صاحب غنم لا يفعل فيها حقها إلا جاءت يوم القيامة أكثر ما كانت وأقعد لها بقاع قرقر تنطحه بقرونها 
ms2024	 ، وتطؤه بأظلافها ليس فيها جماء ولا منكسر قرنها ، ولا صحاب كنز لا يفعل فيه حقه إلا جاء كنزه يوم القيامة شجاعا أقرع يتبعه فاغرا فاه ، فإذا أتاه فر منه فيناديه ربه عز وجل خذ كنزك الذي خبأته فأنا أغنى منك ، فإذا رأى أنه لا بد له منه سلك يده في فيه فيقضمها قضم الفحل ) )(@)(@@) ( حم م ن ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 18814 ) قال النبي :(@)(@@) | 30 ( ما من صاحب ذهب ولا فضة لا يؤدي منها حقها إلا إذا كان يوم القيامة صفحت له صفائح من نار فأحمي عليها في نار جهنم فيكوى بها جنبه وجبينه وظهره كلما بردت أعيدت له في يوم كان مقداره خمسين ألف سنة حتى يقضى بين العباد فيرى سبيله إما إلى الجنة وإما إلى النار ، ولا صاحب إبل لا يؤدي PageV06P287 منها حقها ، ومن حقها حلبها يوم ورودها إلا إذا كان يوم القيامة بطح لها بقاع قرقر أوفر ما كانت لا يفقد منها فصيلا واحدا تطؤه بأخفافها ، وتعضه بأفواهها ، كلما مر عليه أولادها رد عليه أخراها في يوم كان مقداره خمسين ألف سنة حتى يقضى بين العباد فيرى سبيله إما إلى الجنة وإما إلى النار ، ولا صاحب بقر ولا غنم لا يؤدي منها حقها إلا إذا كان يوم القيامة بطح لها بقاع قرقر لا يفقد منها شيئا ، ليس فيها عقصاء ولا جلحاء ولا عضباء تنطحه بقرونها ، وتطؤه بأظلافها ، كلما مر عليه أولاها رد عليه أخراها في يوم كان مقداره خمسين ألف سنة حتى يقضى بين العباد ، فيرى سبيله إما إلى الجنة وإما إلى النار ) )(@)(@@) ( حم م د ن ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 18815 ) قال النبي :(@)(@@) | 30 ( ما من صباح إلا وملكان يناديان : ويل للرجال من النساء ، وويل للنساء من الرجال ) )(@)(@@) ( ه ك ) عن أبي سعيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 18816 ) قال النبي :(@)(@@) | 30 ( ما من صباح ولا رواح إلا وبقاع الأرض ينادي بعضها بعضا : يا جارة هل مر بك اليوم عبد صالح صلى 
ms2025	 عليك أو ذكر الله ؟ فإن قالت نعم ، رأت أن لها بذالك فضلا ) )(@)(@@) ( طس حل ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 18817 ) قال النبي & : ' ما من صباح يصبح العباد إلا مناد ينادي : سبحان الملك القدوس ' ( ت ) عن الزبير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 18818 ) قال النبي :(@)(@@) | 30 ( ما من صباح يصبحه العباد إلا صارخ يصرخ : يا أيها الناس لدوا للتراب ، واجمعوا للفناء ، وابنوا للخراب ) )(@)(@@) ( هب ) عن الزبير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 18819 ) قال النبي :(@)(@@) | 30 ( ما من صباح يصبح العباد إلا وصارخ يصرخ : أيها الخلائق سبحوا الملك القدوس ) )(@)(@@) ( ع ) و ابن السني عن الزبير رضي الله عنه .(@)(@@) PageV06P288(@)(@@)(@@)(@@) $ ( 18820 ) قال النبي :(@)(@@) | 30 ( ما من صدقة أحب إلى الله من قول الحق ) )(@)(@@) ( هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 18821 ) قال النبي :(@)(@@) | 30 ( ما من صدقة أفضل من قول ) )(@)(@@) ( هب ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 18822 ) قال النبي :(@)(@@) | 30 ( ما من صلاة مفروضة إلا وبين يديها ركعتان ) )(@)(@@) ( حب طب ) عن الزبير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 18823 ) قال النبي :(@)(@@) | 30 ( ما من عالم أتى صاحب سلطان طوعا إلا كان شريكه في كل لون يعذب به في نار جهنم ) )(@)(@@) ( ك ) في تاريخه عن معاذ رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 18824 ) قال النبي :(@)(@@) | 30 ( ما من عام إلا والذي بعده شر منه حتى تلقوا ربكم ) )(@)(@@) ( ت ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 18825 ) قال النبي :(@)(@@) | 30 ( ما من عام إلا ينقص الخير فيه ، ويزيد الشر ) )(@)(@@) ( طب ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 18826 ) قال النبي :(@)(@@) | 30 ( ما من عبد ابتلي ببلية في الدنيا إلا بذنب ، والله أكرم وأعظم عفوا من أن يسأله عن ذالك الذنب يوم القيامة ) )(@)(@@) ( طب ) عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 18827 ) قال النبي :(@)(@@) | 30 ( ما من عبد استحيا من الحلال إلا ابتلاه الله بالحرام ) )(@)(@@) ابن عساكر ، عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 18828 ) قال النبي :(@)(@@) | 30 ( ما من عبد إلا وله صيت في السماء ، فإن كان صيته في السماء حسنا وضع في الأرض ، وإن كان صيته في السماء سيئ