ms121	 به ودع الجحود % % 14(@)(@@) % واعلم بأنك إن طلبت % % سواه معه فلا يجود % % 15(@)(@@) % هو واحد في ملكه % % والخلق أجمعهم جنود % % 16(@)(@@) % كن فيه يقظانا له % % ودع البرية في رقود % % 17(@)(@@) % وانظر إليه به ولا % % تنظر إليك عسى تسود % % 18(@)(@@) % في قلبك السر الخفي % % شمس لها منك القيود % % 19(@)(@@) % هذا مقام أولي النهى % % تلك الجهابذة الأسود % % 20(@)(@@) % فاسلك على منهاجهم % % واحرص على حفظ العهود % % PageV01P582 21(@)(@@) % ترفع إلى أوج العلا % % وتكون من أهل الشهود % % PageV01P583 البحر : - 1(@)(@@) % حبي وجودي الذي إني به موجود % % موجود عندي وإني عنده مفقود % % 2(@)(@@) % مقدري هو دائم وهو لي مشهود % % من يعرف الله مثلي حاز كل الجود % % PageV01P584 البحر : - 1(@)(@@) % خيطان خيط أبيض وهو الوجود % % والعدم الأسود يبدو ويعود % % 2(@)(@@) % كلاهما كلمع برق ظاهر % % لعارف محقق له الشهود % % 3(@)(@@) % حياكة الحق لثوب خلقه % % بقذف أمره لأنواع الحدود % % 4(@)(@@) % ثوب طويل وعريض واسع % % يلبسه الحق بنا شكل البرود % % 5(@)(@@) % وليس غير الأبيض الخيط الذي % % هو الوجود الحق من فجر العمود % % 6(@)(@@) % وقد أبيح الأكل والشرب لنا % % حتى نرى البياض من خيط الوجود % % 7(@)(@@) % فإن رأيناه فلا أكل ولا % % شرب ولكن صفة الرب الصمود % % 8(@)(@@) % إلى غروب نوره عنا وعن % % جميع ما نراه من بيض وسود % % 9(@)(@@) % قولوا معي تبارك الله الذي % % له الصيام وبه يجزي الوفود % % 10(@)(@@) % كما أتانا في حديث المصطفى % % بالخبر القدسي عن رب ودود % % PageV01P585 البحر : - 1(@)(@@) % لا رؤية ولا شهود % % في غير مرآة الوجود % % 2(@)(@@) % بل ليس شيئا ظاهرا % % إلا بها بخل وجود % % 3(@)(@@) % فيها السموات العلا % % والأرض تبدو وتعود % % 4(@)(@@) % وكل إدراك الورى % % وفهمهم فيها يرود % % 5(@)(@@) % والروح والعقل الذي % % له اعتراف أو جحود % % 6(@)(@@) % وجملة الأجسام للأبناء % % جمعا والجدود % % 7(@)(@@) % يبدون في المرآة مع % % فنائهم بعد النفود % % 8(@)(@@) % مع غيبة المرآة عن % % كل المعاني والعقود % % 9(@)(@@) % وليس يدري أحد % % بها علت عن القيود % % 10(@)(@@) % والكل ظاهر بها % % لأنها الرب الودود وهو الوجود الحق لا سواه والكل حدود % % PageV01P586 11(@)(@@) % تقذفهم من غيبها % % على عماء أو شهود 
ms122	 % % 12(@)(@@) % هذا هو الدين الذي % % من ارتقى به يسود % % 13(@)(@@) % وهو اعتقاد أمة % % مضوا من القوم الأسود % % 14(@)(@@) % أهل الشريعة الأولى % % هم في الركوع والسجود % % 15(@)(@@) % على الصلاة دائمو ن % % في القيام والقعود % % 16(@)(@@) % عليهم الرضوان من % % ربي مدى تحريك عود % % PageV01P587 البحر : - 1(@)(@@) % قل هو الله أحد % % ليس في الكون أحد % % 2(@)(@@) % كل شيء هالك % % غير وجه لا يحد % % 3(@)(@@) % والذي يفنى به % % مع ربه قد أتحد % % 4(@)(@@) % يا هنا عارفه % % يا شقاء من جحد % % 5(@)(@@) % ما له من ملجأ % % ما له من ملتحد % % PageV01P588 البحر : - 1(@)(@@) % هذا الوجود وهذا الواحد الأحد % % ولا يشاركه في وصفه أحد % % 2(@)(@@) % وكل من عنده دعوى الوجود طغى % % يشارك الله وهو الله لا يلد % % 3(@)(@@) % من أين جاء له هذا الوجود ألم % % يكن له نظر في عين ما يجد % % 4(@)(@@) % بكل شيء محيط قال خالقنا % % وقد أحاط بهذا المدعي الصمد % % 5(@)(@@) % وظالم هو في دعوى الوجود مع الله الذي هو نور دائما يقد % . . . % 6(@)(@@) % وهو القريب المجيب الرب ليس له % % حد ولا أزل معه ولا أبد % % 7(@)(@@) % وهو الوجود بلا شيء يخالطه % % إذ كل شيء هو الفاني له سند % % 8(@)(@@) % والظاهر الحق لا شيء بدا معه % % والباطن الحق فق يا من له رشد % % 9(@)(@@) % وكن بلا أنت كشفا بالوجود ولا % % تكن بنفسك كن ظلاله عمد % % 10(@)(@@) % واترك أقاويل أرباب العقول وخذ % % بما به الله في القرآن معتمد % % PageV01P589 11(@)(@@) % ولا تؤول نصوصا عن ظواهرها % % ولا تحرف وخذ طبق الذي يرد % % PageV01P590 البحر : - 1(@)(@@) % يا من عن الباب لا يرد % . . . % 2(@)(@@) % كيف عن الله فيك صد % . . . % 3(@)(@@) % فانظر كما أنت مستعد % . . . % 4(@)(@@) % مظاهر الحق لا تعد % % والحق فيها فلا يحد % % 5(@)(@@) % إن رمت أن لا يكون كرب % . . . % 6(@)(@@) % ولم يزل في الفؤاد قرب % . . . % 7(@)(@@) % كن عارفا والفناء شرب % . . . % 8(@)(@@) % إن بطن العبد فهو رب % % وإن بدا الرب فهو عبد % % 9(@)(@@) % ذب في التجلي ذاتا ووصفا % . . . % 10(@)(@@) % وكن من الروح فيه أصفى % . . . % PageV01P591 11(@)(@@) % وإن ترم تعرف المصفى % . . . % 12(@)(@@) % فظاهر 
ms123	 لا يكاد يخفى % % وباطن لا يكاد يبدو % % PageV01P592 البحر : - 1(@)(@@) % غنى لنا داعي السرور وغردا % % فسمعته في الصبح يعلن بالندا % % 2(@)(@@) % فأقمت في قلبي صلاة تحيتي % % للوجه من ذاك الحبيب إذا بدا % % 3(@)(@@) % وجه هو النور المبين لمن يرى % % يا سعد من يهوى الحبيب تعبدا % % 4(@)(@@) % نحن الدهان له بنا متلون % % وهو الوجود الحق حيث تجردا % % 5(@)(@@) % هي وردة قل كالدهان سماؤنا % % كانت كما القرآن أفصح مشهدا % % 6(@)(@@) % فنراه يصبغنا بمحض إرادة % % أزلية كيف اقتضته على المدى % % 7(@)(@@) % يمحو ويثبت ما يشا بوجوده % % كالبحر بالأمواج لم يظهر سدى % % 8(@)(@@) % وهو المنزه والمقدس دائما % % عن كل شيء كثرة وتعددا % % 9(@)(@@) % هي صبغة الله التي جاءت لنا % % في الذكر نعرفها على رغم العدا % % 10(@)(@@) % وهي الشؤون له التي قد جاءنا % % نص الكتاب بها يلوح محددا % % PageV01P593 11(@)(@@) % الله أكبر بعد هذا كله % % يا عارفون تحققوا وخذوا الهدى % % PageV01P594 البحر : - 1(@)(@@) % سباني عاقد البند % % مليح أهيف القد % % 2(@)(@@) % غزال ساقه رضوان % % لي من جنة الخلد % % PageV01P595 البحر : - 1(@)(@@) % كحيل العين وافاني % % أنا في حبه فاني % % 2(@)(@@) % ولا يقوى له إنسان % % رشا في صولة الأسد % % PageV01P596 البحر : - 1(@)(@@) % تعالى الله ما أحلى % % طلوع القمر الأعلى % % 2(@)(@@) % وكل من عليها فان % % لا عندك ولا عندي % % PageV01P597 البحر : - 1(@)(@@) % تجلى فاهتدى قلبي % % إلى وجه له يسبي % % 2(@)(@@) % وإني لم أزل حيران % % فيه زائد الوجه % % PageV01P598 البحر : - 1(@)(@@) % وصلى ربنا الهادي % % على طه النبي الهادي % % 2(@)(@@) % ومن عبد الغني ولهان % % فيه حافظ العهد % % PageV01P599 البحر : - 1(@)(@@) % لربي في السما جود % % على الأملاك ممدود % % 2(@)(@@) % كذا لله في التاريخ % % جود الأرض محمود % % PageV01P600 البحر : - 1(@)(@@) % هذا الوجود الحقيقي الواحد الأحد % % يشف عنه لدينا الروح والجسد % % 2(@)(@@) % أستغفر الله لا روح يشف لنا % % عنه ولا جسد ما للعديم يد % % 3(@)(@@) % والكل أجمعه عنه يشف كذا % % لا والد خارج عنه ولا ولد % % 4(@)(@@) % أستغفر الله عنه لا يشف لنا % % شيء وغير وجود الله لا نجد % % 5(@)(@@) % أنا العديم به كلي لأني قد % % ظهرت عن علمه بي فيه أتحد % % 6 
ms124	(@)(@@) % والكائنات جميعا فيه فانية معدومة ليس منها دائما أحد % . . . % 7(@)(@@) % الله أكبر رب الخلق أجمعهم % % هذا الوجود الذي فيهم له مدد % % 8(@)(@@) % والله خالقهم يعني مقدرهم % % كما لنا جاء في القرآن يعتمد % % 9(@)(@@) % وذاك في أزل الآزال ليس لنا % % بداية فيه فهو الخالق الصمد % % 10(@)(@@) % فاشهده فيك ولا تشهد لنفسك مع % % شهوده أنت معدوم ومفتقد % % PageV01P601 11(@)(@@) % وكلنا لم نزل في علمه أبدا % % وعلمه ذاته بل علمه الأبد % % 12(@)(@@) % هو الوجود ومعلوماته ظهرت % % من علمه فيه لا يحصى له عدد % % 13(@)(@@) % وإنه الحق فرد واحد وبه % % كل الخلائق منه دائما جدد % % 14(@)(@@) % فيظهرون سريعا بالوجود فهم % % بأمره الحق مثل البرق يتقد % % 15(@)(@@) % وأمره واحد وهو الوجود لهم % % ذات هي الغيب لم تولد ولا تلد % % PageV01P602 البحر : - 1(@)(@@) % نحن علم الله في الله وما % % لفتى منا سوى الله وجود % % 2(@)(@@) % نحن معلوماته في علمه % % ولنا من ذاك إكرام وجود % % 3(@)(@@) % لا تقل أوجدنا الله ولا % % إننا وجود حق ذو حدود % % 4(@)(@@) % نحن يا ابن اليوم شيء هالك % % من قديم للفنا فيه عهود % % 5(@)(@@) % جل وجه الله أن نشركه % % بوجود أو بقاء أو صمود % % 6(@)(@@) % نحن كالبرق سريعا نختفي % % ثم نبدو لمح ثم نعود % % 7(@)(@@) % هكذا يذكرنا الله على % % كثرة الأطوار من غير جمود % % 8(@)(@@) % فاعرفونا تعرفوا أنفسكم % % مثلنا واحترزوا من الجحود % % 9(@)(@@) % ما له ذكر سوى من علمه % % بجميع الخلق من بيض وسود % % 10(@)(@@) % فهو لا يخرج عنه كائن % % بل من العلم إلى العلم يرود % % PageV01P603 11(@)(@@) % كلهم فيه ولا كل لهم % % عدم حاق به محض وجود % % 12(@)(@@) % واسع قال عليم ربنا % % وسعت رحمته كل الجنود % % 13(@)(@@) % فالذي يؤمن بالحق الذي % % قلته نال مقامات السعود % % 14(@)(@@) % والذي ينكر أشقى هو من عاقرا لناقة في قوم ثمود % . . . % 15(@)(@@) % وهو علم الله أيضا مثلنا % % نازل للذكر من غير صعود % % PageV01P604 البحر : - 1(@)(@@) % يا من غفلتم وجوهكم سود % % وربكم في الخيال مولود % % 2(@)(@@) % خيالكم ولد الإله لكم % % أنتم عبيد وذاك معبود % % 3(@)(@@) % وتنكرون الوجود خالقكم % % بأنه الله وهو 
ms125	 موجود % % 4(@)(@@) % إن لم يكن ربنا الوجود يكن % % بالعدم المستحيل مقصود % % 5(@)(@@) % يكن خيال الذين قد عبدوا % % خيالهم والجهول مبعود % % 6(@)(@@) % حاشا وكلا يكون خالقنا % % غير الوجود الذي له الجود % % 7(@)(@@) % وهو محيط بنا وبالأشيا % % جميعها جاحد ومجحود % % 8(@)(@@) % به السموات أشرقت وبه الأرض % % جميعا وأورق العود % % 9(@)(@@) % ترضون أن الخيال منه لكم % % رب وما بالوجود جلمود % % 10(@)(@@) % ولا بهذا الوجود قائمة % % أكوانكم والغلام والخود % % PageV01P605 11(@)(@@) % وظلم كله الخيال وما % % بدا لكم منه فهو مردود % % 12(@)(@@) % وربنا نحن وهو خالقنا % % وجود حق سواه مفقود % % 13(@)(@@) % وذاك معنى بأينما كنتم % % وهو قريب لنا ومعهود % % 14(@)(@@) % أقرب من حبلنا الوريد كما % % قال وقالته سادة قود % % 15(@)(@@) % ونحن لا شيء هالكون وفا نون % % به وهو وهو مشهود % % 16(@)(@@) % لأجل هذا لنا الوجوه غدا % % بيض وأنتم وجوهكم سود % % 17(@)(@@) % وجوهنا البيض حيث خالقنا % % وجودنا النور وهو مسعود % % 18(@)(@@) % وربكم في خيالكم وبه % % وجوهكم بالسواد معقود % % 19(@)(@@) % بدت بكم ظلمة الخيال وقد % % أوقدها في السعير سفود % % 20(@)(@@) % تنكبوا عن طريقنا وقفوا % % وقفة قوم نذيرهم هود % % PageV01P606 21(@)(@@) % فإن هذا الوجود عز وقد % % جل وما ذا الوجود محدود % % 22(@)(@@) % وما له صورة وليس له % % ثان وفيه التوحيد محمود % % 23(@)(@@) % لا مثل كلا ولا شبيه له % % والكم والكيف عنه مطرود % % 24(@)(@@) % لكن تراه العيون جل ولا % % تدركه باب ذاك مسدود % % 25(@)(@@) % ملك سليمان كان منه كما % % خليفة عنه كان داود % % 26(@)(@@) % لا ذاته تشبه الذوات ولا % % صفاته كالصفات يا دود % % 27(@)(@@) % كالدود أنتم ضعاف خلقتكم % % عزم لكم في الرشاد مخمود % % 28(@)(@@) % قوموا اشهدوا أنه الوجود لكم % % قيومكم كالجميع معدود % % 29(@)(@@) % وهو عيان لكل ذي بصر % % لا يحجبنكم للنفس أخدود % % 30(@)(@@) % من كان أعمى في هذه فغدا % % هناك أعمى والزرع محصود % % PageV01P607 31(@)(@@) % نص كتاب الإله حجتنا % % والدر عقد الحديث منضود % % PageV01P608 البحر : - 1(@)(@@) % كلي تفنيه وتوجده % % ولقاك فنائي موعده % % 2(@)(@@) % ظهرت بتجليك الأشيا % % والأمر بها مدت يده % % 3(@)(@@) % وسواك رآك وضل فلم % % يقدر يهديه مرشده % % 4(@)(@@) % يا طلعة وجه أبيضه 
ms126	 % % للغافل عنه أسوده % % 5(@)(@@) % أنت المأمول لكل فتى % % ومراد القلب ومقصده % % 6(@)(@@) % وإن الأبصار سواك رأت % % ونفت لظهورك تجحده % % 7(@)(@@) % هذا مدد باق أبدا % % من حضرة غيب يورده % % 8(@)(@@) % لا تقدر تقطعه أمم % % تبغي فيه أو تحسده % % 9(@)(@@) % والغيب تبدى في صور % % من ينظر فيها يشهده % % 10(@)(@@) % يهدي قوما ويضل كما % % يشقي من شاء ويسعده % % PageV01P609 11(@)(@@) % والقدرة أجمع قدرته % % فيها لا زال تفرده % % 12(@)(@@) % والكل بها قد قام إذا % % ظهرت في شيء تنجده % % 13(@)(@@) % وبقدر الاستعداد ترى % % في الشيء فيظهر موجده % % 14(@)(@@) % يا نسمة أمر الحق هبي % % سرا في القلب تردده % % 15(@)(@@) % والحضرة بثي رونقها % % فينا إنا نتودده % % 16(@)(@@) % وإذا أنوار الحق بدت % % بالحق نراه فنعبده % % 17(@)(@@) % للجسم ركوع يركعه % % للقلب سجود يسجده % % 18(@)(@@) % والعالم ليل أجمعه % % يا غفلة عبد يرقده % % 19(@)(@@) % فاحذر يلهيك تلبسه % % والظاهر فيك تجدده % % 20(@)(@@) % واظهر بالحمد له أبدا % % قد فاز به من يحمده % % PageV01P610 البحر : - 1(@)(@@) % أصابع الغيب فينا حركت عوده % % وحرقت تحت أذيال الحجا عوده % % 2(@)(@@) % العقل أول مخلوق به وردت % % أخبار طه رسول الله مقصوده % % 3(@)(@@) % وليس ثم سواه واحد هو في % % عين الحقيقة لاحت بيضه سوده % % 4(@)(@@) % وذاك عقل وجود الحق قد ظهرت % % عنه التصاوير بالتقدير محدودة % % 5(@)(@@) % وفيه قوة تصوير الحقائق من % % حس ومعنى مدى الأوقات مشهودة % % 6(@)(@@) % وكل شيء من الأشيا أجمعها % % قامت فمذموم فيه ومحموده % % 7(@)(@@) % والحق صورها حتى تصورها % % فيه فصارت بهذا الأمر موجوده % % 8(@)(@@) % فالعقل في كل شيء ظاهر أبدا % % بمقتضى الشيء يعطي نفسه جوده % % 9(@)(@@) % وحقق القول إن الشيء منه له % % رقيقة هي بالتحقيق ممدوده % % 10(@)(@@) % مثل الأشعة عنه الكل قد ظهروا % % قبضا وبسطا ليبدي الكل مجهوده % % PageV01P611 11(@)(@@) % إنا فتحنا عليهم باب معرفة % % وما سواه من الأبواب مسدوده % % PageV01P612 البحر : - 1(@)(@@) % حرارة عشقه تعطي بروده % % إذا لبس الورى فغدوا بروده % % 2(@)(@@) % وجود قدر الأكوان حتى % % لهم أعطى وما أعطى وجوده % % 3(@)(@@) % عطاء توجه منهم عليهم % % بهم يعطيك مطلقة قيوده % % 4(@)(@@) % كما يعطي تفكرك المعاني % % بتصوير لها يبدي حدوده 
ms127	 % % 5(@)(@@) % وأحضرهم لهم وله بوجه % % إليهم منه يولي الكل جوده % % 6(@)(@@) % وليس الوجه غير توجهات % % لما في علمه تنفي صدوده % % 7(@)(@@) % وهذا كان منه لما اقتضته % % محبته لهم فرأوا ودوده % % 8(@)(@@) % فقوم شاهدوا الأكوان لاحت % % وقوم حققوا فيها شهوده % % 9(@)(@@) % وقوم قد رأوه بهم تجلى % % لهم ونفوا سواه فبت عوده % % 10(@)(@@) % لقد نسجت لها الأرواح منا % % شرانق جسمنا فالروح دوده % % PageV01P613 11(@)(@@) % فإن فسدت هياكلها فطير % % يبيض نوره الشعشاع سوده % % 12(@)(@@) % وذا حكم الشهيد به الموافي % % إلى وكر الغيوب غدت وفوده % % 13(@)(@@) % صدقتك يا ابن حضرتنا تواضع % % له وأطل إليه به سجوده % % 14(@)(@@) % وكن عبدا ولا تك فيه ربا % % على شيء له تصلى وقوده % % PageV01P614 البحر : - 1(@)(@@) % كن عارفا بنعمة الله وكن % % محققا لها بفرط رفده % % 2(@)(@@) % فالشيء لا يعرف في وجدانه % % وإنما يعرف وقت فقده % % 3(@)(@@) % والعطر لا ينشقه عطاره % % والغير يدريه لبعد وجده % % PageV01P615 البحر : - 1(@)(@@) % انظر الكون خارجا من وجوده % % من وجود منزه عن قيوده % % 2(@)(@@) % عدم من وجوده هو باد % % أنت منه ممتع بشهوده % % 3(@)(@@) % حضرة العلم بالكلام أبانت % % عن تفاصيل حادث وحدوده % % 4(@)(@@) % فهو حق في علمه كل شيء % % ظاهر بالكلام عن مقصوده % % 5(@)(@@) % لا تقل غير ما أقول وإلا % % أنت عبد الخيال يا ابن جدوده % % 6(@)(@@) % لا تكن عابدا خيالك وهما % % واعبد الله في حقيق وجوده % % 7(@)(@@) % هو حق وأنت والكون طرا % % باطل زاهق بحكم نفوده % % 8(@)(@@) % هذه وحدة الوجود فخذها % % مثلنا عنه ذائقا فيض جوده % % 9(@)(@@) % ودع الملحدين بالجهل فيها % % مع معاداة غيهم وصدوده % % 10(@)(@@) % يحسبون الضلال في الله رشدا % % ويظنون أنهم من وفوده % % PageV01P616 11(@)(@@) % أنت لا تستطيع أنك تهدي % % عبد رب قد ضل عن معبوده % % PageV01P617 البحر : - 1(@)(@@) % إن من هام فيه وجدا فؤادي % % لا أنا لا سواي حاشاه وحده % % 2(@)(@@) % قبل كل وبعد كل ومع % % كل ولا قبله ومعه وبعده % % PageV01P618 البحر : - 1(@)(@@) % غلب الهوى واستحوذ استحواذا % % فمن الذي نلجأ إليه عياذا % % 2(@)(@@) % في طلعة شمسية قمرية بجمالها صارا لجميع جذاذا % . . . % 3(@)(@@) % يا هيكلا ظهرت غيوب 
ms128	 شؤونه % % فينا فكان لكلنا أخاذا % % 4(@)(@@) % وجه تبرقع بالمحاسن والبها % % فعنت له كل الوجوه لذاذا % % 5(@)(@@) % وتمتعت أرواحنا بهلاكها % % فيه ولاذت بالفناء لياذا % % 6(@)(@@) % ونراه أقرب من نراه ولا نرى % % شيا سواه ومن سواه أعاذا % % 7(@)(@@) % فهو الذي لجمال طلعته يرى % % وقلوبنا وعيوننا تتحاذى % % 8(@)(@@) % إن الوجود يرى الوجود كما به % % عدم يرى عدما له جباذا % % 9(@)(@@) % وممنع بالعز عنه عقولنا % % معقولة لا تقتضيه تنفاذا % % 10(@)(@@) % وقلوبنا في بحر عشقته هوت % % تبغي اللقا لا تعرف الانقاذا % % PageV01P619 11(@)(@@) % نزل النقا فاشتاقه أهل النقا % % أو هل ترى بعد النزول لو اذا % % 12(@)(@@) % بالأمس كان مناخه بطويلع % % واليوم صار مخيما بغداذا % % 13(@)(@@) % لا عار إن خلع العذار محبه % % في حبه ولجا إليه ولاذا % % 14(@)(@@) % ظهرت ملاحته بديباج الورى % % فينا وقد لبس اللطافة لاذا % % 15(@)(@@) % وأقول زيدا قد رأيت وخالدا % % لا ذاك في بصري رأيت ولا ذا % % 16(@)(@@) % ورآه في زيد بن حارثة هنا % % طه النبي وحب فيه معاذا % % 17(@)(@@) % وبيوسف الصديق شاهد وجهه % % يعقوب حين له هواه آذى % % 18(@)(@@) % وصفاتنا ظهرت لنا بصفاته % % ورأى الجنيد به الورى ممشاذا % % 19(@)(@@) % أما هواه فإنه هو ملتي % % وعليه كنت أعاهد الأستاذا % % 20(@)(@@) % عجبي له وهو الكثير أضلنا % % والواحد الهادي لنا استنقاذا % % PageV01P620 21(@)(@@) % يشقى ويسعد بالذي أشقى به % % فتراه لاح صواعقا ورذاذا % % 22(@)(@@) % بالله يا لحظاته لا تجرحي % % قلبي فإن بسهمك الفولاذا % % 23(@)(@@) % ولأنت يا خمر الرضاب محوتنا % % سكرا وريحك لم يزل نباذا % % 24(@)(@@) % من لي بمشهود المحاسن غاب % % لام العذول على هواه وهاذى % % 25(@)(@@) % هو حاضر لكن بغير إشارة % % فإذا جهلت تقول عنه هذا % % 26(@)(@@) % عشاقه بعيونه مفتونة % % وقلوبهم صارت به أفلاذا % % 27(@)(@@) % ويظل يهجرهم ويكثر صده % % عنهم وما أحد يقول لماذا % % 28(@)(@@) % ويرونه حسنا وفي أفعاله % % لطفا وفي تعذيبه استلذاذا % % 29(@)(@@) % وبهم تجمعت القبائل في الهوى % % وعلى البعاد تفرقوا أفخاذا % % 30(@)(@@) % يأتي النسيم لهم بأخبار الحمى % % للمسك فاوح في الهبوب وشاذى % % PageV01P621 31(@)(@@) % وتهجهم ورقاء فوق أراكة % % تدني البعيد وتجمع الأفذاذا % % PageV01P622 البحر : - 1(@)(@@) % ذال الذهاب مقيد 
ms129	 طلق الشذا % % والنفع منه يزيل داهمة الأذى % % 2(@)(@@) % مبتذل فكأنه متمنع % % وبه الحجا منه لديه تعوذا % % 3(@)(@@) % ظهر الضيا ظهر الضيا ظهر الضيا % % خفي السوى خفي السوى هذا وذا % % 4(@)(@@) % حرف به نطق الوجود وشكله % % في اللوح والمحفوظ ذلك هكذا % % 5(@)(@@) % وهو العلي عن الرسوم ونحوها % % من حضرة نبوية فإذا إذا % % PageV01P623 البحر : - 1(@)(@@) % يا من به العبد من دون السوى لاذا % % أنت المراد لقلبي والمنى لا ذا % % 2(@)(@@) % وحقك الود فيه لست ملاذا % % قمصتني الخيش أو قمصتني لاذا % % PageV01P624 البحر : - 1(@)(@@) % عالم الحكمة هذا % % فيه ذو الهذيان هاذى % % 2(@)(@@) % حكمه لله جلت % % ويقول الغر ماذا % % 3(@)(@@) % عمي الدهري عنها % % وبها المؤمن لاذا % % 4(@)(@@) % ويقول الفلسفيون % % هو العلة هذا % % 5(@)(@@) % كذبوا ما الحق إلا % % فعل أمر يتحاذى % % 6(@)(@@) % فعل من يفعل ما شاء % % صحيحا وجذاذا % % 7(@)(@@) % وله الأوصاف والأسماء % % جمعا وفذاذا % % 8(@)(@@) % كيفما شاء ولا علة % % لا طبع عياذا % % 9(@)(@@) % والطبيعيون قوم % % نبذوا الحق انتباذا % % 10(@)(@@) % عبدوا الطبع بكفر % % وجدوا فيه لذاذا % % PageV01P625 11(@)(@@) % ثم أقوام اعتزال % % مطروا الغي رذاذا % % 12(@)(@@) % عن هدى السنة مالوا % % نفذوا عنه نفاذا % % 13(@)(@@) % أين دين الحق ممن % % بالضلال الله آذى % % 14(@)(@@) % ورسول الله أيضا % % عندما شذ شذاذا % % 15(@)(@@) % ديننا شرع نبي % % صادق للحق حاذى % % 16(@)(@@) % فتمسكنا به لا % % نبتغي ذاك ولا ذا % % 17(@)(@@) % واقتدينا به لا % % نبتغي ذاك ولا ذا % % 18(@)(@@) % واقتدينا بأبي بكر % % وتابعنا معاذا % % PageV01P626 البحر : - 1(@)(@@) % أول منامك هذا % % لا أنت أنت ولا ذا % % 2(@)(@@) % وإنما الكل حق % % في صورة تتحاذى % % 3(@)(@@) % وتلك أفعال ربي % % تأتي وتمضي جذاذا % % 4(@)(@@) % والناس قال نيام % % نبينا الأستاذا % % 5(@)(@@) % والناس قال نيام % % نبينا الأستاذا % % 6(@)(@@) % فخذ بما قال واحكم % % فلست تلقى نفاذا % % 7(@)(@@) % وكل شيء تراه % % اطلب له استنقاذا % % 8(@)(@@) % من لبسه فهو حق % % أرضاك أو ذاك آذى % % 9(@)(@@) % إن ذقت شيا أليما % % أو ذقت فيه لذاذا % % 10(@)(@@) % فالكل فان ولكن % % أما الإله فهذا % % PageV01P627 11(@)(@@) % وما السوى غير شيء % % ملاعب لك هاذى % % PageV01P628 البحر : - 1(@)(@@) % لذاتي بذاتي لا لكم أنا 
ms130	 ظاهر % % وما هذه الأكوان إلا مظاهر % % 2(@)(@@) % تقيدت والإطلاق وصفي لأنني % % على كل شيء حين لا حين قادر % % 3(@)(@@) % ومرتبة التقييد أظهرت رحمة % % ومرتبة الإطلاق أني ساتر % % 4(@)(@@) % وتلك بمخلوق وهدي بخالق % % تسمت وفي التحقيق أين التغاير % % 5(@)(@@) % وأحببت بالتكليف إظهار حكمة الظهور % % وحكمي ما أنا فيه جائر % % 6(@)(@@) % وصوني لأفعالي عن العبث اقتضى % % خطابي ومن لم يتمثل فهو كافر % % 7(@)(@@) % جسوم وأعراض تلوح وتختفي % % وما هي للمحبوب إلا ستائر % % 8(@)(@@) % وخلف حجاب الكون ما أنت طالب % % ومن لفظه المقهور يلزم قاهر % % 9(@)(@@) % تأمل حروف الكائنات فإنها % % تشير إلى معنى به أنت حائر % % 10(@)(@@) % وبرق الحمى هذا الوجود وميضه % % ولكن بما تجنيه تعمى البصائر % % PageV01P629 11(@)(@@) % فيا ظاهرا في خلقه وهو باطن % % ويا باطنا في أمره وهو ظاهر % % 12(@)(@@) % تجليت لي في كل شيء ولم أكن % % سواك فمنظور كما أنت ناظر % % 13(@)(@@) % وللقلب مني قد ظهرت بكل ما % % ظهرت ولم تنكرك مني الخواطر % % 14(@)(@@) % بكل مليح بل بكل مليحة % % تراءيت حتى حققتك الضمائر % % 15(@)(@@) % وما مذهبي حب المظاهر إنما % % أحب الذي دلت عليه المظاهر % % 16(@)(@@) % أما ومقام البيت والحجر الذي % % عهدناه قد دارت عليه الخناصر % % 17(@)(@@) % لأنت المنى والقصد يا غاية المنى % % وإن لامني فيك القنا والبواتر % % 18(@)(@@) % وما ملت يوما عنك للغير سلوة % % وكيف ويا نوري معي أنت حاضر % % 19(@)(@@) % وأنت رفيقي لا رفيق سواك لي % % وإن أنا عن إيفاء حقك قاصر % % 20(@)(@@) % أحبك لا بي بل بك الحب منه % % علي كما أني بك الآن شاكر % % PageV01P630 21(@)(@@) % يقول عذولي لا تخاطر بقربه % % وهل يدرك المأمول إلا المخاطر % % 22(@)(@@) % وإني لأدري أن طرق وصاله % % تدور على الأقوام فيه الدوائر % % 23(@)(@@) % ولكن له سلمت نفسي فإن يرد % % هداها وإن يضلل فما هو جائر % % 24(@)(@@) % وماذا عسى نفسي تعادل في الورى % % فمن أجلها عن مالكي أنا نافر % % 25(@)(@@) % فررت به مني إليه لأنني % % تحققت أن لا غير والأمر ظاهر % % 26(@)(@@) % فكان اضطرارا كون قلبي موحدا % % له وبه لأبي أنا اليوم ذاكر % % 27(@)(@@) % أهيم 
ms131	 بأنفاس النسيم وإنني % % بطيب الحمى لا بالنسائم عاطر % % 28(@)(@@) % وأظهر أني قد ظفرت بعلمهم % % وقلبي بذات الخال لا العلم ظافر % % 29(@)(@@) % ودونك شرعي إن هويت طريقتي % % فإني مدى عمري إلى الحب سائر % % 30(@)(@@) % وكن هكذا مثلي فقيرا من السوى % % ومن نفسه تأتيك منك الذخائر % % PageV01P631 31(@)(@@) % وغب عنك وامح نقطة الغين ثابتا % % وغص في بحار الجمع تبد الجواهر % % 32(@)(@@) % ولأنك من قوم أماتت ذنوبهم % % نفوسا لها الأجسام منهم مقابر % % 33(@)(@@) % فإن طريق الحق سهل سلوكه % % وأوضح منه ليس يدرك ناظر % % 34(@)(@@) % وليس بذكر أو بفكر تناله % % سوى بالصفا والمحو عما يغاير % % 35(@)(@@) % وهذا حجاب النفس يصعب خرقه % % وعقلك منه وهو للحق ساتر % % 36(@)(@@) % فمت في الهوى تحيى وأغمض عن السوى % % تقر بذاك الوجه منك النواظر % % 37(@)(@@) % طلبت مقاما بذل روحك شرطه % % وأنت على ما أنت ناه وآمر % % 38(@)(@@) % وما هكذا شرط الهوى إن ترد فرد % % فناء الفنا وانس الذي أنت ذاكر % % 39(@)(@@) % ووطن على الإنكار نفسك والأذى % % فمن عسلا يجني على النحل صابر % % 40(@)(@@) % وقد كثرت فيه العواذل غيره % % وقل لطلاب الحقيقة ناصر % % PageV01P632 41(@)(@@) % فإن شت فاقدم هكذا الشرط بيننا % % وإلا فلا تقدم لأنك آخر % % PageV01P633 البحر : - 1(@)(@@) % لو تجلى عن ناظريك الغبار % % لرأيت الكؤوس كيف تدار % % 2(@)(@@) % ولبانت نار لديك كما بانت لموسى من جانب الطور نار % . . . % 3(@)(@@) % ولزالت رسوم ذاتك فيمن % % لم يزل وانمحت به الآثار % % 4(@)(@@) % وتبدت فريدة الحسن تجلى % % زائلات عن وجهها الأستار % % 5(@)(@@) % ورأيت الهدى وأرشدك الدف % % وصوت الغناء والمزمار % % 6(@)(@@) % لكن القلب منك في غفلات % % وعلى وجهك الكثيف خمار % % 7(@)(@@) % ويقينا إن التكاثر ألهاك % % وعزت بوهمك الأغيار % % 8(@)(@@) % فاجتهد واقصد الحقيقة واطلب % % ولتكن فيك همة واصطبار % % 9(@)(@@) % وتذلل بباب ديرك واخضع % % فعسى أن يريدك الخمار % % 10(@)(@@) % إنما أنت عند نفسك وهم % % ظهرت منك هذه الأطوار % % PageV01P634 11(@)(@@) % والذي أنت فيه محض غرور % % وهو في مذهب الحقيقة عار % % 12(@)(@@) % عدم في الوجود يبدو ويخفى % % ماله في الحقيقتين قرار % % PageV01P635 البحر : - 1(@)(@@) % أيها الناي عندك الخبر % % ليس للأذان عنك مصطبر 
ms132	 % % 2(@)(@@) % سيما والدفوف معلنة % % بالذي قد أسره الوتر % % 3(@)(@@) % هات حدث عن الذين نأوا % % في هواهم لم يقض لي وطر % % 4(@)(@@) % واشرح الحال واحك ما صنعت % % في فؤادي العيون والطرر % % 5(@)(@@) % وارو أخبار من أحب فإن % % فاتت العين لم يفت أثر % % 6(@)(@@) % واترك العاذلين في ولهي % % لا تلمهم فإنهم بقر % % 7(@)(@@) % لا عقول لهم ترددهم % % عن ملامي ولا لهم نظر % % 8(@)(@@) % كل فظ بدت كثافته % % بازدياد كأنه حجر % % 9(@)(@@) % ميت جهل والقبر جثته % % نطقه اللغو ليس يعتبر % % 10(@)(@@) % من أناس بعقلهم قصدوا % % فهم ما العقل عنه محتقر % % PageV01P636 11(@)(@@) % حاولوا الدرك مع جمودتهم % % ثم لما أعياهمو كفروا هل ملامي يليق في قمر إن تبدى يسجد له القمر % % 12(@)(@@) % بل هي الشمس بل أجل سنا % % كل حسن من حسنها أثر % % 13(@)(@@) % ذات وجه تلوح خافية % % خلف ستر جميعه صور % % 14(@)(@@) % يكثف العقل عن لطافتها % % فلهذا حارت بها الفكر % % PageV01P637 البحر : - 1(@)(@@) % هذه نفحة عنبر % % عن شذاها لا يعبر % % 2(@)(@@) % يا مريض النفس عنك العارف % % النحرير أخبر % % 3(@)(@@) % إن ترم داءك يبرا % % فاشرب الماء المدبر % % 4(@)(@@) % لتقيء الكون والكون % % وكسر البعد يجبر % % 5(@)(@@) % قام في الصدر خطيب % % وله قلبك منبر % % 6(@)(@@) % فاستمع وانصت ولا تلغو % % قتيلا كن مصبر % % 7(@)(@@) % وبه لا بك فاذكر % % ولذكر الله أكبر % % PageV01P638 البحر : - 1(@)(@@) % أنت في بالك خاطر % % فانمح عنك وخاطر % % 2(@)(@@) % وصل الجزء بكل % % ثم كن للكل فاطر % % 3(@)(@@) % وانتشق زهر رياضي % % فبطيبي الكون عاطر % % 4(@)(@@) % وانتهض وارفع كفوفا % % فسحاب الجود ماطر % % 5(@)(@@) % وإذا بان همام % % لك من ذانك شاطر % % 6(@)(@@) % عدا عن سلسلة النفس % % وأغلال الخواطر % % 7(@)(@@) % وتيقن أن سري % % حارس فيك وناظر % % PageV01P639 البحر : - 1(@)(@@) % يا طلعة الشمس أو يا طلعة القمر % % يختال في حلل الأشباح والصور % % 2(@)(@@) % في القلب أنت وما في القلب أنت كما % % إن أنت في بصري ما أنت في بصري % % 3(@)(@@) % أنا وأنت كلانا واحد ظهرا % % على البرية في بدو وفي حضر % % 4(@)(@@) % وأنت أنت على ما أنت فيه كذا % % أنا أنا مثل حالي 
ms133	 أول العمر % % 5(@)(@@) % هيهات ابن الثريا والثرى ولقد % % لاح المؤثر لي من كوة الأثر % % 6(@)(@@) % ونحن يا معشر العشاق عادتنا % % طورا وطورا وليس الخبر كالخبر % % 7(@)(@@) % شدوا المناطق تعظيما لخدمته % % مزنرين على الأوساط بالأزر % % 8(@)(@@) % يستنشقون رياح الموت قد ركبوا % % خيل الردى أسرجت بالبؤس والضرر % % 9(@)(@@) % باعوا الشفاء بسقم والهنا بعنا % % والعز بالذل والإغفاء بالسهر % % 10(@)(@@) % وإن صفا الماء أبدى ما يقابله % % ولا حلول ولا تغيير فاعتبر % % PageV01P640 11(@)(@@) % يا ذا الذي لا مني جهلا رويدك بي % % فأنت عندي محسوب من البقر % % 12(@)(@@) % أمري عظيم وشأني لا تحيط به % % ما لم يرق منك ماء الروح من كدر % % 13(@)(@@) % فانظر لنفسك وافرغ من نصيحتها % % ثم انصح الغير عن العلياء في قصر % % 14(@)(@@) % حتى غدا زاعما من فرط طاعته % % وزهده أنه من أفضل البشر % % 15(@)(@@) % وليس يعلم ما تجني عبادته % % من الحجاب له عن لذة النظر % % 16(@)(@@) % ومن إلى الزهد والطاعات ينظر عن % % مولاه أعمى ومن بالعكس ذو بصر % % 17(@)(@@) % ونحن قوم عن الأغيار همتنا % % ترفعت لعزيز الأمر مقتدر % % 18(@)(@@) % لا الزهد عمن سواه عنه يحجبنا % % ولا بطاعته عنا بمستتر % % 19(@)(@@) % قمنا به لا بنا حيث الوجود له % % والظل ليس بموجود من الشجر % % PageV01P641 البحر : - 1(@)(@@) % إن للإحسان نورا % % يملأ القلب سرورا % % 2(@)(@@) % وبه الأموات تحيا % % بعدما زارت قبورا % % 3(@)(@@) % جنة الدنيا لمن قد % % شهد الدنيا غرورا % % 4(@)(@@) % وهو يمن وأمان % % نافخ مني صورا % % 5(@)(@@) % أطلعت منه سمواتي % % شموسا وبدورا % % 6(@)(@@) % وعروس الخدر تجلى % % أخذت كلي مهورا % % 7(@)(@@) % وتجاراتي لديها % % إن أرادت لن تبورا % % 8(@)(@@) % نثر الدوح علينا % % في ربا نجد زهورا % % 9(@)(@@) % فانتشقنا نسمات % % وتأملنا النهورا % % 10(@)(@@) % وجنينا ورد خد % % وترشفنا الثغورا % % PageV01P642 11(@)(@@) % أيها الغائب عنا % % لا تقل بالله زورا % % 12(@)(@@) % اترك اللوم ودعنا % % نشرب الحب خمورا % % 13(@)(@@) % وعلى الحب أعنا % % إن تجد فينا قصورا % % 14(@)(@@) % علنا من وجه هذا اللوح % % أن نمحو سطورا % % 15(@)(@@) % والتجلي دك مني % % ومن الأكوان طورا % % 16(@)(@@) % ليت هذا الأمر لو يدنو % % من القلب خطورا % % 17(@)(@@) % والذي ينفر 
ms134	 عنا % % ليته ينفي النفورا % % 18(@)(@@) % عزة في كبرياء % % أرخت الكل ستورا % % 19(@)(@@) % وهو ما زال على ما % % كان جبارا غفورا % % 20(@)(@@) % والذي نحن عليه % % لم نزل فيه حضورا % % PageV01P643 21(@)(@@) % ولقد أرسل أعواما % % علينا وشهورا % % 22(@)(@@) % وأويقات وساعات % % توالت ودهورا % % 23(@)(@@) % وعلا عن كل شيء % % وعن العلو وفورا % % 24(@)(@@) % إنما الإحسان من إحسانه % % الوافي أجورا % % 25(@)(@@) % وبه الأفلاك دارت % % ساكنات منه دورا % % 26(@)(@@) % وبه الأملاك قامت % % تخدم الرب الشكورا % % 27(@)(@@) % فاجتهد فيه وجاهد % % وعليه كن صبورا % % PageV01P644 البحر : - 1(@)(@@) % افتح عيونك في الآيات والسور % % واحذر غرورك بالأشباح والصور % % 2(@)(@@) % واعلم بأن جميع الكون مغلطة % % واقبل على العين لا تقبل على الأثر إن التقلب للقلب الذي هو ما بين الأصابع فيما صح في الأثر % % 3(@)(@@) % فتارة هو في غيب يحار به % % وتارة في شهود غير مستتر % % 4(@)(@@) % ومنه لي نفس الرحمن منهبط % % لم يبق من جملتي شيئا ولم يذر % % 5(@)(@@) % وزاد جسمي المسوى نفخه طربا % % حتى تعشقت صوت الناي والوتر % % 6(@)(@@) % وقد سمعت ومن بعض النداء أنا % % صوت المنادي بإيمان على البشر % % 7(@)(@@) % هو الوجود له منه الرسول أتى % % مبشرا ونذيرا صادق الخبر % % PageV01P645 البحر : - 1(@)(@@) % عيون العلا نحو السعيد نواظر % % ومنصبه في حضرة العز فاخر % % 2(@)(@@) % وللكون معنى دق عن فهم عارف % % تشير إليه الباطنات الظواهر % % 3(@)(@@) % ومعنى لمعنى ليس معنى وما له % % سوى الكون معنى وهو للعقل باهر % % 4(@)(@@) % يناديك يا مدهوش لو كنت سامعا % % فتلهيك عن ذاك النداء الخواطر % % 5(@)(@@) % وكنت بعيدا ثم جئت فلم تكن % % لأنك عن معنى التصور قاصر % % 6(@)(@@) % ومن تحت تحت التحت عندي إشارة % % إلى فوق فوق الفوق والغير حائر % % 7(@)(@@) % إذا قلت حرفا جاء معنى لها وإن % % سكت بموج البحر تبدو الجواهر % % PageV01P646 البحر : - 1(@)(@@) % رب شخص تقوده الأقدار % % للمعالي وما لذاك اختيار % % 2(@)(@@) % غافل والسعادة احتضنته % % وهو منها مستوحش نفار % % 3(@)(@@) % يتعاطى القبيح عمدا فيلقاه % % جميلا وفلسه دينار % % 4(@)(@@) % كلما قارف الذنوب أتته % % توبة طهرته واستغفار % % 5(@)(@@) % وعليه إن زل عين من الله تقيه ويستر الستار 
ms135	 % . . . % 6(@)(@@) % فهو بالله دائما يترقى % % لا به حيث تشرق الأنوار % % 7(@)(@@) % وفتى كابد العبادة حتى % % منه قد ملء ليلة والنهار % % 8(@)(@@) % يتسامى بالذكر والفكر قصدا % % وهو ناء وعنه شط المزار % % 9(@)(@@) % يفعل الخير ثم يلقاه شرا % % وإذا رام جنة فهي نار % % 10(@)(@@) % حكم حارت البرية فيها % % وحقيق بأنها تحتار % % PageV01P647 11(@)(@@) % وعطايا من المهيمن دلت % % أنه الله فاعل مختار % % PageV01P648 البحر : - 1(@)(@@) % إن السماع سماع الناي والوتر % % يسقي أراضي نفوس الناس كالمطر % % 2(@)(@@) % فإن يكن في النفوس الخبث أنبته % % وبالشقاء له نوع من الثمر % % 3(@)(@@) % وإن يكن في النفوس الطيب فاح له % % بين البرية ريا عنبر عطر فاكشف بعقلك عما أنت فيه وكن من التباس أمور النفس في حذر % % 4(@)(@@) % وكل من قال بالتحريم مقصده % % تحذير ذي الخبث من مستحكم الشرر % % 5(@)(@@) % ومن يقل فيه بالتحليل فهو على % % إرشاد ذي الطيب للتذكار والفكر % % 6(@)(@@) % ومقصد الكل في الإسلام منفعة % % حاشا بأن يقصدوا للناس من ضرر % % 7(@)(@@) % ولا تسىء في الورى ظنا بجهلك من % % حاز الكمال وعنه كنت في قصر % % 8(@)(@@) % أقم على نفسك الميزان معترفا % % بالجهل عن كل من لم تدر في البشر % % 9(@)(@@) % فإن لله في طي الوجود على % % مر الزمان زكيات من الفطر % % PageV01P649 البحر : - 1(@)(@@) % قيل لي كن مع الأنام ودار % % كل شخص فقلت ما الذل قدري % % 2(@)(@@) % أنا عبد الغني لا عبد زيد % % من جميع الورى ولا عبد عمرو % % PageV01P650 البحر : - 1(@)(@@) % أقول لجمعكم يا أهل عصري % % أيا فقراء للرب الخبير % % 2(@)(@@) % أنا عبد الغني فكيف أرجو % % سواه وما أنا عبد الفقير % % PageV01P651 البحر : - 1(@)(@@) % حروف المباني والمعاني تنزهت % % مقاصدها فهي التي لم تكن تقرا % % 2(@)(@@) % فإن رمت يا أولى سواك محققا % % عليك بك افهم منصفا أنك الأحرى % % 3(@)(@@) % وفوق مقام القصد للكل مقصد % % إليك أتى باعا إذا جئته شبرا % % 4(@)(@@) % تحقق بآثار الأواني مجانبا % % بروق المعاني فالعظيم بنا أحرى % % 5(@)(@@) % عليك سلام الله يا طالب الهدى % % مدى الدهر ما مالت غصون الحمى سكرى % % PageV01P652 البحر : - 1(@)(@@) % بالله إذا نفخت في مزماري 
ms136	 % % فاضرب دفي محركا أوتاري % % 2(@)(@@) % وأطرب سمعي بصوت جمعي كرما % % واملأ قدحي وغن يا خماري % % PageV01P653 البحر : - 1(@)(@@) % قف بي هذا الحمى وهذا النور % % فالقلب بما بدا له مسرور % % 2(@)(@@) % واشرح أحوالنا لهم يا حادي % % إني في حبهم بهم مأسور % % PageV01P654 البحر : - 1(@)(@@) % كن عادلا في أمورك لا تكن جاير % % للحب تطلب وأنت الحب يا حاير % % 2(@)(@@) % أما سمعت الذي فيه المثل ساير % % حبي معي وعلى حبي أنا داير % % PageV01P655 البحر : - 1(@)(@@) % لطائر السر في أوج الرقيقة وكر % % ضع حبة القلب له وانصب فخاخ الذكر % % 2(@)(@@) % واستنزله عل ينزل بالرداح البكر % % عليك يوما فتنجو من قيود الفكر % % PageV01P656 البحر : - 1(@)(@@) % ما الخلق سوى خرير نهر الكوثر % % قد جاء هذا في حديث يؤثر % % 2(@)(@@) % والذات هي الجنة بل ما فيها % % فهي الأسماء فاعتبر من أثر % % PageV01P657 البحر : - 1(@)(@@) % دارنا هذه هي الأشجار % % وعليها جسومنا أزهار % % 2(@)(@@) % والنفوس التي إذا زال عنها % % قشر جسم تبقى هي الأثمار % % 3(@)(@@) % فأدر نحو نفسك العقل ربطا % % لك ينحل ما به ما به الكل حاروا % % 4(@)(@@) % واحفظ القلب واحتفظ باطنا من % % كل سوء وكل ما هو عار % % 5(@)(@@) % واترك الغير لا تفتش عليه % % يشغل العقل منك عنك الفشار % % 6(@)(@@) % جعل الله بعضنا فتنة للبعض % % حيث استغنا وحيث افتقار % % 7(@)(@@) % وعليكم قد قال أنفسكم يا % % صاح فارشد وإن غوت أغيار % % 8(@)(@@) % وتنبه فحكم إنا جعلنا % % ما على الأرض زينة غرار % % 9(@)(@@) % هذه نفثة النصوح فأزيلت % % بالتقى الخوف درها والحذار % % 10(@)(@@) % حثت العيس للحمى فأزيلت % % بالتقى عن ظهورها الأوقار % % PageV01P658 11(@)(@@) % قف على باب حانتي يا نديمي % % عل يرضى دخولك الخمار % % 12(@)(@@) % واستمع صوت قينتي تتغنى % % حيث جسمي في كفها مزمار % % 13(@)(@@) % وجميع الوجود ليل لقوم % % جهلوا وهو عند قوم نهار % % 14(@)(@@) % وجنان النعيم عند أناس % % وأناس ذا عندهم هو نار % % 15(@)(@@) % فاعتبر ما أقوله لك وافهم % % حسن الفهم منك والاعتبار % % PageV01P659 البحر : - 1(@)(@@) % يا بديع الحسن بالصور % % جئتنا في هيكل البشر % % 2(@)(@@) % ثم لما كنت مرتفعا % % عن وصول العقل والبصر % % 3(@)(@@) % كان ما قد 
ms137	 كان منك لنا % % بالقضاء الحق والقدر % % 4(@)(@@) % كل شي آي ظهرت % % عبرة فينا لمعتبر % % 5(@)(@@) % وجميع الكون أمثلة % % عند أهل الفهم والنظر % % 6(@)(@@) % علم قومي كله ورق % % وعلومي فيه كالثمر % % 7(@)(@@) % وكلامي عند عارفه % % ليس معناه بمستتر % % 8(@)(@@) % لا على معنى الحلول ولا % % باتحاد يا أولي الحذر % % 9(@)(@@) % لي فؤاد يا وجود قضى % % زيده ما فيك من وطر % % 10(@)(@@) % أنت فينا ظاهر أبدا % % كظهور الشمس في القمر % % PageV01P660 11(@)(@@) % أو كمثل الظل يكشف عن % % هيئة الأوراق والشجر % % 12(@)(@@) % أو كمرآة يلوح بها % % ما يدانيها من الصور % % 13(@)(@@) % جل وجه منك نحن له % % سترة في العقل والفكر % % 14(@)(@@) % وظهور في القلوب لمن هو من جهل النفوس بري آمنت قوم ظهرت لهم % % في جميع النفع والضرر % % 15(@)(@@) % وجهك الميمون قبلتهم % % وعليه الكل كالقتر % % 16(@)(@@) % خرجوا للكائنات كما % % خرج المختار للمطر ثم قاب القوس منك دنوا حين رنت نغمة الوتر % % 17(@)(@@) % وسعوا من نحو مروتهم % % للصفا عن سائر الكدر % % 18(@)(@@) % بالسوى ليسوا على خطر % % والسوى منهم على خطر % % PageV01P661 البحر : - 1(@)(@@) % يا مثمرا قبل ينبت % . . . % 2(@)(@@) % في قلبه الجهل ينكت % . . . % 3(@)(@@) % دع ينطق الحق واسكت % . . . % 4(@)(@@) % لا تحسبن أن بالكتب مثلما ستصير % . . . % 5(@)(@@) % ما الأنس قلب وحيش % . . . % 6(@)(@@) % بفكره مستجيش % . . . % 7(@)(@@) % له خيال مطيش % . . . % 8(@)(@@) % وللدجاجة ريش % % لكنها لا تطير % % PageV01P662 البحر : - 1(@)(@@) % هلا غنيتم بما غنى به الوتر % % فتسمعوا منه يا عشاقه وتروا % % 2(@)(@@) % فإن في نغمة الطنبور بارقة % % من البروق التي في القلب تستعر % % 3(@)(@@) % واستنطقوا الدف ينطق بالإشارة عن % % معنى بدا وهو في الأكوان مستتر % % 4(@)(@@) % وهي المعاني تراءت في السماع لنا % % عنها لقد كان محجوبا بها البصر % % 5(@)(@@) % وأخبرتنا إشارات الصنوج بها % % فهيم القلب منا ذلك الخبر % % 6(@)(@@) % حتى انعطفنا على السنطير نسأله % % عن عينه فتبدى منه لي ثر % % 7(@)(@@) % وقال لي الناي إني من إشارته % % ونفخ روحي منه تبعث الصور % % 8(@)(@@) % والعود عاد بصوت في الغناء شج % % وقال نحن وأنتم كلنا عبر % % 9(@)(@@) % ونسبة الأمر منا في الوجود سوا % % ومن مشى 
ms138	 في ظلام غره القمر % % 10(@)(@@) % وما السماع بهادي العاشقين له % % ما لم يكن حاصلا من قبله النظر % % PageV01P663 البحر : - 1(@)(@@) % تبارك الله ما في الدار ديار % % وإنما هي نيران وأنوار % % 2(@)(@@) % وقد أماطت سليمى عن براقعها % % فوجهها مشرق والطرف سحار % % 3(@)(@@) % وما الجميع سوى إشراق بهجتها % % دوائر كلهم عنها وأدوار % % 4(@)(@@) % إن أومأت كانت الأكوان ظاهرة % % عنها وإلا ففيها الكل أسرار % % 5(@)(@@) % جلت عيون بها لها نظرت % % في صبغ الكون حيث الكون أطوار % % 6(@)(@@) % يا مالك الملك منا قد ظهرت لنا % % وأنت أعياننا والاسم أغيار % % 7(@)(@@) % ملكتنا فملكنا ما ملكت وعن % % ذواتنا قد أميطت منك أستار % % 8(@)(@@) % وإنما هي ذات بالورى كثرت % % فقل شموس وقل إن شئت أقمار % % 9(@)(@@) % رنات أوتار أسماء لذاتك لا % % كما يقولون رنات وأوتار % % 10(@)(@@) % بها طربنا وفيها أنت مطربنا % % وما لغيرك إسماع وإبصار % % PageV01P664 11(@)(@@) % سقيتنا أيها الساقي بأكؤسنا % % خمر التجلي وفينا دب إسكار % % 12(@)(@@) % ونحن كأس وأنت الخمر نشربه % % وكل معنى أتانا منك خمار % % 13(@)(@@) % كتبتنا بك في ألواح نشأتنا % % فنحن عنك أحاديث وأخبار % % 14(@)(@@) % صرف الوجود به عنه الشؤون بدت % % كما الدخان له قد أبدت النار % % 15(@)(@@) % وما كذلك نفس الأمر في نظري % % وإنما نحن يا مولاي أحرار % % 16(@)(@@) % وإننا أنت لا شيء سواك هنا % % ولكن الحكم هتاك وستار % % 17(@)(@@) % إيماء جفنك يا ذا العين يظهرنا % % فأتقياء كما شاءت وأبرار % % 18(@)(@@) % وأنت أنت على ما أنت من قدم % % ونحن نحن فلا نقص ولا عار % % 19(@)(@@) % وهذه نسب أنت اعتبرت لها % % فيها فكان لهم كتم وإظهار % % 20(@)(@@) % وحاصل الأمر أن الأمر حاصله % % هذا ولكنه بالغير غرار % % PageV01P665 21(@)(@@) % الله أكبر لا يدري مقالتنا % % في كوننا غيرنا والكل محتار % % 22(@)(@@) % الله أكبر لا يدري مقالتنا % % في كوننا غيرنا والكل محتار % % 23(@)(@@) % الله أكبر نحن الغائبون به % % عنا وليس لنا في ذاك آثار ولا سوانا من الأكوان يعرفنا والغيب نحن وهذا القول إضمار الله أكبر عزت ذاته وعلت فليس تدرك آراء وأنظار % % 24(@)(@@) % وهو العليم به في الكل ليس 
ms139	 له % % عنه خفاء فذو لطف وجبار % % 25(@)(@@) % بدا فقالوا هي الأرواح قد حكمت % % على جسوم لها في الكون أعمار % % 26(@)(@@) % وهو الخفي فلا أرواح تعرفه % % ولا جسوم وحارت فيه أفكار % % 27(@)(@@) % فإن يشأ يهتدي كل إليه بما قد ضل فيه وعنه زال اكفار وإن يشأ فيما قد آمنت كفرت % % قوم وإن شاء فالإقلال إكثار % % 28(@)(@@) % حقيقة ما اقتضى شيء لها أثرا % % ترومه فهي إيراد وإصدار % % 29(@)(@@) % ولم نقل مثل ما قد قال شاعرهم % % وإنما هي إقبال وإدبار % % 30(@)(@@) % أنا الذي قول محيي الدين قلت به % % بيتين ضمنهما للناس تذكار % % PageV01P666 31(@)(@@) % البحر بحر على ما كان من قدم % % إن الحوادث أمواج وأنهار % % 32(@)(@@) % ولا أقول بتكرار الوجود ولا % % عود التجلي فما في الأمر تكرار % % PageV01P667 البحر : - 1(@)(@@) % دوائر أوهام بها شغل الفكر % % فظاهرها خلق وباطنها أمر % % PageV01P668 @ 4 417 7 @ @ PageV01P669 البحر : - 1(@)(@@) % دوار أوهام بها شغل الفكر % % فظاهرها خلق وباطنها أمر % % 2(@)(@@) % فتوحات محيي الدين عنها عبارة % % أتتنا من البكري مشرقة بكر % % 3(@)(@@) % فهمنا بها لما فهمنا خطابها % % وفي قولنا قد بان من بحرها الدر % % 4(@)(@@) % وذلك علم العين بالغين نقطة % % هي الكاس والسر الإلهي هو الخمر % % 5(@)(@@) % وما العين إلا الغين بالذات باطنا % % كما ظاهرا بالوصف ثناهما الذكر % % 6(@)(@@) % مقام أولي التحقيق كالشمس رفعة % % ومرتبة الإفصاح عنهم هي البدر % % 7(@)(@@) % ولم ينتقل شيء إلى البدر في السما % % من الشمس بل طي الضياء له نشر % % 8(@)(@@) % فغيرية الأعيان خلق لأنها % % بظاهرها الفاني الكثير هي المكر % % 9(@)(@@) % وباطنها الباقي الذي هو واحد % % هدى حيث لا زيد هناك ولا عمرو وما تم إلا الوهم قوة حضرة إلهية عنها بدا السر والجهر % % 10(@)(@@) % تجلت كما شاءت وشاءت كما درت % % وتدري كما يعطيه في نفسه الأمر % % PageV01P670 11(@)(@@) % فكنها على غيب ولا كنه ترتجي % % لها فسواها موجها وهي البحر % % 12(@)(@@) % وما حل في الأمواج بحر ولا به % % قد اتحدت بل تلك عنه لها البر % % 13(@)(@@) % ولا هي حلت فيه إذ لم يكن لها % % وجود سواه وهي منه لها 
ms140	 قدر % % 14(@)(@@) % هو الحق والأكوان قاموا به له % % كما صور التخييل يحفظها الفكر % % PageV01P671 البحر : - 1(@)(@@) % بنغم العود لاح لي أثر % . . . % 2(@)(@@) % أفهمني أن كلنا صور % . . . % 3(@)(@@) % فقلت لما تبدت العبر % . . . % 4(@)(@@) % حدث عن الوتر أيها الوتر % % من فاته الخبر سره الخبر % % 5(@)(@@) % يا عود كم أنت أسر وسوسة % . . . % 6(@)(@@) % رقق لنا الصوت في مؤانسة % . . . % 7(@)(@@) % عن حالة في الهوى مؤسسة % . . . % 8(@)(@@) % وهات عن ليلة مقدسة % % طابت فعندي جميعها سحر % % 9(@)(@@) % سري بك الآن قد غدا علنا % . . . % 10(@)(@@) % ومن غرامي ثرت مكتمنا % . . . % PageV01P672 11(@)(@@) % طب نغمة لي ومسمعا حسنا % . . . % 12(@)(@@) % وقل كما شئت إن لي أذنا % % تتلى عليها بلحنك السور % % 13(@)(@@) % منك ضلوعي قد ذاب أجمعها % . . . % 14(@)(@@) % ومقلتي تستهل أدمعها % . . . % 15(@)(@@) % والأذن مني غناك يصدعها % . . . % 16(@)(@@) % مصغية للحبيب يسمعها % % آيات حق لم تسمع البشر % % 17(@)(@@) % هاجت لشوقي صبا يمانية % . . . % 18(@)(@@) % ومهجتي للهوى معانية % . . . % 19(@)(@@) % قلت وأعوادنا مدانية % . . . % 20(@)(@@) % يا وترا حركته غانية % % لا وأبي ليس ذاك يا وتر % % PageV01P673 21(@)(@@) % طنبورنا قد عشقت نغمته % . . . % 22(@)(@@) % ولست أنسى الغداة رنته % . . . % 23(@)(@@) % كم قلت لما شهدت بهجته % . . . % 24(@)(@@) % قد أودع الوتر فيك حكمته % % فمنه لا منك تطرب الفطر % % PageV01P674 البحر : - 1(@)(@@) % ظهرت في أطواري % % ولحت في أوطاري % % 2(@)(@@) % وأحرقت أنواري % % بنارها أغياري % % PageV01P675 البحر : - 1(@)(@@) % تمتعوا أحبابي % % بفتح هذا الباب % % 2(@)(@@) % ومزقوا أثوابي % % وجانبوا أستاري % % PageV01P676 البحر : - 1(@)(@@) % هذا شرابي رائق % % هذا جمالي فائق % % 2(@)(@@) % قد حقت الحقائق % % في طلعة الأقمار % % PageV01P677 البحر : - 1(@)(@@) % من يعترض علينا % % لا يهتدي إلينا % % 2(@)(@@) % إنا قد استغنينا % % عن أهل هذي الدار % % PageV01P678 البحر : - 1(@)(@@) % بالله يا عذالي % % فما لكم وما لي % % 2(@)(@@) % خلوا لقلبي حالي % % لا تدخلوا في عاري % % PageV01P679 البحر : - 1(@)(@@) % قد لاح وجه المالك % % وكل شيء هالك % % 2(@)(@@) % يعرف هذا السالك % % في طرق الأسرار % % PageV01P680 البحر : - 1(@)(@@) % أنا حبيبي حاضر % % وهو لحالي ناظر % % 2(@)(@@) % وأعمش النواظر % % فليس لي يجاري % % PageV01P681 البحر : - 1(@)(@@) % سمعت صوت الحادي % % فلذ لي اتحادي % % 2(@)(@@) % وطابت البوادي % % لمن يكون ساري % % 3(@)(@@) % صلي إله الناس % % على النبي الرأسي % % 4(@)(@@) % والنور في 