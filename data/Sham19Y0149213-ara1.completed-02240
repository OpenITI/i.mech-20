ms2223	 م 4]: أبو زميل (1) الحنفي سماك بن الوليد.(@)(@@)(@@)(@@) $$$ [ع]: أبو الزناد (1) عبد الله بن ذكوان.(@)(@@)(@@)(@@) $ 8156 - [ق]: أبو زهير (2) الثقفي له صحبة، يقال: معاذ، ويقال:(@)(@@) عمار بن حميد.(@)(@@) وعنه: ابنه أبو بكر "خطبنا النبي - صلى الله عليه وسلم - بالبناوة" (3).(@)(@@)(@@)(@@) $$$ [بخ 4]: أبو زهير (2) عبد الرحمن بن مغراء.(@)(@@)(@@)(@@) $$$ [س]: أبو زهير (4) الأزدي العلاء بن زهير.(@)(@@)(@@)(@@) $$$ [د]: أبو زهير (4) النميري، ويقال: أبو الأزهر. تقدم.(@)(@@)(@@)(@@) $$$ [د س]: أبو زياد (4) الشامي خيار، سمع عائشة.(@)(@@)(@@)(@@) $ 8157 - أبو زياد (4) الغساني شامي أيضا، واسمه يحيى بن عبيد.(@)(@@) عن: سليمان بن سلمة.(@)(@@) وعنه: حريز بن عثمان وغيره.(@)(@@) ذكر للتمييز.(@)(@@)(@@)(@@) $ 8158 - [د]: أبو زياد (5) الكلابي صاحب اللغة.(@)(@@) في تفسير أسنان الإبل (6) قال أبو داود: بلغني عنه.(@)(@@)(@@)(@@) $$$ [د]: أبو [زياد] (7) عبيد الله بن [زيادة] (8) الشامي تابعي.(@)(@)PageV10P267(@)(@)(@@)(@@)(@@) $$$ [م 4]: أبو زيد (1) الأنصاري عمرو بن أخطب.(@)(@@)(@@)(@@) $$$ [د ت]: أبو زيد (2) الإنصاري النحوي سعيد بن أوس.(@)(@@)(@@)(@@) $ 8159 - [د ت ق]: أبو زيد (3) المخزومي، وقيل: أبو زايد، مولى(@)(@@) عمرو بن حريث.(@)(@@) عن: ابن مسعود.(@)(@@) وعنه: أبو فزارة.(@)(@@) قال أبو بكر بن أبي داود: كان أبو زيد نباذا بالكوفة.(@)(@@)(@@)(@@) $$$ [خ م ت س]: أبو زيد (4) الهروي سعيد بن الربيع.(@)(@@)(@@)(@@) $ 8160 - [د ق]: أبو زيد (5) مولى بني ثعلبة، يقال: الوليد.(@)(@@) عن: معقل بن أبي معقل الأسدي.(@)(@@) وعنه: عمرو بن يحيى بن عمارة.(@)(@@)(@@)(@@) $ 8161 - [ق]: أبو زيد (6).(@)(@@) عن: أبي المغيرة.(@)(@@) وعنه: بشر بن منصور.(@)(@@) قال أبو زرعة: لا أعرف الثلاثة .. وحديثه "أبى الله أن يقبل عمل PageV10P268(@)(@@) صاحب بدعة" (1).(@)(@@)(@@)(@@) $ 8162 - [س]: أبو زيد (2).(@)(@@) عن: أبي هريرة، في "سوار الذهب للمرأة" (3).(@)(@@) وعنه: أبو الجهم سليمان بن الجهم.(@)(@@)(@@)(@@) $ 8163 - [ق]: أبو زينب (4).(@)(@@) عن: مولاه حازم بن حرملة، وأبي ذر.(@)(@@) وعنه: نعيم المجمر، وخالد بن سعيد بن أبي مريم.(@)(@)PageV10P269(@)(@)(@@)(@@)(@@) || حرف السين(@)(@@)(@@)(@@) $$$ [م د س ق]: أبو ساسان (1) الرقاشي، حضين بن المنذر.(@)(@@)(@@)(@@) $$$ [م د س]: أبو سالم (1) الجيشاني، سفيان بن هانئ.(@)(@@)(@@)(@@) $ 8164 - [ر م 4]: أبو السائب (2) الأنصاري المدني، مولى هشام بن(@)(@@) زهرة.(@)(@@) عن: المغيرة بن شعبة، وأبي هريرة، وأبي سعيد.(@)(@@) وعنه: العلاء بن عبد الرحمن، 
ms2224	 وبكير بن الأشج، وصيفي مولى(@)(@@) أفلح، والزهري، وجماعة.(@)(@@) ذكره ابن حبان في "الثقات".(@)(@@)(@@)(@@) $$$ [ت ق]: أبو السائب (3) الكوفي، سلم بن جنادة.(@)(@@)(@@)(@@) $$$ [مد]: أبو سبأ (4) التنوخي، عتبة بن تميم.(@)(@@)(@@)(@@) $ 8165 - [د ت ق]: أبو سبرة (4) النخعي الكوفي، يقال: عبد الله بن(@)(@@) عباس.(@)(@@) عن: فروة بن مسيك، ومحمد بن كعب.(@)(@@) وعنه: الأعمش، والحسن بن الحكم، وغيرهما.(@)(@@) في "الثقات" لابن حبان.(@)(@@)(@@)(@@) $ 8166 - [عس]: أبو سخيلة (5).(@)(@)PageV10P270(@)(@)(@@) عن: علي، وسلمان، وأبي ذر.(@)(@@) عنه: الخضر بن القواس، وفضل بن مرزوق، والعرزمي.(@)(@@)(@@)(@@) $$$ [خ د ت س]: أبو سروعة (1) القرشي، عقبة بن الحارث، له صحبة.(@)(@@)(@@)(@@) $$$ [م 4]: أبو سريحة (1) الغفاري حذيفة بن أسيد.(@)(@@)(@@)(@@) $ 8167 - [ت ق]: أبو سعد (2) بن أبي فضالة الأنصاري، له صحبة(@)(@@) ورواية.(@)(@@) وعنه: زياد بن ميناء "الله أغنى الشركاء عن الشرك" (3).(@)(@@)(@@)(@@) $ 8168 - [ت ق]: أبو سعد (4) الأزدي الكوفي، قارئ الأزد، ويقال:(@)(@@) أبو سعيد.(@)(@@) عن: زيد بن أرقم، وأبي الكنود.(@)(@@) وعنه: إسماعيل السدي، ويزيد بن أبي زياد، وسليمان بن قيس.(@)(@@) في "الثقات" لابن حبان.(@)(@@)(@@)(@@) $$$ [بخ د ق]: أبو سعد (4) شرحبيل بن سعد.(@)(@@)(@@)(@@) $$$ [س]: أبو سعد (5) الأنصاري، أو أبو سعيد، يأتي.(@)(@@)(@@)(@@) $$$ [بخ ت ق]: أبو سعد (6) البقال، سعيد بن المرزبان.(@)(@)PageV10P271(@)(@)(@@)(@@)(@@) $ 8169 - [د]: أبو سعد (1) الحميري، حمصي.(@)(@@) عن: أبي هريرة، وواثلة بن الأسقع.(@)(@@) وعنه: فرج بن فضالة.(@)(@@)(@@)(@@) $ 8170 - [ق]: أبو سعد (2) الساعدي.(@)(@@) عن: أنس، حديث "رأى رجلا يتبع حمامة" (3).(@)(@@) وعنه: رواد بن الجراح، فقط.(@)(@@) قال أبو زرعة وأبو حاتم: مجهول.(@)(@@)(@@)(@@) $$$ ت: أبو سعد (2) الصاغاني محمد بن ميسر.(@)(@@)(@@)(@@) $ 8171 - [ق]: أبو سعد (4) المدني، ويقال: إنه شرحبيل بن سعد.(@)(@@) عن: أبي رافع.(@)(@@) وعنه: مخول بن راشد.(@)(@@)(@@)(@@) $ 8172 - أبو سعد الأعمى (4).(@)(@@) عن: أبي هريرة، وغيره.(@)(@@) وعنه: ابن جريج.(@)(@@) وروى له ابن ماجه، قال المزي: لم أقف على ذلك.(@)(@@)(@@)(@@) $$$ دق: أبو سعد (4) الخير، أو أبو سعيد الحبراني، يأتي.(@)(@)