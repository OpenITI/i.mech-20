ms1268	 قال النبي :(@)(@@) | 30 ( حدثوا عني بما تسمعون ولا تقولوا إلا حقا ، ومن كذب علي بني له بيت في جهنم يرتع فيه ) )(@)(@@) ( طب ) عن أبي قرصافة رضي الله عنه .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 11208 ) قال النبي :(@)(@@) | 30 ( حد يعمل في الأرض خير لأهل الأرض من أن يمطروا ثلاثين صباحا ) )(@)(@@) ( حم ن ه ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11209 ) قال النبي :(@)(@@) | 30 ( حدثه بذالك فإنه أثبت للود وأحسن للالفة ) )(@)(@@) هناد عن عمرو بن مرة أن رجلا قال : يا رسول الله إني أحب هاذا في الله قال : فذكره .(@)(@@)(@@)(@@) $ ( 11210 ) قال النبي :(@)(@@) | 30 ( حدثوا عني ولا حرج ، حدثوا عني ولا تكذبوا علي ، ومن كذب علي متعمدا فقد تبوأ مقعده من النار ، وحدثوا عن بني إسرائيل ولا حرج ) )(@)(@@) ( ع ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11211 ) قال النبي :(@)(@@) | 30 ( حدثوا عن بني إسرائيل ولا حرج ، وحدثوا عني ولا تكذبوااعلي ) )(@)(@@) الشافعي ( ت ) في المعرفة عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11212 ) قال النبي :(@)(@@) | 30 ( حدثوا عني كما سمعتم ولا حرج إلا من افترى على الله كذبا متعمدا ليضل به الناس بغير علم فليتبوأ مقعده من النار ) )(@)(@@) ( كر ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11213 ) قال النبي :(@)(@@) | 30 ( حدثوا عن بني إسرائيل ولا حرج فإنه كانت فيهم الأعاجيب ، خرجت طائفة منهم فأتوا مقبرة من مقابرهم فقالوا : لو صلينا ركعتين فدعونا الله عز وجل يخرج لنا بعض الأموات يخبرنا عن الموت ففعلوا فبينما هم PageV04P220 كذالك إذ أطلع رجل رأسه في قبر بين عينيه أثر السجود فقال : يا هاؤلاء ما أردتم إلي ، فوالله لقد مت منذ مائة سنة فما سكنت عني حرارة الموت حتى كان الآن ، فادعوا الله أن يعيدني كما كنت ) )(@)(@@) عبد بن حميد ( ع ) وابن منيع ( ض ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 11214 ) قال النبي :(@)(@@) | 30 ( حديثكم بينكم أمانة ، ولا يحل لمؤمن أن يرفع على مؤمن قبيحا ) )(@)(@@) أبو نعيم في المعرفة عن محمد بن هشام مرسلا ، قال أبو أحمد القاضي : محمد بن هشام له صحبة ، وقال ابن 
