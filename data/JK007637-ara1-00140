ms121	 % % 15(@)(@@) % لا يستميل الهوى منا النفوس ولا % حب البقا عن سبيل المجد يثنينا % % 16(@)(@@) % ماذا يعيب العدا منا سوى حسب % ضخم ؛ به ساد قاصينا ودانينا % % 17(@)(@@) % وإننا لو دعونا الدهر نأمره % لقام طوعا يلبي صوت داعينا ؛ % 18(@)(@@) % ما ناب جارا لنا في الدهر نائبة % إلا وكنا إذن عنه المحامينا % % 19(@)(@@) % يا من يسائل عن قومي ؛ رويدك ما % % جهلت إلا العلى والمجد والدنيا . % 20(@)(@@) % قومي الألى ما انتضوا أسيافهم لوغى % إلا وعاودوا لآي النصر تالينا ؛ % PageV01P571 21(@)(@@) % قوم إذا لبسوا ثوب القتام غدت % أعداؤهم في ثياب النصر عارينا % % 22(@)(@@) % إن تلقهم تلق أحبارا جهابذة ؛ % أو طاعنين العدا شزرا ورامينا % % 23(@)(@@) % قاموا مع القاسم المنصور واجتهدوا % % وجرعوا الترك زقوما وغسلينا ؛ % 24(@)(@@) % و للمؤيد قد أذكت صوارمنا % % وقائعا أذكرت بدرا وصفينا ؛ % 25(@)(@@) % وقائم العصر اسماعيل قد نصرت % سيوفنا وأجابته عوالينا ؛ % 26(@)(@@) % لم نأل جهدا إذن في بث دعوته % إذ قام فينا بأمر الله يدعونا ؛ % 27(@)(@@) % وحب آل رسول الله شيمتنا % % وفخر حاضرنا دوما وبادينا ؛ % 28(@)(@@) % سل الأئمة عنا أي ملحمة % لسنا بأرواحنا فيها مواسينا % % 29(@)(@@) % مضت على حب أهل البيت أسرتنا ؛ % ونحن نمشي على آثار ماضينا ؛ % 30(@)(@@) % فمن يفاخرنا أم من يساجلنا % % أم من يطاولنا أم من يدانينا % % PageV01P572 31(@)(@@) % يكفيك أن لنا الفخر الطويلعلى % % كل الورى ما عدى الآل الميامينا % % 32(@)(@@) % عليهم بعد خير الرسل جدهم % % أزكى وأفضل ما صلى المصلونا . . % PageV01P573 البحر : - 1(@)(@@) % أأطيع العذول في السلوان % لا ؛ ومن قد أضله وهداني % % 2(@)(@@) % يا عذولي في الحب دعني ؛ فإني % % فيه راض بذلتي وهواني ؛ % 3(@)(@@) % وبروحي الذي تركت منامي % % فيه وقفا لطرفه الوسنان . % 4(@)(@@) % غير نكر ؛ إن فاض شاني بالدمع % % على حبه ؛ فدعني وشاني . % 5(@)(@@) % كلما زاد عن وصالي بعدا . . % زدت فيه بعدا عن السلوان ؛ % 6(@)(@@) % ورداح خود إلى الله أشكو % % جور ألحاظها وجورزماني ؛ % 7(@)(@@) % كلما قلت سوف يجنح للسلم ؛ % أتى صرفه بحرب عوان % 8(@)(@@) % كم أروم اكتساب مجد رفيع ؛ % وصروف الزمان تثني عناني % % 9(@)(@@) % وأرجي ابتناء بيت فخار ؛ % وهو مغرى بهدم ما أنا باني 
ms122	 % % 10(@)(@@) % كيف صبري على هوان ؛ % ومن دون مرامي وهمتي الفرقدان % % PageV01P574 11(@)(@@) % مت كريما ؛ فالموت أجدر بالأحرار % من عيش ذلة وهوان % 12(@)(@@) % ودع الحرص ويك واستغن % بالله تعالى عن كل قاص وداني ؛ % 13(@)(@@) % وتغرب ففي التغرب ما شئت % من العز مع بلوغ الأماني ؛ % 14(@)(@@) % فأرى البيض ليس تقطع حتى % % تتناءى يوما عن الأجفان % 15(@)(@@) % وحسود يروم نيل مكاني % % في المعالي ؛ وأين أين مكاني % % 16(@)(@@) % لا يراني إلا بمقلته الحوصا ؛ % ومن لي بأنه لا يراني % % 17(@)(@@) % أي عار على الشموس إذا ما % % خفيت عن نواظر العميان % % PageV01P575 البحر : - 1(@)(@@) % سقى العقيق ؛ فالديار فاللوى % % سحائب تضحك منهن الربى % % 2(@)(@@) % وجادها هامي الغمام رائحا % على رباها غاديا كما تشا ؛ % 3(@)(@@) % ولا خلت عن أهلها طول المدى % % ولا تخطى نحوها صرف القضا ؛ % 4(@)(@@) % فكم بها من أغيد مهفهف % تخجل من الحاظه بيض الظبى ؛ % 5(@)(@@) % له على رغمي كما شاء الهوى % % مني صفا الود ؛ ولي منه القلى % % 6(@)(@@) % ساجي الرنا ؛ يمشي بقد أهيف % يهزؤ بالغصن الرطيب إن مشا % % 7(@)(@@) % يكاد غصن البان يحكي لينه % % وقده يقول مهلا لا سوا . . % 8(@)(@@) % أظل من غرته وفرعه % مولها بين الصباح والمسا ؛ % 9(@)(@@) % يسومني العاذل فيه سلوة % ولي فؤاد عن هواه ما سلا ؛ % 10(@)(@@) % يا عاذلي والله لو رأيته % لقيت منه ما لقيت من عنا ؛ % PageV01P576 11(@)(@@) % كم ذا أقضي زمني في حبه ؛ % معللا ما بين يأس ورجا % % 12(@)(@@) % وكم بوعد وصله أطمعني % % حتى إذا استنجزته الوعد لوى % % 13(@)(@@) % وحالت الأيام دون وصله % كأنما تحسدني على اللقا % % 14(@)(@@) % مالي وللدهر الخؤون لم يزل % علي للأعداء سيفا منتضى % % 15(@)(@@) % كم ذا أغض مقلتي على الأذى % % منه وكم أحمل ما يوهي القوى % % 16(@)(@@) % وهكذا كل جواد سابق % من الورى تعيده إلى الورا . % 17(@)(@@) % يا طالما عللت نفسي بالمنى ؛ % وما عسى تجدي لعل وعسى % % 18(@)(@@) % لأجعلن الصبر لي خلقا ومن % يصبر ينل بصبره أقصى المنى ؛ % 19(@)(@@) % فرب هم قد عرا ثم انجلى % % ورب يسر بعد عسر قد أتى ؛ % 20(@)(@@) % كم فرج قد جاء بعد شدة 
ms123	 % وحالة حولها الله إلى . ؛ % PageV01P577 21(@)(@@) % أما من حج ولبى ودعا % % وجاء بالدين الحنيف المرتضى ؛ % 22(@)(@@) % لو لم يكن علي دين جائر % ولم تكن عندي حقوق للورى % % 23(@)(@@) % لأرفضن هذه الدنيا إلى الأخرى % % وحسبي بدلا وحبذا ؛ % 24(@)(@@) % وألزم النفس العفاف قائلا % للعمر المقبل كن كما مضى ؛ % 25(@)(@@) % ولم أعاتب سيف حظي إن نبا ؛ % ولم اقل لزمني حتى متى % % 26(@)(@@) % لكن حقوق قد ثناني الفقر عن % قضائها ؛ والحق دين يقتضى ؛ % 27(@)(@@) % وثقل دين قد أذاب جسدي % % وترك الطرف سميرا للسهى ؛ % 28(@)(@@) % عسى وعل فرج معجل % من خالقي يكشف هما قد عرى ؛ % 29(@)(@@) % ثم الصلاة والسلام ما بدا % % نور وما غاب الظلام واختفى ؛ % 30(@)(@@) % على النبي المصطفى أكرم من % أرسله رب السموات العلى ؛ % PageV01P578 31(@)(@@) % وصنوه حيدرة الكرار من % باهى به الرحمن أملاك السما ؛ % 32(@)(@@) % والآل أرباب التقى أمان أهل الأرض % % أعلام الهدى سفن النجا . % PageV01P579 البحر : - 1(@)(@@) % ألا خبرا عن رامة أيها الركب % فأني بمن قد حلها مغرم صب ؛ % 2(@)(@@) % إلى الله أشكو سقم ولوعة % ونار غرام في ضلوعي لا تخبو ؛ % 3(@)(@@) % وأبيض طرف لا يزال مسهدا % وأحمر دمع لا يكف له صب ؛ % 4(@)(@@) % وقلبا أناديه وقد لج في الهوى ؛ % رويدك ما هذي الصبابة يا قلب % 5(@)(@@) % تذكرت عيشا مر في شعب عامر % وسفح النقا يا حبذا السفح والشعب % 6(@)(@@) % وأفديه سربا بالعتيق ألفته % فأي غزال ضمها ذلك السرب % 7(@)(@@) % وأفدي التي أجرت دما من محاجري % % بأسياف لحظ لا تكل ولا تنبو ؛ % 8(@)(@@) % ويطمعني بالوصل لين قوامها % % وألحاظها في كل قلب لها حرب ؛ % 9(@)(@@) % وتفعل وهي الفاترات جفونها % % بقلبي ما لا يفعل الصارم العضب % 10(@)(@@) % إذا ما تقاضيت الوصال تمنعت ؛ % وقالت مرام دونه الطعن والضرب % PageV01P580 11(@)(@@) % فقلت لها أحرقت بالصد مهجتي % % واسقمتني ؛ قالت نعم هكذا الحب % 12(@)(@@) % وعاودتها ذكر الوصال فأعرضت % ومالت بقد دونه الغصن الرطب ؛ % 13(@)(@@) % وما علمت أني بغير عيونها % % وغير المعالي لا أهيم ولا أصبو ؛ % 14(@)(@@) % وأني من قوم كرام أعزة % ذخائرهم في صون أعراضهم نهب % 15(@)(@@) % أرى الجود فرضا والتواضع 
ms124	 رفعة % وكسب العلى فخرا ؛ ويا حبذا الكسب ؛ % 16(@)(@@) % واخفض عن فضل جناحي لصحبتي % % وأصفح عن ذنب كأن لم يكن ذنب ؛ % 17(@)(@@) % فودي لهم صاف وخلقي لهم رضى % وكفي لهم بحر وصدري لهم رحب ؛ % 18(@)(@@) % وإني ذو مجد أثيل ومحتد أصيل % وفخر دونه الأنجم الشهب % 19(@)(@@) % إذا الحرب يوما ضرست كل ضيغم % % برزت لها حتى تهابني الحرب ؛ % 20(@)(@@) % وإن رتب العليا فخزن بماجد % فحسب العلى فخرا بأني لها رب ؛ % PageV01P581 21(@)(@@) % وإن قال في الحاسدون مقالة ؛ % فما ضر بدر التم أن ينبح الكلب % 22(@)(@@) % صبرت على صرف الزمان وقد نضا % % لحربي سيقا لا يفل له غرب % PageV01P582 البحر : - 1(@)(@@) % سرى طيفها والنجم في الأفق كالعقد % فكاد سناه للعواذل أن يهدي % % 2(@)(@@) % سرى فسرى منه العبير بعنبر % وفاح شذاه بالفتيق وبالند ؛ % 3(@)(@@) % سرى في ظلام الليل والطرف ناعس % وعاد فلم يشف الفؤاد ولم يجد ؛ % 4(@)(@@) % فسل الكرى عن جفن عيني ولم أفز % بتقبيل كف من سراه ولا خد ؛ % 5(@)(@@) % وبت نديما للسهى ذا ندامة % كئيب فؤاد لا أعيد ولا أبدي ؛ % 6(@)(@@) % ومنها % % 7(@)(@@) % أبيت ويأبى لي الخنا محتد % كريم ؛ وجد في العلى أيما جد ؛ % 8(@)(@@) % وإني من القوم الكرام فعالهم ؛ % وانهم يوم الكريهة كالأسد % 9(@)(@@) % كفاهم فخارا في الأنام بأنهم % لآل رسول الله كالصارم الهندي % % 10(@)(@@) % وأنهم أهل الولاء لحيدر ؛ % وشيعته ؛ أهل المحبة والود . % PageV01P583 11(@)(@@) % فقال يعارضها % % 12(@)(@@) % نسيم الصبا كيف المنازل من نجد ؛ % كما كن عهدي ؛ أم تغيرن من بعدي % % 13(@)(@@) % ويا عذبات البان من سفح حاجر % هل السفح معمور الربوع على عهدي % % 14(@)(@@) % ويا أثلات الجزع من شعب عامر % لقد زادني ذكراك وجدا على وجدي % % 15(@)(@@) % منازل روى تربها مثل أدمعي % % من الغيث منهل الحيا صادق الرعد ؛ % 16(@)(@@) % قضيت بها حق الصبا والزمان لم % يقابل إراداتي بعكس ولا طرد ؛ % 17(@)(@@) % وقوم بنعمان الأراك عهدتهم % سقوني بها كأسا دهاقا من الود ؛ % 18(@)(@@) % وكم همت فيهم والزمان مساعد % وصرف القضا يجري الأمور على قصدي ؛ % 19(@)(@@) % بمعسول أطراف الحديث كأنما % % يدير على أهل الغرام جنى 
ms125	 الشهد ؛ % 20(@)(@@) % من الغيد سحار اللحاظ معطر اللمى جائر الأحكام معتدل القد % جائر الأحكام معتدل القد % PageV01P584 21(@)(@@) % وقد كان طوعي والحوادث نوم ؛ % فها أنا إن سلمت يبخل بالرد % 22(@)(@@) % وكم ليلة قد زارني في ظلامها % % وددت بها أني فرشت له خدي ؛ % 23(@)(@@) % إلى أن سعت فينا الليالي بفرقة % وغربنني عنه وغيرنه بعدي ؛ % 24(@)(@@) % وما زال دهري منذ كان يريش لي % % سهاما من الأحداث تصمي على عمد % 25(@)(@@) % لي الله كم ألقى الزمان بعزمة % تقصر عنها عزمة الصارم الهندي ؛ % 26(@)(@@) % وكم حشدت يوما علي جنوده % % فما كل عن حرب له أبدا حدي ؛ % 27(@)(@@) % وكم يلتقيني من بنيه محاربا ؛ % بأخبث من صل وألأم من قرد % 28(@)(@@) % إلى الله من أبناء دهري أشتكي % % مرامي تصمي كل محكمة السرد ؛ % 29(@)(@@) % وما جهلوا قدري لديهم ورفعتي % % وأن زماني فيهم زمن الورد % 30(@)(@@) % وما ضرني أن لا يرون فضائلي % % فما خفيت إلا على أعين رمد ؛ % PageV01P585 31(@)(@@) % ومالي ذنب غير أني في العلى % % تقدمت من قبلي وأتعبت من بعدي ؛ % 32(@)(@@) % سلي الدهر عني إن شككت وعنهم % لمن قصبات السبق في حلبة المجد % 33(@)(@@) % وقائلة لا عز إلا مع الغنى % % فبالمال يستكسي الفتى حلل الحمد ؛ % 34(@)(@@) % فأعمل إلى نيل الغنى كل حيلة % وشق أديم الأرض في طلب الرفد ؛ % 35(@)(@@) % فقلت لها مهلا فليس بنافعي % % دها ثعل والمال في غرر الأسد ؛ % PageV01P586 البحر : - 1(@)(@@) % لحى الله شخصا يرتضي بمعيشة % ذليلا مهانا عاجز النفس حائرا ؛ % 2(@)(@@) % مرج لشخص كل يوم وليلة ؛ % وربك رب العرش يكفيك ناصرا . % 3(@)(@@) % فقال % % 4(@)(@@) % عدمت اللقا إن لم أوافك زائرا % ولو كان ليث الغاب دونك زائرا ؛ % 5(@)(@@) % سأكشف أستار اصطباري ولم يفز % بنيل المنى من لا يكون مجاهرا ؛ % 6(@)(@@) % وأترك أقوال العواذل جانبا % ولو أنها هبت علي أعاصيرا ؛ % 7(@)(@@) % رويدك يا ذات اللمى بمتيم % % غدا مثلا بين المحبين سائرا % % 8(@)(@@) % فلم يبق مني الحب إلا جوانحا % تذوب اشتياقا أو دموعا بوادرا ؛ % 9(@)(@@) % وجسما ضعيفا مثل خصرك ناحلا % وعزم اصطبار مثل جفنك فاترا ؛ % 10(@)(@@) % يريبك من طرفي 
ms126	 ازورار وإنما % % أسارقك اللحظ الخفي محاذرا ؛ % PageV01P587 11(@)(@@) % فلي فيك أعداء أحاذر كيدهم % % وفيك لعمري حق لي أن أحاذرا ؛ % 12(@)(@@) % حواسد لا تنفك في كل حالة % تسل لعرضي مرهفات بواترا ؛ % 13(@)(@@) % وصرف زمان جائر الحكم لم يزل % يقود لياليه لحربي عساكرا ؛ % 14(@)(@@) % وقلة مال جشمت عيسي السرى % % إلى حيث لا ألقى لعظمي جابرا ؛ % 15(@)(@@) % وتأميل أقوام يريدون أنني % % مدى الدهر لا ينفك حالي قاصرا % % 16(@)(@@) % أأمل منهم بالغنى كف كربة % وقد أنشب الحرمان فيهم أظافرا ؛ % 17(@)(@@) % فوا أسفا ؛ كم لا أزال مماسيا % لأبوابهم أرجو الغنى ومباكرا % % 18(@)(@@) % أأقصد مرزوقا ضنينا برزقه ؛ % ألم يك خلاقي على ذاك قادرا % % 19(@)(@@) % فيا طالبا للرزق من عند مثله % % يبيت كئيبا للهموم مسامرا % % 20(@)(@@) % نصحتك لا تطلب سوى الله رازقا ؛ % كما لم تكن ترجو سوى الله غافرا ؛ % PageV01P588 21(@)(@@) % ولا تدع إلا الله في كل حاجة % تجده قريبا حين تدعوه حاضرا ؛ % 22(@)(@@) % أتبذل ماء الوجه بيعا بتافه % % وترجع صفرا خاسر البيع صاغرا % % 23(@)(@@) % لحى الله شخصا يرتضي بمعيشة % ذليلا مهانا عاجز النفس حائرا ؛ % 24(@)(@@) % مرج لشخص كل يوم وليلة % وربك رب العرش يكفيك ناصرا % % 25(@)(@@) % فيا سوأتا حتام أصبح حامدا % لغير إله العالمين وشاكرا ؛ % 26(@)(@@) % فقل للألى يسعون في طلب العلى % % تعالوا بنا نبكي العلى والمآثرا % % 27(@)(@@) % فقد قوضت أيدي المعالي خيامها % % وعادت ربوع المكرمات دواثر % 28(@)(@@) % فكم من نفوس قد أهينت عزيزة % وكم من قلوب قد بلغن الحناجرا % % PageV01P589 البحر : - 1(@)(@@) % وغيداء لا تنفك تملي عيونها % % على الناس من أسحار بابل ما تملي ؛ % 2(@)(@@) % تناءيت عنها وهي تدعو إلى اللقا % % وأعرضت عنها وهي تدعو إلى الوصل % 3(@)(@@) % وكلفت نفسي عن هواها تسليا ؛ % وكم قد سلا بالمجد عن مثلها مثلي % % 4(@)(@@) % فما خدعتني رقة من كلامها % % ولا دل قلبي نحوها ملق الدل ؛ % 5(@)(@@) % ومن بالعلى والمجد أصبح مغرما % يصد لعمري عن سعاد وعن جمل % 6(@)(@@) % أبى الله أن أمسي وأصبح هادما % % لما شاد أبائي الأكارم من قبلي ؛ % 7(@)(@@) % وما زلت أبدي للزمان تجلدا % كأني عما نابني عنه ؛ في 
ms127	 شغل % 8(@)(@@) % أقضي زمانيبلأماني تعلة ؛ % فما سمري إلا عساني أو علي ؛ % 9(@)(@@) % قرين هموم ليس أرجو لحلها % % سوى الله ربي مالك العقد والحل . % PageV01P590 البحر : - 1(@)(@@) % زمان على الأحرار قد جار في الحكم % وعامل أرباب الفضائل بالظلم % % 2(@)(@@) % يقول أناس في التغرب غربة % وليس لعمري ما يقولون عن علم ؛ % 3(@)(@@) % وها آناذا بين البرية مفرد % غريب وحولي أسرتي وبنو عمي ؛ % 4(@)(@@) % لقيت صروف الدهر مني بهمة % وعزم فما فلت صوارمه عزمي ؛ % 5(@)(@@) % وأظهرت للأيام صبر ابن حرة % وقد نثلت ما في الكنانة من سهم % 6(@)(@@) % وما طلبت وترا لدي صروفها ؛ % وما كان لي غير الفضائل من جرم ؛ % 7(@)(@@) % وكم نوب جليت بالصبر دهمها ؛ % وما المجد إلا الصبر للنوب الدهم ؛ % 8(@)(@@) % لحى الله هذا الدهر ؛ إن أنا لم أكن % % أنا الفارس الحامي الذمار ؛ فمن يحمي % % 9(@)(@@) % أتطمع جهلا أن تجاريني العدا % % وقد نزل الدهر الحزون على حكمي % % 10(@)(@@) % فخاري بفعلي لا بقومي ومعشري ؛ % على أنني نجل الجحاجحة الشم ؛ % PageV01P591 11(@)(@@) % ولي من بديع النظم كل غريبة % كمثل رياض الحزن باكرها الوسمي ؛ % 12(@)(@@) % فلو كانت الشمس المنيرة قينة % لما قلدت إلا قلائد من نظمي ؛ % 13(@)(@@) % وما دنست عرضي مقالة حاسد ؛ % وإن نال من عرضي وبالغ في ذمي ؛ % PageV01P592 البحر : - 1(@)(@@) % إلى كم ينال الأرذلون مناهم % ويعطون أضعاف العطاء وأحرم % 2(@)(@@) % قضاء زمان دأبه الجور في القضا % % وشيمة دهر في الورى يتحكم ؛ % 3(@)(@@) % يود الفصيح القول فيه لو آنه . . % لما قد يرى من قلة الحظ أبكم % % PageV01P593 البحر : - 1(@)(@@) % يا لها خطة خسف % عندها عز عزائي ؛ % 2(@)(@@) % كسي الناس جميعا % ونبذنا بالعراء % PageV01P594 البحر : - 1(@)(@@) % أفنيت عمري في تطلب صاحب % واف ؛ فلم أظفر بغير خؤون % 2(@)(@@) % ألقاه مبتهجا بوجه مسرة % أبدا ويلقاني بوجه حزين ؛ % 3(@)(@@) % وبلوت من أبناء دهري معشرا % حققت فيهم سيئات ظنوني ؛ % 4(@)(@@) % أخلاقهم في غلطة كقلوبهم % % وعقولهم في رقة ؛ كالدين ؛ % 5(@)(@@) % لوددت أني عندما شاهدتهم % % من قبل ذاك عدمت ضوء عيوني % % 6(@)(@@) % لو أنها امتدت لنيل أكفهم % % يوما يميني ؛ ما صحبت يمني ؛ % 7(@)(@@) % يا دهر 
ms128	 أقصر عن محاربتي بنا % % تبديه لي من غدرهم وتريني . % PageV01P595 البحر : - 1(@)(@@) % لا تقف بعد عزم شهر الصيام % أيها العيد وارتحل بسلام ؛ % 2(@)(@@) % يفرح العالمون بالعيد غيري % % فهو عندي كسائر الأيام ؛ % 3(@)(@@) % طال عندي لطول فقري حتى % % صار عاما ورب يوم كعام ؛ % 4(@)(@@) % أحمد الله ؛ كم سوانح آمال % تقنصت في شباك المنام ؛ % 5(@)(@@) % من يكن في الورى فقيرا ؛ فإني % % في غنى من ذخائر الأحلام ؛ % 6(@)(@@) % غير أني حملت نفسا أرتني % % لقنوعي أن الزمان غلامي % % 7(@)(@@) % الفت نفسي القناعة حتى % % ليس يدرى عناي من إعدامي ؛ % 8(@)(@@) % لست أرضى ببذل ماء محياي % % مدى الدهر في يسير حطام % PageV01P596 البحر : - 1(@)(@@) % مالي وللافتقار في بلدي % % أف لدهري وعيشي النكد ؛ % 2(@)(@@) % قد ركبتني الديون واشتملت % على فؤادي بالهم والكمد ؛ % 3(@)(@@) % وكان صدري من قبل ذا سعة % فضاق صدري لضيق ذات يدي ؛ % 4(@)(@@) % قالوا تلطف واحتل ؛ فقلت لهم % قل اصطباري وخانني جلدي ؛ % 5(@)(@@) % وليس يغني شيئا دها ثعل % والمال مني في جبهة الأسد ؛ % 6(@)(@@) % وبعد ذا كله فلي ثقة % وحسن ظن بالواحد الصمد ؛ % 7(@)(@@) % فهو الذي بالأنام قاطبة % أشفق من والد على ولد % PageV01P597 البحر : - 1(@)(@@) % وأشكو بعد ذلك ما ألاقي % % من الأيام من هم وضيق ؛ % 2(@)(@@) % إذا ما رمت سيرا للمعالي % % وجدت الافتقار على طريقي % % 3(@)(@@) % وملني الصديق لسوء حالي % % فلم أعرف عدوي من صديقي ؛ % 4(@)(@@) % وكم أشكو إلى من ليس يرثي % % كما يشكو الأسير إلى الطليق % 5(@)(@@) % ولا والله ما بي خوف فقر ؛ % ولكن كيف أصنع بالحقوق % 6(@)(@@) % فإن أنهض لها فبلا جناح ؛ % وإن أهمل ؛ نسبت إلى العقوق . % PageV01P598 البحر : - 1(@)(@@) % غير حظي لا ألوم ؛ % وهو والله المشوم ؛ % 2(@)(@@) % كلما رمت مراما % صدني عما أروم ؛ % 3(@)(@@) % لم يزل يقعد في ما % % لست أرضى ويقوم % 4(@)(@@) % إن أنبهه لأمر % فهو مكسال نؤوم . % PageV01P599 البحر : - 1(@)(@@) % صرفت عن الكيميا همتي % % وصرفتها في اكتساب الأدب ؛ % 2(@)(@@) % فما قلت للبدر أنت اللجين % % ولا قلت للشمس أنت الذهب % PageV01P600 البحر : - 1(@)(@@) % لا تعتبر ضعف حالي واعتبر أدبي % % وغض عن رث أطماري وأسمالي ؛ % 2(@)(@@) % فما 
ms129	 طلابي للدنيا بممتنع % لكن رأيت طلاب المجد أسمالي . % PageV01P601 البحر : - 1(@)(@@) % الحمد لله الذي % % أصح جسمي وشفى % % 2(@)(@@) % قد كنت لولا فضله % % من ألمي على شفا ؛ % PageV01P602 البحر : - 1(@)(@@) % أخفض للخل من جناحي % % إن كان عند الخطوب خلا % % 2(@)(@@) % وذاك مع من أحب دأبي % % أن يرع لي ذمة ؛ وإلا . . % PageV01P603 البحر : - 1(@)(@@) % قل للحواسد إن الله أكرمنا % % بما ترون ومنه الفضل والمدد % 2(@)(@@) % الحمد لله ؛ كم فينا لخالقنا % % مواهب ليس يحصي شكرها أحد % 3(@)(@@) % فإن قدرتم على تحويل أنعمه % % عنا ؛ فدونكم يا قوم ؛ فاجتهدوا % % 4(@)(@@) % فلا أزال إلاه الخلق أنعمه % % عنا ؛ ولا زال عنكم ذلك الحسد . % PageV01P604 البحر : - 1(@)(@@) % أنا السيف لا تختشى نبوتي % % إذ أحشيت نبوة القاضب ؛ % 2(@)(@@) % إلى ذي القفار اعتزائي ؛ كما % % إلى حيدر يعتزي صاحبي . % PageV01P605 البحر : - 1(@)(@@) % أحسود قل ما شئت في % لك البقاء من الملامه . % 2(@)(@@) % فخري كشمس أشرقت % لم تخفها أبدا غمامه ؛ % 3(@)(@@) % أحسود يا ترب السفالة % والجهالة واللآمة ؛ % 4(@)(@@) % لم لا يطول على الورى % % من كان حيدرة إمامه % % 5(@)(@@) % من بالكتاب وعترة المختار % قد أضحى اعتصامه ؛ % 6(@)(@@) % واختار دين أبي الحسين % % لحب حيدرة علامه % 7(@)(@@) % من بالولاء لحيدر ينجو % ويأمن في القيامه % 8(@)(@@) % ويروح مسرورا غدا % يوم التغابن والندامة % % 9(@)(@@) % ويحوز في جنات عدن % % يوم التغابن والندامة % % 10(@)(@@) % وتدير ولدان الجنان % عليه كاسات المدامه ؛ % PageV01P606 11(@)(@@) % ولرب كأس فض عن % % مسك بلا حرج ختامه % PageV01P607 
