ms21	 يستره % منها أكافيف فيها ، دونه ، زور % 24(@)(@@) % يوما ، بأجود منه ، حين تسأله % ولا بأجهر منه ، حين يجتهر % 25(@)(@@) % ولم يزل بك واشيهم ومكرهم % حتى أشاطوا بغيب لحم من يسروا % % 26(@)(@@) % فلم يكن طاويا عنا نصيحته % وفي يديه بدنيا دوننا حصر % 27(@)(@@) % فهو فداء أمير المؤمنين ، إذا % % أبدى النواجذ يوم باسل ذكر % 28(@)(@@) % مفترش كافتراش الليث كلكله % لوقعة كائن فيها له جزر % 29(@)(@@) % مقدما مائتي ألف لمنزله % ما إن رأى مثلهم جن ولا بشر % 30(@)(@@) % يغشى القناطر يبنيها ويهدمها % % مسوم ، فوقه الرايات والقتر % PageV01P075 31(@)(@@) % قوم أنابت إليهم كل مخزية % وبالثوية لم ينبض بها وتر % 32(@)(@@) % وتستبين لأقوام ضلالتهم % ويستقيم الذي في خده صعر % 33(@)(@@) % ثم استقل باثقال العراق ، وقد % كانت له نقمة فيهم ومدخر % 34(@)(@@) % في نبعة من قريش ، يعصبون بها % % ما إن يوازى بأعلى نبتها الشجر % 35(@)(@@) % تعلو الهضاب ، وحلوا في أرومتها % % أهل الرياء وأهل الفخر ، إن فخروا % % 36(@)(@@) % حشد على الحق ، عيافو الخنى أنف % إذا ألمت بهم مكروهة ، صبروا % % 37(@)(@@) % وإن تدجت على الآفاق مظلمة % كان لهم مخرج منها ومعتصر % 38(@)(@@) % أعطاهم الله جدا ينصرون به % لا جد إلا صغير ، بعد ، محتقر % 39(@)(@@) % لم يأشروا فيه ، إذ كانوا مواليه % ولو يكون لقوم غيرهم ، أشروا % % 40(@)(@@) % شمس العداوة ، حتى يستقاد لهم % % وأعظم الناس أحلاما ن إذا قدروا % % PageV01P076 41(@)(@@) % لا يستقل ذوو الأضغان حربهم % ولا يبين في عيدانهم خور % 42(@)(@@) % هم الذين يبارون الرياح ، إذا % % قل الطعام على العافين أو قتروا % % 43(@)(@@) % بني أمية ، نعماكم مجللة % تمت فلا منة فيها ولا كدر % 44(@)(@@) % بني أمية ، قد ناضلت دونكم % أبناء قوم ، هم آووا وهم نصروا % % 45(@)(@@) % أفحمت عنكم بني النجار قد علمت % % عليا معد ، وكانوا طالما هدروا % % 46(@)(@@) % حتى استكانوا : وهم مني على مضض % والقول ينفذ ما لا تنفذ الإبر % 47(@)(@@) % بني أمية ، إني ناصح لكم % فلا يبيتن فيكم آمنا زفر % 48(@)(@@) % وأتخذوه عدوا ، إن شاهده % وما تغيب من أخلاقه دعر % 49(@)(@@) % إن الضغينة تلقاها ، وإن قدمت % كالعر ، يكمن حينا ، ثم ينتشر 
ms22	 % 50(@)(@@) % وقد نصرت أمير المؤمنين بنا % % لما أتاك ببطن الغوطة الخبر % PageV01P077 51(@)(@@) % يعرفونك رأس ابن الحباب ، وقد % أضحى ، وللسيف في خيشومه أثر % 52(@)(@@) % لا يسمع الصوت مستكا مسامعه % وليس ينطق ، حتى ينطق الحجر % 53(@)(@@) % أمست إلى جانب الحشاك جيفته % ورأسه دونه اليحموم والصور % 54(@)(@@) % يسأله الصبر من غسان ، إذ حضروا % % والحزن كيف قراك الغلمة الجشر % 55(@)(@@) % والحارث بن أبي عوف لعبن به % حتى تعاوره العقبان والسبر % 56(@)(@@) % وقيس عيلان ، حتى أقبلوا رقصا % فبايعوك جهارا بعدما كفروا % % 57(@)(@@) % فلا هدى الله قيسا من ضلالتهم % ولا لعا لبني ذكوان إذا عثروا % % 58(@)(@@) % ضجوا من الحرب إذا عضت غواربهم % وقيس عيلان من أخلاقها الضجر % 59(@)(@@) % كانوا ذوي إمة حتى إذا علقت % بهم حبائل للشيطان وابتهروا % % 60(@)(@@) % صكوا على شارف ، صعب مراكبها % % حصاء ليس لها هلب ولا وبر % PageV01P078 61(@)(@@) % ولم يزل بسليم أمر جاهلها % % حتى تعايا بها الإيراد والصدر % 62(@)(@@) % إذ ينظرون ، وهم يجنون حنظلهم % إلى الزوابي فقلنا بعد ما نظروا % % 63(@)(@@) % كروا إلى حرتيهم يعمرونهما % % كما تكر إلى أوطانها البقر % % 64(@)(@@) % وأصبحت منهم سنجار خالية % والمحلبيات فالخابور فالسرر % 65(@)(@@) % وما يلاقون فراصا إلى نسب % حتى يلاقي جدي الفرقد القمر % 66(@)(@@) % وما سعى فيهم ساع ليدركنا % % إلا تقاصر عنا وهو منبهر % 67(@)(@@) % وقد أصابت كلابا ، من عداوتنا % % إحدى الدواهي التي تخشى وتنتظر % 68(@)(@@) % وقد تفاقم أمر غير ملتئم % ما بيننا رحم فيه ولا عذر % 69(@)(@@) % أما كليب بن يربوع فليس لهم % عند التفارط إيراد ولا صدر % 70(@)(@@) % مخلفون ، ويقضي الناس أمرهم % وهم بغيب وفي عمياء ما شعروا % % PageV01P079 71(@)(@@) % ملطمون بأعقار الحياض ، فما % % ينفك من دارمي فيهم أثر % 72(@)(@@) % بئس الصحاة وبئس الشرب شربهم % إذا جرى فيهم المزاء والسكر % 73(@)(@@) % % وكل فاحشة سبت بها مضر % 74(@)(@@) % على العيارات هداجون ، قد بلغت % نجران أو حدثت سوءاتهم هجر % 75(@)(@@) % الآكلون خبيث الزاد ، وحدهم % والسائلون بظهر الغيب ما الخبر % 76(@)(@@) % واذكر غدانة عدانا مزنمة % من الحبلق تبنى حولها الصير % 77(@)(@@) % تمذي ، إذا سخنت في قبل أذرعها % % وتزرئم إذا 
ms23	 ما بلها المطر % 78(@)(@@) % وما غدانة في شيء مكانهم % الحابسو الشاء ، حتى يفضل السؤر % 79(@)(@@) % يتصلون بيربوع ورفدهم % عند الترافد ، مغمور ومحتقر % 80(@)(@@) % صفر اللحى من وقود الأدخنات ، إذا % % رد الرفاد وكف الحالب القرر % PageV01P080 82(@)(@@) % وأقسم المجد حقا لا يحالفهم % حتى يحالف بطن الراحة الشعر % PageV01P081 البحر : طويل 1(@)(@@) % ألا يا اسلمي يا هند هند بني بدر % وإن كان حيانا عدى ، آخر الدهر % 2(@)(@@) % وإن كنت قد أقصدتني إذ رميتني % % بسهمك ، والرمي يصيب ، وما يدري % % 3(@)(@@) % أسيلة مجرى الدمع ، أما وشاحها % % فجار ، وأما الحجل منها فما يجري % % 4(@)(@@) % تموت وتحيا بالضجيع وتلتوي % % بمطرد المتمين منتبر الخصر % 5(@)(@@) % وكنتم إذا تنأون منا ، تعرضت % خيالاتكم أو بت منكم على ذكر % 6(@)(@@) % شلقد حملت قيس بن عيلان حربنا % % على يابس السيساء محدوب الظهر % 7(@)(@@) % وقد سرني من قيس عيلان ، أنني % % رأيت بني العجلان سادوا بني بدر % 8(@)(@@) % وقد غبر العجلان حينا ، إذا بكى % % على الزاد ألقته الوليدة في الكسر % 9(@)(@@) % فيصبح كالخفاش ، يدلك عينه % فقبح من وجه لئيم ، ومن حجر % 10(@)(@@) % وكنتم بني العجلان ألأمم عندنا % % وأحقر من أن تشهدوا عالي الأمر % PageV01P082 11(@)(@@) % بني كل دسماء الثياب ، كأنما % % طلاها بنو العجلان من حمم القدر % 12(@)(@@) % ترى كعبها قد زال من طول رعيها % % وقاح الذنابى بالسوية والزفر % 13(@)(@@) % وإن نزل الأقوام منزل عفة % نزلتم بني العجلان منزلة الخسر % 14(@)(@@) % وشاركت العجلان كعبا ، ولم تكن % تشارك كعبا في وفاء ولا غدر % 15(@)(@@) % ونجى ابن بدر ركضه من رماحنا % % ونضاحة الأعطاف ملهبة الحضر % % 16(@)(@@) % إذا قلت نالته العوالي ، تقاذفت % به سوحق الرجلين صايبة الصدر % % 17(@)(@@) % كأنهما والآل ينجاب عنهما % % إذا انغمسا فيه يعومان في غمر % 18(@)(@@) % يسر إليها ، والرماح تنوشه : % فدى لك أمي ، إن دأبت إلى العصر % 19(@)(@@) % فطل يفديها ، وطلت كأنها % % عقاب دعاها جنح ليل إلى وكر % 20(@)(@@) % كأن بطبييها ومجرى حزامها % % أداوى تسح الماء من حور وفر % PageV01P083 21(@)(@@) % ركوب على السواءات قد شرم آسته % % مزاحمة الأعداء والنخس في الدبر % 22(@)(@@) % فطاروا شقاقا لاثنتين ، فعامر % تبيع 
ms24	 بنيها بالخصاف وبالتمر % 23(@)(@@) % وأما سليم ، فاستعاذت حذارنا % % بحرتها السوداء والجبل الوعر % 24(@)(@@) % تنق بلا شيء شيوخ محارب % وما خلتها كانت تريش ولا تبري % % 25(@)(@@) % ضفادع في ظلماء ليل تجاوبت % فدل عليها صوتها حية البحر % % 26(@)(@@) % ونحن رفعنا عن سلول رماحنا % % وعمدا رغبنا عن دماء بني نصر % 27(@)(@@) % ولو ببني ذبيان بلت رماحنا % % لقرت بهم عيني وباء بهم وتري % % 28(@)(@@) % شفى النفس قتلى من سليم وعامر % ولم تشفها قتلى عني ولا جسر % 29(@)(@@) % ولا جشم شر القبائل ، إنها % % كبيض القطا ، ليسوا بسود ولا حمر % 30(@)(@@) % وما تركت أسيافنا حين جردت % لأعدانا قيس بن عيلان من عذر % PageV01P084 31(@)(@@) % وقد عركت بابني دخان فأصبحا % % إذا ما احزألا مثل باقية البظر % 35(@)(@@) % وأدرك علمي في سواءة ، أنها % % تقيم على الأوتار والمشرب الكدر % 36(@)(@@) % وظل يجيش الماء من متقصد % على كل حال من مذاهبه يجري % % 37(@)(@@) % فأقسم لو أدركنه لقذفنه % إلى صعبة الأرجاء ، مظلمة القعر % 38(@)(@@) % فوسد فيها كفه ، أو لحجلت % ضباع الصحاري حوله ، غير ذي قبر % 39(@)(@@) % لعمري لقد لاقت سليم وعامر % على جانب الثرثاء راغية البكر % 40(@)(@@) % أعني أمير المؤمنين بنائل % وحسن عطاء ، ليس بالريث النزر % 41(@)(@@) % وأنت أمير المؤمنين ، وما بنا % % إلى صلح قيس يا بن مروان من فقر % 42(@)(@@) % فإن تك قيس ، يا بن مروان ، بايعت % فقد وهلت قيس إليك ، من العذر % 43(@)(@@) % على غير إسلام ولا عن بصيرة % ولكنهم سيقوا إليك على صغر % PageV01P085 44(@)(@@) % ولما تبينا ضلالة مصعب % فتحنا لأهل الشام بابا من النصر % 45(@)(@@) % فقد أصبحت منا هوازن كلها % % كواهي السلامى ، زيد وقرا على وقر % 46(@)(@@) % سمونا بعرنين أشم وعارض % لمنع ما بين العراق إلى البشر % 47(@)(@@) % فأصبح ما بين العراق ومنبج % لتغلب تردى بالردينية السمر % 48(@)(@@) % إليك أمير المؤمنين نسيرها % % تخب المطايا بالعرانين من بكر % 49(@)(@@) % برأس امرئ دلى سليما وعامرا % وأورد قيسا لج ذي حدب غمر % 50(@)(@@) % فأسرين خمسا ، ثم أصبحن ، غدوة % يخبرن أخبارا ألذ من الخمر % 51(@)(@@) % تخل ابن صفار ، فلا تذكر العلى % % ولا تذكرن 
ms25	 حياب قومك في الذكر % 52(@)(@@) % فقد نهضت للتغلبين حية % كحية موسى يوم أيد بالنصر % 60(@)(@@) % يخبرننا أن الأراقم فلقوا % % جماجم قيس بين رذان فالحضر % PageV01P086 61(@)(@@) % جماجم قوم ، لم يعافوا ظلامة % ولم يعلموا أين الوفاء من الغدر % PageV01P087 البحر : كامل تام 1(@)(@@) % صرمت حبالك زينب وقذور % وحبالهن إذا عقدن غرور % 2(@)(@@) % يرمين بالحدق المراض قلوبنا % % فغويهن مكلف مضرور % 3(@)(@@) % وزعمن أني قد ذهلت عن الصبى % % ومضى لذلك أعصر ودهور % 4(@)(@@) % وإذا أقول صحوت من أدوائها % % هاج الفؤاد دمى أوانس حور % 5(@)(@@) % وإذا نصبن قرونهن لغدرة % فكأنما حلت لهن نذور % 6(@)(@@) % ولقد أصيد الوحش في أوطانها % % فيذل بعد شماسه اليعفور % 7(@)(@@) % أحيا الإله لنا الإمام فإنه % خير البرية للذنوب غفور % 8(@)(@@) % نور أضاء لنا البلاد وقد دجت % ظلم تكاد بها الهداة تجور % 9(@)(@@) % الفاخرون بكل يوم صالح % وأخو المكارم بالفعال فخور % 10(@)(@@) % فعليك بالحجاج لا تعدل به % أحدا إذا نزلت عليك أمور % PageV01P088 11(@)(@@) % ولقد علمت وأنت أعلمنا به % أن ابن يوسف حازم منصور % 12(@)(@@) % وأخو الصفاء فما تزال غنيمة % منه يجيء بها إليك بشير % 13(@)(@@) % وترى الرواسم يختلفن وفوقها % % ورق العراق سبائك وحرير % 14(@)(@@) % وبنات فارس كل يوم تصطفى % % يعلونهن وما لهن مهور % 15(@)(@@) % خوصا أضر بها ابن يوسف فانطوت % والحرب لاقحة لهن زجور % 16(@)(@@) % وترى المذكي في القياد كأنه % من طول ما جشم الغوار عقير % 17(@)(@@) % هريت نطاف عيونهن فأدبرت % فكأنهن من الضرارة عور % 18(@)(@@) % وحولن من خلج الأعنة وانطوت % منها البطون وفي الفحول جفور % 19(@)(@@) % قطع الغزاة عجافهن فأصبحت % حرد صلادم قرح وذكور % 20(@)(@@) % ولقد علمت بلاءه في معشر % تغلي شناه صدورهم وثغور % PageV01P089 21(@)(@@) % والقوم زأرهم وأعلى صوتهم % تحت السيوف غماغم وهرير % 22(@)(@@) % واذ اللقاح غلت فإن قدوره % جوف لهن بما ضمن هدير % 23(@)(@@) % طلب الأزارق بالكتائب إذ هوت % بشبيب غائلة النفوس غدور % 24(@)(@@) % يرجو البقية بعدما حدقت به % فرط المنية بحصب وحجور % 25(@)(@@) % فأباح جمعهم حميدا وانثنى % % وله لوقعه آخرين زئيرا % PageV01P090 البحر : وافر تام 1(@)(@@) % ألم تشكر لنا كلب بأنا 
ms26	 % % جلونا عن وجوههم الغبارا % % 2(@)(@@) % كشفنا عنهم نزوات قيس % ومثل جموعنا منع الذمارا % % 3(@)(@@) % وكانوا معشرا قد جاورونا % % بمنزلة فأكرمنا الجوارا % % 4(@)(@@) % فلما أن تخلى الله منهم % أغاروا إذ رأوا منا انفتارا % % 5(@)(@@) % فعاقبناهم لكمال عشر % ولم نجعل عقابهم ضمارا % % 6(@)(@@) % وأطفأنا شهابهم جميعا % وشب شهاب تغلب فاستنارا % % 7(@)(@@) % تحملنا فلما أحمشونا % % أصاب النار تستعر استعارا % % 8(@)(@@) % وأفلت حاتم بفلول قيس % إلى القاطول وانتهك الفرارا % % 9(@)(@@) % جزيناهم بما صبحوا شعيثا % وأصحابا له وردوا قرارا % % 10(@)(@@) % وخير متالف الأقوام يوما % على العزاء عزما واصطبارا % % PageV01P091 11(@)(@@) % فمهما كان من ألم فإنا % % صبحناهم به كأسا عقارا % % 12(@)(@@) % فليت حديثنا يأتي شعيثا % وحنظلة بن قيس أو مرارا % % 13(@)(@@) % بما دناهم في كل وجه % وأبدلناهم بالدار دارا % % 14(@)(@@) % فلا راذان تدعى فيه قيس % ولا القاطول واقتنصوا الوبارا % % 15(@)(@@) % صبرنا يوم لاقينا عميرا % فأشبعنا مع الرخم النسارا % % 16(@)(@@) % وكان ابن الحباب أعير عزا % ولم يك عز تغلب مستعارا % % 17(@)(@@) % فلا برحوا العيون لتنزلوها % % ولا الرهوات والتمسوا المغارا % % 18(@)(@@) % وسيري يا هوازن نحو أرض % بها العذراء تتبع القتارا % % 19(@)(@@) % فإنا حيث حل المجد يوما % حللناه وسرنا حيث سارا % % PageV01P092 البحر : وافر تام 1(@)(@@) % أعاذل ما عليك بأن تريني % % أباكر قهوة فيها احمرار % 2(@)(@@) % تضمنها نفوس الشرب ، حتى % % يروحوا في جفونهم انكسار % 3(@)(@@) % تواعدها التجار إلى أناها % % فأطلعها على العرب التجار % 4(@)(@@) % فأعطينا الغلاء بها ، وكانت % نأبى ، أو يكون لها يسار % 5(@)(@@) % أعاذل توشكين بأن تريني % % صريعا ، لا أزور ولا أزار % 6(@)(@@) % إذا خفقت علي ، فألبستني % % بلامع آلها ، البيد القفار % 7(@)(@@) % لعمر أبي لئن قوم أضاعوا % % لنعم أخو الحفاظ لنا جدار % 8(@)(@@) % حمانا حين أعورنا وخفنا % % وأطعم ، حين يتبع القتار % 9(@)(@@) % وأوقد نار مكرمة ومجد % ولم توقد مع الجشمي نار % 10(@)(@@) % وأطعم أشهر الشهباء حتى % % تصوح في منابته الحسار % PageV01P093 11(@)(@@) % فإذا درت بكفك ، فاحتلبها % % ولا تك درة فيها غرار % 12(@)(@@) % وأمسك عنك بالطرفين ، حتى % % تبين أين يصرفك المغار % 13(@)(@@) % فإن عواقب الأيام تخشى % % دوائرها وتنتقل الديار % 14(@)(@@) % وقدج علم 
ms27	 النساء إذا التقينا % % وهن وراءنا ، أنا تغار % 15(@)(@@) % تربعنا الجزيرة ، بعد قيس % فأضحت وهي من قيس قفار % % 16(@)(@@) % يزجون الحمير بأرض نجد % وما لهم من الأمر الخيار % 17(@)(@@) % رأوا ثغرا تحيط به المنايا % % وأكبد ما يغيره الغيار % 18(@)(@@) % تسامي ماردون به الثريا % % وأيدي الناس دونهم قصار % 19(@)(@@) % وأولاد الصريح مسومات % عليها الأسد غضفا والنمار % 20(@)(@@) % شوازب كالقنا ، قد كان فيها % % من الغارات والغزو اقورار % PageV01P094 21(@)(@@) % ذوابل كل سلهبة خنوف % وأجرد ما يثبطه الخبار % 22(@)(@@) % فأترز لحمه التعداء ، حتى % % بدت منه الجناجن والفقار % 23(@)(@@) % وقد قلقت قلائد كل غوج % يطفن به ، كما قلق السوار % 24(@)(@@) % تراه كأنه سرحان طل % زهاه يوم رائحة قطار % 25(@)(@@) % وأبقى الحرب واللزبات منها % % صلادم ، ما تخونها المهار % 26(@)(@@) % ألم ترني أجرت بني فقيم % بحيث غلا على مضر الجوار % 27(@)(@@) % بعاجنة الرحوب فلم يسيروا % % وسير غيرهم عنها فساروا % % PageV01P095 البحر : طويل 1(@)(@@) % نبئت أن الخزرجيين حافظوا % % بألفين منهم ، دارعون وحسر % 2(@)(@@) % وما فتئت خيل تثوب وتدعي % % إلى النمر ، حتى غص بالقوم عرعر % 3(@)(@@) % وقد حارت الأسرى لمن يصطلي الوغى % % فخابت من الأسرى حبين ويعمر % 4(@)(@@) % وسارت عدي للجوار ، فأجزرت % وغير عدي في المواطن أصبر % 5(@)(@@) % وغنم عتاب بن سعد سواهم % وشمصن بهراء الوشيج الممكر % 6(@)(@@) % وحلت هلال بين حرث وقرية % تروح عليها بالعشي المعصفر % 7(@)(@@) % ألا إن شر الناس حيث لقيتهم % % أراهيط بالثرثار حضري ووقر % 8(@)(@@) % وعمرو بن بكر لم تكشف ستورها % % وحررت عبد الله ، فيمن يحرر % PageV01P096 البحر : طويل 1(@)(@@) % عفا دير لبى من أميمة ، فالحضر % وأقفر إلا أن يلم به سفر % 2(@)(@@) % قليلا غرار العين حتى يقلصوا % % على كالقطا الجوني ، أفزعه القطر % 3(@)(@@) % على كل فتلاء الذراعين ، رسلة % وأعيس نعاب إذا قلق الضفر % 4(@)(@@) % قضين من الديرين هما طلبنه % فهن إلى لهو وجاراتها شزر % 5(@)(@@) % ويامن عن ساتيدما وتعسفت % بنا العيس مجهولا ، مخارمه غبر % 6(@)(@@) % سواهم من طول الوجيف ، كأنها % % قراقير يغشيهن آذيه البحر % 7(@)(@@) % إذا غرق الآل الإكام علونه % بمنتعتات لا بغال ولا حمر % 8(@)(@@) % صوادق 
ms28	 عتق في الرحال : كأنها % % من الجهد ، أسرى مسها البؤس والفقر % 9(@)(@@) % محلقة منها العيون ، كأنها % % قلات ، ثوت فيها مطائطها الحضر % 10(@)(@@) % وقد أكل الكيران أشرافها العلى % % وأبقيت الألواح والعصب السمر % PageV01P097 11(@)(@@) % وأجهضن ، إلا أن كل نجيبة % أتى دون ماء الفحل من رحمها ستر % 12(@)(@@) % من الهوج خرقاء العنيق مطارة % الفؤاد ، براها ، بعد إبدانها ، الضمر % 13(@)(@@) % إذا اتزر الحادي الكميش وقومت % سوالفها الركبان والحلق الصفر % 14(@)(@@) % حمين العراقيب العصا ، فتركنه % به نفس عال مخالطه بهر % 15(@)(@@) % يحدن عهلى المسخبرين ، وأتقى % % كلام المنادي ، إنني خائف حذر % 16(@)(@@) % أقاتل نفسا قد يحب لها الردى % % بنو أم مذعور ورهطك يا جبر % 17(@)(@@) % إذا ما أصابت جحدريا بصكة % دعته بإقبال خزاعة أو نصر % 18(@)(@@) % وقيس تمناني وتهدي عوارما % ولما يصب مني بنو عامر ظفر % 19(@)(@@) % وما قبلت مني هلال أمانة % ولا عائذ مني الضباب ولا شمر % 20(@)(@@) % وإن تك عني جعفر مطمئنة % فإن قشيرا في الصدور ، لها غمر % PageV01P098 21(@)(@@) % وإن أعف عنها ، أو أدعها لجهلها % % فما لبني قيس عتاب ولا عذر % 22(@)(@@) % وقد كنت أعفي من لساني عامرا % وسعدا ويبدي عن مقاتلها الشعر % 23(@)(@@) % ولولا أمير المؤمنين ، تكشفت % قبائل عنا أو بلاها بنا الدهر % 24(@)(@@) % إذا لدفعنا طيئا وحليفها % % بني أسد في حيث يطلع الوبر % 25(@)(@@) % وكلب ، إذا حالت قرى الشام دونها % % إلى النيل هرابا ، وإن أجدبت مصر % 26(@)(@@) % يعوذون بالسلطان منا ، وكلهم % كذي الغارب المنكوب ، أوجعه الوقر % 27(@)(@@) % وألا تصر أعراب بكر بن وائل % مهاجرها لا يرع إل ولا إصر % % 28(@)(@@) % وما تركت أسيافنا من قبيلة % تحاربنا ، إلا لها عندنا وتر % 29(@)(@@) % حجونا بني النعمان إذ عض ملكهم % % وقبل بني النعمان حاربنا عمرو % % 30(@)(@@) % لبسنا له البيض الثقال ، وفوقها % % سيوف المنايا والمثقفة السمر % PageV01P099 31(@)(@@) % وأمسك أرسان الجياد أكفنا % % ولم تلهنا عنها الحجال بها العفر % 32(@)(@@) % أكل أوان ، لا يزال يعودني % % خيال لأخت العامريين أو ذكر % 33(@)(@@) % وبيضاء لا نجر النجاشي نجرها % % إذا التهبت منها القلائد والنحر % 34(@)(@@) % من الصور اللائي يرحن إلى الصبى % % تظل 
ms29	 إليها تنزع النفس والهجر % 35(@)(@@) % ولكن أتى الأبواب والقصر دونها % % كما حال دون العاقل الجبل الوعر % PageV01P100 البحر : طويل 1(@)(@@) % ألا سائل الجحاف هل هو ثائر % بقتلى أصبت من سليم وعامر % % 2(@)(@@) % أجحاف إن تصطك يوما ، فتصطدم % عليك أواذي البحور الزواخر % 3(@)(@@) % تكن مثل اقذاء الحباب الذي جرى % % به الماء ، أو جاري الرياح الصراصر % 4(@)(@@) % لقد حان كل الحين من رام شاعرا % لدى السورة العليا على كل شاعر % 5(@)(@@) % يصول بمجر ليس يحصى عديده % % ويسدر منه ، ساجيا ، كل ناظر % PageV01P101 البحر : طويل 1(@)(@@) % ألا يا لقوم للتنائي وللهجر % وطول الليالي كيف يزرين بالعمر % 2(@)(@@) % تنح ابن صفار إليك ، فإنني % % صبور على الشحناء والنظر الشزر % 3(@)(@@) % فما تركت حياتنا لك حية % تقلب في أرض براح ولا بحر % 4(@)(@@) % فإن تدع قيسا يا دعي محارب % فقد أصبحت أفناء قيس على دبر % 5(@)(@@) % فإن ينهضوا ، لا ينهضوا بجماعة % وإن يقعدوا ، يطووا الصدور على غمر % 6(@)(@@) % لحى الله قيسا حين فرت رجالها % % عن النصف السوداء والكاعب البكر % 7(@)(@@) % وظلت تنادي بالثدي نساؤهم % طوالع بالعلياء ، مائلة الخمر % 8(@)(@@) % وإن يك قد قاد المقانب مرة % عمير ، فقد أضحى بداوية قفر % 9(@)(@@) % تظل سباع الشرعبية حوله % ربوضا وما كانوا أجنوه في قبر % 10(@)(@@) % صريعا بأسياف حداد ، وطعنة % تمج على متن السنان دم الصدر % % PageV01P102 11(@)(@@) % عدا زفر الشيخ الكلابي طوره % فقد أنزلته المنجنيق من القصر % 12(@)(@@) % وزر أضاعته الكتائب حوله % فأصبح محطوم الجناحين والظهر % % 13(@)(@@) % بني عامر ، لم تثأروا بأخيكم % ولكن رضيتم باللقاح وبالجزر % 14(@)(@@) % إذا عطفت وسط البيوت ، احتلبتم % % له لبنا محضنا أمر من الصبر % % 15(@)(@@) % ولما رأى الرحمن أن ليس فيهم % رشيد ، ولا ناه أخاه عن الغدر % 16(@)(@@) % أمال عليهم تغلب ابنت وائل % فكانوا عليهم مثل راغية البكر % 17(@)(@@) % فسيروا إلى أهل الحجاز ، فإنما % % نفيناكم عن منبت القمح والتمر % 18(@)(@@) % ونحن حدرنا عامرا ، إذ تجمعت % ضرابا وطعنا بالمثقفة السمر % PageV01P103 البحر : خفيف تام 1(@)(@@) % هل عرفت الديار يابن أويس % دارسا نؤيها كخط الزبور % 2(@)(@@) % بدلت بعد نعمة وأنيس % صوت 
ms30	 هام ومكنس اليعفور % 3(@)(@@) % وأواري بقين فيها خلاء % حول خد من القطا مأمور % 4(@)(@@) % ذاك إذ كن والشباب جميع % في زمان كلمع ثوب البشير % 5(@)(@@) % إنما الشيخ هزأة للغواني % % ليس في حبهن بالمعذور % 6(@)(@@) % والغواني إذا وعدن خليلا % كاذبات يعدن وعد الغرور % 7(@)(@@) % عللاني بشربة من كميت % نعمة النيم في شبا الزمهرير % 8(@)(@@) % من سلاف أجادها طابخاها % % لم تمت كل موتها في القدور % 9(@)(@@) % ليس بؤس ولا نعيم بباق % % لمسر به ولا مسرور % 10(@)(@@) % أهلك البغي بالجزيرة قيسا % فهوت في مغرق الخابور % PageV01P104 11(@)(@@) % طلبوا الموت عندنا فأتاهم % من قبول عليهم ودبور % 12(@)(@@) % يوم تردي الكماة حول عمير % حجلان النسور حول الجزور % 13(@)(@@) % رب جبار معشر قد قتلنا % % كان في يومه شديد النكير % 14(@)(@@) % بشروا حمير القيول وكلبا % بعمير وشلوه المجزور % 15(@)(@@) % واشربا ما شربتما إن قيسا % من قتيل وهارب وأسير % % 16(@)(@@) % وطحنا قيس بن عيلان طحنا % ورحنا على تميم تدور % 17(@)(@@) % واسألوا الناس يا معاشر قيس % لمن الدار بعد جهد النفير % % 18(@)(@@) % كم ترى من مقاتل وقتيل % وسنان بعامل مكسور % 19(@)(@@) % ورؤوس من الرجال تدهدى % % وجواد بسرجه معقور % 20(@)(@@) % ثم فاءت سيوفنا حين أبنا % % بجميل من البلاء فخور % PageV01P105 البحر : بسيط تام 1(@)(@@) % تغير الرسم من سلمى بأحفار % وأقفرت من سليمى دمنة الدار % 2(@)(@@) % وقد تكون بها سلمى تحدثني % % تساقط الحلي حاجاتي وأسراري % % 3(@)(@@) % ثم استبد بسلمى نية قذف % وسير منقضب الأقران ، مغيار % 4(@)(@@) % كأن قلبي ، غداة البين ، مقتسم % طارت به عصب شتى لأمصار % 5(@)(@@) % ولو تلف النوى من قد تشوقه % إذا قضيت لبناتي وأوطاري % % 6(@)(@@) % ظلت ظباء بني البكاء ترصده % % حتى اقتنصن على بعد وإضرار % 7(@)(@@) % ومهمة طامس تخشى غوائله % قطعته بكلوء العين مسهار % 8(@)(@@) % بحرة كأتان الضحل ، أضمرها % % بعد الربالة ترحالي وتسياري % % 9(@)(@@) % أخت الفلاة ، إذا شدت معاقدها % % زلت قوى النسع عن كبداء مسفار % 10(@)(@@) % كأنها برج رومي ، يشيده % لز بجص وآجر وأحجار % PageV01P106 11(@)(@@) % أو مقفر خاضب الأظلاف جاد له % % غيث ، تظاهر في ميثاء مبكار % 12(@)(@@) % فبات في جنب 
ms31	 أرطاة تكفئه % ريح شآمية ، هبت بأمطار % 13(@)(@@) % يجول ليلته والعين تضربه % منها بغيث أجش الرعد ، نيار % 14(@)(@@) % إذا أراد بها التغميض ، أرقه % سيل ، يدب بهدم الترب ، موار % 15(@)(@@) % كأنه إذا أضاء البقر بهجته % في أصفهانية أو مصطلي نار % 16(@)(@@) % أما السراة ، فمن ديباجة لهق ، % وبالقوائم مثل الوشم بالقار % 17(@)(@@) % حتى إذا انجاب عنه الليل ، وانكشفت % سماؤه عن أديم مصحر عاري % % 18(@)(@@) % آنسن صوت قنيص إذا أحس بهم % % كالجن ، يهفون من جرم وأنمار % 19(@)(@@) % فانصاع كالكوكب الدري ميعته % غضبان يخلط من معج وإحضار % % 20(@)(@@) % فأرسلوهن يذرين التراب ، كما % % يذري سبائخ قطن ندف أوتار % PageV01P107 21(@)(@@) % حتى إذا قلت نالته سوابقها % % وأرهقته بأنياب وأظفار % 22(@)(@@) % أنحى إليهن عينا غير غافلة % وطعن محتقر الأقران كرار % 23(@)(@@) % فعفر الضاريات اللاحقات به % عفر الغريب قداحا بين أيسار % 24(@)(@@) % يعذن منه بحزان المتان ، وقد % فرقن عنه بذي وقع وآثار % 25(@)(@@) % حتى شتا ، وهو مغبوط بغائطه % يرعى ذكورا أطاعت بعد أحرار % 26(@)(@@) % فرد تغنيه ذبان الرياض ، كما % % غنى الغواة بصنج عند إسوار % 27(@)(@@) % كأنه ، من ندى القراص ، مغتسل % بالورس أو خارج من بيت عطار % 28(@)(@@) % وشارب مربح بالكأس نادمني % % لا بالحصور ، ولا فيها بسوار % 29(@)(@@) % نازعته طيب الراح الشمول وقد % % صاح الدجاج وحانت وقعة الساري % % 30(@)(@@) % من خمر عانة ينصاع الفرات لها % % بجدول صخب الآذي مرار % PageV01P108 31(@)(@@) % كمت ثلاثة أحوال بطينها % % حتى إذا صرحت من بعد تهدار % 32(@)(@@) % آلت إلى النصف من كلفاء أترعها % % علج ، ولثمها بالجفن والغار % 33(@)(@@) % ليست بسوداء من ميثاء مظلمة % ولم تعذب بإدناء من النار % 34(@)(@@) % لها رداءان : نسج العنكبوت وقد % % حفت بآخر من ليف ومن قار % 35(@)(@@) % صهباء قد كلفت من طول ما حبست % في مخدع بين جنات وأنهار % 36(@)(@@) % عذراء ، لم يجتل الخطاب بهجتها % % حتى اجتلاها عبادي بدينار % 37(@)(@@) % في بيت منخرق السربال معتمل % ما إن عليه ثياب غير أطمار % 38(@)(@@) % إذا قول تراضينا على ثمن % ضنت بها نفس خب البيع مكار % 39(@)(@@) % كأنما العلج ، إذ أوجبت صفقتها % % خليع خصل ، نكيب بين 
ms32	 أقمار % 41(@)(@@) % لما أتوها بمصباح ومبزلهم % سارت إليهم سؤور الأبجل الضاري % % PageV01P109 42(@)(@@) % تدمى ، إذا طعنوا فيها بجائفة % فوق الزجاج عتيق غير مسطار % 43(@)(@@) % كأنما المسك نهبى بين أرحلنا % % مما تضوع من ناجودها الجاري % % 44(@)(@@) % إني حلفت برب الراقصات ، وما % % أضحى بمكة من حجب وأستار % 45(@)(@@) % وبالهدي ، إذا احمرت مذارعها % % في يوم نسك وتشريق وتنحخار % 46(@)(@@) % وما بزمزم من شمط محلقة % وما بيثرب من عون وأبكار % 47(@)(@@) % المنعمون بنو حرب وقد حدقت % بي المنية ، واستبطأت أنصاري % % 48(@)(@@) % بهم تكشف عن أحيائها ظلم % حتى ترفع عن سمع وأبصار % 49(@)(@@) % قوم ، إذا حاربوا ، شدوا مآزرهم % % دون النساء ، ولو باتت بأطهار % PageV01P110 البحر : طويل 1(@)(@@) % لعمري ، لقد دلى إلى اللحد خالد % جنازة لا كابي الزناد ، ولا غمر % 2(@)(@@) % مقيم بحوارين ليس يريمها % % سقته الغوادي من ثوي ومن قبر % 3(@)(@@) % تصيح الموالي أن أروا أم خالد % مسلبة تبكي على الماجد الغمر % 4(@)(@@) % إذا جاء سرب من نساء يعدنها % % تعرين ، إلا من جلابيب أو خمر % PageV01P111 البحر : - 1(@)(@@) % صدع الخليط فشاقني أجواري % % ونأوك بعد تقارب ومزار % 2(@)(@@) % وكأنما أنا شارب جادت له % بصرى بصافية الأديم عقار % PageV01P112 البحر : طويل 1(@)(@@) % رأيت قريشا ، حين ميز بينها % % تباحث أضغان وطعن أمور % 2(@)(@@) % علتها بحور من أمية ترتقي % % ذرى هضبة ، ما فرعها بقصير % 3(@)(@@) % أخالد ، ما بوابكم بملعن % ولا كلبكم للمعتفى بعقور % 4(@)(@@) % أخالد ، إياكم يرى الضيف أهله % إذا هرت الضيفان كل ضجور % 5(@)(@@) % يرون قرى سهلا ، ودارا رحيبة % ومنطلقا في وجه غير بسور % 6(@)(@@) % ولو سئلت عني أمية ، خبرت % أغثنا بسيب من نداك غزير % 7(@)(@@) % إذا ما اعتراه المعتفون ، تحلبت % يداه بريان الغمام مطير % 8(@)(@@) % ولو سئلت عني أميةن خبرت % لها بأخ حامي الذمار نصور % 9(@)(@@) % إذا نقشعت عني ضبابة معشر ، % شددت لأخرى محملي وزروري % % 10(@)(@@) % وزار على النابين في الحرب ، لو به % أضرت ، لهر الحرب أي هرير % PageV01P113 11(@)(@@) % وليس أخوها بالسؤوم ، ولا الذي % % إذا زنبته ، كان غير صبور % 12(@)(@@) % أمعشر قيس لم يمتع أخوكم % عمير بأكفان ولا بطهور % 13(@)(@@) % تدل 
ms33	 عليه الضبع ريح تضوعت % بلا نفح كافور ولا بعبير % 14(@)(@@) % وقتلى بني رعل ، كأن بطونها % % على جلهة الوادي بطون حمير % 15(@)(@@) % فإن تسألونا بالحريش ، فإننا % % منينا بنوك منهم وفجور % 16(@)(@@) % غداة تحامتنا الحريش ، كأنها % % كلاب بدت أنيابها لهرير % 17(@)(@@) % وجاؤوا بجمع ناصري أم هيثم % فما رجعوا من ذودها ببعير % 18(@)(@@) % إذا ذكرت أنيابها أم هيثم % رغت جيآل مخطومة بضفير % 19(@)(@@) % ألا أيهاذا الموعدي وسط وائل % ألست ترى زاري وعز نصيري % % 20(@)(@@) % وغمرة موت لم تكن لتخضوها % % وليس اختلاسي وسطهم بيسير % PageV01P114 21(@)(@@) % هم فتكوا بالمصعبين كليهما % % وهم سيروا عيلان شر مسير % 22(@)(@@) % وناطوا من الكذاب كفا صغير % وليس عليهم قتله بكبير % 23(@)(@@) % وأحموا بلادا ، لم تكن لتحلها % % هوازن ، إلا عوذا بأمير % 24(@)(@@) % وذاد تميما والذين يلونهم % بها كل ذيال الإزار فخور % PageV01P115 البحر : طويل 1(@)(@@) % ألا يا اسلمي يا أم بشر على الهجر % وعن عهدك الماضي ، له قدم الدهر % 2(@)(@@) % ليالي نلهو بالشباب الذي خلا % % بمرتجة الأرداف طيبة النشر % 3(@)(@@) % أسلية مجرى الدمع خافقة الحشا % % من الهيف مبراق الترائب والنحر % 4(@)(@@) % وتبسم عن ألمى شتيت نباته % لذيذ ، إذا جات به ، واضح الثغر % 5(@)(@@) % من الجازئات الحور ، مطلب سرها % % كبيض الأنوق المستكنة في الوكر % 6(@)(@@) % وإني وإياها ، إذا ما لقيتها % % لكالماء من صوب الغمامة والخمر % 7(@)(@@) % تذكرتها لا حين ذكرى ، وصحبتي % % على كل مقلاق الجنابين والضفر % 8(@)(@@) % إذا ما جرى آل الضحى وتغولت % كأن ملاء بين أعلامها الغبر % 9(@)(@@) % ولم يبق إلا كل أدماء ، عرمس % تشبه بالقرم المخايل بالخطر % 10(@)(@@) % تفل جلاذي الإكام ، إذا طفت % صواها ولم تغرق بمحمرة سمر % PageV01P116 11(@)(@@) % وتلمح ، بعد الجهد عن ليلة السرى % % بغائرة تأوي إلى حاجب ضمرا % % 12(@)(@@) % تدافع أجواز الفلاة ، وتنبري % % لها مثل أنضاء القداح من السدر % 13(@)(@@) % يقوم ، من أعناقها وصدورها % % قوى الأدم المكي في حلق الصفر % 14(@)(@@) % وكم قطعت ، والركب غيد من الكرى % % إليك ، ابن ربعي ، من البلد القفر % 15(@)(@@) % وهل من فتى من وائل ، قد علمتم % كعكرمة الفياض عند عرى الأمر % 16(@)(@@) % إذا نحن 
ms34	 هايجنا به ، يوم محفل % رمى الناس بالأبصار ، أبيض كالبدر % 17(@)(@@) % أصيل إذا اصطك الجباه ، كأنما % % يمر الثقال الراسيات من الصخر % 18(@)(@@) % وإن نحن قلنا : من فتى عند خطة % ترامى به ، أو دفع داهية نكر % 19(@)(@@) % كفينا بجياش على كل موقف % مخوف ، إذا ما لم يجز فارس الثغر % 20(@)(@@) % بصلب قناة الأمر ما إن يصورها % % الثقاف ، إذا بعض القنا صير بالأطر % PageV01P117 21(@)(@@) % وليسوا إلى أسواقهم ، إذ تألفوا % % ولا يوم عرض عودا سدة القصر % 22(@)(@@) % بأسرع وردا منهم نحو دارهم % % ولا ناهل وافى الجوابي عن عشر % 23(@)(@@) % ترى مترع الشيزى الثقال ، كأنها % % تحضر منها أهلها فرض البحر % 24(@)(@@) % تكلل بالترعيب من قمع الذرى % % إذا لم ينل عبط العوالي من الخزر % 25(@)(@@) % من الشهب أكتافا ، تناخ إذا شتا % % وحب القتار بالمهندة البتر % 26(@)(@@) % وما مزبد الأطواد من دون عانة % يشق جبال الغور ذو حدب غمر % 27(@)(@@) % تظل بنات الماء تبدو متونها % % وطورا توارى في غواربه الكدر % 28(@)(@@) % متى يطرد يسق السواد فضوله % وفي كل مستن جداوله تجري % % 29(@)(@@) % بأجود من مأوى اليتامى ، وملجإ % % المضاف ، وهاب القيان أبي عمرو % % 30(@)(@@) % أعكرم ، أنت الأصل والفرع الذي % % أتاك ابن عم ، زائرا لك ، عن عفر % PageV01P118 31(@)(@@) % من المصطلين الحرب أيام قلصت % بنا وبقيس عن حيال وعن نزر % 32(@)(@@) % وإني صبور من سليم وعامر % ومصر على البغضاء والنظر الشزر % 33(@)(@@) % إذا ما التقينا ، عند بشر ، رأيتهم % يغضون دوني الطرف بالحدق الحضر % 34(@)(@@) % فنحن تلفعنا على عسكريهم % جهارا ، وما طبي ببغي ولا فخر % 35(@)(@@) % ولكن حد المشرفية ساقهم % إلى أن حشرنا فلهم أسوأ الحشر % 36(@)(@@) % وأما عمير بن الحباب ، فلم يكن % % له النصف في يوم الهياج ولا العشر % 37(@)(@@) % وإن يذكروها في معد ، فإنما % % أصابك بالثرثار راغية البكر % 38(@)(@@) % وكان يرى أن الجزيرة أصبحت % مواريث لا بني حاتم وأبي صخر % PageV01P119 البحر : بسيط تام 1(@)(@@) % يادار ذلفاء بين السفح والغار % حييت من دمنة أقوت ومن دار % 2(@)(@@) % جرت عليها رياح الصيف أذيلها % % وكل غادية بالماء مهمار % 3(@)(@@) % تلتج فيها رعود 
ms35	 غير كاذبة % في بارق كنظام الدر موار % PageV01P120 البحر : بسيط تام 1(@)(@@) % لقد غدوت على الندمان ، لا حصر % يخشى أذاه ، ولا مستبطىء زمر % 2(@)(@@) % طلق اليدين كبشر ، أو أبي حنش % لا واغل حين تلقاه ولا حصر % 3(@)(@@) % وقد يغادي أبو غيلان رفقته % بقهوة ليس في ناجودها كدر % 4(@)(@@) % سلافة ، حصلت من شارف خلق % كأنما ثار منها أبجل نعر % 5(@)(@@) % عانية ترفع الأرواح نفحتها % % لو كان يشفى بها الأموات قد نشروا % % 6(@)(@@) % وقد أحدث أروى وهي خالية % فلا الحديث شفانيها ولا النظر % 7(@)(@@) % ليست تداويك من داء تخامره % أروى ، ولا أنت ، مما عندها تقر % 8(@)(@@) % كأن فأرة مسك غار تاجرها % % حتى اشتراها بأغلى سعرها التجر % 9(@)(@@) % على مقبل أروى أو مشعشعة % يعلو الزجاجة منها كوكب خصر % 10(@)(@@) % هل تدنيك من أروى مقتلة % لا ناكت يشتكي منها ولا زور % % PageV01P121 11(@)(@@) % كأنها أخدري في حلائله % له ، بكل مكان عازب ، أثر % 12(@)(@@) % أحفظ ، غيران ، ما تستطاع عانته % لا الورد ورد ولا إصداره صدر % 13(@)(@@) % بعانة رعت الأوعار صيفتها % % حتى إذا زهم الأكفال والسرر % 14(@)(@@) % صارت سماحيج قبا ساعة ادرعت % شعبان ، وانجاب عن أكفالها الوبر % 15(@)(@@) % كأن أقرابها القبطي ، إذ ضمرت % وكاد منها بقايا الماء يعتصر % 16(@)(@@) % يشلهن على الأهواء ذو حرد % على الظعائن ، حتى يذهب الأشر % 17(@)(@@) % دامي الخياشيم ، قد أوجعن حاجبه % فهو يعاقب ، أحيانا ، فينصر % 18(@)(@@) % سحاج عون ، طواه الشد صيفته % فالضلع كاسية والكشح مضطمر % 19(@)(@@) % حتى إذا وضحت في الصبح ضاحية % جوزاؤه وأكب الشاة يحتقر % 20(@)(@@) % وزمت الريح بالبهمى جحافله % واجتمع الفيض من نعمان والخضر % PageV01P122 21(@)(@@) % فظل بالوعر الظمآن يعصبه % يوم تكاد شحوم الوحش تصطهر % 22(@)(@@) % يبحث الأحساء من ظبي وقد علمت % من حيث يفرغ فيه ماءه وعر % 23(@)(@@) % وعزه كل ظن كان يأمله % من الثماد ونشت ماءها الغدر % % 24(@)(@@) % فهو بها سيء ظنا ، وليس له % بالبيضتين ولا بالعيص ، مدخر % 25(@)(@@) % ذكرها منهلا زرقا شرائعه % له ، إذا الريح لفت بينها ، نهر % 26(@)(@@) % فحل ، عذوم ، إذا بصبصن ألحقه % % شد يقصر عنه المعبل الحشر % 27 
ms36	(@)(@@) % يشلهن بصلصال يحشرجه % بين الضلوع وشد ليس ينبهر % 28(@)(@@) % صلب النسور فليس المرو يرهصه % ولا المضائغ من رسغيه تنتشر % 29(@)(@@) % يذود عنها ، إذا أمست بمخشية % طرف حديد وقلب خائف حذر % 30(@)(@@) % وهن مستوجسات يتقين به % % وهو على الخوف مستاف ومقتفر % PageV01P123 البحر : كامل تام 1(@)(@@) % بينا يجول بنا عرته ليلة % بعق تكفئه الرياح وتمطر % 2(@)(@@) % فدنا إلى أرطاته لتجنبه % طورا ، يكب على اليدين ويحفر % 3(@)(@@) % حتى إذا هو ظن أن قد ما اكتفى % % واكتن مال به هيام أعفر % 4(@)(@@) % صرد كأن أديمه قبطية % يرتج من صرد نساه ويخصر % 5(@)(@@) % وكأنما ينصب من أغصانها % % در على أقرابه يتحدر % 6(@)(@@) % حتى إذا ما الصبح شق عموده % وانجاب عنه ليله يتحسر % 7(@)(@@) % ورأى مع الغلس السماء ، ولم يكد % يبدو له منها أديم مصحر % 8(@)(@@) % أم الخروج ، فأفزعته نبأة % زوت المعارف فهو منها أوجر % 9(@)(@@) % من مخلق الأطمار ، يسعى حوله % % غضف ذوابل في القلائد ، ضمر % 10(@)(@@) % فانصاع منهزما وهن لواحق % والشاة يبتذل القوائم يحضر % PageV01P124 11(@)(@@) % حتى إذا ما الثور أفرخ روعه % وأفاق أقبل نحوها يتذمر % 12(@)(@@) % فعرفن حين رأينه ، متحمسا % يمشي بنفس محارب ما يذعر % 13(@)(@@) % أضما وهز لهن رمحي رأسه % إذ قد أتيح لهن موت أحمر % 14(@)(@@) % يختلهن بحد أسمر ، ناهل % مثل السنان جراحه تتنسر % 15(@)(@@) % ومضى على مهل يهز مذلقا % ريان من علق الفرائص ، يقطر % PageV01P125 البحر : بسيط تام 1(@)(@@) % ما زال فينا رباط الخيل معلمة % وفي كليب رباط الذل والعار % 2(@)(@@) % النازلين بدار الذل ، إن نزلوا % % وتستبيح كليب محرم الجار % 3(@)(@@) % والظاعنين على أهواء نسوتهم % وما لهم من قديم غير أعيار % % 4(@)(@@) % بمعرض أو معيد أو بني الخطفى % % ترجو ، جرير ، مساماتي وأخطاري % % 5(@)(@@) % قوم إذا استنبح الأضياف كلبهم % قالوا لأمهم : بولي على النار % 6(@)(@@) % فتمسك البول بخلا أن تجود به % وما تبول لهم إلا بمقدار % 7(@)(@@) % لا يثأرون بقتلاهم ، إذا قتلوا % % ولا يكرون ، يوما ، عند إجحار % 8(@)(@@) % ولا يزالون شتى في بيوتهم % يسعون من بين ملهوف وفرار % 9(@)(@@) % فاقعد ، جرير ، فقد لاقيت مطلعا 
ms37	 % صعبا ، ولا قاك بحر مفعم جار % 10(@)(@@) % إلا كفيتم معدا ، يوم معظلة % كما كفينا معدا ، يوم ذي قار % PageV01P126 11(@)(@@) % جاءت كتائب كسرى ، وهي مغضبة % فاستأصلوها ، وأردوا كل جبار % 12(@)(@@) % هلا منعت شرحبيلا ، وقد حدبت % له تميم بجمع غير أخيار % 13(@)(@@) % يوم الكلاب ، وقد سيقت نساؤهم % كأنه لاعب يسعى بمئجار % 14(@)(@@) % مستردفات ، أفاءتها الرماح لنا % % تدعو رياحا وتدعو رهط مرار % 15(@)(@@) % أهوى أبو حنش طعنا ، فأشعره % نجلاء ، فوهاء ، تعي كل مسبار % 16(@)(@@) % والورود يردي بعصم في شريدهم % % 17(@)(@@) % يدعو فوارس ، لا ميلا ولا عزلا % من الهازم ، شيبا غير أغمار % 18(@)(@@) % ألمانعين ، غداة الروع ، ما كرهوا % % إذا تلبس وراد بصدار % 19(@)(@@) % والمطعمون ، إذا هبت شآمية % تزجي الجهام سديف المربع الواري % % 20(@)(@@) % ما كان منزلك المروت . منجحرا % يا بن المراغة ، يا حبلى ، بمختار % PageV01P127 21(@)(@@) % جاءت به معجلا عن غب سابعة % من ذي لهالة ، جهم الوجه ، كالقار % 22(@)(@@) % أم لئيمة نجل الفحل مقرفة % أدت لفحل لئيم النجل شخار % PageV01P128 البحر : بسيط تام 1(@)(@@) % راح القطين من الثغراء أو بكروا % % وصدقوا من نهار الأمس ما ذكروا % % 2(@)(@@) % إني إذا حلب الغلباء قاطبة % حولي وبكر وعبد القيس والنمر % 3(@)(@@) % أعز من ولدت حواء من ولد % إن الربا لهم والفخر إن فخروا % % 4(@)(@@) % يا كلب إن لم تكن فكيم محافظة % ما في قضاعة منجاة ولا خطر % 5(@)(@@) % أعبد آل بغيض لا أبا لكم % عبسا تخافون والعبسي محتقر % 6(@)(@@) % ما كان يرجى ندى عبس الحجاز ولا % % يخشى نفير بني عبس إذا نفروا % % 7(@)(@@) % ولا يصلي على موتاهم أحد % ولا تقبل أرض الله ما قبروا % % 8(@)(@@) % إذا أناخوا هداياهم لمنحرها % % فهم أضل من البدن الذي نحروا % % 9(@)(@@) % قد أقسم المجد حقا لا يحالفهم % حتى يحالف بطن الراحة الشعر % PageV01P129 البحر : طويل 1(@)(@@) % بنو إسد رجلان : رجل تذبذبت % ورجل أضافتها إلينا التراتر % 2(@)(@@) % بني أسد قيست بي الرهن قبلكم % صلادمها والملهبات المحاضر % 3(@)(@@) % فما وجدت لي الرهن من يوم سقطة % ولا عثرة ، إن البطاء العواثر % 4(@)(@@) % أخنجر لو كنتم قريشا طعمتم % وما 
ms38	 هلكت جوعا بلغوى المعاصر % 5(@)(@@) % إذا لضربتم في البطاح بسهمة % وكان لكم من طير مكة طائر % 6(@)(@@) % ولكنها احتكت بكم قملية % بها باطن من داء سوء وظاهر % 7(@)(@@) % إذا نوفل حلت بزمزم أرحلا % وعبد مناف ، حيث تهدى النحائر % 8(@)(@@) % فكانوا قريشا عند ذاك ، وأنتم % مكان الخصى ، قدامهن المناخر % 9(@)(@@) % فأما تمنيكم قريشا ، فإنه % % مصابيح يرميها بعينيه ناظر % 10(@)(@@) % فما أنتم منها ، ولكنكم لها % % عبيد العصا ، ما دام للزيت عاصر % PageV01P130 11(@)(@@) % فما ختمت أكتافكم لنبوة % وأستاهكم قد أنكرتها المنابر % 12(@)(@@) % بني أسد ، لستم بسبي فتشتموا % % ولكنما سبي سليم وعامر % 13(@)(@@) % بني أسد ، لا تذكروا الفخر بينكم % فأنتم لئام الناس : باد وحاضر % 14(@)(@@) % بني أسد ، لا تذكروا المجد والعلى % % فإنكم في السوق كذب فواجر % 15(@)(@@) % وإن تدع سعدا ، لا تجبك ، ودونها % % لجيم بن صعب ، والحلول الكراكر % 16(@)(@@) % هم يوم ذي قار ، أناخوا ، فجالدوا % % غداة أتاهم بالجموع الأساور % 17(@)(@@) % تمشى بآجام الفرات سفاهة % وتحصد في حافاته وتكاثر % 18(@)(@@) % إذا شئت أن تلقى غلام نزيعة % بنو كاهل أخواله والغواضر % 19(@)(@@) % بنو مردفات ، ردهن لعنوة % قراع الكماة والرماح الشواجر % 20(@)(@@) % أخنجر ، قد أخزيت قومك بالتي % % رمتك فويق الحاجبين السنابر % PageV01P131 21(@)(@@) % فلو كنت ذا عز ببعضه % جبينك ، إذ تدمى عليه البصائر % 22(@)(@@) % فأبد لمن لا قيت وجهك ، واعترف % بشنعاء ، للذبان فيها مصاير % 23(@)(@@) % بنعارة ينفي المسابير أربها % % عليها من الزرق العيون عساكر % 24(@)(@@) % أمن عوز الأسماء سميت خنجرا % وشر سلاح المسلمين الخناجر % 25(@)(@@) % غمرناك إسلاما ، وإن تك فتنة % تكن ثعلبا دارت عليه الدوائر % 26(@)(@@) % ولو كنت أبصرت القنابل والقنا % % وهفوة يوم هيجتها الحوافر % 27(@)(@@) % برابية الخابور ، ما اقترنت لنا % % خزيمة ، إذا سارت جميعا ، وعامر % 28(@)(@@) % وإن امرءا ما بين عينيه كاسته % هجا وائلا ، طرا ، لأحمق فاجر % 29(@)(@@) % فما لك في حيي خزيمة من حصى % وما لك في قيس بن عيلان ناصر % PageV01P132 البحر : طويل 1(@)(@@) % هني ، أجيبي دعوة إن سمعتها % % ولا تكثري أمنا ، هني ، ولا ذعرا % % 2(@)(@@) % وكونوا كأن الذعر لم تشعروا به % إذا لقيت بكر على 
ms39	 حنق بكرا % % 3(@)(@@) % وكونوا على مخفية من رماحنا % % بني عبد بكر ، وانظروا نظرا شزرا % % 4(@)(@@) % لقوم ألظوكم ببوسى ، كأنكم % نشاوى ولم تسقوا طلاء ولا خمرا % % 5(@)(@@) % ولا تزعموا بالوعر ، أن قد منعتم % ولم تمنعوا بالوعر بطنا ولا ظهرا % % 6(@)(@@) % وما أنتم بالمانعين ، وأنتم % تودونها ، من كل فائجة ، قسرا % % 7(@)(@@) % وما رمتم البطحاء ، حتى رددتم % هجان ابن حرب والشآمية الصفرا % % 8(@)(@@) % وبالمرء أفنون فسائل ورهطه % فما ضر في الهيجا أبانا ولا كسرا % % 9(@)(@@) % وسل حنشأ عن حربنا وابن مالك % وجدك ، لم يرجع سواما ولا وفرا % % 10(@)(@@) % نفيناه في أرض العدو ، فأصبحت % وجوه صفي ، من عداوتنا ، صفرا % % PageV01P133 11(@)(@@) % فلو كان حبل ابني طريف معلقا % بأحقي كرام ، أحدثوا فيهما أمرا % 12(@)(@@) % لقد كان جاراهم قتيلا وخائفا % أصم ، فقد زادوا مسامعه وقرا % % 13(@)(@@) % وإن تهج بكر بكر تغلب ، لا تجد % % أخا الحلم شيطاني ، إذا ما هجت بكرا % % PageV01P134 البحر : طويل 1(@)(@@) % لعمرك ما لاقيت يوم معيشة % من الدهر ، إلا يوم شقراء أقصر % 2(@)(@@) % حوارية ، لا يقرب الذم بيتها % % مطهرة يأوي إليها مطهر % 3(@)(@@) % وبيت كظهر الفيل أكثر حشوه % أباريقه ، والشارب المتقطر % 4(@)(@@) % ترى فيه أثلام الأصيص ، كأنه % إذا بال فيه الشيخ ، جفر معور % PageV01P135 البحر : رمل تام 1(@)(@@) % ما يضير البحر أمسى زاخرا % أن رمى فيه غلام بحجر % PageV01P136 البحر : طويل 1(@)(@@) % أتاني ، ودوني الزابيان كلاهما % % ودجلة ، أبناء أمر من الصبر % 2(@)(@@) % أتاني بأن ابني نزار تناجيا % % وتغلب أوفى بالوفاء وبالغدر % PageV01P137 البحر : طويل 1(@)(@@) % لأسماء محتل بناظرة البشر % قديم ولما يعفه سالف الدهر % 2(@)(@@) % يكاد من العرفان يضحك رسمه % وكم من ليال للديار ومن شهر % 3(@)(@@) % ظللت بها يوما إلى الليل واقفا % أسائلها أين الأنيس وما تدري % % 4(@)(@@) % سفاها وقد علقت من أم سالم % ومن جارتيها في فؤادي كالجمر % 5(@)(@@) % ثلاث حسان من نزار وغيرهم % تجمعن من شتى فعولين في قصر % 6(@)(@@) % حلائل شيخ في منيف كأنما % % نماهن قشعم من الطير في وكر % 7(@)(@@) % وما زلت أصبيهن بالقول والصبى % % سفاها وقد يصبى على الخالف الخدر % 8(@)(@@) % لعطشان 
ms40	 حج الماء حتى أطاعني % % رسول إلى العساء طيبة النشر % 9(@)(@@) % لها فضل سن فاستقدن إلى الصبى % % فأمسين قد أعطيتها عقد الأمر % 10(@)(@@) % وأعطيتهن العهد غير مماين % وما أنزل الأروى من الجبل الوعر % PageV01P138 11(@)(@@) % وحدثتهن أنني ذو أمانة % كريم فما يخشين خلفي ولا غدري % % 12(@)(@@) % فقمن إلى جبانة قد علمنها % % لنا أثر فيها كمنزلة السفر % 13(@)(@@) % فثنتان مهما تعطيا ترضيا به % وأسماء ما ترضى بثلث ولا شطر % 14(@)(@@) % وما منعت أسماء يوم رحيلنا % % أمر علي من خطإ ومن وزر % 15(@)(@@) % رأيت لها يوما من الدهر بهجة % فهش لها نفسي وهم بها صدري % % 16(@)(@@) % فثم تناهينا كلانا عن الصبى % % ولا شيء خير من تقى الله والصبر % 17(@)(@@) % سبتك بمرتج الروادف ناعم % وأبيض عذب الريق معتدل الثغر % 18(@)(@@) % ومتسق كالنور من كل صبغة % يضيء الدجى فوق الترائب والنحر % 19(@)(@@) % عشية بطن الشعب إذ أهلنا به % وإذ هي تريك الوجه من خلل الستر % 20(@)(@@) % نزلت بها ضيفا فلم تقر مهنأ % % وجادت بلا ثعل الثنايا ولا حفر % PageV01P139 21(@)(@@) % فملت بها ميل النزيف ونازعت % ردائي والميسور خير من العسر % 22(@)(@@) % فأصبح في آثارنا ومبيتنا % % مرافض حلي من جمان ومن شذر % 23(@)(@@) % مهاة من اللائي إذا هي زينت % تضيء دجى الظلماء كالقمر البدر % 24(@)(@@) % مثقلة الأرداف ليست بمرضع % ولا من نساء اللخلخانية الحمر % 25(@)(@@) % إذا ما مشت مالت روادفها بها % % جميعا كما مال المهيض من الكسر % 26(@)(@@) % يقول لي الأدنون مني قرابة % لعلك مسحور وما بي من سحر % 27(@)(@@) % فقلت أقلوا اللوم لا تعذلونني % % هبلتم هل الصافي من الماء كالكدر % 28(@)(@@) % سريت إليها إذ دجا الليل واحدا % وكم من فتى قد ضافه الهم لا يسري % % 29(@)(@@) % فجئت بتخفير الوصيل وشاعني % % أخو الهم ممقدام على الهول كالصقر % 30(@)(@@) % معي فتية لا يسألون بهالك % إذا ما تناشوا أسبلوا سبل الأزر % PageV01P140 31(@)(@@) % وأجانة فيها الزجاج كأنه % طوافي بنات الماء في لجة البحر % PageV01P141 البحر : طويل 1(@)(@@) % أرى كل معقود له حبل ذمة % يرجي الإياب ، غير ضيف ابن عامر % 2(@)(@@) % أرى شعرأ 