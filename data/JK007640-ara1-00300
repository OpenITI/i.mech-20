ms281	 في حالة غنى % % 26(@)(@@) % إذا هتف الداعي مجيبا ب سمه % % زجرت به طيرا من السعد أيمنا % % 27(@)(@@) % تأملت بالأشراف حسنا ومنظرا % فلم أر أبهى من سناه وأحسنا % % 28(@)(@@) % بأكرمهم كفا وأوفرهم ندى % وأرفعهم قدرا وأمنعهم بنا % % 29(@)(@@) % وكم حدثوا يوم الندى بحديثه % % فقلت أحاديث الكلام إلى هنا % % 30(@)(@@) % وما زال يروي الشعر عن مكرماته % % حديث المعالي عن علاه معنعنا % % PageV01P880 31(@)(@@) % بكل قصيد يحسد العقد نظمها % % تفنن فيها المادحون تفننا % % 32(@)(@@) % بروحي من لا زال منذ عرفته % % إذا ما أساء الدهر بالحر أحسنا % % 33(@)(@@) % نبا لا نبا عني بجانب وده % % ومن لي به لو كان بالورد قد دنا % % 34(@)(@@) % وبي فيه من حر الكلام وجزله % % مقال من العتبى وعتب تضمنا % % 35(@)(@@) % إذا برزت لي حجة في عتابه % % أعادت فصيح النطق بالصدق ألكنا % % 36(@)(@@) % أبا مصطفى إني وان كنتأخرسا % فما زال كلي في ثنائك أسنا % % 37(@)(@@) % أبا مصطفى أما رضاك فمنيتي % % ومن عجب فيك المنية والمنى % % 38(@)(@@) % إذا كان عزي من لدنك ورفعتي % % فلا ترتض لي موطن الذل موطنا % % 39(@)(@@) % ألست امرأ أنزلت فيك مقاصدي % % بمنزلة تستوجب الحمد والثنا % % 40(@)(@@) % وشكران ما أوليتنيه من الندى % % لمتخذ المعروف في البر ديدنا % % PageV01P881 41(@)(@@) % وما كان ظني فيك تصغي لكاذب % % وتقبل قول الزور من ولد الزنا % % 42(@)(@@) % فتبدلني بعد المودة بالقلى % % وتغضب ظلما قبل أن تتبينا % % 43(@)(@@) % وأنت الذي جربتني وبلوتني % % وأنت الذي في الناس تعرف من أنا % % 44(@)(@@) % أبي أشم الأنف غير مداهن % % قريب من الحسنى بعيد عن الخنا % % 45(@)(@@) % صددت وأيم الله لا عن جناية % % وما كان لا والله صدك هينا % % 46(@)(@@) % أبن واستبن أمرا تحيط بعلمه % % لعلك أن تستكشف العذر بيننا % % 47(@)(@@) % وهبني مسيئا ما يزعمونني % % بلائقة منهم فكن أنت محسنا % 48(@)(@@) % وسر إذن نفسي ودع عنك مامضى % % فلا زلت مسرورا ولا زلت في هنا % % PageV01P882 البحر : كامل تام 1(@)(@@) % نزلوا بحيث السفح من نعمان % حيث الهوى وملاعب الغزلان % 2(@)(@@) % هام الفؤاد بهم وزاد صبابة % يا شد ما يلقى من الهيمان % % 3(@)(@@) % يا 
ms282	 ليتهم علموا على بعد النوى % % ماذا ألاقي بعدهم وأعاين % % 4(@)(@@) % كيف السلو ولي فؤاد مغرم % في معزل مني عن السلوان % % 5(@)(@@) % أصبوا إلى وادي العقيق وأدفعي % % لشبيهة وأبيك بالعقيان % % 6(@)(@@) % وبمهجتي نار تشب من الجوى % % إن الجوى لمهيج النيران % % 7(@)(@@) % لا تكثرا عذلي فإن مسامعي % % صمت عن اللاحي إذا يلحاني % % 8(@)(@@) % يا صاحبي ترفقا إني أرى % % فيما أعاني غير ما تريان % % 9(@)(@@) % هذا الفؤاد وهذه أعلاقه % % ضاق الغرام به عن الكتمان % % 10(@)(@@) % فعل دكاري بي لأيام مضت % ما تفعل الصهباء بالنشوان % % PageV01P883 11(@)(@@) % أيام كنت لهوت في زمن الصبا % % وطربت بين مثالث ومثاني % % 12(@)(@@) % أيام نادمت البدور طوالعا % والشمس تشرق من بروج دنان % % 13(@)(@@) % راح إذا عل النديم بكاسها % % ما للهموم عليه من سلطان % % 14(@)(@@) % برزت لنا منها السقاة بقرقف % قد كللت بالدر والمرجان % % 15(@)(@@) % ويديرها أحوى أغن إذا رنا % % سحر العقول بناظر وسنان % % 16(@)(@@) % ومهفهف الأعطاف خلت قوامه % % من خوط بان يا له من بان % % 17(@)(@@) % في روضة تزهو بمنهل الحيا % % بتنوع الأشكال والألوان % % 18(@)(@@) % وتأرجت فيها بأنفاس الصبا % % زهر الربا بالروح والريحان % % 19(@)(@@) % تترنم الأوتار في نغماتها % % من غير ألفاظ أتت لمعاني % % 20(@)(@@) % فكأنما تلك القيان حمائم % تملي عليك غرائب الألحان % % PageV01P884 21(@)(@@) % زمن الشبيبة مذ فقدتك لم أجد % للهو عندي والهوى بمكان % % 22(@)(@@) % فارقت مذ فارقت عصرك أوجها % طلعت علينا كالبدور حسان % 23(@)(@@) % تسطو على العشاق من لحظاتها % % بصوارم مشحوذة وسنان % % 24(@)(@@) % وصحوت من شكر الشباب وغيه % وأرحت من قد لامني ولحاني % % 25(@)(@@) % وعرفت إذ حل المشيب بعارضي % % أن الهوى سبب لكل هوان % % 26(@)(@@) % كان النسيب شقيق روحي والهوى % % في مهجتي وقراره بجناني % % 27(@)(@@) % فهجرته هجر الخليل خليله % % من بعد ما قد حلني وجفائي % % 28(@)(@@) % وأخذت أنشد في الثناء قصائدي % % بالسيد السند العظيم الشان % % 29(@)(@@) % قلدته غرر الثناء قلائدا % ما لم تكن لقلائد العقيان % % 30(@)(@@) % أشفي الصدور بمدحه ، ومديحه % % كالماء ينقع غلة الظمآن % % PageV01P885 31(@)(@@) % إن المناقب والمعالي كلها % % بعلي هذا العالم الإنساني % % 32(@)(@@) % وإذا تعرضنا لجود يمينه % % عرضت لنا 
ms283	 بالعارض الهتان % % 33(@)(@@) % شملت مكارمه العفاة فلم تجد % % غلا غريقا منه بالإحسان % % 34(@)(@@) % متفرد بالمجد واحد عصره % ما في الرجال لمجده من ثان % % 35(@)(@@) % إن عدت الأعيان من ساداتها % % أبصرت عين أولئك الأعيان % % 36(@)(@@) % هذا النقيب الهاشمي ويا له % % إنسان عين العز من إنسان % % 37(@)(@@) % هذا علي القدر و بن علائه % % المنتمي شرفا إلى عدنان % % 38(@)(@@) % كم شنفت أذنا مناقبه التي % % تليت محاسنها بكل لسان % % 39(@)(@@) % وإذا شهدت جماله وجلاله % % أبصرت ما لا تسمع الأذنان % % 40(@)(@@) % لو يدعي فيه الفخار مفاخر % ما احتاج يومئذ إلى برهان % % PageV01P886 41(@)(@@) % حازوا الرئاسة والسيادة والعلى % % أبناء عبد القادر الكيلاني % % 42(@)(@@) % شيخ الطريقة والحقيقة مقتدى % % أهل التقى والدين والعرفان % % 43(@)(@@) % من أوتي الحكم التي قد أعجزت % لقمان عما جاء عن لقمان % % 44(@)(@@) % كشفت له الأسرار وهي غوامض % دقت على الأفكار والأذهان % % 45(@)(@@) % غوث الصريخ المستجير ببابه % % لا معرض عنه ولا متواني % % 46(@)(@@) % مذ فاز حيا في كرامة ربه % % ومن الكرامة فاز بالرضوان % % 47(@)(@@) % ومن المواهب لا يزال مريده % % يعطي مزيد الأمن والايمان % % 48(@)(@@) % من زار مرقده الشريف أمده % % بالروح من إمداده الروحاني % % 49(@)(@@) % لا يستطيع الملحدون بزعمهم % % إنكار ما شهدت به الثقلان % % 50(@)(@@) % وإذا الفتى شملته منه عناية % % أغنت عن الأنصار والأعوان % % PageV01P887 51(@)(@@) % هو قطب دائرة يدور مدارها % % أبد الزمان ومنتهى الدوران % % 52(@)(@@) % بعوارف ومعارف ولطائف % تجلى القلوب بها من الأدران % % 53(@)(@@) % مولاي أنت وأنت غاية مطلبي % % وإليك منتجعي وعنك بياني % % 54(@)(@@) % قد حزت من شهر الصيام ثوابه % % وغنمت فيه الأجر من رمضان % % 55(@)(@@) % فليهنك العيد السعيد بعوده % و سلم ودم فينا أبا سلمان % % PageV01P888 البحر : خفيف تام 1(@)(@@) % كم دم فيك أيها الريم طلا % وفؤاد بجمرة الوجد يصلى % % 2(@)(@@) % فأناس بخمر عينيك صرعى % % وأناس بسيف جفنيك قتلى % % 3(@)(@@) % قل لعينيك إنها قتلتنا % % أحسني بالمتيم الصب قتلا % % 4(@)(@@) % ولك الله من حبيب ملول % غير أن الهوى به لن يملا % 5(@)(@@) % يا عزيزا أذل طوعا لديه % % والهوى يترك الأعز الأذلا % % 6(@)(@@) % إن تعجل بالهجر منك عذابي % % أو 
ms284	 تؤاخذ متيميك فمهلا % % 7(@)(@@) % وإذا ما ستحليت أنت تلافي % % كان عندي وريقك العذب أحلى % % 8(@)(@@) % لايمل العذاب فيك معنى % % وسواك الذي يمل ويقلى % % 9(@)(@@) % يتراءى لعاذلي أنني أسمع % نصحا له وأقبل عذلا % % 10(@)(@@) % يأمر القلب بالسلو ومن لي % % بفؤاد يرضيه أن يتسلى % % PageV01P889 11(@)(@@) % خلني والهوى بآرام سلع % يا خليلي ولا عدمتك خلا % 12(@)(@@) % رب طيف من آل مي طروق % زار وهنا فقلت أهلا وسهلا % % 13(@)(@@) % إن من أرسلتك من بعد منع % قد أساءت قطعا وأحسنت وصلا % % 14(@)(@@) % بعثت طيفها ولم تتناءى % % عن مزاري إلا دلالا وبخلا % % 15(@)(@@) % فلقد كاد أن يبل غليلي % % ذلك الطيف في الكرى أو بلا % 16(@)(@@) % نظرت أعيني منازل في الجزع % % فأرسلت دمعها المستهلا % 17(@)(@@) % لم أكفكف دمعي بفضل ردائي % % بادكار الأحباب حتى بتلا % % 18(@)(@@) % فسقيت الغمام يا دار ظيماء % % موقرات نسيمها المعتلا % 19(@)(@@) % طالما كنت فيك والعيش غض % وعروس من المدامة تجلى % % 20(@)(@@) % أشرب الراح من مراشف ألمى % % جاعلا لي تفاح خديه نقلا % % PageV01P890 21(@)(@@) % ف بك عني عهد الصبا أو تباك % لبكائي والصب بالدمع أولى % % 22(@)(@@) % أين ذاك الهوى وكيف تقضى % % كان خمرا فما له صار خلا % 23(@)(@@) % صاحبي هذه المطي التي % % سارت عشاء تجوب وعرا وسهلا % % 24(@)(@@) % زادها الوجد غلة والنوى وج % وجدا وفرقة الشمل غلا % 25(@)(@@) % تتلظى كأنها في حشاها % % جمرات تذوب منها وتصلى % % 26(@)(@@) % وغدت بعد طيها الأرض طيا % آكلات أخفافها البيد أكلا % % 27(@)(@@) % أرتاها تبغي الندى من علي % فنداه لم يبق في النفس سؤلا % % 28(@)(@@) % ساد أقرانه وكان غلاما % % ثم ساد الجميع إذ صار كهلا % % 29(@)(@@) % وانتضته يد العلى مشرفيا % صقلته قين السيادة صقلا % % 30(@)(@@) % فأراع الزمان منه جمال % وجلا كل غيهب إذ تجلى % % PageV01P891 31(@)(@@) % غمر الناس بالجميل فقلنا % % هكذا هكذا الكرام وإلا % 32(@)(@@) % بأياد تكون في المحل خصبا % في زمان يصير الخطب محلا % % 33(@)(@@) % باذلا كل ما يروق ويحلو % % لا مملا ولا ملولا بذلا % % 34(@)(@@) % والفتى الهاشمي إن جاد أغنا % % ك وإن أجزل العطاء استقلا % % 35(@)(@@) % ربما خلته لفرط نداه % % مكثرا 
ms285	 وهو عند ذاك مقلا % 36(@)(@@) % وسواء لديه في حالتيه % % كثر المال عنده أو قلا % 37(@)(@@) % آل بيت إن كنت لم تدر ماهم % % ف سأل البيت عنهم والمصلى % % 38(@)(@@) % بأبي أنت من سلالة طه % % أشرف الكائنات عقلا ونقلا % % 39(@)(@@) % سيد لا يمينه تقبل القبض % % ولا طبعه يلائم بخلا % % 40(@)(@@) % وبما قد سبقت من جاء بعدا % سيدي قد أدركت من كان قبلا % % PageV01P892 41(@)(@@) % ما تعالت قوم إلى المجد إلا % كنت أعلى منهم وأنت الأعلى % % 42(@)(@@) % طيب الفرع طيب الذات تخشى % % سطوات الظبا وترجى نيلا % % 43(@)(@@) % وإذا كنت أطيب الناس فرعا % كنت لاشك أطيب الناس أصلا % % 44(@)(@@) % يا علي الجناب وابن علي % والمعالي لم ترض غيرك بعلا % % 45(@)(@@) % قد بلوناك يوم لا الغيث ينهل % فشمناك عارضا منهلا % % 46(@)(@@) % ووجدناك للجميع ملاذا % يرتجيك الجميع جودا وفضلا % % 47(@)(@@) % والأماني تلقي ببابك رحلا % كل يوم تمضي وتملأ رحلا % % 48(@)(@@) % وتلاقي حلاحلا جعل الله % % علاه على البرية ظلا % 49(@)(@@) % ربما كان في الأوائل مثلا % لك واليوم لم نجد لك مثلا % % 50(@)(@@) % أنت ذات لدى كل يوم % % ترتقي منصبا وتعلو محلا % PageV01P893 51(@)(@@) % أنت في كل موضع ومكان % آية من جميل ذكرك تتلى % % 52(@)(@@) % فإذا قلت في مديحك شيئا % قيل لي أنت أصدق الناس قولا % % 53(@)(@@) % فتقبل مولاي فيك ثنائي % % ولي الفخر إن تكن لي مولى % % 54(@)(@@) % وتكرم بأخذه ولك الفضل % وما زلت للفضائل أهلا % % 55(@)(@@) % لا تزال الأيام في كل حول % لك عيدا ودمت حولا فحولا % % PageV01P894 البحر : رمل تام 1(@)(@@) % شام برقا راعه مبتسما % % عن يمين الجزع شرقي الحمى % % 2(@)(@@) % فبكى مما به من لوعة % لا بكت أعينه إلا دما % % 3(@)(@@) % دنف قد لعب الوجد به % % ورماه البين فيمن قد رمى % % 4(@)(@@) % وقضى الحب عليه أنه % % لا يزال الدهر صبا مغرما % % 5(@)(@@) % رحمة للصب لو يشكو الجوى % % في الهوى يوما إلى من رحما % % 6(@)(@@) % عبرة يا سعد قد أهرقتها % % ليتها بلت من القلب ظما % % 7(@)(@@) % وإلى الله فؤاد كلما % % ضطرم البرق اليماني ضطرما % % 8(@)(@@) % يا خليلي سعداني إنني 
ms286	 % % لم أجد لي مسعدا غيركما % % 9(@)(@@) % إن للدار سقى الدار الحيا % % أرسما لم تبق مني أرسما % % 10(@)(@@) % أين أقمارك غابت فقضت % % أن ترينا كل فج مظلما % % PageV01P895 11(@)(@@) % وليالي بسلع أجتلي % % كل عذب اللفظ حلوي اللمى % % 12(@)(@@) % كنت ذقت الصبر شهدا فيهم % % ثم ذقت الشهد فيهم علقما % % 13(@)(@@) % كان حبلي بهم متصلا % فرمي بالقطع حتى نصرما % % 14(@)(@@) % لا تسل عن دمع حال طالما % % سال في آثارهم و نسجما % % 15(@)(@@) % زعم الناقل سلواني لكم % % كذب الناقل فيما زعما % % 16(@)(@@) % عجبا من عاذل يعذلني % % في هواكم أبعينيه عمى % % 17(@)(@@) % انقضى العهد فما لي بعده % % آكل كفى عليه ندما % % 18(@)(@@) % أتشافى في عسى لا في عسى % % يشتفي القلب ولا في ربما % % 19(@)(@@) % يعلم الجاهل وجدي فيكم % % كيف لا يعلم أمرا علما % % 20(@)(@@) % لا رعى الله زماني إنه % % كان لا يرعى لحر ذمما % % PageV01P896 21(@)(@@) % كل يوم أنا من أرزائه % % شاهد رزءا يشيب اللمما % % 22(@)(@@) % يبتليني صابرا لم يلفني % % فاغرا فيه من الشكوى فما % % 23(@)(@@) % أتقي أسهمه من حيث لا % % تتقي الأدرع تلك الأسهما % % 24(@)(@@) % وإذا مارسني ، مارسني % % حجرا صماء صلا صيلما % % 25(@)(@@) % وسواء بعد أن جربني % % أقدم الدهر إذن أم أحجما % % 26(@)(@@) % فليجئني الدهر فيما يشتهي % % أنا لا أشكو لداء ألما % % 27(@)(@@) % وحري أن تراني بالغا % بعلي القدر أسباب السما % % 28(@)(@@) % أرتقي فيه العلى لم أتخذ % % مدحه للمجد إلا سلما % % 29(@)(@@) % فقوافي إليه ترتمي % % بالأماني فلنعم المرتمى % % 30(@)(@@) % علوي الجد علوي السنا % % دوحة طالت وفرع نجما % % PageV01P897 31(@)(@@) % سيد من هاشم راحته % % تخجل الغيث إذا الغيث همى % % 32(@)(@@) % من رسول الله من جوهره % % ذلك النور الذي قد جسما % % 33(@)(@@) % % أو تجادله تجادل ضيغما % % 34(@)(@@) % يا له من نعمة في نقمة % إن رمى أصمى وإن فاض طمى % % 35(@)(@@) % كلما داويت آلامي به % % حسم الداء به فانحسما % % 36(@)(@@) % قسما بالغر من أجداده % % أترى أعظم منهم مقسما % % 37(@)(@@) % أنا أستشفي ولكن منهم % بشفاء لم يغادر سقما % % 38(@)(@@) % رضي الله تعالى عنهم % وإذا صلى عليهم سلما % % 39(@)(@@) % أنفقوا الأعمار في 
ms287	 طاعته % % وفضوها صوما أو قوما % % 40(@)(@@) % إنما يرحمنا الله بهم % رحمة تدفع عنا النقما % % PageV01P898 41(@)(@@) % ثقتي فيهم وفيهم عصمتي % % فاز من يغدو بهم معتصما % % 42(@)(@@) % وهم ذخري في آخرتي % % يوم لا أملك فيه درهما % % 43(@)(@@) % يا سماء للعلى أنظم في % % مدحه غر لاقوافي أنجما % % 44(@)(@@) % أنت أنت اليوم فيها سيد % يتقى بأسا ويرجى كرما % % 45(@)(@@) % لا أرى وجدان من لا يرتجى % % للندى والبأس إلا عدما % % 46(@)(@@) % أنت فذ المجد في الناس وإن % كنت والبدر المنير تؤما % % 47(@)(@@) % اتقضى الصوم جميلا ومضى % % قادم كل على ما قدما % % 48(@)(@@) % أقبل العيد نهنيك به % % يا أبا سلمان هنيت بما % % 49(@)(@@) % كان فيه من ثواب دائم % عظم الأجر به إذ عظما % % 50(@)(@@) % حزت أجر الصوم ف سلم و بق لي % % أبدا تولي الغنى والمغنما % % PageV01P899 51(@)(@@) % منعا في البر في أعيادها % % لا تزال الدهر برا منعما % % 52(@)(@@) % مسبغا فيها علينا نعما % أسبغ الله عليك النعما % % 53(@)(@@) % أيها الممدوح فينا ولنا % % بدىء المدح به واختتما % % PageV01P900 البحر : طويل 1(@)(@@) % تبين حق للعباد وباطل % ونلت بحمد الله أنت نائل % 2(@)(@@) % وما حاق مكر السوء بأهله % وبعد فما يدريك ما الله فاعل % % 3(@)(@@) % لقد نقلوا عنك الذي هو لم يكن % % فأدحض منقول وكذب ناقل % % 4(@)(@@) % وجاؤوا بما لم يقبل العقل مثله % % ولا يرتضيه في الحقيقة عاقل % % 5(@)(@@) % شهود كأسنان الحمار فبعضهم % % لبعض وإن يأب الغبي أماثل % % 6(@)(@@) % أراذل قوم ساء ما شهدوا به % % وما ضرت الأشراف تلك الأراذل % % 7(@)(@@) % أتوك بتزوير على حين غفلة % % وأنت عن التزوير إذ ذاك غافل % % 8(@)(@@) % وقلت وقال الخصم ما قال وادعى % % وهل يستوي يا قوم قس وباقل % % 9(@)(@@) % أقام على بطلانه بدليله % % دليلا وللحق الصريح دلائل % % 10(@)(@@) % ولو كان يستجديك فوق آدعائه % % لجدت به فضلا وما أنت باخل % % PageV01P901 11(@)(@@) % ولو أنه يبغي إليك وسيلة % لما خيبته في الرجال الوسائل % % 12(@)(@@) % ولكن بسوء الحظ يثني عنانه % % إلى حيث يشقى عنده من يحاول % % 13(@)(@@) % وإلا لما أمسى يعض بنانه % % يعنفه لاح ويخزيه عاذل % % 14(@)(@@) % ولا 
ms288	 راح محروما مناهل فضلكم % % وكيف وأنتم في النوال مناهل % % 15(@)(@@) % لقد نزع الأشهاد من كل فرقة % % ولا بأس فالقرن المنازع باسل % % 16(@)(@@) % وقد زين الشيطان أعماله له % % على أنه لم يدر ما الله عامل % % 17(@)(@@) % وأعملت الأهواء فيه كما اشتهت % % فلا دخلته بعد هذا العوامل % % 18(@)(@@) % ومن جهله ألقى إلى الزور نفسه % % وجاء بما لم يأته اليوم جاهل % % 19(@)(@@) % وأنى له بالشاهد العدل يرتضى % % ويقدم في إشهاده ويجادل % % 20(@)(@@) % أيشهد ديوث ويقبل قوله % % وهل قال في هذا من الناس قائل % % PageV01P902 21(@)(@@) % وإقرار حربي على غير نفسه % % فلا هو مقبول ولا أنت قابل % % 22(@)(@@) % لدى حكم عدل بدين محمد % % وإن لم يكن عدل فربك عادل % % 23(@)(@@) % ومن ذا قضى بالظن يوما على امرئ % وحسبك حكم الله قاض وفاصل % % 24(@)(@@) % وعار من التدبير والعقل والحجى % % وإن كان قد زرت عليه الغلائل % % 25(@)(@@) % رأى الرأي بعد المال قتلا لنفسه % % على المال حرصا فهو لا شك قاتل % % 26(@)(@@) % كما كان ما قد كان منه وغره % نصيح مداج ، أو عدو مناضل % % 27(@)(@@) % ووافق رأيا فاسدا فأماله % % وكل عن الإقبال بالصلح مائل % % 28(@)(@@) % إذا لم يكن عون من الله للفتى % % فكل معين ما عدا الله خاذل % % 29(@)(@@) % ضلالا لقوم يكنزون كنوزهم % % لأبنائهم والله بالرزق كافل % % 30(@)(@@) % لقد شقيت منهم على سوء ظنهم % % أواخرهم فيما جنته الأوائل % % PageV01P903 31(@)(@@) % ولم يدر مال أودع الأرض طالع % لعمرك أم حتف من الله نازل % % 32(@)(@@) % ستهلك قوم حسرة وتأسفا % عليه وأطماع النفوس قواتل % % 33(@)(@@) % تعجل في الدنيا عقوبة طامع % % ومن نكبات المرء ما هو آجل % % 34(@)(@@) % إذا شام برقا خلبا ظن أنه % % مخايل لا بل كذبته المخايل % % 35(@)(@@) % وما كل برق لاح في الجو ممطر % ولا كل قطر لو تأملت وابل % % 36(@)(@@) % وكم غر ظمآنا سراب بقيعة % وأغناه طيف في الكرى وهو زائل % % 37(@)(@@) % تناول بالآمال منك مرامه % % وأنى له منك المنى والتناول % % 38(@)(@@) % وقد شن غارات الدعاوى جميعها % % إليك ولم تشغله عنك الشواغل % % 39(@)(@@) % ولو حكموا من قبلها في جنونه 
ms289	 % % وعاقته عما كان منه السلاسل % % 40(@)(@@) % لما ذهبت أمواله وتقلبت % به الحال فيما يبتغي ويحاول % % PageV01P904 41(@)(@@) % ولا دنس العرض النقي بشاهد % من العار لم يغسله من بعد غاسل % % 42(@)(@@) % لقد خاب مسعاه وطال وقوفه % % على مطلب ما تحته اليوم طائل % % 43(@)(@@) % وما حصل المعتوه ظنا يظنه % % فلا العرض موفور ولا المال حاصل % % 44(@)(@@) % فيا شد ما لاقيت من سوء ظنه % % ومن فعله فيها وما هو فاعل % % 45(@)(@@) % وتكذيب دعواه وتخجيله بها % % ألا ثكلت أم الكذوب الثوالك % % 46(@)(@@) % تحملت أعباء المشقة للسرى % % وكل نجيب للمشقة حامل % % 47(@)(@@) % وأقبلت إقبال السعادة كلها % % علينا كما وافى من الغيث هاطل % % 48(@)(@@) % يشيرون بالأيدي إليك وإنما % % تشير إلى هذا الجناب الأنامل % % 49(@)(@@) % ليهنك حكم الله يمضي غراره % % مضاء حسام ارهفته الصياقل % % 50(@)(@@) % تبرأت مما ثيل فيك براءة % من الله إشهاد عليه الأفاضل % % PageV01P905 51(@)(@@) % تبرأت من تلك الرذائل نائبا % وحاشاك أن يدنو إليك الرذائل % % 52(@)(@@) % وما تسلك الأوهام فيها حقيقة % % ولا حملت يوما عليها المحامل % % 53(@)(@@) % نعمنا بك الأيام وهي قليلة % % لديك وأيام السرور قلائل % % 54(@)(@@) % وأمست دمشق الشام تشتاق طلعة % لوجهك مثل البدر والبدر كامل % % 55(@)(@@) % وإنك منها بالسرور لقادم % % وإنك عنا بالفخار لراحل % % 56(@)(@@) % لأمر يريد الله كشف عمائه % % تجاب له بيد وتطوى مراحل % % 57(@)(@@) % فمن مبلغ عني دمشق وأهلها % % بشارة ما قد ضمنتها الرسائل % % 58(@)(@@) % عدت منكم فينا عواد عوادل % وسارت لنا فيكم قواف قوافل % % 59(@)(@@) % وأصبح من ناواكم بعد صيته % % كئيبا وأما ذكره فهو خامل % % 60(@)(@@) % تناهى إلى عي فقصر دونه % % وعند النتاهي يقصر المتطاول % % PageV01P906 البحر : كامل تام 1(@)(@@) % ما ودع الصب المشوق وما قلى % % رشأ أغن من السوائح أكحلا % % 2(@)(@@) % يرنو فيرسل من سهام لحاظه % % سهما يصادف من مشوق مقتلا % % 3(@)(@@) % خذ ما تراه عن المتيم في الهوى % % خبر الصبابة مجملا ومفصلا % % 4(@)(@@) % ما آمن الواشي آية صبوتي % % حتى رأى دمعي بحبك مرسلا % % 5(@)(@@) % لا زال يكثر بالملامة عاذلي % % إن المتيم بالملامة مبتلى % % PageV01P907 البحر : طويل 1(@)(@@) % زماني على رغم الحسود مسالمي 
ms290	 % % وإن كان يخشى سطوة فعزائمي % % 2(@)(@@) % ولي همة فوق السماء وعفة % تريني الغنى ، والعز عبدي وخادمي % % 3(@)(@@) % ونحن أناس من قريش أكابر % لبسنا المعالي قبل خلع التمائم % % 4(@)(@@) % وربة قفر قد سلكت فجاجها % % فأمسيت أطوي بيدها بالمناسم % % 5(@)(@@) % وصحبي من البيض الحداد مهند % تعود يوم الحرب حز الغلاصم % % 6(@)(@@) % عذلت على حبيك يا ابنة يعرب % ولم يخل صب من عذول ولائم % % 7(@)(@@) % جرحت بلحظيك الفواد صبابة % وجرح الهوى لم يلتئم بالمراهم % % 8(@)(@@) % فهل من صبا تصبو النفوس لريها % % فتحمل تسليمي إلى أم سالم % % 9(@)(@@) % تذكرت عهدي بالحمى ليلة النقا % % وما أنا من عهدي به غير حالم % % 10(@)(@@) % تقدم لي فيها عهود قديمة % فواصبوتي من عهدها المتقادم % % PageV01P908 11(@)(@@) % أروم بأنفاس النسيم خمودها % % وهل تحمد النيران مر النسائم % % 12(@)(@@) % ومن لي بهاتيك الديار عشية % % أروي ثراها بالدموع السواجم % % 13(@)(@@) % إذا جئتما تلك المعالم ف قرآ % % سلامي على تلك الربا والمعالم % % 14(@)(@@) % معاهد آرام ومغنى صبابة % % تصاد بها الآساد في لحطة باغم % % 15(@)(@@) % يؤرقني فيه الحمام ونوحه % % وما كان وجدي مثل وجد الحمائم % % 16(@)(@@) % رعى الله سكان الغضا فلطالما % % أذابوا بنار الوجد مهجة هائم % % 17(@)(@@) % هم أثموا في قتلي وتجنبوا % % وقد حملوني بعدها وزر آثم % % 18(@)(@@) % فيا ليت قاضي الحب يعدل بيننا % % فينتصف المظلوم من كل ظالم % % 19(@)(@@) % وقائلة ما لي أراك بأرضنا % % حللت محل السر من صدر كاتم % % 20(@)(@@) % تلوم ووجه الليل إذ ذاك عابس % وللبرق في أطرافه ثغر باسم % % PageV01P909 21(@)(@@) % ذريني فما وجدي ثكلتك نافع % % وما الضر والسراء يوما بدائم % % 22(@)(@@) % لئن نام حظي يا أميم عن العلى % % فعزمي كما تدرينه غير نائم % % 23(@)(@@) % إذا كنت واليت الشهاب أبا الثنا % % فلست أبالي بالزمان المخاصم % % 24(@)(@@) % من السادة الغر الكرام مهذب % % مكر على أمواله بالمكارم % % 25(@)(@@) % موارد فضل للأنام وحكمة % % على وردها للناس ألف مزاحم % % 26(@)(@@) % فتى صاغ أيديه المهيمن للورى % % نقيعا لظمآن ووردا لحائم % % 27(@)(@@) % يخبر عن إحسانه بشر وجهه % % ووبل العطايا بعد برق المباسم % % 28(@)(@@) % وما الجود والمعروف إلا سجية 
ms291	 % % يزين بها الباري سجايا الأكارم % % 29(@)(@@) % يمد إليه كفه وفد راغب % % ويقرع عنه خصمه سن نادم % % 30(@)(@@) % فإن جحد الحساد فضلك والنهى % % إذن مزجت بالشهد سم الأراقم % % PageV01P910 31(@)(@@) % فهل لك في فرسانهم من مبارز % % وهل لك في أبطالهم من مصادم % % 32(@)(@@) % وكم من جهول رام بحثك صائلا % فهاب وما للكلب بأس الضراغم % % 33(@)(@@) % وأعظم جهل جهلهم قدرك الذي % % يعد ويرجى للأمور العظائم % % 34(@)(@@) % نشرت الهدى والعلم من بعد طيه % % و حييت علم الدين بين العوالم % % 35(@)(@@) % وشيدت ما أعيا حسودك هدمه % وما كان باني المكرمات كهادم % % 36(@)(@@) % خطبت وخاطبت العفاة بسؤلهم % % فأنسيتنا أخبار قس وحاتم % % 37(@)(@@) % فصاحة نطق يسبق الماء جريه % % وها هو أمضى من شفير الصوارم % % 38(@)(@@) % سأتلو على علياك غر قصائدي % % وكم ناثر مثلي لديك وناظم % % 39(@)(@@) % يهز صناديد الرجال نشيدها % % فتغدو على ذكراك ميل العمائم % % 40(@)(@@) % وحسبي فدتك النفس جودا ونائلا % إذا لحظتني منك عين المراحم % % PageV01P911 41(@)(@@) % وكم منة أسديت لي فملكتني % % سل الروض ما جادت هتان الغمائم % % 42(@)(@@) % وأوليتني باللطف أعظم نعمة % فأصبحت في نعماك فوق النعائم % % 43(@)(@@) % أمت بك الأعداء قهرا بغيظها % % وطعن لساني مثل طعن لهازمي % % PageV01P912 البحر : رمل تام 1(@)(@@) % أيها الدار لقد نلت الحبورا % % وبلغت اليوم مقدارا كبيرا % % 2(@)(@@) % يا عرين المجد يا ركن العلى % % قد حوى غابك ضرغاما هصورا % % 3(@)(@@) % تستفيد الوفد من أفضاله % % جوهر الإفضال والجود الغزيرا % % 4(@)(@@) % إن يكن للدهر جدوى كفه % ما رأت عين على الأرض فقيرا % % 5(@)(@@) % فسقاك الله يا ساحاتها % % من ندى راحته غيثا مطيرا % % 6(@)(@@) % فهو الفرد وأما فضله % كان للمعروف والحسنى كثيرا % % 7(@)(@@) % لم يزل يغمرنا نائله % ومحياه لنا يشرق نورا % % 8(@)(@@) % مشكلات العلم فيه اتضحت % بخفايا العلم تلقاه خبيرا % % 9(@)(@@) % أي دار حلها أرختها % % حازت الدار بمحمود السرورا % % PageV01P913 البحر : رمل تام 1(@)(@@) % مالها تطوي فيافي الأرض سيرا % % وتخد البيد قفرأ ثم قفرا % % 2(@)(@@) % أتراها ذكرت أحبابها % % فطوى فيها المغار الشوق قسرا % % 3(@)(@@) % فلهذا لعب الوجد بها % % فترى أعينها بالدمع عبرى % % 4(@)(@@) % كلما عللها الحادي 
ms292	 بمن % % سكنوا سلعا أحبت منه ذكرا % % 5(@)(@@) % وعلامات الهوى بينة % ليس يخفي الشوق من ذي العشق سترا % % 6(@)(@@) % ذكرت من خيموا بالمنحنى % % فجرت أدمعها شفعا ووترا % % 7(@)(@@) % كل غصن ما بدا إلا أرى % % حاملا من صنعة الخلاق بدرا % % 8(@)(@@) % وإذا يرنو إلى مشتاقه % سل سيف اللحظ عنوانا وكرا % % 9(@)(@@) % شربت من ريقه قامته % % فانثنت من ذلك السلسال سكرى % % 10(@)(@@) % وبقلبي ذلك القد الذي % % بقناه طعن القلب وأفرى % % PageV01P914 11(@)(@@) % وعلى عارضه من حطه % كتب الريحان فوق الخد سطرا % % 12(@)(@@) % أيها الممزج دمعي بدمي % % إنني لم أستطع بالهجر صبرا % % 13(@)(@@) % إن تكن عيناك أنكرن دمي % % فبه خداك عمدا قد أقرا % % 14(@)(@@) % عسلي اللون حلوي اللمى % % لم جرعت أخا الأشجان مرا % % 15(@)(@@) % وأمينأ كن إذا ما لامني % % إن في أذني عن اللوام وقرا % % 16(@)(@@) % ما يفيد اللوم في مستغرم % % عدما يأسره العذال كفرا % % 17(@)(@@) % كيف أنسيت ليالينا التي % % قد تقضت فرحا منا وبشرى % % 18(@)(@@) % إذ أمنا ساحة الواشي بنا % % حيث لم نشرب سوى ريقك خمرا % % 19(@)(@@) % وزمان قد نهبنا شطره % % ما حسبنا غيره في الدهر عمرا % % 20(@)(@@) % لا أبالي بزمان جائر % كان عسرا كله أم كان يسرا % % PageV01P915 21(@)(@@) % إن محمود السجايا قد غدا % % في صروف الدهر لي عونا وذخرا % % 22(@)(@@) % لو أفيضت أبحر من علمه % % ونداه صار هذا البر بحرا % % 23(@)(@@) % إنه لو لم يكن بحرا لما % % قذفت ألفاظه للناس درا % % 24(@)(@@) % لو تفكرت به قلت له % % في علاك الله قد أودع سرا % % 25(@)(@@) % أي معنى غامض تسأله % % وهو لم يكشف عن المضمون سترا % % 26(@)(@@) % وعويصات علوم أشكلن % % زحزحت عنها له الآراء خدرا % % 27(@)(@@) % هبة الله الذي أوهبه % % من علوم جاوزت حدا وحصرا % % 28(@)(@@) % ما سمعنا خبرا عمن مضى % % لم يحط فيه على الترتيب خبرا % % 29(@)(@@) % ركن هذا الدين فيه قائم % % ولكسر العلم قد أصبح جبرا % % 30(@)(@@) % يرد العافون من تياره % شرح الله له بالدين صدرا % % PageV01P916 31(@)(@@) % يوضح المبهم في آرائه % % ويرى الأشياء قبل العين فكرا % % 32(@)(@@) % بذكاء كحسام باتر % أو كزند حيثما 
ms293	 يقدح أورى % % 33(@)(@@) % رزن لو لم يكن إحلاله % % فوق هذي الأرض فينا ما استقرا % % 34(@)(@@) % ولطيف لو معاني خلقه % % عصرت كانت لنا شهدا وخمرا % % 35(@)(@@) % وإذا تصغي إلى ما عنده % % من بيان خلته للذهن سحرا % % 36(@)(@@) % وهدى الله به الناس إلى % % طرق الحق وأبدي فيه أمرا % % 37(@)(@@) % وإذا ما ذكر الله لنا % % وجل القلب به لو كان صخرا % % 38(@)(@@) % بلسان كان بقراط النهى % % علل النفس بذاك الوعظ أبرا % % 39(@)(@@) % وكريم من معالي ذاته % % 40(@)(@@) % وإذا يممته في حاجة % % زاد في ملقاك إكراما وبشرا % % PageV01P917 41(@)(@@) % أيها النحرير في هذا الورى % % والذي فاق بني ذا العصر طرا % % 42(@)(@@) % منذ شاهدتك شاهدت المنى % % وأياديك مدى الأيام تترى % % 43(@)(@@) % وبإحسانك رقي مالك % قبل عرفاتك لي قد كنت حرا % % 44(@)(@@) % هاك مني بنت فكر أبرزت % ليس تبغي غير مرضاتك مهرا % % 45(@)(@@) % هاكها عذراء في أوصافكم % % سيدي و قبل من المسكين عذرا % % 46(@)(@@) % و عذر العبد على تقصيره % % إنها في مدحكم حمدا وشكرا % % 47(@)(@@) % و رغم الحاسد في نيل العلى % % وليمت خصمك إرغاما وقهرا % % PageV01P918 البحر : كامل تام 1(@)(@@) % كف الملام فما يفيد ملامي % % الداء دائى والسقام سقامي % % 2(@)(@@) % جسد تعوده الضنى وحشاشة % % ملئت بلاعج صبوة وغرام % % 3(@)(@@) % حتى إذا حار الطبيب بعلتي % % وقف القياس بها على الإيهام % % 4(@)(@@) % لم يدر ما مرض الفؤاد وما الذي % % أخفيته عنه من الآلام % % 5(@)(@@) % قد أنحلت جسمي بتذكار الغضا % % نار الغضا وتشبثت بعظامي % % 6(@)(@@) % من لي بأيام الغوير وحبذا % % أيام ذاك الربع من أيام % % 7(@)(@@) % أيام لم أقطع بها صلة الهوى % % فكأنما هو من ذوي الأرحام % % 8(@)(@@) % في روضة رضعت أفاويق الحيا % % وهمى عليها المستهل الهامي % % 9(@)(@@) % غناء إن غنت حمائم دوحها % % رقصت لها الأغصان بالأكمام % % 10(@)(@@) % أصغي إلى نغم القيان وأرتوي % % من ريق ممتزج بريق الجام % % PageV01P919 11(@)(@@) % وإذا أخذت الكأس قلت لصاحبي % % العيش في دنياك كأس مدام % % 12(@)(@@) % أيام كنت أمنت طارقة النوى % % وظننت أن الدهر من خدامي % % 13(@)(@@) % مرت كما مر الخيال من الكرى % % ما أشبه الأيام بالأحلام 
ms294	 % % 14(@)(@@) % لله أربعنا التي في رامة % % كانت أجل مطالبي ومرامي % % 15(@)(@@) % يا مسرح الآرام من وادي الحمى % % هل عودة يا مسرح الآرام % % 16(@)(@@) % لي فيك منية عاشق ذي صبوة % % معلومة وتهتك وهيام % % 17(@)(@@) % لما رأت نوق الترحل قد دنت % ورأت على صرف النوى أقدامي % % 18(@)(@@) % نثرت علي من المدامع لؤلؤا % أبهى وأبهج من بديع نظامي % % 19(@)(@@) % إن لامني فيك العذول جهالة % % فالصب في شغل عن اللوام % % 20(@)(@@) % كم ليلة قد بت بعدك في جوى % أرعى نجوم الليل رعي سوام % % PageV01P920 21(@)(@@) % أرجو الصباح ولا صباح كأنه % % كرم يرجى من أكف لئام % % 22(@)(@@) % ما كان أطيب من مواصلة الكرى % % لو يسمح النائي بطيف منام % % 23(@)(@@) % هطلت لأربعك الدوارس عبرتي % % فكأنها يا مي صوب غمام % % 24(@)(@@) % وبللت من تلك الرسوم أوامها % % هذا وما بل البكاء أوامي % % 25(@)(@@) % تلك المواقف لم يكن تذكارها % % في القلب يا ظمياء غير ضرام % % 26(@)(@@) % وأكاد أقطع حسرة وتلهفا % مني على أيامها إبهامي % % 27(@)(@@) % بالله يا نسمات نجد بلغي % % دار السلام تحيتي وسلامي % % 28(@)(@@) % وأخلة حلف الزمان بأنهم % % وجه الزمان وغرة الأيام % % 29(@)(@@) % أقسمت إن القلب لا يسلوهم % % وبرزت بالأيمان والأقسام % % 30(@)(@@) % قوم رميت بسهم بين منهم % % فأصاب هذا القلب ذاك الرامي % % PageV01P921 31(@)(@@) % هل ترجعن الدار ثمة بعدهم % % والربع ربعي والخيام خيامي % % 32(@)(@@) % وأرى سناء أبي الثناء كأنه % % صبح تبلج من خلال ظلام % % 33(@)(@@) % قرم له في الفضل أوفر قسمة % % والفضل كالأرزاق في الأقسام % % 34(@)(@@) % فخرت شريعتنا بمفخر سيد % فخر الشرائع فيه والأحكام % % 35(@)(@@) % إن الذي آوى إليه من الورى % % آوى إلى علم من الأعلام % % 36(@)(@@) % جبل أظل على الأنام ولم يكن % قلل الجبال الشم كالآكام % % 37(@)(@@) % وله وإن رغمت أنوف شمخ % مجد إذا عد الأماجد سامي % % 38(@)(@@) % من قاسه بسواه من أقرانه % % قاس النضار لجهله برغام % % 39(@)(@@) % إن أبصرت عيناك حين يجادل الخصم % الخصم الألد وحان حين خصام % % 40(@)(@@) % فهناك تبصر هيبة نبوية % تصنع الرؤوس مواضع الأقدام % % PageV01P922 41(@)(@@) % ببلاغة مقرونة بفصاحة % ترمي فصيح القوم بالإعجام % % 42(@)(@@) % تقف العقول 
ms295	 حواسرا من دونها % % ما بين إقدام إلى إجحام % % 43(@)(@@) % من كل مشكلة يحير فهمها % % دقت على الأفكار والأفهام % % 44(@)(@@) % عذراء ما كشفت لغير جنابه % % من قبل عن مرط لها ولثام % % 45(@)(@@) % ولقد رأيت لسانه مع أنه % % كالشهد أمضى من شفير حسام % % 46(@)(@@) % ولقد رأيت جنانه كلسانه % % وكلاهما إذ ذاك كالصمصام % % 47(@)(@@) % حجج يروع بهن من أفكاره % % برزت بروز الأسد من آجام % % 48(@)(@@) % حاز النهاية في الفضائل كلها % % حتى من الإحسان والإكرام % % 49(@)(@@) % لو لامس الصخر الأصم تفجرت % % من كفه بسوابغ الإنعام % % 50(@)(@@) % رد ذلك البحر الخضم فإنه % % وأبيك بحر بالمكارم طامي % % PageV01P923 51(@)(@@) % سل ما تشاء تنل مرامك كله % % عن كشف إبهام ونيل حطام % % 52(@)(@@) % و بشر بمترعة الغدير بمائها % % إن شمت بارق ثغره البسام % % 53(@)(@@) % أقلامه افتخرت على سمر القنا % % فرأيت كل الفخر للأقلام % % 54(@)(@@) % خط يسر الناظرين ولم يزل % في العين أحسن من عذار غلام % % 55(@)(@@) % وكأنما نظم النجوم قلائدا % في الكتب مشرقة مدى الأيام % % 56(@)(@@) % فيها لمن طلب الحقيقة مورد % يشفي الصدور بها ويروي الظامي % % 57(@)(@@) % ما أظهر الباري حقيقة فضله % % إلا ليظهر قوة الإسلام % % 58(@)(@@) % الله أكبر أنت أكبر آية % ظهرت بأكبر آية لأنام % % 59(@)(@@) % أرضت أقوام الهدى وبعثت في % % ذاك الرضى غيظا إلى أقوام % % 60(@)(@@) % بمباحث للحق في ميدانها % % إحجام كل سميدع مقدام % % PageV01P924 61(@)(@@) % ولكم عددت لك الجميل ولذ لي % % خطي غداة عددتها وكلامي % % 62(@)(@@) % أنى أعد وإن رقمت محاسنا % كنهاية الأعداد والأرقام % % 63(@)(@@) % لكن رأيت لك المديح مثوبة % فمحوت في إثباتها آثامي % % 64(@)(@@) % لك في قلوب المؤمنين محبة % مزجت مع الأرواح في الأجسام % % 65(@)(@@) % شكرا لأنعمك السوالف إنها % % رفعت برغم الحاسدين مقامي % % 66(@)(@@) % إني عقدت بذيل فضلك ذمة % إن حلت الأيام عقد ذمامي % % 67(@)(@@) % إن تسألن عني فإني لم أزل % % بمشقة الإنجاد والإتهام % % 68(@)(@@) % أصبحت كالجمل الذلول تقودني % % هذي النوى قسرا بغير زمام % % PageV01P925 البحر : مجتث 1(@)(@@) % يا ليلة في الليالي % % حميدة بالوصال % % 2(@)(@@) % مرت بمن أنا أهوى % % مرور طيف الخيال % % 3(@)(@@) % لما رأى سوء حالي 
ms296	 % % ورق لي ورثى لي % % 4(@)(@@) % بكيت منه عليه % % يا سعد حتى بكى لي % % PageV01P926 البحر : طويل 1(@)(@@) % لمن أينق يا سعد ترقل أو تخدي % % تغور في غور وتنجد في نجد % % 2(@)(@@) % حوان كأمثال القسي سهامها % % أعاريب ترمي بالسرى غرض القصد % % 3(@)(@@) % لهم فتكات البيض والبيض شرع % بأغبر من وقع الحوادث مسود % 4(@)(@@) % صواد إلى ورد المنون ومالهم % % من العز إلا كل صافية الورد % % 5(@)(@@) % جحاجحة شم العرانين هتف % بكل بعيد الغور ملتهب الزند % % 6(@)(@@) % على مثل معوج الحنايا ضوامر % % طوين الفيافي كيف ما شئن بالأيدي % % 7(@)(@@) % أقول لحاديها رويدك إنها % % بقايا عظام قد تعقفن بالجلد % % 8(@)(@@) % زجرت المطايا غير وان فسر بها % % على ضعفها لا بالذميل ولا الوخد % % 9(@)(@@) % ألست تراها في رسوم دوارس % لها وقفة المأسور قيد في قيد % % 10(@)(@@) % وما ذاك إلا من غرام تجنه % % وما كان أن يخفى عليك بما تبدي % % PageV01P927 11(@)(@@) % وإلا فما بال المطي يروعها % % ريس جوى يعدو وداء هوى يعدي % % 12(@)(@@) % وشامت وميض البرق ليلا فراعها % % سنا البارق النجي وقدا على وقد % % 13(@)(@@) % وعاودها ذكر الغميم فأصبحت % تلوذ بماء الدمع من حرقة الوجد % % 14(@)(@@) % فسيق إليها الشوق من كل وجهة % % وليس لها في ذلك الشوق من بد % 15(@)(@@) % وقد فارقت من بعد لمياء أوجها % يسيل لها دمع العيون على الخد % % 16(@)(@@) % وساء زمان بعد أن سرها بهم % % فماذا يلاقي الحر في الزمن الوغد % % 17(@)(@@) % ويوشك أن تقضي أسى وتلهفا % على فائت لا يستمال إلى الرد % 18(@)(@@) % سقى الله من عيني أكناف حاجر % % إذا هي تستجدي السحاب فما تجدي % % 19(@)(@@) % ورعيا لأيام مضت في عراصها % % تؤلف بين الظبي والأسد الورد % % 20(@)(@@) % قضينا بها اللذات حتى تصرمت % وكنا ولا نظم الجمان من العقد % % PageV01P928 21(@)(@@) % سلام على تلك الديار وإن عفت % % منازل أحبابي وعهد بني ودي % % 22(@)(@@) % فمن مبلغ عني الأحبة أنني % % حليف الهوى فيهم على القرب والبعد % % 23(@)(@@) % ذكرتهم والوجد في القلب كامن % % عليهم كمون النار في الحجر الصلد % % 24(@)(@@) % فهل ذكروا عهد الهوى يوم قوضوا % % وهل 
ms297	 علموا أني مقيم على العهد % % 25(@)(@@) % وما اكتحلت عيناي بالغمض بعدهم % % كما اكتحلت بالغمض أعينهم بعدي % % 26(@)(@@) % وما رحت أشكو لو حظيت بقربهم % % زمانا رماني بالقطيعة والصد % 27(@)(@@) % أما وعلي القدر وهي ألية % رفعت بها قدري وشدت بها مجدي % % 28(@)(@@) % لقد سد ما بيني وبين خطوبه % % فهل كان ذو القرنين في ذلك السد % 29(@)(@@) % أراني أسارير الزمان إذا بدا % % 30(@)(@@) % ومنه متى حانت إلي التفاتة % فلا نحس للأيام في نظر السعد % % PageV01P929 31(@)(@@) % كريم إذا ستعطفت نائل برة % وقد تعطف المولى الكريم على العبد % % 32(@)(@@) % إذا شاء في الدنيا أراني بفضله % % مشافهة ما قيل في جنة الخلد % % 33(@)(@@) % وأمنني والحادثات تريبني % % فأصبحت أشكو في لظى شدة البرد % % 34(@)(@@) % وقام إلى جدواه يهدي عفاته % % ولا ينكر المعروف بالقائم المهدي % % 35(@)(@@) % يلوح عليه نور آل محمد % % كما لاح إفرند من لاصارم الهندي % % 36(@)(@@) % يكاد يدل الناس ضوء جبينه % % على النسب المرفوع والحسب المعدي % % 37(@)(@@) % نتيجة آباء كرام أئمة % هداة بأمر الله تهدي إلى الرشد % % 38(@)(@@) % ربوا في جحور المجد حتى ترعرعوا % % وفوق جياد الخيل والضمر الجرد % % 39(@)(@@) % فلي فيهم عقد الولاء وكيف لا % % ولم يخلقوا إلا أولي الحل والعقد % % 40(@)(@@) % إذا ما أتى في هل أتى بعض وصفهم % % قرأت على أجداثهم سورة الحمد % % PageV01P930 41(@)(@@) % على أنني فيهم ربيب وإنني % % أعيش بجدواهم من المهد للحد % % 42(@)(@@) % وما أنا في بغداد لولا جميلهم % % لدى منهل عذب ولا عيشة رغد % % 43(@)(@@) % فبورك من لا زال يورثني الغنى % % وذكرني أيام داود ذي الأيدي % % 44(@)(@@) % وهب أنه البحر الخصم لآمل % فهل وقفت منه العقول على حد % % 45(@)(@@) % له بارق الغيث الملث وما له % % لعمر أبيك الخير جلجلة الرعد % % 46(@)(@@) % وما أشبهتك المرسلات بوبلها % % بما لك من جدوى وما لك من رفد % % 47(@)(@@) % أغظت بك الحساد حتى وجدتني % % ملأت بها صدر الزمان من الحقد % % 48(@)(@@) % سلمت أبا سلمان للناس كلها % % ولا روعت منك البرية في فقد % % 49(@)(@@) % ولا حرم الراجون فيما تنيله % % مكارم تستحلى مذاقتها عندي % % 50(@)(@@) % فداؤك نفسي 
ms298	 والأنام بأسرها % % وما أنا من يفديك من بينهم وحدي % % PageV01P931 51(@)(@@) % لتعلوا على الأشراف أبناء هاشم % % وتقضي على علاتها إرب المجد % % 52(@)(@@) % وما زالت مر السخط مستعذب الندى % % فآونة تجدي وآونة تردي % % 53(@)(@@) % كأنك شمس في السماء وإنما % % بضر ضياء الشمس بالحدق الرمد % % 54(@)(@@) % شهدت بأن لا رب غيره % % وأن ندى كفيك أحلى من الشهد % % 55(@)(@@) % لقد عادك العيد المبارك بالهنا % % فبشرته من بعد ذلك بالعود % % 56(@)(@@) % إليك فمهديها إليك قوافيا % محاسن تروى لا عن القد والنهد % % 57(@)(@@) % ربيب أياديك التي يستميحها % % وشاعرك المعروف بالهزل والجد % % PageV01P932 البحر : بسيط تام 1(@)(@@) % ما غاب بدر دجى منكم ولا غربا % % إلا وأشرق بدر كان محتجبا % % 2(@)(@@) % لا ينزع الله مجدا كان معطيه % % آل النبي ولا فضلا ولا أدبا % % 3(@)(@@) % الكاشفون ظلام الخطب ما برحوا % % بيض الوجوه وإن صالوا فبيض ظبا % % 4(@)(@@) % من كل أبلج يزهو بهجة وسنا % تخاله بضياء الصبح منتقبا % % 5(@)(@@) % قد أنفقوا في سبيل الله ما ملكوا % % واستسهلوا في طلاب العز ما صعبا % % 6(@)(@@) % هم الجبال شمخرت رفعة وعلى % هم الجبال وأما غيرهم فربا % % 7(@)(@@) % أبناء جد فما تدنو نفوسهم % % من الدنية لا جدا ولا لعبا % % 8(@)(@@) % عارون من كل ما يزري ملابسه % % يكسوهم الحسن أبرادا لهم قشبا % % 9(@)(@@) % ومنية قد حثثناها فتحسبها % % نجائبا لا وجى تشكو ولا لغبا % % 10(@)(@@) % إلى علي علي القدر مرجعها % % نقيب أشراف غر السادة النجبا % % PageV01P933 11(@)(@@) % الواهب المال جما غير مكتوث % % والمستقل مع الإكثار ما وهبا % % 12(@)(@@) % يريك وفر العطايا من مكارمه % % يوم النوال ، وإن عاديته العطبا % % 13(@)(@@) % قد شرف الله فرعا للنبي سما % % إلى السماء إلى أن طاول الشهبا % % 14(@)(@@) % لم لم يشرف على الدنيا بأجمعها % % من كان أشرف هذي الكائنات إبا % % 15(@)(@@) % هذا هو المجد مجد غير مكتسب % % وإنما هو ميراث ، أبا فأبا % % 16(@)(@@) % من راح يحكيهم بين الورى نشبا % فليس يحكيهم بين الورى نسبا % 17(@)(@@) % أنتم رؤوس بني الدنيا وسادتها % % إن عد رأس سواكم لاغتدى ذنبا % % 18(@)(@@) % لكم خوارق عادات متى ظهرت % % على العوالم 
ms299	 كادت تخرق الحجبا % % 19(@)(@@) % رقت شمائلك اللاتي ترق لنا % % حتى كأنك مخلوق نسيم صبا % % 20(@)(@@) % وفيك والدهر يخشى من حوادثه % % ويرتجى رهبا إذ ذاك أو رغبا % % PageV01P934 21(@)(@@) % صلابة قط ما لانت لحادثة % % وقد تلين خطوب الدهر ما صلبا % % 22(@)(@@) % وعزمة مثل وري الزند لمست % موجا من اليم أضحى موجه لهبا % % 23(@)(@@) % تجنب البخل بالطبع الكريم كما % % تجنب الهجر والفحشاء واجتنبا % % 24(@)(@@) % فنال ما نال آباء له سلفت % % ندب إلى الشرف الأعلى قد انتدبا % % 25(@)(@@) % إن كان آباؤه بالجود قد ذهبوا % % فقد أعاد بهذا الجود ما ذهبا % % 26(@)(@@) % ف نظر لأيديه إن جادت أنامله % % بالصيب الهامل الهامي ترى عجبا % % 27(@)(@@) % أين الكواكب من تلك الماقب إذ % تزهو كما قد زهت بالقطر زهر ربا % % 28(@)(@@) % تلك المزايا كنظم العقد لو تليت % على الرواسي لهزت عطفها طربا % % 29(@)(@@) % يرضى العلاء متى يرضى على أحد % ويغضب الدهر أحيانا إذا غضبا % % 30(@)(@@) % قد بلغت نعم العافين أنعمه % % فلم تدع لهم في غيره إربا % % PageV01P935 31(@)(@@) % يقول نائله الوافي لوافده % % قد فار جالب آمالي بما جلبا % % 32(@)(@@) % أكرم بسيد قوم لا يزال له % % مكارم تركت ما حاز منتهبا % % 33(@)(@@) % نوء السحائب منهل على يده % % فلا فقدنا به الأنواء والسحبا % % 34(@)(@@) % الكاسب الحمد في جود وبذل ندى % يرى لكل امرئ في الدهر ما كسبا % % 35(@)(@@) % نهز غصنا رطيبا كل آونة % % يساقط الذهب الإبريز لا الرطبا % % 36(@)(@@) % فما وجدت إلى أيامة سببا % إلا وجدت إلى نيل الغنى سببا % % 37(@)(@@) % وحبذا القرم في أيام دولته % % حلبت ضرع مرام قط ما حلبا % % 38(@)(@@) % بمثله كانت الأيام توعدنا % % فحان ميعاد ذاك الوعد واقتربا % % 39(@)(@@) % حتى أجابته إذ نادى مآربه % % بمنصب لو دعاه غيره لأبى % % 40(@)(@@) % موقف للمعالي ما ابتغى طلبا % إلا وأدرك بالتوفيق ما طلبا % % PageV01P936 41(@)(@@) % سباق غايات قوم لا لحاق له % % وكم جرى إثره من سابق فكبا % % 42(@)(@@) % مذ كنت أنت نقيبا سيدا سندا % أوضحت آثار تلك السادة النقبا % % 43(@)(@@) % أضحكت بعد بكاء المجد طلعته % % وقد تبسم مجد بعدما انتحبا % % 44 
ms300	(@)(@@) % أحييت ما مات من فضل ومن أدب % فلتفتخر في معاني مدحك الأدبا % % 45(@)(@@) % يا آل بيت رسول الله إن لكم % % علي فضلا حباني الجاه والنشبا % % 46(@)(@@) % وأيديا أوجبت شكري لأنعمها % % فاليوم أقضي لكم بالمدح ما وجبا % % PageV01P937 البحر : بسيط تام 1(@)(@@) % أنعم علي بشيء أستعين به % % على المسير لعل الله يشفيني % % 2(@)(@@) % أقضي بنعماك أوقاتا أعيش بها % % وإن أمت فهي تكفيني لتكفيني % % PageV01P938 البحر : خفيف تام 1(@)(@@) % من لصب متيم مستهام % دنف من صبابة وغرام % 2(@)(@@) % لامه اللائمون في الحب جهلا % وهو في معزل عن اللوام % % 3(@)(@@) % لا تلوما على الهوى دنف القلب % % فما للهوى وما للملام % % 4(@)(@@) % كيف يصحو من سكرة الوجد صب % تاه في سكره بغير مدام % % 5(@)(@@) % ورمته فغادرته صريعا % يا لقومي لواحظ الآرام % % 6(@)(@@) % جردت أعين الظباء سيوفا % ورمتنا ألحاظها بسهام % % 7(@)(@@) % لست أنسى منازل اللهو كانت % % مشرقات بكل بدر تمام % % 8(@)(@@) % تنجلي أكؤس من الراح فيها % % يضحك الروض من بكاء الغمام % % 9(@)(@@) % بين آس ونرجس وبهار % وهزار وبلبل ويمام % % 10(@)(@@) % ومليح مهفهف القد ساجي الطرف % % عذب الرضاب لدن القوام % % PageV01P939 12(@)(@@) % وبورحي ذاك الغرير المفدى % % فيه وجدي وصبوتي وهيامي % % 13(@)(@@) % شهدت واو صدغه مذ تبدى % % أن الام العذار أحسن لام % % 14(@)(@@) % يمزج الراح من لماه % % لشفاني من علتي وسقامي % % 15(@)(@@) % رب ليل أطعت فيه التصابي % % باختلاسي مسرة الأيام % % 16(@)(@@) % برزت في الظلام شمس الحميا % % فمحت بالضياء جنح الظلام % % 17(@)(@@) % ف نتشقنا نوافج المسك لما % % 18(@)(@@) % من معيد علي أيام لهو % أعقبتنا عن وصلها بانصرام % % 19(@)(@@) % وزمان مضى وعيش تقضى % % ما أرى عوده ولو في المنام % % 20(@)(@@) % مر والدهر فيه طلق المحيا % % كمرور الخيال في الحلام % % 21(@)(@@) % لو تبل الدموع غلة صب % بل دمعي يوم الغميم أوامي % % PageV01P940 22(@)(@@) % يوم حان النوى فسالت دموع % % لم أخلها إلا نسجام ركام % % 23(@)(@@) % وتلظت حشاشة اوقدوها % % آل مي من بينهم بضرام % % 24(@)(@@) % كلما نسمت رياح صباها % % قلت يا ريح بلغيها سرمي % % 25(@)(@@) % سقيت دارهم أحبة قلبي % % من دموعي بمثل صوب الغمام % % 26(@)(@@) % إن 