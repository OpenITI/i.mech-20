ms61	 1(@)(@@) % واقفة بلا تعب % % تشكو من الصب لهب % % 2(@)(@@) % كأنها في حسنها % % وقد أتين بالعجب % % 3(@)(@@) % فوارة من فضة % % تمج ماء من ذهب وله يمدح القاضي الفاضل % % PageV01P236 البحر : منسرح 1(@)(@@) % حيت فأحيت بطيب رياها % % هيفاء ظمأى الشفاه رياها % % 2(@)(@@) % بيضاء إن سميت جوارحها % % لواحظا وافقت مسماها % % 3(@)(@@) % أحيت ليالي وصالها دنفا % % وكم ليال بالهجر أحياها % % 4(@)(@@) % رمانتا صدرها تدل على % % أن جنى الجلنار خداها % % 5(@)(@@) % ألثم من خدها بنفسجة % % ونرجسا فتحته عيناها % % 6(@)(@@) % ريمة الإلتفات نافرة % % بالغ في الإحتراس جفناها % % 7(@)(@@) % باهت وشاحا لها معاطفها % % وجانست عقدها ثناياها % % 8(@)(@@) % واحر قلباه من تجاهلها % % إشارة الدمع وهي معناها % % 9(@)(@@) % ولست يوما بالذنب ألزمها % % فإن طبع الزمان أعداها % % 10(@)(@@) % واها لنفس منها ومنه غدت % % سقيمة لا تطيق بلواها % % PageV01P237 11(@)(@@) % أتت لعبد الرحيم قاصدة % % عساه يشكي أليم شكواها % % 12(@)(@@) % كعبة جود وكفها حجر % % يهمي نداها إذا استلمناها % % 13(@)(@@) % جئنا إليها بشق أنفسنا % % من ثقل أيد لها حملناها % % 14(@)(@@) % لها أياد تتابعت فأتى % % معادها لاحقا بمبداها % % 15(@)(@@) % كم منن للعفاة أسداها % % وكم أعاد بالعدل أرداها % % 16(@)(@@) % حمى حمى الملة الحنيفة من % % كتائب في الكتاب أملاها % % 17(@)(@@) % فاستوطنت في الغمود أنصلها % % ولم تثر بعد نار هيجاها % % 18(@)(@@) % جادت يداه بالمال فافتخرت % % على سحاب يجود أمواها % % 19(@)(@@) % لو كان للمجد غاية وندى % % عن الذي حزت ما تعداها % % 20(@)(@@) % أأشتكي الفقر والخمول وإن % % من عطاياك المال والجاها % % PageV01P238 21(@)(@@) % إن قل حظي فحسن رأيك لي % % ذخيرة لا عدمت حسناها وقال يمدحه أيضا ويهنئه بالعيد % % PageV01P239 البحر : متقارب تام 1(@)(@@) % أراق دم الليل سيف الصباح % % فهل شفق الصبح بعد الجراح % % 2(@)(@@) % ونثرت السحب در الندى % % فنظمه الغصن مثل الوشاح % % 3(@)(@@) % فكأن إكليل هام الربا % % قد رصع الغيم برد البطاح % % 4(@)(@@) % وروض شذى زهر ضائع % % تنم به هفوات الرياح % % 5(@)(@@) % وورقاء غنت على عودها % % وقد صفقت أختها بالجناح % % 6(@)(@@) % فصاح إذا أعربت لحنها % % ألا فاعجبن لخرس فصاح % % 7(@)(@@) % فقلبي بذكر اللوى خافق % % مشوق لسكان تلك النواح % % 8(@)(@@) % فتاة خلا قلبها من 
ms62	 هوى % % وقلبي بها قلق كالوشاح % % 9(@)(@@) % إذا سجع الحلي في صدرها % % ترى الورق من حسد في مزاح % % 10(@)(@@) % فبت أناجي غراب الدجى % % وقد كان خضبنا بالجناح % % PageV01P240 11(@)(@@) % فلاحت لنا كف عبد الرحيم % % بيضاء مبسوطة بالسماح % % 12(@)(@@) % أفاضت على الأرض نول النوال % % فدام وعم جميع النواح % % 13(@)(@@) % تنوب صدور رسالاتها % % إذا وردت عن صدور الرماح % % 14(@)(@@) % جرت للعفاة نعم والعداة % % برزق مباح وحتف متاح % % 15(@)(@@) % بها العز مقترن والعزيز % % وكان السماح بها والصلاح % % 16(@)(@@) % إذا ما نظرت إلى طوله % % تقاصر عنه لسان امتداح % % 17(@)(@@) % ولا بد إن طال ليل الدجى % % تقرب موعد صبح النجاح % % 18(@)(@@) % فهنيت عيدا ترينا به % % جميع العدى مثل بعض الأضاح وله يمدحه أيضا % % PageV01P241 البحر : كامل تام 1(@)(@@) % نشرت غدائرهن ليلا ساترا % % وجلت معاجرهن صبحا سافرا % % 2(@)(@@) % سرب مددن شعورهن حبائلا % % فتقنصت منا الهزبر الزائرا % % 3(@)(@@) % عجبا لهن صوائدا ما زلن من % % عبث الصبا عن صيدهن نوافرا % % 4(@)(@@) % من كل طائلة القوام تغض من % % فرط الحيا والتيه طرفا قاصرا % % 5(@)(@@) % ماست فأنطقت النطاق وأخرست % % عند النهوض خلاخلا وأساورا % % 6(@)(@@) % فهي القضيب معاطفا ونضارة % % وهي الربيب سوالفا ونواظرا % % 7(@)(@@) % كم أرسلت لي من تغزل طرفها % % معنى فكنت له بطر في ناثرا % % 8(@)(@@) % إياك عن خنث الجفون فإنه % % يغري بقلب الصب لحظا كاسرا % % 9(@)(@@) % يا رب لجة ليلة أبدى بها % % صدف السحاب من النجوم زواهرا % % 10(@)(@@) % عرضت فخاف الطرف من غرق بها % % فغدا على جسر المجرة عابرا % % PageV01P242 11(@)(@@) % فلو استطعت نظمت زهر نجومها % % مدحا إلى عبد الرحيم سوائرا % % 12(@)(@@) % يمناه محسنة فخذ منها الغنى % % واطرب إذا جس اليراعة ياسرا % % 13(@)(@@) % سبقت إلى مضمار كل فضيلة % % لما امتطت في الطرس أصفر حاسرا % % 14(@)(@@) % لما تعمم بالسواد خطيبها % % صعدت أنامله الكرام منابرا % % 15(@)(@@) % ينسى مكارمه إذا ما كررت % % لكنه للوعد أصبح ذاكرا % % 16(@)(@@) % أخفى الندى والدين غاية جهده % % وكلاهما يمسي ويصبح ظاهرا % % 17(@)(@@) % كم ساس بالصفر القصار ممالكا % % أعيت طوالا شرعا وبواترا % % 18(@)(@@) % مولاي خذ لي الحق من دهر عدا % % فغدا علي 
ms63	 وأنت جاري جائرا % % 19(@)(@@) % وإليك روضة خاطر ممطورة % % تهدي إلى الأمداح عرفا عاطرا % % PageV01P243 
