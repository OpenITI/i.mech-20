ms541	 من حيث فتل % 76(@)(@@) % سهر الحاوون في رقيتها % % وهي صماء تعاصي بالعصل % 77(@)(@@) % يعجز الصارم عن تبليغها % % ما تقول الكتب فيها والرسل % 78(@)(@@) % مد حتى نالها فارسهم % % قلما يذرع والرمح أشل % 79(@)(@@) % أدب البر لها كم فآقتفى % % كلهم جود أبيه وامتثل % 80(@)(@@) % إنما قلل من أموالكم % % فرط ما تعطون والمعطي مقل % PageV01P1680 81(@)(@@) % أنست بالعدم أيمانكم % وإذا سودك الصعب سهل % 82(@)(@@) % ضامني الدهر فجاورتكم % فإذا جاركم من لا يذل % 83(@)(@@) % مكرم يحسب في أبياتكم % % منكم في كل ما طاب وحل % 84(@)(@@) % يرد الماء فيسقى أولا % % لم يسم ضرب غريبات الإبل % 85(@)(@@) % إن مرعى أنت فيه رائدي % % لعميم البنت مأنوس المحل % 86(@)(@@) % رضتني بالحب فاقتد عنقا % % طالما عزت على لي الطلول % 87(@)(@@) % ألهم الشعر بأني ناصح % لك في المدح فصفى ونخل % 88(@)(@@) % حظوة في القول مني قسمت % لك والشعر حظوظ ودول % 89(@)(@@) % كلما عن ترنحت له % % فيشكون أفكر أم ثمل % 90(@)(@@) % شاقني فيك فطربت به % % مرح الطرف إذا حن صهل % PageV01P1681 91(@)(@@) % كل بيت ماثل من دونكم % % هضبة أو سائر سير المثل % 92(@)(@@) % هاجه جودك لي مبتدئا % % ما رعى المجد كمعط لم يسل % 93(@)(@@) % لك حبى حزته أكرمته % % عن عقيم اليد مولود العلل % 94(@)(@@) % فرق من لا ضنين بنعم % % وهي غرم وإذا سيل سعل % PageV01P1682 البحر : - 1(@)(@@) % دع ملاميباللوى أورح ودعني % % واقفا أنشد قلبا ضاع مني % % 2(@)(@@) % ما سألت الدار أبغي رجعها % % رب مسئول سواها لم يجبنى % % 3(@)(@@) % إنما الحظ لقلبي عندها % % ولعهدي لا لعيني وأذنى % % 4(@)(@@) % كن أخا يسعد أو بن عن قلى % فأخى الناصح ما استودعت جفنى % % 5(@)(@@) % أنا يا دار أخو وحش الفلا % % فيك من خان فعزمي لم يخنى % % 6(@)(@@) % قائما أو قائلا مفترشا % % بين خدي وثرى أرضك ردني % % 7(@)(@@) % ولئن غال مغانيك البلى % % عادة الدهر فشخص منك يغنى % % 8(@)(@@) % إن خبت نار فها ذي كبدي % % أو جفا الغيث فها ذلك جفني % % 9(@)(@@) % ممن الراكب نجته أمون % زجرت سانحتي خصب وأمن % 10(@)(@@) % رشدا ما التقم الحادي بها % % نجعة يعشب ما شاء 
ms542	 ويسني % % PageV01P1683 11(@)(@@) % يأخذ الحاجات من غايتها % % سهلة إن يتعنى أو يعني % % 12(@)(@@) % دعوة صالحة مسموعة % فيه إن بلغ ما قلت ألكني % % 13(@)(@@) % أو أبانت خبرا ورحلته % من لوى خبت عن الحي المبن % 14(@)(@@) % كم على وادي أشي من هوى % مستعاد العتب محبوب التجني % % 15(@)(@@) % وبرمان سقى رمان من % % أيكة غناء أو ظبي أغن % 16(@)(@@) % ووفاض للتصابي ملئت % ملء أعراضك من طيب وحسن % 17(@)(@@) % وغصيني جموح فتلت % رأسه الشارد حرى بنت غصن % 18(@)(@@) % خلطت حزنا بتغريد فما % % فرق السمع أتبكي أم تغني % % 19(@)(@@) % غرة في العيش كانت أفرجت % قبضة الأيام عنها بعد ضن % 20(@)(@@) % ثم عادت تقتضيني ردها % % أين هذا قبل أن يغلق رهني % % PageV01P1684 21(@)(@@) % حيث لم يلحم عذاري ولا % % رجمت بعد بشهب الشيب جني % % 22(@)(@@) % يا بياضا لست أولى وقعة % لي مع الدهر وجلى طرقتني % % 23(@)(@@) % إنما يستطرف الروعة من % % نفرت منه بقلب مطمئن % 24(@)(@@) % ما دعا باسم سوى اسمي شره % % قط إلا خلته إياي يعنى % % 25(@)(@@) % عبده من ظن خيرا عنده % % إنما حسن حالي سوء ظني % % 26(@)(@@) % لم يزل بي اليأس حتى لم تجد % % معلقا في حبالات التمني % % 27(@)(@@) % فارض خلقى أو فسل خصمي بي % % ربما لم ترض عن قولي سلني % % 28(@)(@@) % لا تجاذب رسنى في طمع % % وكا شئت مع الود فقدني % % 29(@)(@@) % ومتى تسمع بقوم أعجفوا % % ليعزوا فابغني فيهم تجدني % % 30(@)(@@) % جمة الدنيا يسخيني بها % % شربي النطفة لم تمزج بمن % PageV01P1685 31(@)(@@) % قل لمن أنبض لي يوعدني % % برقة تشهد أن ليست لمزن % 32(@)(@@) % قد أتتني فتبسمت لها % % وقليلا أنست بالضحك سني % 33(@)(@@) % ربما قبلك واف ذرعه % % مسح الأفق بكف لم تنلني % % 34(@)(@@) % ود لو ما تقلب الأرض به % % قبل أن يقلب لي ظهر المجن % 35(@)(@@) % سام بغضا بي فلما داسها % % فرآها جمرة قال أقلني % % 36(@)(@@) % كن عدوا مبديا صفحته % % أو فسالمني إذا لم تك قرني % % 37(@)(@@) % أبق من يومي نصيبا لغدي % % ربما سرك ما ساءك منى % % 38(@)(@@) % في اشتباه الناس ود بينهم % % وحزازات التنافي شر ضعن % 39(@)(@@) % كم عدو 
ms543	 سل من ظهر أبي % % وأخ لي أمه ما ولدتني % % 40(@)(@@) % سقيت أنفس وافين زكت % بهم أرضى واستثمر غصني % % PageV01P1686 41(@)(@@) % أدركوني مثقل الظهر فحطوا % % كلف الأيام عن جلبة متني % % 42(@)(@@) % وتمطيت بجنبي أجإ % منذ قاموا يزحمون الدهرعني % % 43(@)(@@) % أدبوا الأيام لي فاعتذرت % بعد أن كانت تجنى وهي تجني % % 44(@)(@@) % ببني عبد الرحيم اعتدلت % واستقامت بعد ميل وتثني % % 45(@)(@@) % المحامون على أحسابهم % % بصريحات من المال وهجن % 46(@)(@@) % وفروا الذكر فما يحفزهم % % ما أصاب المال من نقص ووهن % 47(@)(@@) % تزلق الفحشاء عن أعراضهم % % زلق الشفرة عن ظهر المسن % 48(@)(@@) % صرح الجدب فغطوا شمسه % % بسحاب من نداهم مرجحن % 49(@)(@@) % ودجا القول فعطوا ليله % % بحديدات من الألسن لحن % 50(@)(@@) % تنطق السهل على ما ركبت % من ظهور صعبة الأرداف خشن % PageV01P1687 51(@)(@@) % بلغوا منها ومنأقلامهم % % غاية الأبطال من ضرب وطعن % 52(@)(@@) % وأنابيب خفاف كسبت % % من ندى أيديهم هزة لدن % 53(@)(@@) % تقنص الأغراض ركضا كلما % % أدركت فيا تعدته لفن % 54(@)(@@) % حلماء تعدل الأرض بهم % كلما مالت من الجهل بركن % 55(@)(@@) % خلقوا من طينة الفضل فما % % يرجع اليافع عن شأو المسن % 56(@)(@@) % كلما شارف عمريه أب % منهم آزره الإقبال بابن % 57(@)(@@) % وإذا قال دعي إنني % % منهم قال له المجد وإني % % 58(@)(@@) % بأبي سعد وفى عهد العلا % % لأبيه وشروط المتمني % % 59(@)(@@) % سبق الناس فتى علمهم % % أنه لا يحرز السبق بسن % 60(@)(@@) % لو رأى فيهم سوى والده % % أولا ما كان يرضى أن يثني % % PageV01P1688 61(@)(@@) % زاده مجدا وإن كان له % % في مساعيه من السؤدد مغنى % % 62(@)(@@) % إن رمى شاكلة فهو مصيب % أو جزى يوم عطاء فهو مسنى % % 63(@)(@@) % يخلف المال لأن يتلفه % % وبقاء العز للأموال مفنى % % 64(@)(@@) % حذيت نعليك خدا ناقص % حدثته بك جهلات التظنى % % 65(@)(@@) % خابط يصلد في الخطب وتوري % % وحريص يهدم المجد وتبني % % 66(@)(@@) % راح سرح الهم عنى عازبا % بك واستأسر للأفراح حزني % % 67(@)(@@) % صدتني بالخلق الرحب وكم % % قد تقبضت بخلق لم يسعني % % 68(@)(@@) % ما تخيلتك حتى جبتهم % % باحثا أقلبهم ظهرا لبطن % 69(@)(@@) % رطبت بالشكر صدقا شفتى % % منذ ألقيت إلى 
ms544	 بحرك شني % % 70(@)(@@) % فتسمع فقرا أقراط أذن % هي في أعدائها وقرة أذن % PageV01P1689 71(@)(@@) % من بنات السير لو أطلقها % % حظها ما انتظرت سهلا بحزن % 72(@)(@@) % يتبادرن مروقا من فمي % % فكأن لم يتقيدن بوزن % PageV01P1690 البحر : - 1(@)(@@) % من مخبري عن الطفل % قلص بعد ما أظل % 2(@)(@@) % تناصل البرد السمل % ينصاع من فرط الوجل % 3(@)(@@) % من الصباح المشتعل % نجاء صل من وعل % 4(@)(@@) % أتبع منه بالأمل % % منسلخا لا يستهل % 5(@)(@@) % كنت المدل المحتمل % أيام نبتي مبتقل % 6(@)(@@) % غصن يلس بالقبل % فليته لم يكتهل % 7(@)(@@) % ظل دجى لما انتقل % تحامت الشمس المقل % 8(@)(@@) % يا هل ولا تنفع هل % يخضب دهر ما نصل % 9(@)(@@) % قنعت منه إذ رحل % ببدل ولا بدل % 10(@)(@@) % مضى بشرات الجذل % وجاء يأخذ الأجل % PageV01P1691 11(@)(@@) % طارق شر مذ نزل % أنكرت عاداتي الأول % 12(@)(@@) % ضيف سرى على عجل % خاض الدجى وما استدل % 13(@)(@@) % ثار ولا أرغى جمل % منبسطا وما سئل % 14(@)(@@) % ولا دعا بحي هل % قريته ولم أبل % 15(@)(@@) % البكرات والبزل % والضرع جهد ما احتفل % 16(@)(@@) % نغبقه فما قبل % لحم سواى في الأكل % 17(@)(@@) % حتى انتقى لحمي وخل % عط الظبا رث الخلل % 18(@)(@@) % وقادني نضوا أبل % مع الرذايا والهمل % 19(@)(@@) % مطرحا لا أحتفل % % مطرحة الشن النغل % 20(@)(@@) % موت الشباب والغزل % ذكرت والذكرى شغل % PageV01P1692 21(@)(@@) % بين الجفير والقلل % حيا فؤادي فيه حل % 22(@)(@@) % رامين بالسود النجل % فلا يخيب المنتبل % 23(@)(@@) % يصبن ما تخطى ثعل % فعادني عيد الخبل % 24(@)(@@) % قرفك جرحا ما اندمل % % فانشد رقادي أين ضل % 25(@)(@@) % يوم الأسير في الطول % يا دار إني لم أسل % 26(@)(@@) % حين حليت بالعطل % ونضب الدمع وقل % 27(@)(@@) % أين الشموس في الكلل % كل مهاة لم يزل % 28(@)(@@) % جريحها حتى قتل % مرودها إذا صقل % 29(@)(@@) % لونه صبغ الكحل % ذات قوام معتدل % 30(@)(@@) % من التريب والكفل % بين النشاط والكسل % PageV01P1693 31(@)(@@) % إذا احتبين بالأصل % على الأحاديث الفضل % 32(@)(@@) % ونظم العقد وحل % من العفاف والخجل % 33(@)(@@) % وقد تركن في الظلل % مثل مبارك الإبل % 34(@)(@@) % يا دهر أنت والعذل % % قد وقر السمع ومل 
ms545	 % 35(@)(@@) % غرك من عود بزل % نهوضه بما حمل % 36(@)(@@) % عقلا قد اشتاق العقل % رب طليق محتبل % 37(@)(@@) % قد عدت من تحت الرحل % كأن غارتي أظل % 38(@)(@@) % كم أطلب الأمر الجلل % بنصر أيام خذل % 39(@)(@@) % أعلو بحظ قد نزل % أسوم خرقاء العمل % 40(@)(@@) % أي يد لو لم تشل % لا تسع الرزق الحيل % PageV01P1694 41(@)(@@) % ما أطعم الدهر فكل % وما حذاك فانتعل % 42(@)(@@) % يا سقمي كيف أبل % والطب أعوان العلل % 43(@)(@@) % إن يك مقدار جهل % أو سحر آمال بطل % 44(@)(@@) % فقد يقيلك الزلل % مولى إذا قال فعل % 45(@)(@@) % حي ابن أيوب ومل % إلى ذراه فاستظل % 46(@)(@@) % تر الأنام في رجل % سود في العشر الأول % 47(@)(@@) % وتم وهو مقتبل % وداس عوصاء السبل % 48(@)(@@) % إلى الكمال فكمل % إن روح المزن انهمل % 49(@)(@@) % أو أورق الغصن حمل % مد يمينا فبذل % 50(@)(@@) % لولا الندى لم تبتذل % هامرها الغيث الهطل % PageV01P1695 51(@)(@@) % مطاولا فلم ينل % % حتى إذا زادت وقل % 52(@)(@@) % صاح بها وقد نكل % هذا السماح لا شلل % 53(@)(@@) % أي فتى عقد وحل % % إن عافت الرأي الشكل % 54(@)(@@) % ومر يرتاد العلل % رب الضمير المنقفل % 55(@)(@@) % أنهل رأيا وأعل % إذا طغى الخطب وجل % 56(@)(@@) % وعذرت على الفشل % نفس الشجاع المصمئل % 57(@)(@@) % وقذف الجرح الفتل % وكن أدواء عضل % 58(@)(@@) % خاض من البحر وشل % ضحضاحه ثم وأل % 59(@)(@@) % يعصر ذيلا من بلل % لا مكرها لكن بطل % 60(@)(@@) % فتك عجول في مهل % مصابر طول الطيل % PageV01P1696 61(@)(@@) % إن ركب القرن نزل % % يجيل فكرا لم يجل % 62(@)(@@) % إلا لتقويم خطل % يصحو به اليوم الثمل % 63(@)(@@) % له وراء ما فعل % عين عقاب يوم طل % 64(@)(@@) % من معشر راضو الدول % وملأوا فرج الخلل % 65(@)(@@) % واحتلفوا فلم تحل % % أيمانهم على بطل % 66(@)(@@) % لا صحبوا العيش بذل % إن أكل المال عدل % 67(@)(@@) % مكثرهم حال المقل % إن هوموا على ذحل % 68(@)(@@) % سلوا الكرى من المقل % وشمروا الردن الفضل % 69(@)(@@) % عن كل عبل منصقل % يحسب من غمد يسل % 70(@)(@@) % بالسمهري قد فتل % كأنه من الذبل % PageV01P1697 71(@)(@@) % وأفرغوا من العجل % % على عصارات 
ms546	 المقل % 72(@)(@@) % سيوفهم إثر الفلل % % تأخذ ما أبقى الأسل % 73(@)(@@) % جربت والسيف نكل % وإخوة الفقر قلل % 74(@)(@@) % محمدا فلم يحل % عن شيم المجد الأول % 75(@)(@@) % يقظان كالسمع الأزل % يعقلها ويتكل % 76(@)(@@) % كم لك في العام الأزل % من شافيات للغلل % 77(@)(@@) % من دبر ومن قبل % مفصلات وجمل % 78(@)(@@) % جودا وفي البحر بخل % أطلعني فوق الأمل % 79(@)(@@) % حتى كفاني وفضل % فإن جرى قول عمل % 80(@)(@@) % أو يعدل القطر السبل % فقد مصاعيب ذلل % PageV01P1698 81(@)(@@) % بنات فكر منتخل % يولدن من غير حبل % 82(@)(@@) % إذا مررن في الرحل % بيبس فهو خضل % 83(@)(@@) % حاملها بما نقل % في الركب مرحان جذل % 84(@)(@@) % كأنه قد استهل % ببابه يوم ثمل % 85(@)(@@) % كم سهم حاسد نصل % عنها وقد خاب وذل % 86(@)(@@) % يذم منها ما جهل % ووده إذا احتفل % 87(@)(@@) % بالبيت منها لو وصل % % يقرضه أو ينتحل % 88(@)(@@) % أو لم يقل فقد هبل % من لك أعمى بالحول % 89(@)(@@) % لا تبلغ الموتى الرسل % إن كنت قوالا فقل % 90(@)(@@) % قد جاءني ما يرتجل % من عيبتي فما عمل % PageV01P1699 91(@)(@@) % مبردقين في الجبل % % أمدد يدا قبل زحل % 92(@)(@@) % إذا ابن أيوب كفل % يحفظ غيبي لم أبل % 93(@)(@@) % اسلم يسالمك الأجل % ونل ذرى العز وطل % 94(@)(@@) % في كل يوم مقتبل % إن طرق الخطب الجلل % 95(@)(@@) % حجبته فلم يصل % وصب إذا الغيث مطل % 96(@)(@@) % إنك من قوم فعل % % PageV01P1700 البحر : - 1(@)(@@) % تروح من وجرة الظاعنونا % % فكان الذي ساءني أن يكونا % % 2(@)(@@) % يمينا لعز مرام السل % % و أن تتركوا جنب خبت يمينا % % 3(@)(@@) % هوى بعدهم أمم لا يري % % م يسأل عنهم مزارا شطونا % % 4(@)(@@) % رميت بطرفي ومن مثل ما % % جنى تتشكى القلوب العيونا % % 5(@)(@@) % وراء الحمول إلى أن قتل % % ت شك الفراق بعيني يقينا % % 6(@)(@@) % وقد مات إنسانها حيرة % فغادرته في دموعي دفينا % % 7(@)(@@) % وفي الركب معرفة الإنتساب % % إذا ما القدود ادعين الغصونا % % 8(@)(@@) % إذا شعشعت قبسى وجهها % % عنت لهما بقرالرمل عينا % % 9(@)(@@) % تشير إلي بأسروعة % تكاد وما أفصحت أن تبينا % % 10(@)(@@) % إذا خشيت ظمأ لم يزل % % لها مدد 
ms547	 من دم العاشقينا % % PageV01P1701 11(@)(@@) % أنامل يبسطن رسل الوفاء % إلي ويقبضن للكاشحينا % % 12(@)(@@) % فتاة رأت خطلا في القناة % % فألقت عليها اعتدالا ولينا % % 13(@)(@@) % تنغص بالورد في خدها % % إذا لم تجدني في المجتنينا % % 14(@)(@@) % إذا قلبت قدما أو يدا % تمنت يدي قلبا أو برينا % % 15(@)(@@) % وتحت الرحال صعاب الخطا % % يدسن سهول الفيافي حزونا % % 16(@)(@@) % سواء عليهن يوم الوداع % % حذين دما أو لبين حدينا % % 17(@)(@@) % إذا ما افتلين جمام الريا % % ض أجممنها واجتررن البطونا % % 18(@)(@@) % ذوى البقل من حر أنفاسهن % كأني أعديتهن الحنينا % % 19(@)(@@) % حمى الله والعربي الذما % % م عهدا على وجرة أن يمينا % % 20(@)(@@) % وحيا وجوها تميمية % صرائح ما كان حسن هجينا % % PageV01P1702 21(@)(@@) % مزجن الجمال بماء الحيا % % ء لو رفق المزج بالشاربينا % % 22(@)(@@) % وأرهفن قبل نصول العيون % % فقدت ولم تتخاذل طعينا % % 23(@)(@@) % ألا طربا يا مغني القلاص % بهم وهى تصعب حتى تلينا % % 24(@)(@@) % أعد إن ذكرهم عوذة % ولا تحسب الحب إلا جنونا % % 25(@)(@@) % حنتنى الخطوب فما لي ألوم % % على سرعة الهرم الأربعينا % % 26(@)(@@) % وأعجب من قبلها كيف شب % % ت والشيب لا يستشير السنينا % % 27(@)(@@) % لئن أكثرت عثرات الخطوب % % بحظي جرائحها والوهونا % % 28(@)(@@) % فقد فر منى لجاج الزما % % ن قارح عشر أبيا حرونا % % 29(@)(@@) % سل الحادثات على ما غمز % % ن جنبي هل وجد الغمز لينا % % 30(@)(@@) % وهل سمعت لي إلى أن بعث % % ت في أهل ودي لشكوى أنينا % % PageV01P1703 31(@)(@@) % فيا ليتها قنعت في الخطوب % % بنفسي ورفهت الآخرينا % % 32(@)(@@) % ويا ليتها حين لم تنتفع % % بحربي تجنح للسلم حينا % % 33(@)(@@) % وقد جربتني قرنا فما % % وفت بي فهلا اجتبتني قرينا % % 34(@)(@@) % وفيت بدهري وأيامه % % ولكن عجزت عن الحاسدينا % % 35(@)(@@) % وكيف يصح بياض الوفا % % ء يوما على كثرة الصابغينا % % 36(@)(@@) % إذا كشف الخبر عيب الرجال % % فدامج ودع كل عيب ظنونا % % 37(@)(@@) % لحا الله كل أجب الحفاظ % % بعيدا من الرشد عقلا ودينا % % 38(@)(@@) % يعد الكرامة وجه النفاق % % ويرضى بأفعاله أن يهونا % % 39(@)(@@) % تكلم حلوا وتحت الضلو % % ع حنظلة الشر للماضغينا % % 40(@)(@@) % إذا بت تأمن وثباته % % لقاء خبا لك 
ms548	 خبئا كمينا % % PageV01P1704 41(@)(@@) % كصل الحماطة يطوى الحما % % م صعبا ويعطيك باللمس هونا % % 42(@)(@@) % يبيت يراقب أنى تعن % له هفوة منك حتى يخونا % % 43(@)(@@) % تعلمت من غدره باسما % % بأن الوفاء مع القاطبينا % % 44(@)(@@) % عقارب أطمعها لسبها ال % % حفاة فدبت إلى الناعلينا % % 45(@)(@@) % علا حظهم ووهى مجدهم % % فقد وألوا من فمي سالمينا % % 46(@)(@@) % ولم أك مع غضبي إن غضبت % لأهتك إلا حريما مصونا % % 47(@)(@@) % وقد كنت أمضغهم بالهجا % % ء لو أكل الشعر منهم سمينا % % 48(@)(@@) % أصون لساني عن الغادري % % ن صون طلابي عن الباخلينا % % 49(@)(@@) % حرام علي اجتداء الرجا % % ل لا مانعين ولا باذلينا % % 50(@)(@@) % إذا أنا يوما سألت الجواد % حرصت غدا فسألت الضنينا % % PageV01P1705 51(@)(@@) % بلى إن في آلعبد الرحيم % % مكارم تفسح للراغبينا % % 52(@)(@@) % وبين بيوتهم للضيوف % جفانا عماقا وسرحا لبونا % % 53(@)(@@) % وأندية تسع السامعين % % قرى وجوها تضيف العيونا % % 54(@)(@@) % وسيبا يبر له المقسمو % % ن لا وردوا الماء إلا معينا % % 55(@)(@@) % ذعرت زماني بأسمائهم % % فكن من الدهر دونى حصونا % % 56(@)(@@) % وفرق عزهم النائبا % % ت عنى وقد بتن حولى عزينا % % 57(@)(@@) % وحملت ثقليعميد الكفا % % ة منهم فكان القوي الأمينا % % 58(@)(@@) % من القوم تشرق نيرانهم % % على النجم إن طامن الموقدونا % % 59(@)(@@) % وتأرج أرواح أبياتهم % % رسائل عنهم إلى الطارقينا % % 60(@)(@@) % إذا ما رأيت ازدحام الحقوق % % عليهم عجبت لهم ثابتينا % % PageV01P1706 61(@)(@@) % ومن أذكيت ناره باليفا % % ع في القر زاحمه المصطلونا % % 62(@)(@@) % مساميح لم يعرقوا بالعضا % % ض أيديهم في ندى نادمينا % % 63(@)(@@) % ولم يدفعوا في صدور الحقوق % % بعذر وإن كان عذرا مبينا % % 64(@)(@@) % يبيتون يعتلكون السيا % % ط غرثى وهم يطردون السنينا % % 65(@)(@@) % طوال الحمائل شم الأنوف % يهابون رؤيا ويستحسنونا % % 66(@)(@@) % إذا ركبوا مسحوا بالسحاب % % وإن نزلوا خلتهم راكبينا % % 67(@)(@@) % تفرع من شرفي عيصهم % % مصابيح مجد تضئ الدجونا % % 68(@)(@@) % وكل غلام له حكمه % % على الناس راضين أو كارهينا % % 69(@)(@@) % إذا سكت انتظروا ما يقول % وإن قال دان له الناطقونا % % 70(@)(@@) % تألق ينعت حسنا أباه % % وميض السيوف يصفن القيونا % % PageV01P1707 71(@)(@@) % عميم الحياكعميد الكفاة % ولا يسم الأرض إلا هتونا % % 72 
ms549	(@)(@@) % لك الله مبتدئا سؤددا % تراجع عن شأوه المنتهونا % % 73(@)(@@) % ومقتبل السن فاق الكهول % فجاءوا على عقبه يحتذونا % % 74(@)(@@) % فدى لك كل قصير الفخا % % ر يهرب من ألسن الناسبينا % % 75(@)(@@) % له حسب في العلا أكمة % أضلت محجته المهتدينا % % 76(@)(@@) % إذا أيتم البخل سؤاله % % فيكفيك فينا أبو السائلينا % % 77(@)(@@) % وكل ابن نقص تمنى أبو % % ه أن البنات له بالبنينا % % 78(@)(@@) % إذا ما رأى منك ملء العيون % % رأى منه ملء منى الشامتينا % % 79(@)(@@) % لئن دب دهر إلى مجدكم % % بنقص يخاف على الفاضلينا % % 80(@)(@@) % ومد إليكم غداة الصفاح % % شمالا وكان يمد اليمينا % % PageV01P1708 81(@)(@@) % ونازعكم عن مقر العلا % % ء غصبا وأنتم له مالكونا % % 82(@)(@@) % فقدما رآكم لأخلاقه % % بحسن خلائقكم فاضحينا % % 83(@)(@@) % يصيب فتجبر أيمانكم % % مصاب إساءته محسنينا % % 84(@)(@@) % ويأخذ منا وتعطوننا % % ويجلب فينا فتستنجدونا % % 85(@)(@@) % ولا بد للمجد من عوذة % إذا تم تطرف عنه العيونا % % 86(@)(@@) % وقد يغمد السيف حتى يشام % % ويستتر البدر حتى يبينا % % 87(@)(@@) % يظن العدا أنكم تخشعون % % وقد كذب الله فيك الظنونا % % 88(@)(@@) % ولا أبعد الله غير التلاد % % إذا العرض أضحى منيعا مصونا % % 89(@)(@@) % لئن سر حاسدكم أن يرى % % وفودكم مرة مخفقينا % % 90(@)(@@) % فكم ليلة دونكم أنقبت % % خوافي المناسم حتى دمينا % % PageV01P1709 91(@)(@@) % ويوم سموم يرد القطا % % على الماء كدرا وقد كن جونا % % 92(@)(@@) % حملنا إليكم على الكره فيه % % جوادا أقب وعنسا أمونا % % 93(@)(@@) % فرد نوالكم اليعملا % % ت تعيى كراكرهن المتونا % % 94(@)(@@) % مواقر من جودكم لا تكاد % % تقل قلائدها والعهونا % % 95(@)(@@) % كأنا إذا أشرعت للورود % % نحط إلى الماء منها سفينا % % 96(@)(@@) % فتلت من الناس حبلي بكم % % وقلت لنفسي هم العالمونا % % 97(@)(@@) % وبعتكم مهجتي طائعا % % فو المجد ما كان بيعا غبينا % % 98(@)(@@) % ولم أك حاشاي في الغادرين % % بكمإن نبا الدهر والمارقينا % % 99(@)(@@) % لساني لكم ذاك والنفس تلك % % مضيقين في المال أو موسعينا % % 100(@)(@@) % وأعلم أنى لكم سالم % وأعلم أنكم تعلمونا % % PageV01P1710 101(@)(@@) % وكم لي من مثل سائر % تظل العداة له آذنينا % % 102(@)(@@) % لكم منه داعية في البلاد % ويعطيكم إمرة المؤمنينا % % 103(@)(@@) % أقوم لكم بقوانينه % % وأنطق 
ms550	 ما دمتم تسمعونا % % 104(@)(@@) % فلا عدم الوفد ناديكم % ولا استوحشت سبل الرائدينا % % 105(@)(@@) % وكان لكم من عثار الزمان % لعا يوم يعثر بالغافلينا % % 106(@)(@@) % ولا راعنا قدر فيكم % فإن بكم نعمة الله فينا % % PageV01P1711 البحر : - 1(@)(@@) % إن كان فوق الشمس للساعي قدم % يسمو لها محلق من الهمم % 2(@)(@@) % فابغ وراء ما بلغت غاية % واطلب مزيدا في الذي نلت ورم % 3(@)(@@) % لم يدع الكمال فيك خلة % يقال فيها ليت ذا النقصان تم % 4(@)(@@) % إلا الخلود فتمل خالدا % % كما تشاء وبرغم من رغم % 5(@)(@@) % على الزمان طيه ونشرهتميس من ملكك في مفاضة ترد فضل ذيلها على القدم % وأنت غض محدث على القدمسقط بيت ص % % 6(@)(@@) % حصينة لم يختلل سردها % % نافذة بهم أو صدع ثلم % 7(@)(@@) % كم تطلب الأعداء فيك مغمزا % % تفنى الضروس والحصى لم ينعجم % 8(@)(@@) % ويحسبون عثرة ومتعب % ناظر عثرات النجوم في الظلم % 9(@)(@@) % أضغاث ليل ضاحكت بروقها % % حقيقة الصبح ومن نام حلم % 10(@)(@@) % قد علم الله صلاح خلقه % % على يديك فقضى بما علم % PageV01P1712 11(@)(@@) % والملك مذ ضممته يعرف من % % يفتح باعيه عليه ويضم % 12(@)(@@) % وكيف رضت طفله على الصبا % % وكيف رشت شيخه على الهرم % 13(@)(@@) % يوما أخ مساهم بنفسه % % في جلما ناب ويوما أنت عم % 14(@)(@@) % وطائر من شعب الرأى مضى % % بدائدا طردك بالذئب الغنم % 15(@)(@@) % أرسلت تدبيرك في أطرافه % % يجمع من أقطاره حتى انتظم % 16(@)(@@) % وحدك لم تقدحه عن مشارك % زيد ولو شورك بدر ما استتم % 17(@)(@@) % وقاطع حبل الحفاظ خالع % شاور نجما مشرقيا قد نجم % 18(@)(@@) % لانت لكفيه العصا فشقها % % وما درى بأي كف تلتئم % 19(@)(@@) % ثار وعز الدين من أنصاره % كواسر الجو وآساد الأجم % 20(@)(@@) % يزعم لا يرجع دون غاية % لولاك كان صادقا فيما زعم % PageV01P1713 21(@)(@@) % قمت إليه بحشى ساكنة % كأنما لقيته ولم تقم % 22(@)(@@) % تقود شهباء جميلا وجهها % % ما أبصرت قبيحة ما تقتحم % 23(@)(@@) % تمثل الأشخاص فيما صقلت % من سابغ واف وصمصام خذم % 24(@)(@@) % يقطر ماء بيضها وسمرها % % علامة أن غدا تقطر دم % 25(@)(@@) % ومستقيمات أبوها أعوج % تقوم 
ms551	 من طرق الوغى على لقم % 26(@)(@@) % عودتها الحرب فما تفرق ما % % أوعية العليق من فوس اللجم % 27(@)(@@) % وغيره فالت أشراك الوغى % % قبضته مكرا بأشراك الكلم % 28(@)(@@) % جردت من فيك له قاطعة % يوم الحجاج تقتل القرن الخصم % 29(@)(@@) % قال بنو الحرب وقد كتبتها % % مال على السيف وفاء للقلم % 30(@)(@@) % إن حباء آنفا حبيته % % عن المنى كان كثيرا وعظم % PageV01P1714 31(@)(@@) % لا عنق جيداء طالت طمعا % % في مثله قط ولا أنف أشم % 32(@)(@@) % أخلعة عليك أم هدية % % إلى الرياض أهديت من الديم % 33(@)(@@) % أم من نداك طبعت ورصعت % بجوهر الأخلاق منك والشيم % 34(@)(@@) % قد كان يرضى الوزراء قبلها % % ما أعطي الأتباع منك والخدم % 35(@)(@@) % ويشكرون ما كسا إذا ضفا % % عليهم وما امتطى إذا كرم % 36(@)(@@) % ما أهلوا لما ابتنى موسدا % % جلستهم وما سقى وما ختم % 37(@)(@@) % لا الدر لاثوا عمة قط به % % ولا النضار سحبوا ذيلا وكم % 38(@)(@@) % ولا مشت جيادهم وخرز الت % % يجان في الأكفال منها واللجم % % 39(@)(@@) % قيدت لهم مركوبة مجنوبة % محزمات وسوى ذات الحزم % 40(@)(@@) % قد كان يجنى منبت التبر لها % % فخلتها الآن جنى البحر الخضم % PageV01P1715 41(@)(@@) % نعمى أحلت بك في محلها % % ومعشر تغلط فيهم النعم % 42(@)(@@) % أعلقك المجد بلا مساجل % % عرض جميع وثراء مقتسم % 43(@)(@@) % وشيم لم تغتصبها طيبها % % أبهة الملك وتعظيم الأمم % 44(@)(@@) % يا ناشر الأموات في إحسانه % % ما بال حظي وحده تحت الرجم % 45(@)(@@) % نبهت أرزاق الورى ورزقي الن % % ائم والتأميل فيك لم ينم % 46(@)(@@) % يقول قوم وانبسطت واصفا % % حالي لهم ويعهدوني أحتشم % 47(@)(@@) % يقدم فخر الملك ثم تنجلي % % غاشية الليل إذا الصبح قدم % 48(@)(@@) % فقلت قد أسلفته شكاية % لو قد وفى لرق منها ورحم % 49(@)(@@) % وقد رأى حالي قبل سيره % % لحما كما ترونها على وضم % 50(@)(@@) % لكنني استزدته فقال لي % % ناصحهم إن تستزد فلا جرم % PageV01P1716 51(@)(@@) % العتب ذنب قلت إني تائب % شريطة التوبة ترك وندم % PageV01P1717 البحر : - 1(@)(@@) % ألا صاحب كالسيف حلو شمائله % رداء الهوى مثلي على الشيب شامله % 2(@)(@@) % أخو عزمة أو صبوة عربية % أحامسه شكوى 
ms552	 الجوى وأغازله % 3(@)(@@) % معي أين مالت بي من الأرض حاجة % أعطفه حتى كأني مفاصله % 4(@)(@@) % أضن به ما ضن جفني بمقلتي % % فلا أنا مهديه ولا أنا باذله % 5(@)(@@) % خليلي هل من نظرة ترجعانها % % إلى روح نجد هل تخضر ذابله % 6(@)(@@) % وهل رشأ بالبانتين عهدته % % على ما افترقنا ليته وأياطله % % 7(@)(@@) % رمى يوم سلع والقلوب حوائد % فما رام حتى أثبت السهم نابله % 8(@)(@@) % هربت بلبي أتقي سحر لفظه % ولم أدر أن السحر عيناه بابله % 9(@)(@@) % رأى مهجتي مرعى وعيني مشربا % فلم يغنه ماء النخيل وباقله % 10(@)(@@) % أساهر ليلا بالغضا كلما انقضت % % أواخره كرت علي أوائله % PageV01P1718 11(@)(@@) % كأن الدجى برد تعاقد هدبه % % برضوى يمادي عمره ويطاوله % 12(@)(@@) % رفعت لحاظي والظلام يصدها % % لحي بسلمى أين زالت زوائله % 13(@)(@@) % كأن خلاط البين بين حمولهم % % لواعج قلبي بعدهم وبلابله % 14(@)(@@) % وخلف سجوف الرقم بيض أكنة % تكنفه من جنب سلمى طلائله % 15(@)(@@) % حمته الرماح والحصانة أن ترى % % مصاونه أو أن ترام مباذله % 16(@)(@@) % وأغيد أعياه سوار يغصه % % بخضب يديه أو حقاب يجاوله % 17(@)(@@) % حفظت الذي استودعت من سرحبه % % وهاجرته بغيا وقلبي مواصله % 18(@)(@@) % فما زال طرفي في الهوى وسفاهه % % بحلم فمي حتى علا الحق باطله % 19(@)(@@) % عذيري من دنياي فيما ترومه % % على عفتي من بذلتي وتحاوله % 20(@)(@@) % تكلفني أطماعها ترك شيمتي % % لشيمتها والطبع يتعب ناقله % PageV01P1719 21(@)(@@) % كفى شربتي يومى رواح حلوبة % علي وشاء الحي دثر وجامله % 22(@)(@@) % أرى المرء لا يضويه ما رد وجهه % مصونا ولا يعييه ما هو باذله % 23(@)(@@) % وما الحرص إلا فضلة لو نبذتها % % لما فاتك الزاد الذي أنت آكله % 24(@)(@@) % ومن غالب الأيام كان صريعة % لجانب قرن لا يضعضع كاهله % 25(@)(@@) % يصيب الفتى بالرأى ما شاء حظه % % وما جرت الأقدار وهي تنازله % 26(@)(@@) % يداوى بصيرا كل داء يصيبه % % ويعمى عن الداء الذي هو قاتله % 27(@)(@@) % فما لي وفي الأحرار بعد بقية % تصافح كفي كف من لا أشاكله % 28(@)(@@) % إذا ما ابن عبد الله صح وفاؤه % % كفاني الطلاب وده لي ونائله % 29(@)(@@) % فما 
ms553	 غام خطب وجه أحمد شمسه % ولا جف عام كف أحمد وابله % 30(@)(@@) % كريم جرى والبحر شوطا إلى الندى % % فعاد بفضل السبق والبحر ساحله % PageV01P1720 31(@)(@@) % يصدق ما قال الرواة فأسرفوا % % عن الكرماء بعض ما هو فاعله % 32(@)(@@) % لعاذله حق على من يزوره % % لكثرة ما يغريه بالجود عاذله % 33(@)(@@) % كأن الندى دين له كلما انقضت % % فرائضه عنه تلتها نوافله % 34(@)(@@) % يلوم على إنفاقه كثر ماله % % فمن لك أن تبقى عليه قلائله % 35(@)(@@) % ترى مجده الشفاف من تحت بشره % % إذا الخير دلتنا عليه دلائله % 36(@)(@@) % كأن قناع الشمس فوق جبينه % % ومنكب رضوى ما تضم سرابله % 37(@)(@@) % مديد نجاد السيف إن هو لم يطل % إذا قام قيد الرمح وهو يعادله % 38(@)(@@) % قليل رقاد العين إلا تعلة % لماما كأن الليل بالنوم كاحله % 39(@)(@@) % إذا عج ظهر مثقل فهو عامد % لأثقل ما حملته فهو حامله % 40(@)(@@) % فإن نزل الخطب الغريب تطلعت % له من خصاصات الذكاء شواكله % PageV01P1721 41(@)(@@) % حمى الملك والذؤبان وفوضى تنوشه % % تخاتله عن سرجه وتعاسله % 42(@)(@@) % ولبى وقد ناداه يا ناصر العلا % % على فترة فيها أخو المرء خاذله % 43(@)(@@) % رمى خلل الآفاق منه بسدة % إذا وزنت بالدهر شالت مثاقله % 44(@)(@@) % فيوماه عنه يوم قرن يحاوله % فيرديه أو خصم ألد يجادله % 45(@)(@@) % إذا الدولة استذرت بأيام عزها % % فما هي إلا رايه ومناصله % 46(@)(@@) % ولم يك كالمدلي بحرمة غيره % ولا من أنالته العلاء وسائله % 47(@)(@@) % غريبا على النعماء والخفض وجهه % وناطقة بالعجز عنه مخايله % 48(@)(@@) % ولكنه البدر الذي ما خبت له ال % % كواكب حتى بيض الأفق كامله % 49(@)(@@) % هو الراكب الدهماء تمشي بظهرها % % على جدد لا يحسد الركب راجله % 50(@)(@@) % عريض النياط لا يثور ترابه % % بخف ولا تحفي المطايا جنادله % PageV01P1722 51(@)(@@) % أمين الظما لا تعرف العيس خمسه % ببل إذا ثارت عليه قساطله % 52(@)(@@) % لزاجر أعجاز السوابق فوقه % % سياط من النسل الذي هو ناسله % 53(@)(@@) % تراه بحضنيه يحارك ظله % % يقاومه طورا وطورا يمايله % 54(@)(@@) % وتحسبه يهوي ليفضي بسره % % إلى جالس ما إن يزال يزامله % 55(@)(@@) % أمين بسري أو 
ms554	 مؤد تحيتي % % ومن يحمل السر الذي أنا حامله % 56(@)(@@) % لعل الذي حملت من شوق أحمد % يخف بأن تشكى إليه دواخله % 57(@)(@@) % عهدت فؤادي أصمعا لا يخونني % % وصدري متينا لا ترث حبائله % 58(@)(@@) % فما بال قلبي يستكين لهذه % % وجأشي قد جالت علي جوائله % 59(@)(@@) % وأولى الهوى إن يستخفك ثقله % هوى لم يجرب قبله ما يماثله % 60(@)(@@) % وقبلكم ما خفت أن تسترقني % % مياه عن الماء الذي أنا ناهله % PageV01P1723 61(@)(@@) % ولا أن ربعا بالصليق تشوقني % % على بغضها أو طانه ومنازله % 62(@)(@@) % ولكن أبى الفضل المفرع منكم % على الناس إلا ان يخيل خائله % 63(@)(@@) % جزى الله يوما ضم شملي إليكم % صلاحا وأعطاه الذي هو سائله % 64(@)(@@) % فما كنتم إلا سحابا رجوته % % لبل فمى فعممتني هواطله % 65(@)(@@) % ويا طيب ما استعجلت كتب ودادكم % % لو أني ببعد لم يرعني آجله % 66(@)(@@) % بلغت بكم غيظ الزمان وفيكم % % وأكثر مما نلت ما أنا آمله % 67(@)(@@) % فهل أنت يابن الخير راع على النوى % % أخا لك لم تشغله عنك شواغله % 68(@)(@@) % نعم عهدك العقد الذي لا تحله % % يد الغدر والحبل الذي لا تساحله % 69(@)(@@) % وأنك قد أحرزت منى مهندا % % يروق وإن رثت عليه حمائله % 70(@)(@@) % وعذراء من سر الفصاحة بيتها % % طويل العماد متعب من يطاوله % PageV01P1724 71(@)(@@) % لها نسب في الشعر كالفجر في الدجى % % متى تظلم الأنساب ترفع مشاعله % 72(@)(@@) % أبوها شريف الفكر والفخر كله % % إصابتها صهرا كأنت تباعله % 73(@)(@@) % أتاك بها النيروز منى هدية % فلله ماأرسلت أو من أراسله % 74(@)(@@) % إذا برزت في زي فارس قومها % % فحليتها تيجانه وأكالله % 75(@)(@@) % فعش يعجز الأقوام ما أنت فاعل % كما يعجز الأقوال ما أنا قائله % 76(@)(@@) % وأفضل ما ملكته صفو خاطري % % وها أنا مهديه فهل أنت قابله % PageV01P1725 البحر : - 1(@)(@@) % لله قلبا قرينى صبوة قطعا % % ليل الرضا سهرا أحلى من الوسن % 2(@)(@@) % ناما مع الحب يقتادان طاعته % منزهين له عن سيئ الظنن % 3(@)(@@) % جسمان صارا هوى مزجا فقل حسنا % ماشئت في قمر يحنو على غصن % 4(@)(@@) % يا ليلة لا جحدت الدهر منته % فيها ولو 
ms555	 أنه ما عشت أسخطني % % PageV01P1726 البحر : - 1(@)(@@) % يا صاحبي شكواي هل ناصر % يملك رفدى منكم أو معين % 2(@)(@@) % مرا على خنساء فاستطردا % % ذكري بأطراف الحديث الشجون % 3(@)(@@) % فإن أصاخت لي فقولا لها % % عني عسى صعبتها أن تلين % 4(@)(@@) % قد عاد للقلب جنون الصبا % % وهب هذاك الغرام الدفين % 5(@)(@@) % فهل لكم في الحي عرافة % تحسم بعد الشيب هذا الجنون % 6(@)(@@) % فحدثا خنساء قالتنعم % % هام كمن هام فماذا يكون % 7(@)(@@) % أوصيه بالدمع دواء فإن % % ضن عليه جفنه فالأنين % 8(@)(@@) % يا قلب ما أنصفتني طالعا % % على الهوى من شرف الأربعين % PageV01P1727 البحر : - 1(@)(@@) % أدرك ماشاء غلام فطنا % % إذا نبت به بلاد ظعنا % % 2(@)(@@) % لا يستريح جسمه وعرضه % % مكلف وقلبه أخو العنا % % 3(@)(@@) % يضمن البيداء من حاجاته % % والحرة الوجناء ما تضمنا % % 4(@)(@@) % إن وجد العز وراء جانب % مشى ولو على عوامل القنا % % 5(@)(@@) % دع للهوينا الغمر من أبنائها % % وللمنى فما المنى إلا ضنا % % 6(@)(@@) % لا حملتنى تربة طيبة % % تخبث أن تضمنى وسكنا % % 7(@)(@@) % ولا زمان أنا فيه خامل ال % % ذكر ومن أفضل من فيه أنا % % 8(@)(@@) % كم الرضا بوشل مصرد % لا ناقع ولا يميط الدرنا % % 9(@)(@@) % وفضل عيش جائر مذبذب % لا عفة فيه ولا زهد الغنى % % 10(@)(@@) % قد قنطت نفسى أن تعثر بي % % مسرة مما ألفت الحزنا % % PageV01P1728 11(@)(@@) % أرى عيون الشامتين شارة % مصبوغة تشعر صبرا حسنا % % 12(@)(@@) % يظهر في وجهي لهم ماء الرضا % % والنار ما أجنه مستبطنا % % 13(@)(@@) % وكلما أنحى علي زمني % % موهت حالي وشكرت الزمنا % % 14(@)(@@) % حتى لقد مات فؤادي فغدا % % صدري له لحدا وجسمي كفنا % % 15(@)(@@) % من لي بأن تنشطني الأقدار أو % % يحل عنى الدهر هذا القرنا % % 16(@)(@@) % فأملك الحلبة لا أثنى بأن % % أشكم دون غايتي أو أرسنا % % 17(@)(@@) % قد أغلق الحظ البهيم سبلي % % حجازها وشامهاو اليمنا % % 18(@)(@@) % فما أريد نهضة تنتاشني % % إلا لوى عزمي عنها وثنى % % 19(@)(@@) % تفانت الأيام مالي ولها % % إما بقاء نافع أو الفنا % % 20(@)(@@) % قد نبذتني منبذ المجلوب لا % % يسرح في الإبل ولا يسقى الهنا % % PageV01P1729 21(@)(@@) % دريئة للهم كيف وقعت 
ms556	 % % سهامه كنت الجريح المثخنا % % 22(@)(@@) % لا وطرا من لذة أقضى ولا % % عندي في طارقة الجلى غنى % % 23(@)(@@) % كأنها ما جربت حلمي ولا % % تعاورت منى جنبا خشنا % % 24(@)(@@) % ولا درت أي رجال عصمة % جعلتهم منها لظهري جننا % % 25(@)(@@) % الأشرفين همما والأكرمي % % ن أيديا والأكثرينا مننا % % 26(@)(@@) % والرافعين بعلا أنفسهم % % ما شيد المجد القديم وبنى % % 27(@)(@@) % قوم إذا العام اقشعرت شمسه % % وكب أرباب المقاري الجفنا % % 28(@)(@@) % وخاف كلب الحي من جازره % ما أكل الشاء وأفنى البدنا % % 29(@)(@@) % تساهموه يطردون جدبه % حتى يعود متمرا وملبنا % % 30(@)(@@) % وأقبلواه أوجها ميامنا % تضحك فيه وأكفا يمنا % % PageV01P1730 31(@)(@@) % وزاده عدل الملوك في الندى % % تمردا وبالجدا تمرنا % % 32(@)(@@) % وملكتعجل على الناس به % % رأس الفخار وعرانين السنا % % 33(@)(@@) % سن لهم فاتبعواوزيدوا % % وألحقوا بالفرض تلك السننا % % 34(@)(@@) % علقت منهم بأغر ماجد % كان الأشد في يدي الأمتنا % % 35(@)(@@) % رعيته أخا الربيع وهمت % راحته لي فذممت المزنا % % 36(@)(@@) % وقال لي المجد وقد أحمدته % % تلك الغصون أثمرت هذا الجنا % % 37(@)(@@) % أوفى على مرقبة الملك فتى % يرى خفي المشكلات بينا % % 38(@)(@@) % موفق النظرة لا تحوجه % أوائل اللحظ إلى كر الثنى % % 39(@)(@@) % لكفه من القنيص كل ما % % نص إليه منسرا وبرثنا % % 40(@)(@@) % كفى العظيم ورمى برأيه % % حيث هفا رأى المصيب وونى % % PageV01P1731 41(@)(@@) % وقام بالدولة مد ظهره % والدهر قد طأطأ منها وانحنى % % 42(@)(@@) % لما أبت صماؤها فلم تطع % من أمر حاويها الرقى والدخنا % % 43(@)(@@) % وأعضل الخطب اشتفوا بطبه % % فأفرقت والداء قد تمكنا % % 44(@)(@@) % قالوا الرئيس فاطمأن وحشها % % بعد النفار باسمه وأذعنا % % 45(@)(@@) % وعاد محزوم المطا ريضها % % من بعد ما كان زبونا أرنا % % 46(@)(@@) % ماضي اليدين منصلا وقلما % % صعب المراس جلدا ولسنا % % 47(@)(@@) % إذا فلى برمحه كتيبة % حسبته يكتب فيها بالقنا % % 48(@)(@@) % فإن أفاض كاتبا ظننته % % بالقلم الجاري الضلوع طعنا % % 49(@)(@@) % رأى الندى أجلب شئ للعلا % % فجعل المال العزيز هنيا % % 50(@)(@@) % وجاد حتى قال من جاد له % % أودع عندي ماله أو خزنا % % PageV01P1732 51(@)(@@) % يستوحش الدينار من بنانه % فقلما جاورها مستوطنا % % 52(@)(@@) % قل لأبي القاسم قسام اللهى % % وفي 
ms557	 المعالي ما يفاد بالكنى % % 53(@)(@@) % أشكو إليك كلما جن الدجى % % هزة شوق تستطير الوسنا % % 54(@)(@@) % ومقلة إذا التفت نحوكم % % بل الرداء شأنها والردنا % % 55(@)(@@) % ما انفتحت من بعدكم فأبصرت % % على اختلاف الناس شيئا حسنا % % 56(@)(@@) % قد كنت منيت بأن تراكم % لحاجها لو كان أغناها المنى % % 57(@)(@@) % ورضت نفسي للنوى فأسمحت % أن تهجر الأهل لكم والوطنا % % 58(@)(@@) % واستأذنت على الحيا مجدبة % أرضي ولكن الحيا ما أذنا % % 59(@)(@@) % وقلت صدع ربما لم وعج % % فاء عست بجودكم أن تسمنا % % 60(@)(@@) % وزمن قاس سيعطفونه % % نحوي بما هم يملكون الأزمنا % % PageV01P1733 61(@)(@@) % لكن أبيت شفقا وصنتني % % يا لمسيئ ويظن محسنا % % 62(@)(@@) % ولو شريت ساعة منك بما % % بين ضلوعي ما شكوت الغبنا % % 63(@)(@@) % فلا تؤاخذ بفتى صددته % % عن نسكه عقوبة وما جنى % % 64(@)(@@) % شجعه الشوق على مشقة % كم سيم يوما مثلها فجبنا % % 65(@)(@@) % لعل من أشخصه يرده % % أغلى لديكم قيمة وأوزنا % % 66(@)(@@) % فربما عاد صليبا شرسا % % ما كان تحت العجم سهلا لينا % % 67(@)(@@) % لئن عداني قدر مماكس % عنكم وحظ ما يزال أرعنا % % 68(@)(@@) % وفترة من رأيكم تشهد أن % ما عندكم من الجوى ما عندنا % % 69(@)(@@) % فغاديات رائحات نحوكم % % صرائح إذا الكلام هجنا % % 70(@)(@@) % من اللواتي ما انبرى مسترعيا % % بمثلها قط لسان أذنا % % PageV01P1734 71(@)(@@) % لو مسح الجو ببطن كفه % قائلها كنت بذاك قمنا % % 72(@)(@@) % تسلفت ود الملوك قبلكم % % وعقدت لي في الرقاب المننا % % 73(@)(@@) % فاسمع لهن سابقا ولاحقا % % سوائرا فيك يطبقن الدنا % % 74(@)(@@) % وجل يوم المهرجان هذه % % قلادة تنظم درا مثمنا % % 75(@)(@@) % لم ير مذ فارق كسرى مثلها % % أجمل فوق جيده وأزينا % % 76(@)(@@) % واستوف أقصى غاية من سعده % % وابق له وللمعالي ولنا % % 77(@)(@@) % وكن بذاك من ضمان الله لي % % في أن تعيش وضماني موقنا % % 78(@)(@@) % واندب لها بين يديك ناهضا % % يخلفني في ذا الدعاء والهنا % % PageV01P1735 البحر : - 1(@)(@@) % عثرت يوم العذيب فاستقل % ما كل ساع يحس بالزلل % 2(@)(@@) % ما سلمت قبلك القلوب على ال % % حسن ولا الراجمون بالمقل % 3(@)(@@) % راحوا بقلبي وغادروا جسدا % % أعدى بلاه ربع الهوى فبلي % % 4 
ms558	(@)(@@) % وقفت فيه ولا ترى عجبا % % كطلل واقف على طلل % 5(@)(@@) % سل إخوتي في قصور فارس عن أخ % % عزيز يضام في الحلل % 6(@)(@@) % يا قوم إن العذيب بعدكم % يأخذني بالطوائل الأول % 7(@)(@@) % لا تطلبوا في طلى الرجال دمى % % إن دمي في غوارب الإبل % 8(@)(@@) % كأنها بالحمول واطئة % صفحة خدي تمشي إلى أجلي % % 9(@)(@@) % يا عجبا صادني عنادا على % % وجرة ظبي يصاد بالحيل % 10(@)(@@) % مد حبالا من الذوائب واس % % ترهف يرمي نصلا من الكحل % PageV01P1736 11(@)(@@) % ما اختص منى السقام جارحة % على جهاتي أغراض منتبلي % % 12(@)(@@) % إذا لحاظي لجسمي امتعضت % من الضنا قال قلبي احتمل % 13(@)(@@) % كل عذاب الهوى بليت به % % ولو كفيت الملام لم أبل % 14(@)(@@) % قد اشتفى الدهر من قساوته % % وما اشتفى العاذلات من عذلي % % 15(@)(@@) % يا قصر الليل دم لنائمه % % فالليل لولا السهاد لم يطل % 16(@)(@@) % أحال دمعي لون السواد من ال % % عين ولون الظلام لم يحل % 17(@)(@@) % وأنكرت عيني النهار من اع % % تياد ليلات همي الطول % 18(@)(@@) % ظاهر ثوبا من السلامة لي % % فوق أديم محلم نغل % 19(@)(@@) % يسقيني الصاب إن وصفت له % % ظماءة من إدواة العسل % 20(@)(@@) % مبتسم لي من غير ما مقة % ما كل لحظ بالماق عن قبل % PageV01P1737 21(@)(@@) % إذا استجدت له ثياب غنى % رحت بثوب من غدره سمل % 22(@)(@@) % يرى بعينيه كل منصدع % % يرأب إلا ما سد من خللي % % 23(@)(@@) % يرى ذهاب السادات سوده % % إن التفاني وسم على الغفل % 24(@)(@@) % قل للئيم يضم راحته % % خوف سؤالي أعفيت فاعتزل % 25(@)(@@) % كففتها ترهب العطاء فما % % أحسنها لو تكف من شلل % 26(@)(@@) % عهدي بمال الجواد يأمنني % % فكيف قد خفتني مع البخل % 27(@)(@@) % ما لك ترتاع للسماع إذا % % سيل أناس وأنت لم تسل % 28(@)(@@) % غضبان تبغى شرى بلا ترة % ولا يد أنت ربها قبلي % % 29(@)(@@) % يذم مسترجع النوال فهل % % تكون مسترجعا ولم تنل % 30(@)(@@) % يا عاقدا صبوة الحسان إلى ال % % حاجات حرصا بغارب الجمل % PageV01P1738 31(@)(@@) % يطلب ما أمهل القضاء به % % من الغنى في سفارة العجل % 32(@)(@@) % حيران يضحي على أمان من 
ms559	 ال % % أرض ويمسي منها على وجل % 33(@)(@@) % حط وقد أعتمت مذاهبه % % ينظر رشدا أقمرت فارتحل % 34(@)(@@) % هدا عميد الكفاة نار قرى ال % % ليل وكشاف أوجه السبل % 35(@)(@@) % دل على جوده تبسمه % والشرق يشرى بالعارض الهطل % 36(@)(@@) % أبلج واف سربال سودده % على سرابيل قومه الفضل % 37(@)(@@) % فات به أن تداس حلبته % % سن فتى ورأى مكتهل % 38(@)(@@) % قر وما ألقيت تميمته % % وساد في عشر عمره الأول % 39(@)(@@) % مستيقظ الظن ألمعي إذا % % أخلف ليل النوامة الوكل % 40(@)(@@) % يكاد من طاعة الوفاق له % % يصلح بين الجنوب والشمل % PageV01P1739 41(@)(@@) % صحت له في الندى بصيرته % فما يرد السؤال بالعلل % 42(@)(@@) % وعاقد الغيث أن يساهمه ال % % جود بكف محلولة العقل % 43(@)(@@) % من معشر شاب مجدهم في صبى ال % % دهر وداسوا أوائل الدول % 44(@)(@@) % إذا هوى الناسبون في صبب % تطلعوا من ذوائب القلل % 45(@)(@@) % خلوا عن المال أيديا وهبوا % % منها مكان الأموال والقبل % 46(@)(@@) % يصبح رزق الأنام تحت يد % منهم وثقل الدنيا على رجل % 47(@)(@@) % كل غلام ضرب يخف إلى ال % % ضرب خفوف الصناع للعمل % 48(@)(@@) % لو شاء مما طالت حمائله % % مس قياما ثعالب الأسل % 49(@)(@@) % شابه طيب الولاد بينهم % وفق الأنابيب في القنا الذبل % 50(@)(@@) % محمد كالحسين سبقا إلى % % غايته والحسين مثل علي % % PageV01P1740 51(@)(@@) % يبغى مساعيك متعب يده % تفتل حبلا لشارد الإبل % 52(@)(@@) % وما جنت خيبة كرجل فتى % يمشي على النار غير مشتعل % 53(@)(@@) % أنعمتم لي خوض الرجاء وقد % % كنت أحلا منه عن البلل % 54(@)(@@) % وزاد شعري فيكم على فكري % % مزيد إحسانكم على أملي % % 55(@)(@@) % لكنه يقتضي مكارمكم % % تعجيلها ما يفوت بالمهل % 56(@)(@@) % وأن أكون الشريك في جمة ال % % ماء كما قد شركت في الوشل % 57(@)(@@) % كل يد في مديحكم غمست % غير يدي فهي كف منتحل % 58(@)(@@) % وكل قلب بعدي أحبكم % قلب دخيل الوداد منتقل % 59(@)(@@) % كم جلوة حلوة زففت لكم % % فيها هديا من خاطر غزل % 60(@)(@@) % كالشمس يأتيكم الصباح بها % % عذراء حتى تجلى مع الطفل % PageV01P1741 61(@)(@@) % طيبة الردن بالذي ضمنت % % من سيرة فيكم ومن مثل % 62 
ms560	(@)(@@) % تكثر مع حسنها الوصال فما % % أخشى عليها إلا من الملل % 63(@)(@@) % أثقلتم حمل جيدها فإن از % % دادت فللفخر ليس للعطل % 64(@)(@@) % كم حاسد قد مشى الضراء لها % % لما استقامت برأيه الخطل % 65(@)(@@) % رجا بما قال عندكم وزرا % % ينجيه من غيظه فلم ينل % 66(@)(@@) % لو لم توسع له مسامعكم % % ما طمع الصل في فم الوعل % 67(@)(@@) % يقص إثر الشذوذ يلتمس ال % % عيب وينسى الإحسان في الجمل % 68(@)(@@) % له إذا امتد باع همته % % ذكري بالعيب والمحاسن لي % % 69(@)(@@) % كفى احتقارا تركي إجابته % % لو كان ممن يجاب لم يقل % PageV01P1742 البحر : - 1(@)(@@) % علمتها الأيام أن تتجنى % % فأحالت أخلاقها السمح هجنا % % 2(@)(@@) % وتعدى غدر الزمان إليها % % فرأت رعيها الأمانة غبنا % % 3(@)(@@) % صبغ الدهر عندها بيض أيا % % مي سودا بلونه أو دكنا % % 4(@)(@@) % فعهود ماشئت تلغى وأيما % % ن على غير حلها تستثنى % % 5(@)(@@) % لم تزل تكذب الأماني حتى % % منعتني بالغيب أن أتمنى % % 6(@)(@@) % يا لحا الله ود مثلك ما أن % % زر رفدا عندي وأكثر منا % % 7(@)(@@) % كم خصوع وليس يخجل عينا % % وعتاب وليس يخرق أذنا % % 8(@)(@@) % أعتفي منك صخرة ليس تثنى % % وهي في العين بانة تتثنى % % 9(@)(@@) % وأرى في جبينك الشمس للعا % % لم حسنا ولي شقاء وحزنا % % 10(@)(@@) % ما خذول في رأس أرعن يمسى % % شاهقا دون نيلها معتنا % % PageV01P1743 11(@)(@@) % عبرت وحدها به ترد العذ % % ب لصابا عمقا وترعى الحزنا % % 12(@)(@@) % نجوة توجد الضحى هي والشمس % وتمسي مع الكواكب أمنا % % 13(@)(@@) % لو رماها بكل ما عنده الطر % % ف لأعيا من دونها وتعنى % % 14(@)(@@) % منك أنأى ولست منها إذا كن % % ت مكان الوشاح منى أدنى % % 15(@)(@@) % أستعيد الأحلام ذكرك إن خا % % لس طرفي لماظة النوم وهنا % % 16(@)(@@) % فكأنى أدعو الصدى وكأن ما % % سلك الطيف قط بالنوم جفنا % % 17(@)(@@) % أسأل الدهر عن خلائقه الأو % % لى وقد نقلت فحال وحلنا % % 18(@)(@@) % وأروم الوفاء من زمن الغد % % ر وهل للسحوق باليد مجنى % % 19(@)(@@) % عجبا كيف لامني في قنوطي % % من رأى البحر غاض والقطر ضنا % % 20(@)(@@) % كنت أشكو الأيام قبل وفي أخ 