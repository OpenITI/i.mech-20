ms261	(@)(@@) % كل يوم رحم منبوذة % % كرؤوم البو عضباء تئط % 42(@)(@@) % مطرح الشنة قد أيبسها % % قدم العهد بعامي الاقط % % 43(@)(@@) % يسأل البقيا ، وقد أحميته % ميسما لو مر بالطود غلط % % 44(@)(@@) % صدق الواشين ، فيما زعموا % % فنأى بالود عني وشحط % % 45(@)(@@) % لا أرى الجن وأفاكا به % في دجى الليل ، ولا الوحي هبط % 46(@)(@@) % نفثة من واغر جمجمها % % فيك ، لولا الله والحلم قنط % PageV01P922 البحر : كامل تام 1(@)(@@) % قل للهوامل في الدنا ما بالكم % % كالنائمين ، وأنتم أيقاظ % 2(@)(@@) % اين المقاول والجبابر قبلكم % % فاضوا على علل الزمان وفاظوا % % 3(@)(@@) % متنافسين على المقام ، وإنما % % خلف الركائب سائق ملظاظ % 4(@)(@@) % اللبث لمح والمناخ محفز % % والرعي خطف ، والورود لماظ % 5(@)(@@) % انظر إلى هذا الزمان بعينه % ترجع إليك بمقته الألحاظ % PageV01P923 البحر : رجز تام 1(@)(@@) % يا عمرو ! لا أعرف ثقلا بهظك % خلة حر ، فأعرها ملحظك % 2(@)(@@) % من قائم على العلا ما احفظك % % ما نام عن حاجته من أيقظك % PageV01P924 البحر : وافر تام 1(@)(@@) % أسيغ الغيظ من نوب الليالي % % وما يشعرن بالحنق المغيظ % % 2(@)(@@) % أرجي الرزق من خرت دقيق % يسد بسلك حرمان غليظ % 3(@)(@@) % وارجع ليس في كفي منه % % سوى عض اليدين على الحظوظ % PageV01P925 البحر : سريع 1(@)(@@) % ألهاك عنا ، ربة البرقع % مر الثلاثين إلى الأربع % 2(@)(@@) % انت اعنتني الشيب في مفرقي % % مع الليالي ، فصلي ، أو دعي % % 3(@)(@@) % يا حاجة القلب ألم ترحمي % % جنانة الدمع على مدمعي % % 4(@)(@@) % لولا ضلالات الهوى لم يكن % عنان قلبي لك بالاطوع % % 5(@)(@@) % كيف طوى دارك ذو صبوة % % عهدي به يطرب للمربع % % 6(@)(@@) % كان يرى ناظره سبة % ان مر بالدار ولم يدمع % % 7(@)(@@) % يا حبذا منك خيال سرى % % فدله الشوق على مضجعي % % 8(@)(@@) % اني تسرى من عقيق الحمى % % منازل الحي على لعلع % % 9(@)(@@) % بات يعاطيني جنى ظلمه % وبت ظمآن ، ولم أنقع % 10(@)(@@) % معانقا كان عناقي له % % وراء احشائي والاضلع % % PageV01P926 11(@)(@@) % عاقرني يشرب من مهجتي % % ريا ، ويسقيني من أدمعي % % 12(@)(@@) % هل تبلغني الدار من بعدهم % % على الطوى جائلة الانسع % % 13(@)(@@) % كأن مجرى النسع في ذفها % % مضطرب الايم على الاجرع % % 14(@)(@@) % تحملني 
ms262	 والشوق في كورها % % اني دعاني طرب اسمع % % 15(@)(@@) % ان بهاء الملك ان ادعه % % والخطب قد نازلني ، يمنع % 16(@)(@@) % رب زمام لي في ضمنه % لم اتقوله ولم ادع % % 17(@)(@@) % مصطنعي والسن في روقها % % اصاب مني غرض المصنع % % 18(@)(@@) % لم أرض إلاه ، ومن قبله % أقنعني الدهر ، ولم أقنع % 19(@)(@@) % أغر ، إن روع جيرانه % لم يذق الغمض ولم يهجع % % 20(@)(@@) % كأنما الضيم إليه سرى % % وهو على المطلع الامنع % % PageV01P927 21(@)(@@) % في حسب أصبح وضاحه % قد غلب الشمس على المطلع % % 22(@)(@@) % لئن نأى عنا ، فإحسانه % ادنى من الناظر والمسمع % % 23(@)(@@) % سوم الحيا اقلع عن ارضنا % % ونحن في آثاره نرتعي % % 24(@)(@@) % كم نفخة منه على فاقة % % تنبت عشب البلد البلقع % % 25(@)(@@) % ونظرة تجبر وهن الفتى % % وعظمه منصدع ما وعي % % 26(@)(@@) % إذا قضى مر على نهجه % واستوقف الحق على المقطع % 27(@)(@@) % كم طار في ملك ذو نخوة % % قالت له ريح المنايا قع % % 28(@)(@@) % أما نهى الأعداء ما جربوا % % فهو غدا يعطس عن اجدع % % 29(@)(@@) % لم يلقك المغرور الاغدا % % يقوم الجنب على المصرع % % 30(@)(@@) % ينتظر الحي بهم هتفه % % من النواعي وكأن قد نعي % % PageV01P928 31(@)(@@) % من جاهد خاب ، ومن طالب % اوفي على الفج ولم يطلع % % 32(@)(@@) % ومسرع أقلع من عثرة % روعاء والعثرة للمسرع % % 33(@)(@@) % ونادم أطرق عن حزبه % قد نادم الناجذ بالإصبع % 34(@)(@@) % % ولا ربوا والعز في موضع % % 35(@)(@@) % شابهت السوأة ما بينهم % % ما اسبه الحالق بالانزع % % 36(@)(@@) % ارتضعوا والعار من فيقة % ونزعوا واللؤم من منزع % % 37(@)(@@) % من عاقد اغدر من مومس % % وواعد اكذب من يلمع % % 38(@)(@@) % راموك بالأيدي وكان السهى % % أعلى من أن يدرك بالأذرع % 39(@)(@@) % قد علموا عند قراع الصفا % % وليمة الذؤبان والأضبع % 40(@)(@@) % قل لبهام نشرت في الربا % % هذا قوام الدين ، فاستجمعي % % PageV01P929 41(@)(@@) % قد أصحر الضيغم من غيله % اظفوره منك على مطمع % % 42(@)(@@) % غضبان قد غرك همهامه % % 43(@)(@@) % كم فيك من خرق لاظفاره % % كملغم الأشدق ، لم يرقع % 44(@)(@@) % ليس كغزو الذئب بهم الحمى % % ان مر بالسخلة لم يرجع % % 45(@)(@@) % إن لم تشاور حلمه تصبحي % % أي جنيب 
ms263	 لك لم يوضع % 46(@)(@@) % يستمع الرأي وعنه غنى % % قد يصقل السيف ولم يطيع % % 47(@)(@@) % لا بد أن ترمض روعاته % وان عفا اليوم ولم يوقع % % 48(@)(@@) % والسيف إن مر على هامة % روعها ان هو لم يقطع % % 49(@)(@@) % قل لحسود النجم في فوته % % عشت بداء الكمد الموجع % % 50(@)(@@) % لابد للبطنة من خمصة % % فجع على غيظك أو فاشبع % PageV01P930 51(@)(@@) % مواقف تفسخ فيها الظبى % % عقدة رأي البطل الأروع % 52(@)(@@) % أيامك الغر تسربلتها % % مثل متون القضب اللمع % 53(@)(@@) % افاقت البصرة من دائها % % وقد رقى الناس ولم ينجع % 54(@)(@@) % عادات اسيافك في غيرها % % والسيف مدلول على المقطع % 56(@)(@@) % فلست بالخامل من غاربي % % على سنام النقب الاظلع % % 57(@)(@@) % قد خاب من اصبح من غيركم % % علي ، والإقبال منكم معي % % 58(@)(@@) % يا أيها البحر بنا غلة % فهل لنا عندك من مكرع % % PageV01P931 البحر : كامل تام 1(@)(@@) % تمضى العلى وإلى ذراكم ترجع % % شمس تغيب لكم وأخرى تطلع % 2(@)(@@) % إن الصفا العادي يقرع بالأذى % % من غيركم ، وصفاكم لا يقرع % 3(@)(@@) % متداولين لباس اثواب العلى % % هذا يجاب له وهذا ينزع % % 4(@)(@@) % في كل يوم للنواظر منكم % أعلام علياء تحط وترفع % 5(@)(@@) % لا مثل من ملك العى مستقبل % % فينا ، ومن طوت المنون مودع % 6(@)(@@) % عينان عين للمزيد قريرة % % منا وعين للنقيصة تدمع % % 7(@)(@@) % وإذا اطمأن من العطية مضجع % يوما أقض من الرزية مضجع % 8(@)(@@) % فلئن فرحنا إن ذلك مفرح % ولئن جزعنا إن ذلك مجزع % 9(@)(@@) % للمجد من علياكم ومصابكم % % انف به شمم وآخر اجدع % % 10(@)(@@) % بؤسى ونعمى أعقبت ، فكأنما % % ردت على أعقابهن الأدمع % PageV01P932 11(@)(@@) % لولا الاعز أبو شجاع لم يكن % % وهي النوائب عن قليل يرقع % 12(@)(@@) % لولاه ما انجبر الكسير ولا سيما % % طرف الحسير ، ولا سلا المتفجع % 13(@)(@@) % ما كانت العلياء بعد مصلبها % % لولاه بالبدل المجدد تقنع % 14(@)(@@) % نثلوا كنائن مجدهم فتخيروا % % منهن اقوم نصلة لا ينزع % % 15(@)(@@) % سهما رمى غرض العلى من بعدما % % لم يبق في قوس المعالي منزع % 16(@)(@@) % لا يطمع الأعداء مطلع نجده % قد ضاق الاعنه ذاك المطلع % % 17(@)(@@) % طلبتك قد 
ms264	 قلقت اليك نصولها % % حتى استقر بها النصاب الامنع % % 18(@)(@@) % ظمأى إليك وأين عنك محيدها % % والرعي عندك والروا والمرتع % 19(@)(@@) % يوما ، وطينتها بغيرك تطبع % يوما وطينتها بغيرك تطيع % % 20(@)(@@) % سبقت ببيعتك القلوب أكفها % % ايد اطعنك والضمائر اطوع % % PageV01P933 21(@)(@@) % من مضمر يخشى الهوى لا ينثني % % أو صافق بيد الرضى لا يرجع % % 22(@)(@@) % أعطت تخايلها الصدور ، وربما % % تعطى يد ولها ضمير يمنع % % 23(@)(@@) % الله أيد ملككم وسما به % مجد القواعد والبناء الارفع % % 24(@)(@@) % بيت يسقف بالسماء رواقه % وتهاب ذرته الحمام الوقع % % 25(@)(@@) % اطناب قبته انابيب القنا % % وسجوف ظلته المواضي اللمع % % 26(@)(@@) % إن ساخت الأركان أشرف ركنه % % أو ضعضع البنيان لا يتضعضع % % 27(@)(@@) % كم مصعب منع الخطام تركته % % تحت الرحالة يستقيم ويطلع % % 28(@)(@@) % أو خالع قصرت يداه عن العلى % % بوع لكم تقص الرقاب وأذرع % 29(@)(@@) % فسبقتم وكبا به من جده % دون المنى قصف الفقار موقع % % 30(@)(@@) % تخفى مكانده ويظهر سطوكم % % الذر يقرص والاراقم تلسع % % PageV01P934 31(@)(@@) % لا ثل عرش بني بويه أنهم % غدر المكارم والجناب الامرع % % 32(@)(@@) % فعلى روائهم يحوم المعتفي % % وإلى روائهم تشير الإصبع % 33(@)(@@) % ان قاربوا فهم الشهاد المجتنى % % وإذا أبوا فهم السمام المنقع % 34(@)(@@) % ايديهم طرق الندى وجباههم % % أبهى من التيجان لا بل ألمع % 35(@)(@@) % فهم لا يام الحفائظ مفزع % % وهم لا يام المكارم مظمع % % 36(@)(@@) % هتف العلاء بهم إلى غاياته % فتضرع القوم اللئام وأسرعوا % % 37(@)(@@) % انا غرسكم والغصن لدن والصبا % % غض وللعيس القياد الأطوع % 38(@)(@@) % رشتم سهامي للعدى ، وتركتم % قدمي إلأى امد المعالي تتبع % % 39(@)(@@) % وحثثتم حظي ليلحق شاؤكم % % حتى استمر وحظ غيري يقدع % % 40(@)(@@) % وصنعتم فعرفت قدر صنيعكم % % ولربما غلط الطريق المصنع % % PageV01P935 41(@)(@@) % وحفظت ما استودعت من نعمائكم % % إن الوفاء أمانة تستودع % 42(@)(@@) % يا باني الشرف الموطد حيث لا % % تصل العيون ولا تنال الأذرع % 43(@)(@@) % وسليل محصنة العلى في حجرها % % مستودع وبدرها مسترضع % % 44(@)(@@) % تحنو الملوك من جنباته % % كالقلب حانية عليه الاضلع % % 45(@)(@@) % ارنق لها فتق النوائب بالندى % % أو بالقنا ولكل خرق مرقع % % 46(@)(@@) % واسلك سبيل أبيك ، إن سبيله % % لقم 
ms265	 يجيز إلى المناقب مهيع % 47(@)(@@) % واطلب على ايامه وجياده % % حسرى يردن على الطعان وظلع % 48(@)(@@) % تدق الغوار على الغوار كأنها % % وطفاء تحفزها بليل زعزع % 49(@)(@@) % والصبح منقد القميص كما جلا % % عن حر مفرقه البجال الانزع % % 50(@)(@@) % واستقبل الأيام غير جوامح % يثني إليك بها عنان طيع % PageV01P936 51(@)(@@) % تعنو لأخمصك الخطوب ذليلة % بعد العراك وخدهن الاضرع % % 52(@)(@@) % إن سر أمسك كان يومك فوقه % % ويقل عند غد لما يتوقع % % PageV01P937 البحر : وافر تام 1(@)(@@) % طلاب العز من شيم الشجاع % وسعي المرء تحرزه المساعي % % 2(@)(@@) % ودون المجد قلب مستطيل % وباع غير مجبوب الذراع % 3(@)(@@) % أخوف بالزماع ، ولست أدري % % بأين اجر ناصية الزماع % % 4(@)(@@) % ولست أضل في طرق المعالي % % ونار العز عالية الشعاع % % 5(@)(@@) % ويعجبني البعاد كان قلبي % % يحدث عن عدي بن الرقاع % 6(@)(@@) % لقيت من المقام على الأماني % % كما لقي الطموح من الصقاع % 7(@)(@@) % ولو اني ملكت عنان طرفي % % أخذت على الوسيقة بالكراع % 8(@)(@@) % وكنت اذا تلون لي خليل % % تلون بي له خلو النزاع % 9(@)(@@) % بخيل بالسلام اذا التقينا % % ولكني جواد بالوداع % % 10(@)(@@) % ايصرعني الزمان ولست آوي % % إلأى جنب ذليل للصراع % % PageV01P938 11(@)(@@) % وأرضع بالخداع عن المعالي % % وكان الطفل أولى بالرضاع % 12(@)(@@) % ألا لله طينتنا بأرض % مشوهة المعالم والبقاع % 13(@)(@@) % إذا مرق الدجى منا أخذنا % % عليها بالمذانب والتلاع % 14(@)(@@) % وأولى بالضيافة ، لو علمنا % % خصيب الرحل مطروق الرباع % % 15(@)(@@) % إلى امل الحسين بسطت ظني % % بزين الملة اشتفت الأماني % % 16(@)(@@) % إذا بخل الغمام على محل % تدارك غلة الإبل الزماع % 17(@)(@@) % مجيري إن تناكرت الليالي % % وعوني ان تكاثرت الدواعي % % 18(@)(@@) % وقد جعل الزمان يضئ وجهي % % ويرفع ناظري ويمد باعي % % 19(@)(@@) % رفعت اليك دعوة مستجير % % وانت مدى عقيرة كل داع % % 20(@)(@@) % ليهنك ما تجدده الليالي % % وحسبك من فراق واجتماع % PageV01P939 21(@)(@@) % فذاك الصخر خر من اليفاع % من الاملاك والمال المضاع % % 22(@)(@@) % تمارى الناس قبلك وهي غضب % % اديوان الضياع أم الضياع % % 23(@)(@@) % وعادت في يديك مروضات % % وكانت فقع قرقرة بقاع % 24(@)(@@) % ظفرت بما اشتهيت وانت وان % % ونال الغض غيرك وهو ساع % % 25 
ms266	(@)(@@) % يبشر والقلوب مفجعات % % كأن بشيره في الخلق ناع % % 26(@)(@@) % وما كل المواهب بالاماني % % ولا كل الاحاظي بالقراع % % 27(@)(@@) % لكل في بلوغ العز طيع % % تقلب بين أضلاع السباع % 28(@)(@@) % بزين الملة اشتقت الاماني % % من المطل الممانع والدفاع % % 29(@)(@@) % واصبحت الشفاه مقلقلات % % 30(@)(@@) % فاعلن بشره في كل وحه % % وبين طوله في كل باع % PageV01P940 31(@)(@@) % رآك لكل ما يأتيه أهلا % وأنت أحق ذودا بالمراع % 32(@)(@@) % صنيعا لا يجر عليك منا % وحمل المن غير المستطاع % 33(@)(@@) % أجار أبو الفوارس منك سيفا % تحامته يمين أبي شجاع % 34(@)(@@) % فدى لك من ينازعك الرزايا % % ويقرضك الأذى صاعا بصاع % 35(@)(@@) % يعض أنامل الأسد الضواري % % عليك بغيظ انياب الافاعي % % 36(@)(@@) % رعاك بلحظ طرف غير ران % وعاج عليك سمعا غير واع % % 37(@)(@@) % فكنت السيف اغمده جبان % % فسل وقد تصدى للمصاع % 38(@)(@@) % الان رد العلا بلا رقيب % % وشمر في الأمور ولا تراع % 39(@)(@@) % ولا يغررك قعقعة الاعادي % % 40(@)(@@) % رجونا منك يوما مستطيلا % على الاعداء وضاح القناع % % PageV01P941 41(@)(@@) % تغيظ الحاسدين به وترضي % % قلوبا لا تعلل بالخداع % 42(@)(@@) % اتقنع ان تضام وانت حام % % وتهملنا البقاع ، وأنت راع % 43(@)(@@) % وما في الأرض أحسن من يسارا % اذا استولى على مطاع % % 44(@)(@@) % الان تراجعت تلك الرعايا % % وجهزت الرعية للمراعي % % 45(@)(@@) % وعاد السرب امنع من قلوب % % تقلب بين اضلاع السماع % % 46(@)(@@) % وصار الدهر أمرح من طروب % تصافح سمعه نغم السماع % % 47(@)(@@) % تسمح عطفه بعد اجتناب % وتخطم انفه بعد امتناع % % 48(@)(@@) % تفاخرنا رجال ليس تدري % % بما علم الجبان من الشجاع % % 49(@)(@@) % ولو خليت عنا في رهان % تبينت البطاء من السراع % % 50(@)(@@) % ونحن أحق بالدنيا ، ولكن % تخيرت القطوف على الوساع % % PageV01P942 51(@)(@@) % اروم بحسن رأيك كل امر % % يؤلف فرقة الأمل الشعاع % 52(@)(@@) % وأطلب منك ما لا عيب فيه % واين المجد الا في اصطناعي % % PageV01P943 البحر : طويل 1(@)(@@) % لأغنتك عن وصلي الهموم القواطع % وعن مشرع الذل الرماح الشوارع % 2(@)(@@) % واي طلاب فاتني وطلائعي % % منى قبل اعناق المطي طوالع % % 3(@)(@@) % دعيني أقم أرضا ، وأطلب غيرها % % فبينهما ان واصل الهم قاطع % % 4(@)(@@) % فما كل 
ms267	 ممنوح من العز شاكر % ولا كل محظوظ من المال قانع % 5(@)(@@) % وما عاقني ربع ، فبت ولم تبت % يوقعني من غير ذاك المطامع % 6(@)(@@) % قطوع لا قران الرجال كانني % % إلى كل فج ثائر الرحل نازع % % 7(@)(@@) % أفي كل يوم الدهر جانبي % % وباع الثناء الحر بالذم بائع % 8(@)(@@) % فلم ألق إلا ماذق الود كاذبا % يسف به من طائر الغدر واقع % % 9(@)(@@) % ورايعة للبين من عامرية % تتزعزع منها بالسلام الاصابع % % 10(@)(@@) % فلو لم تزودنا السلام عشية % % لسرنا واعناق المطي خواضع % % PageV01P944 11(@)(@@) % تصد حداء حين تبعث وعدها % % كذوبا ، وإني بالرجاء لقانع % 12(@)(@@) % أفي كل يوم يعدم الدهر جانبي % % ورجع زفيري للحمائم خادع % 13(@)(@@) % حنين المطايا علم الشوق مهجتي % % فكيف تسليها الحمام السواجع % 14(@)(@@) % بذلتك قلبا كنت ادخر صوته % % اذا لاح لي برق من العزم لامع % % 15(@)(@@) % سبقت إلى يأسي رجاي ، فحزته % % ولم تنتظر رأي فها انا طامع % % 16(@)(@@) % وما عند أملاك الطوائف حاجتي % % اذا ما ابت ان تقتضيها القواطع % % 17(@)(@@) % وما لي شغل في القريض ، وإنما % % أبين فيه ما تقول المطامع % 18(@)(@@) % ولو هز أسماع الملوك نشيده % دروان كل المجد ما انا صانع % % 19(@)(@@) % تقول لي الأيام ، وهي بخيلة : % ألا أسأل ، فإما ذو عطاء ومانع % 20(@)(@@) % رأيت كريما ما خلا قط من حمى % % يزار ولو ان الديار بلاقع % % PageV01P945 21(@)(@@) % ولا مرضت نار القرى في خيامه % بليل ولو ان الرياح زعارع % % 22(@)(@@) % اذا صارعته الريح خلنا شعاعها % % يشير إلى الوراد والركب هاجع % 23(@)(@@) % فضنا ، بني فهر ، بما في أكفكم % % من المجد ، فالأيام عود وراجع % 24(@)(@@) % وردوا اكف الحرب حلما عن العدى % % إذا أمكنت حد السيوف المقاطع % 25(@)(@@) % فكم غارة تسترجف الليل أيقظت % صدور القنا والغادرون هواجع % % 26(@)(@@) % عيون العوالي والنجوم روامق % % ونقع المذاكى بينهن براقع % % 27(@)(@@) % ولا بد من شعواء تظما نفوسها % % وليس لها إلا السيوف مشارع % 28(@)(@@) % هو اليوم أخفت خيله لمع آله % فاشباحه فوق العجاج لوامع % % 29(@)(@@) % ترى النقع مسود الذيول وفوقه % % رداء الردى تحمر منه الوشائع % % 30(@)(@@) % وركب كان الترب ينهض نحوه 
ms268	 % % يعانقه في سيره ويصارع % % PageV01P946 31(@)(@@) % فلو أن ثغر الليل لاح ابتسامه % عن الصبح منه لم تسمه البلاقع % 32(@)(@@) % إذا ما سروا تحت الدجى فوجوههم % لضوء الضحى قبل الصباح طلائع % 33(@)(@@) % وان ادلجوا لم يسئل الليل عنهم % % كأنهم فيه النجوم الطوالع % 34(@)(@@) % ويبدأ فيها للسراب زخارف % تلاعب لحظ المجتلي وتخادع % % 35(@)(@@) % فلا تعجبوا من سيرهم في هجيرها % % فجر وغاهم للهجير طبائع % % 36(@)(@@) % وأرض يضل الليل بين فروجها % % ويجزعه أجزاعها والأجارع % 37(@)(@@) % تخطيتها والصبح يخرق في الدجى % % نوافد لا يلقى بها الجو راقع % 38(@)(@@) % تطاول اسر الليل فيها كأنما % % دجاه لاعناق النجوم جوامع % % 39(@)(@@) % وقد مد من باع المجرة فانثنى % % كأن الثريا فيه كف تقارع % 40(@)(@@) % وهبت لضوء الفرقدين نواظري % % إلى أن بدا فتق من الفجر ساطع % PageV01P947 41(@)(@@) % كأنهما إلفان قال كلاهما % % لشخص اخيه قل فاني سامع % % 42(@)(@@) % إذا أنا لم أقبض عن الخل هفوة % فلا بسطت كفي إليه الصنائع % 43(@)(@@) % وإن أنا لم يستنزل المجد حبوتي % % فلا اهلت مني الربى والمرابع % % 44(@)(@@) % أبا قاسم ! حلاك بالشعر ماجد % عليك له حتى الممات رصائع % % 45(@)(@@) % أخ لا يرى الأيام أهلا لمدحه % ولو ضمنت ان لا تراه الفجائع % % 46(@)(@@) % شجاع لأعناق النوائب راكب % همام لأطواد الحوادث فارع % 47(@)(@@) % ستشرع ماء الفخر في كأس مدحتي % % وما انا في ماء الندى منك شارع % % 48(@)(@@) % ليهنك مولود يولد فخره % % أب ، بشره للسائلين ذرائع % 49(@)(@@) % وليد لوان الليل ردي بوجهه % % لما جاورته بالجنوب المضاجع % 50(@)(@@) % ومبتسم ، يرتج في ماء حسنه % له من عيون الناظرين فواقع % PageV01P948 51(@)(@@) % رمى الدهر منه كل قلب من العدى % % بسهم نضا أحقادهم وهو وادع % 52(@)(@@) % يرامونه باللحظ كي يعصفوا به % % وأبصارهم صور لديه خواشع % 53(@)(@@) % % لارواحهم في مقلتيه مصارع % % 54(@)(@@) % يودون ان لو كا بين قلوبهم % % مع الحقد حتى لا تراه المجامع % % 55(@)(@@) % متى ابتسموا فاعلم ثغورهم % % دموع ، لها تلك الشفاه مدامع % PageV01P949 البحر : متقارب تام 1(@)(@@) % تخيرته اطول القوم باعا % % وارحبهم في المعالي ذراعا % % 2(@)(@@) % وأخذهم بعنان الخطوب % % يجير على الدهر أمرا مطاعا % % 3 
ms269	(@)(@@) % بعزم كبارقة المشرفي % يأبى على الهز الا قراعا % % 4(@)(@@) % يهاب ويرجى لريب الزمان % كالمنصل راق عيونا وراعا % % 5(@)(@@) % وصدر وسيع على النائيات % % يبجل اذا غب رأيا وساعا % % 6(@)(@@) % ترى كل يوم مع الحادثات % عراكا له دوننا أو قراعا % % 7(@)(@@) % له قلم إن جرى غربه % أمنا القنا ، وخشينا اليراعا % % 8(@)(@@) % ومدره قول بيد الخصوم % % إذا بلغوا بالخصام القذاعا % % 9(@)(@@) % كعالية الرمج ان طاولوه % % طال إلى المجد نفسا وباعا % % 10(@)(@@) % إذا نزعوا عن هوى المكرمات % من اللوم زاد اليها نزاعا % % PageV01P950 11(@)(@@) % بحمزة امسيت القى الخطوب % % وارمى العدو وارقى اليفاعا % % 12(@)(@@) % يدافع ركني حتى انال % % ويدفع عني الأعادي دفاعا % % 13(@)(@@) % أطال يدي ففرعت الهضاب % وأطلعني بالندى ما استطاعا % % 14(@)(@@) % حقوق علي رأى انها % % حقوق عليه فوالي وراعى % % 15(@)(@@) % فلا الوعد كان مطالا ضمارا % % يغر ولا القول زورا خداعا % % 16(@)(@@) % صنعت فتممت حسن الصنيع % % وكم صانع لا يرب اصطناعا % % 17(@)(@@) % تعاطوا صنيعك ، فاستثقلوه % ان التطبع يعي الطباعا % % 18(@)(@@) % وغيرك يمطل فعل الجميل % فإن فعل الفعل يوما أضاعا % % 19(@)(@@) % تلقاك نيروزك المستجد % يسر عيانا ويرضي سماعا % % 20(@)(@@) % ولا زال دهرك طوع الجنيب % % إذا ما أمرت بأمر أطاعا % % PageV01P951 21(@)(@@) % تلاقى الخطوب ثقالا بطاء % وغر الاماني عجالا سراعا % % 22(@)(@@) % همام رميت قيادي اليه % % مآلا إلى شعبه وانقطاعا % % 23(@)(@@) % مددت يميني فاعلقتها % % يدا باصطناع الأيادي صناعا % % 24(@)(@@) % إذا قرحت عندنا نعمة % اعاد اياديه فينا جذاعا % % 25(@)(@@) % فلو رام قسمة عمري له % % لم أرض له العمر إلا مشاعا % % 26(@)(@@) % وإن هو ساومني مهجتي % % صفقت على راحته بياعا % % PageV01P952 البحر : رجز تام 1(@)(@@) % غالى بها الزائد حتى ابتاعها % % بادنة قد ملأت أنساعها % % 2(@)(@@) % سوغها الراعي ربيع ضارج % والأرض قد عم الندى بقاعها % % 3(@)(@@) % يوردها بين نطاع فالنقا % % زرق جمام لبست يراعها % % 4(@)(@@) % طاع لها حمض اللوى ونشرت % لها ربى قباقب أقطاعها % % 5(@)(@@) % رعت حلي رامة وشاطرت % جوازي الرمل بها لعاعها % % 6(@)(@@) % تلس اثار درور جونة % % ألقت على ذي بقر بعاعها % % 7(@)(@@) % مسيلة بين العقيق والحمى % % أضواج بطن الأرض أو أجزاعها % % 8 
ms270	(@)(@@) % تطلق عقل النبت إما رجعت % جلجالها بالرغد أو قتعاعها % % 9(@)(@@) % يستفيض العشب لها رؤسه % % اذا البروق اعتصرت دفاعها % % 10(@)(@@) % حتى بنى الني على سنامها % % مبانيا ما بطنت سياعها % % PageV01P953 11(@)(@@) % شاغبه الهم فارضاه بها % % تشرع عن دار الاذى نزاعها % % 12(@)(@@) % إن قطع الراعي عليها لم تبل % أشبعها الخذراف أم أجاعها % % 13(@)(@@) % مخيلة مبركها من شخصها % % إذا المطايا عمرت رباعها % % 14(@)(@@) % تضيع عن غب الونى كانها % % عائمة قد رفعت شراعها % % 15(@)(@@) % تحسبها الورهاء ريعت فنجت % % من الذى طارحة قناعها % % 16(@)(@@) % وقرها السير وكانت حقبة % % لو سمعت حس القراد راعها % % 17(@)(@@) % كأنها طاوي المصير هاجه % عض ضراع قد بلا مصاعها % % 18(@)(@@) % اذا رأى افتراقها زاولها % % ثم يني اذا رأى اجتماعها % % 19(@)(@@) % % مشاورات النفس اوازماعها % % 20(@)(@@) % في عانة تطيعه محاميا % فان رآها شردا اطاعها % % PageV01P954 21(@)(@@) % تنتصب انتصابه لنبأة % % ذعرا ، وينصاع لها انصياعها % % 22(@)(@@) % يحفظها عن سربها % % فان رأى جد الردى اضاعها % % 23(@)(@@) % أقضى عليها أربا من همة % لو عدل الدهر ثنى زماعها % % 24(@)(@@) % مطبوعة على العلى لو رضيت % بالذل يوما أنكرت طباعها % % 25(@)(@@) % يا حفظها ان بلغت مرامها % % وان ابى الدهر فياضياعها % % 26(@)(@@) % أستعجل الأمر وحظي رايث % نفس ارجى ابدا خداعها % % 27(@)(@@) % ولو قنعت بالحظوظ لم أبل % ابطائها بالرزق أم اسراعها % % 28(@)(@@) % اصارع الاقدار عن وقوعها % % بمنكب معود صراعها % % 29(@)(@@) % تصادف الخرقاء من زمانها % % سجال رزق أخطأت صناعها % % 30(@)(@@) % قومي الأولى إما جروا لغاية % بذوا بطاء الغاي أو سراعها % % PageV01P955 31(@)(@@) % هم الملاجي والمناجي والحمى % % إذا المنايا وقعت وقاعها % % 32(@)(@@) % هم المعاذ والملاذ والذرى % % اذ السيول ركبت تلاعها % % 33(@)(@@) % هم المقيلون المنيلون اذا % % ما اللزبة اللزباء ألقت باعها % % 34(@)(@@) % أزوال أيام الطعان إن طغت % يد الزمان أحسنوا دفاعها % % 35(@)(@@) % في حيث لا تنظر تحت نقعها % % الا عصي الموت أو قراعها % % 36(@)(@@) % لم يغنموا الاموال الا اخذوا % % صفيها ، وقبضوا مرباعها % % 37(@)(@@) % تلقى بهم مرسى الوقار والحجى % % وضئضئ العلياء أو جماعها % % 38(@)(@@) % ان نزلوا الجو اماتوا شمسه % % والأرض كانوا ابدا طلاعها % % 39(@)(@@) % بيوتهم مرهوبة تخالها % % أولاج غيل 
ms271	 رشحت سباعها % % 40(@)(@@) % المانعون الضيم باللدن ترى % % هبابها للطعن أو زعزاعها % % PageV01P956 41(@)(@@) % كأن في الأيمان حيات النقا % % ارقمها التضناض أو شجاعها % % 42(@)(@@) % من كل سوار ، إذا رام العلى % % حاز عقاب الجو أو ملاعها % % 43(@)(@@) % محلقا يبلغ منها غاية % % لو رامها العيوق ما استطاعها % % 44(@)(@@) % حاصوا خصاصات قريش بالقنا % % شوارعا ، وجمعوا شعاعها % % 45(@)(@@) % ردوا على ساداتها احضارها % % وضمنوا بيض الطلى ارتجاعها % % 46(@)(@@) % وتوجوا بمجدهم مفرقها % % عن عطل وسوروا ذراعها % % 47(@)(@@) % كانوا صياصيها وكانوا دونها % % فراطها في المجد أو نزاعها % % 48(@)(@@) % والزاحمين بالقنا أعداءها % % على الثنايا ، منعوا طلاعها % % 49(@)(@@) % أيام حطوا بالظبى أغمادها % % عن العلى وغمزوا نباعها % % 50(@)(@@) % بالخيل لا تعلف الا شدها % % أو ملقها بالبيد ، واندراعها % % PageV01P957 51(@)(@@) % مثل الرماح هز هزت كعوبها % % أو كالذباب اتبعت اطماعها % % 52(@)(@@) % كأن عقبان الشريف فوقها % % تعلو قنان الأرض أو جزاعها % % 53(@)(@@) % ثلمح ما عارضها باعين % % مثل الجذى طارحة شعاعها % % 54(@)(@@) % هم رفعوا بمجدهم قبابها % % وضؤوا من نارهم يفاعها % % 55(@)(@@) % حموا بأطراف القنا سوامها % % من العدى وامنوا رتاعها % % 56(@)(@@) % والصقوا بالرغم دون نيلها % % موارنا قد أوعبوا اجتداعها % % 57(@)(@@) % إن كان روع عاقدوا شجاعها % % على الردى وامنوا مجزاعها % % 58(@)(@@) % كبوا على أذقانها أصنامها % % لا ودها ابقوا ولا سواعها % % 59(@)(@@) % تدارك الله بجدي عزها % % وقد شراها ذلها وباعها % % 60(@)(@@) % جازت به حد العلى وقد رأت % % تقارع الجدود واصطراعها % % PageV01P958 61(@)(@@) % بمجده والعز من ايامه % % مدت إلى نيل العلى أضباعها % % 62(@)(@@) % واعجبا لعصبة مغرورة % % تريد أن تلصق بي قذاعها % % 63(@)(@@) % أذهلني استواؤها في غيها % % مطيعها أعذل ، أو مطاعها % % 64(@)(@@) % تقودني إلى الهوان ضلة % وقد أبى العز لي اتباعها % % 65(@)(@@) % تسومني ورد القذى وقد رأت % عزة هذي النفس وامتناعها % % 66(@)(@@) % تريد أن ألقى الخنا لقاءها % % وأن أنيخ للأذى جعجاعها % % 67(@)(@@) % وألبس العار الطويل لبسها % % وأرضع الذل لها رضاعها % % 68(@)(@@) % قبيلة اغلطها نهج العلى % % لؤم عروق جرت انضاعها % % 69(@)(@@) % قوم هوت أنفسهم من دلة % وأشرفت حظوظهم أيفاعها % % 70(@)(@@) % يا ليتهم حطوا انحطاط قدرهم % أو رفعتني همتي ارتفاعها % % PageV01P959 71(@)(@@) % اما المعالي فاخذنا اولا 
ms272	 % طول سنيها ، وأخذتم ساعها % % 72(@)(@@) % أسمحت الدنيا لكم وأعرضت % صنائع لم تحسنوا اصطناعها % % 73(@)(@@) % ردت عليكم نعم مظلومة % لم تشكورها فانظروا انقطاعها % % 74(@)(@@) % يا بئس ما جرت عليك عامدا % من رائعات تكثر ارتياعها % % 75(@)(@@) % نفحة عار لذعت أعراضها % % لذع اللظى ووقرت اسماعها % % 76(@)(@@) % وغادرت صفاحها دامية % % عقر المطايا المت ايضاعها % % 77(@)(@@) % وامنت منها نزار انها % % سؤة قول كفيت سماعها % % PageV01P960 البحر : طويل 1(@)(@@) % خصيم من الايام لي وشفيع % % كذا الدهر يعصي مرة ويطيع % % 2(@)(@@) % وبى ظمأ لولا العلى ما بللته % % وفي كل قلب غلة ونزوع % % 3(@)(@@) % وما انا ممن يطلب الماء للصدى % % ويجمعني والواردين شروع % % 4(@)(@@) % رضاعي من الدنيا الممات فطامه % % وما نزح الثقدي الغزير رضيع % % 5(@)(@@) % أبينا ، ولا ضيم أصاب أنوفنا % % وفي الأرض مصطاف لنا وربيع % % 6(@)(@@) % إذا غدرت نفس الجبان بصبره % حمتنا ذروع طلقة وردوع % % 7(@)(@@) % وأقنعنا بالبيد أن ليس منزل % وما بين ايدي اليعملات وسيع % % 8(@)(@@) % أبثك أن المال عار على الفتى % % وما المال إلا عفة وقنوع % 9(@)(@@) % ايطلع لي عزم إلى ما اريده % % وصاحب سري في الرجال مذيع % 10(@)(@@) % وتشتاق نفسي حالة بعد حالة % % وازجرها اني اذا لقنوع % % PageV01P961 11(@)(@@) % واني لاغرى بالنسيم اذا سرى % % ويعجبني بالابرقين ربوع % % 12(@)(@@) % ويحيني علي الشوق نجدي مزنة % % وبرق باطراف الحجاز لموع % % 13(@)(@@) % ولا اعرف الاشجان حتى يشوقني % % حمام ببطن الواديين سجوع % 14(@)(@@) % ولولا الهوى ما كنت إلا مشمرا % أطاع على رغم الهوى وأطيع % 15(@)(@@) % اذا راق صبح فالحصان مصاحب % % وان عاق ليل فالحسام ضجيع % % 16(@)(@@) % تركت الليالي خلف ظهري رذية % % وصاحبني طاغي الذباب قطوع % % 17(@)(@@) % وخاطرت مشغوفا بما أنا طالب % أجوب الدجى والطالبون هجوع % 18(@)(@@) % ألا إن رمحا لا يصول لنبعة % وإن حساما لا يقد قطيع % 19(@)(@@) % وفارقت من أبناء قيس وخندف % رجالا ولم تنفر علي ضلوع % % 20(@)(@@) % تركتهم يدعون والدمع ناشز % % وما ملكت طرفي علي دموع % PageV01P962 21(@)(@@) % وحذرهم مني فؤاد مشيع % % وعزم لاقران الرجال قطوع % % 22(@)(@@) % ونفس على كر النوائب حرة % % وقلب على حرب الزمان مطيع % 23(@)(@@) % وقلت : قبول الضيم 
ms273	 أعظم خطة % % وما الحرفي رحب البلاد مضيع % % 24(@)(@@) % فلما رأيت الذل في القوم سبة % % ذهبت ، فلم يقدر علي رجوع % 25(@)(@@) % ألا إن ليلي بالعراق كأنه % طليح تجافاه الرجال ظليع % % 26(@)(@@) % مقيم يعاطيني الهموم وناظري % % معنى بأعجاز النجوم ولوع % 27(@)(@@) % وخيل أبحناها السماوة والوجى % % تنفر ايديها الحصى وتروع % % 28(@)(@@) % إلى ان تسامى الصبح والليل لافظ % % حشاشته ، والطالعات تريع % 29(@)(@@) % ولله يوم بالعراق نجوته % وايدي المنايا بالنجاء وقوع % % 30(@)(@@) % تملست منه أملس الجيب وانثنى % % له في جيوب الناكثين ردوع % % PageV01P963 31(@)(@@) % تنازعه الأفواه في كل مشهد % وكل حديث كنت فيه بديع % % 32(@)(@@) % طعمنا وأطعمنا القنا من دمائه % وسارت بأمال الرجال صدوع % % 33(@)(@@) % وتحفظ أيدينا كعوب رماحنا % % واطرافها بين القلوب تضيع % % 34(@)(@@) % طماعيتي ان املك المجد كله % % وكل غلام في العلاء طموع % 35(@)(@@) % ومولى يعاطيني الكؤوس تجملا % % وقد ود لو ان العقار نجيع % % 36(@)(@@) % خبأت له ما بين جنبي فتكة % دهته ، ويوم الغادرين شنيع % 37(@)(@@) % فلا كان يوم لا يدوم وفائه % % فإن وفاء في الزمان بديع % 38(@)(@@) % وبعض مقال القائلين مكذب % وبعض وراد الاقربين خدوع % % 39(@)(@@) % ارى رشادا يصغى ولبس مكلم % % ومسترشد يدعو وليس سميع % % 40(@)(@@) % وما الناس إلا ماجد متلثم % وآخر مجرور العطاف خليع % PageV01P964 41(@)(@@) % وما الدهر الا نعمة ومصيبة % % وما الخلق الا آمن وجزوع % % 42(@)(@@) % ويوم رقيق الطرتين مصفق % % وخطب جراز المضربين قطيع % 43(@)(@@) % عجبت له يسري بنا وهو واقف % % ويا كل من اعمارنا ويجوع % % 44(@)(@@) % واي فتى من فرع سعد صحبته % % وما هجنت تلك الأصول فروع % 45(@)(@@) % خفيف على ظهر النجيب تهزه % % عروض على اعطافه وقطوع % % 46(@)(@@) % إذا غاب يوم أطلع العز وجهه % وللبدر فينا مغرب وطلوع % 47(@)(@@) % سانقض من ليل الثوبة وفرتي % % إلى منزل للدهر فيه خضوع % % 48(@)(@@) % ارى العيس قد خاط اللغام شفاهها % % ومن دونها صعب الضراب منيع % 49(@)(@@) % اذا اخذت منها الازمة حثها % % نجاء واعضاد المطي تبوع % % 50(@)(@@) % ونحن ، إذا طار السياط بشأوها % % سجود على اكوارها وركوع % % PageV01P965 51(@)(@@) % وإني لا أرضى من الدهر بالرضا % % وعزمي اخوذ والزمان منوع 
ms274	 % % 52(@)(@@) % وفي العيش مشمول النطاف مرقرق % وفي الأرض مخنصر الجناب مريع % % PageV01P966 البحر : طويل 1(@)(@@) % اظن الليالي بعدكم سنريع % % فمن يبق لي من رائع فتروع % % 2(@)(@@) % خذي عدة الصبر الجميل فانه % % 3(@)(@@) % وقد كنت ابكي للاحبة قد أنى % % لقلبي سلو واطمأن ولوع % % 4(@)(@@) % ولكنما أبكي المكارم أخليت % منازل منها للندى وربوع % 5(@)(@@) % وهل أنا جاز ذلك العهد بالبكا % % ولو أن كحل الماقيين نجيع % 6(@)(@@) % أبيت وطراق الهموم كأنها % % محافل حي تنتجى وجموع % % 7(@)(@@) % اقارع اولى الليل عن اخرياته % % كاني اقود وهو ظليع % % 8(@)(@@) % وعيني لرقراق الدموع وقيعة % لها اليوم من عاصي الشؤون مطيع % 9(@)(@@) % بمن تدفع الجلي بمن ترفع العلى % % بمن تحفظ الآمال وهي تضيع % % 10(@)(@@) % بمن ينقع الظمآن ، وهو محلأ % بمن يؤمن المطرود ، وهو مروع % PageV01P967 11(@)(@@) % هو الرزء لا يعدو المكارم والعلى % % 12(@)(@@) % واين قوام الدين للبيض والقنا % % اذا لم يكن الا اليقين دروع % % 13(@)(@@) % واين قوام الدين للنيل والقرى % % اذا الجذب معط والسحاب منوع % % 14(@)(@@) % الا من لاضياف الشتاء يلفهم % % سقيط ظلام قطقط وصقيع % % 15(@)(@@) % تجاذبهم ايدي الشمال رباطهم % % فيسقط سب أو يضل قطيع % % 16(@)(@@) % اذا كان بين البيت والزفزف الصبا % % أحاديث تخفى مرة ، وتذيع % 17(@)(@@) % ومن للعفاة المرملين يشلهم % من الدهر قرن لا يرام منيع % 18(@)(@@) % فيا راعي الذود الظماء تركتها % % وأحفظ راع مذ نأيت مضيع % 19(@)(@@) % وليس لها في الدار دين شريعة % ولا في ثنايا الطالعين طلوع % 20(@)(@@) % ولا للغوادي مذ فقدت مزايد % % ولا للمعالي مذ عدمت قريع % % PageV01P968 21(@)(@@) % أقول لناعيه عقرت ، وجربت % بشلوك فدعاء اليدين خموع % % 22(@)(@@) % وغلغل ما بين الحجابين والحشا % % كأني أقود النجم ، وهو ظليع % 23(@)(@@) % نعيت الندى غضا يرف نباته % وشمل العلى والمجد وهو جميع % % 24(@)(@@) % ببدر معم في الكواكب مخول % % 25(@)(@@) % من القوم طالوا كل طول إلى العلى % % اذا اذرع يوما قصرن وبوع % % 26(@)(@@) % بنوا في يفاع المجد وهو ممنع % % بنى طيرها بين النجوم وقوع % % 27(@)(@@) % فلا حملت أم المكارم بعده % صلوم لأشراف العلاء جدوع % 28(@)(@@) % ولا أدت الركب الخماص ، على الوجى 
ms275	 % % سفائن بر ، والسياط قلوع % 29(@)(@@) % إلى أن يزاد المستنيلين بعده % من الحي قر في الظلام وجوع % 30(@)(@@) % أضم عليه الراحتين تعلقا % وقد نزعته من يدى نزوع % % PageV01P969 31(@)(@@) % غصبتك علقا لم ابعه ولم اكن % % كباغي رباح يشتري ويبيع % 32(@)(@@) % طويتك طي البرد لم ينض من بلى % % وقد يغمد المطرور ، وهو صنيع % 33(@)(@@) % اناديك من تحت الخطوب غدي لها % % بظهري رحل ضاغط وقطوع % 34(@)(@@) % وما كانت الايام يفرعن هضبتي % % لو أنك واع للدعاء سميع % 35(@)(@@) % رمتني سهام البأس بعدك جهرة % وأنبض ، نحوي عاجز وجزوع % 36(@)(@@) % وزال مجن مانع كنت اتقي % % به الخطب ، والخطب الجليل قطوع % 37(@)(@@) % وما كنت أدري أن فوقك آمرا % من الدهر يدعو بغتة فتطيع % 38(@)(@@) % فغالب اطماعي عليك مغالب % % وقارع آمالي عليك قروع % 39(@)(@@) % عصبت ، فلم أسمح لغير أكفكم % % بدري وبعض الحالبين طموع % % 40(@)(@@) % إباء ، ولو طارت بكفي مليحة % فأين قوام الدين للخطب يعتري % % PageV01P970 41(@)(@@) % لقد لسبتني من عقارب كيدهم % % دبوب ، إذا جن الظلام لسوع % 42(@)(@@) % يسومني حسن الثناء وضامن % % لسوء مقال أن يسوء صنيع % 43(@)(@@) % وحسبك من ذم الفتى ترك مدحه % لأمر يضيق القول وهو وسيع % 44(@)(@@) % سقاك على نأي الديار وشحطها % % ربيع ، وهل يسقي الربيع ربيع % 45(@)(@@) % وحياك عنا كل نجم وشارق % % اذا جن ليل أو اضاء صديع % % 46(@)(@@) % ذكرتك ذكر العاطشات ورودها % % تحرق أكباد لها وضلوع % 47(@)(@@) % تقاذفن يطلبن الرواء عشية % نزائع ادنى وردهن نزيع % % 48(@)(@@) % ضربن طريقا بالمناسم اربعا % % إلى الماء لا تدنى إليه شروع % 49(@)(@@) % فهجرا لدار الحي بعد رحيلكم % % وما كل اظغان لهن رجوع % % 50(@)(@@) % ولا مرحبا بالأرض لستم حلولها % % وان كان مرعى للقطين مريع % % PageV01P971 51(@)(@@) % لقد جل قدر الرزء أن يبلغ البكا % % مداه ولو ان القلوب دموع % % 52(@)(@@) % ولو أن قلبي بعد يومك صخرة % لبان بها وجدا عليك صدوع % % PageV01P972 البحر : بسيط تام 1(@)(@@) % منابت العشب لا حام ولا راع % مضى الردى بطويل الرمح والباع % 2(@)(@@) % القائد الخيل يرعيها شكائمها % % والمطعم البزل للديمومة القاع % 3(@)(@@) % من يستفز سيوفا من مغامدها % % ومن يجلل نوقا 
ms276	 بين أنساع % 4(@)(@@) % يسقى أسنته حتى تقيء دما % ويهدم العيس من شد وايضاع % % 5(@)(@@) % ما بات إلا على هم ولا اغتمضت % عيناه الا على عزم وازماع % % 6(@)(@@) % خطيب مجمعة تغلي شقاشقه % اذا رموه بابصار واسماع % % 7(@)(@@) % لما اتاني نعي من بلادكم % % عضضت كفي من غيظ على الناعي % % 8(@)(@@) % ابدي التصامم عنه حين اسمعه % % عمدا وقد ابلغ الناعون اسماعي % % 9(@)(@@) % عمت عقيلا وإن خضت بني شبث % بزلاء تملأ أذن السامع الواعي % % 10(@)(@@) % ليس الشجاع الذي من دون رؤيته % باب يلاحك مصراعا بمصراع % PageV01P973 11(@)(@@) % ولا الذي إن مضى أبقى لوارثه % سوائما بين اضواح واجزاع % % 12(@)(@@) % لكنه من إذا أودى فليس له % الا عقائل ارماح وادراع % % 13(@)(@@) % يعتسه الذئب في الظلماء مرتفقا % على رحابل ملقااة واقطاع % % 14(@)(@@) % يذوق العين طمع النوم مضمضة % % اذا الجبان ملا عينا بتهجاع % % 15(@)(@@) % أشيعث الرأس لا يجري الدهان به % وإن فلي فبماضي الغرب قطاع % 16(@)(@@) % لا يخلف المال إلا ريث يتلفه % ولا يذم على ما روح الراعي % % 17(@)(@@) % كم فجعتني الليالي قبله بفتى % % مشمر بغروب المجد نزاع % % 18(@)(@@) % يمر صوتي ، فلا يلوي بجانبه % وكان يكفيه ايمائي والماعي % % 19(@)(@@) % من كان انسي اضحى وحشتي وغدا % % من كان برئي اسبابا لا وجاع % % 20(@)(@@) % أنزلته حيث لا يظما إلى نهل % ولا يبالي بإخصاب وإمراع % PageV01P974 21(@)(@@) % وأرتعت حتى إذا لم يبق لي طمع % أملت نهج دموعي غير مرتاع % 22(@)(@@) % في كل يوم أكر الطرف ملتفتا % وراء نجم من الاقران منصاع % % 23(@)(@@) % امانع الدمع عينا حد دامعة % % وألزم اليد قلبا جد ملتاع % 24(@)(@@) % هل دمعة حذفتها العين شافية % % داء حنوت عليه بين اضلاعي % % 25(@)(@@) % أم هل يرد زمان في ثنيته % لنا أوائل سلاف وطلاع % 26(@)(@@) % يحدو على العنف اخرانا ليلحقنا % % عجلان ابرك اولانا بجعجاع % % 27(@)(@@) % جر الزمان على قومي سنابكه % وأوقع الموت فيهم أي إيقاع % 28(@)(@@) % واستطعمتني المنايا من اضن به % % فكان بالرغم اطعامي واشباعي % % 29(@)(@@) % قلد جناجنها الانساع وارم بها % % مناكب الليل ندبا غير مجزاع % 30(@)(@@) % فلا نجاء من الأقدار طالبة % فاطلب 
ms277	 علالة آمال وأطماع % PageV01P975 31(@)(@@) % بينا بسير الفتى حتى دعون به % % فرد عارضه ليا إلى الداعي % % 32(@)(@@) % يسعى مجدا فان الوى به قدر % % ضل الدليل وزلت اخمص الساعي % % 33(@)(@@) % يا مصعبا بخست ايدي المنون به % % فقيد قود ذلول الظهر مطواع % 34(@)(@@) % كم فرجة للاعادي بت تكلؤها % % لولاك فاهت بذي ودقين منباع % % 35(@)(@@) % الحمتها بصدور الخيل معلمة % % إلى الوغى وطوال ذات زعزاع % 36(@)(@@) % أرش فوقك نجدي يمد له % نيل السماء بآذي ودفاع % % 37(@)(@@) % يبدو مع الليل رجافا تكركره % ريح النعامى بواني الخطو مظلاع % 38(@)(@@) % وكل هافتة الاعناق ينحرها % % لمع البروق على ميث وأجراع % 39(@)(@@) % برق كخفق جناح المضرحي إذا % % جلى الطرائد من ومض وتلماع % 40(@)(@@) % تجير ودقا وترغو من جوانبها % % رعدا اذا قيل قد همت باقلاع % % PageV01P976 41(@)(@@) % استودع الأرض خلاني لتحفظهم % % لقد وثقت إلى هوجاء مضياع % PageV01P977 البحر : كامل تام 1(@)(@@) % لو كان يرتدع القضاء بمردع % % أو ينثني بمدجج ومقنع % 2(@)(@@) % لغدت مشمرة تقيك من الردى % % عصب تجر قنا الطعان وتدعي % % 3(@)(@@) % ومسددون أسنة يزنية % فتلوا بأكعبها حبال الأذرع % 4(@)(@@) % قوم ذيولهم الرماح اذا خطوا % % رفعوا بمسحبها غبار الأجرع % 5(@)(@@) % خيل توقح بالنجيع من الوجى % % وقني تثقف بالظلى والاضلع % % 6(@)(@@) % متعلقين عنان كل مسوم % % يشأى عجاجته بوقع الأربع % 7(@)(@@) % ذي غرة سبغت عليه كأنه % فيها يمد لحاظه من برقع % 8(@)(@@) % قعد عن الغنم القريب المجتبى % % سرع إلى الطلب البعيد المنزع % 9(@)(@@) % يا ناشدا همل المساعي نافضا % في إثرها لقم الطريق المهيع % 10(@)(@@) % هيهات لا مسعاة تنشد بعدها % % بظبى القواضب والقنا المتزعزع % PageV01P978 11(@)(@@) % ان ابن يوسف عريت انقاضه % % وثوى بمنزلة المكل المظلع % % 12(@)(@@) % متطامنا من بعد ما وضعت له % % أيامه خد الذليل الأضرع % 13(@)(@@) % ألقى بطاعته ، ولما يمتنع % % ومضى لطيته ولما يرجع % % 14(@)(@@) % قذيت له مقل السماح وقد شكا % % وهوت له قلل العلاء وقد نعي % % 15(@)(@@) % ابنته تحت الصفائح لو يرى % % ودعوته خلف الجنادل لو يعي % % 16(@)(@@) % ما لبث من يمسي مجازا للردى % % ومعرج القدر المغد المسرع % 17(@)(@@) % يغدو لا قدام الخطوب بمعثر % % ويرى 
ms278	 بمرئ للمنون ومسمع % % 18(@)(@@) % ما للزمان يلذ طعم مصائبي % % فكانه يظمى ليشرب ادمعي % % 19(@)(@@) % مغرى بنزع قوادمي مستعذبا % لتالمي من صرفه وتوجعي % % 20(@)(@@) % ارعى الذين جنوا ورق الغنى % % دوني واعلكني شكيمة مطمعي % % PageV01P979 21(@)(@@) % ومضى باخوان الصفاء فلم يدع % % منهم اخا ثقة ولا عضدا معي % % 22(@)(@@) % ابكيك يا عبد العزيز بخطة % % تعمي مطالعها وخطب مضلع % 23(@)(@@) % ومقاوم ما زلت تعجز ليلها % % بلسان قوال وقلب سميدع % % 24(@)(@@) % اني ارى في المجد بعدك ثلمة % % تبقى وخرقا ما له من مرقع % 25(@)(@@) % من يشرق الخصم الألد بريقه % عيا ويقدع منه ما لم يقدع % 26(@)(@@) % أم من يبلغ بالبلاغة غاية % تلوي بحسرى طالبين وظلع % 27(@)(@@) % أم من يرد من المغيرة غربها % % والخيل تنهض كالقطا بالدرع % % 28(@)(@@) % بنوافذ للقول يبلغ وقعها % % ما ليس يبلغ بالرماح الشرع % 29(@)(@@) % شهب تشعشع في النوائب ضؤها % % كالشمس تنغض رأسها للمطلع % % 30(@)(@@) % حتى يقول الغابطون وقد رأوا % % فعلاته : زاحم بجد أودع % PageV01P980 31(@)(@@) % ويود من حمل الثنا لو أصبحت % تلك الاداة على الكمي الاروع % % 32(@)(@@) % إن لا تكن في الجمع أمضى طعنة % فلا انت امضى خطبة في المجمع % % 33(@)(@@) % إن الفصاحة ذللت لك عنقها % % فاخذت منها بالعنان الاطواع % % 34(@)(@@) % أمست ظهور المجد عندك ترتقي % % منها إلى قمع السنام الامنع % % 35(@)(@@) % نهاز أذنبة الكلام ، إذا هفا % % بشر كبارقة النصول اللمع % % 36(@)(@@) % نهاز اذنية الكلام اذا هفا % % قلب الجري وعي قول المصقع % % 37(@)(@@) % قد قلت للمتعرضين لسطوه % % خلوا وجار الارقم المتطلع % % 38(@)(@@) % إياكم أن يستضيفكم الدجى % % ومقيله ومقيلكم في موضع % % 39(@)(@@) % لا تتبعوا شبه الأمور فانه % % شبه يتيح الحق عند المقطع % 40(@)(@@) % نثني عليك ثناء راي هجمة % مثل القذاة ملظة بالدمع % % PageV01P981 41(@)(@@) % واذا تغيطلت المطالع حيرة % % صدع العماية بالقضاء المقنع % 42(@)(@@) % بأبى من استودعته بطن الثرى % % وعلمت كيف خيانة المستودع % % 43(@)(@@) % ياليت شعري من اعد لدهره % % ماذا اعد لضيق هذا المضجع % % 44(@)(@@) % لم يخل من ترمي الخطوب سواده % % من واقع ابدا ومن متوقع % % 45(@)(@@) % نجد الضراعة والنقيصة نزرة % إن القلامة شكة للإصبع % 46(@)(@@) % ان 
ms279	 اقض مفروض البكاء عليكم % % متحرجا يجري الدموع تبرعي % % 47(@)(@@) % هل تعلمون على بعاد دياركم % % أن الغليل عليكم لم ينقع % 48(@)(@@) % لا تعدموا مني وإن بعد المدى % % نفس العميد وانة المتفجع % % 49(@)(@@) % ما شئت من دمع لكم متحدر % % وزفير وجد بعدكم مترفع % 50(@)(@@) % أمسى أخ لك لم يجارك في الصبا % % طلقا ولا ساقاك در المرضع % PageV01P982 51(@)(@@) % في صدره ارة عليك من الجوى % % تذكى بانفاس المعنى الموجع % % 52(@)(@@) % رزء تخضخض سهمه في مقتلي % % يمضى الزمان ونصله لم ينزع % % 53(@)(@@) % نضح الثرى ذو أنت فيه مجلجل % يستخلف الأكلاء بعد المقلع % 54(@)(@@) % هزج الرعود له بكل ثنية % زجل كشقشقة الفنيق الموضع % 55(@)(@@) % لثق المناخ ثقيلة أوراكه % حضر المجر مروض بالبلقع % 56(@)(@@) % حتى ترى نزع الربى من نوره % % غمما يرف على خصيب ممرع % % 57(@)(@@) % ومتى يكن فيه سقاك نقيصة % % أبد الزمان تممتها بالأدمع % 58(@)(@@) % % بعد الجدوب على الغمام المقلع % 59(@)(@@) % ونقول فيك ولو سكننا قالت % % لت الأيام أكثر ما نقول وندعي % % 60(@)(@@) % ولقد تجافى المجد عن ثفناته % قلقا عليك فما يقر بمريع % % PageV01P983 61(@)(@@) % نقصت اداة الفضل بعدك كلها % % فوعى بمصطلم وشم بأجدع % 62(@)(@@) % فاذهب رعاك الله غير مضيع % % وسقى ثراك المزن غير مروع % % 63(@)(@@) % فالقلب للشانين إن لم يكتئب % والجفن للاعداء ان لم يدمع % % PageV01P984 البحر : طويل 1(@)(@@) % الا ناشدا ذاك الجناب الممنعا % % وجردا يناقلن الوشيج المزعزعا % % 2(@)(@@) % ومن يملأ الايام بأسا ونائلا % % وتثنى له الأعناق خوفا ومطمعا % % 3(@)(@@) % أجلي إليه ذلك الخطب مقدما % وقد كان لا يلقاه إلا مروعا % % 4(@)(@@) % وجاز أضاميم البلاد مغيرة % وحي نزارا حاسرين ودرعا % % 5(@)(@@) % وسمر عقيل تحمل الموت أحمرا % وبيض عقيل تقطر السم منقعا % % 6(@)(@@) % ولم تخش من حد الصوارم مضربا % ولم تلق من ايدي القبائل مدفعا % 7(@)(@@) % رأى ورق البيض الخفاف هشائما % وشوك العوالي ناصلا أو منزعا % % 8(@)(@@) % هو القدر الاقوى الذي يقصف لقنا % % ويلوي من الجبار جيدا وأخدعا % % 9(@)(@@) % ويستهزم الجرد الجياد تخالها % % بجافلة الابطال سربا مذعذعا % % 10(@)(@@) % ترى الظفر الماضي الشباة قلامة % إذا غالب الأقدار ، والباع إصبعا 
ms280	 % % PageV01P985 11(@)(@@) % أتاني ، وغول الأرض بيني وبينه % فيا لك رزءا ما أمض وأوجعا % % 12(@)(@@) % جوانب أنباء وددت بأنني % % صممت لها ما أورق العود مسمعا % % 13(@)(@@) % تصاممت حتى ابلغ النفس عذرة % % وما نطق الناعون الا لا سمعا % % 14(@)(@@) % بان أبا حسان كبت جفانه % % واخمد نيران القرى يوم ودعا % % 15(@)(@@) % اعز على عيني من العين موضعا % % والطف في قلبي من القلب موقعا % % 16(@)(@@) % اكن غليلي بالضلوع ولم اجد % % لقلبي وراء الهم مذ غاب مطلعا % % 17(@)(@@) % وفارقني مثل النعيم مفارقا % وودعني مثل الشباب مودعا % % 18(@)(@@) % علا الوجد بي حتى كأن لم أر الردى % % يخط لجنب قبل جنبك مصرعا % % 19(@)(@@) % لقد صغر الارزاء رزؤك قبلها % % وهون عندي النازل المتوقعا % % 20(@)(@@) % فإن لم تزل نفسي عليك ، فإنها % % ستنفد انفاسا حرارا وادمعا % % PageV01P986 21(@)(@@) % فيا لائمي اليوم لا صبر بعده % فطيرا بأعباء الملامة أو قعا % % 22(@)(@@) % برغمك اجممت الصوارم والقنا % % واخليت يوم الروع بيضا وادرعا % % 23(@)(@@) % ومنتجع أرض العدو تخاله % جبال شرورى طلن ميثا واجرعا % % 24(@)(@@) % اذا وردت أنقاع ماء وقيعة % % أنشت على اخراه بالماء اجمعا % % 25(@)(@@) % إذا انقاد علويا حسبت جياده % اكاما عليهن الاجادل وقعا % % 26(@)(@@) % مطوت به استراث جماحه % % وجعجع بالبيداء حسرى وظلعا % % 27(@)(@@) % من القوم طاروا في الفلاكل طيرة % ومدوا إلى الاحساب بوعا واذرعا % % 28(@)(@@) % اذا لبسوا الريط اليماني واقبلوا % % يجرون منها الشرعبي المضلعا % % 29(@)(@@) % حسبت اسود الغاب رحن عشية % % تخال بهن البابلي المشعشعا % % 30(@)(@@) % صفاح خدود كالذوابل طلقة % % يبادون بالظلماء لحما مبضعا % % PageV01P987 31(@)(@@) % وابيض من عليا معد سما به % % إلى السورة العليا أب غير أضرعا % % 32(@)(@@) % كانك تلقى وجهه البدر طالعا % % اذا ابتدر القوم المرفعا % % 33(@)(@@) % فان الهبت فيه الحفيظة خلته % % وراء اللثام الارقم المتطلعا % % 34(@)(@@) % يقوم اهتزاز الرمح خبت كعوبه % % ويقعد اقعاء ابن عيل تسمعا % % 35(@)(@@) % ضموم على الهم الذي بات ضيفه % على الامر الذي كان ازمعا % % 36(@)(@@) % صليب على قرع الخطوب كانما % % يرادين طودا من عماية أفرعا % % 37(@)(@@) % وكم مثله يستفرغ الدمع رزؤه % ويوهي صفاة القلب حتى تصدعا % % 38(@)(@@) % اذا احجم الاقوام 