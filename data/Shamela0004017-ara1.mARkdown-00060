ms57	 النيسابوري(@)(@@)(@@)(@@) $BIO_MAN$ 1265 - إبراهيم بن محمد أبو إسحاق النيسابوري المعروف بالأبيوردي(@)(@@)(@@)(@@) $BIO_MAN$ 1266 - إبراهيم بن أحمد بن الحسن أبو إسحاق النيسابوري المعروف بالبغدادي(@)(@@)(@@)(@@) $BIO_MAN$ 1267 - إبراهيم بن محمد بن إبراهيم بن شداد النيسابوري أبو إسحاق الشدادي الحاكم PageV00P000(@)(@@)(@@)(@@) $BIO_MAN$ 1268 - إبراهيم بن علي بالويه أبو إسحاق البلخي(@)(@@)(@@)(@@) $BIO_MAN$ 1269 - إبراهيم بن محمد أبو إسحاق الرييس البسطامي سكن بنيسابور بباغ الدارس وبها مدرسته وداره اللتي بناها لأهل الحديث(@)(@@)(@@)(@@) $BIO_MAN$ 1270 - إبراهيم بن سيمجور أبو إسحاق الأمير بن الأمير العادل بن العادل ولي بنيسابور سبع سنين فصارت أيامه تاريخا في العدل وتوفي ببخارى في سنة خمس وثلاثين وثلاثمائة(@)(@@)(@@)(@@) $BIO_MAN$ 1271 - إبراهيم بن عبد الله ولقب عبد الله بن عبدوس بن أحمد بن جعفر الحرش أبو إسحاق العدل النيسابوري من محلة الحيرة(@)(@@)(@@)(@@) $BIO_MAN$ 1272 - إسماعيل بن إبراهيم بن عمال الخزرجي (1) الأنصاري أبو محمد النيسابوري(@)(@@)(@@)(@@) $BIO_MAN$ 1273 - إسماعيل بن إبراهيم بن عبد الرحمن النيسابوري(@)(@@)(@@)(@@) $BIO_MAN$ 1274 - إسماعيل بن مطرب بن بحر بن سنان النيسابوري أبو عبد الله الزمجاري(@)(@@)(@@)(@@) $BIO_MAN$ 1275 - إسحاق بن إبراهيم بن عبد الملك النيسابوري أبو يعقوب الهجري محدث جرجان في عصره(@)(@@)(@@)(@@) $BIO_MAN$ 1276 - إسحاق بن عيسى بن يونس أبو يعقوب المرجاني(@)(@@)(@@)(@@) $BIO_MAN$ 1277 - إسحاق بن محمد بن عبد الله النيسابوري أبو يعقوب الجنابدي(@)(@@)(@@)(@@) $BIO_MAN$ 1278 - إسماعيل بن محمد أبو يعقوب الوراق النيسابوري وكان من الصالحين(@)(@@)(@@)(@@) $BIO_MAN$ 1279 - إلياس بن محمد بن يوسف بن حفص أبو يحيى الطوسي(@)(@@)(@@)(@@) $BIO_MAN$ 1280 - أحمد بن علي بن الحين القاضي الترمذي(@)(@@)(@@)(@@) $BIO_MAN$ 1281 - بكر بن محمد بن إسحاق بن خزيمة أبو نصر النيسابوري قال الطاهر محمد بن الفضل بن إسحاق: توفي عمي أبو النصر سنه ثلاث وعشرين وثلاثمائة يروى عنه هذا البيت:لسان الفتى نصب ونصف فؤاده - فلم يبق إلا صورة اللحم والدموكأين ترى من ساكت لك معجب - زيادته أو نقصه في التكلم(@)(@@)(@@)(@@) $BIO_MAN$ 1282 - بكر بن عبد الله بن محمد القاضي أبو علي بن أبو (2) بكر الحنال الرازي وقد روى وحدث بالمناكير(@)(@@)(@@)(@@) $BIO_MAN$ 1283 - بكر بن محمد 
ms58	 بن عبد الله النجاري(@)(@@)(@@)(@@) $BIO_MAN$ 1284 - بشر بن العباس بن الأشعث المروزي(@)(@@)(@@)(@@) $BIO_MAN$ 1285 - جعفر بن محمد بن أحمد بن بحر بن التميمي أبو محمد النيسابوري(@)(@@)(@@)(@@) $BIO_MAN$ 1286 - جعفر بن أحمد بن عمرو أبو محمد النيسابوري جعفرك الغازي(@)(@@)(@@)(@@) $BIO_MAN$ 1287 - الحسين بن محمد بن الحسن بن إبراهيم القاضي أبو علي الجنابدي ولي قضاء نيسابور(@)(@@)(@@)(@@) $BIO_MAN$ 1288 - الحسن بن محمد بن إبراهيم أبو طاهر الجنابدي النيسابوري(@)(@@)(@@)(@@) $BIO_MAN$ 1289 - الحسن بن أبو (3) محمد النصرآبادي السمسار وكان من العباد PageV00P000(@)(@@)(@@)(@@) $BIO_MAN$ 1290 - الحسن بن محمد بن بكر النيسابوري أبو علي بن خان يحيى بن معاذ(@)(@@)(@@)(@@) $BIO_MAN$ 1291 - الحسن بن محمد بن جابر النيسابوري أبو علي الشعيري المعروف بحسن الوكيل(@)(@@)(@@)(@@) $BIO_MAN$ 1292 - الحسن بن علي بن الحسين جعفر (1) النيسابوري أبو علي من محلة عمر آباد(@)(@@)(@@)(@@) $BIO_MAN$ 1293 - الحسن بن محمد بن سنان النيسابوري أبو علي السواق القنطري(@)(@@)(@@)(@@) $BIO_MAN$ 1294 - الحسن بن محمد بن ياسين بن النصر الباهلي النيسابوري(@)(@@)(@@)(@@) $BIO_MAN$ 1295 - الحسن بن محمد بن قيس بن صالح النيسابوري أبو علي البزاز(@)(@@)(@@)(@@) $BIO_MAN$ 1296 - الحسين بن محمد بن أحمد بن يونس بن جندل النيسابوري أبو علي القهستاني نزل أبوه بنيسابور(@)(@@)(@@)(@@) $BIO_MAN$ 1297 - الحسين بن محمد بن هارون أبو علي النيسابوري(@)(@@)(@@)(@@) $BIO_MAN$ 1298 - الحسين بن محمد بن موسى بن محمومة النيسابوري أبو علي السمسار وكان من أهل الصدق والمعروف بطلب الحديث والرحلة(@)(@@)(@@)(@@) $BIO_MAN$ 1299 - الحسين بن فوران النيسابوري(@)(@@)(@@)(@@) $BIO_MAN$ 1300 - الحسين بن محمد بن بشر النيسابوري أبو علي الأنماطي(@)(@@)(@@)(@@) $BIO_MAN$ 1301 - الحسين بن نصر النيسابوري أبو علي الباري وبار قرية من قرى بنيسابور(@)(@@)(@@)(@@) $BIO_MAN$ 1302 - الحسين بن هارون أبو علي المراغي من الرحالة في طلب الحديث وتوفي بنيسابور سنة خمس عشرة وثلاثمائة(@)(@@)(@@)(@@) $BIO_MAN$ 1303 - الحسين بن إسماعيل بن يحيى النيسابوري أبو علي الصفار(@)(@@)(@@)(@@) $BIO_MAN$ 1304 - الحسين بن بحر بن عبد الله المعلم النيسابوري أبو علي المعروف بالصوفي(@)(@@)(@@)(@@) $BIO_MAN$ 1305 - الحسين بن محمد بن محمد سام التميمي أبو علي الحاكم البلخي(@)(@@)(@@)(@@) $BIO_MAN$ 1306 - حميد بن محمد بن علي 
ms59	 الشيبباني أبو عمرو النيسابوري يعرف بحميد الصبي(@)(@@)(@@)(@@) $BIO_MAN$ 1307 - حامد بن محمود بن معقل النيسابوري أبو محمد القطان(@)(@@)(@@)(@@) $BIO_MAN$ 1308 - حامد بن محمود محمد (2) النيسابوري أبو العباس المشهور بأبي العباس بن كليم الشاهد ومسكنه سكة سكش(@)(@@)(@@)(@@) $BIO_MAN$ 1309 - حامد بن أحمد بن محمد بن حبيب أبو أحمد المروزي(@)(@@)(@@)(@@) $BIO_MAN$ 1310 - حامد بن أبي حامد الأشروسني حدث بنيسابور(@)(@@)(@@)(@@) $BIO_MAN$ 1311 - حوترة بن محمد النيسابوري أبو محمد البزنودي(@)(@@)(@@)(@@) $BIO_MAN$ 1312 - خلف بن حنظلة بن خاقان السرخسي أبو محمد(@)(@@)(@@)(@@) $BIO_MAN$ 1313 - زكريا بن محمد بن أكار المعدل النيسابوري أبو يحيى الميداني من ميدان زياد(@)(@@)(@@)(@@) $BIO_MAN$ 1314 - زيد بن يحيى بن الحسين العامري النيسابوري أبو الحسين من محلة دروان كوس PageV00P000(@)(@@)(@@)(@@) $BIO_MAN$ 1315 - سليمان بن داود بن عبد الله النيسابوري أبو أيوب ويعرف بابن داود النسوي وكان أبوه نزل بنيسابور(@)(@@)(@@)(@@) $BIO_MAN$ 1316 - سهل بن عبد الله أبو حاتم السجستاني(@)(@@)(@@)(@@) $BIO_MAN$ 1317 - سفيان بن محمد بن حاجب بن محمود النيسابوري أبو الفضل الجوهري وكان من المشهور بطلب الحديث بخراسان والعراق ومن أهل الثروة والأفضال على أهل العلم رحمه الله(@)(@@)(@@)(@@) $BIO_MAN$ 1318 - سلمة بن النصر بن سوادة بن عقيل القشيري أبو النصر النيسابوري من باب الدير(@)(@@)(@@)(@@) $BIO_MAN$ 1319 - صالح بن نوح بن منصور النيسابوري أبو الفضل الفرهاد جردي(@)(@@)(@@)(@@) $BIO_MAN$ 1320 - صديق بن عبد الله الرادساني النيسابوري(@)(@@)(@@)(@@) $BIO_MAN$ 1321 - طاهر بن يحيى بن قبيصة النيسابوري أبو الطيب البلغي(@)(@@)(@@)(@@) $BIO_MAN$ 1322 - عبد الله بن محمد بن عمر النيسابوري أبو محمد العطري(@)(@@)(@@)(@@) $BIO_MAN$ 1323 - عبد الله بن محمد بن إبراهيم النيسابوري أبو محمد الزوزني(@)(@@)(@@)(@@) $BIO_MAN$ 1324 - عبد الله بن محمد بن صبيح بن عبد العزيز وهو أبو بكر بن سالم بن عبد الله بن (1) عمر بن الخطاب العدوي أبو محمد الجوهري ومنزله في سكة حمدان. قال الحاكم رحمه الله: ومنزل أبي أيضا سكة حمدان ومسجده ومسجد أبي الذي كان عليه المئذنة قديما وقال أبي: توفى عبد الله أخي من الرضاعة سنة خمس عشرة وثلاثمائة(@)(@@)(@@)(@@) $BIO_MAN$ 1325 - عبد الله بن الفضل 
ms60	 بن محمد بن عقيل بن خويلد الخزاعي أبو بكر النيسابوري(@)(@@)(@@)(@@) $BIO_MAN$ 1326 - عبد الله بن الحسين بن محمد النيسابوري أبو بكر المؤدب(@)(@@)(@@)(@@) $BIO_MAN$ 1327 - عبد الله بن محمد بن داود القشيري النيسابوري أبو محمد الدهان(@)(@@)(@@)(@@) $BIO_MAN$ 1328 - عبد الله بن محمد بن زياد بن فاضل الفقيه النيسابوري أبو بكر الشافعي سكن بغداد وكان إمام الشافعيين في عصره(@)(@@)(@@)(@@) $BIO_MAN$ 1329 - عبد الله بن محمد بن مسلم النيسابوري أبو بكر(@)(@@)(@@)(@@) $BIO_MAN$ 1330 - عبد الله بن محمد بن هاشم بن طرماخ الطوسي أبو محمد وكان من أعيان المحدثين في عصره(@)(@@)(@@)(@@) $BIO_MAN$ 1331 - محمد بن علي بن طرخان الباهلي أبو بكر البلخي محدث بلخ في عصره(@)(@@)(@@)(@@) $BIO_MAN$ 1332 - عبد الله بن محمد بن منازل النيسابوري أبو محمد الصوفي المجرد على الصحة والحقيقة لا على مجرى العادة وتوفى رضي الله عنه ليلة الخميس الخامس من ربيع الأول سنة إحدى وثلاثين وثلاثمائة ودفن في مقبرة شاهنبر وله حالات عجيبة قال أبو عبد الله الملقابادي: PageV00P000عاولت عبد الله بن منازل في طريق الحج ومعنا أبو علي الثقفي وكنا نجتمع ويذكر فضل الجنيد بن محمد فيزيدنا (1) شوقا إلى لقائه وعبد الله بن منازل ساكت فلما دخلنا بغداد فقمت أنا وأبو علي الثقفي وقلنا لعبد الله: قم بنا نزور أبا القاسم. فقال: اذهبا أنتما. فقلنا: لا تجيء؟ فقال: لا. فتعجبنا وذهبنا إليه فزادت مشاهدته على ما كان عندنا من أخباره فقال لنا: هل صبحكما غيركما؟ قلنا: بلى هل من أصحابنا يعرف بعبد الله بن منازل؟ قال: كيف لم يحضرنا؟ قلنا: لعله. فقال: إذا انصرفتما إلي فاسألاه أن يصبحكما. قلنا: نعم انصرفنا إليه وقصصنا عليه ما سمعنا ووصفنا فلم يتكلم بشيء إلى أن أصحبنا اليوم الثاني وعرضنا عليه زيارة أبي القاسم فامتنع قلنا: إذا امتنعت فأخبرنا الذي منعك عن زيارة هذا الشيخ. فقال: لا بد أن أخبركم. قلنا: لا. قال: إن كان أمر أبي القاسم على ما وصفتموه فما مثل ما تسمعوه منه إلا مثل الطعام الطيب يتناوله الرجل ثم يخرج 