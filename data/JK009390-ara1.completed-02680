ms2661	 ) .(@)(@@)(@@)(@@) $ 24899 قال النبي :(@)(@@) | 30 ( لا ألفين أحدكم يجيء يوم القيامة على رقبته بعير له رغاء يقول : يا رسول الله أغثني ، فأقول : لا أملك لك شيئا قد أبلغتك ، لا ألفين أحدكم يجيء يوم القيامة على رقبته فرس له حمحمة فيقول : يا رسول الله أغثني ، فأقول : لا أملك لك شيئا قد أبلغتك ، لا ألفين أحدكم يجيء يوم القيامة على رقبته شاة لها ثغاء يقول : يا رسول الله أغثني ، فأقول : لا أملك لك شيئا قد أبلغتك ، لا ألفين أحدكم يجيء يوم القيامة على رقبته نفس لها صياح فيقول : يا رسول الله أغثني ، فأقول : لا أملك لك شيئا قد أبلغتك ، لا ألفين أحدكم يجيء يوم القيامة على رقبته رقاع تخفق فيقول : يا رسول الله أغثني ، فأقول : لا أملك لك شيئا قد أبلغتك ، لا ألفين أحدكم يجيء يوم القيامة على رقبته صامت فيقول : PageV08P131 يا رسول الله أغثني ، فأقول : لا أملك لك شيئا قد أبلغتك ) )(@)(@@) ( حم ق ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 24900 قال النبي :(@)(@@) | 30 ( لا ألفين أقواما من أمتي يأتون يوم القيامة بحسنات أمثال جبال تهامة بيضاء فيجعلها الله هباء منثورا ، أما أنهم إخوانكم ومن جلدتكم ويأخذون من الليل كما تأخذون ، ولاكنهم قوم إذا خلوا بمحارم الله انتهكوها ) )(@)(@@) ( ه ) عن ثوبان رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 24901 قال النبي :(@)(@@) | 30 ( لا إلاه إلا الله إن للموت سكرات ) )(@)(@@) ( حم خ ) عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ 24902 قال النبي :(@)(@@) | 30 ( لا إلاه إلا الله ، ويل للعرب من شر قد اقترب ، فتح اليوم من ردم يأجوج ومأجوج مثل هاذه ، وحلق بإصبعيه : الإبهام والتي تليها ، قيل : أنهلك وفينا الصالحون ؟ قال : نعم ، إذا كثر الخبث ) )(@)(@@) ( ق ن ه ) عن زينب بنت جحش رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ 24903 قال النبي :(@)(@@) | 30 ( لا إلاه إلا الله ، لا يسبقها عمل ولا تترك ذنبا ) )(@)(@@) ( ه ) عن أم هانىء رضي الله عنها .(@)(@@)(@@)(@@) $ 24904 قال النبي :(@)(@@) | 30 ( لا أمس أيدي النساء ) )(@)(@@) ( طس ) عن عقيلة بنت عبيد رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ 24905 قال النبي :(@)(@@) | 30 
ms2662	 ( لا أيم الله لا تصاحبنا راحلة عليها لعنة ) )(@)(@@) ( م ) عن أبي بردة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 24906 قال النبي :(@)(@@) | 30 ( لا إيمان لمن لا أمانة له ، ولا دين لمن لا عهد له ) )(@)(@@) ( حم حب ) عن أنس رضي الله عنه .(@)(@@) PageV08P132(@)(@@)(@@)(@@) $ 24907 قال النبي :(@)(@@) | 30 ( لا إيمان لمن لا أمانة لله ، ولا صلاة لمن لا طهور له ، ولا دين لمن لا صلاة له ، وموضع الصلاة من الدين كموضع الرأس من الجسد ) )(@)(@@) ( طس ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ 24908 قال النبي :(@)(@@) | 30 ( لا إلاه إلا الله الحليم الكريم سبحان الله رب العرش الكريم ، الحمد لله رب العالمين ، اللهم اغفر لي ، اللهم تجاوز عني ، اللهم اعف عني فإنك عفو غفور ) )(@)(@@) ( ن ) و ابن عساكر عن عبد الله بن جعفر قال : أخبرني عمر رضي الله عنه أن النبي يعلمه هاؤلاء الكلمات .(@)(@@)(@@)(@@) $ 24909 قال النبي :(@)(@@) | 30 ( لا إلاه إلا الله وحده لا شريك له ، له الملك وله الحمد وهو على كل شيء قدير ، لا إلاه إلا الله وحده ، أنجز وعده ، ونصر عبده ، وهزم الأحزاب وحده ) )(@)(@@) ( م د ه ) عن جابر أن النبي قال ذالك على الصفا والمروة .(@)(@@)(@@)(@@) $ 24910 قال النبي :(@)(@@) | 30 ( لا إلاه إلا الله وحده ، أعز جنده ، ونصر عبده ، وغلب الأحزاب وحده ، فلا شيء بعده ) )(@)(@@) ( حم خ م ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 24911 قال النبي :(@)(@@) | 30 ( لا إلاه إلا الله تمنع العباد من سخط الله ما لم يؤثروا صفقة دينارهم على دينهم ، فإذا آثروا صفقة دينارهم على دينهم ثم قالوا لا إلاه إلا الله ردت عليهم وقال الله كذبتم ) )(@)(@@) الحكيم عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ 24912 قال النبي :(@)(@@) | 30 ( لا إلاه إلا الله كلمة عظيمة كريمة على الله تعالى ، من قالها مخلصا استوجب الجنة ، ومن قالها كاذبا عصمت ماله ودمه وكان مصيره إلى النار ) )(@)(@@) ابن النجار عن دينار عن أنس رضي الله عنه .(@)(@@) PageV08P133(@)(@@)(@@)(@@) $ 24913 قال النبي :(@)(@@) | 30 ( لا إلاه إلا الله ، ما أطيبك وأطيب ريحك ، وأعظم حرمتك ، والمؤمن 
ms2663	 أعظم حرمة منك ، إن الله جعلك حراما ، وحرم من المؤمن ماله ودمه وعرضه أن يظن به ظنا سيئا ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ 24914 قال النبي :(@)(@@) | 30 ( لا إلاه إلا الله ، سيق من أرضه وسمائه حتى دفن في التربة التي منها خلق ) )(@)(@@) الحكيم عن أبي هريرة ، ( بز ك ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ 24915 قال النبي :(@)(@@) | 30 ( لا إلاه إلا الله ، سبحان الله ، هاذا العبد الصالح قد ضيق عليه قبره حتى خشيت أن لا يوسع عليه يعني سعد بن معاذ ) )(@)(@@) الحكيم عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ 24916 قال النبي :(@)(@@) | 30 ( لا إلاه إلا الله الحليم الكريم سبحان الله ، وتبارك الله رب العرش العظيم ، والحمد لله رب العالمين ) )(@)(@@) ( حم ) و ابن السني في عمل يوم وليلة ، ( حب ك هب ) عن علي رضي الله عنه قال : علمني رسول الله إذا نزل بي كرب أن أقول فذكره .(@)(@@)(@@)(@@) $ 24917 قال النبي :(@)(@@) | 30 ( لا إلاه إلا الله تدفع عن قائلها تسعة وتسعين بابا من البلاء ، أدناها الهم ) )(@)(@@) الديلمي عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ 24918 قال النبي :(@)(@@) | 30 ( لا إلاه إلا الله كلمة كريمة على الله ولها عند الله مكان ، جمعت وصول من قالها صادقا من قلبه دخل الجنة ، ومن قالها كاذبا حقنت دمه ، وأحرزت ماله ، ولقي الله عز وجل غدا محاسبه ) )(@)(@@) أبو نعيم عن عياض الأشعري رضي الله عنه .(@)(@@)(@@)(@@) $ 24919 قال النبي :(@)(@@) | 30 ( لا إلاه إلا الله نصف الميزان ، والحمد لله تملؤه ) )(@)(@@) الديلمي عن شداد بن أوس رضي الله عنه .(@)(@@)(@@)(@@) $ 24920 قال النبي :(@)(@@) | 30 ( لا إذن لك ولا كرامة ولا نعمة ، كذبت أي عدو الله ، لقد رزقك الله حلالا طيبا فاخترت ما حرم الله عليك من رزقه مكان ما أحل الله PageV08P134 لك من حلاله ، ولو كنت تقدمت إليك لفعلت بك وفعلت ، قم عني وتب إلى الله ، أما إنك إن نلت بعد التقدمة شيئا ضربتك ضربا وجيعا وحلقت رأسك مثله ، ونفيتك من أهلك ، وأحللت سلبك لفتيان المدينة ، هاؤلاء العصاة من مات منهم 
ms2664	 بغير توبة حشره الله يوم القيامة كما كان في الدنيا مخنثا عريانا لا يستتر عن الناس بهدمه كلما قام صرع ) )(@)(@@) ( ه طب ) عن صفوان بن أمية أن عمرو بن قرة قال : يا رسول الله كتبت علي الشقوة فلا أراني أرزق إلا من دفي بكفي فتأذن لي في الغناء من غير فاحشة قال فذكره ورواه الديلمي إلى قوله : قم عني وتب إلى الله ، وزاد : وأوسع على نفسك وعيالك حلالا فإن ذالك جهاد في سبيل الله ، واعلم أن عون الله مع صالحي التجار .(@)(@@)(@@)(@@) $ 24921 قال النبي :(@)(@@) | 30 ( لا أحد أن يسجد لأحد ، ولو أمرت أحدا أن يسجد لأحد لأمرت المرأة أن تسجد لزوجها ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ 24922 قال النبي :(@)(@@) | 30 ( لا أحب أن يعينني على وضوئي أحد ) )(@)(@@) البزار عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ 24923 قال النبي :(@)(@@) | 30 ( لا هل تستطيع إذا خرج المجاهد أن تدخل مسجدك فتقوم ولا تفتر ، وتصوم ولا تفطر ) )(@)(@@) ( خ ) عن أبي هريرة رضي الله عنه أن رجلا قال : يا رسول الله دلني على عمل يعدل الجهاد قال فذكره .(@)(@@)(@@)(@@) $ 24924 قال النبي :(@)(@@) | 30 ( لا أحد أغير من الله ، ولذالك حرم الفواحش ما ظهر منها وما بطن ) )(@)(@@) ( طب ) عن أسماء بنت أبي بكر رضي الله عنها .(@)(@@)(@@)(@@) $ 24925 قال النبي :(@)(@@) | 30 ( لا أحد أصبر على أذى يسمعه من الله ، إنه يشرك به ويجعل له ولدا وهو يعافيهم ويدفع عنهم ويرزقهم ) )(@)(@@) ( حم ) عن أبي موسى ا رضي الله عنه .(@)(@@) PageV08P135(@)(@@)(@@)(@@) $ 24926 قال النبي :(@)(@@) | 30 ( لا أحب العقوق ، من ولد له منكم مولود فأحب أن ينسك عنه فليفعل ، عن الغلام شاتان وعن الجارية شاة ) )(@)(@@) ( ك ) عن عمرو بن شعيب عن أبيه عن جده ، ( حم ) والبغوي ، ( هق ) عن رجل من بني ضمرة .(@)(@@)(@@)(@@) $ 24927 قال النبي :(@)(@@) | 30 ( لا أحلف على يمين فأرى غيرها خيرا منها إلا كفرت عن يميني ثم أتيت الذي هو خير ) )(@)(@@) ( ك ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ 24928 قال النبي :(@)(@@) | 30 ( لا أخاف على أمتي إلا ثلاث خلال : أن 
ms2665	 يكثر لهم من المال فيتحاسدون فيقتتلون ، وأن يفتح لهم الكتاب وأخذ المؤمن يبتغي تأويله وليس يعلم تأويله إلا الله ، وأن يروا إلى علمهم فيضيعوه ولا يبالون عليه ) )(@)(@@) ابن جرير ( طب ) عن أبي مالك الأشعري رضي الله عنه .(@)(@@)(@@)(@@) $ 24929 قال النبي :(@)(@@) | 30 ( لا أخاف على أمتي إلا اللبن ، فإن الشيطان بين الرغو والضرع ) )(@)(@@) ( حم ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ 24930 قال النبي :(@)(@@) | 30 ( لا أرضى لك إلا ما أرضى لنفسي ، إني لم أكسكها لتلبسيها ، إنما كسوتكها لتجعليها خمرا بين الفواطم ) )(@)(@@) ( طب ) عن أم هانىء رضي الله عنها .(@)(@@)(@@)(@@) $ 24931 قال النبي :(@)(@@) | 30 ( لا أزال بينكم تطؤون عقبي حتى يكون الله يرفعني ، لا ترفعوني فوق حقي فإن الله اتخذني عبدا قبل أن يتخذني نبيا ) )(@)(@@) ابن عساكر عن علي بن حسين وقال : مرسل حسن الإسناد .(@)(@@)(@@)(@@) $ 24932 قال النبي :(@)(@@) | 30 ( لا أزال بين أظهرهم يطؤون عقبي ، وينازعوني ردائي ، ويصيبني غبارهم حتى يكون الله تعالى هو الذي يريحني منهم ) )(@)(@@) ( طب ) عن العباس بن عبد المطلب رضي الله عنه .(@)(@@)(@@)(@@) $ 24933 قال النبي :(@)(@@) | 30 ( لا أزال أشفع وأشفع حتى أقول : يا رب شفعني PageV08P136 فيمن قال : لا إلاه إلا الله ، فيقال : ليست هاذه لك ولا لأحد ، هاذا لي ، فلا يبقى أحد قال : لا إلاه إلا الله إلا خرج منها ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ 24934 قال النبي :(@)(@@) | 30 ( لا إسلال ولا غلول ، ومن يغلل يأت بما غل يوم القيامة ) )(@)(@@) ( طب ) عن كثير بن عبد الله عن أبيه عن جده .(@)(@@)(@@)(@@) $ 24935 قال النبي :(@)(@@) | 30 ( لا أشهد ولا على رغيف محترق ) )(@)(@@) ابن النجار عن سهل بن سعد رضي الله عنه أن رجلا قال : يا رسول الله اشهد بغلامي هاذا لابني ، قال : ألكل ولدك جعلت مثله ؟ قال : لا ، قال فذكره .(@)(@@)(@@)(@@) $ 24936 قال النبي :(@)(@@) | 30 ( لا اعتكاف إلا في المسجد الحرام ، أو قال : في المساجد الثلاثة ) )(@)(@@) ( هق ) عن حذيفة رضي الله عنه .(@)(@@)(@@)(@@) $ 24937 قال النبي :(@)(@@) | 30 ( لا أعرفن أحدكم ، يأتي يوم القيامة يحمل شاة لها ثغاء ينادي يا محمد يا محمد 
ms2666	 فأقول لا أملك لك من الله شيئا قد بلغتك ، ولا أعرفن أحدكم ، يأتي يوم القيامة يحمل حملا له رغاء يقول : يا محمد يا محمد فأقول : لا أملك لك من الله شيئا قد بلغتك ، لا أعرفن أحدكم يأتي يوم القيامة يحمل فرسا له حمحمة ينادي : يا محمد يا محمد فأقول : لا أملك لك من الله شيئا قد بلغتك ، ولا أعرفن أحدكم ، يأتي يوم القيامة يحمل قسيا من آدم ينادي : يا محمد يا محمد فأقول : لا أملك لك من الله شيئا قد بلغتك ) )(@)(@@) ابن جرير عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ 24938 قال النبي :(@)(@@) | 30 ( لا أعرفن رجلا منكم علم علما فكتمه فرقا من الناس ) )(@)(@@) ابن عساكر عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ 24939 قال النبي :(@)(@@) | 30 ( لا أعرفن أحدا منكم أتاه الحديث عني وهو متكيء على أريكته يقول : أتلوا علي به قرآنا ، ما جاءكم عني من خير قلته أم لم أقله ، فإني PageV08P137 أقول ، وما أتاكم عني من شر فإني لا أقول الشر ) )(@)(@@) ( حم ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 24940 قال النبي :(@)(@@) | 30 ( لا أعرفنكم يا بني عبد مناف ما منعتم طائفا يطوف بهاذا البيت ساعة من ليل أو نهار ) )(@)(@@) عن جبير بن مطعم رضي الله عنه .(@)(@@)(@@)(@@) $ 24941 قال النبي :(@)(@@) | 30 ( لا أعطيكم وأدع أهل الصفة تطوى بطونهم من الجوع ) )(@)(@@) ( هب ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ 24942 قال النبي :(@)(@@) | 30 ( لا أقبل منك حتى تبايع على النصح لكل مسلم ) )(@)(@@) ( ط ص ) عن جرير رضي الله عنه .(@)(@@)(@@)(@@) $ 24943 قال النبي :(@)(@@) | 30 ( لا ألفين ما نوزعت أحدا منكم على الحوض فأقول إنه من أصحابي ، فيقال : إنك لا تدري ما أحدثوا بعدك ) )(@)(@@) ( طب كر ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ 24944 قال النبي :(@)(@@) | 30 ( لا ألفين أحدكم يضع إحدى رجليه على الأخرى يتغنى ويذر سورة البقرة يقرؤها فإن الشيطان يفر من البيت يقرأ فيه سورة البقرة ، وإن أصغر البيوت الجرد الصفر من كتاب الله عز وجل ) )(@)(@@) ( هب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ 24945 
ms2667	 قال النبي :(@)(@@) | 30 ( لا أمثل به فيمثل الله تعالى بي يوم القيامة ) )(@)(@@) ابن النجار عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ 24946 قال النبي :(@)(@@) | 30 ( لا إيمان لمن لا أمانة له ، والمعتدي في الصدقة كمانعها ) )(@)(@@) ابن خزيمة ( عد هق ) عن أنس ، ( طب ) عن عبادة بن الصامت رضي الله عنه .(@)(@@)(@@)(@@) $ 24947 قال النبي :(@)(@@) | 30 ( لا إيمان لمن لا أمانة له ، والذي نفسي بيده لا تدخلوا الجنة حتى تؤمنوا ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@) PageV08P138(@)(@@)(@@)(@@) $ 24948 قال النبي :(@)(@@) | 30 ( لا إيمان لمن لا أمانة له ، ولا دين لمن لا عهد له ، والذي نفس محمد بيده ، لا يستقيم دين عبد حتى يستقيم لسانه ، ولا يستقيم لسانه حتى يستقيم قلبه ، ولا يدخل الجنة من لا يأمن جاره بوائقه ، قيل : يا رسول الله ما البوائق ؟ قال : غشمه وظلمه ، وأيما رجل أصاب مالا من غير حله وأنفق منه لم يبارك له فيه ، وإن تصدق لم تقبل منه ، وما بقي قراره إلا النار ، إن الخبيث لا يكفره الخبيث ، ولاكن الطيب يكفر الخبيث ) )(@)(@@) ( طب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ 24949 قال النبي :(@)(@@) | 30 ( لا إيمان لمن لا أمانة له ، ولا صلاة لمن لا وضوء له ) )(@)(@@) ( هب ) عن ثوبان رضي الله عنه .(@)(@@)(@@)(@@) ||| ( اللام ألف مع الباء(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ 24950 قال النبي :(@)(@@) | 30 ( لا بأس بالحديث قدمت فيه أو أخرت إذا أصبت معناه ) )(@)(@@) الحكيم عن واثلة رضي الله عنه .(@)(@@)(@@)(@@) $ 24951 قال النبي :(@)(@@) | 30 ( لا بأس بالحيوان واحد باثنين يدا بيد ) )(@)(@@) ( حم ه ت ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ 24952 قال النبي :(@)(@@) | 30 ( لا بأس بالغنى لمن اتقى ، والصحة لمن اتقى خير من الغنى ، وطيب النفس من النعيم ) )(@)(@@) ( حم ه ك ) عن يسار بن عبيد رضي الله عنه .(@)(@@)(@@)(@@) $ 24953 قال النبي :(@)(@@) | 30 ( لا بأس بالقمح بالشعير ، اثنين بواحد ، يدا بيد ) )(@)(@@) ( طب ) عن عبادة رضي الله عنه .(@)(@@) PageV08P139(@)(@@)(@@)(@@) $ 24954 قال النبي :(@)(@@) | 30 ( لا بأس ولينصر الرجل أخاه ظالما أو مظلوما ، إن كان ظالما فلينهه فإنه له نصر ، وإن كان مظلوما فلينصره 
ms2668	 ) )(@)(@@) ( م ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 24955 قال النبي :(@)(@@) | 30 ( لا بد من العريف ، والعريف في النار ) )(@)(@@) ابن نعيم في المعرفة عن جعونة بن زياد رضي الله عنه .(@)(@@)(@@)(@@) $ 24956 قال النبي :(@)(@@) | 30 ( لا بر أن يصام في السفر ) )(@)(@@) ( طب ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ 24957 قال النبي :(@)(@@) | 30 ( لا بأس إنما هو جذبة منك ) )(@)(@@) عبد الرزاق ( طب ) عن أبي أمامة رضي الله عنه أن رجلا قال : يا رسول الله مسست ذكري وأنا أصلي قال فذكره .(@)(@@)(@@)(@@) $ 24958 ق ال النبي :(@)(@@) | 30 ( لا بأس به إنه لبعض جسدك ) )(@)(@@) ( حب ) عن طلق رضي الله عنه .(@)(@@)(@@)(@@) $ 24959 قال النبي :(@)(@@) | 30 ( لا بأس ريحانة يشمها ) )(@)(@@) الحاكم في الكنى ا عن أنس رضي الله عنه سئل النبي عن رجل يقبل امرأته في رمضان قال فذكره .(@)(@@)(@@)(@@) $ 24960 قال النبي :(@)(@@) | 30 ( لا بأس بصيد البحر ) )(@)(@@) ابن مردويه عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 24961 قال النبي :(@)(@@) | 30 ( لا بأس ببيع خدمة المدبر إذا احتاج إليه ) )(@)(@@) ( قط هق ) وضعفه عن جابر رضي الله عنه ، وصححه ابن القطان .(@)(@@)(@@)(@@) $ 24962 قال النبي :(@)(@@) | 30 ( لا بأس زدت أو نقصت ، إذا لم تحل حراما أو تحرم حلالا وأصبت المعنى ) )(@)(@@) عبد الرزاق وأبو موسى ا عن محمد بن إسحاق بن سليمان بن PageV08P140 أكيمة الليثي عن أبيه عن جده أن أكيمة قال : يا رسول الله إنا لنسمع منك الحديث ولا نقدر على تأديته قال فذكره .(@)(@@)(@@)(@@) $ 24963 قال النبي :(@)(@@) | 30 ( لا بأس أن يقلب الرجل الجارية إذا أراد أن يشتريها وينظر إليها ما خلا عورتها ما بين ركبتيها إلى مقعد إزارها ) )(@)(@@) ( طب عد هق ) وضعفه عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ 24964 قال النبي :(@)(@@) | 30 ( لا بأس بالبر بالشعير يدا بيد والشعير أفضل ولا يصلح نسيئة ) )(@)(@@) ( طب ) عن عبادة بن الصامت رضي الله عنه .(@)(@@)(@@)(@@) $ 24965 قال النبي :(@)(@@) | 30 ( لا بأس هو صيد البحر يعني الجراد ) )(@)(@@) ( حل ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 24966 قال النبي :(@)(@@) | 30 ( لا بأس بمسك جلد 
ms2669	 الميتة إذا دبغ ) )(@)(@@) ( طب ) عن أم سلمة رضي الله عنها .(@)(@@)(@@)(@@) $ 24967 قال النبي :(@)(@@) | 30 ( لا بأس عليك إنما رزق ساقه الله إليك ، فأتمي صومك ) )(@)(@@) ( طب ) عن أم إسحاق الغنوية قالت : كنت صائمة فنسيت فأكلت ، فقال رسول الله فذكره .(@)(@@)(@@)(@@) $ 24968 قال النبي :(@)(@@) | 30 ( لا بأس أن تأخذهما بسعر يومهما ما لم تتفرقا وبينكما شيء ) )(@)(@@) ( ك هق ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ 24969 قال النبي :(@)(@@) | 30 ( لا بأس بألبان الأتن ) )(@)(@@) ( عد هق ) عن رجل .(@)(@@)(@@)(@@) $ 24970 قال النبي :(@)(@@) | 30 ( لا بأس باسبال الإزار إلى نصف الساق أو الكعبين ، فإنه كان فيمن قبلكم رجل خرج وعليه بردان يتبختر فيهما ، فنظر الله إليه من فوق عرشه فمقته وأمر الأرض فأخذته فهو يتجلجل فيما بين الأرضين فاحذروا وقائع الله عز وجل ) )(@)(@@) ابن لال عن جابر بن سليم بن حرى التميمي رضي الله عنه .(@)(@@)(@@)(@@) $ 24971 قال النبي :(@)(@@) | 30 ( لا بأس بتعليق التعويذ من القرآن قبل نزول البلاء PageV08P141 وبعد نزول البلاء ) )(@)(@@) أبو نعيم عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ 24972 قال النبي :(@)(@@) | 30 ( لا بر أفضل من بر أهل القبور ، ولا يصل أهل القبور إلا مؤمن ) )(@)(@@) الديلمي عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ 24973 قال النبي :(@)(@@) | 30 ( لا بأس ببول ما أكل لحمه ) )(@)(@@) ( قط ) وضعفه عن البراء رضي الله عنه .(@)(@@)(@@)(@@) $ 24974 قال النبي :(@)(@@) | 30 ( لا بأس ببول الحمار وكل ما أكل لحمه ) )(@)(@@) الخطيب عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ 24975 قال النبي :(@)(@@) | 30 ( لا بد للناس من إمارة برة أو فاجرة ، فأما البرة فتعدل في القسم وتقسم بينكم فيئكم بالسوية ، وأما الفاجرة فيبتلى فيها المؤمن ، والإمارة الفاجرة خير من الهرج ، قيل : يا رسول الله وما الهرج ؟ قال : القتل والكذب ) )(@)(@@) ( طب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ 24976 قال النبي :(@)(@@) | 30 ( لا بد من خسف ومسخ ورجف ، قالوا : يا رسول الله في هاذه الأمة ؟ قال : نعم ، إذا أخذوا القيان ، واستحلوا الزنا ، وأكلوا الربا ، واستحلوا الصيد في الحرم ، ولبس الحرير ، واكتفى الرجال بالرجال ، والنساء بالنساء ) )(@)(@@) ابن النجار عن ابن عمر رضي الله 
