ms121	 ما لم تبنه % % وأباحت الأيام ما لم تحمه % % 22(@)(@@) % ولرب مشعلة السيوف طمستها % % قدما كما فعل الصباح بنجمه % % 23(@)(@@) % تأوي النجوم الزهر في شرفاته % % ويزل عن علياه معقل عصمه % % 24(@)(@@) % بردت أحشاء الهدى بضرامه % % وبنيت أركان العلا من هدمه % % 25(@)(@@) % فاسعد بعيد أنتم أعياده % % وسني مفخره وأنفس قسمه % % 26(@)(@@) % بأعز يوم في الدنا وأجله % % وأخص صنع في المنى وأعمه % % PageV01P372 البحر : كامل تام 1(@)(@@) % أعيا شفاء الهم إن لم تشفه % % وعتا ملم الخطب إن لم تكفه % % 2(@)(@@) % وبك استبان الصبح طارق ليله % % والتذ طعم الأمن خائف حتفه % % 3(@)(@@) % ولرب خطب لم تضق ذرعا به % % ويضيق ذرع الواصفين بوصفه % % 4(@)(@@) % لم تلقك الضراء نابي حده % % كلا ولا السراء ثاني عطفه % % 5(@)(@@) % نعم المقدر للأمور برفقه % % ركب الزمان وما اشتكى من عنفه % % 6(@)(@@) % رحبت حدائقه لمرتع مخصب % % وصفت مشاربه لمورد مرفه % % 7(@)(@@) % مستكمل الإنعام قبل أوانه % % مثل الهلال تمامه في نصفه % % 8(@)(@@) % مغرى اليدين بضعف ما رجت المنى % % بدءا وأجدر أن يعود بضعفه % % 9(@)(@@) % ومسربل من حلمه وذكائه % % حللا مطرزة ببارع ظرفه % % 10(@)(@@) % شيم سقاني صفوها فسقيته % % ما شاء من صفو الوداد وصرفه % % PageV01P373 11(@)(@@) % فتركت صدر المجد لابس عقده % % مني وجيد الجود مسبل شنفه % % 12(@)(@@) % والأرض آذنة لصوت ثنائها % % من هاتف تصغي البلاد لهتفه % % 13(@)(@@) % فليأتينك شكر من لم توله % % عني وصفو ثناء من لو تصفه % % 14(@)(@@) % من كل موصول الغرام بقلبه % % أسفا لبعدي والسهاد بطرفه % % 15(@)(@@) % ومغرب تبكي السماء لشجوه % % مني وتلتهف النجوم للهفه % % 16(@)(@@) % لولا قضاء فراقه وطلبته % % في غير جفني ماثلا لم تلفه % % 17(@)(@@) % أبني لاح الفجر إذ بلغ الدجى % % أمدا فسل الهم إن لم تشفه % % 18(@)(@@) % وتركت غول البر معدم أنسه % % مني وهول البحر فاقد إلفه % % 19(@)(@@) % هذا على خفق الشراع وقلسه % % حرم وذاك على البعير وخفه % % 20(@)(@@) % وقصرت ليلي بالسرور منفسا % % من طول ليل الناجيات وعسفه % % PageV01P374 21(@)(@@) % بالحاجب الأعلى المجير لهمتي % % حتى أجرت من الزمان وصرفه % % 22(@)(@@) % ملك يلاقي العلم راضي سعيه % % فيرد عنه الجهل راغم أنفه % % 23 
ms122	(@)(@@) % وإذا تألق بارق من سيفه % % في الروع أشفقت الربى من خطفه % % 24(@)(@@) % أو لاح في رهج شهاب سنانه % % نذرت شياطين الضلال بقذفه % % 25(@)(@@) % قاد الجياد إلى الجهاد وحفني % % بندى يديه تحت ظلي سجفه % % 26(@)(@@) % بوزيره الغادي إلي ببره % % وأمينه الحاني علي بعطفه % % 27(@)(@@) % أظلمت فاستوقدت نور جبينه % % وظمئت فاستسقيت وابل كفه % % 28(@)(@@) % وبه جزيت النائبات بصاعها % % صاعا وسمت الدهر خطة خسفه % % 29(@)(@@) % فإذا أحل ففي مضاعف بره % % أو أستقل ففي مضاعف زغفه % % 30(@)(@@) % وليعلم الأقران حين تدب لي % % تحت الوغى أني لحقت بصفه % % PageV01P375 31(@)(@@) % ولئن نهدت إليهم فبسيفه % % ولئن كررت عليهم فبطرفه % % 32(@)(@@) % كرما بفطرة همة وسيادة % % أغليت في تبر الثناء بصرفه % % 33(@)(@@) % وندى هديت المنعمين سبيله % % سبقا وأقرأت الكرام بحرفه % % 34(@)(@@) % فاسمع فقد أهديتها لك غادة % % تلهيك عن لثم الحبيب ورشفه % % 35(@)(@@) % جاءتك تزجر طير واجب مهرها % % في نسبة لك كرمت عن خلفه % % 36(@)(@@) % أنست ببرء الهم في اسمك بعدما % % كسفت سنا بدري دياجي كفه % % 37(@)(@@) % بكرا تحلت جوهر الشكر الذي % % أنت الوفي بحقه فاستوفه % % 38(@)(@@) % فلينجمن على النجوم بحسنه % % وليعرفن الجو نفحة عرفه % % 39(@)(@@) % وليزهين على الغمام نفاسة % % من صاد مثلي في حبائل عرفه % % PageV01P376 البحر : طويل 1(@)(@@) % سلام على مستودع الروح والنفس % % وذخر غدي مما انتحبت له أمس % % 2(@)(@@) % بحيث تخطيت المنايا إلى المنى % % وآنس وحشي بالفلا كرم الأنس % % 3(@)(@@) % وحيث اعتلى بالمعتلي صوت رائدي % % مهلا إلى خمسي بأنمله الخمس % % 4(@)(@@) % وحيث سقى يحيى حياتي فأينعت % % له من ثنائي زهرة الجن والإنس % % 5(@)(@@) % فمن يد أنفاسي إلى منتهى الدنا % % ومن خط أقلامي إلى مطلع الشمس % % 6(@)(@@) % شوارد لولا حلم يحيى دنا بها % % لجلت أدانيها عن الشم واللمس % % 7(@)(@@) % فكيف بأن أزري بها فأبيعها % % كما زعم الواشون بالثمن البخس % % 8(@)(@@) % وكم فتقت في الأرض من وقر مسمع % % وكم أنطقت بالحمد من ألسن خرس % % 9(@)(@@) % ثناء على من رد روحي روحه % % وقرب أنفاس الحياة من النفس % % 10(@)(@@) % فهل أنا مسد لبس هجوي لمنعم % % كساني فسدى من هجاء اسمه لبسي % % PageV01P377 11 
ms123	(@)(@@) % فأصبحت منه في حلى لو أفكتها % % لطفت بها في الأرض تنضح بالرجس % % 12(@)(@@) % وهل أنا عني خالع تاج عرفه % % فأهوي به في هوة الخسف والنكس % % 13(@)(@@) % كأني قد أنهجت لبسي من الهدى % % وأصبحت من منهاج جدك في لبس % % 14(@)(@@) % وأنكرت حق الله فيكم مودة % % على كل من أمسى على الأرض أو يمسي % % 15(@)(@@) % وحطي رحلي منك بين مكارم % % يمزقن عني راكد الظلم الطمس % % 16(@)(@@) % وبحرك لي يختال بالخيل والمها % % وبرك لي ينهل بالبر والأنس % % 17(@)(@@) % فمن ذا الذي من بعد أرضي ومشهدي % % تخبطه شيطان ضغني من المس % % 18(@)(@@) % فدب بما لو سامني الخوف ذكره % % لما جال في وهمي ولا دب من حسي % % 19(@)(@@) % ولو رد في الروح من قتل قاتل % % لما بات من ذمي وعتبي على وجس % % 20(@)(@@) % وكيف بكفري من هدى وابن من هدى % % أبوك ويمناك التي أثمرت غرسي % % PageV01P378 21(@)(@@) % وهبني ذممت العالمين فكيف لي % % بذمي من أودعت راحته نفسي % % 22(@)(@@) % وإن اختلاق الغدر عني لحاسد % % لأدنى له أن يصبغ الشمس بالنقس % % 23(@)(@@) % وإن أخا غسان عندي لذو يد % % بك ابتاع مني شكرها غير ذي وكس % % 24(@)(@@) % غداة تجلى لي بذكرك فاجتلى % % عروس ثنائي فيك مشهودة العرس % % 25(@)(@@) % فلم يلف صدري خامدا نار شوقه % % إليك ولكن ضم قبسا إلى قبس % % 26(@)(@@) % ولا زادني في حفظ عهدك بسطة % % سوى أن حفظ العلم أثبت بالدرس % % 27(@)(@@) % وطيب حديثي عنك صادف مصغيا % % لأفصح مقتص وأربح مقتس % % 28(@)(@@) % فراسل نشري عنك شدوا بشدوه % % ونادم حمدي فيك كأسا إلى كأس % % 29(@)(@@) % أياديك في أولى الزمان وإنها % % لأدنى إلى ذكري ونشري من أمسي % % 30(@)(@@) % ليالي في مأواك أمني من الردى % % وفي ظلك الممدود نشري من الرمس % % PageV01P379 31(@)(@@) % ومضجع طيب النوم في أمد السرى % % ومشرب عذب الماء في منتهى الخمس % % 32(@)(@@) % فلا زال دين الله منك بمعقل % % منيع وسمك الحق منك على أس % % 33(@)(@@) % ولا رمت الأقدار عنك معاندا % % بأفوق مفلول الغرار ولا نكس % % 34(@)(@@) % ولا مات من والاك من غربة النوى % % ولا عاش من عاداك 
ms124	 من عثرة التعس % % PageV01P380 البحر : كامل تام 1(@)(@@) % نور الوفاء بأرضنا لك ساطع % % والحق شمل عندنا بك جامع % % 2(@)(@@) % هديت إلى المنصور دعوتك التي % % صدق الوداد بها إليه شافع % % 3(@)(@@) % وأواصر نزعت بهن عناصر % % حنت وهن لشكلهن نوازع % % 4(@)(@@) % تلك المعاهد من عهودك عنده % % لم يعفهن مصائف ومرابع % % 5(@)(@@) % صدقت فلا برق المودة خلب % % منها ولا غيم القرابة خادع % % 6(@)(@@) % بوسائل هتفت بهن جوانح % % فتفرجت لقبولهن أضالع % % 7(@)(@@) % فهي الظماء إلى المياه شوارع % % وهي الطيور إلى الوكور قواطع % % 8(@)(@@) % طويت لها بعد التنائف وانزوى % % لدنوها منه الفضاء الواسع % % 9(@)(@@) % وقد حن بالمرخ العفار فأقلعا % % والليل بينهما نهار ساطع % % 10(@)(@@) % وزرعن في الترب الكريم مكارما % % أو فت لحاسدها بما هو زارع % % PageV01P381 11(@)(@@) % نادى المنادي من مناد مسمعا % % فأجابه لتجيب رأي سامع % % 12(@)(@@) % بشوابك الرحم الموصلة التي % % وصل الوصول بها وجب القاطع % % 13(@)(@@) % أشرقن والأيام ليل دامس % % وحلون والأنساب سم ناقع % % 14(@)(@@) % برعاية لا هدي هود غائب % % عنها ولا إيصاء يعرب ضائع % % 15(@)(@@) % ودنوها دين لكم وفرائض % % وسناؤها سنن لكم وشرائع % % 16(@)(@@) % فإذا تثوب فالقلوب نواظر % % وإذا تنادي فالنفوس سوامع % % 17(@)(@@) % بعواطف اليمن التي أنتم لها % % وهي اليمين أنامل وأصابع % % 18(@)(@@) % جمعتكم ببطونهن حوامل % % وغذتكم بثديهن مراضع % % 19(@)(@@) % ونحورها مأوى لك ومعايش % % وجحورها مثوى لكم ومضاجع % % 20(@)(@@) % فتبعتم آثار ما نهجت لكم % % في النضر أذواء لكم وتبابع % % PageV01P382 21(@)(@@) % قهروا الجبابر فالرقاب مقاطع % % لسيوفهم أو فالرقاب خواضع % % 22(@)(@@) % وسروا إلى داعي الهوى فمصدق % % ومسابق ومبادر ومبايع % % 23(@)(@@) % الناصرين الناصحين فما لهم % % في غير ما يرضي الإله موازع % % 24(@)(@@) % ما أشرعت في الناكثين رماحهم % % إلا وباب النصر منها شارع % % 25(@)(@@) % وإذا سيوفهم لمعن لوقعة % % جلل فوجه الفتح فيها لامع % % 26(@)(@@) % لم يرفعوا راياتهم إلا علت % % والحق مرفوع بهن ورافع % % 27(@)(@@) % فالدين أعلام لهم ومعالم % % والكفر أشلاء لهم ومصارع % % 28(@)(@@) % أبني مناد إن تنادوا للندى % % أو للطعان فمسرع ومسارع % % 29(@)(@@) % أو تغضبوا فمعارك ومهالك % % أو ترتضوا فقطائع وصنائع % % 30(@)(@@) % أو تركبوا فمناظر ومخابر % % أو تنزلوا فمشاهد 
ms125	 ومجامع % % PageV01P383 31(@)(@@) % الشام شامكم ومصر مصركم % % والمغربان لكم حمى ومراتع % % 32(@)(@@) % والمشرق الأعلى أبو الحكم الذي % % ناديتم فالدهر عبد طائع % % 33(@)(@@) % أصفى الملوك فناصر أو واصل % % وصفا الأنام فعائذ أو خاضع % % 34(@)(@@) % لم يطلع البدر المنير ببلدة % % إلا لكم فيها هلال طالع % % 35(@)(@@) % ولكم بدار الملك من سرقسطة % % قلم لأقلام البرية فارع % % 36(@)(@@) % بمفاخر من منذر ومآثر % % نظمت بمنطقه فهن شوائع % % 37(@)(@@) % وبها له في المغربين مغارب % % ولذكره في المشرقين مطالع % % 38(@)(@@) % سكنت بها الآفاق وهي غرائب % % واستأنست بالعلم وهي بدائع % % 39(@)(@@) % فالجو من فحواه مسك فائح % % والأرض من يمناه روض يانع % % 40(@)(@@) % من بعدما ولدته من صنهاجة % % شيم إلى ملك الملوك شوافع % % PageV01P384 41(@)(@@) % ومناقب ومناصب وضرائب % % وصوائب وثواقب ولوامع % % 42(@)(@@) % فيها يسابق نحوها ويشايع % % وبها إلى يمنى يديه ينازع % % 43(@)(@@) % إن تشرق الدنيا ببارع ذكره % % فمحله عند ابن يحيى بارع % % 44(@)(@@) % مستودعا لكم مليكا نفسه % % وحياته في راحتيه ودائع % % 45(@)(@@) % فاسعد أبا مسعود بالهمم التي % % عليت فهن إلى النجوم نوازع % % 46(@)(@@) % إن كان سيبك للحقوق مؤديا % % فينا فسيفك للحقائق مانع % % 47(@)(@@) % بحقائق تجلو الخطوب كأنما % % ريب الزمان لهاكمي دارع % % 48(@)(@@) % ومواهب فيما حويت كأنها % % فيمن غزوت ملاحم ووقائع % % 49(@)(@@) % وعليك من نفسي سلام طيب % % مترادف متواصل متتابع % % 50(@)(@@) % الغاديات به إليك نوافح % % والطارقات به عليك ضوائع % % PageV01P385 البحر : بسيط تام 1(@)(@@) % ما أحسن الصبر فيما يحسن الجزع % % وأوجد اليأس ما قد أعدم الطمع % % 2(@)(@@) % وللمنايا سهام غير طائشة % % وذو النهى بجميل الصبر مدرع % % 3(@)(@@) % فإن خلت للأسى في شجوها سنن % % فطالما أحمدت في كظمها البدع % % 4(@)(@@) % وللفجائع أقدار وأفجعها % % للنفس حيث ترى أظفارها تقع % % 5(@)(@@) % كأن للموت فينا ثأر محتكم % % فما بغير الكريم الحر يقتنع % % 6(@)(@@) % قد خبرت نفس إسماعيل في يده % % أن ليس عن حرمات المجد يرتدع % % 7(@)(@@) % فاحتسبوا آل اسماعيل ما احتسبت % % شم الربى من غمام الغيث ينقشع % % 8(@)(@@) % واحتسبوا آلا إسماعيل ما احتسبت % % خيل الوغى من لواء الجيش ينصرع % % 9(@)(@@) % ماذا إلى مصر من بر ومن كرم 
ms126	 % % بعثتم مع وفد الله إذ رجعوا % % 10(@)(@@) % حجوا به بهلال الفطر وانقلبوا % % فاستودعوه ثرى مصر وما ربعوا % % PageV01P386 11(@)(@@) % فأي قدر رفيع حان محله % % في النعش يوما على أكتافهم رفعوا % % 12(@)(@@) % وأي مختشع لله متضع % % حر الشمائل في حر الثرى وضعوا % % 13(@)(@@) % وغادروه ولا عذر بما فعلوا % % وودعوه ولا باك لمن ودعوا % % 14(@)(@@) % تغدو عليه حمام الأيك باكية % % وتستهل على أكنافه القلع % % 15(@)(@@) % والريح تهدي له من كل عارفة % % عرفا وتحمل عنه فوق ما تدع % % 16(@)(@@) % فاستشعروا آل إسماعيل تعزية % % يهدى لها واعظ منكم ومستمع % % 17(@)(@@) % فإن غدا شعبكم في الله مفترقا % % فإن شعبكم في المجد مجتمع % % 18(@)(@@) % وإن يصدع قلوبا صدع شملكم % % فالصبر كالشمس حيث الفجر ينصدع % % 19(@)(@@) % وإن جزعتم فرزء لا يقوم له % % فيض الدموع ولا يشفى له وجع % % 20(@)(@@) % وإن صبرتم فمن قوم إذا بعثوا % % لم يوه عزمهم ذعر ولا فزع % % PageV01P387 21(@)(@@) % قد وطنوا أنفسا للدهر ليس لها % % إلا من الذم أن يدنو لها جزع % % 22(@)(@@) % كأنهم في نعيم العيش ما نعموا % % وفي الفجائع بالأحباب ما فجعوا % % 23(@)(@@) % لله من حرم الأموال ما بذلوا % % جودا ومن حرم الجيران ما منعوا % % 24(@)(@@) % وما كسوكم من المجد الذي لبسوا % % واستحفظوكم من الصبر الذي شرعوا % % 25(@)(@@) % فاربط لها يا أبا مروان جأش فتى % % سما فأتبع حتى عاد يتبع % % 26(@)(@@) % وقد عضضت على ناب البزول فلا % % يغنيك حسن العزاء الأزلم الجذع % % 27(@)(@@) % دهر شجاك وقد وفاك تعزية % % جلت فليست بغير القلب تستمع % % 28(@)(@@) % بشرى لمن زود التقوى لمنقلب % % حياه مدخر فيه ومطلع % % 29(@)(@@) % بميتة في سبيل الله أسلمه % % فيها إلى ربه الأبناء والشيع % % 30(@)(@@) % في حجة برها في الله متصل % % بالمحرمين عن الأوطان منقطع % % PageV01P388 31(@)(@@) % لبى من الغاية القصوى فجاوبه % % حور الخيام إلى لقياه تطلع % % 32(@)(@@) % واستفتح الكعبة العياء فافتتحت % % له إلى الجنة الأبواب والشرع % % 33(@)(@@) % فكيف توحشك الدنيا إلى شيم % % لذكرها في الورى مرأى ومستمع % % 34(@)(@@) % تتلى فيعبق منها كل ذي تفل % % ويعذب منها الصاب والسلع % % 35(@)(@@) % قد حملت ألسن المثنين 
ms127	 ما حملت % % وأوسعت أيدي العافين ما تسع % % 36(@)(@@) % كالغيث ينأى وما يخفى له أثر % % والمسك يوعى وما يوعى له فنع % % 37(@)(@@) % لطيب الذكر من حلم ومن ورع % % لو كان للموت حلم عنه أو ورع % % 38(@)(@@) % ومانع الجار من ضيم ومن عدم % % لو أنه من حمام الحين يمتنع % % 39(@)(@@) % ووازع الخطب عن قرب وعن بعد % % لو أن صرف الرى من بعض ما يزع % % 40(@)(@@) % وإن أقمت أبا مروان سنتها % % شجوا فذو اللب في السلوان يبتدع % % PageV01P389 41(@)(@@) % فاردد زفيرك عما لا مرد له % % وارجع دموعك عمن ليس يرتجع % % 42(@)(@@) % واستخلف العارض المنهل يخلفه % % روض تصيف به مصر وترتبع % % 43(@)(@@) % من كل بحرية شام يشام بها % % حادي الجنوب فلا ريث ولا سرع % % 44(@)(@@) % ينوب عن ضرم الأحشاء بارقها % % وعن دموعك فيها الوابل الهمع % % 45(@)(@@) % تزور في مصر قبرا قل زائره % % لكنه للعلا والمجد مضطجع % % 46(@)(@@) % وأكرم الغيث غيث عاد منتجعا % % لأمن لم يزل للندى والجود ينتجع % % PageV01P390 البحر : وافر تام 1(@)(@@) % بحكم العدل من قاضي السماء % % حباك بحق أحكام القضاء % % 2(@)(@@) % وراثة مورث الأبناء مما % % تحلى من تراث الأنبياء % % 3(@)(@@) % أب وفاك ميراث المساعي % % كما وفيته عهدا لوفاء % % 4(@)(@@) % تهدى فارتدى حلما وعلما % % فلم تسبق إلى ذاك الرداء % % 5(@)(@@) % لتلبسه فإفضال وفضل % % وتنشره بهدي واهتداء % % 6(@)(@@) % نماك وقد بنى دينا ودنيا % % لتخلفه على ذاك البناء % % 7(@)(@@) % وشيده بإخلاص الأماني % % وأسسه بمقبول الدعاء % % 8(@)(@@) % عليما أن أرفع ما بناه % % بناء أسه لك في السماء % % 9(@)(@@) % وأزكى من زكا صدقا وعدلا % % زكي حاز ميراث الزكاء % % 10(@)(@@) % فما زك ذو الجلال بعلم غيب % % وفرك ذو الرياسة عن ذكاء % % PageV01P391 11(@)(@@) % مليك كلما بلغ انتهاء % % من العليا أهل إلى ابتداء % % 12(@)(@@) % فسودده كجود يديه جار % % من الدنيا إلى غير انتهاء % % 13(@)(@@) % تجلى في بهاء ندى وعدل % % ومد عليك من ذاك البهاء % % 14(@)(@@) % رجاء فيك صدق كي يجازى % % كما استدعاك تصديق الرجاء % % 15(@)(@@) % وجزلا من عطاء الله أعدى % % يديك به جزيلات العطاء % % 16(@)(@@) % لتصرف دعوة المظلوم عنه % % كما صرف السوام 
ms128	 إلى الرعاء % % 17(@)(@@) % وترعى موقف الملهوف عنه % % يلبي نفسه قبل النداء % % 18(@)(@@) % وتبسط منك للغرباء وجها % % يجلي عنهم كرب الجلاء % % 19(@)(@@) % فتبلي فيهم سير ابن يحيى % % كما أبلاك محمود البلاء % % 20(@)(@@) % فأعطى القوس باريها وشدت % % عراقي الدلو في كرب الرشاء % % PageV01P392 21(@)(@@) % ورد الروح في جسم المعالي % % ولاح النجم في أفق السماء % % 22(@)(@@) % وجرد للهدى سيف صقيل % % محلى بالمحامد والثناء % % 23(@)(@@) % فولى النكر مهزوم النواحي % % وجاء العرف منشور اللواء % % 24(@)(@@) % وغار الظلم في ظلم الدياجي % % ولاح العدل في حلل الضياء % % 25(@)(@@) % بيمن ألبس الأيام نورا % % يديل من الشدائد بالرخاء % % 26(@)(@@) % وأحكاما بثثن العدل حتى % % تقاسمها الأباعد بالسواء % % 27(@)(@@) % وأخلاقا خلقن من التمني % % فلاقت كل هم بالشفاء % % 28(@)(@@) % فهن الماء في صفو ولين % % وسوغ وهي نار في الذكاء % % 29(@)(@@) % فما بالنفس عنها من تناه % % ولا بالسر عنها من خفاء % % 30(@)(@@) % فكم جليت من نظر جلي % % قرأت به أساطير الدهاء % % PageV01P393 31(@)(@@) % وكم أوريت من زند ثقوب % % أراك سراجه عيب الرياء % % 32(@)(@@) % وكم أحييت من ناء غريب % % فقيد الأهل منبت الإخاء % % 33(@)(@@) % وكم نفست كربة مستكن % % تأخر عنه نصر الأولياء % % 34(@)(@@) % وكم جليت من خطب جليل % % وكم داويت من داء عياء % % 35(@)(@@) % ولا كبني سبيل شردتهم % % عن الأوطان قاضية القضاء % % 36(@)(@@) % عواصف فتنة غمت بغيم % % بوارقه سيوف الإعتداء % % 37(@)(@@) % فأصقعهم براعدة المنايا % % وأمطرهم شآبيب الفناء % % 38(@)(@@) % وطاف عليهم طوفان روع % % أفاض بهم إلى القفر الفضاء % % 39(@)(@@) % سهام نوى إلى بر وبحر % % وأغراض لنشاب البلاء % % 40(@)(@@) % سروا فشروا بأفياء ضواف % % فيافي لا يقين من الضحاء % % PageV01P394 41(@)(@@) % وحمر الموت من خضر المغاني % % وسود البيد من بيض الملاء % % 42(@)(@@) % ومن كلل الستور كلال خوص % % وعدنهم النجاة على النجاء % % 43(@)(@@) % وقد جدعت أنوف العز منهم % % خطوب سمنهم أنف الإباء % % 44(@)(@@) % وألبسهم ثياب الذل خطب % % يليهم في ثياب الكبرياء % % 45(@)(@@) % وألحقهم بلج البحر سيل % % يمد مدوده فيض الدماء % % 46(@)(@@) % فوشكا ما هوى بهم هواء % % تألفهم بأفئدة هواء % % 47(@)(@@) % وحال الموج دون بني سبيل % % يطير بهم إلى الغول ابن ماء 
ms129	 % % 48(@)(@@) % أغر له جناح من صباح % % يرفرف فوق جنح من مساء % % 49(@)(@@) % يذكرهم زفيف الريح فيه % % تناوحها بربعهم الخلاء % % 50(@)(@@) % ومحو الماء ما يختط فيه % % ديارا خلفوها للعفاء % % PageV01P395 51(@)(@@) % وصك الموج فيها كل وجه % % وجوها ساورتهم بالجفاء % % 52(@)(@@) % وعدمهم صفاء الماء منه % % بعدمهم لإخوان الصفاء % % 53(@)(@@) % بحيث تبدلوا باللهو هولا % % ورحب الماء من رحب الفناء % % 54(@)(@@) % ومن قصف وراح قصف ريح % % ومن لعب الهوى لعب الهواء % % 55(@)(@@) % كأن البر والبحر استطارا % % تجارا همهم بعد الثناء % % 56(@)(@@) % يبيعون الرغائب بيع بخس % % ويشرون المصائب بالغلاء % % 57(@)(@@) % ولكن البضائع من هموم % % علت بالربح فيهم والنماء % % 58(@)(@@) % فكم طلبوا الأماني بالأماني % % وكم باعوا السعادة بالشقاء % % 59(@)(@@) % وكم فاضت مدامعهم فمدت % % عباب البحر بالماء الرواء % % 60(@)(@@) % وقد وفدت جوانحهم بشجو % % ينادي الشمس حي على الصلاء % % PageV01P396 61(@)(@@) % وكم خاضوا كهمهم بحورا % % وكم عدموا الثرى عدم الثراء % % 62(@)(@@) % وجاء الموت مقتضيا نفوسا % % لوت بقضائهن يد القضاء % % 63(@)(@@) % وما رد الردى عنها حنانا % % ولكن مطل داء بالدواء % % 64(@)(@@) % فلأيا ما أهل بهم بشير % % إلى أرض تخيل في سماء % % 65(@)(@@) % ولأيا ما تجافى اليم عنهم % % تجافيه عن الزبد الجفاء % % 66(@)(@@) % ويا عجب الليالي أي بحر % % تغلغل بين أثناء الغثاء % % 67(@)(@@) % ومن يسمع بأن نجوم ليل % % هوت مع بدرها فهم أولاء % % 68(@)(@@) % وأخطأ سيرهم أفق ابن يحيى % % ليخطئ علمهم بالكيمياء % % 69(@)(@@) % وكم سرت الرفاق بلا دليل % % إليه والمطي بلا حداء % % 70(@)(@@) % وكم وقيت ركاب يممته % % سهام النائبات بلا وقاء % % PageV01P397 71(@)(@@) % فما شربوا مياه الأرض حتى % % تركن وجوههم من غير ماء % % 72(@)(@@) % ولا نشقوا حياة العيش إلا % % وقد خلعوا جلابيب الحياء % % 73(@)(@@) % ولا جابوا إليه القفر حتى % % تجاوبت الحمائم بالبكاء % % 74(@)(@@) % ولا دل الزمان عليه حتى % % حسبت عداي قد ماتوا بدائي % % 75(@)(@@) % ولا ألقوا عصا التسيار حتى % % عفت حلق البطان من اللقاء % % 76(@)(@@) % ولا بلغوا مناخ العيس إلا % % وفي الحلقوم بالغة الذماء % % 77(@)(@@) % وفي رب العباد عزاء عز % % لذل غاله عز العزاء % % 78(@)(@@) % وفي المنصور مأوى وانتصار % % لمنبوذ الوسائل بالعراء % % 79 
ms130	(@)(@@) % وفي قاضي القضاة قضاء حق % % لمن يرعاهم راعي الرعاء % % 80(@)(@@) % أبو الحكم الذي ألقت يداه % % إليك الحكم في دان وناء % % PageV01P398 81(@)(@@) % وإنك منه في عدل وفضل % % على أمد البعاد أو الثواء % % 82(@)(@@) % مكان الفجر أشرق من ذكاء % % تألقه وأعرب عن ذكاء % % 83(@)(@@) % وإن يك قدوة الكرماء جودا % % فإنك بالمكارم ذو اقتداء % % 84(@)(@@) % وإن أحب ما تقضي إليه % % لمن آواهم حكم الحباء % % 85(@)(@@) % وأنت بسمع رأفته سميع % % لهم وبعينه في العطف راء % % 86(@)(@@) % % % 87(@)(@@) % فإن لحظوك من طرف خفي % % فقد نادوك من برح الخفاء % % 88(@)(@@) % لدين لا يدين به لنبع % % وأغصان مشذبة اللحاء % % 89(@)(@@) % ودينهم على الإسلام أولى % % ومال الله أوسع للأداء % % 90(@)(@@) % هو الحق الذي جاءتك فيه % % شهود العدل من رب السماء % % PageV01P399 91(@)(@@) % وما في لحظ طرفك من نبو % % ولا في نور رأيك من هباء % % 92(@)(@@) % فهل ببراءة والحشر ريب % % يبين بالنفار أو الجلاء % % 93(@)(@@) % وإن تزدد فثانية المثاني % % وإن تزدد فرابعة النساء % % 94(@)(@@) % وهل بعد الأسارى والسبايا % % مكان للفكاك أو الفداء % % 95(@)(@@) % وقد قالوا افتقار أو إسار % % كما قالوا الجلاء من السباء % % 96(@)(@@) % وهل بالبحر من ظمإ فيروى % % صداه بغير أكباد ظماء % % 97(@)(@@) % وما في وعد رب العرش خلف % % بما للمحسنين من الجزاء % % 98(@)(@@) % ومن يرغب بقاء العدل يسأل % % لك الرحمن طولا في البقاء % % 99(@)(@@) % وأية حرة من حر نظمي % % تجلت للخلائق في جلاء % % 100(@)(@@) % هدية واصل وهدي كفء % % إلى كفء الهدايا والهداء % % PageV01P400 101(@)(@@) % متوجة بتاج من ودادي % % مقلدة بدر من ثنائي % % 102(@)(@@) % . . . . . . . . . . . . % . . . . . . . . . . % 103(@)(@@) % . . . . . . . . . . . . % . . . . . . . . . . % PageV01P401 البحر : وافر تام 1(@)(@@) % أخو ظمإ يمص حشاه سبع % % وأربعة وكلهم ظماء % % 2(@)(@@) % كأنجم يوسف عددا ولكن % % برؤيا هذه برح الخفاء % % 3(@)(@@) % خطوب خاطبتهم من دواه % % يموت الحزم فيها والدهاء % % 4(@)(@@) % تراءت بالكواكب وهي ظهر % % وآذن فيه بالشمس العشاء % % 5(@)(@@) % فهل نظري تخفى أو بصدري % % وضاق البحر عنها والفضاء % % 6(@)(@@) % وكلهم كيوسف إذ فداه % % من القتل التغرب والجلاء % % 7(@)(@@) % وإن سجن حواه فكم حواهم % % سجون الفلك والقفر القواء % % 8(@)(@@) % وأية أسوة في الحسن منه % % لإحساني 
ms131	 إذا ارتخص الشراء % % 9(@)(@@) % وفي باكيه من بعد وصدري % % وأجفاني بمن أبكي ملاء % % 10(@)(@@) % وأوحش من غروب الشمس يوما % % كسوف في سناها وامحاء % % PageV01P402 11(@)(@@) % وأفلاذ الفؤاد أمض قرحا % % إذا رمت العيون بما تساء % % 12(@)(@@) % فما كسرورهم في الدهر حزن % % ولا كشفائهم في الصدر داء % % 13(@)(@@) % نقائذ فتنة وخلوف ذل % % ألذ من البقاء به الفناء % % 14(@)(@@) % فإن أقوت مغاني العز منهم % % فكم عمرت بهم بيد خلاء % % 15(@)(@@) % وإن ضاقت بهم أرض فأرض % % فما بكت لمثلهم السماء % % 16(@)(@@) % وإن نسي الردى منهم ذماء % % فأعذر زاهق عنه الذماء % % 17(@)(@@) % فكم تركوا معاهد موحشات % % عفت حتى عفا فيها العفاء % % 18(@)(@@) % فأظلم بعدنا الإصباح فيها % % وكم دهر أضاء بها المساء % % 19(@)(@@) % وجد بها البلى فحكت وجوها % % نأت عنها فجد بها البلاء % % 20(@)(@@) % وهون هوانها في كل عين % % جدير أن يعز له العزاء % % PageV01P403 21(@)(@@) % بسطن لكل مقبوض يداه % % فيما فيهن غير الدمع ماء % % 22(@)(@@) % شموس غالها ذعر وبين % % فهن لكل ضاحية هباء % % 23(@)(@@) % وكم لبسوا من النعمى برودا % % جلاها عن جسومهم الجلاء % % 24(@)(@@) % ملابس بامة لم يبق منها % % لهم إلا ابن يحيى والحياء % % 25(@)(@@) % فإن كشفوا لهم منها غطاء % % ففيه وفيك لي ولهم غطاء % % 26(@)(@@) % شفيع صادق منه الوفاء % % ومولى صادق فيه الرجاء % % 27(@)(@@) % وإن دجت الخطوب بهم عليه % % فأنت لكل داجية ضياء % % 28(@)(@@) % وإن طوت الرزايا من سناهم % % فلحظك منه يتضح الخفاء % % 29(@)(@@) % وإن أخفى نداءهم التنائي % % فسمعك منه يستمع النداء % % 30(@)(@@) % وإن وردوا قليب الجود عطلا % % فأنت الدلو فيها والرشاء % % PageV01P404 31(@)(@@) % وقد شاء الإله بأن أندى % % بحار الأرض يسقي من تشاء % % 32(@)(@@) % فنبه فادي الأسرى عليهم % % نفوسهم له ولك الفداء % % 33(@)(@@) % غصون عند بحر نداه أوفت % % بها كحل وقد شذب اللحاء % % 34(@)(@@) % وآواها الربيع وكل حين % % يعيث القيظ فيها والشتاء % % 35(@)(@@) % وجاورت الصبا فغدت وأمست % % تجرجر في حشاها الجربياء % % 36(@)(@@) % رمت بهم الحوادث نحو مولى % % حواها الرق منه والولاء % % 37(@)(@@) % وقادهم الكتاب إلى مليك % % تقاضاهم ليمناه القضاء % % 38(@)(@@) % فكم عسفوا إليه لج بحر % % تلاقى 
ms132	 الماء فيه والسماء % % PageV01P405 البحر : متقارب تام 1(@)(@@) % وأهد بها في الفلا والسرى % % ويوم التلاقي وحين الثواء % % 2(@)(@@) % وتحت العجاج ووسط الهياج % % وفي بحر آل وفي بحر ماء % % 3(@)(@@) % وأوصل بها لأصيل العشي % % بقرن الضحى والضحى بالمساء % % 4(@)(@@) % وفاء لنفس أمدت سناها % % بنور النهى وبنار الذكاء % % 5(@)(@@) % وهدي هداها سبيل العفاف % % ورأي أراها هدى كل راء % % 6(@)(@@) % كما قد وفيت لها حين عجت % % بغلتها في عباب الوفاء % % 7(@)(@@) % ينابيع مجد سقت نبعة % % من الفضل دانية الإجتناء % % 8(@)(@@) % زكا تربها في ثرى المأثرات % % فأينع إثمارها بالزكاء % % 9(@)(@@) % فأضحت تثنى بروح الثناء % % وينمي لها عنصر الإنتماء % % 10(@)(@@) % فكم أفرجت عن نجوم السعود % % وكم أغمضت من نجوم الشقاء % % PageV01P406 11(@)(@@) % وكم ظللت من حرير الهجير % % وكم أنزلت من طريد العشاء % % 12(@)(@@) % رياضا تفوح بطيب الفعال % % وزهرا يلوح ببشر اللقاء % % 13(@)(@@) % ونادينني بضمان الندى % % وحيينني بحياة الرجاء % % 14(@)(@@) % بما استحفظت من حفاظ الجوار % % وما أبليت من حميد البلاء % % 15(@)(@@) % يجامعها شمل حلم وعلم % % وهاد لها شكر دان وناء % % 16(@)(@@) % ومن ولدت من كريم النجار % % ومن أرضعت بلبان الدهاء % % 17(@)(@@) % رعى حق ما استودعته المساعي % % فأودعنه رعي خير الرعاء % % 18(@)(@@) % ونادت به دولة السبق حي % % فأعدته بالسبق قبل النداء % % 19(@)(@@) % تجيبية جاب عنها الردى % % كجوب المهند متن الرداء % % 20(@)(@@) % حقيق النصيحة أن يستثير % % لها الدر من تحت ردم الغثاء % % PageV01P407 21(@)(@@) % وألا يخلي في ظلها % % ذليل الذمام عزيز العزاء % % 22(@)(@@) % فبشر عنها ببذل الغنى % % وأعذر فيها ببذل الغناء % % 23(@)(@@) % لمنزله منزل الإختصاص % % وملبسه شرطة الإعتلاء % % 24(@)(@@) % ومعتد أقلامه للكتاب % % كتائب مشترفات اللواء % % 25(@)(@@) % مليك تواضع في عز ملك % % كسا دهره حلة الكبرياء % % 26(@)(@@) % مقلد سيف الهدى والهوادي % % متوج تاج السنا والسناء % % 27(@)(@@) % وأغزى جيوش نداه القلوب % % فجاءته مذعنة بالسباء % % 28(@)(@@) % وخاصم في مهجات الأعادي % % فأعطي بالسيف فصل القضاء % % 29(@)(@@) % كأن الأماني من عليه % % فلا آيب دون ضعف الجزاء % % 30(@)(@@) % فلبيك لا من بعيد ولكن % % عذيرك من معذرات الحياء % % PageV01P408 31(@)(@@) % حمى فاحتبى بفناء اختلالي % % فباعد بيني وبين الحباء % % 32 
ms133	(@)(@@) % وقنع وجهي قناعات حر % % فقنع دوني وجوه العطاء % % 33(@)(@@) % وآزرته بالتجمل حتى % % طويت صدى ظمإ عن سقاء % % 34(@)(@@) % أمير على ماء وجهي ولكن % % فداه بعيني ماء بماء % % 35(@)(@@) % فأرصد هذا لحر كريم % % وأسبل ذا طمعا في الشفاء % % 36(@)(@@) % فقد حان من برحاء الضلوع % % رحيل تنادى ببرح الخفاء % % 37(@)(@@) % على ذلل من مطايا الشئون % % قطعن إليك عقال الثواء % % 38(@)(@@) % عواسف يهماء من غول همي % % يقصر عنها ذميل النجاء % % 39(@)(@@) % جدلت أزمتها من جفوني % % وصغت أخستها من ذمائي % % 40(@)(@@) % وأنعلها قرحات المآقي % % فأخصفها بنجيع الدماء % % PageV01P409 41(@)(@@) % فمنجدة في مجال النجاد % % وغاثرة في غرور الرداء % % 42(@)(@@) % فكم قد شققن سلى عن سليل % % وأجهضن عن مستسر الوعاء % % 43(@)(@@) % وكم قد رددن حياة نفوس % % ظماء بموت نفوس ظماء % % 44(@)(@@) % كأن مداهن في صحن خدي % % ركابي في صحصحان الفضاء % % 45(@)(@@) % تجوب التنائف خرقا فخرقا % % وحاجاتها في عنو العناء % % 46(@)(@@) % بكل حزين بعالي إلحزون % % ومقو بكل بلاد قواء % % 47(@)(@@) % ومستوهل حم منه الحمام % % لأول وهلة ذاك التنائي % % 48(@)(@@) % كأن تجاوب خضر الحمام % % نشيجهم لتغني الحداء % % 49(@)(@@) % وقد أوطنوا أربعا للبلى % % وقد وطنوا أنفسا للبلاء % % 50(@)(@@) % وكل خلي عن الإنس رهن % % لجنبي خلية بحر خلاء % % PageV01P410 51(@)(@@) % قريبة ما بين نضو ونضو % % بعيدة ما بين مرأى وراء % % 52(@)(@@) % تمور بضعف نجوم الثريا % % لو انفردت بأديم السماء % % 53(@)(@@) % ثمان كأسرار قلب الكئيب % % ورابعة كقداح السراء % % 54(@)(@@) % مطالبهم لمطال الضمار % % وآجالهم لاقتضاء القضاء % % 55(@)(@@) % فهل آذنت هجرتي أن تريني % % عواقب تجلو كروب الجلاء % % 56(@)(@@) % وهل ظفرت همتي من همومي % % بثأر منيم ووتر بواء % % 57(@)(@@) % ألم يتناه غروب الغريب % % إلى مطلع الشمس في الانتهاء % % 58(@)(@@) % ولم أتخذ جنح ليل المحاق % % جناحا إلى نور ليل السواء % % 59(@)(@@) % ولم أتزود هبيد القفار % % إلى بحر أري جزيل العطاء % % 60(@)(@@) % فأصبحت من ظلم الإكتئاب % % على علم بين قرني ذكاء % % PageV01P411 61(@)(@@) % وألقت يميني عصا الاغتراب % % من الأمن بين العصا واللحاء % % 62(@)(@@) % وأوطنت في قبة الملك رحلي بين الرواق وبين الكفاء % % 63(@)(@@) % وأوفيت سوق الندى والمعالي % % بدر المقال 
ms134	 وحر الثناء % % 64(@)(@@) % وقد شهد البر والبحر أني % % بقرب ابن يحيى مجاب الدعاء % % 65(@)(@@) % وأنك أنت الصريح السميع % % إذا صم مستمع عن ندائي % % 66(@)(@@) % وأنك دوني طود منيع % % على الدهر مستصعب الإرتقاء % % 67(@)(@@) % وانك أنت الشفيع الرفيع % % بدائي إلى مسعف بالدواء % % 68(@)(@@) % فكيف تخطت إلي الرزايا % % ولم أخط في مستجاد الوقاء % % 69(@)(@@) % وكيف اعتصمت بصدر الزمان % % وصدري قرى كل داء عياء % % 70(@)(@@) % وقد ضرستني حروب الخطوب % % وأبطأت يا نصرة الأولياء % % PageV01P412 71(@)(@@) % وعرفت في نكبات الزمان % % بكنه الصديق ومعنى الإخاء % % 72(@)(@@) % فواقدمي من سلام العثار % % ويا ألمي من سهام الجفاء % % 73(@)(@@) % وما أبعد القفر عن عين راء % % وما أقرب الوقر من سمع ناء % % 74(@)(@@) % ويا طول ظمئي لخمس وعشر % % طريد الحياض بعيد الإضاء % % 75(@)(@@) % كأني بعت التقى بالنفاق % % فلا هؤلاء ولا هؤلاء % % 76(@)(@@) % وكم عقرت دون عقر الحياض % % سوامي وأزت أمام الإزاء % % 77(@)(@@) % فرحت بها مخمصا في البطان % % وأصدرتها مظمئا في الرواء % % 78(@)(@@) % وأرعيت سعدان سعد السعود % % نواء المنى وصفايا الصفاء % % 79(@)(@@) % وأقوى فأنحر حرفا سنادا % % وأرعى فأحلب شطر الإناء % % 80(@)(@@) % بسبع كسبع سمام السموم % % وأربعة كربوع العفاء % % PageV01P413 81(@)(@@) % يفدون نفسي من الحادثات % % ومالي ولا لهم من فداء % % 82(@)(@@) % وكم ضربوا بقداح الحنو % % علي ففازوا بقسم سواء % % 83(@)(@@) % وقد أسلمتهم سمائي وأرضي % % فلا من ثراي ولا من ثرائي % % 84(@)(@@) % فيا ضيق ذرعي لهم بالزفير % % على ضيق ذرعي بضيق الشتاء % % 85(@)(@@) % وقد آذنتهم يدي واضطلاعي % % بعدم الوقاء لهم والصلاء % % 86(@)(@@) % فما بسوى حر تلك الصدور % % يوقون من برد هذا الهواء % % 87(@)(@@) % وإن راعت الأرض منهم جنوبا % % تسلوا برعي نجوم السماء % % PageV01P414 البحر : بسيط تام 1(@)(@@) % هل يجهل السمت من يستوضح الطرقا % % أو يبعد الشمس من يستيقن الغلقا % % 2(@)(@@) % قد خبرت دوحة المجد التي كرمت % % عن معتلى ذلك الغصن الذي بسقا % % 3(@)(@@) % لله عين رأته وهو بدر دجى % % يوما أهل فجلى نوره الأفقا % % 4(@)(@@) % وكم رأينا وجوه الروض ضاحكة % % في رائح راح أو في بارق برقا % % 5(@)(@@) % أنجبته يا وزير الملك مدخرا % % لفجأة الخطب 
ms135	 إن غادى وإن طرقا % % 6(@)(@@) % وفارسا لغمار الروع مقتحما % % وصارما في يمين الملك مؤتلقا % % 7(@)(@@) % وقد يرى في نواحي المهد مبتدرا % % إلى الطعان وكرات الوغى قلقا % % 8(@)(@@) % تدنى ملاعبه منه فليس يرى % % غير السنان وغير الرمح معتلقا % % 9(@)(@@) % للبر أول ما قامت به قدم % % سعيا وللحق أولى نطقة نطقا % % 10(@)(@@) % حتى غدا بكتاب الله معتصما % % يحبى بخطة عز كلما حذقا % % PageV01P415 11(@)(@@) % أ ثم استمر إلى العلياء مفتتحا % % معاقل الفخر لا نكسا ولا فرقا % % 12(@)(@@) % تلقاه من دونها الأيام متثدا % % بالجد مشتملا بالحزم منتطقا % % 13(@)(@@) % وقد أحاطت أزاهير النعيم به % % فصير العلم فيها روضة الأنقا % % 14(@)(@@) % وما غدا غير كأس المدح مصطبحا % % ولم يرح غير كأس المجد مغتبقا % % 15(@)(@@) % مفجر الكف جودا والجبين سنا % % ومفعم الجيب نصحا والضمير تقى % % 16(@)(@@) % قد شرد الظلم عن أوطان شيمته % % فلم يدع منك لا خلقا ولا خلقا % % 17(@)(@@) % حتى فرايتك اللاتي سموت لها % % قد حازها مثلما قد حزتها نسقا % % 18(@)(@@) % وما انثنى الأمل المعطي رغائبه % % فيه ولا وقف الظن الذي صدقا % % 19(@)(@@) % حتى يوفى الذي وفيت في عجل % % ومثله إن سعى في مثلها لحقا % % 20(@)(@@) % فقد رأت أنه حقا له خلقت % % كما رأى أنه حقا لها خلقا % % PageV01P416 21(@)(@@) % مشيع السعي لم يبهر له نفس % % حتى أتى الغاية القصوى وقد سبقا % % 22(@)(@@) % ما احتاز ذو همة في المكرمات مدى % % بمجهد الشأو إلا احتازه عنقا % % 23(@)(@@) % لم يأن أن يعلق البيض الحسان وقد % % أضحى فؤاد العلا صبا به علقا % % 24(@)(@@) % ولا انثنى لعناق الخود بعد وقد % % يبيت للشرطة العلياء معتنقا % % 25(@)(@@) % غراء راحت عليه وهو بغيتها % % فأصبح الدهر من أنفاسها عبقا % % 26(@)(@@) % وأصبح العرض في آثاره أسفا % % يعلل النفس أن تستبقي الرمقا % % 27(@)(@@) % إن يشج ألا يسمى عارض أبدا % % يسله أن يسمى عارضا غدقا % % 28(@)(@@) % فالحمد لله راح الغصن معتليا % % والسيف منصلتا والبدر متسقا % % 29(@)(@@) % منا من الله والمولى الذي مطرت % % سماؤه الدر بله التبر والورقا % % 30(@)(@@) % مستيقنا أن شمل الملك مجتمع % % يوما إذا كان شمل المال 
ms136	 مفترقا % % PageV01P417 البحر : متقارب تام 1(@)(@@) % عرفت عوازفك السابقات % % بوادي السنا واضحات السمات % % 2(@)(@@) % وما كدت أبسط لحظ الغريب % % وما آن حلي عقال الأناة % % 3(@)(@@) % وبينا أراقب نشء السحاب % % هبت رياحك لي بالهبات % % 4(@)(@@) % وما كاد ينصف ليل الهموم % % أنار صباحك لي في البيات % % 5(@)(@@) % ب فوفرت في الوجه ماء الحياء % % بدارا إليه بماء الحياة % % 6(@)(@@) % فكيف وقد راق شكري عليك % % وأوثقت لي منك رهن العدات % % 7(@)(@@) % فهذا أوان أذان الغداء % % وقد حان منا إقام الصلاة % % 8(@)(@@) % وهذا إمام الهدى منصت % % إلى دعوة الدين والمكرمات % % PageV01P418 البحر : مجتث 1(@)(@@) % اقبل ثناء وشكرا % % وازدد بقاء وعمرا % % 2(@)(@@) % وليهنك المجد لبسا % % والحمد كنزا وذخرا % % 3(@)(@@) % فما دجا لي خطب % % إلا لمحتك فجرا % % 4(@)(@@) % ولا دعوتك سرا % % إلا وجدتك سترا % % 5(@)(@@) % وإن تضرم صدري % % حرا وجدتك حرا % % 6(@)(@@) % كما وجدتك حلوا % % إذ ذقت دهري مرا % % 7(@)(@@) % فلا تزل فوق ما كنت لي مع العسر يسرا % % 8(@)(@@) % وكنت أمس سريا % % واليوم أسرى وأسرى % % 9(@)(@@) % وكنت تعدل واليوم % % أنت بالعدل أحرى % % 10(@)(@@) % فاحكم كما حكم الله حين زادك فخرا % % PageV01P419 11(@)(@@) % وزد فعالك قدرا % % إذ زادك الله قدرا % % 12(@)(@@) % فقد طلعت هلالا % % واليوم أمسيت بدرا % % 13(@)(@@) % فكيف أرضاك بحرا % % كما رضيتك نهرا % % 14(@)(@@) % وكيف يجري جواد % % كما جرى قبل مهرا % % 15(@)(@@) % وقد بدأت ببر % % فأتبع البر برا % % 16(@)(@@) % وزد على الباء رفعا % % يرفع لك الله ذكرا % % PageV01P420 البحر : طويل 1(@)(@@) % سأمنع قلبي أن يحن إليك % % وأنهى دموعي أن تفيض عليا % % 2(@)(@@) % أغدرا ولم أغدر وخوفا ولم أخن % % لقد ضاع لي صدق الوفاء لدينا % % 3(@)(@@) % بفعلك عيب الحسن عندي وإن غدت % % مهاة النقا والشمس مشتبا % % 4(@)(@@) % أصد بوجهي عن سنا الشمس طالعا % % لأن صار منسوب الصفات إليه % % 5(@)(@@) % وأستفظع الشهد اللذيذ مذاقه % % لمطعمه الموجود في شفتيك % % 6(@)(@@) % وأصرف عن ذكراك سمعي ومنطقي % % ولو نازعتنيها حمامة إليه % % 7(@)(@@) % ولو عن لي ظبي الفلا لاجتنبته % % لتمثال عينيك وسالفته % % PageV01P421 البحر : بسيط تام 1(@)(@@) % شوق شديد ووصل من حبيبين % % فليت شعري ما خطب العذولين 
ms137	 % % 2(@)(@@) % يا ليت شعري إذ لاما وشعرهما % % أفي السويداء من قلبي ومن عيني % % 3(@)(@@) % من أمكن من أذني عذلهما % % فيها إذا قام عذري في العذارين % % 4(@)(@@) % وقد تعبدني رب الهوى فبه % % أعوذ من مشرك فيه إلهينأ % % 5(@)(@@) % وليس ذنبي عند العاذلين سوى % % أني أرى في رضاه ثاني اثنين % % 6(@)(@@) % وكم طلبت بها الأيام مجتهدا % % طلاب رب نفيس الدين بالدين % % 7(@)(@@) % وكم بذلت لها في الشوق مكتئبا % % غروب جفنين ما تشكو من الأين % % 8(@)(@@) % بدمع عين أبى ما في الضمير له % % حتى يصيره دمعا بلا عين % % PageV01P422 البحر : بسيط تام 1(@)(@@) % إقبال جدك للإسلام إقبال % % وعز نصرك للإشراك إذلال % % 2(@)(@@) % ولا معقب للحكم الذي سبقت % % به من الله أحكام وأفعال % % 3(@)(@@) % أحق حقك في الملك الذي ضمنت % % ميراثه لك أملاك وأقيال % % 4(@)(@@) % وحق للمفخر المرفوع معلمه % % حق وللباطل المجهول إبطال % % 5(@)(@@) % فاسعد بملك مفاتيح الفتوح ولا % % خابت بسعيك للإسلام آمال % % 6(@)(@@) % ولا كفتح غدت أعلام دعوته % % ترسو به وكثيب الشرك ينهال % % 7(@)(@@) % فتح كفاتحه في الخلق ليس له % % مما خلا من فتوح الأرض أشكالا % % 8(@)(@@) % أضحت به حلل الدنيا لنا جددا % % ولبس والي العدى والغدر أسمال % % 9(@)(@@) % وشب شيباننا من ذكره فرحا % % وشاب من خزيه في الشرك أطفال % % 10(@)(@@) % وغنت الطير في أغصانها طربا % % وشدو طير العدى والكفر إعوال % % PageV01P423 11(@)(@@) % فقل لرافعها بالغدر ألوية % % حسب الردى والأعادي منك ما نالوا % % 12(@)(@@) % وقل لمن أخلفته الوعد غدرته % % أن يخلف القمر الوضاح إكمال % % 13(@)(@@) % هيهات أشرق في جو العلا ملك % % بالعدل والفضل قوال وفعال % % 14(@)(@@) % للمنى كاسمه محي ومنتعش % % وللأسى والعدى والبغي قتال % % 15(@)(@@) % فذ المكارم لا شبه ولا مثل % % والناس من بعد أشباه وأمثال % % 16(@)(@@) % وقد تجلى إلى العلياء في حلل % % للملك منهن إعظام وإجلال % % 17(@)(@@) % وقابل الدين والإسلام في شيم % % في عفوها من منى الإسلام ما سالوا % % 18(@)(@@) % وقل لمن قصرت بالأسد خبرته % % فشك أن يخلف الرئبال رئبال % % 19(@)(@@) % ب صبرا لموقع أظفار المظفر هل % % يحيلها عن حشاك اليوم محتال % % 20(@)(@@) % وقد 
ms138	 طمت فوقه أمواج أبحره % % حتى تيقن أن قد غره الآل % % PageV01P424 21(@)(@@) % سفائن من خيول مالها شحن % % إلا سيوف وأرماح وأبطال % % 22(@)(@@) % أبناء روع وأهوال لمقدمهم % % في أعين الموت أذعار وأهوال % % 23(@)(@@) % ثبت المواقف لو زالت بأرجلهم % % تحت العجاج متون الأرض ما زالوا % % 24(@)(@@) % دعوا إليك حصون الغدر فاستبقت % % مثل النجوم على يمناك تنثال % % 25(@)(@@) % والموت قد عدهم أكلا له ففدت % % أعدادهم من بني الإشراك أبدال % % 26(@)(@@) % معاقل عرفت يمناك فاعترفت % % بذنب ما فعل الغاوون أو قالوا % % 27(@)(@@) % مقرة أنك المولى المليك لها % % وأنها منك إنعام وإفضال % % 28(@)(@@) % على الذي احتازها منا فأودعها % % علا فعادت عليه وهي أغلال % % 29(@)(@@) % ذو حرمة فال منها فأل طائره % % قلب غوى بحجاه عنك تذهال % % 30(@)(@@) % وكان فأل وقار صد عنك به % % فارتد طائر طيش ذلك الفال % % PageV01P425 31(@)(@@) % صعقت بالنصر مثواه وموطنه % % فضعضعت منه غيطان وأجبال % % 32(@)(@@) % صعقا رمت كل كفر منه راجفة % % وهب في كل غدر منه زلزال % % 33(@)(@@) % وحكم الله يا يحيى سيوفك في % % إحياء حقك والموتور صوال % % 34(@)(@@) % فما يبيت نجي الكفر مرتقبا % % إلا خيولك في جفنيه تختال % % 35(@)(@@) % ولا يراعي نجوم الليل ذو حذر % % إلا وقرناه آجال وأوجال % % 36(@)(@@) % يبيت يسهده ليل السليم أسى % % بصاع خوفك يستوفي ويكتال % % 37(@)(@@) % فإن تخطته منك اليوم بائقة % % ففي غد بعد حال بعدها حال % % 38(@)(@@) % وإن أقطع وصال لواصله % % غدر لطاغية الإشراك وصال % % 39(@)(@@) % فافخر فما فوق ظهر الأرض من حسن % % في الذكر إلا عليه منك تمثال % % 40(@)(@@) % وابشر فإنك روح الحق ليس له % % إلا من النصر أعضاء وأوصال % % PageV01P426 41(@)(@@) % والله يحرس مولى ما يزال لنا % % به إلى الفتح بعد الفتح إهلال % % 42(@)(@@) % . . . . . . . . . . . . . . . . % . . . . . . . . . . . . . . . . % PageV01P427 البحر : طويل 1(@)(@@) % غرام ولا شكوى وعتب ولا عتبى % % وشوق ولا لقيا وصبر ولا عقبى % % 2(@)(@@) % وكم حن معشوق وأعتب عاشق % % وقلبك ما أقسى وقلبي ما أصبى % % 3(@)(@@) % سأصدع أحناء الضلوع بزفرة % % تطير إليك القلب لو أن لي قلبا % % 4(@)(@@) % وأسبل آماق الجفون بعبرة % % وإن حرمت منك المودة في القربى % % 5(@)(@@) % بنسبتنا في 
ms139	 رق مولى أضافنا % % فبوأنا الإكرام والمنزل الرحبا % % 6(@)(@@) % وحسبك والمنصور جامع شملنا % % وكنت له شرقا وكنت له غربا % % 7(@)(@@) % فجهز في العلم والحلم والنهى % % وجهز فيك الخيل والطعن والحربا % % 8(@)(@@) % فلبيته سبيا ولبيته منى % % ودنت له سلما ودنت له حربا % % 9(@)(@@) % فلا عدم الإسلام من عزماته % % سيوفا بها نسبي وجوها بها نسبى % % PageV01P428 البحر : بسيط تام 1(@)(@@) % وطن فؤادك إن كان الرحيل غدا % % أن الأسى إلفه من بعدهم أبدا % % 2(@)(@@) % واندب لتشييعهم حر الزفير ضحى % % وابعث دموعك في آثاره مددا % % 3(@)(@@) % والنفس إن لم تمت من بعدهم كمدا % % مات الوفاء عليها بعدهم كمدا % % 4(@)(@@) % كحد سيفك يا منصور إن سلمت % % منه ملوك العدى ماتوا له حسدا % % PageV01P429 البحر : كامل تام 1(@)(@@) % حاشى لنار هواك أن تطفا % % ولسر وجدي فيك أن يخفى % % 2(@)(@@) % غادرت إلفك بالضنى ألفا % % فردا وكنت لأنسه إلفا % % 3(@)(@@) % حرفا وصال فصلا بنوى % % كانا بخط يد الهوى حرفا % % 4(@)(@@) % فغدوت في طوع الوشاة بنا % % صنفا سواي وكنت لي نصفا % % 5(@)(@@) % ورأيت صبري كيف يغدر بي % % ووجدت منك مدامعي أوفى % % 6(@)(@@) % ألذوب ما في فيك من برد % % أحرمتني من ريقك الرشفا % % 7(@)(@@) % ولعطف صدغيك اللذين بها % % أعدمتني من نيلك العطفا % % 8(@)(@@) % وبما كستك الشمس جلوتها % % قصرت عنك الوهم والطرفا % % 9(@)(@@) % ب وأرى ابن يحيى فوق منزلها % % قدرا وفوق ضيائها ضعفا % % 10(@)(@@) % والأرض من ذكراه قد ملئت % % عرفا ومن إفضاله عرفا % % PageV01P430 11(@)(@@) % ومعالم الإسلام ما برحت % % تلقى بزحف جنوده زحفا % % PageV01P431 البحر : كامل تام 1(@)(@@) % قل للهوى حكمت فاحكم لي % % لا تصل حر الهجر من أجلي % % 2(@)(@@) % لا يغلبن خصماي عندك في % % عين الرقيب وألسن العذل % % 3(@)(@@) % وأصخ لمظلمتي فقد وضحت % % واسمع فعندي شاهدا عدل % % 4(@)(@@) % أأجود بالنفس التي كرمت % % لرشا يضن علي بالوصل % % 5(@)(@@) % وشمائل المنصور قد قطعت % % ظلم الظلوم وسنة البخل % % 6(@)(@@) % ملك أجار الدين موقفه % % بالسيف بين الخيل والرجل % % 7(@)(@@) % وأجار خلق الله فاعترفوا % % عوضا من الأوطان والأهل % % 8(@)(@@) % ووفت بعهد العلم ذمته % % إذ لم يضيع مثله مثلي % % PageV01P432 البحر : مجزوء 
ms140	 الرمل 1(@)(@@) % دأبك الهجر ودابي % % فيك إدمان التصابي % % 2(@)(@@) % أيها المغرى بقتلي % % بك أصبحت لما بي % % 3(@)(@@) % لا ومن آوى اغترابي % % وشفى حر مصابي % % 4(@)(@@) % وكفاني صرف دهر % % سامني سوء العذاب % % 5(@)(@@) % ما رأت عيني كظبي % % لاح في تم الشباب % % 6(@)(@@) % أسبل الليل على متنيه إسبال النقاب % % 7(@)(@@) % فتجلى كتجلي البدر من تحت السحاب % % 8(@)(@@) % في عقود من نجوم % % ووشاح من سراب % % 9(@)(@@) % فهو نومي وسروري % % وسهادي واكتئابي % % PageV01P433 البحر : كامل تام 1(@)(@@) % طير الفؤاد على لماك تحوم % % فهو المنى وهي الظماء الهيم % % 2(@)(@@) % أري تخلل نظم سلكي لؤلؤ % % في جانبيه جنة ونعيم % % 3(@)(@@) % نمت عليها طرة المسك الذي % % أزرى عليه رحيقك المختومأ % % 4(@)(@@) % وحماه قوسا حاجبيك بأسهم % % قلبي بهن مجرح مكلوم % % 5(@)(@@) % وسنا كإصباح المغار مروع % % ودجى كإظلام البيات بهيم % % 6(@)(@@) % وعقارب صدري بهن ملسع % % وأساود قلبي بهن سليم % % 7(@)(@@) % فكأنني لم يحمني الملك الذي % % سجد الفرنج لتاجه والروم % % 8(@)(@@) % أو لم تجرني راحة يمنية % % حي السماح بها ومات اللوم % % PageV01P434 البحر : بسيط تام 1(@)(@@) % منكم إليكم مساعي المجد تنصرف % % ونحوكم عنكم الآمال تنعطف % % 2(@)(@@) % ورب مكرمة عي الكرام بها % % أضحت ذلولا على أهوائكم تقف % % 3(@)(@@) % وأين بالبحر عن مثواه منعرج % % وأين بالنجم عن مجراه منحرف % % 4(@)(@@) % من ذا ينازعكم أعلام مكرمة % % والمجد متلد فيكم ومطرف % % 5(@)(@@) % أم من يباريكم سبقا إلى كرم % % والمجد متلد فيكم ومطرف % % 6(@)(@@) % والنصر منسلكم والحرب مرضعكم % % وشامخ العز والعليا لكم كنف % % 7(@)(@@) % والحمد والشكر مخلوع عذارهما % % فيكم وقلب العلا صب بكم كلف % % 8(@)(@@) % والملك ملككم غاد فمنتظر % % آت فمقتبل ماض فمؤتنف % % 9(@)(@@) % من ذا يعد كقحطان الملوك أبا % % والتبعين إذا ما عدد الشرف % % 10(@)(@@) % من كل أبلج كالجوزاء مفرقه % % في عقد تاج بعز الملك يكتنف % % PageV01P435 11(@)(@@) % إن يهبوا يجزلوا أو يقطعوا يصلوا % % أو يعقدوا عقد محروم الوفاء يفوا % % 12(@)(@@) % إن سالموا الأرض كانوا غيث أمحلها % % أو كلفوها توالي خيلهم عنفوا % % 13(@)(@@) % وإن رضوا أشرق الليل البهيم بهم % % ويكشف الموت عن ساق إذا أنفوا % % 14(@)(@@) % لم 