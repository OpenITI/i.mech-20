ms41	 الشيظم القادح % % 7(@)(@@) % اليوم دار الشرك مأهولة % % يأوي لها الصائح والنائح % % 8(@)(@@) % موسى جزاك الله عن دينه % % خيرا فما أنصفك المادح % % 9(@)(@@) % سعيت في جمع شتات العلى % % لله هذا العمل الصالح % % 10(@)(@@) % أقررت عين المصطفى أحمد % % فوجهه مستبشر واضح % % PageV01P149 11(@)(@@) % ملك يرى أن اكتساب العلى % % تجارة خاسرها رابح % % 12(@)(@@) % يسعى إلى الآفاق إحسانه % % كالبحر غاد ماؤه رائح % % 13(@)(@@) % ممنع الجار مباح الندى % % لله ذاك المانع المانح % % 14(@)(@@) % كالغيث لولا الجهم من جونه % % كالليث لولا وجهه الكالح % % 15(@)(@@) % قل لمعاديه ارتجع سالما % % فهو سماء سعدها ذابح وقال يمدحه ويهنئه باجتماعه بأخيه الملك المعظم صاحب دمشق رحمهما الله تعالى % % PageV01P150 البحر : بسيط تام 1(@)(@@) % يا رائد القوم هذا النبت والزهر % % يا شائم البرق هذا البحر والمطر % % 2(@)(@@) % يا خابط الليل لا تهديه بارقة % % بشراك بشراك هذا الشمس والقمر % % 3(@)(@@) % عيسى وموسى فذا يحيا الأنام به % % وذا به حجر الأرزاق ينفجر % % 4(@)(@@) % فرعان من خير أصل طاهر بسقا % % ما أنجب الأصل إلا أنجب الثمر % % 5(@)(@@) % ملكان حلا من العلياء في شرف % % سام أشم منيع المرتقى وعر % % 6(@)(@@) % حيث النوال قريب المجتنى خضل % % ومنهل الفضل سلسال الندى خضر % % 7(@)(@@) % أنظرهما واستمع آثار جودهما % % حتى يوافق طيب المخبر الخبر % % 8(@)(@@) % مدا على الأرض ظل العدل فاشتبهت % % فيه الظهائر والآصال والبكر % % 9(@)(@@) % بآل أيوب قر الملك وانحسرت % % عن صفحتي مائة الأقذار والكدر % % 10(@)(@@) % خذ ما تراه ودع شيئا سمعت به % % هذا هو الصدق لا ما تكذب السير % % PageV01P151 11(@)(@@) % الله يا آل شاذي شاد مجدكم % % وما بنى ربنا لا يهدم البشر % % 12(@)(@@) % والله خيب ما ظنوه وانتظروا % % والله حقق ما نرجو وندخر % % 13(@)(@@) % ردوا السيوف إلى الإغماد واحتكموا % % فيما أردتم فقد أغناكم القدر % % PageV01P152 البحر : - 1(@)(@@) % معاقل الشرك قد رجت لكم شرفا % % وكل ملك على الإطلاق منحصر % % 2(@)(@@) % خوف وحلم لهم ما صافحا حجرا % % إلا تفلق من معناهما الحجر % % 3(@)(@@) % لكم جيوش إذا جاشت غدة وغى % % بمثلها من جيوش الله تنتصر % % 4(@)(@@) % وجاركم آمن في ظل قدرتكم % % وكم تمرد 
ms42	 قوم عندما قدروا % % 5(@)(@@) % ليس الذي نلتموه كل حظكم % % الله أكبر والهندية البتر % % 6(@)(@@) % لله في ملككم سر سيظهره % % وأول الغيث قطر ثم ينهمر % % 7(@)(@@) % زدتم بحب أمير المؤمنين على % % كذا البحور إذا زادت بها الغدر % % 8(@)(@@) % مجدان هذا إلى أيوب متصل % % وذا بناصر دين الله ينتصر % % 9(@)(@@) % قصرت مدحي وما التقصير من شيمي % % إن الكرام إذا ما قصر بدروا % % 10(@)(@@) % يا سائلي عنهم كلفتني شططا % % لا يحسب الرمل بل لا يحصر المطر وقال يمدحه % % PageV01P153 البحر : متقارب تام 1(@)(@@) % أمنت الليالي وأقدارها % % فصل بالأصائل أسحارها % % 2(@)(@@) % وخذ ما صفا من رحيق الكؤوس % % وخل لغيرك أكدارها % % 3(@)(@@) % ليال تعلل فيها النسيم % % فما كان أقصر أعمارها % % 4(@)(@@) % تجاذب فيها العشا والصباح % % فهل سحر الليل سحارها % % 5(@)(@@) % إذا دق ناقوسها بالبزال % % وشدت على الخصر زنارها % % 6(@)(@@) % عبدت الصليب لراووقها % % ووافقت في القول خمارها % % 7(@)(@@) % حمت مقلتاه رياض الخدود % % فما يجتني الناس أثمارها % % 8(@)(@@) % فيا طيف مقلته لا تنم % % فما أوقدت للقرى نارها % % 9(@)(@@) % ولما رشفت جنى ريقه % % هجرت المدام وعصارها % % 10(@)(@@) % حصلت على الدر من ثغره % % فعفت البحار وأخطارها % % PageV01P154 11(@)(@@) % أفي عصر موسى يكون البخيل % % ناهي النفوس وأمارها % % 12(@)(@@) % أبا الفتح أكرم بها كنيه % % فقد صدق الخبر أخبارها % % 13(@)(@@) % ولا تحتقر فتح تلعفر % % فقد زادك الله سنجارها وقال يمدحه % % PageV01P155 البحر : بسيط تام 1(@)(@@) % للذة العيش والأفراح أوقات % % فانشر لواء له بالنصر عادات % % 2(@)(@@) % أمام جيشك أنى سار أربعة % % نصل ونصر وآراء ورايات % % 3(@)(@@) % وتحت غيل القنا فرسان معركة % % لها ثبات وفي الهيجاء وثبات % % 4(@)(@@) % أهلة في سماء من مغافرها % % لها الترائك أفلاك وهالات % % 5(@)(@@) % تهتز أعطافهم يوم الجلاد إذا % % غنت لهم من بنات القين قينات % % 6(@)(@@) % صفائح هي إذ دب الفرند بها % % صحائف كتبت فيها المنيات % % 7(@)(@@) % إن مس شمس الضحى من لمعها رمد % % كحلتها بالعجاج الأعوجيات % % PageV01P156 البحر : - 1(@)(@@) % جرد كرائم تلقى عن فوارسها % % شبا الأسنة أعناق وهامات % % 2(@)(@@) % مستشرفات بآذان مؤللة % % لها إلى الثغر من دمياط حاجات % % 3(@)(@@) % الويل للروم والإبرنس من 
ms43	 ملك % % له من النصر والتأييد عادات % % 4(@)(@@) % أين المفر لسرب الروم من أسد % % ضار له من رماح الخط غابات % % 5(@)(@@) % دمياط طور ونار الحرب موقدة % % وأنت موسى وهذا اليوم ميقات % % 6(@)(@@) % أنت الصباح فمزق ليل كفرهم % % واصبر ورابط فللأعمال نيات % % 7(@)(@@) % ألق العصا تتلقف كل ما أفكوا % % ولا تخف ما حبال القوم حيات % % 8(@)(@@) % طأهم بجيشك لا تحفل بكثرتهم % % فإنهم لبغات الطير أقوات % % 9(@)(@@) % أصبتهم بسهام الرأي من حلب % % وللمكائد من بعد إصابات % % 10(@)(@@) % فطهر الله ذاك الثغر من قلح % % أصابه وانجلت تلك الثنيات % % PageV01P157 11(@)(@@) % تذكروا يوم صافيثا وما لقيت % % من حد سيفك عرقا والقليعات % % 12(@)(@@) % قتلا وأسرا وسبيا وانتهاب ثرى % % لله كم أحسنت تلك الإساءات % % 13(@)(@@) % شنتها غارة كالنار محرقة % % المكفر وهي على الإسلام جنات % % 14(@)(@@) % أثلجت صدر رسول الله وانكشفت % % عن سرحة الدين والدنيا غمامات % % 15(@)(@@) % لله من ثغر دمياط وبرزخها % % فتح له تفتح السبع السماوات % % 16(@)(@@) % يوم على الروم تنشي ريحه سحبا % % أمطارهن مصيبات مصيبات % % 17(@)(@@) % رأوا جيوش بني أيوب يقدمها % % ليث له في جيوش الشرك هجمات % % 18(@)(@@) % فللرماح كلاهم أو صدورهم % % وللصوارم أعناق ولبات % % 19(@)(@@) % تخلق البحر ذاك اليوم من دمهم % % والموج ترقصه فيه المسرات % % 20(@)(@@) % تفاءلوا أن عيسى نصرة لهم % % فقلت بينهما فرق وأشتات % % PageV01P158 21(@)(@@) % هذا تموت به أحياؤكم أبدا % % وذاك يحيا به في الترب أموات % % 22(@)(@@) % بوادر وهنوا من مس صدمتها % % فكيف لو قد أتت منها النهايات % % 23(@)(@@) % ثق يا أبا الفتح بالفتح المبين فلم % % تخلق لغير أبيهن الفتوحات % % 24(@)(@@) % عكا وصور إلى رؤياك عاطشة % % فانهض فقد أمكنت منهن خلوات % % 25(@)(@@) % واستخبر الريح منها إذ يسيره % % إليك فهو سلام أو تحيات % % 26(@)(@@) % الله أكرم أن تمسي مزامرهم % % تتلى وتنسى من القرآن آيات % % 27(@)(@@) % وأن يخور على القربان عجلهم % % جهرا ويخفى أذان أو تلاوات % % 28(@)(@@) % زلزل بغارتك الشعواء دارهم % % فشيمة النجب الغر الإغارات % % 29(@)(@@) % ما كل من طلب العلياء أدركها % % ووافقت سعيه فيها سعادات وقال وهو بحلب ويمدح الملك العزيز صاحبها % % PageV01P159 البحر : بسيط تام 1 
ms44	(@)(@@) % هويته رشئي الطرف والجيد % % بدري ما تحت تصفيف وتجعيد % % 2(@)(@@) % حل القبا ولوى صدغيه فانعقدا % % واحيرتا بين محلول ومعقود % % 3(@)(@@) % يا مسكري بثناياه وريقته % % هل هذه الخمر من تلك العناقيد % % 4(@)(@@) % أحييتني بالذي حييتني فأنا % % في أرغد العيش من ورد وتوريد % % 5(@)(@@) % قضيب بان إذا ما خف أثقله % % كثيب رمل بطيء النهض رعديد % % 6(@)(@@) % خصر وردف كأن البند بينهما % % مفرق بين معدوم وموجود % % 7(@)(@@) % في حسن يوسف إلا أنه ملك % % فما يباع ببخس النقد معدود % % 8(@)(@@) % يا من حماه ببيض الهند نم فلقد % % حمته جفناه بالهندية السود % % 9(@)(@@) % له من الماء إن لا ينته جسد % % والقلب من صخرة صماء صيخود % % 10(@)(@@) % فلا يرق على نوحي ولا سهري % % والنجم قد مل تعدادي وتعديدي % % PageV01P160 11(@)(@@) % قالوا تعشق مباح الوصل قلت لهم % % ليس الدني إلى قلبي بمودود % % 12(@)(@@) % في أحسن الناس لا في غيره غزلي % % وإن مدحت فموسى خير مقصود % % 13(@)(@@) % ملك إذا ما طغى طوفان راحته % % أرسى سفينة راجيه على الجودي % % 14(@)(@@) % يا قاصد الأشرف امسك عن سؤال فتى % % إلى المكارم صب القلب معمود % % 15(@)(@@) % أغر يلقاك بالإحسان معتذرا % % عذر المسيء على مطل وترديد % % 16(@)(@@) % العاقد الرأي في أعلام عسكره % % فإن نشرن فعن نصر وتأييد % % 17(@)(@@) % والقائد الجيش كالبحر الخضم وما % % أمواجه غير صيد أو صناديد % % 18(@)(@@) % شوس إذا اعتقلوا المران خلتهم % % أسدا تأبطن أمثال الأساويد % % 19(@)(@@) % تجلو لهم في ظلام النقع غرته % % مواقع الطعن بين الهام والجيد % % 20(@)(@@) % وتستعير عواليهم عزائمه % % فما يدعن وريدا غير مورود % % PageV01P161 21(@)(@@) % يا مخلفا ظن كيكاووس حين أتى % % يغزو معاقل إسلام وتوحيد % % 22(@)(@@) % في جحفل عذبات الكفر خافقة % % من جانبيه بسعي غير مسعود % % 23(@)(@@) % فاستقبلته من الأعراب شرذمة % % فبددت شمله في المهمه البيد % % 24(@)(@@) % نجا وأسلم للخرصان أسرته % % فسيد القوم رزق النسر والسيد % % 25(@)(@@) % لو شاء شاه ارمن ما فاته دمه % % لكن عفا عن أسير القلب مطرود % % 26(@)(@@) % ورد أسراه بعد السلب في نعم % % ولو أطاق لأحيا كل مفقود % % 27(@)(@@) % هذا هو الجود لا قعبان من 
ms45	 لبن % % والجود بالنفس أقصى غاية الجود % % 28(@)(@@) % وسائل عن أبي الفتح اختصرت له % % صفاته في مقام غير مجحود % % PageV01P162 البحر : - 1(@)(@@) % مبارك الوجه سمح الكف مشتمل % % على الحفاظ وفي بالمواعيد % % 2(@)(@@) % تصبو إلى ملكه شم الحصون كما % % تصبو النفوس إلى الفتانة الرود % % 3(@)(@@) % فليس تظما وتضحى بعد ما التحفت % % بظل ملك ظليل منه ممدود % % 4(@)(@@) % رأت شمائل من غازي بن يوسف قد % % شهدن أنهما أطلعن من عود % % 5(@)(@@) % أبقى لها الله هذا كافلا وسقت % % سحائب العفو منها خير ملحود % % 6(@)(@@) % لله بحر نوال جف مشرعه % % وطود ملك هوى من بعد تشييد % % 7(@)(@@) % وليث غاب ترد الجيش سطوته % % أخنى عليه قضاء غير مردود % % 8(@)(@@) % صفا له مورد الدنيا فما لبثت % % حتى رمته بتكدير وتنكيد % % 9(@)(@@) % إن كانت الأرض أخفت شخص ظاهرها % % فبالعزيز سلونا كل مفقود % % 10(@)(@@) % هلال ملك تولى السعد مولده % % وما السعادة إلا في المواليد % % PageV01P163 11(@)(@@) % أرى السناجق تهوى أن تظلله % % في يوم حرب بنصر الله مشهود % % 12(@)(@@) % ومجلس العدل أضحى وهو منتظر % % لحكمه بين تشديد وتسديد % % 13(@)(@@) % هذا سليمان لكن سر خاتمه % % موسى فما ضره فقدان داود % % 14(@)(@@) % يا حارس الدين لما نام حارسه % % وناظما شمله من بعد تبديد % % 15(@)(@@) % يظنك الناس في خفض وفي دعة % % جهلا وكم مستريح الجسم مكدود % % 16(@)(@@) % جهز جيوشك إن الثغر قد عبثت % % به الفرنج فأضحى غير منضود % % 17(@)(@@) % أيدركون به أوتار قدسهم % % منكم وذلك ملك غير مردود % % 18(@)(@@) % يا للرجال أناديكم لنازلة % % تستنزل الماء من صم الجلاميد % % 19(@)(@@) % أين الحمية هبوا من منامكم % % إما لعاجل دنيا أو لمعبود % % 20(@)(@@) % مولاي خذها عروسا در لبتها % % من ابتكار وتزييد وتوليد % % PageV01P164 21(@)(@@) % واستقبل العيد في عز وفي نعم % % فالناس في كل يوم منك في عيد وقال يمدح أخاه الملك المظفر شهاب الدين غازيا % % PageV01P165 البحر : سريع 1(@)(@@) % حسبك لا يغني سؤال الديار % % فصرف الهم بصرف العقار % % 2(@)(@@) % واستنطق العيدان إن كنت ذا % % لب فما تنطق صم الحجار % % 3(@)(@@) % البم والزير وكأس الطلى % % أولى بمثلي من سؤال الديار % % 4 
ms46	(@)(@@) % شعشعها الساقي فقلنا له % % هل جمد الماء وذاب النضار % % 5(@)(@@) % مهفهف يجمع بين الرضى % % والسخط فاستئناسه في نفار % % 6(@)(@@) % ألف فيه الحسن أضداده % % فالعارض الجنة والخد نار % % 7(@)(@@) % قد كنت أهوى خده ساذجا % % فكيف حالي بعد رقم العذار % % PageV01P166 البحر : - 1(@)(@@) % هل حاكم ينصف قلبي فقد % % تحكم الحب عليه وجار % % 2(@)(@@) % ملكت ذا منطقة مهجتي % % فانتزعتها منه ذات السوار % % 3(@)(@@) % ولم يزل يكسف بدر الدجى % % إذا بدت أنوار شمس النهار % % 4(@)(@@) % مطلقة الثغر ولكنها % % ترسف من خلخالها في إسار % % 5(@)(@@) % خفيفة أثقلها حليها % % كما ارجحنت في الغصون الثمار % % 6(@)(@@) % ناعمة أخشى إذا ما مشت % % أن يسقط الرمان في الجلنار % % 7(@)(@@) % كالروضة الغناء أوتارها % % تغنيك عن بلبلها والهزار % % 8(@)(@@) % دلت ثناياها على أن ما % % يغلو من الجوهر إلا الصغار % % 9(@)(@@) % وشاحها من خصرها فارغ % % وردفها الوافر ملء الإزار % % 10(@)(@@) % أغار من عيني على خدها % % وحق لي في مثله أن أغار % % PageV01P167 11(@)(@@) % وليس لي عنها اصطبار كما % % ليس لغار عن نداه اصطبار % % 12(@)(@@) % ذاك شهاب الدين من بابه % % كعبة جود كلي يوم تزار % % 13(@)(@@) % محتجب بالجود يوم القرى % % متوج بالمجد يوم الفخار % % 14(@)(@@) % له بنان طافح بالندى % % فهن إما ديم أو بحار % % 15(@)(@@) % بيض الأيادي خضر روض الرضى % % حمر المواضي في العجاج المثار % % 16(@)(@@) % يقظان ربانية نفسه % % فما أسر الغيب منه استثار % % 17(@)(@@) % مؤيد تنصر أعلامه % % بجيش أقدار وجيش اقتدار % % 18(@)(@@) % يا ملكا أصبح نوم العدى % % خوف غراريه قليلا غرار % % 19(@)(@@) % استجل دنياك العروس التي % % جماجم الصيد عليها نثار % % 20(@)(@@) % من زلزل الأرض بغاراته % % قر ليده الملك هذا القرار % % PageV01P168 21(@)(@@) % واهن بعام مقبل مقبل % % يا أكرم الناس يدا أو نجار وقال يمدح الحاجب حسام الدين علي بن حماد الأشرفي % % PageV01P169 البحر : رجز تام 1(@)(@@) % هذا اللوى والحي من أمامه % % قد خفق البرق على أعلامه % % 2(@)(@@) % وهذه مرابع السرب الذي % % تخوف الآساد من آرامه % % 3(@)(@@) % من كل وسنان العيون لم يزل % % يحجب جفن الصب عن منامه % % 4(@)(@@) % يريك وجها وثنايا لمعا % % وقامه تهتز في التزامه 
ms47	 % % 5(@)(@@) % كالبدر في تمامه والدر في % % نظامه والغصن في قوامه % % 6(@)(@@) % تكاثر اللثم على خدوده % % فاعتاض من لثمي عن لثامه % % 7(@)(@@) % ومر يخفي خده بكمه % % فقلت هذا الورد في أكمامه % % 8(@)(@@) % كم ليلة وصلتها بشعره % % فلم أخف صبحا سوى ابتسامه % % 9(@)(@@) % تنوب لي خداه عن صباحه % % وريقه العاطر عن مدامه % % PageV01P170 البحر : - 1(@)(@@) % فليس للقلب خدين غيره % % وليس للدين سوى حسامه % % 2(@)(@@) % علي الحاجب لا أمواله % % وقامع المفسد بانتقامه % % 3(@)(@@) % كالغيث طورا مبرقا ومرعدا % % وماؤه لأمل انسجامه % % 4(@)(@@) % حامل عبء الملك لا يؤوده % % وطبه المبرىء من سقامه % % 5(@)(@@) % ولم يزل في سلمه وحربه % % مؤيد الآراء باهتمامه % % 6(@)(@@) % فكفر زمار على طعانه % % وقف وحران على طعامه % % 7(@)(@@) % يوم انثنى أتابك هزيمة % % منك يرى سيفك في أحلامه % % 8(@)(@@) % جمعت بالرأي قلوبا مزقت % % عليه فاستعصم بانهزامه % % 9(@)(@@) % مواقف مشكورة مشهورة % % جرى بها الملك على انتظامه % % 10(@)(@@) % ما الملك الأشرف إلا راشق % % رماه بالأصلب من سهامه % % PageV01P171 11(@)(@@) % أشكو إليك الدهر يا من يده % % مالكة للفضل من زمامه % % 12(@)(@@) % وسائل عن حالتي أجبته % % لا يسأل النائم عن منامه % % 13(@)(@@) % أنا بميا فارقين مثلما % % أقيل في حران في إنعامه % % 14(@)(@@) % بقيت ما غنى حمام أيكة % % في غلس الصبح وفي ظلامه وقال في صبي يهودي % % PageV01P172 البحر : سريع 1(@)(@@) % من آل إسرائيل علقته % % عذبني بالصد والتيه % % 2(@)(@@) % تنزل السلوى على قلبه % % وأنزل المن على فيه وقال % % PageV01P173 البحر : طويل 1(@)(@@) % تعلمت علم الكيمياء بحبه % % غزال بجسمي ما بجفنيه من سقم % % 2(@)(@@) % فصعدت أنفاسي وقطرت أدمعي % % فصح بذا التدبير تصفيرة الجسم وقال وقد سئل عن بيتين في أيام الملك العزيز رحمه الله % % PageV01P174 البحر : خفيف تام 1(@)(@@) % قلت لليل إذ حباني حببا % % وغناء يسبي النهى وعقارا % % 2(@)(@@) % أنت يا ليل حاجبي فامنع الصبح % % وكن أنت يا دجى برد دارا وللقاضي الفاضل عبد الرحيم بن علي البيساني في هذا المعنى بيتان وهما % % PageV01P175 البحر : سريع 1(@)(@@) % بتنا على حال يسر الهوى % % وربما لا يمكن الشرح % % 2(@)(@@) % بوابنا الليل وقلنا له % % إن غبت عنا دخل 
ms48	 الصبح % % PageV01P176 البحر : - 1(@)(@@) % لو كنت يا من يلومني عادل % % ما كنت فيمن هويته عاذل % % PageV01P177 البحر : - 1(@)(@@) % أصبحت في خدمة الغرام ولي % % جار من العين مطلق هامل % % 2(@)(@@) % قلبي بباقي هواه منكسر % % وحمل همي لأجله حاصل % % 3(@)(@@) % فخفف الآن عن فؤاد فتى % % عليه شغل من حبه شاغل % % 4(@)(@@) % ضل الكرى عن جفون مقلته % % فدمعه عنه لم يزل سائل % % 5(@)(@@) % ما سح في الخد قطر أدمعه % % إلا وأضحى خصيبها ماحل % % 6(@)(@@) % من لي بمرخي الأصداغ بلبلها % % كما يمد الحبائل الحابل % % 7(@)(@@) % الخمر والسحر في لواحظه % % قد شهدا لي بأنها بابل % % 8(@)(@@) % وخاله بالعذار ملتحف % % كحارس في خميلة خامل % % 9(@)(@@) % ما لي نصير على محبته % % والصبر لي فيه مثله خاذل % % 10(@)(@@) % الحمد لله بت في دعة % % لست لهم غير الهوى حامل % % PageV01P178 11(@)(@@) % والدهر بعد الجماح قد عطفت % % عنانه لي عناية الفاضل % % 12(@)(@@) % بحر إذا سح والسحاب معا % % يغيض غيظا منه الحيا الهاطل % % 13(@)(@@) % كم راع يوما يراعه بطلا % % أي شجاع في كفه ذابل % % 14(@)(@@) % من قصب السبق حازه فغدا % % بكل نعمى جسيمة ناحل % % 15(@)(@@) % من سيفه السم للعداة وفي % % راحة راجيه راحة الآمل وقال يمدحه % % PageV01P179 البحر : خفيف تام 1(@)(@@) % قمت ليل الصدود إلا قليلا % % ثم رتلت ذكركم ترتيلا % % 2(@)(@@) % ووصلت السهاد قبح وصلا % % وهجرت الرقاد هجرا جميلا % % 3(@)(@@) % مسمع كل عن كلام عذولي % % حين ألقى عليه قولا ثقيلا % % 4(@)(@@) % وفؤاد قد كان بين ضلوعي % % أخذته الأحباب أخذا وبيلا % % 5(@)(@@) % قل لراقي الجفون إن لجفني % % في بحار الدموع سبحا طويلا % % 6(@)(@@) % ماس عجبا كأنه ما رأى غصنا % % طليحا ولا كثيبا مهيلا % % 7(@)(@@) % وحمى عن محبه كأس ثغر % % حين أمسى مزاجها زنجبيلا % % 8(@)(@@) % بان عني فصحت في أثر العيس % % ارحموني وأمهلوهم قليلا % % 9(@)(@@) % أنا عبد العاضل بن علي % % قد تبتلت للثنا تبتيلا % % 10(@)(@@) % لا تسمه وعدا بغير نوال % % إنه كان وعده مفعولا % % PageV01P180 11(@)(@@) % وإذا كان خصمك الدهر والحكم % % إلى الله فاتخذه وكيلا % % 12(@)(@@) % جل عن سائر الخلائق مدحا % % فاخترعنا في مدحه التنزيلا % % 13(@)(@@) % إن مدحي 
ms49	 له أشد وطاء % % وقريضي أقوى وأقوم قيلا % % 14(@)(@@) % راع أعداءه بصفر اليراعات % % فأنسى صريرهن الصليلا % % 15(@)(@@) % فاستمع لفظه ولد بحماه % % تلق قولا جزلا ونيلا جزيلا ب % % 16(@)(@@) % لا أذم الزمان إذ كنت فيه % % يا سحاب الندى لرزقي كفيلا % % 17(@)(@@) % لي ديون على علاك وهذا % % وقت يسر فأوف واصنع جميلا % % 18(@)(@@) % أتمنى رزق المقيم على الله % % وإن رمت رحلة ونزولا وقال يمدح الصاحب الصفي بن شكر رحمه الله % % PageV01P181 البحر : خفيف تام 1(@)(@@) % ويح قلب المحب ماذا يقاسي % % كل قلب عليه كالصخر قاس % % 2(@)(@@) % يا جفوني أين الدموع فقد أحرق % % قلبي توقد الأنفاس % % 3(@)(@@) % وجد وجدي بحب لاه وأودى % % بفؤادي تذكاره وهو ناس % % 4(@)(@@) % من بني الترك لين العطف قاسي % % القلب سهل الخداع صعب المراس % % 5(@)(@@) % ضيق العين وهو من صفة البخل % % فإن جاد كان ضد القياس % % 6(@)(@@) % جذب القوس فاكتسب وجنتاه % % ثوب ورد طرازه من آس % % 7(@)(@@) % ورمى عن قوسين سهمين هذا % % في فؤادي وذاك في القرطاس % % 8(@)(@@) % فهو تحت السلاح ليث عرين % % وهو فوق الفراش ظبي كناس % % 9(@)(@@) % يا نديمي بالله عن بذكراه % % وموه عن ريقه بالكاس % % 10(@)(@@) % واغتنم لذة الزمان فما جلق % % إلا باللهو والإيناس % % PageV01P182 11(@)(@@) % حبذا النيربان من نهر ثورا % % واخضرار المروج من باناس % % 12(@)(@@) % والنسيم الذي يمر على الغوطة % % ريان عاطر الأنفاس % % 13(@)(@@) % بلدة حلها الوزير فمرعاها % % خصيب والناس في أعراس % % 14(@)(@@) % قل لرائيه قل أعوذ برب الناس % % هذا الوزير رب الناس % % 15(@)(@@) % هيبة تملأ القلوب وشخص % % تمتلي منه أعين الجلاس % % 16(@)(@@) % وذكاء يستفيض الأبحر السبع % % وحلم له تخر الرواسي وقال % % PageV01P183 البحر : سريع 1(@)(@@) % سال على وجنته عارض % % كالعرض القائم بالجوهر % % 2(@)(@@) % يا شعر لا تكذب على خده % % ما ذاك إلا زرد المغفر وقال % % PageV01P184 البحر : بسيط تام 1(@)(@@) % صنف من الترك والخدام قد بلغا % % بأقبح الفعل فينا غاية الأمل % % 2(@)(@@) % فسعد هذا بما قد قد من دبر % % فيه وهذا بما قد قد من قبل وقال بديها في الغلمان الذين يلعبون بالقرقسات في القرافة ليالي الوقود رحمه الله 
ms50	 % % PageV01P185 البحر : متقارب تام 1(@)(@@) % وغيد تعاودوا بليل الوقود % % وشيطان طرفي لهم يسرق % % PageV01P186 البحر : - 1(@)(@@) % فدلت ذوائب نيرانهم % % على أنها شهب تحرق % % PageV01P187 البحر : خفيف تام 1(@)(@@) % أعيونا أدارها أم عقارا % % فترى الناس حين يرنو سكارى % % 2(@)(@@) % كاتب قده إلى الخط يعزى % % بارع في فنونه لا يبارى % % 3(@)(@@) % خدمته روحي فأطلق لي من % % ناظر العين جاريا مدرارا % % 4(@)(@@) % وبذلت الهوى على خط خديه % % فأبقى علي منه انكسارا % % 5(@)(@@) % أصبحت مهجتي ضريبة جفنيه % % قد استوفاها ولم يخش عارا % % 6(@)(@@) % حمل همي به بغير وصول % % بجميع العشاق زاد اعتبارا % % 7(@)(@@) % يا شبيه الغزال طرفا وجيدا % % وفؤادا مستهضما ونفارا % % 8(@)(@@) % صنعة الكيمياء صحت لعيني % % حين تزداد إذ تراني احمرارا % % 9(@)(@@) % فإذا ما ألقيت أكسير لحظي % % في لجين الخدود صار نضارا % % 10(@)(@@) % رب ليل كشعره مستطيل % % حلت العيس في ذراه المدارا % % PageV01P188 11(@)(@@) % أرقصتها الحداة إذ خامرتها % % خمر سير لم تبق منه خمارا % % 12(@)(@@) % ليلة لا تغور أنجمها الغر % % إذا أنجد الدليل وغارا % % 13(@)(@@) % غير الليل فالمجرة فرق % % أشيب والهلال يحكي عذارا % % 14(@)(@@) % قصدنا أسعد فليس نبالي % % أن ركبنا في ابن الخطير الخطارا % % 15(@)(@@) % ماجد صور المهيمن يمناه % % من اليمن واليسار اليسارا % % 16(@)(@@) % ساحر الفضل ألف النفس والطرس % % ظلاما محلوكا ونهارا % % 17(@)(@@) % يحد الأسمر الطويل بيمناه % % إذا ما استمد سمرا قصارا % % 18(@)(@@) % ملحقي بالذين عثرني دهري % % عن شأوهم أقيل العثارا % % 19(@)(@@) % قد جلا خاطري جواري معان % % عربا إن فضضتها أبكارا % % 20(@)(@@) % لم أطلها وكل غصن قصير % % لا يعني من يجتني الأثمارا % % PageV01P189 21(@)(@@) % لو نظمت الشعرى العبور مديحا % % كان أولى نظمي الأشعارا % % 22(@)(@@) % رب هبني شكرا له فلقد قلدني % % أنعما جساما كبارا % % 23(@)(@@) % وكما زدته علوا وفضلا % % لا تزد حاسديه إلا تبارا وقال في الأعز بن شكر % % PageV01P190 البحر : كامل تام 1(@)(@@) % الله يكفي الملك أشأم طلعة % % أضحت تبشره بشر صباح % % 2(@)(@@) % بهق يلوح سواده في صفرة % % قد كرهت نظري إلى اللفاح % % 3(@)(@@) % شقيت به الأرواح بعد نعيمها % % فاقتصت الأرواح للأرواح وقال % % PageV01P191 البحر : مجزوء الرجز 1(@)(@@) % تبا لحماك التي 
ms51	 % % كست فؤادي ولها % % 2(@)(@@) % هل سألتك حاجة % % فأنت تهتز لها وقال % % PageV01P192 البحر : رجز تام 1(@)(@@) % يا طيف يا أكرم طيف قد طرق % % لمثله تعقد أجفان الحدق % % 2(@)(@@) % تراكضت خيل دموعي ودمي % % في حلبة الخد فللحمر السبق % % 3(@)(@@) % جدت فلولا أن أراك زائرا % % ما عتقت عيني من رق الأرق % % 4(@)(@@) % هل من سبيل أن أروي عطشي % % من برد الثغر الذي قد اتسق % % 5(@)(@@) % مهفهف جبينه وشعره % % ينتسبان للصباح والغسق % % 6(@)(@@) % خضرة خديه ربيع ناظري % % كالغصن في أول إخراج الورق % % 7(@)(@@) % حلو اللمى يميل من خمر الصبى % % طوبى لمن قبله أو اعتنق % % 8(@)(@@) % حذار من جمرة خديه فقد % % تجاسر الخال عليه فاحترق % % 9(@)(@@) % يا أيها العاذل ما لي سلوة % % عنه ولا حبي له كما اتفق % % 10(@)(@@) % دع الفؤاد عند ذكر حبه % % يخفق فالعذر له إذا خفق % % PageV01P193 11(@)(@@) % ما كنت يا طيب زمان وصله % % من دولة الصاحب إلا مسترق وقال % % PageV01P194 البحر : مجزوء الرجز 1(@)(@@) % لماك والخد النضر % % ماء الحياة والخصر % % 2(@)(@@) % أخذتني يا تاركي % % أخذ عزيز مقتدر % % 3(@)(@@) % أحلت سلواني على % % ضامن قلب منكسر % % 4(@)(@@) % ونمت عن ذي أرق % % إذا غفا النجم سهر % % 5(@)(@@) % وماء عيني التقى % % لا برحت على قدر % % 6(@)(@@) % ما نصبت أشراك % % ألحاظك إلا للحذر % % 7(@)(@@) % قلبي على الترك بهذا % % البدوي يفتخر % % 8(@)(@@) % ولي عهد البدر إن % % غاب فإني منتظر % % 9(@)(@@) % خلعت إذ بايعته % % عذار من لا يعتذر % % 10(@)(@@) % عقدة قاف صدغه % % تحل عقد المصطبر % % PageV01P195 11(@)(@@) % في خلقة وخلقه % % طبع الغزال والنمر % % 12(@)(@@) % ترعاه أحداق القنا % % فكيفما سار تسر % % 13(@)(@@) % إن طريق ناظري % % إلى محياه خطر وقال % % PageV01P196 البحر : طويل 1(@)(@@) % خدمت بديوان المحبة ناظرا % % على غرة يا ليتني فيه عامل % % 2(@)(@@) % وحاسب فرط السقم جسمي فلم تكن % % بواقيه إلا أعظم ومفاصل وقال في الصاحب % % PageV01P197 البحر : بسيط تام 1(@)(@@) % لا تقنطن إذا ما حالة عسرت % % وكن بإصلاحها مستوثق الأمل % % 2(@)(@@) % كانت بجيرون أوساخ فحين شكت % % أغاثها ربها بالصاحب بن علي % % PageV01P198 البحر : - 1(@)(@@) % هو الإمام الذي لولا هدايته % % تحير الناس في قول 
ms52	 وفي عمل % % PageV01P199 البحر : طويل 1(@)(@@) % أيا منعما شكري له الواجب الأولى % % ويا مخلصا لله في السر والنجوى % % 2(@)(@@) % خرجت لترتيب البناء فلو رأى % % سليمان ما شيدته قال لا أقوى % % 3(@)(@@) % فكم بنيت من قبلها من مدارس % % ولكنهم ما أسسوها على التقوى وقال معمى % % PageV01P200 البحر : خفيف تام 1(@)(@@) % أي شيء ملء السماوات والأرض % % وإن كان من صفات الحبيب % % 2(@)(@@) % هو طورا من الطعام بلا شك % % وطورا من أطيب المشروب % % 3(@)(@@) % لم يطق حمل ذرة وهو عن حمل % % القناطير ليس بالمغلوب وقال % % PageV01P201 البحر : بسيط تام 1(@)(@@) % كم ليلة بت لا ضوء الصباح أرى % % ولا الخيال ولا نومي علي بقي % % 2(@)(@@) % وليلة الوصل لما أن ظفرت بها % % لاح الصباح وقرص الشمس في الأفق وقال وقد سئل وهو في شدة من المرض هل تبت وتركت الخمر ارتجالا % % PageV01P202 البحر : منسرح 1(@)(@@) % الراح روحي فكيف أهجرها % % منظرها طيب ومخبرها % % 2(@)(@@) % راح إذا ما الفقير صافحها % % أغناه ياقوتها وجوهرها وقال % % PageV01P203 البحر : رجز تام 1(@)(@@) % وحق من بدل نومي بالسهر % % وعذب القلب بأنواع الفكر % % 2(@)(@@) % وأسقم الجفن بسقم جفنه % % وأسهر الطرف وللقلب أسر % % 3(@)(@@) % ما خلت ذاك الوجه لما أن بدا % % في جنح ليل شعره إلا قمر % % 4(@)(@@) % وهو فما ظن دموع مقلتي % % بما جرى من فيضها إلا مطر % % 5(@)(@@) % أحور والفتور حشو جفنه % % يا حبذا ذاك الفتور والحور % % 6(@)(@@) % مر بنا يخطر في مشيته % % والقلب من خطرته على خطر % % 7(@)(@@) % هز لنا من قده رمحا ومن % % ألحاظه يا عاذلي سيفا شهر % % 8(@)(@@) % مخالف إن قلت دع زيارتي % % زار وإن قلت له صلني هجر % % 9(@)(@@) % والله ما عاتبته إلا وفي % % ولا وفيت عهده إلا غدر وقال يهنيء علم الدين ابن الصاحب بالعافية % % PageV01P204 البحر : بسيط تام 1(@)(@@) % عفت المدام ولو ذابت من الذهب % % وقلدت بعقود الدر لا الحبب % % 2(@)(@@) % ولم أقل ليد الساقي ووجنته % % جل المؤلف بين الماء واللهب % % 3(@)(@@) % وملت عن لحن شاد عودت يده % % قود القلوب بأرسان من الطرب ب % % 4(@)(@@) % يا مجلس اللهو لا أصبو إليك 
ms53	 ولا % % شخص النديم إلى شخصي بمقترب % % 5(@)(@@) % ويا رقيب الذي أهواه نم فلقد % % كفيت مني ما تخشاه في رجب % % 6(@)(@@) % شهر عظيم كأن الله ألبسه % % خلائق العلم ابن السادة النجب % % 7(@)(@@) % الطاهر النسب ابن الطاهر النسب ابن % % الطاهر النسب ابن الطاهر النسب % % 8(@)(@@) % يغني إذا أعمل الآراء منتصرا % % عن الذوابل والهندية القضب % % 9(@)(@@) % غزا الأعادي في سلم فما علموا % % أن الكتائب تطوى باطن الكتب % % 10(@)(@@) % هنيت عافية من الإله بها % % على البرية من عجم ومن عرب وقال بيتا أبدع فيه % % PageV01P205 البحر : رمل تام 1(@)(@@) % لبق أقبل فيه هيف % % كل ما أملك إن غنى هبه وقال % % PageV01P206 البحر : سريع 1(@)(@@) % حديث دمعي عن غرامي شجون % % تنقله عني رواة الجفون % % 2(@)(@@) % عجبت من صحة أخبارها % % وقد تجرحن بدمع هتون % % 3(@)(@@) % بمهجتي أحور قد جمعت % % جفونه المرضى فنون الفتون % % 4(@)(@@) % صيغ من الدر وحاشاه أن % % يحول في مجلسنا أو يخون % % 5(@)(@@) % مغنيطس الخال على خده % % يجذب بالحسن حديد العيون % % 6(@)(@@) % أحسن وراق العذار الذي % % فتح عند الناس ما يسطرون % % 7(@)(@@) % سألته يمنحني قبلة % % فقال هذا أبدا لا يكون % % 8(@)(@@) % أدر دنانيرا فقد نثرت % % دراهم النور بنان الغصون % % 9(@)(@@) % عوذ جناني من جنون الهوى % % من لام صدغيه بقاف ونون % % 10(@)(@@) % فلا رعى الله زماني لقد % % هون من أمري ما لا يهون % % PageV01P207 11(@)(@@) % ألست من قوم إذا ما دجا % % ليل المنى بالنجم هو يهتدون وقال % % PageV01P208 البحر : كامل تام 1(@)(@@) % بين البنان وصدغه المعقود % % خمران من كأس ومن عنقود % % 2(@)(@@) % هذي تدار لنا بأبيض ناعم % % ترف وتلك تدار في توريد % % 3(@)(@@) % ساق كأن جبينه في شعره % % قمر تبلج في الليالي السود % % 4(@)(@@) % غصن ترنح ردفه في خصره % % فعجبت للمعدوم في الموجود % % 5(@)(@@) % وضاح در الثغر معسول اللمى % % متضايق الأجفان رحب الجيد % % 6(@)(@@) % يلوي على زرد العذار دلاله % % كم فتنة بين اللوى وزرود % % 7(@)(@@) % نبتت على الكافور مسكة خاله % % والمسك ينبت في الظباء الغيد % % PageV01P209 البحر : - 1(@)(@@) % في جفنه لمحبه وعدوه % % سيفان من لحظ وحد حديد % % 2(@)(@@) % هذا يقوم 
ms54	 على القلوب دليله % % قطعا وذاك السيف بالتقليد % % 3(@)(@@) % إياك والأتراك إن لبعضهم % % أشخاص غزلان وفعل أسود % % 4(@)(@@) % أجسامهم كالماء إلا أنها % % حملت قلوبا من صفا الجلمود % % 5(@)(@@) % هم أورثوا الجسم السقام وعذبوا % % أجفاننا بالدمع والتسهيد الجزء الثاني من القسم الأول ما ذكر في نسخة الأصل الثانية دون الأول وقال أيضا % % PageV01P210 البحر : سريع 1(@)(@@) % بيضاء تسطو بسواد أحداق % % تقلدت منها دماء العشاق % % 2(@)(@@) % في خدها ماء الشباب قد راق % % فطائر القلب عليه خفاق % % 3(@)(@@) % قد بلبلت قلب المحب المشتاق % % بسحر جفن هو فيه قد حاق % % 4(@)(@@) % شمس من الوشاح لا من إشراق % % لها أصيل من حلى وأعناق % % 5(@)(@@) % ترنمت كالورق بين الأوراق % % هي الغزال خلقة وأخلاق % % 6(@)(@@) % وشاحها الفارغ يشكو الإملاق % % وحجلها في ثروة من الساق % % 7(@)(@@) % وخالها في غرق وإحراق % % مثلي بين أدمع وأشواق % % 8(@)(@@) % قالت لطرفي وهو دامي الآماق % % قطعتني والقطع حد السراق % % 9(@)(@@) % إن رمقت لم يبق في أرماق % % والطرف سم والرضاب درياق % % 10(@)(@@) % في خدها صدغ كسطر إلحاق % % أو فحمة قد دب فيها إحراق % % PageV01P211 11(@)(@@) % وخالها حبة قلب المشتاق % % كم وعدت وما وفت بميثاق % % 12(@)(@@) % وكم دم بمقلتيها مهراق % % PageV01P212 البحر : بسيط تام 1(@)(@@) % قد بلغتك خطا المهرية الرسم % % دار الأحبة فاشكر نعمة النعم % % 2(@)(@@) % كرائم وهبت مسراك ما لبست % % وهن مثلك بين السهل والحرم % % 3(@)(@@) % لو كنت تنصف ما أرغمت آنفها % % ولا خضبت الحصى من خفها بدم % % 4(@)(@@) % يا نوق عذرا فإن الشوق كلفني % % إلى الحبيب بمسرانا فلا تلمي % % 5(@)(@@) % ما لي ولا لك بعد الدار من أرب % % هذي الظباء وبيت المورد الشبم % % 6(@)(@@) % من كل مخطفة الأعطاف مثقلة % % الأرداف ناعمة الأطراف كالعنم % % 7(@)(@@) % كأنما الثغر يهواها إذا خطرت % % مثلي فيلثم منها موطىء القدم % % 8(@)(@@) % كأنما الموت يجري في محاجرها % % وكل لحظ رسول طالب بدم % % 9(@)(@@) % يا أهلها قد كفتكم في صيانتها % % حمل الرديني والصمصامة الخذم % % 10(@)(@@) % وشاحها معدم والحجل مقتدر % % مثر كذاك اختلاف الرزق في القسم % % PageV01P213 11(@)(@@) % كأنما هي من لين ومن ترف % % ماء تجسد للأبصار 
ms55	 كالصنم % % 12(@)(@@) % إياك يا در عن لألاء لبتها % % وارجع إلى اليم والأصداف والظلم % % 13(@)(@@) % ولا تقل إنني من جنس مبسمها % % فأنت توجد بالأدنى من القيم % % 14(@)(@@) % عشق الغواني وعشق المجد مشتبه % % وإنما الفرق بين الناس بالهمم % % 15(@)(@@) % فعين هذا تراعي وصل غانية % % وعين موسى عن الإسلام لم تنم % % 16(@)(@@) % الأشرف الملك الوهاب مبتدئا % % شم الأنوف بما فيها من النعم % % 17(@)(@@) % نال العلى بيد بيضاء ما برحت % % من فوق كل يد أو تحت كل فم % % 18(@)(@@) % الله أكبر كم رزق وكم أجل % % يجريهما بين حد السيف والقلم % % 19(@)(@@) % ما الموج إلا التطام البحر من حسد % % له ولا البرق إلا خجلة الديم % % 20(@)(@@) % يا موقد النار للأضياف من كرم % % وموقد النار للأعداء من نقم % % PageV01P214 21(@)(@@) % فكم لسلمك من نار على علم % % وكم لحربك من نار على علم % % 22(@)(@@) % السيف مثلك طلق الوجه مبتسم % % إذا اكفهرت وجوه الخيل والبهم % % 23(@)(@@) % ما بين حر من الخرصان مضطرم % % ولج بحر من الماذي ملتطم % % 24(@)(@@) % هنالك البيض تفري الهام من شره % % وتكرع السمر في الأكباد من قرم % % 25(@)(@@) % هناك إن نفيس النفس معتقد % % أن البقاء له في حيز العدم % % 26(@)(@@) % بكر المعالي نفور قط ما أنست % % إلا لبذل نوال أو لسفك دم % % 27(@)(@@) % شرفت أيوب يا موسى كما شرفت % % بالمصطفى نفس إبراهيم في القدم % % 28(@)(@@) % أعدت للدين والدنيا وساكنها % % عصر الشبيبة بعد الشيب والهرم % % 29(@)(@@) % جود هو البحر أغنى الخلق كلهم % % فيه فقرب بين الناس كلهم % % 30(@)(@@) % أنا الذي شملتني منك عاطفة % % فما أقول على ما فات وا ندمي % % PageV01P215 31(@)(@@) % غرستني بيد أثرى ثراي بها % % فاقطف ثمار جني الشكر من كلمي % % 32(@)(@@) % واسعد بعيد رزقت الناس كلهم % % فيه ففزت بأجر الناس كلهم وقال يمدحه ويهنئه بفتح دمياط وأنشده إياها بقلعة نصيبين وهي آخر قصيدة قالها % % PageV01P216 البحر : بسيط تام 1(@)(@@) % يستوجب النصر من صحت عزائمه % % ويقتني الشكر من عمت مكارمه % % 2(@)(@@) % بالنفس والمال نال المجد طالبه % % إن العظيم لمن هانت عظائمه % % 3(@)(@@) % في كل دور لهذا الدين 
ms56	 منتظر % % يشيده بعدما تخفى معالمه % % 4(@)(@@) % فاليوم كل إمامي يوافقنا % % بأن شاه ارمن المهدي قائمه % % 5(@)(@@) % من يملأ الأرض عدلا بعدما ملئت % % جورا وتكشف عماها صوارمه % % 6(@)(@@) % يا يوم دمياط ما أبقيت من شرف % % لمن تقدم إلا أنت هادمه % % 7(@)(@@) % عذراء نادت على بعد فأنقذها % % ملك غيور مصونات كرائمه % % 8(@)(@@) % رأت بنو الأصفر الأعلام طالعة % % والنقع يرمد عين الشمس فاحمه % % 9(@)(@@) % والجيش يلتف قطراه على ملك % % كالليث يزأر حوليه ضراغمه % % 10(@)(@@) % والجو يبكي سهاما كلما ضحكت % % عن كل برق يماني غمائمه % % PageV01P217 11(@)(@@) % وكل طرف إذا طال الطراد به % % يطير من جلده لولا شكائمه % % 12(@)(@@) % وديون دمياط بحر حال بينهما % % من الظبي ليس ينجو منه عائمه % % 13(@)(@@) % صاحوا الأمان فلا سيف نضته يد % % منهم ولا حملت طرفا قوائمه % % 14(@)(@@) % ذلوا لملك أعز الله صاحبه % % موسى سليمانه والسيف خاتمه % % 15(@)(@@) % وسلموها وردوا أهلها ومضوا % % والثغر من فرح يفتر باسمه % % 16(@)(@@) % كأنهم أبصروا ما قد مضى زمنا % % كما يرى مزعج الأحلام نائمه % % 17(@)(@@) % طهرت محرابها العالي ومنبرها % % من رجسهم بعدما ارتجت قوائمه % % 18(@)(@@) % وقمت تكسر تمثال المسيح به % % برغم من هو باللاهوت لاثمه % % 19(@)(@@) % أشبهت جدك إبراهيم واتفقت % % على عزائمك العليا عزائمه % % 20(@)(@@) % قل للكماة وسرته سلامته % % أشد موت الفتى عار يلائمه % % PageV01P218 21(@)(@@) % عادوا بخزي إلى أوطانهم ومضوا % % فكل بيت تلقاهم مآتمه % % 22(@)(@@) % تبكي القسوس على أسرى ملوكهم % % وذاك ذل قضى بالعدل ظالمه % % 23(@)(@@) % يا باذلا في سبيل الله مهجته % % لله لا للذي حازت مغانمه % % 24(@)(@@) % لولاك زلزل قبر المصطفى ووهى % % وأصبح البيت قد حلت محارمه % % 25(@)(@@) % قضيت في الغرب مفروض الجهاد ولو % % فرغت للشرق ما قامت أعاجمه % % 26(@)(@@) % أنسيت من فتح عمورية شرفا % % ومات دون أبي تمام ناظمه % % 27(@)(@@) % أقول للحاسد المحزون ذا ملك % % نال السعادة مذ مدت تمائمه % % 28(@)(@@) % ماذا عطية نجم دار في فلك % % النجم والفلك الدوار خادمه % % 29(@)(@@) % هذا اختصاص إلهي ومرتبة % % ما في الملوك عليها من يزاحمه % % 30(@)(@@) % مولاي عذري سقم قد برى جسدي % % وكيف ينهض من قصت 
ms57	 قوادمه % % PageV01P219 31(@)(@@) % قالوا تأخرت والتأخير ينقضني % % من جود من عمت الدنيا مكارمه % % 32(@)(@@) % لا أرهب الدهر أن يثني مؤونته % % لا أختشي قطع رزقي وهو قاسمه % % 33(@)(@@) % لا فارقت ألسن المداح دولته % % فأحسن الروض ما غنت حمائمه وقال أيضا % % PageV01P220 البحر : منسرح 1(@)(@@) % إذا رأيت الهلال والغصنا % % ذكرت قدا ومنظرا حسنا % % 2(@)(@@) % مهفهف القد ما رنا ودنا % % إلا رأيت الغزال والغصنا % % 3(@)(@@) % كالروض عرفا وبهجة وجنى % % والبدر حسنا ورفعة وسنا % % 4(@)(@@) % جسمي ألفت السقام فيه كما % % أن جفوني لا تعرف الوسنا % % 5(@)(@@) % لله كم ليلة نعمت بها % % ما شابها قط ريبة وخنا % % 6(@)(@@) % أيام كان الحسود في سنة % % فانتبهت عينه ففرقنا القسم الثاني ما سقط من نسختي الأصل وورد في بعض النسخ وقال أيضا % % PageV01P221 البحر : رجز تام 1(@)(@@) % ظبي يخال البرق من بريقه % % غنيت عن إبريقه بريقه % % 2(@)(@@) % ولم أزل أشرب من رحيقه % % حتى سقيت القلب من حريقه وقال لما مرض بمدرسة حلب عند امرأة يقال لها علوة هذه الأبيات % % PageV01P222 البحر : خفيف تام 1(@)(@@) % حبذا طيف علوة حين أسرى % % من زياراته ففك الأسرى % % 2(@)(@@) % زارني والصباح قد لاح في الليل % % وقد . . للنسيم الفجرا % % 3(@)(@@) % وبنو نعش شاخصات إلى القطب % % حيارى والنسر يقفو الإثرا % % 4(@)(@@) % والمصابيح أطفأتها يد الصبح % % فشابت مفارق الروض ذعرا % % 5(@)(@@) % وسقيط الغمام يرشح درا % % فوق أوراقه فيصبح درا % % 6(@)(@@) % جادها وابل السماء رشاشا % % فهي تبكي طورا وتضحك طورا % % 7(@)(@@) % نفشتها أيدي الربيع فلا تزهر % % إلا بيضا وحمرا وصفرا % % 8(@)(@@) % يتلامعن في الدجى كالدنانير % % ويعطين في الدجنة عطرا % % 9(@)(@@) % وعلى سر ستر علوة بيت % % ما تراه العيون إلا شزرا % % 10(@)(@@) % ضربت دونها المضارب والتفت % % عليه الرجال شعثا وغبرا وقال % % PageV01P223 البحر : طويل 1(@)(@@) % دع العين تأخذ منك ما يشتهي القلب % % فقد حان يوم البين واحتمل الركب % % 2(@)(@@) % وقالوا صبا واستحسن العشق جاهلا % % ومن ذا رأى ما قد رأيت ولا يصبو % % 3(@)(@@) % وما لي ذنب غير أني أحبه % % وذلك ذنب تركه في الهوى ذنب % % 4(@)(@@) % وداري من دار الحبيب قريبة % % وما بيننا 
ms58	 رسل تمر ولا كتب % % 5(@)(@@) % أناديه من دون الحجاب مخاطبا % % فما ضر لو قد كشفت بيننا الحجب وقال % % 6(@)(@@) % قل لأحبابي كسوني الأرقا % % مات صبري فلهم طول البقا وقال % % 7(@)(@@) % قل لأحبابي كسوني الأرقا % % مات صبري فلهم طول البقا وقال في غلام بخال % % PageV01P224 البحر : طويل 1(@)(@@) % وبي هندسي الشكل يسبيك لحظه % % وخال وخد بالعذار مطرز % % 2(@)(@@) % ومذ خط بيكار الجمال بخده % % عذارا علمنا أنما الخال مركز وقال يمدح الصاحب نجم الدين بن المجاور العزيزي % % PageV01P225 البحر : خفيف تام 1(@)(@@) % بدر تم له من الشعر هاله % % من رآه من المحبين هاله % % 2(@)(@@) % قصر الليل حين ولى ولا غر % % وغزال غارت عليه الغزاله % % 3(@)(@@) % يا نسيم الصبا عساك تحملت % % لنا من سكان نجد رساله % % 4(@)(@@) % كل معسولة المراشف بيضاء % % حمتها سمر القنا العسالة % % 5(@)(@@) % عانقتني كصارمي وأدارت % % معصميها في عاتقي كالحماله % % 6(@)(@@) % إن بالرقمتين ملعب لهو % % بسطت دوحة علينا ظلاله % % 7(@)(@@) % معلم معلم وشى بسطه الزهر % % وحاكته ديمة هطالة % % 8(@)(@@) % وكأن الحمام فيه قيان % % أعربت لحنها على غير آله % % 9(@)(@@) % وكأن القضيب شمر للرقص % % سحيرا عن ساقه أذياله % % 10(@)(@@) % إن خوض الظلماء أطيب عندي % % من مطايا باتت بكل كلاله % % PageV01P226 11(@)(@@) % فهي مثل القسي شكلا ولكن % % هي في السبق أسهم لا محاله % % 12(@)(@@) % تركتها الحداة في الخفض والرفع % % حروفا في جرها عماله % % 13(@)(@@) % نحو باب الوزير يوسف نجم الدين % % نجل الحسين زين الجلاله % % 14(@)(@@) % كم له من رسالة تعجز الخلق % % كأن الباري بها أوحى له % % 15(@)(@@) % ذو يد موسوية ومحيا % % يوسفي إذا رأيت جماله % % 16(@)(@@) % يبسط الجود عندما يبسط السائل % % في نيل جوده آماله % % 17(@)(@@) % داره جنة النعيم فمن فاز % % بتقبيل تربها طوبى له ومن معانيه % % PageV01P227 البحر : خفيف تام 1(@)(@@) % ما انتفاعي بالقرب منكم إذا لم % % يكن القرب مثمرا للوداد % % 2(@)(@@) % كنت أشكو البعاد حتى التقينا % % فأنا اليوم شاكر للبعاد % % 3(@)(@@) % فعل القرب فوق ما فعل البعد % % بقلبي من كثرة الأنكاد % % 4(@)(@@) % ولعمري لقد تزايد ما بي % % من عذاب ولوعة وسهاد % % 5(@)(@@) % وإذا كنتم 
ms59	 من الله في خير % % وفي نعمة فذاك مرادي % % 6(@)(@@) % لو فعلتم بمهجتي ما فعلتم % % لم يحل فيكم صحيح اعتقادي غيره للقاضي كمال الدين بن النبيه % % PageV01P228 البحر : طويل 1(@)(@@) % وحق الهوى عن ذكركم ليس لي شغل % % وما أنا من ينسى المودة أو يسلو % % 2(@)(@@) % حرام على عيني ترى غير حسنكم % % جمالا وسمعي . . . عدل % % 3(@)(@@) % تعشقتكم طفلا وهمت بكم فتى % % وأنفقت عمري فيكم وأنا كهل % % 4(@)(@@) % وما كان أهنى العيش لولا تقلت % % ليالي . . . الصبر عن داركم يحلو % % 5(@)(@@) % رعى الله قلبا أنتم في ربوعه % % وسهد طرفي . . . . . . . . . . % 6(@)(@@) % وما زالت العشاق في مذهب الهوى % % يفرقها بين ويجمعها شمل % % 7(@)(@@) % وصب يعاني الغانيات وقلبه % % تكلمه الألحاظ والحدق النجل % % 8(@)(@@) % ومن يعشق البيض الحسان تيقنت % % شمائره بالقطع إن حصل الوصل % % 9(@)(@@) % ألا إن قلبي قد أصابته أسهم % % من البين حتى النصل صادفه النصل % % 10(@)(@@) % كأن مقادير الزمان قسيه % % رماني بها والحادثات لها نبل % % PageV01P229 11(@)(@@) % كم غرض فيه للحظ رشاق % % يجرحه وهو جريح الآماق % % 12(@)(@@) % حظي بعد بعدها والإحراق % % طويل هجر وهجير أشواق % % 13(@)(@@) % ذات ذوابات وثغر براق % % أبيضه لأسوديها درياق % % 14(@)(@@) % لو نقل الخاتم وهو سفاق % % من خنصري لخصرها لما ضاق % % 15(@)(@@) % للقلب أسر والدموع إطلاق % % في حبها فالدمع جار سباق % % 16(@)(@@) % وروضة أبدع فيها الخلاق % % لحسن مرأى وبطيب استنشاق % % 17(@)(@@) % تبسم عن دمع غرام رقراق % % رصع كالجوهر فوق الأوراق % % 18(@)(@@) % حكى على الأغصان درا متلاق % % أو منن الفاضل فوق الأعناق % % 19(@)(@@) % له يد قد قابلت باستحقاق % % بقبض أرواح وبسط أرزاق % % 20(@)(@@) % كم صرف العامل حرف قد فاق % % فوعده للخطب منه إشفاق % % PageV01P230 21(@)(@@) % دوحة أفضال تفوق الآفاق % % زكت فروعا ثم طابت أعراق % % 22(@)(@@) % للبشر في مرآه لمع براق % % يولي من استسقى وليا غيداق % % 23(@)(@@) % قلدني بيض الأيادي أطواق % % أما ترى سجعي بين الأوراق % % 24(@)(@@) % أقام للذة فينا أسواق % % يردفها من سر قلب إشراق % % 25(@)(@@) % إني وإن حذوت حذو الحذاق % % مقصر لصيغة الإستغراق % % 26(@)(@@) % هل يلحق النجم العلي لحاق % % أو قلة مثل خضم دفاق % % 27(@)(@@) % هنئت 
ms60	 عاما قد أتاك يشتاق % % تفني ألوفا منه في عز باق وله % % PageV01P231 البحر : سريع 1(@)(@@) % حديث عذل وغرام قديم % % جوانحي من برده في حميم % % 2(@)(@@) % وروضة فيها رقيب لنا % % يا ليته اعتل اعتلال النسيم % % 3(@)(@@) % ونافر آنست من خده % % نارا لها قلبي المعنى كليم % % 4(@)(@@) % فيها هوى قلبي لما مشى % % على صراط العارض المستقيم % % 5(@)(@@) % بنفسج فوق اللمى ذابل % % وورد خد تحت ماء النعيم % % 6(@)(@@) % وسنان من وسواس عيني به % % تواصل الغسل بماء النعيم % % 7(@)(@@) % كأن جسمي في دموعي وقد % % عاينته سلك ودر نظيم % % 8(@)(@@) % تداركي الأنفاس يا أدمعي % % فإنها نار وجسمي هشيم % % 9(@)(@@) % بصبح مرآة حمدت السرى % % يا ناظري في شعر ليل بهيم % % 10(@)(@@) % نام رقيبي عن حبيبي فقم % % يا ساقي الراح وقل يا نديم % % PageV01P232 11(@)(@@) % لا تنتح الأفراح إلا إذا % % مس ابنة الكرم ابن مزن كريم % % 12(@)(@@) % رقيقة صفراء فاعجب لها % % مزاجها منحرف مستقيم % % 13(@)(@@) % رشفت ساقيها وإبريقه % % كلاهما خيل لي منه ريم وله يستدعي بعض أصحابه إلى مجلس أنس % % PageV01P233 البحر : خفيف تام 1(@)(@@) % نحن في روضة وزهر ونهر % % ومدام كالشمس من كف بدر % % 2(@)(@@) % ومغن قد راسلته الشحارير % % فأغنت عن جس عود وزمر % % 3(@)(@@) % أنت روح ونحن جسم فإن غبت % % فإن القلوب تكوى بجمر % % 4(@)(@@) % إن كفا إليك قد كتبتها % % تتهادى ما بين سكر وشكر وله % % PageV01P234 البحر : سريع 1(@)(@@) % عثرت يا دهر فهل من مقيل % % وقلص الظل وما لي مقيل % % 2(@)(@@) % وغاض مائي وانطفت جذوتي % % وسد مسراي فما لي سبيل % % 3(@)(@@) % من بجس الصخر لموسى ومن % % أبدع في تبريد نار الخليل % % 4(@)(@@) % يعطف مقداما إلى نصرتي % % فقد شفى الأعداء مني الغليل % % 5(@)(@@) % وليس في الأرض جحيم ولا % % في هذه الدنيا حساب طويل % % 6(@)(@@) % مولاي يا من أمره نافذ % % ومن له الدست وظل ظليل % % 7(@)(@@) % ومن له البيت الرفيع الذي % % يرد طرف الدهر عنه كليل % % 8(@)(@@) % فيا وزير العصر لا تغترر % % من الأباطيل بقال وقيل % % 9(@)(@@) % فالحمد لله على ذا وذا % % وحسبنا الله ونعم الوكيل وله % % PageV01P235 البحر : مجزوء الرجز 