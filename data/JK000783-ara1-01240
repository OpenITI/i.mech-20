ms1221	 : نهانا رسول الله - [ & ] _ | أن نستب وقال : ' إن كان أحدكم سابا صاحبه فلا يعتري عليه ولا | يسبن والديه ولا يسبن قومه ولكن إن كان يعلم ذلك فليقل إنك مختال | أو ليقل إنك جبان أو ليقل إنك لكذوب أو ليقل إنك لئوم ' . |(@)(@@) 4612 - وبإسناده أن رسول الله - [ & ] - كان | يأمرنا أن نقرأ القرآن كما أقرأناه وقال : ' أنزل على ثلاثة أحرف فلا | تختلفوا فيه ولا تجافوا عنه فإنه مبارك كله اقرءوه كالذي أقرئتموه ' . | PageV10P450 |(@)(@@) 4613 - وبإسناده أن رسول الله - [ & ] - كان | يأمرنا إذا نام أحدنا عن الصلاة أو نسيها حتى يذهب حينها التي تصلى | فيه أن يصليها مع التي تليها من الصلاة المكتوبة . |(@)(@@) 4614 - وبإسناده أن رسول الله - [ & ] - كان | يأمرنا إذا أدركنا الصلاة ونحن ثلاثة أن يؤمنا واحد منا . |(@)(@@) 4615 - وبإسناده أن رسول الله - [ & ] - قال : ' إذا | أقمتم الصلاة فلا تسبقوا قارئكم بالركوع والسجود ولكن هو | يسبقكم فإذا كان حين السلام فسلموا على النبيين ، ثم سلموا على | قارئكم وعلى أنفسكم ' [ 257 ] . | PageV10P451 |(@)(@@) 4616 - وبإسناده أن رسول الله - [ & ] - كان | يأمرهم إذا كانوا في الصلاة أن لا يستوفزوا على أطراف الأقدام ويقول : | ' إذا نفث أحدكم في الصلاة فلا ينفثن قدام وجهه ولا عن يمينه ولكن | تحت قدمه ، ثم يدلكها بالأرض ' . |(@)(@@) 4617 - وبإسناده أن رسول الله - [ & ] - قال : ' إذا | تبايع الرجلان فإن كل واحد منهما بالخيار حتى يفارق صاحبه فيختار | كل واحد هواه من البيع ' . |(@)(@@) 4618 - وبإسناده أن رسول الله - [ & ] - كان | ينهى النساء أن يضطجع بعضهن مع بعض ، إلا وبينهن ثياب أو ثوب ولا | يضطجع الرجل مع صاحبه إلا وبينهما ثوب . | PageV10P452 |(@)(@@) 4619 - وبإسناده أن رسول الله - [ & ] - كان ينهى | أن يسل المسلم على المسلم السلاح . |(@)(@@) 4620 - وبإسناده أن رسول الله - [ & ] - قال : | ' المؤمن يأكل في معى واحد والكافر يأكل في سبعة أمعاء ' . |(@)(@@) 4621 - وبإسناده أن رسول الله - [ & ] - كان | يقول : ' أيكم ما صنع طعاما قدر ما يأكل رجلان فإنه يكفي ثلاثة أو | PageV10P453 | صنع طعاما قدر ما يكفي أربعة فإنه يكفي خمسة ' . |(@)(@@) 4622 - وبإسناده أن رسول الله - [ & ] - كان | يأمرنا أن نصنع المساجد في دورنا وننظفها 
ms1222	 ونطهرها إن شاء الله . |(@)(@@) 4623 - وبإسناده أن رسول الله - [ & ] - كان | يأمرنا أن نشهد الجمعة ولا نغيب عنها وقال : ' إن أحدكم أحق بمقعده | إذا رجع إليه ' . |(@)(@@) 4624 - وبإسناده أن رسول الله - [ & ] - كان | يقول : ' إذا نعس أحدكم يوم الجمعة فليتحول من مقعده إلى مكان | آخر ' . | PageV10P454 |(@)(@@) 4625 - وبإسناده أن رسول الله - [ & ] - أتاه رجل | من الأعراب يستفتيه في الذي يحرم عليه والذي يحل له فقال رسول الله | - [ & ] - : ' أحل لك الطيبات وحرم عليك الخبائث إلا أن | تضطر إلى طعام لا يحل لك فتأكل منه حتى تستغني ' . |(@)(@@) 4626 - وبإسناده أن رسول الله - [ & ] - كان | يأمرنا ألا نخرج الصدقة من الرقيق . |(@)(@@) 4627 - وبإسناده أن رسول الله - [ & ] - قال : ' لو | تعلمون ما أعلم لبكيتم كثيرا ولضحكتم قليلا ' . | PageV10P455 |(@)(@@) 4628 - وبإسناده أن رسول الله - [ & ] - كان | يقول لنا : ' إذا صلى أحدكم فليقل اللهم باعد بيني وبين خطيئتي | كما باعدت بين المشرق والمغرب اللهم إني أعوذ بك أن تصد عني | وجهك يوم القيامة الله نقني من الخطايا كما ينقى الثوب الأبيض | من الدنس اللهم أحيني مسلما وأمتني مسلما ' . |(@)(@@) 4629 - وبإسناده أن رسول الله - [ & ] - كان | يقول لنا : ' إن أحدكم يوشك أن يحب أن ينظر إلى نظرة واحدة أحب | إليه مما له من ماله ' . |(@)(@@) 4630 - وبإسناده أن رسول الله - [ & ] - كان | يقول نا : ' إنكم ستوشكوا أن تكونوا في الناس كالملح في الطعام ولا | يصح الطعام إلا بالملح ' . | PageV10P456 |(@)(@@) 4631 - وبإسناده أن رسول الله - [ & ] - قال : | ' ليس منكم رجل إلا وأنا ممسك بحجزته أن يقع في النار ' . |(@)(@@) 4632 - وبإسناده أن رسول الله - [ & ] - كان | ينهى عن النهبة . |(@)(@@) 4633 - وبإسناده أن رسول الله - [ & ] - كان | يقول : ' لا تقوم الساعة حتى يدل الحجر على اليهودي فيقول يا عبد | الله هذا - أحسبه قال - ورائي يهودي ' . |(@)(@@) 4634 - وبإسناده أن رسول الله - [ & ] - قال : ' إن | المسيح الدجال أعور عين الشمال عليها ظفرة غليظة يبرئ الأكمه | PageV10P457 | ويحيي الموتي ويقول أنا ربكم فمن اعتصم بالله فقال ربي الله حتى | يموت فلا عذاب عليه ومن قال أنت ربي فقد فتن ' . |(@)(@@) 4653 - وبإسناده أن النبي - [ & ] - قال : ' إن | المسيح الدجال يلبث في الأرض 
ms1223	 إذا خرج ما شاء الله ، ثم يجيء عيسى | ابن مريم - [ & ] - من المشرق مصدقا بمحمد | - [ & ] - وعلى ملته ، ثم يقتل المسيح الدجال ، ثم إنما هو بعد | قيام الساعة وسوف ترون قبل أن تقوم الساعة أشياء عظاما تقولون | هل كنا حدثنا بها فإذا رأيتم فاذكروا الله واعلموا أنها أوائل | الساعة ' . |(@)(@@) 4636 - وبإسناده أن رسول الله - [ & ] - قال : ' لا | يحل لرجل مسلم أن يجدع عبده ولا يخصيه فمن فعل به فعل به | مثله ' . | PageV10P458 |(@)(@@) 4637 - حدثنا خالد بن يوسف قال : حدثني أبي قال : نا | جعفر بن سعد بن سمرة قال : حدثني خبيب بن سليمان عن أبيه | سليمان بن سمرة عن سمرة بن جندب - رضي الله عنه - أن رسول الله | - [ & ] - كان يأمر بقرى الضيف ونهى أن نحتلب ماشية | الرجل إلا بإذنه ويقول : إنما ألبانها كما في جفانكم ' - أو كلمة نحوها - | ' ليس أحدها بأحل من الآخر ' . | PageV10P459(@)(@@) وهذا الحديث لا نعلم يروى عن سمرة إلا بهذا الإسناد . |(@)(@@) 4638 - وبإسناده أن رسول الله - [ & ] - كان | يقول : ' إن الشمس والقمر لا ينكسفان لموت أحد منكم ولكنهما | آيتان من آيات الله يستعتب بهما عباده لينظر من يخافه ومن يذكره | فإذا رأيتم ذلك فافزعوا إلى ذكر الله فاذكروه ' .(@)(@@) وهذا الحديث لا نعلم يروى عن سمرة إلا بهذا الإسناد ولا يروى | هذا اللفظ عن النبي - [ & ] - إلا من هذا الوجه . |(@)(@@) 4639 - وبإسناده أن رسول الله - [ & ] - كان | يقول : ' لا تلقوا الأجلاب قبل أن تأتي سوقها ولا تبيعوا للأعراب وإن | كان أخا أحدكم أو أباه أو أمه ' . | PageV10P460(@)(@@) وهذا الحديث لا نعلمه يروى عن سمرة إلا بهذا [ 258 ] الإسناد . |(@)(@@) 4640 - وبإسناده أن رسول الله - [ & ] - قال : ' من | باع أرضا أو دارا فإن جار الدار أو الأرض أحق بها ' . |(@)(@@) 4641 - وبإسناده أن رسول الله - [ & ] - كان | يقول : ' إذا أنكح المرأة الرجلان كلاهما فأحق الناكحين أولهما والبيع | إذا ابتاع الرجلان سلعة واحدة فأحقهما أولهما ' . | PageV10P461 |(@)(@@) 4642 - وبإسناده أن رسول الله - [ & ] - كان | ينهى عن الشغار بين النساء . |(@)(@@) 4643 - وبإسناده أن رسول الله - [ & ] - كان | ينهى إذا كانوا ثلاثة أن ينتجي اثنان منهم دون الثالث .(@)(@@) وهذا الحديث 
ms1224	 لا نعلمه يروى عن سمرة إلا بهذا الحديث . |(@)(@@) 4644 - وبإسناده أن رسول الله - [ & ] - كان | يأمرنا إذا غزونا فدعا رجل في أخرى القوم فقال يا أيها الأول أن ننتظره | حتى يلحق .(@)(@@) وهذا الحديث لا نحفظ كلامه إلا عن سمرة عن النبي - [ & ] - | بهذا الإسناد . | PageV10P462 |(@)(@@) 4645 - وبإسناده أن رسول الله - [ & ] - كان يأمر | المهاجرين أن يتقدموا وأن يكونوا مقدم الصفوف ويقول : ' هم أعلم | بالصلاة من السفهاء والأعراب ولا أحب أن تكون الأعراب أمامهم | ولا يدرون كيف الصلاة ' .(@)(@@) وهذا الكلام لا نعلم أحدا رواه عن النبي - [ & ] - | بهذا اللفظ إلا سمرة بهذا الإسناد . |(@)(@@) 4646 - وبإسناده أن رسول الله - [ & ] - كان | ينهى إذا دعي الرجل إلى الطعام أن يدعو معه أحدا أو آخر إلا أن يأمره | أهل الطعام .(@)(@@) وهذا الكلام لا نعلمه يروى إلا عن سمرة بهذا الإسناد . |(@)(@@) 4647 - وبإسناده أن رسول الله - [ & ] - قال : ' إن | في الجنة شجرة مستقلة على ساق واحد عرض ساقها اثنتين وسبعين | PageV10P463 | سنة ' .(@)(@@) وهذا الكلام لا نعلمه يروى بهذا اللفظ إلا عن سمرة بهذا الإسناد . |(@)(@@) 4648 - وبإسناده أن رسول الله - [ & ] - كان | يقول لنا : ' إن اسم الرجل الكرم من أجل ما كرمه الله على الخليقة | إنكم تدعون العنب وإنما اسمه الجوهر هو الرجل وهو الكرم ' .(@)(@@) وهذا الكلام قد روي معناه عن رسول الله - [ & ] - | وأما لفظ الحديث فلا نعلم رواه إلا سمرة بهذا الإسناد . |(@)(@@) 4649 - وبإسناده أن رسول الله - [ & ] - كان | يقول لنا : ' إن الفردوس هي ربوة الجنة الوسطى التي هي أرفعها | وأحسنها ' . |(@)(@@) 4650 - وبإسناده أن رسول الله - [ & ] - كان | يقول : ' إن الرجل لا تمتلئ نفسه من المال حتى تمتلئ من التراب ولو | PageV10P464 | لأحدكم واد ملآن ما بين أعلاه إلى أسفله أحب أن يملأ له واد آخر | فإن ملئ الواد الآخر فانطلق فوجد واد آخر قال أما والله لو | استطعت لملأتك ' .(@)(@@) وهذا الكلام لا نعلمه يروى عن سمرة إلا بهذا الإسناد وقد روي | في نحو كلامه بغير لفظه عن النبي - [ & ] - من وجوه . |(@)(@@) 4651 - وبإسناده أن رسول الله - [ & ] - كان | يقول : ' إني لأجد من الدواب الدابة خير من مائة ومن 
ms1225	 الرجال الرجل | خير من مائة رجل ' .(@)(@@) وهذا الكلام لا نعلمه يروى بهذا اللفظ إلا عن سمرة بهذا الإسناد | وإن كان قد روي عن النبي - [ & ] - نحو من معناه . | PageV10P465 |(@)(@@) 4652 - وبإسناده أن رسول الله - [ & ] - كان إذا | غزا أو سافر فأقبل راجعا إلى المدينة قال : ' آيبون حامدون لربنا | عابدون ' .(@)(@@) وهذا الكلام لا نعلمه يروى عن سمرة إلا بهذا الإسناد . |(@)(@@) 4653 - وبإسناده أن رسول الله - [ & ] - كان | ينهاهم يوم ورد حجر ثمود عن ركية عند جانب المدينة أن يشرب منها | أحد أو يستقي ونهانا أن نتولج بيوتهم . |(@)(@@) 4654 - وبإسناده أن رسول الله - [ & ] - قال : | ' إياكم والغلو فإن بني إسرائيل قد غلا كثير منهم حتى كانت المرأة | القصيرة تتخذ خفين من خشب فتحشوهما ، ثم تولج فيهما رجليها ، ثم | تقوم إلى جنب المرأة الطويلة فتمشي معها فإذا هي قد ساوت بها أو | كانت أطول منها ' . | PageV10P466(@)(@@) وهذا الكلام لا نعلمه يروى عن سمرة إلا بهذا الإسناد . |(@)(@@) 4655 - وبإسناده أن رسول الله - [ & ] - كان إذا | استسقى للمطر قال : ' اللهم اجعل في أرضنا زينتها اللهم اجعل في | أرضنا سكنها ' . |(@)(@@) 4656 - وبإسناده أن رسول الله - [ & ] - قال لهم | يوم الفتح ' إن هذا العام الحج الأكبر قد اجتمع حج المسلمين وحج | المشركين في ثلاثة أيام متتابعات واجتمع حج النصارى واليهود في ستة | أيام متتابعات ولم يجتمع منذ خلقت السموات والأرض ولا يجتمع بعد | العام حتى تقوم الساعة ' . | PageV10P467(@)(@@) وهذا الكلام لا نعلمه يروى عن النبي - [ & ] - إلا | عن سمرة بهذا الإسناد . |(@)(@@) 4657 - حدثنا خالد بن يوسف بن خالد قال : حدثني أبي | قال : نا جعفر بن سعد بن سمرة قال : حدثني خبيب بن سليمان بن | سمرة عن أبيه سليمان بن سمرة عن سمرة بن جندب - رضي الله عنه - | عن النبي - [ & ] - أنه قال : [ 259 ] ' غفار غفر الله لها | وأسلم سالمها الله ' .(@)(@@) وهذا الحديث لا نعلمه يروى عن سمرة إلا بهذا الإسناد . |(@)(@@) 4658 - وبإسناده أن رسول الله - [ & ] - قال : ' لا | تحلفوا بالطواغي ولا تحلفوا بآبائكم واحلفوا بالله ' . | PageV10P468(@)(@@) وهذا الحديث لا نعلمه يروى عن سمرة إلا بهذا الإسناد . |(@)(@@) 4659 - وبإسناده أن رسول 
ms1226	 الله - [ & ] - كان | يقول : ' إن العرب بنو سام بن نوح والروم بنو يافث بن نوح والحبشة | بنو حام بن نوح ' . |(@)(@@) 4660 - وبإسناده أن رسول الله - [ & ] - كان | يقول : ' إذا قاتلكم المشركون فاقتلوا شيوخهم واستحيوا شرخهم ' . |(@)(@@) 4661 - وبإسناده أن رسول الله - [ & ] - قال : ' لا | تكمل شهرين ستين ليلة ' . | PageV10P469(@)(@@) ومعنى هذا الحديث ما قال رسول الله - [ & ] - :(@)(@@) شهرا عيد لا ينقصان رمضان وذو الحجة ' قال : لا يكونا ثمانية | وخمسين . |(@)(@@) 4662 - وبإسناده أن رسول الله - [ & ] - كان إذا | لعن المشركين في الصلاة يبدأ بقريش ، ثم يتبعهم بعد ذلك قبائل كثيرة من | العرب فقيل له العن كفار قريش فجعل النبي - [ & ] - | يقول إذا أراد أن يلعن قبيلة : ' اللهم العن كفار بني فلان ' .(@)(@@) وهذا الكلام لا نعلم رواه عن النبي - [ & ] - إلا | سمرة . |(@)(@@) 4663 - وبإسناده أن رسول الله - [ & ] - قال : ' إنه | قيل لي اقرأ على عمر بن الخطاب ' فدعاه فأمره أن يحضر القرآن إذا نزل | ليقرأه عليه . | PageV10P470(@)(@@) وهذا الكلام لا نعلمه يروى إلا عن سمرة بهذا الإسناد . |(@)(@@) 4664 - وبإسناده أن رسول الله - [ & ] - كان | يستغفر للمؤمنين والمؤمنات والمسلمين والمسلمات كل جمعة .(@)(@@) وهذا الكلام لا نعلمه يروى عن النبي - [ & ] - بهذا | اللفظ إلا عن سمرة بهذا الإسناد . |(@)(@@) 4665 - وبإسناده أن رسول الله - [ & ] - كان | يقول لنا : ' إن أبا بكر يتأول الرؤيا والرؤيا الصالحة حظ من النبوة ' .(@)(@@) ولا نعلم يروى هذا الكلام إلا عن سمرة بهذا الإسناد . |(@)(@@) 4666 - وبإسناده أن رسول الله - [ & ] - كان | يقول لنا : ' من قتل قتيلا فإن له سلبه ' . | PageV10P471(@)(@@) ولا نعلم يروى هذا الكلام عن سمرة إلا بهذا الكلام . |(@)(@@) 4667 - وبإسناده أن رسول الله - [ & ] - كان | يقول لنا : ' من قتل منكم صابرا يقتل في سبيل الله فإنه في الجنة ' .(@)(@@) وهذا الكلام لا نعلمه يروى عن سمرة إلا بهذا الإسناد . |(@)(@@) 4668 - وبإسناده أن رسول الله - [ & ] - كان | يقول : ' ليس في الدنيا حسد إلا في اثنتين رجل يحسد الرجل أن يعطيه | المال الكثير فينفق منه فيكثر النفقة فيقول الآخر لو كان لي مثل مال | هذا لأنفقت مثل ما ينفق ، ولأنفقته في مثل ما ينفق فهو يحسده ورجل | علمه الله القرآن 
ms1227	 - أحسبه قال - فهو يقوم به فيقول لو علمني الله مثل | هذا لقمت مثل ما يقوم ' . | PageV10P472(@)(@@) ولا نعلم يروي هذا الكلام عن سمرة إلا بهذا الإسناد . |(@)(@@) 4669 - وبإسناده أن رسول الله - [ & ] - قال : | ' مثل المرأة كالضلع إن أراد أن يقيم الضلع لم يستطع أن يقيمه حتى | يكسره وهي عوجاء ' . |(@)(@@) 4670 - وبإسناده أن رسول الله - [ & ] - كان | يقول : ' إنكم تحشرون إلى بيت المقدس ، ثم تجتمعون يوم القيامة ' . | PageV10P473 |(@)(@@) 4671 - وبإسناده أن رسول الله - [ & ] - جعل | شعار المهاجرين يا بني عبد الرحمن وشعار بني الخزرج يا بني عبد الله | وشعار الأوس يا بني عبيد الله . |(@)(@@) 4672 - وبإسناده أن رسول الله - [ & ] - كان | يقول لنا : ' يدخل الجنة سبعون ألفا بغير حساب - أحسبه قال - من | هذه الأمة ' . |(@)(@@) 4673 - وبإسناده أن رسول الله - [ & ] - كان | يأمرنا إذا فزعنا بالجماعة والصبر والسكينة وإذا قاتلنا . |(@)(@@) 4674 - حدثنا خالد بن يوسف بن خالد قال : نا أبي قال : نا | جعفر بن سعد قال : نا خبيب بن سليمان عن أبيه سليمان بن | سمرة عن سمرة بن جندب - رضي الله عنه - أن رسول الله - [ & ] - | PageV10P474 | كان ينهى رب النخل أن يتدين في ثمرة نخله حتى يؤكل من | ثمرها مخافة أن يتدين بدين كثير ، ثم تفسد الثمرة وكان ينهي رب الزرع أن لا يدان في زرعه حتى يبلغ الحصاد . |(@)(@@) 4675 - وبإسناده أن رسول الله - [ & ] - كان | يقول لنا : ' والله ما يسرني أن لي أحدا ذهبا كله ' . |(@)(@@) 4676 - وبإسناده أن الرسول - [ & ] - أتاه رجل | يستفتيه في أكل الضب فقال : ' لست آمر به ولا أنهى عنه ' . |(@)(@@) 4677 - وبإسناده أن رسول الله - [ & ] - نهانا عن | PageV10P475 | الحمار الأهلي وأمرنا بإلقاء ما معنا منه فألقيناه . |(@)(@@) 4678 - وبإسناده أن رسول الله - [ & ] - قال : ' إن | لأحدكم يوم يموت ثلاثة أخلاء منهم من يمنعه ما سأله فذلك ماله | ومنهم خليل ينطلق معه حتى يلج القبر لا يعطيه شيئا ولا يمنعه فأولئك | قرابته ومنهم خليل يقول أنا معك أذهب معك حيث ذهبت ولست | بمفارقك أبدا فذلك عمله إن كان خيرا وإن كان شرا ' . |(@)(@@) 4679 - وبإسناده أن رسول الله - [ & ] - كان | ينهى أن يقد الرجل 
ms1228	 السير بين أصبعيه أو كان ينهى [ 260 ] أحدنا أن | يقد السير بين أصبعيه . |(@)(@@) 4680 - وبإسناده أن رسول الله - [ & ] - كان | يقول : ' إذا طالب الرجل الآخر فدعا أحدهما صاحبه إلى الذي يقضي | بينهما فأبى أن يجيئ فلا حق له ' . | PageV10P476 |(@)(@@) 4681 - وبإسناده عن رسول الله - [ & ] - أنه كان | إذا مطرنا في السفر ونودي بالصلاة يأمر المؤذن فينادي : صلوا في رحالكم | كراهية أن يشق علينا .(@)(@@) آخر مسند سمرة | وهو آخر السابع والثلاثين والحمد لله كثيرا كما هو أهله ، ثم | الصلاة على محمد نبيه وعبده وسلم . | PageV10P477 |(@)(@@) | مسند | ابن عباس | رضي الله عنهما(@)(@@) | PageV11P011 |(@)(@@) | ما روى جابر بن عبد الله عن ابن عباس(@)(@@) 4682 - أخبرنا أبو الحسن محمد بن أيوب بن حبيب الرقي قال : | نا أبو بكر أحمد بن عمرو البزار قال : نا إبراهيم بن سعيد الجوهري قال : | نا أزهر بن سعد عن سليمان التيمي عن خداش عن أبي الزبير عن | جابر عن ابن عباس . |(@)(@@) 4683 - وحدثنا بشر بن آدم قال : نا جدي أزهر بن سعد عن | سليمان التيمي عن خداش ، عن أبي الزبير عن جابر عن ابن عباس | - رضي الله عنهم - قال : قال رسول الله - [ & ] - : | ' ليدخلن الجنة من بايع تحت الشجرة إلا صاحب الجمل الأحمر ' .(@)(@@) وهذا الحديث لا نعلم أحدا رواه فقال عن جابر عن ابن عباس إلا | PageV11P012 | أزهر عن التيمي عن خداش ولا نعلم أحدا تابعه عليه ولم يرو جابر عن | ابن عباس إلا حديثين بهذا الإسناد جميعا رواهما أزهر . |(@)(@@) 4684 - وحدثنا إبراهيم بن سعيد الجوهري قال : نا أزهر عن | سليمان التيمي عن خداش عن أبي الزبير عن جابر عن ابن | عباس . |(@)(@@) 4685 - وحدثنا بشر بن آدم قال حدثني جدي أزهر بن سعد | عن سليمان التيمي عن خداش عن أبي الزبير عن جابر عن ابن | عباس - رضي الله عنهم - قال : قال رسول الله - [ & ] - : | PageV11P013(@)(@@) ' إذا استلقى أحدكم فلا يضع إحدى رجليه على الأخرى ' .(@)(@@) وهذا الحديث رواه غير واحد عن جابر عن النبي - [ & ] - | ولم يقل أحد عن جابر عن ابن عباس إلا أزهر عن التيمي عن | خداش وخداش 
ms1229	 لا نعلم روى عنه إلا التيمي ومحمد بن ثابت العصري | وخداش بصري . | PageV11P014 |(@)(@@) | أنس عن ابن عباس(@)(@@) 4686 - حدثنا بشر بن آدم ومحمد بن يحيى القطعي قالا : نا | عبد الصمد قال : نا هشام عن قتادة عن أنس أن عليا - رضي الله | عنه - أتي بناس من الزط فأراد أن يحرقهم فقال ابن عباس : قال رسول الله | - [ & ] - : ' من بدل دينه فاقتلوه ' .(@)(@@) وهذا الحديث لا نعلم رواه إلا عبد الصمد ولا أسند أنس عن ابن | عباس إلا هذا الحديث . | PageV11P015 |(@)(@@) | أبو الطفيل عن ابن عباس(@)(@@) 4687 - حدثنا محمد بن عثمان بن كرامة قال : نا عبيد الله بن | موسى قال : نا فطر عن أبي الطفيل قال : قلت لابن عباس : إن قومك | يزعمون أن النبي - [ & ] - قد رمل وأنها سنة فقال : كذبوا | وصدقوا ، قد رمل رسول الله - [ & ] - وليست سنة ، قدم | رسول الله - [ & ] - والمشركون على جبل قعيقعان ، فبلغه | أنهم يقولون : إن برسول الله وأصحابه هزلا ، فرمل رسول الله - [ & ] - | وأمر أصحابه ليرملوا ؛ ليرى المشركون أن بهم قوة . |(@)(@@) 4688 - حدثنا الحسين بن مهدي قال : أنا عبد الرزاق قال : أنا | معمر عن ابن خثيم عن أبي الطفيل عن ابن عباس عن النبي - [ & ] - . | PageV11P016 |(@)(@@) 4689 - وحدثناه نصر بن علي قال : أنا عبد الأعلى قال : نا | الجريري عن أبي الطفيل عن ابن عباس عن النبي - [ & ] - | بنحو حديث فطر عن أبي الطفيل ، عن ابن عباس في قدوم | النبي - [ & ] - مكة .(@)(@@) وهذا الحديث قد روي عن ابن عباس من وجوه وروي عن أبي | الطفيل عن ابن عباس من غير وجه وفيمن ذكرنا مقنع ، إلا أن يزيد غير | من ذكرنا كلاما فيكتب من أجل الزيادة . |(@)(@@) 4690 - حدثنا بشر بن معاذ العقدي قال : نا فضيل بن سليمان | قال : نا عبد الله بن عثمان بن خثيم عن سعيد بن جبير وأبي الطفيل عن | ابن عباس - رضي الله عنهم - أن النبي - [ & ] - نظر إلى | مكة فقال : ' إنك لأحب أرض الله إلى الله ، ولولا أن قومي أخرجوني | منك ما خرجت ' . | PageV11P017 | وهذا الحديث قد روي عن أبي هريرة وغيره ، ولا نعلمه يروى عن | ابن عباس 
ms1230	 بإسناد أحسن من هذا الإسناد ، وقد قال بعض من رواه عن ابن | خثيم : عن سعيد بن جبير عن ابن عباس ولم يذكر أبا الطفيل وجمعهما | بشر عن فضيل . |(@)(@@) 4691 - حدثنا الحسين بن مهدي قال : أنا عبد الرزاق قال : أنا | معمر عن ابن خثيم عن أبي الطفيل قال : قال ابن عباس - رضي الله عنه : | إنما استلم رسول الله - [ & ] - الحجر الأسود والركن | اليماني ، فقال معاوية : ليس من البيت [ شيئا مهجورا ] واستلم الأركان | كلها . | PageV11P018(@)(@@) وهذا الحديث قد روي نحو كلامه عن غير ابن عباس ، وقد روي | عن ابن عباس من غير هذا الوجه ، وهذا الإسناد أحسن إسناد يروى في | ذلك عن ابن عباس . | PageV11P019 |(@)(@@) | سعيد بن المسيب عن ابن عباس(@)(@@) 4692 - حدثنا محمد بن المثنى أبو موسى قال : نا محمد بن | جفعر قال : نا شعبة عن قتادة عن سعيد بن المسيب ، عن ابن عباس | عن النبي - [ & ] - . |(@)(@@) 4693 - وحدثنا أبو موسى قال : نا ابن أبي عدي عن سعيد بن | أبي عروبة ، عن قتادة عن سعيد بن المسيب [ 261 ] عن ابن عباس عن | النبي - [ & ] - . |(@)(@@) 4694 - حدثنا أبو موسى قال : نا الوليد بن مسلم ، قال : نا | PageV11P020 | الأوزاعي ، عن محمد بن علي ، عن سعيد بن المسيب ، عن ابن عباس ، عن | النبي - [ & ] - . |(@)(@@) 4694 م - وحدثنا عمر بن الخطاب قال : نا عبد الله بن صالح | قال : نا بكر بن مضر عن عمر بن الحارث ، عن بكير بن عبد الله | عن سعيد بن الميسب ، عن ابن عباس - رضي الله عنهم - ، عن النبي | - [ & ] - قال : ' العائد في هبته كالعائد في قيئه ' . | PageV11P021(@)(@@) وهذا الحديث قد روي عن ابن عباس من وجوه ، وهذه الأسانيد | أحسن أسانيد تروى عن سعيد بن المسيب عن ابن عباس وأجل من روى | هذا الحديث عن ابن عباس سعيد بن المسيب . |(@)(@@) 4695 - حدثنا إبراهيم بن هاني قال : نا محمد بن عثمان أبو | الجماهر قال : نا خليد بن دعلج عن قتادة عن سعيد بن المسيب عن ابن | عباس - رضي الله عنهما - قال : قال رسول الله - [ & ] - : | ' من فارق الجماعة قياس - أو قيد شبر 
ms1231	 - فقد خلع ربقة الإسلام من | عنقه ، ومن مات ليس عليه إمام فميتته ميتة جاهلية ، ومن مات تحت | راية عمية يدعو إلى عصبة أو ينصر عصبة ، فقتلته قتلة جاهلية ' .(@)(@@) وهذا الحديث لا نعلم أحدا يرويه عن ابن عباس من هذا الوجه بهذا | الإسناد ، ولا نعلم روى هذا الحديث إلا خليد بن دعلج ، وخليد رجل | مشهور حديث عنه الوليد بن مسلم وأبو الجماهر والنفيلي وغيرهم . |(@)(@@) 4696 - حدثنا إبراهيم بن هانئ قال : نا يحيى بن عثمان قال : نا | إسماعيل بن عياش عن عبد الرحمن بن سليمان عن أبي سعيد عن | PageV11P022 | معاوية بن إسحاق عن سعيد بن المسيب قال : سمعت ابن عباس - رضي | الله عنهما - يقول : قال رسول الله - [ & ] - : ' من مشى إلى | غريمه بحقه صلت عليه دواب الأرض ونون الماء ، ونبتت له بكل خطوة | شجرة تغرس في الجنة وذنب يغفر ' .(@)(@@) وهذا الحديث لا نعلم أحدا يرويه عن النبي - [ & ] - | إلا ابن عباس ولا نعلم له طريقا غير هذا الطريق . | PageV11P023 |(@)(@@) 4697 - حدثنا محمد بن مرزوق قال : نا مسلم بن إبراهيم قال : | نا أبان بن يزيد قال : نا قتادة عن سعيد بن المسيب وعكرمة عن ابن | عباس - رضي الله عنهما - أن وفد عبد القيس أتوا نبي الله - [ & ] - | فقالوا : يا رسول الله ، إنا ناس من ربيعة وإن بيننا وبينك | كفار مضر ، وإنا لا نصل إليك إلا في شهر حرام ، فمرنا بأمر إذا علمناه | دخلنا الجنة ، وندعو إليه من وراءنا ، فأمرهم ونهاهم عن أربع : ' أن يعبدوا | الله لا يشركوا به شيئا ، ويقيموا الصلاة ، ويؤتوا الزكاة ، ويصوموا | رمضان ، ويحجوا البيت ، ويعطوا الخمس من المغانم ، ونهاهم عن الحناتم | والدباء والمزفت والنقير ' فقالوا : فيم نشرب ؟ قال : ' اشربوا على التي | يلاث على أفواهها ' .(@)(@@) وهذا الحديث لا نعلم رواه عن قتادة عن سعيد بن المسيب | وعكرمة عن ابن عباس إلا أبان بن يزيد . | PageV11P024 |(@)(@@) | طاوس عن ابن عباس(@)(@@) 4698 - حدثنا أبو كامل الفضيل بن الحسين الجحدري قال : نا | عبد الوارث - يعني : ابن سعيد - عن أيوب عن عمرو بن دينار عن | طاوس عن ابن عباس عن 
ms1232	 النبي - [ & ] - . |(@)(@@) 4699 - وحدثنا عمرو بن علي قال : نا عبد الرحمن قال : نا | سفيان عن عمرو بن دينار عن طاوس عن ابن عباس - رضي الله عنهما - | عن النبي - [ & ] - قال : ' من اشترى طعاما فلا يبعه حتى | يقبضه ' .(@)(@@) وهذا الحديث قد رواه غير واحد عن طاوس ، ورواه جماعة عن | عمرو بن دينار عن طاوس فاقتصرنا على من سمينا دون غيره . |(@)(@@) 4700 - وحدثنا المنذر بن الوليد الجارودي قال : نا أبي عن الحسن | PageV11P025 | ابن أبي جعفر عن أيوب ، عن عمرو بن دينار عن طاوس عن ابن | عباس عن النبي - [ & ] - . |(@)(@@) 4701 - وحدثناه عمرو بن علي قال : نا محمد بن جعفر قال : | نا شعبة عن عمرو عن طاوس عن ابن عباس عن النبي - [ & ] . |(@)(@@) 4702 - وحدثنا محمد بن عبد الملك قال : نا حماد - يعني : ابن | زيد - عن عمرو بن دينار عن طاوس عن ابن عباس عن النبي - [ & ] . | PageV11P026 |(@)(@@) 4703 - وحدثناه أبو كامل قال : نا أبو عوانة عن عمرو عن | طاوس عن ابن عباس - رضي الله عنهما - عن النبي - [ & ] - | قال : ' أمرت أن أسجد على سبعة ، ولا أكف شعرا ولا ثوبا ' .(@)(@@) وهذا الحديث قد روي عن النبي - [ & ] - من وجوه | بألفاظ مختلفة ، وروي عن ابن عباس من غير وجه ، ورواه عن عمرو عن | طاوس جماعة فاجتزأنا بمن ذكرنا واستغنينا به عن غيره . |(@)(@@) 4704 - حدثنا عبد الوارث بن عبد الصمد قال : نا أبي | عبد الوارث عن أيوب عن عمرو بن دينار عن طاوس عن ابن عباس | - رضي الله عنهما - قال : لم ينه النبي - [ & ] - عن كرى | الأرض ، ولكن قال : ' لأن يمنح الرجل أخاه أرضه ، خير له من أن يأخذ | عليها خرجا ' . | PageV11P027 |(@)(@@) 4705 - وحدثنا محمد بن عبد الملك قال : نا حماد بن [ 262 ] | زيد عن عمرو عن طاوس عن ابن عباس عن النبي - [ & ] - | بنحوه .(@)(@@) وهذا الحديث قد روي عن النبي - [ & ] - نحوه من | وجوه ، وهذا من أحسن الأسانيد التي تروى في ذلك . |(@)(@@) 4706 - وحدثنا أحمد بن عبدة وعمرو بن علي قال : نا سفيان | ابن عيينة عن عمرو بن دينار عن عطاء وطاوس عن ابن عباس - رضي 
ms1233	 الله | عنهما - أن النبي - [ & ] - احتجم وهو محرم . | PageV11P028(@)(@@) واللفظ في هذا الحديث لفظ عمرو بن علي .(@)(@@) وهذا الحديث لا نعلم أحدا يرويه عن عمرو عن طاوس إلا ابن | عيينة ، وقد روي عن ابن عباس من غير وجه وعن غير ابن عباس أيضا . |(@)(@@) 4707 - حدثنا يوسف بن موسى قال : نا عبيد الله بن موسى | قال : نا ابن عيينة عن عمرو عن طاوس عن ابن عباس - رضي الله عنهما - | قال : نهى رسول الله - [ & ] - عن بيع الثمار حتى تطعم .(@)(@@) وهذا الحديث رواه غير عبيد الله عن ابن عيينة عن عمرو عن | طاوس مرسلا . | PageV11P029 |(@)(@@) 4708 - وحدثنا عمرو بن يحيى بن غفرة البجلي قال : نا حماد | ابن زيد عن عمرو عن طاوس عن ابن عباس - رضي الله عنهما - أن | رسول الله - [ & ] - قال : ' كل شرط ليس في كتاب الله | فهو باطل وإن كان مائة شرط ' . |(@)(@@) 4709 - وحدثناه أحمد بن عبدة قال : نا سفيان عن عمرو عن | طاوس عن النبي - [ & ] - .(@)(@@) ولم يذكر ابن عباس ، ولا نعلم أحدا تابع عمرو بن يحيى على روايته | عن عمرو عن طاوس عن ابن عباس . وهذا الكلام يروى عن غير ابن | عباس عن النبي - [ & ] - . |(@)(@@) 4710 - وحدثنا حوثرة بن محمد المنقري من كتابه قال : نا سفيان | PageV11P030 | ابن عيينة عن عمرو بن دينار عن طاوس عن ابن عباس - رضي الله | عنهما - عن النبي - [ & ] - قال : ' عرفة كلها موقف ومنى | كلها منحر ' . |(@)(@@) 4711 - وحدثنا أحمد بن عبدة قال : أنا سفيان بن عيينة عن | عمرو عن طاوس عن النبي - [ & ] - بنحوه . ولم يقل عن | ابن عباس .(@)(@@) وهذا الحديث لا نعلم أحدا قال : عن طاوس عن ابن عباس إلا | حوثرة ولا نعلم أحدا تابعه عليه والحديث مشهور عن ابن عباس عن النبي | - [ & ] - يروى من وجوه إلا أنه لا يروى عن عمرو عن | طاوس إلآ من هذا الوجه . |(@)(@@) 4712 - حدثنا إبراهيم بن سعيد الجوهري قال : نا يونس بن | PageV11P031 | محمد قال : نا حماد بن زيد عن عمرو بن دينار عن طاوس عن ابن عباس | - رضي الله عنهما - أن أعرابيا أهدى إلى النبي 
ms1234	 - [ & ] - | فأعطاه فقال له : ' أرضيت ؟ ' قال : لا ، ثم زاده فقال : ' رضيت ؟ ' قال : لا ، | ثم زاده فقال : ' رضيت ؟ ' قال : نعم ، فقال النبي - [ & ] - : | ' لقد هممت ألا أتهب هبة إلا من قرشي أو أنصاري أو ثقفي ' .(@)(@@) وهذا الحديث لا نعلم أحدا قال عن طاوس عن ابن عباس إلا | يونس بن محمد عن حماد بن زيد ورواه ابن عيينة . |(@)(@@) 4713 - ناه أحمد بن عبدة عن ابن عيينة عن عمرو عن طاوس | عن النبي - [ & ] - .(@)(@@) ولا نعلم يروى هذا الكلام عن ابن عباس إلا من هذا الوجه ولا | نحفظ أن أحدا رواه عن يونس عن حماد إلا إبراهيم بن سعيد ، فذكر | PageV11P032 | بعض أصحابنا أن مجاهد بن موسى رواه أيضا عن يونس فتابع إبراهيم | على إسناده . |(@)(@@) 4714 - حدثنا محمد بن معمر قال : نا محمد بن كثير قال : نا | سليمان بن كثير عن عمرو بن دينار عن طاوس عن ابن عباس رفعه | قال : ' من قتل في عمية - أو قال : عمية - بحجر أو سوط ، أو عصا | فعليه عقل الخطأ ، ومن قتل عمدا فهو قود ومن حال بينه وبينه فعليه | لعنة الله والملائكة والناس أجمعين ، لا يقبل منه صرف ولا عدل ' .(@)(@@) وهذا الحديث لا نعلمه يروى عن ابن عباس بهذا اللفظ إلا من هذا | PageV11P033 | الوجه بهذا الإسناد ولا نعلم أسنده عن عمرو بن دينار عن طاوس عن ابن | عباس إلا سليمان بن كثير ورواه غير سليمان ، عن عمرو بن دينار عن | طاوس عن النبي - [ & ] - مرسلا . |(@)(@@) 4715 - حدثنا محمد بن أحمد بن الجنيد قال : نا يحيى بن | السكن قال : نا شعبة قال : أنا خالد الحذاء قال : سمعت عكرمة | يقول : ولا أراه إلا عن ابن عباس - رضي الله عنهما - قال النبي - [ & ] - : | ' العائد في هبته كالكلب يعود في قيئه ' . |(@)(@@) 4716 - حدثنا العباس بن الوليد قال : نا المعتمر بن سليمان قال | سمعت ليثا يحدث عن أبي فزارة عن سعيد بن جبير أو مقسم عن ابن | عباس رفع الحديث إلى النبي - [ & ] - أنه قال : ' هذه | PageV11P034 | الكلمات وقاء من كل داء : أعوذ بكلمات الله التامة ، وأسمائه كلها عامة 
ms1235	 | من شر السامة والعامة ، وشر العين اللامة ، ومن شر حاسد إذا حسد ومن | شر ذي شر وما ولد . ثلاثة وثلاثين من الملائكة أتوا بهم ' فقال : | ' وصب وصب ' فقال : ' خذوا تربة من أرضكم فامسحوا نواصيكم وفيه | من أخذ عليها صفدا أو كتمها أحدا فلا أفلح إذا أبدا ' . |(@)(@@) 4717 - وحدثنا إسماعيل بن سيف القطعي قال : نا يونس بن | أرقم قال : نا الأعمش عن سماك عن عكرمة عن ابن عباس أن | PageV11P035 | عليا - رضي الله عنهم - ناول رسول الله - [ & ] - ترابا | فرمى به في وجوه المشركين يوم حنين . |(@)(@@) 4718 - حدثنا محمد بن الحسن الكرماني قال : نا يحيى بن آدم | قال : [ 263 ] نا أبو بكر بن عياش عن إدريس بن بنت وهب بن | منبه عن وهب عن ابن عباس - رضي الله عنهما - قال : سأل النبي | - [ & ] - جبريل أن يراه في صورته قال : ادع ربك ، | فدعا ربه فطلع عليه من قبل المشرق ، فجعل يرتفع ويسير فلما رآه صعق | فأتاه . | PageV11P036 |(@)(@@) 4719 - حدثنا عمرو بن علي قال : نا أبو عاصم قال : نا ابن | جريج عن حسين بن عبد الله عن عكرمة عن ابن عباس - رضي الله | عنهما - أن رسول الله - [ & ] - كانت إذا زاغت الشمس | وهو في منزل جمع بين الظهر والعصر ، وإذا لم تزغ حتى يرتحل صار حتى | إذا كانت العصر نزل فجمع بين الظهر والعصر ، وإذا غابت له الشمس | جمع في منزله بين المغرب والعشاء ، وإذا رحل قبل أن تغيب سار حتى إذا | غاب الشفق نزل فجمع بين المغرب والعشاء . |(@)(@@) 4720 - حدثنا عبد الواحد بن غياث قال : نا عدي بن الفضل | PageV11P037 | قال : نا إسماعيل بن أمية عن أبي الزبير عن ابن عباس ، وقال غيره : عن | أبي الزبير عن سعيد بن جبير عن ابن عباس - رضي الله عنهم - قال : | قال رسول الله - [ & ] - : ' لما أصيب إخوانكم جعل الله | أرواحهم في جوف طير خضر ، ترد أنهار الجنة وتأكل من ثمارها وتأوي | إلى قناديل معلقة في ظل العرش ، فلما وجدوا طيب مطعمهم ومشربهم | قالوا لو يعلمون بما أكرمنا ، قال الله تبارك وتعالى : أنا 
ms1236	 معلمهم عنكم | فأنزل الله : ^ ( ولا تحسبن الذين قتلوا في سبيل الله أمواتا بل أحياء عند | ربهم يرزقون فرحين بما آتاهم الله من فضله ويستبشرون بالذين لم | يلحقوا بهم من خلفهم ألا خوف عليهم ولا هم يحزنون ) ^ ' . | PageV11P038 |(@)(@@) 4721 - حدثنا عبد الله بن سعيد قال : نا حفص بن غياث عن | داود عن عكرمة عن ابن عباس - رضي الله عنهما - قال : أتت الصبا | الشمال فقالت : مري حتى ننصر رسول الله - [ & ] - | فقالت الشمال : إن الحرة لا تسري بالليل ، فكانت الريح التي نصر بها | رسول الله - [ & ] - الصبا . |(@)(@@) 4722 - وحدثنا عبد الله بن سعيد قال : نا أبو خالد عن الأعمش | عن الحكم ومسلم البطين عن سعيد بن جبير وعطاء ومجاهد عن ابن | عباس - رضي الله عنهما - قال : جاءت امرأة إلى النبي - [ & ] - | فقالت : إن أختي ماتت وعليها صيام شهرين متتابعين ، فقال : | ' أرأيت لو كان على أختك دين أكنت تقضينه ؟ ' قالت : نعم قال : | PageV11P039 | ' فحق الله أحق ' . |(@)(@@) 4723 - حدثنا نصر بن علي قال : أنا أبي قال : نا جرير بن | حازم عن يعلى بن حكيم عن سعيد بن جبير ، عن ابن عباس وابن عمر | - رضي الله عنهم - أن النبي - [ & ] - حرم نبيذ الجر . |(@)(@@) 4724 - حدثنا نصر بن علي قال : حدثني أبي عن سفيان عن | PageV11P040 | أبيه عن عكرمة عن ابن عباس ^ ( وأنتم سامدون ) ^ قال : الغناء . |(@)(@@) 4725 - حدثنا إبراهيم بن سعيد قال : نا عبد الله بن عمر | قال : نا مجالد عن الشعبي عن ابن عباس - رضي الله عنهما - قال : قال | رسول الله - [ & ] - : ' مثل الذي يتكلم يوم الجمعة | والإمام يخطب كمثل الحمار يحمل أسفارا ' . | PageV11P041 |(@)(@@) 4726 - حدثنا إسماعيل بن عبد الله الأصبهاني قال : نا حسين | ابن حفص قال : نا خطاب بن جعفر بن أبي المغيرة عن أبيه عن سعيد بن | جبير عن ابن عباس - رضي الله عنهما - قال : كان رسول الله - [ & ] - | يطوف في النخل بالمدينة ، فجعل الناس يقولون : فيها | صاع وفيها وسق ، فقال رسول الله - [ & ] - فيها كذا | وكذا ، قالوا صدق الله ورسوله ، فقال رسول الله : ' إنما أنا بشر فما | حدثتكم عن الله فهو حق ، وما 
ms1237	 قلت فيه من قبل نفسي فإنما أنا بشر | أصيب وأخطئ ' . |(@)(@@) 4727 - حدثنا محمد بن المثنى قال : نا معاذ بن هشام قال | حدثني أبي عن قتادة عن أبي قلابة عن خالد بن اللجلاج عن عبد الله | ابن عباس - رضي الله عنهما - أن نبي الله - [ & ] - قال : | ' رأيت ربي في أحسن صورة ، فقال : يا محمد ، فقلت : لبيك ربي | PageV11P042 5 | وسعديك ، قال : فيم يختصم الملأ الأعلى ؟ قلت : ربي لا أدري ، قال : | فوضع يده بين كتفي فوجدت بردها بين ثدي ، فعلمت ما بين | المشرق والمغرب فقال : يا محمد ، قلت : لبيك ربي وسعديك ، قال : فيم | يختصم الملأ الأعلى ؟ قلت : ربي في الكفارات ، والمشي على الأقدام إلى | الجماعات ، وإسباغ الوضوء في المكروهات ، وانتظار الصلاة بعد | الصلاة إلى الصلوات ، فمن حافظ عليهن عاش بخير ، ومات بخير ، وكان | من ذنوبه كيوم ولد ' . |(@)(@@) 4728 - حدثنا محمد بن معمر قال : نا أبو عبد الرحمن المقرئ | قال : نا ليث بن سعد قال : حدثني أبو الزبير عن سعيد بن جبير | وعن طاوس عن ابن عباس - رضي الله عنهما - قال : كان رسول الله | - [ & ] - يعلمنا التشهد كما يعلمنا القرآن فقال رسول الله | - [ & ] - : ' التحيات المباركات الصلوات الطيبات لله ، | السلام عليك أيها النبي ورحمة الله وبركاته ، السلام علينا وعلى عباد | PageV11P043 | الله الصالحين ، أشهد أن لا إله إلا الله وأشهد أن محمدا عبده | ورسوله ' . |(@)(@@) 4729 - حدثنا محمد بن معمر قال : نا مسلم قال : نا شداد بن | سعيد عن الجريري عن أبي نضرة عن ابن عباس - رضي الله عنهما - | قال : قال رسول الله - [ & ] - : ' يا شباب قريش ، لا تزنوا | احفظوا فروجكم ، ألا من حفظ فرجه فله الجنة ' . | PageV11P044 |(@)(@@) 4730 - حدثنا أبو فروة يزيد بن محمد بن يزيد قال : نا أبي | محمد بن يزيد الرهاوي عن أبيه يزيد بن سنان قال : نا يحيى بن أبي | كثير عن عكرمة عن ابن عباس - رضي الله عنهما - قال : صليت مع | رسول الله - [ & ] - فأقامني عن يمينه . |(@)(@@) 4731 - قال : وحدثني أبي محمد بن يزيد عن [ 264 ] أبيه يزيد | ابن سنان قال : نا يحيى بن أبي كثير ، عن 
ms1238	 عكرمة ، عن ابن عباس | PageV11P045 | - رضي الله عنهما - أن رسول الله - [ & ] - قال لضباعة : | ' احرمي ولبي ، وقولي : محلى من الأرض حيث حبستني ' فإنك إن | مرضت فإنك قد أحللت عن أمر رسول الله - [ & ] - . |(@)(@@) 4732 - قال : وحدثني أبي عن أبيه يزيد قال : نا يحيى بن أبي | كثير عن عكرمة عن ابن عباس - رضي الله عنهما - قال : لم يحج رسول الله | - [ & ] - منذ هاجر إلا حجة واحدة ، وهي تلك الحجة | التي أهل فيها بالعمرة بين يدي الحج . قال عبد الله بن العباس : كذلك فعل | رسول الله - [ & ] - قدم عمرة بين يدي الحج . قال | عبد الله : لا تنقص العمرة من الحج شيئا ، ولا تنقض الحجة من العمرة | PageV11P046 | شيئا ، وذلك خير وذلك حق ، ولكن الشيطان يلبس عليكم . |(@)(@@) 4733 - قال وحدثني أبي عن أبيه قال : نا يحيى بن أبي | كثير ، عن عكرمة عن ابن عباس - رضي الله عنهما - أن رسول | الله - [ & ] - أمر عائشة أن تعتمر من التنعيم ، ثم تطوف | بالبيت ، ولم تكن طافت من أجل حيضتها ، وكانت أهلت بعمرة . |(@)(@@) 4734 - قال : وحدثني أبي عن أبيه ، قال : نا يحيى بن أبي | كثير عن عكرمة عن ابن عباس - رضي الله عنهما - قال : لم أكن لأحج | أبدا إلا وأنحر ، كذلك فعل رسول الله - [ & ] - . |(@)(@@) 4735 - قال : وحدثني أبي عن أبيه قال : نا يحيى بن أبي | كثير عن عكرمة عن ابن عباس - رضي الله عنهما - قال : من طاف | PageV11P047 | بالصفا والمروة فقدمه لعمرته فإن ذلك يكفيه لعمرته وحجته ، وكذلك | فعل رسول الله - [ & ] - مصدره ، طاف لعمرته ثم لبت ثم | ارتحل من الحج فلم يطف بعد الحج حتى ارتحل . |(@)(@@) 4736 - حدثنا محمد بن المثنى قال : نا محمد بن عبد الله الأنصاري | قال : نا سعيد عن قتادة عن أبي طالب الضبعي . |(@)(@@) 4737 - وحدثنا نصر بن علي قال : أنا خالد بن الحارث ، قال : نا | سعيد ، عن قتادة ، عن أبي طالب الضبعي ، عن ابن عباس - رضي الله | عنهما - أن حجاما يقال له أبو طيبة حجم رسول الله - [ & ] - | فأعطاه أجره وحط له من عمله أو وضع عنه طائفة من عمله . | PageV11P048 |(@)(@@) 4738 - حدثنا 
ms1239	 محمد بن معمر قال : نا أبو عاصم عن ابن | جريج عن عمرو بن دينار عن عكرمة عن ابن عباس - رضي الله | عنهما - قال : اشتد غضب الله على من قتله رسول الله - [ & ] - | بيده واشتد غضب الله على قوم دموا وجه رسول الله - [ & ] - . |(@)(@@) 4739 - حدثنا محمد بن معمر قال : نا أبو عاصم قال : نا جرير | ابن حازم عن أبي رجاء ، عن ابن عباس - رضي الله عنهما - قال : قال | رسول الله - [ & ] - : ' لا يزال أمر هذه الأمة مواما أو | مقاربا - قال جرير : أو كلمة تشبهها - ما لم يتكلموا في القدر والولدان ' . | PageV11P049 |(@)(@@) 4740 - وحدثنا محمد بن المثنى قال : نا ابن أبي عدي قال : نا | سعيد عن قتادة عن جابر بن زيد عن ابن عباس - رضي الله عنهما - أنه | كان يجمع بين الصلاتين في السفر ، ويقول : من السنة . |(@)(@@) 4741 - حدثنا عمرو بن علي قال : نا يحيى بن سعيد قال : نا | شعبة عن قتادة عن جابر بن زيد عن ابن عباس - رضي الله عنهما - عن | النبي - [ & ] - قال : ' يقطع الصلاة الكلب الأسود والمرأة | الحائض ' قال : قلت : قد كان يذكر الثالث قال : ما هو ؟ قلت : الحمار | قال : رويدا الحمار قلت : قد ذكر الرابع قال : ما هو ؟ قلت : الكافر قال : | إن استطعت ألا يمر بين يديك كافر ولا مسلم فافعل . | PageV11P050 |(@)(@@) 4742 - حدثنا محمد بن المثنى قال : نا ابن أبي عدي عن سعيد | عن قتادة عن جابر بن زيد عن ابن عباس بنحو حديث شعبة ولم يرفعه . |(@)(@@) 4743 - حدثنا إبراهيم بن عبد الله بن محمد أبو شيبة قال : نا | إبراهيم بن الحسن التغلبي قال : نا يحيى بن يعلى الأسلمي عن أبي | سعد عن عكرمة عن ابن عباس - رضي الله عنهما - قال : قيل : يا | رسول الله أتهلك القرية وفيها الصالحون ؟ قال : ' نعم ' قيل : بم ؟ قال : | ' بدهنتهم وسكوتهم عن معاصي الله ' . |(@)(@@) 4744 - وحدثنا أبو شيبة قال : نا أحمد بن يحيى قال : نا أبو | عبيدة عن الأعمش عن سعيد بن جبير عن ابن عباس - رضي الله | PageV11P051 | عنهما - قال : أخذتهم يوم بدر ريح عقيم . |(@)(@@) 4745 
ms1240	 - حدثنا عبد الله بن سعيد قال : نا عيسى بن سوادة | قال : نا إسماعيل بن أبي خالد ، عن زاذان عن ابن عباس - رضي الله | عنهما - قال : قال رسول الله [ & ] - : ' من حج ماشيا | كتب له بكل خطوة سبعمائة حسنة من حسنات الحرم - قال بعضهم : | وما حسنات الحرم ؟ قال : - بكل حسنة بمائة ألف حسنة ' . |(@)(@@) 4746 - وحدثنا إبراهيم بن سعيد قال : نا يحيى بن سعيد | الأموي قال : نا ابن جريج عن خصيف عن مقسم | PageV11P052 | عن ابن عباس - رضي الله عنهما - قال : أشهد لقد علمت أن رسول الله | - [ & ] - مسح على الخفين . |(@)(@@) 4747 - حدثنا عبد الرحمن بن الأسود بن مأمول قال : نا | شبابة ابن سوار قال : نا الحسن بن عمارة عن عبد الرحمن بن | الأصبهاني عن عكرمة عن ابن عباس - رضي الله عنهما - قال : وقع مولى | للنبي - [ & ] - من نخلة فمات فأعطى النبي ميراثه أهل | PageV11P053 | دينه . |(@)(@@) 4748 - وحدثنا محمد بن عثمان قال : نا عبيد الله قال : نا ابن أبي | يعلى عن الحكم عن يحيى بن الجزار عن ابن عباس - رضي الله عنهما - | قال : خرجتا جاريتان تمشيان في القبلة ورسول الله - [ & ] - | يصلي فأخذتا بحقويه فلما أراد أن يركع فرق بينهما ثم ركع [ 265 ] . | PageV11P054 |(@)(@@) 4749 - حدثنا محمد بن عثمان قال : نا عبيد الله قال : نا ابن | أبي ليلى عن المنهال بن عمرو ، عن سعيد بن جبير ، عن ابن عباس | - رضي الله عنهما - قال : أتى رجل النبي - [ & ] - قال : إن | على أمي رقبة ، وعندي أمة سوداء ، فقال النبي - [ & ] - : | ' ائتني بها ' فقال لها رسول الله : ' أتشهدين أن لا إله إلا الله وأني رسول | الله ؟ ' قالت : نعم . قال : ' فأعتقها ' . |(@)(@@) 4750 - وحدثنا محمد بن عثمان قال : نا عبيد الله بن موسى | قال : نا أبو جعفر الرازي عن عبد الكريم عن مقسم عن ابن عباس | PageV11P055 | - رضي الله عنهما - في الذي يقع على امرأته وهي حائض : إن كان الدم | عبيط فليتصدق بدينار وإن كان صفرة فنصف دينار . | PageV11P056 |(@)(@@) 4751 - حدثنا محمد بن عثمان بن كرامة قال : نا عبيد الله بن | موسى عن شريك عن جابر عن أبي 