ms341	 من غرور يعاني % % 19(@)(@@) % قد أضاع الزمان بالقيل والقا % % ل وفرط الضلال والصغيان % % 20(@)(@@) % يحسب النفس منه تخلق شيئا % % فهو منها يبيت أسر الأماني % % PageV01P1533 21(@)(@@) % كل ما أنت فيه مع من يحاكي % % ك به في اللسان أو في الجنان % % 22(@)(@@) % عندكم ربكم خيال ووهم % % وهو شيء في عقلكم ذو معاني % % 23(@)(@@) % وجميع الأكوان حق وصدق % % عندكم بالعيان والبرهان % % 24(@)(@@) % لو عقلتم تعاكس الأمر فيكم % % وانجلى يا مظاهر الخذلان % % 25(@)(@@) % لكن البغي والتنكر منكم % % أوصلاكم فينا إلى الحرمان % % 26(@)(@@) % ولهذا ملتم على ما سوى الله % % سكارى كميلة الهيمان % % 27(@)(@@) % وعميتم بحبكم كل شيء % % وصممتم عن الهدى والبيان % % 28(@)(@@) % وافتتنتم بما سوى الله جهرا % % واشتغلتم بلذة الحيوان % % 29(@)(@@) % حيث أشقت نفوسكم شهوات % % عن حصول السعادة المتداني % % 30(@)(@@) % فقفوا عند حدكم لاتغطوا % % خبثكم بالفجور والبهتان % % PageV01P1534 31(@)(@@) % ههنا غابة بها أسد حرب % % مشرعات رماحهم للطعان % % PageV01P1535 البحر : - 1(@)(@@) % أنا في الملاح على يقين % % ومحبة المحبوب ديني % % 2(@)(@@) % فتنكبوا يا زائغي % % ن عن الصراط المستبين % % 3(@)(@@) % نار المحبة عندكم % % والنور عندي في كميني % % 4(@)(@@) % وأنا الذي في بحر قد % % س الذات أسبح كل حين % % 5(@)(@@) % وعيونكم وقلوبكم % % يسبحن في ماء وطين % % 6(@)(@@) % متمتع أنا في الجما % % ل بحضرة الحق المبين % % 7(@)(@@) % ونفوسكم مفتونة % % بزخارف الماء المهين % % 8(@)(@@) % ماذا دهاكم يا كلا % % ب النبح من ليث العرين % % 9(@)(@@) % لو لم يكن في الحسن ما % % فيه من السر الحزين % % 10(@)(@@) % ما الله أعمى عنه أع % % ينكم بأسلوب متين % % PageV01P1536 13(@)(@@) % وأضلكم عن وجهه ال % % باقي بمعدوم مهين % % 14(@)(@@) % ورمى بكم للطمس في % % بطن الطبائع كالجنين % % 15(@)(@@) % أو يستوي الإلهام بالأ % % ملاك مع نطق القرين % % 16(@)(@@) % لكم الوساوس في الصدو % % ر من السطور بلا معين % % 17(@)(@@) % ولنا علوم الحق بال % % تحقيق عن حق اليقين % % 18(@)(@@) % ومحبة الوجه الملي % % ح لدي في حصن حصين % % 19(@)(@@) % وخواطري رأت الهدى % % في حب وضاح الجبين % % 20(@)(@@) % والقلب يظفر كل وقت منه بالعقد الثمين % % 21(@)(@@) % وجمال دحية قد حكا % % ه ظهور جبريل الأمين % % 22(@)(@@) % لا 
ms342	 في الحنين له أنا % % كلا ولا أنا في الأنين % % PageV01P1537 23(@)(@@) % بل في التواصل واللقا % % وموارد الماء المعين % % 24(@)(@@) % لا قيد لي في مطلق ال % % حسن المفرح للحزين % % 25(@)(@@) % أبدا ولا بنواظر % % ألهو ولا قلب رهين % % 26(@)(@@) % ومحبتي نور بلا % % نار ولا شيء مشين % % 27(@)(@@) % وهي التي أنا عابد % % ربي بها طوال السنين % % 28(@)(@@) % خلصتها مني ومن % % غيري بتشديد ولين % % 29(@)(@@) % وبها عرفت تجليا % % ت الله بالنور المبين % % 30(@)(@@) % وغدا بها ألقى المنى % % وأكون من أهل اليمين % % PageV01P1538 البحر : - 1(@)(@@) % أنا النور المبين % % أنا الحق اليقين % % 2(@)(@@) % أنا القرآن أتلي % % أنا الحبل المتين % % 3(@)(@@) % أنا عرش التجلي % % أنا الروح الأمين % % 4(@)(@@) % أنا الكرسي مني % % بدا السر الكمين % % 5(@)(@@) % أنا المحفوظ لوحي % % أنا الحصن الحصين % % 6(@)(@@) % وما عندي تراب % % ولا ماء مهين % % 7(@)(@@) % سوى الأسرار عنها % % أضاء لي الجبين % % 8(@)(@@) % وقلبي مستنير % % وحقي مستبين % % 9(@)(@@) % فحول عن طريقي % % وأمري يا لعين % % 10(@)(@@) % وإن أنكرت حالي % % وكنت لي تشين % % PageV01P1539 11(@)(@@) % وتعبد كل وقت % % هواك وتستعين % % 12(@)(@@) % لك الدينار رب % % ومعبود معين % % 13(@)(@@) % وبالأغيار تلهو % % ويطغيك القرين % % 14(@)(@@) % ولا عتب على من % % له دنياه دين % % 15(@)(@@) % وفي الشهوات أضى % % له قلب رهين % % 16(@)(@@) % ولا يدري شمال % % بما حوت اليمين % % PageV01P1540 البحر : - 1(@)(@@) % أنا النور المبين ولا أكنى % % أنا التنزيل يعرفني ابن فني % % 2(@)(@@) % يضل الله بي خلقا كثيرا % % ويهدي بي كثيرا فاستبني % % 3(@)(@@) % ولكن لا يضل سوى نفوس % % بإنكار بغت وبسوء ظن % 4(@)(@@) % وإني الملك والملكوت فضلا % % وإني صحرة الوادي وإني % % 5(@)(@@) % ولما كنت منه بغير فصل % % ولا وصل شهدت الكل مني % % 6(@)(@@) % أحقق من أريد بعلم حقي % % وأسكر من أشاء بخمر دنى % % 7(@)(@@) % وأسعد باللقا قوما وأشقى % % بهجري آخرين وبالتجني % % 8(@)(@@) % مقامي ليس يحصل بالترجي % % وحالي ليس يدريك بالتمني % % 9(@)(@@) % وما بات الهبات ولا العطايا % % بمسدود على أهل التهني % % 10(@)(@@) % ولكن القلوب لها عليها % % من الأغيار ينشأ كل كن % PageV01P1541 11(@)(@@) % وبالتوحيد يعرف كل شيء % % ويجهل كل شيء بالتثني % % 12(@)(@@) % هي الأبواب قد سدت جميعا % % سوى 
ms343	 بابي فدع عنك التعني % % 13(@)(@@) % وما أنا شاعر وجيمع نظمي % % بعيد عن مدى شعر المغني % % 14(@)(@@) % وميز بين الهام وشعر % % وصرح بالمقام ولا تكني % % 15(@)(@@) % ولا تكفر بجهلك في كلامي % % ودعه لمن يوحد يا مثني % % 16(@)(@@) % ولا تعجل على ما لست تدري % % فإنك سوف تدري بالتأني % % 17(@)(@@) % نصحتك فاستطع صبرا معي إن % % سلكت عن الروافض نهج سني % % 18(@)(@@) % تعالى أصلنا عمن كل فرع % % وجل عن التزوج والتبني % % 19(@)(@@) % وكل فتى على كل مقدار ما قد % % سقاه بكفه الساقي يغنى % % 20(@)(@@) % وحين رويت عنه روت بصدق % % جميع رجال هذا العصر عني % % PageV01P1542 البحر : - 1(@)(@@) % نحن قوم نهوى الوجوه الحسانا % % وبها الله زادنا إحسانا % % 2(@)(@@) % وعلينا من المهيمن عين % % أوسعتنا تحققا وعيانا % % 3(@)(@@) % ولنا قد أدير خمر التجلي % % وبه صار كأسنا ملآنا % % 4(@)(@@) % وشهدنا الوجود حوضا وكانت % % صور الكل عندنا كيزانا % % 5(@)(@@) % إن من نال شربة منه يوما % % لا تراه على المدى ظمآنا % % 6(@)(@@) % وأناس قد بدلوا الدين عنه % % طردوا فامتلوا له طغيانا % % 7(@)(@@) % كل ما حاولوه أبعد عنهم % % لا تلمهم أضلهم من هدانا % % 8(@)(@@) % حوض خير الأنام عذب زلال % % بارد سائغ لمن يتعانى % % 9(@)(@@) % بيننا وعده على الحوض نلقى % % صاحب الحوض مثل ما يلقانا % % 10(@)(@@) % وبوجه المليح سر شهود % % عنه ما زالت الورى عميانا % % PageV01P1543 11(@)(@@) % ضل عنه من قبل إبليس جهلا % % وأبى عن كماله نقصانا % % 12(@)(@@) % وإليه اهتدت ملائكة الله % % وزادت بأمره إيقانا % % 13(@)(@@) % حضرات الأسما به قد تبدت % % وأبينت عند الجميع بيانا % % 14(@)(@@) % وعليه السجود كان دليلا % % فتسمى الإسلام والإيمانا % % 15(@)(@@) % كن به عارفا ودم فيه مغرى % % وتقرب له تكن إنسانا % % 16(@)(@@) % والذي حاد عنه فهو جهول % % حيث سماه ربه شيطانا % % 17(@)(@@) % إنه الباب لكن الفتح صعب % % زاد قوما خوفا وقوما أمانا % % 18(@)(@@) % كأس حسن وكأس عشق وإني % % بهما الآن لم أزل سكرانا % % 19(@)(@@) % هذه في العموم جملة حالي % % وتعالى من أنزل الفرقانا % % 20(@)(@@) % ولأهل الخصوص مني مقام % % كل حال في ذاته يتفانى % % PageV01P1544 21(@)(@@) % كان في بيت عزتي من قديم % % ثم 
ms344	 صارت ثيابه الحد ثانا % % 22(@)(@@) % وهو قرآننا بليلة قدر % % قد تلوناه ساعة وتلانا % % 23(@)(@@) % إن تكن قد مضت لأحمد صحب % % إننا لم نزل له إخوانا % % 24(@)(@@) % هكذا جاء في الأحاديث عنه % % ودلو أنه يكون رآنا % % 25(@)(@@) % ظاهر العلم في الصحابة باد % % وهو علم التكليف إنسا وجانا % % 26(@)(@@) % والذي قد بدا بنا هو علم % % زاد عن كل باطن إبطانا % % 27(@)(@@) % وهو علم التشريف علم المزايا % % ليس ظنا لنا ولا حسبانا % % 28(@)(@@) % بل يقين محقق أخذته % % قومنا بالشهود آنا فآنا % % 29(@)(@@) % وهو علم الإله يظهر فيمن % % قرأ الله ذاته وقرآنا % % 30(@)(@@) % خذه منا بالحال والقال وادخل % % لحمانا وافرغ لنا عن سوانا % % PageV01P1545 31(@)(@@) % هو عشق لا وهم لا فهم فيه % % لا تواني لا فكر لا إذعانا % % 32(@)(@@) % يملأ العقل يملأ الحس نورا % % كل من عز في معانيه هانا % % 33(@)(@@) % هو أمر ترى الجبان شجاعا % % إن بدا منه والشجاع جبانا % % 34(@)(@@) % ليس يدريه غير صاحب قرب % % كلما أبعد الجميع تدانى % % PageV01P1546 البحر : - 1(@)(@@) % عين حق إنسانها الإنسان % % وهي نار عنها سواها دخان % % 2(@)(@@) % ما لها صورة سوى كل شيء % % أمرها لابس لنا عريان % % 3(@)(@@) % إن بدت أفنت الجميع بوجه % % مشرق زان حسنه الإحسان % % 4(@)(@@) % وإذا ما اختفت أعارت سناها % % كل شيء فلاحت الأعيان % % 5(@)(@@) % بنت عقل أهل السوى عبدوها % % ليت لو كان عندهم إذعان % % 6(@)(@@) % يحسبون الذي يرون كمالا % % وهو لو يعقلونه نقصان % % 7(@)(@@) % ويظنون إنهم في حصول % % والذي حصلوا هو الحرمان % % 8(@)(@@) % ينصرون الهوى على الشرع عمدا % % وعليهم يستحوذ الشيطان % % 9(@)(@@) % بعدت درة الوجود عليهم % % فبأصدافها لهم لو ذان % % 10(@)(@@) % علمهم قشر علمنا ولبوب % % بقشور عن الدواب تصان % % PageV01P1547 11(@)(@@) % عندهم من عقولهم حشرات % % ولهم من نفوسهم ثعبان % % 12(@)(@@) % ربنا الله لا سواه وأما % % ربهم فهو عسجد وجمان % % 13(@)(@@) % تعسوا أين هم وأين هوانا % % هو فينا عز وفيهم هوان % % 14(@)(@@) % فهو إنا يزداد بالله طيبا % % وهواهم بخبثهم يزدان % % 15(@)(@@) % أمحلت أرضهم وغيث علوم % % هو في كل أرضنا هتان % % 16(@)(@@) % وهي تعلو عنهم وتدنو إلينا % % وهي 
ms345	 فيهم خوف وفينا أمان % % 17(@)(@@) % إن لله في الوجود رجالا % % كل حين بدين أحمد دانوا % % 18(@)(@@) % أسلموا ثم آمنوا بأمور % % تم فيها الإسلام والإيمان % % 19(@)(@@) % هم على الجهل فطرة ليس يدرو % % ن وما العلم غير ما فيه كانوا % % 20(@)(@@) % هم أولوا العلم لا سواهم وفيه % % لم يزالوا لما عليه تفانوا % % PageV01P1548 21(@)(@@) % قطعوا أنهم له بيقين % % فاستراحوا وزالت الأوثان % % 22(@)(@@) % ورموا بالسوى على الكشف منهم % % في بحار الفنا فبان البيان % % 23(@)(@@) % أمة بالمهيمن الحق قامت % % وعلى عرشها استوى الرحمن % % 24(@)(@@) % دخلت في غيب الغيوب فعنها % % قد تولى مكانها والزمان % % 25(@)(@@) % ذهب الجسم وانطوى الروح عنهم % % ومضى الخمر واستقل الدنان % % 26(@)(@@) % هم على حالهم به من قديم % % وكذا عندهم به الأكوان % % 27(@)(@@) % وهو أيضا على الذي هو فيه % % ما عليه بنا تغير شان % % 28(@)(@@) % حلة أهل ديننا لبسوها % % ما بها بدعة ولا طغيان % % PageV01P1549 البحر : - 1(@)(@@) % نحن من المنسوبين % % لسنا من المطلوبين % % 2(@)(@@) % أرسل ذا القول لنا % % والدنا بالتعيين % % 3(@)(@@) % في سبب نعرفه % % بشارة للتحصين % % 4(@)(@@) % وأمر القائل إن % % يخبرنا في ذا الحين % % 5(@)(@@) % وذاك في نصف جما % % دى أول بالتهوين % % 6(@)(@@) % لمائة والألف من % % هجرة ذخر الناجين % % 7(@)(@@) % وكان في واقعة الرؤيا لبعض الأهلين % % 8(@)(@@) % أحفظه ألفاظها % % وزاده في التلقين % % 9(@)(@@) % وقال قل له كذا % % عني لفرط التحنين % % 10(@)(@@) % قإنه يعلم ما % % أقوله بالتبيين % % PageV01P1550 11(@)(@@) % نعم به أعلم عن % % قطع بدون التخمين % % 12(@)(@@) % يعنى به نسبتنا % % لله حقا والدين % % 13(@)(@@) % وللعلوم والتقى % % وسيرة المهديين % % 14(@)(@@) % وللكمال والمعا % % رف العلى والتمكين % % 15(@)(@@) % وللمقامات التي % % تمكينها في تلوين % % 16(@)(@@) % وللجمال والجلا % % ل أرث آل ياسين % % 17(@)(@@) % وإرث من كلمه ال % % حق بطور سينين % % 18(@)(@@) % ومن عليه أنبتت % % شجرة من يقطين % % 19(@)(@@) % وكل مأمون على الوحي الذي بجبرين % % 20(@)(@@) % والنسب الذاتي الذي % % جل عن المخلوقين % % PageV01P1551 21(@)(@@) % الطاهر الظاهر في % % شهم أشم العرنين % % 22(@)(@@) % فماله من أحد % % يطلبه بالتكوين % % 23(@)(@@) % بعزة الشان وما % % لديه من فرط اللين % % 24(@)(@@) % فليس مطلوبا بالمن % % سواه من معلومين % % 25(@)(@@) % وهو 
ms346	 الذي يطلب من % % شاء مقام المسكين % % 26(@)(@@) % أعزنا الله به % % وزادنا في التمكين % % 27(@)(@@) % ولم تزل حلتنا % % بحسنه في تحسين % % 28(@)(@@) % ما أسفر الصبح وصا % % ح طيره بالتلحين % % 29(@)(@@) % ولبس الروض من الزهور ثوب التزيين % % 30(@)(@@) % وما انجلى الغصن على % % نسيم عرف النسرين % % PageV01P1552 البحر : - 1(@)(@@) % لقد نظرت قوم بطرف لهم قذى % % 2(@)(@@) % فلم يشهدوا الأحجاب جمال ذي % % 3(@)(@@) % وقوم لقد شموا شذا روضها الشذى % % 4(@)(@@) % يقولون لي ما العلم ما السر ما الذي % % هو الجوهر الغالي عن البحر خبرنا % % 5(@)(@@) % على صحبنا غنت فصاح طيورنا % % 6(@)(@@) % وذات الحميا أشرقت في صدورنا % % 7(@)(@@) % تجلت علينا تنجلي فوق طورنا % % 8(@)(@@) % فقلت لهم هذي مطالع نورنا % % ومغربها فينا ومشرقها منا % % 9(@)(@@) % إلى حضرات الحق كان ارتفاعنا % % 10(@)(@@) % ومنا لقد مدت إلى الغيب باعنا % % PageV01P1553 11(@)(@@) % وفي أزل الآزال زاد انتفاعنا % % 12(@)(@@) % على الدرة البيضاء كان اجتماعنا % % ومن قبل خلق الخلق والعرش قد كنا % % 13(@)(@@) % سحاب غيوب الذات تمطر ماءنا % % 14(@)(@@) % ومن حط قدرا كيف يدري سماءنا % % 15(@)(@@) % ولما استرحنا واطرحنا عناءنا % % 16(@)(@@) % تركنا البحار الزاخرات وراءنا % % فمن أين تدري الناس أين توجهنا % % 17(@)(@@) % كشفنا عن الوجه الجميل غياهبا % % 18(@)(@@) % وقد صار منا السر للكل ناهبا % % 19(@)(@@) % ومن حضرة الرحمن نلنا مواهبا % % 20(@)(@@) % ألا يا لقومي قد قرأتم مذاهبا % % ولم تدر يا قومي رموز مذاهبنا % % PageV01P1554 21(@)(@@) % فوائدكم أضحت قيود رهيننا % % 22(@)(@@) % وعنكم لقد أخفي مقام أميننا % % 23(@)(@@) % ويا علماء الرسم هل من معيننا % % 24(@)(@@) % مذاهبكم نرفو بها بعض ديننا % % ومذهبنا عمى عليكم وما قلنا % % PageV01P1555 البحر : - 1(@)(@@) % طلعة كلها جمال % % إن بدت تفتن الجميع % % 2(@)(@@) % حال زال مال آل % % كل شيء إلى الفنا % % 3(@)(@@) % زان عشاقها الكمال % % يتهنى بها الخليع % % 4(@)(@@) % طال صال عال غال % % للمسرات والهنا % % 5(@)(@@) % دور % % 6(@)(@@) % نحن آيات وجهها % % ليس ندري بكنهها % % 7(@)(@@) % صاح احب ساح طاح % % من إلى نحوها دنا % % 8(@)(@@) % لا تحم حول شبهها % % من ترى ذاك يستطيع % % 9(@)(@@) % لاح راح فاح ناح % % طائر الشوق بالمنى % % 10(@)(@@) % دور % % PageV01P1556 11(@)(@@) % صل 
ms347	 ربي على النبي % % أحمد المصطفى الهمام % % 12(@)(@@) % فاق راق ساق شاق % % مغرم القلب بالغرام % % 13(@)(@@) % منه عبد الغني حبي % % رفعة الجاه والمقام % % 14(@)(@@) % حاق تاق لاق ذاق % % كلما غرد الحمام % % 15(@)(@@) % دور % % 16(@)(@@) % وعلى الآل والصحاب % % من حووا رفعة الجناب % % 17(@)(@@) % باه وجاه شاه تاه % % كل من غيرهم أجاب % % 18(@)(@@) % وذوي القرب والخطاب % % من غدا برقهم لميع % % 19(@)(@@) % ساه واه فاه لاه % % بسواهم من اعتنى % % PageV01P1557 البحر : - 1(@)(@@) % بدا جمال حبيبي % % والكل قد غابوا % % 2(@)(@@) % والمضني أفنى لا يرفق % % بالمغرم العاني % % 3(@)(@@) % والوجه منه نصيبي % % والحسن جلباب % % 4(@)(@@) % لي أغنى أقنى قد أشرق % % في عين إنسان % % 5(@)(@@) % وفوق قلبي خطيبي % % للسر وهاب % % 6(@)(@@) % والأدنى أدنى بالأبرق % % فرد بلا ثاني % % 7(@)(@@) % يا صاحبي فاقتدي بي % % إني أنا الباب % % 8(@)(@@) % فالمعنى معنا ما أفرق % % عن سر روحاني % % 9(@)(@@) % دور % % 10(@)(@@) % يا واحد قد تثنى % % فأشركوا فيه % % PageV01P1558 11(@)(@@) % والساقي باقي يسقيني % % بكأسه الصافي % % 12(@)(@@) % ونلت ما أتمنى % % والغير في التيه % % 13(@)(@@) % والراقي واقي يحميني % % عن السوى كافي % % 14(@)(@@) % ومن يشاهد تهنى % % من غير تمويه % % 15(@)(@@) % أشواقي لاقى تغنيني % % عن كل أوصافي % % 16(@)(@@) % في النور كان مغيبي % % والكون أسباب % % 17(@)(@@) % والحسنى أسنى لي أحرق % % وجه له داني % % 18(@)(@@) % دور % % 19(@)(@@) % صلي إله البرايا % % ربي على المختار % % 20(@)(@@) % ذي المجد يجدي بالإحسان % % للبائس الراجي % % PageV01P1559 21(@)(@@) % طه شريف المزايا % % من جاء بالأسرار % % 22(@)(@@) % للرفد يفدي مما كان % % فكلهم ناجي % % 23(@)(@@) % عبد الغني بالعطايا % % مشعشع الأنوار % % 24(@)(@@) % لي وجدي يجدي بالألحان % % في الغيهب الساجي % % 25(@)(@@) % ما جدول بالصبيب % % في الروض ينساب % % 26(@)(@@) % أواهنا وهنا مذ أطرق % % ريان الأغصان % % PageV01P1560 البحر : - 1(@)(@@) % إليك من البعد قلبي دنا % % 2(@)(@@) % ومنك لقد نلت كل المنى % % 3(@)(@@) % فيا من لنا قال إني أنا % % 4(@)(@@) % أتيناك بالفقر يا ذا الغنى % % وأنت الذي لم تزل محسنا % % 5(@)(@@) % وعند الصباح وعند المسا % % 6(@)(@@) % نهيم اشتياقا بفرط الأسى % % 7(@)(@@) % عهدناك برابنا مؤنسا % % 8(@)(@@) % وعودتنا كل فضل عسى % % يعود الذي منك عودتنا % % 9(@)(@@) % سراة الهوى بالهوى ولهوا % % 10 
ms348	(@)(@@) % وفيك عن الغير قد توهموا % % PageV01P1561 11(@)(@@) % إليك كفوف الدعا وجهوا % % 12(@)(@@) % مساكينك الشعث قد موهوا % % بحبك إذ هو أقصى المنى % % 13(@)(@@) % لقد جاء من فرعنا أصلكم % % 14(@)(@@) % ونحن الذي عمنا فضلكم % % 15(@)(@@) % وهيهات أنا نكافي لكم % % 16(@)(@@) % فما في الغنى واحد مثلكم % % وفي الفقر لا عصبة مثلنا % % 17(@)(@@) % فنينا بمن لم يزل سرمدا % % 18(@)(@@) % ومنه به قد سمعنا الندا % % 19(@)(@@) % ويا من خفى عن عيون العدى % % 20(@)(@@) % رأيناك في كل أمر بدا % % وليس من الأمر شيء لنا % % PageV01P1562 21(@)(@@) % طمسنا بأنواركم والسنا % % 22(@)(@@) % وآل الورى عندنا للفنا % % 23(@)(@@) % وقد ارص لي حبكم ديدنا % % 24(@)(@@) % سترت اسمكم غيرة ها أنا % % أموه بالشعب والمنحنى % % 25(@)(@@) % جرت خوف هذا الجفا أدمعي % % 26(@)(@@) % وشوقي به التهبت أضلعي % % 27(@)(@@) % وأنت الذي لا سواه أعي % % 28(@)(@@) % إذا كنت في كل حال معي % % فعن حمل زادي أنا في غنى % % 29(@)(@@) % على سيرنا لم يزل سيركم % % 30(@)(@@) % وفي روض قلبي شدا طيركم % % PageV01P1563 31(@)(@@) % وخير جميع الورى خيركم % % 32(@)(@@) % فأنتم هم الحق لا غيركم % % فيا ليت شعري أنا من أنا % % PageV01P1564 البحر : - 1(@)(@@) % نحن الجفون نحفظ العيونا % % ونحن أهل الذكر فاسألونا % % 2(@)(@@) % ونحن ذات من بدت صفاته % % تكشف عن صبغتنا فنونا % % 3(@)(@@) % جنوننا في حبكم عقلا يرى % % وعقلنا في ديننا جنونا % % 4(@)(@@) % وجودنا الحق ونحن باطل % % نذوق في حياته المنونا % % 5(@)(@@) % وهو الذي له الصفات كلها % % والغافلون عنه يدعونا % % 6(@)(@@) % الله وحده هو الموجود لا % % سواه والجميع معدومونا % % 7(@)(@@) % لأنهم هم التقادير التي % % قدرها لنا بأن تكونا % % 8(@)(@@) % ويظهر الوجود منه في الذي % % يظهر عنه واضحا مكنونا % % 9(@)(@@) % والنور نور الذات في ظلامنا % % ولم نزل نحن له الشئونا % % 10(@)(@@) % نلوح كالبرق له ونختفي % % فنعرف الظهور والبطونا % % PageV01P1565 11(@)(@@) % ونحن في كلامه حروفه % % نحمل معناه لنا المصونا % % 12(@)(@@) % وأمره الواحد ينجلي لنا % % فيرسم الكاف بنا والنونا % % 13(@)(@@) % كاف كفاية ونون نعمة % % روحا وجسما سلسا موزونا % % 14(@)(@@) % وفعله نحن على مرداه % % فنقتضي التحريك والسكونا % % 15(@)(@@) % عز وجل عن مشابه له % % قد أعجز الأفكار والظنونا 
ms349	 % % 16(@)(@@) % وهو الغني والورى جميعهم % % يرجون غيث فضله الهتونا % % 17(@)(@@) % أضل في آدم عن طلعته % % عدوة إبليسا الملعونا % % 18(@)(@@) % وقد هدى فيه إليه أمة % % بأمره قد جاء يعملونا % % 19(@)(@@) % تبارك الله الذي بوجهه % % في كل شيء هيج الشجونا % % 20(@)(@@) % وأتعب العاشق المسبى به % % وحير المتيم المفتونا % % PageV01P1566 21(@)(@@) % وإن يشأ بالبعد يحرق الذي % % أراد غيرا أو أحب دونا % % 22(@)(@@) % وإن يشأ يكشف عن الوجه لمن % % يحبه ويخرج المسجونا % % 23(@)(@@) % مطروده بغيره مفتتن % % ولم يزل مقبوله المحصونا % % 24(@)(@@) % وحكمه ليس له من علة % % فإن بدا لا تمنع الماعونا % % 25(@)(@@) % وكن به له خفيا ظاهرا % % ولا تكن بجهله مغبونا % % PageV01P1567 البحر : - 1(@)(@@) % أيها الشحص الذي قال أنا % % مسلم والكفر فيه اكتمنا % % 2(@)(@@) % ليس هذا الأمر بالقول ولا % % بالتمني يدرك المرء المنى % % 3(@)(@@) % إن تكن آمنت بالله كما % % هو في التنزيه عما ههنا % % 4(@)(@@) % حيث لا تشبيه في العقل له % % ثم لا تعطيل سرا علنا % % 5(@)(@@) % ثم صدقت النبي المصطفى والذي أظهره من شرعه هكذا كنت به مستقنا % % بالذي جاء به يرشدنا % % 6(@)(@@) % والذي أظهره من شرعه % % هكذا كنت به مستيقنا % % 7(@)(@@) % أو بدا من ذاك شيء لك في % % أحد عنك تناءى أو دنا % % 8(@)(@@) % فإذا أنت لعمري مسلم % % تتبع الفرض وتقفوا ألسننا % % 9(@)(@@) % فاستعن بالله إن لم تك في % % هذه الحالة تلق المننا % % 10(@)(@@) % وإذا أتحفك الله بها % % فأشكر الله لها وادع لنا % % PageV01P1568 البحر : - 1(@)(@@) % يا كثير الشوق والشجن % % دائما في السر والعلن % % 2(@)(@@) % راح يشكو هجر ممتنع % % فهو عن وصف الجميع غنى % % 3(@)(@@) % ماله إن رمته جهة % % فانتبه من غفلة الوسن % % 4(@)(@@) % ماله في ديننا أبدا % % من مكان لا ولا زمن % % 5(@)(@@) % وكان قبل الكون هو على % % ما عليه كان فاستبن % % 6(@)(@@) % أن رمت تحظى برؤيته % % طبق ما قد جاء في السنن % % 7(@)(@@) % ألق منك النفس وهو بأن % % تعرف المودع في البدن % % 8(@)(@@) % واستمع واصغ لذاك ولا % % تشتغل عنه بلوم ذلي % % 9(@)(@@) % كل من الكون عنه إذا % % لم تجدهم فيه في فتن % % PageV01P1569 البحر 
ms350	 : - 1(@)(@@) % أنت الذي طول عمري الهم تكفيني % % وعند موتي وتغسيلي وتكفيني % % 2(@)(@@) % أنت العليم بحالي والبصير به % % يا مالك الملك يا رب السلاطين % % 3(@)(@@) % وليس لي من سلاح فيك أحمله % % بل أنت حسبي عن حما السكاكين % % 4(@)(@@) % أنت القوي على ضعفي تدبرني % % في كل أمر وعما شئت تغنيني % % 5(@)(@@) % خلقتني من تراب واقتدرت فلا % % مساعد لك في خلقي وتكويني % % 6(@)(@@) % وأنت سويتني من نطفة رجلا % % وفي منك بنفخ الروح تحييني % % 7(@)(@@) % كم نعمة لك عندي لست أحصرها % % فيما سيأتي وفي الماضي وفي الحين % % 8(@)(@@) % وأرتجي منك توفيقي لشكرك يا % % شكور إنك ما أرجوه تعطيني % % 9(@)(@@) % وأعظم الكل إرشادي لدين هدى % % طريقة الحق نور الشرع والدين % % 10(@)(@@) % كان النبي نبيا في الغيوب به % % وآدم بين الماء والطين % % PageV01P1570 11(@)(@@) % وإنني بك ربي واثق كرما % % بالحفظ من كل ما عن ذاك يلويني % % 12(@)(@@) % آمنت بالوعد حقا والوعيد على % % طبق النصوص التي جاءت بتعيين % % 13(@)(@@) % وأنت أكرم من يوفى بموعده % % من غير خلف ولا مطل ولا مين % % 14(@)(@@) % ونرتجي كلنا خلف الوعيد فما % % خلف الوعيد بعيب منك أو شين % % 15(@)(@@) % لأنه كرم وهو الدليل على % % عناية الله بالخلق المساكين % % 16(@)(@@) % يا من له الحجة العظمى التي بلغت % % أقصى الكمال وأزرت بالبراهين % % 17(@)(@@) % على جميع الورى إن شاء عذبهم % % عدلا وخلدهم في نار سجين % % 18(@)(@@) % وإن يشأ بجنان الخلد نعمهم % % فضلا وعاملهم باللطف واللين % % 19(@)(@@) % إني أريدك لا أني أريد سوى % % وما السوى غير تلبيس وتزيين % % 20(@)(@@) % وأنت أنت هو الحق المبين بلا % % شك وغيرك وسواس الشياطين % % PageV01P1571 21(@)(@@) % يا خالق الخلق بالسر العظيم ويا % % من أمره بين تحريك وتسكين % % 22(@)(@@) % إني توسلت في الدنيا إليك بمن % % جعلته سببا في كل تدوين % % 23(@)(@@) % ومن هو النور من فياض نورك قد % % خلقت كل الورى منه بتكوين % % 24(@)(@@) % طه النبي الذي أرسلته كرما % % فينا لكشف وإيضاح وتبيين % % 25(@)(@@) % محمد المصطفى المختار من مضر % % وآله الغر هاتيك الأساطين % % 26(@)(@@) % أن تشرح صدرك من ضيق ومن حرج % % وتفرج الهم من 
ms351	 صعب بتهوين % % 27(@)(@@) % ولا تدعني أمد الكف في طلب % % ممن سواك على ظن وتخمين % % 28(@)(@@) % واحفظ عقيدة قلبي من تقلبه % % حتى ألاقيك في صدق وتمكين % % 29(@)(@@) % وجد بعفوك عن عبد الغني وكن % % عونا له يوم تعديل الموازين % % 30(@)(@@) % وألطف به وبآباءه له سلفوا % % وكل إخوانه أرباب تحصين % % PageV01P1572 31(@)(@@) % والمسلمين جميعا ما شدت سحرا % % ورق الحمام بأنواع التلاحين % % PageV01P1573 البحر : - 1(@)(@@) % الظاهر أفناني % % والباطن أبقاني % % 2(@)(@@) % والعاذل يلحاني % % في الكاس وفي الحان % % 3(@)(@@) % دور % % 4(@)(@@) % يا صاحب أشواقي % % ها أنت هو الباقي % % 5(@)(@@) % والحق هو الساقي % % من خمرة إنسان % % 6(@)(@@) % دور % % 7(@)(@@) % عرج بربا نجد % % يا مكثر ذا الوجد % % 8(@)(@@) % فالقرب لنا يجدي % % من ساكن نعمان % % 9(@)(@@) % دور % % 10(@)(@@) % الحي لنا بانا % % والمركب أعيانا % % PageV01P1574 11(@)(@@) % فارفق بمطايانا % % يا سائق أظعان % % 12(@)(@@) % دور % % 13(@)(@@) % هذه العلم الفرد % % والشوق بنا يحدو % % 14(@)(@@) % والقرب هو القصد % % في عالم روحاني % % 15(@)(@@) % دور % % 16(@)(@@) % مولاي على الهادي % % من طاب به الورى % % 17(@)(@@) % واشتاق له الحادي % % فارتاح بألحان % % 18(@)(@@) % دور % % 19(@)(@@) % أنواع تحياتي % % من عبد غنى تاتي % % 20(@)(@@) % في سائر أوقاتي % % بالخير وإحسان % % PageV01P1575 البحر : - 1(@)(@@) % نحن قوم متنا وفنينا % % بتجلي وجوده الحق فينا % % 2(@)(@@) % وحشرنا إليه عمن سواه % % ودخلنا جناته خالدينا % % 3(@)(@@) % قمر لا نضام فيه اجتلاء % % بينته ذواتنا تبينا % % 4(@)(@@) % وإذا أظلم الكيان عليه % % أطلعته الغيوب حينا فحينا % % 5(@)(@@) % يا أخلاى هذه نفحات % % من رياض بها إليه أتينا % % 6(@)(@@) % فلتشموا الأقاح والورد منها % % والخزامى والآس والياسمينا % % 7(@)(@@) % حضرات بها الوجود تجلى % % زينته لمن يرى تزيينا % % 8(@)(@@) % قد حمدنا السرى بهن إليها % % حيث منها جئنا المقام الأمينا % % 9(@)(@@) % وهي أم الكتاب سبع المثاني % % نزلت مرتين عقلا ودينا % % 10(@)(@@) % فرقينا صفاتها درجاتوتلونا آياتها وقرأنا هن حم والكتاب المبينا % % وشربنا تسنيمها الصرف عيناسقط بيت ص % % PageV01P1576 11(@)(@@) % وبدت عندنا معاني معان % % لمعان بذاتها تبتدينا % % 12(@)(@@) % علمنا والكتاب والوصف منها % % وهي ذات وراء ذا لن تبينا % % 13(@)(@@) % كيف في الكل لن تبين وبانت % % وهي نور لما يزل مستبينا % % 14(@)(@@) % واعتباراتها لثلاث ظلام 
ms352	 % % زائل عندها عيانا يقينا % % 15(@)(@@) % ثلثوها حقيقة لا اعتبارا % % ثم ضلوا ونحن فيها هدينا % % 16(@)(@@) % فأعرف الكل هكذا وتحقق % % تعرف الحق والكفور اللعينا % % PageV01P1577 البحر : - 1(@)(@@) % خذها إليك لها هدى وبيان % % منا نصيحة من له عرفان % % 2(@)(@@) % مغرى بحب المذعنين يسوقهم % % للغيب منه تحقق وعيان % % 3(@)(@@) % وبها يد التوحيد قد مدت لمن % % حفظ العهود وعند الإذعان % % 4(@)(@@) % إني بحبك يا محمد مغرم % % أنت البديري بالكمال مصان % % 5(@)(@@) % وعليك من نسج الهداية حلة % % وطرازها التوفيق والايقان % % 6(@)(@@) % فأبشر كلب سعاد وعناية % % وحماية ومن الإله تصان % % 7(@)(@@) % أنت الحقيق بأن يقال له انتبه % % من رقدة الغفلات با إنسان % % 8(@)(@@) % أعني بذلك رقدة الدين التي % % من كان راقدها هو اليقظان % % 9(@)(@@) % عند العوام وعند من هو غافل % % والذكر منه بها هو النسيان % % 10(@)(@@) % علم اليقين فإن ذلك بعده % % عين اليقين به الأحبة دانوا % % PageV01P1578 11(@)(@@) % من بعده حق ولليقي % % ن حقيقة لظهورها لمعان % % 12(@)(@@) % هي وحدة باسم الوجود تحققت % % وهي الوجود الحق والوجدان % % 13(@)(@@) % تنحل فيها المشكلات جميعها % % والسنة الغراء والقرءآن % % 14(@)(@@) % وكلام أهل الله في طبقاتهم % % وبها يكون من الشكوك أمان % % 15(@)(@@) % إنا لوجود لمن تحقق واحد % % ليس الزيادة فيه والنقصان % % 16(@)(@@) % ذات منزهة عن التركيب لا % % شيء يشابهما له الحدثان % % 17(@)(@@) % وصفاتها في نفسها هي عينها % % وكذاك أسماء لتلك حسان % % 18(@)(@@) % والعقل يدرك أن ذلك غيرها % % وهي المراتب ما لها نكران % % 19(@)(@@) % لا عينها لا غيرها فافطن هنا % % ليزول عنك الظن والحسبان % % 20(@)(@@) % وهي اعتبارات كثيرات وما % % هي غير ذات الحق جل الشان % % PageV01P1579 21(@)(@@) % والحس والمحسوس قد قاما بها % % والعقل والمعقول ياإخوان % % 22(@)(@@) % والكل خلق الله أي تصويرهفانظر إلى هذا الوجود مجردا عنه تقاديرا هي الأكوان % مثل المعاني تدرك الأذهانسقط بيت ص % % 23(@)(@@) % ومنزها لجماله عن كل ما % % يحوي المكان وتجمع الأزمان % % 24(@)(@@) % فالكل موجودون منه به له % % لولاء كان وجودهم ما كانوا % % 25(@)(@@) % والكل معدومون فيه وإنما % % هو وحده المتفضل المنان % % 26(@)(@@) % وهو الذي هو عين ما هو لم يزل % % ما غيرته 
ms353	 بخلقها الأعيان % % 27(@)(@@) % وكذاك لم تتغير الأعيان من % % عدم بها لكن لها لو ذان % % 28(@)(@@) % تبدو به وهو الذي يبدو بهاوهما جميعا ظاهران فتارة خلق يقال وتارة رحمن % كل لكل نسبة وقرانسقط بيت ص % % 29(@)(@@) % حق على العرش العظيم قد استوى % % وبه محل قائم ومكان % % 30(@)(@@) % سبحانه من أن يحل بغيره % % أو في مكان أوله إمكان % % PageV01P1580 31(@)(@@) % هو أول هو أخر هو ظاهر % % هو باطن هو واحد ديان % % 32(@)(@@) % والكائنات جميعها معدومة % % في نوره ولها به ابطان % % 33(@)(@@) % وهو الموجود الحق جل جلاله % % والإنس قد قاموا به والجان % % 34(@)(@@) % في الملك والملكوت عزوجل عن % % معنى الشريك وما هي الأوثان % % 35(@)(@@) % فالجأ إليه وكن به متمسكا % وليستو الإسرار والإعلان % % 36(@)(@@) % واطرح قيودك في حماه ولذ به % % وليكثر التفويض والتكلان % % 37(@)(@@) % وبه فقم واقعد به واركع به % % واسجد إليه به لك استيقان % % 38(@)(@@) % واترك مرادك في قديم مرادهواترك به دعوى الوجود له وكن فيه بلا كون يزول الران % يمضي الفساد ويذهب الطغيانسقط بيت ص % % 39(@)(@@) % واجعل فناءك في هواه هو البقا % % إن الفنا هو للبقا ميدان % % 40(@)(@@) % واعكف على سنن النبي محاذرا % بدع الزمان يسوقها الشيطان % % PageV01P1581 41(@)(@@) % فالسنة الغراء منهاج التقى % % تمحى به الآثام والعصيان % % 42(@)(@@) % واكفف عن الناس الظنون وسوءها % % واحذر ففي هذا لك الحرمان % % 43(@)(@@) % واترك على العاصين ستر الهمم % % وأعلم بأنك كيف دنت تدان % % 44(@)(@@) % واكتم سريرتك التي هي قد صفت % % لك عن سواك يزينك الكتمان % % 45(@)(@@) % وأقم على نصحي وكن متحققا % % بمقالتي فقالتي الفرقان % % 46(@)(@@) % وأدر لسانك بالصلاة على الذي % % غيث الهدى أبدا به هتان % % 47(@)(@@) % ولآله ولصحبه من بعده % % فليكثر التسليم والرضوان % % 48(@)(@@) % وانهض بحب الصالحين وذكرهم % % فيما تروم فتذهب الأحزان % % 49(@)(@@) % ولك الحوائج تنقضي بسهولة % % وإليك يأتي الغفور والغفران % % 50(@)(@@) % وبما أتي عبد الغني فخذ ولا % % تتبع عداه فإنهم عميان % % PageV01P1582 البحر : - 1(@)(@@) % لا كنت إذ كنا أدري كيف كنت ولو % % لا كنت إذ كنت أدري كيف لم أكن % % 2(@)(@@) % إن كنت من قبل أني كنت لامعه 
ms354	 % % فلا تكن معه بل كن به تكن % % PageV01P1583 البحر : - 1(@)(@@) % ظهر الحق للعيان وبينا % % نحن فيه إذ صار بعدا وبينا % % 2(@)(@@) % نقطة الانفصال من كل نفس % % تجعل العين في الشهادة غينا % % 3(@)(@@) % رتب تنقضي وأخرى توافي % % باعتبار منه لهن يقينا % % 4(@)(@@) % كل هذا نراه إذ نحن خلق % % وهو شيء منا لنا لاح فينا % % 5(@)(@@) % والعظيم العظيم جل تعالى % % أين من يعرف الحقيقة أينا % % 6(@)(@@) % لكن الأمر هكذا هو ستر % % وتجل مبين تبينا % % 7(@)(@@) % ويدى هذه يدي وهي أيضا % يده لي بها يكون معينا % % 8(@)(@@) % وجميعي هذا وروحي وجسمي % % فهو لي يفيض دنيا ودينا % % 9(@)(@@) % والتصاوير والتماثيل منه % % لمحات تلونت تلوينا % % 10(@)(@@) % وله الخلق مثل ما قال والأم % % ر على ما قدر ما يريد يرينا % % PageV01P1584 11(@)(@@) % فنراه به كذلك طورا % ويرانا طورا بنا مستبينا % % 12(@)(@@) % بصر واحد وسمع وعلم % % تبتدي حينا ويسترحينا % % 13(@)(@@) % والذي قال عنه الذكر أني % % قال عنا في الذكر أن الذينا % % PageV01P1585 البحر : - 1(@)(@@) % في الكلب عشر خصال كلها حمدت % % يا ليتها كلها أو بعضها فينا % % 2(@)(@@) % جوع له لم يزل والصالحون كذا % % وما له موضع يختص تعيينا % % 3(@)(@@) % كمن على ربه لا زال متكلا % % ولا ينام سوى من ليله حينا % % 4(@)(@@) % مثل المحبين لا ميراث قط له % % إن مات كالزاهدين المستقلنا % % 5(@)(@@) % وليس يهجر يوما من يصاحبه % % وإن جفاه كأخلاق المريدينا % % 6(@)(@@) % وراضيا بيسير من معيشته % % ما زال كالقانع المستكمل الدينا % % 7(@)(@@) % وإن يكن غالبا شخص سواه على % % مكانه ينصرف عن ذاك تهوينا % % 8(@)(@@) % بتركه مثل أصحاب التواضع قل % % وإن بضرب وطرد من فتى هينا % % 9(@)(@@) % ثم الفتى قد دعاه بعد ذاك أتى % % كحال أهل خشوع خذه تبيينا % % 10(@)(@@) % وإن رأى الأكل أضحى واقفا تره % % يرنو إليك كأخلاق المساكينا % % PageV01P1586 11(@)(@@) % وإن رحلت لا شيء ترى معه % % مثل الذي حاز في التجريد تمكينا % % PageV01P1587 البحر : - 1(@)(@@) % هوى عين العيون % % يسوق إلى المنون % % 2(@)(@@) % وللوجه المصون % % ظهور في بطون % % 3(@)(@@) % بدا شهدتف دوني % % تناويع الفنون % % 4(@)(@@) % وقد ثارت شجوني % % 5(@)(@@) % دور % % 6 
ms355	(@)(@@) % سقى لواديا وحيا % % رباه الودق ريا % % 7(@)(@@) % فكم دارت عليا % % به كاس الحميا % % 8(@)(@@) % وصرت به مهيا % % طويت الكون طيا % % 9(@)(@@) % فمن كاف النون % % 10(@)(@@) % دور % % PageV01P1588 11(@)(@@) % وصلى الله ربي % % على الداعي الملبي % % 12(@)(@@) % على محبوب قلبي % % على طه وحبي % % 13(@)(@@) % به في نيل قربي % % وأل ثم صحب % % 14(@)(@@) % بهم فتح الحصون % % 15(@)(@@) % دور % % 16(@)(@@) % أئمة كل حي % ذوي القدر السني % 17(@)(@@) % لهم عبد الغني % بتسليم يحيى % % 18(@)(@@) % من الله العلي % % على أمد العشي % 19(@)(@@) % وتقليب الشئون % % PageV01P1589 البحر : - 1(@)(@@) % قلبي إلى وجه سلمى مغرم عانى % % 2(@)(@@) % وحبها معدم آثار أعياني % % 3(@)(@@) % فيا رفيقي حديث الغير أعياني % % 4(@)(@@) % روح فؤادي بذكر النازح الداني % % فذكره لم يزل روحي وريحاني % % 5(@)(@@) % من لي بمن هو باد في غلالته % % 6(@)(@@) % كالبدر يشرق من صافي غمامته % % 7(@)(@@) % فغن لي باسمه وافصح بآيته % % 8(@)(@@) % واصرف همومي بصرف من مدامته % % فدنها من جناب العز أدناني % % 9(@)(@@) % يالله يا بارق الأسرار قف نفسا % % 10(@)(@@) % فالكون نور ومن يلهو يرى غلسا % % PageV01P1590 11(@)(@@) % إني أردت الهدي خذ منه لي قبسا % % 12(@)(@@) % واحطط رحالي بباب الدير ملتمسا % % راحا فقيوم ذاك الدير لي داني % % 13(@)(@@) % شمس المعاني بأفلاك العلى بهرت % % 14(@)(@@) % وقصة العشق في أهل الهوى اشتهرت % % 15(@)(@@) % والحسن أحكامه بين الورى قهرت % % 16(@)(@@) % ولي بهيكله محجوبة ظهرت % % من بعدما خفيت عني بجسماني % % 17(@)(@@) % شعر الشعور يحاكي حية لسعت % % 18(@)(@@) % فلو دعا كل نفس نحوه لسعت % % 19(@)(@@) % لكن حقيقتنا هذا الذي صنعت % % 20(@)(@@) % منيعة الوصل إلا عن فتى منعت % % في الحب أن يصبوا إلي ثاني % % PageV01P1591 21(@)(@@) % عن العلو علت من فرط عزتها % % 22(@)(@@) % والكون قد غاب في أنوار طلعتها % % 23(@)(@@) % حقيقة أنا فان في محبتها % % 24(@)(@@) % نادمتها فمحتني عند رؤيتها % % وكان محوى بها أصلا لوجداني % % 25(@)(@@) % ما غافل عن تجليها كمنتبه % % 26(@)(@@) % والقلب راق بها يا صفو مشربه % % 27(@)(@@) % وقد أزالت لدينا كل مشتبه % % 28(@)(@@) % ولو شرحت الذي منها خصصت به % % يوما لاصبح من في الكون يهواني % % 29(@)(@@) % على التقادير بالايجاد منعمة 
ms356	 % % 30(@)(@@) % لما تجلت وفي وجه الرضى سمة % % PageV01P1592 31(@)(@@) % من الأعاريب أمر العشق معجمة % % 32(@)(@@) % اشتاقها وهي في سرى مخيمة % % ونورها ظاهر ما بين أجفاني % % 33(@)(@@) % ركبت للشوق في بيدائها نجبا % % 34(@)(@@) % والكون يخفق منها قلبه وجبا % % 35(@)(@@) % يا لائمي في الهوى لومي غدا عجبا % % 36(@)(@@) % وكيف يصبح عنها الطرف محتجبا % % وحسنها في جميع الخلق يلقاني % % 37(@)(@@) % مطول الوجد مني ذاك مختصر % % 38(@)(@@) % والعشق أجمعه في القلب منحصر % % 39(@)(@@) % يا قوم إني على الأغيار منتصر % % 40(@)(@@) % إن غيبت ذاتها عني فلي بصر % % يرى محاسنها في كل إنسان % % PageV01P1593 41(@)(@@) % عني محت سائر الأوهام والشبه % % 42(@)(@@) % لما تجلت بأمر غير مشتيه % % 43(@)(@@) % وأنني لم أزل فيها بمنتبه % % 44(@)(@@) % ما في محبتها ضد أضيق به % % هي المدام وكل الخق ندماني % % PageV01P1594 البحر : - 1(@)(@@) % من مات يعلم أنك الحق المبين % % وأنا الذي قدمت فيك على اليقين % % 2(@)(@@) % وفنيت حتى في وجودك بان لي % % كيف التمسك منك بالحبل المتين % % 3(@)(@@) % يا نور نور الكائنات جميعها % % نور على نور هو النور المبين % % 4(@)(@@) % أنا ظلمة ظهرت بنور محمد % % ومحمد نور بنورك مستبين % % 5(@)(@@) % والنور بالظلمات يظهر عادة % % وكذلك الظلمات من نور تبين % % 6(@)(@@) % نحن التقادير التي قدرتها % % في نور نورك يا مهيمن يا معين % % 7(@)(@@) % فألطف بنا وامنن علينا بالذي % % نرجوه منك ولا تدعنا حائرين % % 8(@)(@@) % وتول حفظ قلوبنا وجسومنا % % مما يعيب من الأمور وما يشين % % 9(@)(@@) % وأعن وثبتنا على سنن الهدى % % دنيا وآخرة كما ترضى ودين % % 10(@)(@@) % بحبيبك الهادي إليك محمد % % خير الورى وأجلهم طه الأمين % % PageV01P1595 11(@)(@@) % وبآله وبصحبه وبحز به % % وبمن غدوا أنصاره والتابعين % % 12(@)(@@) % أبدا عليه كذا عليهم كلهم % % أزكى الصلاة مع السلام بكل حين % % 13(@)(@@) % ما لاح وجه الفجر في شعر الدجى % % والشمس مشطت السواد عن الجبين % % PageV01P1596 البحر : - 1(@)(@@) % أواه من سار فيكم % % بروح أمر أمين % % 2(@)(@@) % لا طبع جسم شمال % % وجهل نفس يمين % % 3(@)(@@) % يرجع لكم منه روح % % يا نور قلبي وعيني % % 4(@)(@@) % يرجع بجسم ونفس % % يرجع بخفي حنين % % PageV01P1597 البحر : - 1(@)(@@) % قلبي الذي 
ms357	 في هوى المحبوب لاقى البين % % وليس للمرء إلا قلب لا قلبين % % 2(@)(@@) % والقلب في الدهر يقلب قلب لا قلبين % % لاق اللقابي وبالأغيار لاق النبين % % PageV01P1598 البحر : - 1(@)(@@) % ما لابن مريم في تلك الأساطين % % من قومه غير تبليغ وتبيين % % 2(@)(@@) % كانت حقيقته الروح التي غلبت % % على الهواء به والنار والطين % % 3(@)(@@) % روح مقدسة من أمر خانقها % % منفوخة فيه عن توجيه جبرين % % 4(@)(@@) % وجاء يدعو بني يعقوب منه إلى % % مثل الذي هو فيه من تحاسين % % 5(@)(@@) % لأنهم كلهم أولاد آدم من % % جسم ورح وتغليظ وتليين % % 6(@)(@@) % فقام يشرح فيهم أمر نشأته % % من التجلي بأنواع التلاوين % % 7(@)(@@) % وقال إني وإني حسبما نقلوا % % عنه على مقتضى ادراك تكوين % % 8(@)(@@) % وقصده أن يروا أحوال أنفسهم % % كما رأى نفسه عيسى بتهوين % % 9(@)(@@) % فيعرفوا ربهم ذات الوجود على % % ذواتهم قد تجلت في الأحايين % % 10(@)(@@) % فيعبدوه كعيسى في عبادته % % من غير نقص وجور في الموازين % % PageV01P1599 11(@)(@@) % وكان مشرب عيسى في معارفه % % للخائفين يسمى بالرهابين % % 12(@)(@@) % والكاشفون لشمس الروح طالعة % % هم الشماميس أمثال العراجين % % 13(@)(@@) % والقس صاحب شان في تحققه % % وغير ذلك مما في الدواوين % % 14(@)(@@) % بمقتضى لغة الانجيل واصطلحت % % عليه تلك الحواريون في الحين % % 15(@)(@@) % كما أتى عابد في شرعنا وأتى % % مقرب وولى أهل تمكين % % 16(@)(@@) % وهكذا هي ألقاب محققة % % للعيسويين من تلك الأساطين % % 17(@)(@@) % حتى لقد نسخت تلك الأمور وقد % % سرى بها الكفر في طرق الشياطين % % 18(@)(@@) % وما بقي الآن غير الاسم وارتفعت % % حقائق الوصف عن قوم ملاعين % % 19(@)(@@) % فراهب كافر والقس يشبهه % % في زيغه عن صراط الحق والدين % % 20(@)(@@) % والأمر في نفسه حق وقد ورثت % % مقام عيسى به أصحاب ياسين % % PageV01P1600 21(@)(@@) % من هذه الأمة الغرا جهابذة % % في صولة الحال أمثال السلاطين % % 22(@)(@@) % فاستعملوا كل اسم في حقيقته % % بالكشف والصدق لا عن حكم تخمين % % 23(@)(@@) % وما تحاشوا الآن الأولياء لهم % % حكم الوراثة عن حق وتعيين % % 24(@)(@@) % وإنه مقتضى علم الحقائق لا % % علم الرسوم لنفع لا لتزيين % % 25(@)(@@) % فحققوا ما كشفنا عنه واعتبروا % % يا عصبة الحق يكفيكم ويكفيني % % PageV01P1601 البحر 
ms358	 : - 1(@)(@@) % كلامكم يا عواذل كله مينا % % معناه فضة زغل ما تقبلو مينا % % 2(@)(@@) % كيف العمل لم تجد إن صحتمومينا % % مراكب العشق في بحر الهوى مينا % % PageV01P1602 البحر : - 1(@)(@@) % في منزل القرب لما نحن حلينا % % كل التعاقيد بالتحقيق حلينا % % 2(@)(@@) % وحين مر الجفا بالصبر حلينا % % أعناقنا بعقود الوصل حلينا % % PageV01P1603 البحر : - 1(@)(@@) % لم يبق مخلوق تخصيصا وتعيينا % % الأبلى بالبلاد دنياه أو دينا % % 2(@)(@@) % بل كل معنى لقد ذاق البلاحينا % % حتى البلا بالملا منا بلى فينا % % PageV01P1604 البحر : - 1(@)(@@) % بدت شمس الضحى تجلى % % على قلب بها عانى % % 2(@)(@@) % فما أهنى وما أحلى % % مليحا ما له ثاني % % 3(@)(@@) % يا أخلائيدؤاكم دائي % % في الرشا النائيإنني رائي % % 4(@)(@@) % أصل بلوائينقطة الباء % % حيث في مائيرمز ايمائي % % 5(@)(@@) % لاحت الأنواربانت الأسرار % % زادت الأطوارغنت الأطيار % % 6(@)(@@) % فأنطفى يا نار % % قد دنا الداني % % 7(@)(@@) % أيها الغافلبدرك الأفل % % ليت لو تدريبالهوى العذري % % 8(@)(@@) % إنما بدريلاح في صدري % % فاختفى أمريبين اخواني % % 9(@)(@@) % دور % % 10(@)(@@) % جميل الوجه قد وافر % % فأفنى سائر الأكوان % % PageV01P1605 11(@)(@@) % ومن بعد الجفا صافي % % وزان الحسن بالاحسان % % 12(@)(@@) % نوره ماحيخط ألواحي % % فارتشف راحيمنه يا صاح % % 13(@)(@@) % لا تكن صاحيواترك اللاحي % % بين أشباحدون أرواح % % 14(@)(@@) % ثم صلى اللهعلى النبي الأواه % % العظيم الجاهمن به قدفاه % % 15(@)(@@) % عبد من أغناه % % مغرم عانى % % 16(@)(@@) % مع جميع الآل % % سادة الافضال % % 17(@)(@@) % والصحاب الغرمن جفاهم غر % % هم لدفع الضركالدواء المر % % 18(@)(@@) % وعقود الدر % % ذاك حلاني % % PageV01P1606 البحر : - 1(@)(@@) % ما لي لقد أصبحت من نيل المنى % % لا أنت أنت أرى ولا أنى أنا % % 2(@)(@@) % وأرى البلاد ولا بلاد وأهلها % % لا أهلها وأرى الدناهي لا الدنا % % 3(@)(@@) % وجميع ما قد كان زال ولم يزل % % والكل وهما صار لي كي يفتنا % % 4(@)(@@) % وبدا الذي قد كان عنى خافيا % متصورا بالكل بها يكون متعينا % % 5(@)(@@) % من غير ما صور تغيره ولا % % هو بالظهور بها يكون مكونا % % 6(@)(@@) % ما قيدته عن مدى إطلاقه % % اذ لا وجود لها سواه مبينا % % 7(@)(@@) % وهي الكثيرة وهو فيها واحد % % فرد وأن صبغته لي فتلونا % % 8(@)(@@) % لم يشتغل عن 
ms359	 بعضها بالبعض بل % % في كل شيء لم يزل متمكنا % % 9(@)(@@) % وشئونه هي وهي فانية به % % وهو الذي هو ليس يدركه الفنا % % 10(@)(@@) % حق ونحن وما نشاهد باطل % % فتن العقول بخلقه والأعينا % % PageV01P1607 11(@)(@@) % فأحذر تظن بأن شيئا غيره % % معه يكون هناك في الغد أوهنا % % PageV01P1608 البحر : - 1(@)(@@) % إن الفناء طهارة الإنسان % % لصلاة معرفة البعيد الداني % % 2(@)(@@) % فصلاة معرفة الإله بغير ما % % طهر الفناء عديمة الأركان % % 3(@)(@@) % والكفر فيها ظاهر بكلامه % % وبفعله وإزالة الإيمان % % 4(@)(@@) % إن الفناء طهارة مفروضة % % لصلاة معرفة على الإنسان % % 5(@)(@@) % وهي الفناء المحض بالتطهير عن % % خبث الجسوم كثائف الحيوان % % 6(@)(@@) % وعن النفوس لطائف الكون التي % % حدثت فقل حدث من الحدثان % % 7(@)(@@) % وطهارة الأخباث والأحداث لاوالماء ماء الغيب ينزل من سما غيب الأله على فؤاد عاني % % تجزي بغير الماء ذي السيلانسقط بيت ص % % 8(@)(@@) % لا بد ذاك يكون ماء مطلقا % عما يخالطه من الأكوان % % 9(@)(@@) % حتى به حدث يزول وإن يكن % % ماء تراه مقيدا بمعاني % % 10(@)(@@) % فهو المقيد وهو ليس برافع % % حدثا كما قالته أهل الثمان % % PageV01P1609 11(@)(@@) % لكنهم في رفعة خبثا لهم % % قولان والرفع اقتضاء بيان % % 12(@)(@@) % والماء ذاك المطلق حقيقة بالحق اذتحقيق كل حقيقة بالحق إذ هو لا سواه وكل شيء فاني % % هو لا سواه وكل شيء فاني % % PageV01P1610 البحر : - 1(@)(@@) % إايك تشهد غير ودع العنا % % لا أنت في هذا الوجود ولا أنا % % 2(@)(@@) % هذا الوجود هو الحقيقي الذي % % نبدو به ونعود إلى الفنا % % 3(@)(@@) % واذا به عدنا نعود كلم نكن % % واذا بدونا فهو باد دوننا % % 4(@)(@@) % والباطل الشان الذي هو باطل % % والحق حق أن تباعد أو دنا % % 5(@)(@@) % إن الذي هو عالم بك جاهل % % يا من تحجب بالسوى وتبينا % % 6(@)(@@) % لونان كالحرباء لون خلائق % % ظهرت ولون حقائق هن المنى % % 7(@)(@@) % يا ابن الحوادث لا تظن فلا تكن % % أنت القديم وإن بدا بك واعتنى % % 8(@)(@@) % هو عنك ممتاز هنا بوجوده % % وبك امتياز عنه في عدم هنا % % 9(@)(@@) % هيهات هيهات الوجود يكون للع % % دم المقدر أو بعكس كالانا % % 10(@)(@@) % إن الحلول 
ms360	 من الجهول توهم % % في قول أهل الله يجعل ديدنا % % PageV01P1611 11(@)(@@) % ما إن سمعت ولست أسمعى عاقلا % % أبدا يظن الحق يسكن ممكنا % % 12(@)(@@) % إن الوجود على الحقيقة واحد % % في كل شيء قد بدا وتعينا % % 13(@)(@@) % والشيء تقدير له فاني كما % % قد جاء فاكشف عنه إن تك مؤمنا % % 14(@)(@@) % والحق قيوم لمن هو باطل % % وهو السوى بالوهم قام فأفتنا % % PageV01P1612 البحر : - 1(@)(@@) % من شدة القرب مني % % شهدت أنك أني % % 2(@)(@@) % فقلت ما قلت جهلا % % وذاك من سوء ظني % % 3(@)(@@) % وحين حققت أمري % % والوهم قد زال عني % % 4(@)(@@) % تركت هذا وهذا % % ثم الفنا صار فني % % 5(@)(@@) % وصرت عن عيب غيب % % بما أقول اكتنى % % 6(@)(@@) % وزال عني ترجى % % علمي به والتمني % % 7(@)(@@) % والعلم كالجهل عندي % % فيه وزال التعنى % % 8(@)(@@) % اذ كل ذلك خلق % % والخلق ما عنه يغني % % 9(@)(@@) % وليس يشبه ربي % % شيء فكن في التهني % % 10(@)(@@) % أنا الموحد ذوقا % % فخلني يا مثني % % PageV01P1613 البحر : - 1(@)(@@) % إنما الإيمان نور % % في قلوب المؤمنين % % 2(@)(@@) % وهو تصديق وإذعا % % ن وتسليم متين % % 3(@)(@@) % لكتاب الله والس % % نة عن طه الأمين % % 4(@)(@@) % غير محتاج لعقل % % أو لفهم مستبين % % 5(@)(@@) % أو دليل أو لشيء % % خارج عنه معين % % 6(@)(@@) % هو نور هو نور % % يتلالأ في الكمين % % 7(@)(@@) % وهو سر الله فينا % % وطرق الصالحين % % 8(@)(@@) % هو نور وكذاك الش % % يء بالنور يبين % % 9(@)(@@) % وبه لا بسواه % % كان سير المتقين % % 10(@)(@@) % عرفوا الله وذاقوا % % وصفه في كل حين % % PageV01P1614 11(@)(@@) % كشفوا عن كل شيء % % كان في دنيا ودين % % 12(@)(@@) % لبس الإيمان منهم % % ذلك الحصن الحصين % % PageV01P1615 البحر : - 1(@)(@@) % كل الكلام كلامك يا عظيم الشان % % أما يوحي هو الإلهام للإنسان % % 2(@)(@@) % أو من وراء حجاب صورة الأكوان % % أو ترسل الرسل بالتبليغ والتبيان % % PageV01P1616 البحر : - 1(@)(@@) % انظر لموسى نبي الله يا مفتون % % لما تجلى له في شجرة الزيتون % % 2(@)(@@) % وانظر لابليس قبلو ذلك الملعون % % لما احتجب عنه في آدم وما هو دون % % PageV01P1617 البحر : - 1(@)(@@) % آدم نبي واحتجب فيه عن الشيطان % % حتى كفر والتبس أمره له ما بان % % 2(@)(@@) % وكان مجلاه 