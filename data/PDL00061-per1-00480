ms461	 خورشید خاوری(@)(@@) 19 صد جامه سیاه بپوشی چو خلق نیست %~% گرد تو کس نگردد اگر گاو عنبری(@)(@@) 20 خوابت نگیرد ار نبود همسر تو زن %~% زان غسل واجبیست که با زن برابری(@)(@@) 21 شاید که از تو دیو گریزان شود مگوی : %~% کز چشم ما برای چه پنهان شود پری(@)(@@) 22 گیرم که بعد ازین نکنی روی در گناه %~% عذر گناه کرده بگو: تا چه آوری(@)(@@) 23 از کار کرد خویش پشیمان شوی یقین %~% روزی که کردگار کند با تو داوری(@)(@@) 24 گفتار اوحدی نبود بی‌حقیقتی %~% قولش قبول کن که به اقبال رهبری(@)(@@) 25 گر طالبی فروغ بگیری ز آفتاب %~% ور غالبی دریغ نداری ز مشتری PageV1P0919(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 بر کوفه و خاک علی ای باد صبح ار بگذری %~% آنجا به حق دوستی کز دوستان یادآوری(@)(@@) 2 خوش تحفه‌ای ز آن آب و گل بوسیده برداری به دل %~% تازان هوای معتدل پیش هواداران بری(@)(@@) 3 با او بگویی: کای ولی وی سر احسان ویلی %~% زان کیمیای مقبلی درده که جان می‌پروری(@)(@@) 4 ای قبله روح و جسد وی بیشه دین را اسد %~% ذات تو خالی از حسد نفس تو از تهمت بری(@)(@@) 5 کافی کف کوفی وطن صافی دل صوفی بدن %~% هم بوالوفا هم بوالحسن هم مرتضی هم حیدری(@)(@@) 6 هستی نبی را ابن‌عم از روی معنی لحم و دم %~% زان گونه بودی لاجرم زین گونه داری سروری(@)(@@) 7 از جام علمت با طرب جوشیده مغزان عرب %~% دربسته صد معدی کرب پیشت میان چاکری(@)(@@) 8 کفر از کفت شد کاسته دین از تو شد آراسته %~% از زیر دستت خاسته صد چون جنید و چون سری(@)(@@) 9 بوذر وکیل خرج تو سلمان رسیل درج تو %~% گردون چه داند ارج تو تو آفتاب خاوری(@)(@@) 10 بر پایه علم تو کس زین‌ها ندارد دسترس %~% مهدی تو خواهی بود و بس گر مهد این پیغمبری(@)(@@) 11 هم کوه حلمش را کمر هم چرخ خلقش را 
ms462	 قمر %~% هم شاخ شرعش را ثمر هم شهر علمش را دری(@)(@@) 12 علم از تو گشت اندوخته شرع از تو گشت افروخته %~% از ذوالفقارت سوختهآیین کفر و کافری(@)(@@) 13 یاسین ز نامت آیتی طاها ز علمت رایتی %~% کشف تو از مه غایتی برداشت مهر دختری(@)(@@) 14 شمعی و ماهت هم نفس پیشی نگیرد بر تو کس %~% هرچند شمع از پیش و پس فارغ بود چون بنگری(@)(@@) 15 رمحت شهاب و مه سپر خوانت بهشت و کاسه‌خور %~% پای ترا کرده به سر گردون گردان منبری(@)(@@) 16 هم میر نحل و هم نحل ای خسرو گردون محل %~% کاخ تو ایوان زحل هم تخت کاخ مشتری(@)(@@) 17 هم تیغ داری هم علم هم علم داری هم حکم %~% هم زهد داری هم کرم دیگر چه باشد مهتری(@)(@@) 18 از مهر در هر منزلی مهری نهادی بر دلی %~% همچون سلیمان ولی دیوت نبرد انگشتری(@)(@@) 19 خط ترا نقاش چین مالیده بر چشم و جبین %~% کلک تو از روی زمین گم کرده نقش آزری(@)(@@) 20 رای تو دشمن مال را رویت مبارک فال را %~% نهج تو اهل حال را کرد از بلاغت یاوری(@)(@@) 21 از بهر حکم و مال و زر هرگز نجستی شور و شر %~% نفسی که چندینش هنر باشد چه جوید داوری(@)(@@) 22 روزی که یاران دگر از دور کردندی نظر %~% از خیبر و باروش در کندی زهی زور آوری(@)(@@) 23 عصمت شعار آل تو ایمان و تقوی مال تو %~% کشف حقیقت حال تو سیر طریقت بر سری(@)(@@) 24 پیش از کسان بودت کسی بعد از نبی بودی بسی %~% پیشی تو هرچند از پسی ای نامدار گوهری(@)(@@) 25 ای مکیان را پیش صف وی شحنه نجد و نجف %~% هستی خلافت را خلف از مایه نیک اختری(@)(@@) 26 گر با تو کین ورزد خسی نامش نمی‌ماند بسی %~% وآنجا که گم گردد کسی علم تو داند رهبری(@)(@@) 27 رای تو جفت تیر شد چون مهر عالم‌گیر 
ms463	 شد %~% عقل بلندت پیر شد در کار معنی گستری(@)(@@) 28 ای گنج صد قارون ترا گفته نبی هارون ترا %~% زان دشمن وارون ترا منکر شود چون سامری(@)(@@) 29 گردون گردان جای تو خورشید خاک پای تو %~% ای پرتوی از رای تو آیینه اسکندری(@)(@@) 30 نام وجودت «لافتی» منشور جودت «هل اتی» %~% «یا منیتی حتی متی انافی اسا و تحسری»(@)(@@) 31 من بسته بند توام خاک دو فرزند توام %~% در عهد و پیوند توام با داغ و طوق قنبری(@)(@@) 32 پر شد دل از بوی گلت زان اوحدی شد بلبلت %~% ای خاک نعل دلدلت بر فرق چرخ چنبری(@)(@@) 33 اندر بیابانش مهل غلتان میان خون و گل %~% جامی فرو ریزش به دل ز آن بادهای کوثری PageV1P0920(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 عمر گذشت ای دل شکسته چه داری %~% چاره کاری نمی‌کنی به چه کاری(@)(@@) 2 روز بیهوده صرف کرده‌ای اکنون %~% گریه بیهوده چیست در شب تاری(@)(@@) 3 آنچه ز عمر تو فوت گشت ز روزی %~% رو که به عمری قضای آن نگزاری(@)(@@) 4 بس که خجالت بری به روز قیامت %~% گر ورق کرده‌های خود بشماری(@)(@@) 5 آب و زمینی چنین و قوت بازو %~% عذر چه گویی که هیچ تخم نکاری(@)(@@) 6 چاره پیری کن ای نفس که جوانی %~% راه به منزل بر آن زمان که سواری(@)(@@) 7 ای که گذر می‌کنی به کوی عزیزان %~% بر سر گور تو بگذرند به خواری(@)(@@) 8 بس که برین باره کوه و دشت که بینی %~% ابر زمستان گذشت و باد بهاری(@)(@@) 9 حجره دل را سیاه کرده ز ظلمت %~% خانه گل را چه می‌کنی که نگاری(@)(@@) 10 این همه جهلست ورنه کوه نمی‌کرد %~% عهده عهد امانتی که تو داری(@)(@@) 11 زان همه کالای قیمتی به قیامت %~% یک دو سه با خویش جهد کن که بیاری(@)(@@) 12 نقد خود اینجا تمام کن که بسوزی %~% بر سر آن آتش ار تمام عیاری(@)(@@) 13 هرچه مرا عقل گفت با تو 
ms464	 بگفتم %~% تا تو ز من بشنوی و در عمل آری(@)(@@) 14 گفته من فرق کن ز گفته دیگر %~% لعل بدخشی شناس و مشک تتاری(@)(@@) 15 دور ز اقوال نیک نیست زبانم %~% گرچه ز افعال خوب فردم و عاری(@)(@@) 16 معترفم من که: هیچ کار نکردم %~% جز ورق خود سیه به شیفته کاری(@)(@@) 17 اوحدی آنجا که بار راه گشایند %~% اهل بضاعت جز آب دیده چه باری(@)(@@) 18 کار سعادت به زور نیست مگر تو %~% در کنف مسکنت گریزی و زاری(@)(@@) 19 یاری از آن درطلب که هرکه بیفتاد %~% از در او یافت زورمندی و یاری(@)(@@) 20 آنکه ترا یک نفس فرو نگذارد %~% جهل بود گر ز خاطرش بگذاری(@)(@@) 21 باری ازو یاد کن که اوست به هرحال %~% خالق و رزاق وحی و قادر و باری PageV1P0921(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 کردم اندیشه تاکنون باری %~% برنیامد ز دست من کاری(@)(@@) 2 گر ز قرب و قبول آن حضرت %~% رتبتی یافت خوب کرداری(@)(@@) 3 من چنانم ز شرم بار گناه %~% که نظر بر نمی‌کنم باری(@)(@@) 4 دیده بسیار لطف و ناکرده %~% شکر او اندکی ز بسیاری(@)(@@) 5 کیستند این مجاهزان زمین %~% کرکسی چند گرد مرداری(@)(@@) 6 هرکس از بهر پای‌بند وجود %~% گرد خود درکشیده دیواری(@)(@@) 7 چیست این عمر و این عمارت دهر %~% پنج روزی و چار دیواری(@)(@@) 8 هیچ مغزی نداشتست آن سر %~% که بود پای‌بند دستاری(@)(@@) 9 عافیت خواهی از جهان بگریز %~% توشه‌ای سهل و گوشه غاری(@)(@@) 10 زین میان گر نجات می‌خواهی %~% بپران خویش را چو طیاری(@)(@@) 11 مکن آزار هیچ نفس طلب %~% که نیرزد جهان به آزاری(@)(@@) 12 سبب و سر این بباید دید %~% هر کرا در قدم رود خاری(@)(@@) 13 جام گیتی نمای خاطر تست %~% که ندارد ز جهل زنگاری(@)(@@) 14 این جهان زان جهان نموداریست %~% در تو از هر دوشان نموداری(@)(@@) 15 در وجودت نهفته گنجی هست %~% تو بر آن گنج خفته چون ماری(@)(@@) 16 راست پرسی درین 
