ms241	(@)(@@) ~~2406 تا ظن نبری، که در نکوییت شکی است یا چون رخ تو، ستارهای بر فلکی است(@)(@@) (@@) در بی آبی و شوخی و تیغ زدن %~% ایضا %~% خورشید و سپهر و چشم تو، هر سه یکی است(@)(@@) (@@) 2407 داری زپی چشم بد، ای در خوشاب %~% یک نرگس ناشکفته، در زیر نقاب(@)(@@) ~~ین از همه بهتر است، کزبادهآ حسن یک چشم تومست است و یکی چشم خراب!(@)(@@) (@@) 2408 ای ترک حصاری، همه کارت به نواست %~% ایضا %~% الآ یک چیز، کآن یکی عین خطاست(@)(@@) (@@) یک چشم تومستور و، د گر مست چراست؟ %~% مستوری و مستیت، به هم ناید راست!(@)(@@)(@@)(@@) | ایضا(@)(@@) ~~2409 ای من زتبت به خون بپرورده دو چشم وین موج سرشک، بر سر آورده دو چشم(@)(@@) (@@) من کرده دو چشم، چار در آرزوت %~% تو از پی دیدنم، یکی کرده دو چشم!(@)(@@)(@@)(@@) | ایضا(@)(@@) ~~2410 یک چشم تو گر تباه گشت، ای دلبردل تنگ مکن، انده بیهوده مخور(@)(@@) (@@) سیار دو نرگس بود، ای جان پدر %~% بشکفته از و یکی و، نشکفته دگر!(@)(@@)(@@)(@@) | در کوری هر دو چشم(@)(@@) ~~2411 گر نیست تو را دو نرگس، ای طرفه نگار از غم دل خود، چون دل من تنگ مدار(@)(@@) (@@) داری تو چو باغ نوبهاری، رخسار %~% نرگس نبود به باغ، هنگام بهارا(@)(@@)(@@)(@@) | در احولی(@)(@@) ~~2414 ای احول خوش، به غمزه جان می ببریدر جور، طریق آسمان می سپری(@)(@@) (@@) چشم تواحول نیست، از غایت کبر %~% گویی، به کرشمه در جهان می نگری!(@)(@@)(@@)(@@) | در کژ دندانی(@)(@@) ~~2414 دندان کژت، راستی کار رهی است شب را زسر زلف توجانا سیهی است.(@)(@@) ~~چون می گنجد در آن دهان، چندین در بر همد گر افتاده، زبی جایگهی است!(@)(@)PageV01P403(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0407.jpg)(@)(@)(@@)(@@)(@@) | درشکست دندان(@)(@@) (@@) 2414 گر لعل لبت، زکات دادی پیوست %~% چشم بد را، بر او کجا بودی دست؟(@)(@@) (@@) تا لاجرمش، زمانهآ عشوه پرست %~% دری که هزار گوهر ارزید، شکست!(@)(@@)(@@)(@@) | ایضا(@)(@@) (@@) 2415 زان درج پر از در تو، گر دست زمان %~% یک دانه بدزدید، مشو 
ms242	 رنجه از آن(@)(@@) (@@) درجی که پراز در بود، ای جان و جهان %~% یک دانه اگر از آن نباشد، چه زیان؟(@)(@@)(@@)(@@) | ایضا(@)(@@) (@@) 2416 تقدیر، چو صورت تو بفکند ز دست %~% اندر دهنت، دو عقد ڈر در پیوست(@)(@@) (@@) از چثم بدان تا شوی ایمن، پیوست %~% در هر عقدی، به قصد دری بشکست(@)(@@)(@@)(@@) | درزردی دندان(@)(@@) (@@) 2417 در ره، چو بداشتم به سوگندانش %~% از شرم، چولاله شد رخ خندانش(@)(@@) (@@) بر چهرهآ زرد من، لبش خوش خندید %~% عکس رخ من، بماند بر دندانش!(@)(@@)(@@)(@@) | در کژی گردن(@)(@@) (@@) 2418 آن یار، که پیش روی او شاید مرد %~% بر ریختن خون دلم، پا بفشرد(@)(@@) (@@) دانی زچه، گردن آنچنان کژ دارد؟ %~% خون دوجهان بر اوست، نتواند برد!(@)(@@)(@@)(@@) | در کوتاهی زلف(@)(@@) (@@) 2419 ای از دل وجان ومال ومذهب خوشتر %~% روی تو زنام و، نامت از لب خوشتر(@)(@@) ~~زلف تو شب است و، چشم من بیمار است بیماران را، کوتهی شب خوشتر!(@)(@@)(@@)(@@) | در سرخ مویی(@)(@@) (@@) 2420 زلفت، که همیشه جان ودل [می] برد او %~% هنرگز به وفا، سوی کسی ننگرد او(@)(@@) ~~21)2 دوشم، به شبیخون به سر آمد زلفش گویند مرا، که زلف او سرخ(@)(@@) چراست؟ %~% ایضا %~% وز خانهآ تنگ دل، در آمد زلفش %~% چون سرخ نباشد؟ که همه خون خورد او!(@)(@@) (@@) امروز، مگر به دزدیش بگرفتند %~% کز شرم، چنان سرخ بر آمد زلفش!(@)(@@)(@@)(@@) | در بالای دراز(@)(@@) ~~«2)2 شد قامت آن دلبر جماش، دراز واندر حق او، زبان اوباش دراز(@)(@@) (@@) گویند مرا که: گشت بالاش دراز %~% او عمر عزیز ماست، گوباش درازا PageV01P404(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0408.jpg)(@)(@)(@@)(@@)(@@) | ایضا(@)(@@) (@@) 2423 معشوقه، دراز و سرفراز اولیتر %~% موزون و، به طبع دلنواز اولیتر(@)(@@) (@@) گویند: دراز است، ندانند یقین %~% کاو عمر عزیز است، دراز اولیتر!(@)(@@)(@@)(@@) | در کوتاهی بالا(@)(@@) (@@) 2424 تا در دل من، مهر تودلخواه بود %~% از حال دلم، زمانه آگاه بود(@)(@@) (@@) تو عمر منی، چه عیب اگر کوتاهی %~% چاره چه بود، چو عمر کوتاه بود!(@)(@@)(@@)(@@) | ایضا(@)(@@) (@@) 2424 کوتاهی بالای دلارای تو را %~% مولا شدهام، چون رخ زیبای 
ms243	 تو را(@)(@@) (@@) گر عمر مرا، به وعده کوتاه کنی %~% شادم، چو موافق است بالای تورا(@)(@@)(@@)(@@) | در معشوق لاغر(@)(@@) ~~2423 ماه، ار چه هلال عالم آرای بود سرو، ار چه نزار نزهت افزای بود(@)(@@) (@@) معشوقه نحیف است، چنین می باید %~% تا، در دل تنگ هر کسش جای بود!(@)(@@)(@@)(@@) | در معشوق سبزا رنگ(@)(@@) ~~242 بستد دل من به عشق سبزی، شایدزین در دل من، کراهیت می ناید(@)(@@) (@@) مبزارنگ است یار و، چونابن باید %~% کزدیدن سبزه، نور چشم افزاید!(@)(@@) درمعشوق ازرق چشم است(@)(@@) (@@) 242 چشم تو، زفیروزه گرفته ست جمال %~% فیروزه به ارشبه بود، در همه حال(@)(@@) (@@) بر خود، چشمت خجسته دارم همه سال %~% فیروزه، بلی خجسته دارند به فال!(@)(@@)(@@)(@@) | الغیره(@)(@@) ~~2،2 ای چرخ، ز گردش تودل می شکند هر کوبه تودل بست، تنش جان بکند(@)(@@) (@@) دلدار مرا خصم زد و، بگذاری %~% تا، اهرمنی فرشته ای را بزند؟(@)(@@)(@@)(@@) | در بیشرمی او(@)(@@) (@@) 2430 در هر سخنی، به انجمن میافتی %~% همچون سخنم، به هر دهن می افتی(@)(@@) (@@) از گرمروی که هستی و، بیشرمی %~% ایضا %~% چون اشک [روان] زچشم من می افتی!(@)(@@) ~~243 یک چند، زنا حفاظی و نادانی از ما بردیگری شدی، پنهانی(@)(@@) (@@) باز آمدهای، دروغها کرده زبر %~% احسنت، زهی رو و، زهی پیشانی!(@)(@)PageV01P405(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0409.jpg)(@)(@)(@@)(@@)(@@) | یضا(@)(@@) (@@) 2432 در کشتن من، یار بداندیشانی %~% در روز مصاف، در صف ایشانی(@)(@@) (@@) آنگه، گویی مرا که: من زان توام! %~% احسنت، زهی رو و، زهی پیشانی!(@)(@@)(@@)(@@) | نمط بیست وهشتم(@)(@@) درسخن گفتن وناگفتن وجواب تلخ ودشنام او(@)(@@)(@@)(@@) | لاادری(@)(@@) (@@) 2433 در عشق تو، هر عشوه که آن گویی هست %~% وز لطف، هر آنچه باز می جویی هست(@)(@@) (@@) این طرفه، که در نکوییت نیست سخن %~% واندر سخنت، هزار نیکویی هست!(@)(@@)(@@)(@@) | جمال عبد الرزاق(@)(@@) (@@) 2434 نه با تو، مرا خلوت و آرام بود %~% نه ازتو، مرا سلام و پیغام بود(@)(@@) (@@) تا چند، به مهر داری آن درج گهر %~% بر گو سخنی، اگر چه دشنام بود!(@)(@@)(@@)(@@) | وله(@)(@@) ~~2435 آن بت، که مرا به طبع 
ms244	 دمساز گرفتبگذاشت ره مهر، ره ناز گرفت(@)(@@) (@@) گه گاه، به دشنام مرا کردی یاد %~% آن نیز، ستیزهآ مرا باز گرفت!(@)(@@)(@@)(@@) | احمد غزالی(@)(@@) (@@) 2436 گرناز کند، ناز نباشد گستش %~% کآواز خوش و، نغمهآ زیبا هستش(@)(@@) (@@) خواهی، به میان باغ بنشان مستش %~% تا، بوسه دهد هزار دستان دستش!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 2437 گر تو، به شکر خنده دهان بگشایی %~% بند غمم، از سینهآ جان بگشایی(@)(@@) (@@) خاموشی تو، همه ز گفتار من است %~% من لب بستم، تا توزبان بگشایی!(@)(@@)(@@)(@@) | مهستی(@)(@@) ~~2438 کو، آنهمه زینهار و عهدت با من؟ در بستن عهد، آنهمه جهدت با من؟(@)(@@) (@@) نا کرده جنایتی، بگو از چه سبب؟ %~% شد زهر، سخنهای چوشهدت با من!(@)(@@)(@@)(@@) | عز علوی(@)(@@) (@@) 24330 کو آنهمه سوگند گرانت با من %~% وان بستن پیمان چنانت با من(@)(@@) (@@) امروز، دریغ داری از من سخنی %~% نابوده مضایقت به جانت با من PageV01P406(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0410.jpg)(@)(@)(@@)(@@)(@@) | اثیر اومانی(@)(@@) ~~244 عهد تو، اشارت به نشانی است که نیست دشنام تو، آن تحفهآ مقبول(@)(@@) عزیز %~% دردا، که حواله بر دهانی است که نیست! %~% وصل تو، عبارت زجهانی است که نیست(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) باری سخنی گوی به هر وقت زمن 244 گیرم که نه پرسیم، به هر ایامی %~%(@)(@@) گر در خور آفرین نیم، دشنامی! %~% شادم نکنی، به رقعه و پیغامی(@)(@@)(@@)(@@) | زکی مراغی(@)(@@) (@@) آن پستهآ بسته از شکر سفت آخر 24 یار از دل ما گرد عنا رفت آخر %~%(@)(@@) بدر %~% با ما، به زبان خود سخن گفت آخر! %~% وز وصل، گل امید بشکفت آخر(@)(@@) (@@) 2،4 گیرم که سر نواختن نیست تورا گر در گنجد، زان دهن تنگ شکر %~% می(@)(@@) گو سخنی، گرچه سخن نیست تورا %~% میلی به من، ای عهد شکن، نیست تورا(@)(@@) (@@) 244 دشنام، که از لب تو مهوش باشد دشنام تو، نشگفت که دلکش باشد %~%(@)(@@) سنایی %~% دری شمرم، کش اصل از آتش باشد %~% کان باد، که بر گل گذرد خوش باشد!(@)(@@)(@@)(@@) | فخر خالد(@)(@@) (@@) 244 صد بوسه، بر آن سنبل پرچین بدهم %~% ور دسترسم بود، دل ودین بدهم 
ms245	(@)(@@) (@@) روزی که مرا تو پاسخ تلخ دهی %~% شکرانه، هزار جان شیرین بدهم(@)(@@)(@@)(@@) | کمال اسماعیل(@)(@@) (@@) 244 گر باز آیی، دلم به من باز آری %~% هوشم به دل و، روان به تن باز آری(@)(@@) (@@) جانم که زتن برفت، اگر رای کنی %~% از نیمه رهش، به یک سخن باز آری(@)(@@)(@@)(@@) | فخر مبارکشاه(@)(@@) (@@) 2447 زهر غم تو خوردم و، لب خوش کردم %~% وز تو، دل خود به هر سبب خوش کردم(@)(@@) (@@) امروز، که کارها به دشنام رسید %~% من نیز دعا گفتم و، شب خوش کردم(@)(@@)(@@)(@@) | عماد بونصر(@)(@@) (@@) 2448 دشنام تو، صاحب سخنان می شنوند %~% نفرین تو، مردان و زنان می شنوند(@)(@@)(@@)(@@) | آهسته ترک! نه دشمنان می شنوند!(@)(@)PageV01P407(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0411.jpg)(@)(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 2449 در حق خود، از توصد سخن می شنوم %~% دشنام همی دهی و، من می شنوم(@)(@@) (@@) این سرد سخنها، نه توام می گویی %~% من، این همه زان لب و دهن می شنوم(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 2450 با من، کردی زبان به دشنام دراز %~% تا گشت از آن من، به فرجام دراز(@)(@@) ~~در مالش ما دست درازی چه کنی؟(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 2451 دلدار، به طعن من سخن می گوید %~% پنهان نه، میان انجمن می گوید(@)(@@) (@@) هم راضیم، ارخود همه دشنام دهد %~% آخر، نه بدان لب و دهن می گوید!(@)(@@)(@@)(@@) | قاضی ظهیر(@)(@@) (@@) 2452 آن دلبر خوش سخن، به هردم زدنی %~% صد نکته کند تعبیه، در هر سخنی(@)(@@) (@@) وان نیست عجب، که جز بدان باریکی %~% بیرون ناید سخن، زچونان دهنی!(@)(@@)(@@)(@@) | شرف شفروه(@)(@@) (@@) 2453 جان، در لب شیرین که نهفته ست جزاو؟ %~% گرد از ره دل، به دم که رفته ست جز او؟(@)(@@) (@@) گوهر، به دو یاقوت که سفتهست جز او %~% صد نکته، به یک نقطه که گفته ست جز او؟(@)(@@)(@@)(@@) | [جمال] عبدالرزاق(@)(@@) (@@) 2454 با حور وشی، که دلبری را شاید %~% گفتم: سخنت شکسته چون می زاید؟(@)(@@) (@@) گفتا: سخن از چنین دهانی که مراست %~% اوله %~% تا نشکنمش چگونه بیرون آید؟(@)(@@) ~~2455 دانی، سخنت شکسته چون می آیدبا لفظ، زبان تو زبون 
ms246	 می آید(@)(@@) ~~2،5 زان غالیه دان، کزو دلم خون آید تنگ است به غایتی دهانت، که از(@)(@@) او %~% وله %~% چندین سخن خوب، همی چون آید؟ %~% یک حرف، به ده پاره برون می آید(@)(@@) (@@) کز تنگ دهان تو، الف گاه سخن %~% چون لام دو تا گردد و، بیرون آید PageV01P408(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0412.jpg)(@)(@)(@@)(@@)(@@) | کمال اصفهانی(@)(@@) ~~2،57 یارم، به سخن دوش همی سفت شکر بر گوش، به خروار همی رفت شکر(@)(@@) (@@) گفتم که: چه چیز است بدین شیرینی؟ %~% پسته، به دل تنگ همی گفت: شکر!(@)(@@) ~~2،58 کوچک دهنت، که هست از او جاه سخن گویی گهر از لعل به در می افتد(@)(@@) %~% الغیره %~% خود نیست ز کو چکی در او راه سخن %~% چون در دهنت نگه کنم، گاه سخن(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~در فهم که آید و، که یارد گفتن 24،59 ای برده دلم قامت رعنای خوشت(@)(@@) %~% الغیره %~% وی کرده مرا شیفته، سودای خوشت %~% وصف دهن تنگ و، سخنهای خوشت؟(@)(@@) (@@) 2460 شیرین سخنت، زلب جدا می نشود %~% یک حرف، به ده پاره رها می نشود(@)(@@) ~~گویی، سخن توبر لبت عاشق شد 246 بردی دل من زمن، چه معنی دارد؟ صد(@)(@@) انجمن از بهر توبرهم زدهام %~% لغیره %~% ورنه، زلبت جدا چرا می نشود؟ %~%(@)(@@) این حیله و مکر و فن چه معنی دارد؟ %~% با من تو به انجمن چه معنی دارد؟(@)(@@)(@@)(@@) | جمال خلیل(@)(@@) ~~2463 یاری، که به جز رنج و عذابم ندهد در آتشم اندازد و، آبم ندهد(@)(@@) (@@) صد ره، گرش از سینهآ نالان پرسم %~% یک ره ز سر مهر، جوابم ندهد!(@)(@@)(@@)(@@) | الغیره(@)(@@) ~~243 شادم زغم تو، ای نگار، این عجب است من مهر توورزم و توکین، این عجب است(@)(@@) (@@) شیرین لب تو، پاسخ من تلخ دهد %~% این پاسخ تلخ، از لب شیرین عجب است(@)(@@)(@@)(@@) | یمین(@)(@@) (@@) 2464 شیرین سخنانت، که چنین دل شکن است. %~% انصاف بده، نه لایق آن دهن است!(@)(@@) ~~شیرین لب تو، تلخ نگفتی هرگز این بی نمکی، ز شور بختی من است!(@)(@@)(@@)(@@) | عزیز(@)(@@) ~~دوشت، سخنی 
ms247	 به رمز بر لفظ برفت PageV01P409(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0413.jpg)(@)(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 2466 گر بهرهآ ما از توجفا افتادهست %~% این نیز، هم از طالع ما افتادهست(@)(@@) (@@) داری لب و دندان ودهان شیرین %~% تلخی زبانت از کجا افتادهست؟(@)(@@)(@@)(@@) | بور بیدوالی(@)(@@) (@@) 2467 هر نکته، که آن ترک پریوش گوید %~% در بارهآ این جان ستمکش گوید(@)(@@) (@@) ترسم، به سر زبان بود با من خوش %~% کاو خود به سر زبان سخن خوش گوید!(@)(@@) ابوالمعالی نخاس(@)(@@) (@@) 68»2 ترکم، چوره عشوه گری برگیرد %~% دل، شیوهآ جان باختن از سر گیرد(@)(@@) (@@) جانم، به سجود سر نهد در پایش %~% چون او به سر زبان سخن در گیرد!(@)(@@) صدر خجندی(@)(@@) (@@) 2469 چون لطف سماع هست، جامی کم گیر %~% چون کار طرب بپخت، خامی کم گیر!(@)(@@) (@@) با لفظ خوش تونیست حاجت به شراب %~% با سحر حلال تو، حرامی کم گیر!(@)(@@) جمال خلیل شروانی(@)(@@) (@@) 2470 تا کی کشم از غم تو بیداد آخر %~% تا کی کنم از هجر تو فریاد آخر(@)(@@) (@@) 2471 گفتم، ز رخ ماهوشت واگویم در حق توای دوست، نه خونی کردم %~%(@)(@@) وله %~% با من سخنی بگو، چه افتاد آخر؟ %~% وز سلسلهآ مشوشت، واگویم(@)(@@) (@@) ز آواز خوشت، کنون چو آگاه شدم %~% زین پس، همه ز آواز خوشت واگویم!(@)(@@)(@@)(@@) | اله(@)(@@) ~~2472 ای جان عزیز بندهآ ناز خوشت انصاف که چون دلم خراشیده، خوش است(@)(@@) %~% %~% دل خیره، زلعل خانه پرداز خوشت %~% ای مرهم جان ودلم، آواز خوشت!(@)(@)PageV01P410(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0414.jpg)(@)(@)(@@) نمط بیست ونهم(@)(@@) درآینه نگرستن او(@)(@@)(@@)(@@) | فخر خالد(@)(@@) ~~24 خواهی صفت ارم، در آیینه نگر یا صورت جام جم، در آیینه نگر(@)(@@) ~~از بهر تماشا، به سوی باغ شدنرنجه چه کنی قدم؟ در آیینه نگر!(@)(@@)(@@)(@@) | الغیره(@)(@@) ~~2،74 در آینه، نقش صورت چین شدهای انگشت گز هزار مسکین شدهای(@)(@@) ~~یینه بنه، که حاجتت نیست بدانک بی آینه، خود تو خویشتن بین شدهای!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 2474 دی، دلبر من قصد دل وجان می کرد %~% کارم، چو سر زلف پریشان می کرد(@)(@@) (@@) برداشته بود آینه، رخ را می دید %~% در 
ms248	 خانه، تماشای گلستان می کرد!(@)(@@)(@@)(@@) | الغیره(@)(@@) ~~2476 زین ساز، که تو کرشمه را ساز کنی نشگفت که بر جمال خود ناز کنی(@)(@@) (@@) ایزد، چومنت کناد بر خود عاشق %~% تا، چشم در آیینه مگر باز کنی!(@)(@@)(@@)(@@) | کمال [اصفهانی](@)(@@) ~~2477 هر کو سر و زر به یار تسلیم کندخود را، ز غم فراق بی بیم کند(@)(@@) (@@) با دلبر خویش، روی در روی آرد %~% چون آینه، هر که پشت بر سیم کند(@)(@@)(@@)(@@) | نظامی(@)(@@) ~~2478 بیداد مکن، بر آنکه مست تو بود وزراه وفا، مهر پرست تو بود(@)(@@) ~~در آینه بین، اگر نه از دست شویآنگه دانم، که حق به دست تو بود!(@)(@@)(@@)(@@) | عبدالرزاق(@)(@@) ~~2479 هجر تو، همی ز دیده بگشاید نمچونانکه زدل، وصل تو بزداید غم(@)(@@) ~~در آینه منگر، که مرا از رشکت روی تو، به آیینه دریغ آید هم!(@)(@@)(@@)(@@) | کمال مراغی(@)(@@) ~~2480 ای نور رخ تو، رشک دیرینهآ مهر حسن تونهاد مهر، در سینهآ مهر(@)(@@) ~~هر صبح، که سر زخواب خوش برداری در روی تو دارد فلک، آیینهآ مهر!(@)(@)PageV01P411(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0415.jpg)(@)(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 2481 بی زر، بت من کجا سر من دارد؟ %~% کان آینه روی، دل چو آهن دارد(@)(@@) (@@) در آینهآ روی بتان، خوش نگرد %~% چون آینه، هر که وجه روشن دارد!(@)(@@)(@@)(@@) | جمال شروانی(@)(@@) (@@) 2482 ای طرهآ شام بندهآ گیسویت %~% پیشانی صبح صادق، آن ابرویت(@)(@@) (@@) در آینه منگر، که من از غایت رشک %~% نتوانم دید، دیده بیند رویت!(@)(@@)(@@)(@@) | شرف بیلقانی(@)(@@) ~~2483 گفتم که: در آیینه صفایی نبودمنمای بدو رخ، ارت رایی نبود(@)(@@) (@@) تا جان بدهم به رونما، گفتا: نه %~% به ز آینه، هیچ رونمایی نبود!(@)(@@)(@@)(@@) | نمط سی ام(@)(@@) درخواب وبیداری او(@)(@@) شمس اسعد گنجه ای(@)(@@) (@@) 2،84 فریاد، که آن سرو چمن می خسبد %~% و آرایش جان انجمن می خسبد(@)(@@) ~~او بخت من است و، نیک خواب آلودهستغمگینم از آنکه بخت من می خسبد!(@)(@@)(@@)(@@) | کمال اسماعیل(@)(@@) (@@) 2،85 فریاد، که آن ترک خطا می خسبد %~% و آسایش جان و دل ما می خسبد(@)(@@) (@@) عاجز شدهام، 
ms249	 که نرگس مخمورش %~% گر دولت ما نیست، چرا می خسبد؟(@)(@@)(@@)(@@) | الغیره(@)(@@) ~~2486 ای فتنه شده ز زلف شستت بیدار هرگز نشود نرگس مستت بیدار(@)(@@) (@@) زنهار، روا مدار هر شب تا روز %~% تو خفته و، عالمیی زدستت بیدار!(@)(@@)(@@)(@@) | کمال اسماعیل(@)(@@) ~~2487 ای کار توروز و شب جگر خواری من بسپار مخند، بر من وزاری من(@)(@@) ~~بیداری من به شب زناخفتن توستای خفثه، بیندیش زبیداری من!(@)(@)PageV01P412(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0416.jpg)(@)(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 2،88 در تن، رمقی ز جان آشفته نماند %~% جزئی زشکایت تو، نا گفته نماند(@)(@@) (@@) شبهاست، که از درد دلم در همه شهر %~% بیرون ز دو نرگس تو، یک خفته نماند!(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) شر درگه آن دلبر سرکش خفته 2489 بودم همه شب دوش، بر آتش خفته %~%(@)(@@) سرگشته و آشفته و، او خوش خفته! %~% در حسرت آن چهرهآ مهوش، خفته(@)(@@) ~~2491 یک خنده بزن، تا همه تن جان گردد بیدار شو از خواب خوش، ای جان وجهان وان نرگس نیم مست، از هم بگشا 249 آیا بود آنکه دل، به هوش تو(@)(@@) رسد؟ %~% لغیره %~% لغیره %~% تا جام می نشاط، گردان گردد! %~% دستم، به لب(@)(@@) شکر فروش تو رسد؟ %~% تا نالهآ زار من، به گوش تو رسد! %~% یک بوسه بده، تا شکر ارزان گردد(@)(@@)(@@)(@@) | 05(@)(@@) (@@) 2،92 ای ماه، مکن عر بده، برخیز، بخسب %~% با مطرب وبا حریف مستیز، بخسب!(@)(@@) (@@) شب بگذرد و، صبح کند پرده دری %~% مستی! ز شراب در میاو یز، بخسب!(@)(@@)(@@)(@@) | 00.(@)(@@) (@@) 249 ای بیخبراز غایت دلداری من %~% فارغ ز دل ستمکش و زاری من(@)(@@) (@@) خه خه! زشب کوته و، شب خفتن من %~% وه وه! ز شب دراز و، بیداری من!(@)(@@)(@@)(@@) | نمط سی ویکم(@)(@@)(@@)(@@) | در جفا وسنگدلی او(@)(@@)(@@)(@@) | کمال اصفهانی(@)(@@) (@@) 2494 ای شور جهانی ز لب شیرینت %~% وی خاصیت مهر گیا در کینت(@)(@@) (@@) صد رحمت، بر نرم دل آهن بادا %~% جایی، که رود یاد دل ستگینت!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 2495 چون دانستم، که گشت پیدا کینش %~% بنشست غباری، زمن مسکینش(@)(@@) (@@) سیلاب روان کردم، از چشمهآ چشم %~% باشد 
ms250	 که بگردد، آن دل سنگینش!(@)(@)PageV01P413(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0417.jpg)(@)(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~2496 گر نیست بتا، ز سنگ و آهن دل تو با من، زبرای چیست دشمن دل تو؟(@)(@@) (@@) صد بار، چو پروانه به پیشت مردم %~% ای شمع، چرا نسوخت بر من دل تو!(@)(@@)(@@)(@@) | مجد زنگی(@)(@@) (@@) 2497 زآتش دل من، زآب روشن دل تو %~% زآهن دل تو، در آن تن روشن تو(@)(@@) (@@) یا گرم شود آب تو از آتش من %~% یا نرم کند آتش من، آهن تو!(@)(@@) (@@) 2498 پیش چشمم به شب نمی ماند سیل %~% الغیره %~% جز بررخ من تخته غلط خواند سیل(@)(@@) (@@) باشد که به گردد دلت، از گریهآ من %~% زان روی، که سنگ را بگرداند سیل!(@)(@@) (@@) 2499 دل جای غم توست، چنان تنگ که هست %~% الغیره %~% گل چاکر روی تو، به هر رنگ که هست(@)(@@) (@@) از آب دو چشم من، بگردد هر شب %~% جز سنگ دلت، هر آسیا سنگ که هست!(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~2500 دیروز که یار قصد صحرا می کرد من جامه همی زدم به صد چاک، از او(@)(@@) %~% وان زلف به هم در شده را، وا می کرد %~% وان سنگدل، از دور تماشا می کرد!(@)(@@) فخر الدین مبارکشاه(@)(@@) (@@) 2501 بر چرخ، ز آه من شررها بینی حال دل من، کزان دلت می خندد %~% بر(@)(@@) خاک، زاشک من شمرها بینی %~% با اشک بگوی، تا اثرها بینی!(@)(@@)(@@)(@@) | اوله(@)(@@) ~~2502 جور تو به من رسد، مباهات کنم من آن نیم ای جان، که مکافات کنم(@)(@@) (@@) بر رهگذر، ارسنگ سیاهی بینم %~% بغیره %~% از بهر دل تواش، مراعات کنم!(@)(@@) (@@) 250 با بنده جفا مکن، که ارزانی نیست %~% وین کار، بدینسان که تومی دانی نیست(@)(@@) یدادگرا، شهر مسلمانان است %~% واندر دل تو، هیچ مسلمانی نیست!(@)(@@) (@@) 250 در حال دلم، اگر نظاره کنیی %~% الغیره(@)(@@) ~~گر یافتیی خبر، زبیچارگیم PageV01P414(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0418.jpg)(@)(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~2505 بر حسن خودت، گرچه تمتایی هست واندر سرت، از جمال سودایی هست(@)(@@) (@@) میرحم از آنی، که هر امروزی را %~% اندیشه نمی کنی، که فردایی هست!(@)(@@)(@@)(@@) | لغیره 
ms251	(@)(@@) ~~2506 از سنگدلیت چون به جان درماند چشمم، شب و روز اشک خون می راند(@)(@@) (@@) گویند که: سنگ را بگرداند سیل %~% چون اشک رهی، دلت نمی گرداند؟(@)(@@)(@@)(@@) | انوری(@)(@@) (@@) 2507 گر در همه عمر، یک نکویی بکنی %~% صد گونه، جفا و زشتخویی بکنی(@)(@@) (@@) ثویی که: به رغم تو چنین خواهد بود! %~% داری سر آنکه هر چه گویی، بکنی!(@)(@@)(@@)(@@) | کمال(@)(@@) (@@) 2508 گفتی که: دلت چند پیاپی سوزد %~% بیچاره نه آتش است، تا کی سوزد!(@)(@@) (@@) ای نور دو چشم من، ببخشای بر آنک %~% اوله %~% با سنگدلی، دل تو بر وی سوزد!(@)(@@) (@@) 2509 ای دوست، مرا اگرچه دشمن دانی %~% حال دل من، تو بهتر از من دانی(@)(@@) (@@) خود نیست زتوامید رحمت، ورنه %~% حال شب من، چو روز روشن دانی!(@)(@@)(@@)(@@) | اوله(@)(@@) ~~2510 نه بی رخت، انتظار دانم کردننه جز غمت، اختیاردانم کردن(@)(@@) (@@) تو هر چه توانی زجفا، باز مگیر %~% من گر نکشم، چه کار دانم کردن!(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 251 با هیچ دلی، چنگ وفایی نزدی! %~% در پردهآ عشاق، هوایی نزدی!(@)(@@) (@@) رساز وفا، راست نکردی قولی %~% غیره %~% کان را تو، ترانهآ جفایی نزدی!(@)(@@) (@@) 251 در عشق تو گشتم، زدل و دیده بری %~% از بس که خورم غم و، کنم نوحه گری(@)(@@) (@@) درد دل و، آب چشم و، روی زردم %~% می بینی و، تن می زنی و، می نگری!(@)(@)PageV01P415(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0419.jpg)(@)(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~2513 گفتم به دلت مهر مرا رخت آید لیکن زبدی موافق بخت آید(@)(@@) (@@) تو کین مرا بنا نهادی، در دل %~% بنیاد که بر سنگ نهی، سخت آید!(@)(@@)(@@)(@@) | جمال اشهری(@)(@@) (@@) 2514 گر دامن بیدلیت در چنگ آید %~% خواهی، که جهان جمله بر او تنگ آید(@)(@@) (@@) بیرون کنی از سر، این همه تنگدلی %~% ایضا %~% گر با چو خودیت، پای در سنگ آید!(@)(@@) (@@) 2515 در کوی ملامت، اینت منزل که تو راست! %~% وز نقد ستیزه، اینت حاصل که تو راست!(@)(@@) (@@) من کرده هزار بار نرمی و، هنوز %~% هم نرم نشد دلت، زهی دل که تو راست!(@)(@@)(@@)(@@) | سجاسی(@)(@@) (@@) 2516 دوش، 
ms252	 از سر عشوه های بیحاصل دوست %~% فریاد من اوفتاد، در منزل دوست(@)(@@) (@@) بر من همه در باز شد، الا دریار %~% بر من همه دل بسوخت، الا دل دوست!(@)(@@)(@@)(@@) | لیر(@)(@@) ~~2517 دل بر هوست نهادنی نیست، ولیک درهای غمت گشادنی نیست، ولیک!(@)(@@) (@@) دل را به تو، ای سنگدل مهر گسل %~% من دانستم که دادنی نیست، ولیک!(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~2518 صد ره ز برم صبر گریزد روزی صد سیل ز چشم من بخیزد روزی(@)(@@) (@@) از آب دو چشم من، کجا پرهیزد %~% آن کس، که هزار خون بریزد روزی!(@)(@@)(@@)(@@) | هستی(@)(@@) ~~2519 بس خون، که بدان دو چشم خونخواره کنیبس دل، که بدان دو زلف، آواره کنی(@)(@@) (@@) ایزد، به دل تو رحمتی در فکناد %~% تا، چارهآ عاشقان بیچاره کنی!(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~2520 عمری است، که در سینه نهانی دارم از آب دو دیده تر جهانی دارم(@)(@@) (@@) تو سخت دلی داری، لیکن انصاف %~% من سخت تر از دل تو، جانی دارم!(@)(@@)(@@)(@@) | حاقانی(@)(@@) (@@) 2521 بیذاد بر این تنگدل، آخر بس کن %~% ای ظالم ده رنگ دل، آخر بس کن(@)(@@) (@@) از خیره کشیت، سنگ بر من بگریست %~% ای خیره کش سنگدل، آخر بس کن!(@)(@)PageV01P416(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0420.jpg)(@)(@)(@@)(@@)(@@) | عزیز(@)(@@) (@@) 2522 از جان وفا نمای من، شرمت باد! %~% وز سینهآ غم سزای من، شرمت باد!(@)(@@) (@@) تو جور و جفا کنی و، من مهر و وفا %~% از جور خود و وفای من، شرمت باد!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 2523 چون از تو شدم سوخته خرمن، چه کنم؟ %~% چندین گلهآ دوست به دشمن، چه کنم؟(@)(@@) (@@) رنج وغم عاشقی، همین شاید بود %~% چون در تو اثر نمی کند، من چه کنم؟(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 2524 از محنت تو، مرا رهایی نبود %~% تا جان مرا، ز من جدایی نبود(@)(@@) (@@) مشتاب به کشتنم، که بازارتورا %~% از کشتن من، هیچ روایی نبود!(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~2520 با لطف توچون چرخ زبون آید آبدر چشم، بر لطف تو چون آید آب؟(@)(@@) (@@) از سنگ دلت، لطیفه ها نیست عجب %~% لغیره %~% زیرا که هم از سنگ برون آید 
ms253	 آب!(@)(@@) (@@) 2526 آن کس که طریق مهر پویید، منم %~% وان کس که وفا ومهر ورزید ، منم(@)(@@) (@@) وان کس، که همه جهان به یک دوست بداد %~% وانگه هم از آن دوست وفا دید، منم!(@)(@@)(@@)(@@) | صدر(@)(@@) (@@) 2527 نه، ماه بود به دلفروزی که تویی %~% نه، مهر بود به دیده دوزی که تویی(@)(@@) (@@) خون دل من، حلال دانی برخود 2528 دلدار، بدان زلف دو تا می نازد %~%(@)(@@) وله %~% احسنت، زهی حرام روزی که تویی! %~% وان ترک خطا، هم به خطا می نازد(@)(@@) (@@) نومید شدم، که توبه ازجور کند %~% کو، در دو جهان خود به جفا می نازد!(@)(@@)(@@)(@@) | اشهری(@)(@@) ~~2529 تا، دیده کم جان و دل و تن نگرفت در دیده، خیال دوست مسکن نگرفت(@)(@@) (@@) بگرفت گریبان دلم عشق کسی %~% صدر %~% کاو را حق هیچ دوست، دامن نگرفت(@)(@@) ~~2530 مپسند مرا به تاب ای تب، زنهار دریاب به وصلم ای شکر لب، زنهار(@)(@@) (@@) گر سنگ بدی، زسوز من نرم شدی %~% هم نرم نشد دل تویارب، زنهار!(@)(@)PageV01P417(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0421.jpg)(@)(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 2531 چندان به بلای عشق تو در غمی ام %~% کز لاغریم، سایه نبیند زمی ام(@)(@@) (@@) رحم آر، ببخش بر دل مسکینم %~% پولادنیم، سنگ نیم، آدمی ام!(@)(@@)(@@)(@@) | نمط سی ودوم(@)(@@) در عشوه ودم معشوق(@)(@@)(@@)(@@) | مرتضی(@)(@@) (@@) 2532 گفتی که: دلم بی توبه صد درد و غم است %~% من بنده که باشم، این چه لطف و کرم است!(@)(@@) (@@) گفتی که: دمی نیم ز کارت فارغ %~% زنهار، که تا بارد گر این چه دم است!(@)(@@)(@@)(@@) | له(@)(@@) (@@) 2533 خون می خورم از دلی، که قوتش غم توست %~% وز مهر تو دشمن من و، محرم توست(@)(@@) (@@) چون شمع به دید گه همی سوزم، لیک %~% می میرم از آن باد، که نامش دم توست!(@)(@@)(@@)(@@) | سلیمانشاه ایوه ای(@)(@@) (@@) 2534 هر چند، دلم سوخته تر می گردد %~% هر دم، به تو آموخته تر می گردد(@)(@@) (@@) زنهار، دمم مده که در کورهآ دل %~% آتش، به دم افروخته ترمی گردد(@)(@@)(@@)(@@) | ثیر(@)(@@) ~~2535 ای داده غمت به 
ms254	 باد عیش خوش ما وی بسته بر آب دیدگان مفرش ما(@)(@@) ~~ما را، دم و عشوهآ تو بر باد نشاندتا چند، به دم تیز کنی آتش ما؟(@)(@@)(@@)(@@) | جمال] عبدالرزاق(@)(@@) (@@) 2536 ای دل، یارت کمر در آزار توبست %~% خوش باش که جمله وهم در کار توبست(@)(@@) ~~هر عشوه، که در جهان کسی زو نخرید 2537 چون وصل توام نیست مها، چه(@)(@@) کنم؟ %~% وله %~% آورد، به نرخ نیک در بار توبست! %~% با هجر ستیزه کار، خود را چه کنم؟(@)(@@) (@@) دوشم گفتی: آن توام، فارغ باش %~% دانم که دمم می دهی، اما چه کنم؟(@)(@@)(@@)(@@) | سید اشرف PageV01P418(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0422.jpg)(@)(@)(@@)(@@)(@@) | مبارکشاه(@)(@@) (@@) 2539 معشوقهآ پیمان شکنت می دانم %~% پیمان شکنی پر سخنت می دانم(@)(@@) (@@) هر روز، دلی به عشوه در بند کنی %~% هی، هی که تو چیستی؟ منت می دانم!(@)(@@)(@@)(@@) | [کمال] اسماعیل(@)(@@) (@@) 254 دی گفت: ندیدمت در این روزی بیست %~% خیر است، کم آمدن چرا؟ موجب چیست؟(@)(@@) (@@) بیش لب او، همین زمان بتوان مرد! %~% صد سال، به لطف این سخن بتوان زیست!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 2541 خرسند نشد یار، به سربازی من %~% برخاست غمش، به خانه پردازی من(@)(@@) ~~از من، به بهای عشوه جان می خواهد 2542 حاشا که تو پند کس پذیری هرگز(@)(@@) %~% اوله %~% دل می گوید: بخر، به انبازی من! %~% یا دست من شیفته گیری هرگز(@)(@@) (@@) گفتی: پس ازین با تو وفا خواهم کرد! %~% اوله %~% چندان بنمیر تا نمیری هرگز(@)(@@) (@@) 2543 ای مهر گسل، که با توام پیوند است %~% از تو، به یکی وعده دلم خرسند است!(@)(@@) (@@) لطفی بکن و، بگو که: «(من زان توام!» %~% پیداست، که قیمت دروغی چند است!(@)(@@)(@@)(@@) | کریم طوسی(@)(@@) (@@) 2544 در عشق تو، قوت شرابم همه مهر %~% ساغر همه جان، بادهآ نابم همه مهر(@)(@@) (@@) هر چند توپیش من چو صبحی، همه دم! %~% من در پی تو چو آفتابم، همه مهر!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 2545 نام ستمت، نقش نگین باید کرد %~% زیر قدمت، دیده زمین باید کرد(@)(@@) (@@) گفتی که : سر تودارم ازعالم [و] بس! %~% ترسم، 
ms255	 که سر اندر سر این باید کرد!(@)(@@)(@@)(@@) | مجد طایی(@)(@@) ~~2546 ای راحت جانها رخ فرخندهآ تو وی قوت روانها ز شکر خندهآ تو(@)(@@) ~~گفتی که: «به حدمت نومی باسد دن؛3 PageV01P419(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0423.jpg)(@)(@)(@@) عبد الواسع جبلی(@)(@@) (@@) 2547 تا در شکن زلف تو، دلبندیهاست %~% جان را، به غم عشق تو خرسندیهاست(@)(@@) (@@) گفتی که: «مرا باش، که من آن توام» %~% نور دل من! این چه خداوندیهاست!(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 2548 کام از لب جانفزای، کم می دهی ام %~% هر لحظه، هزار گونه غم می دهی ام(@)(@@) (@@) با من گویی: ««بیا، که من آن توام!) %~% ای کشته مرا غم تو، دم می دهی ام!(@)(@@)(@@)(@@) | رضی(@)(@@) (@@) 2549 ای هیچ تورا غم من مسکین نه %~% یک ذره، دل تو را وفا آیین نه!(@)(@@) (@@) من خود قدری شنیده بودم، زین پیش %~% از عشوه گریهات، ولی چندین نه!(@)(@@)(@@)(@@) | جمال خلیل(@)(@@) ~~2550 هر لاف، که از درد و غمی شاید زد از ماهرخی و محرمی، شاید زد(@)(@@) (@@) با این همه دم، که می دهیم شب وروز %~% در عمر، دمی با تو نمی شاید زد!(@)(@@)(@@)(@@) | اله(@)(@@) (@@) 2551 ای مرغ جمال یار، پرواز مگیر %~% یعنی: کم این عاشق دمساز مگیر(@)(@@) ~~راضی شدهام از لب توبه عشوهای(؟) آن عشوهآ جانستان، ز من باز مگیر(@)(@@) کمال خجندی(@)(@@) ~~2552 زان زلف به خم، قد مرا خم چه دهی؟ وز روی چومه، دل مرا غم چه دهی؟(@)(@@) (@@) گفتی: پس ازین، کار توبه خواهد شد %~% بگذار که دم برآورم، دم چه دهی!(@)(@@)(@@)(@@) | مجیر بیلقانی(@)(@@) ~~2553 از لشکر صبرم، علمی بیش نماندوزهر چه مرا بود، غمی بیش نماند(@)(@@) ~~این طرفه تر است، کز سر عشوه هنوز دم می دهی و، زمن دمی بیش نماند!(@)(@@)(@@)(@@) | الغیره(@)(@@) ~~2554 بر من زتو، هر دم زدنی تیماری است وزگلبن وصل تو، نصیبم خاری است(@)(@@) (@@) بر وعدهآ اومید وصالت، هر روز %~% من جان دهم وتوعشوه، مشکل کاری است!(@)(@)PageV01P420(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0424.jpg)(@)(@)(@@) نمط سی وسوم(@)(@@) در وعده وانتظار او(@)(@@)(@@)(@@) | سلطان شهاب(@)(@@) (@@) 255 کس با غم تو، 
