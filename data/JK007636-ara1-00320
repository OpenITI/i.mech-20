ms301	 منة تغيث على % % جور عزيز قلبه حمق % % PageV01P1372 البحر : - 1(@)(@@) % قف بباب العلا وقل يا كتابي % % عن لساني قول الخويدم حقا % % 2(@)(@@) % أنا عبد مكاتب غير أني % % لست أخشى من مالك الرق عتقا % % PageV01P1373 البحر : - 1(@)(@@) % غار أخوك الغيث يا سيدي % % فصد عن رؤياك طرفا شقيق % % 2(@)(@@) % فها أنا اليوم لفرط الأسى % % والوحل لاأعرف أين الطريق % % PageV01P1374 البحر : - 1(@)(@@) % تقول لي الغيداء تحتاج رافقا % من الدمع والتبريح قلت لها رفقا % % 2(@)(@@) % شجوني لا ترقى كملسوع خاطيء % ودمعي كحظي ساقط وهو لا يرقا % % PageV01P1375 البحر : - 1(@)(@@) % ألا قل لقاضي قضاة الانام % % أمام التقى ذي الفخار العربق % % 2(@)(@@) % لقد حار عبدك يا سيدي % % وحق الجليل بحق الدقيق % % PageV01P1376 البحر : - 1(@)(@@) % لزهر الشقائق والبدر من % % جلا وجنتيك انتساب عريق % % 2(@)(@@) % فهذا أخوها بمعنى الشبيه % % وفي اللون هذا أخوها الشقيق % % PageV01P1377 البحر : - 1(@)(@@) % بأبي نقي الردف يصعب تارة % % ويعيده سعد يهون الملتقى % % 2(@)(@@) % ويحثني داعي الهوى فبحقه % % يا سعد عرج بي على وادي النقا % % PageV01P1378 البحر : - 1(@)(@@) % أفدي خليلا ما كان يجمع لي % % بين الثمينين من خلائقه % % 2(@)(@@) % ان ضن بالوصل من لقاه فما % % يضن بالوصل من مهارته % % PageV01P1379 البحر : - 1(@)(@@) % كذا أبدا يا أجل الورى % % نوالك بين الورى يرتزق % % 2(@)(@@) % تقدم طرسا وتسدي ندى % فمنك الثمار ومنا الورق % % PageV01P1380 البحر : - 1(@)(@@) % أعتقت رقي من الخطوب فما % % أطيب فيك الثنا وما أعبق % % 2(@)(@@) % لك الولاء الجميل اخلصته % % يا معتقي والولاء لمن اعتق % % PageV01P1381 البحر : - 1(@)(@@) % طوق جود الوزير جيدي % % فلست عن مدحه أعوق % % 2(@)(@@) % أسجع بالمدح في علاه % % لا غرو أن يسجع المطوق % % PageV01P1382 البحر : - 1(@)(@@) % بدا وفي خاله توار % فيا لها طلعة شريقه % % 2(@)(@@) % جوهرة ما علمت الا % % دموع عيني لها عقيقه % % PageV01P1383 البحر : - 1(@)(@@) % لك الله قد خففت عني مؤونتي % % فما لي اذا عن راحة السر عائق % % 2(@)(@@) % وعمرت بيتي بالدقيق فلم أسل % % وكم لك في فعل الجميل دقائق % % PageV01P1384 البحر : - 1(@)(@@) % يا من للحيته دجى % قد رد نوم العاشق % % 2(@)(@@) % عجل بموسى قاطع % واقذف بها من حالق % % PageV01P1385 البحر : - 1(@)(@@) % لا آخذ الله غزال النقا 
ms302	 % % أي عنا أبقى على العاشق % % 2(@)(@@) % ما بين حجل أو وشاح بدا % % وراح بالصامت والناطق % % PageV01P1386 البحر : - 1(@)(@@) % لا تنس يا مولاي قمحية % % لمعشر حاموا على أفقها % % 2(@)(@@) % كيلان لا يقنع من جودكم % % لو أنها كيلان في شرقها % % PageV01P1387 البحر : - 1(@)(@@) % شربت مدامة الندمان يوما % فلاموني على ترك الطريق % % 2(@)(@@) % ثكلتهم أما علموا بأني % % خليع أشتهي شرب العتيق % % PageV01P1388 البحر : - 1(@)(@@) % آه كم قد شقيت من جرب الجس % % م وكم ذا حالي به مفروق % % 2(@)(@@) % خلق الناس كلهم من تراب % وكأني من الحصى مخلوق % % PageV01P1389 البحر : - 1(@)(@@) % أجيراننا حيي دياركم الحيا % % وطاف عليها للغمائم ساقي % % 2(@)(@@) % فقد أنفذ التوديع حاصل أدمعي % % ولم يبق منه للمنازل باقي % % PageV01P1390 البحر : - 1(@)(@@) % على أنكم آنستموني بذكركم % % فقد كدت لا أشكو زمان فراق % % 2(@)(@@) % وإني لمجنون الفؤاد بحبكم % % فهلا ولو في الحين دمعي راقي % % PageV01P1391 البحر : - 1(@)(@@) % رب ليل ترى المجرة فيه % % ذات خط ينضي العيون دقيق % % 2(@)(@@) % حسبته الجوزا طريقا إلى الص % % بح فباتت وعينها للطريق % % PageV01P1392 البحر : - 1(@)(@@) % حدثتني يوم اللقا فتصا % % ممت ازديادا من لفظها المعشوق % % 2(@)(@@) % أدفع الهم بالحديث إذا عا % % د كما يدفع الورى بالعتيق % % PageV01P1393 البحر : - 1(@)(@@) % استنشدوني لطيف شعري % % و القلب بالجوع في حريق % % 2(@)(@@) % و قيل هل من دقيق معنى % % فقال لهفي على الدقيق % % PageV01P1394 البحر : - 1(@)(@@) % طوقت جيدي بالعطاء ومدحتي % % فأنا المطوق ساجع لك في الورق % % 2(@)(@@) % من فعلك اشتق المقال فمن يقل % % هذا تصدق قيل إذ هذا صدق % % PageV01P1395 البحر : - 1(@)(@@) % يئست من الصداقة منك لما % % تمادى منك إعراض وثيق % % 2(@)(@@) % و من عجب الزمان إذا اعتبرنا % % خليل ما يجي منه صديق % % PageV01P1396 البحر : - 1(@)(@@) % كيف الهناء بعيد النحر عندكم % % يا سادة ملكوا الدنيا بتحقيق % % 2(@)(@@) % و كل أيامكم مما تريق دما % في البأس أو في الندى أيام تشريق % % PageV01P1397 البحر : - 1(@)(@@) % يا رب كلب في راحتي حجر % % يذوده والحمام ينطلق % % 2(@)(@@) % أمسكت عن رميه وأعجبني % % تعذيبه بالنباح والقلق % % PageV01P1398 البحر : - 1(@)(@@) % تسلى فؤادي بعد الهوى % % و نامت جفوني بعد الأرق % % 2(@)(@@) % وردتم شجوني إلى أن عفت 
ms303	 % % كما أنضج الشيء حتى احترق % % PageV01P1399 البحر : - 1(@)(@@) % يا أرزق العين والتعدي % % أجرمت في العاشقين حقا % % 2(@)(@@) % طليبك الله يوم يدعو % % و تحشر المجرمين زرقا % % PageV01P1400 البحر : - 1(@)(@@) % لك مقلة إنسانها % % يجني علي وأعشق % % 2(@)(@@) % فاعجب لمن أحببته % % و هو العدو الأزرق % % PageV01P1401 البحر : - 1(@)(@@) % تصرمت الأيام دون وصالك % % فمن شافعي في الحب يا ابنة مالك % % 2(@)(@@) % فكان الكرى يدني خيالك وانقضى % % فلا منك تنويل ولا من خيالك % % 3(@)(@@) % رويدك قد أوثقت بالهم مهجتي % % عليك فماذا يبتغى بملالك % % 4(@)(@@) % أفي كل يوم لي اليك مطالب % عليك ولكنها محفوفة بمهالك % % 5(@)(@@) % وغيران قد مد الحجاب من الظبا % % وقد كان يكفيه حجاب دلالك % % 6(@)(@@) % فتنت بخال فوق خدك صانه % % أبوك فويلي من أبيك وخالك % % 7(@)(@@) % وعاينت منك الشمس بعدا وبهجة % فيا عجبا من واثق بحبالك % % 8(@)(@@) % هجرت وما فاز المحب بزورة % فديتك زوري واهجري بعد ذلك % % 9(@)(@@) % لك الله قلبا كلما جر طرفه % % إلى الحسن القى عروة المتماسك % % 10(@)(@@) % تأبط شرا من أذى الوجد وانثنى % % كثير الهوى شتى النوى والمسالك % % PageV01P1402 11(@)(@@) % قفي تنظريه في لظى البيد تابعا % سرام وإلا في رماد ديارك % % 12(@)(@@) % سقى الله أكناف الديار هوامعا % تبيت بها الأزهار غر المضاحك % % 13(@)(@@) % كأن ندى الملك المؤيد جادها % % فاسفر نوار الربى عن سبائك % % 14(@)(@@) % مليك إلى مغناه تستبق المنى % % مسابقة الحجاج نحو المناسك % % 15(@)(@@) % له شيم تحصي المدائح وصفها % % إذا أحصيت زهر النجوم الشوابك % % 16(@)(@@) % وفي الأرض أخبار له ومآثر % تسير سرى الأسماء بين الملائك % % 17(@)(@@) % حمى الأرض من آرائه وسيوفه % % بكل مضيء في دجى الخطب فاتك % % 18(@)(@@) % وسكنها حتى لو اختار لم تمس % % غصون النقا تحت الرياح السواهك % % 19(@)(@@) % ولما جلا الملك المؤيد رأيه % % جلا ظله الممدود وهج الممالك % % 20(@)(@@) % مهيب السطا هامي العطا سابق العلى % % جلي الحلا كشاف ليل المعارك % % PageV01P1403 21(@)(@@) % تولى فيا عجز الاكاسرة الأولى % % وجاد فقلنا يا حياء البرامك % % 22(@)(@@) % وشاركه العافون في ذات ماله % % وليس له في مجده من مشارك % % 23(@)(@@) % كريم يجيل الرأي فعلا ومنطقا % فلا يرتضي غير 
ms304	 الدراري السوامك % % 24(@)(@@) % كعوب القنا عجبا براحته التي % % يروي نداها مشرعات طوالك % % 25(@)(@@) % اذا هز منها الملك كعبا مثقفا % فيا لك من كعب عليه مبارك % % 26(@)(@@) % وان جر في صوب الثغور رؤسها % % جلت قلح الأعداء اجلاء المساوك % % 27(@)(@@) % ولله من أقلام علم بكفه % % سوالب ألباب الرجال سوالك % % 28(@)(@@) % كأن معانيها كواعب تنجلي % % على حبك الإدراج فوق آرائك % % 29(@)(@@) % كأن بياض الطرس بين سطورها % % أياديه في طي السنين الحوالك % % 30(@)(@@) % أمسدي الأيادي البيض دعوة ظافر % لديك على رغم الزمان المماحك % % PageV01P1404 31(@)(@@) % عطفت على حالي بنظرة سائر % % وقد مد فيها الدهر راحة هاتك % % 32(@)(@@) % فدونك من مدحي اجتهاد مقصر % % تداركت من أحواله شلوها لك % % 33(@)(@@) % تملكه الهم المبرح برهة % إلى أن محى رضوان صولة مالك % % PageV01P1405 البحر : - 1(@)(@@) % لثمت ثغر عذولي حين سماك % % فلذ حتى كأني لاثم فاك % % 2(@)(@@) % حبا لذكراك في سمعي وفي خلدي % % هذا وان جرحت في القلب ذكراك % % 3(@)(@@) % تيهي وصدي اذا ماشئت واحتكي % % على النفوس فإن الحسن ولاك % % 4(@)(@@) % وطولي من عذابي في هواك عسى % % يطول في الحشر ايقافي وإياك % % 5(@)(@@) % في فيك خمر وفي عطف الصبا ميد % % فما تثنيك إلا من ثناياك % % 6(@)(@@) % وما بكيت لكوني فيك ذا تلف % إلا لكون سعير القلب مأواك % % 7(@)(@@) % بالرغم ان لم أقل يا أصل حرقته % % ليهنك اليوم إن القلب مرعاك % % 8(@)(@@) % يا أدمعا لي قد أنفقتها سرفا % ما كان عن ذا الوفا والبر أغناك % % 9(@)(@@) % ويا مديرة صدغيها لقبلتها % % لقد غدت أوجه العشاق ترضاك % % 10(@)(@@) % مهما سلونا فلا نسلو ليالينا % % وما نسينا فلا والله ننساك % % PageV01P1406 11(@)(@@) % نكاد نلقتاك بالذكرى إذا خطرت % % كأنما اسمك يا سعدي مسماك % % 12(@)(@@) % وتشتكي الطير نعابا بفرقتنا % % وما طيور النوى إلا مطاياك % % 13(@)(@@) % لقد عرفناك أياما وداومنا % % شجو فيا ليت أنا ما عرفناك % % 14(@)(@@) % نرعى عهودك في حل ومرتحل % رعي ابن أيوب حال اللائد الشاكي % % 15(@)(@@) % العالم الملك السيار سؤدده % % في الأرض سير الدراري بين أفلاك % % 16(@)(@@) % ذاك الذي قالت العليا لأنعمه % % لا أصغر الله في الأحوال 
ms305	 ممساك % % 17(@)(@@) % له أحاديث تغني كل مجدية % عن الحياء وتجلي كل أحلاك % % 18(@)(@@) % ما بين خيط الدجى والفجر واضحة % كأنها درر من بين أسلاك % % 19(@)(@@) % كافاك يا دولة الملك المؤيد عن % % بر البرية من للفضل أعطاك % % 20(@)(@@) % لك الفتوة والفتوى محررة % % لله ماذا على الحالين أفتاك % % PageV01P1407 21(@)(@@) % أحييت مامات من علم ومن كرم % فزادك الله من فضل وحياك % % 22(@)(@@) % من ذا يجمع ما جمعت من شرف % في الخافقين ومن يسعى كمسعاك % % 23(@)(@@) % أنسى المؤيد أخبار الأولى سلفوا % % في الملك ما بين وهاب وفتاك % % 24(@)(@@) % ذي الرأي يشكي السلاح الجم حدته % % لذاك يسمى السلاح الجم بالشاكي % % 25(@)(@@) % والمكرمات التي افترت مباسمها % % والغيث بالرعد يبدي شهقة الباكي % % 26(@)(@@) % قل للبدور استجني في الغمام فقد % % محا سنا ابن علي حسن مرآك % % 27(@)(@@) % إن ادعيت من البشر المصيف به % % غيظا فقد ثبتت في الوجه دعواك % % 28(@)(@@) % يا أيها الملك المدلول قاصده % % وضده نحو ستار وهتاك % % 29(@)(@@) % لو أدركتك بنوا العباس لانتصرت % % بمقدم في ظلامك الخطب ضحاك % % 30(@)(@@) % مظفر الجد من حظ ومن نسب % مبصر بخفي الرشد مدراك % % PageV01P1408 31(@)(@@) % وحدته في الورى بالقصد وارتفعت % % وسائلي فيه عن زيغ وإشراك % % 32(@)(@@) % ما عارضت يد امداحي مواهبه % % إلا رجعت بصفو المغنم الزاكي % % 33(@)(@@) % إن الكرام اذا حاولت صيدهم % كانت بيوت المعالي مثل إشراك % % 34(@)(@@) % سقيا لدنياك لا كف بخائبة % فيها لديك ولا وصف بأفاك % % 35(@)(@@) % من كان في خيفة الانفاق يمسكها % % فانت تنفقها من خوف إمساك % % PageV01P1409 البحر : - 1(@)(@@) % طيف تصيدته والليل محتبك % % من حلية الشهب أو من شعره الحبك % % 2(@)(@@) % بين الذوائب تمشي في حبائلها % % يا حبذا الظبي أو يا حبذا الشرك % % 3(@)(@@) % عجبت من لائم هنكي على قمر % الشمس منه على الحيطان تنهتك % % 4(@)(@@) % محجب لا يراه العاذلون ولا % % أصغى اليهم وإن بروا وإن أفكوا % % 5(@)(@@) % فليتهم نظروه واستمعت لهم % % وخلصوني من جفنيه واشتبكوا % % 6(@)(@@) % أبكي وعاذلي التعبان يطلبني % % أسلو فيأخذني من عقله الضحك % % 7(@)(@@) % و كيف أسلو هوى بدر رضيت بأن % % أشقى به وهو في 
ms306	 اللذات منهمك % % 8(@)(@@) % لو يعلم الترك أهلوه بأني قد % % شبهته البدر ما أبقوا ولا تركوا % % 9(@)(@@) % أمير حسن كما قلنا أمير تقى % % في الشام وهو على شهيائه ملك % % 10(@)(@@) % سيف الملوك وكافيهم اذا منحوا % % يوم العطاء ويوم البؤس إن فتكوا % % PageV01P1410 11(@)(@@) % نحيي بلقياه أن نفني بفرقته % % كأنما نحن يا بحر الندى سمك % % 12(@)(@@) % قالوا امتدحه فقلت العي معذرة % % قالوا فخذ من حلاه الدر ينسلك % % 13(@)(@@) % أمداحه من عطاه أو فضائله % % كأن أمداحه من تبره سبكوا % % 14(@)(@@) % ذو الجود والبأس كم يحيى ببينة % من حي أو يهلك الأعدا بما هلكوا % % 15(@)(@@) % يظن من طار خوفا من مهابته % % أن النجوم عليه في الدجى شبك % % 16(@)(@@) % و في النهار يري خيلا يضاعفها % % كأن ظل المذاكي خلفها رمك % % 17(@)(@@) % فالشام كالحرم المأمون طائره % % فيه الأماني وفيه البر والنسك % % 18(@)(@@) % نعم وفي حلب فاضت مراضعها % % جدوى خوارزم كالأنواء تعترك % % 19(@)(@@) % و الغيث يهمل لامحل ولا سغب % والأمن يشمل لا خوف ولا درك % % 20(@)(@@) % إن جاد فالمزن في العافين منسفح % أو جال فالدم في العادين منسفك % % PageV01P1411 21(@)(@@) % و دولة الناصر السلطان زاهرة % وللسعود على أمصارها برك % % 22(@)(@@) % كانت عدى الملك كالثعبان فاصطلحوا % % وبعضهم كان كالبرغوث فانفركوا % % 23(@)(@@) % إذا تفرزن في الطاغين بندقهم % % فرأسه بتراب الحتف ينمعك % % 24(@)(@@) % كسرى من الدولة الشهباء منكسر % % قدما وقيصر بالتقصير مرتبك % % 25(@)(@@) % فالأمن يعمر منها فوق ما تعبوا % % والرعب يردع عنها فوق ما فتكوا % % 26(@)(@@) % و أنت نجل ذوي ملك لخدمته % % قد قدموا منه في الأرواح ما ملكوا % % 27(@)(@@) % أنت البداوة في الترك الأولى نشأوا % % مع الضراغم في الأغيال تشترك % % 28(@)(@@) % خيولهم في الوغى للبيض راكضة % % وفي جفان القرى كالبدن تبترك % % 29(@)(@@) % محمرة في العطا آلاف ما وهبوا % % كأنهم لدم الأكياس قد سفكوا % % 30(@)(@@) % يامن بحبل ولاه أو مواهبة % % ومن بمسك ثناه فاز ممتسك % % PageV01P1412 31(@)(@@) % جبرا لها مدحة لولاك ما انسلكت % % نظما به سار قوم أيه سلكوا % % 32(@)(@@) % كم مثلها قلت في روض الشباب وكم % % قد قال غيري فبان الزهر والحسك 
ms307	 % % 33(@)(@@) % قصرت نظمي الا أنه نخب % وطول الناس الا أنهم لبكوا % % 34(@)(@@) % و ما تقضت لبانات لطائفة % % قالت حلاوة ألفاظي لقد علكوا % % 35(@)(@@) % فليعذر الآن مغلوب بعائلة % ليس السكوت بمجديهم ولا الحرك % % 36(@)(@@) % تدور في أحرف الألفاظ هامته % % وما يدور على حرف لهم حنك % % 37(@)(@@) % أموت حزنا إذا عانيت حالهم % % وما بي الموت إلا هذه الترك % % 38(@)(@@) % خلصت رزقهم من كيد كائدهم % % وغبت عنهم فلا والله ما تركوا % % 39(@)(@@) % و لي خصوم ولست الآن شاكيهم % % لكنهم في غد يدرون أين شكوا % % 40(@)(@@) % لا زال حظك من دنيا وآخرة % % ميسرا وحظوظ الناس تعترك % % PageV01P1413 41(@)(@@) % يجري بسؤددك الوضاح كل ثنا % كأنما هو نجم والثنا فلك % % PageV01P1414 البحر : - 1(@)(@@) % أمنزل سعدي بالعذيب سقاكما % % ملث الحيا حتى يبل صداكما % % 2(@)(@@) % صدى كلما أدعو أجاب كأننا % % خلقنا على أطلالها نتشاكى % % 3(@)(@@) % وربع محا ركض الجنائب رسمه % % وجوم غوادي المرزمين دراكا % % 4(@)(@@) % وقفت أناي الصبر في جنباته % % ألا أين مغناها وأين غناكما % % 5(@)(@@) % كأني بكثر الهم أختم في الثرى % % رهينة قلب لا يحش فكاكا % % 6(@)(@@) % يعز على المشتاق يا طلل النقا % % بلاه على حكم النوى وبلاكا % % 7(@)(@@) % وما عن رضى خف القطين ثنية % % فأثبت في جسمي الضنا ومحاكا % % 8(@)(@@) % و طيف سرى للشام من أرض بابل % % لأبعدت يا طيف الحبيب مداكا % % 9(@)(@@) % و ذكرتني العهد القديم على الحمى % % رعى الله أيام الحمى ورعاكا % % 10(@)(@@) % فديتك طيفا لا يذكر ناسيا % ولكن يزيد المستهام هلاكا % % PageV01P1415 11(@)(@@) % تصيدته والأفق مقتبل الدجى % % تخال النجوم الزهر فيه شباكا % % 12(@)(@@) % إلى أن تيقظنا على أرج كما % % بذكر شهاب الدين يفتح فاكا % % 13(@)(@@) % إمام إذا هز اليراع مفاخرا % به الدهر قال الدهر لست هناكا % % 14(@)(@@) % و قالت له العليا فداك ذوو العلى % % وإن قل شيء أن يكون فداكا % % 15(@)(@@) % و قال زماني ما تضر إساءتي % % إذا استغفرت لي في الآثام يداكا % % 16(@)(@@) % لك الله ما أزكى وأشرف همة % % وأنجح في كسب العلوم سراكا % % 17(@)(@@) % علوت فأدركت النجوم فصغتها % % كلاما ففقت القائلين بذاكا % % 18(@)(@@) % و 
ms308	 حزنت معاني القول من كل وجهة % % فأبق علينا نبذة لثناكا % % 19(@)(@@) % و حكت رقيق اللفظ منفردا به % % وقد قيل إن الروض حاك فحاكى % % 20(@)(@@) % و جاوزت صوب الغيث في حلبة الندى % % فعبس لما جزته وتباكى % % PageV01P1416 21(@)(@@) % و لو لم تكن للجود في الناس آية % % لما كان منهل الغمام تلاكا % % 22(@)(@@) % متى تتميز مادحوك ولم تقل % % من الوصف الا ماتقول عداكا % % 23(@)(@@) % تجاورت أشتات المساعي إلى العلى % % وزدت فاعيى الواصفين سناكا % % 24(@)(@@) % و حقك ما فوق البسيطة لاحق % فقصر رعاك الله بعض خطاكا % % 25(@)(@@) % مدحتك لا أبغي ثراء بذلته % % الي ولكن رفعة بثراكا % % 26(@)(@@) % بعيشك الا ما تأملت صفو ما % % منحتك من ودي بعين رضاكا % % 27(@)(@@) % فأقسم ما ضمت كحبك أضلعي % % ولا استنشقت روحي كنشر هواكا % % 28(@)(@@) % أكاد أطيق السيل أدفع صدره % % ولا أدعي أني أطيق جفاكا % % 29(@)(@@) % و من ذا الذي يدري حلا ما أقوله % % سواك ومن يدري سواي حلاكا % % 30(@)(@@) % تخذتك انسا حين أوحشني الورى % % وقلت لرآءي المستقيم هناكا % % PageV01P1417 31(@)(@@) % يجدد لي ذكرى كمالك نقصهم % % كأني من كل الأنام أراكا % % 32(@)(@@) % فلا وحماك الرحم لابت مهديا % حقائق أمداحي لغير حماكا % % 33(@)(@@) % بلى ربما آنست في الفكرة فترة % % فجربت فكري فد مديح سواكا % % PageV01P1418 البحر : - 1(@)(@@) % خليلي من مصر قفا نبك في السبك % % على عيشنا بالنيل في فلك الفلك % % 2(@)(@@) % على مصر والهفي على مصر لهفة % % يصح بها قلبي المشوق على السبك % % 3(@)(@@) % ويا طربي فيها إلى سود أعين % على مثلها في كل داجية أبكي % % 4(@)(@@) % أعاذلتي ما أنت مني في الهوى % % ولا أنا في أنساب هذا الهوى منك % % 5(@)(@@) % تشك سهام اللحظ قلبي بالأسى % % وقلبك خال من سهام بلا شك % % 6(@)(@@) % بكم آل فضل الله طافت مقاصدي % % وتم على نجح الرجا بكم نسكي % % 7(@)(@@) % رفضت الورى لما علقت حبالكم % % ونزهت دين الحب فيكم عن الشرك % % 8(@)(@@) % وستر فؤادي أن أقلام بدركم % % سرور لذي ود وغيظ لذي محك % % 9(@)(@@) % لأقلام مولانا ثنا متضوع % فهل هي في الكافور تكتب بالمسك % % 10(@)(@@) % و 
ms309	 ماهي إلا القضب اما موائسا % واما مواضي الحد تحمي حمى الملك % % PageV01P1419 11(@)(@@) % اذا مادعاها الرأي يا عزة الهدى % % بذا فدعاها السطو ياذلة الشرك % % 12(@)(@@) % اذا أتبعت ألفاظها بصريرها % % طربنا لاقوال البلاغة في هنك % % 13(@)(@@) % اذا ما اليد البيضاء ألقت عضالها % % تلقف صنع الحق صنع ذوي الافك % % 14(@)(@@) % و ان لم تكن موسى فان محمدا % كثيرالأيادي البيض في الظلم الحلك % % 15(@)(@@) % نعم إنها في كفه قصب العلى % % بسفن وتحملن العلى ضخمة السمك % % 16(@)(@@) % دقاق تحملن الجليل وتشتكي % % اليها فلا تشكو ولكنها تشكي % % 17(@)(@@) % تربت بآكام الاسود ترابها % % مواقع سحب ما نداها بمنفك % % 18(@)(@@) % فجاءت تحاكي الاسد والسحب سطوة % % وجودا وللحاكي فحار على المحكي % % 19(@)(@@) % مسخرة تجري بما ينفع الورى % % على يده فانظر إلى البحر والفلك % % 20(@)(@@) % مؤمرة تسري إلى حومة الوغى % % ومن أسود في أبيض علم الرنك % % PageV01P1420 21(@)(@@) % مسددة الأفعال والبأس والندى % % مثقفة الآراء في الأخذ والترك % % 22(@)(@@) % فأحسن بها في الطرس هيفا كحيلة % % تريك قدود العرب مع ثقل الترك % % 23(@)(@@) % و أعجب لها كالنبل تنكي وتارة % % تحصن من وقع النبال التي تنكي % % 24(@)(@@) % و بالظل منها وهو ظل يراعة % % تمر على الدنيا ستورا من الهتك % % 25(@)(@@) % هي الألفات المائلات بكفه % % على أنها اللامات في المعرك الضنك % % 26(@)(@@) % قصار تحاماها الرماح طويلة % % نواحل يستشفى بها الحال من وعك % % 27(@)(@@) % و أقسم ما الشهب المنيرة في السما % % اذا كتبت يمناه أرفع من تلك % % 28(@)(@@) % يدك الحيا دورا وفي سحبها حيا % ينجي ديار المقترين من الدك % % 29(@)(@@) % و يعلو على تبر السبائك حظها % % فان شئت حاكي بالسبائك أو احكي % % 30(@)(@@) % و كم قلم مامر تلو دواته % % وهن لتدبير الممالك في دنك % % PageV01P1421 31(@)(@@) % أمامك يا ممتازها ومشيرها % % طريقان شتى من نجاة ومن هلك % % 32(@)(@@) % تلاعب بالابطال ان قصدوا الفنا % % كأن الوغى منها يلاعب بالدك % % 33(@)(@@) % فلا برحت بدرية النصر والعلى % % مؤملة النعماء مرهوبة الفتك % % 34(@)(@@) % لها أسطر مثل السيوف لدى الوغى % % وترميلها في صحفها من دم السفك % % 35(@)(@@) % و لو نوزعت في فخرها قال 
ms310	 ربها % % نعم في يدي هذا الفخار وفي ملكي % % 36(@)(@@) % و لو أن سيفا فاتحا فك غمده % % يصور عليها عاجل الفك بالفك % 37(@)(@@) % عوارفها كالمزن دائمة البكا % % وأدراجها كالزهر دائمة الضحك % % 38(@)(@@) % أنظم در الوصف من نظمها لها % % وليس لألفاظي سوى رقة السلك % % PageV01P1422 البحر : - 1(@)(@@) % يا بارقا من نحو بشر باسمه % % أذكرتني عهد الهوى المتروكا % % 2(@)(@@) % وحكيت ايماض الثغور فلا تسل % % عن خافق من أضلع تحكيكا % % 3(@)(@@) % خذ من دموع العين جارية فقد % % خلفت قلبي للأسى مملوكا % % 4(@)(@@) % وعهدته للحب بيتا سالما % فعلام يتركه الأسى منهوكا % % 5(@)(@@) % إيها فقد شفي ابن خضر فلم يدع % % قلبا ولا جدا لنا موعوكا % % 6(@)(@@) % تاج العلى والعلم والكرم الذي % % أضحى له تبر الثنا مسبوكا % % 7(@)(@@) % والواضح الفضل الذي لم يلق في % % علياه لا لبسا ولا تشكيكا % % 8(@)(@@) % والطاهر النسب العريق فحبذا % % أصل وفرع في العلى يرضيكا % % 9(@)(@@) % أبناء بيت ما رأت عين الثنا % % شيئا لهم في الفضل لا وأبيكا % % 10(@)(@@) % يا ابن العلى أحيا مقام علائهم % % متوحدا لا يقبل التشريكا % % PageV01P1423 11(@)(@@) % يا من بكفي جاهه ونواله % أحبا وأحيا الخامل الصعلوكا % % 12(@)(@@) % الله بالبر المعجل والشفا % % ستر الزمان وحالنا المهتوكا % % 13(@)(@@) % لا زال مثلي كل شاكر نعمة % يدعو بطول بقاك أو يدعوكا % % 14(@)(@@) % لك في الأولى حظ وفي طرق العلى % % قدم وكف يحسنان سلوكا % % PageV01P1424 البحر : - 1(@)(@@) % يا طالب الجود لا تتعب أمانيكا % % فقد تغيب نجم كان يهديكا % % 2(@)(@@) % ويا فتى القصد يروي عن غمام يد % فلك الذي كان ترويه ويرويكا % % 3(@)(@@) % إنا إلى الله من دهياء قد جعلت % % معنى التصبر بين الناس متروكا % % 4(@)(@@) % و حسرة ثنت الأجفان جارية % % والقلب تحت أسار الحزن مملوكا % % 5(@)(@@) % آها لفقدك نجم الدين من رجل % لو أن آها تروي غلتي فيكا % % 6(@)(@@) % أرعى النجوم لعلي أن أراك بها % % لا بالثراء وقبل أن أراعيكا % % 7(@)(@@) % و أسكب الدمع محمرا كأني قد % % أجريت ذائب ما أعطيت مسبوكا % % 8(@)(@@) % من لي بنفس يكون الخطب قابلها % % فكنت أفدي حمى العليا وأفديكا % % 9(@)(@@) % مالي اناديك 
ms311	 والنعماء صامتة % % وما عهدتك تلقى من يناديكا % % 10(@)(@@) % هذا الغياب الذي قد كنت أحسبه % % حتى أكاد قبيل الفقد أبكيكا % % PageV01P1425 11(@)(@@) % لهفي عليك لفضل ماتركت به % % في القول فضلا ولا في الخلق صعلوكا % % 12(@)(@@) % لهفي عليك لبيت قد تحيفه % % عروض دهر فأضحى البيت منهوكا % % 13(@)(@@) % لهفي عليك لأحكام مسددة % % تدني إلى الغرض الاقصى مراميكا % % 14(@)(@@) % لهفي عليك لآداب مهذبة % % لحظا يراعيك أو لفظا يناجيكا % % 15(@)(@@) % إن يفقد المستفيد العلم من كلم % % ملكا فقد فقد الصوفي تسليكا % % 16(@)(@@) % من للفضائل تحلوها لهاك لنا % % وللفواصل تجلوها مساعيكا % % 17(@)(@@) % من للقصائد يستوفي موازنها % % فيض الندى وهو من جدوى معانيكا % % 18(@)(@@) % من للمعاني التي صيرت غايتها % % للأسر عتقا وللأحرار تمليكا % % 19(@)(@@) % فمن يجاريك يعرف قدر ما فقدت % % منك الأنام وقل لي من يجاريكا % % 20(@)(@@) % قالوا السراة كثير حين تخبرهم % % الآن يبصر من يسري مساريكا % % PageV01P1426 21(@)(@@) % ماكان ضر المنايا في تقبلها % % لو تستبيح بني الدنيا وتخطيكا % % 22(@)(@@) % يا غائبا ولهى كفيه حاضرة % % مهما سلوت فلا والله أسلوكا % % 23(@)(@@) % اني لأذكر للاحسان مر يد % فكيف أنسى وقد حلت أياديكا % % 24(@)(@@) % واخجلتا لمقام قد حضرت به % % وما سقاني بكاس الموت ساقيكا % % 25(@)(@@) % و في لك الجود لما صح ذينكما % % نعم ومالخل إلا من يوافيكا % % 26(@)(@@) % و أصبحت قضب الاسلام ناكسة % % شعثا محاسنها تحكي مساويكا % % 27(@)(@@) % كانت عوالي يستكفي الزمان بها % % ثم انقضت فروينا عن عواليكا % % 28(@)(@@) % ما كنت إلا غماما زال عن أفق % % من بعد ما كفت الدنيا غواديكا % % 29(@)(@@) % وطود حلم هوى من بعد ما زحمت % % وكر السما ونسريها معاليكا % % 30(@)(@@) % تلقى أعاديك بالإحسان مبتسما % حتى يكاد ولي أن يعاديكا % % PageV01P1427 31(@)(@@) % وتحمل الأمر قد أنضت فوادحه % % صم الجبال ولكن ليس ينضيكا % % 32(@)(@@) % لو شك طرف امريء في الشمس طالعة % % لم يبق في فضلك الوضاح تشكيكا % % 33(@)(@@) % ولو حمى المرء من موت صنائعه % % لأقبلت من فجاج الأرض تحميكا % % 34(@)(@@) % هذي وفودك قد أمت ثراك كما % % أمت بعين الندى قدما معانيكا % % 35(@)(@@) % قاموا يعزون فيك اليوم أنفسهم % % وقمت في 
ms312	 الجود والعليا أعزيكا % % 36(@)(@@) % أمر بالربع والأجفان تنشده % % بليت ياربع حتى كدت أبكيكا % % 37(@)(@@) % كأن بابك لم تحفل مواكبه % % وبرق بشرك لم يحلب عزاليكا % % 38(@)(@@) % بعدا ليومك ما أبكى نواك وما % % أحلى لمطلب النعمى مجانيكا % % 39(@)(@@) % حست دمشق وفاضت نفسها أسفا % % أما ترى محلها بالمحل مسفوكا % % 40(@)(@@) % كانت أياديك من بين البلاد بها % % سترا فأصبح ذاك الستر مهتوكا % % PageV01P1428 41(@)(@@) % اذا شدا الطير شق الزهر من أسف % ثيابه فكأن الطير يرثيكا % % 42(@)(@@) % لا تبعدن فلا لاقيت مغربة % ولا سلكت طريقا ليس مسلوكا % % 43(@)(@@) % ولا انثنيت قصي الدار محتجنا % إلا وشخص بنيك الطهر يدنيكا % % 44(@)(@@) % جادت ضريحك أخلاف الغمام ولا % % زالت تجر ذيولا فوق ناديكا % % 45(@)(@@) % ما أنت ميت وهذا الذكر منتشر % وانما نحن موتى من تناسيكا % % PageV01P1429 البحر : - 1(@)(@@) % قالوا أمير فقال العدل بل ملك % % قالت مخافته لله بل ملك % % 2(@)(@@) % نعم علي العلي دنيا وآخرة % % والعقل يشهد والآثار والفلك % % 3(@)(@@) % لو تسأل البدر أنباعن سناه بلا % % تكلف وتجلى باسمه الحلك % % 4(@)(@@) % فليهن شام له من دأبه حلب % حماه بأسا فلا بأس ولا درك % % 5(@)(@@) % كم آمن فيه أمن الطير في حرم % وكان مثل قطاة غرها شرك % % 6(@)(@@) % لا تذكرن بحارا عند أنعمه % % إن البحار لدى نعمائه برك % % 7(@)(@@) % واسمع مدائح كالاسلاك من درر % غنى بها ما دحوه أية سلكوا % % PageV01P1430 البحر : - 1(@)(@@) % نقلوا انني سلوت هواك % % آه من نقل آثم أفاك % % 2(@)(@@) % حاش لله لو سليت على النا % % ر فؤادي ما كنت ممن سلاك % % 3(@)(@@) % سائلي سائل الدموع بخدي % % عن جوى القلب وانظري مغناك % % 4(@)(@@) % ولقد لام في ضنا الجسنم لاه % ما قضى ما قضيته في حماك % % 5(@)(@@) % لائمي ان في الضنا لي عذرا % كلما اشتقت أهل وادي الأراك % % 6(@)(@@) % فسقى الغيث بالأراك حبيبا % صار جسمي عليه كالمسواك % % 7(@)(@@) % ومليكا قد مات بعد مليك % بحماه يا حر قلبي لذاك % % PageV01P1431 البحر : - 1(@)(@@) % تصول بأسياف الجفون وتسفك % % فيا لدم من جفن عيني يسفك % % 2(@)(@@) % حلت لي منها نسبة قاهرية % % على أن قلبي في هواها 
ms313	 مشبك % % 3(@)(@@) % ان استبعدت قلبي فنظمي على الورى % % بمدح الامام المالكي مملك % % 4(@)(@@) % أقاضي القضاة العلم فردا وسوددا % ايا فرد ودي انه فيك يشرك % % 5(@)(@@) % ملكت ولائي بالندى وشرطت لي % % فكان الندى بالجاه والشرط أملك % % 6(@)(@@) % فهنئت بالأعياد سالكة الهنا % % إليك بمنظوم الثناء يسلك % % 7(@)(@@) % ولا برح العافي بذلك أو شذا % % مديحك ما بين الورى يتمسك % % PageV01P1432 البحر : - 1(@)(@@) % اذا وصف الانسان بالبر والتقى % % يقولون هذا من عديد الملائكة % % 2(@)(@@) % وأقسم يا جبريل ما لك في الورى % % مثيل فأيد يا إلهي مسالكه % % 3(@)(@@) % وبالناصر السلطان زده مكانة % وعمر به أملاكه وممالكه % % 4(@)(@@) % وعجل لراجي بابه كل ساعة % % مطالبه أو للشقي مهالكه % % PageV01P1433 البحر : - 1(@)(@@) % هنئت يا أكرم العباد به % % عاما سعيدا على معاليكا % % 2(@)(@@) % يخدم علياك بالهلال أما % % تراه كيف انحنى يحبيكا % % 3(@)(@@) % كأنه منجل حباك به % % يحصد أعمار من يعاديكا % % PageV01P1434 البحر : - 1(@)(@@) % ومولع بفخاخ % % يمدها وشباك % % 2(@)(@@) % قالت لي العين ماذا % % يصيد قلت كراك % % PageV01P1435 البحر : - 1(@)(@@) % لي صديق سيد سند % بيننا الآداب مشتركه % % 2(@)(@@) % كلما قابلت طلعته % % قيل لي سعدها بركه % % PageV01P1436 البحر : - 1(@)(@@) % كان لي عبد يسمى فرجا % % نصب الغير عليه الشبكا % % 2(@)(@@) % وأنا اليوم كما تبصرني % % ليس عندي فرج الا البكا % % PageV01P1437 البحر : - 1(@)(@@) % قالت خزائن علم ان شكا ألما % وزيرنا فلنعم الأخوة الشركه % % 2(@)(@@) % هذا أخوه اذي بالسعد أنعته % % الله يبقي لنا في عمره البركه % % PageV01P1438 البحر : - 1(@)(@@) % حبذا للدين والدنيا فتى % حيثما كان سعيد الحركه % % 2(@)(@@) % كل أفق سار فيه ذكره % % يا له سعد ثنته بركه % % PageV01P1439 البحر : - 1(@)(@@) % أنا في خير ومير بحمى % % صاحب سلك قصدي مسلكه % % 2(@)(@@) % أصل ذا سعد من الله أتى % % ولعمري كل هذا بركه % % PageV01P1440 البحر : - 1(@)(@@) % يا معتق المذنبين مما % % خافوا من النار والمهالك % % 2(@)(@@) % أعتق من المهلكات رقي % % ولا تحكم علي مالك % % PageV01P1441 البحر : - 1(@)(@@) % مولاي رفقا بقلب % صدعته بجفائك % % 2(@)(@@) % لا تكسرن إناء % ملآنة بولائك % % PageV01P1442 البحر : - 1(@)(@@) % عش يا محمد سالما بيت العلى % % إذ كل بيت في الورى منهوك % % 2(@)(@@) % وفدى لك المملوك بالأمس انقضى 
ms314	 % % يا سيدي وفدى لك المملوك % % PageV01P1443 البحر : - 1(@)(@@) % أقول للشاهد إذ ينثني % % عطف رشا قلبي به قد هلك % % 2(@)(@@) % يا معطف الشاهد سبحان من % % سواك في الحسن ومن عدلك % % PageV01P1444 البحر : - 1(@)(@@) % رب ذي شرط على الخ % % د وذي خال ممسك % % 2(@)(@@) % ملكا قلبي في الحب % وكان الشرط أملك % % PageV01P1445 البحر : - 1(@)(@@) % سلبت محاسنك الغزال صفاته % % حتى تحير كل ظبي فيكا % % 2(@)(@@) % لك جيده ولحاظه ونفاره % % وغدا تصير قرونه لأبيكا % % PageV01P1446 البحر : - 1(@)(@@) % لوالدك الممدوح مرأى مبارك % ولولاك في عليائه لم يشارك % % 2(@)(@@) % فان ترو أخبار التقى عنك والعلى % % فإنك عبد الله وابن المبارك % PageV01P1447 البحر : - 1(@)(@@) % إن عشت فيكم بغير قوت % فلست مستنكرا لذلك % % 2(@)(@@) % ما كنت فيكم بآدمي % فصرت من جملة الملائك % % PageV01P1448 البحر : - 1(@)(@@) % يا جفوني دعي الكرى بعد مرأى % % فاتن الحسن ناصب لشراك % 2(@)(@@) % فهو إما بحرفه أو بحسن % % ليس ينفك صائدا لكراكي % % PageV01P1449 البحر : - 1(@)(@@) % ومليح اذا نظرت إليه % % نظرة خففت أليم عذابك % % 2(@)(@@) % قال لي جفنه استعد لحربي % % قلت يا خده دمي في ثيابك % % PageV01P1450 البحر : - 1(@)(@@) % جدتم بما قل عن ظنوني % % فزاد في لوعتي وهلكي % % 2(@)(@@) % لا لذة اليسر في حماكم % % نلت ولا لذة التشكي % % PageV01P1451 البحر : - 1(@)(@@) % ما الطرف بعدكم بالنوم مكحول % % هذا وكم بيننا من ربعكم ميل % % 2(@)(@@) % يا باعثين سهادا لي وفيض بكا % % مهما بعثتم على العينين محمول % % 3(@)(@@) % هبكم منعتم جفوني من خيالكم % % فكيف يمنع تذكار وتخييل % % 4(@)(@@) % في ذمة الله قلب يوم بينكم % موزع ودم في الحب مطلول % % 5(@)(@@) % شغلتم بصباح الأنس مبتسما % وناظري بظلام الليل مشغول % % 6(@)(@@) % كأنما الأفق محراب عكفت به % % والنيرات بأفقيه قناديل % % 7(@)(@@) % ما يمسك الهدب دمعي حين أذكركم % % إلا كما يمسك الماء الغرابيل % % 8(@)(@@) % ورب عاذلة فيما أكابده % % وقل ما قيل والتحذير معذول % % 9(@)(@@) % باتت زخارفها بالصبر واعدة ع وما مواعيدها إلا الأباطيلص سقيا لعهد الصبا والدار دانية سقط شطرين ص % % والشمل مجتمع والجمع مشمول % % 10(@)(@@) % يفدي الزمان الذي في عامه قصر % هذا الزمان الذي في يومه طول % % PageV01P1452 11(@)(@@) % لم لا أشبب 
ms315	 بالعيش الذي سلفت % % أوقاته وهو باللذات موصول % % 12(@)(@@) % لو كنت ارتاع من عذل لروعني % % سيف المشيب برأسي وهو مسلول % % 13(@)(@@) % أما ترى الشيب قد دلت كواكبه % % على الطريق لو أن الصب مدلول % % 14(@)(@@) % و السن قد قرعتها الأربعون وفي % % ضمائر النفس تسويف وتسويل % % 15(@)(@@) % حتى م أسأل عن لهو وعن لعب % % وفي غد أنا عن عقباه مسؤول % % 16(@)(@@) % و لي سعاد شجون ما يعب لها % % إما خيال وإلا فهو تخييل % % 17(@)(@@) % أبكي اشتياقا اليها وهي قاتلتي % % يا من رأى قاتلا يبكيه مقتول % % 18(@)(@@) % مسكية الخال أما ورد وجنتها % % فبالجنى من عيون الناس مبلول % % 19(@)(@@) % فإن يفح من نواحي خدها عبق % فالمسك فيه بماء الورد مجبول % % 20(@)(@@) % تفتر عن شنب حلو لذائقه % % في ذكره لمجاج النحل تعسيل % % PageV01P1453 21(@)(@@) % مصحح النقل عن شهد وعن برد % لأنه منهل بالراح معلول % % 22(@)(@@) % و بارق من اعالي الجذع أرقني % % حتى دموعي على مرجانه لولو % % 23(@)(@@) % مذكري بدنانير الوجوه هدى % % تحف في فيه عذال مثاقيل % % 24(@)(@@) % إلى العقيق فهل يا طيب طيبة لي % % عقد بلفظي إلى مغناك منقول % % 25(@)(@@) % و هل رأى حامل الرجوى كأني من % % شوقي ومن ولهي بالقرب محمول % % 26(@)(@@) % إن لم أنل عملا أرجو النجاة فلي % % من الرسول بإذن الله تنويل % % 27(@)(@@) % حسبي بمدحي رسول باب نجا % يرجى اذا اعترضت تلك التهاويل % % 28(@)(@@) % أقول والقدر أعلا أن يحاوله % % وصل وان جهدت فيه الأقاويل % % 29(@)(@@) % ماذا عسى الشعراء اليوم مادحة % % من بعد ما مدحت حم تنزيل % % 30(@)(@@) % و أفصحت بالثنا كتب مقدمة % % إن جيل في الدهر توراة وانجيل % % PageV01P1454 31(@)(@@) % محمد المجتبي معنى جبلته % % وما لآدم طين بعد مجبول % % 32(@)(@@) % و المجتلى تاج علياه الرفيع وما % % للبدر تاج ولا للنجم إكليل % % 33(@)(@@) % لولاه ما كان أرض لا ولا أفق % % ولا زمان ولا خلق ولا جيل % % 34(@)(@@) % و لا مناسك فيها للهدى شهب % % ولا ديار بها للوحي تنزيل % % 35(@)(@@) % ذو المعجزات التي ما استطاع أبرهة % يغزو منازلها كلا ولا الفيل % % 36(@)(@@) % إن شق ايوان كسرى رهبة 
ms316	 فلقد % % جاء الدليل بأن الكفر مخذول % % 37(@)(@@) % و إن خبا ضرم النيران من زمن % % فالبحر منسحب الأذيال مسدول % % 38(@)(@@) % أوفى النبيين سيفا واتضاح على % % كأنه غرة والقوم تحجيل % % 39(@)(@@) % نعم اليتيم اذا عدت جواهرهم % % وضمها من عقود الوحي تفصيل % % 40(@)(@@) % مازال في الخلق ذاجاه وذا خدم % % لكن خادمه المشهور جبريل % % PageV01P1455 41(@)(@@) % مبرأ القلب من ريب ومن دنس % % وكيف وهو بماء الخلد مغسول % % 42(@)(@@) % مجاهدا في سبيل الله مصطبرا % على الجراح وبعض الجرح تعديل % % 43(@)(@@) % في معشر نجب تغزو نبالهم % مالا غزت في العدى الطير الابابيل % % 44(@)(@@) % كأنما نبل ماضيهم وحاضرهم % % لها على من بغى سجل وسجيل % % 45(@)(@@) % مثل الشواطب ان صالوا أو افتخروا % % فالحد مندلق والعرض مصقول % % 46(@)(@@) % يطيب في الليل تسبيح لسامرهم % % ومالهم عن حياض الموت تهليل % % 47(@)(@@) % كأنهم لانتظار الفضل بيت ثنا % % شخص النبي له معنى وتكميل % % 48(@)(@@) % قوم إذا رقصت فرسانهم طربا % كأن رايات أيديهم مناديل % % 49(@)(@@) % الكاتبون من الاجسام ما اعتبرت % % سمر وبيض فمنقوط ومشكول % % 50(@)(@@) % حيث الحمام شهي وهو من صبر % % يجنى فيا حبذا الغر البهاليل % % PageV01P1456 51(@)(@@) % حتى استقام عمود الدين وانفتحت % % سبل الهدى وخبت تلك الاضاليل % % 52(@)(@@) % روح النجاة الذي قد كان يهرع في % % أبواب مغناه روح الوحي جبريل % % 53(@)(@@) % و مفصح حين يروي الصاد من كرم % % فللمحاسن ترتيب وترتيل % % 54(@)(@@) % و جائد لا يخاف الفقر قال ندى % % كفيه يا مادحي آلائه قولوا % % 55(@)(@@) % و ماالاقاويل ان طالت وان قصرت % % عروض ما بسطت تلك الافاعيل % % 56(@)(@@) % حامي حمى البيت بالرعب المقدم ما % % ناواه أبرهة العادي ولا الفيل % % 57(@)(@@) % تضيئ في الحرب والمحراب طلعته % % فحبذا في الدجى والنقع قنديل % % 58(@)(@@) % و قام في ظل بيت الله شائده % % فحبذا لنظام البيت تكميل % % 59(@)(@@) % ذاك الذي نصبت في نحو بعثته % % هذي المحاريب لا تلك التماثيل % % 60(@)(@@) % و فاض من جانب البطحا لكل حمى % % صاف بأبيض أضحى وهو مشمول % % PageV01P1457 61(@)(@@) % و كل أرض بها الجناب مزهرة % % للمؤمنين فتعجيل وتأجيل % % 62(@)(@@) % وكل ملة دين غير ملته % % تروى فللقابس القسيس 
ms317	 قنديل % % 63(@)(@@) % ولليهودي مع كحل العمى نظر % % على المجوسي أيضا فيه نكحيل % % 64(@)(@@) % حتى أتى عربي يستضاء به % % مهند من سيوف الله مسلول % % 65(@)(@@) % كم معجز لرسول الله قد خذلت % % به العدى وعدو الحق مخذول % % 66(@)(@@) % فاض الزلال المهنى من أصابعه % % نعم الأصابع من كفيه والنيل % % 67(@)(@@) % وبورك الزاد إذ مسته راحته % % فحبذا مشرب منها ومأكول % % 68(@)(@@) % وخاطبته وحوش البيد مقبلة % فالرجل عاسلة واللفظ معسول % % 69(@)(@@) % وحاز سهم المعالي حين كان له % % من قاب قوسين تنويه وتنويل % % 70(@)(@@) % على البراق لوجه البرق من خجل % % ورجل مسعاه تلوين وتشكيل % % PageV01P1458 71(@)(@@) % لسدرة المنتهى يا منتهى طلبي % % ما مثله ياختام الرسل تحويل % % 72(@)(@@) % يا خاتم الرسل لي في المذنبين غدا % على شفاعتك الغراء تعويل % % 73(@)(@@) % ان كان كعب بما قد قال ضيفك في % % دار النعيم فلي في الباب تطفيل % % 74(@)(@@) % وأين كابن زهير لي شذا كلم % ربيعها بغمام القرب مطلول % % 75(@)(@@) % وإن سمي بزهير صيغة فعسى % % يسمو بنبت له بالشبه تعليل % % 76(@)(@@) % بانت معاذير عجزي عن نداك وعن % % بانت سعاد فقلبي اليوم متبول % % 77(@)(@@) % صلى عليك الذي أعطاك منزلة % شفيعها في مقام الحشر مقبول % % 78(@)(@@) % أنت الملاذ لنا دنيا وآخرة % فباب قصدك في الدارين مأهول % % PageV01P1459 البحر : - 1(@)(@@) % نفس عن الحب ما حادت ولا غفلت % % بأي ذنب وقاك الله قد قتلت % % 2(@)(@@) % وعين صب إلى مرآك قد لمحت % % كفى من الدمع والتسهيد ما حملت % % 3(@)(@@) % دعها ومدمعها الجاري فقد لقيت % % ما قدمت من أذى قلبي وما عملت % % 4(@)(@@) % أفديك من ناشط الأجفان في تلفي % % والسحر يوهم طرفي أنها كسلت % % 5(@)(@@) % وواضح الحسن لوشاءت ذوائبه % % في الأفق وصل دجى الظلماء لاتصلت % % 6(@)(@@) % معسل بنعاس في لواحظه % % أما تراها إلى كل القلوب حلت % % 7(@)(@@) % من لي بألحاظ ظبي تدعي كسلا % وكم ثياب ضنا حامكت وكم غزلت % % 8(@)(@@) % وسمرة فوق خديه ومرشفه % % هذي تروت مجانيها وذي ذبلت % % 9(@)(@@) % أما كفاني تكحيل الجفون أسى % حتى المراشف أيضا باللمى كحلت % % 10(@)(@@) % لو ذقت برد رضاب في مراشفه % % يا حار 
ms318	 ما لمت أعضائي التي ثملت % % PageV01P1460 11(@)(@@) % أستودع الله أعطافا شوت كبدي % % وكلما رمت تجديد الوصال قلت % % 12(@)(@@) % ومهجة لي كم ألقت بمسمعها % % إلى الملام ولا والله ما قبلت % % 13(@)(@@) % كأن عيني اذا ارفضت مدامعها % % عن المؤيد أو صوب الحيا نقلت % % 14(@)(@@) % ملك له في الوغى والسلم بسط يد % % مأثورة الفضل ان صالت وان وصلت % % 15(@)(@@) % تعطي الألوف اذا جادت لمطلب % % ومثل أعدادها تردى اذا قتلت % % 16(@)(@@) % في كل نهج ومرماة ركاب سرى % % لولا ابن أيوب ماشدت وما رحلت % % 17(@)(@@) % إن تغش أبواب معناه التي فتحت % % فطالما بالعطايا والندى قفلت % % 18(@)(@@) % سل عن عطاياه تسأل كل وافدة % % من المدائح فازت قبلما سألت % % 19(@)(@@) % فضل أبر فوفي الحمد غايته % % وراحة فعلت كل الندى فعلت % % 20(@)(@@) % وسيرة عدلت في الخلق قاطبة % % مع أنها عن سبيل الحق ما عدلت % % PageV01P1461 21(@)(@@) % وهمة في العلى والعلم دائبة % % شبت على شرف الفنيين وابتهلت % % 22(@)(@@) % هذي السيادة تعلو كلما اتضعت % % وأنمل الفضل تهمي كلما عذلت % % 23(@)(@@) % أنى يقابس بالأنواء نائله % % وهي التي باحمرار البرق قد خجلت % % 24(@)(@@) % جادت يداه بلا من ينغصها % % والمن يظهر في الانواء ان نزلت % % 25(@)(@@) % وشاد بالجود ما شادت أوائله % % والسحب قد تهدم البنيان ان هطلت % % 26(@)(@@) % لا شيء أليق من مرآي أنامله % % اذا تأملت أمريها وما كفلت % % 27(@)(@@) % تخط بالرمح في الاجساد صائلة % % وتطعن العسر بالأقلام ان بذلت % % 28(@)(@@) % لحملة الحرب أو حمل الندى خلقت % % فليس تنفك من شكر لما حملت % % 29(@)(@@) % لو قيل إن شموس الصحو خافية % % ما قال عنها عدو أنها بخلت % % 30(@)(@@) % يممه والسحب عقم واخش سطوته % % والخيل من حدب الهيجاء قد نسلت % % PageV01P1462 31(@)(@@) % ذاك الكريم الذي يجدي مدائحنا % % وكان يكفي من الجدوى اذا قبلت % % 32(@)(@@) % من مبلغ الاهل أني ضيف أنعمه % % وان كفي على الآمال قد حصلت % % 33(@)(@@) % عزيمة السعي ما خابت وسائلها % % وآية المنطق السحارما بطلت % % 34(@)(@@) % وانشر على الناس أمداحي التي اشتهرت % % فانها في معاني مجده اشتغلت % % 35(@)(@@) % أما ووصف ابن شاد قد سما وعلا % % والله ما 
ms319	 قصرت عيني ولا سفلت % % 36(@)(@@) % لا أسأل الله إلا أن يدوم لنا % % لا أن تزاد معانيه فقد كملت % % PageV01P1463 البحر : - 1(@)(@@) % حلفت بما يملا النديم وما يملي % % لقد بت عن عذل العواذل في شغل % % 2(@)(@@) % اذا نادت الاحشاء يا آل محرق % % أجابت فنادت فكرتي يا بني ذهل % % 3(@)(@@) % بروحي فتاك اللواحظ طالب % % كرى مقلتي يوم النوى زدته عقلي % % 4(@)(@@) % من المغل أشكو نحوه ألم الهوى % % وطب الهوى عندي كما قيل بالمغلي % % 5(@)(@@) % أعيذ سناه والعذار وريقه % % بما قد أتى في النور والنمل والنحل % % 6(@)(@@) % وأصبوا إلى السحر الذي في جفونه % % وان كنت أدري أنه جالب قتلي % % 7(@)(@@) % و أملأ أوصال الدروج رسائلا % فتبخل هاتيك الشمائل بالوصل % % 8(@)(@@) % و يعجبني رمل المنجم باسمه % % وما ذاك الا حب من حل بالرمل % % 9(@)(@@) % لعل الصبا تهدي الي رسالة % % فقد تعبت ما بيننا ألسن الرسل % % 10(@)(@@) % يعللني مسرى الرياح وطالما % % تعللت العشاق بالريح من قبلي % % PageV01P1464 11(@)(@@) % و يعذلني من لا يهيم وأدمعي % % كجدوى عماد الدين سابقة العذل % % 12(@)(@@) % اذا سحبت جدوى المؤيد ذيلها % % تغطى فخار الفضل في ذلك الفضل % % 13(@)(@@) % مليك اذا رمنا مديح جلاله % % فأقلامنا تجري وأوصافه تملي % % 14(@)(@@) % مجدد أيام المحامد والندى % % ودافع أيام الشكاية والأزل % % 15(@)(@@) % و باعثها للحرب جردا سوابحا % كأن دم الأبطال من تحتها يغلي % % 16(@)(@@) % اذا حفيت فوق الجسوم تعوضت % % بكل جبين كالهلال عن النعل % % 17(@)(@@) % اذا مادعته الحرب ياقاتل العدى % % بدا فدعاه الجود يا قاتل المحل % % 18(@)(@@) % اذا جئته للعلم والجود طالبا % فيالك بحر باهر الفضل والفصل % % 19(@)(@@) % يقدم في أهل العلى شرف اسمه % % كما قدم الاسم النحاة على الفعل % % 20(@)(@@) % و تخدمه حتى النجوم محبة % % ومن أجل ذا تعزى النجوم إلى عقل % % PageV01P1465 21(@)(@@) % هو المرتقي فوق السها بعزائم % درت كيف ترقى للفخار وتستعلي % % 22(@)(@@) % تفرد لولا ناصر الدين بالعلى % % فيا حبذا أنس الغضنفر بالشبل % % 23(@)(@@) % سليل علا شفت مخايل مجده % % ودلت كما دل الفرند على النصل % % 24(@)(@@) % يروق لرائيه عليه من النهى % % ألذ حلى مما يروق من 
ms320	 الشكل % % 25(@)(@@) % و تعرف فيه من أبيه شمائلا % ومن جده والسابقين من الأهل % % 26(@)(@@) % حوى الدهر من علياه أشرف نسخة % فقابلها يوم المفاخر بالأصل % % 27(@)(@@) % كأنك ياظل العفاة بشخصه % % يجاريك للعلياء كالشخص والظل % % 28(@)(@@) % يمد لك الله التمكن والبقا % % ويعطيك ما ترجوه من رتب الفضل % % 29(@)(@@) % إلى أن تراه في ذرى المجد راقيا % رفيع منار الذكر منتشر العدل % % 30(@)(@@) % مثيلك في يومي وغى ومكارم % وقد قمت أياما كثيرا بلا مثل % % PageV01P1466 31(@)(@@) % و ملتقيا مني مدائح عودت % % فرائدها لقيا مقامك من قبل % % 32(@)(@@) % أصوغ له منها وألحق نسله % % فأجمع مدح الجد والأب والنجل % % 33(@)(@@) % فديتك ملكا في نداه وبشره % % غمام لمستجد وصبح لمستجلي % % 34(@)(@@) % تخيرته دون الأنام ولذ لي % % به بدل البعض الجميل من الكل % % 35(@)(@@) % و أنزلت آمالي لديه وإنه % % لآكرم من آل المهلب في المحل % % 36(@)(@@) % تفصح لفظي مجزلات هباته % % فتحسن أمداح الجزيلة بالجزل % % 37(@)(@@) % سقى الله أيام المؤيد بالهنا % % إذا ما سقى الأيام بالطل والوبل % % 38(@)(@@) % لقد أمنتنا من أذى كل حادث % % وقد فرغتنا للتنعم والدل % % 39(@)(@@) % فلا جائز فينا سوى ساق غادة % % ولا ظالم إلا من الأعين النجل % % PageV01P1467 البحر : - 1(@)(@@) % أهوى بمرشفة الشهي وقال ها % % ويلاه من رشاء أطاع وقالها % % 2(@)(@@) % وأمالت الكاسات معطف قده % % بقصاص ما قد كان قبل أمالها % % 3(@)(@@) % فمصصت من رشفاته معسولها % % وضممت من أعطافه عسالها % % 4(@)(@@) % وظفرت في اليقظات منه بخلوة % % ما كنت آمل في المنام خيالها % % 5(@)(@@) % و لربما أهوى بكأس مدامة % % لولاه ما حملت يدي جريا لها % % 6(@)(@@) % طبخت بنار خدودة في كفه % % فقبلتها وشربت منه حلالها % % 7(@)(@@) % حتى إذا هوت النجوم وأطفأت % % في الصبح أنفاس النسيم ذبالها % % 8(@)(@@) % ولي وأسأر في الجوانح حسرة % % لو شاء عائد وصله لآزالها % % 9(@)(@@) % ومضى بشمس محاسن لولا الهدى % % ما كنت أمسك في الوفاء حبالها % % 10(@)(@@) % و من البلية عذل قد ضمنت % % ثقل الملام مقالها وفعالها % % PageV01P1468 11(@)(@@) % ياليت أرض العاذلين تزلزلت % % أوليتها لا أخرجت أثقالها % % 12(@)(@@) % و النجم من كأس الحبيب وخده % % لا زاغ 