ms541	 % لو أن له أذنا واعيه % 37(@)(@@) % فلا يذمم الأمل المستغر % % ألا ربما ضلت الهاديه % 38(@)(@@) % وقد ينكل المستغير الشجا % % ع حينا وتخطي اليد الداميه % PageV01P1921 البحر : مجزوء الكامل 1(@)(@@) % ودجا هتكت قناعه % % عن وجه طامسة خفيه % % 2(@)(@@) % تسري كواكبه إلى الإ % % صباح ، والليل المطيه % 3(@)(@@) % والنجم وجه مقبل % % والبدر مرآة صديه % % PageV01P1922 البحر : طويل 1(@)(@@) % أراعي بلوغ الشيب والشيب دائيا % % وأفني الليالي والليالي فنائيا % % 2(@)(@@) % وما أدعي أني برىء من الهوى % % ولكنني لا يعلم القوم ما بيا % % 3(@)(@@) % تلون رأسي ، والرجاء بحاله % وفي كل حال لا تغب الأمانيا % % 4(@)(@@) % خليلي هل تثني من الوجد عبرة % % وهل ترجع الأيام ما كان ماضيا % % 5(@)(@@) % إذا شئت أن تسلى الحبيب فخله % % وراءك أياما وجر اللياليا % % 6(@)(@@) % أعف وفي قلبي من الحب لوعة % % وليس عفيفا تارك الحب ساليا % % 7(@)(@@) % إذا عطفتني للحبيب عواطف % أبيت وفات الذل من كان آبيا % % 8(@)(@@) % وغيري يستنشي الرياح صبابة % % وينشي على طول الغرام القوافيا % % 9(@)(@@) % وألقى من الأحباب ما لو لقيته % من الناس سلطت الظبا والعواليا % % 10(@)(@@) % فلا تحسبوا أني رضيت بذلة % ولكن حبا غادر القلب راضيا % % PageV01P1923 11(@)(@@) % رعى الله من ودعته يوم دابق % % ووليت أنهى الدمع ما كان جاريا % % 12(@)(@@) % وأكتم أنفاسي ، إذا ما ذكرته % وما كل ما تخفيه ، يا قلب ، خافيا % % 13(@)(@@) % فعندي زفير ما ترقى من الحشى % % وعندي دموع ما طلعن المآقيا % % 14(@)(@@) % مضى ما مضى ممن كرهت فراقه % % وقد قل عندي الدمع إن كنت باكيا % % 15(@)(@@) % ولا خير في الدنيا إذا كنت حاضرا % وكان الذي يغرى به القلب نائيا % % 16(@)(@@) % إذا الليل واراني خفيت عن الكرى % % وأيدي المطايا جنح ليلي إزائيا % % 17(@)(@@) % وما طال ليلي غير أن علاقة % % بقلبي تستقري بعيني الدراريا % % 18(@)(@@) % ألا ليت شعري هل أرى غير موجع % % وهل ألقين قلبا من الوجد خاليا % % 19(@)(@@) % بأي جنان قارح أطلب العلى % % وأطمع سيفي أن يبيد الأعاديا % % 20(@)(@@) % إذا كنت أعطي النفس في الحب حمها % % وأودع قلبي والفؤاد الغوانيا % % PageV01P1924 21(@)(@@) % ولم أدن من ود وقد غاض وده 
ms542	 % % وإني ، إذا أبدى العدو سفاهة % 22(@)(@@) % تعمدني بالضيم حتى شكوته % ومن يشك لا يعدم من الناس شاكيا % % 23(@)(@@) % وإني إذا التاث الصديق قطعته % % وإن كان يوما رائحا كنت غاديا % % 24(@)(@@) % سجية مضاء على ما يريده % % مقض على الأيام ما كان قاضيا % % 25(@)(@@) % أرى الماء أحلى من رضاب أذوقه % % وأحسن من بيض الثغور الأقاحيا % % 26(@)(@@) % وأطيب من داري بلادا أجوبها % % إلى العز جوبي بالبنان ردائيا % % 27(@)(@@) % ورب منى سددت فيه مطالبي % % وأي سهام لو بلغن المراميا % % 28(@)(@@) % وهم سقيت القلب منه ، وحاجة % ركبت إليها غارب الليل عاريا % % 29(@)(@@) % وعارية الأيام عندي نسيئة % % أسأت لها قبل الأوان التقاضيا % % 30(@)(@@) % أرى الدهر غصابا لما ليس حقه % فلا عجب أن يسترد العواريا % % PageV01P1925 31(@)(@@) % وما شبت من طول السنين ، وإنما % % غبار حروب الدهر غطى سواديا % % 32(@)(@@) % وما انحط أولى الشعر حتى نعيته % فبيض هم القلب باقي عذاريا % % 33(@)(@@) % أرى الموت داء لا يبل عليله % % وما اعتل من لاقى من الدهر شافيا % % 34(@)(@@) % فما لي وقرنا لا يغالب كلما % % منعت أمامي جاءني من ورائيا % % 35(@)(@@) % يحركني من مات لي بسكونه % % وتجديد دهري أن أرى الدهر باكيا % % 36(@)(@@) % وأبعد شيء منك ما فات عصره % وأقرب شيء منك ما كان جائيا % % 37(@)(@@) % ولست بخزان لمال وإنما % % تراث العلى والفضل والمجد ماليا % % 38(@)(@@) % وإتلاف مالي عن حياتي الذلي % % ولا خير أن يبقى وأصبح فانيا % % 39(@)(@@) % وإني لألقى راحتي في تقنعي % % وفي طلب الإثراء طول عنائيا % % 40(@)(@@) % وإني إن ألقى صديقا موافقا % وذلك شيء عازب عن رجائيا % % PageV01P1926 41(@)(@@) % وإن غريب القوم من عاش فيهم % وليس يرى إلا عدوا مداجيا % % 42(@)(@@) % وأكثر من تلقاه كالسيف مرهفا % % عليك وإن جربته كان نابيا % % 43(@)(@@) % وما أنا إلا غمد قلبي فإن مضى % % مضيت ، وما لي منة في مضائيا % % 44(@)(@@) % وما حملتني العيس إلا مشمرا % لأخرق ليلا أو لأقطع واديا % % 45(@)(@@) % طوارح أيد في الليالي كأنها % % تجاري إلى الصبح النجوم الجواريا % % 46(@)(@@) % إذا ما رحلناها من الصيف ليلة % فلا حل حتى ينظر النجم رائيا % % 47 
ms543	(@)(@@) % طواهن طي السير في كل مهمه % ورحن خماصا قد طوين المواميا % % 48(@)(@@) % مررن بمياس الثمام وحزنه % خفافا كأطراف العوالي نواجيا % % 49(@)(@@) % وكم جاوزت من رملة ثم عاقر % وأخرى يضف الروض فيها الغواديا % % 50(@)(@@) % ومن نفر لا يعرف الضيف كلبهم % % ويسغب حتى يقطع الليل عاويا % % PageV01P1927 51(@)(@@) % تهاب الندى أيديهم فكأنما % % تلاطم من بذل النوال الأثافيا % % 52(@)(@@) % وأعلى الورى من وافق الرمح باعه % % وكان له في كبة الخيل ساقيا % % 53(@)(@@) % وأشرفهم من يطلق الكف بالندى % % سخيا ، ببذل المال ، أو متساخيا % % 54(@)(@@) % وإن أمير المؤمنين لحابس % % ركابي أن أرمي بها ما أماميا % % 55(@)(@@) % معيني على الأيام إن غالبت يدي % % وإن كنت معدوا علي وعاديا % % 56(@)(@@) % إذا شئت عنه رحلة حط جوده % حقائب أذوادي ورد المثانيا % % 57(@)(@@) % ولولاه ما انصانت لوجهي طلاوة % % ولا كنت إلا شاحب اللون طاويا % % 58(@)(@@) % جريأ أروع الوحش في كل ظلمة % % وأخلط بالنقع المثار الدياجيا % % 59(@)(@@) % هو السيف إن أغمدته كان حازما % وقورا ، وإن جردته كان عاديا % % 60(@)(@@) % له كل يوم معرك إن شهدته % % ترى قضبا عونا وهاما عذاريا % % PageV01P1928 61(@)(@@) % يضم عليها جانب النقع بالقنا % % يبادرن قدام السيوف التراقيا % % 62(@)(@@) % ويرسل في الأقران كن خفية % % تخال بها طيرا من الريح هافيا % % 63(@)(@@) % ويثني جوادا من دم الطعن ناعلا % % ويزجي نجيبا من وجى السير حافيا % % 64(@)(@@) % تسافه في الغارات أشداق خيلها % % على اللجم حتى تكرع الماء دميا % % 65(@)(@@) % عظيم على غيظ الرجال محسد % % غلوب إذا ما جاذبوه المعاليا % % 66(@)(@@) % تغاديه إلا في حرام مغامرا % % وتلقاه إلا عن نوال محاميا % % 67(@)(@@) % وما قصبات السبق إلا لماجد % % سعى فاحتوى دون الرجال المساعيا % % 68(@)(@@) % أيا علم الإسلام والمجد والعلا % % رضيناك مهديا لدين وهاديا % % 69(@)(@@) % وما حملتك الخيل إلا رددتها % % عن الروع حمرا بالدماء قوانيا % % 70(@)(@@) % وشعث النواصي يتخذن دم الطلى % % دهانا وأطراف العوالي مداريا % % PageV01P1929 71(@)(@@) % وغيرك يقتاد الجياد لغارة % ويرجعها ملس الجلود كما هيا % % 72(@)(@@) % وما الخيل إلا أن تكون سوابقا % وما الأسد إلا أن تكون ضواريا % % 73(@)(@@) % وتترك صبح الجهل يغبر ضوءه % % ونقعك 
ms544	 أخاذ عليه الضواحيا % % 74(@)(@@) % بيوم طراد يصطلي القوم تحته % بنار الحنايا والقنا والمواضيا % % 75(@)(@@) % وجرد يناقلن الرماح عوابسا % ويرمين بالعدو القطا والحواميا % % 76(@)(@@) % خوارج من ذيل الغبار كأنها % % أنامل مقرور دنا النار صاليا % % 77(@)(@@) % بكل سنان لا يرى الدرع جنة % % وكل حسام لا يرى البيض واقيا % % 78(@)(@@) % ولا سلم حتى يخضب الحرب أرضها % % ويغدو فم البيداء بالنقع راغيا % % 79(@)(@@) % إذا ما لقيت الجيش أفنيت جله % ردى ورددت القافلين نواعيا % % 80(@)(@@) % وما كل من أومى إلى العز ناله % ودون العلى ضرب يدمي النواصيا % % PageV01P1930 81(@)(@@) % إلى كم أمني النفس يوما وليلة % وتعلمني الأيام أن لا تلاقيا % % 82(@)(@@) % وكم أنا موقوف على كل زفرة % عليل جوى لو أن ناسا دوائيا % 83(@)(@@) % أيسنح لي روضا وأصبح عازبا % ويعرض لي ماء وأصبح صاديا % % 84(@)(@@) % وما أنا إلا أن أراك بقانع % % وإن كنت جرارا إلي الأعاديا % % 85(@)(@@) % تركت إليك الناس طرا وكلهم % % يتوق إلى قربي ويهوى مقاميا % % 86(@)(@@) % وفارقت أقواما كراما أكفهم % وما ضقت عنهم في البلاد ملاقيا % % 87(@)(@@) % ويمنعني من عادة الشعر أنني % % رأيت لباس الذل بالمال غاليا % % 88(@)(@@) % إذا لم أجد بدا من السيف شمته % % وفقد ذلول أركب الصعب ماشيا % % 89(@)(@@) % فإن كنت لا أعلو على عود منبر % % فلست ألاقي غير مجدي عاليا % % 90(@)(@@) % عليك سلام الله إني لنازع % إليك ، وإن لم أعط منك مراديا % % PageV01P1931 91(@)(@@) % ودمت دوام الشمس والبدر في الدنا % % يجدد أياما وينضو لياليا % % PageV01P1932 البحر : طويل 1(@)(@@) % سأصبر إن الصبر مر صدوره % ألا ربما لذت لقلبي عواقبه % % 2(@)(@@) % ولا بد أن يعطي على البعد دولة % فنأمنن بينا أو رقيبا نراقبه % % 3(@)(@@) % وأرى المعرض باللئيم ، كأنه % % 3(@)(@@) % وأرجع ليس في كفي منه % % 3(@)(@@) % فلا قلب لي إلا وأنت حجابه % ولا سر لي إلا وذكرك حاجبه % % 4(@)(@@) % كاينا للأنوف جدعا ورغما % % 5(@)(@@) % أعطش الله كل فرع بنعما % % كالسيف يأخذ من بنان الصيقل % % 6(@)(@@) % م ودارت على الأعادي رحاكا % % جذب الرشاء عن القليب الأطول % % 7(@)(@@) % حك رعي الحمى وملوا قراكا % % 8(@)(@@) % % إليها ، ولا دمعي عليها 
ms545	 بجامد % % PageV01P1933 11(@)(@@) % لو حيث يستمع السرار وقفتما % % 12(@)(@@) % حامل بزه على ربذ التق % بأروى وأسنى ما يجود ربيع % 21(@)(@@) % كاد الرجال ، ولا دعي ثقيف % % PageV01P1934 البحر : طويل 1(@)(@@) % خليلي ! هل لي لو ظفرت بنية % % إلى الجزع من وادي الأراك سبيل % % 3(@)(@@) % وفي سرعان الريح لي لو علمتما % % لا سفير إليك إلا معالي % % PageV01P1935 البحر : طويل 1(@)(@@) % نلت ما نلته انفرادا وزاحم % غزالا رمى قلبي وراح سليما % % 5(@)(@@) % هل أولاك الذين عهدي بهم في % % 8(@)(@@) % لم أجد صانعا سواك ، ولا أع % غزالا على قلبي ، الغداة ، كريها % % 9(@)(@@) % تكاد من الإسراع تسبق أمها % % بمنتجها ، قبل اللقاح ، أباها % % 9(@)(@@) % % سرت عنك إلا عبقة ونسيما % % 21(@)(@@) % بعجاج يملأ الأفق دجى ، % وطعان يخضب الأرض بدم % % PageV01P1936 
