ms2122	 6، ب 77، ح 3.(@)(@@) * وروى عن زيد الشحام أبى أسامة، وروى عنه فضالة.(@)(@@) التهذيب: ج 3، ح 498 (الاستبصار:(@)(@@) ج 1، ح 794).(@)(@@) * وروى عن سالم، وروى عنه فضالة.(@)(@@) التهذيب: ج 1، ح 177 (الاستبصار:(@)(@@) ج 1، ح 189).(@)(@@) * وروى عن السري بن خالد، وروى عنه الوشاء.(@)(@@) الكافي: ج 1، ك 1، ب 0، ح 25.(@)(@@) * وروى عن سعيد بن يسار، وروى عنه الحسن بن علي.(@)(@@) الكافي: ج 5، ك 3، ب 131، ح 4.(@)(@@) والتهذيب: ج 8، ح 634 (الاستبصار:(@)(@@) ج 3، ح 1312، وفيه حماد فقط).(@)(@@) * وروى عن سعيد بياع السابري، وروى عنه الوشاء. PageV07P415(@)(@@) الكافي: ج 3، ك 4، ب 17، ح 2.(@)(@@) والتهذيب: ج 2، ح 1148 (الاستبصار:(@)(@@) ج 1، ح 1557، وفيه سعد بدل سعيد).(@)(@@) * وروى عن سلامة القلانسي، وروى عنه عثمان بن عيسى.(@)(@@) الكافي: ج 6، ك 6، ب 77، ح 2.(@)(@@) * وروى عن سيف بن عميرة، وروى عنه ابن أبي عمير.(@)(@@) الكافي: ج 2، ك 2، ب 52، ح 7.(@)(@@) * وروى عن سيف التمار، وروى عنه جعفر بن بشير.(@)(@@) التهذيب: ج 2، ح 43.(@)(@@) * وروى عن صالح بن الحكم الأحول، وروى عنه جعفر بن بشير.(@)(@@) الفقيه، المشيخة: في طريقه إلى صالح بن الحكم.(@)(@@) * وروى عن الصباح بن سيابة، وروى عنه جعفر بن بشير البجلي.(@)(@@) الفقيه، المشيخة: في طريقه إلى الصباح ابن سيابة.(@)(@@) * وروى عن عامر بن عبد الله، وروى عنه أحمد بن محمد بن أبي نصر.(@)(@@) الكافي: ج 3، ك 3، ب 95، ح 15.(@)(@@) * وروى عن عامر بن نعيم القمي، وروى عنه فضالة.(@)(@@) التهذيب: ج 2، ح 1556.(@)(@@) * وروى عن عبد الاعلى بن أعين، وروى عنه ابن أبي نصر.(@)(@@) الكافي: ج 6، ك 2، ب 62، ح 3.(@)(@@) وروى عنه ابن فضال.(@)(@@) الكافي: ج 1، ك 2، ب 20، ح 8.(@)(@@) وروى عنه الحسن بن علي الوشاء.(@)(@@) الكافي: ج 1، ك 4، ب 38، ح 2.(@)(@@) وروى عنه يزيد بن إسحاق.(@)(@@) التهذيب: ج 4، ح 466.(@)(@@) * وروى عن عبد الاعلى مولى آل سام، وروى عنه الوشاء.(@)(@@) الكافي: ج 6، ك 9، ب 7، ح 2.(@)(@@) * وروى عن عبد الحميد، وروى عنه جعفر بن بشير.(@)(@@) التهذيب: ج 2، ح 784 (الاستبصار:(@)(@@) ج 1، ح 1546).(@)(@@) * وروى عن عبد الحميد بن عواض، وروى عنه أحمد بن محمد بن أبي نصر.(@)(@@) الكافي: ج 3، ك 3، ب 13، ح 10.(@)(@@) * وروى عن عبد 
ms2123	 الرحمان بن أبي عبد الله، وروى عنه ثعلبة بن ميمون.(@)(@@) التهذيب: ج 3، ح 952 (الاستبصار:(@)(@@) ج 1، ح 865).(@)(@@) وروى عنه الحجال. PageV07P416(@)(@@) الكافي: ج 6، ك 8، ب 45، ح 2.(@)(@@) * وروى عن عبد الرحمان بن أبي عبد الله البصري، وروى عنه أحمد بن محمد بن أبي نصر البزنطي.(@)(@@) الفقيه: ج 4، ح 681.(@)(@@) * وروى عن عبد الرحمان بن الحجاج، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 4، ك 3، ب 83، ح 12.(@)(@@) * وروى عن عبد الرحيم بن عتيك القصير، وروى عنه ابن أبي نجران.(@)(@@) الكافي: ج 1، ك 3، ب 10، ح 1.(@)(@@) * وروى عن عبد الرحيم القصير، وروى عنه عبد الرحمان بن أبي نجران.(@)(@@) الكافي: ج 2، ك 1، ب 16، ح 1.(@)(@@) * وروى عن عبد الله بن أبي يعفور، وروى عنه أحمد بن محمد.(@)(@@) التهذيب: ج 7، ح 1662 (الاستبصار:(@)(@@) ج 3، ح 871).(@)(@@) وروى عنه جعفر بن بشير.(@)(@@) التهذيب: ج 2، ح 624.(@)(@@) وروى عنه محمد بن أبي عمير.(@)(@@) الفقيه، المشيخة: في طريقه إلى عبد الله ابن أبي يعفور.(@)(@@) * وروى عن عبد الله الحلبي، وروى عنه محمد بن أبي عمير.(@)(@@) التهذيب: ج 1، ح 1207. كذا في الطبعة القديمة على الظاهر، ولكن الظاهر أن الصحيح عبيد الله الحلبي.(@)(@@) * وروى عن عبد الله الكاهلي، وروى عنه أحمد محمد بن أبي نصر.(@)(@@) الكافي: ج 1، ك 4، ب 94، ح 2.(@)(@@) * وروى عن عبيد بن زرارة، وروى عنه جعفر بن بشير.(@)(@@) التهذيب: ج 1، ح 1139 (الاستبصار:(@)(@@) ج 1، ح 1130)، والتهذيب: ج 2، ح 1439 (الاستبصار: ج 1، ح 1402).(@)(@@) وروى عنه الحسن بن علي.(@)(@@) الكافي: ج 2، ك 1، ب 165، ح 5.(@)(@@) * وروى عن عبيد الله الحلبي، وروى عنه ابن أبي عمير.(@)(@@) التهذيب: ج 2، ح 551 (الاستبصار:(@)(@@) ج 1، ح 869، وفيه عبيد الله الحلبي، كما أن في الطبعة القديمة من التهذيب عبد الله بن الحلبي).(@)(@@) * وروى عن عبيد الله بن علي الحلبي.(@)(@@) الفقيه: ج 3، ح 179، 796.(@)(@@) وروى عنه ابن أبي عمير.(@)(@@) التهذيب: ج 2، ح 565 (الاستبصار:(@)(@@) ج 1، ح 1330، وفيه محمد بن أبي عمير PageV07P417(@)(@@) وعبيد الله الحلبي)، والتهذيب: ج 3، ح 105، و 148، والتهذيب: ج 4، ح 100 (الاستبصار: ج 2، ح 77)، و 498، 499، والاستبصار: ج 1، ح 381.(@)(@@) وروى عنه ابن أبي نصر.(@)(@@) التهذيب: 
ms2124	 ج 4، ح 100 (الاستبصار:(@)(@@) ج 2، ح 77، وفيه أحمد بن محمد بن أبي نصر).(@)(@@) وروى عنه أبان بن عثمان.(@)(@@) التهذيب: ج 2، ح 1498.(@)(@@) وروى عنه محمد بن أبي عمير.(@)(@@) الكافي: ج 5، ك 3، ب 32، ح 2. والفقيه، المشيخة: في طريقه إلى عبيد الله بن علي، الحلبي. والتهذيب: ج 1، ح 463، 469 (الاستبصار: ج 1، ح 457)، و 1273، والتهذيب: ج 2، ح 171، 249 (الاستبصار: ج 1، ح 1161)، و 261 (الاستبصار: ج 1، ح 1172، وما في هذه الطبعة من التهذيب من أحمد بن أبي عمير من غلط المطبعة، والصحيح محمد بن أبي عمير كما في الطبعة القديمة والاستبصار) و 372 (الاستبصار: ج 1، ح 1203، وفيه عبيد الله الحلبي فقط)، و 754، 772 (الاستبصار: ج 1، ح 1441)، والتهذيب: ج 3، ح 142، هذا بناء على الطبعة القديمة، وفي ونسخة أخرى من الطبعة القديمة وهذه الطبعة عبد الله بن علي الحلبي، و 180، 386، والتهذيب: ج 4، ح 4 (الاستبصار: ج 2، ح 4، وفيه عبيد الله الحلبي)، و 455، في هذه الطبعة والطبعة القديمة عبد الله بن علي الحلبي من غلط المطبعة، والصحيح ما أثبتناه.(@)(@@) * وروى عن عبيد الله الحلبي، وروى عنه ابن أبي عمير.(@)(@@) الكافي: ج 3، ك 1، ب 30، ح 4، والكافي:(@)(@@) ج 7، ك 1، ب 35، ح 2.(@)(@@) والتهذيب: ج 1، ح 96 (الاستبصار:(@)(@@) ج 1، ح 141، وفيه حماد عن الحلبي)، والتهذيب: ج 2، ح 750، 773، 1212 (الاستبصار: ج 1، ح 1226)، و 1216، 1445، والتهذيب: ج 3، ح 848 (الاستبصار: ج 1، ح 1745)، و 933 (الاستبصار: ج 1، ح 1780، وفيه حماد فقط)، و 1008 (الاستبصار: ج 1، ح 1825)، والتهذيب: ج 5، ح 478.(@)(@@) والتهذيب: ج 9، ح 734.(@)(@@) وروى عنه صفوان. التهذيب: ج 5، ح 256. PageV07P418(@)(@@) وروى عنه فضالة.(@)(@@) التهذيب: ج 2، ح 33.(@)(@@) وروى عنه محمد بن أبي عمير التهذيب: ج 1، ح 439 (الاستبصار:(@)(@@) ج 1، ح 442)، و 934 والتهذيب: ج 3 ح 821. والتهذيب: ج 4، ح 36 (الاستبصار: ج 2، ح 42)، والتهذيب:(@)(@@) ج 7، ح 855.(@)(@@) * وروى عن علي بن المغيرة، وروى عنه أحمد بن محمد بن أبي نصر.(@)(@@) الروضة: ح 101.(@)(@@) * وروى عن علي بن يقطين، وروى عنه ابن أبي نصر.(@)(@@) التهذيب: ج 3، ح 515 (الاستبصار:(@)(@@) ج 1، ح 817).(@)(@@) وروى عنه أحمد بن محمد بن أبي نصر.(@)(@@) التهذيب: ج 3، ح 
ms2125	 519 (الاستبصار:(@)(@@) ج 1، ح 820، وفيه ابن أبي نصر فقط).(@)(@@) * وروى عن عمار بن موسى، وروى عنه جعفر بن بشير.(@)(@@) التهذيب: ج 2، ح 789 (الاستبصار:(@)(@@) ج 1، ح 159، وفيه جعفر بن بشير البجلي)، وروى عنه جعفر بن بشير البجلي، التهذيب: ج 1، ح 143.(@)(@@) * وروى عن عمر بن أبي شعبة.(@)(@@) الفقيه: ج 3، ح 1046.(@)(@@) * وروى عن عمر بن أبي شعبة الحلبي، وروى عنه جعفر بن بشير.(@)(@@) الفقيه، المشيخة: في طريقه إلى عمر بن أبي شعبة.(@)(@@) * وروى عن عمر بن يزيد، وروى عنه ابن أبي عمير.(@)(@@) الكافي: ج 2، ك 1، ب 68، ح 28.(@)(@@) والكافي: ج 4، ك 2، ب 54، ح 1، والكافي:(@)(@@) ج 5، ك 2، ب 117، ح 1، والتهذيب:(@)(@@) ج 4، ح 708 (الاستبصار: ج 2، ح 345)، والتهذيب: ج 7، ح 464 (الاستبصار: ج 3، ح 331).(@)(@@) وروى عنه أحمد بن محمد بن أبي نصر.(@)(@@) الكافي: ج 7، ك 3، ب 31، ح 11، والتهذيب: ج 10، ح 345.(@)(@@) * وروى عن جعفر بن بشير.(@)(@@) التهذيب: ج 1، ح 1079 (الاستبصار:(@)(@@) ج 1، ح 232).(@)(@@) وروى عنه الحسن بن علي.(@)(@@) الكافي: ج 5، ك 3، ب 1، ح 9، والكافي:(@)(@@) ج 6، ك 3، ب 15، ح 2، والتهذيب: ج 8، ح 859 (الاستبصار: ج 4، ح 35).(@)(@@) وروى عنه الحسن بن علي بن النعمان.(@)(@@) الكافي: ج 7، ك 5، ب 5، ح 1. PageV07P419(@)(@@) وروى عنه الحسن بن علي الوشاء.(@)(@@) الكافي: ج 4، ك 2، ب 59، ح 5. وك 3، ب 212، ح 12.(@)(@@) وروى عنه سعد بن عبد الله.(@)(@@) التهذيب: ج 1، ح 329، والظاهر أنه مرسل لبعد طبقتهما.(@)(@@) وروى عنه فضالة.(@)(@@) التهذيب: ج 1، ح 320 (الاستبصار:(@)(@@) ج 1، ح 348).(@)(@@) وروى عنه الوشاء.(@)(@@) الكافي: ج 3، ك 1، ب 9، ح 8.(@)(@@) * وروى عن عمرو بن الأشعث، وروى عنه ابن أبي عمير.(@)(@@) الكافي: ج 1، ك 4، ب 60، ح 2.(@)(@@) * وروى عن عمران الحلبي.(@)(@@) الفقيه: ج 1، ح 1231.(@)(@@) وروى عنه جعفر بن بشير.(@)(@@) الفقيه، المشيخة: في طريقه إلى عمران الحلبي. والتهذيب: ج 3، ح 50 (الاستبصار: ج 1، ح 1594).(@)(@@) وروى عنه فضالة.(@)(@@) التهذيب: ج 2، ح 1142.(@)(@@) * وروى عن عيسى بن أبي منصور، وروى عنه جعفر بن بشير.(@)(@@) الفقيه، المشيخة: في طريقه إلى عيسى ابن أبي منصور.(@)(@@) وروى عنه فضالة.(@)(@@) التهذيب: ج 2، ح 60 (الاستبصار: ج 1، ح 889).(@)(@@) * وروى عن عيسى بن الس