ms3301	 أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ 1318 / 30343 قال النبي :(@)(@@) | 30 ( أوصيكم بالسابقين الأولين من المهاجرين وأبنائهم من بعدهم إلا تفعلوه لا يقبل منكم صرف ولا عدل ) )(@)(@@) . ( بز ، طس ) ، عن عبد الرحمان بن عوف رضي الله عنه .(@)(@@)(@@)(@@) $ 1319 / 30344 قال النبي :(@)(@@) | 30 ( أوصيكم بعترتي خيرا وإن موعدكم الحوض ، والذي نفسي بيده لتقيمن الصلاة ، ولتؤتن الزكاة ، أو لأبعثن إليكم رجلا مني أو كنفسي يضرب أعناقكم ثم أخذ بيد علي وقال : هاذا ) )(@)(@@) . ( بز ) ، عن عبد الرحمان بن عوف رضي الله عنه .(@)(@@)(@@)(@@) $ 1320 / 30345 قال النبي :(@)(@@) | 30 ( أو قد رأيت ، ذاك عدو الله أبا جهل بن هشام ، وذاك عذابه إلاى يوم القيامة ) )(@)(@@) . ( طس ) ، عن ابن عمر رضي الله عنهما قال : بينا أنا أسير بجنبات بدر إذ خرج رجل من حفرة في عنقه سلسلة فناداني : يا عبد الله اسقني وخرج آخر من ذالك الحفير في يدهه سوط فناداني يا عبد الله لا تسقه فإنه كافر وضربه بالسوط وعاد إلاى حفرته ، فأخبرت به النبي فذكره .(@)(@@) PageV10P221(@)(@@)(@@)(@@) $ 1321 / 30346 قال النبي :(@)(@@) | 30 ( أو لم أنك لو لم تأتها لأتتك ) )(@)(@@) . ( طك ) ، عن ابن عمر رضي الله عنهما قال رأيت ثمرة فأخذتها فناولتها سائلا فذكره .(@)(@@)(@@)(@@) $ 1322 / 30347 قال النبي :(@)(@@) | 30 ( أو إنكم تفعلون ذالك لا عليكم أن لا تفعلوا ، فإنه ليست نسمة كتب الله أن تخرج إلا هي كائنة ) )(@)(@@) . ( خ ، طك ) ، عن أبي سعيد الخدري رضي الله عنه قال : جاء رجل من الأنصار فقال : يا رسول الله إنا نصيب سبيا ونحب المال كيف تراى في العزل ؟ قال : فذكره .(@)(@@)(@@)(@@) $ 1323 / 30348 قال النبي :(@)(@@) | 30 ( أول الامارة علامة ، وثانيها ندامة ، وثالثها عذاب يوم القيامة إلا من رحم وعدل ، وقال : هاكذا وهاكذا بيده بالمال ثم سكت ما شاء الله ، ثم قال : كيف بالعدل مع ذي القرباى ) )(@)(@@) . ( طك ) ، عن شداد بن أوس رضي الله عنه .(@)(@@)(@@)(@@) $ 1324 / 30349 قال النبي :(@)(@@) | 30 ( أول ما يسأل عنه العبد يوم القيامة ينظر في صلاته فإن صلحت فقد أفلح ، وإن فسدت فقد خاب وخسر ) )(@)(@@) . ( طس ) ، عن أنس رضي الله 
ms3302	 عنه .(@)(@@)(@@)(@@) $ 1325 / 30350 قال النبي :(@)(@@) | 30 ( أول ما أوحي إلي أن قيل خمر عورتك ، فما رؤيت عورته بعد ) )(@)(@@) . ( حم ، طك ) ، عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ 1326 / 30351 قال النبي :(@)(@@) | 30 ( أول ما يكفأ الاسلام كما يكفأ الاناء في شراب يقال له الطلاء ) )(@)(@@) . ( ع ) ، عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ 1327 / 30352 قال النبي :(@)(@@) | 30 ( أول ما يرفع من الناس الأمانة ، وآخر ما يبقاى الصلاة ، ورب مصل لا خير فيه ) )(@)(@@) . ( طص ) ، عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ 1328 / 30353 قال النبي :(@)(@@) | 30 ( أول من جحد آدم فجحدت ذريته قالها PageV10P222 ثلاثا إن الله عز وجل لما خلقه مسح ظهره وأخرج منه ذريته فعرضهم عليه ، فرأى فيهم رجلا يزهر ، فقال : أي رب من هاذا ؟ قال : هاذا ابنك داود ، قال : أي رب كم عمره ؟ قال : ستون عاما ، قال : أي رب زد في عمره ؟ قال : لا إلا أن تزيده أنت من عمرك ، فزاده أربعين سنة من عمره ، فكتب الله عز وجل عليه بذالك كتابا وأشهد عليه الملائكة ، فلما احتضر آدم وأتته الملائكة لتقبضه قال : إنه قد بقي من أجلي أربعون سنة ، فقيل له : إنك قد جعلتها لابنك داود ، قال : فجحد ، فأخرج الله الكتاب وأقام البينة ، فأتمها لدود مائة سنة ، وأتم لآدم عمره ألف سنة ) )(@)(@@) . ( حم ، طك ) ، عن يوسف بن مهران عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ 1329 / 30354 قال النبي :(@)(@@) | 30 ( أول من يشفع يوم القيامة الأنبياء ، ثم الشهداء ، ثم المؤذنون ) )(@)(@@) . ( بز ) ، عن عثمان رضي الله عنه .(@)(@@)(@@)(@@) $ 1330 / 30355 قال النبي :(@)(@@) | 30 ( أول من صنعت له النورة ( 1 ) وجعل له الحمام سليمان بن داود فلما دخله وجد حره وغمه قال : أوه من عذاب الله أوه قبل أن لا تنفع أوه ) )(@)(@@) ( طكس ) ، عن أبي موساى .(@)(@@)(@@)(@@) $ 1331 / 30356 قال النبي :(@)(@@) | 30 ( أول من يختصم يوم القيامة الرجل وامرأته ، والله ما يتكلم لسانها ولاكن يداها ورجلاها فيشهدان عليها بما كانت تعيب لزوجها ، ويشهد يداه بما كان يوليها ، ثم يدعاى الرجل وخدمه بمثل ذالك ، ثم يدعاى أهل الأسواق وما يوجد 
ms3303	 ثم لا ووانيق ولا قراريط ولاكن حسنات هاذا دفع إلاى هاذا الذي ظلم ، وسيئات هاذا الذي ظلمه تدفع عليه ثم يؤتاى بالجبارين في مقامع من حديد فيقال ما وردهم إلاى النار ، فوالله ما أدري يدخلونها ، أو كما قال الله : { وإن منكم إلا واردها . . } الآية ) )(@)(@@) . ( طك ) ، عن أبي أيوب رضي الله عنه .(@)(@@) PageV10P223(@)(@@)(@@)(@@) $ 1332 / 30357 قال النبي :(@)(@@) | 30 ( أول من يدخل من هاذا الباب رجل من أهل الجنة فدخل سعد بن أبي وقاص ) )(@)(@@) . ( حم ) ، عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ 1333 / 30358 قال النبي :(@)(@@) | 30 ( أولكن يرد علي الحوض أطولكن يدا يعني أصنعكن يدا ) )(@)(@@) . ( طس ) ، عن ميمونة رضي الله عنها .(@)(@@)(@@)(@@) $ 1334 / 30359 قال النبي :(@)(@@) | 30 ( أولياء الله أذاعوا ذكر الله ) )(@)(@@) . ( بز ) ، عن ميمونة رضي الله عنها .(@)(@@)(@@)(@@) $ 1335 / 30360 قال النبي :(@)(@@) | 30 ( أوما ترضاى أن يكون منزلك في الجنة مقابل منزلي ، قاله لعلي ) )(@)(@@) . ( بز ، طك ) ، عن ابن أبي أوفاى رضي الله عنه .(@)(@)(@@)(@@)(@@) ||| الهمزة مع اللام ألف(@)(@@)(@@)(@@) $ 1336 / 30361 قال النبي :(@)(@@) | 30 ( ألا أبشرك يا جابر ؟ قال : بلاى يا رسول الله بالخير ، قال : إن الله أحيى أباك فأقعده بين يديه ، فقال : تمن علي ما شئت أعطكه فقال : يا رب ما عبدناك حق عبادتك ، أتمنى عليك أن تردني إلاى الدنيا فأقاتل مع نبيك فأقتل مرة أخراى ، فقال له : قد سلف أنك إليها لا ترجع ) )(@)(@@) . ( طك ، بز ) ، عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ 1337 / 30362 قال النبي :(@)(@@) | 30 ( ألا أحدثك ثنتين من فعلهما دخل الجنة : يحفظ الرجل ما بين فقميه وما بين رجليه ) )(@)(@@) . ( حم ، طك ) ، عن أبي موساى رضي الله عنه .(@)(@@)(@@)(@@) $ 1338 / 30363 قال النبي :(@)(@@) | 30 ( ألا أحدثكم عن الخضر ؟ بينما هو ذات يوم يمشي في سوق بني إسرائيل أبصره رجل مكاتب فقال : تصدق علي بارك الله فيك ، فقال الخضر : آمنت بالله ما شاء الله من أمر يكون ما عندي شيء أعطيكه ، فقال : أسحألك بوجه الله لما تصدقت علي ، فإني نظرت السماحة في وجهك ، ورجوت البركة عندك ، فقال الخضر : آمنت بالله ما عندي شيء أعطيكه إلا أن 
ms3304	 تأخذني فتبيعني ، PageV10P224 فقال : وهل يستقيم هاذا ؟ قال : نعم أقول ، لقد سألتني بأمر عظيم ، أما إني لاجيك بوجه ربي ، يعني فقدمه إلاى السوق فباعه بأربعمائة درهم ، فمكث المشتري زمانا لا يستعمله في شيء ، فقال له : إنك إنما اشتريتني التماس خير عندي فأوصني بعمل ، قال : أكره أن أشق عليك ، إنك شيخ كبير ضعيف ، قال : ليس شيء يشق علي ، قم فاحمل هاذه الحجارة ، وكان لا ينقلها دون ستة نفر في يوم ، فخرج الرجل لبعض حاجته ثم رجع وقد نقل الحجارة في ساعة ، قال : أحسنت وأجملت وأطقت ما لم أرك تطيقه ، ثم عرض للرجل سفر فقال : إني أجدك أمينا فاخلفني في أهلي خلافة حسنة ، قال : وأوصني بعمل ، قال : إني أكره أن أشق عليك ، قال : ليس تشق علي ، قال : فاضرب من اللبن لبيتي حتى أقدم عليك فمضاى الرجل لسفره ورجع وقد شيد بناءه ، قال : أسألك بوجه الله ما سبيلك وما أمرك ؟ قال : سألتني بوجه الله ووجه الله أوقعني في العبودية ، أنا الخضر الذي سمعت به ، سألني مسكين صدقة ولم يكن عندي شيء أعطيه ، فسألني بوجه الله فأمكنته من رقبتي فباعني ، وأخبرك من سئل بوجه الله فرد سائله وهو يقدر وقف يوم القيامة لا جلد ولا لحم ، له عظم يتقعقع ، فقال الرجل : آمنت بالله ، شققت علي يا نبي الله ولا أعلم ، قال : لا بأس أحسنت وأبقيت ، فقال : بأبي أنت وأمي احكم في أهلي ومالي بما شئت واختر فأخلي سبيلك ، قال : أريد أن تخلي سبيلي فأعبد ربي ، فخلى سبيله فقال : الحمد لله الذي أوقعني في العبودية ثم نجاني منها ) )(@)(@@) . ( طك ) ، عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ 1339 / 30364 قال النبي :(@)(@@) | 30 ( ألا أخبرك بما يكثر المرء : المرأة الصالحة إذا نظر إليها سرته ، وإذا أمرها أطاعته ، وإذا غاب عنها حفظته ) )(@)(@@) . ( ع ) ، عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ 1340 / 30365 قال النبي :(@)(@@) | 30 ( ألا أخبرك بأخير سورة في القرآن ؟ الحمد لله رب العالمين ) )(@)(@@) . ( حم ) ، عن عبد الله بن جابر رضي الله عنه .(@)(@@) PageV10P225(@)(@@)(@@)(@@) $ 1341 / 30366 قال النبي :(@)(@@) | 30 ( ألا أخبركم بأهل 
ms3305	 النار وأهل الجنة ، أما أهل الجنة فكل ضعيف مستضعف ذي طمرين ، لو أقسم علاى الله لأبره ، وأما أهل النار فكل جعظري جواظ جماع مناع ) )(@)(@@) . ( حم ) ، عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ 1342 / 30367 قال النبي :(@)(@@) | 30 ( ألا أخبركم بأحبكم إلاى الله ؟ أحبكم إلاى الناس ، ألا أخبركم بأبغضكم إلاى الله ؟ أبغضكم إلاى الناس ) )(@)(@@) . ( طس ) ، عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ 1343 / 30368 قال النبي :(@)(@@) | 30 ( ألا أخبركم برجال في الجنة : النبي في الجنة ، والصديق في الجنة ، والرجل يزور أخاه في ناحية المصر لا يزوره إلا لله في الجنة ) )(@)(@@) . ( طك ) ، عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ 1344 / 30369 قال النبي :(@)(@@) | 30 ( ألا أخبركم بخير أعمالكم ، وأزكاها عند مليككم ، وأرفعها لدرجاتكم ، وخير لكم ممن أعطي الذهب والورق ، وخير لكم من أن تلقوا عدوكم فيضربون رقابكم وتضربون رقابهم ؟ ذكر الله تعالاى ) )(@)(@@) . ( حم ) ، عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ 1345 / 30370 قال النبي :(@)(@@) | 30 ( ألا أخبركم بأحبكم إلي وأقربكم مني مجلسا يوم القيامة ؟ أحسنكم خلقا ) )(@)(@@) . ( حم ) ، عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ 1346 / 30371 قال النبي :(@)(@@) | 30 ( ألا أخبركم بوصية نوح ابنه ؟ أوصاى نوح ابنه فقال : يا بني إني أوصيك باثنتين وأنهاك عن اثنتين ، أوصيك بقول لا إلاه إلا الله ، فإنها لو وضعت في كفة ووضعت السماوات والأرض في كفة لرجحتهن ولو كانت حلقة لقصمتهن حتى تخلص إلاى الله ، وتقول سبحان الله العظيم وبحمده ، فإنها عبادة الخلق ، وفيه تقطع أرزاقهم ، وأنهاك عن اثنتين : ا لشرك والكبر فإنهما يحجبان عن PageV10P226 الله ، فقيل : يا رسول الله أمن الكبر أن يتخذ الرجل الطعام فيكون عليه الجماعة ، أو يلبس النظيف ؟ قال : ليس ذالك ، إنما الكبر أن تسفه الحق وتغمص الناس ) )(@)(@@) . ( بز ) ، عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ 1347 / 30372 قال النبي :(@)(@@) | 30 ( ألا أخبركم بشيء إذا فعلتموه أدركتم فضلهم ؟ قولوا : الله أكبر في كل صلاة إحداى عشرة مرة ، والحمد لله مثل ذالك ، ولا إلاه إلا الله مثل ذالك ، وسبحان الله مثل ذالك تدركوا مثل فعلهم أي الأغنياء فذكر ذالك للأغنياء ففعلوا مثل 
ms3306	 ذالك أيضا ، فقال الفقراء لرسول الله : هاؤلاء إخواننا فعلوا مثل ما نقول ، فقال ذالك فضل الله يؤتيه من يشاء ، يا معشر الفقراء ألا أبشركم أن فقراء المسلمين يدخلون قبل أغنيائهم الجنة بنصف يوم خمس مائة عام ) )(@)(@@) . ( بز ) ، عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ 1348 / 30373 قال النبي :(@)(@@) | 30 ( ألا أخبركم أن هاذه طيحبة قاله ثلاثا ألا أخبركم أن هاذه طيبة قاله ثلاثا ألا أخبركم أن نحو الشام بل في نحو العراق يخرج حتى يخرج من بلدة يقال لها أصبهان ، من قرية من قراها يقال لها : رسيعا ، وعلاى مقدمته سبعون ألفا عليهم التجان ، معه نهران : نهر من ماء ، ونهر من نار ، فمن أدرك ذالك منكم ، فقال له : ادخل الماء فلا يدخل فإنه نار ، وإذا قيل له : ادخل النار فليدخلها فإنه ماء ) )(@)(@@) . ( طكس ) ، عن فاطمة بنت قسس رضي الله عنها .(@)(@@)(@@)(@@) $ 1349 / 30374 قال النبي :(@)(@@) | 30 ( ألا أخبركم بأسرع كرة منه وأعظم غنيمة ؟ رجل توضأ فأحسن الوضوء ثم عمد إلاى المسجد فصلى فيه الغداة ، ثم أعقب بصلاة الضحوة ) )(@)(@@) . ( ع ) ، عن أبي هريرة رضي الله عنه قال : بعث رسول الله بعثا فأعظموا الغنيمة وأسرعوا الكرة ، فقال رجل : ما رأيت بعثا قط أسرع كرة ولا أعظم غنيمة من هاذا البعث فذكره .(@)(@@)(@@)(@@) $ 1350 / 30375 قال النبي :(@)(@@) | 30 ( ألا أخبركم بمكفرات الخطايا : إسباغ الوضوء علاى المكاره ، وكثرة الخطا إلاى المسجد ، وانتظار ال صلاة بعد الصلاة ) )(@)(@@) PageV10P227 . ( حم ، طك ) ، عن عمرو بن عبد الله بن كعب رضي الله عنه .(@)(@@)(@@)(@@) $ 1351 / 30376 قال النبي :(@)(@@) | 30 ( ألا أخبركم بمن تحرم عليه النار ؟ علاى كل هين لين سهل قريب ) )(@)(@@) . ( طس ) ، عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ 1352 / 30377 قال النبي :(@)(@@) | 30 ( ألا أدلك يا سعد على صدقة ، قليل مؤنتها ، عظيم أجرها ؟ سقي الماء ) )(@)(@@) . ( حم ، طك ) ، عن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ 1353 / 30378 قال النبي :(@)(@@) | 30 ( ألا أدلكم على ما ينجيكم من عدوكم ، ويدر لكم أرزاقكم ؟ تدعون الله في ليلكم ونهاركم ، فإن الدعاء سلاح المؤمن ) )(@)(@@) . ( ع ) ، عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ 1354 / 30379 قال 
ms3307	 النبي :(@)(@@) | 30 ( ألا أدلكم علاى كلمة تنجيكم من الاشراك ؟ { قل يا أيها الكافرون } عند منامكم ) )(@)(@@) . ( طك ) ، عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ 1355 / 30380 قال النبي :(@)(@@) | 30 ( ألا أعلمك رقية رقاني بها جبريل ؟ بسم الله أرقيك ، والله يشفيك من كل داء يؤذيك ، خذها فليهنيك ) )(@)(@@) . ( طك ) ، عن عمار بن ياسر رضي الله عنه .(@)(@@)(@@)(@@) $ 1356 / 30381 قال النبي :(@)(@@) | 30 ( ألا أعلمك كلمات إذا قلتهن نمت ؟ قل : اللهم رب السماوات السبع وما أظلت ، ورب الأرض وما أقلت ، ورب الشياطين وما أضلت ، كن لي جارا من شر جميع الجن والإنس أو من شر خلقك أجمعين ، وأن يفرط علي أحد منهم أو يطغاى وأن يؤذيني ، عز جارك ، وجل ثناؤك ، وتبارك اسمك ، ولا إلاه غيرك ) )(@)(@@) . ( طك ) ، عن خالد بن الوليد رضي الله عنه قال : شكوت له الأرق فذكره .(@)(@@) PageV10P228(@)(@@)(@@)(@@) $ 1357 / 30382 قال النبي :(@)(@@) | 30 ( ألا أعلمك ما علمني جبريل ؟ قل : اللهم اغفر خطئي وعمدي وهزلي وجدي ولا تحرمني بركة ما أعطيتني ، ولا تفتني فيما حرمتني ) )(@)(@@) . ( طس ) ، عن أبي رضي الله عنه .(@)(@@)(@@)(@@) $ 1358 / 30383 قال النبي :(@)(@@) | 30 ( ألا أعلمك كلمات يذهب الله عنك السقم والضر ؟ قل : توكلت علاى الحي الذي لا يموت ، { الحمد لله الذي لم يتخذ ولدا . . } الآية ) )(@)(@@) . ( ع ) ، عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 1359 / 30384 قال النبي :(@)(@@) | 30 ( ألا أعلمك دعاء تدعو به فلو كان عليك من الدين مثل صبير يعني جبلا باليمن أداه الله عنك ؟ فادع يا معاذ قل اللهم مالك الملك تؤتي الملك من تشاء وتنزع الملك ممن تشاء وتعز من تشاء وتذل من تشاء بيدك الخير إنك علاى كل شيء قدير ، تولج الليل في النهار وتولج النهار في الليل وتخرج الحي من الميت وتخرج الميت من الحي وترزق من تشاء منهما وتمنع من تشاء ارحمني رحمة تغنني بها عمن سواك ) )(@)(@@) . ( طك ) ، عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ 1360 / 30385 قال النبي :(@)(@@) | 30 ( ألا أعلمكم الكلمات التي دعا بها موساى حين جاوز البحر ببني إسرائيل ؟ قولوا : اللهم لك الحمد ، وإليك المشتكاى ، وعليك المستعان ، ولا 
ms3308	 حول ولا قوة إلا بالله العلي العظيم ) )(@)(@@) . ( طسص ) ، عن ابن مسعود رضي الله عنه )(@)(@@)(@@)(@@) $ 1361 / 30386 قال النبي :(@)(@@) | 30 ( ألا أعلمكم خمسا : حب المساكين والدنو منهم ، وانظروا إلاى من هو أسفل منكم ولا تنظروا إلاى من هو فوقكم ، وصلوا الرحم وإن أدبرت ، وقولوا الحق وإن كان مرا ، وأكثروا من قول لا حول ولا قوة إلا بالله ) )(@)(@@) . ( طس ) ، عن أبي سعيد رضي الله عنه .(@)(@@) PageV10P229 |(@)(@@)(@@)(@@) $ 1366 - قال النبي صلى الله عليه وسلم : ' ألا إن الخمر قد حرمت فلا تبيعوها ولا | تبتاعوها ، ومن كان عنده منها شيء فليهرقه ' . ( طس ، عن أم سليم رضي الله | عنها ) . |(@)(@@)(@@)(@@) $ 1367 - قال النبي صلى الله عليه وسلم : ' ألا إن الأمراء من قريش - قاله ثلاثا - ما | أقاموا بثلاث : ما حكموا فعدلوا ، وما عاهدوا فوفوا ، وما استرحموا فحرموا ، فمن لم | يفعل ذلك منهم فعليه لعنة الله والملائكة والناس أجمعين ' . ( ع ، عن علي رضي | الله عنه ) . |(@)(@@)(@@)(@@) $ 1368 - قال النبي صلى الله عليه وسلم : ' ألا إن الإيمان يمان ، والحكمة يمانية ، | وأجد نفس ربكم من قبل اليمن ' . ( حم ، عن أبي هريرة رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 1369 - قال النبي صلى الله عليه وسلم : ' ألا إن دماءكم وأموالكم عليكم حرام كحرمة | هذا البلد في هذا اليوم ، فلا أعرفنكم ترجعون بعدي كفارا يضرب بعضكم رقاب | PageV10P230 | بعض ألا ليبلغ الشاهد منكم الغائب ، وإني لا أدري هل ألقاكم أبدا بعد ؟ اللهم | اشهد عليهم ، اللهم هل بلغت ؟ ' . ( ع ، عن طالب بني سلمى بن عاصم بن | الحكم عن جده ) . |(@)(@@)(@@)(@@) $ 1370 - قال النبي صلى الله عليه وسلم : ' ألا إن صاحبكم يريد أن يضع كل فارس | ويرفع كل راع بن راع ' . ( حم ، عن ابن عمر رضي الله عنهما ) . |(@)(@@)(@@)(@@) $ 1371 - قال النبي صلى الله عليه وسلم : ' ألا إن عيسى بن مريم ليس بيني وبينه نبي ولا | رسول إلا خليفتي في أمتي من بعدي ، ألا إنه يقتل الدجال ويكسر الصليب وتضع | الحرب أوزارها ، ألا فمن أدركه منكم فليقرأ عليه السلام ' . ( طسص ، عن أبي | هريرة رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 1372 - قال النبي صلى الله عليه وسلم : ' ألا 
ms3309	 إنه سيخرج من أمتي أقوام أشداء أجداء | ذالقة ألسنتهم بالقرآن لا يجاوز تراقيهم ' . ( حم ، عن مسلم بن بكرة عن أبيه ) . |(@)(@@)(@@)(@@) $ 1373 - قال النبي صلى الله عليه وسلم : ' ألا إني أوشك أن أدعى فأجيب ، فسيليكم | عمال من بعدي يعملون بما يعلمون ، ويعملون بما تعرفون ، فمن قادهم وناصحهم | فأولئك قد هلكوا وأهلكوا ، خالطوهم بأجسادكم ، وزايلوهم بأعمالكم ، واشهدوا | على المحسن بأنه محسن وعلى المسيء بأنه مسيء ' . ( طس ، عن أبي سعيد | الخدري رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 1374 - قال النبي صلى الله عليه وسلم : ' ألا تحبون أن تبيتوا في خراف الجنة ؟ ' . | ( طس ، عن أبي هريرة رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 1375 - قال النبي صلى الله عليه وسلم : ' ألا تخرجين معنا في سفرنا هذا ؟ قالت : | إني شاكية ، وأخاف أن يحبسني شكواي قال : أهلي بالحج وقولي : اللهم محلي | PageV10P231 | حيث حبستني ' . ( حم ، طك ، عن أم سلمة رضي الله عنها قالت : أتت ضباعة | بنت الزبير بن عبد المطلب رضي الله عنها وهي شاكية فذكره ) . |(@)(@@)(@@)(@@) $ 1376 - قال النبي صلى الله عليه وسلم : ' ألا ترضى أن تعيش حميدا وتموت شهيدا | وتدخل الجنة - قاله لثابت بن قيس ' . ( طكس ، عن ثابت بن قيس رضي الله | عنه ) . |(@)(@@)(@@)(@@) $ 1377 - قال النبي صلى الله عليه وسلم : ' ألا ترضى أن تكون مني بمنزلة هارون من | موسى إلا أنه لا نبي بعدي ' . ( ع ، طك ، عن أم سلمة رضي الله عنها ) . |(@)(@@)(@@)(@@) $ 1378 - قال النبي صلى الله عليه وسلم : ' ألا ترضين أن تكوني سيدة نساء أهل | الجنة ، وابناك سيدا شباب أهل الجنة - قاله لفاطمة - ' . ( طك ، عن علي رضي الله | عنه ) . |(@)(@@)(@@)(@@) $ 1379 - قال النبي صلى الله عليه وسلم : ' ألا تغسل هذا الرجس عنك ؟ اذهب فاغسله | - قاله ليعلى بن أمية وقد دخل وهو متخلق بزعفران - ' . ( طس ، عن يعلى بن | أمية رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 1380 - قال النبي صلى الله عليه وسلم : ' ألا رجل يتصدق على هذا فيصلي معه ؟ فقام | رجل فصلى معه فقال : هذان جماعة ' . ( حم ، طك ، عن أبي أمامة رضي الله | عنه ) . |(@)(@@)(@@)(@@) $ 1381 - قال النبي صلى الله عليه وسلم : ' ألا عسى أحدكم أن يضرب امرأته 
ms3310	 ضرب | الأمة ، ألا خيركم خيركم لأهله ' . ( بز ، عن الزبير رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 1382 - قال النبي صلى الله عليه وسلم : ' ألا لا تقتلوا ذرية - قاله ثلاثا - فإن كل نسمة | تولد على الفطرة حتى يعرب عنها لسانها ، فإن أبواها يهودانها أو ينصرانها ' . ( حم ، | بأسانيد عن ابن عباس رضي الله عنهما ) . | PageV10P232 |(@)(@@)(@@)(@@) $ 1383 - قال النبي صلى الله عليه وسلم : ' ألا لا تحلبن ماشية امرئ إلا بإذنه ، أيحب | أحدكم أن تؤتى مشربته فيكسر بابها ثم ينتشل ما فيها ، فإنما في ضروع مواشيهم طعام | أحدهم ، ألا لا يحلبن أحدكم ماشية امرئ إلا بإذنه ' . ( حم ، عن ابن عمر رضي | الله عنهما ) . |(@)(@@)(@@)(@@) ||| ( الهمزة مع الياء )(@)(@@)(@@)(@@) $ 1384 - قال النبي صلى الله عليه وسلم : ' أيحسب أحدكم أنه إذا كان عنده أبواه أو | أحدهما أنه ليس في سبيل الله ؟ بل هو في سبيل الله إذا أبرهما وأدى حقهما ' . | ( طك ، عن أبي أمامة رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 1385 - قال النبي صلى الله عليه وسلم : ' أيسرك أن يشرب معك الهر ؟ قال : لا ، | قال : فإنه شرب معك من هو شر منه : الشيطان ' . ( حم ، عن أبي هريرة رضي الله | عنه قال : رأى صلى الله عليه وسلم رجلا يشرب قائما فذكره ) . |(@)(@@)(@@)(@@) $ 1386 - قال النبي صلى الله عليه وسلم : ' أي خديجة ! والله لا أعبد اللات أبدا ، | والله ! لا أعبد العزى أبدا ' . ( حم ، عن عروة بن الزبير رضي الله عنه قال : حدثني | جار خديجة بنت خويلد قال : سمعت النبي صلى الله عليه وسلم يقول لخديجة رضي الله عنها ذلك ) . |(@)(@@)(@@)(@@) $ 1387 - قال النبي صلى الله عليه وسلم : ' أين أنت من الاستغفار ؟ إني لأستغفر الله | في اليوم والليلة مائة مرة ' . ( طس ، عن أنس رضي الله عنه أن رجلا شكى | للنبي صلى الله عليه وسلم ذرب لسانه فذكره ) . |(@)(@@)(@@)(@@) $ 1388 - قال النبي صلى الله عليه وسلم : ' إياك والذنوب التي لا تغفر : الغلول ، فمن | PageV10P233 | غل شيئا أتى به يوم القيامة ، وآكل الربا فمن أكل الربا بعث يوم القيامة مجنونا يتخبطه | الشيطان من المس ' . ( طك ، عن عوف بن مالك رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 1389 - قال النبي 
ms3311	 صلى الله عليه وسلم : ' إياكم والجلوس على الصعدات ، فإن كنتم | لا بد فاعلين فأعطوا الطريق حقه : غض البصر ، ورد السلام ، وإرشاد الضال ' . | ( بز ، عن عمر رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 1390 - قال النبي صلى الله عليه وسلم : ' إياكم والدجالين الثلاثة ، فقيل : أخبرتنا عن | الدجال الأعور ، وعن أكذب الكذابين ، فمن الثالث ؟ قال : رجل يخرج في قوم ، | أولهم مثبور ، وآخرهم منثور عليهم اللعنة دائما في فتنة يقال لها الخارقة وهو الدجال | الأطلس يأكل عباد الله ' . ( طك ، عن شعيب بن عمرو رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 1391 - قال النبي صلى الله عليه وسلم : ' إياكم والظلم فإن الظلم ظلمات يوم القيامة ، | وإياكم والشح فإنما أهلك من كان قبلكم الشح ، أمرهم بالقطيعة أرحامهم ، وأمرهم | بسفك الدماء فسفكوا دماءهم ' . ( طس ، عن معاذ بن جبل رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 1392 - قال النبي صلى الله عليه وسلم : ' إياكم والطمع فإنه هو الفقر ، وإياكم وما | يعتذر منه ' . ( طس ، عن جابر رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 1393 - قال النبي صلى الله عليه وسلم : ' إياكم والفرج - يعني في العبادة - ' . | ( طك ، عن ابن عباس رضي الله عنهما ) . |(@)(@@)(@@)(@@) $ 1394 - قال النبي صلى الله عليه وسلم : ' إياكم والكبر فإن الكبر يكون في الرجل وأن | عليه العباءة ' . ( طس ، عن ابن عمر رضي الله عنهما ) . |(@)(@@)(@@)(@@) $ 1395 - قال النبي صلى الله عليه وسلم : ' إياكم ومحقرات الذنوب يأخذ بها صاحبها | فتهلكه ' . ( حم ، طكس ، عن سهل بن أحمد رضي الله عنه ) . | PageV10P234 |(@)(@@)(@@)(@@) $ 1396 - قال النبي صلى الله عليه وسلم : ' إياكم ولباس الرهبان فإنه من ترهب وتشبه | فليس مني ' . ( طب ، عن علي رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 1397 - قال النبي صلى الله عليه وسلم : ' إياكم وهاتين البقلتين المنتنتين : الثوم | والبصل أن تأكلوهما وتدخلوا مساجدنا ، فإن كنتم لا بد آكليهما فاقتلوهما بالنار | قتلا ' . ( طس ، عن أنس رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 1398 - قال النبي صلى الله عليه وسلم : ' إياكم وهاتان اللعبتان المسومتان اللتان | تزجران زجرا فإنهما ميسر العجم ' . ( حم ، عن ابن مسعود رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 1399 - قال النبي صلى الله عليه وسلم : ' إياكن وكفر المنعمين قيل : وما هو ؟ قال : | لعل إحداكن أن تطول 
ms3312	 أيمتها أو تعنس عند أبويها ، ثم يرزقها الله زوجا ، ثم يرزقها | الله منه ولدا ، ثم تغضب الغضبة فتكفره فتقول : والله ما رأيت منك خيرا قط ' . | ( حم ، طك ، عن أسماء بنت يزيد رضي الله عنها ) . |(@)(@@)(@@)(@@) $ 1400 - قال النبي صلى الله عليه وسلم : ' إياكم وأن يتلعب بكم الشيطان في | صلاتكم ، من صلى منكم فلم يدر أشفع أم وتر فليسجد سجدتين فإنهما تمام | صلاته ' . ( حم ، عن عثمان رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 1401 - قال النبي صلى الله عليه وسلم : ' أيما امرأة تزوجت بغير إذن ولي فنكاحها | باطل ، فإن دخل بها فلها المهر بما استحل من فرجها ، والسلطان ولي من لا ولي | له ' . ( طس ، عن ابن عباس رضي الله عنهما ) . |(@)(@@)(@@)(@@) $ 1402 - قال النبي صلى الله عليه وسلم : ' أيما امرأة اتقت ربها وحفظت فرجها ، | وأطاعت زوجها ، فتحت لها ثمانية أبواب من الجنة ، فقيل لها : ادخلي من حيث | PageV10P235 | شئت ' . ( طس ، عن أبي هريرة رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 1403 - قال النبي صلى الله عليه وسلم : ' أيما امرأة صامت بغير إذن زوجها وأرادها | على شيء فامتنعت عليه كتب الله عليها ثلاثة من الكبائر ' . ( طس ، عن أبي | هريرة رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 1404 - قال النبي صلى الله عليه وسلم : ' أيما رجل أصدق امرأة صداقا والله يعلم أنه | لا يريد أداءه إليها بغير ما تألفه واستحل فرجها بالباطل لقي الله يوم القيامة وهو زان ' . | ( حم ، طك ، عن صهيب بن سنان رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 1405 - قال النبي صلى الله عليه وسلم : ' أيما رجل تزوج امرأة على ما قل من المهر أو | كثر ليس في نفسه أن يؤدي إليها حقها لقي الله يوم القيامة وهو زان ' . ( طسص ، عن | ميمون الكردي عن أبيه ) . |(@)(@@)(@@)(@@) $ 1406 - قال النبي صلى الله عليه وسلم : ' أيما رجل باع عقدة من غير حاجة بعث الله | له تالفا يتلفها ' . ( طس ، عن عبد الله بن يعلى البصري رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 1407 - قال النبي صلى الله عليه وسلم : ' أيما رجل قام إلى وضوئه يريد الصلاة ثم | غسل كفيه نزلت خطيئته من كفيه مع أول قطرة ، فإذا 
ms3313	 تمضمض واستنشق واستنثر نزلت | خطيئته من لسانه وشفتيه مع أول قطرة ، فإذا غسل وجهه نزلت خطيئته من سمعه | وبصره مع أول قطرة ، فإذا غسل يديه إلى المرفقين ورجليه إلى الكعبين سلم من كل | ذنب هو له وخرج من كل خطيئة كهيئته يوم ولدته أمه ، قال : فإذا قام إلى الصلاة | رفع الله بها درجته وإن قعد قعد سالما ' . ( حم ، طكس ، عن أبي أمامة رضي الله | عنه ) . |(@)(@@)(@@)(@@) $ 1408 - قال النبي صلى الله عليه وسلم : ' أيما رجل أتاه ابن عمه يسأله من فضله فمنعه | PageV10P236 | منعه الله من فضله يوم القيامة ، ومن منع فضل الماء ليمنع به فضل الكلأ منعه الله | فضله يوم القيامة ' . ( طسص ، عن ابن عمرو رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 1409 - قال النبي صلى الله عليه وسلم : ' أيما رجل يعود مريضا فإنما يخوض في | الرحمة فإذا قعد عند المريض غمرته الرحمة ، والمريض تحط عنه ذنوبه ' . ( حم ، | طسص ، عن أبي داود عن أنس رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 1410 - قال النبي صلى الله عليه وسلم : ' أيما رجل نحل ابنه نحلا فبان به الابن | فاحتاج الأب فالأب أحق به وإن لم يكن بان به الابن فالأب أحق به ' . ( طس ، عن | ابن عباس رضي الله عنهما ) . |(@)(@@)(@@)(@@) $ 1411 - قال النبي صلى الله عليه وسلم : ' أيما رجل أعمر عمرى فهي له ولعقبه من | بعده يرثها من يرثه من عقبه ، أو أرقب رقبى فهي بمنزلة العمرى ' . ( طس ، عن ابن | بير رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 1412 - قال النبي صلى الله عليه وسلم : ' أيما رجل تزوج امرأة على ما قل من المهر أو | كثر ، ليس في نفسه أن يؤدي إليها حقها لقي الله يوم القيامة وهو زان ، وأيما رجل | استدان دينا لا يريد أن يؤديه إلى صاحبه ، فدعه حتى أخذ ماله حتى مات ولم يرد إليه | دينه لقي الله وهو سارق ' . ( طس ، عن ميمون الكردي عن أبيه ) . |(@)(@@)(@@)(@@) $ 1413 - قال النبي صلى الله عليه وسلم : ' أيما رجل أفلس فوجد رجل عنده ماله ولم | يكن اقتضى من ماله شيئا فهو أحق به ' . ( حم ، عن أبي هريرة 
ms3314	 رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 1414 - قال النبي صلى الله عليه وسلم : ' أيما عبد أصاب شيئا مما نهى الله عنه ثم | أقيم عليه حده كفر الله عنه ذلك الذنب ' . ( حم ، طك ، عن خزيمة بن ثابت رضي | الله عنه ) . | PageV10P237 |(@)(@@)(@@)(@@) $ 1415 - قال النبي صلى الله عليه وسلم : ' أيما قوم نودي فيهم بالأذان صباحا كان لهم | أمانا من عذاب الله تعالى حتى يمسوا ، وأيما قوم نودي فيهم بالأذان مساء كان لهم | أمانا من عذاب الله تعالى حتى يصبحوا ' . ( طك ، عن معقل بن يسار رضي الله | عنه ) . |(@)(@@)(@@)(@@) $ 1416 - قال النبي صلى الله عليه وسلم : ' أيما نائحة ماتت قبل أن تتوب ألبسها الله | سربالا من نار وأقامها للناس يوم القيامة ' . ( ع ، عن أبي هريرة رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 1417 - قال النبي صلى الله عليه وسلم : ' أيها الناس ! إن الأيدي ثلاثة : يد الله وهي | العليا ، ويد المعطي الوسطى ، ويد السائل السفلى ، فتعففوا ولو بحزم الحطب ثم | رفع يديه وقال : اللهم هل بلغت ؟ ' . ( ع ، طك ، عن عدي رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 1418 - قال النبي صلى الله عليه وسلم : ' أيها الناس ! إن الشمس والقمر لا ينكسفان | لموت أحد ولا لحياته ، ولكنهما آيتان من آيات الله ، فإذا رأيتم ذلك فافزعوا إلى | الصلاة ' . ( بز ، عن ابن عمر رضي الله عنهما أن الشمس انكسفت لموت عظيم | فخرج النبي صلى الله عليه وسلم فصلى بالناس أربع ركعات وأربع سجدات ثم أقبل على الناس | وذكره ) . |(@)(@@)(@@)(@@) $ 1419 - قال النبي صلى الله عليه وسلم : ' أيها الناس ! إن المصلي إذا صلى يناجي ربه | تعالى فلينظر بم يناجيه ولا يجهر بعضكم على بعض ' . ( حم ، بز ، طك ، عن ابن | عمر رضي الله عنهما ) . |(@)(@@)(@@)(@@) $ 1420 - قال النبي صلى الله عليه وسلم : ' أيها الناس ! إن النفر غدا ، فلا ينفرن أحد | حتى يطوف بالبيت ، فإن آخر النسك الطواف ' . ( ع ، عن ابن عمر رضي الله | عنهما ) . |(@)(@@)(@@)(@@) $ 1421 - قال النبي صلى الله عليه وسلم : ' أيها الناس ! إن أحدكم إذا قام في الصلاة | PageV10P238 | فإنه في مقام عظيم بين يدي رب عظيم يسأل أمرا عظيما ، الفوز بالجنة والنجاة من 
ms3315	 | النار ، وإن أحدكم إذا قام في الصلاة فإنه يقوم بين يدي الله عز وجل يستقبل ربه | وملكه عن يمينه ، وقرينه عن يساره ، فلا يتفلن أحدكم بين يديه ولا عن يمينه ولكن | عن يساره أو تحت قدمه اليسرى ، ثم ليعرك فليشدد عركه فإنما يعرك أذني الشيطان ، | والذي بعثني بالحق لو انكشفت بينكم وبينه الحجب ويؤذن في الكلام لشكى ما يلقى | من ذلك ' . ( طك ، عن أبي أمامة رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 1422 - قال النبي صلى الله عليه وسلم : ' أيها الناس ! إن جعفر بن أبي طالب مع | جبريل وميكائيل له جناحان عوضهما الله عن يديه يطير بهما في الجنة حيث شاء فسلم | علي وأخبرني كيف كان أمرهم حين لقي المشركين ، ولذلك سمي جعفر الطيار في | الجنة ' . ( طس ، عن ابن عباس رضي الله عنهما ) . |(@)(@@)(@@)(@@) $ 1423 - قال النبي صلى الله عليه وسلم : ' أيها الناس ! إنكم لن تسألوني عن شيء حين | أنزل إلا أخبرتكم به ، فقام رجل فقال : من أبي ؟ فقال : أبوك فلان الذي كان ينسب | إليه ' . ( حم ، عن أسماء بنت أبي بكر رضي الله عنهما ) . |(@)(@@)(@@)(@@) $ 1424 - قال النبي صلى الله عليه وسلم : ' أيها الناس ! ثنتان من وقاه الله شرهما دخل | الجنة : ما بين لحييه وما بين رجليه ' . ( حم ، عن تميم بن غنم عن رجل | صحابي ) . |(@)(@@)(@@)(@@) $ 1425 - قال النبي صلى الله عليه وسلم : ' أيها الناس ! من أبغضنا - أهل البيت - حشره | الله يوم القيامة يهوديا وإن صام وصلى وزعم أنه مسلم احتجز بذلك عن سفك دمه وأن | يؤدي الجزية عن يد وهم صاغرون ، مثل لي في الطين ، فمر أصحاب الرايات | فاستغفرت لعلي وشيعته ' . ( طس ، عن جابر رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 1426 - قال النبي صلى الله عليه وسلم : ' أيها الناس ! هذا وائل بن حجر قد أتاكم من | PageV10P239 | أرض بعيدة من حضرموت طائعا غير مكره راغبا في الله ورسوله ' . ( بز ، عن | وائل بن حجر رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 1427 - قال النبي صلى الله عليه وسلم : ' أيها الناس ! لا يحل لي ولا لأحد من | المسلمين ما يزن هذه الوبرة بعد الذي فرض الله 
ms3316	 لي ' . ( طك ، عن عمرو بن | خارجة رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 1428 - قال النبي صلى الله عليه وسلم : ' أيها الناس ! لا يقتل بعضكم بعضا ، فإذا | رميتم فارموا بمثل حصى الخذف ' . ( حم ، كط ، عن سليمان بن عمرو بن | الأحوص الجشمي الأزدي رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 1429 - قال النبي صلى الله عليه وسلم : ' أي بلد حرام ؟ قيل مكة ، قيل : فأي شهر | حرام ؟ قيل : ذو الحجة ، قال : فأي يوم حرام ؟ قيل : يوم النحر ، يوم الحج | الأكبر ، قال : فإن دماءكم وأموالكم حرام عليكم إلى أن تلقوا ربكم كحرمة يومكم هذا | في شهركم هذا في بلدكم هذا ' . ( طكس ، عن ابن الزبير رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 1430 - قال النبي صلى الله عليه وسلم : ' أي يوم هذا ؟ قالوا : يوم عرفة ، اليوم | الحرام ، في الشهر الحرام ، قال : فأي بلد هذا ؟ قالوا : البلد الحرام ، قال : فإن | أموالكم وأعراضكم ودماءكم عليكم حرام كحرمة يومكم هذا ، في شهركم هذا ، في | بلدكم هذا ، ألا كل نبي قد مضت دعوته ، فإني قد ادخرتها عند ربي يوم القيامة ، أما | بعد ! فإن الأنبياء مكاثرون فلا تخزوني فإني جالس لكم على باب الحوض ' . | ( طك ، عن أبي أمامة صدى بن عجلان الباهلي رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 1431 - قال النبي صلى الله عليه وسلم : ' أي يوم هذا ؟ قيل : يوم حرام ، قال : فإن | دماءكم وأموالكم عليكم حرام كحرمة يومكم هذا ، في شهركم هذا ، في بلدكم | هذا ' . ( بز ، عن أبي هريرة وأبي سعيد رضي الله عنهما ) . | PageV10P240 |(@)(@@)(@@)(@@) $ 1432 - قال النبي صلى الله عليه وسلم : ' أي الأجلين قضى موسى ؟ قال : | أوفاهما ' . ( طس ، عن جابر رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 1433 - قال النبي صلى الله عليه وسلم : ' أي الناس أعظم حقا على المرأة ؟ قال : | زوجها ، قلت : أي الناس أعظم حقا على الرجل ؟ قال : أمه ' . ( بز ، عن | عائشة رضي الله عنها ) . |(@)(@@)(@@)(@@) ||| ( المحلى بأل من هذا الحرف )(@)(@@)(@@)(@@) $ 1434 - قال النبي صلى الله عليه وسلم : ' الإثم جواز القلوب - وفي رواية : الصدور ، | وفي أخرى : ما كان من نظير فللشيطان فيها مطمع ، والإثم جواز القلوب ' . ( طك ، | عن ابن مسعود رضي الله عنه موقوفا ) . |(@)(@@)(@@)(@@) $ 1435 - قال 
ms3317	 النبي صلى الله عليه وسلم : ' الإثم ما حاك في صدرك ' . ( طك ، عن | أبي أمامة رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 1436 - قال النبي صلى الله عليه وسلم : ' الأرض كلها نار يوم القيامة ، والجنة من | ورائها كواعبها وأكوابها ، والذي نفس عبد الله بيده ! إن الرجل ليفيض عرقا حتى | يسبح في الأرض قامة ثم يرتفع حتى يبلغ أنفه وما مسه الحساب ، قيل : بم ذاك ؟ | قال : مما يرى الناس ويلقون ' . ( طك ، عن ابن مسعود رضي الله عنه موقوفا ) . |(@)(@@)(@@)(@@) $ 1437 - قال النبي صلى الله عليه وسلم : ' الأرض على الماء ، والماء على صخرة ، | والصخرة على ظهر حوت يلتقي طرفاه بالعرش ، والحوت على كاهل ملك قدماه في | الهواء ' . ( بز ، عن ابن عمر رضي الله عنهما ) . |(@)(@@)(@@)(@@) $ 1438 - قال النبي صلى الله عليه وسلم : ' الأرواح جنود مجندة فما تعارف منها في الله | ائتلف ، وما تناكر منها في الله اختلف ، إذا ظهر القول ، وخزن العمل ، وأتلفت | الألسنة ، وتباغضت القلوب ، وقطع كل ذي رحم رحمه فعند ذلك لعنهم الله | فأصمهم وأعمى أبصارهم ' . ( طك ، عن ابن مسعود رضي الله عنه ) . | PageV10P241 |(@)(@@)(@@)(@@) $ 1439 - قال النبي صلى الله عليه وسلم : ' الإسلام أن تسلم وجهك لله ، وأن تشهد أن | لا إله إلا الله وحده لا شريك له وأن محمدا عبده ورسوله ، والإيمان أن تؤمن بالله | واليوم الآخر والملائكة والكتاب والنبيين والموت والحياة بعد الموت ، وتؤمن بالجنة | والنار ، والحساب والميزان ، وتؤمن بالقدر كله خيره وشره ، والإحسان أن تعبد الله | كأنك تراه فإن لم تره فإنه يراك ، قال فحدثني متى الساعة ؟ قال : سبحان الله خمس | من الغيب لا يعلمهن إلا الله : ^ ( إن الله عنده علم الساعة . . . ) ^ الآية ، ولكن | إن شئت حدثتك بمعالم لها دون ذلك ، قال : أجل ، قال : إذا رأيت الأمة ولدت | ربتها أو ربها ، ورأيت أصحاب البنيان يتطاولون في البنيان ، ورأيت الحفاة الجياع | العالة كانوا رؤوس الناس فذلك من معالم الساعة ومن أشراطها ' . ( حم ، بز ، عن | ابن عباس رضي الله عنهما قال : جلس رسول الله صلى الله عليه وسلم مجلسا فأتاه جبريل فجلس | بين يديه واضعا يديه على ركبتي 
ms3318	 رسول الله صلى الله عليه وسلم وقال : حدثني عن الإسلام ، | فذكره ) . |(@)(@@)(@@)(@@) $ 1440 - قال النبي صلى الله عليه وسلم : ' الإسلام : طيب الكلام ، وإطعام الطعام ، | والإيمان : الصبر والسماحة ، وأفضل الإسلام من سلم المسلمون من لسانه ويده ، | وأفضل الإيمان خلق حسن ، وأفضل الصلاة طول القنوت ، وأفضل الهجرة أن تهجر | ما كره ربك ' . ( حم ، عن عمرو بن عنبسة رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 1441 - قال النبي صلى الله عليه وسلم : ' الإسلام من سلم المسلمون من لسانه ويده ، | وأفضل الإيمان خلق حسن ، وأفضل الصلاة : طول القنوت ، وأفضل الهجرة أن | تهجر ما كره ربك ' . ( حم ، عن عمرو بن عنبسة رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 1442 - قال النبي صلى الله عليه وسلم : ' الإسلام نظيف فتنظفوا ، فإنه لا يدخل الجنة | إلا نظيف ' . ( طس ، عن عائشة رضي الله عنها ) . | PageV10P242 |(@)(@@)(@@)(@@) $ 1443 - قال النبي صلى الله عليه وسلم : ' الأعمال ستة : عملان منجيان ، وعملان | بأمثالهما ، وعمل بعشرة أمثاله ، وعمل بسبع مائة ، وعمل لا يعلم ثواب عامله إلا | الله ، فأما المنجيات : فمن لقي الله لا يشرك به شيئا وجبت له الجنة ، ومن لقي الله | يشرك به شيئا وجبت له النار ، ومن عمل سيئة جزي بها ، ومن أراد أن يعمل حسنة فلم | يعملها جزي مثليها ، ومن عمل حسنة جزي عشرا ، ومن أنفق ماله في سبيل الله | ضعفت له نفقة الدرهم بسبع مائة ، والصيام لا يعلم ثواب عامله إلا الله ' . ( طس ، | عن ابن عمر رضي الله عنهما ) . |(@)(@@)(@@)(@@) $ 1444 - قال النبي صلى الله عليه وسلم : ' الإمام ضامن ، والمؤذن مؤتمن ' . ( حم ، | طك ، عن أمامة الباهلي رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 1445 - قال النبي صلى الله عليه وسلم : ' الأمور كلها : خيرها وشرها من الله ، والقدر | نظم التوحيد ، فمن وحد الله وآمن بالقدر فقد استمسك بالعروة الوثقى ' . ( طس ، | عن ابن عباس رضي الله عنهما ) . |(@)(@@)(@@)(@@) $ 1446 - قال النبي صلى الله عليه وسلم : ' الأمن والعافية نعمتان مغبون فيهما كثير من | الناس ' . ( طك ، عن ابن عباس رضي الله عنهما ) . |(@)(@@)(@@)(@@) $ 1447 - قال النبي صلى الله عليه وسلم : ' الأنبياء أحياء في قبورهم يصلون ' . ( ع ، | بز ، عن أنس رضي الله عنه 
ms3319	 ) . |(@)(@@)(@@)(@@) $ 1448 - قال النبي صلى الله عليه وسلم : ' الإنسان ثلاثمائة وستون عظما ، وستة | وثلاثون سلامى ، عليه في كل يوم صدقة ، قيل : فمن لم يستطع ؟ قال : يرفع عظما | من الطريق ، فمن لم يستطع فليهد سبيلا ، فمن لم يستطع فليعن ضعيفا ، فمن لم | يستطع فليدع الناس من شره ' . ( بشر ، عن أبي هريرة رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 1449 - قال النبي صلى الله عليه وسلم : ' الإيمان يمان ، وأداء الإيمان في قحطان ، | PageV10P243 | والقسوة في ولد عدنان ، حمير رأس العرب وبابها ، ومذحج هامتها وعصمتها ، والأزد | كاهلتها وحجتها ، وهمدان قلتها وذواتها ، اللهم أعن الأنصار الذين أقام الله بهم | الدين وآووا ونصروا ورحموا وهم أصحابي في الدنيا وشيعتي في الآخرة ، وأول من | يدخل الجنة من أمتي ' . ( بز ، عن عمر رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 1450 - قال النبي صلى الله عليه وسلم : ' الأئمة من قريش : أبرارها وفجارها وأمراء | فجارها ولكل حق ، فآتوا كل ذي حق حقه وإن أمر عليكم عبد حبشي فاسمعوا وأطيعوا | ما لم يخير أحدكم بين إسلامه وضرب عنقه فليمدد عنقه ثكلته أمه فلا دنيا له ولا آخرة | بعد ذهاب دينه ' . ( طسص ، عن علي رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 1451 - قال النبي صلى الله عليه وسلم : ' الأئمة من قريش ، إن لي عليكم حقا ، | ولهم عليكم حقا مثل ذلك ، أما أن يسترحموا رحموا ، وإن عاهدوا وفوا ، وإن حكموا | عدلوا ، فمن لم يفعل ذلك منهم فعليه لعنة الله والملائكة والناس أجمعين ' . | ( حم ، ع ، طس ، بز ، إلا أنه قال : الملك في قريش عن بكير بن وهب عن | أنس رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 1452 - قال النبي صلى الله عليه وسلم : ' الأئمة من قريش ، ولي عليكم حق عظيم | ولهم مثل ذلك ما فعلوا ثلاثا : ما إذا استرحموا رحموا ، وإذا حكموا عدلوا ، وإذا | عاهدوا وفوا ، فمن لم يفعل ذلك منهم فعليه لعنة الله والملائكة والناس أجمعين ' . | ( طكس ، عن أنس رضي الله عنه ، وفي رواية : إذا اؤتمنوا أدوا ) . | PageV10P244 |(@)(@@)(@@)(@@) || ( حرف الباء )(@)(@@)(@@)(@@) ||| ( الباء مع الألف )(@)(@@) | بسم الله الرحمن الرحيم |(@)(@@)(@@)(@@) $ 1453 - قال النبي صلى الله عليه وسلم : ' بسم الله الرحمن الرحيم ، أعيذك بالله | الأحد 
ms3320	 الصمد ، الذي لم يلد ولم يولد ، ولم يكن له كفوا أحد من شر ما تجذع ' . | ( طك ، عن عثمان رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 1454 - قال النبي صلى الله عليه وسلم : ' بسم الله الرحمن الرحيم ، من محمد | رسول الله إلى شرحبيل بن عبد كلال والحارث بن عبد كلال ونعيم بن عبد كلال | قيل ذي رعين ومعافر وهمدان ، أما بعد ! فقد رجع رسولكم وأعطيتم من المغانم | خمس الله وما كتب الله على المؤمنين من العشر وما سقت السماء أو كان سيحا أو كان | بعلا ففيه العشر إذا بلغ خمسة أوسق ، وفي كل خمس من الإبل شاة إلى أن تبلغ | أربعا وعشرين ، فإن زادت واحدة على أربع وعشرين ففيها بنت مخاض فإن لم توجد | بنت مخاض فابن لبون ذكر إلى أن تبلغ خمسا وثلاثين ، فإن زادت واحدة ففيها بنت | لبون إلى أن تبلغ خمسا وأربعين ، فإذا زادت واحدة على خمس وأربعين ففيها حقة | طروقة الجمل إلى أن تبلغ ستين فإن زادت على ستين واحدة ففيها جذعة إلى أن تبلغ | تسعين فإن زادت واحدة ففيها حقتان طروقتا الجمل إلى أن تبلغ عشرين ومائة ، فإن | زادت على عشرين ومائة شاة ففيها شاتان إلى أن تبلغ مائتين ، فإن زادت واحدة ففيها | ثلاث شياه إلى أن تبلغ ثلاثمائة ، فإن زادت ففي كل مائة شاة ، ولا يؤخذ في الصدقة | عجفاء هرمة ، ولا ذات عوار ولا تيس الغنم ، ولا يجمع بين متفرق ، ولا يفرق بين | مجتمع خشية الصدقة ، وما أخذ من خليلين فإنهما يرجعان بينهما بالسوية ، وفي كل | خمس أواق من الورق خمسة دراهم وما زاد ففي كل أربعين درهما درهم وليس فيما | دون خمس أواق شيء ، وفي كل أربعين دينارا دينار ، والصدقة لا تحل لمحمد ولا | PageV10P245 | لأهل بيته إنما هي الزكاة تزكى بها أنفسكم وللفقراء المؤمنين وفي سبيل الله ، ولا | في رقيق ولا مزرعة ولا عمالها شيء إذا كانت صدقتها تؤدى من العشر ، وأنه ليس في | عبد مسلم ولا في فرشه شيء ' . ( طك ، عن عمرو بن حزم رضي الله عنه 