ms61	 البديه % % على أنها ذات نهج سديد % % 38(@)(@@) % ولو أمهل الوقت تنقيحها % % لجاوزت غاية عبد الحميد % % 39(@)(@@) % فلا بالغبي ولا بالعيي % % ولا بالبطي ولا بالبليد % % 40(@)(@@) % بقيت لبذل نوال وجود % % ونشر بنود ونصر جنود % % PageV01P266 البحر : طويل 1(@)(@@) % لمن طلل نائي المزار بعيده % % وعهد كريم لا يذم حميده % % 2(@)(@@) % عفا غير نؤي كالسوار وموقد % % كما جثمت بيض الحمام وسوده % % 3(@)(@@) % إذا أخلف الغيث الأباطح والربا % % فتسكاب دمع المقلتين يجوده % % 4(@)(@@) % محل لسعدى والزمان مساعد % % وجفن الليالي لا يريم هجوده % % 5(@)(@@) % وقفنا به عوج المطي كأنه % % عليل ومجتاز الركاب يعوده % % 6(@)(@@) % فلولا نسيم رد رجع جوابنا % % فسكن من حر الأوام بروده % % 7(@)(@@) % لما حملت منا الضلوع غرامها % % ولا كان هذا الشوق يخبو وقوده % % 8(@)(@@) % وتالله لولا أنة تشهر الجوى % % فأضحى وسر الحب باد جحوده % % 9(@)(@@) % لأثرت كتم الوجد بين جوانحي % % وبلغت في القلب الهوى ما يريده % % 10(@)(@@) % خليلي ما للركب لا يشتكي الوجا % % وما لبساط الفقر يطوى مديده % % PageV01P267 11(@)(@@) % يحيا جناح السير حتى كأنما % % رجاء أمير المسلمين يقوده % % 12(@)(@@) % أظن ديار الحي منا قريبة % % وظمآن هذا البعد حان وروده % % 13(@)(@@) % وإلا فما بال النسيم كأنما % % أكبت على النار الكباء هنوده % % 14(@)(@@) % تأرج في الآفاق مسرى هبوبه % % كما حملت عنه الثناء وفوده % % 15(@)(@@) % وما بال هذا العيس لا تسأم السرى % % كما جهرت عند المغار جنوده % % 16(@)(@@) % أمير كفى الإسلام كل عظيمة % % وقد شاب من طول العناء وليده % % 17(@)(@@) % وقاد إلى أصراخه كل سابح % % معوده ألا تحط لبوده % % 18(@)(@@) % وألف أسرار النفوس على الهوى % % فأوشك من وقد الشتات خموده % % 19(@)(@@) % ولما عرت هذي الجزيرة نبوة % % وعطل من فوق الجهاد أكيده % % 20(@)(@@) % وأصبح ثغر الثغر بعد ابتسامه % % ولولا دفاع الله فضت عقده % % PageV01P268 21(@)(@@) % تدارك آل النصر حفظ ذمائه % % فأعقب صديق الجلال شهيده % % 22(@)(@@) % وأنجبه للدين يحمي ذماره % % كما أنجبت ليث العرين أسوده % % 23(@)(@@) % فقام بأمر الله ناصر دينه % % ولا عبء يثني عزمه ويؤوده % % 24(@)(@@) % وأسلك نهج الحق من حاد بعدما % % تنوسي ذكراه وضل سديده % % 25(@)(@@) % إذا 
ms62	 عدد الأملاك مجدا ومحتدا % % فيوسف أنصار النبي جدوده % % 26(@)(@@) % وإن قعدوا من دون مبلغ غاية % % تدانى له من كل قصد بعيده % % 27(@)(@@) % وأي فؤاد منهم غير خافق % % إذا خفقت أعلامه وبنوده % % 28(@)(@@) % له فتكات ما تجف ظباتها % % وعزم اقتدار ما تحل عقوده % % 29(@)(@@) % ورأي يمد الشمس نورا ومشهدا % % ملائكة السبع الطباق شهوده % % 30(@)(@@) % فللناس في يوم العطاء هباته % % ولله في الليل سجوده وهجوده % % PageV01P269 31(@)(@@) % يمينا لما الأنواء إلا يمينه % % وما الجود إلا ما سقى الأرض جوده % % 32(@)(@@) % أمير العلى لولاك أصبح ربعها % % خلاء ودين الله واه عموده % % 33(@)(@@) % ولكن نهجت العدل من بعد فترة % % وقد درست آثاره وعهوده % % 34(@)(@@) % شمل الكفر بعد ائتلافه % % فأضحى عميدا في الرغام عميده % % 35(@)(@@) % في الله حق جهاده % % فأذعن عاصيه وذل عنيده % % 36(@)(@@) % منصور اللواء سعيده % % وظلك خفاق الرواق مديده % % 37(@)(@@) % مرهوب الغرار حديده % % وسيبك مسكوب النوال عقيده % % 38(@)(@@) % لم تنهل بالغيث ديمة % % ولا راق من زهر الرياض مجوده % % 39(@)(@@) % مسعى كل آمل غاية % % وأخلق من عصب الزمان جديده % % 40(@)(@@) % لك العيد الذي أنت عيده % % وفي الله ما تبديه أو ما تعيده % % PageV01P270 41(@)(@@) % المصلى والجنود روائح % % تغص بها أغواره ونجوده % % 42(@)(@@) % أبصرت منك النواظر ملأها % % جمالا تمد النيرات سعوده % % 43(@)(@@) % وآية نصر في حجاب مهابة % % تدافع عن دين الهدى من يكيده % % 44(@)(@@) % فلما قضيت النحر أقبلت راضيا % % عن الله تعلي ذكره وتشيده % % 45(@)(@@) % وأوردتنا من جود كفيك موردا % % يبرد غلات الظماء بروده % % 46(@)(@@) % وألبستنا الآلاء بيضا سوابغا % % فزادك منها الله ما تستزيده % % PageV01P271 البحر : طويل 1(@)(@@) % زمانك أفراح لدينا وأعياد % % فعيد ونيروز سعيد وميلاد % % 2(@)(@@) % تزورك أثناء الزمان كأنها % % عفاة ترجي راحتيك وقصاد % % 3(@)(@@) % فتهدي إلى كل مقالا يخصه % % فمنا لها در ومنهن أجياد % % 4(@)(@@) % لقد عم منك الرفد من جاء قاصدا % % نوالك حتى للمواسم إرفاد % % 5(@)(@@) % غصون المنى تدني إليك قطافها % % وللدهر إسعاف إليك وإسعاد % % 6(@)(@@) % تعلم من أخلاقك العدل في الورى % % فللعلم إعلام وللجود إيجاد % % 7(@)(@@) % إذا رمت صعبا أو طلبت ممنعا % % فجدك يدعو 
ms63	 بالصعاب فتنقاد % % 8(@)(@@) % مقامك حيث السحب هامية الندى % % مقيل لا صباح السرى فيه إخماد % % 9(@)(@@) % تؤمله الرواد إن أخلف الحيا % % وتنجعه الركبان إن نفد الزاد % % 10(@)(@@) % وتهوى قلوب المعتفين لظله % % فتعمل أقتاب إليه وأقتاد % % PageV01P272 11(@)(@@) % سللت حسام العضد والقطر واجف % % وللروع إبراق عليه وإرعاد % % 12(@)(@@) % وقدت إليها الجرد والنصر خافق % % يرق عليها والملائك أعداد % % 13(@)(@@) % فما عاقها عن نيلها القصد عائق % % ولا عزها يوما من الله إمداد % % 14(@)(@@) % وجاهدت أحزاب الضلالة جاهدا % % فلم يغنهم من حد سيفك ما كاد وا % % 15(@)(@@) % ولاذوا إلى السلم استلاما ورهبة % % وقد شارفوا ورد المنية أو كاد وا % % 16(@)(@@) % فألفت ما بين الظبا وجفونها % % وقد أوحشت منهم جفون وأغماد % % 17(@)(@@) % وأجممت حد السيف عن مهجاتهم % % وقد طال منهم في سؤالك ترداد % % 18(@)(@@) % وأحصن درع أيقنوا بدفاعه % % لبأسك إذعان إليه وإخلاد % % 19(@)(@@) % فمهدت بالسلم البلاد لأهلها % % فللأمن إصدار عليك وإيراد % % 20(@)(@@) % وأصبحت الأدراع وهي مدارع % % وأزراد أزرار الوغى وهي إبراد % % PageV01P273 21(@)(@@) % أيوسف حسب القول فيك وإن علا % % قصور فما إن يحصر القطر تعداد % % 22(@)(@@) % توقلت أهضاب الجلال وأحرزت % % لك الحمد آباء كرام وأجداد % % 23(@)(@@) % وأملاك صدق إن عرا الناس رائع % % من الخطب جدوا أو عرت أزمة جادوا % % 24(@)(@@) % أجاروا رسول الله بدأ ولم تزل % % مآثرهم في الدين تسمو وتزداد % % 25(@)(@@) % مقاماتهم بيض وحمر قبابهم % % يرف بها هدي ويشرق إرشاد % % 26(@)(@@) % تحف بها الجرد العتاق ودونها % % لباغي القرى نار تشب وإيقاد % % 27(@)(@@) % وأندية ينتابها الباس والندى % % فيخلف إيعاد وينجز ميعاد % % 28(@)(@@) % ولم تأل سبقا في اقتفاء سبيلهم % % فصلت كما صالوا وسدت كما سادوا % % 29(@)(@@) % حديث له في المشرقين رواية % % وعند العوالي السمهرية إسناد % % 30(@)(@@) % فدم تذعر الأعداء في شعفاتها % % وتنقض ما شدوا وتعمر ما شادوا % % PageV01P274 31(@)(@@) % ويهنيك نيروز سعيد قد انقضى % % أتتك على آثاره منه أعداد % % 32(@)(@@) % أتاك على علم بجودك في الورى % % فأمل من جدواك ما هو يعتاد % % 33(@)(@@) % وما هو إلا رائد لبشائر % % فلا زال يحدوها إليك ويقتاد % % PageV01P275 البحر : بسيط تام 1(@)(@@) % قلبي وسمعي في 
ms64	 شغل عن الفند % % فأقصر اللوم عني اليوم أو فزد % % 2(@)(@@) % قد كنت أصغي لما توحي إلي به % % لو كان قلبي قبل اليوم طوع يدي % % 3(@)(@@) % وكم كتمت وأسررت الهوى زمنا % % طي الجوانح حتى خانني جلدي % % 4(@)(@@) % وشيمة النفس إن أخفت سريرتها % % بدت شواهدها يوما على الجسد % % 5(@)(@@) % قالوا الهوى بعد بعد الدار منتكث % % فقلت هذا قياس غير مطرد % % 6(@)(@@) % سلوا عن الحب من قلبي مجربه % % فما المقلد يوما مثل مجتهد % % 7(@)(@@) % سقى الإله زمان الوصل صوب حيا % % جون الربابة لا نزر ولا ثمد % % 8(@)(@@) % وجاد ربعا على أكناف كاظمة % % كنا به من لذيذ العيش في رغد % % 9(@)(@@) % والكأس تجلى عروسا في منصتها % % والروض يرفل في أثوابه الجدد % % 10(@)(@@) % والسحب تبكي وثغر الزهر مبتسم % % والنرجس الغض ساه والغمام ند % % PageV01P276 11(@)(@@) % عهود أنس وأيام لنا انصرمت % % أخنى عليها الذي أخنى على لبد % % 12(@)(@@) % ما للزمان رمت نحوي نوائبه % % فأقصدتني بلا عقل ولا قود % % 13(@)(@@) % وسدد الدهر دوني كل شاحبة % % زرقاء أسمى شباها فلذة الكبد % % 14(@)(@@) % سطا علي وقد قل النصير وهل % % يرجى الغناء لدى كف بلا عضد % % 15(@)(@@) % وسار أبناء دهري في سيرته % % ويشبه الأب حقا منجب الولد % % 16(@)(@@) % تخذتهم عدة للدهر فانقلبوا % % وهم علي لدهري أعظم العدد % % 17(@)(@@) % من منصف بين آمالي وغايتها % % فقد تجاوزن في مطلي على الأمد % % 18(@)(@@) % كأنني لم أنط بالنجم من هممي % % ولم أسر في المعالي سير متئد % % 19(@)(@@) % ولا اتخذت من الأنصار لي وزرا % % فكان يوسف بعد الله معتمد % % 20(@)(@@) % ولا نظمت على لباته مدحي % % نظم الحلي على لبات ذي غيد % % PageV01P277 21(@)(@@) % خليفة من صميم العرب دوحته % % فيها انتهى المجد مستوفى ومنها بدي % % 22(@)(@@) % في كفه لبني الآمال بحر ندى % % عذب المذاقة هين غير ذي زبد % % 23(@)(@@) % لو أن راحته فاضت أناملها % % في الغيث لم يقتصر يوما على بلد % % 24(@)(@@) % إن أبهم الخطب أذكى في دجنته % % رأيا يفرق بين الغي والرشد % % 25(@)(@@) % وإن عدا الدهر أبدى من أسرته % % وكفه رأي حيران وريى صد % % 26(@)(@@) % وإن نظرت 
ms65	 إلى لألاء غرته % % يوم الهياج رأيت الشمس في الأسد % % 27(@)(@@) % حتى إذا محص الله القلوب بها % % ولا دفاع لحكم الواحد الصمد % % 28(@)(@@) % وقفت والروع قد ماجت جوانبه % % بحيث لا والد يلوي على ولد % % 29(@)(@@) % وصلت يوم التقى الجمعان منصلتا % % كالصقر في السرب أو كالليث في النقد % % 30(@)(@@) % فأصبح دين الله لا تخفى معالمه % % وأصبح الملك مرفوعا على عمد % % PageV01P278 31(@)(@@) % إن الحروب سجال طالما وهبت % % في اليوم فرصتها واسترجعت لغد % % 32(@)(@@) % لا يغرر الروم ما نالوا وما فعلوا % % فإن ذلك إملاء إلى أمد % % 33(@)(@@) % فللقلوب من الغماء منصرف % % بما تقدم في بدر وفي أحد % % 34(@)(@@) % وإن دون طلاب الثأر أسد وغى % % من قومك الغر أو آبائك النجد % % 35(@)(@@) % قد أقلعوا كل مشحوذ الغرار إلى % % شن الغوار وسلوا كل ذي ميد % % 36(@)(@@) % والعزم باد وصنع الله مرتقب % % والفتح منتظر إن لم يحن فقد % % 37(@)(@@) % وعادة النصر لا تستبط مقدمها % % إن لم توافك في سبت ففي أحد % % 38(@)(@@) % وهاكها من بنات العرب ساحرة % % هيفاء تختال بين الدل والغيد % % 39(@)(@@) % ولست يوما على شعر بمقتصر % % ولا بأبيات منظوم بمنفرد % % 40(@)(@@) % وإنما أنا روض والعلوم له % % غيث فأي جنى إن شئته تجد % % PageV01P279 41(@)(@@) % بقيت في ظل ملك غير منصرم % % مصاحب غير محصور إلى أمد % % PageV01P280 البحر : متقارب تام 1(@)(@@) % ألحظك أم سيف عمرو أعيدا % % لقد جند الحسن فيك الجنودا % % 2(@)(@@) % تبدى محياك تحت الدجى % % فخر العواذل طرا سجودا % % 3(@)(@@) % أناشدك الله في مغرم % % أحلت عليه الجفا والصدودا % % 4(@)(@@) % إذا هطلت سحب أجفانه % % نثرن على الخد درا فريدا % % 5(@)(@@) % فلو كنت تقبل مني الرشا % % لحليت جيدك منه عقودا % % 6(@)(@@) % ولو جدت بالقرب بعد النوى % % أعدت معناك خلقا جديدا % % 7(@)(@@) % فتدخلني للرضا جنة % % وتصلي حسودي نارا وقودا % % PageV01P281 البحر : طويل 1(@)(@@) % أدرها فوجه الصبح قد كاد أن يبدو % % وفي كل غصن ساجع غرد يشد % % 2(@)(@@) % وخذها على آس الرياض وورده % % فهذا عذار للرياض وذا خد % % 3(@)(@@) % كأن سقيط الطل في الروض والصبا % % تهاداه طفل والخزامى له مهد % % 4(@)(@@) % كأن 
ms66	 لطاف القضب من فوق وردها % % مراود تستشفي بها أعين رمد % % 5(@)(@@) % كأن نضير الغصن جيد منعم % % يرف من الزهر الجني به عقد % % 6(@)(@@) % كأن انسياب النهر بين ظلالها % % حسام صقيل والظلال له عمد % % 7(@)(@@) % كأن الصبا عند الهبوب تحية % % بطيبها تختص أندلس الهند % % 8(@)(@@) % فبادر إلى اللذات من قبل فوتها % % فمهما تولت ساعة ما لها رد % % PageV01P282 البحر : طويل 1(@)(@@) % نبا الجنب مني عن وثير مهاده % % وحالف مني الجفن طول سهاده % % 2(@)(@@) % ومما شجاني والشجون كثيرة % % ولا غرو أن يشقى أمرؤ ببعاده % % 3(@)(@@) % تذكرته فرخ القطاة فأسرعت % % دموعي تهمي ويلها لانفراده % % 4(@)(@@) % وما حال جسم ظاعن حال بينه % % قضاء جرى حتما وبين فؤاده % % 5(@)(@@) % إذا شئت أن أحظى إليه بنظرة % % تسكن ما أورى الجوى من زناده % % 6(@)(@@) % جعلت كتابي ناظري ولحظته % % بناظرة من طرسه ومداده % % 7(@)(@@) % سمي الأب الأحنى وأي وسيلة % % تخصك من قلبي بمحض وداده % % 8(@)(@@) % أعندك عبد الله علم بأنني % % رمى الصبر مني للأسى بقياده % % 9(@)(@@) % وقد كان يشفيني الخيال إذا سرى % % وكيف لجفني في الهوى برقاده % % 10(@)(@@) % تناءيت عن دار النعيم لشقوتي % % وأسكنني الرحمن شر بلاده % % PageV01P283 11(@)(@@) % بمنقطع الرمل الذي من ثوى به % % فقد بان في الدنيا ضلال ارتياده % % 12(@)(@@) % مجال لأفراس الرياح إذا جرت % % فليس بخال ساعة من طراده % % 13(@)(@@) % أعانيهما بحرين بحرا من العدا % % له ثبج من بيضه وصعاده % % 14(@)(@@) % وبحرا من الماء الأجاج تروعنا % % روائع من أهواله في اشتداده % % 15(@)(@@) % عسى الله يدني ساعة القرب واللقا % % ويجعل جهدي في سبيل جهاده % % PageV01P284 البحر : وافر تام 1(@)(@@) % أدرها بين مزمار وعود % % ودونك فاغتنم زمن السعود % % 2(@)(@@) % فبرد الروض مرقوم الحواشي % % ودر الطل منظوم العقود % % 3(@)(@@) % وجنح الليل مطوي النواحي % % وضوء الفجر منشور البنود % % 4(@)(@@) % وخذها والبلابل في خصام % % وجنح الصبح ملتهب الوقود % % 5(@)(@@) % عرائس في حلى الكاسات تجلى % % موردة الترائب والخدود % % 6(@)(@@) % خطبناها وكان الأنس مهرا % % وألحان القيان من الشهود % % 7(@)(@@) % شموسا كلما غربت ولاحت % % على الأفواه تطلع في الخرود % % 8(@)(@@) % وفاتنة اللحاظ إذا تثنت % % رأيت الغصن 
ms67	 يمرح في البرود % % 9(@)(@@) % غزالة ربرب ومهاة قفر % % تعود طرفها صيد الأسود % % 10(@)(@@) % فتمرضها بألحاظ مراض % % وتسهرها بأجفان رقود % % PageV01P285 11(@)(@@) % إذا ما استنطقت نغم المثاني % % ثنينا هزة قضب القدود % % 12(@)(@@) % حمدت يد الزمان علي لما % % نعمت بها على رغم الحسود % % 13(@)(@@) % أقول لصاحبي والراح تجري % % وورد الأنس مبذول الورود % % 14(@)(@@) % وقد ماست غصون البان سكرا % % من الأوراق في خضر البرود % % 15(@)(@@) % تهز يد النسيم الطل فيها % % فتحسبها ولائد في مهود % % 16(@)(@@) % وإن قام الغمام بها خطيبا % % ترى الإبريق يسرع في السجود % % 17(@)(@@) % جنان بينهن الحور تمشي % % أحقا هذه دار الخلود % % 18(@)(@@) % تمتع فالزمان لنا كفيل % % بإنجاز المؤمل والوعود % % 19(@)(@@) % فقد عاد الزمان اليوم عيدا % % وهز البشر أعطاف الوجود % % 20(@)(@@) % بأوبة يوسف رب الأيادي % % ومحي الدين من بعد الخمود % % PageV01P286 21(@)(@@) % جمال الملك مبتدع المعالي % % ثمال الخلق منتجع الوفود % % 22(@)(@@) % نمته من الخلائف آل نصر % % أولى الغايات من باس وجود % % 23(@)(@@) % ودان له الزمان فدام فيه % % قرير العين منصور الجنود % % PageV01P287 البحر : طويل 1(@)(@@) % ثنى الصعدة السمراء من لين قده % % وجرد من أجفانه سيف جده % % 2(@)(@@) % وأقبل في جيش من الحسن رائع % % ترى العرب العرباء من دون بنده % % 3(@)(@@) % فمن ثعل الزوراء لمحة طرفه % % ومن مضر الحمراء صفحة خده % % 4(@)(@@) % ولاحت له في حومة القلب فتكة % % تعجل نصر الله فيها لوعده % % 5(@)(@@) % فحكم سيف اللحظ في عسكر الهوى % % فكم مهجة مطلولة فوق حده % % 6(@)(@@) % وكم من فؤاد ضاع في مأزق الهوى % % فقيدا وقد أبلى بمبلغ جهده % % 7(@)(@@) % وأشكل فها موته من حياته % % فعمر في حكم الغرام لفقده % % 8(@)(@@) % بنفسي حجازي الجمال إذا انتمى % % تطأطأت العليا لعزة مجده % % 9(@)(@@) % تبسم عن در من السمط رائق % % تأنق صنع الله في نظم عقده % % 10(@)(@@) % ثناياه قد أبدت معالم بارق % % وأنفاسه أبدت نواسم نجده % % PageV01P288 11(@)(@@) % وأعطافه تبدو عليها إذا انثنى % % شمائل من بان الحجاز ورنده % % 12(@)(@@) % تفجر من عين الجمال بمورد % % تحوم القلوب إليهم من دون ورده % % 13(@)(@@) % يلوح على أزراره قمر الدجى % % ويمرح غصن البان في 
ms68	 طي برده % % 14(@)(@@) % ويختال أثناء الذؤابة هازئا % % كما اختال سيف في خمائل غمده % % 15(@)(@@) % لئن قلقت أعطافه في وشاحه % % فكم أقلقت قلب المشوق بوجده % % 16(@)(@@) % وإن كحل السحر المبين جفونه % % فكم كحلت طرف المعنى بسهده % % 17(@)(@@) % وقالوا عذار قلت لا بل صحيفة % % عقدت له فيها وثيقة وده % % 18(@)(@@) % فقبلت في ليل الذؤابة وجهه % % وعدت بذاك النور من ليل صده % % 19(@)(@@) % وعاطيته حمراء في لون أدمعي % % إذا سكبت ذوب العقيق لبعده % % 20(@)(@@) % وقلت لساقيها وللأنس طاعة % % تحكم في هزل الحديث وجده % % PageV01P289 21(@)(@@) % أدرها فرض الخد أخضله الحيا % % وحف طراز الأنس من حول ورده % % 22(@)(@@) % فناولها ممزوجة برضابه % % ولو أنني أنصفت قلت بشهده % % 23(@)(@@) % فلما بدت للراح فيه ارتياحة % % ومالت شمال للشمول بقده % % 24(@)(@@) % توسد أضغاث الرياحين وانثنى % % يغط غطيط الطفل من فوق مهده % % 25(@)(@@) % فبايعت سلطان العفاف ولم أجز % % على فكرتي إلا الوفاء بعهده % % 26(@)(@@) % أبا الشرف الأرضى تلطف بأنفس % % غزاها غرام أصبحت نهب جنده % % 27(@)(@@) % ترفق وعللها بأيسر نائل % % يحوط دماها كالشمال ورده % % 28(@)(@@) % وإن أنت لم تغفل فما أنت في الورى % % بأول مولى جار في حكم عبده % % PageV01P290 البحر : كامل تام 1(@)(@@) % الصبر إلا في هواك حميد % % الخطب صعب والمرام بعيد % % 2(@)(@@) % يا أيها القمر الحجازي الذي % % تجلى بغرته الدياجي السود % % 3(@)(@@) % وحدت شخصك في الفؤاد لعله % % ينجيه من نار الجوى التوحيد % % 4(@)(@@) % وجعلت حبك مذهبا وشريعة % % قلدته يا حبذا التقليد % % 5(@)(@@) % إن نالت الشهداء جنات العلى % % ولهم نعيم عندها وخلود % % 6(@)(@@) % فلقد شهدت بأن قربك جنة % % حقا وإني بالغرام شهيد % % 7(@)(@@) % يا من تشابه منه في ضعف القوى % % خصر وطرف ساحر وعهود % % 8(@)(@@) % جسمي ولحظك في السقام تشاركا % % والله يعلم أينا المفؤود % % 9(@)(@@) % إن كنت تنكر ما ألاقي في الهوى % % فالوجه قاض والدموع شهود % % 10(@)(@@) % أصبحت في شغل بحبك شاغل % % لا العذل ينهاني ولا التفنيد % % PageV01P291 11(@)(@@) % تهفو الصبا سحرا فأستجفي الصبا % % وأغص بالسلسال وهو برود % % 12(@)(@@) % وأميل عن ظل الأراكة ضاحيا % % ورواقها رحب الجناب مديد % % 13(@)(@@) % يا عهد عين 
ms69	 الدمع كم من لؤلؤ % % للدمع جدت به عساك تعود % % 14(@)(@@) % تسري نواسمك اللدان بليلة % % فيهزني شوق إليك شديد % % 15(@)(@@) % كم ساعة للأنس فيك قضيتها % % من نالها ما فاته مقصود % % 16(@)(@@) % ومجاذب ثني الذؤابة عابث % % تهفو بخوطته الصبا فيميد % % 17(@)(@@) % السقم مبثوث على لحظاته % % والسحر في أجفانه معقود % % 18(@)(@@) % نادمته وشربت فضل مدامه % % واللحظ من أكواسه معدود % % 19(@)(@@) % ولقد هممت بأن أروي غلة % % لجحيمها بين الضلوع وقود % % 20(@)(@@) % وأبث سرا في فؤادي دونه % % للكتم باب مرتج مسدود % % PageV01P292 21(@)(@@) % كم لؤلؤ نثر الحديث عقوده % % نظمت لشمل الود منه عقود % % 22(@)(@@) % ولئن تحامانا الرقيب فلم يرم % % عنا رقيب للعفاف عتيد % % 23(@)(@@) % لولا هواك أيا أبا الشرف الرضا % % ما كان عندي للوجود وجود % % 24(@)(@@) % إيه عميد الوحي غير مدافع % % قلبي بما يلقاه منك عميد % % 25(@)(@@) % إن بنت فاسمح لي برجع تحية % % أو غبت فابعث بالخيال يعود % % 26(@)(@@) % يا ابن الكرام الهاشميين الألى % % الباس طوع بنانهم والجود % % 27(@)(@@) % رفقا على مهج تملكها الهوى % % فالرفق من أخلاقكم معدود % % 28(@)(@@) % ولاك سلطان الجمال نفوسنا % % فاحكم بما ترضى فنحن عبيد % % PageV01P293 البحر : طويل 1(@)(@@) % لي الله من عنوان ملك مجدد % % تروح هبات الله نحوي وتعدي % % 2(@)(@@) % بناني أمير المسلمين محمد % % سمي النبي الهاشمي محمد % % 3(@)(@@) % وقد جيد الأملاك مني قلادة % % وكم زان حسن الجيد حسن المقلد % % 4(@)(@@) % ونوه في بحر الخلافة سعده % % فلا زال في سعد وعز مؤيد % % PageV01P294 البحر : كامل تام 1(@)(@@) % عجبا لوجد لا يلين شديده % % وغرام قلب شب فيه وقوده % % 2(@)(@@) % ولقد عهدت القلب وهو موحد % % فعلام يقضى في العذاب خلوده % % 3(@)(@@) % إتلاف نفسي في هواك حياتها % % وفناء قلبي في رضاك وجوده % % 4(@)(@@) % وإن استربت سلي شهود مدامعي % % قد صح من في وجنتيه شهوده % % 5(@)(@@) % هل تذكرين عهود أيام الحمى % % لله أيام الحمى وعهوده % % 6(@)(@@) % أيام وجه الدهر طلق والصبا % % لدن المعاطف يانع أملوده % % 7(@)(@@) % فاليوم عاد القرب منا في الهوى % % بعدا وصال على الوصال صدوده % % 8(@)(@@) % ولقد شجاني بارق متألق % % يشجى به صب الفؤاد عميده % % 9 
ms70	(@)(@@) % أورى بجنح الليل في سقط اللوى % % سقطا ورت خلل السحاب زنوده % % 10(@)(@@) % وهمى على طلل الأحبة ديمة % % فحسبت عيني عند ذاك تجوده % % PageV01P295 11(@)(@@) % وكأن نور جبين يوسف نوره % % وكأن ديمته الملثة جوده % % 12(@)(@@) % ملك أقام الحق يخفق ظله % % فالحق خفاق الرواق مديده % % 13(@)(@@) % وحباه رب العرش آية مفخر % % حكمت له أن الملوك عبيده % % 14(@)(@@) % وحمى الجزيرة حاملا أعباءها % % بلهام جيش لا يكت عديده % % 15(@)(@@) % وغدا بأسباب العلا متمسكا % % فيها فحفظ الله ليس يؤوده % % 16(@)(@@) % من كان أنصار النبي جدوده % % فملائك السبع الطباق جنوده % % 17(@)(@@) % ماست غصون رماحه وتفتحت % % بشقائق النصر العزيز بنوده % % 18(@)(@@) % وأعد أوزار الحروب صوافنا % % تمضي على عقبانهن أسوده % % 19(@)(@@) % من كل أجرد سابق عبل الشوى % % ما إن تحط عن الحروب لبوده % % 20(@)(@@) % يرمى به الغرض البعيد فينثني % % بطلابه كثب المزار بعيده % % PageV01P296 21(@)(@@) % ويكاد ينتعل الهلال إذا سرى % % ويقلد الشمس المنيرة جيده % % 22(@)(@@) % وقواضبا بيضا سقين دم العدا % % فبدا على صفحاتها توريده % % 23(@)(@@) % ومفاضة زغبا تضاعف نسجها % % حلقاء قدر نسجها داوده % % 24(@)(@@) % وحنية تحنو على سهم الردى % % فيصيب شالكة الرمي سديده % % 25(@)(@@) % أضحى الضلال بها يصوح نبته % % وأخضر من دين الحنيفة عوده % % 26(@)(@@) % أخليفة الرحمن والملك الذي % % تنميه من أقيال خزروج صيده % % 27(@)(@@) % ماذا ينمق في امتداحك مادح % % لا ينزف البحر الخضم وروده % % 28(@)(@@) % ما زهر روض الغور روضة الحيا % % وحنت عليه بروقه ورعوده % % 29(@)(@@) % وسرى سقيط الطل في أوراقه % % بردا كدر أسلمته عقدوه % % 30(@)(@@) % وكأنه في ضفة النهر انتشى % % وغدا يبوح بسره عربيده % % PageV01P297 31(@)(@@) % بجني ورد شج وجنته الندى % % أو سوسن شقت عليه بروده % % 32(@)(@@) % وتخال غصن البان فيه عابدا % % ما إن يريم ركوعه وسجوده % % 33(@)(@@) % بأنم من مسرى امتداح عاطر % % يهدى إلى نادي علاك فريده % % 34(@)(@@) % ألبست هذا الملك ثوب جلالة % % يبقى على مر الجديد جديده % % 35(@)(@@) % وعضدت دين الله بابن نصيره % % حتى سما فوق السماء عموده % % 36(@)(@@) % جاهدت دين الكفر حتى سمته % % خسفا ورام السلم منك عنيده % % 37(@)(@@) % وتبعت آثار النبي ميمما % % مما أمه صديقه 
ms71	 وشهيده % % 38(@)(@@) % قابلت شهر الصوم منك بما به % % ينهل من فضل الآلاء مزيده % % 39(@)(@@) % ووصلت تم الليل منه بيومه % % ذكرا يبلغه القبول صعوده % % 40(@)(@@) % وشرعت للصدقات أصفى مشرع % % يندى على حر الصدور بروده % % PageV01P298 41(@)(@@) % فجزاك بالأجر الجزيل صيامه % % وحباك بالنصر المؤزر عيده % % 42(@)(@@) % فاهنأ به في الدهر أسعد قابل % % طلعت بعز المسلمين سعوده % % 43(@)(@@) % لما مررت إلى مصلاه ضحى % % والترب يلثم أخمصيك صعيده % % 44(@)(@@) % قضيت من حق الشريعة مقصدا % % لزم الملوك الصالحين أكيده % % 45(@)(@@) % فاخلد ودم وانعم بسابع نعمة % % تترى وملك لا يثل مشيده % % 46(@)(@@) % لا زال ذكرك في البسيطة دائما % % يسري على كتد الزمان حميده % % 47(@)(@@) % من كاد ملكك من عدو يبتغي % % شرا فإن الله عنك يكيده % % PageV01P299 البحر : خفيف تام 1(@)(@@) % أنتم من مناسب الأمجاد % % موضع العقد من طلا الأجياد % % 2(@)(@@) % ولكم من مناصب الفخر أسماها % % وعز الندى وغر الأيادي % % 3(@)(@@) % يا لأيامهم وقد يبس العود % % وغالت شهباء سرح البلاد % % 4(@)(@@) % والتقى رائد الحجاز ونجران % % وسعد الأمحال في كل واد % % 5(@)(@@) % أنذر المنذر الأنام بجدواه % % وسح النعمان نعمى عتاد % % 6(@)(@@) % فحوار ترغو ونار تلظى % % وطهاة تشي وداع ينادي % % 7(@)(@@) % وحبا من مطارف وشي صنعا % % بها كالرياض غب العهاد % % 8(@)(@@) % معشر يجعل الضيوف أصدقاء % % كرما والأموال بعض الأعادي % % 9(@)(@@) % معشر يجعل الحسام على الطفل % % اعوذاذا والمهد ظهر الجواد % % 10(@)(@@) % خطباء الأقوال يوم جدال % % وكماة الأبطال يوم الجلاد % % PageV01P300 11(@)(@@) % يا لأيامهم وقد زلت % % الرجل وزالت شوامخ الأطواد % % 12(@)(@@) % فشبا صعدة بثغرة ذمر % % وغرارا مهند في هاد % % 13(@)(@@) % وصفاح تمضي وسمر تلظى % % تقدح النار في متون الصلاد % % 14(@)(@@) % ووجوه بسر وخيل ظماء % % كرعت في مناهل الأوراد % % 15(@)(@@) % وكماة تحمي مراودها السمر % % فتكوى بها عيون الجواد % % 16(@)(@@) % فكأن الرماح كانت ركازا % % وكأن الهيجاء يوم الميعاد % % 17(@)(@@) % أقبلوا إن نظرت قلت بدور % % حجبتها سحائب الأزراد % % 18(@)(@@) % عجبا كيف لا تسيل سيوف % % حملوا أنفسا على الأغماد % % 19(@)(@@) % تضرم النار في غدير دلاص % % وعزيز تألف الأضداد % % 20(@)(@@) % من كعمرو مفني البراجم والمدن % % وقد ألقحت حروب الشداد 
ms72	 % % PageV01P301 21(@)(@@) % معشر أورثوا الهداية عن هود % % فمن مهتد به أو هاد % % 22(@)(@@) % فلقد أنجبوك يا عمدة الحي % % ورب البيت الرفيع العماد % % 23(@)(@@) % ماجدا مفضلا شجاعا حليما % % واسع المنتدى كثير الرماد % % 24(@)(@@) % يا أبا بكر المؤمل للخطب % % المفدى وتحفة المرتاد % % 25(@)(@@) % في سبيل الإله مجد توارثت % % كريم الإصدار والإيراد % % 26(@)(@@) % في سبيل الإلاه أخلاقك اللاتي % % هي العذب في احتدام الجواد % % 27(@)(@@) % في سبل الإلاه علم ترويه % % ونقل مصحح الإسناد % % 28(@)(@@) % في سبيل الإلاه منك خلال % % تدر الشهب في حضيض الوهاد % % 29(@)(@@) % لي ثناء كما علمت هو الوشي % % وصفاء في فمي وفؤادي % % 30(@)(@@) % فلذا ما أحوك عضب امتداحي % % سابريا مسهم الأبراد % % PageV01P302 31(@)(@@) % مخجلا لفظه حلاوة معناه % % صحيح الأسباب والأوتاد % % 32(@)(@@) % ما الذي تحصر الممادح والحمد % % وقد جزت غاية التعداد % % 33(@)(@@) % فلو أني استنصرت إذ رمت شكريك % % وحمدي لسان قس إياد % % 34(@)(@@) % وجعلت النهار طرسي كيما % % أحصر الود والظلام مدادي % % 35(@)(@@) % نفذ الطرس والمداد ولما % % أحصي شكري ولا شرحت ودادي % % 36(@)(@@) % وإذا ما مدحت لست ببدع % % إن في البحر وقع كل ثماد % % PageV01P303 البحر : طويل 1(@)(@@) % مقامك مرفوع على عمد السعد % % وحمدك مسطور على صحف المجد % % 2(@)(@@) % وحبك أشهى في القلوب من المنى % % وذكرك أحلى في الشفاه من الشهد % % 3(@)(@@) % كرمت إلى أن كاد يسألك الحيا % % وصلت إلى أن هابك السيف في الغمد % % 4(@)(@@) % وجمع منك الله مفترق العلا % % وشتى المعاني الغر في في علم فرد % % 5(@)(@@) % وأحييت آثار الخلائف سابقا % % حياد المدى فيما تعيد وما تبدي % % 6(@)(@@) % ولا مثل شفاف الضياء بنيته % % على الطائر الميمون والطالع السعد % % 7(@)(@@) % توشح من زهر النجوم قلادة % % ومن فلق الإصباح أصبح في برد % % 8(@)(@@) % مقام الندى والباس والعدل والتقى % % ومستودع العلياء والشرف العد % % 9(@)(@@) % دحيت من الزليج صفحة أرضه % % بلونين مبيض الأديم ومسود % % 10(@)(@@) % كما رقم الكافور بالمسك والتقت % % ذوائب من شعر أثيث على خد % % PageV01P304 11(@)(@@) % وأرسلت فيه جدول الماء سائلا % % كما سل مصقول الغرارين من غمد % % 12(@)(@@) % تقابل بيتاه وقد أبرزتهما من % % الدين والدنيا علاك على 
ms73	 حد % % 13(@)(@@) % فألبست هذا حلة الملك والغنى % % وألبست هذا شملة النسك والزهد % % 14(@)(@@) % وكم عبرة أبديت تلعب بالنهى % % فتنحرف الأذهان منا عن القصد % % 15(@)(@@) % فكم عادة تختال تحت منصة % % معصفرة السربال مصقولة الخد % % 16(@)(@@) % من الصفر إلا أنها عربية % % إذا اجتليت فيها سمات بني سعد % % 17(@)(@@) % حبتها دمشق الشام كل زجاجة % % أرق من الشكوى وأصفى من الود % % 18(@)(@@) % رأينا به كرسي كسرى وتاجه % % تلاحظه عينا على قدم العهد % % 19(@)(@@) % وكم رامح للفرس فيها ونابل % % وراح تعاطيها مهفهفة القد % % 20(@)(@@) % ومن سرر مرفوعة وأرائك % % كما رقمت أيدي الغمام صبا نجد % % PageV01P305 21(@)(@@) % يذكر مرآها قلوب أولي النهى % % بما وعد الأبرار في جنة الخلد % % 22(@)(@@) % حدائق ديباج سقتها من الحيا % % سحائب أفكار مهنأة الورد % % 23(@)(@@) % فما شئته من نرجس وبنفسج % % وآس وسوسان نضير ومن ورد % % 24(@)(@@) % وهبت رياح النصر في جنباتها % % فأنشأن سحب العنبر الورد والند % % 25(@)(@@) % مطارد فرسان ومجرى سوابح % % ومكنس عزلان وغابة ذي لبد % % 26(@)(@@) % تكنفها عدل الخليفة يوسف % % فترعى الظباء العفر فيها مع الأسد % % 27(@)(@@) % إمام هدي من آل سعد نجاره % % ونصر الهدى ميراثه لبني سعد % % 28(@)(@@) % مآثره تلتاح في أفق العلا % % وآثاره تستن في سنن الرشد % % 29(@)(@@) % فتلحظ من أنواره سورة الضحى % % وتحفظ من آثاره سورة الحمد % % 30(@)(@@) % من النفر الوضاح السادة الأولى % % يغيثون في الجلى ويوفون بالعهد % % PageV01P306 31(@)(@@) % إذا حدثوا تروي الرواة حديثهم % % عن الأسمر الخطي والأبيض الهندي % % 32(@)(@@) % أناصر دين الله وابن نصيره % % على حين لا يغني نصير ولا يجدي % % 33(@)(@@) % طلعت على الدنيا بأيمن غرة % % أضاء بها نور السعادة في المهد % % 34(@)(@@) % وكم رصدت منا العيون طلوعها % % فحقق نصر الله في ذلك الرصد % % 35(@)(@@) % وقت بيتك المعمور من كل حادث % % عناية من يغني عن الآل والجند % % 36(@)(@@) % تهنأ به الأيام دانية الجنا % % وصافح به الآمال منظومة العقد % % 37(@)(@@) % ودونكها من بحر فكري جواهرا % % تقلد في نحر وتنظم في عقد % % 38(@)(@@) % يقوم بآفاق البلاد خطيبها % % يترجم عن حبي ويخبر عن ودي % % 39(@)(@@) % ركضت لها خيل البديهة جاهدا 
ms74	 % % وأسمعت آذان المعاني على بعد % % 40(@)(@@) % فجاءت وفي ألفاظها لفف الكرى % % سراعا وفي أجفانها سنة السهد % % PageV01P307 41(@)(@@) % تقول رواة الشعر عند سماعها % % ترى هل لهذا الند في الأرض من ند % % 42(@)(@@) % رعى الله قطرا أطعلعتك سماؤه % % وبورك في مولى كريم وفي عبد % % PageV01P308 البحر : طويل 1(@)(@@) % دعاها تشم آثار نجد ففي نجد % % هوى هاج منها ذكره كامن الوجد % % 2(@)(@@) % ولا تصرفاها عن ورود جمامه % % فكم شرقت بالريق في مورد الجهد % % 3(@)(@@) % يذيب ثراها الشوق لولا مدامع % % تحل عراها في المحاجر والخد % % 4(@)(@@) % وتصبو إلى عهد هنالك سالف % % فتبدي من الشوق المبرح ما تبدي % % 5(@)(@@) % حملن نشاوى من سلاف صبابة % % تميل بهم ميل المنعمة الملد % % 6(@)(@@) % إذا هب هفاف النسيم تساقطوا % % فكف إلى قلب وأخرى على خد % % 7(@)(@@) % نشدتكما بالله هل تبصرانها % % معالم محتها الغمائم من بعدي % % 8(@)(@@) % عفت غير سفع كالحمام جواثم % % وغير جدار مثل حاشية البرد % % 9(@)(@@) % وموقد نار يستطير رماده % % ونؤي كما دار السوار على الزند % % 10(@)(@@) % وغير ظباء في رباها كوانس % % تفيأن في أفيائها دوحة الزند % % PageV01P309 11(@)(@@) % قفوا نشتكي ما نلاقي من الهوى % % وننح على يوم الرحيل ونستعدي % % 12(@)(@@) % ونهد إلى الأجفان إثمد تربها % % فما اكتحلت من بعده بسوى السهد % % 13(@)(@@) % سنسأل عن سكانها نفس الصبا % % لعل نسيم الريح يخبر عن هند % % 14(@)(@@) % إذ العيش غض والشبيبة وارف % % جناها وشمل الحي منتظم العقد % % 15(@)(@@) % مفارق ما راع البياض سوادها % % وأفئدة لم تدر ما ألم الصد % % 16(@)(@@) % ووصل كأنا منه في سنة الكرى % % وعيش كأنا منه في جنة الخلد % % 17(@)(@@) % مرابع ألا في وعهد أحبتي % % سقى الله ذاك العهد منسكب العهد % % 18(@)(@@) % وجاد به من جود يوسف ساجم % % ملث همول دون برق ولا رعد % % 19(@)(@@) % وإن أحق الغيث أن يحيي الربا % % ويروي غمام صاب من منشىء المجد % % 20(@)(@@) % إمام هدى من آل سعد نجاره % % ونصر الهدى ميراثه لبني سعد % % PageV01P310 21(@)(@@) % مآثره تلتاح في صحف العلا % % وآثاره تستن في سنن الرشد % % 22(@)(@@) % إذا هم أمضى الله في الأرض حكمه % % وما 
ms75	 لقضاء الله في الأرض من رد % % 23(@)(@@) % أقول لركب ينتحي طرق السرى % % ويخبط في جنح من الليل مزبد % % 24(@)(@@) % تهادا مطاياه التهائم والربى % % ويرمي به غور الفلاة إلى نجد % % 25(@)(@@) % وقد أخلف الغيث السكوب ديارها % % وأفضى بها هزل السنين إلى جد % % 26(@)(@@) % ولم يبق منها الأزل غير حشاشة % % تنازعها اللاواء في العظم والجلد % % 27(@)(@@) % أريحوا فقد يممتم حضرة الندى % % وأوردتم في مورد الرفق والرفد % % 28(@)(@@) % بحيث بلوغ القصد ليس بنازح % % لراج ولا باب الرجاء بمنسد % % 29(@)(@@) % ولذتم من الدهر الظلوم بناصر % % يرد شباة الدهر مفلولة الحد % % 30(@)(@@) % به جمع الله القلوب على الهدى % % وأذهب ما تخفي الصدور من الحقد % % PageV01P311 31(@)(@@) % وأحيى رسوم الفضل وهي دوارس % % وأطلع من نور الهداية لمن يهدي % % 32(@)(@@) % فما روضة بالغور عاهدها الحيا % % وحلت حبا الأنواء في ذلك العقد % % 33(@)(@@) % وحجبها عن ناظري الشمس فانثنت % % تستر في ظل من الغيم ممتد % % 34(@)(@@) % وبث نسيم الروض فيها تحية % % قريبة عهد باجتياز على الهند % % 35(@)(@@) % وفض فتيت المسك في جنباتها % % فأرعف آناف الشقائق والورد % % 36(@)(@@) % بأعطر عرفا من أريج ثنائه % % إذا نشرت آثاره صحف الحمد % % 37(@)(@@) % أناصر دين الله وابن نصيره % % على حين لا يغني نصير ولا يجدي % % 38(@)(@@) % طلعت على الدنيا بأيمن غرة % % أضاء بها نور السعادة في المهد % % 39(@)(@@) % وكم رصدت منا العيون طلوعها % % فحقق نصر الله في ذلك الرصد % % 40(@)(@@) % ولما عرت هذه الجزيرة روعة % % وأصبح فيها الرعب ملتهب الوقد % % PageV01P312 41(@)(@@) % وأوجف خوف الكفر شم هضابها % % تداركت منها كل واه ومنهد % % 42(@)(@@) % هززت إلى إعزازها كل ذابل % % وقدت إلى إصراخها كل ذي لبد % % 43(@)(@@) % وشمت سيوف الحق والله ناصر % % وجهزت قبل الجيش جيشا من السعد % % 44(@)(@@) % وقلت لنفس العزم هبي وشمري % % وهذا أوان الشد في الله فاشتدي % % 45(@)(@@) % ولو لم تقد جيشا كفتك مهابة % % من الله تغني عن نصير وعن جند % % 46(@)(@@) % ولكن جنبت الجرد قبا بطونها % % فأقبلن أسرابا كمثل القطا تردي % % 47(@)(@@) % وما راع ملك الروم إلا طلوعها % % بوارق تدعى بالمطهمة الجرد % % 48(@)(@@) % وغابا 
ms76	 من الخطي تحت ظلاله % % أسود من الأنصار تفتك بالأسد % % 49(@)(@@) % فلما استفز الذعر منك فؤاده % % وحقق معنى الفضل في ذلك الحد % % 50(@)(@@) % وما برحت والله ناصر دينه % % قضاياه في عكس لديك وفي طرد % % PageV01P313 51(@)(@@) % رمى بيد الإذعان للسلم رهبة % % وخاطب يستدعي رضاك ويستجدي % % 52(@)(@@) % فرحمى لحيى لم تجره فإنه % % فريد وإن أضحى من القوم في عد % % 53(@)(@@) % وأصرخ نصر الله دعوة صارخ % % طويت له تحت الدجى شقة البعد % % 54(@)(@@) % وبشرى لأرض قد سلكت بأهلها % % من السنن الأرضي على واضح القصد % % 55(@)(@@) % جمعت بها الأهواء بعد افتراقها % % فأصبح فيها الضد يأنس بالضد % % 56(@)(@@) % ويهنيك هذا العيد أسعد وافد % % أتاك مع النصر العزيز على وعد % % 57(@)(@@) % طوى البعد عن شوق وحط ركابه % % ببابك باب الجود في جملة الوفد % % 58(@)(@@) % فأوليتنا في ظله كل نعمة % % هي القطر لا يحصى بحصر ولا عد % % 59(@)(@@) % وفاضت بهتان الندى منك راحة % % هي البحر لا ينفك حينا عن المد % % 60(@)(@@) % ودونكها من بحر فكري لآلئا % % تقلد في نحر وتنظم في عقد % % PageV01P314 61(@)(@@) % يسير بها ركب النسيم إذا سرت % % سراع المطايا في ذميل وفي وخد % % 62(@)(@@) % تقوم بآفاق البلاد خطيبة % % تترجم عن حبي وتخبر عن ودي % % 63(@)(@@) % كأن العراقيين عند سماعها % % وقد غص حفل القوم نحل على شهد % % 64(@)(@@) % يقولون إن هبت من الحمد نفحة % % فليس لهذا الند في الأرض من ند % % 65(@)(@@) % سقى الله قطرا أطلعتك سماؤه % % وبورك في مولى كريم وفي عبد % % PageV01P315 البحر : طويل 1(@)(@@) % قفا فاسألا في ساحة الأجدع الفرد % % معالم محتها الغمائم من بعد % % 2(@)(@@) % وجرت عليها الراسيات ذيولها % % على أنها تزداد طيبا على البعد % % 3(@)(@@) % وعوجا عليها فاسألا عن أنيسها % % وإن كان تسآل المعالم لا يجدي % % 4(@)(@@) % ولكنها نفس تجيش ونفثة % % تورح من بث وتطفىء من وجد % % 5(@)(@@) % مرابع ألا في وعهد أحبتي % % سقى الله ذاك العهد منسكب العهد % % 6(@)(@@) % وجاد به من جود كف محمد % % ملث همول دون برق ولا رعد % % 7(@)(@@) % وإن أحق الغيث أن يروي الثرى % % لغيث زكي صاب من 
ms77	 منشأ المجد % % 8(@)(@@) % إمام هدى من آل سعد نجاره % % ونصر الهدى ميراثه لبني سعد % % 9(@)(@@) % غمام ندى جاد البلاد فأصبحت % % تجرر ذيل الخصب والعيشة الرعد % % 10(@)(@@) % وفرع زكي من أصول كريمة % % حكاها كما قد الشراك من الجلد % % PageV01P316 11(@)(@@) % فتلحظ من أنواره سورة الضحى % % وتحفظ من آثاره سورة الحمد % % 12(@)(@@) % من النفر الوضاح والسادة الألى % % يغيثون في الجلى ويوفون بالعهد % % 13(@)(@@) % محمد قد أحييت دين محمد % % وأنجزت من نصر الهدى سابق الوعد % % 14(@)(@@) % طلعت على الدنيا بأيمن غرة % % أضاء بها نور السعادة في المهد % % 15(@)(@@) % وكم رصدت منا العيون طلوعها % % فحقق نصر الله في ذلك الرصد % % 16(@)(@@) % هنيئا لملك فاتحتك سعوده % % وعز على الأيام منتظم العقد % % 17(@)(@@) % وعقدة ملك كان ربك كالئا % % لها وأصل السعد يغني عن الجد % % 18(@)(@@) % جمعت بها الأهواء بعد افتراقها % % فقد كان فيها الضد يأنس بالضد % % 19(@)(@@) % أمولاي هذا الأمر جد وإنما % % يليق به من عامل الجد بالجد % % 20(@)(@@) % ودونكها من ناصح الجيب مخلص % % وصية صدق أعربت لك عن ود % % PageV01P317 21(@)(@@) % أفض في الرعايا العدل تحظ بحبها % % وحكم عليها الحق في الحل والعقد % % 22(@)(@@) % وما من يد إلا يد الله فوقها % % ومن شيم المولى التلطف بالعبد % % 23(@)(@@) % فكن لهم عينا على كل حادث % % وكن فيهم سمعا لدعوة مستعد % % 24(@)(@@) % وأنت ثمال الله فابسط نواله % % إذا بسط المحتاج راحة مستجد % % 25(@)(@@) % وأوجب لأرباب السوابق حقها % % ولا تمنع المعروف من لك من جند % % 26(@)(@@) % هم الحد في نحر العدو وهل ترى % % دفاعا لمن يلقى العدو بلا حد % % 27(@)(@@) % وشاور أولي الشورى إذا عن معضل % % فمن أعمل الشورى فما ضل عن قصد % % 28(@)(@@) % وكن بكتاب الله تأتم دائما % % هو الحق والنور المبين الذي يهدي % % 29(@)(@@) % ألا لا يرع منا الزمان عصابة % % موكدة الميثاق مرهفة الحد % % 30(@)(@@) % تقابل أمر الله بالبشر والرضا % % وتلقى الذي ترضاه بالشكر والحمد % % PageV01P318 31(@)(@@) % وتخلف فيمن خلفته ملوكها % % برعي الذمام الحر والحفظ للعهد % % 32(@)(@@) % وما هي إلا أنفس مستعارة % % ولا بد يوما للعواري من رد % % 33(@)(@@) % غنينا 
ms78	 عن البحر الذي غاض بالحيا % % وعن كوكب العلياء بالقمر السعد % % 34(@)(@@) % حياة جناها الدهر من شجر الردى % % سريعا ووجدان تكون عن فقد % % 35(@)(@@) % وسيفان هذا سله الدهر ماضيا % % صقيلا وهذا رده الدهر في غمد % % 36(@)(@@) % وقت ملكك المحروس من كل حادث % % عناية من يغني عن الآل والجند % % 37(@)(@@) % ودونكها من بحر فكري جواهرا % % تقلد في نحر وتنظم في عقد % % 38(@)(@@) % ركضت بها خيل البديهة جاهدا % % وأسمعت آذان المعاني على بعد % % 39(@)(@@) % فجاءت وفي ألفاظها لفف الكرى % % سراعا وفي أجفانها سنة السهد % % 40(@)(@@) % وإني وإن أطنبت فيك لقاصر % % ومن ذا يطيق الرمل بالحصر والعد % % PageV01P319 البحر : طويل 1(@)(@@) % أهاجتك ذكرى من خليط ومعهد % % سمحت لها بالدمع في كل مشهد % % 2(@)(@@) % وعادك عيد من تذكر جيرة % % نأوا بالذي أسأرته من تجلد % % 3(@)(@@) % حنانيك من نفس شعاع ومهجة % % إذا لم يحن من بعدهم فكأن قد % % 4(@)(@@) % فكم دونهم من مهمه ومفازة % % وأثباج بحر زاخر اللج مزبد % % 5(@)(@@) % كأن لم يكن من قبل يومك عاشق % % ولا واقف بالربع وقفة مكمد % % 6(@)(@@) % ولا تسأل الأطلال بعد قطينها % % فعفت جوابا بعد طول تردد % % 7(@)(@@) % ومستنصر من دمعه غير ناصر % % ومستنجد من ضره غير منجد % % 8(@)(@@) % سوى عبرة تحدو ثقال سحابها % % إذا ما ونت ريح الزفير المصفد % % 9(@)(@@) % أسى النفس لا يقوى على رد فائت % % فإن شئت فلتقلل وإن شئت فازدد % % 10(@)(@@) % وما رجل الدنيا سوى متفطن % % لنكرائها ماض مضاء المهند % % PageV01P320 11(@)(@@) % إذا أقبلت بالخير لم تستفزه % % وإن هي ضلت لم يقدها بمقود % % 12(@)(@@) % فلا تقن ما يجني عليك ذهابه % % وإن كان معتدا به ضر معتد % % 13(@)(@@) % وخذ ما به جاد الزمان مسامحا % % ولا تترك يوم السرور إلى غد % % 14(@)(@@) % وسر في مراح الله مقتصر الخطا % % وكن لنوال الله منبسط اليد % % 15(@)(@@) % وإن راع دهر أو تنكر حادث % % فلذ بحمى من عامر بن محمد % % 16(@)(@@) % فتى الحي من هنتاتة جيرة الهدى % % وخيرة أصحاب النبي الموحد % % 17(@)(@@) % وكوكب أفق الغرب لم يبق بعده % % وبعد ابنه من كوكب متوقد % % 18 
ms79	(@)(@@) % رحيب مجال الفضل يكلف بالعلا % % فما هو بالمصغي لقول المفند % % 19(@)(@@) % ويطوي برود الملك فوق خلائق % % تناسب خلق الناسك المتزهد % % 20(@)(@@) % ومشتغل بالحزم يقدح زنده % % إذا اشتغل الأملاك باللهو والدد % % PageV01P321 21(@)(@@) % وضافي لباس المجد بالفضل مكتس % % وبالفخر معتم وبالحمد مرتد % % 22(@)(@@) % وتحتمل الركبان طيب حديثه % % فيأتيك بالأخبار من لم تزود % % 23(@)(@@) % ومرتقب الإقبال من كل وجهة % % وأمر وللصنع الجميل معود % % 24(@)(@@) % فوالله ما ندري أيمن نقية % % ترف عليه أم سعادة مولد % % 25(@)(@@) % تساس به الأقطار بعد ارتجاجها % % وتدنو له الأقطار بعد تبعد % % 26(@)(@@) % له جبل في ملتقى الهول عاصم % % يناول من يحتله النجم باليد % % 27(@)(@@) % ورأي إذا ما جهزت عنه راية % % كفى سعدها عن كل جند مجند % % 28(@)(@@) % يرى الأمر في أعجاز صدوره % % بعين البصير الألمعي المسدد % % 29(@)(@@) % أليس من القوم الذين علاهم % % مخلدة واستشهد الكتب تشهد % % 30(@)(@@) % مآثرهم في الدين غير خفية % % فهم كالنجوم الزاهرات لمهتد % % PageV01P322 31(@)(@@) % خلائف عبد المؤمن الملك الذي % % بسر من المهدي قد كان يهتدي % % 32(@)(@@) % ودوخ أكناف البسيطة بعده % % وأعلن بالتوحيد في كل مسجد % % 33(@)(@@) % وأبناؤه من بعده أعملوا الظبا % % وأمضوا سيوف الله في كل ملحد % % 34(@)(@@) % فسل إن أردت الأرك إذ غصت الربا % % بكل عميد بالرغام موسد % % 35(@)(@@) % فمن ذا له كالقوم إن شئت في ندى % % وباس وفي فضل وفي صدق مشهد % % 36(@)(@@) % لئن زينوا الدنيا بزهر وجوههم % % لقد زينوا بالذكر كل مجلد % % 37(@)(@@) % وأبقوا ثناء عاطرا فكأنما % % نسيم الصبا هبت على الزهر الندي % % 38(@)(@@) % أبا ثابت لا زال سعدك ثابتا % % وجودك يروي ورده غلة الصدى % % 39(@)(@@) % ولا زلت قطبا تستدير به العلا % % كما دارت الأفلاك حول المجدد % % 40(@)(@@) % رفعت بناء الملك لما تمايلت % % دعائمه فوق الأساس الموطد % % PageV01P323 41(@)(@@) % وأصرفته لما دعاك على النوى % % وواصل ترجيع النداء المردد % % 42(@)(@@) % بكل صقيل المتن سال خليجه % % ولكن حكم القين قال له اجمد % % 43(@)(@@) % يرى بنحول الحد شيمة عاشق % % ويكذب خداه بخد مورد % % 44(@)(@@) % وملتفت عن أزرق اللحظ قد حكى % % به العلق المحمر مقلة أرمد % % 45(@)(@@) % شكا 
ms80	 مرة الألحاظ في حومة الوغى % % فوافاه ملتف الغبار بأثمد % % 46(@)(@@) % وكل شهير العتق أشرف جيده % % وقام على ملمومة من زبرجد % % 47(@)(@@) % إذا ما تغنى بالصهيل مرجعا % % سمعت به صوت الغريض ومعبد % % 48(@)(@@) % تألق عن برق الدجنة كلما % % تبسم في قطع من الليل أربد % % 49(@)(@@) % وجددت نصر الجد في ابن ابنه اللذي % % رعيت له حق الذمام المؤكد % % 50(@)(@@) % ولم تأت بدعا في الوفاء وإنما % % شفعت الذي أسلفت في القوم من يد % % PageV01P324 51(@)(@@) % ويأبى لك المجد الذي أنت أهله % % على الدهر إلا أن تتمم ما بدي % % 52(@)(@@) % وعدت يجر الملك خلفك ذيله % % وفي حكمك العليا تروح وتغتدي % % 53(@)(@@) % ويعتد منك الملك والدين والورى % % بكافي الدواهي والهمام المؤيد % % 54(@)(@@) % وسوغك العقد السعيد مسرة % % وهنأك الأملاك أعذب مورد % % 55(@)(@@) % شددت بعهد الملك أزر مجادة % % توارثتها عن أوحد بعد أوحد % % 56(@)(@@) % ومثلك من يرمي بهمته العلا % % ويرفع أعلام الثناء المجدد % % 57(@)(@@) % ويحي من التوحيد رسما يعيده % % لخير اجتماع الشمل بعد تبدد % % 58(@)(@@) % عقيلة ملك فزت منها بطائل % % عزيز على النفس الكريم الممجد % % 59(@)(@@) % يزر عليها هوج الملك هالة % % يدور عليها كل غفر وفرقد % % 60(@)(@@) % فلو أنصفت فوق العيون ابتغوا لها % % طريقا فتمشي فوق صرح ممرد % % PageV01P325 61(@)(@@) % وفي نسبة الأشياء يظهر حسنها % % موحدة زفت لخير موحد % % 62(@)(@@) % فهنأك الله الإياب ولا انقضت % % سعودك تترى بين مثنى وموحد % % 63(@)(@@) % وقابل صنيع الله فيك بشكره % % وراقبه حال السر والجهر تحمد % % 64(@)(@@) % فيا هضبة العليا ويا مزنة الندى % % ويا مفخر الدنيا ويا قمر الندى % % 65(@)(@@) % ويا عدة الملك المريني كلما استجار به % % في الأمس واليوم والغد % % 66(@)(@@) % ركضت إليك الجرد أفلي بها الفلا % % وأدرع منها فرقدا بعد فرقد % % 67(@)(@@) % يطير بها الشوق الحثيث فينبري % % لمثواك منها كل سهم مسدد % % 68(@)(@@) % ولو هاج عزمي من سواك وصاح بي % % لآثرت سيما العاجز المتبلد % % 69(@)(@@) % وما كنت أرضى أن أنال ذريعة % % أكد لها نفسي وأكذب مقصدي % % 70(@)(@@) % وأقتحم الأخطار والأرض تلتظي % % وألتهم الأقطار والهول يغتدي % % PageV01P326 71(@)(@@) % ولو أن شمس الجو أو قمر 