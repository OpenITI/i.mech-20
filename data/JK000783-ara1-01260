ms1241	 الضحى عن ابن عباس | - رضي الله عنهما - قال : أفاض رسول الله - [ & ] - من | جمع أو عرفة وقثم بين يديه والفضل خلفه . |(@)(@@) 4752 - حدثنا محمد قال : نا عبيد الله قال : نا شريك عن | جابر عن عكرمة عن ابن عباس رضي الله عنهما - قال : سن رسول | الله - [ & ] - ركعتين في السفر وهما تمام والوتر في السفر | سنة . | PageV11P057 |(@)(@@) 4753 - حدثنا محمد بن عثمان قال : نا عبيد الله عن سفيان | عن أبي الزبير عن سعيد بن جبير عن ابن عباس - رضي الله عنهما - | قال : جمع رسول الله - [ & ] - بالمدينة بين الظهر والعصر | في غير خوف ولا مطر ، قلت لابن عباس : لأي شيء فعل ذلك ؟ قال : | لكي لا يحرج أمته . | PageV11P058 |(@)(@@) 4754 - حدثنا الحسن بن عرفة قال : نا هشيم عن أشعث بن | سوار عن أبي الزبير عن سعيد بن جبير عن ابن عباس - رضي الله | PageV11P059 | عنهما - قال : جمع رسول الله - [ & ] - بين الظهر والعصر | والمغرب والعشاء وهو مقيم بالمدينة من غير خوف ؛ لكي لا يحرج أمته . |(@)(@@) 4755 - حدثنا محمد بن عثمان قال : نا عبيد الله قال : نا عمر | ابن صهبان ، عن أبي الزبير ، عن سعيد بن جبير ، عن ابن عباس | - رضي الله عنهما - قال : كان النبي - [ & ] - في غزوة | يؤخر الظهر حتى يبرد ، ثم يصلي الظهر والعصر ، ثم لا ينزل حتى يغيب | الشفق ، ثم يصلي المغرب والعشاء . |(@)(@@) 4756 - حدثنا محمد بن عثمان قال : نا عبيد الله عن سفيان | عن سماك عن عكرمة عن ابن عباس - رضي الله عنهما - قال : مر علي | ناس من الأنصار يرمون حمامة فقال : نهى رسول الله - [ & ] - | أن يتخذ الروح غرضا . | PageV11P060 |(@)(@@) 4757 - حدثنا محمد بن عثمان قال : نا عبيد الله قال : نا سفيان | عن عبد الأعلى عن سعيد بن جبير عن ابن عباس - رضي الله عنهما - | قال : قال رسول الله - [ & ] - : ' من قال في القرآن بغير | PageV11P061 | علم فليتبوأ مقعده من النار ' . |(@)(@@) 4758 - حدثنا عبد الواحد بن غياث قال : نا أبو عوانة عن عبد | الأعلى عن سعيد بن جبير عن ابن عباس - رضي الله عنهما - قال : قال | رسول الله - [ & ] - : ' من 
ms1242	 كذب علي متعمدا - أو قال : | علي ما لم أقل - فليتبوأ مقعده من النار ' . |(@)(@@) 4759 - حدثنا القاسم بن وهب قال : نا الحسن بن عطية قال : نا | إسرائيل عن عبد الأعلى عن سعيد بن جبير عن ابن عباس - رضي | الله عنهما - أن النبي - [ & ] - كان يقرأ في الوتر في الركعة | الأولى ب ^ ( سبح اسم ربك الأعلى ) ^ والثانية ب ^ ( قل يا أيها | الكافرون ) ^ والثالثة ^ ( قل هو الله أحد ) ^ . | PageV11P062 |(@)(@@) 4760 - حدثنا محمد بن عثمان قال : نا عبيد الله قال : نا | إسرائيل عن أبي إسحاق عن سعيد بن جبير عن ابن عباس | - رضي الله عنهما - قال : كان النبي - [ & ] - يوتر ب | ^ ( سبح اسم ربك الأعلى ) ^ و ^ ( قل يا أيها الكافرون ) ^ و ^ ( قل هو | الله أحد ) ^ . |(@)(@@) 4761 - حدثنا محمد بن عثمان بن كرامة قال : نا عبيد الله عن | إسرائيل عن أبي إسحاق عن سعيد بن جبير عن ابن عباس - رضي | الله عنهما - قال : سئل : مثل من كنت حين توفي النبي - [ & ] - ؟ | PageV11P063 | قال : أنا يومئذ مختون . |(@)(@@) 4762 - حدثنا الحسين بن علويه البغدادي قال : نا حجاج بن | محمد قال : نا يونس بن أبي إسحاق عن أبيه عن سعيد بن جبير عن | ابن عباس - رضي الله عنهما - قال : ولد النبي - [ & ] - عام | الفيل . |(@)(@@) 4763 - حدثنا إبراهيم بن محمد بن سلمة قال : نا الحسن بن | PageV11P064 | عطية قال : نا ( . . . ) عن أبي إسحاق عن سعيد بن جبير عن ابن | عباس - رضي الله عنهما - قال : قال رسول الله - [ & ] - | ' ما من أيام العمل فيها خير من هذه الأيام ' يعني : أيام العشر - قيل : | ولا الجهاد في سبيل الله ؟ قال : ' ولا الجهاد في سبيل الله ' . |(@)(@@) 4764 - حدثنا أسيد بن عاصم قال : نا عامر بن إبراهيم قال : | نا يعقوب القمي عن جعفر بن أبي المغيرة عن سعيد بن جبير عن ابن | عباس - رضي الله عنهما - قال : خرج إلينا رسول الله - [ & ] - | وقد أظلتنا سحابة ونحن نطمع فيها فقال : ' إن الملك الذي | يسوقها أو يسوق هذه السحابة دخل علي فسلم علي فأخبرني أنه | PageV11P065 | يسوقها إلى وادي كذا ' . |(@)(@@) 4765 - حدثنا محمد بن عبد الملك 
ms1243	 قال : نا يحيى بن عمرو بن | مالك النكري عن أبيه عن أبي الجوزاء عن ابن عباس - رضي الله | عنهما - قال كان رسول الله - [ & ] - إذا انصرف من | صلاته قال : ' لا إله إلا الله وحده لا شريك له له الملك وله الحمد بيده | الخير وهو على كل شيء قدير اللهم لا مانع لما أعطيت ولا معطي لما منعت | ولا ينفع ذا الجد منك الجد ' . |(@)(@@) 4766 - حدثنا محمد بن عثمان قال : نا عبيد الله قال : نا | إسرائيل عن سماك عن [ 266 ] عكرمة عن ابن عباس - رضي الله | PageV11P066 | عنهما - قال قضى رسول الله - [ & ] - في الركاز | الخمس . |(@)(@@) 4767 - وبإسناده قال : قال رسول الله - [ & ] - : | ' الرؤيا الصالحة جزء من سبعين جزءا من النبوة ' . |(@)(@@) 4768 - حدثنا محمد بن عثمان قال : نا عبيد الله عن إسرائيل | عن سماك عن عكرمة عن ابن عباس - رضي الله عنهما - قال : قال | رسول الله - [ & ] - : ' لا يباشر الرجل الرجل ولا المرأة | المرأة ' . | PageV11P067 |(@)(@@) 4769 - وبإسناده قال : قيل : يا رسول الله - حين فرغ من بدر - : | عليك بالعير ليس دونها شيء . فناداه العباس وهو أسير في وثاقه . إنه لا | يصلح لك . قال : ' لم ؟ ' قال : لأن الله قد وعدك إحدى الطائفتين . وقد | أعطاك ما وعدك . |(@)(@@) 4770 - وبإسناده قال : قالوا : يا رسول الله أرأيت الذين ماتوا | وهم يشربون الخمر ؟ قال فنزلت : ^ ( ليس على الذين آمنوا وعملوا | الصالحات جناح فيما طعموا ) ^ . | PageV11P068 |(@)(@@) 4771 - وبإسناده قال : قيل : يا رسول الله ، أرأيت الذين ماتوا | وهم يصلون إلى بيت المقدس ؟ فأنزل الله - تبارك وتعالى - : ^ ( وما كان الله | ليضيع إيمانكم ) ^ قال عبيد الله : هذا بين الصلاة من الإيمان . |(@)(@@) 4772 - وبإسناده قال : قال رسول الله - [ & ] - : | ' لا عدوى ولا صفر ولا طيرة ولا هامة ' فقال رجل : يا رسول الله إن | الرجل ليأخذ الشاة الجرباء فيطرحها في مائة شاة فتجربها قال : فما | أجرب الأولى ' | PageV11P069 |(@)(@@) 4773 - وبإسناده أتى رسول الله - [ & ] - رجل | فجعل يثني عليه فقال رسول الله - [ & ] - : ' إن من البيان | سحرا وإن من الشعر حكما ' . | PageV11P070 |(@)(@@) 4774 - وبإسناده قال : أتي النبي - [ & ] - بماعز | ابن مالك فاعترف مرتين فقال : ' اذهبوا به ثم 
ms1244	 ردوه ' فاعترف مرتين حتى | اعترف أربعا فقال : ' اذهبوا فارجموه ' .(@)(@@) هكذا وجدته في كتابي عن عكرمة عن ابن عباس وإنما هو عن | سعيد بن جبير حديث ماعز بن مالك خاصة . |(@)(@@) 4775 - حدثنا محمد بن عثمان قال : نا عبيد الله قال : نا علي | ابن صالح عن سماك عن عكرمة عن ابن عباس - رضي الله عنهما - قال : | كانت قريظة والنضير وكان النضير أشرف من قريظة قال : فكان إذا قتل | PageV11P071 | رجل من قريظة رجلا من النضير قتل به ، وإذا قتل رجل من النضير رجلا | من قريظة قالوا : ادفعوه إلينا نقتلوه ، فقالوا بيننا وبينكم رسول | الله - [ & ] - فأتوه فنزلت : ^ ( وإن حكمت فاحكم بينهم | بالقسط ) ^ ، والقسط النفس بالنفس ثم نزلت : ^ ( أفحكم الجاهلية | يبغون ) ^ . |(@)(@@) 4776 - حدثنا محمد قال : نا عبيد الله عن سالم أبي حماد عن | السدي عن عكرمة عن ابن عباس - رضي الله عنهما - قال : قال رسول | الله - [ & ] - : ' أعطيت خمسا لم يعطها أحد قبلي من | الأنبياء : جعلت لي الأرض مسجدا وطهورا ولم يكن نبي من الأنبياء | PageV11P072 | يصلي حتى يبلغ محرابه ، ونصرت بالرعب مسيرة شهر يكون بين يدي | إلى المشركين فيقذف الله الرعب في قلوبهم وكان النبي يبعث إلى خاصة | قومه وبعثت أنا إلى الجن والإنس وكانت الأنبياء يعزلون الخمس | فتجيء النار فتأكله وأمرت أن أقسمها في فقراء أمتي ولم يبق نبي إلا قد | أعطي شفاعة وأخرت أنا شفاعتي لأمتي ' . |(@)(@@) 4777 - حدثنا سهل بن بحر قال : نا أبو نعيم قال : نا عصام بن | قدامة عن عكرمة عن ابن عباس - رضي الله عنهما - قال : قال رسول الله | - [ & ] - لنسائه : ' ليت شعري أيتكن صاحبة الجمل | الأديب تخرج فينبحها كلاب حوأب ، فيقتل عن يمينها وعن يسارها | قتلا كثيرا ثم تنجو بعدما كادت ' . | PageV11P073 |(@)(@@) 4778 - حدثنا يوسف بن موسى قال : نا عمرو بن طلحة قال : | نا أسباط بن نصر عن سماك عن عكرمة عن ابن عباس - رضي الله | عنهما - قال : كانتا ( امرأتان ضرتان ) بينهما سخط فرمت إحداهما | الأخرى فأسقطت غلام ميت قد نبت شعره فقضى رسول الله - [ & ] - | على العاقلة فقال عمها : يا رسول الله 
ms1245	 إنها قد أسقطت | غلام ميت قد نبت شعره . فقال أبو القاتل : إنه كاذب إنه والله ما | استهل ولا أكل ولا شرب فمثله يطل . فقال النبي - [ & ] - : | ' أسجع الجاهلية وكهانتها ؟ إن في الصبي غرة ' قال : وكان اسم إحداهما | مليكة والأخرى أم عطرف . | PageV11P074 |(@)(@@) 4779 - حدثنا عمر بن الخطاب وسهل بن بحر : قالا : نا عمرو | ابن حماد بن طلحة القناد قال : نا أسباط بن نصر عن سماك عن | عكرمة عن ابن عباس - رضي الله عنهما - قال : جاءت فأرة فأخذت | تجر الفتيلة ، قال : فذهبت الجارية تزجرها فقال نبي الله - [ & ] - : | ' دعيها ' قال : فجاءت بها فألقتها بين يدي رسول الله - [ & ] - | على الخمرة التي كان قاعدا عليها فأحرقت منها مثل موضع | درهم فقال : ' إذا نمتم فأطفئوا سرجكم فإن الشيطان يدل هذه على | هذا فتحرقكم ' . |(@)(@@) 4780 - حدثنا سهل بن بحر قال : نا يحيى بن عبد الحميد قال : | PageV11P075 | : نا سليمان بن بلال عن عمرو بن أبي عمرو ، عن عكرمة عن ابن | عباس - رضي الله عنهما - قال : شهد بدرا مع النبي - [ & ] - | عشرون رجلا من الموالي . |(@)(@@) 4781 - حدثنا سهل قال : نا سعيد بن محمد الجرمي قال : نا | أبو تميلة عن سعيد بن [ 267 ] واقد عن النحوي عن عكرمة عن ابن | عباس - رضي الله عنهما - قال شهد مع النبي - [ & ] - يوم | PageV11P076 | فتح مكة ألف من بني سليم . |(@)(@@) 4782 - حدثنا سهل قال : نا إبراهيم بن موسى الفراء قال : نا | عبد الله بن عصمة عن أبي الصباح عن أبي هاشم عن عكرمة عن | ابن عباس - رضي الله عنهما - أن النبي - [ & ] - قال : | ' ثلاثة ليس عليهم حساب فيما طعموا - إن شاء الله - إذا كان | حلال : الصائم والمتسحر والمرابط في سبيل الله ' . | PageV11P077 |(@)(@@) 4783 - حدثنا سهل قال : نا عبد الرحمن بن صالح قال : نا | يونس بن بكير عن ابن إسحاق عن ثور بن يزيد ، عن عكرمة عن | ابن عباس - رضي الله عنهما - أن النبي - [ & ] - لما وجه | ابن مسلمة وأصحابه إلى ابن الأشرف ليقتلوه مشى معهم إلى بقيع الغرقد ، | ثم وجههم ، ثم قال : ' انطلقوا على اسم الله اللهم أعنهم ' . |(@)(@@) 4784 - حدثنا 
ms1246	 سهل قال : نا محمد بن سليمان قال : نا إسماعيل | PageV11P078 | ابن زكريا مولى بني أسد عن محمد بن عون الخراساني عن عكرمة | عن ابن عباس - رضي الله عنهما - قال : قال رسول الله - [ & ] - : | ' ما من أحد إلا يلقى الله قد هم بخطيئة أو عملها إلا يحيى بن | زكريا فإنه لم يهم بها ولم يعملها ' . |(@)(@@) 4785 - حدثنا سهل قال : نا مسلم بن إبراهيم قال : نا حماد بن | PageV11P079 | سلمة قال : نا سماك بن حرب عن عكرمة عن ابن عباس - رضي الله | عنهما - أن عبدا [ السلام ] لما هاجر النبي - [ & ] - خشى | أهله أن يتبع النبي فقيدوه فكتب إلى النبي - [ & ] - إنك | قد علمت بإسلامي فسيرني أو خلصني ، فبعث النبي - [ & ] - | سبعة نفر على بعير وقال : ' لعلكم تجدون في داره من يعينكم | عليه ' فأعتقه النبي - [ & ] - . |(@)(@@) 4786 - حدثنا عقبة بن مكرم : قال : نا يزيد بن هارون : قال : أنا | حجاج بن أرطاة عن عطاء عن ابن عباس - رضي الله عنهما - أنه | كان لا يرى أن ينزل الأبطح فيقول : إنما هو منزل نزله أو أقام به | PageV11P080 | رسول الله - [ & ] - فيه عريشه . |(@)(@@) 4787 - حدثنا عبد الله بن سعيد قال : نا حفص بن غياث عن | حجاج عن عطاء عن ابن عباس - رضي الله عنهما - أن رسول الله | - [ & ] - قال : ' عمرة في رمضان تعدل حجة ' . |(@)(@@) 4788 - حدثنا عبد الله بن سعيد قال : نا حفص - يعني - ابن | غياث قال : نا حجاج عن عطاء عن ابن عباس - رضي الله | PageV11P081 | عنهما - أن رسول الله - [ & ] - أبصر شاة ميتة شاغرة | برجليها فقال : ' ما ضر أهل هذه لو انتفعوا بإهابها ' فدبغته سودة | وانتبذت فيه . |(@)(@@) 4789 - حدثنا محمد بن معاوية بن مالج قال : نا عباد بن العوام | قال : نا الحجاج بن أرطاة عن عطاء عن ابن عباس - رضي الله | عنهما - أن رسول الله - [ & ] - نهى عن بيع النخل سنتين | وثلاثة أن يشترى في رءوس النخل بكيل ، أو تباع الثمرة حتى يبدو | PageV11P082 | صلاحها . |(@)(@@) 4790 - حدثنا محمد بن معمر قال : نا عمرو بن صالح قال : نا | حجاج عن عطاء عن ابن عباس - رضي الله عنهما - قال كان 
ms1247	 النبي | - [ & ] - لا يرمي حتى تزول الشمس . |(@)(@@) 4791 - حدثنا الحسن بن خلف قال : نا إسحاق بن يوسف | PageV11P083 | عن شريك عن حجاج عن عطاء عن ابن عباس - رضي الله عنهما - | أن النبي - [ & ] - أهدى مائة بدنة مقلدة مجللة . |(@)(@@) 4792 - حدثنا الحسن بن خلف الواسطي الضرير قال : نا | إسحاق عن شريك عن حجاج عن عطاء عن ابن عباس أن | الصعب بن جثامة أهدى إلى رسول الله - [ & ] - وهو محرم | عجز حمار فردها ولم يأكلها . |(@)(@@) 4793 - حدثنا عبيد الله بن سعد قال : حدثني عمي قال : حدثني | PageV11P084 | أبي عن ابن إسحاق عن الحجاج عن عطاء عن ابن عباس - رضي | الله عنهما - قال : قبض النبي - [ & ] - وأنا - قال أبو | الحسن : أحسبه - وأنا ختين . |(@)(@@) 4794 - حدثنا عبد الله بن سعيد الأشج قال : نا عبد الله بن | إدريس عن الليث عن عطاء وطاوس عن ابن عباس - رضي الله عنهما - | قال : تمتع رسول الله وأبو بكر وعمر وأول من نهى عنها معاوية . |(@)(@@) 4795 - حدثنا محمد بن عبد الرحيم قال : نا كثير بن هشام عن | هشام أبي المقدام ، عن حبيب بن الشهيد ، عن عطاء عن ابن عباس | PageV11P085 | - رضي الله عنهما - أن رسول الله - [ & ] - قال : ' إن الله | خلق الجنة بيضاء ، وأحب شيء إلى الله البياض فليلبسه أحياؤكم | وكفنوا فيه موتاكم ' . |(@)(@@) 4796 - حدثنا الحسن بن الصباح قال : نا عبد المجيد بن | عبد العزيز بن أبي رواد عن مروان بن سالم قال : حدثني عبد الملك | عن عطاء عن ابن عباس - رضي الله عنهما - أن رسول الله - [ & ] - | PageV11P086 | قال : ' إن أول ما يجازى به العبد بعد موته أن يغفر لجميع | من اتبع جنازته ' . |(@)(@@) 4797 - حدثنا عبيد بن بخيت قال : نا عبد العزيز بن عبد الرحمن | عن خصيف عن عطاء عن ابن عباس - رضي الله عنهما - أن رجلا | قال : يا رسول الله إني ظاهرت من امرأتي ، فرأيت ساقها في القمر ، فواقعتها | قبل أن أكفر ، فقال له رسول الله - [ & ] - : ' كفر ولا تعد ' . | PageV11P087 |(@)(@@) 4798 - حدثنا خلاد بن أسلم قال : نا مروان بن شجاع قال : | نا خصيف [ 268 ] عن عطاء ومجاهد وعكرمة 
ms1248	 عن ابن عباس رفع | الحديث قال : ' إن الحائض والنفساء يقضيان المناسك كلها غير الطواف | بالبيت حتى تطهر ' . PageV11P088 |(@)(@@) 4799 - حدثنا محمد بن عثمان قال : نا عبيد الله بن موسى عن | حفص بن سليمان ، عن علقمة بن مرثد ، عن مجاهد ، عن ابن عباس | - رضي الله عنه - قال : قال رسول الله - [ & ] - : ' إن الله | ينهاكم عن التعري فاستحيوا من ملائكة الله الذين معكم الكرام | الكاتبين الذين لا يفارقونكم إلا عند إحدى ثلاث حالات : الغائط | والجنابة والغسل ، فإذا اغتسل أحدكم بالعراء فليستتر بثوبه أو بخذمة | حائط أو ببعيره ' . | PageV11P089 |(@)(@@) 4800 - حدثنا محمد بن عثمان بن كرامة قال : نا عبيد الله عن | إسرائيل عن أبي إسحاق عن مسلم البطين عن سعيد بن جبير عن ابن | عباس - رضي الله عنهما - أن النبي - [ & ] - كان يقرأ في | غداة يوم الجمعة ^ ( ألم تنزيل ) ^ و ^ ( هل أتى على الإنسان ) ^ . |(@)(@@) 4801 - حدثنا محمد بن عثمان قال : نا عبيد الله بن موسى عن | شريك عن ليث عن عطاء وطاوس عن ابن عباس - رضي الله | عنهما - قال : عجل رسول الله - [ & ] - أم سلمة ليلة جمع | PageV11P090 | بليل من المزدلفة قال ابن عباس : كنت معهم أيضا . |(@)(@@) 4802 - وحدثنا فضل بن سهل قال : نا أبو النضر قال : نا أبو | جعفر الرازي عن ليث عن عطاء عن ابن عباس - رضي الله | عنهما - قال : ربما رأيت النبي - [ & ] - والحمر تعترك بين | يديه - يعني - وهو يصلي . |(@)(@@) 4803 - حدثنا نصر بن علي قال : أنا عبد الأعلى قال : أنا | هشام عن عطاء عن ابن عباس - رضي الله عنهما - أن رجلا قال : يا | PageV11P091 | رسول الله رميت قبل أن أحلق ؟ قال : ' احلق ولا حرج ' . |(@)(@@) 4804 - حدثنا أزهر بن جميل قال : نا عبد الوهاب قال : نا | هشام عن عطاء ، عن ابن عباس - رضي الله عنهما - أن رسول | الله - [ & ] - بعثه في الثقل بليل من جمع مع أهله . |(@)(@@) 4805 - وحدثنا عبد الله بن معاوية قال : نا ثابت بن يزيد أبو زيد | قال : نا هلال بن خباب عن عكرمة عن ابن عباس - رضي الله عنهما - | PageV11P092 | أن رسول الله - [ & ] - كان يبيت الليالي 
ms1249	 المتتابعة طاويا | وأهله لا يجدون عشاء ، وكان عامة خبزهم خبز الشعير . |(@)(@@) 4806 - حدثنا محمد بن المثنى قال : نا أبو عامر قال : نا إبراهيم | ابن إسماعيل عن داود بن حصين عن عكرمة عن ابن عباس - رضي | الله عنهما - أن رسول الله - [ & ] - كان إذا بعث سرية | قال : ' اغزوا باسم الله ، قاتلوا من كفر بالله ، لا تغدروا ، ولا تمثلوا ولا | تقتلوا وليدا ، ولا أصحاب الصوامع ' . | PageV11P093 |(@)(@@) 4807 - حدثنا محمد بن المثنى قال : نا أبو عامر قال : نا إبراهيم | ابن إسماعيل عن داود بن حصين عن عكرمة عن ابن عباس - رضي | الله عنهما - أن رسول الله - [ & ] - كان يعلمهم من | الحمى والأوجاع كلها : ' بسم الله الكبير والحمد لله الكبير العظيم من | شر عرق نعار ومن شر حر النار ' . | PageV11P094 |(@)(@@) 4808 - حدثنا محمد بن المثنى قال : نا أبو عامر قال : نا أيوب | ابن سيار ، عن يعقوب بن زيد عن ابن عباس - رضي الله عنهما - | أن النبي - [ & ] - كان يقرأ في العيدين ب : ^ ( عم | يتساءلون ) ^ و ^ ( الشمس وضحاها ) ^ . |(@)(@@) 4809 - حدثنا عبد الرحمن بن عيسى بن ساسان قال : نا محمد | PageV11P095 | ابن عبد العزيز عن هشام بن عروة عن عطاء بن يسار عن ابن عباس | - رضي الله عنهما - قال : قال رسول الله - [ & ] - : | ' ثلاثة لا تفطر الصائم ' القيء ، والحجامة ، والاحتلام ' . |(@)(@@) 4810 - حدثنا أحمد بن الوليد الكرخي قال : نا عبد العزيز بن | عبد الله الأويسي قال : نا محمد بن مسلم عن عمرو بن دينار عن | PageV11P096 | عكرمة عن ابن عباس أن علي تزوج فاطمة من رسول الله - [ & ] - | ببدن من حديد . |(@)(@@) 4811 - حدثنا العباس بن محمد قال : نا محمد بن الصلت قال : | نا أبو كدينة قال : نا قابوس عن أبيه عن ابن عباس - رضي الله | عنهما - قال كان النبي - [ & ] - يقول : ' اللهم إني أعوذ | بك من الكسل والهرم وعذاب القبر ومن فتنة الصدر ' . | PageV11P097 |(@)(@@) 4812 - حدثنا محمد بن عبد الرحيم قال : نا حسن بن موسى | الأشيب قال : نا حماد بن سلمة عن يوسف بن عبد الله بن الحارث عن أبي | العالية ، عن عبد الله بن عباس - رضي الله 
ms1250	 عنهما - أن رسول الله - [ & ] - | كان إذا نزل به أمر قال : ' لا إله إلا الله الحليم العظيم لا | إله إلا الله رب السموات والأرض رب العرش الكريم ' ثم يدعو . |(@)(@@) 4813 - حدثنا محمد بن عبد الرحيم قال : نا عبيد بن جناد قال : | نا عبيد الله بن عمرو ، عن عبد الكريم ، عن عكرمة ، عن ابن عباس | PageV11P098 | - رضي الله عنهما - أن رسول الله - [ & ] - احتجم وأن | الحجام شكا إليه ضريبته فأرسل إلى مواليه أن يخففوا من ضريبته . |(@)(@@) 4814 - حدثنا محمد بن عبد الرحيم قال : نا زكريا بن عدي | قال : نا عبيد الله بن عمرو عن عبد الكريم عن عكرمة عن ابن عباس | - رضي الله عنهما - قال : قال أبو جهل : لئن رأيت محمدا يصلي لأطأن على | عنقه قال [ 269 ] فقيل : هو ذاك هو . فقال : ما أراه . قال : فقال رسول | الله - [ & ] - : ' لو فعل لأخذته الملائكة عيانا ، ولو أن | اليهود تمنوا الموت لماتوا ' . |(@)(@@) 4815 - حدثنا محمد بن عبد الرحيم قال : نا عبد الصمد بن | النعمان قال : نا همام عن قتادة عن عكرمة عن ابن عباس - رضي الله | عنهما - قال : كان بين آدم ونوح عشر قرون كلهم على شريعة من الحق | قال فلما بعث الله النبي وأنزل كتابه قال : فكان الناس أمة واحدة . | PageV11P099 |(@)(@@) 4816 - وحدثنا محمد بن عبد الرحيم قال : نا الحسن بن عيسى | قال : نا ابن المبارك قال : نا حسين بن عبد الله عن عكرمة عن ابن | عباس - رضي الله عنهما - قال : نهى رسول الله - [ & ] - | عن الدباء والمزفت وقال : ' لا تشربوا إلا في إناء وكي ' . |(@)(@@) 4817 - حدثنا محمد بن حرب قال : نا أبو سفيان الحميري قال : | نا هشيم عن ابن شبرمة عن عمار الدهني عن عبد الله بن شداد عن | ابن عباس - رضي الله عنهما - قال : حرمت الخمر قليلها وكثيرها | PageV11P100 | والمسكر من كل شراب . |(@)(@@) 4818 - حدثنا إسماعيل بن يعقوب قال : نا محمد بن موسى بن | أعين قال : حدثني أبي ، عن علي بن بذيمة أن سعيد بن جبير أخبره عن | PageV11P101 | قيس بن حبتر أن ابن عباس أتاه رجل يسأله 
ms1251	 عن النبيذ فقال : أول من | سأل رسول الله - [ & ] - عن النبيذ ناس قدموا من عبد | القيس فقالوا : يا رسول الله إنا بأرض ريف فقال : رسول الله - [ & ] - : | ' انتبذوا في الأسقية ولا تنتبذوا في النقير ولا الحنتم ' . |(@)(@@) 4819 - حدثنا خالد بن يوسف قال : حدثني أبي قال : نا | [ الضحاك عن عباد ] عن عكرمة عن ابن عباس - رضي الله عنهما - | أن رسول الله - [ & ] - قال : ' لعن الله اليهود حرمت | عليهم الشحوم فباعوها وأكلوا ثمنها ' . | PageV11P102 |(@)(@@) 4820 - وحدثنا خالد قال : حدثني أبي عن [ الضحاك عن | عباد ] عن عكرمة عن ابن عباس - رضي الله عنهما - أن رسول الله | - [ & ] - نهى عن ثمن الكلب وكسب الأمة . | PageV11P103 |(@)(@@) 4821 - حدثنا محمد بن حرب قال : نا عمير بن عمران قال : نا | ابن جريج عن عطاء عن ابن عباس - رضي الله عنهما - أن رسول الله | - [ & ] - قال : ' ليس من البر الصوم في السفر ' . | PageV11P104 |(@)(@@) 4822 - حدثنا محمد بن حرب قال : نا صلة بن سليمان عن | ابن جريج عن عطاء عن ابن عباس - رضي الله عنهما - قال : قال | رسول الله - [ & ] - : ' من حج عن والديه أو قضى | عنهما دينا بعد موتهما بعث مع الأبرار يوم القيامة ' . |(@)(@@) 4823 - حدثنا أبو داود سليمان بن سيف الحراني قال : نا | عبد الله بن واقد عن حنظلة عن طاوس عن ابن عباس - رضي الله | PageV11P105 | عنهما - قال : قال رسول الله - [ & ] - : ' [ قال الله | تعالى ] : ' إني لا أتقبل الصلاة إلا ممن تواضع بها لعظمتي ، ولم يستطل | على خلقي ولم يبت مصرا على معصيتي ، وقطع نهاره في ذكري ، ورحم | المسكين وابن السبيل والأرملة ، ورحم المصاب ذلك نوره كنور | الشمس أكلؤه بعزتي ، وأستحفظه ملائكتي ، وأجعل له في الظلمة نورا | وفي الجهالة حلما ، ومثله في خلقي كمثل الفردوس في الجنة ' . |(@)(@@) 4824 - حدثنا عبد الواحد بن غياث قال : نا عبد العزيز بن | PageV11P106 | مسلم قال : نا الأعمش عن سعيد بن جبير عن ابن عباس - رضي الله | عنه - قال : قال رسول الله - [ & ] - : ' استغنوا عن الناس | ولو بشوص سواك ' . |(@)(@@) 4825 - حدثنا محمد بن المثنى قال : نا يحيى بن حماد قال : نا أبو | عوانة عن 
ms1252	 سليمان عن مجاهد عن ابن عباس - رضي الله عنهما - قال : | PageV11P107 | كان رسول الله - [ & ] - يصلي نحو بيت المقدس والكعبة | بين يديه وبعدما هاجر إلى المدينة ستة عشر شهرا . |(@)(@@) 4826 - حدثنا محمد بن المثنى قال : نا يحيى بن حماد قال : نا أبو | عوانة عن الأعمش عن عبد الله بن عبد الله ، عن سعيد بن جبير عن | ابن عباس - رضي الله عنهما - قال : لما كان يوم الخميس وما يوم | الخميس ، ثم بكى ابن عباس في مرض رسول الله - [ & ] - | الذي قبض فيه قال : ' ائتوني بصحيفة ودواة حتى أكتب لكم | كتابا لا تضلوا بعده أبدا ' . |(@)(@@) 4827 - حدثنا سعيد بن يحيى قال : نا أبو القاسم بن أبي الزناد | PageV11P108 | قال : نا إبراهيم بن إسماعيل بن أبي حبيبة عن داود بن حصين عن | عكرمة عن ابن عباس - رضي الله عنهما - قال : نهى رسول الله - [ & ] - | عن طرق الجمل . |(@)(@@) 4828 - وحدثنا سعيد بن يحيى قال : نا أبو القاسم بن أبي الزناد | قال : حدثني إبراهيم بن إسماعيل عن داود بن حصين عن عكرمة عن | ابن عباس - رضي الله عنهما - أن النبي - [ & ] - نهى عن | الملاقيح والمضامين وحبل الحبلة . |(@)(@@) 4829 - وحدثنا سعيد بن يحيى قال : نا أبو القاسم بن أبي الزناد | قال : حدثني إبراهيم بن إسماعيل عن داود بن حصين عن عكرمة عن | PageV11P109 | عن ابن عباس - رضي الله عنهما - قال : أمر رسول الله - [ & ] - : | ' إذا ولغ الكلب في الإناء أن يغسل سبع مرار ' . |(@)(@@) 4830 - حدثنا سعيد قال : نا أبو القاسم بن أبي الزناد قال : نا | إبراهيم بن إسماعيل عن داود بن حصين عن عكرمة عن ابن عباس | - رضي الله عنهما - أن رجلا طلق امرأته فجاءت إلى النبي - [ & ] - | فقال : ' لا نفقة ولا سكنى ' . |(@)(@@) 4831 - حدثنا سعيد قال : نا أبو القاسم قال : نا إبراهيم عن | PageV11P110 | داود بن حصين عن عكرمة عن ابن عباس - رضي الله عنهما - [ 270 ] | أن النبي - [ & ] - أمر ضباعة أن تشترط في الحج وتقول : | إن محلي حيث حبستني . |(@)(@@) 4832 - حدثنا أحمد بن معلى الأدمي قال : نا جابر بن إسحاق | قال : نا سلام أبو المنذر 
ms1253	 عن عاصم عن أبي ظبيان عن ابن | عباس - رضي الله عنهما - أن جبريل - عليه السلام - أتى النبي في هيئة | رجل شاحب مسافر حتى وضع يده على ركبة النبي - [ & ] - | فقال : ما الإسلام ؟ قال : ' أن تشهد أن لا إله إلا الله وأن محمدا | رسول الله وإقام الصلاة وإيتاء الزكاة وصوم رمضان وحج البيت ' | قال : فإذا فعلت ذلك فقد أسلمت ؟ قال : ' نعم ' صدقت . قال : | PageV11P111 | فتعجبنا من سؤاله إياه وتصديقه إياه ثم قال : ما الإحسان ؟ قال رسول الله | - [ & ] - : ' تخشى الله كأنك تراه فإن لم تكن تراه فإنه | يراك ' قال : فإذا فعلت ذلك فقد أحسنت ؟ قال : ' نعم ' قال : صدقت . | قال : فأخبرني ما الإيمان ؟ قال : ' الإيمان بالله وملائكته وكتبه ورسله | واليوم الآخر والجنة والنار والبعث بعد الموت والقدر خيره وشره ' | قال : فإذا فعلت ذلك فقد آمنت . قال : ' نعم ' قال : صدقت قال : فمتى | الساعة ؟ قال : ' والذي نفسي بيده ما المسئول عنها بأعلم من السائل | ولكن لها أشراط إذا رأيت المرأة ولدت ربتها ، ورأيت الحفاة العراة | العالة - يعني العرب - ولوا الناس ' قال : صدقت ثم ولى فقال النبي | - [ & ] - : ' علي بالرجل ' فنظر فلم ير شيئا فقال النبي | - [ & ] - : ' تدرون من هذا ؟ ' قلنا : الله ورسوله أعلم . | قال : ' هذا جبريل جاء ليعلمكم دينكم ما جاء في صورة قط إلا | عرفته غير هذه المرة ' .(@)(@@) آخر الجزء الثامن والثلاثين والحمد لله حق حمده | وصلى الله على محمد نبيه . | PageV11P112 |(@)(@@) 4833 - أخبرنا محمد بن أيوب بن حبيب الرقي قال : نا أحمد بن | عمرو بن عبد الخالق البزار قال : نا يوسف بن موسى قال : نا عبد الله بن | نمير عن إسماعيل بن مسلم عن عمرو بن دينار عن طاوس عن ابن عباس | - رضي الله عنهما - قال : أتى النبي - [ & ] - رجل فقال : | إني ظاهرت من امرأتي ، ثم وقعت عليها قبل أن أكفر فقال رسول الله | - [ & ] - : ' ألم يقل الله تبارك وتعالى : ^ ( من قبل أن | يتماسا ) ^ قال : أعجبتني . قال : ' أمسك حتى تكفر ' .(@)(@@) وهذا الحديث لا نعلمه يروى عن ابن عباس بإسناد أحسن من هذا | PageV11P113 | الإسناد على أن إسماعيل بن مسلم قد تكلم 
ms1254	 فيه وروى عنه جماعة كثيرة | من أهل العلم وفي هذا الحديث من الفقه أن النبي - [ & ] - | لم يأمره إلا بكفارة واحدة . |(@)(@@) 4834 - حدثنا محمد بن هارون البغدادي أبو نشيط قال : نا أبو | المغيرة عبد القدوس بن الحجاج قال : نا سعيد بن بشير عن قتادة عن | عمرو بن دينار عن طاوس عن ابن عباس - رضي الله عنهما - قال : قال | رسول الله - [ & ] - : ' لا تقام الحدود في المساجد ولا | يقتل الوالد بالولد ' . | PageV11P114 |(@)(@@) 4835 - وحدثناه الحسن بن عرفة قال : نا عمر بن عبد الرحمن أبو | حفص الأبار عن إسماعيل بن مسلم عن عمرو بن دينار عن طاوس عن | ابن عباس عن النبي - [ & ] - بنحوه .(@)(@@) وهذا الحديث لا نعلمه يروى عن ابن عباس إلا من هذا الوجه بهذا | الإسناد وحديث قتادة لا نعلم حدث به إلا سعيد بن بشير عنه وإنما | ذكرناه عن إسماعيل بن مسلم وإن كان إسماعيل بن مسلم قد تكلم فيه | لأن حديث سعيد لم نحفظه إلا عن أبي المغيرة فأردنا أن نبين أن غيره | رواه . |(@)(@@) 4836 - حدثنا إبراهيم بن زياد الصائغ البغدادي قال : نا محمد | ابن عبد الله الأنصاري قال : نا إسماعيل بن مسلم عن عمرو بن دينار | عن طاوس عن ابن عباس - رضي الله عنهما - أن رسول الله - [ & ] - | خرج وفي يده قطعة من ذهب وقطعة من حرير فقال : ' ألا | إن هذين حرام على ذكور أمتي حل لإناثهم ' . | PageV11P115(@)(@@) وهذا الحديث قد روي عن النبي - [ & ] - من غير | وجه فأسانيدها كلها التي تروى في ذلك متقاربة وقد استغنينا عن تبيين | إسماعيل بن مسلم لما قد تقدم ذكرنا له . |(@)(@@) 4837 - حدثنا الفضل بن سهل قال : نا يعقوب بن إبراهيم بن | سعد قال : نا أبي عن ابن إسحاق قال : حدثني محمد بن مسلم الزهري | عن طاوس اليماني قال : قلت لابن عباس : إن رسول الله - [ & ] - | قال : ' اغتسلوا يوم الجمعة واغسلوا رءوسكم ومسوا من | الطيب ' فقال ابن عباس : أما الطيب فلا أدري ، وأما الغسل فنعم .(@)(@@) وهذا الحديث بهذا اللفظ لا نعلم أحدا يرويه عن النبي - [ & ] - | إلا ابن عباس ولا 
ms1255	 نعلم أسند الزهري عن طاوس إلا حديثين | PageV11P116 | هذا أحدهما والآخر عن ابن عمر . |(@)(@@) 4838 - وحدثناه عمرو بن علي قال : نا أبو عاصم عن ابن | جريج قال : أخبرني إبراهيم بن ميسرة عن طاوس عن ابن عباس | - رضي الله عنهما - أنه ذكر له قول النبي - [ & ] - في | الغسل يوم الجمعة فقلت له : ويمس طيبا إن وجده ؟ قال : لا أعلمه . |(@)(@@) 4839 - وحدثنا عمرو بن علي قال : نا أبو عاصم قال : نا ابن | جريج قال : نا أبو الزبير أنه سمع طاوسا وعكرمة يخبران عن ابن | عباس - رضي الله عنهما - قال : جاءت ضباعة بنت الزبير إلى رسول الله | - [ & ] - فقالت : إني امرأة ثقيلة أريد الحج ، فكيف أهل ؟ | قال : ' أهلي واشترطي إن محلي حيث حبستني ' .(@)(@@) وهذا الحديث : قد روي عن ابن عباس من طرق ولا نعلم أسند | PageV11P117 | [ 271 ] أبو الزبير عن عكرمة عن ابن عباس غير هذا الحديث وإسناده | صحيح وقد روي عن ابن عباس من طرق كثيرة وروي عن ضباعة | وعن إسحاق عن غير من ذكرنا وعن جابر . |(@)(@@) 4840 - حدثنا يوسف بن موسى قال : نا إسحاق بن عيسى بن | الطباع قال : نا مالك بن أنس عن أبي الزبير عن طاوس عن ابن عباس | - رضي الله عنهما - أن رسول الله - [ & ] - قام من جوف | الليل إلى الصلاة فقال : اللهم لك الحمد أنت نور السموات والأرض ، | ولك الحمد أنت قيام السموات والأرض ، ولك الحمد أنت رب | السموات والأرض ومن فيهن ، ولك الحمد أنت الحق ، وقولك الحق | ولقاؤك الحق ، والجنة حق ، و النار حق ، والساعة حق ، لك أسلمت وبك | آمنت ، وعليك توكلت ، وإليك أنبت ، وبك خاصمت ، وإليك | حاكمت ، فاغفر لي ما قدمت وأخرت ، وأسررت وأعلنت ، أنت الله لا | إله إلا أنت ' . | PageV11P118(@)(@@) وهذا الحديث لا نعلمه يروى إلا عن ابن عباس وقد روي عن ابن | عباس من وجوه ولا نعلم رواه عن أبي الزبير إلا مالك . |(@)(@@) 4841 - حدثنا أحمد بن عبدة بن موسى قال : أنا عبد المجيد بن | عبد العزيز بن أبي رواد عن ابن جريج عن أبي الزبير ، عن طاوس | قال 
ms1256	 : سئل ابن عباس عن الإقعاء في السجود قال : لا بأس به ، قال طاوس : | إني لا أراه ، قال : قال ابن عباس : هو سنة .(@)(@@) وهذا الحديث لا نعلم أحدا يرويه بهذا اللفظ إلا ابن عباس ولا نعلم | PageV11P119 | له طريقا غير هذا الطريق من جهة تثبت لهذا اللفظ وقد روي نحو من | معناه : |(@)(@@) 4842 - حدثناه أبو بريد عمرو بن يزيد قال : نا روح بن عبادة | قال : نا زكريا بن إسحاق عن عبد الكريم أنه سمع طاوسا يقول كان | ابن عباس يقول : إن من السنة أن يضع أليتيه على عقبيه بين السجدتين | - يعني : الإقعاء - .(@)(@@) وهذا الحديث لا نعلم أحدا يحدث به عن عبد الكريم إلا زكريا بن | إسحاق وهو ثقة مكي . |(@)(@@) 4843 - حدثنا أبو كريب قال : نا أبو معاوية عن الحجاج | - يعني : ابن أرطاة - عن أبي الزبير ، عن طاوس ، عن ابن عباس | - رضي الله عنهما - قال : قال رسول الله - [ & ] - : | PageV11P120 | ' العمرى لمن أعمرها ، والرقبى لمن أرقبها ، والعائد في هبته كالعائد في | قيئه ' - وأحسبه قال : - ' ولا يحل لأحد أن يهب هبة ثم يعود فيها إلا | الوالد فيما يعطي الولد ' .(@)(@@) وهذا الحديث لا نعلمه يروى عن ابن عباس إلا من هذا الوجه بهذا | الإسناد وهذا الحديث قد رواه غير واحد عن طاوس عن ابن عباس أن | النبي - [ & ] - قال : ' لا يحل لأحد أن يهب هبة ثم يعود | PageV11P121 | فيها إلا الوالد فيما يعطي الولد ' .(@)(@@) وهذا الإسناد من حسان ما يروى في ذلك الحجاج مشهور إلا | أنه رجل فيه تدليس ولا نعلم أحدا ترك حديثه وكان حافظا وأبو الزبير | فحدث عنه جماعة كثيرة من أهل البصرة والكوفة ومكة والمدينة ولا | نعلم أحدا ترك حديثه وما فوق ذلك مستغن عن ذكرهم لجلالتهم . |(@)(@@) 4844 - حدثنا يوسف بن موسى قال : نا جرير بن عبد الحميد | عن منصور عن مجاهد عن طاوس عن ابن عباس - رضي الله عنهما - قال : | سافر رسول الله - [ & ] - في رمضان فصام حتى بلغ | عسفان ، ثم دعا بإناء من ماء نهارا ليريه الناس ثم أفطر . قال : فكان ابن | عباس يقول : صام 
ms1257	 رسول الله - [ & ] - في السفر وأفطر | فمن شاء صام ، ومن شاء أفطر .(@)(@@) وهذا الحديث قد روي عن ابن عباس وعن غير ابن عباس فاقتصرنا | على هذا الإسناد وهو إسناد صحيح عال . |(@)(@@) 4845 - حدثنا عمرو بن علي قال : نا يحيى بن سعيد عن الثوري | عن منصور عن مجاهد عن طاوس عن ابن عباس - رضي الله عنهما - أن | PageV11P122 | رسول الله - [ & ] - قال يوم الفتح : ' لا هجرة بعد اليوم | ولكن جهاد ونية ، وإذا استنفرتم فانفروا ' .(@)(@@) وهذا الإسناد بهذا اللفظ لا نعلم أحدا يرويه إلا ابن عباس وهذا | الإسناد أحسن إسناد يروى في ذلك عن ابن عباس . |(@)(@@) 4846 - حدثنا عمرو بن علي وإسحاق بن إبراهيم بن حبيب | قال : نا وكيع عن الأعمش قال : سمعت مجاهدا يحدث عن طاوس عن | ابن عباس - رضي الله عنهما - قال مر رسول الله - [ & ] - | على قبرين فقال : ' إنهما يعذبان وما يعذبان في كبير ، أما هذا | فكان يمشي بالنميمة ، وأما هذا فكان لا يستتره من بوله ، ثم دعا | بعسيب رطب فجعل على هذا واحدا وعلى هذا واحدا ، ثم قال : لعله | يخفف عنهما ما لم ييبسا ' . | PageV11P123 |(@)(@@) 4847 - وحدثنا يوسف بن موسى قال : نا جرير عن منصور | عن مجاهد عن ابن عباس ، ولم يذكر طاوس بين مجاهد وابن عباس . |(@)(@@) 4848 - وحدثناه الحسن بن يحيى قال : نا محمد بن جهضم قال : | نا إسماعيل بن جعفر عن سهيل بن أبي صالح عن حبيب بن حسان | PageV11P124 | عن مجاهد عن ابن عباس عن النبي - [ & ] - . |(@)(@@) 4849 - وحدثناه أحمد بن عبدة قال : أنا سفيان عن عمرو بن | دينار عن طاوس ولم يقل عن ابن عباس .(@)(@@) وإنما ذكرنا حديث سهيل عن حبيب بن حسان ؛ لأنه لم يسند | سهيل عن حبيب غير هذا الحديث وذكرنا حديث عمرو عن طاوس لئلا | يقول قائل إنه عن ابن عباس ، فبينا أنه ليس عن ابن عباس ، ولا نعلم أحدا | رواه عن الأعمش عن مجاهد عن طاوس عن ابن عباس إلا وكيع . |(@)(@@) 4850 - حدثنا محمد بن المثنى وعمرو بن علي قالا : نا يحيى بن | سعيد قال : [ 272 ] نا 
ms1258	 ابن جريج قال : نا الحسن بن مسلم عن طاوس | عن ابن عباس قال : كان رسول الله - [ & ] - وأبو بكر | وعمر وعثمان يصلون في العيدين قبل الخطبة .(@)(@@) وهذا الحديث يروى عن ابن عباس من غير هذا الوجه . وهذا | الإسناد أحسن إسناد يروى عن ابن عباس في ذلك وهو إسناد صحيح | PageV11P125 | ليس فيه اختلاف ، والحسن بن مسلم أحد الثقات المأمونين مكي . |(@)(@@) 4851 - حدثنا محمد بن عمر بن الهياج قال : نا قبيصة بن عقبة | قال : نا سفيان عن أسامة بن زيد عن الحسن بن مسلم بن يناق عن | طاوس عن ابن عباس - رضي الله عنهما - أن رسول الله - [ & ] - | سن في السفر ركعتين وفي الحضر أربعا ، قال ابن عباس : فكما | تصلوا بعدها وقبلها في الحضر ، فكذا صلوا قبلوا وبعدها في السفر .(@)(@@) وهو أسامة بن زيد الليثي وهو مدني ثقة ، والآخر أسامة بن زيد بن | أسلم ، وأسامة بن زيد الليثي أثبت من أسامة بن زيد . |(@)(@@) 4852 - وحدثناه الحسن بن عبد العزيز الجروي قال : نا بشر بن | بكر قال : حدثني الأوزاعي عن أسامة بن زيد الليثي عن الحسن بن | PageV11P126 | مسلم عن طاوس عن ابن عباس عن النبي - [ & ] - | بنحوه .(@)(@@) وهذا الحديث قد روي عن ابن عباس بنحو منه من غير هذا الوجه | وبغير هذا اللفظ ، وهذا الإسناد أحسن وأصح من الإسناد الآخر الذي | يروى عنه ولا نعلم أسند الأوزاعي عن أسامة بن زيد الليثي عن الحسن | ابن مسلم إلا هذا الحديث . |(@)(@@) 4853 - حدثنا يوسف بن موسى قال : نا جرير عن عطاء بن | السائب عن طاوس عن ابن عباس - رضي الله عنهما - رفعه إلى النبي | - [ & ] - قال : ' إن الطواف حول البيت مثل الصلاة | ولكنكم تتكلمون فيه ، فمن تكلم فيه فلا يتكلم إلا بخير ' . | PageV11P127(@)(@@) وهذا الحديث لا نعلم أحدا رواه عن النبي - [ & ] - | إلا ابن عباس ولا نعلم أسند عطاء بن السائب ، عن طاوس عن ابن عباس | غير هذا الحديث ورواه غير واحد موقوفا وأسنده جرير وفضيل بن عياض | ولا نعلم أحدا ترك حديث عطاء بن السائب لأن عطاء ثقة كوفي مشهور 
ms1259	 | ولكنه كان قد تغير فاضطرب في حديثه . |(@)(@@) 4854 - حدثنا محمد بن المثنى وعمرو بن علي قالا : نا أبو أحمد | قال : نا سفيان عن حنظلة عن طاوس عن ابن عباس - رضي الله | عنهما - قال : قال رسول الله - [ & ] - : ' المكيال مكيال | أهل مكة ، والميزان ميزان أهل المدينة ' . | PageV11P128(@)(@@) وهذا الحديث لا نعلم أحدا يرويه إلا حنظلة عن طاوس ولا نعلم | رواه إلا الثوري وقال : الفريابي عن الثوري عن حنظلة عن طاوس عن ابن | عمر وهذا الحديث رواه حنظلة عن طاوس وحنظلة ثقة ولم يروه عن | حنظلة إلا الثوري واختلفوا على الثوري فقال أبو أحمد : عن الثوري | عن حنظلة عن طاوس عن ابن عباس وقال الفريابي : عن الثوري عن | حنظلة عن طاوس عن ابن عمر ، ولم يروه غير الثوري وحنظلة مكي | صالح الحديث . |(@)(@@) 4855 - حدثنا سليمان بن سيف الحراني قال : نا عبد الله بن واقد | الحراني قال : نا حنظلة عن طاوس عن ابن عباس - رضي الله عنهما - | PageV11P129 | قال : قال رسول الله - [ & ] - : ' قال الله تبارك وتعالى : إنما | أتقبل الصلاة ممن تواضع بها لعظمتي ، ولم يستطل على خلقي ولم يبت | مصرا على معصيتي ، وقطع نهاره في ذكري ، ورحم المسكين وابن | السبيل والأرملة ، ورحم المصاب ، ذلك نوره كنور الشمس ، أكلؤه | بعزتي ، وأستحفظه ملائكتي ، أجعل له في الظلمة نورا ، وفي الجهالة | حلما ، ومثله في خلقي كمثل الفردوس في الجنة ' .(@)(@@) وهذا الحديث لا نعلمه يروى عن رسول الله - [ & ] - | بهذا اللفظ إلا من هذا الوجه بهذا الإسناد وعبد الله بن واقد لم | يكن بالحافظ ، وقد حدث عنه جماعة كثيرة من أهل العلم وعبد الله بن | واقد كان [ حراني عفيف ] وكان حافظا متفقها بقول أبي حنيفة وكان | يغلط فيلقن الصواب ، فلا يرجع وكان يكنى أبا قتادة وكان قاضيا . |(@)(@@) 4856 - حدثنا يوسف بن موسى قال : نا العلاء بن عبد الجبار | PageV11P130 | قال : نا محمد بن مسلم عن إبراهيم بن ميسرة عن طاوس عن ابن عباس | - رضي الله عنهما - عن النبي - [ & ] - قال : ' لم ير | للمتحابين مثل التزويج ' . |(@)(@@) 4857 - حدثنا زياد بن يحيى الحساني قال : نا 
ms1260	 مؤمل بن إسماعيل | قال : نا سفيان بن عيينة عن إبراهيم بن ميسرة عن طاوس عن ابن عباس | PageV11P131 | - رضي الله عنهما - قال : قال رسول الله - [ & ] - : ' لم ير | للمتحابين مثل التزويج ' . |(@)(@@) 4858 - وحدثناه أحمد بن أبان قال : نا سفيان بن عيينة عن | إبراهيم بن ميسرة عن طاوس عن النبي - [ & ] - ، ولم يقل : | عن ابن عباس .(@)(@@) والحديث إنما هو مشهور لمحمد بن مسلم عن إبراهيم عن طاوس | عن ابن عباس عن النبي - [ & ] - وحديث مؤمل لا نعلم | أحدا رواه عن الثوري غيره موصلا فيما اتصل بنا عن رجل ثقة .(@)(@@) قال : أبو بكر - يعني : للمتحابين - ، يعني : إذا أحب الرجل المرأة | فينبغي أن يزوج - . |(@)(@@) 4859 - حدثنا أحمد بن عبدة قال : أنا سفيان [ 273 ] بن عيينة | عن سليمان الأحول عن طاوس عن ابن عباس - رضي الله عنهما - أن | النبي - [ & ] - كان إذا تهجد من الليل قال : ' اللهم لك | الحمد أنت نور السموات و الأرض ومن فيهن ، ولك الحمد أنت قيم | السموات والأرض ومن فيهن ، ولك الحمد أنت الحق ، ووعدك الحق ، | PageV11P132 | ولقاؤك حق ، والجنة حق ، والساعة حق ، لك أسلمت ، وبك آمنت ، | وعليك توكلت ، وإليك أنبت ، وبك خاصمت ، وإليك حاكمت ، اللهم | اغفر لي ما قدمت وما أخرت ، وما أسررت وما أعلنت ، أنت المقدم | وأنت المؤخر ، لا إله إلا أنت ، ولا حول ولا قوة إلا بك ' .(@)(@@) وهذا الحديث إنما ذكرناه وإن كان أبو الزبير قد رواه عن طاوس | لأن لفظ حديث سليمان مخالف لذاك وفيه زيادة ليس في حديث أبي | الزبير . |(@)(@@) 4860 - حدثنا أحمد بن عبدة قال : أنا سفيان بن عيينة عن | سليمان الأحول عن طاوس عن ابن عباس - رضي الله عنهما - قال : كان | الناس ينصرفون من كل وجه فقال رسول الله - [ & ] - : | ' لا ينصرفن أحد حتى يكون آخر عهده بالبيت ' .(@)(@@) وهذا الحديث قد روي عن ابن عباس وعن ابن عمر بقريب منه ، | PageV11P133 | ورخص للنساء في حديث ابن عمر وحديث سليمان الأحول ذكرناه | واستغنينا به عما يروى في ذلك عن ابن عباس بغير هذا الإسناد . |(@)(@@) 4861 - حدثنا بشر بن آدم وأحمد بن عمرو 