ms2051	 أنزل الله عز وجل من السماء سفة من الريح إلا بمكيال ، ولا قطرة من الماء إلا بمكيال إلا يوم نوح ويوم عاد ، فإن الماء يوم نوح طغا على الخزان بأمر الله فلم يكن لهم عليه سبيل ، وإن الريح يوم عاد عتت على الخزان بأمر الله فلم يكن لهم عليها سبيل ) )(@)(@@) ( قط ) عن الأفراد ( حل كر ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19059 ) قال النبي :(@)(@@) | 30 ( ما أنزل الله عز وجل داء إلا وقد جعل له في PageV06P323 الأرض دواء ، علمه من علمه ، وجهله من جهله ) )(@)(@@) ( خط ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19060 ) قال النبي :(@)(@@) | 30 ( ما أنزل الله عز وجل آية إلا لها ظهر وبطن ، وكل حرف حد ، وكل حد مطلع ) )(@)(@@) أبو عبيد في فضائله وأبو نصر السجزي في الإبانة عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 19061 ) قال النبي :(@)(@@) | 30 ( ما أنزل الله داء إلا أنزل له شفاء ) )(@)(@@) أبو نعيم في الطب عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19062 ) قال النبي :(@)(@@) | 30 ( ما أنزل الله داء إلا وقد أنزل له شفاء ، وفي ألبان البقر شفاء من كل داء ) )(@)(@@) ( ك ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19063 ) قال النبي :(@)(@@) | 30 ( ما أنزل الله من داء إلا وقد أنزل معه شفاء ، علمه من علمه ، وجهله من جهله ) )(@)(@@) ( حم ) و الحكيم وابن السني وأبو نعيم في الطب ( ك هق ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19064 ) قال النبي :(@)(@@) | 30 ( ما أنزل الله تعالى آية فيها يا أيها الذين آمنوا إلا وعلي رأسها وأميرها ) )(@)(@@) ( حل ) عن ابن عباس رضي الله عنهما وقال : لم نكتبه إلا من حديث ابن أبي خيثمة والناس رووه موقوفا .(@)(@@)(@@)(@@) $ ( 19065 ) قال النبي :(@)(@@) | 30 ( ما أنزل الله علي آية أرجى من قوله : { ولسوف يعطيك ربك فترضى } ، فادخرتها لأمتي يوم القيامة ) )(@)(@@) الديلمي عن علي وفيه حرب بن سريج فيه ضعف والباقون ثقات .(@)(@@)(@@)(@@) $ ( 19066 ) قال النبي :(@)(@@) | 30 ( ما أنطاك الله فخذ ، ولا تسأل الناس شيئا ، فإن PageV06P324 اليد العليا هي المنطية ، واليد السفلى هي المنطاة ، وإن مال 
ms2052	 الله مسئول ومنطي ) )(@)(@@) ابن سعد ( طب ) عن عروة بن مجد بن عطية السعدي عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 19067 ) قال النبي :(@)(@@) | 30 ( ما أنعم الله عز وجل على عبد من نعمة وأسبغها عليه ، ثم جعل إليه شيئا من حوائج الناس فتبرم بها إلا وقد عرض تلك النعمة للزوال ) )(@)(@@) ابن النجار عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19068 ) قال النبي :(@)(@@) | 30 ( ما أنعم الله تعالى على عبد نعمة في أهل ومال وولد فرآه فأعجبه ، فقال إذا رأى ذالك : ما شاء الله لا قوة إلا بالله إلا رفع الله تعالى عنه كل آفة حتى تأتيه منيته ) )(@)(@@) ابن صصرى في أماليه وحسنه عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19069 ) قال النبي :(@)(@@) | 30 ( ما أنفق المؤمن من نفقة إلا أجر فيها إلا النفقة في هاذا التراب ) )(@)(@@) ( ط ) و أبو نعيم عن خباب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19070 ) قال النبي :(@)(@@) | 30 ( ما أنعم الله عز وجل على عبد نعمة فعلم أنها من الله إلا كتب الله تعالى له شكرها قبل أن يحمده عليها ، وما أذنب عبد ذنبا فندم عليه إلا كتب الله تعالى له مغفرته قبل أن يستغفره ، وما اشترى عبد ثوبا بدينار أو نصف دينار فلبسه فحمد الله عليه إلا لم يبلغ ركبته حتى يغفر له ) )(@)(@@) ( ك ) وتعقب ( عب ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 19071 ) قال النبي :(@)(@@) | 30 ( ما أنعم الله عز وجل على عبد نعمة إلا وهو يحب أن يرى أثرها عليه ) )(@)(@@) ( حم ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19072 ) قال النبي :(@)(@@) | 30 ( ما أنعم الله عز وجل على عبد نعمة إلا كثرت مؤونة الناس عليه ، فإن لم يتحمل مؤونتهم فقد عرض تلك النعمة لزوالها ) ال| خرائطي في مكارم الأخلاق PageV06P325 عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19073 ) قال النبي :(@)(@@) | 30 ( ما أنعم الله تعالى على عبد نعمة فحمد الله عليها إلا كان حمد الله تعالى أعظم منها كائنة ما كانت ) )(@)(@@) ( عب هب ) عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 19074 ) قال النبي :(@)(@@) | 30 ( ما أنعم الله عز وجل على عبد نعمة 
ms2053	 فقال : الحمد لله إلا وقد أدى شكرها ، فإن قالها الثانية جدد الله له ثوابها ، فإن قالها الثالثة غفر الله له ذنوبه ) )(@)(@@) الديلمي عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19075 ) قال النبي :(@)(@@) | 30 ( ما أنعم الله على عبد نعمة فقال الحمد لله رب العالمين إلا كان الذي أعطى أفضل مما أخذ ) )(@)(@@) ( ه ) و ابن السني ( طب هب ض ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19076 ) قال النبي :(@)(@@) | 30 ( ما أنعم الله تعالى على عبد من نعمة ، صغيرة ولا كبيرة ، فحمد الله عليها إلا كان قد أعطى خيرا مما أخذ ) )(@)(@@) هناد والحكيم عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 19077 ) قال النبي :(@)(@@) | 30 ( ما أنكر مسألتك يا حكيم ، إن هاذا المال خضر حلو ، وإنما هو ذالك أوساخ أيدي الناس فمن أخذها بسخاوة بورك له فيها ، ومن أخذها بإشراف نفس لم يبارك له فيها ، وكان كالآكل ولا يشبع ، وإن يد الله العليا ويد المعطي فوق المعطى ، وأسفل الأيدي يد المعطى ) )(@)(@@) ( ط حم طب ك ) عن حكيم بن حزام رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19078 ) قال النبي :(@)(@@) | 30 ( ما أنكرتم من زمانكم فيما غيرتم من أعمالكم ، فإن يك خيرا فواها واها ، وإن يك شرا فآها آها ) )(@)(@@) ( طب كر ) عن أبي الدرداء رضي الله عنه ، وقال ( كر ) : حديث غريب .(@)(@@)(@@)(@@) $ ( 19079 ) قال النبي :(@)(@@) | 30 ( ما أهبط الله عز وجل إلى الأرض منذ خلق آدم PageV06P326 إلى أن تقوم الساعة فتنة أعظم من فتنة الدجال ، وقد قلت فيه قولا لم يقله أحد قبلي : إنه آدم جعد ممسوح عين اليسار ، على عينه طفرة غليظة ، وإنه يبرىء الأكمة والأبرص ويقول : أنا ربكم ، فمن قال : ربي الله فلا فتنة عليه ، ومن قال : أنت ربي فقد افتتن ، يلبث فيكم ما شاء الله ثم ينزل عيسى بن مريم مصدقا بمحمد على ملته ، إماما مهديا ، وحكما عدلا فيقتل الدجال ) )(@)(@@) ( طب ) عن عبد الله بن مغفل رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19080 ) قال النبي :(@)(@@) | 30 ( ما أهلك الله عز وجل قوما ولا قرنا ، ولا أمة ، ولا أهل قرية بعذاب من السماء منذ أنزل التوراة على 
ms2054	 وجه الأرض غير القرية التي مسخت قردة ، ألم تر إلى قوله تعالى : { ولقد آتينا موسى الكتاب من بعد ما أهلكنا القرون الأولى } ) )(@)(@@) ( بز ) و ابن المنذر ( ك ) وابن مردويه عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19081 ) قال النبي :(@)(@@) | 30 ( ما أهل مهل قط ، ولا كبر مكبر قط إلا بشر بالجنة ) )(@)(@@) ابن النجار عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19082 ) قال النبي :(@)(@@) | 30 ( ما أوحي إلي أن أكون فاجرا ولا أن أجمع المال مكاثرا ، ولاكن أوحي إلي أن سبح بحمد ربك وكن من الساجدين ، واعبد ربك حتى يأتيك اليقين ) )(@)(@@) ( ك ) في تاريخه عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19083 ) قال النبي :(@)(@@) | 30 ( ما أوحي إلي أن أجمع المال وأكون من التاجرين ، ولاكن أوحي إلي أن سبح بحمد ربك وكن من الساجدين ، واعبد ربك حتى يأتيك اليقين ) )(@)(@@) ( حل ) عن أبي مسلم الخولاني مرسلا .(@)(@@)(@@)(@@) $ ( 19084 ) قال النبي :(@)(@@) | 30 ( ما بال اقوام يبلغني عنهم أن الله خلق السماوات PageV06P327 سبعا فاختار العليا منها فسكنها ، وأسكن سائر سمااواته من شاء من خلقه ، وخلق الأرضين سبعا فاختار العليا منها فأسكنها من شاء من خلقه ، ثم خلق الخلق فاختار من الخلق بني آدم ، ثم اختار بني آدم فاختار العرب ، ثم اختار العرب فاختار مضر ، ثم اختار مضر فاختار قريشا ، ثم اختار قريشا فاختار بني هاشم ، ثم اختار بني هاشم فاختارني ، فلم أزل خيارا من خيار ، ألا فمن أحب العرب فبحبي أحبهم ، ومن أبغض العرب فببغضي أبغضهم ) )(@)(@@) الحكيم ( طب كر ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19085 ) قال النبي :(@)(@@) | 30 ( ما بال أقوام يتحدثون فإذا رأوا الرجل من أهل بيتي قطعوا حديثهم ، والذي نفسي بيده لا يدخل قلب امرىء الإيمان حتى يحبهم لله ولقرابتهم مني ) )(@)(@@) ( ه ) و الروياني ( ك طب كر ) عن محمد بن كعب القرظي عن العباس بن عبد المطلب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19086 ) قال النبي :(@)(@@) | 30 ( ما بال أقوام يؤذون الأحياء بشتم الأموات ، ألا لا تؤذوا الأحياء بشتم الأموات ) )(@)(@@) ابن سعد عن هشام بن يحيى المخذومي عن 
ms2055	 شيخ له .(@)(@@)(@@)(@@) $ ( 19087 ) قال النبي :(@)(@@) | 30 ( ما بال أقوام يشترطون شروطا ليست في كتاب الله ، ما كان شرطا ليس في كتاب الله فمردود إلى كتاب الله ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19088 ) قال النبي :(@)(@@) | 30 ( ما بال القران ؟ أطلقا قرانكما فلا نذر إلا ما ابتغي به وجه الله ) )(@)(@@) ( بز ) عن عمرو بن شعيب عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 19089 ) قال النبي :(@)(@@) | 30 ( ما بال أقوام يسلمون بأيديهم كأنها أذناب خيل PageV06P328 شمس ؟ ، أما يكفي أحدهم أن يضع يده على فخذه يقول : السلام عليكم السلام عليكم ؟ ) )(@)(@@) ( ن ) عن جابر بن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19090 ) قال النبي :(@)(@@) | 30 ( ما بال أقوام نقضوا عهدي وضيعوا وصيتي في أبي بكر وزيري وأنيسي في الغار ؟ ، لا نالتهم شفاعتي ) )(@)(@@) ابن مردويه عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19091 ) قال النبي :(@)(@@) | 30 ( ما بال أقوام يقولون : إن رحمي لا تنفع ؟ ، بلى والله إن رحمي موصولة ، وإني فرطكم على الحوض ، فإذا جئت قام رجال فقال هاذا : يا رسول الله أنا فلان ، وقال هاذا : أنا فلان ، فأقول : قد عرفتكم ولاكنكم أحدثتم بعدي ورجعتم القهقرى ) )(@)(@@) ( ك ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19092 ) قال النبي :(@)(@@) | 30 ( ما بال أقوام يزعمون أن شفاعتي لا تنال أهل بيتي ، وأن شفاعتي تنال حاء وحكم ) )(@)(@@) ( طب ) عن أم هانىء رضي الله عنها .(@)(@@)(@@)(@@) $ ( 19093 ) قال النبي :(@)(@@) | 30 ( ما بال أقوام يزوجون عبيدهم إماءهم ثم يريدون أن يفرقوا بينهم ، ألا إنما يملك الطلاق من يأخذ بالساق ) )(@)(@@) ( هق ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19094 ) قال النبي :(@)(@@) | 30 ( ما بال رجال ينفرون عن هاذا الدين يمسون لصلاة العشاء الآخرة ) )(@)(@@) الخرائطي في مكارم الأخلاق عن عثمان الثقفي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19095 ) قال النبي :(@)(@@) | 30 ( ما بال رجال يسمعون النداء بالصلاة ثم يتخلفون ، لقد هممت أن أقيم الصلاة ثم لا يتخلف عنها أحد إلا أحرقت بيته ) )(@)(@@) ( عب ) عن عطاء مرسلا .(@)(@@)(@@)(@@) $ ( 19096 ) قال النبي :(@)(@@) | 30 ( ما بال رجال يؤذوني في العباس ، وإن عم PageV06P329 الرجل صنو أبيه ) )(@)(@@) ( كر ) عن عبد 
ms2056	 المطلب بن ربيعة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19097 ) قال النبي :(@)(@@) | 30 ( ما بال رجال يحضرون معنا الصلاة بغير طهور أولائك الذين يلبسون علينا صلاتنا ، من شهد معنا الصلاة فليحسن الطهور ) )(@)(@@) ( عب حم بز ) و البغوي والباوردي ( طب ) وأبو نعيم ( هب ) عن رجل من الصحابة سماه مؤمل بن إسماعيل الأعز قال أبو موسى : لا نعلم أحدا سماه غيره وهو أحد الثقات ، وقال البغوي عن الأعز رجل من بني غفار ، وعند ( بز ) عن الأعز المزني وهو خطأ .(@)(@@)(@@)(@@) $ ( 19098 ) قال النبي :(@)(@@) | 30 ( ما بال أقوام يصلون الصلاة معنا بغير طهور ، إنما يرددنا سوء طهورهم ) )(@)(@@) ( عب ) عن رجل من الصحابة .(@)(@@)(@@)(@@) $ ( 19099 ) قال النبي :(@)(@@) | 30 ( ما بر أباه من شد طرفه إليه ) )(@)(@@) الخرائطي في مساوىء الأخلاق ، وابن مردويه عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 19100 ) قال النبي :(@)(@@) | 30 ( ما بعث الله نبيا قط في قوم ثم يقبضه إلا جعل بعده فترة وملأ من تلك الفترة جهنم ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19101 ) قال النبي :(@)(@@) | 30 ( ما بعث الله نبيا قط إلا وفي أمته قدرية ومرجئة يشوشون عليه أمر أمته ، ألا وإن الله تعالى قد لعن القدرية والمرجئة على لسان سبعين نبيا ) )(@)(@@) ( طب ) عن معاذ ( عد ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19102 ) قال النبي :(@)(@@) | 30 ( ما بعث الله نبيا إلا وقد أمه بعض أمته ) )(@)(@@) أبو نعيم والديلمي من طريق عاصم بن كليب عن عبد الله بن الزبير عن عمر بن الخطاب عن أبي بكر الصديق رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19103 ) قال النبي :(@)(@@) | 30 ( ما بقي من كلام الأنبياء إلا قول الناس : إذا لم PageV06P330 تستح فاصنع ما شئت ) )(@)(@@) ابن منده عن أبي مسعود عن زيد عن أبي الحسن الأنصاري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19104 ) قال النبي :(@)(@@) | 30 ( ما بقي لأمتي من الدنيا إلا كمقدار الشمس إذا صليت العصر ، إن حوضي ما بين أيلة إلى المدينة ، فيه عدد النجوم من أقداح الذهب والفضة ) )(@)(@@) ( خط ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19105 ) قال النبي :(@)(@@) | 30 ( ما بين لابتيها أحد إلا 
ms2057	 يعلم أني نبي إلا كفرة الجن والإنس ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19106 ) قال النبي :(@)(@@) | 30 ( ما بين صلاة الفذ والجماعة خمس وعشرون درجة ) )(@)(@@) ( طب ) عن عبد الله بن زيد بن عاصم رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19107 ) قال النبي :(@)(@@) | 30 ( ما بين كل مصراعين من مصاريع الجنة سبع سنين ) )(@)(@@) أبو الشيخ في العظمة عن معاوية بن حيدة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19108 ) قال النبي :(@)(@@) | 30 ( ما بين مصلاي وبيتي روضة من رياض الجنة ) )(@)(@@) أبو نعيم في المعرفة عن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19109 ) قال النبي :(@)(@@) | 30 ( ما بين كذا وأحد حرام ) )(@)(@@) ( حم طب ض ) عن عبد الله بن سلام رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19110 ) قال النبي :(@)(@@) | 30 ( ما بين قبري ومنبري روضة من رياض الجنة ) )(@)(@@) ( حم ع ض ) عن أبي سعيد ( هب خط كر ) عن جابر بن عبد الله ( خط كر ) عن سعد بن أبي وقاص رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19111 ) قال النبي :(@)(@@) | 30 ( ما بين منبري إلى حجرتي روضة من رياض PageV06P331 الجنة ، وإن منبري على ترعة من ترع الجنة ) )(@)(@@) ( حم ) و الشاشي ( ع بز ض ) عن جابر ( حم طب ) عن عبد الله بن زيد المازني رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19112 ) قال النبي :(@)(@@) | 30 ( ما بين بيتي ومنبري روضة من رياض الجنة ، ومنبري على ترعة من ترع الجنة ) )(@)(@@) ( ع قط ) في الأفراد عن أبي بكر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19113 ) قال النبي :(@)(@@) | 30 ( ما بين قبري ومنبري روضة من رياض الجنة ، وإن منبري لعلى حوضي ) )(@)(@@) ( حل ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19114 ) قال النبي :(@)(@@) | 30 ( ما بين بيتي ومنبري روضة من رياض الجنة ، وقوائم منبري رواتب في الجنة ) )(@)(@@) ( هق ) عن سهل بن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19115 ) قال النبي :(@)(@@) | 30 ( ما تحت ظل السماء من إلاه يعبد من دون الله أعظم عند الله من هوى متبع ) )(@)(@@) ( طب حل ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19116 ) قال النبي :(@)(@@) | 30 ( ما تحت أديم السماء خلق شر من بربر ، ولأن أتصدق بعلاقة سوط في سبيل الله 
ms2058	 أحب إلي من أن أعتق رقبة من بربر ) )(@)(@@) نعيم بن حماد في الفتن عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19117 ) قال النبي :(@)(@@) | 30 ( ما تركت في الناس بعدي فتنة أضر على الرجال من النساء ) )(@)(@@) ( طب ) عن أسامة بن زيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19118 ) قال النبي :(@)(@@) | 30 ( ما تركت شيئا مما أمركم الله تعالى به إلا وقد أمرتكم به ، ولا شيئا مما نهاكم الله تعالى عنه إلا وقد نهيتكم عنه ، وإن الروح الامن قد ألقى في روعي أنه لن تموت نفس حتى تستوفي رزقها ، فأجملوا في الطلب ) )(@)(@@) الشاشي ( هق ) في المعرفة عن المطلب بن حنطة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19119 ) قال النبي :(@)(@@) | 30 ( ما ترى بيتي من المسجد ؟ ، فلأن أصلي في بيتي PageV06P332 أحب إلي من أن أصلي في المسجد إلا أن تكون صلاة مكتوبة ) )(@)(@@) ابن سعد عن عبد الله بن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19120 ) قال النبي :(@)(@@) | 30 ( ما تصدق الناس بصدقة أفضل من قول ) )(@)(@@) ابن النجار عن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19121 ) قال النبي :(@)(@@) | 30 ( ما تصدق أحد بصدقة من كسب طيب ولا يقبل الله إلا الطيب إلا وضعها حين يضعها في كف الرحمان ، وإن الله ليربي لأحدكم التمرة كما يربي أحدكم فلوه أو فصيله حتى تكون مثل أحد ) )(@)(@@) ( قط ) في الصفات عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19122 ) قال النبي :(@)(@@) | 30 ( ما تعدون الرقوب فيكم ؟ قالوا : الذي لا ولد له ، قال : ليس ذاك بالرقوب ، ولاكنه الرجل الذي لم يقدم من ولده شيئا ، فما تعدون الصرعة فيكم ؟ قال : الذي لا يصرعه الرجال ، قال : ليس بذالك ، ولاكنه الذي يملك نفسه عند الغضب ) )(@)(@@) ( حم م ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19123 ) قال النبي :(@)(@@) | 30 ( ما تعدون الشهيد فيكم ؟ قالوا : الذي يقتل في سبيل الله ، قال : إن شهداء أمتي إذن لقليل : القتل في سبيل الله شهادة ، والطاعون شهادة ، والنفساء شهادة ، والحرق شهادة ، والغرق شهادة ، والسل شهادة والبطن شهادة ) )(@)(@@) ( طب ) عن سل مان ( ط ) عن عبادة بن الصامت مثله غير أنه قال بدل السل 
ms2059	 والمرأة يقتلها ولدها جمعا شهادة .(@)(@@)(@@)(@@) $ ( 19124 ) قال النبي :(@)(@@) | 30 ( ما تعدون الشهيد فيكم ؟ قالوا : من قتل في سبيل الله ، قال : إن شهداء أمتي إذن لقليل : من قتل في سبيل الله فهو شهيد ، والمتردي شهيد ، والنفساء شهيد ، والغريق شهيد ، والسل شهيد ، والحريق شهيد ، والغريب شهيد ) )(@)(@@) ( طب ) عن عبد الملك بن هارون بن عنترة عن أبيه عن جده .(@)(@@) PageV06P333(@)(@@)(@@)(@@) $ ( 19125 ) قال النبي :(@)(@@) | 30 ( ما تعدون الشهيد فيكم ؟ قالوا : من قتل في سبيل الله ، قال : إن شهداء أمتي لقليل : القتل في سبيل الله شهادة ، والبطن شهادة ، والغرق شهادة ، والطاعون شهادة ، والنفساء شهادة ) )(@)(@@) ( حم ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19126 ) قال النبي :(@)(@@) | 30 ( ما تعدون الشهداء فيكم ؟ قالوا : من يقتل في سبيل الله ، قال : إن شهداء أمتي إذن لقليل : المقتول في سبيل الله شهيد ، والمرء يموت على فراشه في سبيل الله شهيد ، والمبطون شهيد ، واللديغ شهيد ، والغرق شهيد ، والشريق شهيد ، والذى يفترسه السبع شهيد ، والخار عن دابته شهيد ، وصاحب الهدم شهيد ، وصاحب ذات الجنب شهيد ، والنفساء يقتلها ولدها يجرها بسرره إلى الجنة ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19127 ) قال النبي :(@)(@@) | 30 ( ما تعلت النساء عن ولد ينبغي له أن يقول أنا أفضل من يحيى بن زكريا ، لم يحك في صدره خطيئة ولم يهم بها ) )(@)(@@) ( كر ) عن ضمرة بن حبيب مرسلا .(@)(@@)(@@)(@@) $ ( 19128 ) قال النبي :(@)(@@) | 30 ( ما تفرق قوم من مجلس لم يذكروا الله إلا تفرقوا عن مثل جيفة الحمار ، وكان عليهم حسرة يوم القيامة ) )(@)(@@) الخطيب عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19129 ) قال النبي :(@)(@@) | 30 ( ما تقبل منها يرفع ، ولولا ذالك لرأيتموها مثل الجبال يعني حصى الجمار ) )(@)(@@) ( طس قط ك هق ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19130 ) قال النبي :(@)(@@) | 30 ( ما تقدم رجل خطوة في سبيل الله عز وجل إلا اطلعن إليه الحور العين ، وإن تأخر خطوة استحيين منه ، واستترن منه ، فإن استشهد كانت أول ثجة من دمه كفارة لخطاياه ، وينزل إليه اثنتان من الحور العين PageV06P334 فينفضان التراب عن وجهه ويقولان : مرحبا 
ms2060	 فقدانا لك ، ويقول هو : مرحبا فقدان لكم ) )(@)(@@) ( هناد طب ) عن يزيد بن شجرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19131 ) قال النبي :(@)(@@) | 30 ( ما تقرب عبد إلى الله بأفضل مما خرج منه يعني القرآن ) )(@)(@@) مطين وابن منده عن زيد بن أرطاة عن جبير بن نوفل رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19132 ) قال النبي :(@)(@@) | 30 ( ما تقرب العباد إلى الله بشيء أحب إليه مما خرج منه ) )(@)(@@) ابن السني عن زيد بن أرطاة عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19133 ) قال النبي :(@)(@@) | 30 ( ما تقولون في قوم يدخل قاتلوهم الجنة وأتباعهم النار ؟ قالوا : يا رسول الله وإن عملوا بمثل أعمالهم ؟ قال : وإن عملوا بمثل أعمالهم يدخل هاؤلاء بما سبق لهم الجنة ، ويدخل هاؤلاء بما أحدثوا النار ) )(@)(@@) ( سمويه ) عن جندب البجلي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19134 ) قال النبي :(@)(@@) | 30 ( ما تقولون في رجل قتل في سبيل الله ؟ قالوا : الجنة ، قال : الجنة إن شاء الله ، قال : فما تقولون في رجل مات في سبيل الله ؟ قالوا : الله ورسوله أعلم ، قال : الجنة إن شاء الله ، فما تقولون في رجل مات ؟ فقام رجلان ذوا عدل فقالا : لا نعلم إلا خيرا ؟ قالوا : الله ورسوله أعلم ، قال : الجنة إن شاء الله ، فما تقولون في رجل مات ؟ فقام رجلان ذوا عدل فقالا : لا نعلم خيرا ؟ قالوا : النار ، قال : مذنب والله غفور رحيم ) )(@)(@@) ( طب ) عن كعب بن عجرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19135 ) قال النبي :(@)(@@) | 30 ( ما تقولون في الشارب والزاني والسارق ؟ هن فواحش وفيهن عقوبة ، وأسوأ السرقة الذي يسرق صلاته ، لا يتم ركوعها ولا سجودها ) )(@)(@@) ( عب ) و الشافعي ( هق ) عن النعمان بن مرة مرسلا .(@)(@@)(@@)(@@) $ ( 19136 ) قال النبي :(@)(@@) | 30 ( ما تلف مال في بر ولا بحر إلا بمنع الزكاة فحرزوا PageV06P335 أموالكم بالزكاة ، وداووا مرضاكم بالصدقة ، وارفعوا عنكم طوارق البلاء بالدعاء ، فإن الدعاء ينفع مما نزل ومما لم ينزل ، ما نزل يكشفه وما لم ينزل يحبسه ) )(@)(@@) ( طب ) وفي كتاب الدعاء ( كر ) عن عبادة بن الصامت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19137 ) قال النبي :(@)(@@) | 30 ( ما تواد اثنان في الإسلام فيفرق بينهما 