ms257	 خواهی %~% که دین و دل تبه کرد آن که دل در سیم و زر دارد(@)(@@) 12 جهان پر آتش آزست و بیچاره دل آنکس %~% که او اندر صمیم دل از آن آتش شرر دارد(@)(@@) 13 چه نوشی شربت نوشین و آخر ضربت هجران %~% همه رنجت هبا گردد همه کارت هدر دارد(@)(@@) 14 تو اندر وقت بخشیدن جهانی مختصر داری %~% جهان از روی بخشیدن ترا هم مختصر دارد(@)(@@) 15 سنایی را مسلم شد که گوید زهد پرمعنی %~% نداند قیمت نظمش هر آن کو گوش کر دارد PageV1P0472(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 اگر ذاتی تواند بود کز هستی توان دارد %~% من آن ذاتم که او از نیستی جان و روان دارد(@)(@@) 2 وگر هستی بود ممکن که کم از نیستی باشد %~% من آن هستم که آن از بی‌نشانیها نشان دارد(@)(@@) 3 وگر با نقطه‌ای وهمم کسی همبر بود او را %~% هزاران حجت قاطع که ابعاد چنان دارد(@)(@@) 4 ترازوی قیامت کو همی اعراض را سنجد %~% اگر باشم درین کفه دگر کفه گران دارد(@)(@@) 5 نگیرم هیچ چیز ار در آن کفه نشینم من %~% چون من از هیچ کم باشم گران کفه از آن دارد(@)(@@) 6 سبکتر کفه ذاتی گران‌تر کفه جانی %~% وگر با خود در آن کفه زمین و آسمان دارد(@)(@@) 7 منم خود کمتر از دانگی اگر بر سنجدم وزان %~% اگر دانگی بود ممکن که وزن این جهان دارد(@)(@@) 8 چو عقل کل کند فکرت ز اوصاف و ز ذات من %~% نه ذات من چنان باشد نه اوصافی چنان دارد(@)(@@) 9 فرو شستم ز لوح خویش نقش چونی و سانی %~% ز بیچونی و بیسانی روانم چون و سان دارد(@)(@@) 10 چنان گشتم که نشناسد کسم جز بی‌چگونه و چون %~% که ذات من نه تن دارد نه دل دارد نه جان دارد(@)(@@) 11 چه جای بی‌چگونه و چون که فوق اینست و این معنی %~% چه جای فوق و چه معنی نه این دارد نه 
ms258	 آن دارد(@)(@@) 12 دو صد برهان فزون دارد خرد بر نیستی من %~% بهر برهان که بنماید دو صد گونه بیان دارد(@)(@@) 13 هیولانی عدمهایم نه بیند عقل کلم زین %~% وگر چه کل افعال وفاها را عیان دارد(@)(@@) 14 هزاران مرتبت دانم ورای اینست کاین هر دو %~% یکی از بدکنان خیزد یکی از بدکنان دارد(@)(@@) 15 که داند تا چه چیزم من که باری من نمی‌دانم %~% وگر چه نیک نندیشم که ذات من چه سان دارد(@)(@@) 16 نگنجم در سخن پس من کجا در گنجد آنکس کو %~% به دستی در مکان دارد به دستی در زمان دارد(@)(@@) 17 چو اندر باردان من یکی ذره نمی‌گنجد %~% چگونه کل موجودات را در باردان دارد(@)(@@) 18 سخن را راه تنگ آمد نگنجد در سخن هرگز %~% اگر چه در فراخی ره چو دریای عمان دارد(@)(@@) 19 هر آنکو وصف خود گوید همی احوال خود خواهد %~% که برتر هست زان معنی اگر چه آن گمان دارد(@)(@@) 20 اگر بسیار بندیشی خرد باشد از او عاجز %~% کجا بر آسمان تاند شد آنکو نردبان دارد(@)(@@) 21 هر آنکس کو گمان دارد که بر کیوان رسد تیرش %~% گمان وی خطا باشد اگر زاهن کمان دارد(@)(@@) 22 خرد کمتر از آن باشد که او در وی کند منزل %~% مغیلان چیست تا سیمرغ در وی آشیان دارد(@)(@@) 23 حواشی و عا فکر خون پرورد خواهد شد %~% ازو بس خون برون آید کزو پر خون دهان دارد(@)(@@) 24 خرد را آفریند او کجا اندر خرد گنجد %~% بنان در خط نگنجد ار چه خط نقش از بنان دارد(@)(@@) 25 خرد چون جست یک چندیش باز آمد به نومیدی %~% چه چیز است اندرین دلها که دلها را نوان دارد(@)(@@) 26 ورای هست و نیست و گفت و خاموشی و اندیشه %~% ورای این و برتر زین هزاران ره مکان دارد(@)(@@) 27 برآمد از بحار قدس میغ نور بر جانها %~% همه تشنه دلانرا او به خود 
