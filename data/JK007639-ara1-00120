ms101	 المراعي وجليل واجب % 36(@)(@@) % أصنافه معدودة لا تحتضر % % 37(@)(@@) % وقائل صفها برمز واضح ، % فإنها من أكبر المصالح % 38(@)(@@) % والباقيات بعدك الصوالح ، % قلت : تمنع ، واعص كل كاشح % 39(@)(@@) % فهذه عدتها إذ تعتبر % % 40(@)(@@) % وإن ترد إيضاحها للسائل ، % بغير رمز للضمير شاغل % PageV01P346 41(@)(@@) % وحصر أسماها بعد كامل ، % فهي كشطر عدة المنازل % 42(@)(@@) % أو ما عدا المحذور من عد السور % % 43(@)(@@) % كركي وعناز وأنوق وتم ، % والوز واللغلغ والكي الهرم % 44(@)(@@) % ومرزم وشبطر ، إذا سلم ، % وحبرج ، وبالأنيسة انتظم % 45(@)(@@) % صوغ ، ونسر ، وعقاب قد كسر % % 46(@)(@@) % فستة محملهن الأرجل ، % ثم ثمان بالجناح تحمل % 47(@)(@@) % ولا اعتداد بسوى ما يحصل ، % وصحة الأعضاء شرط يشمل % 48(@)(@@) % كيلا يرى في الطيران ذو قصر % % 49(@)(@@) % شرع صحيح للإمام الناصر ، % قيس على الشرع الشريف الطاهر % 50(@)(@@) % حرره كل فقيه ماهر ، % فجاء كالبيت الشريف العامر % PageV01P347 51(@)(@@) % أساسه الصدق ، وركناه النظر % % 52(@)(@@) % يحرم فيه الرمي بالسهام ، % والشرب في البرزة للمدام % 53(@)(@@) % وبيع شيء من صروع الرامي ، % والسبق للصحب إلى المقام % 54(@)(@@) % والشرط والترخيص ، فهو والهدر % % 55(@)(@@) % وقائل فيه لعل تسلم ، % ومثلها في غير شيء يلزم % 56(@)(@@) % أو ذا على الوجه الصحيح يفهم ، % ثلاثة من الهتار تعصم % 57(@)(@@) % سفن النجاة لامرىء خاف الضرر % % 58(@)(@@) % فانظر إلى زهر الرياض المقبل ، % إذ جاده دمع السحاب المسبل % 59(@)(@@) % يضوع من شذاه عرف المندل ، % كأنه ذكر المليك الأفضل % 60(@)(@@) % إذا طواه الوفد في الأرض انتشر % % PageV01P348 61(@)(@@) % وارث علم الملك المؤيد ، % إرثا صحيحا سيدا عن سيد % 62(@)(@@) % أطلق جري نطقي المقيد ، % فإن أفه فيه بنظم جيد % 63(@)(@@) % كنت كمهد تمره إلى هجر % % 64(@)(@@) % نجل بني أيوب أعلام الهدى ، % والأنجم الزهر ، إذا الليل هدا % % 65(@)(@@) % والسابقين بالندى قبل الندا ، % كل فتى ساس البلاد ، فاغتدى % % 66(@)(@@) % في الحكم لقمان وفي العدل عمر % % 67(@)(@@) % المغمدو بيض الظبى في الهام ، % والمشبعو وحش الفلا والهام % % 68(@)(@@) % مرسلو غيث السماح الهامي ، % ففضلهم بالإرث والإلهام % 69(@)(@@) % لاكامرىء ضن وبالأصل افتخر % % 70(@)(@@) % يا ابن الذي قد كان في العلم علم ، % واستخدم السيف ، جديرا ، والقلم % PageV01P349 71(@)(@@) % لغير 
ms102	 بيت المال يوما ما ظلم % مناقبا مثل النجوم في الظلم % 72(@)(@@) % أضحت حجولا للزمان ، وغرر % % 73(@)(@@) % أكرم مثواي ، وأعلى ذكري ، % حتى نسيت عطني ووكري % % 74(@)(@@) % وإن أجلت في علاه فكري ، % ما لي جزاء غير طيب الشكر % 75(@)(@@) % وقد جزي خير الجزاء من شكر % % 76(@)(@@) % يا حامل الأثقال والأهوال ، % ومتلف الأعداء والأموال % 77(@)(@@) % وصادق الوعود والأقوال ، % أبديت في شدائد الأحوال % 78(@)(@@) % صبرا فكان الصبر عقباه الظفر % % 79(@)(@@) % أنلت باغي الجود فوق ما بغى ، % وعجلت كفاك حتف من بغى % % 80(@)(@@) % فقد سموت في الندى وفي الوغى ، % حتى إذا مارد ملك نزغا % % PageV01P350 81(@)(@@) % أخذته أخذ عزيز مقتدر % % 82(@)(@@) % إني وإن شدت لكم بين الملا % % طيب ثناء للفضاء قدملا % % 83(@)(@@) % لم أبغ بالمدح سوى الود ولا % % إن مت يوما بسوى صدق الولا % % 84(@)(@@) % وحسن نظم فيك إن غبت حضر % % 85(@)(@@) % فاسعد بعيد فطرك السعيد ، % ممتعا بعيشك الرغيد % 86(@)(@@) % في الصوم والإفطار والتعييد ، % للناس في العام انتظار عيد % 87(@)(@@) % وأنت عيد دائم لا ينتظر % % PageV01P351 البحر : مجزوء المتقارب 1(@)(@@) % زمان الربيع % شباب الزمان % 2(@)(@@) % وحسن الوجود % وجود الحسان % 3(@)(@@) % وأمن البليغ % بلوغ الأماني % % 4(@)(@@) % فبادر لفض % ختام الدنان % 5(@)(@@) % وزوج بماء الحيا السلسل % عروسا من الخمر % 6(@)(@@) % أدرها معتق % قة خندريسا % % 7(@)(@@) % تميت العقول % وتحيي النفوسا % % 8(@)(@@) % إذا ما سبت % بسناها الكؤوسا % % 9(@)(@@) % تشاهد كلا من % الصحب موسى % % 10(@)(@@) % يشير إلى طورها المعتلي ، % ويصعق بالسكر % PageV01P352 11(@)(@@) % وأغيد طاف % بكاس وحيا % % 12(@)(@@) % فأطلع في الليل % شمس الضحيا % % 13(@)(@@) % فعاد لنا مي % ت اللهو حيا % % 14(@)(@@) % بشمس الحميا ، % وبدر المحيا % % 15(@)(@@) % لما نجتني ، وما نجتلي % % من الشمس والبدر % 16(@)(@@) % فباكر صبوحك % قبل الفطام % 17(@)(@@) % وحي الندامى % % فكأس المدام % 18(@)(@@) % لربك صل بذا % % مرخي اللثام % 19(@)(@@) % وفل الصباح % جيوش الظلام % 20(@)(@@) % وألقى الشعاع على الجدول % ملاء من التبر % PageV01P353 21(@)(@@) % وقد أضحك الرو % ض دمع السحاب % 22(@)(@@) % غداة غدا % % جونه في انتحاب % 23(@)(@@) % فضرج بالزهر % خد الروابي % % 25(@)(@@) % لكانت يدا الملك الأفضل % تنوب عن القطر % 26(@)(@@) % مليك هو الليث % يحمي 
ms103	 حماه % 27(@)(@@) % إذا ما أتاه % % نزيل حماه % 28(@)(@@) % سليل الملوك % الكماة الحماه % 29(@)(@@) % ملوك بهم ظل % وادي حماه % 30(@)(@@) % يطول فخارا على الأعزل ، % ويسموا على النسر % 31(@)(@@) % أيا ملكا جود % كفيه كوثر % PageV01P354 32(@)(@@) % % العيد وانحر % 33(@)(@@) % وكن موقنا أن % شانيك أبتر % 34(@)(@@) % قل : الحمد لله ، % والله أكبر % 35(@)(@@) % فشانيك في الدرك الأسفل ، % وضدك للنحر % PageV01P355 البحر : مجزوء الكامل 1(@)(@@) % لا زال سعدك دائما % ونحور ضدك داميه % % 2(@)(@@) % وعدو ملكك هائما ، % وسحاب جودك هاميه % % 3(@)(@@) % وحسود فضلك سائما ، % وسعود جدك ساميه % % 4(@)(@@) % والنضر حولك حائما ، % وصدور ضدك حاميه % % 5(@)(@@) % مولاي ! إن أك واهيا ، % ونجوم سعدي هاويه % % 6(@)(@@) % ما زلت بعدك شائما % تلك البروق الساميه % % 7(@)(@@) % أغدو لمجدك رائما ، % ويد الندى لي راميه % % PageV01P356 البحر : متقارب تام 1(@)(@@) % بنيت العلى قبل هذا البناء ، % لذلك أضحى محل الهناء % 2(@)(@@) % رحيب الفناء ، رفيع البناء ، % مشيد الثناء ، عزيز السناء % % 3(@)(@@) % فأصبح ، وهو مقيل الضيوف ، % عرين الأسود ، كناس الظباء % 4(@)(@@) % فلا زلت تلبس فيه الغنى ، % وتسمع فيه للذيذ الغناء % PageV01P357 البحر : كامل تام 1(@)(@@) % هنيت بالولد السعيد ، فقد أتى % % وفق المراد وأنت وفق مراده % % 2(@)(@@) % فالله يبقيه ويبقيكم له ، % حتى ترى الأولاد من أولاده % % PageV01P358 البحر : طويل 1(@)(@@) % يبشرني قوم برتبتك التي % % تمنيت فيها السؤل حتى لقيته % % 2(@)(@@) % فبشرت نفسي بالسرور ولم أزل % أهني بك القلب الذي أنت قوته % % 3(@)(@@) % وقلت لهم أعلى الإله محله ، % وهذا دعاء لو سكت كفيته % % PageV01P359 البحر : بسيط تام 1(@)(@@) % ما عشت لا زاركم إلا ثناي ، وإن % % أمسى يفاخر سمعي فيكم بصري % % 2(@)(@@) % فألزم النفس نشري نشر ذكركم ، % إني حضرت ، وأطوي عنكم خبري % % 3(@)(@@) % لأن إفراط هذا البر يبعدني % % عنكم ، وقد كنت منه دائم الحذر % 4(@)(@@) % مع أن عذركم في ذاك متضح ، % لا عذر للسحب إن لم تهم بالمطر % 5(@)(@@) % فإن عتبتم على بعد المزار أقل ، % نظام من قال قبلي قول معتذر : % 6(@)(@@) % لو اختصرتم من الإحسان زرتكم ، % والعذب يهجر للإفراط في الحضر % PageV01P360 البحر : سريع 1(@)(@@) % لا زلت سباقا إلى المكرمات ، % عاش بك المعروف والمكرمات % % 2 
ms104	(@)(@@) % أنت امرؤ معروفه ثابت ، % وليس للأموال منه ثبات % % 3(@)(@@) % ما جمعت شمل العلى كفه ، % إلا تداعى ماله بالشتات % % PageV01P361 البحر : - 1(@)(@@) % مازال ظل نداك شامل ، % يا مضن يمول كل آمل % 2(@)(@@) % يا من غدا كهف الأيا % % مى واليتامى والأرامل % 3(@)(@@) % حزت العلى والجود يا % % رب الفضائل والفواضل % 4(@)(@@) % وكملت كل فضيلة ، % % PageV01P362 البحر : كامل تام 1(@)(@@) % أوليتني نعما تتابع منها ، % هي فيك أصفادي وقيد ثنائي % % 2(@)(@@) % فلأشكرنك ما استطعت تلفظا ، % شكر الرياض لصيب الأنواء % PageV01P363 البحر : خفيف تام 1(@)(@@) % كثر الله مثل مجدك في الأر % % ض ، لتفشو صنائع الإحسان % 2(@)(@@) % وتعم الأنام منك هبات ، % توجب الصفح عن ذنوب الزمان % 3(@)(@@) % فلقد عمنا نداك بنعمى ، % قصرت دونها يدي ولساني % % 4(@)(@@) % وأياد لو ادعتها الغوادي ، % كذبتها شواهد الامتحان % 5(@)(@@) % شاهد الناس من سماحك معنى ، % غير أني شاهدت منك معاني % % 6(@)(@@) % يا جوادا يلقى وفود نداه % % بجدي منعم ، وأعذار جاني % % 7(@)(@@) % جمعت في بديع أوصافك الأض % % داد ، يا جامع الصفات الحسان % 8(@)(@@) % تبذل المال ثم تبخل بالعر % ض ، وتسطو إلا على ذي لسان % 9(@)(@@) % فلك الله من كريم ، بخيل ، % مانح ، مانع ، شجاع ، جبان % PageV01P364 البحر : مجزوء الخفيف 1(@)(@@) % شرف الله قدر من % % شرف اليوم حضرتي % % 2(@)(@@) % ورعى الله من رعى % % حق عهدي وصحبتي % % 3(@)(@@) % زار من غير موعد % حين أخرت زورتي % % 4(@)(@@) % فتمنيت لو أقا % % م ، وقامت قيامتي % % PageV01P365 البحر : خفيف تام 1(@)(@@) % أنت أوليتني الجميل ، ولولا % % ضعف حظي لكنت بالسعي أولى % % 2(@)(@@) % لم تزل تسبق الأنام بحسنا % % ك ، وتولي العباد لطفا وطولا % % 3(@)(@@) % قد تصدقت بالزيارة للعب % % د فصدقت فيك ظنا وقولا % % 4(@)(@@) % فإذا زرت زرت عبدا ورقا ، % وإذا ذدت ذدت ذخرا ومولى % % PageV01P366 البحر : متقارب تام 1(@)(@@) % أيا من حكى فضل عيسى المسيح ، % غداة حكت عازرا مهجتي % % 2(@)(@@) % أعدت لي الروح ، إذ زرتني ، % وقد يئس الناس من رجعتي % % PageV01P367 البحر : مجتث 1(@)(@@) % وصاحب لي مصافي ، % من غير أبناء جنسي % % 2(@)(@@) % غرست في الصدر منه % ودا ، فأثمر غرسي % % 3(@)(@@) % ولجت يوما فناه ، % لكي أجدد أنسي % % 4(@)(@@) % فلم ألج غير 
ms105	 داري ، % ولم أزر غير نفسي % % PageV01P368 البحر : كامل تام 1(@)(@@) % لي صاحب إن خانني دهري وفى ، % وإذا تكدرت المناهل لي صفا % % 2(@)(@@) % تبدو محبته ويظهر وده % % نحوي إذا ما الود بالملق اختفى % % 3(@)(@@) % أجفو ، فيمنحني المودة طالبا % قربي ، وأمنحه الوداد إذا جفا % % 4(@)(@@) % كل يقول : لصاحبي عندي يد ، % إذ كان لي دون الأنام قد اصطفى % % PageV01P369 البحر : مجزوء الكامل 1(@)(@@) % وقيت حادثة الليالي ، % وحرست من عين الكمال % 2(@)(@@) % يا مالكا بصنيعه % حاز المعاني والمعالي % % 3(@)(@@) % قسما بأنعمك الجسا % % م على المؤمل والموالي % % 4(@)(@@) % إني لمشتاق إلى % % تلك الشمائل والجمال % 5(@)(@@) % ولقد ذكرت القرب منك % وطيب أيامي الخوالي % % 6(@)(@@) % فطفقت أصفق راحتي ، % وعند صفقتها مقالي : % 7(@)(@@) % كيف السبيل إلى سعا % % د ، ودونها فلك الحيا لي % % PageV01P370 البحر : رجز تام 1(@)(@@) % أما ترى الأنواء والسحائبا ، % قد أصبحت دموعها سواكبا % % 2(@)(@@) % فاكتست الأرض بها جلاببا ، % فأظهرت أزهارها عجائبا % % 3(@)(@@) % غرائبا أضحت لنا رغائبا % % 4(@)(@@) % هذي الروابي بالكلا قد توجت ، % ونسمة الخريف قد تأرجت % 5(@)(@@) % وقد صفت مياهه ورججت ، % والأرض بالأزهار قد تدبجت % 6(@)(@@) % وأصبح الطل عليها ساكبا % % 7(@)(@@) % فقم ، فقد تم لنا طيب الهنا ، % والدهر قد من علينا بالمنى % % 8(@)(@@) % والعيش قد رقت حواشيه لنا ، % ومسعدي شرخ الشباب والغني % % 9(@)(@@) % هما اللذان غمرا لي جانبا % % 10(@)(@@) % يا سعد باكر ، فاللبيب من بكر ، % وابرز بنا ليس العيان كالحبر % % PageV01P371 11(@)(@@) % فاغتنم الصفو بنا قبل الكدر ، % فالدهر من زلاته قد اعتذر % 12(@)(@@) % وجاءنا من الذنوب تائبا % % 13(@)(@@) % لا تسكب الدمع على عيش مضى ، % ولا تقل كان زمان وانقضى % % 14(@)(@@) % واغتنم الغفلة من صرف القضا ، % فالموت كالسيف متى ما ينتضى % % 15(@)(@@) % تضحي له أعمارنا ضرائبا % % 16(@)(@@) % فدع حديث الزمن القديم ، % والذكر للأطلال والرسوم % 17(@)(@@) % فإن تكن عوني على الهموم % حدث عن القديم والنديم % 18(@)(@@) % واذكر لدي راميا أو ساريا % % 19(@)(@@) % ما دامت الأيام في نصاحتي ، % والعز ملق رحله بساحتي % % 20(@)(@@) % لأبذلن ما حوته راحتي ، % أتلف ما في راحتي في راحتي % % PageV01P372 21(@)(@@) % وأقصد اللذات والملاعبا % % 22(@)(@@) % فقم بنا مبتكرا ، يا صاحبي 
ms106	 ، % نقضي بأيام الصبى مآربي % % 23(@)(@@) % ولا تكن تفكر في العواقب ، % وخل خلاني ، ودع أقاربي % % 24(@)(@@) % وأقصد بنا الأحلاف والقرائبا % % 25(@)(@@) % واعتبر الجنة في الطريق ، % وانتخب الرفيق للمضيق % 26(@)(@@) % ولا تصاحب غير ذي التحقيق ، % فالتم لا يطير بين الشيق % 27(@)(@@) % والكي لا يرضى الوريد صاحبا % % 28(@)(@@) % أما ترى الطير الجليل قد أتى % % مستبشرا يمرح في فصل الشتا % % 29(@)(@@) % فقم بنا إن الصبى عون الفتى ، % ولا تقل كيف ، وأنى ، ومتى % % 30(@)(@@) % إن الأماني لم تزل كواذبا % % PageV01P373 31(@)(@@) % بمدمجات زانها إدماجها ، % معوجات ، حسنها اعوجاجها % % 32(@)(@@) % أهلة أكفها أبراجها ، % حوامل ، إذا دنا نتاجها % % 33(@)(@@) % تقذف من أكبادها كواكبا % % 34(@)(@@) % ما خيبت يوما لنا مساعيا ، % لكاد حسنا أن تجيب الداعيا % % 35(@)(@@) % تغني بها الجليل والمراعيا ، % إن كمدنت ظننتها افاعيا % % 36(@)(@@) % أو أوترت حسبتها عقاربا % % 37(@)(@@) % ومدمج كالنون في تععريقه ، % أشهى إلى العاشق من معشوقه % % 38(@)(@@) % كالصارم المصقول في بريقه ، % لو أنه يسكن من خفوقه % % 39(@)(@@) % أضحى على عين الزمان حاجبا % % 40(@)(@@) % مستأنف قد تم في أقسامه ، % لكن نقص الطير في تمامه % % PageV01P374 41(@)(@@) % قد نبت العود على لحامه ، % من خطف الخطفة في مقامه % % 42(@)(@@) % أتبعه منه شهابا ثاقبا % % 43(@)(@@) % مردد يرضيك في ترديده ، % شهرته تغنيك عن تحديده % 44(@)(@@) % لافرق بين شاخه وعوده ، % يحقق البندق في صعوده % % 45(@)(@@) % ويضمن المصروع والصوائبا % % 46(@)(@@) % أصلحه صالح عند جسه ، % وزانه واختاره لنفسه % 47(@)(@@) % منظره يغني الفتى عن لمسه ، % فهو له بعد حلول رمسه % % 48(@)(@@) % يهدي الثنا ويظهر المناقبا % % 49(@)(@@) % وبندق معتدل المقدار ، % كأنما قسم العيار % 50(@)(@@) % قد حمل الحقد على الأطيار ، % فهو إذا انقض من الأتار % PageV01P375 51(@)(@@) % يرى فناء الطير فرضا واجبا % % 52(@)(@@) % يريك في وقت الصباح لهبا ، % كأنه برق أضاء وخبا % % 53(@)(@@) % يقطع متن الريح من غير شبا ، % يقظان لا يصبو إلى خفق الصبا % % 54(@)(@@) % ولا يلين للجنوب جانبا % % 55(@)(@@) % وخشية لطفت في مقدارها % % تغنى بها الأطيار عن أوكارها % % 56(@)(@@) % لايبرح الريش على نوارها ، % والدم مسفوكا على أقطارها % % 57(@)(@@) % إذ كان في اللون لها مناسبا % % 58(@)(@@) % كأنذها من كثرة 
ms107	 الصروع ، % قد خضبت بخالص النجيع % 59(@)(@@) % لم تخل في البروز والرجوع % من صارع يحمل ، أو مصروع % % 60(@)(@@) % تحمل آت أو تقل ذاهبا % % PageV01P376 61(@)(@@) % وحلة جفتية كالعندم ، % لطيفة التجليس والتهندم % 62(@)(@@) % مؤخرها في الحسن مثل المقدم ، % يظنها الطير له نطع الدم % 63(@)(@@) % ولم يكن فيما يظن كاذبا % % 64(@)(@@) % فلو شهدت طيرنا فيمن رمى ، % وجيسه من جمعنا قد هزما % % 65(@)(@@) % وبندق الصحب إليه قد سما ، % عجبت من راق إلى جو السما % % 66(@)(@@) % أرسلت الأرض عليه حاصبا % % 67(@)(@@) % من كل شهم كالهزبر الباسل ، % وكل قيل قائل وفاعل % 68(@)(@@) % ذخر الزميل عدة المقاول ، % وبينهم حمل بلا تحامل % 69(@)(@@) % من بعد ما اصطفوا له مراتبا % % 70(@)(@@) % حول قديم كالحسام الماضي % % خال من الأغراض والأعراض % PageV01P377 71(@)(@@) % يطب داء الكلم المراض ، % يرضى بأن الجمع عنها راض % 72(@)(@@) % لا يرقب الأسباق والمواهبا % % 73(@)(@@) % في موقف به الصروع تنثل ، % تلقى المراعي ، والجليل تحمل % 74(@)(@@) % معدودة أصنافه لا تجهل ، % إذ هي في سبع وسبع تكمل % 76(@)(@@) % وصاحب أعده لي مالكا ، % كلفني في النظم عد ذلكا % % 77(@)(@@) % وقال : لخص ذاك في نظامكا ، % قلت : علو صنعك احتشامكا % % 78(@)(@@) % إن كنت لي حل الرموز دائبا % % 79(@)(@@) % لم أنس في ثوب شليل برزتي ، % بين ثقاف من رماة الحلة % 80(@)(@@) % وقد أتاني محرقا عن جفتي ، % مزجوجق من العنانين التي % % 81(@)(@@) % بين الرماة أصبحت غرائبا % % PageV01P378 82(@)(@@) % ثبت للزوج ، وقد أتاني % % مصعصعا يمرح في أمان % 83(@)(@@) % عاجلته من قبل أن يراني % % صرعت حداه ، وصبت الثاني % % 84(@)(@@) % دلى البراثيم وولى هاربا % % 85(@)(@@) % فخر كالنجم ، إذا النجم هوى ، % ما ضل عن صاحبه وما غوى % % 86(@)(@@) % وافاه ، وهو ناطق عن الهوى ، % قد هد منه الخيل من بعد القوى % % 87(@)(@@) % وأصبح الثاني عليه نادبا % % 88(@)(@@) % فيا لها من فرصة لو تمت ، % كنت وهبت للقديم مهجتي % % 89(@)(@@) % ولم يكن ذو قدمة كقدمتي ، % بل فاتني الثاني ، وكانت همتي % % PageV01P379 البحر : رجز تام 1(@)(@@) % انهض فهذا النجم في الغرب سقط ، % والشيب في فود الظلام قد وخط % 2(@)(@@) % والصبح قد مد إلى نحر الدجى % % يدا بها 
ms108	 در النجوم تلتقط % 3(@)(@@) % وألهب الإصباح أذيال الدجى ، % بشمعة من الشعاع لم تقط % 4(@)(@@) % وضجت الأوراق في أوراقها ، % لما رأت سيف الصباح مخترط % 5(@)(@@) % وقام من فوق الجدار هاتف % متوج الهامة ذو فرع قطط % 6(@)(@@) % يخبر الراقد أن نومه % عند انتباه جده من الغلط % 7(@)(@@) % والبدر قد صار هلالا ناحلا ، % في آخر الشهر ، وبالصبح اختلط % 8(@)(@@) % كأنه قوس لجين موتر ، % والليل زنجي عليه قد ضبط % 9(@)(@@) % وفي يديه للثريا ندب % يزيد فردا واحدا عن النمط % 10(@)(@@) % فأي عذر للرماة ، والدجى % % قد عد في سلك الرماة وانخرط % PageV01P380 11(@)(@@) % أما ترى الغيم الجديد مقبلا ، % قد مد في الأفق رداه ، فانبسط % 12(@)(@@) % كأن أيدي الزنج في تلفيقه % قد لبدت قطنا على ثوب شمط % 13(@)(@@) % يلمع ضوء البرق في حافاته ، % كأن في الجو صفاحا تخترط % 14(@)(@@) % وأظهر الخريف من أزهاره % أضعاف ما أخفى الربيع إذ شحط % % 15(@)(@@) % ولان عطف الريح في هبوبها ، % والطل من بعد الهجير قد سقط % 16(@)(@@) % والشمس في الميزان موزون بها % % قسط النهار بعدما كان قسط % 17(@)(@@) % وأرسلت جبال دربند لنا % % رسلا صبا القلب إليها وانبسط % 18(@)(@@) % من الكراكي الخزريات التي % % تقدم ، والبعض ببعض مرتبط % 19(@)(@@) % كأنها ، إذا تابعت صفوفها ، % ركائب عنها الرحال لم تحط % 20(@)(@@) % إذا قفاها سمع ذي صبابة ، % مثلي ، تقاضاه الغرام ونشط % PageV01P381 21(@)(@@) % فقم بنا نرفل في ثوب الصبى ، % إن الرضى بتركه عين السخط % 22(@)(@@) % والقتط اللذة حيث أمكنت ، % فإنما اللذات في الدهر لقط % 23(@)(@@) % إن الشباب زائر مودع ، % لا يستطاع رده ، إذا فرط % 24(@)(@@) % أما ترى الكركي في الجو ، وقد % % نغم في أفق السماء ولغط % 25(@)(@@) % أنساه حب دجلة وطيبها % % مواطنا ، قد زق فيها ولقط % 26(@)(@@) % فجاء يهدي نفسه ، وما درى % % أن الردى قرينه حيث سقط % 27(@)(@@) % فابرز قسيا من كمند أتاتها ، % إن الجياد للحروب ترتبط % 28(@)(@@) % من كل سبط من هدايا واسط % جعد البلاغ منه في الكعب نقط % 29(@)(@@) % أصلحه صالح باجتهاده ، % فكل ذي لب له فيه غبط % 30(@)(@@) % وما أضاع الحزم عند عزمها ، % بل جاوز 
ms109	 القيظ وللفصل ضبط % PageV01P382 31(@)(@@) % حتى إذا حر حزيران خبا ، % وتم تموز وآب وشحط % 32(@)(@@) % وجاء أيلول بحر فاتر ، % في نضج تعديل الثمار ما فرط % 33(@)(@@) % أبرز ما أ ؛ رز من آلاته ، % وحل من ذاك المتاع ما ربط % 34(@)(@@) % ومد للصنعة كفا أوحدا ، % منزها عن الفساد والغلط % 35(@)(@@) % وظل يستقري بلاغ عودها ، % فنبر الأطراف واختار الوسط % 36(@)(@@) % وجود التدفيق في لحامها ، % فأسقط الكرشات منها والسقط % 37(@)(@@) % ولم يزل يبلغها مراتبا ، % تلزم في صنعته وتشترط % 38(@)(@@) % فعندما أفضت إلى تطهيرها % % صحح دارات البيوت والنقط % 39(@)(@@) % حتى إذا قمصها بدهنها ، % جاءت من الصحة في أحلى نمط % 40(@)(@@) % كأنها النونات في تعريقها ، % يعرج منها بندق مثل النقط % PageV01P383 41(@)(@@) % مثل السيور في يد الرامي ، فلو % % شاء طواها وحواها في سفط % 42(@)(@@) % لو يقذف اليوم بها مالكها % % ما انتقض العود ، ولا الزور انكشط % 43(@)(@@) % كأنما بندقها تنازلا ، % أو من يد الرامي إلى الطير خطط % 44(@)(@@) % من كل محني البيوت مدمج ، % ما أخطأ الباري به ولا فرط % 45(@)(@@) % كأنه لام عليه ألف ، % وقال قوم : إنها اللام فقط % 46(@)(@@) % فاجل قذى عيوننا ببرزة % تنفي عن القلب الهموم والقنط % 47(@)(@@) % فما رأت من بعد هور بابل % ومائه التيار عيشا مغتبط % 48(@)(@@) % ونحن في مروجه في نشوة % عند التحري في الوقوف للخطط % 49(@)(@@) % من كل مقبول المقال صادق ، % قد قبض القوس وللنفس بسط % 50(@)(@@) % يقدمنا فيها قديم حاذق ، % لا كسل يشينه ولا قنط % PageV01P384 51(@)(@@) % يحكم فينا حكم داود ، فلا % % ينظر منا خارجا عما شرط % 52(@)(@@) % إذا رأى الشر تعلى ، وإذا % % لاح له الخير تدلى وانحبط % 53(@)(@@) % ما نغم المزهر والدف ، إذا % % فصل أدوار الضروب وضبط % 54(@)(@@) % أطيب من تدفدف التم ، إذا % % دق على القبض الجناح وخبط % 55(@)(@@) % والطير شتى في نواحيه ، فذا % % فاكتسى الريش وهذا قد شمط % 56(@)(@@) % وذاك يرعى في شواطيه ، وذا % % على الروابي قد تحصى ولقط % 57(@)(@@) % فمن جليل واجب تعداده ، % ومن مراع عدها لا يشترط % 58(@)(@@) % يعرج منا نحوها بنادق ، % لم ينج منها من تعلى واختبط % 59 
ms110	(@)(@@) % فمن كسير في العباب عائم ، % ومن ذبيح بالدماء يغتبط % PageV01P385 البحر : رجز تام 1(@)(@@) % أهلا بها قوادما رواحلا ، % تطوي الفلا وتقطع المراحلا % % 2(@)(@@) % تذكرت آكام دبرنداتها ، % وعافت الآجام والمراحلا % % 3(@)(@@) % أذكرها عرف الربيع إلفها ، % فأقبلت لشوقها حواملا % % 4(@)(@@) % نفرق في الجو بصوت مطرب ، % يشوق من كان إليها مائلا % % 5(@)(@@) % هدية الصنف ودربندية ، % أو خزريات بدت أصائلا % % 6(@)(@@) % لما رأت حر المصيف مقبلا ، % وطيب برد القر ظلا زائلا % % 7(@)(@@) % أهملت التخبيط في مطارها ، % وعسكرت لسيرها قوافلا % % 8(@)(@@) % من بعد ما مرت بها أخياطها ، % كما نظمت في البرى البوازلا % % 9(@)(@@) % تنهض من صرح الجليل تحتها ، % بأرجل لبرده قوابلا % % 10(@)(@@) % قد أنفت أيام كانون لها % % من أن ترى من الحلى عواطلا % % PageV01P386 11(@)(@@) % فصاغت الطل لها قلائدا ، % والثلج في أرجلها خلاخلا % % 12(@)(@@) % لما دعاني صاحبي لبرزة % ونبه الزميل والمقاولا % % 13(@)(@@) % أجبته مستبشرا بقصدها : % نبهتم ليث عرين باسلا % % 14(@)(@@) % ثم برزنا نقتفي آثاره ، % ونقصد الأملاق والمناهلا % % 15(@)(@@) % بين قديم وزميل صادق ، % لا زال شكري لهما مواصلا % % 16(@)(@@) % والصبح قد أعمنا بنوره ، % لما انثنى جنح الظلام راحلا % % 17(@)(@@) % تخال ضوء الصبح فودا شائبا ، % وتحسب الليل خضابا ناصلا % % 18(@)(@@) % وقد أقمنا في المقامات لها % % معالما تحسبها مجاهلا % % 19(@)(@@) % وأعين الأسد ، إذا جن الدجى % % أذكت لنا أحداقها مشاعلا % % 20(@)(@@) % نرشقها من تحتها ببندق ، % يعرج كالشهب إليها واصلا % % PageV01P387 21(@)(@@) % فما رقي تحت الطيور صاعد ، % إلا اغتدى بها البلاء نازلا % % 22(@)(@@) % لله أيام بهور بابل % أضحى بها الدهر علينا باخلا % % 23(@)(@@) % فكم قضينا فيه شملا جامعا ، % وكم صحبنا فيه جمعا شاملا % % 24(@)(@@) % فهل ترى ترجع أيام به ، % في جذل قد كان فيه حاصلا % % 25(@)(@@) % هيهات مهما يستعر مسترجع ، % أراجع لي الدهر حولا كاملا % % PageV01P388 البحر : رجز تام 1(@)(@@) % قد ارتدى ذيل الظلام الأشيب ، % والصبح مثل الماء تحت الطحلب % 2(@)(@@) % بأجرد ملء الحزام سلهب ، % مختبر ، كالبطل المجرب % 3(@)(@@) % مثقل الكف بباز أشهب ، % منتصب القامة سامي المكنب % 4(@)(@@) % غليظ خط الجؤجؤ المنكب ، % ذي عنق خصب ورأس أجذب % 5(@)(@@) % قصير عظم الساق ، ثبت الركب ، % قليل 
ms111	 ريش الصفحتين ، أرعب % 6(@)(@@) % تام الجناحين ، قصير الذنب ، % عيونه مثل الجمان المذهب % 7(@)(@@) % قد بدلت من سبج بكهرب ، % محدد المنسر شين المخلب % 8(@)(@@) % ينهش في السبق ، وإن لم يشغب ، % حتف الحبارى وعقال الأرنب % % 9(@)(@@) % لا يرقب النجدة من مدرب ، % إذا الصقور أنجدت بالأكلب % 10(@)(@@) % مهذب الخلق ، قليل الغضب ، % يرتاح للعود ، وإن لم يطلب % % PageV01P389 11(@)(@@) % كفاضل حاول حفظ المنصب ، % زرت به الطير بموج معشب % 12(@)(@@) % فحال بين رعيها والمشرب ، % وظل كالساعي الجريء المذئب % 13(@)(@@) % يجدل الأبعد قبل الأقرب ، % لو أنه مر بعنقا مغرب % % 14(@)(@@) % لم تحم من مشرقها بالمغرب ، % مكذبا فيها مقال العرب % PageV01P390 البحر : رجز تام 1(@)(@@) % يا طيب يوم بالمروج الخضر ، % سرقته مختلسا من عمري % % 2(@)(@@) % والطل قد كلل هام الزهر ، % فعطر الأرجاءض طيب النشر % 3(@)(@@) % باكرتها بعد انبلاج الفجر % عند انبساط الشفق المحمر % 4(@)(@@) % والطير في لج المياه تسري ، % كأنها سفائن في بحر % 5(@)(@@) % حتى إذا لاذت بشاطي النهر ، % دعوت عبدي ، فأتى بصقري % % 6(@)(@@) % من الغطاريف الثقال الحمر ، % مستبعد الوحشة جم الصبر % 7(@)(@@) % معتدل الشلو شديد الأزر ، % منفسح الزور رحيب الصدر % 8(@)(@@) % متسع العين عريض الظهر ، % بأعين مسودة كالحبر % 9(@)(@@) % وهامة عظيمة كالفهر ، % كأن فوق صدره والنحر % 10(@)(@@) % هامة هيق في صماخي نسر ، % طويل أرياش الجناح العشر % PageV01P391 11(@)(@@) % قصير ريش الذنب المحمر ، % قصير عظم الساق تام الظفر % 12(@)(@@) % فظل يتلوها ، عظيم المكر ، % يغري بها همته ونصري % % 13(@)(@@) % كأنه يطلبها بوتر ، % فجاءنا منها بكل عفر % 14(@)(@@) % فبت والصحب بها في بشر % كأننا في يوم عيد النحر % 15(@)(@@) % نأكل من لحومها ونقري % % PageV01P392 البحر : رجز تام 1(@)(@@) % ويوم دجن معلم البردين ، % سماؤه بالغيم في لونين % 2(@)(@@) % كأنها ، وقد بدت للعين ، % فيروزج يلمع في لونين % 3(@)(@@) % قضيت فيه بالسرور ديني ، % وسرت أفلي مفرق الشعبين % 4(@)(@@) % بأدهم محجل الرجلين ، % سبط الأديم مفلق اليدين % 5(@)(@@) % خصب العطاة ماحل الرسغين ؛ % وسرب وحش مذ بدا لعيني % % 6(@)(@@) % عارضته في منتهى السفحين % بأرقط مخطط الأذنين % 7(@)(@@) % ناقي الجبين أهرت الشدقين ، % أفطس سبط الشعر صافي العين % % 8(@)(@@) % ينظر في 
ms112	 الليل بجمرتين ، % ذي كحل سال من العينين % 9(@)(@@) % فخط لامين على الخدين ، % محدد النابين والظفرين % 10(@)(@@) % كأنما يكشر عن نصلين ، % ليس لها عهد بضرب قين % PageV01P393 11(@)(@@) % رقيق لحم الزند والساقين ، % ذي ذنب أملس غير شين % 12(@)(@@) % فخاتل السرب بخطوتين ، % وأردف الخطو بوثبتين % 13(@)(@@) % فكان فيها كغراب البين ، % فرقها قبل بلوغ الحين % 14(@)(@@) % ونال منها عفر المتنين ، % أجيد مصقول الإهاب زين % 15(@)(@@) % جدله في ملتقى الصفين ، % ولم يحل ما بينه وبيني % % 16(@)(@@) % نلت بمهري وبه كفلين ، % إنهما للصيد عدتين % 17(@)(@@) % لايحسن اللهو بغير ذين % % PageV01P394 البحر : رجز تام 1(@)(@@) % وليلة في طول يوم العرض ، % سماؤها من دكنه كالأرض % 2(@)(@@) % مخضت فيها العيش أي مخض ، % وفزت فيها بالنعيم المحض % 3(@)(@@) % وغض جفن الدهر أي غض ، % فبت من صروفه أستقضي % % 4(@)(@@) % أرفع قدر عيشتي بالخفض ، % لا أكحل الجفن بها بغمض % 5(@)(@@) % مع كل ساق كالقضيب الغض ، % يدير راحا بالسرور تقضي % % 6(@)(@@) % ساطعة كالبرق عند الومض ، % حتى إذا آن أداء الفرض % 7(@)(@@) % وشق جيب الفلق المبيض ، % عرضت خيلي ، فأجدت عرضي % % 8(@)(@@) % واخترت منها سابقا لي يرضي ، % يفوت لمح الطرف حين يمضي % % 9(@)(@@) % كأنذما الأرض به في قبضي ، % لافرق بين طوله والعرض % 10(@)(@@) % جعلته وقاية لعرضي ، % ثم غدوت لمرامي أقضي % % PageV01P395 11(@)(@@) % من كل سرب شارد منغض ، % بأرقط الظهر صقيل بض % 12(@)(@@) % كسبج في ذهب مرفض % أهرت رحب الصدر نائي الغمض % 13(@)(@@) % مستثقل الشلو خفيف النهض ، % عريض بسط الكف عند القبض % 14(@)(@@) % محدد الناب لغير عض ، % منتصب الأذنين عند الركض % 15(@)(@@) % مخاتل السرب بغير وفض ، % منخفضا للختل أي خفض % 16(@)(@@) % مصافحا بالبطن ظهرض الأرض ، % يجسها بالكف جس النبض % 17(@)(@@) % عناق ذي حبت لرب بغض % عاجلها كالكوكب المنقض % 18(@)(@@) % فعانق الأكبر عند النهض ، % % 19(@)(@@) % فهاض منه العظم عند الهض ، % ورض منه الصدر أي رض % 20(@)(@@) % فقمت أسعى خيفة أن يقضي ، % أغض عن زلاته وأغضي % % PageV01P396 البحر : رجز تام 1(@)(@@) % وأهرت الشدقين محبوك المطا ، % محدد الأنياب مرهوب السطا % % 2(@)(@@) % افطس تبري الإهاب أرقطا ، % كلون تبر بمداد نقطا % % 3(@)(@@) % ألبسه الخالق 
ms113	 حسنا مفرطا ، % وخط في الخدين منه خططا % % 4(@)(@@) % مستثقل الجسم خفيف إن خطا ، % مجرب الإقدام مأمون الخطى % % 5(@)(@@) % يسبق في إرساله كدر القطا ، % أضحى على قنيصه مسلطا % % 6(@)(@@) % حتى إذا من العقال نشطا ، % وفى لنا فعلا بما قد شرطا % % 7(@)(@@) % قلت ، وقد بت به مغتبطا ، % والشلو من قنيصه معتبطا % % 8(@)(@@) % بذاك أم بالخيل تعدو المرطى % % PageV01P397 البحر : رجز تام 1(@)(@@) % وأهرت ، من الكلاب ، أخطل ، % أصفر مصقول الإهاب أشعل % 2(@)(@@) % أعصم مثل الفرس المحجل ، % يخال مرحوضا وإن لم يغسل % 3(@)(@@) % مختصر الشلو ، ثقيل المحمل ، % منفسح الهامة ، ناتي المقل % 4(@)(@@) % إذ أنه كالسوسن المهدل ، % كأن فوق عنقه المعتدل % 5(@)(@@) % هامة فهد في صماخي فرعل ، % منسرح الزور فسيح الكلكل % 6(@)(@@) % منهضم الخصر ، عريض الكفل ، % ذي أيطل خال ، ومتن ممتلي % % 7(@)(@@) % خصيب أعلى العضب محل الأسفل ، % قصير عظم الساعد المفتل % 8(@)(@@) % مقتصر الأيدي طويل الأرجل ، % مزدحم الأظفار ثبت العضل % 9(@)(@@) % ذي ذنب سبط قصير أفتل ، % أسلس من دفته كالمغزل % 10(@)(@@) % كثير تكرار نزاع الأحبل ، % يبيت غضبان ، إذا لم يرسل % PageV01P398 11(@)(@@) % قيد الأوادي ، وعقال الإبل ، % رعت به سرب الظباء الجفل % 12(@)(@@) % فاعتصمت منه بأعلى الجبل ، % فظل ينحو قصدها ويعتلي % % 13(@)(@@) % وخر ينصب عليها من عل ، % شبيه سهم مرقت من عيطل % 14(@)(@@) % يفوت لمح الطرف في التأمل ، % حتى إذا انقض انقضاض الأجدل % 15(@)(@@) % فما ارتضى منها بدون الأول ، % غادره مجدلا في الجندل % 16(@)(@@) % ذا جثة وافرة كالمسحل ، % وظل صحبي في نعيم مقبل % 17(@)(@@) % لهم غريض لحمه ، والشكر لي % % PageV01P399 البحر : رجز تام 1(@)(@@) % ورب يوم أدكن القتام ، % ممتزج الضياء بالظلام % 2(@)(@@) % سرنا به لقنص الآرام ، % والصبح قد طوح باللثام % 3(@)(@@) % كراقد هب من المنام ، % بضمر طامية الحوامي % % 4(@)(@@) % معتادة بالكر والإقدام ، % تحجم في الحرب عن الإحجام % 5(@)(@@) % حتى إذا آن ظهور الجام ، % والبر بالآل كبحر طام % 6(@)(@@) % عن لنا سرب من النعام ، % مشرقة الأعناق كالأعلام % 7(@)(@@) % فاغرة الأفواه للهيام ، % كأينق فرت من الزمام % 8(@)(@@) % وحش على مثنى من الأقدام ، % بالطير تدعى وهي كالأنعام % 9(@)(@@) % تطير بالأرجل في الموامي 
ms114	 ، % كأنما أعناقها السوامي % % 10(@)(@@) % أراقم قد قمن للخصام ، % فحين هم السرب بانهزام % PageV01P400 11(@)(@@) % ألجمت القسي بالسهام ، % فأرسل النبل كوبل هام % 12(@)(@@) % فعن رأل عارض أمامي ، % كأنما درع بالظلام % % 13(@)(@@) % نيطت جناحاه بعنق سام ، % كأنها من حسن الإلتئام % 14(@)(@@) % هاء شقيق وصلت بلام ، % عارضته تحت العجاج السامي % % 15(@)(@@) % بسابق ينقض كالقطامي ، % خلو العنان مفعم الحزام % 16(@)(@@) % يكاد يلوي حلق اللجام ، % ذي كفل راب وشدق دام % 17(@)(@@) % وصفحة ريا ، ورسغ ظام ، % فحين وافى عارضا قدامي % % 18(@)(@@) % أثبت في كلكله سهامي ، % فمرقت في اللحم والعظام % 19(@)(@@) % فخر مصروعا على الرغام ، % قد ساقه الخوف إلى الحمام % 20(@)(@@) % فأعجب الصحب به اهتمامي ، % حتى اغتدى كل من الأقوام % PageV01P401 21(@)(@@) % يقول : لا شلت يمين الرامي % % PageV01P402 البحر : بسيط تام 1(@)(@@) % وأدهم يقق التحجيل ذي مرح ، % يميس من عجبه كالشارب الثمل % 2(@)(@@) % مطهم مشرف الأذنين تحسبه % % موكلا باستراق السمع عن زحل % 3(@)(@@) % ركبت منه مطا ليل تسير به % كواكب تلحق المحمول بالحمل % 4(@)(@@) % إذا رميت سهامي فوق صهوته ، % مرت بهاديه وانحطت على الكفل % PageV01P403 البحر : كامل تام 1(@)(@@) % ولقد أروح إلى القنيص وأغتدي % % في متن أدهم كالظلام محجل % 2(@)(@@) % رام الصباح من الدجى استنقاذه ، % حسدا ، فلم يظفر بغير الأرجل % 3(@)(@@) % فكانه صبغ الشبيبة هابه % وخط المشيب ، فجاءه من أسفل % PageV01P404 البحر : كامل تام 1(@)(@@) % وأغر تبري الإهاب مردد ، % سبط الأديم محجل ببياض % 2(@)(@@) % أخشى عليه بأن يصاب بأسهمي ، % مما يسابقني إلى الأغراض % PageV01P405 البحر : متقارب تام 1(@)(@@) % وطرف تخيرته طرفة ، % وأحببته من جميع التراث % 2(@)(@@) % حوى ببدائع أوصافه % مضاء الذكور وصبر الإناث % 3(@)(@@) % إذا انقض كالصقر في معرك ، % ترى الخيل في إثره كالبغاث % 4(@)(@@) % طويل الثلاث ، قصير الثلاث ، % عريض الثلاث ، فسيح الثلاث % PageV01P406 البحر : وافر تام 1(@)(@@) % وعادية إلى الغارات ضبحا ، % تريك لقدح حافرها التهابا % % 2(@)(@@) % كأن الصبح ألبسها حجولا ، % وجنح الليل قمصها إهابا % % 3(@)(@@) % جواد في الجبال تخال وعلا ، % وفي الفلوات تحسبها عقاب % % 4(@)(@@) % إذا ما سابقتها الريح فرت ، % وأبقت في يد الريح الترابا % % PageV01P407 البحر : وافر تام 1(@)(@@) % وواد تسكر الأرواح فيه 
ms115	 ، % وتخفق فيه أرواح النسيم % 2(@)(@@) % به الأطيار قد قالت ، وقالت % كلاما شافيا داء الكليم % 3(@)(@@) % تسلسل في خمائله مياه ، % يقد أديمها قد الأديم % 4(@)(@@) % مروج للقلوب بها امتزاج ، % كأن عيونها أيدي الكريم % 5(@)(@@) % لها أرج اللطيمة حين ينشا ، % ورقة منظر الخد اللطيم % 6(@)(@@) % بنوار عن الأنوار يغني ، % وزهر النجم عن زهر النجوم % 7(@)(@@) % نزلنا فيه ، والأكباد حرى ، % فنجانا من الكرب العظيم % 8(@)(@@) % فروح ظله روح الأماني ، % وأخمد برده نفس السموم % % 9(@)(@@) % ونفس إذ تنفس من كروبي ، % وفرج ، حين أرج ، من همومي % % 10(@)(@@) % وأفرشنا من الأزهار بسطا % مسردقة ، بأستار الغيوم % PageV01P408 11(@)(@@) % جمعنا للمسامع في ذراه ، % هديل حمائم وهدير كوم % 12(@)(@@) % وقضينا به باللهو يوما ، % به سمحت حشا الدهر العقيم % PageV01P409 البحر : طويل 1(@)(@@) % وعود به عاد السرور ، لأنه % حوى اللهو قدما وهو ريان ناعم % 2(@)(@@) % يغرب في تغريده ، فكأنه % يعيد لنا ما لقنته الحمائم % PageV01P410 البحر : سريع 1(@)(@@) % عود حوت في الأرض أعواده ، % كل المعاني ، وهو رطب قويم % % 2(@)(@@) % فحاز شدو الورق في سجعه ، % ورقة الماء ولطف النسيم % % PageV01P411 البحر : متقارب تام 1(@)(@@) % معان حكت في قلوب الأنام ، % منال الأماني ونيل الأمان % 2(@)(@@) % بنثر ينظم شمل العلوم ، % ونظم يقلد جيد الزمان % 3(@)(@@) % وتنميق خط كما نمقت % خطوط الغوالي خدود الغواني % % 4(@)(@@) % وأبيات شعر ، إذا أوردت % حكت في الجمال عقود الجمان % 5(@)(@@) % فكم بكر معنى حوى طرسها ، % وإن كان في جسم لفظ عوان % 6(@)(@@) % إذا ما شققت صدور البيوت ، % وجدت بهن قلوب المعاني % % PageV01P412 البحر : كامل تام 1(@)(@@) % أشجتك بالتغريب في تغريدها ، % فظننت معبد كان بعض عبيدها % % 2(@)(@@) % وشدت فأيقظت الرقود بشدوها ، % وأعارت الأيقاظ طيب رقودها % % 3(@)(@@) % خود شدت بلسانها وبنانها % % حتى تشابه ضربها ونشيدها % % 4(@)(@@) % فكأن نغمة عودها في صوتها ، % وكأن رقة صوتها في عودها % % 5(@)(@@) % فطنت لأبعاد الشدود ، فناسبت % بالعدل بين قريبها وبعيدها % % 6(@)(@@) % كملت صنائع وضعها فكأنما % % ورثت أصول العلم عن داودها % % 7(@)(@@) % تسبي العقول فصاحة وصباحة ، % فتحار بين طريفها وتليدها % % 8(@)(@@) % من لهجة مكسوبة ، أو بهجة % منسوبة ، تحلو لعين حسودها % % 9(@)(@@) % إني 
ms116	 لأحسد عودها إن عانقت % عطفيه ، أو ضمته بين نهودها % % 10(@)(@@) % وأغار من لثم الكؤوس لثغرها ، % وأذوب من لمس الحلي لجيدها % % PageV01P413 البحر : طويل 1(@)(@@) % وإني لألهو بالمدام ، وإنها % % لمورد حزم إن فعلت ومصدر % 2(@)(@@) % ويطربني في مجلس الأنس بيننا % % أنابيب في أجوافها الريح تصفر % 3(@)(@@) % ودهم بأيدي الغانيات تقعقعت % مفاصلها من هول ما تتنظر % 4(@)(@@) % وصفر جفون ما بكت بمدامع ، % ولكنها روح تذوب وتقطر % 5(@)(@@) % وأشمط محني الضلوع على لظى % % به الضر إلا أنه يتستر % 6(@)(@@) % إذا انجاب جنح الليل ظلت ضلوعه % % مجردة تضحى لديك وتعصر % PageV01P414 البحر : وافر تام 1(@)(@@) % ومجلس لذة أمسى دجاه ، % يضيء كأنه صبح منير % 2(@)(@@) % تجمع فيه مشموم وراح ، % وأوتار وولدان وحور % 3(@)(@@) % تلذذت الحواس اللمس فيه % % نجمس يستتم بها السرور % 4(@)(@@) % فكان الضم قسم اللمس فيه ، % وقسم الذوق كاسات تدور % 5(@)(@@) % وللسمع الأغاني ، والغواني % % لأعيننا ، وللشم البخور % PageV01P415 البحر : كامل تام 1(@)(@@) % في الشمع أوصاف كوصفي أوجبت % حبي له والبعد عن أضداده % % 2(@)(@@) % جريان أدمعه وصفرة لونه ، % وسهاد مقلته وذوب فؤاده % PageV01P416 البحر : رمل تام 1(@)(@@) % جلت الظلماء باللهب ، % إذا بدت في الليل كالشهب % 2(@)(@@) % فانحلت في تاجها ، فجلت % ظلم الأحزان والكرب % 3(@)(@@) % خرد شابت ذوائبها ، % وفروع الليل لم تشب % 4(@)(@@) % سفرت كالشمس ضاحكة % من تواري الشمس في الحجب % 5(@)(@@) % ما رأينا قبل منظرها ، % ضاحكا في زي منتحب % 6(@)(@@) % كيف لا تحلو ضرائبها ، % وبها ضرب من الضرب % 7(@)(@@) % خلتها ، والليل معتكر ، % ونجوم الأفق لم تغب % 8(@)(@@) % قضبا من فضة غرست % فوق كثبان من الذهب % 9(@)(@@) % أو يواقيتا منضدة ، % بين كثبان من الذهب % 10(@)(@@) % % بين أيدينا على قضب % PageV01P417 11(@)(@@) % أو أساريعا على عمد ، % أشرقت في زي مرتقب % 12(@)(@@) % أو رماحا في العدى طعنت ، % فغدت محمرة العذب % 13(@)(@@) % أو سهاما نصلها ذهب ، % لسوى الظلماء لم تصب % 14(@)(@@) % أو أعالي حمر ألوية % تشرت في جحفل لجب % 15(@)(@@) % أو شعاف الروم قد رفعت % فوق أطراف القنا الأشب % 16(@)(@@) % أو قيانا من ذوائبها % % شف للشم لم يغب % 17(@)(@@) % أو شواظا للقرى رفعت % تتراءى 
ms117	 في ذرى كثب % 18(@)(@@) % أو لظى نار الحباحب قد % % لمعت للعين عن لبب % 19(@)(@@) % أو عيون الأسد موصدة % في ذرى غاب من القصب % 20(@)(@@) % أو خدود الغيد ساطعة % أشرقت في فاقع النقب % PageV01P418 21(@)(@@) % أو شقيق الروض منتظما % فوق مجدول من القصب % 22(@)(@@) % أو ذرى نيلوفر رفعت % فوق قضبان من الغرب % PageV01P419 البحر : خفيف تام 1(@)(@@) % مرحبا مرحبا بأبطال لهو ، % شهبهم سمرهم إذا الليل جنا % % 2(@)(@@) % مزقوا جحفل الظلام وخاضوا % % نقعه بالضياء فانجاب عنا % % 3(@)(@@) % برماح لها أسنة نار ، % قد أبادت عساكر الليل طعنا % % 4(@)(@@) % تتثنى ، سنانها غير وان ، % وقناها بالعز لا تتثنى % % 5(@)(@@) % إن أرادوا لها على الوشي ركزا % وضعوا تحت كل لدن مجنا % % PageV01P420 البحر : مجزوء الرمل 1(@)(@@) % أنكر الصبح دم اللي % % ل ، وفي العذر توصل % % 2(@)(@@) % وتردى من شعاع ال % % شمس ثوبا لم يفصل % % 3(@)(@@) % فبكى الطير بنوح % أجمل القول وفصل % % 4(@)(@@) % قال : عذر الصبح في % % كاره لا يتحصل % % 5(@)(@@) % دمه في بردتيه ، % وهو منه يتنصل % % PageV01P421 البحر : - 1(@)(@@) % وإبرق له نطق عجيب ، % إذا ما أسلت منه السلاف % 2(@)(@@) % كفأفاء تلجلج في حديث % يردد لفظه والفاء قاف % PageV01P422 البحر : بسيط تام 1(@)(@@) % بحر من الحسن لا ينجو الغريق به ، % إذا تلاطم أعطاف بأعطاف % 2(@)(@@) % ما حركته نسيم الرقص من مرح % إلا وماجت به أمواج أرداف % PageV01P423 البحر : بسيط تام 1(@)(@@) % لم أنسن ما عشت ، حماما دخلت به % % ما بين كل رخيم الدل فتان % 2(@)(@@) % في جنة من طباع أربع جمعت : % أرض وماء وأهواء ونيران % 3(@)(@@) % فنلت من حرذها بردا على كبدي ، % وفزت من مالك منها برضوان % 4(@)(@@) % فأعجب لها جنة فيها جحيم لظى % % تذكى ولم تخل عن حور وولدان % PageV01P424 البحر : وافر تام 1(@)(@@) % لئن لم يمض لي حد فكم قد % % فللت الحد في الحرب العوان % 2(@)(@@) % وإني لا أزال أخا حروب ، % إذا لم أجن كنت مجن جان % PageV01P425 البحر : متقارب تام 1(@)(@@) % وباب ، إذا أمه قاصد ، % رآه من الغيث أدنى وأندى % % 2(@)(@@) % له الفتح دأب ، ومن شأنه % % يرد وقاصده لن يردا % % PageV01P426 البحر : منسرح 1 
ms118	(@)(@@) % ما بعد بغداد للنفوس هوى ، % رق هواها وراق منظرها % % 2(@)(@@) % كأنها جنة مزخرفة % ونهر عيسى النمير كوثرها % % PageV01P427 البحر : بسيط تام 1(@)(@@) % انظر إلى بركة الجسرين حين بدا % % للبدر فيها عمود ساطع اللهب % 2(@)(@@) % كالصرح حف به سكران من سبج % وسال في وسطه نهر من الذهب % % PageV01P428 البحر : مجزوء الكامل 1(@)(@@) % وكأن دجلة ، والريا % % ح تغير كالخيل النوازي % % 2(@)(@@) % والحسر واهي السلك من % % فرط أطراب واهتزاز % 3(@)(@@) % ثوب تجندره الريا % % ح ، وقد أضرت بالطراز % PageV01P429 البحر : خفيف تام 1(@)(@@) % حبذا أرض ماردين وبر ال % % ظل فيها وماؤها وهواها % % 2(@)(@@) % بلدة تنبت الكرام فلا ذق % ت فناهم ولا عدمت فناها % % 3(@)(@@) % فهي أرض إن لم تكن هي ذات ال % % نفس مني ، فإنها مشتهاها % % 4(@)(@@) % جمعت سائر المنى ، فلهذا % % ما أتاها ذو الحلم إلا وتاها % % 5(@)(@@) % كم رأينا لها وفيها ومنها % % صورا تسفك الدماء دماها % % 6(@)(@@) % لو تمكنت أن أقضي بها العم % % ر جميعا لما سكنت سواها % % PageV01P430 البحر : كامل تام 1(@)(@@) % لله وادي الغرس حين حللته ، % زمنا كأن العيش فيه منام % 2(@)(@@) % واد حريري الرياض فكم به % % من حارث يغدو به وهمام % 3(@)(@@) % ممتد أودية الظلال فقره % % باكي العيون وثغره بسام % 4(@)(@@) % فالشمس فيه مدى النهار فطيمة ، % والظل كهل ، والنسيم غلام % PageV01P431 البحر : كامل تام 1(@)(@@) % لله قاهرة المعز ، فإنها % % بلد تخصص بالمسرة والهنا % % 2(@)(@@) % أوما ترى في كل قطر منية % من جانبيها ، وهي مجتمع المنى % % PageV01P432 البحر : طويل 1(@)(@@) % وفي النيل ، إذ وفى البسيطة حقها ، % وزاد على ما جاءه من صنائع % 2(@)(@@) % فما إن توفى الناس من شكر منعم % % يشار إلى إنعامه بالأصابع % PageV01P433 البحر : سريع 1(@)(@@) % لئن وهى عقد السحاب الثمين % % فلا عدا ربعك يا ماردين % % 2(@)(@@) % مدينة لم تر في جوها % % جورا ، ولا في أهلها ماردين % % 3(@)(@@) % كما شاهدت عيناي من أهلها % % إظهار معروف وإضمار دين % % 4(@)(@@) % أفاضل في غيهم ما ردوا ، % ونسوة في مثله ما ردين % % PageV01P434 البحر : مجتث 1(@)(@@) % ما حلة ابن دبيس ، % إلا كحصن حصين % 2(@)(@@) % للقلب فيها قرار ، % وقرة للعيون % 3(@)(@@) % إن 
ms119	 أصبح الماء غورا % جاءت بماء معين % 4(@)(@@) % وحولها سور طين ، % كأنه طور سين % PageV01P435 البحر : خفيف تام 1(@)(@@) % ظن قومي أن الأساة ستبري % % داء وجدي ، وذاك شيء بعيد % 2(@)(@@) % فأتوا بالطبيب ، وهو لعمري % % في ذوي فنه مجيد مجيد % 3(@)(@@) % مذ رأى علتي ، وقد لاح للمو % % ت عليها أدلة وشهود % 4(@)(@@) % جس نبضي وقال : ما أنت شاك ؟ % قلت : نارا لم يطفها التبريد % 5(@)(@@) % فغدا يخلص الدواء ، فألفى % % نار وجدي مع الدواء تزيد % 6(@)(@@) % قال : ما كان أصل دائك هذا ؟ % قلت : طرفي ، وذاك حال شديد % 7(@)(@@) % قال : إن الهواء أحدث بلوا % % ك ، فقلت : المقصور لا الممدود % 8(@)(@@) % فانثنى حائرا ، وقال لقومي : % ما دواء العشاق إلا بعيد % PageV01P436 البحر : بسيط تام 1(@)(@@) % لله خط كتاب خلته دررا ، % أو روضة رصعتها السحب بالبرد % 2(@)(@@) % أبدت بظاهره أيدي مجلده % % نقشا على جلدة أوهت به جلدي % % PageV01P437 البحر : طويل 1(@)(@@) % كفى الشعر فخرا أنه كل مشكل % من الذكر في تفسيره جيء بالشعر % 2(@)(@@) % وإن أشكلت في الشرع غامض نكتة % إلى النظم يلجا حين يعوز بالنثر % PageV01P438 البحر : طويل 1(@)(@@) % أخلاي بالفيحاء إن طال بعدكم ، % فأنتم إلى قلبي كسحري من نحري % % 2(@)(@@) % وإن يخل من تكرار ذكري حديثكم ، % فلم يخل يوما من مديحكم شعري % % 3(@)(@@) % فوالله لا يشفي نزيف هواكم % سوى خمر أنس كان منكم بها سكري % % 4(@)(@@) % أرى كل ذي داء يداوى بضده ، % وليس يداوى ذو الخمار بلا خمر % 5(@)(@@) % أطالب نفسي بالتصبر عنكم ، % وأول ما أفقدت ، بعدكم ، صبري % % 6(@)(@@) % فإن كان عصر الأنس منكم قد انقضى ، % فوالعصر إني بعد ذلك في خسر % 7(@)(@@) % بكيت لفقد الأربع الخضر منكم ، % على الرملة الفيحاء بالأربع الحمر % 8(@)(@@) % فكيف بقي إنسان عيني ، وقد مضى % % على ذلك الإنسان حين من الدهر % 9(@)(@@) % سقى روضة السعدي من أرض بابل % سحاب ضحوك البرق منتحب القطر % 10(@)(@@) % وحيا الحيا مغنى قضيت بربعه % فروض الصبا ما بين رملة والجسر % PageV01P439 11(@)(@@) % ورب نسيم مر لي من دياركم ، % ففاح لنا من طيه طيب النشر % 12(@)(@@) % وأذكرني عهدا ، وما كنت ناسيا 
ms120	 ، % ولكنه تجديد ذكر على ذكر % 13(@)(@@) % فيا أيها الشيخ الذي عقد حبه % تنزلض مني منزل الروح من صدري % % 14(@)(@@) % تجاذبني الأشواق نحو دياركم ، % وأحذر من كيد العدو الذي يدري % % 15(@)(@@) % مخافة ض مذاق اللسان يسر لي % % ضروب الردي بين البشاشة والبشر % 16(@)(@@) % وينثر لي حب الوفاء تملقا % وينصب لي من تحته شرك الغدرش % % 17(@)(@@) % وما أنا من يلقي إلى الحتف نفسه ، % ويجهد في استخلاصها منه بالقسر % 18(@)(@@) % إذا كان ذكر المرء شيخ حياته ، % فإن طريف المال كالواو في عمرو % % 19(@)(@@) % ولكن لي في ماردين معاشرا ، % شددت بهم ، لما حللت بها ، أزري % % 20(@)(@@) % ملوك ، إذا ألقى الزمان حباله ، % جعلتهم في كل نائبة ذخري % % PageV01P440 21(@)(@@) % وما أحدثت أيدي الزمان إساءة ، % ووافيتهم إلا انتقمت من الدهر % 22(@)(@@) % إذا جئتهم مستصرخا حقنوا دمي ، % وإن جئتهم مستجديا وفروا وفري % % 23(@)(@@) % عزائم من لم يخش بالبطش من ردى ، % وإنعام من لم يخش بالجود من فقر % 24(@)(@@) % ورووا بماء الجود غرس أبيهم ، % فأينع في أغصانه ثمر الشكر % 25(@)(@@) % وقلدني السلطان منه بأنعم ، % أخف بها نهضي وإن أثقلت ظهري % % 26(@)(@@) % هو الصالح الملك الذي صلحت به % % أمور الورى واستبدل العسر باليسر % 27(@)(@@) % يبيت بها كفي على الفتح بعدما % % بنت نوب الأيام قلبي على الكسر % 28(@)(@@) % وبدلت من دهم الليالي وغيرها ، % لديه ، بأيام محجلة غر % 29(@)(@@) % حططت رحالي في ربيع ربوعه ، % ولولاه لم أثن الأعنة عن مصري % % 30(@)(@@) % منازل ما لاقيت فيها ندامة ، % سوى أنني قضيت في غيرها عمري % % PageV01P441 31(@)(@@) % فلم يك كالفردوس غير سميه ، % من الخلد لا خلد الخليفة والقصر % 32(@)(@@) % وواد حكى الخنساء لا في شجونها ، % ولكن له عينان تجري على صخر % 33(@)(@@) % كأن به الجودان بالسحب شامت ، % فما انتحبت إلا انثنى باسم الثغر % 34(@)(@@) % تعانقت الأغصان فيه فأسبلت % على الروض أستارا من الورق الخضر % 35(@)(@@) % إذا ما حبال الشمس منها تخلصت % إلى روضه ألقت شراكا من التبر % 36(@)(@@) % تدار به ، من دير شهلان ، قهوة % جلتها لنا أيدي القسوس من الخدر % 37(@)(@@) % إذا ما حسوناها ، وسار سرورها 