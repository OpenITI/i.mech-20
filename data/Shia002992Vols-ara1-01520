ms1512	(@)(@@) الكافي: ج 7، ك 7، ب 18، ح 4.(@)(@@) * وروى عن يعقوب بن جعفر، وروى عنه القاسم بن يحيى.(@)(@@) الكافي: ج 6، ك 9، ب 2، ح 13، وب 7، ح 9. التهذيب: ج 6، ح 307.(@)(@@) وروى عنه محمد بن أبي عبد الله مرفوعا.(@)(@@) الكافي: ج 1، ك 3، ب 19، ح 2.(@)(@@) وروى عنه محمد بن علي.(@)(@@) الكافي: ج 1، ك 4، ب 120، ح 5.(@)(@@) * وروى عن يعقوب بن جعفر بن إبراهيم، وروى عنه محمد بن علي.(@)(@@) الكافي: ج 1، ك 4، ب 120، ح 4.(@)(@@) * وروى عن يعقوب بن جعفر بن إبراهيم الجعفري، وروى عنه القاسم ابن يحيى.(@)(@@) الكافي: ج 5، ك 1، ب 22، ح 4، والكافي:(@)(@@) ج 6، ك 9، ب 9، ح 3.(@)(@@) * وروى عن يعقوب بن جعفر الجعفري، وروى عنه علي بن العباس الجراذيني.(@)(@@) الكافي: ج 1، ك 3، ب 19، ح 1.(@)(@@) * وروى عن يعقوب الجعفي، وروى عنه القاسم بن يحيى.(@)(@@) الفقيه: ج 3، ح 1340. والتهذيب: ج 7، ح 1972 كذا في الطبعة القديمة منها والوافي والوسائل أيضا، لكن الموجود في الخصال: الحديث 21 من أبواب الستة والعيون: الجزء 1، ب 28، الحديث 17.(@)(@@) يعقوب الجعفري، وهو الصحيح بقرينة سائر الروايات المتقدمة عليها.(@)(@@) * وروى عن يونس بن ظبيان، وروى عنه محمد بن القاسم بن يحيى.(@)(@@) التهذيب: ج 6، ح 119، كذا في الطبعة القديمة والوافي أيضا لكن الموجود في كامل الزيارات: الباب 72، الحديث 107 أحمد بن محمد بن عيسى، عن محمد بن خالد، عن القاسم بن يحيى عن جده إلا أن فيه الحسين بن راشد بدل الحسن بن راشد.(@)(@@) * وروى عن جده، عن أبي عبد الله PageV05P481(@)(@@) (عليه السلام)، وروى عنه محمد بن عمر ابن مسعدة.(@)(@@) الكافي: ج 2، ك 3، ب 7، ح 4.(@)(@@) * وروى عن بعض أصحابنا، عن مسمع كردين، وروى عنه علي بن الريان.(@)(@@) التهذيب: ج 1، ح 979.(@)(@@) * وروى عن بعض أصحابه، عن مسمع، وروى عنه علي بن الريان بن الصلت.(@)(@@) التهذيب: ج 1، ح 1145.(@)(@@) * وروى مرسلا عن رسول الله (صلى الله عليه وآله)، وروى عنه القاسم بن يحيى.(@)(@@) الكافي: ج 6، ك 8، ب 38، ح 1.(@)(@@) * وروى مضمرا، وروى عنه محمد ابن عيسى.(@)(@@) التهذيب: ج 1، ح 1396 (الاستبصار:(@)(@@) ج 1، ح 744).(@)(@@) الحسن بن زياد * روى عن أبي عبد الله (عليه السلام). 
ms1513	(@)(@@) الفقيه: ج 1، ح 409.(@)(@@) وروى عنه أبو جميلة.(@)(@@) الكافي: ج 5، ك 3، ب 53، ح 4.(@)(@@) والتهذيب: ج 7، ح 1463 (الاستبصار:(@)(@@) ج 3، ح 809).(@)(@@) وروى عنه أبو همام.(@)(@@) التهذيب: ج 4، ح 358، 390.(@)(@@) وروى عنه ابن بكير.(@)(@@) الكافي: ج 3، ك 4، ب 26، ح 3.(@)(@@) والتهذيب: ج 2، ح 1210 (الاستبصار:(@)(@@) ج 1، ح 1214)، والتهذيب: ج 8، ح 786 (الاستبصار: ج 4، ح 3).(@)(@@) وروى عنه ابن مسكان.(@)(@@) الكافي: ج 5، ك 3، ب 56، ح 6، وب 118، ح 2، وب 124، ح 1، والكافي: ج 6، ك 2، ب 43، ح 4. والفقيه:(@)(@@) ج 3، ح 1619. والتهذيب: ج 7، ح 1528 (الاستبصار: ج 3، ح 840).(@)(@@) وروى عنه أبان.(@)(@@) التهذيب: ج 8، ح 55.(@)(@@) وروى عنه أبان بن عثمان.(@)(@@) الكافي: ج 4، ك 3، ب 92، ح 7.(@)(@@) وروى عنه صفوان بن يحيى.(@)(@@) الكافي: ج 6، ك 2، ب 8، ح 5.(@)(@@) وروى عنه عبد الله بن بكير.(@)(@@) التهذيب: ج 2، ح 164.(@)(@@) وروى عنه عبد الله بن مسكان. PageV05P482(@)(@@) التهذيب: ج 7، ح 1410 (الاستبصار:(@)(@@) ج 3، ح 866) و 1679 (الاستبصار:(@)(@@) ج 3، ح 866)، والتهذيب: ج 8، ح 438 (الاستبصار: ج 3، ح 1178).(@)(@@) وروى عنه عبد الكريم.(@)(@@) الكافي: ج 6، ك 2، ب 8، ح 5.(@)(@@) وروى عنه عبد الكريم بن عمرو.(@)(@@) الكافي: ج 3، ك 1، ب 12، ح 10.(@)(@@) والفقيه: ج 3، ح 1568. والتهذيب: ج 1، ح 789 (الاستبصار: ج 1، ح 632).(@)(@@) * وروى عنه الفضيل بن يسار، وروى عنه فضالة بن أيوب.(@)(@@) الكافي: ج 1، ك 4، ب 19، ح 7.(@)(@@) * وروى عن محمد بن الحسن الميثمي، وروى عنه يعقوب بن يزيد.(@)(@@) الكافي: ج 1، ك 4، ب 52، ح 9.(@)(@@) * وروى عن محمد بن مسلم، وروى عنه ابن مسكان.(@)(@@) الكافي: ج 5، ك 3، ب 76، ح 6.(@)(@@) والتهذيب: ج 7، ح 1201.(@)(@@) * وروى مضمرة، وروى عنه عبد الله ابن مسكان.(@)(@@) التهذيب: ج 8، ح 763 (الاستبصار:(@)(@@) ج 3، ح 736).(@)(@@) الحسن بن زياد الصيقل * روى عن أبي عبد الله (عليه السلام).(@)(@@) الفقيه: ج 1، ح 479.(@)(@@) وروى عنه ابن مسكان.(@)(@@) الكافي: ج 3، ك 3، ب 24، ح 1.(@)(@@) والتهذيب: ج 1، ح 954، والتهذيب:(@)(@@) ج 2، ح 656 (الاستبصار: ج 1، ح 1081) و 1075.(@)(@@) وروى عنه أبان.(@)(@@) التهذيب: ج 7، ح 978 (الاستبصار:(@)(@@) ج 3، ح 482).(@)(@@) وروى عنه أبان بن عث