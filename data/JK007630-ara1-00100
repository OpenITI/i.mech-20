ms81	(@)(@@) % ركودي إلى الجو العريض ركوده % إذا رام أمرا أو هبوبي هبوبه % 20(@)(@@) % و أصفح عنه عاذرا متأولا % % و إن كثرت زلاته وذنوبه % PageV01P238 21(@)(@@) % و يقنعني منه ظهارة وجهه % فلا أسأل التفتيش كيف مغيبه % 22(@)(@@) % و من طال عن خبر الأخلاء بحثه % ليبلوهم لم يخل مما يريبه % 23(@)(@@) % دعيني يكن خصمي زماني وحده % و تكفيك لي أحداثه وخطوبه % 24(@)(@@) % هو الطرف غرت رحلتي خطواته % و زمت فكان الليث صعبا ركوبه % 25(@)(@@) % أصافح من كفيه صل خديعة % لغير التحايا أهله ورحيبه % 26(@)(@@) % و لولا رجال هم أساة جروحه % جرت بدمي أظفاره ونيوبه % 27(@)(@@) % لتسق بني عبد الرحيم أكفهم % % فأروى الحيا وكافه وصبيبه % 28(@)(@@) % و ما السيل ذو الدفاع يرغو جفاؤه % % بأمرع من واد نداهم يصوبه % 29(@)(@@) % هم القاتلون الأزم والعام مسنت % يقطب في وجه المسيم جدوبه % 30(@)(@@) % و هم إن شكا الفضل الغريب انفراده % % قبائله دون الورى وشعوبه % PageV01P239 31(@)(@@) % ملوك على الأيام بيت علائهم % % تناط بأعناق النجوم طنوبه % 32(@)(@@) % ربا الملك طفلا ناشئا في حجورهم % % و أشيب هذا الدهر بعد ربيبه % 33(@)(@@) % لهم تاجه المعصوب أيام تاجه % و فيهم أخيرا سيفه وقضيبه % 34(@)(@@) % مواريث فيهم نصها إن مضى أب % يسد الذي سد ابنه وينوبه % 35(@)(@@) % و أمواتهم فيهم كأحياء غيرهم % % إذا ظلع المركوب جاء جنيبه % 36(@)(@@) % إذا ما زعيم الدين حدث عنهم % توارد شبان الفخار وشيبه % 37(@)(@@) % هو البلجة البيضاء في وجه عزهم % % إذا شان عز القوم بابن شحوبه % 38(@)(@@) % يرى نصرهم ما سار من حسن ذكرهم % % فتنشره أفعاله وتطيبه % 39(@)(@@) % فتى كملت فيه أداة اكتهاله % و غصن الصبا لم يعس بعد رطيبه % 40(@)(@@) % تحمل أعباء الرياسة ناهضا % % فما لان من عرض الرجال صليبه % PageV01P240 41(@)(@@) % و من عجب أن البكار جليدة % و قد عقرت بزل الطريق ونيبه % 42(@)(@@) % و كم سابق فيهم ولم يحف رسغه % و لا ابتل في شوط الرهان سبيبه % 43(@)(@@) % و من منجب فيه أبوه وأمه % و ما ولد الإنسان إلا نجيبه % 44(@)(@@) % لهم يوم يحتد الجلاد كميه % و 
ms82	 يوم الترامي بالكلام خطيبه % 45(@)(@@) % فلا محفل إلا وفيهم صدوره % و لا جحفل إلا وفيهم قلوبه % 46(@)(@@) % أبا حسن باهل بهن فضائلا % % لحاسدها حر الجوى ولهيبه % 47(@)(@@) % يعيبك مثني على الغيظ صدره % خوافقه تزوى به ووجيبه % 48(@)(@@) % و كيف ينال العيب أطراف ماجد % محاسن أبناء الزمان عيوبه % 49(@)(@@) % و قال وهل في الناس من هو فوقه % % فقلت نعم . إن كان فيهم ضريبه % 50(@)(@@) % كريم إذا ما ظل يقسم ماله % فانزره مستقسما ما يصيبه % PageV01P241 51(@)(@@) % يحب ثراء المال حبا لبذله % % و ليس كسوب المال إلا وهوبه % 52(@)(@@) % أطلت يدي بالنصر في نيل مطلبي % % فأصبح لي أقصاه وهو قريبه % 53(@)(@@) % و أمكنتني من ظهر حظي وعرفه % فأسمح لي بعد الشماس ركوبه % 54(@)(@@) % و أغنيتني عن كل مرعى أروده % و فج على تيه الطريق أجوبه % 55(@)(@@) % و كم جمد الرزق البطيء على يدي % % فسلسلت من كفيك ماء يذيبه % 56(@)(@@) % و لا خلف إلا من عصابك دره % و لا جفر إلا من نداك ذنوبه % 57(@)(@@) % إذا روعت سرحي من الدهر روعة % زأرت فلم يعسل من الخوف ذيبه % 58(@)(@@) % فقد صار يحبوني الذي ما سألته % و يخطب مني المدح من لا أجيبه % 59(@)(@@) % فلا يخب من نعماك بدر أضاء لي % % زماني ولا نجم هداني ثقوبه % 60(@)(@@) % و لا تتغير من وفائك عادة % يرى المجد في أثنائها ما يعيبه % PageV01P242 61(@)(@@) % و لا برحت تطرو اليك شوارد % يلين لها وعر الفلا وسهوبه % 62(@)(@@) % مطبقة ما طبق الأفق سيرها % % بوصفك مسرى ليلها وذؤوبه % 63(@)(@@) % من الكلم السهل المنيع مرامعة % على الناس والنزر الكثير عجيبه % 64(@)(@@) % ترقرق حسنا فامترى كل سامع % % به وهو مخلوب الفؤاد طروبه % 65(@)(@@) % أسربل منه المهرجان مفاضة % يصان بها عريانه وسليبه % 66(@)(@@) % ينوبان من ناديك أمنع جانب % و أنضر ربع غضه وقشيبه % 67(@)(@@) % مدى الدهر ما هب النسيم لناشق % و دب على وجه الصعيد دبيبه % 68(@)(@@) % على شرط عز لا تحول رسومه % و سرح نعيم لا تراع سروبه % PageV01P243 البحر : - 1(@)(@@) % يا قلب من أين على 
ms83	 فترة % رد عليك الولة العازب % 2(@)(@@) % أبعد أن مات شباب الهوى % % شاورك المحتنك الشائب % 3(@)(@@) % و بعد خمسين قضت ما قضت % و فضلة أغفلها الحاسب % 4(@)(@@) % هبت بأشواقك نجدية % مطمعة أنت لها واجب % 5(@)(@@) % ما أنت يا قلب وأهل الحمى % % و إنما هم أمسك الذاهب % 6(@)(@@) % لم تذكر الغائب من عهدهم % % إلا لأن يأكلك الغائب % 7(@)(@@) % قد وعظت واعظة من جحا % % بوعظها ما زهد الراغب % 8(@)(@@) % فاردد على الريح أحاديثها % % ففي صباها ناقل كاذب % 9(@)(@@) % جاءت وقد أفرقت تهدي الصبا % % لا سلم المجلوب والجالب % 10(@)(@@) % و دون نجد وظباء الحمى % % أن نفرع المنسم والغارب % PageV01P244 11(@)(@@) % و الفيلق الشهباء من عامر % و الطاعنالغيران والضارب % 12(@)(@@) % و الشمس أدنى من تميمية % طالعها من رامة غارب % 13(@)(@@) % لو سبقت بالغدر في قومها % % لما وفي في قوسه حاجب % 14(@)(@@) % مكنونة بيضاء لم يعدها % % في البدو لون العرب الشاحب % 15(@)(@@) % إن وصفت تيمها وصفها % % أو نسبت أعجبها الناسب % 16(@)(@@) % فلا تغرنك تفاحة % منها ولا بارقة خالب % 17(@)(@@) % يا راكب الأخطار تهوى به % % انزل كفيت السير يا راكب % 18(@)(@@) % مالك والراحة قد أمكنت % تشقى بما أنت له طالب % 19(@)(@@) % قد آن أن يعفى الكليل المطا % % و أن يراح النصب اللاغب % 20(@)(@@) % إن المقيم اليوم في غبطة % يحسدها السارح والسارب % PageV01P245 21(@)(@@) % قد أربع الوادي ببغداد واب % % تل الثرى واتسع الجانب % 22(@)(@@) % أظلها من سحب أيدي بني % % عبد الرحيم الهاطل الهاضب % 23(@)(@@) % و رجعت طالعة شمسهم % % فيها وعاد الكوكب الثاقب % 24(@)(@@) % إلى عميد الدولة استرجع ال % % نافر أنسا وأوى الهارب % 25(@)(@@) % عم وسوى عادلا جوده % حتى استوى المحروم والكاسب % 26(@)(@@) % طبق في التدبير أغراضه % سهما فسهما رأيه الصائب % 27(@)(@@) % و أدب الأيام بالحلم وال % % جهل على أخلاقها غالب % 28(@)(@@) % و الملك سرح نام رعيانه % و هب يطغى ذئبه السارب % 29(@)(@@) % كانت جحيما ترتمي بالأذى % % في جانبيها الشرر اللاهب % 30(@)(@@) % فأخمدت هيبته كل ما % % هب عليها الموقد الحاطب % PageV01P246 31(@)(@@) % صب عليها الدم لما غدت % بالماء لا يطفئها الساكب % 32 
ms84	(@)(@@) % فهامة ساقطة فوقها % % حصدا وجنب حولها واجب % 33(@)(@@) % عشواء خطب لم يكن ينجلي % % حتى يؤوب القمر الغائب % 34(@)(@@) % يا شرف الدين تمدح بها % % فالعجب في أمثالها واجب % 35(@)(@@) % ما زال تنكيلك بالمجرم ال % % مصر حتى خافك التائب % 36(@)(@@) % صدع من الدنيا تداركته % لولاك ما كان له شاعب % 37(@)(@@) % جاذبه الناس يرومونه % دهرا فلم يعلق به جاذب % 38(@)(@@) % لا العاجز الواني تأنى له % % منهم ولا المجتهد الدائب % 39(@)(@@) % سللت بالعادة في جسمه % % رأيا هو الصمصامة القاضب % 40(@)(@@) % قد ظهرت راية أيامكم % % و طبق الأرض بها الجائب % PageV01P247 41(@)(@@) % و جمع الألسن تفضيلكم % % فاصطلح المادح والثالب % 42(@)(@@) % لا يصلح الأمر على غيركم % % لا عارض منه ولا راتب % 43(@)(@@) % و لا تدر المال أخلافه % و غير أيديكم له حالب % 44(@)(@@) % وزارة مجلسها منصب % له اصطفاك الله والناصب % 45(@)(@@) % أنت لها فاشدد يمينا بها % % الأخ وابن العم والصاحب % 46(@)(@@) % فإن تعزلت وفارقتها % % أو ناب في تدبيرها نائب % 47(@)(@@) % كان فراقا لك تسديده % و للأعادي سهمه الخائب % 48(@)(@@) % بعدت فانحض الذي رشته % و انقبض السائم والسارب % 49(@)(@@) % فاعطف على الدنيا وما قد جرى % % به عليه القدر اللازب % 50(@)(@@) % فالليث لا يغمز في زأره % % و إن ألح النابح الواثب % PageV01P248 51(@)(@@) % في جلده ذمي وفي عظمه % مظفر في عزكم خالب % 52(@)(@@) % مشى بها الماشي إلى حتفه % % يا بؤس ما أعقبه العاقب % 53(@)(@@) % يا باسطا من كفه مزنة % يبسم منها البلد القاطب % 54(@)(@@) % و من حمى الأرض فما فوقها % % للخوف مسلوب ولا سالب % 55(@)(@@) % و المصطفى المحبوب من ماله % % يخبط فيه العائث الناهب % 56(@)(@@) % أغنيتني عن كل غرارة % سحابها المصعق والحاصب % 57(@)(@@) % و كل مبذول الحمى بابه % و اللؤم عن أمواله حاجب % 58(@)(@@) % لا يخلق الخجلة في وجهه % % لا مادح أثنى ولا عائب % 59(@)(@@) % و صنت وجهي بعد ما شفني % % من مائه المنزف والناضب % 60(@)(@@) % و خلطتني منك نعمى بها % % شجرني في بيتك الناسب % PageV01P249 61(@)(@@) % و حطتني أمنا وقد ثار لي % % بالشر صل الرملة الواقب % 62(@)(@@) % كلب أتى الليث 
ms85	 فأغراه بي % % و قال وهو الفاجر الكاذب % 63(@)(@@) % وغد دعي ليس من شكله % % ما هو كاس باسمه كاسب % 64(@)(@@) % أعداه من مهنة آبائه % عرق إلى اللؤوم به ضارب % 65(@)(@@) % و لم يكن لو أنه كاتب % يراع منه الشاعر الكاتب % 66(@)(@@) % و عند شعري لو هجا مثله % لعرضه القاصم والقاصب % 67(@)(@@) % فابق لأن ترغم لي أنفه % أنف لعمري أجدع تارب % 68(@)(@@) % و البس من الدولة فضفاضة % يسحب من أذيالها الساحب % 69(@)(@@) % و اقسم ليوم المهرجان الحيا % % وفدا فنعم الوافد الآئب % 70(@)(@@) % يوم لآبائك في حفظه % % عهد يراعى حقه الواجب % PageV01P250 71(@)(@@) % و اصبح بفخر طيره أيمن % % و في عداك البارح الناعب % 72(@)(@@) % ما غردت ورقاء أو دافعت % فتخاء عن أفراخها خاضب % 73(@)(@@) % و اسمع إذا شدت لها حبوتي % % أفصح ما فاه به خاطب % 74(@)(@@) % مرصوعة باسمك من خير ما % % لاث على مفرقه عاصب % 75(@)(@@) % عندك منها غرد مطرب % و عند من عاديته نادب % 76(@)(@@) % من معدن الجد ولكن ترى % % رقتها أني بها لاعب % 77(@)(@@) % لا رب غمدان وعى مثلها % % سمعا ولا من داره مارب % 78(@)(@@) % و امض مع العادة في مهرها % % على طريق نهجه لاحب % 79(@)(@@) % فما تطيب الأرض موهوبة % عندي لولا أنك الواهب % PageV01P251 البحر : - 1(@)(@@) % عزفت فما أدري الفتى كيف يرغب % و عفت فما أشكو القذى كيف يشرب % 2(@)(@@) % و روضني لليأس هجر مطامعي % % فبغض عندي الوفر وهو محبب % 3(@)(@@) % رأيت الغنى ما ند عني ففاتني % % فكيف يخاف الفوت من ليس يطلب % 4(@)(@@) % و أرضى عن الأقدار كيف تصرفت % % و غيري بالأقدار يرضى ويغضب % 5(@)(@@) % أأشري بعرضي رفد قوم معوضة % و أشعر نفسي أن ذلك مكسب % 6(@)(@@) % فلا جر رزق غبطة وهو يجتدي % % و لا سد مال خلة وهو يوهب % 7(@)(@@) % هنئيا لرب الرائحات خلاصه % إذا ضافني مما يعق ويحلب % 8(@)(@@) % و من قودها لي في الصلاب ثنية % و بزلاء تعصي في القياد وتصحب % 9(@)(@@) % تركت لمعطي النائل الغمر نيله % و إني إلى ترك البخيل لأقرب % 10(@)(@@) % فلا المدح في المسنى 
ms86	 الجواد أكده % % و لا اللحز المناع ذمي يرهب % PageV01P252 11(@)(@@) % و يظلمني المولى وفي في ناصر % و كفي فلا أشكو ولا أتعتب % 12(@)(@@) % إذا ذهبت بي رغبة عن تلاده % % طريقا فما لي عنه بالود مذهب % 13(@)(@@) % له خصبه دوني ولي نوطة به % % و عون على أيامه وهو مجدب % 14(@)(@@) % و للحب مني ما أمنت خيانة % محلة قلب قلما يتقلب % 15(@)(@@) % أجر الهوى مالان فضلة مقودي % % و يعسفني حينا فآبي وأجذب % 16(@)(@@) % و ما كلما فارقت أشرب دمعتي % % و لا كلما غنى الحمام أطرب % 17(@)(@@) % و كم ألفتني ظبية وهي فذة % فملت ولم أعطف وقد عن ربرب % 18(@)(@@) % أحب الوفاء محمسا ومغزلا % % و أصحبه فيما أجد وألعب % 19(@)(@@) % و أعطى يدي ما خلتني متفضلا % % و أمنعها ما خلت أني أرغب % 20(@)(@@) % فلو لقيت أيام دهري خلائقي % % لكانت على جهلاتها تتأدب % PageV01P253 21(@)(@@) % و لو أنها للسلم جانحة معي % % لكانت على الشحناء بي تتحبب % 22(@)(@@) % و كنت لها عذرا إلى كل ماجد % يرى أنها في حرب مثلي تذنب % 23(@)(@@) % و لكنها عجماء سيان عندها % % شدا جامل أو قال هجرا مؤنب % 24(@)(@@) % تشط بأحبابي الذين أودهم % % و تدنو بجار لا أحب فتقصب % 25(@)(@@) % و لو أنها تأوى لصوني لقربت % بعيدا وشطت بالذين تقرب % 26(@)(@@) % كواكب آمالي وأقمار مطلبي % % نأتني وفي الأحباب بدر وكوكب % % 27(@)(@@) % تطلع حينا من بروج سعودها % % على ويطويها البعاد فتغرب % 28(@)(@@) % إذا قلت هذا العام حسب وبعده ال % % ثواء أتى في الأمر ما ليس يحسب % 29(@)(@@) % فكم يحمل الثقل الضعيف وكم ترى % % يقل وسوق البعد جنب مندب % 30(@)(@@) % و كم تكتسي في ظل قوم أعزة % قوادم ريشي ثم تعرى فتسلب % PageV01P254 31(@)(@@) % و يأخذ مني الحاضرون ببخلهم % % فواضل ما يعطي السماح المغيب % 32(@)(@@) % أيدري الوزير من كني عنه أو عني % % نعم هو يدري ما أعمي وأعرب % 33(@)(@@) % و إني بحبل غير أطناب بيته % % على بيت شعر ناصح لا أطنب % 34(@)(@@) % سمات بني عبد الرحيم سلائط % على وجه أشعاري تنير وتثقب % 35(@)(@@) % لهم جمتا 
ms87	 فكري مطيلا ومقصرا % % و صفوته صرفا وبالماء تقطب % 36(@)(@@) % فلو قلت إني في مديح سواهم % صدقت لقال الشعر في السر تكذب % 37(@)(@@) % هم أمكنوني من ظهور مآربي % % فأركب منها ما اشاء وأجنب % 38(@)(@@) % ألم بهم ما لا يلم بشاعب % و أرأب فيهم صدع ما ليس يرأب % 39(@)(@@) % و أستعتب الأيام وهي مصرة % بهبتهم حتى تفيء فتعتب % 40(@)(@@) % هم رحمي والأقربون معقة % و فيهم أبي البر الرؤوف ولا أب % PageV01P255 41(@)(@@) % و دولتهم لا عطلت لي مواسم % و أيامهم سوق بفضلي تجلب % 42(@)(@@) % ذخرت لهم كنزا مواريث قومهم % % فمن رامني من غيرهم فهو يغصب % 43(@)(@@) % فلا أسمعت ذبيان بعدي وبعدهم % % بني منذر عذرا به العفو يوجب % 44(@)(@@) % و لا فرحت أقيال آل أمية % بما سيرت فيها تميم وتغلب % 45(@)(@@) % أيا راكب العشواء يطرح صدرها % % خطارا على الشق الذي هو أتعب % 46(@)(@@) % ترى ظلها في الشمس تحسب أنه % % لأخرى سواها لاحقا أو ستقرب % 47(@)(@@) % تغار إذا ما ابصرت ظل سنبك % على الأرض جلى سابقا وهي تعقب % 48(@)(@@) % كأن فجاج الأرض نقد لركضها % % تغير عليه كيف شاءت وتنهب % 49(@)(@@) % تنص مقاضاتين للسير تلفظ ال % % محال وتوعي الحق نصحا فتوعب % 50(@)(@@) % و كالئة ترعى الشخوص كأنها % % أخو ليلة بات الربيئة يرقب % PageV01P256 51(@)(@@) % إذا اقتضيت في ذمة النجم حاجة % فتلك لديها دعوة لا تخيب % 52(@)(@@) % تحمل سلامي واحتقب لي حاجة % تضيء لك المسرى وطرقك غيهب % 53(@)(@@) % إلى شرف الدين انتزعها إهابها % % و دعها على نار السياط تلهب % 54(@)(@@) % إلى ملك لا يسلك النوم جفنه % و في الملك صدع بالسهاد يشعب % 55(@)(@@) % و لا تبلغ الأثقال غاية جهده % إذا ظلت البزل المصاعيب تشغب % 56(@)(@@) % تفحص في الآراء حتى أرينه % على غير فحص أي أمريه أصوب % 57(@)(@@) % و أتعبه التدبير حتى أراحه % % و قد تستريح النفس من حيث تتعب % 58(@)(@@) % فكن مبلغا عني وحظك عنده % % إذا أنت باسمي فهت أهل ومرحب % 59(@)(@@) % و قل يا عميد الدولة اعطف وإن جنت % فما زلة إلا وعفوك أرحب % 60(@)(@@) % تلاف عصاها 
ms88	 أن تشق فإنها % % بسوء القضايا تلتحي وتشذب % PageV01P257 61(@)(@@) % و دارك ذماها وهو بعد فربما % % تخور القوى أن ينفع المتطبب % 62(@)(@@) % يقربك الإقبال حينا فتؤنس ال % % حياة ويقصك الشقاء فتعطب % 63(@)(@@) % و من أعجب الأشياء تعليلها بمن % ترى عجزه من حظه يتعجب % 64(@)(@@) % فإن يبلغوا بالداء لا يحسمونه % % و عندهم منك الدواء المجرب % 65(@)(@@) % إذا طلقت منك الوزارة أصبحت % مجدذة من حسنها تتسلب % 66(@)(@@) % تغوث بالأسحار تدعو صباحها % % و تبكي زمان الوصل منك وتندب % 67(@)(@@) % تخال بها ربعا محيلا تساقطت % تحاجل فيه الساحجات وتنعب % 68(@)(@@) % بنيت بها بكر الصبا فمن الذي % % يصفي هواها وهي شمطاء ثيب % 69(@)(@@) % و أبرح من تعنيسها وهي أيم % إذا غبت من يسمى لها وهي تخطب % 70(@)(@@) % و هذا أوان الشد فانهض بحملها % % وثب واثقا إن العلاء توثب % PageV01P258 71(@)(@@) % فما كل ما استوضحت فيها هداية % و ليس ضلالا كل ما تتنكب % 72(@)(@@) % قد اشتاقك الملك الذي أنت أنسه % و أوحش صدر منه وارتاع موكب % 73(@)(@@) % و قد أعجف الرواد واعتصروا الحيا % % من الصخر إذ أمست سماؤك تحجب % 74(@)(@@) % و قص جناح الشعر لا الطبع جاريا % % يرق ولا مستولد الفكر ينجب % 75(@)(@@) % فنحن كأنا لم نصف ملكا ولم % % نقم قط ما بين السماطين نخطب % 76(@)(@@) % و كائن لنا من موقف متشهر % لديك يطيب القول فيه ويعذب % 77(@)(@@) % تميز به عنق القوافي وهجنها % % و تعلم ما ذا يجتبى ويحبب % 78(@)(@@) % و وجهك بسام إلى المدح مقبل % عليه ووجه الدهر جهم مقطب % 79(@)(@@) % و كم ثم من مسترزق حلفت له % % لهاك وبرت أنه لا يخيب % 80(@)(@@) % و عيش يبيس بالسماح بللته % و وجهك فيه من بنانك أرطب % PageV01P259 81(@)(@@) % رعى الله منك البحر لم أرو بعده % % بلى ربما أفعمت والبحر ينضب % 82(@)(@@) % و مطرح آمالي الذي كل ضيق % عليه فسيح عنده لي مرغب % 83(@)(@@) % و ما لي إذا أعسرت من كل وجهة % و جاهي الذي من بعضه المال أكسب % 84(@)(@@) % تأجن غدراني وماؤك سلسل % و تخبث أوطاني وتربك طيب % 85(@)(@@) % و 
ms89	 جودك لي سيان ما كنت حاضرا % % قريبا وما ينأى وما يتقرب % 86(@)(@@) % فلولا مضيض الشوق لم أشك غصة % و لا أجحف الترداد بي والتقلب % 87(@)(@@) % و لكنك العين التي كل غبطة % إذا هي لم توجد عناء معذب % 88(@)(@@) % فلا حولت عني ظلالك خطة % تحل ولا محذورة تترقب % 89(@)(@@) % و عشت لمثلي واحدا في زمانه % % و للناس بعدي يطلبون وتطلب % 90(@)(@@) % أجازي نداك الغمر نشرا مخلدا % % كلانا مطيل في معانيه مطنب % PageV01P260 91(@)(@@) % بكل مطاع أمرها مستجيبة % لدعوتها الأسماع تزجى وتوهب % 92(@)(@@) % تولج لا تخشى تلون آذن % لها الخلوات والرواق المحجب % 93(@)(@@) % يقر لها بالفضل من لم تقل له % % و يعظمها العياب والمتعصب % 94(@)(@@) % لها كل صوت كل راويه مبلغ % فصيح ومن غنى به فهو مطرب % 95(@)(@@) % تصفت فقد كادت مع التبر تقتنى % % و رقت فقد كادت مع الماء تشرب % 96(@)(@@) % مصدقة في المدح أسرف أو غلا % % و مأمونة ما تستزيد وتعتب % 97(@)(@@) % تزورك يوما في نديك تجتلى % % و يوما مع السفار تقرا وتكتب % 98(@)(@@) % تسوق التهاني خلفها وأمامها % % تصعد في الدنيا بكم وتصوب % 99(@)(@@) % تذكركم من حقها إن نسيتم % بما تقسم الأعياد حظا وتنصب % 100(@)(@@) % ترفع عن تيه المصيب وعجبه % و لكن بكم فخرا تتيه وتعجب % PageV01P261 البحر : - 1(@)(@@) % سل الركب إن أعطاك حاجتك الركب % من الكاعب الحسناء تمنعها كعب % 2(@)(@@) % قضى أنها مغلوبة لين عطفها % % و حصنها أن تملك الأسد الغلب % 3(@)(@@) % حموها وذابوا أن ترام وما حموا % % قلوب الهوى من مقلتيها ولا ذبوا % % 4(@)(@@) % و هزوا القنا الخطار والبيض دونها % % فمن طالب والمانع الطعن والضرب % 5(@)(@@) % يخافون صوت العار أن يصبحوا بها % % حديثا وأفواه المواسم تستب % 6(@)(@@) % و ما العار إلا أن بين بيوتهم % % قلوب المحبين السلائب والنهب % 7(@)(@@) % لئن أشحطوها أن تزار فبيننا % % مواثيق بعد الدار إن رعيت قرب % 8(@)(@@) % و إن حجبت والريح تسفر بيننا % % بنجوى فؤادينا فما ضرت الحجب % 9(@)(@@) % و في دارها بالروضتين لناظر % شفائف ضوء البدر تكفره السحب % 10(@)(@@) % و منها ومن أترابها في ثرى 
ms90	 الحمى % % عبائق تهديها الصبا لي والترب % PageV01P262 11(@)(@@) % وقفت وصحبي في اللوى فأملهم % % وقوفي حتى وقفت ولا صحب % 12(@)(@@) % أذاكره مرآة يومي بأهله % % فيشكو الذي أشكو ويصبو كما أصبو % % 13(@)(@@) % و لم أحسب الأطلال تخضعها النوى % % و لا أن جسم الربع ينحله الحب % 14(@)(@@) % تحدث بما أبصرت يا بارق الحمى % % فإنك راو لا يظن بك الكذب % 15(@)(@@) % و قل عن حشي من حرها وخفوقها % % تعلمت ما تنزو خطارا وتشتب % 16(@)(@@) % و عن بدن لم يبرح الشوق معريا % و شائظه حتى التقى الجنب والجنب % 17(@)(@@) % فلو أنه في جفن ظبية حابل % مكان القذي ما كان يلفظه الهدب % 18(@)(@@) % و هذا ضنا جسمي وقلبي عندها % % فكيف به لو كان في جسدي قلب % 19(@)(@@) % فطرت على طين الوفاء ودينه % فنفسي إليه بالغريزة تنصب % 20(@)(@@) % فكم نائم عني وثير مهاده % و جنبي له عن لين مضجعه ينبو % % PageV01P263 21(@)(@@) % أصابر فيه الليل حتى أغيظه % % فتحسد أجفاني على السهر الشهب % 22(@)(@@) % و أعجب ما حدثته أن ذمة % وفت فارس فيها وخاست بها العرب % 23(@)(@@) % عذيري من الأيام أوخمن مرتعي % % و رنقن لي من حيث يستعذب الشرب % 24(@)(@@) % تناوب قوما غضها وهشيمها % % و كل نصيبي من معيشتها الجدب % 25(@)(@@) % أخلى عليهم عفوها ودرورها % % فأرضى بلا ذل بما كده العصب % 26(@)(@@) % و أتركها ترك المسالم قادرا % % لأسلم منها وهي لي أبدا حرب % 27(@)(@@) % و كم قد شكوت الدهر لو كان مشكيا % % و عاتبت جور الحظ لو نفع العتب % 28(@)(@@) % بلى في يدي لا أكفر الله جانب % من العز لي فيه الوسيعة والرحب % 29(@)(@@) % و منبع جود لو قنعت كفى الغنى % % و بل غليلي ماؤه العلل السكب % 30(@)(@@) % تعود جوى غيمه ونسيمه % و أرضي أن تزكو عليه وأن تربو % % PageV01P264 31(@)(@@) % أقلني من التغرير يا طالب العلا % % و من كدي الآمال تنهض أو تكبو % % 32(@)(@@) % فلولا الندى العد الرحيمي ما جرى % % إلى أيكتي ماء ولا اخضر لي ترب % 33(@)(@@) % هم الناس ناسي والزمان زمانهم % % ربيعي وكسبي من رضاهم هو الكسب % 34 
ms91	(@)(@@) % نملحت فيهم والتحفت بريشهم % % فوكري بهم حيث استوى الماء والعشب % 35(@)(@@) % و حسبي غنى أو سوددا أن بحرهم % % و سيدهم عند الملمات لي حسب % 36(@)(@@) % إلى شرف الدين انتشطنا حبالها % % تعانق في نفض الطريق وتختب % 37(@)(@@) % سلائل ما صفى الغضين وداحس % و حازت كلاب رهنها واعتلت كلب % 38(@)(@@) % بنات الفلا والريح كل حسيرة % % إليها الرياح المستقيمات والنكب % 39(@)(@@) % كسير العصا المقدود لو سلكت بها % % ثقوب الخروت لم يضق دونها ثقب % 40(@)(@@) % تخال عنانا في العنان من الطوى % % و إن شطبت بالسوط هي الشطب % PageV01P265 41(@)(@@) % تحط إليه وهي قلب من الطوى % % و تركب عنه وهي مجفرة قب % 42(@)(@@) % إلى ملك لا يملك الخوف صدره % % خفوقا ولا يغشى على رأيه الخطب % 43(@)(@@) % و لا يطبيه التيه في معجزاته % % إذا هامة المفتون أسكرها العجب % 44(@)(@@) % مهيب الرضا مستصفح السخط بالغ % % به القول ما لا يبلغ الباتر العضب % 45(@)(@@) % محيط بآفاق ا صابة رأيه % بديها ورأي الناس مختمر غب % 46(@)(@@) % إذا رفعت للإذن سجفا رواقه % فلأعين الإشراق والآنف الترب % 47(@)(@@) % مقام تلاقى عنده النعم السطا % % و يجتمع الرغب المحبب والرعب % 48(@)(@@) % إذا أمرته مرة من حفيظة % تسوء نهاه خلقه البارد العذب % 49(@)(@@) % تصور من حسن وحلم ونائل % ففي الدست منه البدر والبحر والعضب % 50(@)(@@) % من القوم لم تضرب عليهم إتاوة % و لم يعتبدهم غير خالقهم رب % PageV01P266 51(@)(@@) % صدور قلوب في المجالس والوغى % % إذا رشحوا فاضوا وإن قدحوا شبوا % % 52(@)(@@) % و مد عميد الدولة العرض راسخا % % فحدث عن ضرب العلا الرجل الضرب % 53(@)(@@) % و ما علمت أم الكواكب قبله % % و قبلهم أن الهلال لها عقب % 54(@)(@@) % و أن شروق الشمس عنهم سينتهي % % إلى ملك في صدره الشرق والغرب % 55(@)(@@) % أرى الملك بعد الميل قامت قناته % و لوحم منه بعد ما انصدع الشعب % 56(@)(@@) % لك البلجة البيضاء إن مات فجره % و في يدك التفريج إن غشى الكرب % 57(@)(@@) % و قد علمت أم الوزارة أنها % % إذا غبت ثكلى قصرها الدمع والندب % 58(@)(@@) % و تطمع مخدوع المنى في 
ms92	 نكاحها % % مطامع كدتها وأنت لها خطب % 59(@)(@@) % و دبوا لها تحت الظلام عقاربا % % و لو حسبوا وطء الأخامص ما دبوا % % 60(@)(@@) % و لما رأوا عنها التفاتك عاجلوا % % وثوبا وقدما طاح بالقدم الوثب % PageV01P267 61(@)(@@) % رقيت بفضل الحلم شوكة لسبهم % % فقد ماتت الأفعى وقد برأ اللسب % 62(@)(@@) % هم عقروها إذ تعاطوا فعذبوا % % و رأيك فيهم صالح وهم السقب % 63(@)(@@) % و راموا التي يرضى بها الخرق وحده % خداعا وتأباها الحزامة واللب % 64(@)(@@) % و من دونها أن يخطب الليث هدنة % من الذئب أو يبكي من العطش الضب % 65(@)(@@) % تحدثهم أحلامهم أن ظهرها % % ركوب ولكن يكذبون إذا هبوا % % 66(@)(@@) % صلوها فما يشقى من اليوم سعدها % % عليكم ولا تذوي وأنتم لها قطب % 67(@)(@@) % و لا برحت فيكم تجر عزيزة % سرابيل لا يخفى ذلاذلها السحب % 68(@)(@@) % ضممت عزيب الملك بعد انتشاره % و أفرشته أمنا وقد ذعر السرب % 69(@)(@@) % و ما زلت بالتدبير تركب صعبه % % إلى سهله حتى استوى السهل والصعب % 70(@)(@@) % أحبك ودا من يخافك طاعة % و أعجب شيء خفيفة معها حب % PageV01P268 71(@)(@@) % و لو نشزت عنك القلوب لردها % % لسانك هذا الحلو أو وجهك الرطب % 72(@)(@@) % فما مقلة إلا وأنت سوادها % % و لا كبد إلا وأنت لها خلب % 73(@)(@@) % و أما القوافي فهي منذ رعيتها % % بطائن واد كل أعوامه خصب % 74(@)(@@) % يكاثفها نبتا ويعدب مشربا % % فلساتها خضم ورشفاتها عب % 75(@)(@@) % صحائح ملسا كالدهان وعهدنا % % بها عند قوم وهي مجفلة جرب % 76(@)(@@) % و كم بكرة لمدحك قدتها % % فقرت ومن أخلاقها الغشم والشغب % 77(@)(@@) % تغاديك أيام التهاني بوفدها % % مكررة لبسا وهن بها قشب % 78(@)(@@) % بشائر ملك صدقه فيك لا يهي % % له ركن و لا يقصر له طنب % 79(@)(@@) % و أن يد الله البسيطة جنة % تقيكم وأحزاب السعود لكم حزب % 80(@)(@@) % يزوركم قلبي بها مثل منطقي % % فلا الغش مخشي عليها ولا الحب % PageV01P269 81(@)(@@) % و أمدح من أعطاكم من لسانه % و أرضاكم من قلبه بكم صب % 82(@)(@@) % فلا تعدموا منها عرائس عطلا % لها من أياديكم قلائد أو قلب % 83(@)(@@) % إذا مشت 
ms93	 الأقران حول خريدة % فوحدتها في الحسن ليس لها ترب % 84(@)(@@) % أجد بها والطبع يجري خلالها % % طلاوة رقراق ترى أنها لعب % 85(@)(@@) % و غيركم يرتاب بي إن مدحته % % لعرفانه ألا يحل لها الغصب % 86(@)(@@) % فأرفعه بالفعل لو كان فاعلا % % و قد خفضته من نقيصته رب % 87(@)(@@) % يساء كأني بالثناء أسبه % لعمر أبي أن النفاق هو السب % PageV01P270 البحر : - 1(@)(@@) % و كالرقم يحسبه من قرا % % و يعرف ممن إذا من كتب % 2(@)(@@) % من البهم لو طلب النطق ضل % و في الأنبياء إذا ما طلب % 3(@)(@@) % يبادر خيل الوغى الدهم وال % % وراد بشهباء تجلى الشهب % 4(@)(@@) % بحيث ترى مخطفات الحدي % % د يضعفن عن مرهفات القصب % 5(@)(@@) % إذا ما تردى نجا سالما % % و يقعص إن قام أو إن وثب % 6(@)(@@) % يكون بدرع فيلقى وإن % تسربل درعين لاقى العطب % PageV01P271 البحر : - 1(@)(@@) % و جارية في مجاري الحياة % خلعت عليها رداء الشباب % 2(@)(@@) % و حليتها حلية المشرف % % ي فوق حمائله والقراب % 3(@)(@@) % إذا غادة منعت وطأها % % تبطنت منها ذلول الركاب % 4(@)(@@) % و خرق ما تحته ظهرها % % كما تخرق الشمس ثوب السحاب % 5(@)(@@) % و أحمد من جسمها أنه % % كريم العظام لئيم الإهاب % PageV01P272 البحر : - 1(@)(@@) % و صفحة وجه من وجوه علقتها % % أراعي خدوشا فوقها وندوبا % % 2(@)(@@) % تعرض لي والغانيات صوادف % فأذكر أصداغا لها وتريبا % % 3(@)(@@) % أكون حليما تارة ما اجتليتها % % وقورا وأحيانا أكون طروبا % % 4(@)(@@) % و يعجبني منهن أني لا أرى % % حبيبا لقلبي أو أراه قريبا % % 5(@)(@@) % سبتني بألفاظ الرجال وطاب لي % % جناها ولم تنطق ولم أر طيبا % % 6(@)(@@) % فأودعتها ما أودع الله مهجتي % % جلابيب خيطت لا تقل جيوبا % % 7(@)(@@) % تقصر عن أقدامها ورؤسها % % و تملأ أصلابا وجنوبا % % 8(@)(@@) % إذا عريت منها وقتها عيوبها % % و إن ألبستها لم توار عيوبا % % PageV01P273 البحر : - 1(@)(@@) % ما أنكرت إلا البياض فصدت % و هي التي جنت المشيب هي التي % % 2(@)(@@) % غراء يشعف قلبها في نحرها % % و جبينها ما ساءني في لمتي % % 3(@)(@@) % لولا الخلاف وأخذهن بدينه % % لم تكلف البيضاء بالمسودة % 4(@)(@@) % أأنست حين سريت في 
ms94	 ظلمائها % % و نفرت أن طلعت عليك أهلتي % % 5(@)(@@) % و لقد علمت وعهد رامة عهدنا % % فتيين أني لم أشب من كبرة % 6(@)(@@) % و إذا عددت سني لم أك صاعدا % % عدد الأنابيب التي في صعدتي % % 7(@)(@@) % أجنيتها من خلة في مفرقي % % فتكون عندك قادحا في خلتي % % 8(@)(@@) % نكروا فلا عرفوا برامة وقفة % ميلاء نادتها الديار فلبت % 9(@)(@@) % و ألام فيك وفيك شبت على الصبا % % يا جور لائمتي عليك ولمتي % % 10(@)(@@) % و حننت نحوك حنة عربية % عيبت وتعذر ناقة إن حنت % PageV01P274 11(@)(@@) % ماذا على الغضبان ما استرفدته % دمعا ولا استوقفته من وقفتي % % 12(@)(@@) % أبغى الشفاء بذكره من مسقمي % % عجبا لمن هو علتي وتعلتي % % 13(@)(@@) % يا هل لليلات بجمع عودة % أم هل إلى وادي منى من نظرة % 14(@)(@@) % و الحاصبات وكل موقع جمرة % ينبدنها في القلب موقد جمرة % 15(@)(@@) % و من المحرم صيدهن خليعة % طابت لها تلك الدماء وحلت % 16(@)(@@) % حكمت عليك بقلب ليث مخدر % و رنت اليك بعين ظبي مفلت % 17(@)(@@) % و رأيت أم الخشف تنشد بيتها % % أفأنت تلك سرقت عين الظبية % 18(@)(@@) % نشطوا عن الركب الحبال فنفروا % % سكنات أضلاعي بأول نفرة % 19(@)(@@) % رفعوا القباب وكل طالب فتنة % يرنو اليك وأنت وحدك فتنتي % % 20(@)(@@) % لا استوطأت مني مكانك خلة % كل الفؤاد نصيب ذات الكلة % PageV01P275 21(@)(@@) % يا من يلوم على اجتماعي قاعدا % % و الأرض واسعة الفروج لنهضتي % % 22(@)(@@) % و يرى الرجال وكلهم متكثر % بصحابة فيلومني في وحدتي % % 23(@)(@@) % أعذر أخاك فما تهجر مشمسا % % حتى تقلص عنه ظل الدوحة % 24(@)(@@) % كيف اعترافي بالصديق وكيف لي % % بالفرق بين محبتي من بغضتي % % 25(@)(@@) % و قلوب أعدائي الذين أخافهم % % مغلولة لي في جسوم أحبتي % % 26(@)(@@) % رقص السراب فراقني من راقص % كشرت مودته وراء الضحكة % 27(@)(@@) % و رأيت فاغرة ظننت كشورها % % طلبا لتقبيلي فكان لنهستي % % 28(@)(@@) % ولد الزمان الغادرين فما أرى % % أم الوفاء سوى المقل المقلت % 29(@)(@@) % و هزلت أن سمن اللئام وإنما % % ذل المطامع حز عزة جوعتي % % 30(@)(@@) % و لكل جسم في النحول بلية % و بلاء جسمي من 
ms95	 تفاوت همتي % % PageV01P276 31(@)(@@) % أما على كذب الظنون فإنها % % صدقت أمان في الحسين وبرت % 32(@)(@@) % المجد ألقح في السماء سحابة % نتجت به مطر البلاد فعمت % 33(@)(@@) % أروى على يبس الشفاه وبيضت % كفاه باردة سواد الحرة % % 34(@)(@@) % متهللالا أعدي بخضرة جوده % جدب الربي من أرضها المغبرة % 35(@)(@@) % بالصاحب انفتقت لنا ريح الصبا % % خصبا وغنى الساق فوق الأيكة % 36(@)(@@) % كفلت بأولى مجده أيامه ال % % أخرى فأحيا كل فضل ميت % 37(@)(@@) % شرفا بنى عبد الرحيم فإنما % % تجنى الثمار بقدر طيب المنبت % 38(@)(@@) % لكم قدامى المجد لكن زادكم % % هذا الجناح تحلقا في الذروة % 39(@)(@@) % غدت الرياسة منكم في واحد % كثرت به الأعداد لما قلت % 40(@)(@@) % عطفت لكم يده وزمت آنفا % % شما لغير خشاشه ما ذلت % PageV01P277 41(@)(@@) % لما تقلدها وكانت ناشزا % ألقت عصاها للمقام وقرت % 42(@)(@@) % موسومة بكم فمن تعلق بها % % دعواه يفضحه علاط الوسمة % 43(@)(@@) % نيطت عراها منه بابن نجيبة % سهل الخطا تحت الخطوب الصعبة % 44(@)(@@) % يقظان يلتقط الكرى من جفنه % نظر العواقب واتقاء العذرة % 45(@)(@@) % لا يطمئن على التواكل قلبه % فيما رعى إن نام راعي الثلة % 46(@)(@@) % تدجو الأمور وعنده من رأيه % % شمس إذا ما جن خطب جلت % 47(@)(@@) % و يصيب مرتجلا بأول خطرة % أغراض كل مخمر ومبيت % 48(@)(@@) % تدمى بنان النادمين وسنه % ملساء إثر ندامة لم تنكت % 49(@)(@@) % ما ضم شمل الملك إلا رأيه % بعد انشار شعاعه المتشتت % 50(@)(@@) % حسر القذى عن حوضه وسقى على % % طول الصدى فشفى بأول شربة % PageV01P278 51(@)(@@) % من بعد ما غمز العدا في عوده % و استضعفوا قدما له لم تثبت % 52(@)(@@) % و لرب بادئة وكانت جذوة % كملت ضراما بالحسين وتمت % 53(@)(@@) % حاميت عنه بصولة المتخمط ال % % عادي وهدي المستكين المخبت % 54(@)(@@) % و إذا عرى الحزم التقت علق الفتى % % بمدى السريع على خطا المتثبت % 55(@)(@@) % إن الذين على مكانك أجلبوا % % ضربوا الطلى بصوارم ما سلت % 56(@)(@@) % طلبوا السماء فلا هم ارتفعوا لها % % شل الأكف ولا السماء انحطت % 57(@)(@@) % و بود ذي القدم القطيعة ماشيا % % لو أنها سلمت عليه وزلت % 58 
ms96	(@)(@@) % خان السرى ركب القلاص وسلمت % بسط الفلاة إلى القروم الجلة % 59(@)(@@) % يفديك مرتاب بغلطة حظه % % سرق السيادة من خلال الفلتة % 60(@)(@@) % ما رد يوما عازب من عقله % % إلا رأى الدنيا به قد جنت % PageV01P279 61(@)(@@) % قبضت يداه وما يبالي سائل % بخلت عليه يد امرئ أو شلت % 62(@)(@@) % و أرى الوزارة لا يعاصل نابها % % حاو سواك على اختلاف الرقية % 63(@)(@@) % يرجوك ريضها لمتن مزلق % قد قطرت فرسانه فتردت % 64(@)(@@) % يشتاق ظهرك صدر مجلسها وكم % % شكت الصدور من الظهور وضجت % 65(@)(@@) % و إذا التفت إلى الأمور رأيتها % % مذخورة لك من خلال تلفتي % % 66(@)(@@) % فأل متى يامنت سانح طيره % صدقت عياقها بأول زجرة % 67(@)(@@) % فهناك فاذكر لي طريف بشارتي % % بعلاك واحفظ تالدا من صحبتي % % 68(@)(@@) % لو شافه الصم الجلاد محدث % عنكم بني عبد الرحيم لأصغت % 69(@)(@@) % أو عوضت بكم السماء وقد هوت % أنوارها بدل النجوم تسلت % 70(@)(@@) % الباذلون فلو تصافح راحكم % % ريح الصبا وهي الحيا لاستحيت % PageV01P280 71(@)(@@) % و القائلون بلاغة فلو احتبت % أم الفصاحة بينكم لأذمت % 72(@)(@@) % أنست بفاتحة الكتاب شفاهكم % % و رزقتم ظفر الكتاب المسكت % 73(@)(@@) % لكم انحنى صيدي وأعسل حنظلي % % للمجتني وتولدت حوشيتي % % 74(@)(@@) % و سجرتموني منصفين مودة % و رفادة يومي رخاي وشدتي % % 75(@)(@@) % أعشبتم فبطنت في مرعاكم % و الدهر يقنع لي بفضل الجرة % 76(@)(@@) % أدعو وغاب أبي وقل عشيرتي % % فيكون نصركم إجابة دعوتي % % 77(@)(@@) % و متى تقيدني الليالي عن مدى % % قمتم فأوسعتم إليها خطوتي % % 78(@)(@@) % عجب المديح وقد عممتكم به % % من رجعتي فيه عقيب أليتي % % 79(@)(@@) % حرمته زمنا فكنتم وحدكم % % من بين من حمل التراب تحلتي % % 80(@)(@@) % هو جوهر ما كل غائصة له % % بالفكر تعلم ما مكان الدرة % PageV01P281 81(@)(@@) % و يصح معناه ويسلم لفظه % و نظامه وهناك باقي العلة % 82(@)(@@) % كم خاطب بأعز ما تحوي يد % عذراء منه وعرضه دون ابنتي % % 83(@)(@@) % و لقد زففت لكم كنائن خدره % فكرمتم صهرا ووالي عذرة % 84(@)(@@) % من كل راكبة بفضل عفافها % % و الحسن عنق العائب المتعنت % 85(@)(@@) % عزت فما عثرت بغير معوذ % بلغا ولا 
ms97	 عطست بغير مشمت % 86(@)(@@) % أمة لكم بجزيل ما أوليتم % و تصان عندكم صيان الحرة % 87(@)(@@) % سلمت على غرر الخلاف ولادها % % في أمة وودادها في أمة % 88(@)(@@) % مدت إلى ساسان ناشر عرقها % % و قضت لها عدنان بالعربية % 89(@)(@@) % يصغى الحسود لها فيشكر أذنه % طربا وود لغيظه لو صمت % 90(@)(@@) % تسري رفيقة يوم مؤذن % بسعادة فإذا ألم ألمت % PageV01P282 91(@)(@@) % تروي لكم عن ذي القرون حديثه % قدما ويحيي نشرها ذا الرمة % 92(@)(@@) % أحمدتم ماضي في أمثالها % % و لئن بقيت لتحمدن بقيتي % % PageV01P283 البحر : - 1(@)(@@) % رعى الله يوم البين ظبيا أذم لي % % بما أثر التوديع في وجناته % 2(@)(@@) % تعاطيت إلا النوم بعد فراقه % كأني عليه مسقم بحياته % 3(@)(@@) % و صرت أذم الدهر في الليل ما دجا % % و عهدي به والليل من حسناته % PageV01P284 البحر : - 1(@)(@@) % قفا نضويكما بالغمر نسأل % حفيا أين مثوى المكرمات % 2(@)(@@) % و أي ثرى كريم العرق سيطت % به رمم المعالي الدارسات % 3(@)(@@) % و أين لذكرها تحت الغوادي % % مطارح أعظم فيها رفات % 4(@)(@@) % و كيف تكورت بيد المنايا ال % % غزالة مدرجا للسافيات % 5(@)(@@) % و إن أصفى مزاد كما فمدا % % بأذنبة هنالك مترعات % 6(@)(@@) % أنامل للحسين غبرن حينا % % ضرائر للغيوث المرزمات % % 7(@)(@@) % و لوذا مسندين بجنب طود % من المعروف عالي الهضب عاتي % % 8(@)(@@) % فثم الجار محمى النواحي % % و ثم الرعي مكتهل النبات % 9(@)(@@) % و ثم الوجه أبلج والمساعي ال % % كرام وثم حاجات العفاة % 10(@)(@@) % قفا فتناديا فلعل صوتا % سيزقو أو يصيخ إلى الدعاة % PageV01P285 11(@)(@@) % و قولا كيف يا حنش الرمال أخ % % تدعت ولست من قنص الرقاة % 12(@)(@@) % من الحاوي الذي انترعت يداه % نيوب العز من تلك اللهاة % 13(@)(@@) % لعمر العاطفين اليك ليلا % لنعم أخو العشايا الصالحات % 14(@)(@@) % و نعم عدو مالك كنت فيهم % % و خصب الجالبات الرابحات % 15(@)(@@) % و مأوى كل مطرد ترامى % % به الأخطار أيدي النائبات % 16(@)(@@) % لمن خيل تضمر للسرايا % % و فرسان تخمر للبيات % 17(@)(@@) % و أندية وأروقة رحاب % تضم بدائد الفضل الشتات % 18(@)(@@) % و من للمحكمات من القوافي % % تطير بهن أجنحة الرواة 
ms98	 % 19(@)(@@) % و من لي يزحم الأيام عني % % و قد هجمت علي مصممات % 20(@)(@@) % و يجذب من يد الزمان المعاصي % % بأضباعي إلى الزمن المواتي % % PageV01P286 21(@)(@@) % و من ذا قائل خذ أو تحكم % إذا أنا قلت هب أو قلت هات % 22(@)(@@) % و ما أنا والعزاء وقد تقضت % حياة تستمد بها حياتي % % 23(@)(@@) % يعنف فيك أن صدعت ضلوعي % % خلي القلب من تلك الهنات % 24(@)(@@) % كأني فيك أبعث بالتأسي % % على جزعي وأغري بالعظات % 25(@)(@@) % رزئتك أطول الرجلين باعا % % و أمضى الصارمين على العداة % 26(@)(@@) % و أوفى من سراج الأفق نورا % إذا الأيام كانت داجيات % 27(@)(@@) % كأني قبل يومك لم أفزع % بصائحة العشي ولا الغداة % 28(@)(@@) % و لم تطرف بفاجعة لحاظي % % و لم تقرع بمرزئة صفاتي % % 29(@)(@@) % بكيتك في العناة فحين قالوا % % قتلت وددت أنك في العناة % 30(@)(@@) % أصاب السيف منك غزار سيف % و حط بك الفرات إلى الفرات % PageV01P287 31(@)(@@) % فلا زالت هي البتر النواتي % % سيوف أسلمتك إلى النواتي % % 32(@)(@@) % ذوائب أسرتي وكرام صحبي % % و إخوة شدتي وبني ثقاتي % % 33(@)(@@) % هوت بالصاحب القرطات مني % % فرحت بعاطلات مصلمات % 34(@)(@@) % لقد خولست وسطي العقد منكم % % به وخدعت عن أخرى القناة % 35(@)(@@) % فيا مطلول بل ثراك صبحا % صلاة الله تتبعها صلاتي % % 36(@)(@@) % لقد واسيتني في العيش دهرا % % فمالي لم أواسك في الممات % 37(@)(@@) % عسى وبلى لنا لا بد يوم % سيقضي فيك ممطول الترات % 38(@)(@@) % فإن أجزع فماض كل ماض % و إن أصبر فآت كل آت % PageV01P288 البحر : - 1(@)(@@) % دعها تكن كالسلف من أخواتها % % تجري بها الدنيا على عاداتها % % 2(@)(@@) % ما هذه يا قلب أول عثرة % قذفت بك الأطماع في لهواتها % % 3(@)(@@) % هي ما علمت وإن ألمت لفضلة % من ثقل وطأتها وحد شباتها % % 4(@)(@@) % كم خطوة لك في المنى إزليقة % لم تنتصر بلعا على عثراتها % % 5(@)(@@) % و ذخيرة طفقت يداك تضمها % % و الدهر خلفك مولع بشتاتها % % 6(@)(@@) % و وثيقة ألجأت ظهرك مسندا % بغرورها فسقطت في مهراتها % % 7(@)(@@) % لو كنت عند نصيحتي لم ترتبق % بمشوره الآمال في حلقاتها % % 8(@)(@@) % و هوى 
ms99	 أطعت أميره في لذة % متبوعة لم تنج من تبعاتها % % 9(@)(@@) % يبني السفين اللامعات سرابها % % و يعد مخدوعا تراب فلاتها % % 10(@)(@@) % و فتاة قوم لا ينام مغيرهم % % رمت اقتسارهم على خلواتها % % PageV01P289 11(@)(@@) % شحذوا المدى لك دونها فركبتها % % تغتر حتى طرت في شفراتها % % 12(@)(@@) % و يمين جارية سلكت في % % مسباحها و ذهبت في آناتها % % 13(@)(@@) % ما كان قبلك للحفاظ شريعة % في دينها أبدا ودين لداتها % % 14(@)(@@) % نظرت فكنت ضريبة لحسامها % % و مشت فكنت دريئة لقناتها % % 15(@)(@@) % و مضيت تتبع وصلها ولسانها % % و الرشد عند صدودها ووشاتها % % 16(@)(@@) % نم قدسهرت فدون يوم وفائها % % و هي التي جربت يوم وفاتها % % 17(@)(@@) % و اشكر لها كشف القناع فإنها % % غدرت فكان الغدر من حسناتها % % 18(@)(@@) % و اذكر مآرب غيرها واعجب لها % % غصبتك آفتها على لذاتها % % 19(@)(@@) % و ملثمين على النفاق بأوجه % صم يصيح اللؤم من قسماتها % % 20(@)(@@) % صبغوا الوفاء بياضه بسواده % و المكرمات هبوبها بسباتها % % PageV01P290 21(@)(@@) % متراهنين على الدنية أحرزوا % % غاياتها وتناهبوا حلباتها % % 22(@)(@@) % ورثت نفوسهم خبائث أصلها % % لؤما وزادت دقة من ذاتها % % 23(@)(@@) % أيد تجف على الربيع وألسن % سرق السراب الإفك من كلماتها % % 24(@)(@@) % يصف المودة بشرها ووراء % % بشر الزجاج يشف عن نياتها % % 25(@)(@@) % دسوا المكايد في مواعد حلوة % كانت عقارب والكذاب حماتها % % 26(@)(@@) % خلق إذا حدثت عن أخلاقها % % فكأنما كشفت عن سوآتها % % 27(@)(@@) % لله آمال أرقت دماءها % % فيهم فلم يتعلقوا بدياتها % % 28(@)(@@) % و كرائم وليت فضة عذرها % % منهم سوى أكفائها وكفاتها % % 29(@)(@@) % غر أهنت على اللئام كرامها % % و أبحت أبناء العقوق بناتها % % 30(@)(@@) % أهمتها فيهم سدى مظلومة % تبكي أراجزها على أبياتها % % PageV01P291 31(@)(@@) % يتناكرون حقوقها من بعد ما % % علطوا على أعراضهم بسماتها % % 32(@)(@@) % من كل مفتوح إليها سمعه % مضمومة كفاه دون صلاتها % % 33(@)(@@) % يهوى العلا فاذا ارتقى لينالها % % رداه حب الوفر من شرفاتها % % 34(@)(@@) % حيران يتبع من أخيه ونجله % ما يتبع الأصداء من أصواتها % % 35(@)(@@) % من عاذري منهم ومن لحرارة % أشرجت أضلاعي على جمراتها % % 36(@)(@@) % و لخطة خسف عصبت بعارها % % رأس العلا وحططت من درجاتها 
ms100	 % % 37(@)(@@) % أنا ذاك جانيها فهل أنا آخذ % غيري بها وهو الذي لم ياتها % % 38(@)(@@) % يا حظ ما لك لا أقالك عثرة % جاري الحظوظ وغافر زلاتها % % 39(@)(@@) % كم أشتكيك وأنت صل حماطة % لا يطمع الحاوون في حياتها % % 40(@)(@@) % عيش كلا عيش ونفس ما لها % % من متعة الدنيا سوى حسراتها % % PageV01P292 41(@)(@@) % و تود حين تود لو ما بدلت % أحبابها من جورها بعداتها % % 42(@)(@@) % و يزيدها جلدا وفرط تجلد % بين العدا الإشقاق من إشماتها % % 43(@)(@@) % إن كان عندك يا زمان بقية % مما يضام بها الكرام فهاتها % % 44(@)(@@) % صبرا على العوجاء من أقدارها % % لا بد أن تجري إلى ميقاتها % % 45(@)(@@) % و لعلها بالسخط منك وبالرضا % % أن تستقيم طريقها بحداتها % % 46(@)(@@) % كم مثلها ضاقت فحلل ضيقها % % يوم ولم يحسب جلا غمراتها % % 47(@)(@@) % و لقد كنزت فهل علمت مكانه % من صفو أيامي ومن خيراتها % % 48(@)(@@) % خلا تنخله ارتيادي واحدا % % صحت به الدنيا على علاتها % % 49(@)(@@) % غلطت به أم الزمان فأنجبت % فيه وخابت في بني علاتها % % 50(@)(@@) % لي منه كالئة العيون وبسطة ال % % أيدي الثقات إذا عدمت ثقاتها % % PageV01P293 51(@)(@@) % و قرابة الأخ غير أن مسافة % في الود لم يبلغ أخي غاياتها % % 52(@)(@@) % من مانعي حرم الإخاء ونافضي % % طرق الوفاء فمحرزي قصباتها % % 53(@)(@@) % و السالمين على تلون دهرهم % % و تحول الأشياء عن حالاتها % % 54(@)(@@) % و إذا الأكارع والزعانف عوروا % % من خلة كانوا مكان سراتها % % 55(@)(@@) % نبهته ومن العيون غضيضة % حولي وأخرى كنت أخت قذاتها % % 56(@)(@@) % فأثرت منه أبا الشبول فمالت ال % % أرماح تدعسه على غاباتها % % 57(@)(@@) % ملآن من شرف السجية نفسه % تحوى الفضائل عن جميع جهاتها % % 58(@)(@@) % منقادة للمكرمات وأنفس % تدع العلا وتقاد في شهواتها % % 59(@)(@@) % ما اختارت المختار لي إلا يد % وثقت لمغرسها بطيب جناتها % % 60(@)(@@) % لله خائلة رأيت ودادها % % بدلالة التوفيق في مرآتها % % PageV01P294 61(@)(@@) % رد الزمان به شبيبة عيشتي % % بعد اشتعال الشيب في شعراتها % % 62(@)(@@) % و تسومت غرا محجلة به % % أيام دهر قد نكرت شياتها % % 63(@)(@@) % كم خلة داويتها بدوائها % % منه ونعمى كان من أدواتها % % 64 