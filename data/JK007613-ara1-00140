ms121	 يوم عطلت % سوى حلي خلخال وقرط ومعضد % % 23(@)(@@) % أسيلة مجرى الدمع مهضومة الحشا % % كشمس الضحى حلت ببرج وأسعد % 24(@)(@@) % تكاد إذا قامت لشيء تريده % تميل بها الأرداف ما لم تشدد % 25(@)(@@) % وقد نسيت عهد الصفاء ولم أزل % على ذكر منها أروح وأغتدي % % 26(@)(@@) % يموتني شوقي وتحييني المنى % % فلست بحي في الحياة ولا الردي % % 27(@)(@@) % وما كان ما لاقيت من وصل غادة % وهجرانها إلا بما قدمت يدي % % 28(@)(@@) % فلما رأيت الحب ليس بعاطف % هواها ولا دان لها بتودد % 29(@)(@@) % أخذت بكفي الندامة راجعا % وأيقنت أني عندها غير موطد % 30(@)(@@) % عشية زادتني الزيارة فتنة % فأقبلت محروما بها لم أزود % PageV01P470 31(@)(@@) % وقد علمت حمادة النفس أنني % % إلى نائل لو نلت من وردها صد % 32(@)(@@) % وأن الهوى إن لم ترح لي بزفرة % يكون جوى بين الجوانح مغتد % PageV01P471 البحر : طويل 1(@)(@@) % أبا كرب كلني لهم المجاهد % ولا تستزدني ليس حبي بزائد % 2(@)(@@) % دعاني إلى أم الوليد شبابها % % وحسن فإني مثلها غير واجد % 3(@)(@@) % سأصرم وصلا من علية إنها % % صروم كما أوهى كذوب المواعد % 4(@)(@@) % فأتبع ظل الباهلية إذ غدت % % علي بأهواء المحب المباعد % 5(@)(@@) % إذا شئت راعتني وإن كنت لاهيا % بذات خليل أو بعذراء ناهد % 6(@)(@@) % لعوب بألباب الرجال كأنها % % إذا سفرت بدر بدا في المجاسد % 7(@)(@@) % تشكى الضنى حتى تعاد وما بها % % سوى فترة العينين سقم لعائد % 8(@)(@@) % كأن الثريا يوم راحت عشية % على نحرها منظومة في القلائد % 9(@)(@@) % عقيلة أتراب يقومن حولها % % إذا رحن أمثال الغصون الموائد % 10(@)(@@) % لقيت بها سعد السعود وإنما % % لقيت بأخرى ناحسات الموارد % PageV01P472 11(@)(@@) % فتلك التي نصحي لها ومودتي % % ونصري ومالي طارف بعد تالد % % PageV01P473 البحر : مجزوء الخفيف 1(@)(@@) % يا خليلي أسعدا % % ملك الحب واعتدى % % 2(@)(@@) % أو دعاني أمت به % بلغت نفسي المدا % % 3(@)(@@) % ليس مني من لم يقم % لي بما عالني غدا % % 4(@)(@@) % تفرح العين أن ترى % % عبد قيس وأسعدا % % 5(@)(@@) % حرمة الظاعن الذي % % كان جارا فأصعدا % % 6(@)(@@) % وتلومانني وقد % نزل الموت أسودا % % 7(@)(@@) % كل من ود أحمدا % % ود 
ms122	 أشياع أحمدا % % 8(@)(@@) % لا تكونا كعجرد % لعن الله عجردا % % 9(@)(@@) % ابن نهيا كأمه % يبتغي باسته ندى % % 10(@)(@@) % نفس عوف بن واقد % باعدته فأبعدا % % PageV01P474 11(@)(@@) % أنا بل بشادن % أحور العين أجيدا % % 12(@)(@@) % فاتني إذ رميته % % ورماني فأقصدا % % 13(@)(@@) % ولقد قلت للتي % % دفعتني مصردا : % 14(@)(@@) % لا تكوني بما ضمنت % لذي الزاد أنفدا % % 15(@)(@@) % أنجزي ما وعدت أو % % أنجزي منك موعدا % % 16(@)(@@) % وليكن ما وعدتني % % نسج نير على سدى % % 17(@)(@@) % لا تكوني كبارق % ليس في برقه ندى % % 18(@)(@@) % واذكري ليلة السما % % ء بذي التاج مقعدا % % 19(@)(@@) % بين راح ومزهر % وغناء شفا الصدا % % 20(@)(@@) % إذ تقولين جهرة : % ليت ذا دام سرمدا % % PageV01P475 21(@)(@@) % ونعيم بغيته % بعد ما لذ مرقدا % % 22(@)(@@) % صاحب يشتهي اللعا % % ب إن شئت غردا % % 23(@)(@@) % وحديث كتمته % ولواه فما بدا % % PageV01P476 البحر : مجزوء الرجز 1(@)(@@) % عاد الغداة الصب عيد % فالقلب متبول عميد % % 2(@)(@@) % من حب ظبي صادة % يا من رأى ظبيا يصيد % 3(@)(@@) % أنس ألوف للحجا % % ل ودونه قصر مشيد % 4(@)(@@) % من حوله حراسه % وببابه أسد مريد % 5(@)(@@) % والظبي مسكنه الفلا % ة مطرد فيها شريد % 6(@)(@@) % ما إن تزال تظله ال % % أمطار فيها والجليد % 7(@)(@@) % والظبي تصرعه الحبا % % ئل وهو عن شرك يحيد % 8(@)(@@) % ويطيش نبلي إن رمي % % ت وإن رمى فهو المجيد % 9(@)(@@) % فأصاب لما أن رمى % % قلبي له سهم سديد % % 10(@)(@@) % إذ مر يختلس النفو % % س وخلفه تزجيه غيد % PageV01P477 11(@)(@@) % يمشي الهوينا كالنزي % % ف لبهره وهو الحميد % % 12(@)(@@) % وعلى الترائب درة % فيها الزبرجد والفريد % 13(@)(@@) % ونقارس قد زانها % % حلق غدائرها تصيد % 14(@)(@@) % وأغن يحفل عصفرا % وكأنه جمر وقود % 15(@)(@@) % والقرط في مهلوكة % % مجراه من جبل بعيد % 16(@)(@@) % خصر لطيف كشحه % مجرى الوشاح لها خضيد % 17(@)(@@) % تلك التي لذ الشبا % % ب بها وطاوعني القصيد % 18(@)(@@) % تلك التي حب لها % % في القلب باق لا يبيد % 19(@)(@@) % من كان أفنى وده % دهر فودكم يزيد % 20(@)(@@) % أو كان غيره الزما % % ن فحبكم غض جديد % PageV01P478 21(@)(@@) % أو كان جلدا في الهوى % % فأنا الضعيف له البليد % % 22 
ms123	(@)(@@) % يوما إذا لاقيتكم % ولدى الهجان أنا التليد % 23(@)(@@) % لا أستطيع جوابكم % % ولغيركم قولي عتيد % 24(@)(@@) % فأشد حب حبكم % % والحب أهونه شديد % 25(@)(@@) % فلئن ظفرت بخلوة % من حبتي فأنا السعيد % 26(@)(@@) % أو مت من حبي لها % % فأنا القتيل به الشهيد % PageV01P479 البحر : رجز تام 1(@)(@@) % يا طلل الحي بذات الصمد % بالله حدث : كيف كنت بعدي % % 2(@)(@@) % أوحشت من دعد ونؤي دعد % بعد زمان ناعم ومرد % 3(@)(@@) % عهدا لنا سقيا له من عهد % إذ نحن أخياف بما نؤدي % % 4(@)(@@) % يخلفن وعدا ونفي بوعد % فنحن من جهد الهوى في جهد % 5(@)(@@) % نلهو إلى نور الخزامى الثعد % في زاهر من سبط وجعد % 6(@)(@@) % ما زال من حرج الصبا في رند % % يختال في ماء الندى المندي % % 7(@)(@@) % حتى اكتسى مثل عيون البرد % روضا بمغنى واهب بن فند % 8(@)(@@) % أهدى له الدهر ولم يستهد % أفواف أنوار الحداء المجدي % % 9(@)(@@) % يلقى الضحى ريحانه بسجد % بدلت من ذاك بكى لا يجدي % % 10(@)(@@) % آذن طلبات الصبى بصد % طالبني أمر وليس يجدي % % PageV01P480 11(@)(@@) % فهن لا يشفينني ببرد % وقد أراني في الصبى الأجد % 12(@)(@@) % كالبد فيهن لأهل البد % هذا وبلاني مسير الأزد % 13(@)(@@) % سرب تراءى كنظام العقد % حلو الحديث حسن التصدي % % 14(@)(@@) % واها لأسماء ابنة الأشد % قامت تراءى إذ رأتني وحدي % % 15(@)(@@) % كالشمس بين الزبرج المنقد % سلطان مبيض على مسود % 16(@)(@@) % ضنت بخد وجلت عن خد % ثم انثنت كالنفس المرتد % 17(@)(@@) % ورحت من عرق الهوى أصدي % % يا عجبا للعاجز المسدي % % 18(@)(@@) % حددت عن حظي ولم أجد % ما ضر أهل النوك ضعف الكد % 19(@)(@@) % وافق حظا من سعى بجد % قل للزبير السائلي عن ولدي % % 20(@)(@@) % الحر يوصى والعصا للعبد % وليس للملحف مثل الرد % PageV01P481 21(@)(@@) % فارض بنصف وأزح في القصد % % النصف يكفيك من التعدي % % 22(@)(@@) % وصاحب كالدمل الممد % أراقب منه مثل يوم الورد % 23(@)(@@) % حتى انطوى غير فقيد الفقد % % وما درى ما رغبتي من زهدي % % 24(@)(@@) % وطامس السمت جموح الورد % % خال لأصوات الصدى المصدي % % 25(@)(@@) % أرضا ترى حرباءها كالقرد % يميد في رأد الضحى الممتد 
ms124	 % 26(@)(@@) % للقور في رقراقها تردي % % زوراء تخفي عجبا وتبدي % % 27(@)(@@) % من لامعات كالسعالي البد % تلمع قدامي وطورا بعدي % % 28(@)(@@) % كأن قصوى أكمها تسدي % % لا ، بل تصلي تارة وتردي % % 29(@)(@@) % ترقد في يعانها المرقد % وعاصف من آلها المشتد % 30(@)(@@) % صدعتها بالعيهم العلند % يلقى الضحى بمنسم مكد % PageV01P482 31(@)(@@) % ونظر راع وهاد نهد % وهامة ملمومة كالصلد % 32(@)(@@) % جشمته أفضى وشيح الجلد % طي السخاوي بغير ند % 33(@)(@@) % ما زال يشدو تارة ويخدي % % في بطن عيث وظهر صلد % % 34(@)(@@) % أملس لا يهدى به مهد % حتى انتهى مثل صليف القد % 35(@)(@@) % فانصدعت عن راكب مجد % وراد أمواه كماء السخد % 36(@)(@@) % وغارب أخفى لخافي البلد % ريان يلقى مع طول الشد % 37(@)(@@) % مكعبرا نداءه المثدي % % فيه لصيران الفلا تغدي % % 38(@)(@@) % لم يغذ بالفيض ولا بالعد % إلا بماء المعصرات الهد % 39(@)(@@) % مختلف التيجان في التندي % % كلل بالأصفر بين الورد % 40(@)(@@) % وبالبنفس المشرق الرخود % والجون مشبوبا بلون الفهد % PageV01P483 41(@)(@@) % موف على حوذانه كالنقد % من زاهر أحمر لم يسود % 42(@)(@@) % يغدو كغادي الشرق في التغدي % % منبلقا مثل عيون الجرد % 43(@)(@@) % تحار فيه الشمس ذات الوقد % إذا حدا ذبابه المحدي % % 44(@)(@@) % عارضه المكاء كالمستعدي % % صبحته في ظل مزن سمد % 45(@)(@@) % غدية قبل غدو السبد % بعاقر جداء أو أجد % 46(@)(@@) % يطلب شأو اليعملات الجد % % بل هل ترى لمع الحبي الفرد % 47(@)(@@) % وافى من العين بنجم السعد % % تحدو به ريح وريح تهدي % % 48(@)(@@) % كأن أنواح النساء الجد % في عرصة يلمعن بالفرند % 49(@)(@@) % قد طبق الغور وأعلى نجد % يستن فيه كالنعام الربد % % 50(@)(@@) % إذا سناه انشق غير المكدي % % أضاء للشامة بعد الرقد % PageV01P484 51(@)(@@) % جون الربى مثل جبال الكرد % منبعق القصف هزيم الرعد % 52(@)(@@) % قلت له حين حفا في العهد % وغرق الوهد وغير الوهد % 53(@)(@@) % بسبل مثل زلال الشهد : % اسلم وحييت أبا الملد % 54(@)(@@) % أنت جنى العود وموت الرئد % % متوج الآباء ضخم الرفد % % 55(@)(@@) % مفتاح باب الحدث المنسد % نعم مزار المعتفي والوفد % 56(@)(@@) % وأنت للجند وغير الجند % مشترك النيل وري الزند % 57(@)(@@) % تسبق من جاراك قبل 
ms125	 الشد % بالحلم والجود وضرب الكرد % 58(@)(@@) % ما زلت معروفا مع الأرد % أغر لباسا ثياب المجد % 59(@)(@@) % ما كان مني لك غير الود % ثم ثناء مثل ريح الورد % 60(@)(@@) % نسجته في المحكمات الند % فالبس طرازي غير مستبد % PageV01P485 61(@)(@@) % لله أيامك في معد % ثم بني قحطان ثم عبد % 62(@)(@@) % يوما بذي صبية عند الحد % وعنده استودعت أرض الهند % 63(@)(@@) % بالمقربات المبعدات الجرد % إذا الفتى أكدى بها لم تكد % 64(@)(@@) % تلحم أمرا وأمورا تسدي % % وابن حكيم إذ أتاك يردي % % 65(@)(@@) % في العدد المعلنكس الأعد % راح بحد وغدا بحد % 66(@)(@@) % يحفز دفاعا كطرد الصرد % % حفز الأواذي عباب المد % 67(@)(@@) % كأنه من غلواء الجرد % في العسكر المسلنطح المقود % 68(@)(@@) % أصم لا يسمع صوت الرعد % حييته بحتفه المعد % 69(@)(@@) % بعد طعان صادق وجلد % % فانهد مثل الجبل المنهد % 70(@)(@@) % وانفرجت عن أسد ألد % وعن نمور حوله وأسد % PageV01P486 71(@)(@@) % صرعى كصرعى الخندريس المرد % بعدا ولا ترث لهم من بعد ! % 72(@)(@@) % كل امرئ رهن بما يؤدي % % ورب ذي تاج كريم المجد % 73(@)(@@) % كآل كسرى وكآل برد % أنكب جاف عن طريق الرشد % 74(@)(@@) % فصلته عن ماله والولد % % يا بنت أفصى من بني العرند % 75(@)(@@) % قولي لعبد القيس إن لم تجد : % لا تفرحي بالجلب الأشد % 76(@)(@@) % قد يخرج الليث سهام الوغد % قومي . . . . د ما أو صدى % % 77(@)(@@) % فانتظري عقبة بعد الوخد % سيان من يغزو ومن في اللحد % % 78(@)(@@) % قد جاءك الدهر بأمر إد % بعقبة المشغب ثم المجدي % % 79(@)(@@) % يهز أعلى سيفه الأحد % في جحفل كالعارض المسود % 80(@)(@@) % يشق متن الصحصحان الجرد % % بالعلمين في الحديد السرد % PageV01P487 81(@)(@@) % وكل جياش العشايا نهد % في لبده والموت فوق اللبد % PageV01P488 البحر : مجزوء الكامل 1(@)(@@) % يا دار أقوت بالأجالد % % بعد المسود بها وسائد % 2(@)(@@) % لا غرو إلا درسها % % بين الأمق إلى كداكد % % 3(@)(@@) % يمشي النعام بجوها % % مشي النساء إلى المساجد % % 4(@)(@@) % ولقد رأيت بها الخرا % % ئد يتصلن إلى الخرائد % % 5(@)(@@) % حور أوانس كالدمى % % أو كالأهلة في المجاسد % 6(@)(@@) % رجح الروادف والشوى % % لا يأتزرن على الرفائد % % 7(@)(@@) % متهللات 
ms126	 في العبير وفي % % وفي الزبرجد والفرائد % 8(@)(@@) % لا يرعوين إلى المريب ولا % % ولا ينين على المراصد % % 9(@)(@@) % أيام عبدة وسطهن % % كأنها أم القلائد % % 10(@)(@@) % يحسدن فضل جمالها % % لا تعدمي حسد الحواسد % % PageV01P489 11(@)(@@) % لله عبدة إذ غدت % منا تزف إلى ابن قائد % 12(@)(@@) % كالحلي حسن حديثها % % ودلالها إحدى المصايد % 13(@)(@@) % ولقد نعمت بروحها % % ودفعت عن جسد مساعد % % 14(@)(@@) % يا شوقها لفراقنا % % وتقلبي فوق الوسائد % 15(@)(@@) % يا عبد قد شخص الفؤا % % د وقد شخصت فغير باعد % 16(@)(@@) % قرع الوشاة فأطرقوا % % وشغلت عنا أم عابد % 17(@)(@@) % لا تنجزين مواعدي % % ويلي على تلك المواعد % 18(@)(@@) % ولقد أقول لمولع % غيران يقعد بالقصائد : % 19(@)(@@) % يا ذا المقحم سادرا % أقصر فإنك غير راشد % 20(@)(@@) % لا توعدني باللقا % % ء وقد شربت دم الأساود % PageV01P490 21(@)(@@) % لا أتقي حسد الضغي % % ن ولا أخوف صوت راعد % 22(@)(@@) % يخشى الأسود عرامتي % % ونقي معتلج الأوابد % % 23(@)(@@) % جرح بأفواه الروا % % ة لدى المجالس بالمناشد % % 24(@)(@@) % ولنعم جندلة الردى % % في مأقط كالسيف عاند % % 25(@)(@@) % أشفى من اللمم المعن إذا % % تقحم غير قاصد % 26(@)(@@) % فدع الفضول لأهلها % % قطع المراء حضور صاعد % 27(@)(@@) % وإذا خشيت محيطة % من وارق الجهلات زائد % % 28(@)(@@) % فاندب لها روح القلو % % ب فليس عن شرف ببارد % 29(@)(@@) % نوه بأروع مسعر % للحرب في الغمرات قائد % 30(@)(@@) % أسد الخليفة تلتقي % % بشباته نحر المكايد % PageV01P491 31(@)(@@) % وفتى العشيرة في الحفا % % ظ وزينها عند المشاهد % % 32(@)(@@) % يجري بصالحة الخليل % % وليس عن ترة براقد % % 33(@)(@@) % كثرت مواهبه الكبار % % لصادر منا ووارد % 34(@)(@@) % يعطي القيان مع اللهى % % من سيب مشترك الفوائد % % 35(@)(@@) % وترى الحلول ببابه % % من بين مختبط ووافد % % 36(@)(@@) % متعرضين لسيد % عجلان بالمعروف زائد % % 37(@)(@@) % عطفت عليه قلوبهم % وعلى فواضله العوائد % % 38(@)(@@) % روح يروح مع الندى % % ويراح للبطل المناجد % 39(@)(@@) % تراك ألحية الحنا % % وإلى الوغى سلس المقاود % % 40(@)(@@) % نعم الفتى يسعى به % صيد المحيل من الأصايد % PageV01P492 41(@)(@@) % وإذا الرياح تروحت % % مقورة جسد المقاحد % 42(@)(@@) % وتناوحت شعب الذئا % % ب ولم تجد عودا بعاضد % % 43(@)(@@) % مطرت سحائبه علي % ك من الطرائف 
ms127	 والتلائد % 44(@)(@@) % حللا ومعلمة الوجو % % ه وكالظباء من الولائد % 45(@)(@@) % فاظفر بحظك من أخ % متدفق الشربات ماجد % % 46(@)(@@) % يجدي عليك بماله % وبسيفه عند الشدائد % 47(@)(@@) % سام لزلزلة الحرو % % ب يظله خرق المطارد % % 48(@)(@@) % ملك من الملك الهما % % م لكفه وصلت بساعد % % 49(@)(@@) % دماغ هامات الربى % % بمجر أرعن ذي رثائد % % 50(@)(@@) % ومعود ضرب الرقا % % ب وفكهن من الحدائد % PageV01P493 51(@)(@@) % أهلي فداؤك من أمير % جماعة راع وذائد % 52(@)(@@) % يغدو البخيل مذمما % وغدوت ترفل في المحامد % 53(@)(@@) % وكفيت رهطك واحدا % لله درك أي واحد % 54(@)(@@) % ركاب أهوال الملو % % ك مناويا سبل الرواعد % 55(@)(@@) % ويروح أطولهم يدا % في فعلهم وعليك شاهد % % 56(@)(@@) % ويريك خيرا في غد % ولذلك الغتلي زائد % 57(@)(@@) % وتعود حين تسرنا % % وأخو الفعال عليك عائد % 58(@)(@@) % ولقد أقمت قناتنا % % وسقيتنا والمزن جامد % 59(@)(@@) % أصلحت أمر جميعنا % % ووفيت منا بالمعاهد % % 60(@)(@@) % وتركت قلعة ورزن % كمسارب البقر الروائد % % PageV01P494 61(@)(@@) % سيان معطن أهلها % % ومعاطن الغبر الجدائد % % 62(@)(@@) % وأرى البصيرة أشرقت % وتزينت للقا المجاسد % 63(@)(@@) % وعلى المسارح نضرة % وعلى المصادر والموارد % % 64(@)(@@) % ولقد جرت حلباتهم % % فسبقتهن وأنت قاعد % 65(@)(@@) % بخؤولة قرعوا العلى % % وبفضل أعمام ووالد % % 66(@)(@@) % فاقدح زنادك بالمهلب أو % قبيصة ذي المراقد % 67(@)(@@) % أو حاتم بلغوا اليفا % % ع وضوء نارك غير خامد % 68(@)(@@) % بل أيها الرجل المصي % % إلى الأقارب والأباعد % 69(@)(@@) % اعرف فتى بفعاله % % شتان بين ند وجامد % % 70(@)(@@) % الفضل عند بني المهلب % % في المقاوم والمقاعد % % PageV01P495 71(@)(@@) % قوم إذا جحد الربيع ف % % ما ربيعهمو بجاحد % % 72(@)(@@) % لا يبخلون على القصي وين % % عمون على المساند % % 73(@)(@@) % ومرفلين على العشيرة % الحلوم وفي الوطائد % % 74(@)(@@) % ولقد حلفت برب مك % % ه والمحلقة السواجد : % 75(@)(@@) % ما نال فضل بني المهلب % ذ كانوا جود جائد % % 76(@)(@@) % فإذا أردت سبيلهم % في الود والشك المباعد % 77(@)(@@) % فانك العدى ورد الردى % % وابذل فما شيء بخالد % PageV01P496 البحر : كامل تام 1(@)(@@) % يا حب عبدة قد رجعت جديدا % % ما كنت أحسب هالكا موجودا % % 2(@)(@@) % لله درك من خليط شاعف % هل ينفعنك أن أبيت عميدا % % 3(@)(@@) % إن كان 
ms128	 في طول الصحابة عبرة % فلقد صحبتك شائبا ووليدا % % 4(@)(@@) % ما في اتباعك إن تبعتك راحة % ولئن ففقدت لأفقدن مجودا % % 5(@)(@@) % راجعت من كلف لعبدة يدنا % لا أستطيع به القيام وحيدا % % 6(@)(@@) % وذكرت من رمضان آخر ليلة % طلعت كوكبها علي سعودا % % 7(@)(@@) % إذ نلتقي حلقا ونسترق الهوى % % سرق العفاريت السماع مذودا % % 8(@)(@@) % فكأننا عسل بماء سحابة % بعد التفرغ بالأناة أعيدا % % 9(@)(@@) % وغداة ترمقها الوشاة سألتها % % ما خاف من قمر سواك وعيدا % % 10(@)(@@) % وإذا تعرض ذكرها كاتمته % وكفى بأدمعي السجام شهودا % % PageV01P497 11(@)(@@) % ويلومني الصلف الخلي وإنما % % بكرت وساوسها علي وفودا % % 12(@)(@@) % وكأنني رحل أضل رقاده % عان تطيف به الهموم جنودا % % 13(@)(@@) % ولقد حسدت على عبيدة عينها % % عجبا خلقت لما أحب حسودا % % 14(@)(@@) % وثقيلة الأرداف مخطفة الحشا % % مثل الغزالة مقلتين وجيدا % % 15(@)(@@) % قامت تودعني فقلت لها : قري % % قد كنت نائية وكنت بعيدا % % 16(@)(@@) % لا تعجلي نصل الحديث بمثله % لا خير في شرع الفتى تصريدا % % 17(@)(@@) % قالت : وكيف بما تحب مع العدى % % شبت عيونهمو علي وقودا % % 18(@)(@@) % ذوقي عبيد كما أذوق من الهوى % % إن كنت صادقة الصفاء ودودا % % 19(@)(@@) % إن المحب يذوب من مضض الهوى % % دون السراب ولا يكون حديدا % % PageV01P498 البحر : طويل 1(@)(@@) % ألا من لصب عازب النوم ساهد % ومن لمحب مثبت للعوائد % % 2(@)(@@) % وقالوا : به داء أصاب فؤاده % من الجن أو سحر بأيدي الموارد % 3(@)(@@) % وما ذاك إلا حب خود تعرضت % % لتقتلني بالمنظر المتباعد % % 4(@)(@@) % فأدرك مجلودي جوى الحب كاعب % كشمس الضحى في الفائقات الخرائد % % 5(@)(@@) % كأن العذارى حين قومن حولها % % قلائد بدلهن أم القلائد % % 6(@)(@@) % فسارقت أصحابي المكبين نظرة % إلى غادة لم تستتر بالولائد % % 7(@)(@@) % غداة مشت فيهن رود لجارة % يميل بها غصن الهوى المتزائد % 8(@)(@@) % مشت قاب قوس دونها ثم ألقيت % إلى الأرض من جهد الخطى كالمعاند % 9(@)(@@) % فوطأن ممشاها بما لو كسبنه % كفاهن من زبن الخروج الحواشد % % 10(@)(@@) % وخفن الضحى من نومهن على الضحا % % فأقبلن إقبال الغصون الموائد % % PageV01P499 11(@)(@@) % يفدينها طورا وطورا يلمنها % % عواكف حتى جاوزت غير باعد % 12(@)(@@) % فلما 
ms129	 اشتكت حر السموم وأهلها % % قريب وملت مشيها في المجاسد % % 13(@)(@@) % ضربن عليها الستر ثم سترنها % % بأخضر من خز عتيق العضائد % % 14(@)(@@) % من الشمس والرائين والريح والسفا % % كما ستر الضوء الذي في المساجد % 15(@)(@@) % مخافة أن تعدى بشيء يريبها % % فطيمة أو تغتالها عين حاسد % % 16(@)(@@) % أفاطم إن النفس تخفي من الهوى % % جليلا وتبدي مثله في المشاهد % % 17(@)(@@) % ولا صاحب أشكو إليه فأشتفي % % إذا ما شكى رأسي مكان الوسائد % % 18(@)(@@) % سوى راقد لم يدر مابي ولو درى % % لهان عليه مشهدي ومراقدي % % 19(@)(@@) % أعيرت نفسا لم تمت ببقائها % % وما ذنب معدود له الموت وارد % % 20(@)(@@) % كفى منك أني في الجميع إذا بدوا % % أظل كملقى رأسه غير جاهد % PageV01P500 21(@)(@@) % مكبا بعيني الأماني منكمو % % أماني لا تجدي كأحلام راقد % % 22(@)(@@) % وإني أقاسي من جهادك خاليا % عياء فأنى لي بأجر المجاهد % % 23(@)(@@) % كأني بوسواس الهوى من حديثكم % % أخو جنة في المقفلات الحدائد % 24(@)(@@) % فأنت الهوى شطت بك الدار أو دنت % % وإن رغمت منه أنوف الحواسد % 25(@)(@@) % فكوني كما كنا لكم نقض حاجة % ولا تسمعي قول العدو المكايد % % 26(@)(@@) % لقد زادني وجدا لكم وصبابة % إشارة أقوام أكف السواعد % % 27(@)(@@) % إلى من صبا هذا ومن يصب يتهم % % مقالة أدناه ونهي الأباعد % 28(@)(@@) % وحسب الفتى ممن يكابد همه % إذا كان من يهوى كذوب المواعد % % 29(@)(@@) % تشكى الذي في نفسها من مودتي % % وقد زعمت أني بها غير واجد % % 30(@)(@@) % ولكنني أخشى عيونا وأتقي % % بواسط من جار غيور ووالد % % PageV01P501 31(@)(@@) % شكت طول هجراني عشية زرتها % % وما وجدت وجدي بها أم واحد % % 32(@)(@@) % وأقسم لو قيس الذي بي من الهوى % % لقد عرفت فضلا لحران جاهد % % 33(@)(@@) % منعت قيادي غيرها حين رامني % % وذلت بما تهوى إليها مقاودي % % 34(@)(@@) % إذا أنشدت بالشعر عندي قصيدة % طربت ولم تطرب لها أم خالد % % 35(@)(@@) % يخامرني مما أقول بحبها % % جوى مثل سحر البابلي المعاود % % 36(@)(@@) % كأني أكيد النفس مني بكيدها % % فتغفي وأحيي ليلتي جد ساهد % 37(@)(@@) % فإني وتحبيري القوافي فأصبحت % % علي رقى معقودة في القصائد % % 38(@)(@@) % كمستحرش من 
ms130	 عقرب دببت له % % جيوش الأعادي أو جنود الأساود % 39(@)(@@) % فأصبح من هذي وهاتيك قبلها % % نسيم المنايا بارقا بعد راعد % 40(@)(@@) % كذلك من شعري جنيت الذي جنت % فليت الذي كايدته لمكايد % PageV01P502 البحر : بسيط تام 1(@)(@@) % يا حب إن دواء الحب مفقود % إلا لديك ، فهل ما رمت موجود % 2(@)(@@) % قالت : عليك بمن تهوى ، فقلت لها : % يا حب فوك الهوى والعين والجيد % 3(@)(@@) % لا تلعبي بحياتي واقطعي أملي % % صبرا على الموت ، إن الموت مورود % 4(@)(@@) % رؤياك تدعو المنايا قبل موقتها % % وإن تنيلي فنيل منك مخلود % % 5(@)(@@) % أنت الأميرة في روحي وفي جسدي % % فابري وريشي بكفيك الأقاليد % % 6(@)(@@) % لا تسبقي بي حمام الموت وانتظري % % يوما كأن قد طوتني البيض والسود % % 7(@)(@@) % قد لامني فيك أقوام فقلت لهم : % ما ذنب من قلبه حران مجهود ؟ % 8(@)(@@) % ما كنت أول مجنون بجارية % تسفهت لبه والمرء صنديد % 9(@)(@@) % أغرى به اللوم أذن غير سامعة % وأحور العين في سمطين رعديد % % 10(@)(@@) % أحببت حبى وما حبى بمطلبي % % من ليس لي عنده إلا الجلاميد % PageV01P503 11(@)(@@) % بئس العطية من حبى لنا حجر % بل ليس لي حجر منها ولا عود % % 12(@)(@@) % تغدو ثقالا وتمسي في مجاسدها % % كأنها صنم في الحي معبود % % 13(@)(@@) % نامت ولم ألق نوما بعد رؤيتها % % وهل ينام سخين العين معمود % % 14(@)(@@) % يا حسن حبى إذا قامت لجارتها % % وفي الرواح هضيم الكشح أملود % 15(@)(@@) % كأنها لذة الفتيان موفية % وسكرة الموت إن لم يوف موعود % 16(@)(@@) % تؤتيك ما شئت من عهد ومن عدة % فالوعد دان وباب النيل مسدود % 17(@)(@@) % قد صردت هامتي حبى ببخلتها % % ما خير عيش الفتى والكأس تصريد % % 18(@)(@@) % إني لأحسد مولودا مشى قدما % وبي من الداء ما لم يلق مولود % 19(@)(@@) % أرى الإزار على حبى فأحسده % إن الإزار على ما ضم محسود % % 20(@)(@@) % يادام كنت لحاجاتي وصاحبتي % % حتى اشتكيت وغال النوم تسهيد % % PageV01P504 21(@)(@@) % قولي لحبى فقد أحببت رؤيتها : % لو كان لي منك تقريب وتبعيد % % 22(@)(@@) % قرت بك العين أو بتنا على طمع % من النوال وطاب اللهو والغيد % % 23(@)(@@) % لا 
ms131	 خير في عدة ليست بمنجزة % فأنجزي الوعد إن الجود محمود % % 24(@)(@@) % ليس المحب ككمون بمزرعة % إن فاته الماء أغنته المواعيد % % 25(@)(@@) % إن لم تجودي بموعود فلا تعدي % % ما أقبح الوعد حتى زانه الجود ! % 26(@)(@@) % سألت حبى فما عادت على رجل % لسانه عن سؤال الناس معقود % % 27(@)(@@) % والحر يعطيك عفوا من فواضله % % قبل السؤال وسيب العبد منكود % % 27(@)(@@) % كأنه يتقي الحيات فاغرة % لا بل كأني عن المعروف مجدود % % PageV01P505 البحر : خفيف تام 1(@)(@@) % اشفعي لي صريم عند الكنود % % 2(@)(@@) % تيمته عجزاء مهضومة الكشح % تغول الحجى بعين وجيد % % 3(@)(@@) % ولها مضحك كغر الأقاحي % % وحديث كالوشي وشي البرود % 4(@)(@@) % فرأتني حران مشتعب القلب % بئيسا من حبها في قيود % % 5(@)(@@) % ما أصلي إلا وعندي رقيب % قائم بالحصى يعد سجودي % % 6(@)(@@) % فرمت بي خلف الستور لأفوا % % ه المنايا من بين حمر وسود % 7(@)(@@) % ثم قالت : نلقاك بعد ليال % والليالي يبلين كل جديد % 8(@)(@@) % عندها الصبر عن لقائي ، وعندي % % زفرات يأكلن قلب الجليد % 9(@)(@@) % أيها الساقيان صبا شرابي % % واسقياني من ريق صفراء رود % % 10(@)(@@) % من بني مالك بن وهبان كالشا % % دن جلى في مجسد وعقود % PageV01P506 11(@)(@@) % إن في ريقها شفاء لما بي % % وسعوطا للمحصب المورود % % 12(@)(@@) % ولقد قلت حين لج بي الحب و % % بحت خاشعا كالوحيد : % 13(@)(@@) % كيف لي أن أنام حتى أرى وجه % % في النوم يابنة المحمود % 14(@)(@@) % إن دائي طغى وإن شفائي % % غبرة من رضاب فيك البرود % 15(@)(@@) % بحياتي منى علي بنوم % % أو عديني رضيت بالموعود % 16(@)(@@) % قربيني إن الكرامة والقر % ب مكان الودود عند الودود % % 17(@)(@@) % ما أبالي من ضن عني بنيل % % إن قضى الله منك لي يوم جود % % 18(@)(@@) % إن من قد أصبت من شرف الحي % مصيخ إليك خوف الوعيد % % 19(@)(@@) % يعريه الوسواس منك فيضحي % % كالغريب المكب بين القعود % 20(@)(@@) % وإذا ما خلا لبرد مقيل % % حضرته المنى حضور الوقود % PageV01P507 21(@)(@@) % فله زفرة إليك وشوق % حال بين الهوي وبين الهجود % % 22(@)(@@) % يابنة المالكي قد وقع الأمر % فأوفي لعاشق بالعهود % % 23(@)(@@) % لا تكوني لذا وذاك 
ms132	 فإني % % لست عند الذواق بالموجود % 24(@)(@@) % وجوار حور المدامع لذا % % ت الأماني كالنظم نظم الفريد % 25(@)(@@) % صمت عنهن كي تصومي عن القو % م وقد حين مصغيات الخدود % % 26(@)(@@) % وسألت العشاق عنا فقالوا : % زر حبيبا وبت على تسهيد % % 27(@)(@@) % للمحبين راحة في التلاقي % % واشتياق يبريهما في الصدود % % 28(@)(@@) % فادن ممن تحب غير ملوم % % ليس في الحب راحة من بعيد % 29(@)(@@) % قد جوناك يا عبيد وأني % % بكعاب محفوفة بالأسود ؟ % 30(@)(@@) % رهطها شهد وجيرانها سه % د إلينا وقلبها من حديد % % PageV01P508 البحر : بسيط تام 1(@)(@@) % أقوى وعطل من فراطة الثمد % فالربع منك ومن رياك فالسند % % 2(@)(@@) % فالهضب أوحش ممن كان يسكنه % % هضب الوراق فما جادت له الجمد % % 3(@)(@@) % فمن عهدت به الألاف تسكنه % فالعرج تلاقى القاع والعقد % 4(@)(@@) % فافوا المنازل من نجد وساكنه % % فما دريت لأنى طية عمدوا % % 5(@)(@@) % لكن جرت سنح بيني وبينهم % % والأشأمان غراب البين والصرد % % 6(@)(@@) % صاحا بسيرهم حتى استحث بهم % % وبالخليط من الجيران فانجردوا % % 7(@)(@@) % وخلفوا لك آثارا مدعثرة % مما يلبد منها فهو ملتبد % 8(@)(@@) % إلا العراص وإلا الهدب من دمن % على هداملها الأهدام والنجد % 9(@)(@@) % فقف بهن على ما شئت من أثر % % 10(@)(@@) % ومن مباءة ربعان ومن عطن % يدب بينهم القردان والقرد % % PageV01P509 11(@)(@@) % وملعب لجوار ينتقدن به % % وكل منتزة للهو منتقد % 12(@)(@@) % بانوا بهن وفي الأحداج غانية % % في جيدها ومتالي ليتها غيد % 13(@)(@@) % عبل مسورها وعث مؤزرها % % مثل المهاة رداح نبته رود % 14(@)(@@) % هيفاء لفاء جردحل مخلخلها % % تحيي وتقتل من شاءت بما تعد % % 15(@)(@@) % فما يفوز الذي أحيت بمنفعة % ولا لمن قتلت عقل ولا قود % 16(@)(@@) % تخدي بها أصلا بزل مخيسة % مثل القصور عليها البدن الخرد % % 17(@)(@@) % حتى اغتمسن ضحى في آل قرقرة % سقيا لهن وللصمد الذي صمدوا % % 18(@)(@@) % فعدهما ولأمر ما يزحزحهم % % عند الهواهي وأهواء بهم بدد % % 19(@)(@@) % وقل لمرتفق في بيت مملكة % قولا تبرأ منه الغي والفند % % 20(@)(@@) % ما ذا ترى يا ولي العهد في رجل % بقلبه من دواعي شوقه كمد % % PageV01P510 21(@)(@@) % أقام في بلد حتى بكى 
ms133	 ضجرا % من بعضها وبكت من بعضه بلد % 22(@)(@@) % إذا أتاه غدا أو بعده ثقل % تغدو إليه به الأنباء والبرد % 23(@)(@@) % وقربت لمسير منك يومئذ % مراكب منك لم تولد ولا تلد % 24(@)(@@) % تغلي بهن طريق ما به أثر % في مستوى ما به حزن ولا جدد % % 25(@)(@@) % لا في السماء ولا في الأرض مسلكها % % ولا تقوم ولا تمشي ولا تخد % 26(@)(@@) % ولا يذقن أكالا ما بقين ولا % يشربن ماء وهن الشرع الورد % 27(@)(@@) % جون مجللة قعس مجرشعة % ما بات يرمضها أين ولا خضد % 28(@)(@@) % تلوى الأزمة في أذنابها وبها % % في السير يعدل إن جارت فتقتصد % 29(@)(@@) % من كل مقربة للسير منقزة % خوفا تجمع منها الجؤجؤ الأجد % % 30(@)(@@) % من سبعة فإذا أنشأت تحسبها % % وفاكها كملا في كفك العدد % % PageV01P511 31(@)(@@) % السمر والنجر والنجار يقرعها % % والفقر والقير والألواح والعمد % 32(@)(@@) % فقد وفت ولها في وفقها علم % مثل السحابة في أقرابها زبد % 33(@)(@@) % في نشرة بعد حظي طيب جادية % جاءت تهادي بهم من بعد ما هجدوا % % 34(@)(@@) % فثورت بقرا ما مثلهم بقر % إن قمت قاموا وإن قلت اقعدوا قعدوا % % 35(@)(@@) % فبات عرشك فوق الماء يحمله % بحر تلاطم فيه الموج والزبد % 36(@)(@@) % والريح مرسلة والماء منصلت % وأنت مرتفق والسير منجرد % 37(@)(@@) % إلى أبيك أمير المؤمنين بنا % % نفد إليه وفتح ما به نفد % 38(@)(@@) % والله أصلح بالمهدي فاسدنا % % سرنا إليه وكان الناس قد فسدوا % % 39(@)(@@) % داوى صدروهم من بعدما نغلت % % كما يداوى بدهن العرة العند % % 40(@)(@@) % حتى استصحوا وحتى قيل قد رجعوا % % مما دعتهم إليه العادة العند % % PageV01P512 41(@)(@@) % ولم يدع أحدا طغى وبغى % % إلا تناولهم بالكف فاحتصدوا % % 42(@)(@@) % بل لم يكن لجموع المشركين به % ولا يشيعه جول ولا بدد % 43(@)(@@) % سد الثغور بخيل الله ملجمة % وفي الخيول وفي فرسانها سدد % % 44(@)(@@) % ثم انثنيت ولم تنزل به أودا % إلا عدلت فلا جور ولا أود % % 45(@)(@@) % هذا ليمنك والإنسان مفتخر % % والفخر فيه وفي أيامه كبد % 46(@)(@@) % إذا القبائل في بلدانها افتخرت % وكلهم في مقام الجد محتشد % 47(@)(@@) % إن الفخار إلى 
ms134	 من قد بنى لكمو % % مجدا تقاصر عن أركانه أحد % % 48(@)(@@) % ببطن مكة آثار لأولكم % مما بنى لمعد جده أدد % 49(@)(@@) % الله كان وما كانت فكونها % % وما بها غيركم من أهلها سند % % 50(@)(@@) % إلا الديار التي من حولها وتدت % % لو كان يخبر عن جيرانه الوتد % % PageV01P513 51(@)(@@) % تبلى الديار ويبلى من يحل بها % % ودوركم ومغاني دوركم جدد % % 52(@)(@@) % وبيت خالك حجر في ذرى يمن % بيت تكامل فيه العز والنضد % % 53(@)(@@) % وبيت عمرو ومبنى بيت ذي يزن % % وذي الكلاع ومن دانت له الجند % 54(@)(@@) % وتبع وسرابيل الحديد له % أزمان ينسج في أزمانه الزرد % 55(@)(@@) % فافخر هناك بأقوام ذوي كرم % لو خلد الله قوما للعلى خلدوا % % 56(@)(@@) % وهل ترى عجما في الناس أو عربا % إلا لخالك فيهم نعمة ويد % % 57(@)(@@) % فإن جزوك بشكر فالوفاء به % وإن جحدت فعاد قبلهم جحدوا % % 58(@)(@@) % فكيف ذاك ومن أنى يسوغ لهم % وكلهم لك يابن الخير معتبد % % 59(@)(@@) % وأنت يا سيد الإسلام سيدهم % % وكل دين له من أهله سند % 60(@)(@@) % إن فاخروك بمجد كنت أمجدهم % وما ظلمت وأنت الماجد النجد % PageV01P514 61(@)(@@) % أو صالحوك فصلح ما رعوك به % أو حاربوك ففي سربالك الأسد % 62(@)(@@) % ما الليث مفترشا في الغيل كلكله % على مناكبه من فوقه لبد % 63(@)(@@) % يحمي الشبول ويحمي غيل لبوته % وقد تحرق في حيزومه الحرد % 64(@)(@@) % يوما بأجرأ لا والله منك إذا % % أنباء حرب على نيرانها احتردوا % % 65(@)(@@) % تحت العجاجة إذ فيها جماجمهم % % مثل القرود عليها البيض تتقد % % 66(@)(@@) % في كل معترك ضنك يضيق به % % صدر الكمي إذا ما عمه الرمد % 67(@)(@@) % والجرد مثل عجوز النار قد بردت % شوهاء شهباء مزور بها الكتد % % 68(@)(@@) % لم يبق في فمها شيء تلوك به % إلا اللسان وإلا الدردر الدرد % % 69(@)(@@) % باتت تمخض لما أن رأت عددا % من السلاح على قوم لهم عدد % % 70(@)(@@) % والمشرفية قد فلت مضاربها % % عن الكماة وأطراف القنا قصد % % PageV01P515 71(@)(@@) % لو ما تخيرنا مهدي أمته % عما يرى وكماة الحرب تطرد % 72(@)(@@) % أي الثلاثة فيها أنت إذ غدروا % % بذمة الله 
ms135	 والعهد الذي عهدوا % % 73(@)(@@) % أفارس بطل فيها توقدها % % بمن تحارب حتى يعظم الوقد % % 74(@)(@@) % أم عارض برد بالماء يخمدها % % حتى ينشنشها شؤبوبه البرد % 75(@)(@@) % أم رحمة نزلت من ربه لهمو % % ما قد تداركهم من بعد ما جهدوا % % 76(@)(@@) % يحيي البلاد بها من بعد موتتها % % ويخرج النور منها والثرى ثأد % % 77(@)(@@) % يا ليت شعري ومر القيظ مختلف % على شريجين ملفوظ ومزدرد % % 78(@)(@@) % ما بال موسى ومن يدعى لبيعته % % كأنه قفص في ثوبه صرد % % 79(@)(@@) % لا يظهر الدهر ما في فصل بيعته % إلى المجالس إلا وهو يرتعد % 80(@)(@@) % ومن يدب إلى أمر بداهية % % ربداء تذرب عن أدوائها المعد % % PageV01P516 81(@)(@@) % بني أبي جعفر يا خير من حملت % على غواربها العيدية الأجد % % 82(@)(@@) % ما بال غفلتكم عمن يدب لكم % ببيعة لم يجزها الواحد الصمد % % 83(@)(@@) % لله دركمو من أهل مملكة % ما إن لها عنكمو في الأرض ملتحد % 84(@)(@@) % حتى أتتكم تهادى وهي صافية % عفوا يصفق فيها الراعد الغرد % 85(@)(@@) % كلوا الخلافة واحشوا عين حاسدكم % % قيحا يفقئه العوار والرمد % 86(@)(@@) % كم حاسد لكم يرجوا خلافتكم % قد كان يفقأ منه المقلة الحسد % % 87(@)(@@) % أذكى عليكم عيونا غير غافلة % % إذا تغفلت الأحراس والرصد % 88(@)(@@) % وفيم ذاك ولا في العير عدته % ولا النفير ولا إن مات يفتقد % 89(@)(@@) % أمسى وأصبح والآمال معرضة % كالدرهم الزيف منها حين ينتقد % % 90(@)(@@) % إني بريء إليكم من ولايته % كما تبرأ من قناصه الفرد % % PageV01P517 91(@)(@@) % والله يبرأ ممن لا يحبكمو % % يوم القيامة إذ لا ينفع الحفد % 92(@)(@@) % وقد أقول على هذا لقائمكم % قولا يساعده التوفيق والرشد : % 93(@)(@@) % يا أيها القائم المهدي ملككمو % % 94(@)(@@) % إن كنت ملتمسا يوما لها رجلا % يكفي رجالك إن غابوا وإن شهدوا % % 95(@)(@@) % فاسمع وقيت حمام الموت من رجل % ما في مشورته أفن ولا نكد % 96(@)(@@) % تدعو إلى ابنك موسى وهو محتنك % في سنه وبه ما أنعم الجند % % 97(@)(@@) % فإنه ولد بر بوالده % والبر يخلق منه الطرف و التلد % 98(@)(@@) % وإنه ابن التي إن غبت قلت لها : % يا خيزران سقاك الوابل 
ms136	 الرغد % 99(@)(@@) % ما غبت عنها بأرض لا تحل بها % % إلا دعاك إليها القلب والكبد % 100(@)(@@) % وإن موسى وموسى أيما ملك % عليه بعد عمود الدين يعتمد % % PageV01P518 101(@)(@@) % شريك روحك يأوي منك في جسد % ما دام يرزق منه الروح والجسد % % 102(@)(@@) % قد كان لولاك يا مهدي أمته % بالحمد أجمع والمعروف ينفرد % 103(@)(@@) % فاعقد له يا أمير المؤمنين ولا % تنظر به أمدا قد طال ذا الأمد % 104(@)(@@) % واجعل بعينك فيه الآن قرتها % % فقد يقر بعين الوالد الولد % 105(@)(@@) % واعضد أخاه به لاتتركنهما % % كساعد مفرد ليست له عضد % 106(@)(@@) % فقد سمعت بموسى حين أفظعه % وعيد فرعون لو يأتي بما يعد % 107(@)(@@) % حتى استمد بهارون فآزره % % فمن هناك أتاه النصر والمدد % 108(@)(@@) % فاعقد له يا أمير المؤمنين ولا % % تنظر بذاك غدا لا يغررنك غد % % 109(@)(@@) % إن الليالي والأيام فاجعة % والمرء يفنى ولا يبقى له الأبد % 110(@)(@@) % هذا مقالي لكم والله يرشدكم % % ويعلم الله ربي الواحد الصمد % % PageV01P519 111(@)(@@) % أن قد نصحت لكم بالجود من جدتي % % وهل تجود يد إلا بما تجد ؟ % PageV01P520 البحر : بسيط تام 1(@)(@@) % أمن وقوف على شام بأحماد % % ونظرة من وراء العابد الجادي % % 2(@)(@@) % تبكي نديميك راحا في حنوطهما % % ما أقرب الرائح المبقي من الغادي % % 3(@)(@@) % مهلا فإن بنات الدهر عاملة % في الغبرين وما حي بخلاد % 4(@)(@@) % فاخزن دموعك لا تجري على سلف % تخدي إلى الترب يا جهم بن عباد % % 5(@)(@@) % في النفس شغل عن الغادي لطيته % وفي الثواب رضى من صاحب راد % 6(@)(@@) % من قر عينا رماه الدهر عن كثب % والدهر رام بإصلاح وإفساد % 7(@)(@@) % وكيف يبقى لإلف إلف صاحبه % % ولا أرى والدا يبقى لأولاد % % 8(@)(@@) % نفسي الفداء لأهل البيت إن لهم % عهد النبي وسمت القائم الهادي % % 9(@)(@@) % لم يحكموا في مواليهم وقد ملكوا % % حكم المحل ولا حكم ابنه العادي % % 10(@)(@@) % لكن ولونا بإنصاف ومعدلة % حتى هجدنا وكنا غير هجاد % PageV01P521 11(@)(@@) % إني لغاد فمستأد ومنتجع % رهط النبي وذو الحاجات مستاد % 12(@)(@@) % يا رهط أحمد ما زالت أيمتكم % تؤدي الضعيف ولا تكدي لرواد % % 13 
ms137	(@)(@@) % لا يعدم النصر من كنتم مواليه % ولا يخاف جمادا عام أجماد % % 14(@)(@@) % منكم نبي الهدى يقرو محاسنه % % ساقي الحجيج ومنكم منهب الزاد % % 15(@)(@@) % صلت لكم عجم الآفاق قاطبة % فوج وفود وفوج غير غير وفاد % % 16(@)(@@) % إذا رأوكم وإن كانوا على عجل % خروا سجودا وما كانوا بسجاد % 17(@)(@@) % إن الخليفة ظل يستظل به % عال مع الشمس محفوف بأطواد % 18(@)(@@) % قد سرني أن من عادى كبيركم % في الملك نصفان من قتلى وشراد % % 19(@)(@@) % لا يرجعون لما كانوا وإن رغموا % % ولا ينامون من خوف وإجحاد % % 20(@)(@@) % إن الدعي يعادينا لنلحقه % بالمدعين ويلقانا بإلحاد % % PageV01P522 21(@)(@@) % ولا يزال وإن شابت لهازمه % % مذبذبا بين إصدار وإيراد % 22(@)(@@) % ينفيه أصحابه منهم إذا حضروا % % وإن أتانا وهبناه لمرتاد % % 23(@)(@@) % لم يلق ذو المجد ما لاقيت من قرم % % صم عن الخير بالقرآن جحاد % 24(@)(@@) % لم يشعروا برسول الله ، بل شعروا % % ثم استحالوا ضلالا بعد إرشاد % % 25(@)(@@) % أنصفتمونا فعابوا حكمكم حسدا % والله يعصمكم من غل حساد % % 26(@)(@@) % سطوا علينا بأن كنا مواليكم % % وعيرونا بآباء وأجداد % 27(@)(@@) % وقد نرى عار قوم في أنوفهم % % ونترك العيب إذ ليسوا بأنداد % 28(@)(@@) % كأننا عنهم صم وقد سمعت % % آذاننا قول جور غير قصاد % 29(@)(@@) % يزري علينا رجال لا نصاب لهم % % كانوا عبادا وكنا غير عباد % % 30(@)(@@) % لما رأونا نواليكم وننصركم % ثاروا إلينا بأضغان وأحقاد % % PageV01P523 31(@)(@@) % قالوا بنو عمكم من حيث ننصركم % % قول الرسول وهذا قول صداد % % 32(@)(@@) % لولا الخليفة أنا لا نخالفه % % لقد دلفنا لأرواد بأرواد % 33(@)(@@) % حتى نزونا وعين الشمس فاترة % في كوكب كشعاع الشمس وقاد % 34(@)(@@) % نحش نيران حرب غير خامدة % تحت العجاج بأرواح وأجساد % % 35(@)(@@) % هناك ينسون مراوانا وشيعته % % ويطرقون حذار المنسر العادي % % 36(@)(@@) % دون الخليفة منا ظل مأسدة % ومن خراسان جند بعد أجناد % % 37(@)(@@) % قوم يذبون عن مولى كرامتهم % ويحسنون جوار الوارد الصادي % % 38(@)(@@) % لله درهمو جندا إذا حمسوا % % وشبت الحرب نارا بعد إخماد % 39(@)(@@) % لا يفشلون ولا ترجى سقاطتهم % إذا علا زأر آساد لآساد % 40(@)(@@) % إنا سراة بني الأحرار وقرنا 
ms138	 % % ركض الجياد وهز المنصل البادي % % PageV01P524 41(@)(@@) % في كل يوم لنا عيد وملحمة % حتى سبأنا بأسياف وأغماد % 42(@)(@@) % لا نرهب القتل إن القتل مكرمة % ولا نضن على راح بأصفاد % % 43(@)(@@) % سقنا الخلافة تحدوها أسنتنا % % والقاسطون على جهد وإسهاد % % 44(@)(@@) % حتى ضربنا على المهدي قبته % فسطاط ملك بأطناب وأوتاد % % 45(@)(@@) % إن الخليفة طود يستظل به % عال مع الشمس محفوف بأطواد % 46(@)(@@) % تجبى له الأرض من مسك ومن ذهب % ويتقى غير فحاش على البادي % % 47(@)(@@) % يغدو الخليفة مرؤوما نظيف به % % كما يطيف ببيت القبلة الجادي % % 48(@)(@@) % إذا دعانا ذببنا عن محارمه % % ذب البنين عن البنين عن الآباء أحشاد % % 49(@)(@@) % ونازعين يدا خانوا فقلت لهم : % بعدا وسحقا وكانوا أهل إبعاد % % 50(@)(@@) % راحت لهم من يد الوهاب عدتهم % من المنايا توافيهم بميعاد % PageV01P525 51(@)(@@) % فأصبحوا في رقاد الملك قد خفتوا % % ولم يكونوا على السوأى برقاد % % 52(@)(@@) % مثل المقنع في ضرب له سلفوا % % أذباح أصيد للأبطال صياد % 53(@)(@@) % وعادة الله للمهدي في بطر % شق العصا وتولى أحسن العاد % 54(@)(@@) % يا طالب العرف إن الخير معدنه % % في راحتي ملك أضحى ببغداد % 55(@)(@@) % سلم على الجود قد لاحت مخايله % على ابن عم نبي الرحمة الهادي % % 56(@)(@@) % تزين الدين والدنيا صنائعه % % يخرجن من بادئ بالخير عواد % % 57(@)(@@) % عم العراقين بحر حل بينهما % % ينتابه الناس من زور ووراد % % 58(@)(@@) % نرى الندى والردى من راحتيه لنا % % لما جرى الفيض محفوزا بإمداد % 59(@)(@@) % سر غير وان ولا ثان على شجن % إن الإمام لمن صلى بمرصاد % % 60(@)(@@) % وكاشح الصدر تسري لي عقاربه % رشحته لعقاب بعد إجهاد % PageV01P526 61(@)(@@) % أموعدي العبد إن طالت مواعده % % لهفي ! متى كنت أدحيا لرواد ؟ % 62(@)(@@) % دوني أسود بني العباس في أشب % صعب المرام غريز غير منآد % 63(@)(@@) % بين الإمام وموسى لامرئ شرف % % هذا الهمام وهذا حية الوادي % % 64(@)(@@) % الراعيان بإنعام ومرحمة % والغافران ذنوب الحالف الصادي % % 65(@)(@@) % أعطاهما الخالق الأعلى وهزهما % % ميراث أحمد من دين وإصفاد % % 66(@)(@@) % والوالد الغمر والعم المعاذ به % % لم يرضيا دون إفراع وإصعاد % % 67(@)(@@) % قاما بما بين يعبور 
ms139	 إلى سبل % مستضلعين بتباع وقواد % % 68(@)(@@) % حتى استباحا سنام الأرض فانصرفا % % عن آل مروان صرعى غير نهاد % % 69(@)(@@) % نعم الإمامان لا يقفو مقامهما % % بالحرس دون عمود الدين ذواد % % 70(@)(@@) % هما أقاما عصا الإسلام وارتجعا % % أعواد أحمد من شرق وأعواد % % PageV01P527 71(@)(@@) % فالآن قرت عيون فاستقر بها % % موت النفاق ومنفى كل هدهاد % % 72(@)(@@) % تفرجت ظلم الظلماء عن ملك % من هاشم فرس للناكث العادي % % PageV01P528 البحر : طويل 1(@)(@@) % أصفراء ما أنسى هواك ولا ودي % % ولا ما مضى بيني وبينك من وكد % 2(@)(@@) % أبى الله إلا أن يفرق بيننا % % وكنا كماء المزن بالعسل الشهد % % 3(@)(@@) % فيا غاديا يختال في العطر والحلى % % ويا واقفا يبكي مقيما على فقد % % 4(@)(@@) % أصفراء ما صبري وأنت غريبة % كأنك عند ابن السميذع في لحد % % 5(@)(@@) % إذا هتف القمري راجعني الهوى % % بشوق ولم أملك دموعي من الوجد % % 6(@)(@@) % أصفراء لا تبعد نواك فإنما % % يسوق لك المرأى حبيبك من بعد % % 7(@)(@@) % نظرت بحوضى هل أراك فلم أصب % بعيني سوى الجرعاء والأبلق الفرد % 8(@)(@@) % فيا حزنا في الصدر منك حرارة % وفي النفس حاجات تشوق ولا تجدي % % 9(@)(@@) % وقال ابن منظور أصبت فلا تكن % أحاديث نمام تنير ولا تسدي % % 10(@)(@@) % لعلك تسلى أو تساعفك النوى % % ولم تلق ما لاقى ابن عجلان من هند % % PageV01P529 11(@)(@@) % يخوفني موت المحبين صاحبي % % فطوبى لهم سيقوا إلى جنة الخلد % % 12(@)(@@) % وما لقي النهدي إلا سعادة % بمصرعه صلى الإله على النهدي % % 13(@)(@@) % أصفراء لولا ما أؤمل من غد % ضربت بسيفي رأس قيمك العبدي % % 14(@)(@@) % أصفراء لو أرسلت في الريح حاجة % سكنت إليها أو حرجت من الجهد % % 15(@)(@@) % أما تذكرين الراح والعود والندى % % ومجلسنا بين الأزيهر والصمد % % 16(@)(@@) % كأني إذا ما كنت فيه ولا أرى % % سوى وصفات الدهر أيامها عندي % % 17(@)(@@) % تذكرت يوما بالجريد وليلة % بذات الغضا طابت وأخرى على العد % % 18(@)(@@) % ليالي ندنو في الجوار ونلتقي % % على زاهر يلقى الغزالة بالسجد % 19(@)(@@) % فعاودني دائي القديم بحبه % % وفر إلى صفراء قلبي من البرد % 20(@)(@@) % لقد كان ما بيني زمانا وبينها % % كما 
ms140	 كان بين المسك والعنبر الورد % % PageV01P530 البحر : بسيط تام 1(@)(@@) % يا حب طال تمنينا زيارتكم % وأنتم الجيرة الأدنون في البلد % % 2(@)(@@) % أدويتني ودواء الحب عندكم % % لو كنت تشفينني من داخل الكمد % 3(@)(@@) % لا يعدل الحب عندي لو بذلت لنا % % ما يجمع الناس من مال ومن ولد % % 4(@)(@@) % أرجو نوالك في يومي فيخلفني % % وفي غد قد أرجيه وبعد غد % 5(@)(@@) % وأنت عما ألاقي فيك لاهية % بالعطر والملبس القزي والسبد % 6(@)(@@) % أبيت أرمد ما لم أكتحل بكم % % وفي اكتحال بكم شاف من الرمد % % 7(@)(@@) % وكل حب سيستشفي بحبته % % ساقت إلى الغي أو ساقت إلى الرشد % % 8(@)(@@) % إني وعيشك يا عباد فاستمعي % % لو أبتغي فوق هذا الحب لم أزد % 9(@)(@@) % كأن قلبي إذا ذكراكم عرضت % من سحر هاروت أو ماروت في عقد % % 10(@)(@@) % ما هبت الريح من تلقاء أرضكم % % ألا وجدت لها بردا على الكبد % PageV01P531 11(@)(@@) % ولا تيممت أخرى استسر بها % % إلا وجدت خيالا منك بالرصد % % 12(@)(@@) % فهل لهذا جزاء من مودتكم % % مروع القلب بالأحزان والسهد % % 13(@)(@@) % يروق قلبي وتزدادين لي غلظا % ما ذاك فيما أرجي منك بالسدد % % 14(@)(@@) % تحرجي بالهوى إن كنت مؤمنة % بالله أن تقتلي نفسا بلا قود % % 15(@)(@@) % إن كنت تخشين شركا في مودتكم % % فقد تثبت بين الروح والجسد % PageV01P532 البحر : بسيط تام 1(@)(@@) % يا للرجال أمن شخص بأجياد % % يعتاد شوقي وما نومي بمعتاد % % 2(@)(@@) % كأنما أقسمت عيني تسالمه % % حتى ترى أحور العينين في الجادي % % 3(@)(@@) % من كان يزداد من شوق إلى شجن % عند النساء فإني غير مزداد % % 4(@)(@@) % يا سلم إن تصبحي بسلا محرمة % وتنزلي في منيف بين أرصاد % % 5(@)(@@) % فقد رأيت بنات الدهر غافلة % في الغبرين وما حي بخلاد % 6(@)(@@) % إذا فرحت فخافي ترحة عجلا % وإن ترحت فرجي أم عباد % % 7(@)(@@) % من قر عينا رماه الدهر عن كثب % والدهر رام بإصلاح وإفساد % 8(@)(@@) % وكيف يبقى لإلف إلف صاحبه % % ولا أرى والدا يبقى لأولاد % % 9(@)(@@) % بل ليت شعري هل يدنو بكم سبب % % وهل تعودون أيامي بأجياد % % 10(@)(@@) % أيام لا أعتب العذال 