ms16538	 د. إبراهيم صندقجي، الطبعة الأولى، مكتبة دار العلوم والحكم، المدينة المنورة، 1406ه - 1986م.(@)(@@)(@@)(@@) | 21- (@)(@@) مغني المحتاج إلى معرفة معاني ألفاظ المنهاج:(@)(@@) محمد الخطيب الشربيني، (الطبعة بدون) ، دار الفكر للطباعة والنشر، بيروت، لبنان، (التاريخ بدون)(@)(@@)(@@)(@@) | 22- (@)(@@) منهاج الطالبين وعمدة المفتين:(@)(@@) أبو زكريا يحيى بن شرف النووي، (الطبعة بدون) ، دار إحياء الكتب العربية، مصر، 1380ه - 1960م.(@)(@@)(@@)(@@) | 23- (@)(@@) المهذب في فقه الإمام الشافعي:(@)(@@) PageV45P368(@)(@@) أبو إسحاق إبراهيم بن على بن يوسف الفيروزآبادي، الطبعة الثانية، دار المعرفة للطباعة والنشر، بيروت، لبنان، توزيع دار الباز، مكة المكرمة 1379ه - 1959م.(@)(@@)(@@)(@@) | 24- (@)(@@) نهاية المحتاج إلى شرح المنهاج:(@)(@@) أبو العباس أحمد بن حمزة ابن شهاب الدين الرملي، (الطبعة بدون) ، المكتبة الإسلامية، لصاحبها الحاج ورياض الشيخ، (التاريخ بدون) .(@)(@@)(@@)(@@) | 25- (@)(@@) الوجيز في فقه مذهب الإمام الشافعي:(@)(@@) محمد بن محمد بن محمد الغزالي، (الطبعة بدون) ، دار المعرفة للطباعة والنشر بيروت، لبنان، 1399ه-1979م.(@)(@@) كتب أصول الفقه(@)(@@)(@@)(@@) | 1- (@)(@@) التمهيد في أصول الفقه:(@)(@@) محفوظ بن أحمد بن الحسن أبو الخطاب الكلوذاني، دراسة وتحقيق: محمد ابن علي إبراهيم، الطبعة الأولى، مركز البحوث العلمي، مكة المكرمة، 1406ه - 1985م.(@)(@@)(@@)(@@) | 2- (@)(@@) جمع الجوامع:(@)(@@) تاج الدين عبد الوهاب ابن السبكي، مطبوع مع حاشية البناني، (الطبعة بدون) دار الفكر، بيروت، لبنان، (التاريخ بدون) .(@)(@@)(@@)(@@) | 3- (@)(@@) شرح الكوكب المنير:(@)(@@) أبو البقاء محمد بن أحمد بن عبد العزيز الفتوحي المعروف بابن النجار، الطبعة الأولى، مركز البحث العلمي، مكة المكرمة.(@)(@@)(@@)(@@) | 4- (@)(@@) الفروق:(@)(@@) شهاب الدين القرافي، (الطبعة بدون) ، دار المعرفة، بيروت، لبنان، (التاريخ بدون) .(@)(@@) كتب اللغة(@)(@@)(@@)(@@) | 1- (@)(@@) تصحيح التنبيه:(@)(@@) أبو زكريا يحيى بن شرف النووي، مطبوع بهامش التنبيه، الطبعة الأخيرة، شركة مكتبة مصطفى البابي، الحلبي، مصر، 1370ه -1951م.(@)(@@)(@@)(@@) | 2- (@)(@@) حلية الفقهاء:(@)(@@) أبو الحسين أحمد بن فارس، بن زكريا الرازي، تحقيق: د. عبد الله بن عبد المحسن التركي، الطبعة الأولى، الشركة المتحدة للتوزيع، بيروت، 1403ه - 1983م.(@)(@@)(@@)(@@) | 3- (@)(@@) الدر النقي في شرح ألفاظ الخرقي:(@)(@@) يوسف بن حسن بن عبد الهادي الحنبلي المعروف بابن المبرد، تحقيق: د. رضوان مختار بن غربية، الطبعة الأولى، دار المجتمع للنشر والتوزيع، جدة، 1411ه - 1991م.(@)(@@)(@@)(@@) | 4- (@)(@@) لسان العرب:(@)(@@) أبو الفضل جمال الدين محمد بن مكرم بن منظور، 
ms16539	 (الطبعة بدون) ، دار صادر، بيروت، لبنان، (التاريخ بدون) .(@)(@@) PageV45P369(@)(@@)(@@)(@@) | 5- (@)(@@) مختار الصحاح:(@)(@@) محمد بن أبي بكر الرازي، (الطبعة بدون) ، دار الفكر للطباعة والنشر، بيروت، لبنان، 1401ه - 1981م.(@)(@@)(@@)(@@) | 6- (@)(@@) المصباح المنير:(@)(@@) أحمد بن علي المقري الفيومي، صححه: مصطفى السقا، (الطبعة بدون) ، دار الفكر، بيروت، لبنان (التاريخ بدون) .(@)(@@)(@@)(@@) | 7- (@)(@@) معجم لغة الفقهاء:(@)(@@) د. محمد رواس قلعجي، د. حامد صادق قنيبي، الطبعة الأولى، دار النفائس، بيروت، 1405ه - 1985م.(@)(@@)(@@)(@@) | 8- (@)(@@) النظم المستعذب في شرح غريب المهذب:(@)(@@) محمد بن أحمد بن بطال الركبي، مطبوع مع كتاب المهذب، الطبعة الثانية، دار المعرفة للطباعة والنشر، بيروت، لبنان، توزيع دار الباز، مكة المكرمة، 1397ه - 1959م.(@)(@@)(@@)(@@) | 9- (@)(@@) النهاية في غريب الحديث والأثر:(@)(@@) أبو السعادات المبارك بن محمد الجزري ابن الأثير، تحقيق: محمود محمد الطناحي، طاهر أحمد الزاوي، الطبعة الثانية، دار الفكر، بيروت، لبنان، 1399ه - 1979م.(@)(@@) كتب التراجم والطبقات والسير والتاريخ(@)(@@)(@@)(@@) | 1- (@)(@@) أخبار أبي حنيفة وأصحابه:(@)(@@) أبو عبد الله حسين بن على الصيمري، الطبعة الثانية دار الكتب العلمية، بيروت، لبنان، 1976م.(@)(@@)(@@)(@@) | 2- (@)(@@) أخبار القضاة:(@)(@@) محمد بن خلف بن حيان المعروف بوكيع، (الطبعة بدون) ، عالم الكتب، بيروت، لبنان، (التاريخ بدون) .(@)(@@)(@@)(@@) | 3- (@)(@@) الاستيعاب:(@)(@@) ابن عبد البر القرطبي، مطبوع مع الإصابة، (الطبعة بدون) ، دار الكتاب العربي، بيروت، لبنان، (التاريخ بدون) .(@)(@@)(@@)(@@) | 4- (@)(@@) أسد الغابة في معرفة الصحابة:(@)(@@) أبو الحسن علي بن محمد الجزري (الطبعة بدون) ،دار الفكر للطباعة والنشر، بيروت، لبنان، (التاريخ بدون)(@)(@@)(@@)(@@) | 5- (@)(@@) الإصابة في تمييز الصحابة:(@)(@@) أحمد بن علي بن حجر العسقلاني، (الطبعة بدون) ، دار الكتاب العربي، بيروت، (التاريخ بدون) .(@)(@@)(@@)(@@) | 6- (@)(@@) إعجام الأعلام:(@)(@@) محمود مصطفى، الطبعة الأولى، دار الكتب العلمية، بيروت، لبنان 1403ه - 1983م(@)(@@)(@@)(@@) | 7- (@)(@@) الأعلام:(@)(@@) خير الدين الزركلي، الطبعة الخامسة، دار العلم للملايين، بيروت، لبنان، 1980م(@)(@@)(@@)(@@) | 8- (@)(@@) الإكمال:(@)(@@) PageV45P370(@)(@@) الأمير الحافظ ابن ماكولا، تحقيق، عبد الرحمن بن يحيى المعلمي (الطبعة بدون) ، نشرة محمد أمين دمج، بيروت، لبنان، (التاريخ بدون) .(@)(@@)(@@)(@@) | 9- (@)(@@) الأنساب:(@)(@@) أبو سعد عبد الكريم بن محمد بن منصور التميمي السمعاني، تحقيق: عبد الرحمن بن يحيى المعلمي، الطبعة الثانية، نشره محمد أمين دمج، بيروت، لبنان، 1400ه - 1980م.(@)(@@)(@@)(@@) | 10- (@)(@@) الأنوار في شمائل النبي المختار:(@)(@@) محي السنة أبو محمد الحسين 
ms16540	 بن مسعود البغوي، تحقيق: الشيخ إبراهيم اليعقوبي، الطبعة الأولى، دار الضياء للطباعة والنشر، بيروت، 1409ه.(@)(@@)(@@)(@@) | 11- (@)(@@) البداية والنهاية:(@)(@@) الحافظ ابن كثير، الطبعة الثالثة، مكتبة المعارف، بيروت، لبنان، 1979م(@)(@@)(@@)(@@) | 12- (@)(@@) بغية الوعاة في طبقات اللغويين والنحاة:(@)(@@) جلال الدين عبد الرحمن السيوطي، تحقيق: محمد أبو الفضل إبراهيم، الطبعة الثانية دار الفكر، بيروت - لبنان 1399ه -1979م.(@)(@@)(@@)(@@) | 13- (@)(@@) التاريخ:(@)(@@) يحيى بن معين، تحقيق: د. أحمد محمد نور سيف، الطبعة الأولى، مركز البحث العلمي، مكة المكرمة، 1399ه - 1979م.(@)(@@)(@@)(@@) | 14- (@)(@@) تاريخ الأدب العربي:(@)(@@) كارل بروكلمان، الطبعة الثانية، دار المعارف، مصر، القاهرة.(@)(@@)(@@)(@@) | 15- (@)(@@) تاريخ أسماء الثقات:(@)(@@) أبو حفص عمر أحمد بن عثمان المعروف بابن شاهين، حققه وعلق عليه: د. عبد المعطي قلعجي، الطبعة الأولى، دار الكتب العلمية، بيروت، لبنان 1406ه - 1986م.(@)(@@)(@@)(@@) | 16- (@)(@@) تاريخ الإسلام:(@)(@@) شمس الدين محمد بن أحمد بن عثمان الذهبي، الطبعة الأولى، دار الكتاب العربي، بيروت، لبنان، 1407ه - 1987م.(@)(@@)(@@)(@@) | 17- (@)(@@) تاريخ الإسلام - المغازي:(@)(@@) شمس الدين محمد بن أحمد بن عثمان الذهبي، تحقيق د. عمر عبد السلام التدمري، الطبعة الثانية، دار الكتاب العربي، بيروت، لبنان، 1410ه - 1990م.(@)(@@)(@@)(@@) | 18- (@)(@@) تاريخ الأمم والملوك:(@)(@@) أبو جعفر محمد بن جرير الطبري، تحقيق: محمد أبو الفضل إبراهيم، الطبعة الثانية، دار سويدان، بيروت، لبنان، (التاريخ بدون) .(@)(@@)(@@)(@@) | 19- (@)(@@) تاريخ الثقات:(@)(@@) PageV45P371(@)(@@) أحمد بن عبد الله بن صالح العجلي، تحقيق: د. عبد المعطي قلعجي، الطبعة الأولى، دار الكتب العلمية، بيروت، لبنان، 1405ه - 1984م.(@)(@@)(@@)(@@) | 20- (@)(@@) تاريخ جرحان:(@)(@@) السهمي، الطبعة الثالثة، عالم الكتب، بيروت، لبنان، 1401ه - 1981م.(@)(@@)(@@)(@@) | 21- (@)(@@) التاريخ الكبير:(@)(@@) أبو عبد الله محمد بن إسماعيل بن إبراهيم البخاري، (الطبعة بدون) ، توزيع دار الباز، مكة المكرمة، 1406ه - 1986م.(@)(@@)(@@)(@@) | 22- (@)(@@) تبصير المنتبه بتحرير المشتبه:(@)(@@) أحمد بن علي بن حجر العسقلاني، تحقيق: علي محمد البجاوي، (الطبعة بدون) ، المكتبة العلمية، بيروت - لبنان، (التاريخ بدون)(@)(@@)(@@)(@@) | 23- (@)(@@) التبيين في أنساب القرشيين:(@)(@@)(@@)(@@) | 24- (@)(@@) تتمة المختصر في أخبار البشر:(@)(@@) زين الدين عمر بن الوردي، تحقيق: أحمد رفعت البدراوي، الطبعة الأولى، دار المعرفة، بيروت، لبنان، 1389ه - 1970م.(@)(@@)(@@)(@@) | 25- (@)(@@) تجريد أسماء الصحابة:(@)(@@) أبو عبد الله محمد بن أحمد بن عثمان الذهبي، (الطبعة بدون) ، دار المعرفة للطباعة والنشر، بيروت، لبنان، (التاريخ بدون) 