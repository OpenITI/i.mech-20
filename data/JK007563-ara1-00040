ms21	 طعم إذا % % فكرت في الزقوم في النار % % 30(@)(@@) % أي التذاذ بنعيم إذا % % أدى إلى الشقوة في النار % % PageV01P070 31(@)(@@) % أم أي خير في سرور إذا % % أعقب طول الحزن في النار % % 32(@)(@@) % ففكروا في هولها واحذروا % % ما حذر الله من النار % % 33(@)(@@) % فإنها راصدة أهلها % % تدعهم دعا إلى النار % % 34(@)(@@) % فليس مثلي طالبا حبة % % إلا المعافاة من النار % % 35(@)(@@) % وطالما استرحمته ضارعا % % يا رب حرمني على النار % % 36(@)(@@) % فأنت مولاي ولا رب لي % % غيرك أعتقني من النار % % 37(@)(@@) % ولم تزل تسمعني قائلا % % أعوذ بالله من النار % % PageV01P071 البحر : - 1(@)(@@) % بصرت بشيبة وخطت نصلي % % فقلت له تأهب للرحيل % % 2(@)(@@) % ولا يهن القليل عليك منها % % فما في الشيب ويحك من قليل % % 3(@)(@@) % وكم قد ابصرت عيناك مزنا % % أصابك طلها قبل الهمول % % 4(@)(@@) % وكم عاينت خيط الصبح يجلو % % سواد الليل كالسيف الصقيل % % 5(@)(@@) % ولا تحقر بنذر الشيب واعلم % % بأن القطر يبعث بالسيول % % 6(@)(@@) % فكم ممن مفارقه ثغام % % وأنجمه على فلك الأفول % % 7(@)(@@) % تعوض من ذراع الخطو فترا % % ومن عضب بمفلول كليل % % 8(@)(@@) % فكيف بمثله لمهاة رمل % % كأن وصالها نوم العليل % % 9(@)(@@) % تطلب غير ما في الطبع صعب % % عليك فدع طلاب المستحيل % % 10(@)(@@) % ولازم قرع باب الرب دأبا % % فإن لزومه سبب الدخول % % PageV01P072 البحر : - 1(@)(@@) % ألا قل لصنهاجة أجمعين % % بدور الندي وأسد العرين % % 2(@)(@@) % لقد زل سيدكم زلة % % تقر بها أعين الشامتين % % 3(@)(@@) % تخير كاتبه كافرا % % ولو شاء كان من المسلمين % % 4(@)(@@) % فعز اليهود به وانتخوا % % وتاهوا وكانوا من الأرذلين % % 5(@)(@@) % ونالوا مناهم وجازوا المدى % % فحان الهلاك وما يشعرون % % 6(@)(@@) % فكم مسلم فاضل قانت % % لأرذل قرد من المشركين % % 7(@)(@@) % وما كان ذلك من سعيهم % % ولكن منا يقوم المعين % % 8(@)(@@) % فهلا اقتدى فيهم بالألى % % من القادة الخيرة المتقين % % 9(@)(@@) % وأنزلهم حيث يستاهلون % % وردهم أسفل السافلين % % 10(@)(@@) % وطافوا لدينا بأخراجهم % % عليهم صغار وذل وهون % % PageV01P073 11(@)(@@) % وقموا المزابل عن خرقة % % ملونة لدثار الدفين % % 12(@)(@@) % ولم يستخفوا بأعلامنا % % ولم يستطيلوا على الصالحين % % 13(@)(@@) % ولا جالسوهم وهم هجنة % % ولا واكبوهم مع الأقربين % % 14 
ms22	(@)(@@) % أباديس أنت امرؤ حاذق % % تصيب بظنك نفس اليقين % % 15(@)(@@) % فكيف اختفت عنك أعيانهم % % وفي الأرض تضرب منها القرون % % 16(@)(@@) % وكيف تحب فراخ الزنا % % وهم بغضوك إلى العالمين % % 17(@)(@@) % وكيف يتم لك المرتقى % % إذا كنت تبني وهم يهدمون % % 18(@)(@@) % وكيف استنمت إلى فاسق % % وقارنته وهو بيس القرين % % 19(@)(@@) % وقد أنزل الله في وحيه % % يحذر عن صحبة الفاسقين % % 20(@)(@@) % فلا تتخذ منهم خادما % % وذرهم إلى لعنة اللاعنين % % PageV01P074 21(@)(@@) % فقد ضجت الأرض من فسقهم % % وكادت تميد بنا اجمعين % % 22(@)(@@) % تأمل بعينيك أقطارها % % تجدهم كلابا بها خاسئين % % 23(@)(@@) % وكيف انفردت بتقريبهم % % وهم في البلاد من المبعدين % % 24(@)(@@) % على أنك الملك المرتضى % % سليل الملوك من الماجدين % % 25(@)(@@) % وأن لك البق بين الورى % % كما أنت من جلة السابقين % % 26(@)(@@) % وإني احتللت بغرناطة % % فكنت أراهم بها عابثين % % 27(@)(@@) % وقد قسموها وأعمالها % % فمنهم بكل مكان لعين % % 28(@)(@@) % وهم يقبضون جباياتها % % وهم يخضمون وهم يقضمون % % 29(@)(@@) % وهم يلبسون رفيع الكسا % % وأنتم لأوضعها لابسون % % 30(@)(@@) % وهم أمناكم على سركم % % وكيف يكون خؤون أمين % % PageV01P075 31(@)(@@) % ويأكل غيرهم درهما % % فيقصى ويدنون إذ يأكلون % % 32(@)(@@) % وقد ناهضوكم إلى ربكم % % فما تمنعون ولا تنكرون % % 33(@)(@@) % وقد لابسوكم بأسحارهم % % فما تسمعون ولا تبصرون % % 34(@)(@@) % وهم يذبحون بأسواقها % % وأنتم لأطرافها آكلون % % 35(@)(@@) % ورخم قردهم داره % % وأجرى إليها نمير العيون % % 36(@)(@@) % فصارت حوائجنا عنده % % ونحن على بابه قائمون % % 37(@)(@@) % ويضحك منا ومن ديننا % % فإنا إلى ربنا راجعون % % 38(@)(@@) % ولو قلت في ماله إنه % % كمالك كنت من الصادقين % % 39(@)(@@) % فبادر إلى ذبحه قربة % % وضح به فهو كبش سمين % % 40(@)(@@) % ولا ترفع الضغط عن رهطه % % فقد كنزوا كل علق ثمين % % PageV01P076 41(@)(@@) % وفرق عراهم وخذ مالهم % % فانت أحق بما يجمعون % % 42(@)(@@) % ولا تحسبن قتلهم غدرة % % بل الغدر في تركهم يعبثون % % 43(@)(@@) % وقد نكثوا عهدنا عندهم % % فكيف تلام على الناكثين % % 44(@)(@@) % وكيف تكون لهم ذمة % % ونحن خمول وهم ظاهرون % % 45(@)(@@) % ونحن الأذلة من بينهم % % كأنا أسأنا وهم محسنون % % 46(@)(@@) % فلا ترض فينا بأفعالهم % % فأنت رهين بما يفعلون % % 47(@)(@@) % وراقب إلهك في 
ms23	 حزبه % % فحرب الإله هم الغالبون % % PageV01P077 البحر : - 1(@)(@@) % إن أولي العلم بما في الفتن % % تهيبوها من قديم الزمن % % 2(@)(@@) % فاستعصموا الله وكان التقى % % أوفى لهم فيها من أوفى الجنن % % 3(@)(@@) % واجتمعوا في حسن توفيقه % % وافترقوا في كل سعي حسن % % 4(@)(@@) % فعالم مستمجد عامل % % يسلك بالناس سواء السنن % % 5(@)(@@) % ينثر من فيه لهم جوهرا % % من علمه ليس له من ثمن % % 6(@)(@@) % يقسمه طلابه بينهم % % قسمة تعديل بقدر الفطن % % 7(@)(@@) % وبهمة مخترط سيفه % % يغمده في هام أهل الوثن % % 8(@)(@@) % يلبس من إيمانه لأمة % % فضاضة يغنى بها عن مجن % % 9(@)(@@) % وحابس في بيته نفسه % % معتزل مستمسك بالسنن % % 10(@)(@@) % يأخذ من دنياه قوتا له % % مقنعا مثل عذار الرسن % % PageV01P078 11(@)(@@) % قد جعل البيت كقبر له % % وبرده فيه له كالكفن % % 12(@)(@@) % فهو خفيف الظهر لكنه % % أثقل في ميزانه من حضن % % 13(@)(@@) % وهارب شحا على دينه % % إلى البراري ورؤوس الفتن % % 14(@)(@@) % يأنس بالوحدة في بيدها % % أكثر من تأنيسه بالسكن % % 15(@)(@@) % لا يرهب الأسد ومن لم يخن % % سيده في عهده لم يخن % % 16(@)(@@) % وتائب من ذنبه مشفق % % يبكي بكاء الواكفات الهتن % % 17(@)(@@) % تخاله بين يدي ربه % % في ظلم الليل كمثل الغصن % % 18(@)(@@) % إن مهد الناس لدنياهم % % شمر في تمهيده للجنن % % 19(@)(@@) % كأنما الأرض له أيكة % % وهو بها قمرية في فنن % % 20(@)(@@) % وصامت في قلبه مقول % % بالذكر لله طويل لسن % % PageV01P079 21(@)(@@) % تراه كالأبله في ظاهر % % وهو من اذكى الناس فيما يظن % % 22(@)(@@) % قد نور الله له قلبه % % بالذكر في السر له والعلن % % 23(@)(@@) % فإن يبن بالفكر عن صحبه % % فجسمه بينهم لم يبن % % 24(@)(@@) % إن لغوا جليس لهم % % لم يلج اللغو له في أذن % % 25(@)(@@) % في ملكوت الله سبحانه % % تجول ألباب لباب الفطن % % 26(@)(@@) % فهم خصوص الله نحو التي % % من حل في جيرتها قد أمن % % 27(@)(@@) % ونزهوا الأنفس عن منزل % % نازله مستوفز للظعن % % 28(@)(@@) % وسمروا الخيل ليوم به % % ينكب من يركب فوق الهجن % % 29(@)(@@) % فليتني كنت لهم خادما % % وليتني إذ لم أكن لم أكن % % 30(@)(@@) % ومن سواهم فرجال رجوا % % أن يعبروا 
ms24	 البحر بغير السفن % % PageV01P080 31(@)(@@) % وإنما قصر بي عنهم % % حبي لدار ملئت بالفتن % % 32(@)(@@) % لا غارت الدنيا ولا أنجدت % % فالعاقل الحر بها ممتحن % % 33(@)(@@) % تميل للأحمق من اهلها % % وهي على عاقلهم تضطغن % % 34(@)(@@) % يا عجبا من غفلتي بعد أن % % ناداني الشيب ألا فارحلن % % 35(@)(@@) % وأدرك الفائت من قبل ان % % يفجأك الموت فلا تنظرن % % 36(@)(@@) % اقبح من ترمقه مقلة % % مبصرة شيخ خليع الرسن % % 37(@)(@@) % تقتاده الدهر دواعي الهوى % % إلى الصبا مثل اقتياد البدن % % 38(@)(@@) % يأمل آمال فتى يافع % % كأنه ليس بشيخ يفن % % 39(@)(@@) % ليس جمال الشيخ إلا التقى % % والمحو للسؤ بفعل حسن % % 40(@)(@@) % شغلت بالوصف ولو أنني % % أشغل بالموصوف كنت الفطن % % PageV01P081 41(@)(@@) % ولم أبع رشدا بغي ولم % % أرض بعقلي مثل هذا الغبن % % 42(@)(@@) % إنا إلى الله لقد حاق بي % % ما يورث الخزي غدا والحزن % % 43(@)(@@) % والحمد لله ففي كفه % % منح لمن شاء وفيها المنن % % 44(@)(@@) % وهو الذي أرجو فإن لم يكن % % عند رجائي فيه طولا فمن % % PageV01P082 البحر : - 1(@)(@@) % تمر لداتي واحدا بعد واحد % % واعلم أني بعدهم غير خالد % % 2(@)(@@) % وأحمل موتاهم وأشهد دفنهم % % كأني بعيد منهم غير شاهد % % 3(@)(@@) % فها أنا في علمي بهم وجهالتي % % كمستيقظ يرنو بمقلة راقد % % PageV01P083 البحر : - 1(@)(@@) % ما توج الملك إلا بابن سلمان % % ولا يشد سواه أزر سلطان % % 2(@)(@@) % ما الريح في سيرها تحكي عزائمه % % إلا الجياد إذا جدت بأقران % % 3(@)(@@) % كانت جزيرتنا من قبل أندلسا % % فمذ نشأت بها فهي العراقان % % 4(@)(@@) % نهدي إليك القوافي وهي طيبة % % كالراح تهدى زفافا بين خلان % % 5(@)(@@) % مالي تلاحظني عين الخطوب وقد % % أسندت منك إلى ركن كثهلان % % 6(@)(@@) % وكيف يشكو الصدى مثلي على مقتي % % وماؤك الغمر يروي كل ظمآن % % 7(@)(@@) % أم كيف يطمح شيطان إلى افقي % % ومن سمائك يرمى كل شيطان % % 8(@)(@@) % بل كيف يغمرني إنسان أعينهم % % وأنت لي وزر من كل إنسان % % 9(@)(@@) % نبه أبا حسن للمعضلات ونم % % نوم العروس على روح وريحان % % PageV01P084 البحر : - 1(@)(@@) % رفعتم على قاضيكم فخفضتم % % وحاولتم خزيا له فخزيتم % % 2(@)(@@) % وطال لعمري ما سعدتم بسعده % % ولو أنه 
ms25	 يشقى إذن لشقيتم % % 3(@)(@@) % وما كان إلا ستركم لو عقلتم % % ولكنكم عن رشدكم قد عميتم % % 4(@)(@@) % وحكوا على ظهر الصعيد ستاهكم % % فلن تعشروه في العلى لو خريتم % % PageV01P085 البحر : - 1(@)(@@) % أيا قوس خراط يشير ولا يرمي % % ويا سيف رعديد يرض ولا يدمي % % 2(@)(@@) % تعلمت خلف الوعد من برق خلب % % فبرقك لا يثري ولكنه يعمي % % PageV01P086 البحر : - 1(@)(@@) % السواط أبلغ من قال ومن قيل % % ومن نباح سفيه بالأباطيل % % 2(@)(@@) % مر المذاق كحر النار أبرده % % يعقل المتعاطي أي تعقيل % % 3(@)(@@) % رأى من الطب ما بقراط لم يره % % في برء كل سخيف العقل مخذول % % 4(@)(@@) % عند السخيف به خبر وتجربة % % فقد رمى تحته ما عد بالفول % % 5(@)(@@) % وقد حسا منه امراقا مفلفلة % % جشته شر الجشا من شر مأكول % % 6(@)(@@) % وقد هجاه بهجو مؤلم وجع % % لا يشبه الشعر في نظم وتفصيل % % 7(@)(@@) % فقل له إن جرى هجو بخاطره % % أذكر قيامك محلول السراويل % % 8(@)(@@) % واذكر طوافك في الأسواق مفتضحا % % مجردا خاشعا في ذل معزول % % 9(@)(@@) % واذكر عقوبة ما زورته سفها % % في السادة القادة الشم البهاليل % % 10(@)(@@) % عصابة عظم الرحمن حرمتها % % وخصها منه إكراما بتبجيل % % PageV01P087 11(@)(@@) % هم لباب الورى حقا وغيرهم % % عند الحقيقة ابقال الغرابيل % % 12(@)(@@) % إن ابن توبة فيهم رافع علما % % من القضاء وممتاز بإكليل % % 13(@)(@@) % قضى بتنكيل من لم يرع حقهم % % وحصن الحكم في هذا بتسجيل % % 14(@)(@@) % الظهر قرطاسه والسوط يطلبه % % بئس الكتاب بعقد غير محلول % % PageV01P088 البحر : - 1(@)(@@) % أيا وزيرا لم يزل آخذا % % عند الملمات بأيدينا % % 2(@)(@@) % وسيدا نحكم في ماله % % وجاهه النامي بما شينا % % 3(@)(@@) % اراك مشغولا بكسب العلا % % وحارسا دنياك والدينا % % 4(@)(@@) % فاجعل من الليل لنا ساعة % % يحكم فيها ماله جينا % % 5(@)(@@) % ولا يكن يحضرنا ثالث % % فربما الثالث يؤذينا % % PageV01P089 البحر : - 1(@)(@@) % أين الملوك وأين ما جمعوا وما % % ذخروه من ذهب المتاع الذاهب % % 2(@)(@@) % ومن السوابغ والصوارم والقنا % % ومن الصواهل بدن وشوازب % % 3(@)(@@) % كانت سوابقها تحمل منهم % % اقمار أندية وأسد كتائب % % 4(@)(@@) % كانوا ليوث خفية لكنهم % % سكنوا غياض اسنة وقواضب % % 5(@)(@@) % قصفتهم ريح الردى ورمتهم 
ms26	 % % كف المنون بكل سهم صائب % % 6(@)(@@) % فإن الردى غال أهل التقى % % فلم يبق إلا الغشوم العنيد % % 7(@)(@@) % وأودى بكل خليل ودود % % فأين ولا أين خل ودود % % 8(@)(@@) % وكم من أخي ثقة قد لحدت % % فلله ما غيبته اللحود % % 9(@)(@@) % وأثكلني الأنس ثكل اللدات % % فصرت كأني غريب وحيد % % 10(@)(@@) % وكم من شقي يوارى التراب % % وكم من سعيد يوارى الصعيد % % PageV01P090 البحر : - 1(@)(@@) % لا قوة لي يا ربي فأنتصر % % ولا براءة من ذنبي فأعتذر % % 2(@)(@@) % فإن تعاقب فأهل للعقاب وإن % % تغفر فعفوك مأمول ومنتظر % % 3(@)(@@) % إن العظيم إذا لم يعف مقتدرا % % عن العظيم فمن يعفو ويقتدر % % PageV01P091 البحر : - 1(@)(@@) % وذي غنى أوهمته همته % % أن الغنى عنه غير منفصل % % 2(@)(@@) % فجر أذيال عجبه بطرا % % واختال للكبرياء في حلل % % 3(@)(@@) % بزته أيدي الخطوب بزته % % فاعتاض بعد الجديد بالسمل % % 4(@)(@@) % فلا تثق بالغنى فآفته % % الفقر وصرف الزمان ذو دول % % 5(@)(@@) % كفى بنيل الكفاف منه غنى % % عنه فكن فيه غير محتفل % % PageV01P092 البحر : - 1(@)(@@) % أتيتك راجيا ياذا الجلال % % ففرج ما ترى من سوء حالي % % 2(@)(@@) % عصيتك سيدي ويلي بجهلي % % وعيب الذنب لم يخطر ببالي % % 3(@)(@@) % لعمرى ليت أمي لم تلدني % % ولم أغضبك في ظلم الليالي % % 4(@)(@@) % فها أنا عبدك العاصي فقير % % إلى رحماك فاقبل لي سؤالي % % 5(@)(@@) % فإن عاقبت يا ربي تعاقب % % محقا بالعذاب وبالنكال % % 6(@)(@@) % وإن تعف فعفوك قد أراني % % لأفعالي وأوزاري الثقال % % PageV01P093 البحر : - 1(@)(@@) % كل امرىء فيما يدين يدان % % سبحان من لم يخل منه مكان % % 2(@)(@@) % يا عامر الدنيا ليسكنها وما % % هي بالتي يبقى بها سكان % % 3(@)(@@) % تفنى وتبقى الأرض بعدك مثلما % % يبقى المناخ وترحل الركبان % % 4(@)(@@) % أأسر في الدنيا بكل زيادة % % وزيادتي فيها هي النقضان % % PageV01P094 البحر : - 1(@)(@@) % كم آمن للمنون لاه % % عن الردى بات مطمئنا % % 2(@)(@@) % صبحه وافد المنايا % % فعاين الموت حين عنا % % 3(@)(@@) % حتى إذا ما قضى بكاه % % حميمه معولا مرنا % % 4(@)(@@) % واروه في لحده وسنوا % % العليه قيد التراب سنا % % 5(@)(@@) % وانتهبوا ماله وشنوا % % الغارات فيما حواه شنا % % 6(@)(@@) % لمثل هذا فكن معدا % % ما قد اعد 
ms27	 الهداة منا % % 7(@)(@@) % وارتقب الموت فهو حتم % % يخترم الطفل والمسنا % % PageV01P095 
ms28	