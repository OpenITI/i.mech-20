ms81	 الأرض حاكيا % % 34(@)(@@) % إذا ما مشى يوما على الرأس موحيا % إلى ملك وافى على االرأس ماشيا % % 35(@)(@@) % إذا أعلمته كفه خلت أنه % يسن سنانا أو يسل مواضيا % % 36(@)(@@) % لقد حسد الأقوام لفظي وفضله ، % وقد غبطوا إحسانه ولسانيا % % 37(@)(@@) % غداة تجارينا إلى السبق ، فاغتدى % % يشيد المعالي ، أو أجيد المعانيا % % 38(@)(@@) % وقالوا : أجدت النظم فيه ، أجبتهم : % يرى الزهر أنى أصبح الغيث هاميا % % 39(@)(@@) % فيا محسنا إلا إلى المال وحده ، % وفي ذاك إحسان لمن كان راجيا % % 40(@)(@@) % فذلك قوم لو مدحت صنيعهم ، % لظن الورى أني أعد المساويا % % PageV01P275 41(@)(@@) % رعيت أمور المسلمين بهمة ، % رأيت بها مستقبل الأمر ماضيا % % 42(@)(@@) % لقد عجزوا عن أن يروا لك في الندى % % مدى الدهر أو عنه من الناس ثانيا % % 43(@)(@@) % ويوم أعدت الصبح كالليل عندما % % حجبت ذكا لما أجلت المذاكيا % % 44(@)(@@) % وأجريتها قب البطون تخالها ، % إذا ما سعت تحت العجاج ، سعاليا % % 45(@)(@@) % يمزق تكرار الصدام جلودها ، % فتكسى دما ما أصبح السيف عاريا % % 46(@)(@@) % سقيت بها الأعداء كأسا من الردى ، % غداة غدا كل من الكر ظاميا % % 47(@)(@@) % % وبيض الظبى كأسا وعزمك ساقيا % % 48(@)(@@) % وكم قد كسيت العز من جاء آملا % إذا ما مشى في ربع قدسك حافيا % % 49(@)(@@) % بسطت من المعروف أرضا مديدة ، % وأنبت فيها للحلوم رواسيا % % 50(@)(@@) % وإني ، وإن فارقت مغناك مخطئا ، % لأعلم أني كنت في ذاك خاطيا % % PageV01P276 51(@)(@@) % فكيف بعادي عن مغان ألفتها ، % وأفنيت عمري بينها وشبابيا % % 52(@)(@@) % وقضيت فيها الأربعين مجاورا % ملوك البرايا والبحور الطواميا % % 53(@)(@@) % أصيف وأشتو بينهم ، فكأنني % % نزلت على آل المهلب شاتيا % % 54(@)(@@) % بذلت لنا ، يا ذا المكارم ، أنعما % تسر الموالي ، إذ تسوء المعاديا % % 55(@)(@@) % ولولاك لم تعن الملوك بمنطقي ، % ولا خطبوا مدحي لهم وخطابيا % % 56(@)(@@) % ولولاك لم يعرف مسماي بينهم ، % ولا أصبح اسمي في الممالك ساميا % % 57(@)(@@) % أحيد عن السحب التي ترسل الحيا ، % وإن كنت حران الجوانح صاديا % % 58(@)(@@) % فسوف أجيد النظم فيك وأنثني % % إلى النثر ، إن أفنى النظام القوافيا % % 59(@)(@@) % وأشكركم ما دمت حيا ، وإن أمت % ولم أوفه ، أوصيت بالشكر آليا % % PageV01P277 البحر 
ms82	 : خفيف تام 1(@)(@@) % زوج الماء بابنة العنقود ، % فانجلت في قلائد وعقود % 2(@)(@@) % قتلت بالمزاج ظلما ، فقالت : % كم قتيل كما قتلت شهيد % 3(@)(@@) % طاف يسعى بها أغن حكى ما % % في يديه بثغره والخدود % 4(@)(@@) % قرب الكأس نحو عارضه الغض ، % فأبدى العتيق فضل الجديد % 5(@)(@@) % فغدا التائبون منا ندامى ، % والندامى في ظل عيش رغيد % 6(@)(@@) % فصلينا لظى ، وأزلفت الجنة % للمتقين غير بعيد % 7(@)(@@) % أنا صب قضت له شرعة العشق % بألا يموت غير شهيد % 8(@)(@@) % فإذا ما نجوت من معرك الألحاظ % لم أنج من كمين القدود % 9(@)(@@) % كلذما أخلق التجلد وجدي % % جاد داعي الهوى بوجد جديد % 10(@)(@@) % مثل أهل الجحيم إن تذهب النار % جلودا تبدلوا بجلود % PageV01P278 11(@)(@@) % قسما بالمطي مثل الهوادي ، % نظمتها الحداة نظم العقود % 12(@)(@@) % فهي طورا قلائد القلل الشم ، % وطورا وشاح خصر البيد % 13(@)(@@) % نكبت مرتع الشآم وأمت % نحو مرعى أحوى وظل مديد % 14(@)(@@) % فإذا ما تجاوزت حر حران ، % أناخت ببرد عين البرود % 15(@)(@@) % وتغانت بنهر حرزم والغر % سينه عن نهر ثورة ويزيد % 16(@)(@@) % لقد استعصمت بحصن حصين ، % حين لاذت منها بركن شديد % 17(@)(@@) % وأناخت بظل أبلج رحب الصدر ، % نزر الأقران ، جم الحسود % 18(@)(@@) % ساهر النار ، راقد الجار ، رحب الدار % حي الأكناف ، ميت الحقود % 19(@)(@@) % بطول النجاد ، ضيق باع الع % ذر ، سمح ، قصير عمر الوعود % 20(@)(@@) % خير أبناء أرتق الملك الصالح % شمس الدين الفريد الوحيد % PageV01P279 21(@)(@@) % ملك أنفد الذوابل بالنقل ، % وأفنى الصفاح بالتقليد % 22(@)(@@) % حامل من شدائد الملك ما حمل % قدما سميه من ثمود % 23(@)(@@) % من أناس ، إذا تمنعت العلياء % كانوا منها كحبل الوريد % 24(@)(@@) % عرفوا الزحف قبل معرفة القمط ، % وحلوا السروج قبل المهود % 25(@)(@@) % أيها الماجد الذي حمل الأثقال % في طاعة الحميد المجيد % 26(@)(@@) % لا تكن خائفا سوى الله شيئا ، % إنها من شواهد التوحيد % 27(@)(@@) % فإذا زادت الحوادث حدا ، % كان نقص الكمال في المحدود % 28(@)(@@) % كم جموع فللتها بحسام % شرق الصفحتين ظامي الخدود % 29(@)(@@) % فغدوا والرؤوس فوق صعاد ، % وجسام الجسوم تحت الصعيد % 30(@)(@@) % يا إمام السخا ، وصنو المعالي ، % ونبي الندى 
ms83	 ، ورب الجود % PageV01P280 31(@)(@@) % نقدتك العلياء ، غذا أعوز ، الكفء لديها % % فكنت أغلى النقود % 32(@)(@@) % فإذا آل أرتق حاولوا الفخر % بماضي الحدود أو بالجدود % 33(@)(@@) % كنت ملقى العصا وواسطة العقد ، % وقطب الرجا وبيت القصيد % 34(@)(@@) % فلو أن الزمانض ينطق يوما ، % قال : هذا إنسان عين الوجود % 35(@)(@@) % وإذا الدهر خطذ حولك طرسا ، % كان عنوانه أقل العبيد % 36(@)(@@) % يا مليكا ، إذا عزيت لفخر % كان من بره وجودي وجودي % % 37(@)(@@) % أنت علمتني التجري على الدهر % وفتكي بكل خطب شديد % 38(@)(@@) % فإذا ما أمرت دهري بأمر % خلت أن الأيام بعض جنودي % % 39(@)(@@) % وبك استعذب الملوك كلامي ، % ورعوا حق حرمتي وعهودي % % 40(@)(@@) % فمن الجهل أن أروم أجازيك % بمعنى رسالة ، أو قصيد % % PageV01P281 41(@)(@@) % أو أصوغ الأشعارض يوم هناء ، % يشمل الملك ، أو أهني بعيد % 42(@)(@@) % غير أن الإله يجزيك ، غذ لم % % يك غير الثناء من مجهودي % % 43(@)(@@) % فاستمعها بكرا حماها ضياء الحس % مني عن ظلمة التعقيد % 44(@)(@@) % هجنت شعر كل من عقد القاف % جميعا ، لا جرول ولبيد % 45(@)(@@) % وابق طول الزمان تفني وتغني ، % وتهنى بكل عيد جديد % PageV01P282 البحر : طويل 1(@)(@@) % صفاح عيون لحظها ليس يصفح ، % ونبل جفون للجوارح تجرح % 2(@)(@@) % وماء حياء ليس ينقع غلة ، % ونار خدود للجوانح تلفح % 3(@)(@@) % ومنظر حسن في سنا البدر رسمه % إلى القلب أحلى وهو في العنين أملح % 4(@)(@@) % وجوهر ثغر يحزن القلب لمحه ، % وقد زعموا أن الجواهر تفرح % 5(@)(@@) % وصلت وصلت السهد بالجفن عندما % % غدا وهو من عذري عن الصبر أوضح % 6(@)(@@) % محاسن قادت نحوها شارد الهوى ، % وظل إليها ناظر القلب يطمح % 7(@)(@@) % إذا ضم أقسام الجمال تحيز ، % فإن جميل الصبر بالحر يقبح % 8(@)(@@) % فلله صب لا يبل غليله ، % وإنسان عين بالمدامع يسبح % 9(@)(@@) % ونفس أبت إلا نزاعا إلى الصبا ، % تقاعسها وخط المشيب ، فتجمح % 10(@)(@@) % وأشمط من ورق الحمام كأنما % % سنا الصبح يصبي قلبه حين يصبح % PageV01P283 11(@)(@@) % يرجع تكرارض الهديل مغردا ، % فيصدع قلبي نوحه حين يصدح % 12(@)(@@) % وما ذاك إلا أن شدوت فقد غدا % % يلوح بالأحزان لي فأصرح % 13(@)(@@) % وما ضرني بعد الديار 
ms84	 ، وأهلها % % بأرضي ، وفقد الطرف ما كان يلمح % 14(@)(@@) % ورجلاي في أفناء دجلة قد سعت ، % وطرفي في أفناء حرزم يسرح % 15(@)(@@) % منازل لم أذكر بها السقط واللوى ، % ولم يصبني عنها الدخول فتوضح % 16(@)(@@) % ولم أقر بالمقراة طرفي بمثلها ، % فتسرح فيها العين ، والصدر يشرح % 17(@)(@@) % فإن أك قد فارقت إلفا ومعشرا % كراما ، إلى علياهم العز يجنح % 18(@)(@@) % فصبرا لما قد أفسدته يد النوى ، % عسى أنه بالصالح الملك يصلح % 19(@)(@@) % مليك ، إذا ما رمت مدحا لمجده ، % تعلمني أوصافه كيف أمدح % 20(@)(@@) % له في الوغى والجود نفس زكية ، % من الليث أسطى ، أو من الغيث أسمح % PageV01P284 21(@)(@@) % وأضيق من سم الخياط اعتذاره ، % وصدر من الأرض البسيطة أفسح % 22(@)(@@) % تحل بكفيه اللهى عمر ساعة ، % لتنزحها وفاده ، ثم تنزح % 23(@)(@@) % لقد ظل يصميني الزمان لبعده ، % ويحزن قلبي منه ما كان يفرح % 24(@)(@@) % فقلت لصرف الدهر ها أنا راحل % غلى ملك قلبي منه ما كان يفرح % 25(@)(@@) % إلى ملك يخفي الملوك ، فيجتلي ، % وتغلق أبواب السماح ، فيفتح % 26(@)(@@) % إلى ملك لا مورد الجود عنده % أجاج ، ولا مرعى السماح مصوح % 27(@)(@@) % إلى ملك يلقى الثناء بمثله % % وينعم من بعد الثناء ويسمح % 28(@)(@@) % إلى ملك لا زال للمدح خاطبا ، % وزاد إلى أن كاد للمدح يمدح % 29(@)(@@) % ويذكرني الإلف الذي هو فاقد ، % فقد زجل المداح فيه ووشحوا % % 30(@)(@@) % تقول لي العلياء ، إذ زرت ربعه ، % رويدك ! كم في الأرض تسعى وتكدح % PageV01P285 31(@)(@@) % إذا كنت ترضى أن تعد بتاجر ، % هلم ، ففيه تاجر المدح يربح % 32(@)(@@) % فأنتجت من فكري له كل كاعب % يزين عطفيها البديع المنقح % 33(@)(@@) % وخلدت شعري في الطروس لأنني % % أرى الشعر يعلو قدره حين يقرح % 34(@)(@@) % فيا ملكا قد أطمع الناس حلمه ، % لكثرة ما تهفو ، فيعفو ويصفح % 35(@)(@@) % أعد ، غير مأمور ، على الضد كيده ، % واذك له النار التي بات يقدح % 36(@)(@@) % فقد أيقن الأعداء أنك راحم ، % فباهوا بأفعال الخناء ، وثجحوا % % 37(@)(@@) % إذا ما فعلت الخير ضوعف شرهم ، % وكل إناء بالذي فيه ينضح % 38(@)(@@) % ولو تابعوا قول الإله وأمره ، % لقالوا بأن الصلح للخلق 
ms85	 أصلح % 39(@)(@@) % تهن بعيد النحر ، وانحر من العدى ، % فجودك عيد للورى ليس يبرح % 40(@)(@@) % وضح بهم ، لا زلت تنحر مثلهم ، % ومن دون مغناك العقاير تذبح % PageV01P286 البحر : موشح 1(@)(@@) % لما شدت الورق على الأغصان % بين الورق % 2(@)(@@) % ماست طربا بها غصون البان % كالمغتبق % 3(@)(@@) % الطير شدا % % ومنظر الزهر بدا % % 4(@)(@@) % والقطر غدا % % يوليه جودا وندى % % 5(@)(@@) % والجون حدا % % ومد في الجو ردا % % 6(@)(@@) % والنرجس جفن طرفه % % الوسنان لم ينطبق % 7(@)(@@) % بل بات إلى شقائق % النعمان ساهي الحدق % 8(@)(@@) % يا ليلة بتنا ، وبها % % العز مقيم % 9(@)(@@) % ما بين حياض % ورياض ونسيم % 10(@)(@@) % ما أمهلنا الصبح % لنحظى بنعيم % PageV01P287 11(@)(@@) % لكن تجلت على الظلام الواني % % شمس الأفق % 12(@)(@@) % حتى خضبت من النجيع القاني % % سيف الشفق % 13(@)(@@) % لما شهر الربيع % في الأرض نصال % % 14(@)(@@) % بالخصب شطا % % في معرك المحل وصال % % 15(@)(@@) % والزهر ذكا % % وأكسب الريح خصال % % 16(@)(@@) % والغيث همى بوبله الهتان % بين الطرق % 17(@)(@@) % من محتبس في سرحة الغدران % أو منطلق % 18(@)(@@) % أهدت لي أنفاس % نسيم السحر % 19(@)(@@) % ما أودعها طيب أريج % الزهر % 20(@)(@@) % لم أدر ، وقد جاءت بنشر % عطر % PageV01P288 21(@)(@@) % بالزهر غدت مسكية الأردان % للمنتشق % 22(@)(@@) % أم أكسبها نشر ثنا السلطان % طيب العبق % 23(@)(@@) % ملك كفلت أكنافه % كل غريب % % 24(@)(@@) % كم أبعد بالنوال % من كان قريب % % 25(@)(@@) % ينأى خجلا كأنه % منه مريب % % 26(@)(@@) % عن حضرته الحياء قد أقصاني % % لا عن ملق % 27(@)(@@) % بل أبعد عن مواقع الطوفان % خوف الغرق % 28(@)(@@) % لولا عزمات الملك % الصالح ما % % 29(@)(@@) % شاهدت حمى الشهباء % قد صار حمى % % 30(@)(@@) % إن صالح ما يعصي ، % وإن صال حمى % % PageV01P289 31(@)(@@) % إن شاهد بأسه ذوو التيجان % تحت الحلق % 32(@)(@@) % من هيبته خروا إلى الأذقان % مثل العنق % 33(@)(@@) % قد أوجدني نداه % بعد العدم % % 34(@)(@@) % إذ صان عن الأنام % وجهي ودمي % % 35(@)(@@) % لم أصفق كفي عنده % من ندم % 36(@)(@@) % لو شئت لهامة السهى أوطاني % % عند الغرق % 37(@)(@@) % لولاه لما سلوت عن أوطاني % % بعد القلق % 38(@)(@@) % يا ابن الملك المنصور % يا خير خلف % 39(@)(@@) % يا من هو 
ms86	 أنموذج من % % كان سلف % 40(@)(@@) % كم أتلف كنز المال من % % غير تلف % PageV01P290 41(@)(@@) % إذ فرق ما حوى مدى الأزمان % بين الفرق % 42(@)(@@) % فالمال فني ، وكل شيء فإن % والذكر بقي % % 43(@)(@@) % إسعد بدوام الملك % لا زلت سعيد % % 44(@)(@@) % إذ أنت أجل من أن % أنيك بعيد % 45(@)(@@) % هنيت ، ولا برحت % تبدي وتعيد % 46(@)(@@) % تبدي لذوي الرجاء والإخوان % حسن الخلق % 47(@)(@@) % إذ فيك كمال الحسن والإحسان % لم يفترقد % % PageV01P291 البحر : بسيط تام 1(@)(@@) % ما هبت الريح إلا هزني الطرب ، % إذ كان للقلب في مر الصبا أرب % 2(@)(@@) % لذاك إن هيمنت في الدوح أنشده : % بيني وبينك يا دوح الحمى نسب % 3(@)(@@) % يا جيرة الشعب ، لولا فرط بعدكم % لما غدا القلب بالأحزان ينتعب % 4(@)(@@) % فهل يجود بكم عدل الزمان لنا % % يوما ، وترفع فيما بيننا الحجب % 5(@)(@@) % يا سادة ما ألفنا بعدهم سكنا ، % ولا اتخذنا بديلا حين نغترب % 6(@)(@@) % بودكم صار موصولا بكم نسبي ؛ % إن المودة في أهل النهى نسب % 7(@)(@@) % جميلكم كان في رقي لكم سببا ، % لا يوجد الحكم حتى يوجد السبب % 8(@)(@@) % فكيف أنساكم بعد المشيب ، وقد % % صاحبتكم ، وجلابيب الصبا قشب % 9(@)(@@) % أم كيف أصبر مغترا بأمنية ، % والدار تبعد ، والآجال تقترب % 10(@)(@@) % قد زرتكم وعيون الخطب تلحظني % % شزرا ، وتعثر في آثاري النوب % PageV01P292 11(@)(@@) % وكم قصدت بلادا كي أمر بكم ، % وأنتم القصد لا مصر ولا حلب % 12(@)(@@) % وكم قطعت إليكم ظهر مقفرة ، % لا تسحب الذيل في أرجائها السحب % 13(@)(@@) % ومهمه كسماء الدجن معتكر ، % نواظر الأسد في ظلمائه شهب % 14(@)(@@) % حتى وصلت إلى نفس مؤيدة ، % منها النهى واللهى والمجد يكتسب % 15(@)(@@) % بمجلس لو رآه الليث قال به : % يا نفس في مثل هذا يلزم الأدب % 16(@)(@@) % منازل لو قصدناها بأرؤسنا ، % لكان ذاك علينا بعض ما يجب % 17(@)(@@) % ملك به افتحرت أيامه شرفا ، % واستبشرت بمعالي مجده الرتب % 18(@)(@@) % وقالت الشمس : حسبي أن فخرت به ، % وجهي له شبه ، واسمي له لقب % 19(@)(@@) % لا يعرف العفو إلا بعد مقدرة ، % ولا يرى العذر إلا بعدما يهب % 20(@)(@@) % سماحه عنونت بالبشر غايتها ، % كما 
ms87	 تعنون في غاياتها الكتب % PageV01P293 21(@)(@@) % وهمة حار فكر الواصفين لها ، % حتى تشابه منها الصدق والكذب % 22(@)(@@) % قالوا : هو البدر ؛ قلت : البدر ممحق % قالوا : هو الشمس ؛ قلت : الشمس تحتجب % 23(@)(@@) % قالوا : هو الغيث ؛ قلت : الغيث منتظر . % قالوا : هو الليث ؛ قلت : الليث يغتصب % 24(@)(@@) % قالوا : هو السيل ، قلت : السيل منقطع % قالوا : هو البحر ، قلت : البحر مضطرب % 25(@)(@@) % قالوا : هو الظل ؛ قلت : الظل منتقل . % قالوا : هو الدهر ؛ قلت : الدهر منقلب % 26(@)(@@) % قالوا : هو الطود ؛ قلت : الطود ذو خرس . % قالوا : هو الموت ؛ قلت : الموت يجتنب % 27(@)(@@) % قالوا : هو السيف ؛ قلت : السيف نندبه ، % وذاك من نفسه بالجود ينتدب % 28(@)(@@) % قالوا : فما منهم يحكيه ؛ قلت لهم : % كل حكاه ، ولكن فاته الشنب % 29(@)(@@) % يا ابن الذين غدت أيامهم عبرا % بين الأنام ، بها الأمثال قد ضربوا % % 30(@)(@@) % كالأسد إن غضبوا ، والموت إن طلبوا ، % والسيف إن ندبوا ، والسيل إن وهبوا % % PageV01P294 31(@)(@@) % إن حكموا عدلوا ، أو أملوا بذلوا ، % أو حوربوا قتلوا ، أو غولبوا غلبوا % % 32(@)(@@) % سريت مسراهم في كل منقبة ، % لم يسرها بعدهم عجم ولا عرب % 33(@)(@@) % وفقتهم بخلال قد خصصت بها ، % لولا الخصوص تساوى العود والحطب % 34(@)(@@) % حملت أثقال ملك لا يقام بها ، % لو حملتها الليالي مسها التعب % 35(@)(@@) % وحطت بالعدل أهل الأرض كلهم ، % كأنما الناس أبناء ، وأنت أب % 36(@)(@@) % لكل شيء ، إذا عللته ، سبب ، % وأنت للرزق في كل الورى سبب % 37(@)(@@) % مولاي ! دعوة عبد داره نزحت ، % عليكم قربه بل قلبه يجب % 38(@)(@@) % قد شاب شعري وشعري في مديحكم ، % ودونت بمعاني نظمي الكتب % 39(@)(@@) % فالناس تحسدكم فيه ، وتحسده % % فيكم ، وليس له في غيركم طلب % 40(@)(@@) % فلا أرتنا اللليالي منكم بدلا ؛ % ولا خلت منكم الأشعار والخطب % PageV01P295 البحر : كامل تام 1(@)(@@) % شكرتك عني شاردات قصائد % بصنائع فاهت بشكر صنائع % 2(@)(@@) % تنفي الحداة بها عن الجفن الكرى ، % وتخيط من طرب جفون السامع % PageV01P296 البحر : بسيط تام 1(@)(@@) % هنئت بالعيد بل هني بك العيد ، % فأنت للجود ، بل إرث لك الجود % 2(@)(@@) % يا من على الناس مقصور تفضله ، % وظل رحمته في الأرض ممدود % 3(@)(@@) % أضحت 
ms88	 بدولتك الأيام مشرقة ، % كأنها لخدود الدهر توريد % 4(@)(@@) % أعطيت في الملك ما لان الحديد له ، % حكما ، فأنت سليمان وداود % 5(@)(@@) % لك اليدان اللتان امتاح برهما % % بنو الزمان ، وريعت منهما الصيد % 6(@)(@@) % قضى وجودهما فينا وجودهما % % تكذيب من قال : إن الجود مفقود % 7(@)(@@) % ماذا أقول ، ومدحي فيك ذو قصر ، % وأنت بالفعل ممدوحق ومحمود % 8(@)(@@) % إذا نظمت بديع الشعر قابلني % % من السماح بديع منك منقود % 9(@)(@@) % فلا معانيه في الحسنى مغلغلة ، % ولا بألفاظ في البر تعقيد % 10(@)(@@) % فعشت يوليك طيب العيش أربعة : % عز ، ونصر ، وإقبال ، وتأييد % PageV01P297 11(@)(@@) % ولا خلت كل عام منك أربعة : % نسك ، وصوم ، وإفطار ، وتعييد % PageV01P298 البحر : مجزوء الرجز 1(@)(@@) % برق المشيب قد أضا ، % بعارض مثل الأضا % % 2(@)(@@) % يشبه اشتعاله ، % بالنار في جذل الغضا % % 3(@)(@@) % وواصلت قلبي الهموم ، % فحفا جفني الكرى % % 4(@)(@@) % واتخذ التسهيد عيني % % مألفا لما جفا % % 5(@)(@@) % وكنت ذا بأس ، فمذ % عاندني صرف القضا % % 6(@)(@@) % رضيت قسرا ، وعلى ال % % قسر رضى من كان ذا . . % 7(@)(@@) % لي أسوة بابن الزبير ، % إذ أبى حمل الأذى % % 8(@)(@@) % وابن الأشج القيل سا % % ق نفسه إلى الردى % % 9(@)(@@) % وهكذا جد أبو ال % % خير لإدراك المنى % % 10(@)(@@) % وقد سما قبلي يزيد % طالبا شأو العلى % % PageV01P299 11(@)(@@) % وقد رمى عمر و بسهم % كيده قلب العلى % % 13(@)(@@) % وسيف استعلت به % همته حتى رمى % % 14(@)(@@) % أقسمت لا أنفك أسمو % % طالبا حسن الثنا % % 15(@)(@@) % ألية باليعملات ، % ترتمي بها النجا % % 16(@)(@@) % لأجعلن معقلي ، % مطهما صلب المطا % % 17(@)(@@) % يرضخ في البيد الحصى ، % وإن رمى إلى الربى % % 18(@)(@@) % يكابر السمع اللحا % % ظ إثره ، إذا جرى % % 19(@)(@@) % إذا اجتهدت نظرا % في إثره ، قلت : سنا % % 20(@)(@@) % جاد به ابن الملك ال % % منصور منصور اللوا % % 21(@)(@@) % كأنما جودهما % % لي جانبا من الرجا % % PageV01P300 22(@)(@@) % فقلت ، لما أثقلا % % ظهري بأعباء الندى : % 23(@)(@@) % نفسي الفداء لأميري % ومن تحت السما % % 24(@)(@@) % كأنذما جودهما % % مجلجل من الحبا % % 25(@)(@@) % إذا ونت رعوده % عنت له ريح الصبا % % 26(@)(@@) % فطبق الأرضين حتى % % بلغ السيل الزبى % % 27(@)(@@) % كأنما البيداء ، غب % صوته ، بحر طما % % 28(@)(@@) % يلومني 
ms89	 في البعد % عن حماها خل لحى % % 29(@)(@@) % واللوم للحر مقيم % رادع ، والبعد لا % % 30(@)(@@) % فسوف يعتادهما % % مني امرؤ محض الولا % % 31(@)(@@) % يجوب جوزاء الفلا % % محتقرا هول الدجى % % PageV01P301 32(@)(@@) % قد نلت في ربعهما % % من النعيم ما كفى % % 33(@)(@@) % فإن أعش صاحبت ده % % ري عالما بما انطوى % % 34(@)(@@) % وإن أمت ، فكل شيء % بلغ الحد انتهى % % PageV01P302 البحر : طويل 1(@)(@@) % جزى الله عنا مالك الرق كاسمه ، % فلولا اسمه ما كنت في الخلق أعرف % 2(@)(@@) % ولولا معاليه الشريفة لم تكن % علي ملوك الأرض تحنو وتعطف % 3(@)(@@) % أحدثهم عن بره دون سره ، % وألحف في تعديد ما لي يتحف % 4(@)(@@) % وأنشد من مدحي له كل جزلة % تحلى بها أسماعهم وتشنف % 5(@)(@@) % قصائد في ألفاظهن مقاصد % من الصخر أقوى بل من الماء ألطف % 6(@)(@@) % إذا رام أهل العصر نظما لمثلها ، % وجاؤوا بلفظ دونها وتكلفوا % % 7(@)(@@) % ظننت حبال السحر ما قد أتوا به ، % وتلك عصا موسى لها تتلقف % PageV01P303 البحر : طويل 1(@)(@@) % هنيئا بشهر الصوم للملك الذي % % له نعم معروفها ليس ينكر % 2(@)(@@) % فم عن أحاديث المحارم صائم ، % وكف بإسداء المكارم مفطر % 3(@)(@@) % يسافر منه الذكر ، وهو متمم ، % وكل مقيم في الثناء مقصر % 4(@)(@@) % وأعجب من صوم الأنام بربعه ، % وقد غمرتهم من أياديه أبحر % PageV01P304 البحر : بسيط تام 1(@)(@@) % فطر به كاد قلب الدهر ينفطر ، % إذ بشرت بمعالي مجدك الفطر % 2(@)(@@) % يا مالكا أصحت الدنيا تتيه به ، % والصوم والفطر والأعياد تفتخر % 3(@)(@@) % أضحى وجودك في الدنيا وجودك لي % % عيدا جديدا به يستبشر البشر % 4(@)(@@) % فالعيد منتظر في العام واحدة ، % وجود كفك عيد ليس ينتظر % 5(@)(@@) % لو ينطق العيد بالإنصاف قال لنا : % ليهنكم بالمليك الصالح الظفر % 6(@)(@@) % ملك سما ذكره بين الملوك ، وما % % بنى له الذكر إلا الصارم الذكر % 7(@)(@@) % سهل الخلائق ما في خلقه شرس % للواردين ، ولا في خده صعر % 8(@)(@@) % لايعرف العذر عن إسعاف ذي أمل ، % يوما ، ولكنه يعطي ويعتذر % 9(@)(@@) % من آل أرتق الصيد الألى رتقوا % % فتق العلى ، بعدما حالت بها الغير % 10(@)(@@) % هم الملوك الألى يكسى الزمان بهم 
ms90	 % % عزا وتخفى ملوك الأرض إن ظهروا % % PageV01P305 11(@)(@@) % المنعمون ، ولكن قبلما سئلوا ، % والصافحون ، ولكن بعدما قدروا % % 12(@)(@@) % با ابن الملوك الألي دان الزمان لهم ، % لما استقاموا مع الباري كما أمروا % % 13(@)(@@) % لا فضل لي في نظامي در وصفكم ، % بقيمة الدر لا بالسلك يعتبر % 14(@)(@@) % لم تزه صنعته إلا بصنعكم ، % تزهو الحمائل أنى يهطل المطر % PageV01P306 البحر : خفيف تام 1(@)(@@) % يا مليكا بذكره يفخر المد % ح ويسمو الإيراد والوراد % 2(@)(@@) % أنت أعلى من أن تهنى بعيد % بل تهنى بمجدك الأعياد % 3(@)(@@) % فابق في نعمة بها سر راجيك ، % وردت بغيظها الحساد % 4(@)(@@) % صم في صومك العداة ، وفي % % فطرك منهم تفطر الأكباد % PageV01P307 البحر : متقارب تام 1(@)(@@) % تهن بعيدك يا ابن الكرام ، % وعش لتهانيه في كل عام % 2(@)(@@) % فإن يك غرة وجه الزمان ، % فإنك غرة وجه الأنام % PageV01P308 البحر : طويل 1(@)(@@) % قدمت ، وقد لاح الهلال مبشرا % بعودك ، إن السعد فيه قرينه % % 2(@)(@@) % ويخبر أن النصر فيه مقدر ، % ألم تره قد لاح في الغرب نونه % % PageV01P309 البحر : خفيف تام 1(@)(@@) % هكذا إن بنى المنازل بان ، % وثناها مشيدة الأركان % 2(@)(@@) % يبتني المجد أولا ، فإذا ما % % شاده شيد المنازل ثان % 3(@)(@@) % وبناء العلاء صعب على من % % لم يكن عزمه شديد المباني % % 4(@)(@@) % فإذا حاول المقصر نيل العز % نادى : وعزتي لن تراني % % 5(@)(@@) % كل من أسس البناء على تقوى % % إله السماء والرضوان % 6(@)(@@) % فليشد قبله البناء كما قد % % شيدته مناقب السلطان % 7(@)(@@) % زين أبناء ارتق الملك الصا % % لح شمس الدين الرفيع الشان % 8(@)(@@) % ملك يملأ النواظر بالحسن ، % ويملا الأكف بالإحسان % 9(@)(@@) % لو يشا اسس المنازل من فو % % ق أعالي منازل الزبرقان % 10(@)(@@) % والسواري فوق السواري من الشه % % ب ، وأبوابها على كيوان % PageV01P310 11(@)(@@) % شاد في ذروة العلاء ديارا ، % وجنى الجنتين منهن داني % % 12(@)(@@) % فأراه الإله في ظلها العز ، % وطيب الهنا ، ونيل الأماني % % PageV01P311 البحر : خفيف تام 1(@)(@@) % إن ثنت عنكم الخطوب عناني ، % ففؤادي لديكم وجناني % % 2(@)(@@) % واشتياقي لربعكم لا بوجدي % % بغوان به ، ولا بأغاني % % 3(@)(@@) % ما هوينا مغنى الديار ، ولكن % بالمعاني نهيم لا بالمغاني 
ms91	 % % 4(@)(@@) % من معين الصب الكئيب على الشو % % ق إذا بات للهموم يعاني % % 5(@)(@@) % ومن المبلغ الأحبة أني % % طيب عيشي من بعدهم ما هناني % % 6(@)(@@) % يا نسيم الشمال إن جزت بالشهبا % % ء قبل عني ثرى السلطان % 7(@)(@@) % وابلغ الملك ناصر الدين شوقي % % ثم قبل ثراه بالأجفان % 8(@)(@@) % عمر المالك الذي عمر المجد ، % وقد كان داثر البنيان % 9(@)(@@) % والمليك الذي يرى المن إشرا % % كا بوصف المهيمن المنان % 10(@)(@@) % والجواد السمح الذي مرج ال % % بحرين من راحتيه يلتقيان % PageV01P312 11(@)(@@) % ملك يعتق العبيد من الرق ، % ويشري الأحرار بالإحسان % 12(@)(@@) % بسجايا رضعن در المعالي ، % ومزايا رضعن در المعاني % % 13(@)(@@) % فلباغ عصاه حمر المنايا ، % ولباغي عطاه بيض الأماني % % 14(@)(@@) % يا أخا الجود ليس مثلك موجو % % دا ، وإن كان باديا للعيان % 15(@)(@@) % أنت بين الأنام لفظه إجما % % ع ، عليها اتفاق قاص ودان % 16(@)(@@) % ذلك الرتبة التي قصرت دو % % ن علاها النسران والفرقدان % 17(@)(@@) % والحسام الذي إذا صلت البيض % وصلت في البيض والأبدان % 18(@)(@@) % قام في حومة الهياج خطيبا ، % قائلا : كل من عليها فان % 19(@)(@@) % واليراع الذي يزيد بقطع الرا % % س نطقا من بعد شق اللسان % 20(@)(@@) % لم تمس التراب نعلاك ، إلا % حسدته معاقد التيجان % PageV01P313 21(@)(@@) % شيم لم تكن لغيرك إلا % لمعالي شقيقك السلطان % 22(@)(@@) % جمع الله فيكما الحسن والإحسا % % ن ، إذ كنتما رضيعي لبان % 23(@)(@@) % وتجاريتما إلى حلبة المجد ، % فوافيتما كمهري رهان % 24(@)(@@) % ثم عاضدته ، فكنت لديه % مثل هارون في فتى عمران % 25(@)(@@) % فتهن العيد السعيد ، وإن كا % % ن لكل الأعياد منك التهاني % % 26(@)(@@) % واقض عمر الزمان صوما وفطرا ، % خالدا في مسرة وأمان % 27(@)(@@) % ليس لي في صفات مجدك فخر ، % هي أبدت لنا بديع المعاني % % 28(@)(@@) % كلما أبدعت سجاياك معنى % نظمت فكرتي وخط بناني % % 29(@)(@@) % لا تسمني بالشعر شكر أياديك ، % فما لي بشكرهن يدان % 30(@)(@@) % لو نظمت النجوم شعرا لما كا % % فيت عن بعض ذلك الإحسان % % PageV01P314 البحر : منسرح 1(@)(@@) % لا راجع الطرف باللقا وسنه ، % إن ذاق غمضا من بعدكم وسنه % 2(@)(@@) % طال على الصب عمر جفوتكم ، % فكل 
ms92	 يوم من الفراق سنه % 3(@)(@@) % صب أجبا الغرام ، حين دعا % % طوعا ، وألقى إلى الهوى رسنه % 4(@)(@@) % لم يقض من وصلكم لبانته ، % وإن قضى في هواكم زمنه % 5(@)(@@) % ما عرف الشرك في هواه ، ولا % % خالف دين الهوى ولا سننه % 6(@)(@@) % ولو غدا ، وهو عابد وثنا ، % لما غدا غير شخصكم وثنه % 7(@)(@@) % ما لامه لائم ليحزنه ، % إلا وسلى بذكركم حزنه % 8(@)(@@) % لولاكم لم تبت جونحه % حرى ، ولا أنحل الضنى بدنه % 9(@)(@@) % كم ضمن الدمع ري غلته ، % فما وفى بعدكم بما ضمنه % 10(@)(@@) % لا تودعوا سركم نواظره ، % فهي على السر غير مؤتمنه % PageV01P315 11(@)(@@) % نواظر بالدموع وافية ، % وهي لإظهار سركم خونه % 12(@)(@@) % ورب لفظ فصلت مجمله ، % والليل قد فصل الضحى كفنه % 13(@)(@@) % ساءت ظنون الحساد في به ، % لما غدا الجفن جافيا وسنه % 14(@)(@@) % لم يبسطوا العذر لي ، ولا علموا % % أن يدي بالصنيع مرتهنه % 15(@)(@@) % ولو بمدح المؤيد اعتبروا % % لبدلت سيئاتهم حسنه % 16(@)(@@) % الملك الجامع الفضائل والبا % % ذل في الصالحات ما خزنه % 17(@)(@@) % يمتن للقابلي عطاه ، ولا % % يقلد الوفد في الندى مننه % 18(@)(@@) % ملك لو أن البحار تشبهه ، % لأصبح البحر باذلا سفنه % 19(@)(@@) % ولو أتى الأصمعي ينشده % شعرا لأصبح من خوف به لحنه % 20(@)(@@) % ولو رعى ألكن عبارته ، % أزال من سحر لفظه لكنه % PageV01P316 21(@)(@@) % مهذب اللفظ في الفصاحة لا % % كسائل المازني من ختنه % 22(@)(@@) % من آل أيوب الذين لهم % حماسة بالسماح مقترنه % 23(@)(@@) % ذوي بيوت في المجد سالمة ، % كل أفاعيلهن متزنه % 24(@)(@@) % هم اشتروا الملك غالبا خطرا ، % وصيروا أنفس العدى ثمنه % 25(@)(@@) % طورا سلاح الملك العقيم ترى % % تلك المساعي ، وتارة جننه % 26(@)(@@) % يا مالكا دانت الملوك له ، % واتبعت في اعتمادها سننه % 27(@)(@@) % ومن سنا بشره ، ونائله % رفه سعي الحجاب والخزنه % 28(@)(@@) % والصادق الوعد في الكتاب ومن % % فداه ذو العرش بعدما امتحنه % 29(@)(@@) % أوسعت للعبد من هباتك ما % % أضاق عن حمل بعضه عطنه % 30(@)(@@) % أتعبت بالشكر جهد مهجته ، % كأنها بالنعيم ممتحنه % PageV01P317 31(@)(@@) % آنسه فضلكم ، فما طلبت % مسكنه نفسه ، ولا سكنه % 32(@)(@@) % أسلاه عن أله صنيعكم % به 
ms93	 ، وأنساه ظلكم وطنه % 33(@)(@@) % يعلن بالمدح والثناء ، وقد % % أشبه في الود سره علنه % 34(@)(@@) % ما ساءه غير فوت مدته ، % وما قضى تحت ظلكم زمنه % 35(@)(@@) % فلا أرتنا الأيام فيك ردى ، % ولا أماطت عن حاسد حزنه % 36(@)(@@) % وعمر الله حاسديك لكي % تعيش في الذل عيشة خشنه % PageV01P318 البحر : موشح 1(@)(@@) % زار ، وصبغ الظلام قد نصلا ، % بدر جلا الشمس في الظلام ألا % % 2(@)(@@) % جاء ، وسجف الظلام % قد فتقا فاعجب % % 3(@)(@@) % والصبح لم يبق ، % في الدجى رمقا % % 4(@)(@@) % وقد جلا نور وجهه % % الغسقا % % 5(@)(@@) % وأدهم الليل منه قد جفلا ، % وقد أتى رائد الصباح على % % 6(@)(@@) % أفديه بدرا في % % قالب البشر أشهب % % 7(@)(@@) % قد جاء في حسنه % % على قدر % 8(@)(@@) % يرتع في روض % خده نظري % % 9(@)(@@) % خد بلطف النعيم قد صقلا ، % كأنه من دمي إذا خجلا % % 10(@)(@@) % يا من غدا ظل % حسنه حرما يخضب % % PageV01P319 11(@)(@@) % لما حوى ما به % الجمال حمى % % 12(@)(@@) % فرعا وصدغا إن % % حكما ظلما % % 13(@)(@@) % فارقم الجعد تحرس الكفلا ، % وحارس الخد منه قد جعلا % % 14(@)(@@) % هلا تعلمت بذل % ودك لي عقرب % % 15(@)(@@) % من المليك المؤيد % ابن علي % % 16(@)(@@) % سلطان عصر مسمى % % على الأول % 17(@)(@@) % لولا أياد بها الورى شملا % % لأصبح الناس كالسماء بلا % % 18(@)(@@) % ملك ، معانيه % % للورى حرم كوكب % % 19(@)(@@) % إلى معاليه % % ينتهي الكرم % 20(@)(@@) % قد أغرق الناس % سيله العرم % PageV01P320 21(@)(@@) % سحاب جود على الورى هطلا ، % لابرقه مبطىء النوال ولا % % 22(@)(@@) % حماة أصبحت % للأنام حمى خلب % % 23(@)(@@) % حويت ملكا على % % الملوك سما % % 24(@)(@@) % بحرا غدا بالعلوم % ملتطما % % 25(@)(@@) % ملك لرزق الأنام قد كفلا ، % فصار في الناس جوده مثلا % % 26(@)(@@) % يا من عطاه قبل % السؤال بدا % % 27(@)(@@) % ومن حبانا قبل % الندا بندى % % 28(@)(@@) % هيهات ينسى % % صنيعكم أبدا % % 29(@)(@@) % عبد على فرط حبكم جبلا ، % عليكم إن قام أو رحلا % % PageV01P321 البحر : موشح 1(@)(@@) % بروحي جوذر في القلب كانس ، % تراه نافرا في زي آنس % % 2(@)(@@) % وأحوى أحور % الأحداق ألمى % % 3(@)(@@) % تكاد خدوده % بالوهم تدمى % % 4(@)(@@) % كأن الحسن % لما منه تما % % 5(@)(@@) % وآثر أن ذاك % الروض يحمى 
ms94	 % % 6(@)(@@) % غدا للورد في خديه غارس ، % وظل له بسيف اللحظ حارس % % 7(@)(@@) % جلا في كفه % كأس الحمي % 8(@)(@@) % فقابل نورها % % بدر المحيا % % 9(@)(@@) % وطاف بكأسه % فينا وحيا % % 10(@)(@@) % فغادر ميت % العشاق حيا % % PageV01P322 11(@)(@@) % بوجه إن تبدى في الحنادس ، % غدا للنيرات الخمس سادس % % 12(@)(@@) % جلا كأسي ، فقلت % إليك عني % % 13(@)(@@) % فقد ضيعت % عمري بالتمني % % 14(@)(@@) % فقال مع الخلاعة : % إي ، وإني % % 15(@)(@@) % فقلت : فطف إذا % وامزج وغن % 16(@)(@@) % بشعري فهو حضرات المجالس ، % وفاكهة المفاكه والمجالس % % 17(@)(@@) % أما قال الذي % % في الحسن زيد % % 18(@)(@@) % ومن وجد الندى % % قيدا تقيد % % 19(@)(@@) % فها أنا في حمى % % الملك المؤيد % % 20(@)(@@) % منيع العز ذي % % مجد مشيد % % PageV01P323 21(@)(@@) % عماد الدين مغني كل بائس ، % ومن تغدو الأسود له فرائس % % 22(@)(@@) % أيا ملكا حماني % % من زماني % % 23(@)(@@) % وأعطاني أماني % % والأماني % 24(@)(@@) % خفضت برفع % شأني كل شاني % % 25(@)(@@) % وشيدت المعالي % % والمعاني % % 26(@)(@@) % ولولا أنت يا مردي الفوارس ، % لأضحى العلم بين الناس دارس % % 27(@)(@@) % تجرا من لجودك % رام حدا % % 28(@)(@@) % ومن بالغيث % قاسك قد تعدى % % 29(@)(@@) % وكيف تقاس % بالأنواء حدا % % 30(@)(@@) % وكفك للورى % % أدنى وأندى % % PageV01P324 31(@)(@@) % لأن الغيث يسأل ، وهو حابس ، % وليس يجود إلا وهو عابس % % 32(@)(@@) % جعلت البيض % دامية المآقي % % 33(@)(@@) % وسمر الخط ترقى % % في التراقي % % 34(@)(@@) % مساع للعلى % % أضحت مراقي % % 35(@)(@@) % وتلك الصالحات % هي البواقي % % 36(@)(@@) % فترجل فارس الحرب الممارس ، % وتجعل راجل الإملاق فارس % % 37(@)(@@) % حمدت إليك % % ترحالي وحالي % % 38(@)(@@) % وزاد لديك إقبالي % % وبالي % 39(@)(@@) % وقد ضاعفت آمالي % % ومالي % 40(@)(@@) % فلست أطيل % عن آلي سؤالي % % PageV01P325 41(@)(@@) % أفضت علي للنعمى ملابس ، % فصار لدي رطبا كل يابس % % 42(@)(@@) % أأزعم أني % % بالمدح جازي % % 43(@)(@@) % وهل تجزى % % الحقيقة بالمجاز % 44(@)(@@) % ولكن في ارتجالي % % وارتجازي % 45(@)(@@) % غذا قصرت فالله % المجازي % % 46(@)(@@) % فلو نظمت من مدحي نفائس ، % فإني من قضاء الحق آئس % % PageV01P326 البحر : - 1(@)(@@) % إن قصر لفظي فإن طولك قد طال ، % ما من فعل البر والجميل كمن قال % 2(@)(@@) % أو خفف نهضي جميل صنيعك عندي ، % قد حمل ظهري لفرط منك أثقال % 3(@)(@@) % يا من جعل البر 
ms95	 للعفاة قيودا ، % قد زدت من المن عنق عبدك أغلال % 4(@)(@@) % أظهرت علينا من السماح سمات ، % إن قصر نطقي بوصفها نطق الحال % 5(@)(@@) % شيدت بيوت العلى ، وكن طلولا ، % بالجود فأمست بيوت مالك أطلال % 6(@)(@@) % ما أنصف من قاس راحتيك بسحب ، % من أين لكفيك في السحائب أشكال % 7(@)(@@) % السحب ، إذا ما سخت تجود وتبكي % % بالماء ، وتسخو وأنت تضحك بالمال % 8(@)(@@) % يا من جعل العالم الفصيح بليدا ، % بالبحث كما صير الفلاسف جهال % 9(@)(@@) % لا تعجب إن أخطأوا لديك بوزن % في النظم ، فللشعر كالمعارك أبطال % 10(@)(@@) % لو لم يكن الشعر للمحاول صعبا ، % ما أصبح من دونه البيوت بأقفال % PageV01P327 البحر : وافر تام 1(@)(@@) % جزاك الله عن حسناك خيرا ، % وكان لك المهيمن خير راع % 2(@)(@@) % فقد قصرت بالإحسان لفظي ، % كما طولت بالإنعام باعي % % 3(@)(@@) % فأخرني الحياء ، وليس يدري ، % جميع الناس ما سبب امتناعي % % 4(@)(@@) % فشكري حسن صنعك في اتصال ، % وخطوي نحو ربعك في انقطاع % 5(@)(@@) % وقافية شبيه الشمس حسنا ، % تردد بين كفي واليراع % 6(@)(@@) % لها فضل على غرر القوافي ، % كما فضل البقاع على البقاع % 7(@)(@@) % غدت تثني على علياك لما % % ضمنت لربها نجح المساعي % % 8(@)(@@) % قدمت ، ولا برحت مدى الليالي % % سعيد الجد ذا أمر مطاع % PageV01P328 البحر : سريع 1(@)(@@) % عانده في الحب أعوانه ، % وخانه في الرد إخوانه % % 2(@)(@@) % متيم ، ليس لهث ناصر ، % أول من عاداه سلوانه % % 3(@)(@@) % يكتم ما كابده قلبه ، % ويعجز الأعين كتمانه % % 4(@)(@@) % ما شانه إلا مقال العدى ، % وقد همت عيناه ، ماشانه % % 5(@)(@@) % كلف إخفاء الهوى قلبه ، % فعز من ذلك إمكانه % % 6(@)(@@) % أمانة يشفق من حملها % % لفرط ذاك الثقل إنسانه % % 7(@)(@@) % من لمحب قلبه هائم % يحن ، والأحباب جيرانه % % 8(@)(@@) % ما شام برق الشام إلا همت % بوابل الأدمع أجفانه % % 9(@)(@@) % سقى حمى وادي حماة الحيا ، % وصيب الودق وهتانه % % 10(@)(@@) % وحبذا العاصي ، ويا حبذا % % دهشته الغرا وميدانه % % PageV01P329 11(@)(@@) % واد إذا مر نسيم به % تعطرت بالمسك أردانه % % 12(@)(@@) % تستأسر الأبطال آرامه ، % وتقنص الأساد غزلانه % % 13(@)(@@) % كم فيه من ظبي هضيم الحشا ، % إذا انثنى يحسده بانه % % 14(@)(@@) % تشابهت عند 
ms96	 مرور الصبا % % قدود أهليه وأغصانه % % 15(@)(@@) % كم ليلة قضيت في مرجه ، % وقد طمت بالماء غدرانه % % 16(@)(@@) % والأفق حال بنجوم الدجى ، % قد كللت بالدر تيجانه % % 17(@)(@@) % كأنما الجوزاء فيه ، وقد % % حف بها البدر وكيوانه % % 18(@)(@@) % بيت بني أيوب ، إذ شيدت % بالملك الناصر أركانه % % 19(@)(@@) % بيت أثيل ، بحره وافر ، % قد سلمت في المجد أوزانه % % 20(@)(@@) % لا غرو إن أمسى مشيدا ، وقد % % أسس بالمعروف بنيانه % % PageV01P330 21(@)(@@) % شيده الناصر من بعد ما % % قد كاد أن ينزغ شيطانه % % 22(@)(@@) % ملك كأن الدهر عبد له ، % وسائر الأيام أعوانه % % 23(@)(@@) % وفى لهم في قوله ، والوفا % % قد بليت في اللحد أكفانه % % 24(@)(@@) % لا زال يحيي بنداه الورى ، % ويغرق العالم طوفانه % % 25(@)(@@) % يا أيها الملك الذي سره % % طاعة ذي الأمر وإعلانه % % 26(@)(@@) % تهن بالملك الذي لم تكن % تلقى إلى غيرك أرسانه % % 27(@)(@@) % طلائع الإقبال جاءت ، وذا % % مقتبل العمر وريعانه % % 28(@)(@@) % هذا كتاب ناطق بالعلى ، % وهذه الرتبة عنوانه % % 29(@)(@@) % فافخر ، فما فخرك بدعا ، وقد % % قام لأهل العصر برهانه % % 30(@)(@@) % يفخر ذو الملك ، إذا ما بدا % % له من السلطان إحسانه % % PageV01P331 31(@)(@@) % فكيف من والده قد قضى ، % فأصبح الوالد سلطانه % % 32(@)(@@) % زكاكم قربان إيمانكم % % به ، وزكى الغير إيمانه % % 33(@)(@@) % من يك إسماعيل اصلا له % % لا بدع أن يقبل قربانه % % 34(@)(@@) % أب به ترفع عن مجدكم % % قواعد البيت وأركانه % % 35(@)(@@) % ابلج لا يخسر من أمه % يوما ، ولا يخسر ميزانه % % 36(@)(@@) % تكاد أن تعشو إلى ضيفه % % لفرط ما تهواه نيرانه % % 37(@)(@@) % إن ذكر العلم ، فنعمانه ، % أو ذكر الحكم فلقمانه % % 38(@)(@@) % أحزننا فقدانه ، فانجلت % بالملك الأفضل أحزانه % % 39(@)(@@) % سلام ذي العرش على نفسه ، % ورحمة الله ورضوانه % % PageV01P332 البحر : - 1(@)(@@) % أقطرات أدمعي لا تجمدي ، % ويا شواظ أضلعي لا تخمدي % % 2(@)(@@) % ويا عيوني الساهرات بعدهم ، % إن لم يعدك طيفهم لا ترقدي % % 3(@)(@@) % ويا سيوف لحظ من أحببته % % جهدك عن سفك دمي لا تغمدي % % 4(@)(@@) % ويا غوادي عبرتي تحدري ، % ويا بوادي زفرتي تصعدي % % 5(@)(@@) % فقد أذلت أدمعي ، ولم أقل % % إن يحم عن عيني البكا تجلدي % % 6(@)(@@) % أنا الذي ملكت 
ms97	 سلطان الهوى % % رقي ، وأعطيت الغرام مقودي % % 7(@)(@@) % ما إن أزال هائما بغادة % تسبي العقول ، أو غزال أغيد % 8(@)(@@) % فهو الذي قد نام عني لاهيا ، % لما رماني بالمقيم المقعد % 9(@)(@@) % مولد الترك ، وكم من كمد % مولد من ذلك المولد % 10(@)(@@) % معتدل القد عليه كمة ، % فهو بها كالألف المشدد % PageV01P333 11(@)(@@) % قال المجوس إن نور نارهم % % لو لم تشابه خده لم تعبد % 12(@)(@@) % يريك من عارضه وفرقه % % ضدين قد زادا غليل جسدي % % 13(@)(@@) % فذاك خط أسود في أبيض ؛ % وذاك خط أبيض في أسود % 14(@)(@@) % لله أياما مضت في قربه ، % والدهر منه بالوصال مسعدي % % 15(@)(@@) % ونحن في وادي حماة في حمى % % به حللنا فوق فرق الفرقد % 16(@)(@@) % فحبذا العاصي وطيب شعبه ، % ومائه المسلسل المجعد % 17(@)(@@) % والفلك فوق لجه كأنها % % عقارب تدب فوق مبرد % 18(@)(@@) % وناجم الأزهار من منظم % على شواطيه ، ومن منضد % 19(@)(@@) % من زهر مفتح ، أو غصن % مرنح ، أو طائر مغرد % 20(@)(@@) % والورق من فوق الغصون قد حكت % بشدوها المطرب صوت معبد % PageV01P334 21(@)(@@) % كأنما تنشر فضل الملك ال % % أفضل نجل الملك المؤيد % 22(@)(@@) % أروع محسود العلاء أمجد ، % من نسل محسود العلاء أمجد % 23(@)(@@) % المؤمن الموحد ابن المؤمن ال % % موحد ابن المؤمن الموحد % 24(@)(@@) % السيد ابن السيد ابن السيد % ابن السيد ابن السيد ابن السيد % 25(@)(@@) % من آل أيوب الذين أصبحوا % % كواكبا بها الأنام تهتدي % % 26(@)(@@) % من كل خفاق اللواء لابس % ثوب الفخار مطرزا بالسؤدد % 27(@)(@@) % مهذب محبب مجرب ، % للمجتني والمجتلي والمجتدي % % 28(@)(@@) % فقوله وطوله وحوله % % للمعتني والمعتفي والمعتدي % % 29(@)(@@) % ما إن يشين منه بمنة ، % ولا يشوب بره بموعد % 30(@)(@@) % سماحة تخفض قدر حاتم % في أدب يهزأ بالمبرد % PageV01P335 31(@)(@@) % نامت عيون الناس أمنا عندما % % رعاهم بطرفه المسهد % 32(@)(@@) % صوت الصهيل والصليل عنده % أطيب من شدو الحسان الخرد % 33(@)(@@) % يلهيه صدر النهد في يوم الوغى % % بالكر عن صدر الحسان النهد % 34(@)(@@) % ويغتني بالملد من سمر القنا % % عن كل مجدول القوام أملد % 35(@)(@@) % خلائق تعدي النسيم رقة ، % وسطوة تذيب قلب الجلمد % 36(@)(@@) % وبأس ملك مجده من 
ms98	 عامر ، % وفيض جود كفه من أجود % 37(@)(@@) % ورب يوم أصبح الجو به % % محتجبا من العجاج الأركد % 38(@)(@@) % كأن عين الشمس في قتامه % قد كحلت من نقعه بإثمد % 39(@)(@@) % شكا به الرمح إليه وحشة ، % فاسكن الثعلب قلب الأسد % 40(@)(@@) % حتى إذا ما كبرت كماته ، % والهام بين ركع وسجد % PageV01P336 41(@)(@@) % أفردت الرماح كل تؤام ، % وثنت الصفاح كل مفرد % 42(@)(@@) % يا ابن الذي سن السماح للورى % % فأصبحت به الكرام تقتدي % % 43(@)(@@) % الصادق الوعد كما جاء به % نص الكتاب والصحيح المسند % 44(@)(@@) % من أصبحت أوصافه من بعده % % في الأرض تتلى بلسان الحسد % 45(@)(@@) % ما مات من وارى التراب شخصه % % وذكره يبقى بقاء الأبد % 46(@)(@@) % حتى إذا خاف الأنام بعده % تعلق الملك بغير مرشد % 47(@)(@@) % فوض أمر الملك من محمد % الناصر الملك إلى محمد % 48(@)(@@) % الأفضل الملك الذي أحيا الورى % % فأشبه الوالد فضل الولد % 49(@)(@@) % العادل الحكم الذي أكفه % ليست على غير النضار تعتدي % % 50(@)(@@) % لو زين عصر آل عباد به ، % لم يصل الملك إلى المعتضد % PageV01P337 51(@)(@@) % يا من حباني من جميل رأيه % ببشره والبر والتودد % 52(@)(@@) % طوقتني بالجود ، إذ رأيتني % % بالمدح مثل الطائر المغرد % 53(@)(@@) % أبعدتموني بالنوال ، فاغتدى % % شوقي مقيمي ، والحياء مقعدي % % 54(@)(@@) % لولا حيائي من نوالي بركم ، % ما قل نحو ربعكم ترددي % % 55(@)(@@) % فاعذر محبا طال عنكم بعده ، % ووده ومدحه لم يبعد % 56(@)(@@) % فكم حقوق لكم سوابق ، % ومنة سالفة لم تجحد % 57(@)(@@) % تنشط رب العجز ، إلا أنها % % تعجز بالشكر لساني ويدي % % PageV01P338 البحر : متقارب تام 1(@)(@@) % سوى حسن وجهك لم يحل لي ، % وغيرك في القلب لم يحلل % 2(@)(@@) % فكيف سلوي ولي طينة % على غير حبك لم تجبل % 3(@)(@@) % أتزعم أني أطيع الوشاة ، % وأصغي إلى عذل العذل % 4(@)(@@) % لقد نصل الدهر صبغ الشباب ، % وصبغ المحبة لم ينصل % 5(@)(@@) % عجبت لقدك مع لينه % يرينا اعتدالاص ، ولم يعدل % 6(@)(@@) % يلينث ، وفي فتكه قسوة ، % وذلك شأن القنا الذبل % 7(@)(@@) % وعيناك قد فوقت أسهما ، % فمن دلهن على مقتلي % % 8(@)(@@) % وخدك موقدة ناره ، % وقلبي بجذوتها يصطلي % % 9(@)(@@) % أيا ماطلا لوعود 
ms99	 الوصال ، % ووعد تجافيه لم يمطل % 10(@)(@@) % بخلت ، وقد حزت ملك الجمال ، % ومن ملك الملك لم يبخل % PageV01P339 11(@)(@@) % فهلا تعلمت فضل السماح % من راحة الملك الأفضل % 12(@)(@@) % مليك ، إذا هطلت كفه ، % تصاغر قدر الحيا المسبل % 13(@)(@@) % يشيد العلى باليراع القصير ، % ويفخر بالطرف الأطول % 14(@)(@@) % به أصبح الملك في معقل % وفي السلم ذا الخلق الأسهل % 15(@)(@@) % أخف إلى الحرب من ذابل ، % وأثقل في الحلم من يذبل % 16(@)(@@) % يضيء لنا في ظلام الخطوب % % ويشرق في حندس القسطل % 17(@)(@@) % فسيل عطاياه للمجتدي ، % ونور محياه لملجتلي % % 18(@)(@@) % يرمل بالدم شلو الكمي ، % ويحنو على البائس المرمل % 19(@)(@@) % مناقب معروفها تالد ، % محمد أورثها من علي % % 20(@)(@@) % إلى آل أيوب يعزى الفخار ، % في كل ماض ومستقبل % PageV01P340 21(@)(@@) % ملوك لهم شرف آخر ، % يخبر عن شرف أول % 22(@)(@@) % ينم بهم جودهم مثلما % % تنم الرياح على المندل % 23(@)(@@) % حباك المؤيد تأييده ، % كذا همة الليث في الأشبل % 24(@)(@@) % ولولا وجودك كان السماح % تحت الصفائح والجندل % 25(@)(@@) % فقلبي بإحسانكم فارغ ، % وكفي بإنعامكم ممتلي % % 26(@)(@@) % سمحت ابتداء ، ولم أمتدح ، % وأنعمت عفوا ، ولم أسأل % 27(@)(@@) % وواليت برك حتى رحلت % حياء ، ولولاه لم أرحل % 28(@)(@@) % ولو شئت نهضي إلى قصدكم ، % لخففت عن ظهري المثقل % 29(@)(@@) % فأهملت واجب سعيي إليك ، % وما كنت عندك بالمهمل % 30(@)(@@) % وكفرت عن زلة الانقطاع % بأحسن من كان في منزلي % % PageV01P341 31(@)(@@) % فأرسلته راجيا أنه % يمحص عن زلة المرسل % 32(@)(@@) % فإن لاحظته عيون الرضى % % لك الفضل في ذاك والفخر لي % % 33(@)(@@) % وإن لم يكن غاية في الجمال ، % وبدر معانيه لم يكمل % 35(@)(@@) % فإن له غاية في الذكاء % % ولطف البديهة والمقول % 36(@)(@@) % وبكر خدمت بها عاجلا ، % وسيف القريحة لم يصقل % 37(@)(@@) % أروم إقامة عذري بها ، % وأثني على فضلك الأكمل % 38(@)(@@) % ومثلك من قبل الاعتذار ، % وصدق قول المحب الولي % % 39(@)(@@) % فواضعف حظي وفوت المنى ، % إذا كان عذري لم يقبل % PageV01P342 البحر : رجز تام 1(@)(@@) % قم بي فقد ساعدنا صرف القدر ، % وجاء طيب عيشنا على قدر % 2(@)(@@) % فكم علا قدر امرىء ، وما قدر ، % فارضع بنا در الهنا إن 
ms100	 تلق در % 3(@)(@@) % فالشهم من حاز السرور إن قدر % % 4(@)(@@) % وقد صفا الزمان والأمان ، % وأسعد المكان والإمكان % 5(@)(@@) % وأنجد الإخوان والأعوان ، % وقد وفت بعهدها الأزمان % 6(@)(@@) % والدهر تاب من خطاه واعتذر % % 7(@)(@@) % يا سعد ، فاترك ذكر بان لعلع % وعيشة ولت بوادي الأجرع % 8(@)(@@) % وإن تكن تسمع قولي وتعي ، % فاجل صدا قلبي ، وأطرب مسمعي % % 9(@)(@@) % برشقة الأوتار لا جس الوتر % % 10(@)(@@) % ودع طوالا عرفت بوسمها ، % وأربعا لم يبق غير رسمها % % PageV01P343 11(@)(@@) % واجعل سرور النفس أسنى قسمها ، % وادخل بنا في بحث إن واسمها % % 12(@)(@@) % وخلني من ذكر كان والخبر % % 13(@)(@@) % أما ترى الأطيار في تشرين ، % مقبلة بادية الحنين % 14(@)(@@) % فريقها ناب عن الأنين ، % إذا رنت نحو المياه الجون % 15(@)(@@) % يأمرها الشوق وينهاها الحذر % % 16(@)(@@) % هذي الكراكي حائمات في الضحى % % منظومة أو دائرات كالرحى % % 17(@)(@@) % إذا رأت في القيض ماء طفحا % % تفرق في حال الورود مرحا % % 18(@)(@@) % وما درت أن المنايا في الصدر % % 19(@)(@@) % يا حسنها قادمة في وقتها ، % تغري الرماة بجميل نعتها % % 20(@)(@@) % إذا استوت طائرة في سمتها ، % ترشقها ببندق من تحتها % % PageV01P344 21(@)(@@) % لو أنه من فوقها قيل مطر % فلو ترانا بين إخوان الصفا ، % 22(@)(@@) % حول قديم من قذاه قد صفا % % 23(@)(@@) % مشتهر بالصدق مخبور الوفا ، % لم يغض في الحق لخل إن هفا % % 24(@)(@@) % ولم يقل يوما هبوا لي ما شجر % % 25(@)(@@) % من كل رام شبق اليدين ، % بمدمج مثل الهلال زين % 26(@)(@@) % جعد البلاغ نافر الكعبين ، % لو كف حتى ملتقى القرصين % 27(@)(@@) % ما انتقض الشاخ ، ولا العود انكسر % % 28(@)(@@) % فابرز بنا نحو مرامي فاميه ، % بين مروج ومياه طاميه % % 29(@)(@@) % تلك المرامي لم تزل مراميه ، % فاسم بنا نحو رباها الساميه % % 30(@)(@@) % وخلني من بلدة فيها زور % % PageV01P345 31(@)(@@) % وانظر إلى الأطيار في مطارها ، % واعتبر الجفة كاعتبارها % % 32(@)(@@) % إذ لا تطير مع سوى أنظارها ، % فلا تضع نفسك عن مقدارها % % 33(@)(@@) % مع غير ذي الجنس وكن على حذر % % 34(@)(@@) % أو مل إلى العمق بعزم ثاقب ، % فإنها من أحسن المناقب % 35(@)(@@) % فاعجب لما فيه من الغرائب ، % من 