ms132	 عن هشام بن عروة(@)(@@) له حديث واحد وهو منكر(@)(@@)(@@)(@@) | 2552 - (@)(@@) د ق(@)(@@) سلمى بن عبد الله أبو بكر الهذلي(@)(@@) عن الحسن تركوا حديثه(@)(@@)(@@)(@@) | 2553 - (@)(@@) سلمان بن فروخ أبو واصل عن أبي أيوب الأنصاري(@)(@@) لا يعرف وخبره منكر(@)(@@)(@@)(@@) | 2554 - (@)(@@) سليط عن بهية(@)(@@) لا يعرف(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2555 - (@)(@@) سليمان بن أحمد الواسطي(@)(@@) محدث مشهور سمع الوليد بن مسلم ضعفوه(@)(@@)(@@)(@@) | 2556 - (@)(@@) سليمان بن أحمد الملطي ثم المصري(@)(@@) متأخر روى عنه ابن الثلاج لا يوثق به وكذبه الدارقطني(@)(@@)(@@)(@@) | 2557 - (@)(@@) سليمان بن احمد الطبراني الحافظ(@)(@@) ثقة لينه ابن مردويه وحده(@)(@@)(@@)(@@) | 2558 - (@)(@@) سليمان بن احمد السرقسطي(@)(@@) يروي عن أبي العلاء الواسطي كذاب(@)(@@)(@@)(@@) | 2559 - (@)(@@) سليمان بن إبراهيم الأصبهاني الحافظ(@)(@@) مقبول ضعفه يحيى ابن منده الحافظ(@)(@@)(@@)(@@) | 2560 - (@)(@@) د ت س(@)(@@) سليمان بن أرقم أبو معاذ البصري عن الحسن(@)(@@) واهي الحديث ضعفه أبو حاتم وغيره قال يحيى لا شيء وقال خ تركوه(@)(@@)(@@)(@@) | 2561 - (@)(@@) سليمان بن أيوب الطلحي الكوفي(@)(@@) له مناكير بقي الى حدود المائتين وخرج له الضياء في المختارة(@)(@@)(@@)(@@) | 2562 - (@)(@@) سليمان بن بحير عن ابيه(@)(@@) مجهول(@)(@@)(@@)(@@) | 2563 - (@)(@@) سليمان بن بزيع عن مالك(@)(@@) قال أبو سعيد بن يونس منكر الحديث وقيل ابن أبي بزيع(@)(@@)(@@)(@@) | 2564 - (@)(@@) سليمان بن بشار عن هشيم(@)(@@) وطبقته متهم بوضع الحديث حدث بمصر(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2565 - (@)(@@) سليمان بن بشير(@)(@@) ذكره يعقوب الفسوي في الضعفاء ولا أعرفه(@)(@@)(@@)(@@) | 2566 - (@)(@@) سليمان بن جبير عن أنس(@)(@@) مجهول(@)(@@)(@@)(@@) | 2567 - (@)(@@) سليمان بن جعفر شيخ لبقية(@)(@@) لا يعرف والخبر منكر(@)(@@)(@@)(@@) | 2568 - (@)(@@) سليمان بن جنادة عن أبيه(@)(@@) قال البخاري منكر الحديث(@)(@@)(@@)(@@) | 2569 - (@)(@@) سليمان بن الحجاج شيخ للدراوردي(@)(@@) لا يعرف(@)(@@)(@@)(@@) | 2570 - (@)(@@) قد(@)(@@) سليمان بن حفص عن هشام بن سعد مجهول(@)(@@) وذكره ابن حبان في الثقات(@)(@@)(@@)(@@) | 2571 - (@)(@@) سليمان بن الحكم بن عوانة عن الأعمش(@)(@@) واه باتفاقهم(@)(@@)(@@)(@@) | 2572 - (@)(@@) ع(@)(@@) سليمان بن حيان أبو خالد الأحمر(@)(@@) ثقة مشهور وقد ذكره ابن عدي في كامله وقال هو وابن معين قبله صدوق ليس حجة(@)(@@)(@@)(@@) | 2573 - (@)(@@) سليمان بن أبي خالد المديني البزاز(@)(@@) شيخ للقعنبي لا يعرف(@)(@@)(@@)(@@) | 2574 - (@)(@@) سليمان بن خالد الواسطي عن قتادة(@)(@@) ضعفه الدارقطني(@)(@@)(@@)(@@) | 2575 
ms133	 - (@)(@@) د(@)(@@) سليمان بن خربوذ كان في زمن الأعمش(@)(@@) روى عنه عثمان بن عثمان لا يعرف(@)(@@)(@@)(@@) | 2576 - (@)(@@) سليمان بن داود مولى يحيى بن يعمر(@)(@@) مجهول عنه أيوب السختياني(@)(@@)(@@)(@@) | 2577 - (@)(@@) س(@)(@@) سليمان بن داود الخولاني الشامي عن الزهري وأبي(@)(@@) PageV00P000(@)(@@) قلابة مختلف فيه قال ابو حاتم وغيره لا بأس به وقال ابن معين ضعيف(@)(@@)(@@)(@@) | 2578 - (@)(@@) سليمان بن داود اليمامي عن يحيى بن أبي كثير(@)(@@) ضعفه غير واحد(@)(@@)(@@)(@@) | 2579 - (@)(@@) سليمان بن داود بن قيس المدني(@)(@@) متكلم فيه قاله الأزدي(@)(@@)(@@)(@@) | 2580 - (@)(@@) خت م عه(@)(@@) سليمان بن داود أبو داود الطيالسي(@)(@@) صاحب المسند كان يحفظ ثلاثين ألف حديث وثقوه وقال ابراهيم الجوهري أخطأ في ألف حديث وقال أبو حاتم كان كثير الخطأ(@)(@@)(@@)(@@) | 2581 - (@)(@@) سليمان بن داود المنقري الشاذكوني الحافظ(@)(@@) مشهور رماه ابن معين بالكذب وقال البخاري فيه نظر(@)(@@)(@@)(@@) | 2582 - (@)(@@) سليمان بن داود الحراني بومة عن الزهري(@)(@@) ضعفه غير واحد(@)(@@)(@@)(@@) | 2583 - (@)(@@) سليمان بن الربيع النهدي كوفي عن أبي نعيم ونحوه(@)(@@) تركه الدارقطني(@)(@@)(@@)(@@) | 2584 - (@)(@@) سليمان بن رجاء عن عبد العزيز بن مسلم(@)(@@) مجهول(@)(@@)(@@)(@@) | 2585 - (@)(@@) سليمان بن زياد عن شيبان النحوي(@)(@@) لا يعرف وحديثه منكر بل باطل(@)(@@)(@@)(@@) | 2586 - (@)(@@) سليمان بن زياد(@)(@@) قال ابن يونس في روايته عن ابن وهب نظر يقال اختلط(@)(@@)(@@)(@@) | 2587 - (@)(@@) بخ(@)(@@) سليمان بن يزيد وقيل ابن زيد أبو إدام المحاربي(@)(@@) عن ابن أبي أوفى كذبه يحيى بن معين(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2588 - (@)(@@) سليمان بن سالم القطان المدني(@)(@@) روى عنه يعقوب بن حميد بن كاسب قال البخاري أتى بخبر لا يتابع عليه وقال ابن عدي لا أرى به بأسا(@)(@@)(@@)(@@) | 2589 - (@)(@@) سليمان بن أبي سراج(@)(@@) ضعفه الدارقطني(@)(@@)(@@)(@@) | 2590 - (@)(@@) د(@)(@@) سليمان بن سفيان المدني عن عبد الله بن دينار(@)(@@) ضعفوه(@)(@@)(@@)(@@) | 2591 - (@)(@@) سليمان بن سفيان الجهني عن قيس بن الربيع ضعيف(@)(@@)(@@)(@@) | 2592 - (@)(@@) سليمان بن سلم الرازي(@)(@@) مجهول يروي عن الحارث بن فضيل(@)(@@)(@@)(@@) | 2593 - (@)(@@) سليمان بن سلمة أبو أيوب الخبائري عن إسماعيل بن عياش(@)(@@) تركه أبو حاتم(@)(@@)(@@)(@@) | 2594 - (@)(@@) سليمان بن سلمة عن أصحاب مالك(@)(@@) اتهمه ابن حبان بوضع الحديث(@)(@@)(@@)(@@) | 2595 - (@)(@@) سليمان بن أبي سليمان 
ms134	 القافلائي عن الحسن ومحمد(@)(@@) متروك الحديث(@)(@@)(@@)(@@) | 2596 - (@)(@@) سليمان بن أبي سليمان اليمامي وهو ابن داود ضعيف تقدم(@)(@@)(@@)(@@) | 2597 - (@)(@@) ت(@)(@@) سليمان بن أبي سليمان مولى ابن عباس(@)(@@) لا يعرف تفرد عنه العوام بن حوشب(@)(@@)(@@)(@@) | 2598 - (@)(@@) سليمان بن شعيب بن الليث بن سعد(@)(@@) ثنا ابن لهيعة قال ابن يونس روى مناكير(@)(@@)(@@)(@@) | 2599 - (@)(@@) سليمان بن شهاب عن عبد الله(@)(@@) بن معتمر مجهول(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2600 - (@)(@@) سليمان بن صلاية الملطي متهم(@)(@@)(@@)(@@) | 2601 - (@)(@@) عس(@)(@@) سليمان بن عبد الله(@)(@@) عن معاذة عن علي أنا الصديق الأكبر في الضعفاء للعقيلي وقال خ لا يتابع عليه(@)(@@)(@@)(@@) | 2602 - (@)(@@) د(@)(@@) سليمان بن عبد الحميد البهراني(@)(@@) كذبه النسائي وقبله غيره وقال ابو حاتم صدوق(@)(@@)(@@)(@@) | 2603 - (@)(@@) سليمان بن عبد الله أبو الوليد الرقي(@)(@@) قال ابن معين ليس بشيء ذكره الجوزي(@)(@@)(@@)(@@) | 2604 - (@)(@@) ت ق(@)(@@) سليمان بن عبيد الله الرقي أبو أيوب صويلح(@)(@@) عن عبيد الله بن عمرو قال ابن معين ليس بشيء(@)(@@)(@@)(@@) | 2605 - (@)(@@) ق قد(@)(@@) سليمان بن عتبة الدمشقي عن يونس بن ميسرة(@)(@@) وثقه دحيم ووهاه ابن معين(@)(@@)(@@)(@@) | 2606 - (@)(@@) م د س ق(@)(@@) سليمان بن عتيق عن ابن الزبير(@)(@@) قال البخاري لا يصح حديثه(@)(@@)(@@)(@@) | 2607 - (@)(@@) سليمان بن أبي عثمان التجيبي(@)(@@) روى عنه سالم بن غيلان مصري مجهول(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2608 - (@)(@@) ق(@)(@@) سليمان بن عطاء الحراني عن مسلمة الجهني(@)(@@) هالك اتهم بالوضع لقيه النفيلي وقال أبو حاتم ليس بالقوي(@)(@@)(@@)(@@) | 2609 - (@)(@@) سليمان بن عمران عن حفص بن غياث(@)(@@) قال ابن أبي حاتم دل حديثه على أنه ليس بصدوق(@)(@@)(@@)(@@) | 2610 - (@)(@@) سليمان بن عمرو أبو داود النخعي(@)(@@) عن عبد الملك بن عمير وكان يكذب(@)(@@)(@@)(@@) | 2611 - (@)(@@) سليمان بن عيسى بن نجيح السجزي(@)(@@) عن ابن عون كان يضع الحديث(@)(@@)(@@)(@@) | 2612 - (@)(@@) سليمان بن الفضل(@)(@@) عن ابن المبارك تكلم فيه أبو احمد بن عدي(@)(@@)(@@)(@@) | 2613 - (@)(@@) م د ت س(@)(@@) سليمان بن قرم أبو داود الضبي وهو ابن معاذ نسب الى جده(@)(@@) عن محمد بن المنكدر وثقه أحمد وقال ابو زرعة ليس بذاك وقال ابو حاتم ليس هو بالمتين وقال ابن حبان رافضي غال يقلب الأخبار 
ms135	(@)(@@)(@@)(@@) | 2614 - (@)(@@) ع(@)(@@) سليمان بن كثير العبدي البصري عن الزهري ثقة مشهور ضعفه ابن معين وقال النسائي ليس به بأس الا في الزهري(@)(@@)(@@)(@@) | 2615 - (@)(@@) سليمان بن كراز الطفاوي(@)(@@) عن مبارك بن فضالة ضعفه ابن عدي(@)(@@)(@@)(@@) | 2616 - (@)(@@) سليمان بن ابي كريمة(@)(@@) عن هشام بن عروة لين صاحب مناكير(@)(@@)(@@)(@@) | 2617 - (@)(@@) سليمان بن محمد بن حيان الموصلي(@)(@@) ضعفه الأزدي(@)(@@)(@@)(@@) | 2618 - (@)(@@) سليمان بن محمد بن الفضل النهرواني(@)(@@) متأخر ضعفه الدارقطني(@)(@@)(@@)(@@) | 2619 - (@)(@@) سليمان بن محمد الهاشمي عن شريك لا يعرف(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2620 - (@)(@@) سليمان بن محمد القافلائي هو ابن ابي سليمان مر(@)(@@)(@@)(@@) | 2621 - (@)(@@) سليمان بن مرثد عن عائشة وأبي الدرداء لا يدرى ألقيهما أم لا(@)(@@)(@@)(@@) | 2622 - (@)(@@) سليمان بن مرقاع الجندعي عن مجاهد(@)(@@) قال العقيلي منكر الحديث(@)(@@)(@@)(@@) | 2623 - (@)(@@) سليمان بن مساحن مجهول عن نافع(@)(@@)(@@)(@@) | 2624 - (@)(@@) سليمان بن مسافع الحجبي(@)(@@) عن منصور بن صفية لا يعرف والخبر منكر(@)(@@)(@@)(@@) | 2625 - (@)(@@) سليمان بن مسلم الخشاب عن سليمان التيمي(@)(@@) تركه ابن حبان وغيره(@)(@@)(@@)(@@) | 2626 - (@)(@@) خت م د ت س(@)(@@) سليمان بن معاذ هو سليمان بن قرم قد ذكر(@)(@@)(@@)(@@) | 2627 - (@)(@@) سليمان بن المعافى بن سليمان الرسعني(@)(@@) قال ابن عدي لم يسمع من أبيه شيئا فحملوه على أن روى عنه قلت تكون روايته عنه وجادة(@)(@@)(@@)(@@) | 2628 - (@)(@@) ع(@)(@@) سليمان بن مهران الأعمش(@)(@@) ثقة جبل ولكنه يدلس قال وهب بن زمعة سمعت ابن المبارك يقول انما أفسد حديث أهل الكوفة الأعمش وأبو اسحاق وقال جرير سمعت مغيرة يقول أهلك أهل الكوفة ابو اسحاق وأعمشكم هذا كأنه عنى الرواية عمن جاء(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2629 - (@)(@@) سليمان بن موسى(@)(@@) عن مظاهر بن أسلم صويلح الحال(@)(@@)(@@)(@@) | 2630 - (@)(@@) عه فق(@)(@@) سليمان بن موسى الأشدق ابو أيوب(@)(@@) عن عطاء ونافع وثق وقال البخاري عنده مناكير وقال النسائي ليس بالقوي(@)(@@)(@@)(@@) | 2631 - (@)(@@) سليمان بن هرم عن ابن المنكدر(@)(@@) قال الأزدي لا يصح حديثه قلت تفرد عن ابن المنكدر عن جابر بحديث العابد والرمانة وعنه كاتب الليث(@)(@@)(@@)(@@) | 2632 - (@)(@@) سلميان بن يزيد أبو المثنى الكعبي الخزاعي(@)(@@) عن أنس قال أبو حاتم منكر الحديث ليس بقوي(@)(@@)(@@)(@@) | 2633 - (@)(@@) ق(@)(@@) سليمان بن 
ms136	 بشير ويقال ابن بشير ويقال ابن قسيم ابو الصباح النخعي الكوفي عن إبراهيم النخعي والحكم روى عنه شعبة وضعفه ابو داود وغيره(@)(@@)(@@)(@@) | 2634 - (@)(@@) سليمان البصري عن أنس(@)(@@)(@@)(@@) | 2635 - (@)(@@) وسليمان عن مولى لأنس(@)(@@)(@@)(@@) | 2636 - (@)(@@) وسليمان العبدي عن تبيع(@)(@@)(@@)(@@) | 2637 - (@)(@@) وسليمان أبو حبيب عن ابي الجلد(@)(@@)(@@)(@@) | 2638 - (@)(@@) وسليمان عن أبي هريرة مجهولون(@)(@@)(@@)(@@) | 2639 - (@)(@@) سليم بن عثمان الفوزي الحمصي(@)(@@) عن محمد بن زياد الألهاني متهم واه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2640 - (@)(@@) سليم بن عمرو الأنصاري شامي(@)(@@) لا يعرف وخبره باطل رواه عنه علي بن عياش(@)(@@)(@@)(@@) | 2641 - (@)(@@) سليم بن عيسى عن الثوري(@)(@@) قال العقيلي مجهول وحديثه منكر قلت بل إمام في القراءة جائز الحديث(@)(@@)(@@)(@@) | 2642 - (@)(@@) سليم بن مطير عن أبيه(@)(@@) ذكره ابن حبان في كتاب الضعفاء(@)(@@)(@@)(@@) | 2643 - (@)(@@) سليم بن منصور بن عمار(@)(@@) عن ابن علية تكلم فيه ولم يترك(@)(@@)(@@)(@@) | 2644 - (@)(@@) سليم أبو سلمة عن الشعبي(@)(@@) قال النسائي ليس بثقة(@)(@@)(@@)(@@) | 2645 - (@)(@@) سليم أبو ميمونة عن أبي هريرة(@)(@@) ة قيل كان يبيع الصور(@)(@@)(@@)(@@) | 2646 - (@)(@@) سليم ابو عتبة السلمي(@)(@@) عن الشعبي مجهول(@)(@@)(@@)(@@) | 2647 - (@)(@@) سليم بن صالح(@)(@@) عن ابن ثوبان لا يعرف(@)(@@)(@@)(@@) | 2648 - (@)(@@) سليم بن مسلم الكاتب الخشاب(@)(@@) عن ابن جريج قال النسائي متروك وقال ابن معين جهمي خبيث(@)(@@)(@@)(@@) | 2649 - (@)(@@) م عه خت(@)(@@) سماك بن حرب صدوق جليل(@)(@@) كان شعبة يضعفه وقال ابن المبارك ضعيف الحديث وقال ابن خراش في حديثه لين وقال احمد مضطرب الحديث(@)(@@)(@@)(@@) | 2650 - (@)(@@) بخ(@)(@@) سماك بن سلمة الضبي(@)(@@) لا يعرف على أنه قد وثق(@)(@@)(@@)(@@) | 2651 - (@)(@@) س ق(@)(@@) سمرة بن سهم(@)(@@) تابعي لا يعرف(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2652 - (@)(@@) سمعان بن مالك عن أبي وائل(@)(@@) قال ابو زرعة الرازي ليس بالقوي(@)(@@)(@@)(@@) | 2653 - (@)(@@) سمعان بن مهدي(@)(@@) عن أنس لا يعرف ألصقت به نسخة قبح الله واضعها(@)(@@)(@@)(@@) | 2654 - (@)(@@) سمير بن داود مجهول(@)(@@)(@@)(@@