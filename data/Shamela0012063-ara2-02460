ms2459	 ظهير مدني عنه جعفر بن عبد الله الأنصاري.(@)(@@)(@@)(@@) | 2912 - (@)(@@) " رافع " بن سلمة البجلي الكوفي يروي عن علي لا يعرف.(@)(@@)(@@)(@@) | 2913 - (@)(@@) " رباح " بن أبي معروف بن أبي سارة المكي عن عطاء ومجاهد.(@)(@@) PageV07P215(@)(@@)(@@)(@@) | من اسمه ربيح والربيع وربيعة(@)(@@)(@@)(@@) | 2914 - (@)(@@) " ربيح " بن عبد الرحمن بن أبي سعيد الخدري المدني.(@)(@@)(@@)(@@) | 2915 - (@)(@@) " الربيع " بن بدر بن عمرو بن جراد التميمي السعدي أبو العلاء لقبه عليلة1 البصري.(@)(@@)(@@)(@@) | 2916 - (@)(@@) " الربيع " بن حبيب العبسي بالموحدة مولاهم الملاح الأحول أخو عائذ بن حبيب الكوفي.(@)(@@)(@@)(@@) | 2917 - (@)(@@) " الربيع " بن حبيب الحنفي أبو سلمة البصري قال الدارقطني لا يترك.(@)(@@)(@@)(@@) | 2918 - (@)(@@) " الربيع " بن صبيح2 السعدي أبو بكر البصري.(@)(@@)(@@)(@@) | 2919 - (@)(@@) " الربيع " بن عبد الله بن خطاف بضم المعجمة وتشديد الطاء أبو محمد الأحدب البصري.(@)(@@)(@@)(@@) | 2920 - (@)(@@) " الربيع " بن لوط الأنصاري الكوفي يروي عن البراء.(@)(@@)(@@)(@@) | 2921 - (@)(@@) " الربيع " بن يحيى بن مقسم الاشناني3 أبو الفضل البصري.(@)(@@)(@@)(@@) | 2922 - (@)(@@) " ربيعة " بن سيف بن ماتع المعافري الإسكندراني.(@)(@@)(@@)(@@) | 2923 - (@)(@@) " ربيعة " بن عبد الله بن الهدير بضم الهاء التيمي المدني.(@)(@@)(@@)(@@) | 2924 - (@)(@@) " ربيعة " بن أبي عبد الرحمن فروخ التيمي مولاهم أبو عثمان المدني الفقيه PageV07P215(@)(@@) المعروف بربيعة الرأي.(@)(@@)(@@)(@@) | 2925 - (@)(@@) " ربيعة " بن عثمان ابن ربيعة بن عبد الله بن الهدير التيمي أبو عثمان المدني حفيد الذي تقدم.(@)(@@)(@@)(@@) | 2926 - (@)(@@) " ربيعة " بن كلثوم بن جبر بجيم وموحدة ساكنة البصري.(@)(@@)(@@)(@@) | 2927 - (@)(@@) " ربيعة " بن ناجد1 الأزدي الكوفي. PageV07P216(@)(@@)(@@)(@@) | من اسمه رجاء ورداد ورديح(@)(@@)(@@)(@@) | 2928 - (@)(@@) " رجاء " بن أبي رجاء الباهلي البصري عن محجن.(@)(@@)(@@)(@@) | 2929 - (@)(@@) " رجاء " بن صبيح بالفتح الحرشي بفتح المهملة والراء بعدها معجمة أبو يحيى البصري السقطي صاحب السقط بفتح القاف.(@)(@@)(@@)(@@) | 2930 - (@)(@@) " رجاء " الأنصاري الكوفي روى عنه الأعمش فقط.(@)(@@)(@@)(@@) | 2931 - (@)(@@) " رداد2 " الليثي حجازي والاشهر أبو الرداد روى عن عبد الرحمن بن عوف وعنه أبو سلمة بن عبد الرحمن.(@)(@@)(@@)(@@) | 2932 - (@)(@@) " رديح3 " بن عطية القرشي مؤذن بيت المقدس عن ابن إبراهيم بن أبي عبلة قال أبو حاتم: وثقه دحيم ولينه غيره. PageV07P216(@)(@@)(@@)(@@) | من اسمه رزق الله ورزيق ورزين(@)(@@)(@@)(@@) | 2933 - (@)(@@) " رزق الله " بن موسى الناجي بالنون البغدادي الإسكافي يقال: اسمه عبد الكريم.(@)(@@)(@@)(@@) | 2934 - (@)(@@) " رزيق 
ms2460	 " بن سعيد بن عبد الرحمن المدني عن أبي حازم سلمة بن دينار.(@)(@@)(@@)(@@) | 2935 - (@)(@@) " رزيق " أبو عبد الله الألهاني بفتح الهمزة الحمصي.(@)(@@)(@@)(@@) | 2936 - (@)(@@) " رزين " بن سليمان الأحمري.(@)(@@) PageV07P216(@)(@@)(@@)(@@) | 2937 - (@)(@@) " رزين " بن عقبة عن الحسن كأنه بن عمارة وعنه نجدة بن المبارك1 الكوفي لا يدري من هو. PageV07P217(@)(@@)(@@)(@@) | من اسمه رشدين ورفدة ورفيع(@)(@@)(@@)(@@) | 2938 - (@)(@@) " رشدين2 " بن سعد المهري بفتح الميم وسكون الهاء أبو الحجاج المصري.(@)(@@)(@@)(@@) | 2939 - (@)(@@) " رشدين " بن كريب بن أبي مسلم الهاشمي مولاهم أبو كريب المدني مولى علي بن عبد الله بن عباس.(@)(@@)(@@)(@@) | 2940 - (@)(@@) " رفدة3 " بن قضاعة الغساني مولاهم الدمشقي.(@)(@@)(@@)(@@) | 2941 - (@)(@@) " رفيع4 " أبو العالية بن مهران الرياحي5 مولاهم البصري صلى خلف عمر رضى الله عنه ودخل على أبي بكر رضى الله عنه. PageV07P217(@)(@@)(@@)(@@) | من اسمه رميح ورواد(@)(@@)(@@)(@@) | 2942 - (@)(@@) " رميح6 " الحزامي عن أبي هريرة رضى الله عنه.(@)(@@)(@@)(@@) | 2943 - (@)(@@) " رواد " بن الجراح العسقلاني أبو عصام أصله من خراسان. PageV07P217(@)(@@)(@@)(@@) | من اسمه روح وريحان(@)(@@)(@@)(@@) | 2944 - (@)(@@) " روح " بن اسلم الباهلي أبو حاتم البصري روى عن الحمادين.(@)(@@)(@@)(@@) | 2945 - (@)(@@) " روح " بن جناح الأموي مولاهم أبو سعيد الدمشقي.(@)(@@)(@@)(@@) | 2946 - (@)(@@) " روح " بن عبادة بن العلاء بن حسان القيسي أبو محمد البصري الحافظ أحد الرؤساء الأشراف وصاحب السبق.(@)(@@) PageV07P217(@)(@@)(@@)(@@) | 2947 - (@)(@@) " روح " بن عنبسة بن سعيد الأموي مولاهم البصري.(@)(@@)(@@)(@@) | 2948 - (@)(@@) " ريحان " ابن سعيد بن المثنى الناجي بالنون ثم جيم بعد الألف السامي بالمهملة أبو عصمة البصري.(@)(@@)(@@)(@@) | 2949 - (@)(@@) "ريحان ابن يزيد العامري.(@)(@@) PageV07P218(@)(@@)(@@)(@@) | حرف الزاي(@)(@@)(@@)(@@) | من اسمه زاذان وزافر وزائدة وزبان(@)(@@) ...(@)(@@) حرف الزاي.(@)(@@)(@@)(@@) | 2950 - (@)(@@) " زاذان " الكندي مولاهم أبو عمر البزار الكوفي أبو عبد الله.(@)(@@)(@@)(@@) | 2951 - (@)(@@) " زاذان " أبو يحيى القتات الكوفي مشهور بكنيته.(@)(@@)(@@)(@@) | 2952 - (@)(@@) " زافر " بن سليمان الايادي أبو سليمان القهستاني بضم القاف والهاء وسكون المهملة سكن الري نزيل بغداد قاضي سجستان.(@)(@@)(@@)(@@) | 2953 - (@)(@@) " زائدة " بن أبي الرقاد بضم المهملة ثم قاف الباهلي أبو معاذ البصري الصيرفي صاحب الحلي.(@)(@@)(@@)(@@) | 2954 - (@)(@@) " زبان " ابن سلمان أرسل ما له راو غير بن جريج في ما أعلم.(@)(@@)(@@)(@@) | 2955 - (@)(@@) " زبان " ابن فائد بفاء الحمراوي بالمهملة أبو جوبن بجيم ونون مصغر المصري مات سنة خمس وخمسين 