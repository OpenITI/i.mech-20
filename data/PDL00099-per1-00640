ms621	 خدا نداد مثال(@)(@@) 56 بود نخستین تمثال خامه ازلی %~% اگرچه‌گویند ازکلک او بود تمثال(@)(@@) 57 کمال قدرت حقست و نیست هیچ شکی %~% در اینکه صورت هستی ازو گرفت‌ کمال(@)(@@) 58 ز مهر اوست در ابدان همی تمازج روح %~% ز قهر اوست در آفاق صورت آجال(@)(@@) 59 همی نپوید بی‌حکم او صبا و دبور %~% همی نجنبد بی ‌امر او جنوب و شمال(@)(@@) 60 ز حزم اوست‌ که آمد همی زمین ساکن %~% ز بأس اوست ‌که‌ گیرد مدر همی زلزال(@)(@@) 61 به دست ریدک قدرش سپهر چه سیاره %~% به پای شاهد رایش شهاب چه خلخال(@)(@@) 62 ستاره بی‌شرر فکرتش چو نقطه نیل %~% زمانه بی ‌اثر همتش چو سقطه نال(@)(@@) 63 زمانه را تاند بدهدی به وقت کرم %~% ستاره را یارد بدهدی به‌گاه نوال(@)(@@) 64 نه بی‌ولایش قدر تنی نمود بلند %~% نه بی‌عتابش جاه‌کسی‌گرفت زوال(@)(@@) 65 طفیل اوست اگر عالی است اگر سافل %~% مطیع اوست اگر خواری است اگر اجلال(@)(@@) 66 ز کلک ‌کاتب شد راست در صحیفه الف %~% خمیده ازکف خطاط شد به دفتر دال(@)(@@) 67 شگفت نیست‌گرش از سفال بود آوند %~% که پیش همت او زر نداشت سنگ سفال(@)(@@) 68 به مطبخ‌ کرمش آسمان یکی دود است %~% که از نهیب رکابش ‌گرفته رنگ زگال(@)(@@) 69 نوای صلصل هستیش بد ستاره‌ گرای %~% هنوز نامده آدم پدید از صلصال(@)(@@) 70 جهان و هرچه در او صیدهای بسته ی اوست %~% نزیبد الحق چونین خدای را زیبال(@)(@@) 71 ستوده دلدل او را فره سپهرستی %~% مخمرستی با او اگر نسیم شمال(@)(@@) 72 به پویه چهر فلک را بدم فرو پوشد %~% چنانکه ناف سمک را بمالدی به نعال(@)(@@) 73 به‌ گام‌ کوه‌نوردش ودیعه برق یمان %~% به سم خاره شکافش نهفته باد شمال(@)(@@) 74 هماره تا که جهان آفریده بارخدای %~% بدیع پیکر او را نیافریده مثال PageV1P300(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 هر وجودی ‌را به ‌وهم اندر توان ‌جستن همال %~% جز وجود مهتری ‌کاو را همالستی محال(@)(@@) 2 روی دین 
ms622	 پشت هدی غیث‌ کرم غوث امم %~% چرخ فر قطب ظفر اصل هنر فصل‌ کمال(@)(@@) 3 قهرمان ملک و ملت حاجی آقاسی‌ که هست %~% جان پاکش غوطه‌زن در بحر فیض لایزال(@)(@@) 4 عقل افزون از شهودش داد نتواند خبر %~% وهم بیرون از وجودش دید نتواند مجال(@)(@@) 5 گر ز عدل او به بازو هیکلی بندد مریض %~% ز انحراف طبع بگراید به سوی اعتدال(@)(@@) 6 ور به پیشانی نگارد نام بختش آفتاب %~% تا شباهنگام روز حشر نپذیرد زوال(@)(@@) 7 عقل را ماند که با هر نفس دارد اقتران %~% روح را ماند که با هر جسم دارد اتصال(@)(@@) 8 هستی صرفست پنداری‌کزاو پوشیده نیست %~% هیچ عیبی در برون و هیچ علمی در خیال(@)(@@) 9 صورت عقل‌است از آن ذاتش نگنجد در بیان %~% معنی روحست از آن وهمش نسنجد در مقال(@)(@@) 10 کوه خارا از شرار خشمش افروزد چنانک %~% قبضه‌ گوگرد کز آتش پذیرد اشتعال(@)(@@) 11 وصف مهرش چون‌کنم‌طبعم‌ببالد همچو سرو %~% شرح قهرش چون‌ کنم‌ کلکم بنالد همچو نال(@)(@@) 12 قدر او را بدر گفتم عقل‌ گفتا ای شگفت %~% بدر دیدستی ‌که روزافزون بود همچون هلال(@)(@@) 13 دست او را ابر خواندم وهم‌ گفتا ای عجب %~% ابر دیدستی ‌که بی‌سعی صدف بخشد لآل(@)(@@) 14 مدح هرچیزی‌ که‌ گویی‌در حقیقت مدح اوست %~% زانکه بر هر جزو باشد نفس‌کل را اشتمال(@)(@@) 15 مدح قدر اوست مدح چرخ ‌گردان از علو %~% وصف جود اوست وصف ابر نیسان در نوال(@)(@@) 16 نعت ذات او صفات او به از مردم ‌کند %~% بی‌نزاع‌گفتگوی و بی‌صدای قیل و قال(@)(@@) 17 گل به بوی خویش معروف است بی‌رنج دلیل %~% مه به نور خویش موصوفست بی‌غنج و دلال(@)(@@) 18 هست با شه ارتباطش ارتباط جان و دل %~% جان و دل را جز به وهم اندر نیابی انفصال(@)(@@) 19 نی خطا گفتم براست از اتحاد جان و دل %~% اتحاد اینست‌ کان هرگز نگنجد در مثال(@)(@@) 20 دوش از انعام عامش شکوه‌یی می‌کرد عقل %~% نرم‌ 
ms623	 نرمک زیر لب چون‌ گفتگوی اهل حال(@)(@@) 21 از تعصب موی من چون نوک ناچخ شد درشت %~% جستم از جا تا به پای عقل بربندم عقال(@)(@@) 22 گفت بنشین خشم بنشان ‌گوش ده خاموش باش %~% تا در این معنی ترا سازم به استدلال لال(@)(@@) 23 گفتمش برهان چه داری ‌گفت‌ کز بدو وجود %~% تا به عهد جود او با جان برابر بود مال(@)(@@) 24 گوهر از عزت به جایی بود کاندر جشنها %~% زیور تاج تکین بد زینت فرق ینال(@)(@@) 25 و اینک از خواری ‌گهر را گر به دریا افکنی %~% زانزجار قرب او پهلو فرو دزدد زبال(@)(@@) 26 گفتش ای عقل از پیری به جایی بینمت %~% کز خرافت بازنشناسی یمین را از شمال(@)(@@) 27 خود تو صد ره‌‌ گفته‌یی گوهر جمادی بیش نبست %~% بر جمادی چون نهد عزت عزیزی ذوالجلال(@)(@@) 28 او گهر را خوار دارد تا شود قدرش عزیز %~% زین دو عزت مر کدام اولی بیان‌کن شرح حال(@)(@@) 29 مهترا مسکین‌نوازا هست سالی تاکه من %~% تشنه‌لب جان می‌دهم بر چشمه آب زلال(@)(@@) 30 تو رسول وقت خویشی من بلال وقت تو %~% هیچ از رحمت نفرمودی ارحنا یا بلال(@)(@@) 31 نیمه سالی ندانم بیشتر یاکمترست %~% کز تو دارم انتظار وعده یک طاقه شال(@)(@@) 32 شال را بگذار حال من بدست آور که هست %~% در دلم صدگونه غم زین‌کهنه دیر دیرسال(@)(@@) 33 قرض من چندان بودکاندر درون تست علم %~% گرچه شاید کاین تشابه را نکو گیرم به فال(@)(@@) 34 عمر من‌گر در جهان بودی به قدر وام من %~% هیچکس را بر فنای من نرفتی احتمال(@)(@@) 35 خلعت شاه و تو و اجرا و انعام و تیول %~% گرچه تعیین رفت بختم قاصر آمد در سوال(@)(@@) 36 صبرکن قاآنیا بر تیر باران بلا %~% کز بلا راهی بود تا قاب قوسین وصال(@)(@@) 37 گر توانی پنجه تقدیر تابیدن بتاب %~% ور نتانی صبرکن وز هرچه پیش آید منال(@)(@@) 38 تا ز حی لاینام اندر زبانها 
ms624	 گفتگوست %~% باد بختت لاینام و باد عمرت لایزال(@)(@@) 39 خوی احبابت ز طیبت مشکبو بادا چو زلف %~% بخت اعدایت به طینت تیره‌رو بادا چو خال PageV1P301(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 آمد چه خلعت‌ از کجا از دکه شاه عجم %~% کی‌ صبحدم از بهر که‌ از بهر میر ملک جم(@)(@@) 2 این کرده چه خدمت‌‌ کجا هم در سفر هم در حضر %~% ازکی‌ ز عهدکودکی طوبی لارباب الهمم(@)(@@) 3 آن داده چه خلعت‌ چرا پاداش خدمتهای وی %~% خدمت‌ کند بی حد چه سان‌ از صدق دل‌ کی‌ دم بدم(@)(@@) 4 شه داده ترجیحش به‌ که‌ بر چاکران از بهر چه‌ %~% زر می‌دهد کو زر بده تنها نه زر سر نیز هم(@)(@@) 5 ابن خدمت از روی چه ‌کرد از روی اخلاص عمل %~% آن خلعت از بهر چه داد از بهر اظهار کرم(@)(@@) 6 باری شماری خدمتش آری توانم‌ گوش‌ کن %~% بذل همم نشرکرم طی ستم نظم خدم(@)(@@) 7 رفع زلل دفع علل سد خلل امن ملل %~% تنبیه اشرار دغل ترفیه اصناف امم(@)(@@) 8 نظم بساتین را نگر آسایش دین را نگر %~% حسن قوانین را نگر در حکمرانی منتظم(@)(@@) 9 گه نظم بخشد دهر را گه سور سازد شهر را %~% گاهی کند صد نهر را جاری چو امثال و حکم(@)(@@) 10 در فارس از هر سوی هی نهر بین هی جوی بین %~% هی شهر بین هی‌ کوی بین ‌کاو ساخته در هر قدم(@)(@@) 11 شکرانه تشریف ‌کی اکنون چه باید خورد می %~% تنها نه با آواز نی آهسته نه با زیر و بم(@)(@@) 12 خادم بیا حاسد برو راوی بگو مطرب بخوان %~% ساقی بده شاهد بخور چنگی بزن نایی بدم(@)(@@) 13 مطرب بلی بنشین چرا خوانیم تا شه را دعا %~% تو با نوا من بینوا تو با نغم من بی‌نقم(@)(@@) 14 ساقی نعم‌پرکن چه‌چیز‌آن‌جام خوارزمی ز چه‌ %~% از می‌ کدامین می‌ میی‌ کز دل برد رنج و سقم(@)(@@) 15 زان می خوری‌ آری‌ کجا 
ms625	 در بوستان بی‌دوستان %~% نه دوست دارم دوست‌ کو بسیار نه بسیاریم(@)(@@) 16 می می‌خوری‌ بی‌نقل نه‌کو نقل شیرین‌ لعل تو %~% آن نقل می‌خواهی‌ بلی نقلم بها دارد نعم(@)(@@) 17 نرخش چه خواهی داد دین دین نیستت دل می‌دهم %~% دل داده‌یی جان بخشمت جانت نیرزد یک درم(@)(@@) 18 پس چون ‌کنم‌ شعری بگو بهر چه‌ بهر تهنیت %~% در شأن ‌که‌ در شأن آن میر اجل شیر اجم(@)(@@) 19 نامش چه‌ صاحب اختیار از چیست زینسان نامدار %~% از یمن فضل‌ کردگار از جود شاه محترم(@)(@@) 20 کارش چه‌ شکر پادشا یارش ‌که‌ الطاف خدا %~% وصفش چه‌ نهاب‌العدی نعتش چه‌ وهاب‌النعم(@)(@@) 21 لا گفته آری در نهان وقت تشهد بیکران %~% لم‌ گوید آری آن زمان‌ کز منشیی خواهد قلم(@)(@@) 22 از کس نخواهد هیچ شی خواهد چه خواهد مدح‌ کی %~% چیزی ندارد خصم وی دارد چه دارد درد و غم(@)(@@) 23 بینی به عهدش مفلسی آری ز جود او بسی %~% کو از تو پرسد گر کسی بشمار گنج و کان ویم(@)(@@) 24 هستش‌ که ایزد چه معین بهر چه‌ بهر نظم دین %~% دین را چسان خواهد متین بدخواه دین را چون دوم(@)(@@) 25 باشد که نطقش چه شکر بارد که دستش چه‌ گهر %~% جویدکه بختثث‌ن چه ظفر داردکه شخصثث چه حشم(@)(@@) 26 آید که خصمش در کجا در چشم‌ کی روز وغا %~% همچون چه چون ‌کوه بلا از فربهی نه از ورم(@)(@@) 27 ای همچو گیتی نامجو دریا صفت با آبرو %~% چون باغ رضوان نیکخو چون چرخ‌گردان محترم(@)(@@) 28 گر نام شمشیرت ‌کسی خواند به‌ گوش حامله %~% اژ بیم چون ماهی جنین با جوشن آید از شکم(@)(@@) 29 با سیم دستت در جهان خصمی نماند جاودان %~% کز روی خط بیند عیان از نقش او نقش ستم(@)(@@) 30 ملک تراکز ریمنی آسوده وز اهریمنی %~% حسرت برد از ایمنی روضه ارم حوضه حرم(@)(@@) 31 از بس دلت از هرکسی جوید نشان راستی %~% پیشت نیارد شد 
