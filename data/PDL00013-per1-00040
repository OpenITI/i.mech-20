ms33	 به تیغ در صحرا(@)(@@) 40 باقی بادی که از بداندیشان %~% تیغت نکند به هیچ وقت ابقا(@)(@@) 41 غوغاست مخالف تو را شیوه %~% با هیبت تو چه خیزد از غوغا(@)(@@) 42 روزی که ز نعل مرکبان افتد %~% در زلزله جرم مرکز غبرا(@)(@@) 43 از تیره غبار چشمه روشن %~% تاریک شود چو چشم نابینا(@)(@@) 44 دل دوزد نوک نیزه خطی %~% جان سوزد حد تیغ روهینا(@)(@@) 45 از چتر تو سایه همای افتد %~% وز گرد سپاه سایه عنقا(@)(@@) 46 رعد آوا مرکب تو از هر سو %~% هر ساعت برکشد چو نفخ آوا(@)(@@) 47 ای شاه عجم تو زیر ران آری %~% رخشی که نخواندش خرد عجما(@)(@@) 48 زیرا که بود به وقت کر و فر %~% عزم و حزمش چو مردم دانا(@)(@@) 49 دریابد اگر به دل کنی فکرت %~% بشناسد اگر کنی به چشم ایما(@)(@@) 50 پرورده تنی چو کوهی اندر تن %~% بر رفته سری چو نخلی اندر وا(@)(@@) 51 چون باد که دست و پای را با او %~% حاجت نبود به هیچ استقصا(@)(@@) 52 اندر تک دور تاز چون صرصر %~% در جولان گرد گرد چون نکبا(@)(@@) 53 گر قصد کنی چو وهم یک لحظه %~% از جابلقا رسید به جابلسا(@)(@@) 54 واثق تو بدان که چون برانگیزی %~% در حمله تست عروة الوثقی(@)(@@) 55 اندر مه دی بهاری آرایی %~% بر روی بساط ساحت پیدا(@)(@@) 56 کز چهره و خون دشمنان گردد %~% چون بارگه تو پر گل رعنا(@)(@@) 57 این هست ولیک نیستت حاجت %~% تا از پی رزم ها شوی کوشا(@)(@@) 58 نه نفس نفیس را چه رنجانی %~% ای نفس تو فخر آدم و حوا(@)(@@) 59 واجب نکند به هیچ اندیشه %~% بر طبع عزیز خود نهی حاشا(@)(@@) 60 من بنده به فتح ها همی گویم %~% هر هفته یکی قصیده غرا(@)(@@) 61 تا گردد فتح نامه ها پران %~% از هر سو سوی مجلس اعلا(@)(@@) 62 از نصرت فتح مطلع و مخلص %~% طنان و بدیع و مقطع و مبدا 
ms34	(@)(@@) 63 دل شعبده ها گشاده از فکرت %~% جان معجزه ها نموده در انشا(@)(@@) 64 هر لفظی از آن چو صورتی دلکش %~% هر بیتی از آن چو لعبتی زیبا(@)(@@) 65 شاها تو گزین مالک الملکی %~% هستی تا حشر مالک دنیا(@)(@@) 66 بنده ز سروش یافت این تلقین %~% این لفظ ز خود نگفت بر عمدا(@)(@@) 67 تا یابد هال مرکز سفلی %~% تا دارد دور گنبد خضرا(@)(@@) 68 ایوان تو باد ملک را مکمن %~% درگاه تو باد عدل را مأوا(@)(@@) 69 تا دولت و دانش است جان پرور %~% از دانش پیر و دولت برنا(@)(@@) 70 تو شاد نشسته بر گه دولت %~% با حشمت و فر خسرو دارا(@)(@@) 71 در چشم عزیز چهره دلبر %~% بر دست خجسته ساغر صهبا(@)(@@) 72 سازنده کار گنبد اخضر %~% خنیاگر بزم زهره زهرا PageV1P034(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 تا از بر من دور شد آن لعبت زیبا %~% از هجر نیم یک شب و یک روز شکیبا(@)(@@) 2 بس شب که به یک جای نشستیم و همه شب %~% زو لطف و لطف بود وز من ناله و نینا(@)(@@) 3 ای آن که تو را زهره و مه نیست همانند %~% وی آن که تو را حور و پری نامده همتا(@)(@@) 4 نه چون دل من بود به زاری دل وامق %~% نه چون رخ تو بود به خوبی رخ عذرا(@)(@@) 5 من بی دل و تو دلبر و در زاری و خوبی %~% تا حشر بخوانند به خوبی سمر ما(@)(@@) 6 وانکس که بخواند سمر ما نه شگفت است %~% گر بیش نخواند سمر غفره و غفرا(@)(@@) 7 خون راندم از اندیشه هجران و تو حاضر %~% پس حال چه باشد چو بمانم ز تو تنها(@)(@@) 8 بگذشت مرا عمر به فردا و به امروز %~% تا کی فکنی وعده امروز به فردا(@)(@@) 9 با چهره پرچینم و با قامت کوژم %~% وان چهره شیرین تو و قامت زیبا(@)(@@) 10 گمره شود آن کس که همی روی تو بیند 
ms35	 %~% آن روی نکو صورت ما نیست همانا(@)(@@) 11 همرنگ شبه زلف و همرنگ بسد لب %~% وین هر دو به دل بردن عشاق مسما(@)(@@) 12 در دو شبه تو دو گل سرخ شکفته %~% در بسد تو دو رده لؤلؤ لالا(@)(@@) 13 غوغای چنان روی و چنان موی بسوزد %~% منمای چنان روی و چنان موی به غوغا(@)(@@) 14 خورشید به مویه شود و روی بپوشد %~% کان روی چو خورشید بیارایی عمدا(@)(@@) 15 از مشک چلیپا است بر آن رومی رویت %~% در روم ازین روی پرستند چلیپا(@)(@@) 16 بر نقره خام تو بتا خامه خوبی %~% بنگاشته از غالیه دو خط معما(@)(@@) 17 بر مشک زنم بوسه و بر سیم نهم روی %~% ای مشکین زلفین من ای سیمین سیما(@)(@@) 18 در چاه چو معشوق زلیخایم ازین عشق %~% ای خوبی تو خوبی معشوق زلیخا(@)(@@) 19 تاریست ز دیبا تن من تا نظر من %~% ناگاه فتاد است بر آن روی چو دیبا(@)(@@) 20 با واقعه عشقم و با حادثه هجر %~% در عشوه وسواسم و در قبضه سودا(@)(@@) 21 طبعم ز تو پر کار و دل از رنج تو پربار %~% رازم ز تو پیدا و تن از ضعف نه پیدا(@)(@@) 22 عاشق ز تو شیداشد و باشد که بنالد %~% پیش ملک از جور تو این عاشق شیدا(@)(@@) 23 جورت نکشد بنده آن شاه که امروز %~% در روی زمین نیست چو او شاه توانا(@)(@@) 24 خورشید زمین سایه یزدان فلک ملک %~% سلطان جهان داور دین خسرو دنیا(@)(@@) 25 مسعود جهانگیر جهاندار که ایزد %~% داد است بدو ملک مهیا و مهنا(@)(@@) 26 ای شاه بپیمود زمین را و فلک را %~% جاه تو و قدر تو به بالا و به پهنا(@)(@@) 27 نه دیده معالی تو را گردون غایت %~% نه کرده ایادی تو را گردون احصا(@)(@@) 28 دانا و توانایی و آباد بود ملک %~% چون شاه توانا بود و خسرو دانا(@)(@@) 29 هر شاه که او ملک تو و ملک 
ms36	 تو بیند %~% از ملک مبرا شود از ملک معرا(@)(@@) 30 تا آدم و حوا که شدند اصل تناسل %~% هستی ملک و شاه به اجداد و به آبا(@)(@@) 31 وین آدم و حوا سبب اصل تو بودند %~% ای اصل تو فخر و شرف آدم و حوا(@)(@@) 32 هر گل که تو را بشکفد اندر چمن ملک %~% خاری شود اندر جگر و دیده اعدا(@)(@@) 33 بر فرق عدوی تو کشد خنجر گردون %~% در خدمت قدر تو کمر بندد جوزا(@)(@@) 34 رخش تو و تیغ تو بسی معرکه دیده %~% تا داشته بأسا را بأس تو بیاسا(@)(@@) 35 نه بوده گه حمله بی رخش مقصر %~% نه کرده گه زخم سر تیغ محابا(@)(@@) 36 هر پیل که ران تو برانگیخت به حمله %~% با تازش صرصر شد و با گردش نکبا(@)(@@) 37 وانگاه که با شیر دژاگاه کنی رزم %~% با گردش گردون شود و جوشش دریا(@)(@@) 38 باشد چو دمان دیوی اندر دم پیکار %~% گردد چو روان حصنی اندر صف هیجا(@)(@@) 39 از بن بکند کوه چو زی صحرا تازد %~% گویی که روان کوهی گشته است به صحرا(@)(@@) 40 کین تو برآمد به ثریا و به عیوق %~% لرزان شد و پیچان شد عیوق و ثریا(@)(@@) 41 مهر تو برافتاد به خارا و به سندان %~% گل رست و سمن رست ز سندان و ز خارا(@)(@@) 42 هر دل که نه از مهر تو چون نار بود پر %~% از ترس و هراس تو دگر گرددش اعضا(@)(@@) 43 چون مار همه بر تن او بترکد اندام %~% چون نار همه در شکمش خون شود احشا(@)(@@) 44 بر مرکز غبرا همه در حکم تو باشد %~% هر جاه که باقی است در این مرکز غبرا(@)(@@) 45 بر قبه خضرا همه بر امر تو گردد %~% هر سعد که جاریست بر این گنبد خضرا(@)(@@) 46 هر روز فزون گرددت از گردون ملکی %~% فاللیل بما یطلب من جدک حبلی(@)(@@) 47 شاها می سوری نوش ایرا 
ms37	 به چمن در %~% بگرفت می سوری جای گل رعنا(@)(@@) 48 هر باغ مگر خلد برین است که هر شاخ %~% با خوبی حورا شد و با زیور حورا(@)(@@) 49 از باد برآمیخته شنگرف به زنگار %~% در ابر درآویخته بیجاده به مینا(@)(@@) 50 برخاسته هنگام سپیده نفس گل %~% چونان که به مجمر نفس عود مطرا(@)(@@) 51 گوئی که گیا قابل جان شد که چنین شد %~% روی گل و چشم شکفه تازه و بینا(@)(@@) 52 این جمله ز آثار نسیم است مگر هست %~% آثار نسیم سحر انفاس مسیحا(@)(@@) 53 ای ملک تو کلی که از آن هست به گیتی %~% فخر و شرف و دولت و فتح و ظفر اجزا(@)(@@) 54 دارالکتب امروز به بنده است مفوض %~% این عز و شرف گشت مرا رتبت والا(@)(@@) 55 پس زود چو آراسته گنجی کنمش من %~% گر تازه مثالی شود از مجلس اعلا(@)(@@) 56 اندیشه آن دارم و هر هفته ای آرم %~% زی صدر رفیع تو یکی مدحت غرا(@)(@@) 57 اشعار من آن است که در صنعت نظمش %~% نه لفظ معار است و نه معنیش مثنا(@)(@@) 58 انشا کندش روح و منقح کندش عقل %~% گردون کند املا و زمانه کند اصغا(@)(@@) 59 تا چرخ دو تا گردد بر بنده و آزاد %~% این چرخ دو تا باد تو را بنده یکتا(@)(@@) 60 هر چیز که خواهی همه از دهر میسر %~% هر کام که جویی همه از بخت مهیا(@)(@@) 61 داده همه احکام تو را گردون گردن %~% کرده همه فرمان تو را گیتی PageV1P035(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 دوش در روی گنبد خضرا %~% مانده بود این دو چشم من عمدا(@)(@@) 2 لون انفاس داشت پشت زمین %~% رنگ زنگار داشت روی هوا(@)(@@) 3 کلبه ای بود پر ز در یتیم %~% پرده ای پر ز لؤلؤ لالا(@)(@@) 4 آینه رنگ عیبه ای دیدم %~% راست بالاش در خور پهنا(@)(@@) 5 مختلف شکل ها همی دیدم %~% کامد از اختران همی پیدا(@)(@@) 6 افسری بود بر 
ms38	 سر اکلیل %~% کمری داشت بر میان جوزا(@)(@@) 7 راست پروین چو هفت قطره شیر %~% بر چکیده به جامه خضرا(@)(@@) 8 فرقدان همچو دیدگان هژبر %~% شد پدید از کران چرخ دو تا(@)(@@) 9 بر کران دگر بنات النعش %~% شد گریزان چون رمه ز ظبا(@)(@@) 10 همچو من در میان خلق ضعیف %~% در میان نجوم نجم سها(@)(@@) 11 گاه گفتم که مانده شد خورشید %~% گاه گفتم که خفت ماه سما(@)(@@) 12 که نه این می برآید از پس خاک %~% که نه این می بجنبد اندر وا(@)(@@) 13 من بلا را نشانده پیش و بدو %~% شده خرسند اینت هول و بلا(@)(@@) 14 همت من همه در آن بسته %~% که مرا عمر هست تا فردا(@)(@@) 15 مویها بر تنم چو پنجه شیر %~% بند بر پای من چو اژدرها(@)(@@) 16 ناله زار کرد نتوانم %~% که همه کوه پر شد ز صدا(@)(@@) 17 اشک راندم ز دیدگان چندان %~% کز دل سنگ بر دمید گیا(@)(@@) 18 گر بخواهد از این همه غم و رنج %~% برهاند به یک حدیث مرا(@)(@@) 19 خاصه شهریار شرق علی %~% آن چو خورشید فرد و بی همتا(@)(@@) 20 آن که در نام ها خطابش هست %~% از عمیدان عصر مولانا(@)(@@) 21 دولت از رأی او گرفته شرف %~% عالم از رأی او گرفته ضیا(@)(@@) 22 خنجر عدل از او نموده هنر %~% گوهر ملک از او فزوده بها(@)(@@) 23 رأی او را ذلیل گشته قدر %~% عزم او را مطیع گشته قضا(@)(@@) 24 تیغ او بر فنای عمر دلیل %~% جود او بر بقای عیش گوا(@)(@@) 25 بس نباشد سخاوت او را %~% زاده کوه و داده دریا(@)(@@) 26 گر جهانی به یک عطا بدهد %~% از کف خویش نشمرد به سخا(@)(@@) 27 دیده عالم از تو شد روشن %~% نامه دولت از تو شد والا(@)(@@) 28 ملک را رتبتی نماند بلند %~% که نفرمود شهریار تو را(@)(@@) 29 جز یکی مرتبت نماند که هست %~% جایگاه نشستن وزرا(@)(@@) 30 بشتاب اندر آن 
ms39	 که تا بکنی %~% روی داری همیشه در بالا(@)(@@) 31 ای چو بارنده ابر در مجلس %~% وی چو آشفته شیر در هیجا(@)(@@) 32 باز سالی دو شد که در حضرت %~% نه ای از پیش تخت شاه جدا(@)(@@) 33 نه همی افتدت مراد سفر %~% نه همی آیدت نشاط غزا(@)(@@) 34 باز بر ساز جنگ ایرا هست %~% خون به جوش آمده به مرگ و فنا(@)(@@) 35 زین کن آن رزم کوفته شبدیز %~% کار بند آن زدوده روهینا(@)(@@) 36 دشت را کن به خنجرت جیجون %~% کوه را کن به لشگرت صحرا(@)(@@) 37 من از این قسم خویش می جویم %~% بازیی دیده ام درین زیبا(@)(@@) 38 که به هر سو گذر کند سپهت %~% به هوا بر شود غبار و هبا(@)(@@) 39 من بگیرم غبار موکب تو %~% که بود درد را علاج و شفا(@)(@@) 40 در دو دیده کشم که دیده من %~% گشت خواهد ز گریه نابینا(@)(@@) 41 در غم زال مادری که شده است %~% از غم و درد و رنج من شیدا(@)(@@) 42 نیل کرده رخش ز سیلی غم %~% کرده کافور دیدگان ز بکا(@)(@@) 43 چون عصا خشک و رفت نتواند %~% در دو گام ای عجب مگر به عصا(@)(@@) 44 راست گویی همی در آن نگرم %~% که چه ناله کند صباح و مسا(@)(@@) 45 زار گوید همی کجایی پور %~% کز غمت مرد مادرت اینجا(@)(@@) 46 من بر این گونه مانده در فریاد %~% زآشنایان و دوستان تنها(@)(@@) 47 بستد از من زمانه هر چه بداد %~% با که کرده است خود زمانه وفا(@)(@@) 48 زآن نیارد ستد همی جانم %~% که تو بخریده ایش و داده بها(@)(@@) 49 تا ضمیری است مرمرا به نظام %~% تا زبانی است مرمرا گویا(@)(@@) 50 همتت را کنم به واجب مدح %~% دولتت را کنم به خیر دعا(@)(@@) 51 از چون من کس در این چنین جایی %~% چه بود نی جز دعا و ثنا(@)(@@) 52 مر مرا داد رأی تو آرام %~% مر مرا کرد 
ms40	 جود تو به نوا(@)(@@) 53 دستم از بخشش تو پر دینار %~% تنم از خلعت تو پر دیبا(@)(@@) 54 شبی از من بریده نیست صلات %~% روزی از من بریده نیست عطا(@)(@@) 55 مر مرا آنچنان همی داری %~% که ز من هم حسد برند اعدا(@)(@@) 56 کرد گفتار من به دولت تو %~% آب و خون مغز و دیده شعرا(@)(@@) 57 ایمنم زآنکه قول دشمن من %~% نشود هیچ گونه بر تو روا(@)(@@) 58 زآنکه هرگز گزیده رأی تو را %~% هیچ وقتی نیوفتاد خطا PageV1P036(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 سپاه ابر نیسانی ز دریا رفت بر صحرا %~% نثار لؤلؤ لالا به صحرا برد از دریا(@)(@@) 2 چون گردی کش برانگیزد سم شبدیز شاهنشه %~% ز روی مرکز غبرا به روی گنبد خضرا(@)(@@) 3 گهی ماننده دودی مسطح بر هوا شکلش %~% گهی ماننده کوهی معلق گشته اندر وا(@)(@@) 4 چو گردون گشت باغ و بوستان از ابر نیسانی %~% گل از گلبن همی تابد بسان زهره زهرا(@)(@@) 5 از این پر مشک شد گیتی وزآن پر در همه عالم %~% از این پر بوی شد بستان وزآن پر نور شد صحرا(@)(@@) 6 گهی چون تخته تخته ساده سیم اندر هوا بر هم %~% گهی چون توده توده سوده کافور بر بالا(@)(@@) 7 گهی ماننده خنگی لگام از سر فرو کنده %~% شده تا زنده اندر مرغزاری خرم و خضرا(@)(@@) 8 گهی برقش درخشنده چو نور تیغ رخشنده %~% گهی رعدش خروشنده چو شیر شرزه در بیدا(@)(@@) 9 فلک در سندس نیلی هوا در چادر کحلی %~% زمین در فرش زنگاری که اندر حله خضرا(@)(@@) 10 زمین خشک شد سیراب و باغ زرد شد اخضر %~% هوای تیره شد روشن جهان پیر شد برنا(@)(@@) 11 کنون بینی تو از سبزه هزاران فرش میناگون %~% کنون بینی تو از گلبن هزاران کله دیبا(@)(@@) 12 زمین چون روی مه رویان به رنگ دیبه رومی %~% هوا چون زلف دلجویان به بوی عنبر سارا(@)(@@) 13 ز پستی لاله شد خندان چو 