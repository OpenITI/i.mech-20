ms701	 التواصل ثلمه % 53(@)(@@) % والقوافي مستسقيات فهلا % نزلت في بيوتهن الرحمه % 54(@)(@@) % كل حسرى الجبين عارية الجس % % م فمن ذا أحل هتك الحرمه % 55(@)(@@) % ومتى تكسهن من عرض ما تل % % بس تشف الصدى وتجل الغمه % 56(@)(@@) % إنما السيف زبرة وحلي ال % % جفن يلقى حسنا عليه ووسمه % 57(@)(@@) % رب وافى الجمال قد زاد فيه % % رونق في قميصه والعمه % 58(@)(@@) % خذ من العيد ناعم البال والني % % روز سهما يسنى لك الله قسمه % 59(@)(@@) % وتجلبب من السعادة ثوبا % يسحب الفخر ذيله أو كمه % 60(@)(@@) % كلما شذ عنك فائت حظ % نمنت ذمة المقادير غرمه % PageV01P2198 61(@)(@@) % فلقد فت غاية المدح حتى % % كاد مدحيك أن يكون مذمه % PageV01P2199 البحر : - 1(@)(@@) % راش نبالا في جفنه ورمى % % ظبي بجمع ما راقب الحرما % % 2(@)(@@) % بحيث كفارة القنيص من ال % % وحش دم طل للأنيس دما % % 3(@)(@@) % شن مغيرا على القلوب فما % % ينهض ثقلا منها بما علما % % 4(@)(@@) % يا قرب الله يوم تقصي الدمى ال % % بيض ظباء بمكة أدما % % 5(@)(@@) % أسهمهن اللصوق بالنسب الض % ارب في يعرب وإن قدما % % 6(@)(@@) % إذا اعتزى باللسان منتسب % سفرن ثم انتسبن لي فسما % % 7(@)(@@) % أو سلم الحسن للبياض لما % % عد شفاء بين الشفاه لمى % % 8(@)(@@) % قل بمنى إن أعارك الرشأ ال % % نافر سمعا أو قلت ما فهما % % 9(@)(@@) % تحصب يا رامي الجمار بها ال % % أرض فقلبي لم يشتك الألما % % 10(@)(@@) % نحاك قلب لا يحسن الصفح عن % % جرم ووجه لا يعرف الجرما % % PageV01P2200 11(@)(@@) % بأي دين لم تلو يوم منى % وأي دين عليك قد سلما % % 12(@)(@@) % كادت قريش ترتد جاهلة % لما تمثلت بينهم صنما % % 13(@)(@@) % أستخلف الله والضنا كبدا % % ضامنها ما وفى وما غرما % % 14(@)(@@) % يا لزماني على الحمى عجبا % % أي زمان مضى وأي حمى % % 15(@)(@@) % كان الهوى والشباب نعم القري % % نان وكان الشباب خيرهما % % 16(@)(@@) % يرمي بعيدا وإن أساء له % % دهري ففوادى منه ما سلما % % 17(@)(@@) % شب علي المشنيب بارقة % كان شبابي لنارها فحما % % 18(@)(@@) % لو صبغت بالبكاء ناصلة % دام شبابي مما بكيت دما % % 19(@)(@@) % قامت تألى ما 
ms702	 شاب من كبر % % خنساء برت وأكرمت قسما % % 20(@)(@@) % لا تسألي السن بالفتى وسلى ال % % هم وراء الضلوع والهمما % % PageV01P2201 21(@)(@@) % كم عثرة لي بالدهر لو عثر ال % % هلال طفلا بمثلها هرما % % 22(@)(@@) % ركوبي الدهم من نوائبه % % بدل شهبا من رأسي الدهما % % 23(@)(@@) % طال ارتكاضي أروم إدراك ما % % فات وأبغى وجدان ما عدما % % 24(@)(@@) % أنشد حظا في أرض مهلكة % تخبط عيني وراءه الظلما % % 25(@)(@@) % مقلقل الهم بين هل وعسى % % رجل المنى أو تسد بي الرجما % % 26(@)(@@) % إما تريني بعد اطرادي وتث % % قيفي بجنب الكعوب منحطما % % 27(@)(@@) % فالسيف لا يصدق الفضاء له % % بالعين إلا ما فل أو ثلما % % 28(@)(@@) % وإن تدبرت بعد بحبوحة ال % % عز محلا من الأذى أمما % % 29(@)(@@) % يبلغني إمرة الأمير وإن % % جار وحكم المولى وإن ظلما % % 30(@)(@@) % فالماء قد يسكن السحاب وين % % حط أوانا فيسكن الإرما % % PageV01P2202 31(@)(@@) % الله لي من أخ علقت به % % أوثق ما خلت حبله انجذما % % 32(@)(@@) % شد يديه على أعجف مع % % روقا وخلى عني أن التحما % % 33(@)(@@) % واصلني مصفر القضيب فمذ % رف عليه غصن الغنى صرما % % 34(@)(@@) % واعتاض عنى كل ابن دنيا أخي % % حرص يرى الغنم فضل ما طعما % % 35(@)(@@) % ينكص عند الجلى فإن أبصر ال % % جفنة ملآى استشاط فاقتحما % % 36(@)(@@) % لا ذو لسان يوم الندى ولا % % مقياس رأي إن حادث هجما % % 37(@)(@@) % مالك يا بائعي نقلت يدا % % تأكلها عند بيعتي ندما % % 38(@)(@@) % حلفت بالراقصات تجهد أع % % ناقا خفوضا وأظهرا سنما % % 39(@)(@@) % تحسب أشخاصها إذا اختلطت % بالأكم الوقص في الدجى أكما % % 40(@)(@@) % كل تروك بالقاع سقبا إذا % % لوت إليه خيشومها خرما % % PageV01P2203 41(@)(@@) % تحمل شعثا إذا هم ذكروا % % ذخيرة الأجر غالطوا السأما % % 42(@)(@@) % حتى أناخوا بذي الستور ملب % يين بأرض كادت تكون سما % % 43(@)(@@) % لأنجبت بطن حامل ولدت % محمدا وابن أمه الكرما % % 44(@)(@@) % يا أرض فخرا أخرجت مثلهما % % نعم تملى محسودة بهما % % 45(@)(@@) % واعتمدي منهما مباهلة % على عميد الكفاة فهو هما % % 46(@)(@@) % خير بنيك الفحول من سلم ال % % أمر له شيبهم وما فطما % % 47(@)(@@) % وهب مضمومة تمائمه % % بعد 
ms703	 وتسويده قد انتظما % % 48(@)(@@) % لم ينتظر بالوقار حنكته % رب حليم قد شارف الحلما % % 49(@)(@@) % ما زال يزرى بديهة بالرو % % يات وينسي حدثانه القدما % % 50(@)(@@) % حتى ظننا شبابه من وفو % % ر الرأي شيبا في وجهه كتما % % PageV01P2204 51(@)(@@) % أبلج يحذيك سافرا خلقة ال % % بدر وخيط الهلال ملتثما % % 52(@)(@@) % يدير في الخطب عين فتخاء لا % % تعرف إلا من كسبها الطعما % % 53(@)(@@) % لواحظ كلها نجوم إذا % % كانت لياليه كلها عتما % % 54(@)(@@) % يرمي بقلب وراء حاجته % % أصمع لا يستشير إن عزما % % 55(@)(@@) % لا يسرع القول في سكينته % % ولا ينزيه طارق غشما % % 56(@)(@@) % لو ركب العجز للعلوق به % % ناصية البأس لم يجد لقما % % 57(@)(@@) % سدوا به ثغرة من الملك لا % % ينهض منها بان بما هدما % % 58(@)(@@) % واسعة الفرج أعضلت زمنا % على الأواسي والداء ما حسما % % 59(@)(@@) % فقام حتى استقام مائدها % % باللطف لا عاجزا ولا برما % % 60(@)(@@) % لم يستعن ناصرا عليها ولم % % يخجل وحيدا فيها ولا احتشما % % PageV01P2205 61(@)(@@) % حتى لقد أصبحت وقرحها % % تعلك غيظا وراءه اللجما % % 62(@)(@@) % يقذى علاه مقصر لحز % لو قيد الفضل زيد فيه عمى % % 63(@)(@@) % لا تنطوي بنانه يبسا % % وعرضه لين إذا عجما % % 64(@)(@@) % يحسد منه نفسا سمت ويدا % إن نكص السيف أو غلت قدما % % 65(@)(@@) % يلقي علاطا على القراطيس لا % % يبرد عنق بنارها وسما % % 66(@)(@@) % يختم حر الرقاب عانية % ما فض من صحفها وما ختما % % 67(@)(@@) % عاد بها السرج يحسد الدست وال % % سيف وإن عز يخدم القلما % % 68(@)(@@) % نعم رعى الله للعلا راعيا % % تسلم أطرافها إذا سلما % % 69(@)(@@) % وزاد بشرا وجه إذا نضبت % أسرة البدر فاض أو فغما % % 70(@)(@@) % يشف فيه ماء الحياء فلو % % أرسل عنه اللثام لانسجما % % PageV01P2206 71(@)(@@) % من نفر لم تنم تراتهم % ولم يسم جارهم ولا اهتضما % % 72(@)(@@) % وافين حلما وضيقين إلى الس % % ائل عذرا ما اشتط واحتكما % % 73(@)(@@) % لا ينطقون الخنا ولا يثبت ال % % ماشى بشر اليهم قدما % % 74(@)(@@) % بيض المجاني خضر النعال مطا % % عيم إذا عام جوعة أزما % % 75(@)(@@) % تعودوا الفوز بالسيوف إذا % % تقادحوها مصقولة خذما % % 76(@)(@@) % إذا الوغى 
ms704	 أشمطت رءوس بني ال % % حرب فلوا بالصوارم اللمما % % 77(@)(@@) % كل غلام يرجى إذا اشتط غض % % بان ويخشى بكرا إذا ابتسما % % 78(@)(@@) % من آل عبد الرحيم قد وصل الل % ه لبيتيه بالعلا رحما % % 79(@)(@@) % بنت عليه قباب فارس أف % % لاكا رسى أصل عزها وسما % % 80(@)(@@) % مجد قدامى وخير مجديك ما اس % % تسلف صدر الزمان أو قدما % % PageV01P2207 81(@)(@@) % يا سرحة من ثمارها حسبي % % لا خفرتك البروق ذمة ما % % 82(@)(@@) % التف عيصي بعيصكم فغدا % % ودي خليطا بكم وملتحما % % 83(@)(@@) % حرمتموني على السؤال فما % % أحفل أعطي المسئول أو حرما % % 84(@)(@@) % وصار تربي الريان يضحك إن % % أبصر تربا يستسمح الديما % % 85(@)(@@) % فما أبالي أجار أم عدل ال % % رزق بأيمان غيركم قسما % % 86(@)(@@) % كنت جموحا على المطامع لا % % يلفت رأسي مال ثرى ونمى % % 87(@)(@@) % تحت رواق القنوع لو هجر الر % يق لثاتي لما شكوت ظما % % 88(@)(@@) % لا يطمع الدهر في رضاي ولا % % يسخطني إن آلام أو كرما % % 89(@)(@@) % وكل سام رام بهمته % يرى مديحي كما يرى العصما % % 90(@)(@@) % فرضتموني بألسن وبأخ % % لاق ليان أصبحن لي لجما % % PageV01P2208 91(@)(@@) % فكل راق منكم بنفثته % لم يبق منى بحبه صمما % % 92(@)(@@) % دربتموني يدا بأن أقبل الر % فد وأن أمدح الرجال فيما % % 93(@)(@@) % فسحتم في مضيق صدري وأف % % صحتم لساني من طول ما انعجما % % 94(@)(@@) % فمن جداكم عندي ونعمتكم % % أني تعلمت أشكر النعما % % 95(@)(@@) % وكلما آد دينكم عنقي % % قضيتكم عن فروضه الكلما % % 96(@)(@@) % كل شرود لا تشتكي عضة الد % هر إذا أنصبت ولا الخزما % % 97(@)(@@) % تجري بأوصافكم كما يقطع الس % يل بطن الوهاد والأطما % % 98(@)(@@) % في كل أرض لمجدكم علم % ونار مجد قد أركبت علما % % 99(@)(@@) % تنشر ما بين مشرق الشمس وال % % غرب رياحا لأرضكم فغما % % 100(@)(@@) % والشأن في أنها بواق على الد % هر إذا كان أهله رمما % % PageV01P2209 101(@)(@@) % ملأت فيكم بها الطروس وما % % تشكو كلالا يدي ولا سأما % % 102(@)(@@) % قد شرعت مذهبا لكم نسخ الش % عر على المحدثين والقدما % % 103(@)(@@) % لو نبشت عن صدى زهير زقا % % يحلف أن قد فضلتم 
ms705	 هرما % % 104(@)(@@) % فاقتبسوا من جلالها سير ال % % أمثال فيكم وطالعوا الحكما % % 105(@)(@@) % أو لا تبالوا إذا هي انعطفت % % لكم بشعر إن صد أو صرما % % 106(@)(@@) % راعوا لها حرمة التقدم وال % % ود وضموا أسبابها القدما % % 107(@)(@@) % ووفروا حظها لمجتهد % أكد فيها الحقوق والذمما % % 108(@)(@@) % مستبصر القلب واللسان فما % % يقول فيكم إلا بما علما % % 109(@)(@@) % عقدكم لي أصح من أن يرى الن % % اس بحالي في ملككم سقما % % PageV01P2210 البحر : - 1(@)(@@) % مالك لا تطرب يا حادي النعم % أما سمعت قول خنساء نعم % % 2(@)(@@) % أصخرة قلبك أم أنت عصا % لا تنثني أم بك وقر من صمم % 3(@)(@@) % عد برذاياك الطلاح بدنا % % وراخ من حبلها وارع ونم % 4(@)(@@) % قد أنست خنساء شيئا وارعوى % % نفارها ووصلت بعد الصرم % 5(@)(@@) % وقد تحدثنا على كاظمة % بنافث السحر حديث ذي سلم % 6(@)(@@) % تذكرة من الهوى وسره % نام العدا ونم عنها ما كتم % 7(@)(@@) % وليلة صابحة ما تركت % يقظتها للعين حظا في الحلم % 8(@)(@@) % بتنا نغني بالعتاب ووفت % بسكرنا أوعية العذب الشبم % 9(@)(@@) % وسفرت عن الوفاء أوجه % نواعم بالغدر كانت تلتثم % 10(@)(@@) % يا حبذا ليل الغضا وطوله % % تمت لنا أقماره ولم تتم % PageV01P2211 11(@)(@@) % وخلس من لذة ما نقعت % % كل الصدى ولا شفت كل القرم % 12(@)(@@) % من لي بيوم الوصل أو ساعته % % لو دام لي بحاجر ما لم يدم % % 13(@)(@@) % أبارق على الحمى أم شارق % أم شمت من صبابتي ما لم تشم % 14(@)(@@) % يا صاحبي لو شئت لعلمت لي % % من موقد النار على رأسي العلم % 15(@)(@@) % وهل أثيلات الغضا كعهدنا % % ظلائل تضفو وسوق تلتحم % 16(@)(@@) % أنت ابن عزم الليل إن صحبتني % % على تباريح الكلال والسأم % 17(@)(@@) % وإن ركبت خطر البيد معي % % ركوب من لا يستشير إن عزم % 18(@)(@@) % كم القعود تحت أدراج الأذى % % فرصة من ضام ونهب من ظلم % 19(@)(@@) % تعد كل راحة قناعة % وفي القنوع راحة ما لم تضم % 20(@)(@@) % اهجم على الأمر إذا اتقيته % % وقم إذا قالت لك العلياء قم % PageV01P2212 21(@)(@@) % ولا تقلم ظفريك رابضا % % إن الليوث أسراء في الأجم 
ms706	 % 22(@)(@@) % إن لؤم الشق الذي تحله % % فمل إلى شق الوفاء والكرم % 23(@)(@@) % قد وضح الفجر فأي عذرة % لابن السرى في خبط عشواء الظلم % 24(@)(@@) % وعدلت كف أبي القاسم في ال % % جود لا تحفل بجور من قسم % 25(@)(@@) % بالصاحب استذرت إلى ظلالها % % شتائت الفضل وشذان الكلم % 26(@)(@@) % ونشل المجد التليد نفسه % % منتصرا من كف كل مهتضم % 27(@)(@@) % وقر كل قلق لرزقه % % وقام ميت الجود من تحت الرجم % 28(@)(@@) % وانشعبت فلائق مصدوعة % % في الملك ما كانت فطورا تلتئم % 29(@)(@@) % أبلج تلقى البدر منه حادرا % فضل اللثام والهلال ملتثم % 30(@)(@@) % مبارك الشيمة يورى وجهه % % في الحادثات قبسا وهي عتم % % PageV01P2213 31(@)(@@) % يهدي لأبناء السؤال بشره % نخبة ما تهدي إلى الروض الديم % 32(@)(@@) % توعد اللوام في الجود فلو % % جاد بما خلف الضلوع لم يلم % 33(@)(@@) % كأنما عاذله على الجدا % % مجتهد يحثو على النار الفحم % 34(@)(@@) % قال له العافون قل مالي سدى % فقالها ولم يقل كيف ولم % 35(@)(@@) % لم يعترق بنانه ندامة % % على الندى ولا ندى مع الندم % 36(@)(@@) % كم دولة قيد به ريضها % % ونعمة شبت على رأس الهرم % 37(@)(@@) % قد عاهدوه فوفى وعالجوا % % برأيه الداء العضال فحسم % 38(@)(@@) % وجربوه فارسا وجالسا % % يوم الوغى ويوم يلقون السلم % 39(@)(@@) % أنصحهم جيبا وأمضاهم شبا % والسيف ناب والشقيق متهم % 40(@)(@@) % تحلم الدهر على تدبيره % % والدهر ممسوس به جن اللمم % PageV01P2214 41(@)(@@) % وجمع الأمر الشعاع حزمه % % وأضلع الخيل يقطعن الحزم % 42(@)(@@) % أملس أنبوب الفخار لم تشن % قناته معرة ولم تصم % 43(@)(@@) % من طينة بيضاء صفي مجدها % % تنخل الدهر وتصفيق القدم % 44(@)(@@) % مشى بنوها فوق هامات العلا % % وسبقوا بالفضل أسلاف الأمم % 45(@)(@@) % بيت على الثروة لولا عزه % % ما دانت العرب قديما للعجم % 46(@)(@@) % أعلام هذي الأرض فيهم وبهم % % جرية هذا الماء والنار لهم % 47(@)(@@) % يفديك يا بن الأكرمين وادع % لا تتصباه عليات الهمم % 48(@)(@@) % راض من الهون ومن عجز المنى % % بما اكتسى منتفحا وما طعم % 49(@)(@@) % يعجبه اسم ليس من ورائه % معنى إذا ما هو بالعليا وسم % 50(@)(@@) % لم يدر من أين 
ms707	 أتى سؤدده % % فهو غريب الوجه فيه محتشم % PageV01P2215 51(@)(@@) % رامك بغيا ورماك حسدا % % فعاد غرب السهم من حيث نجم % 52(@)(@@) % أيقظ منك الصل ثم هومت % عيناه يستجدي علالات الحلم % 53(@)(@@) % ومد باعا لا ذراع فوقها % % ولا بنان ليباريك رغم % 54(@)(@@) % فانظر إليه واقعا بجنبه % % مصارع الغدر وعثرات الندم % 55(@)(@@) % يعلم أن لو سلمت ضلوعه % % منك من الغل لقد كان سلم % 56(@)(@@) % لا نفرت عنك الليالي نعمة % وطالما آنست وحشي النعم % 57(@)(@@) % ولا وجدت من عدو فرصة % إلا عفوت ولو اشتد الجرم % 58(@)(@@) % وطلع النيروز بسعوده % % عليك جذلان إليك مبتسم % 59(@)(@@) % رسول ألف مثله يضمن أن % % يوفيك الأعداد منها ويتم % 60(@)(@@) % يوم أتى في الوافدين قائما % % مع القيام خادما بين الخدم % PageV01P2216 61(@)(@@) % فاقبله واردده إلى موفده % % مكرما قد فاز منك وغيم % 62(@)(@@) % عقدت حبلي مذ عرفت رشدي % % بكم فما خان يدي ولا انفصم % 63(@)(@@) % وعشت فيكم شطر عمري باسطا % % يد الغنى أدفع في صدر العدم % 64(@)(@@) % لا تطمع الأيام في تهضمي % % ولا أخاف زمني ولو عرم % 65(@)(@@) % وكنت أنت ناشلي ورافعي % % من خفضة الحال إلى العز الأشم % 66(@)(@@) % وغارسي من قبل أن تمسني % % يد وساقى غصني قبل الديم % 67(@)(@@) % وخاطبا من فكري كرائما % % تبذل في مهورها أغلى القيم % 68(@)(@@) % كل فتاة عندها شبابها % % وعندكم مفضوض ما منها ختم % 69(@)(@@) % لم يكتب الراقي لها عطفا ولم % % تعقد لها خوفا من الغدر الرتم % 70(@)(@@) % قد ملأت بوصفكم عرض الفلا % % وطبقت أقاصى الدنيا بكم % PageV01P2217 71(@)(@@) % منحتكم فيها صفايا مهجتي % % جهد زهير قيل في مدح هرم % 72(@)(@@) % فلا نضع تلك الحقوق بينكم % % ولا تخب عندكم تلك الذمم % % 73(@)(@@) % ولا تحلوا بسواكم حاجتي % % وكل رزق في ذراكم يقتسم % 74(@)(@@) % ضموا إليكم طرفي إنه % % لا يطرد العار بمثل أن أضم % 75(@)(@@) % وحرموا صيدى أن يقنصني % % سواكم صون الحمام في الحرم % % 76(@)(@@) % واحتفظوا بي إنني بقية % تمضي فلا يخلفها الدهر لكم % PageV01P2218 البحر : - 1(@)(@@) % ظن غداة الخيف أن قد سلما % % لما رأى سهما وما أجرى دما % % 2(@)(@@) % فعاد يستقري حشاه 
ms708	 فإذا % % فؤاده من بينها قد عدما % % 3(@)(@@) % لم يدر من أين أصيب قلبه % % وإنما الرامي درى كيف رمى % % 4(@)(@@) % يا قاتل الله العيون خلقت % جوارحا فكيف صارت أسهما % % 5(@)(@@) % وراميا لم يتحرج من دمي % % مقتنصا كيف استحل الحرما % % 6(@)(@@) % أودعني السقم ومر هازئا % % يقول قم فاستشف ماء زمزما % % 7(@)(@@) % ولو أباح ما حمى من ريقه % % لكان أشفى لي من الماء اللمى % % 8(@)(@@) % يا بأبي ومن يبيع بأبى % % على الظما ذاك الزلال الشبما % % 9(@)(@@) % كأنما الصهباء في كافوره % % سحرية وجل عن كأنما % % 10(@)(@@) % يا نافض البطحاء يبغى خبرا % % إن هو أداه إلي غنما % % PageV01P2219 11(@)(@@) % سل بانة الوادي إذا تأودت % % عن ظبية من القضيب منهما % % 12(@)(@@) % وأين سكانالحمى من ولهي % % بعدهم سقيا لسكان الحمى % % 13(@)(@@) % توهموا أن الفراق سلوة % عنهم فلا أحللت من توهما % % 14(@)(@@) % وأن عيني ملئت من غيرهم % % إذ منعوا إذن رأت عيني العمى % % 15(@)(@@) % قالوا توخ الأجر واصبر طامعا % % والحظ في الهيفاء مع من أثما % % 16(@)(@@) % لام ولا يعلم فيها ناصح % مجتهد أغرى بها لو علما % % 17(@)(@@) % قال اكن عنها فاسمها علامة % رضيت فيها أن أكون علما % % 18(@)(@@) % اضمم يدا على الحبيب ما وفى % % ضميره واصل أو تصرما % % 19(@)(@@) % ولا تدع حلة يوم لغد % يأتي بأخرى فالهوى ما قدما % % 20(@)(@@) % قد غمز الدهر بنابيه على % % عودي فلا خر ولا تحطما % % PageV01P2220 21(@)(@@) % وفرني ريب الزمان قارحا % % وجذعا فما أطعت اللجما % % 22(@)(@@) % يحكم في حظي ما شاء فإن % % مر بعرضي لم أكن محكما % % 23(@)(@@) % لم تأكل الأيام وفري عسلا % % إلا رأت مضغة لحمي علقما % % 24(@)(@@) % حملت مجبوب الجنوب ظالعا % % منها الذي أعيى الجلال المقرما % % 25(@)(@@) % إذا أتى اليوم بشر عابس % لقيته منافقا مبتسما % % 26(@)(@@) % خبرت حظي فسواء سفه ال % % دهر علي عامدا أو حلما % % 27(@)(@@) % وكيف يرجى النصف من محكم % % يعرف إلا العدل فيما قسما % % 28(@)(@@) % ومن كريم الصبر عندي أسوة % بمعشر يعلمون الكرما % % 29(@)(@@) % هم طرقوا بسودها وحمرها % % نوائبا خرسا وخطبا أعجما % % 30(@)(@@) % فلم يكن للريح وهي عاصف % % أن تستلين 
ms709	 منكبي يلملما % % PageV01P2221 31(@)(@@) % تسربلوا الحزم لها واتخذوا % % فيها العزاء للعلاء سلما % % 32(@)(@@) % وأقبلوها أوجها بائحة % % بالبشر فيها ونفوسا كتما % % 33(@)(@@) % حتى رأى الأعداء فيما سلبوا % % من نعم أن قد أفيدوا أنعما % % 34(@)(@@) % أسرة مجد لا يرون فائتا % % من وفرهم والعرض باق مغرما % % 35(@)(@@) % كأن ما ينقص من أعدادهم % % ومالهم زيدهم وتمما % % 36(@)(@@) % إن مات منهم سيد قام له % % منهم شبول يخلفون الضيغما % % 37(@)(@@) % تزاحموا على العلا واقترعوا % % على الندى فانتصفوه أسهما % % 38(@)(@@) % وارتكضوا يجنبون الأسد في ال % % غابات أو يبخلون الديما % % 39(@)(@@) % كل غلام ذاهب بنفسه % % حيث مضى المجد به ويمما % % 40(@)(@@) % إذا أبى طارت به حمية % علوية أقرب برجيها السما % % PageV01P2222 41(@)(@@) % فإن خبت شمس نهار منهم % غطوا الدجى أهلة وأنجما % % 42(@)(@@) % أراكة عبد الرحيم عرقها % % ثم زكى الفرع الكريم ونمى % % 43(@)(@@) % وكان من ثمارها لما علت % % أبو المعالي مورقا ومطعما % % 44(@)(@@) % كان فتاها مرضعا وكهلها % % مثغرا وشيخها محتلما % % 45(@)(@@) % وتاجها المعصوب وسوارها % % إن رفعت رأسا ومدت معصما % % 46(@)(@@) % صبا لأصوات العفاة سمعه % % كأنما يؤنس منها نغما % % 47(@)(@@) % واستصغروا الدنيا فلو جاد بها % % موهوبة لم يعتقبها ندما % % 48(@)(@@) % أوجع من ضم على جمر الغضا % % في حسه كف تضم درهما % % 49(@)(@@) % تعلم النسيم من أخلاقه % % حتى صفا والغيث حتى كرما % % 50(@)(@@) % لو أسخطتك يده وحوشيت % أرضاك أو زادك وجها وفما % % PageV01P2223 51(@)(@@) % إذا افتقدت نصره لغاية % داس لها النار وخاض الفحما % % 52(@)(@@) % لله أنت مقبلا على الندى % % بوجهه والدهر قد تجهما % % 53(@)(@@) % وقائما فداعما بيده % % ماثل من عرش العلا وهدما % % 54(@)(@@) % أجدبت الحال فلم تأس غنى % نفس أكنت واجدا أو معدما % % 55(@)(@@) % أو لم تسع مالا فأوسعت به % % بشرا فكنت مانعا ومنعما % % 56(@)(@@) % وخبثت سرائر فلم تكن % % لله في تدبيره متهما % % 57(@)(@@) % لا جرما وإن ذوت دولتكم % % لترجعن غضة لا جرما % % 58(@)(@@) % لا بد أن يجمع حظ شارد % ضل وان يقلع دهر أجرما % % 59(@)(@@) % وأن تحن نعمة قد فارقت % أوطانها حتى تعود أنعما % % 60(@)(@@) % إذا سلمتم أنفسا وحسبا % % فقد سلمتم نشبا ونعما 
ms710	 % % PageV01P2224 61(@)(@@) % فإن أصاب فرصة بشمته % عدوكم فطالما قد رغما % % 62(@)(@@) % توقعوا عود إياب عزكم % % وليتوقع غيظه المضرما % % 63(@)(@@) % كأنني من خلل الغيب أرى % % شمس الضحى تفتق هذي الظلما % % 64(@)(@@) % عيافة ما كذبتني فيكم % قط ولا زجرت منها أشأما % % 65(@)(@@) % وواعد من الأماني لم يكن % % خالا ولا ضاغثت منه حلما % % 66(@)(@@) % فاسمع لها بشارة من صادق % صح على السبر لكم وسلما % % 67(@)(@@) % لم يزو وجها عنكم وقد هفا ال % % دهر بكم ولا أزل قدما % % 68(@)(@@) % ولا ونى مكاشفا عدوكم % % بمدحكم مع كونه محتشما % % 69(@)(@@) % لا يرهب القاهر من سلطانه % % ولا يبالي سيفه المنتقما % % 70(@)(@@) % وكيف أخشى الأمر والله معي % % يعلم أنى فيه أرعى الذمما % % PageV01P2225 71(@)(@@) % وحرة من الكلام سهلة % % ليست على كل فم تكلما % % 72(@)(@@) % يحذر منها العصم فرط خدعي % % يا للرجال من يحط العصما % % 73(@)(@@) % أشقى بمعناها ويحظى معشر % ينتحلون اسما لها مقتسما % % 74(@)(@@) % هل نافع لي حسن إفصاحي بها % % إذا غدا حظي بها مجمجما % % 75(@)(@@) % جاءتك في حبيرة تسحبها % % سحب اليماني برده المسهما % % 76(@)(@@) % فاجتليها كما اجتليت قبلها % % بكرا فضضت عذرها وأيما % % 77(@)(@@) % يلقاك وجه المهرجان سافرا % % عنها ويلق معشرا ملثما % % 78(@)(@@) % واسلم لألف مثلها في مثله % % تعدها مواليا منتظما % % PageV01P2226 البحر : - 1(@)(@@) % انظر معي فهي نظرة أمم % أعلم السفح ذلك العلم % 2(@)(@@) % أنت برئ مما تشبه ال % % عين وطرفي بالدمع متهم % 3(@)(@@) % يطربني اليوم للمنازل ما % % أسأر عندي أيامها القدم % 4(@)(@@) % ويطبيني على فصاحة شك % % واي إليها ربوعها العجم % 5(@)(@@) % علي يا دار جهد عيني وما % % علي عار أن تبخل الديم % 6(@)(@@) % لك الرضا من جمام أدمعها % % وذمها إن سقى ثراك دم % 7(@)(@@) % أما وعهد الغادين عنك وأش % % جان بواق لي فيك بعدهم % 8(@)(@@) % وما أطال الصبا وأعرض من % % عيش كأن اختلاسه حلم % 9(@)(@@) % وسر حب قد سار عندك في % % أمانة الترب وهو منكتم % 10(@)(@@) % ما كان ما قاله المسرون عن % % ريم وعنى إلا كما زعموا % % PageV01P2227 11(@)(@@) % هل هو إلا أن قيل جن بها % % نعم على كل ما جنت 
ms711	 نعم % 12(@)(@@) % كفى بلوم العذال أنهم % عابوا فقالوا بضد ما علموا % % 13(@)(@@) % وأن شق العصا لهم ولها % % طاعة قلبي تقضي وتحتكم % 14(@)(@@) % ليت الذي لام في الغرام بها % % مكان داست من نعلها القدم % 15(@)(@@) % آه لبرق بجنب كاظمة % هب فقالوا هيفاء تبتسم % 16(@)(@@) % وطارق زار يركب الشقة ال % % طولى وليلي بحاجر فحم % 17(@)(@@) % يستكتم الليل وجهه وسرى ال % % أقمار مما لا تكتم الظلم % 18(@)(@@) % فكان منى مكان يرتقب ال % % خليع تحت الدجى ويحتشم % 19(@)(@@) % بتنا وأطواقنا يد ويد % ورسل أشواقنا فم وفم % 20(@)(@@) % يلفني الغصن أو تضاجعني ال % % دمية أجني طورا وألتزم % PageV01P2228 21(@)(@@) % حتى إذا الفجر كان خيطين أو % % كادت عقود الجوزاء تنفصم % 22(@)(@@) % غارت على أختها الغزالة فاس % % تيقظت لا بانة ولا صنم % 23(@)(@@) % عاد من الدهر مرة إن وفا % % خان وإن من عاد ينتقم % 24(@)(@@) % ما أشبه الناس بالزمان وما % % أقل فرقا بالغدر بينهم % 25(@)(@@) % كنت ألوم الإخوان شيئا إذا ال % % تاثوا وأشكوهم إذا صرموا % % 26(@)(@@) % وأحسب البخل والسماحة لي % % غاية ما العقوق عندهم % 27(@)(@@) % فاليوم لثمى في ظهر كل يد % ليس دمي من بنانها العنم % 28(@)(@@) % يا دين قلبي من مالكين له % % بالود حلف الشقاء عبدهم % 29(@)(@@) % يحفظهم خائنين عهدي ودا % % نين وفي وجدهم وإن عدموا % % 30(@)(@@) % وهم جفاء علي أفئدة % صخر وجور صرف إذا قسموا % % PageV01P2229 31(@)(@@) % لا نوب الدهر حين تطرقهم % % تنصفني منهم ولا النعم % 32(@)(@@) % عندهم الغدر بي على القل وال % % كثر وعندي الوفاء والكرم % 33(@)(@@) % لي بعضهم غير خالص ولمن % % دامجهم خالصين كلهم % 34(@)(@@) % بين فؤادي فيهم وبين فمي % % شواجر في الحفاظ تختصم % 35(@)(@@) % فالقلب فيهم خال من الذم وال % % يعتب عليهم في يزدحم % 36(@)(@@) % يا رب هب لي يقظان منهم إذا % % ناموا وعدلا في الود إن ظلموا % % 37(@)(@@) % واسمح لنفسي بحفظ نفسابن أ % % يوب فما ذاك في الإخاء هم % 38(@)(@@) % أبلج خاضت بي الدجى غرة % منه وداست بي العلا قدم % 39(@)(@@) % بر وحظي المقسوم لي من بني % % أمى عقوق ومن أبي يتم % 40 
ms712	(@)(@@) % فاستنصرته لي العلا فوفت % كف يمين وصارم خذم % PageV01P2230 41(@)(@@) % وقام دوني لا عامل الرمح مر % % دود ولا السابري منحطم % 42(@)(@@) % تأبى له نفسه وطينته % % أن يتقاضى أو تخفر الذمم % 43(@)(@@) % وشيمة حرة مضى معها % % والمرء حيث ارتمت به الشيم % 44(@)(@@) % لا طائش الحلم إن هفا الطيش بال % % ناس ولا ضيق إذا برموا % % 45(@)(@@) % من معشر يشكرون إن رزقوا % % أو يحسنون الظنون إن حرموا % % 46(@)(@@) % قروم دنيا يغشون شدتها % % مساكنا لا تلينها القحم % 47(@)(@@) % كل عتيق البزول ملتحم ال % % جلبة تعيا برأسه الخطم % 48(@)(@@) % لا يملك الرحل أكل غاربه % ولا يعفي أوباره الجلم % 49(@)(@@) % شادوا على مجدهم بيوتهم % وما بنى المجد ليس ينهدم % 50(@)(@@) % لا عطلت منك سبل سؤددهم % % تنهج آثارها وتلتقم % PageV01P2231 51(@)(@@) % ولا عدمت الفضل الذي شهدت % لك العلا فيه أنك ابنهم % 52(@)(@@) % واستقبلتك الأيام تجبر من % % جراحها سالفا وتلتحم % 53(@)(@@) % تسفر عن أوجه السعود التي % % كانت حياء بالأمس تلتثم % 54(@)(@@) % يشفع في ذنبها إلى عفوك الن % يروز فاصفح وإن طغى الجرم % 55(@)(@@) % فاقبل ضماني فإنها لك بع % % د اليوم فيما ترومه خدم % 56(@)(@@) % واسمع على الاختصار طارقة % لها طوالا سوالف قدم % 57(@)(@@) % أخرها الدهر عن بلوغ مدا % % هن وهم ماتت له الهمم % 58(@)(@@) % ونوب تلجم الفؤاد إذا ال % % ألسن كفت غروبها اللجم % 59(@)(@@) % والقول يجنى من القلوب فإن % % غاض دم القلب صوح الكلم % PageV01P2232 البحر : - 1(@)(@@) % يلوم عليك لا عدم الملامه % صحيح القلب غرته السلامه % 2(@)(@@) % أبى لؤم الطباع له ولوعا % % بمثلك أو ضلوعا مستهامه % 3(@)(@@) % ولم تنبله باللحظات عين % ولم تطعنه بالخطرات قامه % 4(@)(@@) % ولا ماتت له نفس وعاشت % % مرارا بالرحيل وبالإقامه % 5(@)(@@) % وما يدريه ما نزوات صدري % % إليك وما الذي استدعى غرامه % 6(@)(@@) % وما سر ملكت قياد قلبي % % به فمضيت آخذة زمامه % 7(@)(@@) % وهل وصلفتك أعجاز الليالي ال % % طوال له أعواد البشامه % 8(@)(@@) % وأوسعه الإهانة ثم يفضي % % إلى اسمك بي فأوسعه الكرامه % 9(@)(@@) % سقى عهد الطويلع ما تمنى % % زمان أن تصوب له غمامه % 10(@)(@@) % وعيشا بالجريب وأي عيش 
ms713	 % % وددت وما انقضى لو كنت هامه % PageV01P2233 11(@)(@@) % وليلا بدره لم ينض عشرا % % غرمت وقد سفرت لنا تمامه % 12(@)(@@) % وليت ونابل الأيام رام % يصيب بنا المنى أيام رامه % % 13(@)(@@) % أسائل بان دومة عن فؤادي % % وقد أودعته سمر اليمامه % 14(@)(@@) % وكيف بمهجة أمست بنجد % مضللة وتنشد في تهامه % 15(@)(@@) % من الساري تجد به بنجد % أضاليل السرى عقب السآمه % 16(@)(@@) % إذا وخزتك أنفاس الخزامى % % فهب لنا ابن ليل كان نامه % 17(@)(@@) % فخذ حد الأثيلوقل سلام % على بيت عقيلته سلامه % % 18(@)(@@) % وما الظبيات سارحة وربضا % % ولا الأغصان ميلا واستقامه % 19(@)(@@) % بمن أعنى الكنى عنه ولكن % % بكل من محاسنها علامه % 20(@)(@@) % أمنها والكواكب جاثمات % خيال لم يمتعنا لمامه % PageV01P2234 21(@)(@@) % سرت والشهر قد أرمى ثلاثا % % على العشرين خائضة ظلامه % 22(@)(@@) % على غرر وساعة لا طروق % ألا ما للجبان وللصرامه % 23(@)(@@) % فحيت واقعين على الولايا % % نشاوى لم تنشهم المدامه % 24(@)(@@) % فواقا ثم طار الصبح منها % % مجفلة بقادمتي نعامه % 25(@)(@@) % تقول خف الوشاة وإن ألموا % % بفاطمة فقل طرقت أمامه % 26(@)(@@) % ومن لي أن يتم غدا جحود % وحولي من عتيرتها قسامه % 27(@)(@@) % ألا هل رقية من مس دهر % خفي الكيد شيطان العرامه % 28(@)(@@) % يخاتلني الزمان فلست أدري % % بأي جوانبي أنفى سهامه % 29(@)(@@) % وحظ لو سألت بلال ريقى % % عباب البحر صاعبني مرامه % 30(@)(@@) % يريد الرزق أن أدلى عليه % % بذل أو يقال الحرص ضامه % PageV01P2235 31(@)(@@) % وليست قطرة من ماء وجهي % % حرى أن أستدر بها جمامه % 32(@)(@@) % وأعذل في القناعة أن حبتني % % وباعتني الضئولة بالوسامه % 33(@)(@@) % وكم ذي شارة معناه رث % وأشعث بين طمريه أسامه % 34(@)(@@) % سيغشم قائد الأطماع عنقي % % بأنف لا يلين على الخزامه % 35(@)(@@) % وينصرني وإن ضعف اصطباري % % وقد تحمى البنانة بالقلامه % 36(@)(@@) % وأروع لا يحل الخطب منه % % معاقد حبوتيه ولا اعتزامه % 37(@)(@@) % صليب العود يغمز جنب رضوى % % ولم تدرك غوامزه العجامه % 38(@)(@@) % إذا ضاقت رحاب الرأى جاءت % % بصيرته ففرجت ازدحامه % 39(@)(@@) % تريه عواقب الأمر المبادي % % ويبصر ماوراء غد أمامه % 40(@)(@@) % وقور لم يخض لغوا بفيه % % ولم يسدل على غزل 
ms714	 قرامه % PageV01P2236 41(@)(@@) % تحمله فينهض مستمرا % مليا بالحمالة والغرامه % 42(@)(@@) % إذا نكص الرجال مضى جريا % كأن مميل أقوام أقامه % 43(@)(@@) % أغر ترى الهلال يتم بدرا % % إذا أبصرت منحدرا لثامه % 44(@)(@@) % تود كواكب الجوزاء لو ما % % تكون إذا امتطى سرجا لجامه % 45(@)(@@) % وإن ركب السرير وزير ملك % % رأيت التاج تشرفه العمامه % 46(@)(@@) % ومبهمة مذكرة زبون % تخال شرار جاحمها ضرامه % 47(@)(@@) % ملبدة الجوانب أم نقع % % ترى البيضاء منها مستضامه % 48(@)(@@) % يحاذرها الحمام إذا تداعت % % بها الأبطال تحسبها حمامه % 49(@)(@@) % كفاها غير معتقل قناه % % ولا متسربل حلقات لامه % 50(@)(@@) % يشيم لحسمها قلما نحيلا % % سمين الخطب تحسبه حسامه % PageV01P2237 51(@)(@@) % يناط الملك من شرف المعالي % % بمندمج القوى ثبت الدعامه % 52(@)(@@) % كلوء العين يحمي جانبيه % % إذا ذعرت مشللة سوامه % 53(@)(@@) % تكفله فتى يفعا وكهلا % % وفي الودعات لم يبلغ فطامه % 54(@)(@@) % فلم يسلم لخابطة جناه % % ولم يترك لخائطة نظامه % 55(@)(@@) % وكان متى تعبه بدار صيد % بنائقه يحل بها حرامه % 56(@)(@@) % دعا الكافي الخطير لها فلبى % % أزل يشد للجلى حزامه % 57(@)(@@) % سألت فما حلبت به بكيا % % ولا استمطرت صائفة جهامه % 58(@)(@@) % ولكن جادمحلول العزالى % % إذا بدأ الحيا أدلت عصامه % 59(@)(@@) % كريم البشر تحسب وجنتيه % % سماء الجود والبرق ابتسامه % 60(@)(@@) % إذا ما شاء أن يغريه يوما % % بفرط البذل من يغريه لامه % PageV01P2238 61(@)(@@) % يزيد الغمط نعمته سبوغا % % ويقبل حبه العفو انتقامه % 62(@)(@@) % ينيلك وهو أصفر منك كفا % كساقي الماء واستبقى أوامه % 63(@)(@@) % على دين الأكارم وهو خرق % % يعد الحمد أولى ما استدامه % 64(@)(@@) % وحب الذكر خلى الذكر عند الس % موءل والندى عند ابن مامه % 65(@)(@@) % غرست بعقوتي نعما رطابا % % مجانيها بشكري مستدامه % 66(@)(@@) % ووسع لي مديحك فضل صيت % % ووصفك لي وبرك بالكرامه % 67(@)(@@) % ولم تترك بعدل علاك بيني % % وبين صروف أيامي ظلامه % 68(@)(@@) % فصن غرسا إذا لم يجز فعلا % % على نعمى جزاك بها كلامه % 69(@)(@@) % بكل بعيدة المسرى رفوع % وهاد القول خافضة إكامه % 70(@)(@@) % تحلق حين أرسلها فتمسي % % رديف النجم سائمة مسامه % PageV01P2239 71(@)(@@) % تبين بها عيوب الناس حتى % % تخال على جبين 
ms715	 الشعر شامه % 72(@)(@@) % لو ان لذي القروح البيت منها % % لسر ضريحه وسقى عظامه % 73(@)(@@) % لها وسم على الأعراض باق % بقاء الطوق في عنق الحمامه % 74(@)(@@) % تحلى صبحة النيروز منها % % بعقد لا ترى الدهر انفصامه % 75(@)(@@) % مبشرة بأنك ألف عام % % ستدركه كما أدركت عامه % 76(@)(@@) % رحيب الملك ضخم العز صعبا % % ذراك إن امرؤ بالبغى رامه % 77(@)(@@) % بقاء ما له أمد فيخشى % % عليه قاطع إلا القيامه % PageV01P2240 البحر : - 1(@)(@@) % من مبلغ عنى وإن تعذرت % % عوفا وجارت بي في أحكامها % % 2(@)(@@) % ومنعتني النصف وهو دينها % % وبذلها من غير ما إعدامها % % 3(@)(@@) % وطرحت بين منابذ الحصى % % عهدي على المحفوظ من ذمامها % % 4(@)(@@) % حيث اطمأن الملك في قبابها % % وضفت الدنيا على خيامها % % 5(@)(@@) % وعلقت من أمرها ونهيها % % بذروة العلياء أو سنامها % % 6(@)(@@) % لاتتعدى حكمها قبيلة % ولا نعديها إلى أحكامها % % 7(@)(@@) % ألوكة إن سمع المجد بها % % قام وكيلا لي في خصامها % % 8(@)(@@) % وخجلت منها أسرة الندى % % فردت المحدور من لثامها % % 9(@)(@@) % أبعد أن أرسلتها دوافعا % % ينثال حشد السيل في ازدحامها % % 10(@)(@@) % قاطعة بمدحكم عرض الفلا % % بين مهاويها إلى آكامها % % PageV01P2241 11(@)(@@) % معلوطة بذكركم وسومها % % في الخيل والإبل على وسامها % % 12(@)(@@) % في سلمكم تتلى على كؤسكم % % والحرب بين بيضها ولامها % % 13(@)(@@) % كل لسان أفصحت بشكره % % أوابد القول على إعجامها % % 14(@)(@@) % تسركم وللعدا من غيظها % % ما يؤلم الأطراف باصطلامها % % 15(@)(@@) % لم يسمعوا لمجدكم بمثلها % % في سالف الدنيا ولا قدامها % % 16(@)(@@) % تحسدكم فيها وتستغربها % % ألسنة ما درن في كلامها % % 17(@)(@@) % نبا بأيديكم مضاء حدها % % وطاش ما ريشت من سهامها % % 18(@)(@@) % ورجعت قهقرة أبياتها % % تبكي أياماها على أيتامها % % 19(@)(@@) % أحللتم بغير مهر بضعها % % ظلما وإصرارا على حرامها % % 20(@)(@@) % أبلغ بما أرعتك من أسماعها % % عطفا وما أولتك من أفهامها % % PageV01P2242 21(@)(@@) % فإن لوت صدا فقل لبحرها % % والقمر المشتق من غمامها % % 22(@)(@@) % قف وسط ناديها فحي قائما % % حبا وإعظاما أبا قوامها % % 23(@)(@@) % رسالة من كلف بوده % % متيم الأشواق مستهامها % % 24(@)(@@) % راض عن الإعراض والوصل به % % وفي انطلاق الكف وانضمامها % % 25(@)(@@) % وشاكر ديمته إن مطرت % ليومها 
ms716	 أو مطلت بعامها % % 26(@)(@@) % عن ثقة أن حبال عهده % لفاتل لم يأل في إبرامها % % 27(@)(@@) % وأنه إن بسط الأيام لي % % وعدا فللضيقة واحتشامها % % 28(@)(@@) % أو فاتت اليوم نطاف جوده % % فلي غدا ما شئت من جمامها % % 29(@)(@@) % وأن دين الشعر في ذمته % % شريعة يدين بالتزامها % % 30(@)(@@) % أما حماه أسد وصيدها % % فقد عرفت الشم من أعلامها % % PageV01P2243 31(@)(@@) % قمت لها مواقفا تبصر ما % % تعده السيرة من أيامها % % 32(@)(@@) % وأبصرت ماخط من أشياخها % % بأسا وحلما منك في غلامها % % 33(@)(@@) % إن وهبت كنت عباب بحرها % % أو رهبت كنت شبا حسامها % % 34(@)(@@) % أو طلبت في الجو بك غاية % جعلتها تحت ثرى أقدامها % % 35(@)(@@) % طلعت شمسا لصباح مزيد % وكوكبا يوقد في ظلامها % % 36(@)(@@) % إن غمست في كرم أيديها % % حسرت والأكف في أكمامها % % 37(@)(@@) % أو قصرت بوع قناها نطتها % % بساعد يذرع في تمامها % % 38(@)(@@) % أو دفعتك حسدا عن سؤدد % وقطعت وصلت من أرحامها % % 39(@)(@@) % إن مقاما حايدوك دونه % % خامدة لا بد من ضرامها % % 40(@)(@@) % إن قعدت عنك المقادير بها % % فهي التي تنهض في قيامها % % PageV01P2244 41(@)(@@) % ذخيرة عند غد دولتها % % صائرة منك إلى نظامها % % 42(@)(@@) % هناك فاحفظني بما أسلفته % % قوافيا أبليت في إحكامها % % 43(@)(@@) % واضمن لما أهملت من حقوقها % % غرامة تبرد من غرامها % % 44(@)(@@) % واشكر لها المحبوب من طروقها % % في زمن المحل وفي إلمامها % % 45(@)(@@) % ولا تكن حاشاك كمريقها % % بالقاع لم يضبط قوى عصامها % % 46(@)(@@) % تنكصه البطنة فيما يرتعي % % عن حومة العلياء واقتحامها % % 47(@)(@@) % فانضح على ما خيلت لهذه % % ببلة تنقع من أوامها % % 48(@)(@@) % إن الكريم من قرى أضيافه % % ما يسمع الإمكان من إكرامها % % PageV01P2245 البحر : - 1(@)(@@) % هل لكما من علم % بالطارق الملم % 2(@)(@@) % سرى على الدياجي % % سرى أخيه النجم % 3(@)(@@) % يشق نجدا عرضا % من شخصه بسهم % 4(@)(@@) % فردا وليس منه % % قوة هذا العزم % 5(@)(@@) % فنور الليل ولي % % ست من ليالي التم % 6(@)(@@) % حتى إذا الشهب تدا % % عت من سلوك النظم % 7(@)(@@) % أسأر عندي ضوعه % % مع النهار ينمي % % 8(@)(@@) % قالا نعم نراها % % دعابة من نعم % 9(@)(@@) % ضنت عليك يقظى % % وسمحت 
ms717	 في الحلم % 10(@)(@@) % سماحة ليس على % % باذلها من غرم % PageV01P2246 11(@)(@@) % إن لم تكن شفاء % فهي مزيد سقم % 12(@)(@@) % خذ يا نسيم عنى % % تحيتي وضمي % % 13(@)(@@) % وقف فسلم لي على % % ظبية آل سلم % 14(@)(@@) % وهنها بوجدها % % من الكرى وعدمي % % 15(@)(@@) % قالوا هجرت أرضها % % أهجرها برغمي % % 16(@)(@@) % كم باللوى من وطر % أأباه وهو همي % % 17(@)(@@) % ومن عليل مفرق % لو عوذوه باسمي % % 18(@)(@@) % قد وصلت إلى الحشا % % رسلكم بالسقم % 19(@)(@@) % فلم تدع واسطة % بين دمي وعظمي % % 20(@)(@@) % يا كبدا لرام % رمى ولم يسم % PageV01P2247 21(@)(@@) % ما خلت قبل سهمه % % أن العيون تدمي % % 22(@)(@@) % وأنها تشوي النبا % % ل واللحاظ تصمي % % 23(@)(@@) % يا عاذلي تحرج % تؤب بحمل إثمي % % 24(@)(@@) % قصرك لست عندي % % من شأني المهم % 25(@)(@@) % تسفه في ملامي % % لو لم يسعك حلمي % % 26(@)(@@) % هل يسمع الربع معي % % من مسمع الأصم % 27(@)(@@) % سألته قطينه % % وعلمه كعلمي % % 28(@)(@@) % عج ترها رسوما % % ثلاثة في رسم % 29(@)(@@) % سوى النحول بيننا % % تعرفنا بالوهم % 30(@)(@@) % خيط هلال أبله % ودارها وجسمي % % PageV01P2248 31(@)(@@) % وقال تنسى في السل % % و بيننا والصرم % % 32(@)(@@) % أبعدت في الحب وما % % كنت بعيدا ترمي % % 33(@)(@@) % إن لم تكن من أسرتي % % رهط أبي وعمي % % 34(@)(@@) % فقلبها من قلبي ال % % أخ وإبن العم % 35(@)(@@) % قد جعلت ظبية وال % % معني فلست أسمي % % 36(@)(@@) % تملني ظالمة % لا أخذت بظلمي % % 37(@)(@@) % فأنكرت على الهوى % % أخذي بأمر الحزم % 38(@)(@@) % وكل أمري عندها % % شيبي وليس جرمي % % 39(@)(@@) % إن لم يكن رسل النهى % % فهو ثمار الهم % 40(@)(@@) % شب الزمان ناره % % فأخذت في فحمي % % PageV01P2249 41(@)(@@) % وجهك والغواني % % بعد بياض اللثم % 42(@)(@@) % لففت رأسي مدمجا % % عنها شباب وسمي % % 43(@)(@@) % خيل الهوى في ربطها % % تقلق تحت الحزم % 44(@)(@@) % شتى الشيات من أغ % % ر الوجه أو أحم % 45(@)(@@) % والسبق في حلبتها % % ليس لغير الدهم % 46(@)(@@) % قد نجذتني سنى % % وقد علكت شكمي % % 47(@)(@@) % وأدرد الأيام عض % ى تارة وعجمي % % 48(@)(@@) % وقد أرتني حدثها % % عاداتها في القدم % 49(@)(@@) % وزادني مضاء % تفللي وثلمي % % 50(@)(@@) % وقد عرفت حظي % % فما أكد عزمي % % PageV01P2250 51(@)(@@) % حملت نفسي عن 
ms718	 رجا % % ل ضعفوا عن فهمي % % 52(@)(@@) % ورحت بسلامتي % % منهم سني القسم % 53(@)(@@) % وصاحب بنيته % % مجتهدا لهدمي % % 54(@)(@@) % ألمه وأين رت % % ق صدعه باللم % 55(@)(@@) % يمسح وجهي بيد % % في عقبى تدمي % % 56(@)(@@) % حرب الضمير واللسا % % ن جائح للسلم % 57(@)(@@) % فقلبه من طعم % ووجهه من طعم % 58(@)(@@) % يستام مدحي أو ما % % يكفيه كف ذمي % % 59(@)(@@) % وبعد في العالم من % % يغار دون هضمي % % 60(@)(@@) % بصارم وساعد % يأنف لي ويحمي % % PageV01P2251 61(@)(@@) % ونصرة من مخول % في مجده معم % 62(@)(@@) % بان بسعد الملكمن % % سرى ما أعمي % % 63(@)(@@) % وفلجت حجة فض % % لي والزمان خصمي % % 64(@)(@@) % جاورت منه منكبي % صعب الذرى أشم % 65(@)(@@) % وكان من حاولني % % حاول جدر العصم % 66(@)(@@) % من أيبست شقته % شهباء أم الأرم % 67(@)(@@) % أمسيت لا أرض ربت % ولا سماء تهمي % % 68(@)(@@) % تبغى القرى في مسدف % أكلف مدلهم % 69(@)(@@) % قر ولا رزق به % % للحاطب المقم % 70(@)(@@) % ولا لكلب نابح % % ولا اعتراق العظم % PageV01P2252 71(@)(@@) % فقد رتعت منه في ال % % معبق المعتم % 72(@)(@@) % وقد طرحت شني % في الزاخر الخضم % 73(@)(@@) % أبلج من بلج الجبا % % ه قرم ابن قرم % 74(@)(@@) % من أسرة تقسموا ال % % مجد اقتسام الغنم % 75(@)(@@) % وضمنوا عهد الحيا % % للسنوات القحم % 76(@)(@@) % وصقلوا ببشرهم % % وجه الزمان الجهم % 77(@)(@@) % إن سكتوا فالحلم أو % % قالوا ففصل الحكم % 78(@)(@@) % فآية الناطق من % % هم آية المرم % 79(@)(@@) % تكنفوا الملك ولي % % دا قبل سن الحلم % 80(@)(@@) % وزملوه اليوم في % % بجاد شيخ هم % PageV01P2253 81(@)(@@) % بنو السيوف والضيو % % ف والأنوف الشم % 82(@)(@@) % والكلم الهافي في % % نفثه كل كلم % 83(@)(@@) % إن أجهضت أم العلا % % أو ولدت لليتم % 84(@)(@@) % در عليها ثدي ك % % ل حرة متم % 85(@)(@@) % منجبة والدة % بين النساء العقم % 86(@)(@@) % لهم ظهور الحرب وال % % صدور يوم السلم % 87(@)(@@) % ونفس كل طائع % % ونارة كل وسم % 88(@)(@@) % والصحف يطوين على ال % % أمر المطاع الحتم % 89(@)(@@) % يصدرن عن جوف لها % % بطش الصعاد الصم % 90(@)(@@) % صرير أقلامهم % فيها صليل اللجم % PageV01P2254 91(@)(@@) % حلفت بالمحجوب وال % % مرتشف الأحم % 92(@)(@@) % وبالثلاث من منى % % و السبع ذات الرجم % 93(@)(@@) % والمحرمين 
ms719	 نصلوا % % من دنس ووصم % 94(@)(@@) % منحدرين للبطا % % ح من رءوس الأكم % 95(@)(@@) % جاءت بهم نواحل % من كل فج ترمي % % 96(@)(@@) % شعث بشعث مثلها % % أدم مطايا أدم % 97(@)(@@) % قد السرى قد النسو % % ع بدنها والخطم % 98(@)(@@) % كل ضمور كالح % % ني فوقها كالسهم % 99(@)(@@) % تسلك خبطا كل فج % ضيق كالسم % 100(@)(@@) % لعز منسوب إلى % % عبد العزيز ينمي % % PageV01P2255 101(@)(@@) % وإن فرعا أنت من % % ه لكريم الجذم % 102(@)(@@) % سموك سعد الملك يا % % إصابة المسمي % % 103(@)(@@) % وكنت من نجم العلا % % نطفة ماء الكرم % 104(@)(@@) % ومثل هذا السعد من % % تأثير ذاك النجم % 105(@)(@@) % قومك أجسام العلا % % وأنت قلب الجسم % 106(@)(@@) % عدل حظي منذ صرت % قسمه في سهمي % % 107(@)(@@) % واسطة العقد معي % % منهم وبدر التم % 108(@)(@@) % كم لك في ألهوب حا % % لي من نوال سجم % 109(@)(@@) % ونعمة موشية % % حوك برود الرقم % 110(@)(@@) % فاحت كما فاح النسي % % م في الرياض النعم % PageV01P2256 111(@)(@@) % فلا تنلك يد با % % غ بسطت بغشم % 112(@)(@@) % ولا تزل بالشل تر % % مى في العدا والجذم % 113(@)(@@) % وامتد هذا الظل في % % بيتك هذا الضخم % 114(@)(@@) % ما حمل الفلك جنا % % ح الريح فوق اليم % 115(@)(@@) % وباكرت وراوحت % ربعك سحب نظمي % % 116(@)(@@) % بكل محلول العرى % % واهي العزالى فعم % 117(@)(@@) % مرتجز الرعد إذا % % ما اشتد غرب نجم % 118(@)(@@) % يغشى البلاد هاطلا % % في طمه والرم % 119(@)(@@) % يحمل منه المهرجا % % ن زهرة في كم % 120(@)(@@) % يعطى النفوس حكمها % % من نظر وشم % PageV01P2257 121(@)(@@) % أقيم فيها لك رس % % م الحافظ المهتم % 122(@)(@@) % فراع حق المجد أن % % يلوى لها برسم % 123(@)(@@) % إن الولي يقتضى % % من حيث جاء الوسمي % % PageV01P2258 البحر : - 1(@)(@@) % على مثلها كان العلاء يحوم % وتقعد بالملك المنى وتقوم % 2(@)(@@) % ويخفق قلب الدهر شوقا وتلتظى % % إلى الري أيام لواغب هيم % 3(@)(@@) % وتطمح ألحاظ الوزارة كلما % % وهى عام منها وسال قويم % 4(@)(@@) % مجالس تنبو عن ظهور ولاتها % % فتنزع تبغي غيرهم وتروم % 5(@)(@@) % تغيب المعالي فيهم عن صدورها % % وتحضر أسماء لهم وجسوم % 6(@)(@@) % جرى السابق الممسوح غرة وجهه % ونكص ملطوم الجبين بهيم % 7(@)(@@) % جواد يؤدي عن 
ms720	 كريم عروقه % فيبرز والعرق الكريم نموم % 8(@)(@@) % قناة من المجد التليد صليبة % لها مركز في المكرمات صميم % 9(@)(@@) % تمد أبا وابنا لنحر حسودها % % أنابيب لم تعلق بهن وصوم % 10(@)(@@) % من الدوحة الغيناء يضحك تربها % % رضاع المعالي والتراب فطيم % PageV01P2259 11(@)(@@) % سقاها بنو عبد الرحيم فدلها % % بهم دمث بين العضاه رخيم % 12(@)(@@) % زكت ما زكت حتى انتهت ثمراتها % % إلى خير فرع شف عنه أروم % 13(@)(@@) % وفى لعميد الدولتين بها الحيا % % فرف لها ظل ورق نسيم % 14(@)(@@) % حلت في حلوق الذائقين جناتها % % به ولأخلاق الرجال طعوم % 15(@)(@@) % هنا اليوم هذا الأمر أنك ربه % % وكافله بالرأي وهو يتيم % % 16(@)(@@) % وحاويه لما قيض الله برءه % وقد حام راق وستمات سليم % 17(@)(@@) % توافي عليه الناس أين دواؤه % % وراحوا ومنهم عاجز وسئوم % 18(@)(@@) % فلا لعنت أم الوزارة إنها % % لأنجب أنثى يوم عنك تقوم % 19(@)(@@) % لقد ولدت منك الذي لا أخا له % % وهل تلد العذراء وهي عقيم % 20(@)(@@) % تسنمها قوم بغير مناكب % ففي كل ظهر جلبة وكلوم % PageV01P2260 21(@)(@@) % تساعوا فبان ابن اللبون بقوة % % عليهم وفيهم جلة وقروم % 22(@)(@@) % يعدون فضل السن سبقا إلى المدى % % وأن المعالي شارة ووسوم % 23(@)(@@) % وكم ذابل ينمى بجوهر نفسه % % فيرعى ووافى النبت وهو وخيم % 24(@)(@@) % فهلا كما تكفي كفوا وتعلموا % % ليعقل تدبير الأمور عليم % 25(@)(@@) % فقل لمجر العجب فضل عنانه % % توق عضاض العجب فهو غذوم % 26(@)(@@) % ظننت الحمى ما لم تذد عنه ضائعا % % وفي الغاب أسد لو علمت جثوم % 27(@)(@@) % ستعلم إن شاورت رأيك والهوى % % على البغي أي الآمرين تلوم % 28(@)(@@) % تبين فما كل النفوس عظائم % إذا هن لم يدفع بهن عظيم % 29(@)(@@) % لقد طال باع الملك واشتد عوده % % بأروع لم يحلل عليه حريم % 30(@)(@@) % ومن أين تخشى خطة الجور أمة % وأنت لها بالصالحات زعيم % PageV01P2261 31(@)(@@) % تقلب حتى عاد نفعا ضرارها % % وشقوتها بالأمس وهي نعيم % 32(@)(@@) % وقرت رعاياه فأمست عيونها % % تنام على أم الحمى وتنيم % 33(@)(@@) % مشى الذئب بين السرح كل نصيبه % % لحاظ يسوي بينها وشميم % 34(@)(@@) % ورعت كما آمنت بالعدل فاشتفى % % برئ 