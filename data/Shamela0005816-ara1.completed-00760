ms741	 بن عفان وهو بن خمس عشرة سنة(@)(@@)(@@)(@@) $ 4735 - عباس بن جليد الحجري يروي عن عبد الله بن عمرو وأبي الدرداء روى عنه أبو هانئ حميد بن هانئ(@)(@@)(@@)(@@) $ 4736 - عباس بن عبد الله الجشمي يروي عن عثمان بن عفان وأبي هريرة روى عنه الجريري وقتادة(@)(@@)(@@)(@@) $ 4737 - عباس بن عبد الرحمن بن ميناء الأشجعي يروى عن بن عباس وجودان روى عنه بن جريج محمد بن إسحاق PageV05P259(@)(@@)(@@)(@@) $ 4738 - عباس بن نافع أخو أبو مرحب يروي عن بن عمر روى عنه نافع بن سرجس(@)(@@)(@@)(@@) $ 4739 - عباس بن جمهان يروي المراسيل روى عنه إسماعيل بن رافع(@)(@@)(@@)(@@) $ 4740 - عطية بن قيس الكلابي من أهل الشام كنيته أبو يحيى مولى لأبي بكر بن كلاب يروي عن معاوية روى عنه الشاميون وابنه سعد بن عطية مات سنة إحدى وعشرين ومائة وهو بن أربع ومائة سنة وكان مولده سنة سبع عشرة ومات قبل مكحول(@)(@@)(@@)(@@) $ 4741 - عطية الطفاوي البصري أبو المعذل من أهل البصرة يروي عن PageV05P260 بن عمر روى عنه سليمان التيمي وخالد الحذاء وعوف الأعرابي(@)(@@)(@@)(@@) $ 4742 - عطية بن رافع من أهل الشام كنيته أبو هزان يروي عن حذيفة ومعاوية روى عنه صفوان بن عمرو السكسكي وأهل الشام(@)(@@)(@@)(@@) $ 4743 - عطية بن سفيان بن عبد الله بن ربيعه الثقفي يروي عن عثمان وعلى روى عنه عيسى بن عبد الله بن مالك(@)(@@)(@@)(@@) $ 4744 - عطية بن بسر شيخ من أهل الشام حديثه عند أهلها روى عنه مكحول في التزويج متن منكر وإسناد مقلوب(@)(@@)(@@)(@@) $ 4745 - أبو هزان الشامي اسمه عطية بن أبي جميلة يروي عن جماعة من PageV05P261 التابعين وأدرك واثلة بن الأسقع روى عنه أهل الشام وليس هذا بأبي هزان الصغير ذاك اسمه يزيد بن سمرة(@)(@@)(@@)(@@) $ 4746 - عطية بن عامر الجهني يروي عن سلمان روى عنه عبد الله بن وهب(@)(@@)(@@)(@@) $ 4747 - عطية بن عارض يروي عن بن عباس روى عنه أبو خالد الدالاني(@)(@@)(@@)(@@) $ 4748 - عطية بن عبد الله بن أنيس الجهني يروي عن أبيه وله صحبة روى عنه أخوه عيسى بن عبد الله(@)(@@)(@@)(@@) $ 4749 
ms742	 - عطية بن الأسود أبو الأسود يروي عن بن عمر روى عنه مغيرة بن مالك(@)(@@)(@@)(@@) $ 4750 - عطية بن أبي عطية يروى عن بن أم مكتوم روى عنه علي بن زيد بن جدعان(@)(@@)(@@)(@@) $ 4751 - عطية أبو عبد الكريم مولى سليمان بن زياد يروي عن حذيفة PageV05P262 روى عنه برد بن سنان(@)(@@)(@@)(@@) $ 4752 - عطية بن سعد الدعاء يروي عن الحكم بن أيوب وله صحبة روى عنه كهمس بن الحسن(@)(@@)(@@)(@@) $ 4753 - عون بن عبد الله بن عتبة بن مسعود الهذلي أخو عبيد الله بن عبد الله من عباد أهل الكوفة وقرائهم يروي عن أبي هريرة إن كان سمع منه وقد أدرك بن أبي أوفى وأبا جحيفة روى عنه المسعودي ومسعر بن كدام(@)(@@)(@@)(@@) $ 4754 - عون بن أبي جحيفة واسم أبي جحيفة وهب السوائي من أهل الكوفة يروي عن أبيه روى عنه الثوري وشعبة مات في ولاية خالد على العراق(@)(@@)(@@)(@@) $ 4755 - عون أبو معمر العقيلي يروي عن أنس روى عنه البصريون PageV05P264 وهشام الدستوائي وسليمان بن المغيرة وذووهما(@)(@@)(@@)(@@) $ 4756 - عون بن عبد الله الأزدي يروي عن بن عمر روى عنه أبو فروة(@)(@@)(@@)(@@) $ 4757 - عون السهمي يروي عن أبي أمامة الباهلي روى عنه حاتم بن أبي صغيرة(@)(@@)(@@)(@@) $ 4758 - عياض بن عبد الله بن سعد بن أبي سرح العامري يروي عن أبي سعيد الخدري عداده في أهل المدينة روى عنه زيد بن أسلم والناس(@)(@@)(@@)(@@) $ 4759 - عياض الأشعري يروي عن عمر بن الخطاب وأبي عبيدة بن الجراح وأبي موسى روى عنه سماك بن حرب وقد قيل إنه له صحبة وليس يصح ذلك عندي(@)(@@)(@@)(@@) $ 4760 - عياض بن خليفة يروي عن على وعمر روى عنه الزهرى والناس PageV05P264(@)(@@)(@@)(@@) $ 4761 - عياض بن ضمري الكلبي بن عم أسامة بن زيد وكان ختنه على ابنته يروي عن أسامة بن زيد روى عنه الزهري وقد قيل عياض بن ضبرى(@)(@@)(@@)(@@) $ 4762 - عياض بن مسلم يروي عن بن عمر روى عنه يحيى بن سعيد الأنصاري(@)(@@)(@@)(@@) $ 4763 - عياض بن نضلة يروي عن على وأبي موسى روى عنه ابنه عباس بن عياض 
ms743	(@)(@@)(@@)(@@) $ 4764 - عياض بن هلال الأنصاري يروي عن أبي سعيد الخدري روى عنه يحيى بن أبي كثير ومن زعم أنه هلال بن عياض فقد وهم(@)(@@)(@@)(@@) $ 4765 - عياض بن غطيف يروي عن أبي عبيدة بن الجراح عداده في PageV05P265 أهل الشام روى عنه الوليد بن عبد الرحمن الجرشي وهو الذي يقول له سليم بن عامر غضيف بن الحارث عن أبي عبيدة ولم يضبطه(@)(@@)(@@)(@@) $ 4766 - عياض أبو خالد يروي عن معقل بن يسار عداده في أهل البصرة روى عنه شعبة(@)(@@)(@@)(@@) $ 4767 - عياض بن مسافع يروي عن أبي بكرة روى عنه طلحة بن عبد الله بن عوف من حديث الزهري عنه(@)(@@)(@@)(@@) $ 4768 - عياض بن أبي زهير يروي عن أبي سعيد الخدري روى عنه يحيى بن أبي كثير ثنا عمر بن محمد الهمداني قال ثنا عمرو بن عثمان قال ثنا بقية بن الوليد قال ثنا الأوزاعي عن يحيى بن أبي كثير عن عياض بن أبي زهير قال سمعت أبا سعيد الخدري يقول قال رسول الله صلى الله عليه وسلم إذا سهى أحدكم في صلاته فلا يدري زاد أو نقص فليسجد سجدتين وهو جالس(@)(@@)(@@)(@@) $ 4769 - عياض بن فراس يروي عن أبي سعيد الخدري روى عنه يحيى بن أبى كثير PageV05P266(@)(@@)(@@)(@@) $ 4770 - عياض بن عياض يروي عن أبي مسعود الأنصاري روى عنه الثوري وابنه عياض بن عياض بن عياض(@)(@@)(@@)(@@) $ 4771 - عياض بن دينار الليثي من أهل المدينة يروي عن أبي هريرة روى عنه محمد بن إسحاق بن يسار(@)(@@)(@@)(@@) $ 4772 - عياض بن يزيد الكلابي يروي عن أبي أمامة الباهلي روى عنه عاصم بن كليب(@)(@@)(@@)(@@) $ 4773 - عمار بن سعد القرظ المؤذن مولى بنى مخزوم يروي عن أبي هريرة روى عنه ابنه محمد بن عمار(@)(@@)(@@)(@@) $ 4774 - عمار بن أبي عمار مولى بنى هاشم كنيته أبو محمد وقد قيل PageV05P267 أبو عبد الله عداده في أهل مكة يروي عن أبي هريرة وأبى قتادة وكان يخطىء روى عنه يونس بن عبيد وشعبة وحماد بن سلمة مات في ولاية خالد بن عبد الله القسري على العراق 
ms744	(@)(@@)(@@)(@@) $ 4775 - عمار الغفاري يروي عن عمر بن الخطاب روى عنه عبد الله بن صفوان(@)(@@)(@@)(@@) $ 4776 - عمار المزني يروي عن أنس بن مالك روى عنه حميد الطويل(@)(@@)(@@)(@@) $ 4777 - عمار بن معاوية الدهني البجلي ودهن قبيلة من بجيلة عداده في أهل الكوفة كنيته أبو معاوية وكنية أبيه أبو معاوية وهو الذي يقال له عمار بن أبي معاوية يروي عن أبي الطفيل ربما أخطأ وكان راويا لسعيد بن جبير روى عنه السفيانان(@)(@@)(@@)(@@) $ 4778 - عنبسة بن سعيد بن العاص الأموي القرشي أخو يحيى وعمرو كنيته أبو خالد يروي عن أبي هريرة روى عنه الزهري(@)(@@)(@@)(@@) $ 4779 - عنبسة بن أبي سفيان بن أمية بن عبد شمس القرشي أخو أم حبيبة PageV05P268 بنت أبي سفيان كنيته أبو عثمان يروي عن أم حبيبة روى عنه مكحول وعمرو بن أوس وقد قيل إن كنيته أبو الوليد(@)(@@)(@@)(@@) $ 4780 - عنبسة بن عمار الدوسي القرشي من أهل المدينة قدم الكوفة فحدثهم بها يروي عن بن عمر روى عنه مروان بن معاوية والكوفيون(@)(@@)(@@)(@@) $ 4781 - عنبسة أبو رافع يروي عن أنس بن مالك روى عنه عبد الصمد بن عبد الوارث(@)(@@)(@@)(@@) $ 4782 - عنبسة بن أبي عمرو يروي عن أنس بن مالك روى عنه أيمن بن نابل(@)(@@)(@@)(@@) $ 4783 - عنبسة بن حكيم الفزاري يروي عن على روى عنه علي بن ربيعة الوالبي(@)(@@)(@@)(@@) $ 4784 - عدى بن أبي بن كعب يروي عن أبيه روى عنه أهل المدينة PageV05P269 كنيته أبو معاذ(@)(@@)(@@)(@@) $ 4785 - عدى بن ثابت الأنصاري عداده في أهل الكوفة يروي عن البراء بن عازب وأبي أمه عبد الله بن يزيد الذي روى عنه يحيى بن سعيد الأنصاري روى عنه أهل الكوفة مات في ولاية خالد على العراق(@)(@@)(@@)(@@) $ 4786 - عدى بن أبي عدى الكندي واسم أبي عدى فروة يروي عن أبيه ويقال إن له صحبة روى عنه عيسى بن عاصم مات سنة ست وعشرين ومائة(@)(@@)(@@)(@@) $ 4787 - عدى بن أبي عدى بن جبلة بن عدي بن ربيعة من أهل الكوفة يروي عن جماعة من الصحابة روى عنه الكوفيون(@)(@@)(@@)(@@) $ 4788 - عدى بن دينار 
ms745	 القرشي مولى أم قيس بنت محصن يروي عن أم قيس روى الثوري عن ثابت بن هرمز أبي المقدام عنه(@)(@@)(@@)(@@) $ 4789 - عدى يروي عن عمر بن الخطاب روى عنه ابنه غيلان بن عدى(@)(@@)(@@)(@@) $ 4790 - عدى بن عدى الكندي من أهل الجزيرة يروي عن أبي الدرداء وجماعة من الصحابة روى عنه عمرو بن قيس PageV05P270 السكوني وأهل بلده مات سنة عشرين ومائة وليس هذا بالأول(@)(@@)(@@)(@@) $ 4791 - عدي بن أرطأة الفزاري أخو زيد بن أرطأة يروي المراسيل روى عنه بكر بن عبد الله المزني وعدي بن قبيصة(@)(@@)(@@)(@@) $ 4792 - عياش بن أبي مسلم يروي عن بن عمر روى عنه محمد بن موسى المدني(@)(@@)(@@)(@@) $ 4793 - عياش بن عبد الله الجشمي يروي عن عثمان بن عفان وأبي هريرة روى عنه قتادة(@)(@@)(@@)(@@) $ 4794 - عياش العامري يروي عن بن أبي أوفى روى عنه الثوري(@)(@@)(@@)(@@) $ 4795 - عياش بن مؤنس يروي عن نمران بن محمد بن شرحبيل بن أوس ويقال إن له صحبة وما أرا بمحفوظ روى عنه محمد بن الوليد الزبيدي PageV05P271(@)(@@)(@@)(@@) $ 4796 - عياش بن عقبة عم بن لهيعة يروى عن بن مسعود أنه قال أول ما تنظرون الدجال فبئس الغائب المنتظر أم الساعة فالساعة أدهى وأمر ثنا عمر بن محمد بن الهمداني قال ثنا محمد بن أشكاب قال ثنا محمد بن عبيدة بن معن قال ثنا أبي عن الأعمش عن زيد بن حباب عن عياش بن عقبة قال قال عبد الله فذكره(@)(@@)(@@)(@@) $ 4797 - عقيل بن جابر بن عبد الله الأنصاري السلمي من أهل المدينة يروي عن أبيه روى عنه صدقة بن يسار(@)(@@)(@@)(@@) $ 4798 - عقيل بن المغيرة يروي عن بن عمر روى عنه عبد الملك بن عمير(@)(@@)(@@)(@@) $ 4799 - عقيل مولى بن عباس يروي عن أبي موسى الأشعري روى عنه سليمان بن يسار(@)(@@)(@@)(@@) $ 4800 - عقيل بن سمير ويقال بن شمير يروي عن بن عمر روى عنه ابنه عبد الله بن عقيل(@)(@@)(@@)(@@) $ 4801 - عقيل بن شبيب يروي عن أبي وهب الجيشاني وله صحبة PageV05P272 روى عنه محمد بن المهاجر(@)(@@)(@@)(@@) $ 4802 - عقيل بن طلحة السلمي 
ms746	 يروي عن أبي جري الهجيمي وله صحبة روى عنه سلام بن مسكين(@)(@@)(@@)(@@) $ 4803 - عقيل بن حنظلة المحاربي يروي عن بن عمر روى عنه ابنه مسلم بن عقيل(@)(@@)(@@)(@@) $ 4804 - عقيل بن عبد الرحمن الخولاني يروي عن علي بن أبي طالب وكان على قضاء الموصل وكانت عمته امرأة عقيل بن أبي طالب روى عنه أبو إسحاق السبيعي وأبو السفر(@)(@@)(@@)(@@) $ 4805 - عقيل بن دينار مولى جارية يروي عن جارية بن ظفر وله صحبة روى عنه دهثم بن قران(@)(@@)(@@)(@@) $ 4806 - عرفجة بن عبد الله الثقفي من أهل الكوفة يروي عن علي بن أبي طالب وعبد الله بن مسعود وعائشة وهو الذي روى عنه عطاء بن أبي رباح فقال عرفجة بن عبد الواحد وهو الذي روى مروان PageV05P273 بن معاوية عن عمر بن عبد الله الثقفي عن عرفجة بن عبد الله الثقفي قال كان علي بن أبي طالب يأمر الناس بقيام رمضان يجعل للرجال إماما وللنساء إماما قال عرفجة فأمرني علي فكنت إمام(@)(@@)(@@)(@@) $ 4807 - عرفجة السلمي من أهل الكوفة يروي عن أبي بكر الصديق إن كان سمع منه روى عنه أبو عون الثقفي(@)(@@)(@@)(@@) $ 4808 - عتاب بن حنين المكي ويقال عباد بن حنين يروي عن أبي سعيد الخدري روى عنه عمرو بن دينار(@)(@@)(@@)(@@) $ 4809 - عتاب مولى بنى هرمز من أهل البصرة وهو عتاب بن هرمز يروي عن أنس بن مالك روى عنه شعبة بن الحجاج(@)(@@)(@@)(@@) $ 4810 - عتاب البكري يروي عن أبي سعيد الخدري روى عنه عبد الله بن ميسرة(@)(@@)(@@)(@@) $ 4811 - عتاب بن زيد بن أرقم شيخ كوفي يروي عن أبيه زيد بن أرقم روى عنه فراس(@)(@@)(@@)(@@) $ 4812 - عوف بن مالك بن نضلة الجشمي أبو الأحوص من أهل الكوفة PageV05P274 يروي عن بن مسعود روى عنه أبو إسحاق السبيعي وعطاء بن السائب قتلته الخوارج في أيام الحجاج بن يوسف(@)(@@)(@@)(@@) $ 4813 - عوف بن الحارث بن الطفيل بن سخبرة بن جرثومة الأزدي من النمر بن عثمان والطفيل بن سخبرة أخو عائشة لأمها من الرضاعة يروي عوف عن عائشة وابن الزبير وأبي 
ms747	 هريرة روى عنه الزهري وبكير بن الأشج(@)(@@)(@@)(@@) $ 4814 - عوف بن حصيرة الشامي يروي عن أبي أمامة روى عنه الشعبي(@)(@@)(@@)(@@) $ 4815 - عوف بن أبي حدرد يروي عن السائب بن يزيد وله صحبة روى عنه سعيد بن أبي هلال وابن عجلان PageV05P275(@)(@@)(@@)(@@) $ 4816 - عوف بن مالك الجابري يروي عن علي بن أبي طالب روى عنه أبو الضحاك يحيى بن مسلم(@)(@@)(@@)(@@) $ 4817 - عوف البكالي يروي عن عمر البكالي روى عنه يحيى بن أبي عمرو السيباني(@)(@@)(@@)(@@) $ 4818 - عائذ بن نصيب الأسدي الكاهلي يروي عن بن عمر روى عنه شعبة وابنه مسلم بن عائذ(@)(@@)(@@)(@@) $ 4819 - عائذ أبو معاذ يروي المراسيل روى عنه إسماعيل بن مسلم العبدي(@)(@@)(@@)(@@) $ 4820 - عائذ بن أبي ضب الكعبي الحبتري يروي عن أبى هريرة PageV05P276 روى عنه أبو رشدين(@)(@@)(@@)(@@) $ 4821 - عائذ الجعفي يروي المراسيل روى عنه الجعد بن الصلت(@)(@@)(@@)(@@) $ 4822 - أبو إدريس الخولاني اسمه عائذ الله بن عبد الله ولد عام حنين عداده في أهل الشام يروي عن شداد بن أوس وابن مسعود والمغيرة بن شعبة ولم يسمع من معاذ بن جبل شيئا روى عنه الزهري وأهل الشام ولاه عبد الملك بن مروان القضاء وعزل بلال بن أبي الدرداء وكان أبو إدريس من عباد أهل الشام وقرائهم مات سنة ثمانين وإليه كانت أمور دمشق(@)(@@)(@@)(@@) $ 4823 - عائذ الله المجاشعي قاص عبد الملك بن مروان يروي المراسيل روى عنه سلام بن مسكين وليس هو بأبي إدريس الخولاني(@)(@@)(@@)(@@) $ 4824 - عجلان مولى فاطمة بنت عتبة بن ربيعة القرشي والد بن عجلان PageV05P277 يروي عن أبي هريرة عداده في أهل المدينة روى عنه بكير بن الأشج وابنه محمد بن عجلان(@)(@@)(@@)(@@) $ 4825 - عجلان مولى المشمعل كنيته أبو محمد يروي عن أبي هريرة روى عنه بن أبي ذئب ليس هذا بوالد محمد بن عجلان(@)(@@)(@@)(@@) $ 4826 - عجلان مولى لآل يزيد بن الهاد يروي عن أبي هريرة روى عنه يزيد بن الهاد(@)(@@)(@@)(@@) $ 4827 - عجلان أبو غالب يروي عن بن عباس روى عنه محمد بن الفضل بن عطية الخراساني(@)(@@)(@@)(@@) $ 4828 - عجلان بن سهل الباهلي يروي 
ms748	 عن أبي أمامة روى عنه سليمان بن موسى(@)(@@)(@@)(@@) $ 4829 - عجلان بن سمعان يروي عن أبي هريرة روى عنه أبو سفيان طلحة بن نافع وصالح بن صالح(@)(@@)(@@)(@@) $ 4830 - عجلان بن سالم يروي عن أبي قرصافة واسم أبي قرصافة جندرة بن خيشنة روى عنه زياد بن الجعد PageV05P278(@)(@@)(@@)(@@) $ 4831 - عجلان مولى ثقيف من أهل البصرة يروي عن أبي بكرة وسمرة روى عنه يحيى بن مروان(@)(@@)(@@)(@@) $ 4832 - عزرة بن الحارث الشيباني يروي عن البراء بن عازب روى عنه العوام بن حوشب بن قحطبة قال ثنا بشر بن معاذ قال ثنا هشيم قال ثنا العوام بن حوشب عن عزرة بن الحارث الشيباني عن البراء بن عازب قال كنا إذا صلينا خلف رسول الله صلى الله عليه وسلم فرفعنا رؤوسنا من الركوع فقمنا صفوف حتى يسجد رسول الله صلى الله عليه وسلم فنتبعه(@)(@@)(@@)(@@) $ 4833 - عزرة بن قيس البجلي يروي عن خالد بن الوليد روى عنه أبو وائل شقيق بن سلمة(@)(@@)(@@)(@@) $ 4834 - عزرة بن تميم يروي عن أبي هريرة روى عنه قتادة(@)(@@)(@@)(@@) $ 4835 - عميرة بن سعد أبو السكن اليامي الهمداني من أهل الكوفة يروي عن علي بن أبي طالب روى عنه طلحة بن مصرف PageV05P279(@)(@@)(@@)(@@) $ 4836 - عميرة بن زياد يروي عن عبد الله بن مسعود روى عنه أبو إسحاق السبيعي(@)(@@)(@@)(@@) $ 4837 - عميرة بن يثربي الضبي قاضي البصرة يروي عن أبي بن كعب روى عنه أنس بن سيرين(@)(@@)(@@)(@@) $ 4838 - عفان بن سعيد يروي عن بن الزبير روى عنه مسعر بن كدام(@)(@@)(@@)(@@) $ 4839 - عفان الأزدي شيخ يروي عن بن عمر يروي عنه قتادة(@)(@@)(@@)(@@) $ 4840 - علباء بن أحمر اليشكري سكن مرو أصله من البصرة يروي عن أبي زيد الأنصاري وهو جده واسم أبي زيد عمرو بن أخطب روى عنه داود بن أبي الفرات وحسين بن واقد(@)(@@)(@@)(@@) $ 4841 - علباء شيخ يروي عن علي بن أبي طالب روى عنه عمرو بن غزى البكري PageV05P280(@)(@@)(@@)(@@) $ 4842 - عباية بن رفاعة بن رافع بن خديج الأنصاري الجارتى يروي عن جده رافع بن خديج وابن عمر روى عنه 
ms749	 سعيد بن مسروق وأبو حيان التيمي كنيته أبو رفاعة وهو الذي روى عن أبي عبس بن جبر من حديث يزيد بن أبي مريم(@)(@@)(@@)(@@) $ 4843 - عباية بن رداد التيمي يروي عن عمر بن الخطاب روى عنه سلمة بن كهيل ومحمد بن المنتشر(@)(@@)(@@)(@@) $ 4844 - عباية بن ربعي الأسدي رأى جماعة من الصحابة روى عنه أهل الكوفة(@)(@@)(@@)(@@) $ 4845 - عراك بن مالك الغفاري يروي عن أبي هريرة عداده في أهل المدينة روى عنه الزهري وابنه خثيم بن عراك مات في ولاية يزيد بن عبد الملك وهو الذي يروي عن الزهري عن حميد عن أبي هريرة قصة المجامع من حديث بكر بن مضر عن جعفر بن ربيعة عن عراك بن مالك(@)(@@)(@@)(@@) $ 4846 - عوسجة الهاشمي يروي عن بن عباس روى عنه عمرو بن دينار PageV05P281 وأحسبه عوسجة بن الرماح ثنا مكحول قال ثنا بن المقري قال ثنا سفيان عن عمرو بن دينار عن عوسجة عن بن عباس قال مات رجل على عهد النبي صلى الله عليه وسلم ولم يترك أحدا إلا عبدا هو أعتقه فأعطاه النبي صلى الله عليه وسلم وقال من ميراثه(@)(@@)(@@)(@@) $ 4847 - عتبان بن عمرو بن إياس يروي عن السائب بن يزيد روى عنه الضحاك بن عثمان(@)(@@)(@@)(@@) $ 4848 - عنترة والد هارون بن عنترة كنيته أبو وكيع شهد علي بن أبي طالب رضى الله عنه روى عنه أبو سنان وابنه هارون وهارون الله المستعان على إثباته(@)(@@)(@@)(@@) $ 4849 - عريف بن سريع يروي عن عبد الله بن عمر روى عنه توبة بن نمر(@)(@@)(@@)(@@) $ 4850 - عصام بن بشير أحد بنى الحارث بن كعب من أهل الجزيرة يروي عن أنس بن مالك روى عنه سعيد بن مروان مات وقد جاوز على مائة وعشر سنين(@)(@@)(@@)(@@) $ 4851 - عويمر بن عبد الله السلمي شيخ يروي عن أبي أيوب الأنصاري PageV05P282 روى عنه محمد بن إسحاق بن يسار(@)(@@)(@@)(@@) $ 4852 - العيزار بن حريث العبدي من أهل الكوفة يروي عن بن مسعود روى عنه ابنه الوليد مات في ولاية خالد على العراق(@)(@@)(@@)(@@) $ 4853 - أبو هنيدة المازني اسمه 
ms750	 عريب بن مالك أدرك أنس بن مالك روى عنه أهل البصرة(@)(@@)(@@)(@@) $ 4854 - عريب بن حميد بن عمار الهمداني من أهل الكوفة يروي المراسيل روى عنه أبو إسحاق السبيعي والقاسم بن مخيمرة كنيته أبو عمار الفائشي(@)(@@)(@@)(@@) $ 4855 - عفيف بن معدى كرب يروي عن عمر بن الخطاب روى عنه هارون بن عبد الله(@)(@@)(@@)(@@) $ 4856 - عطارد شيخ يروي عن بن عمر روى عنه وهيب بن الورد وجرير بن حازم PageV05P283(@)(@@)(@@)(@@) $ 4857 - عنبس بن عقبة الحضرمي يروي عن بن مسعود وكان من عباد أهل الكوفة وكان إذا صلى تقع العصافير على ظهره تحسبه جذم حائط روى عنه يزيد بن حيان وأهل الكوفة(@)(@@)(@@)(@@) $ 4858 - عقال البجلي يروي عن بن عباس روى عنه ابنه عيسى بن عقال(@)(@@)(@@)(@@) $ 4859 - عقال بن صعصعة بن ناجية بن مجاشع المجاشعي يروي عن أبيه سمع النبي صلى الله عليه وسلم يقول أمك وأباك وأختك وأخاك أدناك وأدناك(@)(@@)(@@)(@@) $ 4860 - عليبة بن حرملة العنبري التميمي يروي عن أبيه روى عنه ابنه ضرغامة بن عليبة(@)(@@)(@@)(@@) $ 4861 - عيينة بن غصن شيخ يروي عن أنس بن مالك روى عنه جرير PageV05P284 بن عبد الحميد الضبي(@)(@@)(@@)(@@) $ 4862 - عائش بن أنس البكري يروي عن على روى عنه عطاء بن أبي رباح(@)(@@)(@@)(@@) $ 4863 - عابس بن ربيعة النخعي يروي عن علي بن أبي طالب وعمر بن الخطاب روى عنه إبراهيم النخعي وابنه عبد الرحمن بن عابس(@)(@@)(@@)(@@) $ 4864 - عدسة الطائي يروي عن بن مسعود روى عنه سلمة بن كهيل(@)(@@)(@@)(@@) $ 4865 - عتريس بن عرقوب الشيباني يروي عن بن مسعود عداده في أهل الكوفة روى عنه أهلها(@)(@@)(@@)(@@) $ 4866 - عصبة بن سعد البلوى يروي عن الحسن والحسين روى عنه عبدة بن أبي قيس(@)(@@)(@@)(@@) $ 4867 - عبدة بن أبى المضرب قال كنا جلوس عند أنس بن مالك في رمضان فلما أمسينا قام مؤذنه فأذن بصلاة المغرب وجاء خبازه بالعشاء فقال اقعدوا حتى نفطر فإنها سنة روى عنه محمد بن هلال من حديث بن يونس الإسكندراني PageV05P285(@)(@@)(@@)(@@) $ 4868 - عليم شيخ يروي عن سلمان الفارسي روى عنه زاذان(@)(@@)(@@)(@@) $ 4869 - عتي بن 
ms751	 ضمرة السعدي يروي عن أبي بن كعب روى عنه الحسن(@)(@@)(@@)(@@) $ 4870 - عتيك بن الحارث بن عتيك بن قيس بن هيشة المعاوي الأوسي الأنصاري من أهل المدينة يروي عن جابر بن عتيك وجماعة من أصحاب رسول الله صلى الله عليه وسلم روى عنه عبد الله بن عبد الله بن جابر بن عتيك والناس وهو جد عبد الله بن عبد الله بن جابر بن عتيك(@)(@@)(@@)(@@) $ 4871 - علاقة بن عبد الله بن زيد بن مربع من بنى حارثة الأنصاري عداده في أهل المدينة يروي عن سهل بن سعد الساعدي روى عنه كثير بن جعفر(@)(@@)(@@)(@@) $ 4872 - عقيصا أبو سعيد التيمي صاحب الكراش من أهل الكوفة يروي عن علي بن أبي طالب وعمار روى عنه الأعمش ومحمد بن جحادة وقد قيل إن اسم أبي سعيد عقيصا دينار PageV05P286(@)(@@)(@@)(@@) $ 4873 - عسعس بن سلامة أبو صفرة التميمي البصري يروي عن جماعة من أصحاب رسول الله صلى الله عليه وسلم روى عنه الأزرق بن قيس(@)(@@)(@@)(@@) $ 4874 - عقار بن المغيرة بن شعبة الثقفي يروي عن أبيه روى عنه مجاهد وحسان بن أبي وجزة(@)(@@)(@@)(@@) $ 4875 - عتيق والد عبد الرحمن بن عتيق يروي عن عائشة روى عنه ابنه عبد الرحمن بن عتيق وقد قيل بن أبى عتيق والصحيح بن عتيق(@)(@@)(@@)(@@) $ 4876 - علاج شيخ يروي عن بن عمر روى عنه جامع بن شداد(@)(@@)(@@)(@@) $ 4877 - العجاج بن رؤبة يروي عن أبي هريرة طاف الخيالان فهاجا سقما روى عنه ابنه رؤبة بن العجاج وقد قيل إن اسم العجاج عبد الله PageV05P287(@)(@@)(@@)(@@) $ 4878 - عزوان بن عزوان الرقاشي من أهل البصرة لحق جماعة من الصحابة روى عنه البصريون حلف أنه لا يضحك حتى يعلم أين منزلته فلم يضحك حتى مات ويقال أيضا عزوان بن زيد الرقاشي وذكر قصته(@)(@@)(@@)(@@) $ 4879 - عكاظ التيمي يروي عن أنس بن مالك روى عنه هارون بن موسى(@)(@@)(@@)(@@) ||| (النساء)(@)(@@)(@@)(@@) $$ 4880 - عمرة بنت الشافع تروي عن أم سلمة روى عنه عمار الدهني(@)(@@)(@@)(@@) $$ 4881 - عمرة بنت عبد الرحمن بن سعد بن زرارة تروي عن عائشة وكانت من 
ms752	 أعلم الناس بحديثها روى عنها أهل المدينة وأبو الرجال محمد بن عبد الرحمن ابنها ماتت سنة ثمان وتسعين(@)(@@)(@@)(@@) $$ 4882 - عمرة مولاة حمنة بنت شجاع تروي عن أم قيس بنت محصن عن النبي صلى الله عليه وسلم قال استتروا من النار ولو بشق تمرة روى التبوذكي قال ثنا سعد أبو عاصم مولى بنى هاشم عن عمرة(@)(@@)(@@)(@@) $$ 4883 - عائشة بنت سعد بن أبي وقاص تروى عن أبيها روى عنها PageV05P288 أهل المدينة ماتت سنة سبع عشرة ومائة وكانت من أجمل نساء أهل زمانها(@)(@@)(@@)(@@) $$ 4884 - عائشة بنت طلحة بن عبيد الله التيمي تروى عن عائشة روى عنها طلحة بن يحيى وأهل المدينة(@)(@@)(@@)(@@) $$ 4885 - عائشة بنت قدامة بن مظعون الجمحي تروي عن أبيها روى عنها قدامة بن إبراهيم بن محمد بن حاطب وعمرو بن حسين(@)(@@)(@@)(@@) $$ 4886 - العالية بنت أيفع والدة يونس بن أبي إسحاق تروى عن عائشة روى عنها ابنها يونس بن أبي إسحاق السبيعي(@)(@@)(@@)(@@) $$ 4887 - العالية أم عبد الله بن مالك بن حذافة تروي عن ميمونة زوجة رسول الله صلى الله عليه وسلم روى عنها ابنها عبد الله مالك بن حذافة(@)(@@)(@@)(@@) $$ 4888 - عزة بنت أبي قرصافة واسمه جندرة بن حبشية تروي عن أبيها روى عنها أهل فلسطين PageV05P289(@)(@@)(@@)(@@) || (باب الغين)(@)(@@) قال أبو حاتم ممن روى عن الصحابة وشافههم ممن ابتدأ اسمه على الغين(@)(@@)(@@)(@@) $ 4889 - غالب الرياحي بصرى يروي عن بن عمر روى عنه الجريري(@)(@@)(@@)(@@) $ 4890 - غالب بن عجرد التيمي يروي عن بن عمر روى عنه ثابت البناني وعوف الأعرابي(@)(@@)(@@)(@@) $ 4891 - غالب بن سويد الدمشقي يروي عن أبي هريرة روى عنه إسماعيل بن عبيد الله بن أبي المهاجر(@)(@@)(@@)(@@) $ 4892 - غيلان بن معشر المقرإى يروي عن أبي أمامة عداده في أهل الشام روى عنه معاوية بن صالح ومن زعم أنه المقرى فقد وهم إنما هو المقرإى ومقرا قرية بدمشق PageV05P290(@)(@@)(@@)(@@) $ 4893 - غيلان بن جرير العتكي المعولي الأزدي من أهل البصرة يروي عن أنس بن مالك وأبي بردة روى عنه مهدى بن ميمون مات سنة تسع وعشرين ومائة(@)(@@)(@@)(@@) $ 4894 
ms753	 - غيلان بن عبد الله مولى قريش يروي عن بن عمر روى عنه شعبة وهشيم(@)(@@)(@@)(@@) $ 4895 - غيلان بن غيلان الأنصاري يروي عن بن عباس روى عنه شريك(@)(@@)(@@)(@@) $ 4896 - غيلان بن عميرة يروي عن بن عمر روى عنه أبو خالد البصري(@)(@@)(@@)(@@) $ 4897 - غضيف بن الحارث من أهل الشام يروي عن عائشة روى عنه عبادة بن نسي ثنا العباس بن الخليل الطائي بحمص قال ثنا نصر بن خزيمة PageV05P291 بن علقمة بن محفوظ بن علقمة الحضرمي قال ثنا أبي عن نصر بن علقمة عن أخيه محفوظ بن علقمة عن بن عائذ عن غضيف بن الحارث عن أبي الدرداء عن النبي صلى الله عليه وسلم قال قال داود النبي صلى الله عليه وسلم السيئات غضة شوكها وحسكها(@)(@@)(@@)(@@) $ 4898 - غطيف بن عبد الله الشامي الهمداني يروي عن عمر بن الخطاب روى عنه أهل الشام مات في ولاية مروان بن الحكم(@)(@@)(@@)(@@) $ 4899 - غطيف بن أبي سفيان الثقفى يروي عن بن عمر روى عنه سعيد بن السائب وغيره مات سنة ثمان وأربعين ومائة(@)(@@)(@@)(@@) $ 4900 - غطيف أبو عبد الكريم يروي عن عبد الله بن عمرو روى سعيد بن زيد عن رجل من أهل الشام عنه(@)(@@)(@@)(@@) $ 4901 - غنام بن قيس يروي عن بن عمر روى عنه عاصم بن سليمان الأحول(@)(@@)(@@)(@@) $ 4902 - غزوان بن عتبة بن غزوان من بنى مازن بن منصور حليف بنى نوفل وقد قيل حليف بنى عبد مناف يروي عن أبيه روى عنه محمد بن الفضل PageV05P292(@)(@@)(@@)(@@) $ 4903 - غزوان أبو مالك الغفاري يروي عن بن عباس روى عنه أهل المدينة(@)(@@)(@@)(@@) $ 4904 - غزوان أبو حاتم يروي عن أبي ذر روى عنه السرى بن يحيى(@)(@@)(@@)(@@) $ 4905 - غاضرة بن عروة الفقيمي يروي عن أبيه وله صحبة روى عنه البصريون ثنا محمد بن الحسين بن مكرم بالبصرة قال ثنا عمرو بن علي قال ثنا عاصم بن هلال أبو النضر البارقي قال ثنا بن عروة الفقيمي منذ ستون سنة عن أبيه قال دخلت مسجد رسول الله فدخل علينا رجل يقطر رأسه من وضوء توضأ 
ms754	 به أو غسل اغتسل فقام إليه الناس فقالوا يا رسول الله أرأيت كذا يا رسول الله أرأيت كذا أرأيت كذا يا رسول الله فقال رسول الله صلى الله عليه وسلم يا أيها الناس إن دين الله يسر أيها الناس إن دين الله يسر(@)(@@)(@@)(@@) $ 4906 - غاضرة العنبري يروي عن عمر بن الخطاب روى عنه عبد الله بن عون(@)(@@)(@@)(@@) $ 4907 - غنيم بن قيس المازني أبو العنبر يروي عن أبي موسى الأشعري وسعد بن أبي وقاص وعن أبيه وله صحبة روى عنه ثابت بن عمارة مات سنة تسعين PageV05P293(@)(@@)(@@)(@@) $ 4908 - غطفان شيخ يروي عن بن عباس روى عنه قارظ بن شيبة(@)(@@)(@@)(@@) $ 4909 - غنى بن أبي حازم الذهلي ويقال بن أبى حاتم يروي عن بن عمر روى عنه عكرمة بن عمار(@)(@@)(@@)(@@) $ 4910 - الغريف بن عياش من أهل الشام يروي عن فيروز الديلمي وله صحبة روى عنه إبراهيم بن أبي عبلة(@)(@@)(@@)(@@) $ 4911 - الغاز بن ربيعة الجرشي من أهل الشام يروي عن جماعة من الصحابة روى عنه ابنه هشام بن الغاز وأهل الشام(@)(@@)(@@)(@@) || (باب الفاء)(@)(@@) قال أبو حاتم وممن روى عن أصحاب النبي صلى الله عليه وسلم ممن ابتدأ اسمه على الفاء(@)(@@)(@@)(@@) $ 4912 - فضيل بن زيد الرقاشي كنيته أبو حسان من أهل البصرة وقرائهم يروي عن عمر روى عنه عاصم الأحول مات سنة خمس وتسعين PageV05P294(@)(@@)(@@)(@@) $ 4913 - فضيل بن بزوان من أهل الكوفة يروي عن بن مسعود روى عنه أبو رزين(@)(@@)(@@)(@@) $ 4914 - فضيل بن كثير يروي عن أنس روى عنه سيف بن هارون وهشيم بن أبي ساسان(@)(@@)(@@)(@@) $ 4915 - فضيل بن فضالة الهوزني من أهل الشام يروي المراسيل روى عنه صفوان بن عمرو وأهل الشام(@)(@@)(@@)(@@) $ 4916 - فضيل شيخ يروي عن معاوية روى عبيد الله بن أبي جعفر عن صفوان بن سليم عنه إن لم يكن الهوزني فلا أدرى من هو(@)(@@)(@@)(@@) $ 4917 - الفضل بن عبيد الله بن أبي رافع مولى رسول الله صلى الله عليه وسلم يروي عن أبي رافع روى عنه عباس بن أبي خداش وابنه العباس بن الفضل 
ms755	(@)(@@)(@@)(@@) $ 4918 - الفضل بن عمرو بن أمية الضميري يروي عن أبيه عمرو بن أمية روى عنه صالح بن كيسان PageV05P295(@)(@@)(@@)(@@) $ 4919 - الفضل بن طلحة يروي عن جابر بن عبد الله روى عنه فرات القزاز(@)(@@)(@@)(@@) $ 4920 - الفضل بن الحسن بن عمرو بن أمية الضميرى يروى عن بن عمر وأبي هريرة روى عنه جعفر بن ربيعة ومحمد بن إسحاق(@)(@@)(@@)(@@) $ 4921 - الفضل بن عيسى يروي عن أنس بن مالك روى عنه موسى بن عبيدة إن كان الرقاشي فليس بمتصل(@)(@@)(@@)(@@) $ 4922 - الفضل بن مبشر الأنصاري من أهل المدينة كنيته أبو بكر يروي عن جابر روى عنه مروان بن معاوية الفزاري وأهل الكوفة(@)(@@)(@@)(@@) $ 4923 - فضالة بن عبيد الزهراني ويقال بن عمير يروي عن المغيرة بن شعبة روى عنه أبو العالية من حديث داود بن أبي هند(@)(@@)(@@)(@@) $ 4924 - فضالة بن أبي فضالة الأنصاري يروي عن علي بن أبي طالب قال عهد إلي رسول الله صلى الله عليه وسلم أن لا أموت حتى أؤمر وتخضب هذه من هذه يعني لحيته من دم هامته روى عنه عبد الله بن محمد بن عقيل(@)(@@)(@@)(@@) $ 4925 - فضالة بن دينار الخزاعي كنيته أبو حرب يروي عن بن عمر روى عنه مكحول PageV05P296(@)(@@)(@@)(@@) $ 4926 - فضالة بن أبي أمية والد المبارك بن فضالة يروي عن عمر بن الخطاب روى عنه عبد الملك بن أبي بشير(@)(@@)(@@)(@@) $ 4927 - فضالة التميمي يروي المراسيل روى عنه خليد بن دعلج(@)(@@)(@@)(@@) $ 4928 - فروة بن نوفل الأشجعي أخو عبد الرحمن بن نوفل عداده في أهل الكوفة يروي عن عائشة روى عنه أبو إسحاق السبيعي وأهل الكوفة وقد قيل إن له صحبة وقد ذكرناه في الصحابة والقلب إلى تلك اللفظة ليست بمحفوظة أميل إنما قالها عبد العزيز بن مسلم القسملي عن أبي إسحاق(@)(@@)(@@)(@@) $ 4929 - فرات بن ثعلبة البهراني من أهل الشام يروي عن جماعة من أصحاب رسول الله صلى الله عليه وسلم روى عنه سليم بن عامر الخبائري وأهل الشام(@)(@@)(@@)(@@) $ 4930 - فائد بن بكير من أهل الكوفة يروي عن حذيفة روى عنه حلام بن صالح 
ms756	 وابنه بكير بن فائد PageV05P297(@)(@@)(@@)(@@) $ 4931 - فرقد مولى أوس يروي عن بن عمر روى عنه عبد الله بن يزيد بن ضبة(@)(@@)(@@)(@@) $ 4932 - فرقد المكي يروي عن عمر بن الخطاب روى عنه صفوان بن عبد الله(@)(@@)(@@)(@@) $ 4933 - فرقد الخياط يروي عن أنس بن مالك روى عنه يوسف بن زيد(@)(@@)(@@)(@@) $ 4934 - فزع بن عفيق المازني يروي عن عمر بن الخطاب روى عنه المفضل بن فضالة(@)(@@)(@@)(@@) $ 4935 - فروخ مولى عثمان بن عفان يروي عن عمر بن الخطاب روى عنه أبو يحيى المكى(@)(@@)(@@)(@@) $ 4936 - فروخ مولى عمر بن الخطاب يروي عن عمر بن الخطاب روى عنه ابنه عبد الرحمن بن فروخ(@)(@@)(@@)(@@) $ 4937 - فروخ مولى الأشتر النخعي يروي عن علي بن أبي طالب روى عنه حميد بن الأصم PageV05P298(@)(@@)(@@)(@@) $ 4938 - فروخ أبو عنان يروي عن بن عباس روى عنه أبو جناب القصاب(@)(@@)(@@)(@@) $ 4939 - فريس بن صعصعة يروي عن بن عمر روى عنه فطر بن خليفة(@)(@@)(@@)(@@) $ 4940 - فيل بن عرادة من أهل البصرة كنيته أبو سهل يروي عن جراد بن طارق روى عنه الصعق العيشي(@)(@@)(@@)(@@) $ 4941 - فرافصة بن عمير الحنفي المدني يروي عن عمر وعثمان روى عنه القاسم بن محمد وعبد الله بن محمد بن عقيل(@)(@@)(@@)(@@) $ 4942 - فطير يروي عن بن مسعود روى عنه عبد الله بن عون(@)(@@)(@@)(@@) $ 4943 - فنك من أهل اليمن يروي عن يعلى بن أمية PageV05P299 ورجل من أصحاب النبي صلى الله عليه وسلم روى عنه وهب بن منبه(@)(@@)(@@)(@@) $ 4944 - فطر بن خليفة الخياط القرشي أبو بكر من أهل الكوفة سمع أبا الطفيل روى عن عامة التابعين روى عنه أهل الكوفة مات سنة ثلاث وخمسين ومائة(@)(@@)(@@)(@@) $ 4945 - فلفلة بن عبد الله الجعفي يروي عن بن مسعود روى عنه القاسم بن حسان(@)(@@)(@@)(@@) $ 4946 - فنج شيخ يروي عن يعلى بن أمية وعن رجل من أصحاب النبي صلى الله عليه وسلم روى عبد الرزاق عن داود بن قيس الصنعاني عن عبد الله بن وهب بن منبه عن أبيه عنه في الغراس(@)(@@)(@@)(@@) ||| (النساء)(@)(@@)(@@)(@@) $$ 4947 - فاطمة بنت الحسين بن علي بن 
ms757	 أبي طالب تروي عن أسماء بنت PageV05P300 عميس روى عنها موسى الجهني ماتت وقد قاربت التسعين سنة(@)(@@)(@@)(@@) $$ 4948 - فاطمة بنت علي بن أبي طالب تروى عن أبيها ما روى عنه أهل المدينة وأهل الكوفة(@)(@@)(@@)(@@) $$ 4949 - فاطمة بنت المنذر بن الزبير بن العوام امرأة هشام بن عروة تروي عن أسماء بنت أبي بكر وهي جدتها روى عنها هشام بن عروة ومحمد بن إسحاق(@)(@@)(@@)(@@) $$ 4950 - فكيهة بنت كلاب المحاربية تروى عن عائشة روى عنها مياح بن سريع ثنا عمر بن محمد الهمداني قال ثنا أحمد بن المقدام العجلي قال ثنا محمد بن بكر البرساني قال ثنا مياح بن سريع قال حدثتني فكيهة بنت كلاب المحاربية قالت كنت عند عائشة فمرت امرأة بجرة خضراء فقالت عائشة هذا الحنتم الذي نهى رسول الله صلى الله عليه وسلم أن ينبذ فيه PageV05P301(@)(@@)(@@)(@@) || (باب القاف)(@)(@@) قال أبو حاتم وممن روى من الصحابة ورآهم ممن ابتدأ اسمه على القاف(@)(@@)(@@)(@@) $ 4951 - القاسم بن محمد بن أبي بكر الصديق كنيته أبو محمد من سادات التابعين ومن أفضل أهل زمانه علما وأدبا وعقلا وفقها وكان صموتا لا يتكلم فلما ولى عمر بن عبد العزيز قال أهل المدينة اليوم تنطق العذراء في خدرها أرادوا به القاسم بن محمد يروي عن عمته عائشة روى عنه الزهري وابنه عبد الرحمن بن القاسم مات بقديد سنة ثنتين ومائة وهو بن اثنتين وسبعين سنة بعد عمر بن عبد العزيز بسنة في ولاية يزيد بن عبد الملك وقد قيل إنه مات سنة ثمان ومائة وأمه أم ولد(@)(@@)(@@)(@@) $ 4952 - القاسم بن عبيد الله بن عبد الله بن عمر بن الخطاب يروي عن جده عبد الله روى عنه الزهري(@)(@@)(@@)(@@) $ 4953 - القاسم بن عبد الله بن ربيعة بن القائف الثقفي يروي عن سعد بن PageV05P302 أبي وقاص روى عنه يعلى بن عطاء(@)(@@)(@@)(@@) $ 4954 - القاسم بن عبد الرحمن بن عبد الله بن مسعود الهذلي من أهل الكوفة يروي عن جابر بن سمرة وكان غلب أقرانه بخصال ثلاث طول الصمت وحسن الخلق وسخاوة النفس 
ms758	 روى عنه الأعمش ومسعر بن كدام مات في إمارة خالد على العراق سنة عشرين ومائة(@)(@@)(@@)(@@) $ 4955 - القاسم بن عبد الله بن عمرو بن العاص يروي عن أبيه روى عنه ابنه يحيى بن القاسم(@)(@@)(@@)(@@) $ 4956 - القاسم بن عبيد يروي عن أنس بن مالك روى عنه عقبة بن عبد الله البصري(@)(@@)(@@)(@@) $ 4957 - القاسم بن الربيع يروي عن عبد الله بن مغفل روى عنه قتادة(@)(@@)(@@)(@@) $ 4958 - القاسم بن ربيعة بن جوشن الغطفاني يروي عن بن عمر روى عنه البصريون أيوب وخالد وحميد(@)(@@)(@@)(@@) $ 4959 - القاسم بن عاصم التميمي يروي عن رافع بن خديج روى عنه PageV05P303 حميد الطويل وأيوب السختياني(@)(@@)(@@)(@@) $ 4960 - القاسم بن صفوان بن مخرمة الزهري يروي عن بن عمر روى عنه الشعبي وبشير بن سلمان(@)(@@)(@@)(@@) $ 4961 - القاسم بن ينخسرة يروي عن بن عمر عداده في أهل اليمن روى عنه إسماعيل بن سعيد بن رمانة(@)(@@)(@@)(@@) $ 4962 - القاسم بن البرحي يروي عن عبد الله بن عمرو روى عنه الحكيم PageV05P304 بن عبد الله بن قيس(@)(@@)(@@)(@@) $ 4963 - القاسم بن محمد الثقفي يروي عن معاوية بن أبي سفيان وأسماء بنت أبي بكر روى عنه عثمان بن المنذر وقيس بن الأحنف(@)(@@)(@@)(@@) $ 4964 - القاسم بن عمير يروي عن أبي هريرة روى عنه بن أبي ذئب(@)(@@)(@@)(@@) $ 4965 - القاسم بن حسان يروي عن زيد بن ثابت روى عنه الركين بن الربيع(@)(@@)(@@)(@@) $ 4966 - القاسم بن الحكم يروي عن عثمان بن عفان روى عنه محمد بن إسحاق بن يسار(@)(@@)(@@)(@@) $ 4967 - القاسم بن عوف الشيباني البكري من أهل الكوفة يروي عن زيد بن أرقم وابن أبي أوفى روى عنه قتادة وأيوب والبصريون كأنه انتقل إلى البصرة(@)(@@)(@@)(@@) $ 4968 - القاسم بن محمد أبو نهيك الأسدي يروي عن أنس بن مالك روى عنه منصور والثوري PageV05P305(@)(@@)(@@)(@@) $ 4969 - القاسم الرحال أبو مالك يروي عن أنس بن مالك عداده في أهل البصرة ربما أخطأ روى عنه حماد بن سلمة وابن عيينة(@)(@@)(@@)(@@) $ 4970 - القاسم بن محمد أبو نهيك أصله في الكوفة سكن مرو سمع أبا زيد عمرو بن أخطب روى عنه الحسين 
ms759	 بن واقد وقد ذكرناه في أتباع التابعين لأن الناس لا يعرفون سماعه من أبي زيد(@)(@@)(@@)(@@) $ 4971 - القاسم بن مخول البهزي السلمي يروي عن أبيه وله صحبة روى عنه محمد بن سليمان بن مسمول(@)(@@)(@@)(@@) $ 4972 - القاسم بن كثير يروي عن علي بن أبي طالب روى عنه أبو هاشم الرماني(@)(@@)(@@)(@@) $ 4973 - القاسم بن يوسف اليماني يروي عن بن عمر روى عنه حنظلة بن أبي سفيان والحكم بن أبان(@)(@@)(@@)(@@) $ 4974 - القاسم بن زياد السعدي يروي عن أنس بن مالك روى عنه شبابة بن سوار(@)(@@)(@@)(@@) $ 4975 - القاسم بن البرحي يروي عن عبد الله بن عمرو روى عنه الحكيم PageV05P306 بن عبد الله بن قيس إن لم يكن البرحي المتقدم فهو آخر(@)(@@)(@@)(@@) $ 4976 - القاسم بن عثمان أبو العلاء من أهل البصرة ربما أخطأ يروي عن أنس روى عنه إسحاق بن يوسف الأزرق(@)(@@)(@@)(@@) $ 4977 - القاسم بن مخيمرة كوفي سكن الشام كنيته أبو عروة يروي عن أبي موسى الأشعري إن كان سمع منه روى عنه الأوزاعي وعبدة بن أبي لبابة وقد سأل عائشة عما تلبس المحرمة فقالت تلبس من خزها وقزها وعقدها وحليها مات في خلافة عمر بن عبد العزيز بدمشق(@)(@@)(@@)(@@) $ 4978 - قيس بن أبي حازم الكوفي كنيته أبو عبد الله وقد قيل أبو عبيد الله يروي عن العشرة روى عنه إسماعيل بن أبي خالد وأبو إسحاق السبيعي وسماك بن حرب مات سنة أربع وتسعين وقد قيل سنة ثمان وتسعين وقد قيل سنة أربع وثمانين وقد قيل سنة ستة وثمانين واسم أبي حازم عوف بن الحارث ويقال عبد عوف بن الحارث كان قيس بن أبي حازم أتى النبي صلى الله عليه وسلم ليبايعه فقدم المدينة وقد قبض النبي صلى الله عليه وسلم فبايع أبا بكر الصديق ثنا PageV05P307 بن قتيبة قال ثنا بن أبي السري قال ثنا معتمر بن سليمان قال ثنا إسماعيل بن أبي خالد عن قيس بن أبي حازم عن جرير قال كنا جلوسا مع النبي صلى الله عليه وسلم فنظر إلى القمر ليلة البدر فقال إنكم 
ms760	 سترون ربكم كما ترون هذا لا تضامون في رؤيته فإن استطعتم أن لا تغلبوا على صلاة قبل طلوع الشمس وصلاة قبل أن تغرب الشمس فافعلوا ثم قرأ الآية فسبح بحمد ربك قبل طلوع الشمس وقبل غروبها(@)(@@)(@@)(@@) $ 4979 - قيس بن حبتر التميمي النهشلي الأسدي يروي عن بن مسعود وابن عباس روى عنه علي بن بذيمة والكوفيون ثنا البغوي قال ثنا أحمد بن حنبل قال ثنا أبو أحمد الزبيري قال ثنا سفيان عن علي بن بذيمة عن قيس بن حبتر قال قال بن عباس قال رسول الله صلى الله عليه وسلم كل مسكر حرام(@)(@@)(@@)(@@) $ 4980 - قيس بن عباد اليشكري من ولد قيس بن ثعلبة من PageV05P308 روى عنه الحسن وبكر بن عبد الله المزني(@)(@@)(@@)(@@) $ 4981 - قيس بن الحارث الغامدي الشامي الحمصي يروي عن أبي سعيد الخدري روى عنه عراك بن مالك والناس(@)(@@)(@@)(@@) $ 4982 - قيس بن سعد الخارفي من أهل الكوفة كنيته أبو المغيرة يروي عن عثمان بن عفان وعلى بن أبي طالب روى عنه أبو إسحاق والقاسم بن كثير(@)(@@)(@@)(@@) $ 4983 - قيس بن السكن الأسدي الكوفى يروي عن بن مسعود روى عنه أشعث بن سليم مات في ولاية مصعب بن الزبير على العراق(@)(@@)(@@)(@@) $ 4984 - قيس بن مسلم الجدلي جديلة قيس كوفي يروي عن طارق بن شهاب وله صحبة روى عنه أهل الكوفة مات سنة عشرين ومائة كنيته أبو عمرو(@)(@@)(@@)(@@) $ 4985 - قيس بن قيس التيمي وقد قيل قيس بن أبي قيس كنيته أبو سعيد يروي عن سعد بن أبي وقاص روى عنه كليب بن وائل PageV05P309(@)(@@)(@@)(@@) $ 4986 - قيس بن عبد الشعبي شعب من همدان روى عن بن مسعود روى عنه الكوفيون(@)(@@)(@@)(@@) $ 4987 - قيس بن يزيد يروي عن بن مسعود عداده في أهل الكوفة روى عنه ابنه النعمان بن قيس(@)(@@)(@@)(@@) $ 4988 - قيس مولى خباب يروي عن بن عمر روى عنه بن جريج أحسبه بن سعد(@)(@@)(@@)(@@) $ 4989 - قيس أبو قدامة مولى لأم سلمة يروي عن أم سلمة روى عنه فرات القزاز(@)(@@)(@@)(@@) $ 4990 - قيس أبو عبد الله اليربوعي غزا 