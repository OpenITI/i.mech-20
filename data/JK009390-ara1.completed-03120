ms3101	 يريد السكون بها للمرابطة ) . |(@)(@@)(@@)(@@) $ 28801 - قال النبي صلى الله عليه وسلم : ' يكون بعدي أمراء من دخل عليهم فليقل حقا ، وإن | الرجل ليتكلم بالكلمة يرضي بها السلطان فيهوي بها أبعد من السماء ' . ( ابن منده | وابن عساكر عن بلال بن الحارث المزني رضي الله عنه ) . | PageV09P336 |(@)(@@)(@@)(@@) $ 28802 - قال النبي صلى الله عليه وسلم : ' يكون في أحد الكاهنين رجل يدرس القرآن دراسة لا | يدرسها أحد يكون بعده ' . ( حم ، والبغوي طب ، هق ، في الدلائل ، وابن عساكر | عن عبد الله بن معتب بن أبي بردة ، كر ، عن ربيعة بن أبي عبد الرحمن مرسلا عن | أبيه عن جده المظفري ) . |(@)(@@)(@@)(@@) $ 28803 - قال النبي صلى الله عليه وسلم : ' يكون من ولد العباس ملوك يلون أمر أمتي يعز الله | بهم الدين ' . ( حل ، وابن عساكر عن جابر رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28804 - قال النبي صلى الله عليه وسلم : ' يكون في آخر الزمان عند تظاهر من الفتن وانقطاع | من الزمن أمير أول ما يكون عطاؤه للناس أن يأتيه الرجل فيحثي له في حجره ، يهمه | من يقبل منه صدقة ذلك المال لما يصيب الناس من الفرج ' . ( حل ، وابن عساكر | عن أبي سعيد رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28805 - قال النبي صلى الله عليه وسلم : ' يكون في أمتي الخسف والمسخ والقذف باتخاذهم | القينات وشربهم الخمور ' . ( طب ، وابن عساكر عن أبي مالك الأشعري ، البغوي | عن هشام بن الغاز عن أبيه عن جده ربيعة ) . |(@)(@@)(@@)(@@) $ 28806 - قال النبي صلى الله عليه وسلم : ' يكون قوم من أمتي يكفرون بالله وبالقرآن وهم لا | يشعرون كما كفرت اليهود والنصارى يقرون ببعض القدر ويكفرون ببعضه ، يقولون : | الخير من الله والشر من إبليس ، فيقرون على ذلك كتاب الله ويكفرون بالقرآن بعد | الإيمان والمعرفة ، فما يلقى أمتي منهم من العداوة والبغضاء والجدال ، أولئك زنادقة | هذه الأمة ، في زمانهم يكون ظلم السلطان فينالهم من ظلم وحيف وأثرة ، ثم يبعث | الله طاعونا فيفني عامتهم ثم يكون الخسف ، فما أقل من ينجو منهم ، المؤمن يومئذ | قليل فرحه ، شديد غمه ، ثم يكون المسخ فيمسخ الله عامة أولئك قردة وخنازير ، ثم 
ms3102	 | يخرج الدجال على أثر ذلك قريبا ' . ( طب ، والبغوي عن رافع بن خديج رضي الله | عنه ) . |(@)(@@)(@@)(@@) $ 28807 - قال النبي صلى الله عليه وسلم : ' يكون في أمتي رجلان : أحدهما وهب يهب الله له | PageV09P337 | الحكمة ، والآخر غيلان فتنته على هذه الأمة أشد من فتنة الشيطان ' . ( ابن سعد | وعبد بن حميد ، ع ، طب ، هق ، في الدلائل وضعفه عن عبادة بن الصامت ، وأورده | ابن الجوزي في الموضوعات فلم يصب عن عبادة بن الصامت رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28808 - قال النبي صلى الله عليه وسلم : ' يكون في أمتي رجل يقال له صلة ، يدخل بشفاعته | الجنة كذا وكذا ' . ( ابن سعد عن عبد الرحمن بن يزيد بن جابر رضي الله عنه | بلاغا ) . |(@)(@@)(@@)(@@) $ 28809 - قال النبي صلى الله عليه وسلم : ' يكون قبل خروج الدجال نيف على سبعين | دجالا ' . ( نعيم بن حماد في الفتن عن أنس رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28810 - قال النبي صلى الله عليه وسلم : ' يكون في آخر الزمان ديدان القراء ، فمن أدرك ذلك | الزمان فليتعوذ بالله من الشيطان الرجيم وهم الأنتنون ، ثم تظهر قلانس البرود فلا | يستحيي يومئذ من الربا ، والمتمسك يومئذ بدينه كالقابض على جمرة ، والمتمسك | يومئذ بدينه أجره كأجر خمسين ، قالوا : منا أو منهم ؟ قال : بل منكم ' . ( الحكيم | عن إبان عن أنس رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28881 - قال النبي صلى الله عليه وسلم : ' يكون للمسلمين ثلاثة أمصار : مصر بملتقى | البحرين ، ومصر بالحيرة ، ومصر بالشام ، فيفزع الناس ثلاث فزعات ، فيخرج | الدجال في أعراض الناس فيهزم من قبل المشرق ، فأول مصر يرده المصر الذي | بملتقى البحرين فيصير أهلها ثلاث فرق : فرقة تقيم تقول نشامه ننظر ما هو ، وفرقة | تلحق بالأعراب ، وفرقة تلحق بالمصر الذي يليهم ، ومع الدجال سبعون ألفا عليهم | التيجان ، وأكثر من معه اليهودث والنساء ثم يأتي المصر الذي يليهم ، فيصير أهله | ثلاث فرق : فرقة تقول نشامه وننظر ما هو ، وفرقة تلحق بالأعراب ، وفرقة تلحق | بالمصر الذي يليهم ، ثم يأتي الشام فينحاز المسلمون إلى عقبة أفيق فيبعثون سرحا | PageV09P338 | لهم فيصاب سرحهم ' . ( حم ، ع ، كر ، عن عثمان بن أبي العاص 
ms3103	 رضي الله | عنه ) . |(@)(@@)(@@)(@@) $ 28812 - قال النبي صلى الله عليه وسلم : ' يكون قبل خروج المسيح الدجال سنوات خداعة ، | يكذب فيها الصادق ، ويصدق فيها الكاذب ، ويؤتمن فيها الخائن ، ويخون فيها | الأمين ، ويتكلم الرويبضة الوضيع من الناس ' . ( نعيم بن حماد في الفتن عن أبي | هريرة رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28813 - قال النبي صلى الله عليه وسلم : ' يكون بعدي خلفاء وبعد الخلفاء الأمراء ، وبعد | الأمراء الملوك ، وبعد الملوك الجبابرة ، وبعد الجبابرة رجل من أهل بيتي يملأ | الأرض عدلا ، ومن بعده القحطاني ، والذي بعثني بالحق ما هو دونه ' . ( نعيم بن | حماد في الفتن عن عبد الرحمن بن قيس بن جابر الصدفي رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28814 - قال النبي صلى الله عليه وسلم : ' يكون في ثقيف كذاب ومبير ' . ( نعيم بن حماد عن | أسماء بنت أبي بكر رضي الله عنهما ) . |(@)(@@)(@@)(@@) $ 28815 - قال النبي صلى الله عليه وسلم : ' يكون صوت في رمضان ، وتكون ملحمة عظيمة | بمنى يكثر فيها القتل ويسفك فيها الدماء حتى تسيل دماؤهم على عقبة الجمرة ' . | ( نعيم عن عمرو بن شعيب رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28816 - قال النبي صلى الله عليه وسلم : ' يكون في رمضان صوت وفي شوال معمعة ، وفي | ذي القعدة تتحارب القبائل ، وفي ذي الحجة ينتهب الحاج ، وفي المحرم ينادي مناد | من السماء ألا إن صفوة الله من خلقه فلان فاسمعوا له وأطيعوا ' . ( نعيم عن شهر بن | حوشب مرسلا ) . |(@)(@@)(@@)(@@) $ 28817 - قال النبي صلى الله عليه وسلم : ' يكون في النار قوم ما شاء الله أن يكونوا ، ثم | يرحمهم الله فيخرجهم فيكونوا في واد من أدنى الجنة فيغتسلون في نهر يقال له | PageV09P339 | الحيوان ، فيسميهم أهل الجنة الجهنميين ، لو أضاف أحدهم أهل الدنيا لأطعمهم | وسقاهم وفرشهم ولحفهم وزوجهم لا ينقص ذلك مما عنده شيئا ' . ( حم ، وابن | عساكر عن ابن مسعود رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28818 - قال النبي صلى الله عليه وسلم : ' يكون عليكم أمراء تطمئن إليهم القلوب ، وتلين لهم | الجلود ، ثم يكون عليكم أمراء تشمئز منهم القلوب ، وتقشعر منهم الجلود ، قيل : | أفلا نقاتلهم يا رسول الله ؟ قال : لا ، ما أقاموا الصلاة 
ms3104	 ' . ( حم ، ع ، ض ، عن | أبي سعيد رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28819 - قال النبي صلى الله عليه وسلم : ' يكون خلف من بعد ستين سنة أضاعوا الصلاة واتبعوا | الشهوات فسوف يلقون غيا ، ثم يكون خلف يقرأون القرآن لا يعدو تراقيهم ، ويقرأ | القرآن ثلاثة : مؤمن ومنافق وفاجر ' . ( حم ، حب ، ك ، هب ، عن أبي | سعيد رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28820 - قال النبي صلى الله عليه وسلم : ' يكون في هذه الأمة خسف ومسح وقذف ، إذا ظهرت القينات ، والمعازف ، واستحلت الخمور ' . ( عبد بن حميد وابن أبي الدنيا | في ذم الملاهي وابن النجار عن سهل بن سعد رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28821 - قال النبي صلى الله عليه وسلم : ' يكون عليكم أمراء إن أطعتموهم أدخلوكم النار ، | وإن عصيتموهم قتلوكم ، فقال رجل : يا رسول الله ! سمهم لنا لعلنا نحثو في | وجوههم التراب ، فقال : لعلهم يحثون في وجهك ويفقأون عينك ' . ( طب ، | ض ، عن عبادة بن الصامت رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28822 - قال النبي صلى الله عليه وسلم : ' يكون في آخر أمتي الخسف والقذف والمسخ ' . | ( ه ، عن سهل بن سعد بن أبي خيثمة عن هشام بن الغاز عن أبيه عن جده ربيعة | الجرشي رضي الله عنه ) . | PageV09P340 |(@)(@@)(@@)(@@) $ 28823 - قال النبي صلى الله عليه وسلم : ' يكون في أمتي المهدي ، إن قصر عمره فسبع | سنين ، وإلا فثمان ، وإلا فتسع سنين ، تنعم أمتي في زمانه نعيما لم ينعموا مثله قط ، | البر منهم والفاجر ، ترسل السماء عليهم مدرارا ، ولا تدخر الأرض شيئا من نباتها ، | ويكون المال كدوسا ، يقوم الرجل فيقول : يا مهدي ! أعطني فيقولث : خذ ' . ( قط | في الأفراد ، طس ، عن أبي هريرة عن أبي سعيد رضي الله عنهما ) . |(@)(@@)(@@)(@@) $ 28824 - قال النبي صلى الله عليه وسلم : ' يكون بعدي أمراء : صحبتهم بلاء ، ومفارقتهم | كفر ' . ( ابن النجار عن عمر رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28825 - قال النبي صلى الله عليه وسلم : ' يكون في أمتي قذف ومسخ وخسف : إذا ظهرت | المعازف ، وكثرت القينات ، وشربت الخمور ' . ( ابن أبي الدنيا في ذم الملاهي عن | عمران بن حصين رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28826 - قال النبي صلى الله عليه وسلم : ' يكون 
ms3105	 في آخر الزمان : أمراء ظلمة ، ووزراء فسقة ، | وقضاة خونة ، وفقهاء كذبة ، فمن أدركهم فلا يكونن لهم عريفا ولا جابيا ولا خازنا ولا | شرطيا ' . ( الخطيب عن أبي هريرة رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28827 - قال النبي صلى الله عليه وسلم : ' يكون قوم في آخر الزمان يسمون الرافضة ، يرفضون | الإسلام ويلفظونه فاقتلوهم فإنهم مشركون ' . ( عبد بن حميد ، طب ، عن ابن | عباس رضي الله عنهما ) . |(@)(@@)(@@)(@@) $ 28828 - قال النبي صلى الله عليه وسلم : ' يكون بالشام جند ، وبالعراق جند ، وباليمن جند ، | فقال رجل : يا رسول الله ! خر لي ، فقال : عليك بالشام فإن الله قد تكفل بالشام | وأهله ' . ( طب ، عن عبد الله بن يزيد رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28829 - قال النبي صلى الله عليه وسلم : ' يكون من بعدي قوم يقرأون القرآن لا يجاوز | تراقيهم ، يمرقون من الدين لا يعودون فيه حتى يعود السهم إلى فوقه ، طوبى لمن | قتلهم وطوبى لمن قتلوه شر قتلى ، أظلتهم السماء ، وأقلتهم الأرض كلاب أهل | النار ' . ( طب ، عن عبد الله بن خبان بن الأرت رضي الله عنه ) . | PageV09P341 |(@)(@@)(@@)(@@) $ 28830 - قال النبي صلى الله عليه وسلم : ' يكون في آخر أمتي شراب هو الخمر يستحلونه باسم | يسمونه غير الخمر ' . ( طب ، عن عبادة بن الصامت رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28831 - قال النبي صلى الله عليه وسلم : ' يكون في آخر هذه الأمة رجال يركبون على المياثر | حتى يأتوا أبواب المساجد ، نساؤهم كاسيات عاريات على رؤوسهن كأسنمة البخت | العجاف ، العنوهن فإنهن ملعونات ، لو كانت وراءكم أمة من الأمم لخدمهم كما | خدمكم نساء الأمم قبلكم ' . ( ك ، عن ابن عمرو رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28832 - قال النبي صلى الله عليه وسلم : ' يكون في آخر الزمان في هذه الأمة ناس معهم سياط | كأنها أذناب البقر يغدون في سخط الله ويروحون في غضبه ' . ( حم ، ك ، عن أبي | أمامة رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28833 - قال النبي صلى الله عليه وسلم : ' يكون كنز أحدكم يوم القيامة شجاعا أقرع ذا زبيبتين | يتبع صاحبه وهو يتعوذ منه ، فلا يزال يتبعه وهو يفر منه حتى يلقمه أصبعه ' . ( ك ، | عن أبي هريرة رضي الله 
ms3106	 عنه ) . |(@)(@@)(@@)(@@) $ 28834 - قال النبي صلى الله عليه وسلم : ' يكون في أمتي أقوام أشداء أحداء ذليقة ألسنتهم | بالقرآن لا يجاوز تراقيهم ، ألا فإذا رأيتموهم فأنيموهم ثم إذا رأيتموهم فأنيموهم | فالمأجور قاتلهم ' . ( حم ، ك ، عن أبي بكرة رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28835 - قال النبي صلى الله عليه وسلم : ' يكون في آخر الزمان أقوام إخوان العلانية ، أعداء | السريرة ، فقيل يا رسول الله فكيف يكون ذلك ، قال : ذلك برغبة بعضهم إلى بعض | ورهبة بعضهم إلى بعض ' . ( حم ، حل ، عن معاذ رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28836 - قال النبي صلى الله عليه وسلم : ' يكون بعدي قوم يأخذون الملك يقتل عليه بعضهم | بعضا ' . ( حم ، عن عمار رضي الله عنه ) . | PageV09P342 |(@)(@@)(@@)(@@) $ 28837 - قال النبي صلى الله عليه وسلم : ' يكون الناس مجدبين فينزل الله عليهم رزقا من رزقه | فيصبحون مشركين يقولون : مطرنا بنوء كذا وكذا ' . ( حم ، عن معاوية رضي الله | عنه ) . |(@)(@@)(@@)(@@) $ 28838 - قال النبي صلى الله عليه وسلم : ' يكون في آخر الزمان قوم يحضرون السلطان | فيحكمون بغير حكم الله ولا ينهونه فعليهم لعنة الله ' . ( أبو نعيم والديلمي عن ابن | مسعود رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28839 - قال النبي صلى الله عليه وسلم : ' يكون في أمتي رجال طلس رءوسهم ، دنس | ثيابهم ، لو أقسموا على الله لأبرهم ' . ( الديلمي عن أبي موسى رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28840 - قال النبي صلى الله عليه وسلم : ' يكون بعدي قصاص لا ينظر الله إليهم ' . | ( الديلمي عن علي رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28841 - قال النبي صلى الله عليه وسلم : ' يكون لهذه الأمة اثنا عشر قيما لا يضرهم من | خذلهم ، كلهم من قريش ' . ( طب ، عن جابر بن سمرة رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28842 - قال النبي صلى الله عليه وسلم : ' يكون من بعدي اثنا عشر خليفة كلهم من قريش ' . | ( طب ، عن جابر بن سمرة رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28843 - قال النبي صلى الله عليه وسلم : ' يكون بعدي من الخلفاء عدة نقباء موسى ' . | ( نعيم بن حماد في الفتن عن ابن مسعود رضي الله عنه ) . | PageV09P343 |(@)(@@)(@@)(@@) ||| ( الياء مع اللام )(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ 28844 - قال النبي صلى الله عليه وسلم : ' يلبي 
ms3107	 المعتمر حتى يستلم الحجر ' . ( د ، عن ابن | عباس رضي الله عنهما ) . |(@)(@@)(@@)(@@) $ 28845 - قال النبي صلى الله عليه وسلم : ' يلقى إبراهيم أباه آزر يوم القيامة وعلى وجه آزر قترة | وغبرة فيقول له إبراهيم : ألم أقل لك لا تعصيني ؟ فيقول أبوه : فاليوم لا أعصيك ، | فيقول إبراهيم : يا رب ! إنك وعدتني أنك لا تخزيني يوم يبعثون ، وأي خزي أخزى | من أبي الأبعد ؟ فيقول الله : إني حرمت الجنة على الكافرين ، فيقال : يا إبراهيم | انظر ما بين رجليك ، فينظر فإذا هو بذيخ ملتطخ فيؤخذ بقوائمه فيلقى في | النار ' . ( خ ، عن أبي هريرة رضي الله عنه ، ز ) |(@)(@@)(@@)(@@) $ 28846 - قال النبي صلى الله عليه وسلم : ' يلقى على أهل النار الجوع فيعدل ما هم فيه من | العذاب فيستغيثون بالطعام فيغاثون بطعام ذي غصة فيذكرون أنهم كانوا يجيزون | الغصص في الدنيا بالشراب فيستغيثون بالشراب فيدفع إليهم الحميم بكلاليب | الحديد ، فإذا دنت من وجوههم شوت وجوههم ، فإذا دخلت بطونهم قطعت ما في | بطونهم فيقولون : ادعوا خزنة جهنم ، فيقولون : ألم تك تأتيكم رسلكم بالبينات ؟ | قالوا : بلى ، قال : فادعوا وما دعاء الكافرين إلا في ضلال ، فيقولون : ادعوا مالكا | فيقولون : يا مالك ! ليقض علينا ربك ، فيجيبهم إنكم ماكثون | فيقولون : ادعوا ربكم ، فلا أحد خير من ربكم ، فيقولون : ربنا غلبت علينا شقوتنا | وكنا قوما ضالين ، ربنا أخرجنا منها فإن عدنا فإنا ظالمون ، فيجيبهم اخسؤوا فيها ولا | تكلمون فعند ذلك يئسوا من كل خير ، وعند ذلك يأخذون في الزفير والحسرة | PageV09P344 | والويل ' . ( ش ، ت ، عن أبي الدرداء رضي الله عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28847 - قال النبي صلى الله عليه وسلم : ' يلقى عيسى حجته في قوله ^ ( وإذ قال الله يا | عيسى بن مريم أأنت قلت للناس اتخذوني وأمي إلهين من دون الله ) ^ فلقاه الله : | ^ ( سبحانك ما يكون لي أن أقول ما ليس لي بحق ) ^ الآية كلها ' . ( ت ، عن أبي | هريرة رضي الله عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28848 - قال النبي صلى الله عليه وسلم : ' يلي رجل من أهل بيتي يواطئ اسمه اسمي لو لم | يبق من الدنيا إلا يوم لطول الله ذلك 
ms3108	 اليوم حتى يلي ' . ( ت ، عن ابن مسعود وأبي | هريرة رضي الله عنهما . ز ) . |(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ 28849 - قال النبي صلى الله عليه وسلم : ' يلحد رجل من قريش بمكة يقال له عبد الله ، عليه | شطر عذاب العالم ' . ( عن ابن عمرو رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28850 - قال النبي صلى الله عليه وسلم : ' يلجم الناس العرق إلى شحمة أذنيه ' . ( ك ، عن | ابن عمر رضي الله عنهما ) . |(@)(@@)(@@)(@@) $ 28851 - قال النبي صلى الله عليه وسلم : ' يلحد بمكة كبش من قريش اسمه عبد الله ، عليه | مثل أوزار نصف الناس ' . ( حم ، عن عثمان رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28852 - قال النبي صلى الله عليه وسلم : ' يلحد رجل من قريش بمكة يكون عليه نصف عذاب | العالم ' . ( حم ، عن عثمان رضي الله عنه ، ورجال الحديثين ثقات ) . |(@)(@@)(@@)(@@) $ 28853 - قال النبي صلى الله عليه وسلم : ' يلزم الوالد من العقوق لولده ما يلزم الولد من العقوق | لوالده ' . ( ابن النجار عن أبي هريرة رضي الله عنه ) . | PageV09P345 |(@)(@@)(@@)(@@) $ 28854 - قال النبي صلى الله عليه وسلم : ' يلزم الوالدين من البر لولدهما ما يلزم الولد : يؤدبانه | ويزوجانه ' . ( أبو نعيم عن أبي هريرة رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28855 - قال النبي صلى الله عليه وسلم : ' يلقى رجل أباه يوم القيامة فيقول له يا أبت أي ابن | كنت لك ؟ فيقول خير ابن ، فيقول هل أنت مطيعي اليوم ؟ فيقول نعم ، فيقول : خذ | بأزرتي فيأخذ بأزرته ثم ينطلق حتى يأتي الله وهو يعرض الخلق فيقول : يا عبدي | ادخل من أي أبواب الجنة شئت ، فيقول : أي رب وأبي معي ، فإنك وعدتني أن لا | تخزيني ، فيمسخ الله أباه ضبعا فيهوي في النار فيأخذ بأنفه فيقول الله : يا عبدي ! | أبوك هو فيقول : لا وعزتك ' . ( بز ، ك ، عن أبي هريرة رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28856 - قال النبي صلى الله عليه وسلم : ' يلقى الله شارب الخمر يوم القيامة حين يلقاه وهو | سكران فيقول : ويلك ما شربت ؟ فيقول الخمر فيقول : ألم أحرمها عليك ؟ فيقول : | بلى . فيؤمر به إلى النار ' . ( عب ، عن معمر عن إبان عن الحسن مرسلا ) . |(@)(@@)(@@)(@@) $ 28857 - قال النبي صلى الله 
ms3109	 عليه وسلم : ' يلقى في النار أهلها وتقول هل من مزيد ؟ حتى يضع | الله فيها قدمه فتقول : قط قط ' . ( قط ، في الصفات عن أنس رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28858 - قال النبي صلى الله عليه وسلم : ' يلقى في النار أهلها وتقول هل من مزيد ؟ حتى يأتيها | تبارك وتعالى فيضع فيها قدمه فتنزوي فتقول : قط قط ' . ( قط ، في الصفات عن أبي | هريرة رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 288859 - قال النبي صلى الله عليه وسلم : ' يلقى البكاء على أهل النار فيبكون حتى تنفد الدموع | ثم يبكون الدماء حتى إنه ليصير في وجوههم أخدود لو أرسلت فيها سفينة لجرت ' . | ( هناد عن أنس رضي الله عنه ) . | PageV09P346 |(@)(@@)(@@)(@@) ||| ( الياء مع الميم )(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ 28860 - قال النبي صلى الله عليه وسلم : ' يمكث أبو الدجال وأمه ثلاثين عاما لا يولد لهما | ولد ، ثم يولد لهما غلام أعور أضر شيء وأقله منفعة ، تنام عيناه ولا ينام قلبه ، أبوه | طوال ضرب اللحم كأن أنفه منقار ، وأمه امرأة فرضاخية طويلة الثديين ' . ( حم ، | ت ، عن أبي بكرة رضي الله عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28861 - قال النبي صلى الله عليه وسلم : ' يمكث المهاجر بمكة بعد قضاء نسكه ثلاثا ' . | ( حم ، م ، ت ، ن ، عن العلاء بن الحضرمي رضي الله عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28862 - قال النبي صلى الله عليه وسلم : ' يمن الخيل في شقرها ' . ( حم ، د ، ت ، عن | ابن عباس رضي الله عنهما ) . |(@)(@@)(@@)(@@) $ 28863 - قال النبي صلى الله عليه وسلم : ' يمينك على ما يصدقك عليه صاحبك ' . ( حم ، | م ، د ، ه ، عن أبي هريرة رضي الله عنه ) . |(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ 28864 - قال النبي صلى الله عليه وسلم : ' يمثل القرآن يوم القيامة رجلا فيؤتى بالرجل قد حمله | فخالف أمره ، فينتشل له خصما فيقول : يا رب ! حملته إياي فبئس حاملي ، تعدى | حدودي ، وضيع فرائضي ، وركب معصيتي ، وترك طاعتي ، فما يزال يقذف عليه | بالحجج حتى يقال فشأنك ، فيأخذه بيده ، فما يرسله حتى يكبه على منخره في | PageV09P347 | النار ، ويؤتى بالرجل الصالح قد كان حمله وحفظ أمره فينتشل له خصما دونه فيقول : | يا رب حملته إياي 
ms3110	 فحفظ حدودي وعمل بفرائضي ، واجتنب معصيتي واتبع طاعتي ، | فما يزال يقذف له بالحجج حتى يقال له : شأنك به ، فيأخذه بيده فما يرسله حتى | يلبسه حلة الاستبرق ، ويعقد عليه تاج الملك ، ويسقيه كأس الخمر ' . ( ش ، وابن | الضريس عن عمرو بن شعيب عن أبيه عن جده ) |(@)(@@)(@@)(@@) $ 28865 - قال النبي صلى الله عليه وسلم : ' يمر الناس على جسر جهنم وعليه حسك وكلاليب | وخطاطيف يخطف الناس يمينا وشمالا ، وجنبتيه ملائكة يقولون : اللهم سلم سلم ، | فمن الناس من يمر مثل البرق ، ومنهم من يمر مثل الريح ، ومنهم من يمر مثل | الفرس ، ومنهم من يسعى سعيا ، ومنهم من يمشي مشيا ، ومنهم من يحبو حبوا ، | ومنهم من يزحف زحفا ، فأما أهل النار الذين هم أهلها فلا يموتون ولا يحيون ، وأما | أناس يؤخذون بذنوب وخطايا فيحترقون فيكونون فحما ثم يؤذن في الشفاعة فيؤخذون | ضبائر ضبائر فيقذفون على نهر من أنهار الجنة فينبتون كما تنبت الحبة في حميل | السيل ، أما رأيتم الصبغاء شجرة تنبت في الغثاء فيكون من آخر من أخرج من النار | رجل على شفتها فيقول : يا رب اصرف وجهي عنها ، فيقول : عهدك وذمتك لا | تسألني غيرها ، وعلى الصراط ثلاث شجرات ، فيقول : يا رب حولني إلى هذه | الشجرة آكل من ثمرها وأكون في ظلها ، فيقول عهدك وذمتك لا تسألني غيرها ، ثم | يرى أخرى هي أحسن منها فيقول : يا رب حولني إلى هذه آكل من ثمرها وأكون في | ظلها فيقول : عهدك وذمتك لا تسألني غيرها ، ثم يرى أخرى فيقول يا رب حولني إلى | هذه آكل من ثمرها وأكون في ظلها ، ثم يرى سواد الناس ويسمع كلامهم فيقول يا رب | أدخلني الجنة فيدخله الجنة فيعطى الدنيا ومثلها ' . ( حم ، ع ، حب ، ك ، عن أبي | سعيد رضي الله عنه ) . | PageV09P348 |(@)(@@)(@@)(@@) $ 28866 - قال النبي صلى الله عليه وسلم : ' يمسح المسافر ثلاثة أيام والمقيم يوما وليلة ' . | ( هق ، في المعرفة عن خزيمة بن ثابت رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28867 - قال النبي صلى الله عليه وسلم : ' يمسخ قوم من أمتي في آخر الزمان قردة وخنازير ، | قيل : يا رسول 
ms3111	 الله ! ويشهدون أن لا إله إلا الله وأنك رسول الله ويصومون ؟ قال : | نعم ، قيل : فما بالهم يا رسول الله ؟ قال : يتخذون المعازف والقينات والدفوف | ويشربون الأشربة فباتوا على شربهم ولهوهم فأصبحوا قد مسخوا قردة وخنازير ' . | ( حل ، عن أبي هريرة رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28868 - قال النبي صلى الله عليه وسلم : ' يمكث الدجال في الأرض أربعين سنة ، السنة | كالشهر ، والشهر كالجمعة ، والجمعة كاليوم واليوم كاضطرام السعفة في النار ' . | ( حم ، وابن عساكر عن أسماء بنت يزيد رضي الله عنها ) . |(@)(@@)(@@)(@@) $ 28869 - قال النبي صلى الله عليه وسلم : ' يملك الناس رجل من أهل بيتي اسمه اسمي ، | واسم أبيه اسم أبي ، يملأ الأرض قسطا وعدلا كما ملئت ظلما وجورا ' . ( طب ، | والخطيب عن ابن مسعود رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28870 - قال النبي صلى الله عليه وسلم : ' يملك هذه الأمة اثنا عشر خليفة ، كعدة نقباء بني | إسرائيل ' . ( حم ، طب ، ك ، عن ابن مسعود رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28871 - قال النبي صلى الله عليه وسلم : ' يمن الخيل في شقرها ، وأيمنها ناصية ما كان منها | أغر محجل مطلق اليد اليمنى ' . ( طب ، عن ابن عباس رضي الله عنهما ) . |(@)(@@)(@@)(@@) $ 28872 - قال النبي صلى الله عليه وسلم : ' يموت عبد الله بن سلام وهو آخذ بالعروة | الوثقى ' . ( طب ، عن عبد الله بن سلام رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28873 - قال النبي صلى الله عليه وسلم : ' يمين الله عز وجل طباق السموات والأرض ' . | PageV09P349 | ( الديلمي عن أبي أمامة وشداد بن أوس رضي الله عنهما معا ) . |(@)(@@)(@@)(@@) $ 28874 - قال النبي صلى الله عليه وسلم : ' يميني لوجهي وشمالي لفرجي ' . ( عب ، عن | إبراهيم بن محمد عن الحويرث مرسلا ) . |(@)(@@)(@@)(@@) $ 28875 - قال النبي صلى الله عليه وسلم : ' يمين الله ملأى لا يغيضها نفقة سحا الليل والنهار ، | أرأيتم ما أنفق منذ خلق السموات والأرض ، فإنه لا ينقص ما في يمينه وعرشه على | الماء ، وبيده الأخرى الميزان يخفض ويرفع ' . ( قط في الصفات عن أبي | هريرة رضي الله عنه ) . |(@)(@@)(@@)(@@) ||| ( الياء مع النون )(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ 2876 - قال النبي صلى الله عليه وسلم : ' ينادي مناد : إن لكم أن تصحوا 
ms3112	 فلا تسقموا أبدا ، | وإن لكم أن تحيوا فلا تموتوا أبدا ، وإن لكم أن تشبوا فلا تهرموا أبدا ، وإن لكم أن | تنعموا فلا تبأسوا أبدا ' . ( حم ، م ، ت ، ه ، عن أبي سعيد وأبي هريرة رضي الله | عنهما ، ز ) . |(@)(@@)(@@)(@@) $ 28877 - قال النبي صلى الله عليه وسلم : ' ينزل الله تعالى إلى السماء الدنيا كل ليلة حين | يمضي ثلث الليل الأول ، فيقول : أنا الملك ، أنا الملك ، من ذا الذي يدعوني | فأستجيب له ؟ من ذا الذي يسألني فأعطيه ؟ من ذا الذي يستغفرني فأغفر له ؟ فلا يزال | كذلك حتى يضيء الفجر ' . ( م ، ت ، عن أبي هريرة رضي الله عنه ، ز ) |(@)(@@)(@@)(@@) $ 28878 - قال النبي صلى الله عليه وسلم : ' ينزل الله تعالى في السماء الدنيا لثلث الليل الآخر | فيقول : من يدعوني فأستجيب له ، أو يسألني فأعطيه ؟ ثم يبسط يديه يقول : من | يقرض غير عديم ولا ظلوم ' . ( م ، عن أبي هريرة رضي الله عنه ، ز ) . | PageV09P350 |(@)(@@)(@@)(@@) $ 28879 - قال النبي صلى الله عليه وسلم : ' ينزل الله في كل ليلة إلى سماء الدنيا فيقول : هل | من سائل فأعطيه ؟ هل من مستغفر فأغفر له ؟ هل من تائب فأتوب عليه حتى يطلع | الفجر ' . ( حم ، ن ، عن جبير بن مطعم رضي الله عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28880 - قال النبي صلى الله عليه وسلم : ' ينزل ربنا تبارك وتعالى كل ليلة إلى السماء الدنيا حين | يبقى ثلث الليل الآخر فيقول من يدعوني فأستجيب له ؟ من يسألني فأعطيه ، من | يستغفرني فأغفر له ' . ( حم ، ق ، د ، ت ، ه ، عن أبي هريرة رضي الله عنه ، | ز ) |(@)(@@)(@@)(@@) $ 28881 - قال النبي صلى الله عليه وسلم : ' ينزل عيسى بن مريم عند المنارة البيضاء شرقي | دمشق ' . ( طب ، عن أوس بن أوس رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28882 - قال النبي صلى الله عليه وسلم : ' ينزل في الفرات كل يوم مثاقيل من بركة الجنة ' . | ( خط ، عن ابن مسعود رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28883 - قال النبي صلى الله عليه وسلم : ' ينزل ناس من أمتي بغائط يسمونه البصرة عند نهر | يقال له دجلة ، يكون عليه جسر يكثر أهلها وتكون من أمصار المسلمين ، فإذا 
ms3113	 كان في | آخر الزمان جاء بنو قنطوراء : قوم عراض الوجوه ، صغار الأعين حتى ينزلوا على شط | النهر فيتفرق أهلها ثلاث فرق : فرقة يأخذون أذناب البقر والبرية وهلكوا ، وفرقة | يأخذون لأنفسهم وكفروا ، وفرقة يجعلون ذراريهم خلف ظهورهم ويقاتلونهم وهم | الشهداء ' . ( حم ، د ، عن أبي بكرة رضي الله عنه ، ز ) |(@)(@@)(@@)(@@) $ 28884 - قال النبي صلى الله عليه وسلم : ' ينشأ نشؤ يقرأون القرآن لا يجاوز تراقيهم ، كلما | خرج قرن قطع ، كلما خرج قرن قطع ، حتى يخرج في أعراضهم الدجال ' . ( ه ، | عن ابن عمر رضي الله عنهما ، ز ) . | PageV09P351 |(@)(@@)(@@)(@@) $ 28885 - قال النبي صلى الله عليه وسلم : ' ينضح بول الغلام ، ويغسل بول الجارية ' . ( ت ، | ك ، عن علي رضي الله عنه ، ز ) . |(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ 28886 - قال النبي صلى الله عليه وسلم : ' ينجيكم من ذلك أن تقولوا مثل الذي أمرت به عمي | عند الموت فلم يفعل ' . ( حم ، ع ، عن أبي بكر قال : سألت رسول الله صلى الله عليه وسلم ما | الذي ينجينا من هذا الحديث الذي يلقي الشيطان في أنفسنا ؟ قال : فذكره وحسن ) . |(@)(@@)(@@)(@@) $ 28887 - قال النبي صلى الله عليه وسلم : ' ينادي يوم القيامة مناد : ألا ليقم خصماء الله وهم | القدرية ' . ( ابن راهويه ، ع ، عن محمد بن عباد عن أبي هريرة رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28888 - قال النبي صلى الله عليه وسلم : ' ينادي مناد يوم القيامة من بطنان العرش : ألا | فليقم من كان أجره على الله ، فلا يقوم إلا من عفا عن أخيه ' . ( كر ، عن | علي رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28889 - قال النبي صلى الله عليه وسلم : ' ينادي مناد في النار : يا حنان يا منان ! نجني من | النار ، فيأمر الله ملكا فيخرجه ، حتى يوقف بين يديه ، فيقول الله عز وجل : هل | رحمت في شيئا قط فأرحمك هل رحمت عصفورا ' . ( ابن شاهين عن أبي | الدرداء رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28890 - قال النبي صلى الله عليه وسلم : ' ينادي مناد بين يدي الصيحة : يا أيها الناس ! أتتكم | الساعة فيسمعه الأحياء والأموات وينزل الله إلى السماء الدنيا ، ثم ينادي مناد : لمن | الملك اليوم ؟ لله الواحد 
ms3114	 القهار ' . ( الديلمي عن أبي سعيد رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28891 - قال النبي صلى الله عليه وسلم : ' ينبغي للمؤمن أن لا يمسي إلا حزينا وإن كان | محسنا ، ولا يصبح إلا حزينا وإن كان محسنا لأنه بين مخافتين : ذنب قد مضى منه لا | PageV09P352 | يدري ما الله صانع فيه ، وما بقي من عمره لا يدري ما يصيبه فيه من المهالك ' . | ( الديلمي عن أبي أمامة رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28892 - قال النبي صلى الله عليه وسلم : ' ينبغي للعاقل أن لا يكون شاخصا إلا في ثلاث | طلب لمعاش ، أو خطوة لمعاد ، أو لذة في غير محرم ' . ( الخطيب والديلمي عن | علي رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28893 - قال النبي صلى الله عليه وسلم : ' ينبغي للمؤمنين أن يكونوا فيما بينهم كمنزلة رجل | واحد ، إذا اشتكى عضو من جسده تداعى له سائر جسده ' . ( طب ، عن النعمان بن | بشير رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28894 - قال النبي صلى الله عليه وسلم : ' ينبغي للعالم أن يكون قليل الضحك كثير البكاء ، لا | يمازح ولا يصاحب ، ولا يماري ولا يجادل ، إن تكلم تكلم بحق ، وإن صمت صمت | على الباطل ، وإن دخل دخل برفق ، وإن خرج خرج بحلم ' . ( الديلمي عن | أبي رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28895 - قال النبي صلى الله عليه وسلم : ' ينزل الله كل يوم عشرين ومائة رحمة : ستون منها | للطائفين ، وأربعون للعاكفين حول البيت ، وعشرون منها للناظرين إلى البيت ' . | ( طب ، عن ابن عباس رضي الله عنهما ) . |(@)(@@)(@@)(@@) $ 28896 - قال النبي صلى الله عليه وسلم : ' ينزل الله تعالى كل يوم مائة رحمة : ستين منها على | الطائفين بالبيت ، وعشرين على أهل مكة ، وعشرين على سائر الناس ' . ( هب ، | عن ابن عباس رضي الله عنهما ) . |(@)(@@)(@@)(@@) $ 28897 - قال النبي صلى الله عليه وسلم : ' ينزل الله كل يوم مائة رحمة وعشرين رحمة : منها | على الطائف ستون ، وأربعون على المصلين ، وعشرون على الناظرين ' . ( هب ، | عن ابن عباس رضي الله عنهما ) . | PageV09P353 |(@)(@@)(@@)(@@) $ 28898 - قال النبي صلى الله عليه وسلم : ' ينزل ربنا تبارك وتعالى إلى السماء الدنيا حين يبقى | ثلث الليل فيقول : ألا عبد من عبادي يدعوني فأستجيب له 
ms3115	 ، ألا ظالم لنفسه يدعوني | فأغفر له ، ألا مقتر رزقه ، ألا مظلوم يدعوني فأنصره ، ألا عان يدعوني فأفك عانه ، | فيكون كذلك حتى يصبح الصبح ، ثم يعلو عز وجل على كرسيه ' . ( طب ، عن | عبادة بن الصامت رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28899 - قال النبي صلى الله عليه وسلم : ' ينزل الله في آخر ثلاث ساعات يبقين من الليل | فينظر الله في الساعة الأولى منهن في الكتاب الذي لا ينظر فيه غيره فيمحو ما يشاء | ويثبت ، ثم ينظر في الساعة الثانية في جنة عدن وهي مسكنه الذي يسكن لا يكون معه | فيها أحد إلا الأنبياء والشهداء والصديقون ، وفيها ما لم يره أحد ، ولا خطر على قلب | بشر ، ثم يهبط آخر ساعة من الليل فيقول : ألا مستغفر يستغفرني فأغفر له ، ألا سائل | يسألني فأعطيه ، ألا داع يدعوني فأستجيب له ، حتى يطلع الفجر ، وذلك قول الله : | ^ ( وقرآن الفجر إن قرآن الفجر كان مشهودا ) ^ فيشهده الله وملائكة الليل | والنهار ' . ( ابن جرير وابن أبي حاتم ، طب ، وابن مردويه عن أبي الدرداء رضي الله | عنه ) . |(@)(@@)(@@)(@@) $ 28900 - قال النبي صلى الله عليه وسلم : ' ينزل الله إلى السماء الدنيا ليلة النصف من شعبان | فيغفر لكل شيء إلا رجل مشرك أو رجل في قلبه شحناء ' . ( ابن زنجويه والبزار | وحسنه ، قط ، عد ، هب ، عن القاسم بن محمد بن أبي بكر الصديق عن أبيه أو عن | عمه عن جده ) . |(@)(@@)(@@)(@@) $ 28901 - قال النبي صلى الله عليه وسلم : ' ينزل الله إلى السماء الدنيا ليلة النصف من شعبان | فيغفر لكل مؤمن إلا العاق والمشاحن ' . ( ابن خزيمة ، هب ، عن أبي بكر رضي | الله عنه ) . | PageV09P354 |(@)(@@)(@@)(@@) $ 28902 - قال النبي صلى الله عليه وسلم : ' ينزل ربنا إلى السماء الدنيا في النصف من شعبان | فيغفر لأهل الأرض إلا مشركا أو مشاحنا ' . ( ابن زنجويه عن أبي موسى رضي الله | عنه ) . |(@)(@@)(@@)(@@) $ 28903 - قال النبي صلى الله عليه وسلم : ' ينزل الله في كل ليلة إلى السماء الدنيا حين يبقى | نصف الليل الآخر أو ثلث الليل الآخر فيقول : من ذا الذي يدعوني فأستجيب له ، | من ذا الذي يسألني 
ms3116	 فأعطيه ، من ذا الذي يستغفرني فأغفر له ؟ حتى ينصدع الفجر | وينصرف القارئ من صلاة الفجر ' . ( ابن النجار عن أبي هريرة رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28904 - قال النبي صلى الله عليه وسلم : ' ينزل عيسى بن مريم عند باب دمشق عند المنارة | البيضاء لست ساعات من الليل في ثوبين ممشقين كأنما يتحدر من رأسه اللؤلؤ ' . | ( تمام وابن عساكر عن عبد الرحمن بن أيوب بن نافع بن كيسان عن أبيه عن جده ) . |(@)(@@)(@@)(@@) $ 28905 - قال النبي صلى الله عليه وسلم : ' ينزل عيسى بن مريم قبل يوم القيامة فيكسر | الصليب ، ويقتل الخنزير ، ويجتمع الناس على الدين ، ويضع الجزية ' . ( ابن سعد | عن أبي هريرة رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28906 - قال النبي صلى الله عليه وسلم : ' ينزل عيسى بن مريم على ثمانمائة رجل وأربعمائة | امرأة أخيار من على الأرض ، وأصلح من مضى ' . ( الديلمي عن أبي | هريرة رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28907 - قال النبي صلى الله عليه وسلم : ' ينزل الدجال بهذه السبخة بمر قناة فيكون آخر من | يخرج إليه النساء ، حتى إن الرجل ليرجع إلى أمه وابنته وأخته وعمته فيوثقها رباطا | مخافة أن يخرجن إليه ، ثم يسلط الله المسلمين عليه فيقتلونه ويقتلون شيعته ، حتى | إن اليهودي ليختبئ تحت الشجرة أو الحجر فيقول الحجر أو الشجرة : يا مسلم ! هذا | PageV09P355 | يهودي تحتي فاقتله ' . ( حم ، طب ، عن ابن عمر رضي الله عنهما ) . |(@)(@@)(@@)(@@) $ 28908 - قال النبي صلى الله عليه وسلم : ' ينزل بأمتي في آخر الزمان بلاء شديد من سلطانهم | حتى تضيق الأرض عنهم ، فيبعث الله رجلا من عترتي فيملأ الأرض قسطا وعدلا كما | ملئت ظلما وجورا ، يرضى عنه ساكن السماء وساكن الأرض ، لا تدخر الأرض شيئا | من بذرها إلا أخرجته ، ولا السماء شيئا من قطرها إلا صبته ، يعيش فيهم سبع سنين أو | ثمان ، أو تسع ' . ( ك ، عن أبي سعيد رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28909 - قال النبي صلى الله عليه وسلم : ' ينزل المسلمون أرضا يقال لها الجابية ، فتكثر بها | أموالهم ودوابهم ، فيبعث عليهم جرب كالدمل تزكو فيه أعمالهم ، وتستشهد فيه | أبدانهم ' . ( ع ، وابن عساكر عن أبي أمامة 
ms3117	 عن معاذ رضي الله عنهما ) . |(@)(@@)(@@)(@@) $ 28910 - قال النبي صلى الله عليه وسلم : ' ينشئ الله عز وجل السحاب ثم ينزل فيها الماء ، | فلا شيء أحسن من ضحكه ، ولا شيء أحسن من منطقه ، وضحكه البرق ، ومنطقه | الرعد ' . ( عق ، والرامهرمزي في الأمثال ، ك ، في تاريخه وابن مردويه عن أبي | هريرة رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28911 - قال النبي صلى الله عليه وسلم : ' ينصب للكافر يوم القيامة مقدار خمسين ألف سنة كما | لم يعمل في الدنيا ، وإن الكافر ليرى جهنم ويظن أنها مواقعته من مسيرة أربعين | سنة ' . ( حم ، ع ، حب ، ك ، ض ، عن أبي سعيد رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28912 - قال النبي صلى الله عليه وسلم : ' ينصب لكل غادر لواء يوم القيامة ، فيقول : هذه | غدرة فلان ' . ( ه ، عن ابن عباس عن ابن مسعود رضي الله عنهم ) . |(@)(@@)(@@)(@@) $ 28913 - قال النبي صلى الله عليه وسلم : ' ينصب لكل غادر لواء يعرف به يوم القيامة ' . ( كر ، | عن ابن عباس رضي الله عنهما ) . | PageV09P356 |(@)(@@)(@@)(@@) $ 28914 - قال النبي صلى الله عليه وسلم : ' ينظر الله إلى أهل قزوين في كل يوم مرتين ، | فيتجاوز عن مسيئهم ، ويتقبل من محسنهم ' . ( أبو الشيخ في كتاب الأمصار والبلدان | والرافعي عن ابن عباس رضي الله عنهما ) . |(@)(@@)(@@)(@@) $ 28915 - قال النبي صلى الله عليه وسلم : ' ينعق الشيطان بالشام نعقة يكذب ثلثاهم بالقدر ' . | ( هق ، كر ، عن أبي هريرة رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28916 - قال النبي صلى الله عليه وسلم : ' ينفع بإذن الله تعالى من الجنون والجذام والبرص | والعين والحمى ، يكتب : أعوذ بكلمات الله التامة وأسمائه كلها عامة من شر السامة | والهامة ، ومن شر العين اللامة ، ومن شر حاسد إذا حسد ، ومن شر أبي مرة وما ولد ، | ومن شر أبي مرة وما ولد ' . ( الديلمي عن أبي أمامة رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28917 - قال النبي صلى الله عليه وسلم : ' ينفع من الجذام أن يأخذ سبع تمرات من عجوة | المدينة كل يوم ، يفعل ذلك سبعة أيام ' . ( عد ، وأبو نعيم في الطب عن عائشة ، | قال عد : لا أعلم رواة بهذا الإسناد غير محمد بن عبد الرحمن الطفاوي وله غرائب 
ms3118	 | وأفراد كلها تحتمل ، ولم أر للمتقدمين فيه كلاما انتهى . وقال فيه ابن معين صالح ، | وقال أبو حاتم الرازي صدوق ) . |(@)(@@)(@@)(@@) $ 28918 - قال النبي صلى الله عليه وسلم : ' ينهى النساء في إحرامهن عن القفازين والنقاب ، وما | مس الورس والزعفران من الثياب ولتلبس بعد ذلك ما أحبت من ألوان الثياب ' . | ( ك ، عن ابن عمر رضي الله عنهما ) . |(@)(@@)(@@)(@@) ||| ( الياء مع الهاء )(@)(@@)(@@)(@@) |||| الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ 28919 - قال النبي صلى الله عليه وسلم : ' يهود أمتي المرجئة ' . ( أبو مضر ربيعة بن علي | العجلي في كتاب هدم الاعتزال ، والرافعي عن ابن عباس رضي الله عنهما ) . | PageV09P357 |(@)(@@)(@@)(@@) ||| ( الياء مع الواو )(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ 28920 - قال النبي صلى الله عليه وسلم : ' يود أهل العافية يوم القيامة حين يعطى أهل البلاء | الثواب لو أن جلودهم كانت قرضت في الدنيا بالمقاريض ' . ( ت ، عن جابر رضي | الله عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28921 - قال النبي صلى الله عليه وسلم : ' يوزن يوم القيامة مداد العلماء ودم الشهداء فيرجح | مداد العلماء على دم الشهداء ' . ( الشيرازي عن أنس ، المرهبي عن عمران بن | حصين ، ابن عبد البر في العلم عن أبي الدرداء ، ابن الجوزي في العلل عن | النعمان بن بشير رضي الله عنه ) . |(@)(@@)(@@)(@@) $ 28922 - قال النبي صلى الله عليه وسلم : ' يوشك أحدكم أن يصلي الفجر أربعا ' . ( ه ، عن | عبد الله بن بحينة رضي الله عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28923 - قال النبي صلى الله عليه وسلم : ' يوشك الفرات أن يحسر عن جبل من ذهب ، فإذا | سمع به الناس ساروا إليه ، فيقول من عنده : والله لئن تركنا الناس يأخذون منه ليذهبن | به كله فيقتتلون عليه حتى يقتل من كل مائة تسعة وتسعون ' . ( حم ، م ، عن | أبي رضي الله عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28924 - قال النبي صلى الله عليه وسلم : ' يوشك الفرات أن يحسر عن كنز من ذهب ، فمن | حضره يأخذ منه شيئا ' . ( ق ، د ، عن أبي هريرة رضي الله عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28925 - قال النبي صلى الله عليه وسلم : ' يوشك المسلمون أن يحاصروا إلى المدينة حتى | يكون أبعد مسالحهم سلاح ' . ( د ، ك ، عن ابن عمر رضي 
ms3119	 الله عنهما ، ز ) . | PageV09P358 |(@)(@@)(@@)(@@) $ 28926 - قال النبي صلى الله عليه وسلم : ' يوشك الناس يتساءلون حتى يقول قائلهم : هذا الله | خلق الخلق فمن خلق الله ؟ فإذا قالوا ذلك فقولوا : الله أحد ، الله الصمد ، لم يلد | ولم يولد ، ولم يكن له كفؤا أحد ، ثم ليتفل عن يساره ثلاثا وليستعذ من الشيطان ' . | ( د ، عن أبي هريرة رضي الله عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28927 - قال النبي صلى الله عليه وسلم : ' يوشك أن تداعى عليكم الأمم من كل أفق كما | تداعى الأكلة إلى قصعتها ، قيل يا رسول الله ! فمن قلة يومئذ ؟ قال : لا ، ولكنكم | غثاء كغثاء السيل يجعل الوهن في قلوبكم ، وينزع الرعب من قلوب عدوكم ، لحبكم | الدنيا وكراهيتكم الموت ' . ( حم ، د ، عن ثوبان رضي الله عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28928 - قال النبي صلى الله عليه وسلم : ' يوشك إن طالت بك مدة أن ترى قوما في أيديهم مثل | أذناب البقر ، يغدون في غضب الله ، ويروحون في سخط الله ' . ( م ، عن أبي | هريرة رضي الله عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28929 - قال النبي صلى الله عليه وسلم : ' يوشك أن يأتي زمان يغربل فيه الناس غربلة ، وتبقى | حثالة من الناس قد مرجت عهودهم وأماناتهم واختلفوا فكانوا هكذا وشبك بين | أصابعه ، قالوا : كيف بنا يا رسول الله ؟ قال : تأخذون ما تعرفون وتدعون ما | تنكرون ، وتقبلون على أمر خاصتكم ، وتذرون أمر عامتكم ' . ( حم ، د ، ك ، عن | ابن عمرو رضي الله عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28930 - قال النبي صلى الله عليه وسلم : ' يوشك أن يضرب الناس أكباد الإبل يطلبون العلم | فلا يجدون أحدا أعلم من عالم المدينة ' . ( ت ، ك ، عن أبي هريرة رضي الله | عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28931 - قال النبي صلى الله عليه وسلم : ' يوشك أن يقعد الرجل متكئا على أريكته يحدث | PageV09P359 | بحديث من حديثي فيقول : بيننا وبينكم كتاب الله ، فما وجدنا فيه من حلال | استحللناه ، وما وجدنا فيه من حرام حرمناه ، ألا وإن ما حرم رسول الله مثل ما حرم | الله ' . ( حم ، د ، ك ، عن المقدام رضي الله عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28932 - قال النبي صلى الله عليه وسلم : ' يوشك أن يكون 
ms3120	 خير مال المسلم غنما يتبع بها | شعف الجبال ومواقع القطر يفر بدينه من الفتن ' . ( حم ، خ ، د ، ن ، ه ، عن | أبي سعيد رضي الله عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28933 - قال النبي صلى الله عليه وسلم : ' يوشك يا معاذ إن طالت بك حياة أن ترى ما ههنا قد | ملئ جنانا ' . ( حم ، م ، عن معاذ بن جبل رضي الله عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28934 - قال النبي صلى الله عليه وسلم : ' يوضع الصراط بين ظهراني جهنم ، عليه حسك | كحسك السعدان ، ثم يستجيز الناس ، فناج مسلم ومخدوش به ، ثم ناج ومحتبس | به ومنكوس فيها ' . ( حم ، ه ، حب ، ك ، عن أبي سعيد رضي الله عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28935 - قال النبي صلى الله عليه وسلم : ' يوم الثلاثاء يوم الدم ، فيه ساعة لا يرقأ فيها الدم ' . | ( د ، عن أبي بكرة رضي الله عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28936 - قال النبي صلى الله عليه وسلم : ' يوم الجمعة ثنتا عشرة ساعة منها ساعة لا يوجد عبد | مسلم يسأل الله فيها شيئا إلا آتاه الله إياه ، فالتمسوها آخر ساعة بعد العصر ' . ( د ، | ن ، ك ، عن جابر رضي الله عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28937 - قال النبي صلى الله عليه وسلم : ' يوم الحج الأكبر يوم النحر ' . ( ت ، عن | علي رضي الله عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28938 - قال النبي صلى الله عليه وسلم : ' يوم الفطر ويوم النحر وأيام التشريق عيدنا أهل | PageV09P360 | الإسلام ، وهي أيام أكل وشرب ' . ( حم ، 3 ك ، عن عقبة بن عامر رضي الله | عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28939 - قال النبي صلى الله عليه وسلم : ' يوم القيامة على المؤمنين كقدر ما بين الظهر | والعصر ' . ( ك ، عن أبي هريرة رضي الله عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28940 - قال النبي صلى الله عليه وسلم : ' يومئذ تحدث أخبارها أتدرون ما أخبارها ؟ فإن | أخبارها أن تشهد على كل عبد وأمة بما عمل على ظهرها ، أن تقول : عمل كذا وكذا | في يوم كذا وكذا ، فهذه أخبارها ' . ( حم ، ت ، ك ، عن أبي هريرة رضي الله | عنه ، ز ) . |(@)(@@)(@@)(@@) $ 28941 - قال النبي صلى الله عليه وسلم : ' يهرم ابن آدم ويبقى معه اثنتان : الحرص والأمل ' . | ( حم ، ق ، ن 