ms2441	 :(@)(@@) | 30 ( من قام إذا استقلت الشمس فتوضأ فأحسن وضوءه ، ثم قام فصلى ركعتين ، غفر له خطاياه أو قال : كان كما ولدته أمه ) )(@)(@@) ( حم ) و الدارمي ( ع ) عن عقبة بن عامر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22700 ) قال النبي :(@)(@@) | 30 ( من قام مقام رياء أقامه الله مقام رياء وسمعة ) )(@)(@@) ابن منده ( كر ) عن بشير بن عقربة رضي الله عنه .(@)(@@) PageV07P321(@)(@@)(@@)(@@) $ ( 22701 ) قال النبي :(@)(@@) | 30 ( من قام من مجلسه ثم رجع فهو أحق به ) )(@)(@@) ابن النجار عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22702 ) قال النبي :(@)(@@) | 30 ( من قام مقام رياء وسمعة راءى الله تعالى به يوم القيامة وسمع به ) )(@)(@@) ( حم ) و ابن سعد وابن قانع والباوردي ، ( طب ) وأبو نعيم عن أبي هند الداري أخي تميم الداري رضي الله عنه .(@)(@@) [ حديث رقم 22703 غير مطبوع في الكتاب ](@)(@@)(@@)(@@) $ ( 22704 ) قال النبي :(@)(@@) | 30 ( من قام بخطبة لا يلتمس بها إلا رياء وسمعة ، أوقفه الله يوم القيامة موقف رياء وسمعة ) )(@)(@@) ( حم ) و ابن سعد ويعقوب بن سفيان والبغوي وابن السكن والباوردي وابن منده وابن قانع ، ( طب ) وأبو نعيم ، ( ض ) عن بشير بن عقربة الجهني رضي الله عنه ويقال : بشر ، قال البغوي : ولا أعلم له غيره ، وقال ابن السكن : هاذا حديث مشهور ، وقال ( كر ) : روى حديثين .(@)(@@)(@@)(@@) $ ( 22705 ) قال النبي :(@)(@@) | 30 ( من قام بعشر آيات لم يكتب من الغافلين ، ومن قام بمائة آية كتب من القانتين ، ومن قام بمأتي آية كتب من الفائزين ) )(@)(@@) الشيرازي في الألقاب ، وابن مردويه عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22706 ) قال النبي :(@)(@@) | 30 ( من قام من الليل فتوضأ ومضمض فاه ، ثم قال : سبحان الله مائة مرة ، والحمد لله مائة مرة ، والله أكبر مائة مرة ، ولا إلاه إلا الله مائة مرة ، غفرت له ذنوبه إلا الدماء والأموال فإنها لا تبطل ) )(@)(@@) ( طب ) عن سعد بن جنادة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22707 ) قال النبي :(@)(@@) | 30 ( من قام إلى الوضوء فغسل يديه خرجت الخطايا من يديه ، فإذا مضمض خرجت الخطايا من فيه ، فإذا استنشق خرجت من أنفه فكذالك حتى يغسل القدمين 
ms2442	 ، فإن خرج إلى صلاة مفروضة كانت كحجة مبرورة ، وإن خرج إلى صلاة تطوع كانت كعمرة مبرورة ) )(@)(@@) عبد الرزاق ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@) PageV07P322(@)(@@)(@@)(@@) $ ( 22708 ) قال النبي :(@)(@@) | 30 ( من قام ب { قل هو الله أحد ، الله الصمد } فقد قرأ ثلث القرآن ) )(@)(@@) ( طب ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22709 ) قال النبي :(@)(@@) | 30 ( من قام مقام رياء راءى الله به ، ومن قام مقام سمعة سمع الله به ) )(@)(@@) ( طب ) عن عوف بن مالك رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22710 ) قال النبي :(@)(@@) | 30 ( من قام من مجلسه يوم الجمعة وعاد فهو أحق به ) )(@)(@@) ( هق ) عن عروة مرسلا .(@)(@@)(@@)(@@) $ ( 22711 ) قال النبي :(@)(@@) | 30 ( من قبل مني الكلمة التي عرضتها على عمي فردها علي ، فهي له نجاة ) )(@)(@@) ( حم ش ع هب ) عن أبي بكر الصديق رضي الله عنه وصححه .(@)(@@)(@@)(@@) $ ( 22712 ) قال النبي :(@)(@@) | 30 ( من قتل قتيلا من أهل الذمة لم يرح رائحة الجنة ، وإن ريحها ليوجد من مسيرة مائة عام ) )(@)(@@) ( طب ك هق ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22713 ) قال النبي :(@)(@@) | 30 ( من قتل نفسا معاهدة بغير حقها لم يرح رائحة الجنة ، وإن ريحها ليوجد من مسيرة خمسمائة عام ) )(@)(@@) ( طب ك ) عن أبي بكرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22714 ) قال النبي :(@)(@@) | 30 ( من قتل نفسا معاهدة بغير حقها لم يرح رائحة الجنة ، وإن رائحة الجنة ليوجد من مسيرة مائة عام ) )(@)(@@) ( طب ك هق ) عن أبي بكرة رضي الله عنه .(@)(@@) PageV07P323(@)(@@)(@@)(@@) $ ( 22715 ) قال النبي :(@)(@@) | 30 ( من قتل قتيلا فإنه لا يرثه وإن لم يكن له وارث غيره ، وإن كان ولده أو والده ) )(@)(@@) ( هق ) عن ابن عباس رضي الله عنهما ، ( عب ) عن عمرو بن شعيب مرسلا .(@)(@@)(@@)(@@) $ ( 22716 ) قال النبي :(@)(@@) | 30 ( من قتل عبده قتلناه ، ومن جدع عبده جدعناه ، ومن خصى عبده خصيناه ) )(@)(@@) ( ط ش حم ) و الدارمي ، ( د ت ) حسن غريب ، ( ن ع ه طب ك هق ض ) عن سمرة ، ( ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22717 ) قال النبي :(@)(@@) | 30 ( من قتل عصفورا بغير حقه سأله الله تعالى عنه 
ms2443	 يوم القيامة ، قالوا : وما حقه ؟ قال : يذبحه ذبحا ولا يأخذ بعنقه فيقطعه ) )(@)(@@) ( حم طب ) و الشيرازي في الألقاب ، ( طب هق ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22718 ) قال النبي :(@)(@@) | 30 ( من قتل نفسا معاهدة بغير حلها ، حرم الله عليه الجنة أن يشم ريحها ، وإن ريحها ليوجد من مسيرة مائة عام ) )(@)(@@) ( عب حم ن هق ) عن أبي بكرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22719 ) قال النبي :(@)(@@) | 30 ( من قتل متعمدا فإنه يدفع إلى أهل القتيل ، فإن شاءوا قتلوا ، وإن شاءوا أخذوا العقل دية مسلمة ، وهي مائة من الإبل : ثلاثون حقة ، وثلاثون جذعة ، وأربعون خلفة فذالك للمتعمد إذا لم يقتل صاحبه ) )(@)(@@) ( عب ) عن عمرو بن شعيب مرسلا ، ( عب ) عن الشعبي عن أبي موسى الأشعري والمغيرة بن شعبة رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22720 ) قال النبي :(@)(@@) | 30 ( من قتل نفسه بشيء في الدنيا عذب به في يوم PageV07P324 القيامة ) )(@)(@@) ( طب ) عن ثابت بن الضحاك رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22721 ) قال النبي :(@)(@@) | 30 ( من قتل نفسه بشيء متعمدا عذب به يوم القيامة في نار جهنم ، ومن حلف على يمين غير الإسلام كاذبا متعمدا فهو كما قال ، ومن قال لمؤمن يا كافر فهو كقتله ) )(@)(@@) ( طب ) عن ثابت بن الضحاك رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22722 ) قال النبي :(@)(@@) | 30 ( من قتل صغيرا أو كبيرا أو أحرق نخلا ، أو قطع شجرة مثمرة ، أو ذبح شاة لاهيا بها لم يرجع كفافا ) )(@)(@@) ( حم ) عن ثوبان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22723 ) قال النبي :(@)(@@) | 30 ( من قتل حية فكأنما قتل كافرا من أهل الحرب ، ومن قتل زنبورا كتب له ثلاث حسنات ومحي عنه مثلها سيئات ، ومن قتل عقربا كتب له سبع حسنات ومحي عنه مثلها سيئات ) )(@)(@@) الديلمي عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22724 ) قال النبي :(@)(@@) | 30 ( من قتل الحرورية فهو شهيد ) )(@)(@@) أبو الشيخ عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22725 ) قال النبي :(@)(@@) | 30 ( من قتل على ماله فهو شهيد ) )(@)(@@) ( عب ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22726 ) قال النبي :(@)(@@) | 30 ( من قتل منكم صابرا مقبلا في سبيل الله فإنه 
ms2444	 في الجنة ) )(@)(@@) ( طب ض ) عن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22727 ) قال النبي :(@)(@@) | 30 ( من قتل في سبيل الله أو مات فهو في الجنة ) )(@)(@@) الحميدي ( حم ) والعدني ( خ حب ك هق ض ) عن عمر رضي الله عنه .(@)(@@) PageV07P325(@)(@@)(@@)(@@) $ ( 22728 ) قال النبي :(@)(@@) | 30 ( من قتل دون أهله ظلما فهو شهيد ، ومن قتل دون ماله ظلما فهو شهيد ، ومن قتل دون جاره ظلما فهو شهيد ، ومن قتل في ذات الله عز وجل فهو شهيد ) )(@)(@@) ابن النجار عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22729 ) قال النبي :(@)(@@) | 30 ( من قتل صبرا كان كفارة لخطاياه ) )(@)(@@) ابن النجار عن عمرو بن شعيب عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 22730 ) قال النبي :(@)(@@) | 30 ( من قتل في سبيل الله فهو شههيد ، ومن غرق في سبيل الله فهو شهيد ، ومن قتله البطن فهو شهيد ، والمرأة يقتلها نفاسها شهيدة ) )(@)(@@) ( طب ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22731 ) قال النبي :(@)(@@) | 30 ( من قتل في عميا رميا بحجر أو ضربا بالسوط أو بعصا فقتله قتل الخطإ ، ومن قتل اعتباطا فهو قود لا يحال بينه وبين قاتله ، فمن حال بينه وبين قاتله فعليه لعنة الله والملائكة والناس أجمعين ، لا يقبل الله منه صرفا ولا عدلا ) )(@)(@@) ( عب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22732 ) قال النبي :(@)(@@) | 30 ( من قدر على طمع من طمع الدنيا فأداه ، ولو شاء لم يؤده زوجه الله عز وجل من الحور العين حيث شاء ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22733 ) قال النبي :(@)(@@) | 30 ( من قدم من نسكه شيئا أو أخره فلا شيء عليه ) )(@)(@@) ( هق ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22734 ) قال النبي :(@)(@@) | 30 ( من قدم شيئا من ولده صابرا محتسبا حجبوه بإذن الله من النار ) )(@)(@@) ( طس ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 22735 ) قال النبي :(@)(@@) | 30 ( من قرأ القرآن وعمل بما فيه ومات في الجماعة ، بعثه الله تعالى يوم القيامة مع السفرة والحكام ، ومن قرأ القرآن وهو يتفلت منه لا PageV07P326 يدعه فله أجره مرتين ، ومن كان حريصا عليه ولا يستطيعه ولا يدعه 
ms2445	 بعثه الله يوم القيامة مع أشراف أهله ، وفضلوا على الخلائق كما فضلت النسور على سائر الطير ، وكما فضلت عين في مرج على ما حولها ، ثم ينادي مناد : أين الذين كانوا لا تلهيهم رعية الأنعام عن تلاوة كتابي ؟ فيقومون ، فيلبس أحدهم تاج الكرامة ويعطى النور بيمينه ، والخلد بشماله ، فإن كان أبواه مسلمين كسيا حلة خيرا من الدنيا وما فيها ، فيقولان : أنى هاذه لنا ؟ فيقال : بما كان ولدكما يقرأ القرآن ) )(@)(@@) ابن زنجويه ( طب هب ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22736 ) قال النبي :(@)(@@) | 30 ( من قرأ ألف آية في سبيل الله كتب يوم القيامة مع النبيين والصديقين والشهداء والصالحين وحسن أولائك رفيقا ) )(@)(@@) ( حم طب ) و ابن السني ( ك هق ) عن معاذ بن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22737 ) قال النبي :(@)(@@) | 30 ( من قرأ القرآن فقد استدرج النبوة بين جنبيه غير أنه لا يوحى إليه ، لا ينبغي لصاحب القرآن أن يحد مع من حد ، ولا يجهل مع من يجهل وفي جوفه كلام الله ) )(@)(@@) ( ك هب ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22738 ) قال النبي :(@)(@@) | 30 ( من قرأ القرآن يقوم به آناء الليل والنهار ، يحل حلاله ، ويحرم حرامه ، حرم الله لحمه ودمه على النار ، وجعله رفيق السفرة الكرام البررة حتى إذا كان يوم القيامة كان القرآن حجة له ) )(@)(@@) ( طص ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22739 ) قال النبي :(@)(@@) | 30 ( من قرأ القرآن فأعرب كله كان له بكل حرف أربعون حسنة ، ومن أعربع بعضه ولحن في بعض كان له بكل حرف عشرون حسنة ، ومن PageV07P327 لم يعرب منه شيئا كان له بكل حرف عشر حسنات ) )(@)(@@) أبو عثمان الصابوني في المائتين ( هب ) عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22740 ) قال النبي :(@)(@@) | 30 ( من قرأ القرآن قبل أن يحتلم فقد أوتي الحكم صبيا ) )(@)(@@) ابن مردويه ( هب ) عن ابن عباس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22741 ) قال النبي :(@)(@@) | 30 ( من قرأ حرفا من القرآن كتب الله تعالى له به حسنة ، لا أقول { بسم الله } ولاكن : باء وسين وميم ، ولا أقول : { آلم } ولاكن أقول : الألف واللام 
ms2446	 والميم ) )(@)(@@) ( هب ) عن عوف بن مالك رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22742 ) قال النبي :(@)(@@) | 30 ( من قرأ القرآن فقام به آناء الليل والنهار ، يحل حلاله ويحرم حرامه ، خلطه الله بلحمه ودمه ، وجعله رفق السفرة الكرام البررة ، وإذا كان يوم القيامة كان القرآن له حجيجا فقال : يا رب كل عامل يعمل في الدنيا يأخذ بعمله في الدنيا إلا فلان كان يقوم في آناء الليل والنهار فيحل حلالي ويحرم حرامي ، يا رب فأعطه ، فيتوجه الله تاج الملك ويكسوه من حلل الكرامة ، ثم يقول : هل رضيت ؟ فيقول : يا رب أرغب له في أفضل من هاذا ، فيعطيه الله عز وجل الملك بيمينه والخلد بشماله ، ثم يقال له : هل رضيت ؟ فيقول : نعم يا رب ، ومن أخذه بعد ما يدخل في السن فأخذه وهو يتفلت منه أعطاه الله أجره مرتين ) )(@)(@@) ( هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22743 ) قال النبي :(@)(@@) | 30 ( من قرأ آية من القرآن كان له درجة في الجنة ومصباح من نور ) )(@)(@@) ( هب ) عن ابن عمرو رضي الله عنه .(@)(@@) PageV07P328(@)(@@)(@@)(@@) $ ( 22744 ) قال النبي :(@)(@@) | 30 ( من قرأ القرآن وحمد الرب وصلى على التبي واستغفر ربه فقد طلب الخير مكانه ) )(@)(@@) ( هب ) وضعفه عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22745 ) قال النبي :(@)(@@) | 30 ( من قرأ أربعين آية في ليلة لم يكتب من الغافلين ، ومن قرأ مائة آية كتب من القانتين ، ومن قرأمائتي آية لم يحاجه القرآن يوم القيامة ، ومن قرأ خمسمائة آية كتب له قنطار من الأجر ) )(@)(@@) ( طب ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22746 ) قال النبي :(@)(@@) | 30 ( من قرأ القرآن في المصحف كتب له ألف حسنة ، ومن قرأه في غير المصحف فألف حسنة ) )(@)(@@) ( عد هب ) عن أوس الثقفي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22747 ) قال النبي :(@)(@@) | 30 ( من قرأ القرآن فأعرب في قراءته كان له بكل حرف منه عشرون حسنة ، ومن قرأ بغير إعراب كان له بكل حرف عشر حسنات ) )(@)(@@) ( هب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22748 ) قال النبي :(@)(@@) | 30 ( من قرأ القرآن في صلاة قائما كان له بكل حرف مائة 
ms2447	 حسنة ، ومن قرأه قاعدا كان له بكل حرف خمسون حسنة ، ومن قرأه في غير صلاة كان له بكل حرف عشر حسنات ، ومن استمع إلى كتاب الله كان له بكل حرف حسنة ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22749 ) قال النبي :(@)(@@) | 30 ( من قرأ القرآن بإعراب فله أجر شهيد ) )(@)(@@) أبو نعيم عن حذيفة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22750 ) قال النبي :(@)(@@) | 30 ( من قرأ القرآن في سبعة كتبه الله من المحسنين ، ولا تقرءوا في أقل من ثلاثة ، فمن وجد منكم نشاطا فليجعله في حسن تلاوته ) )(@)(@@) الديلمي عن أبي الدرداء رضي الله عنه .(@)(@@) PageV07P329(@)(@@)(@@)(@@) $ ( 22751 ) قال النبي :(@)(@@) | 30 ( من قرأ القرآن كان حقا على الله أن لا تطعمه النار ما لم يغل به ، ما لم يأكل به ، ما لم يرائي به ، ما لم يدعه إلى غيره ) )(@)(@@) الديلمي عن أبي عنبة الحمصي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22752 ) قال النبي :(@)(@@) | 30 ( من قرأ القرآن وتعلمه وعمل به ، ألبس يوم القيامة تاجا من نور ، ضوءه مثل ضوء القمر ، ويكسى والده حلتين لا تقوم لهما الدنيا ، فيقولان : بم كسينا هاذا ؟ فيقال : بأخذ ولدكما القرآن ) )(@)(@@) ( ك ) عن عبد الله بن بريدة عن أبيه .(@)(@@)(@@)(@@) $ ( 22753 ) قال النبي :(@)(@@) | 30 ( من قرأ القرآن في سبع فذالك عمل المقربين ، ومن قرأ في خمس ذالك عمل الصديقين ، ومن قرأه في ثلاث ذاك عمل عبادة النبيين ، وذالك الجهد ، ولا أراكم تطيقونه إلا أن تصبروا على مكابدة الليل أو يبدأ أحدكم بالسورة وهمه في آخرها ، قالوا : يا رسول الله وفي أقل من ثلاث ؟ قال : لا ، ومن وجد منكم نشاطا فليجعله في حسن تلاوتها ) )(@)(@@) الحكيم عن مجاهد مرسلا .(@)(@@)(@@)(@@) $ ( 22754 ) قال النبي :(@)(@@) | 30 ( من قرأ القرآن فلم يعربه وكل به ملك يكتب له كما أنزل بكل حرف عشر حسنات ، فإن أعرب بعضه ولم يعرب بعضه وكل به ملكان يكتبان له بكل حرف عشرين حسنة ، فإن أعربه وكل به أربعة أملاك يكتبون له بكل حرف سبعين حسنة ) )(@)(@@) ابن الأنباري في الوقف عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22755 ) قال النبي :(@)(@@) | 30 ( من 
ms2448	 قرأ القرآن نظرا متع ببصره ) )(@)(@@) ابن النجار عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22756 ) قال النبي :(@)(@@) | 30 ( من قرأ القرآن ثم مات قبل أن يستظهره أتاه ملك PageV07P330 فعلمه في قبره ، ويلقى الله تعالى وقد استظهره ) )(@)(@@) أبو الحسن بن بشران في فوائده وابن النجار عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22757 ) قال النبي :(@)(@@) | 30 ( من قرأ القرآن فرأى أن أحدا من خلق الله عز وجل أعطي أفضل مما أعطي فقد صغر ما عظم الله ، وعظم ما صغر الله ، لا ينبغي لحامل القرآن أن يحتد في من يحتد ، ولا يجهل في من يجهل ، ولاكنه يعفو ويصفح لعز القرآن ) )(@)(@@) الخطيب عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22758 ) قال النبي :(@)(@@) | 30 ( من قرأ القرآن وعمل بما فيه ومات مع الجماعة بعثه الله يوم القيامة مع السفرة ) )(@)(@@) أبو نصر السجزي في الإبانة وقال : حسن غريب عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22759 ) قال النبي :(@)(@@) | 30 ( من قرأ حرفا من القرآن كتب له به حسنة ، لا أقول : { آلم ، ذالك الكتاب } ولاكن : الألف واللام والميم والذال والكاف ) )(@)(@@) ( ش طب ) عن عوف بن مالك الأشجعي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22760 ) قال النبي :(@)(@@) | 30 ( من قرأ القرآن كتب له بكل حرف عشر حسنات ، ومن سمع القرآن كتب له بكل حرف حسنة وحشر في جملة من يقرأ ويرقى ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22761 ) قال النبي :(@)(@@) | 30 ( من قرأ القرآن وعرف تأويله ومعانيه ولم يعمل به تبوأ مضجعه من النار ) )(@)(@@) أبو نعيم عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22762 ) قال النبي :(@)(@@) | 30 ( من قرا مائتي آية في كل يوم نظرا شفع في سبع قبور حول قبره ، وخفف الله العذاب عن والديه وإن كانا مشركين ) )(@)(@@) ابن أبي داود في المصحاحف ، PageV07P331 والديلمي عن أبي الدرداء رضي الله عنه ، وفيه إسماعيل بن عياش عن يحيى بن سعد .(@)(@@)(@@)(@@) $ ( 22763 ) قال النبي :(@)(@@) | 30 ( من قرأ مائتي آية فقد أكثر ) )(@)(@@) أبو نعيم عن المقدام رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22764 ) قال النبي :(@)(@@) | 30 ( من قرأ في ليله : { آلم تنزيل } السجدة ، و 
ms2449	 { اقتربت الساعة } و { تبارك } كن له حرزا من الشيطان وشركه ، ورفعه الله في الدرجات يوم القيامة ) )(@)(@@) ابن الشيخ عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 22765 ) قال النبي :(@)(@@) | 30 ( من قرأ ثلاثين آية في ليلة لم يضره تلك الليلة سبع ضار ولا لص طارق ، وهو في أهله وماله حتى يصبح ) )(@)(@@) الديلمي عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22766 ) قال النبي :(@)(@@) | 30 ( من قرأ القرآن ظاهرا أو ناظرا حتى يختمه غرس الله له به شجرة في الجنة ، لو أن غرابا فرخ في ورقة منها ثم نهض يطير لأدركه الهرم قبل أن يقطع تلك الورقة في تلك الشجرة ) )(@)(@@) الرافعي عن حذيفة ( طب ك ) وتعقب ( هب ) وابن مردويه عن ابن الزبير رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22767 ) قال النبي :(@)(@@) | 30 ( من قرأ ثلث القرآن فقد أعطي ثلث النبوة ، ومن قرأ نصف القرآن أعطي نصف النبوة ، ومن قرأ ثلثيه فقد أعطي ثلثي النبوة ، ومن قرأ القرآن كله أعطي النبوة كلها غير أنه لا يوحى إليه ، ويقال له يوم القيامة اقرأ وارقه ، فيقرأ ويصعد بكل آية درجة حتى ينجز ما معه من القرآن ، ثم يقال له : اقبض فيقبض ، ثم يقال له : هل تدري ما في يدك ؟ فإذا في يده اليمنى الخلد ، وفي PageV07P332 الأخرى النعيم ) )(@)(@@) ابن الأنباري في المصاحف ، ( هب ) وابن عساكر عن أبي أمامة ، وأورده ابن الجوزي في الموضوعات فلم يصب ، الخطيب عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22768 ) قال النبي :(@)(@@) | 30 ( من قرأ القرآن فكأنما استدرجت النبوة بين جنبيه غير أنه لا يوحى إليه ، ومن قرأ القرآن فرأى أن أحدا أعطي مما أعطي أفضل فقد عظم ما صغر الله ، وصغر ما عظم الله ، وليس ينبغي لحامل القرآن أن يسفه فيمن يسفه ، أو يغضب فيمن يغضب ، أو يحتد فيمن يحتد ، ولاكن يعفو ويصفح لفضل القرآن ) )(@)(@@) محمد بن نصر ( طب ) عن ابن عمرو رضي الله عنه ، ( ش ) عنه موقوفا .(@)(@@)(@@)(@@) $ ( 22769 ) قال النبي :(@)(@@) | 30 ( من قرأ القرآن فليسأل الله به ، فإنه سيأتي أقوام يقرءون القرآن ويسألون به الناس ) )(@)(@@) ( ش طب هب 
ms2450	 ) عن عمران بن حصين رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22770 ) قال النبي :(@)(@@) | 30 ( من قرأ عشر آيات في الليل كتب من المصلين ولم يكتب من الغافلين ، ومن قرأ خمسين آية كتب من الحافظين ، ومن قرأ مائة آية كتب من القانتين ، ومن قرأ ثلاثمائة آية لم يحاجه القرآن في تلك الليلة ويقول ربك عز وجل : لقد نصب عبدي في ، ومن قرأ ألف آية كان له قنطار ، القيراط منه خير من الدنيا وما فيها ، فإذا كان يوم القيامة قيل له : اقرأ وارقه ، فكلما قرأ آية صعد درجة حتى ينتهي إلى ما معه ، فيقول الله عز وجل له : اقبض بيمينك على الخلد ، وبشمالك على النعيم ) )(@)(@@) محمد بن نصر ( هب ) وابن عساكر عن فضالة بن عبيد وتميم الداري رضي الله عنهما معا .(@)(@@)(@@)(@@) $ ( 22771 ) قال النبي :(@)(@@) | 30 ( من قرأ في ليلة مائتي آية كتب من القانتين ) )(@)(@@) ابن مردويه عن أبي الدرداء ، ابن مردويه عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 22772 ) قال النبي :(@)(@@) | 30 ( من قرأ في ليلة ثلاثمائة آية كتب من القانتين ) )(@)(@@) ابن مردويه PageV07P333 عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22773 ) قال النبي :(@)(@@) | 30 ( من قرأ عشر آيات في ليلة كتب له قنطار ، والقنطار خير من الدنيا وما فيها ، فإذا كان يوم القيامة يقول ربك عز وجل : اقرأ وارق بكل آية درجة ، حتى ينتهي إلى آخر آية معه ، يقول ربك عز وجل : اقبض فيقبض العبد بيده ، ثم يقال : هل تدري ما في يدك ؟ فيقول العبد : يا رب أنت أعلم ، فيقول : بهاذه الخلد وبهاذه النعيم ) )(@)(@@) ( طب ) عن فضالة بن عبيد وتميم الداري رضي الله عنهما معا .(@)(@@)(@@)(@@) $ ( 22774 ) قال النبي :(@)(@@) | 30 ( من قرأ في ليلة مائة آية لم يكتب من الغافلين ، ومن قرأ بمائتي آية كتب من القانتين ، ومن قرأ خمسمائة آية أصبح له قنطار من الأجر ، القيراط منه مثل التل العظيم ) )(@)(@@) عبد بن حميد في تفسيره ، ( ش ) وابن جرير وابن نصر ، ( طب ) وابن مردويه عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22775 ) قال النبي :(@)(@@) | 30 ( من قرأ عشر آيات في 
ms2451	 ليلة لم يكتب من الغافلين ، ومن قرأ آية كتب له قنوت ليلة ، ومن قرأ مائتي آية كتب من القانتين ، ومن قرأ أربعمائة آية كتب من العابدين ، ومن قرأ خمسمائة آية إلى ألف آية كتب من الحافظين ، ومن قرأ ستمائة آية كتب من الخاشعين ، ومن قرأ ثمانمائة آية كتب من المختبين ، ومن قرأ ألف آية أصبح له قنطار ، والقنطار ألف ومائتا أوقية ، والأوقية منه خير مما بين السماء والأرض ، أو قال : مما طلعت عليه الشمس ، ومن قرأ ألفي آية كان من الموجبين ) )(@)(@@) الدارمي ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22776 ) قال النبي :(@)(@@) | 30 ( من قرأ مائة آية في ليلة لم يكتب من الغافلين ، ومن قرأ مائتي آية كتب من القانتين ، ومن قرأ ثلاثمائة آية كتب من القائمين ، ومن قرأ أربعمائة آية كتب له قنطار ، والقنطار مائة مثقال ، والمثقال عشرون قيراطا ، والقيراط : مثل أحد ) )(@)(@@) ( هب ) و الخطيب عن ابن عباس رضي الله عنهما .(@)(@@) PageV07P334(@)(@@)(@@)(@@) $ ( 22777 ) قال النبي :(@)(@@) | 30 ( من قرأ في كل ليلة مائة آية لم يحاجه القرآن ) )(@)(@@) ابن نصر عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22778 ) قال النبي :(@)(@@) | 30 ( من قرا مائة آية في ليلة لم يحاجه القرآن ، ومن قرأ مائتي آية كتب له قنوت ليلة ، ومن قرأ من خمسمائة آية إلى ألف آية أصبح له قنطار في الجنة وهو دية أحدكم ، وإن أصغر البيوت من الخير بيت لا يقرأ فيه القرآن ) )(@)(@@) ابن الضريس ومحمد بن نصر عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 22779 ) قال النبي :(@)(@@) | 30 ( من قرأ عشر آيات لم يكتب من الغافلين ، ومن قرأ مائة آية كتب له قنوت ليلة ، ومن قرأ مائتي آية كتب من القانتين ، ومن قرأ أربعمائة آية كتب من المخبتين ، ومن قرأ ألف آية أصبح وله قنطار ، ألف ومائتا أوقية ، الأوقية خير مما بين السماء والأرض ، ومن قرأ ألفي آية كان من الموجبين ) )(@)(@@) ( طب ض ) عن عبادة بن الصامت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22780 ) قال النبي :(@)(@@) | 30 ( من قرأ في ليلة خمسين آية لم يكتب من الغافلين ، ومن 
ms2452	 قرأ بمائة آية أعطي قيام ليلة كاملة ، ومن قرأ بمائتي آية ومعه القرآن فقد أدى حق القرآن ، ومن قرأ بخمسمائة آية إلى ألف آية كان كمن تصدق بقنطار قبل أن يصبح ، قيل : وما القنطار ؟ قال : ألف دينار ) )(@)(@@) محمد بن نصر وابن السني في عمل يوم وليلة عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22781 ) قال النبي :(@)(@@) | 30 ( من قرأ عشر آيات في ليلة لم يكتب من الغافلين ، ومن قرأ مائة آية كتب من القانتين ) )(@)(@@) ( ك ) عن ابن عمر ، ( ش ) عن أنس رضي الله عنه موقوفا .(@)(@@)(@@)(@@) $ ( 22782 ) قال النبي :(@)(@@) | 30 ( من قرأ في يوم وليلة خمسين آية لم يكتب من الغافلين ، ومن قرأ في يوم مائة آية كتب من القانتين ، ومن قرأ مائتي آية لم يحاجه PageV07P335 القرآن يوم القيامة ، ومن قرأ خمسمائة آية كتب له قنطار من الأجر ) )(@)(@@) ابن السني عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22783 ) قال النبي :(@)(@@) | 30 ( من قرأ ثلاثمائة آية قال الله عز وجل لملائكته : نصب عبدي أشهدكم يا ملائكتي أني قد غفرت له ) )(@)(@@) ابن السني عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22784 ) قال النبي :(@)(@@) | 30 ( من قرأ في ليلة عشر آيات لم يكتب من الغافلين ) )(@)(@@) ابن السني ( هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22785 ) قال النبي :(@)(@@) | 30 ( من قرأ سورة البقرة في ليلة توج بها تاج في الجنة ) )(@)(@@) أبو نعيم عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22786 ) قال النبي :(@)(@@) | 30 ( من قرأ آية الكرسي دبر كل صلاة لم يمنعه من دخول الجنة إلا الموت ، ومن قرأها حين يأخذ مضجعه ، آمنه الله على داره ، ودار جاره ، ودويرات حوله ) )(@)(@@) ( عب ) وضعفه عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22787 ) قال النبي :(@)(@@) | 30 ( من قرأ في دبر كل صلاة مكتوبة آية الكرسي حفظ إلى الصلاة الأخرى ، ولا يحافظ عليها إلا نبي أو صديق أو شهيد ) )(@)(@@) ( هب ) وضعفه عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22788 ) قال النبي :(@)(@@) | 30 ( من قرأ آية الكرسي في دبر الصلاة المكتوبة كان في ذمة الله إلى الصلاة الأخرى ) )(@)(@@) ( طب ض ) عن 
ms2453	 الحسن بن علي ، الديلمي عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22789 ) قال النبي :(@)(@@) | 30 ( من قرأ آية الكرسي دبر كل صلاة مكتوبة لم يحل بينه وبين دخول الجنة إلا الموت ) )(@)(@@) ابن السني عن أبي أمامة رضي الله عنه .(@)(@@) PageV07P336(@)(@@)(@@)(@@) $ ( 22790 ) قال النبي :(@)(@@) | 30 ( من قرأ آية الكرسي و { قل هو الله أحد } دبر كل صلاة مكتوبة لم يمنعه من دخول الجنة إلا الموت ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22791 ) قال النبي :(@)(@@) | 30 ( من قرأ آية الكرسي في دبر كل صلاة لم يكن بينه وبين أن يدخل الجنة إلا أن يموت ، فإذا مات دخل الجنة ) )(@)(@@) ( هب ) عن الصلصال رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22792 ) قال النبي :(@)(@@) | 30 ( من قرأ آية الكرسي ولم يتول قبض نفسه إلا الله تعالى ) )(@)(@@) الخطيب عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22793 ) قال النبي :(@)(@@) | 30 ( من قرأ آية الكرسي دبر كل صلاة كان الذي يلي قبض روحه ذو الجلال والإكرام ، وكان كمن قاتل عن أنبياء الله ورسله حتى يستشهد ) )(@)(@@) الحكيم عن زيد المروزي رضي الله عنه معضلا .(@)(@@)(@@)(@@) $ ( 22794 ) قال النبي :(@)(@@) | 30 ( من قرأ آية الكرسي دبر كل صلاة مكتوبة كان الرب يتولى قبض روحه بيده ، وكان بمزلة من قاتل عن أنبياء الله عز وجل حتى يستشهد ) )(@)(@@) ابن السني والديلمي عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22795 ) قال النبي :(@)(@@) | 30 ( من قرأ آية الكرسي عند حجامته كانت منفعتها منفعة حجامتين ) )(@)(@@) ابن السني والديلمي عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22796 ) قال النبي :(@)(@@) | 30 ( من قرأ آية الكرسي وخواتيم سورة البقرة عند الكرب أغاثه الله عز وجل ) )(@)(@@) ابن السني عن أبي قتادة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22797 ) قال النبي :(@)(@@) | 30 ( من قرأ خاتمة سورة البقرة حتى يختمها في ليلة PageV07P337 أجزأت عنه قيام تلك الليلة ) )(@)(@@) الديلمي عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22798 ) قال النبي :(@)(@@) | 30 ( من قرأ سورة الكهف كما أنزلت رفع الله له نورا من حيث قرأها إلى مكة ، ومن قال إذا توضأ : سبحانك اللهم وبحمدك ، أشهد أن لا إلاه إلا أنت 
ms2454	 ، أستغفرك وأتوب إليك طبع بطابع ثم جعلت تحت العرش حتى يؤتى بصاحبها يوم القيامة ) )(@)(@@) ( هب ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22799 ) قال النبي :(@)(@@) | 30 ( من قرأ : { شهد الله أنه لا إلاه إلا هو والملائكة وأولوا العلم } إلى { عند الله الإسلام } ، ثم قال : وأنا أشهد بما شهد الله به وأستودع الله هاذه الشهادة وهي لي عند الله وديعة ، جيء به يوم القيامة فقيل : عبدي هاذا عهد إلي عهدا وأنا أحق من وفى بالعهد ، أدخلوا عبدي الجنة ) )(@)(@@) أبو الشيخ عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22800 ) قال النبي :(@)(@@) | 30 ( من قرأ مصبح أو ممسي : { قل ادعوا الله أو ادعو الرحمان } إلى آخر السورة ، لم يمت قلبه ذالك اليوم ولا في تلك الليلة ) )(@)(@@) الديلمي عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22801 ) قال النبي :(@)(@@) | 30 ( من قرأ العشر الأواخر من سورة الكهف عصم من فتنة الدجال ) )(@)(@@) أبو عبيد في فضائله ، ( حم م ن ه حب ) عن أبي الدراء ، ابن الضريس ( ن ع ) والروياني ( ش ) عن ثوبان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22802 ) قال النبي :(@)(@@) | 30 ( من قرأ من سورة الكهف عشر آيات عند منامه عصم من فتنة الدجال ، ومن قرأ خاتمتها عند رقاده كان له نور من لدن قرنه إلى PageV07P338 قدمه يوم القيامة ) )(@)(@@) ابن مردويه عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 22803 ) قال النبي :(@)(@@) | 30 ( من قرأ الكهف يوم الجمعة فهو معصوم إلى ثمانية أيام من كل فتنة تكون ، فإن خرج الدجال عصم منه ) )(@)(@@) ابن مردويه عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22804 ) قال النبي :(@)(@@) | 30 ( من قرأ سورة الكهف كما أنزلت كانت له نورا يوم القيامة من مقامه إلى مكة ، ومن قرأ عشر آيات من آخرها ثم خرج الدجال لم يسلط عليه ) )(@)(@@) ( طس ك ) و ابن مردويه ( هق ض ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22805 ) قال النبي :(@)(@@) | 30 ( من قرأ أول سورة الكهف وآخرها كانت له نورا ما بين الأرض إلى السماء ) )(@)(@@) ( حم طب ) و ابن السني وابن مردويه عن معاذ بن أنس رضي 
ms2455	 الله عنه .(@)(@@)(@@)(@@) $ ( 22806 ) قال النبي :(@)(@@) | 30 ( من قرأ سورة الكهف في يوم الجمعة سطع له نور من تحت قدميه إلى عنان السماء يضيء له يوم القيامة ، وغفر له ما بين الجمعتين ) )(@)(@@) ابن مردويه عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22807 ) قال النبي :(@)(@@) | 30 ( من قرأ سورة الكهف فهو معصوم إلى ثلاثة أيام ) )(@)(@@) ابن النجار عن أبي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22808 ) قال النبي :(@)(@@) | 30 ( من قرأ { ياس } في ليلة ابتغاء وجه الله غفر له ) )(@)(@@) ( حب ض ) عن الحسن عن جندب البجلي الدارمي ، ( عق ) وابن السني وابن مردويه ( هب ض ) عن الحسن عن أبي هريرة رضي الله عنه وصوب .(@)(@@)(@@)(@@) $ ( 22809 ) قال النبي : $ 30 ( من قرأ { ياس &(@)(@@)(@@)(@@) $ 1764 } فكأنما قرأ القرآن عشر مرات ) )(@)(@@) | ( هب ) عن ح$ سان بن عطية مرسلا .(@)(@@) PageV07P339(@)(@@)(@@)(@@) $ ( 22810 ) قال النبي : $ 30 ( من قرأ { ياس &(@)(@@)(@@)(@@) $ 1764 } في ليلة ابتغاء وجه الله غفر له تلك الليلة ) )(@)(@@) | ( هب ) عن أ$ بي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22811 ) قال النبي :(@)(@@) | 30 ( من قرأ { ياس } في ليلة أضعف على غيرها من القرآن عشرا ، ومن قرأها في صدر النهار وقدمها بين يدي حاجته قضيت ) )(@)(@@) أبو الشيخ عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22812 ) قال النبي :(@)(@@) | 30 ( من قرأ { آلم تنزيل الكتاب لا ريب فيه من رب العالمين } في بيته لم يدخل الشيطان بيته ثلاثة أيام ) )(@)(@@) الديلمي عن فروة الأشجعي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22813 ) قال النبي :(@)(@@) | 30 ( من قرأ { الدخان } في ليلة الجمعة أصبح مغفورا له وزوج من الحور العين ) )(@)(@@) الدارمي عن أبي رافع رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22814 ) قال النبي : $ 30 ( من قرأ ليلة الجمعة { حام الدخان } و { ياس &(@)(@@)(@@)(@@) $ 1764 } أصبح مغفورا له ) )(@)(@@) | ا| بن الضريس ( هب ) وضعفه عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22815 ) قال النبي :(@)(@@) | 30 ( من قرأ آخر سورة الحشر : { لو أنزلنا هاذا القرآن على جبل } . . . إلى آخرها ، فمات من ليلته مات شهيدا ) )(@)(@@) أبو الشيخ عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22816 ) قال النبي :(@)(@@) | 30 ( من قرأ كل ليلة : { إذا وقعت الواقعة } لم PageV07P340 يصبه فقر 
ms2456	 أبدا ، ومن قرأ كل ليلة : { لا أقسم بيوم القيامة } لقي الله يوم القيامة ووجهه كالقمر ليلة البدر ) )(@)(@@) ابن عساكر عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22817 ) قال النبي :(@)(@@) | 30 ( من قرأ في إثر وضوئه : { إنا أنزلناه في ليلة القدر } مرة واحدة كان من الصديقين ، ومن قرأها مرتين كان في ديوان الشهداء ، ومن قرأها ثلاثا حشره الله محشر الأنبياء ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22818 ) قال النبي :(@)(@@) | 30 ( من قرأ : { إنا أنزلناه في ليلة القدر } عدل بربع القرآن ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22819 ) قال النبي :(@)(@@) | 30 ( من قرأ : { قل يا أيها الكافرون } فكأنما قرأ ربع القرآن ، ومن قرأ : { قل هو الله أحد } فكأنما قرأ ثلث القرآن ) )(@)(@@) ( هب ) عن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22820 ) قال النبي :(@)(@@) | 30 ( من قرأ أم القرآن و { قل هو الله أحد } فكأنما قرأ ثلث القرآن ) )(@)(@@) أبو نعيم عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22821 ) قال النبي :(@)(@@) | 30 ( من قرأ في ليلة : { إذا زلزلت الأرض زلزالها } كانت له كعدل نصف القرآن ، ومن قرأ : { قل يا أيها الكافرون } PageV07P341 كانت له كعدل ربع القرآن ، ومن قرأ : { قل هو الله أحد } كانت له كعدل ثلث القرآن ) )(@)(@@) ابن السني عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22822 ) قال النبي :(@)(@@) | 30 ( من قرأ : { قل هو الله أحد } مرة واحدة فكأنما قرأ ثلث القرآن ، ومن قرأها مرتين فكأنما قرأ ثلثي القرآن ، ومن قرأها ثلاثا فكأنما قرأ القرآن كله ) )(@)(@@) الرافعي عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22823 ) قال النبي :(@)(@@) | 30 ( من قرأ : { قل هو الله أحد } مرة بورك عليه ، ومن قرأها مرتين بورك عليه وعلى أهله ، فإن قرأها ثلاثا بورك عليه وعلى أهله وجيرانه ، فإن قرأها اثنتي عشرة مرة بنى الله له اثني عشر قصرا في الجنة ، ويقول الحفظة : انطلقوا بنا إلى قصور أخينا ، فإن قرأها مائة مرة كفر عنه ذنوب خمس وعشرين سنة ما خلا الدماء والأموال ، فإن قرأها ثلاثمائة مرة كتب له أجر أربعمائة شهيد ، كل قد عقر جواده واهريق دمه ، وإن 
ms2457	 قرأها ألف مرة لم يمت حتى يرى مكانه من الجنة أو يرى له ) )(@)(@@) ابن عساكر عن إبان عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22824 ) قال النبي :(@)(@@) | 30 ( من قرأ : { قل هو الله أحد } حين يدخل منزله نفت الفقر عن أهل ذالك المنزل والجيران ) )(@)(@@) ( طب ) عن جرير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22825 ) قال النبي :(@)(@@) | 30 ( من قرأ في ليلة أو يوم : { قل هو الله أحد } ثلاث مرات ، كان مقدار القرآن ) )(@)(@@) ابن النجار عن كعب بن عجرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22826 ) قال النبي :(@)(@@) | 30 ( من قرأ : { قل هو الله أحد } ثنتي عشرة مرة بعد صلاة الفجر فكأنما قرأ القرآن أربع مرات ، وكان أفضل أهل الأرض يومئذ إذا PageV07P342 اتقى ) )(@)(@@) ( هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22827 ) قال النبي :(@)(@@) | 30 ( من قرأ : { قل هو الله أحد } على طهارة مائة مرة كطهره للصلاة ، يبدأ بفاتحة الكتاب كتب الله له بكل حرف عشر حسنات ، ورفع له عشر درجات ، وبنى له مائة قصر في الجنة ، ورفع له من العمل في يومه ذالك مثل عمل نبي ، وكأنما قرأ القرآن ثلاثا وثلاثين مرة ، وبراءة من الشرك ، ومحضرة الملائكة ، ومنفرة الشيطان ، ولها دوي حول العرش تذكر بصاحبها حتى ينظر الله إليه ، فإذا نظر الله إليه لم يعذبه أبدا ) )(@)(@@) ( عد هب ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22828 ) قال النبي :(@)(@@) | 30 ( من قرا : { قل هو الله أحد } عشية عرفة ألف مرة أعطاه الله عز وجل ما سأل ) )(@)(@@) أبو الشيخ عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22829 ) قال النبي :(@)(@@) | 30 ( من قرأ : { قل هو الله أحد } دبر كل صلاة مكتوبة عشر مرات أوجب الله له رضوانه ومغفرته ) )(@)(@@) ابن النجار عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22830 ) قال النبي :(@)(@@) | 30 ( من قرأ بعد صلاة الجمعة فاتحة الكتاب ، وقل هو الله أحد ، وقل أعوذ برب الفلق ، وقل أعوذ برب الناس ، سبع مرات أعاذه الله عز وجل بها من السوء إلى الجمعة الأخرى ) )(@)(@@) ابن السني وابن شاهين عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 22831 ) قال النبي :(@)(@@) | 30 ( من 
ms2458	 قرأ بعد الجمعة بفاتحة الكتاب ، و { قل هو PageV07P343 الله أحد } ، و { قل أعوذ برب الفلق } ، و { قل أعوذ برب الناس } حفظ ما بينه وبين الجمعة الأخرى ) )(@)(@@) ( ش ) عن أسماء بنت أبي بكر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22832 ) قال النبي :(@)(@@) | 30 ( من قرأ في ليلة ألف آية لقي الله وهو ضاحك في وجهه ، قيل : يا رسول الله ومن يقوى على قراءة ألف آية ؟ فقرأ : { بسم الله الرحمان الرحيم ، ألهاكم التكاثر } إلى آخرها ، ثم قال : والذي بعثني بالحق إنها لتعدل ألف آية ) )(@)(@@) الخطيب في المتفق والمفترق وقال : غير ثابت ، والديلمي عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22833 ) قال النبي :(@)(@@) | 30 ( من قرأ خلفي : ب { سبح اسم ربك الأعلى } ؟ لقد رأيتك تخالجني القرآن ، من صلى منكم خلف إمامه فقراءته له ) )(@)(@@) ( هق ) في المعرفة عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22834 ) قال النبي :(@)(@@) | 30 ( من قرأ القرآن وتفقه في الدين ، ثم أتى صاحب سلطان طمعا لما في يديه ، طبع الله على قلبه ، وعذب كل يوم بلونين من العذاب لم يعذب به قبل ذالك ) )(@)(@@) أبو الشيخ عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22835 ) قال النبي :(@)(@@) | 30 ( من قرأ القرآن وتفقه في الدين ، ثم أتى صاحب سلطان طمعا لما في يده ، خاض بقدر خطاه في نار جهنم ) )(@)(@@) ( ك ) في تاريخه عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22836 ) قال النبي :(@)(@@) | 30 ( من قضى لأخيه حاجة من حوائج الدنيا ، قضى PageV07P344 الله تعالى له اثنتين وسبعين حاجة أسهلها المغفرة ) )(@)(@@) الخطيب عن دينار عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22837 ) قال النبي :(@)(@@) | 30 ( من قضى نهمته من الدنيا حيل بينه وبين شهوته في الآخرة ، ومن مد عينه إلى زينة المترفين كان مهينا في ملكوت السماء ، ومن صبر على القوت الشديد صبرا جميلا أسكنه الله من الفردوس حيث شاء ) )(@)(@@) ( هب ) و ابن صصرى في أماليه وحسنه عن البراء ، قال ( هب ) : تفرد به إسماعيل بن عمر البجلي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22838 ) قال النبي :(@)(@@) | 30 ( من قضى لأخيه حاجة في غير معصية كان كمن خدم الله عمره ) )(@)(@@) الديلمي 
ms2459	 عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22839 ) قال النبي :(@)(@@) | 30 ( من قطع ميراثا فرضه الله قطع الله ميراثه من الجنة ) )(@)(@@) ( ص ) عن سل يمان بن موسى مرسلا .(@)(@@)(@@)(@@) $ ( 22840 ) قال النبي :(@)(@@) | 30 ( من قضى دين والديه بعد موتهما ، وأوفى نذرهما ، ولم يستسب لهما فقد برهما ، وإن كان عاقا بهما ، ومن لم يقض دينهما ولم يوف نذرهما واستسب لهما فقد عقهما وإن كان بهما بارا في حياتهما ) )(@)(@@) ابن عساكر عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22841 ) قال النبي :(@)(@@) | 30 ( من قطع السدر إلا من زرع بنى الله له بيتا في النار ) )(@)(@@) ( طب هق ) عن عمرو بن أوس الثقفي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22842 ) قال النبي :(@)(@@) | 30 ( من قطع السدر إلا من زرع صب عليه العذاب صبا ) )(@)(@@) البغوي ( هق ) عن عمرو بن أوس عن شيخ من ثقيف .(@)(@@)(@@)(@@) $ ( 22843 ) قال النبي :(@)(@@) | 30 ( من قعد إلى قينة يستمع منها ، صب الله في أذنيه الآنك يوم القيامة ) )(@)(@@) ابن صصرى في أماليه ، ( كر ) عن أنس رضي الله عنه .(@)(@@) PageV07P345(@)(@@)(@@)(@@) $ ( 22844 ) قال النبي :(@)(@@) | 30 ( من قعد مقعدا لم يذكر الله فيه كانت عليه من الله ترة ، ومن قام مقاما لم يذكر الله فيه كانت عليه من الله ترة ، ومنه اضطجع مضطجعا لم يذكر الله فيه كانت عليه من الله ترة ) )(@)(@@) ( هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22845 ) قال النبي :(@)(@@) | 30 ( من قنع بما رزق دخل الجنة ) )(@)(@@) ابن شاهين والديلمي عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22846 ) قال النبي :(@)(@@) | 30 ( من قهقه في الصلاة قهقهة شديدة فعليه الوضوء والصلاة ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22847 ) قال النبي :(@)(@@) | 30 ( من قل ماله ، وكثر عياله ، وحسنت صلاته ، ولم يغتب المسلمين ، جاء يوم القيامة وهو معي كهاتين ) )(@)(@@) ( ع ) و الخطيب وابن عساكر عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22848 ) قال النبي :(@)(@@) | 30 ( من كاتب مكاتبا على مائة درهم ، فقضاها كلها إلا عشرة دراهم فهو عبد ، أو على مائة أوقية فقضاها كلها إلا أوقية فهو عبد ) )(@)(@@) ( عب ) عن ابن عمرو رضي الله عنه 
ms2460	 .(@)(@@)(@@)(@@) $ ( 22849 ) قال النبي :(@)(@@) | 30 ( من كان عنده أوقية ثم سأل فقد سأل إلحافا ) )(@)(@@) الباوردي وابن السكن وابن قانع عن أسيد المزني بالفتح ، قال ابن السكن : إسناده صالح ، وقال ابن منده تفرد بن ابن وهب .(@)(@@)(@@)(@@) $ ( 22850 ) قال النبي :(@)(@@) | 30 ( من كان وصلة لأخيه المسلم إلى ذي سلطان في مبلغ بر أو تيسير عسير ، أو إدخال السرور رفعه الله في الدرجات العلى من الجنة ) )(@)(@@) ( طب ) و ابن عساكر عن أبي الدرداء رضي الله عنه .(@)(@@) PageV07P346(@)(@@)(@@)(@@) $ ( 22851 ) قال النبي :(@)(@@) | 30 ( من كان له إمام فقراءة الإمام له قراءة ) )(@)(@@) ( حم ) و عبد بن حميد والطحاوي ، ( ه قط ) وضعفاه ، ( هق ) في المعرفة وضعفه ، وابن عساكر عن أنس ، والخطيب ( هق ) فيه وضعفه عن ابن عمر ، ( طس هق ) فيه وضعفه عن أبي سعيد ( عب ش هق ) فيه عن عبد الله بن شداد ابن الهاد الليثي ، ( هق ) فيه والخطيب في المتفق والمفترق وضعفاه عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22852 ) قال النبي :(@)(@@) | 30 ( من كان يؤمن بالله واليوم الآخر فلا يدخل حليلته الحمام ، ومن كان يؤمن بالله واليوم الآخر فلا يقعد على مائدة يدخل عليها الخمر ، ومن كان يؤمن بالله واليوم الآخر فلا يخلون بامرأة ليس معها ذو محرم منها ، فإن ثالثهما الشيطان ) )(@)(@@) ( حم ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22853 ) قال النبي :(@)(@@) | 30 ( من كان يؤمن بالله واليوم الآخر فعليه الجمعة يوم الجمعة إلا مريض أو مسافر أو امرأة أو صبي أو مملوك ، ومن استغنى عنها بلهو أو تجارة استغنى الله عنه والله غني حميد ) )(@)(@@) ( عد قط هق ن ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22854 ) قال النبي :(@)(@@) | 30 ( من كان يؤمن بالله واليوم الآخر فليقل خيرا أو ليسكت ، ومن كان يؤمن بالله واليوم الآخر فليكرم ضيفه ، والضيافة ثلاثة ليال ، فما كان وراء ذالك فهو صدقة ) )(@)(@@) ( طب ) عن زيد بن خالد الجهني رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22855 ) قال النبي :(@)(@@) | 30 ( من كان له ثلاث بنات أو ثلاث أخوات فاتقى الله وقام عليهن كان معي في الجنة كهاذا وأشار بأصابعه الأربع ) )(@)(@@) ( حم 