ms2293	 شيء ) )(@)(@@) ( عق ) عن ابن مسعود رضي الله عنه .(@)(@@) PageV07P132(@)(@@)(@@)(@@) $ ( 21400 ) قال النبي :(@)(@@) | 30 ( من أعتق عبدا فماله للذي أعتق ) )(@)(@@) ( هق ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21401 ) قال النبي :(@)(@@) | 30 ( من أعتق رقبة فك الله بكل عضو من أعضائه من النار ) )(@)(@@) ( ك ) عن عقبة بن عامر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21402 ) قال النبي :(@)(@@) | 30 ( من أعتق رقبة كانت فكاكه من النار عضوا بعضو ) )(@)(@@) ( ك هق ) عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21403 ) قال النبي :(@)(@@) | 30 ( من أعتق رقبة مؤمنة أعتق الله بكل إرب منها إربا منه من النار حتى إنه ليعتق باليد اليد ، وبالرجل الرجل ، وبالفرج الفرج ) )(@)(@@) ( حم ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21404 ) قال النبي :(@)(@@) | 30 ( من أعتق شقصا له في مملوك ضمن بقيته ) )(@)(@@) ( حم ) عن سعيد بن المسيب عن ثلاثين من الصحابة رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 21405 ) قال النبي :(@)(@@) | 30 ( من أعتق سهما في مملوك فعتقه عليه في ماله وإن كان له مال ليس لله شريك ) )(@)(@@) ( هق ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21406 ) قال النبي :(@)(@@) | 30 ( من أعتق عبدا وله فيه شرك وله وفاء فهو حر ، ويضمن نصيب شركائه بقيمة عدل بما أساء مشاركتهم وليس على العبد شيء ) )(@)(@@) ( هق كر ) عن جابر ( كر ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21407 ) قال النبي :(@)(@@) | 30 ( من أعتق شركا في مملوك له فقد ضمن عتقه ، يقوم العبد يوم يعتق ) )(@)(@@) ( هق ) عن ابن عباس رضي الله عنهما .(@)(@@) PageV07P133(@)(@@)(@@)(@@) $ ( 21408 ) قال النبي :(@)(@@) | 30 ( من اعتكف نفسه ما بين المغرب والعشاء في مسجد جماعة لم يتكلم إلا بصلاة وقرآن كان حقا على الله تعالى أن يبني له قصرا في الجنة ) )(@)(@@) ابن شاهين والخطيب عن ثوبان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21409 ) قال النبي :(@)(@@) | 30 ( من أعد قوما في الحرم ليقاتل بها عدو الكعبة كتب الله له بكل يوم ألف ألف حسنة حتى يحضر العدو ) )(@)(@@) الحسين بن سفيان وأبو نعيم عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21410 ) قال النبي :(@)(@@) | 30 ( من أعرض عن صاحب بدعة بغضا له ملأ الله 
ms2294	 قلبه أمنا وإيمانا ، ومن انتهر صاحب بدعة أمنه الله تعالى يوم الفزع الأكبر ، ومن أهان صاحب بدعة رفعه الله تعالى في الجنة مائة درجة ، ومن سلم على صاحب بدعة أو لقيه بالبشر أو استقبله بما يسره فقد استخف بما أنزل الله على محمد ) )(@)(@@) الخطيب عن ابن عمرو رضي الله عنه قال : تفرد به الحسين بن خالد أبو الجنيد وغيره أوثق منه .(@)(@@)(@@)(@@) $ ( 21411 ) قال النبي :(@)(@@) | 30 ( من أعطي أربعا لم يحرم أربعا : من أعطي الدعاء لم يحرم الإجابة لأن الله تعالى يقول : { ادعوني أستجب لكم } ، ومن أعطي الشكر لم يحرم الزيادة لأن الله تعالى يقول : { لئن شكرتم لأزيدنكم } ، ومن أعطي الاستغفار لم يحرم المغفرة لأن الله تعالى يقول : { استغفروا ربكم إنه كان غفارا } ، ومن أعطي التوبة لم يحرم القبول لأن الله تعالى يقول : { وهو الذي يقبل التوبة عن عباده } ) )(@)(@@) ( هب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21412 ) قال النبي :(@)(@@) | 30 ( من أعطي أربعا أعطي أربعا وتفسير ذالك في كتاب PageV07P134 الله ، من أعطي الذكر ذكره الله تعالى إذ يقول : { فاذكروني أذكركم } ، ومن أعطي الدعاء أعطي الإجابة لأن الله تعالى يقول : { ادعوني أستجب لكم } ، ومن أعطي الشكر أعطي الزيادة لأن الله تعالى يقول : { لئن شكرتم لأزيدنكم } ، ومن أعطي الاستغفار أعطي المغفرة لأن الله تعالى يقول : { استغفروا ربكم إنه كان غفارا } ) )(@)(@@) ( هب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21413 ) قال النبي :(@)(@@) | 30 ( من أعطي الرفق في الدنيا ينفعه في الآخرة ) )(@)(@@) البغوي عن رجل .(@)(@@)(@@)(@@) $ ( 21414 ) قال النبي :(@)(@@) | 30 ( من أعطى امرأته عطية فهو له صدقة ) )(@)(@@) أبو نعيم عن أمية الضمري عن عائشة رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21415 ) قال النبي :(@)(@@) | 30 ( من أعطي شيئا من غير سؤال ولا استشراف نفس فإنه رزق من الله فليقبله ولا يرده ) )(@)(@@) الهيثم بن كليب وابن عساكر عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21416 ) قال النبي :(@)(@@) | 30 ( من أعطي حظه من الرفق أعطي حظه من خير الدنيا والآخرة ، ومن حرم حظه من الرفق حرم حظه من خير الدنيا والآخرة ، وصلة الرحم ، وحسن الخلق 
ms2295	 وحسن الجوار يعمرن الديار ، ويزدن في الأعمار ) )(@)(@@) ( حم ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 21417 ) قال النبي :(@)(@@) | 30 ( من أعمر عمرى فهي له ولورثته بعد ) )(@)(@@) الشيرازي في الألقاب PageV07P135 عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21418 ) قال النبي :(@)(@@) | 30 ( من أغاث ملهوفا إغاثة غفر الله له ثلاثا وسبعين مغفرة ، واحدة في الدنيا واثنتين وسبعين في الدرجات العلى من الجنة ، ومن قال أشهد أن لا إلاه إلا الله وحده لا شريك له أحدا صمدا لم يلد ولم يولد ولم يكن له كفوا أحد كتب الله له بها أربعين ألف ألف حسنة ) )(@)(@@) ابن عساكر عن عبد الله بن عبد الرحمان بن أبي حسين المكي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21419 ) قال النبي :(@)(@@) | 30 ( من اغبرت قدماه في سبيل الله فهما حرام على النار ) )(@)(@@) ( ط حم ) و الباوردي ( هق ) عن جابر بن زنجويه ( كر ) عن رجل .(@)(@@)(@@)(@@) $ ( 21420 ) قال النبي :(@)(@@) | 30 ( من اغبرت قدماه في سبيل الله حرمهما الله على النار ) )(@)(@@) ابن زنجويه وسمويه والبزار وابن عساكر عن أبي بكر الصديق رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21421 ) قال النبي :(@)(@@) | 30 ( من اغتسل يوم الجمعة ولبس أحسن ثيابه وبكر ودنا كانت كفارة إلى الجمعة الأخرى ) )(@)(@@) ابن منده وأبو نعيم ( كر ) عن يحيى بن عبد الرحمن بن حاطب بن أبي بلتعة عن أبيه عن جده قال ابن منده : غريب .(@)(@@)(@@)(@@) $ ( 21422 ) قال النبي :(@)(@@) | 30 ( من أغلق بابه دون ذوي الفقر والحاجة أغلق الله عن فقره وحاجته باب السماء ) )(@)(@@) ابن عساكر عن أبي مريم رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21423 ) قال النبي :(@)(@@) | 30 ( من اغتسل يوم الجمعة كغسله من الجنابة ، ومس من دهن أو طيب إن كان عنده ، ولبس أحسن ما عنده من الثياب ، ولم يفرق بين اثنين ، وأنصت للإمام إذا جاءه ، غفر له ما بين الجمعتين ) )(@)(@@) ابن سعد عن أبي وديعة رضي الله عنه .(@)(@@) PageV07P136(@)(@@)(@@)(@@) $ ( 21424 ) قال النبي :(@)(@@) | 30 ( من اغتسل يوم الجمعة كفرت عنه ذنوبه وخطاياه ، فإذا أخذ في المشي إلى الجمعة كتب له بكل خطوة عمل عشرين سنة ، فإذا انصرف من الصلاة 
ms2296	 أجر بعمل مائتي سنة ) )(@)(@@) ( خط ) في العلل وقال : غير ثابت ( طب هب ) و ابن النجار عن أبي بكر وعمران بن حصين رضي الله عنهما معا .(@)(@@)(@@)(@@) $ ( 21425 ) قال النبي :(@)(@@) | 30 ( من اغتسل يوم الجمعة فأحسن غسله ، ثم مس من طيب بيته وادهن من دهنه ، ولبس من ثيابه ثم أتى الجمعة فلم يفرق بين اثنين ، وصلى ما كتب له ، وإذا خرج الإمام أنصت ثم استمع غفر له ما بينه وبين الجمعة الأخرى ) )(@)(@@) ( ط ) و الدارمي ( حب ) وابن زنجويه ( طب هق ) عن سلمان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21426 ) قال النبي :(@)(@@) | 30 ( من اغتسل يوم الجمعة ولبس من أحسن ثيابه ، ومن طيب إن كان عنده ، ثم مشى إلى الجمعة وعليه السكينة ، ولم يتخط أحدا ولم يؤذه ، ثم ركع ما قضي له ، ثم انتظر حتى ينصرف الإمام غفر له ما بيحن الجمعتين ) )(@)(@@) ( حم طب ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21427 ) قال النبي :(@)(@@) | 30 ( من اغتسل يوم الجمعة أخرجه الله من ذنوبه ثم قيل له استأنف العمل ) )(@)(@@) الديلمي عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21428 ) قال النبي :(@)(@@) | 30 ( من اغتسل يوم الجمعة بنية وحسبة تنظفا للجمعة من غير جنابة كتب له بكل شعرة سبلها من رأسه ولحيته وسائر جسده حسنة ) )(@)(@@) ( خ ) في تاريخه عن ابن عباس وأبي هريرة رضي الله عنهما معا .(@)(@@)(@@)(@@) $ ( 21429 ) قال النبي :(@)(@@) | 30 ( من اغتسل يوم الجمعة فأحسن غسله ولبس من PageV07P137 صالح ثيابه ، ومس من طيب بيته أو دهنه غفر له ما بينه وبين الجمعة الأخرى وزيادة ثلاثة أيام التي بعدها ) )(@)(@@) ( حب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21430 ) قال النبي :(@)(@@) | 30 ( من أغلق بابه دون ذوي الحاجة والخلة والمسكنة أغلق الله دون خلته وحاجته وفقره ومسكنته ) )(@)(@@) ( ك ) عن عمرو بن مرة الجهني رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21431 ) قال النبي :(@)(@@) | 30 ( من أغلق بابه دون جاره مخافة على أهله وماله فليس ذالك بمؤمن ، وليس بمؤمن من لا يأمن جاره بوائقه ) )(@)(@@) الخرائطي في مساوىء الأخلاق عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21432 ) قال النبي :(@)(@@) | 30 
ms2297	 ( من أفاض من عرفات قبل الصبح فقد تم حجه ، ومن فاته فقد فاته الحج ) )(@)(@@) ( هق ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21433 ) قال النبي :(@)(@@) | 30 ( من أفضى بيده إلى ذكره فليتوضأ ) )(@)(@@) الخطيب في المتفق والمفترق عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21434 ) قال النبي :(@)(@@) | 30 ( من أفضى بيده إلى ذكره ليس بينهما ستر ولا حجاب فليتوضأ ) )(@)(@@) الشافعي والطحاوي عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21435 ) قال النبي :(@)(@@) | 30 ( من أفطر يوما من شهر رمضان من غير رخصة ولا عذر كان عليه أن يصوم ثلاثين يوما ، ومن أفطر يومين عليه ستين يوما ، ومن أفطر على ثلاثة أيام كان عليه تسعين يوما ) )(@)(@@) ( قط ) وضعفه و ابن صصرى في أماليه والديلمي وابن عساكر عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21436 ) قال النبي :(@)(@@) | 30 ( من أفطر فرخصة ، ومن صام فالصوم أفضل يعني في السفر ) )(@)(@@) ( ض ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21437 ) قال النبي :(@)(@@) | 30 ( من أفطر يوما من رمضان من غير علة فعليه صوم PageV07P138 شهر ) )(@)(@@) ( كر ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21438 ) قال النبي :(@)(@@) | 30 ( من أقال نادما بيعته أقال عثرته يوم القيامة ) )(@)(@@) ( حب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21439 ) قال النبي :(@)(@@) | 30 ( من أقال مسلما بيعا أقاله الله نفسه يوم القيامة ، ومن وصل صفا وصل الله خطوه يوم القيامة ) )(@)(@@) عبد الرزاق عن معمر عن يحيى بن أبي كثير مرسلا .(@)(@@)(@@)(@@) $ ( 21440 ) قال النبي :(@)(@@) | 30 ( من أقال مسلما عثرته أقاله الله عثرته يوم القيامة ) )(@)(@@) ( حب هق ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21441 ) قال النبي :(@)(@@) | 30 ( من أقال أخاه المؤمن عثرته في الدنيا أقال الله تعالى عثرته يوم القيامة ) )(@)(@@) ابن النجار عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21442 ) قال النبي :(@)(@@) | 30 ( من أقام الصلاة وآتى الزكاة وحج البيت ، وصام رمضان ، وقرى الضيف دخل الجنة ) )(@)(@@) ( طب هب ) عن ابن عباس رضي الله عنهما وضعف .(@)(@@)(@@)(@@) $ ( 21443 ) قال النبي :(@)(@@) | 30 ( من أقام الصلاة وآتى الزكاة ومات يعبد الله لا يشرك به شيئا ، فإن حقا على الله أن يدخله الجنة 
ms2298	 هاجر أو قعد في مولده ) )(@)(@@) ( طب ) عن أبي مالك الأشعري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21444 ) قال النبي :(@)(@@) | 30 ( من أقام الصلاة وآتى الزكاة ومات لا يشرك بالله شيئا كان حقا على الله أن يدخله الجنة ، هاجر أو مات في مولده ، قالوا : يا رسول الله ! ألا تبشر بها أصحابك ؟ قال : دعوا الناس فليعملوا ، فإن في الجنة PageV07P139 مائة درجة ، ما بين كل درجتين كما بين السماء والأرض أعدها الله للمجاهدين في سبيله ، ولولا أن أشق على الناس بعدي ما تخلفت عن سرية أبعثها ، ولاكن لا يجدون سعة فيتبعوني ، ولا تطيب أنفسهم أن يتخلفوا بعدي ، ولا أجد ما أفضل به عليهم ، ولوددت أن أغزو فأقتل ثم أحيا فأغزو فأقتل ، ثم أحيا ثم أقتل ) )(@)(@@) الروياني وابن عساكر ( ش ) عن أبي ذر ( ن طب كر ) عن أبي الدرداء رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21445 ) قال النبي :(@)(@@) | 30 ( من أقام الصلاة وآتى الزكاة وصام رمضان ، واجتنب الكبائر له الجنة ، قيل : وما الكبائر ؟ قال : الإشراك بالله ، وعقوق الوالدين ، والفرار من الزحف ) )(@)(@@) ابن جرير عن أبي أيوب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21446 ) قال النبي :(@)(@@) | 30 ( من اقتطع شيئا من مال أخيه بيمين فاجرة فليتبوأ مقعده من النار ، ليبلغ شاهدكم غائبكم ) )(@)(@@) ( حب ) و البغوي والباوردي وابن قانع ( طب ك هق ) عن الحارث بن البرصاء الليثي رضي الله عنه ، قال البغوي : ولا أعلم له غير حديثين ، هاذا وحديث لا نغزي مكة .(@)(@@)(@@)(@@) $ ( 21447 ) قال النبي :(@)(@@) | 30 ( من اقتطع مال امرىء مسلم بيمين كاذبة كانت نكتة سوء في قلبه لا يغيرها شيء إلى يوم القيامة ) )(@)(@@) ( طب ) و الحاكم في الكنى ا ( ك ) عن أبي أمامة الحارثي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21448 ) قال النبي :(@)(@@) | 30 ( من اقتطع حق مسلم بيمين لقي الله وهو عليه غضبان ) )(@)(@@) ( طب ) عن الأشعث بن قيس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21449 ) قال النبي :(@)(@@) | 30 ( من اقتطع شبرا من الأرض ظلما ، طوقه الله يوم القيامة من سبع أرضين ، ومن اقتطع مالا بيمينه فلا بورك له فيه ، ومن تولى قوما بغير إذنهم فعليه لعنة الله والملائكة والناس 
ms2299	 أجمعين ) )(@)(@@) ابن جرير ( ك ) عن سعيد بن زيد رضي الله عنه .(@)(@@) PageV07P140(@)(@@)(@@)(@@) $ ( 21450 ) قال النبي :(@)(@@) | 30 ( من اقتطع شبرا من الأرض بغير حقه طوقه الله يوم القيامة إلى سبع أرضين ) )(@)(@@) ( حم ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21451 ) قال النبي :(@)(@@) | 30 ( من اقتنى كلبا فإنه ينقص من عمله كل يوم قيراط إلا كلب حرث أو ماشية ) )(@)(@@) ( ه ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21452 ) قال النبي :(@)(@@) | 30 ( من أقرض رجلا مسلما دراهم كان له أجر صدقتها مرة واحدة ) )(@)(@@) ( هب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21453 ) قال النبي :(@)(@@) | 30 ( من أقرض لله مرتين كان له مثل أجر أحدهما لو تصدق به ) )(@)(@@) ( حب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21454 ) قال النبي :(@)(@@) | 30 ( من أكثر ذكر الله أحبه ) )(@)(@@) ابن شاهين عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 21455 ) قال النبي :(@)(@@) | 30 ( من أكثر ذكر الله فقد برىء من النفاق ) )(@)(@@) ابن شاهين في الترغيب في الذكر عن أبي هريرة رضي الله عنه ورجاله ثقات .(@)(@@)(@@)(@@) $ ( 21456 ) قال النبي :(@)(@@) | 30 ( من أكرم سلطان الله في الدنيا أكرمه الله يوم القيامة ، ومن أهان سلطان الله في الدنيا أهانه الله يوم القيامة ) )(@)(@@) ( حم خ ) في التاريخ والروياني ( هق ) عن أبي بكرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21457 ) قال النبي :(@)(@@) | 30 ( من أكرم أخاه فإنما يكرم الله ) )(@)(@@) ابن النجار عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21458 ) قال النبي :(@)(@@) | 30 ( من أكرمه أخوه المسلم فليقبل كرامته فإنما هي كرامة الله فلا تردوا على الله كرامته ) )(@)(@@) الخرائطي في مكارم الأخلاق ، وابن لال وأبو نعيم وابن عساكر PageV07P141 عن أنس وفيه سعيد بن عبد الله بن دينار أبو روح التمار البصري قال أبو حاتم : مجهول .(@)(@@)(@@)(@@) $ ( 21459 ) قال النبي :(@)(@@) | 30 ( من أكل درهما ربا فهو مثل ثلاث وثلاثين زنية ) )(@)(@@) ابن عساكر عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21460 ) قال النبي :(@)(@@) | 30 ( من أكل الطين حوسب على ما نقص من لونه ونقص من جسمه ) )(@)(@@) ابن عساكر عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21461 ) قال النبي :(@)(@@) | 30 ( من أكل 
ms2300	 من هاذه الشجرة الخبيثة فلا يقربن مسجدنا يعني الثوم ) )(@)(@@) عن عبد الرزاق ( طب ) عن العلاء بن خباب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21462 ) قال النبي :(@)(@@) | 30 ( من أكل من هاتين الشجرتين الخبيثتين فلا يقربنا في مسجدنا ، فإن كنتم لا بد آكليها فأميتوها طبخا ) )(@)(@@) ( حم هب هق ) عن معاوية بن فزة عن أبيه .(@)(@@)(@@)(@@) $ ( 21463 ) قال النبي :(@)(@@) | 30 ( من أكل من هاذه الشجرة يعني الثوم فلا يقربن مصلانا ) )(@)(@@) ( حم طب ) عن معقل بن يسار رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21464 ) قال النبي :(@)(@@) | 30 ( من أكل من هاذه الشجرة شيئا فلا يقربن مسجدنا إلا من عذر ) )(@)(@@) ( طب ) عن المغيرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21465 ) قال النبي :(@)(@@) | 30 ( من أكل بأخيه المسلم أكلة أطعمه الله مثلها من النار ، ومن لبس بأخيه المسلم ثوبا كساه الله مثله من النار ، ومن سمع بأخيه المسلم وراءى به سمع الله به وراءى به يوم القيامة ) )(@)(@@) الخرائطي في مساوىء الأخلاق PageV07P142 عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 21466 ) قال النبي :(@)(@@) | 30 ( من أكل من هاذه البقلة الخبيثة يعني الثوم فلا يقربن مسجدنا ) )(@)(@@) ( طس ) عن أبي بكر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21467 ) قال النبي :(@)(@@) | 30 ( من أكل من هاذه الشجرة فلا يقربن مسجدنا ) )(@)(@@) ( طس ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21468 ) قال النبي :(@)(@@) | 30 ( من أكل من هاذه الشجرة فلا يقربن مساجدنا يعني الثوم ) )(@)(@@) ( طس ) عن عبد الله بن زيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21469 ) قال النبي :(@)(@@) | 30 ( من أكل من هاذه الخضروات البصل والثوم ، والكراث ، والفجل ، فلا يقربن مسجدنا ) )(@)(@@) ( طس ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21470 ) قال النبي :(@)(@@) | 30 ( من أكل من هاذه الشجرة الخبيثة يعني الثوم فلا يقربن المسجد ، فإن الملائكة تتأذى مما يتأذى منه ابن آدم ) )(@)(@@) البغوي وابن قانع عن شريك بن شرحبيل ، وقيل ابن حنبل .(@)(@@)(@@)(@@) $ ( 21471 ) قال النبي :(@)(@@) | 30 ( من أكل من خضركم هاذه شيئا فلا يقربن مسجدنا فإن الملائكة تتأذى مما يتأذى منه بنو آدم ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21472 ) قال النبي :(@)(@@) | 30 ( من أكل من ه