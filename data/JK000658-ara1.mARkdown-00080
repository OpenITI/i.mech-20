ms65	 التيمي النيسابوري ثم الدمشقي بمصر(@)(@@)(@@)(@@) $ 2185 والمحدث اللغوي شرف الدين الحسين بن إبراهيم الإربلي(@)(@@)(@@)(@@) $ 2186 والحافظ المتقن ولي الدين أبو محمد عبدالعظيم بن عبدالقوي بن عبدالله بن سلامة المنذري المصري الشافعي(@)(@@)(@@)(@@) $ 2187 والمحدث شمس الدين أبو الحسن علي بن المظفر بن القاسم الربعي النشبي الدمشقي(@)(@@)(@@)(@@) $ 2188 وخطيب مردا أبو عبدالله محمد بن إسماعيل بن أحمد المقدسي PageV01P208(@)(@@)(@@)(@@) $ 2189 والمقرىء الكبير أبو عبدالله محمد بن حسن بن محمد الفاسي(@)(@@)(@@)(@@) $ 2190 والمسند عفيف الدين أبو محمد المرجا بن الحسن بن شقير الواسطي التاجر المقرىء(@)(@@)(@@)(@@) $ 2191 والمحدث نجيب الدين أبو الفتح نصرالله بن أبي العز مظفر الشيباني الدمشقي الصفار(@)(@@)(@@)(@@) $ 2192 والمحدث مسند المغرب أبو الحسين أحمد بن محمد بن أحمد بن السراج(@)(@@)(@@)(@@) $ 2193 والمسند مجير الدين إبراهيم بن خليل الأدمي بحلب(@)(@@)(@@)(@@) $ 2194 والمحدث المفيد محب الدين عبدالله بن أحمد بن أبي بكرمحمد بن إبراهيم السعدي المقدسي كهلا(@)(@@)(@@)(@@) $ 2195 وأبو محمد عبدالله بن بركات بن إبراهيم الخشوعي الرفاء(@)(@@)(@@)(@@) $ 2196 والشيخ العماد عبدالحميد بن عبدالهادي بن يوسف المقدسي(@)(@@)(@@)(@@) $ 2197 والفقيه الرباني أبو عبدالله محمد بن أبي الحسين أحمد بن عبدالله اليونيني الحافظ PageV01P209(@)(@@)(@@)(@@) $ 2198 والحافظ أبو عبدالله محمد بن عبدالله بن أبي بكر بن الأبار القضاعي شهيدا(@)(@@)(@@)(@@) $ 2199 وشمس الدين محمد بن عبدالهادي بن يوسف المقدسي أخو العماد(@)(@@)(@@)(@@) $ 2200 والحافظ أبو بكر أحمد بن أحمد بن عبدالله الإشبيلي ابن سيد الناس اليعمري خطيب تونس(@)(@@)(@@)(@@) $ 2201 والعلامة عزالدين عبدالعزيز بن عبدالسلام السلمي الدمشقي شيخ الشافعية بمصر(@)(@@)(@@)(@@) $ 2202 والصاحب المحدث جمال الدين أبو القاسم عمر بن أحمد بن هبة الله ابن أبي جرادة العقيلي ابن العديم(@)(@@)(@@)(@@) $ 2203 والمحدث المفسر عز الدين أبو محمد عبدالرزاق بن رزق الله الرسعني(@)(@@)(@@)(@@) $ 2204 والمسند عبدالغني بن سليمان بن بنين المصري الناسخ(@)(@@)(@@)(@@) $ 2205 وشيخ القراء كمال الدين أبو الحسن علي بن شجاع بن سالم العباسي المصري الضرير PageV01P210(@)(@@)(@@)(@@) $ 2206 وشيخ القراء علم الدين أبو محمد القاسم بن أحمد بن الموفق الأندلسي نزيل دمشق(@)(@@)(@@)(@@) $ 2207 وشيخ الشيوخ شرف الدين عبدالعزيز بن محمد بن عبد المحسن الأنصاري 
ms66	 الحموي(@)(@@)(@@)(@@) $ 2208 وقاضي دمشق عماد الدين عبدالكريم بن عبدالصمد بن محمد بن الحرستاني الآنصاري(@)(@@)(@@)(@@) $ 2209 والمحدث ضياءالدين علي بن محمد بن علي البالسي الدمشقي(@)(@@)(@@)(@@) $ 2210 والحفظ رشيدالدين أبو الحسين يحيى بن علي بن عبدالله القرشي المصري العطار(@)(@@)(@@)(@@) $ 2211 والمحدث أبو إسحاق إبراهيم بن عمر بن عبدالعزيز القرشي الدمشقي(@)(@@)(@@)(@@) $ 2212 والمحدث أبو اسحاق إبراهيم بن محمد بن هرون الكندي السبتي الكماد(@)(@@)(@@)(@@) $ 2213 والمحدث محيي الدين محمد بن محمد بن إبراهيم بن سراقة الأنصاري الشاطبي بمصر(@)(@@)(@@)(@@) $ 2214 والحافظ زين الدين أبو البقاء خالد بن يوسف بن سعد النابلسي(@)(@@)(@@)(@@) $ 2215 والحافظ أبو بكرمحمد بن يوسف بن موسى بن مسدي الأزدي الغرناطي الأندلسي PageV01P211(@)(@@)(@@)(@@) $ 2216 والمحدث جمال الدين أبو العباس أحمد بن عبدالله بن شعيب التميمي الدمشقي الذهبي الكتبي(@)(@@)(@@)(@@) $ 2217 والمسند رضي الدين إبراهيم بن البرهان عمر بن مضر بن محمد بن فارس الواسطي التاجر(@)(@@)(@@)(@@) $ 2218 والعلامة المجتهد شهاب الدين عبد الرحمن بن إسماعيل بن إبراهيم المقدسي ثم الدمشقي أبو شامة(@)(@@)(@@)(@@) $ 2219 ومقرىء الوقت الشريف الداعي محمد بن عمر بن أبي القاسم الواسطي(@)(@@)(@@)(@@) $ 2220 والمحدث مجدالدين أحمد بن عبدالله المسلم بن ميسرة الأزدي ابن الحلوانية(@)(@@)(@@)(@@) $ 2221 والمحدث المتقن أبو إسحاق إبراهيم بن عيسى بن يوسف الأندلسي المرادي(@)(@@)(@@)(@@) $ 2222 والمسند أبو الطاهر إسماعيل بن عبدالقوي بن عزون(@)(@@)(@@)(@@) $ 2223 والمحدث زين الدين أبو الفتح محمد بن محمد بن أبي بكر الأبيوردي الصوفي بمصر(@)(@@)(@@)(@@) $ 2224 ومسند العصر المحدث زين الدين أحمد بن عبدالدايم بن نعمة المقدسي PageV01P212(@)(@@)(@@)(@@) $ 2225 والمعمر بدر الدين أبو حفص عمر بن محمد بن أبي سعد الكرماني نزيل دمشق(@)(@@)(@@)(@@) $ 2226 والمسند معين الدين أبو العباس أحمد بن علي بن يوسف الدمشقي ثم المصري(@)(@@)(@@)(@@) $ 2227 والمحدث كمال الدين أحمد بن أبي الفضائل بن أبي المجد الدخميسي نزيل الهند(@)(@@)(@@)(@@) $ 2228 والمحدث شمس الدين محمد بن عبدالمنعم بن عمار بن هامل(@)(@@)(@@)(@@) $ 2229 والحافظ شرف الدين أبوالمظفر يوسف بن الحسن بن بدران النابلسي(@)(@@)(@@)(@@) $ 2230 والمسند الشهير تقي الدين أبو محمد إسماعيل بن إبراهيم بن أبي البسر التنوخي الدمشقي(@)(@@)(@@)(@@) $ 2231 والمسند 
ms67	 أبو عيسى عبدالله بن عبدالواحد بن محمد بن علاق الأنصاري المصري(@)(@@)(@@)(@@) $ 2232 والمسند كمال الدين أبو نصر عبدالعزيز بن عبد المنعم بن عبد السيد PageV01P213(@)(@@)(@@)(@@) $ 2233 ومسند الديار المصرية نجيب الدين أبو الفرج عبد اللطيف بن عبدالمنعم بن علي بن الصيقل لاحراني(@)(@@)(@@)(@@) $ 2234 والمحدث نجم الدين علي بن عبدالكافي بن عبدالملك الربعي الدمشقي(@)(@@)(@@)(@@) $ 2235 والعلامة جمال الدين أبوعبدالله محمد بن عبدالله بن عبدالله بن مالكل شيخ العربية(@)(@@)(@@)(@@) $ 2236 والمسند سيف الدين يحيى بن الناصح عبدالرحمن بن نجم الحنبلي PageV01P214(@)(@@)(@@)(@@) | ( 26 ) طبقة متصلة بما قبلها وإلى عام سبعمائة(@)(@@)(@@)(@@) $ 2237 محدث الإسكندرية وجيه الدين أبوالمظفر منصور بن سليم بن منصور ابن فتوح الهمداني الإسكندراني(@)(@@)(@@)(@@) $ 2238 والمسند أبو الفتح عثمان بن هبة الله بن عبدالرحمن بن عوف الزهري الإسكندراني(@)(@@)(@@)(@@) $ 2239 والمحدث مكين الدين أبو الحسن عبدالعظيم بن أبي الحسن ابن الحصني المصري(@)(@@)(@@)(@@) $ 2240 وشيخ القراء كمال الدين أبو إسحاق إبراهيم بن أحمد بن فارس التميمي الإسكندراني(@)(@@)(@@)(@@) $ 2241 وشيخ العراق أبو أحمد عبدالصمد بن أحمد بن عبدالقادر بن أبي الجيش الحنبلي المقرىء(@)(@@)(@@)(@@) $ 2242 وقاضي مصر العلامة الشيخ شمس الدين محمد بن العماد بن إبراهيم ابن عبدالواحد المقدسي الحنبلي(@)(@@)(@@)(@@) $ 2243 وشيخ الإسلام محيي الدين أبو زكريا يحيى بن شرف بن مري النووي الشافعي كهلا PageV01P215(@)(@@)(@@)(@@) $ 2244 والمحدث شهاب الدين أحمد بن محمد بن عيسى الدمشقي ابن الجرزي(@)(@@)(@@)(@@) $ 2245 والمحدث ناصر الدين أبوعبدالله محمد بن عربشاه بن أبي بكر الهمذاني ثم الدمشقي(@)(@@)(@@)(@@) $ 2246 والمسند أبو العباس أحمد بن أبي الخير سلامة بن إبراهيم بن الحداد الدمشقي(@)(@@)(@@)(@@) $ 2247 والمفتي المسند جمال الدين يحيى بن أبي منصور بن الصيرفي الحراني الحنبلي(@)(@@)(@@)(@@) $ 2248 والعلامة الزاهد موفق الدين أحمد بن يوسف بن حسن الكواشي الموصلي المفسر(@)(@@)(@@)(@@) $ 2249 وراوي صحيح مسلم أمين الدين القاسم بن أبي بكر بن القاسم الإربلي بدمشق(@)(@@)(@@)(@@) $ 2250 والعلامة قاضي القضاة تقي الدين محمد بن الحسين بن رزين العامري الحموي بمصر PageV01P216(@)(@@)(@@)(@@) $ 2251 والحافظ المفيد جمال الدين أبو حامد محمد بن علي بن محمود المحمودي بن الصابوني شيخ دار الحديث النورية 
ms68	(@)(@@)(@@)(@@) $ 2252 وشهاب الدين أبو سعد محمد بن يعقوب بن أبي الفرج بن أبي الدنية(@)(@@)(@@)(@@) $ 2253 والمسند شمس الدين أبو الغنايم المسلم بن محمد بن مسلم بن علان القيسي الدمشقي(@)(@@)(@@)(@@) $ 2254 وقاضي القضاة شمس الدين أبو العباس أحمد بن محمد بن إبراهيم ابن خلكان البرمكي الإربلي بدمشق(@)(@@)(@@)(@@) $ 2255 وبرهان الدين أبو إسحاق إبراهيم بن إسماعيل بن إبراهيم ابن الدرجي القرشي الدمشقي(@)(@@)(@@)(@@) $ 2256 وشيخ القراء فخر الدين اسماعيل بن هبة الله بن علي المليحي المصري(@)(@@)(@@)(@@) $ 2257 والعلامة شيخ القراء زين الدين أبو محمد عبدالسلام بن علي بن عمر الزواوي المالكي(@)(@@)(@@)(@@) $ 2258 والشيخ نجيب الدين أبو المرهف المقداد بن هبة الله بن علي القيسي بدمشق(@)(@@)(@@)(@@) $ 2259 والمحدث جمال الدين أبو محمد عبدالله بن يحيى بن أبي بكر الجزائري بدمشق PageV01P217(@)(@@)(@@)(@@) $ 2260 وشيخ الإسلام شمس الدين أبو محمد عبدالرحمن بن أبي عمر محمد بن أحمد بن محمد بن قدامة المقدسي الحنبلي(@)(@@)(@@)(@@) $ 2261 والحافظ شمس الدين محمد بن محمد بن عباس بن جعوان الأنصاري الدمشقي(@)(@@)(@@)(@@) $ 2262 ورشيد الدين محمد بن أبي بكر محمد بن محمد بن سليمان العامري الدمشقي البزار(@)(@@)(@@)(@@) $ 2263 وأبو إسحاق يوسف بن جامع القفصي الضرير(@)(@@)(@@)(@@) $ 2264 والعلامة القاضي ناصر الدين أحمد بن محمد بن مصعد الجذامي الإسكندراني ابن المنير(@)(@@)(@@)(@@) $ 2265 والمحدث شرف الدين أبو عبدالله محمد بن إبراهيم بن أبي القاسم الميدومي المصري النحوي(@)(@@)(@@)(@@) $ 2266 والمحدث علاء الدين أبو القاسم علي بن بلبان الناصري المشرف(@)(@@)(@@)(@@) $ 2267 والعلامة رضي الدين أبو عبدالله محمد بن علي بن يوسف الأنصاري الشاطبي صاحب اللغة بمصر PageV01P218(@)(@@)(@@)(@@) $ 2268 والمسند بدر الدين أبو العباس أحمد بن شيبان بن ثعلب الصالحي الخياط(@)(@@)(@@)(@@) $ 2269 والعلامة المحدث جمال الدين أبو بكر محمد بن أحمد بن محمد البكري الشريشي(@)(@@)(@@)(@@) $ 2270 والمحدث مجد الدين يوسف بن محمد بن عبدالله المصري الكاتب ابن المهتار(@)(@@)(@@)(@@) $ 2271 والمحدث أمين الدين أبو اليمن عبدالصمد بن عبدالوهاب بن زين الأمناء أبي البركات ابن عساكر الدمشقي(@)(@@)(@@)(@@) $ 2272 ومسند الوقت عزالدين أبو العز عبدالعزيز بن عبدالمنعم بن علي ابن الصقيل الحراني(@)(@@)(@@)(@@) $ 2273 
ms69	 والمحدث قطب الدين أبو بكر محمد بن أحمد بن علي التوزري القسطلاني شيخ الكاملية(@)(@@)(@@)(@@) $ 2274 والمحدث أبو إسحاق إبراهيم بن عبدالعزيز بن مكي اللوزي الرعيني المالكي شيخ السعدية(@)(@@)(@@)(@@) $ 2275 والمسند شهاب الدين أبو الفضل عبدالرحيم ابن خطيب المزة يوسف بن يحيى الدمشقي بمصر(@)(@@)(@@)(@@) $$ 2276 والمسندة المعمرة أم أحمد زينب بنت مكي بن علي الحرانية ثم الصالحية PageV01P219(@)(@@)(@@)(@@) $ 2277 والمحدث شمس الدين محمد بن الجمال عبدالرحيم بن عبدالواحد المقدسي الحنبلي(@)(@@)(@@)(@@) $ 2278 والمسند شمس الدين عبدالرحمن بن الزين أحمد بن عبدالملك المقدسي(@)(@@)(@@)(@@) $ 2279 والإمام شيخ الشافعية تاج الدين عبدالرحمن بن إبراهيم بن سباع الفزاري(@)(@@)(@@)(@@) $ 2280 ومسند الدنيا فخر الدين أبو الحسن علي بن أحمد بن عبد الواحد المقدسي الحنبلي(@)(@@)(@@)(@@) $ 2281 ومسند مصر أبو مجاهد غازي بن أبي الفضل الدمشقي الحلاوي(@)(@@)(@@)(@@) $ 2282 والمسند شمس الدين محمد بن يونس بن أبي الفتح الصوري الصالحي(@)(@@)(@@)(@@) $ 2283 والمسند نجم الدين أبو الفتح يوسف بن يعقوب بن المجاور الشيباني الكاتب(@)(@@)(@@)(@@) $ 2284 ومسند حلب الكمال أحمد بن محمد بن عبدالقاهر(@)(@@)(@@)(@@) $ 2285 والمسند الإمام تقي الدين أبو إسحاق إبراهيم بن علي بن أحمد بن الفضل بن الواسطي الحنبلي الصالحي PageV01P220(@)(@@)(@@)(@@) $ 2286 وشيخ القراء بالثغر مكين الدين أبو محمد عبدالله بن منصور بن علي اللخمي الأسمر(@)(@@)(@@)(@@) $ 2287 والحافظ تقي الدين أبو القاسم عبيد بن محمد بن عباس الإسعردي ثم المصري(@)(@@)(@@)(@@) $ 2288 وراوي جامع الترمذي أبو عبدالله بن ترجم المازني المصري(@)(@@)(@@)(@@) $ 2289 وشيخ القراء بالمغرب القاضي أبو العباس أحمد بن محمد بن حسن ابن الغماز الأندلسي بتونس(@)(@@)(@@)(@@) $ 2290 ومحدث حماة التقي إدريس بن محمد بن المفرج بن مرير(@)(@@)(@@)(@@) $ 2291 والعلامة قاضي القضاة شهاب الدين محمد بن أحمد بن الخليل بن سعادة بن الخويي الدمشقي(@)(@@)(@@)(@@) $ 2292 والعلامة خطيب دمشق شرف الدين أبو العباس أحمد بن أحمد بن نعمة ابن المقدسي الدمشقي الشافعي(@)(@@)(@@)(@@) $ 2293 والشيخ القدوة عز الدين أبو العباس أحمد بن إبراهيم بن عمر الفاروثي الواسطي الواعظ المقرىء(@)(@@)(@@)(@@) $ 2294 وشيخ الحرم المحدث الفقيه محب الدين أبو العباس أحمد بن عبدالله بن محمد بن أبي 
ms70	 بكر الطبري صاحب الأحكام PageV01P221(@)(@@)(@@)(@@) $ 2295 وشيخ الحنابلة بمصر نجم الدين أبو عبدالله أحمد بن حمدان الحراني خاتمة أصحاب عبدالقادر الرهاوي(@)(@@)(@@)(@@) $ 2296 والحافظ عز الدين أحمد بن محمد بن عبدالرحمن الحسيني المصري نقيب الأشراف(@)(@@)(@@)(@@) $ 2297 والمسند تاج الدين محمد بن عبدالسلام بن المطهر بن أبي عصرون الحلبي مدرس الشامية الجوانية بدمشق(@)(@@)(@@)(@@) $ 2298 وشيخ العربية بدمشق بهاء الدين محمد بن إبراهيم بن أبي عبدالله بن النحاس الحلبي(@)(@@)(@@)(@@) $ 2299 وشيخ الحنفية بدمشق محيي الدين محمد بن يعقوب بن إبراهيم الأسدي الحلبي ابن النحاس(@)(@@)(@@)(@@) $ 2300 وشيخ الحنابلة بدمشق زين الدين المنجا بن عثمان بن أسعد بن المنجا التنوخي(@)(@@)(@@)(@@) $ 2301 والحافظ الزاهد جمال الدين أبو العباس أحمد بن محمد بن الظاهري ابن الحلبي نزيل مصر(@)(@@)(@@)(@@) $ 2302 والمسند القاضي تاج الدين أبو محمد عبدالخالق بن عبدالسلام بن سعد بن علوان البعلبكي(@)(@@)(@@)(@@) $ 2303 والمحدث ضياءالدين عيسى بن يحيى بن أحمد الأنصاري السيبي بالقاهرة PageV01P222(@)(@@)(@@)(@@) $ 2304 ومسند العراق كمال الدين أبو الفرج عبد الرحمن بن عبداللطيف البغدادي المكثر البزار الفويره شيخ المستنصرية(@)(@@)(@@)(@@) $ 2305 ومسند الأرض المقدسة عماد الدين عبدالحافظ بن بدران بن شبل النابلسي(@)(@@)(@@)(@@) $ 2306 ومسند دمشق ناصر الدين أبو حفص عمر بن عبدالمنعم بن عمر ابن القواس الطائي(@)(@@)(@@)(@@) $ 2307 والمفسر الزاهد جمال الدين أبو عبدالله محمد بن سليمان بن الحسن ابن النقيب المقدسي(@)(@@)(@@)(@@) $ 2308 والحافظ شهاب الدين أحمد بن فرح بن أحمد اللخمي الإشبيلي نزيل دمشق(@)(@@)(@@)(@@) $ 2309 والمسند شرف الدين أبوالفضل أحمد بن هبة الله بن تاج الأمناء ابن عساكر الدمشقي(@)(@@)(@@)(@@) $ 2310 والمحدث شرف الدين أبو محمدالحسن بن علي بن عيسى اللخمي المصري ابن الصيرفي(@)(@@)(@@)(@@) $$ 2311 ومسندة بعلبك أم محمد زينب بنت عمر بن كندي الدمشقية(@)(@@)(@@)(@@) $ 2312 والمحدث الأمير علم الدين سنجر بن عبدالله الدواداري التركي PageV01P223(@)(@@)(@@)(@@) $ 2313 والمسند الأديب كمال الدين أبوحفص عمر بن إبراهيم بن حسين الأنصاري العقيمي الرسعني بدمشق(@)(@@)(@@)(@@) $ 2314 والمسند شمس الدين محمد بن علي بن أحمد بن فضل الصالحي الواسطي(@)(@@)(@@)(@@) $ 2315 وشيخ تونس القدوة أبو محمد عبدالله بن محمد المرجاني المذكر(@)(@@)(@@)(@@) $ 2316 والمسند عز 
ms71	 الدين أحمد بن العماد عبدالحميد بن عبدالهادي المقدسي(@)(@@)(@@)(@@) $ 2317 والمسند الصالح عز الدين أبو الفداء إسماعيل بن عبدالرحمن بن عمرو المرداوي ثم الصالحي ابن الفراء وأخته صفية(@)(@@)(@@)(@@) $ 2318 والحافظ الفارضي شمس الدين أبوالعلاء محمود بن أبي بكرالبخاري بماردين(@)(@@)(@@)(@@) $ 2319 والمسند المعمر يوسف بن أحمد بن أبي بكر الغسولي الصالحي الحجار توفي بسنة سبعمائة PageV01P224(@)(@@)(@@)(@@) | ( 27 ) طبقة تالية وإلى بضعة وعشرين وسبعمائة(@)(@@)(@@)(@@) $ 2320 المسند العدل علاء الدين علي بن عبدالغني بن الخطيب فخر الدين ابن تيمية الحراني بمصر(@)(@@)(@@)(@@) $ 2321 والمسند تقي الدين أحمد بن عبدالرحمن بن مؤمن الصالحي الحنبلي(@)(@@)(@@)(@@) $ 2322 وخطيب بعلبك ومسندها ضياء الدين عبدالرحمن بن عبدالوهاب ابن علي بن أحمد السلمي الشافعي(@)(@@)(@@)(@@) $ 2323 والمسند الحافظ أبو الحسين علي بن الشيخ الفقيه محمد بن أحمد ابن عبدالله اليونيني ببعلبك شهيدا(@)(@@)(@@)(@@) $ 2324 ومسند العصر شهاب الدين أبو المعالي أحمد بن اسحاق بن محمد ابن المؤيد الأبرقوهي بمكة بعد قضاء نسكه(@)(@@)(@@)(@@) $ 2325 والحافظ الإمام تقي الدين أبوالفتح محمد بن علي بن وهب بن دقيق العيد القشيري الصعيدي المالكي والشافعي(@)(@@)(@@)(@@) $ 2326 والمحدث نجم الدين موسى بن إبراهيم بن يحيى الشقراوي الحنبلي PageV01P225(@)(@@)(@@)(@@) $ 2327 والإمام القدوة أبو إسحاق إبراهيم بن أحمد بن محمد الرقي شيخ دمشق(@)(@@)(@@)(@@) $$ 2328 والمسندة أم أحمد ست الأهل بنت علوان بن سعيد البعلبكية بالغوطة(@)(@@)(@@)(@@) $ 2329 والمحدث نجم الدين اسماعيل بن إبراهيم بن سالم الأنصاري الصالحي المؤدب ابن الخباز(@)(@@)(@@)(@@) $ 2330 وشيخ دار الحديث الأشرفية زين الدين أبو محمد عبدالله بن مروان الفارقي الشافعي(@)(@@)(@@)(@@) $ 2331 والمحدث المفيد أبو الحسن أحمد بن أبي الغنائم الطاووسي الصوفي بالسميساطية(@)(@@)(@@)(@@) $ 2332 والمسند أبو عبدالله محمد بن يوسف بن يعقوب الإربلي ثم الدمشقي الذهبي(@)(@@)(@@)(@@) $ 2333 والمحدث مسند الثغر تاج الدين علي بن أحمد بن عبدالمحسن الحسيني الغراقي الفقيه(@)(@@)(@@)(@@) $ 2334 والمسند المعمر شيخ القراء شرف الدين أبو الحسين يحيى بن أحمد ابن عبدالعزيز الجذامي الإسكندراني ابن الصواف المعدل PageV01P226(@)(@@)(@@)(@@) $ 2335 وخطيب دمشق ومحدثها شرف الدين أحمد بن إبراهيم بن سباع الفزاري النحوي(@)(@@)(@@)(@@) $ 2336 والحافظ الكبير شرف الدين عبدالمؤمن بن خلف بن 
ms72	 أبي الحسن الدمياطي المصري الشافعي(@)(@@)(@@)(@@) $ 2337 ومسند الشام علاء الدين سنقر بن عبدالله الأرمني القضائي الزيني بحلب(@)(@@)(@@)(@@) $ 2338 ومسند العراق رشيد الدين أبو عبدالله محمد بن أبي القاسم عبدالله ابن عمر بن أبي القاسم البغدادي الحنبلي شيخ المستنصرية(@)(@@)(@@)(@@) $ 2339 ومسند دمشق شهاب الدين أبو عبدالله محمد بن أبي العز بن مشرف الأنصاري البزاز بدمشق(@)(@@)(@@)(@@) $$ 2340 والمسندة أم عبدالله فاطمة بنت سليمان بن عبدالكريم الأنصارية الدمشقية خاتمة من سمع من المسلم المازني(@)(@@)(@@)(@@) $ 2341 والحافظ المفيد شمس الدين محمد بن عبدالرحمن بن سامة السوادي الصالحي نزيل القاهرة كهلا PageV01P227(@)(@@)(@@)(@@) $ 2342 والمسند الرحلة أبو جعفر محمد بن علي بن الحسيني السلمي الموازيني الدمشقي(@)(@@)(@@)(@@) $ 2343 وشيخ المستنصرية عماد الدين إسماعيل بن علي بن أحمد البغدادي ابن الطبال الأزجي(@)(@@)(@@)(@@) $ 2344 والحافظ العلامة أبو جعفر أحمد بن إبراهيم بن الزبير الثقفي الغرناطي المغربي وله ثمانون سنة(@)(@@)(@@)(@@) $ 2345 والمحدث الإمام شمس الدين أبو عبدالله محمد بن أبي الفتح بن أبي الفضل البعلبكي الحلبي توفي غريبا بالقاهرة(@)(@@)(@@)(@@) $ 2346 والمسند أبوالفضل إسحاق ابن أبي بكر بن إبراهيم بن هبة الله الأسدي الحلبي ابن النحاس بدمشق(@)(@@)(@@)(@@) $ 2347 ومسند الديار المصرية بهاء الدين علي بن عيسى بن سليمان بن رمضان الثعلبي المصري ابن القيم(@)(@@)(@@)(@@) $ 2348 والمسند فخر الدين إسماعيل بن نصر الله بن أحمد ابن عساكر(@)(@@)(@@)(@@) $$ 2349 والصالحة المسندة فاطمة بنت إبراهيم بن محمود بن جوهر البعلية بسفح قاسيون PageV01P228(@)(@@)(@@)(@@) $ 2350 والمسند المكثر عماد الدين أبو المعالي محمد بن علي بن محمد النابلسي المعدل(@)(@@)(@@)(@@) $ 2351 والمسند الرئيس جمال الدين محمد بن المكرم ابن أبي الحسن الأنصاري المصري(@)(@@)(@@)(@@) $ 2352 والحافظ قاضي القضاة سعد الدين مسعود بن أحمد بن مسعود الحارثي المصري الحنبلي(@)(@@)(@@)(@@) $ 2353 وقارىء الحديث المسند أبو الحسن علي بن محمد بن هارون التغلبي ثم الدمشقي القارىء(@)(@@)(@@)(@@) $ 2354 والمسند أبو الحسن علي بن نصر الله بن عمر القرشي المصري ابن الصواف(@)(@@)(@@)(@@) $ 2355 والمسند المعمر زين الدين أبو محمد الحسن بن عبدالكريم بن عبدالسلام الغماري المصري سبط زيادة المقرىء(@)(@@)(@@)(@@) $ 2356 والمحدث الإمام فخر الدين أبو 
ms73	 عمرو عثمان بن محمد بن عثمان التوزري ثم المصري المالكي المقرىء المجاوز(@)(@@)(@@)(@@) $ 2357 والمسند شهاب الدين أبو بكر أحمد بن محمد بن أبي القاسم بن بدران الدشتي المؤدب بدمشق PageV01P229(@)(@@)(@@)(@@) $ 2358 وشيخ القراء تقي الدين أبو بكر بن عمر بن المشيع الجزري المقصاتي إمام جامع دمشق نيابة(@)(@@)(@@)(@@) $ 2359 والمسند شرف الدين محمد بن الخطيب بن داود بن عمر الآباري(@)(@@)(@@)(@@) $ 2360 ومسند حلب المعمر علاء الدين بيبرس بن عبدالله التركي العديمي(@)(@@)(@@)(@@) $ 2361 ومقرئ مصر نور الدين علي بن يوسف بن جرير الشطنوفي(@)(@@)(@@)(@@) $ 2362 والمسند المفتي رشيد الدين أبو الفداء إسماعيل بن عثمان بن محمد القرشي الدمشقي ابن المعلم الحنفي نزيل القاهرة(@)(@@)(@@)(@@) $$ 2363 والشيخة البغدادية الصالحة العالمة فاطمة بنت عياش بن أبي الفتح الحنبلية بمصر(@)(@@)(@@)(@@) $ 2364 وقاضي القضاة مسند الشام تقي الدين سليمان بن حمزة بن أحمد المقدسي الحنبلي(@)(@@)(@@)(@@) $ 2365 موسى بن علي بن أبي طالب الحسيني الموسوي الشاهد(@)(@@)(@@)(@@) $ 2366 والمحدث الأديب علاء الدين علي بن مظفر بن إبراهيم الكندي الدمشقي الكاتب شيخ النفيسية(@)(@@)(@@)(@@) $$ 2367 والمسندة المعمرة أم عبدالله بنت ست الوزراء بنت عمر بن أسعد بن المنجا التنوخية الدمشقية PageV01P230(@)(@@)(@@)(@@) $ 2368 والمسند المعمر صدر الدين إسماعيل بن مكتوم بن أحمد القيسي الدمشقي(@)(@@)(@@)(@@) $ 2369 وشيخ المغرب العلامة أبو إسحاق إبراهيم بن أحمد بن عيسى الغافقي الإشبيلي نزيل سبتة(@)(@@)(@@)(@@) $ 2370 والمحدث الفقيه أبو الحسن علي بن محمد الجبني التركي نزيل دمشق(@)(@@)(@@)(@@) $ 2371 وقاضي القضاة جمال الدين أبو عبدالله محمد بن سليمان بن سومر الزواوي المالكي(@)(@@)(@@)(@@) $ 2372 والمحدث فخر الدين عثمان بن بلبان بن عبدالله المقاتلي نزيل القاهرة كهلا(@)(@@)(@@)(@@) $ 2373 والمعمر قطب الدين بن عبدالعزيز بن الحسين بن رشيق الربعي المصري المالكي عن سبع وتسعين سنة(@)(@@)(@@)(@@) $ 2374 والمسند علم الدين أحمد بن عبدالرحمن بن عبدالكريم بن درادة القرشي المعدي(@)(@@)(@@)(@@) $ 2375 ومسند دمشق الحاج الصالح أبو بكر بن أحمد بن عبدالدايم بن نعمة المقدسي الحنبلي(@)(@@)(@@)(@@) $ 2376 وشيخ دار الحديث النبوي كمال الدين أحمد بن محمد بن أحمد الشريشي الشافعي PageV01P231(@)(@@)(@@)(@@) $ 2377 وشيخ القراء والنحاة مجدالدين أبو بكر بن 
ms74	 محمد بن قاسم التونسي نزيل دمشق(@)(@@)(@@)(@@) $ 2378 وقاضي المالكية العلامة فخر الدين أحمد بن سلامة بن أحمد الإسكندراني(@)(@@)(@@)(@@) $ 2379 وشيخ القراء شهاب الدين حسين بن سليمان بن فزارة الكفري الحنفي مدرس الطرخانية(@)(@@)(@@)(@@) $ 2380 والقدوة الزاهد المقرئ أبو الفتح نصر بن سلمان بن عمر المنبجي شيخ القاهرة(@)(@@)(@@)(@@) $ 2381 ومسند وقته الشرف عيسى بن عبدالرحمن بن معالي الصالحي المطعم السمسار في العقار(@)(@@)(@@)(@@) $ 2382 والقاضي الكبير زين الدين أبو القاسم محمد بن محمد بن حسين بن عتيق بن رشيق المصري المالكي(@)(@@)(@@)(@@) $ 2383 ومسند مصر أبو علي الحسن بن عمر بن عيسى الكردي الدمشقي(@)(@@)(@@)(@@) $ 2384 والمسند كمال الدين عبدالرحيم بن عبدالمحسن بن ضرغام المنشي المصري الحنبلي PageV01P232(@)(@@)(@@)(@@) $ 2385 والمسند شرف الدين أبو الفتح محمد بن عبدالرحيم بن عباس القرشي الدمشقي ابن النشو الحريري(@)(@@)(@@)(@@) $ 2386 والمسند المعمر أمين الدين محمد بن أبي بكر بن إبراهيم بن هبة الله الأسدي الحلبي ثم الدمشقي النحاس(@)(@@)(@@)(@@) $ 2387 والمسند عماد الدين محمد بن يعقوب بن بدران بن الجرائدي الدمشقي ثم المصري نزيل بيت المقدس(@)(@@)(@@)(@@) $ 2388 وشيخ القراء بالحرم عفيف الدين أبو محمد عبدالله بن عبدالحق المخزومي الدلامي(@)(@@)(@@)(@@) $ 2389 ومسند وقته سعد الدين يحيى بن محمد بن سعد المقدسي الصالحي(@)(@@)(@@)(@@) $ 2390 وشيخ الحرم إمام المقام رضي الدين إبراهيم بن محمد بن إبراهيم بن أبي بكر الطبري المكي الشافعي(@)(@@)(@@)(@@) $ 2391 والمحدث تقي الدين أبو بكر عتيق بن عبدالرحمن بن أبي الفتح العمري المصري المالكي الصوفي عن نيف وسبعين سنة(@)(@@)(@@)(@@) $ 2392 ومسند الإسكندرية محيي الدين عبدالرحمن بن مخلوف بن عبدالرحمن بن جماعة بن رجاء الربعي المالكي PageV01P233(@)(@@)(@@)(@@) $$ 2393 ومسندة بيت المقدس أم محمد زينب بنت أحمد بن عمر بن شكر المقدسية الصالحية(@)(@@)(@@)(@@) $ 2394 ومسند الصعيد زين الدين عبدالرحمن بن أبي صالح رواحة بن علي بن الحسين بن المظفر بن الأنصاري الحموي مات بأسيوط عن أربع وتسعين سنة(@)(@@)(@@)(@@) $ 2395 ومحدث العراق ومؤرخ الآفاق جمال الدين أبي الفضل عبدالرزاق أحمد بن محمد الشيباني الفوطي(@)(@@)(@@)(@@) $ 2396 وقاضي القضاة نجم الدين أحمد بن محمد بن سالم بن الحسن 
ms75	 ابن صصري التغلبي الدمشقي الشافعي رئيس دمشق(@)(@@)(@@)(@@) $ 2397 والمحدث اللغوي صفي الدين محمود بن أبي بكر محمد بن أبي حامد الأرموي الصوفي(@)(@@)(@@)(@@) $ 2398 ومسند الشام شمس الدين أبو نصر محمد بن محمد بن هبة الله بن مميل ابن الشيرازي المزي(@)(@@)(@@)(@@) $ 2399 والمعمر ركن الدين عمر بن محمد بن يحيى بن عثمان القرشي العتبي الإسكندراني ابن جابي الأحباس(@)(@@)(@@)(@@) $ 2400 والمحدث القدوة نور الدين علي بن بكتمر بن عمر السهروردي الحنبلي بمصر PageV01P234(@)(@@)(@@)(@@) $ 2401 والمحدث المفتي علاء الدين علي بن إبراهيم الدمشقي الشافعي ابن العطار(@)(@@)(@@)(@@) $ 2402 والمحدث علاء الدين علي بن النصير محمد بن غالب الأنصاري الدمشقي كاتب الحكم(@)(@@)(@@)(@@) $ 2403 والفقيه شهاب الدين أحمد بن العفيف محمد بن عمر الدمشقي الحنفي خاتمة أصحاب ابن الصلاح(@)(@@)(@@)(@@) $ 2404 وشيخ المقرئين محمد بن أحمد بن عبدالخالق المصري الشافعي الصائغ خاتمة أصحاب الكمال الضرير(@)(@@)(@@)(@@) $ 2405 والمحدث نور الدين علي بن جابر بن علي الهاشمي اليمني نزيل القاهرة وشيخ المنصورية(@)(@@)(@@)(@@) $ 2406 والمسند عفيف الدين إسحاق بن يحيى بن إسحاق الآمدي ثم الدمشقي شيخ السعدية(@)(@@)(@@)(@@) $ 2407 والمسندة المعمرة ست الفقهاء ابنة الشيخ تقي الدين إبراهيم بن علي الواسطي ثم الصالحي الحنبلي وتدعى أمة الرحمن(@)(@@)(@@)(@@) $ 2408 والمسند الخليل قطب الدين موسى بن أبي عبدالله اليونيني صاحب التاريخ PageV01P235(@)(@@)(@@)(@@) $ 2409 والمسند الرحلة شمس الدين محمد بن أحمد بن الهيجا الصالحي ابن الزراد(@)(@@)(@@)(@@) $ 2410 والمحدث قاضي القضاة شمس الدين أبو عبدالله محمد بن مسلم ابن مالك الصالحي الحنبلي العبد الصالح(@)(@@)(@@)(@@) $ 2411 والمسند المعمر شمس الدين محمد بن عمر بن محمد بن العماد الكاتب القرشي الدمشقي(@)(@@)(@@)(@@) $ 2412 والمسند المعمر أبو يوسف محمد بن أحمد بن منعة بن مطرف القنوي ثم الصالحي عن اثنين وتسعين عاما(@)(@@)(@@)(@@) $ 2413 ومسند مصر نور الدين علي بن عمر بن أبي بكر العواني الصوفي(@)(@@)(@@)(@@) $ 2414 ومقرئ الموصل الشيخ أبو عبدالله محمد بن علي بن أبي القاسم الحنبلي الوراق ويعرف بابن خروف(@)(@@)(@@)(@@) $ 2415 والمحدث الإمام القدوة شرف الدين عبدالله بن عبدالحليم بن عبدالسلام بن تيمية الحراني الحنبلي(@)(@@)(@@)(@@) $ 2416 وقاضي القضاة صدر 
ms76	 الدين علي بن أبي القاسم بن محمد البصروي الحنفي شيخ الحنفية بدمشق PageV01P236(@)(@@)(@@)(@@) $ 2417 وقاضي القضاة شيخ الشافعية كمال الدين أبو المعالي محمد بن علي ابن عبدالواحد بن الزملكان الأنصاري(@)(@@)(@@)(@@) $ 2418 وشيخ الإسكندرية الإمام المعمر عز الدين أبو إسحاق إبراهيم بن أحمد بن عبدالمحسن بن أحمد الحسيني الغرافي(@)(@@)(@@)(@@) $ 2419 وشيخ العراق مسند العصر عفيف الدين أبو عبدالله محمد بن عبدالمحسن بن أبي الحسن بن عبدالغفار الأزجي الحنبلي الواعظ عرف بابن الخراط(@)(@@)(@@)(@@) $ 2420 وقاضي القضاة شمس الدين محمد بن عثمان بن أبي الحسن الأنصاري الدمشقي الحنفي ابن الحريري شيخ الحنفية بمصر(@)(@@)(@@)(@@) $ 2421 والحافظ العلامة القدوة شيخ الإسلام تقي الدين أحمد بن عبدالحليم بن عبدالسلام بن عبدالله بن تيمية الحراني(@)(@@)(@@)(@@) $ 2422 والإمام القدوة شيخ الإسلام برهان الدين أبو إسحاق إبراهيم بن عبدالرحمن بن إبراهيم بن سباع بن ضياء الفزاري الدمشقي الشافعي PageV01P237(@)(@@)(@@)(@@) $ 2423 ومسند مصر المعمر يونس بن إبراهيم العسقلاني الدبابيسي(@)(@@)(@@)(@@) $ 2424 ومسند الآفاق أبو العباس أحمد بن أبي طالب الحجار ابن الشحنة(@)(@@)(@@)(@@) | (@)(@@) وإلى هنا انتهى التعريف بأسماء كبار المحدثين والمسندين وبحمد الله في وقتنا طائفة كبيرة منهم بدمشق ومصر والمغرب والأندلس وعدم ذلك جملة من العراق وما والاها من المشرق ومن الجزيرة وبلاد العجم وأذربيجان واليمن والنواحي فلله الأمر(@)(@@) وعلى قلة من يبقى ففي مسنديهم عامية وعدم فقة وفي محدثيهم نقص فضيلة وقلة همة والله يوفقهم لصالح العمل ويحفظ إيمانهم من الشك والزلل وأخبار المذكورين في هذا الكتاب مدونة في تاريخي الكبير وفي غيره فمن رام علم ذلك فليطلبه(@)(@@) ولا قوة إلا بالله العلي العظيم آخر كتاب المعين في طبقات المحدثين لابن الذهبي PageV01P238 
