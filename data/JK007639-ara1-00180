ms161	 % دلائله ، كانت له الحجج اللد % 22(@)(@@) % إذا قال قولا يسبق القول فعله ، % فليس له يوما وعيد ، ولا وعد % 23(@)(@@) % لئن أخطأت أيدي الردى بمصابه ، % لعمر أبي ، هذا هو الخطأ العمد % 24(@)(@@) % مضى طاهر الأثواب والجسم والحشى ، % له الشكر درع ، والعفاف له برد % 25(@)(@@) % وأبقى لنا من طيب ولده ، % ينوب كما أبقى لنا ماءه الورد % 26(@)(@@) % هم القوم فاهوا بالفصاحة رفعا ، % وشابت نواحي مجدهم ، وهم مرد % 27(@)(@@) % إذا حل منهم واحد في قبيلة % يشار إليه إنه العلم الفرد % 28(@)(@@) % كفاهم فخارا أنه لهم أب ، % ويكفيه أن أمسى ومنهم له ولد % 29(@)(@@) % فيا نازحا يدنيه حسن ادكاره ، % ففي بعده قرب ، وفي قربه بعد % 30(@)(@@) % لك الله كم أدركت في المجد غاية % تقاعس عن إدراكها الأسد الورد % PageV01P592 31(@)(@@) % إذا افتخر الأقوام بمجدهم ، % فإنك من قوم بهم يفخر المجد % 32(@)(@@) % تعود متن الصافنات صغيرهم ، % إلى أن تساوى عنده السرج والمهد % 33(@)(@@) % حموا لجنود الجأش حول بيوتهم ، % من المجد ، ما لم يحمه الجيش والجند % 34(@)(@@) % بيوت كماة دونها تحطم القنا ، % وغابات أسد دونها تفرس الأسد % 35(@)(@@) % أقاموا وبرد العيش عندهم لظى ، % وصالوا وحر الكر عندهم برد % 36(@)(@@) % وعزوا إلى أن سالمتهم نجومها ، % فلا نجم إلا وهو في ربعهم سعد % 37(@)(@@) % ورثت علاهم واقتديت بفضلهم ، % فأنت إذا ند الكرام لهم ند % 38(@)(@@) % فإن شاق صدر الخود والنهد معشرا % يشوقك صدر الدست والفرس النهد % 39(@)(@@) % فبالرغم مني أن يغيبك الثرى ، % ويرجع مردودا بخيبته الوفد % 40(@)(@@) % ويعرض عن رد الجواب لسائل ، % وقد كنت لم يعرف لسائلك الرد % PageV01P593 41(@)(@@) % سأبكيك جهد المستطيع منظما % رثاك ، وهذا جهد من ماله جهد % 42(@)(@@) % فإن رمدت أجفان عيني بالبكا ، % فكم جليت منا بك الأعين الرمد % 43(@)(@@) % لئن كنت قد أصبحت عنا مغيبا ، % فقد ناب عنك الذكر والشكر والحمد % 44(@)(@@) % وما غاب من يقصو ومعناه حاضر ، % ولا زال من يخفى وآثاره تبدو % % PageV01P594 البحر : خفيف تام 1(@)(@@) % صال فينا الردى جهارا نهارا ، % فكأن المنون تطلب ثارا % % 2(@)(@@) % كلما قلت يستتم هلال ، % سلبتنا أيدي الرى أقمارا 
ms162	 % % 3(@)(@@) % يا لقومي ! ما إن وجدت من الخط % % ب محيدا ، ولا عليه انتصارا % % 4(@)(@@) % كل حين ألحى الخطوب على فق % % د حبيب ، وأعتب الأقدارا % % 5(@)(@@) % يا هلالا لما استتم ضياء ، % قد أغارت فيه المنون ، فغارا % % 6(@)(@@) % قمر أسرعت له الأرض كسفا ، % وكذا الأرض تكسف الأقمارا % % 7(@)(@@) % أذهل العقل رزؤه ، فترى النا % % س سكارى وما هم بسكارى % % 8(@)(@@) % ما رأينا من قبل رزئك بدرا % جعل المكث في التراب سرارا % % 9(@)(@@) % كنت أدري أن الزمان ، وإن أس % عف بالصفو يحدث الأكدارا % % 10(@)(@@) % غير أني غررت أن سوف تبقى ، % فلقد كنت كوكبا غرارا % % PageV01P595 11(@)(@@) % يا قضيبا ذوى ، وصوح لما % % أظهر الزهر غصنه والثمارا % % 12(@)(@@) % قد فقدنا من طيب خلقك أنسا % علم النوم عن جفوني النفارا % % 13(@)(@@) % خلقا يشبه النسيم ، ولطفا % سلب الماء حسنه ، والعقارا % % 14(@)(@@) % أيها النازح الذي ملأ القل % % ب بأحزانه ، وأخلى الديارا % % 15(@)(@@) % لست أختار بعد بعدك عيشا ، % غير أني لا أملك الإختيارا % % 16(@)(@@) % كلما شام برق مغناك قلبي ، % أرسلت سحب أدمعي أمطارا % % 17(@)(@@) % وإذا ما ذكرت ساعات أنسي % % بكك أذكى التذكار في القلب نارا % % 18(@)(@@) % فكأن التذكار حج بقلبي ، % فهو بالحزن فيه يرمي الجمارا % % 19(@)(@@) % فسأبكيك ما حييت بدمع ، % لا تقال الجفون منه عثارا % % 20(@)(@@) % ليس جهدي من بعد فقدك إلا % أرسل الدمع فيك والأشعارا % % PageV01P596 البحر : طويل 1(@)(@@) % سقى الله قبرا حل فيه ابن مقبل ، % توالي أمطار بها البرق ضاحك % 2(@)(@@) % فتى غبا عنا شخصه دون ذكره ، % فأصبح فينا حاضرا ، وهو هالك % 3(@)(@@) % غريب عن الأوطان قد حل حفرة % من الحزن يعلوه الصفا والدكادك % 4(@)(@@) % فيا رب قد وافاك ذا أمل ، فجد % عليه برضوان ، فإنك مالك % PageV01P597 البحر : كامل تام 1(@)(@@) % رحم الإله جوارحا ضم الثرى ، % في ماردين بأيمن الصمان % 2(@)(@@) % فلقد تمتعت النواظر برهة % من ربها بالحسن والإحسان % 3(@)(@@) % وعلمت أن ذنوبه مغفورة % من دفنه بمقابر الرضوان % PageV01P598 البحر : طويل 1(@)(@@) % وفى لي فيك الدمع إذ خانني الصبر ، % وأنجد فيك النظم إذ خذل النصر % 2(@)(@@) % وأضحت تقول الناس والدست والعلى : % كذا 
ms163	 فليجل الخطب وليفدح الأمر % 3(@)(@@) % توفيت الآمال بعد محمد ، % وأصبح في شغل عن السفر السفر % 4(@)(@@) % وزالت حصاة الحلم عن مستقرها ، % وأصبح كالخنساء في قلبه صخر % 5(@)(@@) % وساوى قلوب الناس في الحزن رزؤه % % كأن صدور الناس في حزنها صدر % 6(@)(@@) % فإن أظلمت أرض الشآم لحزنه ، % فلم يخل من ذاك الصعيد ولا مصر % 7(@)(@@) % قضى الناصر السلطان من بعد ما قضى % % فروض العلى طرا ، وسالمه الدهر % 8(@)(@@) % ولم يغن عنه الجأش والجيش واللهى % % وفرط النهى والحكم والنهي والأمر % 9(@)(@@) % ولا الخيل تجري بين آذانها القنا ، % لحرب العدى والدهم من دمهم حمر % 10(@)(@@) % لدى معرك خاضت به الخيل في الوغى % % من الدم فيما خاضت البيض والسمر % PageV01P599 11(@)(@@) % كأن لم يقدها في الهياج عوابسا ، % بكل كمي ضم في قلبه الصدر % 12(@)(@@) % ولم ترجع البيض الصفاح من العدى % % مخضبة ، والبر من دمهم بحر % 13(@)(@@) % ولم يترك الأبطال صرعى ، وغسلها % % دماها ، وأحشاء النسور لها قبر % 14(@)(@@) % ولا صنعت فيها ظباه مآدبا ، % فأصبح من أضيافه الذئب والنسر % 15(@)(@@) % ولا أخذت منه الملوك لسلمه % % زمام الرضى مما يقلقلها الذعر % 16(@)(@@) % ولا مهد الإسلام عند أضطرابه ، % فأصبح مشدودا به ذلك الأزر % 17(@)(@@) % ولا قلد الأعناق من فيض جوده ، % قلائد بر لا يقوم بها الشكر % 18(@)(@@) % ولا جبرت كفاه في كل بلدة % كبير كرام ما لكسرهم جبر % 19(@)(@@) % ألا في سبيل المجد مهجة ماجد % يشاركنا في حزنه المجد والفخر % 20(@)(@@) % كريم أفاد الدهر منه خلائقا ، % فأيامه منه محجلة غر % PageV01P600 21(@)(@@) % يروع جيوش الحادثات يراغه ، % ويفني الأعادي قبل أسيافه الذكر % 22(@)(@@) % إلى بابه تسعى الملوك ، فإن عدت % تعدى إليها القتل والنهب والأسر % 23(@)(@@) % لقد شهدت أهل الممالك أنه % مليك له من فوق قدرهم قدر % 24(@)(@@) % قوي إذا لانوا ، سريع إذا ونوا ، % صؤول إذا كروا ، ثبوت إذا فروا % % 25(@)(@@) % كأن أديم الرض قد من اسمه ، % فما وجدت إلا وفيها له ذكر % 26(@)(@@) % يجول ثناه في البلاد كأنه % % وشاح ، ومجموع القاع له خصر % 27(@)(@@) % وما كان يدري من تيمم جوده % ونكب لج 
ms164	 البحر أيهما البحر % 28(@)(@@) % مفاتح أرزاق العباد بكفه ، % فيمنى بها يمن ، ويسرى بها يسر % 29(@)(@@) % فتى كان مثل الدهر بطشا وبسطة ، % يرجى ويخشى عنده النفع والضر % 30(@)(@@) % فتى طبق الأرض البسيطة جوده ، % ففي كل قطر من نداه بها قطر % PageV01P601 31(@)(@@) % فتى لفظه مع رأيه ونواله ، % يجيء ارتجالا لا يغلغله الفكر % 32(@)(@@) % فتى يكره التقصير حتى تظنه ، % يكون حراما عنده الجمع والقصر % 33(@)(@@) % فتى ذخر الحسنى ، فأعقب فعله % عواقبه الحسنى ، فقد نفع الذخر % 34(@)(@@) % طواه الثرى من بعد ما شرف الثرى % % بوطأته ، والتخت والدست والقصر % 35(@)(@@) % لوم نر بدرا قبله غاب في الثرى ، % ولم نر طودا قبله ضمه القبر % 36(@)(@@) % وقد كان بطن الأرض يغبط ظهرها % % عليه ، فأمسى البطن يحسده الظهر % 37(@)(@@) % أحاط به الآسون يبغون طبه ، % وقد حارت الأفهام واشتغل السر % 38(@)(@@) % وراموا بأنواع العقاقير برأه ، % وهل يصلح العطار ما أفسد الدهر % 39(@)(@@) % وكيف يرد الطب أمرا مقدرا ، % إذا كان ذاك الأمر ممن له الأمر % 40(@)(@@) % ومما يسلي النفس حسن انتقاله ، % عفيف إزار لا يناط به وزر % PageV01P602 41(@)(@@) % وإن لنا من بحده من سليله % مليكا به عن فقده يحسن الصبر % 42(@)(@@) % فإن غاب ذاك البدر عن أفق ملكه % فقد أشرقت من نجله أنجم زهر % 43(@)(@@) % وسر العلى ما أسمع الناس عنهم ، % وقال الورى قد صدق الخبر الخبر % 44(@)(@@) % فإن فلت الأيام حد محمد ، % فقد جردت سيفا به يدرك الوتر % 45(@)(@@) % وإن أحدثت بالناصر الملك زلة ، % فبالملك المنصور قام لها العذر % 46(@)(@@) % فيا دوحة المجد الذي عندما ذوت % سمت ونمت في المجد أغصانها لك % 47(@)(@@) % لك اللهث كم قلدتنا طوق منة ، % فتلك كعد القطر ليس له حصر % 48(@)(@@) % لقد عز فينا بعد وجدانك الغنى ، % كما ذل فينا قبل فقدانك الفقر % 49(@)(@@) % ترتبت الأحزان فيك مراتبا % بقلبي ، ورقم الصبر من بينها صفر % 50(@)(@@) % ولما نظمت الشعر فيك قلائدا ، % تمنت نجوم الليل لو أنها شعر % PageV01P603 51(@)(@@) % سأبكيك بالأشعار ، حتى إذا وهت % سلوك عقود النظم أنجدني النثر % 52(@)(@@) % عليك سلام الله ما ذكر اسمكم 
ms165	 ، % وذلك بين الناس آخره الحشر % PageV01P604 البحر : - 1(@)(@@) % ما للجبال الراسيات تسير ، % أفآن بعث للورى ونشور ؟ % 2(@)(@@) % أم زالت الدنيا فيذبل يذبل % منها ويدعي بالثبور تبير % 3(@)(@@) % أم أخبرت أن ابن أيوب قضى ، % فتكاد من حزن عليه تمور % 4(@)(@@) % الأفضل الملك الذي لفخاره % ذيل على هام السهى مجرور % 5(@)(@@) % ذو الرتبة العلياء ، والوجه الذي % % منه البدور تغار ثم تغور % 6(@)(@@) % فإذا سخا ذل النضار بكفه ، % عنا ، ويعدل والزمان يجور % 7(@)(@@) % يروي حديث الجود عنه معنفا ، % فحديثه بين الورى مأثور % 8(@)(@@) % جمع الثناء ، وإنه ، إلا على % % جمع النضار ، إذا يشاء قدير % 9(@)(@@) % من معشر ما شك طالب جودهم % % أن الثناء عليهم محصور % 10(@)(@@) % قوم ، إذا صمت الرواة لفضلهم ، % % PageV01P605 11(@)(@@) % أخنت علينا الحادثات برزئه ، % والرزء بالملك الكبير كبير % 12(@)(@@) % وعلا النعي له ، وكان إذا بدا % % يعلو له التهليل والتكبير % 13(@)(@@) % عم الخلائق حزنه ، فقلوبهم % % بالحزن موتى ، والجسوم قبور % 14(@)(@@) % عف الإزار ، فلا يلاث بزلة ، % فيقال : إن هباته تكفير % 15(@)(@@) % طالت إلى الحسنى يداه ، وخطوه ، % نحو المعاصي ، واللسان قصير % 16(@)(@@) % يتطهر الماء القراح بسعيه % وبطيبه يتعطر الكافور % 17(@)(@@) % أين الذي كسب الثناء بسعيه % % لتجارة في المجد ليس تبور % 18(@)(@@) % أين الذي ساس البلاد بخاطر % كالبحر ليس لصفوه تكدير % 19(@)(@@) % أين الذي عم الأنام بأنعم % يطوى الزمان ، وذكرها منشور % 20(@)(@@) % يا غائبا أخفى التراب جماله % عنا ، وأنعمه لدي حضور % PageV01P606 21(@)(@@) % ومسافرا ولى فطول نأيه ، % ونرى المسافر فرضه التقصير % 22(@)(@@) % لقد استقمت كما أمرت ، وأمرك ال % % عالي ، فأنت الآمر المأمور % 23(@)(@@) % رأي حميت به حماة وأهلها ، % ورعى الممالك سعيك المشكور % 24(@)(@@) % ما زال وفرك للعفاة معرضا ، % أبدا ، وعرضك بينهم موفور % 25(@)(@@) % ما خلت أن نداك تقلع سحبه % عنا ، وينضب بحره المسجور % 26(@)(@@) % أفإن أصم صداك عني إن لي % % منك الصدى المهموزث والمقصور % 27(@)(@@) % سمعت بمقدمك الجنان فزخرفت % وتباشرت ولدانها والحور % 28(@)(@@) % لم تثن عنك الغاسلون عنانها ، % إلا أتاك مبشر وبشير % 29(@)(@@) % وغدت تقول العالمون وقد بكت % علما بلذة ما إليه تصير % 30(@)(@@) % تبكي عليه ، وما استقر 
ms166	 قراره % في اللحد ، حتى صافحته الحور % PageV01P607 البحر : بسيط تام 1(@)(@@) % اليوم زعزع ركن المجد وانهدما ، % فحق للخلق أن تذري الدموع دما % % 2(@)(@@) % ما من وفي بكى دمعا بغير دم ، % إلا غدا في صفاء الود متهما % 3(@)(@@) % يا فجعة أحدثت في المجد معضلة % تبلي الصميم وفي سمع العلى صمما % % 4(@)(@@) % شق الجيوب بلا شق القلوب بها % % خلق ذميم لمن يرعى لها الذمما % % 5(@)(@@) % حتام أحزن في توديع مرتحل ، % وأقرع السن في آثاره ندما % % 6(@)(@@) % من خالط الناس كان الحزن غايته ، % من أكثر النوم لا يستذنب الحلما % % 7(@)(@@) % أماتني الحزن إلا أن نطق فمي % % يحكي الصدى لنعي خطبه عظما % % 8(@)(@@) % أين الذي كان مغناه لآمله % حصنا ، وظل فناه للنزيل حمى % % 9(@)(@@) % أين الذي كان مسعاه وبهجته % % بين الممالك تجلو الظلم والظلما % % 10(@)(@@) % أين الذي كان نعم المستشار به ، % إذا تراكم موج الشك والتطما % % PageV01P608 11(@)(@@) % وإن غدت الملوك الأرض مشكلة % غدا لها حكما ترضى بها حكما % % 12(@)(@@) % يقظان يرضيك نجواه وخاطره ، % إن قال أفهم ، أو أسمعته فهما % % 13(@)(@@) % مضى الأمير عماد الدين عن أمم % قد كان منها سناه والندى أمما % % 14(@)(@@) % فما أرتنا الليالي عنده نعما ، % حتى قضى ، فأرتنا عنده نقما % % 15(@)(@@) % قضى ديون العلى في عزة وقضى % % عف الإزار بحبل الله معتصما % % 16(@)(@@) % ما مال إلا على مال يجود به % على الورى ولغير الخيل ما ظلما % % 17(@)(@@) % ولم يحرك لسانا في أذى أحد % من العباد ، ولا أجرى به قلما % % 18(@)(@@) % يا ناصر الحق لماعز ناصره ، % وذل من لم يكن بالجاه ملتزما % % 19(@)(@@) % ما كنت إلا طرازا راق منظره % على ثياب العلى والمجد قد رقما % % 20(@)(@@) % ماتت لموتك خلق كنت غيثهم ، % وهد فقدك من أهل الرجا أمما % % PageV01P609 21(@)(@@) % لبيت داعي الردى لما فجئت به % طوعا ، ولم تر منه عابسا وجما % % 22(@)(@@) % رميت بالذل قوما أنت عزهم ، % وما رميت ولكن الإله رمى % % 23(@)(@@) % حل الردي بك ضيفا فانبسطت له ، % وجدت بالنفس لما رامها كرما % % 24(@)(@@) % قد سلمتك الليالي في تصرفها ، % حتى المنية ألقت دونك 
ms167	 السلما % % 25(@)(@@) % ففاجأتك برفق لم يذقك ضنى ، % ولم تقاس بها في مرضة ألما % % 26(@)(@@) % يا ابن الأئمة والقوم الذين سموا % % على الأنام ، فكانوا للهدى علما % % 27(@)(@@) % مثواك في يوم عاشوراء يخبرنا % % بقرب أصلك من آبائك الكرما % % 28(@)(@@) % وخلقك السبط يا ابن السبط حن له ، % فيوم مصرعه من بيننا اخترما % % 29(@)(@@) % قد كان وجهك في الإقبل قبلتنا ، % فأصبح اسمك فيما بيننا قسما % % 30(@)(@@) % وكان ملك في الأقوام منقسما ، % فصار حزنك بين الناس مقتسما % % PageV01P610 31(@)(@@) % كنا نعزيك في الأموال تتلفها ، % فاليوم فيك نعزي المجد والكرما % % 32(@)(@@) % أرضعتنا ثدي أنس منك تألفه ، % فاليوم منك رضيع الأنس قد فطما % % 33(@)(@@) % تبدي التواضع للاخوان منبسطا ، % وإن وضعت على هام السها قدما % % 34(@)(@@) % بسطت لي منك أخلاقا وتكرمة ، % حتى غدا الود فيما بيننا رحما % % 35(@)(@@) % فكيف نحيا ، وقد زال الحياة لنا ، % فإن نمت بعده حزنا فلا جرما % % 36(@)(@@) % أبكي عليه ، وهل يشفي البكا كمدا ، % ولو مزجت دموعي بالدماء لما % % 37(@)(@@) % ويكف نبكي أمرأ كان الإله له % في المال والآل والخيرات قد ختما % % 38(@)(@@) % مضى ، وأبقى لنا من بعده خلفا % شمل العلاء به قد عاد ملتئما % % PageV01P611 البحر : بسيط تام 1(@)(@@) % ما مات من أنتم أغصان دوحته ، % فالذكر منه مقيم بين أحياء % 2(@)(@@) % لما اقتضى الدهر منه وتره ، وقضى % % عف الإزار حميد الفعل والرأي % 3(@)(@@) % كنتم له خلفا يهدي الثناء له ، % كالماء للورد ، أو كالورد للماء % PageV01P612 البحر : كامل تام 1(@)(@@) % خفص همومك ، فالحياة غرور ، % ورحى المنون ، على الأنام تدور % 2(@)(@@) % والمرء في دار الفناء مكلف ، % لا قادر فيها ولا معذور % 3(@)(@@) % والناس في الدنيا كظل زائل ، % كل إلى حكم الفناء يصير % 4(@)(@@) % فالناس والملك المتوج واحد ، % لا آمر يبقى ، ولا مأمور % 5(@)(@@) % عجبا لمن ترك التذكر ، وانثنى % % في الأمن ، وهو بعينه مغرور % 6(@)(@@) % في فقدنا الملك المؤيد شاهد % ألا يدوم مع الزمان سرور % 7(@)(@@) % ملك تيتمت الملوك برأيه ، % فكأنه لصلاحهم إكسير % 8(@)(@@) % من آل أيوب الذين سماحهم % % بحر بأمواج الندى مسجور % 9(@)(@@) % أضحت مدائحه الحسان مراثيا ، % للناس منها 
ms168	 رنة وزفير % 10(@)(@@) % وبكت له أهل الثغور ، وطالما % % ضحكت لدست الملك منه ثغور % PageV01P613 11(@)(@@) % أمسى عماد الدين بعد علومه % ولطبه عما عراه قصور % 12(@)(@@) % وإذا القضاء جرى بأمر نافذ ، % غلط الطبيب ، وأخطأ التدبير % 13(@)(@@) % ولو أن إسماعيل مثل سميه % % يفدى ، فدته ترائب ونحور % 14(@)(@@) % إن لمت صرف الدهر فيه أجابني : % أبت النهى أن يعتب المقدور % 15(@)(@@) % أو قلت : أين ترى المؤيد ؟ قال لي : % أين المظفر قبل والمنصور ؟ % 16(@)(@@) % أم أين كسرى أزدشير وقيصر % والهرمزان ، وقبلهم سابور ؟ % 17(@)(@@) % أين ابن داود سلمان الذي % % كانت بجحفله الجبال تمور % 18(@)(@@) % والريح تجري حيث شاء بأمره ، % منقادة ، وبه البساط يسير % 19(@)(@@) % فتكت بهم أيدي المنون ، ولم تزل % خيل المنون على الأنام تغير % 20(@)(@@) % لو كان يخلد بالفضائل ماجد ، % ما ضمت الرسل الكرام قبور % PageV01P614 21(@)(@@) % كل يصير إلى البلى ، فأجبته : % إني لأعلم ، واللبيب خبير % PageV01P615 البحر : وافر تام 1(@)(@@) % لدوا للموت ، وابنوا للخراب ، % فما فوق التراب إلى التراب % 2(@)(@@) % كذلك قال خير الخلق طرا ، % رسول الله ، ذو الأمر المجاب % 3(@)(@@) % فمرجع كل حي للمنايا ، % وغاية كل ملك للذهاب % 4(@)(@@) % بنو الدنيا فرائس للمنايا ، % وناب الموت عنها غير ناب % 5(@)(@@) % ومن يغتر في الدنيا بعيش ، % فقد طلب الشراب من السراب % 6(@)(@@) % دعا ابنك للردى من ليس يعصى ، % وداعي الموت ممنوع الجواب % 7(@)(@@) % أرانا فقده الأيام سودا ، % ونادي الأنس مغبر الجناب % 8(@)(@@) % وما طيب الحياة بغير بشر ، % ولا حسن السماء بلا شهاب % 9(@)(@@) % فلذ بالصبر في اللائي وأحسن % عزاءك واغتنم حسن الثواب % 10(@)(@@) % فإنك من أناس ليس يخفى % % على آرائهم وجه الصواب % PageV01P616 البحر : وافر تام 1(@)(@@) % كذا فليصبر الرجل النجيب ، % إذا نزلت بساحته الخطوب % 2(@)(@@) % يسر النفس ثم يسر حزنا ، % يضيق ببعضه الصدر الرحيب % 3(@)(@@) % ويبدي البأس للأعداء كيلا % % تؤنبه الشوامت ، أو تعيب % 4(@)(@@) % ومثل علاك نور الدين من لا % % يقلقل قلبه نوب تنوب % 5(@)(@@) % فإنك في جلاد الملك خطب ، % وفي يوم الجدال له خطيب % 6(@)(@@) % تخافك حين تزجرها الرزايا ، % وتجلى حين تلحظها الكروب % 7(@)(@@) % بقلب كل فكرته 
ms169	 عيون ، % وطرف كل نظرته قلوب % 8(@)(@@) % وإن يد الردى ، ووقيت منها ، % سهام خطوبها أبدا تصيب % 9(@)(@@) % أرتك بفقد فخر الدين رزءا ، % تشق له المرائر لا الجيوب % 10(@)(@@) % كريم ما بسمع نداه وقر ، % ولاي وجه نائله قطوب % PageV01P617 11(@)(@@) % ولو أن الوغى سلبته منا ، % وبزته الوقائع والحروب % 12(@)(@@) % لقام بنصره منا رجال % تزر على دروعهم القلوب % 13(@)(@@) % بيض يغتدي نمل المنايا % % له من فوق صفحتها دبيب % 14(@)(@@) % وخيل كلما رفعت عجاجا % جلاه الدرع والسيف العضيب % 15(@)(@@) % كأن مثار عثيرها سحاب % جلاه الدرع والسيف العضيب % 16(@)(@@) % كأن مثار عثيرها سحاب % حدته من سنابكها جنوب % 17(@)(@@) % أفخر الدين كم أعليت فخرا ، % لآلك حين تشهد ، أو تغيب % 18(@)(@@) % برغمي أن تبيت غريب دار ، % وعشت ، وأنت في الدنيا غريب % 19(@)(@@) % وتخلو منك أمينة المعالي ، % ويمحل ذلك المرعى الخصيب % 20(@)(@@) % وتدعوك الكفاة ولا تناجي ، % وتسألك العفاة ، فلا تجيب % PageV01P618 21(@)(@@) % ويقسم في الأنام زكاة مدح ، % ومالك في نصابهم نصيب % 22(@)(@@) % خفيت عن العيون ، وأي شمس % تلوح ، ولا يكون لها مغيب % 23(@)(@@) % فصبرا يا بني إسحاق ، صبرا ، % فرب العيش بالحسنى يثيب % 24(@)(@@) % وخفض عنك نور الدين حزنا ، % تكاد الراسيات به تذوب % 25(@)(@@) % فإن قريب ما تخشى بعيد ، % وإن بعيد ما ترجو قريب % 26(@)(@@) % وليس الحتف في الدنيا عجيب ، % ولكن البقاء بها عجيب % PageV01P619 البحر : سريع 1(@)(@@) % لا شغل الله لكم خاطرا ، % ولا عرتكم بعدها شائبه % % 2(@)(@@) % ولا أرتكم لصروف الردى % % حادثة تصمي ولا نائبه % % PageV01P620 البحر : خفيف تام 1(@)(@@) % ظن قومي أن الأساة ستبري % % داء وجدي ، والعلاج يفيد % 2(@)(@@) % فأتوا بالطبيب ، وهو لعمري % % في ذوي فنه مجيد مجيد % 3(@)(@@) % مذ رأى علتي ، وقد لاح للمو % % ت عليها أدلة وشهود % 4(@)(@@) % جس نبضي وقال : ما أنت شاك ؟ % قلت : نارا لم يطفها التبريد % 5(@)(@@) % فغدا يخلص الدواء ، فألفى % % نار وجدي مع الدواء تزيد % 6(@)(@@) % قال : ماكان أصل دائك هذا ؟ % قلت : طرفي ، وذاك حال شديد % 7(@)(@@) % قال : إن الهوى قد أحدث بلوا % % ك ، فقلت : المقصور لا الممدود % 8(@)(@@) % فانثنى حائرا وقال لأهلي : % ما شفاء 
ms170	 العشاق إلا بعيد % PageV01P621 البحر : وافر تام 1(@)(@@) % أذاب التبر في كأس اللجين ، % رشا بالراح مخضوب اليدين % 2(@)(@@) % رخيم من بني الأعراب طفل ، % يجاذب خصره جبلي حنين % 3(@)(@@) % يبدل نطقه ضادا بدال ، % ويشرك عجمة قافا بغين % 4(@)(@@) % يطوف على الرفاق من الحميا ، % ومن خمر الرضاب بمسكرين % 5(@)(@@) % إذا يجلو الحميا والمحيا % % شهدنا الجمع بين النيرين % 6(@)(@@) % وآخر من بني الأعراب حفت % جيوش الحسن منه بعارضين % 7(@)(@@) % إلى عينيه تنتسب المنايا ، % كما انتسب الرماح إلى ردين % 8(@)(@@) % تلاحظ سوسن الخدين منه ، % فيبدلها الحياء بوردتين % 9(@)(@@) % ومجلسنا الأنيق تضيء فيه % وبات الزق مغلول اليدين % 10(@)(@@) % وشمعتنا شبيه سنان تبر ، % تركب في قناة من لجين % PageV01P622 11(@)(@@) % وقهوتنا شبيه شواظ نار ، % توقد في أكف الساقيين % 12(@)(@@) % إذا ملىء الزجاج بها وطارت % حواشي نورها في المشرقين % 13(@)(@@) % عجبت لبدر كأس صار شمسا % يحف من السقاة بكوكبين % 14(@)(@@) % ونحن نزف أعياد النضارى % % بشط محول والرقمتين % 15(@)(@@) % نوحد راحنا من شرك ماء ، % ونولع في الهوى بالمذهبين % 16(@)(@@) % بورد كالمداهن في عقيق ، % وأقداح كأزرار اللجين % 17(@)(@@) % وقد جمعت لي اللذات لما % % دنت منها قطوف الجنتين % 18(@)(@@) % وما أن من هوى الفيحاء خال ، % ولا ممن أحب قضيت ديني % % 19(@)(@@) % إذا ما قلبوا في الحشر قلبي ، % رأوا بين الضلوع هوى حسين % 20(@)(@@) % تملك حبه قلبي وصدري ، % فأصبح ملء تلك الخافقين % PageV01P623 21(@)(@@) % وأعوز مع دنوي منه صبري ، % فكيف يكون صبري بعد بين % 22(@)(@@) % إذا ما رام أن يسلوه قلبي % % تمثل شخصه تلقاء عيني % % 23(@)(@@) % ألا يا نسمة السعدي كوني % % رسولا بين من أهوى وبيني % % 24(@)(@@) % ويا نشر الصبا بلغ سلامي % % إلى الفيحاء بين القلتين % 25(@)(@@) % وحي الجامعين وجانبيها ، % فقد كانا لشملي جامعين % 26(@)(@@) % وقل لمعذبي هل من نجاز % لوعدي سالفيك السالفين % 27(@)(@@) % سميك كان مقتولا بظلم ، % وأنت ظلمتني ، وجلبت حيني % % 28(@)(@@) % وهبتك في الهوى روحي بوعد ، % وبعتك عامدا نقدا بدين % 29(@)(@@) % وجئت وفي يدي كفني وسيفي ، % فكيف جعلتها خفي حنين ؟ % 30(@)(@@) % ولم صيرت بعدك قيد قلبي ، % وكان جمال وجهك قيد عيني ؟ % PageV01P624 31 
ms171	(@)(@@) % فصرنا نشبهث النسرين بعدا ، % وكنا ألفة كالفرقدين % 32(@)(@@) % علمت بأن وعدك صار مينا ، % لزجري مقلتيك بصارمين % 33(@)(@@) % وقلت ، وقد رأيتك : خاب سعيي % % لكون البدر بين العقربين % 34(@)(@@) % فلم دليتني بحبال زور ، % ولم أطعمتني بسراب مين % 35(@)(@@) % وهلا قلت لي قولا صريحا ، % فكان المنع إحدى الراحتين % 36(@)(@@) % عرفتك دون كل الناس لما % % نقدتك في الملاحة نقد عين % 37(@)(@@) % وكم قد شاهدتك الناس قبلي ، % فما نظروك كلهم بعيني % % 38(@)(@@) % وطاوعت الفتوة فيك حتى % % جعلتك في العلاء برتبتين % 39(@)(@@) % فلما أن خلا المغنى وبتنا % % عراة بالعفاف مؤزرين % 40(@)(@@) % قضينا الحج ضما واستلاما ، % ولم نشعر بما في المشعرين % PageV01P625 41(@)(@@) % أتهجرني وتحفظ عهد غيري ، % وهل للموت عذر بعد دين % 42(@)(@@) % وقلت : الوعد عند الحر دين ، % فكيف مطلتني وجحدت ديني % % 43(@)(@@) % أأجعل لي سواك عليك عينا ، % وكنت على جمعي الناس عيني % % 44(@)(@@) % إذا ما جاء محبوبي بذنب % يسابقه الجمال بشافعين % 45(@)(@@) % وقلت : جعلت كل الناس خصمي % % لقد شاهدت إحدى الحالتين % 46(@)(@@) % فكان الناس قبل هواك صحبي ، % فهل أبقيت لي من صاحبين % 47(@)(@@) % بعادي أطمع الأعداء حتى % % رأوك اليوم خزر الناظرين % 48(@)(@@) % وهلا طالعوك بعين سوء ، % وأمري نافذ في الدولتين % 49(@)(@@) % وما خفقت جناح الجيش إلا % رأوني ملء قلب العسكرين % 50(@)(@@) % لئن سكنت إلى الزوراء نفسي ، % أواني الراح من ورق وعين % PageV01P626 51(@)(@@) % هوى يقتادني لديار بكر ، % وآخر نحو أرض الجامعين % 52(@)(@@) % سأسرع نحو رأس العين خطوي ، % وأقصدها على رأسي وعيني % % 53(@)(@@) % وأسرح في حمى جيرون طرفي ، % وأربع في رياض النيرين % 54(@)(@@) % فليس الخطب في عيني جليلا ، % إذا قابلته بالأصغرين % 55(@)(@@) % فيا من بان لما بان صبري ، % وحاربني رقاد المقلتين % 56(@)(@@) % تنغص فيك بالزوراء عيشي ، % وبدل زين لذاتي بشين % PageV01P627 البحر : طويل 1(@)(@@) % ترى سكرت عطفاه من خمر ريقه ، % فماست به ، أم من كؤوس رحيقه % 2(@)(@@) % مليح يغير الغصن عند اهتزازه ، % ويخجل بدر التم عند شروقه % 3(@)(@@) % فما فيه شيء ناقص غير خصره ؛ % ولا فيه شيء بارد غير ريقه % 4(@)(@@) % ولا ما يسوء النفس غير نفاره ، % ولا ما يرع 
ms172	 القلب غير عقوقه % 5(@)(@@) % عجبت له يبدي القساوة عندما % % يقابلني من خده برقيقه % 6(@)(@@) % ويلطف بي من بعد إعمال لحظه ، % وكيف يرد السهم بعد مروقه % 7(@)(@@) % يقولون لي ، والبدر في الأفق مشرق : % بذا أنت صب ؟ قلت : بل بشقيقه % 8(@)(@@) % فلا تنكروا قتلي بدقة خصره ، % فإن جليل الخطب دون دقيقه % 9(@)(@@) % وليلة عاطاني المدام ، ووجهه % يرينا صبوح الشرب حال غبوقه % 10(@)(@@) % بكأس حكاها ثغره في ابتسامة ، % بما ضمه من دره وعقيقه % PageV01P628 11(@)(@@) % لقد نلت ، إذ نادمته ، من حديثه % من السكر ما لا نلته من عقيقه % 12(@)(@@) % فلم أدر من أي الثلاثة سكرتي ، % أمن لحظه أم لفظه أم رحيقه % 13(@)(@@) % لقد بعته قلبي بخلوة ساعة ، % فأصبح حقا ثابتا من حقوقه % 14(@)(@@) % وأصبحت ندمانا على خسر صفقتي ، % كذا من يبيع الشيء في غير سوقه % PageV01P629 البحر : رجز تام 1(@)(@@) % لولا الهوى ما ذاب من حنينه % صب أصابته عيون عينه % 2(@)(@@) % متيم لا تهتدي عواده ، % إلا بما تسمع من أنيبه % 3(@)(@@) % أصبح يخشى الظبي في كناسه ، % ولا يخاف الليث في عرينه % 4(@)(@@) % يعتذر الرشد إلى ضلاله ، % ويقرأ العقل على جنونه % 5(@)(@@) % يا جيرة الحي أجيروا عاشقا ، % ما حال عن شرع الهوى ودينه % 6(@)(@@) % باطنه أحسن من ظاهره ، % وشكه أوضح من يقينه % 7(@)(@@) % لا تحسبوا ما ساح فوق خده % مدامعا تسفح من جفونه % 8(@)(@@) % وإنما ذاب جليد قلبه ، % فطرفه يرشح من معينه % PageV01P630 البحر : كامل تام 1(@)(@@) % غيري بحبل سواكم يتمسك ، % وأنا الذي بتربكم أتمسك % 2(@)(@@) % أضع الخدود على ممر نعالكم ، % فكأنني بترابها أترك % 3(@)(@@) % ولقد بذلت النفس ، إلا أنني % % خادعتكم ، وبذلت ما لا أملك % 4(@)(@@) % شرطي بأن حشاشتي رق لكم ، % والشرط في كل المذاهب أملك % 5(@)(@@) % قد ذقت حبكم ، فأصبح مهلكي ، % ومن المطاعم ما يذاق فيهلك % 6(@)(@@) % لا تعجلوا قبل اللقاء بقتلتي ، % وصلوا ، فذلك فائت يستدرك % 7(@)(@@) % ولقد بكيت لدهشتي بقدومكم ، % وضحكت قبل وهجركم لي مهلك % 8(@)(@@) % ولربما أبكى السرور إذا أتى % % فرطا ، وفي بعض الشدائد يضحك % 9(@)(@@) % زعم الوشاة بأن هويت سواكم ، % يا قوتل الواشي 
ms173	 ، فأنى يؤفك % 10(@)(@@) % عار علي بأن أكون مشرعا % دين الهوى ، ويقال إني مشرك % PageV01P631 البحر : سريع 1(@)(@@) % جل الذي أطلع شمس الضحى % % مشرقة في جنح ليل بهيم % 2(@)(@@) % وقدر الخال على خده ، % ذلك تقدير العزيز العليم % 3(@)(@@) % بدر ظننا وجهه جنة ، % فمسنا منها عذاب أليم % 4(@)(@@) % ينفر كالريم ، الا فانظروا % % إلى بخيل ، وهو عندي كريم % 5(@)(@@) % لما انحنى حاجبه ، وانثنى % % يهز للعشاق قدا قويم % 6(@)(@@) % عجبت من فرط ضلالي ، وقد % % بدا لي المعوج والمستقيم % 7(@)(@@) % داو حبيبي ، يا طبيب الهوى ، % وخلني ! إني بحالي عليم % 8(@)(@@) % فخصره واه ، وأجفانه % مريضة ، واللحظ منه سقيم % PageV01P632 البحر : طويل 1(@)(@@) % رعى الله من لم يرع لي حق صحبة ، % وسلم من لم يسخ لي بسلامه % 2(@)(@@) % وفي ذمة الرحمن من ذم صحبتي ، % ولم أك يوما ناقضا لذمامه % 3(@)(@@) % وإني على صبري على فرط هجره ، % وقرب مغانيه ، وبعد مرامه % 4(@)(@@) % يحاول طرفي لحظة من خياله ، % ويشتاق سمعي لفظة من كلامه % 5(@)(@@) % ويوم وقفنا للوداع ، وقد بدا % % بوجه يحاكي البدر عند تمامه % 6(@)(@@) % شكوت الذي ألقى ، فظل مقابلا % بكاي وشكوى حالتي بابتسامه % 7(@)(@@) % بدمع يحاكي لفظه في انتثاره ، % وعتب يحاكي ثغره في انتظامه % 8(@)(@@) % فما رق من شكواي غير خدوده ، % ولا لان من نجواي غير قوامه % PageV01P633 البحر : طويل 1(@)(@@) % أصدا وسخطا ، ما له كيف يحكم ، % أليس له قلب يرق ، فيرحم % 2(@)(@@) % أأرضى بقتلي في الهوى وهو ساخط ، % وأبسط أعذاري له وهو مجرم % 3(@)(@@) % نبي جمال للغرام مشرع ، % يحلل ما يختاره ويخرم % 4(@)(@@) % يرينا خدود المحسنين ضوارعا % لديه ، وأقدام المسيئين تلثم % 5(@)(@@) % عجبت له يجني ويصبح عاتبا ، % فو حربا من ظالم يتظلم % 6(@)(@@) % وأعجب من ذا أنه ، وهو ظالمي ، % غدا لي خصما وهو في الفصل يحكم % 7(@)(@@) % فيا عاتبا في سكب دمع أذاله ، % فأمسى بأسرار الهوى يتكلم % 8(@)(@@) % أسرت فؤادي ثم أطلقت أدمعي ، % وحاولت أني للصبابة أكتم % 9(@)(@@) % ومن قلبه مع غيره كيف حاله ؛ % ومن سره في جفنه كيف يكتم % PageV01P634 البحر : بسيط تام 1(@)(@@) % هويته تحت أطمار مشعثة ، % وطالب الدر 
ms174	 لا يغتر بالصدف % 2(@)(@@) % وخبرتني معان في مراسمه % به ، كما خبر العنوان بالصحف % 3(@)(@@) % ولاح لي من أمارات الجمال به % % ما كان لحظ غيري بالخمول خفي % % 4(@)(@@) % فظلت أرخص ما يبديه من درن % به ، وأدحض ما يخفيه من جنف % 5(@)(@@) % حتى إذا تم معنى حسنه وبدا % % كالبدر في التم أو كالشمس لي الشرف % 6(@)(@@) % ولاح كالصارم المصقول أخلصه % % تتبع القين من شين ومن كلف % 7(@)(@@) % وجال في وجهه ماء الحياة كما % % يجول ماء الحيا في الروضة الأنف % 8(@)(@@) % وأولد الحسن في أحداقه حورا ، % وضاعف الدل ما بالجسم من ترف % 9(@)(@@) % أضحت به حدق الحساد محدقة % ترنو إليه بطرف غير منطرف % 10(@)(@@) % وظل كل صديق يرتضي سخطي % % فيه ، وكل شفيق يرتجي تلفي % % PageV01P635 11(@)(@@) % يا للرجال أما للحب منتصر % لضعف كل محب غير منتصف % 12(@)(@@) % ما أطيب العيش لولا أن سالكه % يمسي لأسهم كيد الناس كالهدف % PageV01P636 البحر : كامل تام 1(@)(@@) % يا رب أعط العاشقين بصبرهم % % في الخلد غايات النعيم المطلق % 2(@)(@@) % وأقهم برد السرور ، فطالما % % صبروا على حر الغرام المقلق % 3(@)(@@) % حتى يرى الجبناء عن حمل الهوى % % غايات عزهم ، التي لم تلحق % 4(@)(@@) % فيكون أصغر جاهل حمل الهوى % % يلهو بأكبر عالم لم يعشق % PageV01P637 البحر : خفيف تام 1(@)(@@) % يا ضعيف الجفون أضعفت قلبا ، % كان قبل الهوى قويا مليا % % 2(@)(@@) % لا تحارب بناظريك فؤادي ، % فضعيفان يغلبان قويا % % PageV01P638 البحر : بسيط تام 1(@)(@@) % أطعت ما سن أعدائي وما فرضوا ، % وشاهدوك بسخطي راضيا فرضوا % % 2(@)(@@) % تشيعوا ، إذ رأوا تفريقنا شيعا ، % وسنة العدل في دين الهوى رفضوا % % 3(@)(@@) % أعياهم السعي فيما بيننا زمنا ، % فمذ رأوا فرصة في بيننا نهضوا % % 4(@)(@@) % بنوا لديك بناء لا ثبات له ، % وما دروا أي ود بيننا نقضوا % % 5(@)(@@) % يا من تقطب مني حين أمنحه % أنسا ، وأبسط آمالي فينقبض % 6(@)(@@) % ومن تعرض لي حتى أعارضه ، % يوما ، فيعرض عني ثم يعترض % 7(@)(@@) % لا بارك الله للأعداء فيك ، ولا % % هناك من لك عني منهم العوض % 8(@)(@@) % ولا تعدى لظلمي في الوثوق بهم ، % ولا علا منك بين 
ms175	 الناس ما خفضوا % % 9(@)(@@) % فسوف تعرف مقداري ، إذا سميت % نفوسهم ، وانقضى من وصلك الغرض % PageV01P639 البحر : خفيف تام 1(@)(@@) % حرضوني على السلو ، وعابوا % % لك وجها به يعاب البدر % 2(@)(@@) % حاشا لله ما لعذري وجه ، % في التسلي ، ولا لوجهك عذر % PageV01P640 البحر : وافر تام 1(@)(@@) % حديث الناس أكثره محال ، % ولكن للعدى فيه مجال % 2(@)(@@) % وأعلم أن بعض الظن إثم ، % ولكن لليقين به احتمال % 3(@)(@@) % وكنت عذرتكم والقول نزر ، % فما عذري وقد كشر المقال % 4(@)(@@) % وقلتم : قيل ما لا كان عنا ، % فمن لي أن يكون ، ولا يقال % 5(@)(@@) % فيا من ضاع فيه نفيس عمري ، % وقوض فيه مالي والرجال % 6(@)(@@) % وكم قد رامه ضدي بسوء ، % فراح وآله في الحرب آل % 7(@)(@@) % سألتك لا تدع للقول وجها ، % فيكثر حين أذكرك الجدال % 8(@)(@@) % وإني مع صدودك والتجني % % وفي ليس لي عنك انتقال % 9(@)(@@) % أغار إذا سرى بحماك برق ، % وأغضب كلما طرق الخيال % 10(@)(@@) % وأوثر أن ينال دمي ووفري ، % ومحبوبي عزيز لا ينال % PageV01P641 11(@)(@@) % لأني لا أخون عهود خل ، % ولو حفت بي النوب الثقال % 12(@)(@@) % وإني إن حلفت له يمينا ، % فما غير الفعال لها شمال % 13(@)(@@) % فيا من سرني باللفظ منه ، % ولكن ساءني منه الفعال % 14(@)(@@) % إلى كم ألتقيك بوجه بشر ، % وفي طي الحشا داء عضال % 15(@)(@@) % وأحمل من عداتك كلذ يوم % حديثا ليس تحمله الجبال % 16(@)(@@) % وأسمع من وشاة الحي فينا % % كلاما دون موقعه النبال % 17(@)(@@) % وأرسل مع ثقاتك من حديثي % % عتابا ، دونه السحر الحلال % 18(@)(@@) % ومهما لم يكن في السيف أصل % لجوهره ، فما يجدي الصقال % 19(@)(@@) % جعلت جميع إحساني ذنوبا ، % وطال بك التعتب والدلال % 20(@)(@@) % وقلت بك انهتكت ، وذاك زور % وإن الزور موقعه محال % PageV01P642 21(@)(@@) % فما نفعي بحسن في خليل ، % إذا لم يصف لي منه الخلال % 22(@)(@@) % إذا عدم الفتى خلقا جميلا ، % يسود به ، فلا خلق الجمال % PageV01P643 البحر : وافر تام 1(@)(@@) % إذا علم العدى عنك انتقالي ، % فخذ ما شئت من قيل وقال % 2(@)(@@) % ونالوا منك بالأقوال عرضا ، % وقيناه بأطراف العوالي % % 3(@)(@@) % وقد كان العذول يود أني 
ms176	 % % أسيغ له اليسير من المقال % 4(@)(@@) % فكيف إذا تيقن فيك زهدي ، % وكان يسره عنك اشتغالي % % 5(@)(@@) % فكم سخط الأنام ، وأنت راض ، % وكم رخص الملاح ، وأنت غالي % % 6(@)(@@) % وكم هدمت حمى قومي خطوب % تهد الراسيات ، وأنت عالي % % 7(@)(@@) % وكم من وقعة لعداك عندي ، % نذرت بها دمي ، ونذرت مالي % % 8(@)(@@) % وكم همت كلاب الحي نهضا % وقد حمت الأسود حمى الغزال % 9(@)(@@) % وكم لامت عليك سراة أهلي ، % فأحسب قول آلي لمع آل % 10(@)(@@) % وكم خاطرت فيك ببذل نفسي % % وأعلم أن بالي فيك بالي % % PageV01P644 11(@)(@@) % وكم صب تفاءل في حبيب % وفى لي ، إن حبي ما وفى لي % % 12(@)(@@) % وكم جربت قبلك من مليح ، % فأمسى جيد حالي منه حالي % % 13(@)(@@) % ولولا أن في التجريب فضلا ، % لما فضل اليمين على الشمال % 14(@)(@@) % أظنك ، إذ حويت الحسن طرا ، % وإذ وفيت أقسام الجمال % 15(@)(@@) % قصدت بأن جعلت العذر عيبا ، % عساه يقيك من عين الكمال % 16(@)(@@) % فسوف أسوء نفسي بانقطاعي ، % بحيث أسر نفسك بارتحالي % % 17(@)(@@) % إذا ماشئت أن تسلو حبيبا ، % فأكثر دونه عدد الليالي % % PageV01P645 البحر : طويل 1(@)(@@) % تيقن مذ أعرضت أني له سالي ، % فأوهم ضدي أنه الهاجر القالي % % 2(@)(@@) % وأظهر للأعداء ، إذ صد جافيا ، % بأن جفاه عن دلال وإذلال % 3(@)(@@) % فلما رآني لا أحرك باسمه % لساني ، ولم أشغل بتذكاره بالي % % 4(@)(@@) % وأيقنض أني لا أعود لوصله ، % ولو قطعت بيض الصوارم أوصالي % % 5(@)(@@) % تعرض للأعداء يحسب أنهم % يكونون في حفظ المودة أمثالي % % 6(@)(@@) % فأصبح لما جرب الغير نادما ، % كثيف حواشي العيش منخفض الحال % 7(@)(@@) % إذا ما رآه عاشق قال شامتا : % ألا انعم صباحا أيها الطلل البالي % % 8(@)(@@) % فإني إذا ما اختل خل تركته ، % وبت ، وقلبي من محبته خال % 9(@)(@@) % وما أنا ممن يبذل العرض في الهوى % % وإن جدت للمحبوب بالروح والمال % 10(@)(@@) % على أنني لا أجعل الذل سلما % به ترتقي نفسي إلى نيل آمالي % % PageV01P646 11(@)(@@) % وما زلت في عشقي عزيزا مكرما ، % أجر على العشاق بالتيه أذيالي % % 12(@)(@@) % فقولا لمن أمسى به متغاليا ، % ولم يدر أني مرخص ذلك الغالي % % 13(@)(@@) % كذا 
ms177	 لم أزل يرعى المحبون فضلتي ، % ويلبس أهل الحب في العشق أسمالي % % PageV01P647 البحر : طويل 1(@)(@@) % عذاب الهوى للعاشقين أليم ، % وأجرهم يوم المعاد عظيم % 2(@)(@@) % فوالله لا ذاقوا الجحيم وإن جنوا ، % فحسبهم أن الغرام جحيم % 3(@)(@@) % بروحي من قد نام عن سوء حالتي % % وعندي منه مقعد ومقيم % 4(@)(@@) % وما ذاك إلا أن مخطف خصره % لراجيه كهف ، والعذار مقيم % PageV01P648 البحر : طويل 1(@)(@@) % خليلي ما أغبى المغالين في الهوى ، % وأغفلهم عن حسن كل مليح % 2(@)(@@) % يظنون أن الحسن بالعين مدرك ، % وسر الهوى باد لكل لموح % 3(@)(@@) % وليس طموح الناظرين بمبصر ، % إذا كان لحظ القلب غير طموح % 4(@)(@@) % فليس جميل في الهوى وكثير % ولا عروة العذري وابن ذريح % 5(@)(@@) % بأعرف مني للملاح توسما ، % ولا جنحوا للعشق بعض جنوحي % % 6(@)(@@) % وأي لبيب ما سبى الحسن لبه ، % فبات بقلب بالغرام قريح % 7(@)(@@) % إذا ما خلا القلب الصحيح من الهوى ، % علمك بأن العقل غير صحيح % PageV01P649 البحر : مقتضب 1(@)(@@) % أين في الحمى عرب % لي بربعهم أرب % 2(@)(@@) % كلما ذكرتهم % هزني لهم طرب % 3(@)(@@) % جيرة بحيهم % ليس يحفظ الحسب % 4(@)(@@) % العهود والحقو % % ق عندهم تغتصب % 5(@)(@@) % في خيامهم قمر % بالصفاح محتجب % 6(@)(@@) % ريقه معتقة % ثغره لها حبب % 7(@)(@@) % بت في ديارهم % والفؤاد مكتئب % 8(@)(@@) % الدموع هاطلة % والضلوع تلتهب % 9(@)(@@) % إن للغرام يدا ، % مسني بها العطب % 10(@)(@@) % إن قضيت فيه أسى ، % فهو بعض ما يجب % PageV01P650 11(@)(@@) % أبدت الوشاة رضى % % منه يلحظ الغضب % 12(@)(@@) % الوجوه ضاحكة ، % والقلوب تنتحب % 13(@)(@@) % لو أتوا بمكرمة ، % أعتبوا وما عتبوا % % 14(@)(@@) % فالغرام نار لظى ، % عذلهم لها حطب % PageV01P651 البحر : سريع 1(@)(@@) % قلوبنا مودعة عندكم ، % أمانة نعجز عن حملها % % 2(@)(@@) % إن لم تصونوها بإحسانكم ، % أدوا الأمانات إلى أهلها % % PageV01P652 البحر : كامل تام 1(@)(@@) % ولقد ذكرتك ، والسيوف مواطر % كالسحب من وبل النجيع وطله % 2(@)(@@) % فوجدت أنسا عند ذكرك كاملا ، % في موقف يخشى الفتى من ظله % PageV01P653 البحر : كامل تام 1(@)(@@) % ولقد ذكرتك ، والعجاج كأنه % ظل الغني وسوء عيش المعسر % 2(@)(@@) % والشوس بين مجدل في جندل % منا ، وبين معفر في مغفر % 3(@)(@@) % فظننت 
ms178	 أني في صباح مشرق ، % بضياء وجهك ، أو مساء مقمر % 4(@)(@@) % وتعطرت أرض الكفاح ، كأنما % % فتقت لنا ريح الجلاد بعنبر % PageV01P654 البحر : كامل تام 1(@)(@@) % ولقد ذكرتك ، والجماجم وقع % تحت السنابك ، والأكف تطير % 2(@)(@@) % والهام في أفق العجاجة حوم ، % فكأنها فوق النسور نسور % 3(@)(@@) % فاعتادني من طيب ذكرك نشوة ، % وبدت علي بشاشة وسرور % 4(@)(@@) % فظننت أني في مجالس لذتي ، % والراح تجلى ، والكؤوس تدور % PageV01P655 البحر : كامل تام 1(@)(@@) % ولقد ذكرتك حين أنكرت الظبى % % أغمادها وتعارفت في الهام % 2(@)(@@) % والنبل من خلل العجاج كأنه % وبل تتابع من فروج غمام % 3(@)(@@) % فاستصغرت عيناي أفواج العدى ، % وتتابع الأقدام في الإقدام % 4(@)(@@) % ووجدت برد الأمن في حر الوغى ، % والموت خلفي تارة وأمامي % % PageV01P656 البحر : كامل تام 1(@)(@@) % يا ظبية قنص الأسود جمالها ، % ونرى الظباء يصيدها القناص % 2(@)(@@) % أصمت لواحظك القلوب بأسهم ، % لم يغن عنها نثرة ودلاص % 3(@)(@@) % فهبني جرحت الخد منك بنظرة ، % أفما لأسر القلب منك خلاص % 4(@)(@@) % ها قد جرحت بنبل عينيك الحشى ، % فدعي فؤادي ، فالجروح قصاص % PageV01P657 البحر : كامل تام 1(@)(@@) % يا من حمت عنا مذاقة ريقها ، % رفقا بقلب ليس فيه سواك % 2(@)(@@) % فلكم سألت الثغر وصف رضابه % فأبى ، وصرح لي سيفه سواك % PageV01P658 البحر : منسرح 1(@)(@@) % قالت : كحلت الجفون بالوسن ، % قلت : ارتقابا لطيفك الحسن % 2(@)(@@) % قالت : تسليت بعد فرقتنا ، % فقلت : عن مسكني وعن سكني % % 3(@)(@@) % قالت : تشاغلت عن محبتنا ، % قلت : بفرط البكاء والحزن % 4(@)(@@) % قالت : تناسيت ! قلت : عافيتي ! % قالت : تناءيت ! قلت : عن وطني % % 5(@)(@@) % قالت : تخليت ! قلت : عن جلدي ! % قالت : تغيرت ! قلت : في بدني % % 6(@)(@@) % قالت : تخصصت دون صحبتنا ، % فقلت : بالغبن فيك والغبن % 7(@)(@@) % قالت : أذعت الأسرار ، قلت لها : % صير سري هواك كالعلن % 8(@)(@@) % قالت : سررت الأعداء ، قلت لها : % ذلك شيء لو شئت لم يكن % 9(@)(@@) % قالت : فماذا تروم ؟ قلت لها : % ساعة سعد بالوصل تسعدني % % 10(@)(@@) % قالت : فعين الرقيب تنظرنا ! % قلت : فإني للعين لم أبن % PageV01P659 11(@)(@@) % أنحلتني بالصدود منك ، فلو % % ترصدتني المنون لم ترني % % PageV01P660 البحر : طويل 1(@)(@@) % فضحت بدور التم ، إذ فقتها حسنا ، % وأخجلتها ، إذ كنت من 
ms179	 نورها أسنى % % 2(@)(@@) % ولما رجونا من محاسنك الحسنى ، % بعثت لنا من سحر مقلتك الوسنى % % 3(@)(@@) % سهادا يذود النوم أن يألف الجفنا % % 4(@)(@@) % وخلت بأني عن مغانيك راحل ، % وربع ضميري من ودادك ماحل % 5(@)(@@) % فأسهر طرفي ناظر منك كاحل ، % وأبصر جسمي أن خصرك ناحل % 6(@)(@@) % فحاكاه لكن زادني دقة المعنى % % 7(@)(@@) % حويت جمالا قد خلقت برسمه ، % فخلناك بدر التم ، إذ كنت كاسمه % 8(@)(@@) % فمذ صار منك الحسن قسما كقسمه : % حكيت أخاك البدر في حال تمه % 9(@)(@@) % سنا وسناء ، إذ تشابهتما سنا % % 10(@)(@@) % سجنت فؤادي حين حرمت زورتي ، % وأطلقت دمعي لو طفا حر زفرتي % % PageV01P661 11(@)(@@) % فقلت ، وقد أبدى الغرام سريرتي : % أهيفاء إن أطلقت بالبعد عبرتي % % 12(@)(@@) % فإن لقلبي من تباريحه سجنا % % 13(@)(@@) % حرمت الرضى إن لم أزرك على النوى ، % وأحمل أثقال الصبابة والجوى % % 14(@)(@@) % فليس لداء القلب غيرك من دوا ، % فإن تحجبي بالبيض والسمر فالهوى % % 15(@)(@@) % يهون عند العاشق الضرب والطعنا % % 16(@)(@@) % سأثني حدود المشرفية والقنا ، % وأسعى إلى مغناك إن شط أو دنا % % 17(@)(@@) % وألقى المنايا كي أنال بها المنى ، % وما الشوق إلا أن أزورك معلنا % % 18(@)(@@) % ولو منعت أسد الثرى ذلك المغنى % % 19(@)(@@) % عدمت اصطباري بعد بعد أحبتي ، % فماذا عليهم لو رعوا حق صحبتي % % 20(@)(@@) % فبت ، وما أفنى الغرام محبتي ، % أأحبابنا قضيت فيكم شبيبتي % % PageV01P662 21(@)(@@) % ولم تسعفوا يوما بإحسانكم حسنى % % 22(@)(@@) % أعيدوا لنا طيب الوصال الذي مضى ، % فقد ضاق بي من بعد بعدكم الفضا % % 23(@)(@@) % ولا تهجروا فالعمر قد فات وانقضى % % وما نلت من مأمول وصلكم رضى % % 24(@)(@@) % ولا ذقت من روعات هجركم أمنا % % 25(@)(@@) % حفظت لكم عهدي على القرب والنوى % % وما ضل قلبي في هواكم وما غوى % % 26(@)(@@) % فكيف نقضتم عهد من شفه الجوى % % وكنا عقدنا لا نحول عن الهوى % % 27(@)(@@) % فقد ، وحياة الحب ، حلتم وما حلنا % % 28(@)(@@) % فلست بسال ، جرتم إو عدلتم ، % ولا حلت إن قاطعتم ، أو وصلتم % 29(@)(@@) % ولكنني راض بما قد فعلتم ، % فشكرا لما أوليتم إذ جعلتم % 30(@)(@@) % بدايتكم بالبعد منكم ، ولا منا % % PageV01P663 البحر : خفيف تام 1 
ms180	(@)(@@) % يا ديار الأحباب ! بالله ماذا % % فعلت في عراصك الأيام % 2(@)(@@) % أخلقتها يد الجديدين حتى % % نكرت من رسومها الأعلام % 3(@)(@@) % قد شهدنا فعل البلى بمغاني % % ك ، ودمع الغيوم فيك سجام % 4(@)(@@) % واقترضنا منها الدموع فقالت : % كل قرض يجر نفعا حرام % PageV01P664 البحر : منسرح 1(@)(@@) % أقول للدار ، إذ مررت بها ، % وعبرتي في عراصها تكف % 2(@)(@@) % ما بال وعد السحاب أخلف مغ % % ناك ؟ فقالت : في دمعك الخلف % PageV01P665 البحر : بسيط تام 1(@)(@@) % البيض دون لحاظ الأعين السود ، % والسمر دون قدود الخرد الغيد % 2(@)(@@) % والموت أحلى لصب في مفاصله ، % تجري الصبابة جري الماء في العود % 3(@)(@@) % من لي بعين عدت بالغنج ناعسة ، % أجفانها ، وكلت جفني بتسهيد % 4(@)(@@) % وحاجب فوقه تشديد طرته ، % كأنما النون منه نون توكيد % 5(@)(@@) % وماء وجه غدا بالنور متقدا ، % كأن في كل خد نار أخدود % 6(@)(@@) % ونقط خال ، إذا شاهدت موقعه ، % خلت الخليل ثوى في نار نمرود % 7(@)(@@) % يا أهل جيرون جرتم بعد معدلة % ظلما ، وعودتموني غير معهودي % % 8(@)(@@) % بذلت روحي إلا أنها ثمن ، % للوصل منكم ، ولكن حسب مجهودي % % 9(@)(@@) % أنا المحب الذي أهل الهوى نقلوا % % عني ، فأعطيتهم بالعشق تقليدي % % 10(@)(@@) % من أين للعشق مثلي في تشرعه ، % ومن يشيد دين الحب تشييدي % % PageV01P666 11(@)(@@) % لله ليلة أنس قلت إذ ذكرت : % يا ليلة الوصل من ذات اللمى عودي % % 12(@)(@@) % والشرق قد حملت أحشاؤه لهبا % للشمس فيها حنين غير مولود % 13(@)(@@) % وثعلب الصبح وافى فاغرا فمه ، % إذ قابلته الثريا شبه عنقود % 14(@)(@@) % كأنها شكل أنكيس تولده % في الغرب أيدي الدياجي أي توليد % 15(@)(@@) % أمسى بها وعيون الغر شاخصة % نحوي وحصني متون الضمر القود % 16(@)(@@) % مكانتي فوق إمكاني ، ومقدرتي % % من دون قدري ، وجودي فوق موجودي % % 17(@)(@@) % وما زجاني امرؤ ، إلا بذلت له % جودا عن الشكر ، أو شكرا عن الجود % 18(@)(@@) % لا أوحش الله من قوم مكارمهم % وفضل جودهم كالطوق في جيدي % % 19(@)(@@) % ما عشت لا أتعاطى غير حبهم ، % وهل سمعتم بشرك بعد توحيد % PageV01P667 البحر : كامل تام 1(@)(@@) % لو صرت من سقمي شبيه سواك ، % ما اخترت من دون 