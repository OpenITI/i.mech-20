ms39	 تفسد من اللئيم بقدر ما تصلح من الكريم(@)(@)(@@)(@@)(@@) ||| 2103(@)(@)(@@) @HAD015 ألجاهل صخرة لا ينفجر مائها وشجرة لا يخضر عودها وأرض لا يظهر عشبها(@)(@)(@@)(@@)(@@) ||| 2104(@)(@)(@@) @HAD023 ألناس طالبان طالب ومطلوب فمن طلب الدنيا طلبه الموت حتى يخرجه عنها ومن طلب الآخرة طلبته الدنيا حتى يستوفي رزقه منها(@)(@)(@@)(@@)(@@) ||| 2105(@)(@)(@@) @HAD011 ألأمانة والوفاء صدق الأفعال والكذب والإفتراء خيانة الأقوال(@)(@)(@@)(@@)(@@) ||| 2106(@)(@)(@@) @HAD018 ألبخيل يسمح من عرضه بأكثر مما أمسك من عرضه ويضيع من دينه أضعاف ما حفظ من نسبه(@)(@)PageV01P117(@)(@)(@@)(@@)(@@) ||| 2107(@)(@)(@@) @HAD019 ألراضي بفعل قوم كالداخل فيه معهم ولكل داخل في باطل اثمان إثم الرضا به واثم العمل به(@)(@)(@@)(@@)(@@) ||| 2108(@)(@)(@@) @HAD021 ألأجل محتوم والرزق مقسوم فلا يغمن أحدكم إبطاؤه فإن الحرص لا يقدمه والعفاف لا يؤخره والمؤمن بالتحمل خليق(@)(@)(@@)(@@)(@@) ||| 2109(@)(@)(@@) @HAD025 ألناس ثلاثة فعالم ربانى ومتعلم على سبيل نجاة وهمج رعاع أتباع كل ناعق لم يستضيئوا بنور العلم ولم يلجؤا إلى ركن وثيق(@)(@)(@@)(@@)(@@) ||| 2110(@)(@)(@@) @HAD018 ألراضي عن نفسه مستور عنه عيبه ولو عرف فضل غيره لساءه ما به من النقص والخسران(@)(@)(@@)(@@)(@@) ||| 2111(@)(@)(@@) @HAD014 ألمرء بأصغريه بقلبه ولسانه إن قاتل قاتل بجنان وان نطق نطق ببيان(@)(@)(@@)(@@)(@@) ||| 2112(@)(@)(@@) @HAD023 ألنعمة موصولة بالشكر والشكر موصول بالمزيد وهما مقرونان في قرن فلن ينقطع المزيد من الله تعالى حتى ينقطع الشكر من الشاكر(@)(@)(@@)(@@)(@@) ||| 2113(@)(@)(@@) @HAD019 ألذكر ليس من مراسم اللسان ولا من مناسم الفكر ولكنه أول من المذكور وثان من الذاكر(@)(@)(@@)(@@)(@@) ||| 2114(@)(@)(@@) @HAD013 ألعقل خليل المؤمن والعلم وزيره والصبر أمير جنوده والعمل قيمه(@)(@)(@@)(@@)(@@) ||| 2115(@)(@)(@@) @HAD08 ألزمان يخون صاحبه ولا يستعتب لمن عاتبه(@)(@)PageV01P118(@)(@)(@@)(@@)(@@) ||| 2116(@)(@)(@@) @HAD015 ألإيمان والعمل أخوان تؤأمان ورفيقان لا يفترقان لا يقبل الله أحدهما إلا بصاحبه(@)(@)(@@)(@@)(@@) ||| 2117(@)(@)(@@) @HAD09 ألمذلة والمهانة والشقاء في الطمع والحرص(@)(@)(@@)(@@)(@@) ||| 2118(@)(@)(@@) @HAD07 ألصبر على مضض الغصص يوجب الظفر بالفرص(@)(@)(@@)(@@)(@@) ||| 2119(@)(@)(@@) @HAD07 ألناس كالشجر شرابه واحد وثمره مختلف(@)(@)(@@)(@@)(@@) ||| 2120(@)(@)(@@) @HAD08 ألطمع مورد غير مصدر وضامن غير موف(@)(@)(@@)(@@)(@@) ||| 2121(@)(@)(@@) @HAD018 ألعقل صاحب جيش الرحمن والهوى قائد جيش الشيطان والنفس متجاذبة بينهما فأيهما غلب كانت في حيزه(@)(@)(@@)(@@)(@@) ||| 2122(@)(@)(@@) @HAD021 ألعقل والشهوة ضدان ومؤيد العقل العلم ومؤين الشهوة الهوى والنفس متنازعة بينهما فأيهما قهر كانت في جانبه(@)(@)(@@)(@@)(@@) ||| 2123(@)(@)(@@) @HAD011 ألسيد 
ms40	 من لا يصانع ولا يخادع ولا تغره المطامع(@)(@)(@@)(@@)(@@) ||| 2124(@)(@)(@@) @HAD013 ألعلم علمان مطبوع ومسموع ولا ينفع المطبوع إذا لم يك مسموع(@)(@)(@@)(@@)(@@) ||| 2125(@)(@)(@@) @HAD023 ألمؤمن دأبه زهادته وهمه ديانته وعزه قناعته وجده لآخرته قد كثرت حسناته وعلت درجاته وشارف خلاصه ونجاته(@)(@)(@@)(@@)(@@) ||| 2126(@)(@)(@@) @HAD07 ألكذاب والميت سواء فإن فضيلة الحي(@)(@)PageV01P119(@)(@)(@@) @HAD010 على الميت ألثقة به فإذا لم يوثق بكلامه بطلت حياته(@)(@)(@@)(@@)(@@) ||| 2127(@)(@)(@@) @HAD016 ألحاسد يظهر وده في أقواله ويخفي بغضه في أفعاله فله إسم الصديق وصفة العدو(@)(@)(@@)(@@)(@@) ||| 2128(@)(@)(@@) @HAD027 ألنفس الأمارة المسولة تتملق تملق المنافق وتتصنع بشيمة الصديق الموافق حتى اذا خدعت وتمكنت تسلطت تسلط العدو وتحكمت تحكم العتو وأوردت موارد السوء(@)(@)(@@)(@@)(@@) ||| 2129(@)(@)(@@) @HAD013 ألحكماء أشرف الناس أنفسا وأكثرهم صبرا وأسرعهم عفوا وأوسعهم أخلاقا(@)(@)(@@)(@@)(@@) ||| 2130(@)(@)(@@) @HAD09 ألعلماء أطهر الناس أخلاقا وأقلهم في المطامع أعراقا(@)(@)(@@)(@@)(@@) ||| 2131(@)(@)(@@) @HAD011 ألأنس في ثلاثة الزوجة الموافقة والولد البار والأخ الموافق(@)(@)(@@)(@@)(@@) ||| 2132(@)(@)(@@) @HAD023 ألسؤال يضعف لسان المتكلم ويكسر قلب الشجاع البطل ويوقف الحر العزيز موقف العبد الذليل ويذهب بهاء الوجه ويمحق الرزق(@)(@)(@@)(@@)(@@) ||| 2133(@)(@)(@@) @HAD017 ألطعام يؤكل على ثلاثة أضرب مع الإخوان بالسرور ومع الفقراء بالإيثار ومع أبناء الدنيا بالمروة(@)(@)(@@)(@@)(@@) ||| 2134(@)(@)(@@) @HAD012 ألمروءة العدل في الإمرة والعفو مع القدرة والمواساة مع العسرة(@)(@)PageV01P120(@)(@)(@@)(@@)(@@) ||| 2135(@)(@)(@@) @HAD06 ألذل بعد العزل يوازي عز الولاية(@)(@)(@@)(@@)(@@) ||| 2136(@)(@)(@@) @HAD012 ألحازم من شكر النعمة مقبلة وصبر عنها وسلاها مولية مدبرة(@)(@)(@@)(@@)(@@) ||| 2137(@)(@)(@@) @HAD05 ألمتعدي كثير الأضداد والأعداء(@)(@)(@@)(@@)(@@) ||| 2138(@)(@)(@@) @HAD05 المنصف كثير الأولياء والأوداء(@)(@)(@@)(@@)(@@) ||| 2139(@)(@)(@@) @HAD04 ألعالم حي بين الموتى(@)(@)(@@)(@@)(@@) ||| 2140(@)(@)(@@) @HAD04 ألجاهل ميت بين الأحياء(@)(@)(@@)(@@)(@@) ||| 2141(@)(@)(@@) @HAD05 ألإخوان جلاء الهموم والأحزان(@)(@)(@@)(@@)(@@) ||| 2142(@)(@)(@@) @HAD06 ألصدق جمال الإنسان ودعامة الإيمان(@)(@)(@@)(@@)(@@) ||| 2143(@)(@)(@@) @HAD03 ألشهوات مصائد الشيطان(@)(@)(@@)(@@)(@@) ||| 2144(@)(@)(@@) @HAD07 ألحياء من الله سبحانه يقي عذاب النار(@)(@)(@@)(@@)(@@) ||| 2145(@)(@)(@@) @HAD09 ألفكر يوجب الإعتبار ويؤمن العثار ويثمر الإستظهار(@)(@)(@@)(@@)(@@) ||| 2146(@)(@)(@@) @HAD06 ألتهجم على المعاصي يوجب عذاب النار(@)(@)(@@)(@@)(@@) ||| 2147(@)(@)(@@) @HAD07 ألغفلة تكسب الإغترار وتدني من البوار(@)(@)(@@)(@@)(@@) ||| 2148(@)(@)(@@) @HAD018 ألمؤمن ينظر إلى الدنيا بعين الإعتبار ويقتات فيها ببطن الإضطرار ويسمع فيها بأذن المقت والإبغاض(@)(@)(@@)(@@)(@@) ||| 2149(@)(@)(@@) @HAD015 ألجلوس فى المسجد من بعد طلوع الفجر إلى حين طلوع الشمس للإشتغال بذكر الله سبحانه(@)(@)PageV01P121(@)(@)(@@) @HAD09 أسرع في تيسير الرزق من الضرب في أقطار الأرض(@)(@)(@@)(@@)(@@) ||| 2150(@)(@)(@@) @HAD013 ألعبادة الخالصة أن لا 