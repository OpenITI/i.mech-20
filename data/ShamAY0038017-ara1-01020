ms1001	 عليه وسلم يقول: " يخرج قوم يقرءون القرآن لا يجاوز حناجرهم يمرقون من الدين كما يمرق السهم من الرمية. "(@)(@@)(@@)(@@) ||| AUTO سويد الحاجب المهري(@)(@@) من أهل مصر، يروي عن أبي الخير مرثد بن عبد الله اليزني، روى عنه عمرو بن الحارث.(@)(@@)(@@)(@@) ||| AUTO سويد، أبو الخطاب الفريعي(@)(@@) يروي عن إياس بن سلمة بن الأكوع، روى عنه حبان بن هلال، وموسى بن إسماعيل التبوذكي.(@)(@@)(@@)(@@) ||| AUTO السائب(@)(@@) مولى عائشة بنت عثمان، يروي عن عروة بن الزبير، روى عنه عثمان بن مرة الليثي.(@)(@@)(@@)(@@) ||| AUTO السائب بن حبيش الكلاعي(@)(@@) يروي عن معدان بن أبي طلحة البصري، عن أبي الدرداء، روى عنه زائدة بن قدامة، وأهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO السائب الطائفي(@)(@@) يروي عن يزيد بن عامر: المراسيل، روى عنه ابنه سعيد بن السائب.(@)(@@)(@@)(@@) ||| AUTO السائب بن عمر بن عبد الرحمن بن السائب المخزومي(@)(@@) يروي عن أبي مليكة، روى عنه وكيع، وأبو نعيم.(@)(@@)(@@)(@@) ||| AUTO سليم بن أذنان النخعي(@)(@@) يروي عن علقمة، روى عنه الحكم، وأبو إسحاق.(@)(@@)(@@)(@@) ||| AUTO سليم، أبو عبد الله المكي(@)(@@) يروي عن مجاهد، روى عنه الحجازيون.(@)(@@)(@@)(@@) ||| AUTO سليم بن شداد(@)(@@) يروي عن الربيع بن خثيم، روى عنه عمرو بن ثابت.(@)PageV01P002(@)(@@) [ج 3: ص 419](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO سليم، أبو اليسع(@)(@@) مولى أبي خليفة العبدي، من أهل البصرة، يروي عن الحسن، روى عنه عون بن موسى.(@)(@@) سليم(@)(@@) مولى الشعبي، كنيته أبو سلمة، كوفي، يروي عن الشعبي، روى عنه عفيف بن سالم، ومحمد بن دينار الطاحي.(@)(@@)(@@)(@@) ||| AUTO سليم بن الحارث بن سليم الهجيمي(@)(@@) أخو خالد بن الحارث، من أهل البصرة، يروي عن جهضم بن الضحاك، عن العداء بن خالد بن هوذة، روى عنه قيس بن حفص الدارمي.(@)(@@)(@@)(@@) ||| AUTO سليم بن الأخضر(@)(@@) من أهل البصرة، يروي عن حميد الطويل، روى عنه ابن مهدي، والبصريون، مات سنة ثمانين ومائة.(@)(@@)(@@)(@@) ||| AUTO سليم بن عثمان، أبو عثمان الطائي(@)(@@) يروي عن جماعة، من أهل الشام، روى عنه سليمان بن سلمة الخبائري: الأعاجيب الكثيرة، ولست أعرفه بعدالة ولا جرح، ولا له راو غير سليمان، وسليمان ليس بشيء، فإن وجد 
ms1002	 له راو غير سليمان بن سلمة اعتبر حديثه ويلزق به ما يتأهله من جرح أو عدالة.(@)(@@)(@@)(@@) ||| AUTO سلام(@)(@@)(@@)(@@) ||| AUTO شيخ يروي عن الحسن، روى عنه سعيد بن أبي عروبة، وإن لم يكن سلام بن تميم فلا أدري من هو.(@)(@@)(@@)(@@) ||| AUTO سلام بن كركرة(@)(@@) يروي عن عمرو بن دينار، روى عنه محمد بن إسحاق.(@)(@@)(@@)(@@) ||| AUTO سلام الليثي(@)(@@) والد القاسم بن سلام، يروي عن عبد الله بن بريدة، روى عنه يحيى بن واضح.(@)(@@) سلام بن تميم(@)(@@) يروي عن الحسن، روى عنه سعيد بن أبي عروبة.(@)PageV01P002(@)(@@) [ج 3: ص 420](@)(@@)(@@)(@@) ||| AUTO سلام بن عبد الله، أبو حفص(@)(@@) من أهل البصرة، يروي عن أبي العلاء بن الشخير، روى عنه التبوذكي.(@)(@@)(@@)(@@) ||| AUTO سلام بن مسكين الأزدي(@)(@@) من أهل البصرة، كنيته أبو روح، يروي عن الحسن، روى عنه مسلم، وأبو نعيم، مات سنة أربع وستين ومائة، وقد قيل: سنة سبع وستين ومائة.(@)(@@)(@@)(@@) ||| AUTO سلام بن سليمان، أبو المنذر القاري(@)(@@) مولى معقل بن يسار، من أهل البصرة، يروي عن ثابت، وعاصم بن بهدلة وحماد بن أبي سليمان، روى عنه زيد بن الحباب، وعفان، وكان يخطئ، وليس هذا بسلام الطويل، ذاك ضعيف، وهذا صدوق.(@)(@@)(@@)(@@) ||| AUTO سلام بن سليم، أبو الأحوص الحنفي(@)(@@) من أهل الكوفة، يروي عن أبي إسحاق، ومنصور، روى عنه قتيبة بن سعيد، وأهل العراق، مات سنة تسع وسبعين ومائة.(@)(@@)(@@)(@@) ||| AUTO أبو رجاء(@)(@@) مولى أبي قلابة، اسمه سلمان، من أهل البصرة، يروي عن أبي قلابة، روى عنه أيوب، وابن عون، وحميد الطويل.(@)(@@)(@@)(@@) ||| AUTO سلمان الشامي(@)(@@) يروي عن جنادة بن أبي أمية، روى عنه عاصم الأحول.(@)(@@)(@@)(@@) ||| AUTO سلمان بن عتبان، أبو الرمكاء(@)(@@) يروي عن نعيم بن أبي هند، عن علي، روى عنه محمد بن طلحة.(@)PageV01P002(@)(@@) [ج 3: ص 421](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO سهيل بن أبي صالح السمان(@)(@@) واسم أبي صالح: ذكوان، مولى جويرية بنت الأحمس الغطفانية، من أهل المدينة، يروي عن ابن المسيب، وأبي صالح أبيه، روى عنه مالك الثوري، وشعبة، وكان يخطئ، مات سهيل في ولاية أبي جعفر.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO سهيل بن 
ms1003	 عمرو القرشي(@)(@@) يروي عن سعيد بن المسيب، روى عنه شعبة.(@)(@@)(@@)(@@) ||| AUTO سهيل بن أبي الجعد(@)(@@) مولى الأنصار، كنيته أبو الأحدل، يروي عن عروة بن الزبير، والمقبري، روى عنه سعيد بن أبي أيوب، وحيوة بن شريح.(@)(@@)(@@)(@@) ||| AUTO سهيل بن ذراع(@)(@@) كان قاضيا بالشام، يروي المقاطيع، روى عنه عاصم بن كليب.(@)(@@) سهيل بن عمرو(@)(@@) شيخ يروي عن أبيه، روى عنه همام بن يحيى، لا أدري من هو ولا من أبوه.(@)(@@) سهيل(@)(@@) شيخ يروي عن الحسن، روى عنه ابن عجلان.(@)(@@)(@@)(@@) ||| AUTO سهيل بن حسان، أبو السحماء الكلبي(@)(@@) من أهل مصر، يروي عن أبي قبيل، وكعب بن علقمة، روى عنه الليث بن سعد، وخالد بن حميد.(@)(@@)(@@)(@@) ||| AUTO سهيل بن أبي سهيل المدني العابد(@)(@@) يروي عن أبيه، عن عائشة، روى عنه عمرو بن الحارث.(@)PageV01P002(@)(@@) [ج 3: ص 422](@)(@@)(@@)(@@) ||| AUTO سلم بن عبد الرحمن النخعي(@)(@@) أخو حصين بن عبد الرحمن، من أهل الكوفة، يروي عن أبي زرعة بن عمرو بن جرير، عن أبي هريرة، روى عنه سفيان الثوري.(@)(@@)(@@)(@@) ||| AUTO سلم بن عطية(@)(@@) من أهل الكوفة، يروي عن مجاهد، وعبد الله بن أبي الهذيل، روى عنه محمد بن قيس الأسدي، وشعبة.(@)(@@)(@@)(@@) ||| AUTO سلم بن يسار(@)(@@) مولى الحارث بن سعد بن أبي ذباب المدني، يروي عن المدنيين، روى عنه سعيد بن مسلم بن بانك.(@)(@@)(@@)(@@) ||| AUTO سلم بن أبي الذيال(@)(@@) من أهل البصرة، يروي عن الحسن، وابن سيرين، وكان متقنا، روى عنه المعتمر بن سليمان.(@)(@@) (333) -[3: 422] حدثنا ابن قتيبة، قال: ثنا ابن أبي السري، قال: ثنا معتمر بن سليمان، قال: ثنا سلم بن أبي الذيال، عن محمد بن سيرين، عن أبي هريرة، قال: قال رجل للنبي صلى الله عليه وسلم أصلي في ثوب واحد، فقال النبي صلى الله عليه وسلم: أوكلكم يجد ثوبين.(@)(@@)(@@)(@@) ||| AUTO سلم بن بشير بن جحل القيسي(@)(@@) من أهل البصرة، يروي عن عكرمة، وعبد العزيز بن صهيب، روى عنه رقبة مسقلة، وأبو عاصم العباداني، وهو الذي يروي عن أبي هريرة ولم يره، بينه وبينه عكرمة.(@)(@@)(@@)(@@) ||| AUTO سلم بن قتيبة 
ms1004	 بن مسلم بن عمرو بن حصين الباهلي(@)(@@) من أهل البصرة، وكان على خراسان، يروي عن عمرو بن دينار، روى عنه ابنه سعيد بن سلم بن قتيبة.(@)(@@)(@@)(@@) ||| AUTO سلم بن إبراهيم الوراق(@)(@@) يروي عن عكرمة بن عمار، روى عنه محمد بن يحيى الذهلي.(@)PageV01P002(@)(@@) [ج 3: ص 423](@)(@@)(@@)(@@) ||| AUTO سلم بن زرير العطاردي(@)(@@) يروي عن أبي رجاء العطاردي، روى عنه عبيد الله بن عبد المجيد الحنفي.(@)(@@)(@@)(@@) ||| AUTO سيار بن قيس(@)(@@) وقد قيل: سنان بن قيس، من أهل الشام، يروي عن خالد بن معدان، روى عنه معاوية بن صالح.(@)(@@)(@@)(@@) ||| AUTO سيار، أبو حمزة(@)(@@) من أهل الكوفة، يروي عن قيس بن أبي حازم، روى عنه عبد الملك بن سعيد بن أبجر.(@)(@@)(@@)(@@) ||| AUTO سيار بن أبي سيار، أبو الحكم الواسطي العنزي(@)(@@) أخو مساور الوراق لأمه، واسم أبي سيار: وردان، يروي عن طارق بن شهاب، والشعبي، روى عنه عبيد الله بن عمر العمري، وبشير بن سلمان، وهشيم، والعراقيون.(@)(@@)(@@)(@@) ||| AUTO سيار بن عبد الرحمن الصدفي(@)(@@) يروي عن يزيد بن قوذر، روى عنه سعيد بن أبي أيوب، والليث بن سعد.(@)(@@)(@@)(@@) ||| AUTO سيار بن عبد الله، شامي(@)(@@) يروي عن أبي إدريس الخولاني، قدم البصرة فحدثهم بها، روى عنه سليمان التيمي، قال: حدثنا ابن قتيبة، قال: ثنا ابن أبي السري، قال: ثنا معتمر، عن أبيه، عن سيار، عن أبي إدريس الخولاني، أنه قال: إن الذي يتعلم هذه الأحاديث ليرائي بها الناس لا يرح رائحة الجنة.(@)(@@)(@@)(@@) ||| AUTO سوار بن داود، أبو حمزة(@)(@@) يروي عن ثابت البناني، وعمرو بن شعيب، PageV01P002 [ج 3: ص 424] روى عنه ابن المبارك، والنضر بن شميل، يخطئ.(@)(@@)(@@)(@@) ||| AUTO سوار بن حكيم الخراساني(@)(@@) ختن عطاء بن أبي رباح، يروي عن عطاء، روى عنه ابن عيينة.(@)(@@)(@@)(@@) ||| AUTO سوار الجرمي(@)(@@) من أهل البصرة، يروي عن أبي قلابة، روى عنه ابنه قتادة بن سوار.(@)(@@)(@@)(@@) ||| AUTO سوار الكندي(@)(@@) من أهل الكوفة، يروي عن موسى بن طلحة، روى عنه ابنه أشعث بن سوار.(@)(@@)(@@)(@@) ||| AUTO سوار بن عبد الله(@)(@@) شيخ يروي عن رفيع أبي العالية، روى عنه عكرمة 
ms1005	 بن عمار.(@)(@@)(@@)(@@) ||| AUTO سوار بن عبد الله بن قدامة العنبري القاضي(@)(@@) من أهل البصرة، كنيته أبو عبد الله، يروي عن الحسن، وبكر بن عبد الله المزني، وكان فقيها، روى عنه أهل البصرة، وابنه عبد الله بن سوار، مات في ذي القعدة سنة ست وخمسين ومائة، وهو يومئذ أمير البصرة وقاضيها، وكان قد ولاه أبو جعفر القضاء سنة ثمان وثلاثين ومائة، وبقي على القضاء إلى أن مات.(@)(@@)(@@)(@@) ||| AUTO سوار بن عبد الله، أبو سنان الهذلي(@)(@@) من أهل البصرة، يروي عن الحسن، روى عنه أبو عبيدة الحداد، ليس هذا بسوار القاضي.(@)(@@)(@@)(@@) ||| AUTO سوار الشقري(@)(@@) يروي عن قدامة بن حماطة، عن أبي هريرة، روى عنه أبو يحيى الحماني.(@)(@@)(@@)(@@) ||| AUTO سنان بن قيس(@)(@@) من أهل الشام، يروي عن خالد بن معدان، روى عنه معاوية بن صالح.(@)PageV01P002(@)(@@) [ج 3: ص 425](@)(@@)(@@)(@@) ||| AUTO سنان(@)(@@) مولى عروة بن الزبير، يروي عن عروة، وكان عاملا لعمر بن عبد العزيز، روى عنه سفيان الثوري.(@)(@@)(@@)(@@) ||| AUTO سنان بن الحارث بن مصرف(@)(@@) يروي عن عمه طلحة بن مصرف، روى عنه القاسم بن الوليد الهمداني.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO سيف، أبو عائذ الأزدي(@)(@@) يروي عن يزيد بن البراء عن البراء، روى عنه سعيد بن إياس الجريري.(@)(@@)(@@)(@@) ||| AUTO سيف بن عبد الحميد بن محمود(@)(@@) يروي عن أبيه، عن ابن عباس، روى عنه هشام بن حسان.(@)(@@) سيف(@)(@@) شيخ يروي عن رشيد الهجري، روى عنه الحكم بن عتيبة.(@)(@@)(@@)(@@) ||| AUTO سيف بن سليمان، كنيته أبو سليمان(@)(@@) مولى بني مخزوم، من أهل مكة، وهو الذي يقال له: سيف بن أبي سليمان، يروي عن مجاهد، وقيس بن سعد، روى عنه الثوري، وعبد الله بن الحارث المخزومي، وأبو نعيم، مات سنة ست وخمسين ومائة، وكان يسكن البصرة في آخر عمره.(@)(@@)(@@)(@@) ||| AUTO سيف بن خليد(@)(@@) يروي عن أبيه، عن علي، روى يحيى بن سعيد الأموي، عن أبيه، عنه.(@)(@@)(@@)(@@) ||| AUTO سيف بن ميسرة(@)(@@) من أهل الكوفة، يروي عن أبي سعيد، عن الزبير، روى عنه وكيع بن الجراح.(@)PageV01P002(@)(@@) [ج 3: ص 426](@)(@@)(@@)(@@) ||| AUTO سيف(@)(@@) شيخ يروي عن أبي 
ms1006	 وائل، روى عنه شعبة بن الحجاج.(@)(@@)(@@)(@@) ||| AUTO سماك بن الفضل الخولاني اليماني(@)(@@) من أهل صنعاء، يروي عن وهب بن منبه، روى عنه معمر بن راشد.(@)(@@)(@@)(@@) ||| AUTO سماك بن عبيد(@)(@@) يروي عن عطاء، روى عنه سفيان الثوري.(@)(@@)(@@)(@@) ||| AUTO سماك بن عطية المربدي(@)(@@) من أهل البصرة، يروي عن الحسن، وأيوب، روى عنه حماد بن زيد.(@)(@@)(@@)(@@) ||| AUTO سماك بن عمران بن مسلم(@)(@@) يروي عن الحسن، روى عنه البصريون.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO السري بن عبد الرحمن الحجازي(@)(@@) يروي عن عباد بن حمزة، عن جابر بن عبد الله، روى عنه موسى بن يعقوب الزمعي.(@)(@@) السري بن عبد الرحمن(@)(@@) من أهل البصرة، يروي عن بكر بن عبد الله المزني، روى عنه أبو معاوية الضرير.(@)(@@)(@@)(@@) ||| AUTO السري بن معارك(@)(@@) من أهل الكوفة، يروي عن إبراهيم النخعي، روى عنه المغيرة بن مقسم.(@)(@@)(@@)(@@) ||| AUTO السري بن ينعم الجبلاني(@)(@@) من أهل الشام، يروي عن عمرو بن قيس، ومريح بن مسروق الهوزني، والشاميين، روى عنه محمد بن حرب الأبرش، وبقية بن الوليد.(@)(@@)(@@)(@@) ||| AUTO السري بن يحيى الشيباني(@)(@@) من أهل البصرة، كنيته أبو يحيى، وقد PageV01P002 [ج 3: ص 427] قيل: أبو الهيثم، يروي عن الحسن، وثابت، روى عنه مسلم بن إبراهيم، مات سنة تسع وستين ومائة بمكة، وكان عاقلا.(@)(@@)(@@)(@@) ||| AUTO السكن بن أبي خالد الأعرابي(@)(@@) صاحب الغنم، يروي عن الحسن، وأبي نعامة، روى عنه هشام بن حسان، وقد بقي إلى أن كتب عنه قتيبة بن سعيد.(@)(@@)(@@)(@@) ||| AUTO السكن بن أبي كريمة(@)(@@) يروي عن الزهري، ومحمد بن عباد بن جعفر، روى عنه محمد بن إسحاق.(@)(@@)(@@)(@@) ||| AUTO السكن بن أبي المغيرة القرشي(@)(@@) مولى عثمان بن عفان، كنيته أبو محمد، يروي عن الحسن، روى عنه عثمان بن عمر، وأبو داود الطيالسي.(@)(@@)(@@)(@@) ||| AUTO السكن بن أبي السكن البرجمي(@)(@@) واسم أبي السكن: سليمان، يروي عن حميد الطويل، ويونس بن عبيد، روى عنه أزهر بن جميل، والبصريون.(@)(@@)(@@)(@@) ||| AUTO سوادة بن مسعود بن سهل(@)(@@) يروي عن الحسن، روى عنه التبوذكي.(@)(@@)(@@)(@@) ||| AUTO سوادة البرجمي(@)(@@) يروي المقاطيع، روى عنه صفوان بن عمرو السكسكي.(@)(@@)(@@)(@@) ||| AUTO 
ms1007	 سوادة بن الصباح الكندي(@)(@@) من أهل الرها، يروي عن الجريريين، روى عنه أهل بلده، وأحسبه الذي يقال له: سوادة الرقي الذي يروي عن أبي الحصين.(@)(@@)(@@)(@@) ||| AUTO سوادة بن أبي الجعد(@)(@@) أخو عمران، وإبراهيم، يروي عن أبي جعفر محمد بن علي، روى عنه مطرف بن طريف.(@)PageV01P002(@)(@@) [ج 3: ص 428](@)(@@)(@@)(@@) ||| AUTO سوادة بن حيان التميمي، أبو عتبة(@)(@@) يروي عن معاوية بن قرة، روى عنه زيد بن الحباب، وداود بن المحبر.(@)(@@)(@@)(@@) ||| AUTO سوادة بن أبي العالية القطعي(@)(@@) من أهل البصرة، يروي عن الحسن، روى عنه موسى بن إسماعيل التبوذكي.(@)(@@)(@@)(@@) ||| AUTO سميع بن زاذان(@)(@@) يروي عن هنيدة بنت قيس، عن عائشة، روى عنه وكيع بن الجراح.(@)(@@)(@@)(@@) ||| AUTO سبرة بن عبد الله بن حنش الكوفي(@)(@@) قدم البصرة، وحدثهم بها، يروي عن أبيه، عن البراء، وابن عمر، روى عنه التبوذكي.(@)(@@)(@@)(@@) ||| AUTO سحيم بن هانئ، جليس الأوزاعي(@)(@@) يروي عن طاوس، قال: ما رأيته إلا مقنعا باكيا. روى عنه محمد بن مصعب القرقساني.(@)(@@)(@@)(@@) ||| AUTO سليط بن أيوب الأنصاري(@)(@@) من أهل المدينة، يروي عن القاسم بن محمد، روى عنه ابن إسحاق.(@)(@@)(@@)(@@) ||| AUTO سليط بن عبد الله(@)(@@) يروي عن بهية، روى عنه الحجاج بن أرطأة.(@)(@@)(@@)(@@) ||| AUTO سهم بن منجاب الضبي(@)(@@) من أهل الكوفة، يروي عن قزعة، عن أبي سعيد، وعن القرثع، عن أبي أيوب، روى عنه إبراهيم بن يزيد النخعي، وأبو سنان، ضرار بن مرة.(@)(@@)(@@)(@@) ||| AUTO سهم بن شقيق(@)(@@) يروي عن عامر بن عبد قيس، روى عنه الوليد، أبو بشر.(@)(@@)(@@)(@@) ||| AUTO سهم بن يزيد الحمراوي، مصري(@)(@@) يروي عن المدنيين، وعمر بن عبد العزيز، روى عنه حيوة بن شريح.(@)PageV01P002(@)(@@) [ج 3: ص 429](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO سهم بن المعتمر(@)(@@) يروي عن الهجيمي، روى عنه عبد الملك بن الحسن الجاري.(@)(@@) سهم(@)(@@) مولى بني سليم، يروي عن مولاته، عن عائشة، روى عنه التبوذكي.(@)(@@)(@@)(@@) ||| AUTO سعدان بن سالم الأيلي، أبو الصباح(@)(@@) يروي عن يزيد بن أبي سمية، روى عنه ابن المبارك.(@)(@@) (334) -[3: 429] ثنا ابن قتيبة، قال: ثنا أبو عمير النحاس، قال: ثنا ضمرة عن سعدان بن سالم الأيلي عن 
ms1008	 يزيد بن أبي سمية، قال: سمعت ابن عمر، يقول: " ما قال رسول الله صلى الله عليه وسلم في الإزار فهو في القميص. "(@)(@@)(@@)(@@) ||| AUTO سعدان بن يحيى بن صالح اللخمي(@)(@@) الكوفي، كنيته أبو يحيى، سكن دمشق، يروي عن إسماعيل بن أبي خالد، روى عنه سليمان بن عبد الرحمن، وهشام بن عمار، وقد قيل: إن اسمه سعيد، وسعدان: لقب.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO سريع(@)(@@) مولى سوادة بن الربيع الجرمي، يروي عن سوادة بن الربيع، روى عنه سلم بن عبد الرحمن.(@)(@@) سريع(@)(@@) شيخ يروي عن وهب بن منبه، روى عنه أبو قتيبة سلم بن قتيبة.(@)(@@)(@@)(@@) ||| AUTO سعر بن نقادة الأسدي(@)(@@) يروي عن نقادة، روى عنه ابنه عاصم بن سعر.(@)(@@)(@@)(@@) ||| AUTO سكين بن عبد العزيز بن قيس القطان(@)(@@) من أهل البصرة، يروي عن سيار بن سلامة، وأبيه، روى عنه موسى بن إسماعيل.(@)PageV01P002(@)(@@) [ج 3: ص 430](@)(@@)(@@)(@@) ||| AUTO سكين بن يزيد، أبو قبيصة المجاشعي(@)(@@) يروي عن ميمون بن مهران، وعبد الله بن عبيد بن عمير، روى عنه العراقيون.(@)(@@)(@@)(@@) ||| AUTO سميط بن عجلان(@)(@@) بصري، يروي عن مؤذن بني عدي، روى عنه الصعق بن حزن، وليس هذا بوالد عبد الله بن شميط، ذاك بالشين، وهذا بالسين.(@)(@@)(@@)(@@) ||| AUTO سمير أبو عاصم(@)(@@) قوله، روى عنه أبو الأحوص سلام بن سليم.(@)(@@)(@@)(@@) ||| AUTO سابق بن عبد الله، أبو سعيد البربري(@)(@@) من أهل بربر، سكن الرقة، يروي عن مكحول، وعمرو بن أبي عمرو، روى عنه الأوزاعي، وأهل الجزيرة، وهو الذي يروي عن سعيد بن سمعان.(@)(@@)(@@)(@@) ||| AUTO سابق، أبو سهل(@)(@@) مولى بني رفاعة، يروي عن الحسن، روى عنه يحيى بن اليمان.(@)(@@)(@@)(@@) ||| AUTO سابق بن ناجية(@)(@@) يروي عن أبي سلام، عن رجل خدم النبي صلى الله عليه وسلم روى عنه أبو عقيل هاشم بن بلال.(@)(@@)(@@)(@@) ||| AUTO سريج، أبو حرب(@)(@@) من أهل البصرة، يروي عن الأحنف بن قيس، روى عنه ابنه حرب بن سريج.(@)(@@)(@@)(@@) ||| AUTO سراج بن عقبة بن طلق بن علي الحنفي(@)(@@) من أهل اليمامة، يروي عن عمته خلدة بنت طلق، روى عنه ملازم بن عمرو، وقد قيل: 
ms1009	 إن اسم عمته جعدة.(@)(@@)(@@)(@@) ||| AUTO سفر بن نسير الأزدي(@)(@@) يروي عن يزيد بن شريح الحضرمي، عن أبي أمامة، روى عنه معاوية بن صالح.(@)PageV01P002(@)(@@) [ج 3: ص 431](@)(@@)(@@)(@@) ||| AUTO سقر بن حبيب الغنوي(@)(@@) يروي عن المدنيين، وعمر بن عبد العزيز، روى عنه الحجاج بن حسان.(@)(@@)(@@)(@@) ||| AUTO السيد بن عيسى(@)(@@) شيخ من أهل الكوفة، يروي عن أبي إسحاق السبيعي، روى عنه العلاء بن عمرو الحنفي.(@)(@@)(@@)(@@) ||| AUTO سمي، مولى أبي بكر بن عبد الرحمن بن الحارث بن هشام المخزومي القرشي(@)(@@) من أهل المدينة، يروي عن أبي صالح، وأبي بكر بن عبد الرحمن، روى عنه مالك بن أنس، وأهل المدينة، قتل سنة ثلاثين ومائة، قتله الحرورية يوم قديد.(@)(@@)(@@)(@@) ||| AUTO سمي بن قيس(@)(@@) يروي عن شمير بن عبد المدان، روى عنه ثمامة بن شراحيل.(@)(@@)(@@)(@@) ||| AUTO سعاد بن سليمان التميمي(@)(@@) يروي عن زياد بن علاقة، روى عنه سهل بن حماد، وعبد الصمد بن النعمان.(@)(@@)(@@)(@@) ||| AUTO سفاح بن مطر الشيباني(@)(@@) يروي عن داود بن كردوس الثعلبي، روى عنه أبو إسحاق الشيباني.(@)(@@)(@@)(@@) ||| AUTO سدوس الثوري، إمام الحي(@)(@@) يروي عن الربيع بن خثيم، عداده في أهل الكوفة، روى عنه الثوري.(@)PageV01P002(@)(@@) [ج 3: ص 432](@)(@@)(@@)(@@) ||| AUTO سليم بن حيان الهذلي(@)(@@) من أهل البصرة، يروي عن سعيد بن ميناء، وأبيه، روى عنه يزيد بن هارون، والبصريون.(@)(@@)(@@)(@@) ||| AUTO سعير بن الخمس التميمي(@)(@@) من أهل الكوفة، يروي عن حبيب بن أبي ثابت، روى عنه عثام بن علي، كان قد مرض مرضه، فغشي عليه، فصيح به، وتوهموا أنه مات، وغسل وكفن، فلما أن وضع على النعش تحرك، فرد إلى منزله، فبرأ وعاش، وولد له بعد ذلك مالك بن سعير ابنه.(@)(@@)(@@)(@@) ||| AUTO سداد، أبو الحسن الجعفي(@)(@@) من أهل الكوفة، يروي عن أم فاطمة، روى عنه إسحاق بن منصور السلولي.(@)(@@)(@@)(@@) ||| AUTO سماعة(@)(@@) شيخ كوفي، يروي عن عمرو بن مرة، روى عنه الثوري.(@)(@@)(@@)(@@) ||| AUTO سقيف بن بشر العجلي(@)(@@) كوفي، يروي عن طاوس، روى عنه يعلى، ومحمد ابنا عبيد الطنافسي.(@)(@@)(@@)(@@) ||| AUTO السقعب بن زهير(@)(@@) يروي عن زيد بن أسلم، روى عنه جرير 
ms1010	 بن حازم.(@)(@@)(@@)(@@) ||| AUTO سرور بن المغيرة بن زاذان السلمي(@)(@@) ابن أخي منصور بن زاذان، كنيته أبو عامر، ويقال: أبو العباس، أصله من البصرة، سكن واسط، يروي عن سليمان التيمي، روى عنه الواسطيون.(@)(@@)(@@)(@@) ||| AUTO سندي بن شماس السمان(@)(@@) يروي عن عطاء، وابن سيرين، روى عنه موسى بن إسماعيل التبوذكي.(@)(@@)(@@)(@@) ||| AUTO السقف(@)(@@) شيخ يروي عن عطاء، روى عنه هشام بن حسان.(@)PageV01P002(@)(@@) [ج 3: ص 433](@)(@@)(@@)(@@) || AUTO باب الشين(@)(@@) قال أبو حاتم، رضي الله عنه:(@)(@@) وممن شافه التابعين وروى عنهم ممن ابتدأ اسمه على الشين:(@)(@@)(@@)(@@) ||| AUTO شعيب بن محمد بن عبد الله بن عمرو بن العاص(@)(@@) يروي عن أبيه، لا يصح له سماع من عبد الله بن عمرو، وروى عنه ابنه عمرو بن شعيب.(@)(@@)(@@)(@@) ||| AUTO شعيب بن درهم(@)(@@) أبو درهم، مولى لقريش، يروي عن أبي رجاء العطاردي، وقد قيل: كنيته أبو زياد، من أهل البصرة، روى عنه المعتمر بن سليمان.(@)(@@)(@@)(@@) ||| AUTO شعيب أبو إسرائيل(@)(@@) مولى بني جشم بن معاوية، من أهل البصرة، عن جعدة بن هبيرة، روى عنه شعبة بن الحجاج.(@)(@@)(@@)(@@) ||| AUTO شعيب بن أبي منيع(@)(@@) يروي عن عيسى بن خثيم، روى عنه عكرمة بن عمار.(@)(@@)(@@)(@@) ||| AUTO شعيب بن أبي حمزة(@)(@@) مولى بني أمية، كنيته أبو بشر، من أهل حمص، واسم أبي حمزة دينار، يروي عن الزهري، ونافع، روى عنه الوليد بن مسلم، وعثمان بن سعيد القرشي، مات سنة اثنتين وستين ومائة.(@)(@@)(@@)(@@) ||| AUTO شعيب الجباي(@)(@@) من أهل اليمن، وجبأ جبل بالجند، يروي عن الحكم بن عتيبة، وكان قرأ الكتب، روى عنه محمد بن إسحاق.(@)(@@)(@@)(@@) ||| AUTO شعيب بن أبي الأشعث(@)(@@) يروي عن نافع، عن ابن عمر، روى عنه محمد بن PageV01P002 [ج 3: ص 434] حمير، وشراحيل بن عبد الحميد، وأهل الشام، يعتبر بحديثه إذا لم يكن في إسناده ضعيف ولا بقية بن الوليد.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO شعيب بن خالد الرازي(@)(@@) خال يحيى بن العلاء الرازي، يروي عن عطاء، والزهري، روى عنه عمرو بن أبي قيس.(@)(@@)(@@)(@@) ||| AUTO شعيب بن طلحة بن عبد الرحمن بن أبي بكر الصديق(@)(@@) أخو محمد 
ms1011	 بن طلحة، يروي عن أبيه، روى عنه معن بن عيسى.(@)(@@)(@@)(@@) ||| AUTO شعيب بن عبد الرحمن(@)(@@) يروي عن أبيه، عن أبي هريرة، روى عنه جهضم بن عبد الله.(@)(@@)(@@)(@@) ||| AUTO شعيب بن إسحاق الدمشقي(@)(@@) يروي عن هشام بن عروة، روى عنه هشام بن عمار، مات في رجب سنة تسع وثمانين ومائة، وكان ينتحل مذهب الرأي.(@)(@@)(@@)(@@) ||| AUTO شعيب بن محمد الغفاري(@)(@@) يروي عن محمد بن زيد بن قنفذ، عن أبي هريرة، روى عنه أبو مصعب.(@)(@@)(@@)(@@) ||| AUTO شعيب بن راشد(@)(@@) الكوفي، يروي عن أبي فزارة، روى عنه قتيبة بن سعيد.(@)(@@) شعيب(@)(@@) شيخ يروي عن أبي محمد الجزري، روى عنه معاوية بن صالح.(@)(@@)(@@)(@@) ||| AUTO شعيب الأصم(@)(@@) يروي عن أبي رجاء الدمشقي، روى عنه ثور بن يزيد.(@)(@@) شعيب(@)(@@) صاحب الطيالسة، يروي عن طاوس، وابن سيرين، عداده في أهل البصرة، روى عنه التبوذكي.(@)PageV01P002(@)(@@) [ج 3: ص 435](@)(@@)(@@)(@@) ||| AUTO شعيب بن أبي سنان(@)(@@) يروي عن الحسن، روى سعيد بن أبي أيوب، عن أبي عيسى محمد بن عبد الرحمن المؤذن الخراساني، عنه، حدثنا أحمد بن علي الصيرفي، قال: ثنا روح بن عبد المؤمن، قال: ثنا شعيب، قال: سئل طاوس عن العزل، وأنا شاهد، فقال: قد فعل ذلك من هو خير منا ومنكم.(@)(@@)(@@)(@@) ||| AUTO شعيب بن صفوان الثقفي، كنيته أبو يحيى(@)(@@) أصله من الكوفة، سكن بغداد، يروي عن عبد الملك بن عمير، روى عنه علي بن حجر السعدي، وكان كاتب ابن شبرمة، مات ببغداد في ولاية هارون، يخطئ.(@)(@@)(@@)(@@) ||| AUTO شداد بن أبي العالية(@)(@@) مولى بني ثور، كنيته أبو الفرات، يروي عن مالك الأحمري، عن حذيفة، روى عنه الثوري، وأبو حيان.(@)(@@)(@@)(@@) ||| AUTO شداد بن سعيد(@)(@@) من أهل البصرة، يروي عن أبي الوازع، عن عبد الله بن المغفل، روى عنه أبو معشر البراء، يوسف بن يزيد.(@)(@@)(@@)(@@) ||| AUTO شداد بن أبي عمرو بن حماش الليثي(@)(@@) يروي عن أبيه، روى عنه أبو اليمان الرحال.(@)(@@)(@@)(@@) ||| AUTO شداد بن عبد الرحمن(@)(@@) من ولد شداد بن أوس، يروي عن إبراهيم بن أبي عبلة، روى عنه عبد الله بن مروان 
ms1012	 بن معاوية الفزاري، مستقيم الحديث.(@)(@@)(@@)(@@) ||| AUTO شداد الضرير(@)(@@) من أهل دمشق، يروي عن أبي سلام الأسود، عن ثوبان، في الحوض، روى عنه سويد بن عبد العزيز الدمشقي.(@)PageV01P002(@)(@@) [ج 3: ص 436](@)(@@)(@@)(@@) ||| AUTO شداد بن جابان(@)(@@) يروي عن حجر المدرى، روى عنه معمر بن راشد.(@)(@@)(@@)(@@) ||| AUTO شداد القاري(@)(@@) يروي المراسيل، روى عنه يحيى بن حمزة، وهو الذي يروي عن أبي الدرداء ولم يره.(@)(@@)(@@)(@@) ||| AUTO شداد بن حي(@)(@@) أبو عبد الله، من أهل الشام، يروي عن نوف البكالي، روى عنه مهاجر النبال.(@)(@@)(@@)(@@) ||| AUTO شريح بن أرطأة النخعي(@)(@@) يروي عن الكوفيين، روى عنه أهل بلده: المقاطيع.(@)(@@)(@@)(@@) ||| AUTO شريح الشامي(@)(@@) يروي المراسيل، روى عنه عبد الملك بن أبي بشير.(@)(@@)(@@)(@@) ||| AUTO شريح بن عبيد، شامي(@)(@@) يروي عن عبد الرحمن بن جبير بن نفير، روى عنه معاوية بن صالح.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO شبيب بن حوشب(@)(@@) يروي عن القاسم بن محمد، روى عنه هشيم بن بشير.(@)(@@)(@@)(@@) ||| AUTO شبيب بن عجلان، أبو فروة(@)(@@) يروي عن الحسن، روى عنه بهز بن أسد.(@)(@@) شبيب(@)(@@) شيخ يروي عن أبي قلابة، روى عنه سليمان التيمي.(@)(@@)(@@)(@@) ||| AUTO شبيب بن شبيب(@)(@@) يروي عن جدته أم شبيب، عن عائشة، روى عنه التبوذكي.(@)(@@)(@@)(@@) ||| AUTO شبيب بن مهران، أبو زياد القسملي البصري(@)(@@) يروي عن قتادة، روى عنه المعلى بن أسد.(@)(@@)(@@)(@@) ||| AUTO شبيب بن عمر الحارثي(@)(@@) يروي عن صالح بن روبة، روى عنه مروان بن معاوية الفزاري.(@)PageV01P002(@)(@@) [ج 3: ص 437](@)(@@)(@@)(@@) ||| AUTO شبيب بن الحكم بن ميناء(@)(@@) يروي عن أبيه، عن أبي هريرة، روى عنه عبد الرحمن بن أبي الزناد.(@)(@@)(@@)(@@) ||| AUTO شهاب بن شرنفة المجاشعي العابد(@)(@@) من أهل البصرة، يروي عن الحسن، روى عنه ابن المبارك.(@)(@@)(@@)(@@) ||| AUTO شريك بن طارق(@)(@@) يروي عن فروة بن نوفل، عن عائشة، روى عنه عبد الملك بن عمير.(@)(@@)(@@)(@@) ||| AUTO شريك البرجمي(@)(@@) يروي عن زاذان، عن علي قوله، روى عنه أهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO شريك بن عبد الله بن الحارث بن أوس بن الحارث النخعي، كنيته أبو عبد الله(@)(@@) كان مولده بخراسان، قال منصور بن أبي مزاحم: سمعت شريكا، يقول: 
ms1013	 ولدت ببخارى، مقتل قتيبة بن مسلم سنة خمس وتسعين. ويروي شريك عن أبي إسحاق، وسلمة بن كهيل، روى عنه ابن المبارك، وأهل العراق، وولي القضاء بواسط سنة خمسين ومائة، ثم ولي الكوفة بعد ذلك، ومات بالكوفة سنة سبع أو ثمان وسبعين ومائة، وكان في آخر أمره يخطئ فيما يروي، تغير عليه حفظه، فسماع المتقدمين عنه الذين سمعوا منه بواسط ليس فيه تخليط، مثل: يزيد بن هارون، وإسحاق الأزرق، وسماع المتأخرين عنه بالكوفة فيه أوهام كثيرة.(@)(@@)(@@)(@@) ||| AUTO شيبة بن نصاح بن سرجس بن يعقوب(@)(@@) مولى أم سلمة، وقد قيل: سمع أم سلمة وهو صغير، وقد ذكرناه في التابعين، يروي عن ابن المسيب، والقاسم بن محمد، وكان قاضيا بالمدينة، روى عنه محمد بن إسحاق، وابن أبي الموالي، وكان إمام أهل المدينة في القراءة، ولا نعلم أحدا روى عن أبيه نصاح إلا ابنه شيبة.(@)(@@)(@@)(@@) ||| AUTO شيبة بن هشام الراسبي(@)(@@) يروي عن سالم بن عبد الله، روى عنه شعبة، وحماد بن زيد.(@)PageV01P002(@)(@@) [ج 3: ص 438](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO أبو حنيفة، شيبة بن مساور(@)(@@) يروي عن عبد الله بن عبيد بن عمير، روى عنه عبد الكريم، وعباد بن أبي على.(@)(@@)(@@)(@@) ||| AUTO شيبة بن نعامة، أبو نعامة الضبي(@)(@@) من أهل الكوفة، يروي عن العراقيين، روى عنه الثوري، وهشيم، وجرير بن عبد الحميد.(@)(@@)(@@)(@@) ||| AUTO شيبة بن الأحنف الأوزاعي(@)(@@) من أهل الشام، يروي عن أبي سلام الأسود، روى عنه الوليد بن مسلم.(@)(@@)(@@)(@@) ||| AUTO شيبة الحضرمي(@)(@@) يروي عن عروة بن الزبير، روى عنه إسحاق بن عبد الله بن أبي طلحة.(@)(@@)(@@)(@@) ||| AUTO شيبة الكاتب(@)(@@) يروي عن المدنيين، وعمر بن عبد العزيز، روى عنه إياس بن دغفل.(@)(@@) شيبة(@)(@@) شيخ يروي عن أبي جعفر محمد بن علي بن الحسين، روى عنه ابن جريج، إن لم يكن ابن نصاح فلا أدري من هو.(@)(@@)(@@)(@@) ||| AUTO شعبة بن الحجاج بن الورد الواسطي(@)(@@) مولى عتيك، كنيته أبو بسطام، يروي عن قتادة، وأبي إسحاق، روى عنه الثوري، وحماد بن سلمة، والبصريون، كان مولده سنة ثلاث وثمانين بنهريان، قرية أسفل 
ms1014	 من واسط، ومات سنة ستين ومائة في أولها، وله يوم مات سبع وسبعون سنة، وكان أكبر من سفيان بعشر سنين، وكان من سادات أهل زمانه حفظا وإتقانا وورعا وفضلا، وهو أول من فتش بالعراق عن أمر المحدثين وجانب الضعفاء والمتروكين، حتى صار علما يقتدى به، ثم تبعه عليه بعده أهل العراق.(@)(@@) (335) -[3: 438] حدثنا(@)PageV01P002(@)(@@)(@@)(@@) ||| AUTO [ج 3: ص 439] أحمد بن يحيى بن زهير، قال: ثنا بندار، قال: ثنا محمد بن جعفر، قال: ثنا شعبة، قال: رأيت الحسن بن أبي الحسن، وعليه عمامة سوداء.(@)(@@)(@@)(@@) ||| AUTO شعبة بن يزيد الحنفي(@)(@@) يروي عن عبيد الله بن عبد الله بن عمر، والقاسم بن محمد، عداده في أهل اليمامة، روى عنه عمر بن يونس، وابنه يحيى بن شعبة.(@)(@@)(@@)(@@) ||| AUTO شعبة بن عبد الرحمن المدني(@)(@@) يروي عن سعيد بن المسيب، روى عنه سعيد بن أبي أيوب، والليث بن سعد.(@)(@@)(@@)(@@) ||| AUTO شعبة بن دينار(@)(@@) يروي عن عكرمة، وأبي بردة بن أبي موسى الأشعري، روى عنه ابن عيينة.(@)(@@) (336) -[3: 439] حدثنا ابن مكرم بالبصرة، قال: ثنا نصر بن علي، قال: ثنا سفيان بن عيينة، قال: ثنا، كوفي لنا، يقال له: شعبة، سمع أبا بردة، عن أبي موسى عن النبي صلى الله عليه وسلم قال: " من أعتق رقبة مؤمنة أعتق الله بكل عضو منها عضوا منه من النار. "(@)(@@)(@@)(@@) ||| AUTO شعبة بن عجلان الإسكاف، أبو عمرو العتكي(@)(@@) من أهل البصرة، يروي عن ابن سيرين، روى عنه موسى بن إسماعيل.(@)(@@)(@@)(@@) ||| AUTO شعبة بن أبي روق(@)(@@) يروي عن الشعبي، روى عنه زكريا بن أبي زائدة.(@)(@@) شعبة(@)(@@) شيخ يروي عن كريب بن أبرهة، روى عنه سليط بن شعبة الشعباني، لست أعرفه ولا أباه.(@)(@@)(@@)(@@) ||| AUTO شقيق بن عبد الله الضبي(@)(@@) قوله، عداده في أهل الكوفة، روى عنه أبو حصين، وعاصم بن أبي النجود.(@)(@@)(@@)(@@) ||| AUTO شقيق بن حيان(@)(@@) يروي عن منصور بن صفية، روى عنه محمد بن أبي يعقوب.(@)PageV01P002(@)(@@) [ج 3: ص 440](@)(@@)(@@)(@@) ||| AUTO شرحبيل بن سعيد بن سعد بن عبادة الخزرجي(@)(@@) من أهل المدينة، يروي عن أبيه، عن جده سعد بن 
ms1015	 عبادة، روى عنه ابنه عمرو بن شرحبيل.(@)(@@)(@@)(@@) ||| AUTO شرحبيل بن شريك المعافري، كنيته أبو محمد(@)(@@) من أهل مصر، يروي عن أبي عبد الرحمن الحبلي، روى عنه حيوة بن شريح.(@)(@@)(@@)(@@) ||| AUTO شرحبيل بن مدرك الجعفي(@)(@@) من أهل الكوفة، يروي عن أبيه، عن ابن عباس، روى عنه أبو أسامة.(@)(@@)(@@)(@@) ||| AUTO شيبان الراعي(@)(@@) من عباد أهل مرو، يروي عن سفيان الثوري، روى عنه أهل بلده، وكان من الأمارين بالمعروف، وسكة شيبان بمرو تعرف به، وهو صاحب حكايات عجيبة مروية، وكان ابن المبارك لا يميل إليه لميله إلى مذهب الرأي.(@)(@@)(@@)(@@) ||| AUTO شيبان بن زهير بن شقيق بن ثور، أبو العوام السدوسي(@)(@@) من أهل البصرة، يروي عن قتادة، وعبد الرحمن بن أبي بكرة، روى عنه الحارث بن مرة الحنفي.(@)(@@)(@@)(@@) ||| AUTO شيبان بن عبد الرحمن، أبو معاوية النحوي التميمي المؤدب(@)(@@) أصله من البصرة، سكن الكوفة، يروي عن الحسن، وقتادة، روى عنه عبيد الله بن موسى، وأبو نعيم، مات سنة أربع وستين ومائة ببغداد.(@)(@@)(@@)(@@) ||| AUTO شيبان اللحام(@)(@@) يروي عن ابن الحنفية، روى عنه سالم بن أبي حفصة.(@)(@@)(@@)(@@) ||| AUTO شرقي بن قطامي(@)(@@) يروي عن محمد بن زياد، روى عنه يزيد بن هارون، وقد قيل: إن شرقي، وقطامي جميعا لقبان، وهو الوليد بن حصين بن حبيب بن جمال الكلبي، كان اسم شرقي: الوليد، واسم قطامي: حصين.(@)PageV01P002(@)(@@) [ج 3: ص 441](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO شرقي البصري(@)(@@) يروي عن عكرمة، روى عنه شعبة.(@)(@@)(@@)(@@) ||| AUTO شرقي الجعفي(@)(@@) يروي عن سويد بن غفلة، روى عنه جابر الجعفي.(@)(@@) شرقي(@)(@@) شيخ يروي عن أبي وائل، روى عنه العوام بن حوشب.(@)(@@)(@@)(@@) ||| AUTO شراحيل بن عمرو، أبو عمرو العنسي(@)(@@) من أهل الشام، يروي عن عمرو بن الأسود، وعبادة بن نسي، روى عنه شرحبيل بن مسلم الخولاني.(@)(@@)(@@)(@@) ||| AUTO شراحيل بن مرثد الصنعاني، أبو عثمان(@)(@@) صاحب الفتوح، يروي المراسيل، روى عنه أهل الشام.(@)(@@)(@@)(@@) ||| AUTO شراحيل بن يزيد المعافري(@)(@@) من أهل مصر، يروي عن مسلم بن يسار، وعبد الرحمن بن رافع التنوخي، روى عنه سعيد بن أبي أيوب.(@)(@@)(@@)(@@) ||| AUTO شملة بن عبد الله 
ms1016	(@)(@@) شيخ يروي عن رجاء بن حيوة، روى عنه المبارك بن فضالة.(@)(@@)(@@)(@@) ||| AUTO شمر بن عطية بن عبد الرحمن الأسدي الكابلي(@)(@@) من أهل الكوفة، يروي عن المغيرة بن سعد بن الأخرم، وشهر بن حوشب، وروى عنه الأعمش، وفطر بن خليفة، مات في ولاية خالد بن عبد الله على العراق.(@)(@@)(@@)(@@) ||| AUTO شمر بن عكرمة بن صعصعة بن صوحان العبدي(@)(@@) يروي عن مولى لهم، روى عنه فضل بن مرزوق.(@)PageV01P002(@)(@@) [ج 3: ص 442](@)(@@)(@@)(@@) ||| AUTO شوذب(@)(@@) مولى الشعبي، كنيته أبو عثمان، وقد قيل: أبو معاذ، يروي عن الحسن، والشعبي، روى عنه شعبة، والثوري.(@)(@@)(@@)(@@) ||| AUTO شميط بن عجلان العابد التيمي(@)(@@) من أهل البصرة، كنيته أبو عبيد الله، أخو الأخضر بن عجلان، يروي عن مالك بن دينار، والبصريين، روى عنه ابنه عبيد الله بن شميط.(@)(@@)(@@)(@@) ||| AUTO شجاع بن أبي شجاع(@)(@@) صاحب السابري، من أهل البصرة، يروي عن معاوية بن قرة، روى عنه عبد الصمد بن عبد الوارث.(@)(@@)(@@)(@@) ||| AUTO شجاع بن الوليد بن قيس السكوني، أبو بدر(@)(@@) من أهل الكوفة، سكن بغداد، يروي عن إسماعيل بن أبي خالد، ويحيى بن سعيد الأنصاري، والأعمش، مات سنة أربع أو خمس ومائتين، روى عنه ابنه، أبو همام الوليد بن شجاع، وأهل العراق.(@)(@@)(@@)(@@) ||| AUTO شعوذ بن عبد الرحمن، أبو عمر الرحبي(@)(@@) من أهل الشام، يروي عن ابن عائذ، وخالد بن معدان، روى عنه معاوية بن صالح، وجنادة بن محمد المزني.(@)(@@)(@@)(@@) ||| AUTO شجرة بن عبد الله المصري، أبو محمد(@)(@@) يروي عن أبي عبد الرحمن المهري: أنه سجد مع عمر بن الخطاب في الحج سجدتين. روى عنه بكر بن مضر.(@)(@@)(@@)(@@) ||| AUTO شهم بن المقدام(@)(@@) من أهل الكوفة، يروي عن الشعبي، روى عنه سفيان الثوري.(@)(@@)(@@)(@@) ||| AUTO شبة بن عقال بن صعصعة بن ناجية المجاشعي(@)(@@) يروي عن أبيه، عن جده PageV01P002 [ج 3: ص 443] صعصعة وله صحبة، روى عنه ابنه عقال بن شبة، من أهل حران.(@)(@@)(@@)(@@) ||| AUTO شبل بن العلاء بن عبد الرحمن بن يعقوب(@)(@@) مولى الحرقة، كنيته أبو المفضل، يروي عن أبيه، روى عنه ابن أبي فديك بنسخة 
ms1017	 مستقيمة، حدثنا بها الفضل بن محمد العطار، بأنطاكية، قال: ثنا أحمد بن الوليد بن برد الأنطاكي، قال: ثنا ابن أبي فديك، قال: ثنا شبل بن العلاء، عن أبيه.(@)(@@)(@@)(@@) ||| AUTO شباك الضبي(@)(@@) من أهل الكوفة، يروي عن إبراهيم النخعي، روى عنه المغيرة بن مقسم.(@)(@@) (337) -[3: 443] حدثنا محمد بن قتيبة، قال: ثنا الفرياناني، قال: ثنا محمد بن فضيل عن أبيه، قال: سمعت شباكا، يقول: رب شباك لو شئت جعلت شباكا يطيعك ولا يعصيك، ثم يبكى حتى تبل لحيته.(@)(@@)(@@)(@@) ||| AUTO شرحاف بن المختار التميمي(@)(@@) يروي عن عكرمة، روى عنه بكر بن بكار.(@)(@@)(@@)(@@) ||| AUTO شعيث بن عبد الله بن زبيب العنبري الأعرابي التميمي(@)(@@) يروي عن أبيه، عن جده، روى عنه موسى بن إسماعيل، وأحمد بن عبدة الضبي.(@)(@@)(@@)(@@) || AUTO باب الصاد(@)(@@) قال أبو حاتم، رضي الله عنه:(@)(@@) وممن روى عن التابعين من أتباعهم ممن ابتدأ اسمه على الصاد:(@)(@@)(@@)(@@) ||| AUTO صالح بن إبراهيم بن محمد بن طلحة بن عبيد الله التيمي القرشي(@)(@@) من أهل المدينة، يروي عن أبيه، عن سعد بن أبي وقاص، روى عنه طلحة بن صالح.(@)(@@)(@@)(@@) ||| AUTO صالح بن إبراهيم بن عبد الرحمن بن عوف(@)(@@) يروي عن محمود بن لبيد الأشهلي، عن محمد بن مسلمة، روى عنه ابناه سالم، وصالح ابنا صالح بن إبراهيم، وقد قيل: إنه سمع من أنس بن مالك.(@)PageV01P002(@)(@@) [ج 3: ص 444](@)(@@)(@@)(@@) ||| AUTO صالح بن كيسان(@)(@@) مولى بني غفار، من أهل المدينة، وكان مؤدبا لعمر بن عبد العزيز، يروي عن عبيد الله بن عبد الله بن عتبة، والزهري، ونافع، وكان من فقهاء المدينة، والجامعين للحديث والفقه، من ذوى الهيبة والمروءة، كنيته أبو محمد، روى عنه عمرو بن دينار، ومالك، وأهل المدينة، وقد قيل: سمع من ابن عمر، وما أراه بمحفوظ، ومات صالح بعد سنة أربعين ومائة.(@)(@@)(@@)(@@) ||| AUTO صالح بن عطاء بن خباب(@)(@@) مولى بني الديل، يروي عن عطاء بن أبي رباح، روى عنه جعفر بن ربيعة.(@)(@@)(@@)(@@) ||| AUTO صالح بن عطاء المكي(@)(@@) يروي عن عمرو بن دينار، روى عنه سعيد بن أبي أيوب، أحسبه 
ms1018	 الأول.(@)(@@)(@@)(@@) ||| AUTO صالح بن أرتبيل(@)(@@) يروي عن محارب بن دثار، روى عنه جابر بن نوح.(@)(@@)(@@)(@@) ||| AUTO صالح البراد(@)(@@) من أهل البصرة، يروي عن أبي الأسود الديلي، روى عنه أبو هلال الراسبي.(@)(@@)(@@)(@@) ||| AUTO صالح بن خباب الفزاري(@)(@@) من أهل الكوفة، يروي عن حصين بن عقبة الفزاري، وخرشة بن الحر، روى عنه العلاء بن المسيب.(@)(@@) (338) -[3: 444] حدثنا ابن مكرم، بالبصرة، قال: ثنا عثمان بن أبي شيبة، قال: ثنا جرير بن عبد الحميد عن العلاء بن المسيب عن صالح بن خباب عن خرشة بن الحر، عن عبد الله بن سلام، قال: " لا أحدثكم إلا عن نبي مرسل وكتاب منزل أن عبدا لو أذنب كل ذنب ثم تاب إلى الله قبل موته بيوم قبل منه. "(@)(@@)(@@)(@@) ||| AUTO صالح بن جبلة(@)(@@) يروي عن قيس بن عبدة، روى عنه شهاب بن خراش الحوشبي.(@)PageV01P002(@)(@@) [ج 3: ص 445](@)(@@)(@@)(@@) ||| AUTO صالح بن حسان(@)(@@) يروي عن سعيد بن المسيب، وأبي سلمة، روى عنه بكير بن الأشج، ويزيد بن أبي حبيب، وابن أبي ذئب، وليس هذا بصالح بن حسان الأنصاري، ذاك ضعيف.(@)(@@)(@@)(@@) ||| AUTO صالح بن أبي جبير(@)(@@) مولى الحكم بن عمرو الغفاري، يروي عن أبيه، عن رافع بن عمرو، روى عنه أبو تميلة يحيى بن واضح، والفضل بن موسى الشيباني.(@)(@@)(@@)(@@) ||| AUTO صالح بن درهم الدهان(@)(@@) من أهل البصرة، كنيته أبو الأزهر، وقد قيل: أبو روح، يروي عن العراقيين، روى عنه شعبة بن الحجاج.(@)(@@)(@@)(@@) ||| AUTO صالح بن رستم، أبو عامر الخزاز(@)(@@) من أهل البصرة، يروي عن ابن أبي مليكة، والحسن، روى عنه هشيم، ويحيى القطان، وابنه عامر بن صالح، مات سنة ثنتين وخمسين ومائة.(@)(@@)(@@)(@@) ||| AUTO صالح بن راشد، أبو عبد الله الخياط(@)(@@) بصري، يروي عن الحسن، ومالك بن دينار، روى عنه حرمي بن عمارة، والتبوذكي.(@)(@@)(@@)(@@) ||| AUTO صالح بن رستم الدمشقي(@)(@@) من أهل الشام، يروي عن مكحول، روى عنه سعيد بن أبي أيوب.(@)(@@)(@@)(@@) ||| AUTO صالح بن عبيد(@)(@@) يروي عن قبيصة بن وقاص، روى عنه عمار بن عمارة بن غزية.(@)PageV01P002(@)(@@) [ج 3: ص 446](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO صالح بن أبي 
ms1019	 عريب(@)(@@) يروي عن كثير بن مرة، روى عنه عبد الحميد بن جعفر.(@)(@@)(@@)(@@) ||| AUTO صالح بن عبيد، أبو مصعب(@)(@@) يروي عن وهب بن منبه، روى عنه علي بن عبد الله بن المديني.(@)(@@)(@@)(@@) ||| AUTO صالح بن حصين بن صالح المدني(@)(@@) يروي عن أبيه، روى عنه إسماعيل بن أبي أويس.(@)(@@)(@@)(@@) ||| AUTO صالح بن روبة(@)(@@) يروي عن العراقيين، روى عنه يونس بن أبي إسحاق.(@)(@@)(@@)(@@) ||| AUTO صالح بن روبة السمان(@)(@@) قوله، روى عنه عثمان بن أبي زرعة، وعبد الحميد بن أبي جعفر الفراء، لست أدري هو الأول أم غيره.(@)(@@)(@@)(@@) ||| AUTO صالح بن دينار الهلالي(@)(@@) يروي عن عمرو بن الشريد، عن أبيه، روى عنه عامر الأحول.(@)(@@) صالح(@)(@@) مولى مازن، يروي عن عبيد بن عمير في قوله عز وجل {يأيها الرسل كلوا من الطيبات واعملوا صالحا}، قال: لم يرض الله من الرسل ولا من غيرهم إلا بالطيب. روى عنه الحسين بن واقد.(@)(@@)(@@)(@@) ||| AUTO صالح بن رافع(@)(@@) يروي عن جبير بن نفير، روى عنه حسان بن نوح.(@)(@@)(@@)(@@) ||| AUTO صالح بن يحيى بن المقدام بن معدي كرب(@)(@@) يروي عن أبيه، عن جده المقدام، روى عنه سلم بن سليم الكناني، يخطئ.(@)PageV01P002(@)(@@) [ج 3: ص 447](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO صالح بن سعيد(@)(@@) يروي عن المدنيين، وعمر بن عبد العزيز، روى عنه سعيد بن السائب.(@)(@@)(@@)(@@) ||| AUTO صالح بن سلمان(@)(@@) يروي المراسيل، روى عنه بكير بن شهاب.(@)(@@)(@@)(@@) ||| AUTO صالح بن رتبيل(@)(@@) يروي المراسيل، روى عنه عمران بن حدير، وليس هذا بصالح بن أرتبيل الذي روى عنه جابر بن نوح.(@)(@@) صالح بن سعيد(@)(@@) يروي عن نافع بن جبير، روى عنه ابن جريج.(@)(@@)(@@)(@@) ||| AUTO صالح بن أبي سلمة(@)(@@) يروي عن مجاهد، روى عنه أبو عاصم النبيل.(@)(@@)(@@)(@@) ||| AUTO صالح بن سرج الشني(@)(@@) يروي عن عمران بن حطان، عن عائشة، روى عنه عمرو بن العلاء اليشكري، أبو العلاء.(@)(@@)(@@)(@@) ||| AUTO صالح بن أبي شعيب العكلي(@)(@@) يروي عن الشعبي، روى عنه وكيع، وأبو نعيم.(@)(@@)(@@)(@@) ||| AUTO صالح بن أبي صالح السمان(@)(@@) واسم أبيه: ذكوان، مولى جويرية بنت الأحمس الغطفاني، يروي عن أبيه، روى 
ms1020	 عنه هشام بن عروة، وهو أخو سهيل، وعباد ابني أبي صالح.(@)(@@) (339) -[3: 447] حدثني أبو بدر، قال: حدثنا أبي، قال: ثنا شعيب بن إسحاق، قال: ثنا هشام بن عروة، عن صالح بن أبي صالح السمان، عن أبيه، عن أبي هريرة، أن رسول الله صلى الله عليه وسلم قال: لا يصبر أحد على لأواء المدينة وجهدها إلا كنت له شفيعا وشهيدا.(@)(@@)(@@)(@@) ||| AUTO صالح بن أبي صالح الأسدي(@)(@@) يروي عن عبد خير، روى عنه عطاء بن مسلم الحلبي.(@)PageV01P002(@)(@@) [ج 3: ص 448](@)(@@)(@@)(@@) ||| AUTO صالح بن صالح بن مسلم بن حي الثوري الهمداني(@)(@@) من أهل الكوفة، كنيته أبو حي، من ثور همدان، والد علي، والحسن ابني صالح، يروي عن الشعبي، وأبي السفر، روى عنه الثوري، وابن عيينة.(@)(@@)(@@)(@@) ||| AUTO صالح بن عبيد الله بن أبي رافع(@)(@@) مولى النبي صلى الله عليه وسلم يروي عن أبيه، روى عنه ابنه رباح بن صالح، رواه ابن أبي أويس، عن عبد الملك بن إبراهيم بن جبر، عن رباح بن صالح.(@)(@@)(@@)(@@) ||| AUTO صالح بن عبد الله(@)(@@) مولى لآل علي، يروي عن أبيه، عن علي، روى عنه ابن إسحاق.(@)(@@)(@@)(@@) ||| AUTO صالح بن مرداس(@)(@@) قال: سمعت الحسن، يقول: في قولهف ذلك ما كنت منه تحيدق، قال: فاسق في الحياة، حياد عند الموت. روى عنه الحوضي.(@)(@@)(@@)(@@) ||| AUTO صالح بن عبد الله بن أبي فروة القرشي الأموي(@)(@@) مولى آل عثمان بن عفان، من أهل المدينة، يروي عن عامر بن سعد بن أبي وقاص، روى عنه الزهري، مات سنة أربع وعشرين ومائة، كنيته أبو عروة، وقد قيل: أبو عفراء، وهو أخو عبد الأعلى، وعبد الحكيم، وعمار، وإسحاق بني عبد الله بن أبي فروة.(@)(@@)(@@)(@@) ||| AUTO صالح بن قدامة بن عبد الله بن إبراهيم بن محمد بن حاطب الجمحي القرشي(@)(@@) يروي عن عبد الله بن دينار، روى عنه إسحاق بن راهويه، وابن كاسب.(@)(@@)(@@)(@@) ||| AUTO صالح بن أبي صالح الأسدي(@)(@@) يروي عن الشعبي، روى عنه زكريا بن PageV01P002 [ج 3: ص 449] أبي زائدة، كذا عند بعض: صالح بن صالح الأسدي، وهو خطأ لأن 