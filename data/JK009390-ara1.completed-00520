ms514	 رفيق والله الطبيب ) )(@)(@@) ( حم ) عن أبي رمثة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4796 ) قال النبي :(@)(@@) | 30 ( أنت صاحبي على الحوض وصاحبي في الغار قاله لأبي بكر رضي الله عنه ) )(@)(@@) ( ت ك ) عن عمر رضي الله عنه ( ز ) .(@)(@@) PageV02P194(@)(@@)(@@)(@@) $ ( 4797 ) قال النبي :(@)(@@) | 30 ( أنت عتيق الله من النار ، قاله لأبي بكر رضي الله عنه ) )(@)(@@) ( ت ك ) عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 4798 ) قال النبي :(@)(@@) | 30 ( أنت مع من أحببت ) )(@)(@@) ( ق ) عن أنس رضي الله عنه ( حم د حب ) عن أبي ذر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4799 ) قال النبي :(@)(@@) | 30 ( أنت مني بمنزلة هاارون من موسى ، إلا أنه لا نبي ب| عد ي ) ( م ت ) عن سعد رضي الله عنه ( ت ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4800 ) قال النبي :(@)(@@) | 30 ( أنت مني وأنا منك قاله لعلي رضي الله عنه ) )(@)(@@) ( ق ) عن البراء رضي الله عنه ( ك ) عن علي رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4801 ) قال النبي :(@)(@@) | 30 ( أنت ومالك لأبيك ) )(@)(@@) ( ه ) عن جابر رضي الله عنه ( طب ) عن سمرة وابن مسعود رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4802 ) قال النبي :(@)(@@) | 30 ( أنت ومالك لوالدك ، إن أولادكم من أطيب كسبكم ، فكلوا من كسب أولادكم ) )(@)(@@) ( حم د ه ) عن ابن عمرو رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 4803 ) قال النبي :(@)(@@) | 30 ( أنتم أعلم بأمر دنياكم ) )(@)(@@) ( م ) عن أنس وعائشة رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4804 ) قال النبي :(@)(@@) | 30 ( أنتم الغر المحجلون يوم القيامة من إسباغ الوضوء ، فمن استطاع منكم فليطل غرته وتحجيله ) )(@)(@@) ( م ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4805 ) قال النبي :(@)(@@) | 30 ( أنتم شهداء الله في الأرض ، والملائكة شهداء الله في السماء ) )(@)(@@) ( طب ) عن سل مة بن الأكوع رضي الله عنه .(@)(@@) PageV02P195(@)(@@)(@@)(@@) $ ( 4806 ) قال النبي :(@)(@@) | 30 ( انتدب الله لمن خرج في سبيله لا يخرجه إلا إيمان بي وتصديق برسلي أن أرجعه بما نال من أجر أو غنيمة أو أدخله الجنة ، ولولا أن أشق على أمتي ما قعدت خلف سرية ولوددت أني أقتل في سبيل الله ثم أحيا ثم أقتل ثم أحيا ثم 
ms515	 أقتل ثم أحيا ) )(@)(@@) ( حم ق ن ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4807 ) قال النبي :(@)(@@) | 30 ( انتسب رجلان على عهد موسى فقال أحدهما : أنا فلان بن فلان حتى عد تسعة ، فمن أنت لا أم لك ؟ قال : أنا فلان بن فلان ابن الإسلام ، فأوحى الله إلى موسى أن قل لهاذين المنتسبين : أما أنت أيها المنتسب إلى تسعة في النار فأنت عاشرهم في النار ، وأما أنت أيها المنتسب إلى اثنين في الجنة فأنت ثالثهما في الجنة ) )(@)(@@) ( ن هب و الضياء ) عن أبي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4808 ) قال النبي :(@)(@@) | 30 ( انتظار الفرج بالصبر عبادة ) )(@)(@@) ( القضاعي ) عن ابن عمر عن ابن عباس رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 4809 ) قال النبي :(@)(@@) | 30 ( انتظار الفرج عبادة ) )(@)(@@) ( عد خط ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4810 ) قال النبي :(@)(@@) | 30 ( انتظار الفرج من الله عبادة ، ومن رضي بالقليل من الرزق رضي الله تعالى منه بالقليل من العمل ) )(@)(@@) ( ابن أبي الدنيا في الفرج وابن عساكر ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4811 ) قال النبي :(@)(@@) | 30 ( انتعلوا وتخففوا وخالفوا أهل الكتاب ) )(@)(@@) ( هب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4812 ) قال النبي :(@)(@@) | 30 ( انتهى الإيمان إلى الورع ، من قنع بما رزقه الله دخل الجنة ، ومن أراد الجنة لا شك فلا يخاف في الله لومة لائم ) )(@)(@@) ( خط ) في PageV02P196 الأفراد عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4813 ) قال النبي :(@)(@@) | 30 ( انزعوا بني عبد المطلب ، فلولا أن تغلبكم الناس على سقايتكم لنزعت معكم ) )(@)(@@) ( م د ه ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4814 ) قال النبي :(@)(@@) | 30 ( إنزلا فكلا من جيفة هاذا الحمار فما نلتما من عرض أخيكما آنفا أشد من أكل منه ، والذي نفسي بيده إنه الآن لفي أنهار الجنة منغمس فيها يعني ماعزا ) )(@)(@@) ( د ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4815 ) قال النبي :(@)(@@) | 30 ( أنزل القرآن بالتفخيم ) )(@)(@@) ( ابن الأنباري في الوقف ك ) عن زيد بن ثابت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4816 ) قال النبي :(@)(@@) | 30 ( أنزل القرآن على ثلاثة أحرف ) ( حم طب ك ) عن س$ مرة رضي 
ms516	 الله عنه .(@)(@@)(@@)(@@) $ ( 4817 ) قال النبي :(@)(@@) | 30 ( أنزل القرآن على ثلاثة أحرف فلا تختلفوا فيه ولا تحاجوا فيه فإنه مبارك فاقرؤوه كالذي أقرئتموه ) )(@)(@@) ( ابن الضريس ) عن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4818 ) قال النبي :(@)(@@) | 30 ( أنزل القرآن على سبعة أحرف ) )(@)(@@) ( حم ت ) عن أبي ( حم ) عن حذيفة رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4819 ) قال النبي :(@)(@@) | 30 ( أنزل القرآن على سبعة أحرف فمن قرأ على حرف منها فلا يتحول إلى غيره رغبة عنه ) )(@)(@@) ( طب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4820 ) قال النبي :(@)(@@) | 30 ( أنزل القرآن على سبعة أحرف لكل حرف منها ظهر وبطن ، ولكل حرف حد ، ولكل حد مطلع ) )(@)(@@) ( طب ) عن ابن مسعود رضي الله عنه .(@)(@@) PageV02P197(@)(@@)(@@)(@@) $ ( 4821 ) قال النبي :(@)(@@) | 30 ( أنزل القرآن على عشرة أحرف : بشير ونذير وناسخ ومنسوخ وعظة ومثل ومحكم ومتشابه وحلال وحرام ) )(@)(@@) ( السجزي في الإبانة ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4822 ) قال النبي :(@)(@@) | 30 ( أنزل القرآن من سبعة أبواب على سبعة أحرف كلها شاف كاف ) )(@)(@@) ( طب ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4823 ) قال النبي :(@)(@@) | 30 ( أنزل الله جبريل في أحسن ما كان يأتيني في صورة ، فقال : إن الله تعالى يقرئك السلام يا محمد ويقول لك : إني أوحيت إلى الدنيا أن تمرري وتكدري وتضيقي وتشددي على أوليائي كي يحبوا لقائي ، فإني خلقتها سجنا لأوليائي وجنة لأعدائي ) )(@)(@@) ( هب ) عن قتادة بن النعمان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4824 ) قال النبي :(@)(@@) | 30 ( أنزل الله علي أمانين لامتي : وما كان الله ليعذبهم وأنت فيهم ، وما كان الله معذبهم وهم يستغفرون ، فإذا مضيت تركت فيهم الاستغفار إلى يوم القيامة ) )(@)(@@) ( ت ) عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4825 ) قال النبي :(@)(@@) | 30 ( أنزل الناس منازلهم من الخير والشر ، وأحسن أدبهم على الأخلاق الصالحة ) )(@)(@@) ( الخرائطي في مكارم الأخلاق ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4826 ) قال النبي :(@)(@@) | 30 ( أنزلت صحف إبراهيم أول ليلة من شهر رمضان ، وأنزلت التوراة لست مضت من رمضان ، وأنزل الإنجيل لثلاث عشرة مضت من رمضان ، وأنزل الزبور لثمان عشرة خلت من رمضان ، وأنزل القرآن لأربع وعشرين خلت 
ms517	 من رمضان ) )(@)(@@) ( طب ) عن واثلة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4827 ) قال النبي :(@)(@@) | 30 ( أنزلت علي آنفا سورة بسم الله الرحمان الرحيم ، إنا أعطيناك الكوثر فصل لربك وانحر إن شانئك هو الأبتر ، أتدرون ما الكوثر ؟ فإنه نهر PageV02P198 وعدنيه ربي ، عليه خير كثير هو حوضي ترد عليه أمتي يوم القيامة ، آنيته كعدد النجوم فيختلح العبد منهم فأقول رب إنه من أمتي ، فيقول : ما تدري ما أحدث بعدك ) )(@)(@@) ( م د ن ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4828 ) قال النبي :(@)(@@) | 30 ( أنزل علي آيات لم ير مثلهن قط : قل أعوذ برب الفلق ، وقل أعوذ برب الناس ) )(@)(@@) ( م ت ن ) عن عقبة بن عامر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4829 ) قال النبي :(@)(@@) | 30 ( أنزل علي عشر آيات من أقامهن دخل الجنة : قد أفلح المؤمنون ، الآيات ) )(@)(@@) ( ت ) عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4830 ) قال النبي :(@)(@@) | 30 ( إنزل عنه فلا تصحبنا بملعون لا تدعوا على أنفسكم ، ولا تدعوا على أولادكم ، ولا تدعوا على أموالكم ، لا توافقوا من الله ساعة يسأل فيها عطاء فيستجيب لكم ) )(@)(@@) ( م ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4831 ) قال النبي :(@)(@@) | 30 ( أنزلوا الناس منازلهم ) )(@)(@@) ( م د ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 4832 ) قال النبي :(@)(@@) | 30 ( أنشد الله رجال أمتي لا يدخلون الحمام إلا بمئزر ، وأنشد الله نساء أمتي لا يدخلن الحمام ) )(@)(@@) ( ابن عساكر ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4833 ) قال النبي :(@)(@@) | 30 ( أنصر أخاك ظالما أو مظلوما ، إن يك ظالما فاردده عن ظلمه ، وإن يك مظلوما فانصره ) )(@)(@@) ( الدارمي وابن عساكر ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4834 ) قال النبي :(@)(@@) | 30 ( أنصر أخاك ظالما أو مظلوما ، قيل : كيف أنصره ظالما ؟ قال : تحجزه عن الظلم فإن ذالك نصره ) )(@)(@@) ( حم خ ت ) عن أنس رضي الله عنه .(@)(@@) PageV02P199(@)(@@)(@@)(@@) $ ( 4835 ) قال النبي :(@)(@@) | 30 ( انطلق أبا مسعود لا ألفينك يوم القيامة تجيء على ظهرك بعير من إبل الصدقة له رغاء قد غللته ) )(@)(@@) ( د ) عن ابن مسعود رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4836 ) قال النبي :(@)(@@) | 30 ( انطلق ثلاثة رهط ممن كان قبلكم حتى 
ms518	 أووا المبيت إلى غار فدخلوه ، فانحدرت عليهم صخرة من الجبل فسدت عليهم الغار ، فقالوا : إنه لا ينحيكم من هاذه الصخرة إلا أن تدعوا الله بصالح أعمالكم ، قال رجل منهم : اللهم كان لي أبوان شيخان كبيران ، وكنت لا أغبق قبلهما أهلا ولا مالا ، فنأى بي في طلب شيء يوما فلم أرح عليهما حتى ناما ، فحلبت لهما غبوقهما فوجدتهما نائمين فكرهت أن أغبق قبلهما أهلا أو مالا فلبثت والقدح على يدي أنتظر استيقاظهما حتى برق الفجر فاستيقظا فشربا غبوقهما ، اللهم إن كنت فعلت ذالك ابتغاء وجهك ففرج عنا ما نحن فيه من هاذه الصخرة فانفرجت شيئا لا يستطيعون الخروج ، وقال الآخر : اللهم كانت لي ابنة عم كانت أحب الناس إلي فأردتها على نفسها فامتنعت مني حتى ألمت بها سنة من السنين فجاءتني فأعطيتها عشرين ومائة دينار على أن تخلي بيني وبين نفسها ففعلت حتى إذا قدرت عليها ، قالت : لا أحل لك أن تفض الخاتم إلا بحقه ، فتحرجت من الوقوع عليها ، فانصرفت عنها وهي أحب الناس إلي ، وتركت الذهب الذي أعطيتها ، اللهم إن كنت فعلت ذالك ابتغاء وجهك فأفرج عنا ما نحن فيه فانفرجت الصخرة غير أنهم لا يستطيعون الخروج منها ، وقال الثالث : اللهم استأجرت أجراء فأعطيتهم أجرهم غير رجل واحد ترك الذي له وذهب ، فثمرت أجره حتى كثرت منه الأموال فجاءني بعد حين فقال : يا عبد الله أدني أجري ، فقلت له : كل ما ترى من أجرك من الإبل والبقر والغنم والرقيق ، فقال : يا عبد الله لا تستهزىء بي ، فقلت : إني لا أستهزىء بك ، فأخذه كله فاستاقه فلم يترك منه شيئا ، اللهم فإن كنت فعلت ذالك ابتغاء وجهك فأفرج عنا ما PageV02P200 نحن فيه فانفرجت الصخرة فخرجوا يمشون ) )(@)(@@) ( ق ) عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 4837 ) قال النبي :(@)(@@) | 30 ( إنطلقوا باسم الله وبالله وعلى ملة رسول الله ، لا تقتلوا شيخا فانيا ، ولا طفلا ، ولا صغيرا ، ولا امرأة ، ولا تغلوا ، وضموا غنائمكم وأصلحوا وأحسنوا إن الله يحب المحسنين ) )(@)(@@) ( د ) عن أنس رضي الله عنه 
ms519	 ( ز ) .(@)(@@)(@@)(@@) $ ( 4838 ) قال النبي :(@)(@@) | 30 ( انظر فإنك لست بخير من أحمر ولا أسود إلا أن تفضله بتقوى ) )(@)(@@) ( حم ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4839 ) قال النبي :(@)(@@) | 30 ( انظرن من إخوانكن فإنما الرضاعة من المجاعة ) ( حم ق د ن ه ) عن ع$ ائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 4840 ) قال النبي :(@)(@@) | 30 ( أنظروا إلى من هو أسفل منكم ولا تنظروا إلى من هو فوقكم فهو أجدر أن لا تزدروا نعمة الله عليكم ) )(@)(@@) ( حم م ت ه ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4841 ) قال النبي :(@)(@@) | 30 ( انظروا قريشا فخذوا من قولهم وذروا فعلهم ) )(@)(@@) ( حم حب ) عن عامر بن شهر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4842 ) قال النبي :(@)(@@) | 30 ( أنظري أين أنت منه فإنما هو جنتك ونارك ) )(@)(@@) ( ابن سعد طب ) عن عمة حصين بن محصن رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4843 ) قال النبي :(@)(@@) | 30 ( أنعت لكم الكرسف فإنه يذهب الدم ) )(@)(@@) ( د ه ) عن حمنة بنت جحش رضي الله عنها ( ز ) .(@)(@@) PageV02P201(@)(@@)(@@)(@@) $ ( 4844 ) قال النبي :(@)(@@) | 30 ( أنعم على نفسك كما أنعم الله عليك ) )(@)(@@) ( ابن النجار ) عن والد أبي الأحوص .(@)(@@)(@@)(@@) $ ( 4845 ) قال النبي :(@)(@@) | 30 ( انفذ على رسلك حتى تنزل بساحتهم ثم ادعهم إلى الإسلام وأخبرهم بما يجب عليهم من حق الله فيه ، فوالله لأن يهدي الله بك رجلا واحدا خير لك من أن يكون لك حمر النعم ) )(@)(@@) ( حم ق ) عن سهل بن سعد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4846 ) قال النبي :(@)(@@) | 30 ( أنفق يا بلال ولا تخش من ذي العرش إقلالا ) )(@)(@@) ( البزار ) عن بلال وعن أبي هريرة رضي الله عنهما ( طب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4847 ) قال النبي :(@)(@@) | 30 ( أنفقي ولا تحصي فيحصي الله عليك ، ولا توعي فيوعي الله عليك ) )(@)(@@) ( حم ق ) عن أسماء بنت أبي بكر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4848 ) قال النبي :(@)(@@) | 30 ( أنكحوا الأيامى على ما تراضى به الأهلون ولو قبضة من أراك ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4849 ) قال النبي :(@)(@@) | 30 ( أنكحوا أمهات الأولاد فإني أباهي بهم يوم القيامة ) )(@)(@@) ( حم ) عن ابن عمرو رصي 
