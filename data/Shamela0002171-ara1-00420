ms401	 وعنه مالك وورقاء والداروردي وكان يسرد الصوم ع(@)(@@)(@@)(@@) | 2824- (@)(@@) عبد الله بن عبد الرحمن بن يحنس عن أبي عبد الله القراظ وعنه الدراوردي وابن أبي فديك وثق م د(@)(@@)(@@)(@@) | 2825- (@)(@@) عبد الله بن عبد الرحمن بن يزيد بن جابر الازدي عن إسماعيل بن عبيد الله وعطاء الخراساني وعنه الحكم بن موسى وعلي بن حجر وعدة قال أبو حاتم صالح الحديث م ت س(@)(@@)(@@)(@@) | 2826- (@)(@@) عبد الله بن عبد الرحمن بن يعلى الثقفي عن عطاء وعمرو بن شعيب وعنه بن مهدي وعبد الرزاق قال أبو حاتم ليس بقوي م د س ق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2827- (@)(@@) عبد الله بن عبد الرحمن الجمحي عن الزهري وعنه معن وخالد بن مخلد شيخ ت(@)(@@)(@@)(@@) | 2828- (@)(@@) عبد الله بن عبد الرحمن أبو نصر الضبي عن أنس ومساور الحميري وعنه السفيانان وابن فضيل وثقه أحمد ت ق(@)(@@)(@@)(@@) | 2829- (@)(@@) عبد الله بن عبد الرحمن الاشهلي عن حذيفة وعنه عمرو بن أبي عمرو وثق ت ق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2830- (@)(@@) عبد الله بن عبد الصمد بن أبي خداش الاسدي الموصلي عن المعافى وابن عيينة وعيسى بن يونس وعنه النسائي وأبو يعلى وأحمد وكيل أبي صخرة صدوق توفي 255 س(@)(@@)(@@)(@@) | 2831- (@)(@@) عبد الله بن عبد العزيز الليثي أبو عبد العزيز عن المقبري والزهري وعنه يحيى بن بكير وأحمد بن محمد الازرقي ضعفه أبو حاتم ق(@)(@@)(@@)(@@) | 2832- (@)(@@) عبد الله بن عبد القدوس السعدي الرازي عن عبد الملك بن عمير وجابر الجعفي وعنه بن حميد وعباد الرواجني قال بن معين رافضي ليس بشئ خت ت(@)(@@)(@@)(@@) | 2833- (@)(@@) عبد الله بن عبد المؤمن الارحبي الواسطي عن يزيد بن هارون وطبقته وعنه بن ماجة وعلي بن عبد الله بن مبشر ثقة ق(@)(@@)(@@)(@@) | 2834- (@)(@@) عبد الله بن عبد الوهاب الحجبي البصري عن مالك وأبي عوانة وعنه البخاري وتمتام وأبو خليفة ثبت مات 228 خ س(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2835- (@)(@@) عبد الله بن عبيد الله بن أبي رافع الهاشمي مولاهم عن أبيه وأبي غطفان وعنه سعيد بن أبي هلال وابن عجلان وثق م س(@)(@@)(@@)(@@) | 2836- (@)(@@) عبد الله بن عبيد الله بن العباس الهاشمي عن أبيه وعمه عبد الله 
ms402	 وعنه موسى بن سالم ويحيى بن سعيد الانصاري وثق 4(@)(@@)(@@)(@@) | 2837- (@)(@@) عبد الله بن عبيد الله بن عمر بن الخطاب عن بن عمر وعنه أبو الزناد د س(@)(@@)(@@)(@@) | 2838- (@)(@@) عبد الله بن عبيد الله بن أبي مليكة التيمي أبو بكر مؤذن بن الزبير وقاضيه سمع عائشة وابن عباس وعنه أيوب والليث قال بعثني بن الزبير على قضاء الطائف فكنت أسأل بن عباس توفي 118 ع(@)(@@)(@@)(@@) | 2839- (@)(@@) عبد الله بن عبيد بن عمير الليثي أبو هاشم عن عائشة وابن عباس وعدة وعنه بن جريج والاوزاعي وثقه أبو حاتم توفي 113 م 4(@)(@@)(@@)(@@) | 2840- (@)(@@) عبد الله بن عبيد عن سعيد بن جبير وعنه داود بن أبي هند س(@)(@@)(@@)(@@) | 2841- (@)(@@) عبد الله بن عبيد الحميري عن عديسة وأبي بكر بن النضر وعنه بن علية وعثمان بن الهيثم وثقه بن معين ت س ق(@)(@@)(@@)(@@) | 2842- (@)(@@) عبد الله بن عبيدة الربذي عن سهل بن سعد وعلي بن الحسين ويرسل وعنه أخواه موسى(@)(@@) PageV00P000(@)(@@) ومحمد وصالح بن كيسان صدوق فيه شئ خ(@)(@@)(@@)(@@) | 2843- (@)(@@) عبد الله بن عتبة بن أبي سفيان بن حرب عن أم حبيبة وعنه أبو المليح الهذلي ق(@)(@@)(@@)(@@) | 2844- (@)(@@) عبد الله بن عتبة بن مسعود الهذلي من أبناء المهاجرين له رؤية سمع عمه وعمر وعنه ابناه الفقيه عبيد الله والزاهد عون وابن سيرين قال بن سعد ثقة رفيع كثير الفتيا والحديث توفي بالكوفة 74 خ م د س ق(@)(@@)(@@)(@@) | 2845- (@)(@@) عبد الله بن أبي عتبة عن مولاه أنس وعائشة وعنه بن جدعان وحميد بصري صدوق خ م س(@)(@@)(@@)(@@) | 2846- (@)(@@) عبد الله بن عتيق ويقال بن عتيك وقيل بن عبيد وابن هرمز عن عبادة بن الصامت وعنه بن سيرين س ق(@)(@@)(@@)(@@) | 2847- (@)(@@) عبد الله بن عثمان بن إسحاق بن سعد بن أبي وقاص عن جده لامه مالك بن حمزة الساعدي وجماعة وعنه أحمد الوهبي والكديمي ليس بقوي ق(@)(@@)(@@)(@@) | 2848- (@)(@@) عبد الله بن عثمان بن جبلة بن أبي رواد العتكي المروزي عبدان الحافظ أبو عبد الرحمن عن أبيه وأبي حمزة وعنه البخاري والذهلي وأحمد بن سيار يقال تصدق بألف 
ms403	 ألف وعاش ستا(@)(@@) وسبعين سنة توفي 221 خ م د ت س(@)(@@)(@@)(@@) | 2849- (@)(@@) عبد الله بن عثمان بن خثيم المكي حليف الزهريين عن صفية بنت شيبة وأبي الطفيل وعنه(@)(@@) PageV00P000(@)(@@) بشر بن المفضل ويحيى بن سليم قال أبو حاتم صالح الحديث توفي 132 م 4 خت(@)(@@)(@@)(@@) | 2850- (@)(@@) عبد الله بن عثمان بن عامر بن عمرو بن كعب بن سعد بن تيم بن مرة أبو بكر الصديق عنه بن عباس وأنس وقيس بن أبي حازم قال عروة أسلم وله أربعون ألف دينار وقال النبي صلى الله عليه وسلم لو كنت متخذا خليلا لاتخذت أبا بكر وقال عمر أبو بكر سيدنا وخيرنا وأحبنا إلى رسول الله صلى الله عليه وسلم توفي في جمادي الاولى سنة ثلاث عشرة عن ثلاث وستين سنة ع(@)(@@)(@@)(@@) | 2851- (@)(@@) عبد الله بن عثمان بن عطاء الخراساني عن مسلم الزنجي وعدة وعنه سمويه وأبو حاتم ليس بذاك ق(@)(@@)(@@)(@@) | 2852- (@)(@@) عبد الله بن عثمان الثقفي عن رجل وعنه الحسن د س(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2853- (@)(@@) عبد الله بن عثمان البصري عن بن القاسم وهشام بن عروة وعنه بن مهدي ويحيى بن آدم ثقة ت س ق(@)(@@)(@@)(@@) | 2854- (@)(@@) عبد الله بن عدي بن الحمراء الزهري له صحبة عنه أبو سلمة ومحمد بن جبير ت س ق(@)(@@)(@@)(@@) | 2855- (@)(@@) عبد الله بن عرادة السدوسي عن زيد العمي وداود بن أبي هند وعنه الشاذكوني وداهر بن نوح واه ق(@)(@@)(@@)(@@) | 2856- (@)(@@) عبد الله بن عروة أبو بكر عن عمه بن الزبير وأبي هريرة وابن عمر وعنه أخوه هشام ونافع المقرئ ويوسف بن الماجشون من نبلاء قريش مات قريب العشرين ومائة خ م ت س ق(@)(@@)(@@)(@@) | 2857- (@)(@@) عبد الله بن عصم ويقال بن عصمة أبو علوان العجلي الحنفي عن أبي سعيد وابن عمر وعنه إسرائيل وشريك شيخ د ت ق(@)(@@)(@@)(@@) | 2858- (@)(@@) عبد الله بن عصمة الجشمي عن حكيم بن حزام وعنه يوسف بن ماهك وعطاء ثقة س(@)(@@)(@@)(@@) | 2859- (@)(@@) عبد الله بن عصمة عن سعيد بن ميمون وعنه عثمان بن عبد الرحمن وابن زبالة ق(@)(@@)(@@)(@@) | 2860- (@)(@@) عبد الله بن عطاء الطائفي أو المدني 
ms404	 أو الواسطي أو المكي أو الكوفي عن أبي الطفيل وابن بريدة وعنه شعبة وابن نمير وعدة صدوق م د ت س(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2861- (@)(@@) عبد الله بن عطاء عن عقبة بن عامر وعنه أبو إسحاق ق(@)(@@)(@@)(@@) | 2862- (@)(@@) عبد الله بن عطية عن رجل وعنه منيب بن عبد الله مجهول س(@)(@@)(@@)(@@) | 2863- (@)(@@) عبد الله بن عقيل أبو عقيل الثقفي ببغداد عن هشام بن عروة وابن أبي خالد وعنه سريج بن النعمان وعاصم بن علي صدوق 4(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2864- (@)(@@) عبد الله بن عكيم أبو معبد الجهني بالكوفة عن كتاب النبي صلى الله عليه وسلم وأبي بكر وعمر وعنه بن أبي ليلى وهلال الوزان وعدة 4(@)(@@)(@@)(@@) | 2865- (@)(@@) عبد الله بن علقمة بن وقاص عن أبيه وعنه عمر بن طلحة وعيسى بن عمر وثق س(@)(@@)(@@)(@@) | 2866- (@)(@@) عبد الله بن علي بن الحسين العلوي عن أبيه وأرسل عن جده وعنه موسى بن عقبة وعبد الله بن عمر ثقة ت س(@)(@@)(@@)(@@) | 2867- (@)(@@) عبد الله بن علي بن السائب المطلبي عن عمرو بن أحيحة ونافع بن عجير وعنه سعيد بن أبي هلال ومحمد بن علي بن شافع ولم يضعف د س(@)(@@)(@@)(@@) | 2868- (@)(@@) عبد الله بن علي بن يزيد بن ركانة المطلبي عن أبيه وعنه الزبير بن سعيد فقط وثق حب د ت ق(@)(@@)(@@)(@@) | 2869- (@)(@@) عبد الله بن علي الافريقي أبو أيوب الازرق عن الزهري وأبي إسحاق وعنه يحيى بن أبي زائدة ومروان بن معاوية لينه أبو زرعة د ت(@)(@@) *- عبد الله بن أبي عمار عن بن بأبيه في قصر الصلاة وعنه بن جريج صوابه عبد الرحمن بن عبد الله بن أبي عمار د 324(@)(@@)(@@)(@@) | 2870- (@)(@@) عبد الله بن عمر بن حفص بن عاصم العمري عن أخيه عبيد الله ونافع والمقبري وعنه ابنه(@)(@@) PageV00P000(@)(@@) عبد الرحمن والقعنبي وأبو مصعب قال بن معين صويلح وقال بن عدي لا بأس به صدوق توفي 4 171 م مقرونا(@)(@@)(@@)(@@) | 2871- (@)(@@) عبد الله بن عمر أبو عبد الرحمن العدوي شهد الاحزاب والحديبية عنه بنوه ونافع وزيد بن أسلم قال النبي صلى الله عليه وسلم إن عبد الله رجل 
ms405	 صالح وقال جابر ما منا أحد إلا مالت به الدنيا ومال بها إلا بن عمر قال بن المسيب مات وما أحد أحب إلي أن ألقى الله بمثل عمله منه مات 74 ع(@)(@@)(@@)(@@) | 2872- (@)(@@) عبد الله بن عمر الخطابي البصري عن معتمر والداروردي وعنه هلال بن العلاء والبغوي ثقة توفي 236 س(@)(@@)(@@)(@@) | 2873- (@)(@@) عبد الله بن عمر بن غانم أبو عبد الرحمن الرعيني قاضي إفريقية عن داود بن قيس وابن أنعم وعنه القعنبي مستقيم الحديث د(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2874- (@)(@@) عبد الله بن عمر بنمحمد بن أبان مشكدانة عن أبي الاحوص والداروردي وعبثر وعنه مسلم وأبو داود والبغوي والسراج ثقة توفي 238 م د(@)(@@)(@@)(@@) | 2875- (@)(@@) عبد الله بن عمر الاموي عن سعيد بن عمرو وعنه يحيى بن أبي بكير وثق س(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2876- (@)(@@) عبد الله بن عمر النميري عن يونس الايلي ويزيد الرقاشي وعنه حجاج بن منهال وأبو سلمة ثقة خ(@)(@@)(@@)(@@) | 2877- (@)(@@) عبد الله بن عمرو بن أمية الضمري عن أبيه وعنه ابنه الزبرقان ومحمد بن أبي حميد وثق س(@)(@@) *- عبد الله بن عمرو بن الحارث المصطلقي عن زينب وعنه أبو وائل غلط والصواب عمرو بن الحارث ت 4137(@)(@@)(@@)(@@) | 2878- (@)(@@) عبد الله بن عمرو بن أبي الحجاج أبو معمر المنقري المقعد البصري حافظ عن أبي الاشهب العطاردي وعبد الوارث وعنه البخاري وأبو داود وأبو حاتم والبرتي مات 224 ع(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2879- (@)(@@) عبد الله بن عمرو بن العاص أبو محمد وقيل أبو عبد الرحمن أسلم قبيل أبيه وكان من العلماء العباد قال شفي بن ماتع عنه إنه حفظ عن رسول الله صلى الله عليه وسلم ألف مثل عنه سبطه شعيب بن محمد وعروة وطاوس مات بالطائف وقيل بمصر سنة 65 ع(@)(@@)(@@)(@@) | 2880- (@)(@@) عبد الله بن عمرو بن عثمان المطرف عن أبيه وابن عباس والحسين وعنه ابنه محمد الديباج والزهري صدوق جواد ممدح توفي 96 م د ت س(@)(@@)(@@)(@@) | 2881- (@)(@@) عبد الله بن عمرو بن علقمة الكناني المكي عن عمر بن سعيد وابن خثيم وعنه بن مهدي وعبد الرزاق ثقة ت(@)(@@)(@@)(@@) | 2882- (@)(@@) عبد الله بن عمرو بن عوف المزني 
ms406	 عن أبيه وله صحبة وعنه ولده كثير وثق حب د ت ق(@)(@@)(@@)(@@) | 2883- (@)(@@) عبد الله بن عمرو بن الفغواء عن أبيه وله صحبة وعنه عيسى بن معمر د(@)(@@)(@@)(@@) | 2884- (@)(@@) عبد الله بن عمرو بن مرة الجملي عن أبيه وعنه وكيع وإسحاق السلولي صدوق ق(@)(@@)(@@)(@@) | 2885- (@)(@@) عبد الله بن عمرو بن هند الجملي أيضا عن علي وعنه عوف ت(@)(@@)(@@)(@@) | 2886- (@)(@@) عبد الله بن عمرو الاودي عن بن مسعود وعنه موسى بن عقبة ت(@)(@@)(@@)(@@) | 2887- (@)(@@) عبد الله بن عمرو مولى الحسن بن علي عن عدي بن حاتم وعنه عمرو بن مرة س(@)(@@) *- عبد الله بن أبي عمرو الزوفي صوابه بن أبي مرة ق 2976(@)(@@)(@@)(@@) | 2888- (@)(@@) عبد الله بن عمرو المخزومي العابدي عن عبد الله بن السائب وعنه محمد بن عباد بن جعفر م د(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2889- (@)(@@) عبد الله بن عمران المخزومي العابدي أبو القاسم عن إبراهيم بن سعد وفضيل وعنه الترمذي وابن صاعد وعلي الغضائري قال أبو حاتم صدوق توفي 245 ت(@)(@@)(@@)(@@) | 2890- (@)(@@) عبد الله بن عمران الاصبهاني ثم الرازي أبو محمد عن جرير وأبي معاوية وعنه بن ماجة وجعفر بن محمد الزعفراني وجعفر بن أحمد بن فارس ثقة ق(@)(@@)(@@)(@@) | 2891- (@)(@@) عبد الله بن عمران الطلحي عن أبي عمران الجوني وجماعة وعنه نوح بن قيس وعمرو بن(@)(@@) سليمان صدوق ت(@)(@@)(@@)(@@) | 2892- (@)(@@) عبد الله بن عمير العباسي مولاهم عن بن عباس وعنه القاسم بن عباس وثق م ق(@)(@@)(@@)(@@) | 2893- (@)(@@) عبد الله بن عميرة كوفي عن الاحنف وعنه سماك حسن الترمذي له حديث الاوعال د ت ق(@)(@@)(@@)(@@) | 2894- (@)(@@) عبد الله بن عنيسة عن بن غنام وعنه ربيعة الرأي ومحمد بن سعيد الطائفي د(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2895- (@)(@@) عبد الله بن عنمة عن العباس وعمار وعنه عمر بن الحكم بن ثوبان وجعفر بن عبد الله د س(@)(@@)(@@)(@@) | 2896- (@)(@@) عبد الله بن عون أبو عون المزني أحد الاعلام مولى عبد الله بن مغفل عن أبي وائل وإبراهيم ومجاهد وعنه شعبة والقطان ومسلم قال هشام بن حسان لم تر عيناي مثله وقال قرة كنا نعجب من ورع بن سيرين فأنساناه بن عون وقال الاوزاعي إذا 
ms407	 مات بن عون وسفيان استوى الناس توفي رحمه الله 151 ع(@)(@@)(@@)(@@) | 2897- (@)(@@) عبد الله بن عون بن أمير مصر أبي عون عبد الملك بن يزيد الهلالي أبو محمد البغدادي الادمي الخراز الزاهد عن مالك وشريك وعنه مسلم وأبو يعلى والبغوي ثقة من الابدال مات 232 م س(@)(@@)(@@)(@@) | 2898- (@)(@@) عبد الله بن العلاء بن زبر الربعي الدمشقي عن أبي سلام ومكحول والقاسم بن محمد الشامي وعنه ابنه إبراهيم وأبو المغيرة ومروان بن محمد وثقه أبو داود مات 164 خ 4(@)(@@)(@@)(@@) | 2899- (@)(@@) عبد الله بن عياش بن عباس القتباني المصري عن أبيه والاعرج وأبي عشانة وعنه بن وهب(@)(@@) PageV00P000(@)(@@) والمقرئ ضعفه أبو داود والنسائي وقال أبو حاتم صدوق ليس بالمتين توفي 17 م ق(@)(@@)(@@)(@@) | 2900- (@)(@@) عبد الله بن عيسى بن عبد الرحمن بن أبي ليلى أبو محمد الانصاري عن جده وعكرمة وسعيد بن جبير وعنه عمه محمد وحفيده عيسى بن المختار وشعبة ثقة ع(@)(@@)(@@)(@@) | 2901- (@)(@@) عبد الله بن عيسى أبو خلف الخزاز بصري عن يحيى البكاء وداود بن أبي هند وعنه عمر بن شبة ومحمد بن موسى الحرشي ضعفوه ت(@)(@@)(@@)(@@) | 2902- (@)(@@) عبد الله بن غابر أبو عامر الالهاني عن ثوبان وعتبة بن عبد وعنه حريز ومعاوية بن صالح ثقة يقال أدرك عمر س ق(@)(@@)(@@)(@@) | 2903- (@)(@@) عبد الله بن غالب الحداني البصري العابد عن أبي سعيد وعنه قتادة والقاسم بن الفضل واعظ قانت متبتل صادق قتل يوم الجماجم سنة 83 ت(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2904- (@)(@@) عبد الله بن غالب العباداني عن الربيع بن صبيح وعدة وعنه عباد الغبري وعباس الترقفي لم يضعف ق(@)(@@)(@@)(@@) | 2905- (@)(@@) عبد الله بن غنام البياضي صحابي عنه عبد الله بن عنبسة د(@)(@@)(@@)(@@) | 2906- (@)(@@) عبد الله بن فروخ عن مولاته عائشة وأبي هريرة وعنه شداد أبو عمار وأبو سلام ممطور ثقة م د(@)(@@)(@@)(@@) | 2907- (@)(@@) عبد الله بن فروخ عن طلحة مولاه وعثمان وعنه ابنه إبراهيم وطلحة بن يحيى صدوق س(@)(@@)(@@)(@@) | 2908- (@)(@@) عبد الله بن فروخ بالمغرب عن هشام بن عروة وابن عون وعنه سعيد بن أبي مريم(@)(@@) PageV00P000(@)(@@) وجماعة قال سعيد هو أرضى أهل الارض عندي وقال 
ms408	 البخاري تعرف وتنكر توفي 175 د(@)(@@)(@@)(@@) | 2909- (@)(@@) عبد الله بن فضالة الليثي عن أبيه وعنه الحرب بن أبي الاسود د(@)(@@)(@@)(@@) | 2910- (@)(@@) عبد الله بن الفضل بن العباس بن ربيعة الهاشمي عن أنس والاعرج وعنه بن الماجشون ومالك وزياد بن سعد ع(@)(@@)(@@)(@@) | 2911- (@)(@@) عبد الله بن فيروز الديلمي المقدسي عن أبيه وابن مسعود وعدة وعنه ربيعة القصير ويحيى السيباني ثقة د س ق(@)(@@)(@@)(@@) | 2912- (@)(@@) عبد الله بن فيروز الداناج بصري عن أنس وأبي رافع الصائغ وعنه همام وابن علية ومن رفاقه قتادة خ م د س ق(@)(@@)(@@)(@@) | 2913- (@)(@@) عبد الله بن القاسم مولى الصديق عن جابر وابن عباس وعنه فضيل بن غزوان وقرة بن خالد وثق حب د(@)(@@)(@@)(@@) | 2914- (@)(@@) عبد الله بن القاسم عن بن أبزى وابن المسيب وعنه بن شوذب قال بن معين ليس به بأس ت(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2915- (@)(@@) عبد الله بن أبي قتادة السلمي أبو إبراهيم عن أبيه وعنه المقبري ويحيى بن أبي كثير مات 95 ع(@)(@@)(@@)(@@) | 2916- (@)(@@) عبد الله بن قدامة العنبري أبو السوار عن أبي برزة وعنه توبة العنبري وثقه النسائي س(@)(@@)(@@)(@@) | 2917- (@)(@@) عبد الله بن قرط الثمالي أمير حمص صحابي عنه غضيف وسليم بن عامر وعدة قتل سنة 56 د س(@)(@@)(@@)(@@) | 2918- (@)(@@) عبد الله بن قريش البخاري عن أبي مسهر وطبقته وعنه أبو داود وغيره د(@)(@@)(@@)(@@) | 2919- (@)(@@) عبد الله بن قيس أبو موسى الاشعري ولي زبيد وعدن للنبي صلى الله عليه وسلم وولي الكوفة والبصرة لعمر عنه بنوه أبو بكر وأبو بردة وإبراهيم وموسى قال بن بريدة كان قصيرا خفيف اللحم أثط مناقبه مشهورة توفي 44 بخلف ع(@)(@@)(@@)(@@) | 2920- (@)(@@) عبد الله بن قيس بن مخرمة المطلبي عن أبي هريرة وجماعة وعنه ابناه محمد ومطلب وأبو بكر بن حزم ولي العراق قبل الحجاج أياما وولي قضاء المدينة م 4(@)(@@)(@@)(@@) | 2921- (@)(@@) عبد الله بن قيس أبو بحرية الكندي السكوني الحمصي عن عمر ومعاذ وعنه خالد بن معدان ويونس بن ميسرة وعدة ولي غزو الصائفة لمعاوية وبقي إلى زمن الوليد 4(@)(@@)(@@)(@@) | 2922- (@)(@@) عبد الله بن قيس النخعي عن الحارث بن أقيش وعنه داود بن 
ms409	 أبي هند ق(@)(@@)(@@)(@@) | 2923- (@)(@@) عبد الله بن قيس أو بن أبي قيس أبو الأسود النصري الحمصي عن أبي ذر وعائشة وعنه(@)(@@) PageV00P000(@)(@@) يزيد بن خمير ومعاوية بن صالح صدوق م 4(@)(@@)(@@)(@@) | 2924- (@)(@@) عبد الله بن كثير الزرقي المدني عن أبيه وسعد بن سعيد المقبري وعنه عباس العنبري(@)(@@) والزبير بن بكار شيخ ق(@)(@@) *- عبد الله بن كثير بن المطلب السهمي عن شيخ وعنه بن جريج لم يصح وصوابه عبد الله بن أبي مليكة واسم شيخه محمد بن قيس م س(@)(@@)(@@)(@@) | 2925- (@)(@@) عبد الله بن كثير الداري أبو معبد مقرئ مكة عن بن الزبير وعبد الرحمن بن مطعم(@)(@@) PageV00P000(@)(@@) ومجاهد وعنه بن جريج وابن أبي نجيح وشبل بن عباد وجرير بن حازم ثقة فصيح مفوه إمام توفي 12 ع(@)(@@)(@@)(@@) | 2926- (@)(@@) عبد الله بن كعب بن مالك السلمي عن أبيه وأبي أيوب وعدة وعنه ابنه عبد الرحمن وإخوته والزهري توفي 97 خ م د س ق(@)(@@)(@@)(@@) | 2927- (@)(@@) عبد الله بن كعب الحميري عن عمر بن أبي سلمة وأبي بكر بن عبد الرحمن وعنه عبد ربه بن سعيد وابن إسحاق ثقة م س(@)(@@)(@@)(@@) | 2928- (@)(@@) عبد الله بن كنانة بن عباس بن مرداس في دعاء عرفة عن أبيه وعنه عبد القاهر بن السري قال البخاري لم يصح حديثه د ق(@)(@@) PageV00P000(@)(@@) *- عبد الله بن كنانة عن بن عباس وعنه ابنه هشام حديثه مضطرب س(@)(@@) PageV01P589(@)(@@)(@@)(@@) | 2929- (@)(@@) عبد الله بن كيسان أبو عمر عن مولاته أسماء وابن عمر وعنه عطاء وابن جريج قال أبو داود ثبت ع(@)(@@)(@@)(@@) | 2930- (@)(@@) عبد الله بن كيسان المروزي أبو مجاهد عن سعيد بن جبير وعكرمة وعنه السيناني وعلي بن الحسن بن شقيق ضعفه أبو حاتم د(@)(@@)(@@)(@@) | 2931- (@)(@@) عبد الله بن كيسان مولى طلحة عن عبد الله بن شداد والمقبري وعنه موسى بن يعقوب وثق ت(@)(@@)(@@)(@@) | 2932- (@)(@@) عبد الله بن أبي لبيد أبو المغيرة المدني عن أبي سلمة والمطلب بن عبد الله وعنه السفيانان ثقة خ م د س ق(@)(@@)(@@)(@@) | 2933- (@)(@@) عبد الله بن لحي أبو عامر الهوزني الحمصي عن عمر ومعاذ وبلال وعنه راشد بن سعد 
ms410	 وأزهر الحرازي ثقة د س ق(@)(@@)(@@)(@@) | 2934- (@)(@@) عبد الله بن لهيعة أبو عبد الرحمن الحضرمي الفقيه قاضي مصر عن عطاء والاعرج وابن أبي مليكة وعمرو بن شعيب وعنه يحيى بن بكير وقتيبة والمقرئ ضعف وقال أبو داود سمعت أحمد يقول من كان مثل بن لهيعة بمصر في كثرة حديثه وإتقانه وضبطه قلت العمل على تضعيف حديثه توفي 174 د ت ق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2935- (@)(@@) عبد الله بن مالك أبو تميم الجيشاني هاجر من اليمن زمن عمر وسمع منه ومن علي وتلا على معاذ وعنه بكر بن سوادة وكعب بن علقمة وعدة وكان من العابدين مات 77 م ت س ق(@)(@@)(@@)(@@) | 2936- (@)(@@) عبد الله بن مالك بن بحينة وبحينة أمه مطلبية من السابقين عنه حفص بن عاصم والاعرج ومحمد بن يحيى بن حبان توفي مع عائشة تقريبا ع(@)(@@)(@@)(@@) | 2937- (@)(@@) عبد الله بن مالك عن علي وابن عمر وعنه أبو إسحاق وأبو روق الهمداني شيخ د ت(@)(@@)(@@)(@@) | 2938- (@)(@@) عبد الله بن مالك بن حذافة عن أمه وعنه كثير بن فرقد د س(@)(@@)(@@)(@@) | 2939- (@)(@@) عبد الله بن مالك له صحبة عنه شبل بن خليد س(@)(@@)(@@)(@@) | 2940- (@)(@@) عبد الله بن مالك اليحصبي عن عقبة بن عامر وعنه أبو سعيد جعثل الرعيني قال بن يونس هو أبو تميم الجيشاني 4(@)(@@)(@@)(@@) | 2941- (@)(@@) عبد الله بن المبارك بن واضح أبو عبد الرحمن الحنظلي مولاهم المروزي شيخ خراسان عن سليمان التيمي وعاصم الاحول والربيع بن أنس وعنه بن مهدي وابن معين وابن عرفة فأبوه تركي مولى تاجر وأمه خوارزمية ولد سنة 118 وتوفي بهيت 181 في رمضان ع(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2942- (@)(@@) عبد الله بن المثنى بن عبد الله بن أنس بن مالك أبو المثنى عن عمومته والحسن وعنه ابنه(@)(@@) محمد ومسدد وعبد الواحد بن غياث قال أبو حاتم صالح وقال أبو داود لا أخرج حديثه خ ت ق(@)(@@)(@@)(@@) | 2943- (@)(@@) عبد الله بن أبي المجالد عن بن أبي أوفى مولاه وعبد الرحمن بن أبزى وعنه أبو إسحاق الشيباني وشعبة ثقة وسماه شعبة محمدا فوهم خ د س ق(@)(@@)(@@)(@@) | 2944- (@)(@@) عبد الله بن محرر العامري 
ms411	 قاضي الجزيرة عن نافع والزهري وعنه عبد الرزاق وأبو نعيم قال البخاري منكر الحديث ق(@)(@@)(@@)(@@) | 2945- (@)(@@) عبد الله بن محصن الانصاري اختلف في صحبته عنه ابنه سلمة ت ق(@)(@@) *- عبد الله بن محصن عن عمته وعنه بشير بن يسار صوابه حصين سعبد الله بن محصن عن عمته وعنه بشير بن يسار صوابه حصين س 1131(@)(@@)(@@)(@@) | 2946- (@)(@@) عبد الله بن محمد بن أبي شيبة الحافظ أبو بكر العبسي مولاهم الكوفي صاحب التصانيف عن شريك وابن المبارك وهشيم وعنه البخاري ومسلم وأبو داود وابن ماجة وأبو يعلى والباغندي قال الفلاس ما رأيت أحفظ منه وقال صالح جزرة هو أحفظ من أدركنا عند المناظرة توفي 235 سوى ت(@)(@@)(@@)(@@) | 2947- (@)(@@) عبد الله بن محمد بن إسحاق أبو عبد الرحمن الاذرمي عن هشيم وجرير وعنه أبو داود(@)(@@) PageV00P000(@)(@@) والنسائي وابن صاعد قال أبو حاتم ثقة د س(@)(@@)(@@)(@@) | 2948- (@)(@@) عبد الله بن محمد بن أسماء الضبعي عن عمه جويرية وجعفر بن سليمان وعنه البخاري ومسلم وأبو داود وأبو يعلى قال أحمد الدورقي لم أر بالبصرة أفضل منه توفي 231 خ م د س(@)(@@)(@@)(@@) | 2949- (@)(@@) عبد الله بن محمد بن أبي الاسود حميد أبو بكر البصري الحافظ عن مالك وديلم بن غزوان وخاله عبد الرحمن بن مهدي وعنه البخاري وأبو داود وإبراهيم الحربي مات 223 خ د ت(@)(@@)(@@)(@@) | 2950- (@)(@@) عبد الله بن محمد التيمي عن عمته عائشة وعنه سالم ونافع قتل بالحرة شابا خ م س(@)(@@)(@@)(@@) | 2951- (@)(@@) عبد الله بن محمد بن تميم المصيصي عن حجاج بن محمد ووهب بن جرير وعنه النسائي(@)(@@) وأبو عوانة وطائفة ثقة س(@)(@@)(@@)(@@) | 2952- (@)(@@) عبد الله بن محمد بن حجاج بن أبي عثمان الصواف عن عبد الوهاب الثقفي ومعاذ بن هشام وعنه الترمذي وابن خزيمة وابن صاعد توفي 255 ت(@)(@@)(@@)(@@) | 2953- (@)(@@) عبد الله بن محمد بن الربيع الكرماني بالمصيصة عن بن المبارك وإسماعيل بن مجالد وعنه الدارمي وأبو حاتم ثقة س(@)(@@)(@@)(@@) | 2954- (@)(@@) عبد الله بن محمد بن رمح المصري عن بن وهب وعنه بن ماجة ومحمد بن محمد بن الاشعث توفي 25 ق 
ms412	(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2955- (@)(@@) عبد الله بن محمد بن صيفي عن حكيم بن حزام وعنه صفوان بن موهب وثق حب س(@)(@@)(@@)(@@) | 2956- (@)(@@) عبد الله بن محمد أبو جعفر الجعفي البخاري الحافظ المسندي عن فضيل ومعتمر وعنه البخاري ومحمد بن نصر المروزي توفي 229 خ ت(@)(@@)(@@)(@@) | 2957- (@)(@@) عبد الله بن محمد بن عبد الله بن زيد بن عبد ربه الانصاري عن جده وعنه بن سيرين وجماعة وثق د(@)(@@)(@@)(@@) | 2958- (@)(@@) عبد الله بن محمد بن عبد الله بن أبي فروة أبو علقمة الفروي عن المقبري ونافع وعنه سعيد بن منصور وابن راهويه ثقة توفي 19 م د س(@)(@@)(@@)(@@) | 2959- (@)(@@) عبد الله بن أبي عتيق محمد بن عبد الرحمن بن أبي بكر عن عائشة وابن عمر وعنه ابناه محمد وعبد الرحمن وابن إسحاق ثقة خ م س ق(@)(@@)(@@)(@@) | 2960- (@)(@@) عبد الله بن محمد بن عبد الرحمن بن المسور بن مخرمة بصري سمع بن عيينة وغندرا وعنه مسلم والاربعة وابن خزيمة وابن أبي داود مات 256 م 4(@)(@@)(@@)(@@) | 2961- (@)(@@) عبد الله بن محمد بن عقيل الطالبي عن بن عمر وجابر وعنه معمر وزائدة وبشر بن المفضل قال أبو حاتم وعدة لين الحديث وقال بن خزيمة لا أحتج به د ت ق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2962- (@)(@@) عبد الله بن محمد بن الحنفية عن أبيه وعنه الزهري وعمرو بن دينار توفي بالحميمة 98 ع(@)(@@)(@@)(@@) | 2963- (@)(@@) عبد الله بن محمد بن علي بن نفيل الحافظ أبو جعفر النفيلي الحراني عن مالك وزهير وعنه أبو داود وهلال بن العلاء والفريابي قال أبو داود ما رأيت أحفظ منه وكان أحمد يعظمه وقال بن واره هو من أركان الدين توفي 234 خ 4(@)(@@)(@@)(@@) | 2964- (@)(@@) عبد الله بن محمد بن عمر بن علي بن أبي طالب عن أبيه وخاله الباقر وعنه أبو أسامة وابن أبي فديك ثقة د س(@)(@@)(@@)(@@) | 2965- (@)(@@) عبد الله بن محمد بن عمرو الغزي أبو العباس عن عمرو بن أبي سلمة والفريابي وعنه أبو داود وابن خزيمة وابن أبي حاتم د(@)(@@)(@@)(@@) | 2966- (@)(@@) عبد الله بن محمد بن معن عن أم هشام وعنه خبيب بن عبد الرحمن 
ms413	 وثق م د(@)(@@)(@@)(@@) | 2967- (@)(@@) عبد الله بن محمد بن يحيى الطرسوسي الضعيف من العبادة عن بن عيينة وأبي معاوية وعنه أبو داود والنسائي وابن أبي داود وثقه النسائي د س(@)(@@)(@@)(@@) | 2968- (@)(@@) عبد الله بن محمد بن أبي يحيى الاسلمي عن أبيه وعمه أنيس وأبي صالح السمان وعنه(@)(@@) PageV00P000(@)(@@) بن أبي فديك وقتيبة وثقه بن معين مات 174 لقبه سحبل د(@)(@@)(@@)(@@) | 2969- (@)(@@) عبد الله بن محمد الليثي عن تابعي صغير عنه يونس المؤدب لا يعرف ق(@)(@@)(@@)(@@) | 2970- (@)(@@) عبد الله بن محمد التميمي عن عمر بن عبد العزيز وابن جدعان وعنه الوليد بن بكير واه ق(@)(@@)(@@)(@@) | 2971- (@)(@@) عبد الله بن محمد بن الرومي ببغداد عن بن عيينة وعبدة بن سليمان وعنه مسلم وأبو يعلى والسراج ثقة توفي 236 م(@)(@@)(@@)(@@) | 2972- (@)(@@) عبد الله بن محيريز الجمحي المكي ببيت المقدس رباه أبو محذورة له عنه وعن عبادة بن الصامت وعنه مكحول والزهري قال رجاء بن حيوة إن فخر علينا أهل المدينة بابن عمر فإنا نفخر بعابدنا بن محيريز إن كنت لاعد بقاءه أمانا لاهل الارض مات قبل المائة ع(@)(@@)(@@)(@@) | 2973- (@)(@@) عبد الله بن المختار البصري عن الحسن ومعاوية بن قرة وعنه شعبة والحمادان قال شعبة(@)(@@) كان أصغر مني وقال بن معين ثقة م د س ق(@)(@@)(@@)(@@) | 2974- (@)(@@) عبد الله بن مخلد التميمي النيسابوري عن أبي نعيم ومكي بن إبراهيم وأبي عبيد فأكثر وعنه أبو داود وابن خزيمة وابن الشرقي توفي 26 د(@)(@@)(@@)(@@) | 2975- (@)(@@) عبد الله بن مرة الخارفي عن بن عمر ومسروق وعنه منصور والاعمش ثقة مات سنة مائة ع(@)(@@)(@@)(@@) | 2976- (@)(@@) عبد الله بن مرة الزرقي عن أبي سعيد وعنه أبو الفيض س(@)(@@)(@@)(@@) | 2977- (@)(@@) عبد الله بن مرة أو بن أبي مرة الزوفي شهد فتح مصر ونزلها سمع خارجة في الوتر وعنه عبد الله بن راشد ورزين الزوفيان سنده منقطع د ت ق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2978- (@)(@@) عبد الله بن مسافع الحجبي عن عمته صفية وعنه ابنها منصور وابن جريج توفي 98 د س(@)(@@)(@@)(@@) | 2979- (@)(@@) عبد الله بن مسعود أبو عبد الرحمن الهذلي حليف بني زهرة من السابقين الاوليين عنه علقمة 
ms414	 والاسود وزر روى الحارث عن علي مرفوعا لو كنت مؤمرا أحدا من غير مشورة لامرت عليهم بن أم عبد أخرجه الترمذي روى أنه خلف تسعين ألف دينار سوى الرقيق والمواشي مات بالمدينة لما وفد سنة 32 ع(@)(@@)(@@)(@@) | 2980- (@)(@@) عبد الله بن مسلم بن جندب الهذلي عن أبيه وغيره وعنه بن أبي فديك ومحمد بن عثمان العثماني قال أبو زرعة لا بأس به ت(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2981- (@)(@@) عبد الله بن مسلم الزهري أخو بن شهاب عن بن عمر وأنس وعنه بكير بن الاشج ومعمر قال النسائي ثقة ثبت م د ت س(@)(@@)(@@)(@@) | 2982- (@)(@@) عبد الله بن مسلم بن هرمز المكي عن بن المسيب وعلي بن الحسين وعنه عيسى بن يونس وأبو عاصم ضعيف ق(@)(@@)(@@)(@@) | 2983- (@)(@@) عبد الله بن مسلم أبو طيبة السلمي المروزي قاضيها عن بن بريدة وأبي مجلز وعنه(@)(@@) زيد بن الحباب وعبدان بن عثمان قال أبو حاتم لا يحتج به وقواه غيره د ت س(@)(@@)(@@)(@@) | 2984- (@)(@@) عبد الله بن مسلم الطويل عن هبار وكلاب بن تليد وعنه الوليد بن كثير وثق حب س(@)(@@)(@@)(@@) | 2985- (@)(@@) عبد الله بن مسلمة بن قعنب أبو عبد الرحمن الحارثي القعنبي أحد الاعلام عن أفلح بن حميد وابن أبي ذئب وعنه البخاري ومسلم وأبو داود وابن الضريس وأبو خليفة قال أبو حاتم ثقة حجة لم أر أخشع منه وقال أبو زرعة ما كتبت عن أحد أجل في عيني منه مات في المحرم 221 خ م د ت س(@)(@@)(@@)(@@) | 2986- (@)(@@) عبد الله بن المسيب بن أبي السائب المخزومي العابدي من أبناء المهاجرين عن عمر وابن عمر وعنه بن أبي مليكة ومحمد بن عباد بن جعفر وثق م د(@)(@@)(@@)(@@) | 2987- (@)(@@) عبد الله بن المسيب مصري عن عكرمة وجماعة وعنه بن وهب وثق حب د(@)(@@)(@@)(@@) | 2988- (@)(@@) عبد الله بن مطر أبو ريحانة البصري عن سفينة وابن عباس وعنه بشر بن المفضل وابن علية قال بن معين وغيره صالح م د ت ق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2989- (@)(@@) عبد الله بن مطرف بن عبد الله بن الشخير عن أبي برزة وعنه حميد بن هلال وعطية 
ms415	 السراج توفي قبل أبيه د س(@)(@@) *- عبد الله بن المطلب عن أنس وعنه عمرو بن أبي عمرو س(@)(@@)(@@)(@@) | 2990- (@)(@@) عبد الله بن مطيع بن الاسود العدوي عن أبيه وعنه الشعبي وعيسى بن طلحة قتل مع بن الزبير وكان من فرسان قريش م(@)(@@)(@@)(@@) | 2991- (@)(@@) عبد الله بن مطيع بن راشد البكري النيسابوري ببغداد عن إسماعيل بن جعفر وابن المبارك وعنه مسلم والبغوي وأحمد بن الحسين الصوفي ثقة توفي 237 م(@)(@@)(@@)(@@) | 2992- (@)(@@) عبد الله بن معاذ الصنعاني عن يونس ومعمر وعنه العدني والزبير بن بكار صدوق ت ق(@)(@@)(@@)(@@) | 2993- (@)(@@) عبد الله بن معانق الاشعري عن أبي مالك الاشعري وعبد الرحمن بن غنم وعنه يحيى بن أبي كثير وبسر بن عبيد الله وثق حب ق(@)(@@)(@@)(@@) | 2994- (@)(@@) عبد الله بن معاوية الجمحي أبو جعفر البصري عن القاسم الحداني وحماد بن سلمة وعنه(@)(@@) أبو داود والترمذي وابن ماجة والبزار وعلي الغضائري نيف على المائة توفي 243 د ت ق(@)(@@)(@@)(@@) | 2995- (@)(@@) عبد الله بن معاوية الغاضري صحابي عنه جبير بن نفير د(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2996- (@)(@@) عبد الله بن معبد بن عباس عن عمه عبد الله وعنه ابنه إبراهيم وابن أبي مليكة ثقة م د س ق(@)(@@)(@@)(@@) | 2997- (@)(@@) عبد الله بن معبد الزماني عن أبي قتادة وأبي هريرة وعنه قتادة وثابت ثقة م 4(@)(@@)(@@)(@@) | 2998- (@)(@@) عبد الله بن معقل بن مقرن المزني عن أبيه وعلي وابن مسعود وعنه أبو إسحاق ويزيد بن أبي زياد ثقة سوى د(@)(@@)(@@)(@@) | 2999- (@)(@@) عبد الله بن معقل عن يزيد الرقاشي وعنه نوح الحداني لا يعرف ق(@)(@@)(@@)(@@) | 3000- (@)(@@) عبد الله بن معية ويقال عبيد الله ولد في حياة النبي صلى الله عليه وسلم أرسل حديثا وعنه سعيد بن السائب وإبراهيم بن ميسرة س(@)(@@)(@@)(@@) | 3001- (@)(@@) عبد الله بن مغفل المزني من أصحاب الشجرة عنه الحسن وسعيد بن جبير وابن بريدة وهو أول من تسور تستر وقت فتحها توفي سنة ستين ع(@)(@@)(@@)(@@) | 3002- (@)(@@) عبد الله بن مكنف الانصاري عن أنس وعنه المسور بن رفاعة وابن إسحاق واه ق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3003- (@)(@@) عبد الله بن منيب الانصاري عن جده وهشام بن عروة وعنه بن 
ms416	 مهدي وسعيد بن أبي مريم صدوق د س(@)(@@)(@@)(@@) | 3004- (@)(@@) عبد الله بن منير المروزي أبو عبد الرحمن الحافظ الزاهد عن النضر بن شميل ويزيد وعنه البخاري والترمذي والنسائي وعبدان المروزي توفي 241 خ ت س(@)(@@)(@@)(@@) | 3005- (@)(@@) عبد الله بن منين مصري عن عبد الله بن عمرو وعنه الحارث بن سعيد د ق(@)(@@)(@@)(@@) | 3006- (@)(@@) عبد الله بن المهاجر الدمشقي عن عنبسة بن أبي سفيان وعنه ابنه محمد ت س ق(@)(@@)(@@)(@@) | 3007- (@)(@@) عبد الله بن موسى بن إبراهيم التيمي عن صفوان بن سليم وعدة وعنه يعقوب بن محمد وإبراهيم بن المنذر الحزامي شيخ ق(@)(@@)(@@)(@@) | 3008- (@)(@@) عبد الله بن مولة القشيري عن بريدة وعنه أبو نضرة صدوق س(@)(@@)(@@)(@@) | 3009- (@)(@@) عبد الله بن المؤمل المخزومي المكي عن بن أبي مليكة وعطاء وعنه الشافعي وسعدويه ولي قضاء مكة قال أبو داود منكر الحديث وقال أبو حاتم ليس بقوي توفي 18 ت ق(@)(@@)(@@)(@@) | 3010- (@)(@@) عبد الله بن موهب قاضي فلسطين لعمر بن عبد العزيز عن معاوية وابن عباس وقبيصة بن ذؤيب وعنه الزهري وعبد العزيز بن عمر بن عبد العزيز صدوق 4(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3011- (@)(@@) عبد الله بن ملاذ الاشعري عن نمير بن أوس وعنه جرير بن حازم مجهول ت(@)(@@)(@@)(@@) | 3012- (@)(@@) عبد الله بن ميسرة أبو ليلى الحارثي ويقال أبو عبد الجليل عن الشعبي وعلباء بن أحمر وعنه وكيع ومسلم واه ق(@)(@@)(@@)(@@) | 3013- (@)(@@) عبد الله بن ميمون القداح مولى بني مخزوم بمكة عن يحيى بن سعيد وابن جريج وجعفر بن محمد وعنه مؤمل بن إهاب وأحمد بن الازهر قال البخاري ذاهب الحديث ت(@)(@@)(@@)(@@) | 3014- (@)(@@) عبد الله بن ميمون عن بن المنكدر وعنه إبراهيم بن عبد السلام ق(@)(@@)(@@)(@@) | 3015- (@)(@@) عبد الله بن نافع الزبيري عن مالك وابن أبي حازم وعنه الذهلي وعباس الدوري ثقة زاهد عابد مات 216 س ق(@)(@@)(@@)(@@) | 3016- (@)(@@) عبد الله بن نافع بن أبي العمياء عن بن الحارث وعنه بن أبي أنس قال البخاري لم يصح حديثه 4(@)(@@)(@@)(@@) | 3017- (@)(@@) عبد الله بن نافع الصائغ المدني مولى بني مخزوم عن أسامة بن زيد الليثي وداود بن قيس وعدة وعنه الذهلي وسلمة 
ms417	 بن شبيب قال البخاري في حفظه شئ وقال بن معين ثقة توفي 206 م 4(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3018- (@)(@@) عبد الله بن نافع كوفي عن مولاه الحسن بن علي وأبي موسى وعنه الحكم د(@)(@@)(@@)(@@) | 3019- (@)(@@) عبد الله بن نافع مولى بن عمر عن أبيه وابن المنكدر وعنه الطيالسي وابن أبي فديك(@)(@@) ضعفوه ق(@)(@@)(@@)(@@) | 3020- (@)(@@) عبد الله بن أبي نجيح يسار المكي مولى ثقيف عن أبيه وطاوس ومجاهد وعنه شعبة وابن علية ثقة توفي 131 ع(@)(@@)(@@)(@@) | 3021- (@)(@@) عبد الله بن نجي الحضرمي عن أبيه وعلي وعمار وعنه أبو زرعة البجلي والحارث العكلي وثقه النسائي وقال البخاري فيه نظر د س ق(@)(@@)(@@)(@@) | 3022- (@)(@@) عبد الله بن نسطاس عن جابر وعنه هاشم بن هاشم د س ق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3023- (@)(@@) عبد الله بن النعمان السحيمي عن قيس بن طلق وعنه ملازم بن عمرو وعمر بن يونس وثق د ت(@)(@@)(@@)(@@) | 3024- (@)(@@) عبد الله بن نمير الهمداني أبو هشام عن هشام بن عروة والاعمش وعنه ابنه وأحمد وابن معين حجة توفي 199 ع(@)(@@)(@@)(@@) | 3025- (@)(@@) عبد الله بن أبي نهيك المخزومي عن سعد وعنه بن أبي مليكة وثق حب د(@)(@@)(@@)(@@) | 3026- (@)(@@) عبد الله بن نيار بن مكرم الاسلمي عن أبي هريرة وسلمان بن ربيعة وعنه أبو الزناد وأسامة الليثي ثقة م د ت س(@)(@@)(@@)(@@) | 3027- (@)(@@) عبد الله بن هارون أبو علي شامي بالبصرة عن أبيه ويونس بن عبيد وعنه الفلاس وأبو قلابة صدوق أدركه البخاري س(@)(@@)(@@)(@@) | 3028- (@)(@@) عبد الله بن هارون عن زياد بن سعد وعنه صفوان بن عيسى د(@)(@@)(@@)(@@) | 3029- (@)(@@) صلى الله عليه وسلم عبد الله بن هارون عن عبد الله بن عمرو وعنه بن نبيه أبو سلمة د(@)(@@)(@@)(@@) | 3030- (@)(@@) عبد الله بن هاشم أبو عبد الرحمن العبدي الطوسي ويقال أبو محمد حافظ ثقة سمع بن عيينة وأبا معاوية وعنه مسلم وابن أبي داود ومكي بن عبدان مات 255 م(@)(@@)(@@)(@@) | 3031- (@)(@@) عبد الله بن هانئ عن عمه مطرف بن الشخير وعنه شعبة م(@)(@@)(@@)(@@) | 3032- (@)(@@) عبد الله بن هانئ أبوالزعراء الكندي الكوفي عن عمر وابن مسعود وعنه بن أخته سلمة بن كهيل ت س(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3033- (@)(@@) عبد الله 
ms418	 بن هبيرة السبائي أبو هبيرة عن أبي تميم الجيشاني وعبيد بن عمير وعنه خير بن نعيم وحيوة بن شريح وابن لهيعة ثقة توفي 126 م 4(@)(@@)(@@)(@@) | 3034- (@)(@@) عبد الله بن أبي الهذيل العنزي كوفي عن أبي وعمر وعبد الله وعنه الاجلح وأشعث بن أبي الشعثاء وعدة ثقة م ت س(@)(@@)(@@)(@@) | 3035- (@)(@@) عبد الله بن هرمز الفدكي عن ابني عبيد وعنه حاتم بن إسماعيل حسن الترمذي له ت(@)(@@) *- عبد الله بن هرمي صوابه هرمي ق 5948(@)(@@)(@@)(@@) | 3036- (@)(@@) عبد الله بن هشام بن زهرة له صحبة عنه حفيده أبو عقيل زهرة خ د(@)(@@)(@@)(@@) | 3037- (@)(@@) عبد الله بن هلال الثقفي عن النبي صلى الله عليه وسلم وعنه عثمان بن عبد الله بن الاسود س(@)(@@)(@@)(@@) | 3038- (@)(@@) عبد الله بن الهيثم العبدي عن بن مهدي وأبي معاوية وعنه النسائي وأبو عروبة وابن مخلد ثقة توفي 261 س(@)(@@)(@@)(@@) | 3039- (@)(@@) عبد الله بن واقد بن عبد الله بن عمر عن جده وعائشة وعنه الزهري وعمر بن محمد العمري ثقة توفي 119 م د ق(@)(@@)(@@)(@@) | 3040- (@)(@@) عبد الله بن واقد أبو رجاء الهروي مشهور بالكنية عن محمد بن مالك ويزيد الرقاشي وعنه إسحاق السلولي وأبو عبد الرحمن المقرئ وثقه أحمد ق(@)(@@)(@@)(@@) | 3041- (@)(@@) عبد الله بن واقد عن بن عجلان وعنه بقية فهذا الهروي أو أبو قتادة الحراني شيخ أحمد بن سليمان الرهاوي وسعدان واه ق(@)(@@)(@@)(@@) | 3042- (@)(@@) عبد الله بن وديعة بن خذام الانصاري عن أبي ذر وسلمان وعنه أبو سعيد المقبري قتل بالحرة خ ق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3043- (@)(@@) عبد الله بن الوضاح اللؤلؤي عن حفص بن غياث ووكيع وعنه الترمذي وابن خزيمة وابن صاعد ثقة توفي 25 ت(@)(@@)(@@)(@@) | 3044- (@)(@@) عبد الله بن الوليد المزني عن أبي جعفر الباقر وبكير بن شهاب وعنه بن المبارك وأبو نعيم(@)(@@) قال أبو حاتم صالح الحديث ت س(@)(@@)(@@)(@@) | 3045- (@)(@@) عبد الله بن الوليد بن قيس التجيبي عن بن المسيب وأبي سلمة وعنه حيوة بن شريح ويحيى بن أيوب وابن لهيعة توفي 131 د(@)(@@)(@@)(@@) | 3046- (@)(@@) عبد الله بن الوليد العدني عن سفيان جامعه وعن زمعة وعنه أحمد ومؤمل بن 
ms419	 يهاب شيخ د ت س(@)(@@)(@@)(@@) | 3047- (@)(@@) عبد الله بن وهب بن زمعة الاسدي عن أم سلمة ومعاوية وعنه الزهري وهاشم بن هاشم ثقة ت ق(@)(@@)(@@)(@@) | 3048- (@)(@@) عبد الله بن وهب أبو محمد الفهري مولاهم أحد الاعلام عن بن جريج ويونس وعنه أحمد بن صالح وحرملة والربيع قال يحيى بن بكير هو أفقه من بن القاسم وقال يونس بن عبد الاعلى طلب للقضاء فجنن نفسه وانقطع توفي 197 ع(@)(@@) *- عبد الله بن وهب عن تميم الداري صوابه بن موهب س 301(@)(@@)(@@)(@@) | 3049- (@)(@@) عبد الله بن يامين الطائفي عن أبيه وأبي هريرة وعنه سعيد بن السائب وأمي الصيرفي ق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3050- (@)(@@) عبد الله بن يحيى الثقفي البصري أبو يعقوب التوأم عن بن أبي مليكة وعبد الملك بن عمير وعنه قتيبة وخلف البزار ضعفه بن معين وقواه بن حبان د ق(@)(@@)(@@)(@@) | 3051- (@)(@@) عبد الله بن يحيى بن أبي كثير اليمامي عن أبيه وعنه مسدد ولوين قال أبو حاتم صدوق خ م(@)(@@)(@@)(@@) | 3052- (@)(@@) عبد الله بن يحيى الانصاري السلمي عن أبيه وعنه الليث وثق ق(@)(@@)(@@)(@@) | 3053- (@)(@@) عبد الله بن يحيى الثقفي البصري أبو محمد عن عبد الواحد بن زياد وبكار بن عبد العزيز وعنه الدارمي والفسوي ثقة س(@)(@@)(@@)(@@) | 3054- (@)(@@) عبد الله بن يحيى المعافري البرلسي عن حيوة بن شريح ومعاوية بن صالح وعنه جعفر بن مسافر والحسن بن عبد العزيز الجروي ثقة توفي 212 خ د(@)(@@)(@@)(@@) | 3055- (@)(@@) عبد الله بن يزيد الخطمي شهد الحديبية وله سبع عشرة سنة وولي الكوفة عنه ابنه موسى(@)(@@) ومحارب بن دثار وأبو إسحاق مات بعيد السبعين ع(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3056- (@)(@@) عبد الله بن يزيد بن الصلت عن بن إسحاق وسفيان وعنه محمد بن عبد العزيز الرملي قال أبو حاتم متروك س(@)(@@)(@@)(@@) | 3057- (@)(@@) عبد الله بن يزيد بن مقسم عن أبيه وعمته سارة وعنه بن مهدي وأبو حذيفة شيخ د(@)(@@)(@@)(@@) | 3058- (@)(@@) عبد الله بن يزيد رضيع عائشة عنها وعنه أبو قلابة فقط م 4(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3059- (@)(@@) عبد الله بن يزيد النخعي عن أبي زرعة وعنه شعبة م س(@)(@@)(@@)(@@) | 3060- (@)(@@) عبد الله بن يزيد مولى المنبعث عن أبيه وزيد 
ms420	 بن خالد وعنه ربيعة وسليمان بن بلال ثقة د س ق(@)(@@)(@@)(@@) | 3061- (@)(@@) عبد الله بن يزيد أبو عبد الرحمن الحبلي عن أبي ذر وأبي أيوب وعنه حميد بن هانئ وابن أنعم الافريقي ثقة توفي سنة مائة م 4(@)(@@)(@@)(@@) | 3062- (@)(@@) عبد الله بن يزيد المخزومي عن أبي سلمة وعروة وعنه إسماعيل بن أمية ومالك ثقة ع(@)(@@)(@@)(@@) | 3063- (@)(@@) عبد الله بن يزيد الدمشقي عن ربيعة القصير وعطية بن قيس وعنه عبد الله بن عقيل حسن له الترمذي ت ق(@)(@@)(@@)(@@) | 3064- (@)(@@) عبد الله بن يزيد أبو عبد الرحمن المقرئ الحافظ بمكة عن كهمس وأبي حنيفة وحيوة وعنه البخاري وبشر بن موسى وأبو الزنباع ثقة لقن سبعين عاما توفي 213 ع(@)(@@)(@@)(@@) | 3065- (@)(@@) عبد الله بن يسار الجهني كوفي عن حذيفة وعلي وعنه الاعمش وفطر ثقة د س(@)(@@)(@@)(@@) | 3066- (@)(@@) عبد الله بن يسار أبو همام عن علي وعمرو بن حريث وعنه يعلى بن عطاء وثق حب د(@)(@@)(@@)(@@) | 3067- (@)(@@) عبد الله بن يسار المكي عن سهل بن سعد وسالم وعنه عمر بن محمد وسليمان بن بلال وثق حب س(@)(@@)(@@)(@@) | 3068- (@)(@@) عبد الله بن يعقوب المدني عن بن أبي الزناد وعنه عبد الله بن أبي زياد القطواني وجماعة د ت(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3069- (@)(@@) عبد الله بن يوسف أبو محمد الدمشقي ثم التنيسي الكلاعي الحافظ عن عبد الرحمن بن يزيد بن جابر وسعيد بن عبد العزيز وعنه البخاري وبكر بن سهل وحبوش بن رزق الله قال بن معين ما بقي في الموطأ أوثق من بن يوسف توفي 218 خ د ت س(@)(@@)(@@)(@@) | 3070- (@)(@@) عبد الله بن يونس عن القرظي والمقبري وعنه يزيد بن الهاد فقط د س(@)(@@)(@@)(@@) | 3071- (@)(@@) عبد الله أبو بكر الحنفي عن أنس وعنه الاخضر حسن له الترمذي 4(@)(@@)(@@)(@@) | 3072- (@)(@@) عبد الله عن الوليد بن عقبة وعنه ثابت بن الحجاج د(@)(@@)(@@)(@@) | 3073- (@)(@@) عبد الله أبو محمد البهي مولى مصعب عن عائشة وابن عمر وعنه السدي وإسماعيل بن أبي خالد وثق م 4(@)(@@)(@@)(@@) | 3074- (@)(@@) عبد الله الصنابحي ويقال أبو عبد الله عن أبي بكر وعبادة وعنه عطاء بن يسار لعله عبد الرحمن د 