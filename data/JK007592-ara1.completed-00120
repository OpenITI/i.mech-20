ms101	 نحوه غمضا % % 4(@)(@@) % له عارض كالجيش تفري سواده % % عناجيج شهب خرقت متنه ركضا % % 5(@)(@@) % فبت ولي خصم من الشوق غالب ، % إذا ما دعا دمعي تحدر وارفضا % % 6(@)(@@) % وأهدته دعوائي بنجد وأهلها ، % فيا أهل نجد هل تجازونني قرضا % % 7(@)(@@) % ألا نكرت شر شجوني ، وراعها % % نحول أرق العظم واستلب الغمضا % % 8(@)(@@) % و شيب تعرى في الشباب ، كأنه % سراج صباح شق في الليل مبيضا % % 9(@)(@@) % منعمة محمودة الحسن غادة ، % تكسر في أجفانها مرضا ، خفضا % % 10(@)(@@) % إذا ما مشت هزت قضيبا على نقا ، % كهز نسيم الغصن ريحانه غضا % % PageV01P581 11(@)(@@) % سلت نافلات الحب ممن علمته ، % فكيف بمشغوف يرى حبها فرضا % % 12(@)(@@) % أرى كل يوم في ظلام مفارقي ، % شهاب مشيب باقي الأثر منقضا % % 13(@)(@@) % و كانت يد الأيام تقبل بزتي ، % فصارت يد الأيام تنفضني نفضا % % 14(@)(@@) % وقارعني ملك الشباب فأصبحت % عيون المها الإنسي تنفضني نفضا % % 15(@)(@@) % رد علي الدهر حد سلاحه ، % فقطعني جرحا ، وأوجعني عضا % % 16(@)(@@) % و خلفت ماء العيش ، صفو غديره ، % و بدلت من سلساله نمرا برضا % % 17(@)(@@) % رويدك إن الدهر ما قد علمته ، % وليس لنا من حكمه كل ما نرضى % % 18(@)(@@) % ولا بد أن يصغي إلى البؤس جانب ال % % نعيم ، ويقضي منعه ثم لا يقضى % % 19(@)(@@) % أرى الدهر يقضي كيف شاء محكما ، % و لا يملك الإنسان بسطا ولا قبضا % % 20(@)(@@) % وإن تجهليني بعد علم ، فإنني % % عرضت على الأحداث بعدكم عرضا % % PageV01P582 21(@)(@@) % وفقد أناس لا أخاف عيونهم ، % قروني من أخلافهم حلبا مخضا % % 22(@)(@@) % أرقي زفيري في التراقي عليهم ، % إذا لاعج الأحزان أوجعني مضا % % 23(@)(@@) % وصلت جناح الود بعد فراقهم ، % بريش ذنابى بعضها يخذل البعضا % % 24(@)(@@) % فعلقة قلبي كيف تلحق لهوه ، % وأسفار أحزاني تخلفه منضى % % 25(@)(@@) % ألا زودي يا ربة الخدر راجلا ، % تتبع أرضا قد دعت شخصه أرضا % % 26(@)(@@) % و كيف ثوائي بين قوم كأنما % % ترض تحياتي وجوههم رضا % % 27(@)(@@) % سرت عقرب الشحناء والبغض بيننا ، % و لا يملك الناس المحبة والبغضا % % 28(@)(@@) % ألا رب حلم عاد رقا وذلة ، % و جهل به معطيك ذو الجهل ما ترضى 
ms102	 % % PageV01P583 البحر : منسرح 1(@)(@@) % نرجسة لا تزال محدقة ، % لم تكتحل قط لذة الغمض % 2(@)(@@) % أمالها القطر ، فهي باهتة ، % تنظر فعل السماء بالأرض % PageV01P584 البحر : طويل 1(@)(@@) % وسكان دار لا تواصل بينهم ، % على قرب بعض في التجاور من بعض % 2(@)(@@) % كأن خواتيما من الطين بينهم ، % فليس لها حتى القيامة من فض % PageV01P585 البحر : سريع 1(@)(@@) % كن جاهلا ، أو فتجاهل تفز ، % للجهل في ذا الدهر جاه عريض % % 2(@)(@@) % والفضل محروم يرى ما يرى ، % كما يرى الوارث عين المريض % % PageV01P586(@)(@@)(@@)(@@) | (@)(@@) البحر : - 1(@)(@@) % ما نلت غير غمزة عينه ، % ورسائل بوصاله ، أو سخطه % 2(@)(@@) % و أجبت في ظهر الكتاب ، إذا أتى % % ليلوط خطي في الكتاب بخطه % 3(@)(@@) % ليت اخضرار بياضه وعذاره ، % لزبرجد ، أو لؤلؤ في قرطه % PageV01P587 البحر : بسيط تام 1(@)(@@) % إني غريب بدار لا كرام بها ، % كغربة الشعرة السوداء في الشمط % 2(@)(@@) % ما أطلق العين في شيء أسر % و لست أبدي الرضا إلا على السخط % PageV01P588 البحر : متقارب تام 1(@)(@@) % تبدى عشاء هلال الصيام ، % بنحس على الكأس والبربط % 2(@)(@@) % فكم من فتى راح بين القيا ، % ن نشوان ذا فرح مفرط % 3(@)(@@) % و كان نشيطا ، فلما رآ % % ه صاحب هم فلم ينشط % 4(@)(@@) % و أعرض عنه ، كما أعرضت % فتاة على الحاجب الأشمط % PageV01P589 البحر : - 1(@)(@@) % ألا تريان البرق ما هو صانع % بدمعة صب شفه النأي والشحط % 2(@)(@@) % من الله سقياه لشر وجوده ، % وليس لها سح الغمام ولا القحط % 3(@)(@@) % ومن رحمة الله التي أنا آمل ، % ومنتظر قرب المزار ، وإن شطوا % % 4(@)(@@) % فإن نجتمع بعد الفراق ، فما لنا % % على فعلات الدهر عتب ولا سخط % 5(@)(@@) % ألا هل تروا ما قد أرى من معاشر % لهم في حكم يهجر الحق مشتط % 6(@)(@@) % يذيعون ما أعتبتهم في شبيبتي ، % على حين أن ذكيت واشتعل الوخط % 7(@)(@@) % ألا إنها أم العجائب ، فاصطبر ، % و إن كنت ما لقيت أمثالها قط % 8(@)(@@) % إذا ما رأوا خيرا أبوا ، وتحملوا % % إلى بيتهم ، أو إن رأوا شرة حطوا % % 9(@)(@@) % ألا إن حلمي واسع إن صلحتم % بحلمي ، وعندي بعضه الجوع والخمط % 10(@)(@@) % فلا تكثروا 
ms103	 شوك الأذى في غصونكم % % فيكثر مني فيكم الكسر والخبط % PageV01P590 11(@)(@@) % و ليس لقرباكم ، وأنت عققتم ، % على السيف يوم الروع عهد ولا شرط % 12(@)(@@) % و لا رحم إلا وقد شجبت بكم ، % ومزقتموها مثل ما مزق المرط % 13(@)(@@) % ستدرس آثار المحبة بيننا ، % و نحن بنو عم كما انفرج المشط % 14(@)(@@) % كفرتم يدي فيكم ، فحل عقالها % % إلى غيركم ، لما يشد لها ربط % 15(@)(@@) % وما كنت إلا من يد الله معطيا ، % ألا إنه في كفه القبض والبسط % 16(@)(@@) % وهل عندكم عتبي ، فيرجع محسن % بعين الرضا ، والعفو ، نائله بسط % 17(@)(@@) % وإلا عزلت الأمر عني وعنكم ، % وكنت كأني ليس لي منكم رهط % 18(@)(@@) % و هل لكم من هذه غير زفرة ، % تصعد منكم في الصدور وتنحط % 19(@)(@@) % وإلا وعيد لا يسير بجنده ، % و حيات ضغن في مكامنها رقط % 20(@)(@@) % فمن يك ذا سلم ، فإني طبيبهث ، % و من يك مجنونا فعندي له سعط % PageV01P591 21(@)(@@) % فغانيتم إن مس حالكم الغنى ، % فلا تصرحوا باسمي إذا مسها الضغط % 22(@)(@@) % إذا ما التقت حلقات دهر عليكم ، % فيمنى يديه في أديمكم عط % 23(@)(@@) % وعند كمال الحظ يخشى زواله ، % كما لغريق اللجة الري والقحط % 24(@)(@@) % أأن مدني فرغ العلى ، فعلوتهث ، % وأمسككم بطن القرارة والهبط % 25(@)(@@) % سخطتم على الله العظيم قضاءه ، % سيمضي بما فيه ، إذا كثر اللغط % 26(@)(@@) % فيا لك حقا لا يقال لسامع ، % وجوهر حكم ما لمنثوره لقط % PageV01P592 البحر : رجز تام 1(@)(@@) % لما تولى النجم في انحطاط ، % وهم رأس الليل باشمطاط % 2(@)(@@) % شدوا لغزلان النقا العواطي ، % داهية تجول في الرباط % PageV01P593 البحر : كامل تام 1(@)(@@) % و كأنما النارنج في أغصانه ، % من خالص الذهب الذي لم يخلط % 2(@)(@@) % كرة رماها الصولجان إلى الهوا ، % فتعلقت في جوه لم تسقط % PageV01P594 البحر : مجزوء المديد 1(@)(@@) % راب دهر وسطا ، % و نأى ، وأفرطا % % 2(@)(@@) % لا كما كنت ترى % % بهجا مغتصبا % % 3(@)(@@) % ولقد أرضى ، ولا % % مثل شيبي سخطا % % 4(@)(@@) % أنبت الدهر لنا % % كل شيء فرطا % % 5(@)(@@) % ولقد أعدو على % % قارح رحب الخطا % % 6(@)(@@) % مقبل في دهمة ، % ببياض قمطا % % 7(@)(@@) % أي عير ضرطا 
ms104	 % % حثها واشترطا % % 8(@)(@@) % مشعل الميعة جوا % % ل ، إذا ما ربطا % % 9(@)(@@) % و إذا سار رمى % % بيديه القمطا % % 10(@)(@@) % كغزال فاته % فرع غصن فعطا % % PageV01P595 11(@)(@@) % وكأن لحيه % مفتحات سفطا % % 12(@)(@@) % فوطئنا عازبا ، % قد حلا وشمطا % % 13(@)(@@) % نشرت فيه أها % % ضيب الربيع نمطا % % 14(@)(@@) % وضممن وشيه ، % واقتسمن خططا % % 15(@)(@@) % فكأن نوره % نبذ شيب وخطا % % 16(@)(@@) % رفعت فيه الضحى % % للطيور لغطا % % 17(@)(@@) % آمنا وحشيه % إن علا ، أو هبطا % % 18(@)(@@) % تاركا ، برجله ، % كل أرض خبطا % % 19(@)(@@) % أيها العابث بي ، % سرفا وغلطا % % 20(@)(@@) % هل يروع يازيا % رزء أفراخ القطا % % PageV01P596 21(@)(@@) % ما على مقتنص % % 22(@)(@@) % نبهت سارية % أفعوانا أرقطا % % 23(@)(@@) % ضاربا مفترسا ، % وعلي سقطا % % PageV01P597 البحر : مجزوء الرمل 1(@)(@@) % قنع الرأس مشيبا ، % واكتسى لون الشمط % 2(@)(@@) % لا أرى فيه سوادا ، % غير أسنان المشط % PageV01P598 (@)(@@)(@@)(@@) | (@)(@@) البحر : رجز تام 1(@)(@@) % قاس على سفك الدماء فظ % ما بينه وبينهن وعظ % 2(@)(@@) % يعطي يديه ما أراد اللحظ % . . . . . . . . . . . . . . . . . . % PageV01P599 (@)(@@)(@@)(@@) | (@)(@@) البحر : كامل تام 1(@)(@@) % الدار أعرفها ربى ، وربوعا ، % لكن أساء بها الزمان صنيعا % % 2(@)(@@) % لبست ذيول الريح تعفو رسمها ، % ومصيف عام قد خلا وربيعا % % 3(@)(@@) % و بكيت من طرب الحمائم غدوة % تدعو الهديل وما وجدن سميعا % % 4(@)(@@) % ساعدتهن بنوحة وتفجع ، % وغلبتهن تفجعا ودموعا % % 5(@)(@@) % أفني العزاء هموم قلب موجع ، % فاحزن ، فلست بمثله مفجوعا % % 6(@)(@@) % حرمتك آرام الصريم ، وقطعت % حبل الهوى ونزعن عنك نزوعا % % 7(@)(@@) % إنا لننتاب العداة ، وإن نأوا ، % ونهز أحشاء البلاد جموعا % % 8(@)(@@) % و نقول فوق أسرة ومنابر ، % عجبا من القول المصيب بديعا % % 9(@)(@@) % قوم ، إذا غضبوا على أعدائهم ، % جروا الحديد أزجة ودروعا % % 10(@)(@@) % حتى يفارق هامهم أجسامهم ، % ضربا يفجر من دم ينبوعا % % PageV01P600 11(@)(@@) % وكأن أيدينا تنفر عنهم % % طيرا ، على الأبدان كن وقوعا % % 12(@)(@@) % وإذا الخطوب أتين منا مطرقا % نكصت على أعقابهن رجوعا % % 13(@)(@@) % وسقيت بالجود الفقير وذا الغنى ، % والغيث يسقي مجدبا ومريعا % 14(@)(@@) % ومتى تشأ في الحرب تلق مؤملا % منا ، مطاعا في الورى متبوعا % % 15(@)(@@) % يعدو به طرف يخال جبينه ، % ببياض غرة وجهه مصدوعا % % 16(@)(@@) % و كأن حد سنانه من عزمه ، % هذا وهذا 
ms105	 يمضيان جميعا % % 17(@)(@@) % يخفي مكيدته ، ويحسب رأيه ، % و هو الذي خدع الورى مخدوعا % % 18(@)(@@) % و هم قروم الناس دون سواهم ، % و الأطيبون منابتا وفروعا % % 19(@)(@@) % لا تعدلن بهم ، فذلك حقهم ، % و الشمس لا تخفى عليك طلوعا % % 20(@)(@@) % و غذا غدت شفعاء جود مبطئ % قد كد صاحب حاجة ممنوعا % % PageV01P601 21(@)(@@) % سبق المواعد والمطال عطاهم ، % و أتى رجاء الراغبين سريعا % % 22(@)(@@) % يا من رجا دركا بوجه شفاعة % ملكت رقك معما وشفيعا % % PageV01P602 البحر : رمل تام 1(@)(@@) % منزل أقوى بسلمى ، وربوع % تعذر الأنفاس فيه والدموع % 2(@)(@@) % ولقد كنت أراها آهلا % % ت ، كذاك الدهر يعصي ويطيع % 3(@)(@@) % كذب الدهر فما فيه سرور ، % يقلب الحال وينفض الجميع % 4(@)(@@) % أبط ما شئت وسر سيرا رويدا ، % إن سير الدهر بالمرء سريع % 5(@)(@@) % ذاك أفنانا ، ومن يبقى سوانا ، % يهلك الصابر منا والجزوع % 6(@)(@@) % و لقد بلغت أوطار العلى ، % ورعيت العيش والعيش مريع % 7(@)(@@) % إذ أمامي يدفع الحادث ع % % ني المليك الكامل البأس المنيع % 8(@)(@@) % ربما أغدو ، وطارت بفؤادي % % عنتريس ، نازع فيها القطيع % 9(@)(@@) % ذا صباح ، وطروق بظلام ، % وبكورا ، وقطا الأرض هجوع % 10(@)(@@) % خلد الغدر ، ولم يبق وفا ، % ليس إلا كاذب العهد قطوع % PageV01P603 11(@)(@@) % كلهم أعمى ، إذا ما كان خير ، % و لدي الشر بصير وسميع % 12(@)(@@) % وبدا لي في التجاريب ، إذا % % كثرت ، خزان سر سيذيع % 13(@)(@@) % فاكتم السر حبيبا وعدوا ، % فهو من هذا وهذاك يشيع % 14(@)(@@) % و لقد ألحقني بالصيد طرف ، % حنيت منه على القلب الضلوع % 15(@)(@@) % يستمد العتق من عرق كريم ، % فله الصفوة منه ، والصنيع % 16(@)(@@) % مائل العرق على الليت كماء % بذنوب فاض في الحوض رفيع % 17(@)(@@) % فقفونا الغيث لم يشرف ندى ، % وهوادي الوحش ، مرات وقوع % 18(@)(@@) % كل يوم يغسل الأرض بماء % ينفع النبت ، فقد تم الربيع % 19(@)(@@) % فإذا الغدران بالريح أحست ، % خلتها يلقى عليهن الدروع % PageV01P604 البحر : طويل 1(@)(@@) % نهى الجهل شيب الرأس بعد نزاع ، % وما كل ناه ناصح بمطاع % 2(@)(@@) % رأت أقحوان الشيب لاح وآذنت % ملاحات أيام الصبا بوداع % 3(@)(@@) % فقالت : محاك الدهر في صبغة الصبا ، % و كنت 
ms106	 من الفتيان خير متاع % 4(@)(@@) % شرير ، فإن الدهر هدم قوتي ، % ولم يغن عني حيلتي ، ودفاعي % % 5(@)(@@) % وشيبني في كل يوم وليلة ، % تنظر داعي الحتف أول داع % 6(@)(@@) % و إن الجديدين اللذين تضمنا % % قيادي بأحداث إلي سراع % 7(@)(@@) % هما أنصفاني قبل ، إذ أنا ناشىء % وقد صارعاني بعد أي صراع % 8(@)(@@) % كناقضة أمرارها ، حين أحكمت % قوى حبل خرقاء اليدين ، صناع % 9(@)(@@) % و غيظا على الأعداء لا يجرعونه ، % وكيل لهم منه بأوفر صاع % 10(@)(@@) % وإخوان شر قد حرثت إخاءهم ، % فكانوا لفرس الود شر بقاع % PageV01P605 11(@)(@@) % قدحت زناد الوصل بيني وبينهم ، % فأذكيت نارا ، غير ذات شعاع % 12(@)(@@) % ولما نأوا عني بود نفوسهم ، % غلبت حنيني نحوهم ، ونزاعي % % 13(@)(@@) % ومكرمة عند السماء منيفة ، % تناولها مني بأطول باع % 14(@)(@@) % و كم ملك قاسى العقاب ، ممنع ، % قدير على قبض النفوس مطاع % 15(@)(@@) % أراه ، فيعديني من المكر ما به ، % فأكرم عنه شيمتي وطباعي % % 16(@)(@@) % وإني لأستوفي المحامد كلها ، % و قد بقيت لي بعدهن مساع % 17(@)(@@) % و تصدقك الأنباء إن كنت سائلا ، % وحسبك مما لا ترى ، بسماع % % PageV01P606 البحر : طويل 1(@)(@@) % عليم بما تحت الصدور من الهوى ، % سريع بكر اللحظ ، والقلب جازع % 2(@)(@@) % و يجرح أحشائي بعين مريضة ، % كما لان متن السيف ، والسيف قاطع % PageV01P607 البحر : طويل 1(@)(@@) % وغادر مني الدهر عضبا مهندا ، % يفل شبا خصمي ، وقلبا مشيعا % % 2(@)(@@) % وجودا يحل الكف عن خير مالها % % إذا عقدت كف البخيل تمنعا % % 3(@)(@@) % و إن تطلبني في الحروب تلاقني % % أهز حساما كلما هز قطعا % % 4(@)(@@) % تخال غديرا غير أن ليس جاريا ، % ولا مرويا إن أنت حاولت مكرعا % % PageV01P608 البحر : منسرح 1(@)(@@) % أصبح سري في الحب قد شاعا ، % وصرت عبدا في الحب مطواعا % % 2(@)(@@) % لا تعذلوني ، فقد برمت بكم ، % و اجتنبوا نصحكم ، فقد ضاعا % % 3(@)(@@) % أفنى رجائي بخلفه رشأ ، % يدير لحظا بالوعد خداعا % % 4(@)(@@) % مجدد للوصال مخلقه ، % فديته معطيا ومناعا % % PageV01P609 البحر : طويل 1(@)(@@) % وأنت الذي ذللت للناس جانبي ، % وأكثرت أحزان الفؤاد المروع % 2(@)(@@) % وأسقيت عيني ريها من دموعها ، % و علمتها لحظ المريب المفزع % 3(@)(@@) % و ما 
ms107	 كنت أعطي الحب والدمع طاعة ، % فما شئت يا عيني من الآن فاصنعي % % 4(@)(@@) % ولم أر عند الصبر وجه شفاعة ، % إلى غير معشوق من الدمع ، فاشفعي % % 5(@)(@@) % ألست ترى النجم ، الذي هو طالع % عليك ، فهذا للمحبين نافع % 6(@)(@@) % عسى يلتقي في الأفق لحظي ولحظه ، % فيجمعنا إذ ليس في الأرض جامع % PageV01P610 البحر : كامل تام 1(@)(@@) % بعث الخيال إلي ، وامتنعا ، % ريم مضت نفسي له تبعا % % 2(@)(@@) % ما زال طول الليل مرتحلا ، % يلقى المتيم كلما هجعا % % PageV01P611 البحر : سريع 1(@)(@@) % يتيه عندي ، وأنا أخضع ، % إن كان ذا بختي ، فما أصنع % 2(@)(@@) % يا عاذلي عذلك لي ضائع ، % أسمعتني ، والحب لا يسمع % PageV01P612 البحر : طويل 1(@)(@@) % أأسمع ما قال الحمام السواجع ، % وصايح بين في ذرى الأيك واقع % 2(@)(@@) % منعنا سلام القول ، وهو محلل ، % سوى لمحات ، أو تشير الأصابع % 3(@)(@@) % تابى العيون البخل ، إلا نميمة ، % بما كتبت من خدهن البراقع % 4(@)(@@) % وإني لمغلوب على الصبر ، إنه % كذلك جهل المرء للحب صارع % 5(@)(@@) % كأن الصبا هبت بأنفاس روضة % لها كوكب في ذروة الشمس لامع % 6(@)(@@) % توقد فيها النور من كل جانب ، % وبللها طل مع الليل دامع % 7(@)(@@) % و شق ثراها عن أقاح ، كأنها % % تهادت بمسك نفحها والأجارع % 8(@)(@@) % ألا أيها القلب الذي هام هيمة % بشرة حتى الآن هل أنت راجع % 9(@)(@@) % إذ الناس عن أخبارنا تحت غفلة ، % وفي الحب إسعاف وللشمل جامع % 10(@)(@@) % و غذ هي مثل البدر يفضح ليله ، % وإذ أنا مسود المفارق يافع % PageV01P613 11(@)(@@) % وغاصت بأعناق المطي كأنها % % هياكل رهبان عليها الصوامع % 12(@)(@@) % و راحت من الديرين تستعجل الخطى % % كأن ذفاراها جفار نوابع % 13(@)(@@) % أذا ليلة ظلت عليه مطيرة ، % تجافت به حتى الصباح المضاجع % 14(@)(@@) % غدا يلمح الأفق المريب بطرفه ، % وفي قلبه من خيفة الإنس رائع % 15(@)(@@) % لعمري لئن أمسى الإمام ببلدة % وأنت بأخرى شائق القلب نازع % 16(@)(@@) % لقد رمت ما يدنيك منه ، وإنما % % أتى قدر والله معط ومانع % 17(@)(@@) % و إني كالعطشان طال به الصدى % % إليك ، ولكن ما الذي أنا صانع % 18(@)(@@) % أيذهب عمري والعوائق دونه ، % على 
ms108	 ما أرى ، إني إلى الله راجع % 19(@)(@@) % و ما أنا في الدنيا بشيء أنا له ، % سوى أن أرى وجه الخليفة ، قانع % 20(@)(@@) % وهبني أريت الحاسدين تجلدا ، % فكيف بحب ضمنته الأضالع % PageV01P614 21(@)(@@) % وإني لنعماه القديمة شاكر ، % وراء بعين النصح فيه ، وسامع % 22(@)(@@) % وما أنا من ذكر الخليفة آيس ، % وما دام حيا عللته المطامع % 23(@)(@@) % وأقعدني عنه انتظار لإذنه ، % و ما قال من شيء ، فإني طائع % 24(@)(@@) % صراط هدى يقضي على الجور عدله ، % و نور على الدنيا من الحق ساطع % 25(@)(@@) % وسيف انتقام لا يخاف ضريبة ، % وما شاء من ذي إحنة فهو قاطع % 26(@)(@@) % وإن يعف لا يندم وإن يسط ينتقم ، % فهل عادل فيها بما أنت واقع % PageV01P615 البحر : وافر تام 1(@)(@@) % عليك بذا وذا واقطع وواصل ، % وفارق كلما قد كنت معه % 2(@)(@@) % ومن أحببت فاعذر واسل عنه ، % و مقلوب الوفا أن لا تدعه % PageV01P616 البحر : بسيط تام 1(@)(@@) % يا قاتلا لا يبالي بالذي صنعتا ، % رميت قلبي ، بسهم الحب ، فانصدعا % % 2(@)(@@) % لولا القضيب الذي يهتز فوق نقا ، % شككت فيك ، وفي البدر الذي طلعا % % 3(@)(@@) % قد تبت من توبتي بعد الصلاح وكم % % مسافر في التقى والنسك قد رجعا % % 4(@)(@@) % مات الهدى ، ثم أحياه بطلعته ، % فاليوم يبدع في قتلي له بدعا % % 5(@)(@@) % ألا ترى بهجة الأيام قد رجعت ، % و الناس في ملك والدين قد جمعا % % 6(@)(@@) % يا خاضب السيف قد شدت مآزره ، % وابن الحروب التي من ثديها رضعا % % 7(@)(@@) % فرقت بالسيف ، يا أعلى الملوك يدا ، % عن ابن مدرك الطائي ، وما جمعا % % 8(@)(@@) % كم من عدو أبحت السيف مهجته ، % والسيف أحسم للداء الذي امتنعا % % 9(@)(@@) % دسست كيدا له تخفي مسالكه ، % كأنه فارس في قوسه نزعا % % 10(@)(@@) % تنال روعته من لا يراد به ، % فإن رأى الشمس منه جانب لمعا % % PageV01P617 البحر : مجزوء الكامل 1(@)(@@) % قل للأمير سلمت لل % % دنيا ، وشعب صدوعها % % 2(@)(@@) % قد نلت مهر خلافة ، % لم تخط حسن صنيعها % % 3(@)(@@) % وحويت بنت وزارة ، % كالشمس حين طلوعها % % 4(@)(@@) % إن الأصول تفرقت ، % فتعانقت بفروعها % % PageV01P618 البحر : طويل 1(@)(@@) % لقد لطف الرحمن 
ms109	 بابنة قاسم ، % و دافع عنها بالجميل من الصنع % 2(@)(@@) % و كان من الأمر الذي كان فانقضى ، % و رد قضيب النبع في مغرس النبع % PageV01P619 البحر : طويل 1(@)(@@) % تمكن هذا الدهر مما يسوءني ، % ولج فما يخلي صفاتي من قرع % 2(@)(@@) % وأبليت آمالي بوصل يكدها ، % وليس بذي ضر وليس بذي نفع % 3(@)(@@) % لئيم ، إذا جاد اللئيم تخلقا ، % يحب سؤال القوم شوقاص إلى المنع % PageV01P620 البحر : طويل 1(@)(@@) % أيا رب لا تقبل صلاة معاشر % يؤمهم دير النميري ركعا % % 2(@)(@@) % تقدم يوما للصلاة ، فخلته % حمارا أمام الركب سار فأسرعا % % PageV01P621 البحر : كامل تام 1(@)(@@) % يا عائدا قد جاء يشمت بي ، % قد زدت في سقمي ، وأوجاعي % % 2(@)(@@) % و سألت ، لما غبت عن خبري ، % كم سائل ليجيبه الناعي % % PageV01P622 البحر : مجزوء الرجز 1(@)(@@) % أقبل يفري ويدع ، % ممتلىء اللحظ جزع % 2(@)(@@) % مستروعا ولم يرع ، % تضره ، إذا رفع % 3(@)(@@) % لما رأى وجه الفزع ، % وريب دهر قذ خدع % 4(@)(@@) % و حم موت ونقع ، % فقطع البعد قطع % 5(@)(@@) % وليس في العيش جزع % . . . . . . . . . . . . . . . % PageV01P623 البحر : بسيط تام 1(@)(@@) % قد قرب الله منا كل ما امتنعا ، % كأنني بهلال العيد قد طلعا % % 2(@)(@@) % فخذ لفطرك قبل العيد أهبته ، % فإن شهرك في الواوات قد وقعا % % PageV01P624 البحر : متقارب تام 1(@)(@@) % أتتني دجلة فيما أتت ، % فما يصنع البحر ما تصنع % 2(@)(@@) % فكم من جدار لنا مائل ، % وآخر يسجد أو يركع % 3(@)(@@) % ويمطرنا السقف من بيننا ، % ومن تحتنا أعين تنبع % 4(@)(@@) % و أصبح بستاننا جوبة % يسبح في مائها الضفدع % PageV01P625 البحر : متقارب تام 1(@)(@@) % نفى ظلمة الشعر نور الجبي ، % ن ، فأمسيت أجلح يا أصلعا % % 2(@)(@@) % و هل يملك الفجر إلا الربي % % ب ، ولا بد للفجر أن يطلعا % % PageV01P626 البحر : رمل تام 1(@)(@@) % روضة من قرقف أنهارها ، % و غناء الورق فيها في ارتفاع % 2(@)(@@) % لا تلم أغصانها إن رقصت ، % فهي ما بين شراب وسماع % PageV01P627 (@)(@@)(@@)(@@) | (@)(@@) البحر : متقارب تام 1(@)(@@) % صلاتك بين الملا نقرة ، % كما استلب الجرعة الوالغ % 2(@)(@@) % و تسجد من بعدها سجدة ، % كما ختم المزود الفارغ % PageV01P628 البحر : كامل تام 1(@)(@@) % إني أرى شرا تأجج ناره 
ms110	 ، % وغدير مملكة كثير الوالغ % 2(@)(@@) % والناس قد ركبوا مطايا باطل ، % والحق وسطهم برحل فارغ % PageV01P629 البحر : كامل تام 1(@)(@@) % قطعته يوما ، وليس يطيعه ، % هيهات إن قناته لم تمضغ % 2(@)(@@) % ظلت تخوفني لقاء منيتي ، % فأحلها ، يا هند مما أبتغي % % 3(@)(@@) % وأطلت بي سفر الملامة والأذى ، % فاثني الركاب هنيد إن تتبلغي % % 4(@)(@@) % صيري إلى عذري فإني مشتر % بالجود من جود الإله الأسبغ % 5(@)(@@) % يا من يناجي صعبة في نفسه ، % و يدب من تحت الأفاعي اللدغ % 6(@)(@@) % ويبيت ينهض زفرة في صدره % مني ، فإن دميت جراحي يولغ % 7(@)(@@) % ويظل منتهكا لعرضي آمنا ، % ويسر حين يخاف حسن المربغ % 8(@)(@@) % نغلت ضمائر صدره من دائه ، % نغل الإهاب معطلا لم يدبغ % 9(@)(@@) % لا تبتغي مني التي لا أبتغي ، % إن كنت مشغولا بشأني فافرغ % 10(@)(@@) % أنهاك غير معاتب عن خطة ، % حزن مقومة زيوغ الزيغ % PageV01P630 11(@)(@@) % عندي لأبناء السخائم وطأة % ترمي رؤوسهم ، إذا لم تدمغ % 12(@)(@@) % و يخاف شيطان النفاق مواقفي ، % وإذا ر ني حاضرا لم ينزغ % 13(@)(@@) % يعطي العنان ، إذا رآه ، رأسه % طوعا ويعطي سوطه ما يبتغي % % 14(@)(@@) % و كانما شقت عليه غلالة % بيضاء من زبر الحديد المفرغ % 15(@)(@@) % وتخاله ، يوم الرهان ، غمامة ، % خطرت بريح في غمائم فرغ % 16(@)(@@) % و مهندا من عهد عاد صارما ، % إن يطلب إتلاف نفس يبلغ % 17(@)(@@) % يلقى الضريبة حده فيقدها % % قد الأديم ومتنه لم يضبغ % 18(@)(@@) % هذا إلى ضافي الذيول مضاعف % كالسلخ من قمص الحديد مسبغ % 19(@)(@@) % وقضيب نبع كالشجاع معطف % لرسائل الموت الزعاف مبلغ % 20(@)(@@) % يحدو إلي قذاذة مقذوذة % قذ الحواجب ، بالدماء مولغ % PageV01P631 البحر : رجز تام 1(@)(@@) % قد أغتدي ، وفي الدجى مبالغ ، % و الفجر للساقة منها صائغ % 2(@)(@@) % ومنه للصبح خطيب نابغ ، % و الليل في المغرب عنه رائغ % 3(@)(@@) % بمشرفي في الدماء والغ ، % قد له قميص وشي سابغ % 4(@)(@@) % ومنسر ماضي الشباة دامع ، % يملأ كفيه جناح فارغ % PageV01P632 (@)(@@)(@@)(@@) | (@)(@@) البحر : طويل 1(@)(@@) % ومن دون ما أبديت لي يقتل الفتى ، % و يمسي جليد القوم وهو ضعيف % 2(@)(@@) % و لم أدر أن البان يغرس في النقا 
ms111	 ، % و لا أن شمسا في الظلام تطوف % PageV01P633 البحر : خفيف تام 1(@)(@@) % قل لذات النقاب إن محبا ، % قد قرا من سطور حسنك حرفا % % 2(@)(@@) % يسأل الله منك رحمة قلب ، % بين وصل وهجرة تتكفا % % PageV01P634 البحر : متقارب تام 1(@)(@@) % أيا من فؤادي به مدنف ، % حجبت ، فلي دمعة تذروف % 2(@)(@@) % إذا منعوا مقلتي أن ترا % % ك ، فقلبي يراك ولا يطرف % PageV01P635 البحر : طويل 1(@)(@@) % لعمرك ماأزرت بيوسف لحية ، % و لكنه قد زاد حسنا ، وأضعفا % % 2(@)(@@) % فلا تعتذر في حبه في التحائه ، % فما يحسن الدينار إلا مشنفا % PageV01P636 البحر : خفيف تام 1(@)(@@) % أنا يا قوم من فؤادي وطرفي % % في أمور تجل عن كل وصف % 2(@)(@@) % مقلتي تورث الهموم فؤادي ، % وفؤادي بالدمع يكلم طرفي % % PageV01P637 البحر : سريع 1(@)(@@) % خل لنا دمنا على وصله ، % ونفسه ليست لنا منصفه % % 2(@)(@@) % لم يقرنا مذ بعدت دارنا ، % منه سلام الله عن معرفه % % PageV01P638 البحر : مخلع البسيط 1(@)(@@) % يا رب عاف الوزير ، واصرف % بي عنه مكروه كل صرف % 2(@)(@@) % أصلح بيني ، وبين دهري ، % وقام بيني وبين حتفي % % PageV01P639 البحر : خفيف تام 1(@)(@@) % كيف لي بالسلو يا شر كيفا ، % كيف للعين أن ترى منك طيفا % % 2(@)(@@) % وابن بشر يلومني في شرير ، % يا ابن بشر جرحت بالعرض سيفا % % PageV01P640 البحر : طويل 1(@)(@@) % قويت على الهجران حتى مللتني ، % ولكنني عن حمل هجرك أضعف % 2(@)(@@) % لعمرك قد أحببتك الحب كله ، % وزدتك حبا لم يكن قط يعرف % 3(@)(@@) % سقى الله نهر الكرخ ما شاء جوده ، % فإني به حتى الممات مكلف % 4(@)(@@) % ولا حرم القصر الخليج وجسره ، % وقصر لأشناس عليه مشرف % 5(@)(@@) % تدور علينا الراح من كف شادن ، % له لحظ عين يشتكي السقم مدنف % 6(@)(@@) % كأن سلاف الخمر من ماء خده ، % وعنقودها من شعره الغض يقطف % 7(@)(@@) % أتعذلني في يوسف وهو من ترى ، % ويوسف أبلاني ، ويوسف يوسف % PageV01P641 البحر : متقارب تام 1(@)(@@) % بنفسي مستسلم للرقاد ، % يحدثني السكر من طرفه % 2(@)(@@) % سريع إلى الأرض من حينه ، % بطيء إلى الكأس من كفه % PageV01P642 البحر : - 1(@)(@@) % بشر بالصبح هتفا % % مستوفيا للجدار مشترفا % % 2(@)(@@) % مذكرا بالصبوح صاح بنا ، % كخاطب 
ms112	 فوق منبر وقفا % % 3(@)(@@) % صفق إما ارتياحة لسنى ال % % فجر ، وإما على الدجى أسفا % % 4(@)(@@) % فاشرب عقارا كأنها قبس % قد سبك الدهر تبرها فصفا % % 5(@)(@@) % تدمي فدام الإبريق من دمها % % كأنه راعف ، وما رعفا % % 6(@)(@@) % بكف ساق حلو شمائله ، % مكره لحظ عينه صلفا % % 7(@)(@@) % يقطر مسكا ، على غلائله ، % شعر نقا بالعبير قد وكفا % % 8(@)(@@) % أفرغ من درة وعنبره % % حسنا وطيبا في خلقه ائتلفا % % 9(@)(@@) % يطيب الريح حين يمسحه ، % فما بريح هبت عليه خفا % % 10(@)(@@) % أراق فيها المزاج فاشتعلت % كمثل نار أطعمتها سعفا % % PageV01P643 البحر : طويل 1(@)(@@) % ألا فاسقنيها قد مشى الصبح في الدجى % % عقارا ، كلون النار حمراء قرقفا % % 2(@)(@@) % فناولني كأسا أضاء بنانه % تدفق ياقوتا ، ودرا مجوفا % % 3(@)(@@) % ولما أذقناها المزاج تسعرت ، % فخلت سناها بارقا متكثقا % % 4(@)(@@) % يطوف بها ظبي من الإنس شادن ، % يقلب طرفا فاسق اللحظ مدنفا % % 5(@)(@@) % عليما بألحاظ المحبين حاذقا % بتسليم عينه ، إذا ما تخوفا % % 6(@)(@@) % فظل يناجيني ، ويقلب طرفه ، % بأطيب من نجوى الأماني وألطفا % % 7(@)(@@) % و يصرف أسرار الهوى عن عداتها ، % و يلقى بها ، من حبها ، المتلقفا % % PageV01P644 البحر : وافر تام 1(@)(@@) % و ندمان سقيت الراح صرفا ، % و أفق الصبح مرتفع السجوف % 2(@)(@@) % صفت وصفت زجاجتها عليها ، % كمعنى دق في ذهن لطيف % PageV01P645 البحر : مجزوء الكامل 1(@)(@@) % ذم الزمان لدمنة % بين المشقر والصفا % % 2(@)(@@) % و كأنما نشرت بها % % أيدي الليالي مصحفا % % 3(@)(@@) % قلقت لساكنها وحم % % ل إنائهم حتى انكفا % % 4(@)(@@) % فيها ثلاث كالعوائد % ئد يكتنفن المدنفا % % 5(@)(@@) % من كل خالدة كست % % ها النار لونا أكلفا % % 6(@)(@@) % ومشجج ذي لمة ، % ثاو بربع قد عفا % % 7(@)(@@) % ألف القفار فإن هفت % % عنه ضواريه هفا % % 8(@)(@@) % لا يشتكي ذل الهوا % % ن ، ولا يمن ، إذا وفى % % 9(@)(@@) % نصب كحرباء الفلاة ، % مضى الجميع ، وخلفا % % 10(@)(@@) % بل هل ترى ذا الظعن لو % % قامت رفاقي لاشتفى % % PageV01P646 11(@)(@@) % لا ناصر من رعبه ، % أبدا ، يوليني القفا % % 12(@)(@@) % كم دوست رجلي العدا % % ة ، وما بها عنه حفا % % 13(@)(@@) % أثبت لضغنهم ، ولا % % تك في العداوة أضعفا % % 14(@)(@@) % و إذا الرياح أطاعها 
ms113	 % % ميل القضيب تقصفا % % 15(@)(@@) % زعمت هنيدة أنني % % ممن يبيت على شفا % % 16(@)(@@) % و لقد هززت مهندا ، % عضب المضارب مرهفا % % 17(@)(@@) % و غذا سطا سطت المنو % % ن به ، وتعفو إن عفا % % 18(@)(@@) % حتى إذا ملأ الثرى % % بار سار ، فأوجفا % % 19(@)(@@) % عضب المضارب كالغدي % % ر نفى القذى حتى صفا % % 20(@)(@@) % ماذا بأول حادث ، % كشفته ، فتكشفا % % PageV01P647 21(@)(@@) % فولجت فيه صابرا ، % وخرجت منه مثقفا % % 22(@)(@@) % و إذا رمت شخصي العدا % % ة بنبلها صارت سفى % % 23(@)(@@) % و غذا حديث الذم ي % % ممني ونى وتخلفا % % 24(@)(@@) % وإذا العيون تعرضت % كانت لعيني أشغفا % % 25(@)(@@) % إن كنت جاهلة ، فخلي % % من يديك الأعرفا % % 26(@)(@@) % فغذا تبدى مقبل ، % أنحى عليه ، فاشتفى % % 27(@)(@@) % بل قد هديت لبارق % هاج الفؤاد المدنفا % % 28(@)(@@) % ما زال يصدع مزنة ، % صدع النجاد المدلفا % % 29(@)(@@) % يقظان يلفظ نوره % نورا تألق ، واختفى % % 30(@)(@@) % والرعد يحدو ظعنه ، % فإذا تأخر عنفا % % PageV01P648 31(@)(@@) % كالعاذلات تأخرت % بالسيف شمعا مترفا % % 32(@)(@@) % طورا ، وطورا لا يعي % % زجرا به ، . . . وتقصفا % % 33(@)(@@) % حتى حسبت سحابه % نوقا تحامل زحفا % % 34(@)(@@) % سيقت ، ولا تألو على % % أولادهن تعطفا % % 35(@)(@@) % حيران يضني ثقله % هوج الرياح العصفا % % 36(@)(@@) % بلواحق مملوءة % ماء ، وزادا عرفا % % 37(@)(@@) % وكأن هاتن وبله % قطن أطير مندفا % % 38(@)(@@) % % جبلا ثوى واحقوقفا % % 39(@)(@@) % % ط النور فيه وزخرفا % % 40(@)(@@) % فتن العيون ، فخلته % بردا أجيد مفوفا % % PageV01P649 41(@)(@@) % و كان نشر الأرض بالأ % % نوار حين تلحفا % % 42(@)(@@) % ملك عليه جوهر ، % في سندس قد أكنفا % % 43(@)(@@) % وتخال كل قرارة % دمعا ، يحول موقفا % % 44(@)(@@) % يا سلم عرفني المشي % % ب وحق لي أن أعرفا % % 45(@)(@@) % ووجدت كف الموت أق % وى الآخذين وألطفا % % 46(@)(@@) % وبقيت بعد معاشر ، % مثل الردي تخلفا % % 47(@)(@@) % خلوا على الباقي الأسى ، % ونجا الفقيد مخففا % % 48(@)(@@) % و لقد أراني بالصبا ، % و الغانيات مكلفا % % 49(@)(@@) % أسقى مخدرة الدنا % % ن سلاف كرم قرقفا % % 50(@)(@@) % راح كأن حبابها % % ذر يجول مجوفا % % PageV01P650 51(@)(@@) % حظ من الدنيا مضى ، % لو كان منع أو شفا % % 52(@)(@@) % و الدهر من أخلاقه اس % % ترجاع ما قد سلفا % % PageV01P651 البحر : بسيط تام 1(@)(@@) % غفرت 
ms114	 ذنب النوى إذ كنت باخله ، % أيام أمكن منك الود واللطف % 2(@)(@@) % لم يفعل البين ، إلا ما فعلت ، وما % % بين الأخلاء إلا المطل والخلف % PageV01P652 البحر : طويل 1(@)(@@) % بني عمنا عودوا نعد لمودة ، % فإنا إلى الحسنى سراع التعطف % 2(@)(@@) % وإلا ، فإني لا أزال عليكم % محالف أحزان كثير التلهف % 3(@)(@@) % لقد بلغ الشيطان من آل هاشم % مبالغه من قبل في آل يوسف % PageV01P653 البحر : رجز تام 1(@)(@@) % بت بليل كله لم أطرف ، % قرقسه كالرمش المنتف % 2(@)(@@) % يلسعنا بشعر مجوف ، % يعذب المهجة ، إن لم يتلف % 3(@)(@@) % و يثقب الجلد وراء المطرف ، % حتى ترى فيه كشكل المصحف % 4(@)(@@) % أو مثل رش العصفر المدوف % . . . . . . . . . . . . . . . % PageV01P654 البحر : كامل تام 1(@)(@@) % يا من أراه لج في طيرانه ، % أخطر ببالك ، إن عقلت ، وقوفا % % 2(@)(@@) % وإذا ذكرت ، وكدت ، فاذكر أنه % % ليس الثناء لما أردت مطيفا % % PageV01P655 البحر : بسيط تام 1(@)(@@) % لا تنكرن إذا أهديت نحوك من % % علومك الغر أو آدابك النتفا % % 2(@)(@@) % فقيم الباغ قد يهدي لصاحبه ، % برسم خدمته ، من باغه التحفا % % PageV01P656 البحر : مجزوء الكامل 1(@)(@@) % خل العدو ، فدهره % % يشفيك منه صروفه % % 2(@)(@@) % و الوعد دين ، والعطا % % مستعيب تسويفه % % 3(@)(@@) % إن الكريم مخلد ، % و حياته معروفه % % PageV01P657 (@)(@@)(@@)(@@) | (@)(@@) البحر : بسيط تام 1(@)(@@) % يا قلب ! قد جد بين الحي فانطلقوا ، % علقتهم هكذا حينا وما علقوا % % 2(@)(@@) % فتلك دارهم أمست مجددة ، % وبالأبارق منهم منزل خلق % 3(@)(@@) % كأن آثار وحشي الظباء بها % % درع تخلفه أظلافه نسق % 4(@)(@@) % لا مثل من يعرف العشاق حبهم ، % بل أنت من بينهم تشقى بمنتمق % 5(@)(@@) % نأوا بليل ، فزموا كل يعملة ، % و يعمل جمل في أنفه الحلق % 6(@)(@@) % يلقى الفلاة بخف لا يقر بها ، % كأن تنقيطه في تربها طبق % 7(@)(@@) % إني وأسماء والحي الذين غدوا % % بها على الكره من نفسي وما وثقوا % % 8(@)(@@) % لكالربيط ، وقد سيقت قرينته ، % ينازع الحبل مشدودا وينطلق % 9(@)(@@) % فطيروا القلب وجدا بين أضلعه ، % و عذبوا النفس حتى ما بها رمق % 10(@)(@@) % كأنني ساورتني ، يوم بينهم ، % رقشاء مجدولة في لونها برق % PageV01P658 11(@)(@@) % كأنها ، حين تبدو من مكامنها ، % غصن تفتح فيه النور 
ms115	 والورق % 12(@)(@@) % ينسل منها لسان يستغيث به ، % كما تعوذ بالسبابة الفرق % 13(@)(@@) % ما أنس لا أنس ، إذ قامت تودعنا % % بمقلة جفنها في دمعها غرق % 14(@)(@@) % تفتر عن مقلة حمراء موقدة % تكاد لولا دموع العين تحترق % 15(@)(@@) % كأنها ، حين تبدو من مجاسدها ، % بدر تمزق في أركانه الغسق % 16(@)(@@) % و فتية كسيوف الهند قلت لهم : % سيروا قما أخطأوا قولي وما خرقوا % % 17(@)(@@) % ساروا وقد خضعت شمس الأصيل لهم % % حتى توقد في ثوب الدجى الشفق % 18(@)(@@) % لحاجة لم أضاجع دونها وسنا ، % وربما جاب أسباب الكرى الأرق % 19(@)(@@) % لا أشرب الماء إلا وهو منجرد % من القذى ولغيري الشوب والرنق % 20(@)(@@) % عزمي حسام ، وقلبي لا يخالفه ، % إذا تخاصم عزم المرء والفرق % PageV01P659 21(@)(@@) % ميت السرائر ضحاك على حنق ، % ما دام يعدز عن أعدائي الحنق % % PageV01P660 البحر : - 1(@)(@@) % لج الفراق من عشقا ، % ما الدمع إلا للنوى خلقا % % 2(@)(@@) % أرأيت لحظتها ، وما صنعت ؟ % هل بعدها للعاشقين بقا % % PageV01P661 البحر : مجزوء الرجز 1(@)(@@) % قل لمراض الحدق ، % وطرر من حلق % 2(@)(@@) % هل في فؤادي للهوى ، % أو جسدي شيى بقي % % 3(@)(@@) % إن لم ترووا عطشي ، % بخلا ، فبلوا رمقي % % 4(@)(@@) % يا مقلة أجفانها % % مفتوقة بالأرق % 5(@)(@@) % بقيت في رق الهوى % % شقية ، فيمن شقي % % PageV01P662 البحر : مجزوء الخفيف 1(@)(@@) % و غزال مقرطقش ، % ذي وشاح ممنطق % 2(@)(@@) % زين الله خده ، % بعذار معلق % 3(@)(@@) % لم أكن فيه بدعة ، % كنت ممن به شقي % % 4(@)(@@) % يا محل السقام بي ، % خذ من الحب ما بقي % % PageV01P663 البحر : كامل تام 1(@)(@@) % و متيم جرح الفراق فؤاده ، % فالدمع من أجفانه يتدفق % 2(@)(@@) % بهرته ساعة فرقة ، فكأنما % % في كل عضو منه قلب يخفق % PageV01P664 البحر : طويل 1(@)(@@) % أما علمت عيناك أني أحبها ، % كما كل معشوق عليم بعاشق % 2(@)(@@) % ألم تر عيني ، وهي تسرق نظرة % إليها على خوف بعبرة وامق % 3(@)(@@) % أراني سأبدي حبه متعرضا ، % وإن لم أكن في الحب منه بواثق % PageV01P665 البحر : مجزوء الكامل 1(@)(@@) % ما لي وما لك يا فراق ، % أبدا رحيل ، وانطلاق % 2(@)(@@) % يا نفس موتي بعدهم ، % فكذا يكون الاشتياق % 3(@)(@@) % كذب الهوى متصنع 
ms116	 ، % الحب شيى لا يطاق % PageV01P666 البحر : كامل تام 1(@)(@@) % بفناء مكة للحجيج مواسم ، % والياسرية موسم العشاق % 2(@)(@@) % ما زلت أنتقد الوجوه بنظرتي ، % نقد الصيارف جيد الأوراق % PageV01P667 البحر : كامل تام 1(@)(@@) % ما بال قلبك لا يقر خفوقا ، % وأراك ترعى النسر والعيوقا % % 2(@)(@@) % و جفون عينك قد نثرن من البكا % % فوق المدامع لؤلؤا وعقيقا % % 3(@)(@@) % لو لم يكن إنسان عينك سابحا % في بحر دمعته ، لمات غريقا % PageV01P668 البحر : وافر تام 1(@)(@@) % ألم تعلم بما صنع الفراق ، % عشية جد بالحي انطلاق % 2(@)(@@) % بلى ! قد مات من جزع وخلى % % مع الأظعان مهجته تساق % 3(@)(@@) % و ليس عليه شيء غير هذا ، % كذاك يميت بالخوف الفراق % 4(@)(@@) % و ما ادري وقد حثوا المطايا ، % أيحمل شر برق أم براق % 5(@)(@@) % فكم رد الأعنة من جموح % ورد دموع حزن لا تطاق % PageV01P669 البحر : طويل 1(@)(@@) % كفى حزنا أني بقولي شاكر % لغيري وتخفى ، وبعد ذاك الحقائق % 2(@)(@@) % وجل ، فما أجزيه إلا بشكره ، % فيا ليته يدري بأني صادق % PageV01P670 البحر : كامل تام 1(@)(@@) % قرب الحبيب إلى المحب الوامق ، % من بعد ما فتك الفراق بعاشق % 2(@)(@@) % فالآن قد لوت النوى أعناقها ، % ودنا من الأوطان كل مفارق % 3(@)(@@) % أقدم ، أمير المؤمنين ، على الرضا ، % واسلم لإهلاك العدو المارق % 4(@)(@@) % أسد بدا من غابه فتضعضعت % منه الثعالب ، عند شد صادق % 5(@)(@@) % حتى إذا عرفوا الهدى ، ورمت يد % ما جمعت لمخاتل ، ولسارق % 6(@)(@@) % شام السيوف وقد رأين مواقعا ، % في أرؤس وكواهل وعواتق % 7(@)(@@) % حلما وإبقاء ، ورأفة واسع ال % % إنعام لا كز ، ولا متضايق % 8(@)(@@) % وثنى أعنته ، ولو حضر الوغى % % كانت دماؤهم كنفثة باصق % 9(@)(@@) % سيروا على خط الطريق ، فإنه % إن رحتم للنكث أسرع لاحق % 10(@)(@@) % لا تحسبوا اليوم الجديد كأمسكم ، % أين الصباح من الظلام الغاسق % PageV01P671 البحر : كامل تام 1(@)(@@) % هذا الفراق ، وكنت أفرقه ، % قد قربت للبين أينقه % 2(@)(@@) % وأكف دمع العين من حذر ، % والدمع يسبقني ، وألحقه % 3(@)(@@) % يجري دمي دمعا عليك ، وكم % % يبدو بكا عيني وأسرقه % 4(@)(@@) % رشأ كساه الحسن خلعته ، % وجرى على خديه رونقه % 5(@)(@@) % أهلا وسهلا بالإمام 
ms117	 ، فقد % % جلى الدجى ، وأنار مشرقه % 6(@)(@@) % بدر تنزل في منازله ، % سعد يصبحه ويطرقه % 7(@)(@@) % فرحت به دار الملوك ، فقد % % كادت إلى لقياه تسبقه % 8(@)(@@) % ولذاك قد كانت منازله % تنبو بساكنها ، وتقلقه % 9(@)(@@) % يا خير من تزجى المطي له ، % و يمر حبل العهد موثقه % 10(@)(@@) % أضحى عنان الملك منتشرا ، % بيديك تحبسه ، وتطلقه % PageV01P672 11(@)(@@) % فاحكم ، لك الدنيا وساكنها ، % ما طاش سهم ، أنت ترشقه % 12(@)(@@) % متفرد يملي الصواب على % % آرائه رب يوفقه % 13(@)(@@) % قر السرير ، وكان مضطربا ، % وأقل تاج الملك مفرقه % PageV01P673 البحر : خفيف تام 1(@)(@@) % حال من دون رؤيتي للوزيري % % ن ، وقد كنت راجيا للتلاقي % % 2(@)(@@) % طول سقم ما إن يفارق جسمي ، % دائر سره شديد الوثاق % 3(@)(@@) % حين أملت في الدنو اجتماعا ، % لطف الدهر في دوام الفراق % PageV01P674 البحر : رجز تام 1(@)(@@) % ما وجد صاد في الحبال موثق % لماء مزن بارد مصفق % 2(@)(@@) % صريح غيث خالص لم يمذق ، % إلا كوجدي بك لكن أتقي % % 3(@)(@@) % يا فاتحا لكل علم مغلق ، % وصيرفيا ، ناقدا للمنطق % 4(@)(@@) % إن قال : هذا بهرج ، لم ينفق ، % إنا على البعاد والتفرق % 5(@)(@@) % نلتقي بالذكر وإن لن نلتق % . . . . . . . . . . . . . . . . % PageV01P675 البحر : مجزوء الوافر 1(@)(@@) % أيا من مات من شوق % إلى لحيته الحلق % 2(@)(@@) % فأما القص والنتف ، % فقد أضناهما العشق % 3(@)(@@) % وما شابت ولكن شا % % ب في عارضها ذرق % 4(@)(@@) % و من يصلح للصفع % برأس كله فرق % 5(@)(@@) % وقرطاس قفاه يص % % لح في طوماره المشق % 6(@)(@@) % و لو صير برجاسا ، % لما أخطأه رشق % 7(@)(@@) % و يا من مدحه كذب ، % و يا من ذمه صدق % 8(@)(@@) % خنقت الكبش حتى كا % % د لا يبقى له خلق % 9(@)(@@) % وقد قدر أن يصر % خ لكن ما به طرق % 10(@)(@@) % طبيب الكف لا يذ % % بل في قبضته عرق % PageV01P676 البحر : خفيف تام 1(@)(@@) % حدثونا عن بدعة ، فأبينا ، % فتغنت ، فظن في البيت بوق % 2(@)(@@) % وإذا شوكة تقصف يبسا ، % فوقها رأس فارة محلوق % PageV01P677 البحر : كامل تام 1(@)(@@) % كم حاسد حنق علي بلا % % جرم ، فلم يضرني الحنق % 2(@)(@@) % متضاحك نحوي ، كما ضحكت % نار الذبالة ، وهي 
ms118	 تحترق % PageV01P678 البحر : وافر تام 1(@)(@@) % أبى آبي الهوى أن لا تفيقا ، % و حملك الهوى ما لن تطيقا % % 2(@)(@@) % برغم البين لا صارمت شرا ، % و لا زالت ، وإن بعدت ، صديقا % % 3(@)(@@) % كذاك بكيت من طرب إليها ، % وبت أشيم بالنجف البروقا % % 4(@)(@@) % وما أدري ، إذا ما جن ليل ، % أشوقا في فؤادي أم حريقا % % 5(@)(@@) % ألا يا مقلتي دهمتماني % % بلحظكما ، فذوقا ، ثم ذوقا % % 6(@)(@@) % لقد قال الروافض في علي % مقالا جامعا كفرا وموقا % % 7(@)(@@) % زنادقة أرادت كسب مال % من الجهال ، فاتخذته سوقا % % 8(@)(@@) % وأشهد أنه منهم بري ، % و كان بأن يقتلهم خليقا % % 9(@)(@@) % كما كذبوا عليه ، وهو حي ، % فأطعم ناره منهم فريقا % % 10(@)(@@) % وكانوا بالرضا شغفوا زمانا ، % وقد نفخوا به في الناس بوقا % % PageV01P679 11(@)(@@) % وقالوا : إنه رب قدير ، % فكم لصق السواد به لصوقا % % 12(@)(@@) % أيترك لونه لا ضوء فيه ، % و يكسو الشمس والقمر البريقا % % 13(@)(@@) % فظل إمامهم في البطن دهرا ، % و لا يجد المسيكين الطريقا % % 14(@)(@@) % فلما أن أتيح له طريق ، % تغيب نازحا عنهم سحيقا % % 15(@)(@@) % وفر من الأنام وكان حينا % يقاسي بينهم ضرا وضيقا % % 16(@)(@@) % فمن يقضي إذا كان اختلاف ، % و يستأدي االفرائض والحقوقا % % 17(@)(@@) % وقال الموصلي : إليه باب ، % فلم لم يعط للثغته لعوقا % % 18(@)(@@) % ويبريه ، فقد أضناه سقم ، % كأن بوجهه منه خلوقا % % 19(@)(@@) % وقال ، وفي الأئمة زهد دين ، % ولم ير مثل شيعتهم فسوقا % % 20(@)(@@) % و قد عرضت قيانهم علينا ، % وباعوا بعضهم منا رقيقا % % PageV01P680 21(@)(@@) % يناطح هامهن لكل باب % من السودان يحسبهن بوقا % % 22(@)(@@) % عظيمات من البخت اللواتي % % تخال شفاهها عشرا فليقا % % PageV01P681 البحر : سريع 1(@)(@@) % قد نتن المجلس مذ جئتنا ، % فكل من مر به يبصق % 2(@)(@@) % فغذ إبطيك وأشبعهما ، % في الصيف بالمرتك يا احمق % 3(@)(@@) % ولا تقل ما فيهما حيلة ، % فالحش قد يكنس أو يطبق % PageV01P682 البحر : طويل 1(@)(@@) % لقد كان يصطاد المبين يوسف % بوجه مليح لا يخلي من العشق % 2(@)(@@) % و قد طالما نادوه : يا قمر الدجى ، % فلما التحى نادوه : يا نافخ الزق % PageV01P683 البحر : بسيط تام 1(@)(@@) % دست بنية بسطام عقاربها % % نحوي 
ms119	 ونامت على الأضغان والحنق % 2(@)(@@) % حتى كأني قد فزعت والدها % % في المهد فانقلبت عيناه من فرق % PageV01P684 البحر : طويل 1(@)(@@) % أتاني والإصباح ينهض في الدجى ، % بصفراء لم تفسد بطبخ وإحراق % 2(@)(@@) % فناولنيها ، والثريا كأنها % % جنى نرجس حيا الندامى بها الساقي % % PageV01P685 البحر : بسيط تام 1(@)(@@) % أباح عيني لطول الليل والأرق ، % وصاح إنسانها في الدمع بالغرق % 2(@)(@@) % ظبي مخلى من الأحزان أوقره % ما يعلم الله من حزن ومن قلق % 3(@)(@@) % كأنه ، وكأن الكأس في يده ، % هلال تم ، ونجم غاب في شفق % PageV01P686 البحر : وافر تام 1(@)(@@) % و ندمان دعوت وهب نحوي % % وسلسلها كما انخرط العقيق % 2(@)(@@) % كأن بكأسها نارا تلظى ، % ولولا الماء كان لها حريق % 3(@)(@@) % و قد مالت إلى الغرب الثريا ، % كما أصغى إلى الحس الفروق % 4(@)(@@) % كأن غمامة بيضاء بيني % % وبين الراح تحرقها البروق % 5(@)(@@) % كأن نجومها ، والفجر يحدو % % بليلته ، سليمان يفيق % PageV01P687 البحر : مجتث 1(@)(@@) % سل بالصبوح غبوقا ، % ولا تكن مستفيقا % % 2(@)(@@) % واعص العذول ودعه % ينفخ بعذلك بوقا % % 3(@)(@@) % دع المسيكين حتى % % يقيم بالنسك سوقا % % 4(@)(@@) % لا تسلكن إلى غي % % ر ما تحب طريقا % % 5(@)(@@) % فإن في ذاك عندي % % رأيا مضيئا ، وثيقا % % 6(@)(@@) % وخذ ، وهات سلافا % من الشراب رحيقا % % 7(@)(@@) % لا تشربن سواها ، % أو من حبيبك ريقا % % 8(@)(@@) % اما ترى الصبح يدعو : % يا نائمين أفيقا % % PageV01P688 البحر : مجزوء الكامل 1(@)(@@) % انظر إلى الجزر الذي % % يحكي لنا لهب الحريق % 2(@)(@@) % كمذبة من سندس ، % و بها نصاب من عقيق % PageV01P689 البحر : طويل 1(@)(@@) % أتعمر بستانا زكا لك غرسه ، % وتخرب ودا من خليل موافق % 2(@)(@@) % فأعجبه كرم يرق نباته ، % وإغداق عيدان رواء الحدائق % 3(@)(@@) % يقيل الحمام الورق في شجراته ، % فمن هادر يدعو الإناث ، وصافق % 4(@)(@@) % وجياشة بالماء طيبة الثرى ، % تغور على أيدي السقاة الدوافق % 5(@)(@@) % وما ذاك إلا خدع دنيا وزخرف ، % وأسباب إنفاق لمالك ماحق % 6(@)(@@) % لعلك في الأرض التي لك واجد % بنا بدلا ، كلا ورب المشارق % PageV01P690 البحر : بسيط تام 1(@)(@@) % أهدت غلي التي نفسي الفداء لها % % الورد نوعين مجموعين في طبق % 2(@)(@@) % كأن أبيضه من فوق 
ms120	 أحمره % كواكب أشرقت في حمرة الشفق % PageV01P691 البحر : بسيط تام 1(@)(@@) % كأن أرواح أهل العشق سائرة % إلى جمالك بالتقريب والعنق % 2(@)(@@) % تؤم كعبة حسن ، خالها حجر ، % في الخد أسوده في أبيض يقق % PageV01P692 البحر : طويل 1(@)(@@) % رحلنا المطايا مدلجين ، فشمرت % بكل فتى غمر إلى الموت سباق % 2(@)(@@) % أطلنا السرى حتى كأن عيونها % % زجاجات جامات أديرت على الساقي % % PageV01P693 البحر : خفيف تام 1(@)(@@) % يا دهر ما أبقيت لي من صديق % عاشرته دهرا ، ولا من شفيق % 2(@)(@@) % تأكل أصحابي وتفنيهم ، % ثم تلقاني بوجه صفيق % PageV01P694 البحر : طويل 1(@)(@@) % أيا دهر لا ترعي علينا ولا تبقي ، % فرفقا بنا بل لا أرى لك من رفق % 2(@)(@@) % فكم من حبيب قد شققت ضريحه % وأسكنته بيتا هو البيت من حق % PageV01P695 البحر : مجزوء الرجز 1(@)(@@) % قل لمشيبي ، إذ بدا ، % و ابيض مني المفرق % 2(@)(@@) % ناطقة لكنها % % كاسفة لا تنطق % 3(@)(@@) % إن الشباب خانني ، % فالرأس مني أبلق % 4(@)(@@) % أين غراب أسود ، % أطرته يا عقعق % PageV01P696 (@)(@@)(@@)(@@) | (@)(@@) البحر : طويل 1(@)(@@) % ضمان على عيني سقي ديارك ، % وإن لم تكوني تعلمين بذلك % 2(@)(@@) % وقلت لأصحابي : انظرو هل بدا لكم % % ضمير بلاد غيبت أم مالك % 3(@)(@@) % كأن المطايا ، إن غدون بسحرة ، % تركن أفاحيص القطا في المبارك % 4(@)(@@) % فلا جزع ، أن راب دهر بصرفه ، % و بدل حالا ، فالخطوب كذلك % 5(@)(@@) % لنا إبل ملء الفضاء ، كأنما % % حملن التلاع الحو فوق الحوارك % 6(@)(@@) % و لكن إذا اغبر الزمان تروحت ، % فجاءت عليه بالعروق السوافك % 7(@)(@@) % أبر على الأعداء مني ابن حرة ، % جري على الشحناء ، عف المسالك % 8(@)(@@) % أقمت لهم سوق الجلاد بمنصلي ، % و علمتهم طعن الكلى بالنيازك % 9(@)(@@) % و ما العيش إلا مدة سوف تنقضي ، % وما المال إلا هالك عند هالك % PageV01P697 البحر : خفيف تام 1(@)(@@) % شفعيني ، يا شر ، في رد نفسي ، % فلقد طال حبس قلبي لديك % 2(@)(@@) % و أذني في الرقاد لي ، إن عيني % % تستعير الرقاد من عينيك % 3(@)(@@) % أو هبي لي صبرا أرد به الدم % ع ، فإني أخاف دمعي عليك % PageV01P698 البحر : خفيف تام 1(@)(@@) % باح يا قوم من أحب بتركي ، % فدعوني 