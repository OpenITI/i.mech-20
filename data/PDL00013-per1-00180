ms166	 %~% در دیده جاش میخ زند کوری استوار(@)(@@) 32 آن کز تو شد غمی نشود تا به حشر شاد %~% وان کز تو شد عزیز نگردد به عمر خوار(@)(@@) 33 پیموده و سپرده ثواب و عقاب تو %~% پهنای هر بلاد و درازی هر دیار(@)(@@) 34 بفراخت نیکخواه تو را راحت وصول %~% بگداخت بدسگال تو را رنج انتظار(@)(@@) 35 این را ز نعمت تو طعامیست خوش مزه %~% وان را ز سطوت تو شرابیست بدگوار(@)(@@) 36 زان تیغ آفتاب کشیده دراز وپهن %~% جز جان دشمن تو نگردد همی فگار(@)(@@) 37 زان رشته دو رنگ سپید و سیاه صبح %~% جز اسب دولت تو نیابد همی چدار(@)(@@) 38 بر عز و ملک تو رقم جاودانی است %~% ز آثار حمله های تو در دشت شابهار(@)(@@) 39 آن روز کاندر آتش پیکار گاه شد %~% سیماب رنگ تیغ چو سیماب بی قرار(@)(@@) 40 چون میغ میغ تاخت سپه در پس سپه %~% چون دود دود خاست غبار از پس غبار(@)(@@) 41 آلود حد خنجر و اندود مد گرد %~% پشت زمین به روین روی هوا به قار(@)(@@) 42 گریان چو ابر نیزه کین توز عمر سوز %~% خندان چو برق حربه دلدوز جانگداز(@)(@@) 43 از حمله ها نفس ها در حلق ها خبه %~% وز گردها نظرها در دیده ها بشار(@)(@@) 44 تا دیر دیر گشت همی تیغ دور دور %~% تا زود زود خاست همی بانگ دار دار(@)(@@) 45 دست یکی سپرد همی پای انتقام %~% پای یکی گرفت همی دست اضطرار(@)(@@) 46 این از نشاط فوز همی تاخت سوی بحر %~% وان از نهیب مرگ همی گشت گرد غار(@)(@@) 47 رفته ره عزیمت این بخت معتمد %~% بسته در هزیمت آن عمر مستعار(@)(@@) 48 آب امید شست همی رنگ احتراز %~% دست قضا نگاشت همی نقش اعتبار(@)(@@) 49 کوشان امل به فتح تن آسوده شد ز رنج %~% جوشان اجل به رزم سراسیمه شد به کار(@)(@@) 50 دیدند جنگ دیده دلیران تو را به جنگ %~% در آهنین 
ms167	 لباس چو روئین سفندیار(@)(@@) 51 بر بارکش هژبری تند و بلا شکر %~% با سرزن اژدهایی پیروز و جان شکار(@)(@@) 52 شد سبز خنگ باره تو بحر فتح موج %~% گشت آب رنگ خنجر تو ابر مرگبار(@)(@@) 53 ناگه به صحن میدان در تاختی چو باد %~% تا مغزهای شیران بشکافتی چو نار(@)(@@) 54 در جمله بی گزند به توفیق ایزدی %~% گشتی بر آنچه کام دلت بود کامگار(@)(@@) 55 دست ظفر گرفته عنان از میان شور %~% آورده بارگیر تو را تا به تخت یار(@)(@@) 56 کف الخضیب گردون از گنج مشتری %~% کرده همه سعادت بر تاج تو نثار(@)(@@) 57 این ملک عالم ایزد کردست بر تو وقف %~% بر خاطر از مصالحش اندیشه کم گمار(@)(@@) 58 ایزد چو وقف کرد کند آنچه واجبست %~% تو روزگار خرم در خرمی گذار(@)(@@) 59 نصرت به نام تیغ تو گیرد همی جهان %~% تازد همی سپاه و گشاید همی حصار(@)(@@) 60 تا این زمانه متلون به سعی چرخ %~% آیین دیگر آرد هر سال چند بار(@)(@@) 61 گه در خزان چنان که درافگند برکشد %~% از گردن بتان چمن خلعت بهار(@)(@@) 62 در صفحه صفحه زر نهد اطراف بوستان %~% تا تخته تخته سیم کند روی جویبار(@)(@@) 63 گه در بهار باز کشد بر زمین بساط %~% از لعل پود بوقلمون های سبز تار(@)(@@) 64 گیسوی گلرخانش نگارد به مشک بید %~% گوش سمنبرانش فروزد به گوشوار(@)(@@) 65 سوسن به کبر عرضه کند روی با جمال %~% نرگس به ناز باز کند چشم پر خمار(@)(@@) 66 گه چون خزان تو زر و درم ریز بی قیاس %~% گه چون بهار در و گهرپاش بی شمار(@)(@@) 67 در جوی های بخت همه آب کام ران %~% در باغ های ملک همه تخم عدل کار(@)(@@) 68 دولت فروز و نصرت یاب و طرب فزا %~% گیتی گشای و ملک ستان و زمانه دار(@)(@@) 69 تو شادمان نشسته و اقبال پیش تو %~% روز و شب ایستاده میان بسته بنده وار(@)(@@) 70 
ms168	 قدر تو را نشانده به صد ناز بر کتف %~% جاه تو را گرفته به صد مهر در کنار PageV1P121(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 جهان را چرخ زرین چشمه زرین می زند زیور %~% از آن شد چشمه خورشید همچون بوته زرگر(@)(@@) 2 خزان را داد پنداری فلک ملک بهاری را %~% که اندر باغ زرین تخت گشت آن زمردین افسر(@)(@@) 3 همان مینا نهاد اطراف گل شد کهربا صورت %~% همان نقاش بوده باد دی امروز شد پیکر(@)(@@) 4 زمین از باد فروردین که از گل بود بر چهره %~% به ماه مهر و مهر ماه گشت از میوه پر شکر(@)(@@) 5 نه صحرا روی بنماید همی از شمعگون حله %~% نه گردون روی بگشاید همی از آبگون چادر(@)(@@) 6 با باغ و راغ نشناسد همی پیری و کوژی را %~% چو بخت دولت خواجه سر سرو و قد عرعر(@)(@@) 7 به طمع جستن سروش به حصر دیدن بزمش %~% کشیده پنجه ها سرو و گشاده دیده ها عبهر(@)(@@) 8 نگه کن در ترنجستان بارآورده تا بینی %~% هزاران لعبت زرین تن اندر زمردین معجر(@)(@@) 9 بسان دشمن خواجه ترنج بزم نادیده %~% نگون آویخته ست از شاخ تن لرزان و روی اصفر(@)(@@) 10 ز عکس رنگ او گشته ملون برگ چون دیبا %~% ز نقل بار او مانده خمیده شاخ چون چنبر(@)(@@) 11 همانا گنج باد آورد بگشا دست بادایرا %~% که در افشاند بس بی حد و زر گسترد بس بی مر(@)(@@) 12 تو گویی خواجه جشنی کرد و زحمت کرد خواهنده %~% ز بس دینار کو پاشید زرین شد همه کشور(@)(@@) 13 عمید مملکت بونصر اصل نصرت دنیا %~% که گر نصرت شود افسر شود نامش در و گوهر(@)(@@) 14 همی بخشیده ایزد به تازی نام او باشد %~% به ایزد گر بود بخشیده ایزد ازو بهتر(@)(@@) 15 بهار دولت او را شکفته از سعادت گل %~% سرای خدمت او را گشاده از بزرگی در(@)(@@) 16 جهان کامرانی را زن ور رای او گردون 
ms169	 %~% بهشت شادمانی را ز دست جود او کوثر(@)(@@) 17 بود بنیاد عزمش را ز چرخ بیستون کوشش %~% سزد کشتی حزمش را ز کوه بیستون لنگر(@)(@@) 18 چو رزمش در ندا آید به تیغش جان دهد پاسخ %~% چو بزمش در مرا افتد ز دستش کان برد کیفر(@)(@@) 19 ز وصف و نعت او خیره ز مدح و شکر او عاجز %~% روان های سخن سنج و زبان های سخن گستر(@)(@@) 20 عمل بی نام او جاهل امل بی بذل او واله %~% سخا بی فعل او ناقص سخن بی قول او ابتر(@)(@@) 21 فزود از جاه و برد از جان و جست از طبع و داد از دل %~% عمل را عز امل را ره سخا را دل سخن را فر(@)(@@) 22 زهی چون بخت بر تو شده بر هر تنی پیدا %~% زهی چون راز مهر تو شده در هر دلی مضمر(@)(@@) 23 نداند کوه بابل را همی حلم تو یک ذره %~% بخواند بحر قلزم را همی جود تو یک فرغر(@)(@@) 24 ز تاب آتش تیغت بجوشد آب در جیحون %~% ز زور شیهه رخشت بریزد خاره در کردر(@)(@@) 25 زبان داده شکوفه تو سیادت را به نیک و بد %~% ضمان کرده نفاذ تو سیاست را به نفع و ضر(@)(@@) 26 ثنا را اصل تو عمده دها را عقل تو مرکز %~% ادب را طبع تو میزان خرد را رای تو داور(@)(@@) 27 شرف اصل تو را قیم هنر عقل تو را نافذ %~% وفا طبع تو را صیقل ذکا رای تو را رهبر(@)(@@) 28 همی بی امر مهر تو عرض نگشاید از عنصر %~% همی با نهی کین تو عرض بگریزد از جوهر(@)(@@) 29 خصال تو به هر سعی و ضمیر تو به هر فکرت %~% مثال تو به هر حکم و حضور تو به هر محضر(@)(@@) 30 همه سعدست بی نحس و همه نورست بی ظلمت %~% همه انصاف بی ظلم و همه معروف بی منکر(@)(@@) 31 جهانی 
ms170	 زاده از طبعت به آب و باد سرد و خوش %~% درختی رسته از خلقت به شاخ و بیخ سبز و تر(@)(@@) 32 چو از خون در برگردان ببندد عیبه جوشن %~% چو از تف در سر مردان بتفسد بیضه مغفر(@)(@@) 33 در آن تنگی که چون دوزخ یلان رزم را گردد %~% ز گرما روی چون انگشت و ز تف دیده چون اخگر(@)(@@) 34 سلب ها ز افرینش بارگیران را بدل گردد %~% شود اشهب به گرد ابرش شود ادهم ز خون اشقر(@)(@@) 35 هوای مظلم تیره مثالی گردد از دوزخ %~% زمین هایل تفته قیاسی گیرد از محشر(@)(@@) 36 ز کاری قوت حمله بلرزد قامت نیزه %~% ز تاری ظلمت زخمت بتابد صفحه خنجر(@)(@@) 37 بری را کوفته باره دلی را دوخته زوبین %~% سری را خار و خس بالین تنی را خاک و خون بستر(@)(@@) 38 به زخم از شخص مجروحان دمد روین ز آذریون %~% ز خون بر روی خنجرها کفد لاله ز نیلوفر(@)(@@) 39 اجل دامن کشان آید گریبان امل در کف %~% قضا نعره زنان خیزد مخاریق بلا بر سر(@)(@@) 40 ز بیم مرگ و حرص نام جوشان پر دل و بد دل %~% گریزان این چو موش کور و تازان آن چون مار کر(@)(@@) 41 تو را بینند بر کوهی شده در حمله چون بادی %~% چو برقی نعره پر آتش چو رعدی حلق پر تندر(@)(@@) 42 هیونی تند خارا شخص آهن ساق سندان سم %~% عقابی تیز کوه انجام هامون کوب دریا در(@)(@@) 43 سرین او ندیده شیب و چون شیب درازش دم %~% برخش او نخورده زخم و بر زخم دو دستش بر(@)(@@) 44 هزاران دایره بینی هزاران خط که بنگارد %~% گه ناورد چون پرگار و گاه پویه چون مسطر(@)(@@) 45 به دستت گوهری لرزان فلک جرم نجوم آگین %~% مرکب نقره در الماس و معجون آب در آذر(@)(@@) 46 ز جان دودی برانگیزی بدان پولاد چون آتش %~% ز گرد ابری برافرازی بر آن شبدیز 
ms171	 چون صرصر(@)(@@) 47 درخش این فرو گیرد همه روی هوا یکسان %~% نعال آن فرو کوبد همه روی زمین یکسر(@)(@@) 48 گهی این بر گهر تابد چو یاقوتی تو را در کف %~% گهی آن پرگره پیچد چو ثعبانی به چنگ اندر(@)(@@) 49 چه بازو و چه دستست آنکه گیرد سستی و کندی %~% ازین دندان پیل مست از آن چنگال شیر نر(@)(@@) 50 نهنگ هیبتت هر سو چو باد اندر کشیده دم %~% همای نصرتت چون ابر بر هر سو گشاده پر(@)(@@) 51 خلیلی تو که هر آتش تو را همسان بود با گل %~% کلیمی تو که هر دریا تو را آسان دهد معبر(@)(@@) 52 معاذالله نه اینی و نه آنی بلکه خود هستی %~% ز نعت فهم ها بیرون ز حد وهم ها برتر(@)(@@) 53 ندانم گفت مدح تو بقا بادت که از رتبت %~% سر عمال هندستان رسانیدی به گردون بر(@)(@@) 54 بدان بی جان که همچون جان شدست انباز اندیشه %~% نخوانده هیچ علمی و تمام علمهاش از بر(@)(@@) 55 فری زان تندرست زرد و آن فارغ دل گریان %~% شگفت آن راستگوی گنگ و آن قوت کن لاغر(@)(@@) 56 تنش چون استخوان سخت و دلش همچون شکم خالی %~% زبان چون دست نیرومند و سر چون پای گام آور(@)(@@) 57 به تو خاور مقلد گشت خورشید از برای آن %~% بپاشد بر جهان نوری که افزون آید از خاور(@)(@@) 58 ز نام تست رای تو همه راحت که بی هر دو %~% نگیرد روح رادی تن نیارد شاخ شادی بر(@)(@@) 59 تویی انصاف و حکم تو چو دانش عقل را شایان %~% تویی اقبال و ملک تو چو دیده چشم را در خور(@)(@@) 60 نبرد افروختی یک چند و بزم آرای یک چندی %~% که گاهی نوبت تیغست و گاهی نوبت ساغر(@)(@@) 61 نزیبد چون به جا و دور بگراید نشاط تو %~% به جز خورشید می پیمای و جز ناهید و خنیاگر(@)(@@) 62 از آن معشوق حورآیین از 
ms172	 آن معشوق سروآسا %~% وز آن خوشخوی گل عارض و زان زیبای مه پیکر(@)(@@) 63 بخواه آن طبع را قوت بخواه آن کام را لذت %~% بخواه آن چشم را لاله بخواه آن مغز را عنبر(@)(@@) 64 بتی کز تن به زلف و رخ کشید و برد هوش و دل %~% نه چون او لعبتی دیگر نه چون او صورتی دلبر(@)(@@) 65 به خدمت پیش روی او میان بسته ست شاخ گل %~% ز حشمت پیش زلف او سرافکندست سیسنبر(@)(@@) 66 به خوی و عادت آبا به جمع زایران زر ده %~% به رسم و سیرت اجداد جشن مهرگان می خور(@)(@@) 67 بدان را غم همی مالد به لفظ رود شادی کن %~% بدی را جان همی کاهد به جان جام جان پرور(@)(@@) 68 ببر بهر نشاط انده به عودی از دل عشرت %~% بزن بهر دماغ آتش به عودی در دل مجمر(@)(@@) 69 بزرگا هیچ اقبالم نباشد چون قبول تو %~% که چون من نیست مدحت گوی و چون تو نیست مدحت خر(@)(@@) 70 عروس طبع من بپذیر ازیرا شاه احراری %~% هر آزاده تو را بنده ست و هر خواجه تو را چاکر(@)(@@) 71 نگاری کز جمال او جهان چون بوستان خرم %~% بهاری کز بهای او زمین چون آسمان انور(@)(@@) 72 همه سر صورت و صفوت همه تن زینت مدحت %~% برین از نور دل کسوت بر آن از لطف جان زیور(@)(@@) 73 به ارج گوهر شهوار و ارز لؤلؤ لالا %~% به فر افسر فغفور و قدر یاره قیصر(@)(@@) 74 به نقش دیبه رومی و بوی عنبر سارا %~% به حسن صورت مانی و زیب لعبت آذر(@)(@@) 75 ولیکن بخت بی معنی به تندی می کند دعوی %~% نمایش و آزمایش را شود هر ساعتی دیگر(@)(@@) 76 سرای دل تنست و تن به محنت می شود ویران %~% امیر تن دلست و دل ز انده می کشد لشکر(@)(@@) 77 نحوس طالعی کردست کار و حال من تیره %~% به حسبت حال من 
