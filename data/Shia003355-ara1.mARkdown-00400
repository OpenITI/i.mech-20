ms390	 الشكر.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب أروى وذكر ديرها وما تكلمت به من الحكمة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب نوادر ميمون بن ميمون في الأدب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب حمزة بن عفيف في سيرة ذي اليمينيين.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب أدب مسعدة الكاتب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب العرزمي في الأدب بنوادر شعر.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب آداب عافية بن يزيد القاضي، كتبه إلى إسحاق بن عيسى بن علي الهاشمي.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب آداب إبراهيم بن المهدى.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب آداب كلثوم بن عمرو العتابي.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب آداب عبد الله بن المعتز.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب شاناق الهندي في الآداب، خمسة أبواب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب سيره نامه تأليف خداهود بن فرخزاد، وهو كتاب الاخبار والأحاديث.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب علي بن زيد النصراني في الآداب والأمثال على مذاهب الفرس والروم والعرب.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب ترجمته نوادر أهل الشرفية ونوادر أوساط الناس ونوادر السفلة والوضعاء.(@)(@@)(@@)(@@) ||| الكتب المؤلفة في تعبير الرؤيا(@)(@@)(@@)(@@) $DIC_BIB$ كتاب ارطاميدورس في تعبير الرؤيا، خمس مقالات.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب النوم واليقظة، لفرفوريوس.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب أبى سليمان المنطقي في الانذارات النومية.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب الفه إبراهيم بن بكوس في الرؤيا.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب تعبير الرؤيا، لابن سيرين.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب تعبير الرؤيا، للكرماني.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب تعبير الرؤيا، للفيرياني، حديث.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب تعبير الرؤيا، لابن قتيبة.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب تعبير الرؤيا على مذاهب أهل البيت عليهم السلام. (الفه.. )(@)(@@)(@@)(@@) $DIC_BIB$ كتاب تعبير الرؤيا، لأهل البيت لطيف.(@)(@@)(@@)(@@) ||| الكتب المؤلفة في العطر(@)(@@)(@@)(@@) $DIC_BIB$ كتاب العطر، ألف ليحيى بن خالد.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب العطر، لإبراهيم بن العباس.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب العطر، للكندي.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب كيمياء العطر، للكندي.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب العطر، مجهول.(@)(@@)(@@)(@@) $DIC_BIB$ كتاب آخر في العطر والتركيبات .(@)(@@)(@@)(@@) $DIC_BIB$ كتاب