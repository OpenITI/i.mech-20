ms101	 ليس الفضل إلا لجعفر ؛ % 2(@)(@@) % فما البحر إلا واحد ؛ ليس غيره ؛ % وفي كل كف منك خمسة أبحر . . % PageV01P462 البحر : - 1(@)(@@) % غداة نأى الصبر الجميل مودعا % وللبين إرعاد علينا وإبراق % 2(@)(@@) % يؤجج لي نارا يريني أنها . . % وما هي إلا النار وجد وأشواق ؛ % PageV01P463 البحر : - 1(@)(@@) % أراك خليلي للمحاسن طالبا % وما هن إلا في ذراك قواطن ؛ % 2(@)(@@) % ومن أعجب الأشياء أن تستعيرها ؛ % ومنك لعمري تستعار المحاسن % PageV01P464 البحر : - 1(@)(@@) % جواهر أبكار يغار لحسنها % % إذا برزت عقد اللآل المنظم ؛ % 2(@)(@@) % يشيب لها فود الوليد لعجزه % ويضحى زياد عندها وهو أعجم % % PageV01P465 البحر : - 1(@)(@@) % فدونك منه سفر لا يسامى % % يجل عن المشابه والنظير ؛ % 2(@)(@@) % يجر على البديع ذيول فخر % ويحفر عنده وشي الحريري % % 3(@)(@@) % وختم التقريض مادحا لمؤلف الكتاب % % 4(@)(@@) % والله ما أخره ربنا . . % وهو لأرباب المعالي إمام ؛ % 5(@)(@@) % إلا لأن كان ختاما لهم ؛ % لله ما أحسن هذا الختام . % PageV01P466 البحر : - 1(@)(@@) % أمولاي ؛ لا تجزع إذا عضك الدهر % % وصبرا ؛ فإن الحر شيمته الصبر ؛ % 2(@)(@@) % متى أبصرت عيناك في الأرض ماجدا % أديبا نهي على الدهر أامر % 3(@)(@@) % وكم قبلك الأيام قد غدرت بنا ؛ % ولم تزل الأيام شميتها الغدر ؛ % 4(@)(@@) % وأغرى بنا الدهر الخؤون صروفه % % وما نحن إلا قطرة منك يا بحر % 5(@)(@@) % وإذ فتنا سبقا إلى غاية العلى ؛ % فأجدر منا أن يحاربك الدهر % PageV01P467 البحر : - 1(@)(@@) % أمل بهذا الدهر خائب % ما إن قضيت به المآرب ؛ % 2(@)(@@) % وحسام عزم باتر % ما إن بلغت به المطالب ؛ % 3(@)(@@) % سيفي يكل عن الضرا % % ب به وسهمي غير صائب % 4(@)(@@) % كم ذا أشاهد في الزمان % من النوادر والعجائب ؛ % 5(@)(@@) % كلب يسود على ألسود ؛ % ويرتقي أعلى المراتب % 6(@)(@@) % ويظل يخدم تائها ؛ % والليث مضطهد الجوانب ؛ % 7(@)(@@) % يا دهر ويحك كم تجور % وكم تهدد بالنوائب . % 8(@)(@@) % وإلام ترشقني سهامك % بالمكائد والمصائب % % 9(@)(@@) % لا غرو إن فقد الوفاء % من الأباعد والأقارب ؛ % 10(@)(@@) % فلكم رجوت بذي إخا % صدق العهود فكان كاذب % PageV01P468 11(@)(@@) % ولمن وكم أمل غدا % % مني به قد عاد خائب ؛ % 12(@)(@@) % كم ذا الإساءة يا زمان ؛ % أما تخاف أما تراقب 
ms102	 % 13(@)(@@) % فلما وقف الحسن عليها قال مجيبا % % 14(@)(@@) % مولاي ؛ صبرا للقضا ؛ % فالصبر محمود العواقب ؛ % 15(@)(@@) % إن الزمان وأنت أدرى % % بالزمان أبو العجائب ؛ % 16(@)(@@) % يضع العزيز ويرفع النذل % الخسيس على الكواكب ؛ % 17(@)(@@) % ونوائب الأيام عن % بيض الظبى أبدا نوائب % 18(@)(@@) % وإذا أعان كمالك الدهر % فمن تحارب % % 19(@)(@@) % إن الكمال لقل ما . . . % تصفو لصاحبه المشارب ؛ % 20(@)(@@) % تالله لا يلقى المنى % % وينال غايات الرغائب ؛ % PageV01P469 21(@)(@@) % ويسود أرباب المكارم ؛ % حاضرا منهم وغائب ؛ % 22(@)(@@) % ويفوت طالبه ويدرك % حين يطلب كل هارب ؛ % 23(@)(@@) % إلا فتى ماضي العزيمة % لا يفكر في العواقب % 24(@)(@@) % كالسيف قد صقلت صفيحة % عزمه أيدي التجارب ؛ % 25(@)(@@) % يبدي من الآراء نجما % في بهيم الخطب ثاقب ؛ % 26(@)(@@) % ويمد للراجين كفا ؛ % لا تدانيه السحائب ؛ % 27(@)(@@) % ويقد هامات الليوث % بصارم عضب المضارب % % 28(@)(@@) % أبدا يجوب الأرض في % % طلب العلى مع كل جائب . % 29(@)(@@) % يعلو أمونا جسرة % يفري بها مهج السباسب ؛ % 30(@)(@@) % تسمو به نفس عصا % % مية ؛ إلى أعلى المراتب ؛ % PageV01P470 31(@)(@@) % ظامى الفؤاد إلى الطراد % % على المطمهة السلاهب % 32(@)(@@) % ما انفك في صهواتها % % كالليث ؛ مطلوبا وطالب % 33(@)(@@) % يلقى العدى بعزيمة % تعنو لها البيض القواضب ؛ % 34(@)(@@) % في كفه متلهب الصفحات % % مشحوذ الجوانب % 35(@)(@@) % كالبرق يعجب صورة . . % لكنه للحتف جالب . % 36(@)(@@) % ومثقف ماضي % % السنان لأنفس الأبطال سالب ؛ % 37(@)(@@) % ويراعة تأتيك من % طرف البراعة بالغرائب . % PageV01P471 البحر : - 1(@)(@@) % يا أخا السؤدد والمجد % ويا زاكي النجار ؛ % 2(@)(@@) % هاكه أسود لا يبرح % في الخدمة جاري ؛ % 3(@)(@@) % كاتب بالفعل لكن . . % لونه الأسود قاري % % 4(@)(@@) % يكتفي بالماء مهما % % مسه حر الأوار % 5(@)(@@) % قد حكى أوجه حسا % دك في يوم فخار ؛ % 6(@)(@@) % أبصرت منك ارتفاعا % فانثنت ذات انكسار % 7(@)(@@) % طالما من غير ذنب % حبسوه في القواري . . . ر % % 8(@)(@@) % فلكم يوم تمنى % % وهو في قيد الإسار ؛ % 9(@)(@@) % وصل خمس منك قد % % أزرت نوالا بالبحار % 10(@)(@@) % لم يزل للقرب منها % % في ارتقاب وانتظار % PageV01P472 11(@)(@@) % فإذا ؛ قد نال منها . . % باقتراح واختيار % 12(@)(@@) % فابق سامي المرتقى % % داني المنى عالي المنار . % PageV01P473 البحر : - 1(@)(@@) % صرفت لسبك النظم والنثر همة % ترينا بها ما 
ms103	 يسحر الفكر حسنه ؛ % 2(@)(@@) % وأضحت سماء الملك منك منيرة ؛ % فأنت سناء الملك قل لي أم ابنه % PageV01P474 البحر : - 1(@)(@@) % لك القلم الأعلى الذي إن سللته % تخاف سيوف الهند سطوة باسه ؛ % 2(@)(@@) % يجلك أن يمشي لديك برجله . . % ولكنه يمشي على أم رأسه % PageV01P475 البحر : - 1(@)(@@) % يا منكرا فضل بني أحمد % كن للذي تسمعه منصتا ؛ % 2(@)(@@) % هل خاتم الرسل سوى جدهم % % أم هل أتى في غيرهم هل أتى % % 3(@)(@@) % هات بالله هل أتى في سواه % % هل أتى من لدى العزيز العليي % % 4(@)(@@) % فتوهم أني أخذت عليه هذه اللطيفة وانه لم يسبقه إليها أحد فكتب إلي مداعبا % % PageV01P476 البحر : - 1(@)(@@) % أتسرقني وأنت أجل خل % يعز علي من حي وميت % 2(@)(@@) % أظن القطع هان عليك حتى % % سرقت لطيفتي من حرز بيتي % % 3(@)(@@) % فأجبت عليه بقولي % % 4(@)(@@) % اتزعمني لديك أجل خل % يعز عليك من حي وميت ؛ % 5(@)(@@) % وتبهتني بقولك لي جهارا % سرقت لطيفتي من حرز بيتي % % 6(@)(@@) % لعمرك إنه نهج مبين % مضاه السابقون بكل وقت ؛ % 7(@)(@@) % وهبني قد سرقت فمحكماتي % % سرقت ؛ فلا تطل أفديك مقتي ؛ % PageV01P477 البحر : - 1(@)(@@) % إن آيات غرامي % % محكمات ؛ ليس تنسخ % 2(@)(@@) % وهواكم في فؤادي % % مع طول اللبين أرسخ . % PageV01P478 البحر : - 1(@)(@@) % رام عذالي فيه سلوة ؛ % دون ما راموه والله الممات ؛ % 2(@)(@@) % ويح عذالي فيه ؛ ما دروا % % أن آيات غرامي محكمات . % PageV01P479 البحر : - 1(@)(@@) % أهديت للأبصار والأسماع % طرسا يقصر عن مداه باعي ؛ % 2(@)(@@) % هو لا أشك الجوهر الفرد الذي % % قطع التراجع فيه بالإجماع ؛ % 3(@)(@@) % لو أبصر الأدباء فيما قد مضى % % شهبا له ماتوا بغير نزاع ؛ % 4(@)(@@) % ما هذه أولى محاسنك التي % % ذهبت بكل محاسن ومساعي ؛ % 5(@)(@@) % لله كم قلدتني من قبلها % % بلطائف الأشعار والأسجاع ؛ % 6(@)(@@) % ولكم بعثت مشرفا وشحته % بغرائب الإبداع والإيداع . % PageV01P480 البحر : - 1(@)(@@) % أخي عذرا فديتك إن بيتي % % لأشبه بالقبور من البيوت ؛ % 2(@)(@@) % يظل الترب من فوقي وتحتي % % فتحسبني دفينا قبل موتي % % 3(@)(@@) % فقبري ما حواه من تراب % وكفني فيه نسج العنكبوت . % PageV01P481 البحر : - 1(@)(@@) % قتل علي في الوغى مرحبا % ضرورة إنكارها سفسطة % % 2(@)(@@) % فقلت مجيزا % % 3(@)(@@) % فإن 
ms104	 يكن أنكرها ناصب % فكم لأهل النصب من مغلطه . % PageV01P482 البحر : - 1(@)(@@) % سلام على من لم يحل بمهجتي % % سواه ولم يملك سواه قيادي ؛ % 2(@)(@@) % ومن حبه راس بقلبي ومن به % % غرامي مهما عشت ؛ لا بسعاد % 3(@)(@@) % ومن لم أزل مذ غبت عنه مدلها % قرين صبابت حليف سهاد . % 4(@)(@@) % أبيت سميرا للنجوم كأنما % % فراشي محشي بشوك قتاد ؛ % 5(@)(@@) % عسى الله بعد البين يجمع شملنا % % على رغم حساد وغيظ أعادي ؛ % 6(@)(@@) % وأشفي فؤادي يا حبيبي بنظرة % إليك فقد أضناه طول بعادي ؛ % 7(@)(@@) % فأجاب علي بكتاب بسيط وفي طيه هذه القصيدة % % 8(@)(@@) % ألمت ؛ فهاجت لوعة بفؤادي % % وزادت غراما أدمعي وسهادي ؛ % 9(@)(@@) % بيوت بها أقوت بيوت تجلدي % % وقام اصطباري بالرحيل ينادي . % 10(@)(@@) % هي السحر أو كالسحر فعلا ؛ فمذ أتت % أقصض لشوقي مضجعي ووسادي ؛ % PageV01P483 11(@)(@@) % تذكرني عهدا لنا ومنازلا % سقاها من الوسمي صوب عهاد . % 12(@)(@@) % فأحللتها من ناظري ومهجتي % % سويداء قلبي أو سواد سوادي . % 13(@)(@@) % فيا باعثا لي الوجد في طي مهرق % رويدك ما قلبي الشجي بجماد . % 14(@)(@@) % ويا مالكا رقي بنعماه دائما % فكم نعم عندي له وأيادي % % 15(@)(@@) % أياد لعمري أهملت ذكر حاتم % و كعب الندى في طيء و إياد % 16(@)(@@) % ويا ماجدا أعطيته عهد صحبتي % % وأصفيته في الغيب محض ودادي . % 17(@)(@@) % أتحسب أني بعد بعدك ساليا % يطيب معاشي أو يلذ رقادي % % 18(@)(@@) % أبى البين إلا أن أرى فيك لابسا % ليالي أحزاني ثياب حداد ؛ % 19(@)(@@) % فغاد من الدمع الهتون ورائح % وخاف من الشوق الشديد وبادي ؛ % 20(@)(@@) % ولو أنني سافرت شرقا ومغربا ؛ % لما كان إلا طيب ذكرك زادي ؛ % PageV01P484 21(@)(@@) % فراقك أشجاني وهد قواي ؛ لا % % تغني هزاز أو ترنم حادي ؛ % 22(@)(@@) % ولا الغادة الهيفا لها بين شبهها % % من المائسات الناعمات تهادي ؛ % 23(@)(@@) % ولا الأهيف الفتان يعبث قده % % وناظره الساجي بكل فؤاد ؛ % 24(@)(@@) % ولا القرقف الصهباء حثت كؤوسها % % أكف مهي هيف الحضور خراد % 25(@)(@@) % أخي ونصيري في النوائب والذي % % أناديه للأحداث حين أنادي % % 26(@)(@@) % فدى لك أهلي الأقربون ومعشري % % وما يبدي من طارف وتلاد % 27(@)(@@) % أتتني من تلقاء سوحك 
ms105	 قطعة ؛ % بنفسي سوح قد حللت ونادي ؛ % 28(@)(@@) % هي الروض بل أبهى من الروض بهجة ؛ % إذا جاده أكف غوادي % % 29(@)(@@) % بعثت بها من سوح نعمة خالقي . . % على حاضر في العالمين وبادي . % 30(@)(@@) % عماد الهدى رب العلى هادي الورى % % إلى خير منهاج وقول سداد . % PageV01P485 31(@)(@@) % أدام إله العرش فينا ظلاله % وأبقاه للإسلام خير عماد % 32(@)(@@) % وقد بعث العبد الجواب تجاريا ؛ % وإن كان يكبو عن مداك جوادي ؛ % 33(@)(@@) % فخذ من جوابي النزر ما كان حاضرا % وأنت إذا أندى ؛ لأنك بادي ؛ % 34(@)(@@) % وعذرا ؛ فقد قابلت درك بالحصى % % وساجلت بحرا زاخرا بثماد ؛ % 35(@)(@@) % فأغض وسامح منعما عن قبيح ما % % بدا لك من عيب به وفساد % 36(@)(@@) % فأنت الذي قدت القوافي طوائعا % وغيرك لم تنقد له بمقاد ؛ % 37(@)(@@) % وأنت الذي جليت في حلبة العلى % % على كل جحجاح طويل نجاد ؛ % 38(@)(@@) % على أنني قد صرت بعدك أعجما % وإن كنت أزرى لهجة بزياد % % 39(@)(@@) % لدهر رماني بالمصائب صرفه % % وأضنى فؤادي خطبه المتمادي % % 40(@)(@@) % أطال حروبي بالمضرات والأذى % % ولا طول حرب الحرث بن عباد % % PageV01P486 41(@)(@@) % يحاول إهمالي وإسقاط رتبتي % % ويسعى حثيثا في خمود زنادي . % 42(@)(@@) % وثقل ديون للورى يا بن ناصر % يراوحني همي بها ويغادي % % 43(@)(@@) % ملأن فؤادي بالأسى وسلبنني % % رقادي وملكن الرجال قيادي % % 44(@)(@@) % فأصبحت رهنا في أزال لأجلها % % وغير أزال بغيتي ومرادي ؛ % 45(@)(@@) % وإن كان فيها منشأي وولادتي % % ومسقط رأسي ؛ فهي غير بلادي . . % 46(@)(@@) % وما بلدي إلا الذي فيه أغتدي % % وعرضي مصون عن مقال أعادي ؛ % 47(@)(@@) % بلاد بها لا أختشي الذل إن غدت % % علي لأحداث الزمان عوادي ؛ % 48(@)(@@) % أأقعد في قوم أرى الشعر بينهم % يباع ببخس ظاهر وكساد % 49(@)(@@) % لنبهتهم بالمدح للجود والندى % % وقد ملئت أجفانهم برقاد . % 50(@)(@@) % وحركتهم بالشعر في كل ساعة % فتحسبني حركت صخرة وادي ؛ % PageV01P487 51(@)(@@) % فلم ألق من نظم القريض سوى عنا % وشغلة أوقات وطول سهاد % 52(@)(@@) % فلا كانت الأمداح من شافع ؛ ولا % % جرى قلم في كتبها بمداد . . % 53(@)(@@) % أروم بها نيل السعادة والغنى % % وقد أشبهت نحسا ليالي عاد ؛ % 54(@)(@@) % وأورد فكري كل بحر 
ms106	 غطمطم % فيصدر حران الجوانح صادي . % 55(@)(@@) % لعل الليالي أن تمن برحلة % إلى أصيد رحب الفناء جواد ؛ % 56(@)(@@) % من البدو تذكى للملمين ناره % % ترى حوله منها جبال رماد % 57(@)(@@) % يفيض على العافين نائل كفه ؛ % فمن إبل مزمومة وجياد ؛ % 58(@)(@@) % وما المرؤ إلا من يؤمله الورى % % لقتل عداة أولبذل عتاد ؛ % 59(@)(@@) % وعش ما دعى لله داع من الورى % % وناداه للكرب العظيم منادي ؛ % 60(@)(@@) % وأسأله من فضله جمع شملنا . . % وأن لا قضى ما بيننا ببعاد . % PageV01P488 البحر : - 1(@)(@@) % قد اصبح الدين نهبا بين زعنفة % لا يرقبون إله الناس في الناس ؛ % 2(@)(@@) % قد كاد يبكي لو أن الدمع أسعده % % ويرتمي شررا من حر أنفاس ؛ % 3(@)(@@) % وكاد يصرخ ؛ يالله من فرق % نيف وسبعين ظلت ذات الباس % 4(@)(@@) % قد خالفت نفس خير الخلق حيدرة % % ميلا إلى قول أرجاس وأنجاس . % PageV01P489 البحر : - 1(@)(@@) % وقد أطلت ما ترى % % من هذيان وهذر % 2(@)(@@) % وقد ذكرت قصصا % تحار فيهن الفكر ؛ % 3(@)(@@) % فاصبر له ؛ ولا تقل ؛ % يا ليته كان اختصر ؛ % 4(@)(@@) % وإن تجد عيبا به . . % فأنت أولى من ستر % 5(@)(@@) % واعذر أخي فإنني % % كتبته على القمر % PageV01P490 البحر : - 1(@)(@@) % تفضل ؛ لا برحت قرير عين % % بمجموع الإمام أبي الحسين ؛ % 2(@)(@@) % فأشواقي إليه كل حين % تمثل شخصه تلقاء عيني % % PageV01P491 البحر : - 1(@)(@@) % يا أحم لا تنس الدعا % % لي بالعشي وبالغدو ؛ % 2(@)(@@) % فلقد غدوت بحالة % منها يرق لها العدو ؛ % 3(@)(@@) % مرت ليال أربع % لم أدر ما طعم الهدو % PageV01P492 البحر : - 1(@)(@@) % مولاي قد فقت الورى % % فيمن تقدم أو تأخر ؛ % 2(@)(@@) % أنت المقدم رتبة % وأحق فينا أن تصدر . % 3(@)(@@) % لكنني يا سيدي % % في مثل هذي الحال أعذر ؛ % 4(@)(@@) % ولأنت منا بالتصدر % في مقام الفضل أجدر ؛ % 5(@)(@@) % لكنه حكم الزمان % وحكمه شيء مقدر ؛ % 6(@)(@@) % لك اسوة فيما معنى % . . . . . . . . % 7(@)(@@) % فلقد % . . . . . . . % PageV01P493 البحر : - 1(@)(@@) % لا ؛ ورمان النهود % فوق أغصان القدود % 2(@)(@@) % وأقاح وورود % من ثغور وخدود % 3(@)(@@) % وغصون من قدود % تتثنى في البرود % 4(@)(@@) % ووصال من حبيب % بعد هجر وصدود % 5(@)(@@) % لم أحل عنكم ولا حلت % عقود من عهودي ؛ % 6(@)(@@) % ولئن قل اصطباري 
ms107	 % % فغرامي في مزيد ؛ % 7(@)(@@) % ولئن غبتم ؛ فلستم % عن فؤادي ببعيد . % PageV01P494 البحر : - 1(@)(@@) % نعاهد من نحب ؛ فلا نجاب % ونمتدح الملوك ؛ فلا نثاب % 2(@)(@@) % فبعدا للقريض إذا غدونا . . % عليه لا نجاز ولا نجاب % PageV01P495 البحر : - 1(@)(@@) % ومن فضل الميهمن عن قريب % نعود لمثل ما كنا عليه ؛ % 2(@)(@@) % وأشكو ما ألاقي من شجوني % % له ؛ وأبث أشواقي إليه ؛ % 3(@)(@@) % ونعقد راية للوصل بيضا % % إذا انهزم البعاد على يديه % % PageV01P496 البحر : - 1(@)(@@) % سلاما ألذ من السلسبيل % . . وأحلا من الوصل بعد الصدود % 2(@)(@@) % كعود الشباب ورشف % الرضاب وكسر الجفون % PageV01P497 البحر : - 1(@)(@@) % أتاني ؛ والفؤاد رهين شوق % فسرى بعض وجدي واشتياقي ؛ % 2(@)(@@) % وقلت لعله من فضل ربي ؛ % يكون لنا مقدمة التلاقي . % PageV01P498 البحر : - 1(@)(@@) % يا حسن وقت لنا تقضى % % بقربكم مر كالنسيم ؛ % 2(@)(@@) % وطيب عيش بكم عرفنا % % في وجهه نضرة النعيم % PageV01P499 البحر : - 1(@)(@@) % عادت عليك بما ترجو وتأمله % % عوائد البر والإحسان والكرم ؛ % 2(@)(@@) % ولا برحت سعيد الجد مغتبطا % تختال في حلل الإقبال والنعم ؛ % 3(@)(@@) % يروون عنك من المجد المؤثل يا % % فتى المكارم ما يروون عن هرم % PageV01P500 البحر : - 1(@)(@@) % حكت أخلاق مرسلها وأهدت % شذا أذكى من المسك الفتيت ؛ % 2(@)(@@) % تكاد بهن أبكار المعاني % % من الإعجاب ترقص في البيوت % % PageV01P501 البحر : - 1(@)(@@) % لم لا ؛ وقد وشت مطارفها % % كف المليك الندب ذي الكرم % 2(@)(@@) % كف إذا برزت لمكرمة . . % يهدي سناها في دجى الظلم % 3(@)(@@) % غراء ما خلقت أناملها % % إلا لحمل السيف والقلم ؛ % 4(@)(@@) % ترجو لها طول البقا أمم % بوجودها أمنت من العدم % PageV01P502 البحر : - 1(@)(@@) % قاضي القضاة وعالم العلما الذي % % أحيى من المجد الأثيل رفاتا ؛ % 2(@)(@@) % من جرت معه الفحول إلى مدى % % قصرت خطاهم عن خطاه وفاتا ؛ % 3(@)(@@) % من لا يدانيه على ونباهة % من ظل في كسب الفخار وباتا . . % 4(@)(@@) % من شرفت ؛ وهم الكرام صفاته % % من أهله الأحياء والأمواتا . % PageV01P503 البحر : - 1(@)(@@) % فليهن هذا الزمان أن قد % أصبح في أهله فريدا ؛ % 2(@)(@@) % أدرك غايات كل مجد % ورام لو أمكن المزيدا ؛ % 3(@)(@@) % لله كم قلد الليالي % % من در عليائه عقودا ؛ % 4(@)(@@) % فليس ترضى حلى علاه % غير عمود الصباح 
ms108	 جيدا ؛ % 5(@)(@@) % وكم له من شذور نظم % تلين من لطفها الحديدا . % 6(@)(@@) % من كل مصقولة المباني % % يشيب إنشادها الوليدا . % PageV01P504 البحر : - 1(@)(@@) % سالكا من فنونه كل شعب % جانبا من غصونه أثماره ؛ % 2(@)(@@) % راتعا من علومه في رياض % خائضا في بحاره الزخاره % % 3(@)(@@) % كل حين أجيل فكري وطرفي % % في فنون مثل الرياض نضاره ؛ % 4(@)(@@) % تارة أشتفي بأدابه الغر % وطورا أجني العلوم ؛ وتاره . % PageV01P505 البحر : - 1(@)(@@) % ما كان ظني فيك مولاي أن % تبلغ في الهجر إلى ما أرى . % 2(@)(@@) % فهل ترى يرجع غصن اللقا % % بعد التنائي نضرا أخضرا . % 3(@)(@@) % ويشتكي القلب صباباته % ويخبر الطرف بما قد جرى % % PageV01P506 البحر : - 1(@)(@@) % وكيف ؛ ونار أشواقي دليل % على ما صرت أكتمه وأخفي ؛ % 2(@)(@@) % وحسبي أن شوقي منذ بنتم % يقصر عن مداه كل وصف % PageV01P507 البحر : - 1(@)(@@) % لانال منك فؤادي ما يرجيه % إن كان طول التنائي عنك يسليه ؛ % 2(@)(@@) % سل الصبابة عن جسمي السقيم ولا % % تسل سقامي فإن السقم يخفيه ؛ % 3(@)(@@) % ولا تسل غير طرفي عن مدامعه % لا تأخذ الماء إلا من مجاريه ؛ % 4(@)(@@) % أشكو إلى الله وجدا ظلت أكتمه % عن عاذلي ودموع العين تبديه % % 5(@)(@@) % وخاطرا قد تمادى في غوايته % % وزاد حتى تمادى في تماديه % 6(@)(@@) % وصرف دهر أصابتني نوائبه % بكل سهم من الأحداث تبريه ؛ % 7(@)(@@) % سقيا لدعر مضى لو كان ساعدني % % حظي لكنت بهذا الدهر أفديه ؛ % 8(@)(@@) % هذا الزمان الذي لا كان من زمن % ولا سقاه من الوسمي ساريه % 9(@)(@@) % مات الوفاء وأبنلء الوفاء به % فالمجد من بعدهم أقوت مغانيه ؛ % 10(@)(@@) % فأين من يستحق المدح مبتذلا % للمال فيه فيوفينا ونوفيه % % PageV01P508 11(@)(@@) % لهفي على غر أبيات مدحت بها % % من لو هجوت لأرخصت الهجا فيه % 12(@)(@@) % لهفي على ثوب عز نشره عطر ؛ % ألبسته لشقائي غير أهليه % 13(@)(@@) % وأفق نظم تذيب الصخر رقته % أطلعت فيه نجوما من معانيه ؛ % 14(@)(@@) % حبرته في بخيل نقش درهمه ؛ % الله من أعين السؤال يحميه % 15(@)(@@) % تكاد تسجد للدينار جبهته % بخلا ويعبده من دون باريه % 16(@)(@@) % يود لو أن في آذانه صمما % إذا دعاه إلى المعروف داعيه 
ms109	 % 17(@)(@@) % لو جاءه المصطفى مستشفعا % بأمين الله في درهم ما كان يعطيه ؛ % 18(@)(@@) % لا المدح يغريه بالإعطا لسائله % ولا الهجاء عن الحرمان يثنيه ؛ % 19(@)(@@) % أزهى من الديك ؛ إذ يمشي على صلف % له جناحان من كبر ومن تيه ؛ % 20(@)(@@) % لا حلم فيه ولا عقل ولا أدب % ولا وفاء إلى المعروف يهديه . % PageV01P509 21(@)(@@) % يروم شأو العلى ؛ والبخل يقعده % كأنه طائر قصت خوافيه % 22(@)(@@) % يرى التكبر من اسنى مناقبه % ويحسب البخل من أعلى معاليه ؛ % 23(@)(@@) % فليت شعري على ما فيه من صلف % أكان منتظرا للوحي يأتيه % % 24(@)(@@) % قلدته لشقائي في سعادته % عقدا من المدح قد راقت لآليه % 25(@)(@@) % تود شمس الضحى لو أنها حليت % به وبدر الدجى لو كان يحكيه % 26(@)(@@) % من للزهور بأن تحكي شمائله % ومن لزهر الدياجي لو تضاهيه % 27(@)(@@) % وقائل لي اتهجوه فقلت له % مهلا ؛ فإن هجائي ليس يؤذيه ؛ % 28(@)(@@) % إني لأتلو مساويه فيحسبني . . % لفرط تغفيله أتلو مساعيه % 29(@)(@@) % قد كان مدحي له ذنبا شقيت به % فصار تكفيره عني هجائيه % 30(@)(@@) % يا هادما بمساويه بناء على % أبوه دون ملوك الأرض بانيه ؛ % PageV01P510 31(@)(@@) % حذار من نار فكر أضرمت لهبا ؛ % ولا تقف لعباب سال واديه ؛ % 32(@)(@@) % فما نبا سيف عزمي حين أعمله % ولا خبا زند فكري حين أوريه ؛ % 33(@)(@@) % وما امتدحتك أرجو منك نيل غنى ؛ % لكن قضاء جرى في الكون ماضيه % 34(@)(@@) % ولو أردت غناء لامتدحت فتى % ينال مادحه أقصى أمانيه % % PageV01P511 البحر : - 1(@)(@@) % وصاحب أنشدني مرة % من شعره ما يشبه الشعرا ؛ % 2(@)(@@) % وقال هل أبصرت مثلا له % ما بين أشعار الورى طرا % 3(@)(@@) % قلت له لا عدمتك العلى % % هذا لعمري يعجز الفكرا ؛ % 4(@)(@@) % هذا هو الشعر لعمري ؛ فما % % اولاه بالتقريض ما أحرى % % 5(@)(@@) % بمثله تستخرج الفضة البيضاء % % بل تستخرج الصفرا ؛ % 6(@)(@@) % فاقعد على هام الثريا فقد % فقت به كل الورى فخرا . % PageV01P512 البحر : - 1(@)(@@) % وسارق لمعاني الشعر من لي لو % رأيت أشلاه في أظفار ذي لبد ؛ % 2(@)(@@) % لو أن من نظم المعنى تصوره % شبلا لأخرجه من غابة الأسد ؛ % 3(@)(@@) % أهين أن معنى بت 
ms110	 أنظمه % ما دار قبلي في فكر ولا خلد . . % 4(@)(@@) % أحدو إليه القوافي العون وهي إذا % ما بين مقترب مني ومبتعد . . % 5(@)(@@) % وبعت من أجله نومي ؛ ويأخذه % % من نام عن تعبي فيه وعن سهدي % % PageV01P513 البحر : - 1(@)(@@) % ومثقل وافاه يوم حمامه % % في غفلة وكذا الحياة غرور ؛ % 2(@)(@@) % قد قلت إذ مروا علي بنعشه % يعلوه منه على الأكف ثبير ؛ % 3(@)(@@) % ما كنت أحسب قبل موتك أن أرى % % رضوى على أيدي الرجال يسير % PageV01P514 البحر : - 1(@)(@@) % ومثقل يكفيك منه انه % % أضحى يخف لديه كل مثقل ؛ % 2(@)(@@) % تشقى برؤيته العيون كأنه % % عيد أطل على فقير معول % PageV01P515 البحر : - 1(@)(@@) % ومثقل وافي مقام جماعة % فيه السقاة تطوف بالكاسات ؛ % 2(@)(@@) % فسمعت القوم يدعو بعضهم % % توبوا ؛ فهذا هادم اللذات % PageV01P516 البحر : - 1(@)(@@) % من راحمي من ثقيل بارد نظري % % إليه برح بي سقما وأمرضني ؛ % 2(@)(@@) % إذا بدا شخصه لي قمت أنشده % % تبارك الله مجري الروح في حضن % PageV01P517 البحر : - 1(@)(@@) % واسود ليس يندى منه كف % لطالبه ؛ إذا سيم النوالا % 2(@)(@@) % أقول لطالب الجدوى ترفق % % فمن عند الظلام طلبت مالا % PageV01P518 البحر : - 1(@)(@@) % أشفقت إذ أوجعوه ضربا % عليه من جوره خشيت % 2(@)(@@) % فقال ؛ لا تخش نحن قوم % ليس على غيرها نموت . % PageV01P519 البحر : - 1(@)(@@) % ودائي من قبيلي براني % % بطلعته وبالطرف العليل ؛ % 2(@)(@@) % وقالوا من قبيل الوجد دائي ؛ % صدقتم ذاك من هذا القبيل ي % % PageV01P520 البحر : - 1(@)(@@) % أهل المدايع كلكم % عن حلة الأيمان عاري % % 2(@)(@@) % إن المدايع هذه % % ستحلكم دار البوار ي % % PageV01P521 البحر : - 1(@)(@@) % قل لمن . . . . . . . . % . . . . . . . . . . . . . % 2(@)(@@) % عد إلى تقديم صنو المصطفى % % ولك الويلات إن لم تعد % PageV01P522 البحر : - 1(@)(@@) % آل النبي هم أتباع ملته % من الأعاجم والسودان والعرب ؛ % 2(@)(@@) % لو لم يكن آله إلا أقاربه % % صلى المصلي على الطاغي أبي لهب % 3(@)(@@) % آل النبي هم أتباع ملته % من مؤمني رهط الأدنون في النسب ؛ % 4(@)(@@) % هذا مقال ابن إدريس الذي % % روت الأعلام عنه ؛ فمل عن منهج الكذب ؛ % 5(@)(@@) % وعندنا ؛ أنهم أبناء فاطمة % وهو الصحيح بلا شك ولا ريب . % PageV01P523 البحر : - 1(@)(@@) % الناصبي جاحد % أعمى الشقاء بصره ؛ % 2(@)(@@) % فرق ما بين 
ms111	 النبي . . % وأخيه حيدره % % 3(@)(@@) % لا تعجبوا من بغضه % للعترة المطهرة % % 4(@)(@@) % فإنه معرفة % لكن أبوه نكرة % % PageV01P524 البحر : - 1(@)(@@) % يا من هجاني عامدا % ومحله عندي مكين % 2(@)(@@) % وأباح عرضي بالهجاء . . % وعرضه عندي مصون ؛ % 3(@)(@@) % لم ينهه عقل لديه % كنت أعرفه ودين ؛ % 4(@)(@@) % كن كيف شئت فلي % % فؤاد بالوفا أبدا يدين ؛ % 5(@)(@@) % إن تحفظ الود الأكيد % فإنك الثقة الأمين % 6(@)(@@) % أو حلت عن ودي وخنت . . % فلا أحول ولا أخون ؛ % 7(@)(@@) % حاشا لمثلك إن مثلي % % عنده أبدا يهون % 8(@)(@@) % ولقد علمت مودتي % % والشك يذهبه اليقين % 9(@)(@@) % فاعطف إلى الذكر الجميلواحذر مفلق بهجائه تقذى برؤيته العيون % فإنه حلي . . يزين ساقط بيت ص % % 10(@)(@@) % كم مفلق بهجائه . . % تقذى برؤيته العيون % PageV01P525 11(@)(@@) % خذها على محض الوداد ؛ % كأنها الدر الثمين . % PageV01P526 البحر : - 1(@)(@@) % هجوتني ظالما ؛ فرفقا % بمؤمن قد أكلت لحمه % % 2(@)(@@) % ولم يكن ضائري ؛ ولكن % % أخاف من أن تموت تخمه % PageV01P527 البحر : - 1(@)(@@) % يا مبتدي ظلمي ستلقى غب صنعك في ابتدائك % % 2(@)(@@) % كن كيف شئت ؛ قد اتكلت % على النوائب في جزائك % 3(@)(@@) % قد كنت أهوى القرب منك % قليل صبر عن لقائك ؛ % 4(@)(@@) % إذ كنت تسعى في رضاي % وكنت أسعى في رضائك % % 5(@)(@@) % حتى تغير منك ما % % قد كنت أعهد من وفائك ؛ % 6(@)(@@) % وثناك صرف الدهر عن % ودي وكدر من صفائك % 7(@)(@@) % فالآن قد أصبحت أطلب % من يخلص من إخائك % % 8(@)(@@) % ولسوف تطلب صحبتي % % فأقول مت بوخيم دائك . % PageV01P528 البحر : - 1(@)(@@) % أيها المغضب جهلا % ليس رزقي في رضاكا ؛ % 2(@)(@@) % لست أرضاك إذا لم % % ترتضيني لإخاكا ؛ % 3(@)(@@) % فاتخذ غيري خليلا فقد % % اخترت سواكا % % PageV01P529 البحر : - 1(@)(@@) % يا من تبدل بي بديلا في الهوى % % خففت عني حب ثقل جائر % % 2(@)(@@) % ناديت حبك خل عن قلبي فقد % % محيت سطورك من صحيفة خاطري ؛ % 3(@)(@@) % وكما رددت لي المنام تفضلا % فامنع خيالك أن يمر بناظري . % PageV01P530 البحر : - 1(@)(@@) % نقضت عهودي فاسترحت من الهوى % % وقد كان قلبي في عناء من الحب ؛ % 2(@)(@@) % جزى الله نقض العهد خيرا ؛ فإنه % أعان على إخراج حبك من قلبي ؛ % 3(@)(@@) % فها انا لا تجري 
ms112	 عليك مدامعي % % لبعد ؛ ولا يشتاق قلبي إلى القرب ؛ % 4(@)(@@) % ولا في وصال منك أطلب شافعا % ولا رسلي تأتي إليك ولا كتبي ؛ % 5(@)(@@) % فسر حيثما شاءت ركابك ؛ إنني % % لفي سعة أن لا أقل من الصحب % PageV01P531 البحر : - 1(@)(@@) % وقد كنت ذا صبر على الهجر والنوى % % على حمل أثقال الهوى أتكلف % 2(@)(@@) % صبرت على أشياء منك أقلها . . % يقل له صبر الجليد ويضعف ؛ % 3(@)(@@) % فأما إذا استبدلت عني صاحبا % وأظهرت لي غير الذي كنت أعرف % % 4(@)(@@) % وأوسعتني من غير جرم ملالة % وصدقت ما قال الوشاة وزخرفوا ؛ % 5(@)(@@) % فزدني هجرانا ؛ أزدك تسليا ؛ % فلا أنا يعقوب ولا أنت يوسف % 6(@)(@@) % وخذ في التجافي ما أردت ؛ فلم أقل ؛ % لعلك ترضى ؛ أو لعلك تعطف % PageV01P532 البحر : - 1(@)(@@) % إلى كم تغضون من قدرنا % % وكم تجهلون وكم نحلم % 2(@)(@@) % وكم ذا تهينون أعراضنا % % ونحن لأعراضكم نكرم % % PageV01P533 البحر : - 1(@)(@@) % لفعل الخير تشتمني % % وتركي بصث أسرارك % 2(@)(@@) % فقل ما شئت في شتمي % % فإني الفاعل التارك % PageV01P534 البحر : - 1(@)(@@) % مالي وقد أتيتكم % في عرض قد عرضا % % 2(@)(@@) % سددت سهم أملي % % وما أصبت الغرضا % % PageV01P535 البحر : - 1(@)(@@) % ركبنا مطايا الشوق سعيا إليكم % % لنشفي فؤادا بالفراق معذبا ؛ % 2(@)(@@) % فلم نلق منكم ما عهدناه أولا . ؛ % ولا قلتم أهلا وسهلا ومرحبا % % PageV01P536 البحر : - 1(@)(@@) % شوقي إلى الغيث قد تمادى % % فابعث به سيدي سريعا ؛ % 2(@)(@@) % لا زال يحكيك في نوال % ولا عدمناكم جميعا . % PageV01P537 البحر : - 1(@)(@@) % يلوم في الغيث أقوام مؤلفة % واللوم عنه لعمر الله مردود ؛ % 2(@)(@@) % فإنه سوق آداب جلبن به ؛ % والسوق هذا وهذا فيه موجود % PageV01P538 البحر : - 1(@)(@@) % مذ تراءى الإحماض في الغيث قوم % أوسعوه لذاك لعنا وسبا ؛ % 2(@)(@@) % قلت هذا مصداق ما ذكروه % % إن للغيث باغضا ومحبا % % PageV01P539 البحر : - 1(@)(@@) % يا أديبا لا يداني شأوه % في المعالي من دنا أو من شحط ؛ % 2(@)(@@) % قل لنا ما اسم ترى جملته % ضده في الصوف إن حرف سقط % 3(@)(@@) % حسن العقبى وإن قوبل في % % أول الأمر بكره وسخط % 4(@)(@@) % وهو في العد ثلاثي وما % % في الذي أوردته قط غلط ؛ % 5(@)(@@) % وإذا الثلثان منه سقطا % % صار 
ms113	 ما أبقي معتل الوسط ؛ % 6(@)(@@) % وله التصحيح حق لازم % وترى أوسطه ما صح قط % PageV01P540 البحر : - 1(@)(@@) % يا فاضلا قد جاءنا % % بكل معنى حسن ؛ % 2(@)(@@) % ماذا الذي تراه مثل % % قولك الخدع فني % % PageV01P541 البحر : - 1(@)(@@) % يا من غدا بين الأنا . . % م بكل مكرمة خليقا ؛ % 2(@)(@@) % ما مثل قولك للذي % % حاجيته أطلب طريقا % % PageV01P542 البحر : - 1(@)(@@) % كيف أبدي شجوني وأنوح % كيف لا أغدو كئيبا وأروح % 2(@)(@@) % كيف لا تهجر عيناي الكرى % % كيف لا تجري دموعي وتسيح % 3(@)(@@) % بعد ما ضمتك أطباق الثرى % % وتغشاك على رغمي الضريح ؛ % 4(@)(@@) % يا نصيحي ؛ لا تلمني في البكى % % بان لي غشك فيه يا نصيح % 5(@)(@@) % لا ترم مني صبرا بعده ؛ % إن صبري عن جميل لقبيح ؛ % 6(@)(@@) % يا حبيبا ؛ حزنه أمرضني % % وله في قلبي الود الصحيح ؛ % 7(@)(@@) % هل لطرفي منك يوما نظرة % ريثما يندمل القلب الجريح % PageV01P543 البحر : - 1(@)(@@) % يا عين ؛ أما لهذا الحادث الجلل % % شقي غمامك عن مسترسل هطل ؛ % 2(@)(@@) % وفجري من ينابيع الدموع إذا % بحرا ولاتقنعي منهن بالوشل % 3(@)(@@) % والنوم لا تصليه واهجريه أسى % فالسهد في مثله فرض على المقل ؛ % 4(@)(@@) % وأنت يا قلب إن لم تنصدع أسفا % بين الضلوع فسر عنهن وانتقل ؛ % 5(@)(@@) % وأنت يا صبر ولي الظهر منهزما % فقد أتتك جيوش الحزن عن كمل ؛ % 6(@)(@@) % فقد رزينا بمن هدت لمصرعها % % شم الشوامخ وانهدت ذرى القلل ؛ % 7(@)(@@) % شمس الظهيرة ؛ إلا أنها أبدا % ما استوطنت قط إلا دارة الحمل % 8(@)(@@) % غابت فأصبح ظل الجود منتقلا ؛ % وهل سمعت بظل غير منتقل % % 9(@)(@@) % وأسعرت إذ تولت في جوانحنا % % حربا تحدث عن صفين والجمل % % 10(@)(@@) % وقام كل نبيه القدر يندبها % % بكل مبتكر الألفاظ مرتجل % PageV01P544 11(@)(@@) % من للأرامل والأيتام يوسعهم % % بذلا إذا ضن كف الغيث بالبلل % 12(@)(@@) % ومن يجير طريد الحادثات ومن % يرجى لتصديق حسن الظن والأمل % 13(@)(@@) % ومن يجود على العافين إن وقفوا % % من رسم إحسانها العافي على طلل % 14(@)(@@) % كم لوعة أودعت إذ ودعت وأسى % يزول منها ثبير وهي لم تزل ؛ % 15(@)(@@) % بكت عيون المعاني بعدها حزنا % وكشر الدهر عن أنيابه 
ms114	 العظل % 16(@)(@@) % فانف المنام وقل للدهر نم ؛ فلقد % رميت يا دهر كف المجد بالشلل ؛ % 17(@)(@@) % وقد فتكت بشمس لو تقاس بها % % شمس الظهيرة لم تنحط عن زحل ؛ % 18(@)(@@) % وروضة لم تحاذر بطش حارسها % % وطالما منعت بالبيض والأسل ؛ % 19(@)(@@) % وقد تعمدت إرغام الأنوف بما % % أبديت من خطأ محض ومن خطل % 20(@)(@@) % جليلة القدر فازت عند خالقها % % بحسن ما ادخرت من صالح العمل ؛ % PageV01P545 21(@)(@@) % وأسكنت جنة الفردوس خالدة % تميس في حبر الرضوان والحلل ؛ % 22(@)(@@) % عقيلة المجد ؛ ما بين النبي زكت % أصلا ؛ وبين أمير المؤمنين علي % % 23(@)(@@) % أم الحسين الذي سارت مكارمه % % في الخافقين مسير الشمس والمثل ؛ % 24(@)(@@) % ملك لديه عهود الجود محكمة % يحول صبغ الليالي وهي لم تحل ؛ % 25(@)(@@) % تقصر الصيد عن إدراك غايته % سعيا ويدركها مشيا بلا عجل % 26(@)(@@) % إن تلقه تحظ منه في ندى وردى % بالزاخر العذب أو بالفارس البطل ؛ % 27(@)(@@) % من معشر ثاقبي الأحساب همتهم % بلوغ غاية مجد السادة الأول ؛ % 28(@)(@@) % من سائري الذكر في شام وفي يمن ؛ % من باذلي الجود في حاف ومنتعل ؛ % 29(@)(@@) % من حافظي الدين من رأي الغلاة وما % % عساه ينجم من زيغ ومن زلل % 30(@)(@@) % من كاشفي ظلم الجلى برأيهم % إذا تجهم وجه الحادث الجلل ؛ % PageV01P546 31(@)(@@) % من قائدي الجيش مثل البحر ملتطما % مسيره من غمام النصر في ظلل % 32(@)(@@) % من واهبي البيض والسمر الذوابل قد % % ضمت إليها كرام الخيل والإبل ؛ % 33(@)(@@) % من مالكي الملك في الدنيا بأجمعها % % فما لهم فيه بعد الله من مثل ؛ % 34(@)(@@) % من موردي بيضهم هام الكماة فما % % تنفك في علل منها وفي نهل ؛ % 35(@)(@@) % من مصدري سمرهم عوج الكعوب بما % % تفض من حلق الأدراع في الوهل % 36(@)(@@) % لكنهم كفلوا تثقيفها أبدا % إذا انثنت بلظى للحرب مشتعل % 37(@)(@@) % قوم أقاموا حدود الله وابتدروا % % بالمشرفية والعسالة الذبل % 38(@)(@@) % يستوطنون ظلال النقع يوم وغى % ويصحبون القنا فيه بلا ملل ؛ % 39(@)(@@) % رجح ؛ كأنهم لم يعرفوا أبدا % من الكلام سوى خذ ما تشا وسل ؛ % 40(@)(@@) % تضيء في دول الإسلام دولتهم % % كأنها غرة في جبهة الدول ؛ % PageV01P547 41 
ms115	(@)(@@) % وكم بدولتهم من دولة نسخت ؛ % كأنها ملة الإسلام في الملل % 42(@)(@@) % وجدت فيهم مكان القول ذا سعة % فإن وجدت لسانا قائلا فقل % 43(@)(@@) % لم لا نشاركهم في الحادثات وقد % % صرنا نشاركهم في المال والخول ؛ % 44(@)(@@) % صلى الإله عليهم ما سرى قمر % في الأفق بعد أبيهم خاتم الرسل . % PageV01P548 البحر : - 1(@)(@@) % أفض عليك لبوس الصبر والجلد % فإنه الموت لا يبقي على أحد ؛ % 2(@)(@@) % وبالتجلد قابل كل حادثة ؛ % إن لم يكن لك عند الخطب من جلد ؛ % 3(@)(@@) % إن الذي يظهر الإنسان من جزع % أمر ؛ إذا جاء أمر الله لم يفد % 4(@)(@@) % فالموت أكؤسه لا بد دائرة % لكل مقترب منا ومبتعد ؛ % 5(@)(@@) % كل له عمر مفض إلى أجل ؛ % متى أتى المرء ؛ لم ينقص ولم يزد ؛ % 6(@)(@@) % عمر الفتى حلبة والموت غايتها % % والمرؤ من موته يسعى إلى أمد ؛ % 7(@)(@@) % وقد يهون ما في القلب من جزع % % أن لا بقاء لغير الواحد الصمد ؛ % 8(@)(@@) % يا درة العقد في آل المؤيد لم % % يترك مصابك من قلب ولا كبد % 9(@)(@@) % لو كان يدفع من ماضي القضا عدد % حطناك بالعدد الموفور والعدد % 10(@)(@@) % لو أنه كان يرضي الموت فيك فدى % إذا فدنياك بالأهلين والولد % PageV01P549 11(@)(@@) % لكنه الموت ؛ لا يرضيه بذل فدى % % ولا يصيخ إلى عذل ولا فند ؛ % 12(@)(@@) % ولا يرق لذي ضعف وذي خور % ولا يحاذر بطش الفارس النجد % 13(@)(@@) % يأتي الملوك ؛ ملوك الأرض مقتحما % ويخرج الشبل من عريسة الأسد % 14(@)(@@) % من للمساكين ؛ قد أصليت أكبدهم % بلاعج من ضرام الحزن متقد % 15(@)(@@) % من للأرامل ؛ تبكيك الدماء لما % % حملن بعدك من كرب ومن كمد ؛ % 16(@)(@@) % كم من فؤاد حيران ملتهبا % حزنا ومن مدمع في الخد مطرد ؛ % 17(@)(@@) % لا غرو إن متن من حزن عليك فقد % % فقدن منك لعمري خير مفتقد % 18(@)(@@) % أما كرزئك ؛ لا والله ما سمعت % أذن ولا دار في فكر ولا خلد . % 19(@)(@@) % رزو غدا منه شمل المجد منصدعا % وفت في ساعد العلياء والعضد ؛ % 20(@)(@@) % جل المصاب ؛ فما خلق يقول إذن % يا صبر اسعد ؛ ولا يا حزن قدك 
ms116	 قد ؛ % PageV01P550 21(@)(@@) % وحسبنا أسوة طهو حيدرة % والآل أجمع من داع ومقتصد ؛ % 22(@)(@@) % فاصبر عماد الهدى للحكم محتسبا % أجرا وسلم لأمر الواحد الصمد ؛ % 23(@)(@@) % فالصبر عقد نفيس ماله ثمن % ولا يكون لغير السيد السند ؛ % 24(@)(@@) % وما الرزية يا مولاي هينة ؛ % وإن أمرت بحسن الصبر والجلد % 25(@)(@@) % لكن نسومك عادات عرفت بها ؛ % أن لست تلقي إلى حزن غزا بيد ؛ % 26(@)(@@) % وليس مثلك من بالصبر نأمره ؛ % فأنت الذي يهدي إلى الرشد ؛ % 27(@)(@@) % كم حادث لا تطيق الشم وطأته ؛ % لاقيته من جميل الصبر في عدد . % 28(@)(@@) % ألست من سادة شم غطارفة % أحيوا بوبل الندى الوكاف كل ندي ؛ % 29(@)(@@) % القوم تضرب أمثال العلى بهم % بين البرية طرا آخر الأبد ؛ % 30(@)(@@) % المقدمون وأسد الغاب خاضعة % والباذلون الجود والأنواء لم تجد ؛ % PageV01P551 31(@)(@@) % غر رقوا من مراقي المجد أرفعها % % وقوموا كل ذي زيغ وذي أود ؛ % 32(@)(@@) % واشكر لمولاك إذ أولاك عافية ؛ % لا زلت ترفل في اثوابها الجدد % 33(@)(@@) % وما بقيت لنا فالصدع ملتئم ؛ % فأنت للدين مثل الروح للجسد % PageV01P552 البحر : - 1(@)(@@) % أتدري من تخرمت المنون % ومن أرقت لمصرعه العيون % % 2(@)(@@) % ومن ذا أثقل الأعناق حملا % وخف لحزنه العقل الرصين % % 3(@)(@@) % ومن ملأ القلوب أسى وحزنا % فكل فتى لمصرعه حزين % 4(@)(@@) % ومن في جنة الفردوس أضحى % % لديه الظل والماء المعين % 5(@)(@@) % وأي هلال أفق غاب عنه % وكان لأفقه أبدا يزين % 6(@)(@@) % أتدري يا زمان بمن دهتنا % % صروفك ؛ أنك الزمن الخؤون % 7(@)(@@) % وأنك بالذي أحدثت فينا . . % جدير أن تساء بك الطنون ؛ % 8(@)(@@) % لئن كدرت من عيش البرايا % % فمبدأ خلقهم ماء وطين ؛ . % 9(@)(@@) % هوى البدر الذي قد كان حقا % % به نور الهداية مستبين ؛ % 10(@)(@@) % هوى الجبل الذي قد كان يأوي % % إليه الملتجي والمستكين % PageV01P553 11(@)(@@) % مضى القرم الذي قد كان ذخرا % تناط به الحوائج والشؤون ؛ % 12(@)(@@) % فأي سحاب دمع ليس يهمي % % وأي حصاة قلب لا تلين % 13(@)(@@) % وليس يرد سهم الموت درع % مزردة ولا حصن حصين % 14(@)(@@) % سقيت الغيث قبرا حل فيه % % تقى وعلى وإيمان ودين ؛ % 15(@)(@@) % ثوى فيك الذي ما كان يلفى 
ms117	 % % له في كل مكرمة قرين ؛ % 16(@)(@@) % رجعنا عن ثراه بجيش حزن % له في كل جارحة كمين % 17(@)(@@) % وأجرينا جياد الصبر عنه ؛ % ولكن شوط مرزئه بطين . % 18(@)(@@) % فيا لك ميتا قد بان عنا % % تكاد لبينه الأحشا تبين ؛ % 19(@)(@@) % وآه لطول بعدك من حبيب % وهل يجدي التأوه والحنين % 20(@)(@@) % ووالهفي عليك وقد تدانى % % خروج الروح وانقطع الأنين % PageV01P554 21(@)(@@) % وأسكنت التراب برغم قوم % محلك في قلوبهم مكين . . % 22(@)(@@) % يكاد النوم أن يغشى الأماقي % % فتلفظه لذكراك الجفون ؛ % 23(@)(@@) % أهنا إذ دفنت عقود دمع % مخبأة لغيرك لا تهون ؛ . % 24(@)(@@) % وكلفنا الجوانح عنك صبرا % فقالت لا قرار ولا سكون ؛ % 25(@)(@@) % وخانتنا بك الأيام لكن % بحسن الصبر بعدك نستعين . % 26(@)(@@) % وكيف الصبر عنك أو التسلي % % جميل الصبر بعدك لا يكون ؛ % 27(@)(@@) % فهل يدري سريرك من علاه % علاه العلم أجمع واليقين ؛ % 28(@)(@@) % وهل يدري ضريحك من تغشى % % ومن وهو تحت تربته دفين % 29(@)(@@) % قرنت بصالح الأعمال فيه % % وحسبك أنه نعم القرين ؛ % 30(@)(@@) % يعز على العلوم نواك عنها % % وأنت لبحرها الطامي سفين % % PageV01P555 31(@)(@@) % هلالا كنت غالته الليالي % % وليثا كنت أسلمه العرين ؛ % 32(@)(@@) % جعلت وداد أهل البيت دينا % لعلمك أنه الحبل المتين ؛ % 33(@)(@@) % ودنت بدينهم في كل حال % وذاك لعمرك الحق اليقين % % 34(@)(@@) % وكنت من التشيع في محل % تسافر دون غايته العيون . % 35(@)(@@) % فيهنيك القدوم على كريم % % خزائن ملكه كاف ونون ؛ % 36(@)(@@) % ويهنيك الدعاء نجوت عبدي % % فعفوي لا تكدره الظنون ؛ % 37(@)(@@) % ويهنيك ادخارك خير كسب % إذا الجاني بمكسبه رهين ؛ % 38(@)(@@) % وأخذك للصحيفة يوم حشر % إذا انتدبت لتأخذها اليمين ؛ % 39(@)(@@) % سأنظم فيك ما يعلو ويغلو % % ويرخص عنده الدر الثمين ؛ % 40(@)(@@) % وأسقي ترب قبرك غيث دمع % يقصر دونه الغيث الهتون % PageV01P556 41(@)(@@) % فمثلك ما سمعنا في البرايا % % ولا قد كان قط ولا يكون ؛ % 42(@)(@@) % عليك صلاة ربك بعد طه % % وعترته فأنت بها قمين . % PageV01P557 البحر : - 1(@)(@@) % يا قبر جادك وابل الرضوان % واستوطنتك عواطف الغفران ؛ % 2(@)(@@) % وعلى ثراك تخطرت ريح المنى % % تسري بنشر البر والإحسان % 3(@)(@@) % فلقد ثوى بثراك حبر ماجد % حزنت لموقع صوته الثقلان 
ms118	 % 4(@)(@@) % يا ضاحكا في جنة الفردوس قد % % أبكيت من كانت لهه عينان . % 5(@)(@@) % ما كان أبرك منك عمرا ماضيا % قضيته في طاعة الرحمان ؛ % 6(@)(@@) % وغدون معتصما به مستعصما % بمعاقل التقوى من الشيطان . % 7(@)(@@) % وسعيت في كسب الثناء فأنت من كفل الثناء له بعمر ثاني ؛ % من كفل الثناء له بعمر ثاني ؛ % 8(@)(@@) % والعلم أجمعق غدوت مبرزا % في شوط حلبته على الأقران ؛ % 9(@)(@@) % وبذلت نفسك للأئمة راعيا % لعهودهم في السر والإعلان ؛ % 10(@)(@@) % وقضيت دهرا في القراع لعصبة % شغلوا بقرع مثالث ومثاني . % PageV01P558 11(@)(@@) % جاهدت في مولاك حق جهاده % تبغي رضا المتفضل المنان . % 12(@)(@@) % كم من محب قد تركت مكابدا % أهوال دار مذلة وهوان . % 13(@)(@@) % دار المصائب والنوائب والعنا % % وقرارة الأكدار والأحزان ؛ % 14(@)(@@) % أعرضت عن دار الغرور فأنت من % % دار المقامة في أعز مكان . . % 15(@)(@@) % كم ليلة أحييتها متهجدا % بالفكر والصلوات والقرآن . % 16(@)(@@) % تدعو إلهك في دجاها قائلا % جد بالفكاك على الأسير العاني % % 17(@)(@@) % لو كنت تملك إن سئلت إجابة % ما قلت إلا سرني وحباني ؛ % 18(@)(@@) % وأباح لي ورد الرضى كرما وما % % برحت عواطف بره تغشاني % % 19(@)(@@) % وأحلني دار المقامة خالدا % في ظل ملك دائم وأمان % 20(@)(@@) % ونداؤه إياي ؛ فزت بما تشا % % من جنتي ونجوت من نيراني ؛ % PageV01P559 21(@)(@@) % آه لو أنك عشت في أعمارنا % % دهرا ؛ وكنا نحن في الأكفان ؛ % 22(@)(@@) % هيهات لا يبقى على ملكوته % % إلا الإله وكل حي فاني % % 23(@)(@@) % فاذكر أهاليك الذين تركتهم % % يتجرعون مرارة الأحزان ؛ % 24(@)(@@) % واسأل لنا مولاك غفرانا إذا % % حضر الحساب وزلت القدمان ؛ % 25(@)(@@) % أحسن ضيافتنا غداة قدومنا ؛ % فلقد عهدتك مكرم الضيفان % 26(@)(@@) % وصلاة ربك لا تزال مدى المدى % % تهدى إلى المختار من عدنان % 27(@)(@@) % والآل من عذبت موارد ذكرهم % من كل مخلوق بكل لسان % PageV01P560 البحر : - 1(@)(@@) % أتعزى في المصاب % % أم تهنى بالثواب % 2(@)(@@) % وأرى ثانيهما أدن % % ى إلى نهج الصواب ؛ % 3(@)(@@) % فاحتسب بالقادم الراحل % % ذخرا في الحساب ؛ % 4(@)(@@) % وتلق الخطب إن جل % بصبر واحتساب ؛ % 5(@)(@@) % واغنم الزلفة ممن % عنده حسن المآب ؛ % 6(@)(@@) % ليس غير الله يخلو % % من نفاد 
ms119	 وذهاب % 7(@)(@@) % والليالي لم تزل فاعلم % % بنا ذات انقلاب ؛ % 8(@)(@@) % ويحها كم خدعتنا % % بسراب كالشراب % % 9(@)(@@) % لم تزل في الخلق تأتي % % كل خلق بعجاب ؛ % 10(@)(@@) % لم تدع ذا لمشيب % لا ولا ذا ؛ لشباب % PageV01P561 11(@)(@@) % لا ؛ ولا تردعها سطوة % % ذي البأس المهاب ؛ % 12(@)(@@) % هلى ترى فيها نعيما % صفوه غير مشاب % % 13(@)(@@) % أم سرورا لم تكدره % % بحزن واكتئاب % 14(@)(@@) % كم غدت تضرب في % % الناس بسيف غير نابى % % 15(@)(@@) % ليس ترضى غير أروا % % ح البرايا من قراب % 16(@)(@@) % كم أذالت من مصون % وأزالت من حجاب % % 17(@)(@@) % ولكم فلت حساما % وأذلت ليث غاب ؛ % 18(@)(@@) % يقتل الأبطال من % % غير طعان وضراب ؛ % 19(@)(@@) % كم همام قاهر % السكوة . . عضته بناب % % 20(@)(@@) % أزعجته لفراق % غير مرجو الإياب ؛ % PageV01P562 21(@)(@@) % ومليك تركته % رهن أطباق التراب ؛ % 22(@)(@@) % يتشكى الضيق من % % بعد المقاصير الرحاب ؛ % 23(@)(@@) % قد غدا . . أبكم لا % % يمكنه رجع الجوواب % 24(@)(@@) % سامعا غير مجيب ؛ % داعيا غير مجاب ؛ % 25(@)(@@) % وقصور تركتها % % بين أهليها يباب % 26(@)(@@) % وسواء في النهى والموت % % طوق في الرقاب % % 27(@)(@@) % ميت يدرج في الكفن % وحي في الثياب % 28(@)(@@) % ولنا بالمصطفى المختار % % في كل مصاب ؛ % 29(@)(@@) % وبينهم من بهم أرجو % % أماني من عذابي ؛ % 30(@)(@@) % شفعائي يوم حشري % % حين أدعى لكتابي % % PageV01P563 31(@)(@@) % أسوة تفضي إلى % % خير نعيم وثواب % PageV01P564 البحر : - 1(@)(@@) % قبر حوى قطعة من الكبد % أودت فأودى لفقدها جلدي ؛ % 2(@)(@@) % ترحل الصبر عندما رحلت % إلى جوار المهجن الصمد % 3(@)(@@) % يا ليت أن الممات أخرها ؛ % من أمد عاجل إلى أمد ؛ % 4(@)(@@) % لم يبق منة الأسى سوى حرق % ومدمع في الخدود مطرد ؛ % 5(@)(@@) % يا راحلا لم تؤب ركائبه % % ويا حبيبا نأى . . فلم يعد ؛ % 6(@)(@@) % ودرة للفخار أسلمها العقد % وكانت كالروح للجسد ؛ % 7(@)(@@) % ما انصف العاذلون إذ عذلوا % % أن بحت بالحزن فيك والكمد ؛ % 8(@)(@@) % كيف يلومونني على جزعي % % وأنت قلبي دفنته بيدي . . % 9(@)(@@) % كل حبيب تذيب فرقته الأحشا ؛ % ولا مثل فرقة الولد . % 10(@)(@@) % فالحمد لله كل آونة ؛ % حق له الحمد دائم الأبد . % PageV01P565 البحر : - 1(@)(@@) % عزاؤكم آل المطهر في فتى % قضى فقضى المجد المؤثل 
ms120	 والندى ؛ % 2(@)(@@) % أقام بدار الخلد جارا لربه % % وأورثنا حزنا أقام وأقعدا % % 3(@)(@@) % وما كان إلا طود مجد تهدمت % جوانبه ؛ أو عقد جود تبددا ؛ % 4(@)(@@) % ولو كان يفدى هالك جل رزؤه % % لكان بأرواح البرية يفتدى % % 5(@)(@@) % وما دمتم للمجد والجود بعده % % فركن المعالي لا يزال مشيدا ؛ % 6(@)(@@) % وإن جميل الصبر فيكم لعادة % إذا جارحكم الحادثات أو اعتدى ؛ % 7(@)(@@) % تعودتم الصبر الجميل وإنما % % لكل امرء من دهره ما تعودا % % 8(@)(@@) % عليكم سلام الله آل مطهر % ورحمته ما غاب بدر وما بدا ؛ % PageV01P566 البحر : - 1(@)(@@) % يبكي عليكم محب ذاب من أسف % ما خان عهدكم يوما ولا نكثا ؛ % 2(@)(@@) % علمتموه رثاكم وامتداحكم % فمنكم كل مدح فيكم ورثا % % PageV01P567 البحر : - 1(@)(@@) % يا قبر أحمد كم حويت % مكارما ومحامدا ؛ % 2(@)(@@) % شهدت بذاك خزيمة % وكفى خزيمة شاهدا % % PageV01P568 البحر : - 1(@)(@@) % قتلوا الوارم ظلما وأتوا % % بمقال نقضي عجبا % % 2(@)(@@) % حين قالوا يدخل النار وقد % % قتلوه صابرا محتسبا % % PageV01P569 البحر : - 1(@)(@@) % رمنا الفخار فنلنا منه ما شينا % % لما مشى في طريق المجد ماشينا % % 2(@)(@@) % نحن الكرام وأبناء الكرام فإن % تجهل مكارمنا ؛ فاسأل أعادينا ؛ % 3(@)(@@) % واسأل لسان المعالي ؛ ما تلافينا % % وقل للاحقنا ما أنت لافينا % % 4(@)(@@) % فرب مجد تلافينا بناه وقد % وهي ؛ فمن ذا تلافاه تلافينا % % 5(@)(@@) % الشمس والبدر أدنى من مراتبنا % % والأنجم الشهب غارت من مساعينا ؛ % 6(@)(@@) % سعى إلى غاية العليا فأدركها % % ونال من شأوها ما رام ساعينا ؛ % 7(@)(@@) % لنا طريق إلى العلياء واضحة % يسير رائحنا فيها وغادينا ؛ % 8(@)(@@) % يسير في طرق العلياء سائرنا % % فيهتدي بنجوم من أيادينا ؛ % 9(@)(@@) % وكم بخيل تراه في الأنام ؛ ولا % % والله لا كان لا منا ولا فينا % % 10(@)(@@) % هل يعرف المجد إلا في منازلنا ؛ % وهل يحل الندى إلا بنادينا % % PageV01P570 11(@)(@@) % ما إن سئلنا مدى الأيام بذل قرى % % إلا وجدنا بما تحويه أيدينا % % 12(@)(@@) % لا نسأم الضيف إن طالت إقامته % % ولا نخيب فينا ظن راجينا ؛ % 13(@)(@@) % نمشي إلى الموت في يوم الوغى قدما % وهاتف النصر بالبشرى ينادينا % % 14(@)(@@) % لنا عزائم تدني ما نروم ؛ فما % % أدنى خراسان إن رمناهو الصينا 