ms4121	 ، وأخذها عطاء من ابن الزبير ، وأخذها ابن الزبير عن أبي بكر ، وأخذها أبو بكر من النبي ، ما رأيت صلاة أحسن من ابن جريج ) ( حم قط في الأفراد وقال : تفرد به عبد الرزاق عن ابن جريج ) ( ق ) ، وزاد : وأخذها النبي عن جبريل وأخذها جبريل من الله تبارك وتعالاى : قال عبد الرزاق : وكان ابن جريج يرفع يديه ) . )(@)(@@) PageV13P182(@)(@@)(@@)(@@) $ ( 700 ) عن أبي العالية قال :(@)(@@) | 30 ( خطبنا أبو بكر الصديق رضي الله عنه فقال : قال رسول الله : للظاعن ركعتان وللمقيم أربع مولدي بمكة ومهاجري بالمدينة ، فإذا خرجت مصعدا من ذي الحليفة صليت ركعتين حتى أرجع ) ( ابن جرير حل ) . )(@)(@@)(@@)(@@) $ ( 701 ) عن قتادة عن أنس رضي الله عنه قال :(@)(@@) | 30 ( صليت خلف أبي بكر رضي الله عنه الصبح فاستفتح بآل عمران فقام إليه عمر فقال : يغفر الله لك لقد كادت الشمس تطلع قبل أن تسلم ، قال : لو طلعت لألفتنا غير غافلين ) ( حب والطحاوي ) . )(@)(@@)(@@)(@@) $ ( 702 ) عن عروة :(@)(@@) | 30 ( أن أبا بكر رضي الله عنه صلى الصبح فقرأ بالبقرة في الركعتين كلتيهما ) ( مالك عب ق ) . )(@)(@@)(@@)(@@) $ ( 703 ) عن أبي عبد الله الصنابحي :(@)(@@) | 30 ( أنه قدم المدينة في خلافة أبي بكر الصديق رضي الله عنه ، فصلى وراء أبي بكر الصديق المغرب ، فقرأ أبو بكر في الركعتين الأوليين { أم القرآن } وسورة من قصار المفصل ، ثم قرأ في الركعة الثالثة بأم القرآن وهاذه الآية : { ربنا لا تزغ قلوبنا بعد إذ هديتنا وهب لنا من لدنك رحمة إنك أنت الوهاب } ( مالك عب د ، ق ) . )(@)(@@)(@@)(@@) $ ( 704 ) عن أنس(@)(@@) | 30 أن أبا بكر رضي الله عنه صلى بالناس الصبح فقرأ بسورة { البقرة } فقال عمر : ( كادت الشمس أن تطلع فقال : لو طلعت لم تجدنا غافلين ) ( الشافعي عب ض ش ق ) . )(@)(@@)(@@)(@@) $ ( 705 ) عن أنس :(@)(@@) | 30 ( أن أبا بكر رضي الله عنه قرأ في يوم عيد بالبقرة ، حتى رأينا الشيخ يميد من طول القيام ) ( ش ) . )(@)(@@)(@@)(@@) $ ( 706 ) عن أبي بكر بن عبد الرحمن بن الحارث بن هشام(@)(@@) | 30 ( أن أبا بكر الصديق وزيد بن ثابت رضي الله عنه دخلا المسجد 
ms4122	 والإمام راكع فركعا دون الصف ، ثم مشيا وهما راكعان حتى لحقا بالصف ) ( سمويه ق ) . )(@)(@@) PageV13P183(@)(@@)(@@)(@@) $ ( 707 ) عن ابن جريج قال :(@)(@@) | 30 ( أخبرني عطاء قال : اشتكى النبي فأمر أبا بكر رضي الله عنه أن يصلي بالناس ، فصلى النبي للناس قاعدا وجعل أبا بكر وراءه بينه وبين الناس ، فصلى الناس وراءه قياما ، فقال النبي : لو استقبلت من أمري ما استدبرت ما صليتم إلا قعودا بصلاة إمامكم ما كان ، إن صلى قائما فصلوا قياما ، وإن صلى قاعدا فصلوا قعودا ) ( عب ) . )(@)(@@)(@@)(@@) $ ( 708 ) عن أبي سلمة بن عبد الرحمان قال :(@)(@@) | 30 ( جيء بالنبي في مرض حتى جلس في مصلاه ، وقام أبو بكر إلاى جنبه فصلى قائما يأتم بالنبي والناس يأتمون بأبي بكر ) ( عب ) . )(@)(@@)(@@)(@@) $ ( 709 ) عن عروة قال :(@)(@@) | 30 ( خرج النبي يوما وأبو بكر رضي الله عنه يصلي بالناس ، فذهب أبو بكر ينكص فأشار إليه النبي أن يصلي كما هو ، فجاء النبي فجلس إلاى جنبه ، فكان الناس يصلون بصلاة أبي بكر ، وكان أبو بكر يصلي بصلاة النبي ، والنبي جالس ) ( عب ) . )(@)(@@)(@@)(@@) $ ( 710 ) عن أبي ضمرة قال :(@)(@@) | 30 ( خطب أبو بكر رضي الله عنه الناس فحمد الله وأثنى عليه ، ثم قال : إنه سيفتح لكم الشام فتأتون أرضا رفيقة فتشبعون فيها من الخبز والزيت ، وستبنى لكم فيها مساجد ، وإياكم أن يعلم الله منكم أنكم إنما تأتونها تلهيا إنما بنيت للذكر ) ( حم في الزهد ) . )(@)(@@)(@@)(@@) $ ( 711 ) عن ابن جريج قال :(@)(@@) | 30 أخبرني حسن بن مسلم أن رجلا سأل طاووسا متى قيل : الصلاة خير من النوم ؟ فقال : ( أما إنها لن تقل علاى عهد رسول الله ولاكن بلالا سمعها في زمان أبي بكر رضي الله عنه بعد وفاة رسول الله يقولها رجل غير مؤذن فأخذها منه ، فأذن بها فلم يمكث أبو بكر إلا قليلا حتى إذا كان عمر قال : لو نهينا بلالا عن هاذا الذي أحدث وكأنه نسيه وأذن به الناس حتى اليوم ) ( عب ) . )(@)(@@)(@@)(@@) $ ( 712 ) عن أبي بكر رضي الله عنه :(@)(@@) | 30 ( أن أعرابيا جاء إلاى النبي فقال : يا رسول الله بلغني أنك تقول 
ms4123	 : الجمعة إلاى الجمعة والصلوات الخمس كفارات لما PageV13P184 بينهن ما اجتنب الكبائر ، فقال : نعم ، ثم زاده فقال : الغسل يوم الجمعة كفارة ، والمشي إلاى الجمعة كل قدم منها كعمل عشرين سنة ، فإذا فرغ من صلاة الجمعة أجيز بعمل مائتي سنة ) ( ابن راهويه وابن زنجويه في ترغيبه ، قط في العلل وضعفه ، طس هب ) . )(@)(@@)(@@)(@@) $ ( 713 ) عن يحيى بن سعيد عن أبي بكر رضي الله عنه :(@)(@@) | 30 ( أنه كان يوتر أول الليل وكان إذا قام يصلي صلى ركعتين ركعتين ) ( ش ) . )(@)(@@)(@@)(@@) $ ( 714 ) عن أبي بكر رضي الله عنه قال :(@)(@@) | 30 ( حق على كل ذات نطاق الخروج إلاى العيدين ) ( ش ) . )(@)(@@)(@@)(@@) $ ( 715 ) عن إسماعيل بن أمية بن العاصي قال : ' كان أبو بكر الصديق رضي الله عنه يأخذ من الأعراب صدقة الفطر الأقط ' ( ش ) .(@)(@@)(@@)(@@) $ ( 716 ) عن وهب بن كيسان عن رجل :(@)(@@) | 30 ( أن أبا بكر وعمر رضي الله عنه كانا يصليان العيد قبل الخطبة ) ( مسدد ورواه مالك بلاغا ، ش ) . )(@)(@@)(@@)(@@) $ ( 717 ) عن أبي هريرة عن أبي بكر الصديق رضي الله عنه قال :(@)(@@) | 30 ( أمرني رسول الله أن لا يطوف بالبيت قرشي بعد هاذا العام عريانا ولا بعد هاذا العام مشرك ) ( رسته في الإيمان ) . )(@)(@@)(@@)(@@) $ ( 718 ) عن جرير قال :(@)(@@) | 30 ( لما قدم رسول الله المدينة قال لأصحابه : انطلقوا بنا إلاى أهل قباء نسلم عليهم ، فأتاهم فسلم عليهم ورحبوا به ، ثم قال : يا أهل قباء ائتوني بأحجار من هاذه الحرة فجمعت عنده أحجار كثيرة ومعه عنزة له فخط قبلتهم ، فأخذ حجرا فوضعه رسول الله ، ثم قال : يا عمر خذ حجرا فضعه إلاى جنب حجر أبي بكر ، ثم التفت فقال : يا عثمان خذ حجرا فضعه إلاى جنب حجر عمر ، ثم التفت إلاى الناس بآخره فقال : وضع رجل حجره حيث أحب من ذالك الخط ) ( طب ) . )(@)(@@)(@@)(@@) $ ( 719 ) عن زرعة بن عمرو مولاى الخباب قال :(@)(@@) | 30 ( لما قدم النبي المدينة قال PageV13P185 لأصحابه : إنطلقوا بنا إلاى أهل قباء نسلم عليهم ، فلما أتاهم سلم عليهم ، ثم قال : يا أهل قباء ائتوني بحجارة من هاذه الحرة ، فجمعت عنده ، فخط بها 
ms4124	 قبلتهم ثم أخذ حجرا فوضعه علاى الخط ، ثم قال : يا أبا بكر خذ حجرا فضعه إلاى جنب حجري ، ففعل ، ثم قال : يا عمر خذ حجرا فضعه إلاى جنب حجر أبي بكر ، ففعله ، ثم قال : يا عثمان خذ حجرا فضعه إلاى جنب حجر عمر ، ففعل ، ثم التفت إلاى الناس بآخره فقال : وضع رجل حجره حيث أحب علاى هاذا الخط وفي لفظ فقال : من أحب أن يضع فليضع حيث شاء علاى هاذا الخط ) ( الديلمي ، كر ) . )(@)(@@)(@@)(@@) $ ( 720 ) عن الزهري قال :(@)(@@) | 30 ( لم يبلغنا أن أحدا من ولاة هاذه الأمة الذين كانوا بالمدينة ، أبو بكر وعمر وعثمان رضي الله عنهم أنهم كانوا يثنون الصدقة ولاكن كانوا يبعثون عليها كل عام في الخصب والجدب لأن أخذها سنة من رسول الله ) ( ش ) . )(@)(@@)(@@)(@@) $ ( 721 ) عن ابن شهاب :(@)(@@) | 30 ( أن أبا بكر وعمر رضي الله عنهما لم يكونا يأخذان الصدقة مثناة ، ولاكن يبعثان عليها في الجدب والخصب والسمن والعجف ، لأن أخذها في كل عام من رسول الله سنة ) ( الشافعي ق ) . قال : رواه الشافعي في القديم وزاد فيه : ولا يضمنونها أهلها ولا يؤخرون أخذها عن كل عام . )(@)(@@)(@@)(@@) $ ( 722 ) عن ابن شهاب(@)(@@) | 30 أن عمر بن الخطاب قال لأبي بكر الصديق رضي الله عنه : ( أليس قد قال رسول الله : أمرت أن أقاتل الناس حتى يقولوا : لا إلاه إلا الله ، فإذا قالوها عصموا مني دماءهم وأموالهم إلا بحقها وحسابهم علاى الله ؟ قال أبو بكر رضي الله عنه : هاذا من حقها ، لا تفرقوا بين ما جمع الله ، والله لو منعوني عناقا مما أعطوا رسول الله لقاتلتهم عليه ) ( الشافعي ق ) . )(@)(@@)(@@)(@@) $ ( 723 ) عن أنس رضي الله عنه قال :(@)(@@) | 30 ( لما توفي رسول الله ارتدت العرب قال : فقال عمر بن الخطاب : يا أبا بكر أتريد أن تقاتل العرب ؟ فقال أبو بكر : إنما قال رسول الله : أمرت أن أقاتل الناس حتى يشهدوا أن لا إلاه إلا الله وأني رسول الله ويقيموا الصلاة ويؤتوا الزكاة ، والله لو منعوني عقالا مما كانوا يعطون PageV13P186 رسول الله لاقاتلنهم عليه ، قال 
ms4125	 عمر رضي الله عنه : ( فوالله ما هو إلا أن قد شرح الله صدر أبي بكر فعرفت أنه الحق ) ( ق ) . )(@)(@@)(@@)(@@) $ 724 عن عمر رضي الله عنه قال :(@)(@@) | 30 ( لما قبض رسول الله ارتد من ارتد من العرب وقالوا : نصلي ولا نزكي ، فأتيت أبا بكر فقلت : يا خليفة رسول الله تألف الناس وارفق بهم فإنهم بمنزلة الوحش ، فقال : رجوت نصرك وجئتني بخذلانك ، جبار في الجاهلية خوار في الإسلام ، ماذا عسيت أن أتألفهم بشعر مفتعل أو بسحر مفترى ، هيهات هيهات ، مضى النبي وانقطع الوحي والله لأجاهدنهم ما استمسك السيف في يدي وإن منعوني عقالا ، قال عمر رضي الله عنه : فوجدته في ذالك أمضى مني وأصرم مني ، وأدب الناس علاى أمور هانت علي كثير من مؤنتهم حين وليتهم ) ( الإسماعيلي ) . )(@)(@@)(@@)(@@) $ ( 725 ) عن عبيد الله بن عبد الله بن عتبة قال :(@)(@@) | 30 ( لما ارتد من ارتد علاى عهد أبي بكر رضي الله عنه أراد أبو بكر أن يجاهدهم ، فقال له عمر رضي الله عنه : ( أتقاتلهم وقد سمعت رسول الله يقول : من شهد أن لا إلاه إلا الله وأن محمدا رسول الله حرم ماله ودمه إلا بحقه وحسابه علاى الله ، فقال له أبو بكر رضي الله عنه : ألا أقاتل من فرق بين الصلاة والزكاة ، والله لأقاتلن من فرق بينهما حتى أجمعهما فقال عمر رضي الله عنه : فقاتلنا معه فكان والله رشدا فلما ظفر بمن ظفر به منهم قال : اختاروا بين خطتين : إما الحرب المجلية وإما الخطة المخزية ، قالوا : هاذه الحرب المجلية قد عرفناها ، فما الخطة المخزية ؟ قال : تشهدون علاى قتلانا أنهم في الجنة ، وعلاى قتلاكم أنهم في النار ففعلوا ) ( ش ) . )(@)(@@)(@@)(@@) $ ( 726 ) عن أنس رضي الله عنه :(@)(@@) | 30 ( أن أبا بكر رضي الله عنه كتب لهم : إن هاذه فرائض الصدقة التي فرض رسول الله علاى المسلمين التي أمر الله بها رسوله فمن سألها من المسلمين علاى وجهها فليعطها ومن سأل فوق ذالك فلا يعط فيما دون خمس وعشرين من الإبل في كل خمس ذود شاة فإذا بلغت خمسا 
ms4126	 وعشرين ففيها ابنة مخاض إلاى خمس وثلاثين ، فإن لم تكن له ابنة مخاض فابن لبون ذكر ، فإذا بلغت PageV13P187 ستة وثلاثين ففيها ابنة لبون إلاى خمس وأربعين فإذا بلغت ستة وأربعين ففيها حقة طروقة الفحل إلاى ستين ، فإذا بلغت إحدى وستين ففيها جذعة إلاى خمس وسبعين فإذا بلغت ستة وسبعين ففيها بنتا لبون إلاى تسعين ، فإذا بلغت إحدى وتسعين ففيها حقتان طروقتا الفحل إلاى عشرين ومائة ، فإذا زادت علاى عشرين ومائة ففي كل أربعين ابنة لبون وفي كل خمسين حقة ، فإذا تباين أسنان الإبل في فرائض الصدقات فمن بلغت عنده صدقة الجذعة وليست عنده جذعة وعنده حقة فإنها تقبل منه ويعطيه المتصدق عشرين درهما أو شاتين ، ومن بلغت عنده صدقة الحقة وليست عنده إلا جذعة فإنها تقبل منه ، ويعطيه المصدق عشرين درهما أو شاتين ، ومن بلغت عنده صدقة الحقة وليست عنده ، وعنده بنت لبون فإنها تقبل منه ويجعل معها شاتين إن استيسرتا له أو عشرين درهما ، ومن بلغت عنده صدقة ابنة لبون وليست عنده إلا حقة فإنها تقبل منه ويعطيه المصدق عشرين درهما أو شاتين ، ومن بلغت عنده صدقة بنت لبون وليست عنده ابنة لبون وعنده ابنة مخاض فإنها تقبل منه ويجعل معها شاتين إن استيسرتا له أو عشرين درهما ، ومن بلغت عنده صدقة ابنة مخاض وليس عنده إلا ابن لبون ذكر فإنه يقبل منه وليس معه شيء ، ومن لم يكن عنده إلا أربع من الإبل فليس فيها شيء إلا أن يشاء ربها ، وفي صدقة الغنم في سائمتها إذا كانت أربعين ففيها شاة إلاى عشرين ومائة فإذا زادت ففيها شاتان إلاى مائتين فإذا زادت واحدة ففيها ثلاث شياه إلاى ثلاث مائة ، فإذا زادت ففي كل مائة شاة ، ولا تؤخذ في الصدقة هرمة ولا ذات عوار ولا تيس إلا أن يشاء المصدق ، ولا يجمع بين متفرق ولا يفرق بين مجتمع خشية الصدقة ، وما كان من خليطين فإنهما يتراجعان بينهما بالسوية وإذا كانت سائمة الرجل ناقصة من أربعين شاة واحدة فليس فيها شيء 
ms4127	 إلا أن يشاء ربها وفي الرقة ربع العشر فإذا لم يكن المال إلا تسعين ومائة درهم فليس فيها شيء إلا أن يشاء ربها ) ( حم وأبو عبيد في كتاب الأموال ، خ د ن ه وابن جرير وابن الجارود وابن خزيمة والطحاوي حب قط ك هق ) . )(@)(@@)(@@)(@@) $ ( 727 ) عن أبي بكر الصديق رضي الله عنه :(@)(@@) | 30 ( أنه أعطى جابرا عدة كانت له عند رسول الله قال : وأزيدك أنه لا زكاة فيه حتى يحول عليه الحول ) ( ش وابن PageV13P188 راهويه هق وفي سنده ضعف ) . )(@)(@@)(@@)(@@) $ ( 728 ) عن القاسم بن محمد أن أبا بكر الصديق رضي الله عنه كان إذا أعطى عطاءه قال :(@)(@@) | 30 ( هل لك مال ؟ فإن قال نعم ، قال : أد زكاته ، فإن لم يكن له مال قال : لا تزكه ، يعني مال العطاء حتى يحول عليه الحول ) ( مالك ومسدد هق ) قال الحافظ ابن حجر : إسناده صحيح إلا أنه منقطع بين القاسم وجده الصديق ، ورواه أبو عبيدة في كتاب الأموال ، ش بلفظ : فإن قال نعم زكى ماله من عطائه وإلا سلم إليه عطاءه . )(@)(@@)(@@)(@@) $ ( 729 ) عن إبراهيم النخعي قال :(@)(@@) | 30 ( قال أبو بكر رضي الله عنه والله لو منعوني عقالا مما أخذ منهم النبي لقاتلتهم عليه ، وكان يأخذ مع البعير عقالا ، ثم قرأ { وما محمد إلا رسول قد خلت من قبله الرسل } ) ( ابن راهويه ) . قال الحافظ ابن حجر : هاذا مرسل . إسناده حسن وقد أخرجوا إسناده من طرق متصلة . )(@)(@@)(@@)(@@) $ ( 730 ) عن يحياى بن برهان(@)(@@) | 30 أن أبا بكر الصديق رضي الله عنه استشار عليا في أهل الردة فقال : ( إن الله جمع الصلاة والزكاة ولا أرى أن تفرق ، فعند ذالك قال أبو بكر : لو منعوني عقالا لقاتلتهم عليه كما قاتلهم عليه رسول الله ) ( مسدد ) . )(@)(@@)(@@)(@@) $ ( 731 ) عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( لما توفي رسول الله وكان أبو بكر رضي الله عنه بعده ، وكفر من كفر من العرب ، قال عمر : يا أبا بكر كيف تقاتل الناس وقد قال رسول الله : أمرت أن أقاتل الناس حتى يقولوا لا إلاه إلا 
ms4128	 الله ، فمن قال : لا إلاه إلا الله عصم مني ماله ونفسه إلا بحقه وحسابه علاى الله ، قال أبو بكر : والله لأقاتلن من فرق بين الصلاة والزكاة فإن الزكاة حق المال ، والله لو منعوني عقالا كانوا يؤدونه إلاى رسول الله لقاتلتهم عليه ، قال عمر : فوالله ما هو إلا أن رأيت أن الله قد شرح صدر أبي بكر للقتال فعرفت أنه الحق ) ( حم خ م د ت ن حب هق ، ورواه عب عن عبيد الله بن عبد الله بن عتبة مثله ) . )(@)(@@) PageV13P189(@)(@@)(@@)(@@) $ ( 732 ) عن أبي قلابة قال :(@)(@@) | 30 ( بعث أبو بكر رضي الله عنه المصدقين فأمرهم أن يبيعوا الجذعة بأربعين والحقة بثلاثين وابن لبون بعشرين وبنت مخاض بعشرة فانطلقوا فباعوا ما باعوا بقيمة أبي بكر ، ثم رجعوا حتى إذا كان العام المقبل بعثهم فقالوا : لو شئنا أن نزداد ازددنا ، فقال : زيدوا في كل سن عشرة فلما أن كان العام المقبل بعثهم فقالوا : لو شئنا أن نزداد ازددنا شيئا ، قال : لا ، فلما ولي عمر بعث عماله بقيمة أبي بكر الآخرة حتى إذا كان العام المقبل قال العمال : لو شئنا أن نزداد ازددنا ، فقال : زيدوا في كل سن عشرة حتى إذا كان العام المقبل بعثهم بالقيمة الآخرة فقالوا : لو شئنا أن نزداد شيئا ازددنا ، قال : لا ، حتى إذا ولي عثمان بعث بقيمة عمر الآخرة حتى إذا كان العام المقبل قالوا : لو شئنا أن نزداد ازددنا ، قال : زيدوا في كل سن عشرة ، حتى إذا كان العام المقبل قالوا : لو شئنا أن نزداد ازددنا ، قال : لا ، فلما ولي معاوية بعث بقيمة عثمان الآخرة ، فلما كان العام المقبل قالوا : لو شئنا أن نزداد ازددنا قال : زيدوا في كل سن عشرة ، حتى إذا كان العام المقبل قالوا : لو شئنا أن نزداد ازددنا قال : خذوا الفرائض بأسنانها ثم سموها وأعلنوها ، ثم جالسوهم البيع فما استطاعوا أن ينتقصوا وما استطعتم أن تزدادوا فازدادوا ) ( ش ) . )(@)(@@)(@@)(@@) $ ( 733 ) عن القاسم بن محمد قال :(@)(@@) | 30 ( لم يكن أبو بكر رضي الله عنه يأخذ من مال 
ms4129	 زكاة حتى يحول عليه الحول ) ( مالك والشافعي ق ) وقال الشافعي : أخبرني هشام بن يوسف أن أهل حفاش أخرجوا كتابا من أبي بكر الصديق في قطعة أديم إليهم يأمرهم بأن يؤدوا عشر الورس ( ق ) . )(@)(@@)(@@)(@@) $ ( 734 ) عن عمرو بن شعيب قال :(@)(@@) | 30 ( قضى أبو بكر رضي الله عنه علاى أهل القرى حين كثر المال وغلت الإبل أقام مائة من الإبل بستمائة دينار إلاى ثمان مائة دينار ) ( الشافعي ق ) . )(@)(@@)(@@)(@@) $ ( 735 ) عن عكرمة بن خالد عن رجل حدثه عن مصدق أبي بكر رضي الله عنه الذي بعثه إلاى اليمن :(@)(@@) | 30 ( أنه أخذ من كل عشر بقرات شاة ) ( مسدد ) . )(@)(@@)(@@)(@@) $ ( 736 ) عن أبي بكر الصديق رضي الله عنه أن بريرة أهدت لهم لحما فأمرهم PageV13P190 النبي & أن يطبخوا منه ، فقالوا : يا نبي الله إنما تصدق به عليها فقال : ' الهدية لنا والصدقة عليها ' ( أبو بكر ، الشافعي وابن النجار ) .(@)(@@)(@@)(@@) $ ( 737 ) عن عبد الرحمان بن السلماني(@)(@@) | 30 أن أبا بكر رضي الله عنه قال فيما أوصى به عمر : ( من أدى الزكاة إلاى غير أهلها لم تقبل زكاته بالدنيا جميعا ، ومن صام شهر رمضان في غيره لم يقبل منه صومه ولو صام الدهر أجمع ) ( عب ، ش وابن السلماني ضعيف ولم يدرك أبا بكر ) . )(@)(@@)(@@)(@@) $ ( 738 ) عن الحسن أنه سأله رجل :(@)(@@) | 30 أتشرب من ماء هاذه السقاية في المسجد فإنها صدقة ، قال الحسن رضي الله عنه : ( قد شرب أبو بكر وعمر من سقاية أم سعد فمه ) ( ابن سعد ) . )(@)(@@)(@@)(@@) $ ( 739 ) عن سالم بن عبيد قال :(@)(@@) | 30 كان أبو بكر الصديق رضي الله عنه يقول لي : ( قم بيني وبين الفجر حتى أتسحر ) ( ش قط وصححه ) . )(@)(@@)(@@)(@@) $ ( 740 ) عن عون بن عبد الله قال :(@)(@@) | 30 ( دخل رجلان علاى أبي بكر رضي الله عنه وهو يتسحر فقال أحدهما : قد طلع الفجر ، وقال الآخر : لم يطلع بعد ، فقال أبو بكر : كل قد اختلفا ) ) ( ش ) . )(@)(@@)(@@)(@@) $ ( 741 ) عن أبي قلابة ،(@)(@@) | 30 أنبأني رجل أنه أدى إلاى أبي بكر الصديق رضي الله عنه نصف صاع من بر في زكاة الفطر ) ( عب ش 
ms4130	 ق قط ) . )(@)(@@)(@@)(@@) $ ( 742 ) عن أبي بكر رضي الله عنه قال :(@)(@@) | 30 ( سئل رسول الله : أي الحج أفضل ؟ قال : العج والثج ( الدارمي ت وقال : غريب وابن خزيمة قط في العلل طس ك هق ص ) . )(@)(@@)(@@)(@@) $ ( 743 ) عن الأسود بن يزيد قال :(@)(@@) | 30 ( حججت مع أبي بكر فجرد ، ومع عمر فجرد ، ومع عثمان فجرد ) ( ش قط والمحاملي ن في أماليه ) . )(@)(@@)(@@)(@@) $ ( 744 ) عن إبراهيم قال :(@)(@@) | 30 ( أفرد الحج أبو بكر وعمر وعثمان ) ( ش ) . )(@)(@@) PageV13P191(@)(@@)(@@)(@@) $ ( 745 ) عن ابن عباس رضي الله عنه قال :(@)(@@) | 30 ( تمتع رسول الله وأبو بكر وعمر وعثمان وأول من نهى عنه معاوية ) ( ش ) . )(@)(@@)(@@)(@@) $ ( 746 ) عن عيسى بن طلحة(@)(@@) | 30 عن رجل رأى النبي وقف عند الحجر فقال : ( إني لأعلم أنك حجر لا تضر ولا تنفع ثم قبله ، ثم حج أبو بكر فوقف عند الحجر ثم قال : إني لأعلم أنك حجر لا تضر ولا تنفع ولولا أني رأيت رسول الله يقبلك ما قبلتك ) ( ش قط في العلل ) . )(@)(@@)(@@)(@@) $ ( 747 ) عن محمد بن المنكدر قال :(@)(@@) | 30 ( أخبرني من رأى أبا بكر الصديق رضي الله عنه واقفا علاى قزح ) ( الأزرقي ) . )(@)(@@)(@@)(@@) $ ( 748 ) عن جبير بن الحارث قال :(@)(@@) | 30 ( رأيت أبا بكر رضي الله عنه واقفا علاى قزح وهو يقول : أيها الناس ، أصبحوا أيها الناس ، أيها الناس أصبحوا ، ثم دفع فإني لأنظر إلاى فخذه وقد انكشفت مما يحرش بعيره بمحجنه ) ( ش وابن سعد وابن جرير هق ) . )(@)(@@)(@@)(@@) $ ( 749 ) عن أسماء بنت عبد الرحمان بن أبي بكر عن أبيها عن أبي بكر الصديق رضي الله عنهم :(@)(@@) | 30 ( أن رسول الله لما غربت الشمس بعرفة أفاض من مزدلفة قبل طلوع الشمس ) ( طس ) وسنده ضعيف . )(@)(@@)(@@)(@@) $ ( 750 ) عن أبي سريحة حذيفة بن أسيد الغفاري قال :(@)(@@) | 30 ( لقد رأيت أبا بكر الصديق وعمر ما يضحيان عن أهلهما خشية أن يستن بهما ) ( ابن أبي الدنيا في الأضاحي والحاكم في الكني وأبو بكر عبد الله بن محمد زياد النيسابوري في الزيادات ق ) وقال ابن كثير : إسناده صحيح . )(@)(@@)(@@)(@@) $ ( 751 ) عن الشعبي :(@)(@@) | 30 ( أن أبا بكر وعمر رضي 
ms4131	 الله عنهما شهدا الموسم فلم يضحيا ) ( مسدد ) . )(@)(@@)(@@)(@@) $ ( 752 ) عن أبي بكر الصديق رضي الله عنه :(@)(@@) | 30 ( أن النبي أهدى جملا لأبي جهل ) ( قط في العلل والاسماعيلي في معجمه قط خط في رواة مالك ) . )(@)(@@) PageV13P192(@)(@@)(@@)(@@) $ ( 753 ) عن ميمون بن مهران(@)(@@) | 30 أن أعرابيا أتى أبا بكر رضي الله عنه فقال : ( قتلت صيدا وأنا محرم ، فما ترى علي من الجزاء ؟ فقال أبو بكر لابي بن كعب وهو جالس عنده : ما ترى فيها ؟ فقال الأعرابي : أتيتك وأنت خليفة رسول الله أسألك ، فإذا أنت تسأل غيرك ، فقال أبو بكر : وما تنكر ؟ يقول الله : { يحكم به ذوا عدل منكم } ، فشاورت صاحبي حتى إذا اتفقنا علاى أمر أمرناك به ) ( عبد بن حميد وابن أبي حاتم ) . )(@)(@@)(@@)(@@) $ ( 754 ) عن عمير بن سلمة الضمري قال :(@)(@@) | 30 ( خرجنا مع رسول الله حتى إذا كنا بالروحاء فإذا بحمار في بعض أحياء الروحاء فيه سهم قد عقر فقال رسول الله : دعوه فإنه يوشك أن يأتي صاحبه ، فأتى رجل من بهز فقال : يا رسول الله هاذا حمار عقرته وهاذا سهمي فيه فشأنكم وشأنه فأمر رسول الله أبا بكر فقسمه علاى القوم وهم حرم ، ثم مضيا حتى إذا كنا بالأثاية إذا نحن بظبي حاقف علاى جبل فيه سهم فنظر إليه الناس فأمر رسول الله رجلا فقال : قف هاهنا حتى يمر الرفاق لا يريبه أحد بشيء فجعل يذب الناس عنه حتى نفدوا ) ( ابن جرير ) . )(@)(@@)(@@)(@@) $ ( 755 ) عن القاسم بن محمد عن أبيه عن جده أبي بكر رضي الله عنه(@)(@@) | 30 ( أنه خرج حاجا مع رسول الله ومعه أسماء بنت عميس فولدت بالشجرة محمد بن أبي بكر ، فأتى أبو بكر النبي فأخبره ، فأمره أن تغتسل ، ثم تهل بالحج وتصنع ما يصنع الناس إلا أنها لا تطوف بالبيت ) ( ن ه وابن خزيمة والبزار ) قال ابن المديني هاذا منقطع فإن محمدا مات أبوه أبو بكر وهو ابن ثلاث سنين والقاسم لم يدرك أباه أيضا . )(@)(@@)(@@)(@@) $ ( 756 ) عن سعيد بن المسيب عن أسماء بنت عميس :(@)(@@) | 30 ( أنها نفست بمحمد بن أبي بكر 
ms4132	 في ذي الحليفة فسأل أبو بكر رضي الله عنه رسول الله فأمره أن تغتسل وتهل ) ( طب ) قال ابن كثير : إسناده جيد . )(@)(@@) PageV13P193(@)(@@)(@@)(@@) $ 757 عن عائشة رضي الله عنها :(@)(@@) | 30 ( أن أسماء بنت عميس نفست بذي الحليفة فأمر رسول الله أبا بكر أن يأمرها أن تغتسل وتهل ) ( أبو نعيم في المعرفة ) . )(@)(@@)(@@)(@@) $ ( 758 ) عن عبد الرحمان بن القاسم عن أبيه(@)(@@) | 30 أن أسماء بنت عميس ولدت محمد بن أبي بكر بالبيداء ، فذكر ذالك أبو بكر رضي الله عنه لرسول الله فقال : ( مرها فلتغتسل ثم تهل ) ( ن طب ) قال ابن كثير هاذا منقطع إلا أنه في حكم الموصول فإن القاسم إنما أخذه عن عائشة وغيرها من أهلهم فلما تحقق القصة أسقط الواسطة وكثيرا معا يورد في صحيحه من هاذا النمط انتهى . )(@)(@@)(@@)(@@) $ ( 759 ) عن عروة عن أبي بكر وعمر رضي الله عنه قال :(@)(@@) | 30 ( لا يحل الحاج حتى يوم النحر ) ( الطحاوي ) . )(@)(@@)(@@)(@@) $ ( 760 ) عن عروة :(@)(@@) | 30 ( أن أبا بكر وعمر رضي الله عنهما كانا يقدمان وهما مهلان بالحج فلا يحل منهما حرام إلاى يوم النحر ) ( ش ) . )(@)(@@)(@@)(@@) $ ( 761 ) عن ابن عمر رضي الله عنه :(@)(@@) | 30 ( أن رسول الله بعث أبا بكر رضي الله عنه فأقام للناس حجهم ، ثم حج رسول الله ، من العام المقبل حجة الوداع ، ثم قبض رسول الله ، واستخلف أبو بكر ، فبعث أبو بكر عمر بن الخطاب فحج بالناس ، ثم حج أبو بكر من العام المقبل ، ثم استخلف عمر بن الخطاب فبعث عبد الرحمان بن عوف ، ثم حج عمر إمارته كلها ) ( كر ) . )(@)(@@)(@@)(@@) $ ( 762 ) عن أبي بكر الصديق رضي الله عنه قال :(@)(@@) | 30 ( ابتغوا الغنى في النكاح ) ( وكيع الصغير في الغرر ) . )(@)(@@)(@@)(@@) $ ( 763 ) عن أبي بكر الصديق رضي الله عنه قال :(@)(@@) | 30 ( أطيعوا الله فيما أمركم به من النكاح ينجز لكم ما وعدكم من الغنى ، قال تعالاى : { إن يكونوا فقراء يغنهم الله من فضله } ( ابن أبي حاتم ) . )(@)(@@) PageV13P194(@)(@@)(@@)(@@) $ ( 764 ) عن سعيد بن المسيب :(@)(@@) | 30 ( أن أبا بكر وعمر رضي الله عنه كانا يكرهان العزل ، ويأمران الناس بالغسل منه 
ms4133	 ) ( ش ) . )(@)(@@)(@@)(@@) $ ( 765 ) عن قيس بن أبي حازم :(@)(@@) | 30 ( جاء رجل إلاى أبي بكر الصديق رضي الله عنه فقال : إن أبي يريد أن يأخذ مالي كله لحاجة فقال لأبيه : إنما لك من ماله ما يكفيك ، فقال : يا خليفة رسول الله أليس قال رسول الله : أنت ومالك لأبيك ؟ فقال : نعم ، وإنما يعني بذالك النفقة ، ارض بما رضي الله عز وجل ) ( طس ، ق ) . )(@)(@@)(@@)(@@) $ ( 766 ) عن البراء قال :(@)(@@) | 30 ( دخلت مع أبي بكر رضي الله عنه أول ما تقدم المدينة ، فإذا عائشة ابنته مضطجعة قد أصابتها حمى ، وأتاها أبو بكر فقال : كيف أنت يا بنية وقبل خدها ) ( خ ، د ، ق ) . )(@)(@@)(@@)(@@) $ ( 767 ) عن مجاهد :(@)(@@) | 30 ( أن أبا بكر رضي الله عنه قبل رأس عائشة ) ( ش ) . )(@)(@@)(@@)(@@) $ ( 768 ) عن أبي بكر رضي الله عنه قال :(@)(@@) | 30 ( أهلكهن الأحمران : الذهب والزعفران ) ( مسدد ، عب ، ص ) . )(@)(@@)(@@)(@@) $ ( 769 ) عن خالد بن معدان أن أبا بكر رضي الله طعنه قال :(@)(@@) | 30 ( إن الله تعالاى تصدق عليكم بثلث أموالكم عند وفاتكم ) ( مسدد ) . )(@)(@@)(@@)(@@) $ ( 770 ) عن عروة قال :(@)(@@) | 30 قال أبو بكر رضي الله عنه : ( لأن أوصي بالخمس أحب إلي من أن أوصي بالربع ، ولأن أوصي بالربع أحب إلي من أن أوصي بالثلث ، ومن أوصى بالثلث فلم يترك شيئا ) ( ابن سعد ) . )(@)(@@)(@@)(@@) $ ( 771 ) عن سعد بن أبي وقاص رضي الله عنه قال :(@)(@@) | 30 ( سألني أبو بكر وعمر رضي الله عنهم عن قول رسول الله في الوصية فخيرتهما ، فحملا الناس عليه في الوصية ) ( أبو الشيخ في الفرائض ، ض ) . )(@)(@@)(@@)(@@) $ ( 772 ) عن هشيم حدثنا جويبر عن الضحاك :(@)(@@) | 30 ( أن أبا بكر وعليا رضي الله عنهما أوصيا بالخمس من أموالهم لمن لا يرث من ذوي قرابتهما ) . )(@)(@@) PageV13P195(@)(@@)(@@)(@@) $ ( 773 ) عن مكحول :(@)(@@) | 30 ( أن أبا بكر وعمر وعليا وابن مسعود وأبا الدرداء وعبادة بن الصامت وعبد الله بن قيس الأشعري رضي الله عنهم كانوا يقولون في الرجل يقولون في الرجل يطلق امرأة تطليقة أو تطليقتين ، إنه أحق بها ما لم تغتسل من حيضتها الثالثة يرثها وترثه ما دامت في العدة ) ( ش ) . )(@)(@@)(@@)(@@) $ ( 774 ) عن 
ms4134	 ابن عباس رضي الله عنه في قصة بريرة أن أبا بكر رضي الله عنه حدثه(@)(@@) | 30 ( أن رسول الله جعل عليها عدة الحرة ) ( هق ) . )(@)(@@)(@@)(@@) $ ( 775 ) عن سالم بن عبد الله قال : $ 30 ( كانت عاتكة بنت زيد تحت عبد الله بن أبي بكر قد غلبته علاى رأيه وشغلته عن سوقه ، فأمره أبو بكر رضي الله عنه بطلاقها واحدة ، ففعل فوجد عليها ، فقعد لاءبيه علاى طريقه وهو يريد الصلاة ، فلما أبصر به شكى وأنشد يقول :(@)(@@) فلم أر مثلي طلق اليوم مثلها %~% ولا مثلها في غير جرم تطلق(@)(@@) فرق له وأمره بمراجعتها ) ( الخرائطي في اعتلال القلوب ورواه وكيع في الغرر عن أبي سلمة بن عبد الرحمان بن عوف رضي الله عنه رضي الله عنه وفيه قال : أي بني أتحبها ؟ قال : نعم ، قال : راجعها ) ( د ، ن ، ه ، ع ، حب ، ك ، ق ) . ) $(@)(@@)(@@)(@@) $ ( 776 ) عن ثابت قال : $ 30 ( كان أبو بكر الصديق رضي الله عنه يكثر أن يتمثل بهذا البيت :(@)(@@) لا تزال تنعى حبيبا حتى تكونه %~% وقد يرجو الفتى الرجا يموت دونه(@)(@@) ( ابن سعد ، ش ، حم في الزهد ، وابن الدنيا في ذكر الموت ) . ) $(@)(@@)(@@)(@@) $ ( 777 ) عن سعيد بن المسيب عن أبي بكر رضي الله عنه قال :(@)(@@) | 30 ( أحق من صلينا عليه أطفالنا ) ( ش ) . )(@)(@@)(@@)(@@) $ ( 778 ) عن صالح مولاى التوأمة عمن أدرك أبا بكر وعمر رضي الله عنهما(@)(@@) | 30 ( أنهم كانوا إذا تضايق بهم المصلى انصرفوا ، ولم يصلوا علاى الجنازة في المسجد ) ( ش ) . )(@)(@@) PageV13P196(@)(@@)(@@)(@@) $ ( 779 ) عن إبراهيم قال :(@)(@@) | 30 ( صلى أبو بكر الصديق رضي الله عنه علاى فاطمة بنت رسول الله فكبر عليها أربعا ) ( ابن سعد ) . )(@)(@@)(@@)(@@) $ ( 780 ) عن عبد الرحمان بن أبزي :(@)(@@) | 30 ( أن أبا بكر وعمر كانا يمشيان أمام الجنازة وكان علي رضي الله عنه يمشي خلفها ، قيل لعلي إنهما يمشيان أمامها فقال : إنهما يعلمان أن المشي خلفها أفضل من المشي أمامها كفضل صلاة الرجل في جماعة علاى صلاته وحده ولاكنهما يسهلان للناس ) ( هق ) . )(@)(@@)(@@)(@@) $ ( 781 ) عن عائشة رضي الله عنها(@)(@@) | 30 أن عبد الله بن أبي بكر لما توفي 
ms4135	 بكى عليه ، فخرج أبو بكر إلاى الرجال فقال : ( إني أعتذر إليكم من شأن أولاء ، إنهن حديثات عهد بجاهلية ، سمعت رسول الله يقول : إن الميت ينضح عليه الحميم ببكاء الحي ) ( ع ، وسنده ضعيف ) . )(@)(@@)(@@)(@@) $ ( 782 ) عن سعيد بن المسيب قال :(@)(@@) | 30 ( لما توفي أبو بكر رضي الله عنه أقامت عائشة عليه النوح فبلغ عمر فنهاها عن النوح علاى أبي بكر ، فأبين أن ينتهين ، فقال لهشام بن الوليد : أخرج إلاى ابنة أبي قحافة فعلاها بالدرة ضربات ، فتفرق النوائح حين سمعن ذالك ، فقال : تردن أن يعذب أبو بكر ببكائكن إن رسول الله قال : إن الميت يعذب ببكاء أهله عليه ) ( ابن سعد ) . )(@)(@@)(@@)(@@) $ ( 783 ) عن عائشة رضي الله عنها قالت :(@)(@@) | 30 ( توفي أبو بكر بين المغرب والعشاء فأصبحنا ، فاجتمع نساء المهاجرين والأنصار وأقاموا النوح ، وأبو بكر يغسل ويكفن ، فأمر عمر بن الخطاب بالنوح ففرقن ، فوالله علاى ذلك إنكن تفرقن وتجتمعن ) ( ابن سعد ) . )(@)(@@)(@@)(@@) $ ( 784 ) عن سعيد بن المسيب قال :(@)(@@) | 30 ( لما مات أبو بكر رضي الله عنه بكي عليه ، فقال عمر : إن رسول الله قال : إن الميت يعذب ببكاء الحي ، فأبوا إلا أن يبكوا ، فقال عمر لهشام بن الوليد : قم فأخرج النساء فقالت عائشة : PageV13P197 أخرجك ، فقال عمر : أدخل فقد أذنت لك فدخل ، فقالت عائشة : أمخرجي أنت يا بني فقال : أما لك ، فقد أذنت لك ، فجعل يخرجهن امرأة امرأة وهو يضربهن بالدرة حتى خرجت أم فروة وفرق بينهن ) ( ابن راهويه ولو صحيح ) . )(@)(@@)(@@)(@@) $ ( 785 ) عن إسماعيل بن خالد(@)(@@) | 30 أن أبا بكر الصديق رضي الله عنه كان يقول إذا أدخل الميت اللحد : ( بسم الله وعلاى ملة رسول الله ، وباليقين بالبعث بعد الموت ) ( عب ) . )(@)(@@)(@@)(@@) $ ( 786 ) عن أبي بكر الصديق رضي الله عنه قال :(@)(@@) | 30 ( قال موسى عليه السلام : يا رب ما لمن عزى الثكلى ؟ قال : أظله بظلي يوم لا ظل إلا ظلي ) ( ابن شاهين في الترغيب ) . )(@)(@@)(@@)(@@) $ ( 787 ) عن أبي عيينة قال :(@)(@@) | 30 ( كان أبو بكر الصديق رضي الله عنه إذا عزى رجلا قال : ليس مع العزاء مصيبة ، وليس مع الجزع 
ms4136	 فائدة ، الموت أهون ما قبله وأشد ما بعده ، اذكروا فقد رسول الله تصغر مصيبتكم ، وأعظم الله أجركم ) ( ابن أبي خيثمة والدينوري في المجالسة ، كر ) . )(@)(@@)(@@)(@@) $ ( 788 ) عن عائشة رضي الله عنها عن عمرو بن شرحبيل قال :(@)(@@) | 30 ( لما أصيب سعد بن معاذ رضي الله عنه بالرمية يوم الخندق جعل دمه يسيل علاى النبي : فجاء أبو بكر فجعل يقول : واانقطاع ظهره ، فقال النبي : مه يا أبا بكر فجاء عمر فقال : إنا لله وإنا إليه راجعون ) ( ش ) . )(@)(@@)(@@)(@@) $ ( 789 ) عن عائشة رضي الله عنها قالت :(@)(@@) | 30 ( فتح رسول الله بابا بينه وبين الناس ، أو كشف سترا ، فرأى أبا بكر والناس يصلون خلفه ، فحمد الله علاى ما رأى من حسن حالهم رجاء أن يخلفه فيهم بالذي رأى فيهم ، فقال : أيها الناس أيما أحد من أمتي أصيب بمصيبة من بعدي فليتعز بمصيبتي عن المصيبة التي تصيبه من بعدي ، فإن أحدا من أمتي لم يصب كمصيبته بي ) ( ع كر ) . )(@)(@@)(@@)(@@) $ ( 790 ) عن عائشة رضي الله عنها :(@)(@@) | 30 ( أن أبا بكر رضي الله عنه قبل النبي بعد موته ) ( ش ، خ ، ت في الشمائل ، ن ، ه ، والمروزي في الجنائز ) . )(@)(@@) PageV13P198(@)(@@)(@@)(@@) $ ( 791 ) عن أبي بكر رضي الله عنه قال :(@)(@@) | 30 ( طوبى لمن مات في النأنأة ) ( ابن المبارك ، وأبو عبيد في الغريب ، حل ) . )(@)(@@)(@@)(@@) $ ( 792 ) عن الضحاك عن أبي بكر وعمر رضي الله عنهم قالا :(@)(@@) | 30 ( أيما رجل قال لامرأته : أنت علي حرام ، فليست عليه حرام وعليه كفارة ) ( هناد بن السري في حديثه ) . )(@)(@@)(@@)(@@) $ ( 793 ) عن الحسن قال :(@)(@@) | 30 ( قال أبو بكر الصديق رضي الله عنه كنا نقرأ : لا ترغبوا عن آبائكم فإنه كفر بكم ) ( رسته في الإيمان ) . )(@)(@@)(@@)(@@) $ ( 794 ) عن القاسم بن عبد الرحمن قال :(@)(@@) | 30 ( جاء رجل إلاى أبي بكر الصديق رضي الله عنه بابن له فقال : يا أبا بكر هاذا ابني وهو ينتفي مني ، فقال أبو بكر : ابنك ولد علاى فراشك ؟ قال نعم ، فقام إليه أبو بكر فجعل يضرب رأسه بالدرة ويقول : إن الشيطان في الرأس ، إن الشيطان في الرأس ، إن الشيطان في 
ms4137	 الرأس ، ثم قال أبو بكر رضي الله عنه : كفر بالله ادعاء نسب لا يعلم ، أو تبرؤ من نسب وإن دق ) ( رسته ) . )(@)(@@)(@@)(@@) $ ( 795 ) عن القاسم :(@)(@@) | 30 ( أن أبا بكر أتي برجل انتفى من أبيه فقال أبو بكر رضي الله عنه : أضرب الرأس فإن الشيطان في الرأس ) ( ش ) . )(@)(@@)(@@)(@@) $ ( 796 ) عن مسروق قال :(@)(@@) | 30 ( قال أبو بكر الصديق رضي الله عنه : كفر بالله تبرؤ من نسب وإن دق ، وكفر بالله ادعاء نسب لا يعلم ) ( ابن سعد وهناد ) . )(@)(@@)(@@)(@@) $ ( 797 ) عن قتادة قال :(@)(@@) | 30 ( ذكر لنا أن أبا بكر الصديق رضي الله عنه قال في خطبته : ألا إن الآية التي أنزلت في أول سورة النساء في شأن الفرائض أنزلها الله في الولد والوالد ، والآية الثانية أنزلها في الزوج والزوجة والإخوة من الأم ، والآية التي ختم بها سورة النساء أنزلها في الإخوة والأخوات من الأب والأم ، والآية التي ختم بها سورة الأنفال أنزلها في أولي الأرحام بعضهم أولا ببعض في كتاب الله مما PageV13P199 جرت به الرحم من العصبة ) ( عبد بن حميد وابن جرير في التفسير ، هق ) . )(@)(@@)(@@)(@@) $ ( 798 ) عن القاسم بن محمد قال :(@)(@@) | 30 ( جاءت جدات إلاى أبي بكر رضي الله عنه فأعطى الميراث أم الأم دون أم الأب فقال له رجل من الأنصار من بني حارثة يقال له عبد الرحمان بن سهل : يا خليفة رسول الله ؟ قد أعطيت الميراث التي لو أنها ماتت لم يرثها ، فجعل أبو بكر الميراث بينهما يعني السدس ) ( مالك ، عب ، ص ، قط ، هق ) . )(@)(@@)(@@)(@@) $ ( 799 ) عن خارجة بن زيد :(@)(@@) | 30 ( أن أبا بكر قضى في أهل اليمامة مثل قول زيد بن ثابت ، ورث الأحياء من الأموات ولم يورث الأموات بعضهم من بعض ) ( عب ) . )(@)(@@)(@@)(@@) $ ( 800 ) عن زيد بن ثابت رضي الله عنه قال :(@)(@@) | 30 ( أمرني أبو بكر رضي الله عنه حيث قتل أهل اليمامة أن يورث الأحياء من الأموات ولا يورث بعضهم من بعض ) ( هق ) . )(@)(@@)(@@)(@@) $ ( 801 ) عن ابن سيرين :(@)(@@) | 30 ( أن سعد بن عبادة رضي الله عنه قسم ماله بين بنيه في حياته فولد 
ms4138	 له ولد بعد ما مات ، فلقي عمر أبا بكر فقال : ما نمت الليلة من أجل ابن سعد ، هاذا المولود ولم يترك له شيئا ، فقال أبو بكر : وأنا والله ما نمت الليلة من أجل ابن سعد ، فانطلق بنا إلاى قيس بن سعد نكلمه في أخيه فأتياه فكلماه ، فقال قيس : أما شيء أمضاه سعد فلا أرده أبدا ولاكن أشهدكما أن نصيبي له ) ( عب ) . )(@)(@@)(@@)(@@) $ ( 802 ) عن أبي صالح قال :(@)(@@) | 30 ( قسم سعد بن عبادة رضي الله عنه ماله بين ولده وخرج إلاى الشام فمات وولد له ولد بعد فجاء أبو بكر وعمر إلاى قيس بن سعد فقالا : إن سعدا مات ولم يعلم ما هو كائن وإنا نرى أن ترد علاى هاذا الغلام نصيبه : قال قيس : لست بمغير شيئا فعله أبي ولاكن نصيبي له ) ( ص ، كر ، وروى ، كر عن عطاء مثله ) . )(@)(@@)(@@)(@@) $ ( 803 ) عن قبيصة بن ذؤيب قال :(@)(@@) | 30 ( جاءت الجدة إلاى أبي بكر رضي الله عنه تطلب ميراثها من ابن ابنها أو ابن ابنتها ، فقال أبو بكر : ما أجد لك في كتاب الله PageV13P200 شيئا ولا سمعت من رسول الله يقضي لك بشيء وسأسأل الناس العشية فلما صلى الظهر أقبل علاى الناس فقال : إن الجدة أتتني تسألني ميراثها من ابن ابنها أو ابن بنتها ، وإني لم أجد لها في كتاب الله شيئا ولم أسمع النبي يقضي لها بشيء ، فهل سمع أحد منكم من رسول الله فيها شيئا ؟ فقام المغيرة بن شعبة فقال : شهدت رسول الله يقضي لها السدس ، فقال : من معك ؟ فشهد محمد بن مسلمة ، فأعطاها أبو بكر السدس ، فلما جاءت خلافة عمر رضي الله عنه جاءته الجدة التي تخالفها فقال عمر : إنما كان القضاء في غيرك ولاكن إذا اجتمعتما فالسدس بينكما وأيتكما خلت به فهو لها ) ( مالك ، عب ، ص ) . )(@)(@@)(@@)(@@) $ ( 804 ) عن ابن الزبير :(@)(@@) | 30 ( أن أبا بكر رضي الله عنه كان يجعل الجد أبا ) ( عب ، ش ، ص ، خ والدارمي ، قط ، هق ) . )(@)(@@)(@@)(@@) $ 805 عن الشعبي قال :(@)(@@) | 30 ( كان من رأي أبي بكر وعمر رضي الله 
ms4139	 عنهما أن يجعلا الجد أولاى من الأخ ، وكان عمر يكره الكلام فيه ، فلما صار عمر جدا قال : هاذا أمر قد وقع لا بد للناس من معرفته فأرسل إلاى زيد بن ثابت فسأله فقال : كان من رأيي ورأي أبي بكر رضي الله عنه أن نجعل الجد أولاى من الأخ ، فقال : يا أمير المؤمنين لا تجعل شجرة تنبت فانشعب منها غصن فانشعب في الغصن غصنان فما يجعل الغصن الأول أولاى من الغصن الثاني وقد خرج الغصن من الغصن ، فأرسل إلاى علي رضي الله عنه فسأله فقال له كما قال زيد إلا أنه جعله سيلا سال فانشعب منه شعب ثم انشعب منه شعبتان فقال : أرأيت لو أن هاذه الشعبة الوسطى رجع أليس إلاى الشعبتين جميعا فقام عمر فخطب الناس فقال : هل منكم من أحد سمع رسول الله يذكر الجد في فريضة ؟ فقام رجل فقال : سمعت رسول الله ذكرت له فريضة فيها ذكر الجد فأعطاه الثلث فقال : من كان معه من الورثة ؟ قال : لا أدري ، قال : لا دريت ، ثم خطب الناس فقال : هل أحد منكم سمع النبي ذكر الجد في فريضة ؟ فقام رجل فقال : سمعت رسول الله ذكرت له فريضة فيها ذكر الجد فأعطاه رسول الله السدس ، قال : من كان معه من الورثة ؟ قال : لا PageV13P201 أدري ، قال : لا دريت . قال الشعبي : وكان زيد بن ثابت يجعله أخا حتى يبلغ ثلاثة هو ثالثهم ، فإذا زادوا علاى ذالك أعطاه الثلث ، وكان علي بن أبي طالب يجعله أخا حتى إذا بلغوا ستة هو سادسهم ، فإذا زادوا علاى ذالك أعطاه السدس ) ( عب ، هق ) . )(@)(@@)(@@)(@@) $ ( 806 ) عن عطاء قال :(@)(@@) | 30 ( كان أبو بكر رضي الله عنه يقول : الجد أب ما لم يكن دونه أب ، كما أن ابن الابن ابن ما لم يكن دونه ابن ) ( هق ) . )(@)(@@)(@@)(@@) $ ( 807 ) عن إسماعيل بن سميع قال :(@)(@@) | 30 ( جاء رجل لأبي وائل أن أبا بردة يزعم أن أبا بكر رضي الله عنه جعل الجد أبا ، فقال : كذب لو جعله أبا لما خالفه عمر ) ( ش ) . )(@)(@@)(@@)(@@) $ ( 808 ) عن 
ms4140	 إبراهيم قال :(@)(@@) | 30 ( لم يكن أبو بكر وعمر وعثمان يورثون الحميل ) ( الدارمي ) . )(@)(@@)(@@)(@@) $ ( 809 ) عن عبيد بن عبد الرحمان عن أبيه قال :(@)(@@) | 30 ( دخلت علاى أبي بكر رضي الله عنه فقال : وددت أني سألت رسول الله عن ميراث العمة والخالة ) ( ك ) . )(@)(@@)(@@)(@@) $ ( 810 ) عن أبي بكر رضي الله عنه قال :(@)(@@) | 30 ( من مات وليس له ولد ولا والد فورثته كلالة فضج منه علي رضي الله عنه ثم رجع إلاى قوله ) ( عبد بن حميد ) . )(@)(@@)(@@)(@@) $ ( 811 ) عن سعيد بن جبير قال :(@)(@@) | 30 ( كان الرجل يعاقد الرجل فيرث كل واحد منهما صاحبه ، وكان أبو بكر رضي الله عنه عاقد رجلا فورثه ) ( ص ) . )(@)(@@)(@@)(@@) $ ( 812 ) عن عكرمة قال :(@)(@@) | 30 ( خاصمت امرأة عمر إلاى أبي بكر وكان طلقها فقال أبو بكر رضي الله عنه : هي أعطف وألطف وأرحم وأحن وأرأف ، وهي أحق بولدها ما لم تتزوج أو يكبر فيختار لنفسه ) ( عب ) . )(@)(@@)(@@)(@@) $ ( 813 ) عن ابن عباس رضي الله عنه قال :(@)(@@) | 30 ( طلق عمر بن الخطاب امرأته الأنصارية أم ابنه عاصم فلقيها تحمله وقد فطم ومشى ، فأخذ بيده لينزعه منها ، وقال : أنا أحق بابني منك ، فاختصما إلاى أبي بكر رضي الله عنه فقضى لها به ، PageV13P202 وقال : ريحها وحرها وفراشها خير له منك حتى يشب ويختار لنفسه ) ( عب ) . )(@)(@@)(@@)(@@) $ ( 814 ) عن القاسم بن محمد قال :(@)(@@) | 30 ( بصر عمر رضي الله عنه عاصما ابنه مع جدته أم أمه فكأنه جاذبها إياه ، فلما رآه أبو بكر رضي الله عنه مقبلا قال أبو بكر : مه مه هي أحق به ، فما راجعه عمر الكلام ) ( مالك عب وابن سعد ش ق ) . )(@)(@@)(@@)(@@) $ ( 815 ) عن زيد بن إسحاق عن حارثة الأنصاري :(@)(@@) | 30 ( أن عمر بن الخطاب خاصم إلاى أبي بكر رضي الله عنه في ابنه فقضى به أبو بكر لامه ثم قال : سمعت رسول الله يقول : لا توله والدة عن ولدها ) ( ق ) . )(@)(@@)(@@)(@@) $ ( 816 ) عن أبي جعفر :(@)(@@) | 30 ( أن أبا بكر وعمر وعثمان رضي الله عنهم تختموا في يسارهم ) ( ابن سعد ق ش ) . )(@)(@@)(@@)(@@) $ ( 817 ) عن سعيد بن المسيب قال :(@)(@@) | 30 