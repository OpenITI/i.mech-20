ms41	 لجهلي % % لأن قلبي به تحرش % PageV01P213 البحر : طويل 1(@)(@@) % فيا خانم الرسل الكرام ومن به % لنا من مهولات الذنوب تخلص % 2(@)(@@) % أغثنا أجرنا من ذنوب تعاظمت % فأنت شفيع للورى ومخلص % 3(@)(@@) % ومالي من وجه ولا من وسيلة % سوى أن قلبي في الحبة مخلص % 4(@)(@@) % % على أي شيء بعد ذلك أحرص % 5(@)(@@) % وليس يخاف الضيم من كنت كهفه % فعن أي شيء غير جاهك يفحص % 6(@)(@@) % عليك صلاة يشمل الآل عرفها % % وللجملة الأصحاب منها تخصص % PageV01P214 البحر : كامل تام 1(@)(@@) % في الراح سر بالسرور يحصص % فلذا الحباب إذا تبدت يرقص % 2(@)(@@) % قم هاتها من عين دارا قهوة % أقوالهم فيها تزيد وتنقص % 3(@)(@@) % لم يغلها ثمن لدى خطابها % % إذ كل غال في اللذاذة يرخص % 4(@)(@@) % واستجلها من كف معسول اللمى % % حلو الفكاهة للتودد يخلص % 5(@)(@@) % واغنم لذاذة عيشك الفاني فطر % % ف الدهر نحو الغدر طرف أخوص % PageV01P215 البحر : بسيط تام 1(@)(@@) % ودي لكم سادتي بالبعد ما نقصا % % والقلب في حبكم بالحب قد قنصا % % 2(@)(@@) % غاليت فيكم وعاصيت العذول وقد % % أطعتم واشيا قدري به رخصا % % 3(@)(@@) % متى أرى النصر منكم مقبلا وأرى % % شيطان ضدي على أعقابه نكصا % % PageV01P216 البحر : كامل تام 1(@)(@@) % سكن الزيادة وهو بدر كامل % يسبي عقول العاشقين بحرصه % 2(@)(@@) % كملت محاسنه بخط عذاره % وبه الأمان لحسنه من نقصه % PageV01P217 البحر : دو بيت 1(@)(@@) % يا من لهم علي وحدي فرض % لم يبق تهتكي بكم لي عرض % 2(@)(@@) % أحبابي مذ نأيتم عن بصري % % ضاقت وحياتكم علي الأرض % PageV01P218 البحر : بسيط تام 1(@)(@@) % أحبابنا أين ذاك العهد قد نقضا % % وأين عصر بأيام الوصال مضى % % 2(@)(@@) % وأين أيمانكم بالله أنكموا % % لا تمزجون بسخط في الغرام رضا % % 3(@)(@@) % عودوا فقد أوحش النادي لغيبتكم % عنه وأظلم ما قد كان منه أضا % % 4(@)(@@) % لما رميتم سهام البين عن ملل % صيرتموا كل قلب في الهوى غرضا % % 5(@)(@@) % أشكو إليكم سقامي من فراقكم % تالله لا جوهرا أبقى ولا عرضا % 6(@)(@@) % حسبي محافظة اني أموت بكم % % وجدا ولست أرجي عنكم عوضا % % PageV01P219 البحر : بسيط تام 1(@)(@@) % للعاشقين بأحكام 
ms42	 الغرام رضا % % فلا تكن يا فتى بالعذل معترضا % % 2(@)(@@) % روحي الفداء لأحبابي وإن نقضوا % % عهد المحب الذي للعهد ما نقضا % % 3(@)(@@) % قف واستمع سيرة الصب الذي قتلوا % % فمات في حبهم لم يبلغ الغرضا % % 4(@)(@@) % رأى فحب فسام الوصل فامتنعوا % % فرام صبرا فأعيا نيله فقضى % % PageV01P220 البحر : دو بيت 1(@)(@@) % يا من ببعاده لقلبي قرضا % % ظلما وبحبه لقتلي فرضا % % 2(@)(@@) % مذ غبت مدامعي بخدي انكسبت % والله وجفن مقلتي ما غمضا % % PageV01P221 البحر : سريع 1(@)(@@) % يا داية في حسنها أرتضي % % أن عذولي دائما يسخط % 2(@)(@@) % تداركي من مهجتي حاملا % حبك من خوف النوى تسقط % PageV01P222 البحر : كامل تام 1(@)(@@) % قمر يحجبه دلال مفرط % سلطانه أبدا علي مسلط % 2(@)(@@) % عهدي به متناهيا في حسنه % لكنه في قتلتي متوسط % PageV01P223 البحر : طويل 1(@)(@@) % غدا نافرا يدني وهو ساحط % وكم جهد ما أرضى الهوى وهو ساخط % 2(@)(@@) % ترحل عنا وصله وهو عادل % وخيم فينا هجره وهو قاسط % % 3(@)(@@) % يغالطني بالبدر عنه عواذلي % % وعن مثله بالبدر كيف أغالط % 4(@)(@@) % غزال يبيت الصب في ليل صده % % يخب اعتسافا وهو حيران خابط % 5(@)(@@) % شرائطه في الحب غير وفية % وكيف توفي من حبيب شرائط % 6(@)(@@) % يسل علينا مرهفات لواحظ % لها كل يوم من يد السحر خارط % PageV01P224 البحر : طويل 1(@)(@@) % خليلي هل من حامل لي تحية % إلى قمر نجم الثريا له قرط % 2(@)(@@) % أتى بين حقف مائج وأراكة % منعمة أوراقها الشعر السبط % 3(@)(@@) % فأبدى على كافور خد سوالفا % على الجلنار الغض من مسكها نقط % 4(@)(@@) % ونار شفاه حول جنة مبسم % مزاجهما شهد جني وإسفنط % 5(@)(@@) % فلا ولماه العذب لا كنت ناقضا % عهود هواه لا ولا ناسيا قط % PageV01P225 البحر : مجزوء الرجز 1(@)(@@) % خط العذار إن بدا % % أسعد منه حظه % 2(@)(@@) % من بدر تم زاهر % يسبي العقول لحظه % 3(@)(@@) % لما جلا الحسن حلا % مرشفه ولفظه % 4(@)(@@) % لام عليه عاذلي % % فلم يرق لي وعظه % PageV01P226 البحر : وافر تام 1(@)(@@) % وظبي قد سبى عقلي ولبي % بكاسات المدام وباللواحظ % 2(@)(@@) % أطعت العشق في وجدي عليه % وقلبي قد عصى فيه المواعظ 
ms43	 % PageV01P227 البحر : طويل 1(@)(@@) % أراك الحمى لما شدته السواجع % تثنى كما هبت عليه الزعازع % 2(@)(@@) % فأطربه من شدوها لحن ساجع % ينوح على أحبابه فهو ساجع % 3(@)(@@) % فسر الهوى للصب بالدمع ذائع % كما قلبه بين المحامل ضائع % 4(@)(@@) % على أن أيام الوصال ودائع % ولا بد يوما أن ترد الودائع % 5(@)(@@) % وليل جلا فيه الطلا أنجم الطلا % وهن أفول بيننا وطوالع % 6(@)(@@) % وقد غاب واشينا ونام رقيبنا % % وقد صدقتنا باللقاء المطالع % 7(@)(@@) % ونحن سجود في جوامع لذة % من الأنس والإبريق للكأس راكع % 8(@)(@@) % وطرف الصبا في حلبة الروض راكض % وطرف الندى في وجنة الورد دامع % 9(@)(@@) % إلى أن تجلى صبحه فكأنه % وجوه العذارى أبرزتها البراقع % 10(@)(@@) % فودعنا لا عن ملال ولا قلى % وقلنا دنا التفريق والشمل جامع % PageV01P228 البحر : طويل 1(@)(@@) % ركائب سهدي من قراها المدامع % هداها لهيب أضرمته الأضالع % 2(@)(@@) % أبيت أبيت الليل إلا بلوعة % أقضت بها وجدا علي المضاجع % 3(@)(@@) % كأن الدجى يبكي لحالي رحمة % فتلك النجوم الزاهرات مدامع % 4(@)(@@) % يا رب هل طيف الحبيبة زائر % وهل عهد ليلى بالأجيرع راجع % 5(@)(@@) % ويا ربة الخال الخلية من جوى % % محب له دون التصبر مانع % 6(@)(@@) % هجرت فلم يستغرق الطرف هجعة % فناظره صاد وهجرك صادع % 7(@)(@@) % وما ذنب من لا عنده الحب ذائع % ولا السر مبذول ولا العهد ضائع % PageV01P229 البحر : كامل تام 1(@)(@@) % نمت بما تحنو عليه ضلوعه % أسقامه وشجونه ودموعه % 2(@)(@@) % جلبت نواظهره لمهجته أسى % % وجوى يذوب ببعضه مجموعه % 3(@)(@@) % مغرى بوسنان اللحاظ وإنما % % في حبه هجر المحب هجوعه % 4(@)(@@) % أبدى محياه وأسبل شعره % % والبدر يحسن في الظلام طلوعه % 5(@)(@@) % للطرف فيه سنا وفيه بارق % هذا وذاك يروقه ويروعه % 6(@)(@@) % دبت عقارب صدغه في خده % فغدا وقلبي في الهوى ملسوعه % 7(@)(@@) % يا وافر الهجر الطويل تولهي % % خبب ألا وعد يجود سريعه % 8(@)(@@) % نبه جفونك من نعاس فتورها % % لترى محبا ذاب فيك جميعه % 9(@)(@@) % ما أنت يا طرفي بمتهم على % % سري فكيف إلى الوشاة تذيعه % 10(@)(@@) % حملتني ثقل الهوى ووضعته % عندي فهل محموله موضوعه 
ms44	 % PageV01P230 11(@)(@@) % من لي بمن لو سام قلبي غيره % ما كنت بالدنيا الغداة أبيعه % 12(@)(@@) % دعني وسهم اللحظ منه فإنني % % صب كما شاء الغرام صريعه % PageV01P231 البحر : مجزوء الكامل 1(@)(@@) % يشكو إليك متيم % صب جفاه هجوعه % 2(@)(@@) % يعصي العذول على هوى % % بك لا يزال يطيعه % 3(@)(@@) % يكفيك من ألم الجوى % % ما ضمنته ضلوعه % 4(@)(@@) % إن لم ترق له فقد % رقت عليه دموعه % PageV01P232 البحر : كامل تام 1(@)(@@) % ما كنت أندب رامة وطويلعا % لو كنت يا قمري علي طويلعا % % 2(@)(@@) % ولقد رأيت برامة بين النقا % % فمنعت طرفي منه أن يتمتعا % % 3(@)(@@) % ما ذاك من روع ولكن من رأى % % أشباه عطفك حق أن يتورعا % % 4(@)(@@) % يا ساكني نعمان لا اصطنع الهوى % % صبا يكون بكم هواه تصنعا % % 5(@)(@@) % قد أزعج القلب الغرام وأعجز ال % % طرف المنام فحق لي أن أجزعا % % 6(@)(@@) % أضمرتموه هجرا وأمرضتم حشى % مني وأضرمتم بنار أضلعا % % 7(@)(@@) % ولقد وقفت على حماكم مجدبا % فجرى به دمعي إلى أن أمرعا % % 8(@)(@@) % وحفظت عهدكم وضيعتم فلا % أدعو لأجلكم على من ضيعا % % 9(@)(@@) % قال العواذل إن من أحببتهم % لم يتركوا لك في وصال مطمعا % % 10(@)(@@) % أنا قد رضيت بما ارتضوه فما عسى % % أن يبلغ الواشي لدي بما سعى % % PageV01P233 11(@)(@@) % من أنت يا طبي الصريم دعوته % هيهات عنك بسلوة أن يرجعا % % 12(@)(@@) % لابد يا قمر الملاحة بعد أن % تبدي السرار وتحتفي أن تطلعا % % 13(@)(@@) % ولربما يا ظبي ترتاع الظبا % % مثل ارتياعك ثم تأنس مرتعا % % 14(@)(@@) % ما سحر هارون المفرق غير ما % % في مقلتيك من الفتور تجمعا % % 15(@)(@@) % أخليت مربع كل قلب في الهوى % % من صبره وجعلته لك مربعا % % 16(@)(@@) % وهي القلوب الطائرات فما لها % % أبدا نراها في حبالك وقعا % % 17(@)(@@) % ما صد عني في الغرام فديته % لما بذلت له دمي فتمنعا % % 18(@)(@@) % لكن رأى قلبي يزيد بقربه % صدعا فأشفق إن دنا أن يصدعا % % 19(@)(@@) % يا عاذلي دعني وعلم مقلتي % % لترى خيال معذبي إن تهجعا % % 20(@)(@@) % من كان مدمعه نجيعا في الهوى % % هيهات عذلك عنده أن ينجعا % % PageV01P234 21(@)(@@) % أم 
ms45	 كيف ريقتك التي أرقت لها % % عيني وما راقت تكفكف أدمعا % % PageV01P235 البحر : منسرح 1(@)(@@) % للمنطقيين أشتكي أبدا % عين رقيبي فليته هجعا % % 2(@)(@@) % حاذرها من أحبه فأبى % % أن نختلي ساعة ونجتمعا % % 3(@)(@@) % كيف غدت في الهوى وما انفصلت % مانعة الجمع والخلو معا % % PageV01P236 البحر : مجزوء الرمل 1(@)(@@) % إن الذي منزله % من سحب دمعي أمرعا % % 2(@)(@@) % لم أدر من بعدي هل % ضيع عهدي أم رعى % % PageV01P237 البحر : - 1(@)(@@) % طرف تعرض بعدكم لهجوع % لا زال شرق بفيض دموع % 2(@)(@@) % وجوانح جنحت لغير جمالكم % لا بشرت من عودكم برجوع % 3(@)(@@) % يا غائبون وهم بدور هل لكم % % أن تسمحوا لطويلع بطلوع % 4(@)(@@) % أوطانه ليست بأوطان إذا % % غبتم وليس ربوعه بربوع % 5(@)(@@) % وإذا حللتم في محل ممحل % كسيت محاسنه بكل ربيع % 6(@)(@@) % من لي بها قمرية قمرية % تسبيك بالمنظور والمسموع % 7(@)(@@) % زادت بطرة شعرها المفروق فو % % ق جبينها في حسنها المجموع % 8(@)(@@) % فعجبت من تلك الذوائب بعضها % % المحمول جاذب بعضها الموضوع % 9(@)(@@) % قد نزه البدر المنير ووجهها % % والشمس بالتثليث عن تربيع % 10(@)(@@) % بخل الخيال بها وزارت يقظة % فحظي بها سهري وخاب هجوعي % % PageV01P238 11(@)(@@) % وألذ ما كان الوصال إذا أتى % % شفعا كما تهوى بغير شفيع % 12(@)(@@) % فرفعت عن تلك العقود قناعها % % شرها ولم أك دونه بقنوع % 13(@)(@@) % فتبسمت عن مثل ما في جيدها % % لطفا ففاضت للسرور دموعي % % 14(@)(@@) % فتوهمت أني بكيت تخضعا % فتواضعت جبرا لفرط خضوعي % % 15(@)(@@) % فضممتها ضم اللمام لوردها % % أحنو على مجموعها بجميعي % % 16(@)(@@) % لولا الضلوع عدمتهن منعنني % % لجعلتها بالضم تحت ضلوعي % % 17(@)(@@) % ما كان أحلى في المزار دنوها % % لو لم تشبه مرارة التوديع % 18(@)(@@) % كالروح فيها للنفوس حياتها % % ونزاعها إن آذنت بنزوع % 19(@)(@@) % كم ميت بعد الفراق حياته % في قرب حي بالعقيق جميع % 20(@)(@@) % في منزل كهل الثمار مراهق الأز % % هار من ثدي الغمام رضيع % PageV01P239 21(@)(@@) % عاقت سريع نسيمه عذباته % بالميل فهو بهن غير سريع % 22(@)(@@) % عرب أعاجم ورقهم تشدوا على % % أسماعهم بالمنطق المسجوع % 23(@)(@@) % يحمون سمرهم بسمر مثلها % % في كل ضنك للكماة وسيع % % 24(@)(@@) % مزجت دموع 
ms46	 العاشقين بأرضهم % % نادى العواذل فيك غير مجاوب % 25(@)(@@) % بأبي بديع راقني من قده % والثغر بالتوشيح والتوشيع % 26(@)(@@) % % ودعوا إلى السلوان غير سميع % 27(@)(@@) % كم من معين للدموع بذلته % بمصون ربع من حماك منيع % 28(@)(@@) % لم أدر كيف كسرت قلبي وهوبي % ت هواك حتى بات في التقطيع % PageV01P240 البحر : - 1(@)(@@) % خافت من الرقباء يوم وداعي % % لما دعا بنوى الأحبة داع % 2(@)(@@) % قامت تودعني بقلب آمن % مما أجن وناظر مرتاع % 3(@)(@@) % لله ركب ليس عهد ودادهم % عند المحب وإن نأى بمضاع % 4(@)(@@) % منحوا النواظر بهجة وملاحة % وجنت حداتهم على الأسماع % 5(@)(@@) % بانوا فغصن البان فوق هوادج % وسروا ببدر التم تحت قناع % 6(@)(@@) % كم كاد يقضي عاشق لفراقهم % لولا الرجا وتعلق الأطماع % 7(@)(@@) % أعذول من علق الهوى بي عادة % فلقد أمرت بأمر غير مطاع % 8(@)(@@) % أو ما كفاه نزاعه مما به % فأتيته من عذله بنزاع % PageV01P241 البحر : دو بيت 1(@)(@@) % أفدي عربا حلوا بوادي الجزع % يا وحشة ناظري لهم في الربع % 2(@)(@@) % لما بحثوا عندي في فرقتنا % % اشتاق لهم مسايلا من دمعي % % PageV01P242 البحر : منسرح 1(@)(@@) % يا جامع المال وهو يمنعه % عن راغب في نواله طامع % 2(@)(@@) % أصبحت في البخل إذ عرفت به % كأنك الحد جامع مانع % PageV01P243 البحر : سريع 1(@)(@@) % قولوا لمن صد ومن حظنا % % في الحب أضحى عنده ملغى % % 2(@)(@@) % نحن سلونا عنك لكننا % % نبصر من يندم يابغا % % PageV01P244 البحر : مجتث 1(@)(@@) % وألثغ زار لكن % رأى رقيبي أصغى % % 2(@)(@@) % فقال ادخل أو امضي % % إلى متى أنت بغا % % PageV01P245 البحر : رجز تام 1(@)(@@) % غنيت بالمحبوب عما يشتهى % % والدهر قد آمنني من نزغه % 2(@)(@@) % فخمره وورده وآسه % من ريقه وخده وصدغه % PageV01P246 البحر : طويل 1(@)(@@) % كفى شرفا أني بحبك أعرف % فما آن أن تحنو علي وتعطف % 2(@)(@@) % عمرت جهاتي في هواك ولا أرى % % سواك ومالي عنك ما عشت مصرف % 3(@)(@@) % فزد في التجني حيث شئت فإنه % وحقك أنت المالك المتصرف % 4(@)(@@) % ومثلي أولى من يموت صبابة % ومثلك أولى من يحن ويسعف % 5(@)(@@) % أيا من له الحسن الذي بهر الورى % % ومن 
ms47	 حاز معنى لا يحد ويوصف % 6(@)(@@) % تجليت لي في كل شيء تكرما % فلست لهجر واقع أتخوف % 7(@)(@@) % وحزت جمالا ليس في الخلق مثله % به دائما قلبي يهيم ويشغف % 8(@)(@@) % فخدك ورد واللواحظ نرجس % وشخصك ندمان وريقك قرقف % 9(@)(@@) % وجفنك نبال وشعرك مسبل % وقدك حظي ولحظك مرهف % PageV01P247 البحر : طويل 1(@)(@@) % شكوت إلى ذاك الجمال صبابة % تكلف جفني أنه قط لا يغفو % % 2(@)(@@) % فلانت لي الأعطاف والخصر رق لي % % ولكن تجافى الشعر واثاقل الردف % PageV01P248 البحر : مجزوء الرمل 1(@)(@@) % قبل المحبوب من قب % ل ترى للدهر حيف % 2(@)(@@) % فلكم قالت لنا تل % ك العيون : الوقت سيف % 3(@)(@@) % وغدا الحب ينادي % % ا كرام الورد ضيف % PageV01P249 البحر : دو بيت 1(@)(@@) % يا ممرض جسمه ويا متلفه % كم تتلفه هجرا ولا تنصفه % 2(@)(@@) % رقوا لمتيم بكم حلف أسى % في حبكم المنام لا يعرفه % PageV01P250 البحر : مجزوء الكامل 1(@)(@@) % يا رب قد علقته % لدن المعاطف أهيفا % % 2(@)(@@) % والنرجس الغض الذي % % في ناظريه تألفا % % 3(@)(@@) % هو مضعف لكن بكس % % ر العين أصبح مضعفا % % 4(@)(@@) % إن كان أذنب بالصدو % % د فإن صبري قد عفا % % 5(@)(@@) % كم رمت رقة خضره % فأبان لي منها جفا % % 6(@)(@@) % وطلبت من ذاك العذا % % ر تعطفا فتوقفا % % PageV01P251 البحر : بسيط تام 1(@)(@@) % لا عذر للصب إن لم يألف التلفا % % وللأحبة إن لم يألفوا الصلفا % % 2(@)(@@) % من أين لي نسبة للعز عندهم % أبغي بها شرفا في الحب أو شغفا % % PageV01P252 البحر : طويل 1(@)(@@) % أرى نار وجدي أطفأتني ولا تطفى % % وسر غرامي قد خفيت ولا يخفى % % 2(@)(@@) % كأن الصبا أهدت إلي تحية % تعرفها نشرا وتنشرها عرفا % % 3(@)(@@) % وبين بيرت النازلين على الحمى % % غزال أبى أن يعرف الوصل والعطفا % % PageV01P253 البحر : - 1(@)(@@) % اتراك بالهجران حين فتكت في % % قلبي علمت بما يجن فتكتفي % % 2(@)(@@) % عاهدتنب أن لا تخون ولمت في % % طلبي وفاءك بالعهود ولم تف % 3(@)(@@) % إن جال طرفي في سواك فلا غفي % % أو حال قلبي عن هواك فلا عفي % % 4(@)(@@) % أنا صابر بل شاكر في الحب إن % أخلفت عهد الوصل أو لم تخلف 
ms48	 % 5(@)(@@) % لكنني أهوى وفاك وفاك إذ % أحببت نيل تشرف وترشف % 6(@)(@@) % وأبث وجدي في الهوى بتوصل % وتوسل وتطفل وتلطف % 7(@)(@@) % تالله لم أتوق في وجدي وقد % نادي هواك جوى ولم أتوقف % 8(@)(@@) % إني لأنأى معرضا عن عاذلي % % إن عاد لي أو عن فيك معنفي % % 9(@)(@@) % وأهيم منك بمرسل ومسلسل % ومورد ومجعد ومهفهف % 10(@)(@@) % لو زرتني يا منيتي ومنيتي % % ورحمت فرط تلهبي وتلهفي % % PageV01P254 11(@)(@@) % لرأيت طرفا ليس ينكر للبكا % % وشهدت جسما بالضنا لم يعرف % 12(@)(@@) % لم تخل من قلب المحب وحق ما % % ترضى به وبغير ذا لم أحلف % 13(@)(@@) % إلا هواك وأنت فيما أدعي % % أدرى بأني عنه لم أك أنكفي % % 14(@)(@@) % قد جار جار الحب في قلبي ولم % أر في الصبابة من صفا من منصف % PageV01P255 البحر : كامل تام 1(@)(@@) % بالغت بالإعراض في إتلافي % % ووصلت بين قطيعة وتجافي % % 2(@)(@@) % لست الملوم بما اجتنيت فإن من % شرط المحبة قلة الإنصاف % 3(@)(@@) % أشكوك أم أشكو إليك صبابة % ما مثلها عن علم مثلك خافي % % 4(@)(@@) % حملتني بهواك أضعاف الذي % % يكفيك منه البعض في إضعافي % % 5(@)(@@) % وطلبت منك السخط أطمع في الرضا % % علما بأنك آخذ بخلافي % % 6(@)(@@) % هلا ترق كوجنتيك على فتى % % يجد المنى في الوجد وهو مناف % 7(@)(@@) % أسرفت في هجري وليتك حيث قد % أسرفت لا أسرفت في الإسراف % 8(@)(@@) % يا طالبا قتلي ولست بواجد % أني وعنه حمى التصبر عافي % % PageV01P256 البحر : طويل 1(@)(@@) % تبسم زهر اللوز عن در مبسم % وأصبح في حسن يجل عن الوصف % 2(@)(@@) % هلم إليه بين قصف ولذة % فإن غصون الزهر تصلح للقصف % PageV01P257 البحر : بسيط تام 1(@)(@@) % مولاي كيف انثنى عنك الرسول ولم % تكن لوردة خديه بمرتشف % 2(@)(@@) % جاءتك من بحر ذاك الحسن لؤلؤة % فكيف ردت بلا ثقب إلى الصدف % PageV01P258 البحر : مجتث 1(@)(@@) % يا من بقلبي غرام % عليه ليس بخافي % % 2(@)(@@) % أضحى هواك وفائي % % فكيف أنت خلافي % % PageV01P259 البحر : سريع 1(@)(@@) % ورب أحوى أحور لم يزل % % يعطفني الحب إلى عطفه % 2(@)(@@) % كأن روض النيربين انثنت % تروي كمال الحسن عن وصفه % 3(@)(@@) % من عاين 
ms49	 الدهشة في وجهه % درى بأن السهم من طرفه % PageV01P260 البحر : كامل تام 1(@)(@@) % لا تخف ما صنعت بك الأشواق % واشرح هواك فكلنا عشاق % 2(@)(@@) % قد كان يخفي الحب لو لا دمعك ال % % جاري ولولا قلبك الخفاق % 3(@)(@@) % فعسى يعينك من شكوت له الهوى % % في حمله فالعاشقون رفاق % 4(@)(@@) % لا تجزعن فلست أول مغرم % فتكت به الوجنات والأحداق % 5(@)(@@) % واصبر على هجر الحبيب فربما % % عاد الوصال وللهوى أخلاق % 6(@)(@@) % كم ليلة أسهرت أحداقي بها % % ملقى وللأفكار بي إحداق % 7(@)(@@) % يا رب قد بعد الذين أحبهم % عني وقد ألف الرفاق فراق % 8(@)(@@) % واسود حظي عندهم لما سرى % % فيه بنار صبابتي إحراق % 9(@)(@@) % عرب رأيت أصح ميثاق لهم % % أن لا يصح لديهم ميثاق % 10(@)(@@) % وعلى النياق وفي الأكلة معرض % فيه نفار دائم ونفاق % PageV01P261 11(@)(@@) % ما ناء إلا حاربت أردافه % خصرا عليه من العيون نطاق % 12(@)(@@) % ترنو العيون إليه في إطراقه % فإذا رنا فلكلها إطراق % PageV01P262 البحر : خفيف تام 1(@)(@@) % ما عهدنا كذا تكون الرفاق % كل يوم تجنب وفراق % 2(@)(@@) % يا قضيبا تهزه نشوات % زر محبا تهزه الأشواق % 3(@)(@@) % ليس يصبو إلى سواك وأنى % % وله في الهوى بك استغراق % 4(@)(@@) % لك يا فتنة العقول التجني % والتجافي وتصبر العشاق % 5(@)(@@) % غير أني أرى الجفا منك بدعا % حيث تلك الأعطاف منك رقاق % 6(@)(@@) % يا أميرا له لواء من الشع % % ر عليه وكل قلب وطاق % PageV01P263 البحر : كامل تام 1(@)(@@) % أوحشتموا نظري فكم من عبرة % سمحت بها الأجفان والآماق % 2(@)(@@) % لا اخضر بعدكم العقيق ولا حلا % من مائه للواردين مذاق % 3(@)(@@) % حتى يراكم ناظري وتضمنا % % بكم الديار ويسعد المشتاق % % 4(@)(@@) % لم أجن ذنبا مذ عرفت هواكم % فعلام كاسات الصدود أذاق % PageV01P264 البحر : منسرح 1(@)(@@) % يا قلب كم ذا الخفوق والقلق % ها قد رثوا رحمة وقد رفقوا % % 2(@)(@@) % نلت أمانيك والأمان بهم % وزال ذاك الفراق والفرق % 3(@)(@@) % فادع إلى الله يدوم لك ال % % ود وما شاء بعد يتفق % 4(@)(@@) % وأنت يا طرفي القريح أسى % % بشراك زال البكاء والأرق % 5(@)(@@) % قد غفرت زلة 
ms50	 الزمان وقد % لان لنا منه ذلك الخلق % 6(@)(@@) % وقد صفا ود من كلفت به % ولاح برق الوصال يأتلق % 7(@)(@@) % وظلت إذ زارني أقبله % وأجتلي حسنه وأعتنق % % PageV01P265 البحر : رجز تام 1(@)(@@) % أنظر إلى الأفق تبدى بدره % وحوله من كل نجم شارق % 2(@)(@@) % كرقعة الشطرنج إلا أنها % % لم يبق إلا النقش والبيادق % PageV01P266 البحر : كامل تام 1(@)(@@) % لم تجرح السكين كف معذبي % % إلا لمعنى حسنه متحقق % 2(@)(@@) % هي مثل ما قد قيل جارحة له % ولكل جارحة إليه تشوق % PageV01P267 البحر : كامل تام 1(@)(@@) % ولقد كتبت إليك لما جد بي % % وجدي عليك وزادت الأشواق % 2(@)(@@) % وشكوت ما ألقاه من ألم الجوى % % فبكى اليراع ورقت الأوراق % PageV01P268 البحر : دو بيت 1(@)(@@) % مذ مال دلالا قدك الممشوق % لم يبق بلا صبابة مخلوق % 2(@)(@@) % قد حزت ملاحة ولطفا وحيا % % ما أسعد من أنت له معشوق % PageV01P269 البحر : بسيط تام 1(@)(@@) % من لي به رق معنى فيه رونقه % % ما كان أكمله لو صح موثقه % 2(@)(@@) % لدن القوام حلت ألفاظه فسبى % % قلبي ممنطقه الزاهي ومنطقه % 3(@)(@@) % استنظر الدهر يغفو عن ممانعتي % % فيه كأني من الأيام أسرقه % 4(@)(@@) % يا حسنه أنت تدري فرط جفوته % فلم أمرت قلوب الناس تعشقه % 5(@)(@@) % بالله يا راقد الأجفان رقع على % % ذي ناظر لم يزل هم يؤرقه % 6(@)(@@) % مجدد مطل ميعادي ومخلفه % مجرد ثوب سلواني ومخلقه % 7(@)(@@) % ما ضن بالدمع يوم البين فيك فهل % إن ظن منك له وصلا تحققه % 8(@)(@@) % يا آخذ القلب أردده على جسدي % % أو حاذر الله فيه أن تحرقه % 9(@)(@@) % لا أشتكي منك في وجد تخص به % يا رب قد ضاع قلبي في محبته % 10(@)(@@) % فإن لي بعض صبر أستعين به % ترفوه كف التأسي إذا تمزقه % % PageV01P270 11(@)(@@) % % ما بين غدر وعذر لي الفقه % PageV01P271 البحر : طويل 1(@)(@@) % مليح كأن الحسن أصبح حاديا % يسوق إليه كل صب يشوقه % 2(@)(@@) % تحمل منه الخصر ردفا يقله % % وحمل منه الصب ما لا يطيقه % 3(@)(@@) % وحكم فيه طرفه وقوامه % فراشقه يودي به ورشيقه % PageV01P272 البحر : منسرح 1(@)(@@) % لم يبق في قلب 
ms51	 عاشق رمقا % لما بدا والعيون ترمقه % 2(@)(@@) % وكان عزمي عن السلو إذا % % عنفني العاذلون يوثقة % % 3(@)(@@) % وكيف يسلوه مغرم دنف % يرى جميع الوجود يعشقه % PageV01P273 البحر : طويل 1(@)(@@) % ولما التقينا للوداع وللجوى % % بقلبي سكون طال منه خفوقه % 2(@)(@@) % لثمت ثناياه وقبلت فرقه % وقد جد وجد بالفءاد يشوقه % 3(@)(@@) % فقد راقني يوم الوداع وراعني % % بحسن وحزن فرقه وفريقه % % PageV01P274 البحر : طويل 1(@)(@@) % كتبت ولو أني من الشوق قادر % لسارعت فيه نحو من أنا رقه % 2(@)(@@) % ولو أنني أسعى إلى ذلك الحمى % % على الرأس ما أديت ما تستحقه % PageV01P275 البحر : دو بيت 1(@)(@@) % المغرم من ذكراكم يقلقه % والعاني من أشواقكم تحرقه % 2(@)(@@) % والمدنف من مدمعه يغرقه % والعاشق فيك بلة تخنقه % PageV01P276 البحر : سريع 1(@)(@@) % كم شمل صبر هجركم فرقه % وناظر بعدكم أرقه % 2(@)(@@) % فكم رنا طرف عليل بكم % وكم تركتم مهجة شيقه % 3(@)(@@) % طورا تجودون بوصل أرى % % أيامه من قربكم مشرقه % 4(@)(@@) % وتارة تبدون هجرا فيا % % ويح حشى نحوكم سيقه % 5(@)(@@) % نشفتموني في هواكم وقد % أخذتموا رأسي في جردقه % PageV01P277 البحر : دو بيت 1(@)(@@) % جفني بكم منامه طلقه % كم أرفو فؤادا هجركم مزقه % 2(@)(@@) % يا من هجروا طرفي محبوه كرى % بالله عسى الخيال أن يطرقه % PageV01P278 البحر : وافر تام 1(@)(@@) % ومجتمعين ما اجتمعا لإثم % وإن وصفا بضم واعتناق % 2(@)(@@) % لعمر أبيك ما اجتمعا لمعنى % % سوى معنى القطيعة والفراق % PageV01P279 البحر : خفيف تام 1(@)(@@) % بتثني قوامك الممشوق % وبأنوار وجهك المعشوق % 2(@)(@@) % وبمعنى للحسن مبتكر في % % ك وخصر كقلبي المسروق % 3(@)(@@) % صل محبا من ناظريك ومن % قدك يرمى براشق ورشيق % 4(@)(@@) % ومن الخال والمقبل ما بين % % حريق يفني وبين رحيق % % 5(@)(@@) % جد بوصل أو زورة أو بوعد % أو كلام أو وقفة في الطريق % 6(@)(@@) % أو بإرسالك السلام من الريح % وإلا فبالخيال الطروق % 7(@)(@@) % أتمناك كلما سار برق % ليس مثلي وجدا على التحقيق % 8(@)(@@) % بيننا في الهوى اختلاف وإن كا % % ن اتفاق فربما في الخفوق % 9(@)(@@) % يا عريب العقيق من لي وهيها % % ت بأيامنا بوادي العقيق % % 10(@)(@@) % حيث غصن الوصال رطب وروض 
ms52	 % وروض الحب زاه وبدره في شروق % PageV01P280 11(@)(@@) % وحبيب قد لان عطفا وعطفا % فهو يزري بكل غصن وريق % 12(@)(@@) % يملأ الكأس لي بمز قديم % وحديث حلو ولحظ وريق % 13(@)(@@) % وإذا نقطت دموعي غنى % ما عهدنا كذا بكاء المشوق % % PageV01P281 البحر : كامل تام 1(@)(@@) % جدد عهود تواصل وتلاق % واستبق لي رمقا فليس بباق % 2(@)(@@) % وأشفع إلى ما رق من ترف الصبا % % في وجنتيك برقة الاخلاق % PageV01P282 البحر : كامل تام 1(@)(@@) % لما رأت عشاقها قد أحدقوا % % من حسنها بحدائق الأحداق % 2(@)(@@) % شغلت سواد عيونهم في شعرها % % وتوشحت بياضهن الباقي % % 3(@)(@@) % وارجع إلى حسن الوفاء فإن قب % ح الغدر حجة سلوة المشتاق % 4(@)(@@) % والحسن ليس بحافظ لك ذمة % إلا بحفظك ذمة العشاق % 5(@)(@@) % يا عاجلا بالهجر منه وجاعلا % بين الجوانح لاعج الأشواق % 6(@)(@@) % ما حق قلب قد صفا لك وده % % تقطيعه بقطيعة وفراق % 7(@)(@@) % مع ذا وذا كيف اشتهيت فكن أنا % % الموثوق بي في صحة الميثاق % 8(@)(@@) % وعلى مذاق المر من ثمر الجفا % % يبلى الصحيح هوى من المذاق % PageV01P283 البحر : دو بيت 1(@)(@@) % يا غصن نقا يميس في الأوراق % يا بدر دجى يطلع في الأطواق % 2(@)(@@) % إن تهجر أو تصد يا بدر أفل % ذا هجرك محمول على الاحداق % PageV01P284 البحر : دو بيت 1(@)(@@) % يا ذا القمر المنير في الآفاق % الصبر فني فيك ووجدي باقي % % 2(@)(@@) % كم تلسعني عقرب صدغيك عسى % % أن تسمح لي من فيك بالدرياق % PageV01P285 البحر : دو بيت 1(@)(@@) % لما حكم الزمان بالتفريق % واستبطن ناديهم ظهور ا لنوق % % 2(@)(@@) % أطلقت دموعي إثرهم في قبس % من نار زفيري خشية التغريق % PageV01P286 البحر : رجز تام 1(@)(@@) % يا قمرا رأيته في ماتم % من حزنه شق على شقيقه % 2(@)(@@) % لا تلطم الخد عليه أسفا % فربما شق على شقيقه % PageV01P287 البحر : بسيط تام 1(@)(@@) % قد مال سمعي إلى عذاله فيكا % % يكفيك تلويح هذا القول يكفيكا % % 2(@)(@@) % كم بت تفكر بغضا كيف تسخطني % % وبت أفكر حبا كيف أرضيكا % % 3(@)(@@) % يا ناظري ارقدا لا للخيال ويا % % قلبي استرح من هوى من كاد يفنيكا % % 4(@)(@@) % وكيف أرضى 
ms53	 لنفسي أن أسود من % لم يرض أني له أصبحت مملوكا % % PageV01P288 البحر : كامل تام 1(@)(@@) % أحبابنا إن باح فيكم بالهوى % % صب بكى وجدا بكم وتهتكا % % 2(@)(@@) % قد كان يستحي فيخفيه وقد % نزح الحيا من عينه لما بكى % % PageV01P289 البحر : سريع 1(@)(@@) % الشيخ قالوا قد غدا سالكا % % فقلت للنار غدا سالكا % % 2(@)(@@) % لا تغترر بالزور من فعله % كم فاتك تحسبه ناسكا % % PageV01P290 البحر : دو بيت 1(@)(@@) % يا مالك رق الصب بالله عليك % ارحم حائرا يسايل الدمع عليك % % 2(@)(@@) % واسمح بخيال في الدجى يطرق من % % أضحى دنفا أذابه الشوق إليك % % PageV01P291 البحر : طويل 1(@)(@@) % بلا غيبة للبدر وجهك أجمل % وما أنا فيما قلته متجمل % 2(@)(@@) % ولا عيب عندي فيك لولا صيانة % لديك بها كل امرىء يتبذل % 3(@)(@@) % وحجبك حتى لو عن الحجب تتقي % % حجابا ولا تبدو لها كنت تفعل % 4(@)(@@) % لحاظك أسياف ذكور فما لها % % كما زعموا مثل الأرامل تغزل % 5(@)(@@) % وما بال برهان العذار مسلما % ويلزمه دور وفيه تسلسل % 6(@)(@@) % وعهدي أن الشمس بالصحو آذنت % فما بال سكري من محياك يقبل % 7(@)(@@) % كأنك لم تخلق لغير نواظر % تسهدها وجدا وقلبا تعلل % 8(@)(@@) % علي ضمان أن طرفك لا يرى % % من الحسن شيئا عند غيرك يجمل % 9(@)(@@) % وإن قلوب العاشقين وإن تجر % عليها إلى سلوانها ليس تعدل % 10(@)(@@) % حبيبي ليهن الحسن أنك حزته % ويهن فؤادي أنه لك منزل % PageV01P292 11(@)(@@) % إذا كنت ذا ود صحيح فلم يكن % يضر بي العذال حيث تقولوا % % 12(@)(@@) % رأوا منك حظي في المحبة وافرا % لذا حرفوا عني الحديث وأولوا % % PageV01P293 البحر : طويل 1(@)(@@) % حللت بإحشاء لها منك قاتل % فهل أنت فيها نازل أو منازل % 2(@)(@@) % أرى الليل مذ حجبت ما حال لونه % على أنه بيني وبينك حائل % 3(@)(@@) % وما كنت مجنون الهوى قبل أن يرى % % لقلبي من صدغيك في الأسر عاقل % 4(@)(@@) % ولولا سنان من لحاظك قاتل % لما كنت أدري أن طرفك ذابل % 5(@)(@@) % ولم لا يصح الوجد فيك وناظري % % لنسخة حسن من سناك يقابل % 6(@)(@@) % ولي منطق من نحو شوقي أطوله % % بعلم المعاني 
ms54	 من خلافك شاغل % 7(@)(@@) % أيسعدني يا طلعة البدر طالع % ومن شقوتي حظ بخديك نازل % 8(@)(@@) % بخلت ولم تسمع فما منك نائل % وصانك إعراض فما لك نائل % 9(@)(@@) % ولو أن قسا واصف منك وجنة % لأعجزه نبت بها وهو باقل % 10(@)(@@) % ولي منك عرف من ودادك عاطر % وحالي من عرفان وصلك عاطل % PageV01P294 11(@)(@@) % على كل أمر منك عون فربما % % يعين الذي أبلى بم أنت فاعل % 12(@)(@@) % وبي ساحر في اللحظ للخد حارس % وذابل أعطاف لدمعي باذل % 13(@)(@@) % وشعر كليلي كان طولا فما له % قصيرا كحظي هل لذاك دلائل % 14(@)(@@) % نعم قد تناهى في الظلام تطاولا % وعند التناهي يقصر المتطاول % PageV01P295 البحر : خفيف تام 1(@)(@@) % كيف يصغي لعاذل أو يميل % مغرم شفه ضنى ونحول % 2(@)(@@) % لي شغل بالحب حتى عن الح % فماذا عسى يقول العذول % 3(@)(@@) % إن للحب معركا يسخط القا % % تل فيه ويرتضي المقتول % 4(@)(@@) % يا ملوكا ومالكا ما الذي يص % % نع فيك المملوك والمملول % 5(@)(@@) % دون نيل الوصال منك خطوب % كلما خلتها تهون تهول % 6(@)(@@) % للسيوف الحداد ضرب وللسم % % ر طعان وللجياد صهيل % 7(@)(@@) % أين راح الوصال بل أين كان ال % % هجر بل كيف للدنو سبيل % 8(@)(@@) % إن شكا الطرف باكيا طول ليل % قلت مهلا ليل الشتاء طويل % 9(@)(@@) % ما معيني على الهوى غير ندب % هو في الحادثات ليث يصول % 10(@)(@@) % ولمن حارب الزمان حسام % ولمن حاول الإخاء خليل % PageV01P296 11(@)(@@) % يا كريم الإحسان ما ضرك الده % ر إذا ماوافاك وهو بخيل % 12(@)(@@) % لي شهود من الوفاء عدول % أنني عن هواك مالي عدول % % 13(@)(@@) % لا تلمني إن كنت قصرت في المد % ح فعذزي عند الورة مقبول % 14(@)(@@) % هل يحيط اللسان منك بوصف % فيه يفنى المنقول والمعقول % PageV01P297 البحر : طويل 1(@)(@@) % ملامك لا ربط لديه ولا حل % دمي للهوى إن كان يرضي الهوى حل % 2(@)(@@) % إليك وما موهت عني فإنما ال % % تجاهل عند العارفين به جهل % 3(@)(@@) % بروحي وأهلي من إذا عرضوا لها % % بذكري قالت دونه الروح والأهل % 4(@)(@@) % تحدث في النادي بذكري وذكرها % % وصار 
ms55	 لأهل الحي من ذكرنا شغل % 5(@)(@@) % وما الحب إلا أن يقلوا ويكثروا % % بنا ويصحوا في الظنون ويعتلوا % % 6(@)(@@) % أبت رقتي إلا الذي يقتضي الهوى % % وعزمي إلا ما اقتضى الرأي والعقل % 7(@)(@@) % فواعجبا أني خفيت وكم أبن % وقد راح مملوء بي الحزن والسهل % 8(@)(@@) % طريد ولي مأوى مباح ولي حمى % وحيد ولي صحب غريب ولي أهل % 9(@)(@@) % سأجهد إما للمنايا أو المنى % % قصاراي إما النصر أو ما جنى النصل % 10(@)(@@) % فإن لم تصل بي همتي بمطالبي % % ولم ينتسج للشيب في لمتي غزل % PageV01P298 11(@)(@@) % فلا نظرت عيني ولا فاه مقولي % % ولا بطشت كفي ولا سعت الرجل % 12(@)(@@) % ومن عرف الأمر الذي أنا عارف % رأى كل صعب كل إدراكه سهل % 13(@)(@@) % خذ العز من أي الوجوه رأيته % فلا خير في عيش يكون به الذل % 14(@)(@@) % وللمرء من داعي الطبيعة قائد % إذا لم يذده دونه الحلم والنبل % 15(@)(@@) % من الترب هذا الطبع والنفس من علا % فللمرء أن يدنو وللمرء أن يعلو % % PageV01P299 البحر : كامل تام 1(@)(@@) % قل لي بعيشك هل على هذا الجفا % % تبقى قلوب أو تدوم عقول % 2(@)(@@) % ما بال خدك جار في تقسيمه % لي ناره ولغيري التقبيل % 3(@)(@@) % يا طرفه والرمح فيه نضارة % فعلام في حد السنان ذبول % 4(@)(@@) % يا من جعلت إخاءه لي عدة % في يوم يدخر الخليل خليل % 5(@)(@@) % ما بال قلبك ما دعته صبابة % ما بال دمعك ما عراه همول % 6(@)(@@) % أين المودة إنها لعزيزة % أين التودد إنه لقليل % 7(@)(@@) % أين المعين على الصبابة أهلها % % ليخف عبء الوجد فهو ثقيل % 8(@)(@@) % أين الذي يحوي صفات محمد % هيهات عز فما إليه سبيل % PageV01P300 البحر : بسيط تام 1(@)(@@) % أرح يمينك مما أنت معتقل % أمضى الأسنة ما فولاذه الكحل % 2(@)(@@) % يا من يريني المنايا واسمها نظر % من السيوف المواضي واسمها مقل % 3(@)(@@) % ما بال ألحاظك المرضى تحاربني % % كأنما كل لحظ فارس بطل % 4(@)(@@) % وما لقومك ساءت بي ظنونهم % فليتهم علموا مني الذي جهلوا % % 5(@)(@@) % في ذمة الله ناء حسنه أمم % وفارغ القلب في قلبي 
ms56	 به شغل % 6(@)(@@) % من دونه كثب من دونها حرس % من دونه قضب من دونها الأسل % 7(@)(@@) % ومعشر لم تزل في الحرب بيضهم % حمر الخدود وما من شأنها الخجل % 8(@)(@@) % إذا انتضوها بروقا ردها سحبا % بها دم سال منها عارض هطل % 9(@)(@@) % يثني حديث الوغى أعطافهم طربا % كأن ذكر المنايا بينهم غزل % 10(@)(@@) % كم نار حرب بهم شبت وهم سحب % وأرض قوم بهم فاضت وهم شعل % PageV01P301 11(@)(@@) % من كل ذي طرة سوداء يلبسها % % غيم بها من عباب النقع متصل % 12(@)(@@) % ضاءت بحسنهم تلك الخيام كما % % ضاءت بوجه ابن عبد الظاهر الدول % 13(@)(@@) % كأنما كف فتح الدين وجنته % لذاك يحسن في ساحاتها القبل % 14(@)(@@) % أغر ما أبدت السحب الحيا لسوى % % تقصيرها عن نداه حين ينهمل % 15(@)(@@) % إن قلت يمناه مثل البحر صدقني % % بها مناهل منها تشرب القبل % 16(@)(@@) % يد لها كم يد من قبلها سبقت % يد وكم من يد من بعدها تصل % 17(@)(@@) % توحي إلى كل قرطاس بلاغته % سحر البيان ومن أقلامه الرسل % 18(@)(@@) % سمر تروقك رأي العين عارية % ومن بديع معانيه لها حلل % 19(@)(@@) % من الأسنة في أطرافها سنة % لولا النضارة قلنا إنها ذبل % 20(@)(@@) % من كل معتدل كالميل إن رمدت % عين المعالي ففيها نقسه كحل % PageV01P302 21(@)(@@) % فللعداة لديه كل ما حذروا % % وللعفاة عليه كل ما سألوا % % 22(@)(@@) % أضحت يداه لعقد الجود واسطة % فليس يدرى لجود بعدها عطل % 23(@)(@@) % يجود حتى يمل الناس أنعمه % وليس يدركه من بذلها ملل % 24(@)(@@) % سادت وسارت بها الأفواه معلنة % فقد غدت مثلا يغدو بها المثل % 25(@)(@@) % بنى لأبنائه بيت العلى وثوى % % فيما بناه له آباؤه الأول % 26(@)(@@) % كانوا أتم الورى جودا وإن صمتوا % % وأعظم الناس أحلاما وإن جهلوا % % 27(@)(@@) % زالوا فأودع في الأسماع ذكرهم % محاسنا أودعتها قبلها المقل % 28(@)(@@) % امدح وقل في معانيه فقد كرمت % لا يحسن القول حتى يحسن العمل % 29(@)(@@) % يا معدن الجود لا أبغي سواك ولو % فعلت ذلك سدت عني السبل % 30(@)(@@) % إن ابن بابك محسوب عليك ولي % % حق العبودة مشفوع به 
ms57	 الأمل % PageV01P303 البحر : وافر تام 1(@)(@@) % متى بالقرب يخبرني الرسول % ويسمح باللقا دهر بخيل % 2(@)(@@) % ويرجع فيك ستر الحب جهرا % ويشفى منك بالوصل الغليل % 3(@)(@@) % وداد لا تغيره الليالي % % وحب لا ينهنهه العذول % 4(@)(@@) % وعهد كنت تعهده صحيح % وقلب كنت تسكنه عليل % 5(@)(@@) % وما بين الضلوع إليك شوق % تزول الراسيات ولا يزول % 6(@)(@@) % ألا يا ظاعنا هل من رجوع % فتجمعنا المنازل والطلول % 7(@)(@@) % فقد فقد الكرى جفن قريح % وقد ألف الضنا جسم نحيل % 8(@)(@@) % وصبك قد قضى سوقا ووجدا % يكون لوجهك العمر الطويل % PageV01P304 البحر : كامل تام 1(@)(@@) % ته كيف شئت فللحبيب تدلل % ولصبه المضنى إليه تذلل % 2(@)(@@) % واحكم بما ترضى فأنت أحق من % ملك الفؤاد يجوز فيه ويعدل % 3(@)(@@) % إني وإن عذلوا عليك وأطنبوا % % لتزيد أشواقي إليك العذل % 4(@)(@@) % لكنني أبدي السلو تجملا % للعاذلين وللمحب تجمل % 5(@)(@@) % وإليك أول ما انثنيت مع الهوى % % إن الحبيب هو الحبيب الأول % 6(@)(@@) % يا من يصون عن العيون تحرزا % حسنا عليه كل روح تبذل % 7(@)(@@) % كم ذا ألين وتعتريك قساوة % وإلام أسمح بالوصال وتبخل % 8(@)(@@) % يا معدن الآمال أين لعاشق % كلف بحبك عن جمالك معدل % PageV01P305 البحر : دو بيت 1(@)(@@) % كم يشمت بي في حبك العذال % كم يكثر فيك القيل بي والقال % 2(@)(@@) % الصبر بكل حالة أليق بي % % أحتاج أداريك ويمشي الحال % PageV01P306 البحر : سريع 1(@)(@@) % بمهجتي سلطان حسن غدا % % يجور في الحب ولا يعدل % 2(@)(@@) % يا عاشقيه إحذروا صدغيه % فهو الحشيشي الذي يقتل % PageV01P307 البحر : وافر تام 1(@)(@@) % فديتك كم علي عليك عذل % وليس لديك للعشاق عدل % 2(@)(@@) % وكم أطوي إذا وافيت شوقا % كأني عند شمس سناك ظل % 3(@)(@@) % وصالك مضمر للعبد هجر % وهجرك مظهر للود وصل % 4(@)(@@) % حبيبي كيف قيل الشعر فرع % وشعرك للملاحة فيك أصل % 5(@)(@@) % بروحي من على خديه ورد % سقاه بأدمعي وبل وطل % 6(@)(@@) % شبيه الريم ضن بطيب وصل % فحدث عن كريم فيه بخل % 7(@)(@@) % إذا حاولت حل البند قالت % معاطفه حمانا لا يحل % 8(@)(@@) % وإن جليت بوجنته مدام % يرى لعذاره دور ونزل 
ms58	 % 9(@)(@@) % وأرسل صدغه عرفا نثارا % بخد ماله في الورد مثل % 10(@)(@@) % فليس الفضل والحسن بن سهل % وإن يك فيهما منح وبذل % PageV01P308 11(@)(@@) % كجودك أو كخلقك يوم سلم % فذا فضل وذا حسن وسهل % PageV01P309 البحر : خفيف تام 1(@)(@@) % هات قل لي كم الجفا والدلال % % لست ممن يمسي لديه محال % 2(@)(@@) % لو أردت الوصال ما صدك الوا % % شي ولا رد عزمك العذال % 3(@)(@@) % أنا لي منك قسوة وصدود % ولغيري تعطف ووصال % 4(@)(@@) % دع دلال الجمال وانصف وقل لي % % أي شيء من الصدود حلال % 5(@)(@@) % أنا ذاك الذي عهدت وإن حا % % ل تجنيك بيننا والملال % 6(@)(@@) % يا كحيل الجفون لي فيك جفن % ما له من سوى السهاد اكتحال % PageV01P310 البحر : كامل تام 1(@)(@@) % لي من جمالك شاهد وكفيل % أني عن الأشواق لست أحول % 2(@)(@@) % يا من تقاصر ليله لسروره % % ليلي كما شاء الغرام طويل % 3(@)(@@) % غادرتني بحشى تذوب ومقلة % عبرى وقلب حظه التعليل % 4(@)(@@) % في كل جفن للتسهد موطن % وبكل خد للدموع مسيل % PageV01P311 البحر : كامل تام 1(@)(@@) % بأبي وما ملكت يدي من سمته % وصلا فلم يك لي إليه وصول % 2(@)(@@) % يهوى الخلاف وقد هويت مقال لا % % إذ لم يزل أبدا بفيه يجول % PageV01P312 البحر : رجز تام 1(@)(@@) % يا بأبي معاطف وأعين % % يصون منها رامح ونابل % 2(@)(@@) % فهذه ذوابل نواضر % وهذه نواظر ذوابل % PageV01P313 البحر : رجز تام 1(@)(@@) % ما لامه عليكم عذوله % إلا وزاد نحوكم عدوله % % 2(@)(@@) % مغرى الفؤاد صبه عاني الحشا % % أسيره مضنى الهوى عليله % % 3(@)(@@) % قد أوقعت عيونه فؤاده % في عثرة فمن له يقيله % 4(@)(@@) % وافى بشوق نحوكم مديده % سريع وجد فيكم طويله % 5(@)(@@) % فما الذي يضير قدس وصلكم % أن الذي هام بكم خليله % 6(@)(@@) % واعجبا والقلب يشكو وحشة % إليكم وأنتم حلوله % 7(@)(@@) % وبي رشيق القد لا يعطفه % % تعطف نحوي ولا يميله % 8(@)(@@) % لا واخذ الله بدمعي خده % % فهو الذي أساله أسيله % 9(@)(@@) % فللقنا وللنقا قوامه % وللظبى وللظبا كحيله % 10(@)(@@) % عجبت منه إذ بدا جماله % لناظري كيف اختفى جميله % PageV01P314 11(@)(@@) % إن ناظروا ناظره في قتلتي % % يقوم 
ms59	 من دلاله دليله % PageV01P315 البحر : سريع 1(@)(@@) % جار فهيهات يرى عدله % أو يرتجى بعد الجفا وصله % 2(@)(@@) % أهكذا بالله أخلاقه % في الحب أم علمه أهله % 3(@)(@@) % يا من حكى لون الدجى فرعه % % قل لي هجرانك ما أصله % 4(@)(@@) % أطلت في الحب تجنيك وال % % موت ولا هذا الجفا كله % % 5(@)(@@) % واعجبا من عاذل لم يزل % يحدو فؤادي للهوى عذله % 6(@)(@@) % يا ذا الذي يطمع في سلوتي % % أهكذا قال له عقله % PageV01P316 البحر : منسرح 1(@)(@@) % وشادن يسلب العقول ولا % % يمهلها في الهوى فيهملها % % 2(@)(@@) % تغزل ألحاظه وكم فتكت % في القلب من راقه تأملها % % 3(@)(@@) % جديدة السحر لم تزل أبدا % حديثها في الهوى ومغزلها % % PageV01P317 البحر : طويل 1(@)(@@) % فدتك نفوس قد حلا بك حالها % % وأضحى صحيحا في هواك اعتلالها % % 2(@)(@@) % ملكت قلوب العاشقين بطلعة % يروق جميع الناظرين جمالها % % 3(@)(@@) % وزاد بك الحسن البديع نضارة % كأنك في وجه الملاحة خالها % % 4(@)(@@) % سلبت فؤاد الصب منك بقامة % حكى الغصن منها ميلها واعتدالها % % 5(@)(@@) % فصل مغرما حملته منك في الهوى % % بلابل وجد لا يطاق احتمالها % % PageV01P318 البحر : خفيف تام 1(@)(@@) % عن لي دمية ولاح هلالا % % وانثنى صعدة وفر غزالا % % 2(@)(@@) % فتذللت حين أبدى دلالا % ورأى رخص أدمعي فتغالا % % 3(@)(@@) % يا غنيا بالحسن أسألك الوص % ل وحاشاك أن ترد السؤالا % % 4(@)(@@) % رشأ قد أطعت فيه غرامي % % وعصيت اللوام والعذالا % % 5(@)(@@) % قتلتني جفونه وهي مرضى % % سلبتني قواي وهي كسالا % PageV01P319 البحر : مجزوء الرمل 1(@)(@@) % كان ماكان وزالا % % فاطرح قيل وقالا % 2(@)(@@) % أيها العاتب ظلما % حسبك الله تعالى % % PageV01P320 البحر : خفيف تام 1(@)(@@) % وفقيه كالبدر زار بليل % فجلا نوره الدجى إذ تجلى % % 2(@)(@@) % ما درى موضعي ولكن قلبي % % بضرام الحشا هداه ودلا % 3(@)(@@) % وعجيب منه فقيه ذكي % بمحل النزاع كيف استدلا % PageV01P321 البحر : وافر تام 1(@)(@@) % أأطلب يا محمد أن يؤولا % لغيرك ود قلبي أو يميلا % % 2(@)(@@) % وأرجو غير بابك لي مراما % وأقصد غير ربعك لي مقيلا % % 3(@)(@@) % واخطب شمسك أن تجلى % % وأسأل غير مائك أن يسيلا % % 4(@)(@@) % وقد أنجحت لي بنداك مسعى % وقد حققت لي 
ms60	 أملا وسولا % % 5(@)(@@) % جعلت بجاهك العلياء دوني % % ورعت ببأسك الخطب المهولا % % 6(@)(@@) % وماأنا منكر تلك العطايا % % وما أنا جاحد ذاك الجميلا % % 7(@)(@@) % ولا أنا قانع لك من وداد % بأن أثني عليك وأن أقولا % % 8(@)(@@) % على أني فتى فطن بليغ % بلوغ ما سلكت له سبيلا % % 9(@)(@@) % بألفاظ تخر لها القوافي % % وينقاد القريض لها ذلولا % % 10(@)(@@) % إذا مرت على أذني فصيح % سواك يعض إصبعه طويلا % % PageV01P322 11(@)(@@) % وما أنا بالغ بكثير مدحي % % من الكرم الذي تحوي قليلا % % 12(@)(@@) % وأنت أعز أن تدعى عزيزا % وأنت أجل أن تدعى جليلا % % 13(@)(@@) % وأنت أخ لكل غريب دار % إذا عدم القرابة والخليلا % % 14(@)(@@) % يسلي لفظك الصب المعنى % % ويشفي ذكرك الدنف العليلا % % 15(@)(@@) % إذا وهب الإله لنا عقولا % وهبت لما وهبناه عقولا % % 16(@)(@@) % فداؤك من من تدين له الأماني % % بأن يلقى إليك له وصولا % % 17(@)(@@) % ومن هو دون أن يرنو بطرف % إليك فكيف تنظره عديلا % % 18(@)(@@) % ترى شمس الضحى إبان تبدو % % وتنظر حين تنتسب الأصولا % % 19(@)(@@) % فمن وافى يعيب الشمس يوما % كفاه على جهالته دليلا % % PageV01P323 البحر : بسيط تام 1(@)(@@) % قد كان ما علم اللاحي وما جهلا % % وصار ما كتم الواشي وما نقلا % % 2(@)(@@) % كان التكتم يرجى قبل بينكم % أما وقد حكمت أيدي الفراق فلا % 3(@)(@@) % وفي الركائب من زودته نظرا % ولو أمنت العدى زودته قبلا % % 4(@)(@@) % أودى بقلبي عذار زار وجنته % % حسنا ومن بعض نبت الروض ما قتلا % % PageV01P324 البحر : منسرح 1(@)(@@) % سرى لأرض الكرى فما وصلا % % ورام كتم الهوى فما حصلا % % 2(@)(@@) % مستغرق الحال بالصبابة لو % % أراد نطقا بغيرها جهلا % % 3(@)(@@) % الناس فيما تحبه فرق % ما منهم من لشأنه عقلا % % 4(@)(@@) % فكم يراعي وكم يراع لقد % جار عليه الغرام مذ عدلا % % 5(@)(@@) % طال نزاع العذول فيه كما % % طال نزاع الفؤاد فاعتدلا % % 6(@)(@@) % ما بال قلبي وشأنه عجب % أماله الوجد حين قلت سلا % % 7(@)(@@) % إن من العذل دائما جدلا % ليس يرى في الهوى به جذلا % % 8(@)(@@) % يا صاحب الصدق نهضة عرفت % منك فقد رمت حادثا جللا % % 9(@)(@@) % يا بن 