ms981	 % % وفي حده مصداق تلك المخايل % 6(@)(@@) % ويوم عصيب ظله مثل ضحه % % بل الضح أعفى من ظلال المناصل % 7(@)(@@) % يبادل أعلاق المظنة تحته % رجال عدى يا للعدو المبادل % % 8(@)(@@) % إلى أن تظل المضرحيات بينهم % % تدف بطانا دلحا بالحواصل % % 9(@)(@@) % وقد شمرت عن ساقها غير أنها % % تركض في ذيل من النقع ذائل % % 10(@)(@@) % قضى بين جمعيه وكم من كريهة % % قضى بين جمعيها بإحدى الفواصل % % PageV01P3823 11(@)(@@) % ألا هبلت أم المعاديه نفسه % % وأي امرىء عاداه إلا ابن هابل % 12(@)(@@) % أكفكم في الأرض أعين مائها % % وأقدامكم فيها مراسي الزلازل % % 13(@)(@@) % هم أهملونا في مصاب عيونهم % % سدى ورعونا بالقنا والقنابل % 14(@)(@@) % فأصبح شمل الناس شمل رعية % % وسربهم في العيش سرب الهوامل % 15(@)(@@) % وكم حملونا نعمة بعد نعمة % على أننا منها خفاف الكواهل % PageV01P3824 البحر : - 1(@)(@@) % ترفع إلى النجم العلي مكانه % % ونل كل ما مناه نفسك فضلها % % 2(@)(@@) % ولاتتكبر عند ذلك كله % % فوالله مانلت التي أنت أهلها % % 3(@)(@@) % عذرتك لو نلت التي أنت دونها % % من الأمر أو نلت التي أنت عدلها % % 4(@)(@@) % ولاعذر إن نلت التي أنت فوقها % % على هذه الصغرى التي قل عذلها % % 5(@)(@@) % أمثل الذي قد نلت يكبرقدره % % لدى نفسك الكبرى التي ليس مثلها % % 6(@)(@@) % ولاعذر للحال التي ضن فرعها % % علينا بما فيه إذا اشتد أصلها % % 7(@)(@@) % عهدنا لك الكف التي جل بذلها % % فلم قل لما زادك الله بذلها % % 8(@)(@@) % وما قل إلا عند عبدك وحده % % وقد جيد حزن الأرض منها وسهلها % % 9(@)(@@) % أضأت لأهل الأرض غيري وأظلمت % لذلك نفس حالف الليل رحلها % % 10(@)(@@) % وصبت على غيري فجادت بطلها % % سماؤك حتى غرق الناس هطلها % % PageV01P3825 11(@)(@@) % فأنت لعمري في العلو نظيرها % % وفي المجد مولاها وفي الحسن شكلها % % 12(@)(@@) % فجد مثل ماجادت سحابة رحمة % مطبقة عم الخلائق وبلها % % 13(@)(@@) % مضى قبلكم قوم أطاعت نفوسهم % % هواها فأداها إلى الشر نحلها % % 14(@)(@@) % وكانوا جراد الأرض يفنون ريعها % % وأنتم تمج الشهد للناس نحلها % % 15(@)(@@) % بل المثل الأعلى لكم من عصابة % غلام العلا منكم قديما وكهلها % % PageV01P3826 البحر : - 1(@)(@@) % نأمل أبا عبد الإله 
ms982	 فإنه % % هو ابن فرات شمس من يتأمل % 2(@)(@@) % علت وأضاءت للعيون وربما % % غدا كل طرف وهو عنها مفلل % % 3(@)(@@) % فلا تكن المطروف عنها وصادها % % تضيء لك والإجمال بالمرء أجمل % % 4(@)(@@) % أبو حسن ذو الحسن والخير منظرا % % ومختبرا أعلى وأسنى وأجمل % 5(@)(@@) % فما ذنبه في ذاك إن كان ربه % % قضى أنه أعلى وذو الرغم أسفل % 6(@)(@@) % ولو لم يقلد فيه غير وزيره % وغير ابنه وهو المرجى المؤمل % 7(@)(@@) % ورأيها ما لا يفيل مثله % % إذا أخطأ التوفيق رأي مفيل % 8(@)(@@) % إذا لاعدمت الشك والريب كله % فكيف ومصباح الفراتي مشعل % 9(@)(@@) % وفيه لعيني ناظر متوسم % شهود وأعلام من الفضل مثل % 10(@)(@@) % وفي ذاك ماجلى عماية عامه % % وقشعها لكن ليلك أليل % PageV01P3827 11(@)(@@) % ولو كان ليلا واحدا زال ظله % % ولكنه ليل بليل مجلل % 12(@)(@@) % دجا ليل نحس في سرار وأطبقت % عليه السواري فهو أسود أطول % % 13(@)(@@) % ومازلت ذا ظلم قديم وظلمة % من الجهل تخفى عنك أنك تجهل % 14(@)(@@) % فلا تجرحن القول فيك فإنه % % وإن لم يكن عدلا عليك معدل % 15(@)(@@) % وحسبك جهلا أن سعيت مشمرا % لتجتث أصلا تحته تتظلل % 16(@)(@@) % سعيت بمن أحياك من بعد ميتة % وأدى وفاء ماوفاه السموأل % % 17(@)(@@) % وفي بغيك البادي عليك شهادة % بأنك مطروق الدماغ مخبل % 18(@)(@@) % ولم أر ما تعتده من ذنوبه % سوى أن أبى تبديل ما لا يبدل % 19(@)(@@) % أكلفته هضم الخراج وحطمه % % لك الفيء عدوانا وأنت مؤمل % % 20(@)(@@) % فلما أبى قلت القبيح ولم تزل % % تبخل ذا الإنصاف قدما وتبخل % PageV01P3828 21(@)(@@) % وقال فقال الحق دافع لومه % % ببينة إذ لم تزل تتقول % 22(@)(@@) % وكم حاجة مقرونة بخيانة % أباها وإن سيىء امرؤ متذلل % 23(@)(@@) % وكم حاجة مستحسن حمل ثقلها % % تحمل منها فوق ما يتحمل % % 24(@)(@@) % وليس على مال الخليفة محمل % لبطل وفيه للحقائق محمل % 25(@)(@@) % أمين على مال الملوك كأنه % % حذارا ونصحا حية يتقلقل % % 26(@)(@@) % ينال بكنه اللوم كل مخفف % % عن الناس والسلطان بالحق مثقل % 27(@)(@@) % يبيت إلى أن يجمع الفيء كله % % أخا فكر مما به يتململ % 28(@)(@@) % وهل حق سلطان 
ms983	 يطالب أهله % % أبو القاسم المحتاط إلا محصل % 29(@)(@@) % ومن عتبك الغث الذي قد عتبته % % على ابن فرات موضع ليس يعقل % % 30(@)(@@) % فما صنع عبد في قضاء مليكه % وتقديره وهو المدين المحول % % PageV01P3829 31(@)(@@) % ولابدع أن ضم الوزير كفاته % % إليه وألغى اللغو والرذل يرذل % % 32(@)(@@) % رآك وقوما أشبهوك نفاية % إماطتها عند الأماثل أمثل % 33(@)(@@) % وهل ساقط وافته دولة حكمه % % وحفظ على السلطان إلا مبطل % 34(@)(@@) % وهل وثن بعد النبي محمد % % وبعد كتاب الله إلا معطل % 35(@)(@@) % فلا تلحمن الشعر عرضك إنه % % حريق هجاء ناره تتأكل % 36(@)(@@) % ولاتهدف الإقذاع سمعك إنه % % وجدك لاتبلى عليك المفضل % 37(@)(@@) % وقد قرعت من ذي أناملك العصا % % وإن راب ريب بعدها سل معول % 38(@)(@@) % وإن أنت لم تردعك رادعة النهى % % فعندي مشحوذ الغراريين مقصل % 39(@)(@@) % وإني لذو نظم ونثر كأنني % % بحديهما رمح مزج منصل % 40(@)(@@) % وإن رمت من يعنى به الحق والهوى % % فإنك مخسوف به أو مزلزل % PageV01P3830 41(@)(@@) % فلا تلحيني إن لحيتك إنني % % بنصرة إخوان الصفاء موكل % % 42(@)(@@) % تنمرت للأعداء من دون صاحبي % % وحاميت عن تاج به أتجمل % 43(@)(@@) % أبيت فلا يرعى حماه بحضرتي % % ولا لحمه ماعشت باللحم يؤكل % % 44(@)(@@) % وهبت له طوعا حفاظي وإنه % % لأوهب مني للحفاظ وأبذل % 45(@)(@@) % وإني ليحميه لساني وإنه % % لأقول مني في الخطوب وأفعل % 46(@)(@@) % وماحمسي من دونه أن رأيتني % % وإياه في الهيجاء أمضي وينكل % % 47(@)(@@) % ولكنه فرض يؤدى إلى العلا % % ونافلة من بعده تتنفل % PageV01P3831 البحر : - 1(@)(@@) % يامن سكون النفس في تأميله % وبلوغها المأمول في تأميله % 2(@)(@@) % قدري لديك مظاهر لبليتي % % فاصرف بطرفك عن جلال جليله % % 3(@)(@@) % أصبحت يحقر لي تطولك الغنى % % فتخط قدري وانس نبل نبيله % 4(@)(@@) % وابذل لعبدك ماتيسر إنه % % في حالة تقذى جفون خليله % 5(@)(@@) % ولتبلغن به الغنى لكنه % % لابد قبل غناه من تعليله % % 6(@)(@@) % لاتحقرن له التي في بذلها % % إحياء مهجته وقتل غليله % 7(@)(@@) % وافرض له من فضل كفك قوته % % واعزم إذا اتسعت على تنقيله % 8(@)(@@) % واملك عليه جماح نفسك إنها % % تأبى من المعروف غير جزيله % 9(@)(@@) % واعذره في 
ms984	 استعجاله بغياثه % لشديد حاجته إلى تعجيله % 10(@)(@@) % ولكان أوسع مهلة من غيره % % لوتحسن الحوجاء في تمهيله % PageV01P3832 11(@)(@@) % واعلم ولست معلما بحقيقة % أن النوى تأبى ازدراء ضئيله % 12(@)(@@) % كل لنوابل معونة لمناله % % عند الضرورة زينة لمنيله % % 13(@)(@@) % ليس الجواد من اشترى شمس العلا % % وحياة سمعتها بموت هزيله % % 14(@)(@@) % يامن يجود من الجدا بكثيره % ويغيث قبل كثيره بقليله % 15(@)(@@) % فاقصد لحق الرأي لاجور الهدى % % فلأنت أعلى ناظرا بجميله % % 16(@)(@@) % وعليك عند بلوغنا آمالنا % % بعريص فعلك في الورى وطويله % % 17(@)(@@) % ولكم جواد الكفه بخل سائلا % فرماه بالحرمان عن تبخيله % % 18(@)(@@) % ولربما شقي الفتى بجوداه % % ولربما حظي الفتى بنجيله % PageV01P3833 البحر : - 1(@)(@@) % لتعط الولاية من فضلها % % فتى سلف المدح في العطله % % 2(@)(@@) % فلم يؤت في المدح من جوده % % ولم يؤت من سعة المهله % % 3(@)(@@) % أتجعل شغلك غير امرىء % % جعلت مدى عمره شغله % % 4(@)(@@) % ومهما فعلت فأنكرته % % فأنت أبا الصقر في الجمله % % PageV01P3834 البحر : - 1(@)(@@) % خصيم الليالي والغواني مظلم % % وعهد الليالي والغواني مذمم % 2(@)(@@) % فظلم الليالي أنهن أشبنني % % لعشرين يحدوهن حول مجرم % % 3(@)(@@) % وظلم الغواني أنهن صرمنني % % لظلم الليالي إنني لمظلم % % 4(@)(@@) % تنكرن لي أن نكر الشيب لمتي % % وفي الشيب للسود الذرى متحرم % % 5(@)(@@) % فإن أغد محزوم السهام فربما % % غدا بي ملقى غرة الصيد مطعم % % 6(@)(@@) % ورب مهاة صدتها بين نظرتي % % ونظرتها أيام رأسي أسحم % 7(@)(@@) % أعارض مرمى الوشح غير مخاتل % فأستدرج الأقناص من حيث تعلم % % 8(@)(@@) % رأيت سواد الرأس واللهو تحته % % كليل وحلم بات رائيه ينعم % 9(@)(@@) % فلما اضمحل الليل زال نعيمه % % فلم يبق إلا عهده المتوهم % % 10(@)(@@) % وصفراء بكر لاقذاها مغيب % ولاسر من حلت حشاه مكتم % PageV01P3835 11(@)(@@) % ينم على الأمرين فرط صفائها % % وسورتها حتى يبوح المجمجم % % 12(@)(@@) % هي الورس في بيض الكؤوس وإن بدت % لعينيك في بيض الوجوه فعندم % 13(@)(@@) % يظل لها المزكوم حين يسوفها % % سحابة يوم وهو بالمسك يفعم % % 14(@)(@@) % لها لذتا طعم ورش وكأنه % % دبيب نمال في نقا بات يرهم % % 15(@)(@@) % مذاق ومسرى في العروق كلاهما % % ألذ من البرء الجديد وأنعم % 16(@)(@@) % كأنهما 
ms985	 لثم الحبيب وضمه % وقد بات منه تحت خدك معصم % 17(@)(@@) % إذا نزلت بالهم في دار أهله % غدا الهم وهو المرهق المهضم % 18(@)(@@) % أقامت ببيت النار تسعين حجة % وعشرا يصلى حولها ويزمزم % 19(@)(@@) % سقتني بها بيضاء فوها وكأسها % % شبيها مذاق عند من يتطعم % 20(@)(@@) % سقيمة طرف العين سقما بمثله % % يصاب صحيحات القلوب فتسقم % PageV01P3836 21(@)(@@) % من الهيف لو شاءت لقامت % % بكأسها وخاتمها في خصرها متختم % % 22(@)(@@) % كهم الخلي اسود فرع ومكحل % لها خلقة وابيض ثغر وملغم مص خصيم الليالي والغواني مظلم % % 23(@)(@@) % وعهد الليالي والغواني مذمم % فظلم الليالي أنهن أشبنني % % 24(@)(@@) % لعشرين يحدوهن حول مجرم % % وظلم الغواني أنهن صرمنني % % 25(@)(@@) % لظلم الليالي إنني لمظلم % % تنكرن لي أن نكر الشيب لمتي % % 26(@)(@@) % وفي الشيب للسود الذرى متحرم % % فإن أغد محزوم السهام فربما % % 27(@)(@@) % غدا بي ملقى غرة الصيد مطعم % % ورب مهاة صدتها بين نظرتي % % 28(@)(@@) % ونظرتها أيام رأسي أسحم % أعارض مرمى الوشح غير مخاتل % 29(@)(@@) % فأستدرج الأقناص من حيث تعلم % % رأيت سواد الرأس واللهو تحته % % 30(@)(@@) % كليل وحلم بات رائيه ينعم % فلما اضمحل الليل زال نعيمه % % PageV01P3837 31(@)(@@) % فلم يبق إلا عهده المتوهم % % وصفراء بكر لاقذاها مغيب % 32(@)(@@) % ولاسر من حلت حشاه مكتم % ينم على الأمرين فرط صفائها % % 33(@)(@@) % وسورتها حتى يبوح المجمجم % % هي الورس في بيض الكؤوس وإن بدت % 34(@)(@@) % لعينيك في بيض الوجوه فعندم % يظل لها المزكوم حين يسوفها % % 35(@)(@@) % سحابة يوم وهو بالمسك يفعم % % لها لذتا طعم ورش وكأنه % % 36(@)(@@) % دبيب نمال في نقا بات يرهم % % مذاق ومسرى في العروق كلاهما % % 37(@)(@@) % ألذ من البرء الجديد وأنعم % كأنهما لثم الحبيب وضمه % 38(@)(@@) % وقد بات منه تحت خدك معصم % إذا نزلت بالهم في دار أهله % 39(@)(@@) % غدا الهم وهو المرهق المهضم % أقامت ببيت النار تسعين حجة % 40(@)(@@) % وعشرا يصلى حولها ويزمزم % سقتني بها بيضاء فوها وكأسها % % PageV01P3838 41(@)(@@) % شبيها مذاق عند من يتطعم % سقيمة طرف العين سقما بمثله % % 42(@)(@@) % يصاب صحيحات القلوب فتسقم % من الهيف لو شاءت لقامت % % 43(@)(@@) % بكأسها وخاتمها في خصرها 
ms986	 متختم % % كهم الخلي اسود فرع ومكحل % 44(@)(@@) % لها خلقة وابيض ثغر وملغم % % وأشرق منها صحن خد مضرج % 45(@)(@@) % يظل بما فيه من الماء يضرم % % مفدى يسمى باسم فيها مقبلا % 46(@)(@@) % إذا قيل للخد الشتيم ملطم % % وأنى يسمى ملطما وهوملثم % 47(@)(@@) % فدى حسنه من ذاك خد ملطم % على أنه مغرى به العض مولع % 48(@)(@@) % وليس له ذنب سوى الحسن ينقم % يعض وما أسدى إلى العين شيئا % 49(@)(@@) % وليس بمظلوم وإن كان يظلم % % يظل إذا أبدى لنا منه صفحةخصيم الليالي والغواني مظلم % % 50(@)(@@) % وعهد الليالي والغواني مذمم % فظلم الليالي أنهن أشبنني % % PageV01P3839 51(@)(@@) % لعشرين يحدوهن حول مجرم % % وظلم الغواني أنهن صرمنني % % 52(@)(@@) % لظلم الليالي إنني لمظلم % % تنكرن لي أن نكر الشيب لمتي % % 53(@)(@@) % وفي الشيب للسود الذرى متحرم % % فإن أغد محزوم السهام فربما % % 54(@)(@@) % غدا بي ملقى غرة الصيد مطعم % % ورب مهاة صدتها بين نظرتي % % 55(@)(@@) % ونظرتها أيام رأسي أسحم % أعارض مرمى الوشح غير مخاتل % 56(@)(@@) % فأستدرج الأقناص من حيث تعلم % % رأيت سواد الرأس واللهو تحته % % 57(@)(@@) % كليل وحلم بات رائيه ينعم % فلما اضمحل الليل زال نعيمه % % 58(@)(@@) % فلم يبق إلا عهده المتوهم % % وصفراء بكر لاقذاها مغيب % 59(@)(@@) % ولاسر من حلت حشاه مكتم % ينم على الأمرين فرط صفائها % % 60(@)(@@) % وسورتها حتى يبوح المجمجم % % هي الورس في بيض الكؤوس وإن بدت % PageV01P3840 61(@)(@@) % لعينيك في بيض الوجوه فعندم % يظل لها المزكوم حين يسوفها % % 62(@)(@@) % سحابة يوم وهو بالمسك يفعم % % لها لذتا طعم ورش وكأنه % % 63(@)(@@) % دبيب نمال في نقا بات يرهم % % مذاق ومسرى في العروق كلاهما % % 64(@)(@@) % ألذ من البرء الجديد وأنعم % كأنهما لثم الحبيب وضمه % 65(@)(@@) % وقد بات منه تحت خدك معصم % إذا نزلت بالهم في دار أهله % 66(@)(@@) % غدا الهم وهو المرهق المهضم % أقامت ببيت النار تسعين حجة % 67(@)(@@) % وعشرا يصلى حولها ويزمزم % سقتني بها بيضاء فوها وكأسها % % 68(@)(@@) % شبيها مذاق عند من يتطعم % سقيمة طرف العين سقما بمثله % % 69(@)(@@) % يصاب صحيحات القلوب فتسقم % من الهيف لو شاءت لقامت % % 70(@)(@@) % بكأسها وخاتمها في 
ms987	 خصرها متختم % % كهم الخلي اسود فرع ومكحل % PageV01P3841 71(@)(@@) % لها خلقة وابيض ثغر وملغم % % وأشرق منها صحن خد مضرج % 72(@)(@@) % يظل بما فيه من الماء يضرم % % مفدى يسمى باسم فيها مقبلا % 73(@)(@@) % إذا قيل للخد الشتيم ملطم % % وأنى يسمى ملطما وهوملثم % 74(@)(@@) % فدى حسنه من ذاك خد ملطم % على أنه مغرى به العض مولع % 75(@)(@@) % وليس له ذنب سوى الحسن ينقم % يعض وما أسدى إلى العين شيئا % 76(@)(@@) % وليس بمظلوم وإن كان يظلم % % يظل إذا أبدى لنا منه صفحة % 77(@)(@@) % تلذ بها أبصارنا وتنعم % % نوليه أطراف الثنايا وإنه % % 78(@)(@@) % ليدمى من الألحاظ بل حين يوهم % بذاك قضى قاضي الهوى وهو ظالم % 79(@)(@@) % على الخد للعين التي هي أظلم % % ومازال في القاضي الغشوم تحامل % 80(@)(@@) % على الخصم للخصم الذي هو أغشم % تفكه منها العين عند اجتلائها % % PageV01P3842 81(@)(@@) % بفاكهة ليست يد الدهر توخم % عناقيد فردوس وتفاح جنة % 82(@)(@@) % تتوق إليها كل نفس وتقرم % % يناغيهما رمان صدر يعيذه % % 83(@)(@@) % من العين ياقوت ودر منظم % % وبين ثمار الرأس والعين عبهر % 84(@)(@@) % يضاهيه منها أقحوان مديم % % رياض وجنات يهز ثمارها % % 85(@)(@@) % ونوارها غصن ودعص مركم % % تفاوت منها الخلق في حسن صورة % 86(@)(@@) % تفاوت إبداع فراب وأهضم % وخدل وممشوق وأبيض ناصع % % 87(@)(@@) % وأسود غربيب وأقنى وأخثم % % إذا استعرضتها العين دق موشح % 88(@)(@@) % لها وربا ردف وجل مخدم % % مراكب للذات منها مضمر % 89(@)(@@) % وما مسه ضمر ومنها مطهم % % لها فرق شتى من الحسن أجمعت % 90(@)(@@) % على أن يلقى البرح منها المتيم % % أما عجب إجماع مختلفاتها % % PageV01P3843 91(@)(@@) % على قتل من لاقته لاتتأثم % % كذا السهم يصمى وهو شتى نجاره % 92(@)(@@) % حديد وريش وابن غيل مقوم % خلوت بها فردا إذا شئت علني % % 93(@)(@@) % بكأس لها ريا بنان منعم % وإن شئت ألهاني غناءان خلفة % 94(@)(@@) % فصيح ومما تنطق الطير أعجم % لدى روضة فيها النور أعين % 95(@)(@@) % ترقرق دمعا بل ثغور تبسم % يضاحك روق الشمس منها مضاحك % 96(@)(@@) % مدامعه من واقع الطل سجم % كمستعبر مستبشر بعد حزنه % 97(@)(@@) % لبين خليط قوضوا ثم خيموا 
ms988	 % % يغازلني فيها غزالان منهما % % 98(@)(@@) % ربيب الفيافي والربيب المتوم % إذا نصبا جيديهما فكلاهما % % 99(@)(@@) % سواء وإبريق لدي مفدم % ثلاثة أظب نجرها غير واحد % 100(@)(@@) % لذي اللهو فيها كلها متنعم % غزال وإبريق رذوم وغادة % % PageV01P3844 101(@)(@@) % تحرك من أوتارها وتنغم % فظبي يغنيه وظبي يعله % 102(@)(@@) % وظبي يرود التلع أو يتجرثم % لعيني مراعي شخصه فيه مأس % % 103(@)(@@) % وملهى وللمستطعم الصيد مطعم % % فقد عكفت منها عليه بما اشتهى % % 104(@)(@@) % هنالك أظآر من العيش روم % وركب قنيص قد شهدت جيادهم % % 105(@)(@@) % تحمحم في ثيران وحش تغمغم % مها كالمها إلا جبال متونها % % 106(@)(@@) % وإلا مكان الوشم أو حيث تلطم % % وإلا مخط الكحل من كل مقلة % 107(@)(@@) % وإلا قرونا تدري فتزنم % % يزنج منها الناسبون وشيظة % 108(@)(@@) % وجمهورها في الناسبين مروم % دفعنا إليها وهي زهر كأنها % % 109(@)(@@) % خلال أنيق النور نور مجسم % فما ذر قرن الشمس حتى رأيتها % % 110(@)(@@) % تعصفرها مثعنجرات تهزم % دلفنا لها بالسمهري فطالع % PageV01P3845 111(@)(@@) % إلى مصرع يرتاده ومحرجم % وقد حاولت منجى فقالت رماحنا % % 112(@)(@@) % لممعنها عرج فهذا المخيم % فلم ينجها إحضارها وهو ملهب % 113(@)(@@) % ولاذب عنها اللها وهو متأم % قرون لها منها حراب قرائن % 114(@)(@@) % ولكن خصم السمهريات يخصم % وقد طال ماذادت بها غير أنه % % 115(@)(@@) % أتيح لها رأس من الكيد مصدم % % بحيث يضم الثور والعير مرتع % 116(@)(@@) % يراعيهما فيه الأصك المصلم % % وشنت لها في آل أخدر غارة % 117(@)(@@) % كما شب ألهوب الحريق المضرم % تنادم فيها الموت أحمر قاتما % 118(@)(@@) % قريع المها والأخدري المكدم % نديمان من شتى وكأس كريهة % 119(@)(@@) % أباها من الشراب إلا المجشم % فظل لنا يوم من اللهو ممتع % 120(@)(@@) % وظل لها يوم من الشر أيوم % ورحنا على القب العتاق وكلها % % PageV01P3846 121(@)(@@) % من العلق الوحشي أقرح أرثم % تخايل منه في خضاب تخاله % % 122(@)(@@) % طلاء من الحناء قاناه بقم % كأن لها حظين مما تصيده % % 123(@)(@@) % على أنها منه مدى الدهر صوم % وأنقذ منا العفر والربد ميلنا % % 124(@)(@@) % إلى العين والحقب التي هي أوسم % وكان لنا في كل حق وباطل % 125(@)(@@) % جنوح إلى الشأن الذي 
ms989	 هو أفخم % ومعترك تبدو نجوم حديده % % 126(@)(@@) % وقد لفه ليل من النقع أطخم % شهدت القنا فيه تقصف والظبا % % 127(@)(@@) % تفلل والبيض الحصين تحطم % فلم أك ممن حاص عن غمراته % % 128(@)(@@) % ولاغاص فيها حيث غاص المغمم % ولكنني غامست خوضة هولها % % 129(@)(@@) % جهيرا شهيرا حين ضل المقرقم % ولم أغشها إلا عليما بأنها % % 130(@)(@@) % هي المجد أو مطرورة الحد صيلم % وليل غشا ليل من الدجن فوقه % PageV01P3847 131(@)(@@) % فليس لنجم في غواشيه منجم % عفا جلبه آي الهدى من سمائه % % 132(@)(@@) % وأعلامه من أرضه فهي طسيم % لبست دجاه الجون ثم هتكته % % 133(@)(@@) % بوجناء ينميها غرير وشدقم % عذافرة تنقض عن كل زجرة % 134(@)(@@) % كما انقض من ذي المنجنيق الململم % يخوض عليها لجة الهول راكب % 135(@)(@@) % هو السيف إلا أنه لا يثلم % نجيب من الفتيان فوق نجيبه % 136(@)(@@) % من العيس في يهماء والليل أيهم % فريدين يمضيها وتمضيه في الدجى % % 137(@)(@@) % كسمراء يمضيها وتمضيه لهذم % يريها الهدى حدسا وتنجو برحله % % 138(@)(@@) % ودون الهدى سد من الليل مبهم % على ظهر مرت ليس فيه معرج % 139(@)(@@) % ولكن مخب للركاب ومسعم % من اللائي تنبو بالجنوب وكلها % % 140(@)(@@) % لأيدي المهاري أملس المتن أدرم % خلاء قواء خير من مرعى مطية % % PageV01P3848 141(@)(@@) % وموردها فيه النجاء الغشمشم % ينوح به بوم وتعزف جنة % 142(@)(@@) % فيعوي لها سيد ويضبح سمسم % يخال بها من رن هذي وهذه % % 143(@)(@@) % إذا اختلف الصوتان عرس ومأتم % تعسفته إما لخفض أناله % % 144(@)(@@) % وإما سآم الخفض والخفض يسأم % وللسيف حينا مرقد في حجابه % % 145(@)(@@) % وحينا مهب صادق ومصمم % وهاجرة بيضاء يعدي بياضها % % 146(@)(@@) % سوادا كأن الوجه منه محمم % أظل إذا كافحتها وكأنني % % 147(@)(@@) % بوهاجها دون اللثام ملثم % نصبت لها مني محاسر لم تزل % 148(@)(@@) % تصلى بنيران العلا فهي سهم % بديمومة لا صل في صحصحانها % % 149(@)(@@) % ولا ماء لكن قورها الدهر عوم % ترى الآل فيها يلطم الآل مائحا % 150(@)(@@) % وبارحها المسموم للوجه ألطم % بذلك قد عللتنفسي كله % % PageV01P3849 151(@)(@@) % ولكن بنو الأيام تغدى وتفطم % سأعرض عما أعرض الدهر دونه % % 152(@)(@@) % وأشربها صرفا وإن لام لومن 
ms990	 خصيم الليالي والغواني مظلم % % وعهد الليالي والغواني مذمم % 153(@)(@@) % فظلم الليالي أنهن أشبنني % % لعشرين يحدوهن حول مجرم % % 154(@)(@@) % وظلم الغواني أنهن صرمنني % % لظلم الليالي إنني لمظلم % % 155(@)(@@) % تنكرن لي أن نكر الشيب لمتي % % وفي الشيب للسود الذرى متحرم % % 156(@)(@@) % فإن أغد محزوم السهام فربما % % غدا بي ملقى غرة الصيد مطعم % % 157(@)(@@) % ورب مهاة صدتها بين نظرتي % % ونظرتها أيام رأسي أسحم % 158(@)(@@) % أعارض مرمى الوشح غير مخاتل % فأستدرج الأقناص من حيث تعلم % % 159(@)(@@) % رأيت سواد الرأس واللهو تحته % % كليل وحلم بات رائيه ينعم % 160(@)(@@) % فلما اضمحل الليل زال نعيمه % % فلم يبق إلا عهده المتوهم % % PageV01P3850 161(@)(@@) % وصفراء بكر لاقذاها مغيب % ولاسر من حلت حشاه مكتم % 162(@)(@@) % ينم على الأمرين فرط صفائها % % وسورتها حتى يبوح المجمجم % % 163(@)(@@) % هي الورس في بيض الكؤوس وإن بدت % لعينيك في بيض الوجوه فعندم % 164(@)(@@) % يظل لها المزكوم حين يسوفها % % سحابة يوم وهو بالمسك يفعم % % 165(@)(@@) % لها لذتا طعم ورش وكأنه % % دبيب نمال في نقا بات يرهم % % 166(@)(@@) % مذاق ومسرى في العروق كلاهما % % ألذ من البرء الجديد وأنعم % 167(@)(@@) % كأنهما لثم الحبيب وضمه % وقد بات منه تحت خدك معصم % 168(@)(@@) % إذا نزلت بالهم في دار أهله % غدا الهم وهو المرهق المهضم % 169(@)(@@) % أقامت ببيت النار تسعين حجة % وعشرا يصلى حولها ويزمزم % 170(@)(@@) % سقتني بها بيضاء فوها وكأسها % % شبيها مذاق عند من يتطعم % PageV01P3851 171(@)(@@) % سقيمة طرف العين سقما بمثله % % يصاب صحيحات القلوب فتسقم % 172(@)(@@) % من الهيف لو شاءت لقامت % % بكأسها وخاتمها في خصرها متختم % % 173(@)(@@) % كهم الخلي اسود فرع ومكحل % لها خلقة وابيض ثغر وملغمه % % 174(@)(@@) % وأشرق منها صحن خد مضرج % يظل بما فيه من الماء يضرم % % 175(@)(@@) % مفدى يسمى باسم فيها مقبلا % إذا قيل للخد الشتيم ملطم % % 176(@)(@@) % وأنى يسمى ملطما وهوملثم % فدى حسنه من ذاك خد ملطم % 177(@)(@@) % على أنه مغرى به العض مولع % وليس له ذنب سوى الحسن ينقم % 178(@)(@@) % يعض وما أسدى إلى العين شيئا % وليس بمظلوم وإن كان يظلم % % 179(@)(@@) % يظل إذا أبدى لنا 
ms991	 منه صفحة % تلذ بها أبصارنا وتنعم % % 180(@)(@@) % نوليه أطراف الثنايا وإنه % % ليدمى من الألحاظ بل حين يوهم % PageV01P3852 181(@)(@@) % بذاك قضى قاضي الهوى وهو ظالم % على الخد للعين التي هي أظلم % % 182(@)(@@) % ومازال في القاضي الغشوم تحامل % على الخصم للخصم الذي هو أغشم % 183(@)(@@) % تفكه منها العين عند اجتلائها % % بفاكهة ليست يد الدهر توخم % 184(@)(@@) % عناقيد فردوس وتفاح جنة % تتوق إليها كل نفس وتقرم % % 185(@)(@@) % يناغيهما رمان صدر يعيذه % % من العين ياقوت ودر منظم % % 186(@)(@@) % وبين ثمار الرأس والعين عبهر % يضاهيه منها أقحوان مديم % % 187(@)(@@) % رياض وجنات يهز ثمارها % % ونوارها غصن ودعص مركم % % 188(@)(@@) % تفاوت منها الخلق في حسن صورة % تفاوت إبداع فراب وأهضم % 189(@)(@@) % وخدل وممشوق وأبيض ناصع % % وأسود غربيب وأقنى وأخثم % % 190(@)(@@) % إذا استعرضتها العين دق موشح % لها وربا ردف وجل مخدم % % PageV01P3853 191(@)(@@) % مراكب للذات منها مضمر % وما مسه ضمر ومنها مطهم % % 192(@)(@@) % لها فرق شتى من الحسن أجمعت % على أن يلقى البرح منها المتيم % % 193(@)(@@) % أما عجب إجماع مختلفاتها % % على قتل من لاقته لاتتأثم % % 194(@)(@@) % كذا السهم يصمى وهو شتى نجاره % حديد وريش وابن غيل مقوم % 195(@)(@@) % خلوت بها فردا إذا شئت علني % % بكأس لها ريا بنان منعم % 196(@)(@@) % وإن شئت ألهاني غناءان خلفة % فصيح ومما تنطق الطير أعجم % 197(@)(@@) % لدى روضة فيها النور أعين % ترقرق دمعا بل ثغور تبسم % 198(@)(@@) % يضاحك روق الشمس منها مضاحك % مدامعه من واقع الطل سجم % 199(@)(@@) % كمستعبر مستبشر بعد حزنه % لبين خليط قوضوا ثم خيموا % % 200(@)(@@) % يغازلني فيها غزالان منهما % % ربيب الفيافي والربيب المتوم % PageV01P3854 201(@)(@@) % إذا نصبا جيديهما فكلاهما % % سواء وإبريق لدي مفدم % 202(@)(@@) % ثلاثة أظب نجرها غير واحد % لذي اللهو فيها كلها متنعم % 203(@)(@@) % غزال وإبريق رذوم وغادة % % تحرك من أوتارها وتنغم % 204(@)(@@) % فظبي يغنيه وظبي يعله % وظبي يرود التلع أو يتجرثم % 205(@)(@@) % لعيني مراعي شخصه فيه مأس % % وملهى وللمستطعم الصيد مطعم % % 206(@)(@@) % فقد عكفت منها عليه بما اشتهى % % هنالك أظآر من العيش روم % 207(@)(@@) % وركب قنيص قد شهدت جيادهم % % تحمحم 
ms992	 في ثيران وحش تغمغم % 208(@)(@@) % مها كالمها إلا جبال متونها % % وإلا مكان الوشم أو حيث تلطم % % 209(@)(@@) % وإلا مخط الكحل من كل مقلة % وإلا قرونا تدري فتزنم % % 210(@)(@@) % يزنج منها الناسبون وشيظة % وجمهورها في الناسبين مروم % PageV01P3855 211(@)(@@) % دفعنا إليها وهي زهر كأنها % % خلال أنيق النور نور مجسم % 212(@)(@@) % فما ذر قرن الشمس حتى رأيتها % % تعصفرها مثعنجرات تهزم % 213(@)(@@) % دلفنا لها بالسمهري فطالع % إلى مصرع يرتاده ومحرجم % 214(@)(@@) % وقد حاولت منجى فقالت رماحنا % % لممعنها عرج فهذا المخيم % 215(@)(@@) % فلم ينجها إحضارها وهو ملهب % ولاذب عنها اللها وهو متأم % 216(@)(@@) % قرون لها منها حراب قرائن % ولكن خصم السمهريات يخصم % 217(@)(@@) % وقد طال ماذادت بها غير أنه % % أتيح لها رأس من الكيد مصدم % % 218(@)(@@) % بحيث يضم الثور والعير مرتع % يراعيهما فيه الأصك المصلم % % 219(@)(@@) % وشنت لها في آل أخدر غارة % كما شب ألهوب الحريق المضرم % 220(@)(@@) % تنادم فيها الموت أحمر قاتما % قريع المها والأخدري المكدم % PageV01P3856 221(@)(@@) % نديمان من شتى وكأس كريهة % أباها من الشراب إلا المجشم % 222(@)(@@) % فظل لنا يوم من اللهو ممتع % وظل لها يوم من الشر أيوم % 223(@)(@@) % ورحنا على القب العتاق وكلها % % من العلق الوحشي أقرح أرثم % 224(@)(@@) % تخايل منه في خضاب تخاله % % طلاء من الحناء قاناه بقم % 225(@)(@@) % كأن لها حظين مما تصيده % % على أنها منه مدى الدهر صوم % 226(@)(@@) % وأنقذ منا العفر والربد ميلنا % % إلى العين والحقب التي هي أوسم % 227(@)(@@) % وكان لنا في كل حق وباطل % جنوح إلى الشأن الذي هو أفخم % 228(@)(@@) % ومعترك تبدو نجوم حديده % % وقد لفه ليل من النقع أطخم % 229(@)(@@) % شهدت القنا فيه تقصف والظبا % % تفلل والبيض الحصين تحطم % 230(@)(@@) % فلم أك ممن حاص عن غمراته % % ولاغاص فيها حيث غاص المغمم % PageV01P3857 231(@)(@@) % ولكنني غامست خوضة هولها % % جهيرا شهيرا حين ضل المقرقم % 232(@)(@@) % ولم أغشها إلا عليما بأنها % % هي المجد أو مطرورة الحد صيلم % 233(@)(@@) % وليل غشا ليل من الدجن فوقه % فليس لنجم في غواشيه منجم % 234(@)(@@) % عفا جلبه آي الهدى من سمائه % % وأعلامه 
ms993	 من أرضه فهي طسيم % 235(@)(@@) % لبست دجاه الجون ثم هتكته % % بوجناء ينميها غرير وشدقم % 236(@)(@@) % عذافرة تنقض عن كل زجرة % كما انقض من ذي المنجنيق الململم % 237(@)(@@) % يخوض عليها لجة الهول راكب % هو السيف إلا أنه لا يثلم % 238(@)(@@) % نجيب من الفتيان فوق نجيبه % من العيس في يهماء والليل أيهم % 239(@)(@@) % فريدين يمضيها وتمضيه في الدجى % % كسمراء يمضيها وتمضيه لهذم % 240(@)(@@) % يريها الهدى حدسا وتنجو برحله % % ودون الهدى سد من الليل مبهم % PageV01P3858 241(@)(@@) % على ظهر مرت ليس فيه معرج % ولكن مخب للركاب ومسعم % 242(@)(@@) % من اللائي تنبو بالجنوب وكلها % % لأيدي المهاري أملس المتن أدرم % 243(@)(@@) % خلاء قواء خير من مرعى مطية % % وموردها فيه النجاء الغشمشم % 244(@)(@@) % ينوح به بوم وتعزف جنة % فيعوي لها سيد ويضبح سمسم % 245(@)(@@) % يخال بها من رن هذي وهذه % % إذا اختلف الصوتان عرس ومأتم % 246(@)(@@) % تعسفته إما لخفض أناله % % وإما سآم الخفض والخفض يسأم % 247(@)(@@) % وللسيف حينا مرقد في حجابه % % وحينا مهب صادق ومصمم % 248(@)(@@) % وهاجرة بيضاء يعدي بياضها % % سوادا كأن الوجه منه محمم % 249(@)(@@) % أظل إذا كافحتها وكأنني % % بوهاجها دون اللثام ملثم % 250(@)(@@) % نصبت لها مني محاسر لم تزل % تصلى بنيران العلا فهي سهم % PageV01P3859 251(@)(@@) % بديمومة لا صل في صحصحانها % % ولا ماء لكن قورها الدهر عوم % 252(@)(@@) % ترى الآل فيها يلطم الآل مائحا % وبارحها المسموم للوجه ألطم % 253(@)(@@) % بذلك قد عللتنفسي كله % % ولكن بنو الأيام تغدى وتفطم % 254(@)(@@) % سأعرض عما أعرض الدهر دونه % % وأشربها صرفا وإن لام لوم % 255(@)(@@) % أعمهم مدحا وأختص منهم % وأخاهم عبيد الله والحق يلزم % 256(@)(@@) % فتى منهم في فضله متقدم % على أنه في سنه متقدم % 257(@)(@@) % يعد إذا عد الملوك مبدأ % كما عد رأسا للشهور المحرم % 258(@)(@@) % له في المعالي والمكارم إخوة % وليس له فيها على ذاك توأم % 259(@)(@@) % بنى بالمساعي سؤددا لا يزيله % صروف الليالي أويزول يلملم % 260(@)(@@) % فتى لا أسميه فتى لحداثة % ولكن لأخلاق له لاتكهم % PageV01P3860 261(@)(@@) % من الأريحيات التي تمترى الندى % % فتندى وتلقى عمرة فتقحم % 262(@)(@@) % إذا النعل 
ms994	 شمت في المجالس مرة % فإن له نعلا تشم وتلثم % 263(@)(@@) % وما دبغت بالمسك بل صوفحت به % % له قدم في كل مجد تقدم % % 264(@)(@@) % فتى ليس من يوم يمر ولا يرى % % لنعماه فيه أو لبؤساء ميسم % 265(@)(@@) % يمر العطايا والمنايا لأهلها % % على هينة منه ولا يتندم % 266(@)(@@) % له فعلات من سماح ونجدة % لمن يعتفي عرفا ومن يتعرم % 267(@)(@@) % يقوم لها المال المؤثل والعدى % % إذا قام للنار الحصاد المحزم % 268(@)(@@) % فتى عزمه سيف حسام وسيفه % % قضاء إذا لاقى الضريبة مبرم % 269(@)(@@) % يباشر أطراف القنا وهو حاسر % ويلقى لسان الذم وهو ملأم % 270(@)(@@) % مقبل ظهر الكف وهاب بطنها % % له راحة فيها الحطيم وزمزم % PageV01P3861 271(@)(@@) % فظاهرها للناس ركن مقبل % وباطنها عين من العرف غيلم % 272(@)(@@) % فتى لو رأى الناس الأمور بعينه % لما جهلوا أن المحامد مغنم % 273(@)(@@) % يدل عليه السائلين ارتياحه % ووجه بسيما الأكرمين مسوم % 274(@)(@@) % إذا سئل استحيا من الله أن يرى % % بموضع مرجو وراجيه يحرم % 275(@)(@@) % يرى شر يومي ماله يوم كسبه % وأفضل يوميه إذا ناب مغرم % 276(@)(@@) % فتى حسنت أسماؤه وصفاته % % فأضحت بها أيدي الكواعب توشم % 277(@)(@@) % ولو وسم الناس الجباه بمدحه % إذا لاستلذوا الوسم والوسم يؤلم % 278(@)(@@) % إذا ما أسرت أنفس القوم ذكره % % تبينته فيهم ولم يتكلموا % % 279(@)(@@) % تطيب به أنفاسه فتذيعه % وهل سر مسك أودع الريح يكتم % % 280(@)(@@) % فتى كملت فيه الفضائل كلها % % هنيئا له الحظ الوفاء المتمم % PageV01P3862 281(@)(@@) % فلاة خلة منها أضرت بخلة % % على أنه في كلها متقسم % 282(@)(@@) % وما اقتسمت شتى الفضائل واحدا % فكاد من التقصير فيهن يسلم % 283(@)(@@) % إلى أي مافيه قصدت حسبته % % هو الغرض المقصود فيه الميمم % 284(@)(@@) % لينظم فيه ذلك الدر سلكت % مريرته والدر في السلك ينظم % 285(@)(@@) % خلال جفا عنها الجفاة خلائفا % وخلقا وهل للدر في الحبل منظم % 286(@)(@@) % ومازال عبد الله يعلم أنه % % قديما لهاتيك الشناشن أخزم % 287(@)(@@) % تبين فيه وهو في المهد أنه % % سيرفع من بنيانه وسيدعم % 288(@)(@@) % وأن سوف يحييه بماهو فاعل % إذا هو واراه الضريح المطمطم % 289(@)(@@) % لذلك أقفاه 
ms995	 وسماه باسمه % % وفي الحق يقفى مثله ويكرم % 290(@)(@@) % وماكان لاستصغاره اسمه % أبى ذاك من معناه فخم مفخم % PageV01P3863 291(@)(@@) % ولكن أسماء الأحبة لم تزل % تصغر في أهليهم وترخم % 292(@)(@@) % وماضر من أضحى له اسم مصغر % ومعنى مجل في الصدور معظم % 293(@)(@@) % هو الغرة البيضاء من آل مصعب % % وهم بعده التحجيل والناس أدهم % 294(@)(@@) % لتفتر عنه في مواطن جمة % رزيق فما مفترها عنه أهتم % % 295(@)(@@) % كفاها به من مضحك يوم زينة % % ومن مكلح في الحرب حين تجهم % 296(@)(@@) % ثنايا لعمري وضح لا يشينها % % وناب عضاض مقصل حين يضغم % 297(@)(@@) % ألكني إلى عمرو بن ليث رسالة % لها حين يدوى الغيب غيب مسلم % 298(@)(@@) % فإنا غدونا نحمد الله أولا % فواتح من حمد بحمدك تختم % 299(@)(@@) % على نعمة ألبستناها جديدة % هي الوشي حسنا والحبير المنمنم % 300(@)(@@) % لك المسمع المصغى إليه إذا غدت % % لبوسا لنا والمنظر المتوسم % PageV01P3864 301(@)(@@) % رعيت سدانا بالأمير فكلنا % % بذلك ممنون عليه ومنعم % 302(@)(@@) % توخى بنا المرعى المرىء نباته % % وجنبنا المرعى الذي يتوخم % 303(@)(@@) % وذب الذئاب الطلس عنا فأصبحت % ومنها طريد الخوف والمتحرم % % 304(@)(@@) % وأثبت للأمر الذي يستديمه % % أواخي صدق أقسمت لاتجذم مص خصيم الليالي والغواني مظلم % % 305(@)(@@) % وعهد الليالي والغواني مذمم % فظلم الليالي أنهن أشبنني % % 306(@)(@@) % لعشرين يحدوهن حول مجرم % % وظلم الغواني أنهن صرمنني % % 307(@)(@@) % لظلم الليالي إنني لمظلم % % تنكرن لي أن نكر الشيب لمتي % % 308(@)(@@) % وفي الشيب للسود الذرى متحرم % % فإن أغد محزوم السهام فربما % % 309(@)(@@) % غدا بي ملقى غرة الصيد مطعم % % ورب مهاة صدتها بين نظرتي % % 310(@)(@@) % ونظرتها أيام رأسي أسحم % أعارض مرمى الوشح غير مخاتل % PageV01P3865 311(@)(@@) % فأستدرج الأقناص من حيث تعلم % % رأيت سواد الرأس واللهو تحته % % 312(@)(@@) % كليل وحلم بات رائيه ينعم % فلما اضمحل الليل زال نعيمه % % 313(@)(@@) % فلم يبق إلا عهده المتوهم % % وصفراء بكر لاقذاها مغيب % 314(@)(@@) % ولاسر من حلت حشاه مكتم % ينم على الأمرين فرط صفائها % % 315(@)(@@) % وسورتها حتى يبوح المجمجم % % هي الورس في بيض الكؤوس وإن بدت % 316(@)(@@) % لعينيك في بيض الوجوه فعندم % يظل لها المزكوم 
ms996	 حين يسوفها % % 317(@)(@@) % سحابة يوم وهو بالمسك يفعم % % لها لذتا طعم ورش وكأنه % % 318(@)(@@) % دبيب نمال في نقا بات يرهم % % مذاق ومسرى في العروق كلاهما % % 319(@)(@@) % ألذ من البرء الجديد وأنعم % كأنهما لثم الحبيب وضمه % 320(@)(@@) % وقد بات منه تحت خدك معصم % إذا نزلت بالهم في دار أهله % PageV01P3866 321(@)(@@) % غدا الهم وهو المرهق المهضم % أقامت ببيت النار تسعين حجة % 322(@)(@@) % وعشرا يصلى حولها ويزمزم % سقتني بها بيضاء فوها وكأسها % % 323(@)(@@) % شبيها مذاق عند من يتطعم % سقيمة طرف العين سقما بمثله % % 324(@)(@@) % يصاب صحيحات القلوب فتسقم % من الهيف لو شاءت لقامت % % 325(@)(@@) % بكأسها وخاتمها في خصرها متختم % % كهم الخلي اسود فرع ومكحل % 326(@)(@@) % لها خلقة وابيض ثغر وملغم % % وأشرق منها صحن خد مضرج % 327(@)(@@) % يظل بما فيه من الماء يضرم % % مفدى يسمى باسم فيها مقبلا % 328(@)(@@) % إذا قيل للخد الشتيم ملطم % % وأنى يسمى ملطما وهوملثم % 329(@)(@@) % فدى حسنه من ذاك خد ملطم % على أنه مغرى به العض مولع % 330(@)(@@) % وليس له ذنب سوى الحسن ينقم % يعض وما أسدى إلى العين شيئا % PageV01P3867 331(@)(@@) % وليس بمظلوم وإن كان يظلم % % يظل إذا أبدى لنا منه صفحة % 332(@)(@@) % تلذ بها أبصارنا وتنعم % % نوليه أطراف الثنايا وإنه % % 333(@)(@@) % ليدمى من الألحاظ بل حين يوهم % بذاك قضى قاضي الهوى وهو ظالم % 334(@)(@@) % على الخد للعين التي هي أظلم % % ومازال في القاضي الغشوم تحامل % 335(@)(@@) % على الخصم للخصم الذي هو أغشم % تفكه منها العين عند اجتلائها % % 336(@)(@@) % بفاكهة ليست يد الدهر توخم % عناقيد فردوس وتفاح جنة % 337(@)(@@) % تتوق إليها كل نفس وتقرم % % يناغيهما رمان صدر يعيذه % % 338(@)(@@) % من العين ياقوت ودر منظم % % وبين ثمار الرأس والعين عبهر % 339(@)(@@) % يضاهيه منها أقحوان مديم % % رياض وجنات يهز ثمارها % % 340(@)(@@) % ونوارها غصن ودعص مركم % % تفاوت منها الخلق في حسن صورة % PageV01P3868 341(@)(@@) % تفاوت إبداع فراب وأهضم % وخدل وممشوق وأبيض ناصع % % 342(@)(@@) % وأسود غربيب وأقنى وأخثم % % إذا استعرضتها العين دق موشح % 343(@)(@@) % لها وربا ردف وجل مخدم % % مراكب للذات منها مضمر % 344(@)(@@) % وما 
ms997	 مسه ضمر ومنها مطهم % % لها فرق شتى من الحسن أجمعت % 345(@)(@@) % على أن يلقى البرح منها المتيم % % أما عجب إجماع مختلفاتها % % 346(@)(@@) % على قتل من لاقته لاتتأثم % % كذا السهم يصمى وهو شتى نجاره % 347(@)(@@) % حديد وريش وابن غيل مقوم % خلوت بها فردا إذا شئت علني % % 348(@)(@@) % بكأس لها ريا بنان منعم % وإن شئت ألهاني غناءان خلفة % 349(@)(@@) % فصيح ومما تنطق الطير أعجم % لدى روضة فيها النور أعين % 350(@)(@@) % ترقرق دمعا بل ثغور تبسم % يضاحك روق الشمس منها مضاحك % PageV01P3869 351(@)(@@) % مدامعه من واقع الطل سجم % كمستعبر مستبشر بعد حزنه % 352(@)(@@) % لبين خليط قوضوا ثم خيموا % % يغازلني فيها غزالان منهما % % 353(@)(@@) % ربيب الفيافي والربيب المتوم % إذا نصبا جيديهما فكلاهما % % 354(@)(@@) % سواء وإبريق لدي مفدم % ثلاثة أظب نجرها غير واحد % 355(@)(@@) % لذي اللهو فيها كلها متنعم % غزال وإبريق رذوم وغادة % % 356(@)(@@) % تحرك من أوتارها وتنغم % فظبي يغنيه وظبي يعله % 357(@)(@@) % وظبي يرود التلع أو يتجرثم % لعيني مراعي شخصه فيه مأس % % 358(@)(@@) % وملهى وللمستطعم الصيد مطعم % % فقد عكفت منها عليه بما اشتهى % % 359(@)(@@) % هنالك أظآر من العيش روم % وركب قنيص قد شهدت جيادهم % % 360(@)(@@) % تحمحم في ثيران وحش تغمغم % مها كالمها إلا جبال متونها % % PageV01P3870 361(@)(@@) % وإلا مكان الوشم أو حيث تلطم % % وإلا مخط الكحل من كل مقلة % 362(@)(@@) % وإلا قرونا تدري فتزنم % % يزنج منها الناسبون وشيظة % 363(@)(@@) % وجمهورها في الناسبين مروم % دفعنا إليها وهي زهر كأنها % % 364(@)(@@) % خلال أنيق النور نور مجسم % فما ذر قرن الشمس حتى رأيتها % % 365(@)(@@) % تعصفرها مثعنجرات تهزم % دلفنا لها بالسمهري فطالع % 366(@)(@@) % إلى مصرع يرتاده ومحرجم % وقد حاولت منجى فقالت رماحنا % % 367(@)(@@) % لممعنها عرج فهذا المخيم % فلم ينجها إحضارها وهو ملهب % 368(@)(@@) % ولاذب عنها اللها وهو متأم % قرون لها منها حراب قرائن % 369(@)(@@) % ولكن خصم السمهريات يخصم % وقد طال ماذادت بها غير أنه % % 370(@)(@@) % أتيح لها رأس من الكيد مصدم % % بحيث يضم الثور والعير مرتع % PageV01P3871 371(@)(@@) % يراعيهما فيه الأصك المصلم % % وشنت لها في آل أخدر غارة % 372(@)(@@) % كما شب 
ms998	 ألهوب الحريق المضرم % تنادم فيها الموت أحمر قاتما % 373(@)(@@) % قريع المها والأخدري المكدم % نديمان من شتى وكأس كريهة % 374(@)(@@) % أباها من الشراب إلا المجشم % فظل لنا يوم من اللهو ممتع % 375(@)(@@) % وظل لها يوم من الشر أيوم % ورحنا على القب العتاق وكلها % % 376(@)(@@) % من العلق الوحشي أقرح أرثم % تخايل منه في خضاب تخاله % % 377(@)(@@) % طلاء من الحناء قاناه بقم % كأن لها حظين مما تصيده % % 378(@)(@@) % على أنها منه مدى الدهر صوم % وأنقذ منا العفر والربد ميلنا % % 379(@)(@@) % إلى العين والحقب التي هي أوسم % وكان لنا في كل حق وباطل % 380(@)(@@) % جنوح إلى الشأن الذي هو أفخم % ومعترك تبدو نجوم حديده % % PageV01P3872 381(@)(@@) % وقد لفه ليل من النقع أطخم % شهدت القنا فيه تقصف والظبا % % 382(@)(@@) % تفلل والبيض الحصين تحطم % فلم أك ممن حاص عن غمراته % % 383(@)(@@) % ولاغاص فيها حيث غاص المغمم % ولكنني غامست خوضة هولها % % 384(@)(@@) % جهيرا شهيرا حين ضل المقرقم % ولم أغشها إلا عليما بأنها % % 385(@)(@@) % هي المجد أو مطرورة الحد صيلم % وليل غشا ليل من الدجن فوقه % 386(@)(@@) % فليس لنجم في غواشيه منجم % عفا جلبه آي الهدى من سمائه % % 387(@)(@@) % وأعلامه من أرضه فهي طسيم % لبست دجاه الجون ثم هتكته % % 388(@)(@@) % بوجناء ينميها غرير وشدقم % عذافرة تنقض عن كل زجرة % 389(@)(@@) % كما انقض من ذي المنجنيق الململم % يخوض عليها لجة الهول راكب % 390(@)(@@) % هو السيف إلا أنه لا يثلم % نجيب من الفتيان فوق نجيبه % PageV01P3873 391(@)(@@) % من العيس في يهماء والليل أيهم % فريدين يمضيها وتمضيه في الدجى % % 392(@)(@@) % كسمراء يمضيها وتمضيه لهذم % يريها الهدى حدسا وتنجو برحله % % 393(@)(@@) % ودون الهدى سد من الليل مبهم % على ظهر مرت ليس فيه معرج % 394(@)(@@) % ولكن مخب للركاب ومسعم % من اللائي تنبو بالجنوب وكلها % % 395(@)(@@) % لأيدي المهاري أملس المتن أدرم % خلاء قواء خير من مرعى مطية % % 396(@)(@@) % وموردها فيه النجاء الغشمشم % ينوح به بوم وتعزف جنة % 397(@)(@@) % فيعوي لها سيد ويضبح سمسم % يخال بها من رن هذي وهذه % % 398(@)(@@) % إذا اختلف الصوتان عرس ومأتم % تعسفته 
ms999	 إما لخفض أناله % % 399(@)(@@) % وإما سآم الخفض والخفض يسأم % وللسيف حينا مرقد في حجابه % % 400(@)(@@) % وحينا مهب صادق ومصمم % وهاجرة بيضاء يعدي بياضها % % PageV01P3874 401(@)(@@) % سوادا كأن الوجه منه محمم % أظل إذا كافحتها وكأنني % % 402(@)(@@) % بوهاجها دون اللثام ملثم % نصبت لها مني محاسر لم تزل % 403(@)(@@) % تصلى بنيران العلا فهي سهم % بديمومة لا صل في صحصحانها % % 404(@)(@@) % ولا ماء لكن قورها الدهر عوم % ترى الآل فيها يلطم الآل مائحا % 405(@)(@@) % وبارحها المسموم للوجه ألطم % بذلك قد عللتنفسي كله % % 406(@)(@@) % ولكن بنو الأيام تغدى وتفطم % سأعرض عما أعرض الدهر دونه % % 407(@)(@@) % وأشربها صرفا وإن لام لوم % أعمهم مدحا وأختص منهم % 408(@)(@@) % وأخاهم عبيد الله والحق يلزم % فتى منهم في فضله متقدم % 409(@)(@@) % على أنه في سنه متقدم % يعد إذا عد الملوك مبدأ % 410(@)(@@) % كما عد رأسا للشهور المحرم % له في المعالي والمكارم إخوة % PageV01P3875 411(@)(@@) % وليس له فيها على ذاك توأم % بنى بالمساعي سؤددا لا يزيله % 412(@)(@@) % صروف الليالي أويزول يلملم % فتى لا أسميه فتى لحداثة % 413(@)(@@) % ولكن لأخلاق له لاتكهم % من الأريحيات التي تمترى الندى % % 414(@)(@@) % فتندى وتلقى عمرة فتقحم % إذا النعل شمت في المجالس مرة % 415(@)(@@) % فإن له نعلا تشم وتلثم % وما دبغت بالمسك بل صوفحت به % % 416(@)(@@) % له قدم في كل مجد تقدم % % فتى ليس من يوم يمر ولا يرى % % 417(@)(@@) % لنعماه فيه أو لبؤساء ميسم % يمر العطايا والمنايا لأهلها % % 418(@)(@@) % على هينة منه ولا يتندم % له فعلات من سماح ونجدة % 419(@)(@@) % لمن يعتفي عرفا ومن يتعرم % يقوم لها المال المؤثل والعدى % % 420(@)(@@) % إذا قام للنار الحصاد المحزم % فتى عزمه سيف حسام وسيفه % % PageV01P3876 421(@)(@@) % قضاء إذا لاقى الضريبة مبرم % يباشر أطراف القنا وهو حاسر % 422(@)(@@) % ويلقى لسان الذم وهو ملأم % مقبل ظهر الكف وهاب بطنها % % 423(@)(@@) % له راحة فيها الحطيم وزمزم % فظاهرها للناس ركن مقبل % 424(@)(@@) % وباطنها عين من العرف غيلم % فتى لو رأى الناس الأمور بعينه % 425(@)(@@) % لما جهلوا أن المحامد مغنم % يدل عليه السائلين ارتياحه % 426(@)(@@) % ووجه بسيما 
ms1000	 الأكرمين مسوم % إذا سئل استحيا من الله أن يرى % % 427(@)(@@) % بموضع مرجو وراجيه يحرم % يرى شر يومي ماله يوم كسبه % 428(@)(@@) % وأفضل يوميه إذا ناب مغرم % فتى حسنت أسماؤه وصفاته % % 429(@)(@@) % فأضحت بها أيدي الكواعب توشم % ولو وسم الناس الجباه بمدحه % 430(@)(@@) % إذا لاستلذوا الوسم والوسم يؤلم % إذا ما أسرت أنفس القوم ذكره % % PageV01P3877 431(@)(@@) % تبينته فيهم ولم يتكلموا % % تطيب به أنفاسه فتذيعه % 432(@)(@@) % وهل سر مسك أودع الريح يكتم % % فتى كملت فيه الفضائل كلها % % 433(@)(@@) % هنيئا له الحظ الوفاء المتمم % فلاة خلة منها أضرت بخلة % % 434(@)(@@) % على أنه في كلها متقسم % وما اقتسمت شتى الفضائل واحدا % 435(@)(@@) % فكاد من التقصير فيهن يسلم % إلى أي مافيه قصدت حسبته % % 436(@)(@@) % هو الغرض المقصود فيه الميمم % لينظم فيه ذلك الدر سلكت % 437(@)(@@) % مريرته والدر في السلك ينظم % خلال جفا عنها الجفاة خلائفا % 438(@)(@@) % وخلقا وهل للدر في الحبل منظم % ومازال عبد الله يعلم أنه % % 439(@)(@@) % قديما لهاتيك الشناشن أخزم % تبين فيه وهو في المهد أنه % % 440(@)(@@) % سيرفع من بنيانه وسيدعم % وأن سوف يحييه بماهو فاعل % PageV01P3878 441(@)(@@) % إذا هو واراه الضريح المطمطم % لذلك أقفاه وسماه باسمه % % 442(@)(@@) % وفي الحق يقفى مثله ويكرم % وماكان لاستصغاره اسمه % 443(@)(@@) % أبى ذاك من معناه فخم مفخم % ولكن أسماء الأحبة لم تزل % 444(@)(@@) % تصغر في أهليهم وترخم % وماضر من أضحى له مصغر % 445(@)(@@) % ومعنى مجل في الصدور معظم % هو الغرة البيضاء من آل مصعب % % 446(@)(@@) % وهم بعده التحجيل والناس أدهم % لتفتر عنه في مواطن جمة % 447(@)(@@) % رزيق فما مفترها عنه أهتم % % كفاها به من مضحك يوم زينة % % 448(@)(@@) % ومن مكلح في الحرب حين تجهم % ثنايا لعمري وضح لا يشينها % % 449(@)(@@) % وناب عضاض مقصل حين يضغم % ألكني إلى عمرو بن ليث رسالة % 450(@)(@@) % لها حين يدوى الغيب غيب مسلم % فإنا غدونا نحمد الله أولا % PageV01P3879 451(@)(@@) % فواتح من حمد بحمدك تختم % على نعمة ألبستناها جديدة % 452(@)(@@) % هي الوشي حسنا والحبير المنمنم % لك المسمع المصغى إليه إذا غدت % % 453(@)(@@) % لبوسا لنا والمنظر 