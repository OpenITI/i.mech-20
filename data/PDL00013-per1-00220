ms201	 نعمت است ده گونه %~% وز منت مدحت است ده دفتر(@)(@@) 28 بر من آن کرده ای در این زندان %~% که شد اندر میان خلق سمر(@)(@@) 29 مر مرا از عطای تو این جا %~% هست هر گونه نعمتی بی مر(@)(@@) 30 تنگ بر تنگ جامه دارم و فرش %~% بدره بر بدره سیم دارم و زر(@)(@@) 31 لیکن از درد و رنج و بیماری %~% جانم افتاده در نهیب و خطر(@)(@@) 32 به خدای ار همی شود ممکن %~% که بگردم ز ضعف بر بستر(@)(@@) 33 دل من خون شده ز خون شکم %~% اشک من خون شده ز خون جگر(@)(@@) 34 تنم از رنج تافته چو رسن %~% پشتم از باد درد چون چنبر(@)(@@) 35 گشته غرقه ز اشک چون کشتی %~% مانده ساکن ز بند چون لنگر(@)(@@) 36 متردد چو ناروان خامه %~% متحیر چو بی روان پیکر(@)(@@) 37 دل بریان من پر اندیشه %~% دیده را بسته بر بلای سهر(@)(@@) 38 زان که من داشتم همه محفوظ %~% جز ثنای توام نماند از بر(@)(@@) 39 دهن من طعم زهر شدست %~% وندر او مدح تو به ذوق شکر(@)(@@) 40 کرده خوشبوی روزگار مرا %~% آتش دل چو آتش مجمر(@)(@@) 41 این همه هست و تن ز بیماری %~% مانده اندر عقوبتی منکر(@)(@@) 42 چون همه حال خود چنین بینم %~% زنده بودن نیایدم باور(@)(@@) 43 چون مرا در نوشت گردش چرخ %~% شخص من شد به زیر خاک اندر(@)(@@) 44 والله ار چون منی دگر بینی %~% به همه نوع در کمال و هنر(@)(@@) 45 شکرهای تو در نوشته به جان %~% می برم پیش ایزد داور PageV1P134(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 رسید عید و ز ما ماه روزه کرد گذر %~% وداع باید کردش که کرد رای سفر(@)(@@) 2 به ما مقدمه عید فر خجسته رسید %~% براند روزه فرخنده ساقه لشکر(@)(@@) 3 برفت زود ز نزدیک ما و نیست شگفت %~% که زودتر رود آن چیز کو گرامی تر(@)(@@) 4 مه صیام درختی است بار او رحمت 
ms202	 %~% به آب زهد توان خورد هم ز شاخش بر(@)(@@) 5 بزرگوار مها و خجسته ایاما %~% چه گفت خواهی از ما به خالق اکبر(@)(@@) 6 نداشتیم تو را آنچنان که واجب بود %~% شدی و ماند حقت خلق را به گردن بر(@)(@@) 7 حقت شناخت که داند چنانکه هست روا %~% بسرت برد که داند چنانکه برد به سر(@)(@@) 8 امیر غازی محمود سیف دولت و دین %~% خدایگان جهاندار خسرو صفدر(@)(@@) 9 مظفری ملکی کش ملوک روی زمین %~% همی ببوسند از بندگی رکاب به زر(@)(@@) 10 سپهر خواست که باشد مظفر و میمون %~% ستاره خواست که باشدش گوهر افسر(@)(@@) 11 از آن سپهر بر افراخت همچو ایوانش %~% وز آن ستاره فروزنده گشت همچو گهر(@)(@@) 12 بدان سبب که فلک پاره ای ز همت اوست %~% همی نگردد قادر بر او قضا و قدر(@)(@@) 13 زمین ز سم پی پیل کوه پیکر او %~% همی بلرزد ز آن ساخت کوه را لنگر(@)(@@) 14 وز آن که گوهر بر افسرش همی باشد %~% شده است تابش خورشید دایه گوهر(@)(@@) 15 خدایگانا آمد مه صیام و گذشت %~% تو شادمانه بمان در جلالت و مگذر(@)(@@) 16 به کامگاری و دولت به تخت ملک نشین %~% به شادمانی و رامش بساط لهو سیر(@)(@@) 17 گذاردی حق روزه چنانکه واجب بود %~% به حاصل آمد خشنودی ایزد داور(@)(@@) 18 خجسته باشد شب قدرو روز نو از تو %~% هر آنچه کردی پذیرفته درگه محشر PageV1P135(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای یل هامون نورد ای سرکش جیحون گذار %~% از تو جیحون گشت هامون روز جنگ و وقت کار(@)(@@) 2 عزم تو در هر نخیزی آتشین راند سپاه %~% حزم تو در هر مقامی آهنین دارد حصار(@)(@@) 3 مانده گرد از باره تو خاره را در سنگلاخ %~% گشته خون از خنجر تو آب در هر جویبار(@)(@@) 4 تا تو نافذ حکم و مطلق دست گشتی در عمل %~% بیش یک ساعت ندیدند از برای کارزار(@)(@@) 5 درعها ذل مضیق و خودها 
ms203	 رنج غلاف %~% تیغ ها حبس نیام و مرکبان بند جدار(@)(@@) 6 زآن نهنگ کوه شخص وز آن هژبر چرخ دور %~% زآن هیون ابر سر وز آن عقاب باد سار(@)(@@) 7 کوه با مغز کفیده چرخ بار روی سیه %~% ابر با پر شکسته باد با پای فگار(@)(@@) 8 رودها کوبی به روز و بیشه ها مالی به شب %~% روزهای روشن دشمن کنی شبهای تار(@)(@@) 9 کرده بدرود و فرامش رامش و عشرت تمام %~% نه هوای رود و ساز و نه نشاط می گسار(@)(@@) 10 داستان رزم های تو کند باطل همی %~% در زمانه داستان رستم و اسفندیار(@)(@@) 11 یک شب از دهگان به چالندر کشیدی لشکری %~% چون زمانه زورمند و چون قضا کینه گذار(@)(@@) 12 در هوا بگداخت ابر از تاب تیغ تو چو موم %~% بر زمین بشکافت کوه از نعل رخش تو چو نار(@)(@@) 13 کوهها در هم شکستند ابرها بر هم زدند %~% تازیان اندر عنان و بختیان اندر مهار(@)(@@) 14 پویه کردند از ره باریک بر شمشیر تیز %~% غوطه خوردند از شب تاریک در دریای قار(@)(@@) 15 ابرها بردی ز گرد اندر سر هر تند شخ %~% رودها راندی ز خون اندربن هر ژرف غار(@)(@@) 16 کوفتی بر خطه ناکوفته هرگز بران %~% بادهای تیز قوت ابرهای تند بار(@)(@@) 17 چون علم های گشاده بندهای سبز سوز %~% با سنان های کشنده شاخ های تیز خار(@)(@@) 18 لشکر یأجوج رخنه ساخته بر کوهسار %~% راست چو سد سکندر حصن های استوار(@)(@@) 19 شخص هاشان برده از خلقت نهاد نارون %~% مغزهاشان خورده از غفلت شراب کوکنار(@)(@@) 20 آب خورده با هژبران بر سر هر آبگیر %~% خواب کرده با پلنگان بر سر هر کوهسار(@)(@@) 21 صبحدم ناگه چو با تکبیر بگشادی عنان %~% خاست از هر سو خروش گیر گیر و داردار(@)(@@) 22 شد حقیقتشان که اکنون هیچ کس را زان گروه %~% یک زمان زنهار ندهد خنجر زنهار خوار(@)(@@) 23 بر فرار کوهها کردند یک لحظه 
ms204	 درنگ %~% در مضیق غارها ماندند یک ساعت بشار(@)(@@) 24 تو در آن بقعت پراکندی به یک نعره سپاه %~% تو از آن تربت برآوردی به یک حمله دمار(@)(@@) 25 چاشتگه ناگشته و نابسته زان بقعت نماند %~% یک سر پیکار جوی و یک تن زنار دار(@)(@@) 26 مغزهاشان را نثاری دادی از برنده تیغ %~% خانه هاشان را بساطی کردی از سوزنده نار(@)(@@) 27 سعد و نحس دوستان و دشمنان آمد پدید %~% چون ظفر کرد از مسیر باد پایان آن شمار(@)(@@) 28 از برای آنکه در پیکارگه روی هوا %~% پر ستاره آسمان را کردی از دود و شرار(@)(@@) 29 چون سمن زاری کند زین پس سباغ از استخوان %~% دشت هایی را که از خون کرده ای چون لاله زار(@)(@@) 30 ره نوشتی فتح و نصرت یارمند و پیشرو %~% بازگشتی بخت و دولت بر یمین و بر یسار(@)(@@) 31 آمد از دهگان سبک پایی که یکجا آمدند %~% از سوار و از پیاده فتنه جویی ده هزار(@)(@@) 32 تو شبانگه بر گرفتی راه و اندر گرد تو %~% بسته جان ها و میانها بندگانت استوار(@)(@@) 33 طبع از اندیشه به جوش و جان از آشفتن به رنج %~% تن ز علت نادرست و دل ز فکرت بی قرار(@)(@@) 34 از میاه راوه بگذشتی به یک منزل چو باد %~% تا شده تر تنگ های مرکبان راهوار(@)(@@) 35 رفته و جسته ز هول و سهم تیغ و تیر تو %~% در گشن تر بیشه شیر و تنگ تر سوراخ مار(@)(@@) 36 ره بریدی و تو را توفیق یزدان راهبر %~% جنگ جستی و تو را اقبال سلطان دستیار(@)(@@) 37 ناگه آمد بانگ کوس سابری از سیرا %~% راست گویی بود نالان بر تن او زارزار(@)(@@) 38 تو ز غبن ننگ و حرص جنگ شوریدی چنانک %~% شیر نر شورد ز بانگ آهو اندر مرغزار(@)(@@) 39 در میان گرد بانگ کوس بونصری بخاست %~% نصرتش لبیک ها کرد از جوانب هر چهار(@)(@@) 40 چون پدید 
ms205	 آمد مصاف دشمن پرخاشجوی %~% تو ز جا انگیختی نعره زنان با سی سوار(@)(@@) 41 زیر ران آن بادپای رعد بانگ برق جه %~% در کف آن تارک شکاف عمر خوار جان شکار(@)(@@) 42 بر لب دریای کینه آمد و بارید و خاست %~% خون چون آغشته روین کرد چون سوده شخار(@)(@@) 43 نیز جان جان را بخست از هیبت تابنده تیغ %~% نیز کس کس را ندید از ظلمت تاری غبار(@)(@@) 44 گشته مانده دستبرد پر دلان اندر نبرد %~% از دو جانب همچو دست نرد مانده در قمار(@)(@@) 45 خاسته در کوشش از گرز گران زخم سبک %~% ساخته در حمله با تیغ تنگ تیر نزار(@)(@@) 46 عمر و مرگ آمیخته در یکدگر چون روز و شب %~% ابر و گرد آمیخته در یکدگر چون پود و تار(@)(@@) 47 تیغ بران مغزهای سرکشان را مشتری %~% تیر پران عمرهای گردنان را خواستار(@)(@@) 48 آتش خنجر پس پشت آب راوه پیش روی %~% تو چه گویی مرگ دادی هیچ کس را زینهار(@)(@@) 49 تیغ هندی چون ز خون های دلیران راند جوی %~% نیزه خطی ز سرهای سران آورده بار(@)(@@) 50 گشته پران از کف او نیزه و زوبین و تیر %~% در هوا ده تیروار راست در ده تیروار(@)(@@) 51 کشته بر کشته فکنده پشته بر پشته نمود %~% پنج فرسنگ کشیده طول و عرض رهگذار(@)(@@) 52 تو سبک زان آذری کیشان ز بهر کرکسان %~% دعوتی بس با تکلف کردی ابراهیم وار(@)(@@) 53 یک سوار رزم ساز از پیش تو بیرون نشد %~% اینت سعی چرخ و عون بخت و فضل کردگار(@)(@@) 54 سایرا کان نصرت بونصر دید از آسمان %~% سطوتی دیگر نهیب و لشکری دیگر شعار(@)(@@) 55 دشمنی مرگ تلخ اندر سرافکندش گریز %~% دوستی عمر شیرین در دلش خوش کرد عار(@)(@@) 56 نه میسر گشتش از ادبار خودساز نبرد %~% نه مهیا گشتش از اقبال تو راه فرار(@)(@@) 57 چون مخیر شد میان جستن و آویختن %~% کرد آب راوه را بر 
ms206	 آتش تیغ اختیار(@)(@@) 58 در عزیمت جنگ بودش چون بدید آن رستخیز %~% در هزیمت خویش را بر زد به آب از اضطرار(@)(@@) 59 آب راوه گردنش بگرفت و چندانش بداشت %~% تا سبک مالک روانش را به دوزخ داد بار(@)(@@) 60 جان او در انتظار زخم شمشیر تو بود %~% هر شب آن پتیاره اندر خواب دیدی چند مار(@)(@@) 61 من چنین دانم که او این مرگ را فوزی شمرد %~% زانکه برهانید او را از عذاب انتظار(@)(@@) 62 زین پس آب راوه را چون خدمتی زاینسان بکرد %~% از سپاه خود شمر وز بندگان خود شمار(@)(@@) 63 تیر مه میدان رزم و موسم پیکار تو %~% آمد و آورد فتح سایری پیشت نثار(@)(@@) 64 در نهان عصیان همی ورزند رایان سله %~% ورچه از بیم تو طاعت می نمایند آشکار(@)(@@) 65 این زمستان گر چنین ده فتح خواهی کرده گیر %~% من بهر ده ضامنم لشکر سوی چالندر آر(@)(@@) 66 کمترین بنده ت منم و اندک ترین عدت مراست %~% تو بر این عدت مرا بر دیده ایشان گمار(@)(@@) 67 من به توفیق خدا و قوت اقبال تو %~% نیست گردانم رسوم بت پرستی زین دیار(@)(@@) 68 تا در قلعه من از کشته بپوشانم زمین %~% تا لب راوه من از برده بپیوندم قطار(@)(@@) 69 وین هنر مشمر بدیع از من که قابل طبع من %~% هر هنر کو دارد از طبع تو دارد مستعار(@)(@@) 70 ای ز مردان جهان اندر کفایت برده دست %~% دستبردت شد جهان را صورتی از اعتبار(@)(@@) 71 شاد باش و دیر زی کامروز بزم و رزم را %~% آفتابی با فروغی آسمان با مدار(@)(@@) 72 رستم ناورد گردی حیدر پیکار ویل %~% از تو تازه نام رخش و تازه ذکر ذوالفقار(@)(@@) 73 ملک و دین را نصرتی کردی که از هندوستان %~% این حکایت ماند خواهد تا قیامت یادگار(@)(@@) 74 شغل را چون تو کمر بندی نیابد پادشاه %~% چاره را چون تو خداوند نیارد روزگار(@)(@@) 75 نام جویی 
ms207	 دولت آموزد همی بی شک ترا %~% نام جویی را چو دولت نیست هیچ آموزگار(@)(@@) 76 بخت تو پیروز باشد بر همه نهمت که او %~% لشکری دارد قوی از حسن رای شهریار(@)(@@) 77 تا تو را نزدیک او در کار کرد این چاشنی است %~% گوهر اقبال تو هرگز نگرداند عیار(@)(@@) 78 ای فروزان رای و معطی دست ساکن طبع تو %~% آفتاب عقل و بحر رادی و کوه وقار(@)(@@) 79 بوم هندوستان بهشتی شد ز فر و جاه تو %~% بد دلی و نیستی نابود گشت از بیخ و بار(@)(@@) 80 آن ظفر یابی تو در میدان که اهل کفر و شرک %~% شد ز پیکار تو ناقص دوده و ابتر تبار(@)(@@) 81 وان شجاعی روز کوشش را که همچون روز حشر %~% زلزله از هیبت تو در جبال و در قفار(@)(@@) 82 و آن جوادی صدر بخشش را که امید جهان %~% دارد از کف تو معشوق حصول اندر کنار(@)(@@) 83 با گل بر و می جود تو جمع سایلان %~% ایمنند از زخم خار و بیغم از رنج خمار(@)(@@) 84 ناتوانان گشته از اقبال تو رستم توان %~% بی یساران گشته از احسان تو قارون یسار(@)(@@) 85 از پی انگشت و کفت آفرید ایزد مگر %~% خامه گوهر نشان و خنجر گوهر نگار(@)(@@) 86 تا همی پیر و جوان گردد جهان از دور چرخ %~% پیری او در خزان باشد جوانی در بهار(@)(@@) 87 از جوانی تا به پیری در صلاح ملک و دین %~% رای پیرت باد با بخت جوانت سازگار(@)(@@) 88 همچنین بادی ز دانش در هنرها چیره دست %~% همچنین بادی به دولت بر ظفرها کامگار(@)(@@) 89 همچنین از شاخ های بخت بار فتح چین %~% همچنین در باغ های طبع تخم مدح کار(@)(@@) 90 هم به صدرت قصه های زایران را التجا %~% هم ز نامت مدح های مادحان را افتخار PageV1P136(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 فریاد مرا زین فلک آئینه کردار %~% کائینه بخت من از او دارد زنگار(@)(@@) 2 
