ms101	 خاتم الطبع % % 23(@)(@@) % إذا العقرب العوجاء أمست كأنما % % أثارت عليها ثأر عادية اللسع % % 24(@)(@@) % وراقبها نجم الثريا بمطلع % % كما انفرقت في العذق ناجمة الطلع % % 25(@)(@@) % وأبرزت الجوزاء صدر زمرد % % محلى بأفذاذ من الدر والودع % % 26(@)(@@) % يشاكه زهر الروض في ماتع الضحى % % على بون ما بين الترفع والوضع % % 27(@)(@@) % سريت دجى هذي وجبت هجير ذا % % بأغول من غول وأسمع من سمع % % 28(@)(@@) % نجيبة هول القفر في مطبق الدجى % % وصفوة لمع الآل في القنن الصلع % % 29(@)(@@) % فلأيا حططت الرحل عن مثل جفنه % % وأطلقت عقد النسع عن شبه النسع % % 30(@)(@@) % فإن تؤو منها يا مظفر غربة % % فنازحة الأوطان مؤيسة الرجعب % % PageV01P311 31(@)(@@) % وإن أعلقت في حبل ملكك حبلها % % فحبل من الأحباب منصرم القطع % % 32(@)(@@) % وإن أخصبت في زرع نعماك رعيها % % فكم قد تخطت واديا غير ذي زرع % % 33(@)(@@) % وإن أرفهت في بحر جودك شربها % % فمن ظمء عشر في الهجير إلى تسع % % 34(@)(@@) % وإن تحي يا يحيى حشاشه نفسها % % فنغبة حسو الموت موشكة الجرع % % 35(@)(@@) % أيادي مليك كلها بكر مفزعي % % وليست ببكر في الأنام ولا بدع % % 36(@)(@@) % لفرع سما ثم انثنى داني الجنى % % لأصل زكا ثم اعتلى باسق الفرع % % 37(@)(@@) % فأودق بالحسنى وأغدق بالمنى % % وأثمر بالنعمى وأجزل بالصنع % % 38(@)(@@) % الملك ميراث تبع % % بما قاد من جيش وأتبع من جمع % % 39(@)(@@) % وتوج من تاج وألبس من حلى % % وقلد من سيف ودرع من درع % % 40(@)(@@) % وصفوة طي والسكون ومذحج % % وكندة والأنصار والأزد والنخع % % PageV01P312 41(@)(@@) % ووتر مثاني المكرمات وماله % % سوى سيفه في مقدم الروع من شفع % % 42(@)(@@) % وذو قلم ينسيك في صدر مهرق % % صدور العذاري في القلائد والردع % % 43(@)(@@) % وإن لقي الأقران خط صدورها % % بأقلام خطي وأترب بالنقع % % 44(@)(@@) % وكم أعجمت بالخفض في العجم أوجها % % وبالكسر والإسلام بالفتح والرفع % % 45(@)(@@) % وكائن لها في كل ملك من العدى % % وإن جل من فتق يجل عن الرقع % % 46(@)(@@) % ومن معقل أشر عن حوليه فاغتدى % % أذل لوطء المقربات من الفقع % % 47(@)(@@) % قرعت ذراه يا مظفر قرعة % % أصم صداها كل مسترق السمع % % 48 
ms102	(@)(@@) % وصبحته أسدا على مضرحية % % تركن صفاة الشرك صدعا على صدع % % 49(@)(@@) % وويل لهم من وقعة لك خيلت % % عليهم سماء الله دانية الوقع % % 50(@)(@@) % فمن مقر دار غير محمية الحمى % % ومصرع قرن غير منتعش الصرع % % PageV01P313 51(@)(@@) % وأشلاء قفر شاكهت فيه ما عفت % % خيولك من مغنى لهن ومن ربع % % 52(@)(@@) % بهام إلى هام كأن جثومها % % بأطلالها مثوى أثافيها السفع % % 53(@)(@@) % فلا عدم الإسلام رعيك لا يني % % ولا أمن الإشراك بأسك لا يرع % % 54(@)(@@) % ولا زالت الأعياد عائدة لنا % % بملكك ما عاد الحمام إلى السجع % % 55(@)(@@) % ولا أخليت منك المصلى بمشهد % % شهيد على ما أتقن الله من صنعأ % % 56(@)(@@) % ولا أوحشت ذكراك أعواد منبر % % بداع لك الرحمن فيها ومستدع % % 57(@)(@@) % ولا رد من أعلاك لي فيك دعوة % % تجلى إليها من سمواته السبع % % 58(@)(@@) % بمارشت من سهمي وأيدت من يدي % % وجلت من ضري وأدنيت من نفعي % % 59(@)(@@) % فأصبح حمدي فيك ملتحم السدى % % كما راح شملي فيك ملتئم الجمع % % PageV01P314 البحر : كامل تام 1(@)(@@) % عيد ووعد صادق لك بالمنى % % ولمن شنئت وعيد صدق بالفنا % % 2(@)(@@) % ومبشر الأيام أن تبقى لها % % ومبشر الإسلام أن تبقى لنا % % 3(@)(@@) % ولمن مناه أن تعيش مؤيدا % % ومؤيدا ومؤمنا ومؤمنا % % 4(@)(@@) % ومعظما ومكرما ومحكما % % ومسلما ومغنما وممكنا % % 5(@)(@@) % ولعز ملك أنت أكرم من نمى % % ولضن دهر أنت أنفس ما افتنى % % 6(@)(@@) % مما نمى قحطان أكرم نبعة % % مهتزة الأغصان دانية الجنى % % 7(@)(@@) % غناء تشدو من خلائقها بها % % طير تغنى للخلائق بالغنى % % 8(@)(@@) % ولربما كانت فروع غصونها % % قضبا من الهندي أولدن القنا % % 9(@)(@@) % أهوى إلى الأعداء من علق الهوى % % وأدب في مهج الضلال من الضنى % % 10(@)(@@) % لفتى له في كسف كل عجاجة % % قبب على عمد الخوافق تبتنى % % PageV01P315 11(@)(@@) % واختال في لبس الوغى حتى غدا % % منه السناء يميس في حلل السنا % % 12(@)(@@) % أعدى إلى الأعداء من سهم رمى % % عن ملكه وأحن من قوس حنى % % 13(@)(@@) % حذر على الإسلام أيسر ما اتقى % % هدر له في الشرك أعظم ما جنى % % 14(@)(@@) % بمناقب نطمت جواهر للورى % % ما أجمل 
ms103	 الدنيا بهن وأزينا % % 15(@)(@@) % ومقادم في يوم كل كريهة % % ما أقرب الدنيا لهن وأمكنا % % 16(@)(@@) % حفظ الحياة فكان أولى باسمها % % وسما إلى الظفر المعلى فاكتنى % % 17(@)(@@) % واجتاب أثواب النهى حتى غدت % % شيم المكارم كلهن له كنى % % 18(@)(@@) % وسعى إلى نيل المنى فكأنما % % كانت مساعيه أماني للمنى % % 19(@)(@@) % ودنت له الآمال حتى خيلت % % أن النجوم له ثمار تجتنى ب % % 20(@)(@@) % وتوالت الاعياد من نعمائه % % ما ينقضي عيد لنا إلا انثنى % % PageV01P316 21(@)(@@) % فكأن هذا العيد عاد مشككا % % أنا عن الأعياد غيرك في غنى % % 22(@)(@@) % أو غار من أعيادنا بك فالتوى % % بمداه حتى كاد يلحقه الونى % % 23(@)(@@) % فليهن عيدك يا مظفر شيمة % % من عطفك التأمت به حتى دنا % % 24(@)(@@) % وليهننا هذا وتلك وبعدها % % ورضاك في الأيام أهنأ ما هنا % % 25(@)(@@) % واسعد بعيد طالما أعديته % % عودا بإحسان فعاد فأحسنا % % 26(@)(@@) % أهدى إليك سلام مكة فالصفا % % فمعالم الحرم الأقاصي فالدنا % % 27(@)(@@) % فمواقف الحجاج من عرفاتها % % فالمنحر المشهود من شعبي منى % % 28(@)(@@) % ومناسك شاقت مساعيك التي % % أحذيتها منها المثال الأبينا % % 29(@)(@@) % فغدا نداك يهل في شرف العلا % % لهجا يلبي ليتنا ولعلنا % % 30(@)(@@) % وخلفت سعي المروتين معاقبا % % بين الندى والبأس سعيا ما ونى % % PageV01P317 31(@)(@@) % ورميت بالجمرات من بدر اللهى % % ونحرت بدن العرف كوما بدنا % % 32(@)(@@) % وغدوت تهدي للمصلى جحفلا % % لسيوفه خضع الصليب وأذعنا % % 33(@)(@@) % تهوي عليها للبنود سحائب % % بخفوقها سكن الشقاق وأسكنا % % 34(@)(@@) % جنحا إلى أرض العداة تغيظا % % وجوانحا للمسلمين تحننا % % 35(@)(@@) % فأريت هذا العيد عزة مالك % % متذللا لإلهه متدينا % % 36(@)(@@) % ورآك في هدي الصلاة مكبرا % % ومهللا وبحمد ربك معلنا % % 37(@)(@@) % فرآك وسط الخيل أحسن ما رأى % % حسنا ووسط الخير منه أحسنا % % 38(@)(@@) % ورأى جبينك الرياسة فتنة % % ورأى يمينك بالمحامد أفتنا % % 39(@)(@@) % ثم انصرفت عن الصلاة مشيعا % % ومقدرا فيك الهدى ومكونا % % 40(@)(@@) % والأرض تشرق دارعا ومغفرا % % والسبل تشرق داعيا ومؤمنا % % PageV01P318 41(@)(@@) % فثنيت أجياد الجياد معرجا % % وثنيت سمعك نحو ألسنة الثنا % % 42(@)(@@) % في مشهد أندى ندي بالندى % % وأحق بالمنن الجزيلة للمنى % % 43(@)(@@) % والعيد يقسم ما رأى أهدى الهدى 
ms104	 % % والملك جامع شمله إلا هنا % % 44(@)(@@) % أفلئن رأى في الدهر جوهر سؤدد % % من بعدها فقد استبان المعدنا % % 45(@)(@@) % وليعمرن بذكر مجدك أعصرا % % ويبشرن بطول عمرك أزمنا % % 46(@)(@@) % يا مدني الأمل البعيد وإن نأى % % ومبعد الخطب الجليل وإن دنا % % 47(@)(@@) % ومسلي الغرباء عن أوطانهم % % حتى تبوأ كل قلب موطنا % % 48(@)(@@) % ومن احتذى من كل بان للعلا % % مثلا ولم يغفل عمارة ما بنى % % 49(@)(@@) % حسبي رسول الله فيكم أسوة % % إذ عاد من مضريكم فتيمنا % % 50(@)(@@) % قلقت به أوطانه من ظاعن % % لم يلف في عدنان عنكم مظعنا % % PageV01P319 51(@)(@@) % فاختاركم رب السماء لحرزه % % ولعزه ولحزبه أن يفتنا % % 52(@)(@@) % ولرحله ولأهله أحبب به % % سكنا لكم وبكم إليه مسكنا % % 53(@)(@@) % فوقيتم ورعيتم وسعيتم % % وحميتم الإسلام حتى استيقنا % % 54(@)(@@) % وبذلتم عنه نفوسا حرة % % لإبائها دان الضلال ودينا % % 55(@)(@@) % وسللتم منها سيوفا برة % % بمضائها بان اليقين وبينا % % 56(@)(@@) % فبها ضربتم كل مرهوب عتا % % وبها فككتم كل مرهون عنا % % 57(@)(@@) % وبها شفيتم قرح دهر عضنا % % وبها جلوتم خطب ضر مسنا % % 58(@)(@@) % وبها بلغتك يا مظفر مسهلا % % في كل لامعة السراب ومحزنا % % 59(@)(@@) % وبها وصلت ظلام ليل هاديا % % بسناك لي وصباح هم مدجنا % % 60(@)(@@) % ظلم كأن نجومها وبدورها % % بعثت علينا للحوادث أعينا % % PageV01P320 61(@)(@@) % وطوارق كانت أضاليل الفلا % % والبحر في الظلماء منها أهونا % % 62(@)(@@) % حتى بلغت بك المنى إلا الحصى % % إذ لم تقيض لي بشكرك ألسنا % % 63(@)(@@) % ولسبعة مع مثلهم أنا كلهم % % في النائبات وليس كلهم أنا % % 64(@)(@@) % فاسلم لهم وليهنهم منك الرضا % % وليهنك الأمل البعيد ويهننا % % 65(@)(@@) % ولتفد نفسك يا مظفر أنفس % % منا متى تغلق برهن تفدنا % % 66(@)(@@) % بندى إذا غص الغمام يعمنا % % ويد إذا شعث الزمان نأمنا % % 67(@)(@@) % فالله يعصمها ويعصمنا بها % % ويقي البلاد بها ويفديها بنا % % PageV01P321 البحر : كامل تام 1(@)(@@) % بكسيت بدولتك الليالي نورا % % واهتزت الدنيا إليك سرورا % % 2(@)(@@) % وإذا تأملت المنى ألفيتها % % قدرا لكم ولنا بكم مقدورا % % 3(@)(@@) % وإذا تفاخرت الملوك وجدتم % % من كل ملك أوجها وصدورا % % 4(@)(@@) % وخلعتم في العالمين مساعيا % % حلينهن مفارقا ونحورا % % 5(@)(@@) % وإذا 
ms105	 الدهور تساجلت ألفيتم % % يا آل تبع للدهور دهورا % % 6(@)(@@) % من كل دهر لا يزال كأنه % % لوح يلوح بفخركم مسطورا % % 7(@)(@@) % يتلى فتنشقه النفوس كأنما % % بالمسك خط غواته الكافورا % % 8(@)(@@) % لكم سماء الملك ما زالت بكم % % تزهى فتشرق أنجما وبدورا % % 9(@)(@@) % ولكم رياض الأرض تسقون الورى % % نعما فتنبت حامدا وشكورا % % 10(@)(@@) % فتهن يا يحيى تراث مآثر % % أحرزت منها حظك الموفورا % % PageV01P322 11(@)(@@) % من كل ذي ملك نموك فأنجبوا % % بدرا لفجرهم المنير منيرا % % 12(@)(@@) % واستودعوك شمائلا ومحاسنا % % كرمت فكنت بحظهن جديرا % % 13(@)(@@) % فوصلت ما وصلوا من النسب الذي % % بذراك عوذ أن يرى مهجورا % % 14(@)(@@) % فحكمت في حكم بشمل جامع % % نورين زادهما التألف نورا % % 15(@)(@@) % قمرين لم يعرف لتلك نظيرة % % هذا ولا هذي لذاك نظيرا % % 16(@)(@@) % فلأمت شعبهما بسوق وليمة % % راح الثرى بدمائها ممطورا % % 17(@)(@@) % تحكي مصارع من عداتك لم تجد % % من حكم سيفك في البلاد مجيرا % % 18(@)(@@) % فجزرت حتى بات من عاديته % % حذرا يراقب أن يكون جزورا % % 19(@)(@@) % ورفعت في ظلم الدياجي عنهما % % شقرء بات لها السماك سميرا % % 20(@)(@@) % نارا تمثل تحت ظل دخانها % % كسف العجاج وسيفك المشهورا % % PageV01P323 21(@)(@@) % وتخالها زهر الكواكب تحتها % % قمرا تغشى دونها ساهورا % % 22(@)(@@) % في مشهد أمسى نذيرا للعدى % % وغدا لنا بالقرب منك بشيرا % % 23(@)(@@) % ندعى له الجفى فحسبك طاعة % % ممن يجيبك مغنما ونفيرا % % 24(@)(@@) % ولمن يرى خفض النعيم محرما % % يوما تريه لواءك المنشورا % % 25(@)(@@) % فجلوت من صدف المقاصر درة % % حليت منها أربعا وقصورا % % 26(@)(@@) % فكسا المنازل مطعما ومشاربا % % وكسا الأسرة نضرة وسرورا % % 27(@)(@@) % كلا كسوت درانكا ونمارقا % % وزرابيا وأرائكا وخدورا % % 28(@)(@@) % وتتابعت منك الجنود كأنما % % يطأون منها لؤلؤا منثورا % % 29(@)(@@) % وتلألأت فيها بروق مجامر % % يكسون أصبار المسوك صبيرا % % 30(@)(@@) % هطلا بماء الورد سح كأنما % % والى فروض سندسا وحريرا % % PageV01P324 31(@)(@@) % يوم لك اكتتبت شهادات الندى % % بالمسك في صحف الوجوه سطورا % % 32(@)(@@) % تبدو فنقرأ في بيان خطوطها % % جدوى يديك وسعيك المشكورا % % 33(@)(@@) % لله أم مهيرة لم تعتقد % % في مهرها العلق الخطير خطيرا % % 34(@)(@@) % زفت إلى حكم بحكمك فاغتدى % % ملكا مليكا 
ms106	 عندها وأميرا % % 35(@)(@@) % والسعد قد شمل السماء كواكبا % % واليمن قد حشد الهواء طيورا % % 36(@)(@@) % ولو ابتذلت بها مخفة والد % % لم تعطها إلا السيوف مهورا % % 37(@)(@@) % ولما جزرت لها وليمة معرس % % إلا الضراغم عاديا وهصورا % % 38(@)(@@) % ولكان يوم الزحف موقد نارها % % حربا تفور مراجلا وقدورا % % 39(@)(@@) % ولما رفعت لهسا دخانا ساطعا % % إلا عجاجا في السماء ومورا % % 40(@)(@@) % حتى تئوب وقد ملأت بلادنا % % نعم العدى والناعمات الحورا % % PageV01P325 41(@)(@@) % فتملاوا يا آل يحيى عمركم % % في ملك يحيى بالمنى معمورا % % 42(@)(@@) % وسقيتم ورعيتم بحياته % % ورقيتم من فقده المحذورا % % PageV01P326 البحر : متقارب تام 1(@)(@@) % قد الخيل والخير بأسا وجودا % % وصل أبد الدهر عيدا فعيدا % % 2(@)(@@) % ودونك فالبس ثياب البقاء % % فأخلق جديدا وأخلف جديدا % % 3(@)(@@) % مظاهر ما أورثتك الجدود % % من الحلل الملبسات الجدودا % % 4(@)(@@) % سنى وسناء وملكا وملكا % % وسيفا وسيبا وجدا وجودا % % 5(@)(@@) % وما نثرته عليك السعود % % محاسن تبهر فيها السعودا % % 6(@)(@@) % حلى منحت منك زهر النجوم % % شنوقا تحلى بها أو عقودا % % 7(@)(@@) % بوأنت وسعت بهن الرجال % % ملابس ألبستهن الخلودا % % 8(@)(@@) % فخولت منها اللهى والخيول % % وعبدت منها المها والعبيدا % % 9(@)(@@) % وألبست فيها الحلى والدروع % % وأسحبت منها الملا والبرودا % % 10(@)(@@) % وكم قد كسوت ثياب الحداد % % بلادا لبست إليها الحديدا % % PageV01P327 11(@)(@@) % فأشرقت بالدين نورا مبينا % % وألحقت بالشرك حتفا مبيدا % % 12(@)(@@) % كتائب حليتهن السيوف % % وتوجتهن القنا والبنودا % % 13(@)(@@) % صوارم بوأتها في الرقاب % % معاهد أنسيتهن الغمودا % % 14(@)(@@) % كما فتقت نيرات الصباح % % تفتح في الروض روضا نضيدا % % 15(@)(@@) % وسمرا جلوت بها للعيون % % وجوه المهالك حمرا وسودا % % 16(@)(@@) % يرينك تحت سجوف العجاج % % نواظر أنسيتهن الهجودا % % 17(@)(@@) % مصارع قربت منها نفوسا % % تعاطين منها مراما بعيدا % % 18(@)(@@) % فمليته عز نصر وفلج % % كفيل المزيد بأن تستزيدا % % 19(@)(@@) % وهنيته فتح أيام عيد % % جدير عوائده أن تعودا % % 20(@)(@@) % ولقيته عيد فأل بوعد % % لنصرك يقرو عداك الوعيدا % % PageV01P328 21(@)(@@) % وكم ذكرت منك أيامه % % مقاما كريما وفعلا حميدا % % 22(@)(@@) % فعشر لياليه فضلا ونسكا % % وعشر بنانك عرفا وجودا % % 23(@)(@@) % ويوم منى بالمنى أي فأل % % مفيد الرغائب أو مستفيدا % % 24(@)(@@) % وفي اليوم من 
ms107	 عرفات عرفنا % % من الله فيما حباك المزيدا % % 25(@)(@@) % وذكرنا منحر البدن منك % % مواقف تنحر فيها الأسودا % % 26(@)(@@) % وتكسو سيوفك فيها الدماء % % وتوطئ خيلك فيها الخدودا % % 27(@)(@@) % ورمي الجمار فكم قد رميت % % عن الدين شيطان كفر مريدا % % 28(@)(@@) % معالم شيدهن الخليل % % وأذن بالحج فيها مشيدا % % 29(@)(@@) % فلباه من لم يكن قبل خلقا % % وأنشئ من بعد خلقا جديدا % % 30(@)(@@) % رجال أجابوا أذان الخليل % % فجابوا إليها بحارا وبيدا % % PageV01P329 31(@)(@@) % كما عمرت بك سبل الجهاد % % جنودا تفل بهن الجنودا % % 32(@)(@@) % وجدت فنادى نداك العفاة % % وسدت فنادى علاك الوفودا % % 33(@)(@@) % ولا كوفود تقبلت منهم % % وسائل كانوا عليها شهودا % % 34(@)(@@) % فحيوك عن كل محيي الوفاء % % إليك حياة تميت الحقودا % % 35(@)(@@) % فكم أنسوا بك شكلا زكيا % % وأدنوا إليك صفيا بعيدا % % 36(@)(@@) % وكم وصلوا بك قلبا كريما % % وكم شرحوا لك صدرا ودودا % % 37(@)(@@) % عهودا تضمنهن الوفاء % % بصدق تضمن منك العهودا % % 38(@)(@@) % فلا أعدمتك ظنون اللبيب % % يقينا على كل قلب شهيدا % % 39(@)(@@) % ولا زال سيفك في كل أرض % % على كل غاو رقيبا عتيدا % % 40(@)(@@) % ولا زلت للدين طودا منيفا % % وظلا ظليلا وركنا شديدا % % PageV01P330 البحر : متقارب تام 1(@)(@@) % نجوم الصبا أين تلك النجوم % % نسيم الصبا أين ذاك النسيم % % 2(@)(@@) % أما في التخيل منها ضياء % % أما في التنشق منها شميم % % 3(@)(@@) % فيلحقها من ضلوعي زفير % % ويدركها من دموعي سجوم % % 4(@)(@@) % لقد شط روض إليه أحن % % وغارت مياه إليها أهيم % % 5(@)(@@) % أوانس يصبح عنها الصباح % % نواعم ينعم منها النعيم % % 6(@)(@@) % كواكب تصغي إليها السعود % % كواعب تصبو إليها الحلوم % % 7(@)(@@) % ليالي إذ لا حبيب يصد % % وعهدي إذ لا عذول يلوم % % 8(@)(@@) % وإذ لا صباحي رقيب عتيد % % ولا ليل وصلي ظلام بهيم % % 9(@)(@@) % وكيف وشمس الضحى لي أليف % % وأنى وبدر الدجى لي نديم % % 10(@)(@@) % وخمري من الدر مسك مذاب % % وروضي من السحر دل رخيم % % PageV01P331 11(@)(@@) % وأوجه أرضي زهر تروق % % وملء سمائي نجوم رجوم % % 12(@)(@@) % فشيطان لهوي مطاع مطيع % % وشيطان همي طريد رجيم % % 13(@)(@@) % غرارة عيش أراها الغرور % % بأن الزمان صديق حميم % % 14(@)(@@) % وغمرة شك 
ms108	 أتاها اليقين % % بأن رضيع الأماني فطيم % % 15(@)(@@) % وغصن شباب علاه المشيب % % كغض رياض علاها الهشيم % % 16(@)(@@) % ب فيا عجبا لصروف الزمان % % شهودا لنا وهي فينا خصوم % % 17(@)(@@) % وكيف قضى حكم هذا القضاء % % علي لدهري وهو الظلوم % % 18(@)(@@) % فنحن ديون النوى كل يوم % % على حكمه يقتضينا الغريم % % 19(@)(@@) % وتلك المعاهد بن رسوما % % عفاها الذميل بنا والرسيم % % 20(@)(@@) % بسير يقول الصفا الصم منه % % أما للحوادث قلب رحيم % % PageV01P332 21(@)(@@) % أما يستقال الزمان الكئود % % أما يستكف العذاب الأليم % % 22(@)(@@) % عن الأوجه المتوالي عليها % % ليال وأيام جهد حسوم % % 23(@)(@@) % جسوم تطير بهن القلوب % % بأجنحة ريشهن الهموم % % 24(@)(@@) % بكل هجير لو النار تصلى % % جحيما لأصبح وهو الجحيم % % 25(@)(@@) % كأن رواحلنا في ضحاه % % صوادي سمام حداها السموم % % 26(@)(@@) % وفي كل ليل تغشى دجاه % % فنام ولكنه لا ينيم % % 27(@)(@@) % كأنا وقد سد بابيه عنا % % وهام بنا الذعر هام وبوم % % 28(@)(@@) % وفي كل بحر كما قيل خلق % % صغير يهاويه خلق عظيم % % 29(@)(@@) % كأنا عليه نجوم الثريا % % تسير وقد أفردتها النجوم % % 30(@)(@@) % نجاء تمنى ثمار النجاة % % ومن دونهن رجاء عقيم % % PageV01P333 31(@)(@@) % فذاك مدى صبر حر يضام % % وذاك مدى صرف دهر يضيم % % 32(@)(@@) % وكم أعقب الظمء حسي جموم % % وكم عاقب الجدب ري جميم % % 33(@)(@@) % وفي اسم المظفر فأل الحياة % % ليحيا الغريب به والمقيم % % 34(@)(@@) % يبشرنا بسناه الصباح % % وتخبرنا عن نداه الغيوم % % 35(@)(@@) % ففي كل بحر لنا منك شبه % % وفي كل فجر لنا فيك خيم % % 36(@)(@@) % ومرعاك في كل أرض نرود % % وسقياك في كل برق نشيم % % 37(@)(@@) % وفي كل ناد مناد إليك % % هلم إلى حيث يغنى العديم % % 38(@)(@@) % هلم إلى حيث تنسى الرزايا % % هلم إلى حيث تؤسى الكلوم % % 39(@)(@@) % هلم إلى حيث يؤوى الغريب % % هلم إلى حيث يحمى الحريم % % 40(@)(@@) % هلم لعز حمى لا يرام % % يسح عليه حيا لا يريم % % PageV01P334 41(@)(@@) % علا أعرقت فيك من عهد عاد % % يدين الكريم بها واللئيم % % 42(@)(@@) % عهود مكارم لا عهدها % % ذميم ولا الدهر فيها مليم % % 43(@)(@@) % أجد مناقبهن اللبيس % % وأحدث آثارهن القديم % % 44(@)(@@) % تنير بهن القبور 
ms109	 الدثور % % وتعبق منها العظام الرميم % % 45(@)(@@) % وتثمر من طعمهن الغصون % % وتغدق في سقيهن الأروم % % 46(@)(@@) % ويوصي بهن مليكا مليك % % ويودعهن كريما كريم % % 47(@)(@@) % فعم الخلائق منها خصوص % % كفاها وخصك منها العموم % % 48(@)(@@) % وجاءتك بين ظباة السيوف % % تصول القيول بها والقروم % % 49(@)(@@) % وفي كل بر وفي كل بحر % % صراط إليك لها مستقيم % % 50(@)(@@) % وأنت بميراثهن المحيط % % لأنك فيها الوسيط الصميم % % PageV01P335 51(@)(@@) % فإن أعلقت بك علق الفخار % % فأنت الكفيل بها والزعيم % % 52(@)(@@) % وإن رضيتك لتاج البقاء % % فأنت الرفيع به والعميم % % 53(@)(@@) % وسيفك للدين ركن شديد % % وحظك في الملك حظ جسيم % % 54(@)(@@) % وإن يهنك اليوم عيد يعود % % فيهن له منك عيد يقيم % % 55(@)(@@) % ولما رأى أنه لا يدوم % % أتاك يهنيك ملكا يدوم % % 56(@)(@@) % وإقبالها دولة لا تناهى % % وإقدامها عزة لا تخيم % % 57(@)(@@) % ويهن المصلى تجليك فيه % % بوجه ينير وكف تغيم % % 58(@)(@@) % وهدي تهادى إليه العيون % % ويزهى له زمزم والحطيم % % 59(@)(@@) % لبست إليها من الملك تاجا % % يهل الهلال له والنجوم % % 60(@)(@@) % على حلل حاكهن السناء % % وأردية نسجتها الحلوم % % PageV01P336 61(@)(@@) % وتحت غيابات غاب الوشيج % % أسود إلى مهج الكفر هيم % % 62(@)(@@) % وللسابغات بحور تمور % % وللسابحات سفين يعوم % % 63(@)(@@) % كأن خوافق أعلامهن % % طيور على الماء منها تحوم % % 64(@)(@@) % ففصل باسمك فصل الخطاب % % كما قد حباك العزيز الحكيم % % 65(@)(@@) % وأخلص فيك جميل الدعاء % % بما لا يضيع السميع العليم % % 66(@)(@@) % فلا شاء دهرك ما لا تشاء % % ولا رام شانيك ما لا ترومب % % 67(@)(@@) % فنصرك أول ما نستمد % % وعمرك آخر ما نستديم % % PageV01P337 البحر : كامل تام 1(@)(@@) % اليوم نادتك السيادة هيت لك % % في ملك من حلاك بهجة ما ملك % % 2(@)(@@) % ورأى جبينك قد تلألأ للمنى % % نورا فتوجك السناء وكللك % % 3(@)(@@) % فلك السيادة والقيادة دونه % % وله الرياسة والسياسة ثم لك % % 4(@)(@@) % صدقت فراسته شمائلك التي % % منه فأغمد سيفه واستبدلك % % 5(@)(@@) % وأخذت سيف النصر منه بحقه % % وحملت من أعبائه ما حملك % % 6(@)(@@) % فرمى بك الثغر القصي تيقنا % % ألا يرى غير المهند موئلك % % 7(@)(@@) % والفتح مبتهج إليك كأنه % % للعرف والإكرام ممن أملك % % 8(@)(@@) % ولرب 
ms110	 وجه للمنايا دونه % % عممته بالسيف حين استقبلك % % 9(@)(@@) % في غمرة أعيا الحمام طريقها % % ففتحت فيه للقنا حتى سلك % % 10(@)(@@) % ونهضت والإسلام يهتف معلنا % % يا منذرا قرة عين لي ولك % % PageV01P338 11(@)(@@) % فسقيت ظمء الغيظ من مهج العدى % % ما علك الشبم القراح وأنهلك % % 12(@)(@@) % ألف كأسد الغاب ألف شملهم % % ليزيدهم ذو العرش فيما نفلك % % 13(@)(@@) % فقسمتهم بين الصوارم والقنا % % إلا الذين ملأت منهم أحبلك % % 14(@)(@@) % أمراء أجناد ونخبة دولة % % كانوا ذخيرة نخبة الأيام لك % % 15(@)(@@) % وحمى ابن شنج منك آجل ميتة % % ألقت إليك بعذر ما قد أعجلك % % 16(@)(@@) % فالحين يدنيه إليك لتقتضي % % عبدا يهيئ وجنتيه لينعلك % % 17(@)(@@) % قلقا تناهى في البلاد فراره % % ونهى ضمير النفس أن يتمثلك % % 18(@)(@@) % ويذود عن أجفانه سنة الكرى % % كي لا يريه الحلم أن يتأولك % % 19(@)(@@) % ويحيد عن جو السماء بطرفه % % ألا يرى بين الكواكب منزلك % % 20(@)(@@) % ولكم أراه البدر حين حمامه % % لما استبد به الكمال فخيلك % % PageV01P339 21(@)(@@) % ودوي سيفك في رقاب حماته % % عجل إليك برقه ويقل لك % % 22(@)(@@) % ولقد تفهم فيه لفظ مخاطب % % خل البلاد لأهلها لا أم لك % % 23(@)(@@) % لمن استرد حياة نفسك عفوه % % وقد انتحى سهم المنية مقتلكأ % % 24(@)(@@) % ولمن تلبيه السماء وأرضها % % مددا إليك له مليكا أو ملك % % 25(@)(@@) % ولمقحم عينيك في رهج الوغى % % خيلا تغص بهن أقطار الفلك % % 26(@)(@@) % فليهن سعيك يا مظفر أمة % % جاهدت عنها من بغى حتى هلك % % 27(@)(@@) % ورميت دون ثغورها ونحورها % % من لم يدن بالحق حتى دان لك % % 28(@)(@@) % ولئن شكرت الله فيك جزاء ما % % قسم الفضائل في الملوك ففضلك % % 29(@)(@@) % فلقد بلا شكري بما خولته % % أني ورق بني مما حولك % % 30(@)(@@) % فلئن لبست بك الثناء فحق لي % % ولئن لبست بي الثناء فحق لك % % PageV01P340 البحر : طويل 1(@)(@@) % سلام على الأيام تسليم إقبال % % بآمال تحقيق وتحقيق آمال % % 2(@)(@@) % بمقدم فتح من مليك مظفر % % وأوبة نصر في تباشير إقبال % % 3(@)(@@) % وشاهد ملك لاح في تاج مفرق % % محيا بإعظام محلى بإجلال % % 4(@)(@@) % ذخيرة أملاك وعلق تبابع % % وصفوة أذواء وميراث أقيال % % 5(@)(@@) % فبشراك 
ms111	 يا دنيا سمي الذي به % % علا صوت جبريل بشيرا وميكال % % 6(@)(@@) % وبشراك باستقبال أرض حياتها % % بما في اسمه من صادق الظن والفال % % 7(@)(@@) % فهذي رياض الأمن تزهر بالمنى % % وهذي سماء الفضل تهمي بإفضال % % 8(@)(@@) % وهذا سناء الفخر يشرق بالسنا % % وهذا جمال الدهر يزهى بإجمال % % 9(@)(@@) % بمن كشف الخطب الذي أظلم الضحى % % وألقى على الألباب حيرة إضلال % % 10(@)(@@) % ومن رتق الفتق الذي أعجز الورى % % وأعدم فيه الدهر حيلة محتال % % PageV01P341 11(@)(@@) % ومن رد في جسم المكارم روحه % % فلا عذر للباكي ولا ذنب للسالي % % 12(@)(@@) % ومن وسع الإسلام رأفة منعم % % وهيأ للإشراك عدوة رئبال % % 13(@)(@@) % ومن ركب الفلك السوابح في الوغى % % إلى كل هول ينتحيه بأهوال % % 14(@)(@@) % ورفع أعلاما كأن خفوقها % % على علم الإشراك إرجاف زلزال % % 15(@)(@@) % وسامر بالشعرى خيولا كأنما % % تمشى بهن الأرض مشية مختال % % 16(@)(@@) % سرى ليل كانونين والدجن ذائب % % عليه بحمد في دجى الليل منهال % % 17(@)(@@) % وليس سوى نار الطعان له صلى % % ولا غيره في حر أولها صالب % % 18(@)(@@) % بجمع كأن الجو مرآة عينه % % إذا ما سرى أو بالغدو والآصال % % 19(@)(@@) % فتمثال أطراف العوالي نجومه % % وشمس ضحاه منك أبين تمثال % % 20(@)(@@) % كأنك عوضت الأباطح والربى % % وشيج القنا من منبت السدر والضال % % PageV01P342 21(@)(@@) % كما عمها جدوى يديك فوصلت % % مساء بإصباح وسهلا بأجبال % % 22(@)(@@) % فكم ألبست شم الربى من عمائم % % وجرت على البيداء من فضل ذيال % % 23(@)(@@) % حدائق ماذي يضاحك في الدجى % % حبيكا كلمع الشمس في ريق الآل % % 24(@)(@@) % إذا هب ريح النصر فيها تفتحت % % بأبيض قضاب وأسمر عسال % % 25(@)(@@) % وطاقة نبع في بنان موتر % % وزهرة نور في كنانة نبال % % 26(@)(@@) % تجارة غزو نقدها البيض والقنا % % قضاء حقوق واقتضاء لآجال % % 27(@)(@@) % فلله كم أغليت من دم مسلم % % وأرخصت في أعدائه من دم غال % % 28(@)(@@) % وأسلمت للإسلام فيها بضاعة % % تعود بأضعاف وتوفي بأمثال % % 29(@)(@@) % وحسبك فيها بابن شنج وجنده % % من السبي أبدالا وأية أبدال % % 30(@)(@@) % مليكا وما يحوي شريت ببعضه % % وأربح بقنطار يباع بمثقال % % PageV01P343 31(@)(@@) % فما حاز غاز مثله فيء مغنم % % ولا نال 
ms112	 ساب مثلها سبي أنفال % % 32(@)(@@) % وما بعت رق الملك منهم نسيئة % % ولا مستجيزا كاليء الدين بالكالي % % 33(@)(@@) % ولكن نقدا ناجزا في رقابهم % % بإذعان تمليك وإذعان إذلال % % 34(@)(@@) % وإقرار من لا يبتغي عنك موئلا % % وليس له من دون سيفك من وال % % 35(@)(@@) % فعد بمفاتيح الفتوح التي شفت % % على غلق من غدرة تحت أقفال % % 36(@)(@@) % بمن لم يسغه كره بعد فره % % ولا رد من عينيه نظرة إجفال % % 37(@)(@@) % غداة تقاضى منه أكفال خيله % % بأجياد خيل لا تقر بأكفال % % 38(@)(@@) % وألقح منه بطن أم طوت به % % مشيمة شوم جال في سخد أوجال % % 39(@)(@@) % إذا أسقطته روعة منك راعه % % هشيم رياض في دوارس أطلال % % 40(@)(@@) % شفا جنة لم تجن حتى جنى لها % % حروبا جناها من جحيم وأنكال % % PageV01P344 41(@)(@@) % يقلب كفيه بحسرة حاسر % % عليها وعينيه بعبرة إعوال % % 42(@)(@@) % مصانع روضات رعى البغي نبتها % % فعوضه منها شواهق أوعالأ % % 43(@)(@@) % فأية أسوار ونصحك سرها % % إلى أن طوى غلا فأية أغلال % % 44(@)(@@) % وأية أشجار وسلمك سقيها % % إلى أن بغى فيها فأية أجذال % % 45(@)(@@) % حماها فأعلاها بناء وما رأى % % مكانك يعلو كل ذي شرف عال % % 46(@)(@@) % وشيدها عجبا ويا رب مثله % % على مثلها أبكيت من طلل بال % % 47(@)(@@) % وعطلها من حلي نصحك باغيا % % فيا عجب الأيام للعاطل الحالي % % 48(@)(@@) % يتوجها بالنقع نظمك حولها % % مجال عقود من خيول وأبطال % % 49(@)(@@) % فيمسي لها منه لحاف وملحف % % وتصبح منه بين درع وسربال % % 50(@)(@@) % كما وصف الكندي بعل فتاته % % عليه القتام سيء الظن والبال % % PageV01P345 51(@)(@@) % فأبق لها بأس ابن باق ونصحه % % فما لمس الجرباء مثل يد الطالي % % 52(@)(@@) % ولا أحصن الحرب العوان كبعلها % % ولا راع آسادا كغاصب أشبال % % 53(@)(@@) % ولا سيما حر جلا لك غيمه % % نصيحة لا وان وإشفاق لا آل % % 54(@)(@@) % وشيعية لا مقصرا عن غلوها % % ولا مشكلا بين المقصر والغالي % % 55(@)(@@) % وطائر يمن لا تزال تريشه % % قوادم إقدام ونهضة إعجال % % 56(@)(@@) % بها رد خيل البغي تدمى كلومها % % وقد يئست من نصرة العم والخال % % 57(@)(@@) % وأمن من عدوانها كل خائف % % وأثكلها مستودع 
ms113	 الأهل والمال % % 58(@)(@@) % وإن هلالا لاح من حد سيفه % % لمضمون إتمام عليه وإكمال % % 59(@)(@@) % فهاك نجوم السعد من كل مطلع % % توالي بتكبير إليك وإهلال % % 60(@)(@@) % فلا عريت منك الجياد إلى الوغى % % ولا العيس من حل إليك وترحال % % PageV01P346 البحر : طويل 1(@)(@@) % دواليك من دهر يواليك بالنجح % % ففتح إلى عيد وعيد إلى فتح % % 2(@)(@@) % كما بشرت بالغيث بارقة الحيا % % وأسفر عن شمس الضحى فلق الصبح % % 3(@)(@@) % وريح من الإقبال تعصف بالعدى % % وتنشأ للإسلام بالوابل السح % % 4(@)(@@) % حيا منك يا يحيى على الدين والهدى % % بوارقه في الكفر خاطفة اللمح % % 5(@)(@@) % جدير الندى أن تتبع المن بالمنى % % وسم العدى أن تنكأ القرح بالقرح % % 6(@)(@@) % ب فوفيت من سعي الجهاد تجارة % % مضاعفة الأضعاف نامية الربح % % 7(@)(@@) % كما بشرت بالغيث بارقة الحيا % % وأسفر عن شمس الضحى فلق الصبح % % 8(@)(@@) % رفعت لها أعلام نصر كأنما % % كستها طيور اليمن أجنحة النجح % % 9(@)(@@) % تمور بها في كل بحر من الوغى % % سوابح محمود لها شيم السبح % % 10(@)(@@) % إذ الحرب بالأبطال في لجة الردى % % تذكرهم بلقيس في لجة الصرح % % PageV01P347 11(@)(@@) % وسيفك في الأعناق والسوق مقتد % % بسيف سليمان الموكل بالمسح % % 12(@)(@@) % لمعت به في جو ناجر لمعة % % ثنت كبد الشيطان دامية الجرح % % 13(@)(@@) % وصبحتها في جنح ليل من القنا % % أحل بها ليل الأسى مطبق الجنح % % 14(@)(@@) % فأية أم للضلال قهرتها % % بنيها بضرب في الطلى فائز القدح % % 15(@)(@@) % وبيضة كفر كم وكم لك أسمحت % % ببيضة خدر لا تواتي يد السمح % % 16(@)(@@) % جللن عن الأكفاء قدرا وأوجها % % فأصممن عن خطب وأخرسن عن نكح % % 17(@)(@@) % فسرعان ما أبرزت منهن للفلا % % غدائر تمسي في سنا أوجه تضحي % % 18(@)(@@) % مظللة بالحافقات كأنها % % ظباء تهادى في ذرا الأيك والطلح % % 19(@)(@@) % كواعب إلا أنهن كواكب % % جلوت سناها من سنا السيف والرمح % % 20(@)(@@) % ترد إلينا عن سهامك فيهم % % سهام عيون حربها موشك الصبح % % PageV01P348 21(@)(@@) % وتسفر عن أشباه ما نضحت به % % سيوف سبتها من دم شرق النضح % % 22(@)(@@) % فهاتيك أم الكفر ناجر بعدها % % ظلاما بلا نجم وليلا بلا صبح % % 23(@)(@@) % لبست 
ms114	 بها ثوب الفخار مجددا % % وغادرتها تلتف في خلق المسح % % 24(@)(@@) % تباكي صدى الهام التي تركت بها % % سيوفك عن ذات المحاسن والملح % % 25(@)(@@) % وعبرة ثكلى ما تقلب ناظرا % % إلى أفق إلا يقول لها سحي % % 26(@)(@@) % وينعى إليها كل بيضة فتنة % % ستتركها قيضا هشيما بلا مح % % 27(@)(@@) % بما قد رأى في كل ماء أممته % % لتشفي منها غلة الظمإ البرح % % 28(@)(@@) % وإن أشرعت من دون مشربه القنا % % وكاشر عنه الأسد دامية الألحي % % 29(@)(@@) % فأي دلاء فيه أدليت ماتحا % % وأية أشطان مددت إلى المتح % % 30(@)(@@) % هوائم بيض لا يصد بها الروى % % وسمر ظماء لا يعللن بالنشح % % PageV01P349 31(@)(@@) % . . . . . . . . . . . . . . . . . % . . . . . . . . . . . . . . . % 32(@)(@@) % . . . . . . . . . . . . . . . . . . % . . . . . . . . . . . . . . . . % PageV01P350 البحر : متقارب تام 1(@)(@@) % أ وفيهن أضحيت يوم الأضاحي % % كتائب مستقدمات التهادي % % 2(@)(@@) % بأجمع مولى لشمل العبيد % % وأخشع عبد لرب العباد % % 3(@)(@@) % فأوسعتهن نظام المصلى % % وقد غص منهن رحب البلاد % % 4(@)(@@) % ملاعبة للصبا بالنواصي % % مسامية للقنا بالهوادي % % 5(@)(@@) % تكاد تفهم فصل الخطاب % % بتعويدها لاسمك المستعاد % % 6(@)(@@) % وعرفانه في شعار الحروب % % وتبيانه في صريخ المنادي % % 7(@)(@@) % وترديده في مجال الطعان % % وتكريره في مكر الطراد % % 8(@)(@@) % وفي كل ذكر وفخر ونشر % % وشكر وشعر وشدو وشاد % % 9(@)(@@) % فلما قضوا بك حق السلام % % ثنوا لك حق سلام معاد % % 10(@)(@@) % فوافى قصورك وفد السلام % % بأيمن حاد إليها وهاد % % PageV01P351 11(@)(@@) % يخوضون نحوك بحر العوالي % % تموج بها أبحر من جياد % % 12(@)(@@) % لملء عيونهم من بهاء % % وملء صدورهم من وداد % % 13(@)(@@) % بمرأى هداهم إلى هدي هود % % وعاد إليهم بأحلام عاد % % 14(@)(@@) % وقد ذكرتهم جفانا نمتك % % إلى كل ملك رفيع العماد % % 15(@)(@@) % مطاعم مدت بها في صحون % % موائد مستبشرات التمادي % % 16(@)(@@) % وكم خط جودك بالمسك فيهم % % شهادته لمليك جواد % % 17(@)(@@) % سطورا محون بياض المشيب % % بنور محامنه لون السواد % % 18(@)(@@) % وراح قرين الشباب النضير % % وفوداه خطا شباب مفاد % % 19(@)(@@) % مشاهد غلفت منها الزمان % % بغالية مسكها من مدادي % % 20(@)(@@) % فأشعرتها كل بر وبحر % % وأنشقتها كل سار وغاد % % PageV01P352 21(@)(@@) % وأتبعتها من كباء الثتاء % % عجاحا يهب إلى كل ناد % % 22(@)(@@) % نوافج مجمرها من ضلوعي % % تؤججها جمرة من فؤادي % % 23 
ms115	(@)(@@) % بما علم الهند أنك أمضى % % غداة الوغى من ظباة الحداد % % 24(@)(@@) % وأن ثناءك أزكى وأذكى % % على الدهر من طيبه المستجاد % % 25(@)(@@) % سوائم فخر علت عن مسيم % % يرود بها مرتع الإقتصاد % % 26(@)(@@) % ودعوى هوى لم يزر في كراه % % خيال ولا خاطر في فؤادب % % 27(@)(@@) % وتلك علاك تهادي العيون % % كواكب مقتربات البعاد % % 28(@)(@@) % أوانس تأبى لها أن تصد % % مقادمها في الوغى أو تصادي % % 29(@)(@@) % كواعب مجدك حليتهن % % بزهر المساعي وبيض الأيادي % % 30(@)(@@) % نجوم تنير بنور الأماني % % وطورا تنوء بغر الغوادي % % PageV01P353 31(@)(@@) % فأول أنوائها منك بشر % % وفي العهود بصوب العهاد % % 32(@)(@@) % حيا صدقه منك في آسم وفعل % % وشاهده في الورى منك باد % % 33(@)(@@) % وسماك ربك مأمون غيث % % على نشره رحمة للعباد % % 34(@)(@@) % غمام يئود متون الرياح % % ويزجيه للروع متن الجواد % % 35(@)(@@) % فمن راحة ريحها الارتياح % % ومن ماء صاد إلى كل صاد % % 36(@)(@@) % وسقيا عنان بثني العنان % % وبارقه في مناط النجاد % % 37(@)(@@) % فأشرق من روضه كل حزن % % وأغدق من وبله كل واد % % 38(@)(@@) % وذاب بأندائه كل فصل % % يكذب فيه حديث الجماد % % 39(@)(@@) % ربيع المصيف ربيع الشتاء % % مريع الحزون مريع الوهاد % % 40(@)(@@) % ومن روضه سروات الكماة % % تثنى على صهوات الجياد % % PageV01P354 41(@)(@@) % ومن زهره سابغات الدروع % % وبيض الصفاح وسمر الصعاد % % 42(@)(@@) % وأينع بها في وقود الطعان % % وأنضر بها في ضرام الجلاد % % 43(@)(@@) % وأي فواتح ورد نضيد % % مواقعها في نحور الأعادي % % 44(@)(@@) % وكم غادرت لمهب الرياح % % سنا جسد شرق بالجساد % % 45(@)(@@) % رياضا قسمت أزاهيرهن % % لعز الموالي وخزي المعادي % % 46(@)(@@) % فأهديتها لأنوف الغناء % % وأرغمت منها أنوف العناد % % 47(@)(@@) % وأوردتها كل بحر يمور % % بما يلبس الشهب لون الوراد % % 48(@)(@@) % ودست بها كل صعب المرام % % وقدت بها كل عاصي القياد % % 49(@)(@@) % إذا ما تنادت لجمع ثنته % % مجيب المنادي ليوم التنادي % % 50(@)(@@) % بهن شعبت عصي الشقاق % % وعنهن أوضحت سبل الرشاد % % PageV01P355 51(@)(@@) % أ فأودعتها في نواصي الرياح % % لتنثرها في أقاصي البلاد % % 52(@)(@@) % فكم أنبت الشرق والغرب منها % % حدائق تغني عن الإرتياد % % 53(@)(@@) % ووقفا على سقيها ماء وجهي % % وفيض دموعي وما في مزادي 
ms116	 % % 54(@)(@@) % وكم حصد الدهر للخلد منها % % ثمار النهى وثمار التهادي % % 55(@)(@@) % فيا أرأس الرؤساء الجدير % % بحكم السداد لقول السداد % % 56(@)(@@) % أيغرب عندك نجم اغترابي % % ومطلعة لك في الأرض باد % % 57(@)(@@) % وأسقي الورى عنك ماء الحياة % % وأرشف منك حميء الثماد % % 58(@)(@@) % وزرعي فيك حصيد الخلود % % وحظي منك لقيط الحصاد % % 59(@)(@@) % سدادا من العوز المستجار % % وأكثره عوز من سداد % % 60(@)(@@) % قضاء له في يد الإقتضاء % % زمام ومن سابق البغي حاد % % PageV01P356 61(@)(@@) % كعلمك من خطب دهر رماني % % بأسهم واش وغاو وعاد % % 62(@)(@@) % يسلون بين الأماني وبيني % % سيوف القلى ورماح البعاد % % 63(@)(@@) % زمان كأن قد تغذى لسعي % % لعاب أفاع وحيات واد % % 64(@)(@@) % فأودع من نفثه حر صدري % % سماما ليالي منها عدادي % % 65(@)(@@) % وأطفأ نوري وناري عليما % % بأن سيضيء الدجى من رمادي % % 66(@)(@@) % وهان عليه نفاقي بفقدي % % لبيع حياتي بيع الكساد % % 67(@)(@@) % ولولا القضاء الذي فل عزمي % % وآد شبا حده متن آدي % % 68(@)(@@) % وأني دنت إلهي بدين % % من الصبر جل عن الإرتداد % % 69(@)(@@) % لغاضت به قطرة من سحابي % % وأودت به شعلة من زنادي % % 70(@)(@@) % وما انفرجت مبهمات الخطوب % % بمثل اشتداد الأمور الشداد % % PageV01P357 71(@)(@@) % فكلني لحاجبك المستجير % % بذمته كل قار وباد % % 72(@)(@@) % ليقسم لي سهم حمدي وشكري % % وينزع سهم الأسى من فؤادي % % 73(@)(@@) % ليقتادني بيد الإصطناع % % ويخلع من يد دهري قيادي % % 74(@)(@@) % ويكتب فوق جبيني ووجهي % % إلى نوب الدهر حيدي حياد % % 75(@)(@@) % وحسبي فإما رباطي أراني % % ثوابي منه وإما جهادي % % 76(@)(@@) % ب فإن شط عن غرب شأوي مداه % % وعادت أماني منه العوادي % % 77(@)(@@) % فأنت عليه دليلي وعوني % % وجدواك ذخري إليه وزادي % % 78(@)(@@) % فلا أبعد الدهر منكم حياة % % تلي نعما مالها من نفاد % % 79(@)(@@) % ولا خذلتكم يد في عنان % % ولا خانكم عاتق في نجاد % % PageV01P358 البحر : بسيط تام 1(@)(@@) % إن يجر زاكي دم للحمد تتلفه % % فابشر بأحمد منه الله يخلفه % % 2(@)(@@) % إما سمحت به للجو يحمله % % طيبا إلى كل روح عنك يتحفه % % 3(@)(@@) % فقد رأى الأرض تأباه فتنكره % % إذ لا سوى دم من عاداك تعرفه % % 4(@)(@@) % وأصبح الجو 
ms117	 منه روضة أنفا % % تبأى بزهرك والأنفاس تقطفه % % 5(@)(@@) % فاسلم فإن كانت الأنفاس طبن به % % فإن أطيب منه فيك يردفه % % PageV01P359 البحر : طويل 1(@)(@@) % سماء العلا منكم وأنت لها بدر % % وأخلاقك الحسنى كواكبها الزهر % % 2(@)(@@) % وقد تم في هذا الورى بك أنعم % % يقصر عن أدنى عوارفها الشكر % % 3(@)(@@) % فمنها النهى والحلم والدين والتقى % % وبذل اللهى والجود والبأس والبر % % 4(@)(@@) % وزحف إلى الأعداء أغراضه العدى % % وسيف عن الإسلام إقدامه النصر % % 5(@)(@@) % وبذلك دون الثغر نفسا عزيزة % % حمت عنه حتى عاد وهي له ثغر % % 6(@)(@@) % وفي سر علم الله لي فيك أنني % % ودادك لي سر وحمدك لي جهر % % 7(@)(@@) % وذكرك لي عز وعزك لي غنى % % وبرك لي عهد وعهدك لي ذخر % % 8(@)(@@) % وإنك أقصى ما بلغت من المنى % % وإنك أسنى ما أفادني الدهر % % 9(@)(@@) % وإني وإن قصرت فيك مدائحي % % فلا قصر بالسلك إن عظم الدر % % 10(@)(@@) % وما قصرت بي همة عنك حرة % % ولا أمل حر ولا منطق حر % % PageV01P360 11(@)(@@) % فإن تقبل العذر المقصر طولها % % فشغلي بشكر الله فيك هو العذر % % 12(@)(@@) % فلا قصر الرحمن عنك سيادة % % تملأها عمرا يمد به عمر % % 13(@)(@@) % . . . . . . . . . . . . % . . . . . . . . . . % 14(@)(@@) % . . . . . . . . . . . . % . . . . . . . . . . . % PageV01P361 البحر : كامل تام 1(@)(@@) % فكأن من حاني السحائب جودها % % وكأن من صعق البروق حسامهاأ % % 2(@)(@@) % فعلى سواكبها إذا جادت ربى % % زهر الرجاء فواترت إنعامها % % 3(@)(@@) % أن تتبع الدلو السجوف رشاءها % % يوم الخوامس والجواد لجامها % % 4(@)(@@) % لم تطلع زهر النجوم سواريا % % إلا رأته في السناء أمامها % % 5(@)(@@) % يا رب شامخة الذوائب والذرى % % أوطأت أعلام الهدى أعلامها % % 6(@)(@@) % أشرعت تنحوها قسي عزائم % % كانت هوادي المقربات سهامها % % 7(@)(@@) % الريح أحسر من يؤم محلها % % والنجم أدنى من يدي من رامها % % 8(@)(@@) % فهتكت بالبيض الرقاق سجوفها % % وفضضت بالجرد العتاق ختامها % % 9(@)(@@) % ورفعت من صلبان بيعة قدسها % % نارا تشب على الضلال ضرامها % % 10(@)(@@) % ولرب حامية الوطيس من الردى % % دلفت وقد كست السماء قتامها % % PageV01P362 11(@)(@@) % أقحمت أجياد الجياد مكرما % % فصلين جاحمها وكنت إمامها % % 12(@)(@@) % فاسعد بسبطي دولة العرب التي % % بسناهما جلت الخطوب ظلامها % % 13(@)(@@) % عبد المليك حسامها وسنانها 
ms118	 % % ومجنها ومليكها وهمامها % % 14(@)(@@) % والقائد الأعلى المملك والذي % % زانت مناقب مجده أيامها % % 15(@)(@@) % لا زال دين الله يأوي ظلكم % % ما ظللت خضر الغصون حمامها % % 16(@)(@@) % ولم تزجري طير السرى بحروفها % % فتنبئك إن يمن فهي سرور % % 17(@)(@@) % تخوفني طول السفار وإنه % % لتقبيل كف العامري سفير % % 18(@)(@@) % دعيني أرد ماء المفاوز آجنا % % إلى حيث ماء المكرمات نمير % % 19(@)(@@) % وأختلس الأيام خلسة فاتك % % إلى حيث لي من غدرهن خفير % % 20(@)(@@) % فإن خطيرات المهالك ضمن % % لراكبها أن الجزاء خطير % % PageV01P363 21(@)(@@) % ولما تدانت للوداع وقد هفا % % بصبري منها أنة وزفير % % 22(@)(@@) % ب تناشدني عهد المودة والهوى % % وفي المهد مبغوم النداء صغير % % 23(@)(@@) % عيي بمرجوع الخطاب ولفظه % % بموقع أهواء النفوس خبير % % 24(@)(@@) % تبوأ ممنوع القلوب ومهدت % % له أذرع محفوفة ونحور % % 25(@)(@@) % فكل مفداة الترائب مرضع % % وكل محياة المحاسن ظير % % 26(@)(@@) % عصيت شفيع النفس فيه وقادني % % رواح لتدآب السرى وبكور % % 27(@)(@@) % وطار جناح الشوق بي وهفت بها % % جوانح من ذعر الفراق تطير % % 28(@)(@@) % لئن ودعت مني غيورا فإنني % % على عزمتي من شجوها لغيور % % 29(@)(@@) % ولو شاهدتني والصواخد تلتظي % % علي ورقراق السراب يمور % % 30(@)(@@) % أسلط حر الهاجرات إذا سطا % % على حر وجهي والأصيل هجير % % PageV01P364 31(@)(@@) % وأستنشق النكباء وهي بوارح % % وأستوطئ الرمضاء وهي تفور % % 32(@)(@@) % وللموت في عيش الجبان تلون % % وللذعر في سمع الجريء صفير % % 33(@)(@@) % لبان لها أني من الضيم جازع % % وأني على مض الخطوب صبور % % 34(@)(@@) % أمير على غول التنائف ماله % % إذا ريع إلا المشرفي وزير % % 35(@)(@@) % ولو بصرت بي والسرى جل عزمتي % % وجرسي لجنان الفلاة سمير % % 36(@)(@@) % وأعتسف الموماة في غسق الدجى % % وللأسد في غيل الغياض زئير % % 37(@)(@@) % وقد حومت زهر النجوم كأنها % % كواعب في خضر الحدائق حور % % 38(@)(@@) % ودارت نجوم القطب حتى كأنها % % كئوس مها والى بهن مدير % % 39(@)(@@) % وقد خيلت طرق المجرة أنها % % على مفرق الليل البهيم قتير % % 40(@)(@@) % وثاقب عزمي والظلام مروع % % وقد غض أجفان النجوم فتور % % PageV01P365 41(@)(@@) % لقد أيقنت أن المنى طوع همتي % % وأني بعطف العامري جدير % % 42(@)(@@) % وأني بذكراه لهمي زاجر 
ms119	 % % وأني منه للخطوب نذير % % 43(@)(@@) % وأي فتى للدين والملك والندى % % وتصديق ظن الراغبين نزور % % 44(@)(@@) % مجير الهدى والدين من كل ملحد % % وليس عليه للضلال مجير % % 45(@)(@@) % تلاقت عليه من تميم ويعرب % % شموس تلالا في العلا وبدور % % 46(@)(@@) % من الحميريين الذين أكفهم % % سحائب تهمي بالندى ونحور % % 47(@)(@@) % ذوو دول الملك الذي سلفت بها % % لهم أعصر موصولة ودهورأ % % 48(@)(@@) % لهم بذل الدهر الأبي قياده % % وهم سكنوا الأيام وهي نفور % % 49(@)(@@) % وهم ضربوا الآفاق شرقا ومغربا % % بجمع يسير النصر حيث يسير % % 50(@)(@@) % وهم يستقلون الحياة لراغب % % ويستصغرون الخطب وهو كبير % % PageV01P366 51(@)(@@) % وهم نصروا حزب النبوة والهدى % % وليس لها في العالمين نصير % % 52(@)(@@) % وهم صدقوا بالوحي لما أتاهم % % وما الناس إلا عاند وكفور % % 53(@)(@@) % مناقب يعيا الوصف عن كنه قدرها % % ويرجع عنها الوهم وهو حسير % % 54(@)(@@) % ألا كل مدح عن مداك مقصر % % وكل رجاء في سواك غرور % % 55(@)(@@) % تمليت هذا العيد عدة أعصر % % تواليك منها أنعم وحبور % % 56(@)(@@) % ولا فقدت أيامك الغر أنفس % % حياتك أعياد لهم وسرور % % 57(@)(@@) % ولما توافوا للسلام ورفعت % % عن الشمس في أفق الشروق ستور % % 58(@)(@@) % وقد قام من زرق الأسنة دونها % % صفوف ومن بيض السيوف سطور % % 59(@)(@@) % رأوا طاعة الرحمن كيف اعتزازها % % وآيات صنع الله كيف تنير % % 60(@)(@@) % وكيف استوى بالبحر والبدر مجلس % % وقام بعبء الراسيات سرير % % PageV01P367 61(@)(@@) % فساروا عجالا والقلوب خوافق % % وأدنوا بطاء والنواظر صور % % 62(@)(@@) % يقولون والإجلال يخرس ألسنا % % وحازت عيون ملأها وصدور % % 63(@)(@@) % لقد حاط أعلام الهدى بك حائط % % وقدر فيك المكرمات قدير % % 64(@)(@@) % مقيم على بذل الرغائب واللهى % % وفكرك في أقصى البلاد يسير % % 65(@)(@@) % وأين انتوى فل الضلالة فانتهى % % وأين جيوش المسلمين تغير % % 66(@)(@@) % وحسبك من خفض النعيم معيدا % % جهاز إلى أرض العدى ونفير % % 67(@)(@@) % فقدها إلى الأعداء شعثا كأنها % % أراقم في شم الربى وصقور % % 68(@)(@@) % فعزمك بالنصر العزيز مخبر % % وسعدك بالفتح المبين بشير % % 69(@)(@@) % وناداك يا بن المنعمين ابن عشرة % % وعبد لنعماك الجسام شكور % % 70(@)(@@) % غني بجدوى راحتيك وإنه % % إلى سبب يدني رضاك فقير % % PageV01P368 71 
ms120	(@)(@@) % ومن دون ستري عفتي وتجملي % % لريب وصرف للزمان يجور % % 72(@)(@@) % وضاءل قدري في ذراك عوائق % % جرت لي برحا والقضاء عسيرب % % 73(@)(@@) % وما شكر النخعي شكري ولا وفى % % وفائي إذ عز الوفاء قصير % % 74(@)(@@) % فقدني لكشف الخطب والخطب معضل % % وكلني لليث الغاب وهو هصور % % 75(@)(@@) % فقد تخفض الأسماء وهي سواكن % % ويعمل في الفعل الصحيح ضمير % % 76(@)(@@) % وتنبو الردينيات والطول وافر % % وينفذ وقع الهم وهو قصير % % 77(@)(@@) % حنانيك في غفران زلة تائب % % وإن الذي يجري به لغفور % % PageV01P369 البحر : كامل تام 1(@)(@@) % لو كان يعدل حاكم في حكمه % % أو كان يقصر ظالم عن ظلمه % % 2(@)(@@) % ما جشم الدنف السقيم ملامة % % تغريالهوى بغرامه وبسقمه % % 3(@)(@@) % هل صم سمع عن جلية عذره % % أو ضاق ذرع عن تغمد جرمه % % 4(@)(@@) % كلفا يكلفه العذول تسليا % % عن حب من صرم السلو بصرمه % % 5(@)(@@) % من عاذري من عاذل عصيانه % % من همتي وصبابتي من همه % % 6(@)(@@) % لما صبوت قضى علي بظنه % % فأجاز في خصم شهادة خصمه % % 7(@)(@@) % يا ويحه لو غالني صرف الردى % % فيبو بإثم المستهام وإثمه % % 8(@)(@@) % إن لم أمت مما أقاسي في الأسى % % وجدا فأوشك أن أموت بزعمه % % 9(@)(@@) % عهدا علي لئن ظفرت بسلوة % % ممن هويت لأعشقن برغمه % % 10(@)(@@) % يا حاجبا تزهى الحجابة والعلا % % وسنا المراتب والقيادة باسمه % % PageV01P370 11(@)(@@) % ملك تحكم في هواه حزمه % % وأباح سيف نداه مهجة حزمه % % 12(@)(@@) % وطما على العافين بحر سماحه % % فحوى الثناء بطمه وبرمه % % 13(@)(@@) % والحلم من ميراث أحنف خاله % % والبأس من ميراث عمرو عمه % % 14(@)(@@) % بأس تميد الأرض من روعاته % % ذعرا وتنهد الجبال لعزمه % % 15(@)(@@) % متقحم الأهوال في ضنك الوغى % % فكأن نفس عدوه في جسمه % % 16(@)(@@) % ضرب الزمان بسيبه وبسيفه % % حتى استقاد لأمره ولحكمه % % 17(@)(@@) % ومضى لإمر الله لما أن مضت % % علياه في مكنون سابق علمه % % 18(@)(@@) % أ متشاكه الحالات من أدواته % % في حربه وخلاله في سلمه % % 19(@)(@@) % فكأن حد سنانه من بأسه % % وكأن صفحة سيفه من حلمه % % 20(@)(@@) % فبهاؤه في نصله وذكاؤه % % في رمحه ومضاؤه في سهمه % % PageV01P371 21(@)(@@) % هدمت صروف الدهر 