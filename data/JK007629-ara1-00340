ms321	 وجدي عن الحزن عن كربي % % 4(@)(@@) % عن السكر عن عقلي عن الشوق عن جوى % % عن الدمع عن جفني عن النارعن قلبي % % 5(@)(@@) % بأن الذي تهواه بين ضلوعكم % % تقلبه الأنفاس جنبا إلى جنب % 6(@)(@@) % فقلت لها : بلغ إليه فإنه % هو الموقد النار التي داخل القلب % 7(@)(@@) % فإن كان إطفاء ، فوصل مخلد ، % وإن كان إحتراق ، فلا ذنب للصب % PageV01P1263 البحر : رمل تام 1(@)(@@) % غادروني بالأثيل والنقا % % أسكب الدمع ، وأشكو الحرقا % % 2(@)(@@) % بأبي من ذبت فيه كمدا % بأبي من مت منه فرقا % % 3(@)(@@) % حمرة الخجلة في وجنته % وضح الصبح يناغي الشفقا % % 4(@)(@@) % قوض الصبر ، وطنب الأسى % % وأنا ما بين هذين لقا % % 5(@)(@@) % من لبثي ، من لوجدي ، دلني % % من لحزني ، من لصب عشقا % % 6(@)(@@) % كلما صنت تباريح الهوى % % فضح الدمع الجوى والأرقا % % 7(@)(@@) % فإذا قلت : هبوا لي نظرة ! % قيل ما تمنع إلا شفقا % % 8(@)(@@) % ما عسى تغنيك منهم نظرة % هي إلا لمح برق برقا % % 9(@)(@@) % لست أنسى إذ حدى الحادي بهم % يطلب البين ويبغي الأبرقا % % 10(@)(@@) % نعقت أغربة البين بهم % لا رعى الله غرابا نعقا % % PageV01P1264 11(@)(@@) % ما غراب البين إلا جمل % سار بالأحباب نصا عنقا % % PageV01P1265 البحر : متقارب تام 1(@)(@@) % حملن على اليعملات الخدورا % % وأودعن فيها الدمى والبدورا % % 2(@)(@@) % وواعدن قلبي أن يرجعوا % % وهل تعد الخود إلا غرورا % % 3(@)(@@) % وحيت بعنابها للوداع % فأذرت دموعا تهيج السعيرا % % 4(@)(@@) % فلما تولت ، وقد يممت % تريد الخورنق ، ثم السديرا % % 5(@)(@@) % دعوت ثبورا على إثرهم % فردت وقالت : أتدعوا ثبورا % % 6(@)(@@) % فلا تدعون بها واحدا % ولكنما ادع تبورا كثيرا % % 7(@)(@@) % ألا يا حمام الأراك قليلا ، % فما زادك البين إلا هديرا % % 8(@)(@@) % وتنوحك يا أيهذا الحمام % يثير المشوق يهيج الغيورا % % 9(@)(@@) % يذيب الفؤاد يذود الرقاد % يضاعف أشواقنا والزفيرا % % 10(@)(@@) % يحوم الحمام لنوح الحمام % فيسأل منه البقاء يسيرا % % PageV01P1266 11(@)(@@) % عسى نفحة من صبا حاجر % تسوق إلينا سحابا مطيرا % % 12(@)(@@) % تروي بها أنفسا قد ظمئن % فما ازداد سحبك إلا نفورا % % 13(@)(@@) % فيا راعي النجم كن لي نديما % ويا ساهر البرق كن لي سميرا % % 14(@)(@@) % أيا 
ms322	 راقد الليل هنئته ، % فقل للممات عمرت القبورا % % 15(@)(@@) % فلو كنت تهوى الفتاة العروبا % % لنلت النعيم بها والسرورا % % 16(@)(@@) % تعاطي الحسان خمور الخمار ، % تناجي الشموس تناغي البدورا % % PageV01P1267 البحر : بسيط تام 1(@)(@@) % يا حادي العيس لا تعجل بها وقفا ، % فإنني زمن في إثرها غادي % % 2(@)(@@) % قف بالمطايا ، وشمر من أزمتها % % بالله بالوجد بالتبريح يا حادي % % 3(@)(@@) % نفسي تريد ، ولكن لا تساعدها % % رجلي ، فمن لي بإشفاق وإسعاد % 4(@)(@@) % ما يفعل الصنع النحرير في شغل % آلاته أذنت فيه بإفساد % 5(@)(@@) % عرج ، ففي أيمن الوادي خيامهم ، % لله درك ما تحويه يا وادي % % 6(@)(@@) % جمعت قوما هم نفسي وهم نفسي % % وهم سواد سويدا خلب أكبادي % % 7(@)(@@) % لا در در الهوى أن لم أمت كمدا % بحاجر أو بسلع أو بأجياد % PageV01P1268 البحر : كامل تام 1(@)(@@) % قف بالمنازل ، واندب الأطلال % وسل الربوع الدارسات سؤالا % % 2(@)(@@) % أين الأحبة ، أين سارت عيسهم % % هاتيك تقطع في اليباب ألالا % % 3(@)(@@) % مثل الحدائق في السراب تراهم % الآل يعظم في العيون ألالا % % 4(@)(@@) % ساروا يريدون العذيب ليشربوا % % ماء به مثل الحياة زلالا % % 5(@)(@@) % فقفوت أسأل عنهم ريح الصبا : % هل خيموا أو استظلوا الضالا % % 6(@)(@@) % قالت تركت على زرود قبابهم % % والعيس تشكو من سراه كلالا % % 7(@)(@@) % قد أسدلوا فوق القباب مضاربا % يسترن من حر الهجير جمالا % % 8(@)(@@) % فانهض إليهم طالبا آثارهم % وارقل يعيسك نحوهم إرقالا % % 9(@)(@@) % فإذا وقفت على معالم حاجر % وقطعت أغوارا بها وجبالا % % 17(@)(@@) % قربت منازلهم ، ولاحت نارهم % % نارا قد اشعلت الهوى إشعالا % % PageV01P1269 18(@)(@@) % فأنخ بها لا يرهبنك أسدها ، % الاشتياق يريكها أشبالا % % PageV01P1270 البحر : خفيف تام 1(@)(@@) % مرضى من مريضة الأجفان % عللاني بذكرها عللاني % % 2(@)(@@) % هفت الورق بالرياض وناحت ، % شجو هذا الحمام مما شجاني % % 3(@)(@@) % بأبي طفلة لعوب تهادى % % من بنات الخدور بين الغواني % % 4(@)(@@) % طلعت في الخيام شمسا ، فلما % % أفلت أشرقت بأفق جناني % % 5(@)(@@) % يا طلولا برامة دارسات ، % كم رأت من كواعب وحسان % 6(@)(@@) % بأبي ثم بي غزال ربيب % يرتعي بين أضلعي في أمان % 7(@)(@@) % ما عليه من نارها ، فهو نور ، % هكذا النور مخمد 
ms323	 النيران % 8(@)(@@) % يا خليلي عرجا بعناني ، % لأرى رسم دارها بعياني % % 9(@)(@@) % فإذا ما بلغتما الدار حطا ، % وبها صاحباي فليبكياني % % 10(@)(@@) % وقفا بي على الطلول قليلا ، % نتباكى ، بل أبكي مما دهاني % % PageV01P1271 11(@)(@@) % الهوى راشقي بغير سهام ، % الهوى قاتلي بغير سنان % 12(@)(@@) % عرفاني إذا بكيت لديها ، % تسعداني على البكا تسعداني % % 13(@)(@@) % واذكرا لي حديث هند ولبنى % % وسليمى وزينب وعنان % 14(@)(@@) % ثم زيدا من حاجر وزرود % خبرا عن مراتع الغزلان % 15(@)(@@) % واندباني بشعر قيس وليلى ، % وبمي ، والمبتلى غيلان % 16(@)(@@) % طال شوقي لطفلة ذات نثر % ونظام ومنبر وبيان % 17(@)(@@) % من بنات الملوك من دار فرس ، % من أجل البلاد من أصبهان % 18(@)(@@) % هي بنت العراق بنت إمامي ، % وأنا ضدها سليل يماني % % 19(@)(@@) % هل رأيتم ، يا سادتي ، أو سمعتم % أن ضدين قط يجتمعان % 20(@)(@@) % لو ترانا برامة نتعاطى % % أكؤسا للهوى بغير بنان % PageV01P1272 21(@)(@@) % والهوى بيننا يسوق حديثا % طيبا مطربا بغير لسان % 22(@)(@@) % لرأيتم ما يذهب العقل فيه % يمن والعراق معتنقان % 23(@)(@@) % كذب الشاعر الذي قال قبلي ، % وبأحجار عقله قد رماني % % 24(@)(@@) % أيها المنكح الثريا سهيلا ! % عمرك الله كيف يلتقيان % 25(@)(@@) % هي شامية ، إذا ما استقلت % وسهيل ، إذا استهل يماني % % PageV01P1273 البحر : طويل 1(@)(@@) % أيا روضة الوادي أجب ربة الحمى ، % وذات الثنايا الغر ، يا روضة الوادي % % 2(@)(@@) % وظلل عليها من ظلالك ساعة % قليلا ، إلى أن يستقر بها النادي % % 3(@)(@@) % وتنصب بالأجواز منك خيامها % % فما شئت من طل غذاء لمنآد % 4(@)(@@) % وما شئت من وبل ، وما شئت من ندى ، % سحاب على باناتها رائح غاد % 5(@)(@@) % وما شئت من ظل ظليل ، ومن جنى % % شهي لدى الجاني يميس بمياد % 6(@)(@@) % ومن ناشد فيها زرود ورملها ، % ومن منشد حاد ومن منشد هاد % PageV01P1274 البحر : كامل تام 1(@)(@@) % عج بالركائب نحو برقة ثهمد ، % حيث القضيب الرطب والروض الندي % % 2(@)(@@) % حيث البروق بها تريك وميضها % % حيث السحاب بها يروح ويغتدي % % 3(@)(@@) % وارفع صويتك بالسحير مناديا % بالبيض والغيد الحسان الخرد % 4(@)(@@) % من كل فاتكة بطرف أحور ، % من كل ثانية يجيد أغيد % 5(@)(@@) % تهوي فتقصد كل قلب 
ms324	 هائم ، % يهوى الحسان براشق ومهند % 6(@)(@@) % تعطو برخص كالدمقس منعم % بالند والمسك الفتيق مقرمد % 7(@)(@@) % ترنو ، إذا لحظت بمقلة شادن ، % يعزى لمقلتها سواد الإثمد % 8(@)(@@) % بالغنج ، والسحر القتول مكحل % بالتيه والحسن البديع مقلد % 9(@)(@@) % هيفاء ما تهوى الذي أهوى ولا % % تف للذي وعدت بصدق الموعد % 10(@)(@@) % سحبت غديرتها شجاعا أسودا ، % لتخيف من يقفو بذاك الأسود % PageV01P1275 11(@)(@@) % والله ما خفت المنون ، وإنما % % خوفي أموت ، فلا أراها في غد % PageV01P1276 البحر : متقارب تام 1(@)(@@) % سحيرا أناخوا بوادي العقيق % وقد قطعوا كل فج عميق % 2(@)(@@) % فما طلع الفجر إلا وقد % رأوا علما لا يحا فوق نيق % 3(@)(@@) % إذا رامه النسر لم يستطع ، % فمن دونه كان بيض الأنوق % 4(@)(@@) % عليه زخارف منقوشة % رفيع القواعد مثل العقوق % 5(@)(@@) % وقد كتبوا أسطرا أودعوها ، % ألا من لصب غريب مشوق % 6(@)(@@) % له همة فوق هذا السماك ، % ويوطأ بالخف وطأ الحريق % 7(@)(@@) % ومسكنه عند هذا العقاب ، % وقد مات في الدمع موت الغريق % 8(@)(@@) % قد أسلمه الحب للحادثات ، % بهذا المكان بغير شفيق % 9(@)(@@) % فيا واردين مياه القليب ، % ويا ساكنين بوادي العقيق % 10(@)(@@) % ويا طالبا طيبة زائرا ، % ويا سالكين بهذا الطريق % PageV01P1277 11(@)(@@) % أفيقوا علينا ، فإنا رزئنا % % بعيد السحير قبيل الشروق % 12(@)(@@) % ببيضاء غيداء بهتانة ، % تضوع نشرا كمسك فتيق % 13(@)(@@) % تمايل سكرى ، كمثل الغصون ، % ثنتها الرياح كمثل الشقيق % 14(@)(@@) % بردف مهول كدعص النقا % % ترجرج مثل سنام الفنيق % 15(@)(@@) % فما لامني في هواها عذول ، % ولا لامني في هواها صديقي % % 16(@)(@@) % ولو لامني في هواها عذول % لكان جوابي إليه شهيقي % % 17(@)(@@) % فشوقي ركابي ، وحزني لباسي ، % ووجدي صبوحي ، ودمعي غبوفي % % PageV01P1278 البحر : كامل تام 1(@)(@@) % قف بالطول الدارسات بلعلع % واندب أحبتنا بذاك البلقع % 2(@)(@@) % قف بالديار ونادها متعجبا % منها بحسن تلطف بتفجع % 3(@)(@@) % عهدي بمثلي عند بانك قاطفا % ثمر الخدود وورد روض أينع % % 4(@)(@@) % كل الذي يرجو نوالك أمطروا % % ما كان برقك خلبا إلا معي % % 5(@)(@@) % قالت : نعم ، قد كان ذاك الملتقى % % في ظل أفناني بأخصب موضع % 6(@)(@@) % إذا كان برقي من بروق مباسم % واليوم برقي لمع 
ms325	 هذا اليرمع % 7(@)(@@) % فاعتب زمانا مالنا من حيلة % في دفعه ، ما ذنب منزل لعلع % 8(@)(@@) % فعذرتها لما سمعت جوابها % % تشكو كما أشكو بقلب موجع % 9(@)(@@) % وسألتها لما رأيت ربوعها % % مسرى الرياح الذاريات الأربع % 10(@)(@@) % هل أخبرتك رياحهم بمقيلهم ؟ % قالت : نعم قالوا : بذات الأجرع % PageV01P1279 11(@)(@@) % حيث الخيام البيض تشرق للذي % % تحويه من تلك الشموس الطلع % PageV01P1280 البحر : رجز تام 1(@)(@@) % واحربا من كبدي ، واحربا ، % واطربا من خلدي واطربا % % 2(@)(@@) % في كبدي نار جوى محرقة % في خلدي بدر دجى قد غربا % 3(@)(@@) % يا مسك ، يا بدر ويا غصن نقا ، % ما أورقا ، ما أنورا ، ما أطيبا % % 4(@)(@@) % يا مبسما أحببت منه الحببا ، % ويا رضابا ذقت منه الضربا % % 5(@)(@@) % يا قمرا في شفق من خفر % في خده لاح لنا منتقبا % % 6(@)(@@) % لو أنه يسفر عن برقعه % كان عذابا ، فلهذا احتجبا % % 7(@)(@@) % شمس ضحى في فلك طالعة ، % غصن نقا في روضة نصبا % % 8(@)(@@) % ظلت لها من حذر مرتقبا % % والغصن أسقيه سماء صيبا % % 9(@)(@@) % إن طلعت كانت لعيني عجبا % أو غربت كانت لحيني سببا % % 10(@)(@@) % مذ عقد الحسن على مفرقها % % تاجا من التبر عشقت الذهبا % % PageV01P1281 11(@)(@@) % لو أن إبليس رأى من آدم % نور محياها عليه ما أبى % % 12(@)(@@) % لو أن إدريس رأى ما رقم ال % % حسن بخديها إذا ما كتبا % % 13(@)(@@) % لو أن بلقيس رأت رفرفها % % ما خطر العرش ولا الصرح ببا % % 14(@)(@@) % يا سرحة الوادي ويا بان الغضا % % أهدوا لنا من نشركم مع الصبا % % 15(@)(@@) % ممسكا يفوح رياه لنا % % من زهر أهضامك أو زهر الربى % % 16(@)(@@) % يا بانة الوادي أرينا فننا % في لبن أعطاف لها أوقضبا % % 17(@)(@@) % ريح صبا تخبر عن عصر صبا % بحاجر أو بمنى أو بقبا % % 18(@)(@@) % أو بالنقا ، فالمنحني عند الحمى % % أو لعلع حيث مراتع الظبا % % 19(@)(@@) % لا عجب لا عجب لا عجبا % % من عربي يتهاوى العربا % % 20(@)(@@) % يفنى ، إذا ما صدحت قمرية % بذكر من يهواه فيه طربا % % PageV01P1282 البحر : كامل تام 1(@)(@@) % بالجزع بين الأبرقين الموعد % فأنخ ركائبنا ، فهذا المورد % 2(@)(@@) % لا تطلبن 
ms326	 ، ولاتنادي بعده % يا حاجر ، يا بارق ، يا ثهمد % 3(@)(@@) % والعب كما لعبت أوانس نهد ، % وارتع كما رتعت ظباء شرد % 4(@)(@@) % في روضة غناء صاح ذئابها ، % فأجابه طربا هناك مغرد % 5(@)(@@) % رقت حواشيها ورق نسيمها % % فالغيم يبرق والغمامة ترعد % 6(@)(@@) % والودق ينزل من خلال سحابه % كدموع صب للفراق تبدد % 7(@)(@@) % واشرب سلافة خمرها بخمارها ، % واطرب على غرد هنالك تنشد % 8(@)(@@) % وسلافة من عهد آدم أخبرت % عن جنة المأوى حديثا يسند % 9(@)(@@) % إن الحسان تفلنها من ريقه % كالمسك جاد بها علينا الخرد % PageV01P1283 البحر : كامل تام 1(@)(@@) % ياأيها البيت العتيق تعالى % % نور لكم بقلوبنا يتلالا % % 2(@)(@@) % أشكو إليك مفاوزا قد جبتها ، % أرسلت فيها أدمعي إرسالا % % 3(@)(@@) % أمسي وأصبح لا ألذ براحة ، % أصل البكور وأقطع الآصال % 4(@)(@@) % إن النياق ، وإن أضر بها الوجى % % تسري وترفل في السرى إرفالا % % 5(@)(@@) % هذي الركاب إليكم سارت بنا % % شوقا ، وما ترجو بذاك وصالا % % 6(@)(@@) % قطعت إليك سباسبا ورمالا % وجدا ، وما تشكو لذاك كلالا % % 7(@)(@@) % ما تشتكي ألم الوجى ، وأنا الذي % % أشكو الكلال ، لقد أتيت محالا % % PageV01P1284 البحر : مجزوء الرجز 1(@)(@@) % بين النقا ولعلع % ظباء ذات الأجرع % 2(@)(@@) % ترعى بها في خمر % خمائلا وترتعي % % 3(@)(@@) % ما طلعت أهلة % بأفق ذاك المطلع % 4(@)(@@) % إلا وددت أنها % % من حذر لم تطلع % 5(@)(@@) % ولا بدت لامعة % من برق ذاك اليرمع % 6(@)(@@) % إلا اشتهيت أنها % % لما بنا لم تلمع % 7(@)(@@) % يا دمعتي فانسكبي ، % يا مقلتي لا تقلعي % % 8(@)(@@) % يا زفرتي خذ صعدا ، % يا كبدي تصدعي % % 9(@)(@@) % وأنت يا حادي اتئد ، % فالنار بين أضلعي % % 10(@)(@@) % قد فنيت مما جرى % % خوف الفراق أدمعي % % PageV01P1285 11(@)(@@) % حتى إذا حل النوى % % لم تلق عينا تدمع % 12(@)(@@) % فارحل إلى وادي اللوى ، % مرتعهم ومصرعي % % 13(@)(@@) % إن به أحبتي % % عند ياه الأجرع % 14(@)(@@) % ونادهم : من لفتى % % ذي لوعة مودع % 15(@)(@@) % رمت به أشجانه % بهماء رسم بلقع % 16(@)(@@) % يا قمرا تحت دجى % خذ منه شيئا ودع % 17(@)(@@) % وزوديه نظرة % من خلف ذاك البرقع % 18(@)(@@) % لأنه يضعف عن % درك الجمال الأروع % 19(@)(@@) % أو علليه 
ms327	 بالمنى % % عساه يحيا ويعي % % 20(@)(@@) % ما هو إلا ميت % بين النقا ولعلع % PageV01P1286 21(@)(@@) % فمت يأسا وأسى % % كما أنا في موضعي % % 22(@)(@@) % ما صدقت ريح الصبا % % حين أتت بالخدع % 23(@)(@@) % قد تكذب الريح إذا % % تسمع ما لم تسمع % PageV01P1287 البحر : كامل تام 1(@)(@@) % بأبي الغصون المايسات عواطفا % العاطفات على الخدود سوالفا % % 2(@)(@@) % المرسلات من الشعور غدائرا % % اللينات معاقدا ومعاطفا % 3(@)(@@) % الساحبات من الدلال ذلاذلا % % اللابسات من الجمال مطارفا % % 4(@)(@@) % الباخلات بحسنهن صيانة ، % الواهبات متالدا ومطارفا % % 5(@)(@@) % المونقات مضاحكا ومباسما ، % الطيبات مقبلا ومراشفا % % 6(@)(@@) % الناعمات مجردا والكاعبات ، % منهدا ، والمهديات ظرائفا % % 7(@)(@@) % الخالبات بكل سحر معجب % عند الحديث مسامعا ولطائفا % % 8(@)(@@) % الساترات من الحياء محاسنا ، % تسبى بها القلب التقي الخائفا % % 9(@)(@@) % المبديات من الثغور لآليا % تشفي بريقتها ضعيفا تالفا % % 10(@)(@@) % الراميات من العيون رواشقا % قلبا خبيرا بالحروب مثاقفا % % PageV01P1288 11(@)(@@) % المطلعات من الجيوب أهلة % لا يلفين مع التمام كواسفا % % 12(@)(@@) % المنشيات من الدموع سحائبا ، % المسمعات من الزفير قواصفا % % 13(@)(@@) % ياصاحبي ! بمهجتي خمصانة % أهدت إلي أياديا وعوارفا % % 14(@)(@@) % نظمت نظام الشمل ، فهي نظامنا ، % عربية عجماء تلهي العارفا % % 15(@)(@@) % مهما رنت سلت عليك صوارما ، % ويريك مبسمها بريقا خاطفا % % 16(@)(@@) % يا صاحبي ! قفا بأكناف الحمى % % من حاجز ، يا صاحبي ، قفا قفا % % 17(@)(@@) % حتى أسائل أين سارت عيسهم ، % فقد اقتحمت معاطبا ومتالفا % % 18(@)(@@) % ومعالما ومجاهلا بشملة ، % تشكو الوجى ، وسباسبا وتنايفا % % 19(@)(@@) % مطوية الأقراب أذهب سيرها % % بحثيثه منها قوى وسدايفا % % 20(@)(@@) % حتى وقفت بها برملة حاجر ، % فرأيت نوقا بالأثيل خوالفا % % PageV01P1289 21(@)(@@) % يقتادها قمر عليه مهابة % فطويت من حذر عليه شراسفا % % 22(@)(@@) % قمر تعرض في الطواف ، فلم أكن % % بسواه عند طوافه بي طائفا % % 23(@)(@@) % يمحو بفضل برده آثاره % فتحار لو كنت الدليل القائفا % % PageV01P1290 البحر : رمل تام 1(@)(@@) % بأثيلات النقا سرب قطا ، % ضرب الحسن عليها طنبا % % 2(@)(@@) % وبأجواز الفلا من إضم ، % نعم ترعى لديها وظبا % % 3(@)(@@) % يا خليلي قفا واستنطقا % % رسم دار بعدهم قد خربا % % 4(@)(@@) % واندبا قلب فتى فارقه ، % يوم بانوا ، وابكيا وانتحبا % % 5(@)(@@) % عله يخبر حيث يمموا % % ألجرعاء الحمى ، أو 
ms328	 لقبا % % 6(@)(@@) % رحلوا العيس ، ولم أشعر بهم ، % ألسهو كان أم طرف نبا % % 7(@)(@@) % لم يكن ذاك ، ولا هذا ، وما % % كان إلا وله قد غلبا % % 8(@)(@@) % يا هموما شردت وافترقت % خلفهم تطلبهم أيدي سبا % % 9(@)(@@) % أي ريح نسمت ناديتها % % يا شمال ، يا جنوب ، يا صبا % % 10(@)(@@) % هل لديكم خبر مما نبا % % قد لقينا من نواهم نصبا % % PageV01P1291 11(@)(@@) % أسندت ريح الصبا أخبارها % % عن نبات الشيح عن زهر الربى % % 12(@)(@@) % إن من أمرضه داء الهوى % % فليعلل بأحاديث الصبا % % 13(@)(@@) % ثم قالت : يا شمال خبري % % مثل ما خبرته أو أعجبا % % 14(@)(@@) % ثم أنت يا جنوب حدثي % % مثل ما حدثته أو أعذبا % % 15(@)(@@) % قالت : الشمال عندي فرج % شاركت فيه الشمال الأزيبا % % 16(@)(@@) % كل سوء في هواهم حسنا % % وعذاب برضاهم عذبا % % 17(@)(@@) % فإلى ما وعلى ما ولما % % تشتكي البث وتشكو الوصبا % % 18(@)(@@) % وإذا ما وعدوكم ما ترى % % برقه إلا بريقا خلبا % % 19(@)(@@) % رقم الغيم على ردن الغما % % من سنا البرق طرازا مذهبا % % 20(@)(@@) % فجرت أدمعها منها على % % صحن خديها ، فأذكت لهبا % % PageV01P1292 21(@)(@@) % وردة نابتة من أدمع % نرجس تمطر غيثا عجبا % % 22(@)(@@) % ومتى رمت جناها أرسلت % % عطف صدغيها عليها عقربا % % 23(@)(@@) % تشرق الشمس إذا ما ابتسمت ، % رب ما أنور ذاك الحببا % % 24(@)(@@) % يطلع الليل ، أذا ما أسدلت % فاحما جثلا أثيثا غيهبا % % 25(@)(@@) % يتجارى النحل مهما تفلت % رب ما أعذب ذاك الشنبا % % 26(@)(@@) % وإذا مالت أرتنا فننا ، % أو رنت سالت من اللحظ ظبى % % 27(@)(@@) % كم تناغي بالنقا من حاجر % يا سليل العربي العربا % % 28(@)(@@) % أنا إلا عربي ، ولذا % % أعشق البيض وأهوى العربا % % 29(@)(@@) % لا أبالي شرق الوجد بنا % % حيث ما كانت به ، أو غربا % % 30(@)(@@) % كلما قلت : ألا ، قالوا : أما % % وإذا ما قلت : هل ؟ قالوا : أبى % % PageV01P1293 31(@)(@@) % ومتى ما أنجدوا أو أتهموا % % أقطع البيد أحث الطلبا % % 32(@)(@@) % سامري الوقت قلبي ، كلما % % أبصر الآثار يبغي المذهبا % % 33(@)(@@) % وإذا هم شرقوا ، أو غربوا % % كان ذو القرنين يقفو السببا % % 34(@)(@@) % كم دعونا لوصال رغبا % كم دعونا من فراق رهبا % % 35(@)(@@) % يا 
ms329	 بني الزوراء هذا قمر % عندكم لاح ، وعندي غربا % % 36(@)(@@) % حربي ، والله منه حربي ، % كم أنادي خلفه : وا حربا % % 37(@)(@@) % لهف نفسي ، لهف نفسي لفتى % كلما غنى حمام غيبا % % PageV01P1294 البحر : متقارب تام 1(@)(@@) % أضاء بذات الأضا بارق % من النور في جوها خافق % 2(@)(@@) % وصلصل رعد مناجاته ، % فأرسل مدراره الوادق % 3(@)(@@) % تنادوا : أنيخوا ، فلم يسمعوا % % فصحت من الوجد : يا سائق % 4(@)(@@) % ألا فانزلوا ها هنا ، وارتعوا ، % فإني بمن عندكم وامق % 5(@)(@@) % بهيفاء غيداء رعبوبة ، % فؤاد الشجي لها تائق % 6(@)(@@) % يفوح الندى لدى ذكرها ، % فكل لسان بها ناطق % 7(@)(@@) % فلو أن مجلسها هضمة ، % ومعقدها جبل حالق % 8(@)(@@) % لكان القرار بها حالقا ، % ولن يدرك الحالق الرامق % 9(@)(@@) % فكل خراب بها عامر % وكل سراب بها غادق % 10(@)(@@) % وكل رياض بها زاهر ، % وكل شراب بها رائق % PageV01P1295 11(@)(@@) % فليلي من وجهها مشرق ، % ويومي من شعرها غاسق % 12(@)(@@) % لقد فلقت حبة القلب إذ % % رماها بأسهمها الفالق % 13(@)(@@) % عيون تعودن رشق الحشا ، % فليس يطيش لها راشق % 14(@)(@@) % فما هامة في خراب البقاع ، % ولا ساق حر ، ولا ناعق % 15(@)(@@) % بأشام من باذل رحلوا ، % ليحمل من حسنه فائق % 16(@)(@@) % ويترك صبا بذات الأضا % % قتيلا ، وفي حبهم صادق % PageV01P1296 البحر : طويل 1(@)(@@) % يذكرني حال الشبيبة والشرخ ، % حديثا لنا بين الحديثة والكرخ % 2(@)(@@) % فقلت لنفسي فيه خمسين حجة ، % وقد صرت من طول التفكر كالفرخ % 3(@)(@@) % تذكرني أكناف سلع وحاجر % وتذكر لي حال الشبيبة والشرخ % 4(@)(@@) % وسوق المطايا منجدا ، ثم متهما ، % وقد حي لها نار العفار مع المرخ % PageV01P1297 البحر : وافر تام 1(@)(@@) % أطارح كل هاتفة بأيك % على فنن بأفنان الشجون % 2(@)(@@) % فتبكي إلفها من غير دمع % ودمع الحزن يهمل من جفوني % % 3(@)(@@) % أقول لها ، وقد سمحت جفوني % % بأدمعها تخبر عن شؤوني % % 4(@)(@@) % أعندك بالذي أهواه علم ، % وهل قالوا بأفياء الغصون % PageV01P1298 البحر : كامل تام 1(@)(@@) % عند الجبال من كثيب زرود % صيد وأسد من لحاظ الغيد % 2(@)(@@) % صرعى ، وهم أبناء ملحمة الوغى ، % أين الأسود من العيون السود % 3(@)(@@) % فتكت بهم لحظاتهن ، وحبذا % % تلك الملاحظ من بنات الصيد 
ms330	 % PageV01P1299 البحر : طويل 1(@)(@@) % ثلاث بدور ما برزن بزينة % خرجن إلى التنعيم معتجرات % 2(@)(@@) % حسرن عن امثال الشموس إضاءة % ولبين بالإهلال معتمرات % 3(@)(@@) % وأقبلن يمشين الرويدا كمثل ما % % تمشي القطا في ألحف الحبرات % PageV01P1300 البحر : طويل 1(@)(@@) % ألا يا ثرى نجد تباركت من نجد ، % سقتك سحاب المزن جودا على جود % 2(@)(@@) % وحياك من أحياك خمسين حجة % بعود على بدء ، وبدء على عود % 3(@)(@@) % قطعت إليها كل قفر ومهمة % على الناقة الكوماء والجمل العود % 4(@)(@@) % إلى أن تراءى البرق من جانب الحمى % % وقد زادني مسراه وجدا على وجدي % % PageV01P1301 البحر : رمل تام 1(@)(@@) % يا خليلي ألما بالحمى ، % واطلبا نجدا وذاك العلما % % 2(@)(@@) % وردا ماء بخيمات اللوى % % واستظلا ضالها والسلما % % 3(@)(@@) % فإذا ما جئتما وادي منى ، % فالذي قلبي به قد خيما % % 4(@)(@@) % أبلغا عني تحيات الهوى ، % كل من حل به أو سلما % % 5(@)(@@) % واسمعا ماذا يجيبون به % واخبرا عن دنف القلب بما % % 6(@)(@@) % يشتكيه من صبابات الهوى % % معلنا مستخبرا مستفهما % % PageV01P1302 البحر : طويل 1(@)(@@) % أحب بلاد الله لي ، بعد طيبة % ومكة والأقصى ، مدينة بغدان % 2(@)(@@) % وما لي لا أهوى السلام ، ولي بها % % إمام هدى ديني وعقدي وإيماني % % 3(@)(@@) % وقد سكنتها من بنيات فارس % لطيفة إيماء مريضة أجفان % 4(@)(@@) % تحيي فتحيى من أماتت بلحظها % % فجاءت بحسنى بعد حسن وإحسان % PageV01P1303 البحر : بسيط تام 1(@)(@@) % نفسي الفداء لبيض خرد عرب % لعبن بي عند لثم الركن والحجر % 2(@)(@@) % ما تستدل ، إذا ما تهت خلفهم % إلا بريحهم من طيب الأثر % 3(@)(@@) % ولا دجا بي ليل ما به قمر % إلا ذكرتهم فسرت في القمر % 4(@)(@@) % وإنما حين أمسي في ركابهم % فالليل عندي مثل الشمس في البكر % 5(@)(@@) % غازلت من غزلي منهن واحدة % حسناء ، ليس لها أخت من البشر % 6(@)(@@) % إن اسفرت عن محياها أرتك سنا % مثل الغزالة إشراقا بلا غبر % 7(@)(@@) % للشمس غرتها ، لليل طرتها % % شمس وليل معا من أعجب الصور % 8(@)(@@) % فنحن بالليل في ضوء النهار بها ؛ % ونحن في الظهر في ليل من الشعر % PageV01P1304 البحر : خفيف تام 1(@)(@@) % طلعت بين أذرعات 
ms331	 وبصرى % % بنت عشر وأربع لي بدرا % % 2(@)(@@) % قد تعالت على الزمان جلالا ، % وتسامت عليه فخرا وكبرا % % 3(@)(@@) % كل بدر إذا تناهى كمالا % جاءه نقصه ليكمل شهرا % % 4(@)(@@) % غير هذي ، فما لها حركات % في بروج ، فما تشفع وترا % % 5(@)(@@) % حقة أودعت عبيرا ونشرا ، % روضة أنبتت ربيعا وزهرا % % 6(@)(@@) % انتهى الحسن فيك أقصى مداه % ما بوسع الإمكان مثلك أخرى % % PageV01P1305 البحر : متقارب تام 1(@)(@@) % رعى الله طيرا على بانة % قد افصح لي عن صحيح الخبر % 2(@)(@@) % بأن الأحبة شدوا على % % رواحلهم ، ثم راحوا سحر % 3(@)(@@) % فسرت وفي القلب من أجلهم % جحيم لبينهم تستعر % 4(@)(@@) % أسابقهم في ظلام الدجى ، % أنادي بهم ثم أقفو الأثر % 5(@)(@@) % وما لي دليل على إثرهم % سوى نفس من هواهم عطر % 6(@)(@@) % رفعن السجاف أضاء الدجى ، % فسار الركاب لضوء القمر % 7(@)(@@) % فأرسلت دمعي أمام الركاب ، % فقالوا : متى سال هذا النهر ؟ % 8(@)(@@) % ولم يستطيعوا عبورا له % فقلت : دموعي جرين درر % 9(@)(@@) % كأن الرعود للمع البروق % % وسير الغمام لصوب المطر % 10(@)(@@) % وجيب القلوب لبرق الثغور ، % وسكب الدموع لركب نفر % PageV01P1306 11(@)(@@) % فيا من يشبه لين القدود % بلين القضيب الرطيب النضر % 12(@)(@@) % فلو عكس الأمر مثل الذي % % فعلت لكان سليم النظر % 13(@)(@@) % فلين الغصون كلين القدود % وورد الرياض كورد الخفر % PageV01P1307 البحر : رمل تام 1(@)(@@) % يا أولى الألباب ، يا أولى النهى % % همت ما بين المهاة والمها % % 2(@)(@@) % من سها عن السها فما سها % % من سها عن المهاة قد سها % % 3(@)(@@) % سر به بسربه لسربه ، % فاللهى تفتح بالحمد اللها % % 4(@)(@@) % إنها من فتيات عرب ، % من بنات الفرس أصلا إنها % % 5(@)(@@) % نظم الحسن من الدر لها % % أشنبا أبيض صافي كالمها % % 6(@)(@@) % رابني منها سفور راعني % % عنده منها جمال وبها % % 7(@)(@@) % فأنا ذو الموتتين منهما ، % هكذا القرآن قد جاء بها % % 8(@)(@@) % ققلت : ما بال سفور راعني % % موعد الأقوام إشراق المها % % 9(@)(@@) % قلت : إني في حمى من فاحم % ساترا فلترسليه عندها % % 10(@)(@@) % شعرنا هذا بلا قافية % إنما قصدي منه حرف ها % % PageV01P1308 11(@)(@@) % غرضي لفظة ها من أجلها % % لست أهوى 
ms332	 البيع هاوها % % PageV01P1309 البحر : طويل 1(@)(@@) % ولا أنس يوما عند وانة منزلي % % وقولي لركب رائحين ونزل % 2(@)(@@) % أقيموا علينا ساعة نشتفي بها ، % فإني ، ومن أهواهم في تعلل % 3(@)(@@) % فإن رحلوا ساروا بأيمن طائر % وإن نزلوا حلوا بأخصب منزل % 4(@)(@@) % وبالشعب من وادى قناة لقيتهم % وعهدي بهم بين النقا والمشلل % 5(@)(@@) % يراعون مرعى العيس حيث وجدنه ، % وليس يراعوا قلب صب مضلل % 6(@)(@@) % فيا حادي الأجمال رفقا على فتى ، % تراه لدى التوديع كاسر حنظل % 7(@)(@@) % يخالف بين الراحتين على الحشا % % يسكن قلبا طار من صر محمل % 8(@)(@@) % يقولون صبرا ، والأسى غير صابر ، % فما حيلتي ، والصبر عني بمعزل % 9(@)(@@) % فلو كان لي صبر ، وكنت بحكمه ، % لما صبرت نفسي ، فكيف وليس لي % % PageV01P1310 البحر : خفيف تام 1(@)(@@) % طلع البدر في دجى الشعر ، % وسقى الورد نرجس الحور % 2(@)(@@) % غادة تاهت الحسان بها ، % وزها نورها على القمر % 3(@)(@@) % هي أسنى من المهاة سنا ، % صورة لا تقاس بالصور % 4(@)(@@) % فلك النور دون أخمصها ، % تاجها خارج عن الأكر % 5(@)(@@) % إن سرت في الضمير يجرحها % % ذلك الوهم ، كيف بالبصر % 6(@)(@@) % لعبة ذكرنا يذوبها % % لطفت عن مسارح النظر % 7(@)(@@) % طلب النعت أن يبينها % % فتعالت ، فعاد ذا حصر % 8(@)(@@) % وإذا رام أن يكيفها % % لم يزل ناكصا على الأثر % 9(@)(@@) % إن أراح المطي طالبها % % لم ترح مطية الفكر % % 10(@)(@@) % روحنت كل من أشب بها ، % نقلته عن مراتب البشر % PageV01P1311 11(@)(@@) % غيرة أن يشاب رايقها % % بالذي في الحياض من كدر % PageV01P1312 البحر : مجزوء الرجز 1(@)(@@) % أحبابنا أين هم ؟ % بالله قولوا : أين هم % 2(@)(@@) % كما رأيت طيفهم ، % فهل تريني عينهم ؟ % 3(@)(@@) % فكم ، وكم أطلبهم ، % زكم سألت بينهم % % 4(@)(@@) % حتى أمنت بينهم ، % وما أمنت بينهم % 5(@)(@@) % لعل سعدي حائل % بين النوى وبينهم % % 6(@)(@@) % لتنعم العين بهم ، % فلا أقول : أين هم % % PageV01P1313 البحر : بسيط تام 1(@)(@@) % بين الحشا والعيون النجل حرب هوى % % والقلب من أجل ذاك الحرب في حرب % 2(@)(@@) % لمياء لعساء معسول مقبلها % % شهادة النحل ما يلقى من الضرب % 3(@)(@@) % ريا المخلخل ، ديجور على قمر ، % في خدها شفق ، غصن على 
ms333	 كثب % 4(@)(@@) % حسناء حالية ليست بغانية ، % تفتر عن برد ظلم وعن شنب % 5(@)(@@) % تصد جدا ، وتلهو بالهوى لعبا ، % والموت ما بين ذاك الجد واللعب % 6(@)(@@) % ما عسعس الليل إلا جاء يعقبه ، % تنفس الصبح معلوم من الحقب % 7(@)(@@) % ولا تمر على روض رياح صبا % تحوي على كاعبات خرد عرب % 8(@)(@@) % إلا أمالت ونمت في تنسمها ، % بما حملن من الأزهار والقضب % 9(@)(@@) % سألت ريح الصبا عنهم لتخبرني ، % قالت : وما لك في الأخبار من أرب % 10(@)(@@) % في الأبرقين ، وفي برك العماد ، وفي % % برك العميم تركت الحى عن كثب % PageV01P1314 11(@)(@@) % لا تستقل بهم أرض ، فقلت لها : % أين المفر ، وخيل الشوق في الطلب % 12(@)(@@) % هيهات ليس لهم معنى سوى خلدي ، % فحيث كنت يكون البدر فارتقب % 13(@)(@@) % أليس مطلعها وهمي ، ومغربها % % قلبي ، فقد زال شؤم البان والغرب % 14(@)(@@) % ما للغراب نعيق في منازلنا % % وما له في نظام الشمل من ندب % PageV01P1315 البحر : سريع 1(@)(@@) % حمامة البان بذات الغضا ، % ضاق لما حملتنيه الفضا % % 2(@)(@@) % من ذا الذي يحمل شجو الهوى ، % من ذا الذي يجرع مر القضا % % 3(@)(@@) % أقول من وجد ومن لوعة : % يا ليت من أمرضني مرضا % % 4(@)(@@) % مر بباب الدار مستهزئا % مستخفيا معتجرا معرضا % % 5(@)(@@) % ما ضرني تعجيره ، إنما % % أضر بي من كونه أعرضا % % PageV01P1316 البحر : رجز تام 1(@)(@@) % يا حادي العيس بسلع عرج ، % وقف على البانة بالمدرج % 2(@)(@@) % ونادهم مستعطفا ، مستلطفا : % يا سادتي ! هل عندكم من فرج ؟ % 3(@)(@@) % برامة ، بين النقا وحاجر ، % جارية مقصورة في هودج % 4(@)(@@) % يا حسنها من طفلة غرنها % % تضيء للطارق مثل السرج % 5(@)(@@) % لؤلؤة مكنونة في صدف ، % من شعر مثل سواد السبج % 6(@)(@@) % لؤلؤة غواصها الفكر ، فما % % تنفك في أغوار تلك اللجج % 7(@)(@@) % يحسبها ناظرها ظبي نقا ، % من جيدها ، وحسن ذاك الغنج % 8(@)(@@) % كأنها شمس ضحى في حمل ، % قاطعة أقصى معالي الدرج % 9(@)(@@) % إن حسرت برقعها ، أو سفرت % أزرت بأنوار الصباح الأبلج % 10(@)(@@) % ناديتها بين الحمى ورامة % من لفتى حل بسلع يرتجي % % PageV01P1317 11(@)(@@) % من لفتى متيه في مهمه % موله مدله العقل شجي % % 12 
ms334	(@)(@@) % من لفتى دمعته مغرقة ، % أسكره خمر بذاك الفلج % 13(@)(@@) % من لفتى زفرته محرقة ، % تيمه جمال ذاك البلج % 14(@)(@@) % قد لعبت أيدي الهوى بقلبه ، % فما عليه في الذى من حرج % PageV01P1318 البحر : مخلع البسيط 1(@)(@@) % من لي بمخضوبة البنان ، % من لي بمعسولة اللسان % 2(@)(@@) % من كاعبات ذوات خدر ، % نواعم خرد حسان % 3(@)(@@) % بدور تم على غصون % هن من النقص في أمان % 4(@)(@@) % بروضة من ديار جسمي ، % حمامة فوق غصن بان % 5(@)(@@) % تموت شوقا تذوب عشقا ، % لما دهاها الذي دهاني % % 6(@)(@@) % تندب إلفا تذم دهرا ، % رماها قصدا بما رماني % % 7(@)(@@) % فراق جار ونأي دار ، % فيا زماني على زماني % % 8(@)(@@) % من لي بمن يرتضى عذابي ، % ما لي بما يرتضي يدان % PageV01P1319 البحر : طويل 1(@)(@@) % بذات الأضا ، والمأزمين وبارق % وذي سلم ، والأبرقين لطارق % 2(@)(@@) % بروق سيوف من بروق مباسم ، % نوافج مسك ما أبيحت لناشق % 3(@)(@@) % فإن حوربوا سلوا سيوف لحاظهم ، % وإن سلموا هدوا عقود المضايق % 4(@)(@@) % فنالوا ، ونلنا لذتين تساويا ، % فملك لمعشوق ، وملك لعاشق % PageV01P1320 البحر : طويل 1(@)(@@) % رضيت برضوى روضة ومناخا ، % فإن به مرعى وفيه نفاخا % % 2(@)(@@) % عسى أهل ودي يسمعون بخصبه ، % فيتخذوه مربعا ومناخا % % 3(@)(@@) % فإن لنا قلبا بهن معلقا % إذا ما حدا الحادي بهن أصاخا % % 4(@)(@@) % وإن هم تنادوا للرحيل وفوزوا ، % سمعت له خلف الركاب صراخا % % 5(@)(@@) % فإن قصدوا الزوراء كان أمامهم ، % وإن يمموا الجرعاء ، ثم أناخا % % 6(@)(@@) % فما الطير إلا حيث كانوا وخيموا ، % فإن له في حيهن فراخا % % 7(@)(@@) % تحارب خوف لي وخوف من اجلها ، % وما واحد عن قرنه يتراخا % % 8(@)(@@) % إذا خطفت أبصارنا سبحاتها ، % أصم لها صوت الشهيق صماخا % % PageV01P1321 البحر : طويل 1(@)(@@) % إذا ما التقينا للوداع حسبتنا % % لدى الضم والتعنيق حرفا مشددا % % 2(@)(@@) % فنحن ، وإن كنا مثنى شخوصنا ، % فما تنظر الأبصار إلا موحدا % % 3(@)(@@) % وما ذاك إلا من نحولي ونوره ، % فلولا أنيني ما رأت لي مشهدا % % PageV01P1322 البحر : متقارب تام 1(@)(@@) % وقالوا شموس بدار الفلك % % وهل منزل الشمس إلا الفلك % 2(@)(@@) % إذا قام عرش على ساقه ، % فلم يبق إلا استواء الملك % % 3(@)(@@) % إذا 
ms335	 خلص القلب من جهله ، % فما هو إلا نزول الملك % % 4(@)(@@) % تملكني وتملكته ، % فكل لصاحبه قد ملك % 5(@)(@@) % فكوني ملكا له بين ، % وملكي له قوله هيت لك % 6(@)(@@) % فيا حادي العيس عرج بنا ، % ولا تعد بالركب دار الفلك % 7(@)(@@) % أعلك دار على شاطئ ، % بقرب المسنى وما عللك % 8(@)(@@) % فليت الذي بي وحملته ، % من الحب رب الهوى حملك % 9(@)(@@) % فليس زرود ولا حاجر ، % ولا سلم منزل أنحلك % 10(@)(@@) % ظللت لحر الهوى طالبا % سحاب الوصال وما ظللك % PageV01P1323 11(@)(@@) % أذلك عز لسلطانه ، % فليت كما ذللك ذل لك % 12(@)(@@) % ويا ليته إذ أبى عزة % تدلله ليته دل لك % PageV01P1324 البحر : طويل 1(@)(@@) % أغيب ، فيفني الشوق نفسي ، فألتقي % % فلا أشتفي ، فالشوق غيبا ومحضرا % % 2(@)(@@) % ويحدث لي لقياه ما لم أظنه ، % فكان الشفاء داء من الوجد آخرا % % 3(@)(@@) % لأني أرى شخصا يزيد جماله ، % إذا ما التقينا نفرة وتكبرا % % 4(@)(@@) % فلا بد من وجد يكون مقارنا % لما زاد من حسن نظاما محررا % % PageV01P1325 البحر : كامل تام 1(@)(@@) % القصر ذو الشرفاء من بغداد % لا القصر ذو الشرفات من سنداد % 2(@)(@@) % والتاج من فوق الرياض كأنه % عذراء قد جليت بأعطر ناد % 3(@)(@@) % والريح تلعب بالغصون ، فتنثني ، % فكأنه منها على ميعاد % 4(@)(@@) % وكأن دجلة سلكها في جيدها % % والبعل سيدنا الإمام الهادي % % 5(@)(@@) % الناصر المنصور خير خليفة ، % لا يمتطي في الحرب متن جواد % 6(@)(@@) % صلى عليه الله ما صدحت به % ورقا مطوقة على مياد % 7(@)(@@) % وكذلك ما برقت بروق مباسم % سحت لها من مقلتي عواد % 8(@)(@@) % من خرد كالشمس أقلع غيثها % % فبدت بأنور مستنير بادي % % PageV01P1326 البحر : طويل 1(@)(@@) % ألا يا نسيم الريح بلغ مها نجد % بأني على ما تعلمون من العهد % 2(@)(@@) % وقل لفتاة الحي موعدنا الحمى % % غدية يوم السبت عند ربى نجد % 3(@)(@@) % على الربوة الحمراء من جانب الضوى ، % وعن أيمن الأفلاج والعلم الفرد % 4(@)(@@) % فإن كان حقا ما تقول ، وعندها % % إلي من الشوق المبرح ما عندي % % 5(@)(@@) % إليها ، ففي حر الظهيرة نلتقي % % بخيمتها سرا على أصدق الوعد % 6(@)(@@) % فتلقي ونلقي ما نلاقي 
ms336	 من الهوى % % ومن شدة البلوى ومن ألم الوجد % 7(@)(@@) % أأضغاث أحلام ، أبشرى منامة ، % أنطق زمان كان في نطقه سعدي % % 8(@)(@@) % لعل الذي ساق الأماني يسوقها % % عيانا فيهدى روضها لي جنى الورد % PageV01P1327 البحر : طويل 1(@)(@@) % ألا هل إلى الزهر الحسان سبيل ، % وهل لي على آثارهن دليل % 2(@)(@@) % وهل لي بخيمات اللوى من معرس % وهل لي في ظل الأراك مقيل % 3(@)(@@) % فقال لسان الحال يخبر أنها % % تقول : تمن ما إليه سبيل % 4(@)(@@) % ودادي صحيح فيك يا غاية المنى ، % وقلبي من ذاك الوداد عليل % 5(@)(@@) % تعاليت من بدر على القطب طالع ، % وليس له بعد الطلوع أفول % 6(@)(@@) % فديتك يا من عز حسنا ونخوة % فليس له بين الحسان عديل % 7(@)(@@) % فروضك مطلول ، ووردك يانع ، % وحسنك معشو ق عليه قبول % 8(@)(@@) % وزهرك بسام وغصنك ناعم ، % تميل له الأرواح حيث يميل % 9(@)(@@) % وظرفك فتان ، وطرفك صارم % به فارس البلوى علي يصول % PageV01P1328 البحر : متقارب تام 1(@)(@@) % لطيبة ظبي ظبى صارم % تجرد من طرفها الساحر % 2(@)(@@) % وفي عرفات عرفت الذي % % تريد ، فلم أك بالصابر % 3(@)(@@) % وليلة جمع جمعنا بها % % كما جاء في المثل السائر % 4(@)(@@) % يمين الفتاة يمين ، فلا % % تكن تطمئن إلى غادر % 5(@)(@@) % منى بمنى نلتها ليتها % % تدوم إلى الزمن الآخر % 6(@)(@@) % تولعت في لعلع بالتي % % تريك سنا القمر الزاهر % 7(@)(@@) % رمت رامة وصبت بالصبا % % وحجرت الحجر بالحاجر % 8(@)(@@) % وشامت بريقا على بارق % بأسرع من خطرة الخاطر % 9(@)(@@) % وغاضت مياه الغضا من غضى ، % بأضلعه من هوى ساحر % 10(@)(@@) % وبانت بيان النقا فانتقت % لآلىء مكنونة الفاخر % PageV01P1329 11(@)(@@) % وأضلت بذات الأضا القهقرى % % حذارا من الأسد الخادر % 12(@)(@@) % بذي سلم أسلمت مهجتي % % إلى لحظها الفاتك الفاتر % 13(@)(@@) % حمت بالحمى ولوت باللوى % % لعطفة جارحها الكاسر % 14(@)(@@) % وفي عالج عالجت أمرها % % لتفلت من مخلب الطائر % 15(@)(@@) % خورنقها خارق للسماء ، % يسمو اعتلاء على الناظر % PageV01P1330 البحر : بسيط تام 1(@)(@@) % ألمم بمنزل أحباب لهم ذمم ، % سحت عليهم سحاب صوبها ديم % 2(@)(@@) % واستنشق الريح من تلقاء أرضهم % شوقا لتخبرك الأرواح أين هم % 3(@)(@@) % أظنهم خيموا بالبان 
ms337	 من أضم % حيث العرار ، وحيث الشيح والكتم % PageV01P1331 البحر : هزج 1(@)(@@) % ألا يا بانة الوادي ، % بشاطي نهر بغداد % 2(@)(@@) % شجاني فيك مياد ، % طروب فوق مياد % 3(@)(@@) % يذكرني ترنمه % ترنم ربة النادي % % 4(@)(@@) % إذا استوت مثالثها ، % فلا تذكر أخا الهادي % % 5(@)(@@) % وإن جادت بنغمتها ، % فمن أنجشة الحادي % % 6(@)(@@) % بذي الخصمات من سلمى % % يمينا ثم سنداد % 7(@)(@@) % لقد أصبحت مشغوفا % بمن سكنت بأجياد % 8(@)(@@) % غلطنا إنما سكنت % سويدا خلب أكباد % 9(@)(@@) % لقد تاه الجمال بها ، % وفاح المسك والحادي % % PageV01P1332 
ms338	