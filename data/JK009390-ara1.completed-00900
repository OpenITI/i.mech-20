ms881	 ابن عمر رضي الله عنهما .(@)(@@) PageV03P160(@)(@@)(@@)(@@) $ ( 7908 ) قال النبي :(@)(@@) | 30 ( إن من تعظيم جلال الله عز وجل إكرام ذي الشيبة في الإسلام ، وإن من تعظيم جلال الله إكرام الإمام المقسط ) )(@)(@@) ابن الضريس عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7909 ) قال النبي :(@)(@@) | 30 ( إن من تعظيم جلال الله عز وجل كرامة ذي الشيبة المسلم وحامل القرآن ، والإمام العادل ) )(@)(@@) ابن الضريس عن قتادة مرسلا .(@)(@@)(@@)(@@) $ ( 7910 ) قال النبي :(@)(@@) | 30 ( إن من تعظيم جلال الله إكرام ثلاثة : الإمام المقسط ، وذي الشيبة المسلم ، وحامل القرآن غير الغالي فيه ولا الجافي عنه ) )(@)(@@) الخرائطي في مكارم الأخلاق عن طلحة بن عبيد الله بن كريز رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7911 ) قال النبي :(@)(@@) | 30 ( إن من تمام عبادة المريض أن تمد يدك إليه وتسأله كيف هو ، وأن تضع يدك عليه ، وإن من تمام تحياتكم بينكم المصافحة ) )(@)(@@) ( هناد ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7912 ) قال النبي :(@)(@@) | 30 ( إن من تمام عيادة المريض أن تضع يدك على المريض وتقول : كيف أصبحت وكيف أمسيت ) )(@)(@@) ( عق ) و ابن السني في عمل يوم وليلة عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7913 ) قال النبي :(@)(@@) | 30 ( إن من حسن إسلام المرء تركه ما لا يعنيه ) )(@)(@@) ( كر ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7914 ) قال النبي :(@)(@@) | 30 ( إن من خيار الناس الأملوك أملوك حمير وسفيان والسكون والأشعريين ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7915 ) قال النبي :(@)(@@) | 30 ( إن من خياركم أو أفاضلكم من تعلم القرآن وعلمه ) )(@)(@@) ( كر ) عن عثمان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7916 ) قال النبي :(@)(@@) | 30 ( إن من خير أكحالكم الإثمد إنه يجلو البصر وينبت PageV03P161 الشعر ) )(@)(@@) ( ن ك حب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7917 ) قال النبي :(@)(@@) | 30 ( إن من خير أسمائكم عبد الله وعبد الرحمان والحارث ) )(@)(@@) أبو أحمد الحاكم عن سبرة بن أبي سبرة الخزاعي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7918 ) قال النبي :(@)(@@) | 30 ( إن من خير التابعين أويس القرني ) )(@)(@@) ( حم كر ) عن رجل .(@)(@@)(@@)(@@) $ ( 7919 ) قال النبي :(@)(@@) | 30 ( إن من سعادة المسلم المسكن الواسع ، والجار الصالح ، والمركب 
ms882	 الهنيء ) )(@)(@@) ( هب ) و ابن النجار عن نافع بن الحارث الخزاعي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7920 ) قال النبي :(@)(@@) | 30 ( إن من سنة الضيف أن يشيع إلى باب الدار ) )(@)(@@) الخرائطي في مكارم الأخلاق عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7921 ) قال النبي :(@)(@@) | 30 ( إن من شر الناس من تدركهم الساعة وهم أحياء ، ومن يتخذ القبور مساجد ) )(@)(@@) ( حم طب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7922 ) قال النبي :(@)(@@) | 30 ( إن من شرار الناس رجلا فاجرا جريئا يقرأ بكتاب الله لا يرعوي إلى شيء منه ) )(@)(@@) الديلمي عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7923 ) قال النبي :(@)(@@) | 30 ( إن من شقاء المرء في الدنيا ثلاثة : سوء الدار ، وسوء المرأة ، وسوء الدابة ، قيل : ما سوء الدار ؟ قال : ضيق ساحتها وخبث جيرانها ، قيل : فما سوء الدابة ؟ قال : منعها ظهرها وسوء ظلعها ، قيل : فما سوء المرأة ؟ قال : عقر رحمها وسوء خلقها ) )(@)(@@) ( طب ) عن أسماء بنت عميس رضي الله عنها .(@)(@@) PageV03P162(@)(@@)(@@)(@@) $ ( 7924 ) قال النبي :(@)(@@) | 30 ( إن من حق الوالد على ولده : أن يخشع له عن الغضب ، ويؤثره عند الشكاية والوصب ، فإن المكافىء ليس بالواصل ، ولكن الواصل إذا قطعت رحمه وصلها ، ومن حق الولد على والده أن لا يجحد نفسه ، وأن يحسن أدبه ) )(@)(@@) ابن عساكر عن ابن مسعود وعن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7925 ) قال النبي :(@)(@@) | 30 ( إن من سعادة الرجل : زوجة صالحة ، وولدا بارا ، وخلطاء صالحين ، ومعيشة في بلاده ) )(@)(@@) ابن النجار عن الحسن بن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7926 ) قال النبي :(@)(@@) | 30 ( إن من شرار الناس الذين يبيعون الناس ) )(@)(@@) الخطيب عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7927 ) قال النبي :(@)(@@) | 30 ( إن من عباد الله لعبادا ليسوا بأنبياء ولا شهداء ، يغبطهم الأنبياء والشهداء ، هم قوم تحابوا بروح الله عز وجل ، على غير أموال ولا أ| نس اب ، وجوههم نور ، وهم على منابر من نور ، لا يخافون إذا خاف الناس ، ولا يحزنون إذا حزن الناس ، ثم قرأ : { ألا إن أولياء الله لا خوف عليهم ولا هم يحزنون } ) )(@)(@@) ( م د ن ه حب ) عن 
ms883	 أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7928 ) قال النبي :(@)(@@) | 30 ( إن من عباد الله عز وجل لاناسا ما هم بأنبياء ولا شهداء ، يغبطهم الأنبياء والشهداء يوم القيامة بمكانتهم من الله تعالى ، قوم يتحابون بروح الله من غير أرحام بينهم ولا أموال يتعاطونها بينهم ، والله إن وجوههم لنور ، وإنهم لعلى منابر من نور ، لا يخافون إذا خاف الناس ، ولا يحزنون إذا حزن الناس ، ثم قرأ : { ألا إن أولياء الله لا خوف عليهم ولا هم يحزنون } ا| بن أبي الدنيا في كتاب الإخوان وابن جرير ( حب هب ) عن أبي هريرة رضي الله عنه .(@)(@@) PageV03P163(@)(@@)(@@)(@@) $ ( 7929 ) قال النبي :(@)(@@) | 30 ( إن من علامات البلاء وأشراط الساعة أن تعزب العقول وتنقص الأحلام ، ويكثر القتل ، وترفع علامات الخير ، وتظهر الفتن ) )(@)(@@) ( طب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7930 ) قال النبي :(@)(@@) | 30 ( إن من فقه الرجل مدخله ومخرجه ومممشاه وإلفه ومجلسه ) )(@)(@@) الديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7931 ) قال النبي :(@)(@@) | 30 ( إن من قبل المغرب بابا فتحه الله للتوبة مسيرة أربعين سنة ، يوم خلق الله السماوات والأرض فلا يغلقه حتى تطلع الشمس منه ) )(@)(@@) ( حب ) عن صفوان بن عسال رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7932 ) قال النبي :(@)(@@) | 30 ( إن من كفارة الغيبة أن تستغفر لمن اغتبته تقول : اللهم اغفر لنا وله ) )(@)(@@) الحاكم في الكنى والخرائطي في مساوىء الأخلاق عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7933 ) قال النبي :(@)(@@) | 30 ( إن من مكارم أخلاق النبيين والصديقين والشهداء والصالحين البشاشة إذا تزاوروا والمصافحة والترحيب إذا التقوا ) )(@)(@@) ابن لال في مكارم الأخلاق عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7934 ) قال النبي :(@)(@@) | 30 ( إن من مكارم الأخلاق التزاور في الله ، وحق على المزور أن يقرب إلى أخيه ما تيسر عنده ، وإن لم يجد عنده إلا جرعة ماء ، فإن احتشم أن يقرب إليه ما تيسر لم يزل في مقت الله يومه وليلته ، ومن استحقر ما يقرب إليه أخوه لم يزل في مقت الله يومه وليلته ) )(@)(@@) الديلمي عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7935 ) قال النبي :(@)(@@) | 30 ( إن من موجبات الله 
ms884	 عز وجل على العبد ثلاثا : إذا رأى حقا من حقوق الله لم يؤخره إلى إيام لا يدركها ، وأن يعمل العمل الصالح في العلانية على قوام من عمله في السريرة ، هو يجمع ما يعمل صلاح ما يأمل فهاكذا ولي الله عز وجل ) )(@)(@@) ( حل ) عن جابر رضي الله عنه .(@)(@@) PageV03P164(@)(@@)(@@)(@@) $ ( 7936 ) قال النبي :(@)(@@) | 30 ( إن من موجبات المغفرة إدخالك السرور على أخيك المسلم : إشباع جوعته وتنفيس كربته ) )(@)(@@) محمد بن الحسين بن عبد الملك البزار في فوائده عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7937 ) قال النبي :(@)(@@) | 30 ( إن منكم من يقاتل على تأويل القرآن كما قاتلت على تنزيله ، قيل : أبو بكر وعمر ؟ قال : لا ، ولاكنه خاصف النعل يعني عليا ) )(@)(@@) ( حم ع حب ك حل ص ) عن أبي سعيد رضي الله عنه وضعف .(@)(@@)(@@)(@@) $ ( 7938 ) قال النبي :(@)(@@) | 30 ( إن مما يلحق المؤمن من عمله وحسناته بعد موته علما نشره ، وولدا صالحا تركه ، ومصحفا ورثه ، أو مسجدا بناه ، أو بيتا لابن السبيل بناه ، أو نهرا أجراه ، أو صدقة أخرجها من ماله في صحته وحياته ، تلحقه من بعد موته ) )(@)(@@) ( ه هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7939 ) قال النبي :(@)(@@) | 30 ( إن مما أتخوف على أمتي أن يكثر فيهم المال حتى يتنافسوا فيه فيقتتلوا عليه ، وإن مما أتخوف على أمتي أن يفتح لهم القرآن حتى يقرأه المؤمن والكافر والمنافق ، فيحل حلاله المؤمن وابتغاء تأويله ) )(@)(@@) ( ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7940 ) قال النبي :(@)(@@) | 30 ( إن مما أخشى عليكم شهوات الغي في بطونكم وفروجكم ومضلات الهوى ) )(@)(@@) ( حم ) عن أبي برزة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7941 ) قال النبي :(@)(@@) | 30 ( إن مما لا يغفر ، اليمين الغموس يقتطع بها مال امرىء مسلم ) )(@)(@@) الديلمي عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7942 ) قال النبي :(@)(@@) | 30 ( إن من واجب المغفرة إدخالك السرور على أخيك PageV03P165 المسلم ) )(@)(@@) الخطيب في المتفق والمفترق عهن جهم بن عثمان عن عبد الله بن سرجس عن أبيه عن جده وعندي أنه تصحيف وإنما هو عبد الله بن الحسن عن جده كما في معجم 
ms885	 ( طب ) وفوائد سمويه وقد تقدم .(@)(@@)(@@)(@@) $ ( 7943 ) قال النبي :(@)(@@) | 30 ( إن من ورائكم أيام الصبر المتمسك فيهن يومئذ بمثل ما أنتم عليه كان له أجر خمسين منكم ) )(@)(@@) ( طب ) عن عقبة بن غزوان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7944 ) قال النبي :(@)(@@) | 30 ( إن ناسا من أهل الجنة يطلعون إلى أناس من أهل النار فيقولون : لم دخلتم النار ؟ فوالله ما دخلنا الجنة إلا بما تعلمنا منكم ، فيقولون : إنا كنا نقول ولا نفعل ) )(@)(@@) ( طب ) عن الوليد بن عتبة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7945 ) قال النبي :(@)(@@) | 30 ( إن موسى عليه السلام قال : أي رب إن عبدك المؤمن تقتر عليه في الدنيا ؟ ففتح له باب من الجنة فنظر إليها ، فقال : يا موسى ؟ هاذا ما أعددت له ، قال موسى : أي رب وعزتك وجلالك ، لو كان أقطع اليدين والرجلين يسحب على وجهه منذ يوم خلقته إلى يوم القيامة وكان هاذا مصيره لم ير بؤسا قط ، ثم قال موسى : أي رب عبدك الكافر توسع عليه في الدنيا ؟ ففتح له باب إلى النار ، فقال : يا موسى هاذا ما أعددت له ، فقال موسى : أي رب وعزتك وجلالك لو كانت له الدنيا منذ يوم خلقته إلى يوم القيامة وكان هاذا مصيره لم ير خيرا قط ) )(@)(@@) ( حم ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7946 ) قال النبي :(@)(@@) | 30 ( إن موسى بن عمران مر برجل وهو يضطرب فقام يدعو الله له أن يعافيه ، فقيل له : يا موسى إنه ليس الذي يصيبه خبط من الشيطان إبليس ، ولاكنه جوع نفسه لي ، فهو الذي ترى إني أنظر إليه كل يوم مرات أتعجب من طاعته لي ، فمره فليدع لك ، فإن له عندي كل يوم دعوة ) )(@)(@@) ( طب حل ) عن ابن عباس رضي الله عنهما .(@)(@@) PageV03P166(@)(@@)(@@)(@@) $ ( 7947 ) قال النبي :(@)(@@) | 30 ( إن موسى بن عمران لقي جبريل فقال له : ما لمن قرأ آية الكرسي كذا وكذا مرة ، فذكر نوعا من الأجر مما لم يقو عليه موسى ، فسأل ربه أن لا يضعفه ثمن ذالك ، ثم أتاه جبريل مرة أخرى فقال : إن ربك يقول : من قال في دبر 
ms886	 كل صلاة مكتوبة مرة واحدة : اللهم إني أقدم إليك بين يدي كل نفس ولمحة وطرفة يطرف بها أهل السماوات وأهل الأرض من كل شيء هو في علمك كائن أو قد كان ، أقدم إليك بين يدي ذالك كله الله لا إلاه إلا هو الحي القيوم إلى قوله العلي العظيم ، فإن الليل والنهار أربعة وعشرون ساعة ، ليس منها ساعة إلا يصعد إلي منه فيها سبعون ألف ألف حسنة حنى ينفخ في الصور وتشغل الملائكة ) )(@)(@@) الحكيم عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7948 ) قال النبي :(@)(@@) | 30 ( إن موسى بن عمران كان إذا أراد أن يدخل الماء لم يلق ثوبه حتى يواري عورته في الماء ) )(@)(@@) ( حم ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7949 ) قال النبي :(@)(@@) | 30 ( إن مؤمني الجن لهم ثواب وعليهم عقاب ، قيل : ما ثوابهم ؟ قال : على الأعراف وليسوا في الجنة ، قيل : وما الأعراف ؟ قال : حائط الجنة تجري فيه الأنهار ، وتنبت فيه الأشجار والثمار ) )(@)(@@) ( هق ) في البعث عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7950 ) قال النبي :(@)(@@) | 30 ( إن ناركم هاذه جزء من سبعين جزءا من نار جهنم ، ولولا أنها ضربت في اليم سبع مرار لما انتفع بها بنو آدم ) )(@)(@@) ابن مردويه عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7951 ) قال النبي :(@)(@@) | 30 ( إن ناسا من أصحابي وزنوا الليلة ، فوزن أبو بكر فوزن ، ثم وزن عمر فوزن ، ثم وزن عثمان فوزن ) )(@)(@@) ( حم ) و ابن منده عن أعرابي يقال له جبر .(@)(@@) PageV03P167(@)(@@)(@@)(@@) $ ( 7952 ) قال النبي :(@)(@@) | 30 ( إن ناسا من أمتي يشربون الخمر يسمونها بغير اسمها ) )(@)(@@) ( ط طب ) عن عبادة بن الصامت ( ك ق ) عن عائشة رضي الله عنها ( حم ) عن رجل من الصحابة .(@)(@@)(@@)(@@) $ ( 7953 ) قال النبي :(@)(@@) | 30 ( إن ناسا من أمتي يأتون من بعدي يود أحدهم لو اشترى رؤيتي بأهله وماله ) )(@)(@@) ( قط ) في الأفراد ( ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7954 ) قال النبي :(@)(@@) | 30 ( إن ناسا من المنافقين اغتابوا ناسا من المؤمنين ، فلذالك هاجت هاذه الريح ) )(@)(@@) ( حل ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7955 ) قال النبي :(@)(@@) | 30 ( إن ناسا 
ms887	 باتوا في شراب ودفوف وغناء فأصبحوا قد مسحوا قردة وخنازير ) )(@)(@@) ابن صصرى في أماليه عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7956 ) قال النبي :(@)(@@) | 30 ( إن ناسا من أمتي يؤمون هاذا البيت لرجل من قريش قد استعاذ بالحرم ، فلما بلغوا البيداء خسف بهم ، مصادرهم شتى ، يبعثهم الله على نياتهم ، قيل : كيف ؟ قال : جمعهم الطريق ، منهم المستنصر وابن السبيل والمجنون ، يهلكون مهلكا واحدا ، ويصدرون مصادر شتى ) )(@)(@@) ( حم ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 7957 ) قال النبي :(@)(@@) | 30 ( إن نبيا من الأنبياء قاتل أهل مدينة ، حتى إذا كاد أن يفتحها خشي أن تغرب الشمس ، فقال لها : أيتها الشمس ، إنك مأمورة وأنا مأمور بحرمتي عليك إلا وكدت ساعة من النهار ، فحبسها الله حتى افتتح المدينة ، وكانوا إذا أصابوا الغنائم قربوها في القربات ، فجاءت النار فأكلتها ، فلما أصابوا وضعوا القربات ، فلم تجيء النار تأكله فقالوا : يا نبي الله ما لنا لا تقبل قرباتنا ؟ قال : فيكم غلول ، قالوا : ما لنا أن نعلم من عنده الغلول وهم اثنا عشر سبطا ، PageV03P168 قال : يبايعني رأس كل سبط منكم ، فبايعه رأس كل سبط ، فلزقت كف النبي بكف رجل منهم ، فقال له : عندك الغلول ، فقال : كيف لي أن أعلم عند أي سبط هو : قال : تدعو سبطك فتبايعهم رجلا رجلا ، ففعل ، فلزقت كفه بكف رجل منهم ، قال : عندك الغلول ؟ قال : نعم عندي الغلول ، قال : وما هو ؟ قال : رأس ثور من ذهب أعجبني فغللته ، فجاء به فوضعه في الغنائم ، فجاءت النار فأكلته ) )(@)(@@) عبد الرزاق في المصنف ( ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7958 ) قال النبي :(@)(@@) | 30 ( إن نبي الله أيوب عليه السلام لبث به بلاؤه ثمانية عشرة سنة ، فرفضه القريب والبعيد إلا رجلين من إخوانه كانا من أخص إخوانه به ، كانا يغدوان إليه ويروحان ، فقال أحدهما لصاحبه ذات يوم : تعلم والله أن أيوب قد أذنب ذنبا ما أذنبه أحد من العالمين ، فقال له صاحبه : وما ذاك ؟ قال : منذ ثمانية عشرة سنة لم يرحمه الله ويكشف ما به ، فلما راحا إلى أيوب لم يصبر 
ms888	 الرجل حتى ذكر له ذالك ، فقال : أدري ما أدري ما يقولان ، غير أن الله تعالى يعلم أني كنت أمر بالرجلين يتراغمان فيذكران الله فأرجع إلى بيتي فاكفر عنهما أن يذكر الله إلا في حق ، وكان يخرج لحاجته ، فإذا قضى حاجته أمسكت امرأته بيده حتى يبلغ ، فلما كان ذات يوم أبطأ عليها ، فاوحي إلى أبي أيوب في مكانه : { أركض برجلك هاذا مغتسل بارد وشراب } فاستبطأته فتلقته بنظر ، وأقبل عليها قد أذهب الله ما به من البلاء وهو أحسن ما كان ، فلما رأته قالت : أي بارك الله فيك ، هل رأيت نبي الله هاذا المبتلى ، والله على ذالك ؟ ، ما رأيت أشبه به منك إذ كان صحيحا ، قال : فإني أنا هو ، وكان له أندران أندر للقمح ، وأندر للشعير ، فبعث الله سحابتين ، فلما كانت إحداهما على أندر القمح أفرغت فيه الذهب حتى فاض ، وأفرغت الأخرى في أندر الشعير الورق حتى فاض ) )(@)(@@) سمويه ( حب ك ) والديلمي عن أنس PageV03P169 رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7959 ) قال النبي :(@)(@@) | 30 ( إن نبي الله نوحا لما حضرته الوفاة قال لابنه : يا بني إني قاص عليك الوصية ، آمرك باثنتين ، وأنهاك عن اثنتين ، آمرك بلا إلاه إلا الله ، فلو أن السماوات السبع والأرضين السبع وضعن في كفة ولا إلاه إلا الله في كفة لرجحت بهن ، ولو أن السماوات السبع والأرضين السبع كن حلقة مبهمة قصمتهن لا إلاه إلا الله ، وسبحان الله وبحمده فإنها صلاة كل شيء وبها الخلق ، وبها يرزق الخلق ، وأنهاك عن الشرك والكبر ، قيل : يا رسول الله ما الكبر ؟ أهو أن يكون للرجل حلة حسنة يلبسها ، وفرس جميل يعجبه جماله ؟ قال : لا ، الكبر سفه الحق وغمص الناس ) )(@)(@@) ( حم طب ك ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7960 ) قال النبي :(@)(@@) | 30 ( إن نبيا من الأنبياء أعجبته كثرة أمته ، فقال : من يقوم لهاؤلاء ؟ فأوحى الله إليه أن خير أمتك بين إحدى ثلاث : إما أن أسلط عليهم الموت ، أو العدو ، أو الجوع ، فعرض لهم ذالك ، فقالوا : أنت نبي الله ، نكل ذالك إليك فخر لنا ، فقام 
ms889	 إلى صلاته ، وكانوا يفزعون إذا فزعوا إلى الصلاة ، فصلى ، قال : أما الجوع فلا طاقة لنا ، ولا طاقة لنا بالعدو ، ولاكن الموت ، فسلط عليهم الموت ، فمات منهم في ثلاثة أيام سبعون ألفا ، فأنا اليوم أقول : اللهم بك أحاول وبك أصاول وبك أقاتل ولا حول ولا قوة إلا بالله العلي العظيم ) )(@)(@@) ( حم ع حب طب حل هق ض ) عن صهيب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7961 ) قال النبي :(@)(@@) | 30 ( إن نبيذ الغبيراء حرام ) )(@)(@@) العسكري في كتاب الصحابة عن أسيد الجعفي .(@)(@@)(@@)(@@) $ ( 7962 ) قال النبي :(@)(@@) | 30 ( إن نساء بني إسرائيل كن يجعلن هاذا في رؤوسهن PageV03P170 فلعن وحرم عليهن المساجد ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما أن رسول الله حرج بقصه قال فذكره .(@)(@@)(@@)(@@) $ ( 7963 ) قال النبي :(@)(@@) | 30 ( إن نفرا من الجن خمسة عشر بنو إخوة وبنو عم يأتون الليلة فاقرأ عليهم القرآن ) )(@)(@@) ( طس ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7964 ) قال النبي :(@)(@@) | 30 ( إن نفرا مروا على عيسى بن مريم فقال : يموت أحد هاؤلاء اليوم إن شاء الله ، فمضوا ثم رجعوا عليه بالعشي ومعهم حزم الحطب ، فقال : ضعوا ، فقال للذي قال يموت اليوم : حل حطبك فحله ، فإذا فيه حية سوداء ، فقال : ما عملت اليوم ؟ قال : ما عملت شيئا ، قال : أنظر ما عملت ؟ قال : ما عملت شيئا ، إلا أنه كان معي في يدي فلقة من خبز ، فمر بي مسكين فسألني فأعطيته بعضها ، فقال : بها دفع عنك ) )(@)(@@) ( طس ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7965 ) قال النبي :(@)(@@) | 30 ( إن نفس المؤمن إذا قبضت تلقاها من أهل الرحمة من عباد الله كما تلقون البشير في الدنيا فيقولون : انطروا صاحبكم يستريح فإنه كان في كرب شديد ، ثم يسألونه ماذا فعل فلان وما فعلت فلانة ، هل تزوجت ؟ فإذا سألوه عن الرجل قد مات قبله ، فيقول : أيهات قد مات ذالك قبلي ، فيقولون : إنا لله وإنا إليه راجعون ، ذهب به إلى أمه الهاوية ، فبئست الأم وبئست المربية ، وإن أعمالكم تعرض على أقاربكم وعشائركم من أهل الآخرة ، فإن كان خيرا فرحوا واستبشروا وقالوا : اللهم 
ms890	 هاذا فضلك ورحمتك فأتمم نعمتك عليه وأمته عليها ، ويعرض عليهم المسيء فيقولون : اللهم ألهمه عملا صالحا ترضى به عنه ، ويقربه إليك ) )(@)(@@) ( طب ) عن أبي أيوب رضي الله عنه .(@)(@@) PageV03P171(@)(@@)(@@)(@@) $ ( 7966 ) قال النبي :(@)(@@) | 30 ( إن نفس المؤمن تخرج رشحا وإن نفس الكافر تسيل كما تخرج نفس الحمار ، وإن المؤمن ليعمل الخطيئة فيشدد بها عليه عند الموت ليكفر بها ، وإن الكافر ليعمل الحسنة فيسهل عليه عند الموت ليجزي بها ) )(@)(@@) ( طب ) عن ابن مسود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7967 ) قال النبي :(@)(@@) | 30 ( إن نفس المؤمن تخرج رشحا ، ولا أحب موتا كموت الحمار ، قيل : وما موت الحمار ؟ قال : روح الكافر تخرج من أشداقه ) )(@)(@@) ( طب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7968 ) قال النبي :(@)(@@) | 30 ( إن نفقتك على أهلك وولدك وخادمك صدقة ، فلا تتبع بذالك منا ولا أذى ) )(@)(@@) ( ك ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7969 ) قال النبي :(@)(@@) | 30 ( إن نوحا كبير الأنبياء لم يقم عن خلاء قط إلا قال : الحمد لله الذي أذاقني لذته ، وأبقى في منفعته ، وأخرج عني أذاه ) )(@)(@@) ( عق هب ) و الديلمي عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 7970 ) قال النبي :(@)(@@) | 30 ( إن نوحا هبط من السفينة على الجودي يوم عاشوراء فصامه نوح وأمر من معه بصيامه شكرا لله ، وفي يوم عاشوراء تاب الله على آدم وعلى أهل مدينة يونس ، وفيه خلق الله البحر لبني إسرائيل ، وفيه ولد أبراهيم وابن مريم ) )(@)(@@) أبو الشيخ في الثواب عن عبد الغفور بن عبد العزيز بن سعد بن زيد بن عمرو بن نفيل عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 7971 ) قال النبي :(@)(@@) | 30 ( إن هاؤلاء القوم كانوا يذكرون الله يعني أهل مجلس أمامه فنزلت عليهم السكينة تحملها الملائكة كالقبة ، فلما دنت منهم ، تكلم رجل منهم بباطل فرفعت عنهم ) )(@)(@@) ابن سعد وابن مسعود مرسلا .(@)(@@)(@@)(@@) $ ( 7972 ) قال النبي :(@)(@@) | 30 ( إن هاؤلاء أولياء الخلافة بعدي يعني أبا بكر وعمر وعثمان ) )(@)(@@) ( حب ) في الضعفاء عن عطية بن مالك رضي الله عنه .(@)(@@) PageV03P172(@)(@@)(@@)(@@) $ ( 7973 ) قال النبي :(@)(@@) | 30 ( إن هاؤلاء النوائح يجعلن يوم القيامة صفين في جهنم ، صف عن 
ms891	 يمينهم ، وصف عن يسارهم ، فينبحن على أهل النار كما تنبح الكلاب ) )(@)(@@) ( طس ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7974 ) قال النبي :(@)(@@) | 30 ( إن هاتين صامتا مما أحل الله لهما ، وأفطرتا على ما حرم الله عليهما ، جلست إحداهما إلى الأخرى فجعلنا تأكلان لحوم الناس ) )(@)(@@) ( حم ) و ابن أبي الدنيا في ذم الغيبة عن عبيد مولى رسول الله .(@)(@@)(@@)(@@) $ ( 7975 ) قال النبي :(@)(@@) | 30 ( إن هاذا الطاعون رجز نزل على من كان قبلكم ، فإذا سمعتم به في أرض فلا تدخلوها ، وإذا كان وأنتم بها فلا تخرجوا منها ) )(@)(@@) سمويه عن أسامة بن زيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7976 ) قال النبي :(@)(@@) | 30 ( إن هاذا الوجع بقية عذاب عذب به من كان قبلكم ، وإذا وقع بأرض وأنتم بها فلا تخرجوا منها ، وإذا وقع بأرض فلا تأتوها ) )(@)(@@) ابن قانع عن أسامة بن زيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7977 ) قال النبي :(@)(@@) | 30 ( إن هاذا الطاعون رجز عذب به طائفة من بني إسرائيل كانوا قبلكم ، فهو في الأرض يذهب أحيانا ويرجع أحيانا ، فمن سمع به بأرض فلا يدخلن عليه ، ومن كان بأرض فوقع بها فلا يخرجن فرارا منه ) )(@)(@@) العدني عن أسامة بن زيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7978 ) قال النبي :(@)(@@) | 30 ( إن هاذا السقم رجز عذب به بعض الأمم قبلكم ثم بقي في الأرض ، فيذهب المرة ويأتي الأخرى ، فمن سمع به بأرض فلا يقدمن عليه ، ومن وقع بأرض وهو بها فلا يخرجنه الفرار منه ) )(@)(@@) ( طب ) عن أسامة بن زيد رضي الله عنه .(@)(@@) PageV03P173(@)(@@)(@@)(@@) $ ( 7979 ) قال النبي :(@)(@@) | 30 ( إن هاذا السقم عذب به الأمم قبلكم ، فإذا سمعتم به في أرض فلا تدخلوها ، وإذا وقع بأرض وأنتم بها فلا تخرجوا فرارا منه ) )(@)(@@) ( حم ) عن عبد الرحمان بن عوف رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7980 ) قال النبي :(@)(@@) | 30 ( إن هاذا السقم عذاب عذب به من كان قبلكم ، فإذا كان بأرض لستم بها فلا تهبطوا عليه ، وإذا كان بأرض وأنتم بها فلا تخرجوا فرارا منه ) )(@)(@@) ( طب ) عنه .(@)(@@)(@@)(@@) $ ( 7981 ) قال النبي :(@)(@@) | 30 ( إن هاذا الوباء شيء عذب به الأمم قبلكم ، وقد 
ms892	 بقيت في الأرض منه بقية فيقع أحيانا ويذهب أحيانا ، فإذا وقع بأرض وأنتم بها فلا تخرجوا منها ، وإذا وقع بأرض ولستم بها فلا تدخلوا عليه ) )(@)(@@) ( طب ) عن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7982 ) قال النبي :(@)(@@) | 30 ( إن هاذا الأمر بدأ رحمة ونبوة ، ثم يكون رحمة وخلافة ، ثم كائن ملكا عضوضا ، ثم كائن عتوا وجبرية وفسادا في الأمة ، يستحلون الحرير والفروج والخمور ويرزقون على ذالك وينصرون حتى يلقوا الله عز وجل ) )(@)(@@) ( طب ) و أبو نعيم في المعرفة ( هب ) عن أبي ثعلب الجشني عن معاذ وأبي عبيدة بن الجراح رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7983 ) قال النبي :(@)(@@) | 30 ( إن هاذا الدين متين ، فأوغل فيه برفق ، ولا تبغض إلى نفسك عبادة الله ، فإن المنبت لا أرضا قطع ولا ظهرا أبقى ) )(@)(@@) ( حم بز هق ) و العسكري في الأمثال عن جابر رضي الله عنه وضعف .(@)(@@)(@@)(@@) $ ( 7984 ) قال النبي :(@)(@@) | 30 ( إن هاذا الدين متين فأوغل فيه برفق ، ولا تكرهوا PageV03P174 عبادة الله إلى عباده ، فإن المنبت لا يقطع سفرا ولا يستبقي ظهرا ) ( هب ) عن ع$ ائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 7985 ) قال النبي :(@)(@@) | 30 ( إن هاذا الدين متين فأوغل فيه برفق ، ولا تبغض إلى نفسك عبادة ربك ، فإن المنبت لا سفرا قطع ، ولا ظهرا أبقى ، فاعمل عمل امرىء يظن أن لن يموت أبدا ، واحذر حذر من يخشى أن يموت غدا ) )(@)(@@) العسكري ( هب ق ) عن ابن عمرو رضي الله عنهما وفي لفظ : يظن أنه لن يموت إلا هرما .(@)(@@)(@@)(@@) $ ( 7986 ) قال النبي :(@)(@@) | 30 ( إن هاذا القرآن نزل بحزن فاقرؤوه بحزن ) )(@)(@@) ابن مردويه عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7987 ) قال النبي :(@)(@@) | 30 ( إن هاذا القرآن أنزل على سبعة أحرف فاقرؤوا ولا حرج ، ولاكن لا تجعلوه ذكر رحمة بعذاب ، ولا ذكر عذاب برحمة ) )(@)(@@) ابن جرير عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7988 ) قال النبي :(@)(@@) | 30 ( إن هاذا القرآن أنزل على سبعة أحرف ، فأي ذالك قرأتم فقد أصبتم ، فلا تماروا فيه ، فإن المراء فيه كفر ) )(@)(@@) ( حم ) عن عمرو بن العاص رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7989 ) قال 
ms893	 النبي :(@)(@@) | 30 ( إن هاذا السفر جهد وثقل ، فإذا أوتر أحدكم فليركع ركعتين ، فإن استيقظ وإلا كانتا له ) )(@)(@@) الدارمي وابن خزيمة والطحاوي ( ز حب قط طب ه ق ض ) عن ثوبان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7990 ) قال النبي :(@)(@@) | 30 ( إن هاذا الشعر سجع من كلام العرب ، به يعطي السائل ، وبه يكظم الغيظ ، وبه يؤتى القوم في ناديهم ) )(@)(@@) أبو نعيم عن شعبة بن الدخان بن القوم عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 7991 ) قال النبي :(@)(@@) | 30 ( إن هاذا الأمر إلى الله ، فمن يسره للهدى تيسر ، PageV03P175 ومن يسره للضلالة كان فيها ) )(@)(@@) الواقدي وابن عساكر عن سعيد بن عمرو الهذلي مرسلا .(@)(@@)(@@)(@@) $ ( 7992 ) قال النبي :(@)(@@) | 30 ( إن هاذا المال خضرة حلوة فمن يأخذه بحقه يبارك له فيه ) )(@)(@@) ( حم طب هب ) عن معاوية رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7993 ) قال النبي :(@)(@@) | 30 ( إن هاذا ذكر الله فذكره ، وأنت نسيت الله فنسيك ) )(@)(@@) ( حم ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7994 ) قال النبي :(@)(@@) | 30 ( إن هاذا لو مات لمات وليس من الدين على شيء ، إن الرجل ليخفف صلاته ويتمها ) )(@)(@@) ( حم ) عن عثمان بن ضيف رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7995 ) قال النبي :(@)(@@) | 30 ( إن هاذا القرآن صعب مستصعب لمن كرهه ، ميسر لمن تبعه ، وإن من حديثي صعب مستصعب لمن كرهه ، ميسر لمن تبعه ، من سمع حديثي فحفظه وعمل به جاء يوم القيامة مع القرآن ، ومن تهاون بحديثي فقد تهاون بالقرآن ، ومن تهاون بالقرآن خسر الدنيا والآخرة ) )(@)(@@) ( ( خط ) في الجامع عن الحكم بن عمير الثمالي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7996 ) قال النبي :(@)(@@) | 30 ( إن هاذا القرآن أنزل على سبعة أحرف فلا تماروا فيه ، فإن المراء فيه كفر ) )(@)(@@) البغوي ( هب ) عن أبي جهيم الأنصاري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7997 ) قال النبي :(@)(@@) | 30 ( إن هاذا الدين يسر ، ولن يشاد هاذا الدين أحد إلا غلبه ، فسددوا وقاربوا ، وأبشروا واستعينوا بالغدوة والرواح وشيء من الدلجة ) )(@)(@@) ( حب ) و العسكري في الأمثال عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7998 ) قال النبي :(@)(@@) | 30 ( إن هاذا الفيء لا يحل منه خيط ولا مخيط ولا PageV03P176 لمعط ) )(@)(@@) ( هب 
ms894	 ) عن ثوبان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7999 ) قال النبي :(@)(@@) | 30 ( إن هاذا الأمر بدأ نبوة ورحمة ثم يكون خلافة ورحمة ، ثم يكون ملكا عضوضا ، يشربون الخمر ، ويلبسون الحرير ، ويستحلون الفروج ، وينصرون ويرزقون حتى يأتيهم أمر الله ) )(@)(@@) نعيم بن حماد في الفتن عن حذيفة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8000 ) قال النبي :(@)(@@) | 30 ( إن هاذه الحشوش محتضرة ، فإذا دخل أحدكم الغائط فليقل : أعوذ بالله من الرجس النجس الشيطان الرجيم ) )(@)(@@) ( طب ك ) عن حذيفة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8001 ) قال النبي :(@)(@@) | 30 ( إن هاذه الأمة مرحومة جعل الله عذابها بينها ، فإذا كان يوم القيامة دفع إلى كل امرىء منهم رجل من أهل الأديان فيقال هاذا فداؤك من النار ) )(@)(@@) ( حم ) عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8002 ) قال النبي :(@)(@@) | 30 ( إن هاذه الأمة أمة مرحومة لا عذاب عليها ، عذابها بأيديها ، فإذا كان يوم القيامة أعطى كل رجل منهم رجلا من أهل الأديان ، فكان فكاكه من النار ) )(@)(@@) ( طب هق ) في الأفراد عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8003 ) قال النبي :(@)(@@) | 30 ( إن هاذه الأمة تبتلى في قبورها فإذا أدخل المؤمن في قبره وتولى عنه أصحابه ، جاءه ملك شديد الانتهار فيقول له : ما كنت تقول في هاذا الرجل ؟ فيقول المؤمن : أقول إنه رسول الله وعبده ، فيقول له الملك : انظر إلى مقعدك الذي كان لك في النار قد أنجاك الله منه ، وأبدلك بمقعدك الذي ترى من النار الذي ترى من الجنة ، فيقول المؤمن : دعوني أبشر أهلي ، فيقال له : اسكن ، PageV03P177 وأما المنافق فيقعد إذا تولى عنه أهله فيقال له : ما كنت تقول في هاذا الرجل ؟ فيقول : لا أدري ، أقول ما يقول الناس ، فيقال له : لا دريت ، وهاذا مقعدك الذي كان في الجنة قد أبدلت منه مقعدك من النار ، يبعث كل عبد في القبر على ما مات ، المؤمن على إيمانه ، والمنافق على نفاقه ) )(@)(@@) ( حم ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8004 ) قال النبي :(@)(@@) | 30 ( إن هاذه الإبل لأهل بيت من المسلمين هي قوتهم ويمنهم بعد الله ، أيسركم لو رجعتم إلى مزاودكم 
ms895	 فوجدتم ما فيها فذهب به ، أترون ذالك عدلا ، قالوا : لا ، قال : فإن هاذا كذالك ) )(@)(@@) ( ه ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8005 ) قال النبي :(@)(@@) | 30 ( إن هاذه من غنائمكم ، وإنه ليس يحل لي فيها إلا نصيبي معكم إلا الخمس والخمس مردود عليكم ، فأدوا الخيط والمخيط ، وأكثر من ذالك وأصغر ، ولا تغلوا فإن الغلول نار وعار على أصحابه في الدنيا والآخرة ، وجاهدوا الناس في الله تعالى ، القريب والبعيد ، ولا تبالوا في الله لومة لائم ، وأقيموا حدود الله تعالى في الحضر والسفر ، وجاهدوا في سبيل الله تعالى ، فإن الجهاد باب من أبواب الجنة عظيم ، وإنه ينجي الله به من الهم والغم ) )(@)(@@) ( حم ) و الشاشي ( طب ك ض ) عن عبادة بن الصامت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8006 ) قال النبي :(@)(@@) | 30 ( إن هاذه أيام أكل وشرب وذكر الله ، فلا صوم فيهن إلا صوما في هدى ) )(@)(@@) الطحاوي ( قط ك ) عن عبد الله بن حذافة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8007 ) قال النبي :(@)(@@) | 30 ( إن هاذه القلوب تصدأ كما يصدأ الحديد ، قيل : يا رسول الله فما جلاؤها ؟ قال : تلاوة القرآن ) )(@)(@@) محمد بن نصر والخرائطي في اعتلال القلوب ( حل عب ) والخطيب عن ابن عمر رضي الله عنهما .(@)(@@) PageV03P178(@)(@@)(@@)(@@) $ ( 8008 ) قال النبي :(@)(@@) | 30 ( إن هاذه أيام أكل وشرب وبعال ، فلا تصوموها ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 8009 ) قال النبي :(@)(@@) | 30 ( إن هاذه أيام أكل وشرب فلا يصمها أحد ) )(@)(@@) ( حم ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8010 ) قال النبي :(@)(@@) | 30 ( إن هاذه القرية هي المدينة لا يصلح فيها قبلتان ، فأيما نصراني أسلم ثم تنصر فاضربوا عنقه ) )(@)(@@) ( طب ) عن عبد الرحمن بن ثوبان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8011 ) قال النبي :(@)(@@) | 30 ( إن هاذه القلوب تصدأ كما يصدأ الحديد إذا أصابه الماء ، قيل : وما جلاؤها ؟ قال : كثرة ذكر الموت ، وتلاوة القرآن ) )(@)(@@) ( هب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 8012 ) قال النبي :(@)(@@) | 30 ( إن هاذه ليست بالمعرفة ، إن المعرفة أن تسأله عن اسمه واسم أبيه ، فتعوده إذا مرض ، وتشيعه إذا مات ) )(@)(@@) الخرائطي في مكارم الأخلاق عن 
ms896	 ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 8013 ) قال النبي :(@)(@@) | 30 ( إن هاذه الصلاة عرضت على من كان قبلكم فتوانوا فيها وتركوها ، فمن صلاها منكم ضعف له أجرها مرتين ، ولا صلاة بعدها حتى يرى الشاهد والشاهد النجم ) )(@)(@@) ( حم ) عن أبي بصرة الغفاري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8014 ) قال النبي :(@)(@@) | 30 ( إن هاذه الحشوش محتضرة فإذا دخلها أحدكم فليقل : اللهم إني أعوذ بك من الخبث والخبائث ) )(@)(@@) عبد الرزاق عن أنس رضي الله عنه .(@)(@@) PageV03P179(@)(@@)(@@)(@@) $ ( 8015 ) قال النبي :(@)(@@) | 30 ( إن هاذه الصلاة عرضت على من كان قبلكم فأبوها وثقلت عليهم ، وفضلت على من سواها بستة وعشرين درجة يعني العصر ) )(@)(@@) عبد الرزاق عن أبي بصرة الغفاري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8016 ) قال النبي :(@)(@@) | 30 ( إن هاذه الأخلاق منائح من الله ، فإذا أحب الله عبدا منحه خلقا حسنا ، وإذا أبغض عبدا منحه خلقا سيئا ) )(@)(@@) العسكري في الأمثال عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 8017 ) قال النبي :(@)(@@) | 30 ( إن هاذين حرما على ذكور أمتي ، وحللا لاناثهم يعني الذهب والحرير ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 8018 ) قال النبي :(@)(@@) | 30 ( إن وراءكم عقبة كؤودا لا يجوزها المثقلون ) )(@)(@@) ( طب ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8019 ) قال النبي :(@)(@@) | 30 ( إن وسادك إذن لعريض طويل إنما هو سواد الليل وبياض النهار ) )(@)(@@) ( حم د طب ) عن عدي بن حاتم رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8020 ) قال النبي :(@)(@@) | 30 ( إن وصيتي وموضع سري وخير من أترك بعدي ، وينجز عدتي ، ويقضي ديني ، علي بن أبي طالب ) ( طب ) عن أ| بي سعيد عن سلمان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8021 ) قال النبي :(@)(@@) | 30 ( إن لا إلاه إلا الله كلمة على الله كريمة ، لها عند الله مكان ، وهي كلمة من قالها صادقا أدخله الله بها الجنة ، ومن قالها كاذبا حقنت دمه وأحرزت به ولقي الله غدا فحاسبه ) )(@)(@@) ( بز ) عن عياض الأنصاري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8022 ) قال النبي :(@)(@@) | 30 ( إن يأجوج ومأجوج ولد آدم ، ولو أرسلوا لأفسدوا على الناس معايشهم ، ولن يموت منهم رجل إلا ترك من ذريته ألفا فصاعدا ، وإن من ورائهم 
ms897	 ثلاث أمم : قاويل وتاريس ومنسلة ) )(@)(@@) عبد بن حميد في التفسير وابن المنذر ( طب ) وابن مردويه ( هق ) في البعث عن ابن عمرو رضي الله عنهما .(@)(@@) PageV03P180(@)(@@)(@@)(@@) $ ( 8023 ) قال النبي :(@)(@@) | 30 ( إن يحيى بن زكريا سأل ربه فقال : يا رب اجعلني ممن لا يقع الناس فيه ، فأوحى الله تعالى إليه ، يا يحيى هاذا شيء لم أستخلصه لنفسي ، كيف أفعله بك ، إقرأ في المحكم تجد فيه : ( وقالت اليهود عزير ابن الله وقالت النصارى المسيح ابن الله وقالوا يد الله مغلولة وقالوا . . . ) قال : يا رب اغفر لي فإني لا أعود ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8024 ) قال النبي :(@)(@@) | 30 ( إن يوشع بن نون دعا ربه : اللهم إني أسألك باسمك الزكي الطهر الطاهر المطهر المقدس المبارك المخزون المكنون المكتوب على سرادق المجد وسرادق الحمد وسرادق القدرة وسرادق السلطان وسرادق السر ، إني أدعوك يا رب بأن لك الحمد لا إلاه إلا أنت النور البار الرحمان الرحيم الصادق عالم الغيب والشهادة ، بديع السماوات والأرض ونورهن وقيمهن ، ذو الجلال والإكرام ، حنان جبار نور دائم قدوس حي لا يموت ، هاذا ما دعا به فحبست له الشمس باذن الله ) )(@)(@@) أبو الشيخ في الثواب وابن عساكر والرافعي عن أنس رضي الله عنه وليس في سنده متهم .(@)(@@)(@@)(@@) $ ( 8025 ) قال النبي :(@)(@@) | 30 ( إن يمين المسلم من ورائها أعظم من ذالك إذا هو حلف كاذبا يدخله الله النار ) )(@)(@@) ( طب ) عن الأشعث بن قيس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8026 ) قال النبي :(@)(@@) | 30 ( إن يوم الجمعة وليلة الجمعة أربعة وعشرون ساعة ، ليس منها ساعة إلا ولله فيها ستمائة عتيق من النار كلهم قد استوجب النار ) )(@)(@@) ( ع ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8027 ) قال النبي :(@)(@@) | 30 ( إنا لا نقبل شيئا من المشركين ولاكن إن شئت أخذتها منك بالثمن ) )(@)(@@) ( حم طب ك ض ) عن حكيم بن حزام أنه أهدى إلى النبي حلة وهو كافر فقال فذكره .(@)(@@) PageV03P181(@)(@@)(@@)(@@) $ ( 8028 ) قال النبي :(@)(@@) | 30 ( إنا نشبه عثمان بأبينا إبراهيم عليه السلام ) )(@)(@@) ( عد هق ) و ابن عساكر والديلمي عن ابن عمر رضي الله عنهما 
ms898	 .(@)(@@)(@@)(@@) $ ( 8029 ) قال النبي :(@)(@@) | 30 ( إن مصبحوهم بغارة فأفطروا وتقووا ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8030 ) قال النبي :(@)(@@) | 30 ( إنا معاشر الأنبياء يضاعف لنا البلاء كما يضاعف لنا الأجر ، إن كان النبي من الأنبياء ليبتلى بالقمل حتى يقتله ، وإن كان النبي من الأنبياء ليبتلى بالفقر حتى يأخذ العباءة فيجوبها ، وإن كانوا ليفرحون بالبلاء كما تفرحون بالرخاء ) )(@)(@@) ( حم ) و عبد بن حميد ( ك ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8031 ) قال النبي :(@)(@@) | 30 ( إنا كذالك يشدد علينا البلاء ويضاعف لنا الأجر ، أشد الناس بلاء الأنبياء ثم العلماء ثم الصالحون ، كان أحدهم يبتلى بالقمل حتى يقتله ، ويبتلى أحدهم بالفقر حتى ما يجد إلا العباءة يلبسها ، ولأحدهم كان أشد فرحا بالبلاء من أحدكم بالعطاء ) )(@)(@@) ( ك هق ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8032 ) قال النبي :(@)(@@) | 30 ( إنا معاشر الأنبياء أمرنا بثلاث : تعجيل الفطر ، وتأخير السحور ، ووضع اليد اليمنى على اليسرى في الصلاة ) )(@)(@@) ( عد هق ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 8033 ) قال النبي :(@)(@@) | 30 ( إنا بحمد الله لم نكن في شيء من أمر الدنيا شغلنا عن صلاتنا ، ولاكن أرواحنا كانت بيد الله عز وجل أرسلها إذا شاء ، فمن أدركته هاذه الصلاة من غد صالحا فليصل معها مثلها ) )(@)(@@) ( هق ) عن أبي قتادة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8034 ) قال النبي :(@)(@@) | 30 ( إنا لا نقبل زبد المشركين ) )(@)(@@) ( ط حم ط ق ) عن PageV03P182 عياض بن حمار رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8035 ) قال النبي :(@)(@@) | 30 ( إنا لا نبيع شيئا من الصدقات حتى نقبضه ) )(@)(@@) ( هق ) عن عل قمة بن ناحية رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8036 ) قال النبي :(@)(@@) | 30 ( إنا معاشر الأنبياء بنيت أجسادنا على أرواح أهل الجنة ، وأمرت الأرض ما كان منا أن تبتلعه ) )(@)(@@) الديلمي عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 8037 ) قال النبي :(@)(@@) | 30 ( إن آل محمد نعفي لحانا ونخفي شواربنا ، وإن آل كسرى يحلقون لحاهم ويعفون شواربهم ، هدينا مخالف لهديهم ) )(@)(@@) الديلمي عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 8038 ) قال النبي :(@)(@@) | 30 ( إنا أهل بيت اختار الله لنا الآخرة على الدنيا 
ms899	 ، وإن أهل بيتي سيلقون من بعدي بلاءا وتشديدا وتطريدا ، حتى يأتي قوم من قبل المشرق معهم رايات سود ، فيسألون الخبر الحق فلا يعطونه ، فيقاتلون فينصرون فيعطون ما سألوا فلا يقبلونه ، حتى يدفعوها إلى رجل من أهل بيتي يواطىء اسمه اسمي ، واسم أبيه اسم أبي ، فيملك الأرض فيملأها قسطا وعدلا ، كما ملاوها جورا وظلما ، فمن أدرك ذالك منكم أو من أعقابكم فليأتهم ولو حبوا على الثلج ، فإنها رايات هدى ) )(@)(@@) ( ه ك ) وتعقب عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8039 ) قال النبي :(@)(@@) | 30 ( إنا نأكل الهدية ولا نأكل الصدقة ) )(@)(@@) ( هق ) عن سل مان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8040 ) قال النبي :(@)(@@) | 30 ( إنا آل محمد لا تحل لنا الصدقة ) )(@)(@@) ( ط حم ) و ابن خزيمة ( ع حب ) والبغوي ( طب ض ) عن السيد الحس ( حم ) وابن سعد ( خ ) في التاريخ والبغوي والباوردي وابن قانع وابن السكن الحاكم في الكنى ( طب ض ) PageV03P183 عن أبي عميرة رشيد بن مالك السعدي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8041 ) قال النبي :(@)(@@) | 30 ( إنا أهل بيت لا تحل لنا الصدقة ) )(@)(@@) ( طب ) عن عبد الرحمان بن أبي ليلى عن أبيه .(@)(@@)(@@)(@@) $ ( 8042 ) قال النبي :(@)(@@) | 30 ( إنا أهل بيت نهينا أن نأكل الصدقة ، وإن مولانا من أنفسنا فلا يأكل الصدقة ) )(@)(@@) ( حم طب هق ) و ابن منده وابن عساكر عن ميمون مولى النبي الروياني وابن عساكر عن كيسان مولى النبي .(@)(@@)(@@)(@@) $ ( 8043 ) قال النبي :(@)(@@) | 30 ( إنا قوم قرويون وإنا نعافه ) )(@)(@@) ابن سعد عن محمد بن سيرين قال : أتي النبي بضب قال فذكره .(@)(@@)(@@)(@@) $ ( 8044 ) قال النبي :(@)(@@) | 30 ( إنا لا نورث ، ما تركناه صدقة ) )(@)(@@) ( حم ) عن عمر وعبد الرحمن بن عوف وطلحة والزبير وسعد رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 8045 ) قال النبي :(@)(@@) | 30 ( إنك لن تقرأ بشيء أبلغ عند الله من { قل أعوذ برب الفلق } ) )(@)(@@) ( حب طب ) عن عقبة بن عامر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8046 ) قال النبي :(@)(@@) | 30 ( إنك نسيت الله فنسيتك ، وإن هاذا ذكر الله فذكرته ) )(@)(@@) ( ك ) عن أبي هريرة رضي الله عنه في اللذين عطسا .(@)(@@)(@@)(@@) $ ( 8047 ) قال النبي :(@)(@@) | 30 ( إنك نجدت 
ms900	 بيتك وسترته وهاذا لا يحل ، شبهته ببيت الله ، لو شئت بسطت فيه وطرحت فيه وسائد ) )(@)(@@) الحكيم عن الحكم بن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8048 ) قال النبي :(@)(@@) | 30 ( إنك وشيعتك في الجنة ، وسيأتي قوم لهم نبز PageV03P184 يقال لهم الرافضة ، فإذا لقيتموهم فاقتلوهم فإنهم مشركون ) )(@)(@@) ( حل ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8049 ) قال النبي :(@)(@@) | 30 ( إنك لن تدع شيئا إتقاء الله عز وجل إلا أعطاك الله خيرا منه ) )(@)(@@) ( حم ) و البغوي ( هق ) عن رجل من أهل البادية .(@)(@@)(@@)(@@) $ ( 8050 ) قال النبي :(@)(@@) | 30 ( إنك إن قلت ثلاثا حين تمسي : أمسينا وأمسى الملك لله ، والحمد لله كله ، أعوذ بالذي يمسك السماء أن تقع على الأرض إلا باذنه من شر ما خلق وذرأ ومن الشيطان وشركه حفظت من كل شيطان وكاهن وساحر حتى تصبح ، وإن قلتها حين تصبح حفظت كذالك حتى تمسي ) )(@)(@@) ابن السني عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8051 ) قال النبي :(@)(@@) | 30 ( إنك مع من أحببت ولك ما احتسبت ) )(@)(@@) ( حب ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8052 ) قال النبي :(@)(@@) | 30 ( إنك من قبيل يقللن الكثير ويمنعن ما لا يغنيها ، وتسأل عن ما لا يغنيها ) )(@)(@@) البغوي وابن قانع عن شهاب بن مالك رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8053 ) قال النبي :(@)(@@) | 30 ( إنك لابنة نبي ، وإن عمك لنبي ، وإنك لتحت نبي ، ففيم تفخر عليك ؟ اتق الله يا حفصة ) )(@)(@@) ( ت ) حسن صحيح غريب ( ع ) عن أنس رضي الله عنه قال : بلغ صفية أن حفصة قالت : بنت يهودي فبكت ، فقال النبي فذكره .(@)(@@)(@@)(@@) $ ( 8054 ) قال النبي :(@)(@@) | 30 ( إنكم ستقاتلون قوما فتظهرون عليهم فيتقونكم بأموالهم دون أنفسهم وأموالهم ، يصالحونكم على صلح فلا تأخذوا منهم فوق ذالك فإنه لا يحل لكم ) )(@)(@@) البغوي عن رجل من جهينة .(@)(@@) PageV03P185(@)(@@)(@@)(@@) $ ( 8055 ) قال النبي :(@)(@@) | 30 ( إنكم تعملون أعمالا لا تعرف ويوشك العازب أن يؤوب إلى أهله ، فمسرور ومكظوم ) )(@)(@@) ( طب ) عن ثوبان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8056 ) قال النبي :(@)(@@) | 30 ( إنكم سترون ربكم يوم القيامة عيانا ) )(@)(@@) ( طب ) عن جرير وقال : فيه لفظة عيانا ، تفرد بها أبو شهاب الخناط وهو حافظ متقن 