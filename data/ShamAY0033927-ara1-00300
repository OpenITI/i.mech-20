ms281	 أبي بن كعب فصدق سمرة الحسن مختلف في سماعه من سمرة وقد سمع منه حديثا واحدا وهو حديث العقيقة فيما زعم قريش بن أنس عن حبيب بن الشهيد PageV01P336 2 - حدثنا محمد بن مخلد ثنا الحسن بن عرفة ثنا هشيم عن يونس بن عبيد عن الحسن عن سمرة Y أنه كان إذا افتتح الصلاة سكت هنيئة وإذا قرأ ولا الضالين سكت سكتة فأنكر ذلك عليه فكتب في ذلك إلى أبي بن كعب فكتب أن الأمر كما صنع سمرة PageV01P336 3 - حدثنا الحسين بن إسماعيل ثنا علي بن مسلم حدثنا جرير عن عمارة بن القعقاع عن أبي زرعة عن أبي هريرة قال Y كان رسول الله صلى الله عليه وسلم إذا كبر في الصلاة سكت هنيهة فقلت يا رسول الله بأبي أنت وأمي ما تقول في صلاتك بين التكبير والقراءة قال أقول اللهم باعد بيني وبين خطاياي كما باعدت بين المشرق والمغرب اللهم نقني من الخطايا كما ينقى الثوب الأبيض من الدنس اللهم اغسلني من خطاياي بالثلج والماء والبرد(@)PageV01P336(@)(@@)(@@)(@@) || AUTO ( 36 باب قدر القراءة في الظهر والعصر والصبح ) PageV01P337 1 - حدثنا القاضي الحسين بن إسماعيل ثنا يعقوب الدورقي ثنا هشيم ثنا منصور بن زاذان عن الوليد بن مسلم عن أبي الصديق الناجي عن أبي سعيد قال Y كنا نحرز قيام رسول الله صلى الله عليه وسلم في الظهر والعصر فحزرنا قيامه في الظهر قدر ثلاثين آية قدر سورة السجدة في الركعتين الأوليين وفي الأخريين على النصف من ذلك وحزرنا قيامه قيامه في الركعتين الأوليين في العصر على قدر الأخريين من الظهر وحزرنا قيامه في الأخريين من العصر على النصف من ذلك هذا ثابت صحيح PageV01P337 2 - حدثنا محمد بن مخلد البجلي حدثنا أحمد بن عثمان بن حكيم الأودي نا سهل بن عامر البجلي ثنا هريم بن سفيان عن إسماعيل بن أبي خالد عن قيس بن أبي حازم قال Y صليت خلف بن عباس بالبصرة فقرأ في أول ركعة بالحمد وأول آية من البقرة ثم قام 
ms282	 في الثانية فقرأ الحمد والآية الثانية من البقرة ثم ركع فلما انصرف أقبل علينا فقال إن الله تعالى يقول فاقرؤا ما تيسر منه هذا إسناد حسن وفيه حجة لمن يقول إن معنى قوله فاقرؤا ما تيسر منه إنما هو بعد قراءة فاتحة الكتاب والله أعلم PageV01P338 3 - حدثنا أبو بكر النيسابوري عبد الله بن محمد بن زياد وعبد الملك بن أحمد الدقاق قالا نا بحر بن نصر ثنا عبد الله بن وهب حدثني معاوية بن صالح عن أبي الزاهرية عن كثير بن مرة عن أبي الدرداء قال Y قام رجل فقال يا رسول الله أفي كل صلاة قرآن قال نعم فقال رجل من القوم وجب هذا فقال أبو الدرداء يا كثير وأنا إلى جنبه لا أرى الإمام إذا أم القوم إلا قد كفاهم ورواه زيد بن حباب عن معاوية بن صالح بهذا الإسناد وقال فيه فقال رسول الله صلى الله عليه وسلم ما أرى الإمام إلا قد كفاهم ووهم فيه والصواب أنه من قول أبي الدرداء كما قال بن وهب والله أعلم(@)PageV01P338(@)(@@)(@@)(@@) || AUTO ( 37 باب ذكر نسخ التطبيق والأمر بالأخذ بالركب ) PageV01P339 1 - حدثنا يحيى بن محمد بن صاعد ثنا أبو سعيد الأشج ثنا عبد الله بن إدريس قال سمعت عاصم بن كليب يذكر عن عبد الرحمن بن الأسود عن علقمة عن عبد الله قال Y علمنا رسول الله صلى الله عليه وسلم الصلاة فرفع يديه ثم ركع وطبق وجعل يديه بين ركبتيه فبلغ ذلك سعدا فقال صدق أخي كنا نفعل هذا ثم أمرنا بهذا وجعل يديه على ركبتيه يعني في الركوع PageV01P339 2 - ثنا محمد بن القاسم بن زكريا حدثنا أبو كريب ثنا بن إدريس عن عاصم بن كليب Y بهذا وقال فكبر ورفع يديه فلما ركع طبق يديه بين ركبتيه فبلغ ذلك سعدا فقال صدق أخي كنا نفعل هذا ثم أمرنا بهذا ووضع الكفين على الركبتين هذا إسناد ثابت صحيح PageV01P339 3 - حدثنا دعلج بن أحمد ثنا موسى بن هارون ثنا الحارث 
ms283	 بن عبد الله بهمذان ثنا هشيم عن عاصم بن كليب عن علقمة بن وائل عن أبيه قال Y كان رسول الله صلى الله عليه وسلم إذا ركع فرج أصابعه وإذا سجد ضم أصابعه الخمس قال دعلج حدثنا أبو بكر بن خزيمة ثنا موسى بن هارون ثم لقيت موسى فحدثني به PageV01P339 4 - حدثنا أحمد بن محمد بن سعيد ثنا علي بن سعيد ثنا علي بن الحسين بن عبيد بن كعب ثنا سعيد بن عثمان الخزاز ح وحدثنا أحمد بن محمد بن سعيد ثنا أحمد بن الحسين بن سعيد ثنا أبي ثنا سعيد بن عثمان الخزاز ثنا عمرو بن شمر عن جابر عن عبد الله بن بريدة عن أبيه قال قال النبي صلى الله عليه وسلم Y يا بريدة إذا رفعت رأسك من الركوع فقل سمع الله لمن حمده اللهم ربنا لك الحمد ملء السماء وملء الأرض وملء ما شئت بعد PageV01P339 5 - ثنا أبو طالب الحافظ أحمد بن نصر نا أحمد بن عمير الدمشقي ثنا أبو زرعة عبد الرحمن بن عمرو حدثنا يحيى بن عمرو بن عمارة بن راشد أبو الخطاب قال سمعت عبد الرحمن بن ثابت بن ثوبان يقول حدثني عبد الله بن الفضل عن الأعرج عن أبي هريرة أن النبي صلى الله عليه وسلم قال Y إذا قال الإمام سمع الله لمن حمده فليقل من وراءه سمع الله لمن حمده PageV01P339 6 - حدثنا أبو طالب الحافظ أيضا ثنا يزيد بن محمد بن عبد الصمد ثنا يحيى بن عمرو بن عمارة سمعت بن ثابت بن ثوبان يقول حدثني عبد الله بن الفضل عن الأعرج عن أبي هريرة أن النبي صلى الله عليه وسلم قال Y إذا قال الإمام سمع الله لمن حمده فليقل من وراءه اللهم ربنا ولك الحمد هذا هو المحفوظ بهذا الإسناد والله أعلم PageV01P340 7 - حدثنا عثمان بن أحمد الدقاق ثنا عيسى بن عبد الله الطيالسي زغاث ثنا يزيد بن عمر بن جنزة المدايني ثنا الربيع بن بدر عن أيوب 
ms284	 السختياني عن الأعرج عن أبي هريرة قال Y صلى لنا رسول الله صلى الله عليه وسلم ثم أقبل علينا بوجهه فقال أتقرءون خلف الإمام فقلنا إن فينا من يقرأ قال فبفاتحة الكتاب الربيع بن بدر ضعيف كذا رواه الربيع بن بدر وخالفه سلام أبو المنذر رواه عن أيوب عن أبي قلابة عن أبي هريرة ولا يثبت وخالفهما عبيد الله بن عمرو الرقي ورواه عن أيوب عن أبي قلابة عن أنس عن النبي صلى الله عليه وسلم ورواه بن علية وغيره عن أيوب عن أبي قلابة مرسلا ورواه خالد الحذاء عن أبي قلابة عن محمد بن أبي عائشة عن رجل من أصحاب رسول الله صلى الله عليه وسلم عن النبي صلى الله عليه وسلم PageV01P340 8 - حدثنا محمد بن إسماعيل الفارسي ثنا أبو زرعة الدمشقي ثنا يحيى بن يوسف الزمي ثنا عبيد الله بن عمرو الرقي عن أيوب عن أبي قلابة عن أنس Y أن رسول الله صلى الله عليه وسلم صلى بأصحابه فلما قضى صلاته أقبل عليهم بوجهه فقال أتقرءون في صلاتكم والإمام يقرأ فسكتوا قالها ثلاثا فقال قائل أو قائلون إنا لنفعل قال فلا تفعلوا وليقرأ أحدكم بفاتحة الكتاب في نفسه لفظ حديث الفارسي PageV01P340 9 - ثنا علي بن أحمد بن الهيثم ثنا أحمد بن إبراهيم القوهستاني حدثنا يوسف بن عدي قالا ثنا عبيد الله بن عمرو Y بإسناده نحوه لفظ حديث الفارسي PageV01P340 10 - حدثنا أحمد بن سلمان نا هلال بن العلاء نا أبي ح وحدثنا أحمد ثنا يزيد بن جمهور ثنا أبو توبة قالا نا عبيد الله بن عمرو Y بهذا PageV01P340 11 - حدثنا أبو بكر النيسابوري ثنا أحمد بن منصور زاج ثنا النضر بن شميل أخبرنا يونس بن أبي إسحاق عن أبي إسحاق عن أبي الأحوص عن عبد الله قال قال رسول الله صلى الله عليه وسلم لقوم كانوا يقرءون القرآن فيجهرون به Y خلطتم علي القرآن وكنا نسلم في الصلاة فقيل لنا إن في الصلاة شغلا PageV01P340 12 - حدثنا عبد 
ms285	 الله بن محمد بن عبد العزيز ثنا عثمان بن أبي شيبة ثنا طلحة بن يحيى عن يونس عن بن شهاب عن سعيد بن المسيب قال Y إذا أدركت القوم ركوعا فكبر واركع فإنها تجزئك واحدة للتكبير والركوع وعن سعيد بن المسيب فيمن نسي التكبير حين افتتح الصلاة ثم كبر للركوع أن ذلك يجزئه(@)PageV01P341(@)(@@)(@@)(@@) || AUTO ( 38 باب صفة ما يقول المصلي عند ركوعه وسجوده ) PageV01P341 1 - حدثنا عبد الله بن محمد بن عبد العزيز إملاء ثنا عبد الله بن عمر بن أبان ثنا حفص بن غياث عن محمد بن أبي ليلى عن الشعبي عن صلة عن حذيفة Y أن النبي صلى الله عليه وسلم كان يقول في ركوعه سبحان ربي العظيم وبحمده ثلاثا وفي سجوده سبحان ربي الأعلى وبحمده ثلاثا PageV01P341 2 - حدثنا محمد بن جعفر بن رميس ثنا محمد بن إسماعيل بن سمرة الأحمسي ثنا أبو يحيى الحماني عبد الحميد بن عبد الرحمن ثنا السري بن إسماعيل عن الشعبي عن مسروق عن عبد الله بن مسعود قال Y من السنة أن يقول الرجل في ركوعه سبحان ربي العظيم وبحمده وفي سجوده سبحان ربي الأعلى وبحمده PageV01P341 3 - حدثنا أبو بكر النيسابوري ثنا يوسف بن سعيد بن مسلم ثنا حجاج عن بن جريج أخبرني موسى بن عقبة عن عبد الله بن الفضل عن عبد الرحمن الأعرج عن عبيد الله بن أبي رافع عن علي بن أبي طالب قال Y كان رسول الله صلى الله عليه وسلم إذا سجد في الصلاة المكتوبة قال اللهم لك سجدت وبك آمنت ولك أسلمت أنت ربي سجد وجهي للذي خلقه وصوره وشق سمعه وبصره تبارك الله أحسن الخالقين وكان إذا ركع قال اللهم لك ركعت وبك آمنت ولك أسلمت أنت ربي خشع لك سمعي وبصري ومخي وعظامي وما استقلت به قدمي لله رب العالمين وكان إذا رفع رأسه من الركوع في الصلاة المكتوبة قال اللهم ربنا لك الحمد ملء السماوات وملء الأرض وملء ما شئت من شيء بعد هذا 
ms286	 إسناد حسن صحيح PageV01P342 4 - حدثنا أبو هريرة محمد بن علي بن حمزة ثنا أبو أمية ثنا روح ثنا بن جريج أخبرني موسى بن عقبة بهذا الإسناد Y أن النبي صلى الله عليه وسلم كان إذا ركع قال مثل قول حجاج في الركوع خاصة دون غيره وزاد روح وعظمي وعصبي PageV01P342 5 - حدثنا الحسين بن إسماعيل ثنا أبو بكر بن زنجويه نا أبو اليمان ثنا إسماعيل بن عياش عن عبد العزيز بن عبيد الله عن عبد الرحمن بن نافع بن جبير بن مطعم عن أبيه عن جده قال Y كان رسول الله صلى الله عليه وسلم يقول إذا ركع سبحان ربي العظيم ثلاث مرات PageV01P342 6 - حدثنا الحسين بن إسماعيل ثنا عبد الله بن شبيب ثنا محمد بن مسلمة بن محمد بن هشام المخزومي ثنا إبراهيم بن سلمان عن عبيد الله بن عبد الله بن أقرم عن أبيه Y قال رأيت رسول الله صلى الله عليه وسلم يقول في ركوعه سبحان ربي العظيم ثلاثا PageV01P343 7 - حدثنا الحسين نا يوسف بن موسى ثنا عبيد الله بن موسى ثنا إبراهيم بن الفضل عن سعيد المقبري عن أبي هريرة قال قال رسول الله صلى الله عليه وسلم Y إذا ركع أحدكم فسبح ثلاث مرات فإنه يسبح لله من جسده ثلاثة وثلاثون وثلاث مائة عظم وثلاثة وثلاثون وثلاث مائة عرق PageV01P343 8 - حدثنا الحسين بن إسماعيل ثنا إبراهيم بن هانئ ثنا آدم ثنا بن أبي ذئب ثنا إسحاق بن يزيد عن عون بن عبد الله بن عتبة عن بن مسعود قال قال رسول الله صلى الله عليه وسلم Y إذا قال أحدكم في ركوعه سبحان ربي العظيم ثلاث مرات فقد تم ركوعه وذلك أدناه PageV01P343 9 - حدثنا الحسين بن إسماعيل ثنا محمد بن عبد الملك الدقيقي ثنا سليمان بن حرب ثنا شعبة عن قتادة عن مطرف عن عائشة Y أن النبي صلى الله عليه وسلم كان يقول في ركوعه سبوح قدوس رب الملائكة والروح قال وحدثني هشام صاحب الدستوائي 
ms287	 عن قتادة عن مطرف عن عائشة أنه كان يقول في ركوعه وسجوده قلت لسليمان بن حرب شعبة يقول حدثني هشام قال كذا قال(@)PageV01P343(@)(@@)(@@)(@@) || AUTO ( 39 باب ذكر الركوع والسجود وما يجزي فيهما ) PageV01P344 1 - حدثنا أحمد بن محمد بن سعيد ثنا أبو شيبة ثنا أبو غسان ثنا جعفر الأحمر عن حارثة عن عمرة عن عائشة قالت Y كان النبي صلى الله عليه وسلم إذا سجد استقبل بأصابعه القبلة PageV01P344 2 - حدثنا الحسين بن الحسين بن عبد الرحمن القاضي ثنا محمد بن أصبغ بن الفرج ثنا أبي ثنا عبد العزيز بن محمد الدراوردي عن عبيد الله بن عمر عن نافع عن بن عمر Y أن رسول الله صلى الله عليه وسلم كان إذا سجد يضع يديه قبل ركبتيه PageV01P344 3 - حدثنا أبو بكر بن أبي داود ثنا محمود بن خالد ثنا مروان بن محمد حدثنا عبد العزيز بن محمد ثنا محمد بن عبد الله بن الحسن عن أبي الزناد عن الأعرج عن أبي هريرة قال قال رسول الله صلى الله عليه وسلم Y إذا سجد أحدكم فليضع يديه قبل رجليه ولا يبرك بروك البعير PageV01P344 4 - حدثنا أبو سهل بن زياد ثنا إسماعيل بن إسحاق ثنا أبو ثابت محمد بن عبيد الله ثنا عبد العزيز بن محمد عن محمد بن عبد الله بإسناده عن النبي صلى الله عليه وسلم Y إذا سجد أحدكم فليضع يديه قبل ركبتيه ولا يبرك بروك الجمل PageV01P345 5 - حدثنا الحسين بن يحيى بن عياش ثنا الحسن بن محمد ثنا إسماعيل بن علية عن بن عون قال قال محمد إذا قال Y الإمام سمع الله لمن حمده قال من خلفه سمع الله لمن حمده اللهم ربنا لك الحمد PageV01P345 6 - حدثنا عبد الله بن أبي داود ثنا أحمد بن سنان ثنا يزيد ح وحدثنا الحسين بن إسماعيل ثنا محمد بن يحيى الأزدي ثنا يزيد بن هارون انا شريك عن عاصم بن كليب عن أبيه عن وائل بن حجر قال Y كان النبي صلى 
ms288	 الله عليه وسلم إذا يسجد تقع ركبتاه قبل يديه وإذا رفع رفع يديه قبل ركبتيه وقال بن أبي داود ووضع ركبتيه قبل يديه تفرد به يزيد عن شريك ولم يحدث به عن عاصم بن كليب غير شريك وشريك ليس بالقوي فيما يتفرد به والله أعلم PageV01P345 7 - حدثنا إسماعيل الصفار ثنا العباس بن محمد ثنا العلاء بن إسماعيل العطار حدثنا حفص بن غياث عن عاصم الأحول عن أنس قال Y رأيت رسول الله صلى الله عليه وسلم كبر حتى حاذى بإبهاميه أذنيه ثم ركع حتى استقر كل مفصل منه في موضعه ثم رفع رأسه حتى استقر كل مفصل منه في موضعه ثم انحط بالتكبير فسبقت ركبتاه يديه تفرد به العلاء بن إسماعيل عن حفص بهذا الإسناد والله أعلم PageV01P345 8 - حدثنا عبد الله بن سليمان بن الأشعث ثنا زياد بن أيوب ثنا إسماعيل عن أيوب عن أبي قلابة قال Y جاءنا أبو سليمان مالك بن الحويرث مسجدنا فقال والله لأصلي وما أريد الصلاة ولكني أريد أن أريكم كيف رأيت رسول الله صلى الله عليه وسلم يصلي قال فقعد في الركعة الأولى حين رفع رأسه من السجدة الأخيرة هذا إسناد صحيح ثابت وكذلك ما بعده PageV01P345 9 - حدثنا أحمد بن عبد الله بن محمد الوكيل ثنا الحسن بن عرفة ثنا هشيم عن خالد الحذاء عن أبي قلابة عن مالك بن الحويرث الليثي قال Y رأيت النبي صلى الله عليه وسلم وهو يصلي فكان إذا كان في الركعة الأولى أو الثالثة لم ينهض حتى يستوي قاعدا هذا صحيح PageV01P346 10 - حدثنا أبو محمد بن صاعد ثنا أحمد بن ثابت الجحدري وعبد الله بن محمد بن المسور الزهري ومحمد بن الوليد القرشي قالوا حدثنا محمد بن جعفر ثنا شعبة عن خالد وأيوب عن أبي قلابة عن مالك بن الحويرث أبي سليمان Y أنهم أتوا النبي صلى الله عليه وسلم قال أحدهما وصاحب له أيوب أو خالد فقال لهما إذا حضرت الصلاة فأذنا وأقيما وليؤمكما أكبركما وصلوا كما 
ms289	 رأيتموني أصلي هذا صحيح PageV01P346 11 - حدثنا محمد بن مخلد ثنا العلاء بن سالم ثنا أبو الوليد المخزومي ثنا بن جريج عن عطاء عن أبي هريرة قال قال رسول الله صلى الله عليه وسلم Y إن سركم أن تزكوا صلاتكم فقدموا خياركم أبو الوليد هو خالد بن إسماعيل ضعيف(@)PageV01P346(@)(@@)(@@)(@@) || AUTO ( 40 باب من أدرك الإمام قبل إقامة صلبه فقد أدرك الصلاة ) PageV01P346 1 - حدثنا أبو طالب الحافظ ثنا أحمد بن محمد بن الحجاج بن رشدين ثنا عمرو بن سوار ومحمد بن يحيى بن إسماعيل قالا ثنا بن وهب ح وحدثنا أبو طالب نا بن رشدين ثنا حرملة ثنا بن وهب حدثني يحيى بن حميد عن قرة بن عبد الرحمن عن بن شهاب أخبرني أبو سلمة عن أبي هريرة أن رسول الله صلى الله عليه وسلم قال Y من أدرك ركعة من الصلاة فقد أدركها قبل أن يقيم الإمام صلبه PageV01P346 2 - حدثنا محمد بن مخلد ثنا إبراهيم بن هانئ ثنا سعيد بن أبي مريم ثنا نافع بن يزيد حدثني يحيى بن أبي سليمان المدني عن زيد بن أبي العتاب وابن المقبري عن أبي هريرة قال قال رسول الله صلى الله عليه وسلم Y إذا جئتم إلى الصلاة ونحن سجود فاسجدوا ولا تعدوها ومن أدرك الركعة فقد أدرك الصلاة(@)PageV01P347(@)(@@)(@@)(@@) || AUTO ( 41 باب لزوم إقامة الصلب في الركوع والسجود ) PageV01P348 1 - حدثنا أبو حامد محمد بن هارون إملاء حدثنا عمرو بن علي ثنا عبد الله بن إدريس ووكيع بن الجراح وأبو معاوية وحماد بن سعيد المازني قالوا حدثنا الأعمش عن عمارة عن أبي معمر عن أبي مسعود قال قال رسول الله صلى الله عليه وسلم Y لا صلاة لرجل لا يقيم صلبه في الركوع والسجود هذا إسناد ثابت صحيح PageV01P348 2 - حدثنا بدر بن الهيثم ثنا محمد بن إسماعيل الأحمسي ثنا وكيع وعبيد الله وأبو أسامة والمحاربي ويعلى عن الأعمش بإسناده عن النبي صلى الله عليه وسلم Y لا تجزيء صلاة لا يقيم الرجل صلبه مثله(@)PageV01P348(@)(@@)(@@)(@@) || AUTO 
ms290	 ( 42 باب وجوب وضع الجبهة والأنف ) PageV01P348 1 - حدثنا أبو عبد الله بن المهتدي ثنا الحسن بن علي بن خلف الله الدمشقي ح وحدثنا محمد بن الحسين بن سعيد الهمداني ثنا أبو عبد الملك أحمد بن إبراهيم القرشي بدمشق قالا نا سليمان بن عبد الرحمن نا ناشب بن عمرو الشيباني ثنا مقاتل بن حيان عن عروة عن عائشة قالت Y أبصر رسول الله صلى الله عليه وسلم امرأة من أهله تصلي ولا تضع أنفها بالأرض فقال ما هذه ضعي أنفك بالأرض فإنه لا صلاة لمن لم يضع أنفه بالأرض مع جبهته في الصلاة ناشب ضعيف ولا يصح مقاتل عن عروة PageV01P348 2 - ثنا عبد الله بن سليمان بن الأشعث ثنا الجراح بن مخلد حدثنا أبو قتيبة ثنا شعبة عن عاصم الأحول عن عكرمة عن بن عباس عن النبي صلى الله عليه وسلم قال Y لا صلاة لمن لم يضع أنفه على الأرض ورواه غيره عن شعبة عن عاصم عن عكرمة مرسلا PageV01P348 3 - حدثنا عبد الله بن سليمان ثنا الجراح بن مخلد ثنا أبو قتيبة ثنا سفيان الثوري ثنا عاصم الأحول عن عكرمة عن بن عباس قال قال رسول الله صلى الله عليه وسلم Y ورأى رجلا يصلي ما يصيب أنفه من الأرض فقال لا صلاة لمن لا يصيب أنفه من الأرض ما يصيب الجبين قال لنا أبو بكر لم يسنده عن سفيان وشعبة إلا أبو قتيبة والصواب عن عاصم عن عكرمة مرسلا PageV01P348 4 - حدثنا يعقوب بن إبراهيم البزاز وجماعة قالوا ثنا الحسن بن عرفة ثنا إسماعيل بن عياش عن عبد العزيز بن عبيد الله قال Y قلت لوهب بن كيسان يا أبا نعيم مالك لا تمكن جبهتك وأنفك من الأرض قال ذلك إني سمعت جابر بن عبد الله يقول رأيت رسول الله صلى الله عليه وسلم يسجد بأعلى جبهته على قصاص الشعر تفرد به عبد العزيز بن عبيد الله عن وهب وليس بالقوي(@)PageV01P349(@)(@@)(@@)(@@) || AUTO ( 43 باب صفة الجلوس للتشهد وبين السجدتين ) PageV01P349 1 
ms291	 - حدثنا بن صاعد ثنا محمد بن عمرو بن العباس وبندار قالا نا عبد الوهاب ح وحدثنا أحمد بن إسحاق بن البهلول القاضي حدثنا أبو موسى محمد بن المثنى ثنا عبد الوهاب ثنا عبيد الله بن عمر عن القاسم عن عبد الله بن عبد الله عن عبد الله بن عمر قال Y سنة الصلاة أن تفترش اليسرى وتنصب اليمنى تفرد به عبد الوهاب PageV01P349 2 - ثنا أبو محمد بن صاعد ثنا أبو موسى محمد بن المثنى ومحمد بن عمرو بن العباس واللفظ لأبي موسى قالا نا عبد الوهاب قال سمعت يحيى بن سعيد يقول سمعت القاسم يقول أخبرني عبد الله بن عبد الله بن عمر أنه سمع بن عمر يقول Y من سنة الصلاة أن تضجع اليسرى وتنصب اليمنى PageV01P349 3 - حدثنا بن صاعد ثنا بندار ثنا عبد الوهاب ثنا عبيد الله عن نافع عن بن عمر قال Y سنة الصلاة أن تفترش اليسرى وتنصب اليمنى هذه كلها صحاح لم يروها إلا الثقفي(@)PageV01P349(@)(@@)(@@)(@@) || AUTO ( 44 باب صفة التشهد ووجوبه واختلاف الروايات فيه ) PageV01P349 1 - حدثنا عبد الله بن سليمان ثنا محمد بن آدم ثنا أبو خالد الأحمر عن بن عجلان عن عامر بن عبد الله بن الزبير عن أبيه قال Y كان رسول الله صلى الله عليه وسلم إذا جلس يدعو يعني في التشهد يضع يده اليمنى ويشير بأصبعه اليمنى السبابة ويضع الإبهام على الوسطى ويضع يده اليسرى على فخذه اليسرى ويلقم كفه اليسرى فخذه اليسرى PageV01P349 2 - حدثنا عبد الله بن سليمان بن الأشعث ثنا عيسى بن حماد ثنا الليث عن أبي الزبير عن سعيد بن جبير وطاوس عن بن عباس أنه قال Y كان رسول الله صلى الله عليه وسلم يعلمنا التشهد كما يعلمنا القرآن وكان يقول التحيات المباركات الصلوات الطيبات لله سلام عليك أيها النبي ورحمة الله وبركاته سلام علينا وعلى عباد الله الصالحين أشهد أن لا إله إلا الله وأشهد أن محمدا رسول الله هذا إسناد صحيح PageV01P350 3 - حدثنا أبو عبد 
ms292	 الله عبيد الله بن عبد الصمد بن المهتدي بالله ثنا أحمد بن محمد بن الحجاج بن رشدين بن سعد حدثني أبي عن أبيه عن جده حدثني عمرو بن الحارث أن أبا الزبير حدثه عن عطاء وطاوس وسعيد بن جبير عن بن عباس قال Y كان رسول الله صلى الله عليه وسلم يعلمنا التشهد التحيات المباركات والطيبات لله السلام عليك أيها النبي ورحمة الله وبركاته السلام علينا وعلى عباد الله الصالحين أشهد أن لا إله إلا الله وأشهد أن محمدا رسول الله PageV01P350 4 - حدثنا أبو محمد يحيى بن محمد بن صاعد إملاء ثنا أبو عبيد الله المخزومي سعيد بن عبد الرحمن ثنا سفيان بن عيينة عن الأعمش ومنصور عن شقيق بن سلمة عن بن مسعود قال كنا نقول قبل أن يفرض التشهد السلام على الله السلام على جبريل وميكائيل فقال رسول الله صلى الله عليه وسلم Y لا تقولوا هكذا فإن الله هو السلام ولكن قولوا التحيات لله والصلوات والطيبات السلام عليك أيها النبي ورحمة الله وبركاته السلام علينا وعلى عباد الله الصالحين أشهد أن لا إله إلا الله وأشهد أن محمدا عبده ورسوله هذا إسناد صحيح PageV01P350 5 - حدثنا أبو بكر بن أبي داود ثنا المسيب بن واضح ثنا يوسف بن أسباط وعبد الله بن المبارك عن سفيان عن أبيه ومنصور والأعمش وحماد ومغيرة عن شقيق عن عبد الله قال Y علمنا رسول الله صلى الله عليه وسلم التشهد التحيات لله ثم ذكر مثله PageV01P351 6 - حدثنا أبو بكر بن أبي داود ثنا نصر بن علي أخبرني أبي عن شعبة عن أبي بشر قال سمعت مجاهدا يحدث عن بن عمر عن رسول الله صلى الله عليه وسلم أنه قال في التشهد Y التحيات لله والصلوات والطيبات السلام عليك أيها النبي ورحمة الله قال بن عمر زدت فيها وبركاته السلام علينا وعلى عباد الله الصالحين أشهد أن لا إله إلا الله قال بن عمر وزدت فيها وحده لا شريك له وأشهد أن محمدا 
ms293	 عبده ورسوله هذا إسناد صحيح وقد تابعه على رفعه بن أبي عدي عن شعبة ووقفه غيرهما PageV01P351 7 - حدثنا أبو بكر الشافعي ثنا محمد بن علي بن إسماعيل السكري ثنا خارجة بن مصعب بن خارجة ح وحدثني أحمد بن محمد بن أبي عثمان الغازي أبو سعيد النيسابوري ثنا أبو العباس محمد بن عبد الرحمن الدغولي ثنا خارجة بن مصعب بن خارجة ثنا مغيث بن بديل ثنا خارجة بن مصعب عن موسى بن عبيدة عن عبد الله بن دينار عن بن عمر قال Y كان رسول الله صلى الله عليه وسلم يعلمنا التشهد التحيات الطيبات الزاكيات لله السلام عليك أيها النبي ورحمة الله وبركاته السلام علينا وعلى عباد الله الصالحين أشهد أن لا إله إلا الله وحده لا شريك له وأن محمدا عبده ورسوله ثم يصلي على النبي صلى الله عليه وسلم هذا لفظ بن أبي عثمان موسى بن عبيدة وخارجة ضعيفان PageV01P351 8 - ثنا عبد الله بن سليمان بن الأشعث ثنا محمد بن وزير الدمشقي ثنا الوليد بن مسلم أخبرني بن لهيعة أخبرني جعفر بن ربيعة عن يعقوب بن الأشج أن عون بن عبد الله بن عتبة كتب لي في التشهد عن بن عباس وأخذ بيدي فزعم أن عمر بن الخطاب أخذ بيده فزعم Y أن رسول الله صلى الله عليه وسلم أخذ بيده فعلمه التشهد التحيات لله والصلوات الطيبات المباركات لله هذا إسناد حسن وابن لهيعة ليس بالقوي PageV01P351 9 - حدثنا علي بن عبد الله بن مبشر ثنا أحمد بن المقدام ثنا المعتمر قال سمعت أبي يحدث عن قتادة عن أبي غلاب عن حطان بن عبد الله الرقاشي أنهم صلوا مع أبي موسى فقال Y إن رسول الله صلى الله عليه وسلم خطبنا فكان يبين لنا من صلاتنا ويعلمنا سنتنا فذكر الحديث وقال فيه فإذا كان عند القعدة فليكن من قول أحدكم التحيات الطيبات الصلوات لله السلام عليك أيها النبي ورحمة الله وبركاته السلام علينا وعلى عباد الله الصالحين أشهد أن لا 
ms294	 إله إلا الله وحده لا شريك له وأشهد أن محمدا عبده ورسوله زاد فيه على أصحاب قتادة وحده لا شريك له وخالفه هشام وسعيد وأبان وأبو عوانة وغيرهم عن قتادة وهذا إسناد متصل حسن PageV01P351 10 - حدثنا أبو بكر النيسابوري حدثنا علي بن حرب وأحمد بن منصور بن سيار وأحمد بن منصور بن راشد وعباس بن محمد وغيرهم قالوا ثنا حسين بن علي الجعفي ح وحدثنا أبو صالح عبد الرحمن بن سعيد الأصبهاني ثنا أبو مسعود ح وحدثنا الحسين بن إسماعيل ثنا أحمد بن محمد بن يحيى بن سعيد قالا نا حسين بن علي الجعفي عن الحسن بن الحر عن القاسم بن مخيمرة قال أخذ علقمة بيدي وقال أخذ عبد الله بيدي وقال Y أخذ رسول الله صلى الله عليه وسلم بيدي فعلمني التشهد التحيات لله والصلوات والطيبات السلام عليك أيها النبي ورحمة الله وبركاته السلام علينا وعلى عباد الله الصالحين أشهد أن لا إله إلا الله أشهد أن محمدا عبده ورسوله تابعه بن عجلان ومحمد بن أبان عن الحسن بن الحر PageV01P352 11 - حدثنا أبو بكر النيسابوري ثنا محمد بن عبد الله بن عبد الحكم ثنا حجاج بن رشدين عن حيوة عن بن عجلان ح وحدثنا أبو بكر ثنا أحمد بن منصور ثنا بن أبي مريم ثنا يحيى بن أيوب حدثني بن عجلان عن الحسن بن الحر Y بإسناده مثله ورواه زهير بن معاوية عن الحسن بن الحر فزاد في آخره كلاما وهو قوله إذا قلت هذا أو فعلت هذا فقد قضيت صلاتك فإن شئت أن تقوم فقم وإن شئت أن تقعد فاقعد فأدرجه بعضهم عن زهير في الحديث ووصله بكلام النبي صلى الله عليه وسلم وفصله شبابة عن زهير وجعله من كلام عبد الله بن مسعود وقوله أشبه بالصواب من قول من أدرجه في حديث النبي صلى الله عليه وسلم لأن بن ثوبان رواه عن الحسن بن الحر كذلك وجعل آخره من قول بن مسعود ولاتفاق حسين الجعفي وابن عجلان 
ms295	 ومحمد بن أبان في روايتهم عن الحسن بن الحر على ترك ذكره في آخر الحديث مع اتفاق كل من روى التشهد عن علقمة وعن غيره عن عبد الله بن مسعود على ذلك والله أعلم PageV01P352 12 - وأما حديث شبابة عن زهير فحدثنا إسماعيل بن محمد الصفار ثنا الحسن بن مكرم ثنا شبابة بن سوار ثنا أبو خيثمة زهير بن معاوية ثنا الحسن بن الحر عن القاسم بن مخيمرة قال أخذ علقمة بيدي قال وأخذ عبد الله بن مسعود بيدي قال Y أخذ رسول الله صلى الله عليه وسلم بيدي فعلمني التشهد التحيات لله والصلوات والطيبات السلام عليك أيها النبي ورحمة الله وبركاته السلام علينا وعلى عباد الله الصالحين أشهد أن لا إله إلا الله وأشهد أن محمدا عبده ورسوله قال عبد الله فإذا قلت ذلك فقد قضيت ما عليك من الصلاة فإذا شئت أن تقوم فقم وإن شئت أن تقعد فاقعد شبابة ثقة وقد فصل آخر الحديث جعله من قول بن مسعود وهو أصح من رواية من أدرج آخره في كلام النبي صلى الله عليه وسلم والله أعلم وقد تابعه غسان بن الربيع وغيره فرووه عن بن ثوبان عن الحسن بن الحر كذلك وجعل آخر الحديث من كلام بن مسعود ولم يرفعه إلى النبي صلى الله عليه وسلم PageV01P353 13 - حدثنا علي بن عبد الله بن مبشر ثنا أحمد بن سنان القطان ثنا موسى بن داود ثنا زهير بن معاوية أبو خيثمة عن الحسن بن الحر عن القاسم بن مخيمرة قال أخذ علقمة بيدي وزعم أن بن مسعود أخذ بيده وزعم Y أن رسول الله صلى الله عليه وسلم أخذ بيده فعلمه التشهد التحيات لله والصلوات والطيبات السلام عليك أيها النبي ورحمة الله وبركاته السلام علينا وعلى عباد الله الصالحين أشهد أن لا إله إلا الله وأشهد أن محمدا عبده ورسوله ثم قال إذا قضيت هذا أو فعلت هذا فقد قضيت صلاتك فإن شئت أن تقوم فقم وإن شئت أن تجلس فاجلس 
ms296	 PageV01P353 14 - وأما حديث بن ثوبان عن الحسن بن الحر الذي رواه عنه غسان بن الربيع بمتابعة شبابة عن زهير عن الحسن بن الحر فحدثنا به جعفر بن محمد بن نصير ثنا الحسين بن الكميت ثنا غسان بن الربيع ح وحدثنا به محمد بن الحسين بن علي الحراني وعمر بن أحمد بن محمد المعدل وآخرون قالوا حدثنا أحمد بن علي بن المثنى ثنا غسان بن الربيع عن عبد الرحمن بن ثابت بن ثوبان عن الحسن بن الحر عن القاسم بن مخيمرة أنه سمعه يقول Y أخذ علقمة بيدي وأخذ بن مسعود بيد علقمة وأخذ النبي صلى الله عليه وسلم بيد بن مسعود فعلمه التشهد التحيات لله والصلوات والطيبات السلام عليك أيها النبي ورحمة الله وبركاته السلام علينا وعلى عباد الله الصالحين أشهد أن لا إله إلا الله وأشهد أن محمدا عبده ورسوله ثم قال بن مسعود إذا فرغت من هذا فقد فرغت من صلاتك فإن شئت فاثبت وإن شئت فانصرف(@)PageV01P354(@)(@@)(@@)(@@) || AUTO ( 45 باب ذكر وجوب الصلاة على النبي صلى الله عليه وسلم في التشهد واختلاف الروايات في ذلك ) PageV01P354 1 - حدثنا أحمد بن محمد بن يزيد الزعفراني ثنا عثمان بن صالح الخياط ثنا محمد بن بكر ثنا عبد الوهاب بن مجاهد حدثني مجاهد حدثني بن أبي ليلى أو أبو معمر قال Y علمني بن مسعود التشهد وقال علمنيه رسول الله صلى الله عليه وسلم كما يعلمنا السورة من القرآن التحيات لله والصلوات والطيبات السلام عليك أيها النبي ورحمة الله وبركاته السلام علينا وعلى عباد الله الصالحين أشهد أن لا إله إلا الله وأشهد أن محمدا عبده ورسوله اللهم صل على محمد وعلى آل بيته كما صليت على إبراهيم إنك حميد مجيد اللهم صل علينا معهم اللهم بارك على محمد وعلى أهل بيته كما باركت على آل إبراهيم إنك حميد مجيد اللهم بارك علينا معهم صلوات الله وصلوات المؤمنين على محمد النبي الأمي السلام عليكم ورحمة الله وبركاته قال وكان مجاهد يقول إذا 
ms297	 سلم فبلغ وعلى عباد الله الصالحين فقد سلم على أهل السماء وأهل الأرض بن مجاهد ضعيف الحديث PageV01P354 2 - حدثنا أبو بكر النيسابوري ثنا أبو الأزهر أحمد بن الأزهر ثنا يعقوب بن إبراهيم بن سعد ثنا أبي عن بن إسحاق قال وحدثني Y في الصلاة على رسول الله صلى الله عليه وسلم إذا المرء المسلم صلى عليه في صلاته محمد بن إبراهيم بن الحارث التيمي عن محمد بن عبد الله بن زيد بن عبد ربه الأنصاري أخي بالحارث بن الخزرج عن أبي مسعود الأنصاري عقبة بن عمرو قال أقبل رجل حتى جلس بين يدي رسول الله صلى الله عليه وسلم ونحن عنده فقال يا رسول الله أما السلام عليك فقد عرفناه فكيف نصلي عليك إذا نحن صلينا في صلاتنا قال فصمت رسول الله صلى الله عليه وسلم حتى أحببنا أن الرجل لم يسأله ثم قال إذا صليتم علي فقولوا اللهم صل على محمد النبي الأمي وعلى آل محمد كما صليت على إبراهيم وعلى آل إبراهيم وبارك على محمد النبي الأمي وعلى آل محمد كما باركت على إبراهيم وعلى آل إبراهيم إنك حميد مجيد هذا إسناد حسن متصل PageV01P354 3 - ثنا أحمد بن محمد بن سعيد ثنا علي بن الحسين بن عبيد بن كعب ثنا سعيد بن عثمان الخزاز ح وحدثنا أحمد بن محمد بن سعيد ثنا أحمد بن الحسين بن سعيد ثنا أبي ثنا سعيد بن عثمان ثنا عمرو بن شمر عن جابر عن عبيد الله بن بريدة عن أبيه قال قال رسول الله صلى الله عليه وسلم Y يا أبا بريدة إذا جلست في صلاتك فلا تتركن التشهد والصلاة علي فإنها زكاة الصلاة وسلم على جميع أنبياء الله ورسله وسلم على عباد الله الصالحين PageV01P355 4 - حدثنا أبو الحسين علي بن عبد الرحمن بن عيسى الكاتب من أصل كتابه نا الحسين بن الحكم بن مسلم الحبري ثنا سعيد بن عثمان الخزاز ثنا عمر بن شمر عن جابر قال قال الشعبي سمعت مسروق 
ms298	 بن الأجدع يقول قالت عائشة إني سمعت رسول الله صلى الله عليه وسلم يقول Y لا تقبل صلاة إلا بطهور وبالصلاة علي عمرو بن شمر وجابر ضعيفان PageV01P355 5 - حدثنا محمد بن عبد الله بن إبراهيم الشافعي حدثنا محمد بن غالب ثنا علي بن بحر حدثنا عبد المهيمن بن عباس عن أبيه عن جده سهل بن سعد أن النبي صلى الله عليه وسلم قال Y لا صلاة لمن لم يصل على نبيه صلى الله عليه وسلم عبد المهيمن ليس بالقوي PageV01P355 6 - حدثنا أحمد بن محمد بن سعيد ثنا جعفر بن علي بن نجيح الكندي ثنا إسماعيل بن صبيح عن سفيان بن إبراهيم الحريري عن عبد المؤمن بن القاسم عن جابر عن أبي جعفر عن أبي مسعود الأنصاري قال قال رسول الله صلى الله عليه وسلم Y من صلى صلاة لم يصل فيها علي ولا على أهل بيتي لم تقبل منه جابر ضعيف وقد اختلف عنه PageV01P355 7 - حدثنا عثمان بن أحمد الدقاق حدثنا الحسن بن سلام ثنا عبيد الله بن موسى ثنا إسرائيل عن جابر عن محمد بن علي عن أبي مسعود الأنصاري قال Y لو صليت صلاة لاأصلي فيها على آل محمد ما رأيت أن صلاتي تتم PageV01P355 8 - حدثنا عبد الله بن يحيى الطلحي بالكوفة ثنا أحمد بن محمد بن أبي موسى الكندي أبو عمر ثنا أحمد بن يونس ثنا زهير ثنا جابر عن أبي جعفر قال قال أبو مسعود Y ما صليت صلاة لا أصلي فيها على محمد إلا ظننت أن صلاتي لم تتم(@)PageV01P356(@)(@@)(@@)(@@) || AUTO ( 46 باب ذكر ما يخرج من الصلاة به وكيفية التسليم ) PageV01P356 1 - حدثنا عبد الله بن سليمان ثنا محمد بن بشار ثنا عبد الرحمن ثنا عبد الله بن جعفر الزهري عن إسماعيل بن محمد بن سعد عن عامر بن سعد عن أبيه عن النبي صلى الله عليه وسلم Y أنه كان يسلم عن يمينه حتى يرى بياض خده وعن يساره حتى يرى بياض خده هذا إسناد 
ms299	 صحيح PageV01P356 2 - ثنا بدر بن الهيثم القاضي ويحيى بن محمد بن صاعد قالا ثنا أبو الفضل فضالة بن الفضل التميمي بالكوفة ثنا أبو بكر بن عياش عن أبي إسحاق عن صلة بن زفر عن عمار بن ياسر قال Y كان النبي صلى الله عليه وسلم إذا سلم عن يمينه يرى بياض خده الأيمن وإذا سلم عن شماله يرى بياض خده الأيمن والأيسر وكان تسليمه السلام عليكم ورحمة الله السلام عليكم ورحمة الله PageV01P356 3 - حدثنا عبد الله بن سليمان ثنا محمود بن آدم ثنا الفضل بن موسى ثنا الحسين بن واقد عن أبي إسحاق عن الأسود وعلقمة وأبي الأحوص عن بن مسعود Y أن رسول الله صلى الله عليه وسلم كان يسلم عن يمينه السلام عليكم ورحمة الله حتى ينظر إلى بياض خده وعن شماله اختلف على أبي إسحاق في إسناده ورواه زهير عن أبي إسحاق عن عبد الرحمن بن الأسود عن أبيه وعلقمة عن عبد الله وهو أحسنهما إسنادا PageV01P356 4 - حدثنا الحسين بن إسماعيل ثنا يوسف بن موسى ثنا حميد الرواسي ثنا زهير عن أبي إسحاق عن عبد الرحمن بن الأسود عن أبيه وعلقمة عن عبد الله قال Y أنا رأيت رسول الله صلى الله عليه وسلم يكبر في كل رفع ووضع وقيام وقعود ويسلم عن يمينه وعن يساره السلام عليكم ورحمة الله السلام عليكم ورحمة الله حتى يرى بياض خده ورأيت أبا بكر وعمر يفعلان ذلك PageV01P357 5 - حدثنا أبو بكر بن أبي داود ثنا عمرو بن علي ثنا عبد الله بن داود عن حريث عن الشعبي عن البراء بن عازب Y أن النبي صلى الله عليه وسلم كان يسلم تسليمتين PageV01P357 6 - حدثنا عبد الله بن محمد بن عبد العزيز البغوي حدثني منصور بن أبي مزاحم حدثنا أبو سعيد المؤدب عن زكريا عن الشعبي عن مسروق عن عبد الله بن مسعود قال Y ما نسيت من الأشياء فلم أنس تسليم رسول الله صلى الله عليه وسلم في الصلاة عن يمينه 
ms300	 وشماله السلام عليكم ورحمة الله السلام عليكم ورحمة الله ثم قال كأني أنظر إلى بياض خديه PageV01P357 7 - حدثنا عبد الله بن سليمان بن الأشعث ثنا جعفر بن مسافر ح وحدثنا أبو بكر النيسابوري نا محمد بن يحيى ح وحدثنا القاضي الحسين بن إسماعيل ومحمد بن مخلد قالا نا محمد بن مسلم بن واره قالوا نا عمرو بن أبي سلمة عن زهير بن محمد عن هشام بن عروة عن أبيه عن عائشة قالت Y كان رسول الله صلى الله عليه وسلم يسلم في الصلاة تسليمة واحدة تلقاء وجهه يميل إلى الشق الأيمن قليلا PageV01P357 8 - ثنا بن مخلد ثنا الرمادي ثنا نعيم ثنا روح بن عطاء بن أبي ميمون عن أبيه عن الحسن عن سمرة بن جندب قال Y كان رسول الله صلى الله عليه وسلم يسلم واحدة في الصلاة قبل وجهه فإذا سلم عن يمينه سلم عن يساره PageV01P358 9 - حدثنا يحيى بن محمد بن صاعد ثنا يحيى بن خالد أبو سليمان المخزومي المدني حدثنا عبد الله بن نافع الصائغ عن عبد المهيمن بن عباس بن سهل الساعدي عن أبيه عن جده Y أن رسول الله صلى الله عليه وسلم كان يسلم تسليمة واحدة عن يمينه من الصلاة PageV01P359 10 - حدثنا يزداد بن عبد الرحمن ثنا الزبير بن بكار نا عتيق بن يعقوب ثنا عبد المهيمن بن عباس عن أبيه عن جده أنه Y سمع رسول الله صلى الله عليه وسلم يسلم تسليمة واحدة لا يزيد عليها(@)PageV01P359(@)(@@)(@@)(@@) || AUTO ( 47 باب مفتاح الصلاة الطهور ) PageV01P359 1 - حدثنا بن أبي داود ثنا علي بن المنذر ثنا بن فضيل ثنا أبو سفيان السعدي ح وحدثنا أبو حامد محمد بن هارون ثنا أبو الوليد القرشي ثنا الوليد بن مسلم ثنا إبراهيم بن عثمان عن أبي سفيان عن أبي سعيد قال قال رسول الله صلى الله عليه وسلم Y مفتاح الصلاة الوضوء وتحريمها التكبير وتحليلها التسليم وقال بن أبي داود الطهور PageV01P359 2 - حدثنا عبد الله بن أبي داود ثنا 