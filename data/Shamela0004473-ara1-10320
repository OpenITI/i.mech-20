ms10305	 جرير، وسلمة ابن المجنون [32] .(@)(@@)(@@)(@@) | 208 - (@)(@@) دجين بن ثابت أبو الغصن بصري عن أسلم مولى عمر، وعن هشام بن عروة [33] .(@)(@@)(@@)(@@) | 209 - (@)(@@) دينار أبو سعيد عقيصا، كوفي عن علي مناكير، رماه أبو بكر بن عياش بالكذب.(@)(@@)(@@)(@@) | 210 - (@)(@@) دهثم بن قران قدم المدينة عن يحيى بن أبي كثير، ونحران لا يعرف إلا به مجهول [34] .(@)(@@)(@@)(@@) | 211 - (@)(@@) درست بن زياد القشيري، بصري عن يزيد الرقاشي، وأبان بن طارق، لا يروى عنه غيره [35] .(@)(@@)(@@)(@@) | 212 - (@)(@@) درست بن حمزة بصري، عن مطر الوراق [36] .(@)(@@)(@@)(@@) | 213 - (@)(@@) ذؤيب بن عمامة بن عمرو السهمي، عن مالك، والمدنيين [37] .(@)(@@) حرف الراء(@)(@@)(@@)(@@) | 214 - (@)(@@) ربيع بن بدر، ويقال عليلة بن بدر، بصري عن الأعمش، ويونس بن عبيد، منكر الحديث، عن مالك والمدنيين [38] .(@)(@@)(@@)(@@) | 215 - (@)(@@) ربيع بن حبيب، أخو عابد كوفي عن نوفل بن عبد الملك عن أبيه عن علي.(@)(@@)(@@)(@@) | 216 - (@)(@@) فأما الربيع بن حبيب الرقاشي، فهو بصري مقل يروي عن المصريين لا يترك [39] .(@)(@@)(@@)(@@) | 217 - (@)(@@) ربيع بن سهل بن الدكين، كوفي عن سعيد بن عبيد، وعبد الله بن شريك العامري.(@)(@@)(@@)(@@) | 218 - (@)(@@) رشدين بن سعد أبو الحجاج، بصري، ضعيف.(@)(@@)(@@)(@@) | 219 - (@)(@@) رشدين بن كريب مدني [40] .(@)(@@)(@@)(@@) | 220 - (@)(@@) رشيد الهجري، عن أبيه عن عبد الله بن عمرو [41] .(@)(@@)(@@)(@@) | 221 - (@)(@@) روح بن أسلم، أبو حاتم بصري عن حماد بن سلمة.(@)(@@)(@@)(@@) | 222 - (@)(@@) روح بن عطاء بن أبي ميمونة عن أبيه.(@)(@@)(@@)(@@) | 223 - (@)(@@) روح بن مسافر، كوفي عن أبي إسحاق، وحبيب بن أبي ثابت، كناه لؤي أبو المعطا.(@)(@@) PageV29P046(@)(@@)(@@)(@@) | 224 - (@)(@@) روح بن غطيف جزري، عن الزهري، وعمرو بن مصعب الكوفي.(@)(@@)(@@)(@@) | 225 - (@)(@@) رباح بن عبيد الله بن عمر القرشي، قال بعضهم: أبو بكر مدني.(@)(@@)(@@)(@@) | 226 - (@)(@@) ركن بن عبد الله الشامي، عن مكحول، مقل.(@)(@@)(@@)(@@) | 227 - (@)(@@) رواد بن الجراح أبو عصام عسقلاني، عن الثوري، وسعيد.(@)(@@) حرف الزاي(@)(@@)(@@)(@@) | 228 - (@)(@@) زيد بن عبد الرحمن بن زيد بن أسلم، عن أبيه منكر الحديث.(@)(@@)(@@)(@@) | 229 - (@)(@@) زيد بن الحسن بصري، يحدث عن مالك بن أنس بمناكير.(@)(@@)(@@)(@@) | 230 - (@)(@@) زيد بن جبيره بن محمود بن أبي جبيره الأنصاري، عن أبيه لا يعرف أبوه إلا به، وعن داود بن 
ms10306	 الحصين [42] .(@)(@@)(@@)(@@) | 231 - (@)(@@) فهد بن عوف أبو ربيعة ويقال زيد، بصري عن حماد بن سلمة [43] .(@)(@@)(@@)(@@) | 232 - (@)(@@) زياد بن المنذر أبو الجارود، كوفي عن أبي الطفيل، وأبي جعفر محمد ابن علي [44] .(@)(@@)(@@)(@@) | 233 - (@)(@@) زياد بن أبي حسان، أبو عمار بصري عن أنس، وعن عمر بن عبد العزيز [45] .(@)(@@)(@@)(@@) | 234 - (@)(@@) زياد بن ميمون أبو عمار عن أنس [46] .(@)(@@)(@@)(@@) | 235 - (@)(@@) زياد بن أبي زياد الجصاص عن الحسن، وابن سيرين، وأبي عثمان النهدي [47] .(@)(@@)(@@)(@@) | 236 - (@)(@@) زياد بن المنذر، وإنما هو منذر بن زياد الطائي، بصري عن زيد بن أسلم عن أبيه عن عمر حديث منكر، وله أيضا مناكير [48] .(@)(@@)(@@)(@@) | 237 - (@)(@@) زكريا بن حكيم الحبطي، كوفي عن الشعبي.(@)(@@)(@@)(@@) | 238 - (@)(@@) زكريا بن يحيى الكسائي، الكوفي عن يحيى بن سالم الأسدي، متروك أيضا.(@)(@@)(@@)(@@) | 239 - (@)(@@) زنفل أبو عبد الله العرني عن ابن أبي مليكة.(@)(@@)(@@)(@@) | 240 - (@)(@@) زبير بن سعيد الهاشمي النوفلي، مدني حمل عنه ابن المبارك، وجرير بن حازم. يعتبر به بما رواه عن عبد الله بن علي بن زيد بن ركانه؛ فأما ما يرويه عن محمد بن المنكدر فإنه يترك [49] .(@)(@@) حرف السين(@)(@@)(@@)(@@) | 241 - (@)(@@) سلمة بن صالح الأحمر، كوفي سكن واسط وبغداد عن أبي إسحاق وحماد بن أبي سليمان، ومالك بن أوس الحدثاني [50] .(@)(@@)(@@)(@@) | 242 - (@)(@@) سلمة بن وردان، مديني عن أنس [51] .(@)(@@) PageV29P047(@)(@@)(@@)(@@) | 243 - (@)(@@) سليمان بن عبد الله بن سليمان، أبو بكر الهذلي، بصري عن الحسن، وابن سيرين.(@)(@@)(@@)(@@) | 244 - (@)(@@) سري بن إسماعيل الكوفي، عن الشعبي، ضعفه يحيى القطان وغيره.(@)(@@)(@@)(@@) | 245 - (@)(@@) سري بن عاصم بغدادي، عن أيوب، وحفص بن غياث، وغندر والناس [52] .(@)(@@)(@@)(@@) | 246 - (@)(@@) سليمان بن أرقم أبو معاذ، عن الزهري، وابن سيرين، وقيل أن داود عن الزهري حديث الصدقات أنه هو.(@)(@@)(@@)(@@) | 247 - (@)(@@) سليمان بن الحكم بن عوانة، واسطي، عن الأعمش.(@)(@@)(@@)(@@) | 248- (@)(@@) سليمان بن خالد واسطي، عن قتادة، وطلحة بن مصرف، هو أخو العلاء ابن خالد والعلاء يعتبر به.(@)(@@)(@@)(@@) | 249 - (@)(@@) سليمان بن داود الخولاني عن الزهري.(@)(@@)(@@)(@@) | 250 - (@)(@@) سليمان بن داود أبو أيوب الشاذكوني، بصري.(@)(@@)(@@)(@@) | 251 - (@)(@@) سليمان بن زيد أبو ادام. عن ابن أبي أوفى [53] .(@)(@@)(@@)(@@) | 252 - (@)(@@) سليمان بن سفيان مديني، أبو سفيان، 
ms10307	 عن عبد الله بن دينار، وبلال بن يحيى، سمع منه أبو عامر العقدي، ومعمر بن سليمان [54] .(@)(@@)(@@)(@@) | 253 - (@)(@@) سليمان بن سفيان الجهني مدايني، عن قيس بن الربيع عن ورقاء [55] .(@)(@@)(@@)(@@) | 254 - (@)(@@) سليمان بن عمرو النخعي، أبو داود كوفي [56] .(@)(@@)(@@)(@@) | 255 - (@)(@@) سليمان بن يسير، أبو الصباح كوفي، عن النخعي، والحكم، وقيس بن رومى، وقال سليمان بن بشير [57] .(@)(@@)(@@)(@@) | 256 - (@)(@@) سليمان بن أبي سليمان القافلاني، أبو محمد بصري، عن الحسن، وابن سيرين، روى عنه عبيد الله بن موسى، فقال: سليمان الخوزي [58] .(@)(@@)(@@)(@@) | 257 - (@)(@@) سالم بن عبد الأعلى أبو الفيض، كوفي عن نافع وغيره [59] .(@)(@@)(@@)(@@) | 258 - (@)(@@) سالم الخياط، عن الحسن، وابن سيرين [60](@)(@@)(@@)(@@) | 259 - (@)(@@) سليمان بن أبي سراج [61] .(@)(@@)(@@)(@@) | 260 - (@)(@@) سلم بن سالم البلخي، عن عبيد الله بن عمر، وابن جريج، والثوري [62] .(@)(@@)(@@)(@@) | 261 - (@)(@@) سليمان بن مسلم الخشاب، مكي، عن ابن جريج، والمكيين [63] .(@)(@@)(@@)(@@) | 262 - (@)(@@) سلام بن أبي خبزة بصري، عن العالم.(@)(@@)(@@)(@@) | 263 - (@)(@@) سلام بن سليمان وقيل: ابن سلمان، وقيل: ابن سالم الطويل المدايني، متروك عن زيد العمي.(@)(@@) PageV29P048(@)(@@)(@@)(@@) | 264 - (@)(@@) سعد بن طريف الاسكاف، كوفي عن عكرمة، والأصبغ [64] .(@)(@@)(@@)(@@) | 265 - (@)(@@) سعد بن سنان، وقيل: سنان بن سعد، عن أنس، روى عنه يزيد بن أبي حبيب [65] .(@)(@@)(@@)(@@) | 266- (@)(@@) سعد بن سعيد بن أبي سعيد المقبري، أخو عبد الله [66] .(@)(@@)(@@)(@@) | 267 - (@)(@@) سعيد بن سلام العطار، أبو الحسن بصري نزل مكة، عن الثوري، والعالم [67] .(@)(@@)(@@)(@@) | 268 - (@)(@@) سعيد بن سنان أبو مهدي، حمصي، عن أبي الزاهرية [68] .(@)(@@)(@@)(@@) | 269 - (@)(@@) سعيد بن زون بصري، عن أنس [69] .(@)(@@)(@@)(@@) | 270 - (@)(@@) سعيد بن زربى أبو معاوية بصري، عن ابن سيرين، وأبي المليح متروك.(@)(@@)(@@)(@@) | 271 - (@)(@@) سعيد بن عبد الجبار الحمصي، العطار، عن أبي بكر بن أبي مريم، والحمصيين [70] .(@)(@@)(@@)(@@) | 272 - (@)(@@) سعيد بن واصل أبو عمرو الحرشي، ويقال أبو عمر بصري عن شعبة [71] .(@)(@@)(@@)(@@) | 273 - (@)(@@) سعيد بن راشد أبو