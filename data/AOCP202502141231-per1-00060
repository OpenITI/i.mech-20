ms41	 به اولم به دم، همچون نای %~% وله %~% پس آخر کار، سر در آورد چو چنگ(@)(@@) (@@) 401 آن هند ورا، که سوختن می شاید %~% کردیش عزیز تر زمن، می شاید!(@)(@@) (@@) در سر دارد، که لب نهد بر لب تو %~% گر برداری سرش زتن، می شاید!(@)(@@)(@@)(@@) | قاضی ابوالمجد(@)(@@) ~~402 دوش اندر رقص، آن صنم حورنژاد در حال، که در راه صفاهان افتاد(@)(@@) ~~در رقص، هنوز پایش اندر خود بود کز جملهآ خلخال، بر آمد فریاد(@)(@@)(@@)(@@) | صدر خجندی(@)(@@) ~~403 آن بت، که برش حور بود گستی گست دی بر سر کوی دیدمش مستی مست(@)(@@) (@@) می گفت و، همی کوفت چو رقاصان پای %~% کای دلشدگان، لاف زدن دستی دست!(@)(@@)(@@)(@@) | ابوحنیفهآ اسکاف(@)(@@) ~~404 تا من نشوم به خاک در پستی پست زوشن نشود، که درجهان هستی هست(@)(@@) (@@) به زان نبود، که در جهان مستی مست %~% می کوبم پای و، می زنم دستی دست(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 405 در رقص، چو جولان کند آن سیم تنش %~% سجده برد ازرشک، گل و یاسمنش(@)(@@) (@@) بر نطع سوم، عروس رقاص فلک %~% سر کوفته شد، زرشک پاکوفتنش PageV01P162(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0166.jpg)(@)(@)(@@)(@@)(@@) | نزهة المجالس(@)(@@)(@@)(@@) | لااعرف(@)(@@) (@@) 406 در رقص، بتم چو آستین برمی کرد %~% صد گونه شمایلش به هم برمی کرد(@)(@@) (@@) می آمد و، آرزوش در پا می مرد %~% می رفت و، امید خاک بر سر می کرد(@)(@@)(@@)(@@) | کمال اسماعیل(@)(@@) (@@) 40 در حالت عشق، بس نکو رقص کنم %~% و اندر غمت، از هزار تو رقص کنم(@)(@@) (@@) دست است ودل است، آلت رقاصی %~% کو دست و دلی، که من بدو رقص کنم(@)(@@) شمس اسعد گنجه ای(@)(@@) (@@) 40 تا چند، چودف دست ستمهات خورم %~% یا همچو رباب، زخم غمهات خورم(@)(@@) (@@) گفتی که: «چو چنگ در برت بنوازم!» %~% من، نای تونیستم که دمهات خورم!(@)(@)PageV01P163(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0167.jpg)(@)(@)(@@)(@@)(@@) | باب ششم(@)(@@)(@@)(@@) | در فصلها(@)(@@) وآن دونمط است(@)(@@)(@@)(@@) | نمط اول(@)(@@) درفصل ربیع ورباحین(@)(@@) شمس اسعد گنجه ای(@)(@@) ~~405 دوشم زعنا گرچه دل غمخوربود عقلم، به جهان خوشدلی رهبر بود(@)(@@) (@@) هر صفحه، که از دفتر 
ms42	 شادی خواندم %~% اله %~% در باب نشاط، فصل گل خوشتر بود!(@)(@@) (@@) 410 چون زلف بنفشه، از صبا گشت به تاب %~% از جام سحاب، خورد باید می ناب(@)(@@) (@@) داماد طرب کنجاست؟ مشاطهآ صنع %~% از روی عروس گل، برانداخت نقاب(@)(@@) حمید پسر رشید گنجه ای(@)(@@) ~~411 آمد گل، اگرباده گساری، واخور بی باده، نفس چند شماری، واخور(@)(@@) (@@) دی، اقچه نداشتی نخوردی، شاید %~% وله %~% امروز، که گل به دست داری وا خور(@)(@@) ~~412 صحرا، زبهاردیبهآ صد رنگ است در باغ، نهاده بلبلان را جنگ است(@)(@@) (@@) گویند که: زر نشاط آرد، اکنون %~% با اینهمه زر، غنچه چرا دلتنگ است؟(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 413 ای مایهآ جان، امید را می مانی %~% و ایام سیه سپید را می مانی(@)(@@) (@@) صد بان، چو سوسنم زبان دادی، بس! %~% ای جمله خلاف، بید را می مانی!(@)(@)PageV01P164(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0168.jpg)(@)(@)(@@)(@@)(@@) | زکی مراغه ای(@)(@@) ~~41 گل، گرچه به صد برگ و نوا می آیدزرین کمر و، بسته قبا می آید(@)(@@) (@@) آن غنچه، ازان کلاهدار است که زر %~% در کیسه اش ازباد هوا می آید(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 41 گل، گرچه به سالی نفسی می آید %~% با بوی گلم، خوش هوسی می آید(@)(@@) (@@) ربوی گل، ارجان بدهم، معذورم %~% کز بوی خوشش، بوی کسی می آید(@)(@@)(@@)(@@) | لاادری(@)(@@) (@@) 41 دی، می گفتم بلبل سودایی را: %~% ای کرده زدل دور، شکیبایی را(@)(@@) (@@) تا کی نالی از گل و، چون خود گیری %~% معشوقهآ شهر گرد و هر جایی را(@)(@@)(@@)(@@) | مغیره(@)(@@) ~~41 گل، خواست که چون روی تو زیبا باشد حسنی باید، چو حسن تو روز(@)(@@) افزون %~% یکروزه نکویی، همه کس را باشد! %~% وین خود چه خیال است، چه سودا باشد؟(@)(@@)(@@)(@@) | کمال اسماعیل(@)(@@) (@@) 417 وقت است، که گلها بنپایند وروند %~% وز شرم رخت، قفا نمایند و روند(@)(@@) (@@) خوبی توجاودان بماناد، ارنه 41 از بس که سوی چمن برد، بوی توباد %~%(@)(@@) وله %~% هر سال، چو گل هزار آیند و روند! %~% وزبس که کند، گل ز دو رخسار تویاد(@)(@@) (@@) اکنون، همه آزادی سرتا پایت %~% در 
ms43	 دست و زبان سرو و سوسن افتاد(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 420 گر لاله بشد، سیاه کامی کم گیر %~% وررفت بنفشه، تیره فامی کم گیر(@)(@@) (@@) آنجا که رخ توباشد، ارگل نبود %~% از بزم طرب، شکسته جامی کم بگیر(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 421 جایی، که می لعل پیاپی گردد %~% طبعم، همه گرد طرب و می گردد(@)(@@) (@@) وقت گل و، می حاضر و، یاران همدم %~% گر توبه کنم، مسلمم کی گردد؟(@)(@)PageV01P165(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0169.jpg)(@)(@)(@@)(@@)(@@) | اوله(@)(@@) ~~422 لاله، همه رنگ ارغوانی به توداد نرگس، همه مایهآ جوانی به توداد(@)(@@) ~~گل بود، که اندکی به رویت می مانداو نیز برفت و، زندگانی به تو داد!(@)(@@)(@@)(@@) | وله(@)(@@) ~~423 گل، خواست که چون رخش نکوباشد و، نیست مانندهآ او به رنگ و بوباشد و، نیست(@)(@@) (@@) صد روی فراهم آورد، هر سالی %~% خواهد که یکی چوروی او باشد و، نیست(@)(@@)(@@)(@@) | وله(@)(@@) ~~424 ای برده گل از رخ چو گلنارتو، رنگو آورده، ز شرم رخ بربار تو رنگ(@)(@@) ~~با روی تو، روزگار گل رفت در آنک می آرد و می برد، ز رخسار تو رنگ(@)(@@)(@@)(@@) | اوله(@)(@@) ~~425 چون، رنگ بدزدید گل از رخسارش وآویخت صبا، چو خونیان بردارش(@)(@@) ~~بسیار بگفت بلبل اندر کارشتا، باد صبا داد به جان زنهارش!(@)(@@)(@@)(@@) | وله(@)(@@) ~~426 از پرده چو آمد گل رنگین بیروناندوه، کنیم از دل غمگین بیرون(@)(@@) ~~کردند نظاره را، عروسان چمنسرها، ز دریچههای چوبین بیرون(@)(@@)(@@)(@@) | وله(@)(@@) ~~427 باور نکنی که خوبرویان یکسر نبالهآ زرشوند، آنک، بنگر!(@)(@@) ~~پیرامن گل، بهر دو سه خردهآ زرصد روی نکو، فتاده بر همدیگر!(@)(@@)(@@)(@@) | وله(@)(@@) ~~28، خوبان، همه را صید توان کرد به زر خوش خوش، بر وصل شان توان خورد به زر(@)(@@) ~~نرگس، که کلهدار جهان است، ببین کو نیز، چگونه سر در آورد به زر PageV01P166(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0170.jpg)(@)(@)(@@)(@@)(@@) | وله(@)(@@) ~~429 وقت است، که بلبل زغم آشوب کند فراش، چمن زباد جاروب کند(@)(@@) (@@) گل، پیرهن دریدهآ خون آلود %~% اوله %~% از دست رخ تو، بر سر چوب کند!(@)(@@) (@@) 43 بلبل، به سپنده دم همی زد 
ms44	 فریاد %~% کآتش زگل اندر همه گلزار افتاد!(@)(@@) (@@) ابر، از برش ارچه آب می ریخت، چه سود %~% کآتش همه در گرفته بود از دم باد(@)(@@)(@@)(@@) | وله(@)(@@) ~~43 آن را، که دل از غمی مشوش باشد باد سحرش، آب بر آتش باشد(@)(@@) (@@) یماری باد، می دهد جان به چمن %~% وله %~% بیمار که جان چنین دهد، خوش باشد!(@)(@@) (@@) 43 آن لاله نگر: چو ساغری آمده خرد %~% یک نیمه از آن صافی و، یک نیمش درد(@)(@@) (@@) وان شبنم بین: نشسته بر عارض گل %~% گویی که پیاله حل شد و، می بفسرد!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) گه لرزه برآب افگند، باد صبا 43 گه زلف بنفشه برکند، باد صبا %~% گه(@)(@@) ساغر لاله بشکند، باد صبا %~% و آنگه چه دم لطف زند، باد صبا!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 42 شاخ، ارزشکوفه شکل پروین دارد %~% آن هم، ز سرشک من مسکین دارد(@)(@@) (@@) از نالهآ من، کوه بدان سنگدلی %~% از لاله به دامن، دل خونین دارد(@)(@@)(@@)(@@) | اوله(@)(@@) ~~43 فراش چمن، باد شمال است اکنونبی باده و گل، عمروبال است اکنون(@)(@@) (@@) ی خور، که به اجماع همه اهل خرد %~% خون رز و، مال گل، حلال است اکنون!(@)(@)PageV01P167(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0171.jpg)(@)(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 36، آن غنچه نگر، چو من گرفتار به دل %~% بیوسته لبش به مهر و، انکار به دل(@)(@@) (@@) آورده فراهم رخ و، بر خود پیچان %~% زان است، که هردم رسدش خاربه دل!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 437 آن غنچهآ دوشیزه نگر، آبستن %~% از مهر شده، به یک نظر آبستن(@)(@@) (@@) لعلی، به هزار خرده زر آبستن %~% چون پیکانی، به صد سپر آبستن(@)(@@) (@@) 38) عشاق بر آمدند، پیرامن گل %~% یکباره زدند دست، در دامن گل(@)(@@) (@@) از بس که همی کشند، پیراهن گل %~% آنک! به هزار شاخ شد، برتن گل(@)(@@) (@@) 439 آتش چو فکند باد، در خرمن گل %~% اوله %~% برخاکی چکید، آب پیراهن گل(@)(@@) (@@) ای ساقی می! دست تو و، دامن گل %~% ای دختر رز، خون تو در گردن گل!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) .44 شد باد، مطر اگر پیراهن سرو %~% آورد چنار، دست در گردن سرو 
ms45	(@)(@@) (@@) ابر آمد و، برداشت به صد لابه گری %~% گردی، که نشسته بود در دامن سرو(@)(@@) (@@) 41، آمد گل و، آورد به پیراهن زر %~% اوله %~% بنشست به باغ و، کرد بر خرمن زر(@)(@@) (@@) یعنی که: به شادی نتوان برد به سر %~% یکروزه حیات، جزبه یک دامن زر!(@)(@@)(@@)(@@) | اوله(@)(@@) ~~442 آن غنچهآ گل نگر: چه چست افتاده ست برداشته آخر، زنخست افتادهست(@)(@@) (@@) دی، روی چنان فراهم آورده دژم %~% و امرون، چنین زخنده سست افتادهست PageV01P168(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0172.jpg)(@)(@)(@@)(@@)(@@) | وله(@)(@@) ~~44 در فرقت تو، چو بلبلم نوحه گران چون دیدهآ نرگس، از پی جان نگران(@)(@@) (@@) چون لالهام: از میان جان سوخته دل %~% چون غنچه ام: از درون دل جامه دران(@)(@@)(@@)(@@) | اوله(@)(@@) ~~445 دیدی، که دگر بی رخ آن سرو بلند آمد گل و، بلبل پی او رخت افکند(@)(@@) (@@) ای بیهده گوی مست، بسیار مگوی! %~% وی شوخ دهن دریده، بسیار مخند!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 445 ابر آمد و، کرد پرگهر دامن گل %~% زیرا همه دامن است، پیراهن گل(@)(@@) (@@) ما نیز، نهیم رخت پیرامن گل %~% پیمانه همی زنیم، در خرمن گل(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 446 اندر مه روزه، گل چنان می خندد %~% گویی، که به طنز برجهان می خندد(@)(@@) (@@) می روشن و، نوبهار و، مردم هشیار! %~% گل را عجب آمدهست، از آن می خندد!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 447 وقت است، که بلبل به گل آواز کند %~% این لابه در افزاید و، آن ناز کند(@)(@@) (@@) بلبل، به سخن مضاحک آغاز کند %~% تا، گل به شکر خنده دهن باز کند(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 448 ای دل، سخن زلف مشوش بگذار %~% و اندیشهآ وصل یار مهوش، بگذار(@)(@@) (@@) در سایهآ گل، این دو سه روزی از عمر %~% گر بگذارند ناخوشان، خوش بگذار!(@)(@@)(@@)(@@) | وله(@)(@@) ~~44 چون بلبل مست، راه در بستان یافت روی گل و جام باده را خندان یافت(@)(@@) (@@) آمد، به زبان حال در گوشم گفت: %~% «دریاب، که روز رفته را نتوان یافت!، PageV01P169(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0173.jpg)(@)(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 450 وقت است، که پر زچین شود طرهآ آب %~% وز نعرهآ تندر، بدرد زهرهآ 
ms46	 آب(@)(@@) (@@) از قطرهآ آب، آتش گل بدمد %~% وز آتش غنچه، بچکد قطرهآ آب(@)(@@)(@@)(@@) | اوله(@)(@@) ~~51، نرگس، که دلش هوای ساغر داردبادی زنشاط و لهو، در سر دارد(@)(@@) (@@) در دست عصا زمرد تر دارد %~% کوری به نشاط است، مگر زر دارد!(@)(@@)(@@)(@@) | ول(@)(@@) (@@) 452 گفتم که چو مست شد مرا نازارد %~% ار بوسه زنم برایگان، بگذارد(@)(@@) (@@) افسوس، که همچونرگس، آن بینایی %~% مست است هنوز و، چشم زرمی دارد!(@)(@@)(@@)(@@) | اوله(@)(@@) ~~453 نرگس، که مرا در نظر آمد چشمش وز هرچه خوش است، خوشتر آمد چشمش(@)(@@) (@@) در خوبی، اگر چه بر سر آمد چشمش %~% با چشم تو، هم به سر در آمد چشمش(@)(@@)(@@)(@@) | وله(@)(@@) ~~454 با غنچه، صبا چودست اندر کش کرد بشکفت و، زشرم چهره چون آتش کرد(@)(@@) ~~دانست، که نورسیده و ساده دل است او را، به دو سه قراضه زردل خوش کرد!(@)(@@)(@@)(@@) | اوله(@)(@@) ~~455 با چشم تو، باد چشم عبهر بگندسودای تو، مرغ عقل را پر بکند(@)(@@) ~~ورگل، نه به اندام کند خدمت توهم، باد صباش پوست از سر بکند!(@)(@@)(@@)(@@) | اله(@)(@@) ~~456 امسال، بهار رسم دیگرگون کردمستخرجیش، بادصبا بین چون کرد؟(@)(@@) ~~بر شاخ، شکوفه را کشید اندر چوب تا هر درمی که داشت، زو بیرون کرد!(@)(@)PageV01P170(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0174.jpg)(@)(@)(@@)(@@)(@@) | اوله(@)(@@) ~~57)، ماییم، نهفته گریه در خنده چوگل مرده به دمی و، از دمی زنده چو گل(@)(@@) ~~خود را، به همه میان در افگنده چوگل واندر همه مجمعی پرا گنده چوگل!(@)(@@)(@@)(@@) | وله(@)(@@) ~~58، چون کیسهآ غنچه را، صبا پرزردید غمازی کرد و، پرده بر وی بدرید(@)(@@) ~~در زخم شکنجه اش، چنان تنگ کشید کش از سر ناخنان، همه خون بچکید!(@)(@@)(@@)(@@) | وله(@)(@@) ~~456 گر، دیدهآ نرگس نه سبل می دارد بینایی او، از چه خلل می دارد(@)(@@) ~~شید، ارنه سر خلاف دارد در باغاز بهر چه، گربه در بغل می دارد!(@)(@@) (@@) 46 گر من، زغمت حکایت آغاز کنم %~% اله %~% با خود، دل خلقی به غم انباز کنم(@)(@@) (@@) خون، در دل من فسرده بینی ده تو %~% چون غنچه، 
ms47	 اگر من سر دل باز کنم(@)(@@) (@@) 461 در حسن، ندارد گل صد پر پایت %~% اوله %~% زان، می افتد زدست اندر پایت(@)(@@) ~~وان غنچه، که لب فراهم آورد چنان زان است، که تا بوسه دهد بر پایت(@)(@@)(@@)(@@) | اوله(@)(@@) ~~461 وقت است، که صحرا خوش و دلکش گردد وز باد صبا، خاک منقش گردد(@)(@@) لبل، زسر شاخ به آواز آید %~% اوله %~% از نغمهآ او، وقت سحر خوش گزدد(@)(@@) ~~46 بلبل، چوبه کار خویشتن درماندبنشیند و، گل را بر خود بنشاند(@)(@@) (@@) صد قصه، زحال خویش بر گل خواند %~% پندارد، گل زبان مرغان داند!(@)(@)PageV01P171(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0175.jpg)(@)(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 464 سیم، ارچه نه مایهآ خردمندان است %~% بی سیمان را، باغ جهان زندان است(@)(@@) (@@) از دست تهی، بنفشه سر بر زانوست %~% وزکیسهآ پر، چهرهآ گل خندان است!(@)(@@) قاضی کمال مراغهای(@)(@@) (@@) 465 وقت است، که خورشید درآید به حمل %~% در زندگی خاک کند، باد عمل(@)(@@) (@@) بر گردن و گوش و شاخ، بندند حلی %~% و اندرتن راغ وباغ، پوشند حلل(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 4،66 برخیز، که روی چمن افروختهاند %~% مرغان، غزل عشق در آموختهاند(@)(@@) (@@) بر سبزه، که هست نطع زنگاری باغ %~% وله %~% صد شمسهآ زرنگار گل دوخته اند(@)(@@) (@@) 467 خواهی، که دلت شود زغمها رسته %~% در باغ خرام، صبحدم آهسته(@)(@@) (@@) ببر سبزهآ باغ، قطرهآ ژاله ببین %~% اوله %~% چون لؤلؤتازه، بر زمرد بسته(@)(@@) (@@) 468 گل گفت: چمن گرچه زمن با نسق است %~% لیکن، زحیات حاصلم یک رمق است(@)(@@) (@@) با اینهمه، دل نهم بر آتش زجهان %~% تا بوک عرق شوم، که اصلم عرق است(@)(@@)(@@)(@@) | اوله(@)(@@) ~~469 غنچه، چوسر از شاخ چمن بیرون کرد آرامگه، از سریر میناگون کرد(@)(@@) (@@) می خواست، که گوید سخنی در رویت %~% بادش، به یکی مشت دهان پرخون کرد!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 470 عشاق، دل اندر قدح مل بستند %~% جان، در نغمات خوش بلبل بستند(@)(@@) ~~اکنون که هر آن زر که خزان داشت، به باغ در صرهآ سرخ اطلس گل بستند(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 471 از چهرهآ گل، نقاب بگشاد صبا %~% صد بوسه، به 
ms48	 ناز بر رخش داد صبما(@)(@@) (@@) از بلبل عاشقش، نیامد شرمی %~% یا رب، که چه بیشرم کس افتاد صبا!(@)(@@)(@@)(@@) | اله(@)(@@) (@@) 72) دی بلبلکی، عاشقکی، خوشگویی %~% در باغ همی گفت، به طرف جویی(@)(@@) (@@) کز لعل و زمرد و زرخرده، توان %~% بر ساخت گلی، ولی ندارد بویی!(@)(@)PageV01P172(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0176.jpg)(@)(@)(@@) ~~قدری زر خرده، زآستینم گم شد 473 گل، گرچه لباس حسن تو بر توداشت(@)(@@) 47 خود هست دلی، که نیست آزردهآ زر؟ %~% اوله %~% اوله %~% چون دامن گل(@)(@@) بجستم، آن زر او داشت! %~% وزلطف وجمال، صورت نیکوداشت %~% یا هست کسی، که نیست او مردهآ زر؟(@)(@@) (@@) گل نیز، که زندگانیش یک روزاست %~% وله %~% دارد طبقی زلعل، پر خردهآ زر(@)(@@) ~~گبل نیزبه باغ، آن قدری زر کاو راست 475 آن را که زراست، همچوجان می(@)(@@) دارد %~% وله %~% پیوسته، زبخل در دهان می دارد! %~% چون جانش از آن روی، نهان می دارد(@)(@@) (@@) 47 گل را چو نظر بر رخت افتاد، بریخت %~% یک بار، دهن پیش توبگشاد بریخت(@)(@@) (@@) ظلمی است صریح، اینکه رخت برسرخاک %~% وله %~% خون دل تنگ غنچه، برباد بریخت!(@)(@@) ~~471 گل، صبحدم از باد برآشفت و بریخت بدعهدی عمربین، که گل درده روز(@)(@@) %~% وله %~% با باد صبا حکایتی گفت و، بریخت %~% سربرزد و، غنچه کرد و، بشکفت و، بریخت!(@)(@@) ~~،47 گل را دیدم، دمیده از کام آتش گفتم که: چه شد؟ گفت: بلایی است(@)(@@) دراز %~% کوتاهی عمرو، پس سرانجام آتش! %~% وز آب گرفته، هفت اندام آتش(@)(@@)(@@)(@@) | عبدالعزیز گنجه ای(@)(@@) (@@) 479 با روی تو، از قمر نمی آید هیچ گر صد ورق از دفتر گل باز کنم %~%(@)(@@) وله %~% با لعل تو، از شکر نمی آید هیچ! %~% جز شرح رخ تو، بر نمی آید هیچ!(@)(@@) (@@) 480 من، کژی ابروی تو را می دانم امسال، چو پار گل خجل خواهد شد %~%(@)(@@) و آشفتگی موی تو را می دانم %~% از روی تو، من روی تو را می دانم!(@)(@@)(@@)(@@) | شمس اسعد گنجهای(@)(@@) (@@) 481 آن باد صبا، که داردش بوی توخوش %~% یک دم نشود، 
ms49	 بی خم گیبوی توخوش(@)(@@) (@@) می گفت حکایتی زرویت با گل %~% شد وقت گل، از حکایت روی توخوش PageV01P173(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0177.jpg)(@)(@)(@@)(@@)(@@) | وله(@)(@@) ~~482 آنها، که دل از عشق تو پرخون کردند این طرفه نگه کن، که چه موزون کردند(@)(@@) (@@) با روی تو، می کرد به خوبی دعوی %~% گل را، به خطا زشهر بیرون کردند!(@)(@@)(@@)(@@) | اشهری(@)(@@) ~~483 نوخاسته گل، که عقل دیوانهآ اوست شمعی است، که عندلیب پروانهآ اوست(@)(@@) (@@) ناخواندهاش هزار مهمان، بیش است %~% له %~% برطرف چمن، که میهمانخانهآ اوست(@)(@@) (@@) 484 زیبایی باغ بین و، محبوبی گل %~% شیدایی بلبل نگر و، خوبی گل(@)(@@) ~~تحریر کشان لطف، خوش می دوزند پیراهن نازو، کفش عرقوبی گل(@)(@@)(@@)(@@) | اوله(@)(@@) ~~485 پک سال، در آن کرد گیل خوش دیدار تا کرد به روی خویش، رخشان گلزار(@)(@@) (@@) از دور، دمی بدو نمودی رخسار %~% اله %~% صد ساله خجالتش، نهادی در بار!(@)(@@) ~~486 ای لاله، مگر رای تماشا زدهای کان خیمه سبزرا، به صحرا زدهای(@)(@@) ~~وان خرگه واشگونهآ لعلی را خوش، بر سریک ستون مینا زدهای!(@)(@@)(@@)(@@) | بدیع بیلقانی(@)(@@) ~~87) چون شعبدهآ طبع، به باغ افسون کرد بر نطع چمن، بازی دیگر گون کرد(@)(@@) (@@) از مهرهآ گل، طاسک لعلی برساخت %~% غیره %~% وزحقهآ لعل، زنگیی بیرون کرد(@)(@@) ~~88، با قامت تو، زنی برآمد نالهبنشست زعشقت، به عرق در ژاله(@)(@@) ~~از رشک برت، نشست آب اندر خاک وز شرم رخت، سرخ برآمد لاله(@)(@@) جمال حاجی شروانی(@)(@@) (@@) 489 می خورد به پاییز، درخت از ژاله %~% شدمست و، شکوفه می کند یکساله(@)(@@) (@@) از بهر شکوفه کردنش بین، که چمن %~% هستا %~% بنهاد، هزار طشت لعل از لاله(@)(@@) (@@) 490 آوازهآ گل در انجمن، چیزی هست؟ %~% طفل است و، دریده پیرهن، چیزی هست؟(@)(@@) ~~خوی کرده و سرخ گشته و شرم زده مشتی زرخرده دردهن، چیزی هست؟(@)(@)PageV01P174(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0178.jpg)(@)(@)(@@)(@@)(@@) | اوله(@)(@@) ~~91، با روی خوشت، گل وسمن چیزی هست با قامت تو، سرو چمن چیزی هست؟(@)(@@) (@@) بلبل، به زبان حال با گل می گفت: %~% اوله %~% کآوازهآ گل در انجمن، چیزی هست؟(@)(@@) ~~492 دی، وقت 
ms50	 سحر بلبل شوریدهآ مست می آمد و، بهر مژده جان بر کف دست(@)(@@) ~~می گفت نسیم را که: از بهر خدا آوازهآ گل در انجمن، چیزی هست؟(@)(@@)(@@)(@@) | مبارک شاه غوری(@)(@@) ~~49 گل، عادت ناز جمله برخاک زده ستدر باغ، دم خویش طربناک زده ست(@)(@@) (@@) برنالهآ یارخویش، یعنی بلبل %~% وله %~% بنگر، که چگونه پیرهن چاک زده ست(@)(@@) (@@) 499 ده رنگ آورد گل، دراین روزی بیست %~% صد قبه به باغ بست و، یک روز نزیست(@)(@@) (@@) بر عمر خود و، عهد توو، کارجهان %~% دیر آمد و زود رفت و، خندید و، گریست!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) گل باری کیست، آن... زنش فراخ 49 گیرم که چوتونشسته باشی در کاخ %~%(@)(@@) کو، با رخ توبه باغ آید گستاخ! %~% دزدیده، درآید آفتاب از سوراخ(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 49 ای گل، به سرباغ شبیخون بردی %~% از کیسهآ ابر، در مکنون بردی(@)(@@) (@@) بلبل، چو تو را بدین خیانت بگرفت %~% رنگ آوردی، به خنده بیرون بردی!(@)(@@) (@@) 497 نرگس، ز زمینی که بدو بی سپری %~% وله %~% گل، از سر شاخ تا بدو برگذری(@)(@@) (@@) روید همه چشم، تا به تودر نگرد %~% وله %~% روید همه روی، تا بدو در نگری(@)(@@) (@@) 498 گل، با رخ خوب توبخندید وبرفت %~% از رنگ رخت، رنگ بدزدید و برفت(@)(@@) (@@) امسال، برآراسته رخ بازآمد %~% گفتم که: «بگیر، دزد!» بشنید و برفت!(@)(@@) ~~499 گل را، که زلعل سفته تختش کردنددی، بر سرتیغ لخت لختش کردند(@)(@@) (@@) امروز، چودیدند که خونی است به رنگ %~% آنک! بنگر که بر درختش کردند!(@)(@)PageV01P175(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0179.jpg)(@)(@)(@@)(@@)(@@) | زکی کاشغری(@)(@@) (@@) 500 گل، ساخته بد زغنچه پیکانی چند %~% تا با تو کند مصاف حسن، ای دلبند(@)(@@) (@@) خورشید رخت، چوتیغ بنمود زدور %~% پیکان به سپر کرد و، سپرهم بفگند!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 501 گل را به جمال، تاب روی تونبود %~% برگشت، از آن کش آب روی تو نبود(@)(@@) (@@) صد صفحه، صبا زروی تو بروی خواند %~% درصد ورقش، جواب روی تو نبود!(@)(@@)(@@)(@@) | سید مرتضی(@)(@@) ~~502 گل، گرچه به خوبی همه تن رو گرددبا روی تو، چون بنفشه 
ms51	 هندو گردد(@)(@@) (@@) وز آرزوی روی تو، هر صبحدمی %~% بر بستر فستقی، به پهلو گردد(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 503 با چشم تو، نرگس سر مستی دارد %~% وز قد تو، سرو آفت پستی دارد(@)(@@) (@@) گل، با همه لعل وزر، گرت بیند روی %~% برباد دهد، هر آنچه هستی دارد(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 504 گر برگ گل، اندام تو افگار کند %~% در دیدهآ [او] حسن رخت کار کند(@)(@@) (@@) وآنگاه ز رشک رخ تو، یک یک خار %~% وله %~% در دیدهآ گل، به صد سنان کار کند!(@)(@@) (@@) 505 ای قد و رخ تو، طیرهآ سرو و سمن %~% وز قد و رخت، قیامتی بر سر من(@)(@@) (@@) از قد چو سرو و، زرخ چون گل توست %~% اوله %~% سر سبزی باغ و، سرخ رویی چمن(@)(@@) (@@) 506 وقت است، که در تن زمین جان آید %~% صحرا، حسد روضهٔ‌ رضوان آید(@)(@@) (@@) وز روح دم باد، که عیسی نفس است 57 در باغ، خروشنده یکی بلبل بود %~%(@)(@@) اوله %~% در قالب خاک، روح و ریحان آید %~% کاندر چمن، از خروش او غلغل بود(@)(@@) (@@) امروز که گل نیست، چرا بلبل نیست %~% اوله %~% بلبل، به نوا گرنه زبرگ گل بود(@)(@@) (@@) 508 گل، رنگ شراب ارغوانی دارد %~% او، باغ بهشت جاودانی دارد(@)(@@) (@@) پرورده به آب زندگانی است مگر %~% کز لطف، طراوت جوانی دارد PageV01P176(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0180.jpg)(@)(@)(@@)(@@)(@@) | اوله(@)(@@) ~~501 باغی است، کزو گیاه دانا روید واندر چشمش، نرگس بینا روید(@)(@@) (@@) هر سوسن و گل، که بر زند سر زگلشن %~% با یاد لبت، خامش و گویا روید(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 510 خیزید، مگر داد دل شاد دهیم %~% مستان صبوح را، طرب یاد دهیم(@)(@@) (@@) ر نغمهآ بلبلان، چو گل جامه دریم %~% پس، همچو شکوفه عمر بر باد دهیم(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 511 گل، سر چو زغنچه بر زند بر لب جوی %~% بنشیند شاد و، تازه می دارد روی(@)(@@) (@@) جاسوس بنفشه را فرستد برمی %~% کای می، اگرت سربه گل است اینجا شوی(@)(@@)(@@)(@@) | صدرخجندی(@)(@@) (@@) 512 آن زخمهآ دست نه، به پای بلبل %~% آنجا که تو حاضری، چه جای بلبل!(@)(@@) (@@) در 
ms52	 زخمهآ چابکت، که بیند جز من؟ %~% اوله %~% گل داند، گل، قدر نوای بلبل!(@)(@@) (@@) 513 ناگاه، بر آمد زچمن غلغلکی %~% یعنی که: شکفته شد به بویی گلکی!(@)(@@) (@@) بودیم در این سخن، که ناگاه آمد %~% بال افشانان، نعره زنان، بلبلکی!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 514 وقت است، که گل سوی گلستان آید %~% با ساز طرب هزار دستان آید(@)(@@) (@@) وان خوش لب نیکورخ بد عهد، چو گل %~% وله %~% می خورده وخوی کرده به بستان آید!(@)(@@) ~~515 ای غنچه، اگر باد مدارات کند زنهار، دمش مخور که رسوات کند(@)(@@) (@@) او پرده در است، بر خودش راه مده %~% ار سیم بنفشه، جمله درپات کند!(@)(@@)(@@)(@@) | اوله(@)(@@) ~~516 وقت است، که آب طره در هم چیند نرگس، همه تن چشم که تا گل بیند(@)(@@) (@@) بلبل، به چنین وقت چمن بکزیند %~% اوله %~% کس، روز چنین به خانه در بنشیند!(@)(@@) ~~517 گل، صبحدم از خواب چو برخاسته بود خود را، چو عروس نو برآراسته بود(@)(@@) ~~مشتی زر ریزه ریزه بر کف کردهزو نیز، مگر که یار زر خواسته بود!(@)(@)PageV01P177(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0181.jpg)(@)(@)(@@)(@@)(@@) | الغیره(@)(@@) ~~518 گفتم: که زند این نفس سرد که من؟بلبل، زدرخت سر فرو کرد که: من!(@)(@@) ~~گفتم: به شب این غوطه کسی خورد که منا نیلوفر، از آب سر برآورد که : من!(@)(@@)(@@)(@@) | ادری(@)(@@) ~~519 گفتم: که خورد بر جگر، این نیش که من؟ بنمود، سحر لاله دل ریش که: من!(@)(@@) ~~گفتم: که کشد محنت از این بیش که من؟خم کرد بنفشه، قامت خویش که : من!(@)(@@)(@@)(@@) | لااعرف(@)(@@) (@@) 520 تا سایه فکند سرو آزاد بر آب %~% تا عکس گل شکفته افتاد برآب(@)(@@) (@@) آب، از هوس بهار دیوانه بماند %~% زنجیر نهاد، از این سبب باد برآب!(@)(@@) (@@) 521 با گل گفتم: عظیم عاری باشد %~% اوله %~% کاندر بر تو خلیده خاری باشد(@)(@@) (@@) گل گفت: چوبر جمع ریاحین ملکم %~% کم زانکه مرا سلاحداری باشد!(@)(@@)(@@)(@@) | مهذب کرجی(@)(@@) (@@) 522 دوشینه، که باد بر گلستان می زد %~% وزچشم خود، ابر آب بستان میزد(@)(@@) (@@) بر گریهآ ابر، لاله خوش می خندید 
ms53	 %~% بلبل، بر گل هزار دستان می زد(@)(@@)(@@)(@@) | لاادری(@)(@@) (@@) 523 در موسم گل، شراب دلکش در کش %~% انصاف بده، باده ستان، خوش درکش(@)(@@) (@@) زان پیش، که گل زآتش آبی گردد %~% در سایهآ گل، آب چو آتش درکش(@)(@@)(@@)(@@) | عزالدین ...(@)(@@) (@@) 524 جانا، به سوی باغ گرافتد رایت %~% سنبل، به سر زلف بروبد جایت(@)(@@) ~~بردست گرفته گل، زاطلس تختی 525 گل را، دهنی خنده پر از خون دادند(@)(@@) %~% اوله %~% تا در چمن آیی، فکند در پایت %~% درد سرش، از گلاب افزون دادند(@)(@@) (@@) گل چه؟ که دل جماعتی پرخون بود %~% غیره %~% آن خون، به طریق خنده بیرون دادند(@)(@@) (@@) 526 در دولت گل، اگر چه بی مال آیی %~% در فصل گل، آن به است در حال آیی(@)(@@) ~~با گل نفسی زن، که اگر در گذری PageV01P178(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0182.jpg)(@)(@)(@@)(@@)(@@) | طلسی(@)(@@) ~~527 گل، باز به گلزار نکو فال آمد بلبل، رخ گل بدید در حال آمد(@)(@@) (@@) گویند کزآن جهان کسی نامد باز %~% چون است که گل پارشد، امسال آمد!(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~528 وقت است، که نقش چمن از سر بندند در گردن شاخ، زر و زیور بندند(@)(@@) (@@) چون سرو کند، دست درازی در باغ %~% از بهرچه دستهای گل در بندند؟(@)(@@)(@@)(@@) | جمال خلیل(@)(@@) ~~520 وقت است، که اندوه زدل کم گرددجام طرب و عیش، دمادم گردد(@)(@@) ~~از بس سبزه، که بر دمد از دل خاکعالم، چوبهشت عدن خرم گردد(@)(@@)(@@)(@@) | سید اشرف(@)(@@) ~~530 ای نرگس تر، جهان معطر کردی وین بزم چو چرخ را، پر اختر کردی(@)(@@) (@@) در باغ خدایگان، چو سر بر کردی %~% اوله %~% دامن پر در، کلاه پر زر کردی(@)(@@) (@@) 53 جانا، به چمن گذر که کوی طرب است %~% رخسارهآ گل نگر، که روی طرب است(@)(@@) (@@) هنگامهآ گرم یاسمین بین، که در او %~% هر شاخ سری، چهار سوی طرب است(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 532 هر بوی، که از مشک و قرنفل شنوی %~% از سایهآ آن زلف چو سنبل شنوی(@)(@@) (@@) چون نغمهآ بلبل ازبی گل شنوی %~% هم گل گوید، گرچه زبلبل شنوی!(@)(@@)(@@)(@@) | الغیره 
ms54	(@)(@@) (@@) 533 مه، پیش رخ تو سرنگون می گردد %~% مشک، ازسر زلفین تو خون می گردد(@)(@@) (@@) ازشوخی یاسمین، عجب میدارم %~% تا، پیش رخت شکفته چون می گردد!(@)(@@)(@@)(@@) | مجیر بیلقانی(@)(@@) (@@) 534 در بزم تو، می با گل سوری در ساخت %~% با باده و گل، نرد طرب باید باخت(@)(@@) (@@) می بود گل، از آه حسود تو فسرد %~% گل بودمی، از آتش تیغ تو گداخت PageV01P179(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0183.jpg)(@)(@)(@@)(@@)(@@) | انوری(@)(@@) ~~535 رفتم بر گل، چو از سفر می آمدوز غنچه، به صد ناز به در می آمد(@)(@@) (@@) با او، صفت روی تومی گفتم و، او %~% از شرم تو سرخ و زرد بر می آمد(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 536 از درد دل گل، همگان بیخبرند %~% شاید که در او به چشم عبرت نگرند(@)(@@) (@@) کز رشک رخت، چنان شد از بیماری %~% کآبش به بر طبیب در شیشه برند!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 537 باد سحری، گذربه کویت دارد %~% زان، بوی بنفشه زار مویت دارد(@)(@@) (@@) در پیرهن غنچه، نمی گنجد گل %~% از شادی آنکه رنگ رویت دارد!(@)(@@)(@@)(@@) | شمس سجاسی(@)(@@) (@@) 538 با گل گفتم که: حسن یارم چون است؟ %~% گفتا: چوغم عشق توروز افزون است(@)(@@) (@@) گفتم که: نماز بر رخ خوبش را؟ %~% گفتا: نتوان، که دامنش پرخون است!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 539 دی، باز رخت عرض گلستان می داد %~% سرو قدت، آرایش بستان می داد(@)(@@) (@@) من نوحه گران، پیش رخت می مردم %~% گل جامه دران، پیش لبت جان می داد!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 540 ای آنکه رخت ببرد، آب مل و گل %~% بتخانهآ چین شد چمن، از سنبل و گل(@)(@@) (@@) بخرام به باغ، تا به هم بنشینیم %~% بی زحمت کس: من و تو و بلبل و گل!(@)(@@)(@@)(@@) | وله(@)(@@) ~~541 بلبل، چونوای ناله بر دست گرفت از گل، گله پیش لاله بر دست گرفت(@)(@@) (@@) لاله به سماع او، چومستان به صبوح %~% خندان خندان، پیاله بر دست گرفت(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 542 در پردهآ غنچه، تا گل آرام گرفت %~% بلبل، زطرب نوای گل بام گرفت(@)(@@) (@@) برخیز، که گل مملکت باغ گشود %~% بشتاب، که 
ms55	 می ولایت جام گرفت(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 543 ای گل، چه سبب بود رخ افروختنت %~% با عمر دو هفته، شادی اندوختنت؟(@)(@@) (@@) سرمایهآ تو زدهر، جز بویی نیست %~% وان نیز، هم آمد سبب سوختنت!(@)(@)PageV01P180(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0184.jpg)(@)(@)(@@)(@@)(@@) | وله(@)(@@) ~~544 بازای گل تازه، این رخ گلگون چیست؟ وین چهرهآ خوب وخندهآ موزون چیست؟(@)(@@) ~~عیسی نه ای، این دم مبارک زکجاست؟یوسف نه ای، آن پیرهن پرخون چیست؟(@)(@@) قاضی مجدالدین بابکر(@)(@@) ~~545 با زلف تو، سنبل زتری پاک نشستسر بر زانو، بنفشه غمناک نشست(@)(@@) (@@) وز رشک رخت، کزو خراب است جهان %~% گل دشت گرفت و، لاله در خاک نشست!(@)(@@)(@@)(@@) | جمال عبدالرزاق(@)(@@) (@@) 546 در عشق، هرآنکه سیم کمتردارد %~% مانند بنفشه، پشت چنبر دارد(@)(@@) (@@) گل را، دورخ سرخ و دهان خندان %~% زان است همه، که در میان زردارد!(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~547 بلبل، چه سبب ناله چوغمناک کند وزبهر چه، گل مفرش خود خاک کند(@)(@@) (@@) گرعاشق، بلبل است، پس وقت سحر %~% گل، خنده زنان جامه چرا چاک کند؟(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 548 گیرم که زعشق گل، بنالد بلبل %~% وزدست من است غرقه در خون شده مل(@)(@@) (@@) صاحبنظری نیست که گوید: زچه خاست %~% دود از دل لاله، آتش ازسینهآ گل!(@)(@@)(@@)(@@) | شیخ برهان گنجه ای(@)(@@) ~~545 در عشق، همه جهان پر آوازهآ ماستوین واقعه، بیش ازحد و اندازهآ ماست(@)(@@) ~~درمجلس ما، گر می و گل نیست چه باک؟ کان بت، می کهنه و، گل تازهآ ماست!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 55 بشنید شکر، صفات نیکویی گل %~% بیرون آمد زنی، به دلجویی گل(@)(@@) (@@) چون وصل شکر، دهان گل شیرین کرد %~% خوش کرد، لب شکر به خوشبویی گل(@)(@@)(@@)(@@) | قوامی گنجه ای(@)(@@) ~~55 این گل، که قضا قبول دادهست او رادر لطف، هزار در گشادهست او را(@)(@@) (@@) هر خار، که پیرامن او می بینی %~% خاری است، که روی تونهاده ست اورا!(@)(@@)(@@)(@@) | عماد الشرف(@)(@@) ~~55 گل بین، که چو رخت در چمن می فکندآوازهآ خود، در انجمن می فکند(@)(@@) ~~پس، زوی تو می بیند و، تن می فکند می افتد و، خاک 
