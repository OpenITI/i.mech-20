ms58	 المعولي (بعين مهملة).(@)(@@) 1352 - (3779) - سلمة = عبد الخالق بن سلمة (بكسر اللام) ويقال: (بفتحها) أبو روح.(@)(@@) 1353 - (3790) - الحناط = عبد ربه بن نافع، الكناني، الحناط (بحاء مهملة ونون).(@)(@@) 1354 - (3793) - دحيم = عبد الرحمن بن إبراهيم، لقبه دحيم (بدال وحاء مهملتين، مصغر).(@)(@@) 1355 - (3794) - أبزى = عبد الرحمن بن أبزى (بفتح الهمزة وسكون الباء الموحدة بعدها زاي مقصور).(@)(@@) 1356 - (3796) - مولى أم برثن = عبد الرحمن بن آدم، مولى أم برثن (بضم الباء الموحدة وسكون الراء بعدها ثاء مثلثة مضمومة ثم نون).(@)(@@) 1357 - (3797) - عبد الرحمن بن أذينة = عبد الرحمن بن أذينة (بنون، مصغر).(@)(@@) 1358 - (4534) - أذينة - هنيدة = وآخر ابن عمر، وصوابه: ابن هنيدة.(@)(@)PageV01P171(@)(@)(@@) 1359 - (3807) - بجيد = عبد الرحمن بن بجيد (بباء موحدة وجيم، مصغر).(@)(@@) 1360 - (3818) - بوذيه = عبد الرحمن بن بوذيه (بضم الباء الموحدة وسكون الواو وبعدها ذال معجمة).(@)(@@) 1361 - (3820) - العنسي = عبد الرحمن بن ثابت العنسي (بالنون).(@)(@@) 1362 - (3823) - ثروان = عبد الرحمن بن ثروان (بثاء مثلثة مفتوحة وراء ساكنة).(@)(@@) 1363 - (3827) - جبير- نفير = عبد الرحمن بن جبير (بجيم وباء موحدة، مصغر) ابن نفير (بنون وفاء، مصغر).(@)(@@) 1364 - (3830) - جوشن - الغطفاني = عبد الرحمن بن جوشن (بفتح الجيم وشين معجمة وسكون الواو بينهما، وآخره نون) الغطفاني (بفتح الغين المعجمة والطاء المهملة والفاء).(@)(@@) 1365 - (3831) - عياش = عبد الرحمن بن الحارث بن عبد الله بن عياش (بياء مثناة من تحت ثقيلة وشين معجمة).(@)(@@) 1366 - (3833) - أبو بلتعة = عبد الرحمن بن حاطب بن أبي بلتعة (بفتح الباء الموحدة والتاء المثناة من فوق وسكون اللام بينهما وعين مهملة).(@)(@@) 1367 - (3834) - الحباب - السلمي = عبد الرحمن بن الحباب (بضم الحاء المهملة وباءين موحدتين الأولى خفيفة) السلمي (بفتح السين المهملة) المدني.(@)(@)PageV01P172(@)(@)(@@) 1368 - (3835) - عبد الرحمن بن الحباب = ونسبة والد عبد الله، وقيل: الأسلمي.(@)(@@) 1369 - (3838) - حجيرة = عبد الرحمن بن حجيرة (بحاء مهملة وبجيم، مصغر).(@)(@@) 1370 - (3840) - سنة = عبد الرحمن بن حرملة بن عمرو بن سنة (بفتح السين المهملة وتثقيل النون).(@)(@@) 1371 - (3844) - حسنة = عبد الرحمن بن حسنة (بفتح الحاء والسين المهملتين ثم نون).(@)(@@) 1372 - (3846) - شعيث = عبد الرحمن بن حماد بن شعيث (بشين معجمة وآخره ثاء مثلثة، مصغر).(@)(@@) 1373 - (3852) - خباب - السلمي = عبد 
ms59	 الرحمن بن خباب (بخاء معجمة وباءين موحدتين الأولى ثقيلة) السلمي (بضم السين) وقيل: (بفتحها).(@)(@@) 1374 - (3853) - النصري = عبد الرحمن بن خلف النصري (بالنون).(@)(@@) 1375 - (3854) - أبو رويق = عبد الرحمن بن خلف، أبو رويق (براء وقاف، مصغر).(@)(@@) 1376 - (3858) - أبو الرجال = عبد الرحمن بن أبي الرجال (بكسر الراء ثم جيم).(@)(@)PageV01P173(@)(@)(@@) 1377 - (3859) - رزين - الغافقي = عبد الرحمن بن رزين (بفتح الراء وكسر الزاي وآخره نون) ويقال: ابن يزيد، والأول هو الصواب، الغافقي (بغين معجمة وفاء مكسورة وقاف).(@)(@@) 1378 - (3860) - الزبير - باطا - القرظي = عبد الرحمن بن الزبير (بفتح الزاي) ابن باطا (بباء موحدة) القرظي (بضم القاف وفتح الراء بعدها ظاء معجمة).(@)(@@) 1379 - (3862) - أنعم = عبد الرحمن بن زياد بن أنعم (بفتح الهمزة وسكون النون وضم العين المهملة).(@)(@@) 1380 - (3869) - أبو نهيك = عبد الرحمن بن السائب، بن أبي نهيك (بفتح النون) ويقال: عبد الله، ويقال: هو عبيد الله بن أبي نهيك.(@)(@@) 1381 - (3879) - الخيواني = عبد الرحمن بن سعيد الخيواني (بخاء معجمة).(@)(@@) 1382 - (3878) - سعوة = عبد الرحمن بن سعوة (بفتح السين المهملة والواو بينهما عين ساكنة).(@)(@@) 1383 - (3881) - سلم = عبد الرحمن بن سلم (بفتح السين المهملة وسكون اللام).(@)(@@) 1384 - (3882) - الحجري = عبد الرحمن بن سلمان، الحجري (بفتح الحاء المهملة وسكون الجيم).(@)(@)PageV01P174(@)(@)(@@) 1385 - (3883) - أبو الأعيس = عبد الرحمن بن سلمان، أبو الأعيس (بفتح الياء المثناة من تحت قبلها عين مهملة ساكنة وآخره سين مهملة).(@)(@@) 1386 - (3885) - أبو الجون - العنسي = عبد الرحمن بن سليمان بن أبي الجون (بفتح الجيم) العنسي (بالنون).(@)(@@) 1387 - (3886) - العنسي = وأبو سليمان الداراني، عبد الرحمن بن أحمد بن عطية العنسي (بالنون).(@)(@@) 1388 - (3889) - سمير - سميرة - أبو سميرة - سمبر = عبد الرحمن بن سمير (بسين مهملة، مصغر) وقيل: سميرة، أو ابن أبي سميرة، ويقال: (بباء موحدة بلا تصغير).(@)(@@) 1389 - (3891) - شبل = عبد الرحمن بن شبل (بكسر الشين المعجمة وسكون الباء الموحدة).(@)(@@) 1390 - (3892) - المعافري = عبد الرحمن بن شريح المعافري (بفتح الميم والعين المهملة).(@)(@@) 1391 - (3894) - أبو الشعثاء = عبد الرحمن بن أبي الشعثاء (بفتح الشين المعجمة والثاء المثلثة بينهما عين مهملة، ممدود).(@)(@@) 1392 - (3895) - شماسة - المهري = عبد الرحمن بن شماسة (كسر الشين المعجمة وتخفيف الميم 
ms60	 بعدها سين مهملة) المهري (بفتح الميم وسكون الهاء).(@)(@)PageV01P175(@)(@)(@@) 1393 - (3896) - أبو شميلة القبائي = عبد الرحمن بن أبي شميلة (بشين معجمة، مصغر) القبائي (بضم القاف وتخفيف الباء الموحدة بعدها ممدود).(@)(@@) 1394 - (3898) - العتكي = عبد الرحمن بن صالح العتكي (بفتح العين المهملة والتاء المثناة من فوق).(@)(@@) 1395 - (3955) - طرفة - عرفجة = عبد الرحمن بن طرفة (بفتح الطاء المهملة والراء والفاء) ابن عرفجة (بفتح العين المهملة والفاء بينهما راء ساكنة ثم جيم).(@)(@@) 1396 - (3957) - عابس = عبد الرحمن بن عابس (بباء موحدة وسين مهملة).(@)(@@) 1397 - (3915) - عايذ - الثمالي = عبد الرحمن بن عايذ (بياء مثناة من تحت وذال معجمة) الثمالي (بضم الثاء المثلثة).(@)(@@) 1398 - (3911) - عايش = عبد الرحمن بن عايش (بياء مثناة من تحت وشين معجمة).(@)(@@) 1399 - (3914) - الدشتكي = عبد الرحمن بن عبد الله الدشتكي (بياء مثناة من تحت مع الدال المهملة وسكون الشين المعجمة وفتح التاء المثناة من فوق).(@)(@@) 1400 - (3916) - اليشكري - النسوي = عبد الرحمن بن عبد الله الشيباني، ويقال: اليشكري (بياء مثناة من تحت مفتوحة وشين معجمة وكاف مضمومة) أبو سفيان النسوي (بنون وسين مهملة).(@)(@)PageV01P176(@)(@)(@@) 1401 - (3918) - جردقة = عبد الرحمن بن عبد الله البصري، جردقة (بفتح الجيم والدال بينهما راء ساكنة ثم قاف).(@)(@@) 1402 - (3921) - القس = عبد الرحمن بن عبد الله بن أبي عمار، الملقب بالقس (بفتح القاف وتشديد السين)، كذا ذكره، والذي يحفظ (بضم القاف)، وأنه سمي بذلك لعبادته.(@)(@@) 1403 - (3925) - الجزري - عبويه = عبد الرحمن بن عبد الله بن مسلم الجزري (بجيم وزاي) يلقب عبويه (بتشديد الباء الموحدة).(@)(@@) 1404 - (3931) - المهري = عبد الرحمن بن عبد الحميد المهري (بفتح الميم وسكون الهاء).(@)(@@) 1405 - (3932) - العائذي = عبد الرحمن بن عبد رب الكعبة العائذي (بعين مهملة وياء مثناة من تحت) وقيل: (بالصاد المهملة).(@)(@@) 1406 - (3935) - حيان - أبجر = عبد الرحمن بن عبد الملك بن سعيد بن حيان (بحاء مهملة وياء مثناة من تحت) ابن أبجر (بباء موحدة وجيم، وزن أحمد).(@)(@@) 1407 - (3936) - الحزامي = عبد الرحمن بن عبد الملك الحزامي (بحاء مهملة وزاي).(@)(@@) 1408 - (3937) - العمي = عبد الرحمن بن عبد الوهاب العمي (ب