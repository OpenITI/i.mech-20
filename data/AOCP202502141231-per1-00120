ms113	(@)(@@)(@@)(@@) | انوری(@)(@@) ~~1117 دی عشق رخش، مرا مشوش می داشت جان، از پی آنکه با غمش یکدل بود(@)(@@) %~% تا وقت سحر، وقت دلم خوش می داشت %~% گه دیده در آب و دل بر آتش می داشت(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 1118 ما را به صبوح، نیست الآ غم تو %~% و آسایش روح، نیست الا غم تو(@)(@@) ~~111 دانی تو که من بی تو چه رسوا باشم تا من بزیم، غم تو خواهم خوردن(@)(@@) هرگز، دل غمگنم به تو شاد مباد %~% اعرف %~% کزعمر، فتوح نیست الآ غم تو(@)(@@) %~% اربی تو دمی شاد زیم، تا باشم %~% ون واله و سرگشته وشیدا باشم PageV01P251(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0255.jpg)(@)(@)(@@)(@@)(@@) | یمین اصفهانی(@)(@@) (@@) یک غم، زعدم پای فراتر ننهد 1120 در باغ طرب، خیمه به صحرا نزند %~%(@)(@@) از غنچهآ دل گلی، که سرما نزند %~% تا دست به صد بهانه در ما نزند!(@)(@@)(@@)(@@) | ایمین اصفهانی(@)(@@) ~~در گفت نیاید، که بگویم غم خویش 1121 در وصف تو، اندیشهآ من گمره شد(@)(@@) %~% در من بنگر، حدیشها کوته شد! %~% وز شوق رخت، فغان من بر مه شد(@)(@@) (@@) 1122 نه زانکه تو را بود زمن بیش و کمی %~% اوله %~% بی انده توم برآرم از سینه دمی(@)(@@) (@@) گر تو نشوی ملول، آرد زمنت %~% هر ذره که در هواست، پیغام غمی!(@)(@@)(@@)(@@) | عزالدین شفروه(@)(@@) (@@) تا کم شودم یاد غم بیهوده 1123 بر خود زغم عشق تو، تا کی پیچم %~% به(@)(@@) زان نبود، که باز در می پیچم %~% در نالهآ چنگ و، در دم نی پیچم!(@)(@@)(@@)(@@) | جمال خلیل شروانی(@)(@@) ~~1124 گر گرد من، ای سرو چمن می گردی دیدی، که چو نقطه شده ام از غم(@)(@@) تو %~% دانم به چه روی و، به چه فن می گردی! %~% زان، دایره وار گرد من می گردی(@)(@@)(@@)(@@) | وله(@)(@@) ~~شادی چه کنم، بی غم تو در عالم؟ 1125 آن را، که غم عشق تو دادش شادی(@)(@@) %~% فرموش بود انده و، یادش شادی %~% آن را که غمت نیست، مبادش شادی!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1122 خوش باش، که تا غم 
ms114	 تو بیحد نشود %~% جان تو، به دام غم مقید نشود(@)(@@) ~~کان تیر، که از شست قضا یافت گشاد 1127 مندیش زسیر اختران، گر مردی(@)(@@) وز شادی، همه کسی خوش باشد %~% وله %~% هرگز، به غم و شادی تو رد نشود! %~%(@)(@@) روزغم را، خوش گذران گر مردی! %~% از جای مرو چو دیگران، گر مردی(@)(@@) (@@) شادی جهان ملک دلم بود، اکنون 1128 تا آرزوی دلگسلم بگرفتهست %~%(@)(@@) اوله %~% و اندیشهآ شمع چگلم بگرفتهست %~% سلطان غمش، ملک دلم بگرفته ست PageV01P252(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0256.jpg)(@)(@)(@@)(@@)(@@) | اوله(@)(@@) ~~1129 با درد تو، جز مرا سر و کار مباد در کوی غم تو، جز مرا بار مباد(@)(@@) (@@) وین دل، که چنین مست شد از جام غمت %~% تاجان به تنش در است، هشیار مباد!(@)(@@) (@@) 1130 چون دیدهآ من با رخ توخوبگرفت %~% اوله %~% جان را، غم عشق تو زهر سوبگرفت(@)(@@) (@@) دل خواست، که از غمش برآرد نفسی %~% سودات در آمد، نفس او بگرفت!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1131 نه هست در این دیار، یارم جز غم %~% نه کس داند در این دیارم، جزغم(@)(@@) (@@) با آنکه زدشمنی خورم غم را من 1132 فریاد، که نیست غمگسارم جز غم %~%(@)(@@) ول %~% این طرفه، که غمخوار ندارم جز غم! %~% زنهار، که نیست در کنارم جزغم(@)(@@) (@@) گویند که: غم مخور بگو پس چه خورم؟ %~% وله %~% از چرخ، چو روزیی ندارم جز غم!(@)(@@) (@@) 1133 هر غم، که زتو بر من دمساز آید %~% صد کار زساز رفته، با ساز آید(@)(@@) (@@) دل خون شودم، ز راه دیده حالی %~% گامی دو سه از پیش، غمت باز آید!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 1134 گفتی که: ««به باغ عشق بالیده نه ای %~% و اندر غم من، چنان پسندیده نه ای»(@)(@@) (@@) در قد خمیده و دل تنگم بین %~% گر صورت غم بعینه دیده نه ای!(@)(@@) (@@) 1135 با غم گفتم: ««جگر به خون می کنی ام %~% وله %~% عشرت کم و، اندوه فزون می کنی ام(@)(@@) (@@) یرون نروی ازدل من» گفتا: «خه! %~% از خانهآ خویشتن برون می کنی ام!)(@)(@@) (@@) 1136 ما، در غم 
ms115	 خود بنسفتیم هنوز %~% له %~% در باغ زمانه، نشکفتیم هنوز(@)(@@) (@@) گفتیم هزار فصل افزون، غم دل %~% وزصد غم دل، یکی نگفتیم هنوز!(@)(@)PageV01P253(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0257.jpg)(@)(@)(@@)(@@)(@@) | باب یانزدهم(@)(@@) در اوصاف وافعال معشوق(@)(@@)(@@)(@@) | وآن چهل ویک نمط است(@)(@@)(@@)(@@) | نمط اول(@)(@@)(@@)(@@) | در حسن وجمال(@)(@@) (@@) 1137 گر حسن توه بر فلک زند خرگاهی %~% از هر برجی، جدا بتابد ماهی(@)(@@) (@@) ور لطف تو، بر زمین بیابد راهی %~% صد یوسف، سر بر زند از هر چاهی(@)(@@)(@@)(@@) | شیخ احمد غزالی(@)(@@) ~~1138 در وصتف توام، دو صد زبان می بایدیا پیشکشم هزارجان می باید(@)(@@) (@@) آنجا که تویی، دست سخن می نرسد %~% فی الجمله، چنانی که چنان می باید!(@)(@@) ~~1139 ناچیده گلی، زآن دو رخ نسرینی دامن ز وصال ما چرا درچینی؟(@)(@@) (@@) تو خود، شکری زفرق سرتا به قدم %~% از بهر چه می کنی، شکر شیرینی؟(@)(@@)(@@)(@@) | به(@)(@@) ~~1140 ای عالم دل ملک تو، شاهت خوانم در جمع بتان، شمع سپاهت خوانم(@)(@@) (@@) یک عکس تو آن است، که ماهش خوانند %~% وله %~% یک سهومن این است، که ماهت خوانم!(@)(@@) ~~1141 ای یوسف عهد، این چه دل آشوبی توست هر زاو یه ای، محنت یعقوبی توست(@)(@@) (@@) خت غم خود، کجا نهم من اکنون %~% چندانکه جهان است، همه خوبی توست!(@)(@)PageV01P254(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0258.jpg)(@)(@)(@@) (@@) 11،2 ای گلشن عقل و جان، رخ روشن تو %~% اوله %~% ننشسته زعیب، گردبر دامن تو(@)(@@) (@@) از لطف، به دست کس نیاید تن تو %~% گر زیر و زبر کنند پیراهن تو(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) جایی که همای حسن توپر بگشود 11،3 ای باز هنر، فاخته خو، کبک دری %~%(@)(@@) طاوس، که باشد که کند جلوه گری؟ %~% طوطی لب و شاهین فر وعنقا گهری(@)(@@) (@@) رچرخ چهارم، از جمالت نقطی 114 ای نقش تو دست اوستادان کرده %~% اله(@)(@@) %~% اوله %~% برداشته، شمع بامدادان کرده %~% انوار فلک را، به تو شادان کرده(@)(@@) (@@) 114،4 دل، چاکر لعل دلر بای تو شود %~% جان، بندهآ جزع جانفزای تو شود(@)(@@) ~~ورعکس پذیرد زجمالت، گردون 1140 ای روی تو نوبهار و بستان بهشت(@)(@@) ناتو، ز بهشت 
ms116	 عدن بگریخته ای %~% وله %~% بس چوب که می خورد نگهبان بهشت!(@)(@@) %~% خورشید، چو ذره در هوای تو شود %~% وز قد تو، آراسته ایوان بهشت(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 1147 در باغ طرب، سرو سهی باری تو %~% گر بر دل و جان داغ نهی، باری تو(@)(@@) ~~11،8 خورشید، که او عکس نگینت بوسد ازحسن و جمال، اگر کسی لاف زند(@)(@@) %~% وله %~% ای نور دو دیدهآ رهی، باری تو! %~% هر لحظة، زآسمان زمینت بوسد(@)(@@) (@@) در پای تو، همچو دامنت می افتد %~% تا دست تو، همچو آستینت بوسد(@)(@@)(@@)(@@) | لاادری PageV01P255(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0259.jpg)(@)(@)(@@) باب یازدهم - اوصاف معشوق(@)(@@)(@@)(@@) | لااعرف(@)(@@) (@@) 1151 بر چهرهآ من، به نام خود زرداری %~% در دیده که تخت توست، گوهر داری(@)(@@) (@@) بر سرو روان، زماه افسر داری %~% بادات زملک حسن، بر خور داری!(@)(@@)(@@)(@@) | سید اشرف(@)(@@) (@@) 1152 گه، بر رخ آن مهرگیا بازم عشق %~% گه، بر سر آن زلف دوتا بازم عشق(@)(@@) (@@) سر تا پایت زیکدیگر خوبتر است %~% عاجز شدهام، که بر کجا بازم عشق!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 1153 مه را، اثری به روی او می ماند %~% چیزیش، بدان فرشته خومی ماند(@)(@@) (@@) نی، نی، غلطم! مه زکجا او زکجاست %~% وله %~% جان برخی او، بدو همو می ماند!(@)(@@) (@@) 1154 مرجان، به حقیقت از لبان توبرند %~% در و گهر، از لفظ و زبان تو برند(@)(@@) (@@) بی نام ونشان شوند، خوبان جهان %~% جایی، که درو نام و نشان تو برند!(@)(@@)(@@)(@@) | لااعرف(@)(@@) (@@) 1155 امروز، به خوبی ای صنم رونق توست %~% در بارگه حسن و لطف، سنجق توست(@)(@@) (@@) اوصاف تو، از وهم وخرد بیرون است %~% این «لیس کمثله») مگر در حق توست(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1156 یک ساعته وصل آن بت روح افزای %~% حقا، که به از مملکت هر دو سرای(@)(@@) (@@) چشم بد از او دور، که از سرتا پای %~% یا روح مجسم است، یا لطف خدای!(@)(@@)(@@)(@@) | مجیر بیلقانی(@)(@@) ~~1157 آنها، که به مذهب تناسخ فردندتومی رفتی، در تو نظر می کردند(@)(@@) (@@) سوگند به اعتقاد خود می خوردند %~% وله %~% کاین یوسف مصری است، که باز آوردند! 
ms117	(@)(@@) (@@) 1158 صد بار وجود را فرو بیختهاند %~% تا زو، چو تو صورتی برانگیخته اند(@)(@@) مان الله! ز فرق سرتا قدمت %~% در قالب آرزوی من ریخته اند!(@)(@)PageV01P256(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0260.jpg)(@)(@)(@@)(@@)(@@) | جمای نقاش(@)(@@) ~~11591 با روی تو، خورشید سخن از مه راندمه پیش تو، آفتاب را نیکو خواند(@)(@@) (@@) حورشید سپید دیده، کور است مگر! %~% یا ماه سیه گلیم را، شرم نماند؟(@)(@@)(@@)(@@) | جمال عبدالرزاق(@)(@@) ~~1160 از بهر خدا، آن قد و قامت نگریدبر عارضش، از مشک علامت نگزید(@)(@@) ~~زانجا که شمایید، بنتوان دیدن! در چشم من آیید و، قیامت نگرید!(@)(@@)(@@)(@@) | صدر زنگانی(@)(@@) (@@) 1161 نقاش رخت، زطعنه ها آسودهست %~% کز صنعت خود، هر چه توان بنمودهست(@)(@@) (@@) مرتا پایت، چنانکه باید بودهست %~% گویی که کسی به آرزو فرموده ست!(@)(@@)(@@)(@@) | عبدالواسع جبلی(@)(@@) (@@) 116 از روی تو، نسختی به چین بردستند %~% آنجا، که دو صد بتگر چابکدستند(@)(@@) (@@) در پیش مثال روی تو، بنشستند %~% انگشت گزیدند و، قلم بشکستند!(@)(@@)(@@)(@@) | لااعرف(@)(@@) (@@) 1163 حاشا که به ماه گویمت می مانی %~% یا چون قد تو، سرو بود بستانی(@)(@@) ~~مه را، لب لعل شکر افشان زکجاست؟ در سرو، کجاست جنبش روحانی؟(@)(@@)(@@)(@@) | لااعرف(@)(@@) (@@) 116 در دور رخت، یک دل بی آبله نیست %~% وان رخ که توداری، از جهانش گله نیست(@)(@@) ~~مه خواندنش خطاست، زان روی که هسترومی رخ و ترک چشم و زنگی گله نیست!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1165 ای عر بدهآ نرگس مستت، همه خوش %~% وی شعبدهآ زلف چوشستت، همه خوش(@)(@@) ~~ای هر چه کنی، زپای تا سر همه خوبوزسرتا پای، هر چه هستت همه خوش!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1166 در موسم گل، شراب را می مانی %~% در جام بلور، آب زامی مانی(@)(@@) (@@) در صبحدم، آفتاب را می مانی %~% در دیدهآ مست، خواب را می مانی!(@)(@)PageV01P257(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0261.jpg)(@)(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 1167 ای نوش لسب، آفتاب را می مانی %~% وی کان طرب، شراب را می مانی(@)(@@) (@@) شیرین پسری، خدای را باید گفت %~% انصاف دهم، جلاب را می مانی(@)(@@)(@@)(@@) | لااعرف(@)(@@) (@@) 1168 گر یوسف ز