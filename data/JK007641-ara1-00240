ms221	 ترى الله معك % % واترك الكل وحاذر طمعك % % 2(@)(@@) % والزم القنع بمن أنت له % % في جميع الكون حتى يسعك % % 3(@)(@@) % بالصفا عن كدر الحس فغب % % واطرح الأغيار واترك خدعك % % 4(@)(@@) % لا تموه بك واطلب منك ما % % فر من يوم بشأن ضيعك % % 19(@)(@@) % وعوجا علي سفح ذاك اللوى % % وإن جئتما دار سلمى قفا % % 20(@)(@@) % فإني مشوق كثير الجوى % % عسى الحب بالوصل أن يعطفا % % 21(@)(@@) % وقولا لمن لام وربح الذي % % به كدربين أهل الصفا % % PageV01P1027 البحر : - 1(@)(@@) % محبوب الذات كامل الأوصاف % % أما كدر كما تشا أوصافي % % 2(@)(@@) % حرك وترى بأصبع تطربني % % واملأ قدحي من العقار الصافي % % 5(@)(@@) % نورك الله به كن مشرقا % % واحذر الأضداد تطفي شمعك % % 6(@)(@@) % ثم ضع نفسك بالذل له % % قبل أن النفس قهرا تضعك % % PageV01P1028 البحر : - 1(@)(@@) % يا واصفي أنت في التحقيق موصوفي % % وعارفي لا تغالط أنت معروفي % % 2(@)(@@) % إن الفتى من بعهده في الأزل يوفى % % صافي فصوفي لهذا سمى الصوفى % % 7(@)(@@) % واعبد الله بكشف واصطبر % % وعلى الكشف توقى جزعك % % 8(@)(@@) % لا تقل لم يفتح الله ولا % % تطلب الفتح وحرر ورعك % % PageV01P1029 البحر : - 1(@)(@@) % نحن أهل الشام سوط الله في % % أرضه طبق الحديث الأشرف % % 2(@)(@@) % وبنا ممن يشا ينتقم الله أمر ظاهر لا يختفي % % 3(@)(@@) % والذي نافقنا ليس على % % من بنا آمن بالمشترف % % 4(@)(@@) % ليس منا كل من في أرضنا % % من سوى العارف والمعترف % % 5(@)(@@) % مثل خير الناس قرني قد أتى % % في حديث ثابت مؤتلف % % 6(@)(@@) % ومراد المصطفى اتباعهمع أن القرن للكل حوى من ذوي الكفر وأهل الشرف % بالهدى من كل شهم مقتفى سقط بيت ص % % 7(@)(@@) % وكذا هذا فنحن الغربا % % بين أهلينا نجوم السدف % % 8(@)(@@) % نحن يا من صرت مبلوا بنا % % نهر طالوت فلا تغترف % % 9(@)(@@) % قد تركنا سيرة الناس ولم % % نتبع غير أمور السلف % % 9(@)(@@) % كيفما شاء فكن في يده % % لك أن فرق أو أن جمعك % % PageV01P1030 10(@)(@@) % في الورى إن شاء خفضا ذقته % % وإذا شاء عليهم رفعك % % 10(@)(@@) % ديننا الإسلام لله بلا % % وقفة في أمرنا تقف % % 11(@)(@@) % وإذا ضرك لا نافع 
ms222	 من % % دونه والضر لا أن نفعك % % 11(@)(@@) % ثم صرنا لسهام من ذوي ال % % نفس والتدبير مثل الهدف % % 12(@)(@@) % وإذا أعطاك من يمنعه % % ثم من يعطى إذا ما منعك % % 12(@)(@@) % إن ترد فانظر إلى واحدنا % % درة من ثوبه في صدف % % 13(@)(@@) % ليس يوقيك أذاه أحد % % وإن استنصرت فيه شيعك % % 13(@)(@@) % كلما مر بقوم عبثوا % % منه بالحال الشريف الأنف % % 14(@)(@@) % وهو في غيظ وفي فرط أذى % % دائما منهم لقبح النطف % % 14(@)(@@) % إنما أنت له عبد فكن % % جاعلا في القرب منه ولعك % % PageV01P1031 15(@)(@@) % فز بوصل أن تراه واصلا % % واقبل القطع إذا ما قطعك % % 15(@)(@@) % ليس هذا عبثا قف واستمع % % حكمة مني بها الجهل نفى % % 16(@)(@@) % كلما نابك أمر ثق به % % واحترز للغير تشكو وجعك % % 16(@)(@@) % انتقام الله ممن شاء ذا % % برجال الله أهل الغرف % % 17(@)(@@) % لا تؤمل من سواه أملا % % إنما يسقيك من قد زرعك % % 17(@)(@@) % اسملوا حتى غدوا في يده % % كسياط لبنات الطرف % % 18(@)(@@) % يضرب الله بهم من شاءه % % من عباد للهوى والسرف % % 18(@)(@@) % ليت لو تشعر ماذا كنت من % % قبل ما مولى الموالي اخترعك % % 19(@)(@@) % كنت لا شيء وأصبحت به % % خير شيء بشرا قد طبعك % % 20(@)(@@) % تابعا كن دائما أنت ولالمتى تبني كنيسات الهوى كسر الصلبان واهجر بيعك % تتمنى إنه لو تبعكسقط بيت ص % % PageV01P1032 21(@)(@@) % ودع التدبير في الأمر له % % واصنع المعروف مع من صنعك % % 22(@)(@@) % واحتفظ حرمة من يبصران % % رمت فعلا أو تنادي سمعك % % 23(@)(@@) % وهو الله الذي جل فيا % % عقل خف من عدم مبتدعك % % 24(@)(@@) % كن به معتصما واسلم له % % لا تعاند فيه واهجر بدعك % % 25(@)(@@) % هذه ملة طه خذ بها % % لا تطع عنها قصورا دفعك % % PageV01P1033 البحر : - 1(@)(@@) % يا جمال الوجودص طاب فيك الشهودص والبرايا رقود % % 2(@)(@@) % إن عيني تراك % % ما لقلبي سواك % % 3(@)(@@) % دور % % 19(@)(@@) % فاحترز إن شئت أو شئت فلا % % وتهيأ للأسى والأسف % % 20(@)(@@) % هم أولوا الجذب رجال سقطوا % % في يد الله على السر الخفي % % PageV01P1034 البحر : - 1(@)(@@) % عبادة الغافلين تكليف % % وعلمهم بالإله تكييف % % 2(@)(@@) % كما عبودية الذين 
ms223	 على % % صراطه سالكون تعريف % % 3(@)(@@) % وعارفوا ربهم عبودتهم % % بربهم رفعة وتشريف % % 4(@)(@@) % ذاب كلي عليكص وانتسابي إليكص والورى في يديك % % 4(@)(@@) % عليك فالزم طريقنا لترى % % ما قد رأينا إلى متسويف % % 5(@)(@@) % والشجى في هواك % % زائد الارتباك % % 5(@)(@@) % واهرب إلينا ودع حواسدنا % % ولا تميلنك إلا راجيف % % 6(@)(@@) % إن الذي نحن أهله حرم % % أمن وما في ذراه تخويف % % 6(@)(@@) % دور % % 7(@)(@@) % أنت في مهجتيص وضلوعي التيص عشقها ما فتي % % PageV01P1035 7(@)(@@) % الله ألله لا سواه فما % % لغيره في الأنام تصريف % % 8(@)(@@) % ونحن لا نحن فالوجود له % % والحكم منه عليه توقيف % % 8(@)(@@) % يا حبيبي عساك % % أن توالي لقاك % % 9(@)(@@) % وكل شيء في العلم ترتيب % % له بأحكامه وتصفيف % % 9(@)(@@) % دور % % 10(@)(@@) % كل شيء عدمص لي بهذا قدمص ثابت من قدم % % 10(@)(@@) % وهو الذي قامت السماء به % % والأرض للكل منه تأليف % % 11(@)(@@) % ليس عنك حراك % % يذهب الاشتراك % % 11(@)(@@) % واستغفر الله للجميع وإن % % جاء من الجاهلين تعنيف % % 12(@)(@@) % دور % % PageV01P1036 12(@)(@@) % هذا مقام يجل عن رجل % % له ادعاء به وتوصيف % % 13(@)(@@) % وهو طبق النصوصص عند أهل الخصوصص قاله في الفصوص % % 14(@)(@@) % يا ظلال الأراك % % إنني لا أراك % % 15(@)(@@) % دور % % PageV01P1037 البحر : - 1(@)(@@) % نحن إخوان النبي المصطفى % % ود لو كان رآنا وكفى % % 2(@)(@@) % وهم الأصحاب كانوا قبلنا % % جاء هذا في حديث يقتفى % % 3(@)(@@) % وانفضت أصحابه وانقطعوا % % وبقينا نحن إخوان الصفا % % 4(@)(@@) % حبنا من حبة مكتسب % % ومع البعد به البعد انتفى % % 5(@)(@@) % وهو يشتاق ونشتاق كما % % يشتكى نشكو تباريح الجفا % % 6(@)(@@) % وإذا ود وددنا مثله % % وهو أمر جل عن أن يوصفا % % 7(@)(@@) % إن للإخوان في الحكم يدا % % تقتضي منه عهودا ووفا % % 8(@)(@@) % وهو أيضا نسب متصل % % وحدة الروح مقام الخلفا % % 9(@)(@@) % وإذا الصحبة في الظاهر قد % % عظمت فضلا وزادت شرفا % % 10(@)(@@) % نسبة الإخوان في الباطن لا % % تقتضي إلا الجوى والشغفا % % PageV01P1038 11(@)(@@) % شرطوا الرؤية بالعين فمن % % نالها منه فبا لجسم اكتفى % % 12(@)(@@) % وشرطنا الذات للذات ترى % % رؤية التحقيق من غير خفا % % 13(@)(@@) % فاعرفوا بالفرق ما بينهما % % فاز بالإحسان من قد عرفا % % 16 
ms224	(@)(@@) % غاب موج الرسومص في بحار العلومص وانطماس النجوم % % 17(@)(@@) % بالفنا والهلاك % % شمس ذات الحباك % % 18(@)(@@) % دور % % 19(@)(@@) % يا ضياء العيونص فيك عقلي جنونص وحياتي منون % % 20(@)(@@) % ما لقلبي فكاك % % من حبال الشباك % % 21(@)(@@) % دور % % 22(@)(@@) % قم ناب يا نديمص إن خمري قديمص كاسه نستديم % % PageV01P1039 23(@)(@@) % لطف عيشي بذاك % % ومناي هناك % % 24(@)(@@) % دور % % 25(@)(@@) % وبروق الوصالص لامعات النصالص نورها الحق صال % % 26(@)(@@) % في ليالي العراك % % محو كل الصكاك % % 27(@)(@@) % دور % % 28(@)(@@) % صل يا ربناص ثم سلم لناص لنبي دنا % % PageV01P1040 البحر : - 1(@)(@@) % يا البط الكيمياء علمي % % أكسيرك الخالص المصفى % % 2(@)(@@) % ذب والق منه عليك جزءا % % يصبغ في الحال منك ألفا % % 3(@)(@@) % يحيل فزد يرك انقلابا % % بذهب عنك ليس يخفى % % 4(@)(@@) % والعين فالغين تلك لكن % % تركت وصفا ونلت وصفا % % 29(@)(@@) % من إله السماك % % في الليالي الحلاك % % 30(@)(@@) % دور % % 31(@)(@@) % فيه عبد الغنيص نال قدرا سنيص كلما بعتني % % 32(@)(@@) % بالنظام المحاك % % في حلى الاحتباك % % PageV01P1041 البحر : - 1(@)(@@) % انظر الكل لطيفا % % لا ترى شيئا كثيفا % % PageV01P1042 البحر : - 1(@)(@@) % كل الكلام الذي يبدو وكل سنا % % 2(@)(@@) % إنما الكل معاني % % فخبيثا وشريفا % % 2(@)(@@) % يفنى سريعا وفقر هكذا وغنى % % 3(@)(@@) % صبغة الله الذي قد % % شرع الدين حنيفا % % 3(@)(@@) % فاحفظ مقالي وخل عنك فرط عنا % % 4(@)(@@) % الملك لله من يظفر بنبيل منى % % يرد قسرا ويضمن دونه الدركا % % 4(@)(@@) % لا ترى من دونه في % % خلقه شيئا مخيفا % % 5(@)(@@) % إني رضيت فلم أحفل بمسئلة % % 5(@)(@@) % واكشف الستر مقاما % % في ذرى القرب منيفا % % 6(@)(@@) % وعن الأكوان طرا % % كن بمولاك عفيفا % % PageV01P1043 6(@)(@@) % أمر المهيمن يجريه بمعدلة % % 7(@)(@@) % هو حق وسواه % % باطل جاء لفيفا % % 7(@)(@@) % حتى قنعت برزق منه لي صلة % % 8(@)(@@) % ووجود مطلق عن % % قيده شف شفيفا % % 8(@)(@@) % لو انك لي أو لغيري قدر أنملة % % من البسيطة كان الأمر مشتركا % % 9(@)(@@) % جعل الكامل منا % % عنه في الأرض خليفا % % PageV01P1044 البحر : - 1(@)(@@) % يا جمال من أهوى يا غيب % % أثنى ذا الحجاب صل عبدك % % 2(@)(@@) % متعني بما أروى لا عيب % % صلنيإن تشأ أكن عبدك % % 3(@)(@@) % نور الوجه لي 
ms225	 ظاهر % % وهو للورى باهر % % 4(@)(@@) % قلبهم له مأوى لا ريب % % يهنى عنه لا تخف بعدك % % 5(@)(@@) % دور % % 6(@)(@@) % تحت ذا القناع محبوبياليت % % حبيلو يكون لي يظهر % % 7(@)(@@) % إنني أنا المحسوبكالميت % % لبى حنسه البهي أبهر % % 8(@)(@@) % واحد ماله ثاني % % واحد له الفاني % % 9(@)(@@) % لا ترى سواه مطلوبوالبيت % % قلبيطف به تنل سعدك % % 10(@)(@@) % كل شيء في يديه % % كله صار الوريفا % % PageV01P1045 10(@)(@@) % دور % % 11(@)(@@) % لم يزل منه قويا % % ومن النفس ضعيفا % % 11(@)(@@) % قم بنا إلى الندمانفي الحان % % يا صاحندرك الصفا بالراح % % 12(@)(@@) % واستمع من العيدانألحان % % أقداحلي أتت بها الأفراح % % 12(@)(@@) % فإذا أمحل قطر % % حله أصبح ريفا % % 13(@)(@@) % طاب لي بها كاسي % % لأن قلبها القاسي % % 13(@)(@@) % حيث كاس الحق تجلى % % وشراب الغير عيفا % % 14(@)(@@) % منيتي في مستواها % % تبعث الروح هفيفا % % 14(@)(@@) % والعذول في حرمانأفنان % % أفراحمنه فاحترز جهدك % % 15(@)(@@) % ولأقلام التجلي % % سمعت أذني صريفا % % PageV01P1046 16(@)(@@) % هي ذات الخال فيها % % لم تجد إلا لهيفا % % 17(@)(@@) % انزلت قولا ثقيلا % % جعل الكون خفيفا % % 18(@)(@@) % جذبتني بالمجالي % % نحوها جذبا عنيفا % % 19(@)(@@) % وأقامتني أماما % % بين قومي وعريفا % % 20(@)(@@) % وبها صرت بصيرا % % بعد ما كنت كفيفا % % 21(@)(@@) % وبأنواع كمال % % منحت عقلي السخيفا % % 22(@)(@@) % فأنا اليوم بها في % % أهلها قمت وصيفا % % PageV01P1047 البحر : - 1(@)(@@) % كنت بالأمس عند نفسي كثيفا % % وأنا الآن صرت شيئا لطيفا % % 2(@)(@@) % خف جسمي وخفت الروح مني % % فوجدت الصخر الثقيل خفيفا % % 3(@)(@@) % وبدت هكذا العوالم عندي % % كلها تالدا لها وطريفا % % 4(@)(@@) % فاعجبوا يا عقول من وصف أمري % % لطفتني معارفي تلطيفا % % 5(@)(@@) % ولقد صرت واحد وكثيرا % % ولقد جئت بالجميع لفيفا % % 6(@)(@@) % صبغة الله وهي خلق وأمر % % ألقت فرقة الورى تأليفا % % 7(@)(@@) % كالمعاني تلوح في كلمات % % لعقول نوت لها تعريفا % % 8(@)(@@) % والذي قام بالجميع بعيد % % وقريب لا يقبل التكييفا % % 9(@)(@@) % جل وجه رأيته فمحاني % % نوره الحق إذ إليه أضيفا % % 10(@)(@@) % رتب في وجوده نحن عنه % % قد ظهرنا به له توصيفا % % PageV01P1048 11(@)(@@) % معه مالنا وجود لأنا % % قد وجدنا به إذا لجهل عيفا % % 12(@)(@@) % وهي ذكرى ائمة الحق يجرو % % ن قويا في شأوها وضعيفا 
ms226	 % % 15(@)(@@) % دور % % 16(@)(@@) % طلعة المليح الزينيختال % % إنيمطلع لذاك النور % % 17(@)(@@) % من به قرير العينبالحال % % يغنى حاله عن الطنبور % % 18(@)(@@) % قد رفعت أستاري % % واجتليت أنواري % % 19(@)(@@) % أين من يراني أينقد زال % % عنييا رشا الحمى صدك % % 20(@)(@@) % دور % % 21(@)(@@) % حولوا حجاب الغيرعن عين % % ذاتيواكشفوا عن الأستار % % 22(@)(@@) % أخوتي وجدوا السيرلابين % % يأتيفي مشعشع الأنوار % % PageV01P1049 23(@)(@@) % فالحبيب قد وافى % % والبغيض قد صافي % % 24(@)(@@) % والذي يريد الخيربالمين % % عاتيقصده نفى قصدك % % 25(@)(@@) % دور % % 26(@)(@@) % كلهم هم الأفعاللا ذات % % عنديغير عين تلك الذات % % PageV01P1050 البحر : - 1(@)(@@) % صفا ماء الحقيقة فهو صافي % % من الكدر الذي هو فيه خافي % % 2(@)(@@) % وما الكدر الذي هو فيه إلا % % تقادير له منه توافى % % 3(@)(@@) % تسمت بالحوادث وهي فيه % % قديمات وما هي بالمنافي % % 4(@)(@@) % سراب ظنه الظمئان ماء % % فلما جاءه للارتشاف % % 5(@)(@@) % هنالك لم يجد شيئا ولكن % % به وجد الإله الحق كافي % % 6(@)(@@) % نظرت به شهدت وإن بنفس % % نظرت عميت ياذا الانحراف % % 7(@)(@@) % شخوص شاءها فيقال أشيا % % بلا شك هناك ولا اختلاف % % 8(@)(@@) % ومشيآته ليست بوصف % % له وبه فما هي ذو اتصاف % % 9(@)(@@) % ولا ذا وصف ذا كلا ولا ذا % % لذا وصف لفقدان التكافي % % 27(@)(@@) % فاعرضوا عن الجهالأموات % % تبدى وهم ما به تقتات % % PageV01P1051 28(@)(@@) % وافهموا لأقوالي % % واسلكوا بأحوالي % % 29(@)(@@) % والعليم يدري الحالما فات % % قصديأن يهيج بي وجدك % % 30(@)(@@) % دور % % 31(@)(@@) % والصلاة والسلامنوران % % منيدائما على الهادي % % 32(@)(@@) % من حياه بالإكرامرحمان % % فنيمدحه بإنشادي % % 33(@)(@@) % عبد للغني شامي % % قدره به سامي % % 34(@)(@@) % كاسه من التسنيمملآن % % يدنيمنك يا أخي رشدك % % PageV01P1052 البحر : - 1(@)(@@) % ليس طيب الحياة غير وفاتك % % والسوى فاتن النفوس وفاتك % % 2(@)(@@) % يا محبا أحب ثوب حبيب % % أعط نفس الحبيب بعض التفاتك % % 3(@)(@@) % وتحقق بمن تحب تجده % % أنت والجهل للأحبة هاتك % % 4(@)(@@) % صور عن مصور كثياب % % لبستها عليك نفس فتاتك % % 5(@)(@@) % وحياتي بمقتضى حكم أمري % % وهو قولي لمنيتي وحياتك % % 6(@)(@@) % ليس لي غير وجهك الحق عنه % % لي ثبوت بمقتضى إثباتك % % 10(@)(@@) % هو الحق الوجود وكل شيء % % به عدم ترتب بانعطاف % % 11(@)(@@) % فقم وانهض إلى التحقيق فيه % % تلافى الحال 
ms227	 من قبل التلاف % % 12(@)(@@) % ومع أهل الوفاق أدم وفاقا % % إلي كم أنت مع أهل الخلاف % % 13(@)(@@) % وكن بالله أنت تكن قويا % % وجانب غفلة القوم الضعاف % % PageV01P1053 14(@)(@@) % وإلا سوف تندم يا نديمي % % لفوت الحظ في زمن الثقاف % % PageV01P1054 البحر : - 1(@)(@@) % الناس حاروا في الضمير وحجبه % % من يرفع الأستار عنه يكشف % % 2(@)(@@) % العين للعين اتحادا صادقا % % قل لي وما هو منه لا يتكيف % % 3(@)(@@) % فأجابه % % 4(@)(@@) % لا حيرة في الحق عند ذوي الهدى % % بل عندهم منه الهداية تعرف % % 5(@)(@@) % قوم أزال حجابه عن قلبهم % % وبهم يسمى بل بهم هو يوصف % % 6(@)(@@) % لازال فيهم نور ظلمة كونهم % % أين الظلام وشمسه لا تكسف % % 7(@)(@@) % خذ نديمي أطوار نفسك ممن % % طاب فيه الشراب من كاساتك % % 7(@)(@@) % والعين تلك العين واحدة كما % % كانت قديما عند من هو منصف % % 8(@)(@@) % وأدرها عليك منك وعربد % % مع ذاك الحبيب في خلواتك % % 8(@)(@@) % والناس حاروا بالعقول لأنهم % % راموا التكيف وهو ليس يكيف % % PageV01P1055 9(@)(@@) % فلو احتملوا بحماه عن أفكارهم % % وبه اهتدوا إلا بالعقول لا تحفوا % % 9(@)(@@) % خمرنا في الدنان منه بواقي % % خذه واشرب واخشع به في صلاتك % % 10(@)(@@) % لكن إذا رام المهيمن رتبة % % للمرء قام بها فمن ذا يحرف % % 10(@)(@@) % وهو خمر معنى القديم تصفى % % قبل يا كرم كنت في شجراتك % % 11(@)(@@) % واسقنا ربنا شرابا طهورا % % مثل ما جاء عنك في آياتك % % 11(@)(@@) % فهو لمكيفا بالأوامر للحجى % % وبحضرة القيوم ذاك مكيف % % 12(@)(@@) % واطرح يا أخا الطريقة واترك % % كل شيء إن رمت نيل نجاتك % % 13(@)(@@) % واسمع النفخ منك في صور جسم % % لك فالناي طاب من نغماتك % % 14(@)(@@) % هذه نشأة بها أنت باد % % لك عندي هاتيك من نشآتك % % 15(@)(@@) % يا رعي الله بالإجارع قوما % % هم لدينا يا دهر من حسناتك % % PageV01P1056 16(@)(@@) % حفظوا العهد من ألست فوافوا % % لمن الملك وهو للكل باتك % % 17(@)(@@) % لم تملهم عن نوره ظلمات % % يا سوى بارتكابهم شهواتك % % PageV01P1057 البحر : - 1(@)(@@) % بهجة النور بعد وقت الكسوف % % فتعجب لواصف موصوف % % 2(@)(@@) % حرفوه فنصححوه جهارا % % وهو صف في عين كل الصفوف % % 3(@)(@@) % فقده وجده 
ms228	 بعزة ذات % % طبعه خارج عن المألوف % % 4(@)(@@) % حرف لفظ وحرف رقم وحفظ % % وحروف تالفت بحروف % % 5(@)(@@) % كل من باعه به يشتريه % % واحد وهو ألف ألف ألوف % % 18(@)(@@) % أخذتهم لها المليحة منهم % % حيننادوا أنا ظهور صفاتك % % 19(@)(@@) % فمحتهم بها وقد أثبتتهم % % عندها في حمى العيون الفواتك % % 20(@)(@@) % هذه زينب التي كشفت عن % % وجهها يا محب في سكراتك % % 21(@)(@@) % وهو عند الجهول خلف قناع % % هو ياذا الجهول أنت بذاتك % % 22(@)(@@) % فانخلع عنك في الوجود إليها % % سائحا منك في فضا فلواتك % % PageV01P1058 البحر : - 1(@)(@@) % أنا بالله عارف % % ومن البحر غارف % % 2(@)(@@) % بحر علم مقدس % % منه تبدو المعارف % % 3(@)(@@) % سفن كلنا به % % طاف فيهن طائف % % 4(@)(@@) % يا أمانا لكل من % % منه قد خاف خائف % % 5(@)(@@) % كن أمانا لجملتي % % حيث تبدو المخاوف % % 6(@)(@@) % وتلطف ودلني % % بك إني المؤالف % % 7(@)(@@) % لا تكلني إلى السوى % % فالسوى أنت كاشف % % 8(@)(@@) % كل من كان معرضا % % عنك فهو المخالف % % 9(@)(@@) % أنت لا نحن كلنا % % نحن ما أنت قاذف % % 10(@)(@@) % يقذف الله قلت % % بالحق وهي اللطائف % % PageV01P1059 11(@)(@@) % يا أخلاي وافقوا % % أمركم لا تخالفوا % % 12(@)(@@) % واحذروا أن تغركمكم نفوس تحيرت ودهتها الكثائف % بفلاها التنائفسقط بيت ص % % 13(@)(@@) % وإلى الحق ما اهتدتماء حق صفا ولا شيء فيه يخالف % وبها العقل واقفسقط بيت ص % % 14(@)(@@) % كدر كلنا به % % فليزلنا المكاشف % % 23(@)(@@) % ثم مت بها راكعا لا تبالي % % وعن الغير فافن في سجداتك % % 24(@)(@@) % سعدت أمة إلى الغيب حجت % % ثم طافت يا كعبتي بجهاتك % % 25(@)(@@) % وأتت زمزم العلوم فنالت % % شربة العز من كفوف سقاتك % % 26(@)(@@) % وبذكر الحبيب لبت وعما % % دونه أحرمت لدى ميقاتك % % 27(@)(@@) % ومناها فازت به في مناها % % بعد ما قد أتت إلى عرفاتك % % 28(@)(@@) % إن هذا هو النعيم فطوبى % % للذي يا مقام في جناتك % % PageV01P1060 29(@)(@@) % منك فيه يسيل كوثر روح % % فتراه السكران من رشفاتك % % 30(@)(@@) % يا رياض الجنان من حان قربى % % عطرينا بالطيب من نفحاتك % % 31(@)(@@) % وانشري ما انطوى من الذكر عنا % % وامنحينا اللذيذ من ثمراتك % % 32(@)(@@) % إننا عنك ظاهرون بلطف % % منك في أرضك 
ms229	 اقتضا نياتك % % 33(@)(@@) % لم تجد كثرة الوسائط جسما % % تمنع الروح ربنا من هباتك % % 34(@)(@@) % فالذي منك قد وفى فتدلى % % لم ينقصه كونه ابن العواتك % % 35(@)(@@) % هو أمر لنا قريب بعيد % % فارجعي يا حروف في ألفاتك % % PageV01P1061 البحر : - 1(@)(@@) % طلعت شمسنا على الأفلاك % % فانمحت ظلمة النفوس الحلاك % % 2(@)(@@) % وسرت نسمة الحمى فأهاجت % % شوق صب ما إن له من حراك % % 3(@)(@@) % هذه طلعة الحبيب بقلبي % % فتنة العابدين والنساك % % 15(@)(@@) % بالصفا والوفا ولا % % عنه بصرفه صارف % % 16(@)(@@) % إنما الحق غيبنا % % حارفي الوصف واصف % % PageV01P1062 البحر : - 1(@)(@@) % دخل إلى بيت قلبي بارقه رفرف % % فلم يدع فيه لا سقفا ولا رفرف % % 2(@)(@@) % لطائر الغيب لما فوقنا رفرف % % جعل لكتب الهدى في حيطنا رفرف % % 4(@)(@@) % هيكل تسرح النواظر منه % % في جمال فرد بغير اشتراك % % 5(@)(@@) % وبذات الغضا خيام عريب % % نصبت بين عسجد فأراك % % PageV01P1063 البحر : - 1(@)(@@) % هل تعرفون العدم الصرفا % % فتدركوا من لظفه حرفا % % 2(@)(@@) % لا تحسبوا معناه مفهومكم % % معناه شيء عنكمو يخفى % % 3(@)(@@) % فكيف تدرون الوجود الذي % % من عدم صرف هو إلا خفى % % 4(@)(@@) % وهو الذي نعنيه في وحدة ال % % وجود لما نذكر الوصفا % % 5(@)(@@) % إن الوجود الصرف اطلاقه % % كالعدم الصرف لمن وفى % % 6(@)(@@) % كلاهما من حيث نفساهما % % تساويا فانعطفا عطفا % % 6(@)(@@) % كلما أومضت بروق رباهم % % هطل القطر من عيون البواكي % % 7(@)(@@) % تقابلا اجتمعاو عندنا % % في عدم الإدراك إذ ينفى % % 7(@)(@@) % حلية للمحب في نار شوق % % صنعة الانسكاب والانسباك % % 8(@)(@@) % هتك الستر نوره فافتضحنا % % من لقلبي بنوره الهتاك % % PageV01P1064 9(@)(@@) % واحد وهو في العقول كثير % % ليس يحكيه في البرية حاكي % % 10(@)(@@) % كل من قال مثله قد رأينا % % إنه قول كاذب أفاك % % 11(@)(@@) % مد أكوانه حبال خيال % % لاصطياد القلوب بالإشراك % % 12(@)(@@) % فأتته الموحدون وجاءت % % بارتباطيها أولوا الإشراك % % PageV01P1065 البحر : - 1(@)(@@) % إن القناعة في الدنيا هي الشرف % % وغيرها عندنا التبذير والسرف % % 2(@)(@@) % وهي التدبر في القرآن تقرأه % % وفي حديث رسول الله تعترف % % 3(@)(@@) % واجعل معاشك من خبز الشعير ومن % % ماء وإن لم يكن عذبا فتغترف % % 4(@)(@@) % وخرقة الصوف طول العمر تلبسها % % مع 
ms230	 صاحب أو صحاب أنت تأتلف % % 13(@)(@@) % دم على حبه ومل عن سواه % % وإذا لم تبك فكن متباكي % % 14(@)(@@) % حضرة العز من أتاها بذل % % كان منها بالقرب فوق السماك % % 15(@)(@@) % أناشاك لطولها من قصوري % % عن مدى الشكر شاكر أنا شاكي % % PageV01P1066 البحر : - 1(@)(@@) % صدق الكتاب لمن به يتمسك % % والبعض منه به يكون المشرك % % 2(@)(@@) % وهو المبين على الذي بجميعه % % يدري وليس ببعضه يتمسك % % 3(@)(@@) % هو نازل من حضرة أحدية % % فتحققوا فيه ولا تتشككوا % % 4(@)(@@) % سور وآيات بدت فتركبت % % من أحرف هي بالتوحيد أملك % % 5(@)(@@) % مشتقة من سور كل مدينة % % لإحاطة فيها بما يتفكك % % 5(@)(@@) % وهذه هذه تلك السعادة في % % دنياك فاقنع بها بالعز تتصف % % 6(@)(@@) % ولقد بدت صورا إذا هي فخمت % % بنزولها الثاني لدى من يسلك % % 6(@)(@@) % وبالفخار على كل الملوك أولى ال % % تيجان ممن مضى في معشر سلفوا % % 7(@)(@@) % بالحق أنزلناه ذلك أول % % كل به قد آمنوا واستبركوا % % 7(@)(@@) % كمثل كسرى انوشروان من ملكت % % يمينه الفرس يرعاها فتنتصف % % PageV01P1067 8(@)(@@) % وبه لقد نزل اغتدى هو ثانيا % % فتفرقوا فيه وعنه تمحكوا % % 8(@)(@@) % وقيصر الروم والقوم الذين حووا % % شرقا وغربا من الأرض التي عرفوا % % 9(@)(@@) % وبعد ذلك فاشكر من حباك بها % % ربا كريما فتكفى عنده الكلف % % 10(@)(@@) % ولا تعرج على مال يكون ولا % % جاه وكن رجلا ما عنده أسف % % 11(@)(@@) % فالكل فان وكل الناس عن كتب % % هم التراب وأقوام هم الجيف % % PageV01P1068 البحر : - 1(@)(@@) % العين واحدة والحكم مختلف % % فمنه مفترق بل منه مؤتلف % % 2(@)(@@) % هي الحوادث لا عين لها أبدا % % قديمها درها والحادث الصدف % % 3(@)(@@) % إياك تفهم من قولي الحلول بها % % لأن قولي رموز صاغها السلف % % 4(@)(@@) % وأنت تجهل علما نحن نورده % % من بحر حق عليه الناس ما وقفوا % % 5(@)(@@) % فقف علينا وسلم بالأمور لنا % % فإن عارفنا بالغيب معترف % % 6(@)(@@) % الله كبرأ لا شيء يشابهه % % وكل حروف عن الإدراك منحرف % % 7(@)(@@) % ظهورنا عنه بالتقدير من عدم % % هو الظهور له في كل ما نصف % % 8(@)(@@) % لأنه الغيب غيب الغيب من يره % % يرى الحوادث تبدو عنه لا 
ms231	 تقف % % 9(@)(@@) % وبدا لهم صور فخصوا بعضه % % بالترك منه وبعضه لم يتركوا % % 10(@)(@@) % وبقى عليهم حكم موطنهم بما % % هو مقتضاه لهم بجهل يملك % % PageV01P1069 11(@)(@@) % ولذلك الدنيا غدت ملعونة % % إلا الذي استثني وهاج المعرك % % 12(@)(@@) % وأتاك من آياته ألوانكم % % والألسن اللاتي غدت تتحرك % % 13(@)(@@) % وجميعها صور وتلك كثيرة % % وبها اختلاف زائد لا يدرك % % 14(@)(@@) % والله مولانا محيط قد أتى % % لك من وراء الكل وجه يهتك % % 15(@)(@@) % بل ذاك قرآن مجيد جاء في % % لوح هو المحفوظ عمن يشرك % % PageV01P1070 البحر : - 1(@)(@@) % ظهرت لقلبي بما قد نوى % % 2(@)(@@) % وبالحول أمددتني والقوى % % 3(@)(@@) % فيا من به في زاد الجوى % % 4(@)(@@) % أحبك حبين حب الهوى % % وحبا لأنك أهل لذاكا % % 5(@)(@@) % حبيبي هو االداء لي والدوا % % 6(@)(@@) % وذاك العليم بما قد روى % % 7(@)(@@) % أقول له وعلي احتوى % % 8(@)(@@) % فأما الذي هو حب الهوى % % فشيء شغلت به عن سواكا % % 9(@)(@@) % ألا عل من شاقني عله % % 9(@)(@@) % كأنها البرق وهي الأمر لاح بما % % يريده الله وهو الخلق منقذف % % PageV01P1071 10(@)(@@) % يداوي فؤادي بما عله % % 10(@)(@@) % وأمره القدر المقدور آخره % % ياء الحروف بدت والأول الألف % % 11(@)(@@) % على عشقك القلب من عله % % 11(@)(@@) % فانظره أنت ودع ما أنت ناظره % % فإنه فعله والفعل منحذف % % 12(@)(@@) % وكن له مظهرا لا عنه محتجبا % % فإن شمس الضحى بالبدر تنكسف % % 12(@)(@@) % وأما الذي أنت أهل له % % فكشفك للحجب حتى أراكا % % 13(@)(@@) % فؤادي بفرط الجوى ممتلى % % 13(@)(@@) % بكل شيء محيط قال خالقنا % % فافهم فبالفهم سر الغيب ينكشف % % 14(@)(@@) % جل الإله وقد عزت مظاهره % % يراه قلب عن الأغيار مختلف % % 15(@)(@@) % فتضمحل رسوم الكائنات ولا % % عقل هناك ولا حس فيغترف % % PageV01P1072 16(@)(@@) % ولا يراه سواه دائما أبدا % % والكل فان كما قد قال يا نطف % % 17(@)(@@) % من كان من نطف الأقذار أولهم % % ماذا يرون هنا والآخر الجيف % % 18(@)(@@) % الله ألله رب العالمين فمن % % به رأه رأى الأكوان تنعطف % % 19(@)(@@) % وزال عنه ضلال في بصيرته % % وما بقي عنده حزن ولا أسف % % 20(@)(@@) % هذا هو الرجل المرفوع جانبه % % عند الإله وفي الدنيا له الشرف 
ms232	 % % PageV01P1073 البحر : - 1(@)(@@) % أعط طرفا له وللكون طرفا % % تلق في الكون اقحوانا وطرفا % % 2(@)(@@) % لك عينان وعين غيب تراه % % وتراه الأخرى فتصرف صرفا % % 3(@)(@@) % أنا عبد الغني لمعة برق % % يعدها لمحة تلوح وتخفى % % 4(@)(@@) % هكذا دائما لأني روح % % تفخ أمر من الإله مصفى % % 14(@)(@@) % وعيني ترى للجمال العلى % % 15(@)(@@) % وحالان عندي هما اجتلى % % 16(@)(@@) % فلا حمد في ذا ولا ذاك لي % % ولكن لك الحمد في ذا وذاكا % % PageV01P1074 البحر : - 1(@)(@@) % أصبحت أنا على مرادك % % في عافية وفي عبادك % % 2(@)(@@) % مكفي مؤونة مهني % % من رزقك قانعا بزادك % % 3(@)(@@) % فالشكر لك الكثير مني % % لازال على صفا ودادك % % 4(@)(@@) % يا مالك جملتي جميعا % % إني لأسير في قيادك % % 5(@)(@@) % أحسنت إلي في ابتداء % % بالحكم بمقتضى رشادك % % 5(@)(@@) % ظاهر في كثيف جسم تجلى % % فيه روح وهو اللطيف الموفى % % 6(@)(@@) % واجعل حسنا تمام أمري % % والقرب فعده من بعادك % % 6(@)(@@) % كل شيء مثلي كثيف لطيف % % وإذا ما عرفت زادك لطفا % % 7(@)(@@) % في الباطن كن لنا حفيظا % % والظاهر من يد استنادك % % 7(@)(@@) % فاترك الكل عنك وانظر إليه % % بالوجود الحق الذي فيك يلفى % % PageV01P1075 8(@)(@@) % واعطف كرما وكن معينا % % في خلقك لي وفي بلادك % % 8(@)(@@) % تعرف الكل يا لوجود جهارا % % فهو أعلى منهم وأجلى وأكفى % % 9(@)(@@) % يا ابن ودي هي الحقيقة أمر % % واحد صار ذلك الأمر ألفا % % 10(@)(@@) % بظهور في كل شيء مراد % % للإله الذي تحققت كشفا % % 11(@)(@@) % ظاهرا ذاك لا يزال ولكن % % شمسه قد كسفتها عنك كسفا % % PageV01P1076 البحر : - 1(@)(@@) % أنا الوجود الذي ذاتي وأوصافي % % خلقتها لي بتقد يرى وانصافي % % 2(@)(@@) % بل قد خلقت جميع الخلق يا صافي % % مع أنني عبد فاني عند وصافي % % 9(@)(@@) % إني أبدا لك التجائي % % ملقى أملي على جهادك % % 10(@)(@@) % لا أبرح عن مقام ذلي % % في نيل مناي بافتقادك % % PageV01P1077 البحر : - 1(@)(@@) % الروح كالريح إن جازت شذا النطف % % تزكو وتخبث إن مرت على الجيف % % 2(@)(@@) % وليس تحكم في جسم تكون له % % الأعلى مقتضى ما فيه فاعترف % % 11(@)(@@) % فادرك رمقي بشرح صدري % % واروي عطشي إلى عهادك % % PageV01P1078 البحر : - 1(@)(@@) % ومستورة عنا 
ms233	 بها أوجبت هتكي % % 2(@)(@@) % بطلعة وجه نوره مشهر الفتك % % 3(@)(@@) % فقلت ورياها لنا فاح كالمسك % % 3(@)(@@) % وإنما هي من أمر الإله أتت % % في خسة هي من جسم وفي شرف % % 4(@)(@@) % أيا ربه الخدر التي أفسدت نسكي % % على كل حال أنت لا بد لي منك % % 4(@)(@@) % فتارة في شقاء منه قدره % % ربي وطورا بسعد غير منصرف % % 5(@)(@@) % فالجأ إلى الله إن رمت النجاة بها % % واسلك سبيل أولى التقوى ولا تقف % % PageV01P1079 البحر : - 1(@)(@@) % صحن صحناء واسع الأطراف % % وهو صحن لذي التقى والعفاف % % 2(@)(@@) % حضرة للذي تولى عليها % % وهي أبهى منازل الأشراف % % 3(@)(@@) % من دعانا لها يجل مقاما % % فاضل الذات كامل الأوصاف % % 4(@)(@@) % مشرفات جهاتها بسناها % % خالص الود صادق الحب صافي % % 5(@)(@@) % صدره واسع لمن جاء يسعى % % لحماه من سائر الأضياف % % 5(@)(@@) % نويت الفنا فيها وللمرء ما نوى % % 6(@)(@@) % فناديتها رفقا إلى كم أرى نوى % % 7(@)(@@) % ولابد من وصل به يسكن الجوى % % 8(@)(@@) % فإما بذل وهو أليق بالهوى % % وأما بعز وهو أليق بالملك % % PageV01P1080 البحر : - 1(@)(@@) % يا قلب لا تشتغل إلا بمن حبك % % وثوب جسمك بأيدي قدرته حبك % % 2(@)(@@) % خيلان وجه جعل صور الصور حبك % % فالق نواك كما قد قال عن حبك % % 6(@)(@@) % لا يزال الكمال يقطر منه % % نوره في سمائه غير خاف % % 7(@)(@@) % وهو شهم مهذب يتسامى % % كل وقت عن كل شيء منافي % % PageV01P1081 البحر : - 1(@)(@@) % مت في هوى حي بحسب حيه حيك % % وانزل بحيه فإنه قد نزل حيك % % 2(@)(@@) % هذا الذي بظهوره قد قتل حيك % % وثوب حالك على نول الهدى حيك % % 8(@)(@@) % وله من عناية الله باع % % طال فوق الرؤوس والأكتاف % % PageV01P1082 البحر : - 1(@)(@@) % يا شرفي يا شرفي يا شرفي % % وجه من أهواه وقد أشرق في % % PageV01P1083 البحر : - 1(@)(@@) % أيها الطالب النجاة أتاكا % % قول حق فخل عنك الهلاكا % % 2(@)(@@) % قلبي المضنى به طلعته % % فتنتنى بالبها والهيف % % 2(@)(@@) % إنني كاشف لك السر فاسمع % % سر رب قد اختفى عن حجاكا % % 3(@)(@@) % غصن بان ينثني مرحا % % قد رماني في بحار التلف % % 3(@)(@@) % خلق الله أولا عالم الرو % % ح 
ms234	 وما كان من مكان هناكا % % 4(@)(@@) % لو رآه البدر ما بان ولو % % سمع الظبي به لم يقف % % 4(@)(@@) % لا ولاكان من زمان فحقق % % ما أشرنا له بلغت مناكا % % 5(@)(@@) % ينجلي في كل شيء عندنا % % فنراه في القبا المنكشف % % 5(@)(@@) % ثم من بعده المقادير جاءته % % بي وكان مع الزمان ابتداكا % % 6(@)(@@) % لبس الصورة يختال بها % % بيننا حاوي البها والترف % % PageV01P1084 6(@)(@@) % وابتداء المقدار عرش محيط % % هو جسم ولا يطيق حراكا % % 7(@)(@@) % قد تسمى لي بأسماء الورى % % وبكل اسم لهم مختلف % % 7(@)(@@) % ثم فيه من روحه كان نفخ % % من إله في غيبه لا يحاكى % % 8(@)(@@) % فاقتضى إذا تحركاوسكونا % % فأدار النجوم والأفلاكا % % 8(@)(@@) % عطفه الغصن وقلبي طائر % % همزة ساكنة في الألف % % 9(@)(@@) % هو حق وسواه باطل % % مثل ما قال لنا في الصحف % % 9(@)(@@) % ثم إن النجوم حرك فيها % % ذلك النفخ عندها الإدراكا % % 10(@)(@@) % فاشهد اشهد أن تكن ذا بصر % % وإذا لم تكن كن في الطرف % % 10(@)(@@) % فنسمت أرواحها بعقول % % عند قوم وليس هذا بذاكا % % 11(@)(@@) % وادخل الحضرة إن كنت فتى % % أو من الحضرة فاخرج وانتف % % PageV01P1085 11(@)(@@) % إنما العقل كاللسان لروح % % وبه النفخ أمر رب حباكا % % 12(@)(@@) % ثم بالنفخ كان مزيج أصول % % أربع واسمه المزاح اصطكاكا % % 12(@)(@@) % ملأ الكون تعالى ربنا % % بوجود ظاهر وهو خفي % % 13(@)(@@) % أنت روح نفخت في أمره % % درة من جسمها في صدف % % 13(@)(@@) % فبدت أربع المواليد منهافهو في الغيب ربنا جل ربا وهو في الكون أمره لا انفكاكا % % كيف ماشاء ربهن انسباكاسقط بيت ص % % 14(@)(@@) % آه من جهلك بالله ومن % % قلبك المنقلب المنحرف % % 14(@)(@@) % فهو من فوق عرشه لا مكان % % هو فيه إذ لا مكان هناكا % % 15(@)(@@) % أفلا تذكر أياما مضت % % أنت بها لم تكن يا منتفى % % 15(@)(@@) % وله الاستوا على العرش حقا % % وهو للكل ممسك إمساكا % % 16(@)(@@) % إن هذا المعنى الذي قال عنه % % إنه فوق عرشه لأعداكا % % PageV01P1086 16(@)(@@) % كن كما كنت قديما فانيا % % واعرف الحق به واعترف % % PageV01P1087 البحر : - 1(@)(@@) % وإذا ذات كل شيء تبدت % % عنده حقق التقرب وصفه % % 2(@)(@@) % لحمى 
ms235	 ذلك الغزال شهود % % يحرسون الذي يحاول خطفه % % 3(@)(@@) % وهو إنساننا وحيوان قوم % % وجنين من قبل ذاك ونطفه % % 4(@)(@@) % صدق الشرع فاعل وهو فعل % % فتأمل وللتحقق عطفه % % 17(@)(@@) % فاعرف الآن منك نفسك تجدها % % أمر رب وخلق أمر أتاكا % % 18(@)(@@) % واعتبر في الوجود علوا وسفلا % % ما ذكرناه واترك الإشراكا % % 19(@)(@@) % وتحقق به تجده قريباولتبقى به له ولتفنى عن سواه ولا تراه سواكا % % لك وافهم به لينطق فاكاسقط بيت ص % % 20(@)(@@) % وهو باق على الذي هو فيه % % أزلا ليس ما سواه اشتراكا % % PageV01P1088 البحر : - 1(@)(@@) % خفض عدوي في الهوى ومصادقي % % محبوبتي ذات الوشاح الخافق % % 2(@)(@@) % أنا لا أميل إلى سواها دائما % % إن شئت خالف في الهوى ووافق % % 21(@)(@@) % عز رب وجل عن كل شيء % % وتعالى يدبر الأملاكا % % PageV01P1089 البحر : - 1(@)(@@) % يا من تملك بالمحاسن مهجتي % % 2(@)(@@) % وإليه ملت ولا سواه بجملتي % % 3(@)(@@) % تجلى إلى متى أردت تفضلا % % بمروط أشباح الورى وقرا طق % % 3(@)(@@) % وأريده لما أقول أحبتي % % 4(@)(@@) % وهي التي كانت وكنت وهكذا % % هي هكذا بمغارب ومشارق % % 4(@)(@@) % خلص الهوى لك واصطفتك مودتي % % إني أغار عليك من ملكيكا % % 5(@)(@@) % أنا ثوبها روحا وجسما وهي في % % خلعي ولبس مثل لمحة بارق % % 5(@)(@@) % عيني بوجهك لا تزال قريره % % 6(@)(@@) % والقلب يضمر منك فيك سريره % % 6(@)(@@) % بل ما أنا ثوب لها بل تلك لي % % ثوب به أختال بين خلائق % % PageV01P1090 7(@)(@@) % بل لست ثوبا لا ولا هي ثوب لي % % يا سارقا قطعت يمين السارق % % 7(@)(@@) % وأنا الذي بك زاد عقلي حيرة % % 8(@)(@@) % فلو استطعت منعت لفظك غيرة % % إني أراه مقبلا شفتيكا % % 8(@)(@@) % هذا لفضاءا بدا فقم متنزها % % في النور واخرج من خلال مضايق % % 9(@)(@@) % واحذر فان وراء ذلك لا ورى % % من رائق لا يستقل وفاتق % % 9(@)(@@) % يا جامعي بكلامه المتشتت % % 10(@)(@@) % واشتق واضرب بالعصا حجرا تسل % % لك أعين منه بماء دافق % % 10(@)(@@) % من كل ناحية إليك تلفتي % % 11(@)(@@) % فتوض فيه واغتسل وادخل به % % للمسجد الأقصى محل رقائق % % 11(@)(@@) % أهفو إليك وعنك وجدي ما فتى % % PageV01P1091 12(@)(@@) % وأراك تخطر في شمائلك 
ms236	 التي % % هي فتنتي فأغار منك عليكا % % 12(@)(@@) % واسجد هناك لوجه حبك سجدة % % من بعدها اخرى سجود الوامق % % 13(@)(@@) % تلق المنى وتكون تحت ستائر % % من لطفه أبدا وتحت سرادق % % PageV01P1092 البحر : - 1(@)(@@) % قمر من فوق غصن نقا % % ينجلي سبحان من خلقا % % PageV01P1093 البحر : - 1(@)(@@) % جاهل كل من رأى % % إن شيئا تحركا % % 2(@)(@@) % والذي في تجرد % % قد رآه تنسكا % % 2(@)(@@) % هذه الأكوان طلعته % % كل من قد هام فيه رقى % % 3(@)(@@) % حيث بالنص من كتا % % ب إلهي تمسكا % % 3(@)(@@) % يا بريق الغور قف نفسا % % قد خطفت القلب والحدقا % % 4(@)(@@) % وهو لاشك عارف % % وهو ذو الفهم والذكا % % 4(@)(@@) % إن تجز يوما بذي سلم % % قل لهم جودوا ببعض لقا % % 5(@)(@@) % لي فؤاد ملؤه شغف % % وضلوع حشيت حرقا % % PageV01P1094 البحر : - 1(@)(@@) % إن قوما لم يروا % % 2(@)(@@) % حالتي لما سروا % % 3(@)(@@) % وعظامي قد بروا % % 4(@)(@@) % ليت شعري هل دروا % % أي قلب ملكوا % % 5(@)(@@) % قد جرى لي ما جرى % % 6(@)(@@) % وعيون كلما رمقت % % لم يدع منا الهوى رمقا % % 6(@)(@@) % بعدهم بين الورى % % 7(@)(@@) % قل لهم يا سعد مغرمكم % % كم يقاسي الدمع والأرقا % % 7(@)(@@) % آه من لي لو أرى % % 8(@)(@@) % وفؤادي لو درى % % أي شعب سلكوا % % PageV01P1095 8(@)(@@) % ذاب شوقا في محبتكم % % حين منكم بارق برقا % % 9(@)(@@) % شمس هذا الكون طالعة % % جذبت روح الذي رمقا % % 9(@)(@@) % أنا صب مغرم % % 10(@)(@@) % ذاتها من ذات لابسها % % وهما في النشأة افترقا % % 10(@)(@@) % واصطباري عدم % % 11(@)(@@) % وهي من أنوار بهجته % % بالعطايا تملأ الأفقا % % 11(@)(@@) % وهم القوم همو % % 12(@)(@@) % أتراهم سلموا % % أم تراهم هلكوا % % 12(@)(@@) % حنت الأرواح حين بدت % % مثل معشوق ومن عشقا % % 13(@)(@@) % ثم راح الجسم مضطربا % % شم ريح الأمر فانتشقا % % PageV01P1096 13(@)(@@) % عنهم الراوي روى % % 14(@)(@@) % وحنين لفرعا لا عجب % % نحو أصل باسمه نطقا % % 14(@)(@@) % إنهم في المستوي % % 15(@)(@@) % يا نسيمات سرت سحرا % % من شذاها الكون قد عبقا % % 15(@)(@@) % ثم من فرط الجوى % % 16(@)(@@) % خير بنا عن احبتنا % % وعن الأهلين والرفقا % % 16(@)(@@) % حار أرباب الهوى % % في الهوى وارتبكوا % % 17(@)(@@) % ليت من بالجزع لو عطفوا % % ليت من أهواه 
ms237	 بي رفقا % % 18(@)(@@) % دمعتي بالسفح من أضم % % سفحت يوم النوى قلقا % % 19(@)(@@) % يا عذولي كف عن عذلي % % إن هذا اللوم محض شقا % % PageV01P1097 20(@)(@@) % لو ترى ما قد رأيت لما % % لمت في ساق هواه سقى % % 21(@)(@@) % في نواحي الشعب غانية % % حسنها في الكون ما اتفقا % % PageV01P1098 البحر : - 1(@)(@@) % فر يا طائر إلى ربك % % عن سواه بمقتضى حبك % % 2(@)(@@) % وتعلق به على ثقة % % منه غيبا ومل إلى قربك % % 3(@)(@@) % فهو مولاك يرتضيك له % % عبد أن تبت فيه من ذنبك % % 22(@)(@@) % كما لاحت سجدت لها % % حيث كلي ذاب وانمحقا % % 23(@)(@@) % وأنا الفاني فواعجبا % % كيف لي منها بوصف بقا % % PageV01P1099 البحر : - 1(@)(@@) % بدرتم لاح في الغسق % % فوق غصن بالجمال سقى % % 2(@)(@@) % وبه الألباب هائمة % % سكرت منه فلم تفق % % 3(@)(@@) % عطرت روضتي نسائمه % % حين وافت بالشذا العبق % % 4(@)(@@) % وفؤادي فيه ذو شغف % % دائما والجفن ذو أرق % % 4(@)(@@) % وبه لا بك اختطفه تنل % % لمحة منه فهو في دربك % % 5(@)(@@) % واصطباري يوم جفونه % % ما بقى والوجد فيه بقى % % 5(@)(@@) % وإذا ما اختطفته فعلى % % نفسك الاختطاف لا ربك % % 6(@)(@@) % هائم صب كثير جوى % % عنه سدت سائر الطرق % % 6(@)(@@) % هو أدنى إليك منك له % % كل نفس فالنفس من حجبك % % 7(@)(@@) % خطفته منه بارقة % % غيرها في القلب لم يرق % % PageV01P1100 7(@)(@@) % أنت عنه بك احتجبت ولم % % يحتجب عنك في صفا شربك % % 8(@)(@@) % فأدارت كأس خمرته % % فهو منا اليوم في غرق % % 8(@)(@@) % إنما شف عنه ثوبك في % % لبسة الماء منك مع تربك % % 9(@)(@@) % فتجرد عن الوجود به % % وتحققه وافن عن سربك % % 10(@)(@@) % وعن الكل وابق فيه به % % حضرة المصطفى الذي هو بك % % PageV01P1101 البحر : - 1(@)(@@) % يا مبتلي بالغرام اصبر لأوجاعك % % لو كنت عاقل دليل العقل ما طاعك % % 2(@)(@@) % فاسلك بربك وخلي عنك أطماعك % % وانظر لأوضاعه واترك لأوضاعك % % 9(@)(@@) % وأثارت عرف روضته % % في الورى طوبى لمنتشق % % 10(@)(@@) % كيف لا اختال في مرح % % ومليح الوجه معتنقى % % PageV01P1102 البحر : - 1(@)(@@) % من مجيري من فاتر الطرف فاتك % % لا تحاكيه يا غزاله فاتك % % 2(@)(@@) % قمر طالع على غصن بان % % صانه الله 
ms238	 وهو للصب هاتك % % 3(@)(@@) % يتثنى بقامة فتنتنا % % فارجعي يا غصون عن حركاتك % % 4(@)(@@) % يا بديع الجمال جرت علينا % % الأمان الأمان من فتكاتك % % 5(@)(@@) % لك ذات بها سلبت البرايا % % بتناويع حسنها من صفاتك % % 6(@)(@@) % أيها الوجه بالمحبين رفقا % % نحن مثل الشخوص في مرآتك % % 7(@)(@@) % كم على وجهك الجميل خمار % % من نفوس لما ظهرت بذاتك % % 8(@)(@@) % فاكشف الوجه وامحق النفس منا % % وأحي منا ميت الهوى بحياتك % % 9(@)(@@) % فيك بعنا نفوسنا واسترحنا % % من بلاها فجد لنا بالتفاتك % % 10(@)(@@) % كل شيء به ظهرت علينا % % فاختفينا يا نور في ظلماتك % % PageV01P1103 11(@)(@@) % أنت طورا ولا سواك وأنا % % نحن طورا ولا سوى آياتك % % 11(@)(@@) % فاسالوا عيني فإن بها % % لمحة من داخل الحدق % % 12(@)(@@) % هي أطوارنا ترد إلينا % % كلها منك وهي بعض هباتك % % 12(@)(@@) % نلتها من حسن بهجة من % % لو بدا الكون لم يطق % % 13(@)(@@) % قسما بالصفا ومروة جسمي % % حين أسعى يا حب في مرضاتك % % 13(@)(@@) % ثم ذوقوا ما بقى بفمي % % من بقايا خمر كل تقى % % 14(@)(@@) % هذه أذنى لقد سمعت % % طيب ذاك الصوت فاسترق % % 14(@)(@@) % لم أحل عنك دائما فافهمي يا % % نفس حتى إن كنت في غفلاتك % % 15(@)(@@) % واسألوا أنفي فقد نفحت % % فيه ريا نفحة الفلق % % 15(@)(@@) % هذه سنة المحبين قبلي % % لك منها نقيم في جناتك % % PageV01P1104 16(@)(@@) % يا بني قومي خذوا خبري % % عن وجى قلبي وعن قلقي % % 17(@)(@@) % وانظروا نحوي فإن خفيت % % شمس ذاتي فاشهدوا شفقي % % 18(@)(@@) % كل ما تدرونه حجب % % لسعيد في الورى وشقي % % 19(@)(@@) % واحذروا في الله أن تقفوا % % عند شيء لاح في الأفق % % 20(@)(@@) % فالبرايا كلها فتن % % أي جمع غير مفترق % % 21(@)(@@) % كلها تمضي بأجمعها % % ثم يبقى الإثم في العنق % % 22(@)(@@) % واحذروا أن تعبدوا صنما % % نحتته فكرة فقي % % 23(@)(@@) % جل ربي في تنزهه % % عن وجودات على طلق % % 24(@)(@@) % فاسرعوا وامحوا الحروف بما % % عندكم من صفحة الورق % % 25(@)(@@) % قل أن يبدو النون لكم % % يأخذ الباقي من الرمق % % PageV01P1105 البحر : - 1(@)(@@) % إن جسمي هنا وقلبي هناكا % % وأنا الصب بين هذا وذاكا % % 2(@)(@@) % دار سلمى ما دار فيها 
ms239	 محب % % قط إلا ذاق الفنا والهلاكا % % 3(@)(@@) % طلعة لا طلوع يعرف منها % % غير أمر يحرك الأفلاكا % % 4(@)(@@) % يا لسلمى ويا لأحباب سلمى % % هل لكم وقفة هنا نتشاكى % % 5(@)(@@) % هي منا قريبة وبعيد % % نحن عنها لقصدنا الإشراكا % % 6(@)(@@) % آه لو أنها دنت فتدلتاحذر احذر تجد بأنك عنها خارج بانفصال شيء دهاكا % % لك حتى بها رأيت مناكاسقط بيت ص % % 7(@)(@@) % كالنصارى في قولهم ولد الل % % ه يضاهون كاذبا أفاكا % % 8(@)(@@) % واليهود الذين قالوا بأنا % % نحن أبناء الله والكفر ذاكا % % 26(@)(@@) % واسلكوا سبل النجاة على % % دين طه زاكي الخلق % % 27(@)(@@) % ثم كونوا أثر سنته % % وبها فامشوا على نسق % % PageV01P1106 28(@)(@@) % وابعثوا لي دعوة وسلوا % % في غدا منا لذي فرق % % 29(@)(@@) % وصلاة الله دائمة % % مع سلام غير منحمق % % 30(@)(@@) % للذي أنواره سطعت % % فأحالت صبغة الغسق % % 31(@)(@@) % أحمد المختار سيدنا % % من به قلبي مناه لقى % % 32(@)(@@) % ما بدا للكون منشئه % % خلف ستر أبيض يقق % % PageV01P1107 البحر : - 1(@)(@@) % أنا الهيكل الذاتي لمظهر قدرة % % 2(@)(@@) % ومن شاخصي قد حزت أكمل صورة % % 3(@)(@@) % ولما تأملت الوجود بفكرة % % 4(@)(@@) % رأيت خيال الظل أكبر عبرة % % لمن هو في علم الحقيقة راقي % % 5(@)(@@) % على كل شيء سيف عزمي قد انتضى % % 6(@)(@@) % وفي ليل غيبي صبح معرفتي يضي % % 7(@)(@@) % وكل الورى من بعد ذا لست ارتضي % % 8(@)(@@) % شخوص أشباحو تمر وتنقضى % % وتفنى جميعا والمحرك باقي % % 9(@)(@@) % حيث معنى هذا انفصال لشيء % % عن إله الورى وما أدراكا % % 10(@)(@@) % وهو كفر منزه عنه ربي % % قد نهاهم عن مثله ونهاكا % % PageV01P1108 11(@)(@@) % إنما الله عالم من قديم % % كل شيء والشي ليس هناكا % % 12(@)(@@) % وبإنزاله هو الذكر يتلى % % لم يكن عنه خارج محراكا % % 13(@)(@@) % وهو الله لا سواه ولكن % % علمه منزل به الأملاكا % % 14(@)(@@) % كالبرايا جميعهم ولهذا % % هو قيومهم كما قد أتاكا % % 15(@)(@@) % حاش لله أن يكون من الل % % ه انفصال للشيء قل حاشاكا % % 16(@)(@@) % وسع الله كل شيء كما قا % % ل وشيء له الفنا في فناكا % % PageV01P1109 البحر : - 1(@)(@@) % رأيت خيال الظل أكبر عبرة % % يلوح بها معنى الكمال لا 
ms240	 حداقي % % 2(@)(@@) % وفي كل موجود على الحق آية % % لمن هو في علم الحقيقة راقي % % 3(@)(@@) % شخوص وأشباح تمر وتنقضي % % وليس لها مما قضى الله من واقى % % 4(@)(@@) % لها حركات ثم يبدو سكونها % % وتفنى جميعا والمحرك باقي % % 17(@)(@@) % هو علم له تعالى فذكر % % نازل منه فيه ليس انفكاكا % % 18(@)(@@) % أنت يا غافل الذي لست تدري % % عارفا كن بنفسك النساكا % % 19(@)(@@) % قمر نائب عن الشمس ليلا % % فإذا ما النهار جاء محاكا % % 20(@)(@@) % إنما ظل نفسك الليل فامحق % % كرة الأرض عنك تلق هداكا % % PageV01P1110 البحر : - 1(@)(@@) % الله يفتح كل باب مغلق % % وهو المقيد للوجود المطلق % % 2(@)(@@) % والفكر في يده كمفتاح لنا % % يبدي به عنا الذي فينا بقى % % 21(@)(@@) % هو نور وما سواه ظلام % % فالق عنك السوى به يلقاكا % % PageV01P1111 البحر : - 1(@)(@@) % ليس لله في الوجود شريك % % لا اشتباه فيه ولا تشكيك % % 2(@)(@@) % والذي يدعي الوجود مع الل % % ه دعواه هذه تشريك % % 3(@)(@@) % فالجأ إليه وكن به متعلقا % % لا فاز من هو ليس بالمتعلق % % PageV01P1112 البحر : - 1(@)(@@) % هي الذات التي فوق البراق % % تحن إلى ذرى السبع الطباق % % 2(@)(@@) % لها بالجسم منها ثوب در % يشف على معانيها الدقاق % % 3(@)(@@) % فمن ينأى إليها فهو دان % % ومن يفنى عليها فهو باقي % % 3(@)(@@) % إنما الله ظاهر يتجلى % % وهو نور يمحى به التحليك % % 4(@)(@@) % وما بسوى المحبة كون شيء % % وليس الميل إلا للتلاقي % % 4(@)(@@) % ومحيط بكل شيء كما قا % % ل ولا شيء سوقة ومليك % % 5(@)(@@) % وأنوار الجمال بكل قلب % % تسمى بالهوى والاشتياق % % 5(@)(@@) % فاعرف اعرف من قبل موتك يا من % % لم يفده نصح ولا تسليك % % 6(@)(@@) % ولم يكن النعيم سوى التداني % % ولم يكن العذاب سوى الفراق % % 6(@)(@@) % لتكن مؤمنا بربك حقا % % ويزول التسكين والتحريك % % PageV01P1113 7(@)(@@) % وترى الكل فيه كن فيكون الأم % % ر منه له اللجين السبيك % % PageV01P1114 البحر : - 1(@)(@@) % يا وجودي إنني الصورة لك % % أنت قد صورتها وهي ملك % % 2(@)(@@) % شهد الحق ولم يشهد سوى % % إنه الشاهد سوى وملك % % 3(@)(@@) % صورتي فعل له وهو الذي % % صاغها من عدم رب الفلك % % 4(@)(@@) % وكذا الأشياء 