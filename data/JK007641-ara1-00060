ms41	 حضرتي % % 2(@)(@@) % وأنفخ مزماري وأصغي لصوته % % وأضرب دفي حين ترقص قينتي % % 3(@)(@@) % وأنشق من روضي نسيم حقائقي % % ويسرح طرفي في حدائق نشأتي % % 4(@)(@@) % وعندي إلى رؤيا جمالي تشوق % % كثير وما عشقي لغير حقيقتي % % 5(@)(@@) % ويا لهف أحشائي على حسني الذي % % فؤادي به صب ويا فرط لوعتي % % 6(@)(@@) % أحن إلى ذاتي صباحا وفي المسا % % وغاية قصدي في العوالم رؤيتي % % 7(@)(@@) % وقد وعدتني اليوم نفسي بوصلها % % غدا متى مني تقوم قيامتي % % 8(@)(@@) % وأرفع عن وجهي خماري مجردا % % ثيابي عن ذاتي وأهتك سترتي % % 9(@)(@@) % أبى الحب إلا أن أكون مولها % % بقلب على طول النوى متفتت % % 10(@)(@@) % وشوق كثير واصطبار ممنع % % وسقم وأشجان علي شديدة % % PageV01P219 11(@)(@@) % وإني لأرجو من حقيقتي اللقا % % وأطلب منها أن أفوز بنظرة % % 12(@)(@@) % فلا عجب أن بحت بالسر للورى % % وعربدت في هذا الوجود بسكرتي % % 13(@)(@@) % وتهت بمحبوبي على كل ناسك % % وغبت عن الأكوان بل عن هويتي % % 14(@)(@@) % وعندي انتظار كل يوم وليلة % % إلى رؤيتي بل كل وقت وساعة % % 15(@)(@@) % وما أنا إلا من أحب وإن من % % أحب أنا من غير شك وشبهة % % 16(@)(@@) % أردت ظهوري لي وما كنت خافيا % % فطورت في الأطوار من كل صورة % % 17(@)(@@) % وقد كنت قدما في عمى ليس فوقه % % ولا تحته أيضا هواء بوحدة % % 18(@)(@@) % وللقلم الأعلى تنزلت من يدي % % وللوح حتى للذوات الكثيرة % % 19(@)(@@) % وقد كنت عرشي واستويت عليه من % % قديم زماني في الوجود برحمتي % % 20(@)(@@) % ومنه إلى الكرسي تنزلت بل إلى % % سمواتي السبع الطباق العلية % % PageV01P220 21(@)(@@) % وطورت أملاكي فلي كنت عابدا % % وطورت أفلاكي فدارت بقدرتي % % 22(@)(@@) % وعذت نجوما مشرقات على الورى % % أزيد ضياء في ظلام الدجنة % % 23(@)(@@) % وطورت شمسا في طلوع نهاركم % % وما الليل إلا من نتائج غيبتي % % 24(@)(@@) % وصرت هلالا تحسبون الشهور بي % % وأجلو عليكم ضوء شمس الظهيرة % % 25(@)(@@) % وقد صرت أياما لكم ولياليا % % ودهرا وساعات وكل دقيقة % % 26(@)(@@) % وطورت شكل الجان في الأرض قبلكم % % وجئت لهم رسلا لإبلاغ حجتي % % 27(@)(@@) % وقد كنت تكذيبا لرسلي منهم % % فصرت لهم أوفي هلاك ونقمة % % 28(@)(@@) % وفي 
ms42	 كل أطوار الشياطين بينكم % % ظهرت بوسواس لأصحاب شقوة % % 29(@)(@@) % وطورت في شكل العناصر ثم في % % مواليدها في الأرض تلك الثلاث % % 30(@)(@@) % ففي معدن طورا وطورا ظهرت في % % نبات وحيوان لتتميم حكمتي % % PageV01P221 31(@)(@@) % وكنت رياحا من شمال ومن صبا % % أهب فأروي عن حديث الأحبة % % 32(@)(@@) % وكنت بحارا زاخرات على المدى % % تفيض فتبدي موجة بعد موجة % % 33(@)(@@) % وطورت أرضا ثم صرت جبالها % % لإرسائها فوق البحار المحيطة % % 34(@)(@@) % وإني على ما كنت فيه ولم أزل % % ولي رتبة التنزيه أرفع رتبه % % 35(@)(@@) % وما كثرة الأطوار مني غيرت % % صفاتي ولا ذاتي ولا قدر ذرة % % 36(@)(@@) % وهل أنت في تخييل ذاتك باطنا % % تغيرت عما كنت في كل مرة % % 37(@)(@@) % فيجلو عليك الفكر ما قد أردت من % % زخارف أشباح هنا مستحيلة % % 38(@)(@@) % وذاك كهذا غير أن الخيال مع % % تخيله في الغير لا في الهوية % % 39(@)(@@) % وما هي إلا أنت لا شيء ههنا % % سواك فحقق سر تلك الحقيقة % % 40(@)(@@) % وإياك والتشبيه في كل موضع % % توهمت فيه الغير وافطن للبسة % % PageV01P222 41(@)(@@) % وخذ كل ما القي عليك منزها % % ولا تخش عارا إن فهمت إشارتي % % 42(@)(@@) % وهذا الذي قد قلته كله أنا % % ظهرت به لي قاصدا لنصيحتي % % 43(@)(@@) % ولما انقضت أطوار ذاتي بمقتضى % % صفاتي وأسمائي العظام الجليلة % % 44(@)(@@) % وتم التباسي بالذي أنا مظهر % % له من شخوص فصلتها إرادتي % % 45(@)(@@) % وسويت جسم الكل بي فهو قابل % % لروحي وتفصيلي استعد لجملتي % % 46(@)(@@) % جمعت من الأشياء طينة آدم % % ومنها إلى الكل الرقائق مدت % % 47(@)(@@) % وخمرتها حتى تناسق نشؤها % % وسويتها حتى لنفخي استعدت % % 48(@)(@@) % ولما استتم الأمر واستكمل الذي % % أردت من الإجمال في البشرية % % 49(@)(@@) % ففي تلك من روحي نفخت وقد سرت % % نسائم أمري في رياض الطبيعة % % 50(@)(@@) % فقمت سميعا باصرا متكلما % % مريدا عليما ذا حيا وقدر % % PageV01P223 51(@)(@@) % فلم يبد ممني غير ما هو كائن % % لدي وبي مني علي حكومتي % % 52(@)(@@) % فكنت كماء لونه ممن إنائه % % وكالشمس تبدي خضر بالزجاجة % % 53(@)(@@) % وأسجدت أملاكي بأمري لمظهري % % فكان سجودي لي وآدم قبلتي % % 54(@)(@@) % ولما أبى إبليس عني 
ms43	 تكبرا % % ولم تأتي من بعد أمري بسجدة % % 55(@)(@@) % عن الملا الأعلى له كنت مخرجا % % وآب بخسران وطرد ولعنة % % 56(@)(@@) % وأسكنته في الأرض أظهر كامنا % % به من شقا أصحاب قبضة يسرتي % % 57(@)(@@) % وأظهرت في ذاك الملا فضل آدم % % وأنزلته أعلى مقام بجنتي % % 58(@)(@@) % وأخرجت حوا منه فهي له كما % % هو الآن لي من حيث وصفي وصورتي % % 59(@)(@@) % وعن بعض أشجار هناك نهيته % % ولي كان مني النهي عني لحكمتي % % 60(@)(@@) % ولما اقتضى فعلي لما كنت عنه قد % % نهيت كمال الصورة الآدمية % % PageV01P224 61(@)(@@) % أتيت بأقسام إلي موسوسا % % وأوقعت نفسي في غرورة غفلة % % 62(@)(@@) % وذقت كما ذاق العدو تباعدي % % وما الأكل إلا الفرق والجمع توبتي % % 63(@)(@@) % وقد لاح عصياني علي ومذ بدت % % طفقت بأوراق أخصف سوءتي % % 64(@)(@@) % ومن بعد ذا أهبطت للأرض هيكلي % % وكنت بها في العالمين خليفتي % % 65(@)(@@) % وسخرت لي كل الوجود تفضلا % % على صورتي مني وأتممت منتي % % 66(@)(@@) % وعرفت ما بيني وبيني كلاهما % % على عرفات بعد طول التشتت فكان نكاح الأمر في الخلق ظاهرا ينافي كلا الشخصين قبل النتيجة % % 67(@)(@@) % وأظهرت من صلبي جميع مظاهري % % بصورة ذر للعهود الوثيقة % % 68(@)(@@) % وأشهدتهم عني ألست بربكم % % فقالوا بلى طرا بنفس مطيعة % % 69(@)(@@) % وأوهمتهم غيرا فأنكر بعضهم % % وأوفى بعهدي بعضهم مع لبسة % % 70(@)(@@) % وأول أطواري الكوامن أنني % % لآدم شيئا كنت وهو عطيتي % % PageV01P225 71(@)(@@) % وطورت نوحا جاء ينذر قومه % % وكنت له التكذيب منهم ببعثتي % % 72(@)(@@) % وألفا سوى خمسين عاما لبثت في % % جماعتهم أبغي لهم نشر دعوتي ولما أبوا واستكبروا كافرين بي دعوت عليهم واستجبت لدعوتي % % 73(@)(@@) % وأرسلت طوفانا عليهم فأغرقوا % % ولم ينج إلا من معي في سفينتي % % 74(@)(@@) % وطورت إدريسا ولي كنت رافعا % % مكانا عليا في أجل مكانه % % 75(@)(@@) % وطورت إبراهيم يدعو إلي بي % % على قومه آتيته أي حجة % % 76(@)(@@) % ومذ قال ذا ربي له كنت كوكبا % % كذا قمرا أيضا وشمسا بوجهه % % 77(@)(@@) % ولا فرق إلا بالأفول ألم تكن % % إذا لا أحب الآفلين مقالتي % % 78(@)(@@) % كما قلت سموهم لقوم تعلقوا % % بما قيد الإمكان من مطلقيتي % % 79 
ms44	(@)(@@) % وجئت إلى النمرود أدعوه للهدى % % فلم يمتثل حتى توى بالبعوضة % % 80(@)(@@) % وأضرم في نارا وأرسلني بها % % فعادت بأمري لي علي كجنة % % PageV01P226 81(@)(@@) % وقد كنت مني طالبا أنني أرى % % لحق يقيني كيف إحياء ميتة % % 82(@)(@@) % فجاء جوابي لي بأربعة فخذ % % من الطير واجعل في العلا كل قطعة % % 83(@)(@@) % وناديهم يأتين سعيا وبعد ذا % % فكن عالما لا شي إلا بقدرتي % % 84(@)(@@) % وطورت إسماعيل لما بلغت مع % % أبي السعي ذبحي قد رأيت بنومة % % 85(@)(@@) % وناديت لما أسلما حين تله % % أصدقت حتى كان بالكبش فديتي % % 86(@)(@@) % وطورت إسحق الغيور ولم تكن % % على غير تحريم الفواحش غيرتي % % 87(@)(@@) % وطورت يعقوبا بليت بيوسف % % وأسلمني حبي له كل محنة % % 88(@)(@@) % وفرقت ما بيني زمانا وبينه % % ووا أسفي ناديت من طول فرقتي % % 89(@)(@@) % وعيناي من حزني قد ابيضتا وقد % % مننت بجمع الشمل بعد التشتت % % 90(@)(@@) % ويوسف قد طورت زاد ملاحة % % بوجه سبى كل الوجوه المليحة % % PageV01P227 91(@)(@@) % وبالثمن البخس اشتراني مشتر % % وفي الجب ألقتني من الكيد إخوتي % % 92(@)(@@) % وقد عشقت حسني زليخاء والهوى % % أضر بها حتى هممت وهمت % % 93(@)(@@) % وطورت هودا كان يشهد قومه % % على أنه من شركهم ذو براءة % % 94(@)(@@) % ولوطا لقد طورت أيضا وصالحا % % أتيت إلى قومي لإبلاغ دعوتي % % 95(@)(@@) % فزاغوا وعن أمري عتوا وتكبروا % % وقد عقروا لما عصوني ناقتي % % 96(@)(@@) % وطورت موسى ضارب البحر بالعصا % % وقد شق حتى قومه فيه مرت وآنس نارا من جوانب طوره فرام ليأتي الأهل منها بجذوة فنال الهدى في شكل مقصده وقد تجلى له من مظهر الأحدية وقد حاز منه رؤية بسؤاله ولكنها الأطواد بالصعق دكت % % 97(@)(@@) % وعيسى لقد طورت يبرئ أكمها % % وأبرص والأموات يحيي بدعوة وأرسلت روحي طبق ما هو عادتي إلى الأم حتى كان مظهر نفختي وأظهرت ما قد كان في الأب مضمرا وبينت للأقوام سر إلا مومة % % 98(@)(@@) % فضلوا وزاغوا عن مثال ضربته % % لفهم علوم في الوجود دقيقة % % 99(@)(@@) % وقالوا بأني قد غدوت له أبا % % وقد خص من دون الورى ببنوتي % % 100(@)(@@) % وأين الوجودان اللذان تباينا % % وما عز 
ms45	 خلاق كذل خليقة % % PageV01P228 101(@)(@@) % ومن بعد هذا جئت في طور كل ما % % مضى من رسول أو نبي لأمة % % 102(@)(@@) % وأصبحت في شكل النبي محمد % % إلى الله أدعو الناس في أرض مكة % % 103(@)(@@) % فآذتني الأقوام بغيا وحاولوا % % بأفواههم إطفاء نور النبوة % % 104(@)(@@) % وأظهرت دين الحق بعد خفائه % % فأصبحت الكفار في سوء حالة % % 105(@)(@@) % ونكست أصنام الضلال وفي الورى % % أزلت ظلام الظلم من فرط سطوتي % % 106(@)(@@) % وطورت أصحابا ومن هو تابع % % لهم بالهدى مثل الكرام الأئمة % % 107(@)(@@) % ومن بعد ذا ما زلت أظهر دائما % % على أمد الأزمان في كل هيئة % % 108(@)(@@) % وطورت أهوال القيامة والذي % % يكون غدا في يوم عرض الخليقة % % 109(@)(@@) % وإياك من قولي بأن تفهم الذي % % تدين به الكفار بين البرية % % 110(@)(@@) % فإني بريء من حلول رمت به % % عقول تغذت بالظنون الخبيثة % % PageV01P229 111(@)(@@) % وما بانحلال واتحاد أدين في % % حياتي وإن دانتهما شر أمة % % 112(@)(@@) % وكل الذي أبديته لك ناظما % % فن فوق أطوار العقول السليمة % % 113(@)(@@) % فإن كنت من أهل المعارف لم تلم % % لأنك تلقاه بنفس تزكت % % 114(@)(@@) % وإن كنت مطموس البصيرة جامدا % % على ما ترى من صورة بعد صورة % % 115(@)(@@) % فإنك معذور بقلة فهم ما % % أقول لضعف في قواك الكليلة % % 116(@)(@@) % فواظب على التنزية وادأب عليه لا % % تكن من أناس بالتشبه ضلت % % 117(@)(@@) % ودع عنك تجسيما ولا تك جاهلا % % بأوصاف من أبداك في كل حالة % % PageV01P230 البحر : - 1(@)(@@) % أنا كل الوجود والكائنات % % أنا كل الأرواح كل الذوات % % 2(@)(@@) % أنا كل العقول بل كل شيء % % في جميع الأزمان والأوقات % % 3(@)(@@) % ليس كل الوجود إلا أسامي % % والمسمى بكل ذلك ذاتي % % 4(@)(@@) % والتباسي عليك حيث لباسي % % كل شيء يلقيك في الآفات % % 5(@)(@@) % يا بني هذه العصابة إني % % جاعل حبكم مكان حياتي % % 6(@)(@@) % لي فؤاد يحن شوقا إليكم % % كل حين في سار الحالات % % 7(@)(@@) % إنما نحن واحد نتجارى % % في بحار الوجود كالموجات % % 8(@)(@@) % لمحات تلوح من نور أمر % % وبقاء الجميع في اللمحات % % 9(@)(@@) % ولعين العيون في كل شأن % % صور تستقل عند عداتي % % 10(@)(@@) % والتجلي في 
ms46	 كل نوع مفيد % % عكس ما نحن فيه والحق آت % % PageV01P231 11(@)(@@) % واقترابي تباعدي وعلومي % % عين جهلي والنفي في إثباتي % % 12(@)(@@) % حبذا ضجة السماع سحيرا % % إن تكن بالدفوف والنايات % % 13(@)(@@) % وصرير الطنبور والجنك لما % % شاكلته رقيقة النغمات % % 14(@)(@@) % وصياح السنطير للهو يدعو % % وكؤوس الطلا بأيدي السقاة % % 15(@)(@@) % مجلس فيه موسم للأماني % % وهو بالأنس حف واللذات % % 16(@)(@@) % سيما والملاح تخطر فيه % % بوجوه محمرة الوجنات % % 17(@)(@@) % هذه هذه المظاهر لاحت % % لا خصوص الشخوص والهيآت % % 18(@)(@@) % صرخ الناي فاستمع يا نديمي % % وتنصت لهذه النفخات % % 19(@)(@@) % وتأمل ما في سماعك منه % % وخذ الأمر من يد الأصوات % % 20(@)(@@) % صور تلك في السماع تجلت % % ثم ولت وما لها من ثبات % % PageV01P232 21(@)(@@) % واضطراب الجسوم بالوجد يحكي % % دوران الأفلاك بالحركات % % 22(@)(@@) % عارف الله عارف كل شيء % % وسواه من جملة الأموات % % 23(@)(@@) % كثر القول من ذي الجهل فينا % % فالصواب السكوت بالإخبات % % 24(@)(@@) % قولهم صادق عليهم لأن الحكم % % فرع عن التصور آت % % 25(@)(@@) % والذي نحن فيه هم في سواه % % أين نور الهدى من الظلمات % % 26(@)(@@) % لو يحوزون ذرة من صواب % % تركونا وهذه الآيات % % 27(@)(@@) % يا أخي العين لو ترى بك ما بي % % كنت مثلي تفوه بالشطحات % % 28(@)(@@) % أنا صب أهيم في كل شي % % حيث ألغيت جمل الكائنات % % 29(@)(@@) % وتجلت علي ذات خمار % % نورها لاح من جميع جهاتي % % 30(@)(@@) % وأنا حافظ قضية حكمي % % والحدود التي بهن نجاتي % % PageV01P233 31(@)(@@) % فلهذا أحب كل لذيذ % % وفؤادي يدوم في الشهوات % % 32(@)(@@) % وأنا مغرم بكل مليح % % في حياتي هنا وبعد مماتي % % 33(@)(@@) % وإذا لامني الجهول أنادي % % حسبك الجهل عن أتم صفاتي % % PageV01P234 البحر : - 1(@)(@@) % أنوار شمس الذات لما لاحت % % أرواحنا شوقا إليها راحت % % 2(@)(@@) % يا زهرة في روض قلبي فاحت % % نفسي بما قد أضمرته باحت % % PageV01P235 البحر : - 1(@)(@@) % يا من هو الموجود عند السالك % % لا غيره إذ كل شيء هالك % % 2(@)(@@) % احكم بما قد شئت أنت المالك % % كل الورى بالعشق فيك ارتاحت % % PageV01P236 البحر : - 1(@)(@@) % أنت الذي قامت بك الأشياء % % أنت الذي ضاءت بك الظلماء % % 2(@)(@@) % عن حكمك العدل الورى أفياء 
ms47	 % % إن زال عنها الحكم يوما طاحت % % PageV01P237 البحر : - 1(@)(@@) % يا ظاهرا في كل شيء باطن % % في القلب لا فيما سواه قاطن % % 2(@)(@@) % عنكم لغات الكون فيها راطن % % بالشوق والأشياء فيكم صاحت % % PageV01P238 البحر : - 1(@)(@@) % العقل من كل الورى محجوب % % إن لم يكن يظهر له المحبوب % % 2(@)(@@) % والظاهر المأمول والمطلوب % % إذ سائر الأستار عنه انزاحت % % PageV01P239 البحر : - 1(@)(@@) % يا حسرة المحجوب والمغرور % % قد سار في الظلماء لا في النور % % 2(@)(@@) % مربوط بالأغيار كالمأسور % % في ساحة الدنيا حشاه ساحت % % PageV01P240 البحر : - 1(@)(@@) % لا عالم يدري الذي أدريه % % والجاهل المغرور بالتمويه % % 2(@)(@@) % فاسمع بأذن القلب ما أبديه % % في الحب أطيار المعاني ناحت % % PageV01P241 البحر : - 1(@)(@@) % يا منكرين لكم في ناركم كيات % % نياتكم جعلت أعمالكم حيات % % 2(@)(@@) % أنتم عميتم عن المنشور في الطيات % % والكل بالله والأعمال بالنيات % % PageV01P242 البحر : - 1(@)(@@) % ظهرت ذاتي لذاتي % % فس صفات من صفاتي % % 2(@)(@@) % وبدت في النفس نفس % % سكنت في حركات % % 3(@)(@@) % كنت كالقشر عليها % % وهي كاللب المواتي % % 4(@)(@@) % والذي أبديه عنها % % هو نعتي وسماتي % % 5(@)(@@) % عينها غابت ولكن % % حضرت باللحظات % % 6(@)(@@) % وغدت تكشف عني % % لي بها عن ظلماتي % % 7(@)(@@) % وتبدت شمسها من % % فوق سبع الطبقات % % 8(@)(@@) % فأنارت أرض قلبي % % وبها ضاءت جهاتي % % 9(@)(@@) % وأنا الحادث ماض % % وأنا الدائم آت % % 10(@)(@@) % وهو أمر واحد واثنان % % بعد الالتفات % % PageV01P243 11(@)(@@) % فتنحوا عن طريقي % % يا نفوسا جاهلات % % 12(@)(@@) % واحذروا أن تدخلوا في % % طرقاتي الضيقات % % 13(@)(@@) % وابحثوا عنكم وخلوا % % البحث عن أوصاف ذاتي % % 14(@)(@@) % أنا الأروح أمر % % فوق كل الكائنات % % 15(@)(@@) % أنا الأمحض نور % % فائض باللمحات % % 16(@)(@@) % أنا الأسر عرش % % وأنا ماء الحياة % % 17(@)(@@) % وأنا المعروف في السبع % % الطباق العاليات % % 18(@)(@@) % وأنا فوق إشاراتي % % وكل الشطحات % % 19(@)(@@) % ومعاني الكون دوني % % وهي من أدنى هباتي % % 20(@)(@@) % كيف لا والنفس مني % % ذهبت في الذاهبات % % PageV01P244 21(@)(@@) % وبدا الحق مكاني % % يتجلى بصفاتي % % 22(@)(@@) % والذي يعرف ربي % % عارف بي وبذاتي % % 23(@)(@@) % والذي يجهله يجهلمني % % بالغفلات % 24(@)(@@) % يا اخلاءي رويدا % % كم بتعويج قناتي % % 25(@)(@@) % ظنكم أعدم نوري % % عندكم ذا اللمعات % % 26(@)(@@) % كلما لمتم شربنا % % كم كؤوس 
ms48	 صافيات % % 27(@)(@@) % وعلمنا كم دنان الباقيات % % الصالحات % 28(@)(@@) % وجهلتم ما لديكم % % كحمير سارحات % % 29(@)(@@) % عندكم ما وأنتم % % قد عطشتم للممات % % 30(@)(@@) % هيئوا الأكباد منكم % % في غد للحسرات واستعدوا لسؤال عن جميع السيئات % % PageV01P245 31(@)(@@) % ليت منكم لو شربتم % % ما حويتم يا سقاتي % % 32(@)(@@) % مخرج الأفلاك أضحى % % بحروف الجسم يأتي % % 33(@)(@@) % عن لسان الملأ الأعلى % % وهاتيك الذوات % % 34(@)(@@) % ومعاني الروح تتلى % % في المسا والغدوات % % 35(@)(@@) % وكلام الله برق % % خصنا بالومضات % % 36(@)(@@) % وسمعنا وتر الوتر % % بأيدي الغانيات % % 37(@)(@@) % ودفوف الحق من نقرتها % % زالت سناتي % % 38(@)(@@) % ومزامير المعاني % % أطربت بالنغمات % % 39(@)(@@) % وحلا رقصي مع الأرواح % % تلك الراقصات % % 40(@)(@@) % ثم باءاتي جميعا % % دخلت في ألفاتي % % PageV01P246 41(@)(@@) % وانقضى صحوي وقد عمت % % ببحر السكرات % % 42(@)(@@) % غرست في أرضه باللطف % % منه شجراتي % % 43(@)(@@) % وهو بزري وهو أيضا % % ظاهرا من ثمراتي % % 44(@)(@@) % وانثنت أغصاننا من % % أمره بالنسمات % % 45(@)(@@) % في ربا أوج التجلي % % ورفيع الحضرات % % 46(@)(@@) % يا شذا عرف غراسي % % فاح يا طيب نباتي % % 47(@)(@@) % والسوى في كل حزن % % وأنا في النزهات % % 48(@)(@@) % والذي عندي مني % % غير ما عند عداتي % % 49(@)(@@) % هم يروني في شتات % % مثل ما هم في شتات % % 50(@)(@@) % وانطوى عنهم خصوصي % % انتفى عنهم ثباتي % % PageV01P247 51(@)(@@) % وانجلت شمس وهم بالجسم % % خلف الهضبات % % 52(@)(@@) % فاح مسكي وزكام % % عندهم عن نفحاتي % % 53(@)(@@) % وأنا في محض إيقان % % وهم في الشبهات % % 54(@)(@@) % وعلى الجملة فيهم % % قد أجيبت دعواتي % % 55(@)(@@) % وأصيبوا برزايا % % هي إحدى السطوات % % PageV01P248 البحر : - 1(@)(@@) % إن لم تجد كل حي في البرايا ميت % % فأنت محجوب حالك ليت تدري ليت % % 2(@)(@@) % أبواب كل الحواس أغلق وقم في بيت % % قلبك تقل لك زليخا أمر ربك هيت % % PageV01P249 البحر : - 1(@)(@@) % ليت شعري مذ كررت نظراتي % % أنا ساع في الموت أو في الحياة % % 2(@)(@@) % يا غلاما إذا اعتبرتك جسما % % أو ترقيت قلت روح الذوات % % 3(@)(@@) % وإذا ما فنيت عنك وعني % % قلت يا رب في أتم الصفات % % 4(@)(@@) % لك عندي في الكل صورة وجه % % جل عن كل صورة بالتفات % % 5(@)(@@) % أنت غيري حقيقة ولو أني % % قلت لما 
ms49	 فنيت ذاتك ذاتي % % 6(@)(@@) % آه من لي بمفرد يتثنى % % فيفوه اللسان بالشطحات % % 7(@)(@@) % نحن في كفه كؤوس مدام % % دائرات في سائر الأوقات % % 8(@)(@@) % من يرمنا يسكر بنا خارجا عن % % كل شيء يرى من الكائنات % % 9(@)(@@) % عدم ظاهر بمحض وجود % % بل وجود يغيب بالغفلات % % 10(@)(@@) % وإذا شاء كان أكشف شي % % وهو إن شاء أغيب الغائبات % % PageV01P250 11(@)(@@) % هذه عادة المظاهر تبدو % % للهلاك السريع أو للنجاة % % 12(@)(@@) % والذي يعشق الملاحة يفنى % % في العيون الفواتر الناعسات % % 13(@)(@@) % يا وجودا وكل شيء سواه % % عدم ظاهر به في الجهات % % 14(@)(@@) % إن أردنا لنا بأنك أنا % % حيث منا لا شيء ماض وآت % % 15(@)(@@) % وإذا ما هياكل الجهل لامت % % فالسوى نحن مثلهم عن ثبات % % 16(@)(@@) % نحن في النور سارون إلينا % % وجميع الأنام في الظلمات % % PageV01P251 البحر : - 1(@)(@@) % بقي الروح مما كان في التابوت % % تابوت موسى وذاك الجسم والناسوت % % 2(@)(@@) % وحين عقلي غدا في ملكه طالوت % % قتل من النفس داود الهدى جالوت % % PageV01P252 البحر : - 1(@)(@@) % إنني إن أمت فما أنا ميت % % أنا حي بمن إليه اهتديت % % 2(@)(@@) % وأنارت مشكاة ذاتي بمصباح % % علومي وفي الزجاجة زيت % % 3(@)(@@) % رمت من رامني بصدق وداد % % وإذا ما دعا له لبيت % % 4(@)(@@) % ولروحي الحضور في كل حي % % فيلذ التصبيح والتبييت % % 5(@)(@@) % إن لله في ابن آدم ملكا % % لا زوال له ولا تفويت % % 6(@)(@@) % سر ذات به الخلافة قامت % % وعليه الإحياء والتمويت % % 7(@)(@@) % نظري في ظواهر الكون فخر % % والتفاتي إلى البواطن صيت % % 8(@)(@@) % من سواه افتقرت لما تبدي % % لي جهرا حتى به استغنيت % % 9(@)(@@) % ولعقلي بسره تكميل % % ولقلبي بأمره تثبيت % % 10(@)(@@) % إن تأملت فالجميع معان % % ولنطق الوجود هم تصويت % % PageV01P253 11(@)(@@) % عطس الكون بي وقد كنت حمدا % % منه حتى له أنا التشميت % % 12(@)(@@) % من يزرني يزر اشعة نور المصطفى % % ضمها ضريح نحيت % % 13(@)(@@) % وهو حي في قبر جسم محب % % بغذاء الهوى له تقويت % % 14(@)(@@) % وله قلبي المدينة كشفا % % أين منها بغداد أو تكريت % % 15(@)(@@) % عالما كن أو طالبا أو محبا % % مثل ما قال تلق ما قد لقيت % % 16 
ms50	(@)(@@) % لا تكن رابعا فتهلك جهلا % % بالذي قد أمرت أو قد نهيت % % 17(@)(@@) % يا شبيهي بصورة الجسم قد أسمعت % % حيا لو أنني ناديت % % 18(@)(@@) % ليت هذا البعيد منك قريب % % ليت لو قربت بعيدك ليت % % 19(@)(@@) % قف على هذه الشخوص فإما % % ملك في الثياب أو عفريت % % 20(@)(@@) % وتجنب عن الحلول وحقق % % كل شيء فذاك للحق بيت % % PageV01P254 21(@)(@@) % وتأمل فالفرق بالله جمع % % واجتماع على السوى تشتيت % % PageV01P255 البحر : - 1(@)(@@) % كل أناس لهم لغات % % وكل محو له ثبات % % 2(@)(@@) % وكل وقت له كلام % % وكل شغل له أداة % % 3(@)(@@) % وكل سر له ظهور % % وكل ليل له سراة % % 4(@)(@@) % وكل أمر له سماء % % وكل شخص له سمات % % 5(@)(@@) % وكل حكم له مضاء % % وكل ذات لها صفات % % 6(@)(@@) % وكل خمر له مدير % % وكل كاس له سقاة % % 7(@)(@@) % وكل سهم له مصاب % % وكل قوس له رماة % % 8(@)(@@) % وكل طير له غذاء % % وكل وحش له فلاة % % 9(@)(@@) % وليس يدري ببعض أمري % % إلا الذي جمعه شتات % % 10(@)(@@) % وليلة بالهدى نهار % % وفي مساء له غدا % % PageV01P256 11(@)(@@) % وقلبه الشمس بالتجلي % % غروبها عنده الممات % % 12(@)(@@) % وجسمه صور نفخ روح % % بأمره تحشر الرفات % % 13(@)(@@) % ميزانه العقل والصراط الشرع % % الذي قالت الهداة % % 14(@)(@@) % يموت في ساعة ويحيى % % فموته طاب والحياة % % 15(@)(@@) % وحاصل الأمر فهو مثلي % % ذاتان في الوصف وهي ذات % % 16(@)(@@) % وما سواه حمار جهل % % يقطته في الورى سنات % % 17(@)(@@) % شيطانه راكب عليه % % من يده ما له نجاة % % 18(@)(@@) % يوقعه في جحود ما لا % % يدريه مما درت ثقات % % 19(@)(@@) % مكدر ما له صفاء % % والقلب من قسوة صفاة % % 20(@)(@@) % وذاك ما لا اعتبار عندي % % ولا إليه لنا التفات % % PageV01P257 21(@)(@@) % والحرف ذو عجمة وأما % % حروفه فهي مهملات % % PageV01P258 البحر : - 1(@)(@@) % ذاتي لاحت % % فيما بدا من صفاتي % % 2(@)(@@) % حتى انزاحت % % عن عيوني غفلاتي % % PageV01P259 البحر : - 1(@)(@@) % يا من أهدى % % كل حسن وجمال % % 2(@)(@@) % لما أبدى % % لي فنون الحركات % % PageV01P260 البحر : - 1(@)(@@) % أنت الباقي % % لم تزل والكف فان % % 2(@)(@@) % إني الراقي % % في رفيع الدرجات % % PageV01P261 البحر : - 1(@)(@@) % جلت عين % % شاهدت وجه حبيبي % % 2(@)(@@) % عنها 
ms51	 غين % % صار يمحى بالثبات % % PageV01P262 البحر : - 1(@)(@@) % يوم الوادي % % طلعت سلمى علينا % % 2(@)(@@) % حتى النادي % % ضاء من كل الجهات % % PageV01P263 البحر : - 1(@)(@@) % يا إخواني % % هذه الأنوار لاحت % % 2(@)(@@) % للأعيان % % جمعت مني شتاتي % % PageV01P264 البحر : - 1(@)(@@) % غنى الحادي % % فشجى قلب المعنى % % 2(@)(@@) % ذاك الصادي % % للقاء الظبيات % % PageV01P265 البحر : - 1(@)(@@) % وما أشواقي % % لمعاني حسن ليلى % % 2(@)(@@) % ما لي واقي % % من سيوف اللحظات % % PageV01P266 البحر : - 1(@)(@@) % إني هائم % % بعدهم في كل وادي % % 2(@)(@@) % عشقي دائم % % لحبيبي يا سقاتي % % PageV01P267 البحر : - 1(@)(@@) % هذا حاني % % جمع القوم السكارى % % 2(@)(@@) % من يلحاني % % ليس يدري حسن ذاتي % % PageV01P268 البحر : - 1(@)(@@) % في أفلاكي % % طلعت شهب نجومي % % 2(@)(@@) % من أملاكي % % أنزلت وحي النجاة % % PageV01P269 البحر : - 1(@)(@@) % حتى يتلى % % سر قرآني بقلبي % % 2(@)(@@) % لما يجلى % % بالبها وجه فتاتي % % 3(@)(@@) % إني وحدي % % ما معي في الكون غيري % % 4(@)(@@) % أبدي وجدي % % لبدوري الطالعات % % PageV01P270 البحر : - 1(@)(@@) % من أغياري % % خلصت للحق عيني % % 2(@)(@@) % مذ أطواري % % أحرقتهم سبحاتي % % PageV01P271 البحر : - 1(@)(@@) % في ديجوري % % أشرقت شمس نهاري % % 2(@)(@@) % لولا نوري % % كتمتني ظلماتي % % PageV01P272 البحر : - 1(@)(@@) % من يهواني % % يترك الكل جميعا % % 2(@)(@@) % يبقى عاني % % يرتجي حسن التفاني % % PageV01P273 البحر : - 1(@)(@@) % يبدو وجهي % % عنده أيان ولى % % 2(@)(@@) % يمحو شبهي % % مع جميع الشبهات % % PageV01P274 البحر : - 1(@)(@@) % لا يلويه % % عن حمانا صوت شاد % % 2(@)(@@) % بل يثنيه % % لي جميع النغمات % % PageV01P275 البحر : - 1(@)(@@) % يصغي لما % % يصدح الطير سحيرا % % 2(@)(@@) % يجلو الغما % % ويزيل الحسرات % % PageV01P276 البحر : - 1(@)(@@) % تلك الليلة % % زارني من كنت أهوى % % 2(@)(@@) % في التهليه % % جذبت نوقي حداتي % % PageV01P277 البحر : - 1(@)(@@) % لو كانت لي % % قدره الرؤية لما % % 2(@)(@@) % أفنت كلي % % عمت في بحر الحياة % % 3(@)(@@) % لكن مني % % خطفت مثلي جميعي % % 4(@)(@@) % تملا دني % % بهوى الحب المواتي % % PageV01P278 البحر : - 1(@)(@@) % ثم اشتاقت % % مثل ما اشتقت إليها % % 2(@)(@@) % حتى راقت % % خمرتي بالنفحات % % PageV01P279 البحر : - 1(@)(@@) % يا عذالي % % في شرب هذي الحميا % % 2(@)(@@) % قدري عالي % % في هوى ماض وآت % % PageV01P280 البحر : - 1(@)(@@) % فرد لكن % % هو في المجلى كثير % % 2(@)(@@) % عندي ساكن % % فيه صحوي سكراتي % % PageV01P281 البحر : - 1(@)(@@) % أفنى لبي % % نور سكان المصلى % % 2(@)(@@) % يحي قلبي % % برقهم بالومضات % % PageV01P282 البحر : - 1(@)(@@) % روضي زاهي % % بأزاهير التجلي 
ms52	 % % 2(@)(@@) % عرفي باهي % % بلطيف النسمات % % PageV01P283 البحر : - 1(@)(@@) % من يدريني % % بملوك العشق يدري % % 2(@)(@@) % في ذا الحين % % نافذات سطواتي % % PageV01P284 البحر : - 1(@)(@@) % جل المولى % % من حباني بالعطايا % % 2(@)(@@) % وهو الأولى % % بي فلا أخشى عداتي % % PageV01P285 البحر : - 1(@)(@@) % صلى ربي % % دام الدهر على من % % 2(@)(@@) % أوج القرب % % قد رقي بالمكرمات % % 3(@)(@@) % أبدى فيه % % مادحا عبد الغني % % 4(@)(@@) % ما يبديه من % % رقيق الكلمات % % PageV01P286 البحر : - 1(@)(@@) % عل الباري % % أن يوقي المسلمينا % % 2(@)(@@) % حر النار % % مع جميع الحسرات % % PageV01P287 البحر : - 1(@)(@@) % ألا ليت لو جاد لي الحب ليت % % فحبي هو الحي والكل ميت % % 2(@)(@@) % مليح به ضاء مصباحنا % % ومن علمه كان إمداد زيت % % 3(@)(@@) % بنتنا له يده كعبة % % بها طفت سبعا وفيها سعيت % % 4(@)(@@) % فيا أم العشق حجوا إلى % % فؤادي الذي هو للحب بيت % % 5(@)(@@) % نحرنا له أنفسا في منى % % هواه وجمرات همي رميت % % 6(@)(@@) % سواي به ضل فيما اهتدى % % وإني بما قد ضللت اهتديت % % 7(@)(@@) % هو الحرم إلا من للملتجي % % ظهرت به حين فيه اختفيت % % PageV01P288 البحر : - 1(@)(@@) % كفة الغيب كفة الحسنات % % وهي في الكون كفة السيئات % % 2(@)(@@) % وانظر الميل فهو للقلب مني % % ميل قلب الميزان يزان ذاتي % % 3(@)(@@) % وأقيموا للوزن بالقسط هذا % % قول ربي في محكم الآيات % % 4(@)(@@) % وكذاك الصراط مني إليه % % نفخة الروح لاتصال الحياة % % 5(@)(@@) % وهو جسر على جهنم جهل % % هو أغيار حضرة الحضرات % % 6(@)(@@) % ما إلى جنة الصفات سواه % % من طريق في هذه الظلمات % % 7(@)(@@) % فإذا مات صاحب الفتح منا % % ورقي بالفنا ذرى الدرجات % % 8(@)(@@) % ثم أحياه ربه يوم حشر % % عرف الكل واهتدى بلغات % % 9(@)(@@) % ورأى ما رأى وحقق كشفا % % أن سر الوجود في الحركات % % 10(@)(@@) % حركات الوجود لا حركات % % سكنات وليس بالسكنات % % PageV01P289 11(@)(@@) % وشؤون وما لها من وجود % % وهي بالقلب للوجود المواتي % % 12(@)(@@) % هي طورا به تلوح وطورا % % هو يبدو بها لأهل النجاة % % 13(@)(@@) % أيها الغافلون مهلا رويدا % % لم أوافق لكم على الغفلات % % 14(@)(@@) % أنا في رؤيتي تصرف ربي % % بي تشاغلت عن تصرف ذاتي % % 15(@)(@@) % غاب نوري في نوره فمحاني % % وأزالت صفاته لصفاتي 
ms53	 % % 16(@)(@@) % وهو حق ذاتا ووصفا وإني % % باطل زاهق بغير ثبات % % 17(@)(@@) % صغة مستحيلة تتلاشى % % بالتجلى في سائر الحالات % % PageV01P290 البحر : - 1(@)(@@) % نور طه المصطفى منه جميع الكائنات % % وبه كان الترقي في رفيع الدرجات % % 2(@)(@@) % كفه غيث مغيث لقلوب المتقين % % ومزيل عطش الأمة يوم الحسرات % % 3(@)(@@) % كل روح هي من نور سناه ظهرت % % كل جسم هو منه ظاهر بالحركات % % 4(@)(@@) % وهو سر ليس يخلو منه شيء في الورى % % لكن الستر عليه من شخوص النسمات % % 5(@)(@@) % شاهد ذلك منا وهو مشهود لنا % % يتجلى للبرايا في جميع اللمحات % % 6(@)(@@) % وصلاتي وسلامي للذي أنواره أشرقت في الكون حتى زال سر الظلام وعلى آل وصحب بهما عبد الغني % % بدل الله له سوء الخطا بالحسنات % % PageV01P291 البحر : - 1(@)(@@) % نفس بعلوة لا تزال أبية % . . . % 2(@)(@@) % زادت على كل النفوس مزيه % . . . % 3(@)(@@) % وحقيقة تهوى الظهور خفيه % . . . % 4(@)(@@) % يا درة بيضاء لا هوتيه % % قد ركبت صدفا من الناسوت % % 5(@)(@@) % داء الجميع وقد بدت بدوائهم % . . . % 6(@)(@@) % عن غيرها إن جانبوا بهواهم % . . . % 7(@)(@@) % فهي التي فيها كمال صفاتهم % . . . % 8(@)(@@) % جهل البرية قدرها لشقائهم % % وتنافسوا بالدر والياقوت % % PageV01P292 البحر : - 1(@)(@@) % كلامنا غير ما تعطى العبارات % % من المعاني لنا فيه اعتبارات % % 2(@)(@@) % بنفسه قائم وهو المجرد عن % % لفظ ومعنى معا وهو الإشارات % % 3(@)(@@) % هما الكثيفان والسر اللطيف له % % علاقة بهما فيها التفاتات % % 4(@)(@@) % كالروح يظهر من نفس ومن جسد % % وليس يكشفه إلا العنايات % % 5(@)(@@) % فلا تظن بأني إن وصفت حلى % % شيء مرادي به تلك الإحالات % % 6(@)(@@) % أو إن ذكرت نسيما هب من جهة % % أو نفحة هي قصدي والمرادات % % 7(@)(@@) % كذلك البرق والأطلال أذكرها % % في النظم ليست مرادي والحمامات % % 8(@)(@@) % لا والذي جل عما للعقول بدا % % وللحواس به الأحياء أموات % % 9(@)(@@) % كلام أهل طريق الله سر هدى % % لا دخل فيه لهم تبديه أبيات % % 10(@)(@@) % عن المواد له التجريد مخطئة % % منك التآويل فيه والقياسات % % PageV01P293 11(@)(@@) % لم يدره ذو انتقاد في تعنته % % لنفسه زعم علم واجتهادات % % 12(@)(@@) % فيعرب اللفظ للمعنى فيفهمه % % ولا يبين له إلا الضلالات % % 13(@)(@@) % ومقصد القوم 
ms54	 نور في القلوب سرى % % من القلوب وما فيه التباسات % % 14(@)(@@) % رموز أسرار قوم تستعد له % % أرواح قوم لهم في الله راحات % % 15(@)(@@) % روائح القوم شمتها بصائرهم % % لهم إلى الحق همات ورغبات % % 16(@)(@@) % لهم نظمنا المعاني يلمحون بها % % غيب الغيوب وتخفيها العبارات % % PageV01P294 البحر : - 1(@)(@@) % بوجودي فغذني ياقوتي % % وبناري لم يحترق ياقوتي % % 2(@)(@@) % كلنا واحد إذا نحن كنا % % خارج الملك فيه والملكوت % % 3(@)(@@) % وكثير وبعضنا غير بعض % % في ثياب اللاهوت والناسوت % % 4(@)(@@) % وأنا أنت إن تجردت عني % % نحو غيب الغيوب في اللاهوت % % 5(@)(@@) % وتنزلت في النعوت وفارقت % % وجودي إلى فضاء الثبوت % % 6(@)(@@) % ثم جولت في ثبوتك ذوقي % % وتنزلت فيك للتابوت % % 7(@)(@@) % ولهذا أكون أنت ولا تشعر بي أنت يا حبيس البيوت % . . . % 8(@)(@@) % إنني مطلق وإنك قيد % % لي ببحري كيونس والحوت % % 9(@)(@@) % وإذا ما أردت مثلك كم لي % % شبح في ظهوره منحوت % % 10(@)(@@) % أنا ساع في هدم كل بناء % % دون مرأى حقيقتي المبحوت % % PageV01P295 11(@)(@@) % وبجهل أراك تبني نفوسا % % وجسوما بناية العنكبوت % % 12(@)(@@) % ليت دواد روح مثلك لو يقتل % % نفسا أضل من جالوت % % PageV01P296 البحر : - 1(@)(@@) % طريقتنا شرقية قادرية % % فلا نختشي قهرا وذلا ولا فوتا % % 2(@)(@@) % وفي الشرق عبد القادر القطب شيخنا % % طريقته تفضي إلى العز مثبوتا % % 3(@)(@@) % طريقة ذل وانكسار لأجل ذا % % إلى الشرق مدت سنة أرجل الموتى % % PageV01P297 البحر : - 1(@)(@@) % لا تلمني إن السماع يقيت % % وهو يحيي بطيبه ويميت % % 2(@)(@@) % وهو باب لبيت سر عظيم % % بيت حق جداره التثبيت % % 3(@)(@@) % نفحات من الغيوب تبدت % % بث مسك منه لدينا حتيت % % 4(@)(@@) % وعلى الجاهلين ريح كريه % % فائح منه عندهم كبريت % % 5(@)(@@) % والذي عندهم هزار وبوم % % لم يغيره منهما التصويت % % 6(@)(@@) % حيوان في الطبع لا إنسان % % وهو حي وفي الحقيقة ميت % % 7(@)(@@) % حبذا حبذا سماع الأغاني % % والنشيد الذي إليه دعيت % % 8(@)(@@) % تتثنى به الرجال انطرابا % % كغصون لها الصبا قال هيت % % 9(@)(@@) % سيما والدفوف منطرقات % % والمزامير ما لها تفويت % % 10(@)(@@) % وفم الناي نافخ بثنايا % % منه لاح المحيي بنا والمميت % % PageV01P298 البحر : - 1(@)(@@) % إن للثاء في الحروف ثبات % % ولبادي ثباته 
ms55	 وثبات % % 2(@)(@@) % حرف سر سرى بلا سريان % % في المعاني جمع له وشتات % % 3(@)(@@) % هو هذا هذا وهذا هذا % % تتسامى آياته البينات % % 4(@)(@@) % وهو أمر محقق في أمور % % كشخوص تريكها المرآة % % 5(@)(@@) % أخذت ظاهرا وأعطت خفيا % % فسكارى شهودها وصحاة % % PageV01P299 البحر : - 1(@)(@@) % لكعبة الوصف ذات قبلها ذات % % فهي الذوات ثلاث مستعزات % % 2(@)(@@) % كما الصفات ثلاث في مراتبها % % غيب وغيب وغيب فهي غيبات % % 3(@)(@@) % وبالوراثة يبدو ما أقول لكم % % يا معشر القوم والوراث أموات % % 4(@)(@@) % قامت قيامة أهلي في معارفهم % % وللموازين بالأعمال وزنات % % 5(@)(@@) % هي الستارة تخفي ما به ظهرت % % وتظهر الأمر حيث النفي إثبات % % 6(@)(@@) % لاح الصباح فبيت الله حضرته % % والطائفون لهم بالبيت حضرات % % 7(@)(@@) % وزمزم القرب منه القوم قد شربوا % % وفيه دارت على الأكوان كاسات % % PageV01P300 البحر : - 1(@)(@@) % لهب النار في الفتيلة كالروح % % لدى الجسم والغذا كالزيت % % 2(@)(@@) % والذي يحرق الفتيلة منها % % في لهيب كالنفس ذات الصيت % % 3(@)(@@) % إن أزالوه أشرق النور حسا % % فأضاءت به جهات البيت % % 4(@)(@@) % وإذا أهملوه زاد سوادا % % وعلا النور ظلمة التفويت % % 5(@)(@@) % فاعتبر أيها المريد وصولا % % لجناب المحيي لنا والمميت % % PageV01P301 البحر : - 1(@)(@@) % أيا علماء الدين ذمي دينكم % % تحير دلوه بأوضح حجة % % 2(@)(@@) % قضى بضلالي ثم قال أراضى بالقضا % % فهل أنا راض بالذي فيه شقوتي % % 3(@)(@@) % إذا شاء ربي الكفر مني مشيئة % % فهل أنا عاص باتباع المشي % % 4(@)(@@) % وهل لي اختيار أن أخالف حكمه % % فبالله فاشفوا بالبراهين علتي % % PageV01P302 البحر : - 1(@)(@@) % دللناك يا من أنت ذمي ديننا % % فلا تتحير واستمع لمقالتي % % 2(@)(@@) % نعم قد قضى ربي بكفرك عندنا % % ولم يرضه لكن قضى بالإرادة % % 3(@)(@@) % كقاض بقصد قد قضى بجناية % % عليك ولا يرضى بتلك الجناية % % 4(@)(@@) % فإن قبيح الفعل لم يرض عاقل % % به والقضا حق شريف المزية % % 5(@)(@@) % وما فعل القاضي قبيحا وإنما % % فعلت قبيحا أنت بين البرية % % 6(@)(@@) % فألزمك الرحمن أن ترضى بالقضا % % ولا ترض بالمقضى فافهم طريقتي % % 7(@)(@@) % فإن كان خيرا ما قضى كان راضيا % % وإن كان شرا ليس يرضى بشرة % % 8(@)(@@) % قضى بضلال فيك وهو يضل من 
ms56	 % % يشاء ويهدي من يشاء لحكمه % % 9(@)(@@) % فكن بالقضا من ربك الحق راضيا % % ولا ترض بالمقضي أي بالشقاوة % % 10(@)(@@) % وقد شاء ربي أن تشاء لما يشا % % فإن شئت عصيانا عصيت بجهلة % % PageV01P303 11(@)(@@) % وما أنت مجبور وربك خالق % % لك الاختيار المحض من غير مرية % % 12(@)(@@) % وحيث اختيار فيك خلقه ربنا % % كباقي صفات مثل حول وقوة % % 13(@)(@@) % فإنك مختار ولا جبر ههنا % % وكلفك المولى بأنواع كلفة % % 14(@)(@@) % وما الشرط في المخلوق يقدر أنه % % يخالف حكم الخالق المتثبت % % 15(@)(@@) % فكن راضيا بالله ربا وبالنبي % % نبيا وبالدين الحنيفي ملتي % % 16(@)(@@) % تكن مسلما مثلي ومثل معاشري % % وتلحق بنا أهل الكمال الأمة % % 17(@)(@@) % وإلا فدم في الكفر والشرك والردى % % تؤدي الخراج الحتم من بعد جزية % % 18(@)(@@) % حقيرا ذليلا إن أبيت تخطفت % % حشاك حداد السمر والمشرفية % % 19(@)(@@) % وهذا جوابي أحمد الله بعده % % وأهدي إلى المختار أسنى تحية % % 20(@)(@@) % وقد قاله عبد الغني بربه % % تبارك لا بالنفس تلك الفقيرة % % PageV01P304 21(@)(@@) % ورضوان ربي جل عن آل أحمد % % وأصحابه جمعا وبالخير تمت % % PageV01P305 البحر : - 1(@)(@@) % مقالة ابن الرفاعي كان حاصلها % . . . % 2(@)(@@) % لحجرة المصطفى شوقا يخاملها % . . . % 3(@)(@@) % قد جاءها ثم ناداها يسائلها % . . . % 4(@)(@@) % في حالة البعد روحي كنت أرسلها % % تقبل الأرض عني وهي نائبتي % % 5(@)(@@) % لواعج الشوق في أحشائه استعرت % . . . % 6(@)(@@) % والقلب يرعد والأجفان قد مطرت % . . . % 7(@)(@@) % يا طالما عين قلبي وجهك انتظرت % . . . % 8(@)(@@) % وهذه دولة الأشباح قد حضرت % % فامدد يمينك كي تحظى بها شفتي % % PageV01P306 البحر : - 1(@)(@@) % خلوة القبر أشرف الخلوات % % بلقاء الحبيب في الجلوات % % 2(@)(@@) % خلوة القبر للتجرد عما % % يشغل الروح عن أتم الصفات % % 3(@)(@@) % خلوة القبر لذة ونعيم % % لسعيد قد ذاق سر الممات % % 4(@)(@@) % خلوة القبر راحة وسرور % % ودخول في أشرف الجنات % % 5(@)(@@) % حضرة تجمع المتيم فيها % % أي جمع في أكمل الحالات % % 6(@)(@@) % فهي لولا أتى لنا النهي عنها % % بالتمني لها لكانت نجاتي % % 7(@)(@@) % هي سعد لكل عبد سعيد % % يترقى بها علا الدرجات % % 8(@)(@@) % وهي سجن لكل عبد شقي % % يتدلى بها إلى الدركات % % 9(@)(@@) % ليس والله من يمت فهو ميت % % إنما 
ms57	 الموت موت هذي الحياة % % 10(@)(@@) % كل من قام في الحياة بنفس قام بالوهم والأسى والشتات والذي قام بالإله فحي % % بحياة الإله في الأوقات % % PageV01P307 11(@)(@@) % ترك الجسم والكثائف عنه % % طاهرا من خبائث الأدوات % % 12(@)(@@) % خالعا ما كسته منه طباع % % لابسا للملابس الطاهرات % % PageV01P308 البحر : - 1(@)(@@) % حركات سكنات % % كلها تجددات % % 2(@)(@@) % ظهرت عن أمر ربي % % فسرت فيها الحياة % % 3(@)(@@) % إنها خلق وأمر % % وصفات وذوات % % 4(@)(@@) % ووجود خالص قد % % لونته الفانيات % % 5(@)(@@) % مثل لمح البصر الكل % % وهن الكائنات % % 6(@)(@@) % أي هذا الحجر الجامد % % والأرض الموات % % 7(@)(@@) % قم تجدد واكشف الأمر % % لتأتيك الهبات % % 8(@)(@@) % وانظر البرق لموعا % % ماله عنك فوات % % 9(@)(@@) % إنه أنت إذا كان % % له منك التفات % % 10(@)(@@) % كل شيء غير وجه % % الله فان ورفات % % PageV01P309 11(@)(@@) % وهي لولاها لما كان % % به قط ثبات % % 12(@)(@@) % فوجود الكون قول الله كن هم كلمات % . . . % 13(@)(@@) % فهي كن لا غيرها قام % % بها القوم الثقات % % 14(@)(@@) % يعبدون الله سرا % % وجهارا ثم ماتوا % % 15(@)(@@) % إن عرفتم غير هذا الحق % % يا قوم فهاتوا % % PageV01P310 البحر : - 1(@)(@@) % لقد بت من فرط الأسى طول ليلتي % . . . % 2(@)(@@) % أقلب قلبي في الهموم الشديدة % . . . % 3(@)(@@) % أقول مدى صوتي لتفريج كربتي % . . . % 4(@)(@@) % إلهي بتقديس النفوس الزكية % % وتجريدها عن عالم البشرية % % 5(@)(@@) % لعفوك أرجو عن ذنوب تضرنا % . . . % 6(@)(@@) % ومن أنت يا مولى الموالي ومن أنا % . . . % 7(@)(@@) % حقير ذليل كم أنادي لمن دنا % . . . % 8(@)(@@) % أزل عن فؤادي ما ألاقي من العنا % % فإني قليل الصبر عند البلية % % PageV01P311 البحر : - 1(@)(@@) % رأيت الظبي في الحمى راتعات % % فشاهدت أسماها والصفات % % 2(@)(@@) % ولما تجلت عدمنا الذوات % % وقلنا هي الغيب والغيب فات % % PageV01P312 البحر : - 1(@)(@@) % ألا فالتفت يا مدير الكؤوس % % ولا تنسي قد أطلت الجلوس % % 2(@)(@@) % أقمني لأشهد وجه العروس % % وهات اسقني فضلة الكأس هات % % 3(@)(@@) % حبيبي سطا بالعيون الحسان % % علينا فناديت منها الأمان % % 4(@)(@@) % وأهديت مني له كل آن % % سلاما سلاما وأوفي صلات % % PageV01P313 البحر : - 1(@)(@@) % كذا آله والصحاب الكرام % % ذوو المجد من فضلهم لا يرام % % 2(@)(@@) % بهم نال عبد الغني المقام % % ونال الرسوخ بهم والثبات % % PageV01P314 البحر 
ms58	 : - 1(@)(@@) % تأمل فما فات شي أتى % % ولا يعرف الأمر إلا الفتى % % 2(@)(@@) % شربت الوجود ولم أرتوي % % من الحب يا ليت شعري متى % % 3(@)(@@) % متى أرتوي منه وهو الذي % % نفاني ولكنه أثبتا % % 4(@)(@@) % فأثبتني فيه من غير أن % % أرى لي وجودا سواه أتى % % 5(@)(@@) % فويلاه ويلاه مني ومن % % تدليه لما دنا ملفتا % % 6(@)(@@) % ألا يا لقومي قفوا ههنا % % فإن له صارما مصلتا % % 7(@)(@@) % خذوا من تعاريف آياته % % به لا بكم وأقصدوا المثبتا % % 8(@)(@@) % محب حبيب لذات له % % إذا ما تجلى لنا أبهتا % % 9(@)(@@) % بعيني عمى عن سوى وجهه % % وأذناي عن غيره صمتا % % 10(@)(@@) % هو الحق يبدو ويخفى ومن % % أراد اجتماعا به شتتا % % PageV01P315 11(@)(@@) % وما الجمع إلا به والذي % % تعدى فعن أمره قد عتا % % PageV01P316 البحر : - 1(@)(@@) % هي هذه الحركات والسكنات % % يأتي بها الفلك الذي هو ذات كر تدور على تحقق علمها بالله كشفا والعقول صفات % % 2(@)(@@) % هي وحدة في كثرة هي كثرة % % في وحدة تتلى بها الآيات % % 3(@)(@@) % وحقيقة فيها الحقاق كلها % % أضدادها جمع بها وشتات % % 4(@)(@@) % قلم إلهي ولوح لم يزل % % بالخلق فيه المحو والإثبات % % 5(@)(@@) % تفنى بأجمعها وترجع عمرها % % مائة مكملة هي السنوات % % 6(@)(@@) % كالطفل تنشأ بالخلاق جملة % % وتعود نسخا فيه تغليظات % % 7(@)(@@) % وشبابها مثل الشباب فرونق % % غض وأيام بها شهوات % % 8(@)(@@) % لا تنكروا تقديمها الصبيان % % والتأخير للأشياخ وهي فتاة % % 9(@)(@@) % حتى إذا كهلت رأيت كهولها % % تحيى وصبيان الحمى أموات % % 10(@)(@@) % وإذا بنا شاخت فإن شيوخنا % % تعلو وتظهر والكهول رفات % % PageV01P317 11(@)(@@) % أبدا كذلك كلما كانت لها % % مائة السنين فإنها المنشآت % % 12(@)(@@) % هي نشأة من بعد أخرى مثلها % % حتى تتم أولئك الحركات % % 13(@)(@@) % ويعود أمر الغيب للبدء الذي % % عنه بدا وتسرمد الحالات % % 14(@)(@@) % لتحققوا بمقالنا وتبينوا % % تجدوا الشموس وتكشف الظلمات % % PageV01P318 البحر : - 1(@)(@@) % قمر الغيب بدا في الظلمات % % فحضرنا منه كل الحضرات % % 2(@)(@@) % وانقضى الموت به والسكرات % % وفنينا في بقاء اللمحات % % PageV01P319 البحر : - 1(@)(@@) % يا شخوصا كسراب ظهرت % % لغرور العقل حتى بهرت % % 2(@)(@@) % طلعة الحق علينا اشتهرت % % وعجيب كيف تبقى الغفلات % % PageV01P320 البحر : - 1 
ms59	(@)(@@) % أيها الظاهر بي خلف حجاب % % كل من يدعوك بالأسما يجاب % % 2(@)(@@) % أمرك الحق هو الأمر العجاب % % وهو كالبرق ونحن اللمعات % % PageV01P321 البحر : - 1(@)(@@) % هذه روحي وهذا جسدي % % ليس شيء منهما طوع يدي % % 2(@)(@@) % وهما عندك يا ذا المدد % % من قبيل الظل تحت الشجرات % % PageV01P322 البحر : - 1(@)(@@) % وعلى طه صلاتي والسلام % % وجميع الآل والصحب الكرام % % 2(@)(@@) % ما رأى عبد الغني نور المقام % % فتلاشى في رفيع الدرجات % % PageV01P323 البحر : - 1(@)(@@) % إن آل النبي في كل عصر % % من زمان مضى وما هو آت % % 2(@)(@@) % شمس فضل بها القلوب أضاءت % % فرأينا الأعمال بالنيات % % PageV01P324 البحر : - 1(@)(@@) % يا نسمة من حمى قاسيون لي هاجت % % حتى اجنبا التي أسرارها ناجت % % 2(@)(@@) % قولي لمن نفسه في عشقها راجت % % بع ههنا النفس أسواق الهوى راحت % % PageV01P325 البحر : - 1(@)(@@) % أحبني وأنا المعدوم في ذاتي % % وهو الوجود تجلى بالخيالات % % 2(@)(@@) % لما عشقني تصورني بإثبات % % فصرت فيه كشكل في المراءات % % PageV01P326 البحر : - 1(@)(@@) % إيماء ربي مزايا عقدها حلت % % ما حرمت أظهرت فيها وما حلت % % 2(@)(@@) % وذاته الأصل في الأكوان ما حلت % % وإنما كل أمر في الورى حلت % % PageV01P327 البحر : - 1(@)(@@) % ترنمت المثاني والمثالث % % فجاء بوصفه ثان وثالث % % 2(@)(@@) % وحيد الذات والأسماء شتى % % وهن إلى تحققه بواعث % % 3(@)(@@) % تجلى بالحجاب على أناس % % طبائعهم برؤيته دمائث % % 4(@)(@@) % فقرت فيه أعينهم وقوم % % تحجب عندهم فيمن يحادث % % 5(@)(@@) % وأحفته مظاهره لديهم % % فكل سائل عنه وباحث % % 6(@)(@@) % فيدنى من يشاء إليه فضلا % % ويبعد من يشاء ولا مناكث % % 7(@)(@@) % هو الفرد الكثير بما تجلى % % وما قد غاب منه عن الحوادث % % 8(@)(@@) % دنا قلبي إليه وقد تدلى % % بقلبي فالتقى فان وماكث % % 9(@)(@@) % فلم يك ههنا أحد سواه % % وقد عبثت من الكون العوابث % % 10(@)(@@) % ترى كل العقول به حيارى % % ولا يدري الشجاع به الدلاهث % % PageV01P328 11(@)(@@) % ولكن من هداه هداه كشفا % % إليه فلا علوم ولا مباحث % % 12(@)(@@) % وجل عن العلوم ومقتضاها % % وما هي غير آداب الموارث % % 13(@)(@@) % ورثناها عن السلف اقتفاء % % لشأن العارفين به الملاوث % % 14(@)(@@) % ألا يا من تجلى في فؤادي % % فذبت به وطهرت الخبائث % % 15 
ms60	(@)(@@) % وكان ولم أكن وحلفت أني % % كغيري لا أكون ولست حانث % % 16(@)(@@) % وجودك منشاي وبه فناءي % % كحال الأحفياء بك الأشاعث % % 17(@)(@@) % مجرد نسبة بالوهم قامت % % ومحض إضافة بالجهل كارث % % 18(@)(@@) % شهدنا وجهك الميمون فينا % % شهود فتى لعلم الغيب وارث % % 19(@)(@@) % ونحن السابقون إليك طلقا % % وإن نبحت أكاليب لواهث % % 20(@)(@@) % وفينا الهاشمية من قريش % % مناسبة نفت سحر النوافث % % PageV01P329 21(@)(@@) % تطير بنا إلى أوج المعالي % % وتسري بالنجيبات الحنائث % % PageV01P330 البحر : - 1(@)(@@) % لما انثنت ثاء الثنا الموروث % % هي كالفراش هناك المبثوث % % 2(@)(@@) % وبها تألف كل معنى نافر % % كجنود حرب هاجم وبعوث % % 3(@)(@@) % يا أيها الحرف الإمام المقتدى % % لك طيب أنفاس وفتك ليوث % % 4(@)(@@) % ملك كهاتيك الحروف مقدس % % في هيكل الناموس والبرغوث % % 5(@)(@@) % ولأجل هذا جاءنا عن سبه % % نهي النبي بعلمه الموروث % % 6(@)(@@) % لكنه في عين منطلق الحجا % % عبد المهيمن ليس عبد يغوث % % PageV01P331 البحر : - 1(@)(@@) % ذهب الخوف والرجا % % ومضى المدح والهجا % % 2(@)(@@) % وأنا اليوم مسلم % % بك قلبي إليك جا % % 3(@)(@@) % طال ما كنت في عمى % % لم أجد عنه مخرجا % % 4(@)(@@) % جامد الذات خامدا % % حامدا ظلمة الدجا % % 5(@)(@@) % وأنا في كثافة % % مطري منك أثلجا % % 6(@)(@@) % مستقيمي القويم بي % % مثل قوم تعوجا % % 7(@)(@@) % حائرا بي آتيه في % % ليل وهمي الذي سجا % % 8(@)(@@) % فبدت نارك التي % % كان موسى لها التجا % % 9(@)(@@) % فتقصدت جمرها % % عندما قد تأججا % % 10(@)(@@) % تذاوبت فوقه % % باستراق فأنتجا % % PageV01P332 11(@)(@@) % جامدي صار مائعا % % كله يا أولي الحجا % % 12(@)(@@) % وإنائي غسلته % % وبدا الصبح أبلجا % % 13(@)(@@) % وخزامى شممت من % % نفحاتي وعرفجا % % 14(@)(@@) % إن رحمننا له % % نفس قد نتأرجا % % 15(@)(@@) % كنت أشتاقه وقد % % كان أوسا وخزرجا % % 16(@)(@@) % نصرة الدين لي به % % وعن الكرب فرجا % % 17(@)(@@) % وقعت قطرتاي في % % بحر أمر تموجا % % 18(@)(@@) % كيف أمتاز بعد أن % % أوضح الحق منهجا % % 19(@)(@@) % من كفوف الهزبر والناب % % ما واقعي نجا % % 20(@)(@@) % واسقياني عتيقة % % يا خليلي وامزجا % % PageV01P333 21(@)(@@) % وعلى حي ربة الخال % % بالقلب عرجا % % 22(@)(@@) % إنني مستهامها % % ولي البعد أزعجا % % 23(@)(@@) % لم أجد مثل حسنها % % قط أبهى وأبهجا % % 24(@)(@@) % سلبني بطلع % % لم يقم بعدها 