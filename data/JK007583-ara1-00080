ms61	 % % سودا من العار لا سودا من الحمم % % 49(@)(@@) % لا تجعلوا البغي ظهرا إنه جمل % من القطيعة يرعى وادي النقم % 50(@)(@@) % نظرت في السير الأولى خلت فإذا % % أيامه أكلت باكورة الأمم % PageV01P195 51(@)(@@) % أفنى جديسا وطمسما كلها وسطا % % بأنجم الدهر من عاد ومن إرم % 52(@)(@@) % أردى كليبا وهماما وهاج به % يوم الذنائب والتحلاق للمم % 53(@)(@@) % سقى شرحبيل من سم الذعاف على % % أيديكم غير رعديد ولابرم % 54(@)(@@) % بز التحية من لخم فلا ملك % متوج في عمامات ولا عمم % 55(@)(@@) % ياعثرة ما وقيتم شر مصرعها % % وذلة الرأي تنسي ذلة القدم % 56(@)(@@) % حين استوى الملك واهتزت مضاربه % % في دولة الأسد لافي دولة الخدم % 57(@)(@@) % أبناء دلفاء مهلا إن أمكم % دافت لكم علقم الأخلاق والشيم % 58(@)(@@) % طائية لا أبوها كان مهتضما % ولامضى بعلها لحما على وضم % 59(@)(@@) % لاتوقظوا الشر من قوم فقد غنيت % دياركم وهي تدعى موطن النعم % 60(@)(@@) % هذا ابن خالكم يهدي نصيحته % من يتهم فهو فيكم غير متهم ! % PageV01P196 البحر : بسيط تام 1(@)(@@) % لن يبق للصيف لا رسم ولا طلل % و لا قشيب فيستكسى ولا سمل % 2(@)(@@) % عدل من الدمع ان يبكي المصيف كما % % يبكى الشباب ويبكى اللهو والغزل % 3(@)(@@) % يمنى الزمان طوت معروفها وغدت % % يسراه وهي لنا من بعدها بدل % 4(@)(@@) % ما للشتاء ولا للصيف من مثل % يرضى به السمع إلا الجود والبخل % 5(@)(@@) % أما ترى الأرض غضبي والحصى قلق % و الأفق بالحرجف النكباء يقتتل % 6(@)(@@) % من يزعم الصيف لم تذهب بشاشته % فغير ذلك أمسى يزعم الجبل % 7(@)(@@) % غدا له مغفر في رأسه يقق % لا تهتك البيض فوديه ولا الأسل % 8(@)(@@) % اذا خراسان عن صنبيرها كشرت % % كانت قيادا لنا أنيابه العضل % 9(@)(@@) % يمسي ويضحي م قيما في مبائته % % وبأسه في كلى الأقوام مرتحل % 10(@)(@@) % من كان يجهل منه جد سورته % في لاقريتين وأمر الحق مكتهل % PageV01P197 11(@)(@@) % فما الضلوع ولا الأحشاء جاهلة % و لا الكلى أنه المقدامة البطل % 12(@)(@@) % هذا ولم يتزر للحرب ديدنه % و أي قرن تراه حين يشتمل % 13(@)(@@) % إن يسر الله أمرا 
ms62	 أثمرت معه % % من حيث أورقت الحاجات والأمل % 14(@)(@@) % فما صلائي ان كان الصلاء بها % % جمر الغضا الجزل الا السير والابل % 15(@)(@@) % المرضياتك ما أرغمت آنفها % % و الهادياتك وهي الرشد والضلل % 16(@)(@@) % تقرب الشقة القصوى أذا أخذت % % سلاحها وهو الإرقال والرمل % 17(@)(@@) % إذا تظلمت من أرض فصلت بها % % كانت هي العز إلا انها ذلل ! % PageV01P198 البحر : طويل 1(@)(@@) % نسائلها أي المواطن حلت % وأي ديار أوطنتها وأيت % 2(@)(@@) % وماذا عليها لو أشارت فودعت % % إلينا بأطراف البنان وأومت % 3(@)(@@) % وما كان إلا أن تولت بها النوى % % فولى عزاء القلب لما تولت % 4(@)(@@) % فأما عيون العاشقين فأسخنت % وأما عيون الشامتين فقرت % 5(@)(@@) % ولما دعاني البين وليت إذ دعا % % ولما دعاها طاوعته ولبت % 6(@)(@@) % فلم أر مثلي كان أوفى بذمة % ولا مثلها لم ترع عهدي وذمتي % % 7(@)(@@) % مشوق رمته أسهم البين فانثنى % % صريعا لها لما رمته فأصمت % 8(@)(@@) % ولو أنها غير النوى فوقت له % بأسهمها لم تصم فيه واشوت % 9(@)(@@) % كأن عليها الدمع ضربة لازب % إذا ما حمام الأيك في الأيك غنت % 10(@)(@@) % لئن ظمئت أجفان عيني إلى البكا % % لقد شربت عيني دما فتروت % PageV01P199 11(@)(@@) % عليها سلام الله أني استقلت % وأنى استقرت دارها واطمأنت % 12(@)(@@) % ومجهولة الأعلام طامسة الصوى % % إذا اعتسفتها العيس بالركب ضلت % 13(@)(@@) % إذا ما تنادى الركب في فلواتها % % أجابت نداء الركب فيها فاصدت % 14(@)(@@) % تعسفتها والليل ملق جرانه % وجوزاؤه في الأفق حين استقلت % 15(@)(@@) % بمفعمة الأنساع موجدة القرا % % أمون السرى تنجو إذا العيس كلت % 16(@)(@@) % طموح بأثناء الزمام كانما % % تخال بها من عدوها طيف جنة % 17(@)(@@) % إلى حيث يلفى الجود سهلا مناله % وخير امرى شدت إليه وحطت % 18(@)(@@) % إلى خير من ساس الرعية عدله % ووطد أعلام الهدى فاستقرت % 19(@)(@@) % حبيش حبيش بن المعافى الذي به % أمرت حبال الدين حتى استمرت % 20(@)(@@) % ولولا أبو الليث الهمام لأخلقت % من الدين أسباب الهدى وأرثت % PageV01P200 21(@)(@@) % أقر عمود الدين في مستقره % وقد نهلت منه الليالي وعلت % 22(@)(@@) % ونادى المعالي فاستجابت نداءه % ولو غيره نادى المعالي لصمت % 23 
ms63	(@)(@@) % ونيطت بحقويه الأمور فأصبحت % بظل جناحيه الأمور استظلت % 24(@)(@@) % وأحيا سبيل العدل بعد دثوره % وأنهج سبل الجود حين تعفت % 25(@)(@@) % ويلوي بأحداث الزمان انتقامه % إذا ما خطوب الدهر بالناس ألوت % 26(@)(@@) % ويجزيك بالحسنى إذا كنت محسنا % ويغتفر العظمى إذا النعل زلت % 27(@)(@@) % يلم اختلال المعتفين بجوده % إذا ما ملمات الأمور ألمت % 28(@)(@@) % همام ، وري الزند ، مستحصد القوى % % إذا ما الأمور المشكلات أظلت % 29(@)(@@) % إذا ظلمات الرأي أسدل ثوبها % % تطلع فيها فجره فتجلت % 30(@)(@@) % به انكشفت عنا الغيابة وانفرت % جلابيب جور عمنا فاضمحلت % PageV01P201 31(@)(@@) % أغر ربيط الجأش ، ماض جنانه % إذا ما القلوب الماضيات ارجحنت % 32(@)(@@) % نهوض بثقل العبء مضطلع به % وإن عظمت فيه الخطوب وجلت % 33(@)(@@) % تطوع له الأيام خوفا ورهبة % % إذا امتنعت من غيره وتأبت % 34(@)(@@) % له ، كل يوم ، شمل مجد مؤلف % وشمل ندى بين العفاة مشتت % 35(@)(@@) % أبا الليث ، لولا أنت لانصرم الندى % % وأدركت الأحداث ما قد تمنت % 36(@)(@@) % أخاف فؤاد الدهر بطشك فانطوت % على رعب أحشاؤه وأجنت % 37(@)(@@) % حللت من العز المنيف محلة % أقامت بفوديها العلى فأبنت % 38(@)(@@) % ليهنىء تنوخا خير أسرة % إذا أحصيت أولى البيوت وعدت % 39(@)(@@) % وأنك منها في اللباب الذي له % تطأطأت الأحياء صغرا وذلت % 40(@)(@@) % بنى لتنوخ الله عزا مؤبدا % تزل عليه وطأة المتثبت % PageV01P202 41(@)(@@) % إذا ماحلوم الناس حلمك وازنت % رجحت بأحلام الرجال وخفت % 42(@)(@@) % إذا ما يد الأيام مدت بنانها % % إليك بخطب لم تنلك وشلت % 43(@)(@@) % وإن أزمات الدهر حلت بمعشر % أرقت دماء المحل فيها فطلت % 44(@)(@@) % إذا ما امتطينا العيس نحوك لم نخف % عثارا ولم نخش اللتيا ولا التي % % PageV01P203 البحر : كامل تام 1(@)(@@) % أرض مصردة وأخرى تثجم % منها التي رزقت وأخرى تحرم % 2(@)(@@) % فإذا تأملت البلاد رأيتها % % تثري كما تثري الرجال وتعدم % 3(@)(@@) % حظ تعاوره البقاع لوقته % % واد به صفر وواد مفعم ! % 4(@)(@@) % لولاه لم تكن النبوة ترتقي % % شرف الحجاز ولا الرسالة تتهم % 5(@)(@@) % ولذاك أعرقت الخلافة بعدما % % عمرت عصورا وهي علق مشئم % 6(@)(@@) % وبه رأينا كعبة الله التي % % هي كوكب الدنيا 
ms64	 تحل وتحرم % 7(@)(@@) % تلك الجزيرة مذ تحمل مالك % أمست وباب الغيث عنها مبهم % 8(@)(@@) % ولعت قراها غبرة ولقد ترى % % في ظله وكأنما هي أنجم % 9(@)(@@) % غنيت زمانا جنة فكأنما % % فتحت إليها منذ سار جهنم % 10(@)(@@) % الجو أكلف والجناب لفقده % محل وذاك الشق شق مظلم % PageV01P204 11(@)(@@) % أقوت فلم أذكر بها لما خلت % إلا مني لما تقضى الموسم % 12(@)(@@) % ولقد أراها وهي عرس كاعب % فاليوم أضحت وهي ثكلى أيم % 13(@)(@@) % إذ في ديار ربيعة المطر الحيا % % وعلى نصيبين الطريق الأعظم % 14(@)(@@) % ذل الحمى مذ أوطئت تلك الربا % % والغاب مذ أخلاه ذاك الضيغم % 15(@)(@@) % إن القباب المستقلة بينها % % ملك يطيب به الزمان ويكرم % 16(@)(@@) % لا تألف الفحشاء برديه ولا % % يسري إليه مع الظلام المأثم % 17(@)(@@) % متبذل في القوم وهو مبجل % متواضع في الحي وهو معظم % 18(@)(@@) % يعلو فيعلم أن ذلك حقه % ويذيل فيهم نفسه فيكرم % 19(@)(@@) % مهلا بني عمرو بن غنم إنكم % % هدف الأسنة والقنا يتحطم % 20(@)(@@) % المجد أعنق والديار فسيحة % والعز أقعس والعديد عرمرم % PageV01P205 21(@)(@@) % ما منكم إلا مردى بالحجا % % أو مبشر بالأحوذية مؤدم % 22(@)(@@) % عمرو بن كلثوم بن مالك بن عت % اب بن سعد سهمكم لا يسهم % 23(@)(@@) % خلقت ربيعة مذ لدن خلقت يدا % جشم بن بكر كف ها والمعصم % 24(@)(@@) % تغزو فتغلب تغلب مثل اسمها % % وتسيح غنم في البلا فتغنم % 25(@)(@@) % وستذكرون غدا صنائع مالك % إن جل خطب أو تدوفع مغرم % 26(@)(@@) % فمن النقي من العيوب وقد غدا % % عن داركم ومن العفيف المسلم % 27(@)(@@) % ما لي رأيت ترابكم يبسا له % مالي أرى أطوادكم تتهدم ؟ % 28(@)(@@) % ما هذه القربى التي لا تصطفى % % ما هذه الرحم التي لا ترحم ؟ ! % 29(@)(@@) % حسد القرابة للقرابة قرحة % أعيت عواندها وجرح أقدم % 30(@)(@@) % تلكم قريش لم تكن آراؤها % % تهفو ولا أحلامها تتقسم % PageV01P206 31(@)(@@) % حتى إذا بعث النبي محمد % فيهم غدت شحناؤهم تتضرم % 32(@)(@@) % عزبت عقولهم وما من معشر % إلا وهم منه ألب وأحزم ! % 33(@)(@@) % لما أقام الوحي بين ظهورهم % ورأوا رسول الله أحمد منهم % 34(@)(@@) % ومن 
ms65	 الحزامة لو تكون حزامة % ألا يؤخر من به يتقدم % 35(@)(@@) % إن تذهبوا عن مالك أو تجهلوا % % نعماه فالرحم القريبة تعلم % 36(@)(@@) % هي تلك مشكاة بكم لو تشتكي % % مظلومة لو أنها تتظلم % 37(@)(@@) % كانت لكم أخلاقه معسولة % فتركتموها وهي ملح علقم % 38(@)(@@) % حتى إذا أجنت لكم داوتكم % من دائكم إن الثقاف يقوم % 39(@)(@@) % فقسا لتزدجروا ومن يك حازما % فليقس أحيانا وحينا يرحم % 40(@)(@@) % واخافكم كي تغمدوا أسيافكم % إن الدم المغتر يحرسه الدم % PageV01P207 41(@)(@@) % ولقد جهدتم أن تزيلوا عزه % فإذا أبان قد رسا ويلملم % 42(@)(@@) % وطعنتم في مجده فثنتكم % زعف يفل بها السنان اللهذم % 43(@)(@@) % أعزز عليه إذا ابتأستم بعده % وتذكرت بالأمس تلك الأنعم % 44(@)(@@) % ووجدتم قيظ الأذى ورميتم % بعيونكم أين الربيع المرهم % 45(@)(@@) % وندمتم ولو استطاع على جوى % % أحشائكم لوقاكم أن تندموا % % 46(@)(@@) % ولو انها من هضبة تدنو له % لدنا لها أو كان عرق يحسم % 47(@)(@@) % ما ذغذغت تلك السروب وأصبحت % فرقين في قرنين تلك الأسهم % 48(@)(@@) % ولقد علمت لدن لجحتم أنه % ما بعد ذاك العرس إلا المأتم % 49(@)(@@) % علما طلبت رسومه فوجدتها % % في الظن ، إن الألمعي منجم % 50(@)(@@) % ما زلت أعرف وبله من عارض % لما رأيتسماءه تتغيم % PageV01P208 51(@)(@@) % يا مال قد علمت نزار كلها % % ما كان مثلك في الأراقم أرقم % 52(@)(@@) % طالت يدي لما رأيتك سالما % وانحت عن خدي ذاك العظلم % 53(@)(@@) % وشممت ترب الرحبة العبق الثرى % % وسقى صداي البحر فيها الخضرم % 54(@)(@@) % كم حل في أكنافها من معدم % أمسى به يأوي إليه المعدم % 55(@)(@@) % وصنيعة لك قد كتمت جزيلها % % فأبى تضوعها الذي لا يكتم % 56(@)(@@) % مجد تلوح فضوله وفضيلة % لك سافر والحق لا يتلثم % 57(@)(@@) % تتكلف الجلى ومن أضحى له % % بيتاك في جشم فلا يتجشم % 58(@)(@@) % وتشرف العليا وهل بك مذهب % عنها وأنت على المكارم قيم ؟ ! % 59(@)(@@) % أثنيت إذ كان الثناء حبالة % شركا يصاد به الكريم المنعم % 60(@)(@@) % ووفيت إن من الوفاء تجارة % وشكرت إن الشكر حرت مطعم % PageV01P209 البحر : وافر تام 1(@)(@@) % لعلك ذاكر الطلل القديم % و موف بالعهود 
ms66	 على الرسوم % % 2(@)(@@) % وواصف ناقة تذر المهارى % % موكلة بوخد أو رسيم % 3(@)(@@) % و قد أممت بيت الله نضوا % على عيرانة حرف سعوم % 4(@)(@@) % أتيت القادسية وهي ترنو % % الي بعين شيطان رجيم % 5(@)(@@) % فما بلغت بنا عسفان حتى % % رنت بلحاظ لقمان الحكيم % 6(@)(@@) % و بدلها السى بالجهل حلما % وقد أديمها قد الأديم % 7(@)(@@) % أذاب سنامها قطع الفيافي % % ومزق جلدها نضج العصيم % 8(@)(@@) % طواها طيها الموماة وخدا % إلى أجبال مكة والحطيم % 9(@)(@@) % رمت خطواتها ببني خطايا % % مواشكة إلى رب كريم % 10(@)(@@) % بكل بعيدة الأرجاء تيه % كأن أوارها وهج الجحيم % PageV01P210 11(@)(@@) % أقول بها وقد أوحت بعين % % إلي تشكي الدنف السقيم % 12(@)(@@) % بكورك أشعر الثقلين طرا % و أوفى الناس في حسب صميم % 13(@)(@@) % لمالك تشتكين وأنت تحتي % % وتحت محمد بدر النجوم ؟ % 14(@)(@@) % متى أظمتك هاجرة فشيمي % % أنامله تروك بالنسيم % 15(@)(@@) % و إنغشيتك ظلماء فجلي % % بغرته دجى الليل البهيم % 16(@)(@@) % فمرت مثلما يمشي شهيد % سويا إلى صراط مستقيم % 17(@)(@@) % ولولا الله يوم منى لأبدت % هواها كل ذات حشا هضيم % 18(@)(@@) % رمين أخا اغتراب واكتئاب % بعيني جؤذر وبجيد ريم % PageV01P211 البحر : طويل 1(@)(@@) % أقول لمرتاد الندى عند مالك % تعوذ بجدوى مالك وصلاته % 2(@)(@@) % فتى جعل المعروف من دون عرضه % سريعا إلى الممتاح قبل عداته % 3(@)(@@) % ولو قصرت أمواله عن سماحه % لقاسم من يرجوه شطر حياته % % 4(@)(@@) % وإن لم يجد في قسمة العمر حيلة % وجاز له الإعطاء من حسناته % 5(@)(@@) % لجاد بها غير كفر بربه % وآساهم من صومه وصلاته % PageV01P212 البحر : كامل تام 1(@)(@@) % ما للدموع تروم كل مرام % والجفن ثاكل هجعة ومنام ! % 2(@)(@@) % يا حفرة المعصوم تربك مودع % ماء الحياة وقاتل الإعدام % 3(@)(@@) % إن الصفائح منك قد نضدت على % % ملقى عظام لو علمت عظام ! % 4(@)(@@) % فتق المدامع أن لحدك حله % % سكن الزمان وممسك الأيام % 5(@)(@@) % ومصرف الملك الجموح كأنه % قد زم مصعبه له بزمام % 6(@)(@@) % هدمت صروف الموت أرفع حائط % ضربت دعائمه على الإسلام % 7(@)(@@) % دخلت على ملك الملوك رواقه % وتشزنت لمقوم القوام % 8(@)(@@) % مفتاح كل مدينة قد 
ms67	 أبهمت % غلقا ومخلي كل دار مقام % 9(@)(@@) % ومعرف الخلفاء أن حظوظها % % في حيز الإسراج والإلجام % 10(@)(@@) % أخذ الخلافة عن أسنته التي % % منعت حمى الآباء والأعمام % PageV01P213 11(@)(@@) % فلسورة الأنفال في ميراثه % آثارها ولسورة الأنعام % 12(@)(@@) % ما دام هارون الخليفة فالهدى % % في غبطة موصولة بداوم % 13(@)(@@) % إنا رحلنا واثقين بواثق % بالله شمس ضحى وبدر تمام % 14(@)(@@) % لله أي حياة انبعثت لنا % % يوم الخميس وبعد أي حمام ! % 15(@)(@@) % أودى بخير إمام اضطربت به % شعب الرجال وقام خير إمام % 16(@)(@@) % تلك الرزية لا رزية مثلها % % والقسم ليس كسائر الأقسام % 18(@)(@@) % أو ي فتقد ذو النون في الهيجا فقد % دفع الإله لنا عن الصمصام % 19(@)(@@) % أو جب منا غارب غدوا فقد % رحنا بأتمك ذروة وسنام % % 20(@)(@@) % هل غير بؤسى ساعة ألبستها % % بنداك ما لبست من الإنعام ! % 21(@)(@@) % نقض كرجع الطرف قد أبرمته % % يا ابن الخلائف أيما إبرام % PageV01P214 22(@)(@@) % ما إن رأى الأقوام شمسا قبلها % % أفلت فلم تعقبهم بظلام % 23(@)(@@) % أكرم بيومهم الذي ملكتهم % في صدره وبعامهم من عام % 24(@)(@@) % لو لم يكن بدعا لقد نصبوا له % % سمة يبين بها من الأعوام % 25(@)(@@) % لغدوا وذاك الحول حول عبادة % فيهم وذاك الشهر شهر صيام % 26(@)(@@) % لما دعوتهم لأخذ عهودهم % طار السرور بمعرق وشآم % 27(@)(@@) % فكان هذا قادم من غيبة % وكأن ذاك مبشر بغلام % 29(@)(@@) % قسمت أمير المؤمنين قلوبهم % بين المحبة فيك والإعظام % 30(@)(@@) % شرحت بدولتك الصدور وأصبحت % خشع العيون إليك وهي سوام % % 31(@)(@@) % ما أحسب القمر المنير إذا بدا % % بدرا بأضوأ منك في الأوهام % 32(@)(@@) % هي بيعة الرضوان يشرع وسطها % % باب السلامة فادخلوا بسلام % PageV01P215 33(@)(@@) % والمركب المنجي فمن يعدل به % يركب جموحا غير ذات لجام % 34(@)(@@) % يتبع هواه ولا لقاح لرهطه % بسل وليست أرضه بحرام % 35(@)(@@) % وعبادة الأهواء في تطويحها % % بالدين فوق عبادة الأصنام % 36(@)(@@) % إن الخلافة أصبحت حجراتها % % ضربت على ضخم الهموم همام % 37(@)(@@) % ملك يرى الدنيا بأيسر لحظة % ويرى التقى رحما من الأرحام % 38(@)(@@) % لا قدح في عود الإمامة بعدما % % متت إليك بحرمة وذمام % 39 
ms68	(@)(@@) % هيهات تلك قلادة الله التي % % ماكان يتركها بغير نظام % 40(@)(@@) % إرث النبي وجمرة الملك التي % % لم تخل من لهب بكم وضرام % 41(@)(@@) % مذخورة أحرزتها بحكومة % لله تعلو أرؤس الحكام % 42(@)(@@) % لسنا مريدي حجة نشفي بها % % من ريبة سقما من الأسقام % PageV01P216 43(@)(@@) % والصبر بالأرواح يعرف فضله % من غيره ابتغيت ولا أعلام % 44(@)(@@) % فأقم مخالفنا بكل مقوم % واحسم مغاندنا بكل حسام % 47(@)(@@) % % صبر الملوك وليس بالاجسام % 48(@)(@@) % لا تدهنوا في حكمه فالبحر قد % تردي غواربه وليس بطام % 49(@)(@@) % يابن الكواكب من أئمة هاشم % والرجح الأحساب والأحلام % 50(@)(@@) % أهدى إليك الشعر كل مفهه % خطل وسدد فيك كل عبام % 51(@)(@@) % غرض المديح تقاربت آفاقه % % ورمى فقرطس فيه غير الرامي % % PageV01P217 البحر : وافر تام 1(@)(@@) % صريع هوى تغاديه الهموم % بنيسابور ليس له حميم % 2(@)(@@) % غريب ليس يؤنسه قريب % ولا يأوي لغربته رحيم % 3(@)(@@) % مقيم في الديار نوى شطون % يشافهه بها كمد مقيم % 4(@)(@@) % يمد زمامه طمع مقيم % تدرع ثوبه رجل عديم % 5(@)(@@) % رجاء ما يقابله رجاء % هو اليأس الذي عقباه شوم % 6(@)(@@) % فلا عجب وإن كانت ركابي % % بأرض طار طائرها المشوم % 7(@)(@@) % فقد فارقت بالغربي دارا % بأرض الشام حف بها النعيم % 8(@)(@@) % وكنت بها الممنع غير وغد % % و لا نكد اذا حل العظيم % 9(@)(@@) % فإن أك حللت بدار هون % صبوت بها فقد يصبو الحليم % 10(@)(@@) % ألومك لا ألوم سؤاك دهرا % قضى لي بالذي يقضي سدوم % PageV01P218 11(@)(@@) % إذا أنا لم ألم عثرات دهر % أصبت بها الغداة فمن ألوم % 12(@)(@@) % و في الدنيا غنى لم أنب عنه % ولكن ليس في الدنيا كريم ! % PageV01P219 البحر : كامل تام 1(@)(@@) % قف بالطلول الدارسات علاثا % % أمست حبال قطينهن رثاثا % % 2(@)(@@) % قسم الزمان ربوعها بين الصبا % % وقبولها ودبورها أثلاثا % % 3(@)(@@) % فتأبدت من كل مخطفة الحشا % % غيداء تكسى يارقا ورعاثا % % 4(@)(@@) % كالظبية الأدماء صافت فارتعت % زهر العرار الغض والجثجاثا % % 5(@)(@@) % حتى إذا ضرب الخريف رواقه % سافت برير أراكة وكباثا % % 6(@)(@@) % سيافة اللحظات يغدو طرفها % % بالسحر في عقد في عقد النهى نفاثا % % 7(@)(@@) % زالت بعينيك الحمول 
ms69	 كأنها % % نخل مواقر من نخيل جواثا % % 8(@)(@@) % يوم الثلاثا لن أزال لبينهم % كدر الفؤاد لكل يوم ثلاثا % % 9(@)(@@) % إن الهموم الطارقاتك موهنا % منعت جفونك أن تذوق حثاثا % % 10(@)(@@) % ورأيت ضيف لهم لا يرضى قرى % إلا مداخلة الفقار دلاثا % % PageV01P220 11(@)(@@) % شجعاء جرتها الذميل تلوكه % أصلا إذا راح المطي غراثا % % 12(@)(@@) % أجدا إذا ونت المهارى أرقلت % رقلا كتحريق الغضا حثحاثا % % 13(@)(@@) % طلبت فتى جشم بن بكر مالكا % ضرغامها وهزبرها الدلهاثا % % 14(@)(@@) % ملك إذا استسقيت مزن بنانه % قتل الصدى وإذا استغيث أغاثا % % 15(@)(@@) % قد جربته تغلب ابنة وائل % لاخاترا غدرا ولا نكاثا % % 16(@)(@@) % مثل السبيكة ليس عن أعراضها % % بالغيب لا ندسا ولا بحاثا % % 17(@)(@@) % ضرح القذى عنها وشذب سيفه % عن عيصها الخراب والخباثا % % 18(@)(@@) % ضاحي المحيا للهجير وللقنا % % تحت العجاج تخاله محراثا % % 19(@)(@@) % هم مزقوا عنه سبائب حلمه % وإذا أبو الأشبال أحرج عاثا % % 20(@)(@@) % لولا القرابة جاسهم بوقائع % تنسي الكلاب وملهما وبعاثا % % PageV01P221 21(@)(@@) % بالخيل فوق متونهن فوارس % مثل الصقور إذا لقين بغاثا % % 22(@)(@@) % لكن قراكم صفحه من لم يزل % وأبوه فيكم رحمة وغياثا % % 23(@)(@@) % عف الإزار تنال جارة بيته % أرفاده وتجنب الأرفاثا % % 24(@)(@@) % عمرو بن كلثوم بن مالك الذي % % ترك العلى لبني أبيه تراثا % % 25(@)(@@) % وزعوا الزمان وهم كهول جلة % وسطوا على أحداثه أحداثا % % 26(@)(@@) % ألقى عليه نجاره فأتى به % يقظان لا ورعا ولاملتاثا % % 27(@)(@@) % تزكو مواعده إذا وعد امرىء % أنساك أحلام الكرى الأضغاثا % % 28(@)(@@) % وترى تسحبنا عليه كأنما % % جئناه نطلب عنده ميراثا % % 29(@)(@@) % كم مسهل بك لو عدتك قلاصه % تبغي سواك لأوعثت إيعاثا % % 30(@)(@@) % خولته عيشا أغن وجاملا % دثرا ومالا صامتا وأثاثا % % PageV01P222 31(@)(@@) % يا مالك ابن المالكين أرى الذي % % كنا نؤمل من إيابك راثا % % 32(@)(@@) % لولا اعتمادك كنت ذا مندوحة % عن برقعيد وأرض باعيناثا % % 33(@)(@@) % والكامخية لم تكن لي منزلا % فمقابر اللذات من قبراثا % % 34(@)(@@) % لم آتها من أي وجه جئتها % % إلا حسبت بيوتها أجداثا % % 35(@)(@@) % بلد الفلاحة لو أتاها جرول % أعني الحطيئة لاعتدى حراثا % % 36(@)(@@) % تصدا بها الأفهام بعد صقالها % % وترد 
ms70	 ذكران العقول إناثا % % 37(@)(@@) % أرض خلعت اللهو خلعي خاتمي % % فيها وطلقت السرور ثلاثا % % PageV01P223 البحر : خفيف تام 1(@)(@@) % أنا في ذمة الكريم سليما % % ن السليم الهوى الرئيف المهام % 2(@)(@@) % نطت همي منه بهمة قوم % ثقلت وطأتي على الأيام % 3(@)(@@) % بحسام اللسان والرأي أمضى % % حين ينضى من الجراز الحسام % 4(@)(@@) % ماجد أفرطت عنايته حت % % تى توهمت أنها في المنام % 5(@)(@@) % ما تواجهت نحو أفق من الآ % % فاق إلا وجدتها من أمامي % % 6(@)(@@) % كل يوم ترى نوال أبي نص % % 7(@)(@@) % لم أزل في دمامه المعظم المك % % رم حتى ظننته في ذمامي % % 8(@)(@@) % يا سليمان ترف الله أرضا % أنت فيها بمستهل الغمام % 9(@)(@@) % ولعمري لقد كفيت لك الدع % % وة إذ كنت شاتيا بالشآم % 10(@)(@@) % أنا ثاو بحمص في كل ضرب % من ضروب الإكثار والإفحام % PageV01P224 11(@)(@@) % كل فدم أخاف حين أراه % مقبلا أن يشجني بالسلام % 12(@)(@@) % رافعا كفه لبري فلا أح % سبه جاءني لغير اللطام % 13(@)(@@) % فبحقي إلا خصصت أبا الطي % يب عني بطيب من سلامي % % 14(@)(@@) % وثنائي من قبل هذا ومن بع % د وشكري غض لعبد السلام % PageV01P225 البحر : كامل تام 1(@)(@@) % يوم الفراق لقد خلقت عظيما % % و تركت جسمي لا سقمت سقيما % % 2(@)(@@) % ما للفراق تفرقت أعضاؤه % ما زال يعصف باللقاء قديما ! % 3(@)(@@) % ما زلت بعدك يا أخي في حسرة % و تلدد حتى أراك سليما % % 4(@)(@@) % اقر السلام عليك مني كلما % % جرت الرياح فانشقتك نسيما % % PageV01P226 البحر : مخلع البسيط 1(@)(@@) % صرف النوى ليس بالمكيث % ينبث ما ليس بالنبيث % 2(@)(@@) % هبت لأحبابنا رياح % غير سواه ولا ريوث % 3(@)(@@) % بدور ليل التمام حسنا % عين حقوف ، ظباء ميث % 4(@)(@@) % بين الخلاخيل والأساوي % % ر والدماليج والرعوث % 5(@)(@@) % من كل رعبوبة تردى % % بثوب فينانها الأثيث % 6(@)(@@) % كالرشإ العوهج اطباه % روع إلى مغزل رغوث % 7(@)(@@) % رعت جنابي عويرضات % من خزمات ومن شثوث % 8(@)(@@) % ولاحب مشكل النواحي % % منخرق السهل والوعوث % 9(@)(@@) % لم تزجر العيس في قراه % مذ عصر نوح وعصر شيث % 10(@)(@@) % كأن صوت النعام فيه % % إذا دعا صوت مستغيث % PageV01P227 11(@)(@@) % قلصته 
ms71	 بالقلاص تهوي % % بالوخد من سيرها الحثيث % 12(@)(@@) % من كل صلب القرا معوج % وكل عيرانة دلوث % 13(@)(@@) % ذي ميعة مشيه الدفقى % % وذات لوث بها ملوث % 14(@)(@@) % يطلبن من عقد وعد موسى % % غير سحيل ولانكيث % 15(@)(@@) % بنان موسى إذا استهلت % % للناس نابت عن الغيوث % 16(@)(@@) % حيث الندى والسدى جميعا % وملجأ الخائف الكريث % 17(@)(@@) % حيث لبون النوال تهمي % % غير شطور ولا ثلوث % 18(@)(@@) % والمجد من تالد قديم % ثم ومن طارف حديث % 19(@)(@@) % إن تستبثه تجد عراما % من مستباث لمستبيث % 20(@)(@@) % وحية أفعوان لصب % يعيث في مهجة العيوث % PageV01P228 21(@)(@@) % تغدو المنايا مسخرات % وقفا على سمه النفيث % 22(@)(@@) % وصارم الشفرتين عضبا % غير ددان ولا أنيث % 23(@)(@@) % ليثا ولكنه حمام % صب انتقاما على الليوث % 24(@)(@@) % أنكد بأري النوال ما لم % يحل من العشب والجثوث % 25(@)(@@) % ما الجود بالجود أو تراه % ليس بنزر ولا لبيث % 26(@)(@@) % طال المدى فاعتراك عتب % من صادق الود مستريث % 27(@)(@@) % خذها فما نالها بنقص % موت جرير ولا البعيث % 28(@)(@@) % وكن كريما تجد كريما % في مدحه يا أبا المغيث % PageV01P229 البحر : كامل تام 1(@)(@@) % أزعمت أن الربع ليس يتيم % والدمع في دمن عفت لا يسجم ! % 2(@)(@@) % يا موسم اللذات غالتك النوى % % بعدي فربعك للصبابة موسم ! % 3(@)(@@) % ولقد أراك من الكواعب كاسيا % فاليوم أنت من الكواعب محرم % 4(@)(@@) % لحظت بشاشتك الحوادث لحظة % مازلت أحلم أنها لا تسلم % 5(@)(@@) % أين التي كانت إذا شاءت جرى % % من مقلتي دمع يعصفره دم % 6(@)(@@) % بيضاء تسري في الظلام فيكتسي % % نورا وتسرب في الضياء فيظلم % 7(@)(@@) % يستعذب المقدام فيها حتفه % فتراه وهو المستميت المعلم % 8(@)(@@) % مقسومة في الحسن بل هي غاية % فالحسن فيها والجمال مقسم % 9(@)(@@) % ملطومة بالورد أطلق طرفها % % في الخلق فهو مع المنون محكم % 10(@)(@@) % مذلت ولم تكتم جفاءك تكتم % إن الذي يمق المذول لمعرم % PageV01P230 11(@)(@@) % إن كان وصلك آض وهو محرم % منك الغداة فما السلو محرم % 12(@)(@@) % عزم يفل الجيش وهو عرمرم % ويرد ظفر الشوق وهو مقلم % 13(@)(@@) % وفتى إذا ظلم الزمان فما يرى % % إلا إلى عزماته 
ms72	 يتظلم ! % 14(@)(@@) % لولا ابن حسان المرجى لم يكن % بالرقة البيضاء لي متلوم % 15(@)(@@) % شافهت أسباب الغنى بمحمد % حتى ظننت بأنها تتكلم % 16(@)(@@) % قد تيمت منه القوافي بامرئ % مازال بالمعروف وهو متيم % 17(@)(@@) % يحلو ويعذب إن زمان ناله % بغنى وتلتاث الخطوب فيكرم % 18(@)(@@) % تلقاه إن طرق الزمان بمغرم % شرها إليه كأنما هو مغنم % 19(@)(@@) % لا يحسب الإقلال عدما بل يرى % % أن المقل من المروءة معدم % 20(@)(@@) % مازال وهو إذا الرجال تواضحوا % % عند المقدم حيث كان يقدم % PageV01P231 21(@)(@@) % يحتل في سعد بن ضبة في ذرا % % عادية قد كللتها الأنجم % 22(@)(@@) % قوم يمج دما على أرماحهم % يوم الوغى المستبسل المستلئم % 23(@)(@@) % يعلون حتى ما يشك عدوهم % % أن المنايا الحمر حي منهم % 24(@)(@@) % لو كان في الدنيا قبيل آخر % بإزائهم ماكان فيهم مصرم % 25(@)(@@) % ولأنت أوضح فيهم من غرة % شدخت وفاز بها الجواد الأدهم % 26(@)(@@) % تجري على آثارهم في مسلك % ماإن له إلا المكارم معلم % 27(@)(@@) % لم ينا عني مطلب ومحمد % عون عليه أو إليه سلم % 28(@)(@@) % لم يذعر الأيام عنك كمرتد % بالعقل يفهم عن أخيه ويفهم % 29(@)(@@) % ممن إذا ما الشعر صافح سمعه % % يوما رأيت ضميره يتبسم % PageV01P232 البحر : كامل تام 1(@)(@@) % هذا كتاب فتى له همم % ساقت إليك رجاءه هممه % 2(@)(@@) % غل الزمان يدي عزيمته % وهوت به من حالق قدمه % 3(@)(@@) % و تواكلته ذوو قرابته % وطواه عن أكفائه عدمه % 4(@)(@@) % افضى إليك بسره قلم % لو كان يعقله بكى قلمه % PageV01P233 البحر : بسيط تام 1(@)(@@) % أبا سعيد وما وصفي بمتهم % على الثناء ولا شكري بمخترم % 2(@)(@@) % لئن جحدتك ما أوليت من حسن % إن لفي اللؤم أولى منك في الكرم % 3(@)(@@) % أنسى ابتسامك والألوان كاسفة % تبسم الصبح في داج من الظلم % 4(@)(@@) % كذا أخوك الندى لو أنه بشر % لم يلف طرفة عين غير مبتسم % 5(@)(@@) % رددت رونق وجهي في صحيفته % رد الصقال بماء الصارم الخذم % 6(@)(@@) % وما أبالي وخير القول أصدقه % حقنت لي ماء وجهي أو حقنت دمي % % PageV01P234 البحر : بسيط تام 1(@)(@@) % قل للأمير لقد قلدتني 
ms73	 نعما % فت الثناء بها ماهبت الريح % 2(@)(@@) % يا مانحي الجاه إذ ضن الجواد به % شكريك ما عشت للأسماع ممنوح % 3(@)(@@) % لم يلبس الله نوحا فضل نعمته % إلا لما بثه من شكره نوح % 4(@)(@@) % ذمت سماحته الدنيا إليه ، فما % % يمسي ويصبح إلا وهو ممدوح % 5(@)(@@) % وللأمور إذا الآراء ضقن بها % % يوم التجادل من آرائه فيح % 6(@)(@@) % لم يغلق الله باب العرف عن أحد % باب الأمير له المألوف مفتوح % 7(@)(@@) % لن يعدم المجد من كانت أوائله % من آل كسرى البهاليل المراجيح % 8(@)(@@) % موري الفؤاد ، فلو كانت بعزمته % تذكى المصابيح لم تخب المصابيح % 9(@)(@@) % كأنه لاجتماع الروح فيه له % من كل جارحة في جسمه روح % PageV01P235 البحر : طويل 1(@)(@@) % متى كان سمعي خلسة للوائم % وكيف صغت للعاذلات عزائمي ؟ ! % 2(@)(@@) % إذا المرء أبقى بين رأييه ثلمة % تسد بتعنيف فليس بحازم % 3(@)(@@) % سأوطئ أهل العسكر الآن عسكرا % من الذل محاء لتلك المعالم % 4(@)(@@) % فإني ما حوزفت في طلب العلى % % ولكنكم حورفتم في المكارم % 5(@)(@@) % رويدا يقر الأمر في مستقره % فما المجد عما تفعلون بنائم % 6(@)(@@) % ومالي من ذنب إلى الرزق خلته % سوى أملي إياكم للعظائم % 7(@)(@@) % بعين العلى أصبحتم بين هادم % دعائمها الطولى وبان كهادم % 8(@)(@@) % لعمر النوى لا زلت بعد محمد % مسحا عليه بالدموع السواجم % 9(@)(@@) % فتى فيصلي العزم يعلم أنه % نشا رأيه بين السيوف الصوارم % 10(@)(@@) % إذا سار فيه الظن كان بكل ما % % يؤمل من جدواه أول قادم % PageV01P236 11(@)(@@) % أسأءت يداه عشرة المال بالندى % % وأحسنتا فينا خلافة حاتم % PageV01P237 البحر : خفيف تام 1(@)(@@) % إن عهدا لو تعلمان ذميما % % أن تناما عن ليلتي أو تنيما % % 2(@)(@@) % كنت أرعى البدور حتى إذا ما % % فارقوني أمسيت أرعى النجوما % % 3(@)(@@) % قد مررنا بالدار وهي خلاء % وبكينا طلولها والرسوما % % 4(@)(@@) % وسألنا ربوعها فانصرفنا % % بسقام وما سألنا حكيما % % 5(@)(@@) % أصبحت روضة الشباب هشيما % وغدت ريحه البليل سموما % % 6(@)(@@) % شعلة في المفارق استودعتني % % في صميم الفؤاد ثكلا صميما % % 7(@)(@@) % تستثير الهموم ما اكتن منها % % صعدا وهي تستثير الهموما % % 8(@)(@@) % غرة بهمة ألا 
ms74	 إنما كن % ت أغرا أيام كنت بهيما % % 9(@)(@@) % دقة في الحياة تدعى جلالا % مثلما سمي اللديغ سليما % % 10(@)(@@) % حلمتني زعمتم وأراني % % قبل هذا التحليم كنت حليما % % PageV01P238 11(@)(@@) % من رأى بارقا سرى صامتيا % جاد نجدا سهولها والحزوما ؟ % 12(@)(@@) % يوسفيا محمديا حفيا % بذليل الثرى رؤوفا رحيما % % 13(@)(@@) % فسقى طيئا وكلبا ودودا % % ن وقيسا ووائلا وتميما % % 14(@)(@@) % لن ينال العلى خصوصا من الفت % يان من لم يكن نداه عموما % % 15(@)(@@) % نشأت من يمينه نفخات % ماعليها ألا تكون عيوما % % 16(@)(@@) % ألبست نجدا الصنائع لا شي % % حا ولا جنبة ولا قيصوما % % 17(@)(@@) % كرمت راحتاه في أزمات % كان صوب الغمام فيها لئيما % % 18(@)(@@) % لا رزيناه ما ألذ إذا هز % وأندى كفا وأكرم خيما ! % 19(@)(@@) % وجه العيس وهي عيس إلى الله % % فآلت مثل القسي حطيما % % 20(@)(@@) % وأحق الأقوام أن يقضي الدي % % ن امرؤ كان للإله غريما % % PageV01P239 21(@)(@@) % في طريق قد كان قبل شراكا % ثم لما علاه صار أديما % % 22(@)(@@) % لم يحدث نفسا بمكة حتى % % جازت الكهف خيله والرقيما % % 23(@)(@@) % حرم الدين زاره بعد أن لم % يبق للكفر والضلال حريما % % 24(@)(@@) % حين عفى مقام إبليس سامى % % بالمطايا مقام إبراهيما % % 25(@)(@@) % حطم الشرك حطمة ذكرته % في دجى الليل زمزما والحطيما % % 26(@)(@@) % فاض فيض الآتي حتى غدا المو % سم من فضل سيبه موسوما % % 27(@)(@@) % قد بلونا أبا سعيد حديثا % وبلونا أبا سعيد قديما % % 28(@)(@@) % ووردناه ساحلا وقليبا % ورعيناه بارضا وجميما % % 29(@)(@@) % فعلمنا أن ليس إلا بشق الن % فس صار الكريم يدعى كريما % % 30(@)(@@) % طلب المجد يورث المرء خبلا % وهموما تقضقض الحيزوما % % PageV01P240 31(@)(@@) % فتراه وهو الخلي شجيا % وتراه وهو الصحيح سقيما % % 32(@)(@@) % تجد المجد في البرية منثو % % را وتلقاه عنده منظوما % % 33(@)(@@) % تيمته العلى فليس يعد ال % % بؤس بؤسا ولا النعيم نعيما % % 34(@)(@@) % وتؤام الندى يري الكرم الفا % % رد في أكثر المواطن لوما % % 35(@)(@@) % كلما زرته وجدت لديه % نسبا ظاعنا ومجدا مقيما % % 36(@)(@@) % أجدر الناس أن يرى وهو مغبو % % ن وهيهات أن يرى مظلوما % % 37(@)(@@) % كل حال تلقاه فيها ولكن % ليس 
ms75	 يلقى في حالة مذموما % % 38(@)(@@) % وإذا كان عارض الموت سحا % خضلا بالردى أجش هزيما % % 39(@)(@@) % في ضرام من الوغى واشتعال % تحسب الجو منهما مهموما % % 40(@)(@@) % واكتست ضمر الجياد المذاكي % % من لباس الهيجا دما وحميما % % PageV01P241 41(@)(@@) % في مكر تلوكها الحرب فيه % وهي مقورة تلوك الشكيما % % 42(@)(@@) % قمت فيها بحجة الله لما % % أن جعلت السيوف عنك خصوما % % 43(@)(@@) % فتح الله في اللواء لك الخا % % فق يوم الاثنين فتحا عظيما % % 44(@)(@@) % حومته ريح الجنوب ولن يح % مد صيد الشاهين حتى يحوما % % 45(@)(@@) % في غداة مهضوبة كان فيها % % ناضر الروض للسحاب نديما % % 46(@)(@@) % لينت مزنها فكانت رهاما % وسجت ريحها فكانت نسيما % % 47(@)(@@) % نعمة الله فيك لا أسأل الل % % ه إليها نعمى سوى أن تدوما % % 48(@)(@@) % ولو أني فعلت كنت كمن يس % % أله وهو قائم أن يقوما % % PageV01P242 البحر : بسيط تام 1(@)(@@) % أهد الدموع إلى دار وما صحها % % فللمنازل سهم في سوافحها % % 2(@)(@@) % أشلى الزمان عليها كل حادثة % وفرقة تظلم الدنيا لنازحها % % 3(@)(@@) % حلفت حقا ، لقد قلت ملاحتها % % بمن تخرم عنها من ملائحها % % 4(@)(@@) % إن تبرحا وتباريحي على كبد % ما تستقر ، فدمعي غير بارحها % % 5(@)(@@) % دار أجل الهوى عن أن ألم بها % % في الركب إلا وعيني من منائحها % % 6(@)(@@) % إذا وصفت لنفسي هجرها جمحت % ودائع الشوق في أقصى جوانحها % % 7(@)(@@) % وإن خطبت إليها صبرها جعلت % جراحة الوجد تدمى في جوارحها % % 8(@)(@@) % ما للفيافي وتلك العيس قد خزمت % فلم تظلم إليها من صحاصحها ؟ % 9(@)(@@) % فتل إذا ابتكر الغادي على أمل % خلفنه يزجر الحسرى برائحها % % 10(@)(@@) % تصغي إلى الحدو إصغاء القيان إلى % % نغم إذا استغربته من مطارحها % % PageV01P243 11(@)(@@) % حتى تؤوب كأن الطلح معترض % بشوكه في المآقي من طلائحها % % 12(@)(@@) % إلى الأكارم أفعالا ومنتسبا % لم يرتع الذم ، يوما ، في طوائحها % % 13(@)(@@) % آساس مكة والدنيا بعذرتها % % لم ينزل الشيب في مثنى مسائحها % % 14(@)(@@) % قوم هم أمنوا قبل الحمام بها % % من بين ساجعها الباكي ونائحها % % 15(@)(@@) % كانوا الجبال لها قبل الجبال وهم % سالوا ولم يك سيل في أباطحها % % 16(@)(@@) % والفضل إن 
ms76	 شمل الإظلام ساحتها % % مصباحها المتجلي من مصابحها % % 17(@)(@@) % من خيرها مغرسا فيها ووسعها % % شعبا تحط إليه عير مادحها % % 18(@)(@@) % لا تفت تزجي فتي العيس ساهمة % إلى فتى سنها منها وقارحها % % 19(@)(@@) % حتى تناول تلك القوس باريها % % حقا وتلقي زنادا عند قادحها % % 20(@)(@@) % كأن صاعقة في جوف بارقة % زئيره واغلا في أذن نابحها % % PageV01P244 21(@)(@@) % سنان موت ذعاف من أسنتها % % صفيح تتحامى من صفائحها % % 22(@)(@@) % ذر تدرإ وإباء في الأمور وهل % جواهر الطير إلا في جوارحها ! % 23(@)(@@) % هشما لأنف المسامي حينه فسما % % لهاشم ، فضلها فيها ابن صالحها % % 24(@)(@@) % ياحاسد الفضل لا أعرفك محتشدا % لغمرة أنت عندي غير سابحها % % 25(@)(@@) % لكوكب نازح من كف لامسه % وصخرة وسمها في قرن ناطحها % % 26(@)(@@) % ولاتقل إننا من نبعة فلقد % بانت نجائب إبل من نواضحها % % 27(@)(@@) % سميدع يتغطى من صنائعه % % كما تغطى رجال من فضائحها % % 28(@)(@@) % وفارة المسك لا يخفي تضوعها % % طول الحجاب ولا يزري بفائحها % % 29(@)(@@) % لله درك في الخود التي طمحت % ما كان أرقاك يا هذا لطامحها % % 30(@)(@@) % نقية الجيب لا ليل بمدخلها % % في باب عيب ولاصبح بفاضحها % % PageV01P245 31(@)(@@) % أخذتها لبوة العريس ملبدة % في الغاب والنجم أدنى من مناكحها % % 32(@)(@@) % لو أن غير أبي الأشبال صافحها % % شكت بمخلبها كفي مصافحها % % 33(@)(@@) % جاءت بصقرين غطريفين لو وزنا % % بهضب رضوى إذا مالا براجحها % % 34(@)(@@) % بهاشميين بدريين إن لحجت % مغالق الدهر كانا من مفاتحها % % 35(@)(@@) % نصلان قد أثبتا في قلب شائنها % % نارين أوقدتا في كشح كاشحها % % 36(@)(@@) % وكذب الله أقولا قرنت بها % % بحجة تسرج الدنيا بواضحها % % 37(@)(@@) % مضيئة نطقت فينا كما نطقت % ذبيحة المصطفى موسى لذابحها % % 38(@)(@@) % لئن قلبيك جاشت بالسماحة لي % % لقد وصلت بشكري حبل ماتحها % % 39(@)(@@) % وقد رأتني قريش ساحبا رسني % % إليك عن طلقها وجها وكالحها % % 40(@)(@@) % إذا القصائد كانت من مدائحهم % فأنت لاشك عندي من مدائحها % % PageV01P246 41(@)(@@) % وإن غرائبها أجدبن من بلد % كانت عطاياك أندى من مسارحها % % PageV01P247 البحر : طويل 1(@)(@@) % عسى وطن يدنو بهم ولعلما % % وأن تعتب الأيام فيهم فربما % % 2(@)(@@) % لهم منزل قد كان 
ms77	 بالبيض كالمها % % فصيح المغاني ثم أصبح أعجما % % 3(@)(@@) % ورد عيون الناظرين مهانة % وقد كان مما يرجع الطرف مكرما % % 4(@)(@@) % تبدل غاشيه بريم مسلم % تردى رداء الحسن طيفا مسلما % % 5(@)(@@) % ومن وشي خد لم ينمنم فرنده % % معالم يذكرن الكتاب المنمنا % % 6(@)(@@) % وبالحلي إن قامت ترنم فوقها % % حماما إذا لاقى حماما ترنما % % 7(@)(@@) % وبالخدلة الساق المخدمة الشوى % % قلائص يتبعن العبنى المخدما % % 8(@)(@@) % سوار إذا قاتلن ممتنع الفلا % % جعلن الشعارين الجديل وشدقما % % 9(@)(@@) % إلى حائط الثغر الذي يورد القنا % % من الثغرة الريا القليب المهدما % % 10(@)(@@) % بسابغ معروف الأمير محمد % حدا هجمات المال من كان مصرما % % PageV01P248 11(@)(@@) % وحط الندى في الصامتين رحله % % وكان زمانا في عدي بن أخزما % % 12(@)(@@) % يرى العلقم المأدوم بالعز أرية % يمانية والأري بالضيم علقما % % 13(@)(@@) % إذا فرشوه النصف ماتت شذاته % % وإن رتعوا في ظلمه كان أظلما % % 14(@)(@@) % لقد أصبح الثغران في الدين بعدما % % رأوا سرعان الذل فذا وتوءما % % 15(@)(@@) % وكنت لناشيهم أبا ولكهلهم % % أخا ولذي التقويس والكبرة آبنما % % 16(@)(@@) % ومن كان بالبيض الكواعب مغرما % فما زلت بالبيض القواضب مغرما % % 17(@)(@@) % ومن تيمت سمر الحسان وأدمها % % فما زلت بالسمر العوالي متيما % % 18(@)(@@) % جدعت لهم أنف الضلال بوقعة % تخرمت في غمائها من تخرما % % 19(@)(@@) % لئن كان أمسى في عقرقس أجدعا % % لمن قبل ما أمسى بميمذ أخرما % % 20(@)(@@) % ثلمتهم بالمشرفي وقلما % % تثلم عز القوم إلا تهدما % % PageV01P249 21(@)(@@) % قطعت بنان الكفر منهم بميمذ % وأتبعتها بالروم كفا ومعصما % % 22(@)(@@) % وكم جبل بالبذ منهم هددته % % وغاو غوى حلمته لو تحلما ! % 23(@)(@@) % ومقتبل حلت سيوفك رأسه % ثغاما ولولا وقعها كان عظلما % % 24(@)(@@) % فلما أبت أحكامه الشيبة اغتدى % % قناك لما قد ضيع الشيب محكما % % 25(@)(@@) % إذا كنت للألوى الأصم مقوما % فأورد وريديه الأصم المقوما % % 26(@)(@@) % ولما التقى البشران أنقع بشرنا % % لبشرهم حوضا من الصبر مفعما % % 27(@)(@@) % وساعده تحت البيات فوارس % تخالهم في فحمة الليل أنجما % % 28(@)(@@) % وقد نثرتهم روعة ثم أحدقوا % % به مثلما ألفت عقدا منظما % % 29(@)(@@) % بسافر حر الوجه لو رام سوءة % لكان بجلبات الدجى متلثما % % 30 
ms78	(@)(@@) % مثلت له تحت الظلام بصورة % على البعد أقنته الحياء فصمما % % PageV01P250 31(@)(@@) % كيوسف لما أن رأى أمر ربه % % وقد هم أن يعروري الذنب أحجما % % 32(@)(@@) % وقد قال إما أن أغادر بعدها % % عظيما وإما أن أغادر أعظما % % 33(@)(@@) % ونعم الصريخ المستجاش محمد % إذا حن نوء للمنايا وأرزما % % 34(@)(@@) % أشاح بفتيان الصباح فأكرهوا % % صدور القنا الخطي حتى تحطما % % 35(@)(@@) % هو افترع الفتح الذي سار معرقا % وأنجد في علو البلاد وأتهما % % 36(@)(@@) % له وقعة كانت سدى فأنرتها % % بأخرى وخير النصر ما كان ملحما % % 37(@)(@@) % هما طرفا الدهر الذي كان عهدنا % % باوله غفلا فقد صار معلما % % 38(@)(@@) % لقد أذكرانا بأس عمرو ومسهر % وما كان من إسفندياذ ورستما % % 39(@)(@@) % رأى الروم صبحا أنها هي إذ رأوا % % غداة التقى الزحفان انهما هما % % 40(@)(@@) % هزبرا غريف شد من أبهريهما % % ومتنيهما قرب المزعفر منهما % % PageV01P251 41(@)(@@) % فأعطيت يوما لو تمنيت مثله % % لأعجز ريعان المنى والتوهما % % 42(@)(@@) % لحقتهما في ساعة لو تأخرت % لقد زجر الإسلام طائر أشأما % % 43(@)(@@) % فلو صح قول الجعفرية في الذي % % تنص من الإلهام خلناك ملهما % % 44(@)(@@) % فإن يك نصرانيا النهر آلس % فقد وجدوا وادي عقرقس مسلما % % 45(@)(@@) % به سبتوا في السبت بالبيض والقنا % % سباتا ثووا منه إلى الحشر نوما % % 46(@)(@@) % فلو لم يقصر بالعروبة لم يزل % لنا عمر الأيام عيدا وموسما % % 47(@)(@@) % وما ذكر الدهر العبوس بأنه % % له ابن كيوم السبت إلا تبسما % % 48(@)(@@) % ولم يبق في أرض البقلار طائر % ولا سبع إلا وقد بات مولما % % 49(@)(@@) % ولا رفعوا في ذلك اليوم إثلبا % ولا حجرا إلا رأوا تحته دما % % 50(@)(@@) % رموا بابن حرب سل فيهم سيوفه % % فكانت لنا عرسا وللشرك مأتما % % PageV01P252 51(@)(@@) % أفظ بني حواء قلبا عليهم % ولم يقس منه القلب إلا ليرحما % % 52(@)(@@) % إذا أجرموا قنا القنا من دمائهم % % وإن لم يجد جرما عليهم تجرما % % 53(@)(@@) % هو الليث ليث الغاب بأسا ونجدة % وإن كان أحيا منه وجها وأكرما % % 54(@)(@@) % أشد ازدلافا بين درعين مقبلا % وأحسن وجها بين بردين محرما % % 55(@)(@@) % جدير إذا ما الخطب طال فلم 
ms79	 تنل % ذؤابته أن يجعل السيف سلما % % 56(@)(@@) % كريم إذا زرناه لم يقتصر بنا % % على الكرم المولود أو يتكرما % % 57(@)(@@) % تجشم حمل الفادحات وقلما % % أقيمت صدور المجد إلا تجشما % % 58(@)(@@) % وكنت أخا الإعدام لسنا لعلة % فكم بك بعد العدم أغنيت معدما % % 59(@)(@@) % وإذ أنا ممنون علي ومنعم % فأصبحت من خضراء نعماك منعما % % 60(@)(@@) % ومن خدم الأقوام يرجوا نوالهم % فإني لم أخدمك إلا لأخدما ! % PageV01P253 البحر : طويل 1(@)(@@) % سقى الله من اهوى على بعد نائه % وإعراضه عني وطول جفائه % 2(@)(@@) % أبى الله الا أن كلفت بحبه % فأصبحت فيه راضيا بقضائه % 3(@)(@@) % وأفردت عيني بالدموع فأصبحت % وقد غص منها كل جفن بمائه % 4(@)(@@) % فإن مت من وجد به وصبابة % فكم من محب مات قبلي بدائه % PageV01P254 البحر : خفيف تام 1(@)(@@) % سعدت غربة النوى بسعاد % فهي طوع الإتهام والإنجاد % 2(@)(@@) % فارقتنا وللمدامع أنوا % % ء سوار على الخدود غواد % 3(@)(@@) % كل يوم يسفحن دمعا طريفا % يمترى مزنه بشوق تلاد % 4(@)(@@) % واقعا بالخدود والحر منه % واقع بالقلوب والأكباد % 5(@)(@@) % وعلى العيس خرد يتبسم % % ن عن الأشنب الشتيت البراد % 6(@)(@@) % كان شوك السيال حسنا فأمسى % % دونه للفراق شوك القتاد % 7(@)(@@) % شاب رأسي ، وما رأيت مشيب الرأ % % س إلا من فضل شيب الفؤاد % 8(@)(@@) % وكذاك القلوب في كل بؤس % ونعيم طلائع الأجساد % 9(@)(@@) % طال إنكاري البياض وإن عمر % ت حينا ، أنكرت لون السواد % 10(@)(@@) % نال رأسي من ثغرة الهم مالم % يستنله من ثغرة الميلاد % PageV01P255 11(@)(@@) % زارني شخصه بطلعة ضيم % عمرت مجلسي من العواد % 12(@)(@@) % يا أبا عبد الله أوريت زندا % في يدي كان دائم الإصلاد % 13(@)(@@) % أنت جبت الظلام عن سبل الآ % % ل إذ ضل كل هاد وحاد % 14(@)(@@) % فكأن المغذ فيها مقيم % وكأن الساري عليهن غاد % 15(@)(@@) % وضياء الآمال أفسح في الطر % % ف وفي القلب من ضياء البلاد % 16(@)(@@) % كان في الأجفلى وفي النقرى عر % فك نضر العموم نضر الوحاد % 17(@)(@@) % ومن الحظ في العلى خضرة المعرو % % ف في الجمع منه والإفراد % 18(@)(@@) % كنت عن غرسه بعيدا فأدنت % ني 
ms80	 إليه يداك عند الجداد % 19(@)(@@) % ساعة لو تشاء بالنصف فيها % % لمنعت البطاء خصل الجياد % 20(@)(@@) % لزموا مركز الندى وذراه % وعدتنا عن مثل ذاك العوادي % % PageV01P256 21(@)(@@) % غير أن الرب إلى سبل الأنوا % % ء أدنى والحظ حظ الوهاد % 22(@)(@@) % بعدما أصلت الوشاة سيوفا % قطعت في وهي غير حداد % 23(@)(@@) % من أحاديث حين دوختها بالرأ % ي كانت ضعيفة الإسناد % 24(@)(@@) % فنفى عنك زخرف القول سمع % لم يكن فرصة لغير السداد % 25(@)(@@) % ضرب الحلم والوقار عليه % % دون عور الكلام بالأسداد % 26(@)(@@) % وحوان أبت عليها المعالي % % أن تسمى مطية الأحقاد % 27(@)(@@) % ولعمري أن لو أضحت لأقدم % % ت لحتفي ضغينة الحساد % 28(@)(@@) % حمل العبء كاهل لك أمسى % % لخطوب الزمان بالمرصاد % 29(@)(@@) % عاتق معتق من الهون إلا % من مقاساة مغرم أو نجاد % 30(@)(@@) % للحمالات والحمائل فيه % % كلحوب الموارد الأعداد % PageV01P257 31(@)(@@) % ملئتك الأحساب أي حياء % وحيا أزمة وحية واد ! % 32(@)(@@) % لو تراخت يداك عنها فواقا % أكلتها الأيام أكل الجراد % 33(@)(@@) % أنت ناضلت دونها بعطايا % % رائحات على العفاة غوادي % % 34(@)(@@) % فإذا هلهل النوال أتتنا % % ذات نيرين مطبقات الأيادي % % 35(@)(@@) % كل شيء غث إذا عاد وال % % معروف غث ما كان غير معاد % 36(@)(@@) % كادت المكرمات تنهد لولا % أنها أيدت بخير إياد % 37(@)(@@) % عندهم فرج اللهيف وتص % % ديق ظنون الزوار والرواد % 38(@)(@@) % بأحاظي الجدود لا بل بوشك % الجد لا بل بسؤدد الأجداد % 39(@)(@@) % وكأن الأعناق يوم الوغى أو % لى بأسيافهم من الأغماد % 40(@)(@@) % فإذا ضلت السيوف غداة الرو % % ع كانت هواديا للهوادي % % PageV01P258 41(@)(@@) % قد بثثتم غرس المودة والشح % ناء في قلب كل قار وباد % 42(@)(@@) % أبغضوا عزكم وودوا نداكم % فقروكم من بغضة ووداد % 43(@)(@@) % لاعدمتم غريب مجد ربقتم % في عراه نوافر الأضداد % % PageV01P259 البحر : كامل تام 1(@)(@@) % قل للأمير أبي سعيد ذي الندى % % والمجد زاد الله في إكرامه % 2(@)(@@) % يا واهب العيس الهموس برحلها % % والأعوجي بسرجه ولجامه % 3(@)(@@) % والحامل الأقوام فوق سلاهب % والحاكي الرئبال في إقدامه % 4(@)(@@) % والواهب الصمصامة السيف الذي % % يجري زعاف الموت في إسطامه % 5(@)(@@) % أنت المباري الريح في نفخاتها 