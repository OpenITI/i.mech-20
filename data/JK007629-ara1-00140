ms121	 % إذا ما ذكرت الله في السر والجهر % 4(@)(@@) % وفي صورة الأكوان أبصرت صاحبي % % لذا كثرت أسماء حبي في شعري % % 5(@)(@@) % فإن قلت شعرا في شخيص معين % فما هو إلا ما تضمنه صدري % % 6(@)(@@) % هو الحق لكن قيدته حقائق % % تقوم به من عقل أو حس أو فكر % % 7(@)(@@) % يناجيه في سري ضميري وشاهدي % % بأسمائه في الشفع كان أو الوتر % % 8(@)(@@) % أقول له حبي فأسمع رده % % بما قلته مثل الصدى حكمه يجري % % PageV01P468 البحر : بسيط تام 1(@)(@@) % إذا تجليت لي أثنى أهيم بها % % ولو تجليت لي في أقبح الصور % 2(@)(@@) % لعاد قبح الذي جعلت مظهركم % عندي وفي نظري من أحسن الصور % 3(@)(@@) % تبارك الله في مجلاه نعرفه % % ولو جهلناه كنا منه في ضرر % 4(@)(@@) % هو المشاهد في ذات وفي صفة % في عالم الأمر والأفلاك والبشر % 5(@)(@@) % به أراه وأصغي عند دعوته % % لأنه عين سمع الأذن والبصر % % 6(@)(@@) % وعالم الرسم لا يدري مقالتنا % % ولو يقول بها لكان في غرر % 7(@)(@@) % وكل صاحب عقد في الذي علمت % ألبابنا إنه فيه على خطر % % 8(@)(@@) % تراه يسبح في بحر وليس له % % سيف يومله إن كان ذا حذر % 9(@)(@@) % فاثبت على ما يقول الشرع فيه ولا % % تعدل عن النظر العقلي والخبر % 10(@)(@@) % ولتنفرد بالذي أشهدته فإذا % % مشيت في الناس لا تعدل عن الأثر % PageV01P469 البحر : بسيط تام 1(@)(@@) % روح يذكر والأنثى طبيعته % فكل عين فمن أنثى ومن ذكر % 2(@)(@@) % هذا فراش وذا سقف يظلله % % والأمر بينهما يجري على قدر % % 3(@)(@@) % لله حكم اقتدار لا يزايله % % كما القبول لنا فاسلك على أثري % % 4(@)(@@) % والكون عن أصل شفع لا وجود له % في الوتر فاعلم وكن منه على حذر % 5(@)(@@) % والرابط الفرد لا ينفك بينهما % % لولاه ما كان ما شاهدت من صور % 6(@)(@@) % عقلا وشرعا وتنزيها لمعرفة % وليس في العلم إن أنصفت من خطر % % PageV01P470 البحر : طويل 1(@)(@@) % إذا النظر الفكري كان سميري % % وكان وجود الحق فيه سجيري % % 2(@)(@@) % وعز لوجدان الحقيقة مطلبي % % وكان ورودي في عمى وصدور % % 3(@)(@@) % تيقنت أني إن تأملت 
ms122	 خاطري % % وجدت الذي أبغيه عين ضميري % % 4(@)(@@) % دعاني إليه الشوق من كل جانب % فكان بشيري بالهوى ونذيري % % 5(@)(@@) % نفوس عفيفات أتين يعدنني % % وقد ضربوا ما بينهن بسور % 6(@)(@@) % شهدن علينا إذ شهدن بما لنا % % وحرمة حبي ما شهدن بزور % 7(@)(@@) % لقد ذهبت في حسن ذاتي طوائف % % ذهاب خبير بالأمور بصير % % 8(@)(@@) % أضلوا على علم فضلوا وضللوا % % فيا ليت شعري من يكون عذيري % % PageV01P471 البحر : مخلع البسيط 1(@)(@@) % يا منزلا ما له نظير % % لم يبق سكناك في الصدور % 2(@)(@@) % هما فتسمو بذاك قدرا % على المقاصير والقصور % 3(@)(@@) % ولم يزل من تكون مأوى % % له على أكمل السرور % 4(@)(@@) % في غبطة وانتظام أمر % فيك إلى آخر الدهور % PageV01P472 البحر : بسيط تام 1(@)(@@) % إن المهيمن وصى الجار بالجار % والكل جار لرب الناس والدار % 2(@)(@@) % فإن تعدى عليه جاره فله % العفو والأخذ آثارا بآثار % 3(@)(@@) % إن شاء عاقبه أو يعف عن كرم % والعفو شيمة من يصغي إلى القاري % % PageV01P473 البحر : طويل 1(@)(@@) % إذا ما ذكرت الله في السر والجهر % ليذكرني ربي بما كان من ذكري % % 2(@)(@@) % لأنا نقلناه حديثا معنعنا % وما زال ذاك النقل عنه على ذكري % % 3(@)(@@) % فمن كونه كوني ومن عينه عيني % % ومن سره سري ومن جهره جهري % % 4(@)(@@) % ولست بغير لا ولا أنا عينه % فمن أنا عرفني فإني لا أدري % % 5(@)(@@) % فلو كنته عينا لما كنت جاهلا % ولو لم أكنه لم يكن أمره أمري % % 6(@)(@@) % فميزه عني الذي فيه من غنى % % وميزني عنه الذي بي من الفقر % % PageV01P474 البحر : بسيط تام 1(@)(@@) % رأيت جارية في النوم عاطلة % حسناء ليس لها أخت من البشر % 2(@)(@@) % ترنو إلي بعين كلها حور % % فمت وجدا بها من ذلك الحور % 3(@)(@@) % لما نظرت إليها وهي تنظرني % % فنيت حبالها من لذة النظر % 4(@)(@@) % وقلت للنفس يا نفس انظري عجبا % هذا الخيال فكيف الحس يا بصري % % 5(@)(@@) % انظر إلى لطفه وحسن صورته % % بالفاء لأبالي من حضرة الفكر % 6(@)(@@) % ولتعتبره وجودا لم يقم عدم % به ولا ندم من صورة البشر % % 7(@)(@@) % فإنها جنة المأوى 
ms123	 لساكنها % % وجنة الخلد لا من جنة النظر % 8(@)(@@) % وتلك جنة عدن والكثيب بها % % مع الذي يحتوي عليه من صور % 9(@)(@@) % هذي المعالي التي الأفكار تطلبها % % وهي التي نال أهل الكشف بالنظر % 10(@)(@@) % فأين غايتهم فيما ذكرت لكم % % هذي الروائح من مسك لهم عطر % % PageV01P475 البحر : بسيط تام 1(@)(@@) % لما شهدت الذي سوى حقيقته % في ذات أكمل مخلوق من البشر % 2(@)(@@) % يخصه اسم وما الأسماء تحصره % % وليس شيئا له نعت بمنحصر % 3(@)(@@) % لأنه قائم بكل ما وصفت % به الذوات من التنزيه والغير % % 4(@)(@@) % سبحان من أوجد الأشياء من عدم % ومن ثبوت وجود غير مختصر % 5(@)(@@) % في عينه أو عيون الخلق يظهره % % أحكامها بالذي فثيها من الصور % 6(@)(@@) % وكله خارج عن عين صورته % بما له في وجود العين من سور % % 7(@)(@@) % الحق أوجده والكون عينه % بما لديه من الآيات والسور % % 8(@)(@@) % في كل آية تنزيه له علم % به يشبهه من كان ذا نظر % 9(@)(@@) % فالحكم يشفعه والعين توتره % % والعقل ينكر ما يتلوه من خبر % % 10(@)(@@) % جل الإله فما تحصى مشاهده % قد حار فيه وجود العقل والبصر % PageV01P476 11(@)(@@) % لأنه يتعالى في نزاهته % عن العقول وعما كان في الفطر % 12(@)(@@) % لذا يقول رسول الله نحن به % كما يكون له فانهض على قدر % % 13(@)(@@) % لو كان لي ما له لكنته وأنا % % إن كنته فأنا منه على خطر % 14(@)(@@) % لكن أقول أنا إن قلته بأنا % % عين الوجود الذي في الحق من سير % 15(@)(@@) % فالصور ليس له والعين ليس لنا % % وباجتماعهما لي ينقضي وطري % % PageV01P477 البحر : بسيط تام 1(@)(@@) % أحببت شخصا جميع الناس تعرفه % من كان في بدوه أو كان في حضره % 2(@)(@@) % الشمس من نوره فالقلب منزله % والمسك في ريحه والشهد من أثره % 3(@)(@@) % إذا أعاينه تسري الحياة به % في خده فيذوب القلب من خفره % 4(@)(@@) % لما بحثت عليه لا أراه سوى % % ما قام بالنفس منه فهو من أثره % % 5(@)(@@) % فما يهيم قلبا في الهوى أبدا % إلا تخيله لا غير من نظره % % 6(@)(@@) % فبالخيال نعيم الناس أجمعهم % % كما 
ms124	 به الألم الآتي على قدره % 7(@)(@@) % إذا علمت بهذا قد نعمت بما % % تشكو نواه إذا ما غاب في سفره % PageV01P478 البحر : طويل 1(@)(@@) % تنازعني الأقدار فيما أرومه % % وإن نزاعي فيه أيضا من القدر % 2(@)(@@) % فحكمي عليها إن تأملته بها % % فمنها أمان الخائفين مع الحذر % 3(@)(@@) % تقابلت الأضداد منها كمثل ما % % تقابلت الأسماء بالنفع والضرر % % 4(@)(@@) % فكل الذي في الكون من متقابل % من العلم بالله العظيم لمن نظر % % 5(@)(@@) % فسلم وفوض واتكل واعتمد فقد % % يجيئك ما ترضاه يمشي على قدر % % PageV01P479 البحر : طويل 1(@)(@@) % توقف فإن العلم ذاك الذي يجري % % وتعلم بأن الحكم منا ولا تدري % % 2(@)(@@) % وما قلت إلا ما تحققه به % % كذا قرر الله المهيمن في صدري % % 3(@)(@@) % أنا في عباد الله روح مقدس % % كمثل الليالي روحها ليلة القدر % % 4(@)(@@) % تقدست عن وتر بشفع لأنني % % غريب بما عندي عن الشفع والوتر % % 5(@)(@@) % ولما أتاني الحق ليلا مبشرا % بأني ختام الأمر في غرة الشهر % % 6(@)(@@) % وقال لمن قد كان في الوقت حاضرا % من الملإ الأعلى ومن عالم الأمر % 7(@)(@@) % ألا فانظروا فيه فإن علامتي % % على ختمه في موضع الضرب في الظهر % 8(@)(@@) % وأخفيته عن أعين الخلق رحمة % بهم للذي يعطى الجحود من الكفر % % 9(@)(@@) % عرضت عليه الملك عرضا محققا % فقال لي الأمر المعظم في الستر % 10(@)(@@) % لأنك غيب والسعيد من اقتدى % % بسيده في حالة العسر واليسر % PageV01P480 11(@)(@@) % فنحمد في السراء حمدا مخصصا % ونحمد حمدا ساريا حالة الضر % 12(@)(@@) % ظهورك في الأخرى فثم ظهورنا لذا % % جئتني في العرب إذ جئتب بالشكر % 13(@)(@@) % فإن وجود الشكر يبغي زيادة % % من الله في النعماء فانهض على اثري % % 14(@)(@@) % لو أنك يا مسكين تعرف سره % % لكنت بما تدري به أوحد العصر % % 15(@)(@@) % غريبا وحيدا حائرا ومحيرا % وكنت على علم تصان عن الذكر % 16(@)(@@) % خفي على الألباب من أجل فكرها % % وإن كان أعلى في الوضوح من البدر % % 17(@)(@@) % أنا وارث لا شك علم محمد % وما الفخر إلا في الجسوم وكونها % % 18(@)(@@) % ولست بمعصوم ولكن شهودنا % % هو العصمة الغراء 
ms125	 في الأنجم الزهر % % 19(@)(@@) % ولست بمخلوق لعصمة خالقي % % من الناس فيما شاء منه على غمر % 20(@)(@@) % علمت الذي قلنا ببلدة تونس % % بأمر إلهي أتاني في الذكر % % PageV01P481 21(@)(@@) % أتاني به في عام تسعين شربنا % % بمنزل تقديس من الوهم والفكر % 22(@)(@@) % ولم أدر أني خاتم ومعين % إلى أربع منها بفاس وفي بدر % 23(@)(@@) % أقام لي الحق المبين يمينه % بركبته والساق من حضرة الأمر % 24(@)(@@) % وبايعته عند اليمين بمكة % % وكان معي قوم وليسوا على ذكري % % 25(@)(@@) % وأقسم بالحجر المعظم قدره % وفي ذلك الإيلاء يمين لذي حجر % 26(@)(@@) % مولدة الأرواح ناهيك من فخر % % لقد جاء بالميراث في طيء نشري % % 27(@)(@@) % وأين بلال من أبي طالب لقد % تشرف بالتقوى المحقر في القدر % 28(@)(@@) % سألتك ربي أن تجود لعبدكم % بأن يك مستورا إلى آخر الدهر % 29(@)(@@) % كمثل ابن جعدون وقد كان سيدا % إماما فلم يبرح من الله في ستر % % 30(@)(@@) % سألتك ربي عصمة الستر إنه % على سنة الحناوي سنتنا تجري % % PageV01P482 31(@)(@@) % لقد عاينت عيني رجالا تبرزوا % % خضامة عليا وما عندهم سري % % 32(@)(@@) % وأقسمت بالشمس المنيرة والضحى % % وزمزم والأركان والبيت والحجر % % 33(@)(@@) % لئن كان عبد الله يملك أمره % % فما مثله عبد السميع أو البر % 34(@)(@@) % فإن لكل اسم تعين ذكره % % سوى الذات مدلولا له حكمة الظهر % % 35(@)(@@) % فمن يشتهي الياقوت من كسب كده % يقاسي الذي يلقاه من غمة البحر % % 36(@)(@@) % وإن ذكروا روحي حننت إلى مصر % % أتاني به الفاروق عند أبي بكر % 37(@)(@@) % فلم أستطع عني دفاعا ولم أكن % % بما جاءني فيه مبشره أدري % % 38(@)(@@) % بحجرته الغرا بمسجد يثرب % % بحضرة عبد الله ذي النائل الغمر % 39(@)(@@) % وما زلت من وقت الغروب بمشهد % % فملت إليه في رجال ذوي نهى % % 40(@)(@@) % ومصباح مشكاة المشيئة في يدي % % أنور بيت الله عن وارد الأمر % % PageV01P483 41(@)(@@) % لأسرح منه والصلاة تلزني % % على ما أراه ما يزيد على العشر % % 42(@)(@@) % لباسي الذي قد كان في اللون أخضرا % % وإني من ذاك اللباس لفي أمر % 43(@)(@@) % غنيت بتصديقي رسالة أحمد % عن الكشف والذوق والمحقق والخبر % 44 
ms126	(@)(@@) % وهذا عزيز في الوجود مناله % % ولو لم يكن هذا لأصبحت في خسر % 45(@)(@@) % ولي في كتاب الله من كل سورة % % نصيب وجل الخير من سورة العصر % 46(@)(@@) % تواصوا بحق الله في كل حالة % كما أنهم أيضا تواصوا على الصبر % % 47(@)(@@) % أحب بقائي ها هنا لزيادة % وأفزع إيمانا إلى سورة النصر % % 48(@)(@@) % إذا لم أكن موسى وعيسى ومثلهم % % فلست أبالي أنني جامع الأمر % % 49(@)(@@) % فإني ختم الأولياء محمد % % ختام اختصاص في البداوة والحضر % % 50(@)(@@) % شهدت له بالملك قبل وجودنا % % PageV01P484 51(@)(@@) % شهود اختصاص أعقل الآن كونه % ولم أك في حال الشهادة في ذعر % % 52(@)(@@) % لقد كنت مبسوطا طليقا مسرحا % ولم أك كالمحبوس في قبضة الأسر % % 53(@)(@@) % ظهرت إلى ذاتي بذاتي فلم أجد % سواي فقال الكل أنت ولا تدري % % 54(@)(@@) % فإن أشركت نفسي فلم يك غيرها % % وإن وحدت كانت على مركب وعر % % 55(@)(@@) % إذا قلت بالتوحيد فاعلم طريقه % % فما ثم توحيد سوى واحد الكثر % 56(@)(@@) % ولا بد أن تمتاز فالوتر حاصل % ولكن في الايجاد لا بد من نزر % % 57(@)(@@) % لقد حارت الحيرات في كل حائر % وحاصل هذا الأمر في القول بالنكر % 58(@)(@@) % فإن شهدت ألفاظنا بوجودنا % % تقول المعاني إنني منك في خسر % 59(@)(@@) % إذا ذكروا جسمي حننت لشامنا % % وإن ذكروا روحي حننت من فخر % 60(@)(@@) % ألا إن طيب الفرع من طيب أصله % % وكيف يطيب الفرع من خبث النجر % PageV01P485 61(@)(@@) % يعز علينا أن ترد سيوفنا % % مفللة من ضرب هام ومن كسر % % 62(@)(@@) % صريرا من أقلام سمعت أصمني % % وما علمت نفسي بصم من الصر % 63(@)(@@) % حياة فؤادي من علوم طبيعتي % % كإحياء ماء قد تفجر من صخر % % 64(@)(@@) % بلادا مواتا لا نبات بأرضها % % فأضحت لمحياها تبسم بالزهر % 65(@)(@@) % تتيه به عجبا وزهوا ونحوه % حدائق أزهار معطرة النشر % 66(@)(@@) % نراها مع الأرواح تثنى غصونها % % حنوا على العشاق دائمة البشر % 67(@)(@@) % فيا حسنه علما يقوم بذاتنا % % جمعنا به بين الذراع مع الشبر % 68(@)(@@) % وما بين سعي الساع والباع والذي % % يهرول بالتقسيم فيه وبالشبر % % 69(@)(@@) % فيحظى بمجلاه وبالصورة التي 
ms127	 % % لها سورة فوق الطبيعة والفقر % 70(@)(@@) % سريت إليه صحبة الروح قاصدا % إلى بيته المعمور في رفرف الدر % PageV01P486 71(@)(@@) % فكن في عداد القوم واصحب خيارهم % % ولا تك في قوم أسافلة غمر % 72(@)(@@) % ولا تتركنهم وانظر الحق فيهم % % 73(@)(@@) % ولا تتخذ نجما دليلا عليهم % فسكناهم المعروف بالبلد القفر % 74(@)(@@) % وعاشر إذا عاشرت قوما تبرقعوا % % أشداء مأمونين من عالم القهر % % 75(@)(@@) % علوم عباد الله في كل موقف % وغير عباد الله في موقف النشر % % 76(@)(@@) % ترى عابد الرحمن في كل حالة % تميل به الأرواح كالغصن النضر % % 77(@)(@@) % بقاء وجودي في الوجود منعما % بما أنعم الله علي من السحر % 78(@)(@@) % يسوق لي الأرواح من كل جانب % % فما معجرات بالخيال ولا السحر % 79(@)(@@) % كما جاد لي بالحل من كل حرمة % % صبيحة يوم الرمي من ليلة النحر % 80(@)(@@) % ويمم لي المطلوب من كل منسك % تجلى لنا فيه إلى حالة النفر % % PageV01P487 81(@)(@@) % سباني وأبلاني بكل مقرطق % وما نظم الرحمن من لولؤ الثعر % 82(@)(@@) % نزين به إكليل تاج وساعد % % 83(@)(@@) % لقد أنشأ الله العلوم لناظري % % على صور شتى من البيض والسمر % 84(@)(@@) % ترفلن في أثواب حسن مهيم % منوعة الألوان من حمر أو صفر % % 86(@)(@@) % وبيض كريمات عقائل خرد % يجررن أذايل البها أيما جر % 87(@)(@@) % لقد جمع الله الجمال لأحمد % % وغير رسول الله منه على الشطر % % 88(@)(@@) % فمن كان يدري ما أقول ويرتقي % % إلى عرشه العلوي من شاطئ النهر % 89(@)(@@) % فذاك الذي حاز الكمال وجوده % % وزاد على الأملاك علما بما يجري % % 90(@)(@@) % إذا جاء خير الله يصبح نادما % بما فرط المسكين في زمن البذر % 91(@)(@@) % علوم أتت نصا جليا تقدست % عن الظن والتخمين والحدس والحزر % PageV01P488 92(@)(@@) % تجيء وما ينفك عنها مجيئها % % ولكنها تأتيك بالمد والجزر % 93(@)(@@) % ألا كل خلق كان مني تخلقا % بخلق إلهي كريم سوى النذر % % 94(@)(@@) % فيا شؤمه خلقا فإن أداءه % كمثل أداء الفرض في القسر والجبر % % 95(@)(@@) % لقد طلعت يوما علي غمامة % تكون لما فيها من الصون كالخدر % % 96(@)(@@) % فقلت تجلى في غمام علمته % أتاني به الرحمن 
ms128	 في محكم الذكر % 97(@)(@@) % فجادت على أركان كوني بأربع % % 98(@)(@@) % علوم يقوم الحبر منا بفضلها % % فما هي من زيد يمر على عمر % % 99(@)(@@) % تعالت فلا شخص يفوز بنيلها % % ولا سيما إن كان في ظلمة الحشر % % 100(@)(@@) % بها ميز الرحمن بين عباده % غداة غد في موقف البعث والنشر % 101(@)(@@) % كما ميز الرحمن بين عباده % إذا دفنوا في الأرض من ضغطة القبر % PageV01P489 102(@)(@@) % فضم لتعذيب وضم تعشق % % فلا بد منه فاعلموا ذاك من شعري % % 103(@)(@@) % قد اشتركا في الضم من كان ذا وفا % % لما كان في عهد ومن كان ذا غدر % % 104(@)(@@) % يجيء بأعذار ليقبل عذره % وليس له يوم القيامة من عذر % 105(@)(@@) % ويقبل منه صدقه في حديثه % ولو جاء يوم العرض بالعمل النزر % % 106(@)(@@) % لقد عم بالطبع العزيز قلوبنا % % فلا يدخلن القلب شيء من النكر % % 107(@)(@@) % جهلت علوما في حداثة سننا % % وما نلت هذا العلم إلا على كبر % % 108(@)(@@) % وما خفت من شيء أتاني بغتة % كخوفي إذا خفنا من النظر الشزر % 109(@)(@@) % جرينا به في حلبة الكشف والحجى % % على الصافنات الغر والسبق الضمر % % 110(@)(@@) % فلما أتينا الصور قال لنا فتى % ألا إنه الناقور فافزع إلى النقر % 111(@)(@@) % فلمت إليه في رجال ذوي نهى % بمحو وإثبات من الصحو والسكر % PageV01P490 112(@)(@@) % أهدى كما قال الجنيد بحامل % % فقلت له : أين القعود من البكر % % 113(@)(@@) % فأنزلني منه بأكرم منزل % % علوت به فوق السماكين والنسر % 114(@)(@@) % وفرق حالي بين هذا وهذه % وأين زمان الرطب من زمن البسر % 115(@)(@@) % إذا كان لي كنت الغني بكونه % وأصبحت ذا جاه وأمسيت ذا وفر % % 116(@)(@@) % دعاني إلهي للحديث مسامرا % ولي أذن صماء من كثرة الوقر % % 117(@)(@@) % وحملني ما لا أطيق احتماله % وأطت ضلوعي من ملابسة الوقر % % 118(@)(@@) % وخفت على نفسي كما خاف صالح % على قومه خوف المقيمين في الحجر % % 119(@)(@@) % إذا قلت يا الله لبى لدعوتي % % ولم يقصيني عنه الذي كان من وزري % % PageV01P491 البحر : كامل تام 1(@)(@@) % شغف السهاد بمقلتي ومزاري % % فعلى الدموع معولي ومشاري % % PageV01P492 البحر : كامل تام 1(@)(@@) % قال 
ms129	 ابن ثابت الذي فخرت به % فقر الكلام ونشأة الأشعار % 3(@)(@@) % فلذا جعلت رويه الراء التي % % هي من حروف الرد والتكرار % 4(@)(@@) % فأقول مبتدئا لطاعة أحمد % % في مدح قوم سادة أخيار % % 5(@)(@@) % إني امرؤ من جملة الأنصار % فإذا مدحتهم مدحت نجاري % % 6(@)(@@) % لسيوفهم قام الهدى وعلت بهم % أنواره في رأس كل منار % 7(@)(@@) % قاموا بنصر الهاشمي محمد % المصطفى المختار من مختار % 8(@)(@@) % صحبوا النبي بنية وعزائم % فازوا بهن حميدة الآثار % 9(@)(@@) % باعوا نفوسهم لنصرة دينه % % ولذاك ما صحبوه بالإيثار % % 10(@)(@@) % لهم كنى المختار بالنفس الذي % % يأتيه من يمن مع الأقدار % % 11(@)(@@) % سعد سليل عبادة فخرت به % % يوم السقيفة جملة الأنصار % % PageV01P493 12(@)(@@) % لله آساد لكل كريهة % نزلت بدين الله والأبرار % 13(@)(@@) % عزوا بدين الله في إعزازهم % % دين الهدى بالعسكر الجرار % % 14(@)(@@) % فيهم علا يوم القيامة مشهدي % % وبهم يرى عند الورود فخاري % % 15(@)(@@) % لو أنني صغت الكلام قلائدا % في مدحهم ما كنت بالمكثار % % 16(@)(@@) % كرش النبي وعيبة لرسوله % لحقت به أعداؤه بتبار % 17(@)(@@) % رهبان ليل يقروون كلامه % آساد غاب في الوغى بنهار % % PageV01P494 البحر : سريع 1(@)(@@) % إن الذي هيمني حسنه % % من الذي هام ولا تدري % % 2(@)(@@) % في سورة الأعلى وأمثالها % % كالفجر والليل إذا يسري % % 3(@)(@@) % سبحان من جل فما مثله % % من أحد إلا الذي أدرى % % 4(@)(@@) % في سورة الشورى أتى ذكره % وإنه الآن على ذكري % % 5(@)(@@) % قد جاء حقا بالصفات التي % % تزيد في العد عن العشر % % 6(@)(@@) % تحمل عرش الذات من ذاتها % % وما لها عين سوى سري % % 7(@)(@@) % بها وجودي وبها كنته % لذاك تجري بي عن أمري % % 8(@)(@@) % لا تنظروني غيره إنني % % هوية الحق بلا ستر % % 9(@)(@@) % فليس في العالم من مفصل % % إلا وفيه علم الذكر % % 10(@)(@@) % فتصب يعرفه من له % % في ذاته منزلة الشكر % PageV01P495 11(@)(@@) % له مزيد العلم من شكره % يستره ما فيه من كفر % % 12(@)(@@) % وليس بالكفر الذي ذقته % من قرر الإنسان في خسر % 13(@)(@@) % بأصله ثم أتى شارحا % % مفرعا بالحق والصبر % % 14(@)(@@) % بذا أتى النص الذي قاله % % لخلقه في محكم الذكر 
ms130	 % 15(@)(@@) % فمن يرد يمتاز في أهله % فليمش بالحال على أثري % % 16(@)(@@) % فإنه الحق الذي قال لي % % انصح عبادي وامتثل أمري % % 17(@)(@@) % بمكة في حالة تقتضي % % في وقتها القبض من العسر % % 18(@)(@@) % وفي دمشق قال لي مثله % % في مرة أخرى على سري % % 19(@)(@@) % فقلت يا رب أعني على % % ما قلت لي فقال بالنصر % 20(@)(@@) % فلم يزل في نصرتي قائما % في كل حال دائم البشر % % PageV01P496 21(@)(@@) % وقال تمم ما بدأتم به % من الفتوحات على قدر % % 22(@)(@@) % على لسان المصطفى أحمد % ولم ينب عني في العذر % 23(@)(@@) % فإن فيها سببا مقلقا % يضيق من إيراده صدري % % 24(@)(@@) % فقال لي لا تلتفت إنني % % مزيل ما تخشى من الضر % 25(@)(@@) % أيدك الله فكن آمنا % ولا يكن قلبك في ذعر % % 26(@)(@@) % فقمت بالعلم لهم مفصحا % مبينا في السر والجهر % % 27(@)(@@) % أورده من غير كيل له % % كأنما آخذ من بحر % 28(@)(@@) % لو أنه ينظر في قوله % % إن إليه مرجع الأمر % % 29(@)(@@) % رأى وجود الحق عين الذي % % يطلبه في وحدة الكثر % 30(@)(@@) % لو أنه يعرف أحواله % % ما ميز الخير من الشر % PageV01P497 31(@)(@@) % ليس له الشر فإن الذي % % سمي شرا عدم فادر % % 32(@)(@@) % بيده الخير فقل كالذي % % يقول فيه صاحب السبر % 33(@)(@@) % فإنه الخير كما قال لي % % من قال بالباع والبشبر % 34(@)(@@) % فاعبد إله السر مستسلما % ولا تكفر صاحب الفكر % PageV01P498 البحر : طويل 1(@)(@@) % إله تعالى أن يرى ببصيرة % % ولا بصر والنص جاء بإبصار % 2(@)(@@) % وليس يرى شيء سواه وإنه % % على كل حال عين ذاتي ومقداري % % 3(@)(@@) % لذاك يسمى ظاهرا باطنا لنا % % لأثبت أو أنفي فالأسماء أبصاري % % 4(@)(@@) % فلا تجزعن فالأمر والشان واحد % % ولا تلتفت إلى يساري وإعساري % % 5(@)(@@) % فإني عين الأمر إن كنت موسرا % ولست له عينا بعسري وإقتاري % % 6(@)(@@) % ألا إن عيني شاهد وشهادتي % % كذلك فيما صح فيه من أخباري % % 7(@)(@@) % لقد أثبت الأرحام بيني وبينه % % وإن أولي الأرحام أولى بأقداري % % 8(@)(@@) % أنا سجنه منه إذا كنت رحمة % % وإن لم تكن رحمتي فقد بعدت داري % % 9(@)(@@) % ألا إنني جار 
ms131	 لمن هو صورتي % % وقد جاء حق الجار فرض على الجار % % 10(@)(@@) % فقد أثبت المثل الذي قد نفاه لي % % بليس وقد حارت لذلك أفكاري % % PageV01P499 11(@)(@@) % إذا قلت : مثل قال : لا فأقول لا % % وإن قلت لا : أبقى رهينا بأوزاري % % 12(@)(@@) % فما هو لي بعض ولا أنا كله % وما ثم كل غير ما برأ الباري % % 13(@)(@@) % ولما بدا خلقي بعيني رأيتني % % بأسمائه الحسنى وسبعة أسوار % % 14(@)(@@) % وما أنا إلا جوده ووجوده % % وإن الذي يبدو لعينك آثاري % % 15(@)(@@) % تعالى بأن يحظى بغير وجوده % % وأين مع التحقيق عين لأغياري % % 16(@)(@@) % إذا قمت أثني والثناء كلامه % فما أنا فيما قد حمدت بمكثار % 17(@)(@@) % إذا أبصرت عيني جمال وجوده % % أكون به في الحال صاحب أنوار % 18(@)(@@) % وإن لم أكن أبصر سواي فإنني % % لعالم وقتي بي وصاحب أسرار % 19(@)(@@) % ولكن متى أن دام بي ما ذكرته % وذلك في التحقيق يثبت أضراري % % PageV01P500 البحر : بسيط تام 1(@)(@@) % الناس أولاد حواء سواي أنا % % فإنني ولد للوالد الذكر % 2(@)(@@) % إن الأنوثة من نعت الرجال لذا % % تراهم يحملون العلم في الصور % 3(@)(@@) % فيصبحون حبالى حاملين به % حمل السحاب لما فيها من المطر % 4(@)(@@) % يحي به كل ميت لا حراك به % فيشكر الحي شكر الزهر للزهر % % 5(@)(@@) % فالزهر أسماؤه الحسنى بجملتها % % والزهر ما أعطت الأسماء من أثر % 6(@)(@@) % يا رحمة الله قد حزت الوجود فما % % في الكون مقلة عين تخلو من نظر % 7(@)(@@) % به يرون وجود الكون فيه كما % % يرون فيه وجود الحق في البشر % % 8(@)(@@) % ما بين ضم وفتح قد بدت عبر % % لكل قلب سليم فيه معتبر % 9(@)(@@) % تربى على قوة الأرواح قوته % فليس يحرقه الإدراك بالبصر % 10(@)(@@) % لأنه سبحات الوجه فاعتبروا % % في النور والظلمة العمياء والغير % PageV01P501 11(@)(@@) % هما الحجاب لها ولم يقم بهما % % إحراقها لا ولا ما فيه من ضرر % % 12(@)(@@) % والحجب ليس سوانا وهو خالقنا % % ونحن مجلى له بالسمع والبصر % 13(@)(@@) % كذا رأيناه ذوقا في مشاربنا % % كما رويناه فيما صح من خبر % % 14(@)(@@) % هو القوي حين ما تعطي جوارحنا % % من النتائج 
ms132	 فانظر فيه وادكر % % 15(@)(@@) % لولاه ما نظرت عين ولا سمعت % أذن لما قد تلاه الحق في السور % % 16(@)(@@) % الله يخلقنا والله يخلفنا % % على الدوام كما قد جاء في الزبر % % 17(@)(@@) % وما له خبر فينا يخبرنا % % سوى الذي نحن فيه اليوم من سير % % 18(@)(@@) % وما تكون عنه من تقابلنا % % في جنة الخلد والمأوى على سرر % % 19(@)(@@) % ومن يكون على ضد النعيم بما % % يلقاه من ألم الضراء في سقر % 20(@)(@@) % ليس التعجب من هذا وما عجبي % % إلا بأني مع الأنفاس في سفر % % PageV01P502 21(@)(@@) % دنيا وآخرة فانظر ترى عجبا % في حالنا واعتبره صنع مقتدر % 22(@)(@@) % والجوهر الأصل باق لا زوال له % % هو المحل لما بيديه من صور % 23(@)(@@) % الله جلى لنا ما قد جلاه لنا % % على صفاء بلا شوب ولا كدر % 24(@)(@@) % لذا أرى زمرا تأتي على زمر % كما أتت في كتاب الله في الزمر % % 25(@)(@@) % إن المياه على مقدار أعينها % % فمنه منهمر وغير منهمر % % 26(@)(@@) % إن السحاب بخار الأرض أنشأه % ماء يحلله للنجم والشجر % 27(@)(@@) % شيئا فشيئا ويبقى بعضها لندى % أو تستحيل هواء في ذرى الأكر % % 28(@)(@@) % لذا رأيت خروج الودق من خلل % فيه ليبرز ما في الروض من ثمر % PageV01P503 البحر : رمل تام 1(@)(@@) % إن لله عبادا كلما % % ذكروا الله فنوا في ذكره % 2(@)(@@) % وإلى هذا فهم ما أمنوا % % حال ذكراهم به من مكره % 3(@)(@@) % يتبغون الفضل منه عندما % % شكروا المنعم حق شكره % 4(@)(@@) % زهد العارف منهم في الذي % % أثبت العقل له من فكره % 5(@)(@@) % من إله قرر الكشف له % إنه المعبود حال نكره % % 6(@)(@@) % يظهر الحق له في صحوه % % عين ما أثبته في سكره % % PageV01P504 البحر : بسيط تام 1(@)(@@) % إن المجاهد في نار وفي نور % % كأنه ذهب في حق بلور % 2(@)(@@) % ما إن رأيت له مثلا يعادله % فيما يحاول من كد وتشمير % % PageV01P505 البحر : بسيط تام 1(@)(@@) % قالت لنا سفري إن كنت في سفري % % ما كان في سكر أحلى من السكر % 2(@)(@@) % فقل إلى سمر شوقي إلى السمر % فإن في عمري خيرا إلى 
ms133	 عمري % % PageV01P506 البحر : سريع 1(@)(@@) % الحمد للأول والآخر % الأحد الباطن والظاهر % 2(@)(@@) % بوحدة الكبر عرفت الذي % % قرره الرحمن في خاطري % % 3(@)(@@) % إن الغنى وصف له ثابت % عند اللبيب العاقل الناظر % % 4(@)(@@) % والنقل قد أثبت أسماءه % % لحكمة الخابر والحائر % 5(@)(@@) % والكشف قد قال بهذا وذا % % لأنه في الموقف الباهر % % 6(@)(@@) % يبهر أرباب الحجى بالغنى % % ويبهر الناقل بالحابر % % 7(@)(@@) % وهو على ما هو في نفسه % يحكم للأول والآخر % % PageV01P507 البحر : - 1(@)(@@) % قسما بسورة العصر % إنه الإنسان في خسر % 2(@)(@@) % غير من أوصوا نفوسهم % بينهم بالحق والصبر % % 3(@)(@@) % فهم القوم الذين نجوا % % من عذاب الله في القبر % 4(@)(@@) % ثم في يوم النشور إذا % % جمعوا للعرش في الحشر % PageV01P508 البحر : كامل تام 1(@)(@@) % إن الذين يبايعونك إنهم % % ليبايعون الله دونك فاعتبر % PageV01P509 البحر : مجزوء الكامل 1(@)(@@) % إن التحرك عن ضجر % % سخط على حكم القدر % 2(@)(@@) % الساكنون لحكمنا % % قوم أعزاء صبر % 3(@)(@@) % فهم لنا وأنا لهم % وهم المراد من البشر % % 4(@)(@@) % لا تركنن لغيرنا % % واصبر تعش مع من صبر % 5(@)(@@) % إني لكل مسلم % عرف الحقيقة فاعتبر % % 6(@)(@@) % في كل ما يجري حليه % من المكاره والضرر % 7(@)(@@) % قل للذين تحركوا % % من حكمنا أين المفر % % 8(@)(@@) % ما ثم إلا حكمنا % % عند الإقامة والسفر % % 9(@)(@@) % فاربح قعودك تسترح % فتكون من أهل الظفر % % 10(@)(@@) % فالله ليس بغائب % وهو الكفيل لمن نظر % PageV01P510 البحر : بسيط تام 1(@)(@@) % الله يعلم أني لست أذكره % % لعلمه باعتقادي أنه الذاكر % 2(@)(@@) % فليس يذكره إلا هويته % والعبد يحجبها عن عينه ساتر % 3(@)(@@) % وقد علمت بما في الدار من حرم % % مسترات عن الإدراك بالناظر % 4(@)(@@) % الدار دار نعيم لا اكتراث بها % % فإن أضيف إليها فهو بالنادر % 5(@)(@@) % لأن ذلك إن قالوه عن غرض % من النفوس إذا ما لم يكن زاجر % 6(@)(@@) % أو كالذي قيل في عين الحسان إذا % % أمرضنن في نظر يا ظرفها الفاتر % 7(@)(@@) % تلهفي حيث لا أحظى بجنتها % % عن التألم وهو المؤلم الحاضر % 8(@)(@@) % إن التألم يعطي الشخص نشأته % لا الدار فاعلم بأن الحكم للخابر % % 9(@)(@@) % لو كان للدار 
ms134	 أخران لما وجدت % % لذاتها أنفس سرورها ظاهر % % 10(@)(@@) % بما ينعم ذا به يعذب ذا % % أعني به السبب المشهود لا الناظر % % PageV01P511 11(@)(@@) % فإن علمت الذي قلناه قلت به % % وإن جهلت فأنت التاجر الخاسر % PageV01P512 البحر : رمل تام 1(@)(@@) % في فؤاد العارفين بصر % ما له في المؤمنين خبر % 2(@)(@@) % حظه علم ومعرفة % ليس يدري ما يقول حير % % 3(@)(@@) % يعرف الأشيا مشاهدة % % ما له في علم ذاك نظر % % 4(@)(@@) % يثبت الأشياء الموجده % % أدبا وما رأى من أثر % 5(@)(@@) % كالذي جاءت مسطرة % وهي سر في قضا وقدر % 6(@)(@@) % عالم بكل ما نسبوا % % فعله لله أو لبشر % % 7(@)(@@) % شاهد خلاف ما شهدوا % % عالم إن الإله ستر % % 8(@)(@@) % واقتدى فيه بموجده % % وعفا عما جرى وصبر % 9(@)(@@) % وادعاه الحق فيه كما % % جاء في نص الهدى وغفر % % 10(@)(@@) % فهو ذو علم على حدة % قابل بما الوجود ظهر % % PageV01P513 11(@)(@@) % ما نرى فيه منازعة % % مثبت ما قد بقي وغبر % 12(@)(@@) % أخرس أعمى معلقة % يده فلا يزال بشر % % 13(@)(@@) % إنه في كونه عدم % مثل نور قد بدا بقمر % % 14(@)(@@) % فتقول العين ذاك له % ويقول البدر لا وعبر % 15(@)(@@) % هكذا أمر الوجود فكن % لا تكن واسكت وقل بقدر % % PageV01P514 البحر : طويل 1(@)(@@) % يرى الحق أعمالي بما هو ذو بصر % وما عندنا من ذاك علم ولا خبر % 2(@)(@@) % ولما أتى الشرع الذي خص بالهدى % % به نحو ما قلنا به مثل ما أمر % 3(@)(@@) % ولا تك ممن قال فيه بأنه % مزيد وضوح العلم في عالم البشر % % 4(@)(@@) % فذلك قول لا خفاء بنقضه % وإن كان مدلولا عليه بما ذكر % % PageV01P515 البحر : طويل 1(@)(@@) % وقد انتهت سور القرآن على ما أعطاه وارد الوقت من غير مزيد ولا حكم فكر ولا روية ولله الحمد . توالى علي اليبس من كل جانب % وأقلقني طول التفكر والسهر % 2(@)(@@) % وأزعجني داعي المنية للبلى % % وأذهلني عما يجل ويحتقر % 3(@)(@@) % وقوى فؤادي حسن ظني بخالقي % % وأضعف مني قوة السمع والبصر % 4(@)(@@) % وإن مرادي حيل بيني وبينه % % بردي كما يتلى إلى أرذل العمر % % 5(@)(@@) % فنادى بروحي للبرازخ 
ms135	 والتوى % % ينادي بجسمي للمقابر والحفر % % 6(@)(@@) % فهذا حبيس القبر في منزل البلى % % وهذا حبيس الصور في برزخ الصور % 7(@)(@@) % فلو لم أكن بالحق كنت مقيدا % ولو لم أكن بالخلق كنت على خطر % % 8(@)(@@) % فحقي يحليني بما في من قوى % % وخلقي يحليني بما يوصف البشر % % 9(@)(@@) % فما أعذب الطعم الذي قد طعمته % % من الظن الجميل لمن نظر % 10(@)(@@) % وما أفظع الطعم الذي قد طعمته % % من العلم بالله المريد وما أمر % PageV01P516 11(@)(@@) % كأني طعمت التمر في طيباته % % وفي العلم ما ذقنا سوى مطعم العشر % % 12(@)(@@) % فوفيت ما قد أوجب الله فعله % علي بتصريف لاقضاء مع القدر % 13(@)(@@) % عناية مختار عليم منبأ % % وجئت كما قد جاء موسى على قدر % % PageV01P517 البحر : مجزوء الخفيف 1(@)(@@) % قرة العين والبصر % جاء موسى على قدر % 2(@)(@@) % بالذي يقتضي النظر % والذي يرتضي القدر % % 3(@)(@@) % من أمور إذا بدت % أذهلت صاحب النظر % 4(@)(@@) % قد تعالت فما يرا % % ها سوى من له بصر % 5(@)(@@) % والذي يدركونه % % إنما ذلك الأثر % 6(@)(@@) % مثل أسمائه العلى % % التي عين البشر % 7(@)(@@) % وهي بالذات في حمى % % مانع ما له خبر % % 8(@)(@@) % نسب كلها لها % % نسب في الذي ظهر % 9(@)(@@) % من وجودي ومن بلو % % غي إلى غاية العمر % 10(@)(@@) % وانتقالي ما ينتهي % % هكذا جاء في الزبر % % PageV01P518 11(@)(@@) % من نعيم مؤبد % في جنان وفي نهر % % 12(@)(@@) % عند رب مؤيد % في الذي شاء مقتدر % % 13(@)(@@) % أو عذاب سرمد % في ضلال وفي سعر % % 14(@)(@@) % نسأل الله عفوه % % فالكريم الذي غفر % PageV01P519 البحر : سريع 1(@)(@@) % الحكم حكم الجبر والاضطرار % ما ثم حكم يقتضي الاختيار % 2(@)(@@) % إلا الذي يعزى إلينا ففي % % ظاهره بأنه عن خيار % 3(@)(@@) % كمثل ما يعزى إلى خالقي % % وعرشنا عن عرشه في ازورار % % 4(@)(@@) % لو فكر الناظر فيه رأى % % بأنه المختار عن اضطرار % 5(@)(@@) % للكل هذا ثابت لا تقل % % بأنه خاص بنا مستعار % % 6(@)(@@) % فالعلم ما يتبع معلومه % % فالحكم للساكن مثل الديار % % 7(@)(@@) % لا تعتب العالم في كل ما % % يكون فيه من غنى وافتقار % 8(@)(@@) % ولا الذي أوجده إنه % % يحكم 
ms136	 بالعلم فأين الفرار % % 9(@)(@@) % حرت وحار الأمر في حيرتي % % فليلزم العالم دار القرار % 10(@)(@@) % وليرتضي بما له لا يزد % % على رضاه إنه في تبار % PageV01P520 11(@)(@@) % لا يعلم الحق سوى واحد % يقضي على الحكام بالاضطرار % 12(@)(@@) % ألا ترى القاضي في حكمه % % بمقتضى الشرع فأين الخيار % 13(@)(@@) % ما أقلق العالم إلا الذي % % قام به من حكمة الانتظار % 14(@)(@@) % هذا هو الفصل الذي بينه % وبين من يفعل بالاقتدار % % PageV01P521 البحر : كامل تام 1(@)(@@) % إن الإله له تجل في الصور % % عند الشهود لمن تحقق بالنظر % 2(@)(@@) % بتحول وتبدل يقضي به % عين الشهود لنا وينفيه النظر % % 3(@)(@@) % الفكر فيه محرم في شرعنا % % فاحذره والزم إن تقدمت النظر % % 4(@)(@@) % من ينتظر نفحاته منه يصب % % هذا ضمنت لمن يلازمه النظر % 5(@)(@@) % إني مع الرحمن إن حققت ما % % جئنا به عند التحقق في نظر % 6(@)(@@) % أين العزيز ومن له في نفسه % % صفة الغنى ممن يذل ويفتقر % PageV01P522 البحر : طويل 1(@)(@@) % عجبت لموجود حوى كل صورة % من الملإ العلوي والجن والبشر % 2(@)(@@) % ومن عالم أدنى ومن عالم علا % % ومن حيوان كان أو نبت أو حجر % 3(@)(@@) % وليست سواه لا ولا هي عينه % وفي كل شيء شاء من صورة ظهر % 4(@)(@@) % ويبدو إلى الأبصار من حيث ذاته % % ويخفى على الألباب ذاك ولستتر % % 5(@)(@@) % فتجهله الألباب من حكم فكرها % % وتظهره الأوهام للسمع والبصر % % 6(@)(@@) % هو الحي لكن لا حياة بذاته % % تقوم كما قامت بها سائر الصور % % 7(@)(@@) % فمن هو خبرني الذي قد ذكرته % % بما قد وصفناه وترمي به الفكر % 8(@)(@@) % فها هو مخفي وليس بغائب % % وها هو منظور ويخفى على النظر % 9(@)(@@) % فيا ليت شعري هل سمعتم بمثله % % ألا فاخبروني أن هذا هو العبر % % 10(@)(@@) % ولم يدر ما جئنا به غير واحد % هو الله لا تدري به سائر الفطر % PageV01P523 11(@)(@@) % وما مثله إلا شخيص وإنني % % عجبت له من كامل وهو مختصر % PageV01P524 البحر : مجزوء الرجز 1(@)(@@) % قد صح عندي خبر % % وجل عندي من خبر % 2(@)(@@) % ليس لنا إعادة % % فيما انقضى وما غبر % 3(@)(@@) % من 
ms137	 صور معلومة % محسوسة من البشر % % 4(@)(@@) % لأنها على مزا % % ج كله مزاج شر % % 5(@)(@@) % وإنما إعادتي % % في مثلها من الصور % 6(@)(@@) % على مزاج صالح % % ما فيه شيء من ضرر % 7(@)(@@) % من صور مشهودة % فيهن نحيا ونسر % 8(@)(@@) % في فرش مرفوعة % % منضودة وفي سرر % % 9(@)(@@) % ملكا إماما سيدا % مدبرا لمن نظر % 10(@)(@@) % وهي الذوات عينها % % المودعات في الحفر % PageV01P525 11(@)(@@) % لم تلحق الذات إذا % % نظرت فيها من غير % 12(@)(@@) % وإنما مزاجها % % من يعتبره لم يحر % 13(@)(@@) % لله في هذا الذي % % أقوله معنى وسر % 14(@)(@@) % يفرق منه ذو حجى % إذا به الحق ظهر % % 15(@)(@@) % فالحمد لله الذي % % أشهدني هذا الخبر % % 16(@)(@@) % في نومنا وعندنا % % محمدا سفندير % % 17(@)(@@) % وامرأة مؤمنة % الوجه منها كالقمر % 18(@)(@@) % يا حسنها من غادة % فتانة لمن نظر % % 19(@)(@@) % فديتها معشوقة % بالسمع مني والبصر % % 20(@)(@@) % في صورة الحق أتت % مع الدلال والخفر % PageV01P526 21(@)(@@) % يستصرخ الشخص الذي % % أراد أن يعطى الوطر % % 22(@)(@@) % منها فلم يحفل به % ولا على النيل قدر % 23(@)(@@) % ما يفعل المسكين إذ % لم ينجه منها الحذر % % 24(@)(@@) % قالت له انزل إلي % من قد نهانا وأمر % 25(@)(@@) % إلى هنا كان الذي % % أريته حتى السحر % PageV01P527 البحر : كامل تام 1(@)(@@) % ضم الكتاب إلى الوعاء فحازه % % ما كل من ضم الكتاب يحوز % 2(@)(@@) % لولا ثبوت الحق لم يجز الذي % % قد كان لكن بالثبوت يجوز % % PageV01P528 البحر : مديد تام 1(@)(@@) % إن دارا أنت فيها تهنى % % وديارا لست فيها تعزى % % 2(@)(@@) % فاشكر الله على كل حال % % واتخذ ربك ركنا وحرزا % % PageV01P529 البحر : رمل تام 1(@)(@@) % زملوني زملوني لا تقل % إنني الشهر الذي في شهرناز % 2(@)(@@) % زبرت شهر الذي قد زبرت % كفنا من كل حق ومجاز % % 3(@)(@@) % زينة الله التي أخرجها % % قد دعت زينة نفسي للبراز % 4(@)(@@) % زجرتها همة علوية % % في وجوب ومحال وجواز % 5(@)(@@) % زينتي يسمع ما أسرده % وإليه كان منه الإنحياز % 6(@)(@@) % زين السوء كذا قال لنا % % لم يقل زينة للإمتياز % 7(@)(@@) % زينت أسماؤه حضرته % فالذي يحفظه بالعلم فاز % % 8(@)(@@) % زهرة الروض شذاها عنبر % % فالذي استنشقها 
ms138	 فاز وحاز % % 9(@)(@@) % زهرة في فلك سابحة % من يراها هام فيها ثم جاز % % 10(@)(@@) % زينب ترف والله الذي % % قلته في كل سهل وعزاز % % PageV01P530 البحر : خفيف تام 1(@)(@@) % أي أمر من الأمور يكون % فرض عين وتشتهيه النفوس % 2(@)(@@) % كل أمر تمجه غير أمر % % أدخلي جنة العلى يا عروس % PageV01P531 البحر : بسيط تام 1(@)(@@) % من طهره الله لم يلحق به دنس % وهو المقدس لا بل عينه القدس % 2(@)(@@) % كأهل بيت رسول الله سيدنا % % وهو الإمام الكريم السيد الندس % 3(@)(@@) % جاء البشير بما الآذان قد سمعت % % ألقى قليلا وجل القوم قد نعسوا % % 4(@)(@@) % ناموا عن الحق لا بل عن نفوسهم % عند المواهب والأقوام ما بخسوا % % 5(@)(@@) % لما تحقق أن النوم حاكمهم % % من أجل ذا جعل الحفاظ والحرس % % 6(@)(@@) % من أجل ذا كانت البشرى وكان لهم % % من أجل نومهم حفظا لهم مس % % 7(@)(@@) % فعندما عصموا من كل حادثة % تصيب أمثالهم قاموا وما جلسوا % % 8(@)(@@) % بحق سيدهم في كل آونة % % على الصفاء وما خانوا وما لبسوا % % 9(@)(@@) % على نفوسهم علما بحالهم % لذاك عن مشهد التحقيق ما اختلسوا % % 10(@)(@@) % إن الوجود الذي قد عز مطلبه % فيه وفي مثله الأرواح تفترس % % PageV01P532 11(@)(@@) % أغارت الخيل ليلا في عساكرهم % فقيل قد قتلوا إذ قيل كبسوا % % 12(@)(@@) % لو أنهم علموا الأمر الذي جهلوا % % على رؤوسهم والله ما نكسوا % % 13(@)(@@) % أقول قولا وما في القول من حرج % ينفي عن النفس ما إغمها النفس % 14(@)(@@) % ما نال موسى بما يبغيه من قبس % % إلا الذي ناله من أجله القبس % % 15(@)(@@) % لو أن أهل وجود الجود نالهم % ما نال موسى من الرحمن ما بئسوا % % 16(@)(@@) % لكنهم بئسوا من ذاك واعتمدوا % % على ظنونهم بالجود إذ يئسوا % % 17(@)(@@) % إني رأيت فتى أعطى الفتوح له % بأرض أندلس الماء والبلس % % 18(@)(@@) % ولم يكن عنده نطق يقوم به % % وقد تحكم فيه الصمت والخرس % % 19(@)(@@) % كمثل مريم قد كانت سجيته % في رزقه فهو في الراحات يلتمس % 20(@)(@@) % وذاك من أعجب الأحوال إن له % حال الغنى وهو بين الناس مبتئس % PageV01P533 21(@)(@@) % أحوال 
ms139	 شخص لأمر الله ممتثل % للحكم مقتنص للنور مقتبس % 22(@)(@@) % إن الإمام الذي تجري الأمور به % في كل نهر من الأحوال ينغمس % % 23(@)(@@) % والسر يحكمه لا بل يحكمه % % في نفسه وبه السادات قد أنسوا % % 24(@)(@@) % فما لهم قدم في غير حضرته % % وما لجانبه منهم فمندرس % % 25(@)(@@) % هم الحيارى السكارى في محارتهم % % وما لهم في جناب الحق ملتمس % 26(@)(@@) % الحال أفناهم عنهم وما عرفوا % % من هم لذلك قيل اليوم قد نفسوا % % 27(@)(@@) % لو أنهم مزقوا منهم وما لهم % لديه من كل خير فيه ما انتكسوا % % 28(@)(@@) % الذات تبهم ما الأسماء توضحه % % والقوم ما قرأوا علما وما درسوا % % 29(@)(@@) % كانت عليهم من أثواب العلى حلل % فبئس ما خلعوا ونعم ما لبسوا % % 30(@)(@@) % دخلت جنة عدن كي أرى أثرا % % فقيل ليس جناهم غير ما غرسوا % % PageV01P534 البحر : رمل تام 1(@)(@@) % وقال أيضا : إنما الإنسان أنفاسه % % وهو للحق جلاسه % % 2(@)(@@) % فإذا ما ينقضي نفس % أخليت في الحين أكياسه % % 3(@)(@@) % فإذا لم يبق من نفس % ينقضي ما فيه إفلاسه % % 4(@)(@@) % والذي يدري إشارتنا % % أنهم للدهر أكياسه % % PageV01P535 البحر : بسيط تام 1(@)(@@) % لله نفس وللرحمن أنفاس % وللمنازع فيما قلت إبلاس % % 2(@)(@@) % وللموافق فيما قلته طرب % وفرحة وسرور فيه إيناس % 3(@)(@@) % من آنس النور نارا عند حاجته % % بالواد بالطور لم يأتيه إقباس % % 4(@)(@@) % فآض وهو كليم الله ليس له % % سوى غنى ليس فيه الدهر إفلاس % % 5(@)(@@) % أغناه عن طلب المطلوب في قبس % % ولم يكن ثم إلا الشرب والكاس % 6(@)(@@) % نديمه عين ساقيه فليس له % في غيره غرض فناسه الناس % 7(@)(@@) % إني سمعت كلام الله من أذني % % من بلة قدر كفي ما بها باس % % PageV01P536 البحر : بسيط تام 1(@)(@@) % لما حللت مقام القلب إدريسا لما حللت مقام القلب إدريسا % ولم أجد فيه تخييلا وتلبيسا % % 2(@)(@@) % حللت من مشكلات العلم ما انعقدت % % فكل ذي علة بشرحها يوسى % % 3(@)(@@) % ورثت منه النبي المصطفى وكذا % % مع الذي عندنا من روحه عيسى % % 4(@)(@@) % وآدم ثم إبراهيم والدنا % % وداود والكليم المجتبى موسى % % PageV01P537 البحر : كامل تام 1(@)(@@) % من 
ms140	 يتخذ غير الإله جليا % أضحى عليه مقدما ورئيسا % % 2(@)(@@) % وبحكمة يجري فإن بلغ المدى % % أمسى لربات الحجال حبيسا % % 3(@)(@@) % فإذا انجلى ذاك الجليس لقلبه % % ظهر الخسيس مع الجلاء نفيسا % % 4(@)(@@) % ودرى بأن الحق فيه فلم يكن % % لسوى الإله مع الشهود جليسا % % 5(@)(@@) % لما علمت به علمت حقيقتي % % فأبحت قلبي من أراد جلوسا % % PageV01P538 البحر : سريع 1(@)(@@) % يا قمر الأسرار يا ملبسي % % غلالة من أخضر السندس % 2(@)(@@) % أصبحت معشوقا ترى يابسا % لولا لهيب النار لم تيبس % 3(@)(@@) % جلست فيه زمنا عاجلا % لذاك تدعى صاحب المجلس % % 4(@)(@@) % رأست فيه بعلوم بدت % فيك ولولا ذاك لم ترأس % % 5(@)(@@) % فأنت تسري في ثمان وفي % % عشرين حساسا على الكنس % 6(@)(@@) % على جواد سابح صيغ من % % نحاس قاصى صنعة المفلس % PageV01P539 البحر : طويل 1(@)(@@) % هنيئا لأهل الشرق من حضرة القدس % بشمس جلت أنوارها ظلمة الرمس % 2(@)(@@) % وجلت عن التشبيه فهي فريدة % فليست بفصل في الحدود ولا جنس % 3(@)(@@) % ويدرك منها في الكمال وجودنا % % كما يدرك الخفاش من باهر الشمس % 4(@)(@@) % فلله من نور أتته رسالة % تصان عن التخمين والظن والحدس % 5(@)(@@) % أتانا بها والقلب ظمآن تائه % إلى المنظر الأعلى إلى حضرة القدس % 6(@)(@@) % فجاء ولم يحفل بيوت كثيرة % % فخاطبها من حضرة النعل والكرسي % % 7(@)(@@) % أنا البعل والعرس الكريم رسالتي % % فبورك من بعل وبورك من عرس % % 8(@)(@@) % غرست لكم غصن الأمانة يانعا % وإني لجان بعده ثمر الغرس % 9(@)(@@) % تولعت بالتبليغ لما تبينت % أمور ترقيني عن الأنس والإنس % 10(@)(@@) % ورحت وقد أبدت بروقي وميضها % % وجزت بحار الغيب في مركب الحس % % PageV01P540 11(@)(@@) % ونمت وما نامت جفوني غدية % وتهت بلا تيه عن الجن والإنس % 12(@)(@@) % فيا نفس بذا الحق لاح وجوده % فإياك والإنكار يا نفس يا نفسي % % 13(@)(@@) % فعني فتش في تلقان في أنا % % أنا في أنا إني أنا في أنا نفسي % % PageV01P541 البحر : بسيط تام 1(@)(@@) % هب النسيم مع الإمساء والغلس % بعرف روض النهى من حضرة القدس % 2(@)(@@) % فشم بريقا بأفق البين لاح لنا % % يدل أن عيون الماء في البلس % % 3(@)(@@) % ألم 