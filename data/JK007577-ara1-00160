ms141	 الشعب من إيوان % % 24(@)(@@) % وسحاب جود يمينه لا ينثني % % تسكابها عن وابل هتان % % 25(@)(@@) % أيقنت لما أن مثلت ببابه % % أن النجوم تشوفت لمكان % % 26(@)(@@) % شاهدت كسرى منه في إيوانه % % ولقيت رب التاج من غمدان % % 27(@)(@@) % من آل سعد الخزرج بن عبادة % % صحب الرسول وأسرة الفرقان % % 28(@)(@@) % المؤثرين على النفوس بزادهم % % والمفعمين حقائب الضيفان % % 29(@)(@@) % إن سوبقوا سبق المدى أو كوثروا % % فهم النجوم علا وعز مكان % % 30(@)(@@) % قوم إذا لاثوا العمائم واحتبوا % % ذلت لعزهم ذوو التيجان % % PageV01P572 31(@)(@@) % أو قام في نادي الملوك خطيبهم % % خروا له رهبا على الأذقان % % 32(@)(@@) % أسليل مجدهم وسبط فخارهم % % ومؤمل القاصي وقصد الدان % % 33(@)(@@) % أعليت بنيانا على ما أسسوا % % فتعاضد البنيان بالبنيان % % 34(@)(@@) % فهم الأصول زكت ولكن إنما % % فضل الجنى من شيمة الأفنان % % 35(@)(@@) % عجبا لمن يعتد دونك جنة % % وغرار سيفك في يد الرحمن % % 36(@)(@@) % ولمن عصاك وظن أن ستجيره % % أنصار جار أو سحيق مكان % % 37(@)(@@) % لكم جنى نصر مآثر لم تكن % % لبني الرشيد ولا بني مروان % % 38(@)(@@) % باهت بلادكم البلاد فأصبحت % % غرناطة تزهى على بغدان % % 39(@)(@@) % قمتم بأمر الله في أقطارها % % ما بين غلظة قدرة وليان % % 40(@)(@@) % قدتم بها الجرد المذاكي شردا % % غبر النواصي ضمر الأبدان % % PageV01P573 41(@)(@@) % وقهرتم من رامها لمساءة % % فغدا معنى ربقة الأذعان % % 42(@)(@@) % لله يوم المرج لا بعدت به % % أيدي الزمان وشفعته بثان % % 43(@)(@@) % صدمته أحزاب الضلال كأنما % % هول الجبال تخب في أرسان % % 44(@)(@@) % هابوا الشرى فتخاذلت عزاماتهم % % جهل الرعاة قضى بهلاك الضان % % 45(@)(@@) % فكأنهم والمشرفية فوقهم % % نار القبول أتت على قربان % % 46(@)(@@) % لله نارا هلكت عبادها % % هندية تغدو بغير دخان % % 47(@)(@@) % نار ولكن في متون غرارها % % ماء يؤجج غلة الظمآن % % 48(@)(@@) % وكذا السيوف ملثمة أنواؤها % % والشمس في جدي وفي سرطان % % 49(@)(@@) % ورسمتم تاريخ كل وقيعة % % في مهرق التلعات والكثبان % % 50(@)(@@) % أعضاؤهم فيها حروف قطعت % % أثر المداد بها نجيع قان % % PageV01P574 51(@)(@@) % فاضرب بخيشك ما وراء ثغورهم % % فمن الملائك دونه جيشان % % 52(@)(@@) % لن تلقى مجتمعا لكفر بعدها % % قد حيل بين العير والنزوان % % 53(@)(@@) % بشراك 
ms142	 أن الله أكمل عيدنا % % بالعفو منك ومنه وبالغفران % % 54(@)(@@) % عيد أعاد على الزمان شبابه % % فاعجب لأشمط عيد في ريعان % % 55(@)(@@) % أضحى بك الأضحى وقد طلعت به % % شمس الضحى وكلاكما شمسان % % 56(@)(@@) % ومددت للتقبيل يمناك التي % % هي والحيا في نفعها سيان % % 57(@)(@@) % شكرت لك الدنيا صنيعكما عندها % % لما شفيت زمانة الأزمان % % 58(@)(@@) % أندرت قبل النضج لما جئتها % % ملكا وكان البرء في البحران % % 59(@)(@@) % مولاي لا تنسى وسائل من له % % للدولة الغراء سبق رهان % % 60(@)(@@) % واسأل مواقفنا ببابك يوم لم % % يدع لخدمته سوى الخلصان % % PageV01P575 61(@)(@@) % قد كان والدك الرضى يرعى لها % % ذمما ويذكرها مع الأحيان % % 62(@)(@@) % خدما رآها بالعيان حميدة % % والموت يحضر من ظبا لسنان % % 63(@)(@@) % فلكم يدهي الرق في أعناقها % % ولنا حقوق نصائح العبدان % % 64(@)(@@) % خذها أمير المسلمين بديعة % % سحبت بدائعها على سحبان % % 65(@)(@@) % تطوي البلاد مشارقا ومغاربا % % قسية تثني بكل لسان % % 66(@)(@@) % ويقر بالتقصير عند سماعها % % رب القصائد في بني حمدان % % 67(@)(@@) % سلفت نسيم الروض رقة عطفها % % ووقارها على ثهلان % % 68(@)(@@) % قضت البلاغة لي بفوز قداحها % % في الشعر يوم تنازع الخصمان % % 69(@)(@@) % ونبغت في زمن أخير أهله % % ما ضر أني لست من ذبيان % % 70(@)(@@) % ما كل من نظم القوافي شاعر % % أو كل مصقول الغرار يمان % % PageV01P576 71(@)(@@) % إن لم أدعها في امتداحك فذة % % مثلا شرودا لست من سلمان % % PageV01P577 البحر : - 1(@)(@@) % أمولاي إن الشعر ديوان حكمة % % يفيد الغنى والعز والجاه من كانا % % 2(@)(@@) % وقد قعد المختار في الحفل منصتا % % له وحبا كعبا عليه وحسانا % % 3(@)(@@) % وفيما رواه الناقلون وأثبتوا % % بذلك ديوانا صحيحا فديوانا % % 4(@)(@@) % بأن أبا بكر خليفته الرضا % % وفاروقه الأدنى إليه وعثمانا % % 5(@)(@@) % وأن عليا قدس الله جمعهم % % وكرمنا بالقرب منهم وجارانا % % 6(@)(@@) % لهم في ضروب القول إذ هم نجاره % % خطاب وشعر يستقران تبيانا % % 7(@)(@@) % وفاض على أهل القريض نوالهم % % فروض روض القول سحا وتهتانا % % 8(@)(@@) % وأنت أحق الناس أن يفعل الذي % % به فعل المختار دينا وإيمانا % % 9(@)(@@) % فما زلت تهدي في البرية هديه % % وتقضي بما يرضيه سرا وإعلانا % % 10(@)(@@) % وإن 
ms143	 قيل قدر المرء ما هو محسن % % فصنعة نظم القول أرفعه شانا % % PageV01P578 البحر : - 1(@)(@@) % سقى علم الجنتين فالجزع فالبانا % % ملث يباري الرسم . . . وتهتانا % % 2(@)(@@) % فإن عد تسكابا معالم أنسها % % وحيا بمسراها هضابا وغيطانا % % 3(@)(@@) % ومد برود النبت في قنن الربا % % وحلى عروس الدوح درا وعقيانا % % 4(@)(@@) % معاهد لذات ربوع مآرب % % هصرنا بها غصن الشبيبة فينانا % % 5(@)(@@) % فكم ليلة لي للمنى في رياضها % % أجرر من عصب الفكاهة أردانا % % 6(@)(@@) % روينا عن الضحاك مسند زهرها % % وقد مثلت فيها المشائخ أغصانا % % 7(@)(@@) % وأدت عن البكاء سحب غمامه % % فروى صدى النبت المشيم وروانا % % 8(@)(@@) % وقد رف جيد الغصن في حلي زهره % % ونافح راح الظل فارتاح نشوانا % % 9(@)(@@) % وهزت وقور الروض نغمة قينة % % من الورق إذ باتت ترجع ألحانا % % 10(@)(@@) % فجاد بها ما ضن من در زهره % % وأرخص من حلي الخمائل ما صانا % % PageV01P579 11(@)(@@) % أبا حسن ما شئت بعدك منظرا % % يروق ولا خامرت نفسي سلوانا % % 12(@)(@@) % ولا حل في قلبي لغيرك خضرة % % ولا استحسنت عيناي بعدك إنسانا % % 13(@)(@@) % ألا من نصيري في جلاد تباعد % % ألا من مجيري من نوى مد أشطانا % % 14(@)(@@) % وقد كنت أستقري حديثك قبلها % % فها أنا أستقري تحيتك الآنا % % PageV01P580 البحر : - 1(@)(@@) % ما لقلبي إذا هفا البرق حنا % % وصبا للنسيم من أرض لبنا % % 2(@)(@@) % وإذا ما الظلام حل عراه % % عايد الشوق والغرام فجنا % % 3(@)(@@) % خبروها أني سلوت فقالت % % أن يشيب الغراب عندي أدنا % % 4(@)(@@) % ثقة بالوفاء في عهد خل % % أصبح العهد عنده مطمئنا % % 5(@)(@@) % يا ابنة الحي إن سلوت سلوناك % % وإن حلت عن عهودك حلنا % % 6(@)(@@) % ما الذي تنكرينه من معناك % % أبخلا أم كبرة أوجبنا % % 7(@)(@@) % لمة ودها الخضاب وغصن % % هز منه الشباب غصنا لدنا % % 8(@)(@@) % وندى يؤثر الضيوف على الأهل % % إذا ما نوء السماوات ضنا % % 9(@)(@@) % وسلي اليوم هل ثنيت عنانا % % عن ثناء أو صعدة تتثونا % % 10(@)(@@) % طال ما بت في تحسدك الترب % % وتصغي لما تناجيه أذنا % % PageV01P581 11(@)(@@) % وهي البدر غير أن عفافي % % طاب خبرا وطال فضلا وردنا % % PageV01P582 البحر : - 1(@)(@@) % هات الحديث عن 
ms144	 الركب الذي بانا % % هل جاوز الشعب أم هل يمم البانا % % 2(@)(@@) % أحبابنا إن نأت يوما دياركم % % عنا فما زلتم بالقلب سكانا % % 3(@)(@@) % إذا دعتنا إلى السلوان بعدكم % % نفوسنا قامت الأشواق تنهانا % % 4(@)(@@) % في ذمة الله أحباب لنا ارتحلوا % % دانوا محبهم مثل الذي دانا % % 5(@)(@@) % فإن شكونا إليهم ما نكابده % % شكوا من البعد عنا مثل شكوانا % % 6(@)(@@) % يا نسمة الريح من تلقاء أرضهم % % جرر على الطيب أذيالا وأردانا % % 7(@)(@@) % واقر السلام على من لست أذكره % % وإن كنيت بهند عنه أحيانا % % 8(@)(@@) % اسأله أين عهود بيننا أخذت % % كأن ما كان منه قط ما كانا % % 9(@)(@@) % وقل له أنت روحي يا معذبه % % فلا أرى عنك طول الدهر سلوانا % % 10(@)(@@) % قد صار دمعي بحرا في محاجره % % وأصبت وسطه الأجفان أجفانا % % PageV01P583 11(@)(@@) % ما رأى يا منى نفسي وبغيتها % % إنسان عيني لما غبت أعيانا % % 12(@)(@@) % قد كان وصلك يوما ليس يقنعي % % فصار يقنع قلبي ذكرك الآنا % % 13(@)(@@) % يا سامعين من العذار إفكهم % % بالله لا تسمعوا زورا وبهتانا % % 14(@)(@@) % يا صاح لا تبك عهدا للوصال مضى % % عنا حميدا وأوطارا وأوطانا % % 15(@)(@@) % هون عليك فما الشكوى بنافعة % % وكل صعب إذا هونته هانا % % 16(@)(@@) % وانظر إلى الروض إذ هبت محدرة % % طلائع الريح كيف اهتز وازدانا % % 17(@)(@@) % وجرد الماء من عهد الظلال به % % سيفا من الجدول المسلول عريانا % % 18(@)(@@) % وأوتر القوس في آفاقه قزح % % يرمي قد راح أنهارا وغدرانا % % 19(@)(@@) % وأرسل الغيم نبلا من سحائبه % % أدمى بغيثها وردا ونعمانا % % 20(@)(@@) % فهاتها كشعاع الشمس مشرقة % % كأن في الكأس ياقوتا وعقيانا % % PageV01P584 21(@)(@@) % واشرب على نغمة الأوتار مصطحبا % % وبح بسر الهوى ولا تبق كتمانا % % 22(@)(@@) % واركض إلى اللهو أفراس الصبا مرحا % % إذا وجدت لخيل اللهو ميدانا % % 23(@)(@@) % ولا تضع فرص اللذات إن لنا % % ربا كريما يقيل الذنب غفرانا % % 24(@)(@@) % وكيف نرهب من خطب ألم بنا % % يوما ويوسف بعد الله مولانا % % PageV01P585 البحر : - 1(@)(@@) % مالي على شرفي ورفعة شان % % وعظيم أنصاري وعز مكاني % % 2(@)(@@) % لعب الغرام بمهجتي وجنان % % عجبا يهاب الليث حد سنان % % 3(@)(@@) % وأهاب 
ms145	 لحظ فواتر الأجفان % % 4(@)(@@) % أصبحت في أمر الهوى متعجبا % % أهدي إلى الأعداء باسا صيبا % % 5(@)(@@) % وأرى الردى في الحرب عذبا طيبا % % وأقارع الأهوال لا متهيبا % % 6(@)(@@) % منها سوى الأعراض والهجران % % 7(@)(@@) % أخفيت سري في الضلوع مكتما % % حتى وشى دمعي به وتكلما % % 8(@)(@@) % وأصاب سهم اللحظ قلبي إذ رمى % % وتملكت نفسي ثلاث كالدما % % 9(@)(@@) % بيض الوجوه نواعم الأبدان % % 10(@)(@@) % أطلعن من غرر الحجال الباهر % % أقمار حسن تحت سود غدائر % % PageV01P586 11(@)(@@) % وسفرن عن مثل الصباح السافر % % ككواكب الظلماء لحن لناظر % % 12(@)(@@) % من فوق أغصان على كثبان % % 13(@)(@@) % من كل ناظرة بعيني جؤذر % % مختالة في الحلي ذات تبختر % % 14(@)(@@) % تعطو كخوط البانة المتناظر % % هذي الهلال وتلك بنت المشتر % % 15(@)(@@) % حسنا وهذي أخت غصن البان % % 16(@)(@@) % لما غدوت بحبهن معذبا % % وعلمت أني لم أصادف مهربا % % 17(@)(@@) % وإذا دعوت لسلوة قلبي أبي % % حاكمت فيهن السلو إلى الصبا % % 18(@)(@@) % فقضى بسلطان على سلطان % % 19(@)(@@) % عجبا لأجفان ضعيفات القوى % % تركنني رهن السقام بلا دوى % % 20(@)(@@) % لولا الهوى أنحى على جبل هوى % % لا تعذلوا ملكا تذلل للهوى % % PageV01P587 21(@)(@@) % ذل الهوى عز وملك ثان % % 22(@)(@@) % مالي وغصن العمر غض ما ذوى % % والشمل لا تدنو إليه يد النوى % % 23(@)(@@) % أطوي الضلوع على الصبابة والجوى % % إن لم أطع فيهن سلطان الهوى % % 24(@)(@@) % كلفا بهن فلست من مروان % % 25(@)(@@) % أخلدت طوعا للهوى وإنابة % % ولئن نحلت ضنا وذبت كآبة % % 26(@)(@@) % فلقبل ما علق الوليد حبابة % % ما ضر أني عبدهن صبابة % % 27(@)(@@) % وبنو الزمان وهن من عبدان % % PageV01P588 البحر : - 1(@)(@@) % ولما رأت عزمي حثيثا على السرى % % وقد رابها صبري على موقف البين % % 2(@)(@@) % أتت بكتاب الجوهري دموعها % % فعارضت من دمعي بمختصر العين % % PageV01P589 البحر : - 1(@)(@@) % يعاهدني دمعي على كتم سره % % ويجري إذا ذكر جرى ويمين % % 2(@)(@@) % وذلك لأني من نجيعي خضبته % % وليس لمخضوب البنان يمين % % PageV01P590 البحر : - 1(@)(@@) % ذكروا العهود فهاج من أشجاني % % شوق إذا جن الدجى ناجاني % % 2(@)(@@) % فكأنما الآماق مني أبحر % % يقذفن بالياقوت والمرجان % % 3(@)(@@) % ولو أنني أمسكت أجفاني وقد % % ذكروا العهود لقلت ما أجفاني 
ms146	 % % 4(@)(@@) % أشكو إلى الله الفراق فإنني % % مالي بما فعل الفراق يدان % % 5(@)(@@) % يا لا رعى الله الرمال ولا سقى % % منها ملث القطر شر مكان % % 6(@)(@@) % جبلا لطارق مذ أقل ركابه % % لم تهن عنه طوارق الحدثان % % 7(@)(@@) % يا مجمع البحرين كم مزقت من % % جمع وكم باعدت بعد تدان % % 8(@)(@@) % لولا عسى ولعل بان تجلدي % % وبرئت من صبري ومن كتماني % % 9(@)(@@) % ومن اللطائف واللطائف رحمة % % لله في سر وفي إعلان % % 10(@)(@@) % خود أتتني خلسة في غرفتي % % وأرتني الآمال رأي عياني % % PageV01P591 11(@)(@@) % قد كنت في نار البعاد معذبا % % فدخلت منها جنة الرضوان % % 12(@)(@@) % وجررت للخيلاء ذيلي عندها % % وجريت في الإعجاب ملء عناني % % 13(@)(@@) % وكأنني عاطيت كأس مدامة % % صهباء بين مثالث ومثان % % 14(@)(@@) % زارت وقد جارت علي يد الضنى % % والسقم قد أنحى على جثماني % % 15(@)(@@) % فاستقبلت بالبرء كل تألم % % واستدركت فضل الذماء الفاني % % 16(@)(@@) % طب المسيح بعثت يابن سميه % % في رقية خفيت عن الأذهان % % 17(@)(@@) % سخرت بدائعها التي أودعتها % % بزمانها هذا وكل زمان % % 18(@)(@@) % يا أيها القاضي الذي لم يختلف % % في القصد منه والكمال اثنان % % 19(@)(@@) % إني ظفرت بمنحة وذخيرة % % من ودك الباقي على الأزمان % % 20(@)(@@) % وغرست حبك في الفؤاد فأصبحت % % أدواحه مخضرة الأفنان % % PageV01P592 21(@)(@@) % ولكم أخ للخطب قد أعددته % % لم تجن منه يدي سوى الخطبان % % 22(@)(@@) % ولكم حميم قد وردت جمامه % % فشرقت منها بالحميم الآن % % 23(@)(@@) % حركت مني فطنة أفكارها % % وقف على البرحاء والأشجان % % 24(@)(@@) % أو بعد شطر الحول مغتربا على % % حكم الليالي نازع الأوطان % % 25(@)(@@) % تذكو لدي من البيان شرارة % % وتشام بارقة من العرفان % % 26(@)(@@) % لازلت تبدي وجه كل غريبة % % يملي حديث بديعها الملوان % % 27(@)(@@) % وتجيل في يوم البيان جياده % % فيقال هذا فارس الميدان % % 28(@)(@@) % ما أن في السحر الحمام بنغمة % % رقصت لها طربا غصون البان % % PageV01P593 البحر : - 1(@)(@@) % لك الله فيما تنتحيه وما تقضي % % فأنت الذي أقرضته أحسن القرض % % 2(@)(@@) % وأنت الذي أحييت شرعة دينه % % وقد رفضت أحكامها أيما رفض % % 3(@)(@@) % وأنت مددت العدل فوق بلاده % % فأصبحت بعد الجهد في عيشة خفض 
ms147	 % % 4(@)(@@) % ولولاك لم تنهل بالغيث ديمة % % ولم ترفل الأغصان في الورق الغض % % 5(@)(@@) % ولا قر قلب في قرار ضلوعه % % ولم تعرف الأجفان ما لذة الغمض % % 6(@)(@@) % ولما أبى الأعداء إلا لجاجة % % نهضت بأمر الله أحسن ما نهض % % 7(@)(@@) % مقيما بما استدعاك فرض جهادهم % % ولم تأل في ندب إليه وفي حض % % 8(@)(@@) % وأعددت من غر الجياد صوافنا % % مطهمة من كل أجرد منقض % % 9(@)(@@) % يشف حجاب النقع عن قسماتها % % كما شف جهم السحب عن بارق الومض % % 10(@)(@@) % وما راع ملك الروم إلا طلوعها % % سوابح تزجيها رياح من الركض % % PageV01P594 11(@)(@@) % ونادى لسان الفتح في عرصاتهم % % كذلك مكنا ليوسف في الأرض % % PageV01P595 البحر : - 1(@)(@@) % هلم فجفن الدهر قد لاذ بالغمض % % وأمكن ميدان التصابي من الركض % % 2(@)(@@) % إلى مجلس حيا مقاصده الحيا % % وراح به الريحان في الطول والعرض % % 3(@)(@@) % ويوم كأخلاق الصبي إذا بكى % % حبته من الصحو السماء بما يرضى % % 4(@)(@@) % فيضحك أحيانا ويعبث تارة % % فمن ضحك يأتي ومن عبرة تمضي % % 5(@)(@@) % وروض دنت للهاصرين قطوفها % % فكان كلام القوم بعضا إلى بعض % % 6(@)(@@) % أهذي التي كنا وعدنا بنيلها % % وجنة عدن في السماء أم الأرض % % 7(@)(@@) % كأن الصبا جاءت تخبر قضبها % % سحيرا بأن الوقت ضاق عن الفرض % % 8(@)(@@) % فأسرعت الأغصان تبتدر الثرى % % وتعمر باقي الوقت منه بما تقضي % % 9(@)(@@) % وسالت دموع الطل عند سجودها % % كما بكت العباد من خشية العرض % % 10(@)(@@) % ونامت جفون النرجس الغض بينها % % كأن خضيب الطير قال لها غض % % PageV01P596 11(@)(@@) % فمن أبيض كالدر حف بأصفر % % هناك ومصفر يحف بمبيض % % 12(@)(@@) % ترى النحل في أثنائهن كأنما % % صيارف عاثت في الدراهم بالقرض % % 13(@)(@@) % ومرضعة طفلا من العود ثديها % % ولا در إلا الدر من أدب محض % % 14(@)(@@) % كأن أباه الدوح ورد خدها % % بما جاده نيسان من ورده الغض % % 15(@)(@@) % وتطلب أحيانا بفرض رضاعه % % فيبتز من تلك الدراهم في الفرض % % 16(@)(@@) % إذا لمسته بالبنان تخالها % % طبيبا من الحذاق جس على نبض % % 17(@)(@@) % وتدني إليه السمع تصغي كأنه % % يحقق قدر البسط فيه من القبض % % 18(@)(@@) % وراح إذا ناجيت في 
ms148	 الكأس روحها % % رأيت اتصال الروح بالعالم الأرض % % 19(@)(@@) % إذا طلعت مفترة في سعودها % % تبشر أحكام السرور بما تقضي % % 20(@)(@@) % إذا سمح الدهر الضنين بساعة % % فعض عليها جاهدا أيما عض % % PageV01P597 21(@)(@@) % فإن لم يساعدك الزمان فإنما % % وجودك في الأيام كالعدم المحض % % PageV01P598 البحر : - 1(@)(@@) % حكم الجفون على فؤادي ماض % % كيف التخلص والخصيم القاضي % % 2(@)(@@) % ومن العجائب أن أحكام الهوى % % جور ولكني بذلك راض % % 3(@)(@@) % يا بانة تلوي معاطفها الصبا % % للحسن بين حدائق ورياض % % 4(@)(@@) % غمزات طرفك في القلوب تخالها % % مثل السهام مضت إلى الأغراض % % 5(@)(@@) % ولدت أشكال الجمال بوجنة % % ألفت فيها حمرة ببياض % % 6(@)(@@) % وأصبت لي قلبا صحيحا سالما % % عمدا بأجفان لديك مراض % % 7(@)(@@) % عذب بما ترضى وما تختاره % % قلبي بسوء الصد والأعراض % % 8(@)(@@) % واعطف علي بوزرة يا بغيتي % % فلقد غرقت بدمعي الفياض % % 9(@)(@@) % وتعال نأخذ بالهوى عهدا كما % % كنا عليه في الزمان الماضي % % PageV01P599 البحر : - 1(@)(@@) % وأحول يعدي القلب سقمى جفونه % % فتضحى صحيحات الجسوم به مرضى % % 2(@)(@@) % رأى الحسن أن اللحظ منه مهند % % فحرفه كيما له يكون أمضا % % PageV01P600 البحر : - 1(@)(@@) % أبا الفضل عاتب أباك الرضى % % وقل يغفر الله ما قد مضا % % 2(@)(@@) % وذكره مني ودادا قديما % % وعهدا أبى الله أن ينقضا % % 3(@)(@@) % وسله عوائد إغضائه % % فقلبي في جمرات الغضا % % 4(@)(@@) % جفى النوم جفني لما جفى % % وأعرض أنسي إذ أعرضا % % 5(@)(@@) % ولكنني أرتجي عطفه % % وشيكا وآمن منه الرضا % % PageV01P601 البحر : - 1(@)(@@) % يا روضة للأدب المجتنى % % أغرقها الشامت في حوض % % 2(@)(@@) % قلنا وقد بللها ماؤه % % لا ينكر الماء على الروض % % PageV01P602 البحر : - 1(@)(@@) % سقى دارهم هام من السحب هامع % % ولا أجدبت تلك الربى والأجارع % % 2(@)(@@) % ينوب عن الأجفان في عرصاتها % % إذا كل منها عارض متتابع % % 3(@)(@@) % وحيا بها عهدا إذ العيش ناعم % % نضير وإذ روض الشبيبة يانع % % 4(@)(@@) % وقفنا عليها الركب يوما وبعده % % وثالث يوم واقتضى السير رابع % % 5(@)(@@) % نعفر في الآثار حر خدودنا % % ونشكو إلى الأطلال ما البين صانع % % 6(@)(@@) % فكم قد روت عنابها تلكم الربى % % أحديث شكوى سلسلتها المدامع % % 7(@)(@@) % معاهدنا التي محت حسنها 
ms149	 النوى % % ترى هل ليالي الأنس فيك رواجع % % 8(@)(@@) % ويسكن قلب من بعادك خافق % % ويرقأ جفن من فراقك دامع % % 9(@)(@@) % يمينا بعهد القرب فيك إذ الهوى % % قشيبا وإذ شمل الأحبة جامع % % 10(@)(@@) % لما خامر السلوان بعد قلوبنا % % ولا عرفت منا الجنوب المضاجع % % PageV01P603 11(@)(@@) % وإنا ليعرونا إليك تشوق % % إذا لاح برق من ثناياك لامع % % 12(@)(@@) % ومن عجب أن خاننا فيك عزمنا % % ولا العهد منسي ولا الحي شاسع % % 13(@)(@@) % وما أن تنكبنا الوفاء طريقة % % ولا برحت تحنو عليه الأضالع % % 14(@)(@@) % ولكننا جئنا من الأرض جنة % % فهل للعباد الفائزين مشارع % % 15(@)(@@) % فأبصارنا وقف على كل منضر % % يروق وفيها ما تلذ المسامع % % 16(@)(@@) % ومن حل هذا الملك لم يبق بعده % % رحيلا ولم ينزع به عنه نازع % % 17(@)(@@) % حللنا من الأنصار حيا بنوره % % أضاءت لأرباب اليقين المطالع % % 18(@)(@@) % وغابا لأسد الله دون مرامه % % جنود السموات الطباق تدافع % % 19(@)(@@) % فإن غال خطب فهوى مأوى من الردى % % وإن جل ذنب فهو في الذنب شافع % % 20(@)(@@) % وفاضت علينا من مواهب يوسف % % بحار لغلات الظماء نواقع % % PageV01P604 21(@)(@@) % ولاحت لنا من بشره ونواله % % سحاب هوام أو شموس طوالع % % 22(@)(@@) % فلم نر من قبل استلام يمينه % % بحار نوال قيل هن أصابع % % 23(@)(@@) % ألا هكذا فليحرز المجد ربه % % وتبنى المعالي أو تربى الصنائع % % 24(@)(@@) % أمير العلا لولاك لم تنب روعة % % ولم تعرف النوم العيون الهواجع % % 25(@)(@@) % ولا سكنت هذي الجزيرة برهة % % وأصبحت الأوطان وهي بلاقع % % 26(@)(@@) % ولا عرف الحق المبين من الهوى % % ولا مثلت للسالكين المهايع % % 27(@)(@@) % ولما استشاط الكفر بين بلادها % % وقادته لاستئصالهن المطالع % % 28(@)(@@) % أعدك فيها الله تنصر دينه % % وتصدع بالحق الذي أنت صادع % % 29(@)(@@) % وتمضي كما يمضي القضاء بقدرة % % من الله لا يلفى لها الدهر دافع % % 30(@)(@@) % وكتبت من أسد الحفاظ كتائبا % % إذا ثوب الداعي أتته تسارع % % PageV01P605 31(@)(@@) % إذا سحبوا ذيل الدروع إلى الوغى % % كما تسحب السحب البدور الطوالع % % 32(@)(@@) % تحركت الأجبال واشتعل الفلا % % وزلزل من هذي البسيطة وادع % % 33(@)(@@) % وأعددت من غر الجياد صوافنا % % تغار بأدناها البروق اللوامع % % 34 
ms150	(@)(@@) % مطهمة جردا لها من دم العدا % % شيات ومن نسج القتام البراقع % % 35(@)(@@) % ومنصلت كالصبح أشهب ساطع % % وأحمر وردي وأصفر فاقع % % 36(@)(@@) % لديهن من زال الرمال إذا انثنت % % تسيل ومن ظبى الفلاة أسارع % % 37(@)(@@) % وثقفت من سمر الرماح ذوابلا % % بأقلامها فيهم تخط الوقائع % % 38(@)(@@) % فأصبح جمع الكفر دون نزالها % % كما تترك النبت الهشيم الزعازع % % 39(@)(@@) % يؤمل بالسلم انتظام شتاته % % وهيهات يرجى وصل ما الله قاطع % % 40(@)(@@) % فبابك مرجو وبأسك متقى % % ورفدك مبذول وعدلك شاسع % % PageV01P606 41(@)(@@) % وملكك منصور وحزبك غالب % % وسيفك أناف الضلالة جاذع % % 42(@)(@@) % لك الله ما أمضى سيوفك كلما % % توقع من مر الحوادث واقع % % 43(@)(@@) % ومن ذا له جد كجدك أو أب % % إذا عددت آباءهن التتابع % % 44(@)(@@) % لقد أبصرت منك النواظر ملئها % % غداة بدا من غرة العيد طالع % % 45(@)(@@) % برزت على رجل الجلال إلى التي % % ترفع من مثواك ما الله رافع % % 46(@)(@@) % وأحييت للدين الحنيف شرائعا % % بأنصار دين الله تحيا الشرائع % % 47(@)(@@) % وقد زحفت يغشي العيون رواؤها % % صفوف من الفرسان وهي دوارع % % 48(@)(@@) % فلما قضيت العيد سنة نحره % % وأطعم معتر هناك وقانع % % 49(@)(@@) % رجعت إلى دار الخلافة والعلا % % فضاءت بنور الهدي تلك المرابع % % 50(@)(@@) % وعرضت للتقبيل كفا كريمة % % تفيض على الطلاب منها ينابع % % PageV01P607 51(@)(@@) % وذاعت بروض المدح فيك مدائح % % كما ذاع من أنفاس دارين ذائع % % 52(@)(@@) % فيهنيك في الأعياد أسعد قادم % % يخبر أن الفتح من بعد تابع % % 53(@)(@@) % أطل فحيانا بطل سروره % % لقد عذبت منه لدينا المواقع % % 54(@)(@@) % فدم ملجأ للدين تحمي ذماره % % إذا دهمت يوما بنيه المفازع % % 55(@)(@@) % كأن بك قد أحرزت كل ممنع % % بعيد فلم يمنعه دونك مانع % % 56(@)(@@) % وأصبح ملك الروم نهبا وأصبحت % % تحكم في غلب الرقاب الجوامع % % 57(@)(@@) % ودانت لك الدنيا وأصبح شملها % % بعيد افتراق وهو بالدين جامع % % 58(@)(@@) % وإني لأرجو الله حتى كأنني % % أرى بجميل الظن ما الله صانع % % PageV01P608 البحر : - 1(@)(@@) % ما ضر لو سلم أو ودعا % % من أودع القلب الذي أودعا % % 2(@)(@@) % ضن برجع الطرف يوم النوى % % هلا رعى عهدي كما أرعى % % 3(@)(@@) % زم 
ms151	 المطايا وتخلفني % % أسأل عنها الطلل البلقعا % % 4(@)(@@) % وصار لا يلوي على ظبة % % يوما ولا يلوي لها أخدعا % % 5(@)(@@) % وارتحل القلب على إثره % % فصرت أبكيه وقلبي معا % % 6(@)(@@) % نشدتك الله نسيم الصبا % % إن جئت في تسيارك الأجرعا % % 7(@)(@@) % فصرت في أغصانه ذبلا % % وغدت من غدرانه أدرعا % % 8(@)(@@) % عرج على الوادي كذا يسرة % % وابلغ سلامي ذلك المربعا % % 9(@)(@@) % وقل له إني مقيم على % % ودي إذا أخلف أو ضيعا % % 10(@)(@@) % يا سائلي كيف طعم الهوى % % لله ما أحلى وما أفظعا % % PageV01P609 11(@)(@@) % كأنما في أضلعي بارق % % يهفو إذا ما صادح رجعا % % 12(@)(@@) % كأنما دمعي إذا استنصرت % % لواعج الشوق به أسرعا % % 13(@)(@@) % وضمر الشقر على وجنتي % % تصنع ما شاءته أن يصنعا % % 14(@)(@@) % جيش بني نصر ملوك الورى % % قوما إذا الداعي لخطب دعا % % 15(@)(@@) % خلائف مجدهم أقدم % % سما جلالا ونما تبعا % % 16(@)(@@) % بيت على أس الهدى قائم % % قد أذن الله بأن يرفعا % % 17(@)(@@) % أملاك صدق جاهدوا في العدا % % وصيروا أملاكها خشعا % % 18(@)(@@) % فاستشهد الآثار في أرضها % % تلف بكل ربوة مصرعا % % 19(@)(@@) % إن بطش الدهر بقوم حموا % % أو تعثر الأيام قالوا لعا % % 20(@)(@@) % أوجئتهم في الجدب تبغي الندى % % سحوا عليك السحب الهمعا % % PageV01P610 21(@)(@@) % وإن خبرت القوم ألفيتهم % % لله ما أهدى وما أروعا % % 22(@)(@@) % في حومة الحرب أسود الشرى % % وفي الظلام سجدا ركعا % % 23(@)(@@) % كواكب الأرض وأنوارها % % أضحى بهم مغربها مطلعا % % 24(@)(@@) % كفاهم أن أنجبوا يوسفا % % الأريحي الملك الأروعا % % 25(@)(@@) % ملكا عميم الجود سح الندى % % أجدى من الوابل أو أنفعا % % 26(@)(@@) % ألف بالعدل قلوب الورى % % وفرقت يمناه ما جمعا % % 27(@)(@@) % يهوي إليه الوفد مستأنسا % % من نازح الآفاق ما انتسا % % 28(@)(@@) % حتى إذا ما أبصروا وجهه % % صدق مرأى عندهم مسمعا % % 29(@)(@@) % حاط بلاد الله من بعدما % % هبت بها ريح العدا زعزعا % % 30(@)(@@) % وابتهلت فيه قلوب الورى % % والله جل اسما سميع الدعا % % PageV01P611 31(@)(@@) % فصانها منه بماضي الظبا % % إن هم أمضى أو همى أترعا % % 32(@)(@@) % فجرد البيض وجر القنا % % وجرع الأعداء ما جرعا % % 33(@)(@@) % يا ناصر الدين وحامي الهدى % % إن غاله 
ms152	 خطب وإن روعا % % 34(@)(@@) % مالي بما أوليك من مقول % % وإن غدوت اللسن المسقعا % % 35(@)(@@) % فاستقبل الأيام وضاحة % % واجن جنى النصر فقد أينعا % % 36(@)(@@) % واهنأ بنيروز مسراته % % قد أصبحت أبوابها شرعا % % 37(@)(@@) % دمت رفيع الملك سامي العلا % % ما طاف بالبيت امرؤ أوسعا % % PageV01P612 البحر : كامل تام 1(@)(@@) % إن كنت تنكر ما تكن ضلوعي % % من لاعج فاسأل شهود دموعي % % 2(@)(@@) % أعلمت بعدك بالمخضب وقفتي % % أدعو من السلوان غير سميع % % 3(@)(@@) % لهفي على عهد بمنعرج الحمى % % مغنى السرور وأنسي المجموع % % 4(@)(@@) % قالوا متى ظعن الذين تخلفوا % % نار الجوى بفؤادك المصدوع % % 5(@)(@@) % فأجبتهم شدوا الركائب موهنا % % وتحملوا الأقمار تحت هزيع % % 6(@)(@@) % وسروا فكان النوم شهر محرم % % ومواطن الأجفان شهر ربيع % % 7(@)(@@) % وكلوا بحفظ العهد أي مراقب % % واستحفظوا الأسرار غير مذيع % % 8(@)(@@) % فمتى جنحت إلى السلو تعللا % % غلب التطبع شيمة المطبوع % % 9(@)(@@) % يا ملبسي ثوب السقام وتاركي % % بين الأوام وبين حر ضلوع % % 10(@)(@@) % عامل بما عودت من لطف ومن % % رحمى ولا تنظر لسوء صنيع % % PageV01P613 11(@)(@@) % واعطف علي وجد بأيسر نائل % % ما قل يكثر منك عند قنوع % % 12(@)(@@) % أيقظت لما نمت ساكن زفرتي % % وحرمت أجفاني لذيذ هجوع % % 13(@)(@@) % ووكلت عيني بالفراقد والسهى % % أبكيت عند غروبها وطلوع % % 14(@)(@@) % فالنجم في كبد السماء مسامري % % والسقم في قلق الفراشي ضجيع % % 15(@)(@@) % جردت ثوب الصبر فيك تولها % % ولبست ثوب تذللي وخضوع % % 16(@)(@@) % حتى بكى لي عاذلي من رحمة % % ورثى لطول صبابتي وولوع % % 17(@)(@@) % سل نحر سائل عبرتي أو زفرتي % % يأتك بالمخفوض والمرفوع % % 18(@)(@@) % واسأله عن وجدي يجبك مبادرا % % هذا قياس ليس بالمرفوع % % 19(@)(@@) % عذبتني وأبحت جسمي للضنا % % ومنعتني ما ليس بالممنوع % % 20(@)(@@) % إن كان ذنبي أنني بك مغرم % % كلف الفؤاد فلات حين رجوع % % PageV01P614 البحر : طويل 1(@)(@@) % لعل خيالا منك يطرق مضجعي % % وإن ضل يهديه الأنين بموضع % % 2(@)(@@) % تصدق به وابعثه في سنة الكرى % % وما شئته من بعد ذلك فاصنع % % 3(@)(@@) % وإن عاد فاسأله يجبك بما يرى % % لعلك ترثي أو لعلك تقنع % % 4(@)(@@) % وإلا فمن لي بأيسر نائل % % بأن أشتكي وجدي إليك 
ms153	 وتسمع % % 5(@)(@@) % عرفت الهوى حلوا ومرا مذاقه % % وما صادق في حبه مثل مدع % % 6(@)(@@) % فما ذقت أدهى من مشاهدة النوى % % وأعظم من بين الحبيب المودع % % 7(@)(@@) % ولم أنس إذ عانقتها لوداعنا % % فخالط در العقد جوهر أدمع % % 8(@)(@@) % فتسمح باليمنى دموع جفونها % % وتجعل يسرى فوق قلب مروع % % 9(@)(@@) % وقالت دموعي واشتياقي وزفرتي % % شهود على ما من غرامك أدع % % 10(@)(@@) % فإن غبت غاب الأنس عني بأسره % % ومالي من عيش إذا لم تكن مع % % PageV01P615 11(@)(@@) % ولما سرت والليل قد مال وانقضى % % وأعجلها ضوء الصباح الملمع % % 12(@)(@@) % ولم تستطع رد السلام مخافة % % أشارت بطرف العين ثم أومت بأصبع % % 13(@)(@@) % فأي اصطبار لم تحلل عقوده % % وأي فؤاد بعد لم يتصدع % % 14(@)(@@) % رعى الله من يرعى العهود على السنوى % % فلست تراه عن هواه بمقلع % % 15(@)(@@) % ولكن دمعي لا يطيع لمن دعا % % وكم بين عاص في الدموع وطيع % % 16(@)(@@) % أحبة قلبي لا تظنوا بأنني % % نسيت وأفنى البعد نيران أضلع % % 17(@)(@@) % عليكم سلام الله ما هبت الصبا % % وما لاح برق في أجارع لعلع % % PageV01P616 البحر : مجزوء الرجز 1(@)(@@) % طغى العدو وبغى % % وشبت نيران الوغى % % 2(@)(@@) % وأظهر السلم وقد % % أسر حسوا في ارتغا % % 3(@)(@@) % فبلغ الرحمن سيف % % النصر فيه ما ابتغا % % 4(@)(@@) % ورده رد ثمود % % والفصيل قد رغا % % 5(@)(@@) % حتى يرى وليمة % % لكل مرهوب الثغا % % PageV01P617 البحر : طويل 1(@)(@@) % تلافيت نصر الدين إذ كاد يتلف % % وأنجزت وعد الحق وهو مسوف % % 2(@)(@@) % وأنشئت في أفق العلا سحب الندى % % وسقيت روض المجد فهو مفوف % % 3(@)(@@) % وجمعت أسباط المكارم والعلا % % وناديت لا تثريب إذ أنت يوسف % % 4(@)(@@) % وقر سرير الملك لما حللته % % ولو لم تشد أرجاؤه كاد يرجف % % 5(@)(@@) % دعتك قلوب الناس إذ عم جدبها % % ولح الأسى فيها وجل التأسف % % 6(@)(@@) % فأطللت غيثا في سماء عجاجة % % ترى دلوها شهب الأسنة تقذف % % 7(@)(@@) % تهب رياح النصر في جنباتها % % رخاء ورعد الطبل خلفك يقصف % % 8(@)(@@) % فما كنت إلا رحمة الله أرسلت % % فأينع معتر وأخصب معجف % % 9(@)(@@) % فقر بك الإسلام عينا ولم يزل % % يعدك للجلى ويسعى فتسعف 
ms154	 % % 10(@)(@@) % فلله من يوم أغر محجل % % لحزب الهدى قدما إليه تشوف % % PageV01P618 11(@)(@@) % أرى الدين دين الله ما كان يرتجي % % ودافع عن أهليه ما يتخوف % % 12(@)(@@) % فيا حضرة للعدل أصبحت روضة % % بأنوارها روض الهداية يتحف % % 13(@)(@@) % ويا كعبة الملك التي بركاتها % % تفيض على زوارها وتوكف % % 14(@)(@@) % ليهنيك منصور اللواء مؤيد % % بحار الندى من جود كفيه تغرف % % 15(@)(@@) % همام إذا ما عاين القرن سيفه % % فموعده الحشر الذي ليس يخلف % % 16(@)(@@) % وأقسم لو رام الثريا لنالها % % بعزم اقتدار ما لها عنه مصرف % % 17(@)(@@) % وصول إلى الغايات يرجى ويتقى % % كريم السجايا لم يشبه التكلف % % 18(@)(@@) % يؤلف بالحسنى قلوبا تفرقت % % يفرق بالإحسان ما لا يؤلف % % 19(@)(@@) % أمولاي إني عبد نعمتك الذي % % عليك ثنائي ما حييت موقف % % 20(@)(@@) % وما الشعر إلا بعض نعماك إنه % % وإن راق من أزهار مجدك يقطف % % PageV01P619 21(@)(@@) % تكفلت بالإحسان بدءا وعودة % % فخير تسنيه وشعر تشرف % % 22(@)(@@) % بلغت بإمداحي لملكك رتبة % % تطل على أوج السماك وتشرف % % 23(@)(@@) % وأحرزت في شأو امتداحك غاية % % تقرر مداح الملوك فتنصف % % 24(@)(@@) % أجرر ذيلي عند ذكر جريرها % % بيانا فلا أهفو ولا أتوقف % % 25(@)(@@) % وأنتعل الجوزاء عجبا وإن غدت % % تقرط آذان بها وتشنف % % 26(@)(@@) % وماذا عسى بثني فصيح وشاعر % % وماذا عسى يحصي كلام مزخرف % % 27(@)(@@) % وأنت أبا الحجاج حجة ديننا % % بك الله يجلو الشك والسوء يصرف % % 28(@)(@@) % وأنت ابن أنصار الهدى وحماته % % هنيئا لهم هذا الثناء المخلف % % 29(@)(@@) % نحوا نحو باب للعلا فعلا بهم % % على السنن المرضي والعدل يعطف % % 30(@)(@@) % شعارهم علم وحلم ونائل % % وحرب ومحراب وسيف ومصحف % % PageV01P620 31(@)(@@) % فكم أطلعوا في الحرب من نجر صارم % % يعفر آناف الطغاة ويرعف % % 32(@)(@@) % وكم عائل أغنوا وكم خائف حموا % % وكم معدم أثروه جودا وأترفوا % % 33(@)(@@) % بعثت إلى أرض العدا بكتيبة % % تكاد بها شمس الظهيرة تكسف % % 34(@)(@@) % قبائل أدواها السرى فتنكرت % % ولكنها عند الكريهة تعرف % % 35(@)(@@) % تقود إليهم كل أجرد سابح % % تهد به شم الهضاب وتنسف % % 36(@)(@@) % تكبر عن لبس الحديد إلى الوغى % % فقام مقام الدرع برد ومطرف % % 37(@)(@@) % تنكب عنها البيض 
ms155	 وهي بواتر % % ويقصر عنها السمهري المشقف % % 38(@)(@@) % وما كل زند يحمل الكف ساعدا % % ولا كل مصقول السفاسق مرهف % % 39(@)(@@) % فجاست أقاصي أرضهم وتعسفت % % غنائمهم لله ذاك التعسف % % 40(@)(@@) % فأبصر ملك الروم منك مؤيدا % % إذا هم لأوان ولا متخلف % % PageV01P621 41(@)(@@) % فسالم إشفاقا وكف تخوفا % % وعف فما أنجاه ذاك التعفف % % 42(@)(@@) % ووجه يستجدي علاك رسوله % % وكاتب يستدني رضاك ويلطف % % 43(@)(@@) % وأقبل لا يدري إلى النجم يرتقي % % أم إلى البحر يبغي أم إلى البيت يدلف % % 44(@)(@@) % يؤمل تقبيل البساط ومن له % % به وبروق الهند عينيه تخطف % % 45(@)(@@) % وقد جنحوا للسلم فاجنح تفضلا % % فما منهم عين من الرعب تطرف % % 46(@)(@@) % فلا برحت أيامك الغر تقتفي % % بك الفتح والآمال لا تتوقف % % 47(@)(@@) % ولا زالت الأملاك تأتيك خضعا % % ولا زلت بالإحسان والعفو تكلف % % 48(@)(@@) % وينشد من يأتي لبابك وافدا % % تلافيت نصر الدين إذ كاد يتلف % % PageV01P622 البحر : طويل 1(@)(@@) % أشارت غداة البين من خلل السجف % % بناظرتي ريم وسالفتي خشف % % 2(@)(@@) % وأبصرت التوديع حقا فلم تطق % % غداتئذ كتما لبعض الذي تخفي % % 3(@)(@@) % أماطت عن الخد اللثام فأطلعت % % هلالا على غصن وغصنا على حقف % % 4(@)(@@) % وقالت لأتراب لها قمن دونها % % فقائلة سحي وقائلة كفي % % 5(@)(@@) % أخلاي هل طعم أمر من النوى % % وأفظع خطبا من مفارقة الإلف % % 6(@)(@@) % ولم تك إلا ساعة وتسنمت % % ظهور المطايا كل فاتنة الطرف % % 7(@)(@@) % ودارت على الركب الصوارم والقنا % % وجرد المذاكي من أمام ومن خلف % % 8(@)(@@) % أمالوا السرى قصد العراق وأزمعوا % % على مهمة تسفي به الريح ما تسفي % % 9(@)(@@) % ودل عليهم من تخلف منهم % % بما أودعوا طيب النسيم من العرف % % 10(@)(@@) % فلا عهد إلا بالخيال وبالمنى % % ولا وصل إلا بالرسائل والصحف % % PageV01P623 11(@)(@@) % بكيت دما حتى توهم صاحبي % % بأني غداة البين أرعف من طرفي % % 12(@)(@@) % وكم رمت أن يجدي البكاء فلم يكن % % ليجدي ورجعت الحنين فلم يشف % % 13(@)(@@) % أيا قاتل الله الغواني فإنما % % طلاب الردى وقف على ربة الوقف % % 14(@)(@@) % تغادو ذا الجأش القوي جفونها % % ضعيف انتصار وهي بينة الضعف % % 15(@)(@@) % إذا ما غرسن الوعد في 
ms156	 روضة الهوى % % جنيت على أغصانه ثمر الخلف % % 16(@)(@@) % ترى من أحل الغدر وهو محرم % % وحرم غصن الأقحوان على الرشف % % 17(@)(@@) % سأصرف عن قلبي مساعدة الهوى % % فقد كان في حولين من ذاك ما يكفي % % 18(@)(@@) % وأذهب من صبري إلى كل مذهب % % وكل كريم لا يقيم على خسف % % 19(@)(@@) % وأفزع من دهري إلى ظل يوسف % % فلله من ركن منيع ومن كهف % % 20(@)(@@) % زجرت القوافي والمطايا شواردا % % إلى واحد في الروع يغني عن الألف % % PageV01P624 21(@)(@@) % وقور إذا الأبطال طاشت حلومها % % وأقدم في الهيجاء صفا إلى صف % % 22(@)(@@) % إذا ذكر الأملاك يوما فيوسف % % لما شئت من جود وما شئت من عطف % % 23(@)(@@) % وبالسيف سفاح وبالهدي مهتد % % وبالرعب منصور وبالله مستكف % % 24(@)(@@) % هو الدهر لكن عدله وسماحه % % يرد صروف الدهر راغمة الأنف % % 25(@)(@@) % هو البدر إلا أنه الدهر كامل % % إذا صيب نور البدر بالنقص والخسف % % 26(@)(@@) % من العرب الشم الأنوف إذا احتبوا % % تبوأت في جار مجير وفي حلف % % 27(@)(@@) % كرام إذا ما الغيث في الأرض لم يكف % % بصوب حيا كانت أكفهم تكفي % % 28(@)(@@) % فإن حملوا أقنوا أو استصرخوا حموا % % وإن بذلوا أغنوا عن الديم الوطف % % 29(@)(@@) % وإن مدحوا اهتزوا كما هبت الصبا % % على كل ممطور من البان ملتف % % 30(@)(@@) % وأن سمعوا اللغو فروا بأنفس % % كرام السجايا لا تفر من الزحف % % PageV01P625 31(@)(@@) % لعمري لئن هاجت عزائمك العدا % % كما بحثت عن حتفها ربة الظلف % % 32(@)(@@) % وغرتهم الحرب السجال وقلما % % يدل غرور القوم إلا على الحتف % % 33(@)(@@) % فقد آن أخذ الدين منهم بثأره % % وما كان جفن الدين في مثلها يغف % % 34(@)(@@) % ودون مهب العزم كل مهند % % وخطية سمر وفضفاضة زغف % % 35(@)(@@) % وأسد غضاب إن تذكرن يومها % % عضضن بأطراف البنان من اللهف % % 36(@)(@@) % أمولاي زارتك القوافي كأنها % % هدايا تهادتها القيان إلى الزف % % 37(@)(@@) % عليها عقود من ثنائك نظمت % % مناسبة التأليف محكمة الرصف % % 38(@)(@@) % أتاك بها النيروز معترفا بما % % لملكك فيه من نوال ومن عرف % % 39(@)(@@) % فهنيته والدهر طوعك والمنى % % توافي بما تهواه ضعفا على ضعف % % 40(@)(@@) % تمهدت الدنيا بملكك 
ms157	 بعدما % % أقامت زمانا لا تفر من الرجف % % PageV01P626 41(@)(@@) % ورضت صعاب الدهر وهي شوامس % % فذللتها من غير جهد ولا عنف % % 42(@)(@@) % وكم صرف التأميل نحوك آمل % % فصيرته بالعدل ممتنع الصرف % % 43(@)(@@) % وكم من يد أوليتنيها كريمة % % يقل لها نظمي ويعي بها وصفي % % 44(@)(@@) % فأسبابك الوثقى وصلت بها يدي % % ونعمتك الكبرى ملأت بها كفي % % 45(@)(@@) % فإن أنا لم أمحضك مني بخالص % % من الود صاف في قراراته صرف % % 46(@)(@@) % وآت ببحر المدح فيك لغاية % % ترى دونها الأبصار حاسرة الطرف % % 47(@)(@@) % فلا ضاع معنى يستضاء بنوره % % جناني ولا خطت بناني في حرف % % PageV01P627 البحر : طويل 1(@)(@@) % إخواننا لا تنسوا الفضل والعطفا % % فقد كاد نور الله بالكفر أن يطفا % % 2(@)(@@) % وإذ بلغ الماء الزبا فتداركوا % % فقد بسط الدين الحنيف لكم كفا % % 3(@)(@@) % تحكم في سكان أندلس العدا % % فلهفا على الإسلام ما بينهم لهفا % % 4(@)(@@) % وجاشت جيوش الكفر بين خلالها % % فلا حافرا أبقت عليها ولا ظلفا % % 5(@)(@@) % أنوما وإغفاء على سنة الكرى % % وما نام طرف في حماها ولا أغفا % % 6(@)(@@) % أحاط بنا الأعداء من كل جانب % % فلا وزرا عنهم وجدنا ولا كهفا % % 7(@)(@@) % ثغور غدت مثل الثغور ضواحكا % % أقام عليها الكفر يرشفها رشفا % % 8(@)(@@) % فمن معقل حل العدو عقاله % % ومن مسجد صار الضلال به وقفا % % 9(@)(@@) % ومن غادة بكر جلتها يد الجلا % % ولم تدر الإذاية قط أو سجفا % % 10(@)(@@) % ومن صبية حمر الحواصل أصبحت % % تقلب ذعرا بين أعدائها الطرفا % % PageV01P628 11(@)(@@) % ومن نسوة أضحت أيامى حواسرا % % يعاين في أعيانها الوهن والضعفا % % 12(@)(@@) % وسيلتنا الإسلام وهو أخوة % % من الملإ الأعلى تقربنا زلفا % % 13(@)(@@) % أخوفا وقد لذنا بجاه من ارتضى % % وذلا وقد عذنا بعز من استصفا % % 14(@)(@@) % فهل ناصر مستبصر في يقينه % % يجير من استعدى ويكفي من استكفا % % 15(@)(@@) % ومنتجز فينا من الله وعده % % فلا نكث في وعد الإله ولا خلفا % % 16(@)(@@) % وهل بائع فينا من الله نفسه % % فلا مشتر أولى من الله أو أوفا % % 17(@)(@@) % أفي الله شك بعد ما وضح الهدى % % وكيف لضوء الصبح في الأفق أن يخفا 
ms158	 % % 18(@)(@@) % وكيف يعيث الكفر فينا ودوننا % % قبائل منكم تعجز الحصر والوصفا % % 19(@)(@@) % غيوث نوال كلما سئلوا الندى % % ليوث نزال كلما حضروا الزحفا % % 20(@)(@@) % إذا كاتبت يوما فأقلامها القنا % % وإن أرسلت كانت صفائحها الصحفا % % PageV01P629 21(@)(@@) % فقوموا برسم الحق فينا فقد عفا % % وهبوا لنصر الدين فينا فقد أشفا % % 22(@)(@@) % وها نحن قد لذنا بعز حماكم % % ونرجو من الله الإدالة واللطفا % % PageV01P630 البحر : متدارك تام 1(@)(@@) % قسما بالليل وما وسقا % % وآيات البدر إذا اتسقا % % 2(@)(@@) % والنجم الثاقب حين هوى % % راجما والصبح إذا انفلقا % % 3(@)(@@) % وبنور الطور وقد أضحى % % موسى لجلالته صعقا % % 4(@)(@@) % لمخايل ملكك تخبرني % % أن التأبيد لها خلقا % % 5(@)(@@) % أحييت الدين وقد أودى % % وأعدت الملك وقد خلقا % % 6(@)(@@) % يا ناصر دين الله ومن % % بعنايته الوثقى وثقا % % 7(@)(@@) % مهدت لملكك مصطبحا % % في ظل الأنس ومغتبقا % % 8(@)(@@) % ونظمت المجد فوافره % % غناك السعد به وسقا % % 9(@)(@@) % طابت بوجودك أندلس % % حسنت بجوارك مرتفقا % % 10(@)(@@) % إن طاف بها شيطان عدى % % يبغي لسمائك مسترقا % % PageV01P631 11(@)(@@) % أو جاس خلال منازلها % % قذفته سعودك فاحترقا % % 12(@)(@@) % الله تخير يوسف من % % غرر الأملاك هدى ونقا % % 13(@)(@@) % كهف لجأ الإسلام له % % فعفا وحمى وكفى ووقا % % 14(@)(@@) % وأعز الرشد به فرقا % % وأذل الغمى به فرقا % % 15(@)(@@) % وافى وصباح الملك دجى % % فانجاب الغاسق وأئتلقا % % 16(@)(@@) % والأرض تضيق بساكنها % % وتغص بريقتها شرقا % % 17(@)(@@) % فاهتزت حين أتى وربت % % وأسال بها ماء غدقا % % 18(@)(@@) % وتداركها بعزائمه % % ما مثل صفاح الهند رقا % % 19(@)(@@) % وأقام الحق وجاء به % % فإذا بالباطل قد زهقا % % 20(@)(@@) % يجري في محكم راحته % % أحكام سعادات وشقا % % PageV01P632 21(@)(@@) % لو عاد البدر بغرته % % لم يخش الخسف ولا امحقا % % 22(@)(@@) % أو أم اليم بعزمته % % يوما لتصدع وانفرقا % % 23(@)(@@) % أو لاذ الوحش بجانبه % % لم يرهب من عاد طرقا % % 24(@)(@@) % مهلا فمواطر كفك ما % % أبقت محتاجا ومرتزقا % % 25(@)(@@) % ولقد أمرت حتى غمرت % % وتخوف سائلك الغرقا % % 26(@)(@@) % أبني الأنصار لك شرف % % حكم آي القرآن به نطقا % % 27(@)(@@) % آووا نصروا أو أذوا صبروا % % كانوا لرسول الله وقا % % 28(@)(@@) % حفظوه ببذل النفس كما % % حفظوا بجفونهم 
ms159	 الحدقا % % 29(@)(@@) % ووفوا لله ما عهدوا % % فما كذبوه إذ صدقا % % 30(@)(@@) % ورضوا بالصبر فما وهنوا % % جزعا في الدين ولا قلقا % % PageV01P633 31(@)(@@) % أمجاهد دين الله لقد % % أمنت بصارمك الطرقا % % 32(@)(@@) % وخليفته في أمة من % % بالوحي أتى وبه فرقا % % 33(@)(@@) % هجرت النوم لطاعته % % بالغزو وواصلت الأرقا % % 34(@)(@@) % هذا النيروز أتاك بما % % تهواه وبالبشرى سبقا % % 35(@)(@@) % فسنملك أرض الروم فما % % أبقيت بها إلا رمقا % % 36(@)(@@) % كفروا بالله فأرهقهم % % وملكت فزادهم رهقا % % 37(@)(@@) % فالرمح ينضنض من شره % % لهم والصارم قد دلقا % % 38(@)(@@) % والخيل تهد مرابطها % % وتقد أعنتها حنقا % % 39(@)(@@) % شهب كالشهب إذا قذفت % % دهم كالليل إذا غسقا % % 40(@)(@@) % صفر كالشمس إذا جنحت % % حمر وقد ألبست الشفقا % % PageV01P634 41(@)(@@) % إما صهلت في أرض عدى % % فغراب البين بهم نعقا % % 42(@)(@@) % ما أرعد ركض سنابكها % % إلا والصارم قد فرقا % % 43(@)(@@) % يعتد بها ملك شهم % % لو رام بها الشعرى لحقا % % 44(@)(@@) % أو عارضها بالبرق كبا % % أو أورد عين الشمس سقا % % 45(@)(@@) % لولا كلمات سبقت % % بالسلم وعهد قد سبقا % % 46(@)(@@) % لتركت ديارهم قفر السلهام % % وسلمهم نفقا % % 47(@)(@@) % وجعلت مياههم غورا % % وتركت صعيدهم زلقا % % 48(@)(@@) % يا حزب الله وناصره % % بالحق ومدرك ما سحقا % % 49(@)(@@) % أنت المدخور ليومهم % % أنت المفتاح لما غلقا % % 50(@)(@@) % وافيت إليك بركض % % لغمر نوالك مستبقا % % PageV01P635 51(@)(@@) % فسبكت التبر لها لحما % % وجعلت أجتلها شرقا % % 52(@)(@@) % فأنل واحمل وأعد وأبد % % وانعم في ظل حمى وبقا % % 53(@)(@@) % ما لاح النور بمشرقه % % أو هزت ريح غصن نقا % % PageV01P636 البحر : بسيط تام 1(@)(@@) % زارت ونجم الدجى يشكو من الأرق % % والزهر سابحة في لجة الأفق % % 2(@)(@@) % والليل من روعة الإصباح في دهش % % قد شاب مفرقه من شدة الفرق % % 3(@)(@@) % وأوشكت أن تضل القصد زائرة % % لولا أني كنت في باق من الرمق % % 4(@)(@@) % قالت تناسيت عهد الحب قلت لها % % لا والذي خلق الإنسان من علق % % 5(@)(@@) % ما كان قط تناسي العهد من شيمي % % ولا السلو عن الأحباب من خلق % % 6(@)(@@) % ولا ترحلت عن مغناك من ملل % % قد يترك الماء يوما خيفة الشرق % % 7(@)(@@) % كم ليلة بتها 
ms160	 والطيف يشهد لي % % لم تطعم النوم أجفاني ولم تذق % % 8(@)(@@) % أشكو إلى النجم وهنا أكابده % % حتى شكا النجم من وجدي ومن قلق % % 9(@)(@@) % يا لائمي أفيقا من ملامكما % % فإنني منذ سقيت الحب لم أفق % % 10(@)(@@) % هل تذكراني ليالينا وقد نفحت % % ريح الصبا في رياض للصبا عبق % % PageV01P637 11(@)(@@) % وإذ نعمنا برغم الدهر فيه وقد % % عض الأنامل من غيظ ومن حنق % % 12(@)(@@) % بكل ساحرة الألباب آيتها % % أن تطلع الشمس في جنح من الغسق % % 13(@)(@@) % تنازع الغصن لدنا في تأوده % % وتخصم الريم في الألحاظ والعنق % % 14(@)(@@) % والروض يجلو عذاره وقد لبست % % عقائل الورق ديباجا من الورق % % 15(@)(@@) % كأنما الغصن شارب ثمل % % بكأس مصطبح في الأنس معتبق % % 16(@)(@@) % فكلما ارتاح هز العطف من طرب % % وجاد زهوا بمنثور من الورق % % 17(@)(@@) % كأنما الدوح والأغصان جائلة % % قد جادها كل جهم الغيم مندفق % % 18(@)(@@) % أحبة راعها والشمل منتظم % % داعي الوداع فمن باك ومعتنق % % 19(@)(@@) % كأنما الطل إذ طل الشقيق به % % خد بصفحته رشح من العرق % % 20(@)(@@) % همت ثغور الأقاحي أن تقبله % % فللبنفسج وجه الواجم الحنق % % PageV01P638 21(@)(@@) % كأن أوراقه والريح تعطفها % % سواعد رفعت خضرا من الدرق % % 22(@)(@@) % كأنما الآس آذان الجياد وقد % % شعرن بالروع في قفر من الطرق % % 23(@)(@@) % كأنما النهر في أثنائه أفق % % والورد في الشط منه حمرة الشفق % % 24(@)(@@) % أو سيف يوسف يوم الروع سال به % % نجيع أعدائه المحمر في الزرق % % 25(@)(@@) % إمام عدل يحب الله سيرته % % عف الغيوب كريم الخلق والخلق % % 26(@)(@@) % أقام للدين قسطاسا فأمنه % % ما سامه الجور من نحس ومن رهق % % 27(@)(@@) % وعم بالرفق هذا القطر فابتدرت % % تنمي مآثره جوابة الرفق % % 28(@)(@@) % أقول للركب المزجي مطيته % % يحثها السير بين النص والعنق % % 29(@)(@@) % يا زاجر العيس أنضاء مضمرة % % كأنها أسهم يمرقن عن فوق % % 30(@)(@@) % أهلة ما لها عهد بمنزلة % % من كل منخسف الجثمان ممحق % % PageV01P639 31(@)(@@) % أرح ركابك فقد أوردت في نهل % % وقد ظفرت بحبل الله فاعتلق % % 32(@)(@@) % حللت بالمنزل المحبو نائله % % بباب ملك لباب البر مستبق % % 33(@)(@@) % نمته أملاك صدق بل ملائكة % % من كل 