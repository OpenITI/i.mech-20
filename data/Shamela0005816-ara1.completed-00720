ms701	 الله بن الأشج PageV05P145(@)(@@)(@@)(@@) $ 4290 - عمر بن عثمان بن عفان القرشي يروي عن أبيه روى إبراهيم بن عمر بن أبان عن أبيه عنه(@)(@@)(@@)(@@) $ 4291 - عمر بن علي بن أبي طالب يروي عن أبيه روى عنه ابنه محمد بن عمر بن علي قتل سنة سبع وستين أمه أم النجوم بنت جندب بن عمرو(@)(@@)(@@)(@@) $ 4292 - عمر بن عبد الرحمن بن عوف الزهري يروي عن جماعة من أصحاب النبي صلى الله عليه وسلم روى عنه ابنه حفص بن عمر(@)(@@)(@@)(@@) $ 4293 - عمر بن قتادة بن النعمان الأنصاري يروي عن أبيه روى عنه ابنه عاصم بن عمر بن قتادة(@)(@@)(@@)(@@) $ 4294 - عمر بن مصعب بن الزبير بن العوام يروي عن بن الزبير روى عنه سعيد بن زيد وأبو هلال الراسبي(@)(@@)(@@)(@@) $ 4295 - عمر بن عبد الله بن عبد الله بن عمر بن الخطاب يروي عن جده عبد الله بن عمر روى عنه أبو الزناد ويزيد بن الهاد PageV05P146(@)(@@)(@@)(@@) $ 4296 - عمر بن عبد الرحمن بن زيد بن الخطاب أخو عبد الحميد بن عبد الرحمن يروي عن عمر بن الخطاب روى عنه أهل المدينة(@)(@@)(@@)(@@) $ 4297 - عمر بن قدامة بن مظعون يروي عن أبيه روى عنه ابنه موسى بن عمر(@)(@@)(@@)(@@) $ 4298 - عمر بن عبد الرحمن بن الحارث بن هشام أخو أبي بكر بن عبد الرحمن يروي عن جماعة من أصحاب رسول الله صلى الله عليه وسلم روى عنه الشعبي وقد قيل إنه مات عام مات عمر بن الخطاب(@)(@@)(@@)(@@) $ 4299 - عمر بن جابر يروي المراسيل روى عنه كهمس بن الحسن حدثنا بن قتيبة قال ثنا بن أبي السري قال ثنا معتمر بن سليمان قال ثنا كهمس عن عمر بن جابر يرفعه قال لا ينظر الله إلى صلاة رجل لا يقيم فيها صلبه(@)(@@)(@@)(@@) $ 4300 - عمر بن الحكم بن ثوبان بن فطيون من أهل الحجاز يروي عن أبي هريرة وعبد الله بن عمرو روى عنه يحيى بن سعيد الأنصاري ويحيى بن أبي كثير مات سنة سبع عشرة ومائة وهو بن ثمانين PageV05P147 سنة كنيته أبو حفص 
ms702	 وهو عمر بن الحكم بن أبي الحكم واسم أبي الحكم ثوبان حليف الأوس وفطيون ملك يثرب(@)(@@)(@@)(@@) $ 4301 - عمر بن عبد الرحمن بن خلدة الزرقي الأنصاري قاضي أهل المدينة يروي عن أبي هريرة روى عنه الزهري(@)(@@)(@@)(@@) $ 4302 - عمر بن الحكم بن رافع الأنصاري كنيته أبو حفص يروي عن جابر عداده في أهل المدينة روى عنه أهلها(@)(@@)(@@)(@@) $ 4303 - عمر بن أنس بن مالك الأنصاري يروي المراسيل روى عنه حميد الطويل(@)(@@)(@@)(@@) $ 4304 - عمر بن سعد بن عائذ القرظ المؤذن مولى بنى مخزوم وقد قيل إنه من موالي عمار بن ياسر يروي عن عمر بن الخطاب عداده في أهل المدينة روى عنه عمر بن عاصم بن عمر بن سعد بن عائذ(@)(@@)(@@)(@@) $ 4305 - عمر بن بلال أبو حفص الفزاري من أهل حمص يروي عن عبد الله بن بسر روى عنه إبراهيم بن عبد الله بن العلاء الزبيدي PageV05P148(@)(@@)(@@)(@@) $ 4306 - عمر بن عبد الله بن الزبير بن العوام يروي عن أبيه روى عنه عبد الله بن مسلم أخو الزهري(@)(@@)(@@)(@@) $ 4307 - عمر بن ثابت الأنصاري من بلحارث بن الخزرج يروي عن أبي أيوب الأنصاري روى عنه الزهري وسعد بن سعيد(@)(@@)(@@)(@@) $ 4308 - عمر بن عبد الله بن الأرقم يروي عن سبيعة بنت الحارث الأسلمية روى عنه عبد الله بن عتبة والد عبيد الله بن عبد الله(@)(@@)(@@)(@@) $ 4309 - عمر بن عبد الله بن أبي واقد وقد قيل بن واقد يروي عن أنس بن مالك روى عنه الحارث بن عبد الرحمن بن أبي ذباب(@)(@@)(@@)(@@) $ 4310 - عمر بن حرملة وقد قيل عمرو بن حرملة والصحيح عمر من أهل البصرة يروي عن بن عباس روى عنه علي بن زيد بن جدعان(@)(@@)(@@)(@@) $ 4311 - عمر بن سفينة مولى رسول الله صلى الله عليه وسلم يروي عن أبيه روى عنه ابنه بريه بن عمر بن سفينة يخطىء PageV05P149(@)(@@)(@@)(@@) $ 4312 - عمر بن سالم يروي عن بن عمر روى هشيم عن عبد الرحمن بن يحيى عنه(@)(@@)(@@)(@@) $ 4313 - عمر بن عبد الله بن أبي ربيعة المخزومي يروي عن عمر روى 
ms703	 عنه مصعب بن شيبة وابن جريج(@)(@@)(@@)(@@) $ 4314 - عمر بن سويد السلمي يروي عن معاوية روى عنه الزبيدي(@)(@@)(@@)(@@) $ 4315 - عمر بن أبي سحيم قوله كنيته أبو معقل من أهل البصرة روى عنه يحيى بن أبي إسحاق(@)(@@)(@@)(@@) $ 4316 - عمر بن عبد الرحمن بن جرهد بن خويلد الأسلمي الحجازي أخو زرعة بن عبد الرحمن يروي عن جابر بن عبد الله روى عنه عبد الرحمن بن حرملة بن الحصين(@)(@@)(@@)(@@) $ 4317 - عمر بن عبد الله بن سعد الزهري يروي عن بن عباس عداده في أهل الشام روى عنه ثور بن يزيد وقد قيل عمر بن عبد الرحمن بن سعد PageV05P150(@)(@@)(@@)(@@) $ 4318 - عمر بن عبد الرحمن وليس بابن عوف يروي عن عبادة بن الصامت روى عنه عبد الله بن محمد بن عقيل(@)(@@)(@@)(@@) $ 4319 - عمر بن شاكر قال سمعت أنسا عن النبي صلى الله عليه وسلم قال من صلى بالناس فليتجوز فإن فيهم الضعيف الكبير والصغير وذا الحاجة روى عنه عثمان بن عبد الرحمن الطرائفي(@)(@@)(@@)(@@) $ 4320 - عمر بن عبد العزيز بن مروان بن الحكم بن أبي العاص بن أمية بن عبد شمس الأموي من الخلفاء الراشدين المهديين الذي أحيى ما أميت قبله من السنن وسلك مسلك من تقدمه من الخلفاء الأربع كنيته أبو حفص كان مولده سنة إحدى وستين في السنة التي قتل فيها الحسين بن علي ومات سنة إحدى ومائة وهو بن تسع وثلاثين سنة وستة أشهر وكانت خلافته مثل خلافة أبي بكر سواء تسع وعشرين شهرا وكانت أمه أم عاصم بنت عاصم بن عمر بن الخطاب(@)(@@)(@@)(@@) $ 4321 - عمر بن عبد الرحمن بن قيس من أهل المدينة يروي عن أبي هريرة روى عنه داود بن قيس وهو الذي يقال له العسقلاني(@)(@@)(@@)(@@) $ 4322 - عمر بن عمر بن محمد بن حاطب الجمحي القرشي يروي عن جده PageV05P151 محمد بن حاطب عداده في أهل الكوفة روى عنه عبد الله بن الوليد(@)(@@)(@@)(@@) $ 4323 - عمر بن عبد الرحمن بن عطية بن دلاف المزني من أهل المدينة يروي عن أبي أمامة روى عنه عبد 
ms704	 العزيز بن أبي سلمة الماجشون(@)(@@)(@@)(@@) $ 4324 - عمر بن ميسرة المدني يروي عن سعد بن أبي وقاص روى عنه محمد بن عثمان بن سعيد بن يربوع المخزومي(@)(@@)(@@)(@@) $ 4325 - عمر بن العلاء شيخ يروي عن سهل بن سعد روى عنه عبد الرحمن بن مهدى(@)(@@)(@@)(@@) $ 4326 - عمر بن نبهان وليس بالغبري يروي عن أبي ثعلبة الخشني روى عنه أبو الزبير(@)(@@)(@@)(@@) $ 4327 - عمر بن محرز الأشجعي يروي عن جماعة من أصحاب النبي صلى الله عليه وسلم روى عنه الزهري وهو أول مولود ولد في الإسلام بحمص(@)(@@)(@@)(@@) $ 4328 - عمر بن الهجنع يروي عن أبي بكرة روى عنه عطاء بن السائب PageV05P152(@)(@@)(@@)(@@) $ 4329 - عمر بن معدان من أهل البصرة يروي عن أنس بن مالك روى عنه قتادة مات قبل بن سيرين(@)(@@)(@@)(@@) $ 4330 - عمر بن هارون الزرقي الأنصاري من أهل المدينة يروي عن أبي هريرة روى عنه يحيى بن حمزة(@)(@@)(@@)(@@) $ 4331 - عمر بن المهاجر أبو حفص الأنصاري من أهل البصرة يروي عن أنس بن مالك روى عنه الثوري(@)(@@)(@@)(@@) $ 4332 - عمر بن أبان يروي عن بن عمر روى عنه ابنه إبراهيم بن عمر(@)(@@)(@@)(@@) $ 4333 - عمر بن خالد الوهبي يروي عن أنس بن مالك عداده في أهل الشام روى عنه الحسن بن حاتم الألهاني ثنا عبد الصمد بن سعيد بحمص قال ثنا أحمد بن إبراهيم قال ثنا الحسن بن حاتم الألهاني قال ثنا عمر بن خالد الوهبي قال ثنا أنس بن مالك قال قال النبي صلى الله عليه وسلم إذا سمعتم المؤذن أذن فقولوا اللهم افتح أقفال قلوبنا لذكرك وأتمم علينا نعمتك وفضلك واجعلنا في عبادك الصالحين(@)(@@)(@@)(@@) $ 4334 - عمر بن نافع الثقفي يروي عن أنس بن مالك روى عنه PageV05P153 أبو معاوية ويحيى بن مصعب(@)(@@)(@@)(@@) $ 4335 - عمر بن يحيى الزرقي الأنصاري يروي عن عمر إن كان سمع منه روى عنه عبد الله بن عون(@)(@@)(@@)(@@) $ 4336 - عمر التميمي شيخ يروي عن الحسن بن علي روى عنه ابنه يزيد بن عمر(@)(@@)(@@)(@@) $ 4337 - عثمان بن إبراهيم بن محمد بن حاطب القرشي يروي عن عمر 
ms705	 روى عنه ابنه عبد الرحمن بن عثمان ويعلى بن عبيد(@)(@@)(@@)(@@) $ 4338 - عثمان بن أبي سودة أخو زياد بن أبي سودة سمع عبادة بن الصامت أبوهما مولى لعبد الله بن عمرو بن العاص وأمهما مولاة لعبادة بن الصامت عداده في أهل بيت المقدس روى عنه زيد بن واقد وأهل الشام(@)(@@)(@@)(@@) $ 4339 - عثمان بن عبد الله بن سراقة المدني العدوى يروي عن بن عمر روى عنه الزهري وعبيد الله بن عمر كنيته أبو عبد الله أمه زينب بنت عمر بن الخطاب وهو عثمان بن عبد الله بن سراقة بن المعتمر PageV05P154 بن أداة بن رباح بن عبد الله بن قرط بن رزاح بن عدي بن كعب(@)(@@)(@@)(@@) $ 4340 - عثمان بن صهيب بن سنان يروي عن أبيه روى عنه بن الهاد(@)(@@)(@@)(@@) $ 4341 - عثمان بن وكيع العبدي من أهل البصرة يروي عن سبعة من أصحاب رسول الله صلى الله عليه وسلم روى عنه السكن بن أبي السكن(@)(@@)(@@)(@@) $ 4342 - عثمان بن جابر يروي عن أنس بن مالك روى عنه صفوان بن عمرو(@)(@@)(@@)(@@) $ 4343 - عثمان بن أجيل يروي عن عتبة بن عبد عداده في أهل الشام روى عنه فرج بن يزيد(@)(@@)(@@)(@@) $ 4344 - عثمان بن جحاش بن أخي سمرة بن جندب يروي عن سمرة بن جندب روى عنه عقبة بن سيار(@)(@@)(@@)(@@) $ 4345 - عثمان بن حفص بن خلدة الزرقي يروي عن معاوية روى عنه PageV05P155 عبد العزيز الماجشون(@)(@@)(@@)(@@) $ 4346 - عثمان بن حاضر الحميري أبو حاضر يروي عن بن عباس روى عنه زياد بن سعد وإسماعيل بن أمية(@)(@@)(@@)(@@) $ 4347 - عثمان بن سليمان بن أبي حثمة القرشي أخو أبي بكر بن سليمان يروي عن رجل من أصحاب النبي صلى الله عليه وسلم روى عنه الزهري(@)(@@)(@@)(@@) $ 4348 - عثمان بن يزدويه أبو عمرو يروي عن أنس بن مالك روى عنه عبد الرزاق عن أبيه عنه وقد روى عنه معمر وابن أبي رواد(@)(@@)(@@)(@@) $ 4349 - عثمان بن ربيعة بن الهدير التيمي القرشي يروي المراسيل روى عنه كثير بن زيد(@)(@@)(@@)(@@) $ 4350 - عثمان مولى آل الزبير يروي عن بن 
ms706	 عمر روى عنه إسماعيل بن أبي خالد(@)(@@)(@@)(@@) $ 4351 - عثمان بن سليمان بن صبيح يروي عن أبي سعيد الخدري روى عنه عثمان بن حكيم PageV05P156(@)(@@)(@@)(@@) $ 4352 - عثمان الطويل من أهل الجزيرة عداده في أهل البصرة يروي عن أنس بن مالك ربما أخطأ روى عنه شعبة بن الحجاج وزهير بن معاوية(@)(@@)(@@)(@@) $ 4353 - عثمان بن عبيد الله مولى سعد بن أبي وقاص يروي عن أبي أسيد وأبي قتادة وأبي هريرة روى عنه بن أبي ذئب(@)(@@)(@@)(@@) $ 4354 - عثمان بن الأرقم بن أبي الأرقم كنيته أبو عمر يروي عن أبيه روى عنه أهل الحجاز وابن ابنه يحيى بن عمران بن عثمان(@)(@@)(@@)(@@) $ 4355 - عثمان بن البهي بن أبي رافع مولى رسول الله صلى الله عليه وسلم يروي عن جده روى عنه حماد بن موسى المديني ويروي أيضا عن أبيه وقد قيل إن اسم البهي عبيد الله(@)(@@)(@@)(@@) $ 4356 - عثمان بن عبد الرحمن التيمي يروي عن أنس بن مالك روى عنه فليح بن سليمان(@)(@@)(@@)(@@) $ 4357 - عثمان بن شماس مولى عبد الله بن عباس يروي عن أبي هريرة روى عنه ابنه موسى بن عثمان PageV05P157(@)(@@)(@@)(@@) $ 4358 - عثمان بن قيس من أهل الكوفة يروي عن جرير بن عبد الله روى عنه إسماعيل بن أبي خالد(@)(@@)(@@)(@@) $ 4359 - عثمان بن أبي الصهباء القرشي من أهل البصرة يروي عن أبي هريرة روى عنه البصريون(@)(@@)(@@)(@@) $ 4360 - عثمان بن أبي صفية الأنصاري يروي عن بن عباس عداده في أهل الكوفة روى عنه صالح بن حي وصالح بن جبير(@)(@@)(@@)(@@) $ 4361 - عثمان بن محمد بن أبي سويد يروي المراسيل روى عنه الزهري(@)(@@)(@@)(@@) $ 4362 - عثمان بن سليمان بن جرموز يروي عن أنس بن مالك روى عنه أهل البصرة(@)(@@)(@@)(@@) $ 4363 - عثمان بن عبد الله بن موهب القرشي مولى طلحة بن عبيد الله أصله من المدينة انتقل إلى العراق يروي عن أبي هريرة روى عنه الثوري وابنه عمرو بن عثمان(@)(@@)(@@)(@@) $ 4364 - عثمان بن عامر بن زيد الأنصاري من بنى عمرو بن عوف يروي عن أنس بن مالك عداده في أهل المدينة روى 
ms707	 عنه بن أخيه عاصم PageV05P158 بن سويد المدني قال جاءنا أنس بن مالك بقباء وعليه جبة أفواف وسراويل أفواف فتنحى فبال ثم قام إلى الجدار فنثر ذكره مرتين أو ثلاثا ثم أتى بتور من ماء فتوضأ ومسح على الخفين ثم دخل المسجد فصلى(@)(@@)(@@)(@@) $ 4365 - عثمان بن عبيد الراسبي يروي عن أبي الطفيل روى عنه مهدى بن ميمون وحماد بن زيد(@)(@@)(@@)(@@) $ 4366 - عثمان بن محصن يروي عن بن عباس روى عنه نوح بن قيس الطاحي(@)(@@)(@@)(@@) $ 4367 - عثمان بن إبراهيم بن محمد بن حاطب يروي عن بن عمر روى عنه ابنه عبد الرحمن بن عثمان(@)(@@)(@@)(@@) $ 4368 - علي بن حسين بن علي بن أبي طالب الهاشمي المدني كنيته أبو الحسن وقد قيل أبو محمد وكان من أفاضل بنى هاشم من فقهاء PageV05P159 أهل المدينة وعبادهم يروي عن جماعة من أصحاب رسول الله صلى الله عليه وسلم روى عنه الزهري وأهل المدينة مات سنة ثنتين وتسعين وله ثمان وخمسون سنة وقد قيل إنه مات سنة أربع وتسعين وأمه أم ولد وكان يقال بالمدينة إن علي بن الحسين سيد العابدين في ذلك الزمان(@)(@@)(@@)(@@) $ 4369 - علي بن عبد الله بن عباس بن عبد المطلب الهاشمي كنيته أبو محمد وقد قيل أبو عبد الله ولد ليلة قتل علي بن أبي طالب فسمى باسمه يروي عن أبيه روى عنه الزهري وابنه محمد بن علي وكان من العباد يصلى في كل يوم ألف ركعة وكان يخضب بالوسمة مات بالشام سنة ثمان عشرة ومائة وقد قيل سنة أربع عشرة ومائة وقد قيل سنة سبع عشرة ومائة أمه زرعة بنت مشرح بن معديكرب(@)(@@)(@@)(@@) $ 4370 - علي بن ربيعة الوالبي الأسدي ووالبة من أسد بن خزيمة كنيته أبو المغيرة عداده في أهل الكوفة يروي عن على وابن عمر روى عنه سعيد بن عبيدة وسلمة بن كهيل وهو علي بن ربيعة بن لقيط بن ربيعة بن خالد بن مالك بن عامر بن خراش بن نمير بن والبة بن الحارث بن ثعلبة بن دودان بن أسد بن 
ms708	 خزيمة PageV05P160(@)(@@)(@@)(@@) $ 4371 - علي بن رفاعة بن رافع يروي عن أبيه وله صحبة روى عنه يحيى بن جعدة(@)(@@)(@@)(@@) $ 4372 - أبو المتوكل الناجي اسمه علي بن داود ويقال داود من بنى سامة بن لؤي بن غالب عداده في أهل البصرة يروى عن بن عباس وأبي سعيد روى عنه بكر بن عبد الله المزني مات أبو المتوكل سنة ثمان ومائة(@)(@@)(@@)(@@) $ 4373 - علي بن رباح اللخمي من أهل مصر كنيته أبو موسى وهو الذي يقال له على وكان على يقول من قال لي علي فليس مني في حل يروي عن عمرو بن العاص وعقبة بن عامر روى عنه ابنه موسى بن علي(@)(@@)(@@)(@@) $ 4374 - علي بن سلمة القرشي يروي عن أبي هريرة روى عنه يحيى بن أبي كثير PageV05P161(@)(@@)(@@)(@@) $ 4375 - علي بن الأقمر الوادعي الهمداني من أهل الكوفة يروي عن أبي جحيفة روى عنه منصور والثوري وشعبة وهو أخو كلثوم بن الأقمر(@)(@@)(@@)(@@) $ 4376 - علي بن خالد الدؤلي يروي عن أبي هريرة وأبي أمامة روى عنه الضحاك بن عثمان وسعيد بن أبي أيوب وبكير بن الأشج(@)(@@)(@@)(@@) $ 4377 - علي بن سليم الحرار كنيته أبو سليم يروي عن أنس بن مالك روى عنه مسعر وأبو عوانة(@)(@@)(@@)(@@) $ 4378 - علي بن سليك يروي عن علي بن أبي طالب روى عنه عثمان بن إبراهيم الحاطبي(@)(@@)(@@)(@@) $ 4379 - علي بن خالد الأولي شيخ يروي عن أبي أمامة روى عنه سعيد PageV05P162 بن أبي أيوب وبكير بن الأشج(@)(@@)(@@)(@@) $ 4380 - علي بن شماخ السلمي يروي عن أبي هريرة روى عنه عقبة أبو الجلاس وعثمان بن شماس(@)(@@)(@@)(@@) $ 4381 - على الأسدي يروي عن جابر بن عبد الله روى عنه سعيد بن أبي أيوب(@)(@@)(@@)(@@) $ 4382 - علي بن عمارة يروي عن جابر بن سمرة روى عنه عمران بن رباح(@)(@@)(@@)(@@) $ 4383 - علي بن علقمة الأنماري يروي عن علي بن أبي طالب روى عنه سالم بن أبي الجعد(@)(@@)(@@)(@@) $ 4384 - علي بن الصلت يروي عن أبي أيوب الأنصاري روى عنه المسيب بن رافع ثنا أبو يعلى قال ثنا بشر بن الوليد قال ثنا شريك 
ms709	 عن الأعمش عن المسيب بن رافع عن علي بن الصلت عن أبى أيوب PageV05P163 الأنصاري أنه رآه يصلي أربع ركعات قال فقلت له إنك لتديم صلاتهن فقال رأيت رسول الله صلى الله عليه وسلم يصليهن حين تزول الشمس فقلت يا نبي الله إنك لتديم هذه الصلاة فقال إنها ساعة تفتح فيها أبواب السماء فأحب أن يرفع لي فيها عمل صالح(@)(@@)(@@)(@@) $ 4385 - علي بن عبد الله أبو حميدة ولد في عهد على وفرض له على روى عنه عبيده بن أبي رائطه(@)(@@)(@@)(@@) $ 4386 - علي بن عبد الله بن سعد بن عدى بن حارثة بن عمرو بن عامر بن ثعلبة بن امرئ القيس بن مازن بن الأزد البارقي وبارق جبل كان ينزله الأزد فنسب إليه كنيته أبو عبد الله من رهطه جماعة منهم محمد بن واسع يروي عن بن عمر روى عنه قتادة ويعلى بن عطاء ثنا الحسن بن سفيان قال ثنا أبو بكر بن أبي شيبة قال ثنا عبيدة بن حميد عن منصور عن مجاهد قال كان علي PageV05P164 الأزدي يختم القرآن في رمضان كل ليلة(@)(@@)(@@)(@@) $ 4387 - علي بن قيس العبدي من أهل الكوفة يروي عن بن الزبير روى عنه أخوه الأسود بن قيس(@)(@@)(@@)(@@) $ 4388 - علي بن أبي أمية يروي عن أبي قرصافة روى عنه الطيب بن زبان(@)(@@)(@@)(@@) $ 4389 - علي بن كردوس الحنفي كنيته أبو كردوس من أهل اليمامة يروي عن بن عمر روى عنه عكرمة بن عمار(@)(@@)(@@)(@@) $ 4390 - علي بن يزيد بن ركانة يروي عن جده وله صحبة فيما يقال روى عنه ابنه عبد الله بن علي(@)(@@)(@@)(@@) $ 4391 - علي بن أبى كثير يروي عن أبي مسعود الأنصاري روى عنه إسماعيل بن سميع(@)(@@)(@@)(@@) $ 4392 - علي بن مدرك النخعي الكوفي وكنيته أبو مدرك سمع أبا مسعود صاحب رسول الله صلى الله عليه وسلم روى عنه شعبة بن الحجاج مات سنة عشرين ومائة PageV05P165(@)(@@)(@@)(@@) $ 4393 - علي بن عبد الرحمن مولى ربيعة بن الحارث يروي عن حذيفة بن اليمان روى عنه حكيم بن حكيم(@)(@@)(@@)(@@) $ 4394 - أبو ماجدة اسمه 
ms710	 علي بن ماجدة السهمي يروي عن عمر روى عنه العلاء بن عبد الرحمن(@)(@@)(@@)(@@) $ 4395 - علي بن عبد الرحمن المعاوي الأنصاري من أهل المدينة يروي عن بن عمر روى عنه مسلم بن أبي مريم(@)(@@)(@@)(@@) $ 4396 - علي بن عبيد الساعدي يروي عن أبي أسيد الساعدي روى عنه ابنه أسيد بن علي(@)(@@)(@@)(@@) $ 4397 - علي بن مسلم يروي عن بن عمر روى عنه كثير أبو إسماعيل(@)(@@)(@@)(@@) $ 4398 - عمرو بن ميمون الأودي من أود كنيته أبو عبد الله أدرك الجاهلية دخل مكة خمسا وخمسين مرة بين حج وعمرة سكن الشام ثم انتقل إلى الكوفة يروى عن بن مسعود ومعاذ بن جبل روى عنه PageV05P166 أبو إسحاق السبيعي وأهل الكوفة مات سنة أربع أو خمس وسبعين(@)(@@)(@@)(@@) $ 4399 - عمرو بن بشر الضبي كان على قضاء البصرة بعد كعب بن سور روى عنه أهل البصرة(@)(@@)(@@)(@@) $ 4400 - عمرو بن دينار المكي الأثرم مولى بن باذان من مذحج وكان باذان عامل كسرى على اليمن كنيته أبو محمد يروى عن بن عباس وابن عمر وابن الزبير وجابر روى عنه أيوب وابن جريج والثوري والناس مات سنة ست وعشرين ومائة وقد جاوز السبعين وكان مولده سنة ست وأربعين(@)(@@)(@@)(@@) $ 4401 - عمرو بن سليم بن عمرو بن خلدة بن عامر بن مخلد بن عامر بن زريق الزرقي الأنصاري وهو الذي يقال له بن خلدة يروي عن أبي قتادة عداده في أهل المدينة روى عنه عامر بن عبد الله بن الزبير وسعيد المقبري وقيل إنه راهق الحلم يوم قتل عمر بن الخطاب PageV05P167(@)(@@)(@@)(@@) $ 4402 - عمرو بن شرحبيل أبو ميسرة الهمداني من أهل الكوفة من العباد كان ركبته كركبة البعير من كثرة الصلاة يروي عن عمر بن مسعود روى عنه أبو إسحاق السبيعي مات في الطاعون قبل أبي جحيفة سنة ثلاث وستين وقد قيل إن اسم أبي ميسرة عمرو بن شراحيل وهذا ليس بصحيح والصحيح شرحبيل(@)(@@)(@@)(@@) $ 4403 - عمرو بن عثمان بن عفان الأموي القرشي من أهل المدينة يروي عن أبيه وأسامة بن زيد روى الزهري عن علي بن 
ms711	 حسين عنه وأم عمرو وأبان وخالد وعمر بنو عثمان بن عفان أسماء بنت عمرو بن حممة الدوسية وقد قيل إن أم عمرو بن عثمان أم النجوم بنت جندب بن عمرو(@)(@@)(@@)(@@) $ 4404 - عمرو بن عطية التيمي بن النمر بن قاسط عداده في أهل الكوفة يروي عن عمر وسلمان روى عنه ربعي بن خراش وعاصم الأحول PageV05P168 وحماد بن أبي سليمان(@)(@@)(@@)(@@) $ 4405 - عمرو بن سعد بن عبادة الخزرجي يروي عن أبيه روى عنه ابنه سعيد بن عمرو وكان كنيته أبو عبادة(@)(@@)(@@)(@@) $ 4406 - عمرو بن أبان بن عثمان يروي عن جابر بن عبد الله روى عنه الزهري(@)(@@)(@@)(@@) $ 4407 - أبو الأعور السلمي اسمه عمرو بن سفيان بن عبد شمس بن سعد بن قائف بن الأوقص بن مرة بن هلال بن فالج بن ذكوان سمع جماعة من الصحابة وكان ممن شهد صفين وبئست الصفين لأهل الشام كانت وقد قيل إن لأبي الأعور صحبة(@)(@@)(@@)(@@) $ 4408 - عمرو بن عبد الله بن قيس أبو بكر بن أبي موسى الأشعري يروي عن أبيه عداده في أهل الكوفة روى عنه عطاء بن السائب(@)(@@)(@@)(@@) $ 4409 - عمرو بن وهب الثقفي يروي عن المغيرة بن شعبة روى عنه محمد بن سيرين(@)(@@)(@@)(@@) $ 4410 - بن أكيمة الخولاني يروي عن أبي هريرة اسمه عمرو بن مسلم بن PageV05P169 عمارة بن أكيمة روى عنه الزهري وأخوه عمرو بن مسلم بن عمارة يروي عن سعيد بن المسيب وسعيد بن أبي هلال ومحمد بن عمرو بن علقمة روى عنه مالك وقال عمرو بن مسلم وإنما هو عمر بن مسلم لا عمرو لأن مالكا لم يدرك عمرا(@)(@@)(@@)(@@) $ 4411 - عمرو بن عاصم بن سفيان بن عبد الله الثقفي أخو بشر بن عاصم يروي عن أبي هريرة روى عنه يعلى بن عطاء وابن أبي حسين(@)(@@)(@@)(@@) $ 4412 - عمرو بن النعمان بن مقرن المزني يروي عن جماعة من أصحاب رسول الله صلى الله عليه وسلم عداده في أهل البصرة وكان من قرائهم روى عنه معاوية بن قرة ثنا الحسن بن سفيان قال ثناه أبو بكر بن 
ms712	 أبي شيبة قال ثنا محمد بن بشر قال ثنا عبد الله بن الوليد قال ثنا يحيى عن أيوب قال ثنا معاوية بن قرة قال كنت نازلا على عمرو بن النعمان بن مقرن فلما حضر رمضان جاء رجل بألفي درهم من قبل مصعب بن الزبير فقال إن الأمير يقرئك السلام ويقول إنا لم ندع قارئا شريفا إلا وقد وصل إليه منا معروف فاستعن بهذين على بقية شهرك فقال عمرو اقرأ على الأمير السلام وقل والله ما قرأنا القرآن نريد به الدنيا وردها عليه(@)(@@)(@@)(@@) $ 4413 - عمرو بن أبي جندب الهمداني ويقال عمر بن جندب أبو عطية الوادعي وقد قيل اسمه مالك بن أبي جندب يروي عن جماعة من PageV05P170 أصحاب رسول الله صلى الله عليه وسلم روى عنه علي بن الأقمر وأبو إسحاق مات في ولاية مصعب بن الزبير على العراق(@)(@@)(@@)(@@) $ 4414 - عمرو بن الأسود العنسي كنيته أبو عياض وقد قيل أبو عبد الرحمن من عباد أهل الشام وزهادهم وكان يقسم على الله فيبره يروي عن عمرو ومعاوية روى عنه خالد بن معدان والشاميون وكان إذا خرج من بيته وضع يمينه على شماله مخافة الخيلاء(@)(@@)(@@)(@@) $ 4415 - عمرو بن بعجة اليشكري البارقي وبارق جبل ينزله الأزد يروي عن على روى عنه أبو إسحاق السبيعي(@)(@@)(@@)(@@) $ 4416 - عمرو بن وابصة بن معبد يروي عن أبيه روى عنه أهل الجزيرة أمه الشعثاء بنت عمرو بن بشر ذي الرمحين بن قيس(@)(@@)(@@)(@@) $ 4417 - عمرو بن الحارث من أصحاب معاذ بن جبل يروي عن معاذ روى عنه الزهري وعيسى بن حصين(@)(@@)(@@)(@@) $ 4418 - عمرو بن بجدان العامري يروي عن أبي ذر وأبي زيد PageV05P171 الأنصاري عداده في أهل البصرة روى عنه أبو قلابة(@)(@@)(@@)(@@) $ 4419 - عمرو بن سفيان يروي عن بن عباس روى عنه الأسود بن قيس(@)(@@)(@@)(@@) $ 4420 - عمرو بن تميم يروى عن بن الزبير عداده في أهل مكة روى عنه عثمان بن الأسود(@)(@@)(@@)(@@) $ 4421 - عمرو بن سلمة بن الحارث الهمداني من أهل الكوفة يروي عن على وابن مسعود روى عنه أهل الكوفة 
ms713	 مات سنة خمس وثمانين ودفن مع عمرو بن حريث في يوم واحد وهو أخو عبد الله بن سلمة سمعا جميعا عن على(@)(@@)(@@)(@@) $ 4422 - عمرو بن ثابت العتواري الليثي يروى عن بن عمر وأبي سعيد الخدري روى عنه ابناه محمد بن عمرو ونافع بن عمرو(@)(@@)(@@)(@@) $ 4423 - عمرو بن عبد الرحمن بن سابط الجمحي المكى يروى عن بن عباس إن كان سمع منه روى عنه خالد بن يزيد PageV05P172(@)(@@)(@@)(@@) $ 4424 - عمرو بن طلحة يروي عن أمه حمنة بنت جحش حديث الاستحاضة روى عنه إبراهيم بن محمد بن طلحة وأحسبه وهما إنما هو عمران بن طلحة(@)(@@)(@@)(@@) $ 4425 - عمرو بن حبشي الزبيدي يروي عن بن عباس وابن عمر روى عنه عبد الله بن مقدام وهو الذي يقال له عمرو بن حريش(@)(@@)(@@)(@@) $ 4426 - عمرو بن حسان شيخ يروي عن أنس بن مالك روى عنه يحيى بن سعيد الأنصاري(@)(@@)(@@)(@@) $ 4427 - عمرو بن حنظلة يروي عن حذيفة روى عنه أبو قيس الأودي(@)(@@)(@@)(@@) $ 4428 - عمرو بن أوس بن حذيفة يروي عن أبيه والمغيرة بن شعبة روى عنه عثمان بن عبد الله بن أوس(@)(@@)(@@)(@@) $ 4429 - عمرو بن عتبة بن فرقد السلمي من العباد يروي عن جماعة من الصحابة روى عنه أهل العراق قتل بتستر في خلافة عثمان وكان يرعى ركائب الصحابة وسحابة تظله وربما بات وإلى جنبه سبع يحميه(@)(@@)(@@)(@@) $ 4430 - عمرو بن الخطاب السدوسي يروي عن بن عمر وعائشة وابن PageV05P173 عباس روى عنه بن سيرين ويحيى بن أبي كثير(@)(@@)(@@)(@@) $ 4431 - عمرو بن علقمة بن وقاص الليثي والد محمد بن عمرو يروي عن بلال بن الحارث المزني روى عنه ابنه محمد بن عمرو(@)(@@)(@@)(@@) $ 4432 - عمرو بن زنيب يروي عن أنس بن مالك روى عنه الحجاج بن الحجاج الأسلمي وهو الذي يروي عنه يحيى بن أبي كثير ويقول عمرو بن بلال الغبري(@)(@@)(@@)(@@) $ 4433 - عمرو بن أبي خبيب يروي عن عوف بن مالك الأشجعي روى عنه برد بن أبي زياد أخو يزيد بن أبي زياد(@)(@@)(@@)(@@) $ 4434 - عمرو بن زرارة يروي عن بن مسعود 
ms714	 روى عنه أبو إسحاق السبيعي(@)(@@)(@@)(@@) $ 4435 - عمرو بن سليم الحضرمي يروى عن بن عمر ورجاء بن حيوة عداده في أهل مصر روى عنه أهلها PageV05P174(@)(@@)(@@)(@@) $ 4436 - عمرو بن أبي مغيث يروي عن عمر بن الخطاب روى عنه محمد بن أبي يحيى(@)(@@)(@@)(@@) $ 4437 - عمرو بن راشد الأشجعي مولى أشجع كنيته أبو راشد يروي عن عمر وعلى ووابصة بن معبد عداده في أهل الكوفة روى عنه هلال بن يساف ونصير بن دعلوق أبو طعمة(@)(@@)(@@)(@@) $ 4438 - عمرو بن عبيد الأنصاري وليس بالبصري والد محمد بن عمرو الأنصاري يروي عن أنس بن مالك روى عنه ابنه محمد بن عمرو وكان من ساكني الأهواز(@)(@@)(@@)(@@) $ 4439 - عمرو بن زياد اليحصبي يروي عن رجل من أصحاب النبي صلى الله عليه وسلم عداده في أهل مصر روى عنه أهلها وكنيته أبو فراس(@)(@@)(@@)(@@) $ 4440 - عمرو بن أوس الثقفي يروي عن عبد الله بن عمرو روى عنه عمرو بن دينار وهو الذي روى عن عنبسة بن أبي سفيان عن أم حبيبة(@)(@@)(@@)(@@) $ 4441 - أبو قرة اسمه عمرو بن سلمة القاضي يروي عن جماعة من الصحابة روى عنه أهل الكوفة PageV05P175(@)(@@)(@@)(@@) $ 4442 - عمرو بن رافع المدني مولى عمر بن الخطاب يروي عن حفصة بنت عمر روى عنه أبو سلمة بن عبد الرحمن وزيد بن أسلم(@)(@@)(@@)(@@) $ 4443 - عمرو بن عبيد الله الأنصاري من بنى الحارث بن الخزرج من أهل المدينة يروي عن بن عباس روى عنه مالك بن أنس وسليمان بن بلال(@)(@@)(@@)(@@) $ 4444 - عمرو بن سفيان بن عبد الله بن ربيعة الثقفي أخو عاصم وعبد الله يروي عن أبيه وله صحبة عداده في أهل الحجاز روى عنه أهلها وعمرو بن شعيب(@)(@@)(@@)(@@) $ 4445 - عمرو بن شداد الليثي يروي عن مسور بن مخرمة روى عنه وهب بن كيسان(@)(@@)(@@)(@@) $ 4446 - عمرو بن أبي عبيد والى أهل المدينة يروي عن أبي هريرة روى عنه يحيى بن سعيد الأنصاري وابن أبي ذئب(@)(@@)(@@)(@@) $ 4447 - عمرو بن عبد الله بن أبي طلحة يروي عن أنس بن مالك وابن الزبير روى عنه محمد 
ms715	 بن إسحاق وجرير بن زيد قصة الغرض PageV05P176(@)(@@)(@@)(@@) $ 4448 - عمرو بن الحارث بن المصطلق يروى عن بن مسعود ما صمت مع رسول الله صلى الله عليه وسلم تسعة وعشرين أكثرا مما صمت معه ثلاثين رواه بن المبارك عن عيسى بن دينار عن أبيه وقال سمعت عمرو بن الحارث بن المصطلق(@)(@@)(@@)(@@) $ 4449 - أبو إسحاق السبيعي اسمه عمرو بن عبد الله الهمداني وسبيع بطن من همدان مولده سنة تسع وعشرين في خلافة عثمان رأى عليا وأسامة بن زيد وابن عباس والبراء بن عازب وزيد بن أرقم وأبا جحيفة وابن أبي أوفى روى عنه الأعمش ومنصور والثوري والناس مات سنة سبع وعشرين ومائة يوم ظفر الضحاك بن قيس بالكوفة وكان مدلسا كان الشعبي أكبر منه بسنة أو سنتين ويقال كان مولده سنة اثنتين وثلاثين(@)(@@)(@@)(@@) $ 4450 - عمرو بن عبد الله بن صفوان بن أمية بن خلف القرشي الجمحي أخو صفوان بن عبد الله بن صفوان بن أمية بن خلف يروي عن أبيه وجماعة من أصحاب النبي صلى الله عليه وسلم عداده في أهل المدينة روى عنه عمرو بن دينار PageV05P177(@)(@@)(@@)(@@) $ 4451 - عمرو بن عبد الرحمن بن أخي يعلى بن أمية يروي عن عمه يعلى بن منية روى عنه الزهري(@)(@@)(@@)(@@) $ 4452 - عمرو بن رافع مولى عمر بن الخطاب يروي عن حفصة بنت عمرو روى عنه نافع مولى بن عمر وأبو جعفر محمد بن علي(@)(@@)(@@)(@@) $ 4453 - عمرو أبو الأسود الديلي اسمه عمرو بن سفيان وقد قيل عمرو بن ظالم ويقال ظالم بن عمرو يروي عن على وأبي موسى وأبي ذر وعمران بن حصين ويقال إنه أول من تكلم في النحو روى عنه الناس وكانت أمه من بني عبد الدار بن قصي(@)(@@)(@@)(@@) $ 4454 - عمرو بن سعيد بن العاص يروي عن عثمان بن عفان روى عنه ابنه سعيد بن عمرو(@)(@@)(@@)(@@) $ 4455 - عمرو بن سعيد الجاري مولى عمر بن الخطاب يروى عن بن عمر وأبي هريرة وعبد الله بن عمرو روى عنه زيد بن أسلم وعبد الملك بن أعين PageV05P178(@)(@@)(@@)(@@) $ 4456 - أبو 
ms716	 أسماء الرحبي اسمه عمرو بن مرثد وقد قيل عمرو بن أسماء يروي عن ثوبان وشداد بن أوس روى عنه أبو قلابة(@)(@@)(@@)(@@) $ 4457 - عمرو بن عبيد العبشمي من أهل الشام يروي عن ثوبان روى عنه أبو الأشهب(@)(@@)(@@)(@@) $ 4458 - أبو عبد الجبار اسمه عمرو بن عبد الله الحضرمي يروي عن أبي هريرة روى عنه يحيى بن أبي عمرو السيباني(@)(@@)(@@)(@@) $ 4459 - عمرو بن خالد بن عرفطة يروي عن أبيه وله صحبة روى عنه ابنه كلاب بن عمرو(@)(@@)(@@)(@@) $ 4460 - عمرو بن أبي الوليد يروي عن عمر بن الخطاب روى عنه يزيد بن أبي حبيب(@)(@@)(@@)(@@) $ 4461 - عمرو بن حريث المدني المخزومي يروى عن بن عباس وأبي هريرة روى عنه سعيد بن أبي سعيد المقبري وأهل مصر PageV05P179(@)(@@)(@@)(@@) $ 4462 - عمرو بن الشريد بن سويد الثقفى يروى عن بن عباس وأبيه روى عنه إبراهيم بن ميسرة(@)(@@)(@@)(@@) $ 4463 - عمرو بن أبي سفيان الجمحي يروى عن بن الزبير أنه أتى بسارق فقطع يده روى عنه سفيان الثوري(@)(@@)(@@)(@@) $ 4464 - عمرو بن غالب الهمداني من أهل الكوفة يروي عن عائشة روى عنه أبو إسحاق السبيعي(@)(@@)(@@)(@@) $ 4465 - عمرو بن أبي سفيان بن أسيد بن جارية الثقفي حليف بنى زهرة يروي عن أبي هريرة وأبي موسى روى عنه الزهري والحجاج بن فرافصة عداده في أهل المدينة(@)(@@)(@@)(@@) $ 4466 - عمرو بن قيس الكندي الحمصي كنيته أبو ثور وهو الذي يقال له عمرو بن قيس السكوني يروي عن عبد الله بن عمر روى عنه الأوزاعي وأهل الشام مات سنة أربعين ومائة وهو بن مائة سنة وكان مولده سنة أربعين سنة الجماعة(@)(@@)(@@)(@@) $ 4467 - أبو حية الوادعي عمرو بن عبد الله الأصم الهمداني الكوفي يروي عن بن مسعود روى عنه أبو إسحاق السبيعي وأهل الكوفة PageV05P180(@)(@@)(@@)(@@) $ 4468 - عمرو بن عبد الله بن ذؤيب المليكي من أهل الشام يروي عن أبي الدرداء روى عنه صفوان بن عمرو(@)(@@)(@@)(@@) $ 4469 - عمرو بن مرداس يروي عن بلال روى عنه أبو الورد بن ثمامة(@)(@@)(@@)(@@) $ 4470 - عمرو بن صليع البصري يروي عن حذيفة بن اليمان روى 
ms717	 عنه صخر بن الوليد(@)(@@)(@@)(@@) $ 4471 - عمرو بن عبد الملك بن حريث المخزومي يروي عن عمه عمرو بن حريث روى عنه حصين بن عبد الرحمن(@)(@@)(@@)(@@) $ 4472 - عمرو بن أبي قرة الكندي يروي عن عمر وحذيفة روى عنه الشيباني(@)(@@)(@@)(@@) $ 4473 - عمرو بن عبد الملك الأسدي إن عمر لما افتتح السواد بعث عثمان بن حنيف فمسح ما دون دجلة ووضع على كل جريب من الأرض PageV05P181 يبلغه الماء عامرا كان أو غامرا درهما وقفيزا روى عنه عبد الله بن الوليد المزني(@)(@@)(@@)(@@) $ 4474 - عمرو بن سعيد بصرى يروي عن أنس بن مالك روى عنه أيوب السختياني(@)(@@)(@@)(@@) $ 4475 - عمرو بن معاذ بن سعد بن معاذ الأشهلي الأنصاري من أهل المدينة يروي عن جدته ولها صحبة روى عنه زيد بن أسلم(@)(@@)(@@)(@@) $ 4476 - عمرو بن ماتع المعافري يروي عن عبد الله بن عمرو عداده في أهل مصر روى عنه خالد بن يزيد وعبد الله بن سليمان(@)(@@)(@@)(@@) $ 4477 - عمرو بن عامر الأنصاري يروي عن أنس بن مالك روى عنه الثوري وشعبة PageV05P182(@)(@@)(@@)(@@) $ 4478 - عمرو بن مالك الجنبي أبو على الهمداني من أهل مصر يروي عن عقبة بن عامر وفضالة بن عبيد روى عنه حميد بن هانئ وأهل مصر(@)(@@)(@@)(@@) $ 4479 - عمرو بن مرة الجملي المرادي من أهل الكوفة كنيته أبو عبد الرحمن ويقال أبو عبد الله يروي عن بن أبي أوفى روى عنه الأعمش ومنصور مات سنة ست عشرة ومائة وكان مرجئا(@)(@@)(@@)(@@) $ 4480 - عمرو بن سفيان يروي عن على روى عنه سعيد بن عمرو بن سفيان PageV05P183(@)(@@)(@@)(@@) $ 4481 - عمرو بن كيسان يروي عن بن عباس يا أهل مكة لا يغرنكم أن لا تعتمروا روى عنه عمرو بن دينار(@)(@@)(@@)(@@) $ 4482 - عمرو بن مساحق يروي عن عمر بن الخطاب روى عنه النضر بن عبد الله(@)(@@)(@@)(@@) $ 4483 - عمرو بن الوليد بن عبدة يروي عن عبد الله بن عمرو روى عنه يزيد بن أبي حبيب(@)(@@)(@@)(@@) $ 4484 - عمرو بن عبد الله أبو سعيد شيخ يروي عن جابر بن عبد الله روى عنه سعيد بن أبي هلال(@)(@@)(@@)(@@) $ 4485 
ms718	 - عمرو بن أبي يوسف أحد بنى نوفل يروي عن معاوية بن أبى سفيان روى عنه بن صيفى أبو صيفى PageV05P184(@)(@@)(@@)(@@) $ 4486 - عمرو بن أبي عمرو مولى المطلب بن عبد الله بن حنطب المخزومي من أهل الحجاز واسم أبي عمرو ميسرة يروي عن أنس بن مالك روى عنه مالك وابن الهاد والناس مات في ولاية أبي جعفر ربما أخطأ يعتبر حديثه من رواية الثقات عنه(@)(@@)(@@)(@@) $ 4487 - عامر بن شراحيل بن عبد الشعبي من شعب همدان من أهل الكوفة كنيته أبو عمرو وكان أكبر من أبي إسحاق السبيعي بسنتين روى عنه الناس وكان فقيها شاعرا مولده سنة عشرين وقد قيل سنة إحدى وعشرين ومات سنة تسع ومائة وقد قيل PageV05P185 سنة خمس ومائة ويقال أربع ومائة على دعابة فيه وقد نيف على الثمانين وكانت أمه من سبى جلولاء روى عن خمسين ومائة من أصحاب رسول الله صلى الله عليه وسلم(@)(@@)(@@)(@@) $ 4488 - عامر بن سعد بن أبي وقاص الزهري القرشي أخو مصعب ومحمد ويحيى وعمر وإبراهيم وعائشة أولاد سعد يروي عن عثمان بن عفان وأبيه روى عنه الزهري مات سنة أربع ومائة أمه أم ولد(@)(@@)(@@)(@@) $ 4489 - عامر بن عبد الله بن الزبير بن العوام القرشي من أهل المدينة كنيته أبو الحارث كان عالما فاضلا يروي عن أبيه روى عنه PageV05P186 زياد بن سعد ومالك مات سنة إحدى وعشرين ومائة أمه حنتمة بنت عبد الرحمن بن الحارث بن هشام بن المغيرة(@)(@@)(@@)(@@) $ 4490 - عامر بن عبد الله بن عبد قيس التميمي العنبري كنيته أبو عبد الله من عباد أهل البصرة وزهادهم كثرت الأخبار عنه في الصلاح يعنى عن الاشتغال بذكرها وهو من الزهاد الثمانية رأى جماعة من أصحاب رسول الله صلى الله عليه وسلم روى عنه الحسن وابن سيرين وأهل البصرة لست أحفظ له خبرا مسندا حدث به(@)(@@)(@@)(@@) $ 4491 - عامر بن أبي أمية المخزومي القرشي أخو أم سلمة يروي عن أم سلمة روى عنه سعيد بن المسيب(@)(@@)(@@)(@@) $ 4492 - أبو بردة بن أبي موسى اسمه عامر بن عبد الله 
ms719	 بن قيس يروى عن PageV05P187 على وأبيه وابن عمر روى عنه الناس وكان على قضاء الكوفة مات سنة أربع ومائة وقد نيف على الثمانين وقد قيل إن اسم أبي بردة الحارث والصحيح عامر(@)(@@)(@@)(@@) $ 4493 - عامر بن النباح مؤذن علي يروي عن علي بن أبي طالب روى عنه الكوفيون(@)(@@)(@@)(@@) $ 4494 - عامر بن عبد الرحمن اليحصبي يروي عن بن عباس عداده في أهل مصر روى عنه خالد بن سليمان(@)(@@)(@@)(@@) $ 4495 - عامر بن عبد الله بن لحى أبو اليمان الهوزني من أهل الشام يروي عن سلمان وصفوان بن أمية روى عنه أبو عبد الرحمن الحبلى والشاميون PageV05P188 وأبوه أبو عامر الهوزني اسمه عبد الله بن لحى قد ذكرناه فيما قبل(@)(@@)(@@)(@@) $ 4496 - عامر بن سعد البجلي من أهل الكوفة يروي عن جرير بن عبد الله البجلي روى عنه أبو إسحاق السبيعي(@)(@@)(@@)(@@) $ 4497 - أبو العشراء الدارمي اسمه عامر بن أسامة بن مالك بن قهطم يروي عن أبيه وله صحبة روى عنه حماد بن سلمة وكان نزل الجفرة على طريق البصرة(@)(@@)(@@)(@@) $ 4498 - عامر بن عبدة أبو إياس البجلي من أهل الكوفة يروي عن بن مسعود روى عنه المسيب بن رافع PageV05P189(@)(@@)(@@)(@@) $ 4499 - عامر بن مسعود يروي المراسيل روى عنه عبد العزيز بن رفيع ونمير بن غريب الهمداني ومن زعم أن له صحبة بلا دلالة فقد وهم(@)(@@)(@@)(@@) $ 4500 - أبو المليح اسمه عامر بن أسامة بن عمير الهذلي من أهل البصرة يروي عن أبيه وبريدة وعوف بن مالك روى عنه أبو قلابة وقتادة وكان عامل الحجاج على الأبلة مات سنة ثمان وتسعين ومن زعم أن اسمه زياد أو زيد بن أسامة فقد وهم ومنهم من زعم أنه مات سنة ثمان ومائة وقد قيل إنه مات سنة ثنتي عشرة ومائة(@)(@@)(@@)(@@) $ 4501 - عامر بن أبي عامر الأشعري يروي عن أبيه ومعاوية روى عنه PageV05P190 مالك بن مسروح(@)(@@)(@@)(@@) $ 4502 - عامر بن مطر الشيباني يروي عن بن مسعود روى عنه الشعبي وجبلة بن سحيم(@)(@@)(@@)(@@) $ 4503 - عامر بن زيد البكالي يروي عن عتبة بن عبد روى عنه 
ms720	 أبو سلام ويحيى بن أبي كثير عداده في أهل الشام(@)(@@)(@@)(@@) $ 4504 - عامر بن جشيب من أهل الشام يروي عن أبي أمامة روى عنه أهلها(@)(@@)(@@)(@@) $ 4505 - عامر بن مالك يروي عن صفوان بن أمية روى عنه أبو عثمان النهدي PageV05P191(@)(@@)(@@)(@@) $ 4506 - عامر بن ذؤيب العجلي يروي عن بن عباس روى عنه حصين بن عبد الرحمن(@)(@@)(@@)(@@) $ 4507 - عامر بن عبيدة الباهلي قاضي البصرة يروي عن أنس روى عنه شعبة بن الحجاج(@)(@@)(@@)(@@) $ 4508 - عامر بن لدين الأشعري يروي عن أبي هريرة عداده في أهل الشام روى عنه أهلها وأبو بشر(@)(@@)(@@)(@@) $ 4509 - عامر بن مصعب يروي عن عائشة لم أعلم له راويا إلا إبراهيم بن المهاجر وربما قال مصعب بن عامر لا يعجبني الاعتبار بحديث إبراهيم بن المهاجر PageV05P192(@)(@@)(@@)(@@) $ 4510 - عامر بن رزيق مولى بن عامر يروي عن أنس بن مالك روى عنه القاسم(@)(@@)(@@)(@@) $ 4511 - عامر بن طهفة السهمي شيخ يروي عن أبي الطفيل روى عنه شيخ يقال له الربيع حكاية(@)(@@)(@@)(@@) $ 4512 - عامر بن عبد الواحد الأحول شيخ يروي عن عائذ بن عمرو روى عنه أبو الأشهب PageV05P193(@)(@@)(@@)(@@) $ 4513 - عامر بن عمرو يروي عن أبي هريرة عداده في أهل الحجاز روى عنه هدبة بن الحكم(@)(@@)(@@)(@@) $ 4514 - عامر بن خارجة بن سعد يروي عن جده عن النبي صلى الله عليه وسلم حديثا منكرا في المطر روى عنه حفص بن النضر السلمي لا يعجبني ذكره(@)(@@)(@@)(@@) $ 4515 - عروة بن الزبير بن العوام القرشي من أهل المدينة كنيته أبو عبد الله أخو عبد الله بن الزبير أمهما أسماء بنت أبي بكر الصديق يروي عن عائشة وأبيه وعبد الله بن عمرو روى عنه الزهري وكان من أفاضل PageV05P194 أهل المدينة وعلمائهم ويقرأ كل يوم ربع القرآن في المصحف نظرا ويقوم به ليلة ما ترك نصيبه من الليل ولا ليلة قطعت رجله وذلك أن الأكلة وقعت فيها فنشرها فما زاد على أن قال الحمد لله وكان إذا أيام الرطب ثلم حائطه وأذن للناس أن يدخلوا فيأكلوا ويحملوا واختلف فمنهم من قال إنه مات سنة 