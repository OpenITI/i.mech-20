ms49	 مادة عود.(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO أغرسطس(@)(@)(@@) : (يونانية)، نوع من النجيليات، انظر معجم الادريسي.(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO أغرل أو أغريل(@)(@)(@@) : تحريف كلمة رومانية مشتقة من اللاتينية glis ( زغبة، الفأرة النوامة) .. وفي لغة الأقاليم glire، وبالأسبانية liron) تجمع على أغرليات: الفأرة النوامة، زغبة، جرذ سنجابي جمعه أغرليات (فوك).(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO إغريل(@)(@)(@@) : (أسبانية): جدجد، صرار الليل (الكالا).(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO أغش(@)(@)(@@) : في معجم الكالا، و(@)(@)(@@)(@@)(@@) || AUTO أغش(@)(@)(@@) ت: أغسطس، شهر آب (سيمونه 237).(@)(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO أغش(@)(@)(@@) ية: = لغشية. (انظر: لغشية).(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO أغلال(@)(@)(@@) : (بربرية)، حلزون، قوقع. (دومب 67، رولاند، همبرت 68) وفي المستعيني مادة حلزون (في نسخة ن فقط): وتسمى بفلاة المغرب من فاس وتلمسان(@)(@)(@@)(@@)(@@) || AUTO أغلال(@)(@)(@@) ، وفي معجم البربر: Limaçon حلزون هو أجغلال وأبرجغلال.(@)(@)PageV01P157(@)(@)(@@)(@@)(@@) || CHECK أفسنتين(@)(@)(@@)(@@)(@@) || CHECK أفروطة(@)(@)(@@)(@@)(@@) || CHECK أفرنطال وفرنطال(@)(@)(@@)(@@)(@@) || CHECK أفام(@)(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO (@)(@)(@@)(@@)(@@) || AUTO أف(@)(@)(@@) : ت(@)(@)(@@)(@@)(@@) || AUTO (@)(@)(@@)(@@)(@@) || AUTO أف(@)(@)(@@) ف من فلان أو من شيء: أظهر الكراهية أو الضجر أو السأم منه (عبد الواحد 92، دى سلان المقدمة 1: 76).(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO (@)(@)(@@)(@@)(@@) || AUTO أف(@)(@)(@@) : في معجم فريتاج بمعنى paucitas أي قلة ويجب أن تحذف (انظر فليشر في تعليقه على المقري 2: 280، بريشت 203).(@)(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO (@)(@)(@@)(@@)(@@) || AUTO أف(@)(@)(@@) ام: دين، واجب محتوم (هيلو، رولاند).(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO إفرنجية أو فرنجية(@)(@)(@@) : ضرب من آلات الحرب (مونج 136، 137).(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO (@)(@)(@@)(@@)(@@) || AUTO أف(@)(@)(@@) رنطال وفرنطال: (أسبانية) جمعها بالألف والتاء، حشية توضع تحت السير الذي يثبت النير على رؤوس الجاموس خشية أن يجرحها (الكالا) وتسمى اليوم فرنتال في بلنسية وفرونتيل في قشتلانة.(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO (@)(@)(@@)(@@)(@@) || AUTO أف(@)(@)(@@) روطة: (أسبانية): أسطول (الكالا، أسطول سفن) كرتاس 222، 224، 225 الخ (يذكر ذلك في كلامه عن أسطول النصارى فقط).(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO إفريقية(@)(@)(@@) : دجاجة مطبوخة بزيت الزيتون. ففي رياض النفوس (69ق): فعملت أخته في ليلة من الليالي دجاجة(@)(@)(@@)(@@)(@@) || AUTO (@)(@)(@@)(@@)(@@) || AUTO أف(@)(@)(@@) ريقية (كذا) ووجهت بها إليه. وفي ص 91و: فقال سلم أنا اشتهي(@)(@)(@@)(@@)(@@) || AUTO (@)(@)(@@)(@@)(@@) || AUTO أف(@)(@)(@@) ريقية (كذا) بزيت طيب. وبعدها: فقدم إليهم ثردة بدجاجة وعليها زيت طيب وقال لسالم كل يا سالم يا صاحب ال(@)(@)(@@)(@@)(@@) || AUTO (@)(@)(@@)(@@)(@@) || AUTO أف(@)(@)(@@) ريقية (كذا).(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO افس(@)(@)(@@) : افيس: اسم يطلقه ال(@)(@)(@@)(@@)(@@) || AUTO (@)(@)(@@)(@@)(@@) || AUTO أف(@)(@)(@@) ريقيون على الضبع (أبو الوليد 799).(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO (@)(@)(@@)(@@)(@@) || AUTO أف 
ms50	(@)(@)(@@) سنتين: هو الابسنت عند فريتاج، وهمزته مكسورة في فوك.(@)(@)PageV01P158(@)(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO افطهاج(@)(@)(@@) : ابسنت، ذكرها المستعيني في مادة افسنتين وفي نسخة لم: افطها بدون جيم.(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO افق(@)(@)(@@) : أفق: نصف كرة الأرض (فوك).(@)(@@) أفق الملائكة: نهاية مقام الروح عند الصوفية، ففي مقدمة ابن خلدون (3: 64): الأفق الأعلى أفق الملائكة.(@)(@@) أفقي = أفقي وأفقي: وردت في شعر ذكره ويجرز 192 - نسبة إلى الأفق (بوشر) ولم تضبط فيه.(@)(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO أفليو(@)(@)(@@) : (باللاتينية Pulegium) : حبق، نعنع، صعتر (دومب 73) انظر: فلى.(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO افلنجمشك(@)(@)(@@) : فرنجمشك (ابن البيطار 2: 254).(@)(@)PageV01P159(@)(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO افلنجة أو فلنجة(@)(@)(@@) : فارسية، انظر المعاجم الفارسية مادة افلنجة وفلنجة. وفي المستعيني: قيل إنها حشيشة تقع في الغالية وهي فلنجة، وهي مثل حب الخردل وأكبر، لها عيدان صغار مثل الصعتر، وأكبرها أجودها، وهو الزرنب بالزاء وهو أرجل (في نسخة رجل) الجراد، واقرأها رزنب بدل الزنب. وانظر ابن البيطار (1: 525) ففيه: الدمشقي: الزررنب يسمى أرجل الجراد، انظر أيضا ابن البيطار (2: 261).(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO افلوس(@)(@)(@@) : أمرد، خمان الماء، بلسان الماء (جنبة، شجيرة). (بوشر).(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO افه وافوه(@)(@)(@@) : أف (هابشت معجم 2).(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO افوغوس(@)(@)(@@) : عرقية الراهب، مضاض (جنبة، شجيرة). (بوشر).(@)(@)PageV01P160(@)(@)(@@)(@@)(@@) || CHECK أفيوني(@)(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO افيثمون(@)(@)(@@) : افتيمون (معجم المنصوري انظر: كشوث، فلاندر 67).(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO أفيون(@)(@)(@@) : دهن ال(@)(@)(@@)(@@)(@@) || AUTO أفيون(@)(@)(@@) وروح ال(@)(@)(@@)(@@)(@@) || AUTO أفيون(@)(@)(@@) : دهن يستخرج من ال(@)(@)(@@)(@@)(@@) || AUTO أفيون(@)(@)(@@) (بوشر) - والأوراق الجافة من الحشيشة التي يدخنها الحشاشون (مالتزان 141).(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO أفيون(@)(@)(@@) ي: الذي يدخن ال(@)(@)(@@)(@@)(@@) || AUTO أفيون(@)(@)(@@) لذة ومتعة (بوشر، ألف ليلة برسل، 7: 43).(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO أق أغاج(@)(@)(@@) : (تركية)، مران، شجرة لسان العصافير (بوشر).(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO أقترمة(@)(@)(@@) : (تركية)، غنيمة سفينة، أو غنيمة بضاعة سفينة تجارية (بوشر).(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO اقحوان(@)(@)(@@) : انظر مادة قحو.(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO اقديميا(@)(@)(@@) :(@)(@@) ذكرها فريتاج في معجمه ويجب حذفها. وأقليميا التي ذكرها الرازي ليست خطأ كما يرى فريتاج، بل هي الصواب، وقد PageV01P161 (@@) ذكرها فريتاج نفسه في حرف القاف.(@)(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO اقراباذين(@)(@)(@@) : أو قراباذين. وهي كلمة يونانية في رأي حاجي خليفة (1: 378). وفي زيشر (5: 90) آراء عن أصل الكلمة، وتعني: الأدوية المركبة (بوشر). - ودستور الصيدلة أو الأدوية (فهرست ليدن 3: 255) وفي معجم بوشر(@)(@)(@@)(@@)(@@) || AUTO اقراباذين(@)(@)(@@) ات.(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO أقرشتة(@)(@)(@@) : من الأسبانية cresta: عرف الديك 
ms51	 (فوك).(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO أقرند(@)(@)(@@) : عار، عريان (فوك).(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO أقروف(@)(@)(@@) : وأخروف، تجمع على أقارف، ضرب من القلانس يعتمرها المغاربة، وهي قلنسوة عالية أسطوانية الشكل (فوك).(@)(@)(@@) وفي كتاب محمد بن الحارث ((275)): فلما قدم قرطبة ولاه الأمير (عبد الرحمن الثاني) رحمه الله القضاء فجلس للحكم في المسجد وعليه جبة صوف بيضاء وفي رأسه(@)(@)(@@)(@@)(@@) || AUTO أقروف(@)(@)(@@) أبيض وغفارة بيضاء من ذلك الجنس (وقد كتبت(@)(@)(@@)(@@)(@@) || AUTO أقروف(@)(@)(@@) في المخطوطة مضبوطة بالشكل) وقد كان هذا اللباس غاية في السذاجة لان المصنف يقول بعد ذلك: فلما نظر إليه الخصوم احتقروه. غير أن الكلمة تدل عند ابن الابار 162 على قلنسوة مصنوعة من نسيج فاخر. وهي عند ابن بطوطة (2: 379) مرادفة للفظة بغطاق الفارسية وهو غطاء للرأس من الذهب مرصع باللؤلؤ أو الجوهر تتخذه أميرات المغول، وينسدل PageV01P162 (@@) من طرفه ذيل يصل إلى الأرض (الجريدة الآسيوية 1847، 2: 170). انظر أيضا ابن بطوطة 2: 388، و3: 229. وقد جاءت مرتين بالخاء في مخطوطة جاينجوس لرحلة ابن بطوطة.(@)(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO أقريطشي(@)(@)(@@) : هي نسبة إلى جزيرة اقريطش (كريت) ويطلق على مخدر يعرف بالبنج (ألف ليلة برسل 4: 146، 380) وقد استعملت الكلمة اسما مرادفا لكلمة بنج (ألف ليلة برسل 7: 282) وفي طبعة ماكن بنج بدل اقريطشي.(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO اقريون، اقريوفش، اقريولش(@)(@)(@@) : حرف، حرف الماء، من اليونانية acryon acryoxardaion ( سيمونة 234) وفي معجم الكالا: اوكوريون.(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO اقسما(@)(@)(@@) : (يونانية) شراب فيه خل وعسل (ألف ليلة، برسل 2: 110، 114 = طبعة ماكن 1: 189).(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO اقسين(@)(@)(@@) : لبلاب (بوشر).(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO أقطن(@)(@)(@@) : ذكر فريتاج أنها من لغة أهل اليمن. وفي ابن البيطار (1: 71) اقطن بكسر الطاء هو الماش بلغة أهل اليمن، وانظر (2: 465) منه.(@)(@)PageV01P163(@)(@)(@@)(@@)(@@) || CHECK إقليميا(@)(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO أقلومية(@)(@)(@@) : حارس الاقلومية: وكيل كنيسة، أبيل، وكيل إدارة أملاك الكنيسة (بوشر).(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO أقلي(@)(@)(@@) : (رومانية، سيمونه 253) تجمع بالألف والتاء: مهماز (فوك).(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO إقليم(@)(@)(@@) : منطقة، منطقة القضاء (معجم الادريسي)، ولاية، ايالة، مقاطعة. (بوشر) - ال(@)(@)(@@)(@@)(@@) || AUTO إقليم(@)(@)(@@) المصري: ولاية مصر. -(@)(@)(@@)(@@)(@@) || AUTO إقليم(@)(@)(@@) الصعيد: مصر العليا. - ال(@)(@)(@@)(@@)(@@) || AUTO إقليم(@)(@)(@@) الوسطاني: مصر الوسطى. - ال(@)(@)(@@)(@@)(@@) || AUTO إقليم(@)(@)(@@) البحري: مصر السفلى (بوشر).(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO إقليم(@)(@)(@@) يا: أو قليميا من اليونانية كلوميا، وهو ثفل الفلز يعلو عند السبك ويرسب 
ms52	 إذا دار، وأكسيد الزنك المتجمع في مداخن الأفران العالية (المستعيني، معجم المنصوري، ابن البيطار 1: 43، 2: 314).(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO اقنوم(@)(@)(@@) :(@)(@)(@@)(@@)(@@) || AUTO اقنوم(@)(@)(@@) ي: نسبة إلى ال(@)(@)(@@)(@@)(@@) || AUTO اقنوم(@)(@)(@@) (بوشر).(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO اقنين(@)(@)(@@) : انظر: قنين.(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO أقوال(@)(@)(@@) : (بربرية): آلة موسيقية تستعمل في أفريقية (المقري 2: 144) وهي طبلة من الصلصال أو دف شد على وجه منه جلد. (انظر هوست 103، 262، وصورة طبل 31 رقم 9، وفيه مكتوب اكوال).(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO أقوبي(@)(@)(@@) : (أسبانية) نطل، وهو شراب يتخذ من عصارة العنب يصب عليها الماء (الكالا).(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO اقونة(@)(@)(@@) : صورة، وانظر: قونة.(@)(@)PageV01P164(@)(@)(@@)(@@)(@@) || CHECK أكتوبري(@)(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO أكابر(@)(@)(@@) : القافلة الكبرى، ففي الجريدة الآسيوية 1840، 1: 380: ثم ورد في بلد تنبكت في رفقة(@)(@)(@@)(@@)(@@) || AUTO أكابر(@)(@)(@@) ، ويقول بارت (5: 32) أن(@)(@)(@@)(@@)(@@) || AUTO أكابر(@)(@)(@@) للمفرد والجمع اكوابير. ففي كتابه غدامس ((164)) يقول: ((إن القافلة المراكشية الذاهبة إلى تنبكتو تسمى(@)(@)(@@)(@@)(@@) || AUTO أكابر)(@)(@)(@@) ) انظر ص192. وهي عند جاكسون 24، 61، 62، 75، أكابه. وقد كرر ذكرها في رحلة إلى تنبكتو وكذلك سماها جراميرج 144. وهذا خطأ منهما. والكلمة من غير شك ليست عربية (انظر بارت 1، 1) وليست جمع اللفظة العربية ((أكبر)) كما يراها دافيزاك (الجريدة الآسيوية 1، 1: 385).(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO أكتمكت(@)(@)(@@) : ذكرها فريتاج في معجمه، انظر ابن البيطار (1، 73، 294). وعند المستعيني (مخطوطة ن) حجر(@)(@)(@@)(@@)(@@) || AUTO أكتمكت(@)(@)(@@) ا وهي ليست واضحة في مخطوطة ل منه.(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO أكتوبر(@)(@)(@@) : شهر تشرين الأول.(@)(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO أكتوبر(@)(@)(@@) ي: سمك يظهر في شهر(@)(@)(@@)(@@)(@@) || AUTO أكتوبر(@)(@)(@@) في خليج تونس (البكري 41) ويسمى اليوم السمك الذي يظهر هناك في شهر(@)(@)(@@)(@@)(@@) || AUTO أكتوبر(@)(@)(@@) شلبة. وهو نوع(@)(@)PageV01P165(@)(@)(@@)(@@)(@@) || CHECK اكديش(@)(@)(@@) من سمك المرجان dorad. ( دي سلان).(@)(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO أكتورية(@)(@)(@@) :(@)(@@) (مختصر اكتوبرية): مرض يصاب به الغرباء في شهر أكتوبر في مدينة توجارت (كاريت جغرافية 247).(@)(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO اكد(@)(@)(@@) : انظر: وكد.(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO اكد(@)(@)(@@) يش: انظر: كديش.(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO أكرة(@)(@)(@@) : لغية في الكرة (انظر فليشر معجم 40) وتجمع على أكر. وهي الكرة - وتفاحة وهي عقدة على شكل التفاحة تستعمل للزينة، (بوشر).(@)(@@) اكر البحر: ليف البحر، ذكر ذلك ابن البيطار (1: 74) ولم يذكر البحر الهندي (سونت 75) بل بحر المهدية وهو يشبه أصول الإسفنج بليف أكر البحر (1: 45).(@)(@@) اكر القيروان: شبه بها الرمان في ألف ليلة وليلة (4: 249 برسل). ولا أدري ماذا 
ms53	 يراد بها.(@)(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO أكرار(@)(@)(@@) : رقيب الشمس، عباد الشمس (بوشر). والكلمة من لغة أهل نجد ففي ابن البيطار (1: 75): إكرار اسم عند عرب نجد PageV01P166 (@@) للنوع الكبير من الطرنشولي الذي لا يثمر الثمر اللازوردي اللون وهو عندهم الشوم (الثوم) وصوابه التنوم.(@)(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO أكربايا، أو أكرباي(@)(@)(@@) : تعبير يستعمله الفرس في قصة ألف ليلة وليلة ليأكدوا به ما يقولون. ويظهر أنها من الفارسية المحرفة، (انظر: فليشر معجم 69. وطبعته لألف ليلة رقم 12، المقدمة ص92).(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO اكريشت أرنب(@)(@)(@@) : Paronychia ( براكس مجلة ش، ج 4: 196).(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO اكرنب(@)(@)(@@) : انظر: كرنب.(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO إكريخ(@)(@)(@@) : جمعها أكاريخ: فتيلة، ذبالة (الجريدة الآسيوية، 1851، 1: 246، 247).(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO أكسيجين(@)(@)(@@) : (يونانية) أوكسجين (محيط المحيط).(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO إكسيس(@)(@)(@@) : انظر أعلاه في: أجاص شتوي.(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO أكل(@)(@)(@@) : يستعمل مجازا بمعنى حت الشيء وبراه شيئا فشيئا. يقال مثلا:(@)(@)(@@)(@@)(@@) || AUTO أكل(@)(@)(@@) الماء الصخرة (بوشر) - ويقال:(@)(@)(@@)(@@)(@@) || AUTO أكل(@)(@)(@@) تهم السنون: أفنتهم (بربر 1: 41). - وابتلع. وأكثر من القراءة (بوشر). - ولدغ ولسع ففي رياض النفوس (48ق): فإذا عنده من البراغيث أمر عظيم، قال فأقبلت أتحرك كلما(@)(@)(@@)(@@)(@@) || AUTO أكل(@)(@)(@@) وني. - وسلب واستباح، ففي الادريسي معجم 1، الفصل السابع: وربما ركبوا في مراكبهم وتعرضوا للسفن ف(@)(@)(@@)(@@)(@@) || AUTO أكل(@)(@)(@@) وا متاعها وقطعوا على أهلها، وفيه: لكن أهل الجزيرة(@)(@)(@@)(@@)(@@) || AUTO أكل(@)(@)(@@) وا متاع الغواصين والتجار القاصدين إليهم. وفي كرتاس 204 في كلامه عن أحد الملوك:(@)(@)(@@)(@@)(@@) || AUTO أكل(@)(@)(@@) هم وسبى حريمهم. وفي معجم PageV01P167 (@@) أبي الفداء: أكل القوي الضعيف. - يقال: لا يأكل برطيلا أي لا يستحله. وهو مجاز (بوشر). - وأكل العرض: انظره في عرض. - وأكل عصا: ضرب بالعصا (بوشر جاكسون تمب 325) ومثله: أكل ضربا، وأكل قتلة (بوشر) وكذلك أكل طريحة (دوماس 15، 480) - وأكل مائة عصا: ضرب مائة ضربة بالعصا (بوشر). - وأكل كفيه ندما: عض على أصابعه غيظا وندما (بوشر) - وأكل الميراث: ورث (بوشر) - وأكلناهم مشبعة كرامتكم: أتعبتمونا في العمل إكرلاما لكم (بوشر).(@)(@@) آكل: بمعنى أكل أي أطعم (فوك).(@)(@@) تأكل: أكل، أكل بعضه بعضا، تحات، ففي ابن البيطار (1: 13): إن وضع مع الثياب حفظها من التآكل. وتستعمل تأكل بمعنى أكل خطأ، ويليها في. ففي المستعيني نشارة الخشب هو الذي ينتشر 
ms54	 (ينتثر) من الخشب من قبل تأكل السوس فيها.(@)(@@) انتكل: أكل: أكل بعضه بعضا أو تناقص شيئا فشيئا. (ألف ليلة، برسل، 9: 296) اتكل واتاكل: (عامية): أكل، صالح للأكل (بوشر).(@)(@@) أكلة: وجبة (بوشر، همبرت 2).(@)(@@) ومرتع الحيونات وطعامها (بوشر) - والمكان الرقيق المتآكل من الثوب (بوشر). - والندم وتبكيت الضمير (بوشر)، - وسرطان، ورم خبيث (دومب 88، بوشر) وفي المعجم اللاتيني: أكلة بهذا المعنى (سرطان) - وغنغرينا (بوشر) - وقرحة (بوشر، هيلو).(@)(@@) أكلة: إقطاع من الأرض يقتطعها الأتراك طعمة للجند (دارست 87، انظر: لين) أكلة: انظر: أكلة.(@)(@@) أكال: مذيب، قارض، حات (بوشر) - وأكال اللحم: الذي يذيب اللحم ويتلفه.(@)(@@) ودواء أكال: مهزل متلف (يهزل الجسم وينهكه). (بوشر).(@)(@@) آكل: نبات يمزج بالتبغ حين يكون حادا (دوماس صحراء 192) - آكل بقيل: دودة صغيرة تتولد في أوراق الكرم وتلتف بها، وهي بالفرنسية Urèbe ( الكالا).(@)(@@) تأكولة: سرطان (بوشر).(@)(@@) تأكولي: سرطاني (بوشر).(@)(@)PageV01P168(@)(@)(@@) مأكل وجمعه مآكل: ما يؤكل من الطعام (فوك).(@)(@@) مأكلة: ما يؤكل، وليمة، وجبة (هيلو).(@)(@@) يأكل سكوت: نوع من البعوض ليس له طنين يلسع في صمت (فان كارنبك في مجلة de gids سنة 1868، 4: 141).(@)(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO أكلك(@)(@)(@@) : يجمع على أكالك: صدرية من التفتة يلبسها النساء (برجرن).(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO اكليرس أو اكليروس(@)(@)(@@) : (يونانية) رجال الدين المسيحي (بوشر).(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO اكليركي(@)(@)(@@) : (يونانية): شماس، شدياق (بوشر).(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO اكليم(@)(@)(@@) : يجمع على أكاليهم: بساط (بوشر)، وفي صفة مصر (18: 388) كلمات: ضرب من البسط.(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO أكم(@)(@)(@@) :(@)(@)(@@)(@@)(@@) || AUTO أكم(@)(@)(@@) ة: هضبة، تل. ففي ابن العوام (1: 249): ويصان من ذلك بال(@)(@)(@@)(@@)(@@) || AUTO أكم(@)(@)(@@) ة.(@)(@)(@@)(@@)(@@) || AUTO أكم(@)(@)(@@) ي، العمرة ال(@)(@)(@@)(@@)(@@) || AUTO أكم(@)(@)(@@) ية: عمرة يؤديها المعتمر في شهر رجب، وسميت بال(@)(@)(@@)(@@)(@@) || AUTO أكم(@)(@)(@@) ية لأن المعتمر يحرم لها من(@)(@)(@@)(@@)(@@) || AUTO أكم(@)(@)(@@) ة قبال مسجد عائشة، انظر ابن بطوطة 1: 383.(@)(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO أكيون(@)(@)(@@) : اخيون، رأس الأفعى (بوشر).(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO ألا(@)(@)(@@) : هلا! هيا! (بوشر).(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO إلا(@)(@)(@@) : بمعنى إن للتأكيد، ففي زيشر (11: 676): حوشوا الهوى عني(@)(@)(@@)(@@)(@@) || AUTO إلا(@)(@)(@@) الهوى يجرح. وقد تفسر بتقدير محذوف: ما هو(@)(@)(@@)(@@)(@@) || AUTO إلا(@)(@)(@@) ، وما يكون(@)(@)(@@)(@@)(@@) || AUTO إلا(@)(@)(@@) . وتستعمل مفردة للتأكيد يقال: تعرفني! والجواب:(@)(@)(@@)(@@)(@@) || AUTO إلا(@)(@)(@@) أي أكيدا، يقينا. وكذلك معنى و(@)(@)(@@)(@@)(@@) || AUTO إلا(@)(@)(@@) أو 
ms55	 ف(@)(@)(@@)(@@)(@@) || AUTO إلا(@)(@)(@@) في مثل قولهم: فإن لم يفعل ف(@)(@)(@@)(@@)(@@) || AUTO إلا(@)(@)(@@) سرت إليه، أي إن لم يفعل وفاني أسير إليه (فالتون 69 وانظر 31، الفخري 372). وفي رياض النفوس (98و): إن لم تنصرف و(@)(@)(@@)(@@)(@@) || AUTO إلا(@)(@)(@@) فقأت عينك PageV01P169 (@@) الأخرى، أي فقأت غينك الأخرى بكل تأكيد.(@)(@@) وفي ألف ليلة (برسل، 9: 340): إذا لم تقلعي وإلا قتلتك، أي قتلتك بكل تأكيد. انظر أيضا في مادة درك.(@)(@@) وفي زيشر (20: 487): ولولا خوف الإطالة وإلا ذكرت جميع أسماء الكتب. أي لذكرت بكل تأكيد، وتعني إلا وأيضا، بكل تأكيد، ففي النص الذي ذكره كرتاس كما جاء في مخطوطة ليدن: وكل ما وصف به رسول الله - صلى الله عليه وسلم - أمراء الزمان إلا وقد نسب إليهم.(@)(@@) إلا أن: غير أن، لكن. (معجم الادريسي، معجم البلاذري، بوشر) وكذلك معنى إلا وحدها (المقري 1: 154، بوشر). وكذلك معنى إلا و (كوزج مختار 89)، وفي ابن البيطار (1: 48): وإذا بخر بجلده مكان لم يبق فيه شيء من السباع إلا ويهرب منه (المقري 1: 829) راجع عن إلا بمعنى لكن تعليقاتي في الجريدة الآسيوية 1826، 2: 210.(@)(@@) إلا أن: لكن، يقال: إن كذبوا إلا أنهم يخافوا من اليمين، أي لكنهم، غير أنهم (بوشر).(@)(@@) وإلا: بمعنى أو (انظر تعليقاتي في الجريدة الآسيوية 1869، 2: 185).(@)(@@) وإلاف: بمعنى إذ ذاك، عند ذلك، حينئذ (فليشر في المقري 2: 824، بريست 206).(@)(@@) إلا تستعمل في جملة منفية بمعنى حتى، ففي ابن عبد الملك (162و): فلم يكن إلا عن قريب ووصل كتاب لابن حسون بأن يفعل الخ.(@)(@@) ماذا وإلا: وإلا (بوشر).(@)(@@) إلا وي: من يعتقد بوجود الله وينكر الوحي (بوشر).(@)(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO ألا بالغي(@)(@)(@@) : (تركية) سمك منقوش، تروته (بوشر).(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO ألاجة(@)(@)(@@) : (تركية) مبرقش، منقش (بوشر) - ونسيج من الحرير مخطط (مقلم) (بوشر) وفي صفة مصر (18: 308): أقمشة من الحرير والقطن، وهما صنفان يسمى الأول:(@)(@)(@@)(@@)(@@) || AUTO ألاجة(@)(@)(@@) شامي، والآخر:(@)(@)(@@)(@@)(@@) || AUTO ألاجة(@)(@)(@@) هندي. وانظر براون 2: 264، ونسيج من القطن (غدامس 40) - و(@)(@)(@@)(@@)(@@) || AUTO ألاجة(@)(@)(@@) كساوي: نسيج غليظ من الحرير والقطن (عوادي 337 وانظر: 341).(@)(@)PageV01P170(@)(@)(@@)(@@)(@@) || CHECK ألاطيني(@)(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO الاسفاقس(@)(@)(@@) : (يونانية Eleciophakosn) ، ناعمة، سالمة، قوية (نبات). ابن البيطار (1: 77) وهو يقول: إن الألف واللام 
ms56	 فيه أصلية تعد من نفس الكلمة، وهو مصيب في قوله. المستعيني، ولم ترد الكلمة في موضعها عند فريتاج.(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO ألاطي(@)(@)(@@) : تنوب، (ابن البيطار 1: 78).(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO ألاطي(@)(@)(@@) ني: (يونانية): لبلاب، لبلاب الأحراش (ابن البيطار 1: 76)، حباحب أحرش، أو لبلاب الاحراج (بوشر). -(@)(@)(@@)(@@)(@@) || AUTO ألاطي(@)(@)(@@) ني ذكر: زهرة الحواشي، فيرونيكة (بوشر).(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO ألاي(@)(@)(@@) : (تركية): ابهة، احتفال، فخفخة، موكب (بوشر).(@)(@@) ب(@)(@)(@@)(@@)(@@) || AUTO ألاي(@)(@)(@@) : بموكب واحتفال (بوشر).(@)(@)(@@)(@@)(@@) || AUTO ألاي(@)(@)(@@) جاوش: نذير الحرب (بوشر).(@)(@)(@@)(@@)(@@) || AUTO ألاي(@)(@)(@@) مدافع: سرية مدفعية (بوشر).(@)(@)(@@)(@@)(@@) || AUTO ألاي(@)(@)(@@) : كتيبة. - وأميرالاي: عميد كولونيل.(@)(@)PageV01P171(@)(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO ألب(@)(@)(@@) :(@)(@)(@@)(@@)(@@) || AUTO ألب(@)(@)(@@) بالتضعيف: جمع الجند ضد فلان ويقال:(@)(@)(@@)(@@)(@@) || AUTO ألب(@)(@)(@@) عليه (النويري أسبانيا 466، وابن خلدون مخطوطة 1350، 4: 3ق).(@)(@@) و(@)(@)(@@)(@@)(@@) || AUTO ألب(@)(@)(@@) على فلان: حرض الناس عليه، ففي ترجمة ابن خلدون (231ق): فاتفقوا على شأنهم في التأليب علي والسعاية بي (أماري 435، انظر: تعليقات ونقد، 436 واقرأها: ف(@)(@)(@@)(@@)(@@) || AUTO ألب)(@)(@)(@@) .(@)(@@) ت(@)(@)(@@)(@@)(@@) || AUTO ألب(@)(@)(@@) : تظافر (لين نقلا عن التاج، المقري 2: 266، أمارى 435، انظر: تعليقات ونقد).(@)(@@) وت(@)(@)(@@)(@@)(@@) || AUTO ألب(@)(@)(@@) عليه: جمع7 جندا وحرضهم عليه (بيديا 4).(@)(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO إلتماق(@)(@)(@@) : (محرفة من الكلمة التركية طوماق): وتجمع بال(@)(@)(@@)(@@)(@@) || AUTO ألف(@)(@)(@@) والتاء، وهي عند أهل الأندلس: جزمة، سوقاء (الملابس 49) وانظر: تماق أدناه.(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO ألتون(@)(@)(@@) : (تركية) خيط من ذهب (بوشر).(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO الجي(@)(@)(@@) : أو الشي، إيلجي (تركية)، جمعها(@)(@)(@@)(@@)(@@) || AUTO الجي(@)(@)(@@) ة وألاجي: سفير (بوشر، محيط المحيط).(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO الخ(@)(@)(@@) : تقرأ: إلى آخره، والعامة تقول: ألخ (محيط المحيط).(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO ألف(@)(@)(@@) :(@)(@)(@@)(@@)(@@) || AUTO ألف(@)(@)(@@) : أنس واعتاد (بوشر).(@)(@)(@@)(@@)(@@) || AUTO ألف(@)(@)(@@) بالتضعيف (في معجم الكالا ومعجم بوشر: ولف في كل المعاني التي انقلها عنهما): آلف وأنس (بوشر، هيلو، همبرت 66) وعود (هيلو، همبرت 66) - ومعناها العام: هيأ وجهز وأعد الشيء في حالة يتطلبها ما أعد له من استعمال.(@)(@@) أما المعنى(@)(@)(@@)(@@)(@@) || AUTO الخ(@)(@)(@@) اص فيحدده المفعول الذي يذكر مع هذا الفعل، فيقال مثلا:(@)(@)(@@)(@@)(@@) || AUTO ألف(@)(@)(@@) اللحم: أعده وتبله وطهاه.(@)(@@) و(@)(@)(@@)(@@)(@@) || AUTO ألف(@)(@)(@@)(@)(@)(@@)(@@)(@@) || AUTO الخ(@)(@)(@@) شب: سحجه وصقله بالمنجر، أو صنعه صنعة فنية يقال خشب مؤلف الصنعة (تاريخ البربر 1: 412).(@)(@@) و(@)(@)(@@)(@@)(@@) || AUTO ألف(@)(@)(@@) النحاس: طرقه، و(@)(@)(@@)(@@)(@@) || AUTO ألف(@)(@)(@@) الزجاج: قطعه صفائح وربطها (معجم الادريسي). 
ms57	(@)(@@) و(@)(@)(@@)(@@)(@@) || AUTO ألف(@)(@)(@@) عند أهل الكيمياء: خلط ومزج (معجم الادريسي).(@)(@@) و(@)(@)(@@)(@@)(@@) || AUTO ألف(@)(@)(@@) : زين وزخرف (الكالا).(@)(@@) و(@)(@)(@@)(@@)(@@) || AUTO ألف(@)(@)(@@) : اخترع ولفق (بوشر).(@)(@@) و(@)(@)(@@)(@@)(@@) || AUTO ألف(@)(@)(@@) : أدخل الماشية في الحظيرة (الكالا).(@)(@@) والف، جمع الجند وقادهم (الكالا).(@)(@)PageV01P172(@)(@)(@@) والف: أغرى بالفجور، وأغرى الجند بالفرار (بوشر).(@)(@@) وألفه على الشيء: عوده (بوشر).(@)(@@) وولف حاله: تهيأ واستعد، وتأهب (يقولها أهل كسروان) (بوشر).(@)(@@) تألف: تعود، وتأنس (بوشر، همبرت 66).(@)(@@) وتألف الفرسان: انتظموا في صف (ملر، نصر 4).(@)(@@) مطاوع ألف (فوك).(@)(@@) ائتلف: التأم، ضد اختلف، فعند عبد الواحد في كلامه عن الربيع ص121: ائتلاف أوانه والأوان هنا الزمان والوقت، والمؤلف يتكلم عن تساوى حالة الجو في الربيع، وائتلاف ضد اختلاف في الفقرة التي تليها. ويبدو لي أن هوجفلايت (ص150 رقم 3، ورقم 185) لم يفهم المعنى المراد في هذه الفقرة.(@)(@@) استألف، استألفه: استماله، وحاول كسب صداقته، ففي حيان (40و): فاستألف عوسجة من أهل الخليج التاكرني وعاقده (أخبار 68 = بيان 2: 44) وكرتاس 54. وفي ابن القوطية (41ق): إن أمكنني أن استألفه بهذه المصاهرة إلى الطاعة فعلت. وتجد في فقرة من تاريخ البربر (1: 295): استئلافا بهم، وصوابه استئلافا لهم.(@)(@@) ألف: وصيغة منتهي الجموع منه ألافات - وصاحب ألافات - من يملك ألف ألف (مليونير) - بالألافات: بالألوف.(@)(@@) خير من ألف دينار، أو خير من ألف، أو ألف دينار: اسم يطلقه أهل الأندلس على نبات كزبرة الثعلب.(@)(@@) وفي الكالا: ( Pinpinella ألف دينار) وفي ابن البيطار (1: 95): وهو PageV01P173 (@@) نبات له ورق شبيه بورق النبات الذي يعرفه عامة الغرب خير من ألف وهو كزبرة الثعلب. هذا ما جاء في مخطوطة أمنه وفي مخطوطة ب: خير من ألف دينار. وليس من الضروري إضافة كلمة دينار ويؤيد هذا ما جاء في المخطوطتين أوب (2: 62): هذا النبات تسميه عامتنا بالأندلس خير من ألف.(@)(@@) ذو ألف ورقة (ابن البيطار 1: 474) أو ألف ورق (الكالا) نبات يسمى أيضا اسطراطيوطس البري، ففي ابن البيطار (1: 1) بعد قوله إنه ذو ألف ورقة قال: ((وقد يسمى أيضا اسطراطيوطس البري بهذا الاسم)).(@)(@@) إلف: في كلام بمأمون: ذاك غرس يدي وإلف أدبي. وقد ترجمت ألف بمعنى: مريد 
ms58	 وتلميذ (معجم المختار) وأرى أن إلف هنا لها معناها اللغوي المعتاد وهو الرفيق الذي يؤلف. ويجب ترجمتها بما معناه رفيقي الذي يجاريني في آداب السلوك. - والإلف: الصديق (معجم مسلم).(@)(@@) ألف. ألف باء: جزء تعليم حروف الهجاء (بوشر).(@)(@@) الألف واللام: أل أداة التعريف (بوشر).(@)(@@) إلفة: رفيقة: أنثى الطائر (بوشر).(@)(@@) ألفة: معاشرة، علاقة غرام (بوشر).(@)(@@) ألفى: ما قيمته ألف قرش، وقد وردت الكلمة في شعر جاء في كتاب صفة مصر (16: 138) حيث الكلام عن دكة (تكة) فتاة. - وتاجر ألفى: تاجر يملك ألف بدرة (ترجمة لين لألف ليلة 4: 640).(@)(@@) تأليف: جمع وتنسيق (بوشر).(@)(@@) تأليفة: مؤلف في الشعر أو النثر (بوشر).(@)(@@) تأليفي: تركيبي، وتأليفيا: تركيبيا.(@)(@@) توليف (بمعنى تأليف): جمع العمال لتشغيلهم (بوشر).(@)(@@) مؤلف: فصيح، بليغ (الكالا) - ومبرش، مسحل، ضرب من المبارد (الكالا) - وجامع العمال ومستخدمهم (بوشر) - مؤلف الكذب: ملفقه ومختلفه.(@)(@@) مألوف: معتاد، والمعتاد أكله من الطعام، ويذكر ابن العوام (1: 67) الأرز مع ((الحبوب المألوفة)).(@)(@@) مواليف: يجب أن يكون له معنى ولكنه لم يتبين لي (ألف ليلة: 1: 365).(@)(@@) مؤتلف: المجانس لفظا، ويطلق على الإسناد PageV01P174 (@@) الذي يرد فيه اسم راو من الرواة يجانس في الكتابة اسم راو آخر ولكنه يلفظ بصورة تختلف عن الأول (دى سلان، المقدمة 2: 483).(@)(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO ألفنسية(@)(@)(@@) : جذام، داء الفيل (الكالا).(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO ألق(@)(@)(@@) : ت(@)(@)(@@)(@@)(@@) || AUTO ألق(@)(@)(@@) وائتلق: يستعمله الشعراء في وصفهم للأزهار بمعنى: لمع وأضاء (ورد ت(@)(@)(@@)(@@)(@@) || AUTO ألق(@)(@)(@@) في عباد 1: 24، 32، والمقري 2: 409، وورد ائتلق في (المقري 2: 371).(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO الكسينى(@)(@)(@@) : (يونانية Helxion) : حشيشة الزجاج (باين سميث 1016).(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO ألكى(@)(@)(@@) : ضرب من التدريب العسكري (انظر الجريدة الآسيوية 1848، 2: 221).(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO ألم(@)(@)(@@) :(@)(@)(@@)(@@)(@@) || AUTO ألم(@)(@)(@@) بالتضعيف: آلم، أوجع، أذل، أخزى (فوك، بوشر) وعذب ونكل (همبرت 214) ت(@)(@)(@@)(@@)(@@) || AUTO ألم(@)(@)(@@) : توجع، تعذب (همبرت 214)(@)(@)(@@)(@@)(@@) || AUTO ألم(@)(@)(@@) .(@)(@@) (اولمس): دردار، شجر البق (شيرب ج).(@)(@)PageV01P175(@)(@)(@@)(@@)(@@) || CHECK ألميم(@)(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO ألم(@)(@)(@@) : وجع، حزن، اسى، شجن، عذاب، نكال (بوشر، همبرت 214).(@)(@)(@@)(@@)(@@) || AUTO ألم(@)(@)(@@) يسوع المسيح: آلام يسوع المسيح (بوشر)، وفي همبرت 153: ال(@)(@)(@@)(@@)(@@) || AUTO ألم(@)(@)(@@) فقط، وجمعة الآلام: الجمعة المقدسة.(@)(@@) وزهرة ال(@)(@)(@@)(@@)(@@) || AUTO ألم(@)(@)(@@) : زهرة الآلام، زهرة الأشجان (بوشر).(@)(@@) وأظهر(@)(@)(@@)(@@)(@@) || AUTO ألم(@)(@)(@@) ه: أظهر غيضه وحقده وضغينته 
ms59	 وغله (بوشر).(@)(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO ألم(@)(@)(@@) يم: من مصطلح الملاحة، وهو فراغ في مقدمة مؤخرة السفينة (الجريدة الآسيوية 1841، 1: 589).(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO ألنجة(@)(@)(@@) : (أسبانية مع أداة التعرف أر): سعد (نبات). وأبو ملعقة وهو نوع من PageV01P176 (@@) البط العريض المنقار (الكالا).(@)(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO ألنجوج(@)(@)(@@) : انظر فريتاج مادة: لج، والمقري 1: 90، 364.(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO أله(@)(@)(@@) :(@)(@)(@@)(@@)(@@) || AUTO أله(@)(@)(@@) بالتضعيف،(@)(@)(@@)(@@)(@@) || AUTO أله(@)(@)(@@) ه: اتخذه إلها، ونزله منزلة إله، قدس، مجد، عظم (بوشر، وكذلك عند فريتاج، وانظر: لين).(@)(@@) ت(@)(@)(@@)(@@)(@@) || AUTO أله(@)(@)(@@) : ادعى الألوهية (المقري 2: 136).(@)(@@) -: تعبد وتنسك (فوك).(@)(@@) -: انظر ت(@)(@)(@@)(@@)(@@) || AUTO أله(@)(@)(@@) فيما يلي: إلاهة: مؤنث إله، ربة (بوشر).(@)(@@) اللهم: إن ابن خلدون وغيره من الكتاب المغاربة يهملون أحيانا القاعدة التي توجب اتباع كلمة اللهم بأداة الاستثناء إلا، مثل ما جاء في المقدمة 1: 2، 13، 402، 304.(@)(@@) الت(@)(@)(@@)(@@)(@@) || AUTO أله(@)(@)(@@) : حب الذات ونظرة المرء لنفسه كأنه إله (المقدمة 1: 360، 2: 393). غير أن ما جاء في تاريخ البربر (1: 641): والتاله على الندمان (وفي مخطوطتنا رقم 1351:(@)(@)PageV01P177(@)(@)(@@) والتاته) والصواب: والتأبه (انظر لين تأبه في مادة أبه).(@)(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO إلهناك(@)(@)(@@) : عامية(@)(@)(@@)(@@)(@@) || AUTO إلى(@)(@)(@@) هناك (فوك).(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO إلى(@)(@)(@@) : إذا استعمل هذا الحرف بمعنى حتى لانتهاء الغاية فقد تسبق أحيانا بالواو الرابطة ففي كليلة ودمنة ((243)) مثلا: ومنذ مجيئه والى الآن لم يطلع له على خيانة. (كما في العبرية إلا و(@)(@)(@@)(@@)(@@) || AUTO إلى)(@)(@)(@@) .(@)(@@) وحين تكرر(@)(@)(@@)(@@)(@@) || AUTO إلى(@)(@)(@@) فمعناها حتى، ففي مملوك (1: 34) مثلا: عدة من مائتي فارس(@)(@)(@@)(@@)(@@) || AUTO إلى(@)(@)(@@) مائة فارس(@)(@)(@@)(@@)(@@) || AUTO إلى(@)(@)(@@) سبعين فارس.(@)(@@) ومرادف عند إذا أرادوا استعمالها بهذا المعنى (انظر لين) ففي المقري (1: 578) مثلا: رجل(@)(@)(@@)(@@)(@@) || AUTO إلى(@)(@)(@@) جانبه أي عند جانبه.(@)(@@) ومرادف بعد، ففي أخبار ((44)) مثلا: مات(@)(@)(@@)(@@)(@@) || AUTO إلى(@)(@)(@@) أيام يسيرة، أي بعد أيام يسيرة. وفي المقرى (1: 465): فلم ينتبهوا إليه إلا(@)(@)(@@)(@@)(@@) || AUTO إلى(@)(@)(@@) زمن، أي بعد زمن.(@)(@@) بمعنى حسب، بمقدار، باعتبار، ففي المقدمة (2: 48) مثلا: وكانت دنانير الفرس ودراهمهم بين أيديهم يردونها في معاملتهم(@)(@)(@@)(@@)(@@) || AUTO إلى(@)(@)(@@) الوزن.(@)(@@) ومعناها في الرهان: مقابل، بدل، ضد، ففي ألف ليلة (برسل 4: 177) مثلا: والرهان بيني وبينك بستان النزه(@)(@)(@@)(@@)(@@) || AUTO إلى(@)(@)(@@) قصرك قصر التماثيل، (لأن هذا هو الصواب في قراءتها كما قال لين وهو مصيب، وليس: 
ms60	 وقصر، وقد ترجمها لين بما معناه: ((يكون رهاننا أنى أراهن ببستان النزه مقابل قصرك قصر التماثيل)).(@)(@@) وتستعمل(@)(@)(@@)(@@)(@@) || AUTO إلى(@)(@)(@@) بدل ((ل)) فيقال مثلا:(@)(@)PageV01P178(@)(@)(@@) ردي إلى الجواب = ردي للجواب. وانقاد إليه = انقاد له. (انظر فليشر في تعليقه على المقري 1: 310، بريشت 181، 182).(@)(@@) كان إلى: بلغ، وصل، ففي لطائف الثعالبي ((68)) مثلا حيث يقول علي ليؤكد أن الرجال قد أصبحوا في كل جيل منهم أقصر من الذين قبلهم: ((كنت إلى منكب أبي، وكان أبي إلى منكب جدي)).(@)(@@) كان إلى: أي تابع، بمعنى كان مضموما إلى، ويؤيد هذا المعنى ما جاء في البلاذري ((132)): وذكروا أن الجزيرة كانت إلى قنسرين، أي تابعة لها. قارن هذا بقوله (ص1): ولم تزل قنسرين وكورها مضمومة إلى حمص حتى الخ. غير إنه كثيرا ما يحذف الفعل كأن يقال: الزراعة وما إليها، أي وما يتبعها ويختص بها. (ابن العوام 1: 10) ومثله: ومن إليهم (بربر 1: 2) وقد تكررت مرتين، 3: 28، 139، وفي الحلل المراكشية (31ق) يقول بعد أن ذكر أسماء عدة مدن في الثغر الأعلى: وما إلى ذلك كله. وفي كتاب ابن صاحب الصلاة (57ق): فاحتشد جميع أهل شرق الأندلس ومن إليه. (بتجرس 130، 131، بربر 1: 32، 41، 45 الخ، ابن بطوطة 4: 273، أماري ديب 87، 88، 89، 131، وأمثلة أخرى في بحوثي 1: 75، رقم 1 الطبعة الأولى). وهذا التعبير بإيجاز الحذف يكثر استعماله كثرة لم يتصورها ويجرز، وقد خلط يونج بينه وبين ما سبقه. وقد حرفه وغيره بعض المحققين الناشرين، من غير ما سبب، مثل دي ساسي، ديب 9: 470، وناشري رحلة ابن بطوطة 2: 138، (انظر التعليقات)، وفليشر في تعليقاته على أماري 497، (غير أن فليشر قد اعترف بخطئه في الملحق).(@)(@@) وإيجاز حذف آخر نجده في رياض النفوس (99ق): فقالوا: الشيخ يدعوك، فقال: إليه، فقد حذف هنا الفعل لنذهب.(@)(@@) وفي جمل مثل: كان إلى الطول ما هو، انظرها في: ما.(@)(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO ألي(@)(@)(@@) : عامية بدل: الذي (بوشر).(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO ألوي(@)(@)(@@) : = ألوة عود البخور (المقري 2: 776، مع PageV01P179 (@@) تعليق فليشر بريشت 195).(@)(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO ألية(@)(@)(@@) :(@)(@)(@@)(@@)(@@) || AUTO ألية(@)(@)(@@) الحمل: الثريا (نجم) (دورن 47).(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO أليبسي(@)(@)(@@) : قطع ناقص، قطع اهليلجي (من مصطلح الهندسة). (بوشر).(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO إم(@)(@)(@@) : عامية(@)(@)(@@)(@@)(@@) || AUTO (@)(@)(@@)(@@)(@@) || AUTO أم 