ms134	 يموت مقدم بن الحسن السائح روى عن عطاء السليمي ذكره ابن منده وقال كنيته وبيض لها(@)(@@)(@@)(@@) $ 3099 - (@)(@@) أبو الينبغي من الشعراء المجان يكنى أبا علي قال أبو هفان(@)(@@) قلت لأبي الينبغي لم كنيت أبا الينبغي قال لأني أقول مالا ينبغي(@)PageV00P000(@)(@@)(@@)(@@) | - الباب الثالث - في الألقاب بألفاظ الأنساب يبدأ برقم 3100 وينتهي برقم 3279(@)PageV02P277(@)(@@) - باب الأنساب(@)(@@)(@@)(@@) || - الألف(@)(@@)(@@)(@@) $ 3100 - (@)(@@) الآدمي(@)(@@) أبو القاسم علي بن عمر الأسد اباذي المعروف بالهمداني نزيل أصبهان عن ابن السني وغيره(@)(@@)(@@)(@@) $ 3101 - (@)(@@) الأحمري اثنان(@)(@@) عبد الرحمن بن الجارود الرقي(@)(@@)(@@)(@@) $ 3102 - (@)(@@) وأحمد بن محمد بن الحسين(@)(@@)(@@)(@@) $ 3103 - (@)(@@) الأركسي(@)(@@) يحيى بن محمد بن أحمد الأنصاري القرطبي أخد عن أبي بكر ابن العربي(@)PageV00P000(@)(@@)(@@)(@@) $ 3104 - (@)(@@) الأسباطي(@)(@@) محمد بن إبراهيم الكوفي نزيل مصر ذكره أبو القاسم بن منده(@)(@@)(@@)(@@) $ 3105 - (@)(@@) الإسماعيلي(@)(@@) أحمد بن المبارك الرقي جمع حديث إسماعيل بن أبي خالد فنسب إليه(@)(@@)(@@)(@@) $ 3106 - (@)(@@) الأعمشي(@)(@@) أبو حامد أحمد بن حمدون النيسابوري جمع حديث الأعمش(@)(@@)(@@)(@@) $ 3107 - (@)(@@) الإقليدسي(@)(@@) يعقوب بن محمد بن يعقوب الرازي(@)(@@)(@@)(@@) $ 3108 - (@)(@@) الأمي(@)(@@) أحمد بن الوليد الرملي روى عن عفان(@)(@@)(@@)(@@) $ 3109 - (@)(@@) الأوزاعي الفقيه المشهور(@)(@@) أبو عمرو عبد الرحمن نزل الأوزاع فنسب إليهم(@)PageV00P000(@)(@@)(@@)(@@) || - الباء(@)(@@)(@@)(@@) $ 3110 - (@)(@@) البافي بالفاء عبد الله بن محمد البخاري الفقيه الشافعي(@)(@@)(@@)(@@) $ 3111 - (@)(@@) الباهلي(@)(@@) أبو محمد المقرىء الخطيب مصنف عمدة التحرير في الإدغام الكبير كان صحيح النسب في بني أمية وربما قيل له الباهلي للزومه شيخه الباهلي فهو كاليزيدي عدوي النسب قيل له اليزيدي لصحبته يزيد بن أبي منصور خال المهدي مات الباهلي سنة خمس وسبعمائة(@)(@@)(@@)(@@) $ 3112 - (@)(@@) البخاري(@)(@@) أحمد بن عبد الواحد والد الفخر بن البخاري قيل له البخاري لأنه تفقه بها وهو مقدسي(@)(@@)(@@)(@@) $ 3113 - (@)(@@) البختي(@)(@@) أحمد بن إبراهيم المروزي يروي عن سعيد بن هبير