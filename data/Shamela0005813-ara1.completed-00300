ms281	 يحيى بن يحيى،(@)(@@) قاله أبو سعيد بن يونس.(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 3099 - (@)(@@) أبو زكريا: يحيى بن عياش(@)(@@) الهروي.(@)(@@) حدث عن: أبي عاصم، وعبد الله بن نافع.(@)(@@)(@@)(@@) || ( [الأفراد من الكنى] )(@)(@@)(@@)(@@) $ 3100 - (@)(@@) أبو الزنباع: صدقة بن صالح.(@)(@@) حدث عن: أبي دهقان.(@)(@@) عداده في أهل الكوفة.(@)(@@)(@@)(@@) $ 3101 - (@)(@@) أبو الزنباع: روح بن الفرج(@)(@@) المصري.(@)(@@) حدث عن: سعيد بن عفير، ويحيى بن بكير.(@)(@@)(@@)(@@) $ 3102 - (@)(@@) أبو زائدة: ميمون بن فيروز، مولى(@)(@@) عمرو بن عبد الرحمن الوادعي.(@)(@@)(@@)(@@) $ 3103 - (@)(@@) أبو زائدة: واسمه قدامة.(@)(@@) والد زائدة بن قدامة.(@)(@@) روى عنه: أبي بكر بن أبي مليكة.(@)(@@) روى عنه: شريك.(@)(@@)(@@)(@@) $ 3104 - (@)(@@) أبو زائدة: زكريا بن يحيى بن(@)(@@) زكريا بن أبي زائدة الكوفي.(@)(@@) حدث عن: أبيه.(@)(@@) روى عنه: محمد بن جرير.(@)(@@)(@@)(@@) $ 3105 - (@)(@@) أبو زائدة: عبيد الله بن زائدة،(@)(@@) عداده في أهل مصر.(@)(@@)(@@)(@@) $ 3106 - (@)(@@) أبو زميل: سماك الحنفي.(@)(@@) حدث عن: عبد الله بن عباس.(@)(@@) روى عنه: مسعر بن كدام، وعكرمة.(@)(@@)(@@)(@@) $ 3107 - (@)(@@) أبو الزاهرية: حدير بن كريب(@)(@@) الحمصي.(@)(@@) حدث عن: ابن عمر.(@)(@@) روى عنه: معاوية بن صالح، وسعيد بن(@)(@@) سنان.(@)(@@)(@@)(@@) $ 3108 - (@)(@@) أبو زحارة: عتبة بن يقظان.(@)(@@) حدث عن: الحسن بن أبي الحسن.(@)(@@)(@@)(@@) $ 3109 - (@)(@@) أبو الزبرقان: الهلالي.(@)(@@) حدث عن: يزيد بن أبي مريم.(@)(@@) روى عنه: حميد بن مهران.(@)(@@)(@@)(@@) $ 3110 - (@)(@@) أبو زينب.(@)(@@) حدث عن: سلمان الفارسي، وعبد الرحمن(@)(@@) ابن سمرة، وأنس بن مالك.(@)(@@) روى عنه: علي بن ربيعة، وعاصم الأحول.(@)(@@) PageV00P000(@)(@@)(@@)(@@) ||| (الأفراد من الصحابة)(@)(@@)(@@)(@@) $ 3111 - (@)(@@) أبو زمعة البلوي.(@)(@@) له صحبة.(@)(@@) شهد فتح مصر.(@)(@@) روى عنه: أبو سالم، وأبو فراس، قاله أبو سعيد(@)(@@) ابن يونس.(@)(@@) أخبرنا أحمد بن الحسن، ثنا يحيى بن عثمان،(@)(@@) ثنا أبي، ثنا ابن لهيعة، حدثني عبيد الله بن(@)(@@) المغيرة، عن أبي قيس مولى بني جمح، قال:(@)(@@) سمعت أبا زمعة (ق 131 / ب) البلوي،(@)(@@) صاحب النبي صلى الله عليه وسلم، وكان من(@)(@@) أصحاب الشجرة ممن بايع.(@)(@@)(@@)(@@) $ 3112 - (@)(@@) أبو زيادة الأنصاري.(@)(@@) له صحبة.(@)(@@) روى حديثه: حفص بن سليمان، عن سعد(@)(@@) بن عمرو بن جعدة، عن زيادة بن أبي زيادة،(@)(@@) عن أبيه.(@)(@@)(@@)(@@) $ 3113 - (@)(@@) أبو زبيد: المزني.(@)(@@) له صحبة.(@)(@@) روى حديثه: 
ms282	 محمد بن مغيث الجرشي، عن(@)(@@) الصلت بن الزبيد، عن أبيه، عن جده.(@)(@@)(@@)(@@) $ 3114 - (@)(@@) أبو الزهراء: البلوي.(@)(@@) صحابي عداده في أهل مصر، لا يعرف له(@)(@@) رواية.(@)(@@) قاله أبو سعيد بن يونس.(@)(@@)(@@)(@@) $ 3115 - (@)(@@) أبو الزعراء: له صحبة.(@)(@@) عداده في المصريين.(@)(@@) قاله أبو سعيد بن يونس.(@)(@@) تقدم ذكره.(@)(@@)(@@)(@@) ||| (ومن التابعين)(@)(@@)(@@)(@@) $ 3116 - (@)(@@) أبو زبيد: الهمداني.(@)(@@) سمع: أبا أيوب الأنصاري.(@)(@@) روى عنه: يزيد بن خمير.(@)(@@) قاله البخاري.(@)(@@)(@@)(@@) $ 3117 - (@)(@@) أبو زبيد.(@)(@@) حدث عن: أبي سعيد الخدري في المناسك، رواه الحجاج بن أرطأة، عن عبادة بن نسي عنه.(@)(@@)(@@)(@@) $ 3118 - (@)(@@) أبو زبيد الأسدي.(@)(@@) حدث عن: القاسم بن محمد، وطاووس.(@)(@@) روى عنه: سفيان الثوري.(@)(@@)(@@)(@@) $ 3119 - (@)(@@) أبو زبيد: عبثر بن القاسم، واسمه:(@)(@@) محمد، كوفي.(@)(@@) حدث عن: الأعمش، ومطرف بن طريف،(@)(@@) والعلاء بن المسيب.(@)(@@)(@@)(@@) $ 3120 - (@)(@@) أبو زينب: مولى حازم بن حرملة.(@)(@@) حدث عن: حازم بن حرملة.(@)(@@) روى عنه: خالد بن سعيد.(@)(@@)(@@)(@@) $ 3121 - (@)(@@) أبو الزعوف: رأى أبا هريرة.(@)(@@) PageV00P000(@)(@@) روى عنه: خداش بن حميد.(@)(@@)(@@)(@@) $ 3122 - (@)(@@) أبو زينبة: سأل ابن عمر، روى(@)(@@) عبد العزيز الدراوردي.(@)(@@)(@@)(@@) $ 3123 - (@)(@@) أبو زعيزعة: كاتب مروان.(@)(@@) روى عنه: عمرو بن عبيد الأنصاري.(@)(@@)(@@)(@@) $ 3124 - (@)(@@) أبو زبان: الطيب بن زبان.(@)(@@) عداده في أهل فلسطين.(@)(@@) حدث عن: أبي قرصافة.(@)(@@)(@@)(@@) $ 3125 - (@)(@@) أبو زبر: عبد الله بن العلاء بن زبر،(@)(@@) دمشقي.(@)(@@) حدثنا عمر بن محمد، ثنا عبد الله بن روح،(@)(@@) ثنا شبانة، ثنا أبو زبر عبد الله بن العلاء.(@)(@@)(@@)(@@) | (باب السين)(@)(@@)(@@)(@@) || (@)(@@)(@@)(@@) $ 3126 - (@)(@@) أبو سلمة: عبد الله بن عبد الأسد(@)(@@) القرشي المخزومي، وهو: ابن هلال بن(@)(@@) عبد الله بن عمرو بن مخزوم، رضيع النبي(@)(@@) صلى الله عليه وسلم.(@)(@@) شهد بدرا وتوفي (ق 132 / أ) في عهد(@)(@@) رسول الله صلى الله عليه وسلم.(@)(@@) أخبرنا أحمد بن سليمان بن حذلم، ثنا عبد الله(@)(@@) ابن أبي أسامة الحلبي، ثنا حجاج بن أبي منيع(@)(@@) عن جده عبيد الله بن أبي زياد، عن الزهري،(@)(@@) قال: وعبد الله بن عبد الأعلى بن هلال بن(@)(@@) عبد الله بن عمرو بن مخزوم يكنى أبا سلمة.(@)(@@)(@@)(@@) $ 3127 - (@)(@@) أبو سلمة: له صحبة.(@)(@@) له ذكر في حديث 
ms283	 كهمس الهلالي، ولا(@)(@@) يعرف له رواية.(@)(@@)(@@)(@@) $ 3128 - (@)(@@) أبو سلمة: عبد الله بن عبد الرحمن(@)(@@) ابن عوف الزهري القرشي.(@)(@@) سمع: عبد الله بن عباس، وأبا هريرة،(@)(@@) وعائشة.(@)(@@) روى عنه: الزهري، ويحيى بن أبي كثير،(@)(@@) ويحيى بن سعيد الأنصاري.(@)(@@) أخبرنا علي بن محمد بن نصر، ثنا الحسين بن(@)(@@) محمد بن زياد، ثنا الحسين بن حريث، ثنا(@)(@@) PageV00P000(@)(@@) الفضل بن موسى الشيباني، عن محمد بن(@)(@@) عمرو المديني، عن أبي سلمة عبد الله بن(@)(@@) عبد الرحمن بن عوف.(@)(@@) روى إسماعيل بن أبي أويس، عن مالك بن(@)(@@) أنس، قال: كان الرجل من الأئمة اسم(@)(@@) أحدهم كنيته منهم: أبو سلمة ابن عبد الرحمن.(@)(@@)(@@)(@@) $ 3129 - (@)(@@) أبو سلمة: عبد الله بن [رافع](@)(@@) الحضرمي، المصري.(@)(@@) حدث عن: عمرو بن معد يكرب.(@)(@@) روى عنه: جعفر بن ربيعة.(@)(@@) قال لي أبو سعيد بن يونس بن عبد الأعلى.(@)(@@)(@@)(@@) $ 3130 - (@)(@@) أبو سلمة: تميم مولى فاطمة بنت(@)(@@) قيس.(@)(@@) حدث عن: فاطمة.(@)(@@) روى عنه: مجاهد بن جبر.(@)(@@) أخبرنا محمد بن يونس، ثنا الحسين، ثنا(@)(@@) إسحاق بن إبراهيم، أنا جرير، عن منصور،(@)(@@) عن مجاهد، قال: حدثني تميم أبو سلمة مولى(@)(@@) لفاطمة.(@)(@@)(@@)(@@) $ 3131 - (@)(@@) أبو سلمة: تميم بن حذلم.(@)(@@) حدث عن: أبي بكر، وعمر(@)(@@) رضي الله عنهما.(@)(@@) كناه البخاري.(@)(@@)(@@)(@@) $ 3132 - (@)(@@) أبو سلمة: الزبير بن عربي.(@)(@@) سمع: عبد الله بن عمر.(@)(@@) روى عنه: حماد بن زيد، ومعمر بن راشد(@)(@@) وكناه.(@)(@@)(@@)(@@) $ 3133 - (@)(@@) أبو سلمة: إياس بن سلمة بن(@)(@@) الأكوع.(@)(@@) حدث عن: أبيه.(@)(@@) كناه محمد بن عمر الواقدي.(@)(@@)(@@)(@@) $ 3134 - (@)(@@) أبو سلمة: الربيع بن حبيب الحنفي(@)(@@) البصري.(@)(@@) حدث عن: أبي سعيد الرقاشي، وعبد الله بن(@)(@@) عبيد بن عمير.(@)(@@) روى عنه: عبد الواحد بن زياد، ويحيى بن(@)(@@) سعيد (ق 132 / ب) القطان، وكناه.(@)(@@)(@@)(@@) $ 3135 - (@)(@@) أبو سلمة: الفضل بن ميمون(@)(@@) البصري.(@)(@@) حدث عن: معاوية بن قرة.(@)(@@) روى عنه: أحمد بن إسحاق الحضرمي،(@)(@@) وأبو سلمة موسى بن إسماعيل، وأبو عامر(@)(@@) العقدي وكناه.(@)(@@)(@@)(@@) $ 3136 - (@)(@@) أبو سلمة: مسعر بن كدام بن ظهير(@)(@@) ابن عبيدة الهلالي.(@)(@@) روى عنه: داود بن أبي هند، وسفيان الثوري(@)(@@) وكناه.(@)(@@)(@@)(@@) $ 3137 - (@)(@@) أبو سلمة: ابن 
ms284	 سليم الكناني(@)(@@) الحمصي.(@)(@@) حدث عن: الزهري، وبقية بن الوليد.(@)(@@) PageV00P000(@)(@@) أخبرنا محمد بن يونس، ثنا الحسين بن محمد(@)(@@) ثنا إسحاق بن إبراهيم، أنا محمد بن حرب(@)(@@) الحمصي، ثنا أبو سلمة: سليمان بن سليم(@)(@@) الحمصي.(@)(@@)(@@)(@@) $ 3138 - (@)(@@) أبو سلمة: المغيرة بن مسلم(@)(@@) الخراساني.(@)(@@) سمع: أبا الزبير، والربيع بن أنس.(@)(@@) روى عنه: سفيان الثوري، وأبو داود،(@)(@@) وشبابة.(@)(@@)(@@)(@@) $ 3139 - (@)(@@) أبو سلمة: سليم مولى الشعبي.(@)(@@) حدث عن: عامر الشعبي.(@)(@@) روى عنه: سفيان الثوري.(@)(@@) كناه مسلم بن الحجاج.(@)(@@)(@@)(@@) $ 3140 - (@)(@@) أبو سلمة: النعمان بن أبي عياش(@)(@@) الزرقي، تابعي.(@)(@@) كناه ابن لهيعة في حديث.(@)(@@)(@@)(@@) $ 3141 - (@)(@@) أبو سلمة: ثابت بن سرج الهمداني(@)(@@) وقيل: الدوسي، ويقال: المحاربي.(@)(@@) حدث عن: سالم بن عبيد الله.(@)(@@) روى عنه: الوليد بن مسلم.(@)(@@) أخبرنا علي بن نصر، ثنا الحسين بن محمد،(@)(@@) ثنا إسحاق بن موسى، ثنا الوليد بن مسلم،(@)(@@) حدثني أبو سلمة: ثابت بن سرج.(@)(@@)(@@)(@@) $ 3142 - (@)(@@) أبو سلمة: وقيل: أبو عبد الله:(@)(@@) موسى بن عبد الله الجهني.(@)(@@) روى عن: أنس.(@)(@@) وسمع: مصعب بن سعد، وعامر الشعبي.(@)(@@) سمعت محمد بن يعقوب، قال: سمعت(@)(@@) عباس بن محمد، قال: سمعت يحيى بن(@)(@@) معين، يقول: موسى الجهني أبو سلمة.(@)(@@)(@@)(@@) $ 3143 - (@)(@@) أبو سلمة: جرير بن زيد.(@)(@@) سمع: عامر بن سعد، وسالم بن عبد الله.(@)(@@) روى عنه: حماد بن زيد، عن يزيد بن حازم(@)(@@) عن سليمان بن يسار، أنه قال لعمي جرير بن(@)(@@) زيد: يا أبا سلمة.(@)(@@)(@@)(@@) $ 3144 - (@)(@@) أبو سلمة: محمد بن أبي حفصة،(@)(@@) وهو: ابن ميسرة.(@)(@@) حدث عن: الزهري.(@)(@@) روى عنه: إبراهيم بن طهمان، والثوري،(@)(@@) وابن المبارك.(@)(@@) كناه حفص بن غياث (ق 133 / أ) .(@)(@@) أخبرنا محمد بن يونس، ثنا أبو بكر بن أبي(@)(@@) شيبة، ثنا حفص بن غياث، عن أبي سلمة بن(@)(@@) أبي حفصة، ثنا إسحاق، أنا أبو معاوية، ثنا(@)(@@) محمد بن أبي حفصة، قال إسحاق: هو ابن(@)(@@) ميسرة، وهو أبو سلمة.(@)(@@)(@@)(@@) $ 3145 - (@)(@@) أبو سلمة: معاوية بن سلمة(@)(@@) النصري، كوفي نزل الشام.(@)(@@) PageV00P000(@)(@@) روى عنه: محمد بن عيسى بن سميع.(@)(@@) وكناه عبد الله بن نمير.(@)(@@)(@@)(@@) $ 3146 - (@)(@@) أبو سلمة: راشد الفزاري.(@)(@@) حدث عن: 
ms285	 زيد بن أبي رجاء الأحمسي.(@)(@@) روى عنه: عبد الله بن المبارك وكناه.(@)(@@)(@@)(@@) $ 3147 - (@)(@@) أبو سلمة: سعيد بن عطية.(@)(@@) حدث عن: سعيد بن جبير.(@)(@@) كناه البخاري.(@)(@@)(@@)(@@) $ 3148 - (@)(@@) أبو سلمة: عباد بن منصور.(@)(@@) حدث عن: عكرمة.(@)(@@) روى عنه: شعبة.(@)(@@) كناه عرعرة بن البرند.(@)(@@)(@@)(@@) $ 3149 - (@)(@@) أبو سلمة: عمر بن الوليد الشني.(@)(@@) عن: عكرمة.(@)(@@) كناه البخاري.(@)(@@)(@@)(@@) $ 3150 - (@)(@@) أبو سلمة: ابن يزداد بن قسوة(@)(@@) الصنعاني.(@)(@@) حدث عن: جابر بن زيد.(@)(@@) روى عنه: الحكم بن أبان.(@)(@@)(@@)(@@) $ 3151 - (@)(@@) أبو سلمة: الحسن بن ذكوان.(@)(@@) حدث عن: سليمان الأحول.(@)(@@) كناه عمرو بن علي.(@)(@@)(@@)(@@) $ 3152 - (@)(@@) أبو سلمة: عثمان بن مسلم الشحام(@)(@@) البصري.(@)(@@) حدث عن: عبد الرحمن بن أبي بكرة.(@)(@@) روى عنه: سعيد بن زيد، وكناه.(@)(@@) أخبرنا محمد بن يونس، ثنا الحسين بن محمد(@)(@@) ثنا محمد بن أبان، ثنا وكيع، عن أبي سلمة(@)(@@) الشحامي - يعني - عثمان.(@)(@@)(@@)(@@) $ 3153 - (@)(@@) أبو سلمة: مروان البصري.(@)(@@) حدث عن: شهر بن حوشب.(@)(@@) روى عنه: عبد الصمد بن عبد الوارث وكناه،(@)(@@) قال البخاري: مروان أبو سلمة: منكر(@)(@@) الحديث.(@)(@@)(@@)(@@) $ 3154 - (@)(@@) أبو سلمة: حماد بن سلمة [بن](@)(@@) دينار، مولى حمير بن كراثة الربعي.(@)(@@) سمع: قتادة، وعمرو بن دينار، وثابت(@)(@@) البناني.(@)(@@) روى عنه: سفيان الثوري، وشعبة، وإبراهيم(@)(@@) ابن طهمان، وعبد الله بن المبارك، ويحيى بن(@)(@@) سعيد.(@)(@@) أخبرنا علي بن نصر، ثنا الحسين بن محمد،(@)(@@) قال: سمعت عمرو بن علي، يقول: حماد(@)(@@) ابن سلمة بن دينار وأبوه يكنى أبا صخرة،(@)(@@) وهو مولى تميم مولى القربعيين مولى حميري(@)(@@) ابن كراثة، قاله الدارمي أحمد بن سعيد.(@)(@@)(@@)(@@) $ 3155 - (@)(@@) أبو سلمة: يوسف بن يعقوب(@)(@@) PageV00P000(@)(@@) الماجشون.(@)(@@) سمع: محمد بن المنكدر (ق 133 / ب)(@)(@@) والزهري.(@)(@@) قال محمد بن إسماعيل: قال لنا علي بن(@)(@@) المديني، ثنا يوسف بن يعقوب بن عبد الله بن(@)(@@) أبي سلمة: أبو سلمة الماجشون، سمع:(@)(@@) محمد بن المنكدر.(@)(@@) قال محمد: ويقال: اسم أبي سلمة دينار،(@)(@@) ولا أرى عليا حفظه، أراه أخا عبد الله.(@)(@@) قال: يعقوب بن محمد الماجشون هو يعقوب(@)(@@) مولى آل المنكدر التيمي، قال محمد: حدثني(@)(@@) أبو يحيى، ثنا أبو سلمة الخزاعي، ثنا عبد 
ms286	 العزيز(@)(@@) ابن يعقوب، عن أبيه، قال: خرجت مع عمر(@)(@@) ابن عبد العزيز، فقال لي: يا ماجشون.(@)(@@)(@@)(@@) $ 3156 - (@)(@@) أبو سلمة: ابن أبي بكر بن(@)(@@) عبد الرحمن بن الحارث بن هشام المخزومي.(@)(@@) حدث عن: أبيه.(@)(@@) روى عنه: شيبة بن نصاح.(@)(@@)(@@)(@@) $ 3157 - (@)(@@) أبو سلمة: مولى آل ربيعة.(@)(@@) حدث عن: أبي هريرة.(@)(@@) روى عنه: إسماعيل بن جعفر.(@)(@@)(@@)(@@) $ 3158 - (@)(@@) أبو سلمة: ابن سفيان بن عبد(@)(@@) [الأسد] المديني.(@)(@@) روى عنه: محمد بن عباد بن جعفر، ويحيى(@)(@@) ابن صيفي.(@)(@@)(@@)(@@) $ 3159 - (@)(@@) أبو سلمة: الكلاعي الحمصي.(@)(@@) حدث عن: ثوبان.(@)(@@) روى عنه: الأحوص بن حكيم.(@)(@@)(@@)(@@) $ 3160 - (@)(@@) أبو سلمة.(@)(@@) عن: أبي مسلم الجليلي.(@)(@@) حدث عن: حريز بن عثمان.(@)(@@) قاله البخاري.(@)(@@)(@@)(@@) $ 3161 - (@)(@@) أبو سلمة: الحمصي.(@)(@@) حدث عن: عبد الرحمن بن عوف، مرسل.(@)(@@) روى عنه: عبد العزيز بن أبي رواد.(@)(@@) أخبرنا خيثمة، ثنا إسحاق، عن عبد الرزاق،(@)(@@) عن ابن أبي رواد، ثنا أبو سلمة الحمصي، أن(@)(@@) عبد الرحمن بن عوف استأجر أجيرا في غزوة.(@)(@@)(@@)(@@) $ 3162 - (@)(@@) أبو سلمة: الحمصي.(@)(@@) حدث عن: خالد بن معدان.(@)(@@) روى عنه: عبد الرحمن بن عمرو الأوزاعي.(@)(@@)(@@)(@@) $ 3163 - (@)(@@) أبو سلمة: البكالي.(@)(@@) حدث عن: حذيفة.(@)(@@) روى حديثه: محمد بن سابق، عن حشرج(@)(@@) ابن نباته عنه.(@)(@@)(@@)(@@) $ 3164 - (@)(@@) أبو سلمة: ابن عبد الله بن عبد الله(@)(@@) ابن عمر بن الخطاب.(@)(@@) حدث عن: القاسم بن محمد.(@)(@@) PageV00P000(@)(@@) روى عنه: عبد العزيز الدراوردي، وأبو عاصم(@)(@@) النبيل.(@)(@@)(@@)(@@) $ 3165 - (@)(@@) أبو سلمة.(@)(@@) حدث عن: وهب بن منبه.(@)(@@) روى عنه: حماد بن سلمة.(@)(@@)(@@)(@@) $ 3166 - (@)(@@) أبو سلمة: الواسطي.(@)(@@) حدث عن: الشعبي.(@)(@@) روى عنه: شعبة بن الحجاج.(@)(@@) قاله البخاري.(@)(@@)(@@)(@@) $ 3167 - (@)(@@) أبو سلمة.(@)(@@) حدث عن: أبيه، قال قدم علينا عمر(@)(@@) (ق 134 / أ) بن عبد العزيز.(@)(@@) روى عنه: عبد الرحمن بن مهدي.(@)(@@) قاله البخاري.(@)(@@)(@@)(@@) $ 3168 - (@)(@@) أبو سلمة: مولى بني فزارة.(@)(@@) حدث عن: عامر الشعبي، وأبي إسحاق.(@)(@@) روى عنه: شعبة بن الحجاج.(@)(@@) أراه الأول.(@)(@@)(@@)(@@) $ 3169 - (@)(@@) أبو سلمة: عثمان بن مقسم البري.(@)(@@) حدث عن: نافع.(@)(@@) أخبرنا محمد بن يونس، ثنا الحسين بن محمد(@)(@@) قال: سمعت عمرو بن علي، يقول: عثمان(@)(@@) ابن مقسم البري، هو أبو 
ms287	 سلمة الكندي.(@)(@@)(@@)(@@) $ 3170 - (@)(@@) أبو سلمة: محمد بن عبد الله(@)(@@) الأنصاري.(@)(@@) متروك الحديث، حدث عن: مالك بن دينار.(@)(@@) روى عنه المتأخرون.(@)(@@) من أهل البصرة.(@)(@@)(@@)(@@) $ 3171 - (@)(@@) أبو سلمة: المثنى الحارثي.(@)(@@) حدث عن: مسلم بن كيسان.(@)(@@) روى عنه: خالد بن عمرو.(@)(@@)(@@)(@@) $ 3172 - (@)(@@) أبو سلمة: الخواص.(@)(@@) حدث عن: ثابت البناني، وأيوب السختياني.(@)(@@) روى عنه: الحسن بن خلف الواسطي.(@)(@@) أخبرنا العباس بن محمد البغدادي، ثنا الخليل(@)(@@) ابن محمد الواسطي، ثنا الحسن بن خلف، ثنا(@)(@@) أبو سلمة الخواص الواسطي، عن أيوب(@)(@@) السختياني.(@)(@@)(@@)(@@) $ 3173 - (@)(@@) أبو سلمة: الجهني.(@)(@@) حدث عن: القاسم بن عبد الرحمن.(@)(@@) روى عنه: فضيل بن مرزوق.(@)(@@) أراه الذي روى عنه: شجاع بن الوليد.(@)(@@)(@@)(@@) $ 3174 - (@)(@@) أبو سلمة: الحضرمي.(@)(@@) أنه رأى قبر عبد الله بن عباس.(@)(@@) رواه محمد بن عمر الواقدي، عن إسحاق بن(@)(@@) يحيى بن طلحة عنه.(@)(@@)(@@)(@@) $ 3175 - (@)(@@) أبو سلمة: الحكم بن الحكم بن أبي(@)(@@) لحية الجزري.(@)(@@) حدث عن: جعفر بن برقان.(@)(@@) PageV00P000(@)(@@) ذكره أبو عروبة وكناه.(@)(@@)(@@)(@@) $ 3176 - (@)(@@) أبو سلمة: سيار بن حاتم العنزي(@)(@@) البصري.(@)(@@) حدث عن: جعفر بن سليمان.(@)(@@) كناه محمد بن إسماعيل.(@)(@@)(@@)(@@) $ 3177 - (@)(@@) أبو سلمة: حماد بن معقل العبدي.(@)(@@) حدث عن: عثمان بن أبي رواد.(@)(@@) أخبرنا علي بن نصر، ثنا الحسين، ثنا محمد(@)(@@) ابن المثنى، ثنا حماد بن معقل أبو سلمة(@)(@@) العبدي.(@)(@@)(@@)(@@) $ 3178 - (@)(@@) أبو سلمة: عبيد بن عبد الرحمن بن(@)(@@) عبيد الحنفي.(@)(@@) حدث عن: عمرو بن يحيى بن سعيد بن(@)(@@) العاص، والجنيد بن أمين بن ذورة.(@)(@@) روى عنه: عمرو بن علي.(@)(@@)(@@)(@@) $ 3179 - (@)(@@) أبو سلمة: بشر بن عبد الله بن عمير(@)(@@) ابن عبد العزيز بن مروان.(@)(@@) حدث عن: أبيه، عن جده.(@)(@@) روى عنه: أبو عبيد القاسم بن سلام.(@)(@@) كناه البخاري.(@)(@@) أخبرنا عبد الله بن محمد بن (ق 134 / ب)(@)(@@) إسحاق بن علي بن عبد العزيز، ثنا أبو عبيد(@)(@@) القاسم بن سلام، ثنا بشر بن عبد الله بن عمر(@)(@@) ابن عبد العزيز.(@)(@@)(@@)(@@) $ 3180 - (@)(@@) أبو سلمة: منصور بن سلمة(@)(@@) الخزاعي.(@)(@@) حدث عن: سليمان بن بلال.(@)(@@) أخبرنا أحمد بن محمد بن إبراهيم مولى بني(@)(@@) هاشم، ثنا أبو أمية محمد 
ms288	 بن إبراهيم بن مسلم(@)(@@) ثنا أبو سلمة منصور بن سلمة.(@)(@@)(@@)(@@) $ 3181 - (@)(@@) أبو سلمة: منهال بن بحر بن سلام(@)(@@) القشيري البصري.(@)(@@) حدث عن: حماد بن سلمة.(@)(@@) روى عنه: عمرو بن علي.(@)(@@) كناه محمد بن خالد بن خداش المهلبي.(@)(@@)(@@)(@@) $ 3182 - (@)(@@) أبو سلمة: الهيثم بن عثمان(@)(@@) البصري.(@)(@@) حدث عن: سليمان بن مسلم.(@)(@@) روى عنه: أحمد بن سيار المروزي.(@)(@@)(@@)(@@) $ 3183 - (@)(@@) أبو سلمة: موسى بن إسماعيل(@)(@@) التبوذكي المنقري.(@)(@@) حدث عن: همام، وحماد، وأدرك شعبة.(@)(@@) أخبرنا خيثمة، ثنا أبو قلابة، وأخبرنا(@)(@@) عبد الرحمن بن يحيى، ثنا إبراهيم بن فهد بن(@)(@@) حكيم، وأخبرنا محمد بن محمد بن يوسف(@)(@@) الطوسي، ثنا عثمان بن سعيد الدارمي، قالوا:(@)(@@) ثنا أبو سلمة: موسى بن إسماعيل التبوذكي(@)(@@) المنقري.(@)(@@)(@@)(@@) $ 3184 - (@)(@@) أبو سلمة: يحيى بن خلف.(@)(@@) حدث عن: يزيد بن زريع، وعبد الوهاب(@)(@@) PageV00P000(@)(@@) الثقفي.(@)(@@) - يعرف - بالجوباري من أهل البصرة.(@)(@@)(@@)(@@) $ 3185 - (@)(@@) أبو سلمة: يحيى بن المغيرة(@)(@@) المخزومي.(@)(@@) حدث عن: محمد بن إسماعيل بن أبي(@)(@@) فديك.(@)(@@)(@@)(@@) $ 3186 - (@)(@@) أبو سلمة: مسلم بن محمد(@)(@@) العوجزي الصنعاني.(@)(@@) حدث عن: عبد الملك الذماري.(@)(@@)(@@)(@@) $ 3187 - (@)(@@) أبو سلمة: معاذ بن نجدة الهروي.(@)(@@) حدث عن: قبيصة بن عقبة، وخلاد بن(@)(@@) يحيى.(@)(@@) أخبرنا محمد بن محمد بن يوسف الطوسي،(@)(@@) ثنا أبو سلمة معاذ بن نجدة الهروي.(@)(@@)(@@)(@@) $ 3188 - (@)(@@) أبو سلمة: عبد الرحمن بن محمد(@)(@@) الألهاني الحمصي.(@)(@@) حدث عن: حيوة بن شريح.(@)(@@) روى عنه: أحمد بن محمد بن صدقة،(@)(@@) ومحمد بن الفضيل الحمصي.(@)(@@)(@@)(@@) $ 3189 - (@)(@@) أبو سلمة: أسامة بن أحمد التجيبي(@)(@@) المصري.(@)(@@) حدث عن: حرملة بن يحيى، وأدرك أحمد(@)(@@) ابن صالح.(@)(@@) روى عنه: أبو علي الحسين بن علي.(@)(@@) حدثنا أحمد بن أسامة بن أحمد التجيبي(@)(@@) بتجيب مصر (ق 135 / أ) عن أبيه.(@)(@@)(@@)(@@) || (من كنيته أبو سعيد (@)(@@)(@@)(@@) ||| من الصحابة)(@)(@@)(@@)(@@) $ 3190 - (@)(@@) أبو سعيد: زيد بن ثابت الأنصاري(@)(@@) ويقال: أبو عبد الله.(@)(@@) كناه عامر بن سعد بن أبي وقاص، وابنه(@)(@@) خارجه بن زيد بن ثابت.(@)(@@)(@@)(@@) $ 3191 - (@)(@@) أبو سعيد: سعد بن مالك بن سنان(@)(@@) الأنصاري الخدري.(@)(@@) له صحبة.(@)(@@) وهو أخو سعد بن أبي وقاص لأمه.(@)(@@) أخبرنا جعفر بن أحمد الخصاف بمكة، 
ms289	 ثنا(@)(@@) أحمد بن الهيثم، ثنا أبو نعيم الفضل بن دكين،(@)(@@) قال: أبو سعيد الخدري سعد بن مالك.(@)(@@)(@@)(@@) $ 3192 - (@)(@@) أبو سعيد: عبد الرحمن بن سمرة(@)(@@) ابن حبيب بن عبد شمس.(@)(@@) له صحبة.(@)(@@) روى عنه: عبد الله بن عباس، والحسن بن أبي(@)(@@) الحسن.(@)(@@) أخبرنا محمد بن يونس المقريء، ثنا الحسين(@)(@@) ابن محمد، ثنا أحمد بن إبراهيم الموصلي،(@)(@@) ثنا ناصح بن العلاء، عن عمار بن أبي عمار(@)(@@) مولى بني هاشم، قال مررت بعبد الرحمن(@)(@@) ابن سمرة القرشي، فقلت يا أبا سعيد.(@)(@@)(@@)(@@) $ 3193 - (@)(@@) أبو سعيد: عمرو بن حريث(@)(@@) القرشي، المخزومي.(@)(@@) له صحبة.(@)(@@) PageV00P000(@)(@@) روى عنه: أهل الكوفة، وأهل البصرة.(@)(@@) أخبرنا أحمد بن مهران، وأحمد بن عثمان،(@)(@@) قالا: ثنا شباب، قال: وعمرو بن حريث(@)(@@) يكنى أبا سعيد، أخبرنا علي بن محمد بن(@)(@@) نصر، ثنا الحسين بن محمد، قال: سمعت(@)(@@) عمرو بن علي، يقول: عمرو بن حريث(@)(@@) المخزومي، يكنى أبا سعيد.(@)(@@)(@@)(@@) $ 3194 - (@)(@@) أبو سعيد: وقيل: أبو عبد الرحمن،(@)(@@) ويقال: أبو زياد: عبد الله بن مغفل المزني(@)(@@) قاله البخاري.(@)(@@)(@@)(@@) $ 3195 - (@)(@@) أبو سعيد: سمرة بن جندب.(@)(@@) له صحبة، عداده في أهل البصرة.(@)(@@) كناه محمد ابن عمر الواقدي.(@)(@@)(@@)(@@) $ 3196 - (@)(@@) أبو سعيد: ابن المعلى، وقيل: ابن(@)(@@) أبي المعلى، اسمه: الحارث، وقيل: رافع بن(@)(@@) المعلى بن الحارث.(@)(@@) أخبرنا أحمد بن مهران، ثنا موسى بن زكريا،(@)(@@) ثنا شباب، قال: وأبو سعيد بن المعلى(@)(@@) اسمه الحارث.(@)(@@) أخبرنا محمد بن سعد الأبيوردي، ثنا عبيد بن(@)(@@) غنام، ثنا محمد بن عبد الله بن نمير، قال:(@)(@@) أبو سعيد بن المعلى اسمه: رافع.(@)(@@)(@@)(@@) $ 3197 - (@)(@@) أبو سعيد: خالد بن(@)(@@) سعيد بن العاص الأموي(@)(@@) (ق 135 / ب) .(@)(@@) له صحبة.(@)(@@) كناه البخاري.(@)(@@)(@@)(@@) $ 3198 - (@)(@@) أبو سعيد: ويقال: أبو عمرو: زيد(@)(@@) ابن أرقم.(@)(@@)(@@)(@@) $ 3199 - (@)(@@) أبو سعيد: المسيب بن حزن(@)(@@) القرشي.(@)(@@) روى عنه: ابنه سعيد.(@)(@@)(@@)(@@) $ 3200 - (@)(@@) أبو سعيد: معمر بن أبي سرح بن(@)(@@) ربيعة القرشي.(@)(@@) له صحبة، شهد بدرا.(@)(@@) قاله محمد بن عمر الواقدي.(@)(@@)(@@)(@@) $ 3201 - (@)(@@) أبو سعيد: ثابت بن وديعة(@)(@@) الأنصاري.(@)(@@) كناه محمد بن عمر الواقدي.(@)(@@)(@@)(@@) $ 3202 - (@)(@@) أبو سعيد: مولى أبي أسيد.(@)(@@) له صحبة. 
ms290	(@)(@@) روى عنه: أبو نضرة.(@)(@@) أخبرنا خيثمة، ثنا أبو قلابة، ثنا قريش بن أنس(@)(@@) عن سليمان التيمي، عن أبي نضرة، عن أبي(@)(@@) سعيد مولى أبي أسيد.(@)(@@)(@@)(@@) $ 3203 - (@)(@@) أبو سعيد: له صحبه.(@)(@@) PageV00P000(@)(@@) عداده في أهل الشام.(@)(@@) روى عنه: الحارث بن عمير الأشعري(@)(@@) الحمصي، من حديث عبد الرحمن بن يزيد بن(@)(@@) جابر عنه.(@)(@@)(@@)(@@) $ 3204 - (@)(@@) أبو سعيد: الزرقي، له صحبة.(@)(@@) أخبرنا أحمد بن مهران، ثنا موسى، ثنا(@)(@@) شباب، قال: أبو سعيد الزرقي، له صحبة.(@)(@@)(@@)(@@) $ 3205 - (@)(@@) أبو سعيد: الأنماري، ويقال:(@)(@@) أبو سعد الخير.(@)(@@) روى عنه: قيس بن حجر، وعبادة بن نسي.(@)(@@)(@@)(@@) $ 3206 - (@)(@@) أبو سعيد: ويقال: أبو إسحاق:(@)(@@) قبيصة بن ذؤيب.(@)(@@) ولد في زمان رسول الله صلى الله عليه وسلم(@)(@@) ولم يره.(@)(@@) ويحدث عنه: أبي بكر، وعمر رضي الله(@)(@@) عنهما.(@)(@@)(@@)(@@) ||| (ومن التابعين)(@)(@@)(@@)(@@) $ 3207 - (@)(@@) أبو سعيد: الحسن بن أبي الحسن(@)(@@) البصري.(@)(@@) وأبو الحسن اسمه: يسار مولى الأنصار.(@)(@@) رأى عثمان بن عفان.(@)(@@) روى عنه: قتادة، وأيوب، ويونس بن عبيد.(@)(@@)(@@)(@@) $ 3208 - (@)(@@) أبو سعيد: المهلب بن أبي صفرة(@)(@@) الأزدي، بصري.(@)(@@) سمع عبد الله بن عمر.(@)(@@) روى عنه: أبو إسحاق السبيعي، وسماك بن(@)(@@) حرب.(@)(@@) كناه الهيثم بن عدي.(@)(@@)(@@)(@@) $ 3209 - (@)(@@) أبو سعيد: المقبري، اسمه:(@)(@@) كيسان المديني.(@)(@@) حدث عن: عمر بن الخطاب، وعلي بن أبي(@)(@@) طالب، وأبي هريرة.(@)(@@) روى عنه: ابنه سعيد.(@)(@@) أخبرنا علي بن محمد بن نصر، ثنا الحسين بن(@)(@@) محمد، ثنا عمرو بن علي، قال: أبو سعيد(@)(@@) المقبري اسمه: كيسان.(@)(@@) حدثنا عبد الرحمن بن مهدي، ثنا ثابت بن(@)(@@) قيس أبو الغصن، حدثني أبو سعيد المقبري،(@)(@@) قال غدوت من منزلي فإذا رجل ينادي: يا(@)(@@) كيسان! فالتفت (136 / أ) فإذا بأبي هريرة.(@)(@@)(@@)(@@) $ 3210 - (@)(@@) أبو سعيد: اسمه: عقيصا.(@)(@@) PageV00P000(@)(@@) سمع: علي بن أبي طالب.(@)(@@) روى عنه: محمد بن حمادة.(@)(@@) كناه الثوري، عن محمد بن جحادة.(@)(@@)(@@)(@@) $ 3211 - (@)(@@) أبو سعيد: وقيل أبو سليم: يحيى(@)(@@) ابن يعمر.(@)(@@) حدث عن: عبد الله بن عمر.(@)(@@) كناه البخاري.(@)(@@)(@@)(@@) $ 3212 - (@)(@@) أبو سعيد: ابن سعيد.(@)(@@) سمع: عبد الله بن مسعود.(@)(@@) روى عنه: أبو يعفور.(@)(@@) كناه عبد الرحمن بن مهدي، عن إسرائيل،(@)(@@) عن أبي 
ms291	 يعفور، عن مسلم أبي سعيد،(@)(@@) وقال صدقة بن أبي عمران، عن أبي يعفور،(@)(@@) عن أبي سعيد مولى ابن مسعود،(@)(@@)(@@)(@@) $ 3213 - (@)(@@) أبو سعيد: حيان التيمي.(@)(@@) حدث عن: علي بن أبي طالب.(@)(@@) روى عنه: الأعمش.(@)(@@) أخبرنا محمد بن يونس، ثنا الحسين بن محمد(@)(@@) ثنا عبد الله بن عمر بن أبان، ثنا حفص بن(@)(@@) غياث، عن سليمان الأعمش، عن حيان أبي(@)(@@) سعيد التيمي.(@)(@@)(@@)(@@) $ 3214 - (@)(@@) أبو سعيد: شهر بن حوشب،(@)(@@) وقيل أبو عبد الرحمن.(@)(@@) حدث عن: عبد الله بن عباس، وأبي هريرة.(@)(@@) كناه أحمد بن سليمان بن أبي الطيب، عن أبي عبيدة الحداد، عن أبان بن صمعة، قال: سألت شهر بن حوشب، فقلت: يا أبا سعيد.(@)(@@)(@@)(@@) $ 3215 - (@)(@@) أبو سعيد: ابن عقيل بن أبي طالب صاحب رواية علي بن أبي طالب رضي الله عنه يوم النهروان.(@)(@@) رواه محمد بن الصلت بن الحجاج الكوفي، عن أبيه الصلت عنه.(@)(@@)(@@)(@@) $ 3216 - (@)(@@) أبو سعيد: الحارثي.(@)(@@) حدث عن: عمر بن الخطاب.(@)(@@) روى عنه: الحارث بن يزيد.(@)(@@) عداده في أهل مصر، قاله أبو سعيد بن يونس.(@)(@@)(@@)(@@) $ 3217 - (@)(@@) أبو سعيد: الحميري.(@)(@@) حدث عن: معاذ بن جبل.(@)(@@) روى حديثه: حيوة بن شريح المصري.(@)(@@) وقال ابن لهيعة: عن عبد الله بن هبيرة، عمن سمع ابن عباس.(@)(@@)(@@)(@@) $ 3218 - (@)(@@) أبو سعيد: مولى بني أمية.(@)(@@) عن: أبي الدرداء.(@)(@@) روى عنه: عبد الله بن بجير الصنعاني.(@)(@@) قاله البخاري.(@)(@@)(@@)(@@) $ 3219 - (@)(@@) أبو سعيد: الأشجعي.(@)(@@) حدث عن: علي بن أبي طالب رضي الله عنه.(@)(@@) روى عنه: أبو إسحاق الكوفي.(@)(@@) أخبرنا عبد العزيز بن محمد بن زياد، ثنا يوسف بن يعقوب، ثنا الربيع الزهراني، ثنا هشيم (ق 136 / ب) ، ثنا أبو إسحاق الكوفي، عن أبي سعيد الأشجعي، عن علي ابن أبي طالب إذا رعف الرجل في الصلاة.(@)(@@)(@@)(@@) $ 3220 - (@)(@@) أبو سعيد: مولى الحسين بن علي.(@)(@@) حدث عن: الحسين بن علي.(@)(@@) روى عنه: عمر بن يعلى بن مرة.(@)(@@)(@@)(@@) $ 3221 - (@)(@@) أبو سعيد: نافع بن سرجس.(@)(@@) سمع: أبا واقد الليثي.(@)(@@) روى عنه: عبد الله بن عثمان بن خثيم.(@)(@@) أخبرنا علي بن نصر، ثنا الحسين بن محمد، 
ms292	 ثنا أبو الربيع البصري، ثنا يحيى بن سليم، عن عبد الله بن عثمان بن خثيم، عن نافع بن سرجس أبي سعيد.(@)(@@)(@@)(@@) $ 3222 - (@)(@@) أبو سعيد: وقيل: أبو عبد الله: أبان ابن عثمان.(@)(@@) حدث عن: أبيه.(@)(@@) كناه السراج في كتابه.(@)(@@) أخبرنا إبراهيم بن محمد النيسابوري، عن محمد بن إسحاق.(@)(@@)(@@)(@@) $ 3223 - (@)(@@) أبو سعيد: قيس.(@)(@@) حدث عن: سعد بن أبي وقاص.(@)(@@) كناه البخاري.(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 3224 - (@)(@@) أبو سعيد: المديني.(@)(@@) حدث عن: عبد الله بن عمرو بن سمرة بن(@)(@@) جندب.(@)(@@) روى عنه: بشير بن سلمان.(@)(@@) قال بعضهم: عن بشير، عن أبي سعيد(@)(@@) صاحب الفساطيط مولى سهيل بن ذريح.(@)(@@) قاله وهب بن إسماعيل.(@)(@@)(@@)(@@) $ 3225 - (@)(@@) أبو سعيد: التمار، وقيل: المازني.(@)(@@) حدث عن: أبي سعيد الخدري.(@)(@@) روى عنه: زيد بن أسلم.(@)(@@)(@@)(@@) $ 3226 - (@)(@@) أبو سعيد: مولى أبي سعيد الخدري.(@)(@@) روى عنه: عبد الملك بن أبي سليمان. يحدث عن: أبي سعيد الخدري.(@)(@@)(@@)(@@) $ 3227 - (@)(@@) أبو سعيد: مولى ابن عباس.(@)(@@) سمع: عبد الله بن عباس.(@)(@@) روى عنه: فرات القزاز.(@)(@@) أخبرنا الحسن بن مروان بقيسارية، ثنا إبراهيم(@)(@@) ابن أبي سفيان، ثنا محمد بن يوسف الفريابي(@)(@@) عن سفيان، عن فرات القزاز(@)(@@)(@@)(@@) $ 3228 - (@)(@@) أبو سعيد:(@)(@@) حدث عن: عبد الله بن مسعود.(@)(@@) روى عنه: أبان بن صالح.(@)(@@)(@@)(@@) $ 3229 - (@)(@@) أبو سعيد: ابن عمارة التغلبي.(@)(@@) حدث عن: ناس من أصحاب رسول الله(@)(@@) صلى الله عليه وسلم.(@)(@@) روى عنه: سليمان بن موسى الأشدق.(@)(@@) PageV00P000(@)(@@) أخبرنا محمد إبراهيم بن مروان، ثنا أحمد بن(@)(@@) معلى، ثنا دحيم، ثنا عمر بن عبد الواحد، عن(@)(@@) عبد الرحمن بن يزيد بن (ق 137 / أ) جابر،(@)(@@) عن سليمان بن موسى، عن أبي سعيد بن(@)(@@) عمارة التغلبي، قال: بينا أنا في منزلي إذ أتاني(@)(@@) آت، فقيل: هؤلاء ناس من أصحاب(@)(@@) رسول الله صلى الله عليه وسلم.(@)(@@)(@@)(@@) $ 3230 - (@)(@@) أبو سعيد: الأزدي إمامهم.(@)(@@) حدث عن: علي بن أبي طالب.(@)(@@) رواه هشيم، عن إسماعيل بن سالم الكوفي.(@)(@@)(@@)(@@) $ 3231 - (@)(@@) أبو سعيد: محمد بن جبير بن(@)(@@) مطعم بن عدي بن نوفل بن عبد مناف القرشي(@)(@@) سمع: أباه.(@)(@@) روى عنه: الزهري، وسعد بن إبراهيم.(@)(@@) كناه 
ms293	 البخاري.(@)(@@)(@@)(@@) $ 3232 - (@)(@@) أبو سعيد: وقيل: أبو زياد: أفلح،(@)(@@) مولى أبي أيوب الأنصاري.(@)(@@) حدث عن: أبي أيوب.(@)(@@) كناه البخاري.(@)(@@)(@@)(@@) $ 3233 - (@)(@@) أبو سعيد: مولى عبد الله بن عامر(@)(@@) ابن كريز.(@)(@@) روى عنه: أسامة بن زيد، وصفوان بن سليم(@)(@@) ومحمد بن عجلان، ودواد بن قيس.(@)(@@) أخبرنا محمد بن أحمد بن عبد الجبار، ثنا(@)(@@) الربيع بن سليمان، ثنا عبد الله بن وهب، عن(@)(@@) أسامة بن زيد، عن أبي سعيد مولى عبد الله بن(@)(@@) عامر بن كريز.(@)(@@)(@@)(@@) $ 3234 - (@)(@@) أبو سعيد: الحمصي.(@)(@@) حدث عن: أبي هريرة.(@)(@@) روى عنه: معاوية بن صالح.(@)(@@) أخبرنا أحمد بن سليمان بن حذلم بدمشق، ثنا(@)(@@) أبو زرعة، ثنا عبد الله بن صالح، ثنا معاوية بن(@)(@@) صالح، عن أبي سعيد.(@)(@@)(@@)(@@) $ 3235 - (@)(@@) أبو سعيد: ابن أبي سعيد، جليس(@)(@@) أبي هريرة، كان ببيروت.(@)(@@) حدث عن: أبي هريرة، وأنس بن مالك.(@)(@@) روى عنه: عبد الرحمن بن يزيد بن جابر.(@)(@@) أخبرنا محمد بن إبراهيم بن مروان، ثنا أحمد(@)(@@) ابن معلى، ثنا سليمان بن عبد الرحمن، ثنا(@)(@@) عمر بن عبد الواحد، عن ابن جابر، حدثني(@)(@@) أبو سعيد ونحن ببيروت.(@)(@@)(@@)(@@) $ 3236 - (@)(@@) أبو سعيد: المهري.(@)(@@) حدث عن: أبي هريرة، وأبي سعيد.(@)(@@) روى عنه: يحيى بن أبي كثير، وسعيد(@)(@@) المقبري، ويحيى بن أبي إسحاق، ومحمد بن(@)(@@) أبي يحيى.(@)(@@)(@@)(@@) $ 3237 - (@)(@@) أبو سعيد: المهري.(@)(@@) حدث عن: ابن عمر.(@)(@@) روى عنه: ابنه سعيد.(@)(@@) PageV00P000(@)(@@) ذكره أبو سعيد بن يونس.(@)(@@)(@@)(@@) $ 3238 - (@)(@@) أبو سعيد: الغفاري، مولى بني(@)(@@) ليث.(@)(@@) حدث عن: أبي هريرة.(@)(@@) روى (ق 137 / ب) عنه: أبو هانئ(@)(@@) الخولاني.(@)(@@) أخبرنا الحسن بن عتبة الرازي بمصر، ثنا(@)(@@) أبو الزنباع روح بن الفرج، ثنا يحيى بن بكير،(@)(@@) ثنا عبد الله بن لهيعة، عن أبي هانئ الخولاني(@)(@@) عن أبي سعيد الغفاري، عن أبي هريرة.(@)(@@)(@@)(@@) $ 3239 - (@)(@@) أبو سعيد: الأزدي.(@)(@@) حدث عن: أبي هريرة.(@)(@@) روى عنه: قتادة بن دعامة، من حديث أبان(@)(@@) عنه، وقال هشام: عن قتادة، عن أبي سعيد(@)(@@) الخدري، عن ابن عباس.(@)(@@) أراه هذا، قاله ابن منده.(@)(@@)(@@)(@@) $ 3240 - (@)(@@) أبو سعيد: الأزدي.(@)(@@) عداده في المصريين.(@)(@@) روى عن: أبي هريرة.(@)(@@) حدث 
ms294	 عن: سالم بن غيلان.(@)(@@) قاله لي أبو سعيد ابن يونس.(@)(@@)(@@)(@@) $ 3241 - (@)(@@) أبو سعيد: الرقاشي الحماني.(@)(@@) حدث عن: عبد الله بن عون.(@)(@@) قال علي بن المديني: اسمه كثير، وهو(@)(@@) أبو سعيد ابن كثير، عن أبي هريرة، وعائشة.(@)(@@)(@@)(@@) $ 3242 - (@)(@@) أبو سعيد: يحصبي.(@)(@@) حدث عن: بسر بن أبي أرطأة.(@)(@@) روى عنه: أبو قبيل المعافري.(@)(@@) قاله أبو سعيد بن يونس.(@)(@@)(@@)(@@) $ 3243 - (@)(@@) أبو سعيد: مولى آل حزم.(@)(@@) حدث عن: أبي هريرة، وابن عمر.(@)(@@) روى عنه: ابنه سعيد، قاله فضيل بن سليمان.(@)(@@) ذكره البخاري.(@)(@@)(@@)(@@) $ 3244 - (@)(@@) أبو سعيد: يحيى بن سعيد بن قيس(@)(@@) الأنصاري، المدني.(@)(@@) سمع: أنس بن مالك، وسعيد بن المسيب.(@)(@@) روى عنه: ربيعة بن أبي عبد الرحمن، ومالك(@)(@@) ابن أنس، والثوري، وشعبة.(@)(@@) كناه يحيى بن سعيد.(@)(@@)(@@)(@@) $ 3245 - (@)(@@) أبو سعيد: المثنى بن سعيد الضبعي(@)(@@) القصير.(@)(@@) حدث عن: أنس بن مالك.(@)(@@) كناه أبو غياث سهل بن حماد وغيره.(@)(@@)(@@)(@@) $ 3246 - (@)(@@) أبو سعيد: بيان الرقاشي البصري.(@)(@@) سمع: أنس بن مالك.(@)(@@) روى عنه: المعتمر بن سليمان وكناه.(@)(@@)(@@)(@@) $ 3247 - (@)(@@) أبو سعيد: عبد الكريم بن مالك(@)(@@) الجزري، أدرك أنس بن مالك.(@)(@@) وروى عن: سعيد بن جبير، وعكرمة.(@)(@@) روى عنه: مالك، والثوري.(@)(@@) PageV00P000(@)(@@) كناه البخاري.(@)(@@)(@@)(@@) $ 3248 - (@)(@@) أبو سعيد: مخارق بن عبد الله(@)(@@) الأحمسي، الكوفي.(@)(@@) حدث عن: طارق بن شهاب.(@)(@@) روى عنه: الثوري، وإسرائيل.(@)(@@) كناه مسلم ابن الحجاج.(@)(@@) أخبرنا الحسين بن محمد، ثنا مكي عنه(@)(@@)(@@)(@@) $ 3249 - (@)(@@) (ق 138 / أ) أبو سعيد:(@)(@@) طالوت.(@)(@@) حدث عن: ابن عباس.(@)(@@) روى عنه: العلاء.(@)(@@) قاله البخاري.(@)(@@)(@@)(@@) $ 3250 - (@)(@@) أبو سعيد: الطائفي.(@)(@@) عن: ابن عمر.(@)(@@) روى عنه: قزعة بن سويد.(@)(@@)(@@)(@@) $ 3251 - (@)(@@) أبو سعيد: الأزدي.(@)(@@) حدث عن: محمد بن علي.(@)(@@) روى عنه: عطاء بن غزال.(@)(@@)(@@)(@@) $ 3252 - (@)(@@) أبو سعيد: البصري.(@)(@@) حدث عن: عامر الشعبي.(@)(@@) روى عنه: مجالد بن سعيد.(@)(@@) قاله البخاري.(@)(@@)(@@)(@@) $ 3253 - (@)(@@) أبو سعيد.(@)(@@) عن: ابن عمر، وعروة بن الزبير.(@)(@@) رواه: شعبة، عن إبراهيم بن محمد بن(@)(@@) حاطب.(@)(@@)(@@)(@@) $ 3254 - (@)(@@) أبو سعيد:(@)(@@) عن: عبد الرحمن بن أبزي.(@)(@@) روى عنه: منصور بن العتمر.(@)(@@) أنبأ محمد بن يعقوب، حدثنا عبد الله بن(@)(@@) أحمد بن حنبل، قال: سألت 
ms295	 أبي من أبو(@)(@@) سعيد هذا الذي روى عنه السدي؟ ، فقال:(@)(@@) روى يحيى بن آدم، عن الثوري، فقال فيه:(@)(@@) أبو سعيد الحداني.(@)(@@) أخبرنا خيثمة، ثنا إسحاق، عن عبد الرزاق،(@)(@@) عن الثوري، عن منصور - يعني - ابن المعتمر(@)(@@) عن أبي سعيد، عن ابن أبزي، قال: كان(@)(@@) النبي صلى الله عليه وسلم يشير بالسبابة.(@)(@@)(@@)(@@) $ 3255 - (@)(@@) أبو سعيد: الخلقاني.(@)(@@) حدث عن: ابن مسلم بن عبد الله.(@)(@@) روى عنه: محبوب بن محرز.(@)(@@)(@@)(@@) $ 3256 - (@)(@@) أبو سعيد: الأعسم الأسدي.(@)(@@) حدث عن: مصعب بن سعد.(@)(@@) روى عنه: الحجاج بن أرطأة.(@)(@@)(@@)(@@) $ 3257 - (@)(@@) أبو سعيد: الحميري، من أهل(@)(@@) مصر.(@)(@@) PageV00P000(@)(@@) روى عنه: حيوة بن شريح.(@)(@@) قاله البخاري.(@)(@@)(@@)(@@) $ 3258 - (@)(@@) أبو سعيد: خادم الحسن.(@)(@@) حدث عن: الحسن.(@)(@@) روى عنه: إسماعيل بن عياش.(@)(@@)(@@)(@@) $ 3259 - (@)(@@) أبو سعيد: وقيل: أبو سعد: حزام(@)(@@) ابن سعد بن محيصة.(@)(@@) حدث عن: أبيه.(@)(@@) روى عنه: الزهري.(@)(@@) كناه الواقدي.(@)(@@)(@@)(@@) $ 3260 - (@)(@@) أبو سعيد: عبد الله بن بشر(@)(@@) الحبراني.(@)(@@) عن: عبد الله بن بشر المازني.(@)(@@) روى عنه: محمد بن حمران.(@)(@@)(@@)(@@) $ 3261 - (@)(@@) أبو سعيد: وقيل: أبو سعد: روح(@)(@@) ابن جناح الدمشقي.(@)(@@) حدث عن: واثلة بن الأسقع.(@)(@@) روى عنه: الوليد بن مسلم وكناه.(@)(@@)(@@)(@@) $ 3262 - (@)(@@) أبو سعيد: داود البصري.(@)(@@) حدث عن: الحسن بن أبي الحسن.(@)(@@) روى عنه: عمران بن أبي خليفة.(@)(@@) كناه مسلم ابن الحجاج.(@)(@@)(@@)(@@) $ 3263 - (@)(@@) أبو سعيد: ثابت البصري.(@)(@@) حدث عن: يحيى بن يعمر (ق 138 / ب) .(@)(@@) روى عنه: محمد بن أبي الوضاح.(@)(@@)(@@)(@@) $ 3264 - (@)(@@) أبو سعيد: وقيل: أبو سهل: عمرو(@)(@@) ابن أبي حكيم.(@)(@@) روى عنه: شعبة.(@)(@@)(@@)(@@) $ 3265 - (@)(@@) أبو سعيد: عمرو بن سعيد(@)(@@) البصري.(@)(@@) حدث عن: أنس بن مالك.(@)(@@) روى عنه: عبد الله بن عون وكناه.(@)(@@)(@@)(@@) $ 3266 - (@)(@@) أبو سعيد: وقيل: أبو الوزرقاء:(@)(@@) سفيان بن دينار الكوفي.(@)(@@) حدث عن: عكرمة.(@)(@@) كناه البخاري.(@)(@@)(@@)(@@) $ 3267 - (@)(@@) أبو سعيد: جعثل بن هاعان.(@)(@@) عداده في أهل مصر.(@)(@@) حدث عن: عقبة بن عامر.(@)(@@) سمعت محمد بن يعقوب، قال: سمعت(@)(@@) عباسا، قال: سمعت يحيى بن معين،(@)(@@) يقول: أبو سعيد جعثل بن هاعان.(@)(@@)(@@)(@@) $ 3268 - (@)(@@) أبو سعيد: اسمه: الحكم.(@)(@@) عن: ابن عباس.(@)(@@) روى عنه: هشام الدستوائي.(@)(@@)(@@)(@@) $ 3269 
ms296	 - (@)(@@) أبو سعيد: ابن عوذ البراد، مكي.(@)(@@) PageV00P000(@)(@@) حدث عن: محمد بن المرتفع.(@)(@@) روى عنه: سفيان بن عيينة، و [أبو] نعيم(@)(@@) الفضل بن دكين.(@)(@@)(@@)(@@) $ 3270 - (@)(@@) أبو سعيد: ابن رافع، عم عباد بن(@)(@@) أبي صالح.(@)(@@) روى عنه: ابن جريج.(@)(@@)(@@)(@@) $ 3271 - (@)(@@) أبو سعيد: المكي.(@)(@@) حدث عن: عبد الله بن بديل.(@)(@@) روى عنه: بكرو بن عمرو المعافري.(@)(@@)(@@)(@@) $ 3272 - (@)(@@) أبو سعيد: الحميري، مصري.(@)(@@) روى عنه: حيوة بن شريح المصري.(@)(@@)(@@)(@@) $ 3273 - (@)(@@) أبو سعيد.(@)(@@) عن: خالد بن يزيد، عن سعيد بن أبي هلال،(@)(@@) مرسل.(@)(@@) أخبرنا أحمد بن سليمان، ثنا أبو زرعة، ثنا(@)(@@) عبد الله بن صالح، عن معاوية بن صالح عنه.(@)(@@)(@@)(@@) $ 3274 - (@)(@@) أبو سعيد.(@)(@@) حدث عن: أنس بن مالك.(@)(@@) روى عنه: وكيع بن الجراح.(@)(@@)(@@)(@@) $ 3275 - (@)(@@) أبو سعيد: مولى بني شيبة، وقيل:(@)(@@) مولى تيم.(@)(@@) روى عنه: عبد الله بن المبارك.(@)(@@) قاله البخاري.(@)(@@)(@@)(@@) $ 3276 - (@)(@@) أبو سعيد: الأعمى.(@)(@@) حدث عن: عطاء بن أبي رباح.(@)(@@) روى عنه: ابن جريج.(@)(@@) أخبرنا محمد بن محمد [بن] الأزهر،(@)(@@) وخيثمة بن سليمان، قالا: ثنا إسحاق، عن(@)(@@) عبد الرزاق، عن ابن جريج، أخبرني أبو سعيد(@)(@@) وحدي، وأنا مع عطاء.(@)(@@)(@@)(@@) $ 3277 - (@)(@@) أبو سعيد: الساحلي عبد الله بن(@)(@@) سعد، كناه محمد بن عمر الواقدي.(@)(@@)(@@)(@@) $ 3278 - (@)(@@) أبو سعيد: اسمه: إسماعيل.(@)(@@) حدث عن: عكرمة.(@)(@@) ذكره البخاري.(@)(@@)(@@)(@@) $ 3279 - (@)(@@) أبو سعيد: الشامي.(@)(@@) حدث عن: عطاء.(@)(@@) أراه (ق 139 / أ) عبد القدوس.(@)(@@) روى عنه: عبد الرزاق، قاله ابن منده.(@)(@@) أخبرنا محمد بن محمد [بن] الأزهر، ثنا(@)(@@) إسحاق، عن عبد الرزاق، ثنا أبو سعيد الشامي(@)(@@) عن عطاء في الأضحية.(@)(@@)(@@)(@@) $ 3280 - (@)(@@) أبو سعيد: عبد القدوس بن حبيب.(@)(@@) حدث عن: عكرمة، ونافع مولى ابن عمر.(@)(@@) روى عنه: الثوري.(@)(@@) أخبرنا محمد بن عمر بن حفص، ثنا إسحاق(@)(@@) ابن إبراهيم [بن] شاذان، بن سعد بن الصلت(@)(@@) ثنا أبو سعيد، عن عكرمة، عن ابن عباس، عن(@)(@@) PageV00P000(@)(@@) النبي صلى الله عليه وسلم، قال: تناصحوا في(@)(@@) العلم، ولا يكتم بعضكم بعضا، فإن جناية(@)(@@) الرجل في العلم أشد من جنايته في ماله،(@)(@@) وإن الله عز وجل سائلكم عنه.(@)(@@)(@@)(@@) $ 3281 - (@)(@@) أبو سعيد: إبراهيم بن 
ms297	 طهمان(@)(@@) الهروي.(@)(@@) نزل مكة.(@)(@@) حدث عن: الأعمش، ومنصور.(@)(@@) روى عنه: صفوان بن سليم، والثوري.(@)(@@) أخبرنا محمد بن الحسن القطان، ثنا قطن بن(@)(@@) إبراهيم، ثنا حفص بن عبد الله، ثنا إبراهيم بن(@)(@@) طهمان أبو سعيد.(@)(@@)(@@)(@@) $ 3282 - (@)(@@) أبو سعيد: سليمان بن المغيرة(@)(@@) القيسي البصري.(@)(@@) حدث عن: ثابت البناني.(@)(@@) أخبرنا محمد بن يعقوب الشيباني، ثنا محمد(@)(@@) ابن عمرو النيسابوري، ثنا عبد الله بن مسلمة(@)(@@) ابن قعنب، ثنا سليمان بن المغيرة أبو سعيد.(@)(@@)(@@)(@@) $ 3283 - (@)(@@) أبو سعيد: يزيد بن إبراهيم التستري(@)(@@) بصري.(@)(@@) حدث عن: الحسن.(@)(@@) روى عنه: الثوري.(@)(@@) كناه موسى بن إسماعيل.(@)(@@)(@@)(@@) $ 3284 - (@)(@@) أبو سعيد: عمارة بن زاذان(@)(@@) البصري.(@)(@@) حدث عن: ثابت البناني.(@)(@@) روى عنه: وكيع.(@)(@@) كناه البخاري.(@)(@@)(@@)(@@) $ 3285 - (@)(@@) أبو سعيد: سلام بن أبي مطيع(@)(@@) البصري.(@)(@@) حدث عن: قتادة، وثابت.(@)(@@) كناه البخاري.(@)(@@)(@@)(@@) $ 3286 - (@)(@@) أبو سعيد: القتباني.(@)(@@) حدث عن: أبي تميم الجيشاني.(@)(@@) روى عنه: بكير بن الأشج.(@)(@@)(@@)(@@) $ 3287 - (@)(@@) أبو سعيد: الحسن بن أبي جعفر.(@)(@@) حدث عن: أيوب، ومحمد بن جحادة،(@)(@@) كناه عمرو بن علي.(@)(@@)(@@)(@@) $ 3288 - (@)(@@) أبو سعيد: حدير الحمير، وقيل:(@)(@@) جرير.(@)(@@) عن: محمد بن المنكدر.(@)(@@) روى عنه: بقية بن الوليد.(@)(@@) قال البخاري: في حديثه حدير، والصواب(@)(@@) جرير.(@)(@@)(@@)(@@) $ 3289 - (@)(@@) أبو سعيد: يحيى بن راشد.(@)(@@) حدث عن: منصور بن المعتمر.(@)(@@) PageV00P000(@)(@@) (ق 139 / ب) أخبرنا علي بن محمد بن(@)(@@) نصر، ثنا الحسين بن محمد، ثنا محمد بن(@)(@@) المثنى، ثنا يحيى بن راشد أبو سعيد البصري.(@)(@@)(@@)(@@) $ 3290 - (@)(@@) أبو سعيد: ربيع النصري،(@)(@@) الكوفي.(@)(@@) روى عنه: محمد بن سابق وكناه.(@)(@@)(@@)(@@) $ 3291 - (@)(@@) أبو سعيد: حريش بن سليم(@)(@@) الكوفي.(@)(@@) حدث عن: طلحة بن مصرف.(@)(@@) كناه البخاري.(@)(@@)(@@)(@@) $ 3292 - (@)(@@) أبو سعيد: عبد المنعم بن نعيم.(@)(@@) حدث عن: العلاء بن عبد الرحمن، وأبي(@)(@@) حنيفة.(@)(@@) روى عنه: أبو بدر شجاع بن الوليد، ومحمد(@)(@@) ابن يزيد بن سنان، وموسى بن أعين وكناه.(@)(@@)(@@)(@@) $ 3293 - (@)(@@) أبو سعيد: الهيثم.(@)(@@) حدث عن: غالب القطان.(@)(@@) كناه البخاري.(@)(@@)(@@)(@@) $ 3294 - (@)(@@) أبو سعيد: محمد بن مسلم بن أبي(@)(@@) الوضاح المؤدب.(@)(@@) سمع: علي بن بذيمة، وعبد الكريم، وخصيف(@)(@@) الجزري.(@)(@@) روى عنه: عبد الرحمن بن مهدي، وأبو داود(@)(@@) وكناه. 
ms298	(@)(@@)(@@)(@@) $ 3295 - (@)(@@) أبو سعيد: محمد بن يزيد الكلاعي(@)(@@) الواسطي.(@)(@@) حدث عن: اسماعيل بن أبي خالد، والعوام(@)(@@) ابن حوشب.(@)(@@) روى عنه: إسحاق بن راهويه، وعلي بن(@)(@@) المديني، كناه الحسين بن حريث.(@)(@@)(@@)(@@) $ 3296 - (@)(@@) أبو سعيد: الحسن بن دعامة.(@)(@@) حدث عن: عمر بن شريك.(@)(@@) كناه مسلم بن الحجاج.(@)(@@)(@@)(@@) $ 3297 - (@)(@@) أبو سعيد: محمد بن عبد العزيز(@)(@@) الكوفي.(@)(@@) حدث عن: مغيرة بن مقسم.(@)(@@) روى عنه: محمد بن عيسى الطباع وغيره،(@)(@@) وكناه.(@)(@@)(@@)(@@) $ 3298 - (@)(@@) أبو سعيد: يعلى بن شبيب(@)(@@) القرشي.(@)(@@) حدث عن: هشام بن عروة، وعبد الله بن(@)(@@) عثمان بن خثيم.(@)(@@) روى عنه: عبد الله بن الزبير الحميدي،(@)(@@) ويعقوب بن كاسب، ومحمد بن أبي خلف.(@)(@@) أخبرنا محمد بن يونس المقريء، ثنا الحسين،(@)(@@) ثنا محمد بن أبان البلخي، ثنا أبو سعيد يعلى(@)(@@) ابن شبيب القرشي.(@)(@@)(@@)(@@) $ 3299 - (@)(@@) أبو سعيد: موسى بن أعين الجزري.(@)(@@) حدث عن: سليمان الأعمش، وإدريس(@)(@@) الأودي.(@)(@@) PageV00P000(@)(@@) كناه محمد بن عمرو بن خالد الحراني، عن(@)(@@) أبيه عنه.(@)(@@)(@@)(@@) $ 3300 - (@)(@@) أبو سعيد: حرملة بن عبد العزيز بن(@)(@@) الربيع بن سبرة الجهني.(@)(@@) حدث عن: أبيه.(@)(@@) كناه البخاري.(@)(@@)(@@)(@@) $ 3301 - (@)(@@) أبو سعيد: يحيى بن زكريا بن أبي(@)(@@) زائدة الهمداني، الكوفي.(@)(@@) حدث عن: إسماعيل بن أبي خالد، وسليمان(@)(@@) الأعمش.(@)(@@) روى عنه: أبو بكر بن أبي شيبة، وأبو كريب(@)(@@) وكناه (ق 140 / أ) .(@)(@@)(@@)(@@) $ 3302 - (@)(@@) أبو سعيد: الحسن بن حبيب بن(@)(@@) ندبه البصري.(@)(@@) حدث عن: روح بن القاسم، وسعيد بن أبي(@)(@@) عروبة.(@)(@@)(@@)(@@) $ 3303 - (@)(@@) أبو سعيد: بشر بن إبراهيم(@)(@@) الدمشقي، متروك.(@)(@@) حدث عن: عبد الرحمن بن عمر الأوزاعي.(@)(@@) روى عنه: سويد بن سعيد وغيره.(@)(@@)(@@)(@@) $ 3304 - (@)(@@) أبو سعيد: أحمد بن خالد الوهبي.(@)(@@) حدث عن: محمد بن إسحاق، وإسرائيل بن(@)(@@) يونس.(@)(@@) روى عنه: محمد بن يحيى الذهلي،(@)(@@) وأبو زرعة الدمشقي وكناه، أخبرنا إبراهيم بن(@)(@@) محمد بن صالح القنطري، ثنا أبو زرعة، ثنا(@)(@@) أحمد بن خالد أبو سعيد.(@)(@@)(@@)(@@) $ 3305 - (@)(@@) أبو سعيد: رباح المكي.(@)(@@) يقال: إنه ابن أبي معروف.(@)(@@) روى عنه: بكر بن عمرو المعافري وغيره.(@)(@@)(@@)(@@) $ 3306 - (@)(@@) أبو سعيد: سهل بن أسلم العدوي(@)(@@) البصري.(@)(@@) حدث عن: حميد بن هلال.(@)(@@) كناه البخاري. 
ms299	(@)(@@)(@@)(@@) $ 3307 - (@)(@@) أبو سعيد: مسلمة بن علي(@)(@@) الخشني.(@)(@@) حدث عن: الأوزاعي.(@)(@@) روى عنه: سليمان بن عبد الرحمن، وابن(@)(@@) وهب وكناه.(@)(@@)(@@)(@@) $ 3308 - (@)(@@) أبو سعيد: سالم بن نوح البصري.(@)(@@) حدث عن: سعيد بن أبي عروبة، وعمر بن(@)(@@) عامر.(@)(@@) كناه أبو موسى محمد بن المثنى، والبخاري.(@)(@@)(@@)(@@) $ 3309 - (@)(@@) أبو سعيد: المسيب بن شريك(@)(@@) الكوفي.(@)(@@) حدث عن: سليمان الأعمش، وإدريس(@)(@@) الأودي، كناه البخاري.(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 3310 - (@)(@@) أبو سعيد: مولى خزاعة.(@)(@@) حدث عن: عوف الأعرابي.(@)(@@) روى عنه: إسحاق بن إدريس البصري وكناه.(@)(@@)(@@)(@@) $ 3311 - (@)(@@) أبو سعيد.(@)(@@) حدث عن: يحيى بن أبي كثير.(@)(@@) روى عنه: عبد الرحمن بن ثابت بن ثوبان.(@)(@@) أخبرنا الحسن بن أحمد بن يوسف الدمشقي،(@)(@@) ثنا أبي، ثنا موسى بن سهل، عن عبد الملك بن(@)(@@) الحكم، عن ابن ثوبان بهذا.(@)(@@)(@@)(@@) $ 3312 - (@)(@@) أبو سعيد: خالد بن عمرو الأموي.(@)(@@) حدث عن: مسعر بن كدام والأعمش.(@)(@@) كناه البخاري.(@)(@@)(@@)(@@) $ 3313 - (@)(@@) أبو سعيد: الأموي.(@)(@@) حدث عن: شعبة.(@)(@@) روى عنه: علي بن محمد الطنافسي.(@)(@@)(@@)(@@) $ 3314 - (@)(@@) أبو سعيد: عبد الحميد بن محمد(@)(@@) ابن أبي العشرين الدمشقي.(@)(@@) حدث عن: الأوزاعي.(@)(@@) كناه هشام بن عمار.(@)(@@) أخبرنا محمد بن إبراهيم ابن مروان، ثنا أحمد(@)(@@) ابن المعلى، عن هشام.(@)(@@)(@@)(@@) $ 3315 - (@)(@@) أبو سعيد: البجلي، شامي.(@)(@@) حدث عن: علي بن عروة.(@)(@@) روى عنه: هشام بن عمار.(@)(@@)(@@)(@@) $ 3316 - (@)(@@) أبو سعيد: الوليد بن(@)(@@) (ق 140 / ب) كثير بن سنان الكوفي.(@)(@@) روى عنه: عثمان بن أبي شيبة وكناه.(@)(@@)(@@)(@@) $ 3317 - (@)(@@) أبو سعيد: عبد القاهر بن شعيب.(@)(@@) حدث عن: روح بن القاسم، وشعبة.(@)(@@) كناه البخاري.(@)(@@)(@@)(@@) $ 3318 - (@)(@@) أبو سعيد: عبد الملك بن قريب(@)(@@) الأصمعي.(@)(@@) حدث عن: عبد الله بن عون، وشعبة بن(@)(@@) الحجاج.(@)(@@) أخبرنا عثمان بن أحمد بن هارون، ثنا(@)(@@) أبو محمد بن إبراهيم وكناه.(@)(@@)(@@)(@@) $ 3319 - (@)(@@) أبو سعيد: عبد الله بن قيس الرقاشي(@)(@@) الخزاز البصري.(@)(@@) حدث عن: أيوب السختياني.(@)(@@) أخبرنا علي بن محمد بن نصر، ثنا الحسين بن(@)(@@) محمد بن زياد، ثنا محمد بن المثنى، حدثني(@)(@@) عبد الله بن قيس الرقاشي، أبو سعيد الخزاز.(@)(@@)(@@)(@@) $ 3320 - (@)(@@) أبو سعيد: سعد بن شعبة بن(@)(@@) الحجاج.(@)(@@) حدث عن: أبيه.(@)(@@) روى عنه: 
ms300	 أبو أمية محمد بن إبراهيم،(@)(@@) وإبراهيم بن فهد، وعباس بن أبي طالب(@)(@@) وكناه.(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 3321 - (@)(@@) أبو سعيد: يحيى بن الحارث(@)(@@) الطائي.(@)(@@) حدث عن: عكرمة بن إبراهيم.(@)(@@) روى عنه: أحمد بن سعيد الرباطي وكناه.(@)(@@)(@@)(@@) $ 3322 - (@)(@@) أبو سعيد: عمرو بن جرير البجلي،(@)(@@) الكوفي.(@)(@@) حدث عن: إسماعيل بن أبي خالد.(@)(@@) روى عنه: محمد بن كامل وكناه.(@)(@@)(@@)(@@) $ 3323 - (@)(@@) أبو سعيد: عمرو بن محمد القرشي(@)(@@) العنقري الكوفي.(@)(@@) سمع سفيان الثوري، وأسباط بن نصر.(@)(@@) روى عنه: أحمد بن حنبل، وعلي بن المديني(@)(@@) وإسحاق بن راهويه وكناه.(@)(@@)(@@)(@@) $ 3324 - (@)(@@) أبو سعيد: أحمد بن داود الحداد.(@)(@@) حدث عن: محمد بن يزيد الواسطي، وابن(@)(@@) مهدي.(@)(@@) روى عنه: أحمد بن سنان القطان، وأبو قدامة(@)(@@) السرخسي.(@)(@@) أخبرنا أحمد بن محمد بن زياد، وإسماعيل(@)(@@) ابن محمد البغدادي، قالا: ثنا خلف بن(@)(@@) محمد الواسطي، ثنا أبو سعيد الحداد أحمد بن(@)(@@) داود.(@)(@@)(@@)(@@) $ 3325 - (@)(@@) أبو سعيد: حماد بن مسعدة الباهلي(@)(@@) البصري.(@)(@@) حدث عن: عبيد الله بن عمر، وسعيد،(@)(@@) وشعبة.(@)(@@) كناه البخاري.(@)(@@)(@@)(@@) $ 3326 - (@)(@@) أبو سعيد: محمد بن سابق(@)(@@) الكوفي.(@)(@@) حدث عن: إسرائيل، وإبراهيم بن طهمان.(@)(@@) كناه البخاري.(@)(@@)(@@)(@@) $ 3327 - (@)(@@) أبو سعيد: يزيد بن يوسف(@)(@@) الصنعاني.(@)(@@) حدث عن: عبد الرحمن بن عمرو الأوزاعي(@)(@@)(@@)(@@) $ 3328 - (@)(@@) أبو سعيد: عبيد بن سعيد الكوفي.(@)(@@) حدث عن: الأعمش، وسفيان الثوري.(@)(@@) كناه مسلم، أخبرنا الحسين، ثنا مكي عنه.(@)(@@)(@@)(@@) $ 3329 - (@)(@@) (ق 141 / أ) أبو سعيد: نوح(@)(@@) ابن ميمون المضروب.(@)(@@) حدث عن: إبراهيم بن سعد.(@)(@@) روى عنه: أحمد بن [حنبل] ، وعباس(@)(@@) الدوري.(@)(@@)(@@)(@@) $ 3330 - (@)(@@) أبو سعيد: يحيى بن سعيد بن(@)(@@) فروخ القطان.(@)(@@) حدث عن: الأعمش، والثوري.(@)(@@) كناه أحمد ابن حنبل.(@)(@@)(@@)(@@) $ 3331 - (@)(@@) أبو سعيد: عبد الرحمن بن مهدي(@)(@@) ابن حسان البصري.(@)(@@) حدث عن: الثوري، وشعبة بن الحجاج.(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 3332 - (@)(@@) أبو سعيد: يحيى بن عبد الله البابلتي(@)(@@) الحراني.(@)(@@) حدث عن: الأوزاعي، وابي بكر بن ابي(@)(@@) مريم.(@)(@@)(@@)(@@) $ 3333 - (@)(@@) أبو سعيد: عبد الرحمن بن عبد الله(@)(@@) ابن عبيد، مولى بني هاشم.(@)(@@) سمع: شعبة، وأبا حرة، واسرائيل.(@)(@@) روى عنه: احمد بن حنبل.(@)(@@) اخبرنا محمد بن يونس المقريء، ثنا الحسين(@)(@@) ابن محمد، ثنا محمد بن عباد 