ms81	 ليلة شغل الرقاد غيورها ، % عن عاشق في الحب هتكة ستره % % 5(@)(@@) % إن لم تعودي للمتيم مرة % أخرى ، فإنك غلطة من دهره % % 6(@)(@@) % ما زال ينجز لي مواعد عينه ، % فمه ، وأحسب ريقه من خمره % % 7(@)(@@) % و إذا تحرك ذعره في قلبه ، % قطع الشفاء على ضنى لم يبره % % PageV01P451 البحر : وافر تام 1(@)(@@) % و مختضب بحثي للعقار ، % سقتني كفه ، والنجم سار % 2(@)(@@) % وفي يمناه إبريق وماء ، % وكأس الخمر في يده اليسار % 3(@)(@@) % فخلت يمينه لما ارقت % مزاج الكأس ممضغة لضار % PageV01P452 البحر : مجتث 1(@)(@@) % يا رب يوم سرور ، % بالمهد ، زار قصير % 2(@)(@@) % لو بعته بسنين ، % و أعمر ودهور % 3(@)(@@) % و كلها في نعيم ، % ما كنت بالمغدور % 4(@)(@@) % بكر علي بكأس ، % فالعيش في التبكير % 5(@)(@@) % أما ترى النجم ولى ، % وهم بالتغوير % 6(@)(@@) % البوم قصف وبسط ، % فسقني بالكبير % 7(@)(@@) % من كف ظبي مليح ، % ساجي الجفون غرير % 8(@)(@@) % يزهو بوردة خد ، % قد خدشت بعبير % 9(@)(@@) % و شعره من ظلام ، % ووجهه من نور % 10(@)(@@) % يزور اللحظ في العي % ن والهوى في الضمير % PageV01P453 البحر : منسرح 1(@)(@@) % يا أرض عمر و ! جادتك أمطار ، % فيك لقلبي ما عشت أوطار % 2(@)(@@) % يا طيب رياك حين يبتسم الفج % ر ، وفيها للروض أخبار % 3(@)(@@) % ومجلس جل أن نشبهه ، % حيث به مزهر ومزمار % 4(@)(@@) % و زانه من بني العباد رشا ، % بالجيد ، والمقلتين سحار % 5(@)(@@) % ابن نصارى يدين دينهم ، % حدث عنه بذاك زنار % 6(@)(@@) % قد ركبت كفه مشعشعة ، % إبريقها في الكؤوس هدار % 7(@)(@@) % يلمع فيها ، من كل ناحية ، % كوكب نور إليك نظار % 8(@)(@@) % باكرته ، والنجوم غائرة ، % والصبح قد حان منه إسفار % 9(@)(@@) % فظلت في يوم لذة عجب ، % وافى به للسعود مقدار % 10(@)(@@) % و قابل الشمس فيه بدر دجى ، % بأخذ من نورها ويمتار % PageV01P454 11(@)(@@) % يا غصن بان ضمته منطقة ، % و جيد ظبي حوتهث أزرار % 12(@)(@@) % تحسب قومي يضيعون دمي ، % ما ضاع قبلي لهاشم ثار % PageV01P455 البحر : بسيط تام 1(@)(@@) % اما ترى الدهر لا تفنى عجائبه ، % والدهر يمزج معسورا بميسور % 2(@)(@@) % و ليس للهم إلا شرب صافية ، % كأنها دمعة 
ms82	 من عين مهجور % PageV01P456 البحر : وافر تام 1(@)(@@) % صبوت إلى الندامى والعقار ، % و شرب بالصغار وبالكبار % 2(@)(@@) % و ساقي حانة يغدو علينا ، % بزنار ، وأقبية صغار % 3(@)(@@) % أما وفتور مقلة بابلي ، % بديع القد ذي صدغ مدار % 4(@)(@@) % لقد فضحت دموع العين سري ، % وأحرقني هواه بغير نار % 5(@)(@@) % و يخجل ، إذ يلاقيني ، كأني % % أنقط خده بالجلنار % 6(@)(@@) % وبيضاء الخمار ، إذا اجتلتها % % عيون الشرب صفراء الإزار % 7(@)(@@) % جموح في عنان الماء تنزو ، % إذا ما راضها ، نزو المهاري % % 8(@)(@@) % فضضت ختامها عن روح راح ، % لها جسدان من خزف وقار % 9(@)(@@) % تلقاها لكسرى رب كرم % يعد من الفلاسفة الكبار % 10(@)(@@) % أقر عروشها بثرى وطيء ، % و أنهار كحيات سوار % PageV01P457 11(@)(@@) % وسلفها العروش فحملته % عناقيدا كأشلاء الجوار % 12(@)(@@) % نواعم لا تذل بوطء رجل ، % وتعصر نفسها قبل اعتصار % 13(@)(@@) % إذا ألقين في الأطباق ذابت ، % فما ينقلن إلا بالجرار % 14(@)(@@) % فأودعها الدنان مصفيات ، % وأسلمها إلى شمس النهار % 15(@)(@@) % وألبسها قلانس معلمات ، % و صاحبها بصبر وانتظار % 16(@)(@@) % فلما جاوزت عشرين عاما ، % مخدرة ، وقرت في قرار % 17(@)(@@) % أتيح لها من الفتيان سمح ، % جواد لا يشح على العقار % 18(@)(@@) % فأبرزها تحدث عن زمان ، % كلمع الآل في البيد القفار % PageV01P458 البحر : خفيف تام 1(@)(@@) % أسقني الراح في شباب النهار ، % وانف همي بالخندريس العقار % 2(@)(@@) % قد تولت زهر النجوم وقد ب % % شر بالصبح طائر الأسحار % 3(@)(@@) % ما ترى نعمة السماء على الأر % % ض ، وشكر الرياض للأمطار % 4(@)(@@) % و غناء الطيور ، كل صباح ، % و انفتاق الأسحار بالأنوار % 5(@)(@@) % فكأن الربيع يجلو عروسا ، % وكأنا من قطره في نثار % PageV01P459 البحر : طويل 1(@)(@@) % ومستبصر في الغدر مستعجل القلى ، % بعيد من العتبى قريب من الهجر % 2(@)(@@) % له شافع في القلب من كل زلة ، % فليس بمحتاج الذنوب إلى العذر % 3(@)(@@) % تجاذبني الأطراف بالوصل والقلى ، % فتختصم الآمال واليأس في الصدر % 4(@)(@@) % بنفسي سقام لا يداوى مريضه ، % خفي على العواد ، باق على الدهر % 5(@)(@@) % هوى باطن فوق الهوى لج داؤه ، % وأعيا على العذال في السر والجهر % 6(@)(@@) % بليت بجبار يجل عن المنى ، % على رأسه 
ms83	 تاج من التيه والكبر % 7(@)(@@) % قدير على ما شاء مني مسلط ، % جري على ظلمي ، أمير على أمري % % 8(@)(@@) % ألفت الهوى حتى قلت نفسي القلى ، % وطال الضنى حتى صبرت على الصبر % 9(@)(@@) % و كرخية الأنساب ، أو بابلية % ثوت حقبا في ظلمة القار لا تسري % % 10(@)(@@) % وكم ليلة للهو قصر طولها % % بساقية الكفين ، والعين للخمر % PageV01P460 11(@)(@@) % وإني ، وإن كان التصابي يحثني ، % لأبلغ حاجاتي ، وأجري على قدري % % 12(@)(@@) % كريم ذنوب إن يصب بعض لذة ، % يدع بعضها فوق الأحاديث والوزر % PageV01P461 البحر : طويل 1(@)(@@) % إذا كان يومي ليس يوم مدامة ، % ولا يوم فتيان ، فما هو من عمري % % 2(@)(@@) % وإن كان معمورا بعود وقهوة ، % فذلك مسروق لعمري من الدهر % PageV01P462 البحر : بسيط تام 1(@)(@@) % إشرب وأسق ابن بشر من مشعشعة % كأن في حانها نورا بلا نار % 2(@)(@@) % دامت ثلاثين حولا في معاصرها ، % تسامر الدهر في طين من القار % PageV01P463 البحر : رجز تام 1(@)(@@) % وليلة من حسنات الدهر ، % ما ينمحي موضعها من ذكري % % 2(@)(@@) % و ليس تسلوها بنات صدري ، % سريت فيها بخيول شقر % 3(@)(@@) % سياطها ماء السحاب الغر ، % كأنه ذوب لجين يجري % % 4(@)(@@) % فلم تزل تحت الظلام تسري ، % محثوثة حتى بلغت سكري % % 5(@)(@@) % في ليلة مقمرة بالزهر ، % وشادن ضعيف عقد الخصر % 6(@)(@@) % يمضي بموج ويجي ببدر ، % يفعل بالليل فعال الفجر % 7(@)(@@) % مكحولة ألحاظه بسحر ، % في خده عقارب لا تسري % % 8(@)(@@) % في سبح قد قيدت بالقطر ، % تلسع أحشائي وليس يدري % % 9(@)(@@) % يا ليلة سرقتها من دهري ، % ما كنت إلا غرة في عمري % % 10(@)(@@) % أما وريق بارد في ثغر ، % شيبا بطعم عسل وخمر % PageV01P464 11(@)(@@) % ما الموت إلا الهجر ، أو كالهجر % . . . . . . . . . . . . . . . . . . . % PageV01P465 البحر : طويل 1(@)(@@) % ظللت بنعمى خير يوم وليلة % يدور علينا الكأس في فتية زهر % 2(@)(@@) % يكف غزال ذي عذار وطرة ، % و صدغين كالقافين في طرفي سطر % 3(@)(@@) % لدى نرجس غض وسدر كأنه % % قدود جوار ملن في ازر خضر % PageV01P466 البحر : مجزوء الرمل 1(@)(@@) % اسكبوا الكأس إلى النو % % م ، وخيل اللهو تجري % % 2(@)(@@) % إن يكن لا بد نوم ، % فاعذروا النوم بسكر % PageV01P467 البحر : كامل 
ms84	 تام 1(@)(@@) % يا رب ليل قد نعمت به ، % يسعى علي بكأسه البدر % 2(@)(@@) % في نرجس غض نواظره ، % بين الجفون عيونها صفر % 3(@)(@@) % فإذا النميمة للرياح جرت % ما بينهن وخانها الصبر % 4(@)(@@) % ظلت لمعتنق ، ومفترق ، % يدني الرضى ويساعد الهجر % 5(@)(@@) % ملأت مداهنها ثرى ، فترى % % أعناقها من ثقله صغر % 6(@)(@@) % أبدى الربيع لصوب وابلها ، % سر البلاد ، فبطنها ظهر % PageV01P468 البحر : متقارب تام 1(@)(@@) % أتاك الربيع بصوب البكر ، % و رف على الجسر برد السحر % 2(@)(@@) % وجفت على المرء أثوابه ، % إذا راح في حاجة أو بكر % 3(@)(@@) % و نقرت الأرض عن جوهر ، % فمنتظم منه ، أو منتثر % 4(@)(@@) % و قد عدل الدهر ميزانه ، % فلا فيه حر ولا فيه قر % 5(@)(@@) % و شرب سبقهم ، والصبا % % ح في وكره واقع لم يطر % 6(@)(@@) % كأنهم نثروا بينهم % حريقا ، فأيديهم تستعر % PageV01P469 البحر : طويل 1(@)(@@) % أفي رد كأس الخمر عني ، فلا خمرا % % عقاربها دبت علي ، ولا وزرا % % 2(@)(@@) % و بدلت منها ، بعد بيضاء غضة ، % بأسود لون كالح حالك مرا % % 3(@)(@@) % كأن الندامى حين كظوا بشربه ، % محابر وراقين قد ملئت حبرا % % PageV01P470 البحر : مجزوء الرمل 1(@)(@@) % ونديم قمرته ، % غفلة الكأس العقار % 2(@)(@@) % لم يزل ليلته في % % فلك السكر يدار % 3(@)(@@) % قهوة سر القذى من % ها لعينيك جبار % 4(@)(@@) % فترى كاساتها تق % % دح فيهن الشرار % 5(@)(@@) % وكساها الماء شيبا ، % لم يكن فيه وقار % PageV01P471 البحر : وافر تام 1(@)(@@) % شربنا بالصغير ، وبالكبير ، % ولم نحفل بأحداث الدهور % 2(@)(@@) % وقد ركضت بنا خيل الملاهي ، % وقد طرنا بأجنحة السرور % PageV01P472 البحر : متقارب تام 1(@)(@@) % وفتيان لهو غدوا للصبو % % ح ، وقد قدح الليل فجرا وأورى % % 2(@)(@@) % ندامى ، فلا ذا يماري لذا ، % ولا ذاك يجلس عن ذاك دورا % % 3(@)(@@) % بدير المطيرة نقرى المدا % % م لدى القس لما أتيناه زورا % % 4(@)(@@) % كأن خراطيمها ، في الزجاج ، % خراطيم فحل ينقينض ثورا % % PageV01P473 البحر : خفيف تام 1(@)(@@) % ضحك الورد في قفا المنثور ، % و استرحنا من رعدة المقرور % 2(@)(@@) % و استطبنا المقيل في برد ظل ، % و شممنا الريحان بالكافور % 3(@)(@@) % فالرحيل الرحيل يا عسكر الل % % ذات في كل 
ms85	 روضة وغدير % 4(@)(@@) % وامزج النبت ، وامزج الراح بالثل % % ج ، وإطفىء بالماء نار الهجير % PageV01P474 البحر : مجتث 1(@)(@@) % اذهب إلى بيت عذره ، % و متع النفس قطره % % 2(@)(@@) % واصرف من الهم يوما ، % و اطفر إلى اللهو طفره % % 3(@)(@@) % في مجلس فوق نهر ، % فيه لعينيك قره % % 4(@)(@@) % تخال كل مليح ، % قد صف في الوجه طره % % 5(@)(@@) % ممن يجيب بشرط ، % أو من يجود بمره % % 6(@)(@@) % وقد علا جانبيه ، % وقد تجاوز قدره % % 7(@)(@@) % و الهر يعمل في ك % % ل موضع فيه سره % % 8(@)(@@) % يسقي رياض جنان ، % يرنو بأحداق زهره % % 9(@)(@@) % كأنه رقم وشي % بصفرة وبحمره % % 10(@)(@@) % كأنها ، حين مجت % في الكأس ، ريقة خمره % % PageV01P475 البحر : بسيط تام 1(@)(@@) % سقيا لدار بنهر الكرخ ، من دار ، % تركت فيها لباناتي وأوطاري % % 2(@)(@@) % من عهد عامين لم ألمم بساحتها ، % دارت عليها رحى الدنيا بأطوار % 3(@)(@@) % كم فيك يا دار من عصر لهوت به ، % يا ليته لي من عمري بأعصار % 4(@)(@@) % يرون فيها الظباء الأدم سانحة ، % يشبهن شرا بأعناق وأبصار % 5(@)(@@) % ثم التفت إلى شيبي ، فذكرني % % حلمي ، فأبت إلى يأس وإقصار % 6(@)(@@) % كأنني ، وقتودي فوق ذي جدد ، % مبكر بين إظلام وإسفار % 7(@)(@@) % فراعني صائح يعدو بأكلبة % مطوقات بأسيار وأوتار % 8(@)(@@) % من كل خالي النحض محتبل ، % يطالب الشر في أطواقه ، ضاري % % 9(@)(@@) % كم سخطة بت أخفيها عليه ، كما % % تخفي الحجارة فيها مسكن النار % 10(@)(@@) % ألا سبيل إلى واف أواصله ، % فقد تجنب ودي كل غدار % PageV01P476 البحر : مجزوء الرجز 1(@)(@@) % يا نفس صبرا صبرا ، % أما عرفت الدهرا % % 2(@)(@@) % لله مني قلب ، % يقري البلايا شكرا % % 3(@)(@@) % يا رب ليل قاس ، % كأن علي قرا % % 4(@)(@@) % سريته بعيني ، % حتى رأيت الفجرا % % 5(@)(@@) % كأنما سناه % أطار عني نسرا % % 6(@)(@@) % واستجمعت همومي ، % حتى ملأن الصدرا % % 7(@)(@@) % ذاقت من الأعادي % % عيناي لحظا مرا % % 8(@)(@@) % ضاع الوفاء منهم ، % وأضمروا لي الغدرا % % 9(@)(@@) % يا نفس لي بقوم % كانوا كراما زهرا % % 10(@)(@@) % مضوا بخير عمري ، % وتركوا لي الشرا % % PageV01P477 11(@)(@@) % ولم أجد إذ ماتوا ، % لي في الحياة عذرا % % 12(@)(@@) % عاشوا بخير عصر ، % سقيا لذاك عصرا 
ms86	 % % 13(@)(@@) % نبئتث أن قومي % % قد دفنوا لي مكرا % % 14(@)(@@) % فابتلع المطايا ، % فاستعجلوا بي القبرا % % 15(@)(@@) % ردوا ردائي لما % % رأوا بقائي فخرا % % 16(@)(@@) % كأنهم بيومي ، % فلا تحثوا العمرا % % 17(@)(@@) % هل للأغر ذنب ، % إن لم يكونوا غرا % % 18(@)(@@) % أغمدت عنكم سيفي ، % وقد ملكت النصرا % % 19(@)(@@) % صيانة وعطفا ، % لرحمي ، وغفرا % % 20(@)(@@) % و ليس كل وقت % يطفىء ماء جمرا % % PageV01P478 21(@)(@@) % أأن ألم دهر ، % جاء بكم وسرا % % 22(@)(@@) % كفرتم كريما ، % حن لكم ودرا % % 23(@)(@@) % أتعبتم يديه ، % بالقلبات دهرا % % 24(@)(@@) % و مهمه رحيب % ظمآن يضني السفرا % % 25(@)(@@) % يخطر في فلاة ، % موج السحاب خطرا % % 26(@)(@@) % خاضوا الظلام بعدي ، % مع الحداة شهرا % % 27(@)(@@) % كم من عبيد دار ، % ظعنت عنهم حرا % % 28(@)(@@) % ذا خلق كريم ، % لم يبق فيهم عقرا % % 29(@)(@@) % ونسب صحيح ، % % 30(@)(@@) % خاضوا الظلامض بعدي ، % و كنت فيهم فجرا % % PageV01P479 البحر : طويل 1(@)(@@) % سأرحل عنكم لا جوادا بعبرة س ، % و أصبح عنكم ساليا فارغ الذكر % 2(@)(@@) % و أركب ظهر الأرض أو بطن لجة % مهملجة لا تشتكي خبب السفر % 3(@)(@@) % إذا اضطربت تحت الرياح رأيتها % % كاحشاء منحوت الفؤاد من الذعر % 4(@)(@@) % يريك بعذب الماء صفو ترابها ، % ويعطيك سر الأرض والأرض لا تدري % % PageV01P480 البحر : رجز تام 1(@)(@@) % قد أغتدي عل الجياد الضمر ، % و الصبح في طرة ليل مسفر % 2(@)(@@) % كأنه غرة مهر أشقر ، % والوحش في أوطانها لم تعذر % 3(@)(@@) % جلا لنا وجه الثرى عن منظر % كالعصب أو كالوشي أو كالجوهر % 4(@)(@@) % من أبيض وأحمر وأصفر ، % و طارف أجفانه لم ينظر % 5(@)(@@) % تخاله العين فما لم يغفر ، % و فاتق كاد ولم ينور % 6(@)(@@) % كأنه مبتسم لم يكشر ، % و أدمع الغدران لم تكدر % 7(@)(@@) % و الروض مغسول بليل ممطر ، % كأنه دراهم في منشر % 8(@)(@@) % أو كتفسير مصحف مفسر ، % و الشمس في غصحاء جو أخضر % 9(@)(@@) % كدمعة جارية في محجر ، % تسقى عقارا كالسراج الأزهر % 10(@)(@@) % مدامة تعقر إن لم تعقر ، % تديرها كف غزال أحور % PageV01P481 11(@)(@@) % ذي طرة عاطرة كالعنبر ، % تخبر عيناه بعشق مضمر % 12(@)(@@) % يعلم الفجورض من لم يفجر ، % و يذعر الصيد بباز أقمر 
ms87	 % 13(@)(@@) % كأنه في جوشن مزرر ، % ذي مقلة تسرح فوق المحجر % 14(@)(@@) % كأنه رق خفي الأسطر ، % وذنب كالمنصل المذكر % PageV01P482 البحر : مجزوء الرجز 1(@)(@@) % لا صيد إلا بوتر ، % أصفر مجدول ، ممر % 2(@)(@@) % إن مسه الرامي نخر ، % ذي مقلة تبكي مدر % 3(@)(@@) % صنعة بار مقتدر ، % دام عليها فمهر % 4(@)(@@) % فجئن أمثال الأكر ، % لم يختلفن في الصور % 5(@)(@@) % بصغر ، ولا كبر ، % أشبه طين بحجر % 6(@)(@@) % يودعن أمثال السرر ، % ثم يطرنض كالشرر % 7(@)(@@) % إلى القلوب والثغر ، % لما غدون بسحر % 8(@)(@@) % والليل مسود الطرر ، % يأخذ أرضا ويذر % 9(@)(@@) % ولاح صبح واشتهر ، % جاءت صفوفاص وزمر % 10(@)(@@) % سوانحا بيض الغرر ، % يطلبنض ما شاء القدر % PageV01P483 11(@)(@@) % روضا جديدا ونهر ، % و هن يسألن النظر % 12(@)(@@) % ما عنده من الخبر ، % فقام رام فابتدر % 13(@)(@@) % وتر قوسا وحسر ، % إذا رمى الصف انتشر % 14(@)(@@) % هولض عودا قد نخر ، % فبين هاو منحدر % 15(@)(@@) % وصائح على خطر ، % وذي جناح منكسر % 16(@)(@@) % وارتاح من حسن الظفر ، % و مسه جن الأشر % 17(@)(@@) % وقلن إذ حق الأثر ، % وجد رمي ، فاستمر % 18(@)(@@) % ما هكذا رمي البشر ، % صار حصى الأرض مدر % PageV01P484 البحر : بسيط تام 1(@)(@@) % سقى المطيرة ذات الظل والشجر % و ديرض عبدون هطال من المطر % 2(@)(@@) % فطالما نبهتني للصبوح بها ، % في غرة الفجر ، والعصفور لم يطر % 3(@)(@@) % أصوات رهبان دير في صلاتهم ، % سود المدارع نعرين في السحر % 4(@)(@@) % مزنرين على الأوساط قد جعلوا % % على الرؤوس أكاليلا من الشعر % 5(@)(@@) % كم فيهم من مليحش الوجه مكتحل % بالسحر يطبق جفنيه على حور % 6(@)(@@) % لاحظته بالهوى حتى استقاد له % طوعا ، وأسلفني الميعاد بالنظر % 7(@)(@@) % و جاءني في قميص الليل مستترا ، % يستعجل الخطو من خوف ومن حذر % 8(@)(@@) % فقمت أفرش خدي في الطريق له % ذلا ، وأسحب أذيالي على الأثر % 9(@)(@@) % ولاح ضوء هلال ، كاد يفضحنا ، % مثل القلامة قد قدت من الظفر % 10(@)(@@) % فكان ما كان مما لست أذكره ، % فظن خيرا ولا تسأل عن الخبر % PageV01P485 البحر : بسيط تام 1(@)(@@) % يا من تبجح في الدنيا وزخرفها ، % كن من صروف لياليها على حذر % 2(@)(@@) % و لا 
ms88	 يغرنك عيش إن صفا وعفا ، % فالمرء من غرر الأيام في غرر % 3(@)(@@) % إن الزمان ، إذا جربت خلقته ، % مقسم الأمر بين الصفو والكدر % 4(@)(@@) % كم قد أغار قوى حبل لغادره ، % لما أغار عليه ، واهي المرر % PageV01P486 البحر : سريع 1(@)(@@) % كأنما التفاح لما بدا ، % يرفل في أثوابه الحمر % 2(@)(@@) % شهد بماء الورد مستودع % في اكر من جامد الخمر % 3(@)(@@) % كأننا حين نحيا به % نستنشق الند من الخمر % PageV01P487 البحر : كامل تام 1(@)(@@) % أنعم بتين طاب طعما واكتسى % % حسنا وزان مخرجا من منظر % 2(@)(@@) % في برد ثلج ، في نقا تبر ، وفي % % ريح العبير وطيب طعم السكر % 3(@)(@@) % يحكي ، إذا ما صب في أطباقه ، % خيما ضربن من الحرير الأحمر % PageV01P488 البحر : طويل 1(@)(@@) % و لما دفنا جسمه في ترابه ، % جعلت صميم القلب مني له قبرا % % 2(@)(@@) % و تربته سر الفؤاد ، وكلما % % هممت بأن أنساه جدد لي ذكرا % % PageV01P489 البحر : طويل 1(@)(@@) % عليك بحسن الصبر في كل كورد % من الأكرم تحظى بحسن المصادر % % 2(@)(@@) % ولا تفزعن من كل شيء مفزع ، % فما كل تربيع النجوم بضائر % PageV01P490 البحر : كامل تام 1(@)(@@) % إن كنت قد بلغت عني سبة ، % فالذنب فيه للعدو المفتري % % 2(@)(@@) % أو خيلوا لك أن عهدي أبتر ، % فالحر لا يرضى بعهد أبتر % 3(@)(@@) % طبعي كطبع المشتري ما فيه من % % شوب ، فهل من مشتر للمشتري % % PageV01P491 البحر : طويل 1(@)(@@) % ومنطقة شدت بخصر معذبي ، % و قالت لهذا الشد : لست أحور % 2(@)(@@) % و قد ضاع مني الخصر من فوق ردفه ، % ولا عجب أني عليه أدور % PageV01P492 البحر : وافر تام 1(@)(@@) % و قالوا : لم بكيت دما ودمعا ، % وقد لاقيت بعد العسر يسرا % % 2(@)(@@) % فقلت : لفرحتي برضاه عني % % بكيت عليه ياقوتا ودرا % % PageV01P493 البحر : بسيط تام 1(@)(@@) % لا غرو إن أصبحت خيلان وجنته % % جمرا ، فقد مسها من خده نار % 2(@)(@@) % آيات حسن بخديه مسطرة ، % لها من الخال أخماس وأعشار % PageV01P494 البحر : مجزوء الكامل 1(@)(@@) % عانيت حبة خاله ، % في روضة من جلنار % 2(@)(@@) % فغدا فؤادي طائرا ، % واصطاده شرك العذار % PageV01P495 البحر : سريع 1(@)(@@) % كأنما الليمون لما بدا % % للعين في أوراقه الخضر 
ms89	 % 2(@)(@@) % مداهن من ذهب أطبقت % على زكي المسك والخمر % PageV01P496 البحر : بسيط تام 1(@)(@@) % قم نصطبح فليالي الوصل مقمرة ، % كأنها باجتماع الشمل أسحار % 2(@)(@@) % و الهر في غفلة نامت حوادثه ، % و نبهتنا إلى اللذات أوتار % 3(@)(@@) % أما ترى أربعا للهو قد جمعت : % جنك ، وعود ، وقانون ، ومزمار % 4(@)(@@) % فخذ بحظ من الدنيا ، فلذتها % % تفنى ، ويبقى روايات وأخبار % PageV01P497 البحر : بسيط تام 1(@)(@@) % أهلا بزائر عام مرة أبدا ، % لو كان من بشر قد كان عطارا % % 2(@)(@@) % كأنما صبغته وجنتا خجل ، % قد حل عقد سراويل وأزرارا % % 3(@)(@@) % فلو رآه حبيس فوق صومعة ، % لقال : في مثل هذا فادخلوا النارا % % PageV01P498 البحر : طويل 1(@)(@@) % و أشجار نارنج كأنذ ثمارها % % حقاق عقيق قد ملئن من الدر % 2(@)(@@) % مطالعها بين الغصون كأنها % % خخدود عذارى في ملاحفها الخضر % % 3(@)(@@) % أتت كل مشتاق بريا حبيبه ، % فهاجت له الأحزان من حيث لا يدري % % PageV01P499 البحر : بسيط تام 1(@)(@@) % من لامني اليوم في سكر فلا عذرا ، % هات الكبير وغيري فاسق ما صغرا % % 2(@)(@@) % غدت منكرة للمزن فاحتجبت % شمس النهار ولم نعرف لها خبرا % % 3(@)(@@) % حتى اذا ثقلت حملا ، وما بقيت % أرض ببغداد إلا ترتجي مطرا % % 4(@)(@@) % واغرورقت لانسكاب الماء مقلتها ، % جاءت بثلج كورد أبيض نثرا % % PageV01P500 البحر : طويل 1(@)(@@) % و ظاهرة في نصف شهر لمن يرى ، % ولكنها مكتومة آخر الشهر % 2(@)(@@) % تداخل في ليل المحاق بمثله ، % وتضحك عن در وتسقيك من خمر % PageV01P501 البحر : - 1(@)(@@) % يا مسكة العطار ، % و خال وجه النهار % 2(@)(@@) % و لعبة أحكمتها % % عناية النجار % 3(@)(@@) % من آبنوس تسمى % % باليمن بين الجواري % % 4(@)(@@) % و أطيب الناس ريقا % لمغتد ، ولسار % 5(@)(@@) % وليس ذا بعجيب ، % وليس في ذا تماري % % 6(@)(@@) % لا تشرب الخمر إلا % مبزولة من قار % PageV01P502 البحر : منسرح 1(@)(@@) % زفت إلى الروض ، وهو يأملها ، % و جنح ليل كالقار معنكر % 2(@)(@@) % سحابة ، والبروق تحرقها ، % كشاطر بالسماط يعتور % PageV01P503 البحر : بسيط تام 1(@)(@@) % اما ترى النرجس المياس يلحظنا % % ألحاظ ذي فرح بالعتب مسرور % 2(@)(@@) % كأن أحداقها في حسن صورتها ، % مداهن التبر في أوراق كافور % 3(@)(@@) % كأن طل الندى 
ms90	 فيه لمبصره % دمع ترقرق من أجفان مهجور % PageV01P504 البحر : منسرح 1(@)(@@) % مقفرة الربع لج هاجرها % % عامرها موحش وغامرها % % 2(@)(@@) % ينتحب القوم في منازلها % % كأن أوطانها مقابرها % % PageV01P505 البحر : سريع 1(@)(@@) % ما ذقت طعم النوى لو تدري ، % كأن جنبي على جمر % 2(@)(@@) % في قمر مشرق نصفه ، % كأنه محرقة العطر % 3(@)(@@) % فريسة للبق منهوشة ؛ % قد ضعفت كفي عن النصر % PageV01P506 البحر : طويل 1(@)(@@) % عيون كساها الغيث ثوبا من الهوى ، % فأجغانها بيض ، وأحداقها حمر % 2(@)(@@) % إذا شمها المشتاق خال نسيمها % % سحيقا من الكافور شيب به الخمر % PageV01P507 البحر : كامل تام 1(@)(@@) % هذا الحمار من الحمير حمار ، % ناحت عليه حلية وعذار % 2(@)(@@) % فكانما الحركات منه سواكن ، % و كأنما إقباله إدبار % PageV01P508 البحر : مجزوء الوافر 1(@)(@@) % رعى شهرين بالدير % قبابا كالطوامير % 2(@)(@@) % يقبلن إلى الذعر % عيونا كالقوارير % 3(@)(@@) % وآذان سميعات % كأصناف الكوارير % PageV01P509 البحر : كامل تام 1(@)(@@) % يا ليلة نسي الزمان بها % % أحداثه ، كوني بلا فجر % 2(@)(@@) % راح الزمان ببدرها ووشت % فيها الصبا بمواقع القطر % 3(@)(@@) % ثم انقضت ، والفجر يتبعها % % في حيث ما سقطت من الدهر % PageV01P510 البحر : بسيط تام 1(@)(@@) % ومزنة جاد من أجفانها المطر ، % فالروض منتظم ، والقطر منتثر % 2(@)(@@) % ترى مواقعها في الأرض لائحة % مثل الدراهم تبدو ، ثم تستتر % 3(@)(@@) % ما زال يلطم خد الأرض وابلها ، % حتى رقت خدها الغدران والخضر % PageV01P511 البحر : كامل تام 1(@)(@@) % كم قد قطعت إليك من ديمومة ، % نطف المياه بها سواد الناظر % 2(@)(@@) % في ليلة فيها السماء مرزة ، % سوداء ، مظلمة كقلب الكافر % 3(@)(@@) % والبرق يخطف من خلال سحابها % % خطف الفؤاد لموعد من زائر % 4(@)(@@) % والغيث منهل يسح ، كأنه % دمع المودع إثر إلف سائر % PageV01P512 البحر : منسرح 1(@)(@@) % أختان : إحداهما إذا انتحبت % تبكي كباك بدمعة حرى % % 2(@)(@@) % وما بها صبوة ولا حزن ، % تضحك منها لدمعها الأخرى % % PageV01P513 البحر : متقارب تام 1(@)(@@) % وأسود في كف مجدولة % لطيف له خلقة منكره % % 2(@)(@@) % إذا استودعت سرها عنده ، % فأحسن ما فيه أن يظهره % % PageV01P514 البحر : خفيف تام 1(@)(@@) % لم تمت أنت إنما مات من لم % % يبق في المجد والمحامد ذكرا % % 2(@)(@@) % لست مستسقيا لقبرك 
ms91	 غيثا ، % كيف يظما وقد تضمن بحرا % % PageV01P515 البحر : طويل 1(@)(@@) % وغرس من الأحباب غيبت في الثرى ، % و سقته أجفاني بسح وقاطر % 2(@)(@@) % فأثمر هما لا يبد وحسرة % لقلبي تجنيها بأيدي الخواطر % 3(@)(@@) % أيا شعبة النفس التي ليس غيرها ، % سقطت فقد أفردت عودي لكاسر % 4(@)(@@) % ويا دهر هذي فعلة قد فعلتها ، % على مثلها كانت تدور دوائري % % PageV01P516 البحر : مجزوء الرجز 1(@)(@@) % قد أنكرت مشيبا % عمر رأسي واستعر % 2(@)(@@) % يا هند ما شاب قلبي ، % و إنما شاب الشعر % % PageV01P517 البحر : كامل تام 1(@)(@@) % صدت شرير وأزمعت هجري ، % وصغت ضمائرها إلى الغدر % 2(@)(@@) % قالت : كبرت وشبت ، قلت لها : % هذا غبار وقائع الدهر % PageV01P518 البحر : طويل 1(@)(@@) % سأكتم حاجاتي عن الناس كلهم ، % ولكنها لله تبدو وتظهر % 2(@)(@@) % لمن لا يرد السائلين بخيبة ، % ويدنو من الداعي ويعطي فيكثر % PageV01P519 البحر : مجتث 1(@)(@@) % إن حارب الدهر قلبي ، % فقد أعين بنصر % 2(@)(@@) % يا دهر لو كنت حرا ، % لما أمنت لحر % PageV01P520 البحر : طويل 1(@)(@@) % سكنتك يا دنيا برغمي مكرها ، % وما كان لي في ذاك صنع ولا أمر % 2(@)(@@) % و جربت حتى قد قلبتك خبرة ، % فأنت وعاء حشوه الهم والوزر % 3(@)(@@) % فإن أرتحل يوما أدعك ذميمة ، % وما فيك من دعوى غراس ولا بذر % % PageV01P521(@)(@@)(@@)(@@) | (@)(@@) البحر : طويل 1(@)(@@) % أبا حسن ثبت في الأمر وطأة ، % وأدركتني في المعضلات الهزاهز % 2(@)(@@) % و ألبستني درعا علي حصينة ، % فناديت صرف الدهر : هل من مبارز ؟ % PageV01P522 البحر : خفيف تام 1(@)(@@) % أنت من معشر لهم قدم السو % % ء ، وذو السابقات ، والتبريز % 2(@)(@@) % و طريق المجد الذي سار في النا % % س ليجبي أموالهم ويحوز % PageV01P523 البحر : مجزوء الرجز 1(@)(@@) % بليت بعد شيبه ، % بضابط عزيز % 2(@)(@@) % و خده مشوك ، % مزرر التلويز % 3(@)(@@) % كأنه فرنية % كثيرة الشونيز % 4(@)(@@) % للنتف فيه أثر % كأثر التخريز % 5(@)(@@) % وأنفه كسترة % تحشى من الإفريز % 6(@)(@@) % تحسنه ، إذا بدا ، % سماجة النزيز % PageV01P524 البحر : متقارب تام 1(@)(@@) % تشاغل عنا صديق لنا ، % وصارت مودته كزه % 2(@)(@@) % وصار ، إذا جاءنا بالسلا % % م ، في مشيه عاجل القفزه % 3(@)(@@) % و كانت مودته حلوة ، % فصارت مودته مزه % % 4(@)(@@) % و يستر 
ms92	 من خجل وجهه ، % و يمشي ، فيعثر في الرزه % % PageV01P525 البحر : بسيط تام 1(@)(@@) % يا صاح يشغل سمعي ، عن عواذله ، % قرع الكؤوس بأفواه القوازيز % 2(@)(@@) % أصغى بإبريقه من تحت مبزلها ، % حتى تملأ من أحشاء موخوز % 3(@)(@@) % يضاحك الأقحوان الغض في فمه % تفاح خد بخال المسك مغروز % 4(@)(@@) % كأن ديباجة في وجهه نشرت % تطريزة حثها في حسن تطريز % 5(@)(@@) % فنحن منه ، وفي أيامه أبدا % في مهرجان نغاديه ونيروز % 6(@)(@@) % إذ لا يزال من الفتيان ذو طرب ، % يعب من ذهب قد ذاب إبريز % 7(@)(@@) % دام عليه هجير الشمس يسبكه ، % فميز الصفو منه أي تمييز % 8(@)(@@) % تنازع الماء في الأقداح ، إذ مزجت ، % بصارم من سيوف النوم مهزوز % 9(@)(@@) % متى يريد جموحا ، وهي تجذبه ، % هل يستطيع سلاحا غير تبريز % 10(@)(@@) % لا يقعد الشك عزمي عند نهضته ، % وليس رأسي عن حزم بمحجوز % PageV01P526 البحر : رجز تام 1(@)(@@) % لما رأوها ، وعلونا نشزا ، % هز جناحيه إليها هزا % % 2(@)(@@) % كما هززت النيزك المرتزا ، % يحز أعناق الرياح حزا % % 3(@)(@@) % وسامها قبضا ، ونقرا وخزا ، % يطلب في رؤوسهن كنزا % % PageV01P527 البحر : مجتث 1(@)(@@) % يا قوم إني مرزا ، % و كل حر مرزا % % 2(@)(@@) % خرج كثير % نزر فلم لا أعزى % % 3(@)(@@) % فالخرج لا يتناهى ، % و الدخل لا يتجزا % % PageV01P528 البحر : طويل 1(@)(@@) % ألم تر أن الدهر قطعني حزا ، % وأصحبني ذلا ، وأثكلني عزا % % 2(@)(@@) % ألا رب وجه في الثرى كان عابسا ، % إذا خفت بطشا من يد الدهر أو غمزا % % 3(@)(@@) % ملوك وإخوان ترى بسماحهم % % من البشر في ديباج أوجههم طرزا % % 4(@)(@@) % فقدتهم مستكرها ، وكنزتهم % % ثوابا وأجرا في بطون الثرى كنزا % % PageV01P529 (@)(@@)(@@)(@@) | (@)(@@) البحر : طويل 1(@)(@@) % ظللت بحزن ، إن بدا البرق غدوة ، % كما رفع النار البصيرة قابس % 2(@)(@@) % إذا استعجلته الريح حلت نطاقه ، % وهاجت له في المعصرات وساوس % 3(@)(@@) % ولاح كما نشرت بالكف طرة % من البرد أو قاءت جروح قواليس % 4(@)(@@) % و شقق أعراف السحاب التماعة ، % كما انصدعت بالمشرفي القوانس % 5(@)(@@) % فما زال حتى النبت يرفع نفسه % بهام الربى والعرق في الأرض ناخس % 6(@)(@@) % مضى عجبي من كل شيء رأيته ، % و باتت 
ms93	 لعيني الأمور اللوابس % 7(@)(@@) % و إني رأيت الدهر في كل ساعة ، % يسير بنفس المرء ، والمرء جالس % 8(@)(@@) % وتعتاده الآمال حتى تحطه % إلى تربة فيها لهن فرائس % 9(@)(@@) % و أصدع شكي باليقين ، وإنني % % لنفسي على بعض المساءة حابس % PageV01P530 البحر : متقارب تام 1(@)(@@) % زففنا إلى الشام رجراجة ، % تسل على من عصى سيف باس % 2(@)(@@) % وجالت صواهلنا المقربات ، % بأفعال جن وأشباح ناس % 3(@)(@@) % وظلت صوارم أيماننا ، % تحسيهم الموت في غير كاس % 4(@)(@@) % تموت النفوس بأجالها ، % و يقطعن ما بين جسم وراس % PageV01P531 البحر : كامل تام 1(@)(@@) % هل حدثتك النفس فيما قد ترى ، % فلربما صدقت أماني الأنفس % 2(@)(@@) % يسقيك فضلة كأسه من كفه ، % وإذا رأى الرقباء لم يتوجس % 3(@)(@@) % وسنان من خدع النعاس جفونه ، % يحكي بمقلته ذبول النرجس % PageV01P532 البحر : طويل 1(@)(@@) % أرى أعين الأعداء قد فطنت بنا ، % رأوا حسن سوء الظن من كان ذا أنس % 2(@)(@@) % و إن تمنعوا من صورة الجسم صورة ، % ففي النفس تلقى صورة النفس للنفس % PageV01P533 البحر : بسيط تام 1(@)(@@) % يا طول شوقي إلى تسليم مقلته ، % إذا تناول كأسا بين جلاس % 2(@)(@@) % فإن رأى الخوف أو هم الرقيب به ، % يعرفن ألحاظه في لحظة الكاس % PageV01P534 البحر : منسرح 1(@)(@@) % أواه يا سيدي ، فخذ بيدي ، % ولا تدعني ولا تقل تعسا % % 2(@)(@@) % واعطف فإن عدت فاعف ثانية ، % فقد يداوي الطبيب من نكسا % % PageV01P535 البحر : رمل تام 1(@)(@@) % دع نديما تناءى وحبس ، % و اسقني واشرب عقارا كالقبس % 2(@)(@@) % هام قلبي بفتاة غداة ، % حولها الأسياف في أيدي الحرس % 3(@)(@@) % لا تنام الليل من حبي ، وإن % % غرد القمري زارت في الغلس % 4(@)(@@) % وتسميني ، إذا ما عثرت ، % و إذا ما فطنوا قالت : تعس % PageV01P536 البحر : طويل 1(@)(@@) % أقول ، وقد ضاقت بأحزانها نفسي : % ألا رب تطليق قريب من العرس % 2(@)(@@) % لئن صرت للبقال ، يا شر زوجة % فلا عجب ، قد يربض الكلب في الشمس % PageV01P537 البحر : كامل تام 1(@)(@@) % يا دار أين ظباؤك اللعبس ، % قد كان لي في إنسها أنس % 2(@)(@@) % أين البدور على غصون نقا ، % من تحتهن خلاخل خرس % 3(@)(@@) % و مراسل فيهم يجيب 
ms94	 ، وقد % % حنت إلى ميعاده النفس % 4(@)(@@) % و كأنما يسخو بضمته % غصن توقد فوقه الشمس % 5(@)(@@) % قد سرني بالفوطتين دم % بالله أحلف انه رجس % 6(@)(@@) % يا عامر الخلوات كيف ترى ، % لو يستطيع يمجك الرمس % 7(@)(@@) % لله در فتى يعمره ، % لامسه شلل ، ولا نفس % 8(@)(@@) % ما إن بمصر لأهلها نشب ، % إلا وفيه عليهم لبس % 9(@)(@@) % في كل يوم ذر شارقة % في غرس بعضهم له غرس % 10(@)(@@) % فشعارهم بالليل بينهم % دب دبيب النمل إذ يعسو % % PageV01P538 11(@)(@@) % ما إن يفارق عوده أبدا % فرحا ، كأعور ضمه حبس % 12(@)(@@) % يا أهل مصر قرونكم سقطت % من بعده ، فرؤوسكم ملس % PageV01P539 البحر : سريع 1(@)(@@) % لا عذر للعاذل في الكاس ، % فما أرى في الكاس من باس % 2(@)(@@) % ويلي من الناس ومن لومهم % % ما لقي الناس من الناس % 3(@)(@@) % مهفهف الخصر هضيم الحشا ، % مشوق بالوعد مكاس % 4(@)(@@) % و قام ، في العاتق منديله ، % يدير كأسا بين جلاس % % 5(@)(@@) % و يدخل الآذان من أمسه ، % من تحت إكليل من الآس % 6(@)(@@) % وشمر الذيل إلى خصره ، % و حثنا بالرطل والكاس % 7(@)(@@) % وطالما عذبني هجره ، % ووكل القلب بوسواس % 8(@)(@@) % لمكا اتتني رسله بالرضا ، % أنسيت ما مر على راسي % % 9(@)(@@) % و لم أزل ، والليل ستر لنا ، % من دون رقاب وحراس % 10(@)(@@) % أشكو إلى غمزة عينيه ما % % قاسيته من قلبه القاسي % % PageV01P540 11(@)(@@) % في ليلة ما مثلها ليلة ، % لست لها ما عشت بالناسي % % PageV01P541 البحر : - 1(@)(@@) % إشرب بكأس من كف طاووس ، % مدلل في النعيم مغموس % 2(@)(@@) % طال وقوفي عليه منتظرا % لموعد في المطال محبوس % 3(@)(@@) % ما في يدي منه غير عض يدي ، % ورب بخت في الحب منحوس % 4(@)(@@) % لم تخل في خصره مناطقه ، % من جذب سيف وحمل دبوس % 5(@)(@@) % ظبي يرى طرفه فيرجمه ، % و هو سوى ذاك ليث عريس % 6(@)(@@) % لا يطمع الصب فيه في درك ، % و لو حباه بعرش بلقيس % 7(@)(@@) % يا رب عجل مما ترى فرجي ، % و اقض لكربي منه بتنفس % 8(@)(@@) % و كم ، وحتى أهيم من ولة ، % كذي جنون الخبال ممسوس % PageV01P542 البحر : كامل تام 1(@)(@@) % يا حسن 
ms95	 أحمد غاديا أمس ، % بمدامة صفراء كالورس % 2(@)(@@) % و الصبح حي في مشارقه ، % والليل يلفظ خر النفس % 3(@)(@@) % فكأن كفيه تقسم في % % أقداحنا قطعا من الشمس % PageV01P543 البحر : منسرح 1(@)(@@) % لا تبك للظاعنين والعيس ، % و منزل ظل غير مأنوس % 2(@)(@@) % واشرب عقارا قد عتقت حقبا % من عهد عاد بالوعد محروس % 3(@)(@@) % تخرج من دنها ، وقد حدبت % مثل هلال بدا بتقويس % 4(@)(@@) % زفت إلينا من بيت دسكرة ، % و شيعتها جنود إبليس % 5(@)(@@) % فلم يزل ينزف المدامة من % % منتبذ بالزال منخوس % 6(@)(@@) % كالنجم قد لج في الغروب وقد % % أنذر بالصبح قرع ناقوس % 7(@)(@@) % وضج في الدير كل مبتهج ، % مشفع ليله بتقديس % 8(@)(@@) % يقول يا من يبغي الكنوز إلى % % رزين تبر في الدن مرموس % 9(@)(@@) % تصبح غنيا من السرور ، ومن % % عقلك تسمي من المفاليس % 10(@)(@@) % من رام في تركي المدام كمن % % يكتب بالماء في القراطيس % PageV01P544 البحر : طويل 1(@)(@@) % ألا ايها الخمار هات بما ترى % % مسامحة ، لا بارك الله في المكس % 2(@)(@@) % إذا ما خمار السكر يذكرني غدا ، % فلا حبذا يومي ولهفي على أمسي % % PageV01P545 البحر : خفيف تام 1(@)(@@) % راض نفسي ، حتى ترضيت ، إبلي % % س ، قديما قد طاوعته النفوس % 2(@)(@@) % كم أردت التقى ، فما تركتني % % خندريس يدريها طاووس % 3(@)(@@) % أسكنوها في الدن من عهد نوح % كظلام ، فيه نهار حبيس % 4(@)(@@) % يخرج العلج خيرها ، وتعاني % % في ظلال كما تصان العروس % 5(@)(@@) % و هي عندي لا ذا ، ولا ذا ، وهذا ، % هي سعد قد فارقته النحوس % 6(@)(@@) % أي حسن تخفي الدنان من الرا % % ح ، وحسن تبديه منها الكؤوس % 7(@)(@@) % يا نديمي أسقياني ، فقد لا % % ح صباح وأذن الناقوس % 8(@)(@@) % من كميت ، كأنها أرض تبر ، % نواحيه لؤلؤ مغروس % 9(@)(@@) % ضحكت شر ، إذ رأتني قد شب % % ت وقالت قد فضض الآبنوس % 10(@)(@@) % قلت إن الشباب في لباق ، % بعد ، قالت : هذا شباب لبيس % PageV01P546 11(@)(@@) % قد تمتعت ما كفاني إذ رب % % ي من اللهو والصبا مأنوس % 12(@)(@@) % وفؤادي مثل القناة من الخ % % ط ، وخدي من لحيتي مكنوس % PageV01P547 البحر : طويل 1(@)(@@) % وعاقد زنار على غصن 
ms96	 الآس ، % رقيق المعاني مخطف الكشح مياس % 2(@)(@@) % سقاني عقارا صب فيها مزاجها ، % فأضحك عن ثغر الحباب فم الكاس % PageV01P548 البحر : طويل 1(@)(@@) % غدوت على حال ورحت إلى الكاس ، % ولم أر فيما تشتهي النفس من باس % 2(@)(@@) % و مشتبه بالبدر في أعين الورى ، % من الناس ، إلا أنه أملح الناس % 3(@)(@@) % سقاني خمرا من يديه وريقه ، % فأسكرني سكرين من دون جلاسي % % 4(@)(@@) % إذا جاد لي عند الخلاص بقبلة ، % وجدت بها بردا على حر أنفاسي % % 5(@)(@@) % فكم من نديم لي نديم إلى الكرى ، % وكم من نديم قد سبقت إلى الكاس % PageV01P549 البحر : رجز تام 1(@)(@@) % و قهوة صفراء مثل الورس ، % قد حبست في الدن أي حبس % 2(@)(@@) % أصبح أسقى كأسها وأمسي % % في قمر كأنه ابن شمس % 3(@)(@@) % يومي منها أبدا كأمسي % . . . . . . . . . . . . . . . . % PageV01P550 البحر : منسرح 1(@)(@@) % إشرب ، فقد دارت الكؤوس ، % وفارقت يومك النحوس % 2(@)(@@) % في كل يوم جديد روض ، % عليه دمع الندى حبيس % 3(@)(@@) % و مأتم في السماء يبكي ، % والأرض من تحته عروس % PageV01P551 البحر : طويل 1(@)(@@) % سلام على غير الديار البسابس ، % و دمنة ربع قد تغير داريس % 2(@)(@@) % وهبت سلامي ، ما حييت ، لمجلس ، % على قصر بسطام أمير المجالس % 3(@)(@@) % مطل على روض أنيق ، كأنه % مقادم خضر فوق فرش عرائس % 4(@)(@@) % و كم فيه من قمري عود مغرد ، % و من كارع في كأسه غير حابس % 5(@)(@@) % و كم فيه من حي مليح مراسل % بعينيه ، فيما شئت ، غير مماكس % 6(@)(@@) % جريء على رقابه ، وغيوره ، % ضحوك إلى أحبابه غير عابس % 7(@)(@@) % تزودت منه نظرة لي مطيعة ، % أراحت فؤادي من حديث الوساوس % 8(@)(@@) % يدير علينا قهوة بابلية ، % أدام عليها الحزن دهقان فارس % 9(@)(@@) % إذا غربت من دنها استبدلت به % قميص زجاج من جميع الملابس % 10(@)(@@) % صفت فبكى ، والطرف لا يسبينها ، % ويرجع محسورا بخيبة آيس % PageV01P552 11(@)(@@) % و ما نال منها ، فهو منه كمدع % حقائق أمر غامس بالنفائس % PageV01P553 البحر : وافر تام 1(@)(@@) % ومعتل المواعد ذي مكاس ، % ملي بالتأبي والشماس % 2(@)(@@) % ينادي في الهوى قلبا جبانا ، % ترجح بين إطماع وياس % 3(@)(@@) % لنا في وجهه 
ms97	 بستان حسن ، % مباح للعيون ، بلا مساس % 4(@)(@@) % سسقاني الراح من يده هجيرا ، % وفي أجفانه مر النعاس % 5(@)(@@) % ويسراه مقرطقة بكوز ، % ويمناه متوجة بكاس % PageV01P554 البحر : كامل تام 1(@)(@@) % كم ليلة محمودة أحييتها ، % جاءت بأسعد طائر لم ينحس % 2(@)(@@) % بيضاء مقمرة لقيها صبحها ، % و ثيابها في ظلمة لم تدنس % 3(@)(@@) % وتوقد المريخ بين نجومها ، % كبهارة في روضة من نرجس % 4(@)(@@) % كملت وتم نعيمها وسرورها ، % بأحب زائرة وأطيب مجلس % 5(@)(@@) % ما أنصف الندمان كأس مدامها ، % ضحكت عليه فشمسها بتعبس % PageV01P555 البحر : رجز تام 1(@)(@@) % قد أغتدي قبل غدو بغلس ، % وللرياض في دجى الليل نفس % 2(@)(@@) % حتى إذا النجم بدا لي بالقبس ، % قام الجواد في ظلام قد جلس % 3(@)(@@) % يلاحق الوثبة ممتد النفس ، % محملج ممر آمرار المرس % 4(@)(@@) % نعم الرديف رابنا قوس الفرس ، % ينفي القذى عن مقلة فيها شوس % PageV01P556 البحر : كامل تام 1(@)(@@) % بيضاء إن لبست بياضا خلتها % % كالياسمين منضدا في مجلس % 2(@)(@@) % وإذا بدت في حمرة ، فكأنها % % ورد من الداري حسنا مكتسي % % 3(@)(@@) % وإذا بدت في صفرة ، فكأنها % % نسرين بستان كريم المغرس % 4(@)(@@) % وإذا بدت في خضرة في صفرة ، % فكأنها للحسن باقة نرجس % PageV01P557 البحر : سريع 1(@)(@@) % انظر إلى حسن هلال بدا % % يهتك من أنواره الحندسا % % 2(@)(@@) % كمنجل قد صيغ من فضة % يحصد من زهر الدجى نرجسا % % PageV01P558 البحر : وافر تام 1(@)(@@) % فنيت سوى حشاشات ترقى ، % و خلفت الحياة على أناس % 2(@)(@@) % و أدنى مجلس العواد مني % % سقام ظل يخبرهم بباسي % % PageV01P559 البحر : مجزوء الكامل 1(@)(@@) % يا دهر كيف شفعت نفسا ، % فخلست فيها النفس خلسا % % 2(@)(@@) % وتركت نفسا للأسى ، % جعل البقاء عليه نحسا % % 3(@)(@@) % سقيا لوجه حبيبة % أودعتها كفنا ورمسا % % PageV01P560 البحر : رجز تام 1(@)(@@) % ذمك بيا دنياي مدح نفسي ، % أقللت زادي وأطلت حبسي % % 2(@)(@@) % غدا أماني ، ويأسي أمسي ، % و اليوم من مآتم وعرس % 3(@)(@@) % لا أفقد الوحشة عند الأنس ، % طوبى لنا وتحت ترب الرمس % PageV01P561 البحر : طويل 1(@)(@@) % ومازال أخذ الموت أهلي وجيرتي ، % يحدث عني أن سيأتي على نفسي % % 2(@)(@@) % فقد صرت محمولا على الموت مكرها ، % وإن حثت 
ms98	 الكاسات طال لها حبسي % % PageV01P562 البحر : سريع 1(@)(@@) % أشهى من القهوة والكاس ، % على نسيم الورد والآس % 2(@)(@@) % و من كحيل العين مياس ، % من جاد بالفقر على ياس % 3(@)(@@) % برغم حجاب وحراس ، % صيانة الوجه عن الناس % PageV01P563 (@)(@@)(@@)(@@) | (@)(@@) البحر : كامل تام 1(@)(@@) % عذر الهوى ، عند العذول ، رشا ، % فاليوم حبي فيه حين نشا % % 2(@)(@@) % شق الظلام البدر ، حين بدا ، % واهتز غصن البان حين مشى % % 3(@)(@@) % يسقيك ، من خمر بمقلته ، % كأسا يزيدك شربه عطشا % % 4(@)(@@) % عجل الرقيب بلحظ عاشقه ، % أو دام في وجناته خدشا % % 5(@)(@@) % أدرجت في الأحشاء فتنته ، % فسعى البكاء بسرها ، ووشى % % 6(@)(@@) % يا ناصر الإسلام ، إذ خذلت % دعواته فابتل وانتعشا % % 7(@)(@@) % لما استغاث ، وقل ناصره ، % لبيته ، وسعيت منكمشا % % 8(@)(@@) % كالليث لا تبقي مخالبه % يدا لجارحة إذا بطشا % % 9(@)(@@) % بسط الخميس بكفه ذكر ، % عضب ، كأن يمينه نمشا % % PageV01P564 البحر : متقارب تام 1(@)(@@) % أيا من يحاربني غدره ، % ويبعث للهم نحوي جيوشا % 2(@)(@@) % هجرت ، فمت ، أيا سيدي ، % أتأذن بالوصل لي أن أعيشا ؟ % PageV01P565 البحر : طويل 1(@)(@@) % أبا طيب خبرت أنك بعدنا ، % وقفت على القشاش ، فيما يقشش % % 2(@)(@@) % عجوز كأن الشيب تحت قناعها ، % على الرأس والأكتاف ، قطن منفش % 3(@)(@@) % خبيثة ريح الريق تحسب هدهدا % يبيض بفيها ثاويا ويعشش % 4(@)(@@) % وما زلت حتى صادك اليوم عندها ، % فكم صامت منهم وآخر يبطش % 5(@)(@@) % وكم قائل : هذا النميري ، فأقبلوا ، % وكم قائل : هذا النبي المجمش % 6(@)(@@) % وقد نصحوا من قبل ذلك زوجها ، % فقال لهم : وجه المحرش أحرش % PageV01P566 البحر : كامل تام 1(@)(@@) % قد أغتدي في صبح ليل فاش ، % بنيرج رهب ملب ناش % 2(@)(@@) % معلم ، منخر ، فشاش ، % يسائل الأرض عن المعاش % 3(@)(@@) % ملتقط للكلإ المنحاش ، % كلقطك المشيب بالمقاش % 4(@)(@@) % أمير كل طائر وماش ، % من أكلب يطرن كالفراش % 5(@)(@@) % فهم إلى أشارس عطاش ، % تصان للصيد عن الهراش % PageV01P567 البحر : رجز تام 1(@)(@@) % قم صاحبي نغدو لجيش الوحش ، % بضاريات من بزاة برش % 2(@)(@@) % كأنما نقطها موشي ، % ونيرجات ضمر تستنشي % % 3(@)(@@) % و وابل في العدو غير طش ، % ما استأثرت من دوننا بخدش % 4(@)(@@) % لصيدها ، وهي شداد البطش ، % فقام نحوها بوجه 
ms99	 بش % 5(@)(@@) % كمثل دينار جديد النقش ، % و استبدل السرج بلين الفرش % 6(@)(@@) % لما رأى في الليل فجرا يمشي ، % فكم كناس قد خلا وعش % 7(@)(@@) % و قهوة صرف بغير غش ، % تفس قفل الهم أي فش % 8(@)(@@) % شربتها تحت ندى ورش ، % في ليلة ذات نجوم عمش % PageV01P568 البحر : متقارب تام 1(@)(@@) % و بئر شربنا بها عذبة ، % وطفل النبات بها منتعش % 2(@)(@@) % فتقت بها جيب كافورة % من الأرض جدولها منتقش % 3(@)(@@) % يمزق ريا جلود الثما % % ر إذا مص ماء الثمار العطش % 4(@)(@@) % كفيل لأشجارها بالحياة ، % أذا ما جرى خلته يرتعش % PageV01P569 (@)(@@)(@@)(@@) | (@)(@@) البحر : كامل تام 1(@)(@@) % ما غر من تسري عقاربه ، % من أسد غيل ترقب الفرصا ؟ % 2(@)(@@) % وكتيبة دفاء من أسل ، % قد ألبسوها من دم قمصا % % 3(@)(@@) % صبر لريب زمانهم صمت الشك % % وى إذا ما عض أو قرصا % % 4(@)(@@) % والهاجعين على سروجهم ، % خفقا يذيقهم الكرى نغصا % % 5(@)(@@) % متوقدين من الحديد ، إذا % % ما صارموا بأس العدى نكصا % % PageV01P570 البحر : كامل تام 1(@)(@@) % هاتيك دار الملك مقفرة ، % ما إن بها من أهلها شخص % 2(@)(@@) % عهدي بها ، والخيل جائلة % لا يستبين لشمسها قرص % 3(@)(@@) % و إذا علت صخرا حوافرها ، % غادرنه وكأنه دعص % 4(@)(@@) % والملك منشور الجناح ، ولم % % يهتك قوادم ريشه القص % 5(@)(@@) % ينشق منه الجمع عن قمر ، % ما في تكامل حسنه نقص % 6(@)(@@) % أخذت يداه الملك ممتليا % حزما ، وعود شبابه رخص % 7(@)(@@) % و معاشر وجدوا مشيئتهم ، % و بما تحب نفوسهم خصوا % % 8(@)(@@) % طيب التحية حيث قمت لهم ، % فهم الألى حيوك ، واختصوا % % 9(@)(@@) % فمض بذاك العيش آخره ، % و الهم مما سر مقتص % 10(@)(@@) % والدهر يخبط أهله بيد ، % في كل جارحة له قرص % PageV01P571 11(@)(@@) % أفما ترى بلدا أقمت به % أعلى مساكن أهله خص % 12(@)(@@) % وولاته نبط زنادقة ، % ملأى البطون ، وأهلها خمص % 13(@)(@@) % و لهم مسالخ يسلخون بها ، % لا يتقي سطواتها اللص % 14(@)(@@) % أسيافها خشب معلقة ، % مصنوعة ، وقرابها جص % 15(@)(@@) % و جنودهم تحمي رعيتهم ، % و لهم على أكبادهم رقص % 16(@)(@@) % غلبت خيانتهم أمانتهم ، % وطغى على تقواهم الحرص % 17(@)(@@) % فتيانهم في كل رابية ، % و 
ms100	 لهم بكل قرارة شخص % 18(@)(@@) % و أميرهم متقدم بهم % نحو الحرام ، وسيره نص % 19(@)(@@) % وإذا بدا أفدي الزمان به ، % وسط الخميس ، كأنه دلص % 20(@)(@@) % و كأن خل الخمر يعصر من % % وجناته ، أو يجتنى العفص % PageV01P572 21(@)(@@) % فترى الأنام كهامة حلقت ، % تعدي مفارقها . . . تخص % 22(@)(@@) % و يرون رخص السعر أغبط في ال % % بلوى ، وليس بدرهم رخص % PageV01P573 البحر : طويل 1(@)(@@) % ونقبت عرسي بالطلاق مصمما ، % وكانت حصاة بين رجلي وأخمصي % % 2(@)(@@) % فأبهت عذالي ، وفات الذي مضى ، % و هنيت عيشا بعد عيش منغص % PageV01P574 البحر : كامل تام 1(@)(@@) % يا سارق الأنوار من شمس الضحى ، % يا مثكلي طيب الكرى ومنغصي % % 2(@)(@@) % أما ضياء الشمس فيك ، فناقص ، % و أرى حرارتها بها لم تنقص % 3(@)(@@) % لم يظفر التشبيه منك بطائل ، % متسلخ بهقا كلون الأبرص % PageV01P575(@)(@@)(@@)(@@) | البحر : بسيط تام 1(@)(@@) % قالوا اعتللت ، فسل عني وعن خبري ، % ألم أبت باكيا ، لا أطعم الغمضا % % 2(@)(@@) % قولوا لمكتوم : يا سمعي ويا بصري ، % علمت جسمي من أجفانك المرضا % % PageV01P576 البحر : كامل تام 1(@)(@@) % يا ظبية الميدان ، واحربا ، % من سحر أجفان تمرضها % % 2(@)(@@) % تفديك نفس أنت فتنتها ، % لاشك أنك سوف تقبضها % % 3(@)(@@) % طوبى لطرف ظل مكتحلا % بغبار خيلك حين تركضها % % 4(@)(@@) % تحكي حوافرها ، إذا وقعت ، % حرقا على قلبي ترضضها % % PageV01P577 البحر : مجزوء الرجز 1(@)(@@) % ولي وكيل كيس ، % ما شاء من أمر قضي % % 2(@)(@@) % غازل خصمي ساعة ، % وضمه حتى رضي % % PageV01P578 البحر : منسرح 1(@)(@@) % لا عيش إلا بكف ساقية ، % ذات دلال في طرفها مرض % 2(@)(@@) % كأن في الراح ، حين تمزجها ، % نجوم در تهوي وتنخفض % PageV01P579 البحر : رجز تام 1(@)(@@) % قد أغتدي ، والليل قد تقضى % % بزورق أرخى به وانفضا % % 2(@)(@@) % لما حملناه أراد الفرضا ، % انلن بعضا ، ومنعن بعضا % % 3(@)(@@) % يركض في جو السماء ركضا % % بخافقين ينقضان نقضا % % 4(@)(@@) % كما رأيت الكوكب المنقضا ، % فأطعم القوم شواء غضا % % PageV01P580 البحر : طويل 1(@)(@@) % و مما شجاني بارق لاح موهنا ، % فأكفا إناء الدمع واستلب الغمضا % % 2(@)(@@) % كأن الملاء البيض في يد ناشر ، % على الأفق الغربي ينفضها نفضا % % 3(@)(@@) % رنوت إليه من بعيد بنظرة % رسول قلب لم يطق 