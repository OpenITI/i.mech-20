ms41	 تعاور المنديلا % % 69(@)(@@) % وإذا قريش أوقدت نيرانها % % وثنت ضغائن بينها وذحولا % 70(@)(@@) % فأبوك سيدها ، وأنت أميرها % % وأشدها عند العزائم جولا % PageV01P169 71(@)(@@) % إن السعاة عصوك حين بعثتهم % وأتوا دواعي لو علمت وغولا % 72(@)(@@) % إن الذين أمرتهم أن يعدلوا % % لم يفعلوا مما أمرت فتيلا % % 73(@)(@@) % أخذوا العريف فقطعوا حيزومه % بالأصبحية قائما مغلولا % 74(@)(@@) % حتى إذا لم يتركوا لعظامه % % لحما ولا لفؤاده معقولا % % 75(@)(@@) % نسي الأمانة من مخافة لقح % شمس تركن بضبعه مجزولا % 76(@)(@@) % كتب الدهيم وما تجمع حولها % % ظلما فجاء بعدلها معدولا % 77(@)(@@) % وغدوا بصكهم وأحدب أسأرت % منه السياط يراعة إجفيلا % % 78(@)(@@) % من عامل منهم إذا غيبته % غالى يريد خيانة وغلولا % % 79(@)(@@) % خرب الأمانة لو أحطت بفعله % لتركت منه طابقا مفصولا % 80(@)(@@) % كتبا تركن غنينا ذا خلة % بعد الغنى ، وفقيرنا مهزولا % % PageV01P170 81(@)(@@) % أخذوا حمولته فأصبح قاعدا % لا يستطيع عن الديار حويلا % % 82(@)(@@) % يدعو أمير المؤمنين ودونه % خرق تجر به الرياح ذيولا % % 83(@)(@@) % كهداهد كسر الرماة جناحه % يدعو بقارعة الطريق هديلا % % 84(@)(@@) % وقع الربيع وقد تقارب خطوه % ورأى بعقوته أزل نسولا % 85(@)(@@) % متوضح الأقراب فيه شهبة % نهش اليدين تخاله مشكولا % 86(@)(@@) % كدخان مرتجل بأعلى تلعة % غرثان ضرم عرفجا مبلولا % 87(@)(@@) % ولئن سلمت لأدعون بطعنة % تدع الفرائض بالشريف قليلا % % 88(@)(@@) % وأرى الذي يدع المطامع للتقى % % منا أتى خلقا بذاك جميلا % % 89(@)(@@) % بنيت مرافقهن فوق مزلة % لا يستطيع بها القراد مقيلا % % 90(@)(@@) % وأتاهم يحيى فشد عليهم % عقدا يراه المسلمون ثقيلا % PageV01P171 91(@)(@@) % وتركت قومي يقسمون أمورهم % أإليك أم يتلبثون قليلا % 92(@)(@@) % أخذوا المخاض من الفصيل غلبة % ظلما ويكتب للأمير أفيلا % % PageV01P172 البحر : وافر تام 1(@)(@@) % ومن يك باديا ويكن أخاه % أبا الضحاك ينتسج الشمالا % % 2(@)(@@) % سيكفيك المرحل ذو ثمان % سحيل تغزلين له الجفالا % 3(@)(@@) % سيكفيك الإله ومسنمات % كجندل لبن تطرد الصلالا % % 4(@)(@@) % بنات لبونه عثج إليه % يسفن الليت منه والقذالا % % 5(@)(@@) % لها سلف يعوذ بكل ريع % حمى الحوزات واشتهر الإفالا % % 6(@)(@@) % خراخر تحسب الصقعي حتى % % يظل يقر الراعي سجالا % % 7(@)(@@) % إذا غزر المحالب أتأقته % يمج على مناكبه 
ms42	 الثمالا % % 8(@)(@@) % فلما جاوز الربلات منها % % إلى الكاذات بات بها وقالا % % 9(@)(@@) % ترعى من جنوب ثعالبات % أسرة عازب نحر الهلالا % 10(@)(@@) % إليكم لا نكون لكم خلاة % ولا نكع النقاوى إذ أحالا % % PageV01P173 البحر : كامل تام 1(@)(@@) % صدقت معية نفسه فترحلا % ورأى اليقين ولم يجد متعللا % 2(@)(@@) % وقضى لبانته معية منكم % ورأى عزيمة أمره أن يفعلا % 3(@)(@@) % ورأى أبا حسان دون عطائه % فتبينته العين أسمر مقفلا % % 4(@)(@@) % فشرى حريبته بكل طوالة % دهماء سابغة توفي المكيلا % % 5(@)(@@) % وغدا من الأرض التي لم يرضها % % واختار ورثانا عليها منزلا % 6(@)(@@) % فطوى الجبال على رحالة بازل % لا يشتكي أبدا بخف جندلا % 7(@)(@@) % تغتال كل تنوفة عرضت لها % % بتقاذف يدع الجديل موصلا % 8(@)(@@) % بجنوب لينة ما تزال براكب % تذري مناسمها بهن الحنظلا % % 9(@)(@@) % تدع الفراخ الزغب في آثارها % % من بين مكسور الجناح وأقزلا % % 10(@)(@@) % نح الحناجر ما يكاد يقيمها % % تدع القعود من التصرف أجزلا % % PageV01P174 11(@)(@@) % آلى إذا بلغت مدافع تلعة % وعلا ليبلغها المكان الأطولا % 12(@)(@@) % وكأنهن أشاء يثرب حولها % % جرف أضر بهن نهي بهلا % % 13(@)(@@) % وكأن جزية تاجر وهبت له % يوما إذا استقبلن غيثا مبقلا % 14(@)(@@) % وترى أوابيها بكل قرارة % يكرفن شقشقة ونابا أعصلا % 15(@)(@@) % وإذا سمعن هدير أكلف محنق % عدلت سوالفها إذا ما جلجلا % % 16(@)(@@) % فالعبد قد أعنتن أسفل ساقه % وعدلن ركبته سواها معدلا % 17(@)(@@) % فتركنه حلق الأديم مكسرا % % كالمسح ألقي ما يحرك مفصلا % % 18(@)(@@) % دسم الثياب كأن فروة رأسه % زرعت فأنبت جانبها فلفلا % % 19(@)(@@) % لا يسمع الحبشي وسط عراكها % % صوتا إذا ما العبد أورد منهلا % 20(@)(@@) % إلا تجاوبهن حول سواده % بحناجر نح وشدق أهدلا % % PageV01P175 21(@)(@@) % ولقد ترى الحبشي وهو يصكها % % أشرا إذا ما نال يوما مأكلا % 22(@)(@@) % يرمد من حذر الخلاط كما ازدهت % ريح يمانية ظليما مجفلا % % 23(@)(@@) % لا خير في طول الإقامة للفتى % % إلا إذا ما لم يجد متحولا % % PageV01P176 البحر : بسيط تام 1(@)(@@) % قافية الميممن كل بذاء في البردين يشغلها % % عن مهنة الحي ترحيل وعلام % PageV01P177 البحر : وافر تام 1(@)(@@) % أرى إبلي تكالأ راعياها % % مخافة 
ms43	 جارها طبق النجوم % 2(@)(@@) % وقد جاورتهم فرأيت سعدا % شعاع الأمر عازبة الحلوم % 3(@)(@@) % معاتيم القرى سرف إذا ما % % أجنت طخية الليل البهيم % 4(@)(@@) % فأمي أرض قومك إن سعدا % % تحملت المخازي عن تميم % PageV01P178 البحر : بسيط تام 1(@)(@@) % إني نذير التي ألقت منيئتها % % على القعود وحفتها بأهدام % 2(@)(@@) % من المهيبات مخضرا مغابنها % % لم تثقب الجمر كفاها بأهضام % PageV01P179 البحر : طويل 1(@)(@@) % فإن كنت يا ابن السمط سالمت دوننا % % وقيس أبو ليلى فلما نسالم % 2(@)(@@) % وإن كنتما أعطيتما القوم موثقا % % فلا تغدرا واستسمعا للمراجم % 3(@)(@@) % فإني زعيم أن أقول قصيدة % مبينة كالنقب بين المخارم % 4(@)(@@) % خفيفة أعجاز المطي ثقيلة % على قرنها نزالة بالمواسم % 5(@)(@@) % ومغتصب من رهط ضبعان يشتكي % % إلى القوم أعضاد المطي الرواسم % 6(@)(@@) % تجول به عيرانة عند غرزها % % جنيب أقادته جريرة جارم % 7(@)(@@) % إذا ما اشتكى ظلم العشيرة عضه % حناك وقراص شديد الشكائم % 8(@)(@@) % وللحق فينا خصلتان فمنهما % % ذلول وأخرى صعبة للمظالم % 9(@)(@@) % وإنا لقوم نشتري بنفوسنا % % ديار المنايا رغبة في المكارم % 10(@)(@@) % جزى الله مولانا غنيا ملامة % شرار موالي عامر في العزائم % PageV01P180 11(@)(@@) % بكى خشرم لما رأى ذا معارك % أتى دونه والهضب هضب البهائم % 12(@)(@@) % لها بدن عاس ونار كريمة % بمكتفل الآري بين الصرائم % 13(@)(@@) % ضعاف القوى ليسوا كمن يبتني العلا % % جعاسيس قصارون دون المكارم % PageV01P181 البحر : طويل 1(@)(@@) % أثم غدوت بعد ذاك تلومني % % فسائل ذوي الأحلام من كان ألوما % % PageV01P182 البحر : طويل 1(@)(@@) % أشاقتك آيات أبان قديمها % % كما بينت كاف تلوح وميمها % % 2(@)(@@) % ومستنبح تهوي مساقط رأسه % على الرحل في طخياء طلس نجومها % % 3(@)(@@) % رفعت له مشبوبة عصفت لها % % صبا تعتقيها تارة وتقيمها % % 4(@)(@@) % فكبر للرؤيا وهاش فؤاده % وبشر نفسا كان قبل يلومها % % 5(@)(@@) % ولم يسكنوها الجر حتى أظلها % % سحاب من العوا تثوب غيومها % % 6(@)(@@) % وبات بثدييها الرضيع كانه % قذى حبلته عينها لا ينيمها % % 7(@)(@@) % وكانت جديرا أن يقسم لحمها % % إذا ظل بين المنزلين شكيمها % % 8(@)(@@) % فبات شريكا في ركود مدامة % يميت المحال أزها ونهيمها % % 9(@)(@@) % أتت دونها الأحلاف أحلاف مذحج % وأفناء 
ms44	 كعب حشوها وصميمها % % 10(@)(@@) % . . . . . . . . . . . . . . . . . . . % أدر النسا كيلا تدر عتومها % % PageV01P183 البحر : بسيط تام 1(@)(@@) % فلا يكونن موعودا وأيت به % دينا يعود إلى مطل وليان % 2(@)(@@) % واعلم بأن نجاح الوعد منزلة % جليلة القدر عند الإنس والجان % 3(@)(@@) % لا أنهئ الأمر إلا ريث أنضجه % ولا أكلف عجز الأمر أعواني % % 4(@)(@@) % ثم انصرفت وظل الحلم يعذلني % % قد طال ما قادني جهلي وعناني % % 5(@)(@@) % كأنها ناشط لاح البروق له % من نحو أرض تربته وأوطاني % % 6(@)(@@) % حتى غدا خرصا طلا فرائصه % يرعى شقائق من علقى وبركان % 7(@)(@@) % يعلو الظواهر فردا لا أليف له % مشي البطرك عليه ريط كتان % 8(@)(@@) % بني أمية إن الله ملحقكم % عما قليل بعثمان بن عفان % PageV01P184 البحر : وافر تام 1(@)(@@) % أعبد الله للبرق اليماني % % يضيء حبي ذي سقطين داني % % 2(@)(@@) % تناهى المزن واسترخت عراه % ببرقة ماسل ذات الأفان % PageV01P185 البحر : وافر تام 1(@)(@@) % أبت آيات حبى أن تبينا % % لنا خبرا فأبكين الحزينا % % 2(@)(@@) % وكيف سؤالنا عرصات ربع % تركن بقفرة حتى بلينا % % 3(@)(@@) % وأحجارا من الصوان سفعا % % بهن بقية مما صلينا % % 4(@)(@@) % عرفناها منازل آل حبى % % فلم نملك من الطرب العيونا % % 5(@)(@@) % تراوحها رواعد كل هيج % وأرواح أطلن بها حنينا % % 6(@)(@@) % بدارة مكمن ساقت إليها % % رياح الصيف أرآما وعينا % % 7(@)(@@) % حفرن عروقها حتى أجنت % مقاتلها وأضحين القرونا % % 8(@)(@@) % كناس تنوفة ظلت إليه % هجان الوحش حارنة حرونا % % 9(@)(@@) % يقلن بعاسمين وذات رمح % إذا حان المقيل ويرتعينا % % 10(@)(@@) % كأن بكل رابية وهجل % من الكتان أبلاقا بنينا % % PageV01P186 11(@)(@@) % ونار وديقة في يوم هيج % من الشعرى نصبت لها الجبينا % % 12(@)(@@) % إذا معزاء هاجرة أرنت % جنادبها وكان العيس جونا % % 13(@)(@@) % وعارية المحاسر أم وحش % ترى قطع السمام بها عزينا % % 14(@)(@@) % نصبت بها روائي فوق شعث % بموماة يظنون الظنونا % % 15(@)(@@) % إلى أقتاد راحلتي فظلت % تنازعه الأعاصير الوضينا % % 16(@)(@@) % ونحن لدى دفوف مغورات % نقيس على الحصى نطفا بقينا % % 17(@)(@@) % قليلا ثم طرنا فوق خوص % يلاعبن الأزمة والبرينا % % 18(@)(@@) % مضبرة مرافقهن فتل % نواعب بالرؤوس إذا حدينا % % 19(@)(@@) % إذا الحاجات كن وراء خمس % من 
ms45	 الموماة كن بها سفينا % % 20(@)(@@) % وماء تصبح الفضلات منه % كخمر براق قد فرط الأجونا % % PageV01P187 21(@)(@@) % وردت مديه فطردت عنه % سواكن قد تمكن الحضونا % % 22(@)(@@) % بصفنة راكب وموصلات % جمعت الرث منها والمتينا % % 23(@)(@@) % ومصنعة هنيد أعنت فيها % % على لذاتها الثمل المنينا % % 24(@)(@@) % ونازعني بها ندمان صدق % شواء الطير والعنب الحقينا % % 25(@)(@@) % وطنبور أجش وريح ضغث % من الريحان يتبع الشؤونا % % 26(@)(@@) % وعيش صالح قد عشت فيه % لو أن عماد ظلته يقينا % % 27(@)(@@) % وأظعان طلبت بذات لوث % يزيد رسيمها سرعا ولينا % % 28(@)(@@) % من العيدي تحملني ورحلي % % وتحملها ملاطس ما يقينا % % 29(@)(@@) % إذا خفقت مشافرها وظلت % بسيرتها مصانعة ذقونا % % 30(@)(@@) % عقيلة أينق أغدو عليها % % إذا حاجات قوم يعترينا % % PageV01P188 31(@)(@@) % ألا يا ليت راحلتي بخبت % ميممة أمير المؤمنينا % % 32(@)(@@) % وإن دميت مناسمها وألقت % بموماة على عجل جنينا % % 33(@)(@@) % تشق الطير ثوب الماء عنه % بعيد حياته إلا الوتينا % % 34(@)(@@) % وهزة نسوة من حي صدق % يزججن الحواجب والعيونا % % 35(@)(@@) % طلبت وقد تواهقت المطايا % % بيعملة تبذ السابقينا % % 36(@)(@@) % وحث الحاديان بأم لهو % ظعائن في الخليط الرافعينا % % 37(@)(@@) % أنخن جمالهن بذات غسل % سراة اليوم يمهدن الكدونا % % 38(@)(@@) % بروض عازب سرحن فيه % سواما وانتظرن به الظعونا % % 39(@)(@@) % وما مال النهار وهن فيها % % يخدرن الدمقس ويحتوينا % % 40(@)(@@) % فرحن عشية كبنات مخر % على الغبطات يملأن العيونا % % PageV01P189 41(@)(@@) % دعون قلوبنا بأثيفيات % فألحقنا قلائص يغتلينا % % 42(@)(@@) % بغيطلة إذا التفت علينا % % نشدناها المواعد والديونا % % 43(@)(@@) % عطفن لها السوالف من بعيد % فقلت عيون آرام كسينا % % 44(@)(@@) % أولائك نسوة في إرث مجد % كرائم يصطفين ويصطفينا % % 45(@)(@@) % مدلات يسرن بكل ثغر % إذا أرقن من فزع حمينا % % 46(@)(@@) % لهن فوارس ليسوا بميل % ولا كشف إذا قلن : امنعونا % % 47(@)(@@) % ظعائن من كرام بني نمير % خلطن بميسم حسبا ودينا % % 48(@)(@@) % تفرعن النصور وحي معن % وسادة عامر حتى رضينا % % 49(@)(@@) % وسبق تعظم الأخطار فيه % ويحسر جريه البطل البطينا % % 50(@)(@@) % شهدناه بفتيان كرام % فلم نبرح به حتى علينا % % PageV01P190 51(@)(@@) % تبادرنا إساءته فجئنا % % من الأفواج نلتهم المئينا % % 52(@)(@@) % ومعترك تشق البيض فيه % كشق الجارز 
ms46	 القمع السمينا % % 53(@)(@@) % لنا جبب وأرماح طوال % بهن نمارس الحرب الشطونا % % 54(@)(@@) % وأفراس إذا نلقى عدوا % بملحمة عرفن إذا ربينا % % 55(@)(@@) % وردن المجد قبل بني نزار % فما شربوا به حتى روينا % % 56(@)(@@) % وجدنا عامرا أشراف قيس % فكنا الصلب منها والوتينا % % 57(@)(@@) % ذؤابتنا ذؤابتها وكانت % قناة لوائها المتبوع فينا % % 58(@)(@@) % ومن يفخر بمكرمة فإنا % % سبقناها لأيدي العالمينا % % 59(@)(@@) % عصا كرم ورثناها أبانا % % ونورثها إذا متنا بنينا % % 60(@)(@@) % وإن وزن الحصى فوزنت قومي % % وجدت حصى ضريبتهم رزينا % % PageV01P191 61(@)(@@) % ومن يحفر أراكتنا يجدها % % أراكة هضبة ثقبت شؤونا % % 62(@)(@@) % ونحن الحابسون إذا عزمنا % % ونحن المقدمون إذا لقينا % % 63(@)(@@) % ونحن المانعون إذا أردنا % % ونحن النازلون بحيث شينا % % 64(@)(@@) % إذا ندبت روايا الثقل يوما % % كفينا المضلعات لمن يلينا % % 65(@)(@@) % إذا ماقيل أين حماة ثغر % فنحن بدعوة الداعي عنينا % % 66(@)(@@) % وتلقى جارنا يثني علينا % % إذا ما حان يوم أن يبينا % % 67(@)(@@) % هم فخروا بخيلهم فقلنا % % بغير الخيل تغلب أوعدينا % % 68(@)(@@) % لنا آثارهن على معد % وخير فوارس للخير فينا % % 69(@)(@@) % وعلمنا سياستهن إنا % % ورثنا آل أعوج عن أبينا % % 70(@)(@@) % مقربة إذا خوت الثريا % % جعلنا رزقهن مع البنينا % % PageV01P192 71(@)(@@) % وكن إذا أبرن ديار قوم % عطفناها لقوم آخرينا % % 72(@)(@@) % كأن شوادخ الغرات منهم % بوازي يصطفقن ويلتقينا % % 73(@)(@@) % أصابت حربنا جشم بن بكر % فأصبح بيت عزهم عزينا % % 74(@)(@@) % ألم نترك نساءهم جميعا % % بأقبال الهضاب مسندينا % % 75(@)(@@) % بدأنا ثم عدنا فاصطلمنا % % شراذم من أنوفكم بقينا % % 76(@)(@@) % قتلناكم ببلدة كل أرض % وكنا في الحروب مجربينا % % 77(@)(@@) % بأسياف لنا متوارثات % كشهبان بأيدي مصلتينا % % 78(@)(@@) % إذا خالطن هامة تغلبي % فلقن الرأس منه والجبينا % % 79(@)(@@) % ألم نترك نساء بني زهير % على الآسي يحلقن القرونا % % 80(@)(@@) % تمنيت المنى فكذبت فيها % % ورويت الرماح وما روينا % % PageV01P193 81(@)(@@) % وما تركت رماح بني سليم % لفحل في حواصنهم جنينا % % 82(@)(@@) % وإن بنات حلاب وجدنا % % فوارسهن في الهيجا قيونا % % 83(@)(@@) % وهم تركوا على أكناف لبنى % % نساءهم لنا لما لقونا % % 84(@)(@@) % إذا ما حاربتك بطون قيس % حسبت الناس حربا أجمعينا % % 85(@)(@@) % عليك البحر حيث 
ms47	 نفيت إنا % % منعناك السهولة والحزونا % % 86(@)(@@) % ثناء تشرق الأحساب منه % به نتودع الحسب المصونا % % 87(@)(@@) % فلم نشعر بضوء الصبح حتى % % سمعنا في مساجدنا الأذينا % % 88(@)(@@) % يقدن ولا يقدن لكل غيث % وفي رأس يسرن وينتوينا % % 89(@)(@@) % ونحن ذوو الأناة وإن أصبنا % % بمظلمة حسبت بنا جنونا % % PageV01P194 البحر : - 1(@)(@@) % إن على أهوى لألأم حاضر % حسبا وأقبح مجلس ألوانا % % 2(@)(@@) % قبح الإله ولا أحاشي غيرهم % أهل السبيلة من بني حمانا % % 3(@)(@@) % متوسدون على الحياض لحاهم % يرمون عن فضلائها فضلانا % % 4(@)(@@) % وبحسب قومك إن شتوا مطلولة % شرع النهار ومذقة أحيانا % % PageV01P195 البحر : وافر تام 1(@)(@@) % قليلا ثم قام إلى المطايا % % سمادعة يجرون الثنايا % % PageV01P196 البحر : طويل 1(@)(@@) % ألم يسأل الركب الديار العوافيا % % بوجه نوى من حلها أو متى هيا % % 2(@)(@@) % ظللنا سراة اليوم من حب أهلها % % نسائل آناء لها وأثافيا % % 3(@)(@@) % بذي الرضم سار الحي منها فما ترى % % بها العين إلا مسجدا وأواريا % % 4(@)(@@) % وجونا أظلتها ركاب مناخة % ركاب قدور لا يرمن المثاويا % % 5(@)(@@) % وآناء حي تحت عين مطيرة % عظام البيوت ينزلون الروابيا % % 6(@)(@@) % أربت بها شهري ربيع عليهم % جنائب ينتجن الغمام المتاليا % % 7(@)(@@) % بأسحم من هيج الذراعين أتأقت % مسايله حتى بلغن المناجيا % % 8(@)(@@) % عهدنا الجياد الجرد كل عشية % يشار بها والمجلس المتباهيا % % 9(@)(@@) % وضرب نساء لو رآهن راهب % له ظلة في قلة ظل رانيا % % 10(@)(@@) % جوامع أنس في حياء وعفة % يصدن الفتى والأشمط المتناهيا % % PageV01P197 11(@)(@@) % بأعلام مركوز فعير فغرب % مغاني أم الوبر إذ هي ما هيا % % 12(@)(@@) % لها بحقيل فالنميرة منزل % ترى الوحش عوذات به ومتاليا % % 13(@)(@@) % ومعترك من أهلها قد عرفنه % بوادي أريك حيث كان محانيا % % 14(@)(@@) % وإن نساء الحي لما رمينني % % أصبن الشوى مني وصدن فؤاديا % % 15(@)(@@) % ثقال إذا راد النساء خريدة % صناع فقد سادت إلي الغوانيا % % 16(@)(@@) % ولست بلاق في قبائل قومها % % لوبرة جارا آخر الدهر قاليا % % 17(@)(@@) % كغراء سوداء المدامع ترتعي % % بحومل عطفي رملة وتناهيا % % 18(@)(@@) % لها ابن ليال ودأته بقفرة % وتبغي بغيطان سواه المراعيا % % 19(@)(@@) % أغن غضيض الطرف باتت تعله % صرى 
ms48	 ضرة شكرى فأصبح طاويا % % 20(@)(@@) % وقد عودته بعد أول بلجة % من الصبح حتى الليل أن لا تلاقيا % % PageV01P198 21(@)(@@) % تظل بذي الأرطى تسمع صوته % مفزعة تخشى سباعا وراميا % % 22(@)(@@) % إذا نظرت نحو ابن إنس فإنه % يرى عجبا ما واجهته كما هيا % % 23(@)(@@) % دعاني الهوى من أم وبر ودونها % % ثلاثة أخماس فلبيك داعيا % % 24(@)(@@) % فعجنا لذكراها وتشبيه صوتها % % قلاصا بمجهول الفلاة صواديا % % 25(@)(@@) % نجائب لا يلقحن إلا يعارة % عراضا ولا يشرين إلا غواليا % % 26(@)(@@) % كأنا على صهب من الوحش صعلة % سماوية ترعى المروج خواليا % % 27(@)(@@) % من المفرعات المجفرات كأنها % % غمام حدته الريح فانقض ساريا % % 28(@)(@@) % إذا شرب الظمء الأداوى ونضبت % ثمائلها حتى بلغن العزاليا % % 29(@)(@@) % بغبراء مجراز يبيت دليلها % % مشيحا عليها للفراقد راعيا % % 30(@)(@@) % طوى البعد أن أمست نعاما وأصبحت % قطا طالقا مسحنفرا متدانيا % % PageV01P199 31(@)(@@) % تداعين من شتى ثلاثا وأربعا % % وواحدة حتى برزن ثمانيا % % 32(@)(@@) % دعا لبها غمر كأن قد وردنه % برجلة أبلي ولو كان نائيا % % 33(@)(@@) % فصبحن مسجورا سقته غمامة % رعال القطا ينفضن فيه الخوافيا % % 34(@)(@@) % فلما نشحناهن منه بشربة % ركبنا فيممنا بهن الفيافيا % % 35(@)(@@) % فتلك مطايانا وفوق رحالها % % نجوم تخطى ظلمة وصحاريا % % 36(@)(@@) % أرجي المنى من عند بشر ولم أزل % لأمثالها من آل مروان راجيا % % 37(@)(@@) % لعمرك إن العاذلات بيذبل % وناعمتي دمخ لينهين ماضيا % % 38(@)(@@) % بعيد الهوى رام الأمور فلم يرى % % لحاجته دون ابن مروان قاضيا % % 39(@)(@@) % لوارد ماء من فلاة بعيدة % تذكر أين الشرب إن كان صافيا % % 40(@)(@@) % فأصبحن قد أقصرن عن متبسل % قرى طارق الهم القلاص المناقيا % % PageV01P200 41(@)(@@) % وهن يحاذرن الردى أن يصيبني % % ومن قبل خلقي خط ما كنت لاقيا % % 42(@)(@@) % وأعلم أن الموت يا أم سالم % قرين محيط حبله من ورائيا % % 43(@)(@@) % فكائن ترى من مسعف بمنية % يجنبها ، أو معصم ليس ناجيا % % 44(@)(@@) % ومنيت من بشر صحابي منية % فكلهم أمسى لما قلت راضيا % % 45(@)(@@) % فأنت ابن خيري عصبتين تلاقيا % % على كل حي عزة ومعاليا % % 46(@)(@@) % وأنت ابن أملاك وليث خفية % تفادى الأسود الغلب منه تفاديا % % 47(@)(@@) % ونائلك 
ms49	 المرجو سيب غمامة % سقت أهلها عذبا من الماء صافيا % % 48(@)(@@) % نزلت من البيضاء في آل عامر % وفي عبد شمس المنزل المتعاليا % % 49(@)(@@) % فلم نر خالا مثل خالك سوقة % إذا ابتدر القوم الكرام المساعيا % % 50(@)(@@) % وكان العراق يوم صبحت أهله % كذي الداء لاقى من أمية شافيا % % PageV01P201 51(@)(@@) % كشفت غطاء الكفر عنا وأقلعت % زلازله لما وضعت المراسيا % % 52(@)(@@) % وعفيت منهم بعد آثار فتنة % وأحييت بابا للندى كان خاويا % % 53(@)(@@) % فإنا وبشرا كالنجوم رأيتها % % يمانية يتبعن بدرا شآميا % % 54(@)(@@) % أبوك الذي آسى الخليفة بعدما % % رأى الموت منه بالمدينة وانيا % % 55(@)(@@) % فلو كنت من أصحاب مروان إذ دعا % % بعذراء يممت الهدى إذ بدا ليا % % 56(@)(@@) % على بردى إذ قال إن كان عهدهم % أضيع فكونوا لا علي ولا ليا % % 57(@)(@@) % ولكنني غيبت عنهم فلم يطع % رشيد ولم تعص العشيرة غاويا % % 58(@)(@@) % وكم من قتيل يوم عذراء لم يكن % لصاحبه في أول الدهر قاليا % % 59(@)(@@) % فإن يك سوق من أمية قلصت % لقيس بحرب لا تجن المعاريا % % 60(@)(@@) % فقد طال أيام الصفاء عليهم % وأي صفاء لا يحور تغاويا % % PageV01P202 61(@)(@@) % ألسنا أشد الناس يا أم سالم % لدى الموت عند الحرب قدما تآسيا % % 62(@)(@@) % فلم يبق منا القتل إلا بقية % ولم يبق من حيي ربيعة باقيا % % 63(@)(@@) % برزنا لضبعاني معد فلم ندع % لبكر ولا أفناء تغلب ناديا % % 64(@)(@@) % برهط ابن كلثوم بدأنا فأصبحوا % % لتغلب أذنابا وكانوا نواصيا % % 65(@)(@@) % أعدنا بأيام الفراة عليهم % وقائعنا والمشعلات الغواشيا % % 66(@)(@@) % سلاهب من أولاد أعوج فوقها % % فوارس قيس مشرعين العواليا % % 67(@)(@@) % وغارتنا أودت ببهراء إنها % % تصيب الصميم مرة والمواليا % % 68(@)(@@) % ونحن تركنا بالعقير نساءكم % مع الثكل هزلى يشتوين الأفاعيا % % 69(@)(@@) % وكانت لنا ناران نار بجاسم % ونار بدمخ يحرقان الأعاديا % % PageV01P203 البحر : طويل 1(@)(@@) % ظعنت وودعت الخليط اليمانيا % % سهيلا وآذناه أن لا تلاقيا % % 2(@)(@@) % وكنا بعكاش كجاري جنابة % كفيئين زادا بعد قرب تنائيا % % 3(@)(@@) % وكنت كذي داء وأنت دواءه % فهبني لدائي إذ منعت شفائيا % % 4(@)(@@) % شفائي أن تختصني بكراهة % وتدرأ عني الكاشحين الأعاديا % % 5(@)(@@) % فإلا تنلني 
ms50	 من يزيد كرامة % أول وأصبح من قرى الشام خاليا % % 6(@)(@@) % وأرضى بأخرى قد تبدلت إنني % % إذا ساءني واد تبدلت واديا % % 7(@)(@@) % وإلف صبرت النفس عنه وقد أرى % % غداة فراق الحي ألا تلاقيا % % 8(@)(@@) % وقد قادني الجيران حينا وقدتهم % وفارقت حتى ما تحن جماليا % % 9(@)(@@) % رجاؤك أنساني تذكر إخوتي % % ومالك أنساني بوهبين ماليا % 10(@)(@@) % وخصم غضاب ينفضون لحاهم % كنفض البراذين الغراث المخاليا % % PageV01P204 11(@)(@@) % لدى مغلق أيدي الخصوم تنوشه % وأمر يحب المرء فيه المواليا % % 12(@)(@@) % دلفت لهم بعد الأناة بخطة % ترى القوم منها يجهدون التفاديا % % 13(@)(@@) % فبت وبات الحاطبان وراءها % % بجرداء محل يألسان الأفاعيا % % 14(@)(@@) % فما برحا حتى أجنا فروجها % % وضما من العيدان رطبا وذاريا % % 15(@)(@@) % إذا حمشاها بالوقود تغيظت % على اللحم حتى تترك العظم باديا % % 16(@)(@@) % خليلة طراق الظلام رغيبة % تلقم أوصال الجزور كما هيا % % 17(@)(@@) % وقدر كرأل الصحصحان وئية % أنخت لها بعد الهدو الأثافيا % % 18(@)(@@) % بمغتصب من لحم بكر سمينة % وقد شام ربات العجاف المناقيا % % 19(@)(@@) % وأعرض رمل من عنيس ترتعي % % نعاج الملا عوذا به ومتاليا % % 20(@)(@@) % أبا خالد لا تنبذن نصاحة % كوحي الصفا خطت لكم في فؤاديا % % PageV01P205 21(@)(@@) % فنورثكم إن التراث إليكم % حبيب مربات الحمى فالمطاليا % % PageV01P206 البحر : بسيط تام 1(@)(@@) % إن ابن مغراء عبد ليس نائلنا % % حتى ينال بياض الشمس رانيها % % 2(@)(@@) % تبلى ثياب بني سعد إذا دفنوا % % تحت التراب ولا تبلى مخازيها % % 3(@)(@@) % الآكلين اللوايا دون ضيفهم % والقدر مخبوءة منها أثافيها % % 4(@)(@@) % اللافظين النوى تحت الثياب كما % % مجت كوادن دهم في مخاليها % % PageV01P207 
