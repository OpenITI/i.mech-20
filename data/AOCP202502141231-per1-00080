ms73	 آزاد زعشق %~% ای وای زعاشقی و، فریاد زعشق!(@)(@)PageV01P203(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0207.jpg)(@)(@)(@@)(@@)(@@) | لاادری(@)(@@) (@@) 727 پیوسته، دل من است فرمانبر عشق %~% همواره، تن من است خدمتگر عشق(@)(@@) (@@) چون من به سر ایستادهام بر در عشق %~% دارم سر آنکه سر کنم در سر عشق(@)(@@) (@@) 728 برداشتهٔ‌ دولتم، افکندهآ عشق %~% وله %~% پا برجایم، ولی پراکندهآ عشق(@)(@@) (@@) دلشاد بدانم، که غم عشق خورم %~% آزاد کنونم، که شدم بندهآ عشق(@)(@@) (@@) 729 دلبر، نخرد ناله و زاری در عشق %~% وله %~% در باز دلا، هر آنچه داری در عشق(@)(@@) (@@) لیکن به یقین بدان، که خون آرد بار %~% ای شیفته، هر غمی که کاری در عشق(@)(@@)(@@)(@@) | سید مرتضی(@)(@@) (@@) 730 یا، سر زفضولها بباید پرداخت %~% یا، عاشقیی تمام برباید ساخت(@)(@@) (@@) یا، در رخ نیکوان نباید نگریست %~% ورنه، دل وجان ومال درباید باخت(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 731 ای گردن دل کشیده در چنبر عشق %~% حسن تو، نهاده بر سرم افسر عشق(@)(@@) (@@) سری است، رخت نبشته بر دفتر عشق: %~% فرخ تن آنکه سر کند در سر عشق!(@)(@@)(@@)(@@) | شمس سجاسی(@)(@@) (@@) 732 [آن را] که گآل ذوق نرست از گیل عشق %~% بیهوده، چرا می سپرد منزل عشق(@)(@@) (@@) سودای هوس، در سرما هست، ولیک %~% کو.................... درد دل عشق(@)(@@) (@@) 732 معشوقه، که شمع چگلش می خوانی %~% وله %~% نقش هوس آب و گلشن میخوانی(@)(@@) (@@) در شیوهآ عاشقی، که مردان ورزند %~% وله %~% جان است، چرا درد دلش می خوانی؟(@)(@@) (@@) 73 مرکب، به ره عشق مرا نیت شما %~% کان راه دراز است، بما نیت شما!(@)(@@) ~~نا عشق موافقت، زجان بیزاری است 73 آنها، که در آرزوی جانان میرند(@)(@@) %~% اله %~% سری است در این شیوه، ندانیت شما! %~% گریان، زپی وصل به هجران میرند(@)(@@) (@@) شق، از گل و شمعشان بباید آموخت %~% کز غصه خورند خون و، خندان میرند!(@)(@)PageV01P204(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0208.jpg)(@)(@)(@@)(@@)(@@) | اوله(@)(@@) ~~732 برخیز، که عاشقان به شب راز کنند گرد در و بام دوست، پرواز کنند(@)(@@) (@@) هر در که بود، جمله به شب در بندند %~% الآ درعاشق، که به شب باز کنند(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 72 
ms74	 تا در غم یار پرستم باید بود %~% با خشم و رضای او، به هم باید بود(@)(@@) (@@) گر زانکه رضای او بود کشتن تو %~% در بند بقای خویش، کم باید بود(@)(@@)(@@)(@@) | شهاب خواری(@)(@@) (@@) 72 پیری که همیشه گرم در کار بود %~% از سود و زیان خویش بیزار بود(@)(@@) (@@) در عالم عشق، هر که سردار بود %~% در سر دارد، که بر سر دار بود(@)(@@) عزیزالدین علی شروانی(@)(@@) (@@) 73 در عالم جان، شربت مستی عشق است %~% بر گلشن جان، نسیم مستی عشق است(@)(@@) (@@) زآلایش خلق، پاک دستی عشق است %~% در مذهب من، خداپرستی عشق است(@)(@@)(@@)(@@) | جمال حاجی شروانی(@)(@@) ~~عقلی، که به وهم در نیاید علم است 71 آن دل، که زنیک و بد نرنجد عشق(@)(@@) است 74 ای دل، همه اسرار جهانبان عشق است %~% اوله %~% وان پشت، که بارکس(@)(@@) نسنجد عشق است %~% علمی، که به عقل در نگنجد عشق است %~% نیک وبد وم آشکار و پنهان عشق است(@)(@@) (@@) چون دانستی، که توبه جانی زنده %~% اوله %~% می دان، که همه زندگی جان عشق است(@)(@@) (@@) 74 دردی، که دوای جان رساند عشق است %~% راهی، که ببه دلستان رساند عشق است(@)(@@) (@@) وان حال، که فرزند بنی آدم را %~% اوله %~% از خاک بر آسمان رساند، عشق است(@)(@@) (@@) 74 شوقی، که به گیل دل شکفاند عشق است %~% ذهنی، که رموز غیب داند عشق است(@)(@@) (@@) قهری، که تورا ازتوستاند عشق است %~% لطفی، که تورا بدو رساند عشق است PageV01P205(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0209.jpg)(@)(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 744 در جستن رشتهآ به خون رشتهآ عشق %~% زنده شود آن کس، که شود کشتهآ عشق(@)(@@) (@@) ما، رشتهآ سر گمشده را می جوییم %~% تا بخت، که را دهد سررشتهآ عشق؟(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 7،5 بر رشتهآ سر به خون درآغشتهآ عشق %~% آمد گرهی، که خلق شد کشتهآ عشق(@)(@@) (@@) خلقی، چوزره بر آن گره جمع شدند %~% هم، کس نگشاد این گره ازرشتهآ عشق(@)(@@)(@@)(@@) | شیخ حسین سقا(@)(@@) (@@) 746 سر دفتر عالم معانی، عشق است %~% وآرایش جان و زندگانی، عشق است(@)(@@) (@@) در دور 
ms75	 سپهر پیر، بی عشق مباش %~% کآسایش ایام جوانی، عشق است(@)(@@)(@@)(@@) | سعدالدین لحافی(@)(@@) (@@) 747 گنجی است وجود و، پاسبانش عشق است %~% مجموع جهان تن است و، جانش عشق است(@)(@@) ~~و ین قلعهآ نه قله، که نامش فلک استطاقی است بلند و، نردبانش عشق است(@)(@@) (@@) 748 ماییم در این زمانه افسانهٔ‌ عشق %~% وله %~% خورده می بیخودی ز پیمانهآ عشق(@)(@@) (@@) سری که زعشق است زما پرس، از آنک %~% همسایهآ محنتیم و، همخانهآ عشق(@)(@@)(@@)(@@) | جمال خلیل شروانی(@)(@@) ~~شمعی، که ازوست نور در مجلس جان 749 داریم دلی به درد، دیوانهآ عشق(@)(@@) %~% عقل است، ولیک هست پروانهآ عشق %~% افتاده به هر دهن، چوافسانهآ عشق(@)(@@) (@@) 75 پیری، که به حق راه نماید عشق است %~% اوله %~% وان آب خضره که جان فزاید عشق است(@)(@@) (@@) وان علم، که مشکلات غیبی یک یک %~% بر دل به کمال برگشاید، عشق است(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 751 زان روی، به جز غم نپذیرم در عشق %~% کزغم خوردن، نیست گزیرم در عشق(@)(@@) (@@) توبه نکنم ز عشقبازی هرگز %~% در مذهب عشق، تا نمیرم در عشق(@)(@@)(@@)(@@) | عماد یسا(@)(@@) (@@) 251 خوبان، سخنان کهن و نونخرند %~% بشنو زمن ای عاشق، بشنو نخرند(@)(@@) (@@) زر باید، زر که اندرین راه از تو %~% صد سال بقا را، به یکی جونخرند PageV01P206(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0210.jpg)(@)(@)(@@)(@@)(@@) | نزهه المجالس(@)(@@)(@@)(@@) | ابوالفرج رونی(@)(@@) (@@) 75 در عشق، کسی که از زیان اندیشد %~% به زان نبود که ترک آن اندیشد(@)(@@) (@@) در عالم عاشقی، کسی را نرسد %~% کزعشق زند لاف و، زجان اندیشد(@)(@@)(@@)(@@) | مجیر بیلقانی(@)(@@) ~~756 چون است، که عشق از دل و ازتن خیزدزو، بر دل وتن هزار شیون خیزد(@)(@@) (@@) آری، بخورد زنگ همی آهن را %~% هر چند که زنگ هم از آهن خیزد(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 755 اندر ره عشق، اگر سر غم داری %~% باید خود را نخست ماتم داری(@)(@@) (@@) اول سخن آن است، که مستی نکنی %~% و آخر قدم آن است، که محکم داری(@)(@@)(@@)(@@) | مهستی(@)(@@) (@@) 75 آنها، که هوای عشق موزون زدهاند %~% هر نیمشبی، سجاده در خون زدهاند(@)(@@) (@@) نشنیدستی، که عاشقان 
ms76	 خیمهآ عشق %~% از گردش هفت چرخ، بیرون زده اند(@)(@@)(@@)(@@) | لها(@)(@@) (@@) 75 شب را چه خبر، که عاشقان می چه کشند %~% وزجام بلا، چگونه می زهر چشند؟(@)(@@) (@@) ار راز نهان کنند، غمشان بکشد %~% ور فاش کنند، مردمانشان بکشند(@)(@@)(@@)(@@) | ظهیر طوسی(@)(@@) (@@) 75 تو، مونس غم شبان تاریک نه ای %~% یا چون دل من، چو موی باریک نه ای(@)(@@) (@@) عاشق نه ای و، به عشق نزدیک شده %~% تو قیمت عاشقان چه دانی، که نه ای!(@)(@@)(@@)(@@) | جمال عبد الرزاق(@)(@@) (@@) 75 در عشق، حدیث مصلحت باد بود %~% هر غم که از او کشی، همه داد بود(@)(@@) (@@) این زیور عاشقی، کسی را زیبد %~% الغیره %~% کز هژده هزار عالم، آزاد بود(@)(@@) (@@) 76 گفتی نفسی بر آر در دولت وصل %~% نه نه که همی گریزم از رحمت وصل(@)(@@) (@@) در مذهب عاشقی وراه مردی %~% صد ضربت هجر به، که یک منت وصل(@)(@@)(@@)(@@) | فخرالدین مبارکشاه(@)(@@) (@@) 761 اندر ره عشق، فرد باید بودن %~% همواره، قرین درد باید بودن(@)(@@) (@@) تروی کبود، که دروصی آو یزی %~% در روز فراق، مرد باید بودن!(@)(@)PageV01P207(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0211.jpg)(@)(@)(@@)(@@)(@@) | سید مرتضی(@)(@@) ~~762 کار، از لب خشک و دیدهآ تر بگذشت تیر غم او، زجان و دل بر بگذشت(@)(@@) (@@) آبیم نمود بس تنک، آتش عشق %~% چون پای درو نهادم، از سر بگذشت(@)(@@)(@@)(@@) | مغیره(@)(@@) (@@) 763 گویند، که عشق را زبان پیدا نیست %~% و اندر ره جانان، پی جان پیدا نیست(@)(@@) (@@) کان مرغ، که راه سوی دریا سپرد %~% زیر اپر وبال او] نشان پیدا نیست(@)(@@)(@@)(@@) | مهستی(@)(@@) (@@) 764 جان، در ره غمهاش خطر باید کرد %~% آسوده دلی، زیر و زبر باید کرد(@)(@@) (@@) وآنگه، زرضای یار نادیده اثر %~% با درد دل، از جهان گذر باید کرد(@)(@@)(@@)(@@) | سعد گیلانی(@)(@@) (@@) 765 تا کی، زبرای دل چنین خوار شوی %~% در دست ستمگری، گرفتار شوی(@)(@@) (@@) آنگه دانی، که دل چه کردهست به تو %~% کز غفلت خواب عشق، بیدار شوی(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 766 پیوسته کنی ز زلف وخال اندیشه %~% ای بی سر وپا و دل، محال اندیشه(@)(@@) (@@) بی سیم 
ms77	 سپیدت، نشود کار چوزر %~% گر زانکه کنی هزار سال اندیشه(@)(@@)(@@)(@@) | صدر خجندی(@)(@@) (@@) 767 آسوده دلی، که با غم یار بساخت %~% در کام رسید، هر که با کار بساخت(@)(@@) (@@) مه، نور بدان گرفت کز شب نرمید %~% گل، بوی بدان یافت که باخار بساخت(@)(@@) (@@) 768 ای دل، به از این کار طرب سازی کن %~% الغیره %~% در مهر بتان، خانه بر اندازی کن(@)(@@) (@@) گر از سر و تیغ و کازد می اندیشی %~% این کارنه کارتوست، روبازی کن!(@)(@@)(@@)(@@) | جمال خلیل(@)(@@) (@@) 769 در عشق، حدیث سر غرامت باشد %~% راه غم یار، بی سلامت باشد(@)(@@) (@@) در عشق، مرنج از ملامت زیراک %~% اول قدم از عشق، ملامت باشد(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 770 عشق آن بهتر، که با ملامت باشد %~% آن زهد بود، که با سلامت باشد(@)(@@) (@@) عشقی، که نه تا روز قیامت باشد %~% بر عاشق ومعشوق، غرامت باشد PageV01P208(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0212.jpg)(@)(@)(@@)(@@)(@@) | لاادری(@)(@@) (@@) 77 نه عشق بود، ز آبرو ترسیدن %~% وز زحمت تیغ وهاو هو ترسیدن(@)(@@) (@@) فیارهآ عاشقی، به سر وابستن %~% وز شحنه و دار و چارسو ترسیدن(@)(@@)(@@)(@@) | لااعرف(@)(@@) (@@) 772 اندر ره عاشقی، کمی بیشی نیست %~% با هیچ کسی، زمانه را خویشی نیست(@)(@@) (@@) افتادهآ عشق را، ملامت مکنید %~% کاین عشق، به خواجگی و در و یشی نیست(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 77 در عشق تو، ازملامتم ننگی نیست %~% با بیخبران، در این سخن جنگی نیست(@)(@@) ~~پن شربت عاشقی همه، مردان راست نامردان را، در این قدح رنگی نیست(@)(@@)(@@)(@@) | شیخ احمد غزالی(@)(@@) (@@) 77 روزی دو سه، تا در این جهانی زنده %~% شرمت بادا، اگر به جانی زنده(@)(@@) (@@) ی عشق مباش، تا نباشی مرده %~% در عشق بمیر، تا بمانی زنده(@)(@@)(@@)(@@) | الغیره(@)(@@) ~~775 در قدرت حق، نظاره کردن چه خوش است وزعالم دون، کناره کردن چه خوش است(@)(@@) (@@) هر دل، که در او عشق الهی نبود %~% آن دل، به هزار پاره کردن چه خوش است!(@)(@@)(@@)(@@) | ظهیر(@)(@@) (@@) 776 در عشق، اگر دمی قرارت باشد %~% با صحبت نیکوان، چه کارت باشد(@)(@@) (@@) سرتیز چو خار باش، با یار چو گل 
ms78	 %~% گه در بر و، گاه در کنارت باشد(@)(@@)(@@)(@@) | شهاب الدین سهروردی(@)(@@) ~~77 اصل گهر عشق، ز کانی دگر است منزلگه عاشقان، جهانی دگر است(@)(@@) (@@) وان مرغ، که دانهآ غم عشق خورد %~% بیرون زدو کونش، آشیانی دگر است(@)(@@)(@@)(@@) | جمال عبدالرزاق(@)(@@) (@@) 773 در کوی هوس، عشق مجازی دگر است %~% واندر ره عشق، جانگدازی دگر است(@)(@@) ~~در عشق، حدیث جان نشاید کردن بازی دگر است و، عشقبازی دگر است!(@)(@)PageV01P209(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0213.jpg)(@)(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 779 از منزل عشق، رخت بر در گیرید %~% ورنه، زفراق دست بر سر گیرید(@)(@@) (@@) ور نیست شما را خبر از محنت عشق %~% در من نگرید و، عبرتی بر گیرید(@)(@@) (@@) 780 ای دل، نکنند عشقبازی هر جا %~% وله %~% چون ماه مباش، هر زمان دیگر جا(@)(@@) (@@) در عشق، چو پرگار همی باید بود: %~% سرگشته زدست غم، ولی پا بر جا!(@)(@@)(@@)(@@) | (ااعرف(@)(@@) (@@) 781 یک خانهات ار پر زکتاب فقهی است %~% سودت نکند، چو کیسهآ سیم تهی است(@)(@@) (@@) زر باید، زر که ضرب شاهی دارد %~% معشوقه چه داند که ررفان قیل)) تو چیست!(@)(@@) (@@) 782 دیدم، که دل خسته غمین خواهد بود %~% تن، با غم هجر همنشین خواهد بود(@)(@@) (@@) حالت نه چنان بود، که هر کس می گفت %~% ای وای من، ار عشق چنین خواهد بود!(@)(@@)(@@)(@@) | اشهری(@)(@@) (@@) 783 در راه وفا، چو گشت صادق معشوق %~% با یار لطیف خود، موافق معشوق(@)(@@) (@@) در عشق، که دید حالتی خوشتر از آنک %~% معشوق شود عاشق و، عاشق معشوق!(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 784 عاشق باشی، تو را زبون باید بود %~% ورنه، زصف عشق برون باید بود(@)(@@) (@@) عاشق باشی زبون نباشی، چه کنی؟ %~% خود عشق بگویدت، که چون باید بود(@)(@@)(@@)(@@) | صدر خجندی(@)(@@) (@@) 785 سودای میان تهی، زسر بیرون کن %~% ازناز بکاه و، در نیاز افزون کن(@)(@@) (@@) استاد توعشق است و، چو آنجا برسی %~% او خود، به زبان حال گوید چون کن(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 876 از عالم عشق، آنکه دارد خبری %~% بر خود نکند به هیچ وجهی گذری(@)(@@) (@@) گر هر چه به شهوت است، آن 
ms79	 عشق بود %~% پس، عاشق صادق است هر گاو و خری.(@)(@)PageV01P210(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0214.jpg)(@)(@)(@@)(@@)(@@) | اوله(@)(@@) ~~787 در عشق، دلی باید و صد جانبازی حالی و، هزار گونه محنت سازی(@)(@@) (@@) شرمت ناید، عاشق و آنگه ««من وتو؟» %~% معشوقی وعاشقی است، یا انبازی!(@)(@@)(@@)(@@) | اوله(@)(@@)(@@)(@@) | در بیشهآ عشق، شیر روبه گردد(@)(@@) (@@) وآنکس که ز سرعشق آگه گردد %~% با او، سخن دراز کوته گردد!(@)(@@) برادر مجیر راست(@)(@@) (@@) 78 باشد زهوای خویش، غمگین عاشق %~% شد در خورصد هزار چندین عاشق(@)(@@) (@@) ز جملهآ عالم، چه خورد یا چه برد %~% جز غصه وذل وهجر، مسکین عاشق؟(@)(@)PageV01P211(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0215.jpg)(@)(@)(@@)(@@)(@@) | اب نهم(@)(@@)(@@)(@@) | دردل واحوال آن(@)(@@)(@@)(@@) | لااعرف قائله(@)(@@) (@@) 790 از شبنم عشق، خاک آدم گل شد %~% صد فتنه و شو در جهان حاصل شد(@)(@@) (@@) سرنشتر عشق، بر رگ روح زدند %~% یک قطره فرو چکید، نامش دل شد(@)(@@)(@@)(@@) | عایشهآ سمرقندیه(@)(@@) (@@) 791 گفتی که: (ترا شوم مدار اندیشه %~% دل خوش کن و، بر صبر گمار اندیشه!)(@)(@@) ~~گفتم که: ررچه دل؟ کآنچه دلش می خوانییک قطرهآ خون است و، هزار اندیشه!))(@)(@@)(@@)(@@) | فخررازی(@)(@@) (@@) 792 ای دل، زغبار جسم اگر پاک شوی %~% تو روح مجردی، بر افلاک شوی(@)(@@) (@@) عرش است نشیمن تو، شرمت ناید %~% کآیی و، مقیم عرصهآ خاک شوی؟(@)(@@)(@@)(@@) | وحد کرمانی(@)(@@) ~~793 ای دل، بر تو زنیک و بد پیدا نیست بر لوح تو، خود نقش خرد پیدا نیست(@)(@@) (@@) از بس که به زلف دلبران پیوستی %~% سر رشتهآ احوال تو،خود پیدا نیست PageV01P212(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0216.jpg)(@)(@)(@@)(@@)(@@) | شیخ حسین سقا(@)(@@) ~~79 گیرم سخنی چو در مکنون شنوییا رمز لطیف و نغز و موزون شنوی(@)(@@) ~~در پیش تو گر صفات دل شرح دهند تا دل نشوی، حدیث دل چون شنوی؟(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~795 دل، آفت و نقصان نپذیرد هرگز وین آینه، زنگار نگیرد هرگز(@)(@@) (@@) لیکن چو زمعشوق جفایی باشد %~% بیمار شود، ولی نمیرد هرگز!(@)(@@)(@@)(@@) | فخرالدین مبارکشاه(@)(@@) ~~79 دل، از سر کوی فتنه در تاخته بودبرهم زدن کار مرا، ساخته بود(@)(@@) (@@) جان، دست به پیشانی او باز استاد %~% ورنه، همه خان ومان 
ms80	 برانداخته بود(@)(@@)(@@)(@@) | اوله(@)(@@) ~~797 ای دل، همه کار و بارت از دست بشد زور و زر و روزگارت از دست بشد(@)(@@) (@@) سررا، به گریبان ضرورت در کش %~% چون دامن اختیارت از دست بشد(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 298 در دل، علم وصل نگون می بینم %~% هر روز، سپاه غم فزون می بینم(@)(@@) (@@) از زخم سنان هجر، بر سینهآ صبر %~% صحرای دل، آغشته به خون می بینم(@)(@@)(@@)(@@) | وله(@)(@@) ~~799 گفتی که: سرشک تو چرا گلگون شد؟چون پرسیدی، باتو بگویم چون شد(@)(@@) (@@) خونابهآ سودای تومی پخت، دلم %~% چون جوش برآورد، زسر بیرون شد!(@)(@@)(@@)(@@) | اوله(@)(@@) ~~800 دل، در غم انتظار وصلت خون شد یک روز نگفته ای که: حالت چون شد؟(@)(@@) (@@) آبی برزن، که در تف آتش عشق %~% خونابهآ دیگ دل، زسر بیرون شد(@)(@@) رفیع الدین البکرانی الابهری(@)(@@) (@@) 801 گفتی که: «ردلت به هر دری می پوید %~% می گردد و، رسوایی ما می جوید!»(@)(@@) ~~دل را چه گنه؟ راز تودل باز نگفت اشک است، که یک به یک چودر می گویدا PageV01P213(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0217.jpg)(@)(@)(@@) (@@) 802 گفتی: ««غم عشقت همه کس می داند %~% لغیره %~% وان راز گشادهای، بدان می ماند!»)(@)(@@) (@@) ما، راز تو را فاش نکردیم، ولی %~% اشک است، که چون آب فرو می خواند!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 803 دل، پیش من از یار جفایی می گفت %~% پنداشتم، از درد خطایی می گفت(@)(@@) ~~خون شد دل و، گفته های او شد همه راستمسکین دلم، آن سخن زجایی می گفت!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 804 بادل گفتم: نخاری، ای دل، تن عشق %~% رسوا گردی، مگرد پیرامن عشق!(@)(@@) (@@) بر زد دلم آستین به پیراهن عشق %~% یعنی : تو کیی؟ دست من و، دامن عشق!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 805 ای دل، چو شراب عشق در جام افتاد %~% بستان و بکش، که کارنا کام افتاد(@)(@@) (@@) خوش باش به ناخوشی، که در عالم عشق %~% اول مرغی نه ای، که در دام افتاد!(@)(@@)(@@)(@@) | فهستی(@)(@@) ~~806 زین سان که فتاد هجر درراه، ای دل ترسم نبری جان زغمش، آه ای دل(@)(@@) ~~باری، چونه 