ms5557	 25، ح 21.(@)(@@) وروى عنه محمد بن حسان.(@)(@@) الكافي: ج 2، ك 1، ب 156، ح 1.(@)(@@) * وروى عن سعدان بن مسلم، وروى عنه علي بن الحسن بن فضال.(@)(@@) التهذيب: ج 7، ح 1595.(@)(@@) * وروى عن سعيد بن الجهم، وروى عنه أحمد بن مهران.(@)(@@) الكافي: ج 1، ك 4، ب 72، ح 12.(@)(@@) * وروى عن سلام بن عبد الله الهاشمي، وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 1، ك 4، ب 81، ح 6.(@)(@@) وروى عنه محمد بن حسان.(@)(@@) الكافي: ج 1، ك 4، ب 81، ح 1.(@)(@@) * وروى عن سماعة بن مهران.(@)(@@) وروى عنه المعلى بن محمد.(@)(@@) الكافي: ج 1، ك 4، ب 81، ح 6.(@)(@@) * وروى عن سيف بن عميرة، وروى عنه أحمد بن مهران.(@)(@@) الكافي: ج 1، ك 4، ب 120، ح 7.(@)(@@) * وروى عن شريف بن سابق، وروى عنه محمد بن أحمد النهدي.(@)(@@) الكافي: ج 5، ك 2، ب 159، ح 59.(@)(@@) * وروى عن الضحاك بن الأشعث، وروى عنه أحمد بن مهران.(@)(@@) الكافي: ج 1، ك 4، ب 72، ح 13.(@)(@@) * وروى عن عاصم بن حميد، وروى عنه محمد بن الحسين.(@)(@@) الكافي: ج 1، ك 4، ب 118، ح 4.(@)(@@) * وروى عن العباس بن موسى، وروى عنه أحمد بن أبي عبد الله.(@)(@@) الكافي: ج 6، ك 8، ب 48، ح 8.(@)(@@) * وروى عنه أحمد بن محمد بن خالد.(@)(@@) الكافي: ج 6، ك 8، ب 11، ح 9.(@)(@@) * وروى عن العباس مولى الرضا عليه السلام، وروى عنه أحمد بن محمد ابن خالد.(@)(@@) الكافي: ج 2، ك 1، ب 189، ح 1.(@)(@@) * وروى عن عبد الرحمن بن أبي هاشم، وروى عنه أحمد بن أبي عبد الله.(@)(@@) الكافي: ج 3، ك 3، ب 9، ح 6، و ج 5، ك 2، ب 39، ح 4، وب 42، ح 5، و ب 121، ح 6، و ج 6، ح 9، ب 3، و ح 5.(@)(@@) وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 2، ك 2، ب 50، ح 6، و ج 6، PageV17P456(@)(@@) ك 7، ب 4، ح 3.(@)(@@) وروى عن أحمد بن محمد بن خالد.(@)(@@) الكافي: ج 2، ك 2، ب 48، ح 31.(@)(@@) والروضة: ح 450.(@)(@@) * وروى عن عبد الرحمن بن زيد بن أسلم، وروى عنه أحمد بن محمد بن خالد.(@)(@@) الكافي: ج 6، ك 6، ب 129، ح 5.(@)(@@) * وروى عن عبد الرحمان بن سالم، وروى عنه محمد بن ناجية.(@)(@@) الفقيه: ج 4، ح 412. والتهذيب: ج 10، ح 873.(@)(@@) * وروى عن عبد الرحمان بن محمد، وروى 
ms5558	 عنه أحمد بن محمد بن خالد.(@)(@@) الكافي: ج 5، ك 3، ب 187، ح 4.(@)(@@) * وروى عن عبد الرحمان بن محمد الأسدي، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 4، ك 1، ب 2، ح 3.(@)(@@) * وروى عن عبد الرحمان بن محمد ابن أبي هاشم، وروى عنه أحمد بن محمد بن خالد.(@)(@@) الكافي: ج 1، ك 3، ب 1، ح 2، و ج 2، ك 1، ب 188، ح 6.(@)(@@) * وروى عن عبد الله بن أيوب الأشعري، وروى عنه محمد بن علي بن معمر.(@)(@@) الروضة: ح 5.(@)(@@) * وروى عن عبد الله بن جبلة، وروى عنه أحمد بن أبي عبد الله.(@)(@@) الكافي: ج 5، ك 2، ب 12، ح 5، وب 40، ح 8. والتهذيب: ج 6، ح 1071 (الاستبصار: ج 3، ح 220، وفيه أحمد بن محمد بن خالد البرقي من باب اختلاف الطريق).(@)(@@) * وروى عن أحمد بن محمد بن خالد.(@)(@@) الكافي: ج 4، ك 3، ب 16، ح 1، و ج 5، ك 2، ب 66، ح 3. والتهذيب: ج 5، ح 1567.(@)(@@) * وروى عن عبد الله بن القلا، وروى عنه أحمد بن مهران.(@)(@@) الكافي: ج 1، ك 4، ب 71، ح 1، و 8.(@)(@@) * وروى عن عبيد بن يحيى، وروى عنه أحمد بن أبي عبد الله.(@)(@@) الكافي: ج 6، ك 8، ب 25، ح 1.(@)(@@) والروضة: ح 277.(@)(@@) * وروى عن عبيد بن يحيى الثوري، وروى عنه أحمد بن أبي عبد الله.(@)(@@) الكافي: ج 6، ك 8، ب 44، ح 7.(@)(@@) * وروى عن عثمان بن عيسى، وروى عنه أحمد بن مهران. PageV17P457(@)(@@) الكافي: ج 1، ك 4، ب 23، ح 3.(@)(@@) * وروى عن علي بن أبي حمزة، وروى عنه أحمد بن مهران.(@)(@@) الكافي: ج 3، ك 3، ب 74، ح 6.(@)(@@) والتهذيب: ج 1، ح 991.(@)(@@) * وروى عن علي بن أسباط، وروى عنه أحمد بن أبي عبد الله.(@)(@@) الكافي: ج 2، ك 1، ب 48، ح 4.(@)(@@) وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 5، ك 2، ب 159، ح 33.(@)(@@) وروى عنه أحمد بن محمد بن خالد.(@)(@@) الكافي: ج 2، ك 1، ب 31، ح 11، وك 4، ب 22، ح 5، و ج 6، ك 6، ب 42، ح 1، و ك 8، ب 21، ح 9.(@)(@@) وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 1، ك 4، ب 81، ح 1.(@)(@@) * وروى عنه محمد بن حسان.(@)(@@) الكافي: ج 1، ك 4، ب 81، ح 1.(@)(@@) وروى عن علي بن حسان، وروى عنه أحمد بن محمد بن أبي عبد 
ms5559	 الله.(@)(@@) الكافي: ج 2، ك 1، ب 32، ذيل ح 3.(@)(@@) * وروى عن علي بن الحكم، وروى عنه أحمد بن مهران.(@)(@@) الكافي: ج 1، ك 4، ب 72، ح 8.(@)(@@) وروى عنه محمد بن بندار.(@)(@@) التهذيب: ج 3، ح 212.(@)(@@) * وروى عن علي بن حماد، وروى عنه أحمد بن أبي عبد الله.(@)(@@) الكافي: ج 4، ك 3، ب 48، ح 5.(@)(@@) وروى عنه محمد بن حسان.(@)(@@) الكافي: ج 7، ك 7، ب 2، ح 7 و 8.(@)(@@) * وروى عن علي بن الخطاب الحلال، وروى عنه أحمد بن أبي عبد الله.(@)(@@) الكافي: ج 6، ك 6، ب 97، ح 8.(@)(@@) * وروى عن علي بن عبد الله، وروى عنه أحمد بن محمد بن خالد.(@)(@@) الكافي: ج 5، ك 3، ب 187، ح 4.(@)(@@) * وروى عن علي بن عثمان، بن رزين، وروى عنه أحمد بن أبي عبد الله.(@)(@@) الكافي: ج 7، ك 7، ب 2، ح 3.(@)(@@) * وروى عن علي بن محمد، وروى عنه أحمد بن محمد بن خالد.(@)(@@) الكافي: ج 2، ك 2، ب 57، ح 11.(@)(@@) * وروى عن علي بن النعمان، وروى عنه علي بن الحسن.(@)(@@) التهذيب: ج 9، ح 732.(@)(@@) وروى عنه علي بن الحسن بن فضال.(@)(@@) التهذيب: ج 3، ح 207 (الاستبصار:(@)(@@) ج 1، ح 1790)، و ج 4، ح 603 PageV17P458(@)(@@) (الاستبصار: ج 2، ح 249)، و 885 (الاستبصار: ج 2، ح 412)، و ج 7، ح 1452 (الاستبصار: ج 3، ح 799)، و ج 9، ح 1038.(@)(@@) وروى عنه محمد بن حسان.(@)(@@) الكافي: ج 4، ك 2، ب 1، ح 9. والتهذيب:(@)(@@) ج 4، ح 538.(@)(@@) * وروى عن علي الحناط (الخياط)، وروى عنه أحمد بن أبي عبد الله.(@)(@@) الكافي: ج 6، ك 8، ب 38، ح 8.(@)(@@) * وروى عن عمار بن مروان، وروى عنه محمد بن حسان.(@)(@@) الكافي: ج 1، ك 4، ب 108، ح 31.(@)(@@) * وروى عن عمر بن جبلة الأحمسي، وروى عنه أحمد بن أبي عبد الله.(@)(@@) الكافي: ج 2، ك 1، ب 60، ح 7.(@)(@@) * وروى عن عمر بن عبد العزيز، وروى عنه أحمد بن محمد.(@)(@@) التهذيب: ج 8، ح 381.(@)(@@) وروى عنه أحمد بن محمد بن خالد.(@)(@@) الكافي: ج 6، ك 1، ب 33، ح 5.(@)(@@) وروى عنه أحمد بن مهران.(@)(@@) الكافي: ج 6، ك 2، ب 2، ح 3.(@)(@@) * وروى عن عيسى بن عبد الله، وروى عنه أحمد بن أبي عبد الله البرقي.(@)(@@) الكافي: ج 6، ك 7، ب 1، ذيل ح 1.(@)(@@) * وروى 
ms5560	 عن عيسى بن عبد الله ابن محمد بن عمر بن علي، وروى عنه أحمد بن أبي عبد الله.(@)(@@) الكافي: ج 6، ك 7، ب 1، ح 5.(@)(@@) * وروى عن عيسى بن عبد الله العلوي، وروى عنه أحمد بن أبي عبد الله.(@)(@@) الكافي: ج 6، ك 6، ب 55، ح 2.(@)(@@) * وروى عن عيسى بن عبد الله العمري، وروى عنه محمد بن حسان.(@)(@@) الكافي: ج 3، ك 3، ب 83، ح 3.(@)(@@) * وروى عن الفضيل بن عثمان، وروى عنه أحمد بن مهران.(@)(@@) الكافي: ج 1، ك 4، ب 70، ح 6.(@)(@@) * وروى عن محمد بن أبي عمير، وروى عنه علي بن الحسن بن فضال.(@)(@@) التهذيب: ج 9، ح 1126 (الاستبصار:(@)(@@) ج 4، ح 620).(@)(@@) * وروى عن محمد بن أحمد العلوي.(@)(@@) التهذيب: ج 2، ح 1523.(@)(@@) * وروى عن محمد بن إسحاق الكاهلي، وروى بعض أصحابنا عنه.(@)(@@) الكافي: ج 2، ك 1، ب 99، ح 27. PageV17P459(@)(@@) وروى عن محمد بن أسلم، وروى عنه أحمد بن محمد بن خالد.(@)(@@) الكافي: ج 5، ك 3، ب 102، ح 2، و ب 106، ح 1، و ج 7، ك 4، ب 56، ح 1، و 2. والتهذيب: ج 7، ح 1153، و ج 10، ح 803.(@)(@@) * وروى عن محمد بن أسلم الجبلي، وروى عنه أحمد بن محمد بن خالد.(@)(@@) الكافي: ج 5، ك 3، ب 167، ح 1.(@)(@@) * وروى عن محمد بن إسماعيل، وروى عنه علي بن الحسن.(@)(@@) التهذيب: ج 1، ح 437 (الاستبصار:(@)(@@) ج 1، ح 438).(@)(@@) * وروى عن محمد بن إسماعيل بن بزيع، وروى عنه علي بن الحسن بن فضال.(@)(@@) التهذيب: ج 7، ح 1454 (الاستبصار:(@)(@@) ج 3، ح 800).(@)(@@) وروى عنه محمد بن حمزة الهاشمي، وروى عنه معلى بن محمد.(@)(@@) الكافي: ج 1، ك 4، ب 122، ح 6.(@)(@@) * وروى عن محمد بن سنان، وروى عنه أحمد بن أبي عبد الله.(@)(@@) الكافي: ج 6، ك 8، ب 66، ح 5.(@)(@@) وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 2، ك 1، ب 157، ح 1، و ج 4، ك 1، ب 40، ح 8.(@)(@@) وروى عنه أحمد بن محمد بن خالد.(@)(@@) الكافي: ج 2، ك 1، ب 99، ح 25، و ب 155، ح 1.(@)(@@) وروى عنه أحمد بن مهران.(@)(@@) الكافي: ج 1، ك 4، ب 14، ح 1، وب 72، ح 3، و 8.(@)(@@) وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 6، ك 1، ب 12، ح 6.(@)(@@) والتهذيب: ج 7، ح 1758.(@)(@@) وروى عنه علي بن الحسن 