ms1521	 5: ص 301](@)(@@)(@@)(@@) ||| AUTO عبد العظيم بن حبيب(@)(@@) شيخ، يروي عن بهز بن حكيم، روى عنه سليمان بن مسلمة الخبائري، إن لم يكن الأول فلا أدري من هو.(@)(@@)(@@)(@@) ||| AUTO عبد العظيم بن إبراهيم بن عمر السالمي(@)(@@) من أهل حمص، يروي عن أبي اليمان وأهل بلده، حدثنا عنه محمد بن المسيب، يغرب.(@)(@@)(@@)(@@) ||| AUTO عبد الغني بن سعيد الثقفي(@)(@@) مصري، يروي عن موسى بن عبد الرحمن الصفار، عن هشام بن عروة، روى عنه بكر بن سهل الدمياطي.(@)(@@)(@@)(@@) ||| AUTO عبد الخبير(@)(@@) شيخ، يروي عن أبيه عن جده عن ثابت بن قيس، روى عنه الفرج بن فضالة.(@)(@@)(@@)(@@) ||| AUTO عبد الأول بن حكيم الحلبي(@)(@@) (616) -[5: 301](@)(@@) يروي عن مسرة بن معبد اللخمي، عن عثمان بن أبي سودة، عن معاوية، عن النبي صلى الله عليه وسلم قال: السنة كلها تصام إلا يومين: الفطر والأضحى. روى محمد بن إبراهيم عن سعيد بن واقد الحراني عنه(@)(@@)(@@)(@@) ||| AUTO عبد المتعال بن طالب الأنصاري(@)(@@) من أهل بغداد، يروي عن إبراهيم بن سعد وابن وهب، روى عنه العراقيون أبو يحيى محمد بن عبد الرحيم وغيره.(@)(@@)(@@)(@@) ||| AUTO عبد الواحد بن سليمان(@)(@@) (617) -[5: 301] يروي عن ابن عون، عن ابن سيرين، عن أبي هريرة، أن رسول الله صلى الله عليه وسلم قال: لو دعيت إلى ذراع أو كراع لأجبت. حدثنا الحسن بن أحمد بن إبراهيم بن فيل البالسي بأنطاكية، ثنا عيسى بن سليمان الحجازي، ثنا عبد الواحد بن سليمان(@)(@@)(@@)(@@) ||| AUTO عبد الواحد بن سعيد(@)(@@) يروي عن عمر بن عبد العزيز، روى عنه المعتمر بن سليمان.(@)PageV01P002(@)(@@) [ج 5: ص 302](@)(@@)(@@)(@@) ||| AUTO عبد الواحد بن واصل، أبو عبيدة الحداد(@)(@@) مولى بني سدوس، من أهل البصرة، يروي عن شعبة ويونس بن أبي إسحاق، روى عنه يحيى بن معين وأهل العراق.(@)(@@)(@@)(@@) ||| AUTO عبد الواحد بن جميل(@)(@@) من أهل البصرة، يروي عن شعبة، روى عنه يعقوب بن سفيان.(@)(@@)(@@)(@@) ||| AUTO عبد الواحد بن غياث، أبو بحر(@)(@@) من أهل البصرة، يروي عن حماد بن سلمة، ثنا عنه زكريا الساجي وغيره من شيوخنا، مات سنة ثمان وثلاثين ومائتين.(@)(@@)(@@)(@@) ||| AUTO 
ms1522	 عبد الواحد بن شعيب اللاذقي(@)(@@) من أهل اللاذقية، من أهل الشام، يروي عن خالد بن الحباب عن سليمان التيمي، حدثنا عنه محمد بن المنذر.(@)(@@)(@@)(@@) ||| AUTO عبد السلام بن سميع بن عبد السلام، أبو همام(@)(@@) بصري، شيخ، يروي عن أبي عاصم، عن أبي سفيان، عن سلمة بن كهيل، عن ابن أشوع، عن ربيعة بن الأسود، عن علي، قال: البرق محاريق الملائكة، حدثناه الحسن بن محمد بن أسد بفم الصلح، ثنا عبد السلام.(@)(@@)(@@)(@@) ||| AUTO عبد السلام بن أبي مطر(@)(@@) يروي عن أبيه وأبي سويد الفقيمي، عداده في أهل البصرة، روى عنه مسدد بن مسرهد.(@)(@@)(@@)(@@) ||| AUTO عبد السلام بن أبي المسلي الحارثي(@)(@@) من أهل الكوفة، يروي عن بيان بن بشر، روى عنه ابن نمير وأبو نعيم.(@)(@@)(@@)(@@) ||| AUTO عبد السلام بن قيس الهلالي(@)(@@) يروي عن أم صالح عن أبي الدهماء، عداده في أهل البصرة، روى عنه أهلها.(@)PageV01P002(@)(@@) [ج 5: ص 303](@)(@@)(@@)(@@) ||| AUTO عبد السلام بن مالك(@)(@@) يروي عن رجل من بني واهب، روى عنه محمد بن أبي بكر البرساني.(@)(@@)(@@)(@@) ||| AUTO عبد السلام العدني(@)(@@) يروي عن الحكم بن أبان المراسيل، روى عنه أهل بلده.(@)(@@)(@@)(@@) ||| AUTO عبد السلام بن هاشم، أبو عثمان البزار(@)(@@) يروي عن حنبل بن عبد الله، عداده في أهل البصرة، روى عنه عمرو بن طالوت.(@)(@@)(@@)(@@) ||| AUTO عبد السلام بن محمد الحمصي الحضرمي(@)(@@) يروي عن عبد الله بن سالم الأشعري، روى عنه الحمصيون محمد بن عوف وغيره.(@)(@@)(@@)(@@) ||| AUTO عبد السلام بن مطهر بن حسام بن المصك، أبو الظفر الأزدي(@)(@@) من أهل البصرة، يروي عن سليمان بن المغيرة وشعبة، حدثنا عنه الفضل بن الحباب الجمحي.(@)(@@)(@@)(@@) ||| AUTO عبد السلام بن عبد الحميد بن سويد(@)(@@) مولى ربيعة إمام مسجد الجامع بحران، كنيته أبو الحسين، يروي عن زهير بن معاوية، ثنا عنه أبو عروبة وأهل الجزيرة، مات سنة أربع وأربعين ومائتين، ربما أخطأ.(@)(@@)(@@)(@@) ||| AUTO عبد السلام بن عبد الرحمن بن صخر بن وابصة بن سعيد، أبو الفضل(@)(@@) يروي عن الخزريين، روى عنه أهلها، مات في المحرم سنة تسع وأربعين ومائتين. 
ms1523	(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن يوسف الجبيري، أبو حفص(@)(@@) من أهل البصرة، يروي عن أبي عاصم والبصريين، روى عنه ابنه أحمد بن عبيد الله بن يوسف الجبيري بالبصرة.(@)PageV01P002(@)(@@) [ج 5: ص 304](@)(@@)(@@)(@@) ||| AUTO عبيد الله بن جرير بن جبلة بن أبي رواد العتكي(@)(@@) من أهل البصرة، أبو عبيد الله، يروي عن أبي عاصم والبصريين، ثنا عنه محمد بن المنذر بن سعيد وغيره.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن سليمان الباهلي(@)(@@) مولى عبد الرحمن بن مسلم أخي قتيبة بن مسلم، كنيته أبو الحارث، أصله من الكوفة، سكن مرو، يروي عن الضحاك بن مزاحم، روى عنه أبو تميلة يحيى بن واضح وأبو معاذ النحوي الفضل بن خالد.(@)(@@)(@@)(@@) ||| AUTO عبيد بن حجر(@)(@@) يروي المقاطيع، روى عنه أبو أسامة محمد بن عيسى بن سميع.(@)(@@)(@@)(@@) ||| AUTO عبيد بن الوليد بن سلمان بن أبي السائب المخزومي(@)(@@) من أهل الشام، يروي عن أبيه، روى عنه محمد بن عيسى في الشاميين.(@)(@@)(@@)(@@) ||| AUTO عبيد بن عمرو، أبو عبد الرحمن الضرير(@)(@@) من أهل البصرة، كان ينزل بني عجم، يروي عن عطاء بن السائب، روى عنه محمد بن سلام البيكندي.(@)(@@)(@@)(@@) ||| AUTO عبيد بن أبي الوسيم الجمال، كنيته أبو الوسيم(@)(@@) من أهل الكوفة يروي المقاطيع، روى عنه وكيع وأبو نعيم.(@)(@@)(@@)(@@) ||| AUTO عبيد بن عبد الرحمن، أبو سلمة البصري(@)(@@) يروي عن عمرو بن يحيى بن سعيد، روى عنه البصريون.(@)(@@)(@@)(@@) ||| AUTO عبيد بن الصباح الكوفي(@)(@@) يروي عن الكوفيين، وكان راويا لكامل أبي العلاء، روى عنه أهل بلده المسروقي وغيره.(@)(@@)(@@)(@@) ||| AUTO عبيد بن حفص بن أبي ثروان، أبو حفص الثرواني(@)(@@) كوفي، يروي عن عمرو بن شمر والكوفيين، روى عنه أحمد بن موسى بن إسحاق الحمار وأهل الكوفة.(@)PageV01P002(@)(@@) [ج 5: ص 305](@)(@@)(@@)(@@) ||| AUTO عبيد بن يحيى(@)(@@) من أهل المدينة، يروي عن معان بن رفاعة بن رافع عن أبيه عن جده، روى عنه إبراهيم بن محمد بن يحيى بن هانئ السجزي، عن أبيه عنه قصة طويلة ذكرتها في الهداية.(@)(@@)(@@)(@@) ||| AUTO عبيد بن عمرو، أبو عبد الرحمن(@)(@@) يروي عن حسان بن محرش، روى عنه قتيبة 
ms1524	 بن سعيد وكتب عنه بمكة.(@)(@@)(@@)(@@) ||| AUTO عبيد بن سعيد بن أبان القرشي الأموي(@)(@@) أخو يحيى بن سعيد، يروي عن الثوري، روى عنه ابن أخيه سعيد بن يحيى بن سعيد وأبو كريب، مات سنة مائتين.(@)(@@)(@@)(@@) ||| AUTO عبيد بن ميمون، أبو عباد المزني(@)(@@) مولى هارون بن زيد بن المهاجر بن قنفذ التيمي، يروي المقاطيع، روى عنه العراقيون، مات سنة أربع ومائتين، وهو والد محمد بن عبيد بن ميمون التبان المزني.(@)(@@)(@@)(@@) ||| AUTO عبيد بن عقيل(@)(@@) من أهل البصرة، يروي عن شعبة، روى عنه ابن ابنه محمد بن عبد الله بن عبيد بن عقيل وأهل البصرة، مات في شعبان سنة سبع ومائتين.(@)(@@)(@@)(@@) ||| AUTO عبيد بن أبي قرة(@)(@@) من أهل بغداد، سكن مصر، يروي عن الليث بن سعد وابن لهيعة، روى عنه إبراهيم بن سعيد الجوهري والعراقيون، ربما خالف.(@)(@@)(@@)(@@) ||| AUTO عبيد بن إسحاق العطار، أبو عبد الرحمن الضبي(@)(@@) من أهل الكوفة، يروي عن زهير بن معاوية وشريك، روى عنه ابنه أحمد بن عبيد وأهل العراق، يغرب.(@)PageV01P002(@)(@@) [ج 5: ص 306](@)(@@)(@@)(@@) ||| AUTO عبيد بن عبيدة التمار(@)(@@) بصري، يروي عن المعتمر بن سليمان، روى عنه أحمد بن الحسن بن خراش، يغرب.(@)(@@)(@@)(@@) ||| AUTO عبيد بن يعيش(@)(@@) صاحب المحامل، من أهل الكوفة، كنيته أبو محمد، يروي عن أبي بكر بن عياش والكوفيين، روى عنه عثمان بن خرزاذ وأهل العراق، كان يخطئ، مات سنة ثمان وعشرين ومائتين.(@)(@@)(@@)(@@) ||| AUTO عبيد بن يحيى، أبو سليم(@)(@@) يروي عن أبي بكر بن عياش، روى عنه أحمد بن بزيع الرقي.(@)(@@)(@@)(@@) ||| AUTO عبيد بن عياش(@)(@@) يروي عن الأوزاعي، روى عنه أهل الشام.(@)(@@) (618) -[5: 306] حدثنا جعفر بن أحمد بن عاصم الأنصاري بدمشق، ثنا أحمد بن أبي الحواري، ثنا عبيد بن عياش، قال: قال الأوزاعي: إذا رأيته يمشي مع صاحب بدعة وحلف لك أنه على غير دأبه فلا تصدقه.(@)(@@)(@@)(@@) ||| AUTO عبيد بن هاشم(@)(@@) يروي عن شريك.(@)(@@) (619) -[5: 306] حدثني محمد بن أحمد بن علي الجزري بالموصل، ثنا أبو شيبة بن أبي بكر بن أبي شيبة، ثنا عبيد بن هاشم، ثنا شريك، عن سالم، 
ms1525	 عن سعيد بن جبير {أرأيتم إن أصبح ماؤكم غورا}، قال: لا تناله الدلاء.(@)(@@)(@@)(@@) ||| AUTO عبيد بن يحيى، أبو يحيى الطريقي(@)(@@) من أهل الكوفة، يروي عن محمد بن عمر وأبي سهل عن ابن سيرين، روى عنه إبراهيم بن إسحاق الصواف والكوفيون.(@)(@@)(@@)(@@) ||| AUTO عبيد بن جناد(@)(@@) مولى بني جعفر بن كلاب، من أهل حلب، يروي عن عبيد الله بن عمرو وعطاء بن مسلم الحلبي، حدثنا عنه أبو يعلى، مات سنة إحدى وثلاثين ومائتين.(@)(@@)(@@)(@@) ||| AUTO عبيد بن أسباط بن محمد الهمداني، أبو محمد(@)(@@) من أهل الكوفة، PageV01P002 [ج 5: ص 307] يروي عن أبيه والكوفيين، حدثنا عنه الطبري وغيره، مات سنة خمس ومائتين في شهر ربيع الأول، وكان من حلفاء قريش.(@)(@@)(@@)(@@) ||| AUTO عبيد بن معبد البصري(@)(@@) يروي عن عيسى بن شعيب وأبي عاصم، ثنا عنه الحسن بن سفيان.(@)(@@)(@@)(@@) ||| AUTO عبيد بن حيان(@)(@@) من أهل جيل، يروي عن مالك وابن لهيعة، روى عنه العباس بن الوليد بن مزيد، مستقيم الحديث.(@)(@@)(@@)(@@) ||| AUTO عبيد بن إسماعيل الهباري القرشي، كنيته أبو محمد(@)(@@) من أهل الكوفة، يروي عن أبي معاوية وأبي أسامة وأهل بلده، حدثنا عنه البختري وغيره، مات في يوم الجمعة في شهر ربيع الأول سنة خمسين ومائتين.(@)(@@)(@@)(@@) ||| AUTO عبيد بن الهيثم الحلبي(@)(@@) يروي عن جعفر بن عون، ثنا عنه الحسين بن عبد الله القطان، مستقيم الحديث.(@)(@@)(@@)(@@) ||| AUTO عبيد بن محمد الوراق(@)(@@) من أهل بغداد، يروي عن يزيد بن هارون وعلي بن عاصم، ثنا عنه محمد بن المسيب وغيره.(@)(@@)(@@)(@@) ||| AUTO عبيد بن مهدي الواسطي، أبو محمد(@)(@@) يروي عن يزيد بن هارون، ثنا عنه السلم بن معاذ بدمشق.(@)(@@)(@@)(@@) ||| AUTO عبيد بن الغازي، أبو ذهل(@)(@@) من أهل عسقلان، يروي عن أبي عاصم، ثنا عنه محمد بن أيوب بن مشكان بطبرية.(@)(@@)(@@)(@@) ||| AUTO عبيد بن عبد الواحد بن شريك البغدادي البزار(@)(@@) يروي عن أبي الوليد، كتب عنه أصحابنا.(@)PageV01P002(@)(@@) [ج 5: ص 308](@)(@@)(@@)(@@) ||| AUTO عباد بن مغرا العتكي(@)(@@) من أهل البصرة، عن عاصم بن المنذر، روى عنه القاسم بن الفضل.(@)(@@)(@@)(@@) ||| AUTO عباد بن سعيد البصري(@)(@@) يروي عن 
ms1526	 مبشر بن أبي المليح، روى عنه يحيى بن زكريا بن أبي زائدة.(@)(@@)(@@)(@@) ||| AUTO عباد بن عباد بن علقمة بن أخضر المازني(@)(@@) من أهل البصرة، يروي المقاطيع، روى عنه المعتمر بن سليمان.(@)(@@)(@@)(@@) ||| AUTO عباد بن موسى الجهني(@)(@@) يروي عن أبيه المقاطيع، روى عنه عبد الله بن داود الخريني.(@)(@@)(@@)(@@) ||| AUTO عباد بن صالح، أبو مجاهد السلمي(@)(@@) من أهل البصرة، يروي عن أبي الجلاس واسمه عقبة بن سيار، عن أبيه ووكيع، روى عنه إبراهيم بن عرعرة وعيسى بن محمد المروزي.(@)(@@)(@@)(@@) ||| AUTO عباد بن الوليد(@)(@@) يروي عن خالد الحذاء، روى عنه يحيى بن أبي بكير الكرماني.(@)(@@)(@@)(@@) ||| AUTO عباد بن عباد، أبو عتبة الخواص(@)(@@) من أهل الشام، من العباد الخشن، شهد الأوزاعي وغيره، روى عنه أهل الشام الرقائق.(@)(@@)(@@)(@@) ||| AUTO عباد بن جعفر(@)(@@) يروي عن أشعث بن عبد الملك، روى عنه عثمان بن أبي شيبة، مستقيم الحديث.(@)(@@)(@@)(@@) ||| AUTO عباد بن راشد اليماني، كنيته أبو عبد الله(@)(@@) يروي المقاطيع، روى عنه علي بن المديني.(@)PageV01P002(@)(@@) [ج 5: ص 309](@)(@@)(@@)(@@) ||| AUTO عباد بن موسى(@)(@@) شيخ، من أهل حمص، يروي عن صفوان بن عمرو والشاميين، روى عنه عمرو بن حفص الحمصي وأهل بلده، مات سنة ست ومائتين.(@)(@@)(@@)(@@) ||| AUTO عباد بن موسى السعدي(@)(@@) من أهل البصرة، كنيته أبو أيوب، يروي عن يونس بن عبيد، روى عنه بندار وأبو موسى.(@)(@@)(@@)(@@) ||| AUTO عباد بن كناسة(@)(@@) أخو محمد بن كناسة، يروي عن ابن أبي ليلى، عداده في أهل الكوفة، روى عنه أخوه محمد بن كناسة.(@)(@@)(@@)(@@) ||| AUTO عباد بن عمرو بن أبي حليمة(@)(@@) يروي عن مالك بن مغول وشعبة، روى عنه أهل العراق.(@)(@@)(@@)(@@) ||| AUTO عباد بن موسى الختلي(@)(@@) من أهل بغداد، يروي عن إبراهيم بن سعد وقران بن تمام، حدثنا عنه أبو يعلى، مات سنة ثلاثين ومائتين.(@)(@@)(@@)(@@) ||| AUTO عباد بن الوليد بن خالد العنبري، أبو بدر(@)(@@) من أهل البصرة، يروي عن أبي عاصم والبصريين، ثنا عنه حاجب بن أركين وغيره من أصحابنا.(@)(@@)(@@)(@@) ||| AUTO عبدة بن أبي برزة(@)(@@) من أهل سجستان، صحب الثوري وأخذ عنه العبادة، وكان صلبا 
ms1527	 في السنة، روى عنه أهل بلده والغرباء.(@)(@@) (620) -[5: 309] حدثنا محمد بن شاذل الهاشمي، ثنا محمد بن حميد، ثنا جرير بن عبد الحميد، عن عبدة بن أبي برزة، قال: كان جهم قد سئل عن مسألة فتحير فيها فترك الصلاة أربعين يوما.(@)(@@) (621) -[5: 309] حدثنا محمد بن صالح الطبري بالصيمرة، ثنا محمد بن حميد، ثنا جرير بن عبد الحميد، عن عبدة السجستاني، عن الصلت بن حكيم، عن أبيه، عن جده، أن أعرابيا، قال: يا رسول الله أقريب ربنا فنناجيه أم بعيد فنناديه، فأنزل الله عز وجل {وإذا سألك عبادي عني فإني قريب أجيب دعوة الداع إذا دعان}(@)(@@)(@@)(@@) ||| AUTO عبدة بن رباح(@)(@@) من أهل الشام، يروي عن عبادة بن نسي، روى عنه الوليد بن مسلم.(@)PageV01P002(@)(@@) [ج 5: ص 310](@)(@@)(@@)(@@) ||| AUTO عبدة بن عبد الرحيم المروزي، كنيته أبو سعيد(@)(@@) يروي عن ابن عيينة ووكيع، دخل الشام، فحدثهم بها، فحديثه عند أهل خراسان والشام، حدثنا عنه الحسن بن سفيان وعمر بن سعيد بن سنان.(@)(@@)(@@)(@@) ||| AUTO عبدة بن سليمان المصيصي، كنيته أبو عبد الرحمن(@)(@@) يروي عن ابن المبارك ومخلد بن الحسين، روى عنه أبو حاتم الرازي، مستقيم الحديث، وكان أصله من مرو، سكن المصيصة.(@)(@@) (622) -[5: 310] حدثني محمد بن المنذر بن سعيد، ثنا أبو حاتم الرازي، ثنا عبدة بن سليمان المروزي، ثنا مخلد بن الحسين، عن غالب القطان، أن نبي الله داود قال: لأعبدن الله عبادة، فقال في بعض الليل نامت العيون، وهدأت الألسن، فأوحى الله إلى ضفدع أن كلميه، فقالت: يا داود، أعجبت بعملك! وأنا في هذه الركية أقدس الله منذ ثلاث مائة سنة(@)(@@)(@@)(@@) ||| AUTO عبدة بن عبد الله الخزاعي، أبو سهل(@)(@@) من أهل البصرة، يروي عن يزيد بن هارون، ثنا عنه ابن خزيمة وغيره، مستقيم الحديث، مات سنة ستين ومائتين أو قبلها أو بعدها بقليل.(@)(@@)(@@)(@@) ||| AUTO عبيدة بن الأسود بن سعيد الهمداني(@)(@@) من أهل الكوفة، يروي عن القاسم بن الوليد بن مجالد بن سعيد، روى عنه يحيى بن عبد الرحمن الأرحبي، يعتبر حديثه إذا روى بين السماع في روايته وكان فوقه 
ms1528	 ودونه ثقات.(@)(@@)(@@)(@@) ||| AUTO عمر بن سالم بن عجلان الأفطس(@)(@@) مولى محمد بن مروان بن الحكم القرشي، من أهل الجزيرة، يروي عن أبيه عن سعيد بن جبير، روى عنه أبو تميلة يحيى بن واضح.(@)(@@)(@@)(@@) ||| AUTO عمر بن بكار(@)(@@) يروي عن عمرو بن الحارث، روى عنه ابن المبارك.(@)(@@)(@@)(@@) ||| AUTO عمر بن جابر اليمامي(@)(@@) أخو محمد بن جابر، يروي عن عبد الله بن بدر PageV01P002 [ج 5: ص 311] عن عبد الرحمن بن علي بن شيبان عن أبيه، روى عنه إياس بن دغفل.(@)(@@)(@@)(@@) ||| AUTO عمر بن عبد الله العبسي(@)(@@) من أهل المدينة، يروي عن عبد الرحمن بن حرملة عن سعيد بن المسيب، روى عنه سعيد بن أبي أيوب.(@)(@@)(@@)(@@) ||| AUTO عمر بن عبد الملك الكندي(@)(@@) يروي عن عمر بن عبد العزيز، روى عنه ضمرة بن ربيعة.(@)(@@)(@@)(@@) ||| AUTO عمر بن عبد الله البكري(@)(@@) يروي المقاطيع، روى عنه ابن المبارك.(@)(@@)(@@)(@@) ||| AUTO عمر بن عبد الله بن رزين السلمي(@)(@@) من أهل نيسابور، يروي عن سفيان بن حسين الغرائب، روى عنه سهل بن عمار العتكي وأهل نيسابور.(@)(@@)(@@)(@@) ||| AUTO عمر بن عبيد الصنعاني(@)(@@) يروي عن عبد الصمد بن معقل عن وهب بن منبه، روى عنه إبراهيم بن خالد الصنعاني.(@)(@@)(@@)(@@) ||| AUTO عمر بن شيبة بن أبي كثير(@)(@@) مولى أشجع، من أهل المدينة، يروي المقاطيع، روى عنه أبو أويس المدني.(@)(@@)(@@)(@@) ||| AUTO عمر بن حوشب(@)(@@) يروي عن إسماعيل بن أمية، روى عنه عبد الرزاق بن همام.(@)(@@)(@@)(@@) ||| AUTO عمر بن ذكوان(@)(@@) يروي عن داود بن بكر المقبري، روى عنه عبد الله بن نافع الصائغ.(@)(@@)(@@)(@@) ||| AUTO عمر بن بهرام(@)(@@) يروي عن عمر بن عبد العزيز، روى عنه موسى بن إسماعيل.(@)PageV01P002(@)(@@) [ج 5: ص 312](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO عمر بن زياد(@)(@@) يروي عن غيلان بن حرير، روى عنه عبد الصمد بن عبد الوارث.(@)(@@)(@@)(@@) ||| AUTO عمر بن أيوب الموصلي، كنيته أبو حفص(@)(@@) يروي عن المغيرة بن زياد، روى عنه العراقيون، مات سنة ثمان وثمانين ومائة، يعتبر حديثه من رواية الثقات عنه وروايته عن الثقات.(@)(@@) عمر بن زياد(@)(@@) من أهل الكوفة، يروي عن 
ms1529	 الأسود بن قيس، روى عنه مالك بن إسماعيل أبو غسان.(@)(@@)(@@)(@@) ||| AUTO عمر بن حفص بن عمر بن ثابت، أبو سعيد الأنصاري(@)(@@) من أهل الكوفة، يروي عن أبيه، روى عنه داود بن رشيد.(@)(@@)(@@)(@@) ||| AUTO عمر بن شوذب(@)(@@) بياع الأكسية، من أهل الكوفة، يروي المقاطيع، روى عنه وكيع ومحمد بن عبيد الطنافسي، يعتبر حديثه إذا روى عنه الثقات المشاهير فإن له رواية كثيرة عن أقوام مجاهيل وكانت فيه دعابة.(@)(@@)(@@)(@@) ||| AUTO عمر بن سهل بن مروان المازني التميمي، أبو حفص(@)(@@) من أهل البصرة، سكن مكة، يروي عن الذيال بن عبد وشعبة، روى عنه الحميدي وأهل الحجاز، ربما خالف.(@)(@@)(@@)(@@) ||| AUTO أبو داود الحفري اسمه عمر بن سعد(@)(@@) وحفر موضع بالكوفة، كان يسكنه، يروي عن الثوري، روى عنه أبو بكر بن أبي شيبة والناس، مات سنة ثلاث PageV01P002 [ج 5: ص 313] ومائتين، وقد قيل: سنة ست ومائتين، وكان من العباد الخشن، قال: عثمان بن أبي شيبة، كنا عند أبي داود الحفري في غرفته وهو يملي، فلما تمت الصحيفة، قلت: يا أبا داود أترب الكتاب، قال: لا، الغرفة بكراء.(@)(@@)(@@)(@@) ||| AUTO عمر بن طلحة بن علقمة الليثي(@)(@@) من أهل المدينة، يروي عن عبد الله بن علقمة، روى عنه علي بن المديني.(@)(@@)(@@)(@@) ||| AUTO عمر بن شقيق الجرمي(@)(@@) من أهل البصرة، كان يتجر إلى الري، يروي عن أبي جعفر الرازي، روى عنه روح بن عبد المؤمن المقرئ وابنه الحسن بن عمر بن شقيق.(@)(@@)(@@)(@@) ||| AUTO عمر بن عبد الواحد بن قيس الدمشقي السلمي، أبو حفص(@)(@@) يروي عن الأوزاعي، روى عنه عبد الرحمن بن إبراهيم وأهل الشام، كان مولده سنة ثمان عشرة، ومائة ومات سنة مائتين.(@)(@@)(@@)(@@) ||| AUTO عمر بن عبيد الجزار(@)(@@) بياع الخمر السابري، يروي عن يونس بن عبيد، روى عنه المقرئ والحميدي، وهو الذي يقال له: الفرار الذي يروي عن سهيل بن أبي صالح.(@)(@@)(@@)(@@) ||| AUTO عمر بن عثمان بن عمر التيمي(@)(@@) من أهل المدينة، كنيته أبو حفص، يروي عن أبيه عن الزهري، روى عنه إبراهيم بن المنذر الخزاعي، مستقيم الحديث.(@)(@@)(@@)(@@) ||| AUTO عمر 
ms1530	 بن عمير، أبو الخطاب الهجري(@)(@@) يروي عن عزرة بن فيروز، روى عنه ابن عيينة.(@)(@@)(@@)(@@) ||| AUTO عمر العنزي(@)(@@) شيخ، يروي عن عمر بن عبد العزيز قوله، روى عنه قتادة بن دعامة، أدخلناه في هذه الطبقة لأنه لا نعلم له رواية إلا هذا الحرف الذي حكاه عن عمر بن PageV01P002 [ج 5: ص 314] عبد العزيز وما رواه عنه إلا قتادة حكاية لا يحسن ذكرها.(@)(@@)(@@)(@@) ||| AUTO عمر بن فروخ القتاب العبدي(@)(@@) يروي عن بسطام بن النضر، روى عنه أبو نعيم والحوضي.(@)(@@)(@@)(@@) ||| AUTO عمر بن درهم القريعي(@)(@@) من عباد أهل الكوفة، ليس له حديث مسند يرجع له، روى عنه خالد بن يزيد القسام: دخل الجبان ومعه ابنه وهو معصوب العين، فوطئ على قبر، فقال: أين أنا يا بني؟ قال: في الجبان يا أبة! قال: هاه تم، فخر ميتا.(@)(@@)(@@)(@@) ||| AUTO عمر بن فرقد الباهلي(@)(@@) يروي عن عطاء بن السائب، روى عنه موسى بن إسماعيل.(@)(@@)(@@)(@@) ||| AUTO عمر بن زياد المديني(@)(@@) يروي المقاطيع، روى عنه يعقوب بن حميد بن كاسب.(@)(@@)(@@)(@@) ||| AUTO عمر بن المرقع بن صيفي التيمي(@)(@@) من أهل الكوفة، يروي عن الثوري والكوفيين، روى عنه أبو الوليد الطيالسي.(@)(@@)(@@)(@@) ||| AUTO عمر بن معدان(@)(@@) من أهل البصرة، يروي عن عمران القصير، روى عنه أيوب بن سليمان بن بلال.(@)(@@)(@@)(@@) ||| AUTO عمر بن سنان العقيلي(@)(@@) من أهل البصرة، يروي عن يونس بن عبيد، روى عنه البصريون، يغرب.(@)(@@)(@@)(@@) ||| AUTO عمر بن الوليد الشني العبدي(@)(@@) من عبد القيس، كنيته أبو سلمة، من أهل البصرة، يروي عن يونس بن عبيد والبصريين، روى عنه وكيع.(@)PageV01P002(@)(@@) [ج 5: ص 315](@)(@@)(@@)(@@) ||| AUTO عمر بن مالك(@)(@@) شيخ، يروي عن صفوان بن سليم، روى عنه عبد الله بن وهب.(@)(@@)(@@)(@@) ||| AUTO عمر بن صالح البصري(@)(@@) يروي عن سعيد بن أبي عروبة، روى عنه صفوان بن صالح الدمشقي الحكايات.(@)(@@)(@@)(@@) ||| AUTO عمر بن يحيى بن حفص بن عمر بن عباد التيمي(@)(@@) من أهل سرخس، يروي عن ابن عيينة وجرير بن عبد الحميد، روى عنه محمد بن المهلب السرخسي وأهل بلده.(@)(@@)(@@)(@@) ||| AUTO عمر بن زرارة الحدثي، 
ms1531	 أبو حفص(@)(@@) حدث ببغداد، يروي عن عيسى بن يونس، روى عنه أحمد بن سعيد الدارمي.(@)(@@)(@@)(@@) ||| AUTO عمر بن عبد الغفار الصنعاني(@)(@@) يروي عن ابن عيينة، روى عنه محمد بن حبان الصنعاني وأهل بلده، من خيار عباد الله ممن أظهر السنة في بلاده ودعا الناس إليها مع تورع شديد وضبط عتيد.(@)(@@)(@@)(@@) ||| AUTO عمر بن خالد الرقي(@)(@@) يروي عن موسى بن أعين، روى عنه ابنه سليمان بن عمر بن خالد.(@)(@@)(@@)(@@) ||| AUTO عمر بن سعد الدمشقي(@)(@@) يروي عن سعيد بن عبد العزيز، روى عنه إبراهيم بن الجنيد وأهل الشام.(@)(@@)(@@)(@@) ||| AUTO عمر بن عمرو بن ميمون بن مهران(@)(@@) يروي عن أبيه، روى عنه ذبيان بن حكيم الكوفي.(@)(@@)(@@)(@@) ||| AUTO عمر بن ميمون القيسي(@)(@@) من أهل البصرة، يروي عن عدي بن أبي القلوص، روى عنه محمد بن عقبة السدوسي.(@)PageV01P002(@)(@@) [ج 5: ص 316](@)(@@)(@@)(@@) ||| AUTO عمر بن يزيد السعدي(@)(@@) من أهل البصرة، يروي المقاطيع، روى عنه أبو عبيدة الحداد.(@)(@@)(@@)(@@) ||| AUTO عمر بن عبد الحميد الراسبي(@)(@@) يروي عن أبي هلال والربيع بن صبيح، وكان شيخا صالحا، من أهل سرخس، وكان شيخا صالحا، من أهل سرخس، روى عنه محمد بن المهلب السرخسي وأهل بلده.(@)(@@)(@@)(@@) ||| AUTO عمر بن هرمز(@)(@@) يروي عن الربيع بن أنس وإبراهيم الصائغ، روى عنه إسحاق بن إبراهيم الحنظلي ومحمد بن يحيى بن أيوب القصيري.(@)(@@)(@@)(@@) ||| AUTO عمر بن يونس بن القاسم الحنفي اليمامي(@)(@@) يروي عن عكرمة بن عمار، روى عنه العراقيون والغرباء، يتقي حديثه من رواية أحمد بن محمد بن عمر بن يونس اليمامي ابن ابنه، هذا لأنه يقلب الأخبار.(@)(@@)(@@)(@@) ||| AUTO عمر بن مرة(@)(@@) من أهل البصرة، يروي عن بلال بن يسار، روى عنه ابنه حفص بن مرة.(@)(@@)(@@)(@@) ||| AUTO عمر بن عبد الوهاب بن رياح بن عبيدة الرياحي(@)(@@) من أهل البصرة، كنيته أبو حفص، يروي عن يزيد بن زريع والبصريين، روى عنه محمد بن إسماعيل البخاري، مات لأيام بقين من شعبان سنة إحدى وعشرين ومائتين.(@)(@@)(@@)(@@) ||| AUTO عمر بن حفص بن غياث النخعي(@)(@@) من أهل الكوفة، يروي عن أبيه والكوفيين، 
ms1532	 روى عنه أبو حاتم الرازي، مات سنة ثنتين وعشرين ومائتين، ربما أخطأ.(@)PageV01P002(@)(@@) [ج 5: ص 317](@)(@@)(@@)(@@) ||| AUTO عمر بن موسى الشامي، أبو حفص الحادي(@)(@@) ويقال له: السياري، من أهل البصرة، يروي عن حماد بن سلمة، ثنا عنه عبدان الجواليقي، ربما أخطأ، مات سنة أربعين ومائتين(@)(@@)(@@)(@@) ||| AUTO عمر بن إبراهيم العبدي(@)(@@) يروي عن قتادة، روى عنه ابنه الخليل بن عمر بن إبراهيم، يخطئ ويخالف.(@)(@@)(@@)(@@) ||| AUTO عمر بن شبة بن عبيدة بن زيد بن رابطة النميري، كنيته أبو زيد(@)(@@) من أهل البصرة، يروي عن عبد الوهاب بن عبد المجيد الثقفي، حدثنا عنه حاجب بن أركين الفرغاني بدمشق وغيره، مستقيم الحديث، وكان صاحب أدب وشعر وأخبار ومعرفة بتاريخ الناس.(@)(@@)(@@)(@@) ||| AUTO عمر بن يزيد السياري، أبو حفص(@)(@@) من أهل البصرة، يروي عن عاصم بن هلال وابن أبي عدي، حدثنا عنه عمر بن الحسن بن سفيان وغيره، مستقيم الحديث، مات سنة بضع وأربعين ومائتين.(@)(@@)(@@)(@@) ||| AUTO عمر بن حفص السياري(@)(@@) يروي عن عبيد الله بن موسى، وكان راويا لابن وهب، حدثنا عنه محمد بن يعقوب بن الخطيب بالأهواز.(@)(@@)(@@)(@@) ||| AUTO عمر بن أبي الرطيل(@)(@@) من أهل الكوفة، يروي عن عبد الرحمن بن عبد الملك بن أبجر والكوفيين، روى عنه محمد بن سليمان وهو عمر بن عبد الله بن سليمان بن أبي الرطيل.(@)PageV01P002(@)(@@) [ج 5: ص 318](@)(@@)(@@)(@@) ||| AUTO عمر بن شعيب، أبو شعيب(@)(@@) من أهل الكوفة، يروي عن ابن المبارك، روى عنه يعقوب بن سفيان.(@)(@@)(@@)(@@) ||| AUTO عمر بن حفص الشيباني(@)(@@) من أهل البصرة، يروي عن أبي عاصم والبصريين، ثنا عنه محمد بن يعقوب بالأهواز.(@)(@@)(@@)(@@) ||| AUTO عمر بن الخطاب السجستاني، أبو حفص(@)(@@) سكن الأهواز، يروي عن أبي عاصم وأبي الوليد وأهل العراق والشام، حدثنا عنه أحمد بن يحيى بن زهير بتستر وغيره، مستقيم الحديث.(@)(@@)(@@)(@@) ||| AUTO عمر بن محمد بن الحسن بن الزبير الأسدي(@)(@@) يقال له: ابن التل، من أهل الكوفة، يروي عن وكيع والكوفيين، ثنا عنه شيوخنا ابن خزيمة وغيره، مات سنة خمسين ومائتين، يعتبر حديثه ما حدث من كتاب أبيه فإن في 
ms1533	 روايته التي كان يرويها من حفظه بعض المناكير.(@)(@@)(@@)(@@) ||| AUTO عمر بن نصر(@)(@@) من أهل نهاوند، يروي عن يزيد بن هارون، روى عنه أهل العراق.(@)(@@)(@@)(@@) ||| AUTO عمر بن حفص بن بسطام بن عمرو الباهلي، أبو حفص(@)(@@) من أهل سمرقند، يروي عن أبي نعيم وأبي الوليد، روى عنه أهل بلده، مات بسمرقند يوم الإثنين المنتصف من ذي القعدة سنة تسع وستين ومائتين.(@)(@@)(@@)(@@) ||| AUTO عمر بن عبد الله بن أبي عرابة الشاشي(@)(@@) يروي عن علي بن حجر السعدي، روى عنه أهل بلده، مات سنة ثمان وخمسين ومائتين.(@)(@@)(@@)(@@) ||| AUTO عمر بن حفص السدوسي(@)(@@) من أهل البصرة، يروي عن أبي الوليد الطيالسي والبصريين، كتب عنه أصحابنا.(@)PageV01P002(@)(@@) [ج 5: ص 319](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO عثمان بن جبلة بن أبي رواد(@)(@@) أخو عبد العزيز بن أبي رواد، من أهل البصرة، يروي المقاطيع، كنيته أبو عبد الله والبصريين، كتب عنه أصحابنا.(@)(@@) عثمان بن جبلة بن أبي رواد(@)(@@) أخو عبد العزيز بن أبي رواد، من أهل البصرة، يروي المقاطيع، كنيته أبو عبد الله، يروي عن عبد الملك بن أبي نضرة عن أبيه عن أبي سعيد الخدري نسخة مسندة، روى عنه أولاده والبصريون، كتب عنه شعبة.(@)(@@)(@@)(@@) ||| AUTO عثمان بن خالد بن الزبير(@)(@@) يروي عن محمد بن عمرو بن علقمة، روى الليث بن سعد عن يحيى بن أبي أسيد عنه.(@)(@@)(@@)(@@) ||| AUTO عثمان بن طلحة بن عمر بن عبيد الله بن معمر القرشي(@)(@@) يروي عن ابن أبي ذئب، روى عنه إبراهيم بن المنذر الحزامي.(@)(@@)(@@)(@@) ||| AUTO عثمان بن إسحاق(@)(@@) يروي عن عبد المجيد بن أبي عبس، عداده في أهل المدينة، روى عنه ابن أبي فديك.(@)(@@)(@@)(@@) ||| AUTO عثمان بن شبرمة(@)(@@) من أهل الكوفة، يروي عن عاصم بن أبي النجود، روى عنه محمد بن فضيل بن غزوان.(@)(@@)(@@)(@@) ||| AUTO عثمان بن زيد الشامي(@)(@@) يروي المقاطيع، روى عنه معمر بن راشد.(@)(@@)(@@)(@@) ||| AUTO عثمان بن قيس بن محمد بن الأشعث الكندي(@)(@@) يروي عن أبيه، روى عنه حفص بن غياث، وقيس لم يسمع من أبيه.(@)(@@)(@@)(@@) ||| AUTO عثمان بن سعيد بن أبان القرشي 
ms1534	(@)(@@) يروي عن أبي فروة، روى عنه محمد بن عيسى بن الطباع.(@)(@@)(@@)(@@) ||| AUTO عثمان بن عمرو بن ساج الحراني(@)(@@) أخو الوليد بن عمرو بن ساج، يروي عن خصيف ويعقوب بن عطاء، روى عنه أهل بلده، وهو الذي يروي عنه المعتمر بن سليمان، ويقول: حدثني عثمان بن ساج المروزي.(@)PageV01P002(@)(@@) [ج 5: ص 320](@)(@@)(@@)(@@) ||| AUTO عثمان بن عبد الرحمن بن علاق القرشي(@)(@@) من أهل دمشق، كنيته أبو عبد الرحمن، يروي عن زيد بن واقد والشاميين، روى عنه الهيثم بن خارجة، وليس هذا بعثمان بن عبد الرحمن الذي يقال له: الطريفي، ذاك حراني واه، وهذا دمشقي، مستقيم الحديث.(@)(@@)(@@)(@@) ||| AUTO عثمان بن سعيد بن كثير بن دينار القرشي(@)(@@) من أهل حمص، يروي عن شعيب بن أبي حمزة وأبي غسان محمد بن مطرف، روى عنه ابناه عمرو ويحيى بن عثمان، مات سنة تسع ومائتين.(@)(@@)(@@)(@@) ||| AUTO عثمان بن محصن بن علاق القرشي(@)(@@) من أهل الشام، يروي عن زيد بن واقد، روى عنه الهيثم بن خارجة.(@)(@@)(@@)(@@) ||| AUTO عثمان بن سعيد المري(@)(@@) جار أبي غسان النهدي، من أهل الكوفة، كنيته أبو علي، وقد قيل: أبو عبد الله، يروي عن الحسن بن صالح بن حي والكوفيين، روى عنه ابن أبي شيبة وأهل العراق.(@)(@@)(@@)(@@) ||| AUTO عثمان بن يسار(@)(@@) يروي عن المغيرة بن مقسم، روى عنه جرير بن عبد الحميد الضبي.(@)(@@)(@@)(@@) ||| AUTO عثمان بن أبي هند العبسي(@)(@@) من أهل الكوفة، يروي عن عمر بن عبد العزيز، روى عنه وكيع وأبو نعيم.(@)(@@)(@@)(@@) ||| AUTO عثمان بن فرقد(@)(@@) يروي عن جعفر بن محمد، روى عنه زيد بن أخزم الطائي.(@)(@@)(@@)(@@) ||| AUTO عثمان بن سوادة العبسي(@)(@@) يروي عن عمران القطان أبي العوام قال: ما رأيت الحسن قط إلا وكان رواها عنه أبو عاصم النبيل.(@)PageV01P002(@)(@@) [ج 5: ص 321](@)(@@)(@@)(@@) ||| AUTO عثمان بن اليمان بن هارون(@)(@@) أصله من هراة، سكن مكة، يروي عن الثوري وزمعة بن صالح وهشام بن زياد، روى عنه الحجازيون وأهل العراق، ربما أخطأ.(@)(@@)(@@)(@@) ||| AUTO عثمان بن معاوية القرشي(@)(@@) يروي عن أبيه، روى عنه قراد أبو نوح.(@)(@@)(@@)(@@) ||| AUTO عثمان بن 
ms1535	 المنذر(@)(@@) يروي عن القاسم بن محمد الثقفي، عداده في أهل الشام، روى عنه الوليد بن مسلم.(@)(@@)(@@)(@@) ||| AUTO عثمان بن قيس الكلابي(@)(@@) يروي عن أبي أيوب الهجري، روى عنه وكيع بن الجراح.(@)(@@)(@@)(@@) ||| AUTO عثمان بن عصام(@)(@@) يروي عن أبيه المقاطيع، روى عنه بسطام بن وائل.(@)(@@)(@@)(@@) ||| AUTO عثمان بن عمر بن فارس بن لقيط البصري، كنيته أبو عبد الله(@)(@@) أصله من بخارا، يروي عن يونس بن يزيد الأيلي وشعبة بن الحجاج، روى عنه أحمد بن حنبل وأهل العراق، مات سنة تسع ومائتين يوم الأحد لثمان بقين من شهر ربيع الأول، وصلى عليه يحيى بن أكثم وهو على قضاء البصرة يومئذ.(@)(@@)(@@)(@@) ||| AUTO عثمان بن عمر بن عثمان التيمي(@)(@@) من أهل البصرة، يروي عن عيسى بن يونس والبصريين، ثنا عنه الحسن بن سفيان.(@)(@@)(@@)(@@) ||| AUTO عثمان بن عمرو الكحال(@)(@@) يروي عن ابن أبي زائدة، روى عنه أهل الكوفة.(@)(@@) (623) -[5: 321] حدثنا محمد بن المنذر بن سعيد، ثنا كثير بن عبد الله التميمي، ثنا عثمان بن عمرو الكحال، عن ابن أبي زائدة، عن مجالد، عن الشعبي، قال: لا تمضي الأيام والليالي حتى ينتقل العلم إلى خراسان.(@)PageV01P002(@)(@@) [ج 5: ص 322](@)(@@)(@@)(@@) ||| AUTO عثمان بن الحكم الجذامي(@)(@@) من أهل مصر، يروي عن ابن جريج وهو الذي أقدم علم ابن جريج بمصر، روى عنه الليث بن عاصم القتباني وأهل مصر.(@)(@@)(@@)(@@) ||| AUTO عثمان بن مكتل(@)(@@) من أهل مصر، من ثقات المسلمين ومتقنيهم، يروي عن عبيد الله بن عمر وأهل المدينة، روى عنه أهل مصر.(@)(@@) (624) -[5: 322] حدثني عمر بن محمد الهمداني من كتابه، ثنا محمد بن داود بن ناجية، ثنا زياد بن يونس، ثنا عثمان بن مكتل، عن عبيد الله بن عمر، قال: دفع إلى ابن شهاب صحيفة، فقال: انسخ ما فيها وحدث عني، فقلت: ويجوز ذلك؟ قال: نعم، ألم تر الرجل يشهد على الوصية ولا يفتحها فيجوز ذلك، ويؤخذ به.(@)(@@)(@@)(@@) ||| AUTO عثمان بن سعيد، المعروف بورش(@)(@@) من أهل مصر، يروي عن نافع بن أبي نعيم القارئ، وكان عالما بقراءة أهل المدينة، صاحب أخبار ودراية، روى 
ms1536	 عنه أهل مصر.(@)(@@)(@@)(@@) ||| AUTO عثمان بن زفر بن مزاحم بن زفر التيمي(@)(@@) من أهل الكوفة، كنيته أبو زفر، يروي عن أبي بكر بن عياش وزهير بن معاوية والكوفيين، روى عنه هناد بن السري، مات سنة ثمان عشرة ومائتين.(@)(@@)(@@)(@@) ||| AUTO عثمان بن الضحاك بن عثمان القرشي الحزامي(@)(@@) من أهل المدينة، يروي عن أبيه، روى عنه المدنيون.(@)(@@)(@@)(@@) ||| AUTO عثمان بن عمران الحنفي(@)(@@) يروي عن ابن جريج، روى عنه محمد بن حرب النسائي، ربما أغرب، يعتبر حديثه إذا بين السماع في خبره.(@)(@@)(@@)(@@) ||| AUTO عثمان بن عبد الوهاب بن عبد المجيد الثقفي(@)(@@) من أهل البصرة، يروي عن أبيه، روى عنه عباس بن محمد الدوري.(@)PageV01P002(@)(@@) [ج 5: ص 323](@)(@@)(@@)(@@) ||| AUTO عثمان بن مخلد التمار(@)(@@) من أهل واسط، يروي عن هشيم، روى عنه محمد بن عبد الملك الدقيقي.(@)(@@)(@@)(@@) ||| AUTO عثمان بن صالح بن صفوان السهمي(@)(@@) من أهل مصر، كنيته أبو يحيى، يروي عن مالك بن أنس، وكان راويا لابن وهب، روى عنه محمد بن سهل بن عسكر وابنه يحيى بن عثمان بن صالح.(@)(@@)(@@)(@@) ||| AUTO عثمان بن الهيثم بن الجهم المؤذن، كنيته أبو عمرو العبدي(@)(@@) من أهل البصرة، كان مؤذن مسجد الجامع بها، يروي عن هشام بن حسان وابن جريج، حدثنا عنه أبو خليفة، مات سنة عشرين ومائتين.(@)(@@)(@@)(@@) ||| AUTO عثمان بن سعيد بن حماد بن زهدم الغفاري(@)(@@) من أهل مكة، يروي عن ابن عيينة وبشر بن السري، روى عنه أبو الحسين عبد الله بن المرزبان.(@)(@@)(@@)(@@) ||| AUTO عثمان بن محمد بن أبي شيبة العبسي(@)(@@) من أهل الكوفة، كنيته أبو الحسن، أخو أبي بكر والقاسم بنو أبي شيبة، يروي عن شريك، حدثنا عنه السجستاني وغيره من شيوخنا، مات سنة تسع وثلاثين ومائتين.(@)(@@)(@@)(@@) ||| AUTO عثمان بن طالوت بن عباد الجحدري(@)(@@) من أهل البصرة، يروي عن عبد الوهاب الثقفي وأبي عاصم وأهل بلده، وكان أحفظ من أبيه، حدثنا عنه محمد بن علي الصيرفي غلام طالوت بن عباد، مات وهو شاب ولم يتمتع بعلمه في سنة أربع وثلاثين ومائتين.(@)(@@)(@@)(@@) ||| AUTO عثمان بن صالح بن 
ms1537	 سعيد بن يحيى الخياط المرزوي(@)(@@) مولى بني كنانة، PageV01P002 [ج 5: ص 324] كنيته أبو القاسم، حدث ببغداد، يروي عن يزيد بن هارون، حدثنا عنه محمد بن المسيب، حسن الاستقامة في الرواية.(@)(@@)(@@)(@@) ||| AUTO عثمان بن مروان القرشي الأنماطي(@)(@@) من أهل الكوفة، يروي عن عصام بن قدامة، روى عنه يعقوب بن سفيان.(@)(@@)(@@)(@@) ||| AUTO عثمان بن سعيد، أبو وهب(@)(@@) من أهل نصيبين، يروي عن أبي نعيم وأهل العراق، حدثنا عنه جماعة بنصيبين.(@)(@@)(@@)(@@) ||| AUTO عثمان بن يحيى بن سعيد القرقساني(@)(@@) إمام مسجد قرقيسيا، كنيته أبو عمرو الصياد، يروي عن ابن عيينة، حدثنا عنه أحمد بن محمد بن الأزهر السجستاني، مات سنة ثمان وخمسين ومائتين.(@)(@@)(@@)(@@) ||| AUTO عثمان بن حفص التومني(@)(@@) من أهل الأهواز، يروي عن أبي عاصم وأهل البصرة، حدثنا عنه أهل الأهواز، يغرب.(@)(@@)(@@)(@@) ||| AUTO عثمان بن سعيد الواسطي(@)(@@) يروي عن أبي نعيم ويزيد، ثنا عنه علي بن أحمد بن عتبة، يغرب.(@)(@@)(@@)(@@) ||| AUTO عثمان بن صالح البغدادي(@)(@@) شيخ، يروي عن أبي عاصم، ثنا عنه محمد بن إسحاق الثقفي، وزعم أنه كان ثقة.(@)(@@)(@@)(@@) ||| AUTO عثمان بن سعيد الدارمي، أبو سعيد السجستاني(@)(@@) سكن هراة، أحد أئمة الدنيا، يروي عن أبي الوليد وأهل العراق، حدثنا عنه ابنه محمد بن عثمان بن سعيد، مات سنة إحدى وثمانين ومائتين أو ثمانين ومائتين.(@)(@@)(@@)(@@) ||| AUTO عثمان بن عمر الضبي البصري(@)(@@) يروي عن أبي الوليد الطيالسي، كتب عنه أصحابنا.(@)PageV01P002(@)(@@) [ج 5: ص 325](@)(@@)(@@)(@@) ||| AUTO عثمان بن خرزاذ الأنطاكي، أبو جعفر(@)(@@) عن أبي الوليد، حدثنا عنه وصيف وغيره.(@)(@@)(@@)(@@) ||| AUTO علي بن عمر بن علي بن الحسين بن علي بن أبي طالب الهاشمي(@)(@@) من أهل المدينة، يروي عن أبيه عن علي بن الحسين، روى عنه ابن الهاد، لست أحفظ له عن تابعي سماعا قد رآه فلذلك أدخلناه في هذه الطبقة، يعتبر حديثه من غير رواية أولاده عنه.(@)(@@)(@@)(@@) ||| AUTO علي بن مالك(@)(@@) شيخ، من أهل الكوفة، يروي عن الضحاك بن مزاحم، روى عنه وكيع بن الجراح.(@)(@@)(@@)(@@) ||| AUTO علي بن بحير(@)(@@) يروي عن أبيه، روى عنه إبراهيم بن نشيط اللؤلؤي.(@)(@@)(@@)(@@) ||| AUTO 
ms1538	 علي بن ثابت الجزري(@)(@@) مولى العباس بن محمد الهاشمي، كنيته أبو الحسن، يروي عن عبد الحميد بن جعفر، روى عنه علي بن حجر السعدي وأهل الجزيرة، ربما أخطأ.(@)(@@)(@@)(@@) ||| AUTO علي بن موسى الرضا وهو علي بن موسى بن جعفر بن محمد بن علي بن الحسين بن علي بن أبي طالب، أبو الحسن(@)(@@) من سادات أهل البيت وعقلائهم، وجلة الهاشميين ونبلائهم، يجب أن يعتبر حديثه إذا روى عنه غير أولاده وشيعته وأبي الصلت خاصة، فإن الأخبار التي رويت عنه وبين بواطيل إنما الذنب فيها لأبي الصلت ولأولاده وشيعته، لأنه في نفسه كان أجل من أن يكذب، ومات علي بن موسى الرضا بطوس من شربة سقاه إياها المأمون فمات من ساعته، وذلك في يوم السبت آخر يوم سنة ثلاث ومائتين، وقبره بسناباذ خارج النوقان، مشهور يزار، بجنب قبر الرشيد، قد زرته مرارا كثيرة وما حلت PageV01P002 [ج 5: ص 326] بي شدة في وقت مقامي بطوس، فزرت قبر علي بن موسى الرضا صلوات الله على جده، وعليه ودعوت الله إزالتها عني إلا أستجيب لي، وزالت عني تلك الشدة، وهذا شيء جربته مرارا فوجدته كذلك، أماتنا الله على محبة المصطفي وأهل بيته صلى الله عليه وسلم الله عليه وعليهم أجمعين.(@)(@@)(@@)(@@) ||| AUTO علي بن جبلة الحضرمي(@)(@@) من أهل الكوفة، كنيته أبو الحسن، يروي عن سالم وابن أبي مريم، روى عنه أبو قدامة عبيد الله بن سعيد السرخسي.(@)(@@)(@@)(@@) ||| AUTO علي بن ثابت العطار(@)(@@) من أهل الكوفة مولى العباس بن محمد، يروي عن الحكم بن عبد الملك عن قتادة، روى عنه صاعقة والكوفيون.(@)(@@)(@@)(@@) ||| AUTO علي بن حمزة الكسائي المقرئ، كنيته أبو الحسن(@)(@@) يروي عن الأعمش وعاصم بن أبي النجود، روى عنه أبو عبيد وأهل العراق، مستقيم الحديث، مات بالري سنة تسع وثمانين ومائة برنبويه، قرية من قراها مع محمد بن الحسن الشيباني في يوم واحد.(@)(@@)(@@)(@@) ||| AUTO علي بن نفيل الحراني(@)(@@) جد أبي جعفر، يروي عن أهل بلده والغرباء، روى عنه أهل الجزيرة.(@)(@@)(@@)(@@) ||| AUTO علي بن سحيم الباهلي(@)(@@) يروي عن 
ms1539	 ابن عون، روى عنه أبو الوليد الطيالسي.(@)(@@)(@@)(@@) ||| AUTO علي بن عبد الله بن راشد العامري، أبو الحسن(@)(@@) من ساكن الري، يروي عن عبد الكريم الجزري، روى عنه الحكم ابن المبارك الخاشتي.(@)(@@)(@@)(@@) ||| AUTO علي بن عبد الرحمن بن عثمان(@)(@@) يروي عن حكيم بن محمد، روى عنه ابن أبي فديك.(@)(@@)(@@)(@@) ||| AUTO علي بن علي المدني(@)(@@) مولى مزينة، يروي عن الحسن بن زيد بن حسن بن علي بن أبي طالب، روى عنه زياد بن يونس الإسكندراني.(@)PageV01P002(@)(@@) [ج 5: ص 327](@)(@@)(@@)(@@) ||| AUTO علي بن مهران المروزي(@)(@@) يروي عن عبد الله بن المبارك وأبي حمزة السكري، روى عنه علي بن الحسن بن شقيق.(@)(@@)(@@)(@@) ||| AUTO علي بن عبد الله بن بعجة بن عبد الله بن بدر الجهني(@)(@@) من أهل المدينة، يروي عن أبيه عن جده، روى عنه إبراهيم بن علي الرافعي.(@)(@@)(@@)(@@) ||| AUTO علي بن عوف(@)(@@) يروي عن أيوب بن سحيم، عداده في أهل الكوفة، روى عنه أبو أسامة.(@)(@@)(@@)(@@) ||| AUTO علي بن مجاهد الرازي(@)(@@) من سبى كابل، كنيته أبو مجاهد العبدي، يروي عن محمد بن إسحاق وعنبسة بن سعيد، روى عنه محمد بن حميد الرازي وأهل بلده.(@)(@@)(@@)(@@) ||| AUTO علي بن قادم الخزاعي(@)(@@) من أهل الكوفة، يروي عن الثوري، روى عنه أبو بكر بن أبي شيبة وأهل العراق.(@)(@@)(@@)(@@) ||| AUTO علي بن يونس البلخي العابد(@)(@@) (625) -[5: 327] يروي عن هشام بن الغاز، عن نافع، عن ابن عمر، عن النبي صلى الله عليه وسلم قال: لا تشد المطايا إلا إلى ثلاثة مساجد مسجد الحرام ومسجدي هذا والمسجد الأقصى، حدثناه عمران بن موسى المهرجاني بطرسوس، ثنا محمد بن يزيد بن محمش، ثنا علي بن يونس، ثنا هشام بن الغاز(@)(@@)(@@)(@@) ||| AUTO علي بن القاسم الكندي(@)(@@) من أهل الكوفة، يروي عن المسور بن الصلت، روى عنه الكوفيون.(@)(@@)(@@)(@@) ||| AUTO علي بن علي الحميدي(@)(@@) يروي عن زياد بن أبي زياد، روى عنه أبو جعفر النفيلي.(@)PageV01P002(@)(@@) [ج 5: ص 328](@)(@@)(@@)(@@) ||| AUTO علي بن نصر بن علي الجهضمي الأزدي، كنيته أبو الحسن(@)(@@) من أهل البصرة، يروي عن شعبة بن الحجاج، روى عنه ابنه 
ms1540	 نصر بن علي الجهضمي، مات سنة سبع وثمانين ومائة.(@)(@@)(@@)(@@) ||| AUTO علي بن عياش بن مسلم الألهاني الحمصي(@)(@@) من أهل حمص، يروي عن شعيب بن أبي حمزة، روى عنه يحيى بن أكثم وأهل العراق، وكان مولده سنة ثلاث وأربعين ومائة، ومات سنة تسع عشرة ومائتين، وكان متقنا.(@)(@@)(@@)(@@) ||| AUTO علي بن الحسين بن واقد(@)(@@) مولى عبد الله بن عامر بن كريز، كنيته أبو الحسن، من أهل مرو، يروي عن أبيه، روى عنه أهل بلده، وكان مولده سنة ثلاثين ومائة، ومات سنة إحدى عشرة ومائتين، وقيل: سنة اثنتي عشرة ومائتين.(@)(@@)(@@)(@@) ||| AUTO علي بن الحسن بن شقيق، كنيته أبو عبد الرحمن(@)(@@) مولى عبد القيس، من أهل مرو، يروي عن ابن المبارك وأبي حمزة، روى عنه ابنه محمد بن علي بن الحسن، كان مولده سنة سبع وثلاثين ومائة ليلة، قتل أبو مسلم بالمدائن، مات سنة إحدى عشرة ومائتين وهو ابن ثمان وسبعين سنة.(@)(@@)(@@)(@@) ||| AUTO علي بن هارون الزينبي(@)(@@) يروي عن مسلم بن خالد الزنجي، روى عنه يوسف بن سعيد بن مسلم.(@)(@@)(@@)(@@) ||| AUTO علي بن زبيد بن عامر الطائي(@)(@@) كوفي، يروي عن فياض بن الأسود ومحل بن PageV01P002 [ج 5: ص 329] خليفة، روى عنه طلق بن غنام والكوفيون.(@)(@@)(@@)(@@) ||| AUTO علي بن زفر التميمي(@)(@@) من عباد أهل الكوفة، يروي عن جماعة من الكوفيين، روى عنه جامع بن شريك.(@)(@@)(@@)(@@) ||| AUTO علي بن أبي بكر الإسفذني(@)(@@) من أهل الري إسفذن قرية من قراها، يروي عن همام بن يحيى، روى عنه محمد بن عبيد الهمداني ومحمد بن حميد الرازي.(@)(@@)(@@)(@@) ||| AUTO علي بن خالد العابد(@)(@@) من أهل بخارا، يروي عن فضيل بن عياض، روى عنه حفص بن داود الربعي.(@)(@@)(@@)(@@) ||| AUTO علي بن أبي طالب البزار(@)(@@) من أهل البصرة.(@)(@@) (626) -[5: 329] يروي عن الوقاصي، عن مكحول، عن حذيفة، عن النبي صلى الله عليه وسلم: الندم توبة، حدثناه الحسن بن محمد بن أسد بفم الصلح، ثنا إبراهيم بن فهد، ثنا علي بن أبي طالب(@)(@@)(@@)(@@) ||| AUTO علي بن إسحاق المروزي، أبو الحسن(@)(@@) يروي عن ابن المبارك، روى عنه 