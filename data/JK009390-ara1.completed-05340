ms5321	 عن علي رضي الله عنه :(@)(@@) | 30 ( أن النبي كان يجنب من الليل فلا يمس ماء حتى يصبح ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 7170 عن أبي فاختة :(@)(@@) | 30 ( أن عليا رضي الله عنه كان يستحب أن يغتسل من الحجامة ) . ( عب ) . )(@)(@@)(@@)(@@) $ 7171 عن إبراهيم :(@)(@@) | 30 ( أن عليا رضي الله عنه كان يغتسل إذا خرج من الحمام ) . ( عب ) . )(@)(@@)(@@)(@@) $ 7172 عن علي رضي الله عنه قال :(@)(@@) | 30 ( رأى النبي ناسا يغتسلون في النهر عراة ليس عليهم أزر ، فوقف فنادى بأعلاى صوته فقال : ما لكم لا ترجون لله وقارا ) . ( عب ) . )(@)(@@)(@@)(@@) $ 7173 عن علي رضي الله عنه قال :(@)(@@) | 30 ( كان رسول الله يقرئنا القرآن علاى كل حال إلا الجنابة ، فإن كان جنبا لم يقرئنا شيئا ) . ( أبو عبيدة في فضائله ، ش والعدني ، ع ، وابن جرير وصححه ) . )(@)(@@) PageV16P090(@)(@@)(@@)(@@) $ 7174 عن علي رضي الله عنه قال :(@)(@@) | 30 ( الجنب لا يأكل شيئا حتى يتوضأ وضوءه للصلاة ) . ( ص ) . )(@)(@@)(@@)(@@) $ 7175 عن علي رضي الله عنه قال :(@)(@@) | 30 ( لا بأس أن يستدفىء الرجل بامرأته إذا اغتسل من الجنابة قبل أن تغتسل هي ) . ( عب ، ص ) . )(@)(@@)(@@)(@@) $ 7176 عن علي رضي الله عنه قال :(@)(@@) | 30 ( إذا أجنب الرجل فأراد أن ينام أو يطعم فليتوضأ وضوءه للصلاة ) . ( ن ) . )(@)(@@)(@@)(@@) $ 7177 عن علي رضي الله عنه قال :(@)(@@) | 30 ( الطهارات ست : من الجنابة ومن الحمام ، ومن غسل الميت ، ومن الحجامة ، والغسل للجمعة والغسل للعيدين ) . ( عب ) . )(@)(@@)(@@)(@@) $ 7178 عن زاذان :(@)(@@) | 30 ( أن رجلا سأل عليا رضي الله عنه عن الغسل ؟ فقال : اغتسل كل يوم إن شئت ، قال : لا بل الغسل المستحب ؟ قال : اغتسل كل يوم جمعة ، ويوم الفطر ، ويوم النحر ، ويوم عرفة ) . ( ش ، ومسدد ، ق ) . )(@)(@@)(@@)(@@) $ 7179 عن علي رضي الله عنه قال :(@)(@@) | 30 ( سئل رسول الله عن ماء البحر ؟ فقال : هو الطهور ماؤه ، الحل ميتته ) . ( قط ، ك ) . )(@)(@@)(@@)(@@) $ 7180 عن كميل قال :(@)(@@) | 30 ( رأيت عليا رضي الله عنه يخوض المطر ، ثم دخل المسجد صلى ولم يغسل رجليه ) . ( ص ) . )(@)(@@)(@@)(@@) $ 7181 عن علي رضي الله عنه قال :(@)(@@) | 30 ( إذا سقطت الفأرة في البئر فتقطعت ، نزع منها سبعة أدلاء ، فإن 
ms5322	 كانت الفأرة كهيئتها لم تقطع ، نزع منها دلو ودلوان ، فإن كانت منتنة أعظم من ذالك ، فلينزع من البئر ما يذهب الريح ) . ( عب ) . )(@)(@@)(@@)(@@) $ 7182 عن معاذ بن العلاء وهو أخو عمرو بن العلاء عن أبيه عن جده قال :(@)(@@) | 30 ( أقبلت مع علي بن أبي طالب رضي الله عنه إلاى الجمعة وهو ماش ، فحال بينه PageV16P091 وبين المسجد حوض من ماء وطين ، فخلع نعليه وسراويله فخاض ، فلما جاوز لبس سراويله ونعليه ، ثم صلى بالناس ولم يغسل رجليه ) . ( ق ) . )(@)(@@)(@@)(@@) $ 7183 عن علي رضي الله عنه :(@)(@@) | 30 ( أنه كان لا يرى بأسا بالوضوء بالنبيذ ) . ( قط ) . )(@)(@@)(@@)(@@) $ 7184 عن علي رضي الله عنه :(@)(@@) | 30 ( أنه سئل عن سؤر السنور فقال : هي من السباع ، ولا بأس به ) . ( مسدد قط ) . )(@)(@@)(@@)(@@) $ 7185 عن علي رضي الله عنه قال :(@)(@@) | 30 ( لا بأس بطعام المجوس ، إنما نهي عن ذبائحهم ) . ( ق ) . )(@)(@@)(@@)(@@) $ 7186 عن علي رضي الله عنه قال :(@)(@@) | 30 ( إذا أجنب الرجل فليطلب الماء إلاى آخر الوقت ، فإن لم يقدر فليتيمم فيصلي ، فإن قدر علاى الماء اغتسل ولم يعد الصلاة ) . ( خلف العكبري ) . )(@)(@@)(@@)(@@) $ 7187 عن أبي البحتري :(@)(@@) | 30 ( أن عليا رضي الله عنه قال في التيمم : ضربة للوجه ، وضربة لليدين إلاى المرفقين ) . ( عب ) . )(@)(@@)(@@)(@@) $ 7188 عن علي رضي الله عنه قال :(@)(@@) | 30 ( التيمم عند كل صلاة ) . ( ش ، ومسدد ) . )(@)(@@)(@@)(@@) $ 7189 عن علي رضي الله عنه قال :(@)(@@) | 30 ( إذا أجنبت فاسأل عن الماء جهدك ، فإن لم تقدر عليه فتيمم وصل ، فإذا قدرت علاى الماء فاغتسل ) . ( عب ) . )(@)(@@)(@@)(@@) $ 7190 عن علي رضي الله عنه قال :(@)(@@) | 30 ( ينتظر الماء ما لم يفته وقت تلك الصلاة ) . ( عب ) . )(@)(@@)(@@)(@@) $ 7191 عن علي رضي الله عنه قال :(@)(@@) | 30 ( إذا لم يجد الماء فليؤخر التيمم إلاى الوقت الآخر ) . ( عب ) . )(@)(@@) PageV16P092(@)(@@)(@@)(@@) $ 7192 عن علي رضي الله عنه :(@)(@@) | 30 ( في الرجل يكون في السفر فتصيبه الجنابة ، ومعه الماء القليل يخاف أن يعطش ؟ قال : يتيمم ولا يغتسل ) . ( قط ) . )(@)(@@)(@@)(@@) $ 7193 عن علي رضي الله عنه :(@)(@@) | 30 ( أنه يكره أن يؤم المتيمم المتوضئين ) . ( ص ، ومسدد ) . )(@)(@@)(@@)(@@) $ 7194 عن علي رضي الله عنه 
ms5323	 قال :(@)(@@) | 30 ( إذا أجنب الرجل في فلاة من الأرض ومعه الماء اليسير ، فليؤثر شفتيه بالماء وليتيمم بالصعيد ) . ( ش ) . )(@)(@@)(@@)(@@) $ 7195 عن علي رضي الله عنه قال :(@)(@@) | 30 ( لو كان الدين بالرأي لكان باطن القدمين أحق بالمسح من ظاهرهما ، ولاكن رأيت رسول الله مسح ظاهرهما ) . ( عب ، ش ، د ) . )(@)(@@)(@@)(@@) $ 7196 عن شريح بن هانىء قال :(@)(@@) | 30 ( سألت عائشة رضي الله عنها عن المسح علاى الخفين فقالت : ائت عليا فإنه أعلم بذالك مني ، كان يسافر مع رسول الله فاسأله ، فأتيت عليا رضي الله عنه فسألته فقال : كان رسول الله يأمرنا أن يمسح المقيم يوما وليلة ، والمسافر ثلاثة أيام ولياليهن ) . ( ط ، والحميدي ، ص ، عب ، ش ، حم ، والعدني والدارمي ، م ، ن ، وابن خزيمة والطحاوي ، حب ) . )(@)(@@)(@@)(@@) $ 7197 عن الشعبي قال :(@)(@@) | 30 ( أخبرني من سمع عليا رضي الله عنه ، وسئل عن المسح علاى الخفين ، فقال : نعم ، وعلاى النعلين ، وعلاى الخمار ) . ( عب ) . )(@)(@@)(@@)(@@) $ 7198 عن علي رضي الله عنه قال :(@)(@@) | 30 ( لو كان الدين بالرأي لكان أسفل الخف أولى بالمسح من أعلاه ، وقد رأيت رسول الله يمسح علاى ظهر خفيه ) . ( الدارمي د ، والطحاوي ، قط ) . )(@)(@@)(@@)(@@) $ 7199 عن علي رضي الله عنه قال :(@)(@@) | 30 ( كنت أرى أن باطن القدمين وفي لفظ : أن باطن الخفين أحق بالمسح من ظاهرهما ، حتى رأيت رسول الله PageV16P093 يمسح علاى ظاهرهما ) . ( د ، ع ، عم ، قط ، ص ) . )(@)(@@)(@@)(@@) $ 7200 عن علي رضي الله عنه قال :(@)(@@) | 30 ( كان رسول الله : يمسح علاى الخفين إذا كان مسافرا ثلاثة أيام ولياليهن ، وإن كان مقيما يوما وليلة ) . ( ص ، قط في الأفراد ، كر ) . )(@)(@@)(@@)(@@) $ 7201 عن كعب بن عبد الله قال :(@)(@@) | 30 ( رأيت عليا رضي الله عنه بال ، فمسح علاى جوربيه ونعليه ثم قام يصلي ) . ( عب ) . )(@)(@@)(@@)(@@) $ 7202 عن أبي صهبان قال :(@)(@@) | 30 ( رأيت عليا رضي الله عنه بال قائما حتى أرغى ثم توضأ ومسح علاى نعليه ، ثم دخل المسجد فخلع نعليه وجعلهما في كمه ، ثم صلى ، قال معمر : فأخبرني زيد بن أسلم عن عطاء بن يسار عن ابن عباس عن النبي بمثل صنيع علي رضي الله 
ms5324	 عنه ) . ( عب ) . )(@)(@@)(@@)(@@) $ 7203 عن علي رضي الله عنه قال :(@)(@@) | 30 ( أمرني رسول الله بالمسح علاى الخفين ) . ( قط ) . )(@)(@@)(@@)(@@) $ 7204 عن قيس رجل من الموالي قال :(@)(@@) | 30 ( سمعت منادي علي بن أبي طالب رضي الله عنه ينادي : يا أيها الناس إن الكتاب قد سبق ، المسح علاى الخفين ثلاث مرات ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 7205 عن رجل :(@)(@@) | 30 ( أنه سمع عليا رضي الله عنه يخطب علاى المنبر قال : سبق الكتاب الخفين ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 7206 حدثنا عبد الملك بن سلع الهمداني قال :(@)(@@) | 30 ( رأيت عبد خير يمسح علاى الخفين ، فسألته عن ذالك فقال : رأيت من هو خير مني يمسح علاى الخفين يعني : علي بن أبي طالب ) . ( أبو عروبة الحراني في مسند القاضي أبي يوسف ) . )(@)(@@) PageV16P094(@)(@@)(@@)(@@) $ 7207 عن عبد خير قال :(@)(@@) | 30 ( رأيت عليا رضي الله عنه وهو يعرض أهل السجون بال ، ثم توضأ ومسح علاى جوربيه ) . ( ص ) . )(@)(@@)(@@)(@@) $ 7208 عن علي رضي الله عنه قال :(@)(@@) | 30 ( انكسر إحداى زندي ، فسألت رسول الله ، فأمرني أن أمسح علاى الجبائر ) . ( عب وابن السني وأبو نعيم معا في الطب وسنده حسن ) . )(@)(@@)(@@)(@@) $ 7209 عن علي رضي الله عنه قال :(@)(@@) | 30 ( أصابني جرح في يدي فعصبت عليه الجبائر ، فأتيت النبي فقلت : أمسح عليها أو أنزعها ؟ قال : بلاى امسح عليها ) . ( ابن السني ) . )(@)(@@)(@@)(@@) $ 7210 عن علي رضي الله عنه قال :(@)(@@) | 30 ( إذا رأت المرأة بعد الطهر ما يريبها ، مثل غسالة اللحم ، أو مثل غسالة السمك ، أو مثل قطرة الدم قبل الرعاف ، فإن تلك ركضة من ركضات الشيطان في الرحم ، فلتنضح بالماء ولتتوضأ ولتصل ، فإن كان دما عبيطا لا خفاء به فلتدع الصلاة ) . ( عب ) . )(@)(@@)(@@)(@@) $ 7211 عن علي رضي الله عنه قال :(@)(@@) | 30 ( المستحاضة إذا انقضى حيضها ، اغتسلت كل يوم واتخذت صوفة فيها سمن أو زيت ) . ( د ) . )(@)(@@)(@@)(@@) $ 7212 عن أبي يوسف ، أنبأنا أبو حنيفة عن حماد وعن سعيد بن جبير عن ابن عباس رضي الله عنهما أنه قال علي رضي الله عنه في المستحاضة : $ 30 ( تدع الصلاة أيام حيضها ، وتغتسل إذا مضت ، وتؤخر من الظهر ، وتقدم من العصر 
ms5325	 ، وتغتسل غسلا واحدا ، وتصليهما جميعا ، وتؤخر المغرب ، وتقدم العشاء ، ثم تغتسل غسلا واحدا فتصليهما ، وتغتسل للفجر فتصليها ) . ( أبو عروبة الحراني في مسند القاضي أبي يوسف ) .(@)(@@)(@@)(@@) $ 7213 عن سعيد بن جبير :(@)(@@) | 30 ( أن امرأة من أهل الكوفة كتبت إلى ابن PageV16P095 عباس رضي الله عنهما بكتاب فيه : إني امرأة مستحاضة أصابني بلاء وضر ، وإني أدع الصلاة الزمان الطويل ، وإن علي بن أبي طالب رضي الله عنه سئل عن ذالك ، فأفتاني أن أغتسل عند كل صلاة ، فقال ابن عباس رضي الله عنهما : اللهم لا أجد لها إلا ما قال علي غير أنها تجمع بين الظهر والعصر بغسل واحد ، والمغرب والعشاء بغسل واحد ، وتغتسل للفجر ، فقيل له : إنه يشق عليها ؟ قال : لو شاء الله لابتلاها بأمثل من ذالك ) . ( عب ، ص ) . )(@)(@@)(@@)(@@) $ 7214 عن علي رضي الله عنه أنه قال في الرجل يقول لامرأته :(@)(@@) | 30 ( أنت علي حرام ، قال : هي ثلاث ) . ( عب ) . )(@)(@@)(@@)(@@) $ 7215 عن ابن التيمي عن أبيه :(@)(@@) | 30 ( أن عليا وزيدا رضي الله عنهما فرقا بين رجل وامرأته قال : علي حرام ) . ( عب ) . )(@)(@@)(@@)(@@) $ 7216 عن أبي حسان الأعرج أو خلاس بن عمرو بن عدي بن قيس أحد بني كلاب ،(@)(@@) | 30 جعل امرأته عليه حراما ، فقال له علي بن أبي طالب رضي الله عنه : والذي نفسي بيده لئن مسستها قبل أن تزوج غيرك لأرجمنك ) . ( عب ) . )(@)(@@)(@@)(@@) $ 7217 عن الشعبي قال :(@)(@@) | 30 ( أنا أعلمكم بما قال علي رضي الله عنه في الحرام ، قال : لآمرك أن تقدم ، ولآمرك أن تؤخر ) . ( عب ) . )(@)(@@)(@@)(@@) $ 7218 عن علي رضي الله عنه :(@)(@@) | 30 ( أنه كان لا يرى طلاق المكره شيئا ) . ( عب ) . )(@)(@@)(@@)(@@) $ 7219 عن علي رضي الله عنه قال :(@)(@@) | 30 ( كل طلاق جائز إلا طلاق المعتوه ) . ( عب ، ق ) . )(@)(@@)(@@)(@@) $ 7220 عن الحسن قال :(@)(@@) | 30 ( سأل رجل عليا رضي الله عنه قال : قلت : ( إن تزوجت فلانة فهي طالق ، فقال علي : ليس بشيء ) . ( عب ) . )(@)(@@) PageV16P096(@)(@@)(@@)(@@) $ 7221 عن علي رضي الله عنه قال :(@)(@@) | 30 ( إذا جعل أمرها بيدها فالقضاء ما قضت هي وغيرها سواء ، وهي بيدها حتى تتكلم ) . ( عب ) . )(@)(@@)(@@)(@@) $ 7222 عن 
ms5326	 إبراهيم والشعبي عن علي رضي الله عنه في الرجل يخير امرأته ، قال :(@)(@@) | 30 إن اختارت نفسها فهي واحدة بائنة ، وإن اختارت زوجها فهي واحدة وهو أحق بها ، قال : وقال عمر بن الخطاب وعبد الله بن مسعود رضي الله عنهما : إن اختارت نفسها فهي واحدة وهو أحق بها ، وإن اختارت زوجها فلا شيء قال : قال زيد بن ثابت : إن اختارت نفسها فهي ثلاث ) . ( عب ، ق ) . )(@)(@@)(@@)(@@) $ 7223 عن ابن جعفر محمد بن علي قال :(@)(@@) | 30 ( قال علي بن أبي طالب رضي الله عنه فيمن يخير امرأته إن اختارت زوجها فلا شيء ، وإن اختارت نفسها فهي واحدة ، وزوجها أحق برجعتها ، فقيل له : فإن تحدث عنه بغير هاذا ؟ قال : إنما شيء وجدوه في الصحف ) . ( عب ، ق ) . )(@)(@@)(@@)(@@) $ 7224 عن علي رضي الله عنه قال :(@)(@@) | 30 ( لا يجوز علاى الغلام طلاق حتى يحتلم ) . ( عب ) . )(@)(@@)(@@)(@@) $ 7225 عن عامر :(@)(@@) | 30 ( أن عليا رضي الله عنه قال في الرجلا جعل امرأته عليه حراما ، قال : حرمت عليه كما حرم إسرائيل علاى نفسه لحم الجمل ، فحرم عليه ) . ( عبد بن حميد ) . )(@)(@@)(@@)(@@) $ 7226 عن علي رضي الله عنه قال :(@)(@@) | 30 ( لا طلاق إلا بعد نكاح ) . ( ق ) . )(@)(@@)(@@)(@@) $ 7227 عن الحسن :(@)(@@) | 30 ( أن رجلا سأل علي بن أبي طالب رضي الله عنه قال : قلت : إن تزوجت فلانة فهي طالق ، قال علي : تزوجها فلا شيء عليك ) . ( ق ، عب ) . )(@)(@@)(@@)(@@) $ 7228 عن علي رضي الله عنه قال :(@)(@@) | 30 ( لا طلاق لمكره ) . ( ق ) . )(@)(@@) PageV16P097(@)(@@)(@@)(@@) $ 7229 عن علي رضي الله عنه :(@)(@@) | 30 ( في الرجل يطلق امرأته تطليقة أو تطليقتين ، ثم تزوج ، فيطلقها زوجها ؟ قال : إن رجعت إليه بعد ما تزوجت ائتنف الطلاق ، فإن تزوجها في عدتها كانت عنده علاى ما بقي ) . ( ق وضعفه ) . )(@)(@@)(@@)(@@) $ 7230 عن مزيدة بن جابر عن أبيه أنه سمع عليا رضي الله عنه يقول :(@)(@@) | 30 هي عنده علاى ما بقي الطلاق ) . ( ق ، وقال : هاذا أصح من الأول ) . )(@)(@@)(@@)(@@) $ 7231 عن علي رضي الله عنه قال :(@)(@@) | 30 ( الطلاق بالرجال ، والعدة بالنساء ) . ( ق ) . )(@)(@@)(@@)(@@) $ 7232 عن علي رضي الله عنه قال :(@)(@@) | 30 
ms5327	 ( في الرجل يطلق امرأته ، ثم يشهد علاى رجعتها ولم تعلم بذالك ، قال : هي امرأة الأول دخل بها الآخر أو لم يدخل ) . ( الشافعي ، ق ) . )(@)(@@)(@@)(@@) $ 7233 عن حبيب بن أبي ثابت ، عن بعض أصحابه قال :(@)(@@) | 30 ( جاء رجل إلاى علي رضي الله عنه فقال : طلقت امرأتي ألفا ، قال : ثلاث تحرمها عليك ، واقسم سائرها بين نسائك ) . ( ق ) . )(@)(@@)(@@)(@@) $ 7234 عن عطاء بن أبي رباح :(@)(@@) | 30 ( أن عمر رضي الله عنه رفع إليه رجل طلق ، قال لامرأته : حبلك علاى غاربك ، فقال لعلي رضي الله عنه : اقض بينهما ، فاستحلفه علاى ما أراد ؟ قال : أردت الطلاق ، فأمضاه علي ) . ( الشافعي في القديم ، ق ) . )(@)(@@)(@@)(@@) $ 7235 عن الشعبي قال :(@)(@@) | 30 قال علي رضي الله عنه : ( الخلية ، والبرية ، والبتة ، والبائن ، والحرام إذا نوى فهو بمنزلة الثلاث ) . ( ق ) . )(@)(@@)(@@)(@@) $ 7236 عن زاذان قال :(@)(@@) | 30 ( كنا عند علي رضي الله عنه فذكر الخيار فقال : إن أمير المؤمنين قد سألني عن الخيار ، فقلت : إن اختارت نفسها فواحدة بائنة ، وإن PageV16P098 اختارت زوجها فواحدة وهو أحق بها ، فقال عمر : ليس كذالك ، ولاكنها إن اختارت زوجها فليس بشيء ، وإن اختارت نفسها فواحدة وهو أحق بها ، فلم أستطع إلا متابعة أمير المؤمنين عمر رضي الله عنه ، فلما خلص الأمر إلي ، وعلمت أني مسؤول عن الفروج ، أخذت بالذي كنت أرى ، فقالوا : والله لئن جامعت عليه أمير المؤمنين عمر وتركت رأيك الذي رأيت ، إنه لأحب إلينا من أمر تفردت به بعده ، قال : فضحك ثم قال : أما إنه قد أرسل إلاى زيد بن ثابت رضي الله عنه فسأل زيدا ، فحالفني وإياه ، فقال زيد : إن اختارت نفسها فثلاث ، وإن اختارت زوجها فواحدة وهو أحق بها ) . ( ق ) . )(@)(@@)(@@)(@@) $ 7237 عن علي رضي الله عنه في رجل وهب امرأته لأهلها فقال :(@)(@@) | 30 ( إن قبلوها فهي تطليقة بائنة ، وإن ردوها فهي واحدة وهو أملك برجعتها ) . ( ق ) . )(@)(@@)(@@)(@@) $ 7238 عن علي رضي الله عنه قال :(@)(@@) | 30 ( إذا ملك الرجل امرأته مرة واحدة ، فإن قضت فليس له من أمرها شيء ، وإن لم تقض فهي واحدة وأمرها إليه ) . ( ق ) . )(@)(@@)(@@)(@@) $ 7239 عن 
ms5328	 أم سعيد أم ولد علي قالت :(@)(@@) | 30 ( كنت أصب علاى علي رضي الله عنه الماء وهو يتوضأ ، فقال : يا أم سعيد قد اشتقت أن أكون عروسا ، فقلت : ما يمنعك يا أمير المؤمنين ؟ قال : أبعد أربع ؟ قالت : فقلت تطلق واحدة منهن وتزوج أخرى ، قال : إن الطلاق قبيح أكرهه ) . ( ق ) . )(@)(@@)(@@)(@@) $ 7240 عن علي رضي الله عنه قال :(@)(@@) | 30 ( ما طلق الرجل طلاق السنة فندم أبدا ) . ( ابن منيع وصحح ) . )(@)(@@)(@@)(@@) $ 7241 عن الشعبي في الرجل يجعل امرأته عليه حراما ؟ قال : يقولون :(@)(@@) | 30 ( إن عليا رضي الله عنه جعلها ثلاثا ، قال الشعبي : ما قال علي رضي الله عنه هاذا ، إنما قال : لا أحلها ولا أحرمها ) . ( ق ) . )(@)(@@) PageV16P099(@)(@@)(@@)(@@) $ 7242 عن علي رضي الله عنه(@)(@@) | 30 في رجل طلق امرأته وهي حائض ؟ ( قال : لا تعتد بتلك الحيضة ) . ( إسماعيل الخطبي في الثاني من حديثه ) . )(@)(@@)(@@)(@@) $ 7243 عن عبيدة السلماني قال :(@)(@@) | 30 ( شهدت علي بن أبي طالب رضي الله عنه وجاءته امرأة وزوجها كل واحد منهما فئام من الناس ، فأخرج من هاؤلاء حكما ، ومن هاؤلاء حكما ، فقال علي للحكمين : أتدريان ما عليكما ؟ إن رأيتما أن تفرقا فرقتما ، وإن رأيتما أن تجمعا جمعتما ، فقال الزوج : أما الفرقة فلا ، فقال علي : كذبت والله ، لا تبرح حتى ترضى بكتاب الله تعالاى لك وعليك ) . ( عب ) . )(@)(@@)(@@)(@@) $ 7244 عن جعفر عن أبيه :(@)(@@) | 30 ( أن عليا رضي الله عنه قال في المبتوتة : لا نفقة لها ولا سكنى ) . ( عب ) . )(@)(@@)(@@)(@@) $ 7245 عن علي رضي الله عنه قال :(@)(@@) | 30 ( عدة أم الولد أربعة أشهر وعشرا ، قال وكيع : يعني إذا مات عنها زوجها ) . ( ق وضعفه ) . )(@)(@@)(@@)(@@) $ 7246 عن علي رضي الله عنه قال :(@)(@@) | 30 ( الطلاق بالرجل ، والعدة بالمرأة ) . ( عب ) . )(@)(@@)(@@)(@@) $ 7247 عن الشعبي :(@)(@@) | 30 ( أن عليا رضي الله عنه أتي في امرأة طلقها زوجها فزعمت أنها حاضت في شهر ثلاثا ، فقال علي لشريح : قل فيها ، قال : أقول وأنت شاهد ، قال : عزمت عليك ، قال : إن جاءت بنسوة من بطانة أهلها ممن ترضى أمانتهن ودينهن فشهدن أنها حاضت ثلاث حيض تطهر وتصلي ، فقد حلت ، فقال علي 
ms5329	 رضي الله عنه : قالون ، وقالون بالرومية : جيد ) . ( ص ، والدارمي ، ق ، كر ) . )(@)(@@)(@@)(@@) $ 7248 عن علي رضي الله عنه(@)(@@) | 30 في الحامل إذا وضعت بعد وفاة زوجها قال : ( تعتد أربعة أشهر وعشرا ) . ( ش ، وعبد بن حميد ) . )(@)(@@) PageV16P100(@)(@@)(@@)(@@) $ 7249 عن مغيرة قال : قلت للشعبي :(@)(@@) | 30 ( ما أصدق أن علي بن أبي طالب رضي الله عنه كان يقول : عدة المتوفى عنها زوجها آخر الأجلين ، قال : بلاى ، فصدق به ، كأشد ما صدقت بشيء ، كان علي يقول : إنما قوله : { وأولات الأحمال أجلهن أن يضعن حملهن } في المطلقة ) . ( ابن المنذر ) . )(@)(@@)(@@)(@@) $ 7250 عن الشعبي :(@)(@@) | 30 ( أن عليا رضي الله عنه كان يرحل المتوفى عنها لا ينتظر بها ) . ( الشافعي ، ق ) . )(@)(@@)(@@)(@@) $ 7251 عن الشعبي قال :(@)(@@) | 30 ( نقل علي رضي الله عنه أم كلثوم بعد قتل عمر رضي الله عنهما بسبع ليال لأنها كانت في دار الامارة ) . ( سفيان الثوري في جامعه ، ق ) . )(@)(@@)(@@)(@@) $ 7252 عن مسلم أبي الضحى قال :(@)(@@) | 30 ( كان علي رضي الله عنه يقول : آخر الأجلين ) . ( ق ) . )(@)(@@)(@@)(@@) $ 7253 عن الشعبي في المتوفى عنها قال :(@)(@@) | 30 ( كان علي رضي الله عنه ينقلهن ) . ( عب ) . )(@)(@@)(@@)(@@) $ 7254 عن الشعبي :(@)(@@) | 30 ( أن عليا وابن مسعود رضي الله عنهما كانا يقولان : النفقة من جمع المال للحامل المتوفى عنها ) . ( عب ) وعن ابن عمر رضي الله عنهما مثله . )(@)(@@)(@@)(@@) $ 7255 عن الحكم بن عتبة :(@)(@@) | 30 ( أن عليا رضي الله عنه قال في امرأة المفقود : وهي امرأة ابتليت فلتصبر حتى يأتيها موت أو طلاق ، قال ابن جريج : بلغني أن ابن مسعود وافق عليا علاى أنها تنتظره أبدا ) . ( عب ) . )(@)(@@) PageV16P101(@)(@@)(@@)(@@) $ 7256 عن علي رضي الله عنه قال :(@)(@@) | 30 ( عدة السرية ثلاث حيض ) . ( عب ، ص ) . )(@)(@@)(@@)(@@) $ 7257 عن علي رضي الله عنه قال :(@)(@@) | 30 ( نهى رسول الله أن توطأ الحامل حتى تضع ، والحامل حتى تستبرأ بحيضة ) . ( ش ) . )(@)(@@)(@@)(@@) $ 7258 عن علي رضي الله عنه قال :(@)(@@) | 30 ( هي عنده علاى ما بقي من طلاقها ) . ( ق ) . )(@)(@@)(@@)(@@) $ 7259 عن علي رضي الله عنه قال :(@)(@@) | 30 ( سمع رسول الله رجلا طلق البتة فغضب وقال : تتخذون دين الله هزوا ولعبا ، من 
ms5330	 طلق البتة ألزمناه ثلاثا ، لا تحل له حتى تنكح زوجا غيره ) . ( قط وابن النجار ) . )(@)(@@)(@@)(@@) $ 7260 عن أبي صالح عن علي رضي الله عنه :(@)(@@) | 30 ( في رجل كانت عنده أمة فطلقها اثنتين ثم اشتراها ، فقيل له : أيأتيها فأبى ) . ( عب ) . )(@)(@@)(@@)(@@) $ 7261 عن علي رضي الله عنه قال :(@)(@@) | 30 ( من طلق امرأته ثلاثا فلا تحل له حتى تنكح زوجا غيره ) . ( ابن شاهين في السنة ) . )(@)(@@)(@@)(@@) $ 7262 عن الحسن بن علي رضي الله عنه قال :(@)(@@) | 30 ( سمعت جدي أو حدثني أبي أنه سمع جدي يقول : أيما رجل طلق امرأته ثلاثا عند الإقراء ، أو ثلاثا مبهمة ، لم تحل له حتى تنكح زوجا غيره ) . ( طب ، ق ) . )(@)(@@)(@@)(@@) $ 7263 عن علي رضي الله عنه :(@)(@@) | 30 ( فيمن طلق امرأته ثلاثا قبل أن يدخل بها ، لا تحل له حتى تنكح زوجا غيره ) . ( ق ) . )(@)(@@)(@@)(@@) $ 7264 عن علي رضي الله عنه قال :(@)(@@) | 30 ( إذا طلق الرجل امرأته ثلاثا في مجلس واحد فقد بانت منه ، ولا تحل له حتى تنكح زوجا غيره ) . ( عد ، ق ) . )(@)(@@)(@@)(@@) $ 7265 عن أبي صالح الكواص عن علي رضي الله عنه قال :(@)(@@) | 30 ( المملوكة PageV16P102 تكون تحت الرجل فيطلقها تطليقتين ، ثم يشتريها فقال : لا تحل له ) . ( ق ) . )(@)(@@)(@@)(@@) $ 7266 عن علي رضي الله عنه :(@)(@@) | 30 ( فيمن طلق امرأته ثلاثا قبل أن يدخل بها لا تحل له حتى تنكح زوجا غيره ) . ( ق ) . )(@)(@@)(@@)(@@) $ 7267 عن علي رضي الله عنه :(@)(@@) | 30 ( في الرجل يطلق امرأته وفي بطنها ولدان ، فتضع واحدا ويبقى الآخر ؟ قال : هو أحق برجعتها ما لم تضع الآخر ) . ( ق ) . )(@)(@@)(@@)(@@) $ 7268 عن علي رضي الله عنه قال :(@)(@@) | 30 ( دخلنا مع رسول الله علاى رجل من الأنصار نعوده بظهره ورم ، فقال النبي : هاذه مدة أخرجوها عنه فبطه ، ورسول الله شاهد ) . ( ع ، والدورقي وفيه أشعث بن سعيد ضعيف وضعفه ) . )(@)(@@)(@@)(@@) $ 7269 عن علي رضي الله عنه :(@)(@@) | 30 ( أنه دخل علاى رسول الله وهو رمد ، وبين يدي النبي تمر يأكله فقال : يا علي أتشتهيه ؟ فرمى إلي بتمرة ثم رمى إلي بأخرى ، حتى رمى إلي بسبع تمرات ، ثم قال : حسبك 
ms5331	 يا علي ) . ( ابن السني وأبو نعيم معا في الطب وسنده حسن ) . )(@)(@@)(@@)(@@) $ 7270 عن علي رضي الله عنه :(@)(@@) | 30 ( أنه دخل علاى رسول الله وهو حديث عهد بمرض ، وعند رسول الله رطب ، فناوله رسول الله رطبة ثم أخرى حتى بلغ سبع رطبات ، ثم قال رسول الله : حسبك ) . ( المحاملي في أماليه ، وفي سنده إسحاق بن محمد الغزوي ضعيف لاكن له طريق آخر يأتي ) . )(@)(@@)(@@)(@@) $ 7271 عن علي رضي الله عنه قال :(@)(@@) | 30 ( احتجم رسول الله ثم قال للحجام حين فرغ : كم خراجك ؟ قال : صاعان ، فوضع عنه صاعا ، وأمرني فأعطيته صاعا ) . ( ش ، وفيه أبو جناب الكلبي ضعيف ) . )(@)(@@)(@@)(@@) $ 7272 عن علي رضي الله عنه : $ 30 ( أنه كره الحقنة ) . ( أبو نعيم ) .(@)(@@)(@@)(@@) $ 7273 عن علي رضي الله عنه قال :(@)(@@) | 30 ( إذا اشتكى أحدكم فليسأل امرأته ثلاثة دراهم أو نحوها ، فليشتر بها عسلا ، وليأخذ من ماء السماء فيجمع هنيئا مريئا ، وشفاء ومباركا ) . ( عبد بن حميد وابن المنذر وابن أبي حاتم وأبو مسعود أحمد بن الفرات الرازي في جزئه ) . )(@)(@@) PageV16P103 دراهم أو نحوها ، فليشتر بها عسلا ، وليأخذ من ماء السماء فيجمع هنيئا مريئا ، وشفاء ومباركا ) . ( عبد بن حميد وابن المنذر وابن أبي حاتم وأبو مسعود أحمد بن الفرات الرازي في جزئه ) . ) $(@)(@@)(@@)(@@) $ 7274 عن علي رضي الله عنه قال :(@)(@@) | 30 ( كنت أرمد من دخان الحصن ، فدعاني رسول الله فتفل عليه وغمزها بأصبعه ، فما رمدت بعد ) . ( أبو نعيم في الطب ) . )(@)(@@)(@@)(@@) $ 7275 عن علي رضي الله عنه قال :(@)(@@) | 30 ( الحناء بعد النورة أمان من الجذام والبرص ) . ( أبو نعيم فيه من نسخة عبد بن أحمد بن عامر عن أبيه عن أهل البيت ) . )(@)(@@)(@@)(@@) $ 7276 عن شييم بن زييم البكري أبي مريم قال :(@)(@@) | 30 ( كنت مع عمر وعلي وعبد الرحمان رضي الله عنهم وهم يأكلون ، فجاء رجل من خلف عمر به برص ، فتناول منه ، فقال له عمر : أخر ، وقال بيده ، فقال علي : فخشيت علاى طعامك وآذيت جليسك ؟ فجعل عمر ينظر إلاى عبد الرحمان ، فقال عبد الرحمان : صدق فحمد الله عمر ، فقال رجل لعمر : يا أمير المؤمنين 
ms5332	 إن أمر هاذا كذا وكذا ينتقصه ، فقال عمر : أننفيه ؟ قال : لا ، قال : فحمله علاى ناقة ، وكساه حلة ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 7277 عن عبد الله بن الحسين :(@)(@@) | 30 ( أن عبد الله بن جعفر دخل علاى ابن له مريض يقال له صالح فقال : قل لا إلاه إلا الله الحليم الكريم ، سبحان الله رب العرش العظيم ، الحمد لله رب العالمين ، اللهم اغفر لي ، اللهم ارحمني ، اللهم تجاوز عني ، اللهم اعف عني فإنك غفور رحيم ، ثم قال : هاؤلاء الكلمات علمنيهن عمي رضي الله عنه وذكر أن النبي علمهن إياه ) . ( ش ، ن ، حل ، وهو صحيح ) . )(@)(@@) PageV16P104(@)(@@)(@@)(@@) $ 7278 عن علي رضي الله عنه قال :(@)(@@) | 30 ( لا أرقيه إلا مما أخذ عليه سليمان الميثاق ) . ( ابن راهويه وحسن ) . )(@)(@@)(@@)(@@) $ 7279 عن علي رضي الله عنه قال :(@)(@@) | 30 ( بينا رسول الله ذات ليلة يصلي فوضع يده علاى الأرض فلدغته عقرب ، فتناولها رسول الله بنعله فقتلها ، فلما انصرف قال : لعن الله العقرب ، ما تدع مصليا ولا غيره ، ولا نبيا ولا غيره ألا لدغتهم ثم دعا بملح وماء فجعلهما في إناء ، ثم جعل يصبه علاى أصبعه حيث لدغته ، ويمسحها ويعوذها بالمعوذتين ، وفي رواية : ويقرأ قل هو الله أحد والمعوذتين ) . ( ش ، هب ، والمستغفري في الدعوات ، وأبو نعيم في الطب ) . )(@)(@@)(@@)(@@) $ 7280 عن علي وابن مسعود رضي الله عنهما عن النبي(@)(@@) | 30 في قوله تعالاى : { لو أنزلنا هاذا القرآن علاى جبل } إلاى آخر السورة قال : ( هي رقية الصداع ) . ( الديلمي ) . )(@)(@@)(@@)(@@) $ 7281 عن الحارث عن علي رضي الله عنه :(@)(@@) | 30 ( أن جبريل أتى النبي فوافقه مغتما ، فقال : يا محمد ما هاذا الغم الذي أراه في وجهك ؟ قال : الحسن والحسين أصابتهما عين ، قال : صدق بالعين فإن العين حق ، أفلا عوذتهما بهاؤلاء الكلمات ؟ قال : وما هن يا جبريل ؟ قال : قل اللهم ياذا السلطان العظيم ، ذا المن القديم ، ذا الرحمة الكريم ، ولي الكلمات التامات ، والدعوات المستجابات ، عاف الحسن والحسين من أنفس الجن وأعين الانس ، فقالها النبي ، فقاما يلعبان بين يديه ، فقال النبي : عوذوا أنفسكم ونساءكم وأولادكم بهاذا التعويذ ، فإنه لم يتعوذ المتعوذون 
ms5333	 بمثله ) . ( ابن منده في غرائب شعبة ، والجرجاني في الجرجانيات والأصبهاني في الحجة ، كر ، وقال قط ، تفرد به أبو رجاء محمد بن PageV16P105 عبيد الله الخطيبي من أهل تستر ) . )(@)(@@)(@@)(@@) $ 7282 عن علي رضي الله عنه قال :(@)(@@) | 30 ( كان النبي يعوذ الحسن والحسين بهاؤلاء الكلمات : أعيذكما بكلمات الله التامات من كل شيطان وهامة ، ومن كل عين لامة ) . ( طس ، وابن النجار ) . )(@)(@@)(@@)(@@) $ 7283 عن علي رضي الله عنه قال :(@)(@@) | 30 ( لدغت النبي عقرب وهو يصلي ، فلما فرغ قال : لعن الله العقرب ، لا تدع مصليا ولا غيره إلا لدغته ، ثم دعا بملح وماء وجعل يمسح عليها ويقرأ { قل يا أيها الكافرون } و { قل أعوذ برب الفلق } و { قل أعوذ برب الناس } ) . ( طس ، وابن مردويه وأبو نعيم في الطب ) . )(@)(@@)(@@)(@@) $ 7284 عن ثعلبة بن يزيد الحماني قال :(@)(@@) | 30 ( سمعت عليا رضي الله عنه يقول : قال رسول الله : لا صفر ولا هامة ، ولا يعدي سقيم صحيحا ، قلت : أنت سمعت هاذا من رسول الله ؟ قال : نعم ، سمعت أذني وبصرت عيني ) . ( ابن جرير وصححه ) . )(@)(@@)(@@)(@@) $ 7285 عن علي رضي الله عنه قال :(@)(@@) | 30 ( إذا ظاهر مرارا في مجلس واحد فكفارة واحدة ، وإن ظاهر في مقاعد شتى فكفارات شتى والأيمان كذالك ) . ( عب ) . )(@)(@@)(@@)(@@) $ 7286 عن علي رضي الله عنه قال :(@)(@@) | 30 ( لا يدخل إيلاء في تظاهر ولا تظاهر في إيلاء ) . ( عب ) . )(@)(@@) PageV16P106(@)(@@)(@@)(@@) $ 7287 عن علي رضي الله عنه قال :(@)(@@) | 30 ( قال رجل : يا رسول الله ما ينفي عني حجة الجهل ؟ قال : العلم ، قال : فما ينفي عني حجة العلم ؟ قال : العمل ) . ( خط في الجامع ، وفيه عبد الله بن خراش ضعيف ) . )(@)(@@)(@@)(@@) $ 7288 عن علي رضي الله عنه قال :(@)(@@) | 30 ( يا طالب العلم إن العلم ذو فضائل كثيرة ، فرأسه التواضع ، وعينه البراءة من الحسد ، وأذنه الفهم ، ولسانه الصدق ، وحفظه الفحص ، وقلبه حسن النية ، وعقله معرفة الأشياء والامور الواجبة ، ويده الرحمة ، ورجله زيارة العلماء ، وهمته السلامة ، وحكمته الورع ، ومستقره النجاة ، وقائده العافية ، ومركبه الوقار ، وسلاحه لين الكلمة ، وسيفه الرضى ، وقوسه المداراة ، وجيشه مجاورة العلماء ، وماله الأدب ، وذخيرته اجتناب الذنوب 
ms5334	 ، وزاده المعروف ، ومأواه الموادعة ، ودليله الهدى ، ورفيقه صحبة الأخيار ) . ( خط في الجامع ) . )(@)(@@)(@@)(@@) $ 7289 عن علي رضي الله عنه قال :(@)(@@) | 30 ( من حق العالم عليك أن تسلم علاى القوم عامة وتخصه دونهم بالتحية ، وأن تجلس أمامه ، ولا تشيرن عنده بيدك ، ولا تغمزن بعينيك ، ولا تقولن قال فلان خلافا لقوله ، ولا تغتابن عنده أحدا ، ولا تسار في مجلسه ولا تأخذ بثوبه ، ولا تلج عليه إذا مل ، ولا تعرض من طول صحبته ، فإنما هو بمنزلة النخلة تنتظر متى يسقط عليك منها شيء ، فإن المؤمن العالم لأعظم أجرا من الصائم القائم الغازي في سبيل الله ، فإذا مات العالم انثلمت في الاسلام ثلمة لا يسدها شيء إلاى يوم القيامة ) . ( خط في الجامع ) . )(@)(@@)(@@)(@@) $ 7290 عن علي رضي الله عنه قال :(@)(@@) | 30 ( تعلموا العلم تعرفوا به ، واعملوا به تكونوا من أهله ، فإنه سيأتي من بعدكم زمان ينكر فيه الحق تسعة أعشاره ، وإنه لا ينجو فيه إلا كل نومة منبت إنما أولائك أئمة الهدى ومصابيح العلم ، ليسوا بالعجل المذاييع البذر ) . ( حم في الزهد وأبو عبيد والدينوري في الغريب ، كر ) . )(@)(@@) PageV16P107(@)(@@)(@@)(@@) $ 7291 عن علباء بن الأحمر اليشكري قال : قال علي رضي الله عنه :(@)(@@) | 30 ( من يشتري مني علما بدرهم ) . ( المروزي في العلم ) . )(@)(@@)(@@)(@@) $ 7292 عن علي رضي الله عنه قال :(@)(@@) | 30 ( نوم علاى علم خير من اجتهاد علاى جهل ) . ( آدم في العلم ) . )(@)(@@)(@@)(@@) $ 7293 عن علي رضي الله عنه قال :(@)(@@) | 30 ( ألا أنبئكم بالفقيه ، حق الفقيه ؟ من لم يقنط الناس من رحمة الله ، ولم يرخص لهم في معاصي الله تعالاى ، ولم يؤمنهم مكر الله ، ولم يترك القرآن رغبة عنه إلاى غيره ، ولا خير في عبادة ليس فيها تفقه ، ولا خير في فقه ليس فيه تفهم وفي لفظ : لا ورع فيه ولا خير في قراءة ليس فيها تدبر ) . ( ابن الضريس وابن بشران ، حل ، كر ، والمرهبي في العلم ، وزاد : ألا إن لكل شيء ذروة ، وذروة الجنة الفردوس ، ألا وإنها لمحمد ) . )(@)(@@)(@@)(@@) $ 7294 عن ابن وهب ، أخبرني عقبة بن نافع ، عن إسحاق بن أسيد ، عن أبي 
ms5335	 مالك وأبي إسحاق عن علي بن أبي طالب رضي الله عنه أن رسول الله قال :(@)(@@) | 30 ( ألا أنبئكم بالفقيه كل الفقيه ؟ قالوا : بلاى ، قال : من لم يقنط الناس من رحمة الله ، ولم يؤيسهم من روح الله ، ولا يؤمنهم من مكر الله ، ولا يدع القرآن رغبة عنه إلاى ما سواه ، ألا لا خير في عبادة ليس فيها تفقه ، ولا علم ليس فيه تفهم ، ولا قراءة ليس فيها تدبر ) . ( العسكري في المواعظ وابن لال والديلمي وابن عبد البر في العلم ، وقال : لا يأتي هاذا الحديث مرفوعا إلا من هاذا الوجه أكثرهم يوقفونه علاى علي ) . )(@)(@@)(@@)(@@) $ 7295 عن كميل بن زياد قال :(@)(@@) | 30 ( أخذ بيدي علي بن أبي طالب رضي الله عنه فأخرجني إلاى ناحية الجبانة ، فلما أصحر تنفس ثم قال : يا كميل إن هاذه القلوب أوعية فخيرها أوعاها ، احفظ عني ما أقول لك : الناس ثلاثة : عالم رباني ، ومتعلم علاى سبيل نجاة ، وهمج رعاع أتباع كل ناعق ، يميلون مع كل ريح ، لم يستضيئوا PageV16P108 بنور العلم ، ولم يلجأوا إلاى ركن وثيق ، يا كميل العلم خير من المال ، العلم يحرسك ، وأنت تحرس المال ، والعلم يزكو علاى العمل ، والمال تنقصه النفقة ، يا كميل محبة العالم دين يدان بها ، العلم يكسب العالم الطاعة لربه في حياته ، وجميل الاحدوثة بعد وفاته ، وصنيعة المال تزول بزواله ، والعلم حاكم والمال محكوم عليه ، يا كميل مات خزان الأموال وهم أحياء ، والعلماء باقون ما بقي الدهر ، أعيانهم مفقودة ، وأمثالهم في القلوب موجودة ، هاه إن هاهنا لعلما وأشار إلاى صدره لو أصبت له حملة ، ثم قال : اللهم بلاى ، أصبته لقنا غير مأمون ، يستعمل آلة الدين للدنيا ، ويستظهر بحجج الله علاى كتابه ، وبنعمه علاى كتابه ، أو منقادا لأهل الحق لا بصيرة له في أحيائه ، يقتدح الشك في قلبه بأول عارض من شبهة ، اللهم لا ذا ولا ذاك ، أو منهوما باللذات سلس القياد للشهوات ، أو مغرما بجمع الأموال والادخار ، وليسا من دعاة الدين ، أقرب شبها بهما الأنعام السائمة ، كذالك يموت العلم بموت حامليه ، ثم قال : اللهم 
ms5336	 بلاى لا تخلوا الأرض من قائم لله بحجة ، إما ظاهر مشهور ، وإما خائف مغمور لئلا تبطل حجج الله وبيناته ، وكم وأين أولائك ؟ أولائك هم الأقلون عددا ، الأعظمون عند الله قدرا ، بهم يدفع الله عن حججه حتى يؤدوها إلاى نظرائهم ، ويورعوها في قلوب أشباههم ، هجم بهم العلم علاى حقيقة الأمر ، فباشروا روح اليقين ، واستسهلوا ما استوعر منه المترفون ، وأنسوا بما استوحش منه الجاهلون ، وصحبوا الدنيا بأبدان أرواحها معلقة بالنظر الأعلاى ، يا كميل أولائك خلفاء الله في أرضه ، الدعاة إلاى دينه ، هاه شوقا إلاى رؤيتهم ، أستغفر الله لي ولك ) . ( ابن الأنباري في المصاحف ، والمرهبي في العلم ، ونصر في الحجة ، حل ، كر ) . )(@)(@@)(@@)(@@) $ 7296 عن علي رضي الله عنه قال :(@)(@@) | 30 ( كنا جلوسا عند النبي وهو نائم ، فذكرنا الدجال ، فاستيقظ محمرا وجهه ، فقال غير الدجال أخوف عندي عليكم من PageV16P109 الدجال ، أئمة مضلون ) . ( ش ، حم ، ع ، والدورقي ) . )(@)(@@)(@@)(@@) $ 7297 عن الحارث عن علي رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : إني لا أخاف علاى أمتي مؤمنا ولا مشرويفعل ما تنكرون ) . ( العسكري في المواعظ ) . )(@)(@@)(@@)(@@) $ 7298 عن علي رضي الله عنه أنه قال :(@)(@@) | 30 ( يا حملة القرآن اعملوا به ، فإن العالم من عمل بما علم ، ووافق عمله علمه ، وسيكون أقوام يحملون العلم لا يجاوز تراقيهم ، تخالف سريرتهم علانيتهم ، ويخالف عملهم علمهم ، يجلسون حلقا فيباهي بعضهم بعضا حتى إن أحدهم ليغضب علاى جليسه حين يجلس إلاى غيره ويدعه ، أولائك لا تصعد أعمالهم في مجالستهم تلك إلاى الله ) . ( قط في حديث ابن مردك ، خط في الجامع ، وأبو الغنائم النرسي في كتاب أنس ، العاقل ، كر ) . )(@)(@@)(@@)(@@) $ 7299 عن عمير بن سعيد قال : $ 30 ( سمعت عليا رضي الله عنه يخبر القوم أن هاذه الزهرة تسميها العرب الزهرة ، وتسميها العجم أناهيد ، وكان الملكان يحكمان بين الناس ، فأتتهما فأرادها كل واحد منهما عن غير علم صاحبه ، فقال أحدهما لصاحبه : يا أخي إن في نفسي بعض الأمر أريد أن أذكره لك ، قال : اذكره يا أخي ، لعل الذي في نفسي مثل الذي في نفسك ، فاتفقا علاى 
ms5337	 أمر في ذالك ، فقالت لهما المرأة : حتى تخبراني بما تصعدان به إلاى السماء وبما تهبطان به إلاى الأرض ؟ فقالا : بسم الله الأعظم نهبط وبه نصعد ، فقالت : ما أنا بمؤاتيتكما الذي تريدان حتى تعلمانيه ، فقال أحدهما لصاحبه : علمها إياه ، قال : كيف لنا بشدة عذاب الله ، فقال الآخر : إنا نرجو سعة رحمة الله ، فعلمها إياه فتكلمت به ، فطارت إلاى السماء ، ففزع ملك في السماء لصعودها ، فطأطأ رأسه فلم يجلس بعد ، ومسخها الله فكانت كوكبا ) . ( ابن راهويه وعبد بن حميد وابن أبي الدنيا في العقوبات وابن PageV16P110 جرير وأبو الشيخ في العظمة ، ك ) .(@)(@@)(@@)(@@) $ 7300 عن عطاء قال :(@)(@@) | 30 ( قيل لعلي بن أبي طالب رضي الله عنه : هل كان للنجوم أصل ؟ قال : نعم ، كان نبي من الأنبياء يقال له : يوشع بن نون ، فقال له قومه : لا نؤمن بك حتى تعلمنا بدء الخلق وآجاله ، فأوحى الله تعالاى إلاى غمامة فأمطرتهم واستنقع علاى الجبل ماء صافيا ، ثم أوحى الله تعالاى إلاى الشمس والقمر والنجوم : أن تجري في ذالك الماء ، ثم أوحى إلاى يوشع بن نون أن يرتقي هو وقومه علاى الجبل ، فارتقوا الجبل ، فقاموا علاى الماء حتى عرفوا به بدء الخلق وآجاله بمجاري الشمس والقمر والنجوم وساعات الليل والنهار ، فكان أحدهم يعلم متى يموت ، ومتى يمرض ، ومن ذا الذي يولد له ، ومن ذا الذي يولد له ، فبقوا كذالك برهة من دهرهم ، ثم إن داود عليه الصلاة والسلام قاتلهم علاى الكفر ، فأخرجوا إلاى داود في القتال من لم يحضر أجله خلفوه في بيوتهم ، فكان يقتل من أصحاب داود ، ولا يقتل من هاؤلأ أحد ، فقال داود : رب أقاتل علاى طاعتك ، ويقاتل هاؤلأ علاى معصيتك ، فيقتل من أصحابي ، ولا يقتل من هاؤلأ أحد ، فأوحى الله تبارك وتعالاى إليه : إني كنت علمتهم بدء الخلق وآجاله ، وإنما أخرجوا إليك من لم يحضر أجله ، ومن حضر أجله خلفوه في بيوتهم ، فمن ثم يقتل من أصحابك ، ولا يقتل منهم أحد ، قال داود : يا رب علاى ماذا علمتهم ؟ قال : علاى مجاري الشمس والقمر والنجوم وساعات 
ms5338	 الليل والنهار ، قال : فدعا الله تعالاى فحبست الشمس عليهم ، فزاد في النهار ، فاختلطت الزيادة بالليل والنهار ، فلم يعرفوا قدر الزيادة ، فاختلط عليهم حسابهم ، قال علي : فمن ثم كره النظر في النجوم ) . ( خط في كتاب النجوم ، وسنده ضعيف ) . )(@)(@@)(@@)(@@) $ 7301 عن علي رضي الله عنه قال :(@)(@@) | 30 ( نهاني رسول الله عن النظر في النجوم وأمرني بإسباغ الطهور ) . ( خط في كتاب النجوم ) . )(@)(@@) PageV16P111(@)(@@)(@@)(@@) $ 7302 عن علي رضي الله عنه قال :(@)(@@) | 30 ( نهى رسول الله أن تنزى الحمر علاى الخيل ، وأن ينظر في النجوم ، وأمر بإسباغ الوضوء ) . ( عق وابن مردويه ، خط في كتاب النجوم ) . )(@)(@@)(@@)(@@) $ 7303 عن عبد الله بن عوف بن الأحمر :(@)(@@) | 30 ( أن مسافر بن عوف بن الأحمر قال لعلي بن أبي طالب رضي الله عنه حين انصرف من الأنبار إلاى أهل النهروان : يا أمير المؤمنين لا تسر في هاذه الساعة ، وسر في ثلاث ساعات يمضين من النهار ، قال علي : ولم ؟ قال : لأنك إن سرت في هاذه الساعة أصابك أنت وأصحابك بلأ وضرر شديد ، وإن سرت في الساعة التي أمرتك بها ظفرت وظهرت وأصبت وطلبت ، فقال علي : ما كان لمحمد منجم ، ولا لنا من بعده ، هل تعلم ما في بطن فرسي هاذه ؟ قال : ( إن حسبت علمت ، قال : من صدقك بهاذا القول كذب القرآن ، قال الله تعالاى : { إن الله عنده علم الساعة وينزل الغيث ويعلم ما في الأرحام } الآية ، ما كان محمد يدعي علم ما ادعيت علمه ، تزعم أنك تهدي إلاى علم الساعة التي يصيب السوء من سافر فيها ؟ قال : نعم ، قال : من صدقك بهاذا القول استغنى عن الله تعالاى في صرف المكروه عنه ، وينبغي للمهتم بأمرك أن يوليك لأمر دون الله ربه ، لأنك أنت تزعم هدايته إلاى الساعة التي تنجو من السوء ، من سافر فيها ، فمن آمن بهاذا القول لم آمن عليه أن يكون كمن اتخذ دون الله ندا وضدا ، اللهم لا طائر إلا طيرك ، ولا خير إلا خيرك ، ولا إلاه غيرك ، نكذبك ونخالفك ، ونسير في هاذه الساعة التي تنهانا عنها ، ثم أقبل علاى 
ms5339	 الناس فقال : يا أيها الناس إياكم وتعلم هاذه النجوم إلا ما يهتدى به في ظلمات البر والبحر ، إنما المنجم كالكافر ، والكافر في النار ، والله لئن بلغني أنك تنظر في النجوم وتعمل بها ، لاخلدنك في الحبس ما بقيت وبقيت ، ولأحرمنك العطاء ما كان لي سلطان ، PageV16P112 ثم سار في الساعة التي نهاه المنجم عنها ، فأتى أهل نهروان فقتلهم ، ثم قال : لو سرنا في الساعة التي أمرنا بها فظفرنا أو ظهرنا ، لقال قائل : سار في الساعة التي أمر بها المنجم ، ما كان لمحمد منجم ولا لنا من بعدهه ، ففتح الله علينا بلاد كسرى وقيصر وسائر البلدان ، أيها الناس توكلوا علاى الله وثقوا به ، فإنه يكفي ما سواه ) . ( الحارث ، خط في كتاب النجوم ) . )(@)(@@)(@@)(@@) $ 7304 عن علي رضي الله عنه قال :(@)(@@) | 30 ( إن هاؤلأ العرافين كهان العجم ، فمن أتى كاهنا يؤمن بما يقول ، فقد كفر بما أنزل علاى محمد ) . ( ش ) . )(@)(@@)(@@)(@@) $ 7305 عن علي رضي الله عنه :(@)(@@) | 30 ( أن النبي قال : يا علي لا تجالس أصحاب النجوم ) . ( الخرائطي في مساوىء الأخلاق والديلمي ) . )(@)(@@)(@@)(@@) $ 7306 عن أبي البختري قال :(@)(@@) | 30 ( دخل علي بن أبي طالب رضي الله عنه المسجد ، فإذا رجل يخوف ، فقال : ما هاذا ؟ فقالوا : رجل يذكر الناس ، فقال : ليس برجل يذكر الناس ، ولاكنه يقول : أنا فلان ابن فلان اعرفوني ، فأرسل إليه ، فقال : أتعرف الناسخ من المنسوخ ؟ فقال : لا ، قال : فاخرج من مسجدنا ، تذكر فيه ) . ( الروزي في العلم والنحاس في نسخه والعسكري في المواعظ ) . )(@)(@@)(@@)(@@) $ 7307 عن أبي يحيى قال :(@)(@@) | 30 ( مر بي علي رضي الله عنه وأنا أقص فقال : هل عرفت الناسخ من المنسوخ ؟ قلت : لا ، قال : أنت أبو اعرفوني ) . ( المروزي في العلم ) . )(@)(@@)(@@)(@@) $ 7308 عن شريح قال :(@)(@@) | 30 ( كنت مع علي بن أبي طالب رضي الله عنه ومعه الدرة بسوق الكوفة وهو يقول : يا معشر التجار خذوا الحق وأعطوا الحق تسلموا ، لا تردوا قليل الربح فتحرموا كثيره ، حتى انتهى إلاى قاص يقص ، فقال : تقص ونحن حديثوا عهد برسول الله ، أما إني أسألك عن مسألتين فإن أصبت وإلا 
ms5340	 PageV16P113 أوجعتك ضربا ، قال : سل يا أمير المؤمنين ، قال : ما ثبات الايمان وزواله ؟ قال : ثبات الايمان الورع ، وزواله الطمع ) . ( وكيع في الغرر ) . )(@)(@@)(@@)(@@) $ 7309 عن الحارث عن علي رضي الله عنه :(@)(@@) | 30 ( أنه دخل المسجد فإذا بصوت قاص ، فلما رآه سكت ، قال علي : من هاذا ؟ قال القاص : أنا ، فقال علي : إما إني سمعت رسول الله يقول : سيكون بعدي قصاص لا ينظر الله إليهم ) . ( أبي عمير ابن فضالة في أماليه ) . )(@)(@@)(@@)(@@) $ 7310 عن سعيد بن أبي هند :(@)(@@) | 30 ( أن عليا رضي الله عنه مر بقاص فقال : ما يقول ؟ قالوا : يقص ، قال : لا ، ولاكن يقول : اعرفوني ) . ( مسدد ، وصحح ) . )(@)(@@)(@@)(@@) $ 7311 عن أبي الأسود الدؤلي قال :(@)(@@) | 30 ( دخلت علاى علي بن أبي طالب رضي الله عنه فرأيته مطرقا متفكرا ، فقلت : فيم تفكر يا أمير المؤمنين ؟ قال : إني سمعت ببلدكم هاذا لحنا ، فأردت أن أصنع كتابا في أصول العربية ، فقلت : إذا فعلت هاذا أحييتنا وبقيت فينا هاذه اللغة ، ثم أتيته بعد ثلاث ، فألقى إلي صحيفة فيها : بسم الله الرحمان الرحيم ، الكلام كله : اسم وفعل وحرف فالاسم ما أنبأ عن المسمى ، والفعل ما أنبأ عن حركة المسمى ، والحرف ما أنبأ عن معنى ليس باسم ولا فعل ، ثم قال لي : تتبعه وزد فيه ما وقع لك ، واعلم يا أبا الأسود أن الأشياء ثلاثة : ظاهر ومضمر وشيء ليس بظاهر ولا مضمر ، وإنما يتفاضل العلماء في معرفة ما ليس بظاهر ولا مضمر ، قال أبو الأسود : فجمعت عنه أشياء وعرضتها عليه ، فكان من ذالك حروف النصب ، فذكرت منها : أن وإن وليت ولعل وكأن ، ولم أذكر لاكن ، فقال لي : لم تركتها ؟ فقلت : لم أحسبها منها ، فقال : بلاى هي منها ، فزاد لي فيها ) . ( أبو القاسم الزجاجي في أماليه . )(@)(@@)(@@)(@@) $ 7312 عن صعصعة بن صوحان قال :(@)(@@) | 30 ( جاء أعرابي إلاى علي بن أبي طالب رضي الله عنه فقال : يا أمير المؤمنين كيف نقرأ هاذا الحرف : لا يأكله إلا PageV16P114 الخاطون ، كل والله يخطو ، فتبسم علي وقال { لا يأكله إلا الخاطئون } ، قال : صدقت يا أمير المؤمنين ، ما كان الله 