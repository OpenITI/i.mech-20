ms466	 کس آورده پشت او به زمین %~% هزار مرد بیفگند دیده‌ام به عیان(@)(@@) 17 بیامدند به امید جنگ او هر مرد %~% به پیش شاه و بدین بست با همه پیمان(@)(@@) 18 ز بخت نیک یکی را ربود سر ز بدن %~% ز مشت خویش دگر را ز تن ربود روان(@)(@@) 19 از آن سپس که همه «نحن غالبون» گفتند %~% فگند در دلشان «کل من علیها فان»(@)(@@) 20 چگونه وصف شجاعت کنم کسی را من %~% که نرخ جان شود از زور او همی ارزان(@)(@@) 21 ایاستوده‌تر از هر که در جهان مردست %~% که از شجاعت تو کرده حاسدت نقصان(@)(@@) 22 نه یوسفی و ترا هست روی چون خورشید %~% نه موسئی و ترا هست نیزه چون ثعبان(@)(@@) 23 هنر چگونه رسد بی‌کمال تو به کمال %~% سخن چگونه رسد بی‌بیان تو به بیان(@)(@@) 24 به وقت مردی احوال تیغ را معیار %~% به گاه رادی اسباب جود را میزان(@)(@@) 25 به تو کنند نو آبادیان همی مفخر %~% که فخر عالمی ای راد کف خوب کمان(@)(@@) 26 سپهر وارت قدرست و طلعتت خورشید %~% منیر وارت بدرست و برج تو دکان(@)(@@) 27 هزار دشمن و از تو یکی گذارش مشت %~% هزار لشکر و از دولتت یکی دوران(@)(@@) 28 شگفت نیست اگر من به مدح تو نرسم %~% که خاک را نبود قدر گنبد گردان(@)(@@) 29 ایا ندیدم ندم را ثنای تو دارو %~% ایا معین طرب را سخای تو بستان(@)(@@) 30 اگر نیامد تر شعر من رواست از آنک %~% نماند آب سخن را چو رانی از پی نان(@)(@@) 31 بگفتم این قدر از مدحت تو با تقصیر %~% پسنده باشد در شعر نام تو برهان(@)(@@) 32 تو شاعری و به نزد تو شعر من ژاژست %~% که برد زیره بضاعت به معدن کرمان(@)(@@) 33 ولیکن ارچه بود بحر ژرف معدن آب %~% ببارد آخر هم گه گهی برو باران(@)(@@) 34 همه دعای من آنست بر تو ای سرهنگ %~% که ای خدای مر او 
ms467	 را به کامها برسان(@)(@@) 35 همیشه تا نبود جای در بجر دریا %~% همیشه تا نبود جان زر بجز در کان(@)(@@) 36 بقات خواهم در دولت و سعادت و عز %~% عدو و حاسد تو در غم دل و احزان(@)(@@) 37 به عمر خویش چنان کن که خواهمت گفتن %~% به جاه خویش چنان کن که دانی از ارکان(@)(@@) 38 چو ابر و بحر ببخش و چو ماه و مهر بتاب %~% چو چرخ و شیر بگرد و چو سنگ و کوه بمان PageV1P0579(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 تا کی از یاران وصیت تخت و افسر داشتن %~% وز برای لقمه‌ای نان دست بر سر داشتن(@)(@@) 2 تا تو بیمار هوای نفس باشی مر ترا %~% بایدت بر خاک خواری خفت و بستر داشتن(@)(@@) 3 گر ترا بر کشور جان پادشاهی آرزوست %~% پیش آزت زشت باشد دست و دل بر داشتن(@)(@@) 4 ور ره دین و شریعت ناگزیران بایدت %~% چون رسن گرمی چه داری سر به چنبر داشتن(@)(@@) 5 کفر باشد از طمع پیش در هر منعمی %~% قامت آزادگی چون حلقه بر در داشتن(@)(@@) 6 سیم و زر را خوار داری پیش تو آسان بود %~% پیش ایزد روز محشر کار چون زر داشتن(@)(@@) 7 خار را در راه دین همرنگ گل فرسود نست %~% در حقیقت خاک را هم بوی عنبر داشتن(@)(@@) 8 راستی در راه توحید این دو شرطست ای عجب %~% چشم صورت کور و گوش مادگی کر داشتن(@)(@@) 9 آدمی اصلی بود با احتیاط و اصطفا %~% هر چه از ابلیس معروفست منکر داشتن(@)(@@) 10 بگذر از رنگ طبیعت دست در تحقیق زن %~% ننگ باشد با پدر نسبت به مادر داشتن(@)(@@) 11 هر که دارد آشنایی با همه کروبیان %~% تخت همت باید از عیوق برتر داشتن(@)(@@) 12 زیر پای حرص دنیا چون دلت فرسوده شد %~% دلبر همت چه سود آنگاه در بر داشتن(@)(@@) 13 قوت اسلام و دین بود اقتضای ایزدی %~% ذوالفقار احمد اندر دست حیدر داشتن(@)(@@) 14 
ms468	 شرط باشد دین به حرمت داشتن در حکم شرع %~% چون عروس بکر را با زر و زیور داشتن(@)(@@) 15 دوزخست انباشتن در ملت فردوسیان %~% تشنه لب را در کنار حوض کوثر داشتن(@)(@@) 16 هر که او از موکب صورت پرستان شد برون %~% بایدش طبل ملامت از قفا برداشتن(@)(@@) 17 و آنکه را اندیشه عقلی بود گوید طبیب %~% باید این را از غذا جستن نکوتر داشتن(@)(@@) 18 خود ندانی گر نبودی جان نبودی تن نکو %~% بی‌سواری خود چه باید اسب و افسر داشتن(@)(@@) 19 گر نتابد سوی کان خورشید تابان بر فلک %~% تیغ هندی از کجا آورد گوهر داشتن(@)(@@) 20 ناجوانمردی و بددینی بود کز ناکسی %~% در مزاج این جان صافی را مکدر داشتن PageV1P0580(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 کار عاقل نیست در دل مهر دلبر داشتن %~% جان نگین مهر مهر شاخ بی‌بر داشتن(@)(@@) 2 از پی سنگین دل نامهربانی روز و شب %~% بر رخ چون زر نثار گنج گوهر داشتن(@)(@@) 3 چون نگردی گرد معشوقی که روز وصل او %~% بر تو زیبد شمع مجلس مهر انور داشتن(@)(@@) 4 هر که چون کرکس به مرداری فرود آورد سر %~% کی تواند همچو طوطی طمع شکر داشتن(@)(@@) 5 رایت همت ز ساق عرش برباید فراشت %~% تا توان افلاک زیر سایه پر داشتن(@)(@@) 6 بندگان را بندگی کردن نشاید تا توان %~% پاسبان بام و در فغفور و قیصر داشتن(@)(@@) 7 تا دل عیسی مریم باشد اندر بند تو %~% کی روا باشد دل اندر سم هر خر داشتن(@)(@@) 8 یوسف مصری نشسته با تو اندر انجمن %~% زشت باشد چشم را در نقش آزر داشتن(@)(@@) 9 احمد مرسل نشسته کی روا دارد خرد %~% دل اسیر سیرت بوجهل کافر داشتن(@)(@@) 10 ای دریای ضلالت در گرفتار آمده %~% زین برادر یک سخت بایست باور داشتن(@)(@@) 11 بحر پر کشتی‌ست لیکن جمله در گرداب خوف %~% بی‌سفینه نوح نتوان چشم معبر داشتن(@)(@@) 12 گر نجات دین و دل خواهی همی تا چند 
ms469	 ازین %~% خویشتن چون دایره بی‌پا و بی سر داشتن(@)(@@) 13 من سلامت خانه نوح نبی بنمایمت %~% تا توانی خویشتن را ایمن از شر داشتن(@)(@@) 14 شو مدینه علم را در جوی و پس دروی خرام %~% تا کی آخر خویشتن چون حلقه بر در داشتن(@)(@@) 15 چون همی دانی که شهر علم را حیدر درست %~% خوب نبود جز که حیدر میر و مهتر داشتن(@)(@@) 16 کی روا باشد به ناموس و حیل در راه دین %~% دیو را بر مسند قاضی اکبر داشتن(@)(@@) 17 من چگویم چون تو دانی مختصر عقلی بود %~% قدر خاک افزونتر از گوگرد احمر داشتن(@)(@@) 18 از تو خود چون می‌پسندد عقل نابینای تو %~% پارگین را قابل تسنیم و کوثر داشتن(@)(@@) 19 مر مرا باری نکو ناید ز روی اعتقاد %~% حق زهرا بردن و دین پیمبر داشتن(@)(@@) 20 آنکه او را بر سر حیدر همی خوانی امیر %~% کافرم گر می‌تواند کفش قنبر داشتن(@)(@@) 21 گر تن خاکی همی بر باد ندهی شرط نیست %~% آب افیون خوردن و در دامن آذر داشتن(@)(@@) 22 تا سلیمان‌وار باشد حیدر اندر صدر ملک %~% زشت باشد دیو را بر تارک افسر داشتن(@)(@@) 23 آفتاب اندر سما با صدهزاران نور و تاب %~% زهره را کی زهره باشد چهره از هر داشتن(@)(@@) 24 خضر فرخ پی دلیلی رامیان بسته چو کلک %~% جاهلی باشد ستور لنگ رهبر داشتن(@)(@@) 25 گر همی خواهی که چون مهرت بود مهرت قبول %~% مهر حیدر بایدت با جان برابر داشتن(@)(@@) 26 چون درخت دین به باغ شرح حیدر در نشاند %~% باغبانی زشت باشد جز که حیدر داشتن(@)(@@) 27 جز کتاب الله و عترت ز احمد مرسل نماند %~% یادگاری کان توان تا روز محشر داشتن(@)(@@) 28 از گذشت مصطفای مجتبی جز مرتضی %~% عالم دین را نیارد کس معمر داشتن(@)(@@) 29 از پس سلطان ملک شه چون نمی‌داری روا %~% تاج و تخت پادشاهی جز که سنجر داشتن(@)(@@) 30 از پی سلطان دین پس 
ms470	 چون روا داری هم %~% جز علی و عترتش محراب و منبر داشتن(@)(@@) 31 اندر آن صحرا که سنگ خاره خون گردد همی %~% وندران میدان که نتوان پشت و یاور داشتن(@)(@@) 32 هفت زندان را زبانی برگشاید هفت در %~% از برای فاسق و مجرم مجاور داشتن(@)(@@) 33 هشت بستان را کجا هرگز توانی یافتن %~% جز به حب حیدر و شبیر و شبر داشتن(@)(@@) 34 گر همی مومن شماری خویشتن را بایدت %~% مهر زر جعفری بر دین جعفر داشتن(@)(@@) 35 کی مسلم باشدت اسلام تا کارت بود %~% طیلسان در گردن و در زیر خنجر داشتن(@)(@@) 36 گر همی دیندار خوانی خویشتن را شرط نیست %~% جسم و جان از کفر و دین قربی و لاغر داشتن(@)(@@) 37 پند من بنیوش و علم دین طلب از بهر آنک %~% جز بدانش خوب نبود زینت و فر داشتن(@)(@@) 38 علم دین را تا نیابی چشم دل را عقل ساز %~% تا نباید حاجتت بر روی معجر داشتن(@)(@@) 39 تا ترا جاهل شمارد عقل سودت کی کند %~% مذهب سلمان و صدق و زهد بوذر داشتن(@)(@@) 40 علم چه بود فرق دانستن حقی از باطلی %~% نی کتاب زرق شیطان جمله از بر داشتن(@)(@@) 41 گبرکی چبود فکندن دین حق در زیر پای %~% پس چو گبران سال و مه بردست ساغر داشتن(@)(@@) 42 گبرکی بگذار و دین حق بجو از بهر آنک %~% ناک را نتوان به جای مشک اذفر داشتن(@)(@@) 43 گر بدین سیرت بخواباند ترا ناگاه مرگ %~% پس ز آتش بایدت بالین و بستر داشتن(@)(@@) 44 ای سنا بی وارهان خود را که نازیبا بود %~% دایه را بر شیرخواره مهر مادر داشتن(@)(@@) 45 از پی آسایش این خویشتن دشمن خران %~% تا کی آخر خویشتن حیران و مضطر داشتن(@)(@@) 46 بندگی کن آل یاسین را به جان تا روز حشر %~% همچو بی‌دینان نباید روی اصفر داشتن(@)(@@) 47 زیور دیوان خودساز این مناقب را از آنک %~% چاره نبود نو عروسان را 
ms471	 ز زیور داشتن PageV1P0581(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 شرط مردان نیست در دل عشق جانان داشتن %~% پس دل اندر بند وصل و بند هجران داشتن(@)(@@) 2 بلکه اندر عشق جانان شرط مردان آن بود %~% بر در دل بودن و فرمان جانان داشتن(@)(@@) 3 در که از بحر عطا خیزد صدف دل ساختن %~% تیز کز شست قضا آید هدف جان داشتن(@)(@@) 4 نوک پیکانها که بر جانها رسد بر جان خویش %~% نامشان پیکان سلطانی نه پیکان داشتن(@)(@@) 5 از برای جاه سلطان نز پی سگبان و سگ %~% دل محط رحل سگبانان سلطان داشتن(@)(@@) 6 عقل ناکس روی را مصحف در آب انداختن %~% عشق برنا پیشه را شمشیر بران داشتن(@)(@@) 7 چون ز دست دوست خوردی در مذاق از جام جان %~% لقمه را حلوا و بلوا هر دو یکسان داشتن(@)(@@) 8 چون جمال زخم چوگان دیدی اندر دست دوست %~% خویشتن را پای کوبان گوی میدان داشتن(@)(@@) 9 وصل بتوان خواست لیک از قهر نتوان یافتن %~% وقت نتوان یافت لیک از لطف بتوان داشتن(@)(@@) 10 بر در میدان الا الله تیغ لا اله %~% هر قرینی کونه زالله بهر قربان داشتن(@)(@@) 11 شرط مومن چیست اندر خویشتن کافر شدن %~% شرط کافر چیست اندر کفر ایمان داشتن(@)(@@) 12 هر چه دست آویز داری جز خدا آن هیچ نیست %~% چون عصا پنداشتن در دست ثعبان داشتن(@)(@@) 13 خویشتن را چون نمک بگداخت باید تا توان %~% خویشتن بر خوان ربانی نمکدان داشتن(@)(@@) 14 کی توان با صدهزاران پرده نا بود و بود %~% اهرمن را قابل انوار یزدان داشتن(@)(@@) 15 کی توان با همرهان خطه کون و فساد %~% جان خود را محرم اسرار فرقان داشتن(@)(@@) 16 هم به جاه آن اگر ممکن شود در راه آن %~% هر دو گیهان داشتن پس بر سری آن داشتن(@)(@@) 17 خویشتن اول بباید شستن از گرد حدوث %~% آن گه خود را چو قرا ز اهل قرآن داشتن(@)(@@) 18 چند ازین در جستجوی و رنگ 
ms472	 و بوی و گفتگوی %~% خویشتن در تنگنای نفس انسان داشتن(@)(@@) 19 چون دو شب همخوابه خواهد بود با خورشید ماه %~% در محاق او را چه بیم از شکل نقصان داشتن(@)(@@) 20 خاک و باد و آب و آتش را به ارکان بازده %~% چند خواهی خویشتن موقوف دوران داشتن(@)(@@) 21 تا کی اندر پرده غفلت ز راه رنگ و بوی %~% این رباط باستانی را به بستان داشتن(@)(@@) 22 خوب نبود سوخته جبریل پر در عشق تو %~% آن گه از رضوان امید مرغ بریان داشتن(@)(@@) 23 کدخدای هر دو عالم بود خواهی پس ترا %~% زشت باشد زیر کیوان تخت و ایوان داشتن(@)(@@) 24 بگذر از نفس بهیمی تا نباید تنت را %~% طمع نقل و مرغ و خمر و حور و غلمان داشتن(@)(@@) 25 بگذر از عقل طبیعی تا نباید جانت را %~% صورت تخییل هر بی‌دین به برهان داشتن(@)(@@) 26 تا کی از کاهل نمازی ای حکیم زشت خوی %~% همچو دونان اعتقاد اهل یونان داشتن(@)(@@) 27 صدق بوبکری و حذق حیدری کردن رها %~% پس دل اندر زمره فرعون و هامان داشتن(@)(@@) 28 عقل نبود فلسفه خواندن ز بهر کاملی %~% عقل چه بود جان نبی خواه و نبی خوان داشتن(@)(@@) 29 دین و ملت نی و بر جان نقش حکت دوختن %~% نوح و کشتی نی و در دل عشق طوفان داشتن(@)(@@) 30 فقه نبود قال و قیل از بهر کسب جاه و مال %~% فقه چه بود عقل و جان و دین به سامان داشتن(@)(@@) 31 از برای سختن دعوی و معنی روز عدل %~% صد زبان خاموش و گویا همچو میزان داشتن(@)(@@) 32 هر کجا شیریست خود را چون شکر بگداختن %~% هر کجا سیریست خود را چون سپندان داشتن(@)(@@) 33 از پی تهذیب جان پیوسته بر خوان بلا %~% چاشنی گیران جان را تیز دندان داشتن(@)(@@) 34 عقل را بهر تماشا گرد سروستان غیب %~% همچو طاووسان روحانی خرامان داشتن(@)(@@) 35 چون بپویی راه دانی چیست علم 
ms473	 آموختن %~% چون بجویی علم دانی چست کیهان داشتن(@)(@@) 36 دین نباشد با مراد و با هوا در ساختن %~% دین چه باشد خویشتن در حکم یزدان داشتن(@)(@@) 37 چارپایی بی‌دم عیسی مریم تاختن %~% چوب دستی بی‌کف موسی عمران داشتن(@)(@@) 38 آفتی‌دان عشوه ده را سر شرع آموختن %~% فتنه‌ای دان دیو را مهر سلیمان داشتن(@)(@@) 39 هر دم از روی ترقی بر کتاب عاشقی %~% «جددوا ایمانکم» در دیده جان داشتن(@)(@@) 40 از برای پاکی دین در سرای خامشی %~% عقل دانا زندگانی را به زندان داشتن(@)(@@) 41 عشق نبود درد را داروی صبر آمیختن %~% عشق چبود ذوق را همدرد درمان داشتن(@)(@@) 42 از برای غیرت معشوق هم در خون دل %~% ای دریغا های خون‌آلود پنهان داشتن(@)(@@) 43 گه گهی در کوی حیرت بی‌فضولی گوش و لب %~% از دل سنگین جلاجل وز لب افغان داشتن(@)(@@) 44 زهد چبود هر چه جز حق روی ازو برتافتن %~% زهد نبود روی چون طاعون و قطران داشتن(@)(@@) 45 فقر نبود باد را از خاک خفتان دوختن %~% فقر چبود بود را از بود عریان داشتن(@)(@@) 46 از برای زاد راه اندر چراگاه صفا %~% پیش جانان جان بی‌جان خوان بی‌نان داشتن(@)(@@) 47 عقل و جان پستان بستانست طفل راه را %~% گر تو مردی تا کی از پستان و بستان داشتن(@)(@@) 48 عشق دنیا کافری باشد که شرط مومنست %~% صحن بازی جان رندان را به زندان داشتن(@)(@@) 49 چون ز شبهت خویشتن را تربیت کردی ترا %~% از جوارح ظلم باشد چشم احسان داشتن(@)(@@) 50 چون طعامش پاک دادی پس مسلم باشدت %~% چون سگ اصحاب کهف او را نگهبان داشتن(@)(@@) 51 تا ترا در خاکدان ناسوت باشد میزبان %~% کی توان لاهوت را در خانه مهمان داشتن(@)(@@) 52 خویش و جان را در دو گیتی از برای خویشتن %~% چار میخ عقل و نفس و چار ارکان داشتن(@)(@@) 53 خاکپاشان دیگرند و باد پیمایان دگر %~% کی توان ساسانیان را ز آل سامان داشتن(@)(@@) 54 
ms474	 سینه نتوان خانه «ام الخبائث» ساختن %~% چون بصر نتوان فدای ام غیلان داشتن(@)(@@) 55 تا کی از نار هوا نز روی هویت چنین %~% خویشتن را بیهده مدهوش و حیران داشتن(@)(@@) 56 زشت باشد خویشتن بستن بر آدم وانگهی %~% نفس آدم را غلام نفس شیطان داشتن(@)(@@) 57 تا بیابی بوی یوسف بایدت یعقوب‌وار %~% رخت و بخت و عقل و جان در بیت احزان داشتن(@)(@@) 58 قابل تکلیف شرعی تا خرد با تست از آنک %~% چاره نبود اسب کودن را ز پالان داشتن(@)(@@) 59 کو کمال حیرتی تا مر ترا رخصت بود %~% صورت جان را نه کافر نه مسلمان داشتن(@)(@@) 60 کو جمال طاعتی تا مر ترا فتوی دهد %~% از برای چشم بد خالی ز عصیان داشتن(@)(@@) 61 گر چه برخوانند حاضر لیک نتوان از گزاف %~% برفراز خوان مگس را همچو اخوان داشتن(@)(@@) 62 دوزخ آشامان بدند ایشان و اینان کاهلان %~% این خسان را کی توان هم سنگ ایشان داشتن(@)(@@) 63 دشمن خود باش زیرا جز هوا نبود ترا %~% تا تو یار خویش باشی یار نتوان داشتن(@)(@@) 64 تا کی اندر صدر «قال الله» یا «قال الرسول» %~% قبله تخییل فلان یا قیل بهمان داشتن(@)(@@) 65 خوب نبود عیسی اندر خانه پس در آستین %~% از برای توتیا سنگ سپاهان داشتن(@)(@@) 66 چون بزیر این دو گویی گوی شو چون این و آن %~% از پی شاهان گذار آیین چوگان داشتن(@)(@@) 67 تا کی اندر کار دنیا تا کی اندر شغل دین %~% از حریصی خویشتن دانا و نادان داشتن(@)(@@) 68 اهل دنیا اهل دین نبوند ازیرا راست نیست %~% هم سکندر بودن و هم آب حیوان داشتن(@)(@@) 69 برکه خندد پس خضر چون با شما بیند همی %~% گور کن در بحر و کشتی در بیابان داشتن(@)(@@) 70 چون ز راه صدق و صفوت نز من آید نز شما %~% صدق بوذر داشتن یا عشق سلمان داشتن(@)(@@) 71 بوهریره‌وار باید باری اندر اصل و فرع %~% گه دل اندر 
ms475	 دین و گه دستی در انبان داشتن(@)(@@) 72 دین ز درویشان طلب زیرا که شاهان را مقیم %~% رسم باشد گنجها در جای ویران داشتن(@)(@@) 73 از خود و از خلق نرهی تا نگردد بر تو خوش %~% در دبیرستان حیرت لوح نسیان داشتن(@)(@@) 74 چند بر باد هوا خسبی همی عفریت‌وار %~% خویشتن در آب و آتش همچو دیوان داشتن(@)(@@) 75 راحت از دیوان نجویی پس ز دیوان دور شو %~% باز هل همواره دیوان را به دیوان داشتن(@)(@@) 76 کی توان از خلق متواری شدن پس در ملا %~% مشعله در دست و مشک اندر گریبان داشتن(@)(@@) 77 شاعری بگذار و گرد شرع گرد ایرا ترا %~% زشت باشد بی‌محمد نظم حسان داشتن(@)(@@) 78 ورت خرسندی درین منزل ولی نعمت بود %~% رو که چون من بی‌نیازی از فراوان داشتن(@)(@@) 79 باد بیرون کن ز سر تا جمع گردی بهر آنک %~% خاک را جز باد نتواند پریشان داشتن(@)(@@) 80 راستی اندر میان داوری شرطست از آنک %~% چون الف زو دور شد دستی در امکان داشتن(@)(@@) 81 گر چو خورشیدی نباید تا بوی غماز خویش %~% توبه باید کرد ازین رخسار رخشان داشتن(@)(@@) 82 بی طمع زی چون سنایی تا مسلم باشدت %~% خویشتن را زین گرانجانان تن آسان داشتن(@)(@@) 83 باد کم کن جان خود را تا توانی همچنو %~% خاک پای خاکپاشان خراسان داشتن PageV1P0582(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 دست اندر لام لا خواهم زدن %~% پای بر فرق هوا خواهم زدن(@)(@@) 2 نفی و اثباتست اندر عاشقی %~% صدمه در صور بقا خواهم زدن(@)(@@) 3 در دبیرستان «لا احصی ثنا» %~% خیمه خلوت جدا خواهم زدن(@)(@@) 4 گام اندر عاشقی مردانه‌وار %~% از ثریا تا ثرا خواهم زدن(@)(@@) 5 آه کاندر کار دل هر ساعتی %~% همچو موسی با عصا خواهم زدن(@)(@@) 6 کم عیاران سرای ضرب را %~% نقد بر سنگ صفا خواهم زدن(@)(@@) 7 همچو ایوب از برای مصلحت %~% دست در صبر و بلا خواهم زدن(@)(@@) 8 بر لب دریای قهر از 
ms476	 بوی لطف %~% بانگ بر خوف و رجا خواهم زدن(@)(@@) 9 کم‌زنان را بر بساط نیستی %~% پای همت بر قفا خواهم زدن(@)(@@) 10 از برون عالم جان و خرد %~% لاف تسلیم و رضا خواهم زدن(@)(@@) 11 زخمه اخلاص اندر صدر جان %~% بر نوای لا الا خواهم زدن(@)(@@) 12 طرف دولت از برای بندگی %~% بر دوال کبریا خواهم زدن(@)(@@) 13 تیر توفیق از کمان اعتقاد %~% بر دل کام و هوا خواهم زدن(@)(@@) 14 کفر و دین را در مقام نیستی %~% بر نوای بی‌نوا خواهم زدن(@)(@@) 15 خویشتن را در مصال «قل کفی» %~% بر صف اهل رضا خواهم زدن(@)(@@) 16 هم چو مستان در صف میخوارگان %~% نعره «انی ارا» خواهم زدن(@)(@@) 17 ای سنایی با ثنایی هر زمان %~% چنگ در آل عبا خواهم زدن PageV1P0583(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای مسافر اندرین ره گام عاشق‌وار زن %~% فرش لاف اندر نورد و گفت از کردار زن(@)(@@) 2 گر نسیم مشک معنی نیست اندر جیب تو %~% دست همت باری اندر دامن عطار زن(@)(@@) 3 هرکت از زر باز گوید اوست دقیانوس تو %~% گر همی دین بایدت خیمه میان غار زن(@)(@@) 4 دیو طرارست پیش آهنگ حرب وی تویی %~% سوزن تمهید را در چشم این طرار زن(@)(@@) 5 پیش از آن کز غدر عالم لال گردد جان تو %~% آتش درویشی اندر عالم غدار زن(@)(@@) 6 منزلی کآنجا نشان خیمه معشوق تست %~% خاک اندر سرمه ساز و بوسه بر دیوار زن(@)(@@) 7 گر نثار پای معشوقان بود در راه وصل %~% با دو دیده در بپاش و با دو رخ ایثار زن(@)(@@) 8 چون سوار راهبر گشتی تو در میدان عشق %~% شو پیاده آتش آندر زین و زین‌افزار زن(@)(@@) 9 هوشیار از باده و مست از می دنیا چه سود %~% طیلسان فقر و بر فرق چنین هشیار زن(@)(@@) 10 در خرابات خرابی همچو مستان گوشه‌گیر %~% خیمه قلاشی اندر خانه خمار زن(@)(@@) 11 پای در میدان مهر کمزنان ملک نه %~% نرد 
ms477	 بازیدی ز مستی حصل بر اسرار زن(@)(@@) 12 جان و دل را در قباله عاشقی اقرار کن %~% پس به نام عاشقی مهری بر آن اقرار زن(@)(@@) 13 گر همه دعوی کنی در عاشقی و مفلسی %~% چون سنایی دم درین عالم قلندروار زن PageV1P0584(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای یار مقامر دل پیش آی و دمی کم زن %~% زخمی که زنی بر ما مردانه و محکم زن(@)(@@) 2 در پاکی و بی‌باکی جانا چو سرانداران %~% چون کم زدی اندر دم آن کمزده را کم زن(@)(@@) 3 اشغال دو عالم را در مجلس قلاشان %~% چون زلف نکورویان بر هم نه و بر هم زن(@)(@@) 4 در چارسوی عنصر صد قافله غم هست %~% یک نعره ز چالاکی بر قافله غم زن(@)(@@) 5 آبی که نهی زان پس بر عالم عالم نه %~% آتش که زنی آن گه در عالم عالم زن(@)(@@) 6 ار تخت نهی ما را در صف ملایک نه %~% ور دار زنی ما را بر گنبد اعظم زن(@)(@@) 7 در بوته قلاشان چون پاک شدی زر شو %~% وندر صف مهجوران چون صبح شدی دم زن(@)(@@) 8 تاج «انا عبدالله» بر تارک عیسی نه %~% مهری ز سخن گفتن بر دو لب مریم زن(@)(@@) 9 هر طعمه که آن خوشتر مر بی‌خبران را ده %~% هر طعنه که آن سختر بر تارک محرم زن(@)(@@) 10 رخت از در همرنگان بردار و به یکسو نه %~% وندر بر همدردان خر پشته و طارم زن(@)(@@) 11 در مجلس مستوران وندر صف رنجوران %~% هم جام چو رستم کش هم تیغ چو رستم زن(@)(@@) 12 یاران موافق را شربت ده و پرپر ده %~% پیران منافق را ضربت زن و دم دم زن(@)(@@) 13 نقلی که نهی دل را در حجره مریم نه %~% لافی که زنی جان را از زاده مریم زن(@)(@@) 14 نازی که کنی اینجا با عاشق محرم کن %~% لافی که زنی باری با شاهد محرم زن(@)(@@) 15 کحل «ارنی انظر» 
ms478	 در دیده موسی کش %~% خال «فعصی آدم» در چهره آدم زن(@)(@@) 16 گر باده همی ما را بر تارک کیوان ده %~% ور رای زنی ما را در قعر جهنم زن(@)(@@) 17 چون عشق به دست آمد تن دور کن و خوش زی %~% چون عقل به پا آمد پی گور کن و خم زن(@)(@@) 18 غماز و سیه رویند اینجا شب و روز تو %~% در سینه آن سم نه در شربت آن سم زن(@)(@@) 19 بر تارک هفت اختر چون خیمه زدی زان پس %~% هم خصل دمادم نه هم رطل دمادم زن(@)(@@) 20 خواهی که سنایی را سرمست به دست آری %~% خاشاک بر اشهب نه تازانه بر ادهم زن PageV1P0585(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 چو مردان بشکن این زندان یکی آهنگ صحرا کن %~% به صحرا در نگر آن گه به کام دل تماشا کن(@)(@@) 2 ازین زندان اگر خواهی که چون یوسف برون آیی %~% به دانش جان بپرور نیک و در سر علم رویا کن(@)(@@) 3 مشو گمراه و بیچاره چنین اندر ره سودا %~% چراغ دانشت بفروز و آن گه رای سودا کن(@)(@@) 4 ز موسی رهروی آموز اگر خواهی به دیدن ره %~% گذرگه برفراز کوه و گه بر قعر دریا کن(@)(@@) 5 چو زین سودای جسمانی برون آیی تو آنگاهی %~% به راه وحدت از حکمت علامتهای بیضا کن(@)(@@) 6 ره وحدانیت چون کرد روشن دیده عقلت %~% به نقش مهر هستیهای حسی صورت لاکن(@)(@@) 7 سر حرف شهادت لا از آن معنی نهاد ایزد %~% چو حرف لا اله گفتن به الا الله مبدا کن(@)(@@) 8 سلیمان‌وار دیوان را مطیع امر خود گردان %~% نشین بر تخت بلقیسی و چتر از پر عنقا کن(@)(@@) 9 چو موسی گوسفندان را یکی ره سوی صحرا بر %~% پس آن گه با عصا آهنگ کوه طور سینا کن(@)(@@) 10 مسیحاوار دعوی تو ننیوشند اگر خواهی %~% یقینت چون مسیحا دار و دعوی مسیحا کن(@)(@@) 11 ملاقا چون کنی با عقل 
ms479	 زیر پرده حسی %~% نخست از پرده بیرون آی و پس رای ملاقا کن(@)(@@) 12 چو عیسی گر همی خواهی که مانی زنده جاویدان %~% ز احیائت بساز اموات و از اموات احیا کن(@)(@@) 13 امید عمر جاویدان کنی چون گوهر یکتا %~% دل از اندیشه اوباش جسمانیت یکتا کن(@)(@@) 14 به کف کن حشمت و نعمت ز بهر نام و ننگ اندر %~% چو آمد حشمت و نعمت ز غربت قصد ماوا کن(@)(@@) 15 ز حرص و نفس شهوانی عدیل و یار شیطانی %~% ز شیطان دور شو آن گه امید وصل حورا کن(@)(@@) 16 ز اول داد خلق از خود بده آن گه ز مردم جوی %~% به فر اوج اسکندر شو آن گه قصد دارا کن(@)(@@) 17 چو زهره گر طمع داری شدن بر اوج اعلابر %~% به دانش جان گویا را تو همچون زهره زهرا کن(@)(@@) 18 تو چون زین دامگاه دیو دوری جویی از دیوان %~% به جمله بگسل آن گه روی سوی چرخ اعلا کن(@)(@@) 19 اگر خواهی که در وحدت روانت پادشا گردد %~% سرای ملکت و دین را تهی از شور و غوغا کن(@)(@@) 20 تن و جان تو بیمار از سخنهای خلافی شد %~% برانداز این خلاف از علم و جانت را مداوا کن(@)(@@) 21 گر از جانان خبر داری تو جان را زیر پای آور %~% ور از نفس آگهی داری حدیث از نفس رعنا کن(@)(@@) 22 جمال چهره جانان اگر خواهی که بینی تو %~% دو چشم سرت نابینا و چشم عقل بینا کن(@)(@@) 23 هوای دوست گر خواهی شراب شوق جانان خور %~% وصال یار اگر خواهی طواف جای بطحا کن(@)(@@) 24 ببینی بی‌نقاب آن گه جمال چهره قرآن %~% چو قرآن روی بنماید زبان ذکر گویا کن(@)(@@) 25 چو چشم عقل بگشادی عیان هر نهان دیدی %~% زبان ذکر بگشادی بیان هر معما کن(@)(@@) 26 چو مجنون دل پر از خار فراق چشم لیلی‌دار %~% چو وامق جان پر از نقش و نگار 
ms480	 روی عذرا کن(@)(@@) 27 میان کمزنان کمزن چو نرد عاشقان بازی %~% به درد دوری یوسف صبوری چون زلیخا کن(@)(@@) 28 ز رنج نفس و ضعف تن اگر فرتوت گشتستی %~% به شوق دوست جانت را زلیخاوار برنا کن(@)(@@) 29 مجرد چون شدی زالایش نفس طبیعی تو %~% دو گوش عقلت آن گه سوی شعر و حکمت ما کن(@)(@@) 30 سنایی را به طبع اندر چو زینسان شعرها بینی %~% بدان معنی شعرش بین و جان از علم دانا کن PageV1P0586(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 رحل بگذار ای سنایی رطل مالامال کن %~% این زبان را چون زبان لاله یک دم لال کن(@)(@@) 2 یک زمان از رنگ و بوی باده روح‌القدس را %~% در ریاض قدس عنبر مغز و مرجان بال کن(@)(@@) 3 زهد و صفوت یک زمان از عشق در دوزخ فگن %~% حال و وقتت ساعتی در کار زلف و خال کن(@)(@@) 4 در میان زهد کوشان خویشتن قلاش ساز %~% در جهان می‌فروشان خویشتن ابدال کن(@)(@@) 5 شاهد شیرین نخواهد زاهدان تلخ را %~% شاهدی چون شهد خواهی رطل مالامال کن(@)(@@) 6 سرو خود را گوی ای سرو از پی گلزار رخ %~% خون روان در جویبار اکحل و قیفال کن(@)(@@) 7 تو به کژی ما به خدمت چون دو دالیم از صفت %~% یک الف را بهر الفت ردف جفتی دال کن(@)(@@) 8 خاک جسم و آب چشم ما به دست عشق تست %~% خاک را صلصال کردی آب را سلسال کن(@)(@@) 9 باز صیاد اجل را آتشین منقاردار %~% چرخ گیرای امل را کاغذین چنگال کن(@)(@@) 10 دامن تر دامنان عقل در آخال کش %~% ساعد هودج کشان عشق پر خلخال کن(@)(@@) 11 عاشق مالست حرص و دشمن مالست می %~% مال دشمن را به سعی باده دشمن مال کن(@)(@@) 12 خال خود در چشم ما زن صبحهامان شام کن %~% زلف خود بر دوش خود نه روزهامان سال کن(@)(@@) 13 عشق یک رویست او را بر در عیسی نشان %~% عقل یک 