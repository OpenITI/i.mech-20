5 ) قال 
ms2357	 النبي :(@)(@@) | 30 ( من رعف في صلاته فلينصرف فليتوضأ ثم ليبن على ما صلى ) )(@)(@@) ( هق ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 21986 ) قال النبي :(@)(@@) | 30 ( من رغب في الدنيا وأطال فيها رغبته ، أعمى الله قلبه على قدر رغبته فيها ، ومن زهد في الدنيا وقصر فيها أمله أعطاه الله علما من غير تعلم ، وهدي من غير هداية ) )(@)(@@) أبو عبد الرحمان السلمي في كتاب المواعظ والوصايا عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21987 ) قال النبي :(@)(@@) | 30 ( من رفع نفسه في الدنيا قمعه الله يوم القيامة ، ومن تواضع في الدنيا بعث الله إليه ملكا يوم القيامة فانتشطه من بين الجمع فقال أيها العبد الصالح يقول الله عز وجل : إلي فإنك ممن لا خوف عليهم ولا هم يحزنون ) )(@)(@@) ابن عساكر عن أبي بن كعب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21988 ) قال النبي :(@)(@@) | 30 ( من رفق بأمتي رفق الله به ، ومن شق على أمتي شق الله عليه ) )(@)(@@) ابن أبي الدنيا في ذم الغضب عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 21989 ) قال النبي :(@)(@@) | 30 ( من ركب فرسا ثم استعرض أمتي يقتلهم بسيفه خرج من الإسلام ) )(@)(@@) ابن عساكر عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21990 ) قال النبي :(@)(@@) | 30 ( من ركب البحر حين يرتج فلا ذمة له ، ومن بات PageV07P215 على ظهر بيت ليس عليه سترة فمات فلا ذمة له ) )(@)(@@) الباوردي عن زهير بن أبي حيل رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21991 ) قال النبي :(@)(@@) | 30 ( من ركب دابة فقال : ( سبحان الذي سخر لنا هاذا وما كنا له مقرنين ) )(@)(@@) ثم مات قبل أن ينزل مات شهيدا ) )(@)(@@) | أ| بو الشيخ وأبو نعيم عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21992 ) قال النبي :(@)(@@) | 30 ( من رمى رمية في سبيل الله فهي له عدل محرر ) )(@)(@@) ( طس ض ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21993 ) قال النبي :(@)(@@) | 30 ( من ركع ركعة ؛ أو سجد سجدة رفعه الله بها درجة وحط عنه بها خطيئة ) )(@)(@@) ( حم ) و الطحاوي والروياني ( ض ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21994 ) قال النبي :(@)(@@) | 30 ( من رهن أرضا بدين فإنه يقضي من 
ms2358	 ثمرتها ما فضل بعد نفقتها يقضي ذالك له من دينه ذالك الذي عليه بعد أن يحسب لصاحبها الذي هي عنده عمله ونفقته بالعدل ) )(@)(@@) ( طب ) عن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21995 ) قال النبي :(@)(@@) | 30 ( من رمى بالليل فليس منا ، ومن رقد على سطح لا جدار له فسقط فمات فدمه هدر ) )(@)(@@) ( طب ) عن عبد الله بن جعفر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21996 ) قال النبي :(@)(@@) | 30 ( من رمى بسهم في سبيل الله فقصر أو بلغ كان ذالك له نورا يوم القيامة ) )(@)(@@) ( طب ) عن ابن عمرو الأنصاري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21997 ) قال النبي :(@)(@@) | 30 ( من رمى بسهم في سبيل الله كان كمن أعتق رقبة ) )(@)(@@) ( حب ) عن كعب بن مرة رضي الله عنه .(@)(@@) PageV07P216(@)(@@)(@@)(@@) $ ( 21998 ) قال النبي :(@)(@@) | 30 ( من رمى الجمرة بسبع حصيات ، الجمرة التي عند العقبة ثم انصرف فنحر هديه ثم حلق فقد حل له ما حرم عليه من شأن الحج ) )(@)(@@) البزار عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21999 ) قال النبي :(@)(@@) | 30 ( من روع مؤمنا لم تؤمن روعته يوم القيامة ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22000 ) قال النبي :(@)(@@) | 30 ( من زاد ببناء في المسجد فله الجنة ) )(@)(@@) ابن نعيم في فضائل الصحابة عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22001 ) قال النبي :(@)(@@) | 30 ( من زار قبري كنت له شفيعا أو شهيدا ، ومن مات في أحد الحرمين بعثه الله من الآمنين يوم القيامة ) )(@)(@@) ( ط هق ) عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22002 ) قال النبي :(@)(@@) | 30 ( من زارني بعد موتي فكأنما زارني في حياتي ، ومن مات في أحد الحرمين بعث من الآمنين يوم القيامة ) )(@)(@@) ابن قانع ( هب ) عن حاطب بن الحارث رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22003 ) قال النبي :(@)(@@) | 30 ( من زارني متعمدا كان في جواري يوم القيامة ، ومن سكن المدينة وصبر على بلائها كنت له شهيدا وشفيعا يوم القيامة ، ومن مات في أحد الحرمين بعثه الله من الآمنين يوم القيامة ) )(@)(@@) ( هب ) عن رجل من آل الخطاب .(@)(@@)(@@)(@@) $ ( 22004 ) قال النبي :(@)(@@) | 30 ( من زار أخاه المؤمن خاض في رياض الرحمة حتى يرجع ، ومن 
