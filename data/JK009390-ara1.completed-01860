ms1855	 جندب رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 17154 ) قال النبي :(@)(@@) | 30 ( لقد دنت مني الجنة حتى لو اجترأت عليها لجئتكم بقطاف من قطافها ، ودنت مني النار حتى قلت : أي رب وأنا فيهم ؟ ورأيت امرأة تخدشها هرة لها فقلت : ما شأن هاذه ؟ قال : حبستها حتى ماتت جوعا ، لا هي أطعمتها ولا هي أرسلتها تأكل من خشاش الأرض ) )(@)(@@) ( حم ه ) عن أسماء بنت أبي بكر رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 17155 ) قال النبي :(@)(@@) | 30 ( لقد رأيت الآن منذ صليت لكم الجنة والنار ممثلتين في قبلة هاذا الجدار ، فلم أر كاليوم في الخير والشر ) )(@)(@@) ( خ ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17156 ) قال النبي :(@)(@@) | 30 ( لقد رأيت الملائكة تغسل حمزة ) )(@)(@@) ابن سعد عن الحسن مرسلا .(@)(@@) PageV06P053(@)(@@)(@@)(@@) $ ( 17157 ) قال النبي :(@)(@@) | 30 ( لقد رأيت رجلا يتقلب في الجنة في شجرة قطعها من ظهر الطريق كانت تؤذي الناس ) )(@)(@@) ( م ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17158 ) قال النبي :(@)(@@) | 30 ( لقد رأيتني في الحجر وقريش تسألني عن مسراي ، فسألتني عن أشياء من بيت المقدس لم أثبتها ، فكربت كربا ما كربت مثله قط ، فرفعه الله لي أنظر إليه ، ما يسألوني عن شيء إلا أنبأتهم به ، وقد رأيتني في جماعة من الأنبياء ، فإذا موسى قائم يصلي فإذا رجل جعد ضرب كأنه من رجال شنوءة ، وإذا عيسى بن مريم قائم يصلي أقرب الناس به شبها عروة بن مسعود الثقفي ، وإذا إبراهيم قائم يصلي أشبه الناس به صاحبكم ، يعني نفسه ، فحانت الصلاة فأممتهم ، فلما فرغت من الصلاة قال قائل : يا محمد هاذا مالك صاحب النار فسلم عليه ، فالفتت إليه فبدأني بالسلام ) )(@)(@@) ( م ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 17159 ) قال النبي :(@)(@@) | 30 ( لقد رأيتني يوم أحد وما في الأرض قربي مخلوق غير جبريل عن يميني وطلحة عن يساري ) )(@)(@@) ( ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17160 ) قال النبي :(@)(@@) | 30 ( لقد سألتني عن عظيم وإنه ليسير على من يسره الله عليه ، تعبد الله لا تشرك به شيئا ، وتقيم الصلاة المكتوبة ، وتؤتي الزكاة المفروضة ، وتصوم رمضان ، وتحج 
ms1856	 البيت . ألا أدلك على أبواب الخير : الصوم جنة ، والصدقة تطفىء الخطيئة كما يطفىء الماء النار ، وصلاة الرجل في جوف الليل . ألا أخبرك برأس الأمر وعموده وذروة سنامه ، رأس الأمر الإسلام : من أسلم سلم ، وعموده الصلاة ، وذروة سنامه الجهاد . ألا أخبرك بملاك ذالك كله : كف عليك هاذا ، وأشار إلى لسانه ، قال : يا نبي الله وإنا لمؤاخذون بما نتكلم به ؟ PageV06P054 قال : ثكلتك أمك يا م| عاذ ، وهل يكب الناس في النار على وجوههم إلا حصائد ألسنتهم ) )(@)(@@) ( حم ت ك ه هب ) عن معاذ ، زاد ( طب هب ) : إنك لن تزال سالما ما سكت ، فإذا تكلمت كتب لك أو عليك . ( ز ) .(@)(@@)(@@)(@@) $ ( 17161 ) قال النبي :(@)(@@) | 30 ( لقد طاف الليلة بآل محمد نساء كثير كلهن تشكو زوجها من الضرب ، وايم الله لا تجدون أولائك خياركم ) )(@)(@@) ( د ن حب ك ) عن إياس الدوسي رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 17162 ) قال النبي :(@)(@@) | 30 ( لقد طهر الله أهل هاذه الجزيرة من الشرك إن لم تضلهم النجوم ) )(@)(@@) ابن خزيمة ( طب ) عن العباس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 17163 ) قال النبي :(@)(@@) | 30 ( لقد قرأتها يعني سورة الرحمان على الجن ليلة الجن ، فكانوا أحسن مردودا منكم ، كنت كلما أتيت على قوله : { فبأي آلاء ربكما تكذبان } ، قالوا : ولا بشيء من نعمك ربنا نكذب فلك الحمد ) )(@)(@@) ( ت ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 17164 ) قال النبي :(@)(@@) | 30 ( لقد قلت بعدك أربع كلمات ثلاث مرات ، لو وزنت بما قلت منذ اليوم لوزنتهن : سبحان الله وبحمده عدد خلقه ، ورضا نفسه ، وزنة عرشه ، ومداد كلماته ) )(@)(@@) ( م د ) عن جويرية رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 17165 ) قال النبي :(@)(@@) | 30 ( لقد قلت كلمة لو مزجت بماء البحر لمزجته ) )(@)(@@) ( د ت ) عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 17166 ) قال النبي :(@)(@@) | 30 ( لقد لقيت من قومك ، وكان أشد ما لقيت منهم يوم العقبة ، إذ عرضت نفسي على ابن عبد ياليل بن عبد كلال فلم يجبني إلى ما أردت ، فانطلقت وأنا مهموم على وجهي ، فلم أستفق إلا وأنا بقرن الثعالب ، PageV06P055 فرفعت رأسي فإذا أنا بسحابة 
ms1857	 قد أظلتني ، فنظرت فإذا فيها جبريل فناداني فقال : إن الله قد سمع كلام قومك لك وما ردوا عليك ، وقد بعث إليك ملك الجبال لتأمره بما شئت فيهم ، فناداني ملك الجبال فسلم علي ثم قال : يا محمد فقال ذالك ، فما شئت ؟ إن شئت أطبق عليهم الأخشبين ، قلت : بل أرجو أن يخرج الله من أصلابهم من يعبد الله وحده لا يشرك به شيئا ) )(@)(@@) ( حم ق ) عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 17167 ) قال النبي :(@)(@@) | 30 ( لقد هممت أن آمر رجلا يصلي بالناس ثم أحرق على رجال يتخلفون عن الجمعة بيوتهم ) )(@)(@@) ( حم م ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17168 ) قال النبي :(@)(@@) | 30 ( لقد هممت أن آمر فتيتي فيجمعوا حزما من حطب ، ثم آتي قوما يصلون في بيوتهم ليست بهم علة فأحرقها عليهم ) )(@)(@@) ( د ت ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 17169 ) قال النبي :(@)(@@) | 30 ( لقد هممت أن أرسل إلى أبي بكر وأنبه فأعهد أن يقول القائلون أو يتمنى المتمنون ثم قلت يأبى الله ويدفع المؤمنون ) )(@)(@@) ( خ ) عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 17170 ) قال النبي :(@)(@@) | 30 ( لقد هممت أن ألعنه لعنا يدخل معه قبره ، كيف يورثه وهو لا يحل له ؟ كيف يستخدمه وهو لا يحل له ؟ ) )(@)(@@) ( حم م د ) عن أبي الدرداء رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 17171 ) قال النبي :(@)(@@) | 30 ( لقد هممت أن أنهى عن الغيلة حتى ذكرت أن PageV06P056 الروم وفارس يصنعون ذالك فلا يضر أولادهم ) )(@)(@@) مالك ( حم م 4 ) عن جدامة بنت وهب رضي الله عنها .(@)(@@)(@@)(@@) $ ( 17172 ) قال النبي :(@)(@@) | 30 ( لقد هممت أن لا أقبل هدية إلا من قرشي ، أو أنصاري ، أو ثقفي ، أو دوسي ) )(@)(@@) ( ن ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17173 ) قال النبي :(@)(@@) | 30 ( لقلب ابن آدم أشد انقلابا من القدر إذا استجمعت غليانا ) )(@)(@@) ( حم ك ) عن المقداد بن الأسود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17174 ) قال النبي :(@)(@@) | 30 ( لقنوا موتاكم لا إلاه إلا الله ) )(@)(@@) ( حم م 4 ) عن أبي سعيد ( م ه ) عن أبي هريرة ( ن ) عن عائشة رضي 
ms1858	 الله عنهم .(@)(@@)(@@)(@@) $ ( 17175 ) قال النبي :(@)(@@) | 30 ( لقنوا موتاكم : لا إلاه إلا الله الحليم الكريم ، سبحان الله رب السماوات السبع ورب العرش العظيم ، الحمد لله رب العالمين ، قالوا : كيف هي للأحياء ؟ قال : أجود وأجود ) )(@)(@@) ( ه ) و الحكيم ( طب ) عن عبد الله بن جعفر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 17176 ) قال النبي :(@)(@@) | 30 ( لقنوا موتاكم لا إلاه إلا الله ، فإن نفس المؤمن تخرج رشحا ، ونفس الكافر تخرج من شدقه كما تخرج نفس الحمار ) )(@)(@@) ( طب ) عن ابن مسعود رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 17177 ) قال النبي :(@)(@@) | 30 ( لقنوا موتاكم : لا إلاه إلا الله فإنه من كان آخر كلامه لا إلاه إلا الله عند الموت دخل الجنة يوما من الدهر ، وإن أصابه قبل ذالك ما أصابه ) )(@)(@@) ( حب ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 17178 ) قال النبي :(@)(@@) | 30 ( لقنوا موتاكم لا إلاه إلا الله وقولوا : الثبات الثبات PageV06P057 ولا حول ولا قوة إلا بالله ) )(@)(@@) ( طس ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 17179 ) قال النبي :(@)(@@) | 30 ( لقيام رجل في الصف في سبيل الله عز وجل ساعة أفضل من عبادة ستين سنة ) )(@)(@@) ( هق خط ) عن عمران بن حصين رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17180 ) قال النبي :(@)(@@) | 30 ( لقيت إبراهيم ليلة أسري بي فقال : يا محمد أقرىء أمتك مني السلام وأخبرهم أن الجنة طيبة التربة عذبة الماء ، وأنها قيعان ، وأن غراسها : سبحان الله ، والحمد لله ، ولا إلاه إلا الله ، والله أكبر ) )(@)(@@) ( ت ) عن ابن مسعود رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 17181 ) قال النبي :(@)(@@) | 30 ( لقيت ليلة أسري بي إبراهيم وموسى وعيسى فتذاكروا أمر الساعة ، فردوا أمرهم إلى إبراهيم فقال : لا علم لي بها ، فردوا الأمر إلى موسى فقال : لا علم لي بها ، فردوا الأمر إلى عيسى فقال : أما وجبتها فلا يعلم بها أحد إلا الله ، وفيما عهد إلي ربي أن الدجال خارج ومعي قضيبان ، فإذا رآني ذاب كما يذوب الرصاص فيهلكه الله إذا رآني ، حتى إن الحجر والشجر ليقول : يا مسلم إن تحتي كافرا فتعال فاقتله فيهلكهم الله ، ثم يرجع الناس إلى 
ms1859	 بلادهم وأوطانهم ، فعند ذالك يخرج يأجوج ومأجوج وهم من كل حدب ينسلون فيطئون بلادهم ، لا يأتون على شيء إلا أهلكوه ولا يمرون على ماء إلا شربوه ، ثم يرجع الناس إلي فيشكونهم ، فأدعو الله عليهم فيهلكهم ويميتهم ، حتى تجوي الأرض من نتن ريحهم ، فينزل الله المطر فيجترف أجسادهم حتى يقذفهم في البحر ، ثم تنسف الجبال ، وتمد الأرض مد الأديم ، ففيما عهد إلي ربي أن ذالك إذا كان كذالك فإن الساعة كالحامل المتم لا يدري أهلها متى تفجؤهم بولادتها ليلا أو نهارا ) )(@)(@@) ( حم ه ك ) عن ابن مسعود رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 17182 ) قال النبي :(@)(@@) | 30 ( لقيد سوط أحدكم من الجنة خير مما بين السماء PageV06P058 والأرض ) )(@)(@@) ( حم ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 17183 ) قال النبي :(@)(@@) | 30 ( لقد هممت أن آمر رجلا فيقيم الصلاة ، ثم آمر فتياني فيخالفون إلى الذين لا يأتونها فيحرقون عليهم بيوتهم بحزم الحطب ، ولو علم أحدهم أنه يجد عظما سمينا أو مرماتين حسنتين لشهد الصلاة ) )(@)(@@) ( حم ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17184 ) قال النبي :(@)(@@) | 30 ( لقد شهدكم أقوام بالمدينة حبسهم المرض ) )(@)(@@) ( حب ) عن جابر قال : كنا في غزاة فقال النبي فذكره .(@)(@@)(@@)(@@) $ ( 17185 ) قال النبي :(@)(@@) | 30 ( لقد وفق وهدي : لا تشرك بالله شيئا ، وتقيم الصلاة ، وتؤتي الزكاة ، وتصل الرحم ، دع الناقة ) )(@)(@@) ( حب ) عن أبي أيوب أن أعرابيا عرض للنبي فأخذ بزمام ناقته فقال : يا رسول الله أخبرني بأمر يدخلني الجنة وينجيني من النار ؟ فنظر إلى وجوه أصحابه وقال : فذكره .(@)(@@)(@@)(@@) $ ( 17186 ) قال النبي :(@)(@@) | 30 ( لقد أمركم الله الليلة بصلاة هي خير لكم من حمر النعم : الوتر فيما بين صلاة العشاء إلى طلوع الفجر ) )(@)(@@) ( ش ) عن خارجة بن حذافة العدوي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17187 ) قال النبي :(@)(@@) | 30 ( لقد أقبلت إليكم مسرعا لأخبركم بليلة القدر فنسيتها فيما بيني وبينكم ، فالتمسوها في العشر الأواخر ) )(@)(@@) ( ع طب ض ) عن ابن عباس PageV06P059 رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 17188 ) قال النبي :(@)(@@) | 30 ( لقد هبط علي ملك من السماء ما هبط على نبي قبلي 
ms1860	 ولا يهبط على أحد بعدي وهو إسرافيل وعندي جبريل فقال : السلام عليك يا محمد ، ثم قال : أنا رسول ربك إليك ، أمرني أن أخبرك : إن شئت نبيا عبدا وإن شئت نبيا ملكا ، فنظرت إلى جبريل فأومأ إلي أن تواضع ، فقلت : نبيا عبدا ، فلو أني قلت نبيا ملكا ثم مشيت لسارت الجبال معي ذهبا ) )(@)(@@) ( طب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 17189 ) قال النبي :(@)(@@) | 30 ( لقد بارك الله في العشرة : كسا الله نبيه قميصا ، ورجلا من الأنصار قميصا ، وأعتق الله منها رقبة ، وأحمد الله الذي رزقنا هاذا بقدرته ) )(@)(@@) ( طب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 17190 ) قال النبي :(@)(@@) | 30 ( لقد رأيت قبيل الفجر كأني أعطيت المقاليد والموازين ، فأما المقاليد فهاذه المفاتيح ، وأما الموازين فهاذه التي تزنون بها ، ووضعت في كفة ووضعت أمتي في كفة فرجحت بهم ، ثم جيء بأبي بكر فوضع في كفة ووضعت أمتي في كفة فرجح بهم ، ثم جيء بعمر فوضع في كفة ووضعت أمتي في كفة فرجح بهم ، ثم جيء بعثمان فوضع في كفة ووضعت أمتي في كفة فرجح بهم ، ثم رفعت الموازين ) )(@)(@@) ( طب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 17191 ) قال النبي :(@)(@@) | 30 ( لقد دعا الله باسمه الأعظم الذي إذا سئل به أعطى ، وإذا دعي به أجاب ) )(@)(@@) ( ش حم د ت ن ه حب ك ض ) عن أنس رضي الله عنه قال : سمع النبي رجلا يقول : اللهم إني أسألك بأن لك الحمد لا إلاه إلا أنت وحدك لا شريك لك ، المنان بديع السماوات والأرض ، ذو الجلال والإكرام ، يا حي يا قيوم قال : فذكره .(@)(@@)(@@)(@@) $ ( 17192 ) قال النبي :(@)(@@) | 30 ( لقد طاف بآل محمد الليلة سبعون امرأة كلهن قد PageV06P060 ضربت ، ما أحب أن أرى الرجل ثائر فريص عصب رقبته على مرئيته يقاتلها ) )(@)(@@) ابن سعد ( ك ق ) عن أم كلثوم بنت أبي بكر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17193 ) قال النبي :(@)(@@) | 30 ( لقد رأيته يتخضخض في أنهار الجنة يعني ماعزا ) )(@)(@@) أبو عوانة ( حب ض ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17194 ) قال النبي :(@)(@@) | 30 ( لقد 