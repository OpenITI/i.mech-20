ms161	 الزيادة ، ثم ليتم ما بقي من صلاته ، ثم يسجد سجدتين وهو جالس قبل أن يسلم ) )(@)(@@) ( حم ه ك هق ) عن عبد الرحمن بن عوف رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1505 ) قال النبي :(@)(@@) | 30 ( إذا شك أحدكم في صلاته فلم يدر اثنتين صلى أو ثلاثا ؟ فليلق الشك وليبن على اليقين ) )(@)(@@) ( هق ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1506 ) قال النبي :(@)(@@) | 30 ( إذا شك أحدكم في صلاته فلم يدر كم صلى ، ثلاثا أم أربعا ؟ فليطرح الشك وليبن على ما استيقن ، ثم ليسجد سجدتين قبل أن يسلم ، فإن كان صلى خمسا شفعن له صلاته ، وإن كان صلى إتماما لأربع كانتا ترغيما للشيطان ) )(@)(@@) ( حم م د ن ه ) عن أبي سعيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1507 ) قال النبي :(@)(@@) | 30 ( إذا شك أحدكم في صلاته فليلق الشك وليبن على اليقين ، فإن استيقن التمام سجد سجدتين ، فإن كانت صلاته تامة ، كانت الركعة نافلة والسجدتان نافلة ، وإن كانت ناقصة ، كانت الركعة تمام الصلاة والسجدتان يرغمان أنف الشيطان ) )(@)(@@) ( حب ك ) عن أبي سعيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1508 ) قال النبي :(@)(@@) | 30 ( إذا شهدت إحداكن العشاء فلا تمس طيبا ) )(@)(@@) ( حم م ن ) عن زينب الثقفية رضي الله عنها .(@)(@@)(@@)(@@) $ ( 1509 ) قال النبي :(@)(@@) | 30 ( إذا شهدت أمة من الأمم وهم أربعون فصاعدا أجاز الله تعالى شهادتهم ) )(@)(@@) ( طب ) و الضياء عن والد أبي المليح رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1510 ) قال النبي :(@)(@@) | 30 ( إذا أشهر المسلم على أخيه سلاحا ، فلا تزال ملائكة PageV01P227 الله تلعنه حتى يشيمه عنه ) )(@)(@@) ( البزار ) عن أبي بكرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1511 ) قال النبي :(@)(@@) | 30 ( إذا صار أهل الجنة إلى الجنة وأهل النار إلى النار ، جيء بالموت حتى يجعل بين الجنة والنار ثم يذبح ، ثم ينادي مناد : يا أهل الجنة خلود لا موت ، يا أهل النار خلود لا موت ، فيزداد أهل الجنة فرحا إلى فرحهم ، ويزداد أهل النار حزنا إلى حزنهم ) )(@)(@@) ( حم ق ) عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1512 ) قال النبي :(@)(@@) | 30 ( إذا صلى أحدكم إلى سترة فليدن منها لا 
ms162	 يمر الشيطان بينه وبينها ) )(@)(@@) ( طب ) و الضياء عن جبير بن مطعم رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1513 ) قال النبي :(@)(@@) | 30 ( إذا صلى أحدكم إلى شيء يستره من الناس فأراد أحد أن يجتاز بين يديه فليدفعه ، فإن أبى فليقاتله فإنما هو شيطان ) )(@)(@@) ( حم ق د ن ) عن أبي سعيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1514 ) قال النبي :(@)(@@) | 30 ( إذا صلى أحدكم إلى غير سترة فإنه يقطع صلاته الحمار والخنزير واليهودي والمجوسي والمرأة ويجزي عنه إذا مروا بين يديه على قذفة بحجر ) )(@)(@@) ( د هق ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1515 ) قال النبي :(@)(@@) | 30 ( إذا صلى أحدكم الجمعة فلا يصل بعدها شيئا حتى يتكلم أو يخرج ) )(@)(@@) ( طب ) عن عصمة بن مالك رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1516 ) قال النبي :(@)(@@) | 30 ( إذا صلى أحدكم فليصل إلى سترة وليدن منها ولا يدع أحدا يمر بين يديه ، فإن جاء أحد يمر فليقاتله فإنما هو شيطان ) )(@)(@@) ( حم ق د ه حب هق ) عن أبي سعيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1517 ) قال النبي :(@)(@@) | 30 ( إذا صلى أحدكم الجمعة فليصل بعدها أربعا ) ( حم م ن ) عن أ$ بي هريرة رضي الله عنه .(@)(@@) PageV01P228(@)(@@)(@@)(@@) $ ( 1518 ) قال النبي :(@)(@@) | 30 ( إذا صلى أحدكم ركعتي الفجر فليضطجع على جنبه الأيمن ) )(@)(@@) ( د ت حب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1519 ) قال النبي :(@)(@@) | 30 ( إذا صلى أحدكم فأحدث فليمسك على أنفه ثم لينصرف ) )(@)(@@) ( ه ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 1520 ) قال النبي :(@)(@@) | 30 ( إذا صلى أحدكم فخلع نعليه فلا يؤذ بهما أحدا ، ليجعلهما بين رجليه أو ليصل فيهما ) )(@)(@@) ( د حب ك هق ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1521 ) قال النبي :(@)(@@) | 30 ( إذا صلى أحدكم فلا يبصق بين يديه ولا عن يمينه وليبصق عن يساره أو تحت قدمه ) )(@)(@@) ( حم حب ) عن جابر ( ن ) عن أبي هريرة رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1522 ) قال النبي :(@)(@@) | 30 ( إذا صلى أحدكم فلا يشبك بين أصابعه فإن التشبيك من الشيطان ، وإن أحدكم لا زال في صلاة ما دام في المسجد حتى يخرج 
ms163	 منه ) )(@)(@@) ( حم ) عن مولى لأبي سعيد الخدري رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1523 ) قال النبي :(@)(@@) | 30 ( إذا صلى أحدكم فلا يضع نعليه عن يمينه ولا عن يساره فتكون عن يمين غيره إلا أن لا يكون عن يساره أحد وليضعهما بين رجليه ) )(@)(@@) ( د ك هق ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1524 ) قال النبي :(@)(@@) | 30 ( إذا صلى أحدكم فلم يدر زاد أم نقص فليسجد سجدتين وهو قاعد ، فإذا أتاه الشيطان فقال إنك قد أحدثت فليقل في نفسه كذبت إلا ما وجد ريحا بأنفه أو سمع صوتا باذنه ) )(@)(@@) ( حم د حب ك ) عن أبي سعيد رضي الله عنه ( ز ) .(@)(@@) PageV01P229(@)(@@)(@@)(@@) $ ( 1525 ) قال النبي :(@)(@@) | 30 ( إذا صلى أحدكم فلم يدر كيف صلى فليسجد سجدتين وهو جالس ) )(@)(@@) ( ت ه ) عن أبي سعيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1526 ) قال النبي :(@)(@@) | 30 ( إذا صلى أحدكم فليأتزر وليرتد ) )(@)(@@) ( حب هق ) عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1527 ) قال النبي :(@)(@@) | 30 ( إذا صلى أحدكم فليبدأ بتحميد الله تعالى والثناء عليه ثم ليصل على النبي ثم ليدع بعد بما شاء ) )(@)(@@) ( د ت حب ك هق ) عن فضالة بن عبيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1528 ) قال النبي :(@)(@@) | 30 ( إذا صلى أحدكم فليتم ركوعه ولا ينقر في سجوده ، فإنما مثل ذالك كمثل الجائع يأكل التمرة والتمرتين فماذا يغنيان عنه ) )(@)(@@) ( تمام وابن عساكر ) عن أبي عبد الله الأشعري رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1529 ) قال النبي :(@)(@@) | 30 ( إذا صلى أحدكم فليجعل تلقاء وجهه شيئا ، فإن لم يجد شيئا فلينصب عصا ، فإن لم يكن معه عصا فليخطط بين يديه خطا ثم لا يضره ما مر أمامه ) )(@)(@@) ( عب حم د ه حب ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1530 ) قال النبي :(@)(@@) | 30 ( إذا صلى أحدكم فليصل إلى سترة وليدن من سترته لا يقطع الشيطان عليه صلاته ) )(@)(@@) ( حم د ن حب ك ) عن سهل بن أبي حثمة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1531 ) قال النبي :(@)(@@) | 30 ( إذا صلى أحدكم فليصل إلى سترة وليدن منها ولا يدع أحدا 
ms164	 يمر بين يديه ، فإن جاء أحد يمر فليقاتله فإنه شيطان ) )(@)(@@) ( د ه حب هق ) عن أبي سعيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1532 ) قال النبي :(@)(@@) | 30 ( إذا صلى أحدكم فليصل صلاة مودع ، صلاة من لا PageV01P230 يظن أنه يرجع إليها أبدا ) )(@)(@@) ( فر ) عن أم سلمة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 1533 ) قال النبي :(@)(@@) | 30 ( إذا صلى أحدكم فليلبس ثوبيه فإن الله تعالى أحق من تزين له ) )(@)(@@) ( طس ) عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1534 ) قال النبي :(@)(@@) | 30 ( إذا صلى أحدكم فليلبس نعليه ، أو ليخلعهما بين رجليه ولا يؤذ بهما غيره ) )(@)(@@) ( ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1535 ) قال النبي :(@)(@@) | 30 ( إذا صلى أحدكم في بيته ثم دخل المسجد والقوم يصلون فليصل معهم تكون له نافلة ) )(@)(@@) ( طب ) عن عبد الله بن سرجس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1536 ) قال النبي :(@)(@@) | 30 ( إذا صلى أحدكم في ثوب واحد فليخالف بطرفيه على عاتقيه ) )(@)(@@) ( حم د حب ) عن أبي هريرة ( حم ) عن أبي سعيد رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1537 ) قال النبي :(@)(@@) | 30 ( إذا صلى أحدكم في ثوب واحد فليشده على حقويه ، ولا تشتملوا كاشتمال اليهود ) )(@)(@@) ( ك هق ) عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1538 ) قال النبي :(@)(@@) | 30 ( إذا صلى أحدكم في رحله ثم أدرك الإمام ولم يصل فليصل معه فإنها له نافلة ) )(@)(@@) ( د ك هق ) عن يزيد بن الأسود رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1539 ) قال النبي :(@)(@@) | 30 ( إذا صلى أحدكم بالناس فليخفف فإن فيهم الضعيف والسقيم والكبير ، وإذا صلى أحدكم لنفسه فليطول ما شاء ) )(@)(@@) ( مالك حم ق د ن ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1540 ) قال النبي :(@)(@@) | 30 ( إذا صلى الأمير جالسا فصلوا جلوسا ) )(@)(@@) ( ش ) عن PageV01P231 معاوية رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1541 ) قال النبي :(@)(@@) | 30 ( إذا صلت المرأة خمسها ، وصامت شهرها ، وحصنت فرجها ، وأطاعت زوجها ، قيل لها : أدخلي الجنة من أي أبواب الجنة شئت ) )(@)(@@) ( حب ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1542 ) قال النبي :(@)(@@) | 30 ( إذا صلت المرأة خمسها ، وصامت شهرها ، وحفظت فرجها ، وأطاعت 
ms165	 زوجها دخلت الجنة ) )(@)(@@) ( البزار ) عن أنس ( حم ) عن عبد الرحمن الزهري ( طب ) عن عبد الرحمن بن حسنة رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 1543 ) قال النبي :(@)(@@) | 30 ( إذا صلوا على جنازة فأثنوا خيرا يقول الرب أجزت شهادتهم فيما يعلمون وأغفر له ما لا يعلمون ) )(@)(@@) ( تخ ) عن الربيع بنت معوذ رضي الله عنها .(@)(@@)(@@)(@@) $ ( 1544 ) قال النبي :(@)(@@) | 30 ( إذا صليت الصبح فأمسك عن الصلاة حتى تطلع الشمس فإنها تطلع بين قرني الشيطان فإذا طلعت فصل فإن الصلاة محضورة متقبلة حتى تعتدل على رأسك مثل الرمح فأمسك ، فإن تلك الساعة التي تسجر فيها جهنم وتفتح فيها أبوابها حتى ترتفع الشمس على حاجبك الأيمن ، فإذا زالت عن حاجبك الأيمن فصل فإن الصلاة محضورة متقبلة حتى تصلي العصر ، ثم دع الصلاة حتى تغيب الشمس ) )(@)(@@) ( حم د ك ) عن صفوان بن المعطل رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1545 ) قال النبي :(@)(@@) | 30 ( إذا صليت الصبح فقل قبل أن تكلم أحدا من الناس : اللهم أجرني من النار سبع مرات فإنك إن مت من يومك ذالك كتب لك الله جوارا من النار ، وإذا صليت المغرب فقل قبل أن تكلم أحدا من الناس : اللهم PageV01P232 أجرني من النار سبع مرات فإنك إن مت من ليلتك كتب الله لك جوارا من النار ) )(@)(@@) ( حم د ن حب ) عن الحارث السلمي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1546 ) قال النبي :(@)(@@) | 30 ( إذا صليت فلا تبزقن بين يديك ولا عن يمينك ولاكن ابزق تلقاء شمالك إن كان فارغا وإلا فتحت قدمك اليسرى وادلكه ) )(@)(@@) ( حم ( 4 ) حب ك ) عن طارق بن عبد الله المحاربي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1547 ) قال النبي :(@)(@@) | 30 ( إذا صليت فلا تبسط ذراعيك بسط السبع وادعم على راحتيك وجاف مرفقيك عن ضبعيك ) )(@)(@@) ( طب ) عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1548 ) قال النبي :(@)(@@) | 30 ( صليتما في رحالكما ثم أتيتما الإمام فصليا معه فتكون لكما نافلة والتي في رحالكما فريضة ) )(@)(@@) ( فر ) عن ابن عمرو رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1549 ) قال النبي :(@)(@@) | 30 ( إذا صليتما في رحالكما ثم أتيتما مسجد جماعة فصليا معهم 
ms166	 فإنها لكما نافلة ) )(@)(@@) ( حم ت ن هق ) عن يزيد بن الأسود رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1550 ) قال النبي :(@)(@@) | 30 ( إذا صليتم الجمعة فصلوا بعدها أربعا ) )(@)(@@) ( د ه ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1551 ) قال النبي :(@)(@@) | 30 ( إذا صليتم الصبح فافزعوا إلى الدعاء وباكروا في طلب الحوائج ، اللهم بارك لأمتي في بكورها ) )(@)(@@) ( خط ) و ابن عساكر عن علي رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1552 ) قال النبي :(@)(@@) | 30 ( إذا صليتم الفجر فلا تناموا عن طلب أرزاقكم ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@) PageV01P233(@)(@@)(@@)(@@) $ ( 1553 ) قال النبي :(@)(@@) | 30 ( إذا صليتم خلف أئمتكم فأحسنوا ططوركم فإنما برتج على القارىء قراءته بسوء طهر المصلي خلفه ) )(@)(@@) ( فر ) عن حذيفة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1554 ) قال النبي :(@)(@@) | 30 ( إذا صليتم صلاة الفرض فقولوا في عقب كل صلاة عشر مرات لا إلاه إلا الله وحده لا شريك له ، له الملك وله الحمد وهو على كل شيء قدير ، يكتب له من الأجر كأنما أعتق رقبة ) )(@)(@@) ( الرافعي في تاريخه ) عن البراء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1555 ) قال النبي :(@)(@@) | 30 ( إذا صليتم على الجنازة فاقرؤوا بفاتحة الكتاب ) )(@)(@@) ( طب ) عن أسماء بنت يزيد رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 1556 ) قال النبي :(@)(@@) | 30 ( إذا صليتم على الميت فأخلصوا له الدعاء ) )(@)(@@) ( د ه حب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1557 ) قال النبي :(@)(@@) | 30 ( أذا صليتم علي فقولوا : اللهم صل على محمد النبي الأمي وعلى آل محمد كما صليت على إبراهيم وعلى آل إبراهيم ، وبارك على محمد النبي الأمي وعلى آل محمد كما باركت على إبراهيم وعلى آل إبراهيم إنك حميد مجيد ) )(@)(@@) ( حم حب قط هق ) عن أبي مسعود رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1558 ) قال النبي :(@)(@@) | 30 ( إذا صليتم فأتزروا وارتدوا ولا تشبهوا باليهود ) )(@)(@@) ( عد ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 1559 ) قال النبي :(@)(@@) | 30 ( إذا صليتم فارفعوا سبلكم فإن كل شيء أصاب الأرض من سبلكم فهو في النار ) )(@)(@@) ( تخ طب هب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 1560 ) قال النبي :(@)(@@) | 30 ( إذا صليتم فأقيموا صفوفكم 
ms167	 ثم ليؤمكم أحدكم فإذا كبر فكبروا وإذا قرأ فأنصتوا ، وإذا قال غير المغضوب عليهم ولا الضالين فقولوا آمين PageV01P234 يحبكم الله فإذا كبر وركع فكبروا واركعوا فإن الإمام يركع قبلكم ويرفع قبلكم فتلك بتلك ، وإذا قال سمع الله لمن حمده فقولوا : اللهم ربنا لك الحمد يسمع الله لكم ، وإذا كبر وسجد فكبروا واسجدوا فإن الإمام يسجد قبلكم ويرفع قبلكم فتلك بتلك ، وإذا كان عند القعدة فليكن من أول قول أحدكم التحيات الطيبات الصلوات لله السلام عليك أيها النبي ورحمة الله وبركاته ، السلام علينا وعلى عباد الله الصالحين ، أشهد أن لا إلاه إلا الله وأشهد أن محمدا عبده ورسوله ) )(@)(@@) ( حم م د ن ه ) عن أبي موسى ا رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1561 ) قال النبي :(@)(@@) | 30 ( إذا صليتم فقولوا : سبحان الله ثلاثا وثلاثين مرة ، والحمد لله ثلاثا وثلاثين مرة ، والله أكبر أربعا وثلاثين مرة ، ولا إلاه إلا الله عشر مرات فإنكم تدركون به من سبقكم ولا يسبقكم من بعدكم ) )(@)(@@) ( ت ن ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1562 ) قال النبي :(@)(@@) | 30 ( إذا صمتم فاستاكوا بالغداة ولا تستاكوا بالعشي فإنه ليس من صائم تيبس شفتاه بالعشي إلا كان نورا بين عينيه يوم القيامة ) )(@)(@@) ( طب قط ) عن خباب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1563 ) قال النبي :(@)(@@) | 30 ( إذا صمت من الشهر ثلاثا فصم ثلاث عشرة وأربع عشرة وخمس عشرة ) )(@)(@@) ( حم ت ن حب ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1564 ) قال النبي :(@)(@@) | 30 ( إذا ضاع للرجل أو سرق له متاع فوجده في يد رجل يبيعه فهو أحق به ويرجع المشتري على البائع بالثمن ) )(@)(@@) ( ه هق ) عن سمرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1565 ) قال النبي :(@)(@@) | 30 ( إذا ضحى أحدكم فليأكل من أضحيته ) )(@)(@@) ( حم ) عن أبي هريرة رضي الله عنه .(@)(@@) PageV01P235(@)(@@)(@@)(@@) $ ( 1566 ) قال النبي :(@)(@@) | 30 ( إذا ضرب أحدكم خادمه فذكر الله فارفعوا أيديكم ) )(@)(@@) ( ت ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ 1567 قال النبي :(@)(@@) | 30 ( إذا ضرب أحدكم خادمه فليتق الوجه ) )(@)(@@) ( د ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1568 
ms168	 ) قال النبي :(@)(@@) | 30 ( إذا ضن الناس بالدينار والدرهم وتبايعوا بالعينة وتبعوا أذناب البقر وتركوا الجهاد في سبيل الله أدخل الله تعالى عليهم ذلا لا يرفعه عنهم حتى يراجعوا دينهم ) )(@)(@@) ( حم طب هب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 1569 ) قال النبي :(@)(@@) | 30 ( إذا طبخ أحدكم قدرا فليكثر مرقها ثم ليناول جاره منها ) )(@)(@@) ( طس ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1570 ) قال النبي :(@)(@@) | 30 ( إذا طبختم اللحم فأكثروا المرقة فإنه أوسع وأبلغ للجيران ) )(@)(@@) ( ش ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1571 ) قال النبي :(@)(@@) | 30 ( إذا طلب أحدكم من أخيه حاجة فلا يبدأه بالمدحة فيقطع ظهره ) )(@)(@@) ( ابن لال في مكارم الأخلاق ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1572 ) قال النبي :(@)(@@) | 30 ( إذا طلع الفجر فقد ذهب كل صلاة الليل والوتر فأوتروا قبل طلوع الفجر ) )(@)(@@) ( ت ) عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1573 ) قال النبي :(@)(@@) | 30 ( إذا طلع الفجر فلا صلاة إلا ركعتي الفجر ) )(@)(@@) ( طس ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1574 ) قال النبي :(@)(@@) | 30 ( إذا طلعت الثريا أمن الزرع من العاهة ) )(@)(@@) ( طص ) عن أبي هريرة رضي الله عنه .(@)(@@) PageV01P236(@)(@@)(@@)(@@) $ ( 1575 ) قال النبي :(@)(@@) | 30 ( إذا طنت أذن أحدكم فليذكرني وليصل علي وليقل ذكر الله من ذكرني بخير ) )(@)(@@) ( الحكيم وابن السنى عق طب عد ) عن أبي رافع رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1576 ) قال النبي :(@)(@@) | 30 ( إذا ظلم أهل الذمة كانت الدولة دولة العدو ، وإذا كثر الزنا كثر السباء ، وإذا كثر اللوطية رفع الله تعالى يده عن الخلق ولا يبالي في أي واد هلكوا ) )(@)(@@) ( طب ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1577 ) قال النبي :(@)(@@) | 30 ( إذا ظننتم فلا تحققوا ، وإذا حسدتم فلا تبغوا ، وإذا تطيرتم فامضوا وعلى الله فتوكلوا ، وإذا وزنتم فأرجحوا ) )(@)(@@) ( ه ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1578 ) قال النبي :(@)(@@) | 30 ( إذا ظهر الزنا والربا في قرية فقد أحلوا بأنفسهم عذاب الله ) )(@)(@@) ( طب ك ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 1579 ) قال النبي :(@)(@@) | 30 ( إذا ظهر السوء في الأرض أنزل الله بأسه بأهل الأرض ، وإن كان فيهم 
ms169	 قوم صالحون يصيبهم ما أصاب الناس ثم يرجعون إلى رحمة الله ومغفرته ) )(@)(@@) ( طب حب ) عن أم سلمة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 1580 ) قال النبي :(@)(@@) | 30 ( إذا ظهرت البدع ولعن آخر هاذه الأمة أولها ، فمن كان عنده علم فلينشره ، فإن كاتم العلم يومئذ ككاتم ما أنزل الله على محمد ) )(@)(@@) ( ابن عساكر ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1581 ) قال النبي :(@)(@@) | 30 ( إذا ظهرت الحية في المسكن فقولوا لها : إنا نسألك بعهد نوح وبعهد سليمان بن داود أن لا تؤذينا فإن عادت فاقتلوها ) )(@)(@@) ( ت ) عن ابن أبي ليلى ا .(@)(@@)(@@)(@@) $ ( 1582 ) قال النبي :(@)(@@) | 30 ( إذا ظهرت الفاحشة كانت الرجفة ، وإذا جار الحكام قل المطر ، وإذا غدر بأهل الذمة ظهر العدو ) )(@)(@@) ( فر ) عن ابن عمر رضي الله عنهما .(@)(@@) PageV01P237(@)(@@)(@@)(@@) $ ( 1583 ) قال النبي :(@)(@@) | 30 ( إذا عاد أحدكم مريضا فلا يأكل عنده شيئا ، فإنه حظه من عيادته ) )(@)(@@) ( فر ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1584 ) قال النبي :(@)(@@) | 30 ( إذا عاد أحدكم مريضا فليقل : اللهم اشف عبدك ينكا لك عدوا أو يمشي لك إلى صلاة ) )(@)(@@) ( ك ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 1585 ) قال النبي :(@)(@@) | 30 ( إذا عاد الرجل أخاه المسلم مشى في خرافة الجنة حتى يجلس ، فإذا جلس غمرته الرحمة فإن كان غدوة صلى عليه سبعون ألف ملك حتى يمسي ، وإن كان عشيا صلى عليه سبعون ألف ملك حتى يصبح ) )(@)(@@) ( حم ع هق ) عن علي رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1586 ) قال النبي :(@)(@@) | 30 ( إذا عاهة من السماء أنزلت صرفت عن عمار المساجد ) )(@)(@@) ( هب ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1587 ) قال النبي :(@)(@@) | 30 ( إذا عرف الغلام يمينه من شماله فمروه بالصلاة ) )(@)(@@) ( د هق ) عن رجل من الصحابة .(@)(@@)(@@)(@@) $ ( 1588 ) قال النبي :(@)(@@) | 30 ( إذا عطس أحدكم فحمد الله فشمتوه ، وإذا لم يحمد الله فلا تشمتوه ) )(@)(@@) ( حم خد م ) عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1589 ) قال النبي :(@)(@@) | 30 ( إذا عطس أحدكم فقال : الحمد لله رب قالت الملائكة : رب العالمين ، فإذا قال رب العالمين ، قالت الملائكة : رحمك الله ) )(@)(@@) ( طب ) عن 
ms170	 ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 1590 ) قال النبي :(@)(@@) | 30 ( إذا عطس أحدكم فليشمته جليسه ، فإن زاد على ثلاث فهو مزكوم ولا يشمت بعد ثلاث ) )(@)(@@) ( د ) عن أبي هريرة رضي الله عنه .(@)(@@) PageV01P238(@)(@@)(@@)(@@) $ ( 1591 ) قال النبي :(@)(@@) | 30 ( إذا عطس أحدكم فليضع كفيه على وجهه وليخفض صوته ) )(@)(@@) ( ك هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1592 ) قال النبي :(@)(@@) | 30 ( إذا عطس أحدكم فليقل : الحمد لله رب العالمين وليقل له يرحمك الله ، وليقل هو يغفر الله لنا ولكم ) )(@)(@@) ( طب ك هب ) عن ابن مسعود ( حم ( 3 ) ك هب ) عن سالم بن عبيد الأشجعي رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 1593 ) قال النبي :(@)(@@) | 30 ( إذا عطس أحدكم فليقل الحمد لله على كل حال ، وليقل له من حوله : يرحمك الله ، وليقل هو لمن حوله يهديكم الله ويصلح بالكم ) )(@)(@@) ( حم ت ن ك ) عن أبي أيوب ( ه ك هب ) عن علي رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1594 ) قال النبي :(@)(@@) | 30 ( إذا عطس أحدكم فليقل الحمد لله ، فإذا قال فليقل له أخوه أو صاحبه يرحمك الله ، فإذا قال له يرحمك الله فليقل : يهديكم الله ويصلح بالكم ) )(@)(@@) ( حم خ ه ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1595 ) قال النبي :(@)(@@) | 30 ( إذا عطس الرجل والإمام يخطب يوم الجمعة فشمته ) )(@)(@@) ( ق ) عن الحسن مرسلا ( ز ) .(@)(@@)(@@)(@@) $ ( 1596 ) قال النبي :(@)(@@) | 30 ( إذا عظمت أمتي الدنيا نزعت منها هيبة الإسلام ، وإذا تركت الأمر بالمعروف والنهي عن المنكر حرمت بركة الوحي ، وإذا تسابت أمتي سقطت من عين الله ) )(@)(@@) ( الحكيم ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1597 ) قال النبي :(@)(@@) | 30 ( إذا علم العالم فلم يعمل كان كالمصباح يضيء للناس ويحرق نفسه ) )(@)(@@) ( ابن قانع في معجمه ) عن سليك الغطفاني رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1598 ) قال النبي :(@)(@@) | 30 ( إذا عمل أحدكم عملا فليتقنه فإنه مما يسلي بنفس PageV01P239 المصاب ) )(@)(@@) ( ابن سعد ) عن عطاء مرسلا .(@)(@@)(@@)(@@) $ ( 1599 ) قال النبي :(@)(@@) | 30 ( إذا عملت الخطيئة في الأرض كان من شهدها فكرهها كمن غاب عنها ، ومن غاب عنها فرضيها كان كمن شهدها ) )(@)(@@) ( د ) عن العرس بن عميرة رضي 
ms171	 الله عنه .(@)(@@)(@@)(@@) $ ( 1600 ) قال النبي :(@)(@@) | 30 ( إذا عملت سيئة فأتبعها حسنة تمحها ) )(@)(@@) ( حم ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1601 ) قال النبي :(@)(@@) | 30 ( إذا عملت سيئة فأحدث عنها توبة ، السر بالسر والعلانية بالعلانية ) )(@)(@@) ( حم ) في الزهد عن عطاء مرسلا .(@)(@@)(@@)(@@) $ ( 1602 ) قال النبي :(@)(@@) | 30 ( إذا عملت عشر سيئات فاعمل حسنة تحدرهن بها ) )(@)(@@) ( ابن عساكر ) عن عمرو بن الأسود مرسلا .(@)(@@)(@@)(@@) $ ( 1603 ) قال النبي :(@)(@@) | 30 ( إذا عملت مرقة فأكثر ماءها واغرف لجيرانك منها ) )(@)(@@) ( ه ) عن أبي ذر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1604 ) قال النبي :(@)(@@) | 30 ( إذا غربت الشمس فكفوا صبيانكم فإنها ساعة ينشر فيها الشياطين ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 1605 ) قال النبي :(@)(@@) | 30 ( إذا غضب أحدكم فليسكت ) )(@)(@@) ( حم ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 1606 ) قال النبي :(@)(@@) | 30 ( إذا غضب أحدكم وهو قائم فليجلس فإن ذهب عنه الغضب وإلا فليضطجع ) )(@)(@@) ( حم د حب ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1607 ) قال النبي :(@)(@@) | 30 ( إذا غضب الرجل فقال : أعوذ بالله سكن غضبه ) ) PageV01P240(@)(@@) ( عد ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1608 ) قال النبي :(@)(@@) | 30 ( إذا غضبت فاجلس ) )(@)(@@) ( الخرائطي في مساوىء الأخلاق ) عن عمران بن حصين رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1609 ) قال النبي :(@)(@@) | 30 ( إذا فاءت الأفياء وهبت الأرياح فإذكروا حوائجكم فإنها ساعة الأوابين ) )(@)(@@) ( عب ) عن أبي سفيان مرسلا ( حل ) عن ابن أبي أوفى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1610 ) قال النبي :(@)(@@) | 30 ( إذا فتحت عليكم فارس والروم أي قوم أنتم ؟ قيل : نكون كما أمر الله ، قال أو غير ذالك تتنافسون ثم تتحاسدون ثم تتدابرون ثم تتباغضون ثم تنطلقون في مساكن المهاجرين فتجعلون بعضهم على رقاب بعض ) )(@)(@@) ( م ه ) عن ابن عمرو رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1611 ) قال النبي :(@)(@@) | 30 ( إذا فتحت مصر فاستوصوا بالقبط خيرا فإن لهم ذمة ورحما ) )(@)(@@) ( طب ك ) عن كعب بن مالك رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1612 ) قال النبي :(@)(@@) | 30 ( إذا فتح على العبد الدعاء فليدع ربه فإن الله يستجيب له ) )(@)(@@) ( ت ) عن ابن عمر ( الحكيم ) عن أنس رضي الله عنهم 
ms172	 .(@)(@@)(@@)(@@) $ ( 1613 ) قال النبي :(@)(@@) | 30 ( إذا فتح لأحدكم رزق من باب فليلزمه ) )(@)(@@) ( هب ) عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 1614 ) قال النبي :(@)(@@) | 30 ( إذا فرغ أحدكم من التشهد الأخير فليتعوذ بالله من أربع يقول : اللهم إني أعوذ بك من عذاب جهنم ، ومن عذاب القبر ، ومن فتنة المحيا والممات ، ومن شر فتنة المسيح الدجال ) )(@)(@@) ( حم م د ه ) عن أبي هريرة PageV01P241 رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1615 ) قال النبي :(@)(@@) | 30 ( إذا فرغ أحدكم من صلاته فليدع بأربع ثم ليدع بعد بما شاء ، اللهم إني أعوذ بك من عذاب جهنم ، وعذاب القبر ، وفتنة المحيا والممات وفتنة المسيح الدجال ) )(@)(@@) ( هق ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1616 ) قال النبي :(@)(@@) | 30 ( إذا فرغ أحدكم من طهوره فليقل : أشهد أن لا إلاه إلا الله وأن محمدا عبده ورسوله ، ثم ليصل علي فإذا قال ذالك فتحت له أبواب الرحمة ) )(@)(@@) ( أبو الشيخ في الثواب ) عن ابن مسعود رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1617 ) قال النبي :(@)(@@) | 30 ( إذا فرغ الرجل من صلاته فقال : رضيت بالله ربا وبالإسلام دينا وبالقرآن إماما كان حقا على الله عز وجل أن يرضيه ) )(@)(@@) ( السجزي في الإبانة ) عن الزبير رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1618 ) قال النبي :(@)(@@) | 30 ( إذا فزع أحدكم في النوم فليقل أعوذ بكلمات الله التامة من غضبه وعقابه وشر عباده ومن همزات الشياطين وأن يحضرون فإنها لن تضره ) )(@)(@@) ( ت ) عن ابن عمرو رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1619 ) قال النبي :(@)(@@) | 30 ( إذا فسا أحدكم في الصلاة فلينصرف وليعد الصلاة ، ولا تأتوا النساء في أعجازهن فإن الله لا يستحيي من الحق ) )(@)(@@) ( حم ( 3 ) حب ) عن علي بن طلق رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1620 ) قال النبي :(@)(@@) | 30 ( إذا فسد أهل الشام فلا خير فيكم ، ولا تزال طائفة من أمتي منصورين لا يضرهم من خذلهم حتى تقوم الساعة ) )(@)(@@) ( حم ت حب ) عن قرة بن أياس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1621 ) قال النبي :(@)(@@) | 30 ( إذا فعلت أمتي خمس عشرة خصلة حل بها البلاء : إذا كان المغنم دولا ، والأمانة مغنما 
ms173	 ، والزكاة مغرما ، وأطاع الرجل زوجته وعق أمه ، وبر صديقه وجفا أباه ، وارتفعت الأصوات في المساجد ، وكان زعيم القوم PageV01P242 أرذلهم ، وأكرم الرجل مخافة شره ، وشربت الخمور ، ولبس الحرير ، واتخذت القينات والمعازف ولعن آخر هاذه الأمة أولها فليرتقبوا عند ذالك ريحا حمراء أو خسفا أو مسخا ) )(@)(@@) ( ت ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1622 ) قال النبي :(@)(@@) | 30 ( إذا قاتل أحدكم فليتق الوجه ) )(@)(@@) ( حم ) عن أبي سعيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1623 ) قال النبي :(@)(@@) | 30 ( إذا قال أحدكم في الصلاة آمين ، وقالت الملائكة في السماء آمين فوافقت إحداهما الأخرى غفر له ما تقدم من ذنبه ) )(@)(@@) ( مالك ق ن ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1624 ) قال النبي :(@)(@@) | 30 ( إذا قال الإمام سمع الله لمن حمده فقولوا : اللهم ربنا لك الحمد ، فإنه من وافق قوله قول الملائكة غفر له ما تقدم من ذنبه ) )(@)(@@) ( مالك ق 3 ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1625 ) قال النبي :(@)(@@) | 30 ( إذا قال الإمام سمع الله لمن حمده فقولوا : اللهم ربنا ولك الحمد ) )(@)(@@) ( ه ك ) عن أبي سعيد ( ه حب ) عن أنس ( حب ) عن أبي هريرة رضي الله عنهم ( ز ) .(@)(@@)(@@)(@@) $ ( 1626 ) قال النبي :(@)(@@) | 30 ( إذا قال الإمام غير المغضوب عليهم ولا الضالين فقولوا : آمين ، فإنه من وافق قوله قول الملائكة غفر له ما تقدم من ذنبه ) )(@)(@@) ( مالك خ د ن ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1627 ) قال النبي :(@)(@@) | 30 ( إذا قال الرجل إذا أذن المؤذن اللهم رب هاذه الدعوة التامة ، والصلاة القائمة أعط محمدا سؤله نالته شفاعة محمد ) )(@)(@@) ( أبو الشيخ في فوائد الأصبهانيين ) عن أنس رضي الله عنه ( ز ) .(@)(@@) PageV01P243(@)(@@)(@@)(@@) $ ( 1628 ) قال النبي :(@)(@@) | 30 ( إذا قال الرجل لأخيه جزاك الله خيرا فقد أبلغ في الثناء ) )(@)(@@) ( ابن منيع خط ) عن أبي هريرة ( خط ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 1629 ) قال النبي :(@)(@@) | 30 ( إذا قال الرجل لأخيه يا كافر فقد باء بها أحدهما ) )(@)(@@) ( خ ) عن أبي هريرة ( حم خ ) عن ابن عمر رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 1630 ) قال النبي 
ms174	 :(@)(@@) | 30 ( إذا قال الرجل لأخيه يا كافر فهو كقتله ، ولعن المؤمن كقتله ) )(@)(@@) ( طب ) عن عمران بن حصين رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1631 ) قال النبي :(@)(@@) | 30 ( إذا قال الرجل للرجل يا يهودي فاضربوه عشرين وإذا قال : يا مخنث فاضربوه عشرين ، ومن وقع على ذات محرم فاقتلوه ) )(@)(@@) ( ت ه هق ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1632 ) قال النبي :(@)(@@) | 30 ( إذا قال الرجل للمنافق يا سيدي فقد أغضب ربه ) )(@)(@@) ( ك هب ) عن بريدة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1633 ) قال النبي :(@)(@@) | 30 ( إذا قال الرجل هلك الناس فهو أهلكهم ) )(@)(@@) ( حم م د ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1634 ) قال النبي :(@)(@@) | 30 ( إذا قال العبد لا إلاه إلا الله والله أكبر قال الله : صدق عبدي لا إلاه إلا أنا وأنا أكبر ، فإذا قال لا إلاه إلا الله ووحده قال : صدق عبدي لا إلاه إلا أنا وحدي ، فإذا قال لا إلاه إلا الله لا شريك له قال : صدق عبدي لا إلاه إلا أنا ولا شريك لي ، فإذا قال لا إلاه إلا الله له الملك وله الحمد قال : صدق عبدي لا إلاه إلا أنا لي الملك ولي الحمد ، فإذا قال لا إلاه إلا الله ولا حول ولا قوة إلا بالله قال : صدق عبدي لا إلاه إلا أنا ولا حول ولا قوة إلا بي ، من رزقهن عند موته لم تمسه النار ) )(@)(@@) ( ت ن ه حب ك ) عن أبي هريرة وأبي سعيد رضي الله عنه ( ز ) .(@)(@@) PageV01P244(@)(@@)(@@)(@@) $ ( 1635 ) قال النبي :(@)(@@) | 30 ( إذا قال العبد يا رب يا رب ، قال الله : لبيك عبدي سل تعط ) )(@)(@@) ( ابن أبي الدنيا ) في الدعاء عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 1636 ) قال النبي :(@)(@@) | 30 ( إذا قال المؤذن الله أكبر الله أكبر فقال أحدكم : الله أكبر الله أكبر ، ثم قال : أشهد أن لا إلاه إلا الله ، قال أشهد أن لا إلاه إلا الله ، ثم قال : أشهد أن محمدا رسول الله قال : أشهد أن محمدا رسول الله ، ثم قال : حي على الصلاة قال : لا حول 
ms175	 ولا قوة إلا بالله ، ثم قال : حي على الفلاح قال : لا حول ولا قوة إلا بالله ، ثم قال : الله أكبر الله أكبر قال : الله أكبر الله أكبر ، ثم قال : لا إلاه إلا الله قال : لا إلاه إلا الله من قلبه دخل الجنة ) )(@)(@@) ( م د ) عن عمر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1637 ) قال النبي :(@)(@@) | 30 ( إذا قالت المرأة لزوجها ما رأيت منك خيرا قط فقد حبط عملها ) )(@)(@@) ( عد ) و ابن عساكر عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 1638 ) قال النبي :(@)(@@) | 30 ( إذا قام أحدكم إلى الصلاة فإن الرحمة تواجهه فلا يمسح الحصى ) )(@)(@@) ( حم ( 4 ) حب ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1639 ) قال النبي :(@)(@@) | 30 ( إذا قام أحدكم إلى الصلاة فلا يبزق أمامه ، فإنما يناجي الله تبارك وتعالى ما دام في مصلاه ، ولا عن يمينه فإن عن يمينه ملكا ، وليبصق عن يساره أو تحت قدمه فيدفنها ) )(@)(@@) ( حم خ ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1640 ) قال النبي :(@)(@@) | 30 ( إذا قام أحدكم إلى الصلاة فليسكن أطرافه ولا يتميل كما تتميل اليهود فإن تسكين الأطراف في الصلاة من تمام الصلاة ) )(@)(@@) ( الحكيم عد حل ) عن أبي بكر رضي الله عنه .(@)(@@) PageV01P245(@)(@@)(@@)(@@) $ ( 1641 ) قال النبي :(@)(@@) | 30 ( إذا قام أحدكم إلى الصلاة فليسو موضع سجوده ولا يدعه حتى إذا أهوى ليسجد نفخ ثم سجد فيسجد أحدكم على جمرة خير له من أن يسجد على نفخته ) )(@)(@@) ( طس ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1642 ) قال النبي :(@)(@@) | 30 ( إذا قام أحدكم إلى الصلاة فليقبل عليها حتى يفرغ منها ، وإياكم والالتفات في الصلاة فإن أحدكم يناجي ربه ما دام في الصلاة ) )(@)(@@) ( طس ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1643 ) قال النبي :(@)(@@) | 30 ( إذا قام أحدكم عن فراشه ثم رجع إليه فلينفضه بصنفة إزاره ثلاث مرات فإنه لا يدري ما خلفه عليه بعده ، وإذا اضطجع فليقل باسمك ربي وضعت جنبي وبك أرفعه فإن أمسكت نفسي فارحمها ، وإن أرسلتها فاحفظها بما تحفظ به عبادك الصالحين ، فإذا استيقظ فليقل الحمد لله 
ms176	 الذي عافاني في جسدي ، ورد علي روحي وأذن لي بذكره ) )(@)(@@) ( ت ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1644 ) قال النبي :(@)(@@) | 30 ( إذا قام أحدكم في الصلاة فلا يغمض عينيه ) )(@)(@@) ( طب عد ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 1645 ) قال النبي :(@)(@@) | 30 ( إذا قام أحدكم من منامه فليقل الحمد لله الذي رد فينا أرواحنا بعد إذ كنا أمواتا ) )(@)(@@) ( طب ) عن أبي جحيفة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1646 ) قال النبي :(@)(@@) | 30 ( إذا قام أحدكم من الليل فاستعجم القرآن على لسانه فلم يدر ما يقول فليضطجع ) )(@)(@@) ( حم م د ه ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1647 ) قال النبي :(@)(@@) | 30 ( إذا قام أحدكم من الليل فليصل ركعتين خفيفتين ، ثم ليطول بعد ما شاء ) )(@)(@@) ( د ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@) PageV01P246(@)(@@)(@@)(@@) $ ( 1648 ) قال النبي :(@)(@@) | 30 ( إذا قام أحدكم من الليل فليفتح صلاته بركعتين خفيفتين ) )(@)(@@) ( حم م ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1649 ) قال النبي :(@)(@@) | 30 ( إذا قام أحدكم من النوم فأراد أن يتوضأ فلا يدخل يده في الإناء حتى يغسلها فإنه لا يدري أين باتت يده ولا على ما وضعها ) )(@)(@@) ( ه قط ) و ( الضياء ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1650 ) قال النبي :(@)(@@) | 30 ( إذا قام أحدكم من منامه فليقل : الحمد لله الذي رد فينا أرواحنا بعد إذ كنا أمواتا ) )(@)(@@) ( طب ) عن أبي جحيفة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1651 ) قال النبي :(@)(@@) | 30 ( إذا قام أحدكم يصلي فإنه يستره إذا كان بين يديه مثل آخرة الرحل ، فإذا لم يكن بين يديه مثل آخرة الرحل فإنه يقطع صلاته الحمار والمرأة والكلب الأسود قيل : ما بال الكلب الأسود من الكلب الأحمر ، قال : الكلب الأسود شيطان ) )(@)(@@) ( م ن ) عن أبي ذر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1652 ) قال النبي :(@)(@@) | 30 ( إذا قام أحدكم يصلي من الليل فليستك ، فإن أحدكم إذا قرأ في صلاته وضع ملك فاه على فيه ولا يخرج من فيه شيء إلا دخل فم الملك ) )(@)(@@) ( هب ) و تمام الضياء عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1653 ) قال 
ms177	 النبي :(@)(@@) | 30 ( إذا قام الإمام في الركعتين فإن ذكر قبل أن يستوي قائما فليجلس ، فإن استوى قائما فلا يجلس ويسجد سجدتي السهو ) )(@)(@@) ( حم د ه هق ) عن المغيرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1654 ) قال النبي :(@)(@@) | 30 ( إذا قام الرجل في صلاته ، أقبل الله عليه بوجهه فإذا التفت قال : ابن آدم إلى من تلتفت إلى من هو خير لك مني أقبل إلي ، فإذا التفت الثانية قال مثل ذالك ، فإذا التفت الثالثة صرف الله وجهه عنه ) )(@)(@@) ( البزار ) عن جابر رضي الله عنه ( ز ) .(@)(@@) PageV01P247(@)(@@)(@@)(@@) $ ( 1655 ) قال النبي :(@)(@@) | 30 ( إذا قام الرجل من مجلسه ثم رجع إليه فهو أحق به ) )(@)(@@) ( حم خد م د ه ) عن أبي هريرة ( حم ) عن وهب بن حذيفة رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 1656 ) قال النبي :(@)(@@) | 30 ( إذا قام الرجل يتوضا ليلا أو ونهارا فأحسن الوضوء واستن ثم قام فصلى أطاف به الملك ودنا منه حتى يضع فاه على فيه فما يقرأ إلا في فيه ، وإذا لم يستن أطاف به ولا يضع فاه على فيه ) )(@)(@@) ( محمد بن نصر ) في الصلاة عن ابن شهاب مرسلا ( ز ) .(@)(@@)(@@)(@@) $ ( 1657 ) قال النبي :(@)(@@) | 30 ( إذا قام العبد في صلاته ذر البر على رأسه حتى يركع ، فإذا ركع علته رحمة الله حتى يسجد ، والساجد يسجد على قدمي الله تعالى فليسأل وليرغب ) )(@)(@@) ( ص ) عن أبي عمار مرسلا .(@)(@@)(@@)(@@) $ ( 1658 ) قال النبي :(@)(@@) | 30 ( إذا قام صاحب القرآن فقرأ بالليل والنهار ذكره ، وإن لم يقم به نسيه ) )(@)(@@) ( محمد بن نصر في الصلاة ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 1659 ) قال النبي :(@)(@@) | 30 ( إذا قام لك رجل من مجلسه فلا تجلس فيه ولا تمسح يدك بثوب من لا تملك ) )(@)(@@) ( الطيالسي هق ) عن أبي بكرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1660 ) قال النبي :(@)(@@) | 30 ( إذا قبر الميت أتاه ملكان أسودان أزرقان يقال لأحدهما المنكر وللآخر النكير فيقولان ما كنت تقول في هاذا الرجل فيقول ما كان يقول هو عبد الله ورسوله أشهد أن لا إلاه إلا الله وأن محمدا عبده ورسوله ، فيقولان قد كنا 
ms178	 نعلم أنك تقول ثم يفسح له في قبره سبعون ذراعا في سبعين ، ثم ينور له فيه ، ثم يقال نم فيقول أرجع إلى أهلي فاخبرهم فيقولان : نم كنومة العروس الذي لا يوقظه إلا أحب أهله إليه حتى يبعثه الله من مضجعه ذالك وإن كان منافقا قال : سمعت الناس يقولون قولا فقلت مثله لا أدري فيقولان قد كنا نعلم أنك تقول ذالك فيقال للأرض التئمي عليه فتلتئم عليه فتختلف أضلاعه فلا يزال فيها معذبا PageV01P248 حتى يبعثه الله من مضجعه ذالك ) )(@)(@@) ( ت ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1661 ) قال النبي :(@)(@@) | 30 ( إذا قدم أحدكم على أهله من سفر فليهد لأهله فليطرفهم ولو كان حجارة ) )(@)(@@) ( هب ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 1662 ) قال النبي :(@)(@@) | 30 ( إذا قدم أحدكم ليلا فلا يأتين أهله طروقا حتى تستحد المغيبة وتمتشط الشعثة ) )(@)(@@) ( م ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1663 ) قال النبي :(@)(@@) | 30 ( إذا قدم أحدكم من سفر فلا يدخل ليلا وليضع في خرجه ولو حجرا ) )(@)(@@) ( فر ) عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1664 ) قال النبي :(@)(@@) | 30 ( إذا قدم أحدكم من سفر فليقدم معه بهدية ولو يلفي في مخلاته حجرا ) )(@)(@@) ( ابن عساكر ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1665 ) قال النبي :(@)(@@) | 30 ( إذا قدم العشاء وحضرت الصلاة فابدؤوا به قبل أن تصلوا صلاة المغرب ولا تعجلوا عن عشائكم ) )(@)(@@) ( ق ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1666 ) قال النبي :(@)(@@) | 30 ( إذا قرأ ابن آدم السجدة فسجد اعتزل الشيطان يبكي يقول يا ويله أمر ابن آدم بالسجود فسجد فله الجنة ، وأمرت بالسجود فعصيت فلي النار ) )(@)(@@) ( حم م ه ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1667 ) قال النبي :(@)(@@) | 30 ( إذا قرأ الإمام فأنصتوا ) )(@)(@@) ( م ) عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1668 ) قال النبي :(@)(@@) | 30 ( إذا قرأ الرجل القرآن واحتشى من أحاديث رسول الله وكان هناك غريزة كان خليفة من خلفاء الأنبياء ) )(@)(@@) ( الرافعي في تاريخه ) PageV01P249 عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1669 ) قال النبي :(@)(@@) | 30 ( إذا قرأ الرجل 
ms179	 القرآن وتفقه في الدين ، ثم أتى باب السلطان تملقا إليه وطمعا لما في يده خاض بقدر خطاه في نار جهنم ) )(@)(@@) ( أبو الشيخ فر ) عن معاذ رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1670 ) قال النبي :(@)(@@) | 30 ( إذا قرأ القارىء فأخطأ أو لحن أو كان أعجميا كتبه الملك كما أنزل ) )(@)(@@) ( فر ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 1671 ) قال النبي :(@)(@@) | 30 ( إذا قرأتم الحمد لله فاقرؤوا بسم الله الرحمان الرحيم إنها أم القرآن وأم الكتاب والسبع المثاني وبسم الله الرحمان الرحيم إحدى آياتها ) )(@)(@@) ( قط هق ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1672 ) قال النبي :(@)(@@) | 30 ( إذا قرب إلى أحدكم طعام وهو صائم فليقل بسم الله والحمد لله ، اللهم لك صمت وعلى رزقك أفطرت ، وعليك توكلت ، سبحانك وبحمدك تقبل مني إنك أنت السميع العليم ) )(@)(@@) ( قط ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1673 ) قال النبي :(@)(@@) | 30 ( إذا قرب لأحدكم طعامه وفي رجليه نعلان فلينزع نعليه فإنه أروح للقدمين وهو من السنة ) )(@)(@@) ( ع ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1674 ) قال النبي :(@)(@@) | 30 ( إذا قسمت الأرض وحدت فلا شفعة فيها ) )(@)(@@) ( د ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1675 ) قال النبي :(@)(@@) | 30 ( إذا قسم لأحدكم رزق فلا يدعه حتى يتغير له ) )(@)(@@) ( هب ) عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 1676 ) قال النبي :(@)(@@) | 30 ( إذا قصر العبد في العمل ابتلاه الله تعالى بالهم ) )(@)(@@) ( حم ) في الزهد عن الحكم مرسلا .(@)(@@)(@@)(@@) $ ( 1677 ) قال النبي :(@)(@@) | 30 ( إذا قضى أحدكم في الصلاة في مسجده فليجعل لبيته PageV01P250 نصيبا من صلاته فإن الله تعالى جاعل في بيته من صلاته خيرا ) )(@)(@@) ( حم م ه ) عن جابر ( قط ) في الأفراد عن أنس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 1678 ) قال النبي :(@)(@@) | 30 ( إذا قضى أحدكم حجه فليعجل الرجوع إلى أهله فإنه أعظم لأجره ) )(@)(@@) ( ك هق ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 1679 ) قال النبي :(@)(@@) | 30 ( إذا قضى أحدكم صلاته في المسجد ثم رجع إلى بيته فليصل في بيته ركعتين وليجعل لبيته نصيبا من صلاته فإن الله جاعل في بيته من صلاته 
ms180	 خيرا ) )(@)(@@) ( حم ع ) عن أبي سعيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1680 ) قال النبي :(@)(@@) | 30 ( إذا قضى الإمام الصلاة وقعد فأحدث قبل أن يتكلم فقد تمت صلاته ، ومن كان خلفه ممن أتم الصلاة ) )(@)(@@) ( د ) عن ابن عمرو رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1681 ) قال النبي :(@)(@@) | 30 ( إذا قضى القاضي فاجتهد فأصاب فله عشرة أجور ، وإذا اجتهد فأخطأ كان له أجر أو أجران ) )(@)(@@) ( حم ) عن ابن عمرو رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1682 ) قال النبي :(@)(@@) | 30 ( إذا قضى الله تعالى الأمر في السماء ضربت الملائكة بأجنحتها خضعانا لقوله كأنه سلسلة على صفوان ، فإذا فزع عن قلوبهم قالوا ماذا قال ربكم ؟ قالوا للذي قال الحق وهو العلي الكبير فيسمعها مسترقو السمع ، ومسترقو السمع هاكذا واحد فوق آخر فربما أدرك الشهاب المستمع قبل أن يرمي بها إلى صاحبه فيحرقه وربما لم يدركه حتى يرمي بها إلى الذي يليه ، إلى الذي هو أسفل منه حتى يلقوها إلى الأرض فتلقى على فم الساحر فيكذب معها مائة كذبة فيصدق فيقولون ألم تخبرنا يوم كذا وكذا يكون كذا وكذا فوجدناه حقا للكلمة التي سمعت من PageV01P251 السماء ) )(@)(@@) ( خ ت ه ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1683 ) قال النبي :(@)(@@) | 30 ( إذا قضى الله تعالى لعبد أن يموت بأرض جعل الله له إليها حاجة ) )(@)(@@) ( ت ك ) عن مطر بن عكامس ( ت ) عن أبي عزة رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 1684 ) قال النبي :(@)(@@) | 30 ( إذا قعد أحدكم إلى أخيه فليسأله تفقها ولا يسأله تعنتا ) )(@)(@@) ( فر ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1685 ) قال النبي :(@)(@@) | 30 ( إذا قعد بين شعبها الأربع وألزق الختان بالختان فقد وجب الغسل ) )(@)(@@) ( حم ) عن عائشة ( د ) عن أبي هريرة رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1686 ) قال النبي :(@)(@@) | 30 ( إذا قلت لصاحبك والإمام يخطب يوم الجمعة أنصت فقد لغوت ) )(@)(@@) مالك ( حم ق د ن ه ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1687 ) قال النبي :(@)(@@) | 30 ( إذا قمت إلى الصلاة فأسبغ الوضوء ثم استقبل القبلة فكبر ، ثم اقرأ ما تيسر معك من القرآن ، ثم 