ms1321	 خالد بن | عبد الله ، عن عطاء بن السائب ، عن سعيد بن جبير ، عن ابن عباس | - رضي الله عنهما - قال : سأل موسى - [ & ] - مسألة | PageV11P314 | فأعطيها محمد - [ & ] - قوله : ^ ( واختار موسى قومه | سبعين رجلا ) ^ إلى قوله : ^ ( فسأكتبها للذين يتقون ) ^ . |(@)(@@) 5122 - حدثنا العباس بن الوليد النرسي قال : نا المعتمر بن | سليمان قال : سمعت ليثا يحدث عن أبي فزارة ، عن سعيد بن جبير أو | مقسم ، عن ابن عباس - رضي الله عنهما - رفع الحديث إلى النبي | - [ & ] - أنه قال : ' هذه الكلمات رقى من كل داء : | أعوذ بكلمات الله التامة وأسمائه كلها عامة من شر السامة ، والعامة ، | وشر عين [ 298 ] لامة ، ومن شر حاسد إذا حسد ، ومن شر أبي فترة | وما ولد ، ثلاثة وثلاثين من الملائكة أتوا ربهم فقالوا : وصب وصب ، | فقال : خذوا تربة من أرضكم فامسحوا بوصبكم من أخذ عليها صفدا | PageV11P315 | أو كتمها أحدا فلا أفلح إذا أبدا ' .(@)(@@) وهذا الحديث لا نعلمه يروى بهذا اللفظ إلا من هذا الوجه بهذا | الإسناد . |(@)(@@) 5123 - حدثنا نصر بن علي قال : أنا أبي قال : نا جرير بن | حازم ، عن يعلى بن حكيم ، عن سعيد بن جبير ، عن ابن عباس وابن | عمر - رضي الله عنهم - أن النبي - [ & ] - حرم نبيذ | الجر . |(@)(@@) 5124 - وحدثنا محمد بن عبد الملك قال : نا حماد بن زيد ، عن | أيوب ، عن سعيد بن جبير ، عن ابن عمر وابن عباس ، عن النبي - [ & ] - | بنحوه . | PageV11P316 |(@)(@@) 5125 - وحدثنا عمرو بن علي ، ومحمد بن معمر قالا : نا أبو | عاصم قال : نا ثور ، عن سلمة بن أبي عطاء ، عن سعيد بن جبير ، | عن ابن عمر وابن عباس - رضي الله عنهم - أن النبي - [ & ] - | حرم نبيذ الجر . |(@)(@@) 5126 - وحدثنا عمرو بن علي قال : نا يزيد بن هارون قال : أنا | منصور بن حيان ، عن سعيد بن جبير ، عن ابن عباس ، وابن عمر ، عن | النبي - [ & ] - بنحوه . |(@)(@@) 5127 - حدثنا حمدان بن علي البغدادي قال : نا جعفر بن سلمة | PageV11P317 | قال : نا أبو بكر بن علي بن مقدم قال : نا حبيب بن أبي عمرة ، عن | سعيد بن جبير ، عن ابن عباس - رضي الله 
ms1322	 عنهما - قال : بعث رسول الله | - [ & ] - سرية فيها المقداد بن الأسود ، فلما أتوا القوم | وجدوهم قد تفرقوا ، وبقي رجل له مال كثير لم يبرح ، فقال : أشهد أن لا | إله إلا الله ، فأهوى إليه المقداد فقتله ، فقال له رجل من أصحابه : أقتلت | رجلا يشهد أن لا إله إلا الله ؟ والله لأذكرن ذلك للنبي - [ & ] - | فلما قدموا على النبي قالوا : يا رسول الله ، إن رجلا شهد أن لا | إله إلا الله فقتله المقداد . فقال : ' ادعوا لي المقداد ، يا مقداد ، أقتلت رجلا | يقول : لا إله إلا الله ، فكيف بك بلا إله إلا الله غدا ؟ ' فأنزل الله - تبارك | وتعالى - : ^ ( يا أيها الذين آمنوا إذا ضربتم في سبيل الله فتبينوا ولا | تقولوا لمن ألقى إليكم - السلم أو - السلام ) ^ . شك أبو سعيد . يعني | جعفر بن سلمة : ^ ( لست مؤمنا تبتغون عرض الحياة الدنيا فعند الله مغانم | كثيرة كذلك كنتم من قبل ) ^ قال : فقال رسول الله - [ & ] | للمقداد : ' كان رجل مؤمن يخفي إيمانه مع قوم كفار ، فأظهر | إيمانه فقتلته ، وكذلك كنت تخفي إيمانك بمكة قبل ' . | PageV11P318(@)(@@) وهذا الحديث لا نعلمه يروى بهذا اللفظ إلا عن ابن عباس ، ولا | نعلم له طريقا عن ابن عباس إلا هذا الطريق . |(@)(@@) 5128 - حدثنا سلمة بن شبيب قال : نا زيد بن الحباب قال : نا | كامل - يعني : ابن العلاء - عن حبيب بن أبي عمرة ، عن سعيد بن | جبير ، عن ابن عباس - رضي الله عنهما - أن النبي - [ & ] - | كان يقول بين السجدتين : ' رب اغفر لي وارحمني واهدني وأجرني | وعافني ' أو نحو ذلك . | PageV11P319 |(@)(@@) 5129 - حدثنا محمد بن معاوية البغدادي قال : نا خلف بن | خليفة ، عن أبي هاشم ، عن سعيد بن جبير ، عن ابن عباس - رضي | الله عنهما - أن النبي - [ & ] - سئل : من في الجنة ؟ قال : | ' النبي في الجنة ، والشهيد في الجنة ، والمولود في الجنة ، والمؤودة في | الجنة ' . | PageV11P320(@)(@@) وهذا الحديث لا نعلمه يروى بهذا اللفظ عن ابن عباس إلا من هذا | الوجه بهذا الإسناد ، وقد روي هذا الكلام عن النبي من وجوه . |(@)(@@) 5130 - حدثنا محمد بن الوليد قال : نا محمد بن جعفر قال 
ms1323	 : نا | شعبة ، عن يزيد أبي خالد ، عن المنهال بن عمرو ، عن سعيد بن جبير ، | عن ابن عباس - رضي الله عنهما - عن النبي - [ & ] - قال : | ' من دخل يعود مريضا لم يحضر أجله ، فيقول سبع مرات : أسأل الله | العظيم رب العرش العظيم أن يشفيك إلا عوفي ' . | PageV11P321(@)(@@) وهذا الحديث لا نعلمه يروى بهذا اللفظ إلا عن ابن عباس وإسناده | حسن . |(@)(@@) 5131 - حدثنا محمد بن عبد الأعلى الصنعاني قال : نا عبد | الرزاق قال : أنا معمر ، عن أيوب ، عن عبد الله بن سعيد بن جبير ، | عن أبيه ، عن ابن عباس . |(@)(@@) 5132 - وحدثنا مؤمل بن هشام قال : نا ابن علية ، عن أيوب ، | عن عبد الله بن سعيد ، عن أبيه ، عن ابن عباس . |(@)(@@) 5133 - وحدثنا محمد بن عثمان بن كرامة قال : نا عبد الله قال : | PageV11P322 | نا هشيم ، عن أبي بشر ، عن سعيد بن جبير ، عن ابن عباس - رضي | الله عنهما - قال : قدم النبي - [ & ] - المدينة فوجد اليهود | يصومون يوم عاشوراء ، فسئلوا عن ذلك . فقال : هذا اليوم الذي | أظهر الله فيه موسى وبني إسرائيل على فرعون ، فنحن نصومه . فقال | رسول الله - [ & ] - : ' نحن أولى بموسى منكم ' . فأمر | بصومه .(@)(@@) وهذا الحديث قد روي في صوم عاشورا عن ابن عباس من وجوه | بألفاظ ، فذكرنا كل حديث منها بلفظه في موضعه . |(@)(@@) 5134 - حدثنا الحسن بن عرفة قال : نا هشيم ، عن أبي بشر | قال : نا سعيد بن [ 299 ] جبير ، عن ابن عباس - رضي الله عنهما - أن | PageV11P323 | رجلا كان مع النبي - [ & ] - وهو محرم ، فوقصته ناقته | فمات . فقال رسول الله - [ & ] - : ' اغسلوه بماء وسدر ، | وكفنوه في ثوبيه ، ولا تخمروا رأسه ، ولا تمسوه بطيب ، فإنه يبعث يوم | القيامة ملبدا ' . |(@)(@@) 5135 - وحدثناه الفضل بن سهل قال : نا محمد بن بكار ، قال : نا | قيس ، عن سالم الأفطس ، عن سعيد بن جبير ، عن ابن عباس ، عن | النبي . |(@)(@@) 5136 - وحدثنا عقبة بن مكرم قال : نا أبو داود قال : نا | قيس ، عن عبد الكريم ، عن سعيد بن جبير ، عن ابن عباس ، عن النبي | PageV11P324 | بنحوه . |(@)(@@) 5137 - وحدثنا الفضل بن سهل قال : نا يونس بن محمد 
ms1324	 قال : نا | المعتمر بن سليمان ، عن أبيه قال : كتب ليث إلى سليمان بن طرخان : | حدثني حبيب بن أبي ثابت ، عن سعيد بن جبير ، عن ابن عباس - رضي | الله عنهما - قال : قيل : يا رسول الله - أو ذكروا عن رسول الله - [ & ] - | نحو هذا - : يا نبي الله ، أرأيت ما نعمل ؟ أشيئا نبتديه ؟ أم | شيئا قد فرغ منه ؟ فقال : ' لا ، بل شيء قد فرغ منه ' قال : فقال القوم | بعضهم لبعض : فالجد إذا .(@)(@@) وهذا الحديث لا نعلم رواه عن حبيب إلا ليث ، ولا رواه عن ليث | إلا سليمان التيمي . |(@)(@@) 5138 - حدثنا بشر بن معاذ قال : نا فضيل بن سليمان ، عن | عبد الله بن عثمان بن خثيم ، عن سعيد بن جبير ، عن ابن عباس - رضي | الله عنهما - عن النبي - [ & ] - قال : ' قال الله - تبارك | وتعالى - : يا ابن آدم ، إذا ذكرتني خاليا ذكرتك خاليا ، وإذا ذكرتني في | PageV11P325 | ملأ ، ذكرتك في ملأ خير من الذين تذكرني فيهم ' .(@)(@@) وهذا الحديث لا نعلمه يروى عن ابن عباس بهذا اللفظ إلا من هذا | الوجه . |(@)(@@) 5139 - حدثنا محمد بن عامر قال : نا محمد بن كثير المصيصي | قال : نا هارون بن حيان ، عن خصيف ، عن سعيد بن جبير ، عن ابن | عباس - رضي الله عنهما - عن النبي - [ & ] - قال : ' لا يدخل | الجنة مثقال حبة خردل من كبر ، ولا يدخل النار مثقال حبة خردل من | إيمان ' . | PageV11P326(@)(@@) وهذا الحديث لا نعلمه يروى عن ابن عباس ، عن النبي إلا من هذا | الوجه بهذا الإسناد . |(@)(@@) 5140 - حدثنا عباد بن يعقوب قال : نا عبد الله بن بكير | قال : نا حكيم بن جبير ، عن سعيد بن جبير ، عن ابن عباس - رضي الله | عنهما - قال : بعث رسول الله - [ & ] - إلى خيبر | - أحسبه : أبا بكر - فرجع منهزما ومن معه ، فلما كان من الغد بعث عمر | فرجع منهزما يجبن أصحابه ويجبنه أصحابه ، فقال رسول الله - [ & ] - : | ' لأعطين الراية غدا رجلا يحب الله ورسوله ، ويحبه الله | ورسوله ، لا يرجع حتى يفتح الله عليه ' . فثار الناس . فقال : ' أين علي ؟ ' | فإذا هو يشتكي عينه ، فتفل رسول الله - [ & ] - في عينه ، | ثم 
ms1325	 دفع إليه الراية فهزها ، ففتح الله عليه . | PageV11P327(@)(@@) وهذا الحديث لا نعلمه يروى عن ابن عباس ، عن النبي إلا من هذا | الوجه بهذا الإسناد . |(@)(@@) 5141 - حدثنا إبراهيم بن سعيد الجوهري قال : نا يحيى بن | سعيد الأموي ، عن محمد بن قيس ، عن أبي عون ، عن سعيد بن | جبير ، عن ابن عباس - رضي الله عنهما - قال : جاءت بنو أسد إلى رسول | الله - [ & ] - فقالوا : يا رسول الله ، أسلمنا وقاتلتك العرب | ولم نقاتلك . فقال رسول الله : ' إن فقههم قليل ، وإن الشيطان ينطق | على ألسنتهم ' ونزلت هذه الآية : ^ ( يمنون عليك أن أسلموا قل لا تمنوا | علي إسلامكم ) ^ الآية . | PageV11P328(@)(@@) وهذا الحديث لا نعلم أحدا رواه عن رسول الله - [ & ] - | بهذا اللفظ إلا ابن عباس ، ولا له طريقا عن ابن عباس إلا هذا | الطريق . ولا نعلم أسند محمد بن عبيد الله ، عن سعيد بن جبير غير هذا | الحديث . ومحمد بن عبيد الله هو : أبو عون . |(@)(@@) 5142 - حدثنا محمد بن معمر قال : نا مسلم بن إبراهيم قال : نا | الحسن بن أبي جعفر قال : نا أبو الصهباء عن سعيد بن جبير ، عن | ابن عباس - رضي الله عنهما - قال : قال رسول الله - [ & ] - : | ' مثل أهل بيتي مثل سفينة نوح ، من ركب فيها نجا ، ومن | تخلف عنها غرق ' .(@)(@@) وهذا الحديث لا نعلم أحدا رواه إلا الحسن بن أبي جعفر ، والحسن | PageV11P329 | لم يكن بالقوي ، وقد حدث عنه جماعة من أهل العلم ، واحتملوا | حديثه ، وكان أحد العباد . |(@)(@@) 5143 - حدثنا الفضل بن سهل ، وعبد الملك بن هوذة بن | خليفة ، وإبراهيم بن زياد الصائغ قالوا : نا يونس بن محمد قال : نا | يعقوب بن عبد الله القمي قال : نا جعفر بن أبي المغيرة ، عن سعيد | ابن جبير ، عن ابن عباس قال : جاء عمر بن الخطاب - رضي الله عنه - إلى | رسول الله - [ & ] - فقال : يا رسول الله ، هلكت . قال : | ' وما أهلكك ؟ ' قال : حولت رحلي الليلة . فلم يرد عليه بشيء . فأنزل الله | - تبارك وتعالى - هذه الآية : ^ ( نساؤكم حرث لكم فأتوا حرثكم أنى | شئتم ) ^ قال : يقول : ' أقبل وأدبر واتق الدبر والحيضة ' . | PageV11P330(@)(@@) وهذا الحديث 
ms1326	 لا نعلمه يروى عن ابن عباس إلا من هذا الوجه بهذا | الإسناد . |(@)(@@) 5144 - حدثنا محمد بن المثنى قال : نا بكر بن يحيى [ 300 ] بن | زبان العتري قال : نا حبان بن علي ، عن جعفر بن أبي المغيرة ، عن | سعيد بن جبير ، عن ابن عباس - رضي الله عنهما - أن رسول الله - [ & ] - | صلى ذات يوم صلاة الغداة ، ثم قال : ' هل هاهنا أحد | من هذيل ؟ إن صاحبكم محبوس على باب الجنة ' - أحسبه قال - : | ' بدينه ' .(@)(@@) وهذا الحديث لا نعلمه يروى عن ابن عباس إلا من هذا الوجه ، ولا | نعلم أحدا حدث به عن جعفر بن أبي المغيرة إلا حبان بن علي . |(@)(@@) 5145 - حدثنا الفضل بن سهل قال : نا عفان بن مسلم قال : نا | PageV11P331 | حفص بن غياث قال : نا حبيب - يعني : ابن أبي عمرة - ، عن سعيد | ابن جبير ، عن ابن عباس - رضي الله عنهما - في قول الله - تبارك | وتعالى - : ^ ( ما قطعتم من لينة أو تركتموها قائمة على أصولها فبإذن | الله وليخزي الفاسقين ) ^ قال : اللينة : النخلة . ^ ( وليخزي الفاسقين ) ^ | قال : استنزلوهم من حصونهم وأمروا بقطع النخل ، فقالوا : قد قطعنا بعضا | فلنسألن رسول الله - [ & ] - : هل لنا فيما قطعنا من أجر ؟ | وهل علينا فيما تركنا من وزر ؟ فأنزل الله - تبارك وتعالى - ما قطعتم من | لينة فبإذن الله وما تركتم فبإذن الله . |(@)(@@) 5146 - حدثنا سلمة بن شبيب وأحمد بن منصور بن سيار | قالا : نا عبد الله بن إبراهيم ، عن أبيه إبراهيم بن عمر قال : نا وهب بن | مانوس أنه سمع سعيد بن جبير يحدث عن ابن عباس - رضي الله | PageV11P332 | عنهما - قال : لما رفع رسول الله - [ & ] - رأسه من | الركوع قال : ' ربنا لك الحمد ملء السماوات وملء الأرض | وملء ما شئت من شيء بعد ' . |(@)(@@) 5147 - حدثنا زياد بن أيوب قال : نا هشيم بن بشير قال : نا | أبو بشر ، عن سعيد بن جبير ، عن ابن عباس قال كان عمر - رضي الله | عنه - يأذن لأهل بدر ، ويأذن لي معهم . فقال بعضهم : أتاذن لهذا الفتى | معنا ، وفي أبنائنا من هو مثله ؟ فقال عمر : إنه ممن قد 
ms1327	 علم . فأذن لهم ذات | PageV11P333 | يوم ، وأذن لي معهم فسألهم عن هذه السورة : ^ ( إذا جاء نصر الله والفتح ) ^ | فقالوا : أمر الله - تبارك وتعالى - نبيه إذا فتح الله له أن يستغفره ويتوب | إليه . فقال : ما تقول يا بن عباس ؟ فقلت : ليس كذلك ، ولكن أخبر نبيه | بحضور أجله ، فقال : ^ ( إذا جاء نصر الله والفتح ) ^ فتح مكة ، ^ ( ورأيت | الناس يدخلون في دين الله أفواجا ) ^ فذلك علامة موتك ، ^ ( فسبح بحمد | ربك واستغفره إنه كان توابا ) ^ فقال لهم عمر : كيف تلومونني عليه بعدما | ترون ؟ . |(@)(@@) 5148 - حدثنا عمر بن الخطاب السجستاني قال : نا محمد بن | يوسف قال : نا قيس بن الربيع ، عن الأعمش ، عن مسلم البطين ، | عن سعيد بن جبير ، عن ابن عباس - رضي الله عنهما - قال : لما خرج | رسول الله - [ & ] - من مكة . قال أبو بكر : إنا لله وإنا إليه | PageV11P334 | راجعون ، أخرج رسول الله ، سيهلكوا جميعا ، فلما نزلت هذه الآية : | ^ ( أذن للذين يقاتلون بأنهم ظلموا وإن الله على نصرهم لقدير * الذين | أخرجوا من ديارهم ) ^ عرف أبو بكر أنه سيكون قتال . |(@)(@@) 5149 - حدثنا يوسف بن موسى قال : نا عبيد الله بن موسى | قال : نا إسرائيل ، عن أبي إسحاق ، عن سعيد بن جبير ، عن ابن عباس | - رضي الله عنهما - قال : كان الجن يقعدون إلى السماء فيستمعون | الوحي ، فإذا سمعوا الكلمة زادوا فيها أضعافا ، فأما الكلمة فتكون حقا ، | وأما الباقي فيكون باطلا ، حتى بعث النبي - [ & ] - فمنعوا | مقاعدهم ، ولم تكن النجوم يرمى بها قبل ذلك ، فقال لهم إبليس : ما هذا | إلا لأمر قد حدث في الأرض ، فبعث جنوده ، فوجدوا رسول الله - [ & ] - | PageV11P335 | قائما يصلي ، فأخبروه . فقال : هذا الحدث الذي حدث | في الأرض . |(@)(@@) 5150 - حدثنا أحمد بن إسحاق قال : نا أبو أحمد قال : نا عمر ابن | ذر ، عن أبيه ، عن سعيد بن جبير ، عن ابن عباس - رضي الله عنهما - قال : | قال النبي - [ & ] - لجبريل - عليه السلام - : ' ما لك لا تأتينا | أكثر مما تأتينا ؟ ' ، فنزلت : ^ ( وما نتنزل إلا بأمر ربك ) ^ الآية . |(@)(@@) 5151 - حدثنا محمد بن إسماعيل بن سمرة قال : نا أسباط ، عن | PageV11P336 | أشعث ، عن سلمة 
ms1328	 بن كهيل ، عن سعيد بن جبير ، عن ابن عباس | - رضي الله عنهما - قال : نهى رسول الله - [ & ] - أن يرموا | الجمرة حتى تطلع الشمس . |(@)(@@) 5152 - حدثنا إبراهيم بن إسماعيل بن يحيى بن سلمة بن كهيل قال : | حدثني أبي ، عن أبيه ، عن سلمة بن كهيل ، عن سعيد بن جبير ، عن ابن | عباس - رضي الله عنهما - أن النبي - [ & ] - صلى صلاة الفجر | يوم الجمعة فقرأ : ^ ( ألم تنزيل ) ^ و ^ ( هل أتى على الإنسان ) ^ . | PageV11P337(@)(@@) وحديث أسباط عن أشعث ، أخطأ فيه أشعث ، إنما هو عن سلمة ، | عن الحسن العرني ، عن ابن عباس . |(@)(@@) 5153 - حدثنا أبو بريد عمرو بن يزيد قال : نا سيف بن عبيد الله | الجرمي قال : نا ورقاء ، عن عطاء بن السائب ، عن سعيد بن جبير ، | عن ابن عباس - رضي الله عنهما - أن رسول الله - [ & ] - | قال : ' أمر المرء أن يسجد على سبعة أعظم : يديه [ 301 ] ورجليه | وركبتيه ووجهه ' . | PageV11P338(@)(@@) وهذا الحديث لا نعلم رواه عن عطاء فأسنده إلا ورقاء . |(@)(@@) 5154 - حدثنا زيد بن أخزم ، وحمدان بن علي البغدادي ، قالا : نا | مسلم بن إبراهيم قال : نا أبو هلال ، عن عقبة بن أبي ثبيت ، عن أبي | الجوزاء ، عن ابن عباس - رضي الله عنهما - قال : قال رسول | الله - [ & ] - : ' أهل الجنة من ملأ أذنيه من خير يسمعه ، | وأهل النار من ملأ أذنيه من شر يسمعه ' .(@)(@@) سمعت حمدان بن علي يقول : سمعت مسلما يقول : بلغني أن عقبة بن | أبي ثبيت كان يدعو الطير فتجيبه . |(@)(@@) 5155 - حدثنا أحمد بن سنان قال : نا أبو داود قال : نا أبو | عوانة ، عن أبي بشر ، عن سعيد بن جبير ، عن ابن عباس - رضي الله | PageV11P339 | عنهما - قال : قال رسول الله - [ & ] - : ' ليس المعاين | كالمخبر ، أخبر الله - تبارك وتعالى - موسى أن قومه قد فتنوا فلم يلق | الألواح ، فلما رآهم ألقى الألواح ' .(@)(@@) آخر الموفي الأربعين ، والحمد لله كثيرا | كما هو أهله ، والصلاة على محمد | المصطفى وآله وسلم تسليما . | PageV11P340 |(@)(@@) | المكيون عن ابن عباس(@)(@@) 5156 - أخبرنا أبو الحسن محمد بن أيوب بن حبيب بن يحيى | الرقي قال : نا أحمد بن عمرو بن عبد الخالق 
ms1329	 : نا محمد بن عبد الرحيم قال : | نا كثير بن هشام أبو المقدام ، عن حبيب بن الشهيد ، عن عطاء ، عن ابن | عباس - رضي الله عنهما - أن رسول الله - [ & ] - قال : | ' إن الله - تبارك وتعالى - خلق الجنة بيضاء ، فأحب الثياب إلى الله | البياض ، فليلبسه أحياؤكم ، وكفنوا فيه موتاكم ' .(@)(@@) وهذا الحديث لا نعلمه يروى عن رسول الله - [ & ] - | بهذا اللفظ إلا من هذا الوجه ، ولم يسند حبيب بن الشهيد ، عن | عطاء ، عن ابن عباس غير هذا الحديث ، ولا رواه عن حبيب إلا كثير بن | هشام ، وهشام رجل من أهل البصرة ليس به بأس . قد حدث عنه جماعة | من أهل العلم . |(@)(@@) 5157 - حدثنا عيسى بن هارون القرشي قال : نا عمران بن | عيينة ، عن يزيد بن أبي زياد ، عن عطاء ، عن ابن عباس - رضي الله | عنهما - عن النبي - [ & ] - أنه قال : ' للغلام عقيقتان ، | PageV11P341 | وللجارية عقيقة ' .(@)(@@) وهذا الحديث لا نعلمه يروى عن النبي - [ & ] - | بهذا اللفظ إلا من هذا الوجه بهذا الإسناد ، وإنما يروى عن النبي - [ & ] - : | ' عن الغلام شاتان وعن الجارية شاة ' . ولم يسند | يزيد بن أبي زياد عن عطاء عن ابن عباس غير هذا الحديث . ولم يروه عن | يزيد إلا عمران بن عيينة وأبو بكر بن عياش . |(@)(@@) 5158 - حدثنا إبراهيم بن عبد الله بن محمد الكوفي أبو شيبة قال : | نا خالد بن يزيد بن زياد قال : نا أبو بكر بن عياش ، عن يزيد بن أبي | زياد ، عن عطاء ، عن ابن عباس عن النبي - [ & ] - .(@)(@@) وقد اختلف في هذا الحديث عن عطاء فروي عن عطاء ، عن حبيبة | PageV11P342 | بنت ميسرة ، عن أم كرز هكذا ، رواه عمرو بن دينار والحجاج بن أرطاة ، | ورواه قيس بن سعد ، عن عطاء ، عن أم كرز ، ولم يدخل بينهما حبيبة | بنت ميسرة . |(@)(@@) 5159 - حدثنا إبراهيم بن سعيد الجوهري وإبراهيم بن زياد | الصائغ قالا : نا عبد الله بن نمير قال : نا محمد بن إسحاق ، عن أيوب | ابن موسى ، عن عطاء ، عن ابن عباس - رضي الله عنهما - قال : كان | قيمة المجن على عهد رسول الله - [ & ] - عشرة دراهم .(@)(@@) وهذا الحديث إنما 
ms1330	 ذكرناه وإن لم يذكر عن النبي - [ & ] - | شيء منه ؛ لأنه قال : كان قيمته على عهد رسول الله - [ & ] - | عشرة دراهم ، فكان دلالة على أنه إنما قطع النبي - [ & ] - | في المجن وقيمته عشرة دراهم ، وإنما ذكر ابن عباس القيمة من | PageV11P343 | قبل نفسه كما ذكر عبد الله بن عمر فقال : كان قيمته ثلاثة دراهم من | نفسه . ولا نعلم روى أيوب بن موسى عن عطاء ، عن ابن عباس غير هذا | الحديث . |(@)(@@) 5160 - حدثنا الحسن بن الصباح بن البزار قال : نا عبد المجيد | ابن عبد العزيز بن أبي رواد قال : نا مروان بن سالم ، قال : حدثني | عبد الملك - يعني : ابن أبي سليمان - عن عطاء ، عن ابن عباس | - رضي الله عنهما - أن رسول الله - [ & ] - قال : ' إن أول | ما يجازى به العبد بعد موته أن يغفر لجميع من اتبع جنازته ' .(@)(@@) وهذا الحديث لا نعلمه يروى عن النبي - [ & ] - إلا | من هذا الوجه ولا نعلم رواه إلا ابن عباس عن النبي - [ & ] - | ومروان بن سالم لين الحديث ، ورواه عنه محمد بن الزبرقان أبو | همام الأهوازي ، وعبد المجيد بن عبد العزيز بن أبي رواد ، ولا نعلم أسند | عبد الملك بن أبي سليمان ، عن عطاء ، عن ابن عباس إلا حديثين هذا | أحدهما والآخر بت عند خالتي ميمونة . |(@)(@@) 5161 - حدثنا محمد بن المثنى قال : نا خالد بن الحارث قال : نا | PageV11P344 | عبد الملك ، عن عطاء ، عن ابن عباس .(@)(@@) فلم يثبته لأنا كنا قد أخرجناه عن غير عبد الملك ، عن عطاء ، | ورواه عن عبد الملك رجلان : خالد بن الحارث ، وإسحاق بن يوسف . |(@)(@@) 5162 - حدثنا محمد بن معاوية البغدادي قال : نا عباد بن | العوام قال : نا الحجاج بن أرطاة ، عن عطاء ، عن ابن عباس - رضي | الله عنهما - أن رسول الله - [ & ] - نهى عن بيع النخل | سنتين [ 302 ] وثلاثة أن يشترى في رءوس النخل بكيل أو تباع الثمرة | حتى يبدو صلاحها .(@)(@@) وهذا الحديث لا نعلم أحدا يرويه بهذا اللفظ بإسناد حسن من هذا | الإسناد . |(@)(@@) 5163 - حدثنا محمد بن معمر قال : نا عمرو بن صالح ، قال : نا | الحجاج بن أرطاة ، عن 
ms1331	 عطاء ، عن ابن عباس - رضي الله عنهما - | PageV11P345 | قال : كان النبي - [ & ] - لا يرمي حتى تزول الشمس | - يعني : فيما كان بعد يوم النحر - .(@)(@@) وهذا الحديث لا نعلمه يروى بهذا اللفظ إلا عن ابن عباس ، وإنما | يروى أنه كان يرمي - [ & ] - ضحى . |(@)(@@) 5164 - وحدثنا الحسن بن خلف الواسطي قال : نا إسحاق بن | يوسف قال : نا شريك عن الحجاج ، عن عطاء ، عن ابن عباس | - رضي الله عنهما - أن النبي - [ & ] - أهدى مائة بدنة مقلدة | مجللة .(@)(@@) وهذا الحديث قد روي عن النبي - [ & ] - ، روي | PageV11P346 | عن ابن عباس من غير وجه أنه أهدى مائة بدنة فيها جمل لأبي جهل | ولم يقل مقلدة مجللة . |(@)(@@) 5165 - حدثنا عبيد الله بن سعد بن إبراهيم بن سعد الزهري | قال : حدثني عمي يعقوب بن إبراهيم بن سعد قال : حدثني أبي ، عن ابن | إسحاق ، عن الحجاج بن أرطاة ، عن عطاء ، عن ابن عباس | - رضي الله عنهما - قال : قبض النبي - [ & ] - وأنا | ختين .(@)(@@) وهذا الحديث قد روي عن سعيد بن جبير ، عن ابن عباس ، | فاختلفوا في لفظه فقال أبو إسحاق عن سعيد بن جبير ، عن ابن عباس | قال : قبض النبي - [ & ] - وأنا ختين ، وقال أبو بشر عن | سعيد بن جبير ، عن ابن عباس قال : قبض النبي - [ & ] - | وأنا ابن ثنتي عشرة سنة فذكرنا حديث الحجاج ، عن عطاء ، عن ابن | عباس ؛ لأنه تابع أبا إسحاق ، عن سعيد ، عن ابن عباس في روايته . | PageV11P347 |(@)(@@) 5166 - حدثنا عبد الله بن سعيد الكندي قال : نا حفص بن | غياث ، عن الحجاج ، عن عطاء ، عن ابن عباس - رضي الله | عنهما - قال : قال رسول الله - [ & ] - : ' عمرة في رمضان | تعدل حجة ' .(@)(@@) وهذا الحديث قد روي عن غير ابن عباس ، فذكرنا هذا الحديث في | هذا الموضع بهذا اللفظ ، ورواه أيضا ابن جريج . |(@)(@@) 5167 - حدثنا عمرو بن علي قال : نا أبو عاصم ، عن ابن | جريج ، عن عطاء ، عن ابن عباس ، عن النبي - [ & ] - | بنحوه . | PageV11P348 |(@)(@@) 5168 - وحدثناه عبد الله بن سعيد قال : نا حفص بن غياث | قال : نا الحجاج ، عن عطاء ، عن ابن عباس - رضي الله عنهما - أن | رسول الله - [ & ] - أبصر شاة 
ms1332	 ميتة شاغرة برجلها فقال : | ' ما ضر أهل هذه لو انتفعوا بإهابها ؟ ' فدبغته سودة وانتبذت فيه .(@)(@@) وإنما ذكرنا هذا الحديث لأنه زاد فيه ما نحب أن نخرجه لعلة الزيادة | فيه . |(@)(@@) 5169 - حدثنا عبيد بن بخيت قال : نا عبد العزيز بن عبد الرحمن | PageV11P349 | قال : نا خصيف ، عن عطاء ، عن ابن عباس - رضي الله عنهما - أن | رجلا قال : يا رسول الله ، إني ظاهرت من امرأتي ، فرأيت ساقها في القمر | فواقعتها قبل أن أكفر ، فقال له رسول الله - [ & ] - : | ' كفر ولا تعد ' .(@)(@@) وهذا الحديث لا نعلمه يروى عن عطاء ، عن ابن عباس إلا من هذا | الوجه ، ولا نعلم رواه عن خصيف إلا عبد العزيز بن عبد الرحمن . |(@)(@@) 5170 - حدثنا عمرو بن علي وعقبة بن مكرم العمي قالا : نا أبو | عاصم ، عن ابن جريج ، عن عطاء قال : سمعت ابن عباس - رضي | الله عنهما - يقول : سمعت النبي - [ & ] - يقول : ' لو أن | لابن آدم واديا مملوءا مالا لأحب أن يكون له مثله ، ولا يملأ نفس | ابن آدم إلا التراب ويتوب الله على من تاب ' . | PageV11P350(@)(@@) وهذا الحديث إنما ذكرناه وإن كان يروى عن جماعة عن النبي ؛ | لأن يزيد بن الأصم رواه عن ابن عباس ، عن أبي ، وقال في حديث ابن | جريج عن عطاء ، عن ابن عباس قال : سمعت النبي . . فذكرناه لنبين | اختلاف ذلك وابن جريج أحفظ ممن رواه عن يزيد الأصم وعطاء أحفظ | من يزيد بن الأصم . |(@)(@@) 5171 - حدثنا عمرو بن علي قال : نا يحيى بن سعيد القطان قال : | نا ابن جريج ، عن عطاء ، عن ابن عباس - رضي الله عنهما - أنه دعا | أخاه عبيد الله يوم عرفة فأتى بطعام فقال : إني صائم ، فقال : إنكم أهل | بيت يقتدى بكم لقد رأيت رسول الله - [ & ] - أتي | بحلاب لبن في مثل هذا اليوم فشرب . | PageV11P351(@)(@@) وهذا الحديث قد روي عن ابن عباس بإسناد آخر ، رواه أيوب عن | عكرمة ، واختلفوا على أيوب فبعضهم قال عن عكرمة ، وبعضهم قال عن | سعيد بن جبير ، وابن جريج ، عن عطاء ، عن ابن عباس أحب إلينا من | أيوب عن عكرمة . |(@)(@@) 5172 
ms1333	 - حدثنا عمرو بن علي قال : نا أبو عاصم ، عن ابن | جريج ، عن عطاء قال : حضرت مع ابن عباس جنازة ميمونة فقال : | هذه زوجة رسول الله - [ & ] - فلا تزعزعوها ولا | تزلزلوها ، فإنه كان للنبي - [ & ] - تسع نسوة وكان | يقسم لثمان ولا يقسم لواحدة . قال عطاء : التي لا يقسم لها صفية بنت | حيي بن أخطب .(@)(@@) وهذا الحديث لا نعلمه يروى عن ابن عباس بإسناد أحسن من هذا | PageV11P352 | الإسناد وقد روي بغير هذا الإسناد ، عن ابن عباس ، والذي يحفظ عن | ابن عباس من غير هذا الوجه [ 303 ] أن التي لم يكن يقسم لها سودة | بنت زمعة ؛ لأنها وهبت يومها لعائشة . |(@)(@@) 5173 - وحدثنا أبو كريب وعمرو بن علي قالا : نا أبو معاوية | قال : نا ابن جريج ، عن عطاء ، عن ابن عباس - رضي الله عنهما - | قال : رمل رسول الله - [ & ] - في حجته وعمرته ، وأبو | بكر وعمر وعثمان والخلفاء ، وزاد عمرو بن علي : رمل رسول الله | - [ & ] - ثلاثا ومشى أربعا .(@)(@@) وهذا الحديث لا نعلمه يروى عن ابن عباس بهذا اللفظ إلا من هذا | الوجه ، ولا نعلم أسند هذا الحديث ، عن ابن جريج إلا أبو معاوية ، | ورواه غير أبي معاوية ، عن ابن جريج ، عن عطاء مرسلا . |(@)(@@) 5174 - حدثنا محمد بن حرب الواسطي قال : نا صلة بن | سليمان ، عن ابن جريج ، عن عطاء ، عن ابن عباس - رضي الله | PageV11P353 | عنهما - أن رسول الله - [ & ] - قال : ' من حج عن والديه | أو قضى عنهما دينا بعث مع الأبرار ' .(@)(@@) وهذا الحديث لا نعلمه يروى عن النبي - [ & ] - إلا | من هذا الوجه ، ولا نعلم له طريقا غير هذا الطريق ، وصلة بن سليمان | رجل واسطي ، كان أصلهم من البصرة فانتقلوا إلى واسط ، ولم يتابع | صلة على هذا الحديث . |(@)(@@) 5175 - حدثنا محمد بن حرب الواسطي قال : نا عمير بن | عمران قال : نا ابن جريج ، عن عطاء ، عن ابن عباس - رضي الله | عنهما - أن رسول الله - [ & ] - قال : ' ليس من البر | الصوم في السفر ' .(@)(@@) وهذا الحديث لا نعلمه يروى عن ابن عباس عن النبي - [ & ] - | إلا من هذا الوجه ، ولا نعلم حدث بهذا الحديث 
ms1334	 عن ابن | جريج إلا عمير بن عمران ، وهو رجل من أهل البصرة ولم يتابع على | هذا الحديث . |(@)(@@) 5176 - حدثنا عمرو بن علي قال : نا يحيى بن سعيد قال : نا ابن | PageV11P354 | جريج ، عن عطاء ، عن ابن عباس - رضي الله عنهما - أن رسول الله | - [ & ] - قال : ' إذا أكل أحدكم طعاما فلا يمسح يده | حتى يلعقها أو يلعقها ' .(@)(@@) وهذا الحديث قد روي نحو كلامه عن النبي - [ & ] - | من غير وجه ، ولا نعلم إسنادا يروى في ذلك أحسن من هذا | الإسناد ولا أصح . |(@)(@@) 5177 - حدثنا عبد الله بن إسحاق العطار قال : نا أبو عاصم ، | عن ابن جريج ، عن عطاء ، عن ابن عباس ، وجابر بن عبد الله | - رضي الله عنهم - قالا : لم يكن يؤذن للنبي - [ & ] - في | فطر ولا أضحى . | PageV11P355(@)(@@) وهذا الحديث قد روي عن جابر من غير وجه ، وروي عن الحكم | عن مقسم عن ابن عباس وحديث ابن جريج ، عن عطاء أحسن من | حديث الحكم عن مقسم ، ولا نعلم أحدا جمعهما ، عن عطاء ، عن ابن | عباس وجابر غير ابن جريج ، ولم نسمع أحدا يحدث به ، عن أبي عاصم | إلا عبد الله بن إسحاق ، وكان مشهورا ثقة في الحديث . |(@)(@@) 5178 - حدثنا أحمد بن خزيمة قال : نا أبو عاصم ، عن ابن | جريج ، عن عطاء ، عن ابن عباس - رضي الله عنهما - قال : استسلف | النبي - [ & ] - من رجل من الأنصار أربعين صاعا فاحتاج | الأنصاري ، فأتاه فقال رسول الله - [ & ] - : ' ما جاءنا | شيء بعد ' قال : ثم احتاج بعد ، فأتاه ، فقال رسول الله - [ & ] - : | ' ما جاءنا شيء بعد ' فقال الرجل - وأراد أن يتكلم - فقال | رسول الله - [ & ] - : ' لا تقل إلا خيرا فأنا خير من | يسلف ' فأعطاه أربعين فضلا وأربعين لسلفه فأعطاه ثمانين . | PageV11P356(@)(@@) وهذا الحديث لا نعلمه يروى عن النبي - [ & ] - | بإسناد متصل إلا من هذا الوجه ، بهذا الإسناد ولم نسمع هذا الحديث إلا | من أحمد بن خزيمة وكان ثقة . |(@)(@@) 5179 - حدثنا محمد بن مسكين قال : نا عمرو بن الربيع قال : نا | يحيى بن أيوب ، عن ابن جريج ، عن عطاء ، عن ابن عباس - رضي | الله عنهما - أن رجلا قال 
ms1335	 : يا رسول الله علي بدنة وأنا موسر لها ولا | أجدها قال : ' اذبح شاة ' .(@)(@@) وهذا الحديث لا نعلم أحدا أسنده إلا يحيى بن أيوب ، عن ابن | جريج ، وقد رواه غيره موقوفا . |(@)(@@) 5180 - حدثنا الفضل بن سهل قال : نا قدامة بن محمد بن | قدامة قال : نا إسماعيل بن شيبة الطائفي ، قال : نا ابن جريج ، عن | PageV11P357 | عطاء ، عن ابن عباس - رضي الله عنهما - قال : قال رسول الله | - [ & ] - : ' باب النار لا يدخله أحد إلا رجل يشفي | غيظه بسخط الله ' .(@)(@@) وهذا الحديث لا نعلمه يروى عن النبي - [ & ] - | بهذا اللفظ إلا من هذا الوجه بهذا الإسناد ، وقدامة بن محمد ليس به بأس | وإسماعيل بن شيبة قد حدث عنه ابن جريج بغير حديث لم يتابع عليه . |(@)(@@) 5181 - حدثنا محمد بن عبد الرحيم صاحب السابري قال : نا | يونس بن محمد قال : نا مسلم بن خالد ، عن ابن جريج ، عن | عطاء ، عن ابن عباس - رضي الله عنهما - عن النبي - [ & ] - | PageV11P358 | وقت لأهل المشرق ذات عرق .(@)(@@) وهذا الحديث لا نعلمه يروى إلا عن ابن عباس بهذا الإسناد ، ولا | نعلم روي هذا الحديث ، عن ابن جريج إلا مسلم بن خالد . |(@)(@@) 5182 - وحدثنا محمد بن عبد الرحيم قال : نا يونس بن محمد | قال : نا مسلم بن خالد ، عن ابن جريج ، عن عطاء ، عن ابن عباس | [ 304 ] - رضي الله عنهما - عن النبي - [ & ] - في المحرم : | ' يلبس الخفين إذا لم يجد نعلين ' ولم يقل : ليقطعهما .(@)(@@) وهذا الحديث لا نعلم رواه أحدا عن ابن جريج إلا مسلم بن خالد | ومسلم لم يكن به بأس ولم يكن حافظا وكان أحد فقهاء مكة . | PageV11P359 |(@)(@@) 5183 - وحدثنا محمد بن أبي غالب قال : نا صفون بن صالح | قال : نا عيسى بن يونس قال : نا ابن جريج ، عن عطاء ، عن ابن | عباس - رضي الله عنهما - أن رسول الله - [ & ] - سئل | عن الغيل ؟ فقال : ' لو كان ضارا أحدا ضر فارس والروم ' .(@)(@@) وهذا الحديث لا نعلمه يروى عن ابن عباس إلا من هذا الوجه ، ولا | نعلم حدث به عن ابن جريج إلا عيسى بن يونس . |(@)(@@) 5184 
ms1336	 - حدثنا عمرو بن يحيى الأبلي قال : نا الحارث بن | PageV11P360 | غسان ، قال : نا ابن جريج ، عن عطاء ، عن ابن عباس - رضي الله | عنهما - أن النبي - [ & ] - قال : ' كل مولود يولد على | الفطرة فأبواه يهودانه وينصرانه ' .(@)(@@) وهذا الحديث لا نعلم أحدا رواه عن ابن جريج ، عن عطاء ، عن | ابن عباس إلا الحارث بن غسان وهو رجل من أهل البصرة ليس به بأس . |(@)(@@) 5185 - حدثنا شعيب بن أيوب قال : نا معاوية بن هشام | قال : نا سفيان عن ابن جريج ، عن عطاء ، عن ابن عباس - رضي الله | عنهما - أن محمدا رأى ربه - يعني بقلبه - . | PageV11P361(@)(@@) وهذا الحديث لا نعلم أحدا رواه عن سفيان الثوري ، عن ابن | جريج غير معاوية بن هشام . |(@)(@@) 5186 - حدثنا عمر بن الخطاب قال : نا نعيم بن حماد قال : نا | إبراهيم بن أبي حية ، عن ابن جريج ، عن عطاء ، عن ابن عباس | - رضي الله عنهما - قال : قال رسول الله - [ & ] - : ' لا | يزال الدين واصبا ما بقي من قريش عشرون رجلا ' . | PageV11P362(@)(@@) وهذا الحديث لا نعلمه يروى بهذا اللفظ عن النبي - [ & ] - | إلا من هذا الوجه وإبراهيم بن أبي حية لا نعلم أحدا تابعه على | هذا الحديث وهو رجل ليس بالقوي في الحديث ، وإنما كتبناه ؛ لأنا لم | نحفظه عن النبي - [ & ] - إلا من هذا الوجه ، وابن أبي حية | يماني . |(@)(@@) 5187 - حدثنا عمر بن الخطاب قال : نا داود بن أبي شبيب | قال : نا يحيى بن عباد السعدي ، عن ابن جريج ، عن عطاء ، عن ابن | عباس - رضي الله عنهما - أن رسول الله - [ & ] - أمر | صارخا يصرخ في بطن مكة يأمر بصدقة الفطر ويقول : هي حق واجب | على كل مسلم ذكر أو أنثى صغير أو كبير حر أو عبد حاضر أو باد | مدان من قمح أو صاع مما سوى ذلك من الطعام ، ألا وإن الولد | للفراش وللعاهر الحجر . | PageV11P363(@)(@@) وهذا الحديث لا نعلم أحدا حدث به عن ابن جريج ، إلا يحيى بن | عباد ، ولا نعلم أحدا حدث به عن يحيى بن عباد إلا داود بن شبيب ، وقد | روي أكثر كلام هذا الحديث من 
ms1337	 غير وجه إلا حاضر أو باد ، فإن هذا | اللفظ لا يروى عن النبي - [ & ] - إلا من هذا الوجه . |(@)(@@) 5188 - حدثنا محمد بن عبد الرحيم قال : نا يونس بن محمد قال : | نا الليث عن يزيد بن أبي حبيب ، عن عطاء قال سمعت ابن عباس | - رضي الله عنهما - يقول : ماتت شاة فقال النبي - [ & ] - | لأهل الشاة : ' ألا دبغتم جلدها ثم انتفعتم به ' . |(@)(@@) 5189 - حدثنا عمرو بن علي قال : نا يحيى بن سعيد ، عن ابن | PageV11P364 | جريج ، عن عطاء ، عن ابن عباس - رضي الله عنهما - قال : ماتت | داجنة لميمونة فقال رسول الله - [ & ] - : ' ألا انتفعتم | بإهابها ' . |(@)(@@) 5190 - وحدثناه محمد بن عثمان بن كرامة قال : نا عبيد الله بن | موسى عن ابن جريج ، عن عطاء ، عن ابن عباس - رضي الله | عنهما - قال : كانت شاة لإحدى نساء النبي - [ & ] - | فماتت ، فقال رسول الله - [ & ] - : ' أفلا انتفعتم | بإهابها ' .(@)(@@) وهذا الحديث قد روي عن ابن عباس بألفاظ مختلفة ، وقد روي عن | غير ابن عباس بنحو معناه ، بغير لفظه ، وذكرنا كل حديث في موضعه ولفظه . | PageV11P365 |(@)(@@) 5191 - حدثنا مقدم بن محمد بن يحيى بن عطاء بن مقدم قال : | حدثني عمي القاسم بن يحيى بن عطاء بن مقدم عن عبد الله بن عثمان بن | خثيم ، عن عطاء ، عن ابن عباس ، عن النبي - [ & ] - . |(@)(@@) 5192 - وحدثناه محمد بن عبد الرحيم قال : نا أحمد بن عبد الله | ابن يونس قال : نا أبو بكر بن عياش ، عن عبد العزيز بن رفيع ، عن | عطاء ، عن ابن عباس ، عن النبي - [ & ] - . |(@)(@@) 5193 - وحدثنا الحسن بن محمد قال : نا سعيد - يعني : ابن | سليمان - قال : نا هشيم ، عن منصور بن زاذان ، عن عطاء ، عن ابن | عباس - رضي الله عنهما - قال : جاء رجل إلى رسول الله - [ & ] - | PageV11P366 | فقال : إني حلقت قبل أن أذبح قال : ' اذبح ولا حرج ' وقال | آخر : إني حلقت قبل أن أرمي ، قال : ' ارم ولا حرج ' وقال آخر : إني | زرت البيت قبل أن أرمي قال : ' ارم ولا حرج ' .(@)(@@) وهذا اللفظ لفظ ابن خثيم وقال عبد العزيز في حديثه : إني زرت | قبل أن أرمي ، قال : ' ارم 
ms1338	 ولا حرج ' قال : حلقت قبل أن أرمي ، قال : ' ارم ولا | حرج ' قال : نحرت [ 305 ] قبل أن أرمي ، قال : ' ارم ولا حرج ' .(@)(@@) وهذا الحديث رواه غير من ذكرنا عن عطاء ، عن جابر رواه أسامة | ابن زيد وقيس بن سعد ، عن عطاء ، عن جابر فذكرناه لاختلافهم ، عن | عطاء لنبين ذلك وحديث منصور بن زاذان ، لا نعلم رواه إلا هشيم ، ولا | نعلم أسند ابن خثيم ، عن عطاء ، عن ابن عباس غير هذا ولا أسند عبد | العزيز بن رفيع ، عن عطاء عن ابن عباس غير هذا الحديث . |(@)(@@) 5194 - حدثنا عمرو بن علي قال : نا أبو عاصم جعفر بن | يحيى بن ثوبان ، عن عمه عمارة بن ثوبان ، عن عطاء ، عن ابن | PageV11P367 | عباس - رضي الله عنهما - قال : قال رسول الله - [ & ] - : | ' خير صفوف الرجال أولها وشرها آخرها ، وشر صفوف | النساء أولها وخيرها آخرها ' . |(@)(@@) 5195 - وحدثنا عمرو بن علي قال : نا أبو عاصم قال : نا | جعفر بن يحيى بن ثوبان ، عن عمه عمارة بن ثوبان ، عن عطاء ، | عن ابن عباس - رضي الله عنهما - قال : قال رسول الله - [ & ] - : | ' خياركم ألينكم مناكب في الصلاة ' . |(@)(@@) 5196 - وحدثنا عمرو بن علي قال : نا أبو عاصم قال : نا | جعفر بن يحيى بن ثوبان عن عمه عمارة بن ثوبان ، عن عطاء ، | PageV11P368 | عن ابن عباس - رضي الله عنهما - أن رسول الله - [ & ] - | أذن في ضرب النساء فسمع من الليل صوتا عاليا فقال : ' إني لأسمع صوتا | عاليا ' قالوا : يا رسول الله ، أذنت في ضرب النساء ، فقال رسول الله | - [ & ] - : ' خيركم خيركم لأهله ، وأنا خيركم لأهلي ' .(@)(@@) وهذه الأحاديث لا نعلمها تروى عن ابن عباس إلا بهذا الإسناد | وجعفر بن يحيى وعمه من أهل مكة مستورون . |(@)(@@) 5197 - حدثنا محمد بن المثنى قال : نا عبد الوهاب - يعني ابن عبد | المجيد - عن حبيب المعلم ، عن عطاء ، عن ابن عباس - رضي الله | عنهما - أن رسول الله - [ & ] - كان يبعث بالثقل | سحرا وكنت فيهم .(@)(@@) وهذا الحديث قد رواه جماعة ، عن عطاء ، عن ابن عباس ، وعن | PageV11P369 | عكرمة ، ولا نعلم يروى من حديث حبيب المعلم ، عن عطاء 
ms1339	 ، عن ابن | عباس إلا من هذا الوجه ، وحبيب المعلم بصري ثقة . |(@)(@@) 5198 - حدثنا عبد الله بن سعيد أبو سعيد الأشج والحسن بن | عرفة قالا : نا يحيى بن اليمان قال : نا المنهال بن خليفة ، عن الحجاج | ابن أرطاة ، عن عطاء ، عن ابن عباس - رضي الله عنهما - أن النبي | - [ & ] - دفن رجلا في قبر ليلا وأسرج له بسراج وألحده | من قبل القبلة وكبر عليه أربعا وقال : ' رحمك الله إن كنت لأواها | بالقرآن تلاء للقرآن ' .(@)(@@) وهذا الحديث لا نعلم رواه إلا يحيى بن يمان عن منهال بن خليفة | بهذا الإسناد ، ولا نعلم يروى هذا الكلام إلا من هذا الوجه . يحيى بن | اليمان كوفي مشهور ثقة والمنهال بن خليفة كوفي مشهور والحجاج بن | أرطاة كوفي أيضا ، وكان حجاج على قضاء الكوفة . |(@)(@@) 5199 - حدثنا عبد الله بن سعيد أبو سعيد قال : نا حفص بن | PageV11P370 | غياث قال : نا أشعث بن سوار عن عطاء . |(@)(@@) 5200 - وحدثناه الحسين بن أيوب قال : نا عبد الأعلى بن عبد | الأعلى قال : نا هشام بن حسان ، عن عسل بن سفيان ، عن عطاء | قال : صلى ابن الزبير بالناس صلاة المغرب فسلم فيهما ، ثم قام إلى الحجر | يستلمه فسبحوا به فرجع فصلى الركعة الباقية ، ثم سلم وسجد سجدتين | فذكر ذلك لابن عباس فقال : ما أماط عن سنة نبيه - [ & ] - . | PageV11P371(@)(@@) وهذا الحديث قد رواه عن عطاء جماعة غير من سمينا ، فاقتصرنا | على من سمينا . |(@)(@@) 5201 - حدثنا محمد بن بشار بندار قال : نا محمد بن جعفر | قال : نا شعبة ، عن يعقوب بن عطاء - يعني : ابن أبي رباح - عن أبيه ، | عن ابن عباس - رضي الله عنهما - ، عن النبي - [ & ] - | أنه تزوج ميمونة وهو محرم . |(@)(@@) 5202 - وحدثناه إبراهيم بن هاني قال : نا أبو المغيرة عبد | القدوس بن الحجاج عن الأوزاعي ، عن عطاء ، عن ابن عباس - رضي | الله عنهما - أن النبي - [ & ] - تزوج ميمونة وهو محرم .(@)(@@) وقد روى هذا الحديث جماعة عن عطاء ، عن ابن عباس منهم : | PageV11P372 | معقل بن عبيد الله ، وأبو الزبير ، ويحيى بن أبي كثير ، وغيرهم . وأما | حديث يعقوب بن عطاء 
ms1340	 ، عن أبيه ، عن ابن عباس ، فلا نعلم رواه عن | يعقوب إلا شعبة . معقل بن عبيد الله جزري ثقة . |(@)(@@) 5203 - حدثنا محمد بن معمر ، والسكن بن سعيد قالا : نا | روح بن عبادة قال : نا شعبة ، عن يعقوب بن عطاء ، عن أبيه ، عن | ابن عباس - رضي الله عنهما - قال : ماتت شاة لميمونة فقال النبي - [ & ] - : | ' هلا استمتعتم بإهابها ؟ ' قال : ' إن دباغ الأديم | طهوره ' .(@)(@@) وهذا الحديث لا نعلم رواه عن يعقوب بن عطاء ، عن أبيه ، إلا | شعبة وقد روي عن عطاء ، عن ابن عباس من وجوه . |(@)(@@) 5204 - وحدثنا محمد بن الهيثم قال : نا أحمد بن يونس ، عن أبي | بكر بن عياش ، عن يعقوب بن عطاء ، عن أبيه ، عن ابن عباس | PageV11P373 | - رضي الله عنهما - قال : صلى رسول الله - [ & ] - يوم | عرفة الظهر والعصر جمع بينهما وصلى الظهر بأذان وإقامة والعصر | بإقامة ولم يتطوع بينهما .(@)(@@) وهذا الحديث لا نعلم رواه عن يعقوب بن عطاء بهذا الإسناد إلا | أبو بكر بن عياش . |(@)(@@) 5205 - حدثنا طليق بن محمد [ 306 ] الواسطي قال : نا سعيد | ابن سليمان قال : نا عبد الله بن مؤمل - مكي مشهور - قال : حدثني | عمر بن عبد الرحمن بن محصن عن عطاء بن أبي رباح عن ابن عباس | رفعه قال : ' من دخل البيت دخل في حسنة ثم خرج مغفورا له ' .(@)(@@) وهذا الكلام لا نعلمه يروى عن ابن عباس إلا من هذا الوجه . PageV11P374 |(@)(@@) | كريب عن ابن عباس(@)(@@) 5206 - حدثنا عمرو بن علي قال : نا عبد الرحمن بن مهدي | قال : نا مالك ، عن مخرمة بن سليمان ، عن كريب ، عن ابن عباس - رضي | الله عنهما - قال : بت عند خالتي ميمونة ، فقلت : لأنظرن إلى صلاة رسول | الله - [ & ] - فطرحت لي وسادة فنمت في طولها ، ونام هو | وأهله ، ثم قام نصف الليل أو قبيله أو بعيده ، فجعل يمسح النوم عن وجهه ، | ثم قرأ الآيات الأواخر من آل عمران ، حتى ختم ، ثم قام فأتى شنا معلقا | فأخذه فتوضأ ، ثم قام فصلى ، وقمت فصنعت مثل الذي صنع ، ثم جئت | فقمت إلى جنبه ، فوضع يده على رأسي 