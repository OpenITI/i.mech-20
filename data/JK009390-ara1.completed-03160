ms3141	 وفي منامه وقعوده ، فهل لك أن أقبض لك الأرض فتصلي عليه ؟ قال : نعم ، فصلى عليه ) )(@)(@@) | . ( ع ، عن أنس بن مالك رضي الله عنه ) . .(@)(@@) PageV10P019(@)(@@)(@@)(@@) $ 60 / 29085 قال النبي :(@)(@@) | 30 ( أتاني جبريل فقال : قل ، قلت : وما أقول ؟ قال : قل : أعوذ بكلمات الله التامات التي لا يجاوزهن بر ولا فاجر من شر ما خلق وذرأ وبرأ ، ومن شر ما ينزل من السماء ، ومن شر ما يعرج فيها ، ومن شر ما ذرأ في الأرض ومن شر ما يخرج منها ، ومن شر فتن الليل والنهار ومن شر كل طارق يطرق إلا طارقا يطرق بخير يا رحمان ) )(@)(@@) . ( حم ، طك ، عن عبد الرحمان بن خفش رضي الله عنه بإسناد حسن ) . .(@)(@@)(@@)(@@) $ 61 / 29086 قال النبي :(@)(@@) | 30 ( أتاني جبريل فقال : إن ربك أرسلني إليك لأرقيك فحللت رأسي فقال : باسم الله أرقيك ، من كل شيء يؤذيك ، ومن شر كل عين حاسد أرقيك ورددها ثلاثا ) )(@)(@@) . ( طس ، عن بريرة رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 62 / 29087 قال النبي :(@)(@@) | 30 ( أتاني جبريل ومعه ملك فتنحى الملك فقلت : يا جبريل ! ما شأنه ؟ قال : إنه وجد منك ريح نحاس ، وإنا لا نستطيع ريح النحاس ) )(@)(@@) . ( طس ، عن ابن عمر رضي الله عنهما ) . .(@)(@@)(@@)(@@) $ 63 / 29088 قال النبي :(@)(@@) | 30 ( أتاني جبريل فقال : يا محمد ! استوص معاوية فإنه أمين علاى كتاب الله ونعم الأمين هو ) )(@)(@@) . ( طس ، عن ابن عباس رضي الله عنهما ) . .(@)(@@)(@@)(@@) $ 64 / 29089 قال النبي :(@)(@@) | 30 ( أتاني جبريل فقال : إن ربك يقرئك السلام ويقول لك : إن شئت أصبح لهم الصفا ذهبا فمن كفر منهم عذبته عذابا لا أعذبه أحدا من العالمين ، وإن شئت فتحت لهم باب التوبة والرحمة ، قلت : بل باب التوبة والرحمة ) )(@)(@@) . ( طس ، عن ابن عباس رضي الله عنهما قال : قالت قريش : ادع لنا ربك يجعل لنا الصفا ذهبا ، فإذا أصبح ذهبا اتبعناك فدعاى ربه فذكره ) . .(@)(@@)(@@)(@@) $ 65 / 29090 قال النبي :(@)(@@) | 30 ( أتاني ربي عز وجل الليلة في أحسن صورة فقال : يا محمد ! فقلت : لبيك وسعديك ، قال : هل تدري فيم يختصم الملأ الأعلاى ؟ قلت : لا أدري ، قاله مرتين أو ثلاثة 
ms3142	 ، ثم وضع كفه بين كتفي فوجدت PageV10P020 بردها بين ثديي حتى تجلى لي ما في السماوات وأرض ، ثم تلاى هاذه الآية : { وكذلك نري إبراهيم ملكوت السماوات والأرض } الخ ، قال : يا محمد ! فيم يختصم الملأ الأعلاى ؟ قلت في الكفارات والدرجات ، قال : وما الكفارات ؟ قلت : المشي علاى الأقدام ، والجلوس في المسجد خلف الصلوات ، وإسباغ الوضوء في المكاره ، قال : صدقت يا محمد فمن فعل ذالك بخير عاش بخير ومات بخير وكان من خطيئته كيوم ولدته أمه ، ومن الدرجات : طيب الكلام ، وبذل السلام ، وإطعام الطعام ، والصلاة بالليل والناس نيام ، يا محمد إذا صليت فقل : اللهم إني أسألك الطيبات ، وترك المنكرات ، وحب المساكين ، وأن تتوب علي ، وإذا أردت فتنة في الناس فتوفني غير مفتون ) )(@)(@@) . ( حم ، عن عبد الرحمان بن عاش رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 66 / 29091 قال النبي :(@)(@@) | 30 ( أتاني رسول ربي وأنا جالس فقال : { إن الله يأمر بالعدل والإحسان . . } الآية ) )(@)(@@) . ( حم ، طك ، عن ابن عباس رضي الله عنهما ) . .(@)(@@)(@@)(@@) $ 67 / 29092 قال النبي :(@)(@@) | 30 ( أتاني الملك فقال : يا محمد ! أما يرضيك إن ربك عأ وجل يقول : إنه لا يصلي عليك أحد من أمتك صلاة إلا صليت عليه عشرا ، قلت : بلاى أي رب ) )(@)(@@) . ( حم ، عن أبي طلحة رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 68 / 29093 قال النبي :(@)(@@) | 30 ( أتاني ملكان وأنا ببعض بطحاء مكة ، فقال أحدهما : أهو هو ؟ قال : زنه برجل فرجحته ، قال : زنه بعشرة ، فوزنني بعشرة فوزنتهم ، ثم قال : زنه بمائة فوزنني بمائة فرجحتهم ، قال : زنه بألف فرجحتهم ، فقال أحدهما لصاحبه : لو وزنته بأمته لرجحها ، ثم قال أحدهما لصاحبه : شق بطنه ، فشق بطني ثم أخرج منه قسم الشيطان فطرحها ، ثم اغسل بطنه غسل الإناء ، ثم دعا PageV10P021 بالسكينة كأنها زهرة بيضاء ، فأدخلت قلبي ثم قال : خط بطنه فخاطها وجعل الخاتم بين كتفي ، فما هو إلا أن وليا عني كأنما أعاين الأمر معاينة ) )(@)(@@) . ( بز ، عن أبي ذر رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 69 / 29094 قال النبي :(@)(@@) | 30 ( أتتصدقين بما لا تأكلين ) )(@)(@@) . ( طس ، عن عائشة رضي الله عنها قالت : أردت أن أتصدق بلحم أنتن فذكره 
ms3143	 ) . .(@)(@@)(@@)(@@) $ 70 / 29095 قال النبي :(@)(@@) | 30 ( أتحب الزنا لأمك ؟ قال : لا والله ، قال : ولا الناس يحبونه لأمهاتهم ، قال : أفتحبه لابنتك ؟ قال : لا ، قال : ولا الناس يحبونه لبناتهم ، قال : أتحبه لأختك ؟ قال : لا ، قال : ولا الناس يحبونه لأخواتهم ، قال : أتحبه لعمتك ؟ قال : لا ، قال : ولا الناس يحبونه لعماتهم ، قال : أتحبه لخالتك ؟ قال : لا ، قال : ولا الناس يحبونه لخالاتهم ، فوضع يده عليه وقال : اللهم اغفر له ذنبه ، وطهر قلبه ، وحصن فرجه ) )(@)(@@) . ( حم ، طك ، عن أبي أمامة رضي الله عنه قال : أتاه فتى من قريش فقال : إئذن لي في الزنا ، فزجره القوم ، فقال له النبي : ادن مني ، فلما دنا منه ذكره ) . .(@)(@@)(@@)(@@) $ 71 / 29096 قال النبي :(@)(@@) | 30 ( أتحبني يا كعب ؟ قال : نعم ، قال : إن الفقر أسرع إلاى من يحبني من السيل إلاى مغاديه ، وإنه سيصيبك بلاء فأعد له تجفافا ) )(@)(@@) . ( طس ، عن كعب بن عجرة رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 72 / 29097 قال النبي :(@)(@@) | 30 ( أتحبون أن يستظل نبيكم بظل من نار يوم القيامة ؟ ) )(@)(@@) . ( طس ، عن أبي حازم الأنصاري رضي الله عنه ، قال : أتاى رجل للنبي بنطع من الغنيمة ليستظل به فذكره ) . .(@)(@@)(@@)(@@) $ 73 / 29098 قال النبي :(@)(@@) | 30 ( اتخذ زوج حمام يؤنسك ) )(@)(@@) . ( طك ، عن PageV10P022 عبادة رضي الله عنه قال : شكى رجل للنبي الوحشة قال فذكره ) . .(@)(@@)(@@)(@@) $ 74 / 29099 قال النبي : $ 30 ( اتخذوا تقواى الله تجارة يأتيكم الرزق بلا بضاعة ولا تجارة ثم قرأ : { ومن يتق الله يجعل له مخرجا ويرزقه من حيث لا يحتسب } ( طك ، عن معاذ رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 75 / 29100 قال النبي :(@)(@@) | 30 ( أتدرون أي الأعمال أحب ؟ الحب في الله والبغض في الله ) )(@)(@@) . ( حم ، عن أبي ذر رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 76 / 29101 قال النبي :(@)(@@) | 30 ( أتدرون ما مثلي ومثلكم ؟ قالوا الله ورسوله أعلم ، قال : إنما مثلي ومثلكم مثل قوم خافوا عدوا يأتيهم فبعثوا رجلا يتراءى لهم ، فبينما هو كذالك أبصر العدو فأقبل لينذرهم ، وخشي أن يذركه العدو قبل أن ينذر قومه ، فأهواى بثوبه ، أيها الناس أتيتم ، أيها الناس أتيتم ثلاث مرار ) )(@)(@@) . ( حم ، عن بريرة رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 77 
ms3144	 / 29102 قال النبي :(@)(@@) | 30 ( أتدرون ما هاذه ؟ هاذه ريح الذين يغتابون المؤمنين ) )(@)(@@) . ( حم ، عن جابر رضي الله عنه ، قال : كنا مع النبي فارتفعت ريح منتنة فذكره ) . .(@)(@@)(@@)(@@) $ 78 / 29103 قال النبي :(@)(@@) | 30 ( أتدرون من السابقون إلاى ظل الله عز وجل ؟ الذين إذا أعطوا الححق قبلوه ، وإذا سئلوه بذلوه ، وحكموا للناس كحكمهم لأنفسهم ) )(@)(@@) . ( حم ، عن عائشة رضي الله عنها ) . .(@)(@@)(@@)(@@) $ 79 / 29104 قال النبي :(@)(@@) | 30 ( أتدرون ما مثل ناركم هاذه من نار جهنم ، لهي PageV10P023 أشد من ناركم هاذه بسبعين ضعفا ) )(@)(@@) . ( طس ، عن أبي هريرة رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 80 / 29105 قال النبي :(@)(@@) | 30 ( أتدري ما تفسير لا حول ولا قوة إلا بالله ؟ : لا حول عن معصية الله ، ولا قوة علاى طاعة الله إلا بعون الله ) )(@)(@@) . ( بز ، عن ابن مسعود رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 81 / 29106 قال النبي :(@)(@@) | 30 ( أتدري ما يقول الله عز وجل في الشام ؟ إن الله يقول للشام : أنت صفوتي من بلادي ، فيك خيرتي من عبادي ، إن الله تكفل بالشام وأهله ) )(@)(@@) . ( طك ، عن ابن خولة الأزدي رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 82 / 29107 قال النبي :(@)(@@) | 30 ( أتراى ثوبيك هاذين يدخلانك الجنة ؟ قال : لئن استغفرت لي لا أقعد حتى أنزعهما فقال : اللهم اغفر لضمرة فانطلق ونزعهما ) )(@)(@@) . ( حم ، طك ، عن ضمرة بن ثعلبة رضي الله عنه قال : دخلت علاى النبي وعلي حلتان من حلل اليمن فذكره ) . .(@)(@@)(@@)(@@) $ 83 / 29108 قال النبي :(@)(@@) | 30 ( انزعوا واسقوا فلولا أن أخاف أن تغلبوا عليها لنزعت ) )(@)(@@) . ( بز ، عن أبي الكفل رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 84 / 29109 قال النبي :(@)(@@) | 30 ( انزعوا ولولا أن تغلبوا عليها لنزعت ) )(@)(@@) . ( بز ، عن عثمان رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 85 / 29110 قال النبي :(@)(@@) | 30 ( أترون هاذه السخلة هانت علاى أهلها إذ طرحوها ، والله للدنيا أهون علاى الله من هاذه السخلة علاى أهلها ، ولو كانت تزن عند الله جناح بعوضة ما سقاى كافرا منها قطرة ماء أبدا ) )(@)(@@) . ( طكس ، عن عمر رضي الله عنه قال : مر النبي بسخلة ميتة مطروحة فذكره ) . .(@)(@@)(@@)(@@) $ 86 / 29111 قال النبي :(@)(@@) | 30 ( أتشهدين أن لا إلاه إلا الله وأني رسول 
ms3145	 الله ؟ PageV10P024 قالت : نعم ، قال : أتؤمنين بالبعث بعد الموت ؟ قالت : نعم ، قال : أعتقها ) )(@)(@@) . ( حم ، عن رجل من الأنصار أنه جاء بأمة سوداء فقال : أنا علاى رقبة مؤمنة ، فإن كنت تراى هاذه مؤمنة أعتقتها فذكره ) . .(@)(@@)(@@)(@@) $ 87 / 29112 قال النبي :(@)(@@) | 30 ( أتضحكون وذكر الجنة والنار بين أيديكم ) )(@)(@@) . ( طك ، عن عبد الله بن الزبير رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 88 / 29113 قال النبي :(@)(@@) | 30 ( أتعلمين من الشهيد ؟ القتل في سبيل الله شهادة ، والطاعون شهادة ، والغرق شهادة ، والبطن شهادة ، والنفساء يجرها ولدها بسرره إلاى الجنة ) )(@)(@@) . ( حم ، عن راشد بن حنيش رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 89 / 29114 قال النبي :(@)(@@) | 30 ( أتغتسلون ولا تستترون ؟ ولله إني لأخشاى أن تكونوا خلق الشر يعني الخلق الذي يكون فيه الشر ) )(@)(@@) . ( طك ، عن عبد الله بن عامر بن ربيعة عن أبيه قال : أتاى النبي علينا ونحن نغتسل يصب بعضنا علاى بعض فذكره ) . .(@)(@@)(@@)(@@) $ 90 / 29115 قال النبي :(@)(@@) | 30 ( اتق الله يا أبا الوليد ، لا تأتي يوم القيامة ببعير له رغاء ، أو بقرة لها خوار ، أو شاة لها ثؤاج ، قال : يا رسول الله ! إن ذالك كذالك ؟ قال : إي والذي نفسي بيده ، قال : فوالذي بعثك بالحق لا أعمل لك علاى شيء أبدا ) )(@)(@@) . ( طك ، عن عبادة رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 91 / 29116 قال النبي :(@)(@@) | 30 ( اتق الله يا سعد أن تجيء يوم القيامة ببعير تحمله له رغاء ، قال : لا أجده ، اعفني فأعفاه ) )(@)(@@) . ( بز ، عن ابن عمر رضي الله عنهما ) . .(@)(@@)(@@)(@@) $ 92 / 29117 قال النبي :(@)(@@) | 30 ( اتق الله يا عمار بن مظعون ، فإن لأهلك عليك PageV10P025 حقا ، وإن لضيفك عليك حقا ، وإن لنفسك عليك حقا : صم وأفطر ، وصل ونم ) )(@)(@@) . ( حم ، عن عائشة رضي الله عنها ) . .(@)(@@)(@@)(@@) $ 93 / 29118 قال النبي :(@)(@@) | 30 ( اتقوا الله وصلوا أرحامكم فإنه ليس من ثواب أسرع من صلة الرحم ، وإياكم والبغي فإنه ليس من عقوبة أسرع من عقوبة بغي ، وإياكم وعقوق الوالدين ، فإن ريح الجنة توجد من مسيرة ألف عام ، والله لا يجدها عاق ولا قاطع رحم ، ولا شيخ زان ، ولا جار إزاره خيلاء ، إنما الكبرياء لله رب العالمين 
ms3146	 ، والكذب كله إثم إلا ما نفعت به مؤمنا ودفعت به عن دين ، وإن في الجنة لسوقا لا يباع فيه ولا يشتراى ، ليس فيها إلا الصور ، فمن أحب صورة رجل أو امرأة دخل فيها ) )(@)(@@) . ( طكس ، عن جابر رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 94 / 29119 قال النبي :(@)(@@) | 30 ( اتقوا الله ، فإنكم إن اتقيتم الله يوشك أن يثيبكم من زيت الشام وقمحها ) )(@)(@@) . ( طك ، عن سهل رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 95 / 29120 قال النبي :(@)(@@) | 30 ( اتقوا الله يا أمة محمد ، واديان عميقان قفران ، لا تهيجوا عليكم وهيج النار ، بسم الله الرحمان الرحيم ، هاذا كتاب من الرحمان الرحيم بأسماء أهل الجنة وأسماء آبائهم وأمهاتهم وعشائرهم فرغ ربكم ، بسم الله الرحمان الرحيم هاذا كتاب من الرحمان الرحيم بأسماء أهل النار وأسماء آبائهم وأمهاتهم وعشائرهم فرغ ربكم أعذرت أنذرت اللهم إني بلغت ) )(@)(@@) . ( طك ، عن أبي الدرداء وواثلة بن الأسقع رضي الله عنهما ) . .(@)(@@)(@@)(@@) $ 96 / 29121 قال النبي :(@)(@@) | 30 ( اتقوا الله واسمعوا وأطيعوا ) )(@)(@@) . ( طك ، عن عدي بن حاتم رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 97 / 29122 قال النبي :(@)(@@) | 30 ( اتقوا النار ولو بشق تمرة فإنها تسد من الجائع مسدها من الشبعان ) )(@)(@@) . ( حم ، عن عائشة رضي الله عنها ) . .(@)(@@)(@@)(@@) $ 98 / 29123 قال النبي :(@)(@@) | 30 ( اتقوا خداج الصلاة ، إذا ركع الإمام فارجعوا ، PageV10P026 وإذا رفع فارفعوا ) )(@)(@@) . ( حم ، عن أبي سعيد رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 99 / 29124 قال النبي :(@)(@@) | 30 ( اتقوا هاذا الشرك فإنه أخفاى من دبيب النمل ، قيل : كيف نتقيه ؟ قال : قولوا اللهم إنا نعوذ بك أن نشرك بك شيئا نعلمه ، ونستغفرك لما لا نعلمه ) )(@)(@@) . ( حم ، طكس ، عن أبي موساى رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 100 / 29125 قال النبي :(@)(@@) | 30 ( أتقعد قعدة المغضوب عليهم ) )(@)(@@) . ( حم ، عن الشريد بن سويد رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 101 / 29126 قال النبي :(@)(@@) | 30 ( أوتيت خزائن الدنيا والخلد فيها ثم الجنة ، وخيرت بين ذالك وبين لقاء ربي عز وجل والجنة ، قيل فخذ مفاتيح الدنيا والخلد فيها ثم الجنة ، قلت : لا والله ، لقد اخترت لقاء ربي ثم الجنة ) )(@)(@@) . ( حم ، طك ، عن أبي مويهبة رضي الله عنه ) . ) .(@)(@@)(@@)(@@) $ 102 / 29127 قال النبي 
