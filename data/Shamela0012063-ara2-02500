ms2485	 الكوفي روى عنه عبد المؤمن بن عبد الله القيسي لا يدري من هو.(@)(@@)(@@)(@@) | 3513 - (@)(@@) " عبد الله " بن أبي رزين بن مسعود الأسدي الكوفي عن مالك وعن أبيه وعنه موسى بن أبي عايشة وثقه بن حبان لا يدري من هو.(@)(@@)(@@)(@@) | 3514 - (@)(@@) " عبد الله " بن الرقيم5 الكناني الكوفي سمع سعدا وعنه عبد الله بن شريك PageV07P261(@)(@@) العامري وحده قاله بن خراش.(@)(@@)(@@)(@@) | 3515 - (@)(@@) " عبد الله " بن الزبير بن معبد الباهلي البصري عن ثابت وعنه نصر بن علي.(@)(@@)(@@)(@@) | 3516 - (@)(@@) " عبد الله " بن زغب1 الأيادي الشامي عن عبد الله بن حوالة.(@)(@@)(@@)(@@) | 3517 - (@)(@@) " عبد الله " بن زياد بن سليمان ابن سمعان المخزومي أبو عبد الرحمن المدني قاضيها عن مجاهد وعنه روح.(@)(@@)(@@)(@@) | 3518 - (@)(@@) " عبد الله " بن زياد البحراني2 البصري عن علي بن زيد.(@)(@@)(@@)(@@) | 3519 - (@)(@@) " عبد الله " بن زياد عن أبي عبيدة بن عبد الله بن ربيعة وعنه محمد بن بكر البرساني.(@)(@@)(@@)(@@) | 3520 - (@)(@@) " عبد الله " بن زيد بن اسلم العدوي المدني أبو محمد مولى آل عمر عن أبيه وعنه ابن المبارك.(@)(@@)(@@)(@@) | 3521 - (@)(@@) " عبد الله " بن زيد بن عمر أو عامر أبو قلابة الجرمي3 البصري أحد الأئمة نزل الشام عن عائشة رضى الله عنهما.(@)(@@)(@@)(@@) | 3522 - (@)(@@) " عبد الله " بن زيد بن الأزرق عن عقبة بن عامر وعنه أبو سلام.(@)(@@)(@@)(@@) | 3523 - (@)(@@) " عبد الله " بن سالم الزبيدي4 أبو محمد الكوفي المفلوج القزاز روى عنه أبو داود بن ماجة ثقة.(@)(@@)(@@)(@@) | 3524 - (@)(@@) " عبد الله " بن سالم الأشعري الوحاظي5 الحمصي أبو يوسف.(@)(@@)(@@)(@@) | 3525 - (@)(@@) " عبد الله " بن السائب بن يزيد الكندي أبو محمد المدني بن أخت نمر عن أبيه وعنه ابن أبي ذئب. PageV07P262(@)(@@)(@@)(@@) | 3526 - (@)(@@) " عبد الله " بن سبع1 عن علي تفرد عنه سالم بن أبي الجعد.(@)(@@)(@@)(@@) | 3527 - (@)(@@) " عبد الله " بن سخبرة عن أبيه وعنه أبو داود الأعمى مجهول.(@)(@@)(@@)(@@) | 3528 - (@)(@@) " عبد الله " بن سراقة الأزدي البصري عن أبي عبيدة.(@)(@@)(@@)(@@) | 3529 - (@)(@@) " عبد الله " بن السري الأنطاكي المدايني الزاهد عنه خلف بن تميم.(@)(@@)(@@)(@@) | 3530 - (@)(@@) " عبد الله " بن سعد عن الصناب