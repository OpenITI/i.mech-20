ms441	 عبد بن حميد ( ت ) حسن صحيح وابن سعد ( ع حل ) عن ابن عمر رضي الله عنهما ( ز ) عن أنس بن خباب .(@)(@@)(@@)(@@) $ ( 4177 ) قال النبي :(@)(@@) | 30 ( اللهم اشدد الدين بأحب الرجلين إليك بعمر بن الخطاب أو بأبي جهل بن هشام ) )(@)(@@) ابن عساكر عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4178 ) قال النبي :(@)(@@) | 30 ( اللهم أيد الإسلام بعمر ) )(@)(@@) ( ط حم ) و الشاشي عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4179 ) قال النبي :(@)(@@) | 30 ( اللهم أعز الإسلام بعمر بن الخطاب خاصة ) )(@)(@@) ( ه عد ك هق ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 4180 ) قال النبي :(@)(@@) | 30 ( اللهم أعز الإسلام بعمر بن الخطاب ، اللهم وأعز عمر بن الخطاب ) )(@)(@@) ابن عساكر عن الزبير بن العوام رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4181 ) قال النبي :(@)(@@) | 30 ( اللهم أعز الدين بأبي جهل أو بعمر بن الخطاب ) )(@)(@@) البغوي عن ربيعة السعدي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4182 ) قال النبي :(@)(@@) | 30 ( اللهم أعز الدين بعمر بن الخطاب ) )(@)(@@) ابن سعد عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 4183 ) قال النبي :(@)(@@) | 30 ( اللهم صل على المحلقين ثلاثا ) )(@)(@@) ابن منده وأبو نعيم عن جابر بن الأزرق الغاضري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4184 ) قال النبي :(@)(@@) | 30 ( اللهم إني أعوذ بك من قلب لا يخشع ، ومن دعاء لا يسمع ، ونفس لا تشبع ) )(@)(@@) ( طب ) و ابن عساكر عن جرير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4185 ) قال النبي :(@)(@@) | 30 ( اللهم لا تخزني يوم البأس ، ولا تخزني يوم القيامة ) )(@)(@@) ابن قانع ( طب ) وأبو نعيم ( ض ) عن أبي قرصافة رضي الله عنه .(@)(@@) PageV02P101(@)(@@)(@@)(@@) $ ( 4186 ) قال النبي :(@)(@@) | 30 ( اللهم لا تخزنا يوم القيامة ولا تفضحنا يوم اللقاء ) )(@)(@@) ابن عساكر عن أبي قرصافة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4187 ) قال النبي :(@)(@@) | 30 ( اللهم اغفر لأحيائنا وأمواتنا وأصلح ذات بيننا ، وألف بين قلوبنا ، اللهم هاذا عبدك فلان ولا نعلم إلا خيرا وأنت أعلم به فاغفر لنا وله ، قيل يا رسول الله فإن لم أعلم خيرا ؟ قال : لا تقل إلا ما تعلم ) )(@)(@@) ابن سعد والبغوي والباوردي ( طب ) وأبو نعيم عن عبد الله بن الحارث بن نوفل بن الحارث بن عبد المطلب 
ms442	 عن أبيه .(@)(@@)(@@)(@@) $ ( 4188 ) قال النبي :(@)(@@) | 30 ( اللهم اغفر للمحلقين ، قالوا والمقصرين يا رسول الله ؟ قال اللهم اغفر للمحلقين قال في الثالثة والمقصرين ) )(@)(@@) ( ش حم طب ) و ابن قانع ( ض ) عن حبشي بن جنادة ( حم ش ) عن يزيد بن أبي مريم عنه ( حم طب ) عن مالك بن ربيعة ( حم ش طب ) عن ابن عباس ( حم طب ) عن أم الحصين ( حم ) عن قارب بن الأسود الثقفي رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 4189 ) قال النبي :(@)(@@) | 30 ( اللهم ارحم المحلقين ، قالوا : والمقصرين يا رسول الله ؟ قال : اللهم ارحم المحلقين ، قال في الثالثة والمقصرين ) )(@)(@@) مالك ( ط حم خ م د ت ه ) عن ابن عمر ( حم ش م ) عن أم الحصين ( ط حم ع ) عن أبي سعيد ( طب ) عن عبد الله بن قارب رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 4190 ) قال النبي :(@)(@@) | 30 ( اللهم من كنت مولاه فعلي مولاه ، اللهم وال من والاه وعاد من عاداه وانصر من نصره ، وأعن من أعانه ) )(@)(@@) ( طب ) عن حبشي بن جنادة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4191 ) قال النبي :(@)(@@) | 30 ( اللهم أعنه وأعن به ، وارحمه وارحم به ، وانصره PageV02P102 وانصر به ، اللهم وال من والاه ، وعاد من عاداه يعني عليا ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4192 ) قال النبي :(@)(@@) | 30 ( اللهم إنك باركت لامتي في أصحابي فلا تسلبهم البركة ، وباركت لأصحابي في أبي بكر فلا تسلبهم البركة ، وأجمعهم عليه ولا تشتت أمره ، فإنه لم يزل يؤثر أمرك على أمره ، اللهم وأعز عمر بن الخطاب ، وصبر عثمان بن عفان ، ووفق عليا ، واغفر لطلحة ، وثبت الزبير ، وسلم سعدا ، ووقر عبد الرحمان بن عوف ، وألحق بي السابقين الأولين من المهاجرين والأنصار والتابعين باحسان ، الذين يدعون لي ولأموات أمتي ولا يتكلفون ، ألا وإني بريء من التكلف وصالح أمتي ) )(@)(@@) ( قط ) في الأفراد ، ( ك ) و الخطيب وابن عساكر والديلمي والرافعي عن الزبير بن العوام .(@)(@@) وابن عساكر عن الزبير بن أبي هالة وفي آخره : والتابعين بإحسان . . .(@)(@@)(@@)(@@) $ ( 4193 ) قال النبي :(@)(@@) | 30 ( اللهم إنما أنا بشر فأيما رجل من المسلمين سببته أو لعنته أو جلدته 
ms443	 فاجعلها له زكاة ورحمة ) )(@)(@@) ( حم م ش ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4194 ) قال النبي :(@)(@@) | 30 ( اللهم إنما محمد بشر يغضب كما يغضب البشر ، وإني قد اتخذت عندك عهدا لن تخلفه ، فأيما مؤمن آذيته أو سببته أو جلدته فاجعلها له كفارة وقربة تقربه بها إليك يوم القيامة ) )(@)(@@) ( م ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4195 ) قال النبي :(@)(@@) | 30 ( اللهم إنما أنا بشر فأيما عبد من المؤمنين دعوت عليه بدعوة فاجعلها له زكاة ورحمة ) )(@)(@@) ( حم ) عن أبي الطفيل وامرأته سودة رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4196 ) قال النبي :(@)(@@) | 30 ( اللهم إنما أنا بشر أغضب كما يغضب البشر وأرضى PageV02P103 كما يرضى البشر ، فمن لعنته من أحد من أمتي فاجعلها له زكاة ورحمة ) )(@)(@@) ( طب ) عن أبي الطفيل رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4197 ) قال النبي :(@)(@@) | 30 ( اللهم ارزق آل محمد قوتا ) )(@)(@@) ( خ م ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4198 ) قال النبي :(@)(@@) | 30 ( اللهم ارزق آل محمد كفافا ) )(@)(@@) ( م ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4199 ) قال النبي :(@)(@@) | 30 ( اللهم إني أتخذ عندك عهدا تؤديه إلي يوم القيامة إنك لا تخلف الميعاد ، فإنما أنا بشر فأي المسلمين آذيته أو شتمته أو ضربته أو سببته فاجعلها له صلاة واجعلها له زكاة وقربة تقربه بها إليك يوم القيامة ) )(@)(@@) ( ش حم ) و عبد بن حميد وابن منيع ( ع ض ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4200 ) قال النبي :(@)(@@) | 30 ( اللهم إنما أنا بشر ، فأي رجل من المسلمين سببته أو لعنته أو جلدته فاجعلها له زكاة وأجرا ) )(@)(@@) ( ش حم ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4201 ) قال النبي :(@)(@@) | 30 ( اللهم ارزق آل محمد في الدنيا قوتا ) )(@)(@@) ( حم م ت ه ع هق ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4202 ) قال النبي :(@)(@@) | 30 ( اللهم إني أحب حسينا فأحبه وأحب من يحبه ) )(@)(@@) ( حم خ م ه ع ) عن أبي هريرة ( طب ) عن سعيد بن زيد ( طب ) وابن عساكر عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 4203 ) قال النبي :(@)(@@) | 30 ( اللهم إني أحبهما فأحبهما ، وأبغض من 
ms444	 أبغضهما يعني الحسن والحسين ) ، ( ش طب ) عن أ$ بي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4204 ) قال النبي :(@)(@@) | 30 ( اللهم إني أحبه فأحبه يعني الحسين ) )(@)(@@) ( ك ) عن PageV02P104 أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4205 ) قال النبي :(@)(@@) | 30 ( اللهم أهل بيتي وأنا مستودعهم كل مؤمن ) )(@)(@@) ابن عساكر عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4206 ) قال النبي :(@)(@@) | 30 ( اللهم بارك على آل فاتك كما أوى هاذا المصاب ) )(@)(@@) أبو عبيد وابن عساكر عن أيوب قال : نبئت أن رسول الله أتى على رجل قد قطعت يده في سرقة وهو في فسطاط فقال من آوى هاذا العبد المصاب ؟ قالوا فاتك أو خزيم بن فاتك قاتل فذكره .(@)(@@)(@@)(@@) $ ( 4207 ) قال النبي :(@)(@@) | 30 ( اللهم ضاجت بلادنا ، واغبرت أرضنا ، وهامت دوابنا ، اللهم منزل البركات من أماكنها ، وناشر الرحمة من معادنها بالغيث المغيث ، أنت المستغفر من الآثام فنستغفرك للجمات من ذنوبنا ، ونتوب إليك من عظيم خطايانا ، اللهم أرسل السماء علينا مدرارا والعا مغروا من تحت عرشك من حيث سقنا غيثا مغيثا دارعا رائعا ممرعا طبقا غدقا خصبا تسرع لنا به النبات ، وتكثر لنا البركات وتقبل به الخيرات ، اللهم إنك قلت في كتابك { وجعلنا من الماء كل شيء حي } اللهم فلا حياة لشيء خلق من الماء إلا بالماء ، اللهم وقد قنط الناس ، أو من قد قنط منهم وساء ظنهم ، وهامت بهائمهم ، وعجت عجيج الثكلى على أولادها إذ حبست عنا قطر السماء فدقت لذالك عظمها وذهب لحمها وذهب شحمها ، اللهم ارحم أنين الآنة وحنين الحانة ومن لا يحمل رزقه غيرك اللهم ارحم البهائم الحائمة والأنعام السائمة والأطفال الصائمة اللهم ارحم المشائخ الركع والأطفال الرضع والبهائم الرتع ، اللهم زدنا قوة إلى قوتنا ولا تردنا محرومين إنك سميع الدعاء برحمتك يا أرحم الراحمين ) )(@)(@@) الخطابي في غريب الحديث وابن عساكر عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4208 ) قال النبي :(@)(@@) | 30 ( اللهم انصر العباس وولد العباس ثلاثا ، يا عم أما علمت أن المهدي من ولدك موفقا راضيا مرضيا ) )(@)(@@) الهيثم بن كليب وابن عساكر عن PageV02P105 عبد الله بن عباس رضي الله 
ms445	 عنهما عن أبيه وسنده رجاله ثقات .(@)(@@)(@@)(@@) $ ( 4209 ) قال النبي :(@)(@@) | 30 ( اللهم استر العباس وولد العباس من النار ) )(@)(@@) الروياني والشاشي والخرائطي ( ك ) وتعقب وابن عساكر عن سهل بن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4210 ) قال النبي :(@)(@@) | 30 ( اللهم اغفر للعباس وولده مغفرة ظاهرة وباطنة لا تغادر ذنبا ، اللهم اخلفه أو احفظه في ولده ) )(@)(@@) ( ت ) حسن غريب ( ع ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4211 ) قال النبي :(@)(@@) | 30 ( اللهم إن عمي العباس حاطني بمكة من أهل الشرك ، وأخذ لييعلى الأنصار ، ونصرني في الإسلام مؤمنا بالله مصدقا بي ، اللهم فاحفظه وحطه واحفظ له ذريته من كل مكروه ) )(@)(@@) ابن عساكر عن محمد بن إبراهيم بن الحارث التميمي مرسلا .(@)(@@)(@@)(@@) $ ( 4212 ) قال النبي :(@)(@@) | 30 ( اللهم اغفر للعباس وولد العباس ولمن أحبهم ) )(@)(@@) الخطيب وابن عساكر عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4213 ) قال النبي :(@)(@@) | 30 ( اللهم اغفر للعباس وأبناء العباس وأبناء أبناء العباس ) )(@)(@@) ( طب ) عن سهل بن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4214 ) قال النبي :(@)(@@) | 30 ( اللهم اغفر للعباس ما أسر وما أعلن ، وما أبدى وما أخفى ، وما كان وما يكون منه ومن ذريته إلى يوم القيامة ) )(@)(@@) ابن عساكر عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4215 ) قال النبي :(@)(@@) | 30 ( اللهم إن جعفرا قدم إلي أحسن الثواب فاخلفه في ذريته بأحسن ما خلفت أحدا من عبادك في ذريته ) )(@)(@@) الواقدي وابن سعد وابن عساكر عن عبد الله بن جعفر بن سعد عن عامر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4216 ) قال النبي :(@)(@@) | 30 ( اللهم اخلف جعفرا في ولده ) )(@)(@@) ( طب ) و ابن عساكر PageV02P106 عن ابن عباس ( حم ) وابن عساكر عن عبد الله بن جعفر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4217 ) قال النبي :(@)(@@) | 30 ( اللهم اخلف جعفرا في أهله ، وبارك لعبد الله في صفقة يمينه ثلاث مرات ) )(@)(@@) ( ط ) و ابن سعد ( حم طب ك ) وابن عساكر عن عبد الله بن جعفر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4218 ) قال النبي :(@)(@@) | 30 ( اللهم اهدني فيمن هديت ، وعافني فيمن عافيت ، وتولني فيمن توليت ، وبارك لي فيما أعطيت ، وقني شر ما قضيت ، إنك تقضي 
ms446	 ولا يقضى عليك ، وإنه لا يذل من واليت ، تباركت ربنا وتعاليت ) )(@)(@@) ( ط ش حم دت ) حسن ( ن ه ) و الدرامي وابن الجارود وابن جزيمة ( ع ) وابن قانع ( حب طب ك ق ض ) عن السيد الحسن قال : علمني رسول الله كلمات أقولهن في الوتر فذكره ، وزاد ( طب هق ) ولا يعز من عاديت ( حم ) عن السيد الحسن الخطيب عن ابن عمر ( طس ) عن بريدة رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 4219 ) قال النبي :(@)(@@) | 30 ( اللهم أنت الصاحب في السفر والخليفة في الأهل ، اللهم اصحبنا بصحبته ، واقلبنا بذمة ، اللهم ارزقني قفل الأرض وهون علينا السفر ، اللهم إني أعوذ بك من وعثاء السفر وكآبة المنقلب ، اللهم ازو لنا الأرض وسيرنا فيها ) )(@)(@@) ( ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4220 ) قال النبي :(@)(@@) | 30 ( اللهم اجعلها حجة مبرورة متقبلة لا رياء فيها ولا سمعة ) )(@)(@@) ( عق ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4221 ) قال النبي :(@)(@@) | 30 ( اللهم إني أعوذ بك من شر الريح ومن شر ما تجيء به الريح ومن ريح الشمال فإنها الريح العقيم ) )(@)(@@) ( ك ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4222 ) قال النبي :(@)(@@) | 30 ( اللهم بارك له في صفقة يده ) )(@)(@@) قاله الح كيم بن حزام PageV02P107 ( طب ) عن حكيم رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4223 ) قال النبي :(@)(@@) | 30 ( اللهم آمن روعتي واستر عورتي واحفظ أمانتي ، واقض ديني ) )(@)(@@) ابن منده وأبو نعيم عن حنظلة بن علي الأسلمي مرسلا .(@)(@@)(@@)(@@) $ ( 4224 ) قال النبي :(@)(@@) | 30 ( اللهم الق طلحة يضحك إليك وتضحك إليه ) )(@)(@@) الباوردي والبغوي ( طب ) وأبو نعيم ( ض ) عن حصين بن وحوح يعني طلحة بن البراء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4225 ) قال النبي :(@)(@@) | 30 ( اللهم قد رضيت عن عثمان فارض عنه ثلاثا ) )(@)(@@) ابن عساكر عن عائشة أبو نعيم وابن عساكر عن أبي سعيد رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4226 ) قال النبي :(@)(@@) | 30 ( اللهم إن عثمان يترضاك فارض عنه ) )(@)(@@) ابن عساكر عن ليث بن أبي سليم مرسلا .(@)(@@)(@@)(@@) $ ( 4227 ) قال النبي :(@)(@@) | 30 ( اللهم جوزه على الصراط ) )(@)(@@) ابن عساكر عن زيد بن أسلم قال : بعث عثمان إلى النبي بناقة صهباء فقال فذكره 
ms447	 .(@)(@@)(@@)(@@) $ ( 4228 ) قال النبي :(@)(@@) | 30 ( اللهم اغفر لعثمان ما أقبل وما أدبر ، وما أخفى وما أعلن ، وما أسر وما جهر ) )(@)(@@) ( طس حل ) و ابن عساكر عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4229 ) قال النبي :(@)(@@) | 30 ( اللهم اجعل عبيدا أبا عامر فوق أكثر الناس يوم القيامة ) )(@)(@@) ابن سعد ( طب ) عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4230 ) قال النبي :(@)(@@) | 30 ( اللهم صل على عبيد أبي مالك واجعله فوق كثير من الناس ) )(@)(@@) ( حم ) عن أبي مالك الأشعري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4231 ) قال النبي :(@)(@@) | 30 ( اللهم اغفر لآل ياسر وقد فعلت ) )(@)(@@) ( حم ) و ابن سعد PageV02P108 عن عثمان بن عفان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4232 ) قال النبي :(@)(@@) | 30 ( اللهم بارك في عمار ، ويحك ابن سمية يقتلك الفئة الباغية ، وآخر زادك من الدنيا ضياح من لبن ) )(@)(@@) ابن عساكر عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 4233 ) قال النبي :(@)(@@) | 30 ( اللهم أخرج ما في صدر عمر من غل وداء وأبدله إيمانا ثلاثا ) )(@)(@@) ( ك ) وتعقب و ابن عساكر عن ابن عمر رضي الله عنهما أن رسول الله ضرب صدر عمر بيده حين أسلم وقال فذكره .(@)(@@)(@@)(@@) $ ( 4234 ) قال النبي :(@)(@@) | 30 ( اللهم صل على أبي بكر فإنه يحبك ويحب رسولك ، اللهم صل على أبي عبيدة بن الجراح فإنه يحبك ويحب رسولك ) )(@)(@@) ابن عساكر عن أبي مخامر السكسكي مرسلا وفيه انقطاع .(@)(@@)(@@)(@@) $ ( 4235 ) قال النبي :(@)(@@) | 30 ( اللهم اغفر لعمرو بن العاص ثلاثا ، كنت إذا ناديت للصدقة جاءني بها ) )(@)(@@) ( عد ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4236 ) قال النبي :(@)(@@) | 30 ( اللهم من آمن بي وصدقني وشهد أن ما جئت به الحق فأقل ماله وولده وعجل قبضه ، اللهم ومن لم يؤمن بي ولم يصدقني ولم يعلم أن ما جئت به الحق فأكثر ماله وولده وأطل عمره ) )(@)(@@) ( عد طب هب ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4237 ) قال النبي :(@)(@@) | 30 ( اللهم من ظلم أهل المدينة وأخافهم فأخفه وعليه لعنة الله والملائكة والناس أجمعين ، ل| ا يقبل الله منه صرفا ولا عدلا ) )(@)(@@) ( طب ) و ابن عساكر من عبادة بن الصامت رضي 
ms448	 الله عنه .(@)(@@)(@@)(@@) $ ( 4238 ) قال النبي :(@)(@@) | 30 ( اللهم علمه الكتاب والحساب ومكن له في البلاد ، وقه العذاب قاله لمعاوية ) )(@)(@@) ابن سعد ( طب ) وابن عساكر عن مسلمة بن مخلد رضي الله عنه .(@)(@@) PageV02P109(@)(@@)(@@)(@@) $ ( 4239 ) قال النبي :(@)(@@) | 30 ( اللهم علمه العلم واجعله هاديا مهديا واهده واهد به قاله لمعاوية ) )(@)(@@) ( حم ت ) وحسن غريب ( طس حل ) و تمام وابن عساكر عن عبد الرحمن بن أبي عمير المزني وابن عساكر عن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4240 ) قال النبي :(@)(@@) | 30 ( اللهم توفني إليك فقيرا ولا تتوفني غنيا ، واحشرني في زمرة المساكين يوم القيامة ، فإن أشقى الأشقياء من اجتمع عليه فقر الدنيا وعذاب الآخرة ) )(@)(@@) ( طس ) و أبو الشيخ في الثواب عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4241 ) قال النبي :(@)(@@) | 30 ( اللهم بارك لنا في تمرنا ، وبارك لنا في مدينتنا ، وبارك لنا في صاعنا ، وبارك لنا في مدنا ، اللهم إن إبراهيم عبدك وخليلك ونبيك ، وإني عبدك ونبيك ، وإنه دعك لمكة ، وإني أدعوك للمدينة بمثل ما دعاك به لمكة ومثله معه ) )(@)(@@) ( م ت ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4242 ) قال النبي :(@)(@@) | 30 ( اللهم إن إبراهيم نبيك وخليلك دعاك لأهل مكة ، وأنا نبيك ورسولك أدعوك لأهل المدينة ، اللهم بارك لهم في مدهم وصاعهم وقليلهم وكثيرهم ضعفي ما باركت لأهل مكة ، اللهم ارزقهم من هاهنا وهاهنا وأشار إلى نواحي الأرض كلها ، اللهم من أرادهم بسوء فأذبه كما يذوب الملح في الماء ) )(@)(@@) ابن عساكر عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4243 ) قال النبي :(@)(@@) | 30 ( اللهم إن إبراهيم خليلك وعبدك ونبيك دعاك لأهل مكة ، وأنا عبدك ورسولك أدعوك لأهل المدينة مثل ما دعاك إبراهيم لأهل مكة ، ندعوك أن تبارك لهم في صاعهم ومدهم وثمارهم ، اللهم حبب إلينا المدينة كما حببت إلينا مكة ، واجعل ما بها من وباء بخم ، اللهم إني قد حرمت ما بين لابتيها كما حرمت على لسان إبراهيم الحرم ) )(@)(@@) ( حم ) و الروياني ( ض ) عن أبي قتادة رضي الله عنه .(@)(@@) PageV02P110(@)(@@)(@@)(@@) $ ( 4244 ) قال النبي :(@)(@@) | 30 ( اللهم بارك لأهل المدينة في مدينتهم ، وبارك لهم 
ms449	 في صاعهم ، وبارك لهم في مدهم ، اللهم إن إبراهيم عبدك وخليلك وإني عبدك ورسولك ، وإن إبراهيم سألك لأهل مكة ، وإني أسألك لأهل المدينة كما سألك إبراهيم لأهل مكة ومثله معه ، ألا إن المدينة مشبكة بالملائكة ، على كل نقب منها ملكان يحرسانها لا يدخلها الطاعون ولا الدجال ، من أرادها بسوء أذابه الله كما يذوب الملح في الماء ) )(@)(@@) ( حم ع ك ض ) عن سعد بن أبي وقاص وأبي هريرة معا رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4245 ) قال النبي :(@)(@@) | 30 ( اللهم إن إبراهيم خليلك ونبيك ، وإنك حرمت مكة على لسان إبراهيم ، اللهم وأنا عبدك ونبيك وإني أحرم ما بين لابتيها ) )(@)(@@) ( ه ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4246 ) قال النبي :(@)(@@) | 30 ( اللهم متعني بسمعي وبصري واجعلهما الوارث مني ) )(@)(@@) ( طب ) عن عبد الله بن الشخير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4247 ) قال النبي :(@)(@@) | 30 ( اللهم لك الحمد حمدا كثيرا طيبا مباركا فيه ) )(@)(@@) ( حم طب ) عن ابن أبي أوفى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4248 ) قال النبي :(@)(@@) | 30 ( اللهم اغفر لي ذنبي ، ووسع لي في داري ، وبارك لي في رزقي ) )(@)(@@) فسئل عنهن فقال : وهل تركن من شيء ، ابن السني ( طب ) عن أبي موسى ا رضي الله عنه ( حم ) عن رجل من الصحابة .(@)(@@)(@@)(@@) $ ( 4249 ) قال النبي :(@)(@@) | 30 ( اللهم اجبر كسيرهم ، وآوي طريدهم ، وأرض بريهم ، ولا ترد منهم سائلا ) )(@)(@@) ( طب ) عن أبي عمران محمد بن عبد الله بن عبد الرحمن عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 4250 ) قال النبي :(@)(@@) | 30 ( اللهم اجعل له لسانا ذاكرا ، وقلبا شاكرا ، وارزقه حبي وحب من يحبني ، وصير أمره إلى خير ) )(@)(@@) ( طب ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4251 ) قال النبي :(@)(@@) | 30 ( اللهم انصر من نصر عليا ، اللهم أكرم من أكرم عليا ، اللهم اخذل من خذل عليا ) )(@)(@@) ( طب ) عن عمرو بن شراحيل .(@)(@@)(@@)(@@) $ ( 4252 ) قال النبي :(@)(@@) | 30 ( اللهم بارك لنا في شامنا ، اللهم بارك لنا في يمننا ، قالوا : وفي نجدنا ؟ قال : هناك الزلازل والفتن وبها يطلع قرن الشيطان ) )(@)(@@) ( حم خ ت ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4253 ) قال النبي 
ms450	 :(@)(@@) | 30 ( اللهم بارك لنا في صاعنا ومدنا ، وبارك لنا في مكتنا ومدينتنا ، وبارك لنا في شامنا ويمننا ، فقال رجل : وعراقنا ؟ قال : إن بها قرن الشيطان وتهيج الفتن ، وإن الجفا بالمشرق ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4254 ) قال النبي :(@)(@@) | 30 ( اللهم بارك على خيل أحمس ورجالها ) )(@)(@@) ( طب ض ) عن خالد بن عرفطة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4255 ) قال النبي :(@)(@@) | 30 ( اللهم أجرني من النار ، ويل لأهل النار ) )(@)(@@) ابن قانع وأبو نعيم عن عبد الرحمن بن أبي ليلى عن أبيه .(@)(@@)(@@)(@@) $ ( 4256 ) قال النبي :(@)(@@) | 30 ( اللهم أقبل بقلوبهم إلى دينك وحيط من ورائهم برحمتك ) )(@)(@@) ( طب ) و سمويه عن أنس رضي الله عنه قال : دعا رسول الله لامته قال فذكره .(@)(@@) PageV02P112(@)(@@)(@@)(@@) $ ( 4257 ) قال النبي :(@)(@@) | 30 ( اللهم لا أحل لهم أن يكذبوا علي ) )(@)(@@) ابن سعد عن المنقع بن الحصين التميمي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4258 ) قال النبي :(@)(@@) | 30 ( اللهم اغفر لعبد القيس إذ إسلموا طائعين غير مكرهين ، إذ بعض قوم لم يسلموا إلا خزايا موتورين ) )(@)(@@) ابن سعد ( طب ) عن أبي خيرة الصباحي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4259 ) قال النبي :(@)(@@) | 30 ( اللهم بارك فيهما وبارك عليهما وبارك لهما في نسلهما ) )(@)(@@) قاله لعلي وفاطمة ليلة البناء ، ابن سعد عن بريدة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4260 ) قال النبي :(@)(@@) | 30 ( اللهم عز حزنها ، واجبر مصيبتها وأبدلها بها خيرا منها ) )(@)(@@) ابن سعد عن صمرة بن حبيب مرسلا .(@)(@@)(@@)(@@) $ ( 4261 ) قال النبي :(@)(@@) | 30 ( اللهم اطو له البعيد وهون عليه السفر ) )(@)(@@) ( ت ) حسن ( ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4262 ) قال النبي :(@)(@@) | 30 ( اللهم أني أعوذ بك من الهم والكسل وعذاب القبر ) )(@)(@@) ( ت ) حسن غريب عن أبي بكرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4263 ) قال النبي :(@)(@@) | 30 ( اللهم استجب لسعد إذا دعاك ) )(@)(@@) ( ت حب ك ) عن سعد بن أبي وقاص رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4264 ) قال النبي :(@)(@@) | 30 ( اللهم استجب لسعد ، اللهم سدد لسعد رميته ، إيها سعد فداك أبي وأمي ) )(@)(@@) ( ك ) عن سعد بن أبي وقاص رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4265 ) قال النبي :(@)(@@) | 30 ( اللهم إنك أذقت قريشا نكالا 
