ms361	 منهم بشير بن سلام، وفي " تعق " على قول " صه " ضعيف فيه ما مر في الفوائد، وروى عنه جعفر بن بشير بواسطة حماد وصفوان بلا واسطة، مضافا إلى رواية كتابه جماعة.(@)(@@) أقول: لا اعتبار بهذه المقربات.(@)(@@)(@@)(@@) $ 4395 - صالح الخراساني " ق " عليه السلام.(@)(@@)(@@)(@@) $ 4396 - صالح بن رزين، كوفي روى عن " ق " عليه السلام ذكره أصحاب الرجال، روى عنه منصور بن يونس، له كتاب " جش " له أصل " ست " عنه الحسن بن محبوب فيهما.(@)(@@)(@@)(@@) $ 4397 - صالح بن سعد الجعفي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4398 - صالح بن سعيد، أبو سعيد القماط، كوفي " ق " " جش " مولى بني أسد كوفي، روى عن " ق " عليه السلام ذكره أبو العباس، له كتاب، عنه جماعة منهم عبيس بن هشام " جش " عنه إبراهيم بن هاشم " ست ".(@)(@@)(@@)(@@) $ 4399 - صالح بن سهل من أهل همدان، وقد يصغر أبوه، روى عن " ق " عليه السلام لا خير فيه ولا في سائر ما رواه، قال " غض ": انه كوفي غال كذاب وضاع للحديث، وهو غير صالح بن سهل المشار إليه في السابقة. والظاهر على ما في " صه " أنه الذي ذكره الشيخ من المذمومين بعنوان ابن محمد بن سهل.(@)(@@)(@@)(@@) $ 4400 - صالح بن صالح الهمداني الثوري كوفي، أخو الحسن بن صالح بن حي " ق ".(@)(@@)(@@)(@@) $ 4401 - صالح بن عبد الله الأحول الكوفي " ق ". PageV01P488(@)(@@)(@@)(@@) $ 4402 - صالح بن عبد الله الخثعمي الكوفي " ق " ولا يبعد كونه الخثعمي المتقدم عن " ضا " في السابقة وان احتمل التغاير قويا.(@)(@@)(@@)(@@) $ 4403 - صالح بن عقبة " قر " ابن عقبة من أصحاب " ق " عليه السلام " ظم " عليه السلام وهو غير خارج عن الآتيين، على ما ذكره الميرزا.(@)(@@)(@@)(@@) $ 4404 - صالح بن عقبة بن خالد الأسدي، له كتاب، محمد بن إسماعيل بن بزيع عن محمد بن أيوب عنه " جش " أقول: وهذا مجهول، وعلي أخوه ثقة يروي عن أبيه في ترجمته.(@)(@@)(@@)(@@) $ 4405 - صالح بن عقبة بن قيس بن سمعان بن أبي ربيعة، مولى رسول الله صلى الله عليه وآله في " صه " " جش " روى عن " ق " عليه السلام كذاب غال لا يلتفت إليه " صه " وما 
ms362	 فيها من " غض " والظاهر أنه للأخبار الدالة على جلالة قدر الأئمة، وليس فيها غلو على ما نقل في " تعق " عن جده.(@)(@@)(@@)(@@) $ 4406 - صالح بن عمار الجهني " ق " " جخ ".(@)(@@)(@@)(@@) $ 4407 - صالح بن مسلم الجعفي، مولاهم كوفي " ق ".(@)(@@)(@@)(@@) $ 4408 - صالح بن منصور بن عبد الله بن جعفر بن أبي طالب، أسند عنه " ق " والظاهر أنه في التالية بملاحظة الآبار.(@)(@@)(@@)(@@) $ 4409 - صالح بن موسى الطلحي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4410 - صالح النيلي وهو ابن الحكم، وهو ضعيف وقد تقدم.(@)(@@)(@@)(@@) $ 4411 - صالح بن زيد الفنكي أو العتكي " ق " وفي " قي " ابن يزيد العكي.(@)(@@)(@@)(@@) $ 4412 - صايد النهدي، روى " كش " عن معد عن " ق " عليه السلام مسندا أنه لعنه ومحمد بن خالد لا يحضرني حاله " صه " أقول: وفي السند محمد بن خالد وأشار إليه وفي " طس " روى عنه عليه السلام لعنه، وفي الوجيزة ضعيف.(@)(@@)(@@)(@@) $ 4413 - صامت بن محمد الجعفي، مولاهم الكوفي " ق ".(@)(@@)(@@)(@@) $ 4414 - صباح الأزرق، يروي عنه صفوان بن يحيى، والظاهر ابن عبد الحميد " تعق ". PageV01P489(@)(@@)(@@)(@@) $ 4415 - صباح الحذاء الكوفي " ق " له كتاب، عنه عبيس " ست " وربما احتمل أن يكون ابن صبيح الحذاء، وجزم في " تعق " باتحاده كالنقد والحاوي الا أنه ذكر على حدة في بعض الكتب، وهو سهو.(@)(@@)(@@)(@@) $ 4416 - صباح بن سيابة الكوفي " ق " وفي " تعق " يروي جعفر بن بشير عن حماد بن عيسى عنه، وهو أخو عبد الرحمن بن سيابة. وفي الكافي رواية تدل على كونه من خواص الشيعة، وكذا في آخر الروضة. وحسنه خالي لان للصدوق طريقا إليه.(@)(@@)(@@)(@@) $ 4417 - صباح بن صبيح الحذاء الفزاري مولاهم، امام مسجد دار اللؤلؤ، ثقة عين روى عن " ق " عليه السلام له كتاب، عنه عبيس وغيره، وقد تقدم الحذاء وتكرره في " ق " دال على التغاير.(@)(@@)(@@)(@@) $ 4418 - صباح الطنافس، يروي عنه ابن أبي عمير بواسطة ابنه عبد الوهاب " تعق ".(@)(@@)(@@)(@@) $ 4419 - صباح بن عبد الحميد الأزرق الكوفي " ق " وفي " تعق " مضى في إبراهيم بن عبد الحميد عن " جش " أخوه صباح وإسماعيل، والظاهر أنه الأزرق، وقد أشار إليه في ترجمته، وهو غير معلوم.(@)(@@)(@@)(@@) $ 4420 
ms363	 - صباح بن عمارة الصيداوي الأسدي، مولاهم كوفي " ق ".(@)(@@)(@@)(@@) $ 4421 - صباح بن محمد الزعفراني الكوفي " ق ".(@)(@@)(@@)(@@) $ 4422 - صباح المدائني " ق " ولم يعرف نسبه ولا وصفه الموجب للرد والقبول اجتهادا، فيرد قوله فقاهة كأضرابه.(@)(@@)(@@)(@@) $ 4423 - صباح بن موسى الساباطي " ق " أخو عمار، ثقة الا أنه امامي وليس فطحيا كأخيه قاله " شه " وعن ظاهر " ق " ولكن المولى البهبهاني في " تعق " قال ما فيه انهم من الثقات في الرواية، ثم تنظر في إفادته التوثيق الاصطلاحي، فتأمل.(@)(@@)(@@)(@@) $ 4424 - صباح مولى " ق " عليه السلام " قي ".(@)(@@)(@@)(@@) $ 4425 - صباح مولى بني هاشم " ق ".(@)(@@)(@@)(@@) $ 4426 - صباح مولى عثمان بن جبير، روى عن يونس بن يعقوب " قي " PageV01P490(@)(@@) " ق ".(@)(@@)(@@)(@@) $ 4427 - صباح بن واقد الأنصاري " قي " الظاهر أنه في هذه الطبقة، ويحتمل كونه في السابقة.(@)(@@)(@@)(@@) $ 4428 - صبيح أبو الصباح مولى بسام " ق " مولى بسام بن عبد الله الصيرفي، له كتاب، عنه جماعة منهم صفوان بن يحيى " جش " وفي " تعق " فيه شهادة بالوثاقة، وفي " مشكا " عنه صفوان، وابن أبي عمير، والقاسم بن إسماعيل.(@)(@@)(@@)(@@) $ 4429 - صبيح الصائغ أبو علي كوفي ثقة " صه " " جش " له كتاب، عنه محمد بن بكر بن جناح " جش " ويحتمل كونه في السابقة.(@)(@@)(@@)(@@) $ 4430 - صبيح بن عمرو البندي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4431 - صبيح الغرشي الكوفي، أسند عنه " ق " وعن نسخة العرسي.(@)(@@)(@@)(@@) $ 4432 - صدقة الأحدب " ق " غير معروف الحال مردود القول على مذهب المختار، نعم في التهذيب، رواية تدل على أنه منا، ولكن قال بعض: انه يشعر بأنه ليس منا، فلاحظ.(@)(@@)(@@)(@@) $ 4433 - صدقة بن عمير القماط الكوفي " ق ".(@)(@@)(@@)(@@) $ 4434 - صدقة بن مسلم الفزاري الكوفي " ق ".(@)(@@)(@@)(@@) $ 4435 - صدقة بن يزيد الكوفي مولى " ق ".(@)(@@)(@@)(@@) $ 4436 - صديق بن عبد الله الكوفي " ق ".(@)(@@)(@@)(@@) $ 4437 - صفوان بن مهران بن المغيرة الأسدي مولاهم، ثم مولى بني كاهل، أبو محمد الجمال، ثقة روى عن " ق " عليه السلام، وعنه السندي، وابن قضاعة، وقال " ظم " عليه السلام: كل منك حسن ما خلا الاكراء من هارون، فباع جماله.(@)(@@)(@@)(@@) $ 4438 - صفير مولى " ق " عليه السلام، ويأتي في معتب ذمه " تعق " والظاهر أنه بالغين المعجمة، 
ms364	 وانما تبع رحمه الله المولى عناية الله، وفي " كش " ذكر عن " ق " حديثا في مواليه إلى أن قال: وفيهم خائن فاحذروه وهو صغير، وجعله في المنتهى بالغين مستفادا من كتب الرجال بأسرها. والظاهر أنهما جعلاه اسما للخائن الذي أمر عليه PageV01P491(@)(@@) السلام بالحذر منه، وهو محل تأمل.(@)(@@)(@@)(@@) $ 4439 - صمد أبو محمد " ق ".(@)(@@)(@@)(@@) $ 4440 - ضابي بن عمر السعدي الأموي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4441 - الضحاك أبو مالك الحضرمي كوفي " ق " " جش " " صه " عربي أدرك " ق " عليه السلام وقد قيل: روى عنه، وقال آخرون: لم يرو عنه روى عن " ظم " عليه السلام وكان متكلما ثقة، فهو في السابقة، عنه الطاطري " جش ".(@)(@@)(@@)(@@) $ 4442 - الضحاك بن الأشعث " ق ".(@)(@@)(@@)(@@) $ 4443 - الضحاك بن زيد، ويروي عنه أحمد بن أبي نصر، كما في طرق الروايات، وهو لا يروي الا عن ثقة، كما في العدة، مضافا إلى اجماع العصابة على تصحيح ما يصح عنه، وما توهمه البعض بأنه أبو مالك الحضرمي كما في " ك " وتبعه المولى البهبهاني في حواشيه لا وجه له.(@)(@@)(@@)(@@) $ 4444 - الضحاك بن سعد الواسطي، عنه إبراهيم بن سلميان " ست " " جش " " لم " له كتاب " ست " والثاني وفي " د " الضحاك بن سعد الواسطي أبو عاصم النيلي الشيباني " لم " " جش " عامي.(@)(@@)(@@)(@@) $ 4445 - الضحاك. بن محمد بن الشيبان، أبو عاصم النبيل الشيباني البصري عامي " صه " وزاد " جش " روى عن جعفر كتابا رواه هارون بن مسلم، ويظهر منهما أن الكنية واللقب المذكورين له لا للسابق، خلافا لما نقله " د " عن " جش ".(@)(@@)(@@)(@@) $ 4446 - الضحاك بن مخلد الشيباني أبو عاصم البصري النبيل " ق " واستظهر الميرزا أنه المتقدم، وظني أن التعدد قوي لاختلاف الآباء.(@)(@@)(@@)(@@) $ 4447 - الضحاك بن عمارة الكوفي " ق ".(@)(@@)(@@)(@@) $ 4448 - الضحاك بن النعمان الجابري الهمداني الكوفي " ق ".(@)(@@)(@@)(@@) $ 4449 - ضريس بن عبد الملك بن أعين الشيباني الكوفي أبو عمارة، وأخوه علي " ق " وانما سمي بالكناسي لان تجارته بالكناسة، وكانت تحته بنت حمران، وهو PageV01P492(@)(@@) خير فاضل ثقة " كش " عنه " صه ".(@)(@@)(@@)(@@) $ 4450 - ضريس بن عبد الواحد بن المختار الكناسي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4451 - ضريس الوابشي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4452 - طالب 
ms365	 بن عمير الحنفي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4453 - طالب بن هارون بن عمير النخعي، أبو سالم الكوفي، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 4454 - طاهر مولى أبي عبد الله عليه السلام " ق ".(@)(@@)(@@)(@@) $ 4455 - طربال بن جميل الكوفي " ق ".(@)(@@)(@@)(@@) $ 4456 - طربال بن رجاء الكوفي " ق ".(@)(@@)(@@)(@@) $ 4457 - طريف بن سنان الثوري الكوفي " ق ".(@)(@@)(@@)(@@) $ 4458 - طعمة بن غيلان الجعفي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4459 - الطفيل بن مالك بن المقداد النخعي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4460 - طلاب بتشديد الام ابن حوشب بالشين المعجمة ابن يزيد بن الحارث، كوفي ثقة، روى عن جعفر بن محمد عليهما السلام كتابا " صه " وزاد " جش " بعد ذكر نسبه إلى شيبان بن رويم عنه الحسين بن محمد بن علي الأزدي وفي " ق " ابن حوشب الشيباني الكوفي يكنى أبا رويم.(@)(@@)(@@)(@@) $ 4461 - ظريف بن ناصح بياع الأكفان، أصله كوفي نشأ ببغداد، وكان ثقة في حديثه صدوق، له كتب، عنه ابنه الحسن " جش " الحسن بن علي بن فضال " ست ".(@)(@@)(@@)(@@) $ 4462 - ظهير بن عمارة البارقي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4463 - ظهير والد الحكم بن ظهير الفزاري كوفي " ق ".(@)(@@)(@@)(@@) $ 4464 - عاصم بن حفص الكوفي أبو عمرو الوابشي، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 4465 - عاصم بن حميد الحناط الكوفي، مولى بني حنيفة، مات بالكوفة، ثقة عين صدوق، روى عن " ق " عليه السلام، له كتاب، عنه محمد بن عبد الحميد والسندي بن محمد، وعبد الرحمن بن أبي نجران " ست ". PageV01P493(@)(@@)(@@)(@@) $ 4466 - عاصم بن زكير الحنفي كوفي " ق ".(@)(@@)(@@)(@@) $ 4467 - عاصم بن سليمان البصري يعرف بالكوزي " ق " كما يأتي عن " صه " و " جش " بنو كوز بالضم بطن في بني أسد وكوز بن كعب بطن في بني ضبة.(@)(@@)(@@)(@@) $ 4468 - عاصم بن عمر بن حفص بن عاصم بن عمر بن الخطاب القرشي المدني " ق " وفي الكافي في الصحيح عن زرارة أنه قال قال رجل من بجيلة يقال له عاصم بن عمر لأبي جعفر عليه السلام: ان كعب الأحبار يقول: إن الكعبة كمسجد لبيت المقدس في كل غداة، فقال: كذبت وكذب كعب الأحبار وغضب، قال: ما رأيته استقبل أحدا كذبت غيره.(@)(@@)(@@)(@@) $ 4469 - عاصم الكوزي من كوز 
ms366	 ضبة، وقيل: إنه من كوز بني مالك بن أسد ثقة، روى عن جعفر بن محمد عليهما السلام " صه " وزاد " جش " له كتاب، سليمان بن سماعة الحذاء عن عمه عاصم بكتابه، وقد مضى عن " ق " ابن سليمان، وفي " مشكا " عاصم الكوزي ابن سليمان، عنه سليمان بن سماعة.(@)(@@)(@@)(@@) $ 4470 - عاصم بن محمد الكوفي " ق ".(@)(@@)(@@)(@@) $ 4471 - عاصم بن واقد المزني " ق ".(@)(@@)(@@)(@@) $ 4472 - عامر بن جذاعة، له كتاب، عنه القاسم بن إسماعيل، وإبراهيم بن سليمان الخزاز، وعن " كش " دعاء الصادق عليه السلام بعدم المغفرة، وعنه أيضا أنه من حواري " قر " و " ق " عليهما السلام فللتوقف مجال.(@)(@@)(@@)(@@) $ 4473 - عامر بن حميد الحضرمي " ق ".(@)(@@)(@@)(@@) $ 4474 - عامر بن السبط التميمي الخزامي الكوفي، تابعي أسند عنه " ق " وفي " تعق " يظهر من بعض الأخبار كونه موافقا، وفي المنتهى توهم اتحاده مع ابن السمط الآتي.(@)(@@)(@@)(@@) $ 4475 - عامر بن سلمة البكري الكوفي " ق ".(@)(@@)(@@)(@@) $ 4476 - عامر بن سويد الحجوجي " ق ".(@)(@@)(@@)(@@) $ 4477 - عامر بن عبد الله بن جذاعة الأزدي عربي " جش " كوفي " ق " روى PageV01P494(@)(@@) عنه عليه السلام له كتاب، والظاهر من " جش " و " صه " أنه ابن جذاعة حيث أشير فيها بالنقل فيه من القدح والذم، فتأمل فيهما.(@)(@@)(@@)(@@) $ 4478 - عامر بن عمير " ق ".(@)(@@)(@@)(@@) $ 4479 - عامر بن نعيم القمي، روى الصدوق في الحسن عن ابن أبي عمير عنه، وفي " تعق " فيه شهادة على الوثاقة، ويروي عنه أيضا حماد بن عثمان، وعده خالي من الحسان. أقول: وقد مر عنه غير مرة أنه جعل في رواية ابن أبي عمير عنه أشعارا بالوثاقة، وهنا جعله شهادة عليها والتفاوت ظاهر، وإن كان ذلك مطابقا للمختار.(@)(@@)(@@)(@@) $ 4480 - عائذ الأحمسي " ين " ويأتي عن " ق " ابن نباته، كذا ذكره الميرزا فيه اشعار بأنه هو الا أن الشيخ أبا علي استظهر كونه ابن حبيب مستشهدا بكلام الصدوق في مشيخته من تلقبه بالحمسي، ثم احتمل اتحاد الكل بكون أحدهما نسبة إلى الجد، فتأمل. أقول: وللتأمل مجال وما في مشيخة الصدوق لعله العبسي وغيره الناسخ بالأحمسي.(@)(@@)(@@)(@@) $ 4481 - عائذ بن حبيب، أبو أحمد العبدي أو العبسي 
ms367	 الكوفي " ق " وفي " تعق " مر في حبيب ما يؤمي إلى معروفيته، وفي أخيه الربيع أنهما عربيان انتهى. أقول: إنه لم يذكر فيه الا أنه ولد عائذ، وكذا ما ذكره في أخيه، إذ لا جدوى لهما في خروجه عن المجهولية.(@)(@@)(@@)(@@) $ 4482 - عائذ بن مدرك النخعي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4483 - عائذ بن نباتة الأحمسي الكوفي بياع الهروي " ق " ومضى بعنوان الأحمسي على ما فهمه الميرزا، وبعنوان ابن حبيب على ما احتمله الشيخ أبو علي طاب ثراه.(@)(@@)(@@)(@@) $ 4484 - عباد بن بكير، حكي فيه حديثا حين دخوله على الصادق عليه السلام وعليه ثياب شهرة غلاظ، فقال عليه السلام: يا عباد ما هذه الثياب؟ إلى أن قال: من لبس ثياب شهرة ألبسه الله ثياب الذل يوم القيامة الحديث. فهذا: اما ابن حبيب فبتري، واما هو فعامي. PageV01P495(@)(@@)(@@)(@@) $ 4485 - عباد بن الربيع البجلي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4486 - عباد بن زياد الكلبي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4487 - عباد بن سالم " ق ".(@)(@@)(@@)(@@) $ 4488 - عباد بن سليمان، عنه محمد بن خالد البرقي بكتابه، وهو في السابقة أيضا، وفي " تعق " روى عنه محمد بن أحمد بن يحيى ولم يستثن روايته، ويروي عنه الأجلة كالصفار، ومحمد بن الحسين، وأحمد بن محمد بن عيسى وغيرهم.(@)(@@)(@@)(@@) $ 4489 - عباد بن سليمان، روى عن محمد بن سليمان الديلمي، روى عنه الصفار " لم " وكأنه أيضا في السابقة، والظاهر الاتحاد مع السابق.(@)(@@)(@@)(@@) $ 4490 - عباد بن صهيب المازني الكلبي اليربوعي بصري " ق " ابن صهيب عامي " كش " بتري قاله " كش " " صه " الا أن ما في " كش " قال نصر: عباد بتري، واستظهر منه أنه في عباد بن بكير، وعن " جش " ثقة روى عن " ق " عليه السلام عنه ابن محبوب وابن مسلم (1).(@)(@@)(@@)(@@) $ 4491 - عباد بن عمران الأنصاري مولاهم كوفي " ق ".(@)(@@)(@@)(@@) $ 4492 - عباد بن عمران التغلبي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4493 - عباد بن كثير البصري، مر ما فيه في عباد بن صهيب " تعق " أقول:(@)(@@) قد ذكر فيه بعد ترجيح كون ابن صهيب عاميا الا أنه ليس صاحب الحديثين.(@)(@@) بلا شبهة، فإنه ابن كثير الصوفي المرائي المشهور الضعيف جدا، وكتب 
ms368	 الاخبار مشحونة من ذمه فلاحظ، ولعل الصواب ما فعله العلامة المجلسي حيث حكم بكون بن كثير ضعيفا وابن صهيب موثقا.(@)(@@)(@@)(@@) $ 4494 - عباد بن موهب الكوفي " ق ".(@)(@@)(@@)(@@) $ 4495 - عباس بن جعفر بن محمد بن علي بن الحسين بن علي بن أبي طالب عليهم السلام كان فاضلا نبيلا، كذا في الارشاد، عنه الشيخ أبو علي في المنتهى.(@)(@@) PageV01P496(@)(@@)(@@)(@@) $ 4496 - عباس بن عائذ الكوفي مولى همدان " ق ".(@)(@@)(@@)(@@) $ 4497 - عباس بن عبد الرحمن الصائغ الكوفي " ق ".(@)(@@)(@@)(@@) $ 4498 - عباس بن عتبة اللهبي الكندي " ق ".(@)(@@)(@@)(@@) $ 4499 - عباس بن عطية العامري الكوفي، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 4500 - عباس بن عمير " ق ".(@)(@@)(@@)(@@) $ 4501 - عباس بن عوف العبدي البصري " ق " قد توهم بعض أنه عياش لا عباس لوجوده كذا في بعض الطرق، كطريق " ست " إلى ثابت بن دينار.(@)(@@)(@@)(@@) $ 4502 - عباس بن الوليد بن صبيح، كوفي ثقة، روى عن " ق " عليه السلام " صه " " جش " عنه صفوان بن يحيى، والحسن بن محبوب، وقد مر في السابقة.(@)(@@)(@@)(@@) $ 4503 - عباس بن يحيى الجعفري المدني " ق ".(@)(@@)(@@)(@@) $ 4504 - عبد الاعلى بن أعين العجلي، مولاهم الكوفي " ق " والظاهر أنه ضعيف من السابقة، مولى بني شيبان، كذا ذكره البعض، وفي " تعق " الظاهر بن المفيد أنه من فقهاء أصحاب الأئمة عليهم السلام.(@)(@@)(@@)(@@) $ 4505 - عبد الاعلى بن زيد، أبو شاكر العبدي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4506 - عبد الاعلى بن علي بن أبي شعبة، أخو محمد بن علي الحلبي، ثقة لا يطعن عليه " صه " " جش " في أخيه محمد كما يأتي.(@)(@@)(@@)(@@) $ 4507 - عبد الاعلى بن كثير البصري الكوفي أبو عامر، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 4508 - عبد الاعلى مولى آل سام الكوفي " ق " روى عنه سيف بن عميرة، قال للصادق عليه السلام ان الناس يعيبون علي بالكلام وأنا أكلم الناس، فقال: أما مثلك من يقع ثم يطير فنعم (1)، وأما من يقع ثم لا يطير فلا " كش ".(@)(@@)(@@)(@@) $ 4509 - عبد الاعلى بن الوضاح الأزدي الكوفي " ق ".(@)(@@) PageV01P497(@)(@@)(@@)(@@) $ 4510 - عبد الاعلى بن يزيد الجهني الكوفي " ق ".(@)(@@)(@@)(@@) $ 4511 - عبد الباهر بن محمد بن قيس الأسدي الكوفي " ق " وعن نسخة أصح عبد القاهر 
ms369	 كما يأتي.(@)(@@)(@@)(@@) $ 4512 - عبد الجبار بن عباس الهمداني الشبامي " ق " وفي " تعق " بعد ترجمة شبام كما يأتي في الألقاب النسبية قال: ولا يخفى أنه يظهر منه أنه من المحدثين المعروفين المتصلبين في التشيع لأنه من الغلات.(@)(@@)(@@)(@@) $ 4513 - عبد الجبار بن مسلم العبدي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4514 - عبد الحميد بن أبي جعفر الفراء الفزاري، مولاهم الكوفي " ق ".(@)(@@)(@@)(@@) $ 4515 - عبد الحميد بن أبي العلاء الأزدي الخفاف الكوفي " ق " وفي " تعق " مر في الحسين بن أبي العلاء وجاهته، وعن المصنف وغيره اتحاده مع السمين الثقة، وظاهر هنا التعدد، ومر فيه وفي خالد بن طهمان ما ينبغي أن يلاحظ، فلاحظ وسيجئ في الكنى.(@)(@@)(@@)(@@) $ 4516 - عبد الحميد بن أبي العلاء الأزدي السمين الكوفي، ثقة يقال له:(@)(@@) السمين، روى عن " ق " عليه السلام له كتاب، عنه ابن أبي عمير " جش " قد عرفت من " تعق " اتحاده مع الخفاف، واستظهره في النقد وعن تصريح المجمع، ولا يخلو من تأمل.(@)(@@)(@@)(@@) $ 4517 - عبد الحميد بن بكير بن أعين الشيباني، مولاهم كوفي " ق ".(@)(@@)(@@)(@@) $ 4518 - عبد الحميد الزطي " ق ".(@)(@@)(@@)(@@) $ 4519 - عبد الحميد بن جابر الأزدي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4520 - عبد الحميد بن خالد بن طهمان، هو ابن أبي العلاء " تعق " أقول:(@)(@@) لا وجه الا في الاشتراك في كنيته والتلقيب بالخفاف. والظاهر أن هذا اشتباه، إذ خالد بن طهمان المكنى بابن العلاء من السلولي كما مر وابن أبي العلاء أزدي، وهو من طوائف أهل سبا المتفرقة في اليمن والشامات، وسلول قبلية من هوازن.(@)(@@)(@@)(@@) $ 4521 - عبد الحميد بن زياد الكوفي، أسند عنه " ق ". PageV01P498(@)(@@)(@@)(@@) $ 4522 - عبد الحميد بن سعد، روى عنه صفوان بن يحيى " قي " مولى " ق " بجلي كوفي " جش " وفي رواية صفوان عنه اشعار على وثاقته.(@)(@@)(@@)(@@) $ 4523 - عبد الحميد بن عبد الحكيم الكوفي " ق ".(@)(@@)(@@)(@@) $ 4524 - عبد الحميد العطار الكوفي، أسند عنه " ق " والظاهر أنه ابن سالم العطار المشار إليه في الطبقة السابقة الذي يروي عن " ظم " عليه السلام فهو ثقة كما مر.(@)(@@)(@@)(@@) $ 4525 - عبد الحميد بن فرقد الأسدي، مولى كوفي " ق ".(@)(@@)(@@)(@@) $ 4526 - عبد الحميد الكندي الكوفي 
ms370	 " ق ".(@)(@@)(@@)(@@) $ 4527 - عبد الحميد بن مسلم الأزدي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4528 - عبد الحميد بن المعلى الكوفي، ثم عبد الحميد بن المعلى " ق " وقد ذكر عنه هكذا بلا فصل، والظاهر الاتحاد، فتأمل.(@)(@@)(@@)(@@) $ 4529 - عبد الخالق بن حبيب الصيرفي، أخو ميثم بن حبيب الصيرفي كوفي " ق ".(@)(@@)(@@)(@@) $ 4530 - عبد الخالق بن دينار الخزاعي، مولاهم الكوفي " ق ".(@)(@@)(@@)(@@) $ 4531 - عبد الخالق الصيقل الكوفي " ق " روى عنه " ق " عليه السلام.(@)(@@)(@@)(@@) $ 4532 - عبد الخالق بن عبد ربه، من صلحاء الموالي، معد عن عبد الله بن محمد، عن أبيه، عن أبيه إسماعيل بن عبد الخالق، قال: ذكر أبو عبد الله عليه السلام أبي، فقال: صلى الله على أبيك ثلاثا " كش " واستظهر الميرزا أنه " ق " عليه السلام، وعبد الله ثقة، أبوه غير معلوم، فلو ثبت توثيقه فيثمر.(@)(@@)(@@)(@@) $ 4533 - عبد الخالق بن محمد البناني الكوفي، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 4534 - عبد ربه ابن ميمونة بن يسار الأسدي، مولى كوفي والد شهاب " ق ".(@)(@@) والظاهر أنه في الطبقة الآتية.(@)(@@)(@@)(@@) $ 4535 - عبد الرحمن بن أبي الصيرفي المرادي الكوفي مولى " ق ". PageV01P499(@)(@@)(@@)(@@) $ 4536 - عبد الرحمن بن أبي الحسين " ق ".(@)(@@)(@@)(@@) $ 4537 - عبد الرحمن بن أبي عبد الله ميمون، من أهل البصرة ختن ابن يسار، ثقة، روى عن ابن سلمة، وخالد الحذاء، وشعبة، وعوف، وكثير النوى بعنوان الكنية، روى عن أبي وعبد الله أبناء عباس وعمر وبريدة والبراء بن عازب، قال " عق " روى عن " ق " عليه السلام سبعمائة مسألة.(@)(@@)(@@)(@@) $ 4538 - عبد الرحمن بن أبي العطار الخياط " ق ".(@)(@@)(@@)(@@) $ 4539 - عبد الرحمن بن أبي عمارة الطحان أو القطان الهمداني، مولى كوفي " ق ".(@)(@@)(@@)(@@) $ 4540 - عبد الرحمن بن أبي الموالي، مولى بني هاشم " ق ".(@)(@@)(@@)(@@) $ 4541 - عبد الرحمن بن أحمر العجلي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4542 - عبد الرحمن الأسود أبو عمرو اليشكري الكوفي، مات سنة سبع وستين ومائة، وعاش خمس وسبعون سنة.(@)(@@)(@@)(@@) $ 4543 - عبد الرحمن بن بدر أبو إدريس، كوفي ثقة، ليس بالمتحقق بنا " صه " " جش " مع زيادة، وقد روى أحاديث، له كتاب، عنه يحيى بن زكريا اللؤلؤي، ولا يبعد قبول حديثه، إذ ذكره في الحاوي 
ms371	 في الموثقين، وعن الوجيزة والبلغة أنه ثقة، والقياس بسليمان المنقري فاسد، كما لا يخفى.(@)(@@)(@@)(@@) $ 4544 - عبد الرحمن بن بشير التغلبي الكوفي مولاهم " ق ".(@)(@@)(@@)(@@) $ 4545 - عبد الرحمن بن بكير الكوفي " ق ".(@)(@@)(@@)(@@) $ 4546 - عبد الرحمن بن الحجاج البجلي، مولاهم كوفي بياع السابري، أستاد صفوان بن يحيى " ق " ثقة ثقة ثبت عين وكيل للصادق عليه السلام روى عنه وعن " ظم " عليهما السلام ولقى الرضا عليه السلام ومات في عصره، عنه صفوان وابن أبي عمير.(@)(@@)(@@)(@@) $ 4547 - عبد الرحمن بن حميد الكلابي الرواسي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4548 - عبد الرحمن الخثعمي، يروي عنه عبد الله بن المغيرة، وفي روايته PageV01P500(@)(@@) عنه اشعار بالوثاقة.(@)(@@)(@@)(@@) $ 4549 - عبد الرحمن بن زياد القصير الصيقل " ق ".(@)(@@)(@@)(@@) $ 4550 - عبد الرحمن بن زيد أبي زيد الجرشي، مولى كوفي " ق ".(@)(@@)(@@)(@@) $ 4551 - عبد الرحمن بن زيد بن أسلم التنوخي المدني الكوفي " ق ".(@)(@@)(@@)(@@) $ 4552 - عبد الرحمن بن سالم بن عبد الرحمن الأشل، كوفي روى عنهما عليهما السلام، وأخوه عبد الحميد، وفي " جش " و " لم " ضعيف، وأبوه ثقة، وفي " تعق " يروي عنه ابن أبي نضر في الصحيح، وفيها شهادة بالوثاقة، وتضعيف " صه " من " غض " كما صرح به في النقد، فلا عبرة به، وفي " مشكا " عنه ابن جعفر، واحمد، وابنا أبي حمزة وعلي.(@)(@@)(@@)(@@) $ 4553 - عبد الرحمن السراج، يروي عنه ابن أبي عمير " تعق " وقد مر غير مرة أن رواية ابن أبي عمير دليل على الوثاقة.(@)(@@)(@@)(@@) $ 4554 - عبد الرحمن بن سويد الكلبي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4555 - عبد الرحمن بن سيابة الكوفي البجلي البزاز مولى، أسند عنه " ق " وروى أنه أعطاه دنانير في عيالات من قتل مع زيد، عنه ابن أبي عمير، وأبو عبد الله البرقي، وموسى بن القاسم.(@)(@@)(@@)(@@) $ 4556 - عبد الرحمن بن عباد البصري " ق ".(@)(@@)(@@)(@@) $ 4557 - عبد الرحمن بن عبد العزيز الأنصاري الامامي المدني، من ولد أبي أمامة بن سهل بن حنيف، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 4558 - عبد الرحمن بن عبيد الأسدي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4559 - عبد الرحمن بن عبيد المزني الكوفي " ق ".(@)(@@)(@@)(@@) $ 4560 - عبد الرحمن بن عتيك، يأتي في عبد الرحيم القصير " تعق 
ms372	 " أقول:(@)(@@) الذي يأتي فيه كونه هو، وهو بعيد.(@)(@@)(@@)(@@) $ 4561 - عبد الرحمن بن عثمان، أبو يحيى البكرواني البصري " ق ".(@)(@@)(@@)(@@) $ 4562 - عبد الرحمن بن العطار المكي " ق ". PageV01P501(@)(@@)(@@)(@@) $ 4563 - عبد الرحمن بن عمران، كوفي له كتاب، عنه إبراهيم بن سليمان " جش " غير كوفي " ست " ويحتمل كونه في الطبقة الآتية بملاحظة الراوي.(@)(@@)(@@)(@@) $ 4564 - عبد الرحمن بن كثير القرشي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4565 - عبد الرحمن بن كثير الهاشمي، ضعيف غمز عليه كما في " صه " و " جش " بل فيهما يضع الحديث، عنه علي بن حسان، وفي " تعق " استظهر كونه هو القرشي، ويظهر منه استنباط الوثاقة ببعض الامارات. ولا يخلو من التأمل في كليهما.(@)(@@)(@@)(@@) $ 4566 - عبد الرحمن بن محمد العرزمي الفزاري أبو محمد روى عن " ق " عليه السلام ثقة، عنه زكريا بن يحيى، وجعفر بن بشير، ويوسف بن الحارث الكمنداني، وفي " تعق " عبد الرحمن العرزمي هو ابن محمد، ويروي عنه ابن أبي عمير، وعلي بن الحكم أيضا.(@)(@@)(@@)(@@) $ 4567 - عبد الرحمن بن مسلم الأزدي الكوفي " ق " وفي " تعق " عبد الرحمن بن مسلم هو سعدان بن مسلم، والظاهر أنه سقط من النسخة الحاضرة عندي لفظ الأخ والا فلا معنى له.(@)(@@)(@@)(@@) $ 4568 - عبد الرحمن بن المنذر العبدي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4569 - عبد الرحمن بن ناصح الجعفي أبو العلاء، أسند عنه، مات سنة ست وستين ومائة وهو ابن سبعين سنة " ق ".(@)(@@)(@@)(@@) $ 4570 - عبد الرحمن بن نصر بن عبد الرحمن البارقي الكوفي " ق " ثم كرر مزيدا أبو محمد، أسند عنه.(@)(@@)(@@)(@@) $ 4571 - عبد الرحمن بن نعيم الصحاف، مولى بني أسد، روى عن " ق " عليه السلام، وكذا اخوانه كما تقدم في أخيه الحسين.(@)(@@)(@@)(@@) $ 4572 - عبد الرحمن بن وردان النخعي، مولى كوفي " ق ".(@)(@@)(@@)(@@) $ 4573 - عبد الرحمن بن ولاد الجعفي، مولاهم كوفي " ق ".(@)(@@)(@@)(@@) $ 4574 - عبد الرحمن بن الهلقام أبو محمد العجلي، ضعيف من أصحاب " ق " عليه السلام " صه " " جخ ". PageV01P502(@)(@@)(@@)(@@) $ 4575 - عبد الرحمن بن اليسع الأزدي الغامدي أو العامري الكوفي أبو محمد " ق ".(@)(@@)(@@)(@@) $ 4576 - عبد الرحيم بن روح القصير الأسدي، روى عن " قر " و " ق " عليهما السلام وبقي بعد 
ms373	 الأخير عليه السلام فهو في السابقة أيضا، كما أنه في التالية، ويأتي فيها بعنوان عبد الرحيم القصير.(@)(@@)(@@)(@@) $ 4577 - عبد الرحيم بن سعدان بن مسلم الغامري " قي " " ق " ويحتمل ما ذكرناه عن " تعق " في عبد الرحمن بن مسلم أنه سقط من النسخة لفظ الابن وأعتقد كونه عبد الرحيم، وهو بعيد جدا.(@)(@@)(@@)(@@) $ 4578 - عبد الرحيم بن سليمان الرازي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4579 - عبد الرحيم بن عتبة الله بي، أخو عبد الملك " ق ".(@)(@@)(@@)(@@) $ 4580 - عبد الرحيم بن مسلم البجلي الحريري وكأنه أخو عبد الرحمن بن نصر.(@)(@@)(@@)(@@) $ 4581 - عبد الرزاق بن إبراهيم الخراساني " ق " كوفي " ق ".(@)(@@)(@@)(@@) $ 4582 - عبد الرحيم بن نصر بن عبد الرحمن البارقي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4583 - عبد الرزاق بن همام اليماني، روى عنهما " ق " وفي " قب " ابن همام بن نافع الحميري أبو بكر الصنعاني، وصفه بالحافظ المصنف الشهير والتشيع والعمى في آخر عمره، وفي " هب " الحافظ أبو بكر الصنعاني أحد الاعلام، فلو كان المذكور هنا هو المذكور فيهما فيبعد الرواية عنهما بملاحظة تاريخ وفاته، الا أن التعدد قريب، وان استغربه البعض.(@)(@@)(@@)(@@) $ 4584 - عبد السلام بن حرب النهدي، مولى كوفي أصله بصري، أبو بكر الملائي " ق " والملائي بضم الميم وتخفيف اللام.(@)(@@)(@@)(@@) $ 4585 - عبد السلام بن حفص المزني " ق ".(@)(@@)(@@)(@@) $ 4586 - عبد السلام الحلال الكوفي " ق ".(@)(@@)(@@)(@@) $ 4587 - عبد السلام بن راشد الجعفي، مولى كوفي " ق ". PageV01P503(@)(@@)(@@)(@@) $ 4588 - عبد السلام بن سالم البجلي، كوفي ثقة " صه " " جش " له كتاب، عنه الحسن بن علي بن يوسف بن بقاح في الثاني، وفي " تعق " مر ذكره في زياد بن المنذر.(@)(@@)(@@)(@@) $ 4589 - عبد السلام بن عبد الرحمن بن نعيم الأزدي " ق " وقد ورد فيه حديث معتبر يدل عليه شرفه، وقد دعى له الصادق عليه السلام حين كون سدير وهو في السجن رحمه الله.(@)(@@)(@@)(@@) $ 4590 - عبد السلام بن المستنير بن يزيد أبو كثير السلمي، مات سنة إحدى وثمانين ومائة، وهو ابن ثلاث وسبعين سنة " ق ".(@)(@@)(@@)(@@) $ 4591 - عبد السلام بن نعيم الكوفي " ق " وفي " تعق " أنه ابن عبد الرحمن بن نعيم الأزدي المذكور، والى 
ms374	 الآن لم أتحققه بل لابد من التأمل، فمع ثبوته يقبل روايته والا فلا.(@)(@@)(@@)(@@) $ 4592 - عبد السلام بن الوضاح الكلبي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4593 - عبد السميع بن سالم المزني " ق ".(@)(@@)(@@)(@@) $ 4594 - عبد السميع بن واصل الأزدي " ق ".(@)(@@)(@@)(@@) $ 4595 - عبد الصمد بن بشير العرامي الكوفي العبدي، مولاهم كوفي ثقة ثقة، روى عن " ق " عليه السلام " صه " " جش " له كتاب، عنه عبيس بن هشام " ست " والثاني، والعرامي بضم المهملة.(@)(@@)(@@)(@@) $ 4596 - عبد الصمد بن الصباح الهمداني، مولاهم الكوفي " ق ".(@)(@@)(@@)(@@) $ 4597 - عبد الصمد بن عبد الله الجهني الكوفي، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 4598 - عبد الصمد بن علي بن عبد الله بن العباس بن عبد المطلب، عداده في الكوفيين " ق " وانما قال ذلك لأنه ساكن بالكوفة، والا فهو مدني الأصل.(@)(@@)(@@)(@@) $ 4599 - عبد الصمد بن مدار الصيرفي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4600 - عبد الصمد بن هلال الجعفي مولاهم الخزاز البزكندي الكوفي، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 4601 - عبد العزيز بن أبي حازم مسلمة بن دينار المدني، أسند عنه " ق " PageV01P504(@)(@@) مات سنة خمس وثمانين ومائة " ق " وهو في السابقة، كما لا يخفى على من لاحظ تاريخ وفاته.(@)(@@)(@@)(@@) $ 4602 - عبد العزيز بن أبي ذيب المدني، وهو عبد العزيز بن عمران، ضعفه ابن نمير " ق " " صه " وزاد وليس هذا عندي موجبا للطعن فيه، لكنه من مرجحات الطعن. أقول: مع التسليم فيرد فقاهة.(@)(@@)(@@)(@@) $ 4603 - عبد العزيز بن أبي سلمة الماجشوني المدني الثقة عند العامة، أسند عنه " ق " وفيه مدح وذم على ظاهر العبارة، وذمه أتقن.(@)(@@)(@@)(@@) $ 4604 - عبد العزيز بن أموي المرادي الصيرفي الكوفي، أسند عنه " ق " وفي " تعق " الظاهر أنه ابن نافع. أقول: وهو قريب بملاحظة الامارات، وان لم يترتب عليه ثمرة مع الجهالة.(@)(@@)(@@)(@@) $ 4605 - عبد العزيز بن سليمان الكناني المدني، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 4606 - عبد العزيز بن عبد الله العبدي، مولاهم الخزاز الكوفي " ق ".(@)(@@)(@@)(@@) $ 4607 - عبد العزيز العبدي، كوفي روى عن " ق " عليه السلام ضعيف ذكره ابن نوح " صه " " جش " له كتاب، عنه جماعة منهم الحسن بن محبوب في الثاني، وكأنه ابن عبد الله المشار إليه 
ms375	 قبيله، كما احتمله بعض الأجلة.(@)(@@)(@@)(@@) $ 4608 - عبد العزيز بن فضالة الكلبي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4609 - عبد العزيز بن محمد الاندراوردي المدني، أسند عنه، مات سنة ست وثمانين ومائة " ق " وهو في الطبقة السابقة أيضا.(@)(@@)(@@)(@@) $ 4610 - عبد العزيز بن المطلب المخزومي المدني، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 4611 - عبد العزيز بن نافع الأموي، مولاهم كوفي " ق ".(@)(@@)(@@)(@@) $ 4612 - عبد الغفار الجازي ابن حبيب الطائي. والجازي من أهل الجازية قرية بالنهرين روى عن " ق " عليه السلام ثقة، له كتاب عنه جماعة منهم النضر والقاسم بن إسماعيل.(@)(@@)(@@)(@@) $ 4613 - عبد الغني بن عبد ربة " ". PageV01P505(@)(@@)(@@)(@@) $ 4614 - عبد الغني بن موسى الليثي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4615 - عبد القاهر الذي روى عن جابر " ق " وهو عبد الباهر وقد مر.(@)(@@)(@@)(@@) $ 4616 - عبد الكريم بن حسان النبطي " ق ".(@)(@@)(@@)(@@) $ 4617 - عبد الكريم بن حماد الكوفي " ق ".(@)(@@)(@@)(@@) $ 4618 - عبد الكريم بن سعد أبو العلاء الجعفي " ق ".(@)(@@)(@@)(@@) $ 4619 - عبد الكريم بن عبد الرحمن البجلي البزاز الكوفي، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 4620 - عبد الكريم بن عمرو بن صالح الخثعمي، مولاهم كوفي، روى عن " ق " و " ظم " عليهما السلام ثم وقف على " ظم " عليه السلام ثقة ثقة عين. وقيل: خبيث لقبه كرام، عنه عبيس والبزنطي.(@)(@@)(@@)(@@) $ 4621 - عبد الكريم بن هلال الجعفي، مولاهم الخزاز الكوفي يقال له:(@)(@@) الخلقاني، ثقة عين، روى عن " ق " عليه السلام، له كتاب عنه ابنه الحسن وفي " صه " هليل بدل هلال.(@)(@@)(@@)(@@) $ 4622 - عبد الكريم بن هلال القرشي، له كتاب، عنه محمد بن موسى خورا " ست " وفي " تعق " في النقد لا يبعد اتحاده مع السابق، فتأمل. ولعل الامر بالتأمل إشارة إلى البعد، وفي " مشكا " ابن هلال القرشي المجهول، عنه محمد بن موسى.(@)(@@)(@@)(@@) $ 4623 - عبد الله بن أبان الكوفي، روى عنه ربيع المسلي " ق ".(@)(@@)(@@)(@@) $ 4624 - عبد الله بن أبحر " ق " وكأنه ابن سعيد بن حياة بن أبحر، فان كتابه معروف بكتاب عبد الله بن أبحر، وفي النقد والوجيزة جزم به الا أني لم أتحققه.(@)(@@)(@@)(@@) $ 4625 - عبد الله بن إبراهيم بن أبي عمير الغفاري أبو محمد مدني يقال عليه الفاسد 
ms376	 كثيرا، قال " غض " روى عن " ق " عليه السلام، ويجوز أن يخرج شاهدا " صه " قيل: وهو ابن إبراهيم المتقدم في السابقة.(@)(@@)(@@)(@@) $ 4626 - عبد الله بن إبراهيم بن الحسين بن علي بن الحسين بن علي بن أبي طالب عليهم السلام له نسخة يرويها عن آبائه، عنه علي بن سالم الثوباني " جش ".(@)(@@)(@@)(@@) $ 4627 - عبد الله بن إبراهيم الكوفي " ق ". PageV01P506(@)(@@)(@@)(@@) $ 4628 - عبد الله بن أبي خالد، لا يعرف بأكثر من هذا، له كتاب المناقب، عنه محمد بن إسماعيل بن بزيع " جش ".(@)(@@)(@@)(@@) $ 4629 - عبد الله بن أبي محمد البصري " ق ".(@)(@@)(@@)(@@) $ 4630 - عبد الله بن أبي ميمونة الكوفي " ق ".(@)(@@)(@@)(@@) $ 4631 - عبد الله بن إدريس، له كتاب، رويناه بالاسناد عن حميد بن زياد،(@)(@@)(@@)(@@) $ 4632 - عبد الله بن الأزهر الغامري، مولى بني عقيل كوفي " ق ".(@)(@@)(@@)(@@) $ 4633 - عبد الله بن أعين، في الوجيزة والبلغة " ح " لما روي أن الصادق عليه السلام دعى له وترحم عليه بعد موته، واستقرب في " تعق " كونه اشتباها لعدم تعرض علماء الرجال لذكر عبد الله، وعينه تلميذه في المنتهى نظرا إلى حصر أولاد أعين في رسالة أبي غالب في عدد ليس فيه عبد الله، وفيه نظر لذكره في طرق " يب ".(@)(@@)(@@)(@@) $ 4634 - عبد الله بن إسحاق الجعفري الهاشمي المدني " ق ".(@)(@@)(@@)(@@) $ 4635 - عبد الله بن أسد الكوفي " ق " وعن نسخة ابن راشد (@)(@@)(@@)(@@) $ 4636 - عبد الله بن الأسود الثقفي، مولى آل عمرو بن هلال كوفي " ق ".(@)(@@)(@@)(@@) $ 4637 - عبد الله بن أسيد القرشي الأخنسي الكوفي، أسند عنه " ق " مات سنة ثمان وثمانين ومائة، وهو ابن سبعين أو إحدى وسبعين سنة، وهو في السابقة.(@)(@@)(@@)(@@) $ 4638 - عبد الله بن أمية الكوفي " ق " وفي نسخة السكوني.(@)(@@)(@@)(@@) $ 4639 - عبد الله بن أيوب الأسدي، مولاهم الكوفي " ق ".(@)(@@)(@@)(@@) $ 4640 - عبد الله بن أيوب بن راشد الزهري بياع الزطي، روى عن " ق " عليه السلام ثقة قيل: فيه تخليط، وقال " غض " ذكره الغلاة ورووا عنه لا نعرفه، له كتاب عنه عبيس والقاسم بن إسماعيل.(@)(@@)(@@)(@@) $ 4641 - عبد الله بن بحر، كوفي روى عن أبي بصير، والرجال ضعيف مرتفع 
ms377	 القول " صه " وفي " تعق " استظهر ما فيها من كلام " غض " ثم نفى الاعتبار واحتمل كونه ابن أبحر، الا أن تلميذه قال: ولعله بعيد لاختلاف طبقتهما، وفي كل منهما كلام إذ لا شاهد على الاتحاد، والتعليل عليل لاتفاق الطبقة، كما لا يخفى. PageV01P507(@)(@@)(@@)(@@) $ 4642 - عبد الله بن بشير الكوفي " ق ".(@)(@@)(@@)(@@) $ 4643 - عبد الله بن بكار الهمداني، مولاهم كوفي " ق ".(@)(@@)(@@)(@@) $ 4644 - عبد الله بن بكر أو بكير، روى عن " ق " و " ظم " فارسي، ويأتي عن " كش " عبد الله الرجاني، ويظهر من الميرزا الاتحاد.(@)(@@)(@@)(@@) $ 4645 - عبد الله بن بكر الارجاني، روى عن " ق " عليه السلام، مرتفع القول ضعيف " صه " وفي " ق " ابن بكير الارجاني، وفي " كش " البرجاني، وفي " مشكا " الارجاني عنه يونس بن يعقوب.(@)(@@)(@@)(@@) $ 4646 - عبد الله بن بكر المرادي الكوفي " ق " وعن نسخة ابن بكير.(@)(@@)(@@)(@@) $ 4647 - عبد الله بن بكير بن أعين الشيباني أبو علي، روى عن " ق " عليه السلام واخوته عبد الجهم وعمر وعبد الاعلى، روى عبد الحميد عن " ظم " عليه السلام وولده محمد والحسين وعلي رووا الحديث، فطحي الا أنه ثقة من أهل الاجماع.(@)(@@)(@@)(@@) $ 4648 - عبد الله بن جعفر الجعفري المدني " ق ".(@)(@@)(@@)(@@) $ 4649 - عبد الله بن جعفر بن محمد بن علي بن الحسين عليهم السلام كان أخو " ظم " عليه السلام وهو أكبر اخوته بعد إسماعيل، ولم تكن منزلته عند أبيه عليه السلام منزلة غيره من ولده، وكان متهما بالخلاف على أبيه، وادعى بعد أبيه الإمامة واحتج بأنه أكبر اخوته.(@)(@@)(@@)(@@) $ 4650 - عبد الله بن جعفر الخرمي المدني، أسند عنه " ق " وفي " قب " أبو محمد المدني الخرمي بكسر المعجمة وفتح الراء الخفيفة، لا بأس به من الثامنة، مات سنة سبعين ومائة وله بضع وسبعين سنة، وهو في السابقة.(@)(@@)(@@)(@@) $ 4651 - عبد الله بن جعفر المخزومي المدني أسند عنه " ق " وفي نسخة الخرمي فيتحد مع السابق، هكذا ذكره الميرزا، الا أن توهم الاتحاد مع اسقاط الواو أيضا غريب خصوصا مع التكرار في " ق " والله أعلم.(@)(@@)(@@)(@@) $ 4652 - عبد الله بن جعفر بن نجيح المدني، أسند عنه 
ms378	 " ق ".(@)(@@)(@@)(@@) $ 4653 - عبد الله بن الحجاج البجلي أخو عبد الرحمن، مولى ثقة " صه " PageV01P508(@)(@@) " جش " له كتاب عنه ابن أبي عمير في الثاني، وفي " تعق " يأتي ذكره في الخاتمة.(@)(@@)(@@)(@@) $ 4654 - عبد الله بن حرب الجزري أو الجوزي " ق ".(@)(@@)(@@)(@@) $ 4655 - عبد الله بن الحارث أبو علي خلف بن حامد، قال " كش " في طريق لا بأس به عن الصادق عليه السلام قال: أنزل الله تعالى في القرآن سبعة بأسمائهم فمحت قريش ستة وتركوا أبا لهب، وقال في قول الله تعالى (هل أنبئكم على من تنزل الشياطين) هم سبعة: المغيرة وبنان وصائد والحارث الشامي وعبد الله بن الحارث وحمزة الزبيري وأبو الخطاب.(@)(@@)(@@)(@@) $ 4656 - عبد الله بن حسان بن حميد الكوفي المدني " ق ".(@)(@@)(@@)(@@) $ 4657 - عبد الله بن الحسن بن جعفر بن الحسن بن الحسن الحسيني " ق ".(@)(@@)(@@)(@@) $ 4658 - عبد الله بن الحسن بن زيد بن الحسن بن علي بن أبي طالب عليهما السلام " ق " وهو في التالية أيضا.(@)(@@)(@@)(@@) $ 4659 - عبد الله بن الحسن الشيباني، أخو محمد بن الحسن الفقيه " ق " " د " ابن الحسن الصيرفي " ق ".(@)(@@)(@@)(@@) $ 4660 - عبد الله بن الحسين أبي زيد الهمداني المشاعري الكوفي " ق ".(@)(@@)(@@)(@@) $ 4661 - عبد الله بن الحسن بن الحسن بن علي بن أبي طالب عليهما السلام أبو محمد هاشمي مدني تابعي " ق " أقول: ويلقب هذا بالمحض كما يأتي في ابنه يحيى، فان أباه الحسن بن الحسن عليه السلام وأمه فاطمة بنت الحسين عليه السلام وكان يشبه رسول الله صلى الله عليه وآله.(@)(@@)(@@)(@@) $ 4662 - عبد الله بن الحسين بن علي بن الحسين بن علي بن أبي طالب عليهم السلام الهاشمي " ق ".(@)(@@)(@@)(@@) $ 4663 - عبد الله بن الحكم الأرمني ضعيف " صه " " جش " روى عن " ق " عليه السلام في الثاني مرتفع القول، له كتاب، عنه أبو عمران موسى بن رنجوية الأرمني " جش " " ست " وفي " مشكا " عنه موسى بن رنجوية، وجعفر بن سليمان.(@)(@@)(@@)(@@) $ 4664 - عبد الله بن داهر بن يحيى الأحمري، ضعيف له كتاب يرويه عن PageV01P509(@)(@@) " ق " عليه السلام، عنه محمد بن إسماعيل البرمكي " جش " وفي " مشكا 
ms379	 " ابن داهر عنه محمد بن إسماعيل، وهو عن " ق " عليه السلام.(@)(@@)(@@)(@@) $ 4665 - عبد الله بن دكين الكوفي أبو عمرو، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 4666 - عبد الله بن داود الخريبي " ق ".(@)(@@)(@@)(@@) $ 4667 - عبد الله بن ذبيان بكسر الذال وضمها أيضا، واقع في طرق الأحاديث ولم يوجد في كتب الرجال، فكأنه مجهول والله أعلم، هكذا ذكره الميرزا في التلخيص.(@)(@@)(@@)(@@) $ 4668 - عبد الله بن راشد الكوفي " ق " في نسخة، وفي أخي ابن أسد وقد تقدم.(@)(@@)(@@)(@@) $ 4669 - عبد الله بن رباط ثقة " صه " " جش " البجلي الكوفي وأخوه يونس " ق " ورباط بالراء المكسورة والباء الموحدة والطاء المهملة، وفي ترجمة ابنه محمد عن " ق " عليه السلام كما في " جش " و " صه ".(@)(@@)(@@)(@@) $ 4670 - عبد الله بن رجاء المكي " ق ".(@)(@@)(@@)(@@) $ 4671 - عبد الله بن الزبير الأسدي، روى نوادر كتابا عن " ق " عنه عباد بن يعقوب الأسدي " جش " واحتمل في المنتهى اتحاده مع عبد الله بن الزبير الرساني لما في " ق " في ترجمة الفضيل أخي عبد الله، وعن تصريح المجمع الاتحاد، ولكن دعواه خالية عن الاستناد.(@)(@@)(@@)(@@) $ 4672 - عبد الله بن الزبير الرساني، في " كش " ذكر حديثا قيل: إنه يعطي كونه زيديا، وفيه نظر لما روي من الترغيب في اعانته وامداده وأخذه البيعة للرضا عليه السلام، ومع أن اعطائه ذلك محل تأمل، بل لا يبعد اشعاره المدح فلاحظ، ومضى في ابن الزبير الأسدي اتحاده معه عن المجمع، فتأمل.(@)(@@)(@@)(@@) $ 4673 - عبد الله بن زرارة بن أعين الشيباني، روى عن " ق " ثقة " صه " " جش " له كتاب عنه علي بن النعمان في الثاني، وفي " مشكا " ابن زرارة الثقة، عنه علي بن النعمان، وحماد بن عثمان، كما في مشرق الشمسين عن " شه ". PageV01P510(@)(@@)(@@)(@@) $ 4674 - عبد الله بن زياد الحنفي، مولاهم كوفي " ق ".(@)(@@)(@@)(@@) $ 4675 - عبد الله بن زياد بن سمعان، مولى أم سلمة مكي " ق ".(@)(@@)(@@)(@@) $ 4676 - عبد الله بن زياد النخعي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4677 - عبد الله بن زياد أبو عبد الرحمن الهراء الهمداني الكوفي " ق ".(@)(@@)(@@)(@@) $ 4678 - عبد الله بن زياد الثقفي، وهو مع سابقه ذكرهما بعض الأصحاب 
ms380	 في عنوان عبد الله. قال بعض الأفاخم من الرجاليين: ان الصحيح فيهما عبيد الله كما يأتي، والله أعلم.(@)(@@)(@@)(@@) $ 4679 - عبد الله بن سابري الواسطي الزيات " ق " وفي " تعق " يروي عنه الحسن بن محبوب.(@)(@@)(@@)(@@) $ 4680 - عبد الله بن سالم " ق " الصيرفي، يروي عن " ق " عليه السلام، مرتفع القول لا يعبأ به " صه " " د ".(@)(@@)(@@)(@@) $ 4681 - عبد الله بن سعيد أبو شبل الأسدي، مولاهم كوفي بياع الوشى، روى عن " ق " عليه السلام ثقة " صه " " جش " له كتاب يرويه عنه علي بن النعمان في الثاني، وفي " مشكا " أبو شبل الثقة، عنه علي بن النعمان وصفوان.(@)(@@)(@@)(@@) $ 4682 - عبد الله بن سعيد الوابشي أبو محمد الكوفي " ق ".(@)(@@)(@@)(@@) $ 4683 - عبد الله بن سلام الكوفي أبو خديجة " ق ".(@)(@@)(@@)(@@) $ 4684 - عبد الله بن سليمان الصيرفي، مولى كوفي، روى عن " ق " عليه السلام، له أصل إلى أن قال: حدثنا عبد الله بن سليمان بكتابه " جش " وفي " تعق " حسنه خالي لوجود طريق للصدوق إليه، ويروي عنه صفوان وابن أبي عمير، ثم استظهر كونه الصيرفي، وفي " مشكا " ابن سليمان الصيرفي، عنه جعفر بن علي.(@)(@@)(@@)(@@) $ 4685 - عبد الله بن سليمان الغامري كوفي " ق ".(@)(@@)(@@)(@@) $ 4686 - عبد الله بن سليمان النخعي كوفي " ق " عربي " قي ".(@)(@@)(@@)(@@) $ 4687 - عبد الله بن سنان بن ظريف، مولى بني هاشم ويقال: مولى بني أبي طالب، ويقال: مولى بني العباس، كان خازنا للمنصور والمهدي والهادي والرشيد، PageV01P511(@)(@@) كوفي ثقة من أصحابنا جليل لا يطعن عليه في شئ، روى عن " ق " عليه السلام عنه ابن أبي عمير.(@)(@@)(@@)(@@) $ 4688 - عبد الله بن سيابة الكوفي " ق " أخو عبد الرحمن بن سيابة " قي ".(@)(@@)(@@)(@@) $ 4689 - عبد الله بن شاذان الزبالي " ق ".(@)(@@)(@@)(@@) $ 4690 - عبد الله بن صبيح البكري الكوفي " ق ".(@)(@@)(@@)(@@) $ 4691 - عبد الله بن طلحة النهدي، عربي كوفي، روى عن " ق " وليس هو أخا يحيى بن طلحة، له كتاب، عنه علي بن إسماعيل الليثي " جش ".(@)(@@)(@@)(@@) $ 4692 - عبد الله بن عاجز الكوفي " ق ".(@)(@@)(@@)(@@) $ 4693 - عبد الله بن عاصم، في " تعق " نقل عن الفاضل الخراساني أن المستفاد من المحقق توثيقه، 