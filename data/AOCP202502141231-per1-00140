ms121	 دلم را به تعب می داری وزتاب سرزلف به تب میداری(@)(@@) (@@) یا قد و خط ورخ چوسرو و گل و مشک %~% شکلی و شمایلی عجب می داری(@)(@@)(@@)(@@) | نمط دوم(@)(@@) در تشبیهات طره(@)(@@)(@@)(@@) | لااعرف(@)(@@) (@@) 119 ای توده به گرد روز تو خرمن شب %~% وی روز تو دست کرده در گردن شب(@)(@@) (@@) یشانی روشن تو، وان طره بدو %~% صبحی است، برون آمده از دامن شب(@)(@@)(@@)(@@) | صدر خجندی(@)(@@) (@@) 1200 تا طرف رخت زلف سیه بگرفتهست %~% گویی ره توبه را گنه بگرفتهست(@)(@@) (@@) آن طرهآ عنبرین، زرخ یک سوکش %~% تا ظن نبرد کسی، که مه بگرفته ست!(@)(@)PageV01P261(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0265.jpg)(@)(@)(@@)(@@)(@@) | جمال خجندی(@)(@@) (@@) 1201 چشمت به کرشمه ای دو صد جان ببرد %~% لعل لب تو رونق صد کان ببرد(@)(@@) (@@) وان طره هندوی مشعبد بازت %~% از حقهآ دل مهرهآ ایمان ببرد!(@)(@@)(@@)(@@) | کمال اصفهانی(@)(@@) (@@) 1202 ای دیده، خیال روی چون گلنارش %~% بر خود زدی، از چشم فرو مگذارش(@)(@@) (@@) وی دل، تو سر طرهآ عنبر بارش %~% نیک آوردی به دست، محکم دارش!(@)(@@)(@@)(@@) | برهان گنجه ای(@)(@@) (@@) 1203 مهر، از لب جانفزای نوشین بردار %~% بار، از دل عاشقان غمگین بردار(@)(@@) (@@) در کار جگر سوختگان، کن نظری %~% از گوشهآ مه، طرهآ مشکین بردار!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 1204 در عشق تو، ای فرشته خومی ترسم %~% تا از غم آن روی نکو می ترسم(@)(@@) (@@) از زلف تو ایمنم، ولی طرهآ تو %~% پیوستهآ حاجب است، از او می ترسم!(@)(@@)(@@)(@@) | عزیز شروانی(@)(@@) (@@) 1205 ای چشم تو بر کرده به عیاری سر %~% ابروت نهاده، در جفا کاری سر(@)(@@) (@@) چون زلف به سر برآمدم از تو و، تو %~% چون طره، به من فرو نمی آری سر!(@)(@@) شمس اسعد گنجه ای(@)(@@) (@@) 1206 ای چشم تو خو کرده به خون ریختنم %~% مگذار به غمزه دست بر پیختنم(@)(@@) (@@) گر بر خطت از میان جان سر ننهم %~% از طره بفرمای، در آو یختنم!(@)(@@)(@@)(@@) | جمال حاجی(@)(@@) (@@) 1207 دل عاشق روی توست، نیکودارش %~% در بند به بوسه با لبت بازارش(@)(@@) (@@) چون زلف، به پای در میفکن کارش 
ms122	 %~% وله %~% چون طره، بیکبار فرو مگذارش!(@)(@@) ~~ورجان زخط خوش تو سر پیچاند 1208 گر دل نه مطیع توست، برخیز او را(@)(@@) %~% برخیز، سر از طره بر آو یز او را! %~% از حلق به تیر غمزه خون ریز او را(@)(@@)(@@)(@@) | خلیل شروانی(@)(@@) (@@) 1209 بس نیست، که مشک لاله را می پوشد %~% یعنی، خط توخد تورا می پوشد(@)(@@) (@@) این طرهآ هندوی تو، باری از من %~% بیشانی روشنت چرا می پوشد؟(@)(@)PageV01P262(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0266.jpg)(@)(@)(@@)(@@)(@@) | نمط سوم(@)(@@)(@@)(@@) | درتشبیهات زلف(@)(@@)(@@)(@@) | جمال اشهری(@)(@@) ~~121 ای یافته زلف توز هر باد شکست با زلف تو، تا ابد بهم باد شکست(@)(@@) (@@) لاله وگل، رخ تورا بود مصاف %~% از بهر چه، بر زلف توافتاد شکست؟(@)(@@)(@@)(@@) | لاادری(@)(@@) (@@) 121 زلف تو، عظیم سرفراز افتادهست %~% در بردن دل، دست دراز افتادهست(@)(@@) (@@) روی تو، به حسن می کند تربیتش %~% او فارغ از آن، به پشت باز افتادهست!(@)(@@)(@@)(@@) | جمال اشهری(@)(@@) ~~زلف تو، به جنبشی دل از من بر بود 1212 مشکین سر زلفین تو، تا می(@)(@@) جنبد %~% وله %~% آن زلف نگر، که از کجا می جنبد! %~% در غارت مسکین دل ما می جنبد(@)(@@) ~~1212 چشمت، در رحمت است بازش می کن ازلف سیهت، که مشک می خیزد ازاو(@)(@@) %~% سرمایهآ عمر است، درازش می کن! %~% وز ناز و کرشمه، برگ و سازش می کن(@)(@@)(@@)(@@) | اوله(@)(@@) ~~1214 ای هر دهن ازتو کرده افسانه مرا در پای چه می کشی سر زلف، که(@)(@@) کرد %~% وله %~% زنجیر کشیدن از تو، دیوانه مرا! %~% غم نیست، که نیست از تو هم خانه مرا(@)(@@) ~~1215 زلف کژتو، که هست با قد تو راست پیوند از آنجا که تویی با دل(@)(@@) ماست %~% وله %~% بنگر، که مسافت از کجا تا به کجاست! %~% بالاش، همان مدان که از سرتا پاست(@)(@@) (@@) 1216 زلف سیهت، که مشک با او کم زد %~% مشاطهآ فتنهاش خم اندر خم زد(@)(@@) (@@) یک شب به منش سپار، تا یک باری %~% برهم زنمش، که عالمی بر هم زد!(@)(@)PageV01P263(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0267.jpg)(@)(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 1217 آن 
ms123	 بت که دلم جست... در بر زلف %~% بر اخگر رخ نهاد خوش عنبر زلف(@)(@@) ~~نمودیمی دل شده در صورت خطاز آینهآ عذار، عکس سر زلف(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 1218 دل بشکندم، چوزلف بر هم شکنی %~% دل کم شکند مرا، گرش کم شکنی(@)(@@) (@@) برهم مشکن زلف، که یک عالم دل %~% بر هم شکند، چوزلف بر هم شکنی!(@)(@@)(@@)(@@) | لااعرف(@)(@@) (@@) 1219 ای ترک، به غمزه آفت جان و تنی %~% خصم تونیم، گرچه به جان خصم منی(@)(@@) (@@) بر می شکند خسته دلم را، زلفت %~% اوله %~% من، زلف ندیده ام بدین پرشکنی(@)(@@) (@@) 1220 نزدیک دو زلفت، ای مه بنده نواز %~% چشمت، سخن روی تومی کرد آغاز(@)(@@) (@@) می پیخت در اوحدیث و، الحق خوش بود %~% مستی و حدیث خوب وافسانه دراز!(@)(@@)(@@)(@@) | کمال خجندی(@)(@@) (@@) 1221 زلفت، به جز از ستیزه کاری چه کند؟ %~% دانی که چودل بدو سپاری چه کند؟(@)(@@) (@@) در زیر کله، جهان بر آورد به هم %~% وه، وه! که گرش فرو گذاری چه کند!(@)(@@)(@@)(@@) | لااعرف(@)(@@) (@@) 1222 زلف تو، تنت را به زره پوشیدهست %~% مانا که به دزدی دلم کوشیدهست(@)(@@) (@@) بی شک، که به خون ریختنم دارد میل %~% خط تو، بر آنگونه که بر جوشیدهست(@)(@@) (@@) 223) زلف توم که عادتش دل آزاری ماست %~% اوله %~% پیچان همه گه، زناله و زاری ماست(@)(@@) (@@) باید که ازین سپس نبری سر او %~% گر نیز همه برای دلداری ماست!(@)(@@)(@@)(@@) | سید بوعلی(@)(@@) (@@) 122 زلف تو، بنفشهآ کمر بر بستهست %~% یا خود گرهی به کار مادر بسته ست(@)(@@) (@@) گر دوش ندادهست کسی درد سرش %~% امروز چرا تافته و سر بستهست(@)(@@)(@@)(@@) | ااعرف(@)(@@) ~~122 در صدف لعل. تو، قند افتادهست(@)(@@) ~~تو، غرهآ به بر شکستگیهاش مشو PageV01P264(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0268.jpg)(@)(@)(@@)(@@)(@@) | لااعرف(@)(@@) ~~122 گفتم که: ««دلم به نزد تو گشت گرو دل باز ده، آغاز مکن حیلهآ نوا»(@)(@@) (@@) فشاند هزار دل، زیک حلقهآ زلف %~% اوله %~% گفتا: «دل خود بجوی و برگیر و بروا»(@)(@@) ~~می لافد از آنکه گرد رویت گشتهست 1221 زلفت که همیشه سروری ورزیده ست(@)(@@) %~% یعنی: همه آفتاب گردش 
ms124	 دیده ست! %~% در پای تو چون در دل من پیچیدهست(@)(@@)(@@)(@@) | سید بوعلی(@)(@@) ~~1228 دل را، که به خدمت تو آمد رایش در چاه زنخدان تو دیدم، در بند(@)(@@) %~% از زلف تو،زنجیر گران بر پایش %~% عمری پس از آنکه گشت خالی جایش(@)(@@)(@@)(@@) | لااعرف(@)(@@) (@@) 220) تا دیده ام آن زلف زره مانندش %~% کآرامگه دلم همی خوانندش(@)(@@) ~~ر خاک نهد مه بر او پیشانی سی صبر و دل و قرار چون [می] باشد 123(@)(@@) چشمم که بر آن سرو قباپوش افتد %~% الغیره %~% دیوانه که زنجیر بجنبانندش(@)(@@) %~% دل، زآتش او چو دیگ در جوش افتد %~% زلف خوش او، چو بر بناگوش افتد(@)(@@)(@@)(@@) | شیخ برهان(@)(@@) (@@) 123 گر جرعه ای از جام لبت نوش کنم یک حلقه ز زلف عنبرینم بفرست %~%(@)(@@) تا حلقهآ بندگیت، در گوش کنم %~% مهر همه دلبران، فراموش کنم(@)(@@) (@@) 1232 چون ساخت دلم در سر زلف تو مقام %~% اوله %~% همچون زلفت به جمله اوصاف تمام(@)(@@) (@@) آشفته و آو یخته و تیره نهاد %~% سرگشته و بر هم زده و بی آرام(@)(@@)(@@)(@@) | اوله(@)(@@) ~~1232 هر دم، دل من میل به جایی دارد رایش همه زلف دلبران باشد و بس(@)(@@) %~% اوله %~% یارب، چه شکسته بسته رایی دارد! %~% اندیشهآ عشق دلر بایی دارد(@)(@@) ~~1234 با روی تو، ماه آسمان راچه مخل؟(@)(@)PageV01P265(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0269.jpg)(@)(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1235 زلف توام، از عنا بخواهد کشتن %~% یک شهر چو من گدا بخواهد کشتن(@)(@@) (@@) برخیزم و، در شهر برآرم فریاد %~% کآو یختهای مرا بخواهد کشتن!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1236 جانا، چومیان ما نه بیگانگی است %~% بشنو، که مرا با تو سخن خانگی است(@)(@@) (@@) بر آرزوی سلسلهآ زلف خوشت %~% دیوانه دلم را، سر دیوانگی است!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1237 زلف تو، که صد کار و کیایی دارد %~% با جان، زلطافت آشنایی دارد(@)(@@) (@@) بر گوشهآ چشم حلقه گشتهست، مگر %~% کان ترک، سر حلقه ربایی دارد!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1238 تا جنبش زلف تونگارین، بیش است %~% با عشق تو، میل من مسکین بیش است(@)(@@) (@@) با زلف تو مشک چین چه قیمت دارد %~% مویی 
ms125	 ز سر زلف تو، صد چین بیش است(@)(@@)(@@)(@@) | عیانی گنجه ای(@)(@@) (@@) 1239 زلفت، بر خال و خط غلط می گردد %~% پرگار صفت، گرد نقط می گردد(@)(@@) (@@) خط تو زمرد است و، زلفت افعی %~% افعی، به چه زهره گرد خط می گردد!(@)(@@)(@@)(@@) | رفیع بکرانی(@)(@@) (@@) 1240 زلفت، که چو عقرب پی شرمی گردد %~% دانی پس پشتت به چه سر می گردد؟(@)(@@) (@@) چون دید که لعل تو زمرد بگرفت %~% وحشی شد و، بر کوه و کمر می گردد(@)(@@)(@@)(@@) | مجد تاییدی(@)(@@) (@@) 1241 ای قاعدهآ طرهآ تو طراری %~% هرگز نکنی چودیده مردم داری(@)(@@) (@@) هم روز رخت شبی بر آرد کارم %~% چون زلف خوشت اگر فرو بگذاری(@)(@@)(@@)(@@) | مهذب نیشابوری(@)(@@) ~~2242 رگ، چو بر ال عارص م وس بهد(@)(@@) ~~بر رخ فکن ان عنبرت، از بهر خی PageV01P266(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0270.jpg)(@)(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~1244 دل، دزد غم است، خون او ریختنی است در چاه زنخ کنش، که بگریختنی است!(@)(@@) (@@) بندی ز دو زلف خویش در پایش کن %~% باری، به چنان رسن گر آو یختنی است!(@)(@@)(@@)(@@) | لااعرف(@)(@@) (@@) 12،5 برخاسته قامتت، سرافرازی را %~% چشم تو نشسته، ناوک اندازی را(@)(@@) (@@) خون باد دلی، کو رسن زلف تودید %~% وانگاه، میان نبسته جانبازی را!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 1246 زلفت، که طراز آستینش دیدم %~% گه بر سر و، گاه بر زمینش دیدم(@)(@@) (@@) جاسوس ضمیرم، ز ختن می آمد %~% پرسیدم از او، گفت: به چینش دیدم!(@)(@@) (@@) 12،7 هر حلقهآ زلفت، ز فن یکدیگر %~% ظهیر %~% گشتند نهان، در شکن یکدیگر(@)(@@) (@@) از بهر ربودن دل و، غارت جان %~% کردند زبان در دهن یکدیگر!(@)(@@)(@@)(@@) | مهستی(@)(@@) (@@) 1248 چشم ترکت، چو مست بر می خیزد %~% شور، از می و می پرست بر می خیزد(@)(@@) (@@) زلفت، چو به رقص در میان می آید %~% صد فتنه، به یک نشست بر می خیزد!(@)(@@) (@@) 1249 مر موی تو را، چه بود بی آزاری %~% ولها %~% برخاستن، از سر چو تو دلداری(@)(@@) (@@) من بنده، اگر موی شوم در غم تو %~% هرگز، ز سر تو بر نخیزم باری!(@)(@@)(@@)(@@) | ولها(@)(@@) (@@) 1250 در 
ms126	 عشق تو، هر سوی همی باید رفت %~% چون اشک، به هر روی همی باید رفت(@)(@@) ~~در خدمت زلفین تو، همچون شاهان شرط است، که بر موی همی باید رفت!(@)(@@)(@@)(@@) | رضی(@)(@@) ~~1251 ای زلف تورنگ برده و بوی از مشک چوگان شده و، برده بسی گوی ازمشک(@)(@@) (@@) هر موی، که از فرق توافتد به زمین %~% فرقش نکند کسی، به یک موی از مشک(@)(@@) صفی جرباد قانی(@)(@@) ~~1252 ای باد صبا، ززلف جانان چه خبر؟ زان مشک فروش عنبر افشان چه خبر؟(@)(@@) ~~زان خسته دلم، که در خمش گم شده بوددیدی اثری یانه؟ بگو، هان، چه خبر؟(@)(@)PageV01P267(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0271.jpg)(@)(@)(@@)(@@)(@@) | ااعرف(@)(@@) (@@) 1253 ای زلف تو گه گشاده، گه بافته خوش %~% گاهی گرهی بر زده، گه تافته خوش!(@)(@@) (@@) هم زلف تو، دیده از رخت روزی نیک %~% هم روی تواز زلف، شبی یافته خوش!(@)(@@) (@@) 1254 ای صنعت زلفت دل مشک آزردن %~% وله %~% کس نیست چوزلف سیهت، بر گردن(@)(@@) (@@) القصه میان مشک و، زلفت به جهان %~% جز شانه، کسی فرق نداند کردن(@)(@@)(@@)(@@) | ظهیر شفروه(@)(@@) (@@) 1255 زلفش، که نگار صد طراز آید ازو %~% جان و دل را، محرم راز آید ازو(@)(@@) (@@) تاری، که به نوک شانه باز آید ازو %~% عالم عالم فتنه فراز آید ازو!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 1256 زلفش بکشم، شب دراز آید ازو %~% ور باز هلم، چنگل باز آید ازو(@)(@@) (@@) ور گرد به آستین ازو بنشانم %~% دامن دامن مشک فراز آید ازو!(@)(@@)(@@)(@@) | فخر مبارکشاه(@)(@@) ~~1257 آنک آتش مهر، در دل ما افکند در آب، نظر بر رخ زیبا افکند(@)(@@) (@@) بندی ز سر زلف خود، آشفته بدید %~% پنداشت که کار ماست، در پا افکند!(@)(@@)(@@)(@@) | اشهری(@)(@@) (@@) 1258 در عشوه گری، چو گل شکفتی با من %~% صد شب به خیال، بیش خفتی با من!(@)(@@) (@@) گفتی که : («سرزلف به دست تو دهم)) %~% در پای فکندی، آنچه گفتی با من!(@)(@@)(@@)(@@) | اوله(@)(@@) ~~1259 دل، در سر زلفت آرمیدن خو کردزین موی بدان موی رسیدن خو کرد(@)(@@) (@@) چون موی شدم، بر منش باز فرست 
ms127	 %~% اکنون که به موی بر دو یدن خو کرد!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1260 بیچاره دلم، زمن رمیدن خو کرد %~% در حلقهآ زلفت آرمیدن خو کرد(@)(@@) (@@) آن دست نداشت او، که زنجیر کشد %~% هم، بر پی زنجیر دو یدن خو کرد!(@)(@@)(@@)(@@) | لااعرف(@)(@@) ~~1261 تا سوی لبش، به بوسه پروانه دهدوین مرغ نیاز را، دم دانه دهد(@)(@@) ~~من مست گرفته زلف او، اومی گفت: PageV01P268(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0272.jpg)(@)(@)(@@) (@@) 1262 افتد که سر زلف تو پروانه دهد %~% وله %~% و اندر خم و بیچ خود مرا خانه دهد(@)(@@) (@@) از گردش روزگار، نومید نیم %~% وله %~% کان سلسله، هم به دست دیوانه دهد!(@)(@@) ~~آن زلف چوزنجیر، به رخ برچه نهی؟ 126 در هر دهن، از عشق تو افسانه(@)(@@) منم %~% رسوا شده پیش خویش و بیگانه، منم %~% در گردن من فکن، که دیوانه منم!(@)(@@)(@@)(@@) | 1اعرف(@)(@@) (@@) 1264 هر شب، زغمت هزار افسانه نهم زنجیر سر زلف تو در دست من است %~%(@)(@@) بر پای دل سرکش و دیوانه نهم %~% وز دست غمت، روی به بتخانه نهم(@)(@@)(@@)(@@) | لاادری(@)(@@) (@@) 1223 ما را، دل کور بخت و کژ بین افتاد %~% در دام دو زلف هندوت، زین افتاد(@)(@@) (@@) این دل، هوس راه ختن داشته بود %~% اندیشه خطا کرد، سوی چین افتاد(@)(@@)(@@)(@@) | مختصر گنجه ای(@)(@@) ~~126 زلف سیهت، که مشک تو بر تو اوست کس مشک ندید، کان ندارد آهو خ مشک، ولی نا شده در نافه هنوز 126 رخسار تومشک است، سرزلف توخون با تو،(@)(@@) سخن زلف درازت گفتم 126 تا در سر زلفت خم چین افکندی %~% وله %~% الغیره(@)(@@) %~% الآ زلفت، که مشک بی آهو اوست %~% ای جان وجهان، دلیل می دانی چون؟ %~%(@)(@@) مرد افکن وشست ودلبر وهندو اوست %~% خون زلف، ولی آمده از نافه برون %~% بر(@)(@@) ماه، نقاب عنبرین افکندی %~% در خشم شدی و، بر زمین افکندی(@)(@@)(@@)(@@) | اادری(@)(@@) (@@) 126 مشکت، پسرا بر گل رعنا مفکن %~% در گردن جان، کمند والا مفکن(@)(@@) (@@) دستی بزن و، سری بجنبان با ما %~% و ین کار، چوزلف خویش در پا مفکن! 
ms128	(@)(@@)(@@)(@@) | صاحب سعید شمس الدین(@)(@@) (@@) 1270 از بند سر زلف تو، ای حور نژاد %~% خود را، به هزار حیله کردم آزاد(@)(@@) (@@) از چاه زنخدان تو، غافل بودم %~% از بند برون آمد و، در چاه افتاد!(@)(@)PageV01P269(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0273.jpg)(@)(@)(@@)(@@)(@@) | مبارکشاه(@)(@@) (@@) 1271 ای زلف تو در مشک نگه ناکرده %~% نگذاشته حال خود، تبه ناکرده(@)(@@) (@@) گر عاشق تو نیست، چرا هر ساعت %~% در پای تو سر نهد، گنه ناکرده؟(@)(@@)(@@)(@@) | شمس سجاسی(@)(@@) (@@) 1272 ماه، از رخ یار مایه اندوخته است %~% خورشید فلک، به مهرش آموخته است(@)(@@) (@@) تا زلف ورا مشک نخوانی، زنهار! %~% کان مشک سیه دل، جگر سوخته است!(@)(@@)(@@)(@@) | مهذب نیشابوری(@)(@@) (@@) 1273 قندت، که نبات عنبر افشان آورد %~% از تربیتی چشمهآ حیوان آورد(@)(@@) (@@) آورد شب زلف به روز رخ و، گفت: %~% لغیره %~% شب، بهتر از این به روز نتوان آورد!(@)(@@) (@@) 1274 آو یخته زلف تو، دلاو یز بود %~% هندو نسبی، که رومی آمیز بود(@)(@@) (@@) دوش آمده بود، تا بریزد خونم %~% آو یخته، دیدهای که خونریز بود؟(@)(@@) (@@) 1275 امسروزم دل از محتکفان در اوست %~% عطار %~% وین دل، که تهی است زوبر ما، بر اوست(@)(@@) (@@) زلف خوش او، گرچه ندارد سر کس %~% دل را سر اوست، لاجرم در سر اوست(@)(@@) (@@) 1276 زلف تو، که مشک کمترین چاکر اوست %~% لیر %~% جان با همه بارنامه، خاک در اوست!(@)(@@) (@@) زان شکل مسلسل ودرازی و شکن %~% هر چند که بی سر است، ما را سر اوست(@)(@@)(@@)(@@) | وله(@)(@@) ~~1237 زلفت، که طراوت جهان مایهآ اوست هر زیبایی که هست، پیرایهآ اوست(@)(@@) (@@) در مرتبهآ فروتر، این پایهآ اوست %~% کان روی چو آفتاب، در سایهآ اوست(@)(@@)(@@)(@@) | انوری(@)(@@) (@@) 1278 مسکین دل من، چومحرم راز نیافت %~% و اندر قفس جهان، هم آواز نیافت(@)(@@) (@@) اندر سر زلف خوبرو یان گم شد %~% تاریک شبی بود، کسش باز نیافت!(@)(@)PageV01P270(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0274.jpg)(@)(@)(@@)(@@)(@@) | نزهة المجالس(@)(@@)(@@)(@@) | کحال(@)(@@) (@@) 1279 یک بار بگفتم : ای مه مهر پرست %~% در گردن من گره زن، آن زلف چوشست(@)(@@) (@@) گفتا: چه گشاید از تو آخر، که مرا %~% خود را 
ms129	 به کمند، بر تومی باید بست!(@)(@@)(@@)(@@) | شمس گنجه ای(@)(@@) (@@) 1280 در حلقهآ زلف آن بت عشوه پرست %~% دی شب، چوزدم زغایت مستی دست(@)(@@) (@@) در هر شکن زلف تو، افزون دیدم %~% ده پانزده، بیست سی، چهل پنجه شست!(@)(@@)(@@)(@@) | جمال سرخسی(@)(@@) (@@) 128 ای زلف تو را هزار دل در شکنی %~% فریاد وفغان زتو، به هر انجمنی(@)(@@) (@@) می گشت به لاف گرد رویت، می گفت: %~% کس دید در آفتاب گردش، چومنی؟(@)(@@)(@@)(@@) | عماد دبیر(@)(@@) (@@) 128 گر ماه در آن چهرهآ رخشان نگرد %~% از رشک تو، انگشت به دندان ببرد(@)(@@) (@@) ور باز بدان گوی زنخدان نگرد %~% از زلف تو، صد هزار چوگان بخورد(@)(@@)(@@)(@@) | قاضی نجم(@)(@@) (@@) 1282 زلفی، که به خم همچو کمندش داری %~% گرچه گفتم که بی گزندش داری(@)(@@) ~~چون با منش از هیچ گره می گیرد 128 زلف تو، نگون از بر رخسار چراست؟(@)(@@) گر کرد گنه، چه کار دارد به بهشت؟ %~% لغیره %~% آن به، که همه ساله به(@)(@@) بندش داری %~% با عارض چون بهشت تو، یار چراست؟ %~% ور نیست گنهکار، نگوسار چراست؟(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 1285 یاری، که به چشم فتنه انگیز است او %~% مرد افکن و دلفریب وخونریز است او(@)(@@) (@@) هر دل که برد، در سر زلف آو یزد %~% جانهاش فدا، که بس دلاو یز است او!(@)(@@)(@@)(@@) | حمید گنجه ای(@)(@@) (@@) 1286 از زلف بپرهیز و، زمکاری او %~% هان! تا نشوی غره به غداری او!(@)(@@) (@@) کان روز، که غوغای خطت برخیزد %~% الغیره %~% معلوم رخت شود، سیهکاری اوا!(@)(@@) (@@) 1287 آن عنبر لالای تو، ای طرفه پسر %~% کژ می رود و، می رودش کار به سر(@)(@@) (@@) شاید، که برانگشت بپیچی آن را %~% کز روی زنخ نهاد بر خط توسر PageV01P271(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0275.jpg)(@)(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~1288 زلفت، که سر از خلق جهان می پیچد دانی که زبهر چه، چنان می پیچد(@)(@@) (@@) در پای تومی بایدش افتاد، زعجز %~% بر خویشتن، از غیرت آن می پیچد(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 1289 زلفت، که زمن چون زتو سر می پیچد %~% همچون عملت، به پای در می 
ms130	 پیچد(@)(@@) (@@) بر دست خود ار سرش بپیچی، شاید %~% کو دست چو من هزار، بر می پیچد(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 1290 ای کرده هزار دل سر زلف تولاش %~% پرخم شده، چون تراشهآ تیر تراش(@)(@@) (@@) هر چیز که بشکند، بها کم شودش %~% زلف تو چوبشکست، بیفزود بهاش!(@)(@@) (@@) 1291 گفتم: دل من دراز تا چند کشی؟ %~% لغیره %~% وز من، سر زلف بازتا چند کشی؟(@)(@@) (@@) می گفتم و، می کشیدم از سر زلفش %~% گفتا: برو [این] دراز تا چند کشی؟(@)(@@)(@@)(@@) | سعد سمرقندی(@)(@@) (@@) 1292 باعنبرش ای باد، چه سر می داری %~% کو را چو دلم زیر و زبر میداری(@)(@@) (@@) دلهای پر از راز، بسی در خم اوست %~% تو پردهآ رازها چه بر می داری!(@)(@@)(@@)(@@) | فخر مراغه ای(@)(@@) ~~1293 آن نرگس نو شکفته، مست از چه فتاد؟ وان سنبل تازه، گل پرست از چه فتاد؟(@)(@@) (@@) ننموده سیاهی سپه، مشک خطت %~% بر لشکر زلف تو، شکست از چه فتاد؟(@)(@@)(@@)(@@) | شفروه(@)(@@) (@@) 1294 گر دور شود، زلف پشولیدهآ او %~% پیدا شود آن روی پسندیدهآ او(@)(@@) (@@) ای باد صبا، زمزمهای نرم بکن %~% تا رقص کند، زنگی شوریدهٔ‌ او!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 1295 هر کوبه جهان غمخور زلف تو شود %~% دلتنگ تر از چنبر زلف تو شود(@)(@@) (@@) وان دل، که به طبع در سر زلف توشد %~% دانی چه کند؟ در سر زلف تو شود!(@)(@@)(@@)(@@) | مجیر بیلقانی(@)(@@) ~~1296 چون دید دلم که زلف یارم خم داشت در حلقهآ او رفت و، قدم محکم داشت(@)(@@) (@@) یچاره ندانست، چوبه در نگرست %~% هر حلقه از آن زلف، دری در غم داشت!(@)(@)PageV01P272(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0276.jpg)(@)(@)(@@)(@@)(@@) | لاادری(@)(@@) (@@) 1297 تا غمزهآ کافرت به کین اندر شد %~% کافر صفتی از توبه دین اندرشد(@)(@@) (@@) هندوی دو زلف تو، به ترکی برخاست %~% آمد ختنی وار، به چین اندر شد(@)(@@) (@@) 1298 زلفت، که زماه تکیه گاهی دارد %~% وله %~% انصاف، که خوش منصب و جاهی دارد(@)(@@) (@@) ربود دلم، نیارمش گفت که او %~% چون عارض تو، پشت و پناهی دارد!(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 1299 زلف تو، که حق باد بحق داور 
ms131	 او %~% زان گشت بریده، حلقهآ چنبر او(@)(@@) (@@) کوخواست به باد داد، سرهای سران %~% سر دل او گشت قضای سر او!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 130 جان، در پس ان زلف سیه پوش گریخت %~% و آرام و قرار، از من بیهوش گریخت(@)(@@) (@@) زلف تو، چو دزدید دلم، هندو وار %~% قد خم زد و رفت، در پس گوش گریخت!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 1301 سودت، به زیان من تعلق دارد %~% نامت، به زبان من تعلق دارد(@)(@@) (@@) رنهار، سر زلف تو را چون داری %~% الغیره %~% کان رشته، به جان من تعلق دارد(@)(@@) (@@) 1302 ای فتنهآ عاشقان بیدل که تویی %~% وی حاکم ساحران بابل که تویی(@)(@@) (@@) با زلف بگو، چو بر رخت تکیه زند %~% ای هندوی نیکبخت مقبل که تویی!(@)(@@)(@@)(@@) | تغیره(@)(@@) (@@) 1302 بی آنکه به کس رسید، زوری از ما %~% یا گشت پریشان، دل موری از ما(@)(@@) (@@) ناگاه، برآورد بدین رسوایی %~% شوریده سر زلف تو، شوری از ما(@)(@@)(@@)(@@) | تغیره(@)(@@) ~~130 زلف تو، که جز دل به جفا نشکند او در پای تو سر بشیوه می افکند او(@)(@@) ~~سا آنکه تو، بر فرق سرش می داریبر روی توبینی، چه زنخ در زند او!(@)(@@)(@@)(@@) | صدر خجندی(@)(@@) ~~1304 زلفت، که همیشه سرفرازی می کرد در باغ رخت، دست درازی می کرد(@)(@@) (@@) ار خیره کسی، سرس ببایس برید %~% هندو بچه مست بود، بازی می کرد!(@)(@)PageV01P273(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0277.jpg)(@)(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 1306 زلفت، به لبت دست درازی می کرد %~% هر لحظه، به خون خلق بازی می کرد(@)(@@) (@@) جانا، سره کردی که سرش ببریدی %~% آن هندو را، که ترکتازی می کرد!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1307 چشم تو، دل خلق زناگه ببرد %~% لعل تو، هزار زاهد از ره ببرد(@)(@@) (@@) بازیگر زلف تو، به یک بوالعجبی %~% از حقهآ چرخ، مهرهآ مه ببرد!(@)(@@) (@@) 1308 یارم، زشکر خنده شکر می شکند %~% وله %~% وان ترک، گله بر گل تر می شکند(@)(@@) (@@) واندر خم زلف، صد هزاران دل را %~% بر می شکند، چنانکه بر می شکند(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 1309 آن زلف نگر، چگونه پر دستان است %~% گویی 
ms132	 که کمند رستم دستان است(@)(@@) (@@) یازنده بدان زلف، بسی دستان است %~% اوله %~% دستی که بدان زلف رسد، دست آن است!(@)(@@) (@@) 1310 بالای تو ای ماه، بلای دل ماست %~% رعنایی نرگست، عنای دل ماست(@)(@@) (@@) گفتی : ««سر زلف ماست، جای دل تو!») %~% جای همه دلهاست، چه جای دل ماست!(@)(@@)(@@)(@@) | جمال خجندی(@)(@@) ~~1311 تا وسوسهآ عشق تو، در خانهآ ماستپبیوسته، میان خلق افسانهآ ماست(@)(@@) (@@) زنجیر سر زلف تو، زان دارم دوست %~% کان، لایق پای دل دیوانهآ ماست(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1312 از پیش دلم، خوش پسرا دور مشو! %~% ای دوست، خدا راو مرا دور مشو!(@)(@@) (@@) ور زانکه به جستن دلم خواهی شد %~% گرد سر زلف خود برآ، دور مشو!(@)(@@)(@@)(@@) | معین طنطرانی(@)(@@) (@@) 1313 در کوی تو در گذر چو کردم رایت %~% تا بو که ببینم رخ شهر آرایت(@)(@@) (@@) در پای فکندی سر و، من چون زلفت %~% می خواستم آن دم، که فتم در پایت!(@)(@@) (@@) 1314 زلف خوش مشک رنگ عنبر سایت %~% الغیره %~% آمد بر سر، چو گشت هم بالایت(@)(@@) (@@) زنهار، به سر باز مزن بگذارش %~% تا رقص کنان، بوسه زند بر پایت!(@)(@)PageV01P274(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0278.jpg)(@)(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 1315 یک چند، به کین زلف عنبر سایت %~% کو همسریی نمود با بالایت(@)(@@) (@@) دستی به صد انگشت، زنم در زلفت %~% بوسی به هزار لب، دهم بر پایت!(@)(@@) جمال عبدالرزاق(@)(@@) ~~131 بر آتش غم فتاده، چون زلف توام سر خیره به باد داده، چون زلف توام(@)(@@) (@@) پا آنکه زخط برون نهادستی پای %~% سر برخط تونهاده، چون زلف توام(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 1311 گفتی که: به زلف در کجا دارم دل؟ %~% بنمای به من، تا به تو بسپارم دل!(@)(@@) (@@) بگشای سر زلف و، نگه کن تا من %~% وله %~% چون از سر زلف تو برون آرم دل!(@)(@@) (@@) 1317 جایی که به جان زلف تو پرواز دهد %~% دل را نبود زهره، که آواز دهد(@)(@@) (@@) کار من و زلفت، ز دو بیرون نبود %~% دل بازدهد، ورنه دلم بازدهد!(@)(@@)(@@)(@@) | کمال اسماعیل(@)(@@) (@@) 1315 ای جان و جهان را مدد از 
ms133	 بیش و کمت %~% حیران شده عقل، از صفت بیش وکمت(@)(@@) (@@) روزی صد بار، همچو زلف بخمت %~% اندیشه فرو رفته زسرتا قدمت(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 132 رشک آیدم از جعد تو، ای عشوه فروش %~% کو، روی تو را چنان کشد در آغوش(@)(@@) (@@) زین پس، نشوم جدا از آن چشمهآ نوش %~% چون زلف تو، تامرا بود بر سر دوش!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 1321 زلف تو، که در سیه گری چاکر توست %~% گویی که زمشک افسری بر سر توست(@)(@@) (@@) سر بر زانو چرا نهادهست، چومن؟ %~% آخر، نه به ناز روز و شب در بر توست!(@)(@)PageV01P275(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0279.jpg)(@)(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1322 زلف تو، که چون او نبود خیره سری %~% مشکی است، کزو سوخته شد هر جگری(@)(@@) (@@) چون گرد میان او در آید گویی %~% ماری اشت، که حلقه می شود بر کمری(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1323 لعل توه ز لطف صورت جان دارد %~% خطت، صفت مهر سلیمان دارد(@)(@@) (@@) و ین طرفه، که با مهر سلیمان زلفت %~% اوله %~% دیوی است، که باد را به فرمان دارد!(@)(@@) (@@) 1324 لعل تو، طریق مهر بانی داند %~% هر شیوه که در لطف تو دانی، داند(@)(@@) (@@) زلفین تو، هم دلبر و هم دلدارند %~% هندو، دزدی و پاسبانی داند!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 1325 هر شب، زغمت تازه عذابی بینم %~% در دیده به جای خواب، آبی بینم(@)(@@) (@@) وانگه، که چو نرگس تو خوابم ببرد %~% آشفته تر از زلف تو، خوابی بینم!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1326 چشمم، چو بر آن روی نکو می آید %~% خونابه به جای آب، از او می آید(@)(@@) (@@) هرجا که سیه گلیمی، آشفته سری است %~% در حلقهٔ‌ زلف او، فرو می آید!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1327 احوال منت، باور اگر نیست زکس %~% وراین دو گواهت زرخ و اشک، نه بس(@)(@@) (@@) بیماری من، به چشم خود می بینی %~% اوله %~% آشفتگیم نیز، ز زلفت بر رس!(@)(@@) (@@) 1328 امشب، که نشان روز در عالم نیست %~% بالای شب، از روزقیامت کم نیست(@)(@@) (@@) زلف تو، نشاندهست بدین روز مرا %~% ورنه، شب من بدین درازی هم نیست!(@)(@)PageV01P276(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0280.jpg) 
ms134	(@)(@)(@@)(@@)(@@) | ول(@)(@@) (@@) گفتم که بگیرمش، چوبشنید سخن 1329 مویی، که زفرق آن دلارای برفت %~%(@)(@@) اوله %~% بر بود دل مرا و، از پای برفت %~% با آنهمه پر دلی، هم ازجای برفت!(@)(@@) ~~133 هنگام سحر، باد صبا می آمدوزوی، بویی بس آشنا می آمد(@)(@@) (@@) بی می بردم، که از کجا می آید %~% اوله %~% هم، از سر زلف یار ما می آمد!(@)(@@) ~~در جنبش باد، زلفکان تو چنانک 133 ای کرده رخت به ماه و اختر بازی(@)(@@) %~% اوله %~% هندو بچگان کنند چنبر بازی %~% وی عادت من در ره تو سربازی(@)(@@) (@@) 1332 ای زلف، که روز من سیه می داری %~% بر پای دلم بیگه و گه می داری(@)(@@) (@@) دانی که دل من، دل شیران دارد %~% زانش، به دو زنجیر نگه می داری!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1333 از زلف تو گشت سر سبک باد سحر %~% وز بوی تو گشت دل تنک باد سحر(@)(@@) (@@) در گرد سر زلف تو، کس می نرسد %~% اوله %~% جز باد سحرگهی، خنک باد سحرا(@)(@@) ~~1334 گر من، ز زمانه حاصلی داشتمی چون زلف تو، هم کرده امی در سر تو(@)(@@) %~% بر هر مویی، اگر دلی داشتمی! %~% خود را زتو، کی چون خجلی داشتمی؟(@)(@@) ~~1335 زلف تو دلم برد و، به قصد جان شد درتاب شد از نخست و، در خود(@)(@@) پیچید %~% وله %~% قد خم زد و، در زیر گله پنهان شد. %~% گفتم که بگیرمش، زمن ترسان شد PageV01P277(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0281.jpg)(@)(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 133 دل، از غم توبی سر وسامان ماندهست %~% جان، از تو و از خوی تو حیران ماندهست(@)(@@) (@@) گر بر سر تو نمی رسد جز زلفت %~% او نیز، در این کار پریشان ماندهست!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 1337 ای آنکه چوقدت زچمن سرو نخاست %~% با ما، سخنی گوی چو بالای توراست(@)(@@) (@@) می من خوردم، چشم تو مخمور زچیست؟ %~% دیوانه منم، زلف تو آشفته چراست؟(@)(@@)(@@)(@@) | عماد محمود(@)(@@) (@@) 1338 در موسم وعده، ناز در پیش افتاد %~% گفتم که: «رچه شیوه باز در پیش افتاد؟»)(@)(@@) (@@) دزدیده به زلف بنگرید، آنگه گفت: 
ms135	 %~% «(کاری دو، چنین دراز، در پیش افتاد!»)(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 1339 با من، دل تو به مهر آموخته نیست %~% یک شمع وفا، در دلت افروخته نیست(@)(@@) ~~گفتی که: («سر زلف سیاهم مشک است!)مشک است، ولی بی جگر سوخته نیست!(@)(@@)(@@)(@@) | کمال خجندی(@)(@@) (@@) 1340 ای قند فراخ از شکر تنگ خوشت %~% من، بندهآ آن عتاب و آن جنگ خوشت(@)(@@) (@@) زلف تونیم من، که به هرباد کنم %~% پهلوتهی از عارض گلرنگ خوشت!(@)(@@)(@@)(@@) | دختر سالار(@)(@@) ~~1341 با درد تو، نیست روی درمان دیدن دشوار بود، وصل تو آسان دیدن(@)(@@) (@@) من، دوش به خواب دیده ام زلف تورا %~% گویی چه بود خواب پریشان دیدن؟(@)(@@)(@@)(@@) | پسر سله (؟) گنجه(@)(@@) (@@) 1342 هندوی سر زلف تو، ای شهر آرای %~% چون ترک، به یغمای ختن دارد رای(@)(@@) (@@) در پای تو می افتد و، دل می دزدد %~% داند که: بود روزی هندو در پای!(@)(@@)(@@)(@@) | رکن پسر قاضی(@)(@@) (@@) 1343 گیرم که رخت رونق نسرین بشکست %~% با خط تو بازار دل و دین بشکست(@)(@@) (@@) زلف تو، زهر باد چرا می شکند؟ %~% آخر، نه هزار قلب در چین بشکست!(@)(@@) (@@) 1344 دیدار رخت، به چشم بینا برمن %~% لغیره %~% لعلت، به هزار کان و دریا بر من(@)(@@) (@@) مشکین زلفت، با همه آهو و هنر %~% سر بسته به صد نافهآ بویا بر من PageV01P278(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0282.jpg)(@)(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 1345 زلف تو، زمشک سوده زه می بندد %~% عیبش نکنم، که خوش زره می بندد(@)(@@) (@@) زان زلف شکن شکن، گره بازگشا %~% کز غصهآ او، عود گره می بندد!(@)(@@)(@@)(@@) | سید اشرف(@)(@@) (@@) 1346 چشمم، زگل تو دستهای می بندد %~% وان دسته، چوراه خسته ای می بندد(@)(@@) (@@) زلف تو، دل مرا به زنجیر ببست %~% شکر است، که هم شکستهای می بندد!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1347 در پستهآ لبهات، شکر می جنبد %~% وز لطف، میان او گهر می جنبد(@)(@@) (@@) من، بیش ز زلف تو شکایت نکنم %~% کاین سلسله، از جای دگر می جنبد!(@)(@@)(@@)(@@) | محمد اردبیلی(@)(@@) (@@) 348) آو یخته بودی آن دل انگیخته را %~% آن با دو هزارفتنه آمیخته را(@)(@@) (@@) گر 
ms136	 بود گنهکار، خود آو یخته بود %~% سر بهر چه می بریدی آو یخته را؟(@)(@@)(@@)(@@) | صدر لربختیاری(@)(@@) (@@) 1349 زلف تو، اگر نمی نهد پیمان را %~% سر از بن گوش بر خطت فرمان را(@)(@@) (@@) در روی تو آخر، زنخی بیش نزد %~% چندین تو بر انگشت چه پیچی آن را!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1350 زلف تو، که آزارش کس نپسندد %~% چون رشتهآ شب، چرا گره می بندد(@)(@@) (@@) شب، دعوی همرنگی او کرد به لاف %~% در صبح نگر، که چون بر او می خندد!(@)(@@)(@@)(@@) | شهریاری(@)(@@) ~~1351 در عشق تو، حال خود تبه نتوان داشتوین خیره کشی از تو گنه نتوان داشت(@)(@@) (@@) زنجیر سر زلف تو، هر دل که بدید %~% در سینه، به زنجیر نگه نتوان داشت!(@)(@@) (@@) 1352 آن ماه، که دل زبهر اوایمن نیست %~% ظهیر %~% در طرهآ او، قرار خود ممکن نیست(@)(@@) (@@) سودای وی از چیست، که چندین زنجیر %~% بر هر مویی نهاد، هم ساکن نیست!(@)(@@)(@@)(@@) | شمس سجاسی(@)(@@) (@@) 1353 گر در طلب چون تو کسی خواهم بود %~% بی غم، نه همانا نفسی خواهم بود(@)(@@) ودای سر زلف تو دارم در سر %~% چون زلف تو آشفته بسی خواهم بود PageV01P279(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0283.jpg)(@)(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 1354 با زلف تو گفت چشم بی آهویت %~% کای خشک شده دماغ مشک از بویت(@)(@@) (@@) آری نه چو تو زمشک چوگان باشی %~% میدان زگل و، ز ماه زیبد گویت؟(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 1355 با من، خویت ز ناخوشی می جنبد %~% چشم خوشت، از کمانکشی می جنبد(@)(@@) (@@) با زلف تو، حال دل خود چون گویم؟ %~% کو خود زسر مشوشی می جنبد!(@)(@@)(@@)(@@) | تفلیسی شروانی(@)(@@) (@@) 1356 زلفت، که دل شکسته در بند وی است %~% خون دو هزارخسته، در بند وی است(@)(@@) (@@) با آنکه به بند محکمش می داری %~% چندین دل خسته، بسته در بند وی است(@)(@@)(@@)(@@) | رشید شروانی(@)(@@) (@@) 1357 ای لعل لبت گوهر دل بشکسته %~% جان از ستمت، به نیم جانی رسته(@)(@@) (@@) از دست غمت، دو اسبه بگریختمی %~% پایم، به دو زلفت ار نبودی بسته!(@)(@@)(@@)(@@) | وله(@)(@@) ~~1358 گر چشم خوشت 
ms137	 زند بر آن زلف زنخ او راست روا، بر آنچنان زلف زنخ(@)(@@) (@@) زیرا به زنخ زدن دلم برد، آن زلف %~% زنهار، چه خوش می زند آن زلف زنخ!(@)(@@) (@@) 1359 کوسر، که ز طره تو بگریخته نیست %~% اوله %~% کودل، که ززلف تو غم انگیخته نیست(@)(@@) (@@) چون طرهآ تو سرم ببری، شاید %~% از زلف تو، گر دلم [برا] آو یخته نیست(@)(@@)(@@)(@@) | اوله(@)(@@) ~~1360 ای زلف توبرده از دلم توش وتوانوزدیده چومهرت اشکم از دیده روان(@)(@@) (@@) گویند که: مار بر سر گنج بود %~% ها زلف تو مار و، ها رخت گنج روان!(@)(@@)(@@)(@@) | اوله(@)(@@) ~~رات رک سسه نورا دارم دوست(@)(@@)(@@)(@@) | ت . ی(@)(@@) ~~1322 زلف تو، که دلبند جوانمرد است(@)(@@) ~~تا حال من وتو دید، بر هم پیچید PageV01P280(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0284.jpg)(@)(@)(@@)(@@)(@@) | تاج خلاطی(@)(@@) (@@) 1363 مشکین رسن زلف تو، روز افزون است %~% بر آتش رخسار، قرارش چون است(@)(@@) (@@) آو یخته، از جام لبت می نوشد %~% دیوانگی، ای نگار گوناگون است!(@)(@@)(@@)(@@) | ظهیر شفروه(@)(@@) ~~1364 چون دیده بر آن پریوشم می افتد در چشم ودل، آب و آتشم می افتد(@)(@@) (@@) چون زلف گر افتدم، فتم در پایش %~% و افتادگیی چنین، خوشم می افتد!(@)(@@)(@@)(@@) | شمس طبسی(@)(@@) ~~آن زنگی سرشکسته، ره کی زده است؟ 1365 بر عارض مه، گرد شب انگیخته ای(@)(@@) %~% ول %~% کز کنگرهآ مهش در آو یخته ای! %~% بر سرو روان، رنگ گل آمیختهای(@)(@@) (@@) 1366 بستان ارم، به گرد کویت نرسد %~% آسیب فلک، به ماه رویت نرسد(@)(@@) (@@) حورشید، که او آینهآ گردون است %~% گر شانه شود، بتا به مویت نرسد!(@)(@@)(@@)(@@) | عماد شروانی(@)(@@) (@@) 1367 زلفت، که زبالای جهان در گوید %~% گاه از سر آن سرو روان در گوید(@)(@@) (@@) چون تکیه گهی چو آفتابش باشد %~% شاید که سخن زآسمان در گوید!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 1368 گفتم به بتم که: ««زلف هندوی تودوش %~% دزدید دلم، باز بده، یا بفروش!))(@)(@@) (@@) گفتا که: «(شکنجه کردمش، نیست مقر» %~% گفتم که : «در آویزش!» گفت: ««از بن گوش!»(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 1365 زلف تو، که گوش تا به دوش آمده است 
ms138	 %~% آهسته و نرمک و خموش آمده است(@)(@@) (@@) هان، حلقهآ گوش را نگه دار ز زلف %~% کان هندوی دل دزد، به گوش آمده است(@)(@@)(@@)(@@) | شمس مسعود(@)(@@) (@@) 1370 زلف تو، که این دلم به پیوند وی است %~% دل، بندهآ آن زلف وخداوند وی است(@)(@@) (@@) در بند دلم نبود هرگز روزی %~% با آنکه دلم همیشه در بند وی است(@)(@@)(@@)(@@) | عیانی گنجه ای(@)(@@) (@@) 1371 هندوی تو را، گردن و سر پیخته به! %~% مشکش همه از حلقه فرو ریخته به!(@)(@@) (@@) در زیر کله مکن به زندان او را %~% او هست کشندهآ من، آویخته به!(@)(@)PageV01P281(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0285.jpg)(@)(@)(@@)(@@)(@@) | سید مرتضی(@)(@@) ~~1372 در دهر، کسی به گلغداری نرسید تا بر دلش از زمانه، خاری نرسید(@)(@@) (@@) چون شانه، که تا سرش به صد شاخ نشد %~% دستش، به سر زلف نگاری نرسید(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1373 زلفت، که صبا عبیر می ساید ازو %~% پیوسته دل سوخته می زاید ازو(@)(@@) (@@) چون زادهآ کلک من، به شرح غم تو %~% مشکی است، که بوی خون همی آید ازو!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1374 زلف تو، که پشتش آنچنان رویی هست %~% صد جانش، اسیر زیر هر مویی هست(@)(@@) (@@) از روی تو، افتاد به روزی نیکو %~% یارب، که چه نیکروز هندو یی هست!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 1375 گفتم که: دلم زعشقت، ای عشوه پرست %~% دیوانه شد و، زدست من خواهد جست(@)(@@) (@@) بگرفت به دست زلف، گفتا که: مترس! %~% یعنی که: بدین سلسله اش خواهم بست!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1376 گفتم که: گرفت عارضت آرایش %~% آن خط چه کنی؟ به زیر زلفت جایش!(@)(@@) (@@) گفتا که رها کنش که سودایی گشت %~% تا سلسلهآ زلف نهم بر پایش!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 1377 بندش چوز زلف چون رسدن، باز شود %~% دل بسته میان جان رسن باز شود(@)(@@) (@@) بی عقل دلی هست، وگرنه به چه عقل %~% در ظلمت شب بدان رسن، باز شود!(@)(@@)(@@)(@@) | یحیی تبریزی(@)(@@) (@@) 1378 چشم تو، که نیست جز ستم یاد او را %~% از فتنه ندیدهست کس آزاد او را(@)(@@) (@@) زلف تو، که او به باد از هم برود 
ms139	 %~% در بردن دل، چه می دهی باد او را!(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 1379 دل، هر چه زآشکار و پنهان گوید %~% زان زلف دراز عنبر افشان گوید(@)(@@) (@@) این آشفتهست و آن پریشان، دائم %~% آشفته، سخنهای پریشان گوید!(@)(@@) نجیب گنجهای(@)(@@) (@@) 138 زلفت، که تو را به چشم در می آید %~% گرچه بر چشم تو به سر می آید(@)(@@) (@@) هندوست، ورا زچشم خود دور افکن %~% زیرا که به روی ترک بر می آید!(@)(@)PageV01P282(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0286.jpg)(@)(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1381 زلفت، که دلم را زعنا می پیچد %~% پیوسته سر از عهد و وفا می پیچد(@)(@@) ~~گرفعل تونیست [آن] سیه کار آخر در پای تو، هر لحظه چرا می پیچد؟(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1382 آن شانه، که او در خور زلف توشود %~% آید، به حیل همبر زلف تو شود(@)(@@) (@@) ترسم که سرزلف تورا راست کند %~% وانگاه، سرش در سرزلف تو شود!(@)(@@)(@@)(@@) | اوله(@)(@@) ~~33) زلف توم که چون خودم پریشان دارد در هر تاری، دلی به زندان دارد(@)(@@) (@@) سی زخم، چگونه می کشد مردم را %~% اوله %~% آن مار که نه زهر، نه دندان دارذ!(@)(@@) (@@) 1384 از جام لبت، گرچه به بویی مستم %~% بر تو نرسد، به هیچ رویی دستم(@)(@@) (@@) از زلف توام، فتاد مویی در دست %~% از دست فراق تو، به مویی رستم!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1385 زلف تو، که صد هزار چین بر چین است %~% من کافرم، ارمشک چنان در چین است(@)(@@) ~~1386 خطت، که به زلف حسن بر چین دارد گویند: به چین مشک فراوان باشد(@)(@@) %~% اوله %~% خود مشک دو زلف تو، سراسر چین است! %~% بیرامن مه، زمشک پرچین دارد(@)(@@) (@@) زلفت، چو دل خستهآ بیچارهآ من %~% آواره، هزار دل به هر چین دارد!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1387 گفتم: مگر از حال دلم وا دانی گفتم که: بگیرم سرزلفت، بکشم %~%(@)(@@) وله %~% گفتا که: دراز می کشی! تادانی! %~% گفتا که: برو، خیره مکن نادانی!(@)(@@) ~~1388 هر چند، که زلفت زعنا خست مرا سودای سر زلف تودارم، شب و روز(@)(@@) %~% سودای سیه بین، که گرفته ست مرا! %~% صدبار، 
ms140	 به حیله کرد پابست مرا(@)(@@) (@@) 1389 زلفت، که به رنگ و بوی او می نازی %~% ول %~% با خال تو کرد بازی، از طتازی PageV01P283(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0287.jpg)(@)(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 1390 بر زلف تو، کآب مشک سارا ببرد %~% رونق ز هزار مشک بویا ببرد،(@)(@@) (@@) باد ار به خطا گذر کند، مشک ختن %~% از چین دو زلف توبه یغما ببرد(@)(@@)(@@)(@@) | اله(@)(@@) (@@) 1391 گر مشک، به چین نافهآ آهودارد %~% عالم، ز نسیم خویش خوشبودارد(@)(@@) (@@) در چین دو زلف تو، که صد چینش بیش %~% مشکی است، نه زان مشک که آهودارد!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 1392 هر دل، که در آن زلف دو تا می افتد %~% شک نیست، که در دام بلا می افتد(@)(@@) (@@) چون ترک دلم، هندوی خال لب توست %~% وله %~% در چین دو زلفت، به خطا می افتد(@)(@@) (@@) 1393 زلف تو، چو از رخت جدا می افتد %~% بنگر، ز کجا تا به کجا می افتد(@)(@@) (@@) او نیز اگر نیست چو من، عاشق تو %~% وله %~% در پای تو، هر لحظه چرا می افتد؟(@)(@@) (@@) 1394 تا بوی نهفته کرد پیدا، زلفت %~% یهلو نزند مشک ختن، با زلفت(@)(@@) (@@) از هر چه برونام درازی افتد %~% پای قد تو ندارد، الآ زلفت(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1395 مه، گر چه به رخ چون رخ زیبای تونیست %~% یا سرو به قد، چون قدو بالای تونیست(@)(@@) (@@) هنگام سیاهکاری و شیفتگی %~% اوله %~% جز زلف، کسی همسر و همپای تونیست!(@)(@@) (@@) 1396 ای رفته مرا هوای زلفت در سر %~% پای هوس زلف تو دارد هر سر(@)(@@) (@@) با زلف تو، مشک لاف خوشبویی زد %~% هم، زلف معنبر تو آمد بر سر(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1397 زلف تو، که بند و چنبرش را دیدم %~% و آشفتگی و شور و شرش را دیدم(@)(@@) (@@) از بس که ستیزه برد با عارض تو %~% در پای تو افتاده سرش را دیدم(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 139 شهد لب تو، قیمت شکر شکند %~% مشک خط تو، رونق عنبر شکند(@)(@@) (@@) عالم، همه بوی مشک وعنبر گیرد %~% گر باد، دو زلسف توبهم بر شکند PageV01P284(@)(@@) ![image 