ms557	 يوم القيامة فيقال لهم : أحيوا ما خلقتم ) )(@)(@@) ( ق ن ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 5211 ) قال النبي :(@)(@@) | 30 ( إن الذين يقطعون السدر يصبون في النار على رؤوسهم صبا ) )(@)(@@) ( هق ) عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 5212 ) قال النبي :(@)(@@) | 30 ( إن الله أبى ذالك لكم ورسوله أن يجعل لكم أوساخ أيدي الناس ) )(@)(@@) ( طب ) عن عبد المطلب بن ربيعة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5213 ) قال النبي :(@)(@@) | 30 ( إن الله أبى علي فيمن قتل مؤمنا ، ثلاثا ) )(@)(@@) ( حم ن ك ) عن عقبة بن مالك الليثي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5214 ) قال النبي :(@)(@@) | 30 ( إن الله أبى لي أن أتزوج أو أزوج ألا أهل الجنة ) )(@)(@@) ( ابن عساكر ) عن هند بن أبي هالة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 5215 ) قال النبي :(@)(@@) | 30 ( إن الله اتخذني كما اتخذ إبراهيم خليلا ، فمنزلي ومنزل إبراهيم في الجنة يوم القيامة تجاهين ، والعباس بيننا مؤمن بين خليلين ) ( ه ) PageV02P253 عن ا$ بن عمرو رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 5216 ) قال النبي :(@)(@@) | 30 ( إن الله اتخذني خليلا كما اتخذ إبراهيم خليلا ، وإن خليلي أبو بكر ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5217 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى أجاركم من ثلاث خلال : أن لا يدعو عليكم نبيكم فتهلكوا جميعا ، وأن لا يظهر أهل الباطللعلى أهل الحق ، وأن لا تجتمعوا على ضلالة ) )(@)(@@) ( د ) عن أبي مالك الأشعري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5218 ) قال النبي :(@)(@@) | 30 ( إن الله احتجر التوبة على كل صاحب بدعة ) )(@)(@@) ( ابن فيل طس هب والضياء ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5219 ) قال النبي :(@)(@@) | 30 ( إن الله أحدث في الصلاة أن لا تكلموا إلا بذكر الله ، وما ينبغي لكم ، وأن تقوموا لله قانتين ) ( ن ) عن ا$ بن مسعود رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5220 ) قال النبي :(@)(@@) | 30 ( إن الله اختار لكم من الكلام أربعا ، ليس القرآن وهن من القرن : سبحان الله ، والحمد لله ، ولا إلاه إلا الله ، والله أكبر ) )(@)(@@) ( طب ) عن أبي الدرداء رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5221 ) قال النبي :(@)(@@) | 30 ( إن الله اختار من بني 
ms558	 آدم العرب ، واختار من العرب مضر ، ومن مضر قريشا ، واختار من قريش بني هاشم ، واختارني من بني هاشم ، فأنا من خيار إلى خيار ، فمن أحب العرب فبحبي أحبهم ، ومن أبغض العرب فببغضي أبغضهم ) )(@)(@@) ( ك ) عن ابن عمرو رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 5222 ) قال النبي :(@)(@@) | 30 ( إن الله اختارني واختار لي أصحابا ، واختار لي منهم أصهارا وأنصارا ، فمن حفظني فيهم حفظه الله ، ومن آذاني فيهم آذاه الله ) )(@)(@@) ( خط ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5223 ) قال النبي :(@)(@@) | 30 ( إن الله اختارني واختار لي أصحابي ، فجعل لي PageV02P254 منهم وزراء وأصهارا وأنصارا ، فمن سبهم فعليه لعنة الله والملائكة والناس أجمعين ، لا يقبل الله منه صرفا ولا عدلا ) )(@)(@@) ( طب ) عن عويمر بن ساعدة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5224 ) قال النبي :(@)(@@) | 30 ( إن الله اختارني واختار لي أصحابي وأصهاري وسيأتي قوم يسبونهم ويبغضونهم فلا تجالسوهم ولا تشاربوهم ولا تواكلوهم ولا تناكحوهم ) )(@)(@@) ( هق ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5225 ) قال النبي :(@)(@@) | 30 ( إن الله أخذ الميثاق من ظهر آدم بنعمان يوم عرفة ، وأخرج من صلبه كل ذرية ذرأها فنثرهم بين يديه كالذر ثم كلمهم قبلا قال : ألست بربكم ؟ قالوا : بلى ) )(@)(@@) ( حم ن ك ) في الأسماء عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 5226 ) قال النبي :(@)(@@) | 30 ( إن الله أخذ ذرية آدم من ظهره ثم أشهدهم على أنفسهم ألست بربكم ؟ قالوا : بلى ، ثم أفاض بهم في كفيه فقال : هاؤلاء في الجنة وهاؤلاء في النار ، فأهل الجنة ميسرون لعمل أهل الجنة ، وأهل النار ميسرون لعمل أهل النار ) )(@)(@@) ( البزار طب هق ) عن هشام بن حكيم رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5227 ) قال النبي :(@)(@@) | 30 ( إن الله أخرجني من النكاح ، ولم يخرجني من السفاح ) )(@)(@@) ( هب ) عن محمد بن علي مرسلا ( ز ) .(@)(@@)(@@)(@@) $ ( 5228 ) قال النبي :(@)(@@) | 30 ( إن الله إذا أحب إنفإذ أمر سلب كل ذي لب لبه ) )(@)(@@) ( خط ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 5229 ) قال النبي :(@)(@@) | 30 ( إن الله إذا أحب أهل بيت أدخل عليهم الرفق ) )(@)(@@) ( ابن أبي الدنيا في 
ms559	 ذم الغضب ، والضياء ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5230 ) قال النبي :(@)(@@) | 30 ( إن الله إذا أحب عبدا جعل رزقه كفافا ) )(@)(@@) ( أبو الشيخ ) عن علي رضي الله عنه .(@)(@@) PageV02P255(@)(@@)(@@)(@@) $ ( 5231 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى إذا أحب عبدا دعا جبريل فقال : إني أحب فلانا فأحبه فيحبه جبريل ، ثم ينادي في السماء فيقول : إن الله تعالى يحب فلانا فأحبوه فيحبه أهل السماء ثم يوضع له القبول في الأرض ، وإذا أبغض عبدا دعا جبريل فيقول : إني أبغض فلانا فأبغضه فيبغضه جبريل ثم ينادي في أهل السماء إن الله يبغض فلانا فأبغضوه فيبغضونه ثم يوضع له البغضاء في الأرض ) )(@)(@@) ( م ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5232 ) قال النبي :(@)(@@) | 30 ( إن الله إذا أحب قوما ابتلاهم ، فمن صبر فله الصبر ، ومن جزع فله الجزع ) )(@)(@@) ( حم ) عن محمود بن لبيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5233 ) قال النبي :(@)(@@) | 30 ( إن الله إذا أراد إمضاء أمر نزع عقول الرجال حتى يمضي أمره ، فإذا أمضاه رد إليهم عقولهم ووقعت الندامة ) )(@)(@@) ( أبو عبد الرحمن السلمي في سنن الصوفية ) عن جعفر بن محمد عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 5234 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى إذا أراد أن يجعل عبدا للخلافة مسح يده على جبهته ) )(@)(@@) ( خط ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5235 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى إذا أراد أن يخلق خلقا للخلافة مسح يده على ناصيته فلا تقع عليه عين إلا أحبته ) )(@)(@@) ( ك ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 5236 ) قال النبي :(@)(@@) | 30 ( إن الله إذا أراد أن يهلك عبدا نزع منه الحياء ، فإذا نزع منه الحياء لم تلقه إلا مقيتا ممقتا ، فإذا لم تلقه إلا مقيتا ممقتا نزعت منه الأمانة ، فإذا نزعت منه الأمانة لم تلقه إلا خائنا مخونا نزعت منه الرحمة ، فإذا نزعت منه الرحمة لم تلقه إلا رجيما ملعنا نزعت منه ربقة الإسلام ) )(@)(@@) ( ه ) عن ابن عمر رضي الله عنهما .(@)(@@) PageV02P256(@)(@@)(@@)(@@) $ ( 5237 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى إذا أراد بالعباد نقمة أمات الأطفال ، وعقم النساء 
ms560	 ، فتنزل بهم النقمة وليس فيهم مرحوم ) )(@)(@@) ( الشيرازي في الألقاب ) عن حذيفة وعمار بن ياسر معا رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 5238 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى إذا أراد رحمة أمة من عباده قبض نبيها قبلها فجعله لها فرطا وسلفا بين يديها ، وإذا أراد هلكة أمة عذبها ونبيها حي فأهلكها وهو ينظر فأقر عينه بهلكتها حين كذبوه وعصوا أمره ) )(@)(@@) ( م ) عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5239 ) قال النبي :(@)(@@) | 30 ( إن الله استودع شيئا حفظه ) )(@)(@@) ( حب هق ) عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 5240 ) قال النبي :(@)(@@) | 30 ( إن الله إذا أطعم نبيا طعمة فهي للذي يقوم من بعده ) )(@)(@@) ( د ) عن أبي بكر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5241 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى إذا أنزل سطواته على أهل نقمته فوافت آجال قوم صالحين فاهلكوا بهلاكهم ثم يبعثون على نياتهم وأعمالهم ) )(@)(@@) ( هب ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 5242 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى إذا أنزل عاهة من السماء على أهل الأرض صرفت عن عمار المساجد ) )(@)(@@) ( ابن عساكر ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5243 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى إذا أنعم على عبد نعمة يحب أن يرى أثر النعمة عليه ، ويكره البؤس والتباؤس ويبغض السائل الملحف ، ويحب الحيي العفيف المتعفف ) )(@)(@@) ( هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 5244 ) قال النبي :(@)(@@) | 30 ( إن الله إذا أنعم على عبد نعمة يحب أن يرى أثر نعمته على عبده ) )(@)(@@) ( طب هق ) عن عمران بن حصين رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 5245 ) قال النبي :(@)(@@) | 30 ( إن الله إذا جعل لقوم عمادا أعانهم بالنصرة ) )(@)(@@) ( ابن قانع ) عن صفوان بن صفوان بن أسيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5246 ) قال النبي :(@)(@@) | 30 ( إن الله إذا ذكر شيئا تعاظم ذكره ) )(@)(@@) ( ك ) عن معاوية رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 5247 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى إذا رضي عن العبد أثنى عليه بسبعة أصناف من الخير لم يعمله ، وإذا سخط على العبد أثنى عليه بسبعة أصناف من الشر لم يعمله ) )(@)(@@) ( حم حب ) عن 