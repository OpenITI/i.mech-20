ms406	 بدسگال تو به حیلت نشود ملک روا %~% هیزم خشک به افسون ندهد میوه تر(@)(@@) 62 این هنرهاکه بود بخت جهانگیر ترا %~% عشوه زال جهانش نکند محو اثر(@)(@@) 63 جلوه حسن عروسان ختن‌کم نشود %~% از دلالی که کند پیرزنی در چادر(@)(@@) 64 حاسدت را نکند جامه دیبا زیبا %~% زشت را زشتی زایل نشود از زیور(@)(@@) 65 داورا راد امیرا ز خلوص تو مرا %~% جای آنست‌که جان رقص‌کند در پیکر(@)(@@) 66 چون‌کنم مدح توکوشم‌که سخن رانم بکر %~% تا مرا طعنه حاسد نکند خون به جگر(@)(@@) 67 چون منی بهر مدیح تو ز مادر بنزاد %~% هم مگر باز مرا زاید از نو مادر(@)(@@) 68 ز انکه رسمست که مادر چو دهد دخت به شوی %~% خوار گردد اگرش بکر نباشد دختر(@)(@@) 69 بفسرد طبع من ار چون تو نبیند ممدوح %~% خون خورد باکره گر فحل نیابد شوهر(@)(@@) 70 آب دارد سخنم‌گو نپسندد جاهل %~% سگ گزیده چه کند گر نکند زاب حذر(@)(@@) 71 تا ازبن‌کوره فیروزه‌که نامش فلک است %~% مهر هر روز برآید چو یکی بوته زر(@)(@@) 72 هرکرا بوته دل از زر مهر تو تهیست %~% باد چون کوره‌اش از کین تو دل پر آذر PageV1P214(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 آفتاب و سایه می‌رقصند با هم ذره‌وار %~% کافتاب دین و سایه حق شد امروز آشکار(@)(@@) 2 دفتر ایجاد را امروز حق شیرازه بست %~% تا درآرد فرد فرد اوصاف خود را در شار(@)(@@) 3 گلشن ابداع را امروز یزدان آب داد %~% تا ز سیرابی نهال صنع ‌گیرد برگ و بار(@)(@@) 4 کلک قدرت صورتی‌بر لوح هستی برنگاشت %~% وز تماشای جمال خود بدوکرد اقتصار(@)(@@) 5 صورت‌و صورت‌نگار از هم اگر دارند فرق %~% از چه این‌ صورت ندارد فرق با صورت‌نگار(@)(@@) 6 عکس صورتگر توان دید اندرین صورت درست %~% تا چه‌ معجز برده ‌صورتگر درین صورت به ‌کار(@)(@@) 7 راست پنداری به جای رنگ سودست آینه %~% تا در آن صورت ببیند عکس خویش آیینه‌وار(@)(@@) 8 قدرت حق آشکارا کرد امروز 
ms407	 آنچه بود %~% کز تماشای جمال خویشتن بد بیقرار(@)(@@) 9 در تمنای وصال خویش عمری صبر کرد %~% دست شوق آخر فرو درید جیب انتظار(@)(@@) 10 ناقد عشق آتشی زانگیز غیرت برفروخت %~% تا بدو نقد جمال خویش راگیرد عیار(@)(@@) 11 تا به‌کی در پرده‌گویم روز مولود نبی است %~% کاوست‌اندر پرده هم خود پردگی هم پرده‌دار(@)(@@) 12 احمد محمود ابوالقاسم محمد عقل‌کل %~% مخزن سر الهی رازدار هشت و چار(@)(@@) 13 همنشین لی مع الله معنی نون والقلم %~% رهسپار لیله الاسری سوی پروردگار(@)(@@) 14 در حجاب‌کنت کنزا بود حق پنهان هنوز %~% کاو خدا را بندگی کردی به قلب خاکسار(@)(@@) 15 ازگل آدم هنوز اندر میان نامی نبود %~% کاو شمار نسل آدم ‌کرد تا روز شمار(@)(@@) 16 نار و جنت بود در بطن مشیت مختفی %~% کاو گروهی را به جنت برد قومی را به نار(@)(@@) 17 آنکه ‌هر وصفی ‌که‌ گویی ‌در حقیقت ‌وصف اوست %~% راست ‌پنداری سخن‌ با نعت ‌او جست انحصار(@)(@@) 18 پیش از آن کز دانه باشد نام یا زین خاک نود %~% برگ و بار هر درختی دیدی اندر شاخسار(@)(@@) 19 آسمان عدل بد پیش از وجود آسمان %~% روزگار فضل بد پیش از ظهور روزگار(@)(@@) 20 پیش ازین لیل و نهار اندر قرون سرمدی %~% موی و روی احمدی واللیل بود و والنهار(@)(@@) 21 پیش‌ازآن کز صلب‌حکمت‌قدرت‌آبستن شود %~% در مشیمه مام دادی قوت طفل شیرخوار(@)(@@) 22 بچه امکان هنوز اندر مشیمه امر بود %~% کاو یتیمان را سر از رحمت ‌گرفتی در کنار(@)(@@) 23 گر مصورگشتی اخلاق‌کریمش در قلوب %~% ور مجسم‌گشتی اوصاف جمیلش در دیار(@)(@@) 24 بر حقایق در ضمایر تنگ بودی جایگاه %~% بر خلایق در معابر ضیق جستی رهگذار(@)(@@) 25 چون ‌به‌ هر دعوی ‌دو شاهد باید او مه ‌را دو کرد %~% زان‌دوشاهد دعوی دینش پذیرفت اشتهار(@)(@@) 26 سوماری‌ کاو سخن‌ گفتست‌ با شاهی چنان %~% بوسه جای انبیا زیبد لب آن سوسمار(@)(@@) 27 خلق از معراج او آگاه و او خود بیخبر %~% زانکه 
ms408	 بیخود رفت در خلوتسرای‌کردگار(@)(@@) 28 شور عشق احمدی بازم به جوش آورد دل %~% بلبل آری در خروش آید ز بوی نوبهار(@)(@@) 29 عشق‌را معنی‌بلندست‌و خردها سخت پست %~% دوس‌راقربان‌عزیزست ‌و روانهاسخت خوار(@)(@@) 30 ای‌ که یار نغز جویی *‌پای تا سر مغز شو %~% زانکه طبع دوست را از پوست ‌گیرد انزجار(@)(@@) 31 غرق عشق یار شو چونان‌که سر تا پای تو %~% ذکر حسن دوست‌گوید هر زمان بی‌اختیار(@)(@@) 32 گر ندانی عاشقی‌کردن ز مطرب یادگیر %~% کاو همی بی‌اختیار از شوق ‌گوید یار یار(@)(@@) 33 عشق را جایی رسان با دوست‌کز هر موی تو %~% جلوه‌های طلعت معشوق گردد آشکار(@)(@@) 34 عشق ‌چون ‌کامل ‌شود معشوق و عاشق را ز هم %~% می‌نشاید فرق کرد الا ز روی اعتبار(@)(@@) 35 باورت ناید به چشم سر نه با این چشم سر %~% فرق‌کن از روی معنی خواجه را با شهریار(@)(@@) 36 خسرو ایران محمد شه‌ که اسم و رسم او %~% تا به روز حشر ماند از محمد یادگار(@)(@@) 37 آنکه جامه قدرتش را در ازل نساج صنع %~% از مشیت رشت پود و از حمیت بافت تار(@)(@@) 38 خلق می‌گویند چون خورشید بنشیند به‌کوه %~% روز ش‌گردد خلاف من‌که دیدم چند بار(@)(@@) 39 شه‌ به ‌شب ‌خو‌رشید سان‌ بر اسب که ‌پیکر نشست %~% وز جمالش‌گشت همچون روز روشن شام تار(@)(@@) 40 آیت والنجم را آن لحظه بینی‌کز هوا %~% در جهد پیکان او بر خود خصم بد شعار(@)(@@) 41 خصم چون زلزال بأسش را نمی‌بیند به چشم %~% خفته غافل ‌کش به سر ناگه فرود آید حصار(@)(@@) 42 فتح ‌و فیروزی به‌ جاهش خورده سوگند عظیم %~% کش دوند اندر عنان آن از یمین این از یسار(@)(@@) 43 خسروا از نوک‌کلک خواجه پشت دولتت %~% دارد آن گرمی که دین مصطفی از ذوالفقار(@)(@@) 44 راست پنداری ‌که ‌کلک او شهاب ثاقبست %~% دولت تو چرخ و بدخواه تو دیوی نابکار(@)(@@) 45 تا همی تارکتان از تاب مه ریزد ز هم %~% تا همی آب بحار 
ms409	 از تف خورگردد بخار(@)(@@) 46 باد بختت تاب ماه و حاسدت تار کتان %~% باد تیغت تف مهر و دشمنت آب بحار(@)(@@) 47 لاف مسکینی مزن قاآنیا زانرو که هست %~% آستین خاطرت مملو ز در شاهوار PageV1P215(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 آفرین برکلک سحرانگیز آن صورت‌نگار %~% کز مهارت برده معنیها درین صورت به ‌کار(@)(@@) 2 راست پنداری مثالی ‌کرده زین تمثال نقش %~% از عروس ملک و شوی بخت و زال روزگار(@)(@@) 3 کرده یکسو نوعروسی نقش‌ کاندر صورتش %~% هر که بگشاید نظر عاشق شود بی‌اختیار(@)(@@) 4 از تنش ‌بیدا نزاکت همچو نرمی از حریر %~% در رخش پنهان لطافت همچو گرمی از شرار(@)(@@) 5 خیزران‌قد ارغوان‌خد ضیمران‌مو مشک‌بو %~% سیم‌سیما سروبالا ماه‌پیکر گلعذار(@)(@@) 6 چشم‌او بی‌سمه‌همچون‌چشم‌نرگس‌دلفریب %~% زلف او بی‌شانه همچون زلف سنبل تابدار(@)(@@) 7 بی‌عبارت رازگوی و بی‌اشارت رازجوی %~% بی‌تکلم دلفریب و بی‌تبسم جان‌شکار(@)(@@) 8 بی‌سروداز وجد در حالت‌چو شمشاداز نسیم %~% بی‌سروراز رقص‌در جنبش‌چو گل‌بر شاخسار(@)(@@) 9 از دو زلف او ودیعت هرچه درگردون فریب %~% در دو چشم او امانت هرچه در مستی خمار(@)(@@) 10 فتنه خوابیده در چشمش گروه اندر گروه %~% عنبر تابیده در زلفش قطار اندر قطار(@)(@@) 11 نونهال قامتش را لطف و خوبی برگ و بر %~% پرنیان پیکرش را ناز و خوبی پود و تار(@)(@@) 12 جادویی خیزد ز چشمش همچو وسواس از جنون %~% خرمی زاید ز چهرش چون طراوت از بهار(@)(@@) 13 در بهاران باغ دیدستی ‌که بار آورده سرو %~% سرو قد او نگر باری ‌که باغ آورده بار(@)(@@) 14 آنچه او دارد ز خوبی‌گر زلیخا داشتی %~% با همه عصمت ازو یوسف نمی‌کردی فرار(@)(@@) 15 همچنان‌کاشفته‌گردد صرع دار از ماه نو %~% ز ابرویش آشفته‌ گردد ماه نو چون صرع دار(@)(@@) 16 وز دگر سو روی بر رویش یکی زیبا پسر %~% کز جمالش خیره‌ گردد مغز مرد هوشیار(@)(@@) 17 صورتی بیجان ولیکن هرکسش بیند ز دور %~% زود بگشاید بغل‌ کش تنگ ‌گیرد در کنار(@)(@@) 18 فتنهای چشم او چون جور گیتی بی‌حساب 
ms410	 %~% حلقهای زلف او چون دور گردون بی‌شمار(@)(@@) 19 شهوت ‌انگیز است ‌رویش همچو سیمین‌ ساق ‌دوست %~% عنبرآمیزست زلفش همچو مشکین‌زلف یار(@)(@@) 20 گر چنین ‌رویی به ‌شب در مجلسی حاضر کنند %~% شمع بی‌پروا زند خود را بر او پروانه‌وار(@)(@@) 21 وز قفای او عجوزی دیو-خوی و زشت-‌روی %~% کز بنی الجان مانده در دوران آدم یادگار(@)(@@) 22 بینیش چون خرزه خر خاصه هنگام نعوظ %~% چانه‌اش چون خایه غرخاصه هنگام فشار(@)(@@) 23 موی او باریک و چرکین همچو تار عنکبوت %~% روی‌او تاریک و پرچین همچو چرم سوسمار(@)(@@) 24 چانه و بینیش گویی فربهی دزدیده‌اند %~% از دگر اعضاکه آنان فربهند اینان نزار(@)(@@) 25 بسکه در رخسارزشش چین بود بالای چین %~% زو نظر بیرون نیارد رفت تا روز شمار(@)(@@) 26 چانه و بینیش پنداری بهم‌چشمی هم %~% گوی و چوگان ساختندی از برای ‌کارزار(@)(@@) 27 بسکه‌ پی آورده سر گویی‌ که نجوی می کنند %~% بینی او با زنخدان چانه او با زهار(@)(@@) 28 در همه‌ گیتی بدین زشتی نباشد هیچ‌کس %~% ور بود باری نباشد جز حسود شهریار PageV1P216(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 از خجلت تیغ ملک و ابروی دلدار %~% دوشینه مه عید نگردید نمودار(@)(@@) 2 یا موکب شه‌گرد برانگیخت ز هامون %~% وان پرده‌یی از گرد برافکند به رخسار(@)(@@) 3 یا نقش سم دیونژاد ابرش شه دید %~% وز شرم نهان‌کرد رخ از خلق پریوار(@)(@@) 4 یا از قد خم‌ گشته زهاد ز روزه %~% خجلت‌زده‌ گردید و نگردید پدیدار(@)(@@) 5 گفتم به خرد کاین همه ژاژ ست بیان ‌کن %~% کاخر ز چه مه دوش نهان بود ز ابصار(@)(@@) 6 فرمود که دی نعل سمند شه غازی %~% فرسوده شد از صدمت جولان و شد ازکار(@)(@@) 7 از روی ضرورت به صد اکراه به سمش %~% بستند ورا بیخبر از شاه به‌ناچار(@)(@@) 8 گر دوش مه عید نهان بود نهان باد %~% تا هست به ‌گیتی اثر از ثابت و سیار(@)(@@) 9 فرداست ‌که از مشرق نصرت ‌کند اشراق %~% ماهیچه تابان علم شاه 
ms411	 جهاندار(@)(@@) 10 دارای جوان بخت حسن‌شاه‌که تیغش %~% در لجه ناورد نهنگیست عدوخوار(@)(@@) 11 آن شیر دژاهنج‌ که در صفحه ناورد %~% گیرد ملک‌الموت ز قهرش خط زنهار(@)(@@) 12 شاهی که به شاهین شهامت ز شهانش %~% هم‌کفه ورا نیست پس از حیدرکرار(@)(@@) 13 از هیبت او حرفی و غوغا به سمرقند %~% از صولت او ذکری و آشوب به فرخار(@)(@@) 14 ای‌گوهر تیغ تو نتاجش همه مرجان %~% وی سبزه شمشیر تو بارش همه‌گلنار(@)(@@) 15 تیغ تو به میدان وغا برق به خرداد %~% دست تو در ایوان عطا ابر در آذار(@)(@@) 16 نی‌نی‌که از آن برق به خرداد در آذر %~% نی‌نی ‌که از این ابر در آذار در آزار(@)(@@) 17 با گرزن رخشان تو کز مه بودش ننگ %~% با افسر تابان تو کز خور بودش عار(@)(@@) 18 صد گرزن لهراسب نیرزد به یک ارزن %~% صد افسر گشتاسب نیرزد به یک افسار(@)(@@) 19 یک جلوه ز روی تو و گیتی همه خلخ %~% یک نفخه ز خلق تو و عالم همه تاتار(@)(@@) 20 چون رخش تو در پویه هوا غیرت‌گلخن %~% چون تیغ تو در جلوه زمین حسرت‌گلزار(@)(@@) 21 در دست توکلک تو به توصیف تو ناطق %~% ماننده حصبا به‌کف احمد مختار(@)(@@) 22 از قهر تو بادی وزد از جانب گلشن %~% گل چاک‌کند جیب غم از سرزنش خار(@)(@@) 23 گر نام جهانسوز تو برابر نویسند %~% تا روز قیامت شود البته شرربار(@)(@@) 24 وز لفظ سمند تو بر البرز نگارند %~% تا حشر زند قهقهه بر برق ز رفتار(@)(@@) 25 هم‌کفه خلقت نبود آهوی جوجو %~% کاین مشک به‌جوجو دهد آن نافه به خروار(@)(@@) 26 ذکری ز خدنگ تو و زلزال به سقسین %~% حرفی ز پرنگ تو و ولوال به بلغار(@)(@@) 27 تیر تو که دلدوزتر از غمزه جانان %~% تیغ توکه خونریزتر از ابروی دلدار(@)(@@) 28 پیوند کند با اجل این درگه ناورد %~% سوگند خورد با ظفر آن در صف پیکار(@)(@@) 29 گر صاعقه تیغ تو برکوه بتابد %~% از هیبت 
