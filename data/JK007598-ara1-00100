ms81	 بأوجه أحرار % 34(@)(@@) % قوم إذا ذكرت قريش فشلهم % أصغى إليها البيت ذو الأستار % 35(@)(@@) % بلغ السماء بهم كنانة وارتدى % % بالفخر حيا يعرب ونزار % 36(@)(@@) % فاسلم رفيع الناظرين إلى العلا % % تهدى إليك قلائد الأشعار % 37(@)(@@) % والدهر عبد ، والأوامر طاعة % والملك مقتبل ، وزندك وار % PageV01P261 البحر : مديد تام 1(@)(@@) % نقمي تتبعها نعمي % % ويميني درة الديم % 2(@)(@@) % ليت شعري ، والمنى خدع % هل أروي صارمي بدم % 3(@)(@@) % وجباه الصيد لاثمة % ما تمس الأرض من قدمي % % 4(@)(@@) % تقتفي الأفواه موطئها % % راعيات حرمة الكرم % 5(@)(@@) % أتراه خد غانية % مد للتقبيل كل فم % 6(@)(@@) % والعلا إرثي ، ولست أرى % % حاجزا عنها سوى العدم % 7(@)(@@) % كيف أرجو أن أفوز بها % % في زمان ضاق عن هممي % % PageV01P262 البحر : طويل 1(@)(@@) % إذا استلب النوم العنان من اليد % علقت بأعطاف الخيال المسهد % 2(@)(@@) % ومالي وللزور الهلالي موهنا % بنهج طوينا غوله طي مجسد % 3(@)(@@) % بحيث صهيل الأعوجي يروعه % وينكر سجر الأرحبي المقيد % 4(@)(@@) % لك الله من ماض على الهول ، والعدا % % يهزون أطراف الوشيج المسدد % 5(@)(@@) % يراقب أسراب النجوم بمقلة % تقسم لحظا بين نسر وفرقد % 6(@)(@@) % تراءت له في منحنى الرمل جذوة % تمايل سكرى بين صال وموقد % % 7(@)(@@) % وكم دونها من أتلع الجيد شادن % مهفهف مستن الوشاحين أغيد % % 8(@)(@@) % إذا الليل أدنى من يدي وشاحه % خلعت نجاد المشرفي المهند % 9(@)(@@) % يحط عن البدر المنير لثامه % ويهفو بخوط البانة المتأود % 10(@)(@@) % سموت إليه والنجوم كأنها % % على الأفق مرفض الجمان المبدد % PageV01P263 11(@)(@@) % على لاحق الأطلين يختصر المدى % % بإرخاء ذئب الردهة المتورد % 12(@)(@@) % أفيض عليه شكتي وأخيضه % دجى الليل والأعداء مني بمرصد % 13(@)(@@) % وأجنبه الري الذليل وقد جلت % على الورد أنفاس الصبا متن مبرد % 14(@)(@@) % وتجمح بي عن موطن الذل همة % تجمع أشتات المعالي بأحمد % 15(@)(@@) % همام إذا استنهضته لملمة % مضى غير واهي المنكبين معرد % 16(@)(@@) % معرسه مأوى المكارم والعلا % % ونائله قيد الثناء المخلد % 17(@)(@@) % تشبت منه المكرمات بماجد % يروح إلى غاياتهن ويغتدي % % 18(@)(@@) % ويبسط كفا للندى أموية % تباري شآبيب الغمام المنضد % 19(@)(@@) % ويخفق أنى سار أو حل فوقه 
ms82	 % حواشي ثناء أو ذوائب سؤدد % 20(@)(@@) % وما روضة تشفي الجنوب غليلها % % بذي وطف من غائر المزن منجد % PageV01P264 21(@)(@@) % كأن الربيع الطلق في حجراتها % % يجرر ذيل الأتحمي المعضد % 22(@)(@@) % بأطيب نشرا من شمائله التي % % يلوذ بها جار وضيف ومجتد % 23(@)(@@) % إليك أبا العباس سارت ركائب % بذكرك تحدى بل بنورك تهتدي % % 24(@)(@@) % عليهن من أفناء قومك غلمة % يزمزم عنهم فدفد بعد فدفد % 25(@)(@@) % وتشكو إليك الدهر تفري خطوبه % بقية شلو من ذويك مقدد % 26(@)(@@) % حوى عنفوان المكرع الناس قبلنا % % وأوردنا أعقاب شرب مصرد % 27(@)(@@) % ولابد من يوم أغر محجل % يبوئنا ظل الطراف الممدد % 28(@)(@@) % فإنك أصل طيب أنا فرعه % وأي نجيب سل من أي محتد % 29(@)(@@) % وكم لك عندي من يد مستفيضة % لبست بها طوق الحمام المغرد % 30(@)(@@) % بقيت مصون العرض مبتذل الندى % % مديد رواق العز ، طلاع أنجد % PageV01P265 31(@)(@@) % ويومك يلوي أخدع الأمس نحوه % ويهفو بعطفيه اشتياقا إلى الغد % PageV01P266 البحر : بسيط تام 1(@)(@@) % غمت نزارا وساءت يعربا مدح % زفت إلى ذنب إذ لم أجد راسا % % 2(@)(@@) % ولو رآني ابن هند عض أنمله % غيظا على أموي يمدح الناسا % % PageV01P267 البحر : طويل 1(@)(@@) % طربن إلى نجد وأنى لها نجد % وبغداذ لم تنجز لنا موعدا بعد % 2(@)(@@) % وأسعدها سعد على ما تجنه % من الوجد ، لاأدمى جوانحه الوجد % 3(@)(@@) % فيا نضو لا يجمح بك الشوق واصطبر % قليلا وكفكف من دموعك ياسعد % 4(@)(@@) % فما بكما دون الذي بي من الهوى % % ولكن أبى أن يجزع الأسد الورد % 5(@)(@@) % سترعى وإن طالت بنا غربة النوى % % ربا في حواشي روضها النفل الجعد % 6(@)(@@) % بحيث تناجينا بألحاظها المها % % إذا ضمنا والربرب الأجرع الفرد % 7(@)(@@) % وليلة رفهنا عن العيس بعدما % % قضت وطرا منهن ملوية جرد % 8(@)(@@) % سرت أم عمرو والنجوم كأنها % % على مستدار الحلي من نحرها عقد % 9(@)(@@) % فلما انتبهنا للخيال تولعت % بنا صبوات فل من غربها البعد % 10(@)(@@) % وقلت لعيني وهي نشوى من الكرى % % أبيني لنا حلم رأيناه أم هند % PageV01P268 11(@)(@@) % لئن أخلف الطيف المواعيد باللوى % % فبالهضبات الحمر لم يخلف الوعد % 12 
ms83	(@)(@@) % وبتنا بروض ينثر الطل زهره % علينا ، ويرخي من ذوائبه الرند % 13(@)(@@) % ونحن وراء الحي نحذر منهم % عيونا تلظيها الحفيظة والحقد % 14(@)(@@) % وتجري أحاديث تلين متونها % % ويفتن في أطرافها الهزل والجد % 15(@)(@@) % وتحت نجادي مشرفي ، إذا التوى % % بجنبي روع كاد يلفظه الغمد % 16(@)(@@) % وهل يرهب الأعداء من غضبت له % مغاوير من بكر كأنهم الأسد % 17(@)(@@) % يذودون عني بالأسنة والظبا % % ولولاهم أدنى خطا العاجز القد % 18(@)(@@) % فأوجههم ، والخطب داج ، مضيئة % وألسنهم والعي محتصر ، لد % 19(@)(@@) % إذا انتسبوا مد الفخار أكفهم % إلى شرف أعلى دعائمه المجد % 20(@)(@@) % فكل سعى للمكرمات ، وإنما % % إلى ناصر الدين انتهى الحسب العد % PageV01P269 21(@)(@@) % أغر يهز الحمد عطفيه للندى % % على حين لا شكر يراعى ولا حمد % 22(@)(@@) % أتته العلا طوعا ، وكم رد طالب % على عقبيه بعدما استفرغ الجهد % 23(@)(@@) % ترى سيمياء العز فوق جبينه % كما لاح حد السيف أخلصه الهند % 24(@)(@@) % له نعمة تأوي إلى ظلها المنى % % ويسحب أذيال الثراء بها الوفد % 25(@)(@@) % وعزمة ذي شبلين ضاق بهمه % زراعا فلا يثنيه زجر ولا رد % 26(@)(@@) % يقلب عينا لا يذال لدى الوغى % % يذر عليها من خبيئته الزند % 27(@)(@@) % إذا السنوات الشهب أجلى قتامها % % عن المحل حتى عي بالصدر الورد % 28(@)(@@) % حلبنا أفاويق الغنى من يمينه % وما غرنا البرق اللموع ولا الرعد % % 29(@)(@@) % ودرت علينا راحة خلصت بها % % إلينا اليد البيضاء والعيشة الرغد % 30(@)(@@) % فداه من الأقوام كل مبخل % له منظر حر ومختبر عبد % PageV01P270 31(@)(@@) % إذا بسط المدح الوجوه وأشرقت % زوى بين عينيه على الشاعر الوغد % 32(@)(@@) % فلا بلغت إن زرته ما ترومه % ركائب أنضاها التوقص والوخد % 33(@)(@@) % يخضن الدجى خوصا كأن عيونها % % وهن جليات ، أناسيها رمد % 34(@)(@@) % إذا ما المطايا جرن عن سنن الهدى % % وجاذبنا قصد النجاد بها الوهد % 35(@)(@@) % ذكرناك والظلماء تثنى صدورها % % إلى الغي حتى يستقيم بها الرشد % 36(@)(@@) % حملن إليك الشعر غضا كأنما % % غذته بريا الشيح عذرة أو نهد % 37(@)(@@) % فما زلت أحدوه إليك محبرا % ولله دري أي ذي فقر أحدو % % 38(@)(@@) % ولاعبت ظلي في فنائك بعدما 
ms84	 % % أبى أن يزير الأرض طرته البرد % 39(@)(@@) % وقد كان عهدي بالمنى يستميلني % % إليك ، وتدنيني البشاشة والود % 40(@)(@@) % فما بالنا نجفى ومنك تعلمت % صروف الليالي أن يدوم لها عهد % PageV01P271 41(@)(@@) % وما بي نوال أرتجيه ، فطالما % % نقعت الصدى والماء مقتسم ثمد % 42(@)(@@) % ولكنك ابن العم ، والعم والد % وما لامرئ من بر والده بد % PageV01P272 البحر : طويل 1(@)(@@) % وسرب عذارى من عقيل سمعنني % % وراء بيوت الحي مرتجزا أشدو % % 2(@)(@@) % فسدت خصاصات الخدور بأعين % حكت قضبا في كل قلب لها غمد % 3(@)(@@) % ورددن أنفاسا تقد من الحشى % % وتدمى فلم يسلم لغانية عقد % 4(@)(@@) % وفيهن هند وهي خود غريرة % ومنية نفسي دون أترابها هند % 5(@)(@@) % فقلن لها : من أين أوضح ذا الفتى % % ومنشؤه غورا ثهامة أو نجد ؟ % 6(@)(@@) % ففي لفظه علوية من فصاحة % وقد كاد من أشعاره يقطر المجد % 7(@)(@@) % فقالت : غلام من قريش تقاذفت % به نية يعيى بها العاجز الوغد % 8(@)(@@) % لعمر أبيها إنها لخبيرة % بأروع يمري در نائله الحمد % 9(@)(@@) % من القوم تستحلي المنايا نفوسهم % ويختال تيها في ظلالهم الوفد % 10(@)(@@) % ومن لان للخطب الملم عريكة % فإني على ما نابني حجر صلد % PageV01P273 11(@)(@@) % بلغت أشدي ، والزمان ممارس % جماحي عليه وهو ما راضني بعد % PageV01P274 البحر : طويل 1(@)(@@) % أثرها فلا ماء أصابت ولا عشبا % % وقد ملئت أحشاء ركبانها رعبا % % 2(@)(@@) % ونحن بحيث الذئب يشكو ضلاله % إلى النجم ، والساري يسوف به التربا % % 3(@)(@@) % نحاذر من حيي سليم وعامر % أناسي لا يرضون غير الظبا صحبا % % 4(@)(@@) % إذا خلفت بطحاء نجد وراءها % % فلسنا بمناعين أن تقف الركبا % % 5(@)(@@) % فأين ومثلي لا يغشك ، ماجد % نصول به كالعضب محتضا عضبا % % 6(@)(@@) % له همة غيري على المجد برحت % بنفس على الأيام من تيهها غضى % % 7(@)(@@) % وإن يك في نجدي قيس بسالة % فإني ابن أرض تنبت البطل الندبا % % 8(@)(@@) % يعد إباء الضيم كبرا ، وطالما % % أبينا فلم نعثر بأذيالنا عجبا % % 9(@)(@@) % ولكننا في مهمة تعجل الخطا % % على وجل ، هوج الرياح به نكبا % % 10(@)(@@) % إذا طالعتنا من قريش عصابة % وشافهن من أعلام مكتها هضبا % % PageV01P275 11 
ms85	(@)(@@) % نزلن من الوادي المقدس تربه % بآمنه سربا وأعذبه شربا % % 12(@)(@@) % وفي الركب من يهوى العذيب وماءه % ويضمر أحيانا على أهله عتبا % % 13(@)(@@) % ويصبو إلى واديه والروض باسم % يغازله عافي النسيم إذا هبا % % 14(@)(@@) % ووالله لولا حب ظمياء لم يعج % عليه ، ولم يعرف كلابا ولا كعبا % % 15(@)(@@) % وما أم ساجي الطرف مال به الكرى % % على عذبات الجزع تحسبه قلبا % % 16(@)(@@) % تراعي بإحدى مقلتيها كناسها % % وترمي بأخرى نحوه نظرا غربا % % 17(@)(@@) % فلاح لها من جانب الرمل مرتع % كأن الربيع الطلق ألبسه عصبا % % 18(@)(@@) % فمالت إليه ، والحريص إذا عدت % % به طوره الأطماع لم يحمد العقبى % % 19(@)(@@) % وآنسها المرعى الأنيق وصادفت % مدى العين في أرجائه بلدا خصبا % % 20(@)(@@) % فلما قضت منه اللبانة راجعت % طلاها ، فألفته قضى بعدها نحبا % % PageV01P276 21(@)(@@) % أتيح لها عاري السواعد لم يزل % يخوض إلى أوطاره مطلبا صعبا % % 22(@)(@@) % فولت على ذعر وبالنفس ما بها % % من الكرب لا لقيت في حادث كربا % % 23(@)(@@) % بأوجد مني يوم عجت ركابها % % لبين فلم تترك لذي صبوة لبا % % 24(@)(@@) % وما أنس لا أنس الوداع وقد بدت % % تغيض دمعا فاض وابله سكبا % % 25(@)(@@) % مهفهفة لم ترض أترابها لها % % ببدر الدجى شبها ، وشمس الضحى تربا % % 26(@)(@@) % تنفس حتى يسلم العقد سلكه % وأكظم وجدا كاد ينتزع الخلبا % % 27(@)(@@) % وتذري شآبيب الدموع كأنما % % أذابت بعينيها النوى لؤلؤا رطبا % % 28(@)(@@) % وما كنت أخشى أن أراع لحادث % من الدهر ، أو أشكو إلى أهله خطبا % % 29(@)(@@) % وقد زرت من أفناء سعد ومالك % ضراغمة تغرى ، كنانية غلبا % % 30(@)(@@) % من القوم يزجي الراغبون إليهم % على نصب المسرى ، غريري ة صهبا % % PageV01P277 31(@)(@@) % لهم نسب رفت عليهم فروعه % وبوأهم من خندف كنفا رحبا % % 32(@)(@@) % إذا ذكروه أضمر العجم إحنة % عليهم ، وأصلى جمرة الحسد العربا % % 33(@)(@@) % وإن سئلوا عمن يدير على العدا % % رحى الحرب فيهم أو يكون لها قطبا % % 34(@)(@@) % أشاروا بأيديهم إلى خيرهم أبا % وأطولهم باعا ، وأرحبهم شعبا % % 35(@)(@@) % إلى مدلجي رد عن آل جعفر % صدور القنا والجرد شازبة قبا % % 36(@)(@@) % وقابل بالحسنى إساءة مجرم % فود بريء 
ms86	 القوم أن له ذنبا % % 37(@)(@@) % تراق دماء الكوم حول قبابه % إذا راح شول الحي مقورة حدبا % % 38(@)(@@) % ويستمطر العافون منه أناملا % أبى الجود أن يستمطروا بعدها سحبا % % 39(@)(@@) % رأى عنده الأعداء ملء عيونهم % مناقب لو فازوا بها وطئو الشهبا % % 40(@)(@@) % فودوا من البغضاء أن جفونهم % عقدن بهدب دون رؤيتها هدبا % % PageV01P278 41(@)(@@) % ولم يتلعوا أعناقهم نحوه هوى % ولا عفروا تلك الجباه له حبا % % 42(@)(@@) % ولكنهم هابوا مخالب ضيغم % يجوب أديم الأرض نحوهم وثبا % % 43(@)(@@) % أبا خالد إني تركتهم سدى % % وأحسابهم فوضى ، وأعراضهم نهبى % % 44(@)(@@) % وصدق قولي فيك أفعالك التي % % أبت لقريضي أن أوشحه كذبا % % 45(@)(@@) % وهزك مدح كاد يصيبك حسنه % وفي الشعر ما هز الكريم وما أصبى % % 46(@)(@@) % يحدث عنه البدر بالشرق أهله % ويسأل عنه الشمس من سكن الغربا % % 47(@)(@@) % ومن لم يراقب ربه في رعية % أخشته تدمي عرانينهم جذبا % % 48(@)(@@) % فإنك أرضيت الرعايا بسيرة % تحلت بها الدنيا ولم تسخط الربا % % PageV01P279 البحر : طويل 1(@)(@@) % دعت أم عمر و ويلها ثم أقبلت % تؤنبني والصبح لم يتنفس % 2(@)(@@) % وتعجب من بذلي لكل رغيبة % وجودي بما أحويه من كل منفس % 3(@)(@@) % وتعلم أني من بقية معشر % نماهم إلى العلياء أكرم مغرس % 4(@)(@@) % هم ملكوا الأعناق بالبأس والندى % % وعز معاوي المباءة أقعس % 5(@)(@@) % وقد ولدتهم من قريش سراتها % % على نمطي بيضاء من سر فقعس % 6(@)(@@) % فقلت لها كفي وغاك فأعرضت % وفي خدها ورد يطل بنرجس % 7(@)(@@) % أبخلا وبيتي من أمية في الذرا % % وعرقي بغير المجد لم يتلبس % 8(@)(@@) % وما أنا ممن يألف الضحك في الغنى % % وإن نال مني الفقر لم أتعبس % 9(@)(@@) % ففي العسر أحيانا وفي اليسر تارة % يعيش الفتى ، والغصن يعرى ويكتسي % % PageV01P280 البحر : طويل 1(@)(@@) % رماك بشوق فالمدامع ذرف % حنين المطايا أو حمائم هتف % 2(@)(@@) % أجل عاود القلب المعنى خباله % عشية صحبي عند يبرين وقف % 3(@)(@@) % فلله ما يطوي عليه ضلوعه % رمي بذكر الغانيات مكلف % 4(@)(@@) % يهيجه نوح الحمام وناسم % ترق حواشيه من الريح ، مدنف % 5(@)(@@) % ويذكي له الغيران عينا إذا رأى % % أجارع من 
ms87	 حزوى بسمراء تسعف % 6(@)(@@) % أيوعدني الحي اليماني ، وصارمي % % كهمك ، مفتوق الغرارين مرهف % 7(@)(@@) % وأفرش سمعي للوعيد فحبها % % إذا جمحت بي نخوة يتلطف % 8(@)(@@) % وحولي من عليا خزيمة عصبة % إذا غضبت ظلت لها الأرض ترجف % 9(@)(@@) % يجرون أذيال الدروع إلى الوغى % % فأقوى ويعروني هواها فأضعف % 10(@)(@@) % أما وجلال الله لولا اتقاؤه % لبات يوارينا الرداء المفوف % PageV01P281 11(@)(@@) % وفض ختام السر بيني وبينها % % كلام يؤديه البنان المطرف % 12(@)(@@) % ونازعني شكوى الصبابة شادن % من الغيد مجدول الموشح أهيف % 13(@)(@@) % برابية ميثاء أضحك روضها % % غمام بكى من آخر الليل أوطف % 14(@)(@@) % وركب على الأكوار غيد من الكرى % % تداولهم سير حثيث ونفنف % 15(@)(@@) % ترى العتق منهم في وجوه شواحب % يردد فيها لحظه المتقوف % 16(@)(@@) % وتخدي بهم خوص تخايل في البرى % % 17(@)(@@) % ويثني هواديها إذا طمحت بها % % من القد ملوي المرائر محصف % 18(@)(@@) % سروا وفضول الريط تضربها الصبا % % إلى أن يمس الأرض منهن رفرف % 19(@)(@@) % وعاتبني عمرو على السير والسرى % % ولم يدر أني للمعالي أطوف % 20(@)(@@) % وما الصقر يستذكي الطوى لحظاته % بأصدق مني نظرة حين يخطف % PageV01P282 21(@)(@@) % أخادع ظني عن أمور خفية % إلى أن أرى تلك العماية تكشف % 22(@)(@@) % وأهزأ بالأنوار والصبح طالع % ولا اهتدي بالنجم والليل مسدف % 23(@)(@@) % وقول أتاني والحوادث جمة % ودوني من ذات الأراكة صفصف % 24(@)(@@) % أغض له طرفي حياء من العلا % % وعطفا عليكم ، والأواصر تعطف % 25(@)(@@) % أعتبا وقد سيرت فيكم مدائحا % كما خالطت ماء الغمامة قرقف % 26(@)(@@) % بني عمنا لا تنسبونا إلى الخنى % % فلم يتردد في كنانة مقرف % 27(@)(@@) % أأشتم شيخا لف عرقي بعرقه % مناسب تزكو في قريش وتشرف % 28(@)(@@) % وأهجو رجالا في العشيرة سادة % وبي من بقايا الجاهلية عجرف % 29(@)(@@) % وإني إذا ما لجلج القول فاخر % يؤنب في أقواله ويعنف % 30(@)(@@) % أدافع عن أحسابكم بقصائد % غدا المجد في أثنائها يتصرف % PageV01P283 31(@)(@@) % ولم أخترعها رغبة في نوالكم % وإن كان مشمولا به المتضيف % 32(@)(@@) % ولكن عريق في من عربية % يحامي وراء ابني نزار ويأنف % 33(@)(@@) % فنحن بني دودان فرع خزيمة % يذل لنا ذو السورة 
ms88	 المتغطرف % 34(@)(@@) % وأنتم ذوو المجد القديم يضمنا % % أب خمدفي فيه للفخر مألف % 35(@)(@@) % وتقرون والآفاق يمري نجيعها % % شآمية تستجمع الشول حرجف % 36(@)(@@) % فناؤكم مأوى الصريخ إذا انثنى % % بأيدي الكماة السمهري المثقف % 37(@)(@@) % وواديكم للمكرمات معرس % رحيب بطلاب الندى متكنف % 38(@)(@@) % بأرجائه مما اقتنيتم نزائع % يباح عليهن الحمى المتخوف % 39(@)(@@) % ترود بأبواب القباب وأهلها % % عليها بألبان القلائص عكف % 40(@)(@@) % وأماتها أودت بحجر وأدركت % عتيبة والأبطال بالبيض تدلف % PageV01P284 41(@)(@@) % وكم ملك أدمين بالقيد ساقه % فظل يداني من خطاه ويرسف % 42(@)(@@) % فيا لنزار دعوة مضرية % بحيث الردينيات بالدم ترعف % 43(@)(@@) % لنا في المعالي غاية لا يرومها % % سوى أسدي عرقت فيه خندف % PageV01P285 البحر : وافر تام 1(@)(@@) % وحماء العلاط إذا تغنت % فكم طرب يخالطه أنين % 2(@)(@@) % وأرعيها مسامع لم يملها % % إلى نغماتها إلا الرنين % 3(@)(@@) % وبين جوانحي مما أعاني % % تباريح يلقحها الحنين % 4(@)(@@) % بكت ، وجفونها ما صافحتها % % دموع ، والغرام بها يبين % 5(@)(@@) % ولي طرف ألح عليه دمع % تتابع فيضه فمن الحزين ؟ % PageV01P286 البحر : وافر تام 1(@)(@@) % مراحك إنه البرق اليماني % % على عذب الحمى ملقى الجران % 2(@)(@@) % تطلع من حشى الظلماء وهنا % خلوص النار من طرر الدخان % 3(@)(@@) % فلا تلعب بعطفك مستنيما % إلى خدع تطور بها الأماني % % 4(@)(@@) % فإن وميضه قمن بخلف % كما ابتسمت إلى الشمط الغواني % % 5(@)(@@) % ولا تجثم بمدرجة الهوينى % % تقعقع للنوائب بالشنان % 6(@)(@@) % إذا ذلت حياتك في مكان % فمت لطلاب عزك في مكان % 7(@)(@@) % أبى لي أن أضام أبي ونفسي % % ورمحي والحسام الهندواني % % 8(@)(@@) % وشوس في الذوائب من قريش % ذوو النخوات والغرر الحسان % 9(@)(@@) % وأموال تخونها هزال % تبدد دون أعراض سمان % 10(@)(@@) % إذا حفزتهم الهيجاء لاذوا % % بأطراف المثقفة اللدان % PageV01P287 11(@)(@@) % وطارت كل سلهبة مزاق % ببزة كل منتجب هجان % 12(@)(@@) % يقدون الدروع بمرهفات % تجعجع بالخميس الأدجوان % 13(@)(@@) % ويطوون الضلوع على طواها % % ويأكل جارهم أنف الجفان % 14(@)(@@) % تناوشهم صروف الدهر حتى % % أتيح لهم بنو عبد المدان % 15(@)(@@) % زعانف لا يزال لهم خطيب % غداة الفخر مسترق اللسان % 16(@)(@@) % يروح إليهم النعم المندى % % وقد عصفت بنا نوب الزمان 
ms89	 % 17(@)(@@) % ودبت نشوة الخيلاء فيهم % دبيب النار في سعف الإهان % 18(@)(@@) % وكيف يعز شردمة لئام % على صفحاتهم سمة الهوان % 19(@)(@@) % أراقب ليلة فيهم عماسا % تمخض لي بيوم أرونان % 20(@)(@@) % وأخدعهم ولي عزم شجاع % بمختلق من الكلم الجبان % PageV01P288 21(@)(@@) % سأخبطهم بداهية نآد % فليس لهم بنائبة يدان % 22(@)(@@) % ولا حسب يقدمهم ولكن % أرى الأنبوب قدام السنان % 23(@)(@@) % فإن ضياء دين الله جاري % % عشية تلتقي حلق البطان % 24(@)(@@) % حذار فدون ما تسمو إليه % أسامة ، وهو مفترش اللبان % 25(@)(@@) % وإن أخا أمية في ذراه % لكالنمري جار الزبرقان % 26(@)(@@) % لدى متوقد العزمات طلق ال % % خليقة والمحيا والبنان % 27(@)(@@) % له نعم يراح لهن عاف % إلى نقم يهيب بهن جان % 28(@)(@@) % وفيض يد تجن على سماح % وأخرى تستريح إلى طعان % 29(@)(@@) % تلوذ بحقوه أيدي الرعايا % % لياذ المضرحية بالرعان % 30(@)(@@) % هنيئا ، والسعود لها دواع % قدوم تستطيل به التهاني % % PageV01P289 31(@)(@@) % لأروع حج بيت الله ، يطوي % % إليه نياط أغبر صحصحان % 32(@)(@@) % ويفري بردة الظلماء حتى % % يفيق الأعوجي من الحران % 33(@)(@@) % ويصبح كل ناجية ذمول % بهادية كخوط الخيزران % 34(@)(@@) % فلما شارف الحرم استنارت % % به سرر الأباطح والمحاني % % 35(@)(@@) % تساوى الشوط بينكما بشأو % كأنكما لديه الفرقدان % 36(@)(@@) % فشيد مابناه أولوه % وروق شبابه في العنفوان % 37(@)(@@) % أتخطئه العلا ويدل فيها % % بعرق من شيوخك غير وان % 38(@)(@@) % جرى وجريت مستبقين حتى % % دنا طرف العنان من العنان % PageV01P290 البحر : طويل 1(@)(@@) % خليلي هلا ذدتما عن أخيكما % % أذى اللوم إذ جانبتما ما يسره % 2(@)(@@) % ألم تعلما أني على الخطب إن عرا % % صبور إذا ما عاجز عيل صبره % 3(@)(@@) % تعيرني المعاوي أن أرى % % على عجز الأمر الذي فات صدره % 4(@)(@@) % وقد جهلت أني أسور إلى العلا % % ويعيى بها من لم يساعده دهره % 5(@)(@@) % وأجشم ما يوهي القوى في طلابها % % وسيان عندي حلو عيش ومره % 6(@)(@@) % فلا عز حتى يحمل المرء نفسه % على خطة يبقى بها الدهر ذكره % 7(@)(@@) % ويغشى غمارا يتقى دونها الردى % % فإن هو أودى قيل : لله دره % 8(@)(@@) % ومن يتخذ ظهر الوجيهي في الوغى % % مقيلا فبطن 
ms90	 المضرحية قبره % 9(@)(@@) % ولا بد لي من وثبة أموية % بحيث العجاج الليل والسيف فجره % 10(@)(@@) % إذا ما بكى في مأزق الحرب صارمي % % دما أو سناني ضاحك الذئب نسره % PageV01P291 البحر : طويل 1(@)(@@) % غدا أبطن الكشح الحسام المهندا % % إذا وقذ الحي الهوان وأقصدا % % 2(@)(@@) % ولله فهري إذا الورد رابه % أبى الري واختار المنية موردا % % 3(@)(@@) % يراقب أفراط الصباح بناظر % يساهر في المسرى جديا وفرقدا % % 4(@)(@@) % ولو بقيت في المشرفية هبة % ضربت لداعي الحي بالخصب موعدا % % 5(@)(@@) % وهل ينفع الصمصام من يرتدي به % بحيث الطلى تفرى إذا كان مغمدا % % 6(@)(@@) % فما أرضعتني درة العز حرة % لئن لم أذر شلو ابن سلمى مقددا % % 7(@)(@@) % تريع إليه كل ممسى ومصبح % حصان تشق الأتحمي المعضدا % % 8(@)(@@) % بعين تفل الدمع بالدمع ثرة % أفاضت على النحر الجمان المبددا % % 9(@)(@@) % وطيف سرى والليل ينضو خضابه % ويجلو علينا الصبح خدا موردا % % 10(@)(@@) % أتى ، والثريا حلة الغور ، معشرا % كراما بأطراف المرودات هجدا % % PageV01P292 11(@)(@@) % يرومون أمرا دونه رب سربة % لهام تشب الكوكب المتوقدا % % 12(@)(@@) % وصلنا به سمر الرماح وربما % % هجرنا لها بيض الترائب خردا % % 13(@)(@@) % وإني على ما في من عجرفية % إذا ما التقى الخيلان ، أذكر مهددا % % 14(@)(@@) % هلالية أكفاؤها كل باسل % بعيد الهوى ، إن غار للحرب أنجدا % % 15(@)(@@) % رمتني بعيني جؤذر وتلفتت % بذي غيد يعطو به الريم أجيدا % % 16(@)(@@) % فيا خادييها سائقين طلائحا % تجوب بصحراء الأراكة فدفدا % % 17(@)(@@) % إذا أصغرت أو أكبرت في حنينها % % ظللت على آثارهن مغردا % % 18(@)(@@) % أفيقا قليلا من حداء غشمشم % أقام من القلب المعنى وأقعدا % % 19(@)(@@) % فإنكما إن سرتماها بهدنة % رمت بكما نجدا من اليوم أوغدا % % 20(@)(@@) % وسيان لولا حبها عامرية % غراب دعا بالبين أو سائق حدا % % PageV01P293 21(@)(@@) % وكل هوى نهب الليالي وحبها % % إذا بليت أهواء قوم تجددا % % 22(@)(@@) % وعاذلة نهنهت من غلوائها % % وكنت أبيا لا أطيع المفندا % % 23(@)(@@) % إذا استل مني طارق الخطب عزمة % فلابد من نيل المعالي أو الردى % % 24(@)(@@) % أأسحب ذيلي في الهوان وأسرتي % % تجر إلى العز الدلاص المسردا % % 25(@)(@@) % ولي من أمير المؤمنين 
ms91	 إيالة % سترغم أعداء وتكمد حسدا % % 26(@)(@@) % هي الغاية القصوى إذا اعتلقت بها % % مآرب طلاب العلا بلغوا المدى % % 27(@)(@@) % أغر منافي يمد بضبعه % جدود يعالون الكواكب محتدا % % 28(@)(@@) % تبرع بالمعروف قبل سؤاله % فلم يبسط العافي لسانا ولا يدا % % 29(@)(@@) % فرحنابمال فرق المجد شمله % وراح بحمد ضم أشتاته الندى % % 30(@)(@@) % حلفت بفتلاء الذراع شملة % تخب بقرم من أمية أصيدا % % PageV01P294 31(@)(@@) % وتهوي إلى البيت العتيق ، وربها % % إذا غال من تأويبه البيد أسأدا % % 32(@)(@@) % أظلت محلي طيء منه وقعة % فكادوا يبارون النعام المطردا % % 33(@)(@@) % ولاقى رئيس القوم عمرو بن جابر % طعانا ينسيه الهدي المقلدا % % 34(@)(@@) % لأستود عن الدهر فيكم قصائدا % وهن يوشحن الثناء المخلدا % % 35(@)(@@) % زجرت إليكم كل وجناء حرة % وأدهم محجول القوائم أجردا % % 36(@)(@@) % فألبستموني ظل نعمى كأنني % % أجاور ربعيا من الروض أغيدا % % 37(@)(@@) % تسير بها الركبان شرقا ومغربا % ويسري لها العافون مثنى وموحدا % % 38(@)(@@) % وكم لك عندي منة لو جحدتها % % لقام بها أبناء عدنان شهدا % % 39(@)(@@) % بمعترك العز الذي في ظلاله % أفل شبا الخطب الذي جار واعتدى % % 40(@)(@@) % يظل حواليه المساكين عوذا % بخير إمام ، والسلاطين سجدا % % PageV01P295 41(@)(@@) % عليه من النور الإلهي لمحة % إذا اكتحل الساري بلألائها اهتدى % % 42(@)(@@) % ورثت عبيد الله عمك جوده % وأشبهت عبد الله جدك سؤددا % % PageV01P296 البحر : وافر تام 1(@)(@@) % وخيل كالذئاب على مطاها % % أسود خاضت الغمرات شوس % 2(@)(@@) % بيوم قاتم الطرفين فيه % يشوب طلاقة الوجه العبوس % 3(@)(@@) % ونحن نلاعب الأسلات حتى % % تجيش إلى تراقيها النفوس % 4(@)(@@) % ونترك في النجيع الورد صرعى % % كشرب الخمر غالهم الكؤوس % 5(@)(@@) % فسال بهم على العلمين واد % فواقعه إذا زخر الرؤوس % PageV01P297 البحر : طويل 1(@)(@@) % على عذب الجرعاء من أيمن الحمى % % مراد الظباء الأدم أو ملعب الدمى % % 2(@)(@@) % رعابيب يحمى سربهن بغلمة % يشم بهم أنف المكاشح مرغما % % 3(@)(@@) % غيارى ، إذا أرخى الظلام سدوله % سروا في ضمير الليل سرا مكتما % % 4(@)(@@) % يبيتون أيقاظا على حين هومت % كواكب يغشين المغارب نوما % % 5(@)(@@) % طرقتهم والبيض بالسمر تحتمي % % فخضت إليهن الوشيج المقوما % % 6(@)(@@) % وكاد يريني أول الفجر غرة % على أخريات 
ms92	 الليل في وجه أدهما % % 7(@)(@@) % وكم شنب في ثغره لم أبل به % ففي شفة الظلماء من دونه لمى % % 8(@)(@@) % فبتن على ذعر يقلبن في الدجى % % بزج على دعج ، قسيا وأسهما % % 9(@)(@@) % وغازلت إحداهن حتى بكت دما % مدامعنا للصبح حين تبسما % % 10(@)(@@) % وضاق عناق يسلب الجيد عقده % ولم يحتضن منا الوشاحان مأثما % % PageV01P298 11(@)(@@) % فوا عجبا حتى الصباح يروعني % % له الويل كم يشجو الفؤاد المتيما % % 12(@)(@@) % ولو قابلته بالذوائب راجعت % % بها الليل ملتف الغدائر أسحما % % 13(@)(@@) % وإن كف عنا ضوءه بات حليها % % ينم علينا جرسه إن ترنما % % 14(@)(@@) % ولسنا نبالي الحلي ، إن فصيحه % بحيث يرى من قلة النطق أعجما % % 15(@)(@@) % فما شاع بالأسرار منها مسور % ولم نتهم أيضا عليها المخدما % % 16(@)(@@) % إذا ما سرت لم يمكن القلب منطق % ولا حاول الخلخال أن يتكلما % % 17(@)(@@) % ولكن وشى بي نشرها إذ توشحت % لدي جمان الرشح فذا وتوأما % % 18(@)(@@) % لئن كثر الواشون فالود بيننا % % على عقب الأيام لن يتصرما % % 19(@)(@@) % وأبرح ما ألقاه في الحب رائع % من الشيب بالفودين مني تضرما % % 20(@)(@@) % أقبل بلوغ الأربعين تسومني % % صروف الليالي أن أسشيب وأهرما ؟ % PageV01P299 21(@)(@@) % وتسحبني ذيل الخصاصة ، والعلا % % تحملني عبء السيادة معدما % % 22(@)(@@) % وأهتز عند المكرمات فشيمة % لنا ساعة الضراء أن نتكرما % % 23(@)(@@) % وأرضى بحظ في الثراء مؤخر % إذا كان بيتي في العلاء مقدما % % 24(@)(@@) % وتألف نفسي عزها وهي حرة % ترى الكبر غنما والضراعة مغرما % % 25(@)(@@) % وقد لامني من لو تأملت قوله % علمت يقينا أنه كان ألوما % % 26(@)(@@) % يعيرني أني صددت عن الورى % % ولم أمتدح منهم لئيما مذمما % % 27(@)(@@) % رويدك إني أبتغي إرث معشري % % وهمك أن تعطى لبوسا ومطعما % % 28(@)(@@) % فو الله لا عتبت بابك أخمصي % % فذرني وجر الأتحمي المسهما % % 29(@)(@@) % أأنحو طريقا للطماعة مجهلا % وأترك نهجا للقناعة معلما % % 30(@)(@@) % وقد شبهتني إذ ولدت قوابلي % % من الأسد مجدول الذراعين ضيغما % % PageV01P300 31(@)(@@) % ولو شئت إدراك الغنى بالتماسه % زجرت على الأين المطي المخزما % % 32(@)(@@) % أكلفه الإسآد حتى يمله % ويرعف في المسرى سناما ومنسما % % 33(@)(@@) % فلا عاش من يرضى بأسآر 
ms93	 عيشة % تبرضها ، إلا ذليلا مهضما % % 34(@)(@@) % ولي نظرة شطر المعالي وهمة % أبت أن تزور الجانب المتجهما % % 35(@)(@@) % وأقرع أبواب الملوك بوالد % حوى بأبي سفيان أشرف منتمى % % 36(@)(@@) % ولولا ابن منصور لما شمت بارقا % لجدوى ، ولم أفتح بمسألة فما % % 37(@)(@@) % يعد إلى دودان بيضا غطارفا % تفرع روقي عيصهم وتسنما % % 38(@)(@@) % وفي مزيد من بعد ريان مفخر % لوى عن مداه ساعد النجم أجذما % % 39(@)(@@) % فأكرم بآباء هم في اشتهارهم % % بدور ، وأبناء يعالون أنجما % % 40(@)(@@) % وأنت ابنهم ، والفرع يشبه أصله % تحامي وراء المجد أن يتقسما % % PageV01P301 41(@)(@@) % تروض مصاعيب الأمور وتمتطي % % غوارب من دهر أبى أن يخطما % % 42(@)(@@) % وتسمو إلى شأو ثنى كل طالب % على ظلع يمشي وقد كان مرجما % % 43(@)(@@) % وتنهل من كلتا يديك غمائم % يظل عليهن الأماني حوما % % 44(@)(@@) % فجارك لا يخشى الأذى وتخاله % من الأمن في أنضاد يذبل أعصما % % 45(@)(@@) % وعافيك في روض توسد زهره % يناجي غديرا في حواشيه مفعما % % 46(@)(@@) % ويمتار نعمى لا تغب ، ويجتلي % % محيا يروق الناظر المتوسما % % 47(@)(@@) % وإن ألقت الحرب العوان قناعها % % وطارت فراخ كن في الهام جثما % % 48(@)(@@) % بيوم مريض الشمس جون إهابه % تظن الضحى ليلا من النقع أقتما % % 49(@)(@@) % ضربت بسيف لم يخنك غراره % يرد شباه جانب القرن أثلما % % 50(@)(@@) % ورأي كفاك المشرفي وسله % وسمر العوالي والخميس العرمرما % % PageV01P302 51(@)(@@) % بلغت المدى فارفق بنفسك تسترح % فليس عليها بعده أن تجشما % % 52(@)(@@) % وحسب الفتى أن فاق في الجود حاتما % % وفي بأسه عمرا ، وفي الرأي أكثما % % 53(@)(@@) % فهنئت الأيام منك بماجد % أضاء به الدهر الذي كان مظلما % % 54(@)(@@) % له هيبة فيها التواضع كامن % وعز بذيل الكبرياء تلثما % % 55(@)(@@) % وزارك عيد ناش ذيلك سعده % وألقى عصاه في ذراك وخيما % % 56(@)(@@) % فصير أعاديك الأضاحي إذ لووا % % طلى يستزرن المشرفي المصمما % % 57(@)(@@) % وسق الثرى للنسك من نعم دما % ورو الظبا للملك من بهم دما % % 58(@)(@@) % ولا تصطنع إلا الكرام فإنهم % % يجازون بالنعماء من كان منعما % 59(@)(@@) % ومن يتخذ عند اللئام صنيعة % تجده على آثارها متندما % % 60(@)(@@) % وأي فتى من عبد شمس 
ms94	 غمرته % بسيب كشؤبوب الغمام إذا همى % % PageV01P303 61(@)(@@) % فأهدى إليك الشعر حلوا مذاقه % تضم قوافيه الجمان المنظما % % 62(@)(@@) % ومن يترقب في رجائك ثروة % فإني لم أخدمك إلا لأخدما % % PageV01P304 البحر : طويل 1(@)(@@) % وأشعث منقد القميص تلفه % إلى الدفء هوجاء الهبوب عقيم % 2(@)(@@) % دعا والصبا تثني إلى فيه صوته % ويفري أديم الليل وهو بهيم % 3(@)(@@) % فجاوبه مستشرف لطروقه % ألوف بتأنيس الضيوف عليم % 4(@)(@@) % ولاحت له فرعاء تهدر فوقها % % قدور لها تحت الظلام نئيم % 5(@)(@@) % فقلت له أبشر بنار عتيقة % لها موقد محض النجار كريم % 6(@)(@@) % لئن سفهت قدري عليك بغليها % % فكلبي غضيض الناظرين حليم % 7(@)(@@) % وإن امرأ لم ينحر الكوم للقرى % % وساد معدا جده للئيم % PageV01P305 البحر : طويل 1(@)(@@) % أثرها فما دون الصرائم حاجز % ولا فوقها واهي العزائم عاجز % 2(@)(@@) % أطل على الأكوار سرحان ردهة % وأرقم مما يوطن القف ناكز % 3(@)(@@) % فتى لم توركه الإماء وهجمة % تضم قواصيها إليه المفاوز % 4(@)(@@) % أهبت به حيث الهدان من السرى % % لهامته في غمرة النوم غارز % 5(@)(@@) % فهب كما استتلى القرينة شامس % به وجل من روعة السوط حافز % 6(@)(@@) % يخوض الدجى والنجم يومض بالكرى % % إلى طرفه ، والليل بالصبح رامز % 7(@)(@@) % أخي أقم أعناقهن لحاجز % فهن على بطحاء نجد نواشز % 8(@)(@@) % إذا أنت عاطيت الأزمة مارنا % به يرأم الذل العدو المناجز % 9(@)(@@) % فما صدقت عنك القوابل وانثنت % تذم شيوخ الحي فيك العجائز % 10(@)(@@) % هل العز إلا أن تليح من الأذى % % محاذرة أن يستلينك غامز % PageV01P306 11(@)(@@) % فغضي ملاما يا بنة القوم ، إنني % % مقيم بحيث الوجه للقرن بارز % 12(@)(@@) % يروض أبي الشعر مني مقصد % مرارا ، وأحيانا يصاديه راجز % 13(@)(@@) % خذي قصبات السبق مني فما لها % % من الحي غير ابن المعاوي حائز % 14(@)(@@) % ولا تعذلي بي أزهر بن عويمر % فما الزائف المنفي عندك جائز % 15(@)(@@) % ولاتعجبي من مدرع مسه البلى % % فكم حسب لفت عليه المعاوز % 16(@)(@@) % ومرت يضل الذئب فيه إذا دجا % % به الليل أو ش بت لظاها الأماعز % 17(@)(@@) % أقمنا به صغو المطايا كأنما % % يمد بها سيرا على الأرض خارز % 18 
ms95	(@)(@@) % إليك أبا الغمر استلبنا مراحها % % وقد بليت أنساعها والرجاثز % 19(@)(@@) % تؤم المناخ الرحب عندك بعدما % % تضايق عنها المبرك المتلاحز % 20(@)(@@) % وتزور عن بكر ، وللجار فيهم % مهين ومغتاب وهاج ونابز % PageV01P307 21(@)(@@) % أقول لسفيان بن عبد وفي الحشى % % هموم لها بين الضلوع حزائز % 22(@)(@@) % أغرت على أذواد جارك عاديا % عليه ، وهن المنفسات الحرائز % 23(@)(@@) % لبئس الفتى جاءت به ثقفية % تذم بنيها ، أو جعتها الجنائز % 24(@)(@@) % وأنت الذي تضفو علينا ظلاله % وتصفو لنا أخلاقه والغرائز % 25(@)(@@) % على حين لم يرسل إلى الماء فارط % ولاشد أوذاما على السجل ناهز % 26(@)(@@) % وجدت بما أضحى الورى يكنزونه % فلا ظفرت تلك الأكف الكوانز % 27(@)(@@) % تذود العدا عن دولة أرعدت لها % % فرائص تستشري عليها الهزاهز % 28(@)(@@) % نزا خالد فيهن وابن وشيكة % وآل كثير وابن كعب ولاهز % 29(@)(@@) % فرد إلى الغمد السريجي منتض % وألقى على الأرض الرديني راكز % 30(@)(@@) % وكل امرئ ينوي خلافك خائب % ومن هو يسعى في وفاقك فائز % PageV01P308 البحر : طويل 1(@)(@@) % بني مطر إن الخطوب تهون % وإن حديثي عنكم لشجون % 2(@)(@@) % فأي لئام كنتم في رعايتي % % وأي كريم في الجزاء أكون % 3(@)(@@) % صحبتكم والعيش أغبر والغنى % % تحسر عنكم والرياح سكون % 4(@)(@@) % فلما استفدتم ثروة طرتم بها % % نعم وبطرتم ، والجنون فنون % 5(@)(@@) % وغرتكم نعمى لبستم ظلالها % % على ثقة بالدهر وهو خؤون % 6(@)(@@) % فلا تشربوا حب الثراء قلوبكم % فكل عليه للزمان عيون % 7(@)(@@) % ركنتم إليه والحوادث عودت % إذالة مال المرء وهو مصون % 8(@)(@@) % فما اليسر إلا توأم العسر والمنى % % تسولها للعاجزين ظنون % PageV01P309 البحر : سريع 1(@)(@@) % أماط ، والليل أثيث الجناح % عن مبسم الشمس لثام الصباح % 2(@)(@@) % أغن يعروه مراح الصبا % % وينثني فالقد نشوان صاح % 3(@)(@@) % كالفنن المهزور ، تعتاده % على لغوب نسمات الرياح % 4(@)(@@) % يطوي الفلا وهنا وقد نشرت % ذوائب النار قريش البطاح % 5(@)(@@) % حيث القباب الحمر محفوفة % بالأسل السمر وبيض الصفاح % 6(@)(@@) % حل الدجى حبوتها إذ سرى % % والليل للبدر حماه مباح % 7(@)(@@) % إذا الكرى رنق في عينه % رنا بأجفان مراض صحاح % 8(@)(@@) % وإن وشى الحلي به راعه % بعد وفاء الخرس 
ms96	 غدر الفصاح % 9(@)(@@) % وكيف يستكتم خلخاله % % سرا وقد نم عليه الوشاح % 10(@)(@@) % إذا رنا لف الردى حاسرا % بدارع ، فاللحظ شاكي السلاح % PageV01P310 11(@)(@@) % وما أضاء البرق من ثغره % إلا تجلى حبب فوق راح % 12(@)(@@) % كأنه الروضة مطلولة % لها اغتباق بالندى واصطباح % 13(@)(@@) % إن مطرت فيها دموع الخيا % % ظلت بأنفاس النعامى تراح % 14(@)(@@) % فالطرف - إن مرضه - نرجس % والخد ورد ، والثغور الأقاح % 15(@)(@@) % صغا إلى الللاحي وصغو الهوى % % إليه ، لاروع صب بلاح % 16(@)(@@) % كالمهر إن طامنت من غريبه % أشمه الميعة جن المراح % 17(@)(@@) % أنصف إن جار ، وأعنو إذا % % سطا ، وألقى بالخشوع الجماح % 18(@)(@@) % فالغي رشد ، وهواني له % في الحب عز ، وفسادي صلاح % 19(@)(@@) % وربما تجمح بي نخوة % تلهج عيناي لها بالطماح % 20(@)(@@) % سأطلب العز ولو رفرفت % على حواشيه عوالي الرماح % PageV01P311 21(@)(@@) % بضربة رعلاء أو طعنة % تخاوصت منها عيون الجراح % 22(@)(@@) % متى أراها وهي مزورة % تعدو بآساد الشرى كالسراح % 23(@)(@@) % واليوم محمر أديم الضحى % % بالمشرفيات صقيل النواح % 24(@)(@@) % فالذابل الخطي يشكو الصدى % % حتى يروى بالنجيع المفاح % 25(@)(@@) % ياسروات الركب رفقا بنا % % فالأرحبيات رذايا طلاح % 26(@)(@@) % أسمعها الرعد بإرزامه % إهابة الحادي وراء اللقاح % 27(@)(@@) % واعترض المزن وفي شوطه % دون شآبيب حياه انتزاح % 28(@)(@@) % يومض بالبرق ، وكم حاردت % بودقه أطباؤه حين لاح % 29(@)(@@) % يحكي أبا المغوار في بشره % ياليته أشبهه في السماح % 30(@)(@@) % سيروا إلى آل عدي نقم % في عطن رحب وحي لقاح % PageV01P312 31(@)(@@) % حيث العراص الخضر ، والأنعم ال % % بيض ، وأنوار الوجوه الصباح % 32(@)(@@) % لا المنهل المورود طرق ، ولا ال % % مسرح ممنوع ، ولا الظل ضاح % 33(@)(@@) % إذا بلغنا عضد الدين لم % نثلم شبا المحل بضرب القداح % 34(@)(@@) % نهدي إليه مدحا نمتري % % بهن خلف لنائل المستماح % 35(@)(@@) % أروع طلق البرد ، لم يحتضن % من التقى حاشيتيه جناح % 36(@)(@@) % نائي المدى ، يقصر عن شأوه % خطا أطالتها الأعادي فساح % 37(@)(@@) % لا يغلب الحق به باطل % ولا يداني الجد منه مزاح % 38(@)(@@) % ومأزق أغمد فيه الظبا % % لما انتضى عزمته للكفاح % 39(@)(@@) % ونازل الموت بأرجائه % شهباء تقتاد المنايا رداح % 40(@)(@@) % وأنصت القرن 
ms97	 لداعي الردى % % حيث العوالي جهرت بالصياح % PageV01P313 41(@)(@@) % حتى تولى كالنعام العدا % % مقنعي الهام ببيض الأداح % 42(@)(@@) % ياواهب الأعمار بعد اللها % % ورت زنادي بك قبل اقتداح % 43(@)(@@) % إليك أغدو غير مستلفت % جيدي إلى رشح أكف شحاح % 44(@)(@@) % بهمة تفتر عن منية % مد هواديه إليها النجاح % 45(@)(@@) % وبين طمري فتى ماجد % لم يجتذب عارفة بامتداح % 46(@)(@@) % وحاجة دافع عن نيلها % % وجه حيي وزمان وقاح % 47(@)(@@) % وحاذر المنة من باخل % فطلق المنحة قبل النكاح % PageV01P314 البحر : طويل 1(@)(@@) % سرى البرق وهنا فاستحنت جماليا % وأخطر ذكرى أم عمرو بباليا % % 2(@)(@@) % وقد كنت عما يعقب الجهل نازعا % ومن أريحيات الصبابة ساليا % % 3(@)(@@) % فبرح بي شوق أراني بثغرها % % ودمعي وعقديها وشعري لآليا % % 4(@)(@@) % وذكرني ليلا بحزوى منحته % هوى تحسد الأيام فيه اللياليا % % 5(@)(@@) % وأصبح أدنى صاحبي يلومني % % فمالك يا ابن الهاشمي وماليا % % 6(@)(@@) % تكلفني ما لا أطيق وقد وهت % حبالك حتى زايلتها حباليا % % 7(@)(@@) % أما نحن فرعا دوحة غالبية % بحيث تناجي المكرمات المعاليا % % 8(@)(@@) % وكنا عقيدي ألفة ومودة % فكيف اجتنينا من تصاف تقاليا % % 9(@)(@@) % ولو خالفت في الحب وهي كريمة % علي يميني فارقتها شماليا % % 10(@)(@@) % رزقت الهدى والله مغو ومرشد % فدعني وما أختاره من ضلاليا % % PageV01P315 البحر : طويل 1(@)(@@) % أبت إبلي - والليل وحف الغدائر - % رشيف صرى في منحنى الورد غائر % 2(@)(@@) % وباتت تنادي جارها وهو راقد % وهيهات أن يرتاح مغف لساهر % 3(@)(@@) % وقد كاد أولاد الوجيه ولاحق % ترق لأبناء الجديل وداعر % 4(@)(@@) % دعي إبلي رجع الحنين بمبرك % يضيق على ذود الخليط المجاور % 5(@)(@@) % فعن كثب تشكو مناسمك الوجى % % وتطوي الفلا مخصوفة بالحوافر % 6(@)(@@) % وترويك في قيس حياض تظلها % % ذوابل في أيدي ليوث خوادر % 7(@)(@@) % بحيث رغاء المتليات وراءه % صهيل الجياد المقربات الضوامر % 8(@)(@@) % بنو عربيات ، يحوط ذمارها % % كماة كأنضاء السيوف البواتر % 9(@)(@@) % لهم في نزار محتد دون فرعه % تخاوص ألحاظ النجوم الزواهر % 10(@)(@@) % ولما طوت عني خزيمة كشحها % % ولم ترع في حيي قريش أواصري % % PageV01P316 11(@)(@@) % لويت عناني ، والليالي تنوشني % % إلى أريحي من ذؤابة عامر % 12(@)(@@) % فأفرخ روعي إذ 
ms98	 قمعت به العدا % % وخفض جأشي حين رفع ناظري % % 13(@)(@@) % فتى الحي يأبى صحبة الدرع في الوغى % % ولا تكلف الأرماح إلا بحاسر % 14(@)(@@) % ويوم تراءى شمسه من عجاجه % تطلع أسرار الهوى من ضمائر % 15(@)(@@) % وتختفق الرايات فيه كأنما % % هفت بحواشيها قوادم طائر % 16(@)(@@) % تبسم حتى انجاب جلباب نقعه % بمرموقة تطوي رداء الدياجر % 17(@)(@@) % تضيء وراء اللثم كالشمس أشرقت % وراء غمام للغزالة ساتر % 18(@)(@@) % فغض طماح الحرب ، وهي أبية % بكل عقيلي كريم العناصر % 19(@)(@@) % وحفت به من سر جوثة غلمة % مناعيش للمولى ، رقاق المآزر % % 20(@)(@@) % إذا اعتنق الأبطال خلت عيونهم % تبث شرار النار تحت المغافر % PageV01P317 21(@)(@@) % يصولون ، والهيجاء تلقي جرانها % % بمأثورة بيض وأيد قوادر % 22(@)(@@) % ويرجون من آل المهيا غطارفا % عظام المقاري واللها والمآثر % 23(@)(@@) % وينمي ضياء الدين من كبرائهم % إلى خير باد في معد وحاضر % 24(@)(@@) % سليل ملوك من نزار ، تخيروا % % له سروات المحصنات الحرائر % 25(@)(@@) % فجاء كماء المزن محضا نجاره % مقابل أطراف العروق الزواخر % 26(@)(@@) % يطيف به أنى تلفت سؤدد % أوائله مشفوعة بالأواخر % 27(@)(@@) % بني البزرى صاهرتم منه ماجدا % يزينكم أخرى الليالي الغوابر % 28(@)(@@) % وسقتم إلى أحسابه من خياركم % % عقائل لا تشرونها بالأباعر % 29(@)(@@) % فبوأتموها حيث يلقي به التقى % % مراسيه ، والعز مرخى الضفائر % 30(@)(@@) % وحزتم بكعب في كلاب مناقبا % تنافي أنابيب الرماح الشواجر % PageV01P318 31(@)(@@) % ولو بذل البدر النجوم لخاطب % لمد إلى ثروان باع المصاهر % 32(@)(@@) % فإيه أبا الشداد إن وراءنا % % أحاديث تروى بعدنا في المعاشر % 33(@)(@@) % فمن لي بخرق ثائر فوق سابح % تردى بإعصار من النقع ثائر % 34(@)(@@) % إذا حفزته هزة الروع خلته % على الطرف صقرا فوق فتخاء كاسر % 35(@)(@@) % أترضى - وما للعرب غيرك ملجأ % % توسدهم رملي زرود وحاجر % 36(@)(@@) % بهم ظمأ أدمى الجوانح برحه % وذموا إلى الشعرى احتدام الهواجر % 37(@)(@@) % وطوقتهم نعمى فهم يشكرونها % % ولا تأنس النعماء إلا بشاكر % 38(@)(@@) % فأين الجياد الجرد تخطو إلى العدا % % على علق تروى به الأرض مائر % 39(@)(@@) % وفتيان صدق يصدرون عن الوغى % % وأيدي المنايا داميات الأظافر % 40(@)(@@) % على عارفات للطعان عوابس % طوال الهوادي 
ms99	 ، مجفرات الخواصر % PageV01P319 41(@)(@@) % تقدت بآطال الظباء ، ومزجت % دما بدموع في عيون الجآذر % 42(@)(@@) % وحاجتهم إحدى اثنتين من العلا : % صدور العوالي أو فروع المنابر % PageV01P320 البحر : وافر تام 1(@)(@@) % سواي يكون عرضة مستريث % ويصدف عن نداء المستغيث % 2(@)(@@) % ويألف غمده الذكر اليماني % % وينبو نبوة السيف الأنيث % 3(@)(@@) % وإن لبس العجاجة ضل فيها % % ضلال المشط في الشعر الأثيث % 4(@)(@@) % فلست إذا النوائب أجهضتني % % بواه في الخطوب ولا مكيث % 5(@)(@@) % يهاب شراستي قرني ، وخلى % % أفيء به إلى خلق دميث % 6(@)(@@) % وأولغ صارمى والموت يتلو % % شباه مجاجة العلق النفيث % 7(@)(@@) % وللعافي بعقوتي احتكام % على شيم ترف عليه ميث % 8(@)(@@) % ولي ذمم إذا شدت عراها % % فما تفتر عن عهد نكيث % 9(@)(@@) % فها أنا أكرم الثقلين طرا % أبا فأبا إلى نوح وشيث % 10(@)(@@) % وأفصح من يقوم درء قول % يجوت الأرض بالعنق الحثيث % PageV01P321 11(@)(@@) % ولي كلم أطايب حين يشدو % % رواة السوء بالكلم الخبيث % 12(@)(@@) % تحل حبا الملوك لها ارتياحا % وتهزأ بالفرزدق والبعيث % 13(@)(@@) % فنم بما ترى يا نجد مني % % وإيه يا تهامة عن حديثي % % PageV01P322 البحر : بسيط تام 1(@)(@@) % لواعج الحب أخفيها وأبديها % % والدمع ينشر أسراري وأطويها % % 2(@)(@@) % ولوعة كشباة الرمح يطفئها % % تجلدي وأوار الشوق يذكيها % % 3(@)(@@) % إحدى كنانة حلت سفح كاظمة % غداة سأل بظعن الحي واديها % % 4(@)(@@) % فلست أدري أمن دمع أرقرقه % أم من مباسمها ما في تراقيها % % 5(@)(@@) % ذكرت بالرمل من حزوى روادفها % % والعين تمرح عبري في مغانيها % % 6(@)(@@) % بحيث ترشح أم الخشف واحدها % % على مذانب ترعى في محانيها % % 7(@)(@@) % دار على عذبات الجزع ناحلة % تميتها الريح والأمطار تحييها % % 8(@)(@@) % حييتها وجفون العين مترعة % بأدمع رسبت فيها مآقيها % % 9(@)(@@) % وقل للدار مني مدمع هطل % وعبرة ظلت في ردني أواريها % % 10(@)(@@) % فقد نضوت بها الأيام ناضرة % تغني عن السحر الأعلى لياليها % % PageV01P323 11(@)(@@) % أزمان أخطر في بردي هوى وصبا % بلمة يعجب الحسناء داجيها % % 12(@)(@@) % فانجاب ليل شباب كنت آلفه % إذ لاح صبح مشيبي في حواشيها % % 13(@)(@@) % يا سرحة القاع رواك الحيا غدقا % من ديمة هطلت وطفا عزاليها % % 14(@)(@@) % زرناك 
ms100	 والظل ألمى فاستريب بنا % % ولم ينخ عندك الأنضاء حاديها % % 15(@)(@@) % ومسرح المهرة الدهماء مكتهل % لو كان بالروضة الغناء راعيها % % 16(@)(@@) % لويت عنه عناني وهي تجمح بي % % والبيض مرتعدات في غواشيها % % 17(@)(@@) % مهر الفزاري غض الطرف عن نغب % يروي بها إبل العبسي ساقيها % % 18(@)(@@) % فقد نمتك جياد لا تلم بها % % حتى ترى السمر محمرا عواليها % % 19(@)(@@) % كأن آذانها الأقلام جارية % بما نبا السيف عنه في مجاريها % % 20(@)(@@) % منها الندى والردى فالمعتفون رأوا % % أرزاقهم مع آجال العدا فيها % % PageV01P324 21(@)(@@) % بكف أروع لم يطمح لغايته % ثواقب الشهب في أعلى مساريها % % 22(@)(@@) % يمطي ذرا الشرف العادي همته % ملقى على الأمد الأقصى مراسيها % % 23(@)(@@) % ذو سؤدد كأنابيب القنا نسق % في نجدة من دماء الصيد ترويها % % 24(@)(@@) % يزهى بها الدهر والأيام مشرقة % تهز في ظله أعطافها تيها % % 25(@)(@@) % وعصبة ملئت أسماعهم كلما % ظللت أخلقها فيهم وأفريها % % 26(@)(@@) % أوطأتهم عقبي إذ فقتهم حسبا % % براحة يرتدي بالنجح عافيها % % 27(@)(@@) % فقلد السيف يوم الروع طابعه % وأعطي القوس عند الرمي باريها % % 28(@)(@@) % أرى أهيل زماني حاولوا رتبي % % وللنجوم ازورار عن مراقيها % % 29(@)(@@) % وللصقور مدى لا ترتقي صعدا % إليه أغربة تهفو خوافيها % % 30(@)(@@) % لولا مساعيك لم أهدر بقافية % يكاد يسترقص الأسماع راويها % % PageV01P325 31(@)(@@) % إذا وسمت بك الأشعار أصحب لي % % أبيها فيك وانثالت قوافيها % % PageV01P326 البحر : بسيط تام 1(@)(@@) % وليلة من ليالي الدهر صالحة % فهن وهي الشفاه اللعس والرثم % 2(@)(@@) % جعلت يمناي فيها طوق غانية % حور مدامعها في كشحها هضم % 3(@)(@@) % فارفض شمل الكرى والطل يخضلنا % % سقيطه وثغور الصبح تبتسم % 4(@)(@@) % نمشي بمنعرج الوادي على وجل % والنوم من أعين الواشين ينتقم % 5(@)(@@) % ثم افترقنا وبردي في معاطفه % تقى يعانق فيه العفة الكرم % PageV01P327 البحر : - 1(@)(@@) % عرضت كخطوط البانة الأملود % تختال بين مجاسد وعقود % 2(@)(@@) % هيفاء لينة التثني ، أقبلت % في خرد كمها الصرائم غيد % 3(@)(@@) % ومررن بالوادي على عذب الحمى % % فحكين هزة بأنه بقدود % 4(@)(@@) % وحكى الشقيق به اسوداد قلوبها % % وأعير منهن احمرار خدود % 5(@)(@@) % وكأن أعينهن من وجناتها % % شربت على ثمل دم العنقود % 6 