ms5781	 الدنيا وما فيها ، فقال النبي : ( وإنكم لتجدونه ) ؟ قالوا : نعم يا رسول الله قال : ذاك محض الإيمان ) . ( محمد بن عثمان PageV17P139 الأذرعي في كتاب الوسوسة ) . )(@)(@@)(@@)(@@) $ 9487 عن أبي أمامة رضي الله عنه قال :(@)(@@) | 30 ( لما نزلت : { لقد رضي الله عن المؤمنين إذ يبايعونك تحت الشجرة } ، قلت : يا رسول الله أنا ممن بايعك تحت الشجرة ، قال : ( يا أبا أمامة أنت مني وأنا منك ) . ( ابن مردويه ، كر ) . )(@)(@@)(@@)(@@) $ 9488 عن أبي غالب قال :(@)(@@) | 30 ( رأيت أبا أمامة رضي الله عنه يمسح علاى الخفين ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 9489 عن أبي أمامة رضي الله عنه :(@)(@@) | 30 ( أن رجلا قال : يا رسول الله ما المسلم ؟ فقال رسول الله : من سلم المسلمون من لسانه ويده ) . ( ابن النجار ) . )(@)(@@)(@@)(@@) $ 9490 عن أبي أمامة رضي الله عنه :(@)(@@) | 30 ( أن النبي لعن يوم خيبر : الواصلة والموصولة ، والواشمة والموشومة ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 9491 عن أبي أمامة رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : ( من حلف علاى يمين ليقتطع بها مال امرىء مسلم لقي الله وهو عليه غضبان ) ، فقال رجل وهو يزهد الأمر ويصغره : يا رسول الله وإن كان سواكا من أراك ؟ قال : ( وإن كان سواكا من أراك ) . ( هب ) . )(@)(@@)(@@)(@@) $ 9492 عن أبي رافع عن أبي أمامة رضي الله عنه قال :(@)(@@) | 30 ( لما آخاى رسول الله بين الناس ، آخاى بينه وبين علي رضي الله عنه ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9493 عن أبي أمامة رضي الله عنه قال :(@)(@@) | 30 ( بعثني رسول الله إلاى قوم أدعوهم إلاى الله وإلاى رسوله ، وأعرض عليهم شرائع الاسلام ، فأتيتهم وقد سقوا PageV17P140 إبلهم واحتلبوها وشربوا ، فلما رأوني قالوا : مرحبا بصداى بن عجلان ، قالوا : بلغنا أنك صبؤت إلاى هاذا الرجل ، قلت : لا ولاكني آمنت بالله ورسوله وبعثني رسول الله إليكم أعرض الإسلام وشرائعه ، فبينا نحن كذالك إذ جاءوا بقصعة من دم فوضعوها واجتمعوا عليها يأكلونها ، قالوا : هلم يا صداى ، قلت : ويحكم إنما أتيتكم من عند من يحرم هاذا عليكم بما أنزله الله عليه ، قالوا : وما ذالك ؟ فتلوت عليهم هاذه الآية : { حرمت عليكم الميتة والدم ولحم الخنزير . . إلاى قوله 
ms5782	 : ذالكم فسق } فجعلت أدعوهم إلاى الاسلام ويأبون علي ، فقلت لهم : ويحكم اسقوني شربة من ماء فإني شديد العطش وعلي عباءة ، قالوا : لا ، ولاكن ندعك حتى تموت عطشا ، فاغتظت وضربت برأسي في العباءة ونمت في الرمضاء في حر شديد ، فأتاني آت في منامي بقدح زجاج لم ير الناس أحسن منه وفيه شراب لم ير الناس شرابا ألذ منه ، فأمكنني منا فشربتها ، فحين فرغت من شرابي استيقظت ، فلا والله ما عطشت ولا أغريت بعد تلك الشربة ) . ( كر ) . )(@)(@@)(@@)(@@) |||| ( مسند 23 أبي أمامة ، أسعد بن سهل بن حنيف(@)(@@) رضي الله عنه ) $(@)(@@)(@@)(@@) $ 9494 عن عبد الله بن المبارك ، عن أبي بكر بن عثمان قال :(@)(@@) | 30 ( سمعت أبا أمامة رضي الله عنه حدث أن سهلا وعامر بن ربيعة قال لهما رسول الله : ( أخرج يا سهل بن حنيف ويا عامر بن ربيعة حتى تكونوا لنا عينا ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9495 عن الزهري قال :(@)(@@) | 30 ( سمعت أبا أمامة بن سهل رضي الله عنه يحدثنا في مجلس سعيد بن المسيب قال : مضت السنة أن لا تؤخذ الزكاة من نخل ولا عنب حتى يبلغ خرجها خمسة أوسق ) . ( ابن جرير ) . )(@)(@@) PageV17P141(@)(@@)(@@)(@@) $ 9496 عن أبي أمامة بن سهل رضي الله عنه :(@)(@@) | 30 ( أن رجلا من مساكين المسلمين كان ضريرا ، فأصاب الناس ليلة ماطرة أو ليلة باردة فدعته امرأة من المسلمين إلاى بيتها ، فوثب عليها فغلبها علاى نفسها ، فأتت النبي فأخبرته بما صنع ، فأرسل إليه فاعترف ، فأمر النبي بقنو فعدمنه مئة شمراخ ثم أمر به فضرب ضربة واحدة ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 9497 عن أبي أمامة بن سهل بن حنيف رضي الله عنه قال :(@)(@@) | 30 ( مر عامر بن ربيعة بسهل بن حنيف وهو يغتسل فقال : لم أر كاليوم ولا جلد مخبأة ، فما لبث أن لبط به ، فأتيع النبي فقيل له : أدرك سهلا صريعا ، فقال : من تتهمونه ؟ قالوا : عامر بن ربيعة ، قال : علام يقتل أحدكم أخاه ؟ إذا رأى أحدكم من أخيه أمرا يعجبه فليدع له بالبركة ، ثم أمره فغسل وجهه ويديه إلاى مرفقيه وركبتيه وداخلة إزاره فرش عليه ) . ( ن 
ms5783	 ، وأبو نعيم ) . )(@)(@@)(@@)(@@) $ 9498 عن شقيق أبي وائل قال :(@)(@@) | 30 ( سمعت سهل بن حنيف يقول بصفين : أيها الناس اتهموا رأيكم ، فوالله لقد رأيتني يوم أبي جندل ولو أستطيع أن أرد أمر رسول الله لرددته ، والله ما وضعنا سيوفنا علاى عواتقنا مع رسول الله لأمر يفظعنا قط إلا أسهل بنا إلاى أمر نعرفه إلا أمركم هاذا ) . ( ش ونعيم بن حماد في الفتن ) . )(@)(@@)(@@)(@@) $ 9499 عن أبي أمامة بن سهل بن حنيف الأنصاري :(@)(@@) | 30 ( أن النبي صلى الظهر ثم ضرب ماعز ، فطول الأوليين من الظهر حتى كاد الناس يعجزون عنهما من طول القيام ، فلما انصرف أمر أن يرجم ، فرجم فلم يقتل حتى رماه عمر بن PageV17P142 الخطاب رضي الله عنه بلحى بعير فأصاب رأسه فقتله ، فقال رجل حين فاظ لماعز : تعست فقيل للنبي : يا رسول الله نصلي عليه ؟ قال : ( نعم ) ، فلما كان الغد صلى الظهر فطول الركعتين الأوليين كما طولهما بالأمس ، أو أدناى شيئا ، فلما انصرف قال : ( صلوا علاى صاحبكم ) ، فصلى عليه النبي والناس ) . ( عب ) . )(@)(@@)(@@)(@@) $ 9500 عن أبي أمامة بن سهل بن حنيف رضي الله عنه :(@)(@@) | 30 ( أنه أخبره رجل من أصحاب النبي : أن السنة في الصلاة علاى الجنازة أن يكبر الامام ثم يقرأ أم القرآن بعد التكبيرة الأولاى سرا في نفسه ، ويصلي علاى النبي ، ثم يخلص الدعاء للميت في التكبيرات الثلات ، لا يقرأ فيهن بعد التكبيرة الأولاى ، ويسلم سرا تسليما خفيا حتى ينصرف ، فالسنة أن يفعل ويفعل الناس بمثل ما فعل إمامهم ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9501 عن الزهري :(@)(@@) | 30 ( أن أبا أمامة بن سهل بن حنيف سماه النبي أسعد ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9502 عن أبي أمامة بن سهل بن حنيف رضي الله عنه :(@)(@@) | 30 ( أن مسكينة مرضت ، فأخبر رسول الله بمرضها ، قال : وكان رسول الله يعود المساكين ويسأل عنهم ، فقال رسول الله : ( إذا ماتت فآذنوني بها ) فخرجوا بجنازتها ليلا وكرهوا أن يوقظوا رسول الله ، فلما أصبح أخبر بالذي كان من شأنها ، فقال : ( ألم آمركم أن تؤذنوني بها ) ؟ فقالوا : يا رسول الله كرنا أن نخرجك ليلا ، فخرج رسول الله 
ms5784	 حتى صف الناس علاى قبرها وكبر أربع تكبيرات ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9503 عن أبي أمامة بن سهل بن حنيف رضي الله عنه قال :(@)(@@) | 30 ( السنة في PageV17P143 الصلاة علاى الجنائز : أن يقرأ في التكبيرة الأولاى بأم القرآن مخافتة ، ثم يكبر ثلاثا ، والتسليم عند الآخرة ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9504 عن أبي أمامة رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : من حلف علاى يمين ليقتطع بها مال امرىء مسلم لقي الله وهو عليه غضبان ، فقال رجل وهو يزهد الأمر أو يصغره : يا رسول الله وإن كان سواكا من أرك ؟ قال : ( وإن كان سواكا من أراك ) . ( هب ) . )(@)(@@)(@@)(@@) $ 9505 عن أبي أمامة بن سهل بن حنيف رضي الله عنه :(@)(@@) | 30 ( أن أبا أمامة أسعد بن زرارة رضي الله عنه وكان أحد النقباء يوم العقبة أنه أخذته الشوكة ، فجاءه رسول الله يعوده فقال رسول الله : بئس الميت ليهود مرتين سيقولون : لولا دفع عن صاحبه ، وما أملك له ولا لنفسي ضرا ولا نفعا ، فأمر به وكوي بخطين فوق رأسه فمات ) . ( حم ، والبغوي ، والباوردي ، طب ، وأبو نعيم ) . )(@)(@@)(@@)(@@) |||| ( 24 أبو أمامة ، صدى بن عجلان(@)(@@) رضي الله عنه ) 3 $(@)(@@)(@@)(@@) $ 9506 عن أبي أمامة رضي الله عنه قال :(@)(@@) | 30 ( بعثني رسول الله إلاى قوم أدعوهم إلاى الله وإلاى رسوله وأعرض عليهم شرائع الإسلام ، فأتيتهم وقد سقوا إبلهم واحتلبوها وشربوا ، فلما رأوني قالوا : مرحبا بصدى بن عجلان ؟ قالوا : بلغنا أنك صبؤت إلاى هاذا الرجل ، قلت : لا ولاكني آمنت بالله ورسوله ، وبعثني رسول الله إليكم أعرض عليكم الاسلام وشرائعه ، فبينا نحن كذالك إذ جاءوا بقصعة من دم فوضعوها واجتمعوا عليها يأكلونها ، قالوا : هلم يا صدى قلت : ويحكم إنما أتيتكم من عند من يحرم هاذا عليكم بما أنزل الله عليه ، قالوا : وما ذالك ؟ PageV17P144 فتلوت هاذه الآية : { حرمت عليكم الميتة والدم ولحم الخنزير } إلاى قوله : { ذالكم فسق } فجعلت أدعوهم إلاى الإسلام ويأبون علي ، فقلت لهم : ويحكم اسقوني شربة من ماء ، فإني شديد العطش وعلي عباءة ، قالوا : لا ، ولاكن ندعك حتى تموت عطشان ، فاعتصمت فضربت برأسي في العباءة ونمت 
ms5785	 في الرمضاء في حر شديد ، فأتاني آت في منامي بقدح زجاج لم ير الناس أحسن منه ، وفيه شراب لم ير الناس شرابا ألذ منه ، فأمكنني منها فشربتها ، فحين فرغت من شرابي استيقظت ، فلا والله ما عطشت ولا غرثت بعد تلك الشربة ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9507 عن أبي أمامة رضي الله عنه قال :(@)(@@) | 30 ( أخذ رسول الله بيدي ثم قال : يا أبا أمامة إن من المؤمنين من يلين له قلبي ) . ( كر ) . )(@)(@@)(@@)(@@) |||| ( 25 أبو أمامة ، إياس بن ثعلبة البلوي(@)(@@) رضي الله عنه(@)(@@)(@@)(@@) $ 9508 عن أبي أمامة إياس بن ثعلبة البلوي رضي الله عنه قال :(@)(@@) | 30 ( لما هم رسول الله بالخروج إلاى بدر أزمعت الخروج معه ، فقال له خاله أبو بردة بن نيار : أقم علاى أمك ، قال : بل أنت أقم علاى أختك ؛ فذكر ذالك لرسول الله ، فأمر أبا أمامة بالمقام ، وخرج أبو بردة ، فرجع رسول الله وقد توفيت ، فصلاى عليها ) . ( الحسن بن سفيان ، وأبو نعيم ) . )(@)(@@)(@@)(@@) |||| ( 25 أبو أمامة ، إياس بن ثعلبة البلوي(@)(@@) رضي الله عنه(@)(@@)(@@)(@@) $ 9508 عن أبي أمامة إياس بن ثعلبة البلوي رضي الله عنه قال :(@)(@@) | 30 ( لما هم رسول الله بالخروج إلاى بدر أزمعت الخروج معه ، فقال له خاله أبو بردة بن نيار : أقم علاى أمك ، قال : بل أنت أقم علاى أختك ؛ فذكر ذالك لرسول الله ، فأمر أبا أمامة بالمقام ، وخرج أبو بردة ، فرجع رسول الله وقد توفيت ، فصلاى عليها ) . ( الحسن بن سفيان ، وأبو نعيم ) . )(@)(@@)(@@)(@@) |||| ( 26 أبو أوفاى الأسلمي ، علقمة رضي الله عنه )(@)(@@)(@@)(@@) $ 9509 عن إبراهيم الهجري قال : $ 30 ( رأيت ابن أبي أوفاى وكان من أصحاب PageV17P145 الشجرة ، وماتت ابنته فتبعها علاى بغل خلفها فجعل النساء يرثين ، فقال : لا ترثين ، فإن رسول الله نهاى عن الرثاء ، ولتفض إحداكن من عبرتها ما شاءت ، ثم كبر عليها أربعا ، ثم قام بعد ذالك قدر ما بين التكبيرتين يدعو ، وقال : إن رسول الله كان يصنع علاى الجنائز هاكذا ) . ( ابن النجار ) .(@)(@@)(@@)(@@) |||| ( مسند 27 أبي أيوب الأنصاري رضي الله عنه )(@)(@@)(@@)(@@) $ 9510 عن أبي أيوب رضي الله عنه قال : $ 30 ( أن 
ms5786	 نبي الله أخبرني أنه لا يدخل النار أحد يقول : لا إلاه إلا الله ) . ( كر ) .(@)(@@)(@@)(@@) $ 9511 عن أبي أيوب رضي الله عنه :(@)(@@) | 30 ( أن رسول الله ليلة أسري به مر به جبريل علاى إبراهيم خليل الرحمان ، فقال إبراهيم لجبريل : من هاذا الذي معك ؟ فقال جبريل : هاذا محمد ، فقال إبراهيم : يا محمد مر أمتك ، فليكثروا من غراس الجنة ، فإن أرضها واسعة ، وتربتها طيبة ، فقال محمد لإبراهيم عليه السلام : وما غراس الجنة ؟ فقال إبراهيم : لا حول ولا قوة إلا بالله ) . ( أبو نعيم وابن النجار ) . )(@)(@@)(@@)(@@) $ 9512 عن أبي أيوب رضي الله عنه قال :(@)(@@) | 30 ( قدم رسول الله المدينة ، فنزل علاى أبي أيوب ، فنزل رسول الله السفل ، ونزل أبو أيوب العلو ، فلما أمساى وبات ، جعل أبو أيوب يذكر أنه علاى ظهر بيت ، رسول الله أسفل منه ، وهو بينه وبين الوحي ، فجعل أبو أيوب لا ينام ، يحاذر أن يتناثر عليه الغبار ويتحرك فيؤذيه ، فلما أصبح غدا إلاى النبي فقال : يا رسول الله ما جعلت الليلة فيها غمضا أنا ولا أم أيوب ، فقال : ومم ذاك يا أبا أيوب ؟ قال : ذكرت أني علاى ظهر بيت أنت أسفل مني ، فأتحرك فيتناثر الغبار ، ويؤذيك تحركي ، وأنا بينك وبين الوحي ، قال : PageV17P146 فلا تفعل يا أبا أيوب ، ألا أعلمك كلمات إذا قلتهن بالغداة عشر مرات ، وبالعشي عشر مرات ، أعطيت بهنا عشر حسنات ، وكفر عنك بهن عشر سيئات ، ورفع لك بهن عشر درجات ، وكن لك يوم القيامة كعدل عشر محررين ؟ تقول : لا إلاه إلا الله ، له الملك ، وله الحمد ، لا شريك له ) . ( طب ) . )(@)(@@)(@@)(@@) $ 9513 عن زياد بن أنعم قال :(@)(@@) | 30 ( انضم مركبنا إلاى مركب أبي أيوب الأنصاري رضي الله عنه في البحر ، وكان معنا رجل مزاح ، فكان يقول لصاحب طعامنا : جزاك الله تعالاى خيرا وبرا فيغضب ، فقلنا لأبي أيوب : إن معنا رجلاف إذا قلنا له : جزاك الله خيرا وبرا يغضب ، فقال : اقلبوه له ، فإنا كنا نتحدث أن من لم يصلحه الخير أصلحه الشر ، فقال له المزاح : جزاك الله تعالاى شرا وعرا فضحك ، وقال 
ms5787	 : ما تدع مزاحك ، فقال الرجل : جزاك الله يا أبا أيوب خيرا ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9514 عن أبي أيوب رضي الله عنه قال :(@)(@@) | 30 ( جاء رجل إلاى النبي فقال : يا رسول الله دلني علاى عمل أعمله ، يقربني من الجنة ، ويباعدني عن النار ، قال : اعبد الله ولا تشرك به شيئا ، وتقيم الصلاة ، وتؤتي الزكاة ، وتصل ذا رحمك ، فلما أدبر ، قال : إن تمسك بما أمرته ، دخل الجنة ) . ( ابن النجار ) . )(@)(@@)(@@)(@@) $ 9515 عن أبي أيوب رضي الله عنه قال :(@)(@@) | 30 ( صليت المغرب والعشاء الآخرة مع رسول الله بحجة الوداع بالمزدلفة ) . ( أبو نعيم كر ) . )(@)(@@)(@@)(@@) $ 9516 عن أبي أيوب رضي الله عنه :(@)(@@) | 30 ( أن النبي كان يدمن أربعا عند زوال الشمس ، فقلت له : يا رسول الله إنك تدمن هاذه الأربع ركعات عند زوال الشمس ، فقال : ( إن أبواب السماء تفتح عند زوال الشمس فلا ترتج حتى يصلى PageV17P147 الظهر ، فأحب أن يصعد لي في تلك الساعة خير ) ، قلت : أفي كلهن قراءة ؟ قال : ( نعم ) ، قلت : أفيهن تسليم فاصل ؟ قال : ( لا ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 9517 عن أبي أيوب رضي الله عنه :(@)(@@) | 30 ( أنه كان يصلي أربع ركعات قبل الظهر ، ويقول : رأيت رسول الله يصليهن حين تزول الشمس ، فقلت : يا نبي الله أراك تديم هاذه الصلاة ؟ فقال : إنها ساعة تفتح فيها أبواب السماء ، فأحب أن يرفع لي فيها عمل صالح ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 9518 عن أبي أيوب رضي الله عنه :(@)(@@) | 30 ( لما نزل رسول الله علي رأيته يديم أربعا قبل الظهر وقال : إنه إذا زالت الشمس فتحت أبواب السماء ، فلا يغلق منها باب حتى يصلى الظهر ، فأنا أحب أن يرفع لي في تلك الساعة خير ) . ( طب ) . )(@)(@@)(@@)(@@) $ 9519 عن عروة عن زيد بن ثابت وأبي أيوب رضي الله عنها :(@)(@@) | 30 ( أن النبي قرأ في المغرب بالأعراف في الركعتين جميعا ) . ( ش ) . )(@)(@@)(@@)(@@) $ 9520 عن أبي أيوب رضي الله عنه :(@)(@@) | 30 ( أن النبي قرأ في الصبح : { تبارك الذي بيده الملك } ) . ( أبو نعيم ) . )(@)(@@)(@@)(@@) $ 9521 عن محمد بن كعب القرظي قال :(@)(@@) | 30 ( كان أبو أيوب رضي الله عنه يخالف مروان ، فقال له 
ms5788	 مروان : ما يحملك علاى هاذا ؟ قال : إني رأيت رسول الله يصلي الصلوات الخمس ، فإن وافقته وافقناك ، وإن خالفته خالفناك ) . ( الروياني كر ) . )(@)(@@)(@@)(@@) $ 9522 عن ابن سيرين :(@)(@@) | 30 ( أن أبا أيوب رضي الله عنه كان يصلي بعد العصر PageV17P148 ركعتين ، فنهاه زيد بن ثابت رضي الله عنه فقال : إن الله تعالاى لا يعذبني علاى أن أصلي ، ولاكن يعذبني علاى أن لا أصلي ، فقال : إني آمرك بهاذا وأنا أعلم أنك خير مني ، وما عليك بأس أن تصلي ركعتين بعد العصر ، ولاكن أخاف أن يراك من لا يعلم ، فيصلي حتى يصلي في الساعة التي حرم فيها الصلاة ) . ( ابن جرير ، كر ) . )(@)(@@)(@@)(@@) $ 9523 عن أبي زيد قال :(@)(@@) | 30 ( دخلت أنا ونوف البكالي علاى أبي أيوب الأنصاري رضي الله عنه وقد اشتكاى ، فقال نوف : اللهم عافه واشفه ، قال : لا تقولوا هاذا وقولوا : اللهم إن كان أجله عاجلا فاغفر له وارحمه ، وإن كان آجلا فعافه واشفه وآجره ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9524 عن أفلح مولاى أبي أيوب رضي الله عنه :(@)(@@) | 30 ( أنه كان يأمر بالمسح علاى الخفين ، وكان هو يغسل قدميه ، فقيل له : كيف تأمر بالمسح وأنت تغسل ؟ فقال : بئس مآلي إن كان مهنأة لكم ومأثمة علي ، فقد رأيت رسول الله يفعله ويأمر به ، لاكني امرؤ حبب إلي الوضوء ) . ( عب ، ص ، ش ، ع ، وابن جرير ) . )(@)(@@)(@@)(@@) $ 9525 عن أبي صادق قال :(@)(@@) | 30 ( قدم علينا أبو أيوب الأنصاري رضي الله عنه العراق ، فقلت له : يا أبا أيوب قد كرمك الله بصحبة نبيه محمد ، وبنزوله عليك ، فما لي أراك تستقبل الناس تقاتلهم ؟ تستقبل هاؤلاء مرة ، وهاؤلاء مرة ، فقال : إن رسول الله عهد إلينا أن نقاتل مع علي الناكثين فقد قاتلناهم وعهد إلينا أن نقاتل معه القاسطين فهاذا وجهنا إليهم يعني معاوية وأصحابه ، وعهد إلينا أن نقاتل مع علي المارقين فلم أرهم بعد ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9526 عن محمد بن سليم قال :(@)(@@) | 30 ( أتينا أبا أيوب رضي الله عنه فقلنا : يا أبا أيوب قاتلت المشركين بسيفك مع رسول الله ثم جئت تقاتل المسلمين قال : إن رسول الله أمرنا 
ms5789	 بقتال ثلاثة : الناكثين ، والقاسطين ، والمارقين ) . فقد قاتلت PageV17P149 الناكثين والقاسطين . وأنا مقاتل إن شاء الله المارقين ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 9527 عن أبي أيوب رضي الله عنه قال :(@)(@@) | 30 ( صنعت للنبي وأبي بكر رضي الله عنه طعاما قدر ما يكفيهما ، فأتيتهما به ، فقال لي رسول الله : إذهب فادع لي ثلاثين من أشراف الأنصار فشق ذالك علي ، فقلت : ما عندي شيء أزيده ، فكأني تغفلت ، فقال : إذهب فادع لي ثلاثين من أشراف الأنصار ، فدعوتهم فجاءوا ، فقال : اطعموا ، فأكلوا حتى صدروا ، ثم شهدوا أنه رسول الله ثم بايعوه قبل أن يخرجوا ، ثم قال : إذهب فادع لي ستين من أشرا الأنصار ، والله لأنا بالستين أجود مني بالثلاثين ، فدعوتهم ، فأكلوا حتى صدروا ثم شهدوا أنه رسول الله ، ثم بايعوه قبل أن يخرجوا ، ثم قال : إذهب فادع لي تسعين من الأنصار ، فلأنا أجود بالتسعين والستين مني بالثلاثين ، فدعوتهم ، فأكلوا حتى صدروا ، ثم شهدوا أنه رسول الله ثم بايعوه قبل أن يخرجوا ، فأكل من طعامي ذالك مائة وثمانون رجلا كلهم من الأنصار ) . ( طب ) . )(@)(@@)(@@)(@@) $ 9528 عن أبي أيوب رضي الله عنه :(@)(@@) | 30 ( أنه تناول من لحية رسول الله الأذاى ، فقال رسول الله : مسح الله بك يا أبا أيوب ما تكره ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9529 عن سعيد بن المسيب :(@)(@@) | 30 ( أن أبا أيوب الأنصاري رضي الله عنه أخذ من لحية رسول الله شيئا ، فقال له النبي : لا يصيبك السوء يا أبا أيوب ) . ( عد ، كر ) . )(@)(@@)(@@)(@@) $ 9530 عن سعيد بن المسيب :(@)(@@) | 30 ( أن أبا أيوب الأنصاري أبصر إلاى لحية رسول الله أذى فنزعه فأراه إياه ، فقال النبي : نزع الله عن أبي أيوب ما يكره ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9531 عن حبيب بن أبي ثابت :(@)(@@) | 30 ( دن أبا أيوب رضي الله عنه أتاى معاوية PageV17P150 فشكا إليه أن عليه دينا ، فلم ير منه ما يحب ورأى ما يكرهه ، فقال : سمعت رسول الله يقول : ( إنكم سترون بعدي أثرة ) قال : فأي شيء قال لكم ؟ قال : ( اصبروا ) ، قال : فاصبروا ، فقال : والله لا أسألك شيئا أبدا ، فقدم البصرة فنزل علاى ابن عباس رضي الله عنهما 
ms5790	 ، ففرغ له بيته وقال : لأصنعن بك كما صنعت برسول الله ، فأمر أهله فخرجوا ، وقال : لك ما في البيت كله ، وأعطاه أربعين ألفا وعشرين مملوكا ) . ( الروياني ، كر ) . )(@)(@@)(@@)(@@) $ 9532 عن عمارة بن غزية قال :(@)(@@) | 30 ( دخل أبو أيوب رضي الله عنه علاى معاوية فقال : صدق رسول الله سمعت رسول الله يقول : يا معشر الأنصار إنكم سترون بعدي أثرة فعليكم بالصبر فقال معاوية : صدق رسول الله ، أنا أول من صدقه ، فقال أبو أيوب رضي الله عنه : أجرأة علاى الله وعلاى رسوله ؟ لا أكلمه أبدا ، ولا يأويني وإياه سقف بيت ) . ( يعقوب بن سفيان ، كر ) . )(@)(@@)(@@)(@@) $ 9533 عن أبي أيوب رضي الله عنه قال :(@)(@@) | 30 ( نزل رسول الله في بيتنا الأسفل ، وكنت في الغرفة ، فاهريق ماء في الغرفة ، فقمت أنا وأم أيوب بقطيفة لنا نتتبع الماء شفقا أن يخلص إلاى رسول الله ، فنزلت إلاى رسول الله وأنا مشفق ، فقلت : يا رسول الله لا ينبغي أن أكون فوقك ، انتقل إلاى الغرفة فأمر رسول الله بمتاعه فنقل ، ومتاعه قليل ، فقلت : يا رسول الله كنت ترسل إلي بالطعام فأنظر ، فإذا رأيت أثر أصابعك وضعت يدي فيه ، حتى إذ كان هاذا الطعام الذي أرسلت به إلي فنظرت فلم أر فيه أثر أصابعك فقال رسول الله : أجل ، إن فيه بصلا وكرهت أن آكله من أجل الملك الذي يأتيني ، وأما أنتم فكلوه ) . ( أبو نعيم ، كر ) . )(@)(@@)(@@)(@@) $ 9534 عن أبي أيوب رضي الله عنه قال :(@)(@@) | 30 ( لما نزل علي رسول الله قلت : بأبي وأمي إني أكره أن أكون فوقك وتكون أسفل مني ، فقال رسول الله : PageV17P151 إن أرفق بنا أن نكون في السفل لما يغشانا من الناس ، فلقد رأيت جرة لنا انكسرت فأهريق ماؤها ، فقمت أنا وأم أيوب بقطيفة لنا مالنا لحاف غيرها فننشف بها الماء فرقا من أن يصل إلاى رسول الله منا شيء يؤذيه ، فكنا نصنع طعاما ، فإذا رد ما بقي منه تيممنا موضع أصابعه ، فأكلنا منها نريد بذالك البركة ، فرد علينا عشاءه ليلة وكنا جعلنا فيه ثوما أو بصلا ، فلم نر فيه 
ms5791	 أثر أصابعه ، فذكرت له الذي كنا نصنع ، والذي رأينا من رده الطعام ولم يأكل فقال : إني وجدت منه ريح هاذه الشجرة ، وأنا رجل أناجي فلم أحب أن يوجد مني ريحه ، فأما أنتم فكلوه ) . ( طب ) . )(@)(@@)(@@)(@@) $ 9535 عن سالم بن عبد الله قال :(@)(@@) | 30 ( أعرست في عهد أبي فدعا أبي الناس ، فكان فيمن دعا أبا أيوب ، وقد ستروا بيتي ببجادي أخضر ، فجاء أبو أيوب رضي الله عنه فطأطأ رأسه فنظر ، فإذا البيت ستر ، فقال : يا عبد الله تسترون دلجدر فقال أبي واستحييا : غلبنا النساء يا أبا أيوب فقال : من خشيت أن تغلبه النساء ، فلم أخش أن يغلبنك لا أدخل لكم بيتا ولا أطعم لكم طعاما ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9536 عن أبي أيوب رضي الله عنه :(@)(@@) | 30 ( أن رسول الله خرج عند المغرب فسمع صوتا ، فقال : اليهود تعذب في قبورها ) . ( ط ، وأبو نعيم ) . )(@)(@@)(@@)(@@) $ 9537 عن أبي أيوب رضي الله عنه :(@)(@@) | 30 ( أن رجلا قال : يا رسول الله عظني وأوجز ، قال : إذا كنت في صلاتك فصل صلاة مودع ، وإياك وما يعتذر منه ، وأجمع اليأس مما في أيدي الناس ) . ( ك ) . )(@)(@@)(@@)(@@) $ 9538 عن البراء قال :(@)(@@) | 30 ( لقيت خالي ومعه الراية وفي لفظ : راية للنبي فقلت : أين تذهب ؟ فقال : أرسلني النبي إلاى رجل تزوج امرأة أبيه أن أقتله أو أضرب عنقه ) . ( ش ، وابن النجار ) . )(@)(@@) PageV17P152(@)(@@)(@@)(@@) $ 9539 عن أبي أيوب ، عن رسول الله :(@)(@@) | 30 ( كان يستاك في الليلة مرارا ) . ( ش ) . )(@)(@@)(@@)(@@) $ 9540 عن يحي ى بن سعيد الأنصاري قال :(@)(@@) | 30 ( قال أبو أيوب الأنصاري رضي الله عنه : من أراد أن يكثر علمه ، وأن يعظم حلمه ، فليجالس غير عشيرته ) . ( ابن عساكر ) . )(@)(@@)(@@)(@@) $ 9541 عن أبي بن كعب عن أبي أيوب رضي الله عنه قال :(@)(@@) | 30 ( سأل النبي فقال : أحدنا يأتي المرأة ثم يكسل ، فقال النبي : ( الماء من الماء ) . ( عب ) . )(@)(@@)(@@)(@@) $ 9542 عن عاصم قال لام أيوب مرة :(@)(@@) | 30 ( فلما انصرف فقال : ما زال الشيطان بي آنفا رأيت أن لي فضلا علاى من خلفي ألا أؤم أبدا ) . ( كر ) . )(@)(@@)(@@)(@@) |||| ( مسند 28 أبي برزة رضي الله عنه )(@)(@@)(@@)(@@) $ 9543 
ms5792	 عن أبي برزة الأسلمي رضي الله عنه قال :(@)(@@) | 30 ( أغلظ رجل لأبي بكر الصديق رضي الله عنه ، فقال أبو برزة : ألا أضرب عنقه ؟ فانتهره ، فقال : ما هي لأحد بعد رسول الله ) . ( ط ، حم ، والحميدي ، د ، ت ، ع ، ك ، قط في الأفراد ، ص ، ق ) . )(@)(@@)(@@)(@@) $ 9544 عن أبي برزة الأسلمي رضي الله عنه :(@)(@@) | 30 ( أنه قال لزياد : وكان يقال : شر الرعاء الحطمة ، فإياك أن تكون منهم ) . ( كر ) . )(@)(@@) PageV17P153(@)(@@)(@@)(@@) $ 9545 عن أبي برزة رضي الله عنه قال :(@)(@@) | 30 ( كان رسول الله يصلي العشاء الآخرة إذا غاب الشفق إلاى ثلث الليل ، أو إلاى نصف الليل ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 9546 عن أبي برزة رضي الله عنه قال :(@)(@@) | 30 ( من السنة الأذان في المنارة ، والاقامة في المسجد ) . ( أبو الشيخ في الأذان ) . )(@)(@@)(@@)(@@) $ 9547 عن أبي برزة رضي الله عنه قال :(@)(@@) | 30 ( كان رسول الله يقول إذا أراد أن يقوم من المجلس : ( سبحانك وبحمدك أشهد أن لا إلاه إلا أنت ، أستغفرك وأتوب إليك ) . ( ش ) . )(@)(@@)(@@)(@@) $ 9548 عن أبي برزة رضي الله عنه قال :(@)(@@) | 30 أتي رسول الله بدنانير ، فجعل يقسمها وعنده رجل أسود ، مطموم الشعر ، عليه ثوبان أبيضان ، بين عينيه أثر السجود ، وكان يتعرض لرسول الله فلم يعطه ، فأتاه فعرض له من قبل وجهه فلم يعطه شيئا ، وأتاه من قبل يمينه فلم يعطه شيئا ، ثم أتاه من قبل شماله فلم يعطه شيئا ، ثم أتاه من خلفه فلم يعطه شيئا ، فقال : يا محمد ما عدلت منذ اليوم في القسمة ، فغضب رسول الله غضبا شديدا ، ثم قال : ( والله لا تجدون أحدا أعدل عليكم مني ) ثلاث مرات ، ثم قال : ( يخرج عليكم رجال من قبل المشرق كان هاذا منهم ، هديهم هاكذا ، يقرءون القرآن لا يجاوز تراقيهم ، يمرقون من الدين كما يمرق السهم من الرمية ، ثم لا يعودوا إليه ) ووضع يده علاى صدره ( سيماهم التحليق ، لا يزالون يخرجون ، حتى يخرج آخرهم مع المسيح الدجال ، فإذا رأيتموهم فاقتلوهم ثلاثا هم شر الخلق والخليقة ) يقولها ثلاثا ) . ( حم ، ن ، وابن جرير ، ش ، طب ، ك ) . )(@)(@@) PageV17P154(@)(@@)(@@)(@@) $ 9549 عن أبي برزة رضي 
ms5793	 الله عنه قال :(@)(@@) | 30 ( أتيت رسول الله فقلت : علمني شيئا لعل الله تعالاى أن ينفعني به ، قال : أنظر ما يؤذي الناس فنحه عن الطريق ) . ( ابن النجار ) . )(@)(@@)(@@)(@@) |||| ( 29 أبو بشر اليشكري ، جعفر بن إياس بن(@)(@@) أبي وحشية رضي الله عنه ) 3 $(@)(@@)(@@)(@@) $ 9550 عن أبي بشر جعفر بن أبي وحشية رضي الله عنه :(@)(@@) | 30 ( أن رجلا من خولان أسلم ، فأراده قومه علاى الكفر فألقوه في النار فلم يحترق إلا أمكنة لم يكن فيما مضى يصيبها الوضوء ، فقدم علاى أبي بكر رضي الله عنه فقال له : استغفر لي ، قال : أنت أحق قال أبو بكر : إنك ألقيت في النار فلم تحترق ، فاستغفر له ثم خرج إلاى الشام فكانوا يشبهونه بإبراهيم ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9551 عن شرحبيل بن مسلم الخولاني عن أبي بشر جعفر بن أبي وحشية رضي الله عنه :(@)(@@) | 30 ( أن الأسود بن قيس بن ذي الخمار تنبأ باليمن فبعث إلاى أبي مسلم الخولاني فأتاه ، فقال : أتشهد أني رسول الله ؟ قال : ما أسمع ، قال : أتشهد أن محمدا رسول الله ؟ قال : نعم ، فأمر بنار عظيمة ثم ألقاى أبا مسلم فيها ، فلم تضره ، فقيل للأسود بن قيس : إن لم تنف هاذا عنك أفسد عليك من اتبعك ، فأمره بالرحيل ، فقدم المدينة وقد قبض رسول الله واستخلف أبو بكر رضي الله عنه فأناخ راحلته بباب المسجد ودخل يصلي إلاى سارية ، فبصر به عمر بن الخطاب رضي الله عنه فقام إليه فقال : ممن الرجل ؟ فقال : من أهل اليمن ، فقال : ما فعل الذي حرقه الكذاب ؟ قال : ذاك عبد الله بن ثوب ، قال : فنشدتك بالله أنت هو ؟ قال : اللهم نعم ، فاعتنقه عمر وبكاى ، ثم ذهب به وأجلسه فيما بينه وبين أبي بكر الصديق ، فقال : الحمد لله الذي لم يمتني حتى أراني فهي أمة محمد من صنع PageV17P155 به كما صنع بإبراهيم خليل الرحمان فلم تضره النار ) . ( كر ) . )(@)(@@)(@@)(@@) |||| ( مسند 30 أبي بكرة رضي الله عنه )(@)(@@)(@@)(@@) $ 9552 عن أبي بكرة رضي الله عنه قال :(@)(@@) | 30 ( كان النبي يدعو في دبر الصلاة يقول : اللهم إني أعوذبك من 
ms5794	 الكفر والفقر وعذاب القبر ) . ( ش ) . )(@)(@@)(@@)(@@) $ 9553 عن أوس بن أبي أوفاى بن منده في تاريخ أصبهان :(@)(@@) | 30 أخبرني محمد بن محمد بن سهل : حدثنا إبراهيم بن عبد الله بن حاتم : سمعت أبي يقول : سمعت المأمون يخطب ، فكان في خطبته أن قال : يا أيها الناس إني آمركم في الحياء ، وأحضكم عليه ، فإن هشيم بن بشير حدثني عن يونس عن الحسن عن أبي بكرة : أن النبي سمع رجلا يعظ أخاه في الحياء ، فقال : ( دعه فإن الحياء من الايمان ، فقام إليه رجل فقال : يا أمير المؤمنين حدثنا هشيم كما حدثك عن يونس عن الحسن عن عمران بن حصين ، عن النبي ، فقال له المأمون : حدثني والله هشيم عن يونس وحبيب ومنصور عن الحسن عن عمران بن حصين وأبي بكرة وسمرة بن جندب ، ومن هو خير من طلاع الأرض منهم ، علي بن أبي طالب رضي الله عنه أن النبي سمع رجلا يعظ أخاه في الحياء ) . )(@)(@@)(@@)(@@) $ 9554 عن أبي بكرة رضي الله عنه عن النبي أنه قال :(@)(@@) | 30 ( أي شهر هاذا ؟ قلنا : الله ورسوله أعلم ، فسكت حتى ظننا أنه سيسميه بغير اسمه ، قال : أليس ذا الحجة ؟ قلنا : بلاى ، قال : فأي بلد هاذا ؟ قلنا : الله ورسوله أعلم ، فسكت حتى ظننا أنه سيسميه بغير اسمه ، قال : أليس هاذا البلد الحرام ؟ قلنا : بلاى ، قال : أي يوم هاذا ؟ قلنا : الله ورسوله أعلم ، فسكت ، حتى ظننا أنه سيسميه بغير اسمه ، قال : PageV17P156 أليس يوم النحر ، قلنا : بلاى يا رسول الله ، قال : فإن دماءكم وأموالكم وأعراضكم عليكم حرام ، كحرمة يومكم هاذا ، في بلدكم هاذا ، في شهركم هاذا ، ستلقون ربكم فيسألكم عن أعمالكم ) . ( ش ) . )(@)(@@)(@@)(@@) $ 9555 عن أبي بكرة رضي الله عنه قال :(@)(@@) | 30 ( قدمنا علاى عمر رضي الله عنه فشهد أبو بكرة ونافع وشبل بن معبد ، فلما دعا زيادا قال : رأيت أمرا منكرا ، فكبر عمر ودعا بأبي بكرة وصاحبيه ، فضربهم ، فقال أبو بكرة بعد ما حدوه : والله إني لصادق ، وهو فعل ما شهدته ، فهم عمر بضربه ، فقال علي رضي الله عنه : إن جلدت هاذا 
ms5795	 ، فارجم ذاك ) . ( هق ) . )(@)(@@)(@@)(@@) $ 9556 عن أبي بكرة رضي الله عنه :(@)(@@) | 30 ( أن رسول الله أخر صلاة العشاء تسع ليال إلاى ثلث الليل ، فقال له أبو بكر رضي الله عنه : يا رسول الله لو عجلتها لكان أطول لقيامنا من الليل فعجلها ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 9557 عن أبي بكرة رضي الله عنه : $ 30 ( أن النبي كبر في صلاة الفجر ثم أومأ إليهم ، ثم انطلق فاغتسل ، فجاء ورأسه يقطر فصلى بهم ) . ( كر ) .(@)(@@)(@@)(@@) $ 9558 عن عبد الرحمان بن أبي بكرة عن أبيه :(@)(@@) | 30 ( أنه رأى ناسا يصلون الضحاى فقال : إن هاذه الصلاة ما صلاها رسول الله ولا عامة أصحابه ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 9559 عن أبي بكرة رضي الله عنه :(@)(@@) | 30 ( أن النبي جعل للمسافر يمسح ثلاثة أيام ولياليهن ، وللمقيم يوما وليلة ) . ( ش ) . )(@)(@@)(@@)(@@) $ 9560 عن أبي بكرة رضي الله عنه :(@)(@@) | 30 ( أن النبي قال : ( إن في أمتي قوما يقرءون القرآن لا يجاوز تراقيهم ، فإذا خرجوا فأيتموهم ، فإذا خرجوا فأيتموهم ، فإذا خرجوا فأيتموهم ) بهاذه يقول : اقتلوهم ) . ( ابن جرير ) . )(@)(@@) PageV17P157(@)(@@)(@@)(@@) $ 9561 عن أبي بكرة رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : ( سيخرج قوم من أمتي ، أشداء أحداء ذلقة ألسنتهم بالقرآن ، لا يجاوز تراقيهم ، فإذا لقيتموهم فأيتموهم ثم أيتموهم فإنه يؤجر قاتلهم ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 9562 عن أبي بكرة رضي الله عنه قال :(@)(@@) | 30 ( أتي النبي بمويل فقعد النبي يقسمه ، فكان يأخذ منه بيده ثم يلتفت عن يمينه كأنه يخاطب رجلا ساعة ثم يعطيه من عنده ، وكانوا يرون أن الذي يخاطبه جبريل ، فأتاه رجل وهو علاى تلك الحال أسود طويل مشمر محلوق الرأس بين عينيه أثر السجود فقال : يا محمد والله ما تعدل فغضب النبي حتى احمرت وجنتاه فقال : ( ويحك فمن يعدل إذا لم أعدل ) ؟ فقال أصحابه : ألا نضرب عنقه ؟ فقال : ( لا أريد أن يسمع المشركون أني أقتل أصحابي ، إنه يخرج هاذا في أمثاله وفي أشباهه وفي ضرباته ، يأتيهم الشيطان من قبل دينهم ، يمرقون من الدين كما يمرق السهم من الرمية ، لا يراى في قطبه ولا ريشه ولا عوده ما في 
ms5796	 كلام له إلا أحفظه ) وفي لفظ : إن هاذا وأصحابه يمرقون من الدين كما يمرق السهم من الرمية لا يتعلقون من الاسلام بشيء ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 9563 عن أبي بكرة رضي الله عنه :(@)(@@) | 30 ( أن جبريل ختن النبي حين طهر قلبه ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9564 عن عبد الرحمان بن أبي بكرة قال :(@)(@@) | 30 ( وقدنا إلاى معاوية ومعنا أبو بكرة رضي الله عنهما فقال : يا أبا بكرة حدثنا بشيء سمعته من رسول الله ، فقال أبو بكرة : كان رسول الله تعجبه الرؤيا الحسنة ويسأل عنه ، وإنه قال ذات يوم : أيكم رأى رؤيا ؟ فقال رجل من القوم : أنا رأيت ميزانا دلي من السماء ، فوزنت أنت وأبو بكر فرجحت بأبي بكر ، ووزن فيه أبو بكر وعمر رضي الله عنهما فرجح أبو بكر PageV17P158 بعمر ، ووزن فيه عمر وعثمان رضي الله عنه فرجح عمر بعثمان ، ثم رفع الميزان ، فاستأولها نبي الله أي : أولها ، فقال : خلافة نبوة ، ويؤتي الله الملك من يشاء ، وقال رسول الله : ( من قتل نفسا معاهدة بغير حقها لم يجد ريح الجنة ، وإن ريحها ليوجد من مسيرة خمسمائة سنة ) ، وقال رسول الله : ( ليردن علي الحوض رجال ممن صحبني ورآني وإذا رفعوا إلي ورأيتهم اختلجوا دوني ، فأقول : يا رب أصحابي ) وفي لفظ : ( أصحابي ) فيقال : إنك لا تدري ما أحدثوا بعدك ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9565 عن الحسن عن أبي بكرة رضي الله عنه قال :(@)(@@) | 30 ( كان رسول الله إذا أصبح قال : ( من رأى منكم رؤيا ) ؟ فقال رجل : أنا رأيت كأن ميزانا نزل من السماء ، فوزنت أنت وأبو بكر فرجحت أنت بأبي بكر ، ووزن عمر وأبو بكر رضي الله عنه فرجح أبو بكر بعمر ، ووزن عمر وعثمان رضي الله عنهما فرجح عمر ، ثم رفع الميزان ؛ فرأيت الكراهية في وجه رسول الله ) . ( ت ، ع ، والروياني ( كر ) . )(@)(@@)(@@)(@@) $ 9566 عن أبي بكرة رضي الله عنه قال :(@)(@@) | 30 ( جاء رجل إلاى رسول الله فقال له : إلاى من أوءدي صدقة مالي ؟ قال : ( إلي ) ، قال : فإن لم أجدك ؟ قال : ( إلى أبي بكر ) ، قال : فإن لم أجده ؟ قال : ( إلاى عمر 
ms5797	 ) ، قال : فإن لم أجده ؟ قال : ( إلاى عثمان ) ؛ ثم ولى منصرفا ، فقال النبي : ( هاؤلاء الخلفاء من بعدي ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9567 عن أبي بكرة رضي الله عنه قال :(@)(@@) | 30 ( كان الحسن والحسين رضي الله عنهما يثبان علاى ظهر رسول الله فيمسكهما بيده حتى يرفع صلبه ويقومان علاى الأرض ، فلما فرغ أجلسهما في حجره ثم قال : ( إن ابني هاذين ريحانتي من الدنيا ) . ( عد ، كر ) . )(@)(@@)(@@)(@@) $ 9568 عن أبي بكرة رضي الله عنه قال :(@)(@@) | 30 ( كان رسول الله يصلي بالناس ، فإذا سجد وثب الحسن علاى ظهره أو علاى عنقه ، فرفع رأسه فيضعه وضعا PageV17P159 رفيقا لئلا يصرع ، ففعل ذالك غير مرة ، فلما قضاى صلاته ضمه إليه وجعل يقبله ، فقالوا : يا رسول الله إنك لتفعل بهاذا شيئا ما رأيناك تفعله بأحد فقال : ( إن ابني هاذا ريحانتي من الدنيا ، وإن ابني هاذا سيد ، وسيصلح الله به بين فئتين من المسلمين ) . ( حم ، والروياني ، كر ) . )(@)(@@)(@@)(@@) $ 9569 عن عبد الرحمان بن أبي بكرة عن أبيه :(@)(@@) | 30 ( أن الأقرع بن حابس جاء إلاى النبي فقال : إنما بايعك سراق الحجيج من أسلم وغفار ومزينة وجهينة ، فقال رسول الله : ( أرأيت إن كان أسلم وغفار وجهينة خيرا من بني تميم ومن بني عامر وأسد وغطفان أخابوا وخسروا ) ؟ قال : نعم ، قال : ( فوالذي نفسي بيده إنهم لأخير منهم ) . ( ش ) . )(@)(@@)(@@)(@@) $ 9570 عن أبي بكرة رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : ( أرأيتم إن كان جهينة وأسلم وغفار خيرا من بني تميم ومن بني أسد ومن بني عبد الله بن غطفان ومن بني عامر بن صعصعة ) ومد بها صوته قالوا : يا رسول الله وقد خابوا وخسروا ، قال : ( فإنهم خير من بني تميم ومن بني أسد ، ومن بني عبد الله بن غطفان ، ومن بني عامر بن صعصعة ) . ( ش ، حم ، خ ، م ) . )(@)(@@)(@@)(@@) $ 9571 عن أبي بكرة رضي الله عنه قال :(@)(@@) | 30 ( ذكر رسول الله أرضا يقال لها : البصرة أو البصيرة ، إلاى جنبها نهر يقال لها دجلة ذو نخل كثير ، ينزل به قنطوراء ، فيفرق الناس ثلاث فرق : فرقة تلحق بأصلها وهلكوا ، وفرقة 
ms5798	 تأخذ علاى أنفسها وكفروا ، وفرقة يجعلون ذراريهم خلف ظهورهم فيقاتلون ، قتلاهم شهداء ، يفتح الله علاى بقيتهم ) . ( ش ، وسنده حسن ) . )(@)(@@) PageV17P160(@)(@@)(@@)(@@) |||| ( مسند 31 أبي ثعلبة الخشني رضي الله عنه )(@)(@@)(@@)(@@) $ 9572 عن أبي ثعلبة الخشني رضي الله عنه قال :(@)(@@) | 30 ( قدم رسول الله في غزاة له ، فدخل المسجد فصلى فيه ركعتين ، وكان يعجبه إذا قدم من سفر أن يدخل المسجد فيصلي فيه ركعتين ويثني بفاطمة ، ثم يأتي أزواجه ، فقدم من سفره مرة فأتاى فاطمة رضي الله عنه فبدأ بها قبل بيوت أزواجه ، فاستقبلته علاى باب البيت فاطمة ، فجعلت تقبل وجهه وفي لفظ : فاه وعينيه وتبكي ، فقال لها رسول الله : ( ما يبكيك ) ؟ قالت : أراك يا رسول الله قد شحب لونك ، واخلولقت ثيابك ، فقال لها رسول الله : ( يا فاطمة لا تبكي ، فإن الله بعث أباك علاى أمر لا يبقاى علاى ظهر الأرض بيت مدر ولا وبر ولا شعر إلا أدخل الله تعالاى به عزا أو ذلا حتتى يبلغ حيث يبلغ الليل ) . ( طب ، حل ، كر ) . )(@)(@@)(@@)(@@) $ 9573 عن أبي ثعلبة الخشني رضي الله عنه قال :(@)(@@) | 30 ( نهاى رسول الله عن قتل النساء والولدان ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9574 عن أبي ثعلبة الخشني رضي الله عنه قال :(@)(@@) | 30 ( كان الناس إذا نزلوا مع النبي تفرقوا في الشعاب والأودية ، فقال النبي : ( إن تفرقكم في هاذه الشعاب والأودية ، إنما ذالكم من الشيطان ) ، فلم ينزلوا بعد ذالك منزلا إلا انضم بعضهم إلاى بعض ، حتى لو بسط عليهم ثوب لوسعهم ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9575 عن أبي ثعلبة الخشني رضي الله عنه قال :(@)(@@) | 30 ( بينا رسول الله يصلي إذ سمع رجلا يدعو الله : الحمد لله حمدا كثيرا طيبا مباركا فيه كما ينبغي لكرم وجه ربنا عز وجل ، فلما انصرف رسول الله قال : أيكم القائل كذا وكذا ؟ لقد رأيت اثني عشر ملكا يبتدرونها ، ثم شخص رسول الله ببصره حتى توارت بالحجاب ، PageV17P161 قال : هي لك بخاتمتها يوم القيامة ومثلها ) . ( طس ، ش ) . )(@)(@@)(@@)(@@) $ 9576 عن أبي ثعلبة رضي الله عنه قال :(@)(@@) | 30 ( بينا النبي يصلي بأصحابه بطريق مكة ، مر رجل يطرد شولا 
ms5799	 له ، فأشار إليه النبي فلم يفطن ، فصرخ به عمر رضي الله عنه فقال : يا صاحب الشول رد إبلك ، فردها ، فلما صلى النبي قال : من المتكلم ؟ قالوا : عمر ، قال : مالك فقها يا ابن الخطاب ) . ( عبد الرزاق بن عبد الرحمن بن يزيد بن أسلم عن أبيه مرسلا ) . )(@)(@@)(@@)(@@) $ 9577 عن أبي ثعلبة رضي الله عنه قال :(@)(@@) | 30 ( قلت يا رسول الله إنا نغزو أرض العدو فنحتاج إلاى آنيتهم ، فقال : استغنوا عنها ما استطعتم ، فإن لم تجدوا غيرها فاغسلوها وكلوا منها واشربوا ) . ( ش ) . )(@)(@@)(@@)(@@) $ 9578 عن أبي ثعلبة رضي الله عنه قال :(@)(@@) | 30 ( لقيت رسول الله فقلت : يا رسول الله ادفعني إلاى رجل حسن التعليم ، فدفعني إلاى أبي عبيدة بن الجراح رضي الله عنه ثم قال : دفعتك إلاى رجل يحسن تعليمك وأدبك ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9579 عن أبي ثعلبة رضي الله عنه قال :(@)(@@) | 30 ( والله لا تعجز هاذه الأمة من نصف يوم ، إذا رأيت الشام قائده رجل وأهل بيته فعند ذالك فتح القسطنطينية ) . ( ق في البعث ) . )(@)(@@)(@@)(@@) $ 9580 عن أبي ثعلبة الخشني رضي الله عنه قال :(@)(@@) | 30 ( إن من أشراط الساعة : أن تنتقص العقول ، وتقرب الأحلام ، ويكثر الهم ) . ( نعيم بن حماد في الفتن ) . )(@)(@@)(@@)(@@) $ 9581 عن أبي ثعلبة الخشني رضي الله عنه قال :(@)(@@) | 30 ( إن من أشراط الساعة PageV17P162 2 أبشروا بدنيا عريضة تأكل إيمانكم فمن كان منكم يومئذ علاى يقين منح ربه أتته فتنة بيضاء مسفرة ، ومن كان منكم علاى شك من ربه أتته فتنة سوداء مظلمة ، ثم لم يبال الله في أي الأودية سلك ) . ( نعيم ) . )(@)(@@)(@@)(@@) $ 9582 عن أبي ثعلبة رضي الله عنه قال :(@)(@@) | 30 ( لقيت رسول الله فقلت : يا رسول الله ادفعني إلاى رجل حسن التعليم فدفعني إلاى أبي عبيدة بن الجراح رضي الله عنه ثم قال : ( قد دفعتك إلاى رجل يحسن تعليمك وأدبك ) فأتيت أبا عبيدة وهو وبشر بن سعد أبو النعمان بن بشير يتحدثان ، فلما رأياني سكتا ، فقلت : يا أبا عبد الله والله ما هاكذا أوصاك رسول الله . فقال : إنك جئت ونحن نتحدث حديثا سمعناه من 
ms5800	 رسول الله ، فاجلس حتى نحدثك فقال : قال رسول الله : ( إن فيكم النبوة ، ثم تكون خلافة علاى منهاج النبوة ، ثم يكون ملكا وجبرية ) . ( أبو نعيم في المعرفة ) . )(@)(@@)(@@)(@@) $ 9583 عن أبي ثعلبة الخشني رضي الله عنه قال :(@)(@@) | 30 ( قلت : يا رسول الله أخبرني ما يحل لي وما يحرم علي ، قال : فصعد في البصر وصوبه وقال : لا تأكل لحم الحمار الأهلي ولا ذا ناب من السباع ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9584 عن أبي ثعلبة الخشني عن أبي ثور الفهمي قال :(@)(@@) | 30 ( كنا عند رسول الله فأتي بثوب من ثياب المعافر ، فقال رسول الله : لعن الله هاذا ، ولعن من وجهه ) . ( الديلمي ) . )(@)(@@)(@@)(@@) $ 9585 عن أبي ثعلبة الخشني رضي الله عنه :(@)(@@) | 30 ( من أشراط الساعة أن تنقض العقول ، وتقرب الأحلام ، ويكثر الهم ) . ( نعيم بن حماد في الفتن ) . )(@)(@@) PageV17P163(@)(@@)(@@)(@@) |||| ( مسند أبي جحيفة رضي الله عنه )(@)(@@)(@@)(@@) $ ( 9586 ) عن أبي جحيفة رضي الله عنه : ' أن رسول الله & : آخي بين سلمان وبين أبي الدرداء رضي الله عنهما ، فجاء سلمان يزوز أبا الدرداء ، فرأى أم الدرداء متبذلة ، قال : ما شأنك ؟ قالت : إن أخاك ليس له حاجة في الدنيا ، فلما جاء أبو الدرداء رحب به ، وقرب إليه طعاما ، فقال له سلمان : إطعم ، فقال : إني صائم ، قال : أقسمت عليك إلا ما طعمت ، ما أنا بآكل حتى تأكل ، فأكل معه ، وبات عنده ، فلما كان من الليل ، قام أبو الدرداء فحبسه سلمان ، ثم قال : يا أبا الدرداء ! إن لربك عليك حقا ، ولأهلك عليك حقا ، ولجسدك عليك حقا ، فأعط كل ذي حق حقه صم وأفطر ، وقم ونم ، وائت أهلك ، فلما كان عند الصبح قال : قم الآن ، فقاماوصليا ، ثم خرجا إلى الصلاة ، فلما صلى النبي & ، قام إليه أبو الدرداء فأخبره بما قال له سلمان ، فقال له رسول الله & مثل ما قال سلمان له وفي لفظ : فقال له رسول الله & : يا أبا الدرداء ! إن لجسدك عليك حقا ، مثل ما قال لك سلمان ' , ( ع ، خ ) .(@)(@@)(@@)(@@) $ 9587 عن أبي جحيفة رضي الله عنه قال :(@)(@@) | 30 ( أكلت ثريدا ولحما وسمنا ثم أتيت النبي أتجشأ ، فقال 