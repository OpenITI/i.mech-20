ms321	 و نه صدیق و نه حمیم(@)(@@) 28 خویشتن را ز توانائی خود بهره بده %~% گر بدانی که پذیرنده حکیم است و علیم(@)(@@) 29 به سخاوت سمری از بس که وقف رباط %~% به فسوسی بدهی غله گرمابه و تیم(@)(@@) 30 وگر از بهر ضعیفی دو درم باید داد %~% ندهی تا نشود حاضر مفتی و زعیم(@)(@@) 31 جز بدان وقت که بستانی ازو مال به غصب %~% نتوانی که ببینی به مثل روی یتیم(@)(@@) 32 گر به صورت بشری پیشه مکن سیرت گرگ %~% نام محمود نه خوب آید با فعل ذمیم(@)(@@) 33 دیو دنیای جفا پیشه تو را سخره گرفت %~% چو بهایم چه دوی از پس این دیو بهیم(@)(@@) 34 حرم آل رسول است تو را جای که هیچ %~% دیو را راه نبوده‌است در این شهره حریم(@)(@@) 35 سخن حجت بر وجه ملامت مشنو %~% تا نمانی به قیامت خزی و خوار و ملیم PageV1P169(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 از دهر جفا پیشه زی که نالم %~% گویم ز که کرده‌است نال نالم(@)(@@) 2 با شست و دو سالم خصومت افتاد %~% از شست و دو گشته است زار حالم(@)(@@) 3 مالی نشناسم ز عمر برتر %~% شاید که بنالم ز بهر مالم(@)(@@) 4 یک چند جمالم فزون همی شد %~% گفتی که یکی نو شده هلالم(@)(@@) 5 در خواب ندیدی مگر خیالم %~% آن سرو سهی قد مشک خالم(@)(@@) 6 چون دید زمانه که غره گشتم %~% بشکست به دست جفا نهالم(@)(@@) 7 بربود شب و روز رنگ و بویم %~% برکند مه و سال پر و بالم(@)(@@) 8 زین دیو دژاگه چو گشتم آگه %~% زین پس نکند صید به احتیالم(@)(@@) 9 گاه از در میر جلیل گوید %~% «بنگر به فر و نعمت و جلالم(@)(@@) 10 گر سوی من آئی عزیز گردی %~% پیوسته بود با تو قیل و قالم»(@)(@@) 11 گه یاد دهد آن زمان که بودی %~% پیشم شده جمله تبار و آلم(@)(@@) 12 آنها که نبودی مگر بدیشان %~% مسعود مرا بخت 
ms322	 و نیک فالم(@)(@@) 13 گوید « به چه معنی حرام کردی %~% برجان و تن خویشتن حلالم(@)(@@) 14 چه‌ت بود نگشتی هنوز پیری %~% که‌ت رخت نمانده‌است در جوالم»(@)(@@) 15 ای دهر جز از من بجوی صیدی %~% نه مرد چنین مکر و افتعالم(@)(@@) 16 من نیستم آن گل کز آب زرقت %~% تازه شودم شاخ و بال و یالم(@)(@@) 17 حق است و حقیقت به پیش رویم %~% زانی تو فگنده پس قذالم(@)(@@) 18 چون طمع بریدم ز مال شاهان %~% پس مدحت شاهان چرا سگالم(@)(@@) 19 من جز که به مدح رسول و آلش %~% از گفتن اشعار گنگ و لالم(@)(@@) 20 گر میل کند سوی هزل گوشم %~% به انگشت خرد گوش خود بمالم(@)(@@) 21 جز راست نگویم میان خصمان %~% با باد نگردم که من نه نالم(@)(@@) 22 هنگام عدالت به خار خارد %~% مر دیده بدخواه را خیالم(@)(@@) 23 چون من ز حقایق سخن گشایم %~% سقراط و فلاطون سزد عیالم(@)(@@) 24 ای فخرکننده بدانکه گوئی %~% «بر درگه سلطان من از رجالم(@)(@@) 25 امروز تگینم بخواند و فردا %~% داده است نوید عطا ینالم»(@)(@@) 26 زان که‌ش تو خداوند می‌پسندی %~% ننگ است مرا گر بود همالم(@)(@@) 27 وان چیز که او را همی بجوئی %~% حقا که گرفته‌است ازو ملالم(@)(@@) 28 بحر است مرا در ضمیر روشن %~% در شعر همی در ازان فتالم(@)(@@) 29 بر دشت فصاحت مطیر میغم %~% در باغ بلاغت بزان شمالم(@)(@@) 30 وانجا که بیاید تموز جاهل %~% من خفته و آسوده در ظلالم(@)(@@) 31 رفتم پس دنیا بسی ولیکن %~% افلاک بران داد گوشمالم(@)(@@) 32 گر نیز غرور جهان بخرم %~% پس همچو تو گم بوده در ضلالم(@)(@@) 33 ایزد مکنادم دعا اجابت %~% گر جز که زفضلش بود سؤالم(@)(@@) 34 صد شکر خداوند را که آزم %~% کم شد چو فزون شد شمار سالم(@)(@@) 35 در حب رسول خدا و آلش %~% معروف چو خورشید بر زوالم(@)(@@) 36 وز مدحت ایشان نگر که ایدون %~% گشته است مطرز پر مقالم(@)(@@) 37 
ms323	 مامور خداوند قصر و عصرم %~% محمود بدو شد چنین خصالم(@)(@@) 38 مستنصریم ور ازین بگردم %~% چون دشمن بی‌دینش بد فعالم(@)(@@) 39 زو گشت به حاصل کمال عالم %~% من بنده آن عالم کمالم(@)(@@) 40 بی‌او قدحی آب‌شور بودم %~% و امروز بدو چشمه زلالم(@)(@@) 41 قولم همه هزل و محال بودی %~% هزلم همه حکمت شد و محالم(@)(@@) 42 بی‌مغز سفالیم دیده بودی %~% امروز همه مغز بی‌سفالم(@)(@@) 43 من گوهر دین رسول حقم %~% منکوهم اگر مانده در حبالم(@)(@@) 44 تاجم سر پر مغز را ولیکن %~% مر پای تهی مغز را عقالم PageV1P170(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 شاید که حال و کار دگر سان کنم %~% هرچ آن به است قصد سوی آن کنم(@)(@@) 2 عالم به ماه نیسان خرم شده است %~% من خاطر از تفکر نیسان کنم(@)(@@) 3 در باغ و راغ دفتر دیوان خویش %~% از نثر و نظم سنبل و ریحان کنم(@)(@@) 4 میوه و گل از معانی سازم همه %~% وز لفظ‌های خوب درختان کنم(@)(@@) 5 چون ابر روی صحرا بستان کند %~% من نیز روی دفتر بستان کنم(@)(@@) 6 در مجلس مناظره بر عاقلان %~% از نکته‌های خوب گل‌افشان کنم(@)(@@) 7 گر بر گلیش گرد خطا بگذرد %~% آنجا ز شرح روشن باران کنم(@)(@@) 8 قصری کنم قصیده خود را درو %~% از بیتهاش گلشن و ایوان کنم(@)(@@) 9 جائی درو چو منظره عالی کنم %~% جائی فراخ و پهن چو میدان کنم(@)(@@) 10 بر درگهش ز نادره بحر عروض %~% یکی امین دانا دربان کنم(@)(@@) 11 مفعول فاعلات مفاعیل فع %~% بنیاد این مبارک بنیان کنم(@)(@@) 12 وانگه مر اهل فضل اقالیم را %~% در قصر خویش یکسره مهمان کنم(@)(@@) 13 تا اندرو نیاید نادان که من %~% خانه همی نه از در نادان کنم(@)(@@) 14 خوانی نهم که مرد خردمند را %~% از خوردنیش عاجز و حیران کنم(@)(@@) 15 اندر تن سخن به مثال خرد %~% معنی خوب و نادره را جان کنم(@)(@@) 16 گر تو ندیده‌ای ز سخن مردمی %~% من بر سخنت 
ms324	 صورت انسان کنم(@)(@@) 17 او را ز وصف خوب و حکایات خوش %~% زلف خمیده و لب خندان کنم(@)(@@) 18 معنیش روی خوب کنم وانگهی %~% اندر نقاب لفظش پنهان کنم(@)(@@) 19 چون روی خویش زی سخن‌آرم به قهر %~% پشتش به پیش خویش چو چوگان کنم(@)(@@) 20 ور خاطرم به جائی کندی کند %~% او را به دست فکرت سوهان کنم(@)(@@) 21 جان را چو زنگ جهل پدید آورد %~% چون آینه ز خواندن فرقان کنم(@)(@@) 22 دشوار این زمانه بد فعل را %~% آسان به زهد و طاعت یزدان کنم(@)(@@) 23 دست از طمع بشویم پاک آنگهی %~% از خفته دست بر سر کیوان کنم(@)(@@) 24 گر در لباس جهل دلم خفته بود %~% اکنون از آن لباسش عریان کنم(@)(@@) 25 وین جسم بی‌فلاحت آسوده را %~% خیزم به تیغ طاعت قربان کنم(@)(@@) 26 ور عیب من ز خویشتن آمد همه %~% از خویشتن به پیش که افغان کنم(@)(@@) 27 خیزم به فصل و رحمت یزدان حق %~% دشوار دهر بر دلم آسان کنم(@)(@@) 28 اندر میان نیک و بد خویشتن %~% ماننده زبانه میزان کنم(@)(@@) 29 هر ساعتی به خیر درون پاره‌ای %~% بفزایم و ز شرش نقصان کنم(@)(@@) 30 تا غل و طوق و بند که بر من نهاد %~% در دست و پای و گردن شیطان کنم(@)(@@) 31 گر دیو از آنچه کرد پشیمان نشد %~% من نفس را ز کرده پشیمان کنم(@)(@@) 32 گر نیست طاقتم که تن خویش را %~% بر کاروان دیو سلیمان کنم(@)(@@) 33 آن دیو را که در تن و جان من است %~% باری به تیغ عقل مسلمان کنم(@)(@@) 34 از قول و فعل زین و لگامش نهم %~% افسار او ز حکمت لقمان کنم(@)(@@) 35 گر تو نشاط درگه جیلان کنی %~% من قصد سوی درگه رحمان کنم(@)(@@) 36 سوی دلیل حق بنهم روی خویش %~% تا خویشتن به سیرت سلمان کنم(@)(@@) 37 زی اهل بیت احمد مرسل شوم %~% تن را رهی و بنده ایشان کنم(@)(@@) 38 تا 
ms325	 نام خویش را به جلال امام %~% بر نامه معالی عنوان کنم(@)(@@) 39 زان آفتاب علم و دل خویش را %~% روشن به سان ماه به سرطان کنم(@)(@@) 40 وز برکت مبارک دریای او %~% دل را چو درج گوهر و مرجان کنم(@)(@@) 41 ای آنکه گوئیم به نصیحت همی %~% ک «این پیرهن بیفگن و فرمان کنم(@)(@@) 42 تا سخت زود من چو فلان مر تو را %~% در مجلس امیر خراسان کنم»(@)(@@) 43 اندر سرت بخار جهالت قوی است %~% من درد جهل را به چه درمان کنم(@)(@@) 44 کی ریزم آب‌روی چو تو بی‌خرد %~% بر طمع آنکه توبره پر نان کنم(@)(@@) 45 ترکان رهی و بنده من بوده‌اند %~% من تن چگونه بنده ترکان کنم(@)(@@) 46 ای بد نصیحت که تو کردی مرا %~% تا چون فلان خسیس و چو بهمان کنم(@)(@@) 47 گیتیت گربه‌ای است که بچه خورد %~% من گرد او ز بهر چه دوران کنم(@)(@@) 48 از من خسیس‌تر که بود در جهان %~% گر تن به نان چو گربه گروگان کنم(@)(@@) 49 دین و کمال و علم کجا افگنم %~% تا خویشتن چو غول بیابان کنم(@)(@@) 50 از فضل تا چو غول بمانم تهی %~% پس من چگونه خدمت دیوان کنم(@)(@@) 51 این فخر بس مرا که به هر دو زبان %~% حکمت همی مرتب و دیوان کنم(@)(@@) 52 جان را ز بهر مدحت آل رسول %~% گه رودکی و گاهی حسان کنم(@)(@@) 53 دفتر ز بس نگار و ز نقش سخن %~% برتر ز چین و روم و سپاهان کنم(@)(@@) 54 واندر کتاب بر سخن منطقی %~% چون آفتاب روشن برهان کنم(@)(@@) 55 بر مشکلات عقلی محسوس را %~% بگمارم و شبان و نگهبان کنم(@)(@@) 56 زادالمسافر است یکی گنج من %~% نثر آنچنان و نظم از این‌سان کنم(@)(@@) 57 زندانمؤمناست جهان من چنین %~% زیرا همی قرار به یمگان کنم(@)(@@) 58 تا روز حشر آتش سوزنده را %~% بر شیعت معاویه زندان کنم PageV1P171(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 عقل چه آورد ز گردون 
