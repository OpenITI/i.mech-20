ms101	 من ديني ويقين من أمري(@)(@)(@@)(@@)(@@) ||| 2(@)(@)(@@) @HAD010 إنى لعلى يقين من ربي وغير شبهة فى ديني(@)(@)(@@)(@@)(@@) ||| 3(@)(@)(@@) @HAD06 إنى محارب أملي ومنتظر أجلي(@)(@)(@@)(@@)(@@) ||| 4(@)(@)(@@) @HAD010 إنى مستوف رزقي ومجاهد نفسي ومنته إلى قسمي(@)(@)(@@)(@@)(@@) ||| 5(@)(@)(@@) @HAD09 إنى لعلى جادة الحق وانهم لعلى مزلة الباطل(@)(@)(@@)(@@)(@@) ||| 6(@)(@)(@@) @HAD013 إنى لعلى إقامة حجج الله أقاول وعلى نصرة دينه أجاهد وأقاتل(@)(@)(@@)(@@)(@@) ||| 7(@)(@)(@@) @HAD026 إنى لأرفع نفسي أن تكون حاجة لا يسعها جودي أو جهل لا يسعه حلمي أو ذنب لا يسعه عفوي أو أن يكون زمان أطول من زماني(@)(@)(@@)(@@)(@@) ||| 8(@)(@)(@@) @HAD014 إنى كنت إذا سئلت رسول الله صلوات الله وسلامه عليه أعطاني وإذا(@)(@)PageV01P263(@)(@)(@@) @HAD04 سكت عن مسئلته إبتدأني(@)(@)(@@)(@@)(@@) ||| 9(@)(@)(@@) @HAD025 إنى لأرفع نفسي عن أن أنهى الناس عما لست انتهي عنه أو آمرهم بما لا أسبقهم إليه بعملي أو أرضى منهم بما لا يرضى ربي(@)(@)(@@)(@@)(@@) ||| 10(@)(@)(@@) @HAD020 إنى لا أحثكم على طاعة إلا وأسبقكم إليها ولا أنها كم عن معصية إلا وأتناهى قبلكم عنها(@)(@)(@@)(@@)(@@) ||| 11(@)(@)(@@) @HAD014 إني طلقت الدنيا ثلاثا بتاتا لا رجعة لي فيها وألقيت حبلها على غاربها(@)(@)(@@)(@@)(@@) ||| 12(@)(@)(@@) @HAD015 إني أخاف عليكم كل عليم اللسان منافق الجنان يقول ما تعلمون ويفعل ما تنكرون(@)(@)(@@)(@@)(@@) ||| 13(@)(@)(@@) @HAD024 إني آمركم بحسن الإستعداد والإكثار من الزاد ليوم تقدمون فيه على ما تقدمون وتندمون على ما تخلفون وتجزون بما كنتم تسلفون(@)(@)(@@)(@@)(@@) ||| 14(@)(@)(@@) @HAD047 إني إذا استحكمت في الرجل خصلة من خصال الخير احتملته لها واغتفرت له فقد ما سواها ولا أغتفر له فقد عقل ولا عدم دين لأن مفارقة الدين مفارقة الأمن ولا تهنأ حياة مع مخافة وعدم العقل عدم الحيوة ولا تعاشر الأموات(@)(@)PageV01P264(@)(@)(@@)(@@)(@@) ||| (ألفصل الثالث عشر) مما ورد من حكم أمير المؤمنين على بن أبيطالب (عليه السلام) في حرف الألف بلفظ إنك فى خطاب المفرد قال (عليه السلام)(@)(@)(@@)(@@)(@@) ||| 1(@)(@)(@@) @HAD014 إنك في سبيل من كان قبلك فاجعل جدك لآخرتك ولا تكترث بعمل الدنيا(@)(@)(@@)(@@)(@@) ||| 2(@)(@)(@@) @HAD016 إنك لمن يتقبل من عملك إلا ما أخلصت فيه ولم تشبه بالهوى وأسباب الدنيا(@)(@)(@@)(@@)(@@) ||| 3(@)(@)(@@) @HAD015 إنك لن تبلغ أملك ولن بعد وأجلك فاتق الله وأجمل في الطلب(@)(@)(@@)(@@)(@@) ||| 4 
ms102	(@)(@)(@@) @HAD026 إنك مدرك قسمك ومضمون رزقك ومستوف ما كتب لك فأرح نفسك من شقاء الحرص ومذلة الطلب وثق بالله وخفض فى المكتسب(@)(@)(@@)(@@)(@@) ||| 5(@)(@)(@@) @HAD016 إنك لست بسابق أجلك ولا بمرزوق ما ليس لك فلما ذا تشقي نفسك يا شقي(@)(@)(@@)(@@)(@@) ||| 6(@)(@)(@@) @HAD016 إنك إن ملكت نفسك قيادك أفسدت معادك وأوردتك بلاء لا ينتهي وشقاء لا ينقضي(@)(@)(@@)(@@)(@@) ||| 7(@)(@)(@@) @HAD010 إنك طريد الموت الذي لا ينجو هاربه ولابد أنه(@)(@)PageV01P265(@)(@)(@@) @HAD01 مدركه(@)(@)(@@)(@@)(@@) ||| 8(@)(@)(@@) @HAD015 إنك إن اشتغلت بفضائل النوافل عن أداء الفرائض فلن يقوم فضل تكسبه بفرض تضيعه:(@)(@)(@@)(@@)(@@) ||| 9(@)(@)(@@) @HAD011 إنك لن تدرك ما تحب من ربك إلا بالصبر عما تشتهي(@)(@)(@@)(@@)(@@) ||| 10(@)(@)(@@) @HAD016 إنك لن تلج الجنة حتى تزدجر عن غيك وتنتهي وترتدع عن معاصيك وترعوي(@)(@)(@@)(@@)(@@) ||| 11(@)(@)(@@) @HAD08 إنك إن سالمت الله سبحانه سلمت وفزت(@)(@)(@@)(@@)(@@) ||| 12(@)(@)(@@) @HAD08 إنك إن حاربت الله سبحانه حربت وهلكت(@)(@)(@@)(@@)(@@) ||| 13(@)(@)(@@) @HAD06 إنك إن أقبلت على الدنيا أدبرت(@)(@)(@@)(@@)(@@) ||| 14(@)(@)(@@) @HAD06 إنك إن أدبرت عن الدنيا أقبلت(@)(@)(@@)(@@)(@@) ||| 15(@)(@)(@@) @HAD05 إنك إن تواضعت رفعك الله(@)(@)(@@)(@@)(@@) ||| 16(@)(@)(@@) @HAD05 إنك إن تكبرت وضعك الله(@)(@)(@@)(@@)(@@) ||| 17(@)(@)(@@) @HAD08 إنك إن أنصفت من نفسك أزلفك الله سبحانه(@)(@)(@@)(@@)(@@) ||| 18(@)(@)(@@) @HAD07 إنك إن إجتنت السيئات نلت رفيع الدرجات(@)(@)(@@)(@@)(@@) ||| 19(@)(@)(@@) @HAD07 إنك إن تورعت تنزهت عن دنس السيئات(@)(@)(@@)(@@)(@@) ||| 20(@)(@)(@@) @HAD09 إنك إن أطعت الله سبحانه نجاك وأصلح مثواك(@)(@)(@@)(@@)(@@) ||| 21(@)(@)(@@) @HAD012 إنك إن أطعت هواك أصمك وأعماك وأفسد منقلبك وأرداك(@)(@)PageV01P266(@)(@)(@@)(@@)(@@) ||| 22(@)(@)(@@) @HAD08 إنك إن أحسنت فنفسك تكرم وإليها تحسن(@)(@)(@@)(@@)(@@) ||| 23(@)(@)(@@) @HAD08 إنك إن أسأت فنفسك تمتهن وإياها تغبن(@)(@)(@@)(@@)(@@) ||| 24(@)(@)(@@) @HAD05 إنك مخلوق للآخرة فاعمل لها(@)(@)(@@)(@@)(@@) ||| 25(@)(@)(@@) @HAD09 إنك لن تخلق للدنيا فازهد فيها وأعرض عنها(@)(@)(@@)(@@)(@@) ||| 26(@)(@)(@@) @HAD05 إنك موزون بعقلك فزكه بالعلم(@)(@)(@@)(@@)(@@) ||| 27(@)(@)(@@) @HAD05 إنك مقوم بأدبك فزينه بالحلم(@)(@)(@@)(@@)(@@) ||| 28(@)(@)(@@) @HAD09 إنك من ورائك طالبا حثيثا من الموت فلا تغفل(@)(@)(@@)(@@)(@@) ||| 29(@)(@)(@@) @HAD014 إنك لن يغني عنك بعد الموت إلا صالح عمل قدمته فتزود من صالح العمل(@)(@)(@@)(@@)(@@) ||| 30(@)(@)(@@) @HAD06 إنك إن عملت للآخرة فاز قدحك(@)(@)(@@)(@@)(@@) ||| 31(@)(@)(@@) @HAD06 إنك إن عملت للدنيا خسرت صفقتك(@)(@)(@@)(@@)(@@) ||| 32(@)(@)(@@) @HAD011 إنك لن تلقى الله سبحانه بعمل أضر عليك من حب الدنيا(@)(@)(@@)(@@)(@@) ||| 33(@)(@)(@@) @HAD016 إنك لن تحمل الى الآخرة عملا أنفع لك من الصبر والرضا والخوف والرجاء(@)(@)PageV01P267(@)(@)(@@)(@@)(@@) ||| (ألفصل الرابع 
ms103	 عشر) مما ورد من حكم أمير المؤمنين على بن أبيطالب (عليه السلام) في حرف الألف فى خطاب الجمع بلفظ إنكم قال (عليه السلام)(@)(@)(@@)(@@)(@@) ||| 1(@)(@)(@@) @HAD014 إنكم بأعمالكم مجازون وبها مرتهنون (قال الله تعالى كل امرء بما كسب رهين)(@)(@)(@@)(@@)(@@) ||| 2(@)(@)(@@) @HAD09 إنكم إلى الآخرة صايرون وعلى الله تعالى معروضون(@)(@)(@@)(@@)(@@) ||| 3(@)(@)(@@) @HAD06 إنكم حصائد الآجال وأغراض الحمام(@)(@)(@@)(@@)(@@) ||| 4(@)(@)(@@) @HAD06 إنكم هدف النوائب ودريئة الأسقام(@)(@)(@@)(@@)(@@) ||| 5(@)(@)(@@) @HAD08 إنكم مدينون بما قدمتم ومرتهنون بما أسلفتم(@)(@)(@@)(@@)(@@) ||| 6(@)(@)(@@) @HAD012 إنكم طرداء الموت الذي إن أقمتم أخذكم وإن فررتم منه أدرككم(@)(@)(@@)(@@)(@@) ||| 7(@)(@)(@@) @HAD013 إنكم إلى العمل بما علمتم أحوج منكم إلى تعلم ما لم تكونوا تعلمون(@)(@)(@@)(@@)(@@) ||| 8(@)(@)(@@) @HAD011 إنكم إلى إنفاق ما اكتسبتم أحوج منكم إلى إكتساب ما تجمعون(@)(@)(@@)(@@)(@@) ||| 9(@)(@)(@@) @HAD09 إنكم إلى إعراب الأعمال أحوج منكم إلى إعراب الأقوال(@)(@)(@@)(@@)(@@) ||| 10(@)(@)(@@) @HAD03 إنكم إلى اكتساب(@)(@)PageV01P268(@)(@)(@@) @HAD07 صالح الأعمال أحوج منكم إلى مكاسب الأموال(@)(@)(@@)(@@)(@@) ||| 11(@)(@)(@@) @HAD015 إنكم إلى الإهتمام بما يصحبكم إلى الآخرة أحوج منكم إلى كل ما يصحبكم من الدنيا(@)(@)(@@)(@@)(@@) ||| 12(@)(@)(@@) @HAD09 إنكم إلى أزواد التقوى أحوج منكم إلى أزواد الدنيا(@)(@)(@@)(@@)(@@) ||| 13(@)(@)(@@) @HAD011 إنكم إلى عمارة دار البقاء أحوج منكم إلى عمارة دار الفناء(@)(@)(@@)(@@)(@@) ||| 14(@)(@)(@@) @HAD013 إنكم إلى جزاء ما أعطيتم أشد حاجة من السائل إلى ما أخذ منكم(@)(@)(@@)(@@)(@@) ||| 15(@)(@)(@@) @HAD010 إنكم أغبط بما بذلتم من الراغب إليكم فيما وصله منكم(@)(@)(@@)(@@)(@@) ||| 16(@)(@)(@@) @HAD011 إنكم إلى اكتساب الأدب أحوج منكم الى اكتساب الذهب والفضة(@)(@)(@@)(@@)(@@) ||| 17(@)(@)(@@) @HAD012 إنكم إلى القناعة بيسير الرزق أحوج منكم إلى اكتساب الحرص في الطلب(@)(@)(@@)(@@)(@@) ||| 18(@)(@)(@@) @HAD07 إنكم مؤاخذون بأقوالكم فلا تقولوا إلا خيرا(@)(@)(@@)(@@)(@@) ||| 19(@)(@)(@@) @HAD07 إنكم مجازون بأفعالكم فلا تفعلوا إلا برا(@)(@)(@@)(@@)(@@) ||| 20(@)(@)(@@) @HAD09 إنكم إلى مكارم الأفعال أحوج منكم الى بلاغة الأقوال(@)(@)(@@)(@@)(@@) ||| 21(@)(@)(@@) @HAD09 إنكم إلى اصطناع الرجال أحوج منكم إلى جمع الأموال(@)(@)(@@)(@@)(@@) ||| 22(@)(@)(@@) @HAD010 إنكم إن اغتررتم بالآمال تخرمتكم بوادر الآجال وقد فاتتكم(@)(@)PageV01P269(@)(@)(@@) @HAD06 الأعمال (واخترمه أهلكه واستأصله)(@)(@)(@@)(@@)(@@) ||| 23(@)(@)(@@) @HAD010 إنكم إن اغتنمتم صالح الأعمال نلتم من الآخرة نهاية الآمال(@)(@)(@@)(@@)(@@) ||| 24(@)(@)(@@) @HAD010 إنكم إنما خلقتم للآخرة لا للدنيا وللبقاء لا للفناء(@)(@)(@@)(@@)(@@) ||| 25(@)(@)(@@) @HAD09 إنكم ان رضيتم بالقضاء طابت عيشتكم وفزتم بالغناء(@)(@)(@@)(@@)(@@) ||| 26(@)(@)(@@) @HAD018 إنكم إن صبرتم على البلاء وشكرتم في 
ms104	 الرخاء ورضيتم بالقضاء كان لكم من الله سبحانه الرضا(@)(@)(@@)(@@)(@@) ||| 27(@)(@)(@@) @HAD011 إنكم إن زهدتم خلصتم من شقاء الدنيا وفزتم بدار البقاء(@)(@)(@@)(@@)(@@) ||| 28(@)(@)(@@) @HAD010 إنكم ان قنعتم حزتم الغنى وخفت عليكم مؤن الدنيا(@)(@)(@@)(@@)(@@) ||| 29(@)(@)(@@) @HAD015 إنكم إن رغبتم في الدنيا أفنيتم أعماركم فيما لا تبقون له ولا يبقى لكم(@)(@)(@@)(@@)(@@) ||| 30(@)(@)(@@) @HAD010 إنكم إن أمرتم عليكم الهوى أصمكم وأعماكم وأرداكم(@)(@)(@@)(@@)(@@) ||| 31(@)(@)(@@) @HAD09 إنكم إن أطعتم أنفسكم نزعت بكم إلى شر غاية(@)(@)(@@)(@@)(@@) ||| 32(@)(@)(@@) @HAD010 إنكم إن ملكتم شهواتكم نزت بكم إلى الأشر والغواية(@)(@)(@@)(@@)(@@) ||| 33(@)(@)(@@) @HAD011 إنكم إن أقبلتم على الله أقبلتم وإن أدبرتم عنه أدبرتم(@)(@)(@@)(@@)(@@) ||| 34(@)(@)(@@) @HAD010 إنكم إن رغبتم إلى الله غنمتم ونجوتم وإن(@)(@)PageV01P270(@)(@)(@@) @HAD06 رغبتم إلى الدنيا خسرتم وهلكتم(@)(@)(@@)(@@)(@@) ||| 35(@)(@)(@@) @HAD015 إنكم إن رجوتم الله بلغتم آمالكم وإن رجوتم غير الله خابت أمانيكم وآمالكم(@)(@)(@@)(@@)(@@) ||| 36(@)(@)(@@) @HAD08 إنكم ان أطعتم سورة الغضب أوردتكم موارد العطب(@)(@)(@@)(@@)(@@) ||| 37(@)(@)(@@) @HAD019 إنكم لن تحصلوا بالجهل اربا ولن تبلغوا به من الخير سببا ولن تدركوا به من الآخرة مطلبا(@)(@)(@@)(@@)(@@) ||| 38(@)(@)(@@) @HAD046 إنكم في زمان القائل فيه بالحق قليل واللسان فيه عن الصدق كليل واللازم فيه للحق ذليل أهله منعكفون على العصيان مصطلحون على الإدهان فتاهم عارم وشيخهم آثم وعالمهم منافق وقاريهم ممارق ولا يعظم صغيرهم كبيرهم ولا يعول غنيهم فقيرهم(@)(@)(@@)(@@)(@@) ||| 39(@)(@)(@@) @HAD013 إنكم ستعرضون على سبي أو البراءة مني فسبوني وإياكم والبرائة مني(@)(@)PageV01P271(@)(@)(@@)(@@)(@@) ||| (ألفصل الخامس عشر) مما ورد من حكم أمير المؤمنين على بن أبيطالب (عليه السلام) في حرف الألف بلفظ إنما قال (عليه السلام):(@)(@)(@@)(@@)(@@) ||| 1(@)(@)(@@) @HAD07 إنما الحلم كظم الغيظ وملك النفس(@)(@)(@@)(@@)(@@) ||| 2(@)(@)(@@) @HAD07 إنما الحزم طاعة الله ومعصية النفس(@)(@)(@@)(@@)(@@) ||| 3(@)(@)(@@) @HAD08 إنما الناس رجلان متبع شرعة ومبتدع بدعة(@)(@)(@@)(@@)(@@) ||| 4(@)(@)(@@) @HAD013 إنما