ms41	 أطمار الإماء الحواطب % 38(@)(@@) % إليك أمين الحضرتين تناقلت % مطايا بأنضاء خفاف الحقائب % 39(@)(@@) % وهن كأمثال القسي نواحل % مرقن بأمثال السهام الصوائب % 40(@)(@@) % فإن يدا طوقتني نفحاتها % % لمرتقب منها بلوغ المآرب % PageV01P128 البحر : كامل تام 1(@)(@@) % وعليلة اللحظات يشكو قرطها % % بعد المسافة من مناط عقودها % % 2(@)(@@) % حكت الغزالة والغزال ببعدها % % وبصدها وبوجهها وبجيدها % % 3(@)(@@) % فمنال تلك إذا نأت كوصالها % % ونفار ذاك وإن دنت كصدودها % % 4(@)(@@) % هي في الفؤاد ، وفيه نيران الهوى % % فبمدمعي تلوذ عند وقودها % % 5(@)(@@) % وإذا شكوت نسبت في شعري بها % % شكوى الحمام تنوح في تغريدها % % 6(@)(@@) % عرضت لنا تختال بين كواعب % والروض يذهل حورها عن غيدها % % 7(@)(@@) % إذ شق أردية الشقيق به الحيا % % فحكينه بقلوبها وخدودها % % PageV01P129 البحر : طويل 1(@)(@@) % لمن فتية منشورة وفراتها % % رواعف في أيمانها قنواتها % % 2(@)(@@) % تليح بهم جرد المذاكي عوابسا % وقد طاولت أرماحهم صهواتها % % 3(@)(@@) % إذا الحرب شبت بالأسنة والظبى % % فهم حين تصطك القنا جمراتها % % 4(@)(@@) % لهم في بني البرشاء قتلى كأنما % % أميلت على بطحائهم نخلاتها % % 5(@)(@@) % تدوسهم خيل عتاق وغلمة % تسيل على حد الظبى مهجاتها % % 6(@)(@@) % وقد علمت عليا نزار ويعرب % غداة استثير النقع ، أنا كماتها % % 7(@)(@@) % تلوي أنابيب الرماح بطعنة % مخالسة تزور عنها أساتها % % 8(@)(@@) % وتولغ في اللبات بيضا فتنثني % % من الدم حمرا تلتظي شفراتها % % 9(@)(@@) % وهل نحن إلا عصبة خندفية % ترادف غايات العلا سرواتها % % 10(@)(@@) % تضوع أرياح النجيع دروعهم % وتنفح مسكا ساطعا حبراتها % % PageV01P130 11(@)(@@) % وتدعو إذا استشرى العدا : يا لغالب % فتشرق من أبطالنا قسماتها % % 12(@)(@@) % وهم في سرابيل الحديدي ضراغم % ومن قصد خطية أجماتها % % 13(@)(@@) % وتطغى بنا يوم الوغى جاهلية % تردد في أعطافنا نخواتها % % 14(@)(@@) % ونسحب أذيال السوابغ ، والقنا % % شوارع ، والهيجاء شتى دعاتها % % 15(@)(@@) % فلله حي من كنانة أرقلوا % % إلى رتب لا تمتطى هضباتها % % 16(@)(@@) % بأيمانهم بيض مشاريف تختلي % % رؤوسا من الأعداء مالت طلاتها % % 17(@)(@@) % بأفيائهم قب عناجيج ، ترعوي % % إليهم لدى أطنابهم مهراتها % % 18(@)(@@) % يشبون بالبطحاء نارا قديمة % توقد والآفاق خضر لظاتها % % 19(@)(@@) % وتدمى عراقيب المطي إذا حدت % إليهم أعاريب الفلا سنواتها % % 20(@)(@@) % إذا 
ms42	 ما عقدنا راية مقتدية % رجعنا بها خفاقة عذباتها % % PageV01P131 21(@)(@@) % يسير حواليها الملوك بأوجه % تباهي ظبى أسيافهم صفحاتها % % 22(@)(@@) % إذا ركزوها فالأنام عفاتهم % وإن رفعوها فالنسور عفاتها % % 23(@)(@@) % ترد شعاع الشمس عنهم أسنة % تذوب على أطرافهن أياتها % % 24(@)(@@) % وتختال فيهم عزمة نبوية % إذا الحرب طاشت وقرتها أناتها % % 25(@)(@@) % لكم يا بني العباس في المجد سورة % تبحبح في حيي نزار بناتها % % 26(@)(@@) % وأنتم أعالي دوحة مضرية % تطيب على مر الليالي جناتها % % 27(@)(@@) % إذا انتضلت بالفخر كعب توشحت % بكم غررا مشهورة جبهاتها % % 28(@)(@@) % إليكم رسول الله أوصى بأمة % أقامت بمستن الرشاد غواتها % % 29(@)(@@) % فمهزوزة إن روعت أسلاتكم % ومغفورة إن أذنبت هفواتها % % 30(@)(@@) % ولم تشرق الأيام إلا بعدلكم % فما أحسن الدنيا وأنتم حماتها % % PageV01P132 31(@)(@@) % وفيكم سجايا من قصي وإنما % % مساعي الإمام القائمي صفاتها % % 32(@)(@@) % وينسبها شعري بأكناف بابل % كما انتسبت وهنا لصحبي قطاتها % % 33(@)(@@) % لكم أوجه ، للعين فيهن مسرح % حكت مشرفيات أرقت ظباتها % % 34(@)(@@) % وأيد كما حل الغمام نطاقه % تدر أفاويق الغنى نفحاتها % % 35(@)(@@) % فمن مبلغ أفناء خندف أنني % % بأفنية مخضرة عرصاتها % % 36(@)(@@) % يروح على صحبي بأرجائها الندى % % وتغدو بأشعاري إليها رواتها % % 37(@)(@@) % وتغلي بأسرار العذيب ضمائري % % ولكن قليل في النوى هفواتها % % 38(@)(@@) % وتطر بني الذكرى فأشتاق فتية % تدور على باغي القرى جفناتها % % 39(@)(@@) % وأكتم ما لو شاع أغرى بي العدا % % فبالجزع أحلام خفيف حصاتها % % 40(@)(@@) % وأذكر أياما بجرعاء مالك % رقاقا حواشيها غضابا وشاتها % % PageV01P133 41(@)(@@) % ولو علمت بغداد أن ركائبي % % على ظمأ لاستشرفت لي صراتها % % 42(@)(@@) % ولكنها تحت الأزمة خضع % إذا جأجأت بي من بعيد سقاتها % % 43(@)(@@) % فأوردها الرأي الظهيري مسرحا % على نغب زرق تجلت قذاتها % % 44(@)(@@) % وتلك ركابي إن غرضن ببلدة % بكرن ولم تشعر بسيري بزاتها % % 45(@)(@@) % ترود مصاب المزن أنى تلومت % وتنكر أفلاق الحصى ثفناتها % % 46(@)(@@) % فلا خيمت إلا لديكم مدائحي % % ولا ساقها إلا إليكم حداتها % % PageV01P134 البحر : بسيط تام 1(@)(@@) % مجد على هامة العيوق مرفوع % راق الورى منه مرئي ومسموع % 2(@)(@@) % وسؤدد لم يجب الدهر غاربه % وغيره في ندي الحي مدفوع % 3 
ms43	(@)(@@) % طرف الحسود غضيض دون غايته % % وسنه ببنان العجز مقروع % 4(@)(@@) % وقد ورثنا هما غرا جحا جحة % أريبهم في الندى بالحمد مخدوع % 5(@)(@@) % لكننا في زمان ليت دابره % بما يشق على الأوغاد مقطوع % 6(@)(@@) % غاض الكرام كما فاض اللئام به % فالخير مجتنب والشر متبوع % 7(@)(@@) % وما لهم نسب لكن لهم نشب % وكل لؤم به في الناس مرقوع % 8(@)(@@) % وهل يضرهم أن ليس عمهم % عمرو العلا هاشم والخال يربوع % 9(@)(@@) % وهم شباع رواء في الغنى ، ولنا % % أحساب آل أبي سفيان والجوع % PageV01P135 البحر : بسيط تام 1(@)(@@) % رنا ، وناظره بالسحر مكتحل % أغن يمتار من ألحاظه الغزل % 2(@)(@@) % فرحت أدنو بقلب هاجه شجن % وراح ينأى بخد زانه خجل % 3(@)(@@) % يمشي كما لا عبت الصبا غصنا % ظلت تجور به طورا وتعتدل % 4(@)(@@) % ذو وجنة إن جنت عين الرقيب بها % % ورد الحياء كساها ورسه الوجل % 5(@)(@@) % كالشمس إن غاب عنا فهي طالعة % وإن أطل علينا غالها الطفل % 6(@)(@@) % نخشى عيون العدا يعتادها شوس % تكاد من وقدات الحقد تشتعل % 7(@)(@@) % إذا انتضلنا أحاديث الهوى علقت % بنظرة تلد البغضاء تنتضل % 8(@)(@@) % واها لعصر يعنينا تذكره % مضى وفي الخطو من أيامه عجل % 9(@)(@@) % بمنزل حل فيه الغيث حبوته % حتى استهل عليه عارض هطل % 10(@)(@@) % أهدى لنا صحة تقوى النفوس بها % % نسيمه ، وأثارت ضعفه العلل % PageV01P136 11(@)(@@) % وموقف ضج جيد الريم من غيد % فيه ، وأزرى بألحاظ المها كحل % 12(@)(@@) % زرنا به رشأ يرتاد غرته % ذو لبدة بنجاد السيف مشتمل % 13(@)(@@) % يدير كأسين من لحظ ومبتسم % يغنيهما عن حباب ثغره الرتل % 14(@)(@@) % وينثني مشية النشوان من ترف % كأنما قده من طرفه ثمل % 15(@)(@@) % أزمان رقت حواشي الدهر في دول % لا يشرئب إليها حادث جلل % 16(@)(@@) % كأنها بندى المستظهر ارتجعت % روق الشبيبة ، حتى ماؤها خضل % 17(@)(@@) % عصر كورد الخدود البيض قد غرست % يد الحياء به ما تجتني القبل % 18(@)(@@) % وعزة دون أدناها ممنعة % مما يناجي عليه الفرقد الوعل % 19(@)(@@) % فالعدل منتشر ، والعزم مجتمع % والعمر مقتبل ، والرأي مكتهل % 20(@)(@@) % ساس البرية قرم ماجد ندس % غمر 
ms44	 للبديهة ندب حازم بطل % PageV01P137 21(@)(@@) % برأفة ما تخطى نحوها عنف % ومنحة لم يكدر صفوها بخل % 22(@)(@@) % لو كان في السلف الماضين إذ طفقت % نعل اليمانين يرخي شسعها الزلل % 23(@)(@@) % لقدمته قريش ثم ما ولغت % للبغي في دمها صفين والجمل % 24(@)(@@) % يتلو الأثمة من آبائه ، وبهم % في كل ما أثلوه يضرب المثل % 25(@)(@@) % شوس الحواجب في الهيجاء إذ لقحت % بيض المسافر ، وهابون ما سئلوا % % 26(@)(@@) % لهم من البيت ما طاف الحجيج به % والسهل من سرة البطحاء والجبل % 27(@)(@@) % إذا انتضى السيف وارى الأرض بحر دم % تضحي فواقعه الهامات والقلل % 28(@)(@@) % شزر المريرة ، سباق إلى أمد % يزور عن شأوه الهيابة الوكل % 29(@)(@@) % يروض أفكاره والحزم يسهره % وللإصابة في أعقابها زجل % 30(@)(@@) % حتى يرى ليله بالصبح ملتثما % وقد قضى بالكرى للعاجز الفشل % PageV01P138 31(@)(@@) % يا خير من خضبت أخفافها بدم % حتى أنيخت إلى أبوابه الإبل % 32(@)(@@) % بها صدى وحياض الجود مترعة % للواردين عليها العل والنهل % 33(@)(@@) % هنيت بالقادم الميمون طائره % نعماء يختال في أفيائها الدول % 34(@)(@@) % لو تستطيع لوت شوقا أخادعها % % إليك ثم إليه ، الأعصر الأول % 35(@)(@@) % أهلا بمنتجب سرت بمولده % من هاشم خلفاء الله والرسل % 36(@)(@@) % أغر مستظهري يستضاء به % تبلج السعد عنه وهو مقتبل % 37(@)(@@) % تثني الخلافة عطفيها به جذلا % لا زال يستن في أعطافها الجذل % 38(@)(@@) % والخيل تمرح من عجب بفارسها % % والبيض تبسم في الإغماد والأسل % 39(@)(@@) % هذا الهلال ستجلوه العلا قمرا % تلقى إليه عنان الطاعة المقل % 40(@)(@@) % فرع تأثل بالعباس مغرسه % وأصله برسول الله متصل % PageV01P139 41(@)(@@) % أعطاك ربك في الأولاد ما بلغت % أجدادهم فيك حتى حقق الأمل % PageV01P140 البحر : طويل 1(@)(@@) % رعى الله نفسي ما أشد اصطبارها % % ولو طلبت غير العلا ما تعنت % 2(@)(@@) % إذا ذكر المجد التليد تلفتت % إليه بعيني ثاكل وأرنت % 3(@)(@@) % فليت اعتراض اليأس دون رجائها % % ثنى غربها أو أدركت ما تمنت % 4(@)(@@) % ولولا دواعي همة أموية % تذكرها أجدادها لاطمأنت % 5(@)(@@) % تحن إلى حرب أخوض غمارها % % بجرد يبارين القنا في الأعنة % 6(@)(@@) % ويوم عبوس ضيق حجراته % تضاحكه تحت 
ms45	 العجاج أسنتي % % 7(@)(@@) % ولما رأت أن الثراء يخونها % % لوت جيدها عما تمنت وظنت % 8(@)(@@) % وما استهدفت للذل حين تكدرت % عليها الليالي ، فالقناعة جنتي % % PageV01P141 البحر : بسيط تام 1(@)(@@) % النجم يبعد مرمى طرفه الساجي % % والليل ينشر مرخى فرعه الداجي % % 2(@)(@@) % ويهتدي الطيف تغويه غياهبه % بكوكب فر عنه الأفق وهاج % 3(@)(@@) % طوى إلى نقوي حزوى على وجل % نهجا يكفكف غرب الأعيس الناجي % % 4(@)(@@) % ودون ما أرسلت ظمياء شر ذمة % ألقوا مراسيهم في آل وساج % % 5(@)(@@) % من نائل وعدي في عضادتها % % أو آل نسر بن وهب أو بني ناج % 6(@)(@@) % قوم يمانون ، والمثوى على إضم % لله ما جر تأويبي وإدلاجي % % 7(@)(@@) % رمى بهم شق يسراه إلى عصب % سدت بهم لهوات الأرض أفواج % % 8(@)(@@) % فهاج وجدا كسر النار تضمره % جوانح من نزيع الهم مهتاج % 9(@)(@@) % إذا التذكر أغرتني خيالتها % % به رجعت إلى الأشواق أدراجي % % 10(@)(@@) % غرثى للوشاح وسلوى قلبها شرق % % من معصمي طفلة كالريم مغناج % PageV01P142 11(@)(@@) % كأنها فنن مال النسيم به % % على كثيب وعاه الطل رجراج % 12(@)(@@) % بدت لنا كمهاة الرمل تكنفها % % هيف الخواصر من طي وإدماج % 13(@)(@@) % تشكو بأعينها صوتا تراع به % لناعب بفراق الحي شحاج % 14(@)(@@) % فقلت للركب والحادي يساعده % بشدوه ، وكلا صوتيهما شاج - % 15(@)(@@) % مباسم ما أرى تجلو لنا بردا % أم استطارت بروق بين أحداج % 16(@)(@@) % وهزة السير أنستهم معاطفهم % من كل زيافة كالفحل هملاج % 17(@)(@@) % وكلهم يشتكي بثا على كمد % بين الجوانح والأضلاع ولاج % % 18(@)(@@) % موله كنزيف بز ثروته % بذى رقاع لصفو الراح مجاج % 19(@)(@@) % إذا صحا عاودته نشوة فثنى % % يدا على أسحم السربال نشاج % 20(@)(@@) % وهم غضاب على الأيام ، لا حسب % يرعى ، ولا ملجأ فيهن للاجي % % PageV01P143 21(@)(@@) % يا سعد ذا اللمة المرخاة ما علقت % منك الخطوب بكابي الزند هلباج % 22(@)(@@) % دهر تذأب من أبنائه نقد % فأوطئت عرب أعقاب أعلاج % 23(@)(@@) % وأينع الهام لكن نام قاطفها % % فمن لها بزياد أو بحجاج % 24(@)(@@) % وكم أهبنا إليها بالملوك فلم % تظفر بأروع للغماء فراج % 25(@)(@@) % وأنت يا بن أبي الغمر الأغر لها % % فقل لذود 
ms46	 أضاعوا رعيها : عاج % 26(@)(@@) % وألقح الرأي ينتج حادثا جللا % إن الحوامل قد همت بإخداج % 27(@)(@@) % وإن كويت فأنضج غير متئد % لا نفع للكي إلا بعد إنضاج % 28(@)(@@) % ألست أغزرهم جودين ، شوبهما % % دم ، وأولاهم فودين بالتاج % 29(@)(@@) % هل يبلغون مدى يطوي اللغوب به % أذيال منشورة الأعراف مهداج % 30(@)(@@) % أم يملكون سجايا وشحت كرما % وألهجت بالمعالي أي إلهاج % PageV01P144 31(@)(@@) % متى أراها تثير النقع عابسة % تردي بكل طليق الوجه مبلاج % 32(@)(@@) % ولاج باب أناخ الخطب كلكله % به ومن غمرات الموت خراج % 33(@)(@@) % في غلمة كضواري الأسد أحنقها % % رز العدا دون غابات وأحراج % 34(@)(@@) % من فرع عدنان في أزكى أرومتها % % كالبحر يدفع أمواجا بأمواج % 35(@)(@@) % إذا الصريخ دعاهم أقبلوا رقصا % إلى الوغى قبل إلجام وإسراج % 36(@)(@@) % يرمي بهم سرعان الخيل شاحبة % تلف في الروع أعراجا بأعراج % 37(@)(@@) % بحيث ينسى الحفاظ المر حاضره % والطعن لا يتقى إلا بأثباج % 38(@)(@@) % ولا يذود كمي فيه عن حرم % ولا يحامي غيور دون أزواج % 39(@)(@@) % حتى يمج غرار المشرفي دما % والرمح ما بين لبات وأوداج % 40(@)(@@) % نمتك من غالب أقمار داجية % تحل من ظلل الهيجا بأبراج % PageV01P145 41(@)(@@) % قوم حوى الشرف الوضاح أولهم % والناس بين سلالات وأمشاج % 42(@)(@@) % يمري أكفهم إن حاردت سنة % فيستدر أفاويق الغنى الراجي % % 43(@)(@@) % لن يبلغ المدح في تقريظ مجدهم % مداه حتى كأن المادج الهاجي % % 44(@)(@@) % مهلا فلا شأو بعد النجم تلحفه % ملاءة قدم الساعي بإرهاج % 45(@)(@@) % الله يعلم والأقوام أن لكم % عند الفخار لسانا غير لجلاج % 46(@)(@@) % والدهر يثني بما نثني عليك به % وما بمطريك من عي وإرتاج % 47(@)(@@) % وقد أغذ إليك العيد مغترفا % من ذي فروغ ملث الودق ثجاج % % 48(@)(@@) % وكل أيامك الأعياد ضاحكة % عن روضة جادها الوسمي مبهاج % 49(@)(@@) % فأرع سمعك شعرا يستلذ به % رجع الغناء بأرمال وأهزاج % 50(@)(@@) % لولا الهوى لرمينا الليل عن عرض % بأرحبي ، لهام البيد ، شجاج % PageV01P146 51(@)(@@) % ومن أزارك للعلياء همته % فليس يرضى بمزجاة من الحاج % PageV01P147 البحر : طويل 1(@)(@@) % خليلي إن العمر ودعت شرخه % وما في مشيبي من تلاف لفارط 
ms47	 % 2(@)(@@) % ألم تعلما أني أنست بعطلة % مخافة أن أبلى بخدمة ساقط % 3(@)(@@) % فلا تدعواني للكتابة إنها % % طماعة راج في مخيلة قانط % 4(@)(@@) % ينافسني فيها رعاع تهادنوا % % على دخن من بين راض وساخط % 5(@)(@@) % وأنكرت الأقلام منهم أناملا % مهيأة أطرافها للمشارط % 6(@)(@@) % لئن قدمتهم عصبة خانها النهى % % فهل ساقط لم يحظ يوما بلاقط % 7(@)(@@) % وأي فتى ما بين بردي قابض % عن الشر كفيه ، وللخير باسط % 8(@)(@@) % ومعتجر بالحلم والسلم تبتغى % % وللجأش في بحبوحة الحرب رابط % 9(@)(@@) % ولكنني أغضيت جفني على القذى % % ولم أرض إدراك العلا بالوسائط % 10(@)(@@) % أقول لذي الباع الطويل عويمر % ومن شيمتي نصح الصديق المخالط % PageV01P148 11(@)(@@) % هو الدهر لا تبغ الحقيقة عنده % وإن شئت أن تكفى أذاه فغالط % PageV01P149 البحر : كامل تام 1(@)(@@) % لمعت كناصية الحصان الأشقر % نار بمعتلج الكثيب الأعفر % 2(@)(@@) % تخبو وتوقدها ولائد عامر % % بالمندلي وبالقنا المتكسر % 3(@)(@@) % فتطارحت مقل الركائب نحوها % % ولنا برامة وقفة المتحبر % 4(@)(@@) % وهززت أطراف السياط فأرقلت % وبها مراح الطارق المتنور % 5(@)(@@) % حني رويدا ناق إن مناخنا % % بعنيزتين ، ونارها بمحبر % 6(@)(@@) % فمتى اللقاء ودون ذلك فتية % ضربت قبابهم بقنة عرعر % 7(@)(@@) % وأسنة المران حول بيوتهم % شدت بها عذر العتاق الضمر % 8(@)(@@) % فهم يشبون الحروب إذا خبت % بالبيض تقطر بالنجيع الأحمر % 9(@)(@@) % يا أخت مقتحم الأسنة في الوغى % % لولا مراقبة العدا لم تهجري % % 10(@)(@@) % هل تأمرين بزورة من دونها % % حدق تشق دجى الظلام الأخضر % PageV01P150 11(@)(@@) % أأصانع الأعداء فيك وطالما % % خضب القنا بدماء قومك معشري ؟ % 12(@)(@@) % ويروعني لغط الوشاة ، وقبلنا % % حكمت قبائل خندف في حمير ؟ % 13(@)(@@) % لأشارفن إليك كل تنوفة % زوراء تعقر بالمشيح الأزور % 14(@)(@@) % فلكم هززت إليك أعطاف الدجى % % وركبت هادية الصباح المسفر % 15(@)(@@) % نفسي فداؤك من عقيلة معشر % منعوا قضاعة بالعديد الأكثر % 16(@)(@@) % ألفت ظباء الواديين ، فعندها % % حذر الغزالة والتفاف الجؤذر % 17(@)(@@) % وبمنشط الحوذان خمسة أرسم % تبدو فأحسبهن خمسة أسطر % 18(@)(@@) % وافيتها والركب يسجد للكرى % % والعيس تركع بالحزيز الأوعر % 19(@)(@@) % فوقفت أسألها وفي عرصاتها % % طرب المشوق وحنة المتذكر % 20(@)(@@) % وكأن أطلالا بمنعرج اللوى % % أشلاء 
ms48	 قتلاك التي لم تقبر % PageV01P151 21(@)(@@) % أخليت منها الشام حين تظلمت % منها ، ومن يستجد عدلك ينصر % 22(@)(@@) % فقشرت بالعضب الجراز قشيرها % % وقلعت بالأسلات قلعة جعبر % 23(@)(@@) % شماء تلعب بالعيون ، وترتدي % % هضباتها حلل السحاب الأقمر % 24(@)(@@) % وتحلها عصب تضرم للقرى % % شذب الأراك زهادة في العنبر % 25(@)(@@) % قوم حصونهم الأسنة والظبا % % والخيل تنحط في مطار العثير % 26(@)(@@) % ألفوا ظهور المقربات وما دروا % % أن المصير إلى بطون الأنسر % 27(@)(@@) % فخبت ببأسك فتنة عربية % كانت تهجهج بالسوام النفر % 28(@)(@@) % وفتحت أنطاكية الروم التي % % نشزت معاقلها على الإسكندر % 29(@)(@@) % وكفى معز الدين رأيك عسكرا % لجبا يجنح جانبيه بعسكر % 30(@)(@@) % وطئت مناكبها جيادك فانثنت % تلقي أجنتها بنات الأصقر % PageV01P152 31(@)(@@) % تردي كما نسلت سراحين الغضى % % قبل العيون بجنة من عبقر % 32(@)(@@) % وترى الشجاع يدير في حمس الوغى % % حدق الشجاع يلحن تحت المغفر % 33(@)(@@) % فتناوش الأسل الشوارع أرضها % % والخيل تعثر في العجاج الأكدر % 34(@)(@@) % رفعت منار العدل في أرجائها % % فالليث يخضع للغزال الأحور % 35(@)(@@) % وترشف العافون منك أناملا % يخلفن غادية الغمام المغزر % 36(@)(@@) % وردوا نداك فأصدرت نفحاته % عنك المقل يجر ذيل المكثر % 37(@)(@@) % وصبا الدهور إليك بعد مضيها % % لترى نضارة عصرك المتأخر % 38(@)(@@) % فغدا بها الإسلام يسحب ذيله % مرحا ويخطر خطرة المتبختر % 39(@)(@@) % إيها فقد أدركت من شرف العلا % % ما لم ينل ، وذخرت ما لم يذخر % 40(@)(@@) % وبلغت غاية سؤدد لم يلفه % كسرى ، ولا علقته همة قيصر % PageV01P153 41(@)(@@) % فإذا استجار بك العفاة تبينوا % % أثر السماح على الجبين الأزهر % 42(@)(@@) % ورأوا علا إسحاق شيد سمكها % % كرم الرضي ، فياله من مفخر % 43(@)(@@) % ومناصبا فرعت ذؤابة فارس % لم يستبد بهن آل المنذر % 44(@)(@@) % يا صاحبي دنا الرحيل فقربا % % وجناء تكفل بالغنى للمقتر % 45(@)(@@) % وتجر أثناء الزمام إلى فتى % % خضل الأنامل ، كسروي المفخر % 46(@)(@@) % فمطالع البيداء تعلم أنني % % أسري وأعنف بالمهارى الحسر % 47(@)(@@) % وأحبر الكلم التي لا أرتضي % % منها بغير الشارد المتخير % 48(@)(@@) % وجزالة البدوي في أثنائه % مفترة عن رقة المتحضر % 49(@)(@@) % وإليك يلتجئ الكريم ، ويتقي % % بك ما يحاذر ، والنوائب تعتري % % 50(@)(@@) % والأرض 
ms49	 دارك ، والبرايا أعبد % وعلى أوامرك اختلاف الأعصر % PageV01P154 البحر : طويل 1(@)(@@) % عجبت لمن يبغي مداي وقد رأى % % مساحب ذيلي فوق هام الفراقد % 2(@)(@@) % ولي نسب في الحي عال يفاعه % رحيب مساري العرق زاكي المحاتد % 3(@)(@@) % وفي من الفضل الذي لو ذكرته % كفاني أن أزهى بجد ووالد % 4(@)(@@) % ورثنا العلا وهي التي خلقت لنا % % ونحن خلقنا للعلا والمحامد % 5(@)(@@) % أبا فأبا من عبد شمس وهكذا % % إلى آدم لم ينمنا غير ماجد % PageV01P155 البحر : كامل تام 1(@)(@@) % جهد الصبابة أن أكون ملوما % % والوجد يظهر سري المكتوما % % 2(@)(@@) % يا صاحبي ترفقا بمتيم % نزف الصبابة دمعه المسجوما % % 3(@)(@@) % وأضاء برق كاد يسلبه الكرى % % فتقصيا نظرا إليه وشيما % % 4(@)(@@) % وتعلما أني أجيل وراءه % طرفا يثير على الفؤاد هموما % % 5(@)(@@) % لولا أميمة ما طربت لبارق % ضرم الزناد ، ولا انتشقت نسيما % % 6(@)(@@) % فقفا بحيث محا مساحب ذيلها % % نكباء غادرت الديار رسوما % % 7(@)(@@) % والنؤي أنحله البلى ، فكأنها % % أهدت إليه سوارها المفصوما % % 8(@)(@@) % لازال مرتجز الغمام بربعها % % غدقا وخفاق النسيم سقيما % % 9(@)(@@) % ما أنس لا أنس الوداع وقولها % % والثغر يجلو اللولؤ المنظوما % % 10(@)(@@) % لا تقرب البكري إن وراءه % من أسرتيه جحا جحا وقروما % % PageV01P156 11(@)(@@) % فخرت علي الوائلية ضلة % كفى وغاك فقد أصبت كريما % % 12(@)(@@) % إن تفخري ببنى أبيك فإن لي % % من فرع خندف ذروة وصميما % % 13(@)(@@) % حدبت علي قبائل مضرية % طلعت عليك أهلة ونجوما % % 14(@)(@@) % آتاهم الله النبوة والهدى % % والملك مرتفع البناء عظيما % % 15(@)(@@) % وسما بإبراهيم ناصر دينه % شرف الخليل أبيه إبراهيما % % 16(@)(@@) % متهلل يحمي حقيقة عامر % بالسيف عضبا والنوال جسيما % % 17(@)(@@) % ويهز ه نغم الثناء كأنه % متسمع هزج الغناء رخيما % % 18(@)(@@) % والجار يأمن في ذراه كأنما % % عقدت مكارمه عليه تميما % % 19(@)(@@) % يغدو لحالية الربيع مجاورا % ولصوب غادية الغمام نديما % % 20(@)(@@) % وله ذمام أبيه حزن إن جرت % ريح الشتاء على السوام عقيما % % PageV01P157 21(@)(@@) % ولفارس الهرار فيه شمائل % لقحت بها الحرب العوان قديما % % 22(@)(@@) % من معشر بيض الوجوه توشحوا % % شيما خلقن من العلا وحلوما % % 23(@)(@@) % إن أقدموا برزوا إليك صوارما % أو أنعموا 
ms50	 مطروا عليك غيوما % % 24(@)(@@) % تلقى الكماة الصيد حول بيوتهم % والخيل صافنة تلوك شكيما % % 25(@)(@@) % وكتيبة من سر جوثة فخمة % كالأسد تملأ مسمعيك نئيما % % 26(@)(@@) % زخرت بهم أم البنين فأقبلوا % % كالمشرفية نجدة وعزيما % % 27(@)(@@) % وإذا العمومة لم تشج بخؤولة % خرج النسيب بها أغر بهيما % % 28(@)(@@) % ومرنحين من النعاس بعثتهم % % والعين تكسر جفنها تهويما % % 29(@)(@@) % فسرت بهم ذلل المطي لواغبا % تهفو إلى آل المسيب هيما % % 30(@)(@@) % قوم إذا طرق الزمان بحلدث % لم يلف مارن جارهم مخطوما % % PageV01P158 31(@)(@@) % يتهللون إلى العفاة بأوجه % رقت ، وقد غلظ الزمان أديما % % 32(@)(@@) % ياسيد العرب الألى زيدوا به % شرفا بميسم عزة مرقوما % % 33(@)(@@) % نشأت قناتك في فروع هوزان % ريا المعاقد لا تسر وصوما % % 34(@)(@@) % ولحاسديك ، وأنت مقتبل الصبا % % كمد يكاد يصدع الحيزوما % % 35(@)(@@) % لا عذر للقيسي يضرب طوقه % طرف اللبان ولا يسود فطيما % % PageV01P159 البحر : كامل أحذ 1(@)(@@) % كبد تذوب ومدمع هطل % فمتى يورع صبوتي عذل % 2(@)(@@) % ماذا يروم به العذول وكم % يلوي عليه لسانه الخطل % 3(@)(@@) % أما السلو فإن مطلبه % صعب ولكن أدمعي ذلل % 4(@)(@@) % وبمهجتي رشأ كأن به % ثملا يميل به ويعتدل % 5(@)(@@) % كالمسك في لون وفي أرج % يمتار منه العنبر الشمل % 6(@)(@@) % فجلا صباح الشيب حين حكى % % ليل الشبيبة ثغره الرتل % 7(@)(@@) % يا لائمي ، وجانحي دميت % وجدا به ، والقلب مختبل % 8(@)(@@) % تهوى الظباء الكحل أعينها % % وتعيب ظبيا كله كحل % 9(@)(@@) % قد صيغ من حب القلوب كما % % نفضت عليه سوادها المقل % PageV01P160 البحر : بسيط تام 1(@)(@@) % رنت إلي وظل النقع ممدود % سوابق الخيل والمهرية القود % 2(@)(@@) % فما غمدن عن الأسياف أعينها % % إلا ومسلولها في الهام مغمود % 3(@)(@@) % أفعالنا غرر فوق الجباه لها % % وللحجول دم الأعداء مورود % 4(@)(@@) % أنا ابنها ورماح الخط مشرعة % وللكماة عن الهيجاء تعريد % 5(@)(@@) % من كل مرتعد العرنين ، يحفزه % رأي جميع ، وطيات عباديد % 6(@)(@@) % صحبته حين لا خل يؤازره % ولا يخب إلى واديه منجود % 7(@)(@@) % إذا ذكرناه هز الرمح عامله % والسيف مبتسم ، والبأس مشهود % 8(@)(@@) % نأى فأنكرت نصلي واتهمت يدي % % وفاقد النصر يوم الروع مفقود 
ms51	 % 9(@)(@@) % كادت تضيق بأنفاسي مسالكها % % كأن مطلعها في الصدر مسدود % 10(@)(@@) % ما فات عارم لحظي ريث رجعته % إلا وجفني على ما ساء مردود % PageV01P161 11(@)(@@) % ياعامر بن لؤي أنتم نفر % شوس ، إذا ثوب الداعي ، صناديد % 12(@)(@@) % أرحتم النعم المشلول عازبه % وقد تكنفه القوم الرعاديد % 13(@)(@@) % فما لجاركم ليث الهوان به % وعزكم بمناط النجم معقود % 14(@)(@@) % يرنو إلى عذبات الورد من ظمأ % لحظ الطريدة حيث الماء مثمود % 15(@)(@@) % وللركائب إرزام ترجعه % إذا أقمنا ولم تشرق بها البيد % 16(@)(@@) % كنا نحيد عن الري الذليل بها % % وهل يروي صدى الأنضاء تصريد % 17(@)(@@) % فاستشرفت لمصاب المزن طامحة % وهن من لغب أعناقها غيد % 18(@)(@@) % وزرن أروع لا يثني مسامعه % عن دعوة الجار تأنيب وتفنيد % 19(@)(@@) % فللحداة على أرجاء منهله % بما تحملن من مدحي ، أغاريد % 20(@)(@@) % ألقيت عبء النوى عنهن حين غدت % تلقى إلى ابن أبي أوفى المقاليد % PageV01P162 21(@)(@@) % محسد المجد ، لم يطلع ثنيته % إلا أغر على العلياء محسود % 22(@)(@@) % يستحضن الليل أفكارا أراق لها % % كأس الكرى ، واعتلاج الفكر تسهيد % 23(@)(@@) % لله آل عدي حين يرمقهم % لحظ يردده العافون مزؤود % 24(@)(@@) % تشكو إليهم شفار البيض مرهفة % غر مناجيد أو أدم مقاحيد % 25(@)(@@) % فتلك أيديهم تدمي سماحتها % % والسؤدد الغمر حيث البأس والجود % 26(@)(@@) % بشرى فقد أنجز الأيام ما وعدت % وقلما صدقت منها المواعيد % 27(@)(@@) % إن الإمارة لا تمطي غواربها % % إلا المغاوير والشم المناجيد % 28(@)(@@) % إن يسحب الناس أذيال الظنون بها % % فلا يخاطر ليث الغابة السيد % 29(@)(@@) % وقد دعاك أمير المؤمنين لها % % والهم منتشر والعزم مكدود % 30(@)(@@) % فكنت أول سباق إلى أمل % على حواشيه للأنفاس تصعيد % PageV01P163 31(@)(@@) % وهل يحيط من الأقوام ذو ظلع % بغاية أحرزتها الفتية الصيد % 32(@)(@@) % ورضت أمرا أطاف العاجزون به % وكاد يلوي بشمل الملك تبديد % 33(@)(@@) % فأحجموا عنه والأقدام ناكصة % وللأمور إذا أخلقن تجديد % 34(@)(@@) % كذلك الصبح إن هزت مناصله % يد السنا فقميص الليل مقدود % 35(@)(@@) % لولاك ردت على الأعقاب شاردة % تمد أضباعها الصيد المجاويد % 36(@)(@@) % ولم ترد عقوة الزوراء ناجية % تدمي السريح بأيديها الجلاميد % 37 
ms52	(@)(@@) % فقت الأعاريب في شعر نأمت به % كأنه لؤلؤ في السلك منضود % 38(@)(@@) % إن كان يعجزهم قولي ويجمعنا % % أصل ، فقد تلد الخمر العناقيد % 39(@)(@@) % وهذه مدح درت بها منح % بيض أضاءت بهن الأزمن السود % 40(@)(@@) % إذا التفت إلى ناديك ممتريا % نداك طوق من نعمائك الجيد % PageV01P164 البحر : وافر تام 1(@)(@@) % مقيل النصر في ظلل القتام % ومسرى العز في ظبة الحسام % 2(@)(@@) % ولي همم جثمن على ضلوع % تلف من الهموم على كلام % 3(@)(@@) % تمر بها الخطوب وهن شوس % فتقرفها بأظفار دوام % 4(@)(@@) % وقلبي يطمئن به التياح % أضم حشاي منه على ضرام % 5(@)(@@) % ولا أصبو إلى ري ذليل % إذا صادفت عزي في أوامي % % 6(@)(@@) % ستجلى غمرة الحدثان عني % % وما ملكت علي يد زمامي % % 7(@)(@@) % فضوء الصبح مرتقب لسار % تردد بين أثناء الظلام % PageV01P165 البحر : طويل 1(@)(@@) % طلبنا النوال الغمر ، والخير يبتغى % % فلم نر أندى منك ظلا وأسبغا % % 2(@)(@@) % وزرنا بني كعب فخلنا وجوههم % شموسا نبت عنها النواظر بزغا % % 3(@)(@@) % فأنت الحيا والجود يغبر أفقه % وليث الشرى والبأس يحمر في الوغى % % 4(@)(@@) % وتسطو كما يعتن في جريانه % أتي إذا مارد ريعانه طغى % % 5(@)(@@) % ولولاك لم ترضع غوادي مزنة % خمائل تضحي السحب عنهن روغا % % 6(@)(@@) % لك الراحة الوطفاء يربي نوالها % % على مطر في صفحة الأرض رسغا % % 7(@)(@@) % وعزمة ذي شبلين إن شم مرغما % أخاض النجيع الورد نابا وأولغا % % 8(@)(@@) % وناد يغض الطرف فيه مهابة % ولا ينقل العوراء عنه ولا اللغا % % 9(@)(@@) % فلا الماحل الواشي يفوه بباطل % لديه ، ولا الإصغاء يدني المبلغا % % 10(@)(@@) % يكاد فم الجبار يرشف بسطه % إذا الخد في أطرافهن تمرغا % % PageV01P166 11(@)(@@) % إذا ما مخضت الرأي والخطب عاقد % نواصيه بان الصريح من الرغا % % 12(@)(@@) % تشيم الظبا حتى إذا الحرب ألقحت % هززت حساما للجماجم مفدغا % % 13(@)(@@) % غدا والردى تستن في شفراته % يمير دما بالحائنين تبيغا % % 14(@)(@@) % فما الرأي إلا أن يضرج غربه % به تحت أذيال العجاج ويصبغا % % 15(@)(@@) % ولا عز حتى تترك القرن مرهقا % حمته العوالي أن يعيث وينزغا % % 16(@)(@@) % فبكر عليه بالأراقم لسعا % وأسر إليه بالعقارب 
ms53	 لدغا % % 17(@)(@@) % وأرعف شباة الرمح ، فالنصر حائم % عليك إذا ما الطعن بالدم أوزغا % % 18(@)(@@) % وكل امرئ جازى المسيء بفعله % فلا حزمه ألغى ، ولا الدين أوتغا % % 19(@)(@@) % فدى لك من يطوي الهجاء أديمه % على حلم إذ لم يجد فيه مدبغا % % 20(@)(@@) % وقد نعشته ثروة غير أنه % أعد بها للذم عرضا ممشغا % % PageV01P167 21(@)(@@) % فإن ازدياد المال من غير نائل % يشين الفتى كالسن لز به الشغا % % 22(@)(@@) % إذا صيح بالأمجاد أقمأ شخصه % وإن زأر الضرغام في غابه ثغا % % 23(@)(@@) % وإن هدرت يوم الفخار شقاشق % شحا فاه يستقري الكلام الممضغا % % 24(@)(@@) % تلوب المنى من راحتيه على صرى % وتمتاح بحرا من يمينك أهيغا % % 25(@)(@@) % وشاردة يطوي بها الأرض بازل % إذا اضطرب الأعناق من لغب رغا % % 26(@)(@@) % أدار بها الراوي كؤوس مدامة % يظل فصيح القوم منهن ألثغا % % 27(@)(@@) % ودون قوافيها كبا كل شاعر % إذا قيد كرها في أزمتها ضغا % % 28(@)(@@) % فذللتها حتى تحلت بمنطق % يرد على أعقاب وحشيها اللغا % % 29(@)(@@) % أراك بطرف ما زوى عنك لحظه % ولا افتر عن قلب إلى غيركم صغى % % 30(@)(@@) % بقيت ضجيع العز في خضن دولة % لبست بها طوق الأهلة مفرغا % % PageV01P168 البحر : خفيف تام 1(@)(@@) % وقواف ملس المتون شداد ال % % أسر غر مصقولة الأطراف % 2(@)(@@) % لم يشنها إجازة وسناد % وحلت إذ خلت من الإصراف % 3(@)(@@) % وإذا ما رواتها انتقدوها % % حسبوها لآلئ الأصداف % 4(@)(@@) % صغتها في النسيب والفخر حتى % % عد فيها الإعجاء من أوصافي % % 5(@)(@@) % ومتى زل عن لساني مديح % هو أدنى مروءة الأشراف % 6(@)(@@) % فأنا المستعير معناه مما % % قاله المادحون في الأسلاف % PageV01P169 البحر : كامل تام 1(@)(@@) % لك ما يروقه الغمام الهاطل % إن رد عبرته الجموح السائل % 2(@)(@@) % وعليك يا طلل الجميع تحية % أصغى ليسمعها المحل الآهل % 3(@)(@@) % أمن البلى هذا النحول أم الضنى % % فالحب من شيمي وأنت الناحل % 4(@)(@@) % خلع الربيع عليك من أنواره % حليا توشحه ثراك العاطل % 5(@)(@@) % والروض في أفوافه متبرج % والزهر في حلل السحائب رافل % 6(@)(@@) % وغنيت في حجر الحيا مسترضعا % يغذوك واشل طله والوابل % 7(@)(@@) % كانت أيادي الدهر 
ms54	 فيك كثيرة % لكن لياليه لديك قلائل % 8(@)(@@) % في حيث يقتنص الأسود ضواريا % لحظ تمرضه المهاة الخاذل % 9(@)(@@) % إذا لم يكن ، والليل يسحب ذيله % لسعاد غير يدي وشاح جائل % 10(@)(@@) % فكأننا غصنان يشكو منهما % % برح الغرام إلى الرطيب الذابل % PageV01P170 11(@)(@@) % هيفاء إن خطرت فقد رامح % نجلاء إن نظرت فطرف نابل % 12(@)(@@) % وكأن فاها بعدما نشر الدجى % % فرعا يلوح به الخضاب الناصل % 13(@)(@@) % صهباء تعشي الناظرين نضت بها % % عذب الفدام عن اللطيمة بابل % 14(@)(@@) % وأبي اللوائم لا أفقت من الهوى % % ولئن أفقت فأين قلب ذاهل % 15(@)(@@) % حتى يرد قوام دولة هاشم % من يرتجيه لما يقول العاذل % 16(@)(@@) % مر الحفيظة والرماح يشفها % % ظمأ ، ومن ثغر النحور مناهل % 17(@)(@@) % يرمي العدو ودرعه من حلمه % فيقيه عادية المنون القاتل % 18(@)(@@) % والراية السوداء يخفق ظلها % % والرعب يطلع ، والتجلد آفل % 19(@)(@@) % والقرن قلقل جأشه حذر الردى % % فأعير نفرته النعام الجافل % 20(@)(@@) % نام الملوك وبات سرحان الغضى % % مرعي سرحهم له والهامل % PageV01P171 21(@)(@@) % فأعاد أكناف العراق على العدا % % شركا يدب به الضراء الحابل % 22(@)(@@) % ويمد ساعده الطعان كما لوت % للفحل من طرف العسيب الشائل % 23(@)(@@) % وطوى إلى أمد المكارم والعلا % % نهجا تجنب طرتيه الناعل % 24(@)(@@) % وله شمائل أودعت من نشرها % % سرا يبوح به النسيم خمائل % 25(@)(@@) % ويد يتيه بها اليراع على الظبا % % ويشاب فيها بالنجيع النائل % 26(@)(@@) % علقت بكلتا راحتيه أربع % نفض الأنامل دونهن الباخل % 27(@)(@@) % نعم يشف وراءها نيل المنى % % وأعنة وأسنة ومناصل % 28(@)(@@) % من معشر فرعوا ذوائب سؤدد % أغصان دوحته الكمي الباسل % 29(@)(@@) % تدعى زرارة في أواخر مجدهم % يوم الفخار ، وفي الأوائل وائل % 30(@)(@@) % يا خيرهم حيث السيوف تزيدها % % طولا وقد قصرت عليك حمائل % PageV01P172 31(@)(@@) % إن الصيام يهز عطفي شهره % أجر بما زعم التمني كافل % 32(@)(@@) % وافاك طلق المجتلي ، فثوابه % لك آجل ، ونداك فيه عاجل % 33(@)(@@) % وإذا السنون قضى بسعدك حاضر % منها تبلج عنه عام قابل % 34(@)(@@) % وحمى بك المستظهر الشرف الذي % % يزور دون ثنيتيه الواقل % 35(@)(@@) % وبك استفاض العدل ، واعتجر الورى % % بالأمن ، وانتبه الزمان الغافل % 36 
ms55	(@)(@@) % لما أرحت إليه عازب سربهم % هدأ الرعية واستقام المائل % 37(@)(@@) % ودعاك للنجوى ، فكنت لرأيه % رداءا ، كما عضد السنان العامل % 38(@)(@@) % وبرزت في حلل الجلال ، أنارها % % بأنامل العز النعيم الشامل % 39(@)(@@) % متوشحا بالمشرفي ، يقله % أسد ، مخالبه الحسام القاصل % 40(@)(@@) % فوق الأغر ، يلوح في أعطافه % من آل أعوج والصريح شمائل % PageV01P173 41(@)(@@) % ومعرس النعمى دواة ، حليها % % حسب تحف به علا وفضائل % 42(@)(@@) % نشر الصباح بها الجناح ، ورقرقت % فيها من الشفق النضار أصائل % 43(@)(@@) % وكأنما أقلامها هندية % بيض أحد متونهن الصاقل % 44(@)(@@) % والعز مقتبل بحيث صريرها % صليل سيفك والجواد الصاهل % 45(@)(@@) % ففداك من ريب الحوادث ناقص % في المكرمات ، وفي المعايب كامل % 46(@)(@@) % بيد يشام لها بريق خلب % علقت به ذبل الجهام محائل % 47(@)(@@) % غلت عن المعروف فهي بكية % والضرع تغمره الأصرة حافل % 48(@)(@@) % قسما بخوص شفها عقب السرى % % حتى رثى لابن اللبون البازل % 49(@)(@@) % وفلت بأيديهن ناصية الفلا % % فشكا الكلال إلى الإظل الكاعل % 50(@)(@@) % والليل بحر ، والغياهب لجة % والشهب در ، والصباح الساحل % PageV01P174 51(@)(@@) % ومرنحين سقاهم خدر الكرى % % نطفا يعاف كؤوسهن الواغل % 52(@)(@@) % نزلوا بمعتلج البطاح ، وعنده % لفت على الحسب الصميم وصائل % 53(@)(@@) % لأقلدنك مدحة أموية % فانظر من المهدي لها والقائل % 54(@)(@@) % فالورد إلا في ذراك مرنق % والظل إلا في جنابك زائل % 55(@)(@@) % والحق أنت ، وكل مانثني به % إلا عليك من المدائح باطل % PageV01P175 البحر : كامل تام 1(@)(@@) % وكواعب تشكو الوشاة كما شكت % أردافها عند القيام خصورها % % 2(@)(@@) % وتريك أدحي الظليم حجالها % % وتضم غزلان الصريم خدورها % % 3(@)(@@) % وإذا رنت ولع الفتوربمهجتي % % من أعين ملك القلوب فتورها % % 4(@)(@@) % حسنت ليالي الوصل حين تشابهت % وجناتها في حسنها وبدورها % % 5(@)(@@) % وصددت عن تلك المراشف عفة % فالريق خمر والحباب ثغورها % % PageV01P176 البحر : طويل 1(@)(@@) % أصاخ إلى الواشي فلباه إذ دعا % % وقد كان لا يرعي النمائم مسمعا % % 2(@)(@@) % وبات يناجي ظنه في بعدما % % أباح الهوى مني حمى القلب أجمعا % % 3(@)(@@) % وأبدى الرضى والعتب في أخرياته % ومن بينات الغدر أن يجمعا معا % % 4(@)(@@) % ومن ناول الإخوان حبلا مشى البلى % % إلى طرفيه ، هم أن 
ms56	 يتقطعا % % 5(@)(@@) % فما غره من مضمر الغل كاشح % إذا حدر الخصم اللثام تقنعا % % 6(@)(@@) % سعى بي إليه ، لا هدى الله سعيه % ولو نال عندي ما ابتغاه لما سعى % % 7(@)(@@) % وحاول مني غرة حال دونها % % مكائد تأبى أن أغر وأخدعا % % 8(@)(@@) % فأجررته حبل المنى غير أنني % % سلكت به نهجا إلى الغي مهيعا % % 9(@)(@@) % ولما رأى أني تبينت غدره % وأدركت حزم الرأي فيه وضيعا % % 10(@)(@@) % أزار يديه ناجذيه تندما % يبوئه في باحة الموت مصرعا % % PageV01P177 11(@)(@@) % لك الله من غصن يلاعب عطفه % وبدر يناغي جيده الشهب طلعا % % 12(@)(@@) % تجلى لنا والبين زمت ركابه % فشيعه أرواحنا حين ودعا % % 13(@)(@@) % وشيب بكاء بابتسام ، وأدميت % مسالك أنفاس يقومن أضلعا % % 14(@)(@@) % ولما تعانقنا فذابت عقوده % بحر الجوى ، صارت ثغورا وأدمعا % % 15(@)(@@) % ألا بأبي أسد الحمى وظباؤه % ومنعرج الوادي مصيفا ومربعا % % 16(@)(@@) % أجر به ذيل الشباب ، وأرتدي % % بأسحم فينان الذوائب أفرعا % % 17(@)(@@) % معي كل فضفاض الرداء سميدع % أصاحب منه في الوقائع أروعا % % 18(@)(@@) % غذته ربا نجد فشب كأنه % شبا مشرفي يقطر السم منقعا % % 19(@)(@@) % يريق إذا ارتج الندي بمنطق % كلاما كأن الشيح منه تضوعا % % 20(@)(@@) % ويروي أنابيب الرماح بمأزق % يظل غداة الروع بالدم مترعا % % PageV01P178 21(@)(@@) % عركت ذنوب الحادثات بجنبه % فهب مشيحا لا يلائم مضجعا % % 22(@)(@@) % وما علقت حرب تلقح للردى % % بأصبر منه في اللقاء وأشجعا % % 23(@)(@@) % أهبت ، وصرف الدهر يحرق نابه % به آمنا أن أستقيم ويظلعا % % 24(@)(@@) % فأقبل كابن الغاب ، عبلا تليله % ولم يستلنه القرن ليتا وأخدعا % % 25(@)(@@) % يريك الربا للأعوجية سجدا % وهام العدا للمشرفية ركعا % % 26(@)(@@) % فسكن روعي ، والرماح تزعزعت % % وخفض جأشي ، والعجاج ترفعا % % 27(@)(@@) % ولما رآني في تميم على شفا % % ألاقي بجفني القذى متخشعا % % 28(@)(@@) % قضى عجبا مني ومنهم ، وبيننا % % شوافع لا يرضى لها المجد مدفعا % % 29(@)(@@) % وهن القوافي تذرع الأرض شردا % بشعر إذا ما أبطأ الريح أسرعا % % 30(@)(@@) % يروح لها رب الفصاحة تابعا % ويغدو بها ترب السماحة مولعا % % PageV01P179 31(@)(@@) % ولم أستفد من نظمها غير حاسد % إذا مارمى لم يبق في القوس منزعا % % 32(@)(@@) % وما أنا 
ms57	 ممن يملأ الهول صدره % وإن عضه ريب الزمان فأوجعا % % 33(@)(@@) % إذا ما غسلت العار عني لم أبل % نداء زعيم الحي بشر أو نعى % % 34(@)(@@) % لعز على الأشراف من آل غالب % خدود غطاريف توسدن أذرعا % % 35(@)(@@) % ننادي أمير المؤمنين ، ودونه % أعاد يزجون العقارب لسعا % % 36(@)(@@) % أيا خير من لاذ القريض بسيبه % وأعنق مدحي في ذراه وأوضعا % % 37(@)(@@) % تناط بك الآمال والخطب فاغر % وتستمطر الجدوى إذا المزن أقلعا % % 38(@)(@@) % وتغضي لك الأبصار رعبا ، وتنثني % % إليك الهوادي طائعات وخضعا % % 39(@)(@@) % بحيث رأينا العز تندى ظلاله % ومجدك ملتف الغدائر أتلعا % % 40(@)(@@) % وأنت الإمام المستضاء بنوره % إذا الليل لم يلفظ سنا الصبح أدرعا % % PageV01P180 41(@)(@@) % أعني على دهر تكاد خطوبه % تبلغ من يضرر بنا ما توقعا % % 42(@)(@@) % فقد هد ركني العدو ، ولم يكن % يحاول فينا قبل ذلك مطمعا % % 43(@)(@@) % أفي الحق أن يسترقع العز وهيه % وأن أتردى بالهوان وأضرعا % % 44(@)(@@) % ويرتع في عرضي ويقبل قوله % ولو رد عنه لم يجد فيه مرتعا % % 45(@)(@@) % أما والمطايا جائلات نسوعها % % من الضمر حتى خالها الركب أنسعا % % 46(@)(@@) % ضربن إلى البيت العتيق ، ولم تقل % لناحية منهن إذ عثرت : لعا % % 47(@)(@@) % لقد طرقتني النائبات بحادث % لوان الصفا يرمى به لتصدعا % % 48(@)(@@) % ولست وإن عض الزمان بغاربي % % أطيل على الضراء مبكى ومجزعا % % 49(@)(@@) % إذا ما أغام الخطب لم أحتفل به % وضاجعت فيه الصبر حتى تقشعا % % 50(@)(@@) % أراع ولم أذنب ، وأجفى ولم أخن % وقد صدق الواشي فأخنى وأقذعا % % PageV01P181 51(@)(@@) % ومنكم عهدنا الورد زرقا جمامه % رحيب مندى العيس ، والروض % 52(@)(@@) % فعطفا علينا ، إن فينا لماجد % يراقب أعقاب الأحاديث ، مصنعا % % PageV01P182 البحر : بسيط تام 1(@)(@@) % وغادة لو رأتها الشمس ما طلعت % والريم أغضى ، وخوط البان لم يمس % 2(@)(@@) % عانقتها برداء الليل مشتملا % حتى انتبهت ببرد الحلي في الغلس % 3(@)(@@) % فبت أحميه خوفا أن ينبهها % % وأتقى أن أذيب العقد بالنفس % PageV01P183 البحر : كامل تام 1(@)(@@) % لك من غليل صبابتي ما أضمر % وأسر من ألم الغرام وأظهر % 2(@)(@@) % وتذكري زمن العذيب يشفني % % والوجد ممنو به المتذكر % 3(@)(@@) % إذ لمتي 
ms58	 سحماء مد على التقى % % أظلالها ورق الشباب الأخضر % 4(@)(@@) % هو ملعب شرقت بنا أرجاؤه % إذ نحن في حلل الشبيبة نخطر % 5(@)(@@) % فبحر أنفاسي وصوب مدامعي % % أضحت معالمه تراح وتمطر % 6(@)(@@) % وأجيل في تلك المعاهد ناظري % % فالقلب يعرفها وطرفي ينكر % 7(@)(@@) % وأرد عبرتي الجموح لأنها % % بمقيل سرك في الجوانح تخبر % 8(@)(@@) % فأبيت محتضن قلق الحشى % % وأظل أعذل في هواك وأعذر % 9(@)(@@) % غضبت قريش إذ ملكت مقادتي % % غضبا يكاد السم منه يقطر % 10(@)(@@) % وتعاودت عذلي فما أرعيتها % % سمعا يقل به الملام ويكثر % PageV01P184 11(@)(@@) % ولقد يهون على العشيرة أنني % % أشكو الغرام فيرقدون وأسهر % 12(@)(@@) % وبمهجتي هيفاء يرفع جيدها % % رشأ ، ويخفض ناظريها جؤذر % 13(@)(@@) % طرقت وأجفان الوشاة على الكرى % % تطوى ، وأردية الغياهب تنشر % 14(@)(@@) % والشهب تلمع في الدجى كأسنة % زرق يصافحها العجاج الأكدر % 15(@)(@@) % فنجاد سيفي مس ثني وشاحها % % بمضاجع كرمت وعف المئزر % 16(@)(@@) % ثم افترقنا والرقيب يروع بي % % أسدا يودعه غزال أحور % 17(@)(@@) % والدر ينظم ، حين يضحك ، عقده % وإذا بكيت فمن جفوني ينثر % 18(@)(@@) % فوطئت خد الليل فوق مطهم % هوج الرياح وراءه تستحسر % 19(@)(@@) % طرب العنان ، كأنه في حضره % نار بمعترك الجياد تسعر % 20(@)(@@) % والعز يلحفني وشائع برده % حلق الدلاص وصارمي والأشقر % PageV01P185 21(@)(@@) % وعلام أدرع الهوان وموئلي % % خير الخلائف أحمد المستظهر % 22(@)(@@) % هو غرة الزمن الكثير شياته % زهي السرير به وتاه المنبر % 23(@)(@@) % وله كما اطردت أنابيب القنا % % شرف وعرق بالنبوة يزخر % 24(@)(@@) % وعلا ترف على التقى ، وسماحة % علق الرجاء بها ، وبأس يحذر % 25(@)(@@) % لا تنفع الصلوات من هو ساحب % ذيل الضلال ، وعن هواه أزور % 26(@)(@@) % ولو استميلت عنه هامة مارق % لدعا صوارمه إليها المغفر % 27(@)(@@) % فعفاته حيث الغنى يسع المنى % % وعداته حيث القنا يتكسر % 28(@)(@@) % وبسيبه وبسيفه أعمارهم % في كل معضلة تطول وتقصر % 29(@)(@@) % وكأنه المنصور في عزماته % ومحمد في المكرمات وجعفر % 30(@)(@@) % وإذا معد حصلت أنسابها % % فهم الذرا والجوهر المتخير % PageV01P186 31(@)(@@) % ولهم وقائع في العدا مذكورة % تروي الذئاب حديثها والأنسر % 32(@)(@@) % والسمر في اللبات راعفة دما % والبيض يخضبها النجيع الأحمر % 33 
ms59	(@)(@@) % والقرن يركب ردعه ثمل الخطا % % والأعوجية بالجماجم تعثر % 34(@)(@@) % ودجا النهار من العجاج ، وأشرقت % فيه الصوارم ، وهو ليل مقمر % 35(@)(@@) % يابن الشفيع إلى الحيا ما لامرىء % طامنت نخوته المحل الأكبر % 36(@)(@@) % أنا غرس أنعمك التي لا تجتدى % % معها السحائب ، فهي منها أغزر % 37(@)(@@) % والنجح يضمنه لمن يرتادها % % منك الطلاقة والجبين الأزهر % 38(@)(@@) % وإن اقتربت أو اغتربت فإنني % % لهج بشكر عوارف لا تكفر % 39(@)(@@) % وعلاك لي في ظلها ما ابتغي % منها ، ومن كلمي لها ما يذخر % 40(@)(@@) % يسدي مديحك هاجسي ، وينيره % فكري ، وحظي في امتداحك أوفر % PageV01P187 41(@)(@@) % بغداد أيتها المطي ، فواصلي % % عنقا تئن له القلاص الضمر % 42(@)(@@) % إني وحق المستجن بطيبة % كلف بها وإلى ذراها أصور % 43(@)(@@) % وكأنني ، مما تسوله المنى % % والدار نازحة ، إليها أنظر % 44(@)(@@) % أرض تجر بها الخلافة ذيلها % % وبها الجباه من الملوك تعفر % 45(@)(@@) % فكأنها جليت علينا جنة % وكأن دجلة فاض فيها الكوثر % 46(@)(@@) % وهواؤها أرج النسيم ، وتربها % % مسك تهاداه الغدائر أذفر % 47(@)(@@) % يقوى الضعيف بها ، و يأمن خائف % قلقت وسادته ، ويثري المقتر % 48(@)(@@) % فصددت عنها إذ نباني معشري % % وبغى علي من الأراذل معشر % % 49(@)(@@) % من كل ملتحف بما يصم الفتى % % يؤذي ويظلم أو يخون ويغدر % 50(@)(@@) % فنفضت منه يدي مخافة كيده % إن الكريم على الأذى لا يصبر % PageV01P188 51(@)(@@) % وأبى لشعري أن أدنسه بهم % حسبي ، وسب ذوي الخنا أن يحقروا % % 52(@)(@@) % قابلت سيء ما أتوا بجميل ما % % آتي ، فإني بالمكارم أجدر % 53(@)(@@) % وأباد بعضهم المنون ، وبعضهم % في القد ، وهو بما جناه أبصر % 54(@)(@@) % والأبيض المأثور يخطم بالردى % % من لا ينهنهه القطيع الأسمر % 55(@)(@@) % فارفض شملهم ، وكم من مورد % للظالمين وليس عنه مصدر % 56(@)(@@) % وإلى أمير المؤمنين تطلعت % مدح كما ابتسم الرياض تحبر % 57(@)(@@) % ويقيم مائدهن ليل مظلم % ويضم شاردهن صبح مسفر % 58(@)(@@) % فبمثل طاعته الهداية تبتغي % % وبفضل نائله الخصاصة تجبر % PageV01P189 البحر : بسيط تام 1(@)(@@) % النجح تحت خطا المهرية النجب % والعز فوق ظبا الهندية القضب % 2(@)(@@) % والعزم يوقظ داعي الحزم نائمه % وهل تدور الرحى إلا على القطب % 3(@)(@@) % فما 
ms60	 الثواء بأرض للمقيم بها % % إلى الهوينى حنين الوله السلب % 4(@)(@@) % أقذى الزمان بها شربي ورنقه % ماذا تريد الليالي من فتى غرب % 5(@)(@@) % متى أروي غليل السمر من ثغر % يمدن فيهن كالأشطان في القلب % 6(@)(@@) % فهن أزوين إبلي والمياه دم % وقد توشحت الغدران بالعشب % 7(@)(@@) % أزهى بنفسي وإن أصبحت في مضر % ألوي على العز من بيتي قوى الطنب % 8(@)(@@) % فالعود من حطب لولا روائحه % والنخل تكرم للأثمار لا العسب % 9(@)(@@) % وقد جعلت مراد الطرف غير مها % يهززن في المشي أغصانا على كثب % 10(@)(@@) % إن العيون عن العلياء نابية % ومسرح العين مني مسبح الشهب % PageV01P190 11(@)(@@) % هي التي لا تزال الدهر ناظرة % إلى علا ولسؤال وفي كتب % 12(@)(@@) % وقد شكت فشفاها الله وارتجعت % لحظا أحد من المأثورة الرسب % 13(@)(@@) % والشمس ترنو بعين لا يغيض من % أنوارها ما يواريها من السحب % 14(@)(@@) % والمشرفية لا تنبو مضاربها % % فيها المضاء وإن ردت إلى القرب % 15(@)(@@) % فأصبح المجد مسرورا بعافية % ألاعب الظل في أثوابها القشب % 16(@)(@@) % وأشرق الدهر حتى خلت صفحته % تقد من وجنات الخرد العرب % PageV01P191 البحر : طويل 1(@)(@@) % تراءت لنا ، والبدر وهنا ، على قدر % فحطت لثام الليل عن غرة الفجر % 2(@)(@@) % بدت إذ بدا ، والحلي عقد ومبسم % وليس له حلي سوى الأنجم الزهر % 3(@)(@@) % فقلت لصحبي والمطي كأنها % % فطا بجنوب القاع من بلد قفر % 4(@)(@@) % أأحلاهما في صفحة الليل منظرا % أميمة أم رأي المحب ، فلا أدري % % 5(@)(@@) % أجل هي أبهى ، أين للبدر زينة % كعقدين من نحر وعقدين من ثغر % 6(@)(@@) % مهفهفة كالريم ترسل نظرة % بها تنفث الحسناء في عقد السحر % 7(@)(@@) % بنجلاء تشكو سقمها وهو صحة % إذا نظرت لا تستقل من الفتر % 8(@)(@@) % كأني غداة البين من روعة النوى % % أقلب أحناء الضلوع على الجمر % 9(@)(@@) % نأت بعدما عشنا جميعا بغبطة % وأي وصال لم يرع فيه بالهجر % 10(@)(@@) % إذا ابتسمت عجبا بكيت صبابة % فمن لؤلؤ نظم ومن لؤلؤ نثر % PageV01P192 11(@)(@@) % يذكرنيها البرق حين أشيمه % وإن عن خشف بت منها على ذكر % 12(@)(@@) % وهبني لا أرمي بطرفي إليهما 