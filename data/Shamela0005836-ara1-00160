ms159	 الحارث بن هشام قال البخاري لا يصح حديثه(@)(@@)(@@)(@@) | 3118 - (@)(@@) عبد الله بن أبي بكر المقدمي أخو محمد عن جعفر بن سليمان ضعفوه(@)(@@)(@@)(@@) | 3119 - (@)(@@) عبد الله بن بكير الغنوي الكوفي عن ابن سوقه حديثه منكر وقبله بعضهم وقال أبو حاتم كان من عتق الشيعة(@)(@@)(@@)(@@) | 3120 - (@)(@@) عبد الله بن ثابت يروي عن محمد بن حمير مجهول(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3121 - (@)(@@) عبد الله بن ثابت المروزي النحوي معاصر لمالك فيه جهالة(@)(@@)(@@)(@@) | 3122 - (@)(@@) عبد الله بن جابر بن ربيعة يروي عنه أبو نعيم ضعفه ابن معين(@)(@@)(@@)(@@) | 3123 - (@)(@@) عبد الله بن جبير الخزاعي تابعي مجهول(@)(@@)(@@)(@@) | 3124 - (@)(@@) عبد الله بن جراد مجهول ولا يصح حديثه لأنه من رواية يعلى بن الأشدق عنه(@)(@@)(@@)(@@) | 3125 - (@)(@@) عبد الله بن جرير عن ابن نمير قدري داعية(@)(@@)(@@)(@@) | 3126 - (@)(@@) عبد الله بن جرير السعدي عن عبد الله بن نمير موضوع(@)(@@)(@@)(@@) | 3127 - (@)(@@) ت ق(@)(@@) عبد الله بن جعفر بن نحيح والد علي بن المديني اتفقوا على ضعفه(@)(@@)(@@)(@@) | 3128 - (@)(@@) م متابعه عه(@)(@@) عبد الله بن جعفر المخرمي المدني ثقة وهاه ابن حبان فقط وقال ابن معين صدوق وليس بثبت(@)(@@)(@@)(@@) | 3129 - (@)(@@) عبد الله بن جعفر أخو إسماعيل مدني أيضا قال ابن معين ليس بشيء(@)(@@)(@@)(@@) | 3130 - (@)(@@) عبد الله بن جعفر الثعلبي شيخ لابن المظفر متهم جاء بخبر من لم يقل علي خير البشر فقد كفر بسند ينفرد به(@)(@@)(@@)(@@) | 3131 - (@)(@@) د(@)(@@) عبد الله بن أبي جعفر الرازي عن أبيه وغيره ليس بحجة(@)(@@)(@@)(@@) | 3132 - (@)(@@) عبد الله بن الحارث الصنعاني عن عبد الرزاق كذاب(@)(@@)(@@)(@@) | 3133 - (@)(@@) عبد الله بن حاضر بن عبدوس قال الدارقطني ليس بالقوي له عن الأنصاري وقيل اسم جده عبد القدوس(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3134 - (@)(@@) عبد الله بن الحسن بن غالب عن البغوي ليس بثقة(@)(@@)(@@)(@@) | 3135 - (@)(@@) عه(@)(@@) عبد الله بن الحسين أبو حريز قاضي سجستان مختلف فيه قال أبو داود حديثه ليس بشيء(@)(@@)(@@)(@@) | 3136 - (@)(@@) عبد الله بن الحسين بن جابر المصيصي قال ابن حبان كان يسرق الأخبار(@)(@@)(@@)(@@) | 3137 - (@)(@@) ق(@)(@@) عبد الله بن الحسين بن عطاء بن يسار قال أبو زرعة ضعيف له عن 
ms160	 سهيل(@)(@@)(@@)(@@) | 3138 - (@)(@@) عبد الله بن الحسين بن عبد الله أبو القاسم ابو رواحة مكثر عن السلفي وسماعه صحيح لكنه متهم في الشهادات(@)(@@)(@@)(@@) | 3139 - (@)(@@) عبد الله بن الحسين أبو أحمد السامري المقريء واه لا يعتمد على قوله(@)(@@)(@@)(@@) | 3140 - (@)(@@) عبد الله بن حشرج عن ابيه لا يعرف من هو(@)(@@)(@@)(@@) | 3141 - (@)(@@) عبد الله بن حفص بن عمر عن ابيه عن جده قال ابن معين ليس بشيء(@)(@@)(@@)(@@) | 3142 - (@)(@@) عبد الله بن حفص لا يعرف(@)(@@)(@@)(@@) | 3143 - (@)(@@) عبد الله بن حفص الوكيل لقيه ابن عدي وقال كان يضع الحديث(@)(@@)(@@)(@@) | 3144 - (@)(@@) عبد الله بن حكيم ابو بكر الداهري عن التابعين واه متهم بالوضع(@)(@@)(@@)(@@) | 3145 - (@)(@@) عبد الله بن حكيم بن جبير الاسدي في زمن هشيم رافضي غال كأبيه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3146 - (@)(@@) عبد الله بن حكيم الشامي عن محمد بن عمرو لا يعرف ذكره العقيلي(@)(@@)(@@)(@@) | 3147 - (@)(@@) عبد الله بن حكيم بالتصغير الكناني عن بشر بن قدامة مجهول(@)(@@)(@@)(@@) | 3148 - (@)(@@) عبد الله بن حيدر القزويني الفقيه له اربعون لقي زاهرا الشحامي اتهمه ابن الصلاح(@)(@@)(@@)(@@) | 3149 - (@)(@@) عبد الله بن خالد بن سلمة المحزومي عن ابيه ضعفوه(@)(@@)(@@)(@@) | 3150 - (@)(@@) ق(@)(@@) عبد الله بن خراش بن حوشب عن عمه العوام ضعفه الدارقطني(@)(@@)(@@)(@@) | 3151 - (@)(@@) عبد الله بن خلج الصنعاني عن وهب ضعفه هشام بن يوسف(@)(@@)(@@)(@@) | 3152 - (@)(@@) عبد الله بن خلف الطفاوي عن هشام بن حسان تكلم فيه العقيلي(@)(@@)(@@)(@@) | 3153 - (@)(@@) عه(@)(@@) عبد الله بن الخليل الحضرمي عن زيد بن ارقم في القرعة قال البخاري لا يتابع عليه(@)(@@)(@@)(@@) | 3154 - (@)(@@) عبد الله بن خيران البغدادي عن شعبة قال العقيلي لا يتابع على حديثه يعني من حيث السند وقبله غيره(@)(@@)(@@)(@@) | 3155 - (@)(@@) ت(@)(@@) عبد الله بن داود الواسطي التمار عن حنظلة بن ابي سفيان ضعفوه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3156 - (@)(@@) عبد الله بن داهر الرازي الاحمري عن ابيه رافضي ضعفوه(@)(@@)(@@)(@@) | 3157 - (@)(@@) عبد الله بن دكين ابو عمر الكوفي معاصر لشعبة وثقه جماعة وضعفه ابو زرعة(@)(@@)(@@)(@@) | 3158 - (@)(@@) ع(@)(@@) عبد الله بن دينار مولى ابن عمر ثقة ثبت تفرد بحديث الولاء عن ابن عمر قال العقيلي في رواية المشايخ 