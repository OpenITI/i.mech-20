ms1141	 سمرة - رضي الله عنه - | قال سمعت رسول الله - [ & ] - يقول : ' إن بين يدي | الساعة كذابين ' قال سماك : سمعت أبي يقول : احذروهم . | PageV10P176 |(@)(@@) 4253 - حدثنا محمد بن المثنى قال : نا أبو داود قال : نا شعبة عن | سماك عن جابر بن سمرة - رضي الله عنه - قال كانت صلاة رسول الله | - [ & ] - قصدا وخطبته قصدا . | PageV10P177 |(@)(@@) 4254 - حدثنا محمد بن المثنى ومحمد بن بشار قالا نا محمد بن | جعفر قال : نا شعبة عن سماك عن جابر بن سمرة - رضي الله عنه - | قال : قال رسول الله - [ & ] - : ' ليفتحن ناس من أمتي | كنوز كسرى الأبيض ' . |(@)(@@) 4255 - حدثنا محمد بن بشار قال : نا أبو داود قال : نا سليمان بن | معاذ عن سماك عن جابر بن سمرة - رضي الله عنه - قال : قال رسول | PageV10P178 | الله - [ & ] - : ' إني لأعلم حجرا بمكة كان يسلم علي | حين بعثت ' . |(@)(@@) 4256 - حدثناه أحمد بن منصور قال : نا يحيى بن أبي بكير قال : نا | إبراهيم بن طهمان عن سماك عن جابر بن سمرة عن النبي - [ & ] - | نحوه . | PageV10P179(@)(@@) وهذا الحديث لا نعلم أحدا حدث به عن سماك إلا إبراهيم وسليمان | ابن معاذ . |(@)(@@) 4257 - حدثنا العباس بن عبد العظيم قال : نا عمرو بن طلحة قال : نا | أسباط بن نصر عن سماك - يعني - ابن حرب عن جابر بن سمرة - رضي | الله عنه - قال : صليت مع النبي - [ & ] - صلاة الأولى ، ثم خرج | إلى أهله فاستقبله ولدان أهل المدينة فجعل يمسح خد أحدهم ، فأما أنا فمسح | خدي ، فوجدت برد يده وريحا ، كأنما كانت في جؤنة عطار . |(@)(@@) 4258 - حدثناه عبد الله بن الحارث المروزي قال : نا عبد الله بن | عثمان قال : حدثني أبي عن شعبة عن سماك عن جابر بن سمرة عن | PageV10P180 | النبي - [ & ] - بنحوه .(@)(@@) وهذا الحديث لا نعلم أحدا حدث به عن شعبة إلا عثمان بن جبلة | ولا نعلم حدث به غير شعبة إلا أسباط بن نصر . |(@)(@@) 4259 - حدثنا معاذ بن شعبة قال : نا شريك عن سماك بن | حرب عن جابر بن سمرة - رضي الله عنه - أن النبي - [ & ] - | رجم يهوديا ويهودية .(@)(@@) وهذا الحديث لا نعلم أحدا رواه عن 
ms1142	 سماك إلا شريك . |(@)(@@) 4260 - حدثنا محمد بن المثنى قال : نا عبد الرحمن بن مهدي عن | حماد ابن سلمة عن سماك عن جابر بن سمرة - رضي الله عنه - أن | PageV10P181 | النبي - [ & ] - كان يقرأ في الظهر والعصر ب ^ ( سبح اسم | ربك الأعلى ) ^ و ^ ( هل أتاك حديث الغاشية ) ^ .(@)(@@) وهذا الحديث لا نعلم أحدا رواه عن سماك إلا حماد بن سلمة . |(@)(@@) 4261 - حدثنا محمد بن المثنى قال : نا هشام بن عبد الملك قال : نا | حماد بن سلمة عن سماك عن جابر بن سمرة - رضي الله عنه - أن النبي | - [ & ] - كان يصلي الظهر إذا دحضت الشمس . | PageV10P182(@)(@@) قال أبو بكر وهذا الحديث لا نعلم أحدا يرويه عن سماك إلا حماد | ابن سلمة . |(@)(@@) 4262 - حدثنا يوسف بن موسى وأحمد بن منصور قالا نا عبيد الله | ابن موسى قال أنا الحسن بن صالح عن سماك عن جابر بن سمرة | - رضي الله عنه - أن رسول الله - [ & ] - لم يمت حتى كان | أكثر صلاته جالسا .(@)(@@) وهذا الحديث لا نعلم أحدا يرويه عن سماك إلا الحسن بن صالح . |(@)(@@) 4263 - حدثنا محمد بن [ 224 ] المثنى وعمرو بن علي قالا نا أبو | PageV10P183 | داود قال : نا شريك عن سماك عن جابر بن سمرة - رضي الله عنه - | قال كان النبي - [ & ] - لا يؤذن له في العيدين . |(@)(@@) 4264 - حدثنا عمرو بن علي قال : نا أبو داود قال : نا شريك | عن سماك عن جابر بن سمرة - رضي الله عنه - قال كان بلال لا يخرم | عن الوقت وربما أخر الإقامة شيئا . | PageV10P184 |(@)(@@) 4265 - حدثنا محمد بن إسماعيل البخاري قال : نا عبد الرحمن بن | شريك عن أبيه عن سماك عن جابر بن سمرة عن النبي - [ & ] - | في ليلة القدر ' أنها ليلة ريح وقطر ' . |(@)(@@) 4266 - حدثنا أحمد بن منصور قال : نا عبد الرحمن بن شريك | عن أبيه عن سماك بن حرب عن جابر بن سمرة - رضي الله عنه - قال : | قال رسول الله - [ & ] - : ' التمسوا ليلة القدر في العشر | الأواخر من رمضان فإني قد رأيتها فنسيتها وهي ليلة مطر أو ريح ' أو | PageV10P185 | قال : ' قطر وريح ' .(@)(@@) وهذا الحديث لا 
ms1143	 نعلم أحدا يرويه عن سماك إلا شريك ولا نعلم | أحدا يرويه بهذا اللفظ عن شريك إلا عبد الرحمن بن شريك عن أبيه . |(@)(@@) 4267 - حدثنا محمد بن بشار قال : نا أبو داود قال : نا شريك | عن سماك عن جابر بن سمرة - رضي الله عنه - عن النبي - [ & ] - | قال : ' التمسوا ليلة القدر في العشر الأواخر من رمضان ' . |(@)(@@) 4268 - حدثنا معاذ بن شعبة قال : نا شريك عن سماك عن | جابر ابن سمرة - رضي الله عنه - قال : كان أصحاب رسول الله - [ & ] - | يذكرون عنده الشعر ويتناشدونه بينهم وربما تبسم النبي | - [ & ] - . | PageV10P186(@)(@@) وهذا الحديث لا نعلم أحدا يرويه عن سماك إلا شريك . |(@)(@@) 4269 - حدثنا أبو كامل قال : نا أبو عوانة عن سماك عن | جابر بن سمرة - رضي الله عنه - أن قوما مات لهم بغل ، ولم يكن لهم شيء | يأكلونه ، فجاءوا إلى النبي - [ & ] - فرخص لهم فيه . |(@)(@@) 4270 - حدثنا عبد الله بن جعفر البرمكي قال : نا عبيد الله بن | موسى قال : نا إسرائيل عن سماك عن جابر بن سمرة - رضي الله | PageV10P187 | عنه - أن رسول الله - [ & ] - قال : ' إن الشيطان عرض لي | فجعل يلقي علي شرر النار ؛ فلولا دعوة أخي سليمان أخذته ' .(@)(@@) وهذا الحديث لا نعلم أحدا يرويه عن سماك إلا إسرائيل . |(@)(@@) 4271 - حدثنا العباس بن محمد البغدادي قال : نا إسحاق بن | منصور قال : نا إسرائيل عن سماك عن جابر بن سمرة - رضي الله | عنه - قال كان بلال يؤذن ، ثم يمهل فإذا رأى النبي - [ & ] - | أخذ في الإقامة .(@)(@@) وهذا الحديث لا نعلم أحدا يرويه عن سماك إلا إسرائيل . | PageV10P188 |(@)(@@) 4272 - حدثنا أحمد بن منصور بن سيار قال : نا إسحاق بن | منصور السلولي قال : نا إسرائيل عن سماك عن جابر بن سمرة - رضي | الله عنه - قال : رأيت رسول الله - [ & ] - متكئا على | وسادة على يساره .(@)(@@) وهذا الحديث إنما اختصر من حديث جابر بن سمرة أن النبي - [ & ] - | أتي بماعز ليرجمه فزاد إسرائيل هذا الحرف فيه فكتب من | أجل الزيادة وإلا فإن حديث جابر بن سمرة في رجم ماعز ، رواه شعبة | وإسرائيل وأبو عوانة . |(@)(@@) 4273 - حدثنا أحمد بن 
ms1144	 منصور قال : نا عبد الله بن صالح بن | مسلم العجلي قال : نا ناصح أبو عبد الله عن سماك عن جابر بن سمرة | - رضي الله عنه - قال كان النبي - [ & ] - إذا كان يوم الفطر | PageV10P189 | أكل قبل أن يخرج سبع تمرات وإذا كان يوم الأضحى لم يطعم شيئا حتى | يرجع .(@)(@@) وهذا الحديث لا نعلمه يروى عن جابر بن سمرة إلا من هذا الوجه | ولا نعلم رواه عن سماك إلا ناصح أبو عبد الله وهو لين الحديث وإنما | يكتب من حديثه ما لم يروه غيره . |(@)(@@) 4274 - حدثنا العباس بن جعفر قال : نا إسحاق بن منصور قال : | نا ناصح أبو عبد الله عن سماك عن جابر بن سمرة - رضي الله عنه - عن | النبي - [ & ] - قال : ' لأن يؤدب أحدكم ولده خير له من | أن يتصدق كل يوم بنصف صاع ' . | PageV10P190(@)(@@) وهذا الحديث لا نعلم أحدا يرويه عن سماك إلا ناصح . |(@)(@@) 4275 - حدثنا أحمد بن منصور قال : نا عبد الله بن مسلم قال : نا | أبو عبد الله عن سماك بن حرب عن جابر بن سمرة - رضي الله عنه - | قال كفن رسول الله - [ & ] - في ثلاثة أثواب بيض وإزار | ولفافة وكفن عمر في ثوبين .(@)(@@) وهذا الحديث لا نعلم أحدا يرويه بهذا اللفظ في كفن النبي - عليه | السلام - إلا جابر بن سمرة ولا نعلم رواه عن سماك إلا ناصح وقد تقدم | ذكرنا له . |(@)(@@) 4276 - حدثنا محمد بن الليث الهرائي قال : نا إسماعيل بن أبان | قال : نا ناصح عن سماك ، عن جابر بن سمرة - رضي الله عنه - قال : قلت | يا رسول الله من يحمل رايتك يوم القيامة قال : ' من يحملها في الدنيا علي | ابن أبي طالب ' . | PageV10P191(@)(@@) وهذا الحديث لا نعلم أحدا رواه عن سماك إلا ناصح . |(@)(@@) 4277 - حدثنا محمد بن جوان بن شعبة قال : نا إسماعيل بن أبان | قال : نا قيس عن سماك عن جابر بن سمرة - رضي الله عنه - قال | صعد النبي - [ & ] - المنبر فقال : ' آمين آمين آمين ' فلما | نزل سئل عن ذلك فقال : ' أتاني جبريل ، فقال : رغم أنف من أدرك | رمضان فلم 
ms1145	 يغفر له ، قل : آمين ، قلت : آمين ورغم أنف رجل ذكرت | عنده فلم يصل عليك قل : آمين ، فقلت آمين ورغم أنف رجل أدرك | والديه أو أحدهما فلم يغفر له أو لا [ 225 ] يدخلانه الجنة آمين . | قلت : آمين ' . هذا أو نحوه . | PageV10P192(@)(@@) وهذا الحديث لا نعلمه يروى عن جابر بن سمرة إلا من هذا الوجه | ولا نعلم أحدا رواه عن سماك إلا قيس ولا نعلم أحدا رواه عن قيس إلا | إسماعيل بن أبان . |(@)(@@) 4278 - حدثنا محمد بن المثني قال : نا أبو داود قال : نا زهير يعني | ابن معاوية عن سماك عن جابر بن سمرة - رضي الله عنه - أن رجلا قتل | نفسه بمشاقص فلم يصل النبي عليه .(@)(@@) وهذا الحديث لا نعلم يروى عن النبي - [ & ] - إلا | من هذا الوجه من حديث جابر بن سمرة عنه وإنما ترك النبي - [ & ] - | الصلاة عليه عندنا - والله أعلم - عقوبة لئلا يعود غيره | PageV10P193 | فيصنع مثل ذلك بنفسه . |(@)(@@) 4279 - حدثنا أحمد بن منصور قال : نا أبو النضر هاشم بن | القاسم قال : نا أبو خيثمة يعني زهير بن معاوية قال : نا زياد بن خيثمة | عن الأسود ابن سعيد الهمداني عن جابر بن سمرة - رضي الله عنه - قال : | قال رسول الله - [ & ] - : ' يكون من بعدي اثنا عشر | خليفة كلهم من قريش ' ، ثم رجع إلى بيته فأتيته فقلت : ثم يكون ماذا ؟ | قال : ' ثم يكون الهرج ' . |(@)(@@) 4280 - حدثنا عباد بن يعقوب قال : نا حاتم بن إسماعيل قال : | نا المهاجر بن مسمار عن عامر بن سعد ، عن جابر بن سمرة عن النبي | - [ & ] - . | PageV10P194 |(@)(@@) 4281 - وحدثناه نصر بن علي قال أنا يزيد بن زريع قال أنا ابن | عون عن الشعبي عن جابر بن سمرة عن النبي - [ & ] - | بنحو حديث الأسود بن سعيد إلا أنه لا أحفظ في حديثهما ' ثم يكون | الهرج ' .(@)(@@) ولا نعلم روى عامر بن سعد عن جابر بن سمرة إلا هذا الحديث | PageV10P195 | ولا روى الشعبي عن جابر بن سمرة إلا هذا الحديث وقد رواه زياد بن | علاقة عن جابر بن سمرة أيضا . |(@)(@@) 4282 - حدثنا صفوان بن المغلس قال : نا 
ms1146	 بكر بن خداش قال : | نا حرب بن خالد بن جابر بن سمرة عن أبيه عن جده - رضي الله عنه - | قال : قال رسول الله - [ & ] - : ' من أكل من هذه البقلة | المنكرة ' - يعني الثوم - ' فليجلس في بيته ' .(@)(@@) وهذا الحديث لا نعلمه يروى بهذا اللفظ عن جابر بن سمرة إلا من | هذا الوجه ولا نعلمه يروى أيضا بهذا اللفظ عن غير جابر بن سمرة . |(@)(@@) 4283 - حدثنا صفوان بن المغلس قال : نا بكر بن خداش قال : | نا حرب بن خالد بن جابر بن سمرة عن أبيه عن جده - رضي الله عنه - | قال جاء ماعز إلى النبي - [ & ] - ، فقال : يا رسول الله | PageV10P196 | - [ & ] - إني قد زنيت فأعرض عنه بوجهه ، ثم جاءه من | قبل وجهه فأعرض عنه فجاءه الثالثة فأعرض عنه ، ثم جاءه الرابعة فلما | قال له ذلك قال رسول الله - [ & ] - لأصحابه : ' قوموا إلى | صاحبكم فإن كان صحيحا فارجموه ' فسئل عنه فوجدوه صحيحا فرجم | فلما أصابته الحجارة حاضرهم وتلقاه رجل من أصحاب النبي - [ & ] - | بلحيي جمل فضربه به فقتله ، فقال أصحاب رسول الله | - [ & ] - إلى النار ، فقال رسول الله - [ & ] - : | ' كلا فإنه قد تاب توبة لو تابها أمة من الأمم لقبل منهم ' .(@)(@@) وهذا الحديث لا نعلمه يروى بهذا اللفظ عن جابر بن سمرة إلا من | هذا الوجه ولا عن غير جابر بن سمرة أيضا وإن كان قد روي عن جابر | بعض هذا الكلام بغير هذا اللفظ . |(@)(@@) 4284 - وحدثنا صفوان بن المغلس قال : نا بكر بن خداش قال : | نا حرب بن خالد بن جابر بن سمرة عن أبيه عن جده - رضي الله عنه | قال : قال رسول الله - [ & ] - : ' لا تزال أمتي على الحق | ظاهرين ولا يزال أمر أمتي صالحا لا يضرهم عداوة من عاداهم حتى | يليهم اثنا عشر خليفة ' ، فقال سمرة أبو جابر : ' كلهم من قريش ' قال | PageV10P197 | نعم .(@)(@@) ولا نعلم روى عن حرب بن خالد إلا بكر بن خداش . |(@)(@@) 4285 - حدثنا أحمد بن يحيى الكوفي قال : نا عمر بن حفص بن | غياث قال : نا أبو بكر بن عياش عن عبد الملك بن عمير عن 
ms1147	 جابر | ابن سمرة - رضي الله عنه - قال : قال رسول الله - [ & ] - : | ' يوشك أن تخرج الظعينة من المدينة إلى الحيرة لا تخاف أحدا ' . | PageV10P198(@)(@@) وهذا الحديث لا نعلمه يروى عن جابر بن سمرة إلا من هذا الوجه | بهذا الإسناد . |(@)(@@) 4286 - حدثنا محمد بن عبد الملك القرشي قال : نا أبو عوانة عن | عبد الملك بن عمير عن جابر بن سمرة - رضي الله عنه - قال رسول الله | - [ & ] - : ' إذا هلك كسرى فلا كسرى بعده ، وإذا | هلك قيصر فلا قيصر بعده ، والذي نفسي بيده لتنفقن كنوزهما في | سبيل الله ' . | PageV10P199 |(@)(@@) 4287 - حدثنا علي بن مسلم قال : نا محمد بن أبي عبيدة عن أبيه | عن الأعمش عن أبي خالد الوالبي عن جابر بن سمرة قال [ سمعت جابر | ابن سمرة يقول ] : أول من رمى مع النبي - [ & ] - بسهم | دما به سعد . |(@)(@@) 4288 - حدثنا أحمد بن منصور بن سيار قال : نا محمد بن القاسم | PageV10P200 | الأسدي قال : نا فطر عن أبي خالد الوالبي عن جابر بن سمرة | السوائي - سواء قيس - قال سمعت النبي - [ & ] - يقول : | ' ثلاث أخاف على أمتي : الاستسقاء بالأنواء ، وحيف السلطان ، | والتكذيب بالقدر ' .(@)(@@) وهذا الحديث لا نعلمه يروى عن جابر بن سمرة إلا من هذا الوجه | ومحمد بن القاسم لين الحديث وقد احتمل حديثه أهل العلم ورووا عنه . |(@)(@@) 4289 - حدثنا أحمد بن منصور قال : نا يزيد بن أبي حكيم قال : | نا سفيان عن الأعمش عن المسيب بن [ 226 ] رافع عن تميم بن طرفة عن | جابر بن سمرة - رضي الله عنه - أن رسول الله - [ & ] - | قال : ' ألا تصفون كما تصف الملائكة عند ربها ؟ ' قالوا : يا رسول الله | وكيف تصف الملائكة عند ربهم قال : ' يتمون الصفوف المقدمة ، | ويتراصون في الصف ' . | PageV10P201 |(@)(@@) 4290 - حدثنا عمرو بن علي قال : نا أبو معاوية عن الأعمش عن | المسيب بن رافع عن تميم بن طرفة عن جابر بن سمرة عن النبي - [ & ] - | بنحوه .(@)(@@) وهذا الكلام لا نعلم أحدا يرويه عن النبي - [ & ] - | إلا جابر بن سمرة ولا نعلم له طريقا عن جابر إلا هذا الطريق . |(@)(@@) 4291 - حدثنا أحمد بن منصور قال : نا يزيد 
ms1148	 بن أبي حكيم قال : | PageV10P202 | نا سفيان عن الأعمش عن المسيب بن رافع عن تميم بن طرفة عن جابر | ابن سمرة - رضي الله عنه - عن النبي - [ & ] - أنه دخل | المسجد فرآهم رافعي أيديهم في الصلاة فقال : ' ما لهم رافعي أيديهم كأنها | أذناب الخيل الشمس اسكنوا في الصلاة ' . | PageV10P203 |(@)(@@) 4292 - حدثنا محمد بن المثنى قال : نا أبو معاوية عن الأعمش | عن المسيب بن رافع عن تميم بن طرفة عن جابر بن سمرة عن النبي - [ & ] - | بنحوه .(@)(@@) وهذا الحديث لا نعلمه يروى عن النبي - [ & ] - إلا | برواية جابر بن سمرة عنه ومعناه عندنا أن القوم كانوا يشيرون بأيديهم | بالصلاة عن يمين وشمال ، فقال رسول الله - [ & ] - : | ' اسكنوا في الصلاة ' . |(@)(@@) 4293 - حدثنا أحمد بن عيسى الكوفي قال : نا عمر بن حفص بن | غياث قال : نا أبي قال : نا الأعمش عن أبي خالد الوالبي عن جابر | ابن سمرة أو رجل من أصحاب النبي - [ & ] - قال : كان | النبي - [ & ] - يرعى غنما ، ثم كان يرعى الإبل مع شريك | له قد اكترتهما أخت خديجة فلما قضوا السفر بقي عليهما شيء فجعل | شريكه يأتيهم فيتقاضاهم ويقول لمحمد انطلق فيقول : ' اذهب فأنت فإني | PageV10P204 | أستحي ' فقالت له مرة - يعني الشريك - وأتاهم : فأين محمد لا يجيء | معك ؟ قال : قد قلت له فذكر أنه يستحي قال : فذكرت ذلك لأختها | خديجة ، فقالت ما رأيت أحدا قط أشد حياء ولا أعف من محمد - [ & ] - ، | فوقع في نفس أختها خديجة ، فبعثت إليه ، فقالت : ائت | أبي فاخطب إليه ، فقال : ' أبوك رجل كثير المال وهو ' - أحسبه قال - ' لا | يفعل ' قالت : فانطلق ، فألق كلمة فإني أكفيك وأته عند سكره ، ففعل ، | فأتاه فزوجه فلما أصبح جلس في الناس فقيل له : قد أحسنت زوجت | محمدا ، قال : وفعلت ؟ ! قالوا : نعم فقام فدخل عليها ، فقال : إن الناس | يقولون : إني قد زوجت محمدا وما فعلت . قالت : بلى فلا تسفهن فإن | محمدا كذا وكذا ، فلم تزل به حتى رضي ، ثم بعثت إلى محمد - [ & ] - | بأوقيتين من فضة أو من ذهب فقالت : اشتر حلة فأهدها | إليه ، وكذا وكذا . قال وأحسبه فعل .(@)(@@) وهذا الحديث لا نعلمه 
ms1149	 يروى بهذا اللفظ إلا عن جابر بن سمرة ولا | نعلم أسند هذا الحديث عن جابر إلا عمر بن حفص عن أبيه عن الأعمش | عن أبي خالد عن جابر وقد رواه غير عمر بن حفص عن الأعمش عن | PageV10P205 | أبي خالد مرسلا ، وقد روي عن النبي - [ & ] - في تزويجه | خديجة أحاديث بألفاظ مختلفة نذكر كل حديث منها بلفظه في موضعه إن | شاء الله . |(@)(@@) 4294 - حدثنا أبو كريب قال : نا عثام بن علي - فيما أحسب - | عن الأعمش ، عن أبي خالد الوالبي عن جابر بن سمرة - رضي الله عنه - | أن النبي - [ & ] - قال : ' بعثت أنا والساعة كهاتين كهذه | من هذه ' .(@)(@@) وهذا الحديث رواه فطر أيضا عن أبي خالد عن جابر بن سمرة عن | النبي - [ & ] - كهذه من هذه وأشار بأصبعيه . | PageV10P206 |(@)(@@) | مسند | زيد بن أرقم | رضي الله عنه(@)(@@) | PageV10P207 | صفحة فارغة . | PageV10P208 |(@)(@@) | ما أسند زيد بن أرقم عن النبي - [ & ] -(@)(@@) 4295 - حدثنا إبراهيم بن هانئ قال : نا عفان قال : نا حماد بن | سلمة قال : أنا قيس بن سعد عن عطاء عن ابن عباس أنه قال لزيد بن | أرقم : أما علمت أن رسول الله - [ & ] - أهدى له عضو | من صيد ، وهو محرم فلم يقبله ؟ قال بلى .(@)(@@) ولا نعلم أسند ابن عباس عن زيد غير هذا الحديث . |(@)(@@) 4296 - حدثنا محمد بن المثنى قال : نا الضحاك عن ابن جريج عن | الحسن بن مسلم عن طاوس عن ابن عباس قال قدم زيد بن أرقم ، فقال | له ابن عباس يستذكره : كيف أخبرتني عن لحم الصيد الذي أهدي إلى | رسول الله - [ & ] - وهو حرام ؟ قال : نعم ، أهدي له رجل | أو عضو لحم صيد فرده ، وقال : ' إنا لا نأكله إنا حرم ' . | PageV10P209 |(@)(@@) 4297 - حدثنا محمد بن بشار قال : نا أبو داود قال : نا شعبة عن | أبي عبد الله الشامي قال سمعت معاوية يقول أخبرني الأنصاري - يعني | زيد بن أرقم - رضي الله عنه - قال : قال رسول الله - [ & ] - : | ' لا تزال طائفة من أمتي على الحق ' قال : فإني لأرجو أن | تكونوا أنتم هم يا أهل الشام .(@)(@@) قال [ 227 ] أبو بكر ولا نعلم أسند معاوية 
ms1150	 عن زيد إلا هذا | PageV10P210 | الحديث وأبو عبد الله الشامي فلم أسمع أحدا سماه ولا نعلم روى عنه إلا | شعبة . |(@)(@@) 4298 - حدثنا محمد بن المثنى قال : نا يحيى بن حماد قال : نا أبو | عوانة عن الأعمش عن حبيب بن أبي ثابت عن أبي الطفيل عن زيد بن | أرقم - رضي الله عنه - أن رسول الله - [ & ] - قال : ' من | كنت مولاه فعلي مولاه ، اللهم وال من والاه وعاد من عاداه ' . | PageV10P211 |(@)(@@) 4299 - حدثنا إبراهيم بن هانئ قال : نا علي بن حكيم قال : نا | شريك عن أبي إسحاق عن سعيد بن وهب وعن زيد بن يثيع | قالا : نشد على الناس في الرحبة من سمع رسول الله - [ & ] - | يوم غدير خم فقام ستة فشهدوا أنهم سمعوا رسول الله - [ & ] - | يقول يوم غدير خم : ' ألست أولى بالمؤمنين ' قالوا بلى قال : | ' أو لست أولى بكم من أنفسكم ' قالوا : بلى قال : ' اللهم من كنت | مولاه فعلي مولاه اللهم وال من والاه وعاد من عاداه ' . | PageV10P212 | صفحة فارغة . | PageV10P213 |(@)(@@) 4300 - قال وحدثناه إبراهيم بن هانئ قال : نا علي بن حكيم | قال : نا شريك عن الأعمش عن حبيب بن أبي ثابت عن أبي الطفيل | عن زيد بن أرقم عن النبي - [ & ] - مثله . |(@)(@@) 4301 - حدثنا عمرو بن علي قال : نا أبو معاوية قال : نا | الأعمش عن ثمامة بن عقبة عن زيد بن أرقم - رضي الله عنه - قال جاء | رجل من اليهود إلى النبي - [ & ] - ، فقال يا أبا القاسم | تزعم أن أهل الجنة يأكلون ويشربون فقال : ' والذي نفسي بيده إن | الرجل منهم ليؤتى قوة مائة رجل في الأكل والشرب والجماع | والشهوة ' قال فإن الذي يأكل ويشرب تكون له الحاجة قال : ' عرق | يفيض مثل ريح المسك فإذا كان ذلك ضمر له بطنه ' . | PageV10P214 |(@)(@@) 4302 - قال : نا الحسن بن يحيى قال : نا يعلى عن الأعمش عن | ثمامة عن زيد بن أرقم عن النبي - [ & ] - بنحوه .(@)(@@) وقال غير أبي معاوية ويعلى عن الأعمش عن يزيد بن حيان عن | زيد بن أرقم . |(@)(@@) 4303 - حدثنا يوسف بن موسى قال : نا جرير عن الأعمش | عن ثمامة بن عقبة 
ms1151	 المحلمي عن زيد بن أرقم . |(@)(@@) 4304 - وحدثناه إبراهيم بن هانئ والحسن بن يحيى قال : نا | PageV10P215 | موسى بن مسعود عن سفيان عن الأعمش عن ثمامة بن عقبة عن زيد | ابن أرقم - رضي الله عنه - قال عقد رجل من الأنصار للنبي - [ & ] - | عقدا فكان يألم ذلك فجاءه الملكان يعودانه ، فقال أحدهما | لصاحبه : تدري ما به ، عقد له فلان الأنصاري عقدا فرمى به في بئر | كذا ، وكذا فلو أخرجه فرمى به عوفي ، فبعثوا إلى البئر ، فوجدوا الماء قد | اخضر ، فأخرجوه فرموا به ، فعوفي النبي - [ & ] - فما رئي | في وجهه ولا حدث به .(@)(@@) وهذا الحديث لا نعلم أحدا يرويه عن زيد بن أرقم إلا ثمامة بن | عقبة ولا نعلم أحدا حدث به إلا الأعمش عنه ، ولا نعلم حدث الأعمش | PageV10P216 | عن ثمامة إلا هذين الحديثين . |(@)(@@) 4305 - حدثنا محمد بن عثمان بن كرامة قال : نا عبيد الله بن | موسى قال : نا إسرائيل عن السدي عن أبي سعد الأزدي قال : نا | زيد بن أرقم - رضي الله عنه - قال : غزونا مع رسول الله - [ & ] - | ومعنا ناس من الأعراب فكنا نبتدر الماء فكان الأعراب | يسبقوننا فيسبق الأعرابي أصحابه فيملأ الحوض يجعل حوله حجارة | ويجعل النطع عليه حتى يجيء أصحابه . قال : فأتى رجل من الأنصار | أعرابيا فأدخل زمام ناقته لتشرب ، فأبى أن يدعه فانتزع حجرا فغاض الماء | فرفع الأعرابي خشبة فضرب بها رأس الأنصاري فشجه ، فأتى عبد الله بن | أبي بن سلول رأس المنافقين فأخبره ، وكان من أصحابه فغضب عبد الله | ابن أبي ، وقال : لا تنفقوا على من عند رسول الله ؛ حتى ينفضوا من حوله | - يعني : الأعراب - وكانوا يحضرون رسول الله - [ & ] - | عند الطعام ، فقال عبد الله لأصحابه : إذا انفضوا من عند محمد فأتوا محمدا | بالطعام ، فليأكل هو ومن عنده ، ثم قال لأصحابه : إذا رجعتم المدينة | PageV10P217 | فليخرجن الأعز منكم الأذل . قال زيد : وأنا ردف عمي فسمعت عبد الله | ابن أبي ، وكنا أخواله فأخبرت عمي فانطلق فأخبر رسول الله - [ & ] - | فأرسل إليه رسول الله - [ & ] - فحلف | وجحد فصدقه وكذبني فجاء إلى عمي ، فقال ما أردت أن قبل 
ms1152	 رسول الله | - [ & ] - قوله وكذبك ، وكذبك المسلمون . قال : فوقع | علي من الهم ما لم يقع على أحد قط ، قال : فبينا أنا أسير مع رسول الله | - [ & ] - في سفر فأخفقت برأسي من الهم ، فأتاني رسول | الله - [ & ] - فعرك أذني وضحك في وجهي ، فما كان | يسرني أن لي بها الملك أو الدنيا ، ثم إن أبا بكر لحقني ، فقال : ما قال لك | رسول الله ؟ قلت : ما قال لي شيئا إلا أنه عرك في أذني وضحك في | وجهي ، فقال : أبشر ، ثم لحقني عمر ، فقال لي مثل قول أبي بكر ، فلما | أصبحنا قرأ رسول الله - [ & ] - سورة المنافقين . | PageV10P218 |(@)(@@) 4306 - وحدثناه محمد بن المثنى قال : نا محمد بن جعفر قال : نا | شعبة عن الحكم قال سمعت محمد بن كعب القرظي قال سمعت زيد بن | أرقم - رضي الله عنه - قال كنا مع رسول الله - [ & ] - في | غزوة ، فقال عبد الله بن أبي لئن رجعنا إلى المدينة ليخرجن الأعز [ 228 ] | منها الأذل فأتيت النبي - [ & ] - فأخبرته ، فقال لي قومي | ما أردت إلى هذا فرجعت فنمت كئيبا حزينا ، وجاء عبد الله بن أبي | فحلف فرجعت إلى النبي - [ & ] - ، فقال : ' إن الله قد | صدقك ' وأنزل الله تبارك وتعالى : ^ ( هم الذين يقولون لا تنفقوا على من | عند رسول الله حتى ينفضوا ولله خزائن السموات والأرض ولكن | المنافقين لا يفقهون ) ^ . | PageV10P219(@)(@@) وهذا الكلام لا نعلم أحدا يرويه إلا زيد بن أرقم ولا نعلم أسند | محمد بن كعب عن زيد غير هذا الحديث ولا أسند أبو سعد عن زيد غير | هذا الحديث . |(@)(@@) 4307 - حدثنا أبو كريب محمد بن العلاء قال : نا أبو معاوية | عن عاصم الأحول عن أبي عثمان وعبد الله بن الحارث عن زيد بن | أرقم - رضي الله عنه - قال ألا أعلمكم ما كان رسول الله - [ & ] - | يعلمنا ' اللهم إني أعوذ بك من العجز والكسل والبخل | والجبن والهرم وعذاب القبر ، اللهم آت أنفسنا تقواها ، أنت خير من | زكاها ، أنت وليها ومولاها ، اللهم إني أعوذ بك من قلب لا يخشع | ونفس لا تشبع وعلم لا ينفع ودعوة لا يستجاب لها ' . | PageV10P220 |(@)(@@) 4308 - وحدثناه 
ms1153	 محمد بن عبد الله القرشي قال : نا عبد الواحد بن | زياد عن عاصم الأحول عن عبد الله بن الحارث عن زيد بن أرقم | عن النبي - [ & ] - بمثله .(@)(@@) وهذا الحديث لا نعلمه يروى عن زيد بن أرقم إلا من هذا الوجه | ولا نعلم أحدا جمع أبا عثمان وعبد الله بن الحارث إلا أبو معاوية عن | عاصم . |(@)(@@) 4309 - حدثنا محمد بن المثنى قال : نا محمد بن جعفر قال : نا | شعبة عن قتادة ، عن النضر بن أنس عن زيد بن أرقم - رضي الله عنه - أن | رسول الله - [ & ] - قال : ' اللهم اغفر للأنصار ، ولأبناء | الأنصار والأبناء أبناء الأنصار ' . | PageV10P221 |(@)(@@) 4310 - وحدثنا زياد بن أيوب قال : نا هشيم عن علي بن زيد | عن النضر بن أنس أن أنس بن مالك كتب إليه زيد بن أرقم أن رسول | الله - [ & ] - قال : ' اللهم اغفر للأنصار ولأبناء الأنصار | ولأبناء أبناء الأنصار ' . |(@)(@@) 4311 - وحدثناه محمد بن يعمر قال : نا أبو داود قال شعبة عن | علي بن زيد عن النضر بن أنس عن زيد بن أرقم عن النبي - [ & ] - | بمثله . | PageV10P222(@)(@@) وهذا الحديث لا نعلم أحدا رواه عن قتادة عن النضر بن أنس عن | زيد أوثق من شعبة ، وقد تابعه على روايته غير واحد فاجتزئنا بشعبة | وخالفه معمر ، فقال عن قتادة عن النضر بن أنس ، عن أنس . |(@)(@@) 4312 - وحدثنا محمد بن المثنى قال : نا محمد بن جعفر قال : نا | شعبة عن قتادة عن النضر بن أنس عن زيد بن أرقم - رضي الله عنه - أن | رسول الله - [ & ] - قال : ' إن هذه الحشوش محتضرة فإذا | أتى أحدكم الخلاء فليقل أعوذ بالله من الخبث والخبائث ' . |(@)(@@) 4313 - وحدثنا العباس بن الوليد النرسي قال : نا يزيد بن زريع | قال : نا سعيد عن قتادة عن القاسم الشيباني عن زيد بن أرقم عن | PageV10P223 | النبي - [ & ] - بنحوه .(@)(@@) وهذا الحديث قد اختلفوا في إسناده عن قتادة ، فقال شعبة عن قتادة | عن النضر عن زيد وقال معمر عن قتادة عن النضر بن أنس عن أبيه | وقال ابن أبي عروبة عن قتادة عن القاسم بن عوف الشيباني عن زيد 
ms1154	 | وقال حسام بن مصك عن قتادة عن القاسم بن ربيعة عن زيد بن أرقم . |(@)(@@) 4314 - وحدثنا العباس بن الوليد قال : نا يزيد بن زريع قال : نا | سعيد - يعني - ابن أبي عروبة عن قتادة عن القاسم الشيباني عن زيد | ابن أرقم عن النبي - عليه السلام - . |(@)(@@) 4315 - وحدثنا محمد بن معمر قال : نا روح بن عبادة عن | PageV10P224 | سعيد عن قتادة عن القاسم الشيباني عن زيد بن أرقم - رضي الله | عنه - عن النبي - [ & ] - أنه مر بمسجد قباء فوجدهم | يصلون بعد ما أشرقت الشمس فقال : ' صلاة الأوابين كانوا يصلونها | إذا رمضت الفصال ' . |(@)(@@) 4316 - حدثنا مؤمل بن هشام قال : نا إسماعيل بن إبراهيم قال : نا | أيوب عن القاسم الشيباني عن زيد بن أرقم - رضي الله عنه - أنه رأى | قوما يصلون من الضحى في مسجد قباء ، فقال أما علموا أن الصلاة في | غير هذه الساعة أفضل إن رسول الله - [ & ] - قال : | ' صلاة الأوابين حين ترمض الفصال ' . | PageV10P225(@)(@@) وهذا الحديث بهذا اللفظ لا نعلم أحدا يرويه إلا زيد بن أرقم ولا | نعلم أحدا رواه عن زيد إلا القاسم بن عوف الشيباني . |(@)(@@) 4317 - حدثنا محمد بن عبد الرحمن ابن أخي محمد بن سواء | قال : نا محمد بن سواء ، قال : نا سعيد عن قتادة عن القاسم الشيباني | عن زيد بن أرقم - رضي الله عنه - أن رسل الله - [ & ] - | قال : ' إذا دعا الرجل امرأته فلتجب ، وإن كانت على ظهر قتب ' .(@)(@@) وهذا الحديث لا نعلم أحدا رواه بهذا اللفظ إلا زيد بن أرقم ولا | نعلم أحدا حدث به عن سعيد عن قتادة إلا محمد بن سواء . |(@)(@@) 4318 - حدثنا إبراهيم بن هانئ قال : نا عبد الله بن يزيد | الدمشقي قال : نا صدقة بن عبد الله عن سعيد بن أبي عروبة عن | PageV10P226 | قتادة عن القاسم الشيباني وهو ابن عوف عن زيد بن أرقم | - رضي الله عنه - قال بعث رسول الله - [ & ] - معاذ بن | جبل إلى الشام فلما قدم معاذ [ 229 ] قال يا رسول الله إني رأيت أهل | الكتاب يسجدون لأساقفتهم وبطارقتهم أفلا نسجد لك قال : ' لا ولو 
ms1155	 | كنت آمرا أحدا أن يسجد لأحد لأمرت المرأة أن تسجد لزوجها ' . |(@)(@@) 4319 - وحدثناه عمر بن الخطاب قال : نا أبو حفص التنيسي قال : نا | صدقة - يعني - ابن عبد الله عن سعيد بن أبي عروبة عن قتادة عن القاسم | الشيباني عن زيد بن أرقم عن النبي - [ & ] - بنحوه .(@)(@@) وهذا الحديث قد اختلف فيه عن القاسم الشيباني فقال أيوب عن | القاسم بن أبي أوفى . | PageV10P227 | وقال قتادة عن القاسم عن زيد بن أرقم وقال هشام عن القاسم | الشيباني عن عبد الرحمن بن أبي ليلى عن معاذ .(@)(@@) ولا نعلم روى هذا الحديث عن أبي عروبة إلا صدقة وصدقة ليس | بالقوي في الحديث وقد كتب أهل العلم حديثه . |(@)(@@) 4320 - حدثنا يوسف بن موسى قال : نا أبو غسان قال أسباط بن | PageV10P228 | نصر عن السدي ، عن صبيح مولى أم سلمة عن زيد بن أرقم - رضي | الله عنه - عن النبي - [ & ] - أنه قال لعلي وفاطمة والحسن | والحسين - رضي الله عنهم - : ' أنا حرب لمن حاربتم سلم لمن سالمتم ' .(@)(@@) وهذا الحديث لا نعلم أحدا رواه عن النبي - [ & ] - | إلا زيد بن أرقم ولا نعلم له طريقا عن زيد إلا هذا الطريق وصبيح مولى | أم سلمة لا نعلم حدث عنه إلا السدي . |(@)(@@) 4321 - حدثنا محمد بن المثنى قال : نا محمد بن جعفر قال : نا | شعبة عن عمرو بن مرة عن عبد الرحمن بن أبي ليلى قال : كان زيد بن | PageV10P229 | أرقم يصلي على جنائزنا فيكبر أربعا فكبر يوما خمسا فسألناه عن ذلك | فقال إن رسول الله - [ & ] - كبر خمسا . |(@)(@@) 4322 - حدثنا محمد بن عبد الرحيم قال : نا خالد بن | عمرو القرشي قال : نا إسرائيل عن عبد الأعلى | PageV10P230 | الثعلبي قال : صليت خلف زيد بن أرقم على جنازة فكبر خمسا فقال | له ابن أبي ليلى أوهمت فقال لا إني صليت خلف رسول الله - [ & ] - | على جنازة فكبر خمسا . |(@)(@@) 4323 - وحدثناه إسحاق بن إبراهيم بن حبيب قال : نا محمد بن | فضيل عن ليث بن المرقع عن زيد بن أرقم عن النبي - [ & ] - | بنحوه . |(@)(@@) 4324 - حدثنا حميد بن مسعدة قال : نا حسان بن 
ms1156	 إبراهيم قال : نا | سعيد بن مسروق عن يزيد بن حيان عن زيد بن أرقم - رضي الله | عنه - قال : قلنا له حدثنا قال قدم رسول الله - [ & ] - فنزل | بواد بين مكة والمدينة فخطبنا ، ثم قال : ' إنما أنا بشر أوشك أن أدعى | فأجيب ألا وإني تارك فيكم الثقلين أحدهما كتاب الله وأهل بيتي ' قالها | ثلاث مرات . فقلنا : من أهل بيته نساؤه ؟ قال : ألم تر أن المرأة تكون مع | الرجل حينا من الدهر فترجع إلى أبيها وقومها أهل بيته أهله وعصبته | PageV10P231 | الذين حرموا الصدقة بعده آل عباس وآل علي وآل جعفر وآل عقيل .(@)(@@) ولا أعلم أسند سعيد بن مسروق عن يزيد بن حيان عن زيد بن | أرقم غير هذا الحديث وأكثر ظني أن حميد بن مسعدة حدثناه . |(@)(@@) 4325 - وحدثنا يوسف بن موسى قال : نا جرير بن عبد الحميد | عن الحسن بن عبيد الله النخعي عن مسلم بن صبيح عن زيد بن أرقم | - رضي الله عنه - أن النبي - [ & ] - قال : ' إني تارك فيكم | الثقلين كتاب الله وأهل بيتي وإنهما لن يتفرقا حتى يردا على الحوض ' . | PageV10P232 |(@)(@@) 4326 - وحدثناه الفضل بن سهل قال : نا أسود بن عامر قال : نا | إسرائيل عن عثمان بن المغيرة عن علي بن ربيعة قال لقيت زيد بن أرقم | وهو داخل على المختار وأنا خارج من عنده فقلت ، سمعت رسول الله | يقول : ' إني تارك فيكم الثقلين ؟ ' قال : نعم .(@)(@@) ولا نعلم روي مسلم بن صبيح عن زيد بن أرقم إلا هذا الحديث ، | ولا روى علي بن ربيعة عن زيد بن أرقم إلا هذا الحديث . |(@)(@@) 4327 - حدثنا إبراهيم بن هانئ قال : نا عفان قال : نا أبو عوانة | عن المغيرة عن أبي عبيدة عن ميمون أبي عبد الله قال : قال زيد بن | أرقم وأنا أسمع نزلنا مع رسول الله - [ & ] - واد يقال له | وادي خم فأذن بالصلاة فصلاها تهجيرا ، ثم خطبنا وظلل لرسول الله | - [ & ] - بثوب على شجرة سمرة من الشمس فقال : ' ألستم | تعلمون أو تشهدون أني أولى بكل مؤمن من نفسه ' قالوا : بلى . قال : | PageV10P233 | ' فمن كنت مولاه فإن 
ms1157	 عليا مولاه اللهم وال من والاه وعاد من | عاداه ' .(@)(@@) وهذا الحديث لا نعلم أحدا رواه عن مغيرة إلا أبا عوانة . |(@)(@@) 4328 - حدثنا محمد بن معمر قال : نا أبو داود قال : نا شعبة عن | خالد الحذاء قال : سمعت ميمون أبا عبد الله يقول سمعت زيد بن | أرقم يقول إن النبي - [ & ] - أمر أن يتداوى من ذات | الجنب بالعود الهندي والزيت . | PageV10P234(@)(@@) وهذا الحديث لا نعلم أحدا يرويه عن النبي - [ & ] - إلا | زيد بن أرقم . |(@)(@@) 4329 - حدثناه الفضل بن سهل وزريق بن السخت قالا : نا | يعقوب ابن إسحاق قال : عبد الرحمن بن ميمون عن أبيه قال سألت | زيد بن أرقم ما كان اسم أم النبي - [ & ] - ؟ قال : آمنة بنت | وهب .(@)(@@) وميمون أبو عبد الله روى عن زيد أحاديث . |(@)(@@) 4330 - حدثنا عمرو بن علي قال : نا أبو عاصم عن ابن | PageV10P235 | جريح قال أخبرني عمرو بن دينار وعامر بن مصعب أنهما سمعا أبا | المنهال يقول سألت البراء وزيد بن أرقم - رضي الله عنهما - عن الصرف | فقالا كنا تاجرين على عهد رسول الله - [ & ] - فسألنا | رسول الله - [ & ] - عن الصرف فقال : ' ما كان من يد | بيد فلا بأس [ 230 ] وما كان نسيئة فلا يصلح ' . | PageV10P236 |(@)(@@) 4331 - حدثنا عمرو بن علي قال : نا أبو عاصم عن ابن | جريج ، عن الحسن بن مسلم عن أبي المنهال ، قال : سمعت البراء وزيد | ابن أرقم يحدثان عن النبي - [ & ] - ، قال : ' ما كان من يد | بيد فلا بأس وما كان من نسيئة فلا يصلح ' .(@)(@@) ولا نعلم روى هذين الحديثين إلا ابن جريج . |(@)(@@) 4332 - حدثنا عمرو بن علي قال : نا المعتمر بن سليمان قال : | نا يوسف بن صهيب عن حبيب بن يسار عن زيد بن أرقم - رضي الله | عنه - أن رسول الله - [ & ] - قال : ' من لم يأخذ من شاربه | فليس منا ' . | PageV10P237(@)(@@) وهذا الحديث لا نعلم أحدا يحدث به عن النبي - [ & ] - | إلا زيد بن أرقم ولا نعلم له إسنادا إلا هذا الإسناد . |(@)(@@) 4333 - حدثنا العباس بن الوليد قال : نا المعتمر بن سليمان | قال : نا يوسف بن صهيب عن حبيب بن يسار عن 
ms1158	 زيد بن أرقم - رضي | الله عنه - قال : كنا نقرأ لو أن لابن آدم واديا من مال لتمنى إليه ثانيا ولا | يملأ نفس بن آدم إلا التراب . |(@)(@@) 4334 - وحدثنا محمد بن معمر قال : نا أبو عاصم قال : نا | PageV10P238 | عمارة الأحمر قال أخبرني حبيب بن يزيد وأبو ليلى مولى فلان بن | سعيد وحبيب بن يسار قالوا : كنا مع زيد بن أرقم جلوسا فجاءه رجل | فجلس فقال : إن الناس قد أكثروا في هذين الرجلين علي وعثمان فأخبرني | عنهما ؟ قال : لا أحدثك إلا بما شهدته ووعاه قلبي خرج نبي الله - [ & ] - | فاستقبلنا بوجهه فحمد الله وأثنى عليه بما هو أهله ، ثم | قال ' ألستم تعلمون أني أولى بالمؤمنين من أنفسهم ' فأعادها علينا ثلاثا | كل ذلك نقول : بلى يا رسول الله ، وعلي ساكت قال : قم يا علي وأخذ | بعضده أو بعضديه فرفعها أو رفعهما فقال : ' من كنت مولاه فعلي | مولاه ' . |(@)(@@) 4335 - حدثنا يوسف بن موسى قال : نا أبو حيان عن يزيد بن | حيان عن زيد بن أرقم - رضي الله عنه - قال : بعث إلي عبيد الله بن زياد | فأتيته فقال ما أحاديث تبلغنا عنك إنك تحدث بها وترويها عن رسول الله | - [ & ] - لا نسمعها في كتاب الله تحدث أن له حوضا في | الجنة قلت : قد حدثنا عنه رسول الله - [ & ] - ووعيناه قال | PageV10P239 | كذبت وكبرت وخرفت فقال زيد : أما إني سمعت ووعاه قلبي منه وهو | يقول : ' من كذب علي متعمدا فليتبوأ مقعده من النار ' . |(@)(@@) 4336 - حدثنا يوسف بن موسى قال : نا جرير قال : نا أبو | حيان عن يزيد بن حيان قال انطلقت أنا وحصين وعمرو بن مسلم أو | عمر بن مسلم إلى زيد بن أرقم في داره فقال حصين يا زيد لقد لقيت | خيرا ورأيت خيرا كثيرا رأيت رسول الله - [ & ] - وسمعت | حديثه وغزوت معه وصليت خلفه حدثنا ما رأيت من رسول الله - [ & ] - | وشهدت منه قال يا ابن أخي كبرت سني وقدم عهدي | ونسيت بعض الذي كنت أذكر عن رسول الله - [ & ] - | فما حدثتكم فاقبلوه وما لم أحدثكموه فلا تكلفونيه ، ثم قال : خطبنا 
ms1159	 | رسول الله - [ & ] - فحمد الله وأثنى عليه ، ثم قال : ' أما | بعد أيها الناس ، إنما أنا بشر يوشك أن يأتيني رسول ربي فأجيب وإني | تارك فيكم الثقلين أولهما كتاب الله فيه الهدى والنور ' فحث على | كتاب الله ورغب ' فيه وأهل بيتي أذكركم الله في أهل بيتي ' قال حصين | PageV10P240 | يا زيد من أهل بيته نساؤه من أهل بيته قال إن نساءه من أهل بيته ولكن | أهل بيته من حرم الصدقة من بعده قيل من هم قال آل عباس وآل علي | وآل جعفر وآل عقيل فإن هؤلاء تحرم عليهم الصدقة . |(@)(@@) 4337 - حدثنا محمد بن معمر قال : نا أبو داود قال : نا إسرائيل | عن عثمان بن أبي زرعة عن إياس بن أبي رملة قال شهدت معاوية | سأل زيد بن أرقم - رضي الله عنه - أشهدت العيد مع رسول الله - [ & ] - | والجمعة قال شهدت مع رسول الله - [ & ] - | ذلك قال فما صنع قال صلى العيد ورخص في الجمعة فقال : ' من | شاء أن يجلس فليجلس ' . |(@)(@@) 4338 - حدثنا ميمون بن الأصبغ النصيبي قال : نا يزيد بن | PageV10P241 | هارون قال : نا حسام بن مصك عن قتادة عن القاسم بن ربيعة عن | زيد بن أرقم - رضي الله عنه - أن رسول الله - [ & ] - | قال : ' نعم المرء بلال وهو سيد الشهداء والمؤذنون أطول الناس أعناقا | يوم القيامة ' .(@)(@@) وهذا الحديث لا نعلمه عن زيد بن أرقم إلا من هذا الوجه ولا | نعلم رواه عن قتادة إلا حسام بن مصك ولا عن حسام إلا يزيد بن | هارون وحسام رجل من أهل البصرة قد حدث عنه جماعة كثيرة | واحتملوا حديثه . |(@)(@@) 4339 - حدثنا محمد بن المثنى قال : نا أبو قتيبة قال : نا يونس بن | PageV10P242 | أبي إسحاق عن أبيه عن زيد بن أرقم . |(@)(@@) 4340 - وحدثنا محمد بن معمر قال : نا خلاد بن يزيد الباهلي | قال : نا يونس بن أبي إسحاق عن أبيه عن زيد بن أرقم . |(@)(@@) 4341 - وحدثنا الحسن بن يحيى وعبد الله بن الصباح العطار قالا | نا عبيد الله بن عبد المجيد الحنفي قال : نا إسرائيل قال : حدثني أبي | يونس عن 
ms1160	 أبي إسحاق عن زيد بن أرقم - رضي الله عنه - قال | مرضت فعادني النبي - [ & ] - ، ثم برئت فلقيني فقال : ' يا | زيد أرأيت لو كان عينك لما بها ما كنت صانعا قلت كنت [ 231 ] | أصبر وأحتسب قال لو كانت عينك لما بها فصبرت واحتسبت وجبت | لك الجنة ' . | PageV10P243(@)(@@) واللفظ في هذه الأحاديث لفظ أبي قتيبة وحديث إسرائيل لا نعلم | رواه عن إسرائيل إلا عبيد الله الحنفي . |(@)(@@) 4342 - وحدثنا الحسن بن يحيى قال : نا عبيد الله بن عبد المجيد | قال : نا إسرائيل عن جابر عن خيثمة عن زيد بن أرقم - رضي الله | عنه - قال : قال رسول الله - [ & ] - : ' ما ابتلى عبد بعد | ذهاب دينه بأشد من بصره ومن ابتلى ببصره فصبر حتى يلقى الله لقي | الله - تبارك وتعالى - ولا حساب عليه ' .(@)(@@) وخيثمة هذا هو خيثمة بن أبي خيثمة . | PageV10P244 |(@)(@@) 4343 - وحدثنا محمد بن المثنى قال : نا محمد بن جعفر قال : نا | شعبة عن أبي إسحاق قال : سمعت زيد بن أرقم - رضي الله عنه - يقول | غزوت مع رسول الله - [ & ] - تسعة عشر غزوة . |(@)(@@) 4344 - حدثنا بشر بن معاذ أبو سهل العقدي قال : نا عوين بن | عمرو القيسي قال : نا أبو مصعب المكي قال أدركت زيد بن أرقم | PageV10P245 | والمغيرة بن شعبة وأنس بن مالك يحدثون أن النبي - [ & ] - | لما كان ليلة بات في الغار أمر الله تبارك وتعالى شجرة فنبتت في وجه الغار | فسترت وجه النبي - [ & ] - وأمر الله تبارك وتعالى | العنكبوت فنسجت على وجه الغار وأمر الله جل وعز حمامتين وحشيتين | فوقعتا بفم الغار وأتى المشركون من كل بطن حتى إذا كانوا من النبي | - [ & ] - على قدر أربعين ذراعا معهم قسيهم وعصيهم تقدم | رجل منهم فنظر فرأى الحمامتين فرجع فقال لأصحابه ليس في الغار شيء | رأيت حمامتين على فم الغار فعرفت أن ليس فيه أحد فسمع قوله النبي | - [ & ] - فعرف أن الله تبارك وتعالى قد درأ بهما عنه | فشمت عليهما وفرض جزاءهما واتخذت في حرم الله يفرخن . أحسبه | قال : فأصل كل حمام في الحرم من فراخها . | PageV10P246(@)(@@) وهذا الحديث لا نعلم رواه إلا عوين 