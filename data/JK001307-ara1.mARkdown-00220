ms201	 - عبيد بن سلمان الأعرج عن ابن المسيب لينه البخاري وحده(@)(@@)(@@)(@@) $ 3966 - عبيد بن الصباح عن عيسى بن طهمان ضعفه أبو حاتم(@)(@@)(@@)(@@) $ 3967 - عبيد بن عبد الرحمن أبو سلمه شيخ للفلاس مجهول قال وخبره منكر(@)(@@)(@@)(@@) $ 3968 - عبيد بن عبد الرحمن تفرد عنه أبو اسامة الكلبي بخبر موضوع(@)(@@)(@@)(@@) $ 3969 - عبيد بن عمر الهلالي شيخ لأحمد بن عبدة كذا مجهول(@)(@@)(@@)(@@) $ 3970 - عبيد بن عمرو البصري عن علي بن زيد ضعفه الأزدي PageV02P419(@)(@@)(@@)(@@) $ 3971 - عبيد بن الفرج العتكي عن حماد بن زيد ضعفه ابن حبان(@)(@@)(@@)(@@) $ 3972 - ق / عبيد بن القاسم عن هشام بن عروة كذبة ابن حبان وغيره من الحفاظ(@)(@@)(@@)(@@) $ 3973 - عبيد بن أبي قرة عن الليث بن سعد تفرد بخبر ساقط في بني العباس يملك من صلبك يا عم بعدد الثريا(@)(@@)(@@)(@@) $ 3974 - عبيد بن كثير العامري التمار قال الأزدي متروك الحديث وقال الدارقطني كوفي متروك(@)(@@)(@@)(@@) $ 3975 - عبيد بن محمد الكوفي النحاس والد محمد قال ابن عدي له مناكير عن ابن أبي ذئب وغيره(@)(@@)(@@)(@@) $ 3976 - خ س / عبيد بن أبي مريم المكي لم يرو عنه سوى ابن أبي مليكة وقد وثق(@)(@@)(@@)(@@) $ 3977 - عبيد بن ميمون البصري قال النسائي متروك(@)(@@)(@@)(@@) $ 3978 - د / عبيد بن هشام أبو نعيم قال أبو داود ثقة تغير في الآخر وقال س ليس بالقوي PageV02P420(@)(@@)(@@)(@@) $ 3979 - ت / عبيد بن واقد البصري ضعفه أبو حاتم(@)(@@)(@@)(@@) $ 3980 - عبيد بن أبي الوزير الحلبي ما نعلم أحدا روى عنه سوى أبي داود السجزي(@)(@@)(@@)(@@) $ 3981 - عبيد بن يزيد الحمصي أبو بشر مجهول بيض له(@)(@@)(@@)(@@) $ 3982 - عبيد أبو العوام عن أنس مجهول(@)(@@)(@@)(@@) $ 3983 - عبيد رجل من همدان عن قتادة وعنه بقية بخبر منكر(@)(@@)(@@)(@@) $ 3984 - عبيدة بن عبد الرحمن أبو عمر البجلي وهاه ابن حبان(@)(@@)(@@)(@@) $ 3985 - عبيدة بن حسان العنبري السنجاري عن الزهري قال ابن حبان روى الموضوعات عن الثقات وقال أبو حاتم منكر الحديث(@)(@@)(@@)(@@) $ 3986 - د ت ق / عبيدة بم معتب عن الشعبي قال أحمد تركوا حديثه قلت هو بضم أوله(@)(@@)(@@)(@@) $ 3987 - عبدوس بن خلاد عن عبد الوهاب الخفاف 
ms202	 كذاب قاله أبو زرعة PageV02P421(@)(@@)(@@)(@@) $ 3988 - ق / عبيس بن ميمون الخزاز عن القاسم بن محمد ضعفه ابن معين وغيره(@)(@@)(@@)(@@) $ 3989 - عتاب بن أعين عن الثوري قال العقيلي في حديثه وهم(@)(@@)(@@)(@@) $ 3990 - خ د س / عتاب بن بشير الجزري عن خصيف قال أحمد أحاديثه عن خصيف منكرة وقال ابن معين ثقة وقال أيضا ضعيف(@)(@@)(@@)(@@) $ 3991 - عتاب بن ثعلبة تابعي روى عنه أبو زيد الأحوال في قتال الناكثين إسناد مظلم(@)(@@)(@@)(@@) $ 3992 - عتاب بن حرب عن أبي عامر الخزاز قال أبو حفص الفلاس ضعيف جدا(@)(@@)(@@)(@@) $ 3993 - عه / عتبة بن أبي حكيم عن مكحول قال أبو حاتم صالح ووثقه ابن معين مرة وضعفه أخرى وكان أحمد بن حنبل يلينه(@)(@@)(@@)(@@) $ 3994 - د ت ق / عتبة بن حميد عن عكرمة ضعيف(@)(@@)(@@)(@@) $ 3995 - عتبة بن السكن عن الأوزاعي قال الدارقطني متروك الحديث وقال البيهقي منسوب إلى الوضع(@)(@@)(@@)(@@) $ 3996 - عتبة بن أبي سليمان الطائي مجهول(@)(@@)(@@)(@@) $ 3997 - عتبة بن عبد الله بن عمرو كذلك PageV02P422(@)(@@)(@@)(@@) $ 3998 - عتبة بن عبد الرحمن الحرستاني عن أنس وعنه الأوزاعي بيض له حديثان وهما منكران(@)(@@)(@@)(@@) $ 3999 - عتبة بن عبيد الله أو ابن عبد الله تابعي ما روى عنه إلا عبد الحميد بن جعفر(@)(@@)(@@)(@@) $ 4000 - عتبة بن عويم بن ساعدة عن أبيه قال البخاري لم يصح حديثه(@)(@@)(@@)(@@) $ 4001 - عتبة بن محمد بن الحارث بن نوفل أو عقبة بن محمد عن عبد الله بن جعفر وعنه مصعب بن شيبة قال س ليس بمعروف(@)(@@)(@@)(@@) $ 4002 - عتبة بن يقظان عن الشعبي وثقه بعضهم وقال النسائي غير ثقة(@)(@@)(@@)(@@) $ 4003 - عتبة عن بريد بن أصرم قال البخاري فيه نظر وقيل اسمه عتيبة(@)(@@)(@@)(@@) $ 4004 - عتيبة بنت عبد الملك روت عن الزهري مجهولة والخبر باطل PageV02P423(@)(@@)(@@)(@@) $ 4005 - د س / عتيك بن الحارث ما روى عنه سوى سبطه عبد الله ابن عبد الله المديني(@)(@@)(@@)(@@) $ 4006 - عثمان بن إبراهيم الحاطبي رأى ابن عمر لا يحتج به وله مناكير(@)(@@)(@@)(@@) $ 4007 - عثمان بن أحمد بن السماك موثق لكنه راوية للموضوعات عن طيور(@)(@@)(@@)(@@) $ 4008 - عه / عثمان بن إسحاق تفرد عنه 
ms203	 الزهري(@)(@@)(@@)(@@) $ 4009 - ق / عثمان بن جبير ما روى عنه سوى عبد الله بن عثمان ابن خثيم(@)(@@)(@@)(@@) $ 4010 - عثمان بن الحارث عن ابن عمر لا يعرف(@)(@@)(@@)(@@) $ 4011 - عثمان بن حرب الباهلي عن بعض التابعين مجهول قاله البخاري(@)(@@)(@@)(@@) $ 4012 - عثمان بن حفص بن خلدة لم يصح حديثه(@)(@@)(@@)(@@) $ 4013 - عثمان بن الحكم الجذامي شيخ لابن وهب قال أبو حاتم ليس بالمتين(@)(@@)(@@)(@@) $ 4014 - عثمان بن حكيم عن عبد الرحمن بن عبد العزيز قال ابن معين مجهول(@)(@@)(@@)(@@) $ 4015 - عثمان بن خالد العثماني عن ابن أبي الزناد ومالك قال النسائي ليس بثقة PageV02P424(@)(@@)(@@)(@@) $ 4016 - عثمان بن الخطاب أبو الدنيا الأشج حدث بعد الثلاثمائة عن علي فكذبوه(@)(@@)(@@)(@@) $ 4017 - عثمان بن داود عن الضحاك لا يدري من هو والخبر منكر(@)(@@)(@@)(@@) $ 4018 - عثمان بن دينار أخو مالك ووالد حكامة لا شيء والخبر كذب(@)(@@)(@@)(@@) $ 4019 - عثمان بن رشيد عن أنس بن سيرين ضعفه يحيى بن معين(@)(@@)(@@)(@@) $ 4020 - م / عثمان بن زائدة عن نافع صدوق لكن له حديث منكر خولف فيه ذكره العقيلي رواه عنه متروك فالآفة من صاحبه(@)(@@)(@@)(@@) $ 4021 - عثمان بن أبي زرعة شيخ لشريك القاضي ضعفه الدارقطني(@)(@@)(@@)(@@) $ 4022 - عثمان بن سالم عن زر بن حبيش لا يتابع على حديثه فيما قيل(@)(@@)(@@)(@@) $ 4023 - د ت / عثمان بن سعد عن أنس قال أبو زرعة لين وقال النسائي ليس بالقوي(@)(@@)(@@)(@@) $ 4024 - عثمان بن سليمان عن أبي سعيد الخدري لا يعرف وكذا(@)(@@)(@@)(@@) $ 4025 - عثمان بن سليمان عن عمر بن عبد العزيز(@)(@@)(@@)(@@) $ 4026 - عثمان بن سليمان الحارثي عن يزيد بن المهلب مجهول(@)(@@)(@@)(@@) $ 4027 - عثمان بن أبي شيبة شيخ البخاري تكلم فيه وهو صدوق(@)(@@)(@@)(@@) $ 4028 - خ س / عثمان بن صالح السهمي عن ابن لهيعة صدوق لينه أحمد بن صالح المصري PageV02P425(@)(@@)(@@)(@@) $ 4029 - ت / عثمان بن الضحاك بن عثمان الحزامي عن التابعين ضعفه أبو داود(@)(@@)(@@)(@@) $ 4030 - عثمان بن الضحاك الشامي عن محمد بن يوسف بن عبد الله ابن سلام لا يعرف(@)(@@)(@@)(@@) $ 4031 - عثمان بن أبي العاتكة القاص وثق وضعفه النسائي وغيره(@)(@@)(@@)(@@) $ 4032 - عثمان بن عباد عن ابن المسيب 
ms204	 مجهول(@)(@@)(@@)(@@) $ 4033 - عثمان بن عبد الله الأموي الشامي عن ابن لهيعة قال ابن عدي له موضوعات(@)(@@)(@@)(@@) $ 4034 - عثمان بن عبد الله بن عمرو بن عثمان بن عفان عن مالك هو الذي قبله متهم(@)(@@)(@@)(@@) $ 4035 - عثمان بن عبد الله العبدي عن حميد الطويل قال الأزدي مجهول(@)(@@)(@@)(@@) $ 4036 - د س ق / عثمان بن عبد الرحمن الطرائفي المؤدب وثق وقال أبو حاتم صدوق وأما محمد بن عبد الله بن نمير فقال كذاب سمع جعفر بن برقان(@)(@@)(@@)(@@) $ 4037 - عثمان بن عبد الرحمن التيمي قال الدارقطني ليس بالقوي(@)(@@)(@@)(@@) $ 4038 - ت عثمان بن عبد الرحمن الوقاصي من ذرية سعد عن عطاء قال البخاري تركوه(@)(@@)(@@)(@@) $ 4039 - ق / عثمان بن عبد الرحمن بن أبان عن جده ضعفه أبو حاتم PageV02P426(@)(@@)(@@)(@@) $ 4040 - ت ق / عثمان بن عبد الرحمن الجمحي البصري عن محمد ابن زياد قال أبو حاتم لا يحتج به(@)(@@)(@@)(@@) $ 4041 - ق / عثمان بن عبد الملك هو مستقيم بن عبد الملك عن ابن المسيب قال أبو حاتم منكر الحديث(@)(@@)(@@)(@@) $ 4042 - م د س / عثمان بن عثمان القرشي ويقال الغطفاني عن ابن أبي ذئب قال خ مضطرب الحديث(@)(@@)(@@)(@@) $ 4043 - ق / عثمان بن عطاء الخراساني عن أبيه ضعفه الدارقطني وغيره(@)(@@)(@@)(@@) $ 4044 - عثمان بن عفان السجستاني عن معتمر بن سليمان وغيره قال ابن خزيمة إمام الأئمة أشهد أنه كان يضع الحديث(@)(@@)(@@)(@@) $ 4045 - عثمان بن العلاء عن سلمة بن وردان قال البخاري ضعيف(@)(@@)(@@)(@@) $ 4046 - عثمان بن علي بن المعمر بن أبي عمامة عمر ويروي عن غيلان هجاء مخل بالصلوات(@)(@@)(@@)(@@) $ 4047 - عثمان بن عمر بن أبي خيثمة قال ابن معين لا أعرفه(@)(@@)(@@)(@@) $ 4048 - عثمان بن عمرو بن ساج عن سهيل بن أبي صالح قال أبو حاتم لا يحتج به وقواه غيره(@)(@@)(@@)(@@) $ 4049 - عثمان بن عمارة عن المعافى بن عمران حديث لله في الخلق أربعون على قلب موسى وهذا كذب(@)(@@)(@@)(@@) $ 4050 - عثمان بن عمرو بن منتاب عن البغوي قال ابن أبي الفوارس كان كثير التساهل PageV02P427(@)(@@)(@@)(@@) $ 4051 - د ت ق / عثمان بن عمير أبو اليقظان الثقفي عن 
ms205	 أنس ويقال عثمان بن أبي زرعة وعثمان بن قيس وعثمان بن أبي حميد الاعمى وأعشى ثقيف وغير ذلك ضعفوه(@)(@@)(@@)(@@) $ 4052 - عثمان بن فائد عن جعفر بن برقان قال ابن حبان لايحتج به ووهاه ابن عدي(@)(@@)(@@)(@@) $ 4053 - خ ت / عثمان بن فرقد البصري عن هشام بن عروة وثق وبعضهم لينه(@)(@@)(@@)(@@) $ 4054 - عثمان بن قادر مصري يروي عن الثقات موضوعات قاله النقاش(@)(@@)(@@)(@@) $ 4055 - عثمان بن أبي الكنات عن ابن أبي مليكة قال البخاري لا يصح حديثه(@)(@@)(@@)(@@) $ 4056 - عثمان بن محمد شيخ لمعن القزاز مجهول(@)(@@)(@@)(@@) $ 4057 - وعثمان بن محمد عن مكحول لا يعرف(@)(@@)(@@)(@@) $ 4058 - عه / عثمان بن محمد الأخنسي المدني عن سعيد المقبري وثق وله مناكير(@)(@@)(@@)(@@) $ 4059 - عثمان بن محمد بن خشيش القيرواني عن ابن غانم قاضي إفريقية أظنه كان كذابا PageV02P428(@)(@@)(@@)(@@) $ 4060 - عثمان بن محمد الأنماطي شيخ روى عنه إبراهيم الحربي فيه لين(@)(@@)(@@)(@@) $ 4061 - عثمان بن مضرس وأخوه عمر شيخان لحرملة بن عبد العزيز الجهني لا يعرفان(@)(@@)(@@)(@@) $ 4062 - ق عثمان بن مطر الشيباني عن ثابت البناني ضعفوه(@)(@@)(@@)(@@) $ 4063 - عثمان بن معاوية عن ثابت قال ابن حبان روى موضوعات(@)(@@)(@@)(@@) $ 4064 - عثمان بن المغيرة وليس بالثقفي قال الدارقطني زائغ لم يحتج به(@)(@@)(@@)(@@) $ 4065 - خ عه / عثمان بن المغيرة الثقفي ثقة ولأبي عوانة عنه مناكير(@)(@@)(@@)(@@) $ 4066 - عثمان بن مقسم البري عن هشام بن عروة وقتادة كذبه غير واحد عنه مناكير(@)(@@)(@@)(@@) $ 4067 - عثمان بن موزع عن الشعبي قوله لا يعرف من هو(@)(@@)(@@)(@@) $ 4068 - عثمان بن موسى المزني عن عطاء له حديث منكر لكنه يروي عنه عبد الرحمن بن مهدي(@)(@@)(@@)(@@) $ 4069 - خ / عثمان بن الهيثم المؤذن قال أبو حاتم كان بأخرة يلقن قال الدارقطني صدوق كثير الخطأ(@)(@@)(@@)(@@) $ 4070 - عثمان بن نمر لا يعرف وحديثه منكر(@)(@@)(@@)(@@) $ 4071 - د ت / عثمان بن واقد بن محمد العمري عن نافع بن جبير وثق وضعفه أبو داود PageV02P429(@)(@@)(@@)(@@) $ 4072 - عثمان بن يحيى الحضرمي عن ابن عباس صدوق ولينه بعضهم وقال الأزدي لا يكتب حديثه(@)(@@)(@@)(@@) $ 4073 - عه / عثمان البتي الفقيه عن أنس وثقوه إلا ابن 
ms206	 معين في قول وهو ابن مسلم(@)(@@)(@@)(@@) $ 4074 - عثمان البري هو ابن مقسم متروك قد ذكر(@)(@@)(@@)(@@) $ 4075 - م د س / عثمان الشحام أبو سلمة البصري عن أبي رجاء العطاردي قال يحيى القطان تعرف وتنكر وقال أحمد وغيره ليس به بأس قلت له حديث واحد في مسلم أخرجه شاهدا في الفتنة(@)(@@)(@@)(@@) $ 4076 - عثمان الأعرج عن الحسن وعنه عباد بن كثير لا يعرف(@)(@@)(@@)(@@) $ 4077 - عثمان التنوخي والد أبي الجماهر محمد لا يعرف قال ابنه سمعته يقول أصاب الناس جهد بأرمينية حتى أكلوا البعر فأمطروا بنادق فيها قمح(@)(@@)(@@)(@@) $ 4078 - عثمان أبو عمر المؤدب الكوفي مجهول(@)(@@)(@@)(@@) $ 4079 - عثيم بن كثير بن كليب عن أبيه عن جده لا يدرى من هو ولا أبوه بحديث ألق عنك شعر الكفر واختتن(@)(@@)(@@)(@@) $ 4080 - عجلان بن سمعان عن أبي هريرة وعنه طلحة ابن صالح مجهولان PageV02P430(@)(@@)(@@)(@@) $ 4081 - عجلان بن سهل الباهلي عن أبي أمامة لا يعرف ضعفه أبو زرعة(@)(@@)(@@)(@@) $ 4082 - عجيبة بن عبد الحميد روى عنه ملازم بن عمرو لا يكاد يعرف(@)(@@)(@@)(@@) $ 4083 - عدي بن أرطأه عن أبيه حديثه غير محفوظ(@)(@@)(@@)(@@) $ 4084 - ع / عدي بن ثابت تابعي كوفي شيعي جلد ثقة مع ذلك وكان قاص الشيعة وإمام مسجدهم قال المسعودي ما أدركنا أحدا أقول بقول الشيعة من عدي بن ثابت وفي نسبه اختلاف وقال ابن معين شيعي مفرط وقال الدارقطني رافضي غال(@)(@@)(@@)(@@) $ 4085 - عدي بن الفضل عن أيوب وغيره تركوه(@)(@@)(@@)(@@) $ 4086 - عدي بن أبي القلوص روى عنه عمرو بن ميمون العبسي مجهول(@)(@@)(@@)(@@) $ 4087 - عراك بن خالد عن عثمان بن عطاء صدوق قال أبو حاتم ليس بالقوي(@)(@@)(@@)(@@) $ 4088 - ع / عراك بن مالك ثقة قال أحمد لم يسمع من عائشة إنما هو عن عروة عنها(@)(@@)(@@)(@@) $ 4089 - س / عرعرة بن البرند ضعفه ابن المديني(@)(@@)(@@)(@@) $ 4090 - عرفة بن يزيد العبدي ما روى عنه سوى ولده الحسن فذكر خبرا منكرا(@)(@@)(@@)(@@) $ 4091 عرفة عن أبي موسى لا يعرف وحديثه منكر بل موضوع PageV02P431(@)(@@)(@@)(@@) $ 4092 - عرفطة بن أبي الحارث عن الحسن مجهول(@)(@@)(@@)(@@) $ 4093 - عروة بن أذنة من رؤوس الخوارج 
ms207	 ذكره الجوزجاني في الضعفاء(@)(@@)(@@)(@@) $ 4094 - عروة بن زهير عن ثابت قال البخاري منكر الحديث(@)(@@)(@@)(@@) $ 4095 - د / عروة ويقال عزرة بن سعيد مجهول الحال يعد في صغار التابعين(@)(@@)(@@)(@@) $ 4096 - عروة بن عبد الله عن أبي الزناد كذلك(@)(@@)(@@)(@@) $ 4097 - عروة بن علي السهمي عن أبي هريرة لا يعرف وروى عنه سلمة مجهول(@)(@@)(@@)(@@) $ 4098 - س / عروة بن النزال عن معاذ لا يعرف(@)(@@)(@@)(@@) $ 4099 - د ت / عروة المزني تفرد عنه حبيب بن أبي ثابت(@)(@@)(@@)(@@) $ 4100 - عروة العرقي عن عبد الله بن المبارك لا يعرف(@)(@@)(@@)(@@) $ 4101 - عريان عن سلمة بن سيرين مثله(@)(@@)(@@)(@@) $ 4102 - عريف بن إبراهيم ما روى عنه سوى يعقوب بن محمد الزهري(@)(@@)(@@)(@@) $ 4103 - عريف بن درهم عن جبلة بن سحيم قال أبو أحمد الحاكم ليس بالمتين وقد حدث عنه يحيى القطان على تكره منه عن زيد بن وهب(@)(@@)(@@)(@@) $ 4104 - عزرة بن قيس عن أم الفيض وعنه مسلم بن إبراهيم ضعفه ابن معين(@)(@@)(@@)(@@) $ 4105 - عزرة بن قيس تابعي كبير كوفي تفرد عنه أبو وائل PageV02P432(@)(@@)(@@)(@@) $ 4106 - عزير بن أحمد بن محمد أبو القاسم المضري الأصبهاني عن أبي سعيد النقاش تكلم فيه(@)(@@)(@@)(@@) $ 4107 - د ت / عسل بن سفيان عن عطاء حدث عنه شعبة ضعفه ابن معين(@)(@@)(@@)(@@) $ 4108 - عصام بن رواد بن الجراح العسقلاني شيخ ابن جوصاء لينه أبو أحمد الحاكم(@)(@@)(@@)(@@) $ 4109 - عصام بن طليق عن الحسن البصري قال ابن معين ليس بشيء(@)(@@)(@@)(@@) $ 4110 - عصام بن الليث السدوسي البدوي عن أنس لا يعرف وعنه علي بن يزداد ولا يدرى من هو(@)(@@)(@@)(@@) $ 4111 - عصام بن الوضاح السرخسي عن مالك قال ابن حيان لايجوز أن يحتج به(@)(@@)(@@)(@@) $ 4112 - عصمة بن بشير عن الفزع قال الدارقطني هما مجهولان(@)(@@)(@@)(@@) $ 4113 - عصمة بن عروة الفقيمي عن مغيرة بن مقسم مجهول(@)(@@)(@@)(@@) $ 4114 - عصمة بن محمد بن هشام بن عروة قال أبو حاتم ليس بقوي وقال غيره متروك(@)(@@)(@@)(@@) $ 4115 - عصمة بن المتوكل عن شعبة تكلم فيه لغلطه(@)(@@)(@@)(@@) $ 4116 - عطارد بن عبد الله مجهول(@)(@@)(@@)(@@) $ 4117 - وعطاف الشامي عن هشام كذلك(@)(@@)(@@)(@@) $ 4118 - ت س / عطاف بن 
ms208	 خالد المخزومي عن نافع وثقه أحمد وغيره وقال ابن معين ليس به بأس وقال أبو أحمد الحاكم ليس بالمتين عندهم غمزه مالك(@)(@@)(@@)(@@) $ 4119 - عطاء بن جبلة عن الاعمش قال أبو حاتم ليس بالقوي PageV02P433(@)(@@)(@@)(@@) $ 4120 - عطاء بن أبي راشد شيخ لمحمد بن عمرو مجهول(@)(@@)(@@)(@@) $ 4121 - عه م متابعة / عطاء بن السائب تابعي مشهور حسن الحديث ساء حفظه بأخرة قال أبو حاتم سمع منه حماد بن زيد قبل أن يتغير وقال أحمد ثقة رجل صالح وقال أيضا من سمع منه قديما فهو صحيح وقال غيره ليس بالقوي وقال ابن معين لا يحتج بحديثه(@)(@@)(@@)(@@) $ 4122 - خ م عه / عطاء بن عبد الله بن مسلم الخراساني صدوق مشهور وثقه ابن معين وأحمد والعجلي وقال يعقوب بن شيبة هو معروف بالفتوى والجهاد وقال أبو حاتم لا بأس به وذكره العقيلي في الضعفاء وقال ابن حبان ردئ الحفظ يخطئ فبطل الاحتجاج به(@)(@@) وقال الترمذي في كتاب العلل قال أحمد ما أعرف لمالك رجلا يروي عنه يستحق أن يترك حديثه غير عطاء الخراساني قلت ما شأنه قال عامة أحاديثه مقلوبة قال الترمذي وعطاء الخراساني رجل ثقة روى عنه مثل مالك ومعمر ولم نسمع أن أحدا من المتقدمين تكلم فيه بشيء(@)(@@) وقال البيهقي عطاء الخراساني غير قوي قاله في الوصايا PageV02P434(@)(@@)(@@)(@@) $ 4123 - عطاء بن عثمان القرشي شيخ لعفيف بن سالم مجهول(@)(@@)(@@)(@@) $ 4124 - ت / عطاء بن عجلان الحنفي البصري عن أنس تركوه وكذبه يحيى بن معين(@)(@@)(@@)(@@) $ 4125 - عطاء بن المبارك عن أبي عبيدة الناجي قال الأزدي لا يدري ما يقول(@)(@@)(@@)(@@) $ 4126 - عطاء بن محمد الهجري عن أبيه قال البخاري لم يصح حديثه(@)(@@)(@@)(@@) $ 4127 - عطاء بن مسروق الفزاري عن بيض مجهول(@)(@@)(@@)(@@) $ 4128 - س ق / عطاء بن مسلم الخفاف عن الأعمش وثق وقال أبو داود ضعيف(@)(@@)(@@)(@@) $ 4129 - خ م / عطاء بن أبي ميمونة تابعي صدوق وثقوه وقال أبو حاتم لا يحتج به(@)(@@)(@@)(@@) $ 4130 - عطاء بن نقادة الأسدي روى عنه يعقوب بن محمد الزهري(@)(@@)(@@)(@@) $ 4131 - عطاء أبو محمد الجمال عن علي رضي الله 
ms209	 عنه ضعفه ابن معين(@)(@@)(@@)(@@) $ 4132 - س / عطاء الشامي عن أبي أسيد في أكل الزيت لين البخاري حديثه(@)(@@)(@@)(@@) $ 4133 - عطاء البصري العطار شيخ كان قبل المائتين قال أبو داود ليس بشيء(@)(@@)(@@)(@@) $ 4134 - عطاء السليمي قتل مع ابن الأشعث قاله البخاري قلت ما أسند شيئا فأما PageV02P435(@)(@@)(@@)(@@) $ 4135 - عطاء السليمي الزاهد فآخر(@)(@@)(@@)(@@) $ 4136 - ت س ق / عطاء مولى ابن أبي أحمد تابعي لا يعرف(@)(@@)(@@)(@@) $ 4137 - عطاء البزاز عن أنس بن مالك قال ابن معين ليس بشيء(@)(@@)(@@)(@@) $ 4138 - عطية بن بسر شيخ لمكحول قال البخاري لم يقم حديثه(@)(@@)(@@)(@@) $ 4139 - د ت ق / عطية بن سعد العوفي الكوفي تابعي مشهور مجمع على ضعفه(@)(@@)(@@)(@@) $ 4140 - عطية بن عارض عن ابن عباس لا يعرف(@)(@@)(@@)(@@) $ 4141 - عطية بن عطية عن عطاء لا يعرف في العاشر من فوائد أبي أحمد الحاكم وحديثه موضوع(@)(@@)(@@)(@@) $ 4142 - عطية بن يعلي شيخ لاسماعيل بن أبان ضعفه الأزدي(@)(@@)(@@)(@@) $ 4143 - عطية الظفاري روى عنه سليمان التيمي وهاه الأزدي(@)(@@)(@@)(@@) $ 4144 - عطي بن مجدي الضمري من أبناء الصحابة قال البخاري لم يصح حديثه(@)(@@)(@@)(@@) $ 4145 - عفان بن سعيد عن ابن الزبير(@)(@@)(@@)(@@) $ 4146 - وعفان عن ابن عمر مجهولان(@)(@@)(@@)(@@) $ 4147 - ت ق / عفير بن معدان الحمصي مشهور ضعفوه وقال أبو حاتم لا يشتغل بحديثه(@)(@@)(@@)(@@) $ 4148 - عفيف بن سالم الموصلي مشهور قال الدارقطني ربما أخطأ ولا يترك PageV02P436(@)(@@)(@@)(@@) $ 4149 - عقبة بن بشير الأسدي عن أبي جعفر مجهول(@)(@@)(@@)(@@) $ 4150 - ت / عقبة بن عبد الله الرفاعي الأصم عن شهر ضعفه الفلاس والناس وقيل هو أبو جهم عقبة بن أبي الصهباء وهذا غلط بل هو آخر صدوق(@)(@@)(@@)(@@) $ 4151 ت / عقبة بن عبيد الطائي أبو الرحال عن أنس ضعفه غير واحد(@)(@@)(@@)(@@) $ 4152 - ت / عقبة بن علقمة أبو الجنوب عن علي قال أبو حاتم ضعيف(@)(@@)(@@)(@@) $ 4153 - س ق / عقبة بن علقمة البيروتي ثقة قال ابن عدي في الكامل يتفرد عن الأوزاعي(@)(@@)(@@)(@@) $ 4154 - عقبة بن علي عن هشام بن عروة قال العقيلي منكر الحديث(@)(@@)(@@)(@@) $ 4155 - عقبة بن وهب عن يزيد بن الأصم ليس بشيء ولا يكاد يعرف(@)(@@)(@@)(@@) $ 4156 
ms210	 - عقبة بن بريم أو ابن يزيد الدمشقي عن أبي ثعلبة الخشني قال البخاري في صحته نظر(@)(@@)(@@)(@@) $ 4157 - ت / عقبة العقيلي عن أبي هريرة لا يعرف وكذا(@)(@@)(@@)(@@) $ 4158 - ق / عقبة والد محمد عن تابعي PageV02P437(@)(@@)(@@)(@@) $ 4159 - عقيصا أبو سعيد التيمي عن علي قيل اسمه دينار شيعي جلد تركه الدارقطني(@)(@@)(@@)(@@) $ 4160 - د / عقيل بن جابر بن عبد الله الأنصاري عن أبيه فيه جهالة(@)(@@)(@@)(@@) $ 4161 - عقيل بن الجعدي عن الحسن قال البخاري منكر الحديث(@)(@@)(@@)(@@) $ 4162 - د ق / عقيلة عن سلامة بنت الحر لا نعرفها وهي تابعية(@)(@@)(@@)(@@) $ 4163 - عكاش بن الأشعث بصري سمع الحسن التراب ربيع الصبيان وعنه محمد بن سيابة أو ابن أبي سيابة مجهولان(@)(@@)(@@)(@@) $ 4164 - عكرمة بن إبراهيم الأزدي عن هشام مجمع على ضعفه(@)(@@)(@@)(@@) $ 4165 - عه / عكرمة بن خالد بن سلمة المخزومي عن أبيه وعنه مسلم بن إبراهيم ضعفه النسائي وغيره فأما(@)(@@)(@@)(@@) $ 4166 - عكرمة بن خالد بن العاص المخزومي فمكي تابعي حجة(@)(@@)(@@)(@@) $ 4167 - عكرمة بن ذؤيب روى عنه ولده عبد الله لا يصح حديثه(@)(@@)(@@)(@@) $ 4168 - م عه / عكرمة بن عمار اليمامي صدوق مشهور قال القطان أحاديثه عن يحيى بن أبي كثير ضعيفة وقال أحمد ضعيف الحديث ووثقه ابن معين وغيره وقال الحاكم أكثر مسلم الاستشهاد به وقال البخاري لم يكن له كتاب فاضطرب حديثه(@)(@@)(@@)(@@) $ 4169 - خ عه م قرنه / عكرمة مولى ابن عباس من أوعية العلم تكلموا فيه لرأيه لا لحفظه اتهم برأي الخوراج وثقة غير واحد PageV02P438 - وكذبه مجاهد وابن سيرين ومالك فالله أعلم واعتمده البخاري وأما مسلم فروى له مقرونا بآخر(@)(@@)(@@)(@@) $ 4170 - عكرمة بن يزيد عن أبيض قال الأزدي ضعيف(@)(@@)(@@)(@@) $ 4171 - عكرمة بن مصعب عن المحرر بن أبي هريرة مجهول(@)(@@)(@@)(@@) $ 4172 - العلاء بن برد بن سنان الدمشقي ضعفه أحمد بن حنبل(@)(@@)(@@)(@@) $ 4173 - العلاء بن بشر العبشمي عن ابن عيينة ضعفه الأزدي(@)(@@)(@@)(@@) $ 4174 - العلاء بن ثعلبة عن أبي المليح الهذلي مجهول(@)(@@)(@@)(@@) $ 4175 - م عه / العلاء بن الحارث الدمشقي الفقيه صاحب مكحول قال أبو داود ثقة تغير عقله وقال البخاري منكر الحديث وقيل كان 
ms211	 يرى القدر(@)(@@)(@@)(@@) $ 4176 - العلاء بن الحكم البصري عن ميسرة بن عبد ربه حديثه في الاسراء موضوع(@)(@@)(@@)(@@) $ 4177 - م ت / العلاء بن خالد الكاهلي عن أبي وائل ثقة وقال العقيلي يضطرب في حديثه(@)(@@)(@@)(@@) $ 4178 - ت / العلاء بن خالد الواسطي عن قتادة وعدة كذبه التبوذكي وقواه ابن حبان(@)(@@)(@@)(@@) $ 4179 - العلاء بن زيد بصري قال الدارقطني متروك الحديث(@)(@@)(@@)(@@) $ 4180 - ق / العلاء بن زيدل الثقفي عن أنس واه قال ابن المديني كان يضع الحديث(@)(@@)(@@)(@@) $ 4181 - س / العلاء بن زهير الأزدي أبطل ابن حبان الإحتجاج PageV02P439 به ووثقه ابن معين كان في زمن شعبة(@)(@@)(@@)(@@) $ 4182 - العلاء بن سليمان أبو سليمان الرقي عن الزهري قال ابن عدي منكر الحديث وقال أبو حاتم ضعيف(@)(@@)(@@)(@@) $ 4183 - العلاء بن أبي العباس الشاعر المكي عن أبي الطفيل شيعي جلد(@)(@@)(@@)(@@) $ 4184 - م عه / العلاء بن عبد الرحمن مولى الحرقة صدوق مشهور قال ابن عدي ما أرى بحديثه بأسا وقال أبو حاتم صالح الحديث أنكر من حديثه أشياء(@)(@@)(@@)(@@) $ 4185 - العلاء بن عمرو الحنفي عن أبي إسحاق الفزاري قال ابن حبان لا يحتج به وتركه غيره(@)(@@)(@@)(@@) $ 4186 - العلاء بن فرد عن أنس ضعفه أبو الفتح الأزدي الموصلي(@)(@@)(@@)(@@) $ 4187 - ت ق / العلاء بن الفضل المنقري عن عبيد الله بن عكراش ليس بالقوي ولا الواهي(@)(@@)(@@)(@@) $ 4188 - العلاء بن كثير الدمشقي نزيل الكوفة مجمع على ضعفه(@)(@@)(@@)(@@) $ 4189 - العلاء بن محمد بن سيار المازني عن محمد بن عمرو ضعفه ابن معين والنسائي(@)(@@)(@@)(@@) $ 4190 - ت / العلاء بن مسلمة الرواس شيخ للترمذي متهم بوضع الحديث PageV02P440(@)(@@)(@@)(@@) $ 4191 - ع العلاء بن المسيب صدوق مشهور أخبرت عن بعض الحفاظ أنه يهم كثيرا وما أعلم هذا وحديثه في الصحيحين قال الأزدي في بعض حديثه نظر(@)(@@)(@@)(@@) $ 4192 العلاء بن المنهال والد قطبة عن هشام بن عروة فيه جهالة ذكره العقيلي(@)(@@)(@@)(@@) $ 4193 - العلاء بن ميمون عن حجاج الأسود لا يدرى من هو(@)(@@)(@@)(@@) $ 4194 - العلاء بن هلال الباهلي الرقي قال البخاري وغيره منكر الحديث فأما(@)(@@)(@@)(@@) $ 4195 - ت / العلاء بن هلال البصري عن شهر فما فيه تجريح(@)(@@)(@@)(@@) $ 4196 
ms212	 - العلاء بن يزيد الثفي أبو محمد عن أنس كذبه أبو الوليد الطيالسي وقال خ منكر الحديث وقال هو ابن زيد(@)(@@)(@@)(@@) $ 4197 - د / علاج بن عمرو عن ابن عمر لا يعرف(@)(@@)(@@)(@@) $ 4198 - علاق بن أبي مسلم عن أبان بن عثمان وهاه الأزدي(@)(@@)(@@)(@@) $ 4199 - علباء بن أبي علباء عن علي رضي الله عنه لا يعرف(@)(@@)(@@)(@@) $ 4200 - علقمة بن نضلة لم يرو عنه سوى عثمان بن أبي سليمان PageV02P441(@)(@@)(@@)(@@) $ 4201 - علقمة بن هلال الكلبي تابعي عن أبيه مجهول(@)(@@)(@@)(@@) $ 4202 - م عه / علقمة بن وائل بن حجر عن أبيه قال ابن معين مرسل قلت هو في نفسه ثقة(@)(@@)(@@)(@@) $ 4203 - علقمة بن يزيد بن سويد عن أبيه عن جده لا يعرف والحديث منكر(@)(@@)(@@)(@@) $ 4204 - علوان بن داود وقيل ابن صالح البجلي قال البخاري منكر الحديث قلت ذكره ابن يونس في تاريخه وأن الليث بن سعد روى عنه توفي سنة 180(@)(@@)(@@)(@@) $ 4205 - علوان أبو رهم شيخ روى عنه ليث بن أبي سليم تركه الدارقطني(@)(@@)(@@)(@@) $ 4206 - علي بن إبراهيم البصري البزاز هو الجرجاني تالف(@)(@@)(@@)(@@) $ 4207 - علي بن إبراهيم الجرجاني عن أبي سعيد الأشج متهم لقيه الاسماعيلي(@)(@@)(@@)(@@) $ 4208 - علي بن إبراهيم بن الهيثم البلدي روى عنه ابن بخيت اتهمه أبو بكر الخطيب(@)(@@)(@@)(@@) $ 4209 - علي بن أحمد المصيصي شيخ أبي نعيم فيه تساهل(@)(@@)(@@)(@@) $ 4210 - علي بن أحمد بن النضر أبو غالب الأزدي ضعفه الدارقطني ومشاه غيره(@)(@@)(@@)(@@) $ 4211 - علي بن أحمد البصري كان قبل الثلاثمائة فيه جهالة وحديثه فموضوع(@)(@@)(@@)(@@) $ 4212 - علي بن أحمد الهاشمي توفي سنة تسع وستمائة متهم PageV02P442(@)(@@)(@@)(@@) $ 4213 - علي بن أحمد النعيمي الحافظ اتهم بوضع الحديث في صباه ثم تاب(@)(@@)(@@)(@@) $ 4214 - علي بن أحمد الحراني فلسفي الزهادة والمقالة زعم أنه من علم الحروف استخرج خروج الدجال وطلوع الشمس من مغربها(@)(@@)(@@)(@@) $ 4215 - علي بن أحمد الرزاز عن ابن السماك صدوق في بعض أصوله شيء(@)(@@)(@@)(@@) $ 4216 - علي بن أحمد بن البقشلام بدعه ابن ناصر ووثقه غيره(@)(@@)(@@)(@@) $ 4217 - علي بن أحمد الدباس متهم في قراءته على الشهرزوري(@)(@@)(@@)(@@) $ 4218 - علي بن أحمد شيخ 
ms213	 لهلال الحفار كان يؤدب روى موضوعات(@)(@@)(@@)(@@) $ 4219 - علي بن أحمد بن زهير التميمي المالكي الدمشقي متأخرليس بثقة(@)(@@)(@@)(@@) $ 4220 - علي بن أحمد شيخ الاسلام الهكاري سمع ابن نظيف ونحوه قال ابن عساكر لم يكن موثقا(@)(@@)(@@)(@@) $ 4221 - علي بن أحمد بن أبي قيس الرفاء عن ابن أبي الدنيا ضعفه جدا ابن أبي الفوارس(@)(@@)(@@)(@@) $ 4222 - علي بن أحمد بن عبد العزيز الجرجاني عن الفربري تركه أبو عبد الله الحاكم(@)(@@)(@@)(@@) $ 4223 - د علي بن أعبد عن علي لا يعرف(@)(@@)(@@)(@@) $ 4224 - علي بن أميرك الخزافي المروزي كذاب زور سماعا لزينب الشعرية فانتهك(@)(@@)(@@)(@@) $ 4225 - علي بن أيوب العمي الكاتب عن المتنبي رافضي(@)(@@)(@@)(@@) $ 4226 - عه / علي بن بذيمة عن عكرمة قال أحمد صالح الحديث رأس في التشيع PageV02P443(@)(@@)(@@)(@@) $ 4227 - علي بن بشير الأموي عن يزيد بن هارون لينه أبو الشيخ(@)(@@)(@@)(@@) $ 4228 - علي بن بيهس هو ابن قرين(@)(@@)(@@)(@@) $ 4229 - د ت / علي بن ثابت الجزري شيخ ابن عرفة وثقه أحمد وغيره وضعفه الأزدي(@)(@@)(@@)(@@) $ 4230 - علي بن جابارة القزويني عن أبي الدنيا الأشج وعنه أبو عثمان البحيري لا شيء(@)(@@)(@@)(@@) $ 4231 - خ د / علي بن الجعد الجوهري حافظ ثبت ودعه مسلم فلم يخرج له في الصحيح لأنه فيه بدعة قال مرة من قال القرآن مخلوق لم أعنفه قال مسلم ثقة ولكنه جهمي(@)(@@)(@@)(@@) $ 4232 - علي بن جميل الرقي عن جرير بن عبد الحميد ضعفه الدارقطني وكذبه ابن حبان(@)(@@)(@@)(@@) $ 4233 - علي بن الجند عن عمرو بن دينار قال البخاري منكر الحديث وقال أبو حاتم خبره كذب(@)(@@)(@@)(@@) $ 4234 - ق / علي بن الحزور عن الأصبغ بن نباتة هالك قال البخاري فيه نظر(@)(@@)(@@)(@@) $ 4235 - علي بن حسان الدممي صاحب مطين قال أبو خازم الفراء تكلموا فيه(@)(@@)(@@)(@@) $ 4236 - علي بن الحسن السامي عن ابن أبي عروبة قال ابن عدي أحاديثه بواطيل PageV02P444(@)(@@)(@@)(@@) $ 4237 - علي بن الحسن النسوي عن مبشر بن إسماعيل ضعفه ابن حبان(@)(@@)(@@)(@@) $ 4238 - علي بن الحسن بن جعفر بن كرنيب عن الباغندي متهم بالوضع والكذب(@)(@@)(@@)(@@) $ 4239 - علي بن الحسن المكتب هو ابن عبدة عن يحيى القطان 
ms214	 كذاب هالك(@)(@@)(@@)(@@) $ 4240 - علي بن الحسن الكلبي عن يحيى بن ضريس بخبر موضوع لعله آفته(@)(@@)(@@)(@@) $ 4241 - علي بن الحسن بن علي الشاعر عن محمد بن جرير الطبري بخبر باطل(@)(@@)(@@)(@@) $ 4242 - علي بن الحسن الخسروجردي عن يحيى بن المغيرة بخبر كذب في فضائل علي(@)(@@)(@@)(@@) $ 4243 - علي بن الحسن الصفار عن وكيع قال ابن معين غير ثقة(@)(@@)(@@)(@@) $ 4244 - علي بن الحسن القاضي أبو الحسن الجراحي عن البغوي قال البرقاني كان يتهم(@)(@@)(@@)(@@) $ 4245 - علي بن الحسن بن بندار الأستراباذي عن خيثمة بن سليمان اتهمه محمد بن ظاهر(@)(@@)(@@)(@@) $ 4246 - علي بن الحسن الذهلي الأفطس النيسابوري عن ابن عيينة قال ابن الشرقي متروك(@)(@@)(@@)(@@) $ 4247 - علي بن الحسن ويقال ابن الحسين الرازي عن أبي بكر بن الأنباري كذبه الأزهري(@)(@@)(@@)(@@) $ 4248 - عه / علي بن الحسين بن واقد المروزي صدوق وثق وقال أبو حاتم ضعيف(@)(@@)(@@)(@@) $ 4249 - علي بن الحسين أبو الفرج الأصبهاني مؤلف الأغاني شيعي يأتي بعجائب يحتمل لسعة اطلاعه فالله أعلم قال ابن أبي الفوارس خلط قبل موته(@)(@@)(@@)(@@) $ 4250 - علي بن الحسين الرصافي في زمان الجعابي قال الدارقطني لا يوصف ما أدخل على الشيوخ وعمل محضر عليه بأحاديث أدخلها على دعلج(@)(@@)(@@)(@@) $ 4251 - علي بن الحسين العلوي الشريف المرتضى عن سهل الديباجي رافضي جبل مصنف(@)(@@)(@@)(@@) $ 4252 - علي بن الحصين عن عمر بن عبد العزيز قال ابن حبان لا يحتج به(@)(@@)(@@)(@@) $ 4253 - م د ت س / علي بن حفص المدائني عن شعبة قال أبو حاتم لا يحتج به ووثقه د(@)(@@)(@@)(@@) $ 4254 - علي بن الحكم البناني ثقة قال الأزدي وحده فيه لين(@)(@@)(@@)(@@) $ 4255 - علي بن حماد بن السكن عن يزيد بن هارون قال الدارقطني متروك(@)(@@)(@@)(@@) $ 4256 - علي بن أبي حملة شيخ ضمرة بن ربيعة ما علمت به بأسا ولم يخرج له احد PageV02P445(@)(@@)(@@)(@@) $ 4257 - علي بن حميد السلولي عن شعبة قال أبو زرعة لا أعرفه وأورد له العقيلي(@)(@@)(@@)(@@) $ 4258 - علي بن الخضر السلمي عن تمام الرازي قال الكتاني روى أشياء لا سماع له فيها ولا إجازة(@)(@@)(@@)(@@) $ 4259 - علي بن خلف المصري 
ms215	 قال ابن يونس لم يكن يساوي شيئا(@)(@@)(@@)(@@) $ 4260 - علي بن داود الدمشقي كان بعد المائتين لا يعرف وحديثه كذب(@)(@@)(@@)(@@) $ 4261 - علي بن داود القنطري صالح سمع سعيد بن أبي مريم روى خبرا منكرا فتكلم فيه لذلك(@)(@@)(@@)(@@) $ 4262 - علي بن الربيع عن بهز بن حكيم لينه ابن حبان(@)(@@)(@@)(@@) $ 4263 - علي بن زبيد شيخ لبقية لا يعرف(@)(@@)(@@)(@@) $ 4264 - علي بن زرارة عن سعيد بن جبير قال أبو حاتم ضعيف(@)(@@)(@@)(@@) $ 4265 - م عه / علي بن زيد بن جدعان صالح الحديث قال حماد ابن زيد كان يقلب الأحاديث وذكر شعبة أنه اختلط وقال أحمد ليس بشيء وقال أبو زرعة ليس بقوي يهم ويخطئ وقال أبو حاتم لا يحتج به وقال الدارقطني لا يزال عندي فيه لين(@)(@@)(@@)(@@) $ 4266 - س / علي بن أبي سارة عن مكحول قال أبو داود PageV02P447 تركوا حديثه وضعفه أبو حاتم من مناكيره عن ثابت عن أنس رفعه من حمل أحد قوائم السرير حط الله عنه أربعين كبيرة(@)(@@)(@@)(@@) $ 4267 علي بن سالم عن علي بن زيد بن جدعان حديث المحتكر ملعون قال الأزدي لا يتابع علي حديثه(@)(@@)(@@)(@@) $ 4268 - علي بن سراج المصري حافظ متأخر لكنه يشرب المسكر(@)(@@)(@@)(@@) $ 4269 - علي بن سعيد بن بشير الرازي قال الدارقطني ليس بذاك تفرد بأشياء(@)(@@)(@@)(@@) $ 4270 - علي بن سعيد الرملي عن ضمرة يكشف من هو ويحرر اسم جده قتيبة كأنه صدوق(@)(@@)(@@)(@@) $ 4271 - علي بن سعيد بن شهريار الرقي عن الأنصاري قال ابن حبان لا يجوز ان يحتج به(@)(@@)(@@)(@@) $ 4272 - علي بن الحافظ أبي سعيد بن يونس المصري منجم ساحر له الزيج الكبير(@)(@@)(@@)(@@) $ 4273 - علي بن سلمة عن أبي هريرة وعنه يحيى بن أبي كثير لا يعرف مجهول(@)(@@)(@@)(@@) $ 4274 - علي بن سليمان الأزدي عن ابن جريج قال ابن حبان لا يحتج بما انفرد به(@)(@@)(@@)(@@) $ 4275 - علي بن سليمان عن مكحول حدث بمصر لا يكاد يعرف PageV02P448(@)(@@)(@@)(@@) $ 4276 - علي بن سليمان بن أبي الرقاع قال عبد الغني الأزدي يروي أباطيل عن عبد الرزاق(@)(@@)(@@)(@@) $ 4277 - علي بن سويد شيخ ليحيى الحماني لا 
ms216	 يعرف فيقال هو معلى بن هلال بن سويد دلسه(@)(@@)(@@)(@@) $ 4278 - علي بن شاذان عن أبي بدر السكوني وغيره ضعفه الدارقطني(@)(@@)(@@)(@@) $ 4279 - علي بن شبرمة عن شريك ضعفه الأزدي(@)(@@)(@@)(@@) $ 4280 - علي بن شداد الحنفي مجهول(@)(@@)(@@)(@@) $ 4281 - علي بن صالح عن ابن جريج ضعفوه كذا لفظ ابن الجوزي ولا أعرفه(@)(@@)(@@)(@@) $ 4282 - علي بن صالح بياع الأكسية لا يعرف(@)(@@)(@@)(@@) $ 4283 - علي بن الصقر السكري عن عفان قال الدارقطني ليس بالقوي(@)(@@)(@@)(@@) $ 4284 - علي بن الصلت لا يعرف عن أبي أيوب الأنصاري وقال ابن خزيمة لا يحتج به(@)(@@)(@@)(@@) $ 4285 - علي بن أبي طالب القرشي بصري بعد المائتين قال ابن معين ليس بشيء(@)(@@)(@@)(@@) $ 4286 - خ / علي بن طبراخ عن سعيد بن عبد الرحمن قال الأزدي ضعيف جدا وقواه غيره PageV02P449(@)(@@)(@@)(@@) $ 4287 - م دس / علي بن أبي طلحة عن مجاهد قال أحمد له أشياء منكرات وقال د كان يرى السيف قلت خرج له مسلم(@)(@@)(@@)(@@) $ 4288 - علي بن ظبيان العبسي عن ابن أبي خالد قال أبو حاتم والنسائي متروك(@)(@@)(@@)(@@) $ 4289 - ت / علي بن عابس الأزرق عن العلاء بن المسيب ضعفوه(@)(@@)(@@)(@@) $ 4290 - د ت ق / علي بن عاصم الواسطي حافط مشهور ضعفوه وكان مكثرا(@)(@@)(@@)(@@) $ 4291 - علي بن عبد الله بن معاوية بن ميسرة بن شريح القاضي عن أبيه عن جده ميسرة تقدمت إلى شريح القاضي إمرأة فقالت لي إحليل ولي فرج . . وذكر القصة وأن عليا عد أضلاعها قال أبو حاتم كتبت هذا لأسمعه من هذا الشيخ ثم تركته لأنه موضوع(@)(@@)(@@)(@@) $ 4292 - علي بن عبد الله البرداني عن محمد بن محمود قال الخطيب ليس بشيء واتهمه بالوضع(@)(@@)(@@)(@@) $ 4293 - علي بن عبد الله بن إبراهيم البغدادي شيخ للبخاري وثقه وفيه جهالة في معرفتنا PageV02P450(@)(@@)(@@)(@@) $ 4294 - م عه / علي بن عبد الله البارقي عن ابن عمر أورده ابن عدي وما تكلم فيه أحد وقال ابن عدي لا بأس به عندي(@)(@@)(@@)(@@) $ 4295 - علي بن عبد الله بن جهضم أبو الحسن شيخ الحرم صوفي نبيل لكنه ليس بثقة أتهمه(@)(@@)(@@)(@@) $ 4296 - علي بن عبد الأعلى بن عامر 
ms217	 الثعلبي عن أبيه صويلح قال أبو حاتم ليس بقوي(@)(@@)(@@)(@@) $ 4297 - علي بن عبد الحميد كوفي مجهول جار لقبيصة وما هو بالمعني ذاك صدوق(@)(@@)(@@)(@@) $ 4298 - علي بن عبد الملك الطرسوسي نزيل نيسابور عن أبي خليفة قال الحاكم كان معتزليا متهاونا بالرواية تجهرم حتى هجر(@)(@@)(@@)(@@) $ 4299 - علي بن عبدة التميمي المكتب عن ابن علية قال الدارقطني كان يضع الحديث(@)(@@)(@@)(@@) $ 4300 - علي بن عبد الله أبو الحسن بن الزاغوني إمام انفرد بمسائل كلامية بدع بها PageV02P451(@)(@@)(@@)(@@) $ 4301 - علي بن عثمان اللاحقي ثقة من طبقة أحمد بن يونس قال ابن خراش فيه اختلاف(@)(@@)(@@)(@@) $ 4302 - ق / علي بن عروة الدمشقي عن ابن المنكدر قال ابن حبان كان يضع الحديث(@)(@@)(@@)(@@) $ 4303 - علي بن عروة القرشي في التابعين مجهول(@)(@@)(@@)(@@) $ 4304 - ت / علي بن علقمة الأنماري عن علي قال البخاري في حديثه نظر(@)(@@)(@@)(@@) $ 4305 - علي بن علي بن بركة بن عبيدة الكرخي أخو الإمام أبي محمد الحسن سمع أحمد بن الأشقر كان على طريقة مذمومة(@)(@@)(@@)(@@) $ 4306 - علي بن علي بن نجاد الرفاعي مشهور وثقه أبو زرعة وتكلم فيه ابن معين لقوله بالقدر سمع الحسن(@)(@@)(@@)(@@) $ 4307 - علي بن أبي علي اللهبي القرشي ويقال ابن علي عن ابن المنكدر تركه أبو حاتم والنسائي(@)(@@)(@@)(@@) $ 4308 - علي بن عمر الحربي السكري مشهور صدوق لينه البرقاني(@)(@@)(@@)(@@) $ 4309 - علي بن عمر الدمشقي عن أبيه وعنه بقية لا يعرف(@)(@@)(@@)(@@) $ 4310 - علي بن عيسى الرماني لقي ابن دريد معتزلي رافضي(@)(@@)(@@)(@@) $ 4311 - علي بن عيسى الأصمعي عن ابن أبي عروبة حديثه منكر ولا يدرى من هو PageV02P452 -(@)(@@)(@@)(@@) $ 4312 - علي بن غالب المصري عن وهب بن عبد الله تكلم فيه ابن حبان(@)(@@)(@@)(@@) $ 4313 - س ق / علي بن غراب الفزاري عن هشام بن عروة وثقه الدارقطني ومن قبله ابن معين وقال أبو داود تركوا حديثه وقال السعدي ساقط وقال ابن حبان حدث بالموضوعات وكان غاليا في التشيع(@)(@@)(@@)(@@) $ 4314 - علي بن الفرات شيخ يجهل روى عنه عبد الوهاب بن نجدة خبرا ساقطا(@)(@@)(@@)(@@) $ 4315 - علي بن أبي فاطمة هو ابن الحزور واه مر 
ms218	(@)(@@)(@@)(@@) $ 4316 - د ت / علي بن قادم عن الثوري قال أبو حاتم محله الصدق وضعفه ابن معين(@)(@@)(@@)(@@) $ 4317 - علي بن القاسم الكندي عن معروف بن خربوذ قال أبو حاتم ليس بقوي(@)(@@)(@@)(@@) $ 4318 - علي بن قتيبة الرفاعي عن مالك قال ابن عدي له أحاديث باطلة(@)(@@)(@@)(@@) $ 4319 - علي بن قرين بن بيهس عن عبد الوارث كذبه غير واحد وتركه أبو حاتم(@)(@@)(@@)(@@) $ 4320 - د / علي بن ماجدة عن عمر لا يعرف(@)(@@)(@@)(@@) $ 4321 - علي بن مالك العبدي عن الضحاك قال ابن معين ليس بشيء PageV02P453(@)(@@)(@@)(@@) $ 4322 - علي بن مبارك الربيعي عن إبراهيم بن سعيد بخبر كذب(@)(@@)(@@)(@@) $ 4323 - علي بن مجاهد كذاب تراه(@)(@@)(@@)(@@) $ 4324 - علي بن المحسن التنوخي صحيح السماع قال ابن خيرون قيل كان رأيه الرفض والاعتزال(@)(@@)(@@)(@@) $ 4325 - علي بن محمد بن أحمد ن كيسان عن يوسف القاضي لينه البرقاني وكان عنده جزءان فقط(@)(@@)(@@)(@@) $ 4326 - علي بن محمد أبو الحسن المدائني الأخباري صدوق قال ابن عدي ليس بالقوي(@)(@@)(@@)(@@) $ 4327 - علي بن محمد بن أبي سارة وينسب إلى جده قد ذكر(@)(@@)(@@)(@@) $ 4328 - علي بن محمد الصائغ عن أصحاب مالك ضعفه الخطيب(@)(@@)(@@)(@@) $ 4329 - علي بن محمد بن عيسى الخياط عن محمد بن هشام السدوسي وهاه ابن ماكولا واتهمه ابن يونس(@)(@@)(@@)(@@) $ 4330 - علي بن محمد أبو القاسم الزيدي الحراني المقرئ وثقه الداني واتهمه عبد العزيز الكتاني(@)(@@)(@@)(@@) $ 4331 - علي بن محمد أقضى القضاة الماوردي صدوق لكنه معتزلي(@)(@@)(@@)(@@) $ 4332 - علي بن محمد بن السري الوراق عن الباغندي متهم بالكذب(@)(@@)(@@)(@@) $ 4333 - علي بن محمد بن بكران شيخ لهناد النسفي بخبر كذب سمج(@)(@@)(@@)(@@) $ 4334 - علي بن محمد الزهري عن أبي يعلى الموصلي كذبه الخطيب وغيره PageV02P454(@)(@@)(@@)(@@) $ 4335 - علي بن محمد أبو أحمد الحبيبي المروزي كذبه الحاكم روى عن سعيد بن مسعود(@)(@@)(@@)(@@) $ 4336 - علي بن محمد بن صافي الربعي عن عبد الوهاب الكلابي قال ابن عساكر كذب في سماعه لهواتف الجنان(@)(@@)(@@)(@@) $ 4337 - ت / علي بن مجاهد الكابلي عن ابن إسحاق كذبه يحيى بن الضريس ومشاه غيره(@)(@@)(@@)(@@) $ 4338 - علي بن مسعدة الباهلي عن قتادة قال ابن 
ms219	 حبان لا يحتج بما انفرد به وكذا قال أبو حاتم(@)(@@)(@@)(@@) $ 4339 - علي بن مشرف الأنماطي شيخ السلفي قال السلفي زور سماعات(@)(@@)(@@)(@@) $ 4340 - علي بن معمر القرشي نكرة عن خليد بن دعلج بخبر باطل من أكل القثاء بلحم وقي الجذام(@)(@@)(@@)(@@) $ 4341 - علي بن مصعب أخو خارجة ضعفهما الدارقطني(@)(@@)(@@)(@@) $ 4342 - علي بن معاذ الرعيني عن سعيد بن فحلون متهم(@)(@@)(@@)(@@) $ 4343 - علي بن مهاجر عن هيصم بن شداخ جاء في خبر موضوع(@)(@@)(@@)(@@) $ 4344 - علي بن مهران الطبري قال أبو إسحاق الجوزجاني كان ردئ المذهب PageV02P455(@)(@@)(@@)(@@) $ 4345 - ق / علي بن موسى بن جعفر الرضا عن آبائه قال ابن طاهر يأتي عن آبائه بعجائب قلت الشأن في صحة الإسناد إليه فإنه كذب عليه وعلى جده(@)(@@)(@@)(@@) $ 4346 - علي بن موسى السمسار مسند دمشق في ايام أبي نعيم قال أبو الوليد الباجي في أصوله سقم وفيه تشيع يفضي إلى الرفض(@)(@@)(@@)(@@) $ 4347 - علي بن ميسر عن عمر بن عمير عن ابن فيروز إسناد مظلم والمتن موضوع(@)(@@)(@@)(@@) $ 4348 - علي بن ميمون المدني عن القاسم بن محمد روى أحاديث موضوعة(@)(@@)(@@)(@@) $ 4349 - علي بن نافع عن بهز بن حكيم لا يعرف والحديث منكر(@)(@@)(@@)(@@) $ 4350 - ت ق / علي بن نزار عن أبيه عن عكرمة قال ابن عدي ليس بشيء(@)(@@)(@@)(@@) $ 4351 - علي بن نصر البصري عن عبد الرزاق نكرة والخبر باطل(@)(@@)(@@)(@@) $ 4352 - د ق / علي بن نفيل جد النفيلي له حديث في ذكر المهدي لا يصح ذكره العقيلي(@)(@@)(@@)(@@) $ 4353 - م عه / علي بن هاشم بن البريد صدوق شيعي جلد قال ابن حبان روى المناكير عن المشاهير(@)(@@)(@@)(@@) $ 4354 - علي بن أبي هاشم هو علي بن طبراخ شيخ البخاري أهدر للوقف في القرآن PageV02P456(@)(@@)(@@)(@@) $ 4355 - علي بن هاشم الكرماني عن نصر بن حماد أتى بحديث موضوع وعن عثمان بموضوع آخر(@)(@@)(@@)(@@) $ 4356 - علي بن واقد المروزي ضعفه أبو حاتم(@)(@@)(@@)(@@) $ 4357 - دق / علي بن يزيد بن ركانة في الطلاق قال البخاري لم يصح حديثه(@)(@@)(@@)(@@) $ 4358 - ت ق / علي بن يزيد الألهاني عن القاسم أبي عبد الرحمن ضعفوه وتركه الدارقطني 
ms220	(@)(@@)(@@)(@@) $ 4359 - علي بن يزيد الذهلي عن ابن عيينة بخبر كذب في فضل علي وعنه إسماعيل بن موسى اتهم ابن الجوزي إسماعيل(@)(@@)(@@)(@@) $ 4360 - علي بن يزداد الجرجاني الجوهري شيخ لابن عدي روي عن الثقات مالا يحتملونه(@)(@@)(@@)(@@) $ 4361 - علي بن يزيد الصدائي عن الأعمش قال ابن عدي عامة حديثه لا يتابع عليه(@)(@@)(@@)(@@) $ 4362 - علي بن يعقوب مصري شيخ للحسن بن رشيق قال ابن يونس كان يضع الحديث(@)(@@)(@@)(@@) $ 4363 - علي بن يعقوب البلاذري روي بعد السبعين وثلاثمائة خبرا مكذوبا(@)(@@)(@@)(@@) $ 4364 - علي الحوراني عن بعض التابعين PageV02P457(@)(@@)(@@)(@@) $ 4365 - وعلي عن أبي ذر مجهولان(@)(@@)(@@)(@@) $ 4366 - علي الأسدي عن جابر مجهول(@)(@@)(@@)(@@) $ 4367 - علي بن العسقلاني وهاه ابن معين(@)(@@)(@@)(@@) $ 4368 - علي بن الأعرابي شيخ للخرائطي بخبر كذب على إسناد الصحيحين(@)(@@)(@@)(@@) $ 4369 - علي الجند شيخ لمسدد لا يعرف والخبر منكر وقيل هو ابن الجند(@)(@@)(@@)(@@) $ 4370 - عليلة بن بدر أحد الضعفاء اسمه الربيع مر(@)(@@)(@@)(@@) $ 4371 - عمار بن إسحاق عن سعيد بن عامر كأنه واضع هذه القصة التي فيها قد لسعت حية الهوى كبدي فإن باقي الإسناد ثقات(@)(@@)(@@)(@@) $ 4372 - عمار بن إسحاق بن يسار أخو محمد عن ابن المنكدر له حديث منكر(@)(@@)(@@)(@@) $ 4373 - عمار بن حفص بن عمر بن القرظ المؤذن عن آبائه قال ابن معين ليس بشيء(@)(@@)(@@)(@@) $ 4374 - عمار بن حكيم شيخ لعكرمة بن عمار مجهول ويقال حكيم بن عمار(@)(@@)(@@)(@@) $ 4375 - عمار بن زربي عن معتمر بن سليمان قال عبدان الأهوازي يكذب PageV02P458(@)(@@)(@@)(@@) $ 4376 - عمار بن سعد المؤذن عن أبي عبيدة بن محمد قال البخاري لا يتابع على حديثه(@)(@@)(@@)(@@) $ 4377 - ت ق / عمار بن سيف الضبي الزاهد عن الأعمش ضعفه أبو حاتم وغيره(@)(@@)(@@)(@@) $ 4378 - عمار بن عبد الملك عن بقية بعجائب وقال الأزدي متروك(@)(@@)(@@)(@@) $ 4379 - عمار بن عطية الكوفي قال ابن معين كذاب(@)(@@)(@@)(@@) $ 4380 - عمار بن عمران عن سويد بن غفلة في الصلاة قال البخاري لا يصح(@)(@@)(@@)(@@) $ 4381 - عمار بن غنيم وقيل ابن علثم شيخ لأزهر السمان مجهول وقال خ لا يتابع على حديثه وذكر لأحمد حديث تفرد به عمار فقال 