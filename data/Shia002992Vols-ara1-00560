ms552	 بن يحيى الأشعري.(@)(@@) * وروى عن محمد بن الحسين بن سفيان.(@)(@@) مشيخة التهذيب: في طريقه إلى محمد بن أحمد بن يحيى الأشعري.(@)(@@) أحمد بن عبدون أبو عبد الله * روى عن علي بن محمد بن الزبير أبي الحسن.(@)(@@) الاستبصار: ج 3، ح 1 و 2 و 3 و 4.(@)(@@) (أحمد بن عمر) * روى عن أبي الحسن عليه السلام، وروى عنه الحسن بن علي الوشاء، التهذيب: ج 2، ح 52 (الاستبصار: ج 1، ح 883).(@)(@@) وروى عنه الحسين بن سعيد.(@)(@@) الفقيه: ج 2، ح 1228.(@)(@@) وروى عنه محمد بن القاسم بن الفضيل.(@)(@@) التهذيب: ج 2، ح 1242، (الاستبصار:(@)(@@) ج 1، ح 1251.(@)(@@) وروى عنه يعقوب بن يزيد.(@)(@@) التهذيب: ج 1، ح 236.(@)(@@) وروى عنه الوشاء.(@)(@@) الكافي: ج 1، ك 4، ب 106، ح 3.(@)(@@) * وروى عن أبي الحسن الرضا عليه السلام، وروى عنه الحسن.(@)(@@) الكافي ج 1، ك 4، ب 24، ح 3.(@)(@@) وروى عنه الحسن بن علي الوشاء.(@)(@@) الكافي: ج 1، ك 4، ب 59، ح 2.(@)(@@) وروى عنه عبيد الله.(@)(@@) الروضة: ح 546.(@)(@@) وروى عنه يونس.(@)(@@) الكافي: ج 1، ك 4، ب 62، ح 5.(@)(@@) * وروى عن أبيه (عمر)، وروى عنه ابن فضال.(@)(@@) الكافي: ج 7، ك 1، ب 25، ح 4.(@)(@@) * وروى عن درست الواسطي، وروى عنه ابن فضال.(@)(@@) الكافي: ج 5، ك 3، ب 33، ح 7.(@)(@@) والتهذيب: ج 7، ح 1244، (الاستبصار:(@)(@@) ج 3، ح 648).(@)(@@) * وروى عن زيد القتات، وروى عنه PageV02P309(@)(@@) عبد الله بن محمد.(@)(@@) الكافي: ج 2، ك 1، ب 188، ح 8.(@)(@@) * وروى عن عبد الله بن سنان، وروى عنه ابن فضال.(@)(@@) الكافي: ج 6، ك 4، ب 6، ح 7. والتهذيب:(@)(@@) ج 9، ح 147.(@)(@@) * وروى عن محمد بن سنان. وروى عنه أبو إسحاق النهاوندي.(@)(@@) التهذيب: ج 2، ح 421.(@)(@@) * وروى عن مروان بن مسلم. وروى عنه الحسن بن علي.(@)(@@) التهذيب: ج 1، ح 1525.(@)(@@) * وروى عن يحيى بن أبان، وروى عنه الحسن بن موسى.(@)(@@) الكافي: ج 2، ك 1، ب 21، ح 1.(@)(@@) * وروى مضمرة، وروى عنه الحسن بن علي الوشاء.(@)(@@) الفقيه: ج 3، ح 85.(@)(@@) * وروى مرفوعا إلى أبى عبد الله عليه السلام، وروى عنه الحسن بن علي.(@)(@@) الكافي: ج 3، ك 3، ب 90، ح 2.(@)(@@) (أحمد بن عمر الحلال) * روى عن أبي الحسن عليه السلام، وروى عنه أحمد بن محمد عمن ذكره.(@)(@@) الكافي: ج 4، ك 3، ب 
ms553	 152، ح 3.(@)(@@) وروى عنه الحسن بن علي.(@)(@@) الكافي: ج 1، ك 4، ب 9، ح 3.(@)(@@) وروى عنه موسى بن القاسم.(@)(@@) التهذيب: ج 5، ح 462 (الاستبصار:(@)(@@) ج 2، ح 812).(@)(@@) وروى عنه الوشاء.(@)(@@) الكافي: ج 1، ك 4، ب 89، ح 2، و ب 109، ح 70.(@)(@@) * وروى عن أبي الحسن الرضا عليه السلام، وروى عنه محمد بن يحيى بإسناده.(@)(@@) الكافي: ج 1، ك 2، ب 17، ح 6.(@)(@@) * وروى عن علي بن سويد، وروى عنه على بن أسباط.(@)(@@) الكافي: ج 2، ك 1، ب 32، ح 5، و ب 125، ح 3 * وروى عن ياسر، وروى عنه أحمد بن محمد بن عيسى.(@)(@@) التهذيب: ج 10، ح 590.(@)(@@) وروى عنه محمد بن عيسى.(@)(@@) الكافي: ج 7، ك 3، ب 63، ح 4.(@)(@@) * وروى هو أو غيره عن الرضا عليه PageV02P310(@)(@@) السلام، وروى عنه الحسن بن علي الوشاء.(@)(@@) الكافي: ج 1، ك 4، ب 93، ح 1.(@)(@@) (أحمد بن عمر الحلبي) * روى عن أبي عبد الله عليه السلام، وروى عنه سعيد بن جناح.(@)(@@) الكافي: ج 2، ك 7، ب 3، ح 2.(@)(@@) * وروى عن أبي الحسن عليه السلام، وروى عنه الوشاء.(@)(@@) الفقيه: ج 3، ح 199.(@)(@@) * وروى عن أبي بصير، وروى عنه عبد الله بن الحجال.(@)(@@) الكافي: ج 1، ك 4، ب 40، ح 1.(@)(@@) وروى عنه أبيه، وروى عنه ابن فضال.(@)(@@) الكافي: ج 3، ك 4، ب 26، ح 3، و ج 7، ك 1، ب 25، ح 24. والتهذيب: ج 9، ح 589.(@)(@@) وروى عنه الحسن بن علي بن فضال.(@)(@@) الفقيه: ج 4، ح 651.(@)(@@) وروى أحمد عن أبيه عنه.(@)(@@) التهذيب: ج 9، ح 901.(@)(@@) * وروى عن حماد الأزدي، وروى عنه يونس بن عبد الرحمان.(@)(@@) الروضة: ح 549.(@)(@@) * وروى عن زيد القتات، وروى عنه عبد العزيز بن عمرو الواسطي.(@)(@@) الكافي: ج 5، ك 2، ب 10، ح 7.(@)(@@) * وروى عن عبد الله بن سنان، وروى محمد وأحمد ابنا الحسن عن أبيهما عنه.(@)(@@) التهذيب: ج 9، ح 730.(@)(@@) * وروى عن يحيى بن عمران، وروى عنه عبيد الله الدهقان.(@)(@@) الكافي: ج 1، ك 1، الحديث 34.(@)(@@) (أحمد بن محمد) * روى عن أبي الحسن عليه السلام.(@)(@@) الفقيه: ج 2، ح 1063. والتهذيب: ج 9، ح 772.(@)(@@) وروى عنه الحسين بن سعيد.(@)(@@) التهذيب: ج 1، ح 179 (الاستبصار:(@)(@@) ج 1، ح 184، وفيه أحمد بن محمد عن أحمد بن محمد بن أبي نصر، عن أبي الحسن الرضا 
