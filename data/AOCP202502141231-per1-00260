ms257	 بدان رخان زیبا که مراست %~% چون خلد، وثاق تو نخواهم آراست!(@)(@@) (@@) امروز درین زمانه، خود زهره که راست؟ %~% تا گوید کان خلاف گفتی، یا راست!(@)(@@)(@@)(@@) | سماوی(@)(@@) (@@) 2567 از خون چو آب خوردنت می ترسم %~% وز ماندن خون به گردنت می ترسم(@)(@@) (@@) گفتی: «با تو کنم بسی نیکویی») %~% از گفتن وز نکردنت می ترسم!(@)(@@)(@@)(@@) | الغیره(@)(@@) ~~2568 چون لاف زنم، که دل ز درد تو به است؟تا از پی من، کمان هجرت به زه است!(@)(@@) (@@) نادوخته، زان بماند پیراهن وصل %~% کاین رشتهآ وعدهآ تو، بس پر گره است!(@)(@@) حسین هزار مرد(@)(@@) (@@) 2569 با حسن تودر عشق ملامت برسد %~% با سوز دلم ساز سلامت برسد(@)(@@) (@@) گر مدت وعدههای خود با شب من %~% در هم بندی، تا به قیامت برسد!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 257 نزدیکی و دوری، آفتابی گویی %~% تلخی وخوشی، شراب نابی گویی!(@)(@@) (@@) گر وعده کنی، زلطف آبی گویی 257 ای برده دلم، به جانم آهنگ مکن %~%(@)(@@) علالی %~% چون وعده طلب کنم، سرابی گویی! %~% بر من چودهان خود، جهان تنگ مکن(@)(@@) (@@) دی وعدة من بود، چوعهد تو پریر %~% این وعده بدان چنگ بشو، جنگ مکن!(@)(@)PageV01P422(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0426.jpg)(@)(@)(@@)(@@)(@@) | ابن طلحه(@)(@@) ~~2571 جز وعدهآ تو- گرچه ز مقصود تهی است درمان دل قرار نایافته چیست؟(@)(@@) ~~در رنگ وصال تو، چونتوان نگریست ناچار، به بوی وعده می باید زیست!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 2573 مارا بس از انتظار، رسوا شده گیر %~% رازی که نهفته بود، پیدا شده گیر(@)(@@) (@@) جان بر سر لب رسیده ما را، زغمت %~% جانی که به لب رسید، آن را شده گیر!(@)(@@) جمال الدین] عبدالرزاق(@)(@@) (@@) 2574 گه، تاب سر زلف مشوش میده %~% گه، عشوهآ این جان ستمکش می ده(@)(@@) (@@) با ما سر راستی نداری، شاید %~% باری به دروغ، وعده ای خوش می ده!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 25776 گفتم که: دهی بوسه کنون، یا فردا؟ %~% در زیر لبک به شرم گفتا: فردا!(@)(@@) (@@) مرگشت و به طعنه گفت: کاین بیچاره! %~% پنداشت، که زنده ماند او تا فردا!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 257 گفتم که به وعده 
ms258	 امشبی یا فردا %~% بگریست زجور خصم، گفتا: فردا(@)(@@) (@@) س دام امیدها، که از آدمیان 257 دوش، از سر عشوه گفت دلدارم فاش: %~%(@)(@@) وله %~% در گردن فرداست، شده تا فردا %~% ««فردا، لبم آن توست می بوس، بلاش!»(@)(@@) (@@) نهان به رقیب گفت: «دم می دهمش! %~% لغیره %~% او تا فردا کجا زید؟ فارغ باش!»)(@)(@@) (@@) 2578 روزی گفتی که: روزگاری آید %~% کز وصل منت، شبی دری بگشاید!(@)(@@) (@@) زان می ترسم، که روزگارم برود %~% وان شب، روزی روی به ما ننماید!(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 2579 روزی گفتی: شبی کنم دلشادت %~% وز غصهآ هجر خود، کنم آزادت!(@)(@@) (@@) دیدی، که از آن روز چه شبها بگذشت %~% وز گفتهآ خود، هیچ نیامد یادت!(@)(@)PageV01P423(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0427.jpg)(@)(@)(@@)(@@)(@@) | کافی ظفر(@)(@@) (@@) 2580 زان گوش به وصل تو نداریم هنوز %~% کز درد فراق در حصاریم هنوز(@)(@@) (@@) گفتی که: به هم رسیم، روزی آخر %~% عمری شد و، ما در انتظاریم هنوز!(@)(@@)(@@)(@@) | حدیشی(@)(@@) (@@) 2581 گه، زهر مرا به خوش سخن نوش کند %~% گاهیم، چو زهر خورده مدهوش کند(@)(@@) (@@) روزم ز فغان، به وعده خاموش کند %~% شب، وعدهآ کرده را فراموش کند!(@)(@@) (@@) 2582 هجران تو داد بس درشتی ما را %~% الغیره %~% روی تونکرد هیچ پشتی ما را(@)(@@) (@@) گفتی: شب وصل زنده دارم با تو %~% ای مه، برهان هین که بکشتی ما را(@)(@@)(@@)(@@) | شهری(@)(@@) (@@) 2583 بر من اثر طرب چوپیدا بودی %~% گر در سر تو، ز وصل سودا بودی(@)(@@) (@@) بر وعدهآ فردات، رخ افروختمی %~% گر بی تو، مرا امید فردا بودی!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 2584 زان پستهآ لب، جز شکرت نستانم %~% زر را، بدل سیم برت نستانم!(@)(@@) (@@) دل بردهستی، عوض جگر می دهی ام %~% جانا، عوض دل جگرت نستانم!(@)(@@)(@@)(@@) | فخر خالد(@)(@@) (@@) 2585 از بس که کنم در انتظار اندیشه %~% شغلم همه محنت است و، کار اندیشه(@)(@@) (@@) ز اندیشه چنان شدم، که در هستی خویش %~% کردم شب دوش، صد هزار اندیشه(@)(@@)(@@)(@@) | وله(@)(@@) ~~2586 جز بر دل من، عشق تو فیروز مباد کس را، چو تودلستان دلسوز مباد!(@)(@@) ~~اکنون که در انتظار، روزم 
ms259	 برسید من خود رفتم، کسی بدین روز مباد!(@)(@@)(@@)(@@) | سجاسی(@)(@@) ~~2587 گفتی در دوستی دیرینه زنمبا مهر تو، قفل بر در کینه زنم(@)(@@) (@@) در وعدهآ آن، چودست بر سینه زدی %~% جایی مرسان، که دست بر سینه زنم!(@)(@@)(@@)(@@) | مام رضی(@)(@@) ~~2583 غم نیست، که این غریب تنها نکشد وانده نبود، کاین دل شیدا نکشد(@)(@@) (@@) با این تن وجان، وعده به فردا می ده %~% باشد که خود این خسته به فردا نکشد PageV01P424(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0428.jpg)(@)(@)(@@) (@@) 258 صیدم کردی: نه دانه، نه دام، نه هیچ! %~% وله %~% مستم کردی: نه باده، نه جام، نه هیچ!(@)(@@) (@@) نفتی که: ««به نوبهار، کامت بدهم!» %~% بگذشت سه نوبهار: نه کام، نه هیچ!(@)(@@)(@@)(@@) | بغیره(@)(@@) (@@) تا چند جگر خورم، زدست ستمت؟ 2590 جانا، همه وعدههای باطل دهی ام %~%(@)(@@) نامد گه آنکه اندکی دل دهی ام؟ %~% وز جام شکر، شربت قاتل دهی ام(@)(@@)(@@)(@@) | کمال اسماعیل(@)(@@) (@@) 259 ای کار دل از غمت روان پروردن %~% درد تو به ناز، در نهان پروردن(@)(@@) (@@) شرط است، به وعدهآ توجان پروردن %~% زیرا که به یاد، جان توان پروردن(@)(@@) (@@) 259 گفتی که: چوتنها شوی اندرخانه %~% اوله %~% آیم به بر تو، تا کنم افسانه(@)(@@) (@@) شد خانه تهی زخویش و از بیگانه %~% هان! بر سر آن حدیث، هستی یا نه؟(@)(@@)(@@)(@@) | وله(@)(@@) حان الله! که چون فرو می بارد 2592 دی گفت مرا، به زیر لب خندانک: %~%(@)(@@) چندین همه لطف، از دهنی چندانک! %~% امشب، برما همی خزی پنهانک؟(@)(@@)(@@)(@@) | موفق السراج(@)(@@) (@@) 259 خود دست مراد از سر نازم ندهی %~% وز وصل به جز بهانه سازم ندهی(@)(@@) (@@) من حجت تو، به صبر کوتاه کنم %~% وله %~% تا وعده، چوزلف خود درازم ندهی(@)(@@) ~~دیدی که به وصل چند اومیدم داد 2594 یار آنچه نمود، از وفا هیچ نکرد(@)(@@) %~% می گفت، ولیک از کجا، هیچ نکرد! %~% بر ما، به جز از جور و جفا هیچ نکرد(@)(@@)(@@)(@@) | اسمعیل فارسی(@)(@@) (@@) 2590 در وعده مکن خلاف، چون دوش امشب %~% تا با تو کنم سه جام می، نوش امشب(@)(@@) (@@) مروعدهآ تونهادهام 
ms260	 گوش امشب %~% هان، تا نکنی وعده فراموش امشب PageV01P425(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0429.jpg)(@)(@)(@@)(@@)(@@) | ابوالحسن علی(@)(@@) (@@) 2597 بر وعدهآ تو سمع من آموخته گیر %~% صد شمع امید، در دل افروخته گیر(@)(@@) (@@) از پختن سودای تو، بر آتش عشق %~% گر خام بود وعده، مرا سوخته گیر!(@)(@@)(@@)(@@) | معزی(@)(@@) (@@) 2598 خورشید رخی، که عشق اوشد دینم %~% گفت: امشبی آیم، بر تو بنشینم(@)(@@) (@@) نومید شد و، گفت دل مسکینم: %~% خورشید به شب که دید؟ تا من بینم!(@)(@@)(@@)(@@) | تغیره(@)(@@) (@@) 2599 در دست غمت، دلم زبون می آید %~% وز دیده، به جای آب خون می آید(@)(@@) (@@) دردا، که مرا زهجر تو سنگ نماند %~% وین وصل تو، از سنگ برون می آید!(@)(@@)(@@)(@@) | ابوالمعالی نخاس(@)(@@) (@@) 2600 دی گفت: کنم با تو من امشب می نوش %~% چون مست شوم، کشم تورا در آغوش!(@)(@@) (@@) او نامد و، من نخفتم از حسرت دوش %~% منهاد کسی، به وعدهآ خوبان گوش!(@)(@@)(@@)(@@) | مهستی(@)(@@) (@@) 2601 کردی به سخن، پریرم از هجر آزاد %~% بر وعدهآ بوسه، دی دلم کردی شاد(@)(@@) (@@) گر زانچه پریر گفته ای، ناری یاد %~% باری، سخنان دینه بریادت باد!(@)(@@)(@@)(@@) | مرتضی(@)(@@) (@@) 2602 ای یار، کز انتظار رویت مردم %~% زنهار، کز انتظار رویت مردم(@)(@@) (@@) باری دگرم زنده کن و، باز بکش %~% وانگار، کز انتظار رویت مردم!(@)(@@)(@@)(@@) | صفی(@)(@@) ~~2603 یک ذره اگر وفات درتن بودی از جور و جفا، مرا چه شیون بودی؟(@)(@@) (@@) لطفی بودی بتا، اگر وعدهآ تو %~% چون قد و رخ تو، راست و روشن بودی!(@)(@@)(@@)(@@) | جمال خلیل(@)(@@) ~~2604 ای دوست، به کام دشمنم زار مکش یعنی که در انتظارم ای یار، مکش(@)(@@) ~~من کشتهآ هجر توام ای مه، زنهار این کشتهآ هجر را، دگر بار مکش!(@)(@)PageV01P426(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0430.jpg)(@)(@)(@@) نمط سی وچهارم(@)(@@) در شراب خوردن معشوق(@)(@@) ~~رخسارهآ او گل است و، می آتش تیز از غیرت ساغر، که لبت می بوسد(@)(@@) 2606 ای لعل لبت، چومی درون ساغر 2603 معشوقهآ من، چو در شراب آو یزد %~%(@)(@@) رضی %~% لغیره %~% لغیره %~% هر لحظه، منم تشنه به خون ساغر! %~% آتش چوبه 