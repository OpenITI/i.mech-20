ms121	 وصل جوانی کامیاب(@)(@@) 12 گر ز خودرایی خودآرایی‌که من بیخود شوم %~% نیست محتاج خودآرایی خدا را آفتاب(@)(@@) 13 بس‌که لاغر ز اشتیاقم بس‌که دلتنگ از فراق %~% بی‌خلیلم چون خلال و بی‌حبیبم چون حباب(@)(@@) 14 بی‌تو ای رشک روان بارم به رخ اشک روان %~% آنچنان‌اشکی‌که رشک از وی برد لعل مذاب(@)(@@) 15 جلوه‌خورشید و ما هم‌از توکی‌بخشد شکیب %~% کی‌شنیدستی‌که‌گردد نشنه سیراب از سراب(@)(@@) 16 سیم در سنگست سنگ اکنون ترا در سیم در %~% مشک‌در چین‌است چین‌اکنون‌ترا در مشک ناب(@)(@@) 17 در میان لعل خندان در دندانت نهان %~% چون درون حقه یاقوت لولوی خوشاب(@)(@@) 18 ساعدت‌چون‌اشک‌من‌سمین‌ولی‌هردو خضیب %~% این ز خون بیگناهان وان ز خون دل خضاب(@)(@@) 19 تا مرا زلفت دلیل دل شد اندر راه عشق %~% هر زمان با خویشتن‌گویم اذا کان‌الغراب(@)(@@) 20 پرنیان‌سوزد زآتش‌وین‌چه‌سحر است‌اینکه‌تو %~% بر عذار آتشین از پرنیان بستی نقاب(@)(@@) 21 چون ببینی چشم‌گریانم بپوشی رخ بلی %~% از نظر پنهان‌شود خورشید چون‌گرید سحاب(@)(@@) 22 قامتت را سرو ناز از راستی قایم مقام %~% طلعتت را ماه بدر از روشنی نایب مناب(@)(@@) 23 عشق رویت‌گر بلای دل به دل جویم بلا %~% مهر مویت‌گر عذاب‌جان‌به‌جان‌خواهم عذاب(@)(@@) 24 بی‌توگر زین‌بعد همچون رعد نالم دور نیست %~% وعدهمچون‌رعد نالدچون‌شود دوراز رباب(@)(@@) 25 گر دهانت نیست سیمرغ از چه باشد بی‌نشان %~% گر وصالت نیست اکسیر از چه باشد دیریاب(@)(@@) 26 هم ز سیمرغت بدل باری مرا چون‌کوه قاف %~% هم زاکسیرت به‌رخ اشکی‌مرا چون سیم ناب(@)(@@) 27 ترک می‌کن ترک من ترسم‌که خشم آرد امیر %~% گر ببیند چشمت‌از می‌چون‌دل دشمن خراب(@)(@@) 28 اعتماد دولت و دین‌کافتد اندر روزکین %~% در سپاه هفت‌کشور از نهیب او نهاب(@)(@@) 29 فارس رخش جلالت حارس اقلیم فارس %~% کز تف تیغش به بحر اندر شود ماهی‌کباب(@)(@@) 30 پیش‌جودش‌بحر جوی و نزد حلمش‌کوه‌کاه %~% پیش عزمش باد خاک و نزد قهرش نار آب(@)(@@) 31 رمح او شیر فلک را دل بدرد از طعان %~% تیغ اوگاو زمین را تن بکافد از ضراب(@)(@@) 32 ملک‌گیرد بی‌سپاه و 
ms122	 خصم بندد بی‌کمند %~% درع درد بی‌طعان و خود برد بی‌ضراب(@)(@@) 33 قدر او بدریست‌کاو را سدره آمد آسمان %~% تیغ او میغیست‌کاو را فتنه آمد فتح باب(@)(@@) 34 معشر او محشری‌کش خنجر سوزان جحیم %~% درگه او خرگهی‌کش گنبدگردان قباب(@)(@@) 35 فوج او موجی بودکاو را چرخ‌گردانست پل %~% تیر او شریست‌کاو را مغزگردانست غاب(@)(@@) 36 چهر او مهریست‌کز وی ماه اندر تاب و تب %~% قهر او زهریست‌کز وی مار اندر پیر و تاب(@)(@@) 37 عصر او قصریت‌در وی‌خفته‌یک‌کشوربه‌ناز %~% عهد اومهدیست‌در وی‌رفته‌یک‌عالم‌به‌خواب(@)(@@) 38 دفتر پیشینیان را سوخت باید فرد فرد %~% داستان باستان را شست باید باب باب(@)(@@) 39 بی‌ثنای او مقیم است آنچه در عالم رقیم %~% بی‌سپاس او عقیم است آنچه درگیتی‌کتاب(@)(@@) 40 گر نسیم لطف او درکام اژدر بگذرد %~% در دهان اژدها نوش روان گردد لعاب(@)(@@) 41 دست او بازنده ابر و تیغ او تابنده برق %~% کوس او نالنده رعد و تیر او سوزان شهاب(@)(@@) 42 عیب خلق او نه‌کز وی خصم او باشد نفور %~% مرجعل را نفرت جان خیزد از بوی‌گلاب(@)(@@) 43 یک سوار از لشکر او خصم یک‌کشور سپاه %~% یک پلنگ ازکوه بربر مرگ یک هامون‌کلاب(@)(@@) 44 ازکمال عدل او ترسم‌کزین پس‌گوسفند %~% آنچنان نازد به خودکارد شبیخون بر ذئاب(@)(@@) 45 هرکه‌گردد تشنه آبش چاره باشد ای شگفت %~% تیغ‌او آبست و چبود چاره چون شد تشنه آب(@)(@@) 46 با سپاه او روان نصرت عنان اندر عنان %~% با سمند او دوان دولت رکاب اندر رکاب(@)(@@) 47 غره اقبال و سلخ فتنه آنروزیست‌کاو %~% همچو ماه نو برآرد تیغ خونریز از قراب(@)(@@) 48 ای‌که چرخ از صولت قهر تو دارد ارتعاش %~% ای‌که دهر از هیبت تیغ تو دارد اضطراب(@)(@@) 49 خصم را ماهیت از خشم توگردد منقلب %~% گرچه در ماهیت اشیا محالست انقلاب(@)(@@) 50 التهاب تشنه راگویند آب آمد علاج %~% وین‌سخن‌نزدیک‌دانشمنددور است‌ازصواب(@)(@@) 51 زانکه تیغت تشنه خون چون شد آبش دهند %~% تا بیفزاید ورا از دادن آب التهاب(@)(@@) 52 داد بخشا داورا باشد سؤالی 
ms123	 مر مرا %~% هم به‌شرط آنکه مهلت می نجویی در جواب(@)(@@) 53 مر ترا امروز همچون من هزاران چاکرست %~% هریکی در دفتر آفاق فردی انتخاب(@)(@@) 54 هریکی را مزدهایی پایمرد امتحان %~% هریکی راگنج‌هایی دسترنج اکتساب(@)(@@) 55 هریکی را همچو افلاس من و احسان تو %~% هست‌دولت بی‌شمار و هست‌مکنت بی‌حساب(@)(@@) 56 هریکی را بندگان با صولت اسفندیار %~% هریکی را بردگان با دولت افراسیاب(@)(@@) 57 هریکی‌را صد عیال حورمنظر در حریم %~% هریکی را صد غلام ماه‌پیکر در جناب(@)(@@) 58 هریکی را قصرها هریک به رفعت آسمان %~% هریکی راکاخ‌ها هریک بطلعت آفتاب(@)(@@) 59 قصرشان چون قصر قیصر مملو از رومی لبوس %~% کاخشان چون‌کاخ خاقان محشو از چینی ثیاب(@)(@@) 60 من همانا قابل خدمت نبودم ورنه من %~% هم به قدر خویشتن بودم سزاوار خطاب(@)(@@) 61 هم مرا بودی چو دیگر چاکران قدر و جاه %~% هم مرا بودی چو دیگر بندگانت فر و آب(@)(@@) 62 نه‌چو من یک‌تن ثناخوانت‌ازینسان در حضور %~% نه‌چو من یک‌کس دعاگویت‌ازینسان‌در غیاب(@)(@@) 63 هم تو خود دانی‌که‌گر شمشیر رانندم به فرق %~% در خلوص صدق من نبود مجال ارتیاب(@)(@@) 64 شعر من شعرا و نثرم نثره هرکاو منکر است %~% گو بگو بیتی‌که تا پیدا شود قشر از لباب(@)(@@) 65 با چنان نثری مرا نبود نثاری از مهان %~% با چنین شعری مرا نبود شعیری در جواب(@)(@@) 66 گر سخن‌گویدکسی‌کاو معجز است‌و سر و وحی %~% الله‌اینک‌معجز اینک سحر و اینک وحی ناب(@)(@@) 67 نه بود شاعر هرانکو می ببافد یک دو شعر %~% نه بود بونصر هرکاو را وطن شد فاریاب(@)(@@) 68 نه بود پیل دمان هرکش بود خرطوم وگاز %~% نه بود شیر ژیان هرکس بود چنگال و ناب(@)(@@) 69 هم بجز خرطوم پیلان را بباید زور و هنگ %~% هم بجز چگال شیران را بباید توش و تاب(@)(@@) 70 پشه را خرطوم و از پیل دمان در احتراز %~% گربه را چنگال و از شیر ژیان در اجتناب(@)(@@) 71 مردواب و آدمی را بس به باطن فرقهاست 
ms124	 %~% گر به‌ظاهر همچو آدم‌جسم‌و جان دارد دواب(@)(@@) 72 چون تویی بایدکه داند شعر نیک از شعر بد %~% خضر باید تا شناسد جلوه آب از سراب(@)(@@) 73 این‌من و این‌گوی‌و این‌چوگان‌و این‌صف این‌حریف %~% هرکه می‌گوید حریفم‌گوگران سازد رکاب(@)(@@) 74 با چنین شعری مرا نبود هوای شاعری %~% وز چنین شعری روا نبود بدین فن ارتکاب(@)(@@) 75 گر نبودی شعر و شاعرکس نخواندی مر مرا %~% شاهد بختم نماندی در حجاب احتجاب(@)(@@) 76 آه ازان شعری‌که شاعر را رسد از وی زیان %~% آوخ از آن ناخلف‌کامد بلای جان باب(@)(@@) 77 هرکه آمد یک دو روز وکرد بختش یاوری %~% یافت عالی پایه‌یی زین آستان مستطاب(@)(@@) 78 غیر من‌کم بخت ‌بد در خواب و می‌دانم یقین %~% کاینچنین‌در خواب خواهد بود تا روز حساب(@)(@@) 79 از سخن‌گر نازش من خاک بر فرق سخن %~% خشک‌به‌آن‌لجه‌یی کاوراست نازش از سراب(@)(@@) 80 هست ز الطاف توام نازش ولی الطاف‌کو %~% تا به‌گردن هفت گردون را دراندازم طناب(@)(@@) 81 نه زکم ظرفیست‌گر رازم تراوید از درون %~% خس برون افتد چو آید قلزم اندر اضطراب(@)(@@) 82 تنگدل‌گشتم بسی زان شکوه سرزد از لبم %~% جام می چون‌شد لبالب ریزدش از لب شراب(@)(@@) 83 خون‌کند قی‌هرکرا زخمی‌است پنهان‌در درون %~% گرد خیزد از زمین چون خانه‌یی‌گردد خراب(@)(@@) 84 فارس قدر من نداند زانکه من زادم درون %~% در صدف فرقی‌ندارد با شبه در خوشاب(@)(@@) 85 خود بیا انصاف ده با قدردانی همچو تو %~% باید اینسان‌قدر چون من نکته‌سنجی نکته‌یاب‌(@)(@@) 86 خانه من چشم مور و خدمت من شاعری %~% ذلت من با درنگ و عزت من با شتاب(@)(@@) 87 هرکرا درکوی من افتد پس از عمری‌گذر %~% همچو عمر رفته‌اش نبود به سوی من ایاب(@)(@@) 88 روز فرش من زمین و نزل خوانم خون دل %~% شب دواجم آسمان و شمع بزمم ماهتاب(@)(@@) 89 غیر آب جاری اندر خانه من هیچ نیست %~% ور نبودی آب بودی اشک من جاری چو آب(@)(@@) 90 بیست‌تن‌ماهی‌صفت‌خوشدل‌به‌آب‌استیم و بس %~% آب‌مان باشد طعام و آب‌مان 
ms125	 باشد شراب(@)(@@) 91 تاب دلتنگی نیارد در قفس یک مرغ و بس %~% بیست‌تن در یک قفس برگو چسان آرند تاب(@)(@@) 92 خدمتی جز شعر فرما مر مراکاین روزگار %~% شاعری ننگست‌کش نتوان شنود از هیچ باب(@)(@@) 93 وز طریق لفظ و معنی بیش از این‌یک فرق نیست %~% شاعران را با یهودان ازکمال انتساب(@)(@@) 94 آن کشد خواری که از مردم ستاند جایزه %~% وین سپارد جزیه تا جان را رهاند از عذاب(@)(@@) 95 ملکهاگیری به یک‌گفتار چبودگر مرا %~% هم به‌یک‌گفتار سازی‌کامجوی وکامیاب(@)(@@) 96 من نیم دریا وکان تا باشم از جودت به رنج %~% من‌نیم‌خورشید و مه تا باشم از رایت به تاب(@)(@@) 97 شکوه از بخت زبون قاآنیا زین پس بسست %~% شکر یزدان راکه هستی مدح‌گوی بوتراب(@)(@@) 98 آنکه با مهرش ثوابست آنچه در عالم‌گناه %~% آنکه باکینش‌گناه است آنچه درگیتی ثواب(@)(@@) 99 هردو عالم از زکات بخشش او یک نصیب %~% گرچه مال او نشد هرگز پذیرای نصاب(@)(@@) 100 عفو او در روز محشر هفت دوزخ را حجیب %~% خشم او در وقت‌کیفر هشت جنت را حجاب(@)(@@) 101 مدح او ذکر شفاه وگرد او نور عیون %~% مهر او داغ جباه و حکم او طوق رقاب(@)(@@) 102 مؤمن صدیق از قهرش بنالد از عمل %~% کافر زندیق با مهرش ننالد از عتاب(@)(@@) 103 بخت‌او تختیست‌کاو را عرش یزدانست فرش %~% چهر او مهریست‌کاو را نور ایمانست ناب(@)(@@) 104 گر جنینی را نباشد داغ مهرش بر جبین %~% از مشیمه مام پوید واژگون زی پشت باب(@)(@@) 105 طاعت میکال بی‌مهرش نیفتد سودمند %~% دعوت جبریل بی‌عونش نگردد مستجاب(@)(@@) 106 تا قدومش‌گشت‌زیب‌فرش خاک از عرش پا ک %~% قدسیان را ذکر لب یالیتنی‌کنت تراب(@)(@@) 107 گر قوافی شد مکرر غم مخور قاآنیا %~% قند بود و شد مکرر اینت عذری ناصواب(@)(@@) 108 تا ببالد از وصال دوست طالب چون نهال %~% تا بنالد از فراق یار عاشق چون رباب(@)(@@) 109 هرکه یار او ببالد چون نهال از انبساط %~% هرکه خصم او بنالد چون رباب 
ms126	 از اکتئاب PageV1P104(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 بدا به حالت آن مجرمی‌که روز حساب %~% به قدر یک شب هجر تواش‌کنند عذاب(@)(@@) 2 خوشا به حالت آن زاهدی‌که در محشر %~% به قدر یک دم وصل تواش دهند ثواب(@)(@@) 3 کمند زلف خم اندر خمت ز هر تاری %~% به‌گردن دلم افکند صدهزار طناب(@)(@@) 4 حرارت تب شوقم شد از لب تو فزون %~% اگرچه‌گرمی تب برطرف‌کند عناب(@)(@@) 5 به زیر ابروی پیوسته چشم رهزن تو %~% چوکافریست‌که‌سرمست خفته در محراب(@)(@@) 6 دهان تنگ تو آن نقطه‌یی بود موهوم %~% که می نگنجد وصفش به صد هزارکتاب(@)(@@) 7 شبی ز لعل لبش بوسه‌یی طلب‌کردم %~% اشاره‌کرد به ابروکه در طلب بشتاب(@)(@@) 8 چو رفتم از دو لبش ذوق بوسه دریابم %~% رضا به بوسه ندادند آن دو لعل خوشاب(@)(@@) 9 چنانکه‌هرلب لعلش به‌عذر رنجش خویش %~% ز بهر بوسه به لعل دگر نمود خطاب(@)(@@) 10 خطابشان چو به اندازه عتاب رسید %~% فتاد لاجرم اندر میانشان شکرآب(@)(@@) 11 مکش به‌گوش من ای پارسا ز خلد سخن %~% که خلد را نخرم من به نیم جرعه شراب(@)(@@) 12 به سوی خلدکشیدی دلم اگر بودی %~% دروکباب و می و ساقی و سماع و رباب(@)(@@) 13 ز ضرب ناخن من از چه برکشد آهنگ %~% اگر نه سینه ربابست و ناخنم مضراب(@)(@@) 14 فراهم آمده در من ز جور هفت سپهر %~% جدا ز طره آشفته تو چار اسباب(@)(@@) 15 ز وصل باد به دستم ز هجر خاک به سر %~% ز ناله سینه بر آتش زگریه دیده پر آب(@)(@@) 16 به بزم هردو ز شرم محبتیم خموش %~% کجاست باده‌که بردارد از میانه حجاب(@)(@@) 17 به‌مستی ار عرق‌افشانی از جبین چه عجب %~% خمار دردسری هست و به شود زگلاب(@)(@@) 18 دهان تنگ تو را نیست‌گنج آنکه‌کند %~% بیان اجر شهیدان خود بروز حساب(@)(@@) 19 به پارهای‌کباب دلم نمک پاشند %~% دو جرعه نوش لبت وقت خوردن می ناب(@)(@@) 20 بلی عجب نبود زانکه رسم مستانست %~% که از برای‌گزک شور می‌کنندکباب(@)(@@) 21 
ms127	 گرت هواست‌که جان آفرین ببخشاید %~% بر آن‌گروه‌که هستند مستحق عذاب(@)(@@) 22 به روز حشر بدان حالتی‌که می‌دانی %~% برافکن از رخ عالم فریب خویش نقاب(@)(@@) 23 ز نشتر مژه ایما نماکه تا بزنند %~% به یک‌کرشمه رگ خواب مالکان عقاب(@)(@@) 24 به عهد عدل ملک این قدر همی دانم %~% که ملک دل نسزد از تطاول تو خراب(@)(@@) 25 ابوالشجاع بهادر شه آنکه از سخطش %~% به خواب می نرود شیر شرزه اندر غاب(@)(@@) 26 تهمتنی‌که ز یک جلوه بلارک او %~% فتد به خاک هلاکت هزار چون سهراب(@)(@@) 27 تکی ز خنگ وی وگرد و دوله در دهلی %~% غوی ز سنج وی و شور و ناله در سنجاب(@)(@@) 28 بر آستانش اگر سنجرست اگر سلجوق %~% به بارگاهش اگر بهمنست اگر داراب(@)(@@) 29 که نشمردشان‌گردون ز جرگه خدام %~% نیاوردشان‌گیتی به حلقه حجاب(@)(@@) 30 به‌کام اژدر اگر رأفتش دمی بدمد %~% عموم خلق خورند از لغت او جلاب(@)(@@) 31 شها تویی‌که پس ازکار ساز بنده نواز %~% کف‌کریم تو آمد مسبب الاسباب(@)(@@) 32 تویی‌که هست به همدستی‌کلید ظفر %~% پرند قلعه‌گشایت مفتح الابواب(@)(@@) 33 اگر عدوی تو را پرورش دهدگردون %~% همان حکایت‌میش است و صرفه‌جو قصاب(@)(@@) 34 سنان خطیت آن‌گرزه مار عقرب نیش %~% پرنگ هندیت آن اژدهای افعی ناب(@)(@@) 35 یکی بدرد ناف سمک به‌گاه طعان %~% یکی ببرد فرق فلک به وقت ضراب(@)(@@) 36 چو آن به چنگل خشم تو ویله در لاهور %~% چو این به پنجه قهر تو مویه در پنجاب(@)(@@) 37 عجب نباشد اگر صید شاهبازکند %~% به پشت‌گرمی شاهین همت تو ذباب(@)(@@) 38 ز خون دیده خصم تو می‌شدی لبریز %~% اگر نه دروا می‌بودی این‌کهن دولاب(@)(@@) 39 ستارگان همه شب تا به صبح بیدارند %~% ز بیم آنکه نبیند سطوت تو به خواب(@)(@@) 40 ز ملک دفع نماید خدنگت اعدا را %~% چنانکه رجم شیطان‌کند ز چرخ شهاب(@)(@@) 41 عیان ز ماهچه اخترت مطالع فتح %~% چو ارتفاع نجوم از خطوط اسطرلاب(@)(@@) 42 اگر ز تیغ تو برقی‌گذرکند به محیط 
ms128	 %~% محیط در خوی خجلت‌رود ز شم تراب(@)(@@) 43 به حجله‌گاه وغا خنجر تو دامادیست %~% که‌کرده است ز خون دست‌و پای خویش خضاب(@)(@@) 44 ولیک تا ندهد روگشا ز خون عدو %~% عروس فتح ز رخ بر نیفکند جلباب(@)(@@) 45 چو نام عزم تو شنود همی سپهر و دزنگ %~% چو سوی حزم تو بیند همی زمین و شتاب(@)(@@) 46 زمانه را نبود خز به خدمت تو رجوع %~% سپهر را نسزد جز به حضرت تو ایاب(@)(@@) 47 اگرچه شکل حبابست چرخ لیکن نیست %~% به نزد لجه جود تو در شمار حباب(@)(@@) 48 به سیم و زر چوکند سکه نام نیک تو را %~% ز فر نام تو صاحبقران شود ضراب(@)(@@) 49 به چرخ خواست‌کند دود مطبخ تو صعود %~% خرد به سهو سرودش به ره قرین سحاب(@)(@@) 50 چنان به‌گرد خود از ننگ این سخن پیچعد %~% که نارسیده به‌گردون شد از خجالت آ‌ب(@)(@@) 51 شبی ز روی تفاخر هلال‌گفت به چرخ %~% که باد پای ملک را منم خجسته رکاب(@)(@@) 52 جواب دادش‌کای هرزه‌گرد هرجایی %~% که از لقای تو دیوانه می‌شود بیتاب(@)(@@) 53 هزار همچو تو یک لحظه نقش می‌بندد %~% ز نیم جنبش خنگ ملک به لوح تراب(@)(@@) 54 به روز رزمگه از خون پردلان‌گردد %~% فضای معرکه آزرم بحر بی‌پایاب(@)(@@) 55 زمین شود متلاطم ز موج خون یلان %~% بدان مثابه‌که افتد سفینه درگرداب(@)(@@) 56 درون لجه خون دست و پا زندگردون %~% ز بیم غرقه شدن چون غریق در غرقاب(@)(@@) 57 زمین بتابد از تاب تیغ چون‌کوره %~% فلک بجنبد از بادگرز چون سیماب(@)(@@) 58 ز اشک چشم عدو لجه‌یی شود هامون %~% که ساق عرش‌کند تر ز جیش خیزاب(@)(@@) 59 زمانه‌جفت‌کند موزه پیش پای اجل %~% پرند جانشکرت چون برون شود ز قراب(@)(@@) 60 نهنگ سبز تو بر خویشتن سیه شمرد %~% که سرخ‌گردد از خون سرخه و سرخاب(@)(@@) 61 خدنگ‌دال پرت چون ز چرخ دال مثال %~% به‌صید نسر فلک‌بال‌و پر زند چو عقاب(@)(@@) 62 شوند بی‌پر ازان لاجرم ز 
