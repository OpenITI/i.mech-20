ms101	 جورها عني فرارا % % 18(@)(@@) % و لما اخترته ليفل عني % % شباة الدهر لم آل اختيارا % % 19(@)(@@) % و كان القرب منه جمال دنيا % % ترى أيامهاحسنا قصارا % % 20(@)(@@) % و عيشا ناضر الأفنان غضا % يرفإذا اهتصرناه اهتصارا % % PageV01P364 21(@)(@@) % فما برح العدا حتى أعادوا % % حلاوة نشوتي منه خمارا % % 22(@)(@@) % فعوضني من الأنس انحرافا ؛ % و بدلني من البشر ازورارا % % 23(@)(@@) % فصرت أرى نهاري منه ليلا % و كنت أرى به ليلي نهارا % % 24(@)(@@) % أبيتو مقلتي تذري نجيعا % و قد أفنت مدامعها الغزارا % % 25(@)(@@) % ترى الأشفار منه معصفرات % فتحسب أنها لاقت شفارا % % 26(@)(@@) % أبا الهيجاء أصبحت القوافي % % تخب إليك حجا واعتمارا % % 27(@)(@@) % عتابا كالنسيم جرى لعتب % تضرم في الحشا مني استعارا % % 28(@)(@@) % أشعشعه لأطرب سامعيه % % كما شعشعت بالماء العقارا % % 29(@)(@@) % أيجمل أن أرى منك انحرافا % و لا عارا أتيتو لا شنارا % % 30(@)(@@) % و لم أجحد صنائع منك جلت % و لم أسلبك مدحا فيك سارا % % PageV01P365 31(@)(@@) % و لكني كسوتك حلي قوم % رأيتك منهم أزكى نجارا % % 32(@)(@@) % و أي غريبة للشعر لاقت % علاكفحاولت عنها اصطبارا % % 33(@)(@@) % تحن إليك أبكار القوافي % % إذا اجتليت رواحا وابتكارا % % 34(@)(@@) % فتقرب منك أنسا بالمعالي % % و تبعد من بعولتها نفارا % % 35(@)(@@) % و يؤثرك الثناء على ملوك % تعد مقامها فيهم حسارا % % 36(@)(@@) % و كيف تلام خيرة القوافي % % إذا اختارت من القوم الخيارا % % 37(@)(@@) % تبين زهوها في العيد لما % % رأت مولى يتوجها فخارا % % 38(@)(@@) % فهزت عطفها طربا إليه % % و ألقت عن محاسنها الخمارا % % 39(@)(@@) % فإن تك هفوة عرضت سرارا % فقد أصحبتها عذرا جهارا % % 40(@)(@@) % و مما شيد الشرف المعلى % % ذنوب صادفت منك اغتفارا % % PageV01P366 41(@)(@@) % فضلت الناس فضلا واقتصادا % وإشراقا من الجدوى ابتدارا % % 42(@)(@@) % و لولا أن أعوذك من عدوي % % حسبناه لنضرته نضارا % % PageV01P367 البحر : - 1(@)(@@) % أقصر الزاجر عنه فازدجر % و طوى اللائم ما كان نشر % 2(@)(@@) % حمل الغي عليه أصره % % فإذا قيل ارعوى عنه أصر % 3(@)(@@) % قائل إن نذر الشيب بدت % % في عذاريهو ما تغني النذر % 4(@)(@@) % شعر مات على مفرقه ؛ % و حياة المرء في موت الشعر % % 5(@)(@@) % و 
ms102	 شباب جف إلا شجر % موجف منهو كم يبقى الشجر % % 6(@)(@@) % يا خليلي اطلبا وتركما % % تجداه بين كأس ووتر % % 7(@)(@@) % ساقني مستشرف الديرو قد % % راح صوب المزن فيه وبكر % % 8(@)(@@) % أهواء رق في أرجائه % أم هوى راقفما فيه كدر % % 9(@)(@@) % و خدود سفرت عن وردها % % أم ربيع عن جنى الورد سفر % % 10(@)(@@) % مجلس ينصرف الشربو ما % % طويت من بسطة تلك الحبر % % PageV01P368 11(@)(@@) % و كأن الشمس فيه نثرت % ورقا من بين أوراق الشجر % % 12(@)(@@) % بين غدر يقع الطير بها % % فتراهن رياضا في غدر % % 13(@)(@@) % و ثرى يشهد بالطيب له % % عبق حالف أطراف الأزر % % 14(@)(@@) % و غيوم نشرت أعلامها % % فلها ظل علينا منتشر % % 15(@)(@@) % و نسيم عطر الروضفإن % طار في الصبح ارتديناه عطر % % 16(@)(@@) % نحن في ظل وصال سجسج % ناعم الآصال فينان البكر % % 17(@)(@@) % و إذا الدهر رمانا صرفه % % فبعمار بن نصر ننتصر % 18(@)(@@) % يا أميرا خضع الدهر له % % فغدا يفعل طرا ما أمر % % 19(@)(@@) % و إذا الجدب عرا كان حيا ؛ % و إذا الخطب دجى كان قمر % % 20(@)(@@) % و إذا هز لمعروف مضى % % كالحسام العضبإن هز بتر % % PageV01P369 21(@)(@@) % صادق البشر ترى ماء الندى % % يرتقي في وجهه أو ينحدر % % 22(@)(@@) % فله فيه اطراد كامن % كاطراد الماء في العضب الذكر % 23(@)(@@) % قلتإذ برز سبقا في العلى % % أإلى المجد طريق مختصر % % 24(@)(@@) % إن تكن تغلب يوما وسمت % صفحة الدهر بيوم مشتهر % % 25(@)(@@) % فبنو الحارث فيهم وزر % حين لا ينجي من الدهر وزر % % 26(@)(@@) % فعدي غرر المجدإذا % % قسم المجد حجولا وغرر % % 27(@)(@@) % معشر لولا أحاديث الندى % % عنهم لم يعرف الناس السمر % % 28(@)(@@) % يا أبا اليقظان أيقظت الندى % % فملأت البدو منه والحضر % % 29(@)(@@) % و لكم أرديت من مستلئم % صادق الإقدام يحمي ويكر % 30(@)(@@) % و الضحى أدهم النقع فإن % ضحكت فيه الظبا كان أغر % PageV01P370 31(@)(@@) % موقف لو لم يكن نارا إذا % لم تكن زرق عواليه شرر % % 32(@)(@@) % ينظم الطعن على أبطاله % و عقود الهام فيه تنتشر % % 33(@)(@@) % و كأن الشمس في قسطله % كاعب أسبل سجفيها الخفر % % 34(@)(@@) % فتوخيت به 
ms103	 حمد العلى % % و القنا يخطر محمود الأثر % % 35(@)(@@) % و ثنيت الخيل عنه لابسا % حلة النصرمحلى بالظفر % % 36(@)(@@) % قد تقضى الصوم محمودا فعد % لهوى يحمدأو راح تسر % 37(@)(@@) % أنت والعيد الذي عاودته % % غرتا هذا الزمان المعتكر % % 38(@)(@@) % لذ فيك المدح حتى خلته % % سمرا لم أشق فيه بسهر % % PageV01P371 البحر : - 1(@)(@@) % أعن الأهلة في الدياجر % سفرت لناو البين سافر % 2(@)(@@) % أم عن محاجر ربرب % كشفت لنا تلك المعاجر % % 3(@)(@@) % أظباء وجرة أقصدت % ك بسحر أجفان فواتر % % 4(@)(@@) % جنت الهوى وتنصلت % % باللحظ من تلك الجرائر % % 5(@)(@@) % حتى أخذن من المنا % % طق للذي تحوي المآزر % % 6(@)(@@) % لأخاطرنو ما المنى % % في الحبإلا للمخاطر % % 7(@)(@@) % فلأوضحن صبابتي % % بالدمع في الدمن الدواثر % % 8(@)(@@) % تالله أغدر بالهوى % % مادمت مسود الغدائر % 9(@)(@@) % و لكم هصرت غصون عي % % ش مورق الأفنان ناضر % % 10(@)(@@) % و وجدت عدل الدهر حك % % م مسفه ووفاء غادر % % PageV01P372 11(@)(@@) % و على الأمير أبي المظف % فر في الندى تثنى الخناصر % % 12(@)(@@) % و عليه تزدحم العلى % % دون البرية والمآثر % % 13(@)(@@) % ملك إلى أفعاله % % تنمى المناقب والمفاخر % % 14(@)(@@) % كثرت مواهبه وقل % لت عند طالبها المعاذر % % 15(@)(@@) % و تغايرت فيه العلى % % حتى حسبناها ضرائر % % 16(@)(@@) % ذخر الثناء وفرقت % يمناه مجتمع الذخائر % % 17(@)(@@) % و أقام يعمل في العدو % ظبا العواسل والبواتر % % 18(@)(@@) % متقيلا شرف الأرا % % قم كابرا منهمفكابر % % 19(@)(@@) % أقمار مجد تنجلي % % بضيائها ظلم الدياجر % % 20(@)(@@) % و جبال أحلام تقل % لهم الأسرة والمنابر % % PageV01P373 21(@)(@@) % آساد كل كريهة % فتكت بآساد خوادر % % 22(@)(@@) % تدمى شبا أظفارها % % و الموت محمر الأظافر % % 23(@)(@@) % و ترى السوابغ والقنا % % مثل الغلائل والمخاصر % % 24(@)(@@) % كم حاولوا قسر العدو % بصولة الأسد القساور % % 25(@)(@@) % و كتائب تزجي الردى % % ما بين مدرع و حاسر % % 26(@)(@@) % و تركن وسم أهلة % في الصخر من وقع الحوافر % % 27(@)(@@) % فبكرن يحجبن الصبا % % ح بقسطل في الجو ثائر % % 28(@)(@@) % و غدواو طيب ثنائهم % % ينبيك عن طيب العناصر % % 29(@)(@@) % يا ناصر الكرم الذي % % لولاه كان بغير ناصر % % 30(@)(@@) % من كان مثلك لم تنل % معشار سؤدده العشائر % % PageV01P374 31(@)(@@) % شيم 
ms104	 إذا ما شمتها % % أغنت عن الديم الهوامر % % 32(@)(@@) % مثل الأصائل في السما % % حفإن أبى عادت هواجر % % 33(@)(@@) % و شمائل هن الشمو % % س لباطن منها وظاهر % % 34(@)(@@) % فكأنما هي روضة % منظومة فيها الأزاهر % % 35(@)(@@) % يهني المكارم أنها % % أمنت ببرئك ماتحاذر % % 36(@)(@@) % من بعد ما أنحت علي % % ك نوائب خرز النواظر % % 37(@)(@@) % فاهتز جسمك مثلما % % يهتز ماضي الحد باتر % % 38(@)(@@) % لازال لطف الله يد % رأ عنك مكروه الدوائر % % 39(@)(@@) % و سرت إلى أعدائك الأ % % حداث بالأجل المسافر % % 40(@)(@@) % لاحظت ربعكفاكتحل % ت بمخصب الجنبات زاهر % % PageV01P375 41(@)(@@) % و وردت بحرا منك مح % % مود الموارد والمصادر % % 42(@)(@@) % و تركت مدحك سائرا % في الناس من باد وحاضر % % 43(@)(@@) % فتحل منه محبر الأ % % برادمنظوم الجواهر % % 44(@)(@@) % لم يعز در عقوده % % إلا إلى بحر الخواطر % % PageV01P376 البحر : - 1(@)(@@) % سر سرك اللهفيما أنت منتظر % فقد جرى بالذي تهوى لك القدر % 2(@)(@@) % و أظفرتك بما أملت أربعة % النصر والفتح والإقبال والظفر % 3(@)(@@) % لم يعل نجمك في أعلى مطالعه % % حتى غدت أنجم الأعداء تنتشر % 4(@)(@@) % و كيف يبعد أمر أنت طالبه % % و الله طالبه والبدو والحضر % 5(@)(@@) % يا ناصر الدولة استعجل إجابتها % % فقد دعتكو ما في صفوها كدر % 6(@)(@@) % ملك تجدد لم يدم السنان له % % عزا ولم يتحل الصارم الذكر % 7(@)(@@) % باب السعادة مفتوح لداخله % % و أنت داخلهو السادة الغرر % 8(@)(@@) % فالملك مبتسم و الأمر منتظم % و الدهر من دولة الأوغاد يعتذر % 9(@)(@@) % فما انتظاركو الآفاق ناظرة % إليكو الحضرة الغراء تنتظر % 10(@)(@@) % و قد نجا البدرإذ طاف الكسوف به % % و زال عن مشتهيه الخوف والحذر % PageV01P377 البحر : - 1(@)(@@) % أربعاء حسامه مشهور % حين يأتيو شره محذور % 2(@)(@@) % نتوقاه أول الشهرإن دا % % رو نخشاه آخرا لا يدور % 3(@)(@@) % فاغد سرا بنا إلى قفص المل % حيفالعيش فيه غض نضير % 4(@)(@@) % نتوارى من الحوادثو الده % % ر خبير بمن توارى بصير % 5(@)(@@) % منزل في فناء دجلة يرتا % % ح إليه الخليع والمستور % 6(@)(@@) % طائر في الهواءفالبرق يسري % % دون أعلاهو الحمام يطير % 7(@)(@@) % و إذا الغيم سار أسبل منه % % حلل 
ms105	 حول جدره وستور % 8(@)(@@) % فإذا غارت الكواكب صبحا % فهو الكوكب الذي لا يغور % 9(@)(@@) % ليس فيه إلا خمار وخمر % و ممات من سكره ونشور % 10(@)(@@) % و حديث كأنه زهر السو % % سن حسنا أو لؤلؤ منثور % PageV01P378 11(@)(@@) % و جريح من الدنان يسيل الر % راح من جرحهو قدر تفور % 12(@)(@@) % و لك الظبية الغريرةإن شئ % تفإن عفتهافظبي غرير % 13(@)(@@) % فتنعم بها نهارا و بتيا % % سيدي معرسا و أنت أمير % 14(@)(@@) % كل هذا بدرهمينفإن زد % تفأنت المبجل المحبور % 15(@)(@@) % فهو شيخ رأى القيادة عيشا % كل عيش سواه إفك وزور % 16(@)(@@) % و من الجور أن يلام علي % و هو عندي في فعله معذور % 17(@)(@@) % ترك الملح والتجارة فيه % % إذرآها تجارة لا تبور % 18(@)(@@) % فتيمم بنا السرور إليه % % إن يوم السرور يوم قصير % PageV01P379 البحر : - 1(@)(@@) % ثنت لك أعطافها والخصورا % % و أعطتك أجيادها والنحورا % % 2(@)(@@) % تصدت لناو الهوى أنة % فصدتو قد غادرته زفيرا % % 3(@)(@@) % و كانت ظباء ترود اللوى % % فأضحت شموسا ترود الخدورا % % 4(@)(@@) % فراق أصاب جوى ساكنا % فكان له يوم سلع مثيرا % % 5(@)(@@) % و ساجي الجفونإذا ماسجى % % أغار المها دعجا أو فتورا % % 6(@)(@@) % أغرر بالنفس في حبه % % و آلف منه غزالا غريرا % % 7(@)(@@) % و أعتد زورته في الكرى % % نوالا لديو إن كان زورا % % 8(@)(@@) % لقد جهل الدهر حق الأريب % و مازال بالدهر طبا خبيرا % % 9(@)(@@) % عزائمه شعل لو سطت % على الليل عاد ضياء منيرا % % 10(@)(@@) % إذا ما توعر خطب سرى % % ففل سهول الفلا والوعورا % % PageV01P380 11(@)(@@) % نزور أغر تغار العلى % % عليهو يلفى عليها غيورا % % 12(@)(@@) % إذا المجد أنجز ميعاده % % أعاد وعيد الليالي غرورا % % 13(@)(@@) % يعد من الأزد يوم الفخار % ملوكا حوت تاجها والسريرا % % 14(@)(@@) % يريك النديإذا ما احتبوا % % بدور المحافل تحبو البدورا % % 15(@)(@@) % و تجلب من كرم في الندى % % فإن أجلب الدهر أضحى وقورا % % 16(@)(@@) % أقول لمن رام إدراكه % % و ما رام من ذاك إلا عسيرا % % 17(@)(@@) % عزاؤك إن عز نيل السهى % % و صبرك لست تنال الصبيرا % % 18(@)(@@) % سلامةيا خير من يغتدي % % سليم الزمان به مستجيرا 
ms106	 % % 19(@)(@@) % إلى كم أحبر فيك المديح % و يلقى سواي لديك الحبورا % % 20(@)(@@) % لهمت عرائسه أن تصد ؛ % و همت كواكبه أن تغورا % % PageV01P381 21(@)(@@) % أتسلمني بعد أن أوجدت % % على نوب الدهرجارا مجيرا % % 22(@)(@@) % و أسفر حظي لما رآك % % بينيو بين الليالي سفيرا % % 23(@)(@@) % و كم قيل ليقد جفاك ابن فهد % و قد كنت بالوصل منه جديرا % % 24(@)(@@) % فقلتالخطوب ثنت وده % فلم يبق لي منه إلا يسيرا % % 25(@)(@@) % سأهدي إليك نسيم العتاب % و أضمر من حر عتب سعيرا % % 26(@)(@@) % معان إذا ظهرت دبجت % بطون المديح له والظهورا % % 27(@)(@@) % تبرج للفكر أنسا به % % و طورا تخفر عنه نفورا % % 28(@)(@@) % تراءت له كسطور البروق % و قد رامها فشآها سطورا % % 29(@)(@@) % فيهنك أن حل وفد السرور % و أزمع وفد الصيام المسيرا % % 30(@)(@@) % فلا فضل للعود حتى يحن ؛ % و لا حمد للكأس حتى يدورا % % PageV01P382 31(@)(@@) % فقد جدد الدهر ظلا ظليلا % و روضا أريضا و ماء نميرا % % 32(@)(@@) % و حل الربيع نطاق الحيا % % فغادر في كل سهل غديرا % % 33(@)(@@) % هواء بنا شره حسرا % فنقسمه ساجيا أو حسيرا % % 34(@)(@@) % و زهر إذا ما اعتبرنا النسيم % حسبناه يمسح منه العبيرا % % 35(@)(@@) % و روض يراق بماء الحياة % فنواره يملأ العين نورا % % 36(@)(@@) % جلا البرق عن ثغره ضاحكا % إليهفأضحك منه الزهورا % % 37(@)(@@) % و سافره الرعد مستعطفا % فقد سفر الورد فيه سفيرا % % 38(@)(@@) % و مالت من الري أشجاره % % كأن السواقي سقتها الخمورا % % 39(@)(@@) % و ولت صوادر منشورة % و قد ملأ الحزن منه الصدورا % % 40(@)(@@) % أوان تحييك أنواره % % رواحا بأنفاسهاأو بكورا % % PageV01P383 41(@)(@@) % و شهر يشهر ثوب الثرى % % و ينظم بالطل فيه شذورا % % 42(@)(@@) % أعاد عبوس الربا نضرة % و شيب الغصون شبابا نضيرا % % 43(@)(@@) % فسل الجداول سل الذكور % و أغمض للبيض بيضا ذكورا % % 44(@)(@@) % و دل على عدله أننا % % نرى القر معتدلا و الهجيرا % % 45(@)(@@) % فلازلت مغتبطا ما حييت % بعيد يعيد عليك السرورا % % 46(@)(@@) % بكاس بكف خلوب اللحاظ % % تخلب شرابها والمديرا % % 47(@)(@@) % إذا هو عاينها بالمزاج % رأى غدرها لهبا مستطيرا % % 48(@)(@@) % تشير إليك بها كفه 
ms107	 % و قد مثلت لك كسرى مشيرا % % 49(@)(@@) % بحلة ورد إذا ردها % % على الشرب عاودها مستعيرا % % 50(@)(@@) % تحف بها صور لاتزال % عيون الندامى إليهن صورا % % PageV01P384 51(@)(@@) % فلو أن ميتا يلاقي النشور % بنشر المدامة لاقى النشورا % % 52(@)(@@) % و فكر خواطره ألبست % علاك من المجد ثوبا خطيرا % % 53(@)(@@) % محاسن لو علقت بالقتير % لحسن عند الحسان القتيرا % % 54(@)(@@) % إذا ما جفت خلع المادحين % عليهنرقت فكانت حريرا % % PageV01P385 البحر : - 1(@)(@@) % ما سره أن زاع من أسراره % % ما غيب الكتمان في إضماره % % 2(@)(@@) % تأبى العبارة عن هواه فينبري % % جفن يعبر عنه في استعباره % % 3(@)(@@) % أخفاه بين ضلوعه فجفت به % % حرق تظاهره على إظهاره % % 4(@)(@@) % أنى يكون القصد شيمة وجده % % يوم النوى و الجور شيمة جاره % % 5(@)(@@) % هل ينجدن فريق نجد بعدما % % غارت نجوم الحسن في أغواره % % 6(@)(@@) % نهدي التحية منهم لمحجب % عبراتنا أبدا تحية داره % % 7(@)(@@) % و ضعيف عقد الخصر راب ردفه % ظلم الجمال نطاقه لإزاره % % 8(@)(@@) % و مودع ظفرت يداه بمهجتي % % فمضى ونضح دمي على أظفاره % % 9(@)(@@) % أقصرت عن ذكر السلوو قصرت % % همم العذولفعاد في إقصاره % % 10(@)(@@) % و غنيت بالساقي الأغن لأنه % % وزر يزيد الصب من أوزاره % % PageV01P386 11(@)(@@) % ظفرت يداه بمهجة الدن الذي % % غبرت وديعة صدره وصداره % % 12(@)(@@) % فصباحها من ليلهو نسيمها % % من تربهو عقيقها من قاره % % 13(@)(@@) % قل للعذول إليك عن ذي عدة % ما ثار إلا نال أبعد ثاره % % 14(@)(@@) % صل إذا ما افتر عن أنيابه % % من سمه قطرت على أشفاره % % 15(@)(@@) % لو أنه جارى عتيقي طيء % في الحلبتين تبرقعا بغباره % % 16(@)(@@) % مازال ينجده ابن فهد ناصرا % حتى أعاد الدهر من أنصاره % % 17(@)(@@) % جاورت منه غزير جمات الندى % % و البحر يغني جاره بجواره % % 18(@)(@@) % و أغر ما طلعت أسرة وجهه % % إلا استسر البدر قبل سراره % % 19(@)(@@) % مثل الشهاب محرقا أو كاسفا % ظلم الخطوب بنوره أو ناره % % 20(@)(@@) % أو كالحسامإذا مضى في مشهد % شهدت مضاربه بعتق نجاره % % PageV01P387 21(@)(@@) % أو كالربيع الطلق واجه قطره % % وجه الثرى فاخضر من أقطاره % % 22(@)(@@) % خلق سهول المكرمات سهوله % % و توعر الأيام 
ms108	 من أوعاره % % 23(@)(@@) % إن لاحفهو الصبح في أثوابه ؛ % أو فاحفهو الروض في نواره % % 24(@)(@@) % نزلت على حكم القنا أعداؤه % لما أشار إليهم بشراره % % 25(@)(@@) % و ارتد من جاراه مضمر حسرة % لما جرى للمجد في مضماره % % 26(@)(@@) % عزم يذب عن العلا بذبابه % أبدا و يحمي عزها بغراره % % 27(@)(@@) % و مكارم تعلي ذرى أطواده % % في الأزدأو تذكي سنا أقماره % % 28(@)(@@) % يا خيرة المجد الذي ورث العلى % % من فهد الأدنى و من مختاره % % 29(@)(@@) % بكر الثناء عليكفاخلع عونه % % و البس جديد الحلي من أبكاره % % 30(@)(@@) % و اسلمفقد سلمت خلالك كلها % % من عر أخلاق اللئيم وعاره % % PageV01P388 31(@)(@@) % و تحلها من عائذ بكواثق % دهرا سهام الظلم في أوتاره % % 32(@)(@@) % ألبسته برد الغنى و سللته % % من عدمهفانسل من أطماره % % 33(@)(@@) % قد كان هيض جناحهفجبرته % % بنداكحتى طار في أوطاره % % 34(@)(@@) % فجفى المواطن والأحبة ناسيا % من لا يفيقالدهرمن تذكاره % % 35(@)(@@) % لولا ربيع نوالك الغمر الندى % % ما كان يذهل عن ربيع دياره % % 36(@)(@@) % نشر الثناءفكان من إعلانه % % و طوى الودادفكان من أسراره % % 37(@)(@@) % كالنخل يبدي الطلع من أثماره % % حينا ويخفي الغض من جماره % % PageV01P389 البحر : - 1(@)(@@) % هل الصبر مجد حين أدرع الصبرا % % و هل ناصر للشعر يوسعه نصرا % % 2(@)(@@) % تحيف شعرييا ابن فهد مصالت % ظلوم فقد أعدمت منهو قد أثرى % % 3(@)(@@) % و في كل يوم للغبيينغارة % تروع ألفاظي المحجلة الغرا % % 4(@)(@@) % إذا عن لي معنى تضاحك لفظه % % كما ضاحك النوار في روضه الغدرا % % 5(@)(@@) % غريب كسطر البرق لما تبسمت % مخائله للفكر أودعته سطرا % % 6(@)(@@) % فوجه من الفتيان يمسح وجهه ؛ % و صدر من الأقوام يسكنه صدرا % % 7(@)(@@) % تناوله مثر من الجهل معدم % من الحلممعذور متى خلع العذرا % % 8(@)(@@) % فبعد ما قربت منه غباوة % ورددما سهلت من لفظهوعرا % % 9(@)(@@) % فمهلا أبا عثمانمهلا فإنما % % يغار على الأشعار من عشق الشعرا % % 10(@)(@@) % لأطفأتما تلك النجوم بأسرها % % و دنستما تلك المطارف والأزرا % % PageV01P390 11(@)(@@) % فويحكما هلا بشطر قنعتما % % و أبقيتما لي من محاسنها شطرا % % 12(@)(@@) % لئن وترت كفي سعيد بن هاشم % فقد نال من شعري بغارته 
ms109	 الوترا % % PageV01P391 البحر : - 1(@)(@@) % أمن المدامة تنثني سكرا % % أم قد سقتك جفونها خمرا % % 2(@)(@@) % نثرت فريد الدمع حين رأت % صبا يقاد إلى الردى نثرا % % 3(@)(@@) % إن الوداعو إن سعدت به % % ليزيد كامن لوعتي حرا % 4(@)(@@) % لما رأت للبين رائعة % تطوي الوصالو تنشر الهجرا % % 5(@)(@@) % ضاقت بأدمع ها الجفون كما % % ضاق المودع بالهوى صدرا % % 6(@)(@@) % و إذا رأيت نوالهم ثمدا % فالحظ بين طلابك البحرا % % 7(@)(@@) % اكفف يديك عن اللئامو لو % % أضحت يداك من الغنى صفرا % % 8(@)(@@) % و إلى الأمير سريت مرتديا % بعزيمة تدع الدجى فجرا % % 9(@)(@@) % و أغر نهد لو طلبت به % % شأو الجنائب بذها حضرا % % 10(@)(@@) % طرفا إذا ما اختالخلت به % % صلفا من الإعراضأو كبرا % % PageV01P392 11(@)(@@) % ينسيك صبغ أديمه الخمرا ؛ % و تريك غرة وجهه البدرا % % 12(@)(@@) % لا يستقر كأن أربعه % % فرش يطا من تحتها الجمرا % % 13(@)(@@) % و كأنهلما كتسى عرقا % ورقالشقائق يحمل القطرا % % 14(@)(@@) % يجري ويعطفه العنان كما % % عطف القضيب وقد غدا نضرا % % 15(@)(@@) % حمد العفاةفطال حمدهم % بندى الأمير علي الدهرا % % 16(@)(@@) % أدنى المكارمو هي نازحة % بالجود منهو شرد العسرا % % 17(@)(@@) % نشرت له غر الصنائع في % % شرق البلاد وغربها ذكرا % % 18(@)(@@) % و النورإن جاد الغمام به % % حملت له ريح الصبا نشرا % % 19(@)(@@) % يلقاه راجي الجود مبتسما % سهل الخلائق لابسا بدرا % % 20(@)(@@) % عزماتهفي كل مظلمة % سيف يضيء البدو والحضرا % % PageV01P393 21(@)(@@) % يقظان ينتجع الحتوف وقد % % جعل السبيل إلى العلى الصبرا % % 22(@)(@@) % في فتية جعلوا معاقلهم % % بيض الصفائح والقنا السمرا % % 23(@)(@@) % يرد الندى ورد الظماء على % % نهل يبرد منهم الحرا % % 24(@)(@@) % بمثقفات يحتملنو قد % % حملت نجوما في الوغى زهرا % % 25(@)(@@) % و صوارم خضر مضاربها % % تكسو الرجال عمائما حمرا % % 26(@)(@@) % فكأن أطراف القنا حدق % ترنو إلى مقل العدا شزرا % % 27(@)(@@) % و كأن سابغة الدروع ضحى % غدر تمر بها الصبا مرا % % 28(@)(@@) % قوم إذا اسود الزمان غدت % أيمانهم بفعالهم غرا % % 29(@)(@@) % سادواو سادهم أبو حسن % بعلى تزين النظم والنثرا % % 30(@)(@@) % ملك إذا استلت صوارمه % % ذهبت دماء عداته هدرا % % PageV01P394 31(@)(@@) % ظلم العدا والمالحين سطا % % بأسا و أتبع 
ms110	 نائلا غمرا % % 32(@)(@@) % لا زال يظلم في سطاه وفي % % نفحاته الأعداء والوفرا % % PageV01P395 البحر : - 1(@)(@@) % غصبان ينسانيو أذكره % % و ينام عن ليليو أسهره % % 2(@)(@@) % و بجوره ما صار مورقه % % حظيو حظ سواي مثمره % % 3(@)(@@) % و كفى الهوى لو كان مكتفيا % ما رحت أضمره وأظهره % % 4(@)(@@) % لم يقتسم في العاشقين أسى % إلا وقسمي منه أوفره % % 5(@)(@@) % فأطيح في نفس أصعده % % و أعوم في دمع أحدره % % 6(@)(@@) % و سمير نجم لا براح له % % و كأنما ملك يسمره % % 7(@)(@@) % و مهفهف هفت العقول به % % شغفا تخيرهن أحوره % % 8(@)(@@) % إن لم يكن وهب الغزال له % % لحظات مقلته فجؤذره % % 9(@)(@@) % وافى بخمرته وناظره % % بالفتر يسكرها وتسكره % % 10(@)(@@) % حمراء كالياقوت صافية % و معظم الياقوت أحمره % % PageV01P396 11(@)(@@) % فهي التي عصرت لقاطفها % % عنقودها من قبل يعصره % % 12(@)(@@) % في كأسه كسرى يقابله % % من خلف ستر الراح قيصره % % 13(@)(@@) % فكأنها نار هما حصب % لحريقها العالي يسعره % % 14(@)(@@) % أصلى لها هذا تمجسه % % و أحلها هذا تنصره % % 15(@)(@@) % في زاهر عبق تضوعه % % فكأن عطارا يعطره % % 16(@)(@@) % ضاهى ممسكه معنبره % % و حكى مدرهمه مدنره % % 17(@)(@@) % و حكى غديرا غادرته لنا % % خضر النبات يرف أخضره % % 18(@)(@@) % صاف تمد الريح خطوتها % % و يفيض فيهفلا تكدره % % 19(@)(@@) % مثل الرداء يكفصانعه % % يطويه أحيانا وينشره % % 20(@)(@@) % شاد الأمير بناء مكرمة % لا يستطيع النجم يعشره % % PageV01P397 21(@)(@@) % وسماؤه الكرم الذي شرقه % % فيه أسرته ومنبره % % 22(@)(@@) % و كأن قدسا أو متالعه % % وهب الوقار له يوقره % % 23(@)(@@) % و مغيم يوم السخط مظلمه % % و مضيء ليل البشر مقمره % % 24(@)(@@) % و كأنه في الغيب مطلع % للأمر يورده ويصدره % % 25(@)(@@) % و إذا الأنامل أرعشت حذرا % فشفاء من علقته خنصره % % 26(@)(@@) % و إذا تلجلج قائل حصرا % و أمات حجته تحيره % % 27(@)(@@) % فتق المسامع بالصوابو لم % % تنجد بديهته تفكره % % 28(@)(@@) % من حيث لا معنى يعقده % % عيا و لا لفظ يكدره % % 29(@)(@@) % فمتى أراد الجحد حاسده % % شهدت غمائمه وأبحره % % 30(@)(@@) % و إذا طمى في البر بحر وغى % لا شيءإلا السيفمعبره % % PageV01P398 31(@)(@@) % أبصرت عسكر نجدة تحيا % منهإذا ما شام عسكره 
ms111	 % % 32(@)(@@) % حيث الظبا بالهام عاثرة % و الصبح مثل الليل غثيره % % 33(@)(@@) % يردي العدا بالضرب أبيضه % % و يبيدهم بالطعن أسمره % % 34(@)(@@) % سرب الحديثة راضيين به % % في مأمن ممن ينفره % % 35(@)(@@) % إن زاد عنها ما يروعها % % فالغاب يدفع عنه قسوره % % 36(@)(@@) % فليحي في ظفر وعاش له % % في نعمة أبدا مظفره % % 37(@)(@@) % ولد علت بركات مولده % % سعدا و طهره مطهره % % 38(@)(@@) % ضاهى أباه سماحة وحجى % % و حكاه مرآه ومخبره % % 39(@)(@@) % أأبا شجاع يا عقيد ندى % كرمت أرومته وعنصره % % 40(@)(@@) % الله يعلم كيف أحمد ما % % أوليتنيهو كيف أشكره % % PageV01P399 41(@)(@@) % و نداك لا تنسى مواعده % % كرما فما أحتاج أذكره % % 42(@)(@@) % لكن إحسانا تقدمه % % أولى به مما تؤخره % % 43(@)(@@) % و مداك إن جاد المداء به % غمر الثناءنداك يغمره % % PageV01P400 البحر : - 1(@)(@@) % يا أبا إسحاق زاد ال % % له في حسن حبورك % 2(@)(@@) % و غدا شانيك ذا هم % م طويل بسرورك % 3(@)(@@) % عمر الله بطلا % ب الندى أبواب دورك % 4(@)(@@) % أشرق الدهرو ما إش % % راقه إلا بنورك % 5(@)(@@) % و أرى الأيام لا تب % خل إلا بنظيرك % 6(@)(@@) % قلت للحاسدصبرا % إذ نوى نيل صبيرك % 7(@)(@@) % أنت غيث لموالي % % كو ليث لمثيرك % 8(@)(@@) % فالورى في برد آصا % % لكأو حر هجيرك % 9(@)(@@) % لا تنبي عن معالي % % ك الورى مثل خبيرك % 10(@)(@@) % شدت علياك بتغلي % % سك فيها وبكورك % PageV01P401 11(@)(@@) % ظاهرا للحمد تنبي % % ه على بعد ظهيرك % 12(@)(@@) % كيفما جردت أقلا % % مك أغنت عن ذكورك % 13(@)(@@) % فكأن الدهر قد سط % طر ما بين سطورك % 14(@)(@@) % بدع ترتع منها ال % % عين في وشي حبيرك % 15(@)(@@) % حسبنا من جودك العم % % رو من فيض بحورك % 16(@)(@@) % قد أتانا منه ما زا % % د على شكر شكورك % 17(@)(@@) % بين صفر من دناني % % ركأو صفر خمورك % 18(@)(@@) % فاشفع العرف بعرف % ترتضيه من بخورك % 19(@)(@@) % وبق لا أقصر صوب ال % % مزن عن فيح قصورك % PageV01P402 البحر : - 1(@)(@@) % أبا جعفر كانت يداك سحائبا % تفيض على الركب العفاة غزارها % % 2(@)(@@) % فما للندى قد سد منك سبيله % و ما للمعالي عطلت منك دارها % % 3(@)(@@) % لقد 
ms112	 قبضت كيد المكارم كفه % % و قل على رغم العفاة غزارها % % 4(@)(@@) % فأظلمت الآفاق بعد محمد % فسيان منها ليلها ونهارها % % PageV01P403 البحر : - 1(@)(@@) % شباب المرء ثوب مستعار % و أيام الصبا أبدا قصار % 2(@)(@@) % طوى الدهر الجديد من التصابي % % و ليسلما طوى الدهرانتشار % 3(@)(@@) % و لم نعط المنى في القرب منه % % فكيف بهاو قد شط المزار % 4(@)(@@) % صدود في التقارب واجتناب % و شوق في التباعد وادكار % 5(@)(@@) % يطولإذا تقاصرت الليالي % % و يقربإن تباعدت الديار % 6(@)(@@) % لحى الله العراق وساكنيه % فما للحر بينهم قرار % 7(@)(@@) % و جاد الموصل الغراء غيث % يجودو للبروق به انسفار % 8(@)(@@) % كما انهلت مدامع مستهام % تلهب منه في الأحشاء نار % 9(@)(@@) % ففي أيامها حسن التصابي ؛ % و في أفيائها خلع العذار % 10(@)(@@) % ليالي كان لي في كل يوم % إلى الحانات حج واعتمار % PageV01P404 11(@)(@@) % فعن ذكر القيامة بي صدود ؛ % و عن ساح المساجد بي نفار % 12(@)(@@) % و لي خدنان همهما المعالي % % و شأنهما السكينة والوقار % 13(@)(@@) % و ساق تضحك الدنيا إليه % % إذا ضحكت بكفيه العقار % 14(@)(@@) % يطوف بهاو قد حملت حبابا % كما حمل السقيط الجلنار % 15(@)(@@) % كأن الشرب ينتهبون نارا % لها لهب و ليس لها شرار % 16(@)(@@) % رأى الدهر اجتماع الشمل منا % % فشتتهو للدهر الخيار % 17(@)(@@) % و بدلني بأخدان المعالي % % أناسا فعلهم شين وعار % 18(@)(@@) % مساجب لست أغشاهمو لا لي % % من الأيام بينهم انتصار % 19(@)(@@) % هم شجر من التمويه أكدى % % فلا ظل لديهو لا ثمار % 20(@)(@@) % فمغبوط و ليس له عشاء ؛ % و محسود و ليس له دثار % PageV01P405 21(@)(@@) % و مقصور الندى قصرت يداه % % فلا نفع لديهو لا ضرار % 22(@)(@@) % و معتصب بتاج الملك فيه % إلى من رام نائله افتقار % 23(@)(@@) % أسير في يد الأيام راض % بما يجري به الفلك المدار % 24(@)(@@) % إذا حكم العبيد عليه فاضت % لفرط الذلأدمعه الغزار % 25(@)(@@) % فما يخشى سطاهالدهر جان ؛ % و لا يرجو نداهالدهرجار % 26(@)(@@) % أأقعد بالعراق أسير دهر % غريبا لا أزور ولا أزار % 27(@)(@@) % و في غربي دجلة لي محل % جوار المكرمات له جوار % 28(@)(@@) % و سيد 
ms113	 معشر كرموا وسادوا % % يجير على الخطوب ويستجار % 29(@)(@@) % يهز على النوائب منه عضبا % حساما لا يفل له غرار % 30(@)(@@) % له من جوهر الآداب حلي % و للأسياف حلي مستعار % PageV01P406 31(@)(@@) % تشبه في الفعال به أناس % و أنى يشبه الشبه النضار % 32(@)(@@) % جلت عزماته نوب الليالي % % كما يجلو دجى الليل النهار % 33(@)(@@) % و شاد المجد بالأفضال حتى % % تناهى في العلو به الفخار % 34(@)(@@) % فما فيه عن المعروف منع ؛ % و لا فيه عن الحمد ازورار % PageV01P407 البحر : - 1(@)(@@) % للخالديين جمال منظر % و بزة تملأ عين المبصر % 2(@)(@@) % و العار في فعلهما المشهر % تشابها في منظر ومخبر % 3(@)(@@) % و اشتركا إلى الممات في حر % يحرثه جد فدان الأصغر % 4(@)(@@) % و الزرع إن تم بهللأكبر % أقولإذ هما بأمر منكر % 5(@)(@@) % وراء ستر لهما لم يستر % و اعتفرا ظبي الصريم الأعفر % 6(@)(@@) % و اقتسما باللحظ في المعجر % و جمشا الورد بورد أحمر % 7(@)(@@) % و لعبت أيديهما في القرقر % أيهما بعل الغزال الأحور % 8(@)(@@) % أصاحب الشيبة لم يغير % أم الخضيبذي الصبا المزور % 9(@)(@@) % و كم قبيح لهما مستر % في كل مبدى نازح و محضر % 10(@)(@@) % يسفر عن ضد الصباح المسفر % و ذات وجه كصفا المشقر % PageV01P408 11(@)(@@) % لو رضه الحافر لم يؤثر % خلة بعلين وخل مضمر % 12(@)(@@) % يعجبها وقع خراب البربر % و هي معناة بكل أسمر % 13(@)(@@) % أحين أضحى شيبها كالمغفر % و جاوزت عصر الفتاة المعصر % 14(@)(@@) % حنت إلى كل قمد أعجر % فعنبرت شيئا كلون العنبر % 15(@)(@@) % و لبة في لبب من جوهر % و جلست بين غثا و أغثر % 16(@)(@@) % فشربامن ثغرها المؤشر % ريقا كريق النحلة المزعفر % 17(@)(@@) % و جاذبا مئزر بسل المئزر % فلقيا شنيرها بقنبر % 18(@)(@@) % طعان يوم ضاحك مستبشر % لم تعثر الخيل به في عثير % 19(@)(@@) % ينسى به المطعون فرط المنكر % و لو حكت عرس الضرير الأبخر % 20(@)(@@) % و زوجة ابن العصب المخكر % و هي وق ود النار يوم المحشر % PageV01P409 21(@)(@@) % و كيف للأعمى بحظ الأعور % معرة لو فاض ماء الكوثر % 22(@)(@@) % و انهل حنان الغمام الممطر 
ms114	 % و برقت لجة بحر أخضر % 23(@)(@@) % حتى ترى ساحة بر أقفر % على الذي هما به لم يظهر % 24(@)(@@) % إني على سلبكما لمجتري % % و في الذي أطلقت غير مقتر % 25(@)(@@) % فاستمعا حسناء لو لم تهجر % حلى بها الخاطب جيد المنبر % PageV01P410 البحر : - 1(@)(@@) % نوال أبي نصر على الدهرناصر % وفت لي به الأيام وهي غوادر % 2(@)(@@) % نظمنا له در الكلامو إنما % % ينظم في الأشعار ما هو ناثر % 3(@)(@@) % أغرإذا ما الحادثات تنكرت % تبلج لي معروفهو هو سافر % 4(@)(@@) % و هل يتعدى الحادث النكر أمره % % و في كفه للدهر ناه وآمر % 5(@)(@@) % من الرقشأعلاه سنان مذرب % و أسفله عضب الغرارين باتر % 6(@)(@@) % و لم أر سيفا يرتدي الوشي قبله % % و تنثر عند الهز منه الجواهر % 7(@)(@@) % فلا راكبا في ظلمة الليل سائرا % مطيته بحر من الخوف زاخر % 8(@)(@@) % و لا مفردا يثني الكتائب بأسه % و يرتاع منه دارع و هو حاسر % 9(@)(@@) % يريك العطايا والمناياإذا جرى % % لوامع في الوشي الذي هو ناشر % 10(@)(@@) % و لما أتتني من يديك صنيعة % شكرتك إني للصنائع شاكر % PageV01P411 11(@)(@@) % و أحسن من يجزى على الحمد كاتب % يسربله وشي الفصاحة شاعر % 12(@)(@@) % يمت إليكم بالقرابةإننا % % عشائر قربى حين تنأى العشائر % 13(@)(@@) % أبونا أبو اللفظ البديع عطارد % تجيش له بالمعجزات الخواطر % 14(@)(@@) % تفرقنا الأنساب في كل مجمع % و تجمعنا الآدابو هي أواصر % 15(@)(@@) % أرى حاجتي لم ينأ منها أوائل % فكيف نأى منها علي الأواخر % 16(@)(@@) % و ما الذم للأيام ذنبا لأنه % % بأمرك يجري صرفها المتواتر % 17(@)(@@) % و لا أظلم المقدار في بعد حاجة % تمسكو الأقلام فيها المقادر % PageV01P412 البحر : - 1(@)(@@) % إذا الشيب باعد بين القلوب % فليس بمجد تداني الديار % 2(@)(@@) % سكنت إلى شمسه كارها % و قد كنت من نجمه ذا نفار % 3(@)(@@) % و زهدني عارها في الخضاب % فجانبت زور الشباب المعار % 4(@)(@@) % و سرحت للشعر بالآبنوس % فسرحت بالعاج شيب العذار % 5(@)(@@) % ألاقي الظلام بمثل الظلام % وألقى النهار بمثل النهار % PageV01P413 البحر : - 1(@)(@@) % و أجرد يسعى ليله ونهاره % % و في وسطه عظم يقوم سيره 
ms115	 % % 2(@)(@@) % و ما جار فيما سار قدر قلامة % و لكنه يشقى ويستر غيره % % PageV01P414 البحر : - 1(@)(@@) % لا بد من نفثة مصدور % فحاذروا صولة محذور % 2(@)(@@) % قد أنست العالم غاراته % % في الشعر غارات المغاوير % 3(@)(@@) % أثكلني غيد قواف غدت % أبهى من الغيد المعاطير % 4(@)(@@) % أطيب ريحا من نسيم الصبا % % جاءت بريا الورد من حور % 5(@)(@@) % من بعد ما فتحت أنوارها % % فابتسمت مثل الأزاهير % 6(@)(@@) % و بات فكري تعبا بينها % % ينقشها نقش الدنانير % 7(@)(@@) % يا وارث الأغفال ما حبروا % % من القوافيو المشاهير % 8(@)(@@) % أعط قفا نبك أمانا فقد % % باتت بقلب منكمذعور % PageV01P415 البحر : - 1(@)(@@) % و اصطبحناها على نه % % ر بصفو الماء يجري % % 2(@)(@@) % ظللته شجرات % عطرها أطيب عطر % 3(@)(@@) % فلك أنجمه اللي % % مون من بيض وخضر % 4(@)(@@) % أكر من فضة قد % % شابها تلويح تبر % PageV01P416 البحر : - 1(@)(@@) % أنظر إلى السوسن في نباته % % فإنه نبت عجيب المنظر % 2(@)(@@) % كأنه ملاعق من فضة % قد خط فيها نقط من عنبر % PageV01P417 البحر : - 1(@)(@@) % أيا شاغل الشكر عن غيره % % بما ذاع في الناس من شكره % % 2(@)(@@) % و يا ناصر الأدب المستضام % إذا قعد الناس عن نصره % % 3(@)(@@) % أرى خلعة العيد قد أغفلت % و كانت تجيء على إثره % % 4(@)(@@) % فجد لي بحمراء إن فاخرت % جنى الورد أزرت بمحمره % % 5(@)(@@) % و إما بصفراء منسوبة % إلى خالص التبر في نجره % % 6(@)(@@) % و إما ببيضاء مثل اللجين % تزيد بياضا على حره % % 7(@)(@@) % إذا ما أخو الكبر حلى بها % % سراويله زاد في كبره % % 8(@)(@@) % و تلحق بالأرض أطرافها % % إذا هي دارت على خصره % % 9(@)(@@) % إذا ما الحسود رآها رأى % % و ميض الخناجر في نحره % % 10(@)(@@) % فأنت الموحد في جوده ؛ % و أنت المؤمل في عصره % % PageV01P418 البحر : - 1(@)(@@) % سيوفكمبحمد اللهنقع % إذا كانت سيوف الناس ضرا % % 2(@)(@@) % فلم قصرتو أيديكم طوال % تحكم في رقاب الناس طرا % % 3(@)(@@) % و ما لفراخكم تبيض لونا % فإن زقت شآها الزق حمرا % % 4(@)(@@) % و ما لجريحكم وتر عليكم % % و كل جراحة تعتد وترا % % 5(@)(@@) % و رب جريرة شنعاء ساقت % إلى مجترها حمدا وذكرا 
ms116	 % % 6(@)(@@) % أرى أفعالكم أفعال عز % فلم أنتم بفرط الذل أحرى % % PageV01P419 البحر : - 1(@)(@@) % دنو المدامة يدني السرورا % % فصل باغتباقك منها البكورا % % 2(@)(@@) % فقد نشر الصبحأعلامه % % و حان لكاساتها أن تدورا % % 3(@)(@@) % تعجبت من غفلات الورى % % و تركهم العيش غضا نضيرا % % 4(@)(@@) % فطائفة ترتجي جنة ال % % خلود وأخرى تخاف السعيرا % % 5(@)(@@) % ألا فسقني الخمر مشمولة % تصب على الليل صبحا منيرا % % 6(@)(@@) % موردة اللون مسكية % تعز الذليل وتغني الفقيرا % % 7(@)(@@) % كأن العقيق بكاساتها % % تفض السقاة عليها العبيرا % % 8(@)(@@) % صريع النوائب من لم يكن % جليدا على الهول منها صبورا % % 9(@)(@@) % فكن موقنا بذهاب الصبا % % و مغتنما منه دهرا قصيرا % % 10(@)(@@) % فإن الشباب له مدة % تفضفتذهب عنك السرورا % % PageV01P420 البحر : - 1(@)(@@) % أقررت في شكرك بالتقصير % إذ زدت في البر على التكثير % 2(@)(@@) % و جاءني من سيبك الغزير % مراكب مخطفة الخصور % 3(@)(@@) % مسودة الأعجاز والصدور % سود عليها رونق الذكور % 4(@)(@@) % كأنما قدت من الديجور % و من نفيس الأدم المبشور % 5(@)(@@) % كل غريب الحسن مستنير % أخضر مثل الشارب المطرور % 6(@)(@@) % ذي سمة مغموسة في النور % كصفحة الدينار ذي السطور % 7(@)(@@) % و مخطفات كالعذارى الحور % مشمرات القمص كالمنثور % 8(@)(@@) % كل فتاة نشأت بحور % تختال في دوجها القصير % 9(@)(@@) % حاسرة عن أرج حسير % مثل نسيم الزهر الممطور % 10(@)(@@) % تبرد منه علل الصدور % أشهى من الوصل إلى المهجور % PageV01P421 البحر : - 1(@)(@@) % قل لابن حرب قد جني % ت عليك حربا فاصطبر % % 2(@)(@@) % أنت الذي بسقوطه % % يدعى أبوه أبو العبر % % 3(@)(@@) % لم عبت شعريو هو أو % % ضاح تبسم أو غرر % % 4(@)(@@) % أحرمت نشر العنبر ال % % ورد الذي منه انتشر % % 5(@)(@@) % أم قد منعت الفكر في % % ه كما منعت من النظر % % 6(@)(@@) % إني لأرحم شاعرا % حرم البصيرة والبصر % % PageV01P422 البحر : - 1(@)(@@) % لو رحبت كاس بذي أوبة % لرحبت بالورد إذ زارها % % 2(@)(@@) % جاء فخلناه خدودا بدت % مضرمة من خجل نارها % % 3(@)(@@) % كأنما خير في روضة % طرائف الكسوة فاختارها % % 4(@)(@@) % و عطر الدنيا فطابت به % % لا عدمت دنياك عطارها % % 5(@)(@@) % قد خلع القطر جلابيبه % % إلا شظاياها وأزرارها % % PageV01P423 البحر 
ms117	 : - 1(@)(@@) % يوم خلعت به عذاري % % فعريت من حلل الوقار % 2(@)(@@) % و صبوت فيه إلى الصبا % % و الشيب يضحك في عذاري % % 3(@)(@@) % متلون يبدي لنا % % طرفا بأطراف النهار % 4(@)(@@) % فهواؤه سكب الردا % % ءو غيمه صافي الإزار % 5(@)(@@) % و سماؤه تخبو الربى % % بشبيه مكنون البحار % 6(@)(@@) % تبكي فيجمد ماؤها % % و البرق يكحلها بنار % PageV01P424 البحر : - 1(@)(@@) % و شمعة في يد الغلام حكت % عنق ظليم بغير منقار % 2(@)(@@) % تبكيإذا نار شوقها اضطرمت % بدمع تبر من الأسى جاري % % 3(@)(@@) % كأنها نخلة بلا سعف % تحمل أترجة من النار % PageV01P425 البحر : - 1(@)(@@) % يا من أنامله كالعارض الساري % % و فعله أبدا عار من العار % 2(@)(@@) % أما ترى الثلج قد خاطت أنامله % % ثوبا يزر على الدنيا بأزرار % 3(@)(@@) % نار و لكنها ليست بمبدية % نورا و ماء ولكن ليس بالجاري % % 4(@)(@@) % و الراح قد أعوزتنا في صبيحتنا % % بيعا و لو وزن دينار بدينار % PageV01P426 البحر : - 1(@)(@@) % خيش ابن رستم يحمى و هو ممطور % أخنى الهجير عليهفهو مهجور % 2(@)(@@) % و لو يطيبو لو علت سرايجه % % بالراحخالطها مسك وكافور % 3(@)(@@) % يرشهو الندامى يغرقون به % % كأنه لدوام الرش ممطور % 4(@)(@@) % فإن يكن خيشه في الحر ملتهبا % فإن كانونه في القر مقرور % PageV01P427 البحر : - 1(@)(@@) % ونى في التصابي بعدما كان شمرا % % و قصر في شأو الزمانفأقصرا % % 2(@)(@@) % و شاب بلون الصبح ليل شبابه % % فأصبح شتى الحلتين مشهرا % % 3(@)(@@) % و لا عاد رد المستعار مسلما % و قدم ريعان الصباو تأخرا % % 4(@)(@@) % فلم يبق إلا الراح بين كؤوسها % % مذاكرة كالروض جيدفأزهرا % % 5(@)(@@) % أحاديث لو يجتازها نفس الصبا % % تأرج من أنفاسهاو تعطرا % % 6(@)(@@) % و ساقية تشدو فتحسن شدوها % % و تبسم أحيانا فتحسن منظرا % % 7(@)(@@) % هجرت الندامى إذ بلوت خلالهم % % و نادمت كسرى في الزجاج وقيصرا % % 8(@)(@@) % أعريهما طورا و طورا أراهما % % يجران مصقول البنائق أحمرا % % 9(@)(@@) % فلو لم يكونا جوهرين كلاهما % % نفيسين ما حلا من الكاس جوهرا % % 10(@)(@@) % و هيج من وجدي حنين ابن قينة % إذا استنطقته بالأنامل زمجرا % % PageV01P428 11(@)(@@) % خفيف إذا لاقاك في ذهبية % مزنرة أرضاك مرأى ومخبرا % % 12 
ms118	(@)(@@) % براه صناع القلب والكف كلما % % تعذر معناه البديع تفكرا % % 13(@)(@@) % و ضمته رب المرط ينفض جسمها % % على جسمه مسكا ذكيا وعنبرا % % 14(@)(@@) % فساق قلوب الشربإذ حنغلبا % % و راق عيون البيض حين توقرا % % 15(@)(@@) % سأبعث حمدي غازيا وفر سيد % إذا ما غزاه الحمد عاد مظفرا % % 16(@)(@@) % كأن ثنائي غب جدواه مرتع % تبسم غب الساريات ونورا % % 17(@)(@@) % قديم على الأيام إن عد معشر ؛ % حديث المعالي عند عاد وحميرا % % 18(@)(@@) % تسهل ليفي أحمد الشعر طائعا % و لو رمته في غيره لتعذرا % % 19(@)(@@) % أطلتو ما استغرقت وصف خلاله % % فرحت مطيلا في الثناء مقصرا % % 20(@)(@@) % أأحمدإني بين قوم تبرؤوا % % من العرف حتى قد حسبناه منكرا % % PageV01P429 21(@)(@@) % إذا نزلوا أبصرت للجهل ناديا ؛ % و إن رحلوا أبصرت للبخل عسكرا % % 22(@)(@@) % أقولو قد عاينتهم عدد الحصى % % عدمتك جيلا ما أقل وأكثرا % % 23(@)(@@) % كأنك فيهم شارق في دجنة % إذا أغبشت مربدة اللون أسفرا % % 24(@)(@@) % أتتك القوافي الغر تطلب حاجة % جزاؤك فيها أن تثاب وتشكرا % % 25(@)(@@) % غرائبلو نادين في المحل عارضا % أجابو لو ناشدن صخرا تفجرا % % 26(@)(@@) % عدلت عن النابي الكهام بحليها % % و ألبسته منك الحسام المذكرا % % 27(@)(@@) % فلا تردد العقد المفصل خائبا % بصدك عنه والرداء المحبرا % % PageV01P430 البحر : - 1(@)(@@) % أعاد الله عيدك بالسرور % و في الحال الجليلة والحبور % 2(@)(@@) % و لازالت سعودك طالعات % بما تهواه من عيش نضير % 3(@)(@@) % دفاع الله عنك أعم فضلا % و أحلى في القلوب وفي الصدور % 4(@)(@@) % أناصر دولة الإسلام صبرا % فإن الصبر من عزم الأمور % 5(@)(@@) % كبا الأعداء إذ راموك جهلا % فقلناللجباه وللثغور % 6(@)(@@) % هبوط لا يمكن من صعود ؛ % و موت لا يقرب من نشور % 7(@)(@@) % منانا أن تعمر ألف عام % و تصرف عنك أحداث الدهور % 8(@)(@@) % و أن تلقى العدا في النحر صرعى % % بحد ظباك دامية النحور % PageV01P431 البحر : - 1(@)(@@) % أما ترى حسن بنات البر % مقيدات في عباب البحر % 2(@)(@@) % مأسورة لولا وثاق الأسر % صدرن عنه خالعات العذر % 3(@)(@@) % نيط بها كل خفيف الخصر % سارو ما يبرح قيد شبر % 4(@)(@@) % تئن كالمضرور لا من ضر 
ms119	 % تحصب منه بندى كالدر % 5(@)(@@) % فيومنا يوم صفا وقطر % فهاتها قبل نفاد العمر % 6(@)(@@) % و قبل مطوي بعيد النشر % داج على ساكنه مغبر % 7(@)(@@) % تخفي الفتى لولاها ماء الذكر % % PageV01P432 البحر : - 1(@)(@@) % لنا غرفة حسنت منظرا % % و طابت لسكانها مخبرا % % 2(@)(@@) % ترى العين من تحتها روضة ؛ % و من فوقها عارضا ممطرا % % 3(@)(@@) % و ينساب قدامها جدول % كما ذعر الأيم أو نفرا % % 4(@)(@@) % و راح كأن نسيم الصبا % % تحمل من نشرها العنبرا % % 5(@)(@@) % و عندي علق قليل الخلاف % و ندمان صدق قليلو المرا % % 6(@)(@@) % و دهماء تهدر هدر الفنيق % إذا ما امتطت لهبا مسعرا % % 7(@)(@@) % تجيش بأوصال وحشية % رعت زهرات الربا أشهرا % % 8(@)(@@) % كأن على النار زنجية % تفرج بردا لها أصفرا % % 9(@)(@@) % و ذي أربع لا يطيق النهوض % و لا يألف السير فيمن سرى % % 10(@)(@@) % نحمله سبجا أسودا % فيجعله ذهبا أحمرا % % PageV01P433 11(@)(@@) % إذا قلب القر كف الفتى % % حمى حره الكف أن تخصرا % % 12(@)(@@) % و قد بكر العبد من عندنا % % يزف لك الطرف والممطرا % % 13(@)(@@) % فشمرهديت إلى لذة % فإن أخا الجد من شمرا % % PageV01P434 البحر : - 1(@)(@@) % لنا قهوة في الدن تمت شهورها % % فرقت حواشيها وأشرق نورها % % 2(@)(@@) % يحييك بالمسك الذكي دنوها % % و يلقاك بالبشر الجميل بشيرها % % 3(@)(@@) % و قد كتبت أيدي الربيع صحائفا % كأن سطور البرق حسنا سطورها % % 4(@)(@@) % فمن روضة سار إلينا نسيمها ؛ % و من مزنة مرخى علينا ستورها % % 5(@)(@@) % و غرفتنا الحسناء قد زاد حسنها % % بزائرة في كل عام تزورها % % 6(@)(@@) % بمبيضة الأحشاء سود شطورها % % مزنرة الأذناب حمر نحورها % % 7(@)(@@) % مرفرفة حول البيوت وفودها % % محلقة حول السقوف وكورها % % 8(@)(@@) % لهن لغات معجمات كأنها % % صرير نعال السبت عال صريرها % % 9(@)(@@) % تجاورنا حتى تشب صغارها % % فيلحق فينا بالكبير صغيرها % % 10(@)(@@) % فزرنا ترى اللذات بيضا وجوهها % % محببة روحاتها وبكورها % % PageV01P435 11(@)(@@) % و بادر إلى الراح التي أنت خلها % % فقد قام ساقينا الأغر يديرها % % PageV01P436 البحر : - 1(@)(@@) % ذكرناهفانهلت مدامعنا تترى % % مخبرة عن كل ذي كبد حرى % % 2(@)(@@) % عهدناك مخصوصا من البيت كله % % بمنزلة في الصدر أنت بها أحرى 
ms120	 % % 3(@)(@@) % تظل لها رجلاك في قعر وهدة % إذا ما علت إحداهما هوت الأخرى % % 4(@)(@@) % و فوقك صفراوان إن شئت غنتا % % كذاكرتي فرخين شفهما الذكرى % % 5(@)(@@) % و كم أرسلت يمنى يديك رسولها % % فما لبثته حين صافحت اليسرى % % 6(@)(@@) % عجبت له طرفا يجر عنانه % و لا يتشكى الأين ما بعد المسرى % % 7(@)(@@) % يشق نقي المتن جعدا كأنه % % غدير تمشى الريح من فوقه حسرى % % 8(@)(@@) % فيا هالكا أعرى الصديق بهلكه % % و عز على تلك الأنامل أن تعرى % % 9(@)(@@) % إذا صغرت يوما رزية صاحب % بصاحبه كانت رزيتك الكبرى % % PageV01P437 البحر : - 1(@)(@@) % كأن تأجج كانوننا % % تكاثف نور من العصفر % 2(@)(@@) % و أحدث إخماده زرقة % تأجج في مدمج أحمر % 3(@)(@@) % كبركة جمر على قونها % % بقايا تفتح لينوفر % PageV01P438 البحر : - 1(@)(@@) % هل للمكارم من مجير % أم هل لأحمد من نصير % 2(@)(@@) % أنى ارتقت همم الردى % % منه إلى القمر المنير % 3(@)(@@) % بعد ابتسام شمائل % كالنور في الغصن النضير % 4(@)(@@) % يا رمةأرج الثرى % % من طيبهاأرج العبير % 5(@)(@@) % لو تستطيع الأرض ما % % سمحت بها يوم النشور % 6(@)(@@) % نظرت إليك المكرما % % تفلم تجد لك من تظير % 7(@)(@@) % فغدت عليك حواسرا % ينظرن من طرف حسير % 8(@)(@@) % فاذهب على رغم العدا % % و البأس والحسب الخطير % 9(@)(@@) % فارقتني وتركتني % % غرضا لأحداث الدهور % 10(@)(@@) % فلبست أثواب الأسى % % و خلعت أثواب السرور % PageV01P439 البحر : - 1(@)(@@) % ينبيك عن صحة أخباري % % عسريو من العشقو إيساري % % 2(@)(@@) % و سوقة أفضلهم مرتد % نقصا ففخري بينهم عاري % % 3(@)(@@) % و كانت الإبرةفيما مضى % % صائنة وجهي وأشعاري % % 4(@)(@@) % فأصبح الرزق بها ضيقا % كأنهمن ثقبهاجاري % % PageV01P440 البحر : - 1(@)(@@) % خير أوقاتكفي اللذ % ذاتأوقات البكور % 2(@)(@@) % ليس يوم إن تقصر % ه اصطباحا بقصير % 3(@)(@@) % و الظريف الحر عن إخ % % وانه غير صبور % 4(@)(@@) % و لنا راح خلال الش % شرب لا راح العصير % 5(@)(@@) % ذات لون ونسيم % خلقا من ورد جور % 6(@)(@@) % و سقاة إن سقوا حي % يوا بريحان الصدور % 7(@)(@@) % و عدو لك في القر % ر صديق في الهجير % 8(@)(@@) % يستعير البرد والإش % % راق من برد الثغور % 9(@)(@@) % رق حتى 