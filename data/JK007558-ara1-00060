ms41	 % 2(@)(@@) % لو كنت حييتها ما زلت ذا مقة % عندي ولا مسك الإدلاج والعمل % 3(@)(@@) % فحن من وله إذ قلت ذاك له % وظل معتذرا قد شفه الخجل % 4(@)(@@) % وود من جزع ما كنت أعرفها % % ورام تكليمها لو تنطق الأبل % 5(@)(@@) % ليت التحية كانت لي فأشكرها % % مكان يا جمل حييت يا رجل % PageV01P153 البحر : طويل 1(@)(@@) % أهاجك من سعدى الغداة طلول % بذي الطلح عامي بها ومحيل % 2(@)(@@) % وما هاجه من منزل لعبت به % لعوجاء مرقال العشي ذيول % 3(@)(@@) % بما قد ترى سعدى به وكأنها % % طلى راشح للسارحات خذول % 4(@)(@@) % رأيت وعيني قربتني لما أرى % % إليها وبعض العاشقين قتول % 5(@)(@@) % عيونا جلاها الكحل أما ضميرها % % فعف وأما طرفها فجهول % 6(@)(@@) % وركب كأطراف الأسنة عرسوا % % قلائص في أصلابهن نحول % 7(@)(@@) % إليك أبا بكر تروح وتغتدي % % برحلي مرداة الرواح ذميل % 8(@)(@@) % كثير عطاء الفاعلين مع الغنى % % بجود إن كاثروك قليل % 9(@)(@@) % وإني لأثري أن أراكم بغبطة % وإني أبا بكر - بكم لجميل % 10(@)(@@) % وإن أك قصرا في الرجال فإنني % % إذا حل أمز ساحتي لطويل % PageV01P154 البحر : وافر تام 1(@)(@@) % ألم تربع فتخبرك الطلول % ببينة رسمها رسم محيل % 2(@)(@@) % تحمل أهلها وجرى عليها % % رياح الصيف والسرب الهطول % 3(@)(@@) % تحن بها الدبور إذا أربت % كما حنت مولهة عجول % 4(@)(@@) % تعلق ناشئا من حب سلمى % % هوى سكن الفؤاد فما يزول % 5(@)(@@) % سبتني إذ شبابي لم يعصب % وإذ لا يستبل لها فتيل % 6(@)(@@) % فلم يملل مودتها غلاما % وقد ينسى ويطرف الملول % 7(@)(@@) % فأدركك المشيب على هواها % % فلا شيب نهاك ولا ذهول % 8(@)(@@) % تصيد ولا تصاد ومن أصابت % فلا قودا ، وليس به حميل % 9(@)(@@) % هجان اللون واضحة المحيا % % قطيع الصوت آنسة كسول % 10(@)(@@) % وتبسم عن أغر له غروب % فرات الريق ليس له فلول % PageV01P155 11(@)(@@) % كأن صبيب غادية بلصب % تشج به شآمية شمول % 12(@)(@@) % على فيها إذا الجوزاء كانت % محلقة وأردفها رعيل % 13(@)(@@) % فدع ليلى فقد بخلت وصدت % وصدع بين شعبينا الفلول % 14(@)(@@) % وأحكم كل قافية جديد % تخيرها غرائب ما تقول % 15(@)(@@) % لأبيض ماجد 
ms42	 تهدي ثناه % إليه والثناء له قليل % 16(@)(@@) % أبي مروان لا تعدل سواه % به أحدا وأين به عديل % 17(@)(@@) % بطاحي له نسب مصفى % % وأخلاق لها عرض وطول % 18(@)(@@) % فقد طلب المكارم فاحتواها % % أغر كأنه سيف صقيل % 19(@)(@@) % تجنب كل فاحشة وعيب % وصافى الحمد فهو له خليل % 20(@)(@@) % إذا السبعون لم تسكت وليدا % وأصبح في كباركها الفحول % PageV01P156 21(@)(@@) % وكان القطر أجلابا وصرا % تحث به شآمية بليل % 22(@)(@@) % فإن بكفه ما دام حيا % من المعروف أودية تسيل % 23(@)(@@) % تقول حليلتي لما رأتني % % أرقت وضافني هم دخيل % 24(@)(@@) % كأنك قد بدا لك بعد مكث % وطول إقامة فينا رحيل % 25(@)(@@) % فقلت أجل ، فبعض اللوم إني % % قديما لا يلائمني العذول % 26(@)(@@) % وأبيض ينعس السرحان فيه % % كأن بياضه ريط غسيل % 27(@)(@@) % خدت فيه برحلي ذات لوث % من العيدي ناجية ذمول % 28(@)(@@) % سلوك حين تشتبه الفيافي % % ويخطىء قصد وجهته الدليل % 29(@)(@@) % إذا فضلت نسعتيها % % وأصبح ضفرها قلقا يجول % 30(@)(@@) % على قرواء قد ضمرت ففيها ، % ولم تبلغ سليقتها ذبول % PageV01P157 31(@)(@@) % طوت طي الرداء الخرق حتى % % تقارب بعده سرح نصول % 32(@)(@@) % من الكتم الحوافظ لا سقوط % إذا سقط المطي ولا سؤول % 33(@)(@@) % تكاد تطير إفراطا وسغبا % إذا زجرت ومد لها الحبول % 34(@)(@@) % إلى القرم الذي فاتت يداه % بفعل الخير بسطة من ينيل % 35(@)(@@) % إذا ما غالي الحمد اشتراه % فما إن يستقل ولا يقيل % 36(@)(@@) % أمين الصدر يحفظ ما تولى % % كما يلفى القوي به النبيل % 37(@)(@@) % نقي طاهر الأثواب بر % لكل الخير مصطنع محيل % 38(@)(@@) % أبا مروان أنت فتى قريش % وكهلهم إذا عد الكهول % 39(@)(@@) % توليه العشيرة ما عناها % % فلا ضيق الذراع ولا بخيل % 40(@)(@@) % إليك تشير أيديهم إذا ما % % رضوا أو غالهم أمر جليل % PageV01P158 41(@)(@@) % كلا يوميه بالمعروف طلق % وكل فعاله حسن جميل % 42(@)(@@) % جواد سابق في اليسر بحر % وفي العلات وهاب بذول % 43(@)(@@) % تأنس بالنبات إذا أتاها % % لرؤية وجهه الأرض المحول % 44(@)(@@) % لبهجة واضح سهل عليه % إذا رئي المهابة والقبول % 45(@)(@@) % لأهل الود والقربى عليه % صنائع بثها بر وصول 
ms43	 % 46(@)(@@) % أياد قد عرفن مظاهرات % له فيها التطاول والفضول % 47(@)(@@) % وعفو عن مسيئهم وصفح % يعود به إذا غلق الحجول % 48(@)(@@) % إذا هو لم تذكره نهاه % وقار الدين والرأي الأصيل % 49(@)(@@) % وللفقراء عائدة ورحم % ولا يقصى الفقير ولا يعيل % 50(@)(@@) % جناب واسع الأكناف سهل % وظل في منادحه ظليل % PageV01P159 51(@)(@@) % وكم من غارم فرجت عنه % مغارم كل محملها ثقيل % 52(@)(@@) % وذي لدد أريت اللد حتى % % تبين واستبان له السيل % 53(@)(@@) % وأمر قد فرقت اللبس منه % % بحلم لا يجور ولا يميل % 54(@)(@@) % نمى بك في الذؤابة من قريش % بناء العز والمجد الأثيل % 55(@)(@@) % أرم ثابت يهتز فيه % % بأكرم منبت فرع أصيل % PageV01P160 البحر : طويل 1(@)(@@) % أقول وقد جاوزن من صدر رابغ % مهامه غبرا يرفع الأكم آلها % % 2(@)(@@) % أألحي أم صيران دوم تناوحت % بتريم قصرا واستحثت شمالها % % 3(@)(@@) % أرى حين زالت عير سلمى برابغ % وهاج القلوب الساكنات زوالها % % 4(@)(@@) % كأن دموع العين لما تخللت % مخارم بيضا من تمني جمالها % % 5(@)(@@) % قبلن غروبا من سميحة أنزعت % بهن السواني واستدار محالها % % 6(@)(@@) % لعمرك إن العين عن غير نعمة % كذاك إلى سلمى لمهدى سجالها % % 7(@)(@@) % عذرتك في سلمى بآنفة الصبا % % وميعته إذ تزدهيك ظلالها % % 8(@)(@@) % وملتمس مني الشكية غره % ليان حواشي شيمتي وجمالها % % 9(@)(@@) % رميت بأطراف الزجاج فلم يفق % عن الجهل حتى حكمته نصالها % % 10(@)(@@) % وذي كرم يوما أراد كرامتي % % وعربة ودي رغبة هل ينالها % % PageV01P161 11(@)(@@) % بذلت له مثلا وكل تحية % من المرء مردود عليه مثالها % % PageV01P162 البحر : كامل تام 1(@)(@@) % حي المنازل قد عفت أطلالها % % وعفا الرسوم بمورهن شمالها % % 2(@)(@@) % قفرا وقفت بها فقلت لصاحبي % % والعين يسبق طرفها إسبالها % % 3(@)(@@) % أقوى الغياطل من حراج مبرة % فخبوت سهوة قد عفت فرمالها % % 4(@)(@@) % وتقاصرت أصلا شخوص أرومها % % حتى مثلن وأعرضت أغفالها % % 5(@)(@@) % الضاربون أمامها ووراءها % % بمهندات قد أجيد صقالها % % 6(@)(@@) % الحلم أثبت منزلا في صدره % من هضب صندد حيث حل خيالها % % 7(@)(@@) % ولوجهه عند المسائل إذ غدا % % وغدت فواضل سيبه ونوالها % % 8(@)(@@) % بالخير أبلج من سقاية راهب % تجلى بموزن مشرق 
ms44	 تمثالها % % PageV01P163 البحر : طويل 1(@)(@@) % إذا ابتدر الناس المكارم بزهم % عراضة أخلاق ابن ليلى وطولها % % 2(@)(@@) % وإن ابن ليلى فاه لي بمقالة % ولو سرت فيها كنت ممن ينيلها % % 3(@)(@@) % عجبت لتركي خطة الرشد بعدما % % بدا لي من عبد العزيز قبولها % % 4(@)(@@) % وأمي صعبات الأمور أروضها % % وقد أمكنتني يوم ذاك ذلولها % % 5(@)(@@) % حلفت برب الراقصات إلى منى % يغول البلاد نصها وذميلها % % 6(@)(@@) % لئن عاد لي عبد العزيز بمثلها % % وأمكنني منها إذا لا أقيلها % % 7(@)(@@) % فهل أنت إن راجعتك القول مرة % بأحسن منها عائد فمنيلها % % PageV01P164 البحر : طويل 1(@)(@@) % على خالد أصبحت أبكي لخالد % وأصدق نفسا قد أصيب خليلها % % 2(@)(@@) % تذكرت منه بعد أول هجعة % مساعي لا أدري على من أحيلها % % 3(@)(@@) % وكنت إذا نابت قريشا ملمة % وقال رجال سادة : من يزيلها % % 4(@)(@@) % تكون لها لا معجبا بنجاحها % % ولا يحمل الأثقال إلا حمولها % % 5(@)(@@) % فأين الذي كانت معد تنوبه % ويحتمل الأعباء ثم يعولها ؟ % PageV01P165 البحر : طويل 1(@)(@@) % أمن طلل أقوى من الحي ماثله % تهيج أحزان الطروب منازله % 2(@)(@@) % بكيت ، وما يبكيك من رسم دمنة % أضر به جود الشمال ووابله % 3(@)(@@) % سقى الربع من سلمى بنعف رواوة % إلى القهب أجواد السمي ووابله % 4(@)(@@) % وإن كان لا سعدى أطالت سكونه % ولا أهل سعدى آخر الدهر نازله % 5(@)(@@) % وإني لأرضى من نوالك بالذي % % لو أبصره الواشي لقرت بلابله % 6(@)(@@) % بلى وبأن لا أستطيع وبالمنى % % وبالوعد والتسويف قد مل آمله % 7(@)(@@) % وحبك ينسيني من الشيء في يدي % % ويذهلني عن كل شيء أزاوله % 8(@)(@@) % سيهلك في الدنيا شفيق عليكم % إذا غاله من حادث الدهر غائله % 9(@)(@@) % ويخفي لكم حبا شديدا ورهبة % وللناس أشغال وحبك شاغله % % 10(@)(@@) % كريم يميت السر حتى كأنه % إذا استبحثوه عن حديثك جاهله % PageV01P166 11(@)(@@) % يود بأن يمسي سقيما لعلها % % إذا سمعت عنه بشكوى تراسله % 12(@)(@@) % ويرتاح للمعروف في طلب العلى % % لتحمد يوما عند ليلى شمائله % 13(@)(@@) % وعن سركم في مضمر القلب والحشا % % شفيق عليكم لا تخاف غوائله % 14(@)(@@) % وأكتم نفسي بعض سري تكرما % إذا ما أضاع السر 
ms45	 في الناس حامله % 15(@)(@@) % فلو كنت في كبل وبحت بلوعتي % % إليه لأنت رحمة لي سلاسله % 16(@)(@@) % ولو أكلت من نبت عيني بهيمة % لهيج منها رحمة حين تأكله % 17(@)(@@) % ويدرك غيري عند غيرك حظه % بشعري ويعييني به ما أحاوله % 18(@)(@@) % فلا هانت الأشعار بعدي وبعدكم % % محبا ومات الشعر بعدي وقائله % % PageV01P167 البحر : طويل 1(@)(@@) % أهاجك ليلى إذ أجد رحيلها % % نعم وثنت لما احزألت حمولها % % 2(@)(@@) % لقد سرت شرقي البلاد وغربها % % وقد ضربتني شمسها وظلولها % % 3(@)(@@) % ينوء فيعدو من قريب إذا عدا % % ويكمن في خشباء وعث مقيلها % % 4(@)(@@) % سيأتي أمير المؤمنين ودونه % صماد من الصوان مرت ميولها % % 5(@)(@@) % فبيد المنقى فالمشارف دونه % فروضة بصرى أعرضت فبسيلها % % 6(@)(@@) % ثنائي تؤديه إليك ومدحتي % % صهابية الألوان باق ذميلها % % 7(@)(@@) % عسوف بأجواز الفلا حميرية % مريش بذئبان السبيب تليلها % % 8(@)(@@) % يغادي بفار المسك طورا وتارة % ترى الدرع مرفضا عليه نثيلها % % 9(@)(@@) % وقد شخصت بالسابرية فوقه % معلبة الأنبوب ماض أليلها % % 10(@)(@@) % ترى ابن أبي العاصي وقد صف دونه % ثمانون ألفا قد توافت كمولها % % PageV01P168 11(@)(@@) % يقلب عيني حية بمحارة % أضاف إليها الساريات سبيلها % % 12(@)(@@) % يصد ويغضي وهو ليث خفية % إذا أمكنته عدوة لا يقيلها % % 13(@)(@@) % بسطت لباغي العرف كفا بسيطة % تنال العدى بله الصديق فضولها % % 14(@)(@@) % ولم يك عن عفر تفرعك العلى % % ولكن مواريث الجدود تؤولها % % 15(@)(@@) % حموا منزل الأملاك من مرج راهط % ورملة لد أن تباح سهولها % % PageV01P169 البحر : طويل 1(@)(@@) % ألا حييا ليلى أجد رحيلي % % وآذن أصحابي غدا بقفول % 2(@)(@@) % تبدت له ليلى لتغلب صبره % وهاجتك أم الصلت بعد ذهول % 3(@)(@@) % أريد لأنسى ذكرها فكأنما % % تمثل لي ليلى بكل سبيل % 4(@)(@@) % إذا ذكرت ليلى تغشتك عبرة % تعل بها العينان بعد نهول % 5(@)(@@) % وكم من خليل قال لي لو سألتها % % فقلت : نعم ليلى أضن خليل % 6(@)(@@) % وأبعده نيلا وأوشكه قلى % % وإن سئلت عرفا فشر مسول % 7(@)(@@) % حلفت برب الراقصات إلى منى % خلال الملا يمددن كل جديل % 8(@)(@@) % تراها وفاقا بينهن تفاوت % ويمددن بالإهلال كل أصيل % 9(@)(@@) % تواهقن بالحجاج من بطن 
ms46	 نخلة % ومن عزور والخبت خبت طفيل % 10(@)(@@) % بكل حرام خاشع متوجه % إلى الله يدعوه بكل نقيل % PageV01P170 11(@)(@@) % على كل مذعان الرواح معيدة % ومخشية ألا تعيد هزيل % 12(@)(@@) % شوامذ قد أرتجن دون أجنة % وهوج تبارى في الأزمة حول % 13(@)(@@) % يمين امرئ مستغلظ بألية % ليكذب قيلا قد ألح بقيل % 14(@)(@@) % لقد كذب الواشون ما بحت عندهم % بليلى ولا أرسلتهم برسيل % 15(@)(@@) % فإن جاءك الواشون عني بكذبة % فروها ولم يأتوا لها بحويل % 16(@)(@@) % فلا تعجلي يا ليل أن تتفهمي % % بنصح أتى الواشون أم بحبول % 17(@)(@@) % فإن طبت نفسا بالعطاء فأجزلي % % وخير العطايا ليل كل جزيل % 18(@)(@@) % وإلا فإجمال إلي فإنني % % أحب من الأخلاق كل جميل % 19(@)(@@) % فإن تبذلي لي منك يوما مودة % فقدما صنعت القرض عند بذول % 20(@)(@@) % وإن تبخلي يا ليل عني فإنني % % توكلني نفسي بكل بخيل % PageV01P171 21(@)(@@) % ولست براض من خليلي بنائل % قليل ولا راض له بقليل % 22(@)(@@) % وليس خليلي بالملول ولا الذي % % إذا غبت عنه باعني بخليل % 23(@)(@@) % ولكن خليلي من يدوم وصاله % ويحفظ سري عند كل دخيل % 24(@)(@@) % ولم أر من ليلى نوالا أعده % ألا ربما طالبت غير منيل % 25(@)(@@) % يلومك في ليلى وعقلك عندها % % رجال ولم تذهب لهم بعقول % 26(@)(@@) % يقولون ودع عنك ليلى ولا تهم % بقاطعة الأقران ذات حليل % 27(@)(@@) % فما نقعت نفسي بما أمروا به % ولا عجت من أقوالهم بفتيل % 28(@)(@@) % تذكرت أترابا لعزة كالمها % % حبين بليط ناعم وقبول % 29(@)(@@) % وكنت إذا لاقيتهن كأنني % % مخالطة عقلي سلاف شمول % 30(@)(@@) % تأطرن حتى قلت لسن بوارحا % رجاء الأماني أن يقلن مقيلي % % PageV01P172 31(@)(@@) % فأبدين لي من بينهن تجهما % وأخلفن ظني إذ ظننت وقيلي % % 32(@)(@@) % فلأيا بلأي ما قضين لبانة % من الدار واستقللن بعد طويل % 33(@)(@@) % فلما رأى واستيقن البين صاحبي % % دعا دعوة يا حبتر بن سلول % 34(@)(@@) % فقلت وأسررت الندامة ليتني % % وكنت امرءا أغتش كل عذول % 35(@)(@@) % سلكت سبيل الرائحات عشية % مخارم نصع أو سلكن سبيلي % % 36(@)(@@) % فأسعدت نفسا بالهوى قبل أن أرى % % عوادي نأي بيننا وشغول % 37(@)(@@) % ندمت 
ms47	 على ما فاتني يوم بنتم % فيا حسرتا ألا يرين عويلي % % 38(@)(@@) % كأن دموع العين واهية الكلى % % وعت ماء غرب يوم ذاك سجيل % 39(@)(@@) % تكنفها خرق تواكلن خرزها % % فأرخينه والسير غير بجيل % 40(@)(@@) % أقيمي فإن الغور يا عز بعدكم % إلي إذا ما بنت غير جميل % PageV01P173 41(@)(@@) % كفى حزنا للعين أن راء طرفها % % لعزة عيرا آذنت برحيل % 42(@)(@@) % وقالوا : نأت فاختر من الصبر والبكا % % فقلت البكا أشفى إذا لغليلي % % 43(@)(@@) % فوليت محزونا وقلت لصاحبي % % أقاتلتي ليلى بغير قتيل ؟ % 44(@)(@@) % لعزة إذ يحتل بالخيف أهلها % % فأوحش منها الخيف بعد حلول % 45(@)(@@) % وبدل منها بعد طول إقامة % تبعث نكباء العشي جفول % 46(@)(@@) % لقد أكثر الواشون فينا وفيكم % ومال بنا الواشون كل مميل % 47(@)(@@) % وما زلت من ليلى لدن طر شاربي % % إلى اليوم كالمقصى بكل سبيل % PageV01P174 البحر : طويل 1(@)(@@) % ألما على سلمى نسلم ونسأل % سؤال حفي بالحبيب موكل % 2(@)(@@) % سبته بعذب الريق صاف غروبه % % رقيق الثنايا بارد لم يفلل % 3(@)(@@) % وأسود ميال على جيد ظبية % من الأدم حوراء المدامع مغزل % 4(@)(@@) % وأتلع براق كأن اهتزازه % إذا انتصفت للروع هزة منصل % 5(@)(@@) % وما قرقف من أذرعات كأنها % % إذا سكبت من دنها ماء مفصل % 6(@)(@@) % يصب على ناجودها ماء بارق % وعاه صفا في رأس عنقاء عيطل % 7(@)(@@) % بأطيب من فيها لمن ذاق طعمه % وقد لاح ضوء النجم أو كاد ينجلي % % 8(@)(@@) % أخاضت إلي الليل خود غريرة % جبان السرى لم تنتطق عن تفضل % 9(@)(@@) % إليك ابن مروان الأغر تكلفت % مسافة ما بين البضيع فيليل % 10(@)(@@) % جرى ناشيا للمجد في كل حلبة % فجاء مجيء السابق المتهلل % PageV01P175 11(@)(@@) % متى يعتهده الراغبون فيكثروا % % على بابه يكثر قراه فيعجل % 12(@)(@@) % ويعطي عطاء تنتهي دونه المنى % % عطاء وهوب للرغائب مجزل % 13(@)(@@) % أشد حياء من فتاة حيية % وأمضى مضاء من سنان مؤلل % 14(@)(@@) % وأخوف في الأعداء من ذي مهابة % بخفان ورد واسع العين مطفل % 15(@)(@@) % له جزر في كل يوم يجره % إلى لبوات في العرين وأشبل % 16(@)(@@) % إذا وفدت ركبان كعب وعامر % عليك وأردوا 
ms48	 كل هوجاء عيهل % 17(@)(@@) % لقوك بقول من ثنائي صادق % تخيرته حر القصيد المنخل % 18(@)(@@) % ثناء يوافي بالمواسم أهلها % % وينشده الركبان في كل محفل % PageV01P176 البحر : وافر تام 1(@)(@@) % أقر الله عيني إذ دعاني % % أمين الله يلطف في السؤال % 2(@)(@@) % وأثنى في هواي علي خيرا % ويسأل عن بني وكيف حالي % % 3(@)(@@) % وكيف ذكرت حال أبي خبيب % وزلة فعله عند السؤال % 4(@)(@@) % هو المهدي خبرناه كعب % أخو الأحبار في الحقب الخوالي % % PageV01P177 البحر : وافر تام 1(@)(@@) % عرفت الدار كالخلل البوالي % % بفيف الخائعين إلى بعال % 2(@)(@@) % ديار من عزيزة قد عفاها % % تقادم سالف الحقب الخوالي % % 3(@)(@@) % كأن حمولهم لما تولت % بيليل والنوى ذات انفتال % 4(@)(@@) % وعدت نحو أيمنها وصدت % عن الكثبان من صعد وخال % 5(@)(@@) % شوارع في ثرى الخرماء ليست % بجاذية الجذوع ولا رقال % 6(@)(@@) % فسجفن الخدور بكل وجه % نقي لونه كسنا الهلال % 7(@)(@@) % بكل تلاعة كالبدر لما % % تنور واستقل على الجبال % 8(@)(@@) % كأن الريح تثني حين هبت % - ولو ضعفت - بهن فروع ضال % 9(@)(@@) % كسون الريط ذا الهدب اليماني % % خصورا فوق أعجاز ثقال % 10(@)(@@) % ويجعلن الخلاخل حين تلوى % % بأسؤقهن في قصب خدال % PageV01P178 11(@)(@@) % وكنت قبيل أن يخلفن ظني % % أكذب بالتفرق والزيال % 12(@)(@@) % فلما إن رأيت العيس صبت % بذي المأثول مجمعة التوالي % % 13(@)(@@) % وقحم سيرنا من قور حسمى % % مروت الرعي ضاحية الظلال % 14(@)(@@) % وأرغم ما عزمن البين حتى % % دفعن بذي المزارع والنجال % 15(@)(@@) % فقلت وقد جعلن براق بدر % يمينا والعنابة عن شمال % 16(@)(@@) % وأشمت العدى حتى كأني % % وإياها لهم غرض النبال % 17(@)(@@) % وأبعد ما بدا لك غير مشك % خليل لست أنت له بقال % 18(@)(@@) % أقول لها عزيز مطلت ديني % % وشر الغانيات ذوو المطال % 19(@)(@@) % فقالت ويب غيرك كيف أقضى % % غريما ما ذهبت له بمال % 20(@)(@@) % فأقسم لو أتيت بالبحر يوما % لأشرب ما سقتني من بلال % PageV01P179 21(@)(@@) % وأقسم أن حبك أم عمرو % لدى جنبي ومنقطع السعال % PageV01P180 البحر : كامل تام 1(@)(@@) % إربع فحي معارف الأطلال % بالجزع من حرض فهن بوال % 2(@)(@@) % فشراج ريمة قد تقادم عهدها % % بالسفح بين 
ms49	 أثيل فبعال % 3(@)(@@) % وحشا تعاورها الرياح كأنها % % توشيح عصب مسهم الأغيال % 4(@)(@@) % لما وقفت بها القلوص تبادرت % حبب الدموع كأنهن عزالي % % 5(@)(@@) % وذكرت عزة إذا تصاقب دارها % % برحيب فأرابن فنخال % 6(@)(@@) % أيام أهلونا جميعا جيرة % بكتانة ففراقد فثعال % 7(@)(@@) % سقيا لعزة خلة سقيا لها % % إذ نحن بالهضبات من أملال % 8(@)(@@) % إذ لا تكلمنا وكان كلامها % % نفلا نؤمله من الأنفال % 9(@)(@@) % وبجيد مغزلة ترود بوجرة % بجلات طلح قد خرفن وضال % 10(@)(@@) % إذ هن في غلس الظلام قوارب % أعداد عين من عيون أثال % PageV01P181 11(@)(@@) % يجتزن أودية البضيع جوازعا % أجواز عينونا فنعف قبال % 12(@)(@@) % ترمي الفجاج إذا الفجاج تشابهت % أعلامها بمهامه أغفال % 13(@)(@@) % بركائب من بين كل ثنية % سرح اليدين وبازل شملال % 14(@)(@@) % ناج إذا زجر الركائب خلفه % فلحقنه وثنين بالحلحال % 15(@)(@@) % يهدي مطايا كالحني ضوامرا % بنياط أغبر شاخص الأميال % 16(@)(@@) % تمطو الجديل إذا المكاكي بادرت % جحل الضباب محافر الأدحال % 17(@)(@@) % وتعانقت أدم الظباء وباشرت % أكناف كل ظليلة مقيال % 18(@)(@@) % فكأنه إذ يغتدي متسنما % وهدا فوهدا ناعق برئال % 19(@)(@@) % كالمضرحي عدا فأصبح واقعا % من قدس فوق معاقل الأوعال % 20(@)(@@) % فنبذت ثم تحية فأعادها % % غمر الرداء مفضفض السربال % PageV01P182 21(@)(@@) % يعطي العشيرة سؤلها ويسودها % % يوم الفخار ويوم كل نبال % 22(@)(@@) % وبثثت مكرمة فقد أعددتها % % رصدا ليوم تفاخر ونضال % 23(@)(@@) % غمر الرداء إذا تبسم ضاحكا % غلقت لضحكته رقاب المال % PageV01P183 البحر : سريع 1(@)(@@) % يا عين بكي للذي عالني % % منك بدمع مسبل هامل % 2(@)(@@) % يا جعد بكيه ولا تسأمي % % بكاء حق ليس بالباطل % 3(@)(@@) % إن تستري الميت على مثله % في الناس من حاف ومن ناعل % PageV01P184 البحر : خفيف تام 1(@)(@@) % ما عناك الغداة من أطلال % دارسات المقام مذ أحوال % 2(@)(@@) % بادي الربع والمعارف منها % % غير رسم كعصبة الأغيال % 3(@)(@@) % ما ترى العين حولها من أنيس % قربها غير رابدات الرئال % 4(@)(@@) % يا خليلي الغداة إن دموعي % % سبقت لمح طرفها بانهمال % 5(@)(@@) % قم تأمل وأنت أبصر مني % % هل ترى بالغميم من أجمال % 6(@)(@@) % قاضيات لبانة من مناخ % وطواف وموقف بالجبال % 7 
ms50	(@)(@@) % حزيت لي بحزم فيدة تحدى % % كاليهودي من نطاة الرقال % 8(@)(@@) % قلن عسفان ثم رحن سراعا % طالعات عشية من غزال % 9(@)(@@) % قارضات الكديد مجترعات % كل وادي الجحوف بالأثقال % 10(@)(@@) % قصد لفت وهن متسقات % كالعدولي لاحقات التوالي % % PageV01P185 11(@)(@@) % حين وركن دوة بيمين % وسرير البضيع ذات الشمال % 12(@)(@@) % حزن وادي المياه محتضرات % مدرج العرج سالكات الخلال % 13(@)(@@) % والعبيلاء منهم بيسار % وتركن العقيق ذات النصال % 14(@)(@@) % طالعات الغميس من عبود % سالكات الخوي من أملال % 15(@)(@@) % وطوت جانبي كتانة طيا % فجنوب الحمى فذات النضال % 16(@)(@@) % فسقى الله منتوى أم عمرو % حيث أمت به صدور الرحال % 17(@)(@@) % تسمع الرعد في المخيلة منها % % مثل هزم القروم في الأشوال % 18(@)(@@) % وترى البرق عارضا مستطيرا % مرح البلق جلن في الأجلال % 19(@)(@@) % أو مصابيح راهب في يفاع % سغم الزيت ساطعات الذبال % 20(@)(@@) % حبذا هن من لبانة قلبي % % وجديد الشباب من سربالي % % PageV01P186 21(@)(@@) % رب يوم أتيتهن جميعا % عند بيضاء رخصة مكسال % 22(@)(@@) % غير أني امرؤ تعممت حلما % يكره الجهل والصبا أمثالي % % 23(@)(@@) % ويلام الحليم إن هو يوما % راجع الجهل بعد شيب القذال % PageV01P187 البحر : طويل 1(@)(@@) % وأنت لعيني قرة حين نلتقي % % وذكرك في نفسي إذا خدرت رجلي % % 2(@)(@@) % وإن رمدت عيناي يوما كحلتها % % بعينيك ، لم أبغ الذرور من الكحل % PageV01P188 البحر : طويل 1(@)(@@) % ألا يا لقومي للنوى وانفتالها % % وللصرم من أسماء ما لم ندالها % % 2(@)(@@) % على شيمة ليست بجد طليقة % إلينا ولا مقلية من شمالها % % 3(@)(@@) % هو الصفح منها خشية أن تلومها % % وأسباب صرم لم تقع بقبالها % % 4(@)(@@) % ونحن على مثل لأسماء لم نجز % إليها ولم نقطع قديم خلالها % % 5(@)(@@) % وشوقي إذا استيقنت أن قد تخيلت % لبين نوى أسماء بعض اختيالها % % 6(@)(@@) % وأسماء لا مشنوعة بملامة % إلينا ولا معذورة باعتلالها % % 7(@)(@@) % وإني على سقمي بأسماء والذي % % تراجع مني النفس بعد اندمالها % % 8(@)(@@) % لأرتاح من أسماء للذكر قد خلا % % وللربع من أسماء بعد احتمالها % % 9(@)(@@) % وإن شحطت يوما بكيت وإن دنت % تذللت واستكثرتها باعتزالها % % 10(@)(@@) % وأجمع هجرانا لأسماء إن دنت % بها الدار لا من 
ms51	 زهدة في وصالها % % PageV01P189 11(@)(@@) % فما وصلتنا خلة كوصالها % % ولا ماحلتنا خلة كمحالها % % 12(@)(@@) % فهل تجزين أسماء أورق عودها % % ودام الذي تثرى به من جمالها % % 13(@)(@@) % حنيني إلى أسماء والخرق دونها % % وإكرامي القوم العدى من جلالها % % 14(@)(@@) % هل أنت مطيعي أيها القلب عنوة % ولم تلح نفسا لم تلم في احتيالها % % 15(@)(@@) % فتجعل أسماء الغداة كحاجة % أجمت فلما أخلفت لم تبالها % % 16(@)(@@) % وتجهل من أسماء عهد صبابة % وتحذوها من نعلها بمثالها % % 17(@)(@@) % لعمر أبي أسماء ما دام عهدها % % على قولها ذات الزمين وحالها % % 18(@)(@@) % وما صرمت إذ لم تكن مستثيبة % بعاقبة حبل امرئ من حبالها % % 19(@)(@@) % فواعجبا من شوبها عذب مائها % % بملح ، وما قد غيرت من مقالها % % 20(@)(@@) % ومن نشرها ما حملت من أمانة % ومن وأيها بالوعد ثم انتقالها % % PageV01P190 21(@)(@@) % وكنا نراها بادي الرأي خلة % صدوقا على ما أعطيت من دلالها % % 22(@)(@@) % وليلة شفان يبل ضريبها % % بنا صفحات العيس تحت رحالها % % 23(@)(@@) % سريت ولولا حب أسماء لم أبت % تهزهز أثوابي فنون شمالها % % PageV01P191 البحر : طويل 1(@)(@@) % إلى ظعن يتبعن في قتر الضحى % % بعدوة ودان المطي الرواسما % % 2(@)(@@) % تخللن أجزاع الضئيد غدية % ورعن امرءا بالحاجبية هائما % % 3(@)(@@) % ومرت تحث السائقات جمال % بها مجتوى ذي معيط فالمخارما % % 4(@)(@@) % فلما انقضت أيام نهبل كلها % % وواجهن ديموما من الخبت قاتما % % 5(@)(@@) % تيامن عن ذي المر في مسبطرة % يدل بها الحادي المدل المراوما % % PageV01P192 البحر : طويل 1(@)(@@) % لعزة أطلال أبت أن تكلما % % تهيج مغانيها الطروب المتيما % % 2(@)(@@) % كأن الرياح الذاريات عشية % بأطلالها ينسجن ريطا مسهما % % 3(@)(@@) % أبت وأبى وجدي بعزة إذ نأت % على عدواء الدار أن يتصرما % % 4(@)(@@) % ولكن سقى صوب الربيع إذا أتى % % على قلهي الدار والمتخيما % % 5(@)(@@) % بغاد من الوسمي لما تصوبت % عثانين واديه على القعر ديما % % 6(@)(@@) % سقى الكدر فاللعباء فالبرق فالحمى % % فلوذ الحصى من تغلمين فأظلما % % 7(@)(@@) % فأروى جنوب الدونكين فضاجعا % فدر فأبلى صادق الوبل أسحما % % 8(@)(@@) % تثج رواياه إذا الرعد زجها % % بشابة فالقهب المزاد المحذلما % % 9(@)(@@) % فأصبح من يرعى الحمى وجنوبه % بذي أفق مكاؤه 
ms52	 قد ترنما % % 10(@)(@@) % ديار عفت من عزة الصيف بعدما % % تجد عليهن الوشيع المثمما % % PageV01P193 11(@)(@@) % فإن أنجدت كان الهوى بك منجدا % وإن أتهمت يوما بها الدار أتهما % % 12(@)(@@) % أجد الصبا واللهو أن يتصرما % % وأن يعقباك الشيب والحلم منهما % % 13(@)(@@) % لبست الصبا واللهو حتى إذا انقضى % % جديد الصبا واللهو أعرضت عنهما % % 14(@)(@@) % خليلين كانا صاحبيك فودعا % % فخذ منهما ما نولاك ودعهما % % 15(@)(@@) % على أن في قلبي لعزة وقرة % من الحب ما تزداد إلا تتيما % % 16(@)(@@) % يطالبها مستيقنا لا تثيبه % ولكن يسلي النفس كي لا يلوما % % 17(@)(@@) % يهاب الذي لم يؤت حلما كلامها % % وإن كان ذا حلم لديها تحلما % % 18(@)(@@) % تروك لسقط القول لا يهتدى به % % ولا هي تستوصى الحديث المكتما % % 19(@)(@@) % ويحسب نسوان لهن وسيلة % من الحب ، لا بل حبها كان أقدما % % 20(@)(@@) % وعلقتها وسط الجواري غريرة % وما قلدت إلا التميم المنظما % % PageV01P194 21(@)(@@) % غيوف القذى تأبى فلا تعرف الخنا % % وترمي بعينيها إلى من تكرما % % 22(@)(@@) % إلى أن دعت بالدرع قبل لداتها % % وعادت ترى منهن أبهى وأفخما % % 23(@)(@@) % وغال فضول الدرع ذي العرض خلقها % % وأتعبت الحجلين حتى تقصما % % 24(@)(@@) % وكظت سواريها فلم يألوانها % % لدن جاورا الكفين أن يتقدما % % 25(@)(@@) % وتدني على المتنين وحفا كأنه % عناقيد كرم قد تدلى فأنعما % % 26(@)(@@) % من الهيف لا تخزى إذا الريح ألصقت % على متنها ذا الطرتين المنمنما % % 27(@)(@@) % وكنت إذا ما جئتها بعد هجرة % تقاصر يومئذ نهاري وأغيما % % 28(@)(@@) % فأقسمت لا أنسى لعزة نظرة % لها كدت أبدي الوجد مني المجمجما % % 29(@)(@@) % عشية أومت ، والعيون حواضر % إلي برجع الكف أن لا تكلما % % 30(@)(@@) % فأعرضت عنها والفؤاد كأنما % % يرى لو تناديه بذلك مغنما % % PageV01P195 31(@)(@@) % فإنك - عمري - هل أريك ظعائنا % بصحن الشبا كالدوم من بطن تريما % % 32(@)(@@) % نظرت إليها وهي تنضو وتكتسي % % من القفر آلا كلما زال أقتما % % 33(@)(@@) % وقد جعلت أشجان برك يمينها % % وذات الشمال من مريخة أشأما % % 34(@)(@@) % مولية أيسارها قطن الحمى % % تواعدن شربا من حمامة معلما % % 35(@)(@@) % نظرت إليها وهي تحدى عشية % فأتبعتهم طرفي حتى تتمما % % 36(@)(@@) % تروع 
ms53	 بأكناف الأفاهيد عيرها % % نعاما وحقبا بالفدافد صيما % % 37(@)(@@) % ظعائن يشفين السقيم من الجوى % % به يخبلن الصحيح المسلما % % 38(@)(@@) % يهن المنقى عندهن من القذى % % ويكرمن ذا القاذورة المتكرما % % 39(@)(@@) % وكنت إذا ما جئت أجللن مجلسي % % وأبدين مني هيبة لا تجهما % % 40(@)(@@) % يحاذرن مني غيرة قد علمنها % % قديما فما يضحكن إلا تبسما % % PageV01P196 41(@)(@@) % يكللن حد الطرف عن ذي مهابة % أبان أولات الدل لما توسما % % 42(@)(@@) % تراهن إلا أن يؤدين نظرة % بمؤخر عين أو يقلبن معصما % % 43(@)(@@) % كواظم لا ينظقن إلا محورة % رجيعة قول بعد أن يتفهما % % 44(@)(@@) % وكن إذا ما قلن شيئا يسره % أسر الرضا في نفسه وتجرما % % 45(@)(@@) % فأقصر عن ذاك الهوى غير أنه % إذا ذكرت أسماء عاج مسلما % % PageV01P197 البحر : طويل 1(@)(@@) % وددت وما تغني الودادة أنني % % بما في ضمير الحاجبية عالم % 2(@)(@@) % فإن كان خيرا سرني وعلمته % وإن كان شرا لم تلمني اللوائم % 3(@)(@@) % وما ذكرتك النفس إلا تفرقت % فريقين منها عاذر لي ولائم % 4(@)(@@) % فريق أبى أن يقبل الضيم عنوة % وآخر منها قابل الضيم راغم % 5(@)(@@) % أروح وأغدو من هواك وأستري % % وفي النفس مما قد علمت علاقم % 6(@)(@@) % إلى أهل أجنادين من أرض منبج % على الهول إذ ضفر القوى متلاحم % 7(@)(@@) % وما لست من نصحي أخاك بمنكر % ببطنان إذ أهل القباب عماعم % 8(@)(@@) % سيأتي أمير المؤمنين ودونه % رحاب وأنهار البضيع وجاسم % 9(@)(@@) % ثنائي تنميه علي ومدحتي % % سمام على ركبانهن العمائم % PageV01P198 البحر : طويل 1(@)(@@) % لعزة من أيام ذي الغصن هاجني % % بضاحي قرار الروضتين رسوم % 2(@)(@@) % فروضة ألجام تهيج لي البكا % % وروضات شوطى عهدهن قديم % 3(@)(@@) % هي الدار وحشا غير أن قد يحلها % % ويغنى بها شخص علي كريم % 4(@)(@@) % فما برباع الدار أن كنت عالما % ولا بمحل الغانيات أهيم % 5(@)(@@) % سألت حكيما أين صارت بها النوى % % فخبرني ما لا أحب حكيم % 6(@)(@@) % أجدوا فأما آل عزة غدوة % فبانوا وأما واسط فمقيم % 7(@)(@@) % فما للنوى لا بارك الله في النوى % % وعهد النوى عند المحب ذميم % 8(@)(@@) % لعمري لئن كان الفؤاد من النوى 
ms54	 % % بغى سقما إني إذن لسقيم % 9(@)(@@) % فإما تريني اليوم أبدي جلادة % فإني لعمري تحت ذاك كليم % 10(@)(@@) % وما ظعنت طوعا ولكن أزالها % % زمان نبا بالصالحين مشوم % PageV01P199 11(@)(@@) % فواحزنا لما تفرق واسط % وأهل التي أهذي بها وأحوم % 12(@)(@@) % وقال لي البلاغ ويحك إنها % % بغيرك حقا يا كثير تهيم % 13(@)(@@) % أتشخص والشخص الذي أنت عادل % به الخلد بين العائدات سقيم % 14(@)(@@) % يذكرنيها كل ريح مريضة % لها بالتلاع القاويات نسيم % 15(@)(@@) % تمر السنون الماضيات ولا أرى % % بصحن الشبا أطلالهن تريم % 16(@)(@@) % ولست ابنة الضمري منك بناقم % ذنوب العدى إني إذن لظلوم % 17(@)(@@) % وإني لذو وجد لئن عاد وصلها % % وإني على ربي إذن لكريم % 18(@)(@@) % إذا برقت نحو البويب سحابة % لعينيك منها لا تجف سجوم % 19(@)(@@) % ولست براء نحو مصر سحابة % وإن بعدت إلا قعدت أشيم % 20(@)(@@) % فقد يوجد النكس الدني عن الهوى % % عزوفا ويصبو المرء وهو كريم % PageV01P200 21(@)(@@) % وقال خليلي : ما لها إذ لقيتها % % غداة الشبا فيها عليك وجوم % 22(@)(@@) % فقلت له : إن المودة بيننا % % على غير فحش والصفاء قديم % 23(@)(@@) % وإني وإن أعرضت عنها تجلدا % على العهد فيما بيننا لمقيم % 24(@)(@@) % وإن زمانا فرق الدهر بيننا % % وبينكم في صرفه لمشوم % 25(@)(@@) % أفي الدين هذا إن قلبك سالم % صحيح وقلبي من هواك سقيم % 26(@)(@@) % وإن بجوفي منك داء مخامرا % وجوفك مما بي عليك سليم % 27(@)(@@) % لعمرك ما أنصفتني في مودتي % % ولكنني يا عز عنك حليم % 28(@)(@@) % علي دماء البدن أن كان حبها % % على النأي أو طول الزمان يريم % 29(@)(@@) % وأقسم ما استبدلت بعدك خلة % ولا لك عندي في الفؤاد قسيم % PageV01P201 البحر : طويل 1(@)(@@) % يقول العدا يا عز قد حال دونكم % شجاع على ظهر الطريق مصمم % 2(@)(@@) % فقلت لها والله لو كان دونكم % جهنم ما راعت فؤادي جهنم % 3(@)(@@) % وكيف يروع القلب يا عز رائع % ووجهك في الظلماء للسفر معلم % 4(@)(@@) % وما ظلمتك النفس يا عز في الهوى % % فلا تنقمي حبي فما فيه منقم % PageV01P202 البحر : - 1(@)(@@) % أمن آل قيلة بالدخول رسوم % وبحومل طلل يلوح 
ms55	 قديم % 2(@)(@@) % لعب الرياح برسمه فأجده % جون عواكف في الرماد جثوم % 3(@)(@@) % سفع الخدود كأنهن وقد مضت % حجج ، عوائد بينهن سقيم % 4(@)(@@) % أجواز داوية خلال دماثها % % جدد صحاصح بينهن هروم % 6(@)(@@) % كذب العواذل بل أردن خيانتي % % وبدت روائع لمتي وقتوم % 7(@)(@@) % ولقد شهدت الخيل يحمل شكتي % % متلمظ حذم العنان بهيم % 8(@)(@@) % عتد القياد كأنه متحجر % حرب يشاهد رهطه مظلوم % 9(@)(@@) % باقي الذماء إذا ملكت مناقل % وإذا جمعت به أجش هزيم % 10(@)(@@) % عوم المعيد إلى الرجا قذفت به % في اللج داوية المكان جموم % PageV01P203 البحر : طويل 1(@)(@@) % وأنت التي حببت شغبى إلى بدا % % إلي وأوطاني بلاد سواهما % % 2(@)(@@) % وحلت بهذا حلة ثم أصبحت % بأخرى فطاب الواديان كلاهما % % 3(@)(@@) % إذا ذرفت عيناي أعتل بالقذى % % وعزة لو يدري الطبيب قذاهما % % 4(@)(@@) % فلو تذريان الدمع منذ استهلتا % % على إثر جازي نعمة لجزاهما % % PageV01P204 البحر : طويل 1(@)(@@) % ويوم الوغى يوم الطعان إذا اكتسى % % محجل خيل الملتقى وبهيمها % % 2(@)(@@) % من الماء لونا واحدا فتشابهت % وغير ألوان الجياد حميمها % % 3(@)(@@) % وصارت إلى شهباء ثابتة الرحى % % مقنعة أخرى تزول نجومها % % 4(@)(@@) % وطارت خلال الضرب أيد وأرجل % وحانت رقاب لم تعقد تميمها % % 5(@)(@@) % وإني بخير ما بقيت وما ولي % % قناة الهدى منكم إمام يقيمها % % PageV01P205 البحر : طويل 1(@)(@@) % عفت غيقة من أهلها فحريمها % % فبرقة حسمى قاعها فصريمها % % 2(@)(@@) % وهاجتك أطلال لعزة باللوى % % يلوح بأطراف البراق رسومها % % 3(@)(@@) % إلى المئبر الداني من الرمل ذي الغضا % % تراها وقد أقوت حديثا قديمها % % 4(@)(@@) % وقال خليلي يوم رحنا وفتحت % من الصدر أشراج وفضت ختومها % % 5(@)(@@) % أصابتك نبل الحاجبية إنها % % إذا ما رمت لا يستبل كليمها % % 6(@)(@@) % كأنك مردوع من الشمس مطرد % يفارقه من عقدة البقع هيمها % % 7(@)(@@) % أخو حية عطشى بأرض ظميئة % تجلل غشيا بعد غشي سليمها % % 8(@)(@@) % إذا شحطت يوما بعزة دارها % % عن الحي صفقا فاستمر جذيمها % % 9(@)(@@) % فإن تمس قد شطت بعزة دارها % % ولم يستقم والعهد منها زعيمها % % 10(@)(@@) % فقد غادرت في القلب مني زمانة % وللعين عبرات سريعا سجومها % % PageV01P206 11(@)(@@) % فذوقي بما جشمت عينا 
ms56	 مشومة % قذاها وقد يأتي على العين شومها % % 12(@)(@@) % فلا تجزعي لما نأت وتزحزحت % بعزة دورات النوى ورجومها % % 13(@)(@@) % ولي منك أيام إذا شحط النوى % % طوال وليلات تزول نجومها % % 14(@)(@@) % قضى كل ذي دين فوفى غريمه % وعزة ممطول معنى غريمها % % 15(@)(@@) % إذا سمت نفسي هجرها واجتنابها % % رأت غمرات الموت في ما أسومها % % 16(@)(@@) % إذا بنت بان العرف إلا أقله % من الناس واستعلى الحياة ذميمها % % 17(@)(@@) % وتخلق أثواب الصبا وتنكرت % نواح من المعروف كانت تقيمها % % 18(@)(@@) % فهل تجزيني عزة القرض بالهوى % % ثوابا لنفس قد أصيب صميمها % % 19(@)(@@) % بأني لم تبلغ لها ذا قرابة % أذاتي ، ولم أقرر لواش يذيمها % % 20(@)(@@) % متى ما تنالا بي الأولى يقصبونها % % إلي ولا يشتم لدي حميمها % % PageV01P207 21(@)(@@) % وقد علمت بالغيب أن لن أودها % % إذا هي لم يكرم علي كريمها % % 22(@)(@@) % فإن وصلتنا أم عمرو فإننا % % سنقبل منها الود أو لا نلومها % % 23(@)(@@) % فلا تزجر الغاوين عن تبع الصبا % % وأنت غوي النفس قدما سقيمها % % 24(@)(@@) % بعزة متبول إذا هي فارقت % معنى بأسباب الهوى ما يريمها % % 25(@)(@@) % ولما رأيت النفس نفسا مصابة % تداعى عليها بثها وهمومها % % 26(@)(@@) % عزمت عليها أمرها فصرمته % وخير بديعات الأمور عزيمها % % 30(@)(@@) % وما جابة المدرى خذول خلا لها % % أراك بذي الريان دان صريمها % % 31(@)(@@) % بأحسن منها سنة ومقلدا % إذا ما بدت لباتها ونظيمها % % 32(@)(@@) % وتفرق بالمدرى أثيثا نباته % كجنة غربيب تدلت كرومها % % 33(@)(@@) % إذا ضحكت لم تنتهز وتبسمت % ثنايا لها كالمزن غر ظلومها % % PageV01P208 34(@)(@@) % كأن على أنيابها بعد رقدة % إذا انتبهت وهنا لمن يستنيمها % % 35(@)(@@) % مجاجة نحل في أباريق صفقة % بصهباء يجري في العظام هميمها % % 36(@)(@@) % ركود المحيا وردة اللون شابها % % بماء الغوادي غير رنق مديمها % % 37(@)(@@) % فإن تصدفي يا عز عني وتصرمي % % ولا تقبلي مني خلالا أسومها % % 38(@)(@@) % فقد أقطع الموماة يستن آلها % % بها جيف الحسرى يلوح هشيمها % % 39(@)(@@) % على ظهر حرجوج يقطع بالفتى % % نعاف الفيافي سبتها ورسيمها % % 40(@)(@@) % وقد أزجر العوجاء أنقب خفها % % مناسمها لا يستبل رثيمها % % 41(@)(@@) % وقد غيبت سمرا كأن حروفها % % مواثم 
ms57	 وضاح يطير جريمها % % 42(@)(@@) % وليلة إيجاف بأرض مخوفة % تقتني بجونات الظلام نجومها % % 43(@)(@@) % فبت أساري ليلها وضريبها % % على ظهر حرجوج نبيل حزيمها % % PageV01P209 44(@)(@@) % تواهق أطلاحا كأن عيونها % % وقيع تعادت عن نطاف هزومها % % 45(@)(@@) % أضر بها الإدلاج حتى كأنها % % من الأين خرصان نحاها مقيمها % % 46(@)(@@) % تنازع أشراف الإكام مطيتي % % من الليل سيجانا شديدا فحومها % % 47(@)(@@) % بمشرفة الأجداث خاشعة الصوى % % تداعى إذا أمست صداها وبومها % % 48(@)(@@) % إذا استقبلتها الريح حال رغامها % % وحالف جولان السراب أرومها % % 52(@)(@@) % يمشي بحزان الإكام وبالربى % % كمستكبر ذي موزجين ظليمها % % 53(@)(@@) % رأيت بها العوج اللهاميم تغتلي % % وقد صقلت صقلا وتلت جسومها % % 54(@)(@@) % تراكل بالأكوار من كل صيهب % من الحر أثباجا قليلا لحومها % % 55(@)(@@) % ولو تسألين الركب في كل سربخ % إذا العيس لم ينبس بليل بغومها % % 56(@)(@@) % من الحجرة القصوى وراء رحالها % % إذا الأسد بالأكوار طاف رزومها % % PageV01P210 57(@)(@@) % وجربت إخوان الصفاء فمنهم % حميد الوصال عندنا وذميمها % % 58(@)(@@) % وأعلم أني لا أسربل جنة % من الموت معقودا علي تميمها % % 59(@)(@@) % ومن يبتدع ما ليس من سوس نفسه % % يدعه ويغلبه على النفس خيمها % % PageV01P211 البحر : طويل 1(@)(@@) % أفي رسم أطلال بشطب فمرجم % دوارس لما استنطقت لم تكلم % 2(@)(@@) % تكفكف أعدادا من العين ركبت % سوانيها ثم اندفعن بأسلم % 3(@)(@@) % فأصبح من تربي خصيلة قلبه % له ردة من حاجة لم تصرم % 4(@)(@@) % كذي الظلع إن يقصد عليه فإنه % يهم وإن يخرق به يتيمم % 5(@)(@@) % وما ذكره تربي خصيلة بعدما % % ظعن بأجواز المراض فتغلم % 6(@)(@@) % فأصبحن باللعباء يرمين بالحصى % % مدى كل وحشي لهن ومستمي % % 7(@)(@@) % موازية هضب المضيح واتقت % جبال الحمى والأخشبين بأخرم % 8(@)(@@) % إليك تبارى بعدما قلت قد بدت % جبال الشبا أو نكبت هضب تريم % 9(@)(@@) % بنا العيس تجتاب الفلاة كأنها % % قطا الكدر أمسى قاربا جفر ضمضم % 10(@)(@@) % تشكى بأعلى ذي جراول موهنا % مناسم منها تخضب المرو بالدم % PageV01P212 11(@)(@@) % تنوط العتاق الحميرية صحبتي % % بأعيس نهاض على الأين مرجم % 12(@)(@@) % كأن المطايا تتقي من زبانة % مناكب ركن من نضاد ململم % 13(@)(@@) % تعالي وقد نكبن أعلام عابد 
ms58	 % بأركانها اليسرى هضاب المقطم % 14(@)(@@) % ترى طبق الأعناق منها كأنه % إليك كعوب السمهري المقوم % 15(@)(@@) % إذا انتقدت فضل الأزمة زعزعت % أنابيبها العليا خوابي حنتم % 16(@)(@@) % تزور امرءا أما الآله فيتقي % % وأما بفعل الصالحين فيأتمي % % 17(@)(@@) % نجد لك القول الحلي ونمتطي % % إليك بنات الصعيري وشدقم % 18(@)(@@) % إليك فليس النبل أصبح غاديا % بذي حبك يعلو القرى متسنم % 19(@)(@@) % بطام يكب الفلك حول جنابه % لأذقانه معلولب المد يرتمي % % 20(@)(@@) % بأفضل سيبا منك ، بل ليس كله % كبعض أيادي سيبك المتقسم % PageV01P213 21(@)(@@) % رأيت ابن ليلى يعتري صلب ماله % مسائل شتى من غني ومصرم % 22(@)(@@) % مسائل إن توجد لديه تجد بها % % يداه وإن يظلم بها يتظلم % 23(@)(@@) % يداك ربيع ينتوى فضل سيبه % ووجهك بادي الخير للمتوسم % 24(@)(@@) % لقد أبرزت منك الحوادث للعدى % % على رغمهم ذري عضب مصمم % 25(@)(@@) % وذي قونس يوما شككت لبانه % بذي حمة في عامل الرمح لهذم % 26(@)(@@) % وذي مغرم فرجت عن لون وجهه % صبابة ذي دجن من الهم مظلم % 27(@)(@@) % وعان فككت الغل عنه وكبله % وقد أندبا منه بساق ومعصم % 28(@)(@@) % ولو وزنت رضوى الجبال بحلمه % لمال برضوى حلمه ويرمرم % 29(@)(@@) % من النفر البيض الذين وجوههم % دنانير شيفت من هرقل بروسم % 30(@)(@@) % فأنت إذا عد المكارم بينه % وبين ابن حرب ذي النهى المتفخم % % PageV01P214 البحر : طويل 1(@)(@@) % عرج بأطراف الديار وسلم % وإن هي لم تسمع ولم تتكلم % % 2(@)(@@) % فقد قدمت آياتها وتنكرت % لما مر من ريح وأوطف مرهم % 3(@)(@@) % تأملت من آياتها بعد أهلها % % بأطراف أعظام فأذناب أزنم % 4(@)(@@) % محاني آناء كأن دروسها % % دروس الجوابي بعد حول مجرم % 5(@)(@@) % يقول خليلي سر بنا أي موقف % وقفت وجهل بالحليم المعمم % 6(@)(@@) % تلوم ولم تعلم بأسرار خلة % فتعذر إلا عن حديث مرجم % 7(@)(@@) % فإن كنت لم أجهل فقد لمت ظالما % وإن كنت قد أزرى بي الجهل فاحلم % 8(@)(@@) % وفي الحلم والإسلام للمرء وازع % وفي ترك طاعات الفؤاد المتيم % 9(@)(@@) % بصائر رشد للفتى مستبينة % وأخلاق صدق علمها بالتعلم % 10(@)(@@) % وليت فلم تشتم عليا ولم تخف % بريا ولم 
ms59	 تقبل إشارة مجرم % PageV01P215 11(@)(@@) % وأظهرت نور الحق فاشتد نوره % على كل لبس بارق الحق مظلم % 12(@)(@@) % وعاقبت فيما قد تقدمت قبله % وأعرضت عما كان قبل التقدم % 13(@)(@@) % وصدقت بالفعل المقال مع الذي % % أتيت فأمسى راضيا كل مسلم % % 14(@)(@@) % تكلمت بالحق المبين وإنما % % تبين آيات الهدى بالتكلم % 15(@)(@@) % ألا إنما يكفي الفتى بعد زيغه % من الأود البادي ثقاف المقوم % 16(@)(@@) % وقد لبست لبس الهلوك ثيابها % % تراءى لك الدنيا بكف ومعصم % 17(@)(@@) % وتومض أحيانا بعين مريضة % وتبسم عن مثل الجمان المنظم % 18(@)(@@) % فأعرضت عنها مشمئزا كأنما % % سقتك مدوفا من سمام وعلقم % 19(@)(@@) % وقد كنت من أجبالها في ممنع % ومن بحرها في مزبد الموج مفعم % 20(@)(@@) % وما زلت تواقا إلى كل غاية % بلغت بها أعلى البناء المقدم % PageV01P216 21(@)(@@) % فلما أتاك الملك عفوا ولم يكن % لطالب دنيا بعده من تكلم % 22(@)(@@) % تركت الذي يفنى وإن كان مونقا % وآثرت ما يبقى برأي مصمم % 23(@)(@@) % وأضررت بالفاني وشمرت للذي % % أمامك في يوم من الشر مظلم % 24(@)(@@) % وما لك إذا كنت الخليفة مانع % % سوى الله من مال رغيب ولا دم سم % % 25(@)(@@) % سما لك هم في الفؤاد مؤرق % بلغت به أعلى المعالي بسلم % 26(@)(@@) % فما بين شرق الأرض والغرب كلها % % مناد ينادي من فصيح وأعجم % 27(@)(@@) % يقول : أمير المؤمنين ظلمتني % % بأخذ لدينار ولا أخذ درهم % 28(@)(@@) % ولا بسط كف امرئ غير مجرم % ولا السفك منه ظالما ملء محجم % 29(@)(@@) % ولو يستطيع المسلمون تقسموا % % لك الشطر من أعمارهم غير % 30(@)(@@) % فعشت به ما حج لله راكب % مغذ مطيف بالمقام وزمزم % PageV01P217 31(@)(@@) % فأربح بها من صفقة لمبايع % وأعظم بها أعظم بها ثم أعظم . . % PageV01P218 البحر : طويل 1(@)(@@) % لك الويل من عيني خبيب وثابت % وحمزة أشباه الحداء التوائم % 2(@)(@@) % تخبر من لاقيت أنك عائذ % بل العائذ المظلوم في مسجن عارم % 3(@)(@@) % ومن ير هذا الشيخ بالخيف من منى % من الناس يعلم أنه غير ظالم % 4(@)(@@) % وصي النبي المصطفى وابن عمه % وفكاك أغلال وقاضي مغارم % 5(@)(@@) % أبى فهو لا يشري هدى بضلالة 
ms60	 % ولا يتقي في الله لومة لائم % 6(@)(@@) % ونحن بحمد الله نتلو كتابه % حلولا بهذا الخيف خيف المحارم % 7(@)(@@) % بحيث الحمام آمن الروع ساكن % وحيث العدو كالصديق المسالم % % 8(@)(@@) % فما ورق الدنيا بباق لأهله % ولا شدة البلوى بضربة لازم % 9(@)(@@) % فلا تجزعن من شدة إن بعدها % % فوارج تلوي بالخطوب العوارم % PageV01P219 البحر : طويل 1(@)(@@) % وهاجرة يا عز يلتف حرها % % بركبانها من حيث لي العمائم % 2(@)(@@) % نصبت لها وجهي وعزة تتقي % % بجلبابها والستر لفح السمائم % PageV01P220 البحر : طويل 1(@)(@@) % رأيت أبا الحجناء في الناس جائزا % ولون أبي الحجناء لون البهائم % 2(@)(@@) % تراه على ما لاحه من سواده % وإن كان مظلوما له وجه ظالم % PageV01P221 البحر : منسرح 1(@)(@@) % كأن فاها لمن توسنها % % أو هكذا موهنا ولم تنم % 2(@)(@@) % بيضاء من عسل ذروة ضرب % شجت بماء الفلاة من عرم % 3(@)(@@) % دع عنك سلمى إذ فات مطلبها % % واذكر خليليك من بني الحكم % 4(@)(@@) % ما أعطياني ولا سألتهما % % إلا وإني لحاجزي كرمي % % 5(@)(@@) % إني متى لا يكن نوالهما % % عندي بما قد فعلت أحتشم % 6(@)(@@) % مبدي الرضا عنهما ومنصرف % عن بعض ما لو فعلت لم ألم % 7(@)(@@) % لا أنزر النائل الخليل إذا % % ما اعتل نزر الظوور لم ترم % PageV01P222 البحر : وافر تام 1(@)(@@) % عرفت الدار قد أقوت بريم % إلى لأي فمدفع ذي يدوم % 2(@)(@@) % أمير المؤمنين إليك نهوي % % على البخت الصلادم والعجوم % 3(@)(@@) % كأن سوالف النجدات منها % % تقطر بالأرندج والعصيم % 4(@)(@@) % إذا اتخذت وجوه القوم نصبا % أجيج الواهجات من السموم % 5(@)(@@) % فكم غادرن دونك من جهيض % ومن نعل مطرحة جذيم % 6(@)(@@) % يزرن على تنائيه يزيدا % بأكناف الموقر والرقيم % 7(@)(@@) % تهنئه الوفود إذا أتوه % بنصر الله والملك العظيم % PageV01P223 البحر : خفيف تام 1(@)(@@) % يا لقومي لحبلك المصروم % يوم شوطى وأنت غير مليم % 2(@)(@@) % ورسوم الديار تعرف منها % % بالملا بين تغلمين فريم % 3(@)(@@) % غشي الركب ربعها فعجبنا % % من بلاه وما المدى بمقيم % 4(@)(@@) % كحواشي الرداء قد مح منه % بعد حسن عصائب التسهيم % 5(@)(@@) % بدل السفح في اليلابن منها % % كل أدماء مرشح وظليم % 6(@)(@@) % قد 