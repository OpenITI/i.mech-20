ms521	 قريش هجينها % % فإني على رغم العدو هجانها % % 16(@)(@@) % وإن يك فخر أو نضال فإنني % % لها يدها طورا ، وطورا لسانها % % 17(@)(@@) % وإني من القوم الذين ببأسهم % % يذلل من أيامهم حدثانها % % 18(@)(@@) % إذا غبروا في الجو ضاق فضاؤه % % وإن نزلوا البيداء غمت رعانها % % 19(@)(@@) % فوارس تجري بالدماء رماحها % % وتفهق بالني الغريض جفانها % % 20(@)(@@) % يثور إذا أوفى الصباح عجاجها % % ويعلو إذا جن الظلام دخانها % % PageV01P1843 21(@)(@@) % وإني لوثاب على كل فرصة % % تخيل على الرائي ، ويخفى مكانها % % 22(@)(@@) % سبقت وقفيتم بكل طليعة % % على عقبي يلوي بها هدجانها % % 23(@)(@@) % وما كنت إلا كالثريا تحلقا % يدف على آثارها دبرانها % % 24(@)(@@) % عصائب ما استام الفخار وضيعها % % ولا استأنف العز الجديد مهانها % % 25(@)(@@) % إذا لحظتني أمسكت بأكفها % % علي ، قلوبا دائما خفقانها % % 26(@)(@@) % فلا هي يوما في ينفذ كيدها % % ولا ينجلي من غيها شنآنها % % 27(@)(@@) % يريد المعالي عاطل من أداتها % % وهيهات من محصوصة طيرانها % % 28(@)(@@) % دعوها لمن رباه مذ كان حجرها % % وأرضعه حتى استقل لبانها % % 29(@)(@@) % ولا تخطبوها بالرجاء ، فما أرى % % تدنس بالبعل الدني حصانها % % 30(@)(@@) % رآني بهاء الملك سيفا عليكم % جريء الظبا لا ينثني صلتانها % % PageV01P1844 31(@)(@@) % فجردني من بعد طول صيانة % وإن مضرا بالسيوف صيانها % % 32(@)(@@) % أفاض ، بلا من ، علي كرامة % ونقص الأيادي إن يزيد امتنانها % % 33(@)(@@) % خرجت أجر الذيل منها وقد نزت % قلوب العدا مني ، وجن جنانها % % 34(@)(@@) % وليس على زهر الكواكب سبة % % إذا غض من أنوارها زبرقانها % % 35(@)(@@) % وقرب لي وافي العذار تلبست % به خيلاء ما يزول افتنانها % % 36(@)(@@) % ألا إن أصناف السيوف كثيرة % % وأقطعها هنديها ويمانها % % 37(@)(@@) % وكل أنابيب القناة شريفة % وأشرفها ، لو تعلمون ، سنانها % % 38(@)(@@) % فكيف وأنتم وثبة الليث إذ رمى % % تخمطها في جمعكم واستنانها % % 39(@)(@@) % وكان يسوء السامعين سماعها % % فصار يهول الناظرين عيانها % % 40(@)(@@) % فمن مبلغ عني الجبان بأنني % % أنا المورد الشقراء يدمى لبانها % % PageV01P1845 41(@)(@@) % ولو لم تعن كفي قناة قويمة % لأجرى ينابيع الدماء بنانها % % 42(@)(@@) % بلينا ونحن الناهضون إلى العلى % % بزمنى يمنيها الغرور زمانها % % 43(@)(@@) % ذئاب أرادت أن تعازز ضيغما % فطال على مر 
ms522	 الزمان هوانها % % 44(@)(@@) % رأوا فترة منا فظنوا ضراعة % % وتلك بروق غرهم شولانها % % 45(@)(@@) % فكيف تعرضتم بغير نباهة % لصعبة عز في يدي عنانها % % 46(@)(@@) % فإن تعتطل يوما من الدهر صعدتي % % فقد طال في نحر العدو طعانها % % 47(@)(@@) % وإن تستجم النائبات سوابقي % % فمن قبل ما بذ الجياد رهانها % % PageV01P1846 البحر : طويل 1(@)(@@) % ظمائي إلى من لو أراد سقاني % % وديني على من لو يشاء قضاني % % 2(@)(@@) % ولو كان عندي معسرا لعذرته % ولكنه ، وهو المليء ، لواني % % 3(@)(@@) % رمى مقتلي واسترجع السهم داميا % غزال بنجلاوين تنتضلان % % 4(@)(@@) % أأرجو شفاء منه وهو الذي جنى % % على بدني داء الضنى وشجاني % % 5(@)(@@) % أبيت ، فلم أستسق من كان غلتي % % ولم استرش من كان قبل براني % % 6(@)(@@) % مررت على تلك الديار ، ووحشها % % دوان ، ومن يحكين غير دواني % % 7(@)(@@) % فأنكرت العينان والقلب عارف % % قليلا ، ولجا بعد في الهملان % 8(@)(@@) % عشية بلتني الدموع كأنما % % رداواي بردا ماتح خضلان % 9(@)(@@) % ضمن وصالي ثم ماطلن دونه % وإن ضمان البيض شر ضمان % 10(@)(@@) % أمنك طروق الزور أية ساعة % وعيد خيال عاد أي أوان ؟ % PageV01P1847 11(@)(@@) % ألم بعوج كالحنايا مناخة % على جزع واد ذي ربى ومجاني % % 12(@)(@@) % وميل كخيطان الأراك ترنحوا % % فمن ذقن مستقبل بلسان % 13(@)(@@) % ومالوا على البوغاء من كل جانب % % عواطف أيدي توأم وثوان % 14(@)(@@) % يقودهم مني غلام غشمشم % % معين على البأساء غير معان % 15(@)(@@) % إذا انفرجت منه السجوف لناظر % تألق نور من أغر هجان % % 16(@)(@@) % وإني لآوي من أعز قبيلة % % إلى نضد ، أو جامل عكنان % 17(@)(@@) % وإن قعودي أرقب اليوم أو غدا % % لعجز ، فما الإبطاء بالنهضان % 18(@)(@@) % سأترك في سمع الزمان دويها % % بقرعي ضراب صادق وطعان % % 19(@)(@@) % وأخصف أخفافا بوقع حوافر % إلى غاية تقضي منى وأماني % % 20(@)(@@) % فإن أسر ، فالعلياء همي ، وإن أقم % فإني على بكر المكارم باني % % PageV01P1848 21(@)(@@) % وإن امض أترك كل حي من العدا % % يقول ألا لله نفس فلان % % 22(@)(@@) % أكرر في الإخوان عينا صحيحة % % على أعين مرضى من الشنآن % 23(@)(@@) % فلولا أبو إسحق قل تشبثي % % بخل ، وضربي عنده بجران % 24(@)(@@) % هو اللافتي 
ms523	 عن ذا الزمان وأهله % % بشيمة لا وان ، ولا متوان % 25(@)(@@) % إخاء تساوى فيه أنسا وألفة % رضيع صفاء أو رضيع لبان % % 26(@)(@@) % تمازج قلبانا مزاج أخوة % % وكل طلوبي غاية إخوان % 27(@)(@@) % وغيرك ينبو عنه طرفي مجانبا % وإن كان مني الأقرب المتداني % % 28(@)(@@) % ورب قريب بالعداوة شاحط % ورب بعيد بالمودة داني % % 29(@)(@@) % لئن رام قبضا من بنانك حادث % لقد عاضنا منك انبساط جنان % % 30(@)(@@) % وإن بز من ذاك الجناح مطاره % % فرب مقال منك ذي طيران % PageV01P1849 31(@)(@@) % وإن أقعدتك النائبات ، فطالما % % سرى موقرا من مجدك الملوان % 32(@)(@@) % وإن هدمت منك الخطوب بمرها % % فثم لسان للمناقب باني % % 33(@)(@@) % مآثر تبقى ما رأى الشمس ناظر % وما سمعت من سامع أذنان % 34(@)(@@) % وموسومة مقطوعة العقل لم تزل % % شوارد قد بالغن في الجولان % 35(@)(@@) % وما زل منك الرأي والحزم والحجى % % فنأسى إذا ما زلت القدمان % 36(@)(@@) % ولو أن لي ، يوما ، على الدهر إمرة % وكان لي العدوى علي الحدثان % % 37(@)(@@) % خلعت على عطفيك برد شبيبتي % % جوادا بعمري واقتبال زماني % % 38(@)(@@) % وحملت ثقل الشيب عنك مفارقي % % وإن فل من غربي وغض عناني % % 39(@)(@@) % ونابت طويلا عنك في كل عارض % بخط وخطو أخمصي وبناني % % 40(@)(@@) % على أنه ما انفل من كان دونه % % حميم يرامي عن يد ولسان % PageV01P1850 41(@)(@@) % وما كل من لم يعط نهضا بعاجز % ولا كل ليث خادر بجبان % 42(@)(@@) % وإنك ما استرعيت مني سوى فتى % % ضموم على رعي الأمانة حان % 43(@)(@@) % حفيظ إذا ما صيع المرء قومه % % وفي ، إذا ما خون العضدان % 44(@)(@@) % من الله أستهدي بقاءك أن ترى % % محلا لأسباب العلى بمكان % 45(@)(@@) % وأسأله إن لا تزال مخلدا % بملقى سماع بيننا وعيان % 46(@)(@@) % إذا ما رعاك الله يوما ، فقد قضى % % مآرب قلبي كلها ورعاني % % PageV01P1851 البحر : بسيط تام 1(@)(@@) % دع من دموعك بعد البين للدمن % غدا لدارهم واليوم للظعن % % 2(@)(@@) % هل وقفة بلوى خبت مؤلفة % بين الخليطين من شام ومن يمن % 3(@)(@@) % عجنا على الركب أنضاء محزمة % أثقالها الشوق من باد ومكتمن % 4(@)(@@) % موسومة بالهوى يدرى برؤيتها % % إن 
ms524	 المطايا مضمري شجن % % 5(@)(@@) % ثم انثنينا على يأس وقد وجلت % % نواظر بمجاري دمعها الهتن % 6(@)(@@) % تروم رد نفوس بعد طيرتها % % على قوادم من وجد ومن حزن % 7(@)(@@) % تعريسة بين رملي عالج ضمنت % % بل الغليل لقلب الموجع الضمن % % 8(@)(@@) % بتنا سجودا على الأكوار يحملنا % % لواغب قد لطمن الأرض بالثفن % 9(@)(@@) % أهفو إلى الريح إن هبت يمانية % % تحدو زعازعها عيرا من المزن % 10(@)(@@) % أبى ضميري إلا ذكره ، وأبى % % تعرض البرق إلا أن يؤرقني % % PageV01P1852 11(@)(@@) % شوق ألم وما شوقي إلى أحد % سوى الذي نام عن ليلي وأيقظني % % 12(@)(@@) % إن زاغ قلبي ، فإن الهجر أحرجني % % وإن صبرت فإن اليأس صبرني % % 13(@)(@@) % وكم رمتني من الأقدار منبضة % لم تثن باعي ولم يحرج لها عطني % % 14(@)(@@) % ما كنت أعلم والأيام عالمة % % إن الليالي تقاعيني لتنهشني % % 15(@)(@@) % قد أدمج الهم في عنقي حبائله % ولزة الهم تنسي لزة القرن % 16(@)(@@) % إن يبل ثوبي ، فإني أكتسي حسبي % % أو تود خيلي فإني أمتطي منني % % 17(@)(@@) % وأدخل البيت لم تأذن قعائده % % على الحصان أمام القوم والحصن % % 18(@)(@@) % لا أطلب المال إلا من مطالبه % ولا يفي لي بذل المال بالمنن % 19(@)(@@) % إن البخيل الذي قد بات يؤنسني % % مثل الجواد الذي قد بات يمطلني % % 20(@)(@@) % لقد تقدم بي فضلي بلا قدم % % أعظم بأمر على ذي السن قدمني % % PageV01P1853 21(@)(@@) % لا يبرح المجد مرفوعا دعائمه % % ما دام معتمدا منا على ركن % % 22(@)(@@) % من أسرة تنبت التيجان هامهم % منابت النبع في الأطواد والقنن % % 23(@)(@@) % المجد أنوط من كف إلى عضد % فيهم ، وأقوم من رأس على بدن % 24(@)(@@) % من مبلغ لي أبا إسحاق مألكة % % عن حنو قلب سليم السر والعلن % 25(@)(@@) % جرى الوداد له مني ، وإن بعدت % منا العلائق مجرى الماء في الغصن % 26(@)(@@) % لقد توامق قلبانا كأنهما % % تراضعا بدم الأحشاء لا اللبن % 27(@)(@@) % مسود قصب الأقلام نال بها % % نيل المحمر أطراف القنا اللدن % 28(@)(@@) % إن لم تكن تورد الأرماح موردها % % فما عدلت إلى الأقلام عن جبن % % 29(@)(@@) % والطاعن الطعنة النجلاء عن جلد % كالقائل القولة الغراء عن 
ms525	 لسن % 30(@)(@@) % حار المجارون إذ جاروك في طلق % % وأجفلوا عن طريق السابق الأرن % % PageV01P1854 31(@)(@@) % ضلوا وراءك حتى قال قائلهم : % ماذا الضلال وذا يجري على السنن % % 32(@)(@@) % ما قدر فضلك ما أصبحت ترزقه % % ليس الحظوظ على الأقدار والمهن % 33(@)(@@) % قد كنت قبلك من دهري على حنق % فزاد ما بك من غيظي على الزمن % 34(@)(@@) % كم راشنا وبرانا ، غير مكترث % بما نعالج ، بري القدح بالسفن % 35(@)(@@) % ألقى على آل وضاح حويته % % وحك بركا على سيف بن ذي يزن % 36(@)(@@) % ومثلها أنشب الأظفار في مضر % ومر يحرق بالأنياب لليمن % % 37(@)(@@) % إن يدن قوم إلى داري فألفهم % % وتنأ عني فأنت الروح في البدن % 38(@)(@@) % فالمرء يسرح في الآفاق مضطربا % % ونفسه أبدا تهفو إلى الوطن % 39(@)(@@) % والبعد عنك بلاني باستكانهم % إن الغريب لمضطر إلى السكن % 40(@)(@@) % أنت الكرى مؤنسا طرفي وبعضهم % مثل القذى مانع عيني من الوسن % PageV01P1855 41(@)(@@) % كم من قريب يرى أني كلفت به % % يمسى شجاي وتضحى دونه شجني % % 42(@)(@@) % وصاحب طال ما ضرت صحابته % % عكفت منه على اطغى من الوثن % 43(@)(@@) % مستهدف لمرامي العيب جانبه % يكاد ينعط برداه من الظنن % 44(@)(@@) % ذي سؤة إن ثناها محفل كثرت % % لها المضارب فوق الصدر بالذقن % 45(@)(@@) % إذا احتميت به أحمي على كبدي % % كيف اجتناني إذا أسلمنني جنني % % 46(@)(@@) % لا تجعلن دليل المرء صورته % % كم مخبر سمج عن منظر حسن % 47(@)(@@) % إن الصحائف لا يقريك باطنها % % نفس الطوابع موسوما على الطين % 48(@)(@@) % أشتاقكم ودواعي الشوق تنهضني % % إليكم وعوادي الدهر تقعدني % % 49(@)(@@) % وأعرض الود أحيانا فيؤنسني % % وأذكر البعد أطوارا فيوحشني % % 50(@)(@@) % هذا ، ودجلة ما بيني وبينكم % وجانب العبر غير الجانب الخشن % PageV01P1856 51(@)(@@) % ومشرف كسنام العود ملتبس % كالماء لز بأضلاع من السفن % 52(@)(@@) % كالخيل ربطن دهما في مواقفها % % والبزل قطرن بين الحوض والعطن % 53(@)(@@) % قد جاءت النفثة الغراء ضامنة % % ما يوبق النفس من عجب ومن درن % 54(@)(@@) % أنبطت من حسنها ماء بلا نصب % وحزت من نظمها درا بلا ثمن % 55(@)(@@) % أنشدتها فحدا سمعي غرائبها % % إلى الضمير حداء الركب للبدن 
ms526	 % 56(@)(@@) % جازت إلى خاطري عفوا وخيل لي % % مما استبت أذني ، أن لم تجز أذني % % 57(@)(@@) % فاقتد إليك أبا إسحاق قافية % % قود الجواد ، بلا جل ولا رسن % 58(@)(@@) % كادت تقاعس لو ما كنت قائدها % % تقاعس البازل المجنوب في الشطن % 59(@)(@@) % تستوقف الركب إن مرت معارضة % تهدي عقيلتها العذراء من يمن % PageV01P1857 البحر : وافر تام 1(@)(@@) % تواعد ذا الخليط لأن يبينا % % وزايلنا القطين ، فلا قطينا % % 2(@)(@@) % وإني ، والمواعد كاذبات % ليطمعنا خلاب الواعدينا % % 3(@)(@@) % نعنى بالمطال من الغواني % % وهان على المواطل ما لقينا % % 4(@)(@@) % ونظمأ والموارد معرضات % فنرجع بالغليل ، وما سقينا % % 5(@)(@@) % لهن الله كيف أصبن منا % % نفوسا ما عقلنا وما ودينا % % 6(@)(@@) % لقين قلوبنا بجنود حرب % تطاعن بالدمالج والبرينا % % 7(@)(@@) % جلون لنا لآليء واضحات % أضأن بها الذوائب والقرونا % % 8(@)(@@) % عهدنا الدر مسكنه أجاج % فكيف تبدل الثغب المعينا % % 9(@)(@@) % جنون المرشقات غداة جمع % % بأقتل من نبالك ما رمينا % % 10(@)(@@) % ولم نر كالعيون ظبا سيوف % % أرقن دما ، وما رمن الجفونا % % PageV01P1858 11(@)(@@) % عوائد من تذكر آل ليلى % % كأن لها على قلبي ديونا % % 12(@)(@@) % أكاتمها ففي الأحشاء منها % % مضيض بعدما بلغ الحنينا % % 13(@)(@@) % فيا حادي السنين قف المطايا % % وعز على العقائل أن يهونا % % 14(@)(@@) % وإن الرأس بعدك صوحته % % بوارح شيبة فغدا جبينا % % 15(@)(@@) % وكان سواده عيد الغواني % % يعدن إلى مطالعة العيونا % % 16(@)(@@) % أتاجرها ، فأربح في التصابي % % وبعض القوم يحسبني غبينا % % 17(@)(@@) % أهان الشيب ما أعززن منه % % 18(@)(@@) % جنون شبيبة ووقار شيب % % خذا عني النهى ودعا الجنونا % % 19(@)(@@) % نرى الأيام وهي غدا سنون % % وبالآحاد يبلغن المئينا % % 20(@)(@@) % ستنبئنا النوائب ما أرتنا % % من العجب العجيب بما ترينا % % PageV01P1859 21(@)(@@) % حلفت بملقيات التي عوج % خوابط تطلب البلد الأمينا % % 22(@)(@@) % حوامل ناحلين على ذراها % % حواني ينجذبن بمنحنينا % % 23(@)(@@) % يسقين الهجير على التظامي % % وينعلن الحرار إذا وجينا % % 24(@)(@@) % كأن سياطها ولها هباب % % قلوع اليم زعزعت السفينا % % 25(@)(@@) % بكل معبد القطرين ينضي % % مطال طريقه الأجد الأمينا % % 26(@)(@@) % لقد أرضى قوام الدين فينا % % وصاة الله والدين اليقينا % % 27(@)(@@) % رعانا بالقنا ، ولقد ترانا % % وأضبع ما نكون 
ms527	 إذا رعينا % % 28(@)(@@) % أعاد ثقافنا حتى استقمنا % % ودل بنوره اللقم المبينا % % 29(@)(@@) % تيقظ والعيون مغمضات % % وقلقل والرعية وادعونا % % 30(@)(@@) % نماه أب ولود للمعالي % % وفي خرق الوليد ولا جنينا % % PageV01P1860 31(@)(@@) % من القوم الألى تبعوا المعالي % % قران العود يتبع القرينا % % 32(@)(@@) % أقاموا عن فرائسها الليالي % % وردوا عن موادرها المنونا % % 33(@)(@@) % هم رفعوا كما رفعت نزار % % قباب على على كرم بنينا % % 34(@)(@@) % نبقي سائرات الدهر فيهم % % ويبقون اليد البيضاء فينا % % 35(@)(@@) % فإن نثمر لهم شكرا طويلا % فهم غرسوا ، وكانوا المورقينا % % 36(@)(@@) % فقل للمصحرين دعوا الضواحي % % فإن الليث قد نزع العرينا % % 37(@)(@@) % ولا تتغنموا منه قعودا % يقيم لكم به الحرب الزبونا % % 38(@)(@@) % ففي أغماده ورق قديم % % يزيد علي قراع الصيد لينا % % 39(@)(@@) % قواضب لا يغب بها الهوادي % % فيعطيها الصياقل والقيونا % % 40(@)(@@) % أليس وقاعه بالأمس فيكم % % سقى غلل الرماح وما روينا % % PageV01P1861 41(@)(@@) % بأربق قد أدار لكم رحاها % % مدار الطود مرداة طحونا % % 42(@)(@@) % وجلجلها على الأهواز حتى % % أعاد زئير أسدكم أنينا % % 43(@)(@@) % وساخ ، تقصع اليربوع ، غاو % أثار بطعنها ، فنجا طعينا % % 44(@)(@@) % أشيعث ، رأسه بالبيض يفلى % % ويغدو بالدم الجاري دهينا % % 45(@)(@@) % يذود رقابها هيهات منها % % وقد غلبت عصي الذائدينا % % 46(@)(@@) % تولع بالقنا فتطاوحته % % لداغ الدبر ، أيدي الغاسلينا % % 47(@)(@@) % غدا يمري عفافتها ، فأمسى % % يرى بالطعن لقحتها لبونا % % 48(@)(@@) % ومن شرعت رماح الله فيه % % درى أن السوابغ لا يقينا % % 49(@)(@@) % وبتن على المطالع ملجمات % % علائقها أنابيب القنينا % % 50(@)(@@) % على صهواتها أبناء موت % % حواسر للردى ومقنعينا % % PageV01P1862 51(@)(@@) % مجاذبة أعنتها جماحا % % هبطن قرارة وطلعن بينا % % 52(@)(@@) % وقعن بغارة ، وطلبن أخرى % % يماطلن الإقامة والصفونا % % 53(@)(@@) % تكفكف وهي في الغلواء تلقي % % إلى أرض العدا نظرا شفونا % % 54(@)(@@) % تلفت جوع الآساد فاتت % فرائسها النيوب وقد دمينا % % 55(@)(@@) % تحاذر في مرابطها وقوفا % وإن بلغ العدا أمدا شطونا % % 56(@)(@@) % فلو ألجمن لا لغوار حرب % لقد ظن العدو بها الظنونا % % 58(@)(@@) % ومنشرها على هضبات بم % رياطا للعجاجة ما طوينا % % 59(@)(@@) % إذا رجع الغزي بهن حسرى % % أعدن إلى الطعان كما بدينا % % 60(@)(@@) % لحقن طريدة لولا قناها % % لطال رواغها 
ms528	 للطاردينا % % 61(@)(@@) % وعدن ، وفي حقائبهن هام % لقين من الصوارم ما لقينا % % PageV01P1863 62(@)(@@) % بقناص أصاب وفي يديه % % حبائل قد مددن لآخرينا % % 63(@)(@@) % نوائب ألقت الجلى عليه % فقام بعبئهن وما أعينا % % 64(@)(@@) % % وحنظلة الذي قطع الوضينا % % 65(@)(@@) % وهل يرضى المطول وفي الأعادي % % ديون للصوارم ما قضينا % % 66(@)(@@) % إلا جزت الجوازي اليوم عني % % جوادا لا أغم ولا هجينا % % 67(@)(@@) % نماه أب ولوج للمعالي % % وأم أراقم تدهي البنينا % % 68(@)(@@) % من العظماء أطولهم عمادا % وأنداهم إذا مطروا يمينا % % 69(@)(@@) % تبوع بي إلى قلل المعالي % % وخيرني المعاقل والحصونا % % 70(@)(@@) % فأرغم بي على رغم أنوفا % مضاغنة ، وأقذى بي عيونا % % 71(@)(@@) % تهن بمطلع النيروز وابلغ % مطالع مثله حينا فحينا % % PageV01P1864 72(@)(@@) % مرحل كل نائبة مقيما % مذيلا للعدا ، أبدا مصونا % % 73(@)(@@) % تظفر بالمآرب طيعات % وبالآمال أبكارا وعونا % % 74(@)(@@) % وإن أحق منك بأن يهنى % % إذا مد البقاء لك ، السنونا % % PageV01P1865 البحر : طويل 1(@)(@@) % جناني شجاع إن مدحت وإنما % % لساني إن سيم النشيد جبان % % 2(@)(@@) % وما ضر قوالا أطاع جنانه % إذا خانه عند الملوك لسان % % 3(@)(@@) % ورب حيي في السلام وقلبه % % وقاح ، إذا لف الجياد طعان % 4(@)(@@) % ورب وقاح الوجه يحمل كفه % % أنامل لم يعرق بهن عنان % 5(@)(@@) % وفخر الفتى بالقول لا بنشيده % % ويروي فلان مرة وفلان % % PageV01P1866 البحر : طويل 1(@)(@@) % دعا بالوحاف السود من جانب الحمى % % نزيع هوى ، لبيت حين دعاني % % 2(@)(@@) % تعجب صحبي من بكائي وأنكروا % % جوابي لما لم تسمع الأذنان % % 3(@)(@@) % فقلت نعم لم تسمع الأذن دعوة % % بلى إن قلبي سامع وجناني % % 4(@)(@@) % ويا أيها الركب اليمانون خبروا % % طليقا بأعلى الخيف أني عاني % % 5(@)(@@) % عدوه لقائي أوعدوني لقاءه % % إلا ربما دانيت غير مداني % % 6(@)(@@) % وما حائمات يلتقين من الصدى % % إلى الماء قد موطلن بالرشفان % 7(@)(@@) % يزيد لها بالخمس بين ضلوعها % % تنسم ريح الشيح والعلجان % 8(@)(@@) % إذا قيل هذا الماء لم يملكوا لها % % معاجا بأقران ولا بمثان % 9(@)(@@) % بأظمى إلى الأحباب مني وفيهم % غريم ، إذا رمت الديون لواني % % 10(@)(@@) % فيا صاحبي رحلي أقلا فإنني % % رأيت بليلى غير ما تريان % PageV01P1867 11(@)(@@) % ويا مزجي 
ms529	 النضو الطليح عشية % تراك ببطن المأزمين تراني % % 12(@)(@@) % وهل أنا غاد أنشد النبلة التي % % بها عرضا ذاك الغزال رماني % % 13(@)(@@) % فلم يبق من أيام جمع إلى منى % % إلى موقف التجمير غير أماني % % 14(@)(@@) % يعلل دائي بالعراق طماعة % وكيف شفائي والطبيب يماني % % PageV01P1868 البحر : طويل 1(@)(@@) % أفي كل يوم لي عشار تسوقها % % رماح بني الغبراء سوق الظعائن % 2(@)(@@) % أحالوا عليها عاكسين رقابها % % وطوا بهواديها مكان الفراسن % % 3(@)(@@) % إذا جزت في أبيات آل محلم % % تراغين نحوي من وراء المعاطن % 4(@)(@@) % تحن إلى ترعية لم يرد بها % % وبيء المراعي والنطاف الأواجن % % 5(@)(@@) % وخالسنيها كل أطلس خاتل % % خفي المرامي عن قسي الضغائن % 6(@)(@@) % وشر الأذى ما جاء من غير حسبة % % وكيد المبادي دون كيد المداهن % % 7(@)(@@) % وإن بلوغ الخوف من قلب خائف % لدون بلوغ الخوف من قلب آمن % % 8(@)(@@) % وخيل جررن النقع في كل بلدة % وناقلن فيها بالطوال الموارن % % 9(@)(@@) % حواها العدا عني ، فأصبحن بالحمى % % عواطل من آبي عليق وصافن % 10(@)(@@) % وثلة حي قد أضب بأرضها % % ذؤالة أضباب الغريم المداين % % PageV01P1869 11(@)(@@) % ولولا ذئاب العامري لشابهت % % بمكة أسراب الحمام القواطن % % 12(@)(@@) % لنا كل يوم منه ذئب عمرد % % دم الشعر في أنيابه والبراثن % 13(@)(@@) % متى تطلعوا نجدا أو الغور تفضحوا % % بوسم فشت نيرانه في المواطن % 14(@)(@@) % خطبتم إلى شمس الخدود فوارك % طوالق من حبل اللئام بوائن % 15(@)(@@) % عذارى بغت فيكم بغاء نسائكم % % وقد كن عندي في ثياب الحواضن % 16(@)(@@) % خذوها فلو قرنتموها ببرقة % % قطعن إلى داري وثاق القرائن % PageV01P1870 البحر : سريع 1(@)(@@) % ومستهلات كصوب الحيا % % تبقى ، وأقوال الفتى تفنى % % 2(@)(@@) % منتصبات كالقنا لا نرى % % عيا من القول ولا أفنا % % 3(@)(@@) % قد حرم الناظر من حسنها % % قائلها ما رزق الأذنا % % 4(@)(@@) % لا يفضل المعنى على لفظه % شيئا ، ولا اللفظ على المعنى % % PageV01P1871 البحر : كامل تام 1(@)(@@) % ووصية خلفت لنا من حازم % وطئ الزمان سهولة وحزونا % % 2(@)(@@) % لما تعذر أن يبقي نفسه % % بقى ، علينا رأيه المأمونا % % PageV01P1872 البحر : بسيط تام 1(@)(@@) % أي المنازل نرضى بعدكم وطنا % % هان الفراق فما نعني بمن ظعنا 
ms530	 % % 2(@)(@@) % لقد سقوك بأطباء ملعنة % كأنما كنت تسقى السم لا اللبنا % % PageV01P1873 البحر : كامل تام 1(@)(@@) % هذي المنازل فاضربي بجران % % وتذكري الأوطار بالأوطان % % 2(@)(@@) % حي الطلول كما تحيي أهلها % % إن الطلول وأهلها سيان % % PageV01P1874 البحر : وافر تام 1(@)(@@) % قصور الجد مع طول المساعي % % وقول الناس لم ينجح فلان % % 2(@)(@@) % أحب إلي من سعي هجين % وإن بلغ العلى جد هجان % 3(@)(@@) % يذم لي الزمان إذا الامت % % يداه ولا يذم بي الزمان % % PageV01P1875 البحر : خفيف تام 1(@)(@@) % سبق الدهر جدكم في الرهان % % وعلت ناركم على النيران % 2(@)(@@) % وجرى في عنانكم جامح الج % د ، مطولا يلوي بكل عنان % PageV01P1876 البحر : وافر تام 1(@)(@@) % هبي لي ني زورك والبواني % % وأمي مسقط النجم اليماني % % 2(@)(@@) % فإنك ما رعيت من الفيافي % % طويلا ما رعيت من الأماني % % PageV01P1877 البحر : كامل تام 1(@)(@@) % بئس التحية بيننا المران % وضراب يوم وقيعة وطعان % % 2(@)(@@) % بسطوا إلي أناملا مغروسة % في اللؤم لم يعرق لهن عنان % PageV01P1878 البحر : متقارب تام 1(@)(@@) % وبرق حدا المزن حدو الثقال % % يزجي على الأين حينا فحينا % % 2(@)(@@) % كراعي العشار أحس الظلام % % فساق الهجائن بيضا وجونا % % PageV01P1879 البحر : طويل 1(@)(@@) % إلى أين مرمى قصدها وسراها % % رمى الله من أخفافها بوجاها % % 2(@)(@@) % هو اليأس فليحبس هباب رقابها % % كما كان مغرور الرجاء حداها % % 3(@)(@@) % رأت لامعا ، فاستشرقت لمضائه % ولو كان من مزن الندى لشفاها % % 4(@)(@@) % تدافعها الحي اللئيم عماية % % وأعرض طوع اللؤم وهو يراها % % 5(@)(@@) % فماطل أصحاب الحياض ورودها % % وأعتم أرباب المبيت قراها % % 6(@)(@@) % تلطمها الأيدي القصار عن الرقى % % وخير من الري الذليل صداها % % 7(@)(@@) % ترى كل ميلاء السنام كأنما % % من الطود إلا زجوها وخطاها % % 8(@)(@@) % مناقلة تنجو بزجرة غيرها % % وترهب سوط المرء راع سواها % % 9(@)(@@) % تكاد من الإسراع تسبق أمها % % بمنتجها قبل اللقاح أباها % % 10(@)(@@) % تعود ولم تشرع بحوض ابن حرة % % ولا عريت عند الكرام ذراها % % PageV01P1880 11(@)(@@) % رأين ديارا بين بصرى وجاسم % مراعي ليوم لا تلس خلاها % % 12(@)(@@) % نفوس لئام لا تحل عقودها % % وأيدي جمود لا ينض صفاها % % 13(@)(@@) % ألا ! لا تلوموا ظاعنا قذفت به % بنات 
ms531	 السرى عن أرضكم ونواها % % 14(@)(@@) % رعت ذروة فيكم ضحى جاشرية % فأجشرت في أوطانكم ، وأعاها % % 15(@)(@@) % تحمل عنها شر دار إقامة % % إذا قيل أي الأرض قال خلاها % % 16(@)(@@) % فكم موحشات بالرفاق أزاحها % % ولمة ليل بالمطي فلاها % % 17(@)(@@) % كان حماكم خطة الخسف للفتى % % إذا سيمها الحر الكريم أباها % % 18(@)(@@) % ولو بابن ليلى كان ملقى رحالها % % لطرق من حر النضار ثراها % % 19(@)(@@) % تباينتها فعلا ، فكم من عظيمة % أتيت بها مرحولة وكفاها % % 20(@)(@@) % حماك ملما منتضى لك حده % وداهية تشحو لضغنك فاها % % PageV01P1881 21(@)(@@) % غداة أغامت بالعجاج سماؤها % % ودارت على قطب الطعان رحاها % % 22(@)(@@) % إذا السيل والى في الركاء سجاله % % وأنبط ، أنقوت الندى ، وأماها % % 23(@)(@@) % أرى شجرا طالت وقصر ظلها % % فلا أورقت يوما وطال ذواها % % 24(@)(@@) % ولو جمعت لونين بذل شباكها % % لطالبها الراجي بمنع جناها % % 25(@)(@@) % أضرا ولؤما لا أبا لأبيكم % سفاها لرأي العاجزين سفاها % % 26(@)(@@) % نلوم أكف المحسنين إذا جنت % % فكيف بأيد لا ينال جداها % % 27(@)(@@) % ضلالا لراجي نشطة من ربيعكم % رمى الداء في أكلائكم فحماها % % 28(@)(@@) % وعين رجتكم أن تكونوا جلاءها % % فكنتم على عكس الرجاء قذاها % % 29(@)(@@) % طلبتم ثنائي ثم عفتم سماعه % % كمن خطب العذراء ، ثم قلاها % % 30(@)(@@) % وما كل جيد موضع لقلائدي % % ولا قمن من صوغها وحلاها % % PageV01P1882 31(@)(@@) % فلا تغررن عينيك يا خابط الدجى % % قباب بناها اللؤم حيث بناها % % 32(@)(@@) % ودار لئام إن رأى الركب سمتها % % تحايد عنها عامدا ، وطواها % % 33(@)(@@) % مساو كنيران البقاع مضيئة % ونار ظلام لا يضيء سناها % % 34(@)(@@) % ألا غنياني بالديار ، فإنني % % أحب زرودا ما أقام ثراها % % 35(@)(@@) % وبين النقا والأنعمين محلة % % حبيب لقلبي قاعها ورباها % % 36(@)(@@) % ونعمان يا سقيا لنعمان ما جرت % % عليه النعامى بعدنا وصباها % % 37(@)(@@) % وللقلب عند المأزمين وجمعها % % ديون ومضى خيفها ومناها % % 38(@)(@@) % وظبي بأطوار الجمار إذا غدا % % رمى كبدا مقروحة ورماها % % 39(@)(@@) % وغيداء لم تصحب سوى الشمس أختها % % ولا جاورت إلا الغزال أخاها % % 40(@)(@@) % وخلة فرسان عيون ظبائها % % أمض جراحا من طعان قناها % % PageV01P1883 41(@)(@@) % هي الدار لا دار بأكناف بابل % جدير بضيم النازلين حماها 
ms532	 % % 42(@)(@@) % منازل ممنون على الركب زادها % % نزور على كد المطال جداها % % 43(@)(@@) % فلا سقيت إلا الصوارم والقنا % % ولا صاب إلا بالدماء حياها % % PageV01P1884 البحر : متقارب تام 1(@)(@@) % تلفت ، والرمل ما بيننا % % وأعلام ذي بقر أو رباه % 2(@)(@@) % فقلت على طربات الهوى : % عسى الطرف يبلغهم أو كراه % % 3(@)(@@) % فما لقي الحب إلا الجوى % % ولا بلغ الطرف إلا قذاه % 4(@)(@@) % بذكري أشم ثرى أرضه % على نأيه ، وبقلبي أراه % 5(@)(@@) % عسى من رمى بالمحب الغري % % ب مرمى بعيدا يقضي نواه % 6(@)(@@) % وتدنو الديار بسكانها % % تمني امرىء ما عراكم عراه % 7(@)(@@) % أصاح ترى البرق في لمعه % تخلج أيم يلوي مطاه % 8(@)(@@) % وقالوا : سناه على رامة % ويا بعد موقفنا من سناه % 9(@)(@@) % دع القلب يأرق من ذكرهم % % فقد ذاق من بينهم ما كفاه % % 10(@)(@@) % فلا حط إلا بهم رحله % ولا جاد إلا عليهم حياه % PageV01P1885 البحر : وافر تام 1(@)(@@) % أحبك ما أقام منى وجمع % وما أرسى بمكة أخشباها % % 2(@)(@@) % وما رفع الحجيج إلى المصلى % % يجرون المطي على وجاها % % 3(@)(@@) % وما نحروا بخيف منى وكبوا % % على الأذقان مشعرة ذراها % % 4(@)(@@) % نظرتك نظرة بالخيف كانت % % جلاء العين مني بل قذاها % % 5(@)(@@) % ولم يك غير موقفنا فطارت % % بكل قبيلة منا نواها % % 6(@)(@@) % فواها كيف تجمعنا الليالي % % وآها من تفرقنا ، وآها % % 7(@)(@@) % فأقسم بالوقوف على آلال % ومن شهد الجمار ومن رماها % % 8(@)(@@) % وأركان العتيق وبانييها % % وزمزم والمقام ومن سقاها % % 9(@)(@@) % لأنت النفس خالصة ، فإن لم % تكونيها ، فأنت إذا مناها % % 10(@)(@@) % نظرت ببطن مكة أم خشف % تبغم ، وهي ناشدة طلاها % % PageV01P1886 11(@)(@@) % وأعجبني ملامح منك فيها % % فقلت أخا القرينة أم تراها ؟ % 12(@)(@@) % فلولا أنني رجل حرام % ضممت قرونها ولثمت فاها % % PageV01P1887 البحر : رجز تام 1(@)(@@) % يا طالبا ملك بني بويه % % ما أنت من ذاك ولا إليه % % 2(@)(@@) % إرث قوام الدين عن أبيه % خل عنان الملك في يديه % % 3(@)(@@) % مناضلا يذب عن ثغريه % % بديهة الصل جلا نابيه % 4(@)(@@) % يلجلج الموت بماضغيه % يكتلئ الدين بناظريه % % 5(@)(@@) % كالمقضب اضطر إلى حديه % % نجا الذي فاز بحجزتيه % % 6(@)(@@) % وضل 
ms533	 مغرور بما لديه % % يحتك بالعضب ومضربيه % 7(@)(@@) % شتان من ينفض مذروبه % % مخايلا ، ينظر في عطفيه % 8(@)(@@) % ما نقل الذابل في كفيه % % ومن طوى المجد على غربيه % 9(@)(@@) % مرتقيا إلى ذؤابتيه % % إذا المقام لم يقم حوليه % 10(@)(@@) % قام به يركد في حاليه % % لا يطرف الهول به جفنيه % % PageV01P1888 11(@)(@@) % شوك القنا يلدغ أخمصيه % % قد قلت للطالب غايتيه % % 12(@)(@@) % أقع ، فما غورك من نجديه % ما أنت والطول إلى فرعيه % % 13(@)(@@) % سقط شرار طار عن زنديه % من يطلع اليوم ثنيتيه % 14(@)(@@) % قد سبق الناس إلى مجديه % سبق الجواد بقلادتيه % % 15(@)(@@) % في فلك العز إلى قطبيه % % يمسي به ثالث نيريه % % 16(@)(@@) % أي فتى ينزع في سجليه % % قد ورد الماء بجمتيه % 17(@)(@@) % أما ترى الضرغام في غابيه % مزمجرا يفتل ساعديه % 18(@)(@@) % قد أنشب الفريس في ظفريه % % هيهات من يغلبه عليه % 19(@)(@@) % أقسمت بالبيت وبانييه % % عظم ما عظم من ركنيه % 20(@)(@@) % رب منى ورب مأزميه % % ورب من عج بوقفتيه % % PageV01P1889 21(@)(@@) % عريان إلا معقدي برديه % % لقد وسمت الدهر صفحتيه % 22(@)(@@) % يقوده يوضع في عرضيه % % قود الضليع مل جاذبيه % 23(@)(@@) % قد أغبط الرحل على دفيه % % حتى رأينا نضح ذفرتيه % % 24(@)(@@) % يا نفس ضني بك أن تلقيه % عساه يدعوك لأن تريه % 25(@)(@@) % لبيه من داع دعا لبيه % % PageV01P1890 البحر : مجزوء الكامل 1(@)(@@) % عاد الهوى بظباء مك % % ة للقلوب كما بداها % % 2(@)(@@) % وخبت عليك منى تبا % % ريح الغرام وما زهاها % % 3(@)(@@) % طربا على طرب بها % % يا دين قلبك من جواها % % 4(@)(@@) % إني علقت على منى % % لمياء يقتلني لماها % % 5(@)(@@) % راحت مع الغزلان قد % لعبت بقلبي ، ما كفاها % % 6(@)(@@) % تبغي الثواب ، فمهجتي % % هذي القريحة من رماها % % 7(@)(@@) % تزهو على تلك الظبا % % ء فليت شعري من أباها % % 8(@)(@@) % وقف الهوى بي عندها % % وسرت بقلبي مقلتاها % % 9(@)(@@) % بردت علي كأنما % % طل الغمامة عارضاها % % 10(@)(@@) % شمس أقبل جيدها % % يوم النوى ، وأجل فاها % % PageV01P1891 11(@)(@@) % وأذود قلبا ظامئا % لو قيل : وردك ما عداها % % 12(@)(@@) % ولو استطاع لقد جرى % % مجرى الوشاح على حشاها % % 13(@)(@@) % يا يوم مفترق الرفا % % ق 
ms534	 ترى تعود لملتقاها % % 14(@)(@@) % قالت : سيطرقك الخيا % % ل من العقيق على نواها % % 15(@)(@@) % فعدي بطيفك مقلة % إن غبت تطمع في كراها % % 16(@)(@@) % إني شربت من الهوى % % حمراء صرف ساقياها % % 17(@)(@@) % يا سرحة بالقاع لم % يبلل بغير دمي ثراها % % 18(@)(@@) % ممنوعة ، لا ظلها % % يدنو إلي ولا جناها % % 19(@)(@@) % أكذا تذوب عليكم % نفسي ، وما بلغت مناها % % 20(@)(@@) % جسد يقلب للضنى % % بيدي طبيبة سواها % % PageV01P1892 21(@)(@@) % أين الوجوه أحبها % % وأود لو أني فداها % % 22(@)(@@) % أمسى لها متفقدا % في العائدين ولا أراها % % 23(@)(@@) % واها ولولا أن يلو % % م اللائمون ، لقلت : آها % % PageV01P1893 البحر : مجزوء الخفيف 1(@)(@@) % اكبح النفس إن جم % % حت إلى غاية بها % % 2(@)(@@) % أنا مولى لشهوتي % % وسواي عبد لها % % 3(@)(@@) % لا يذل العزيز إلا % لا إذا رام مسها % % 4(@)(@@) % لو رأى المستغر ما % % ضرر اللهو ما لها % % PageV01P1894 البحر : طويل 1(@)(@@) % لمن بعده أسيافه وقناه % % ومن يولع البيض الرقاق سواه % % 2(@)(@@) % فقد كان يرجو أن ينال مناه % % فخلفني فردا ، ونال رداه % PageV01P1895 البحر : خفيف تام 1(@)(@@) % علق القلب من أطال عذابي % % ورواحي على الجوى وغدوي % % 2(@)(@@) % وافترقنا في مذهب الحب شتى % % بين تقصيره وبين غلوي % % 3(@)(@@) % كان عندي أن الحبيب شقيقي % % في التصافي فكان عين عدوي % % 4(@)(@@) % ساءني ، مذ نأيت ، نسيان ذكري % % فاذكروني ولو ذكرت بسو % PageV01P1896 البحر : طويل 1(@)(@@) % أقول لركب رائحين لعلكم % % تحلون من بعدي العقيق اليمانيا % % 2(@)(@@) % خذوا نظرة مني فلاقوا بها الحمى % % ونجدا وكثبان اللوى والمطاليا % % 3(@)(@@) % ومروا على أبيات حي برامة % % فقولوا : لديغ يبتغي اليوم راقيا % % 4(@)(@@) % عدمت دوائي بالعراق فربما % % وجدتم بنجد لي طبيبا مداويا % % 5(@)(@@) % وقولوا لجيران على الخيف من منى % % تراكم من استبدلتم بجواريا % % 6(@)(@@) % ومن حل ذاك الشعب بعدي وراشقت % % لواحظه تلك الظباء الجوازيا % % 7(@)(@@) % ومن ورد الماء الذي كنت واردا % به ورعى الروض الذي كنت راعيا % % 8(@)(@@) % فوالهفتي كم لي على الخيف شهقة % % تذوب عليها قطعة من فؤاديا % % 9(@)(@@) % صفا العيش من بعدي لحي على النقا % % حلفت لهم لا أقرب الماء صافيا % % 10(@)(@@) % فيا جبل الريان إن 
ms535	 تعر منهم % فإني سأكسوك الدموع الجواريا % % PageV01P1897 11(@)(@@) % ويا قرب ما أنكرتم العهد بيننا % % نسيتم وما استودعتم الود ناسيا % % 12(@)(@@) % أأنكرتم تسليمنا ليلة النقا % % وموقفنا نرمي الجمار لياليا % % 13(@)(@@) % عشية جاراني بعينيه شادن % حديث النوى حتي رمى بي المراميا % % 14(@)(@@) % رمى مقتلي من بين سجفي عبيطه % % فيا راميا لا مسك السوء راميا % % 15(@)(@@) % فيا ليتني لم أعل نشزا إليكم % حراما ولو أهبط من الأرض واديا % % 16(@)(@@) % ولم أدر ما جمع وما جمرنا منى % % ولم ألق في اللاقين حيا يمانيا % % 17(@)(@@) % ويا ويح قلبي كيف زايدت في منى % بذي البان لا يشرين إلا غواليا % % 18(@)(@@) % ترحلت عنكم لي أمامي نظرة % % وعشر وعشر نحوكم لي ورائيا % % 19(@)(@@) % ومن حذر لا أسأل الركب عنكم % وأعلاق وجدي باقيات كما هيا % % 20(@)(@@) % ومن يسأل الركبان عن كل غائب % % فلا بد أن يلقى بشيرا وناعيا % % PageV01P1898 21(@)(@@) % وما مغزل أدماء تزجي بروضة % % طلا قاصرا عن غاية السرب وانيا % % 22(@)(@@) % لها بغمات خلفه تزعج الحشى % % كجس العذارى يختبرن الملاهيا % % 23(@)(@@) % يحور إليها بالبغام فتنثني % % كما التفت المطلوب يخشى الأعاديا % % 24(@)(@@) % بأروع من ظمياء قلبا ومهجة % % غداة سمعنا للتفرق داعيا % % 25(@)(@@) % تودعنا ما بين شكوى وعبرة % % وقد أصبح الركب العراقي غاديا % % 26(@)(@@) % فلم أر يوم النفر أكثر ضاحكا % ولم أر يوم النفر أكثر باكيا % % PageV01P1899 البحر : مجزوء الخفيف 1(@)(@@) % من رأى أعينا حذ % % ن الدموع الجواريا % % 2(@)(@@) % قد عرفن السهاد % % تى نكرن اللياليا % % 3(@)(@@) % تتبع النجم نظرة % والوميض اليمانيا % % 4(@)(@@) % كل يوم يجدن رب % عا من الحي خاليا % % 5(@)(@@) % بدموع روائحا % % ودماء غواديا % % 6(@)(@@) % إن تر الطرف دامعا % فاعلم القلب داميا % % 7(@)(@@) % قل لواد على الثو % ية : حييت واديا % % 8(@)(@@) % أين قوم عهدتهم % يملؤون المقاريا % % 9(@)(@@) % لا يخلى غديرهم % عن حيا الماء ظاميا % % 10(@)(@@) % لحبوا المجد وابتنوا % % في المعالي مبانيا % % PageV01P1900 11(@)(@@) % وثبوها ، وغيرهم % صعدوها مراقيا % % 12(@)(@@) % معشر إن بلوتهم % % غيبهم والمباديا % % 13(@)(@@) % كرموا أنفسا عظا % % ما ، وراقوا مجاليا % % 14(@)(@@) % وملوك قادوا الرؤ % % س مطيعا وآبيا % % 15(@)(@@) % لا يبالون في القيا % % د 
ms536	 الرقاب العواصيا % % 16(@)(@@) % وإذا اليوم قربوا % % للطعان المذاكيا % % 17(@)(@@) % اعجلوا الملجمات أو % % ركبوها عواريا % % 18(@)(@@) % وسوا في ظهورها % % يعلقون النواصيا % % 19(@)(@@) % كأسود الشرى ركب % % ن الظباء العواطيا % % 20(@)(@@) % وإذا ما غدا فم الش % % س بالنقع راغيا % % PageV01P1901 21(@)(@@) % حفظوا عورة العلى % % ورقوا للعواليا % % 22(@)(@@) % كم رموا بالمطي تلك % % ك الحزون الفيافيا % % 23(@)(@@) % يعسفون الذرى ويع % تسفون المواميا % % 24(@)(@@) % جملوا شحمة السنا % % م ، وقد كان واريا % % 25(@)(@@) % كل صل يبيت في % % مربأ النجم رابيا % % 26(@)(@@) % زحمت منهم المنو % % ن الجبال الرواسيا % % 27(@)(@@) % لم تخف منهم القنا % % والدروع الأواقيا % % 28(@)(@@) % قلل للعلاء عا % % دت ترابا وسافيا % % 29(@)(@@) % وعظام البلاء صا % % روا عظاما بواليا % % 30(@)(@@) % ومضوا معقبين إر % % ثا من المجد باقيا % % PageV01P1902 31(@)(@@) % كلما أحرزوا المكا % % رم شادوا المعاليا % % 32(@)(@@) % فهم اليوم جيرة % % لا يجيبون داعيا % % 33(@)(@@) % قرع الذل منهم % مارنا كان حاميا % % 34(@)(@@) % وأناخوا مناخ من % لم ير الدهر ساريا % % 35(@)(@@) % طوحتهم أيدي المنو % % ن الغيوب الأقاصيا % % 36(@)(@@) % كنبال القاري ير % مي بهن المراميا % % 37(@)(@@) % كنت من مجدهم % % ل الذرى والروابيا % % 38(@)(@@) % وإذا شئت زاحموا % % بالقنا من ورائيا % % 39(@)(@@) % أقرضوني ، من عزهم % وازن القدر وافيا % % 40(@)(@@) % فجزوا إن قضيتهم % % من يدي أو لسانيا % % PageV01P1903 41(@)(@@) % وإذا أعوز الجزا % % ء جزيت القوافيا % % 42(@)(@@) % وأرى بعدهم موا % % مق قومي مراميا % % 43(@)(@@) % ورجالا قد أعبقوا % % بالبرود المخازيا % % 44(@)(@@) % إن لقوني أصادقا % فارقوني ، أعاديا % % 45(@)(@@) % ما ترى الناس كالبها % % م يوقعن ضاريا % % 46(@)(@@) % كل يوم يجهزو % % ن إلى الله غازيا % % 47(@)(@@) % ويقودون ساليا % % عن قليل وناسيا % % 48(@)(@@) % ريعة الذود قد أم % ن على القرب حاديا % % 49(@)(@@) % قد رجعنا ضواحكا % ومضينا بواكيا % % 50(@)(@@) % وترى المرء إن رأى % % عارض الخطب رانيا % % PageV01P1904 51(@)(@@) % خافق الجأش ناظرا % من يجيب الدواعيا % % 52(@)(@@) % فإذا انجاب ليله % وانجلى عنه ناجيا % % 53(@)(@@) % طرح الهم جانبا % % وتمنى الأمانيا % % 54(@)(@@) % ما لهذا الزمان يلقي % % قي علينا المراسيا % % 55(@)(@@) % كل يوم يجلو علي % خطوبا عودايا % % 56(@)(@@) % كم طوى بالردى % % صفيا لقلبي مصافيا % % 57(@)(@@) % ثالث الناظرين % % عزا وللنفس ثانيا % % 58 
ms537	(@)(@@) % صار بالدمع آمرا % فيه من كان ناهيا % % 59(@)(@@) % أغتدي منه عاطلا % بعد ما كنت حاليا % % 60(@)(@@) % عطل الكأس لا تح % % س النديم المعاطيا % % PageV01P1905 61(@)(@@) % إن تفض عبرتي تجد % كمد القلب باقيا % % 62(@)(@@) % ربما تعرف الجوى % % وترى الدمع غاليا % % PageV01P1906 البحر : خفيف تام 1(@)(@@) % ما مقامي على الهوان وعندي % % مقول صارم وأنف حمي % 2(@)(@@) % وإباء محلق بي عن الضيم % % كما راغ طائر وحشي % 3(@)(@@) % أي عذر له إلى المجد إن ذ % ل غلام في غمده المشرفي % 4(@)(@@) % ألبس الذل في ديار الأعادي % % وبمصر الخليفة العلوي % 5(@)(@@) % من أبوه أبي ومولاه مولا % % ي إذا ضامني البعيد القصي % 6(@)(@@) % لف عرقي بعرقه سيد النا % % س جميعا محمد وعلي % 7(@)(@@) % إن ذلي بذلك الجو عز % وأوامي بذلك النقع ري % 8(@)(@@) % قد يذل العزيز ما لم يشمر % لانطلاق وقد يضام الأبي % 9(@)(@@) % إن شرا علي إسراع عزمي % % في طلاب العلى وحظي بطي % % 10(@)(@@) % أرتضي بالأذى ولم يقف العز % % م قصورا ولم تعز المطي % % PageV01P1907 11(@)(@@) % كالذي يخبط الظلام وقد أق % % مر من خلفه النهار المضي % PageV01P1908 البحر : وافر تام 1(@)(@@) % أتذهل بعد إنذار المنايا % % وقبل النزع أنبضت الحنايا % % 2(@)(@@) % رويدك لا يغرك كيد دنيا % % هي المرنان مصمية الرمايا % % 3(@)(@@) % فإنك سالك منها طريقا % تقطع فيه أرقاب المطايا % % 4(@)(@@) % أترجو الخلد في دار التفاني % % وأمن السرب في خطط البلايا % % 5(@)(@@) % وتغلق دون ريب الدهر بابا % كأنك آمن قرع الرزايا ؟ % 6(@)(@@) % وإن الموت لازمة قراه % لزوم العهد أعناق البرايا % % 7(@)(@@) % لنا في كل يوم منه غاز % % له المرباع منا والصفايا % % 8(@)(@@) % بجيش لا غبار لحجرتيه % % قليل الرزء غرار السرايا % % 9(@)(@@) % مغير لا يفادي بالأسارى % % وساب لا يمن على السبايا % % 10(@)(@@) % إذا قلنا أغب رأيت منه % % كميش الذيل يطلع الثنايا % % PageV01P1909 11(@)(@@) % غشوم الناب تصرف ناجذاه % إذا أبقى أحال على البقايا % % 12(@)(@@) % يطيل غرورنا مهل الأماني % % وننسى بعده عجل المنايا % % 13(@)(@@) % وهذا الدهر تحدوني يداه % % حداء الطلح بالإبل الرذايا % % 14(@)(@@) % إذا ما قلت روح عقر ظهري % % من الإدلاج أغبط بالحوايا % % 15(@)(@@) % وإن 
ms538	 النائبات لها حماة % وإن كثر الرقاب والربايا % % 16(@)(@@) % إذا أبطأن بالغدوات فاعبأ % % قرى لضيوفهن مع العشايا % % 17(@)(@@) % ومن عجب صدود الحظ عنا % % إلى المتعممين على الخزايا % % 18(@)(@@) % أسف بمن يطير إلى المعالي % % وطار بمن يسف إلى الدنايا % % 19(@)(@@) % ترى لهم المزايا إن أرموا % % وإن نطقوا رأيت لنا المزايا % % 20(@)(@@) % غباوة هاجر الدنيا ، وكيد % ولا كيد الفواجر والبغايا % % PageV01P1910 21(@)(@@) % وإن ظهورهم لو كان نصف % % من الأنعام أولى بالولايا % % 22(@)(@@) % جرت بهم الحظوظ مع القدامى % % وأسقطنا الزمان مع الردايا % % 23(@)(@@) % ففاقوا في المراتب والمعالي % % وفقنا في الضرائب والسجايا % % 24(@)(@@) % لهم عن مالهم نفحات كيد % قراع الدبر ذاد عن الخلايا % % 25(@)(@@) % ذممنا كل مرتجع عطاء % ولم يعطوا ، فيرتجعوا العطايا % % 26(@)(@@) % فلولا الله لارتابت قلوب % بقاض لا يجور في القضايا % % PageV01P1911 البحر : وافر تام 1(@)(@@) % مضى حسب من الدنيا ودين % % وأعقب منهما عار وغي % 2(@)(@@) % فذاك الطي للماضين نشر % وهذا النشر للباقين طي % 3(@)(@@) % تقدمت الذوائب والقدامى % % وخلد بعدها هي وبي % 4(@)(@@) % يعز علي أن يمضى وتبقى % % وإن يرد المنون وأنت حي % PageV01P1912 البحر : طويل 1(@)(@@) % أيعلم قبر بالجنينة أننا % % أقمنا به ننعي الندى والمعاليا % % 2(@)(@@) % حططنا ، فحيينا مساعيه أنها % % عظام المساعي لا العظام البواليا % % 3(@)(@@) % مررنا به ، فاستشرفتنا رسومه % % كما استشرف الروض الظباء الجوازيا % % 4(@)(@@) % وما لاح ذاك الترب حتى تحلبت % % من الدمع أوشال ملأن المآقيا % % 5(@)(@@) % نزلنا إليه عن ظهور جيادنا % % نكفكف بالأيدي الدموع الجواريا % % 6(@)(@@) % ولما تجاهشنا البكاء ولم نطق % عن الوجد أقلاعا عذرنا البواكيا % % 7(@)(@@) % أقول لركب رائحين تعرجوا % % أريكم به فرعا من المجد ذاويا % % 8(@)(@@) % الموا عليه عاقرين فإننا % % إذا لم نجد عقرا عقرنا القوافيا % % 9(@)(@@) % وحطوا به رحل المكارم والعلى % % وكبوا الجفان عنده والمقاريا % % 10(@)(@@) % ولو أنصفوا شقوا عليه ضمائرا % وجزوا رقابا بالظبى لا نواصيا % % PageV01P1913 11(@)(@@) % وقفنا ، فأرخصنا الدموع ، وربما % % تكون على سوم الغرام غواليا % % 12(@)(@@) % ألا أيها القبر الذي ضم لحده % قضيبا على هام النوائب ماضيا % % 13(@)(@@) % هل ابن هلال منذ أودى كعهدنا % % هلالا على ضوء المطالع باقيا % % 14 
ms539	(@)(@@) % وتلك البنان المورقات من الندى % % نواضب ماء أو بواق كما هيا % % 15(@)(@@) % فإن يبل من ذاك اللسان مضاؤه % فإن به عضوا من المجد باقيا % % 16(@)(@@) % يجيب الدواعي جائدا ومدافعا % هناك مرم لا يجيب الدواعيا % % 17(@)(@@) % وما كنت آبى طول لبث بقبره % % لو أني ، إذا استعديته ، كان عاديا % % 18(@)(@@) % ترى الكلم الغرات من بعد موته % % نوافر عمن رامهن ، نوائيا % % 19(@)(@@) % هو الخاضب الأقلام نال بها على % % تقاصر عنها الخاضبون العواليا % % 20(@)(@@) % معيد ضراب باللسان لو أنه % % بيوم وغى فل الجراز اليمانيا % % PageV01P1914 21(@)(@@) % مرير القوى نال المعالي واثبا % إذا غيره نال المعالي حابيا % % 22(@)(@@) % مضى لم يمانع عنه قلب مشيع % إذا هم لم يرجع عن الهم نابيا % % 23(@)(@@) % ولا مسندوه بالأكف عن الحشى % % على جزع والمفرشوه التراقيا % % 24(@)(@@) % ولا رد في صدر المنون براحة % % يرد بها سمر القنا والمواضيا % % 25(@)(@@) % خلا بعدك الوادي الذي كنت أنسه % وأصبح تعروه النوائب واديا % % 26(@)(@@) % أراحت علينا ثلة الوجد ترتعي % % ضمائرنا أيامها واللياليا % % 27(@)(@@) % ولولاك كان الصبر منك سجية % تراثا ورثناه الجدود الأواليا % % 28(@)(@@) % رضيت بحكم الدهر فيك ضرورة % ومن ذا الذي يغدو بما ساء راضيا % % 29(@)(@@) % وطاوعت من رام انتزاعك من يدي % % ولو أجد الأعوان أصبحت عاصيا % % 30(@)(@@) % وطأمنت كيما يعبر الخطب جانبي % % فألقى على ظهري وجر زماميا % % PageV01P1915 31(@)(@@) % ملأت بمحياك البلاد فضائلا % ويملأ مثواك البلاد مناعيا % % 32(@)(@@) % كما صم عالي ذكرك الخلق كله % كذاك أقمت العالمين نواعيا % % 33(@)(@@) % رثيتك كي أسلوك فازددت لوعة % لأن المراثي لا تسد المرازيا % % 34(@)(@@) % وأعلم أن ليس البكاء بنافع % عليك ولكني أمني الأمانيا % % PageV01P1916 البحر : طويل 1(@)(@@) % أملتمسا مني صديقا لنوبة % وأنت صديقي لا أرى لك ثانيا % % 2(@)(@@) % لحا الله دهرا خانني فيه أهله % وأحشمني حتى احتشمت الأدانيا % % 3(@)(@@) % فلست أرى إلا عدوا مكاشفا % ولست أرى إلا صديقا مداجيا % % PageV01P1917 البحر : متقارب تام 1(@)(@@) % أأنكر والمجد عنوانيه % % ومخبرتي عند أقرانيه % % 2(@)(@@) % ويعرف غيري بلا ميسم % مبين ، ولا غرة ضاحيه % 3(@)(@@) % ألا قاتل الله هذا الأنام % % وقاتل ظني وآماليه % 4(@)(@@) % ودهرا يمول 
ms540	 ذلاته % % ولا يدخر العدم إلا ليه % 5(@)(@@) % إذا ما تماثلت من غصة % أعاد المرار فسقانيه % 6(@)(@@) % فيا ليت حظي من ذا الزما % % ن رد نوائبه الجاريه % 7(@)(@@) % زمان عدا العي أبناءه % فأفصح من ناطق راغيه % 8(@)(@@) % سؤالا فهل يخبرن سالف % % من العيش قطع أقرانيه % % 9(@)(@@) % ألا أين ذاك الشباب الرطي % % ب ، أم أين لي بيض أياميه % 10(@)(@@) % مشى الدهر بيني وبين النعي % % م ظلما ، وغير من حاليه % PageV01P1918 11(@)(@@) % نظرت وويل أمها نظرة % % ببيضاء في عارضي باديه % % 12(@)(@@) % يقولون : داعية الشباب % فقلت : ولكنها ناعيه % 13(@)(@@) % ألا قطع الناس حبل الوفاء % % وأولع بالغدر خلانيه % 14(@)(@@) % وصرت أعدد في ذا الزمان % صديقي أول أعدائيه % 15(@)(@@) % أضر الأنام لي الأقربون % % وأعدى الورى لي جيرانيه % % 16(@)(@@) % إلى كم أخفض من عزمتي % % وكم يأكل العضب أغماديه % 17(@)(@@) % فلله عزمي لو أنه % % على قدر عزمي سلطانيه % % 18(@)(@@) % ستسمع بي شاردا في البلاد % لأمر أغير انسانيه % % 19(@)(@@) % وقد أغتدي غرض النائبا % % ت ، لا يتقى الروع إلا بيه % 20(@)(@@) % نديما جذيمة لي في البلاد % % نديمان والظلمة الداجية % % PageV01P1919 21(@)(@@) % عليق جيادي شم النسي % % والظمء سائق أذواديه % % 22(@)(@@) % دفعن فمن مقلة بالدمو % % ع ريا ومن مهجة صاديه % % 23(@)(@@) % يطرن سوابك جعد اللغام % على القور والقلل السامية % % 24(@)(@@) % وفي كل يوم بلا غاية % % تقعقع للبين أعماديه % 25(@)(@@) % وأزرق ماء كلون الزجا % % ج بالرمل جمته طاميه % % 26(@)(@@) % سبقت إليه وفود القطا % % فلله سيري وإغذاذيه % % 27(@)(@@) % وقد مال جل الدجا والصباح % % كشقراء في جدد عاديه % % 28(@)(@@) % أرى غمرة يتقيها الرجا % % ل محفوفة بالقنا طاغيه % 29(@)(@@) % سألقى بنفسي أهوالها % % فإما العلاء أو الداهيه % % 30(@)(@@) % أنوما ألذ على ذلة % % ويعرى من الذل أضداديه % PageV01P1920 31(@)(@@) % وأرعى المنى دون أن أستشير % قنا خالقا وظبى فاريه % 32(@)(@@) % وأعزل ناء عن المكرمات % يرى الموت من دون لقيانيه % 33(@)(@@) % مدحت فكان جزاء المديح % % قبول نظامي وأشعاريه % 34(@)(@@) % فصرحت بالذم حتى ترك % ت شنعاء من عرضه داميه % 35(@)(@@) % ولم أهجه بهجائي له % % ولكن هجوت به القافيه % % 36(@)(@@) % ألا ما أفيصح هذا الكلام 