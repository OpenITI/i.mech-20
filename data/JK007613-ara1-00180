ms161	 لاترى عنده لبا ولا جلدا % % 9(@)(@@) % لا يبعد الناس ما يدنو القضاء به % % ولا يقربه شيء إذا بعدا % % 10(@)(@@) % قصرت بعد اجتهاد في مودتها % % وهل يلام على التقصير من جهدا % % PageV01P603 11(@)(@@) % ما تأمرين بذي عين مؤرقة % إن شئت مات وإن خلدته خلدا % % 12(@)(@@) % قد يخرج المخرج المعتل صاحبه % % وقد ينال لسان السوء من قعدا % % 13(@)(@@) % ظلت على قلبها الحوراء ممسكة % من ظاعن حرك الأحشاء والكبدا % % PageV01P604 البحر : طويل 1(@)(@@) % ألا راعه صوت الأذين وما هجد % وما ذاك إلا ذكر من ذكره كمد % % 2(@)(@@) % ألانت لنا يوم التقينا حديثها % % أماني وعد ثم زاغت بما تعد % % 3(@)(@@) % وما كان إلا لهو يوم سرقته % إلى فاتر العينين من دونه الأسد % % 4(@)(@@) % تراءت لنا في السابري وفي الحنا % % ثقيلة دعص الردف مهضومة الكبد % % 5(@)(@@) % كأن عليها روضة يوم ودعت % % بأقوالها خوفا وراحت ولم تعد % % 6(@)(@@) % فلما رأيت المالكية أعرضت % % صدودا وحفت بالعيون وبالرصد % % 7(@)(@@) % صرفت الهوى عني وليس ببارح % % على كبدي مارق للوالد الولد % % 8(@)(@@) % لقد كنت أرجوها وكانت قريبة % بأقوالها تدنو الورود ولاترد % 9(@)(@@) % فما بالها يا بكر راحت مع العدى % % على عاشق لم يجن ذنبا ولم يكد % % 10(@)(@@) % أمالت صفاء الود من حيل دونها % % فيا حزني لا نلتقي آخر الأبد % PageV01P605 11(@)(@@) % كأن فؤادي في خوافي حمامة % من الشوق أو صنع النوافث في العقد % % 12(@)(@@) % وقد لامني فيها المعلى ولو بدا % % له مابدا لي من محاسنها سجد % PageV01P606 البحر : طويل 1(@)(@@) % أشاقك مغنى منزل متأبد % وفحوى حديث الباكر المتعهد % % 2(@)(@@) % وشام بحوضى ما يريم كأنه % % حقائق وشم أو وشوم على يد % 3(@)(@@) % إذا ما رأته العين بعد جلادة % جرى دمعها كاللؤلؤ المتبدد % 4(@)(@@) % كأن الحمام الورق في الدار وقعا % مآثم ثكلى من بواك وعود % % 5(@)(@@) % ذكرت بها مشي الثلاث فعادني % % جديد الهوى والموت في المتجدد % % 6(@)(@@) % وقال خليلي قد مضت لمضائها % % أحلك في قصر منيف مشيد % 7(@)(@@) % فقلت له لم تبق أذن لسامع % وما اللوم إلا جنة بك فاقصد % 8(@)(@@) % على عينها مني السلام وإن 
ms162	 غدت % % مفارقة تخدي إلى غير مقعد % 9(@)(@@) % أبا كرب لم تمس حبى بعيدة % فما قلب حبى عن أخيك بمبعد % % 10(@)(@@) % فلما رأيت الهجر قد لاح وجهه % % وراح عتار الحي والبين معتد % % PageV01P607 11(@)(@@) % فيا حسنها لولا العيون فإنها % % إذا أرسلت يوما أحالت على الغد % 12(@)(@@) % على الغزلى مني السلام وربما % % خلوت بها من عارب في خلا ند % 13(@)(@@) % لغيث ثلاث لا يفارق ريبة % عففن ولا أربو ولست بمبعد % 14(@)(@@) % لقد زادني شوقا خيال يزورني % % وصوت غناء من نديم مغرد % % 15(@)(@@) % وطول التقاء العاشقين ومعهد % % تهول الندامى حوله ثم ترقد % 16(@)(@@) % تمشى به عين النعاج كأنها % % سروب العذارى في البياض المعمد % % 17(@)(@@) % سفيه قريش لا تهولنك المنى % % إلى ضلة قد نلت سعيك فابعد % 18(@)(@@) % يغنيك بالملك الصدى فترومه % وحسبك من لهو سماع ومن دد % 19(@)(@@) % سفيه قريش ما عليك مهابة % ولا فيك فضل من إماء وأعبد % 20(@)(@@) % إذا قمت لم تظفر وواعدت فالمنى % % مسارقة خلف الإمام المقلد % PageV01P608 21(@)(@@) % ولولا أمير المؤمنين محمد % % رجعت لقى في ظل قصر مجرد % % 22(@)(@@) % ولا تنس إنعام الخليفة بعدما % % 23(@)(@@) % تعز بصبر عن خلافة أحمد % وكل رغدا مما تشرقت وارقد % % 24(@)(@@) % % وأنك عند الحي غير مؤيد % % 25(@)(@@) % سيكفيكها مهدي آل محمد % أحاط بها عن والد غير قعدد % % 26(@)(@@) % فتى جاد بالدنيا خلا زاد راكب % وشح على دين النبي المؤيد % % 27(@)(@@) % فطر طيرة المذعور أوقع فإنما % % أتت ملكا ميراثه عن محمد % % PageV01P609 البحر : طويل 1(@)(@@) % مللت مبيتي بالقرين وشاقني % % طروق الهوى من نازح متباعد % % 2(@)(@@) % على حين ودعت الحباب وأطرقت % همومي وذلت للفراق مقاودي % % 3(@)(@@) % فأحييت ليلي قاعدا أنتحي الهوى % % لدى راقد عن ذاك أو متراقد % 4(@)(@@) % وما أنا إن نام الرقيق ولم أنم % % بأول منكوب بفقد المساعد % 5(@)(@@) % إلى آل ليلى أشتكي لو دنت بهم % % نوى طية عن عازب النوم ساهد % % 6(@)(@@) % إلى طارقات الحي ودعن قلبه % يراها رسيس المغمزات التلائد % % 7(@)(@@) % فبات هجورا للوساد وقد يرى % % على ما بعينيه مكان الوسائد % 8(@)(@@) % أفالآن إذ مالت إليها صبابتي 
ms163	 % % أعزى عن الحوراء ذات المجاسد % 9(@)(@@) % كأن التي تمري فؤادي بحبها % % مرية نطف البابلي المعاند % 10(@)(@@) % عراقية أهدى لك الشوق ذكرها % % وأنت على ظهر شآم الموارد % % PageV01P610 11(@)(@@) % ذهوب بألباب الرجال كأنها % % إذا برزت بردية في المجاسد % % 12(@)(@@) % تشكى الضنى حتى تعاد وما بها % % سوى قرة العينين سقم لعائد % 13(@)(@@) % من البيض ما تلقاك إلا مصونة % ثقالا ومشي الخيزلى في الولائد % 14(@)(@@) % كأن الثريا يوم راحت عشية % على نحرها منظومة في القلائد % % 15(@)(@@) % لقيت بها سعد السعود وربما % % لقيت حرادا باجتناب الموارد % % 16(@)(@@) % فتلك التي نصحي لها ومودتي % % وقبضي مالي طارفي بعد تالدي % % 17(@)(@@) % وصعراء من مس الخشاش كأنها % % مسيرة صاد في الشؤون اللوابد % 18(@)(@@) % إذا كذبت حر الهجير صدمتها % % بسوطي على مجهولة أم آبد % 19(@)(@@) % عسوف لأجواز الدياميم بعدما % % جرى آلها فوق المتان الأجالد % 20(@)(@@) % تروع من صوت الحمامة بالضحى % % وبالليل تنجو عن غناء الجداجد % PageV01P611 21(@)(@@) % سقيت بدعثور فعافت نطافه % إلى منهل عن ذي صدير معاند % % 22(@)(@@) % وماء صرى الجمات طام كأنه % عبية طال متلدات صعائد % % 23(@)(@@) % تنوه أنقاض كأن هويها % % هوي سمامات بنجد طرائد % 24(@)(@@) % تثير بها والليل ملق رواقه % هجود القطا مستوقد غير هاجد % % 25(@)(@@) % حراجيج يغتال الفلاة نجاؤها % % إلى خير موفود إليه بوافد % 26(@)(@@) % تراهن من طول الجديل بكفه % نوافر أو يمشين مشي الولائد % 27(@)(@@) % سى الليل والتهجير حتى تبدلت % % معاقد من أنساعها بمعاقد % 28(@)(@@) % إذا قلت لقينا بعقبة أرقلت % تشفى ببرد الماء أول وارد % 29(@)(@@) % فتى في ذرى قحطان يبسط كفه % إذا شنجت كف البخيل المحارد % % 30(@)(@@) % وكنا إذا ما خاننا الدهر أو سرى % % علينا وعيد من عدو مكايد % % PageV01P612 31(@)(@@) % هتفنا ونوهنا بعقبة إنه % مع النصر مفروط بعم ووالد % % 32(@)(@@) % مغاوير فرسانا وجنا إذا مشوا % % إلى الموت إقدام الليوث الحوارد % % 33(@)(@@) % بنو النجدة الجماء يسقون مرها % % ويسقونها تحت اللوا والمطارد % % 34(@)(@@) % إذا أقبلوا للحرب بالحرب أقبلت % وجوه المنايا بارق بعد راعد % 35(@)(@@) % يقول سليم لو طلبت سحابة % بسربة أو صنعاء أو بالفراقد % % 36(@)(@@) % إذا لغنينا بابن 
ms164	 سلم إذا جرت % سفوح المنايا في متون القرادد % % 37(@)(@@) % رجال عليهم عزة ومهابة % إذا استنفروا لم ينفروا للشدائد % 38(@)(@@) % حطوط إلى قود الجياد على الرحا % % وفي السنة الحمراء جم الموارد % 39(@)(@@) % يفيض على المستمطرين غمامه % ومرهوبه يسقي بسم الأساود % % 40(@)(@@) % هو القاده الحامي حقيقة قومه % % إذا قيل من للمحصنات الخرائد % % PageV01P613 41(@)(@@) % وزير أمير المؤمنين وسيفه % إذا نفخ الشيطان في أنف حاسد % 42(@)(@@) % على المسجد البصري منه جلالة % وفوق الحشايا عارض غير جامد % 43(@)(@@) % إمام يحيا في الحجاب وتارة % رئيس خميس تحت ظل المطارد % % 44(@)(@@) % كأن عليه جاحما في سلاحه % % إذا قاد خيلا أو تصدى لقائد % 45(@)(@@) % ويوم ترى فيه النجوم تكشفت % تراكا وهت عنه كريم المشاهد % 46(@)(@@) % أمات وأحياهم بكفيه إنه % يميت ويحيي في الوغا غير واحد % 47(@)(@@) % وثار بأرجاء المدينة عالما % بأقدامه أو دول زين المناجد % 48(@)(@@) % وبالهند أيام له مجرهدة % حصدن العدى بالمرهفات الحواصد % % 49(@)(@@) % إذا ما خشينا شوكة من منافق % على الناس أو حيران ليس بقاصد % % 50(@)(@@) % دعونا له الميمون عقبة إنه % % أخو الحرب إن قامت به غير قاعد % PageV01P614 51(@)(@@) % من الشوس دلافا لكل كتيبة % بأبيض يستبكي عيون العوابد % 52(@)(@@) % حسام إذا ما هز أرعد متنه % خفوق ثياب الآل فوق الفدافد % PageV01P615 البحر : بسيط تام 1(@)(@@) % أعبد قد طال في ذكراك تفنيدي % % وكدت أقضي وما تقضى مواعيدي % % 2(@)(@@) % يا عبد ما . . . . روحي ولا بدني % % إلا ذكرت وإلا عاد لي عيدي % % 3(@)(@@) % لو بالجلاميد من حبي لكم طرف % لأثر الحب في قاسي الجلاميد % 4(@)(@@) % إن تبك عيني فقد علقت جارية % كأن ريقتها ماء العناقيد % PageV01P616 البحر : طويل 1(@)(@@) % وضعت قناعي وارتببت نجادي % % وأيقظت دون الشعرس قتادي % % 2(@)(@@) % ولما رأيت القوم ملو سلامة % وقادهم الزنجي شر مقاد % 3(@)(@@) % صنعت لقوح الحرب ثم بعثتها % % تدر دماء القوم غير جماد % 4(@)(@@) % أهيجوا بني زيد على ذل دعوة % ولا تقطعوا إلا بطيق عتاد % 5(@)(@@) % لكم شاعر قد نيك في بيت يوسف % وفي بيت كندير وبيت هداد % % 6(@)(@@) % ولا تفخروا بالشعر لستم من أهلها % % ولكنكم 
ms165	 أهل لنقل سماد % % 7(@)(@@) % تعالوا بني زيد إلى بيت كيركم % % تسيل دما من طعنة ببداد % % 8(@)(@@) % تروح غيلان المصلى وغودرت % % مفردة من شادن وزياد % % 9(@)(@@) % أقامت على ذي نيقة وتفحش % لعر ما بين مثلها ووداد % % 10(@)(@@) % دعوت بني زيد وكانوا أذلة % يقومون بالمعزاء غير جلاد % PageV01P617 11(@)(@@) % بل افترعت منهم فتاة وسيطة % فما قدحوا في عقرها بزناد % % 12(@)(@@) % عدمتكم لم تأنفوا لعروسكم % ينطقها الكفين قبل وساد % 13(@)(@@) % فأمست تشكى حوزة الرمح في استها % % وما كان يخطي عامر بن نجاد % % 14(@)(@@) % تلافوا بني زيد جراح فتاتكم % % بخل وماء بارد ورماد % 15(@)(@@) % فإن أيور العامريين زعفة % إذا طعنت في غير وجه سداد % 16(@)(@@) % إذا شبع الزيدي لاعب أمه % سبوق إلى اللذات غير جواد % 17(@)(@@) % يشين بني زيد بقية أعصر % كما شبت وجها فاضحا بسواد % % 18(@)(@@) % جماعة قوم معصمين بدعوة % وكل دعي معود لفساد % % 19(@)(@@) % أجدهم لم يشعروا بقصائدي % % تحن حنين الحارسات غوادي % % 20(@)(@@) % إذا خلص النادي بزيد فكلهم % % يرى وجه عبد في النداء مناد % PageV01P618 21(@)(@@) % لهم زنية في مثلهم يحملونها % % وليس لهم في الناس زنية عاد % % 22(@)(@@) % إذا الليل غطاهم غدوا تحت ظله % وأثوابهم مسحورة لفساد % % 23(@)(@@) % يعيشون في أماتهم وبناتهم % يعقونها عن رائد ومراد % 24(@)(@@) % إذا شئت لاقيت امرأ من سراتهم % على أخته يحكي لصوق قراد % 25(@)(@@) % وويل أمه يرجو له غفر غافر % لما جره من عائد ومعاد % % 26(@)(@@) % فأما اللعين ابن الخليق فإنه % % يبل إلى سود الوجوه جعاد % % 27(@)(@@) % لعلك ياجعد بن جعد حسبتني % % كأير فتى كدحته بكداد % 28(@)(@@) % ستعلم أني مقصد لك عامدا % % بمثل ذراع البكر غير كساد % 29(@)(@@) % ثنيتك عن لقط النوى فهجوتني % % وكلفتني دادا فرحت بداد % 30(@)(@@) % فليت حوى البرصاء أير مجوف % يكفك عن شتمي وأير رقاد % % PageV01P619 البحر : طويل 1(@)(@@) % أبا خالد دعني وزنجي خالد % وقل في فتى ما قص أكرا ولا سدا % % 2(@)(@@) % تبارك من ألقيت وجهي لوجهه % % ومن خلق الخنزير والكلب والقردا % % 3(@)(@@) % فشتان بين العامري ابن واقد % وبين ابنة الزيدي إذ كامها عفدا % % 4(@)(@@) % دعا 
ms166	 حرها ودا لها ولقومها % % ولم يدع رب العامري لنا ودا % % 5(@)(@@) % سأترك إبراهيم إذ خبت استه % ولا خير في المستوه حرا ولا عبدا % % 6(@)(@@) % لحى الله إبراهيم في ذي قرابة % ومن صاحب ما أضعف العقل والعقدا % % 7(@)(@@) % فرحت بخصييه لقومي وليته % أتانا خصيا من حر مجه وغدا % % PageV01P620 البحر : خفيف تام 1(@)(@@) % حال حب الذلفاء دون الرقاد % % وارثيا صاحبي لي من سهاد % % 2(@)(@@) % واتركا لي من أمره كل يوم % باقتصاد ليس الهوى باقتصاد % % 3(@)(@@) % نصب عيني سعاد فاستبقياني % % ليس قلبي بمقصر عن سعاد % % 4(@)(@@) % وجهها الوجه لا تطاعان فيه % % فانزلا البعد أو أريدا مرادي % % 5(@)(@@) % ولقد قلت يوم قالوا تشكت % % بصداع من صالب الأوراد % % 6(@)(@@) % ليت داء الصداع أمسى براسي % % ثم كانت سعاد من عوادي % % 7(@)(@@) % ذاك إذ أهلها دناء وعهدي % . . . . . . . . بالجزع والأجماد % % 8(@)(@@) % لا تحب الفراق حتى غدا البي % ن وأقوت ديارنا بالنجاد % 9(@)(@@) % فابك من دارس ومن نسفات ال % حي كالجون علقت في الرماد % 10(@)(@@) % ومصام الجياد يمشي بها الرأ % % س غدوا كالعائد الحماد % PageV01P621 11(@)(@@) % أصبحت من عبيد قفرا وقد تغن % % نى زمانا بلادها من بلادي % % 12(@)(@@) % ثمت ازددت بعدها من سلو % بل أراني من حبها في ازدياد % % 13(@)(@@) % ليت شعري عن ذلك الشخص إذا شط % % ت به نية إلى أجياد % 14(@)(@@) % هل دعا شوقه الوساد فإني % % لم أنل بعده اشتياق وساد % 15(@)(@@) % أنكر النفس والفؤاد ولا أع % رف مأتى غواية من رشاد % % 16(@)(@@) % وكأني بدلت بالنفس نفسا % وكأن الفؤاد غير الفؤاد % % 17(@)(@@) % لا تلوما لاقيتما مثل مالا % % قى ببين المحب إذ قيل غاد % % 18(@)(@@) % راعه من سعاد إذ ودعته % في ثلاث من ملكها أغياد % % 19(@)(@@) % وجه شمس بدا بعيني غزال % في عسيب مقوم مياد % 20(@)(@@) % يأخذ المرط والمؤصد ذا العر % ضو ثوبا رجراجة الأبراد % PageV01P622 21(@)(@@) % بأبي تلكم وأمي ونفسي % % في التداني إذا دنت والبعاد % 22(@)(@@) % وموار بالدين لا يذكر الدي % % ن إذا ما خلا من الأرصاد % 23(@)(@@) % نبطي يدعى زيادا وقد عا % % ش زمانا يدعى بغير زياد % % 24 
ms167	(@)(@@) % كأن قولي له تنح فإني % % رجل من صلاة أهل السواد % PageV01P623 البحر : بسيط تام 1(@)(@@) % لا يأيسن فقير من غنى أبدا % بعد الذي نال يعقوب بن داوود % 2(@)(@@) % قد صار من بعد إشراف على تلف % وبعد غل على الزندين مشدود % % 3(@)(@@) % أخا لمهدي خلق الله كلهم % يوفى به فوق أعناق الصناديد % 4(@)(@@) % لئن حسدت على ما نلت من شرف % لقد عنيت زمانا غير محسود % 5(@)(@@) % يأيها الناس قد ضاعت خلافتكم % % إن الخليفة يعقوب بن داوود % 6(@)(@@) % ضاعت خلافتكم يا قوم فالتمسوا % % خليفة الله بين الزق والعود % PageV01P624 البحر : سريع 1(@)(@@) % راحت رواحا بين كناد % وأخلفت ظني وميعادي % % 2(@)(@@) % وبت مشتاقا إلى وجهها % % ألقى عليه غلة الصادي % % 3(@)(@@) % فقلت للنفس قفي إنها % % شيمة ما في الوعد ميعاد % 4(@)(@@) % ما كل برق مرشد ماؤه % % ولا صديق كل معتاد % 5(@)(@@) % كم دونها من منهل آجن % % ومن ذرى طود وأعقاد % 6(@)(@@) % ومن سخاوي بها مشرف % للعين من مثنى وأفراد % 7(@)(@@) % فعز نفسا قلبها شاخص % بفقد من ليس بمفقاد % 8(@)(@@) % وصاحب يعطي ويبدي العلى % % ركاب أهوال وأعواد % 9(@)(@@) % صحبته في الملك أو عوده % % فزاد في عدة حسادي % % 10(@)(@@) % يا طالب الحاجات لا تعصني % % واسمع فإني ناصح هاد % PageV01P625 11(@)(@@) % دع عنك حمادا وخلقانه % % لا خير في خلقان حماد % % 12(@)(@@) % المؤثر الرأس على ربه % % والجاعل الخنزير في الزاد % 13(@)(@@) % طراد ولدان إذا ما غدا % % ما كل لوطي بطراد % % 14(@)(@@) % برئت من هذا ومن دينه % يصبح للخشف بمرصاد % % 15(@)(@@) % بئس الشواني له منصب % % في آل نهيا غير مرتاد % 16(@)(@@) % لا يشرب الخمر ولكنه % يأكلها أكل امرىء عاد % 17(@)(@@) % سميت عبد الرأس من حبه % % قد علم الحاضر والبادي % % 18(@)(@@) % سماك حمادا أب كاذب % % ما أنت لله بحماد % 19(@)(@@) % أبعد خمسين تكملتها % % تبكي على است المسمر العادي % % 20(@)(@@) % عردت عن قرم بني هاشم % والموت يحدوك به الحادي % % PageV01P626 21(@)(@@) % لولا تنحيك وفى نذره % % فيك فأصبحت مع الزاد % 22(@)(@@) % ما أنت بالزاني ولكنما % % ورثت عن حش وولاد % % 23(@)(@@) % لو كنت ممن يتقي سوءة % أعولت 
ms168	 من سخطي وإبعادي % % 24(@)(@@) % تخدم أقواما وخليتني % % وقد تراني حية الوادي % % PageV01P627 البحر : بسيط تام 1(@)(@@) % إن يحسدوني فإني غير لائمهم % قبلي من الناس أهل الفضل قد حسدوا % % 2(@)(@@) % فدام لي ولهم ما بي وما بهم % ومات أكثرنا غيظا بما يجد % % 3(@)(@@) % أنا الذي وجدوني في حلوقهم % لا أرتقي صعدا منها وأزدرد % 4(@)(@@) % وما أؤمل من أمر يسوؤهم % % إلا وعندي لهم من مثله مدد % % PageV01P628 البحر : بسيط تام 1(@)(@@) % يا ليلتي لم أنم شوقا وتسهادا % % حتى رأيت بياض الصبح قد عادا % % 2(@)(@@) % كبرت لما رأيت الصبح منبلجا % يحدو توالي جون بان أو كادا % % 3(@)(@@) % ورائح من بني العلات يعذلني % % وما درى بدواعي الحب وثادا % % 4(@)(@@) % كاتمته بعض ما ألقى وقلت له % % لا أستطيع دواعي الحب منقادا % % 5(@)(@@) % أيام يحسدها ودي ويحسدني % % ما لا أنال نساء كن حسادا % % 6(@)(@@) % ثم انقضى ذاك إلا ذكر ملعبنا % % بالبيت إذ نتقي عينا وأرصادا % % 7(@)(@@) % لم يبق لي الشوق من ( جمل ) وجارتها % % إلا هموما تؤوب الليل أجنادا % % 8(@)(@@) % قد كان لي عندها وعد فأخلفني % % وما بخلت ولا أخلفت ميعادا % % 9(@)(@@) % يا ويحها خلة كانت مواعدها % % كالليل غرت به الأحلام رقادا % % 10(@)(@@) % منيتها النفس حتى لامني . . . % وشفني الحب تقريبا وإبعادا % % PageV01P629 11(@)(@@) % يا طالب اللهو مجتازا ومعترضا % أقبل أصبت الهوى إن كنت مرتادا % % 12(@)(@@) % إن سرك الطعن من قبل ومن دبر % % فأت ابن سيمين ذا الرأسين حمادا % % 13(@)(@@) % من يعطه درهما ينكح خليلته % ونائك في أست رب البيت مرتادا % % 14(@)(@@) % إن ابن نهيا على أخلاق والده % % لا يحرم الضيف من عرس له زادا % % 15(@)(@@) % قد صاد بكرا ويعفورا لنسوته % بعد المثنى ألا بعدا لما صادا % % 16(@)(@@) % إني لأعرف حمادا ومكسره % % عند اللقاء إذا ما كيد أو كادا % % 17(@)(@@) % صعبا إذا كنت لينا حين تصدقه % من آل نهيا إذا زلزلته حادا % % 18(@)(@@) % لا غرو إلا لحماد أبي عمر % يظل فهدا ويسري الليل فهادا % % 19(@)(@@) % أدر كالزق مربوطا برمته % قد بده الطعن إصدارا وإيرادا % % 20(@)(@@) % تهوي المخازي إليه كل شارقة % ركض 
ms169	 القطا يبتدرن الماء ورادا % % PageV01P630 21(@)(@@) % طاب النعيم لحماد أبي عمر % % إذا أتى فجره لم يخش مرصادا % % 22(@)(@@) % يلقى القرائب مختالا بهربذة % ولا يرى الخشف إلا اهتز أو مادا % % 23(@)(@@) % يا فارس الأمرد العادي ليركضه % اركض فأنت ابن ظئر كان قوادا % % 24(@)(@@) % إن السواني مأكول ومهتضم % فما يرى طيره يعني إذا رادا % % 25(@)(@@) % كم خلة فيك يا حماد فاضحة % ورثتها والدا علجا وأجدادا % % 26(@)(@@) % إن الغرائب لا تولي محارمها % % فاطعن برمحك محلوبا وولادا % % PageV01P631 البحر : طويل 1(@)(@@) % لحى الله حماد بن نهيا فإنه % ذميم إذا ما قام علج إذا قعد % 2(@)(@@) % من المدمنين الطعن قبلا ومدبرا % % مسامحة من غير من ولا حسد % 3(@)(@@) % يقول إذا راح الأوانس حيضا % فديت خليلا لا يحيض ولا يلد % 4(@)(@@) % وما في سهيل طائل غير أنه % % إذا نيك أعطى غير كز ولاجحد % % 5(@)(@@) % ويقطع ودي من سهيل بن سالم % كبرت ولا يرجو طعاني إذا انفرد % % 6(@)(@@) % وقد كنت أحيانا أمنيه بالمنى % % فيحفى بحاجاتي وينجز ما وعد % 7(@)(@@) % فلما غدا في الملك ضاقت به استه % % وآلى يمينا لا يجود على أحد % 8(@)(@@) % أهان سهيل حاجتي فأهنته % % كذلك من يطلب بأسلافه يجد % 9(@)(@@) % إذا ذكر النابي تلمطت استه % % وبرق عينيه لورد متى يرد % % 10(@)(@@) % رأى منعظا يوما وقد طال عهده % . . . من استه الماء كالزبد % PageV01P632 11(@)(@@) % بكى الخر لما مس جلد ابن سالم % % وأعول عود الخيزرانة والأسد % 12(@)(@@) % وما المنبر السوسي باست ابن سالم % % براض ولكن المنايا لها عدد % % 13(@)(@@) % أبان ثلاثا يوم أوفى برأسه % % فقلت له أسويت يا سوءة البلد % % 14(@)(@@) % كأن أميرا قد سطا بابن سالم % % فقولا لمصان امسح استك وانجرد % % PageV01P633 البحر : مجزوء الرجز 1(@)(@@) % عجل أبا محمد % حاجة غاد من غد % 2(@)(@@) % ولا تكن مثل السرا % % ب إذ غدا لم يوجد % 3(@)(@@) % فالجود من كرم الفتى % % والمطل داء في اليد % 4(@)(@@) % أمضيت حاجة عشرق % برق الحمامة وارعد % 5(@)(@@) % وصبرت لابن الباهلي % % ولم أخس بالموعد % 6(@)(@@) % لا خير في مطل الجوا % % د ولا عطاء مفسد % PageV01P634 البحر : بسيط تام 
ms170	 1(@)(@@) % لله درك يا مهدي من ملك % % لولا اصطناعك يعقوب بن داوود % 2(@)(@@) % أما النهار فنخمات وقرقرة % % والليل يأوي إلى المزمار والعود % PageV01P635 البحر : طويل 1(@)(@@) % أباهل إني للحروب عواد % % وإن ردائي منصل ونجاد % 2(@)(@@) % أباهل هزوا لي فتى غير مدخل % فإن سماء الباهلي جماد % % 3(@)(@@) % إذا ما رآني الباهلي ابن كشكش % تقنع أو ضاقت عليه بلاد % 4(@)(@@) % وإني لشغار مرارا وربما % % سهلت وعندي للخليل وداد % % 5(@)(@@) % وهبت لأير الضالمي أست شاعر % % وقدت ابن نهيا والأسود تقاد % 6(@)(@@) % فأصبحت لا أخشى عداوة مجلب % % يد الله دوني واللسان حصاد % 7(@)(@@) % أنا ابن ملوك الأعجمين تقطعت % % علي ولي في العامرين عماد % 8(@)(@@) % خطبت وما أهدى لي اللؤم بنته % وشبت ومايحمي حماي نجاد % 9(@)(@@) % وحسبك أني منذ ستين حجة % أكيد عفاريت العدى وأكاد % 10(@)(@@) % إذا الخطب لم يقبل علي بوجهه % % فتكت ولم يضرب علي سداد % % PageV01P636 11(@)(@@) % وما زلت في رأد الشباب الذي مضى % % وفي الشيب يرجى نائلي ويراد % 12(@)(@@) % أجود العفاة الزائرين وربما % % طلبت أمير المؤمنين أجاد % % 13(@)(@@) % ومن عجب يعدو علي ابن كشكش % بغرمول كندير عليه سهاد % 14(@)(@@) % أبا كشكش لما عرفت قصائدي % % شحذت لها في راحتيك زناد % % 15(@)(@@) % وأنت ابن لقاط النوى قد عرفته % % وجدك زنجي أبوه رماد % % 16(@)(@@) % لقد كان عبدا للقشيري حقبة % وبئس الفتى عولى اليدين رقاد % 17(@)(@@) % يقول له الكعبي في جنباته % % علاجك يابن الفاعلين جهاد % 18(@)(@@) % فلا تشتر الزنجي إنك مفلح % % بأحمر فالزنجي عنك عتاد % % 19(@)(@@) % أبا كشكش وافقت زيدا لفعله % وأنت لأخرى والدخيس عياد % % 20(@)(@@) % فأصبحت ترجو أن تسود عليهم % % وهيهات ظن ابن الخليق فناد % % PageV01P637 21(@)(@@) % لعمري لقد أخطأت رأيك فيهم % وما كل ما تهوى أصاب مراد % % 22(@)(@@) % فدع عنك تشبيه الرقاد فإنما % % حلمت ولا يجدي عليك رقاد % % 23(@)(@@) % طوى الملك أولاد الزنا عن مخنث % لداء استه مخطومه وحساد % 24(@)(@@) % وما دافعوه رغبة عن سقامه % ولكن أولاد الزناء خلاد % 25(@)(@@) % أبا كشكش لاتدع فينا قرابة % عرفت وعرفان القبيح رشاد % % 26(@)(@@) % عليك بأولاد الزنا أنت منهم % % وما لك 
ms171	 في أهل الزكاء وساد % 27(@)(@@) % لسادات أولاد الزناء مزية % عليك فلا تجمع وفيك فؤاد % % 28(@)(@@) % وما كل أولاد الزنا يستطيعه % من آباء أولاد الزناء جواد % % 29(@)(@@) % أباهل فيكم عصبة مستفادة % لئام القرى فطس الأنوف جعاد % 30(@)(@@) % أباهل ردوا أعبد الحي إنهم % % جعاد ومن مال الكرام تلاد % % PageV01P638 31(@)(@@) % لقد شان أولاد الزناء سواده % وإن كان في بدر السماء سواد % % 32(@)(@@) % بني كشكش غطوا أساتي نسوة % تزيد من طعن وسوف تزاد % % 33(@)(@@) % بنات وزوجات وأخت وخالة % بها من شعاف بالطعان كباد % % 34(@)(@@) % لقد نفدت أشرافنا بعد عذرة % وما لعيون ابن الخليق نفاد % % 35(@)(@@) % ومشفقة مني على فرخ كشكش % % فقلت لها بقيا عليه فساد % % 36(@)(@@) % وما في هلاك ابن الخليق لرهطه % فساد ولكن في البقاء فساد % % 37(@)(@@) % دعاني وما أصبحت صوت ابن كشكش % لأنكح أختيه وفي بعاد % % 38(@)(@@) % فقلت له عندي من الطعن أربع % % صلاب وماعندي لهن كراد % 39(@)(@@) % عليك بطاووس الحبوش لأيره % % مناعم زهر منهما ووعاد % % 40(@)(@@) % نزا بك زنجي وأمك سلفع % من البرص لا تصطادهم وتصاد % PageV01P639 41(@)(@@) % فجئت كبغل السوء بين عرينة % وبين حمار حط عنه مزاد % 42(@)(@@) % إذا صهلت أماته حن أيره % لهن فكانت محجة وسفاد % PageV01P640 البحر : كامل تام 1(@)(@@) % أقبيص لست وإن جهلت ببالغ % سعي ابن عمك ذي الندى داوود % 2(@)(@@) % شتان بينك يا قبيص وبينه % أنت الذميم ولست كالمحمود % 3(@)(@@) % اختار داوود البكاء مكارما % واخترت أكل نقانق وثريد % % 4(@)(@@) % قد كان مجد أبيك لو أصلحته % روح أبي خلف كمجد يزيد % 5(@)(@@) % لكن جرى داوود جري مبرز % فحوى الندى وجريت جري بليد % % 6(@)(@@) % هذا جزاؤك يا قبيص فإنه % % جادت يداه وأنت قفل حديد % % 7(@)(@@) % داوود محمود وأنت مذمم % % عجبا لذاك ، وأنتما من عود % 8(@)(@@) % ولرب عود قد يشق لمسجد % % نصفا وسائره لحش يهودي % % 9(@)(@@) % والحش أنت له وذاك لمسجد % % كم بين موضع مسلح وسجود % PageV01P641 البحر : منسرح 1(@)(@@) % الناس إثنان في زمانك ذا % % لو تبتغي غير ذين لم تجد % 2(@)(@@) % هذا بخيل وعنده جدة % % وذا جواد بغير ذات يد % % PageV01P642 البحر 
ms172	 : وافر تام 1(@)(@@) % علي ألية وعلي نذر % أمسك طائعا إلا بعود % % 2(@)(@@) % أتيتك زائرا فوضمت كفي % % على أير أشد من الحديد % 3(@)(@@) % فخير منك من لاخير فيه % % وخير من زيارتكم قعودي % % PageV01P643 البحر : طويل 1(@)(@@) % أظن سعيدا كائنا لصديقه % كداحس عبس أو كبكر ثمود % % 2(@)(@@) % وما ابن زريق مقصر دون ضربة % على أنفه من ضامن لمزيد % % 3(@)(@@) % أمن حمل عند ابن نهيا أكلته % % من آل المثنى أو من آل يزيد % % 4(@)(@@) % تحوط ابن نهيا يا سعيد كأنما % % تحوط امرأ قد ناك أم سعيد % % PageV01P644 البحر : طويل 1(@)(@@) % تنح لحاك الله لست من العدد % وليس أبوك الوغل بالسيد السند % % 2(@)(@@) % مقامك مغمور وأنت مدفع % وبيتك بيت العنكبوت على العمد % % 3(@)(@@) % نزلت بجيل من ربيعة واسط % وقد كنت ملقى بالعراء لمن ورد % % 4(@)(@@) % فلما رأيت البحر دونك زاخرا % وفارقت أقراط المليحة والثمد % % 5(@)(@@) % فجرت ولم تشكر لمولاك نعمة % وجللك النعمى وأنت مع النقد % % 6(@)(@@) % أراك تجاري الغر من آل عامر % وأنت بهيم اللون حسبك من فند % % 7(@)(@@) % دع الفخر للأحرار إنك تارك % % لأفعالهم كل امرىء رهن ما مهد % 8(@)(@@) % أبوك الذي يعطى على ثمن استه % فما نفع الخنزير ما قال كاذبا % 9(@)(@@) % فإن قلت إني ماجد وابن ماجد % % فقد قال خنزير السواد أنا الأسد % % 10(@)(@@) % فإن نفع الخنزير ما قال كاذبا % ولا سرني ضغن الضغائن والحسد % % PageV01P645 11(@)(@@) % وبيت كدخان السماء بنيته % على طامح العينين في رأسه ميد % % 12(@)(@@) % وأنسيته لون السماء ولم يكن % يرى غيرها من شدة الكبر والأود % % 13(@)(@@) % وأصبح ينفي عيبه تحت رجله % وتحت استه الملحاء إن قام أو قعد % % 14(@)(@@) % وكنت إذا ضاقت علي محلة % تيممت أخرى ولم يضق عني البلد % % 15(@)(@@) % ومولى تولى عامدا فتركته % % وما غاله إن العقاب لمن عند % 16(@)(@@) % ومعترض سكنته بغريبة % لها مذهب في كل حي ومنتقد % 17(@)(@@) % إذا أخرجت مني لقوم حدا بها % % من القوم حاد خلفها أيد غرد % % 18(@)(@@) % يصلي لها أذن الهمام ومن أتت % % على سمعه من سوقة خر أو سجد % % 19(@)(@@) % وإني 
ms173	 لحمال العدو على التي % % إذا لقيت أولاد وجعائه اقتصد % % 20(@)(@@) % أشأو بني كعب طلبت بمجهر % % قريب المدى يا سوأة لك لا تعد % % PageV01P646 21(@)(@@) % فلا تلم النهري إن قل جريه % لعمر أبيك الوالقي لقد جهد % % 22(@)(@@) % ولكنما جارى الرياح بعبدة % فمرت فلم تحصر بحد ولاجلد % % PageV01P647 البحر : كامل تام 1(@)(@@) % هجر الوساد فبات غير موسد % % وأذابه ورد الحمام المورد % 2(@)(@@) % شرع المكاره من توجه غاديا % يا للرجال لما يروح ويغتدي % % 3(@)(@@) % وبياض يوم قد سحبت وليلة % % قد بتها غرض الهموم العود % 4(@)(@@) % وكأن همي والظلام تواعدا % % عندي فكل قد وفا بالموعد % % 5(@)(@@) % جاشت جنودهما علي فلم أنم % % وبدا وقد بلغت بغير تبدد % 6(@)(@@) % إن التي سبعت عدوه أصبحت % عما لقيت كغائب لم يشهد % 7(@)(@@) % ملأت حشاك وربما ملأ الحشا % % وجد بحمدة مثله لم يوجد % % 8(@)(@@) % إذ أنت مشتغل الفؤاد بذكرها % % صب وإذ هي من بنات المسجد % % 9(@)(@@) % لو أن أرمد لا يجلى نظرة % تبدو له كانت شفاء الأرمد % 10(@)(@@) % أيام يحسدها الثنا جاراتها % % وسط النساء ومثلها فليحسد % PageV01P648 11(@)(@@) % . . . . خاه لا في التي % % تصل النساء له هوى المتأود % 12(@)(@@) % . . . . . شفق من هواك ولم أخف % % عجل المنايا والردى في المرصد % % 13(@)(@@) % . . . . . . يخزنك الثرى % % ريا كغصن البانة المتأود % % 14(@)(@@) % لا تبعدن وأين من فارقته % % أمسى بمثل سبيلها لم يبعد % % 15(@)(@@) % إن التي كانت هواك فأصبحت % تحت السفائف في الثرى المتلبد % % 16(@)(@@) % ليست بسامعة وإن ناديتها % % منك السلام كذلك الميت الردى % % 17(@)(@@) % أحميد إن ترد المصاب فإننا % % رهن النفوس بمثل ذاك المورد % % 18(@)(@@) % والناس كلهم وإن بعد المدى % % عنق تتابع كلهم في مقود % 19(@)(@@) % أصبحت بعدك كالمصاب جناحه % يبكي لجانبه إذا لم يسعد % % 20(@)(@@) % حران فارق إلفه ونأى به % % دهر يعود على سواد الموجد % PageV01P649 21(@)(@@) % مما يعزي القلب بعدك أنني % % في اليوم جارك ياحميدة أو غد % 22(@)(@@) % نفد الزمان ومن حميدة لوعة % بين الجوانح حرها لم ينفد % 23(@)(@@) % يبدي الضمير إذا عرفت له به % لونا كخافية الغراب الأسود % % 24(@)(@@) % بيضاء لبسها الحياء عفافه % فضل القناع إذا 
ms174	 خلت لم توصد % % 25(@)(@@) % فأتتك في جدث الضريحة خلة % يا خلة لك في الضريح الملحد % 26(@)(@@) % فالآن أغدو ما يكون بغيره % % غلبت وطول صبابة وتبلد % 27(@)(@@) % قد كنت أذكر من عبيدة بصة % وأعف عن شغب اللسان وفي اليد % % 28(@)(@@) % وأرى حراما أن يحل محلها % % مني امرؤ بصداقة وتودد % % 29(@)(@@) % ولقد أقول غداة ينأى نعشها % % صلى الإله عليك أم محمد % 30(@)(@@) % فلقد تركت كبيرة محزونة % وأخا إخاء عينه لم تجمد % PageV01P650 31(@)(@@) % بردت على كبد المصاب وأصبحت % % مني نوافذ حرها لم تبرد % % PageV01P651 البحر : مجزوء الكامل 1(@)(@@) % يا صاح بين حاجتي % % إن البيان مع السداد % % 2(@)(@@) % صرح بإحدا كلمتي % % ن وخذ أمانك من جهادي % % 3(@)(@@) % بخل البخيل أحبه % مطل الجواد غداة صاد % % 4(@)(@@) % أنت الغنى لولا مطا % % لك والمطال من الكياد % % 5(@)(@@) % يا صاح لا تلو العدا % % ت فإنها دين الهوادي % % 6(@)(@@) % إن السبيل على اثنتي % % ن اخترهما يا بن الجياد % % 7(@)(@@) % إما تسامح أو تجا % % مح ليس ثالثة لعاد % % 8(@)(@@) % يكفيك لا طول العبا % % د ولا اجتهادا من مناد % 9(@)(@@) % ضمنت حاجة صاحب % % فاسلك بها سبل الرشاد % % 10(@)(@@) % الموت شيء هين % والموت إنجاز الوعاد % % PageV01P652 11(@)(@@) % صدق البخيل يسرني % % ويسوءني كذب الجواد % % 12(@)(@@) % إني لأنجز ما وعد % % ت على الطريف وفي التلاد % % 13(@)(@@) % وإذا سئلت أتيتها % % ضرب الأمير طلا الأعادي % % 14(@)(@@) % إما بتيا أو بتي % % ك وراحة ترك الكداد % 15(@)(@@) % وأخو المباخل مطرق % كالعرد ليس بمستزاد % 16(@)(@@) % يا صاح رشح حاجتي % % واذكر ضمانك في المعاد % % 17(@)(@@) % لا خير في دنيا الكري % % م ولا اللئيم عن الوداد % % 18(@)(@@) % فاندب لودك واحدا % أو كن كذي الفرس الوجاد % % 19(@)(@@) % بل كيف تأبى للنفو % % س وغيها في كل واد % 20(@)(@@) % المرء يغبط حظه % واللهو من ثمر الفؤاد % % PageV01P653 21(@)(@@) % وعلى النساء بشاشة % وأرى الصلاح إلى فساد % 22(@)(@@) % فاصبر لقسمة ما ترى % % لا يدفع القدر المعادي % % PageV01P654 البحر : متقارب تام 1(@)(@@) % ألا طرقت موهنا مهدد % % وقد غور الكوكب المنجد % 2(@)(@@) % ألمت بملمومة كالقنا % % وفتيان حرب لهم توقد % 3(@)(@@) % فبت أحيا 
ms175	 بموجودة % مع الليل تصبح لا توجد % % 4(@)(@@) % ألاعب غولا هداه الكرى % % إلينا تشط وتستورد % % 5(@)(@@) % فلما صحوت ولم ألقها % % صحوت وقلبي مقتصد % % 6(@)(@@) % أقلب هما بها جاثما % وعينين رعيتها الفرقد % 7(@)(@@) % فيا حزنا بعد جنية % عليها القلائد والمسجد % % 8(@)(@@) % ويا كبدا ليس منها لنا % % نوال ولا عندها لي يد % % 9(@)(@@) % سوى شوق عيني إلى وجهها % % وأني إذا فارقت أكمد % 10(@)(@@) % بكيت من الداء داء الهوى % % إليها وأن ليس لي مسعد % PageV01P655 11(@)(@@) % وقد عدت صفدا في غد % وكم وعدتك ولا تصفد % % 12(@)(@@) % وإني على طول إخلافها % % لأرجو الوفاء ولا أحقد % 13(@)(@@) % إذا أخلف القوم ظني بها % % وكان لها في غد موعد % 14(@)(@@) % صبرت على طلق آيايها % % حفاظا وصبر الفتى أعود % 15(@)(@@) % وما ضن يوم بداء الهوى % % محبا إذا ما سقاه الغد % 16(@)(@@) % وليلة نحس جمادية % إذا نسمت ريحها تبرد % 17(@)(@@) % أقمنا لأضيافنا مرقدا % وما كل يوم لهم مرقد % 18(@)(@@) % وإني إذا ما عوى نابح % وجاش له بحري المزبد % 19(@)(@@) % لأرمي نوافذ يشقى بها % % فراخ اللئام ولاتسعد % 20(@)(@@) % أحماد لست من أكفائنا % % وأنت امرؤ زعموا تسفد % PageV01P656 21(@)(@@) % كفى عجبا معجبا أنني % % أراك تكلم يا عجرد % 22(@)(@@) % وما كنت أحسب من داؤه % كدائك ينطق لا يخلد % % 23(@)(@@) % جلست على الخز بعد الحفا % % وأصبحت في حفد تحفد % 24(@)(@@) % ونازعت قوما تماريهم % فيا عجب الدهر لا ينفد % 25(@)(@@) % وما لك لا تحتبي جالسا % على العبقري وتستوفد % 26(@)(@@) % أبوك شبير فأكرم به % وفي استك ورد لمن تورد % % 27(@)(@@) % وأمك من نسوة همهن % أشيب ومفرقها يجمد % % 28(@)(@@) % إذا سئلت لم تكن كزة % ولكن تذوب ولا تجمد % % 29(@)(@@) % ليالي إذا لم يرد بيتها % % أقامت تذكر من تغمد % % 30(@)(@@) % إذا قدم الشرب إبريقهم % % ظللت لإبريقهم تسجد % PageV01P657 31(@)(@@) % وتعبد رأسا تصلي له % وأما الإله فلا تعبد % 32(@)(@@) % وتظهر حب نبي الهدى % % وأنت به كافر تشهد % 33(@)(@@) % وتشرك ليلة شهر الصيام % % حلالا كما نظر الأربد % 34(@)(@@) % وما إن تزال على سوءة % من ابنك . . . لها تصمد % 35(@)(@@) % وبنتك بلوا قشرت استها % % مجونا 
ms176	 كما ينحت المبرد % 36(@)(@@) % وتغشى النساء توازي بهن % ومن همك الحية الأسود % % 37(@)(@@) % وإن سنح الخشف عارضته % كما اندفع السابح الأجرد % 38(@)(@@) % وإن قيل صل فقد أذنوا % % زمعت كما يزمع المقعد % 39(@)(@@) % وإن قامت الحرب عراضة % قعدت وحرضت من يقعد % 40(@)(@@) % وإن جئت يوما إلى زلة % أكلت كما يأكل القرهد % PageV01P658 41(@)(@@) % وإن كتم السر أفشيته % نميما كما بلغ الهدهد % 42(@)(@@) % فأنت المشقى وأنت الذي % % بما قد سردت وما أسرد % 43(@)(@@) % ستعلم لو قد بدا مئسمي % % عليك وغنى بك المنشد % 44(@)(@@) % ألوم ابن نهيا على أنه % % يحب الرقود ولا يرقد % % 45(@)(@@) % وكيف ألوم امرأ باسته % % عياء من الداء لا يفقد % % 46(@)(@@) % عصاني ابن نهيا فبعدا له % كما بعد النازح الأعقد % 47(@)(@@) % إذا نال جاها كبا تحته % كما يزحف الحية الأربد % 48(@)(@@) % ويعطيك ذلا إذا رعته % كما ذل للقدم المربد % 49(@)(@@) % ويأخذ شرة إخوانه % % مفيدا كما يأخذ الأبعد % % 50(@)(@@) % وتبعد أن لم أنك أمه % % وأما المثنى فلا يبعد % PageV01P659 51(@)(@@) % لقد جال جردانه في ستها % % كما جال في المقلة المرود % PageV01P660 البحر : طويل 1(@)(@@) % لعمرك لقد أجدى علي ابن برمك % وما كل من كان الغنى عنده يجدي % % 2(@)(@@) % حلبت بشعري راحتيه وقد رنا % % سماحا كما در السحاب على الرعد % 3(@)(@@) % وثغر كأفواه الأسود سددته % بسمر القنا والبيض والقرح الجرد % % 4(@)(@@) % مقامك محمود وسيبك واسع % وبيتك مرفوع الدعائم بالمجد % % 5(@)(@@) % مفيد ومتلاف سبيل تراثه % % إذا ماغدا أو راح بالجزر والمد % 6(@)(@@) % سبقت بأيام المكارم والعلا % % تراث أب نال المكارم عن جد % % 7(@)(@@) % أجعفر إن الحمد يبقى لأهله % % جمالا ولا تبقى الكنوز على الكد % 8(@)(@@) % فأطعم وكل من عارة مستردة % ولا تبقها إن العواري للرد % PageV01P661 البحر : هزج 1(@)(@@) % ألا يا حبذا والل % ه من حملته ودي % % 2(@)(@@) % أحب الوعد من فيه % % وإن لم يوف بالعهد % % 3(@)(@@) % حبيب قربه الخلد % وأنى لك بالخلد % % 4(@)(@@) % كأني في الهوى جهدا % وقد زاد على الجهد % % 5(@)(@@) % ترى مني له بدا % % وما لي منه من بد % 6(@)(@@) % فمن ينصفني منه % على 
ms177	 ما بي له مدي % % 7(@)(@@) % من اللؤلؤ والياقو % % ت أو من عنبر الهند % % 8(@)(@@) % أو المسك فإن المس % ك من أشباهه عندي % % 9(@)(@@) % فلو بتنا به ليلا % مع الأسفاط والورد % % 10(@)(@@) % قضينا حاجة النفس % % ولم نصبح على وجد % PageV01P662 البحر : بسيط تام 1(@)(@@) % ظل اليسار على العباس ممدود % وقلبه أبدا بالبخل معهود % 2(@)(@@) % إن الكريم لتخفى عنك عسرته % % حتى تراه غنيا وهو مجهود % 3(@)(@@) % وللبخيل على أمواله علل % زرق العيون عليها أوجه سود % 4(@)(@@) % إذا تكرهت أن تعطي القليل ولم % تقدر على سعة لم يظهر الجود % 5(@)(@@) % أورق بخير ترجى للنوال فما % % ترجى الثمار إذا لم يورق العود % 6(@)(@@) % بث النوال ولا تمنعك قلته % فكل ما سد فقرا فهو محمود % PageV01P663 البحر : طويل 1(@)(@@) % إليك طلبنا يا وليد وإنما % % طلبنا يدا مثل السماء تجود % 2(@)(@@) % إذا قيل من يعطي على الحمد ماله % ويصطنع المعروف قيل وليد % 3(@)(@@) % وليد ابن عباس وليس بعابس % إذا احتاج جار أو ألم بعيد % PageV01P664 البحر : طويل 1(@)(@@) % تصلي الضحى شتى وتمسي فنلتقي % % لعقد اليدين الحرتين على الود % 2(@)(@@) % فإن تك قد شطت بصفراء نية % وأصبح مولاها مصيخا على حقد % % 3(@)(@@) % فقولي لها مني السلام ورحمة % وأن أسأل الفعال ما فعلت بعدي % % 4(@)(@@) % لحى الله قوما عيروني بحبها % % وقد سبق المقدار في القلب والخلد % PageV01P665 البحر : طويل 1(@)(@@) % خليلي غضا ساعة وارحلا بردا % % وزورا فتى يكفيكما حسبا إدا % % 2(@)(@@) % سفيح بن عمرو لا بل وليده % وإن ذكر المعروف أصغى له خدا % % 3(@)(@@) % أرى الهم قد ألقى علي جرانه % حديثا وبعض الهم ينتهك الجلدا % % 4(@)(@@) % فزورا سفيحا أو أشيرا بمثله % وأنى بأمثال الفرات إذا مدا % % 5(@)(@@) % دعاسبه أود الجياد على الوجا % % وهز المنايا في مناصله ربدا % % 6(@)(@@) % فلم يبق ممن يشتري الحمد بالندى % % خلا ما سفيح لا رأينا له فقدا % % 7(@)(@@) % إذا لبس الماذي يوم كريهة % وشمر يحدو الخيل أو قادها جردا % % 8(@)(@@) % رأيت إباء الملك فوق جبينه % % يهز المنايا والهرقلية النقدا % % 9(@)(@@) % يهز يدا للحمد طالت وهزه % % ندى مثل طيار 
ms178	 الفرات إذا جدا % % 10(@)(@@) % جزى الله عن قومي سفيحا كرامة % وعن رجل يهدي له الحمد والودا % % PageV01P666 11(@)(@@) % إذا ماسفيح راح في الملك واغتدى % % جرت ذهبا كفاه للقوم أو جدا % % 12(@)(@@) % طلوع بحاجات الوفود وربما % % تجاسر بالكبرى فأورى بها زندا % % 13(@)(@@) % وركاب أعواد المنابر لا يني % % خليفة ملك للصعاليك أو حدا % % 14(@)(@@) % بنا حاجة أنت ابن عمرو طبيبها % % فأنصف أخا أصفاك أشعاره رفدا % % 15(@)(@@) % خلقت سماء للعفاة غزيرة % ومفتاح أبواب المهم إذا امتدا % % 16(@)(@@) % وكوكب قوم كان نحسا عليهم % % زمانا فلما قمت أطلعته سعدا % % 17(@)(@@) % وخطة حزم قد كشفت بها الردى % % ورأس رئيس قد بعثت به وفدا % % 18(@)(@@) % وأنت امرؤ من وائل وسط الندا % % كفيت به من كان نائله جعدا % % 19(@)(@@) % رأيتك تنوي الهند بالبيض والقنا % % وبالخيل تسمو في أعنتها جردا % % 20(@)(@@) % فسر مصحبا بالنصر في محزئلة % تهز القنا حتى تروع بها الهندا % % PageV01P667 21(@)(@@) % وحتى تضم الساحلين كليهما % % سبيا كشاء العيد أصبح منتدا % % 22(@)(@@) % فتى البأس لايلقاه إلا مع الندى % % مهينا لحر المال أو ضاربا كردا % % 23(@)(@@) % أقول وقد راح اللواء لعامر % وعبد قفا نعهد إلى ملك عهدا % % 24(@)(@@) % لعل التي قلدتها قرم وائل % يجود لنا من سيبه نفلا يهدى % % 25(@)(@@) % قعيدك أن ينسى امرؤ أنت همه % تلالا عليه الهم لا يبرح الخلدا % % PageV01P668 البحر : طويل 1(@)(@@) % نبا بك خلف الظاعنين وساد % % وما لك إلا راحتيك عماد % 2(@)(@@) % لخدك من كفيك في كل ليلة % إلى أن ترى وجه الصباح وساد % 3(@)(@@) % كأنك للشوق الغريب إذا سرى % % من الوجه مشدود عليك صفاد % 4(@)(@@) % تبيت تراعي الليل ترجو نفاده % وليس لليل العاشقين نفاد % % 5(@)(@@) % تقلب في داج كأن سواده % % إذا انجاب موصول إليه سواد % % 6(@)(@@) % أبى لك إغماض الخلي جفونه % على النوم عين صبة وفؤاد % 7(@)(@@) % وطول جهاد النفس فيما تتبعت % % وإدراكك النفس اللجوج جهاد % % 8(@)(@@) % وبعد المدى من غاية لو جريتها % % إلى هجر سعدى ما هجاك بعاد % 9(@)(@@) % ولكن عقلي مجلسا بعد مجلس % لنفسك مما لا تنال فساد % % 10(@)(@@) % أفالآن تستشفي طبيبك سلوة 
ms179	 % وقد ظعنت سعدى وقلبك راد % PageV01P669 11(@)(@@) % أرى النفس قد ضنت عليك بنيلها % % وضنت عليها بالنوال سعاد % 12(@)(@@) % وما بك إن لم تعط تلك جلادة % وما منك إن لم تلق رقاد % 13(@)(@@) % لقد صادني ريم أردت اصطياده % % وما كنت لولا ما أردت أصاد % 14(@)(@@) % إذا طارف الحب انجلى عنك همه % ثناه من الحب الدخيل تلاد % 15(@)(@@) % لقد صرحت عما تجمجم طعنة % شجيت بها حتى ظللت تعاد % 16(@)(@@) % تداعت لك الأهواء فازددت عبرة % وللدمع من بين الحبيب مداد % % 17(@)(@@) % فقل في صديق يحسب الغي رشدة % وفي بعض حوزات الخليل رشاد % 18(@)(@@) % يؤخر ما تعجيله لك راحة % فتحيا كروب كلهن شداد % 19(@)(@@) % إذا قلت إني قد لقيت شقاوة % بحبك قالت لي وسوف تزاد % 20(@)(@@) % لنا غلظة منها ولين مقالة % % ولوعة هجر مرة ووداد % PageV01P670 21(@)(@@) % فوالله ما أدري وكل مصيبة % بأي مكيدات النساء نكاد % % 22(@)(@@) % لقد صادني ريم أردت اصطياده % % وما كنت لولا ما أردت أصاد % 23(@)(@@) % جميل المحيا حظه منك نسبة % وحظك منه لوعة وسهاد % 24(@)(@@) % إذا أنست من عاجل البين . . . . % رجاء بأخت الناس حين تذاد % 25(@)(@@) % غرور مواعيد كأن جداءها % % جدا بارقات مزنهن جماد % 26(@)(@@) % على الدهر ما منتك سعدى ودونه % لأم المنايا مبتدى ومعاد % 27(@)(@@) % فهل أنت إن لم يعطك الدهر رأسه % % مذلله حتى تراه يقاد % 28(@)(@@) % وإلا فدع عنك الصبابة فالشفا % % على إثر من تهوى وفيك مداد % PageV01P671 البحر : وافر تام 1(@)(@@) % أعبدة قد غلبت على فؤادي % % بدلك فارجعي بعض الفؤاد % % 2(@)(@@) % جمعت القلب عندك أم عمرو % % وكان مطرحا في كل واد % % 3(@)(@@) % إذا نادى المنادي باسم أخرى % % على اسمك راعني ذاك المنادي % % 4(@)(@@) % كما أفسدتني عرضا فهاتي % % صلاحي قد قدرت على فسادي % % 5(@)(@@) % ملكت فأحسني وتخلصيني % % من البلوى بحبك والبعاد % 6(@)(@@) % فإني منك يا بصري وسمعي % % ومن قلبي حميتك في جهاد % % 7(@)(@@) % يميل إليكم وأميل عنكم % % فآتي جهده دون اجتهادي % % 8(@)(@@) % ولو أسطيع ما عذبت نفسي % % بذكرك غير منصرف بزاد % 9(@)(@@) % ولكن الأماني قربتني % % فدل بها إلى حتفي قيادي % % 10 
ms180	(@)(@@) % ألفتك يا عبيدة إن شوقا % وطيفا منك قد ألفا وسادي % % PageV01P672 11(@)(@@) % ألا تجزينني بالشوق شوقا % هداك إلى الجزاء بذاك هاد % % 12(@)(@@) % بلغت تجلدي بصدود يوم % % ولم تغني بذاك ولم تكادي % % 13(@)(@@) % أطعت بنا الوشاة وقد عصينا % % إليك الناصحين مع الأعادي % % 14(@)(@@) % كأني من تذكركم سليم % % أضل دواؤه غير السهاد % 15(@)(@@) % رضينا من نوالك أن تردي % % علي ولم أمت غما رقادي % % 16(@)(@@) % ألا يا ليت شعري يوم تبدو % % بها صبر وصبري غير باد % 17(@)(@@) % أدلت بالصدود أم استزادت % % فتى في الحب ليس بمستزاد % % 18(@)(@@) % أزائر أهل عبدة قل لشخص % عدتني عن زيارتها العوادي % % 19(@)(@@) % أحاولت الرشاد بقتل نفس % وأين القتل من عمل الرشاد % 20(@)(@@) % دعي ما تصنعين فدتك نفسي % % عبيد وطارفي بعد التلاد % % PageV01P673 21(@)(@@) % أعيرينا ودادكم فواقا % بما نلقي إليك من الوداد % 22(@)(@@) % فقد أفردتني من كل أنثى % % تؤملني وقل لك انفرادي % % 23(@)(@@) % رتقت لهن ياعباد عندي % % وإن كن الملائح بالكساد % % 24(@)(@@) % أصد عن النساء وهن صور % كما صد الرهيص عن الضماد % % 25(@)(@@) % كأني واطئ بيني وبين ال % % غواني غيركم شوك القتاد % % 26(@)(@@) % عفا من حبهن سواد قلبي % % وحبك يا عبيدة في السواد % % 27(@)(@@) % بلادي سهلة الممشى إليكم % % وتحزن دون غيركم بلادي % % PageV01P674 البحر : بسيط تام 1(@)(@@) % يا بنت صقر بن قعقاع على كبدي % % شوق إليك وفي روحي وفي جسدي % % 2(@)(@@) % كدرت شرب الغواني لاصفوت لنا % % وقد صفا لك ودي موردا فردي % % 3(@)(@@) % أمنت من شرك أخرى في مودتنا % % ما حافظت ذات أحشاء على ولد % 4(@)(@@) % الله يعلم أني منذ حدثني % % عنك النساء طويل الليل بالسهد % 5(@)(@@) % أحرمت ريحان بستان وناضره % حتى أشمك يا ريحانة البلد % 6(@)(@@) % ما ساقني لك مملوكا وعلقني % % إلا العيون اللواتي جئن من صدد % % 7(@)(@@) % جمعن نفسي وقد كانت مفرقة % بين النساء وما أبقين من جلد % 8(@)(@@) % قال النواصح طوبى قد ظفرت بها % % مكسورة الطرف بالتأنيث والرمد % % 9(@)(@@) % جنية الحسن مرتج روادفها % % كأنها من جواري الجنة الخلد % % 10(@)(@@) % أبشر ستلقى غدا سعدى برؤيتها % % وكل ما في غد دان 