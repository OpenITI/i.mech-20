ms81	 أهل الهوى أهدافها % % PageV01P268 11(@)(@@) % نشأت مع الأرام إلا أنها % % لاشيحها ترعى ولا خذرافها % % 12(@)(@@) % وبذي الأراكة ربعها لك جنة % غيد الظباء تفيأت ألفافها % % 13(@)(@@) % ألفته فارتبعت بأطيب ملعب % منه وكان لطيبه مصطافها % % 14(@)(@@) % أرجت برياه رباه وقد مشت % % عطرى البرود فضوعت أخيافها % % 15(@)(@@) % يا ربع شوقي هل تضيف حشاشة % نزلت ظباك بربعها فأضافها % % 16(@)(@@) % ديست بأخفاف المطي لأنها % % شوقا إليك تقدمت أخفافها % % 17(@)(@@) % حيتك من نور الثريا حفل % حلبت عليك يد الصبا أخلافها % % 18(@)(@@) % من كل صادقة المخيلة حلقت % % من نحو نجد واغتديت مطافها % % 19(@)(@@) % طارت بأجنحة النسيم وأقبلت % % تحدو الرعود ثقالها وخفافها % % 20(@)(@@) % قد حللت كف البروق نطاقها % % فغدت تريق بصقوتيك نطافها % % PageV01P269 21(@)(@@) % نثرت عليك عشية برد الحيا % % نثر اللئالىء فارقت أصدافها % % 22(@)(@@) % أمشببا بالغيد زدني مازجا % في وسف مجلس أنسنا أوصافها % % 23(@)(@@) % هو تحفة الدنيا لنا قد أحسنت % % فيه بريحان الهوى إتحافها % % 24(@)(@@) % قد بت أقطف من حديقة زهره % أزهار بشر ما ألذ قطافها % % 25(@)(@@) % ونديمتي هيفاء وشح خصره % بمذهب شغفت به وصافها % % 26(@)(@@) % جلت المدام لنا فقلت لصاحبي % % منحتك ساقية الطلى أسعافها % % 27(@)(@@) % وشدت وقد أرخت ثلاث ذوائب % بيد الدلال فأطربت ألافها % % 28(@)(@@) % ودعوت يا بشراك إن ليالي ال % % تشريق تلك فبادر استينافها % % 29(@)(@@) % وصدقتك البشرى فعرس محمد % عيد على الدنيا أدار سلافها % % 30(@)(@@) % ضحكت بها الدنيا سرورا واكتست % % للزهو من حبراتها أفوافها % % PageV01P270 31(@)(@@) % فاليوم قرت عين هاشم في الثرى % % وسقته أنواء السرور نطافها % % 32(@)(@@) % وسرت إلى أبناء عبد منافها % % نفحات بشر أطربت مستافها % % 33(@)(@@) % وصلتهم البشرى بعرس مهذب % أحيت مآثر جده أسلافها % % 34(@)(@@) % ينميه من مهدي آل محمد % % هذا الذي نعشت يداه ضعافها % % 35(@)(@@) % ورث الإمامة علمها وصلاحها % % وسماحها وإباءها وعفافها % % 36(@)(@@) % يتدارس الملأ المقدس عنده % % حكما بهرن من الورى عرافها % % 37(@)(@@) % رب القدور الراسيات موائلا % كالبرك أرحب مالئا أجوافها % % 38(@)(@@) % هدارة تحت الدجى فكأنما % % تدعو بحي على القرى أضيافها % % 39(@)(@@) % ولو أن ياجوجا ومأجوجا أتت % % مغناه تلتمس القرى لأضافها % % 40(@)(@@) % يا من مكارم شيبة الحمد 
ms82	 انتهت % % إرثا إليه وزادها إضعافها % % PageV01P271 41(@)(@@) % علمت قريش أن قومك خيرها % % كرما وإن منعتهم إنصاقها % % 42(@)(@@) % فإذا قريش في المكارم طاولت % % غلبت بطول المطعمين عجافها % % 43(@)(@@) % بالراحلين بها وقد أخذوا لها % % عهد الأمان وسل بهم إيلافها % % 44(@)(@@) % بالمنشقين أنوفها عزف العلا % % والمرغمين على الهدى آنافها % % 45(@)(@@) % من أعتقوها في المحول وأرهنوا % % في السبق حتى استعبدوا أشرافها % % 46(@)(@@) % فبكم أعز المؤمنين إلهها % % وكفا بواحد جمعكم آلافها % % 47(@)(@@) % واليوم إن شكت الشريعة قرحة % فسواك ليس بمدمل إقرافها % % 48(@)(@@) % ما أيقنت ببقاء مهجتها لها % % حتى دعاك الله قم فتلافها % % 49(@)(@@) % فمنعت حوزتها وصنت حريمها % % وحميت بيضتها وحطت سجافها % % 50(@)(@@) % يابن النبي وتلك أشرف دعوة % طربا تهز لها العلى أعطافها % % PageV01P272 51(@)(@@) % أنت الذي ارتضع النبوة درها % % وله الإمامة مهدت أكنافها % % 52(@)(@@) % من حل دارك ظن تربة قدسها % % كافورة خلدية فاستافها % % 53(@)(@@) % ونعم هي الفردوس إلا أنها % % رضوان بشرك خازن إلطافها % % 54(@)(@@) % هي باحة الشرف المقدسة التي % % ولدت بها منك العلى أشرافها % % 55(@)(@@) % ولدتهم علماء يكشف هديهم % % عن ذي القلوب الغافلات غلافها % % 56(@)(@@) % شفوا طباعا لا تميل مع الهوى % % من حيث طهر ربها شفافها % % 57(@)(@@) % فإذا بجعفرها ارتفدت وجدته % % فراج كل عظيمة كشافها % % 58(@)(@@) % قمر توسط دارة فلكية % جمع الكمال على النهى أطرافها % % 59(@)(@@) % لولا اكتساب الحاسدين بنعله % % شرفا لقال المجد طأ آنافها % % 60(@)(@@) % حيث التفت وجدت ألسنة الثنا % % والمدح تعلن في علاه هتافا % PageV01P273 61(@)(@@) % وسعى الورى حلما وأدب جهلها % % غضبا فآمن خوفها وأخافها % % 62(@)(@@) % وكفا بني الأمل السؤال وطالما % % ملت بساحة غيره إلحافها % % 63(@)(@@) % هو سيد الكرماء إن ذكر السخا % % وأخو المكارم إن غدوا أحلافها % % 64(@)(@@) % زعم الأنام بنانه أم الحيا % % كذبوا وإن رضع الحيا أخلافها % % 65(@)(@@) % لا قلت أنمله ضروع غمامة % % ومن الغمائم كم ذممت جفافها % % 66(@)(@@) % وحمدت أنمله لأن لها الندى % % طبع تنيلك دائما إسعافها % % 67(@)(@@) % قد قلت للبخلاء مذ عقروا الندى % % وبنوا المكارم حرمت إيجافها % % 68(@)(@@) % كونوا ثمود فإن جعفر صالح % للوفد يغمر بالندى معتافها % % 69(@)(@@) % هذا أبو الهادي الذي لو 
ms83	 جاورت % % يده الغيوم ولبخلت وكافها % % 70(@)(@@) % بين الإمامة والنبوة رتبة % % بعلى السيادة قد علا أعرافها % % PageV01P274 71(@)(@@) % تقف الملائك دون نور جلالها % % خضعا فتكثر نحوه استشرافها % % 72(@)(@@) % آباؤه حمت الشريعة في ضبا % لم يعد حاسم رأيه أوصافها % % 73(@)(@@) % فكأن من أسيافها آراؤه % % وكأن من آرائه أسيافها % % 74(@)(@@) % رأي يرد على الزمان سهامه % % حتى تبيت صروفه أهدافها % % 75(@)(@@) % جذلان يبسط راحة لم يعقد الأ % % مساك لمحة ناظر أطرافها % % 76(@)(@@) % ماذا حواسدها تقول وقد رأت % % في المكرمات لوفرها أتلافها % % 77(@)(@@) % أتقول مسرفة بلى هي تقتفي % % بالجود في إسرافها أسلافها % % 78(@)(@@) % وكأنما فمه حوى نضناضة % للخصم ينفث في حشاه ذعافها % % 79(@)(@@) % هو في لسان المكرمات محمد % ومحمد هو جامع أصنافها % % 80(@)(@@) % مولى خلائقه حلت فلو أنها % % PageV01P275 81(@)(@@) % هو والحسين بمجده قمرا علا % كل عن الدنيا جلا أسدافها % % 82(@)(@@) % سقيت رياض كماله ماء النهى % % فبهرن في أزهارها قطافها % % 83(@)(@@) % فئة لها حسب تكافا في العلى % % طرفاه قد وطا معا اكتافها % % 84(@)(@@) % فلكم بني الوحي الرسالة في الورى % % وعليكم مد الإله طرافها % % 85(@)(@@) % إن تفضلوا شرفا ملائكة السما % % فالله أخدم جدكم أشرافها % % 86(@)(@@) % لو لم يجئ في ذكر وصف علاكم % % تالله ما عرف الورى أوصافها % % 87(@)(@@) % ولكل آن في الأنام إذا التوت % % منكم إمام هدى يقيم ثقافها % % 88(@)(@@) % وإمام هذا العصر قام أبوكم % % فيها فراض برفقه أعسافها % % 89(@)(@@) % لم تختلف علماؤها في مشكل % إلا ورد إلى الصواب خلافها % % 90(@)(@@) % يابن الألى ركبوا سوابق من علا % عقدوا بناصية السهى أعرافها % % PageV01P276 91(@)(@@) % وابن الذين إذا الجياد حملنهم % % لوغى وقوا بصدورها أردافها % % 92(@)(@@) % خذها كما اقترح الوفا مزفوفة % بجميل ذكرك تستطيب زفافها % % 93(@)(@@) % تهدي التهاني جهدها ومن الحيا % % تبدي رجاء قبولك استعطافها % % 94(@)(@@) % أنت الذي زهرت مناقب مجده % % بين النجوم وأشرفت إشرافها % % 95(@)(@@) % نضت الشريعة من لسانك مرهفا % فمخيفها بالأمس ها هو خافها % % 96(@)(@@) % ورأت بناثلك الوفود غناءها % % من كل من طلبت لديه كفافها % % 97(@)(@@) % فإذا لغيرك ذم موجفها السرى % % حمدت إليك بنو السرى إيجافها % % 98(@)(@@) % فخلدت في الدنيا 
ms84	 بعلمك في الورى % % ونداك يملأ صحفها وصحافها % % PageV01P277 البحر : كامل تام 1(@)(@@) % حيتك من وجناتها بشقيقها % % وجلت عليك مدامة من ريقها % % 2(@)(@@) % وتبسمت لك عن ثنايا لم تشم % % عين كبارقها ولا كعقيقها % % 3(@)(@@) % وحبتك من رشفاتها بسلافة % ما فض مرتشف ختام رحيقها % % 4(@)(@@) % وتعطفت لك بانة غير الصبا % % لم يحض قبلك بانعطاف رشيقها % % 5(@)(@@) % ورنت بأجفان إليك فواتر % بأخي الهوى الدنيا تضيق لضيقها % % 6(@)(@@) % يا أهل رامة ما الجمال وما الهوى % % إلا لشائق ريمكم ومشوقها % % 7(@)(@@) % نفحتكم بعبيرها ريح الصبا % % ونحتكم ديم الحيا ببروقها % % 8(@)(@@) % فسقت ملاعبكم بأوطف تزدهي % % منه بزهر رياضها وأنيقها % % 9(@)(@@) % غيث بسيب ندى محمد صالح % تشبيه واكف سحبه ودفوفها % % 10(@)(@@) % هو خير من رضع المكارم درها % % ورعى بها مذ كان فرض حقوقها % % PageV01P278 11(@)(@@) % من مثله وهو ابنها البر الذي % % ما هم لمحة ناظر بعقوقها % % 12(@)(@@) % ملك تجلى للبرية فخره ال % % سامي تجلي الشمس عند شروقها % % 13(@)(@@) % فإذا تكرم كان فارج ضيقها % % وإذا تكلم كان ضيق حلوقها % % 14(@)(@@) % تفدي أنامله العريقة في الندى % % أيد من اللؤم انتساج عروقها % % 15(@)(@@) % ورث العلى من سابقين لغاية % ما للبرية مطمع للحوقها % % 16(@)(@@) % خلقت كراما فهي تقتسم الثنا % % والحمد بين جديرها وخليقها % % 17(@)(@@) % شرعت طريق الجود وهو مشى به % % فمشى الكرام وراءه بطريقها % % 18(@)(@@) % ولدته مم ( أبا الأمين ) فأحرزت % % بهما ثناء عدوها وصديقها % % 19(@)(@@) % بلغا السماء علا وزاد محمد % شرفا سما فيه على عيوقها % % 20(@)(@@) % أحيت أنامله العفاة ومن رأى % % لججا يكون بها نجاة غريقها % % PageV01P279 21(@)(@@) % كرم كغادية السحاب تزينه % لمعات بشر كالتماع بروقها % % 22(@)(@@) % يا من تفرع في الذرى من دوحة % تجنى المكارم من ثمار وريقها % % 23(@)(@@) % من دوحة الشرف الذي بثرى العلى % % وشجت قديما ساريات عروقها % % 24(@)(@@) % أهدى لك الفرح الإله مخلدا % وكساك من حلل الثنا برقيقها % % 25(@)(@@) % هذي المسرة كم أقرت أعينا % ولأعين كانت قذى في موقها % % 26(@)(@@) % وعد الزمان بأن يزيل بها جوى % % الأحشاء فاشاقت إلى تحقيقها % % 27(@)(@@) % خفقت بها شوقا وحين وفى بها % % سكنت وقرت بعد طول 
ms85	 خفوقها % % 28(@)(@@) % وغدا الزمان وقد ترشف راحها % % نشوان بين صبوحها وغبوقها % % 29(@)(@@) % فليهنينك سائغ الطرب الذي % % لك قد أغص الحاسدين بريقها % % 30(@)(@@) % واسعد بعرس محمد حسن العلى % % وأخي النهى عبد الحسين شقيقها % % PageV01P280 31(@)(@@) % داما بظلك رافهين ولم تزل % % تغلي حشاشة من أبى بحريقها % % 32(@)(@@) % فبنوك ثم بنو أخيك جميعهم % % تأوي الورى منهم لفارج ضيقها % % 33(@)(@@) % فإذا الخطوب تراكمت فالمصطفى % % يرجى لدفع جليلها ودقيقها % % 34(@)(@@) % وإذا لياليها دجت فمحمد ال % % هادي بطلعته انجلاء غسوقها % % 35(@)(@@) % ولدى أمين المجد حفظ عهودها % % إن خانها دهر بحل وثيقها % % 36(@)(@@) % أبني العلى ارتشفوا سلافة فرحة % أحلى من الصهباء في راووقها % % 37(@)(@@) % طاب السرور بها فقلت مؤرخا % وصل الأحبة عرسكم برحيقها % % PageV01P281 البحر : كامل تام 1(@)(@@) % وصلت وريعان الشبيبة مونق % وجفت وقد لبس المشيب المفرق % 2(@)(@@) % والغيد طوع نسيم ريعان الصبا % % يهتز غصن شبابهن المورق % % 3(@)(@@) % والشيب إن حطت عقاب نهاره % % فغراب ليلة وصلهن محلق % % 4(@)(@@) % أدرت فتاة الحي أني مذ نأت % % قلبي أسير هوى ودمعي مطلق % % 5(@)(@@) % أنا والجوى والدمع وهي ومهجتي % % طوع البعاد مغرب ومشرق % % 6(@)(@@) % عافت أخا دمعي العقيق وثغرها % % أمسى يضيء به أخوه الأبرق % % 7(@)(@@) % لله موقفنا صبيحة أجمعت % % بينا له جزعا بريقي أشرق % % 8(@)(@@) % ومسكت قلبي كي يقر وإنه % % ليكاد يلفظه الزفير فيحرق % % 9(@)(@@) % وكظمت أنفاسي الغداة وفوقها % % كادت مجامع أضلعي تتفرق % 10(@)(@@) % جاذبتها فضل الرداء فأقبلت % % بالعنف تجمع ما جذبت وأرفق % % PageV01P282 11(@)(@@) % ومذ استقل بها الفراق دعوتها % % بالدمع إذ هو من لساني أطلق % % 12(@)(@@) % الله ياذات النظاق بواجم % لسن المدامع عن جواه تنطق % % 13(@)(@@) % وتذكري عهد المودة بيننا % % أيام أوقاتي بلهوك تنفق % % 14(@)(@@) % متألفين بحيث لاظل الهوى % % صاح ولا صفو الوداد مرنق % % 15(@)(@@) % في روضة عذراء لم يبرح بها % % يمري مذانبه الغمام المغدق % % 16(@)(@@) % يسري النسيم عليلة أنفاسه % % فيها بنشر من عبيرك يعبق % % 17(@)(@@) % وعيون نرجسها المندى غازلت % % منك المحيا وو شمس تشرق % % 18(@)(@@) % فكأن في أجفانهن الطل من % % أنوار وجهك أدمع تترقرق % % 19(@)(@@) % ولهوت منك بذات خدر زانها % % ثوب الشباب 
ms86	 الغض لا الاستبرق % % 20(@)(@@) % طورا تعاطيني الحديث وتارة % راحا بها شمل الهموم يفرق % % PageV01P283 21(@)(@@) % قالت وقد عاقرتها من كفها % % صرفا لها نور يروق ورونق % % 22(@)(@@) % ألها نظير ، قلت خلق ( محمد % في لطفه منها أرق وأورق % % 23(@)(@@) % خلق لأبلج غير معقود الندى % % ديم الغمام غدت به تتخلق % % 24(@)(@@) % عذبت بفيه نعم فليس بغيرها % % يلقى الذي من جوده يسترزق % % 25(@)(@@) % ويد أن بكل منبت شعره % منه بقول نعم لسان ينطق % % 26(@)(@@) % أثرى من الحسب الكريم وكل من % % أثرى بلا حسب مقل مملق % % 27(@)(@@) % فانظر لمن عرب القوافي في الورى % % تنشى وأبكار المعاني تخلق % % 28(@)(@@) % ما فيهم إلا محمد صالح % بالمدح جيد علائه يتطوق % % 29(@)(@@) % المستجار من الزمان بظله % % إن جاء يرعد بالخطوب ويبرق % % PageV01P284 30(@)(@@) % والمستضاء بوجهه إن يدج من % % دهم الحوادث ليلهن الأورق % % 31(@)(@@) % ومسدد الآراء أسهم رأيه % % غرض القضايا الغامضات تطبق % % 32(@)(@@) % يقضان قد سبرت تجارب حزمه % % غور الزمان بأي فن يطرق % % 33(@)(@@) % إن أبهمت يوما مطالع شبهة % عمياء فيها الحق لا يتحقق % % 34(@)(@@) % يغشى نعاس الجهل تحت ظلامها % % بصر القلوب المدركات فتخفق % % 35(@)(@@) % فعمود صبح بيانه بضيائه % % غسق العمى لذوي البصائر يفلق % % 36(@)(@@) % وإذا تحيرت العقول بمشكل % صعب مجال الوهم فيه ضيق % % 37(@)(@@) % جمع العقول على الصواب بحجة % فيها احتمال الريب لا يتطرق % % 38(@)(@@) % فمن السكينة والوقار سكوته % % وله المقال الفصل ساعة سنطق % % 39(@)(@@) % وعلاؤه الآفاق ضقن بعظمها % % وبعظم معجزه البسيطة أضيق % % PageV01P285 40(@)(@@) % إما أقام فمنه طرف الناس في % % قرت بإنسانيهما عيناكما % % 41(@)(@@) % وبأي أرض قد سرى ففعاله % % عن أهلها عين الحوادث تطبق % % 42(@)(@@) % فالناس في جدواه شخص واحد % وبمدحه الدنيا جميعا تنطق % % 43(@)(@@) % ونداه لو سكتوا لنوه باسمه % % إن الندى لهو الخطيب المفلق % % 44(@)(@@) % وإذا ترادفت المحول تشعبت % % منه غمائم للبلاد تطبق % % 45(@)(@@) % وغدا يرف على البرية ظلها % % وبريق النعماء فيهم تغدق % % 46(@)(@@) % حتى تمج الأرض ماء نعيمها % % ريا وبالعشب الثرى يتشقق % % 47(@)(@@) % فتبيت حالية بوشي ربيعها % % ولساكنيها العيش غضا يونق % % 48(@)(@@) % منن تفوت الواصفين وإنما % % وصف الأنام ببعضها 
ms87	 يستغرق % % 49(@)(@@) % وإذا انتمى فلدوحة الشرف التي % % تنمو على مر الزمان وتورق % % PageV01P286 50(@)(@@) % وشجت قديما ساريات عروقها % % حيث المجرة نهرها يتدفق % % 51(@)(@@) % فاصولها فوق السما وفروعها % % شرفا إلى مالا نهاية تبسق % % 52(@)(@@) % وطريف علياه يريك تليدها % % فمن المكذب والطريف مصدق % % 53(@)(@@) % لا كالذي بين البرية أصله % % خر على علك اللسان يلفق % % 54(@)(@@) % ملك على أولى الزمان قبيله % بذوائب الشرف الرفيع تعلقوا % % 55(@)(@@) % طلبوا سماء المجد فابتدرت بهم % % تسموا قدامى عزهم وتحلق % % 56(@)(@@) % حتى ارتقوا أفلاكها وغدا لهم % % دون البرية غربها وتحلق % % 57(@)(@@) % وإلى انقطاع الدهر فخر علاهم % % أبدا بهالتها الرفيعة محدق % % 58(@)(@@) % فكفاهم فخرا بأن عشيرهم % % فيه وفي عبد الكريم معرق % % 59(@)(@@) % فهما معا كفا ندا وصلا بهم % % وهم لتاج العز قدما مفرق % % PageV01P287 60(@)(@@) % فرعا علاهم في حديقة مجدهم % % ما أثمراه طيب مستوسق % % 61(@)(@@) % ضربا بعرق واحد في طينة % هي من سواها في المكارم أسبق % % 62(@)(@@) % مثلان مهما راهنا في حلبة % فغبار شأوهما بها لا يلحق % % 63(@)(@@) % وبكف كل منهما ما برزا % % في السبق رهن ذوي المعالي يغلق % % 64(@)(@@) % كالعين تبلغ أختها الشأو الذي % % بلغته إن كل إلأيه تحدق % % 65(@)(@@) % يا نيري فلك المعالي من غدا % % لهما بكل سماء مجد مشرق % % 66(@)(@@) % % وعلى القذى أغضى الحسود المحنق % % 67(@)(@@) % فلقد تباشرت النفوس بأوبة ' ال % % هادي ' وجمع أنسها المتفرق % % 68(@)(@@) % وسما المكارم أشرقت لما بدا % % نور ( الحسين ) بأفقها يتألق % % 69(@)(@@) % قدما معا والسعد طائر يمنه % % غرد يرف عليهما ويرنفق % % PageV01P288 70(@)(@@) % ولئن تشوقت البلاد إليهما % % فألى لقائهما المعالي أشوق % % 71(@)(@@) % لا مس أيدي الراميات إلى منى % نصب ولا منها عقرن الأسوق % % 72(@)(@@) % فلكعبة البيت الحرام بكعبتي % % أمل العفاة سرت خفائف تعنق % % 73(@)(@@) % وبثقل أجرهما ثقيلات الخطا % % صدرت كأن لها الرواسي أوسق % % 74(@)(@@) % المحرمين وإن أحلا دائما % زهدا بما تهوى النفوس وتعشق % % 75(@)(@@) % فكأن كل مقام احتلا به % % حرم وحج كل يوم يخلق % % 76(@)(@@) % والركن يشهد أن كفهما التي % % استلمته لا إثم بها متعلق % % 77(@)(@@) % نحرا غداة النفر هديا قال لم % % ي~~قبل سواي 
ms88	 لو أن هديا ينطق % % 78(@)(@@) % وسرين من حرم الأله جوانحا % بهما إلى حرم البني الأينق % % 79(@)(@@) % بيت لو البيت استطاع لجاءه % % بالركن يسعى سعي من يتملق % % PageV01P289 80(@)(@@) % فالدهر فيه محرم فمقصر % والفخر فيه طائف فمحلق % % 81(@)(@@) % عكفا به يتمسكان فناشق % لثم الضريح ولاثم يتنشق % % 82(@)(@@) % واستقبلا حرم الوصي وإنه % % حرم الإله به الملائك تحدق % % 83(@)(@@) % وحمى يجير من السعير لأنه % % 84(@)(@@) % فاستشفعا لله فيه ويميما % % ناد بغير العز ليس يروق % % 85(@)(@@) % رفعت بأعلا ' الكرخ ' منه سرادق % بعلائها العيوق لا يتعلق % % 86(@)(@@) % جمع الصلاح على التقى أطرافه % وغدا لواء الفخر فيه يخفق % % 87(@)(@@) % فلتلبس الزوراء حلة زهوها % % فالعيش رغد والهنا مستوسق % 88(@)(@@) % أوما ترى كأس المسرة تجتلى % % لعشيرة الشرف الرفيع وتدهق % % 89(@)(@@) % عقدوا الندي وللوفاء محبهم % % ينشي المديح مهنيا وينمق % % PageV01P290 90(@)(@@) % والزهر من أبنائهم ما بينها ال % % ندب ' الرضا ' في خلقه تتخلق % % 91(@)(@@) % قد أحدقت منه بأزهدها كما % % تمسي بأزهرها الكواكب تحدق % % 92(@)(@@) % تسمو لو احظهم إليه مطرقا % وإذا سمت منه اللواحظ تطرق % % 93(@)(@@) % لو أنصفته الكاشحون بنعله % % لتتوجوا ويبشعها لتمنطقوا % % 94(@)(@@) % عبقت شمائله فما ريا للصبا % % ممطورة الأنفاس منها أعبق % % 95(@)(@@) % وجلت محيا الدهر بهجة وجهه % % فارتد وهو من النضارة مشرق % % 96(@)(@@) % وجه يلوح عليه عنوان النهى % % ويروق فيه من الطلاقة رونق % % 97(@)(@@) % ومن الخلال الصالحات قد احتوى % % مجموع ما هو في الورى متفرق % % 98(@)(@@) % فبعزه صرف الزمان مقيد % وبجوده جود العفاة مطوق % % 99(@)(@@) % أمراهنيه في الفخار وراءكم % % عمن إذ ابتدر المدى لا يلحق % % PageV01P291 100(@)(@@) % ودعوا الندى فله محمد جعفر % يسقي رياض المكرمات فتورق % % 101(@)(@@) % ضرغام هيجاء إذا ذكر اسمه % % في يوم روع للجموع تفرقوا % % 102(@)(@@) % خلقت أنامل راحتيه أبحرا % يروي بها طورا وطورا يغرق % % 103(@)(@@) % نشأت لهن غمائم بين الورى % % عشر بوادقها تضيء وتحرق % % 104(@)(@@) % في السلم وابلها النضار وإنما % % في الحرب وابلها دم يتدفق % % 105(@)(@@) % ولها تبسمه بريق في الندى % % وبسيفه يوم الكريهة تبرق % % 106(@)(@@) % لو قيل يوم الروع من ترب الوغى % % لأشار من بعد إليه الفليق % % 107 
ms89	(@)(@@) % أو قيل أي الناس أسبق للندى % % قلنا ' محمد الجواد ' الأسبق % 108(@)(@@) % لجج أسرة راحتيه ووجهه % % منه سهيل طالع يتألق % % 109(@)(@@) % فاعجب لأنضاء الوفود وأنسها % % بسناه إن وردت وليست تفرق % % PageV01P292 110(@)(@@) % ملأ الزمان فواضلا وفضائلا % بهما يكل من الفصيح المنطق % % 111(@)(@@) % يا من رباعهم غدت مملوة % بالوفد من كل الأماكن تطرق % % 112(@)(@@) % فتحوا لهم باب السماح بهن في % % زمن به باب السماحة مغلق % % 113(@)(@@) % قد زف فكري من عقائله لكم % % عذراء ليس لغيركم تتشوق % % 114(@)(@@) % أضحت بجيب الدهر جونة عنبر % % في نشر ذكركم تضوع وتعبق % % 115(@)(@@) % جاءت كما اقترح الوفاء وإن يكن % % كثر القصيد فغيرها لا يعشق % % 116(@)(@@) % وترى الوفا نفس الكريم لأهله % % فرضا ولو بأدائه هي تزهق % % 117(@)(@@) % وتمجه نفس اللئيم ولو لها % % ما دمت بالعسل المصفى تلعق % % PageV01P293 البحر : خفيف تام 1(@)(@@) % أين في عصرنا نرى لك مثلا % % جئت بعدا ففقت من جاء قبلا % % 2(@)(@@) % كلما قد بلغت غاية فضل % زدت جدا فزادك الله فضلا % % 3(@)(@@) % وإذا قيل بعض جدك هذا % % لك كل الفضل انتهى قلت كلا % 4(@)(@@) % لم تزل هكذا تجد إلى أن % % قيل مهلا لك انتهى الفضل كلا % 5(@)(@@) % نلت أقصى العلى وتبغي مزيدا % عز من هكذا براك وجلا % 6(@)(@@) % لو على قدرك اتخذت خليلا % لا اتخذت الهلال في الأفق خلا % 7(@)(@@) % أيما خصلة من المجد عنت % % لم تفز منم قداحها بالمعلى % % 8(@)(@@) % قد بحثت العلوم فنا ففنا % % وبها قد أحطت عقلا ونقلا % % 9(@)(@@) % وشحنت الزمان هديا ونشكا % % وقضيت الحقوق فرضا ونفلا % % 10(@)(@@) % فإلى أين عنك يبغي انحراف % ضل من لا يراك لله ظلا % PageV01P294 11(@)(@@) % أيها المقتفي الأئمة لا تخطئ % % قولا لهم ولم تعد فعلا % % 12(@)(@@) % قل لمن يدعي النيابة عنهم % % هكذا عنهم يناب وإلا % 13(@)(@@) % أنت ياكعبة إليها الرجا حج % ويا قبلة لها المدح صلى % % 14(@)(@@) % مشعر الحق مستجار ذوي الحق % ومن لم يقل بما قلت ضلا % 15(@)(@@) % فيك لو أعطيت مناها الثريا % % لتمنت بأن ترى لك نعلا % % 16(@)(@@) % يا وقور الندي جئت بجيل % خيرهم في نديه 
ms90	 طاش جهلا % % 17(@)(@@) % ما عسى أن يقول فيك مريب % صقلت عرضك المكارم صقلا % % 18(@)(@@) % لك أفدي معذبا بمعاليك % % إليها يمد باعا أشلا % 19(@)(@@) % يتعالى بجهله وهو يدري % % أن من مفرقيه كعبك أعلى % % 20(@)(@@) % لو رأى الليث كيف رشحت أشبا % % لك لارتاح أن يرى لك شبلا % % PageV01P295 21(@)(@@) % غررا قد نجلتها ليس ترضى % % معها البدر ينتمي لك نجلا % % 22(@)(@@) % طبت نسلا وكنت أزكى المج % % د وما كل من زكى طاب نسلا % % 23(@)(@@) % سرجا للعلى ولدت وكل % كم له من نهار فخر تجلى % % 24(@)(@@) % لك خلق لو ذاقه مجتني النحل % دعى ما جنيت ما عشت نحلا % % 25(@)(@@) % ذاك للذائقين حلو وهذا % % في فم الذوق منه أحلا وأحلا % % 26(@)(@@) % خفة الروح لا كأخلاق قوم % أبدا في الأرواح تحدث ثقلا % % 27(@)(@@) % هو روض النهى وقد جعل الله % % له منك رائق البشر طلا % 28(@)(@@) % قد لعمري حملت أعباء جود % لو بها الدهر يستقل لكلا % 29(@)(@@) % ومن الرمل لو عطاؤك يعطى % % نفذ الرمل من يديه وملا % 30(@)(@@) % لقد اختط دارك المجد للحمد % % وفيها الندى ترعرع طفلا % % PageV01P296 31(@)(@@) % منه جيد المحب يلبس طوقا % ويد الكاشحين تحمل غلا % 32(@)(@@) % دم شكيم المصاقع اللد واسلم % % شرقا للخصيم تنطق فصلا % % 33(@)(@@) % بلسان يريه نضنضة الصل % فيغضي كيلا يساور صلا % 34(@)(@@) % أمطرتنا يداك طلا ووبلا % فوردنا نداك نهلا وعلا % 35(@)(@@) % بهدايا يديك أقسم لا أيدي % % الهدايا يرمين نحو المصلى % % 36(@)(@@) % لجديرا أراك في أن أهنيك % % بمن نبت عنه قولا وفعلا % % 37(@)(@@) % ولأحلا الأيام يوم يد الله % % به سلت الحسام المحلى % % 38(@)(@@) % يوم بعث لمن سيبعث فيه % % مالئ المشرقين قسطا وعدلا % % 39(@)(@@) % ذاك من كان قربه قاب قوسين % من الله إذ دنى فتدلى % % 40(@)(@@) % والبشير الذي به قسم الله % % على العالمين لطفا وفضلا % % PageV01P297 41(@)(@@) % هو للخير كان أصلا وفرعا % وله الخير كان فرعا وأصلا % % 42(@)(@@) % أيها المجزل الوهوب سماحا % هاك نظما كجود كفيك جزلا % % 43(@)(@@) % بل كعلياك خذه ممتنعا صعب % منال ومثل خلقك سهلا % % 44(@)(@@) % زف بكرا كفاك فيها هديا % % لك تجلى وحسبها 
ms91	 بك بعلا % % PageV01P298 البحر : سريع 1(@)(@@) % زارت على رقبة عذالها % % فاقتبل العمر باقبالها % % 2(@)(@@) % طيبة الأردان ما استجمرت % % بالمندل الرطب كأمثالها % % 3(@)(@@) % تدني الجلابيب لتخفي لها % % ما رسم المشي بأذيالها % % 4(@)(@@) % وكيف تخفى وكثيب الحمى % % يأرج من فضلة سروالها % % 5(@)(@@) % فانعم بعطشى الخصر ريا الصبا % % مجدولة الأعطاف مكسالها % % 6(@)(@@) % وارشف كما شاء الهوى ريقة % كانت تمنيك بسلسالها % % 7(@)(@@) % أحبب بها من شائق واله % أحيت مشوقا بالحمى والها % % 8(@)(@@) % غيداء لو غنت لريم الفلا % % ما بكرت تعطو إلى ضالها % % 9(@)(@@) % جاءت ولكن كمجيىء الكرى % % تكاتم الغيران من آلها % % 10(@)(@@) % يا طرب الصب لإنسانة % لم تكن الحور بأبدالها % % PageV01P299 11(@)(@@) % كم زادني العذل ولوعا بها % % ما أولع النفس بقتالها % % 12(@)(@@) % يهزها الدل فتختال عن % % معتدل القامة ميالها % % 13(@)(@@) % ترقص قلب الصب مهما مشت % % لكن على رنة خلخالها % % 14(@)(@@) % ذات الجعود السود معقوصة % تحكي الأفاعي عند إرسالها % % 15(@)(@@) % هل نثرت مسكا على كثبها % % إذ عبقت دلا بإسبالها % % 16(@)(@@) % أم علقت في خدها جمرة % فاحترق العنبر من خالها % % 17(@)(@@) % يا هل طرقت الحي قد حجبت % % معسولة الريق بعسالها % % 18(@)(@@) % أم رئال بين أبياتهم % % يا عجبا تحمى برئبالها % % 19(@)(@@) % تلك الخصور الهيف وارحمتا % % لضعفها من ثقل أكفالها % % 20(@)(@@) % هيمت الصب وقالت له % % صل الغديات بآصالها % % PageV01P300 21(@)(@@) % نفسك للإطراب دعها فقد % % مالت إلى الزهو بآمالها % % 22(@)(@@) % إجر بكفيك كميت الطلى % % واجل صدى الهم بجريالها % % 23(@)(@@) % فروضة الأفراح قد طلها % % ببشره ' جعفر ' إفضالها % % 24(@)(@@) % من جمعت فيه العلى هاشم % وافترقت منه إلى آلها % % 25(@)(@@) % قد وزنت قنطار أهل الندى % % همته لكن بمثقالها % % 26(@)(@@) % يبسط أخت السحب لكن يدا % تهزء بالجود بهطالها % % 27(@)(@@) % إيها ( أبا موسى ) لأنت الذي % % قد رشح الأسد لأغيالها % % 28(@)(@@) % ضرغام فهر وحقيق بأن % % طرا تهنيك بأشبالها % % 29(@)(@@) % لي من ' حسين ' أي ريحانة % قد أينعت منك باخضالها % % 30(@)(@@) % أنميت لي في عرسه نبعة % عنك ستروي طيب أفعالها % % PageV01P301 31(@)(@@) % فاسمع فداك الدهر من قائل % % تهنية طابت كقوالها % % 32(@)(@@) % في عرس ( هاد ) سبقت نعمة % بشرى لك اليوم بإكمالها % % 33 
ms92	(@)(@@) % تلك التي قرت عيون العلى % % والفضل فيها يابن مفضالها % % 34(@)(@@) % وفي السما قد قام ( جبريلها % % يهدي شذا البشر ( لميكالها ) % 35(@)(@@) % والأرض من نوء الهنا أغدقت % % فروضت من بعد إمحالها % % 36(@)(@@) % فخرا جبال الحلم لولاكم % % ما قرت الأرض لزلزالها % % 37(@)(@@) % أسرة مجد كوفئت في العلى % % أعمالها الغر بأخوالها % % 38(@)(@@) % معذولة الأيدي على جودها % % والغيث فيه بعض عذالها % % 39(@)(@@) % تنمى إلى القائم بين الورى % % برشدها أو حمل أثقالها % % PageV01P302 40(@)(@@) % ما هو إلا آية للهدى % % قد شرف الروح بأنزالها % % 41(@)(@@) % بل هو في لأمة مهديها % % وحبه صالح أعمالها % % 42(@)(@@) % للرشد أبواب وأبناؤه % % كانوا المفاتيح لأقفالها % % 43(@)(@@) % هم أنجم العلم التي كم جلت % % عن الورى ظلمة أشكالها % % 44(@)(@@) % داموا ببال فاره في النهى % % أبقى أعاديهم ببلبالها % % PageV01P303 البحر : رمل تام 1(@)(@@) % فاخري أيتها الدار النجوما % % هن في الضوء ، وفي الجو الغيوما % % 2(@)(@@) % ونعم أنت بآل المصطفى % % معدن الفخر حديثا وقديما % % 3(@)(@@) % لم تلد أم المعالي منهم % % فيك إلا واضح الوجه كريما % % 4(@)(@@) % معشر طابوا فروعا في العلى % % وزكوا في طينة المجد أروما % % 5(@)(@@) % فقد المعروف إلا عندهم % % وغدا الدهر وحاشاهم لئيما % % 6(@)(@@) % وكفاهم ( بأبي المهدي ) فخرا % حيث أضحى لهم اليوم زعيما % % 7(@)(@@) % المحيا عند بذل الجود وجها % صاحيا ، والمرتجى كفا مغيما % % 8(@)(@@) % تخجل المزن إذا ساجلها % % بيد أرطب منهن أديما % % 9(@)(@@) % وتموت الشهب إن قابلها % % بمحيا يكشف الليل البهيما % % 10(@)(@@) % ليم في الجود ، ولا جود لمن % % لم يكن بين الورى فيه ملوما % % PageV01P304 11(@)(@@) % وكريم الطبع من لم يتغير % % طبعه في عذل من أضحى لئيما % % 12(@)(@@) % ليس يثني الغيم عذل فمتى % % ينثني من علم الجود الغيوما % % 13(@)(@@) % همم لو عن مدى زاحمها % % منكب الدهر لردته حطيما % % 14(@)(@@) % عاد مرعى الفضل مخضرا به % % وهو لولا جوده كان هشيما % % 15(@)(@@) % تحمد الناس فان جاء به % % لم نجد أحمدهم إلا ذميما % % 16(@)(@@) % ما بصلب الدهر يجري مثله % % إذ على ميلاده صار عقيما % % 17(@)(@@) % هو في أجفانه ثاني الكرى % % قرة العينين منه أن يدوما % % 18(@)(@@) % من أناس ركبوا ظهر العلى 
ms93	 % % وجروا في حلبة الفخر قديما % % 19(@)(@@) % هم أقاموا عمد العليا وهم % شرعوا فيها الصراط المستقيما % % 20(@)(@@) % ذهبوا بيض المجالي طيبي % % عقد الأزر مصاعيبا قروما % % PageV01P305 21(@)(@@) % وتبقوا من بنيهم لعلاهم % % زينة في نحرها عقدا نظيما % % 22(@)(@@) % كأبي الهادي ذي الفضل ومن % % في معاليه لهم كان قسيما % % 23(@)(@@) % ذلك الندب أخوه من برا % % ه ربه من عنصر المجد كريما % % 24(@)(@@) % ورضى العليا ومن غير الرضا % % من عظيم يدفع الخطب العظيما % % 25(@)(@@) % ذكره بين الورى يهدي شذا % عطرت نفحة رياه النسيما % % 26(@)(@@) % وأخيه مصطفى الفخر الذي % % لم تزل طلعته تجلو الهموما % % 27(@)(@@) % وكنجم الشرف الهادي إلى % % بيت جدواه لمن نص الرسوما % % 28(@)(@@) % وأمين ذي النهى من لم يزل % % سالكا نهجا من التقوى قويما % % 29(@)(@@) % كرماء لا تبارى كرما % حلماء تزن الشم حلوما % % 30(@)(@@) % كم دعتهم للقوافي ألسن % تركت قلب أعاديهم كليما % % PageV01P306 31(@)(@@) % يا نجوما في سما المجد زهت % % ويسر المجد قولي يا نجوما % % 32(@)(@@) % للعلى أنتم مصابيح كما % % لشياطين العدى كنتم رجوما % % 33(@)(@@) % قد أقر الله منكم أعينا % كم لحظتم بالغنى فيها عديما % % 34(@)(@@) % وحباهم فرحة تشملهم % % والمحبين خصوصا وعموما % % 35(@)(@@) % ذهب الروع الذي غم وقد % % جاءت البشرى التي تنفي الغموما % % 36(@)(@@) % واستهل السعد في أبياتكم % % فاكتست من حلل الزهور قوما % % 37(@)(@@) % بالفتى ' عبد الكريم ' المجتبي % % وأمين الفضل من طاب أروما % % 38(@)(@@) % قد لعمري سنن الحج لها % % ما رأت مثلهما أمس مقيما % % 39(@)(@@) % قيل نخشى لهما يدنو البلى % % قلت لا يدنو وإن كان عظيما % % 40(@)(@@) % فهما من أسرة في برهم % % يدرء الخطب وإن كان جسيما % % PageV01P307 41(@)(@@) % فحجيج البيت لما أنزل الله % % فيهم ذلك الرجز الأليما % % 42(@)(@@) % فعن الباقين منهم كرما % بهما قد صرف الريح العقيما % % 43(@)(@@) % فحطيم البيت لو لم يشهداه % % كل من قد أمه أضحى حطيما % % 44(@)(@@) % آل بيت المصطفى حيتكم % غادة تجلو لكم وجها وسيما % % 45(@)(@@) % أقبلت زهوا تهنيكم بما % % زاد من يحسد علياكم وجوما % % 46(@)(@@) % فبقيتم في سرور أبدا % ولكم لا برح السعد نديما % % PageV01P308 البحر : بسيط تام 1(@)(@@) % يا جوهر 
ms94	 المجد بل يا جوهر الكرم % أمنت من عرض الآلام والسقم % 2(@)(@@) % ولا أصابك داء يا شفاء بنيم % % الآمال من مرض الإقتار والعدم % 3(@)(@@) % أنت الذي تتداوى الناس قاطبة % في خصب نائله في شدة القحم % % 4(@)(@@) % لا غرو أن شكت الدنيا وساكنها % % داء أجارك منه بارئ النسم % % 5(@)(@@) % فالدهر أنت له روح مدبرة % ويؤلم الجسم ما بالروح من ألم % 6(@)(@@) % واليوم بشرى لنا صحت بصحتك ال % % دنيا وزالت غواشي الهم والغمم % 7(@)(@@) % وأصبحت أوجه الأيام مسفرة % من البشاشة تجلو ثغر مبتسم % 8(@)(@@) % نعم وعين المعالي قر ناظرها % % إذ برء إنسانها من أكبر النعم % % 9(@)(@@) % برؤ ولكنه منا لكل حشا % حوت على الود قلبا غير متهم % 10(@)(@@) % وصحة وشفاء وانتعاش قوى % لكن لنفس العلى والمجد والكرم % PageV01P309 11(@)(@@) % أما ومجدك يابن المصطفى قسما % من عالم إن هذا أعظم القسم % 12(@)(@@) % لقد غدا بشفاك الدين مبتهجا % لعلمه ماله إلاك من علم % 13(@)(@@) % لله برؤك من شكوى بها لك دا % % م الأجر وهي بحمد الله لم تدم % 14(@)(@@) % آل النبي بها كانوا أسر أم النبي % بل شرع هم في سرورهم % 15(@)(@@) % وهل بدعوة أهل الأرض أم بدعا % % أهل السما عنك زالت أم بكلهم % % PageV01P310 البحر : بسيط تام 1(@)(@@) % إن قلت عذرا لها ما أبطأت سأما % % فرب معتذر يوما وما اجترما % % 2(@)(@@) % وكيف تسأم من إهداء تهنية % كم عللت قبل فيها المجد والكرما % % 3(@)(@@) % كانت تمنى على الله الشفا لأبي ال % % هادي لتملأ أكباد العدى ضرما % % 4(@)(@@) % بكل سيارة في الأرض ما فتحت % % بمثلها أبدا أم القريض فما % % 5(@)(@@) % تشع فهي لعين كوكب شرق % وجمرة لحشا في نادها وسما % % 6(@)(@@) % فهل تظن ورب العرش خولها % % ما قد تمنت وذاك الداء قد حسما % % 7(@)(@@) % ينام منها لسان الشكر عن سأم % إذا لساني حتفا نام ، لا سئما % % 8(@)(@@) % سائل بها الشرف الوضاح هل كفرت % % نعماه أو عبدت من دونه صنما % % 9(@)(@@) % لا ينقم المجد منها أنها خفرت % % في خير عترته يوما له ذمما % % 10(@)(@@) % لكنها لهناة عن ولادتها % % طروقة 
ms95	 الفكر حالت ، لا الوفا عقما % % PageV01P311 11(@)(@@) % وقد تحيل لقاحا طالما نتجت % % واستقبل الحي من إنتاجها النعما % % 12(@)(@@) % بكر من النظم لم يثقب لئالئها % % فكر ولا فوق نحر مثلها نظما % % 13(@)(@@) % مولودة في ثياب الحسن ، قد رضعت % % در النهى في زمان عنه قد فطما % % 14(@)(@@) % قد أقبلت وطريق الحسن متسع % تضيق خطوا وإن لم تقترف جرما % % 15(@)(@@) % ما قدمت قدما تبغي الوصول بها % % إلا وأخرها تقصيرها قدما % % 16(@)(@@) % حتى ألمت بأكناف الذين بهم % % عن الولي يحط الخالق اللمما % % 17(@)(@@) % قوم يؤدب جهل الدهر حلمهم % % حتى ترى الدهر بعد الجهل قد حلما % % 18(@)(@@) % وجودهم يتداوى المسنتون به % % ما اعتل بالجدب عام بالورى أزما % % 19(@)(@@) % فكيف مرت شكاة ساورت لهم % عضوا من المجد سر المجد إذ سلما % % 20(@)(@@) % أبكت وأضحكت العلياء والكرما % % روعاء قطب فيها الدهر وابتسما % % PageV01P312 21(@)(@@) % دجت ببؤس فلم تبرح تضاحكها % % بوارق اللطف حتى أمطرت نعما % % 22(@)(@@) % أمت قليلا وهبت في جوانحها % % من الدعاء قبول فانجلت أمما % % 23(@)(@@) % أضحي طريفا لنا نشر السرور بها % % لنشرنا ذلك البشر الذي قدما % % 24(@)(@@) % مسرة لأبي الهادي أعاد بها % % برء الحسين لنا العهد الذي قدما % % 25(@)(@@) % إذ قد جنى الدهر ما لم تستطع معه % نشر المسرة لكن راجع الندما % % 26(@)(@@) % فأتبع الفرحة الأولى بثانية % لم تبق في الأرض لا غما ولا غمما % % 27(@)(@@) % فأرشف المجد في كلتيهما طربا % راح التهاني وقرط سمعه نغما % % 28(@)(@@) % وقل - وإن صم سمع من أخي حسد % فسرني أنه ما فارق الصمما - % 29(@)(@@) % ليهنك النعمة الكبرى أبا حسن % في صحة لم تدع في مهجة سقما % % 30(@)(@@) % أنت الذي رمقت عين الرشاد به % % فما رأت بك يا إنسانها ألما % % PageV01P313 31(@)(@@) % وقد صبرت وكان الصبر منك رضى % % عن الإله وتسليما لما حكما % % 32(@)(@@) % أصالح أنت أم أيوب بل قسما % بما تحملت من ضر : لأنت هما % % 33(@)(@@) % وهبك لم تك مبعوثا كما بعثا % % فقد ورثت بحمد الله ما علما % % 34(@)(@@) % سقم وما مسك الشيطان فيه لقد % % حكيت أيوب صبرا عندما سقما % % 35(@)(@@) % حتى علمنا 
ms96	 بأن الابتلاء به % % ما للنبيين عند الله للعلما % % 36(@)(@@) % آل الأله أقر الله أعينكم % بالمبكيين عيون الحاسدين دما % % 37(@)(@@) % بشرا فتلك يد البشرى ببرئهما % % مرت على جرح قلب الدين فالتحما % % 38(@)(@@) % كانت ولكن لقلب الدهر موجعة % كادت مضاضتها تستأصل النسما % % 39(@)(@@) % قد ود أهل السما والأرض أن لكم % % ثوابها وعليهم داؤها انقسما % % 40(@)(@@) % لقد أعاد على ' الفيحاء ' فضلكم % شبابها بعد ما قد عنست هرما % % PageV01P314 41(@)(@@) % كم ابن فهد غدا فيها لعدة دا % % عيكم وكم لأياديكم من ابن نما % % 42(@)(@@) % نضيتم للمقال الفصل ألسنة % لو تقرع السيف يوما صدره انثلما % % 43(@)(@@) % رياسة في الهدى أنتم أحق بها % % من كان جاذبكم أبرادها أثما % % 44(@)(@@) % حيث الأمامة من مهديها نصبت % % لها النبوة في أحكامها علما % % 45(@)(@@) % من قابض ورعا عن كل مشتبه % أناملا لم تزل مبسوطة ديما % % 46(@)(@@) % مولى هو الكعبة البيت الحرام لنا % % أضحى وأضحت بنوه الأشهر الحرما % % 47(@)(@@) % قوم هم علماء الدين سادة خلق % الله أكرم من فوق الثرى شيما % % 48(@)(@@) % هم البدور أنار الله طلعتها % % لها الكواكب قلت أن ترى خدما % % 49(@)(@@) % من طينة أبدا تبيض عن كرم % ما اسود طين رجال في الورى لؤما % % 50(@)(@@) % اليكموها هداة الخلق باهرة % لسانها قال فيكم بالذي علما % % PageV01P315 51(@)(@@) % إن أنس فيكم زهيرا بالثناء لكم % % فأنتم لي قد أنسيتم ' هرما ' % PageV01P316 البحر : رجز تام 1(@)(@@) % أسفرت الأيام عن مرأى حسن % % وسعدها الطالع باليمن اقترن % % 2(@)(@@) % وأصبح الزمان وهو لابس % نشوة زهو ربحت عطف الزمن % % 3(@)(@@) % وروضة الأفراح في الكرخ زهت % % فكل مغنى من مغانيها أغن % % 4(@)(@@) % وطائر البشر غدا مغردا % يبدي فنون سجعه على فنن % % 5(@)(@@) % يا سعد ما أبهجها مسرة % بها أقام السعد والنحس ظعن % % 6(@)(@@) % خصت زعيم آل بيت المصطفى % % وعمت العالم من إنس وجن % % 7(@)(@@) % سرهم سروره كأنما % % لديهم بشراه من أعلى المنن % % 8(@)(@@) % لأنه دام علاه في الورى % % محبب إذ كل ما فيه حسن % % 9(@)(@@) % محمد ليس سواه صالح % على كنوز المكرمات يؤتمن % % 10(@)(@@) % لا تعدلن عنه في قافية % وإن 
ms97	 بها عدلت عنه فلمن % % PageV01P317 11(@)(@@) % تالله لولاه لما بضاعة % من القوافي نفقت بذا الزمن % % 12(@)(@@) % يسني لها أثمانها مستحييا % ولو يميح نفسه مع الثمن % % 13(@)(@@) % هذا الذي تضمنت أبراده % % منه فتى أطهر من ماء المزن % % 14(@)(@@) % هذا الذي تقوم المجد به % % فشخصه والمجد روح وبدن % % 15(@)(@@) % أين بنو العلياء من محله % % يا بعد ما بين الوهاد والقنن % % 16(@)(@@) % مولى غدا أمراه أحلى لذة % % حتى إلى عين العدى من الوسن % % 17(@)(@@) % قد لقبت راحته أم الندى % % لآن منها كان ميلاد المنن % % 18(@)(@@) % ترتضع الآمال من أخلافها % % در الندى الغزير لا در اللبن % % 19(@)(@@) % فليهنه اليوم ختان نجله % % فانه أيمن مولود ختن % % 20(@)(@@) % قد ولدته كاملا أم العلى % % وفي زيادة ونقص لم يشن % % PageV01P318 21(@)(@@) % ثم فلم يختنه إلا سنة % أدامه الله لإحياء السنن % % 22(@)(@@) % وليهن فيه عمه من لم تكن % % بشأوه تعلق أمجاد الزمن % % 23(@)(@@) % ندب يعد الفخر ثوب مدحه % % إن عده سواه ثوبا من عدن % % 24(@)(@@) % وليبتهج فيه الرضا شقيقه % من لا يشوب منه يوما بمن % % 25(@)(@@) % ومن كساه الفضل أبهى حلة % رحيضة الأردان من كل درن % % 26(@)(@@) % وليزه فيه مصطفى المجد الذي % % بغير أبكار المعالي ما افتتن % % 27(@)(@@) % مبارك الطلعة ما صبحه % ذو محنة إلا جلا عنها المحن % % 28(@)(@@) % وليسعد الهادي به من لم تحط % % في وصف معناه دقيقات الفطن % % 29(@)(@@) % مصدق الظنون حيث لا ترى % % لآمل يصدق المأمول ظن % % 30(@)(@@) % يا أيكة للفضل منها كم شدت % % ورق القوافى بالثنا على غصن % % PageV01P319 31(@)(@@) % لا برحت بيوت عليائكم % وهي لكم وللمسرات وطن % % 32(@)(@@) % واليوم لابتهاجكم أبهجت ال % % دنيا وزال الكرب عنها والحزن % % 33(@)(@@) % وعاد وجه الكرخ حين أرخوا % % ختان أزهاها محمد حسن % % PageV01P320 البحر : سريع 1(@)(@@) % دار بذي الأثل عهدناها % % ما أطيب العيش بمغناها % % 2(@)(@@) % فاسأل بها أروى الغوادي حيا % وروح القلب بذكراها % % 3(@)(@@) % دار بها كانت لأهل الهوى % % تهدي بنات الشوق حوراها % % 4(@)(@@) % ناشئة الظل تربى بها % % عواطف الصبوة أبناها % % 5(@)(@@) % من كل عذري الهوى ، قلبه % يرف مارف عذاراها % % 6(@)(@@) % آه 
ms98	 لاحشاء على رامة % % قد ذهبت إلا بقاياها % % 7(@)(@@) % رقت إلى أن بين أيدي الجوى % % تساقطت ضعفا شظاياها % % 8(@)(@@) % أيام تستقطر من لمتي % % ماء الصبا الغض عذاراها % % 9(@)(@@) % ووفرتي منها بأيدي المها % % طاقة ريحان تهاداها % % 10(@)(@@) % يا حبذا الغيد ودار بها % % في ريق العمر علقناها % % PageV01P321 11(@)(@@) % جرت بها ضمياء أردانها % % فأرجت بالطيب أرجاها % % 12(@)(@@) % حيث نشاوى بكؤوس الهوى % % أماتها الشوق وأحياها % % 13(@)(@@) % وافت وعمر الدهر في ليلة % فينا هي العمر عددناها % % 14(@)(@@) % رقت لنا فيها حواشي الدجى % % لكن ببرق من ثناياها % % 15(@)(@@) % ولائم ، والراح من خدها % % تديره للسكر عيناها % % 16(@)(@@) % قال عليك الوزر في نعتها % % قلت وخذ أنت مهناها % % 17(@)(@@) % لا ذم للوردة عندي سوى % % عادة دهر ما تعداها % % 18(@)(@@) % لمجتنيها شوكها والشذا % % منها لمن لم يدر مجناها % % 19(@)(@@) % يا دهر ما أطربها ليلة % عن غفلة منك سرقناها % % 20(@)(@@) % فيها عقدنا مجلسا للهنا % % لا لكؤوس نتعاطاها % % PageV01P322 21(@)(@@) % ننشر للأشواق ديباجة % من غزل رق ، نسجناها % % 22(@)(@@) % ونسمة الأسحار قد فاكهت % % بطيب أنفاس نداماها % % 23(@)(@@) % فاردد عليها من أحاديثها % % ما نقلته عن خزاماها % % 24(@)(@@) % وحيها ناقلة قد روت % % عن خلق المهدي رياها % % 25(@)(@@) % تسند ما ترويه عن عبقة % من شيبة الحمد انتشقناها % % 26(@)(@@) % للفضل أرباب وكل له % % مزية يسمو بعلياها % % 27(@)(@@) % والفضل كل الفضل في عصرنا % % لجامع كل مزاياها % % 28(@)(@@) % للخلف ابن الحسن القائم ال % % مهدي أتقى الخلق أهداها % % 29(@)(@@) % يا واحد الدهر بلا مشبه % تركت كل الناس أشباها % % 30(@)(@@) % علمك إلهام وكل الورى % % كسب ومن بيتك وافاها % % PageV01P323 31(@)(@@) % كم لك من عارفة حرة % ألسنة الشكر أرقاها % % 32(@)(@@) % جودك طوفان وسفن الرجا % % باسمك مجراها ومرساها % % 33(@)(@@) % مكارم مسموعها في الندى % % أعظم منه فيه مرآها % % 34(@)(@@) % لو قيل للغيث انتسب للورى % % مثلك جودا ما تعداها % % 35(@)(@@) % لا شرقت في دم أوداجها % % عيدية حنت لمسعاها % % 36(@)(@@) % وارتبعت في كل مطلولة % خمائل الروض بجرعاها % % 37(@)(@@) % تخضم أما شيحة أو إلى % % بشامة تدنو فترعاها % % 38(@)(@@) % جزاء ما خفت بتلك التي % % قد ثقلت بالأجر مسراها % % 39(@)(@@) % كريمة الشيخ 
ms99	 إمام الهدى % % خير كريمات الهدى جاها % % 40(@)(@@) % لا بل هي الكعبة في سترها % % تنقلها نحو مصلاها % % PageV01P324 41(@)(@@) % قد قال إكبارا لها إذ مشت % % لا صغر الرحمن ممشاها % % 42(@)(@@) % لو أن حواء رأت زهدها % % والزهد من بعض سجاياها % % 43(@)(@@) % ودت على كثر بنات لها % % أن لم تلد منهن إلاها % % 44(@)(@@) % لم تعلق الآثام فيها ولا % % بالتبعات اغبر كفاها % % 45(@)(@@) % طهرها الرحمن علما بها % % وبالتقى والنسك زكاها % % 46(@)(@@) % نزهت العصمة أفعالها % % وكانت العصمة تقواها % % 47(@)(@@) % لو قسمت صالح أعمالها % % بين بني الدنيا لأغناها % % 48(@)(@@) % كل ألوف الخدر في خدرها % % لم تعرف التخدير لولاها % % 49(@)(@@) % باه بها أم نجوم السما % % وفاخر الشهب بأبناها % % 50(@)(@@) % إذ هي أم الكلمات التي % % آدم من قبل تلقاها % % PageV01P325 51(@)(@@) % قد أوشجت أعراقها في العلى % % من فاطم أعراق علياها % % 52(@)(@@) % نمت غصونا كلها أثمرت % % علما به الله توخاها % % 53(@)(@@) % عن مثلها ما انشق يوما ثرى % % نبوة فاسأل سجاياها % % 54(@)(@@) % من طينة المجد إلى المرتضى % % وجعفر يضرب عرقاها % % 55(@)(@@) % للجعفريين ابتنت دارها % % بيض المساعي فوق خضراها % % 56(@)(@@) % هم أنجم الدين وسبحان من % % في أفقه للرشد أبداها % % 57(@)(@@) % أسرة مجد شرع كلها % % أطربها المجد وأطراها % % 58(@)(@@) % حسبهم فخرا بأن العلى % % آخرهم فيه كأولاها % % 59(@)(@@) % كأنما أخلاقهم روضة % باكرها الطل فنداها % % 60(@)(@@) % تعبق في المجلس ألفاظهم % % كأن نشر المسك معناها % % PageV01P326 61(@)(@@) % القوم لطف الله في أرضه % % من رحمة للخلق أنشاها % % 62(@)(@@) % قد بسط الجود أكفا لهم % % عاشت بنو الدنيا بنعماها % % 63(@)(@@) % أهل الوجوه الزهر لو قابلوا % % بنورها الشهب لأطفاها % % 64(@)(@@) % أقسم أن الدهر أجفانه % ما فتحت إلا لمرآها % % 65(@)(@@) % وسمعته ما شق حتى يعي % % شيئا سوى حسن مزاياها % % 66(@)(@@) % من طينة بيضاء قدسية % صلصلها الله وصفاها % % 67(@)(@@) % والطينة السوداء من خبثها % % هيهات تبيض سجاياها % % 68(@)(@@) % جرت لسبق فتساوت بهم % % سوابق الفضل بمجراها % % 69(@)(@@) % هم فيه كالأعين يمناها % % بالرمش لا يسبق يسراها % % 70(@)(@@) % والقبض والبسط استوت فيهما % % البنان صغراها وكبراها % % PageV01P327 71(@)(@@) % فيا بني الوحي وآل الهدى % % جباله ، والله أرساها % % 72(@)(@@) % اليكموها من بنات 
ms100	 الثنا % % غراء قد راق محياها % % 73(@)(@@) % تستوهب الصفح لنا منكم % % من عثرة فيها استقلناها % % PageV01P328 البحر : منسرح 1(@)(@@) % إحدى الغواني إلى الزوراء % جاءتك تمشي على استحياء % 2(@)(@@) % جميلة من بنات الفكر % % مكنونة في حجاب الصدر % % 3(@)(@@) % حيتك تبدي جميل العذر % % فحي منها ألوف الخدر % % 4(@)(@@) % يا ساكنا مثلها أحشائي % % 5(@)(@@) % سيرتها في سماء الحمد % زهرة مدح لبدر السعد % 6(@)(@@) % لمن أياديه جلت عندي % % قد خففت في ثقيل الرفد % 7(@)(@@) % عن كاهلي منة الأنواء % % 8(@)(@@) % معشوقة أقبلت للوصل % % لسانها ناطق بالفصل % % 9(@)(@@) % تغنيك عن غيرها بالنقل % % غناء كفيك لي بالمحل % % 10(@)(@@) % حتى عن الديمة الوطفاء % % PageV01P329 11(@)(@@) % كم رق ديباج نظمي وشيا % % وراق صوغي القوافى حليا % % 12(@)(@@) % كجوهر زان نحر العليا % % ذاك الذي لم تلد في الدنيا % % 13(@)(@@) % نظيره من بني حواء % % 14(@)(@@) % ذو طلعة وهي أم البشر % % من شامها قال بنت البدر % % 15(@)(@@) % وراحة وهي أخت البحر % % كم قلدت للورى من نحر % % 16(@)(@@) % بجوهر الرفد والنعماء % % 17(@)(@@) % سماؤها لم تزل منهلة % بها رياض المنى مخضله % % 18(@)(@@) % وغيرها ليس يشفي غلة % % عن الندى لم تزل معتله % % 19(@)(@@) % بالبخل لا فارقت من داء % % 20(@)(@@) % محمد الطيب الأخلاق % الحسن الماجد الأعراق % PageV01P330 21(@)(@@) % تباركت قدرة الخلاق % % إذ أطلعت منك للأشراق % 22(@)(@@) % للأرض شمس السما للرائي % % 23(@)(@@) % سبحانه ناشرا إحسانا % % في حسن طاويا سحبانا % % 24(@)(@@) % أنسى أخاها به ذبيانا % % نسيانه لي لأمر كانا % % 25(@)(@@) % حداه عني على الأعضاء % % 26(@)(@@) % يا هل ترى مخلفا للوعد % % من لم يجد غير بذل الجهد % % 27(@)(@@) % إن كنت أبطأت عما عندي % % فأنت يا مسرعا بالصد % 28(@)(@@) % أعجل بالعتب من أبطائي % % 29(@)(@@) % لا تشمتن هجرنا بالوصل % % ولا تسم عقدنا بالحل % 30(@)(@@) % فمثلك اليوم خلا من لي % % ومن لك اليوم خلا مثلي % % PageV01P331 31(@)(@@) % ونحن كالماء والصهباء % % 32(@)(@@) % أنت على النفس منها أغلا % % وأنت في العين منها أحلى % % 33(@)(@@) % وأنت أولى بقلبي كلا % ذاك الهوى لا تخله ملا % 34(@)(@@) % فمال عنه إلى الأهواء % % 35(@)(@@) % لسانكم للمقال الفصل % وكفكم للندى والبذل % 36(@)(@@) % فما لكم في الورى 