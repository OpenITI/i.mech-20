ms81	 الحي الذي قصدوا % % بها إليه ، فحيزت منه في دار % 7(@)(@@) % فاحت برائحة قال العريف لهم : % هل في محلتنا دكان عطار % PageV01P381 البحر : متقارب تام 1(@)(@@) % طربت إلى الصنج والمزهر ، % وشرب المدامة بالأكبر % 2(@)(@@) % وألقيت عني ثياب الهدى ، % خيول من الراح ما عريت % 3(@)(@@) % وأقبلت اسحب ذيل المجون ، % وأمشي إلى القصف في مئزر % 4(@)(@@) % ليال أروح على أدهم % كميت ، وأغدو على أشقر % 5(@)(@@) % خيول من الراح ما عربت % ليوم رهان ولم تضمر % 6(@)(@@) % براقعها من سحيق العبير ، % ومن ياسمين وسيسنبر % 7(@)(@@) % ذخائر كسرى لأولاده ، % وغرس كرام بني الأصفر % 8(@)(@@) % غدا المشترون على أهلها ، % فقالوا : أتيناكم نشتري % % 9(@)(@@) % خيولا لكم قد أتت فرها ، % فمن بين أحوى إلى أحور % 10(@)(@@) % فقالوا لهم : إنما خيلنا % % وغرس كرام بني الأصفر % PageV01P382 11(@)(@@) % ولا تحمل اللبد ، لكنها % % خيول لكل فتى أزهر % 12(@)(@@) % وسيما إذا أنت باكرتها ، % كمثل دم الجوف في الأبهر % 13(@)(@@) % مشعشعة من بنات الكرو % % م سالت نطافا ، ولم تعصر % 14(@)(@@) % عقيلة شيخ من المشركين ، % أتتنا تهادى من الكوثر % 15(@)(@@) % ولونان لون لها أصفر % ولون على الماء كالعصفر % 16(@)(@@) % لو ان أبا معشر ذاقها ، % لخر صريعا أبو معشر % 17(@)(@@) % وكبر من طيبها ساعة ، % وأمشي إلى القصف في مئزر % 18(@)(@@) % فما برح القوم حتى اشتروا ، % ومن يشتر الراح لم يخسر % PageV01P383 البحر : خفيف تام 1(@)(@@) % اسقني أن سقيتني بالكبير ، % إن في السكر لي تمام السرور % 2(@)(@@) % إن شرب الصغير صغر وعجز ، % فاجعل الدور كله بالكبير % 3(@)(@@) % قد تدانت لنا الأمور كما نه % وى ، وذلت لنا رقاب الدهور % PageV01P384 البحر : وافر تام 1(@)(@@) % تداو من الصغيرة بالكبير ، % وخذها من يدي ساق غرير % 2(@)(@@) % ودعني من بكائك في عراص ، % وفي أطلال منزلة ودور % 3(@)(@@) % ولاتشرب بلا طرب ولهو ، % فإن الخيل تشرب بالصفير % 4(@)(@@) % فليس الشرب إلا بالملاهي ، % وفي الحركات من بم وزير % PageV01P385 البحر : كامل تام 1(@)(@@) % طاب الزمان ، وأورق الأشجار ، % ومضى الشتاء ، وقد أتى آذار % 2(@)(@@) % وكسا الربيع الأرض ، من أنواره % وشيا تحار لحسنه الأبصار % 3(@)(@@) % فانف الوقار عن المجون بقهوة % حمراء 
ms82	 ، خالط لونها إقمار % 4(@)(@@) % فاستنصف الأقدار من أحداثها ، % فلطالما لعبت بك الأقدار % 5(@)(@@) % من كف ذي غنج كأن جبينه % قمر ، وسائر وجهه دينار % 6(@)(@@) % يزهى بعيني شادن ، وجبينه ، % والخصر فيه لشقوتي زنار % 7(@)(@@) % يسقيك كأسا من عصير جفونه ، % وتدور أخرى من يديه عقار % 8(@)(@@) % شمطاء ، تأبى أن يدوس أديمها % % أيدي الرجال ، وما بها استنكار % 9(@)(@@) % كرخية كالروح دب بشربها % % حلم ، يداخله حيا ووقار % 10(@)(@@) % في فتية فطموا الحيا ؛ فلباسهم % حلم ، وليس لجهلهم آثار % PageV01P386 البحر : خفيف تام 1(@)(@@) % شهدت جلوة العروس جنان ، % فاستمالت بحسنها النظاره % 2(@)(@@) % حسبوها العروس حين رأوها ، % فإليها دون العروس الإشاره % 3(@)(@@) % قال أهل العروس حين رأوها : % ما دهانا بها سوى عماره % PageV01P387 البحر : طويل 1(@)(@@) % ومشتعل الخدين ، يسحر طرفه ، % له سمة يحكي بها سمة البدر % 2(@)(@@) % إذا ما مشى يهتز من دون نحره % وأعطافه منه إلى منتهى الخصر % 3(@)(@@) % وليست خطاه حين يزهى بردفه ، % إذا ما مشى في الأرض ، أكثر من فتر % 4(@)(@@) % دعوت له بالليل صاحب حانة % بمنتقص الأطراف ، منخسف الظهر % 5(@)(@@) % فجاء به في الليل سحبا ، كأنما % % يجر قتيلا ، أو نشيرا من القبر % 6(@)(@@) % فقرب من نحو الأباريق خده ، % وقهقه مسرورا من القرقف الخمر % 7(@)(@@) % فصب فأبدت ، ثم شجت ، فكتبت % ثمان من الواوات يضحكتن في سطر % 8(@)(@@) % فقلت لها : يا خمر كم لك حجة ؟ % فقالت : سكنت الدن ردحا من الدهر % 9(@)(@@) % فقلت لها : كسرى حواك ؛ فعبست % وقالت : لقد قصرت في قلة الصبر % 10(@)(@@) % سمعت بذي القرنين قبل خروجه ، % وأدركت موسى قبل صاحبه الخضر % PageV01P388 11(@)(@@) % ولو أنني خلدت فيه سكنته % إلى أن ينادي هاتف الله بالحشر % 12(@)(@@) % فبتنا على خير العقار عوابسا ، % وإبليس يحدونا بألوية السكر % PageV01P389 البحر : خفيف تام 1(@)(@@) % اسقني إن سقيتني بالكبير ، % من لذيذ الشراب لا بالصغير % 2(@)(@@) % من مدام معتق أخرسته % حقبة الدهر بعد طول الهدير % 3(@)(@@) % بابلي ، صاف ، مؤنثة طو % را ، وطورا تهم بالتذكير % 4(@)(@@) % في أباريق سجد ، كبنات ال % % ماء أقمين من حذار الصقور % 5(@)(@@) % فإذا ما الكؤوس دارت علينا ، % قذفت في 
ms83	 أنوفنا بالعبير % 6(@)(@@) % ولدينا المهذب ابن رباب ، % عصمة المعتفين ، بحر البحور % 7(@)(@@) % صاغه ربه على الجود والحل % م ، وما شئت من حياء وخير % PageV01P390 البحر : خفيف تام 1(@)(@@) % طفلة كالغزال ذات دلال ، % فتنة في النقاب والإسفار % 2(@)(@@) % أتمنى ، وما بكفي منها % % غير مطل وغير سوء انتظار % 3(@)(@@) % ثم قالت : جهرت باسمي في الشع % ر ، فهلا كنيت في الأشعار % 4(@)(@@) % قلت : إن الهوى إذا كان بالصب % وهى قلبه عن الأسرار % 5(@)(@@) % أنا جار لكم قريب ، ولكن % ليس يغنى لديك حق الجوار % PageV01P391 البحر : وافر تام 1(@)(@@) % زجرت كتابكم لما أتاني % % بزجر سوانح الطير الجواري % % 2(@)(@@) % نظرت إليه مخزوما بزير % على ظهر ، ومختوما بقار % 3(@)(@@) % فقلت : الظهر أحور قرطقي % يشابه شكله شكل الجواري % % 4(@)(@@) % وقلت : الزير ملهاة لمله ، % وطين الختم من زق العقار % 5(@)(@@) % فجئت إليكم طربا وشوقا ، % فما أخطأت داركم بدار % 6(@)(@@) % فكيف ترون زجري واعتيافي % % ألست من الفلاسفة الكبار ؟ % PageV01P392 البحر : منسرح 1(@)(@@) % طول اشتياقي ، وضيق مصطبري % % يقلبان الفؤاد بالفكر % 2(@)(@@) % فالحب ضيف علي معتكف ، % و القلب من محنة على خطر % 3(@)(@@) % يبتعث الشوق من مكامنه ، % وجه زها حسنه على القمر % PageV01P393 البحر : طويل 1(@)(@@) % وليل لنا قد جاز في طوله القدرا ، % كشفنا له عن وجه قينتنا الخدرا % % 2(@)(@@) % فولى برعب قبل وقت انتصافه ، % كأنا ألحنا عند ذاك له الفجرا % % 3(@)(@@) % وأقبل صبح قبل وقت مجيئه ، % فأدبر مرعوبا ، وقد كسي الذعرا % % 4(@)(@@) % وظن بأن الله أحدث بعده % ضياء منيرا ، أو قضى بعده أمرا % % 5(@)(@@) % فبتنا بلا ليل ، وقمنا بلا ضحى ، % كأنا نصبناها لذاك وذا سحرا % % PageV01P394 البحر : كامل تام 1(@)(@@) % حسبي جوى إن ضاق بي أمري % % ذكري لرحم وهي لا تدري % % 2(@)(@@) % وأخاف أن أبدي مودتها ، % فيغار مولاها ويستشري % % 3(@)(@@) % فأكون قد سببت فرقتنا ، % وحططت مجتهدا على ظهري % % 4(@)(@@) % ويلومني في حبها نفر % خالدون من شجوي ومن ضري % % 5(@)(@@) % لم يعرفوا حق الهوى ، فلحوا ، % لو جربوه تبينوا عذري % % 6(@)(@@) % إني لأبغض كل مصطبر % عن إلفه في الوصل والهجر % 7(@)(@@) % الصبر يحسن في مواضعه ، % ما للفتى 
ms84	 المشتاق والصبر % PageV01P395 البحر : مجزوء الوافر 1(@)(@@) % أراح الله من بصري ، % كما قد سامني نظري % % 2(@)(@@) % يكلفني تولعه % بمردان ذوي خطر % 3(@)(@@) % فواحزناه من عين % بنظرتها جنت ضرري % % 4(@)(@@) % فإن عاتبتها فيه % أحالتني على القدر % 5(@)(@@) % فتخصمني ، فأسكت لا % % أحير القول كالحجر % 6(@)(@@) % فيا من لم يكن للح % ب فيه ميل ذي وطر % 7(@)(@@) % ولم يذق الهوى نوعي % ن مثل الشهد والصبر % 8(@)(@@) % تلوم ! ؟ فوالذي نجا % % ك من شوقي ومن ذكري % % 9(@)(@@) % لو انك ذقت أحيانا % مخالاة من الفكر % 10(@)(@@) % و قد فتح الهوى بيدي % ك ألوانا من العبر % PageV01P396 11(@)(@@) % وأنت عليك مغضوب ، % وقلبك غير مصطبر % 12(@)(@@) % إذن لعلمت أن الح % ب يأخذ أخذ مقتدر % 13(@)(@@) % فإني مضمر أمرا % أنا منه على خطر % 14(@)(@@) % فوا أسفا تلاعب بي % % جنون الحب في صغري % % 15(@)(@@) % فأهرمني ، بلا كبر ، % وبث الشيب في شعري % % 16(@)(@@) % فقوقوا للذي أهوى ، % وكيف تكلم القمر % 17(@)(@@) % فديت ! إلى متى ذا الشخ % ص منك يضج في البشر ؟ % PageV01P397 البحر : بسيط تام 1(@)(@@) % لاكان أحسن ممن قال ملتفتا % وقد تغضب : ما مشاك في أثري % % 2(@)(@@) % كأنما كلمتني الشمس ضاحية ، % إذ قال ماقال لي ، أو شقة القمر % 3(@)(@@) % ظبي له من قلوب الناس نابتة % من المودة تجني أطيب الثمر % 4(@)(@@) % إذا بدا رمت الأبصار جانبه % معا ؛ فلم تختلف عينان في النظر % PageV01P398 البحر : متقارب تام 1(@)(@@) % أمحييه القلب ضد اسمها % % أرق وأصفى من الجوهر % 2(@)(@@) % تخف الخلافة في عينها ، % ورب السرير مع المنبر % 3(@)(@@) % وقد ملكت بالجمال الأنام ، % و رق الأمير أب الأزهر % PageV01P399 البحر : سريع 1(@)(@@) % أما كفى طرفك أن ينظرا % % إن راح للتسليم أو بكرا % % 2(@)(@@) % رأى الذي يهوى ، فلم يرضه % حظا ، وما أكثر من لا يرى % % 3(@)(@@) % فشانك اليوم ، وشأن الذي % % تهوى ، فما أيأس أن تظفرا % % 4(@)(@@) % قصد الفتى في كل ما رامه % أن يبلغ الغاية أو يعذرا % % PageV01P400 البحر : منسرح 1(@)(@@) % إن تشق عيني بها فقد سعدت % عين رسولي ، وفزت بالخبر % 2(@)(@@) % فكلما جاءني الرسول لها % % رددت شوقا في طرفه نظري % % 3 
ms85	(@)(@@) % تظهر في طرفه محاسنها ، % قد أثرت فيه أحسن الأثر % 4(@)(@@) % خذ مقلتي يارسول عارية ، % فانظر بها ، واحتكم على بصري % % PageV01P401 البحر : طويل 1(@)(@@) % أساقيتي كأسا أمر من الصبر ، % ومحوجتي من صفو عيش إلى كدر % % 2(@)(@@) % وكنت عزيزا قبل أن أعرف الهوى ، % فألبسني ثوب المذلة والصغر % PageV01P402 البحر : مجتث 1(@)(@@) % قالوا : اغتسل أتت الظه % هر ، والكؤوس تدور % 2(@)(@@) % فقلت : سوف ! فقالوا : % ترك الصلاة كبير % 3(@)(@@) % فقلت : أكبر منه % ظبي ينال غرير % 4(@)(@@) % إن قمت لم ينتظرني ، % وغاب عني السرور % 5(@)(@@) % وما لمثلي صلاة ، % لأن فسقي شهير % 6(@)(@@) % فأقصروا عن ملامي ، % فإنني معذور % 7(@)(@@) % إن الجنابة ممن % جنبت منه طهور % PageV01P403 البحر : سريع 1(@)(@@) % يا تارك الأبرار فجارا ، % وتارك النوام سمارا % % 2(@)(@@) % قد قلت لما زارني طيفكم : % أهلا بهذا الطيف إذ دارا % % 3(@)(@@) % نفسي فدت طيفك من زائر ، % لو زرتني يقظان ما زارا % % 4(@)(@@) % يا حبذا خدك هذا الذي % % من شمه قارف أوزارا ! % PageV01P404 البحر : سريع 1(@)(@@) % فدتك نفسي يا أبا جعفر ، % جارية كالقمر الأزهر % 2(@)(@@) % تعلقتني وتعلقتها % % طفلين في المهد إلى المحشر % 3(@)(@@) % كنت وكانت نتهادى الهوى % % بخاتمينا غير مستنكر % 4(@)(@@) % حبست لي الخاتم مني ، وقد % سلبتني إياه مذ أشهر % 5(@)(@@) % فأرسلت فيه ، فغالطتها % % بخاتم من فضة أخضر % 6(@)(@@) % قالت : لقد كان لنا خاتم % أحمر يهديه إلينا سري % % 7(@)(@@) % لكنه علق غيري ، فقد % أهدى لها الخاتم ؛ لا أمتري % % 8(@)(@@) % كفرت بالله وآياته ، % إن أنا لم أهجره ؛ فليبصر % 9(@)(@@) % أوبات بالمخرج من تهمتي % % إياه في خاتمه الأحمر % 10(@)(@@) % فاردده تردد وصلها ، إنها % % قرة عيني ، يا أبا جعفر % PageV01P405 11(@)(@@) % فإنني متهم عندها ، % وأنت من تعلم أني بري % % PageV01P406 البحر : طويل 1(@)(@@) % كأن صفاء الدمع في ساح خده % حكى الدر منثورا على ورق نضر % 2(@)(@@) % فيا نور عيني لو كففت من البكا ، % وناديت من أبكاكض قام من القبر % PageV01P407 البحر : هزج 1(@)(@@) % ألا قومو إلى الكرخ ، % إلى منزل خمار % 2(@)(@@) % إلى صهباء كالمسك % لدى جونة عطار % 3(@)(@@) % وبستان له نهر ، % لدى نخل وأشجار % 4(@)(@@) % فأطعمكم به لحما % من الوحش وأطيار 
ms86	 % 5(@)(@@) % فإن أحببتم لهوا ، % أتيناكم بزمار % 6(@)(@@) % وإن أحببتم وصلا % فهذي ربة الدار ! % PageV01P408 البحر : مجزوء الرمل 1(@)(@@) % قل لذا الوجه الطرير % ولذا الردف الوثير % 2(@)(@@) % ولمغلاق همومي % % ولمفتاح سروري % % 3(@)(@@) % والذي يبخل عني % % بقليل من كثير % 4(@)(@@) % يا صغير السن والمو % لد في عقل الكبير % 5(@)(@@) % وقليلا في التلاقي ، % وكثيرا في الضمير % 6(@)(@@) % لم تغضبت على عب % دك في خطب يسير % 7(@)(@@) % فارض عني بحياتي ، % يا حياتي وأميري % % PageV01P409 البحر : طويل 1(@)(@@) % تأملت حمدانا ، فقلت لصاحبي : % لقد كان من شرطي زمانا من الدهر % 2(@)(@@) % فإن تك قد سالت بخديه لحية % فباطن فخذيه نقي من الشعر % 3(@)(@@) % تذكر أخي ما قد مضى من شبابه ، % ونله على تلك الخيالة والذكر % 4(@)(@@) % له مقلة حوراء تدعو إلى الصبا % % جميع قلوب العاشقين وما تدري ! % PageV01P410 البحر : منسرح 1(@)(@@) % لما جفاني الحبيب ، وامتنعت % عني الرسالات منه والخبر % 2(@)(@@) % اشتد شوقي ، فكاد يقتلني % % ذكر حبيبي ، والهم والفكر % 3(@)(@@) % دعوت إبليس ، ثم قلت له % في خلوة والدموع تنهمر : % 4(@)(@@) % أما ترى كيف قد بليت ، وقد % أقرح جفني البكاء والسهر % 5(@)(@@) % إن أنت لم تلق لي المودة في % % صدر حبيبي ، وأنت مقتدر % 6(@)(@@) % لا قلت شعرا ، ولا سمعت غنا % ولا جرى في مفاصلي السكر % 7(@)(@@) % ولا أزال القرآن . . أدرسه % أروح في درسه وأبتكر % 8(@)(@@) % وألزم الصوم ، والصلاة ، ولا % % أزال ، دهري ، بالخير آتمر % 9(@)(@@) % فما مضت بعد ذاك ثالثة ، % حتى أتاني الحبيب يعتذر % PageV01P411 البحر : بسيط تام 1(@)(@@) % إذا ابتهلت سألت الله رحمته ، % كنيت عنك ، وما يعدوك إضماري % % 2(@)(@@) % أحببت من شعر بشار لحبكم ، % بيتا شغفت به من شعر بشار % PageV01P412 البحر : منسرح 1(@)(@@) % كل محب سواي مستور ، % و الناس إلا عن قصتي عور % 2(@)(@@) % كأن طرفي عين علي لهم ، % فكل طي لدي منشور % 3(@)(@@) % ما إن يغب الفعال أفعله ، % حتى تهاداه بيننا الدور % 4(@)(@@) % يخرج من هذه ، ويدخل في % % تلك ، وعنه القناع محسور % 5(@)(@@) % كأنني عند ستر مأربتي ، % بكل طرف إلي منظور % 6(@)(@@) % فما احتيالي ، وقد خلقت فتى % % تجري بما ساءني المقادير 
ms87	 % 7(@)(@@) % لكن وجه الذي كلفت به % محتمل ذنبه ومغفور % PageV01P413 البحر : هزج 1(@)(@@) % لقد كنت وما في النا % % س مني للهوى أستر % 2(@)(@@) % ولا أقنع بالدون % على اللهو ولا أصبر % 3(@)(@@) % فلما أظهروا أمري ، % وقدما كان لا يظهر % 4(@)(@@) % وأغروا بي تأنيبا % من المقبل والمدبر % 5(@)(@@) % تجاسرت ؛ فأقدمت % على كشف الهوى المضمر % 6(@)(@@) % ولا والله ، لا والا % ه ، ولا والله لا أقصر % 7(@)(@@) % وقد شاع الذي أخفي ، % وقد كان الذي أحذر ! % PageV01P414 البحر : هزج 1(@)(@@) % أيا من طرفه سحر % ومن مبسمه در % 2(@)(@@) % تجاسرت ؛ فكاشفت % ك لما غلب الصبر % 3(@)(@@) % وما أحسن في مثل % ك أن ينهتك الستر % 4(@)(@@) % لئن عنفني الناس ، % ففي وجهك لي عذر % 5(@)(@@) % ودعني من مواعيد % ك ، إذ ساعتك الدهر % 6(@)(@@) % ومن قولك : آتيك ، % إذا صليت الظهر % 7(@)(@@) % فلا والله لا تبر % ح حتى يبرم الأمر % 8(@)(@@) % فإما الهجر والذم ، % وإما الوصل والشكر % PageV01P415 البحر : بسيط تام 1(@)(@@) % ماجئت ذنبا به استوجبت سخطكم % استغفر الله إلا شدة النظر % 2(@)(@@) % ياأهل بغداد ألقى ذا بحضرتكم ، % فكيف لو كنت بين الترك والخزر % 3(@)(@@) % سحت علي سماء الحزن بعدكم ، % وأحدقت بي بحور الشوق والفكر % PageV01P416 البحر : مجزوء الوافر 1(@)(@@) % طموح العين والنظر ، % مباح لي وللبشر % 2(@)(@@) % فقلبي غير مصطبر % و عنه غير مزدجر % 3(@)(@@) % وتعجبني وجيف الكا % % س ، بين الناي والوتر % 4(@)(@@) % نرى جثمانها معنا ، % ورياها على سفر % PageV01P417 البحر : سريع 1(@)(@@) % قد سلم الصوم على الفطر ، % واختفقت ألوية السكر % 2(@)(@@) % وسحب القصف ذيول الصبا % % في عسكر العيدان والزمر % 3(@)(@@) % واستمكن الوصل وأشياعه % من قود الإبعاد والهجر % 4(@)(@@) % فليس يلفى غير مستبشر % لعلة الصوم إلى الشكر % PageV01P418 البحر : - 1(@)(@@) % أزور محمدا ، فإذا التقينا % % تكلمت الضمائر في الصدور % 2(@)(@@) % فأرجع لم ألمه ، ولم يلمني ، % وقد رضي الضمير عن الضمير % 3(@)(@@) % أمور ليس يعرفها سوانا ، % يحير لطفها بصر البصير % PageV01P419 البحر : متقارب تام 1(@)(@@) % أحب الغلام إذا كرها ، % وأبصرته أشعثا أمرها % % 2(@)(@@) % وقد حذر الناس سكينه ، % فكلهم يتقي شرها % % 3(@)(@@) % وإني رأيت سراويله ، % لها تكة أشتهي جرها % % PageV01P420 البحر 
ms88	 : سريع 1(@)(@@) % الجار أبلاني لا الجاره ، % بحسن وجه مستوي الداره % 2(@)(@@) % أبيت من وجد به مدنفا ، % كأنما ألسعت جراره % 3(@)(@@) % كفى بلاء حب من لا أرى ، % ونحن في حي وفي حاره % 4(@)(@@) % أنا الذي أصلى بنار الهوى % % وحدي ، والعشاق نظاره % 5(@)(@@) % قلبي لا يعشق ، حتى إذا % % أحب يوما جاء بالكاره % 6(@)(@@) % تلعب الحب بقلبي ، كما % % تلعب السنور بالفاره % PageV01P421 البحر : - 1(@)(@@) % لم أبك في مجلس منصور % شوقا إلى الجنة والحور % 2(@)(@@) % لكن بكائي لبكا شادن ، % تقيه نفسي كل محذور % 3(@)(@@) % تنتسب الألسن من وصفه % إلى مدى عجز ، وتقصير % 4(@)(@@) % فات لسان الوصف لكن ذا ، % تفديه نفسي ، جهد معذور % 5(@)(@@) % أحسن من مجلس منصور % ضرب بعود ، وبطنبور % 6(@)(@@) % نتيج أنوار سماوية ، % قرين تقديس وتطهير % 7(@)(@@) % جوهره روح ، وأعراضه % % قد ألفت من مارج النور % PageV01P422 البحر : طويل 1(@)(@@) % توهمه قلبي ، فأصبح خده ، % وفيه مكان الوهم من نظري أثر % 2(@)(@@) % ومر بفكري خاطرا ، فجرحته ، % ولم أر جسما قط يجرحه الفكر % 3(@)(@@) % وصافحه قلبي ؛ فآلم كفه % فمن غمز قلبي في أنامله عقر % PageV01P423 البحر : هزج 1(@)(@@) % ألا يا قمر الدار ، % ويا مسكة عطار % 2(@)(@@) % ويا نفحة نسرين ، % ويا وردة أشجار % 3(@)(@@) % ويا ظلة أغصان ، % على شاطىء نهار % 4(@)(@@) % ويا كعبين من عاج ، % ويا طنبور شطار % 5(@)(@@) % ويا عرش سليمان ، % إذاهم بأسفار % 6(@)(@@) % ويا مزمور داود ، % إذا يتلى بأسحار % 7(@)(@@) % وكعبة بيت الل % ه ذا ركن وأستار % 8(@)(@@) % لقد أصبحت من حب % ك بين الخلد والنار ! % PageV01P424 البحر : مجزوء الكامل 1(@)(@@) % يا من بمقلته العقار ، % وبوجنتيه الجلنار % 2(@)(@@) % ماذا الصدود ، متى فطن % ت له لك الرحمن جار ؟ ! % 3(@)(@@) % أما الفؤاد ، ففيه مذ % % فطنت للهجران نار % 4(@)(@@) % لم ينته الحساد حتى % % شط بي عنك المزار % PageV01P425 البحر : مجتث 1(@)(@@) % مني إلى المتكبر ، % و الشامخ المتجبر % 2(@)(@@) % وشاتمي حين يخلو ، % ولاعني حين يعشر % 3(@)(@@) % إلى المعرض بالبغ % ض لي ، وإن لم يفسر % 4(@)(@@) % فإن شكوت إليه % ما قد جرى منه أنكر % 5(@)(@@) % أصاب ودك عين ، % يا سيدي ، فتغير % 6(@)(@@) % فصرت قائد خلف 
ms89	 ، % تسوق في الهجر عسكر % 7(@)(@@) % فإن أقل : قف يسر ، أو % % أقل : تقدم تأخر ! % 8(@)(@@) % كطالب مثلا قي % % ل : خالف القوم تذكر % 9(@)(@@) % إن كبر الناس غنى ، % وإن تغنوا يكبر % 10(@)(@@) % خلاف أكشف ذي دا % % رتين في الناس ، أعسر % PageV01P426 11(@)(@@) % فلست أنسى خداعي % % له ، وإن كان ينكر % 12(@)(@@) % إذ قلت : من أين للعي % ن ، يا فديتك ، أصغر % 13(@)(@@) % وقلت : ما شك في ذا % % سواك ، عيني أكبر % 14(@)(@@) % وقلت : ما قلت شيئا ، % فهات حتى نقدر % 15(@)(@@) % حتى إذا أطبق العي % ن فوق خدي لينظر % 16(@)(@@) % خلست قبلة ظبي ، % قد راح ماضغ سكر % 17(@)(@@) % فاصفر من ذاك واحم % ر لونه وتمعر % PageV01P427 البحر : طويل 1(@)(@@) % إذا أنت لم يدع الهوى فتجيبه ، % ولم تاته طوعا خرجت بلا وطر % 2(@)(@@) % وخلفك الإيقاع تطرب سادرا ، % وصرت كنغم تاه في الحلق لم يدر % 3(@)(@@) % وما فوق ظهر الأرض أنعم عيشة ، % وأعرض دنيا من محب إذا اقتدر % 4(@)(@@) % فإن قلت في الحب الشقاوة ، والبلا ، % وفيه مقاساة المكاره ، والعبر % 5(@)(@@) % ففيه مواتاة الحبيب ، وعطفه % % عليك ، وفيه الشم والذوق والنظر % PageV01P428 البحر : - 1(@)(@@) % سيحبسني ، أظن ، عن المس ير % فتوني بابن مسعدة الصغير % 2(@)(@@) % فلا تعذل عليه أبا علي ، % فإني لم ألمك على الكبير % 3(@)(@@) % أما وجلال من أصفاك ودي ، % وأكرمني بمعرفة الأمير % 4(@)(@@) % لئن نطق اللسان ببعض حبي ، % لأعظم منه مالك في الضمير % PageV01P429 البحر : منسرح 1(@)(@@) % خليت عيني ولذة النظر ، % تلهو بحسن الوجوه والصور % 2(@)(@@) % نزهتها في محاسن الخرد ال % % غيد ، وروض الدلال والخفر % 3(@)(@@) % لست ، إذا مارأيت ذا حور ، % من لحظ عيني له بمعتذر % 4(@)(@@) % أسرح العين ترتعي في ريا % % ض الحسن أجلو بنورها بصري % % 5(@)(@@) % فقد جنيت الهموم منه ، وقد % خليت قلبي بعوم في الفكر % 6(@)(@@) % لا أسعد القلب في هواه ، ولا % % يطمع في عزتي ولا خوري % % 7(@)(@@) % عف ضميري ، وطيب خبري ، % ولذتي في الحديث والنظر % PageV01P430 البحر : كامل تام 1(@)(@@) % هارون ، ياخير الخلائف كلهم ، % ممن مضى فيهم ، وهذا الغابر % 2(@)(@@) % تتحاسد الآفاق وجهك بينها ، % فكأنهن ، بحيث كنت ، ضرائر % 3(@)(@@) % فاقدم 
ms90	 قدوم سعادة وسلامة ، % فلقد جرى لك بالسعود الطائر % 4(@)(@@) % إن العيون حجبن عنك بهيبة ، % فإذا بدأت بهن نكس ناظر % PageV01P431 البحر : مجتث 1(@)(@@) % قد قلت ، ليلة ساروا ، % وما استبان النهار % 2(@)(@@) % وقد خلين الديار % منهم فلا آثار % 3(@)(@@) % لصاحب يستشار % أ أنجدوا أم أغاروا ! % 4(@)(@@) % فقد أسارؤوا ، وجاروا ، % لما تولى القطار % 5(@)(@@) % وفيهم أبكار ، % وجوههن نضار % 6(@)(@@) % وطيبهن الصوار ، % وفيهم مصطار % 7(@)(@@) % كلامه سحار ، % ووجهه نوار % 8(@)(@@) % كأنه الدينار ، % دموع عيني غزار % 9(@)(@@) % الواحد القهار ، % ونوم عيني غرار % 10(@)(@@) % وفوق رأسي غبار ، % وتحت رجلي بحار % PageV01P432 11(@)(@@) % وحشو رجلي شرار ، % فأين ، أين الفرار ؟ % 12(@)(@@) % مالي على ذا القهار ، % أنت الذي تستجار % 13(@)(@@) % وبي أمور كبار % وفي حبيبي ازورار % 14(@)(@@) % عني ، وفيه نفار ، % فليس تلهي العقار % 15(@)(@@) % عنه ، ولا المزمار ، % إذا الندامى أداروا % % 16(@)(@@) % ما يمدح الخمار % حمراء فيها اصفرار % 17(@)(@@) % وعندهم عمار % منعم ، بندار % 18(@)(@@) % في حقوه زنار % % PageV01P433 البحر : طويل 1(@)(@@) % نعزي أمير المؤمنين محمدا ، % على خير ميت غيبته المقابر % 2(@)(@@) % وإن أمير المؤمنين محمدا ، % لرابط جأش للخطوب وصابر % 3(@)(@@) % زهت بأمير المؤمنين محمدا ، % أسرة ملك ، واستقرت منابر % 4(@)(@@) % فلا زلت للإسلام عزا وناصرا ، % كما أنت للإسلام عز وناصر % 5(@)(@@) % ولا زلت مرعيا بعين حفيظة ، % من الله لا تسطو عليك المقادر % 6(@)(@@) % تسوس أمور الناس تسعين حجة % وهديك محمود ، وعرضك وافر % PageV01P434 البحر : بسيط تام 1(@)(@@) % قام الأمين بأمر الله في البشر % واستقبل الملك في مستقبل الثمر % 2(@)(@@) % فالطير تخبرنا ، والطير صادقة ، % عن طيب عيش وعن طول من العمر % 3(@)(@@) % فيملك الأرض أقصى ما تعد يد ، % حتى يدب كليل الصوت والنظر % 4(@)(@@) % قد زين الله دنيانا ، وحسنها % % بابن الشفيع إلى الرحمن في المطر % 5(@)(@@) % وازدادت الأرض لما ساسها سعة ، % حتى تضاعف نور الشمس والقمر % PageV01P435 البحر : وافر تام 1(@)(@@) % تتيه الشمس ، والقمر المنير % إذا قلنا كانكما الأمير % 2(@)(@@) % فإن يك أشبها منه قليلا ، % فقد أخطاهما شبه كثير % 3(@)(@@) % لأن الشمس تغرب حين تمسي ، % وأن البدر ينقصه المسير % 4(@)(@@) % ونور محمد أبدا تمام ، % على وضح 
ms91	 الطريقة لا يحور ! % PageV01P436 البحر : سريع 1(@)(@@) % أتيح لي يا سهل مستظرف ، أتيح لي يا سهل مستظرف ، % تسحر عيني عينه الساحره % 2(@)(@@) % دنياه ما شئت ، ولكنه % منافق ليست له آخره % PageV01P437 البحر : طويل 1(@)(@@) % تتيه بك الدنيا ، وتزهو المنابر ، % وتشرق نورا حين تبدو المقاصر % 2(@)(@@) % ألا يا أمين الله ، والملك الذي % % إذا ما بدا تحبو إليه الأكابر % 3(@)(@@) % لبست رداء الفخر في صلب آدم ، % فما تنتهي إلا إليك المفاخر % 4(@)(@@) % ولله بدر في السماء منور ، % وأنت لنا بدر على الأرض زاهر % PageV01P438 البحر : منسرح 1(@)(@@) % قد أصبح الملك بالمنى ظفرا ، % كأنما كان عاشقا قدرا % % 2(@)(@@) % قيد بأشطانه إلى ملك ، % ماعشق الملك قبله بشرا % % 3(@)(@@) % حسبك وجه الأمين من قمر ، % إذا طوى الليل دونك القمرا % % 4(@)(@@) % خليفة يعتني بأمته ، % وإن أتته ذنوبها غفرا % % 5(@)(@@) % حتى لو اسطاع من تحننه ، % دافع عنها القضاء والقدرا ! % PageV01P439 البحر : طويل 1(@)(@@) % تذكر أميرض الله ، والعهد يذكر ، % مقامي ، وإنشاديك ، والناس حضر % 2(@)(@@) % ونثري عليك الدر ، يا در هاشم ، % فيا من رأى درا على الدر ينثر % 3(@)(@@) % أبوك الذي لم يملك الأرض مثله ، % وعمك موسى صنوه المتخير % 4(@)(@@) % وجداك مهدي الهدى ، وشقيقه % أبو أمك الأدنى ، أبو الفضل جعفر % 5(@)(@@) % وما مثل منصوريك منصورهاشم ، % ومنصور قحطان ، إذا عد مفخر % 6(@)(@@) % فمن ذا الذي يرمي بسهميك في الورى % % وعبد مناف والداك ، وحمير % 7(@)(@@) % تحسنت الدنيا بوجه خليفة ، % هو الصبح إلا أنه الدهر مسفر % 8(@)(@@) % إمام يسوس الملك تسعين حجة ، % عليه له منه رداء ومئزر % 9(@)(@@) % يشير إليه الجود من وجناته ، % وينظر من أعطافه حين ينظر % 10(@)(@@) % مضت لي شهور مذ حبست ثلاثة % كأني قد أذنبت ما ليس يغفر % PageV01P440 11(@)(@@) % فإن كنت لم أذنب ، ففيم حبستني ؟ % وإن كنت ذا ذنب فعفوك أكبر % PageV01P441 البحر : وافر تام 1(@)(@@) % تكثر ما استطعت من الخطايا ، % فإنك قاصد ربا غفورا % % 2(@)(@@) % سيفضي ذاك منك إلى نعيم ، % وتلقى ماجدا صمدا شكورا % % 3(@)(@@) % تعض ندامة كفيك مما % % تركت مخافة النار السرورا % % PageV01P442 البحر : مديد تام 1(@)(@@) % أيها المنتاب عن عفره ، % لست من 
ms92	 ليلي ، ولا سمره % 2(@)(@@) % لا أذود الطير عن شجر ، % قد بلوت المر من ثمره % 3(@)(@@) % فاتصل ، إن كنت متصلا ، % بقوى من أنت من وطره % 4(@)(@@) % خفت مأثور الحديث غدا ، % وغد دان لمنتظره % 5(@)(@@) % خاب من أسرى إلى بلد ، % غير معلوم مدى سفره % 6(@)(@@) % وسدته ثني ساعده ، % سنة حلت إلى شفره % 7(@)(@@) % فامض لا تمنن علي يدا ، % منك المعروف من كدره % 8(@)(@@) % رب فتيان ربأتهم ، % مسقط العيوق من سحره % 9(@)(@@) % فاتقوا بي ما يريبهم ؛ % إن تقوى الشر من حذره % 10(@)(@@) % وابن عم لا يكاشفنا ، % قد لبسناه على غمره % PageV01P443 11(@)(@@) % كمن الشنآن فيه لنا ، % ككمون النار في حجره % 12(@)(@@) % ورضاب بت أرشفه ، % ينقع الظمآن من خصره % 13(@)(@@) % علنيه خوط إسحلة ، % لان متناه لمهتصره % 14(@)(@@) % ذا ، ومغبر مخارمه ، % تحسر الأبصار عن قطره % 15(@)(@@) % لا ترى عين المبين به % ما خلا الآجال من بقره % 16(@)(@@) % خاض بي لجيه ذو حرز ، % يفعم الفضلين من ضفره % 17(@)(@@) % يكتسي عثنونه زبدا ، % فنصيلاه إلى نحره % 18(@)(@@) % ثم يعتم الحجاج به ، % كاعتمام الفوف في عشره % 19(@)(@@) % ثم تذروه الرياح ، كما % % طار قطن الندف عن وتره % 20(@)(@@) % كل حاجاتي تناولها % % وهو لم تنقص قوى أشره % PageV01P444 21(@)(@@) % ثم أدناني إلى ملك ، % يأمن الجاني لدى حجره % 22(@)(@@) % تأخذ الأيدي مظالمها ، % ثم تستذري إلى عصره % 23(@)(@@) % كيف لا يدنيك من أمل % من رسول الله من نفره % 24(@)(@@) % فاسل عن نوء تؤمله ؛ % حسبك العباس من مطره % 25(@)(@@) % ملك قل الشبيه له ، % لم تقع عين على خطره % 26(@)(@@) % لا تغطى عنه مكرمة % ربى واد ، ولا خمره % 27(@)(@@) % ذللت تلك الفجاج له ، % فهو مختار على بصره % 28(@)(@@) % سبق التفريط رائده ، % وكفاه العين من أثره % 29(@)(@@) % وإذا مج القنا علقا ، % وتراءى الموت في صوره % 30(@)(@@) % راح في ثنيي مفاضته ، % أسد يدمى شبا ظفره % PageV01P445 31(@)(@@) % تتأيا الطير غدوته ، % ثقة بالشبع من جزره % 32(@)(@@) % وترى السادات ماثلة ، % لسليل الشمس من قمره % 33(@)(@@) % فهم شتى ظنونهم ، % حذر المكنون من فكره % 34(@)(@@) % وكريم الخال من يمن ؛ % وكريم العم من مضره % 35 
ms93	(@)(@@) % قد لبست الدهر لبس فتى ، % أخذ الآداب عن عبره % 36(@)(@@) % فادخر خيرا تثاب به ، % كل مدخور لمدخره % PageV01P446 البحر : طويل 1(@)(@@) % ديار نوار ، ما ديار نوار ، % كسونك شجوا هن منه عوار % 2(@)(@@) % يقولون في الشيب الوقار لأهله ، % وشيبي بحمد الله غير وقار % 3(@)(@@) % إذا كنت لا أنفك عن طاعة الهوى ، % فإن الهوى يرمي الفتى بيوار % 4(@)(@@) % فها إن قلبي لا محالة مائل % إلى رشإ يسعى بكأس عقار % 5(@)(@@) % شمول ، إذا شجت تقول عقيقة ، % تنافس فيها السوم بين تجار % 6(@)(@@) % كأن بقايا ما عفا من حبابها ، % تفاريق شيب في سواد عذار % 7(@)(@@) % تردت به ثم انفرت عن أديمه ، % تفري ليل عن بياض نهار % 8(@)(@@) % نعاطيكها كف كأن بنانها ، % إذا اعترضتها ، العين صف مدار % 9(@)(@@) % حلفت يمينا برة لا يشوبها % % فجار ، وما دهري يمين فجار % 10(@)(@@) % لقد قوم العباس للناس حجهم ، % وساس برهبانية ووقار % PageV01P447 11(@)(@@) % وعرفهم أعلامهم ، وأراهم % منار الهدى موصولة بمنار % 12(@)(@@) % وأطعم حتى ما بمكة آكل % وأعطي عطايا لم تكن بضمار % 13(@)(@@) % وحملان أبناء السبيل تراهم % قطارا ، إذا راحوا أمام قطار % 14(@)(@@) % أبت لك يا عباس نفس سخية % بزبرج دنيانا ، وعتق نجار % 15(@)(@@) % وأنك للمنصور ، منصور هاشم % وما بعده من غاية لفخار % 16(@)(@@) % فجداك هذا خير قحطان واحدا ، % وهذا إذا ما عد خير نزار % 17(@)(@@) % إليك غدت بي حاجة لم أبح بها ، % أخاف عليها شامتا فأداري % % 18(@)(@@) % فأرخ عليها ستر معروفك الذي % % سترت به قدما علي عواري % % PageV01P448 البحر : مجزوء الرجز 1(@)(@@) % وبلدة فيها زور ، % صعراء تخطي في صعر % 2(@)(@@) % مرت ، إذا الذئب اقتفر % بها من القوم الأثر % 3(@)(@@) % كان له من الجزر ، % كل جنين ما اشتكر % 4(@)(@@) % ولا تعلاه شعر % ميت النسا ، حي الشفر % 5(@)(@@) % عسفتها على فطر ، % يهزه جن الأشر % 6(@)(@@) % لا متشك من سدر ، % ولا قريب من خور % 7(@)(@@) % كأنه بعد الضمر ، % وبعد ما جال الضفر % 8(@)(@@) % وراح فيء فحسر ، % جأت رباع المثغر % 9(@)(@@) % يحدو بحقب كالأكر ، % ترى بأثباج القصر % 10(@)(@@) % منهن توشيم الجدر ، % رعين أبكار الخضر % PageV01P449 11(@)(@@) % شهري 
ms94	 ربيع وصفر ، % حتى إذا الفحل جفر % 12(@)(@@) % وأشبه السفي الإبر ، % ونش إذخار النقر % 13(@)(@@) % قلن له ما تأتمر ، % وهن إذ قلن أشر % 14(@)(@@) % غير عواص ما أمر ، % كأنها لمن نظر % 15(@)(@@) % وكب يشيمون مطر ، % حتى إذا الظل قصر % 16(@)(@@) % يممن من جنبي هجر % أخضر ، طمام العكر % 17(@)(@@) % وبين إخفاق القتر % سار ، وليس للسمر % 18(@)(@@) % ولا تلاوات السور % يمسح مشرنانا يسر % 19(@)(@@) % زمت يمشزور المرر % لام كحلقوم النغر % 20(@)(@@) % حتى إذا اصطف السطر % أهدى لها لو لم يجر % PageV01P450 21(@)(@@) % دهياء يحدوها القدر ، % فتلك عيني لم تذر % 22(@)(@@) % شبها ، إذا الآل مهر ، % إليك كلفنا السفر % 23(@)(@@) % خوصا يجاذين النخر ، % قد انطوت منها السرر % 24(@)(@@) % طي القراري الحبر ، % لم تتقعدها الطير % 25(@)(@@) % ولا السنيح المزدجر ، % يافضل للقوم البطر % 26(@)(@@) % إذ ليس في الناس عصر ، % ولا من الخوف وزر % 27(@)(@@) % ونزلت إحدى الكبر ، % وقيل صماء الغير % 28(@)(@@) % فالناس أبناء الحذر ، % فرجت هاتيك الغمر % 29(@)(@@) % عنا ، وقد صابت بقر ، % كالشمس في شخص بشر % 30(@)(@@) % أعلى مجاريك الخطر ، % أبوك جلى عن مضر % PageV01P451 31(@)(@@) % قام كريما فانتصر % و الخوف يقري ويذر % 32(@)(@@) % لما رأى الأمر الذكر ، % ماحس من شيء هبر % 33(@)(@@) % وأنت تقتاف الأثر % من ذي حجول وغرر % 34(@)(@@) % معيد ورد وصدر ، % وإن علا الأمر اقتدر % 35(@)(@@) % فاين أصحاب الغمر ، % إذ شربوا كأس المقر % 36(@)(@@) % أصحرت إذ دبوا الخمر % شكرا ، وحر من شكر % 37(@)(@@) % فالله يعطيك الشبر ، % وفي أعاديك الظفر % 38(@)(@@) % والله من شاء نصر ، % وأنت إن خفنا الحصر % 39(@)(@@) % وهر دهر وكشر % عن ناجذيه ، وبسر % 40(@)(@@) % أغنيت ما أغنى المطر % وفيك أخلاق اليسر % PageV01P452 41(@)(@@) % حتى ترى تلك الزمر % تهوي لأذقان الثغر % 42(@)(@@) % من جذب ألوى لو نتر % إليه طودا لا نأطر % 43(@)(@@) % صعبا ، إذا لاقى أبر ، % وإن هفا القوم وقر % 44(@)(@@) % أو رهبوا الأمر جسر ، % ثم تسامى ففغر % 45(@)(@@) % عن شقشق ثم هدر ، % ثم تجافى فخطر % 46(@)(@@) % بذي سبيب وعذر ، % يمصع أطراف الإبر % 47(@)(@@) % هل لك ، والهل خير ، % فيمن إذا غبت حضر % 48(@)(@@) % أو نالك القوم 
ms95	 أثر ، % وإن رأى خيرا نشر % 49(@)(@@) % أو كان تقصير عذر % % PageV01P453 البحر : طويل 1(@)(@@) % جعلت عبيدا دون ما أناخائف ، % وصيرته بيني وبين يد الدهر % % 2(@)(@@) % أشار إليه الناس من كل جانب ، % وقالوا أبو عمرو لها ، وأبو عمرو % % 3(@)(@@) % فتى لا يحب الكسب ، إلا أحله % % ولا الكنز إلا من ثناء ومن شكر % 4(@)(@@) % عيوف لأخلاق اللئام وهديهم ، % وذو زور عما يقرب من وزر % 5(@)(@@) % ويقصر كف الدهر عمن أجاره ، % ويرعى من الآفات من حيث لا يدري % % PageV01P454 البحر : طويل 1(@)(@@) % ألا يا أمين الله كيف تحبنا % % قلوب بني مروان والأمر ما تدري % % 2(@)(@@) % وما بال مولاهم لسرك موضعا ، % وما باله أمسى يشارك في الأمر % 3(@)(@@) % تبين أمين الله في لحظاته % شنان بني العاصي ، وحقد بني صخر % 4(@)(@@) % بنيت ، بما خنت الأمير ، سقاية ، % فلا شربوا إلا أمر من الصبر % % 5(@)(@@) % فما كنت إلا مثل بائعة استها ، % تعود على المرضى به طلب الأجر % % PageV01P455 البحر : وافر تام 1(@)(@@) % مضى أيلول ، وارتفع الحرور ، % وأخبت نارها الشعرى العبور % 2(@)(@@) % فقوما ، فالقحا خمرا بماء ، % فإن نتاج بينها السرور % 3(@)(@@) % نتاج لا تدر عليه أم % بحمل لا تعد له الشهور % 4(@)(@@) % إذا الطاسات كرتها علينا ، % تكون بيننا فلك يدور % 5(@)(@@) % تسير نجومه عجلا وريثا ، % مشرقة ، وتارات تغور % 6(@)(@@) % إذا لم يجرهن القطب متنا ، % وفي دوراتهن لنا نشور % 7(@)(@@) % رأيت الفضل يأتي كل فضل ، % فقل له المشاكل والنظير % 8(@)(@@) % و ما استغلى أبو العياس مدحا ، % ولم يكثر عليه له كثير % 9(@)(@@) % ولم تك نفسه نفسين فيه % ليفصل بين رأييه مشير % 10(@)(@@) % تقبلت الربيع ندى وبأسا ، % وحزما حين تحزبني الأمور % PageV01P456 البحر : سريع 1(@)(@@) % أمنك للمكتوم إظهار ، % أم منك تغبيب وإنكار % 2(@)(@@) % أحل بالفرقة لومي ، وما % % بان الألى أهوى ، ولا ساروا % % 3(@)(@@) % إلا لأن تقلع عن قولها ، % مكثارة فينا ، ومكثار % 4(@)(@@) % ياذا الذي أبعده للذي % % أسمع فيه ، وهو الجار ! % 5(@)(@@) % واحدة أعطيك فيها العشا ، % إن قلت إني عنك صبار % 6(@)(@@) % وثانيا : إن قلت إني الذي % % أسلاك إن شطت بك الدار % 7(@)(@@) % ولسم عليه 
ms96	 جنن للهوى ، % وضمه للورد دوار % 8(@)(@@) % أضحكت عنه سن كتمانه % وكان من شأني إظهار % 9(@)(@@) % وجنة لقبت المنتهى ، % ثم اسمها في العجم جلار % 10(@)(@@) % سنم في جنات عدن لها % % من قضب العقيان أنهار % PageV01P457 11(@)(@@) % وفتية ما مثلهم فتية ، % كلهم للقصف مختار % 12(@)(@@) % من كل محض الجد لم يضطمم % % جيبا له مذ كان أزرار % 13(@)(@@) % يلقون في القراء أمثالهم % زيا ، وفي الشطار شطار % 14(@)(@@) % نادمتهم يوما ، فلما دجا % % ليل وصاروا في الذي صاروا % % 15(@)(@@) % قمت إلى مبرك عيدية ، % فانتخبوا الغرة واختاروا % % 16(@)(@@) % وتحت رحلي طيع ميلع % أدمجها طي وإضمار % 17(@)(@@) % كأنما برز من حبلها % % تحت محاني الرحل أسوار % 18(@)(@@) % لا والذي وافى لرضوانه ، % سارون حجاج وعمار % 19(@)(@@) % ماعدل العباس في جوده ، % رام بدفاعيه ، تيار % 20(@)(@@) % ولا دلوح ألفته الصبا ، % لدن على الملمس خوار % PageV01P458 21(@)(@@) % حتى غدا أوطف ما إن له % % دون اعتناق الأرض إقصار % 22(@)(@@) % يا بن أبي العباس أنت الذي % % سماؤه بالجود مدرار % 23(@)(@@) % أتتك أشعاري ، فأذريتها ، % وفيك أشعار وأشعار % 24(@)(@@) % يرجو ويخشى حالتيك الورى % % كأنك الجنة والنار % 25(@)(@@) % تقيلا منك أباك الذي % % جرت له في الخير آثار % 26(@)(@@) % الراكب الأمر تعايت به % أقياس أقوام وأقدار % 27(@)(@@) % كأنه أبيض ذو رونق ، % أخلصه الصيقل ، بتار % 28(@)(@@) % حفظ وصايا عن أب لم تشب % معروفه في الناس أكدار % 29(@)(@@) % كأن ربيعا كاسمه جاده % % منفهق الأرجاء مهمار % 30(@)(@@) % يسقيه ما غرد ذو علطة % في فنن العبري هدار % PageV01P459 31(@)(@@) % من عصم الناس وقد أسنتوا ، % ومن هدى الناس وقد حاروا % % 32(@)(@@) % قوم كأن المزن معروفهم % % ينميهم في المجد أخطار % 33(@)(@@) % حلوا كداء أبطحيها ، فما % % وارت من الكعبة أستار % 34(@)(@@) % ليسوا بجانين على ناظر % شوبان إحلاء وإمرار % 35(@)(@@) % كأنما أوجههم ، رقة ، % لها من اللؤلؤ أبشار % PageV01P460 البحر : كامل تام 1(@)(@@) % إني أتيتكم من القبر ، % والناس محتبسون للحشر % 2(@)(@@) % لولا أبو العباس ما نظرت % عيني إلى ولد ، ولا وفر % 3(@)(@@) % ألله ألبسني به نعما ، % شغلت جسامتها يدي شكري % % 4(@)(@@) % لقنتها من مفهم ، فهم ، % فعقدتها بأنامل عشر % PageV01P461 البحر : طويل 1 
ms97	(@)(@@) % أتحسبني باكرت بعدك لذة ، % أبا الفضل ، أو رفعت عن عاتق خدرا % % 2(@)(@@) % أو انتفعت عيني بغابر نظرة ، % أو أثبت في كأس لأشربها ثغرا % % 3(@)(@@) % جفاني إذن يوما إلى الليل سيدي ، % وأضحت يميني من مواعيده صفرا % % 4(@)(@@) % ولكنني استشعرت ثوب استكانة ، % فبت ، وكف الموت تحفر لي قبرا % % 5(@)(@@) % وحق لمن أصفيته الود كله ، % وأثبت في عالي المحل له ذكرا % % 6(@)(@@) % بأن لا يرى إلا لأمرك طاعة ، % و أن يكسو اللذات إذ عفتها هجرا % % PageV01P462 البحر : مجزوء الكامل 1(@)(@@) % وعظتك واعظة القتير ، % ونهتك أبهة الكبير % 2(@)(@@) % ورددت ما كنت استعر % ت من الشباب إلى المعير % 3(@)(@@) % ولقد تحل بعقوة ال % اب من بقر القصور % 4(@)(@@) % وبما تواكبهن ما % % بين الرصافة والجسور % 5(@)(@@) % صور إليك ، مؤنثا % % ت الدل في زي الذكور % 6(@)(@@) % عطل الشوى ومواضع % الأسوار منها والنحور % 7(@)(@@) % أرهفن إرهاف الأعن % تة ، والحمائل والسيور % 8(@)(@@) % وموقرات في القرا % % طق والخناجر في الخصور % 9(@)(@@) % أصداغهن معقربا % % ت ، والشوارب من عبير % 10(@)(@@) % مثل الظباء سمت إلى % % روض ، صوادر من غدير % PageV01P463 11(@)(@@) % زهر يطير فراشه ، % كتسأقط الدر النثير % 12(@)(@@) % فالآن صرت إلى النهى ، % وبلوت عاقبة السرور % 13(@)(@@) % هذا ، وبحر تنائف ، % وعر الإجازة والعبور % 14(@)(@@) % للجن فيه حاضر ، % جم المجالس والسمير % 15(@)(@@) % قاربت من مبسوطه ، % بالعنتريس العيسجور % 16(@)(@@) % لأزور صفو الله في ال % % دنيا من الكرم الخطير % 17(@)(@@) % يافضل ، جاوزت المدى ، % فجللت عن شبه النظير % 18(@)(@@) % وإذا العيون تأملت % بر في العيون وفي الصدور % 19(@)(@@) % فإذا العقول تفاطنت % ك عرضن في كرم وخير % 20(@)(@@) % % ك صدرن عن طرف حسير % PageV01P464 21(@)(@@) % مازلت في عقل الكبي % % ر ، وأنت في سن الصغير % 22(@)(@@) % حتى تعصرت الشبي % % بة ، واكتسيت من القتير % 23(@)(@@) % عف المداخل والمخا % % رج ، والغريزة ، والضمير % % 24(@)(@@) % والله خص بك الخلي % % فة ، فاصطفاك على بصير % 25(@)(@@) % فإذا ألاث بك الأمو % % ر كفيته قحم الأمور % 26(@)(@@) % آل التربيع ، فضلتم % فضل الخميس على العشير % 27(@)(@@) % من قاس غيركم بكم ، % قتاس الثماد إلى البحور % 28(@)(@@) % أين النجوم التاليا % % ت من الأهلة والبدور 
ms98	 % 29(@)(@@) % أين القليل بنو القلي % % ل من الكثير بني الكثير % 30(@)(@@) % قوم كفوا أيام مك % ة نازل الخطب الكبير % PageV01P465 31(@)(@@) % فتداركوا جزر الخلا % % فة ، وهي شاسعة النصير % 32(@)(@@) % لولا مقامهم بها % % هوت الرواسي من ثبير % PageV01P466 البحر : كامل تام 1(@)(@@) % يا منة إمتنها السكر ، % ما ينقضي مني لك الشكر % 2(@)(@@) % أعطتك فوق مناك من قبل % من قيل إن مرامها وعر % 3(@)(@@) % يثني إليك بها سوالفه ، % رشأ صناعة عينه السحر % 4(@)(@@) % ظلت حميا الكأس تبسطنا % % حتى تهتك بيننا الستر % 5(@)(@@) % في مجلس ضحك السرور به % % عن ناجذيه ، وحلت الخمر % 6(@)(@@) % ولقد تجوب بنا الفلاة ، إذا % % صام النهار ، وقالت العفر % 7(@)(@@) % شدنية رعت الحمى فأتت % ملء الجبال كأنها قصر % 8(@)(@@) % تثني على الحاذين ذا خصل ، % تعماله الشذران والخطر % 9(@)(@@) % أما إذا رفعته شامذة ، % فتقول : رنق فوقها نسر % 10(@)(@@) % أما إذا وضعته عارضة ، % فتقول : أرخي فوقها ستر % PageV01P467 11(@)(@@) % وتسف أحيانا ، فتحسبها % % مترسما ، يقتاده أثر % 12(@)(@@) % فإذا قصرت لها الزمام سما % % فوق المقادم ملطم حر % 13(@)(@@) % فكأنها مصغ لتسمعه % بعض الحديث بأذنه وقر % 14(@)(@@) % تنفي الشذا عنها بذي خصل ، % وحف السبيب يزينه الضفر % 15(@)(@@) % تترى لإنفاض ، أضر بها % % جذب الرى ، فخدودها صفر % 16(@)(@@) % يرمي إليك بها بنو أمل ، % عتبوا ، فأعتبهم بك الدهر % 17(@)(@@) % أنت الخصيب ، وهذه مصر ، % فتدفقا فكلاكما بحر % 18(@)(@@) % لا تقعدا بي عن مدى أملي % % شيئا ، فما لكما به عذر % 19(@)(@@) % ويحق لي ، إذ صرت بينكما ، % ألا يحل بساحتي فقر % 20(@)(@@) % النيل ينعش ماؤه مصرا ، % ونداك ينعش أهله الغمر % PageV01P468 البحر : طويل 1(@)(@@) % أجارة بيتينا أبوك غيور ، % وميسور ما يرجى لديك عسير % 2(@)(@@) % و إن كنت لا خلما ولا أنت زوجة % فلا برحت دوني عليك ستور % 3(@)(@@) % وجاورت قوما لا تزاور بينهم ، % ولا وصل إلا أن يكون نشور % 4(@)(@@) % فما أنا بالمشغوف شربة لازب ، % ولا كل سلطان علي قدير % 5(@)(@@) % وإني لطرف العين بالعين زاجر ، % فقد كدت لا يخفى علي ضمير % 6(@)(@@) % كما نظرت ، والريح ساكنة لها ، % عقاب بأرساغ اليدين ندور % 7(@)(@@) % طوت ليلتين 
ms99	 القوت عن ذي ضرورة % أزيغب لم ينبت عليه شكير % 8(@)(@@) % فأوفت على علياء حين بدالها % % من الشمس قرن ، والضريب يمور % 9(@)(@@) % يقلب طرفا في حجاجي مغارة ، % من الرأس ، لم يدخل عليه ذرور % 10(@)(@@) % تقول التي عن بيتها خف مركبي : % عزيز علينا أن نراك تسير % PageV01P469 11(@)(@@) % أما دون مصر للغنى متطلب ؟ % بلى إن أسبابض الغنى بكثير % 12(@)(@@) % فقلت لها : واستعجلتها بوادر ، % جرت ، فجرى في جريهن عبير : % 13(@)(@@) % ذريني أكثر حاسديك برحلة ، % إلى بلد فيه الخصيب أمير % 14(@)(@@) % إذا لم تزر أرض الخصيب ركابنا ، % فأي فتى ، بعد الخصيب ، تزور % 15(@)(@@) % فتى يشتري حسن الثناء بماله ، % ويعلم أن الدائرات تدور % 16(@)(@@) % فما جازه جود ، ولا حل دونه ، % ولكن يصير الجود حيث يصير % 17(@)(@@) % فلم تر عيني سؤددا مثل سؤدد ، % يحل أبو نصر به ، ويسير % 18(@)(@@) % سموت لأهل الجور في حال أمنهم ، % فأضحو وكل في الوثاق أسير % 19(@)(@@) % إذا قام غنته على الساق حلية ، % لها خطوة عند القيام قصير % 20(@)(@@) % فمن يك أمسى جاهلا بمقالتي ، % فإن ألأمير المؤمنين خبير % PageV01P470 21(@)(@@) % ومازلت توليه النصيحة يافعا % إلى أن بدا في العارضين قتير % 22(@)(@@) % إذا غاله أمر ، فإما كفيته ، % وإما عليه بالكفاء تشير % 23(@)(@@) % إليك رمت بالقوم هوج كأنما % % جماجمها ، فوق الحجاج ، قبور % 24(@)(@@) % رحلن بنا من عقرقوف ، وقد بدا % % من الصبح مفتوق الأديم شهير % 25(@)(@@) % فما نجدت بالماء حتى رأيتها % % مع الشمس في عيني أباغ تغور % 26(@)(@@) % وغمرنض من ماء النقيب بشربة ، % وقد حان من ديك الصباح زمير % 27(@)(@@) % ووافين إشراقا كنائس تدمر ، % وهن إلى رعن المدخن صور % 28(@)(@@) % يؤممن أهل الغوطتين كأنما % % لها ، عند أهل الغوطتين ، ثؤور % 29(@)(@@) % وأصبحن بالجولان يرضخن صخرها ، % ولم يبق من أجراحهن شطور % 30(@)(@@) % وقاسين ليلا دون بيسان لم يكد % سنا صبحه ، للناظرين ، ينير % PageV01P471 31(@)(@@) % وأصبحن قد فوزن من نهر فطرس ، % وهن عن البيت المقدس زور % 32(@)(@@) % طوالب بالركبان غزة هاشم ، % وفي الفرما ، من حاجهن ، شقور % 33(@)(@@) % ولما أتت فسطاط مصر أجارها % % على ركبها ، أن لا تزال ، مجير % 34(@)(@@) % من القوم 
ms100	 بسام كأن جبينه % سنا الفجر يسري ضوؤه وينير % 35(@)(@@) % زها بالخصيب السيف والرمح في الوغى ، % وفي السلم يزهو منبر وسرير % 36(@)(@@) % جواد إذا الأيدي كففن عن الندى ، % ومن دون عورات النساء غيور % 37(@)(@@) % له سلف في الأعجمين كأنهم % إذا استؤذنوا يوم السلام بدور % 38(@)(@@) % وإني جدير ، إذ بلغتك بالمنى ، % وأنت بما أملت منك جدير % 39(@)(@@) % فإن تولني منك الجميل ، فأهله ، % وإلا فإني عاذر وشكور % PageV01P472 البحر : متقارب تام 1(@)(@@) % وما أنزر الطرف فيمن نرى ، % ولو أصبحوا ملحصى أكثرا % % 2(@)(@@) % سوى رجل ضمنته الطريق ، % ونحن ضحى نقصد العسكرا % % 3(@)(@@) % فقال ، وأزكنني شاعرا ، % وأزكنته فطنا مفكرا % % 4(@)(@@) % أتنشدني بعض ما صغته ، % ولا تدع الأجود الأفخرا % % 5(@)(@@) % فأنشدته مدح البرمكي ، % أبي الفضل ، أعني الفتى جعفرا % % 6(@)(@@) % فأعجبني ظرفه ، إذ يقول : % مديحك در ، فهل دررا % % PageV01P473 البحر : هزج 1(@)(@@) % إذا أنشد داود ، % فقل أحسن بشار % 2(@)(@@) % له من شعره الغث ، % إذا ما شاء ، أشعار % 3(@)(@@) % وما منها له شيء % ألا هذا هو العار % PageV01P474 البحر : كامل تام 1(@)(@@) % لم تدر جارتنا ، ولا تدري % % أن الملامة إنما تغري % % 2(@)(@@) % هبت تلومك غير عاذرة ، % ولقد بدا لك أوسع العذر % 3(@)(@@) % واستبعدت مصرا ، ومات بعدت ، % أرض يحل بها أبو نصر % 4(@)(@@) % ولقد وصلت بك الرجاء ولي % % مندوحة ، لو شئت ، عن مصر % 5(@)(@@) % فيما تنافسه الملوك من ال % % حور الحسان ، وعاتق الخمر % 6(@)(@@) % ومحدث كثرت طرائفه ، % عان لدي بقلة الوفر % 7(@)(@@) % إني لآمل ، يا خصيب ، على % % يدك اليسارة آخر الدهر % 8(@)(@@) % وكذاك نعم السوق أنت لمن % كسدت عليه تجارة الشعر % 9(@)(@@) % أنت المبرز يوم سبقهم ، % إن الجواد بعرفه يجري % % 10(@)(@@) % علم الخليفة أن نعمته % حلت بساحة طيب النشر % PageV01P475 11(@)(@@) % كاف ، إذا عصب الأمور به ، % ماضي العزيمة ، جامع الأمر % 12(@)(@@) % فانقع بسيبك غلة نزحت % بي عن بلادي ، وارتهن شكري % % PageV01P476 البحر : كامل تام 1(@)(@@) % قولا لعباس لكي يدري % % لغلام عك قدوة المصر % 2(@)(@@) % فيما الكتاب إلي تخبرني % % بسلامة في البطن والظهر % 3(@)(@@) % وبحسن صنع الله ، يا عجبا % % لك ، في جميع الشأن والأمر % 4 