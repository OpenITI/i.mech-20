ms21	 فيه مريب % PageV01P075 11(@)(@@) % كبعض الصيد يرزق منه مخط % ويحرم خيره الرامي المصيب % 12(@)(@@) % سأغرب في الثناء على ابن فهد % فما هوفي الورى إلا غريب % 13(@)(@@) % تألق والخطوب لها ظلام % فأسفر والظلام له قطوب % 14(@)(@@) % وقد قرحت على الجود المآقي ؛ % وقد شقت على الشعر الجيوب % 15(@)(@@) % حلي من حلى الآداب يغني % % بحليته وشيمته الأديب % 16(@)(@@) % إذا شيمت بوارقه استهلت % % سماء من مواهبهتصوب % 17(@)(@@) % سمت بأبي الفوارس في المعالي % % ضرائب ما له فيها ضريب % 18(@)(@@) % فمن حزم تدين له الليالي ؛ % ومن رأي تدين به الغيوب % 19(@)(@@) % وزاد الأزد مأثرة فأمسى % % لها من كل مكرمة نصيب % 20(@)(@@) % منحت وليك النعم اللواتي % % كفته كل نائبة تنوب % PageV01P076 21(@)(@@) % وبين رحب صدرك من خلال % يضيق بوسعها الصدر الرحيب % 22(@)(@@) % فلما راق ناظرة الليالي % % شباب الأنس عاجله المشيب % 23(@)(@@) % متى يثني إليه عنان بشر % فتثني عنه أوجهها الخطوب % 24(@)(@@) % فقد نشر الثناء عليك منه % % خطيب ليس يشبهه خطيب % 25(@)(@@) % فسير منه وشيا ليس يبلى % % وأطلع منه شمسا لا تغيب % 26(@)(@@) % وقد غرست يمينك منه غرسا % فصنه أن يلم به شحوب % 27(@)(@@) % أيقرب منك ذونسب بعيد % ويبعد من له نسب قريب % 28(@)(@@) % ومدح فوقته لك المعالي % % فجاء كأنه برد قشيب % 29(@)(@@) % إذا ما صافح الأسماع يوما % تبسمت الضمائر والقلوب % 30(@)(@@) % فمن حسن الصنائع فيه حسن ؛ % ومن طيب المحامد فيه طيب % PageV01P077 31(@)(@@) % وليس يفوح زهر الروض حتى % % تفتحه شمال أوجنوب % PageV01P078 البحر : - 1(@)(@@) % عل طيفا سرى حليف اكتئاب % مطفىء من صبابة وتصاب % 2(@)(@@) % لم يذقنا حلاوة الوصل إلا % بين عتب مبرح وعتاب % 3(@)(@@) % كيف عنت لنا ظباء كناس % غادرتها النوى شموس قباب % 4(@)(@@) % كل ريم يشفي إذا رمت منه ال % % وصل حر الهوى ببرد الرضاب % 5(@)(@@) % لطمت خدها بحمر لطاف % نال منها عذاب بيض عذاب % 6(@)(@@) % يتشكى العناب نور الأقاحي % % واشتكى الورد ناضر العناب % 7(@)(@@) % نحن في معدن من اللؤم مطغ % دون عذب الندى أليم العذاب % 8(@)(@@) % قصدتنا يد الحوادث فيه % % بسهام من الخطوب صياب % 9(@)(@@) % ودعتنا إلى العراق هناة 
ms22	 % لأمور تنقض مثل العقاب % % 10(@)(@@) % كل زنجية كأن سواد ال % % ليل أهدى لها سواد الإهاب % PageV01P079 11(@)(@@) % تسحب الذيل في المسيرفتختا % % لوطورا تمر مر السحاب % 12(@)(@@) % وتشق العباب كالحية السو % داء أبقت في الرمل أثر انسياب % 13(@)(@@) % وإذا قومت رؤوس المطايا % % للسرى قومت من الأذناب % 14(@)(@@) % مهديات إلى الأمير لبابا % من ثناء يثنى من الآداب % 15(@)(@@) % زهرة غضة النسيم غذاها % % صفوماء العلوم والآداب % 16(@)(@@) % فهي كالخرد الأوانس يخلط % ن شماس الصبا بأنس التصابي % % 17(@)(@@) % رقة فوق رقة الخصر تبدي % % فطنة فوق فطنة الأعراب % 18(@)(@@) % طالبات أبا المفضل يمتت % ن إليه بأوكد الأسباب % 19(@)(@@) % خطبت وده ونائله الغم % روكم أعرضت عن الخطاب % 20(@)(@@) % ملك ما انتضى المهند إلا % % خيل بدرا يسطوبحد شهاب % PageV01P080 21(@)(@@) % خيمه في مواطن الحلمكهل % ونداه في عنفوان الشباب % 22(@)(@@) % راتع في رياض حمد أناس % رتعوا منه في رياض ثواب % 23(@)(@@) % قمر أطلعته أقمار ليل ؛ % أسد أنجبته آساد غاب % 24(@)(@@) % جلب الخيل ضمرا تلهب العش % ب إذا ما أثرن نار الضراب % 25(@)(@@) % بخميس كأنما حجب الشم % سوقد ثار نقعه بضباب % 26(@)(@@) % وكأن اللواء في الجولما % % باشرته الصبا جناحا عقاب % 27(@)(@@) % فإذا الريح نبهتهوقد أغ % ضى تبدى لها وثوب الحباب % 28(@)(@@) % في مقام للموت تحتسب الأن % فس في هبوتيه أي احتساب % 29(@)(@@) % حين أوفى على العراق طلوع ال % % بدر في ليل حادث مستراب % 30(@)(@@) % فثنى الأرض منه محمرة الأر % جاءوالأفق حالك الجلباب % PageV01P081 31(@)(@@) % آل حمدان غرة الكرم المح % ضوصفوالصريح منه اللباب % 32(@)(@@) % أشرق الشرق منهم وخلا الغر % بولم يخل من ندى وضراب % 33(@)(@@) % نزلوا منه منزلا وسموه % بالندى فهو موسم الطلاب % 34(@)(@@) % ينجلي السلم عن بدور رواض % فيهوالحرب عن أسود غضاب % 35(@)(@@) % جادنا منهم سحائب جود % أنشأتها جنوب ذاك الجناب % 36(@)(@@) % فحملنا ملء الحقائب من أف % واف مدح يبقى على الأحقاب % 37(@)(@@) % واستقلت بنا سواع تخوض ال % % بحر خوض النسور بحر السراب % 38(@)(@@) % شتتت شملها الشمالوأمست % % كالغرابيب عذبت باغتراب % PageV01P082 البحر : - 1(@)(@@) % أتظن أن الدهر يسعف طالبا % أوتعتب الأيام منا عاتبا % % 2 
ms23	(@)(@@) % فقد النوالفعاد برقا خلبا % ومضى السماحفعاد وعدا كاذبا % 3(@)(@@) % وطوى الردى شيم ابن فهد بعدما % % نشرت بدائع سؤدد وغرائبا % % 4(@)(@@) % ليت الردى لما سما لك جحفل % ملأ البلاد أسنةوقواضبا % % 5(@)(@@) % فيؤوب مغلوبا لديك مذمما % وتؤوب محمود السجية غالبا % % 6(@)(@@) % يبكيك عزم لم يزل إشراقه % % في كل مظلمة شهابا ثاقبا % % 7(@)(@@) % وسماء مجد إن تغيم أفقها % % أطلعت فيها بالسيوف كواكبا % % 8(@)(@@) % ورغائب شيدتها بمواهب % لوأنهن نطقن قمن خواطبا % % 9(@)(@@) % في مضجع وسع الحسين وجوده % % يسع البلاد مشارقا ومغاربا % % 10(@)(@@) % لوأن قبرا جاد ساكن لحده % لم يرجع المرتاد منه خائبا % % PageV01P083 البحر : - 1(@)(@@) % لأبي الفوارس في السماح مآرب % تقضى فتقضي للعفاة مآربا % % 2(@)(@@) % ملك أبر على الملوك بهمة % زيدت بها الأزد الكرام مناقبا % % 3(@)(@@) % وأغر يحسن منظرا وضرائبا % كالسيف يحسن رونقا ومضاربا % % 4(@)(@@) % ومناسب السيف الحسامفإن جرى % % في الجود أصبح للسحاب مناسبا % % 5(@)(@@) % شيم كأنفاس الرياح جرت على % % زهر الربيع شمائلا وجنائبا % % 6(@)(@@) % طلب العفاة نوالهفبدا لهم % % متهللا للحمد منهم طالبا % % 7(@)(@@) % ورأى الزمان عليهم متعتبا % فغدا له بالمكرمات معاتبا % % 8(@)(@@) % كم قد رأيت لبشره من شارق % يحتث من جدوى يديه سحائبا % % 9(@)(@@) % فأريته زهر الربيع مدائحا % ورأيت منه حيا الربيع مواهبا % % PageV01P084 البحر : - 1(@)(@@) % تحية الغيث منهلا سحائبه % % على العقيق وإن أقوت ملاعبه % % 2(@)(@@) % لا بل على الحي منشودا هوادجه % % على الشموس ومذموما ركائبه % % 3(@)(@@) % حتى ترد عليه آية سلكت % ظباؤها الغيدأوحلت ربائبه % % 4(@)(@@) % ففي الظعائن مجنوب لغانية % تغنى بوصل سواهأوتجانبه % % 5(@)(@@) % وفي الديار سميع ليس تسمعه % % إجابة وخطيب لا تخاطبه % % 6(@)(@@) % حتى تبدل للعشاق زورته % % طيف يصد عن العشاق صاحبه % % 7(@)(@@) % سرى إلى البدر يخفي البدر منتقبا % والبدر يأنف أن تخفي مناقبه % % 8(@)(@@) % إذا بدا الصبح من إشراق طلعته % % أبدت لك الليل مسودا ذوائبه % % 9(@)(@@) % والحسن ضدان لا أدري إذا اجتمعا % % أنواره فتنتني أم غياهبه % % 10(@)(@@) % حليه وثناياه وعنبره % % كل ينم عليه أو يراقبه % % PageV01P085 11(@)(@@) % فلست أدريإذا ما سار في أفق % شمائل الأفق أذكى أم جنائبه % % 12(@)(@@) % أما القريضفما تحظى محاسنه % % عند 
ms24	 الملوك كما تحظى معائبه % % 13(@)(@@) % وربما ظلم الدينار ناقده % % وقد كساه ضروب الحسن ضاربه % % 14(@)(@@) % كأنني بنجيب الشعر قد رحلت % عنهم إلى الشرف الأعلى نجائبه % % 15(@)(@@) % ولو تشاءم لانقضت صواعقه % % على العراق كما ارفضت سحائبه % % 16(@)(@@) % قل للذي قلدتني كفه رسني % % وكنت أدنوإليهوهوجاذبه % % 17(@)(@@) % لك الأمان إذا انسابت أراقمه % % من المكامن أو دبت عقاربه % % 18(@)(@@) % ليس الصديق الذي أعطاك شاهده % % شهد الوداد وخان الغيب غائبه % % 19(@)(@@) % كم منطق كسحيق المسك ظاهره % % لم يقض عند أبي إسحاق واجبه % % 20(@)(@@) % كانت مدائحنا غرا محجلة % تثني عليهفقد أضحت تعاتبه % % PageV01P086 21(@)(@@) % وما أقول لمن طابت عناصره % % في رتبة المجدوابيضت مناسبه % % 22(@)(@@) % أغر زان مديحي فضل سؤدده % % كلؤلؤ العقد زانته ترائبه % % 23(@)(@@) % وصادق الود لا ترتد خلته % % على الصديقولا يزور جانبه % % 24(@)(@@) % لا أستريح إلى زور ولا كذب % يهدى إليهوشر القول كاذبه % % 25(@)(@@) % وليس للذم فيه مذهب فيرى % % أنى ومن ذهب صيغت مذاهبه % % 26(@)(@@) % نبا عليفما أدري لنبوته % % أنياب دهري أمضى أم نوائبه % % 27(@)(@@) % هو الحسام لقوم ماء صفحته % % بشاشة ولأقوام مضاربه % % 28(@)(@@) % والغيث إن برقت نحوي مخائله % % راحت تصوب على غيري صوائبه % % 29(@)(@@) % هذا وما صدئت قدما مسامعه % % بما نظمتولا ضاعت مواهبه % % 30(@)(@@) % ولي من الأدب المحمود أثمره % % ينمى إليه وأعراف تناسبه % % PageV01P087 31(@)(@@) % ورغبة كلما جاءت معرضة % بجاهه أعرضت عنها رغائبه % % 32(@)(@@) % وكم ضربت بماض منه ذي شطب % عضب مضاربه حلوضرائبه % % 33(@)(@@) % وردت في طيب الأنفاس ذي ثمر % قريبة من يد الجاني أطايبه % % 34(@)(@@) % عاقبتني بجفاء لا أقوم به % % فهل عقابك محمود عواقبه % % 35(@)(@@) % وعاد رأيك لي سودا مشارقه % % وكنت أعهده بيضا مغاربه % % 36(@)(@@) % الشعر وشي برود أنت ساحبه % % فهما ودر عقود أنت ثاقبه % % 37(@)(@@) % فلم منعت على الإحسان محسنه % % ما نال من جاهك المبذول خاطبه % % 38(@)(@@) % وزاهر الحمد إن أنصفته زهر % يطيب رياهإن طابت مشاربه % % 39(@)(@@) % أكان في العدل أن تظما حدائقه % % بساحتيك وأن تروى سباسبه % % 40(@)(@@) % لقد نثرت على قوم حصى كلم % لوشئت لآنتثرت فيكم كواكبه % % PageV01P088 41(@)(@@) % لولاك ما ارتديت أطمارهوغدت % % تردوهي 
ms25	 أنيقات سبايبه % % 42(@)(@@) % لأصبرن على إخلال عرفك بي % % حتى يثوب إلى المعهود ثائبه % % 43(@)(@@) % عسى العتاب يرد العتب منك رضا % وربما أدرك المطلوب طالبه % % PageV01P089 البحر : - 1(@)(@@) % هذه الشمس أوشكت أن تغيبا % % فأقلا الملام والتأنيبا % % 2(@)(@@) % أوجبت لوعة الفراق على الصب % ب جوى يقرح الفؤاد وجيبا % % 3(@)(@@) % لن يرى غالب الصبابة حتى % % يدع اللوم في الهوى مغلوبا % % 4(@)(@@) % حث غرب من المدامع غربا % حين رامت تلك الشموس الغروبا % % 5(@)(@@) % أعرضت خيفة الرقيبولولا % % ه لكان الإعراض منها رقيبا % % 6(@)(@@) % وأرته برق الثغورفأبدى % % بارق الشوق في حشاه لهيبا % % 7(@)(@@) % والثنايا العذاب تثني على الوج % د الحشا أوتضاعف التعذيبا % % 8(@)(@@) % حي ربعا لهن يزداد حسنا % ومحلا منهن يزداد طيبا % % 9(@)(@@) % سلبته النوى بدور تمام % تركتني من العزاء سليبا % % 10(@)(@@) % قد قطعن البلاد شرقا وغربا % وبلونا الورى فتوا وشيبا % % PageV01P090 11(@)(@@) % ونزلنا بكل مجتذب المن % % زل نرعى لديه ربعا جديبا % % 12(@)(@@) % قرب الوعدوالنوال بعيد % فأراني النوى بعيدا قريبا % % 13(@)(@@) % فدعونا أبا الفوارس للجو % % دفكان القريب فيه المجيبا % % 14(@)(@@) % وهززناه للمكارم فاهتز % كما هزت الرياح القضيبا % % 15(@)(@@) % فرأينا مهذب الفعل يكسى % % حلل المدح هذبت تهذيبا % % 16(@)(@@) % ونسيب الحسام أسرف في الجو % % د فخلناه للسحاب نسيبا % % 17(@)(@@) % يا غريب السماح والمجد والسؤ % % دد أصبحت في الأنام غريبا % % 18(@)(@@) % ملك عدت الملوك من الأز % % دفكان الشريف منها الأديبا % % 19(@)(@@) % راح يبدي لمن أتى مستجيرا % من صروف الزمان أو مستثيبا % % 20(@)(@@) % خلقا مشرقا ووجها طليقا % ونوالا جزلا ورأيا صليبا % % PageV01P091 21(@)(@@) % قمر لاح في سحابة جود % منه ما زال ذيلها مسحوبا % % 22(@)(@@) % ورأى البدر في دجاه حميدا % والحيا في أوانه محبوبا % % 23(@)(@@) % كلما مدت الحوادث باعا % مد للمكرمات باعا رحيبا % % 24(@)(@@) % وإذا خاض غمرة الموت رد الس % سيف من غمرة الدماء خضيبا % % 25(@)(@@) % شيم لا تزال تشجي قلوبا % من أعاديهأوتسر قلوبا % % 26(@)(@@) % وخلال أغض من زهر الرو % ض كسته الثناء غضا قشيبا % % 27(@)(@@) % فاطلب المكرمات بالحمد منه % % تجد الحمد عنده مطلوبا % % 28(@)(@@) % يا بن فهد أحلني جود كفي % ك محلا رحب 
ms26	 الجناب رحيبا % % 29(@)(@@) % أنت أضحكت لي الزمان فأبدى ال % % بشر منهوكان يبدي القطوبا % % 30(@)(@@) % فمتى لم أقم بشكرك في النا % % س خطيبا فلا وقيت الخطوبا % % PageV01P092 البحر : - 1(@)(@@) % لقد طمع البشري في ولم يكن % ليطمع في المرء وهو لبيب % 2(@)(@@) % خلعت عليه من ثنائي خلعة % تحن إليها أنفس وقلوب % 3(@)(@@) % فقطب حتى خلت أن قد وسمته % وذواللؤم فيه ضجرة وقطوب % 4(@)(@@) % وقاسمني جود الأمير كأنما % % له في القوافي السائرات نصيب % PageV01P093 البحر : - 1(@)(@@) % أرى الشاعر الملحي راح بنا صبا % % نباغضه عمدا فيوسعنا حبا % % 2(@)(@@) % دعانا ليستوفي الثناء فأظلمت % خلائق تستوفي لصاحبها السبا % % 3(@)(@@) % تيمم كرخايافجاد قليبها % % عليه وما شرب القليب لنا شربا % % 4(@)(@@) % وأحضرنا محبوسة طول ليلها % % معذبة بالنار مسعرة كربا % % 5(@)(@@) % تحتت من رطب الذؤابة لحمها % % ومن يابس الحب الثقيل لها الحبا % % 6(@)(@@) % وساهرها ليلا يضيق سجنها % % فلما أضاء الصبح أوسعها ضربا % % 7(@)(@@) % إذا مسحتها الريح راحت كأنما % % تمسح موتى كشفت عنهم التربا % % 8(@)(@@) % وداذنة تنهى الصباحإذا بدا % % وتفسد أنفاس النسيمإذا هبا % % 9(@)(@@) % شراب يفض الطين عنهإذا بدا % % ثلاثة أيام وقد شب لا شبا % % 10(@)(@@) % يمد بأطراف النهاروما افترى % % ولا كان خدنا للزناة ولا تربا % % PageV01P094 11(@)(@@) % فلما تراءت للجميع حبالنا % % عجبت لمضروبين لا جنيا ذنبا % % PageV01P095 البحر : - 1(@)(@@) % تناهى فاطمأن إلى العتاب % وأحسن للعواذل في الخطاب % 2(@)(@@) % وسار جنيب غصن غير رطب % وكان جنيب أغصان رطاب % 3(@)(@@) % خلت منه ميادين التصابي % % وعري منه أفراس الشباب % 4(@)(@@) % وزهده خضاب الناس لما % % تولى عنه في زور الخضاب % 5(@)(@@) % ورد كؤوسه في الحلي تجلى % % وكان يردها عطل الرقاب % 6(@)(@@) % وأيقن أنه ظفر الليالي % % تبين في شبا ظفر وناب % 7(@)(@@) % وإن غادرت مصباحا ضئيلا % فقد ساورن أثقب من شهاب % 8(@)(@@) % رأيت رداءه عبئا عليه % % وسهل طريقه حزن الشعاب % 9(@)(@@) % كأن لم يغن فتيان العوالي % % بنجدتهوفتيان التصابي % % 10(@)(@@) % ولم يعدل صفاء العيش فيهم % % وبعضهم قذاة في شراب % PageV01P096 11(@)(@@) % ورب معصفرات القمص طافت % عليه بها معصفرة النقاب % 12(@)(@@) % وألفاظ له عذبتفأغنت % غناء الراح بالنطف العذاب % 13(@)(@@) % يكررها على 
ms27	 راووق فكر % فيبعثها كرقراق السراب % 14(@)(@@) % وخرق طال فيه السير حتى % % حسبناه يسير مع الركاب % 15(@)(@@) % صحبنا فيه ترحات التنائي % % على ثقة بفرحات الإياب % 16(@)(@@) % إلى الخرق الذي يلقى الأماني % % رحيب الصدر منه والرحاب % 17(@)(@@) % لقد أضحت خلال أبي حصين % حصونا في الملمات الصعاب % 18(@)(@@) % كساني ظل نائلهوآوى % % غرائب منطقي بعد اغتراب % 19(@)(@@) % فكنت كروضة سقيت سحابا % فأثنت بالنسيم على السحاب % 20(@)(@@) % عطاء يستهل البشر فيه % % فيبعثه انسكابا في التهاب % PageV01P097 21(@)(@@) % كما سارت مؤلفة الهوادي % % بلمع البرق مذهبة الرباب % 22(@)(@@) % تجرد للجهادفكان عضبا % حديد الحد فيه غير نابي % % 23(@)(@@) % ينازل مصلتا من كل أوب % ويدخل معلما من كل باب % 24(@)(@@) % وأشيب عاين العلياء طفلا % فقارع قبل تقريع العتاب % 25(@)(@@) % وحرم مسمعيه على الملاهي % % وهداب الإزار على التراب % 26(@)(@@) % يروعكوهومصقول السجايا % % إذا ما هز مصقول الذباب % 27(@)(@@) % وقد شغلت كعوب الرمح منه % % يديه عن ملامسة الكعاب % 28(@)(@@) % وخف عليه ثقل الدرع حتى % % كأن دروعه سرق الثياب % 29(@)(@@) % وكم خرق الحجاب إلى مقام % توارى الشمس فيه بالحجاب % 30(@)(@@) % إذا شنت به الغارات كانت % % نفوس المعلمين من النهاب % PageV01P098 31(@)(@@) % كأن سيوفه بين العوالي % % جداول يطردن خلال غاب % 32(@)(@@) % وخيل قادها في جنح ليل % تطير بوطئها نار الضراب % 33(@)(@@) % إذا مرقت من الظلماء أذكت % على المراق ثائرة العذاب % 34(@)(@@) % وقرن شام صفحتهفعادى % % صفيحة سيفه عند الضراب % 35(@)(@@) % وقد وضحت سطور البيض فيه % % كما وضحت سطور في كتاب % 36(@)(@@) % مناقب تملأ الحساد غيظا % وتغني الطالبين عن الطلاب % 37(@)(@@) % وحكم تفرق الأعداء منه % % كأنك فيه فاروق الصحاب % % 38(@)(@@) % يودك فيه من تقضي عليه % % لشافي الحكم أوكافي الصواب % 39(@)(@@) % إليك زففتها عذراء تأوي % % حجاب القلب لا حجب النقاب % 40(@)(@@) % أذبت لصوغها ذهب القوافي % % فأدت رونق الذهب المذاب % PageV01P099 41(@)(@@) % تهاداها الملوك كما تهادت % أكف البيض منظوم السحاب % 42(@)(@@) % تروقكوهي ناجمة المعاني % % كما راقتك ناجمة الحباب % PageV01P100 البحر : - 1(@)(@@) % حسب الأمير سماح وطد الحسبا % % ورتبة في المعالي فاتت الرتبا % % 2(@)(@@) % أعطى فقال العفاة النازلون به % % أنائلا أنشأت كفاه أم سحبا 
ms28	 % % 3(@)(@@) % أغر لا يتحامى قرنه بدا % حتى يرد غرار السيف مختضبا % % 4(@)(@@) % كالليث لا يسلب الأعداء بزهم % في الروع لكن ترى أرواحهم سلبا % % 5(@)(@@) % لا يعرف الغدر ما ضمت جوانحه % % على الوفاءولا يبقي إذا وثبا % % 6(@)(@@) % أما عدي فقد عدته سيدها % % نجابةوهي تدعى السادة النجبا % % 7(@)(@@) % أسد إذا حاولت أرض العدا حملت % على الكواهل أما برة وأبا % % 8(@)(@@) % لما هممت بآثار مجددة % حدوت للحاسد الأحزان والكربا % % 9(@)(@@) % أنشأته منزلا في قلب دجلة لا % % تمتاح جنته الغدران والقلبا % % 10(@)(@@) % صفا الهواء به والماء فاشتبها % % كأن بينهما من رقة نسبا % % PageV01P101 11(@)(@@) % وأصبح الغيث مخلوع العذار به % % فليس يخلع أبراد الحيا القشبا % % 12(@)(@@) % فمن جنان تريك النور مبتسما % في غير إبانهوالماء منسكبا % % 13(@)(@@) % ومن سواق على خضراء تحسبها % % مخضرة البسط سلوا فوقها القضبا % % 14(@)(@@) % كأن دولابهاإذ حنمغترب % نأى فحن إلى أوطانه طربا % % 15(@)(@@) % باك إذا عق الروض والده % % من الغمامغدا فيه أبا حدبا % % 16(@)(@@) % مشمر في مسير ليس يبعده % عن المحلولا يهدي له تعبا % % 17(@)(@@) % ما زال يطلب رفد البحر مجتهدا % للبر حتى ارتدى النوار والعشبا % % 18(@)(@@) % فالنخل من باسق فيه وباسقة % يضاحك الطلع في قنوانه الرطبا % % 19(@)(@@) % أضحت شماريخه في الجومطلعة % إما ثرياوإما معصما خضبا % % 20(@)(@@) % تريك في الظل عقيانا فإن نظرت % شمس النهار إليها خلتها لهبا % % PageV01P102 21(@)(@@) % و الكرم مشتبك الأفنان توسعنا % % أجناسه في تساوي شربها عجبا % % 22(@)(@@) % فكرمة قطرت أغصانها سبجا ؛ % و كرمة قطرت أغصانها ذهبا % % 23(@)(@@) % كأنما الورق المخضر دونهما % % غيران يكسوهما من سندس حجبا % % 24(@)(@@) % و الماء مطرد فيه ومنعرج % كأنما ملئت حياته رعبا % % 25(@)(@@) % و بركة ليس يخفي موج لجتها % % من القذى ما طفا فيها وما رسبا % % 26(@)(@@) % تسدي عليها الصبا بردا فإن ركدت % رأيته دارس الأفواف مستلبا % % 27(@)(@@) % قد كالمت بنجوم للحباب ضحى % % فإن دجا الليل عادت أنجما شهبا % % 28(@)(@@) % ترى الإوز سروبا في ملاعبها % % كما تأملت في ديباجة لعبا % % 29(@)(@@) % يرف منه على أمواجها زهر % أربى على الزهر حتى عاد مكتئبا % % 30(@)(@@) % مسلم و سباع 
ms29	 الطير حائمة % يخطفن ما طار في الآفاق أو سربا % % PageV01P103 31(@)(@@) % كأنما الجارح المرهوب يحذره % % فليس يوفي عليه جارح ذهبا % % 32(@)(@@) % و سهم فوارة ما ارتد رائده % % حتى أصاب من العيوق ما طلبا % % 33(@)(@@) % أوفى ولم تثنه حرب الشمالو قد % % لاقتهفاعتركا في الجو واحتربا % % 34(@)(@@) % كأن بركته درع مضاعفة % تقل رمح لجين منه منتصبا % % 35(@)(@@) % و القصر يبسم في وجه الضحى فترى % % وجه الضحى عندما أبدى لنا شحبا % % 36(@)(@@) % يبيت أعلاه بالجوزاء منتطقا % و يغتدي برداء الغيم محتجبا % % 37(@)(@@) % تطأمن نحوه الإيوان حين سما % % ذلا فكيف تضاهي فارس العربا % % 38(@)(@@) % إذا القصور إلى أربابها انتسبت % أضحى إلى القمة العلياء منتسبا % % 39(@)(@@) % فصله لا وصلتك الحادثاتو لا % % زالت سعودك فيه تنفذ الحقبا % % 40(@)(@@) % بر وبحر وكثبان مدبجة % ترى النفوس الأماني بينها كثبا % % PageV01P104 41(@)(@@) % و منزل لا تزال الدهرعقوته % % جديدة الروض جد الغيث أو لعبا % % 42(@)(@@) % حصباؤه لؤلؤ نثر و تربته % % مسك ذكي فلو لم تحمه انتهبا % % 43(@)(@@) % و كل ناحية منه زبرجدة % أجرى اللجين عليها جدولا سربا % % 44(@)(@@) % فإن دعاك إليه ذكر مأدبة % فما نشأتو فيها للعلى أدبا % % 45(@)(@@) % و إن دعاك له ظل فرب وغى % جعلت ظلك منها السمر والعذبا % % 46(@)(@@) % لا تكذبن فإني في مدائحكم % % مصدق القوللا أستحسن الكذبا % % 47(@)(@@) % من رام في الشعر شأوي كل عنهو من % ناوى أبا تغلب في سؤدد غلبا % % PageV01P105 البحر : - 1(@)(@@) % نسالم هذا الدهرو هو لنا حرب % و نعتبو الأيام شيمتها العتب % 2(@)(@@) % و نخطب صلح النائباتو لم يزل % % لأنفسنا من خطبها أبدا خطب % 3(@)(@@) % تهم بنا أفراسها وسيوفها % % فلا هذه تكبو ولا هذه تنبو % % 4(@)(@@) % و كنا نعد المشرفية والقنا % % حصونا إذا هزت مضاربها الحرب % 5(@)(@@) % فلما مضى المقدار قل غناؤها % % فلم يمض حد من ظباهاو لا غرب % 6(@)(@@) % تبلد هذا الدهر فيما نرومه % % على أنهفيما نحاذره ندب % 7(@)(@@) % فسير الذي يرجوه سير مقيد % و سير الذي يخشى غوائله وثب % 8(@)(@@) % إذا فاجأتنا الحادثات بمصرع % فليس سوى الجنب الكريم لنا جنب % 9(@)(@@) % فعز الأمير 
ms30	 التغلبي ورهطه % % بمن غربت عنه الغطارفة الغلب % 10(@)(@@) % بسيدة عمت صنائعها الورى % % فأعرب عن معروفها العجم والعرب % PageV01P106 11(@)(@@) % و مشرفة الأفعال لم يحو مثلها % % إذا عدد النسوانشرق ولا غرب % 12(@)(@@) % تساوت قلوب الناس في الحزنإذ ثوت % كأن قلوب الناس في موتها قلب % 13(@)(@@) % و كانت سهول الأرض دون هضابها % % فلما حواها السهل ذل له الصعب % 14(@)(@@) % فإن كانفيمن غيب التربتربها % % فمريممن دون النساءلها ترب % 15(@)(@@) % و طوبى لماء المزن لو أن ظهرها % % لريقه ما فاض ريقه السكب % 16(@)(@@) % و أقسم لو زادت على المسك تربة % لزاد على المسك الذكي بها الترب % 17(@)(@@) % فضائل ينفدن الثناء كأنما % % ثناء ذوات الفضل من حسنها ثلب % 18(@)(@@) % لقد جاورت من قوم يونس معشرا % أحبت بروح لا يجاوره كرب % 19(@)(@@) % فقد بردت تلك المضاجع منهم % % فأشرق ذاك النور فيها فما يخبو % % 20(@)(@@) % فلله ما ضم الثرى من عفافها % % و ما حجبتها من طهارتها الحجب % PageV01P107 21(@)(@@) % لئن كان وادي الحصن رحبا لقد ثوى % % بعرصته المعروف والنائل الرحب % 22(@)(@@) % و إن عذبت رياهأو طاب نشره % % فقد مل في بطحائها الكرم العذب % 23(@)(@@) % عجبت له أنى تضمن مثلها % % و لا كبر يعروه ذاكو لا عجب % 24(@)(@@) % و لو علمت بطحاؤه ما تضمنت % % تطاولت البطحاء وافتخر الشعب % 25(@)(@@) % تذال مصونات الدموع إزاءها % % و تمشي حفاة حولها الرجل والركب % 26(@)(@@) % فلا زال رطب الروض من ريق الندى % % كأن الندى من فوقه اللؤلؤ الرطب % 27(@)(@@) % أبا تغلب صبرا و مازلت صابرا % إذا زلحزم ثابت أو هفا لب % 28(@)(@@) % فقد أعقبت منكم أسود شجاعة % و كم معقب في الناس ليس له عقب % 29(@)(@@) % و أنتم جناب المكرماتو لم يكن % % لتهفو رواسيهاو إن عظم الخطب % 30(@)(@@) % فكل حيا للجود أنتم سحابه ؛ % و كل رحى للحرب أنتم لها قطب % PageV01P108 31(@)(@@) % و لو أنه غير الحمام صببتم % % عليه سحابا قطره الطعن والضرب % 32(@)(@@) % أرى أرضكم أضحت سماء بعزكم % % فأنتم لها الأقمارو الأنجم الشهب % 33(@)(@@) % تموت عداكم قبل سل سيوفكم % % و يفنيهم من قبل حربكم الرعب 
ms31	 % 34(@)(@@) % و كيف تنال الحرب منكمو إنما % % بأمركم تمضي العوامل والضرب % 35(@)(@@) % إذا أنت كاتبت العدا مثلت لها % % ظباكفنابت عن كتائبك الكتب % 36(@)(@@) % دعانا الأمير التغلبي إلى الندى % % فنحن له شرب الندى و هو الشرب % 37(@)(@@) % نصاحب أياما له عدوية % محاسن أيام الشباب لها صحب % 38(@)(@@) % هو الغيث نال الخافقين نواله % % إلى أن تساوى عنده البعد والقرب % 39(@)(@@) % يزور الندى زواره متواترا % عليهمو زوار الحيا أبدا غب % 40(@)(@@) % أأعداءه كفوا فإن نصيبكموليس على البحر الذي راح زاخرا ملام إذا لم % % إذا رمتم إدراك غايته النصبسقط بيت % % PageV01P109 41(@)(@@) % و هل يستوي عذب المياه وملحها % % و هل يتكافا الخصب في الأرض والجدب % 42(@)(@@) % فإن عجز الأقوام أو بان نقصهم % % فليس لمن بانت فضيلته ذنب % 43(@)(@@) % رأيتك طبا للقريضو لم يكن % % لينظمه إلا الخبير به الطب % 44(@)(@@) % و لا بد أن أشكو إليك ظلامة % و غارة مغوار سجيته الغصب % 45(@)(@@) % تخيل شعري أنه قوم صالح % هلاكا و أن الخالدي له السقب % 46(@)(@@) % رعى بين أعطان له ومسارح % و لم يرع فيهن العشار ولا النجب % 47(@)(@@) % و كان رياضا غضةفتكدرت % مواردها واصفر في تربها العشب % 48(@)(@@) % تساق إلى الهجر المعارف خيله % وتسبله الغر المحجلة القب % 49(@)(@@) % غضبت على ديباجه وعقوده % % فديباجه غصب وجوهره نهب % 50(@)(@@) % و أبكارها شتى أذيل مصونها % % و ريعت عذاراها كما روع السرب % PageV01P110 51(@)(@@) % يعريكم من عصبه وبروده % % عصائب شتى لا يليق بها الغصب % 52(@)(@@) % فإن ريع سربي أو تمرد دونه % % و لم ينجني منه الحماية والذب % 53(@)(@@) % فعندي هناء للعدو يهينه % % إذا اختلفت منه خلائقه الجرب % 54(@)(@@) % فكنتإذا ما قلت شعرا حدت به % % حداة المطايا أو تغنت به الشرب % PageV01P111 البحر : - 1(@)(@@) % شفاه قربا وقد أشفى على العطب % خيال نائية حياه من كثب % 2(@)(@@) % ألم يتحفه بالورد من خفر % في وجنتيهو بالصهباء من شنب % 3(@)(@@) % فبات عذب الرضا والظلم ليلته % % و ربما بات مر الظلم والغضب % 4(@)(@@) % إذا تجلى جلا الخدين في خفر % و إن تثنى ثنى العطفين من تعب % 5 
ms32	(@)(@@) % و كيف بالجد منهاو هي لاعبة % تهدي إلى الصب جد الشوق في اللعب % 6(@)(@@) % تعرضت لي في بيض السوالف لا % % يسلفن وعدا و لا يقرفن بالريب % 7(@)(@@) % من بارز بحجاب الصون محتجب % و سافر بنقاب الورد منتقب % 8(@)(@@) % حتى كأن سجوف الرقم ضاحية % تكشفت عن دمى منهن أو لعب % 9(@)(@@) % هلا ونحن على كثب اللوى اعترضت % % تلك المحاسن من قضب ومن كثب % 10(@)(@@) % أيام لي في الهوى العذري مأربة % و ليس لي في هوى العذال من أرب % PageV01P112 11(@)(@@) % سقى الغمام رباها دمع مبتسم % و كم سقاها التصابي دمع مكتئب % 12(@)(@@) % و لو حمدت بها الأيام قلتسقى % % ربوعها أحمد المحمود في النوب % 13(@)(@@) % سأبعث الحمد موشيا سبايبه % % إلى الأمير صحيحا غير مؤتشب % 14(@)(@@) % إن المدائح لا تهدى لناقدها % % إلا وألفاظها أصفى من الذهب % 15(@)(@@) % كم رضت بالفكر منها روضة أنفا % تفتح الزهر منها عن جنى الأدب % 16(@)(@@) % إذا الرجا هز أرواح الكلام بها % % أتتك أحسن من مهتزة القصب % 17(@)(@@) % لفظ يروح له الريحان مطرحا % إذا جعلناه ريحانا على النخب % 18(@)(@@) % أما تراه أبا العباس معترضا % على السها ويدي تجنيه من قرب % 19(@)(@@) % خطى المكارم فرد الحسن مغتربا % يلوذ منه بفرد الجود مقترب % 20(@)(@@) % مقسم بين نفس حرة ويد % مقابل بين أم برة وأب % PageV01P113 21(@)(@@) % مصباح خطب له في كل مظلمة % صبح من العز أو صبح من الحسب % 22(@)(@@) % إذا بلونا عديا يوم عادية % كانت ضرائبها أحلى من الضرب % 23(@)(@@) % قوم هم البيض أفعالا إذا اطردت % جداول البيض في غاب القنا الأشب % 24(@)(@@) % راح الصيامفولى عنك منقضبا % ورحت عنه بأجر غير منقضب % 25(@)(@@) % فعاد فطرك في نعماء سابغة % و في سعود إليها ساقة الحقب % 26(@)(@@) % أتاك والجو يجلى في ممسكة % و الأرض تختال في أبرادها القشب % 27(@)(@@) % إذا ألح حسام البرق مؤتلقا % في الروض جد خطيب الرعد في الخطب % 28(@)(@@) % فللخمائل بسط غير زائلة % و للسحائب ظل غير مستلب % 29(@)(@@) % تملها يا ابن نصر فهي سيف وغى % ماضي الظبا وشهاب ساطع اللهب 
ms33	 % 30(@)(@@) % تسريفتخفق أحشاء العدو لها % % كأنها راية خفاقة العذب % PageV01P114 31(@)(@@) % تكاد تبرق لو أن الثناء له % % كتيبة برقت من قبل في الكتب % 32(@)(@@) % فلو هتفت بها في يوم ملحمة % قامت مقام القنا والبيض واليلب % PageV01P115 البحر : - 1(@)(@@) % أهون علي بعبد الله إن غضبا % % فما له عندي العتبى إذا عتبا % % 2(@)(@@) % كسوته حبرات المدح مذهبة % و قلت قد ملئت كفي به ذهبا % % 3(@)(@@) % و قد ضربت بسيف مرهف فنبا % % و قد قدحت بزند مضرم فخبا % % 4(@)(@@) % حتى إذا الإذن من نجواه قربني % % و رفع الحاجب الأستار والحجبا % % 5(@)(@@) % و قفت بين يدي نجواه من حمق % أصب في أذنيه الزور والكذبا % % 6(@)(@@) % إذا وعى المدح لم يطرب لبهجته % % و إن تصافع قوم عنده طربا % % PageV01P116 البحر : - 1(@)(@@) % هي الدنيا وزينتها الشباب % و في اللذات بعدهما ارتياب % 2(@)(@@) % فلا تذهب بك الأطماع واذهب % كؤوسك لي فقد حان الذهاب % 3(@)(@@) % نزلنا منزلا من سرمرى % % به اللذات صافية عذاب % 4(@)(@@) % حديث كابتسام الروض جادت % عليه بفيض أدمعها السحاب % 5(@)(@@) % و أقداح تفوح المسك طيبا % ويكمد عندها الذهب المذاب % 6(@)(@@) % إذا ما الراح والأترج لاحا % % لعينك قلت أيهما الشراب % PageV01P117 البحر : - 1(@)(@@) % هفا طربا في أوان الطرب % فأنخب أقداحه بالنحب % 2(@)(@@) % و غنى ارتياحا إلى عارض % يغني وعبرته تنسكب % 3(@)(@@) % غيوم تمسك أفق السما % % وبرق يكتبها بالذهب % % 4(@)(@@) % وخضراء تنثر فيها الصبا % % فريد ندى ما له من ثقب % % 5(@)(@@) % فأنوارها مثل نظم الحلى % % وأنهارها مثل بيض القضب % % 6(@)(@@) % شهدت بها في ندامى سلوا % % عن الجد واستهتروا باللعب % % 7(@)(@@) % وأغناهم عن بديع السماع % % بدائع ما ضمنته الكتب % % 8(@)(@@) % و أحسن شيء ربيع الحيا % % أضيف إليه ربيع الأدب % % PageV01P118 البحر : - 1(@)(@@) % الماء يلعب كالأراقم موجه % % والسفن بالأذناب فيه عقارب % 2(@)(@@) % و الصوت من دولاب كل متوج % أطفال زنج للرضاع نوادب % 3(@)(@@) % فانظر إليه كأنهو كأنما % % كيزانهوالماء منها ساكب % 4(@)(@@) % فلك يدور بأنجم جعلت له % % كالعقد فهي شوارق وغوارب % PageV01P119 البحر : - 1(@)(@@) % جاءت هديتك التي % % هي شمسنا بعد الغياب % % 2(@)(@@) % حليت أفق محلنا % % منها 
ms34	 بنجم أو شهاب % % 3(@)(@@) % بسليلة النحل الكري % % مشقيقة النطف العذاب % % 4(@)(@@) % صفر الجسومكأنما % % صيغت من الذهب المذاب % % 5(@)(@@) % فكأن ماء الحسنإذ % % شرقت بهماء الشباب % % 6(@)(@@) % فإذا ذكت نيرانها % % ليلا و جدت في التهاب % % 7(@)(@@) % أنساك طيب دخانها % % طيب العبير أو الملاب % % 8(@)(@@) % و إذا عرتها مرضة % فشفاؤها ضرب الرقاب % % 9(@)(@@) % تثني الدجى عن لونه % % فيعود مبيض الحجاب % 10(@)(@@) % لولا غرائب فعلها % % لارتد في لون الغراب % % PageV01P120 البحر : - 1(@)(@@) % بكرت عليك مغيرة الأعراب % فاحفظ ثيابك يا أبا الخطاب % 2(@)(@@) % ورد العراق ربيعة بن مكدم % و عتيبة بن الحارث بن شهاب % 3(@)(@@) % أفعندنا شك بأنهما هما % % في الفتك لا في صحة الأنساب % 4(@)(@@) % جلبا إليك الشعر من أوطانه % % جلب التجار طرائف الأجلاب % 5(@)(@@) % فبدائع الشعراء فيما جهزوا % % مقرونة بغرائب الكتاب % 6(@)(@@) % تبا لقوم لا تزال حلومهم % % و عقولهم في ضلة وتباب % 7(@)(@@) % لهما من الحظ الصوارم والقنا ؛ % و من الطروس نفيسة الأسلاب % 8(@)(@@) % شنا على الآداب أقبح غارة % جرحت قلوب محاسن الآداب % 9(@)(@@) % فحذار من حركات صلي قفرة % و حذار من حركات ليثي غاب % 10(@)(@@) % لا يسلبان أخا الثراءو إنما % % يتناهبان نتائج الألباب % PageV01P121 11(@)(@@) % إن عز موجود الكلام عليهما % % فأنا الذي وقف الكلام ببابي % % 12(@)(@@) % أو يهبطا من ذلة فأنا الذي % % ضربت على الشرف المطل قبابي % % 13(@)(@@) % كم حاولا أمدي فطال عليهما % % أن يدركا إلا مثار ترابي % % 14(@)(@@) % عجزا ولم تقف العبيدإذا جرت % يوم الرهانمواقف الأرباب % 15(@)(@@) % و لقد حميت الشعرو هو لمعشر % رمم سوى الأسماء والألقاب % 16(@)(@@) % و ضربت عنه المدعينو إنما % % عن صورة الآداب كان ضرابي % % 17(@)(@@) % فغدت نبيط الخالدية تدعي % % شعري وترفل في حبير ثيابي % % 18(@)(@@) % أشياخ عمر الزعفران تراهم % حول الصليب حواني الأصلاب % 19(@)(@@) % نزلوا ذرمة بين غض نواظر % لم تسم مذ خلقت وذل رقاب % 20(@)(@@) % وطن المحرمة الجسوم نجاسة % في خير صحف نزلت وكتاب % PageV01P122 21(@)(@@) % من كل أشقر باحث خرطومه % % عن رزقهفتراه في إكتاب % 22(@)(@@) % خزر العيون خفية أصواتها % % تكسي الرؤوس شوائل الأذناب % 23(@)(@@) % يحمي جوانب سرحها إيرادها 
ms35	 % % فيبيت عنها مشرع الأنياب % 24(@)(@@) % رعيت لشيخ الخالدية برهة % بل كان يرعاها على الأحقاب % 25(@)(@@) % أسعيدإنك لو بصرت بهاشم % في العمر غير مبجل الأصحاب % 26(@)(@@) % محض المذلة راكبا عكازة % % رث المعيشة شاحب الجلباب % 27(@)(@@) % لحلفت أنك لا تطيل عمامة % مصقولة العذبات والأهداب % 28(@)(@@) % نفقوا بآلات الخنا وتوهموا % % أن الزمان جرى بهم وكبا بي % % 29(@)(@@) % قوم إذا قصدوا الملوك لمطلب % نقضت عمائمهم على الأبواب % 30(@)(@@) % من كل كهل يستطير سباله % % لونين بين أنامل البواب % PageV01P123 31(@)(@@) % مفض على ذل الحجاب يرده % % دامي الجبينتجهم الحجاب % 32(@)(@@) % و مفههين تعرضا لحرابتي % % فتعرضت لهما صدور حرابي % % 33(@)(@@) % نظرا إلى شعري يروق فتربا % % منه خدود كواعب أتراب % 34(@)(@@) % شرباه فاعترفا له بعذوبة % و لرب عذب عاد سوط عذاب % 35(@)(@@) % في غارة لم تنثلم فيها الظبا % % ضربا و لم تند القنا بخضاب % 36(@)(@@) % تركت غرائب منطقي في غربة % مسبية لا تهتدي لإياب % 37(@)(@@) % جرحى وما ضربت بحد مهند % أسرى وما حملت على الأقتاب % 38(@)(@@) % لفظ صقلت متونهفكأنه % % في مشرقات النظم در سخاب % 39(@)(@@) % و كأنما أجريت في صفحاته % % حر اللجين وخالص الزرياب % 40(@)(@@) % أغربت في تحبيرهفرواته % % في نزهة منه وفي استغراب % PageV01P124 41(@)(@@) % و قطعت فيه شبيبة لم تشتغل % عن حسنه بصبا ولا بتصابي % % 42(@)(@@) % فإذا ترقرق في الصحيفة ماؤه % % عبق النسيمفذاك ماء شبابي % % 43(@)(@@) % يصغي اللبيب له فيقسم لبه % % بين التعجب منه والإعجاب % 44(@)(@@) % جد يطير شرارهو فكاهة % تستعطف الأحباب للأحباب % 45(@)(@@) % أعزز علي بأن أرى أشلاءه % % تدمى بظفر للعدو وناب % 46(@)(@@) % أفن رماه بغارة مأفونة % باعت ظباء الروم في الأعراب % 47(@)(@@) % أأخي قد عزيتني بحسيبة % منه فعز بها ذوي الأحساب % 48(@)(@@) % عز الأكارم أنها حسب الندى % % فاضت أناملهم بغير حساب % 49(@)(@@) % هم نافسوا في حليه وبروده % % و هم أثيبوا عنه خير ثواب % 50(@)(@@) % و سقوه محتفل الحيا ريانه % % و رأوا ذنوبا سقيه بذناب % PageV01P125 51(@)(@@) % إني أحذر من يقول قصيدة % غراء خدني غارة ونهاب % 52(@)(@@) % ذئبين إذ نظرا إلى سيارة % بعثا لها يوما كيوم دؤاب % 53(@)(@@) % علجين 
ms36	 إذ حن النواقس صرحا % % بالشوق أو حنا حنين الناب % 54(@)(@@) % شغفا بذي القربان يصدق أنه % % ينشق من نسب إليه قراب % 55(@)(@@) % و رضى عن الإنجيل يظهر فيهما % % غضبا على الفرقان والأحزاب % 56(@)(@@) % إني نبذت على السواء إليكما % % فتأهبا للفادح المنتاب % 57(@)(@@) % نصبت مجانيق الهجاءو إن رأت % لكما ضؤولة منصب ونصاب % 58(@)(@@) % و إذا نبذت إلى امرىء ميثاقه % % فليستعد لسطوتي وعقابي % % 59(@)(@@) % حاولتما جبلا كأن رعانه % % فوق السحاب الغر غر سحاب % 60(@)(@@) % فإذا أصابكما غضاب سهامها % % غيرت مدى الأيام غير غضاب % PageV01P126 61(@)(@@) % و جريتما في غرة فنكصتما % % من سوءة العقبى على الأعقاب % 62(@)(@@) % و رميتما المسك الذكي بغيبة % و ذكاؤه يربي على المغتاب % 63(@)(@@) % فلتلفحنكما سمائم منطقي % % و لتغرقنكما سيول شعابي % % 64(@)(@@) % و لتسرين مع الجنوب إليكما % % مغموسة في الشري أو في الصاب % 65(@)(@@) % و لتطلعن من الفجاج كأنها % % غرر الجياد لواحق الأقراب % 66(@)(@@) % و لأضربنكما على ما خنتما % % بصوارم للشعر غير نوابي % % 67(@)(@@) % متواترات لا تغبكماو هل % % للصبح راعي الليل من إغباب % 68(@)(@@) % تشتق أجبال الشقيقفإن سرت % % ذات اليمين خطت غمار الزاب % 69(@)(@@) % نبل أغلغل منكما مسمومة % بمكامن الأحقاد والأطراب % 70(@)(@@) % فأريكما الدنيا به مغبرة % حتى يظن اليوم يوم ضباب % PageV01P127 71(@)(@@) % فلتعلماإن لم تهب عليكما % % أبدا نسيم جنايتي وجنابي % % 72(@)(@@) % و ليحذر الكذاب تربكما يدا % باتت تحن إلى طلى الكذاب % 73(@)(@@) % فلكم عدو قد أطلت عذابه % % بكلوم ريقة الكلام عذاب % 74(@)(@@) % وشيتها قبل الحتوف كما ارتدى % % بالوشي ظهر الحية المنساب % 75(@)(@@) % لولا أبو الخطاب طال تنكري % % للخطب يظلمنيو ساء خطابي % % 76(@)(@@) % و هبت شمائله الجزيلو أبرأت % يمناه من ندب الزمان إهابي % % 77(@)(@@) % و كفاك أن الدهر أعتبني به % % فكفيت عتبي عنده وعتابي % % PageV01P128 البحر : - 1(@)(@@) % ألا غادها مخطئا أو مصيبا % و سر نحوها داعيا أو مجيبا % % 2(@)(@@) % و خذ لهبا حره في غد % إذا الحر قارن يوما لهيبا % % 3(@)(@@) % دعانا الخريف إلى موطن % يفوق المواطن حسنا وطيبا % % 4(@)(@@) % و قد جمع الحسن في روضة % و فرق دجلة فيه شعوبا % % 5(@)(@@) % و 
ms37	 مطرب وشي أبراده % % يضاحك وشي النجاد القشيبا % % 6(@)(@@) % نشيده إن نزلنا ضحى % و نهدمه إن رحلنا الغروبا % % 7(@)(@@) % كأنا ارتبطنا به نافرا % من الخيل يفرق شخصا مهيبا % % 8(@)(@@) % فبتناو بات نسيم الصبا % % يدرج في جانبيه الكتيبا % % 9(@)(@@) % يكاد على ضعف أنفاسه % % يطير على الشرب تلك الشروبا % % 10(@)(@@) % و قد حجب الأرض ريحاننا % % فلم يبق للعين منها نصيبا % % PageV01P129 11(@)(@@) % كأنا على صفحتي لجة % تلاقي الشمال عليها الجنوبا % % 12(@)(@@) % فمن طرب يستفز النهى ؛ % و من أدب يسترق القلوبا % % 13(@)(@@) % و ساق يقابل إبريقه % % كما قابل الظبي ظبيا ربيبا % % 14(@)(@@) % يطوف علينا بشمسية % يروع بها الشمسحتى تغيبا % % 15(@)(@@) % و ينشر صيادنا حولنا % % لبابا من الصيد يرضي اللبيبا % % 16(@)(@@) % سبابيط تخبر أجسامها % % بأن قد رعين جنابا خصيبا % % 17(@)(@@) % نواعم لو أنها باشرت % هواء لأحدث فيها ندوبا % % 18(@)(@@) % فلولا الدروع التي قدرت % % لأبدانها أوشكت أن تذوبا % % 19(@)(@@) % و تبعث للبر وحشية % تسوق إلى الوحش يوما عصيبا % 20(@)(@@) % مؤدبة يرتضى فعلها % % و لم نر ليثا سواها أديبا % % PageV01P130 21(@)(@@) % و تركية الوجه تبدي لنا % % إخاء فصيحا ووجها جليبا % % 22(@)(@@) % تعانق إن وثبت صيدها % % عناق المحب يلاقي حبيبا % % 23(@)(@@) % طرادا صحيحا وخلفا صبيحا % و وثبا مليحا وأمرا عجيبا % % 24(@)(@@) % فقد ملكت ود أربابها % % فكل يخاف عليها شعوبا % % 25(@)(@@) % و للماء من حولنا ضجة % إن الماء كافح تلك العروبا % % 26(@)(@@) % جبال تؤلفها حكمة % فتحبو البحار بها لا السهوبا % % 27(@)(@@) % تقابلنا في قميص الدجى % % إذا الأفق أصبح منه سليبا % % 28(@)(@@) % حيازيمها الدهر منصوبة % تعانق للماء وفدا غريبا % % 29(@)(@@) % عجبت لها شاحبات الخدود % لم يذهب السري عنها الشحوبا % % 30(@)(@@) % إذا ما هممنا بغشيانها % % ركبنا لها ولدا أو نسيبا % % PageV01P131 31(@)(@@) % تغني السكور لنا بينها % % غناء تشق عليه الجيوبا % % 32(@)(@@) % يجاورها كل ساع يرى % % و إن جد في السيرمنها قريبا % % 33(@)(@@) % خلي الفؤادو لكنه % % يحن فيشجي الفؤاد الطروبا % % 34(@)(@@) % فيا حبذا الدير من منزل % هصرنا به العيش غضا رطيبا % % 35(@)(@@) % إذا ما استحمنا به نزهة % حمتنا بدائعه أن نخيبا % % PageV01P132 البحر : - 1(@)(@@) % أجزار باب 
ms38	 الشام كيف وجدتني % % و أنت جزور بين نابي ومخلبي % % 2(@)(@@) % أراك انتهبت الشعر ثم خبأته % عن الناس فعل الخائف المترقب % 3(@)(@@) % تباعدت عن باقورة الشعر بالمدى % % إليهفلم تخرج ولم تتحوب % 4(@)(@@) % و لما جرى الحذاق في ضوء صبحه % تعثرت منه في ضبابة غيهب % 5(@)(@@) % جريت من الإيجاز أقرب مسلك % و من ذهب الألفاظ أحسن مذهب % 6(@)(@@) % و تزعم أن الشعر عندك أعربت % محاسنه عن ناطق منك معرب % 7(@)(@@) % فما بال شعر الناس ملء عيوننا % % و شعرك في الأشعار عنقاء مغرب % PageV01P133 البحر : - 1(@)(@@) % سل الملحي كيف رأى عقابي % % و كيفو قد أبى رأي الصواب % 2(@)(@@) % رقاني الهاشمي فسل ضغني % % و أغمد عنه نائبتي ونابي % % 3(@)(@@) % و قال أخو المودة والتصابي % % و عون أخي الصبابة والتصابي % % 4(@)(@@) % و شيخا طاب أخلاقا فأضحى % % أحب إلى الشباب من الشباب % 5(@)(@@) % له دار إذا استخفيت فيها % % خفيت فلم تنلك يد الطلاب % 6(@)(@@) % طرقناه وقنديل الثريا % % يحطو فارس الظلماء كابي % % 7(@)(@@) % فرحب واستمال وقالحطت % رحالكم بأفنية رحاب % 8(@)(@@) % و حض على المناهدة الندامى % % بألفاظ مهذبة عذاب % 9(@)(@@) % و قال تيمموا الأبواب منها % % فكل جاء من تلقاء باب % 10(@)(@@) % فهذا قالريحان ونقل % و ثلج مثل رقرقة السراب % PageV01P134 11(@)(@@) % و هذا قالقدر من طعام ؛ % و هذا قال دن من شراب % 12(@)(@@) % و سمح القوم من سمحت يداه % % بخد غريرة بكر كعاب % 13(@)(@@) % فتم لهم بذلك يوم لهو % غريب الحسن عذب مستطاب % 14(@)(@@) % إذا العبء الثقيل توزعته % رقاب القوم خف على الرقاب % PageV01P135 البحر : - 1(@)(@@) % مدحت أبا جعفر % و قلت شريف العرب % 2(@)(@@) % فأسلمني بخله % إلى خيبة المنقلب % 3(@)(@@) % و أبدى على بابه % تجمل أهل الأدب % 4(@)(@@) % إذا قلت قد جاد لي % % يقول قميصي كذب % PageV01P136 البحر : - 1(@)(@@) % جد لي بها للشرخ من نشابها % % لم تشرب السن قوى شرابها % % 2(@)(@@) % فهي خلاف الراحو انتسابها % % في قدم العمر إلى أحقابها % % 3(@)(@@) % دخينة والثلج من ترابها % % خضر جرى الإفرند في أثوابها % % 4(@)(@@) % فاسودت الأطواق في رقابها % % تفوح ريا المسك في قرابها % % 5(@)(@@) % و 
ms39	 مسكها الفائح من شرابها % % إذا السيوف انحرن عن أثوابها % % 6(@)(@@) % حيث صريع الراحأو يحيا بها % % و أعقبته البر من عقابها % % 7(@)(@@) % فهي شفاء النفس من أوصابها % % و كربة المخمور والتهابها % % 8(@)(@@) % يغنى بها الساقي الذي يعنى بها % % وحجبها في الظل من حجابها % % 9(@)(@@) % وعقد الآس على قبابها % % و صانها عن ذامها وعابها % % 10(@)(@@) % و قام يجلوها على خطابها % % كأنما في الرحب من رحابها % % PageV01P137 11(@)(@@) % لطائما تنفح في عيابها % % فالصائم القائم من أصحابها % % 12(@)(@@) % و شارب الخمرة من شرابها % % PageV01P138 البحر : - 1(@)(@@) % عوجا على ذاك الكثيب من كثب % فكم لنا في ربوتيه من أرب % 2(@)(@@) % ما عن للعين به سرب مها % % إلا جرى من جفنها دمع سرب % 3(@)(@@) % سرن فقد عوض قلبي طربا % للحزن من فرط السرور والطرب % 4(@)(@@) % و احتجبت في كلل الرقم دمى % % تأنق أثناء الحجال والحجب % 5(@)(@@) % جدن بأجياد تحليها النوى % % فرائدا من دمع عين منسكب % 6(@)(@@) % صواعد الأنفاس أبقت نفسا % في صعد منا ودمعا في حبب % 7(@)(@@) % و مخطف يهتز من ماء الصبا % % كأنما يهتز عن ماء العنب % 8(@)(@@) % قام وسوق اللهو قد قام به % % ينخب أقداح الندامى بالنخب % 9(@)(@@) % و يمزج الكأس بعذب ريقه % % حتى تبدى الصبح مبيض العذب % 10(@)(@@) % وجدي به وجد الأمير أحمد % بجمع حمد أو بتقريق نشب % PageV01P139 11(@)(@@) % أغر رد الجود وعدا صادقا % من بعد ما كان غرورا وكذب % 12(@)(@@) % يستمطر البيض دما و تارة % يمطر راجيه ذهابا من ذهب % % 13(@)(@@) % كالعارض انهل رواء ديمة % و برقه بادي الحريق ملتهب % 14(@)(@@) % مغرى بسمر الخط لا سمر المها % % بأسا و بيض الهند لا بيض العرب % 15(@)(@@) % يريه أعلى الرأي حزم كامن % فيه كمون الموت في حد القضب % 16(@)(@@) % حسب بني حمدان مجدا أنهم % % أبناء محمود السماح والحسب % 17(@)(@@) % أسد إذا ما سلبت أسد الوغى % % أنفسهاعاقت نفيسات السلب % 18(@)(@@) % كم حاسد رحب الفناء ضيقت % عليه أسياف الأمير ما رحب % 19(@)(@@) % و حامد يسحب ذيل نعمة % أعم من ذيل السحاب المنسحب % 20(@)(@@) % حن إلى أرض العراق فامتطى 
ms40	 % % مطية تسبح في اللج اللجب % PageV01P140 21(@)(@@) % ناحية ترجو النجاة تارة % بسيرهاو تارة تخشى العطب % 22(@)(@@) % إذا المطايا قومت رؤوسها % % لتهتدي قوم هاديها الذنب % 23(@)(@@) % ركائب إن عرست لم تسترح % و إن سرت لم تشك إفراط التعب % % 24(@)(@@) % كأنما في الماء ظمآن فلا % % ينقع رقراق السراب المنسرب % % 25(@)(@@) % كأنما نحل منها أوطنا % و نحن للسير الحثيث في دأب % % 26(@)(@@) % و لم يزر بغداد حتى إنها % % بحر ندى يحيا به روض الأدب % % 27(@)(@@) % كأننالما بدت رباعها % % أسرى أحسوا بفكاك مقترب % % 28(@)(@@) % عدنا بمبيض الصلات في الرضا % % منه ومحمر الظباة في الغضب % % 29(@)(@@) % أثرى من المجدفأبقى سعيه % % مآثرا تبقى على مر الحقب % % 30(@)(@@) % فراح راجيهو قد نال المنى % % بنائل فلل أنياب النوب % % PageV01P141 31(@)(@@) % و راح من وشي الثناء كاسيا % يخطر في أثناء أبراد قشب % % PageV01P142 البحر : - 1(@)(@@) % يعنفني أن أن أطلت النحيبا % % و أسكب للبين دمعا سكوبا % % 2(@)(@@) % و أدنى المحبين من نحبه % % محب بكى يوم بين حبيبا % % 3(@)(@@) % دعا دمعه ودعت دمعها % % فبلل منها ومنه الجيوبا % % 4(@)(@@) % فتاة رمته بسهم الجفون % و مدت إليه بنانا خضيبا % % 5(@)(@@) % فعاين منهم غزالا ربيبا % و بدرا منيرا و غصنا رطيبا % % 6(@)(@@) % و عهدي بها لا تديم الصدود % و لا تتجنى علي الذنوبا % % 7(@)(@@) % ليالي لا وصلنا خلسة % نراقب للخوف فيها الرقيبا % % 8(@)(@@) % و لا برق لذاتنا خلب % إذا ما دعونا لوصل قلوبا % % 9(@)(@@) % و كم لي وللبين من موقف % يميت بلحظ العيون القلوبا % % 10(@)(@@) % إذا شهر اللحظ أسيافه % تدرعت للصبر بردا قشيبا % % PageV01P143 11(@)(@@) % كأني في هبوتيه ابن فهد % إذا اليوم أصبح يوما عصيبا % % 12(@)(@@) % فتى يستقل جزيل الثواب % سماحا لمن جاءه مستثيبا % % 13(@)(@@) % و يربي على سنن المكرمات % فيظهر فيهن مجدا غريبا % % 14(@)(@@) % و تلقاه مبتسما واضحا % إذا ما الحوادث أبدت قطوبا % % 15(@)(@@) % كريم إذا خاب راجي الندى % % حمتنا مكارمه أن نخيبا % % 16(@)(@@) % رأى لحظه ما تجن الصدور % فخلناه يعلم منها الغيوبا % % 17(@)(@@) % بعيد إذا رمت إدراكه % و إن كان في الجود سهلا قريبا % % 18(@)(@@) % نمته 