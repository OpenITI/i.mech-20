ms21	(@)(@@) % منا النبي الأمي سنته % فاضلة نافع تعلمها % % 40(@)(@@) % وأهل بدر منا خيارهم % وأفهم العالمين أفهمها % % PageV01P091 41(@)(@@) % يقضي له الله بالذي سبقت % % وما وعاه الكتاب محكمها % % 42(@)(@@) % يأبى لي الذم رأي ذي حسب % واف ونفس باق تكمها % % 43(@)(@@) % وشيمة سهلة مقدمة % لم يك ذو عسرة يوحمها % % 44(@)(@@) % والأرض فيها عما كرهت إذن % منادح واسع تزعمها % % 45(@)(@@) % نحن البقايا وكل صالحة % تهدي إلى الخير حين نقسمها % % PageV01P092 البحر : مخلع البسيط 1(@)(@@) % لا بكر لي إذ دعوت بكرا % ودون بكر ثرى وطين % PageV01P093 البحر : طويل 1(@)(@@) % سمين قريش مانع منك لحمه % وغث قريش حيث كان سمين % PageV01P094 البحر : كامل تام 1(@)(@@) % وتفرقوا بعد الجميع لنية % لا بد أن تتفرق الجيران % 2(@)(@@) % لا تصبر الإبل الجلاد تفرقت % حى تحن ويصبر الإنسان % PageV01P095 البحر : هزج 1(@)(@@) % سليمى أزمعت بينا % % فأين تقولها أينا % % 2(@)(@@) % وقد قالت لأتراب % لها زهر تلاقينا % % 3(@)(@@) % تعالين فقد طاب % لنا العيش تعالينا % % 4(@)(@@) % وغاب البرم الليلة % % والعين فلا عينا % % 5(@)(@@) % فأقبلن إليها % % رعات يتهادينا % % 6(@)(@@) % إلى مثل مهاة % ل تكسو المجلس الزينا % % 7(@)(@@) % إلى خود منعمة % حففن بها وفدينا % % 8(@)(@@) % تمنين مناهن % فكنا ما تمنينا % % 9(@)(@@) % فبينا ذاك سلمت % فرحبن وفدينا % % PageV01P096 البحر : بسيط تام 1(@)(@@) % أما قتلت ديار الحي عرفانا % % يوم الكفافة بعد الحي إذ بانا % % 2(@)(@@) % إلا توهم آيات بمنزلة % هاجت عليك لبانات وأحزانا % % 3(@)(@@) % قف ساعة ثم أما كنت مدكرا % وباكيا عبرة يوما فمل آنا % % 4(@)(@@) % ولو بكيت الصبا يوما وميعته % إذن بكيت على ما فات أزمانا % % 5(@)(@@) % من شرة من شباب لست راجعه % حتى يزور ثبيرا صخر لبنانا % % 6(@)(@@) % لم يعط قلبك عن سعدى ولو بخلت % صبرا ولم تسق عنها النفس سلوانا % % 7(@)(@@) % فاقصد برأيك عنها قصد مجتنب % ما لا تطيق فقد دانتك أديانا % % 8(@)(@@) % عهدي بها صلته الخدين واضحة % حوراء مثل مهاة الرمل مبدانا % % 9(@)(@@) % مقنعة في اعتدال الخلق خرعبة % تكسو الترائب ياقوتا ومرجانا % % 10(@)(@@) % يصفو لنا العيش والدنيا إذا رضيت % % وقد تكدر ما لم ترض دنيانا % % PageV01P097 11(@)(@@) % لولا الحياء طلبنا 
ms22	 يوم ذي بقر % ممن تغور قصد البيت أظعانا % % 12(@)(@@) % بيض السوالف يورثن القلوب جوى % لا يستطيع له الإنسان كتمانا % % 13(@)(@@) % قال العواذل قد حاربت في فنن % من الصبا وشباب الغصن ريعانا % % 14(@)(@@) % ومن يطعهن يقرع سنه ندما % ولا يكن له في الخير أعوانا % % 15(@)(@@) % لا يرض من سخطة والحق مغضبة % من كان من فضلنا المعلوم غضبانا % % 16(@)(@@) % تلقى ذرى خندف دوني وتغضب لي % % إذا غضبت بنو قيس بن عيلانا % % 17(@)(@@) % حيا حلالا نفى الأعداء عزهم % حتى أطرنا بهم مثنى ووحدانا % % 18(@)(@@) % أوفى معد وأولاهم بمكرمة % وأعظم الناس أحلاما وسلطانا % % 19(@)(@@) % من شاء عد ملوكا لا كفاء لهم % % منا ومن شاء منا عد فرسانا % % 20(@)(@@) % إذا الملوك اجرهدت غير نازعة % كانوا لها في احتدام الموت أقرانا % % PageV01P098 21(@)(@@) % حتى تلين وما لانوا وقد لقيت % % أعداؤنا حربا منهم وليانا % % 22(@)(@@) % فهم كذلك من كادوا فإن له % إن لم يمت منهم ذلا وإثخانا % % 23(@)(@@) % لا ينكر الناس من ورائهم % % في الحرب نرعاهم والله يرعانا % % 24(@)(@@) % أحياؤنا خير احياء وأكرمهم % % وخير موتى من الأموات موتانا % % 25(@)(@@) % منا الرسول نخير الناس كلهم % ولا نحاشي من الأقوام إنسانا % % 26(@)(@@) % وذاك نور هدى الله العباد به % من بعد خبطهم صما وعميانا % % 27(@)(@@) % فأبصروا فاستبان الرشد مشعرة % بعد الضلال قلوب الناس إيمانا % % 28(@)(@@) % فينا الخلافة والشورى وقاداتها % % فمن له عند أمر مثل شورانا % % 29(@)(@@) % أو مثل أولنا أو مثل آخرنا % % أو مثل أنسابنا أو مثل مقرانا % % 30(@)(@@) % وكل حي له قلب يعيش به % في الناس أصبح يرجونا ويخشانا % % PageV01P099 31(@)(@@) % نبغي قريشا ويأبنى الله ربهم % الا اصطناعهم نصرا وإحسانا % % 32(@)(@@) % وما قريش إذا غضت حروبهم % يوما بأكلة جافي الدين غرثانا % % 33(@)(@@) % وما أرادهم باغ يغشهم % يبغي الزيادة الا ازداد نقصانا % % 34(@)(@@) % قوم إذا الحمد لم يوجد له ثمن % ألفيت عندهم للحمد أثمانا % % 35(@)(@@) % قماقم العز لا يفرى خطيبهم % ولا يقوم إذا ما قام خزيانا % % 36(@)(@@) % قد جربتهم حروب الناس واقتبست % منهم ثواقب نار الحرب نيرانا % % 37(@)(@@) % فلم يلينوا لهم في 
ms23	 كل معجمة % ولم يروا منهم في الحرب إدهانا % % 38(@)(@@) % إذا الشياطين رامتهم بأجمعهم % % لم يبق منهم جنود الله شيطانا % % 39(@)(@@) % هم العرانين والأثرون قبض حصى % وجوهر السر والعيدان عيدانا % % 40(@)(@@) % والأكرمون نصابا في أرومتهم % % والأثقلون على الأعداء أركانا % % PageV01P100 البحر : بسيط تام 1(@)(@@) % أفي رسوم محل غير مسكون % من ذي الأجارع كاد الشوق يبكيني % % 2(@)(@@) % فقر عفا غير أوتاد منبذة % ومنحن خط دون السيل مدفون % 3(@)(@@) % وهامد كسحيق الكحل ملتبد % أكناف ملمومة اثباجها جون % 4(@)(@@) % عوارف ذلل أمست معطلة % في منزل ظل فيه الدمع يعصيني % % 5(@)(@@) % وبالسقا وإلى مثنى قراينه % رسم به كان عهد الربرب العين % 6(@)(@@) % أيام سعدى هوى نفسي ونيقتها % % من لام زينها عندي بتزيين % 7(@)(@@) % للظبية البكر عيانها وتلعتها % % في حسن مبتسم منها وعرنين % 8(@)(@@) % تنوء منها إذا قامت بمردفة % كأنها الغر من أنقاء معرون % 9(@)(@@) % لا بعد سعدى مريحي من جوى سقم % يوما ولا قربها ان حم يشفيني % % 10(@)(@@) % أمست كأمنية سعدى ملاوذة % كانت بها النفس أحيانا تمنيني % % PageV01P101 11(@)(@@) % إذا الوشاة لحوا فيها عصيتهم % وخلت أن بسعدى اللوم يغريني % % 12(@)(@@) % وما اجتنابك من تهوى تباعده % ظلما وتهجره حينا إلى حين % 13(@)(@@) % إني امرء يخن ودي مكاذبة % ولا الغنى حفظ أهل الو ينسيني % % 14(@)(@@) % وقد علمت وما الإسراف من خلقي % % أن الذي هو رزقي سوف يأتيني % % 15(@)(@@) % أسعى له فيعنيني تطلبه % % ولو قعدت أتاني لا يعنيني % % 16(@)(@@) % وأن حظ امرىء غيري سيأخذه % لابد لابد أن يحتازه دوني % % 17(@)(@@) % فلن أكلف نفسي فوق طاقتها % % حرصا أقيم به في معطن الهون % 18(@)(@@) % أبيت ذلك رأيا لست قاربه % ولا معرضه عرضي ولا ديني % % 19(@)(@@) % من كان من خدم الدنيا أشت به % حتى يقال صحيح مثل مجنون % 20(@)(@@) % نعالج العيش أطوارا تقلبه % فيه أفانين تطوى عن أفانين % PageV01P102 21(@)(@@) % باليسر والعسر والأحداث معرضة % لابد من شدة فيها ومن لين % 22(@)(@@) % حتى تكل وتلقى في تطردها % % أطباق ملهى بها حيران مفتون % 23(@)(@@) % ولو تخفض لم ينقض تخفضه % مكتوب رزق ما عاش مضمون % 24(@)(@@) % فما 
ms24	 امرء لم يضع دينا ولا حسبا % بفضل مال وقى عرضا بمغبون % 25(@)(@@) % كم من فقير غني النفس تعرفه % % ومن غني فقير النفس مسكين % 26(@)(@@) % ومن موءاخ طوى كشحا فقلت له % % إن انطواءك هذا عنك يطويني % % 27(@)(@@) % لا تحسبن مؤاخاتي مقصرة % ولا رضاك وقد أذنبت يرضيني % % 28(@)(@@) % لا خير عندك في غيب وفي حضر % إلا أهاويل من خلط وتلوين % 29(@)(@@) % بأي رأيك في أمر عنيت به % وفضل مالك يوما كنت تكفيني % % 30(@)(@@) % فليت شعري وما أدري فتخبرني % % بأي قرضي من الأيام تجزيني % % PageV01P103 31(@)(@@) % أبا الذي كان مني مرة حسنا % أم بالقبيح وما أقبحت ترميني % % 32(@)(@@) % فما حفظت وما أحسنت رعيته % سرا أمنت عليه غير مأمون % 33(@)(@@) % عجزا عن الخير تلويه وتمطله % بخلا علي به والشر تقضيني % % 34(@)(@@) % ما كنت ممن تجاريني بديهته % ولا من الأمد الأقصى يغالبني % % 35(@)(@@) % منتك نفسك أمرا لا تؤلفه % حتى تؤلف بين الضب والنون % 36(@)(@@) % النون يهلك في بيداء مقفرة % والضب يهلك بين الماء والطين % 37(@)(@@) % لا تغضبن فأني غير معتبه % من كنت أوليته ما كان يوليني % % PageV01P104 البحر : سريع 1(@)(@@) % كأنما عائبها دائبا % زينها عندي بتزيين % PageV01P105 البحر : بسيط تام 1(@)(@@) % لقد علمت وما الإشراف من خلقي % % أن الذي هو رزقي سوف يأتيني % % 2(@)(@@) % أسعى له فيعنيني تطلبه % % ولو جلست أتاني لا يعنيني % % 3(@)(@@) % لا خير في طمع يدني إلى طبع % وغضة من قوام العيش يكفيني % % 4(@)(@@) % لا أركب الأمر تزري بي عواقبه % ولا يعاب به عرضي ولا ديني % % 5(@)(@@) % كم من فقير غني النفس تعرفه % % ومن غني فقير النفس مسكين % 6(@)(@@) % ومن عدو رماني لو قصدت له % لم آخذ النصف منه حين يرميني % % 7(@)(@@) % ومن أخ لي طوى كشحا فقلت له % % إن انطواءك عني سوف يطويني % % 8(@)(@@) % إني لأنظر فيما كان من أربي % % وأكثر الصمت فيما ليس يعنيني % % 9(@)(@@) % لا أبتغي وصل من يبغي مقاطعتي % % ولا ألين لمن لا يبتغي ليني % % 10(@)(@@) % وإن حظ امرىء غيري سيبلغه % لا بد لابد أن يختاره دوني % % PageV01P106 البحر : بسيط تام 1 
ms25	(@)(@@) % لا يبعد الله حسادي وزادهم % حتى يموتوا بداء في مكنون % 2(@)(@@) % إني رأيتهم في كل منزلة % أجل قدرا من اللائي يحبوني % % PageV01P107 البحر : خفيف تام 1(@)(@@) % من لعين كثيرة الهملان % ولحزن قد شفني وبراني % % 2(@)(@@) % أن تولى أخي وعارف حقى % % وأميني في السر والإعلان % 3(@)(@@) % عامر من كعامر يرقع الثلم % ويكفيك حضرة السلطان % 4(@)(@@) % حيث لا ينفع الضعيف ولا للوغل % في الجد بالفئام يدان % 5(@)(@@) % فثوى بالعراق رمسا غريبا % لا بدار ولا حرى أوطان % 6(@)(@@) % نائيا عن بني الزبير مقيما % بين أنهار واسط والجنان % 7(@)(@@) % سيدا وابن سادة يشترون ال % % قدما بأربح الأثمان % 8(@)(@@) % قدموا أفضل المكارم مجدا % ولهم سر كل عرق هجان % 9(@)(@@) % ورثوه مجد الحياة فثبى % % مجد بان أشاد في البيان % 10(@)(@@) % بقيام على الجسيم من الأم % وضغم للمترف الحيران % PageV01P108 11(@)(@@) % وانصراف عن جهل ذي الرحم % المفرط لو شاء ناله بهوان % 12(@)(@@) % من يلم في بكائه لا أطعه % وأقل : مثل عامر أبكاني % % 13(@)(@@) % من يصادي سخطي ويحلم عني % % وإذا قلت : من لأمري كفاني % % PageV01P109 البحر : خفيف تام 1(@)(@@) % سخنة في الشتاء باردة الصيف % سراج في الليلة الظلماء % PageV01P110 البحر : كامل تام 1(@)(@@) % قالت وعيش أخي ونعمة والدي % % لأنبهن الحي ان لم تخرج % 2(@)(@@) % فجرجت خوف يمينها فتبسمت % فعلمت أن يمينها لم تخرج % 3(@)(@@) % فتناولت رأسي لتعرف مسه % بمخضب الأطراف غير مشنج % 4(@)(@@) % فلثمت فاها آخذا بقرونها % % شرب النزيف ببرد ماء الحشرج % PageV01P111 البحر : طويل 1(@)(@@) % غراب وظبي أغضب القرن نادبا % بين وصردان العشي تصيح % 2(@)(@@) % لعمري لئن شطت بعثمة دارها % % لقد كنت من خوف الفراق أليح % PageV01P112 البحر : وافر تام 1(@)(@@) % حللنا آمنين بخير عيش % ولم يشعر بنا واش يكيد % 2(@)(@@) % ولم نشعر بجد البين حتى % % أجد البين سيار عنود % 3(@)(@@) % وحتى قيل قوض آل بشر % وجاءهم ببينهم البريد % 4(@)(@@) % وأبرزت الهوادج ناعمات % عليهن المجاسد والعقود % 5(@)(@@) % فلما ودعونا واستقلت % بهم قلص هواديهن قود % 6(@)(@@) % كتمت عواذلي ما في فؤادي % % وقلت لهن ليتهم بعيد % 7(@)(@@) % فجالت عبرة أشفقت منها % % تسيل كأن وابلها فريد 
ms26	 % 8(@)(@@) % فقالوا قد جزعت فقلت كلا % وهل يبكي من الطرب الجليد % 9(@)(@@) % ولكني أصاب سواد عيني % % عويد قذى له طرف حديد % 10(@)(@@) % فقالوا ما لدمعهما سواء % أكلتا مقلتيك أصاب عود % PageV01P113 11(@)(@@) % لقبل دموع عينك خبرتنا % % بما جمجمت زفرتك الصعود % 12(@)(@@) % فقم وانظر يزدك مطال شوق % هنالك منظر منهم بعيد % PageV01P114 
ms27	