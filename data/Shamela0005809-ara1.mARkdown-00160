ms141	 إليها(@)(@@)(@@)(@@) $ 3259 - (@)(@@) المكاري(@)(@@) لقب ربيعة بن ثابت الشاعر الرقي(@)(@@)(@@)(@@) $ 3260 - (@)(@@) المكي(@)(@@) إسماعيل بن مسلم البصري نزل مكة فنسب إليها(@)PageV00P000(@)(@@)(@@)(@@) $ 3261 - (@)(@@) وكذلك عبد الله بن رجاء المكي(@)(@@)(@@)(@@) $ 3262 - (@)(@@) الملحي(@)(@@) بضم أوله وفتح ثانيه أبو محمد إسماعيل بن محمد الصفار النحوي قيل له ذلك لروايته الملح(@)(@@)(@@)(@@) $ 3263 - (@)(@@) الملطي(@)(@@) محمد بن عبد الله بن محمد بن مسلم الحميري إمام الجامع بمصر قال ابن يونس كان يلقب الملطي(@)(@@)(@@)(@@) $ 3264 - (@)(@@) المنجنيقي(@)(@@) إسحاق بن إبراهيم بن يونس المصري الحافظ كان يجلس عند منجنيق الجامع مات بعد الثلاثمائة(@)(@@)(@@)(@@) $ 3265 - (@)(@@) ولقب بها عبد الله بن علي الطبري وتأخر عن الذي قبله ومات في حدود الستين وثلاثمائة(@)PageV00P000(@)(@@)(@@)(@@) || - النون(@)(@@)(@@)(@@) $ 3266 - (@)(@@) النبطي(@)(@@) مقاتل بن حيان البلخي قيل له النبطي لعجمة لسانه(@)(@@)(@@)(@@) $ 3267 - (@)(@@) النرسي عبد الأعلى بن حماد بن نصر البصري(@)(@@)(@@)(@@) $ 3268 - (@)(@@) الناشيء والنابي تقدما في الأسماء(@)(@@)(@@)(@@) $ 3269 - (@)(@@) النوري أبو الحسين محمد بن محمد الصوفي البغدادي قيل لقب بذلك لنور وجهه(@)(@@)(@@)(@@) || - الواو(@)(@@)(@@)(@@) $ 3270 - (@)(@@) الوزدولي(@)(@@) إبراهيم بن موسى الجرجاني(@)PageV00P000(@)(@@)(@@)(@@) $ 3271 - (@)(@@) الورشي(@)(@@) محمد بن أحمد بن عبد الأعلى بن القاسم الأندلسي المغربي روى عن علي بن المرزبان(@)(@@)(@@)(@@) $ 3272 - (@)(@@) الورعي(@)(@@) أبو جعفر أحمد بن يحي القرطبي من شيوخ ابن مسدي بالاجازة وهو آخر من حدث عن المازري(@)(@@)(@@)(@@) $ 3273 - (@)(@@) الوساوسي(@)(@@) أبو طلحة أحمد بن محمد بن عبد الكريم البصري(@)(@@)(@@)(@@) $ 3274 - (@)(@@) الوكيعي(@)(@@) أحمد بن عمر بن حفص الكوفي قيل له ذلك للزومه وكيعا(@)(@@)(@@)(@@) $ 3275 - (@)(@@) ومحمد بن أحمد بن جعفر الطرسوسي الوكيعي قيل له ذلك لتتبعه حديث وكيع رحمه الله(@)PageV00P000(@)(@@)(@@)(@@) $ 3276 - (@)(@@) الولادي(@)(@@) عبد الرحمن بن أحمد بن عبد الله الأصبهاني أبو بشر المديني ذكره ابن عساكر في تاريخه(@)(@@)(@@)(@@) || - الياء(@)(@@)(@@)(@@) $ 3277 - (@)(@@) اليزيدي(@)(@@) يحي بن المبارك العدوي مولاهم كان مولى بني عدي بن عبد مناه ولزم يزيد بن منصور الحميري خال المهدي فعرف به(@)(@@)(@@)(@@) $ 3278 - (@)(@@) اليهودي(@)(@@) جماعة من أهل أصبهان من قرية اليهودية وعرف بها أبو محمد عبيد الله بن عبد الله بن البيع صاحب المحاملي لأنه كان يسكن درب اليهود ببغداد(@)(@@)(@@)(@@) $ 3279 - (@)(@@) ومثله أحمد بن محمد بن عبد الكريم 
ms142	 الجرجاني كان يسكن باب اليهود بجرجان(@)PageV00P000(@)(@@)(@@)(@@) |PARATEXT|(@)(@@) آخر الكتاب(@)(@@) فرغ من جميع تبييض هذه النسخة جامع الكتاب ومهذبه أحمد بن علي بن محمد بن محمد بن حجر الشافعي عفا الله عنه وهذه ثاني نسخة منه وقد صارت أيضا شبه المسودة اه PageV02P315 
