ms141	 النبراس % % معنعن الأخبار % % PageV01P682 البحر : - 1(@)(@@) % عبد الغني قد وافى % % يبدي له الأوصافا % % 2(@)(@@) % في مدحه أصنافا % % ينظم من أشعار % % PageV01P683 البحر : - 1(@)(@@) % بيني وبينك يا قديم جدار % % هو جملتي بك حادث يا جار % % 2(@)(@@) % والكنز أنت وراء ذلك كله % % والطلمسات العقل والأفكار فتحت رياضتنا إليك طريقة والشرع باب والحقيقة دار % % 3(@)(@@) % وبدا جمالك للعيون وزال عن % % وجه القلوب من الغيوب خمار % % 4(@)(@@) % يا طلعة هي للمتيم جنة % % تجري بها من تحتها الأنهار % % 5(@)(@@) % أنهار أنواع العلوم فما السوى % % لا الحقائق منك والأسرار % % 6(@)(@@) % بتنا وأصبحنا نراك فليلنا % % من نور وجهك يا مليح نهار % % 7(@)(@@) % ولقد نزلت فكنت جملة كوننا % % وتفككت عنا بك الأزرار % % 8(@)(@@) % والوجه شقق بالظهور ثيابنا % % حتى بدا وأزيلت الأستار % % 9(@)(@@) % الله أكبر هذه ذات الذي % % نحن الشؤون لديه والأطوار % % 10(@)(@@) % والماء أيضا والتراب له به % % كان التجلي والهوا والنار % % PageV01P684 11(@)(@@) % وكواكب الأفلاك قبل ظهورنا % % أصل لنا تزجى بنا وتدار % % 12(@)(@@) % والعرش منشأنا وكرسي الملا % % هيآتنا ونفوسنا الأقدار % % 13(@)(@@) % ولنا السموات العلية كونت % % والأرض والظلمات والأنوار % % 14(@)(@@) % ولأجلنا ظهر الوجود بكل ما % % هو ظاهر وأنارت الأسحار % % 15(@)(@@) % ودوائر حركاتهن تناسقت % % بعض لبعض ما لهن قرار % % 16(@)(@@) % كالبرق في التغيير وهي جوامد % % عند النواظر فاسمها أغيار % % 17(@)(@@) % طورا هناك وتارة هي ههنا % % ظهر اللطيف بهن والجبار % % 18(@)(@@) % ووراءهن حقيقة مطوية % % منشورة حارت بها الأبصار % % 19(@)(@@) % أسماؤها أسماؤهن وذاتها % % هي ذاتهن لمن له استبصار % % 20(@)(@@) % وهي المقدسة المنزهة التي % % جلت فتاة بها الجميع وحاروا % % PageV01P685 21(@)(@@) % وتحققوا بالعجز عن إدراكها % % وبها إليها في الكمال يشار % % 22(@)(@@) % عرفوا بها منهم حقائق أنفس % % خفيت فكان بنورها الإظهار % % 23(@)(@@) % والحكم منها نازل في حقهم % % شهدت به الآيات والأخبار % % 24(@)(@@) % ولأجله جاء الخطاب بعزهم % % ولهم تزايد عندها المقدار % % 25(@)(@@) % لولا مقالة كن الشيء لم يكن % % هي هذه الكلمات والأذكار % % 26(@)(@@) % وكذاك لولا الحكم كان الكل في % % نقص ولم يك للكمال منار % % 27(@)(@@) % وتشابه الإنسان والحيوان إذ % % رجل يقال مكون وحمار % % 28(@)(@@) % هذا هو الحق اليقين وغيره 
ms142	 % % قول عليه تعين الإنكار % % PageV01P686 البحر : - 1(@)(@@) % زمان المصيف ووقت الشتا % . . . % 2(@)(@@) % فتاة الحمى تنجلي والفتى % . . . % 3(@)(@@) % وهذا الحبيب لنا قد أتى % . . . % 4(@)(@@) % إلى م يا قلب وحتى متى % % يكفيك من أمرك ما قد جرى % % 5(@)(@@) % لقد وقف الكل إلا أنا % . . . % 6(@)(@@) % فسيري هو القصد وهو المنى % . . . % 7(@)(@@) % ويا صب مهلا ملأت الإنا % . . . % 8(@)(@@) % وأنت يا نوق براك الونا % % وخالف الأجفان طيب الكرى % % 9(@)(@@) % لمن لام في الحب طرف عمي % . . . % 10(@)(@@) % ونفس المحب به ترتمي % . . . % PageV01P687 11(@)(@@) % كم الكد حادى المطايا كم % . . . % 12(@)(@@) % فخفف السير ولا تسأم % % لا بد أن يحمد هذا السرى % % PageV01P688 البحر : - 1(@)(@@) % نعم لقلوب العاشقين سرائر % % من الغيب قد ضمت عليها الضمائر % % 2(@)(@@) % يحركها صوت السماع بوقعه % % فتظهر منها للعيان الأشائر % % 3(@)(@@) % هو الدف والطنبور والوتر الذي % % يسير به للوتر في الكون سائر % % 4(@)(@@) % أعد ما بدا يا منشد القوم عندنا % % بصوتك واطربنا فيرشد حائر % % 5(@)(@@) % وتفتح أغلاق المعارف واللقا % % تدق له بين القلوب البشائر % % 6(@)(@@) % كشفت حجاب الكون عنا بذكر من % % عليه من الأغيار مدت غدائر % % 7(@)(@@) % وأظهرت سرا طالما قد كتمته % % وبالغير في أرض القريحة غائر % % 8(@)(@@) % وأذكرت عهدا من ألست بربكم % % به شخصت منا إليه البصائر % % 9(@)(@@) % وقد حيعل المزمار بالوجد بيننا % % وضجت بتأذين الغناء المنابر % % 10(@)(@@) % ألا أيها الناي الرخيم كشفت عن % % سرائر شوقي يوم تبلى السرائر % % PageV01P689 11(@)(@@) % وأشبهتني في نفخ روحي وقد بدت % % لقلبي هنا من سر قلبي ذخائر % % 12(@)(@@) % عليل الهوى أضحى يعلله الهوى % % وقد جبرت بالكسر منه الجبائر % % 13(@)(@@) % يموت ويحيى كلما لمعت له % % بروق الحمى النجدي وغرد طائر % % 14(@)(@@) % وإن نفحت ريح الصبا في دياره % % بها هو نقع كله وهو ثائر % % 15(@)(@@) % سمعت كلاما قد أتاني به الصبا % % عن المطلع الشرقي له أنا دائر % % 16(@)(@@) % فهمت بوجدي إذ فهمت رموزه % % فها أنا للبرق اللموع أساير % % 17(@)(@@) % وما كل أذن طارقات الهوى تعي % % ولا كل طرف فيه تجلى الحرائر % % 18(@)(@@) % تغار سليمى إن رأى غيرها امرؤ % % كما قد عهدناها تغار الضرائر % % 19 
ms143	(@)(@@) % صدقتك هذا الركب طال به السرى % % وجار عليه بالمحبة جائر % % 20(@)(@@) % ولولا التسلي بالتجلي لأحجمت % % دوائر أفلاك الوجود الدوائر % % PageV01P690 21(@)(@@) % على مثل هذا الوجه تلتهب الحشى % % ومن حسنه فينا تشق المرائر % % 22(@)(@@) % وما ذاك إلا وجه سلمى فإنه % % يغاير للأشيا وليس يغاير % % 23(@)(@@) % بدا فأزيلت عنه أستار غيره % % وقد غفرت للمذنبين الكبائر % % 24(@)(@@) % وكنا وما كنا وكان ولم يكن % % وما ثم إلا قدسه والحظائر % % 25(@)(@@) % وجود ولا أعني الوجود الذي بدت % % من الكون أشباه له ونظائر % % 26(@)(@@) % ولكن وجود مطلق عن تقيد % % بإطلاقه والكل منه شعائر % % 27(@)(@@) % وكل وجود مطلق أو مقيد % % بعقل وحس فهو عنه ستائر % % 28(@)(@@) % إذا لاح غبنا فيه عنا جميعنا % % وإن غاب نحن السائبات البحائر % % PageV01P691 البحر : - 1(@)(@@) % قل لنفس جهلت بين الورى % % أمر مولى لم يزل مقتدرا % % 2(@)(@@) % جاهدي فيه به واجتهدي % % واتركي الأوهام بل والفكرا % % 3(@)(@@) % لا تظني أن بالفكر وإن % % طال وازداد وفيه انتشرا % % 4(@)(@@) % أن تنالي غير بعد وعنا % % وتحوزي منه إلا أثرا % % 5(@)(@@) % سلم الأمر له واعمل بما % % جاء عنه إن نهى أو أمرا % % 6(@)(@@) % واحذر البدع واعبده على % % سنة واصبر وكن منتظرا % % 7(@)(@@) % ربما يقبلك الله وإن % % صد يكفيك الذي قد ذكرا % % PageV01P692 البحر : - 1(@)(@@) % بنا المولى هو الأحرى % % ونحن النزلة الأخرى % % 2(@)(@@) % رأيناه بنا لما % % تجلى الجهة اليسرى % % 3(@)(@@) % وكنا عنه معناه % % فلم نقدر له قدرا % % 4(@)(@@) % ومعنانا أتى خلقا % % ومعناه أتى أمرا % % 5(@)(@@) % خفينا فيه لما أن % % تجلى عندنا جهرا % % 6(@)(@@) % فكنا عنده كشفا % % وكنا عندنا سترا % % 7(@)(@@) % وقفنا دونه برا % % وقد خضنا به بحرا % % 8(@)(@@) % ولم ندرك سوانا في % % تجليه بنا قهرا % % 9(@)(@@) % وغيب الغيب مكشوف % % ومولانا به أدرى % % 10(@)(@@) % ومستور بنا عنا % % كما قد جاءت الذكرى % % PageV01P693 11(@)(@@) % وهذا الحال لا يمضي % % وهذا الداء لا يبرا % % 12(@)(@@) % فقولوا للذي يهوى % % دع المحجوبة البكرا % % 13(@)(@@) % فماذا أنت حتى ترتجي % % أن تطرق الخدرا % % 14(@)(@@) % ولكن أنت مفتون % % بإحساناتها التترى % % 15(@)(@@) % جمال ظاهر هذا % % به كل الورى أسرى % % 16(@)(@@) % وأعلى الكل مجذوب 
ms144	 % % إليه جاذب أسرى % % 17(@)(@@) % بلا ذات ولا وصف % % ولا دنيا ولا أخرى % % 18(@)(@@) % هو السالي لها المغري % % ولا سال ولا مغرى % % PageV01P694 البحر : - 1(@)(@@) % حبيبي أنت لي ظاهر % % سباني وجهك الباهر % % 2(@)(@@) % وطرفي في الدجى ساهر % % وسلطان الهوى قاهر % % PageV01P695 البحر : - 1(@)(@@) % أمانا يا منى قلبي % % من الهجران والسلب % % 2(@)(@@) % وإني حائر اللب % % على عرفانك الزاهر % % PageV01P696 البحر : - 1(@)(@@) % بدا من جانب الوادي % % علينا نورك الهادي % % 2(@)(@@) % فذاب الركب والحادي % % وتاه الغر والماهر % % 3(@)(@@) % ألا ليت الهوى يجدي % % لقاء الطيب الطاهر % % PageV01P697 البحر : - 1(@)(@@) % صلاة الله والتسليم % % على من خص بالتكريم % % 2(@)(@@) % حوى عبد الغني التقديم % % به في قدره الساهر % % PageV01P698 البحر : - 1(@)(@@) % قد صرت كلي قلوبا فيه تحتار % % لما تجلى وما يختار نختار % % 2(@)(@@) % والكل مني له الآذان مصغية % % وإن نظرت فكلي فيه أبصار % % 3(@)(@@) % غيب تحجب في الأكوان فهو بها % % نور ونار ولا نور ولا نار % % 4(@)(@@) % وهو الوجود النزيه الصرف عزفلا شيء سواه وعنه الكل آثار % . . . % 5(@)(@@) % إذا أراد بدا ذاك المراد به % % كما يريد وكانت منه أغيار % % 6(@)(@@) % والكل في علمه لكن إرادته % % تخفى وتبدي فكتمان وإظهار % % 7(@)(@@) % جل المهيمن في تقديس حضرته % % عمن سواه به كل الورى حاروا % % 8(@)(@@) % لا ذنب للعقل هذا قدر طاقته % % وذاك منه تسابيح وأذكار % % 9(@)(@@) % لكنه إن يكن بالعجز معترفا % % فمؤمن هو أولا فهو كفار % % 10(@)(@@) % إذ ليس للحق مع شيء مناسبة % % ولا بوجه فكالتصديق إنكار % % PageV01P699 البحر : - 1(@)(@@) % عندنا سر عجيب خطرا % % إن للجهال فيه خطرا % % 2(@)(@@) % نحن ثوب كلنا أجمعنا % % فيه نقش وهو أنواع الورى % % 3(@)(@@) % فسداه أولا قد مده % % ربنا من ذاته نورا برى % % 4(@)(@@) % وهو نور المصطفى حتى كما % % جاءنا نور على نور جرى % % 5(@)(@@) % ثم أبدى لحمه منه له % % حائك الأسماء لما ظهرا % % 6(@)(@@) % وهو ثوب ربنا قد حاكه % % بيد عزت وجلت قدرا % % 7(@)(@@) % ثم منه فصل الروح له % % كقميص للتجلي سترا % % 8(@)(@@) % فوقه النفس كقنباز بدا % % حشوه من كل معنى خطرا % % 9(@)(@@) % فوقها الجبة جسم قد حوى % % ما حوى مما 
ms145	 علا أو قصرا % % 10(@)(@@) % فهي أثواب ثلاث لك يا % % أيها الإنسان تحوي عبرا % % PageV01P700 11(@)(@@) % لابس تلك عليك الله في كل حين فاكتشف ذا الخبرا % . . . % 12(@)(@@) % ثم هذا كله قام بمن % % هو منشيه علا فاقتدرا % % 13(@)(@@) % لا به قام الذي أنشأه % % فالذي ظن حلولا كفرا % % 14(@)(@@) % وهو فان كله أيضا كما % % قال إلا وجهه يا من قرا % % 15(@)(@@) % فالوجود الحق فرد واحد % % وسواه كخيال في الكرى % % 16(@)(@@) % واعتبر نفسك يا جاهلها % % أي شيء شئت واجعل صورا % % 17(@)(@@) % هل تراها كلها قائمة % % لك إلا بك حقق نظرا % % 18(@)(@@) % وتأملها فلا داخلة % % هي أو خارجة عنك ترى % % 19(@)(@@) % ثم هل نفسك عن حالتها % % غيرت إن هي أبدت أثرا % % 20(@)(@@) % لا ومن قال وفي أنفسكم % % أفلا أي تبصرون الفكرا % % PageV01P701 21(@)(@@) % فمثالا ضرب الله لكم % % وهو من أنفسكم قد بهرا % % PageV01P702 البحر : - 1(@)(@@) % الله أنزل حكم أمري % % في نشأتي في ليل قدر وأنا الخفي هنا وما أدرك ما قدري وفخري % % 2(@)(@@) % أنا ليلة القدر التي % % هي خير قل من ألف شهر % % 3(@)(@@) % ذي شهرة من أولياء % % الوقت زبدة أهل عصري % % 4(@)(@@) % تتنزل الأملاك أرواح % % المعاني وسط صدري % % 5(@)(@@) % لمحات أسرار الرجال % % الجامعين لفرق سري % % 6(@)(@@) % أنا شمسهم والنور يبدو % % لي بهم في كل بدر % % 7(@)(@@) % في كل مرتبة لهم % % حسب المقام وحسب ذكر % % 8(@)(@@) % حسب الهلال ورتبة القمر % % الذي في الأفق يجري % % 9(@)(@@) % والروح روح الحق عن % % أذن الإله بكل أمر % % 10(@)(@@) % مني السلام علي حتى % % أنقضي بطلوع فجري % % PageV01P703 البحر : - 1(@)(@@) % باطن الباطن ظاهر % % ظاهر الباطن قاهر % % 2(@)(@@) % أول الأول ثان % % آخر الآخر باهر والذي أثبت ناف وغبي النفي ماهر % % 3(@)(@@) % هذه سكرة صاح % % من شراب هو طاهر % % 4(@)(@@) % لا تقولوا هو هذا % % قولكم يخفي الجواهر % % 5(@)(@@) % هو هذا لا سواه % % عند طرف فيه ساهر % % 6(@)(@@) % والذي نام يرى في % % نومه الطيف المجاهر % % 7(@)(@@) % فهو يحكي عن خيال % % مثل مولود لعاهر % % PageV01P704 البحر : - 1(@)(@@) % يا من ظهرت بنوره الأكوان % % أنت الظاهر % % 2(@)(@@) % حتى كانوا مع أنهم ما 
ms146	 كانوا % % أمر باهر % % 3(@)(@@) % في الغيبة والحضور لا إنسان % % غير القاهر % % 4(@)(@@) % هذا شأن يبدو ويخفي شان % % غر ماهر % % PageV01P705 البحر : - 1(@)(@@) % قلبي بيت له على التنزيه % % والنفس حجاب % % 2(@)(@@) % يبدو منا لنا بلا تشبيه % % ماء وحباب % % 3(@)(@@) % لا يخرج عنه كل شيء فيه % % والشيء سراب % % 4(@)(@@) % حق والكل باطل يدريه % % قلب طاهر % % PageV01P706 البحر : - 1(@)(@@) % في أيمن رامة وذاك الوادي % % مخضوب بنان % % 2(@)(@@) % إن عرض باسمه وغنى الحادي % % ناديت أمان % % 3(@)(@@) % هذا عبد الغني نحو الهادي % % مصروف عنان % % 4(@)(@@) % يهديه تحية المشوق الصادي % % ساهي ساهر % % PageV01P707 البحر : - 1(@)(@@) % ظلمات تقدرت تقديرا % % من قديم وصورت تصويرا % % 2(@)(@@) % وعلا بعضها المرتب بعض % % هكذا طبق ما أتى تحريرا % % 3(@)(@@) % واسمها الكائنات علوا وسفلا % % كاملات لا نقص لا تغييرا % % 4(@)(@@) % كاشف حيث لا بداية عنها % % نور حق يعرف التنكيرا % % 5(@)(@@) % فهي بالنور وهو محض وجود % % مطلق عن قيودها تكبيرا % % 6(@)(@@) % وعهدنا النور المنفر للظلمة % % في الحال إن بدا تنفيرا % % 7(@)(@@) % ثم إنا لما رأيناه أبقى % % وصفها طبق ما اقتضته قريرا % % 8(@)(@@) % وهي لا شك أنها عدم صرف % % قديما قلنا مقالا شهيرا % % 9(@)(@@) % رحمة منه عمت الكل حتى % % أثرت في ظهورهم تأثيرا % % 10(@)(@@) % ولهم ههنا الظهور وخاف % % هو عنهم بهم يرى التستيرا % % PageV01P708 11(@)(@@) % وهو رأي العوام من أهل دين الله حظ النفوس فيهم أثيرا % . . . % 12(@)(@@) % ولنا ههنا مقالة صدق % % حبرتها أئتمى تحبيرا % % 13(@)(@@) % إنما الظاهر الذي ليس يخفى % % نور حق وسل بذاك خبيرا % % 14(@)(@@) % والتي لم تكن ولا هي كانت % % لاح فيها نور الغيوب منيرا % % 15(@)(@@) % ظلمات على الذي هي فيه % % أزلا لم تزل ولا تنويرا % % 16(@)(@@) % إنما النور وحده هو باد % % في ظلام مقدر تقديرا % % 17(@)(@@) % فيرى نفسه برؤيتنا في % % كل شيء لذاك كان بصيرا % % 18(@)(@@) % ونرى نفسنا به ويرانا % % هو أيضا بنا فكان قديرا % % 19(@)(@@) % ونراه برؤية هي منه % % جاءنا وعده بها تبشيرا % % 20(@)(@@) % ثم في الأربع المراتب كشف % % هو هذا للنور ثم استعيرا % % PageV01P709 21(@)(@@) % واعترته مراتب وإضافات % % فسمي عقلا وحسا كثيرا % % 22(@)(@@) % وإذا حقق 
ms147	 المحقق هذا % % ونفى عنه بالسوى تغريرا % % 23(@)(@@) % قال أوصاف ربنا وكذا الأسماء % % بالكائنات فاحت عبيرا % % 24(@)(@@) % فهو منها الأوصاف وهو المسمى % % عندها باعتبارها تقريرا % % 25(@)(@@) % ولهذا نقول تلك قديمات % % وعين الذات التي لا نظيرا % % 26(@)(@@) % وهي ذات حقيقة موصوف % % ومسمى شريعة توقيرا % % 27(@)(@@) % ثم بالشرع والحقيقة نأتي % % ظاهرا باطنا ولا تخييرا % % 28(@)(@@) % ونقول الذي به الكل قالوا % % فنساوي المحقق التحريرا % % 29(@)(@@) % إنهم عند ربهم درجات % % كلهم لا تشيين لا تعبييرا % % 30(@)(@@) % والبرايا قسمان أهل نعيم % % في جنان ومن يرون السعيرا % % PageV01P710 31(@)(@@) % فالذي قلبه المصدق ناج % % وسواه مكفر تكفيرا % % 32(@)(@@) % ثم أهل الجنان قسمان أدنى % % ثم أعلى يرى بها التصديرا % % 33(@)(@@) % والذي فاته الذي نحن فيه % % ههنا من علومنا تقصيرا % % 34(@)(@@) % إن يكن مؤمنا به مذعنا لا % % هو ناف له يراه حقيرا % % 35(@)(@@) % فهو في جنة النعيم ولكن % % لا يرى الرفع والمقام الخطيرا % % 36(@)(@@) % وإذا كان جاحدا مسلما في % % ظاهر الشرع يلتقي تيسيرا % % 37(@)(@@) % وهو في مذهب الحقيقة شخص % % كافر لا يرى الغداة نصيرا % % 38(@)(@@) % وبحكم الحقيقة الله فينا % % حاكم في غد فكن مستجيرا % % 39(@)(@@) % وهنا الشرع لانتظام أمور الناس % % وافى مبشرا ونذيرا % % 40(@)(@@) % فاغتنم ما أقوله لك واعرف % % وتذكر بفهمه تذكيرا % % PageV01P711 41(@)(@@) % وتبين مقالتي فهي نصح % % لك جاءت فحذرت تحذيرا % % PageV01P712 البحر : - 1(@)(@@) % هو أمر وكل أمر % % وهو زيد هنا وعمرو % % 2(@)(@@) % غمرته شؤونه % % ذاته ذاتهن غمر % % 3(@)(@@) % عنه خذ كل ذرة % % ملئت منه كأس خمر % % 4(@)(@@) % وتمتع بوصله % % روحه فيك نفخ زمر % % 5(@)(@@) % واترك الجاهل الغبي % % قلبه في سواه جمر % % 6(@)(@@) % وتجنب كلامه % % ليس كل اللذيذ تمر % % 7(@)(@@) % ثم حقق وقل له % % هو أمر وكل أمر % % PageV01P713 البحر : - 1(@)(@@) % إن محسوسات الحواس الظواهر % % إن معقولات العقول البواهر % % 2(@)(@@) % إن أنواع هذه العرضيات % % وأجسامها وكل الجواهر % % 3(@)(@@) % معنويات روح أمر شريف % % تتراءى له به وهو قاهر % % 4(@)(@@) % قائمات به قيام المعاني % % بالمعاني لها الذي هو ماهر % % 5(@)(@@) % وهو روح لطف من الله باد % % وهو خاف عن الجميع وظاهر % % 6(@)(@@) % نور طه الرسول 
ms148	 مركز علم % % الغيب بالذات والصفات الشواهر % % 7(@)(@@) % من ترقى له به عنه كشفا % % كأنه فهو ذو العيون السواهر % % PageV01P714 البحر : - 1(@)(@@) % هو المشكور والشاكر % % هو المذكور والذاكر % % 2(@)(@@) % هو الممكور فيه % % قد بدا والمكر والماكر % % 3(@)(@@) % هو الأمر الذي قد أنكروا % % والنكر والناكر % % 4(@)(@@) % معان كلها فيه % % فقم لرياضها باكر % % 5(@)(@@) % وأطلق ذاته فيها % % وحاذر عقلك الحاكر % % PageV01P715 البحر : - 1(@)(@@) % يا صبا الأسحار % % هجت أشواقي فاشرح الأخبار عند أرفاقي % % 2(@)(@@) % إن وجدي % % نحو نجد ليت يجدي كلما قد ثار % % PageV01P716 البحر : - 1(@)(@@) % هذه سلمى % % أقبلت تختال ثغرها الألمى لي سقى الجريال % % 2(@)(@@) % يا رفيقي % % في طريقي ضاق زيقي فأهتك الأستار % % PageV01P717 البحر : - 1(@)(@@) % دار في الحضره % % لابس الأثواب لي به نظره وهي فتح الباب % % 2(@)(@@) % جل أمري % % ذات خدر راق خمري دارت الأدوار % % PageV01P718 البحر : - 1(@)(@@) % عج على الوادي % % سائق الإظعان نغمة الحادي هاجت الركبان % % 2(@)(@@) % والأغاني للمعاني % % كالمباني تظهر الأسرار % % PageV01P719 البحر : - 1(@)(@@) % يا غني عبدك % % دائما صلى للذي عندك في العلا جلا % % 2(@)(@@) % وهو طه % % نال جاها يتباهى بعطا الجبار % % PageV01P720 البحر : - 1(@)(@@) % قوم بهم ينفخ الشيطان نفخ الزمر % % فيظهرون التمسك ظاهرا بالأمر % % 2(@)(@@) % إن رمت أوصافهم تدري بهم يا عمرو % % لا يشربون النتن بل يشربون الخمر % % PageV01P721 البحر : - 1(@)(@@) % قد رام فرعون أن يتبع أباه الخضر % % دعوى بنفسه فقدم نفسه في الصدر % % 2(@)(@@) % وقال أنا ربكم بالنفس ذات الخدر % % حتى غرق فاحترق بالنار نار القدر % % PageV01P722 البحر : - 1(@)(@@) % حرف له بالانحراف مظاهر % % وهو الذي هو في الإضافة قاهر % % 2(@)(@@) % متنوع الحركات في سكناته % % وله كمال بالإحاطة باهر % % 3(@)(@@) % وجهان فيه فواحد متقاصر % % عن دركما فيه وآخر ماهر % % 4(@)(@@) % نامت عيون الأولين به وما % % منهم به قد فاز إلا الساهر % % 5(@)(@@) % وحقيقة في الغيب منه تقدست % % وتدنست أخرى به تتجاهر % % PageV01P723 البحر : - 1(@)(@@) % إن هذا بعض ما قد ظهرا % % من جمال المصطفى خير الورى حجرة تجمع طه وأبا بكر الصديق حتى عمرا % % 2(@)(@@) % ثم في ثوبيهما كان بدا % % وأعيد الآن لما قبرا % % 3(@)(@@) % حضرة في حضرة في حضرة 
ms149	 % % أثرت في كل قلب أثرا يا جميل الوجه إني أينما لك فارفع عن تولوا ضررا % % 4(@)(@@) % إنه النور الذي منك أتى % % يقتفي البحر فيحوي الدررا % % 5(@)(@@) % ومعانيه إذا لاحت به % % فهي منه فيه أمر خطرا % % 6(@)(@@) % صحت الأمة في أنفسها % % مثل نفسي أمتي منك جرى % % 7(@)(@@) % وعفا الرحمن عما حدثت % % أمتي أنفسها قد أثرا % % 8(@)(@@) % يا بني الجمع هو الفرق لكم % % كل من جال به واعتبرا % % PageV01P724 البحر : - 1(@)(@@) % وجه الحبيب بدا في الكائنات لنا % % ونحن بالشوق في هم وأكدار % % 2(@)(@@) % وقد تحير من يدري بحالتنا % % فالعين في جنة والقلب في نار % % PageV01P725 البحر : - 1(@)(@@) % دنا كل المنى % % لما دنا بالمنحنى % % 2(@)(@@) % أواه ممن خلف الستور % % يا ليته لو لنا يزور % % 3(@)(@@) % أنا له أنا % % ما ههنا إلا العنا % % 4(@)(@@) % من يجليه امتلا سرور % % عشقي له النار وهو نور % % 5(@)(@@) % لنا هذا البنا % % لما اعتنى تكونا % % 6(@)(@@) % لولاك يا صاحب الحضور % % ما أشرقت في الدجى بدور % % 7(@)(@@) % جنى فرط الهنا % % نهب الضنا ملقى العنا % % 8(@)(@@) % متيم عشقه يجور % % عليه في ربة الخدور % % PageV01P726 البحر : - 1(@)(@@) % علا عن الملا % % باهى الحلى لما حلا % % 2(@)(@@) % جماله حير العقول % % له على قلوبنا نزول % % 3(@)(@@) % جلا كأس الطلا % % لما تلا قالوا بلى % % 4(@)(@@) % يا سعد من فاز بالوصول % % وصار فيه به يصول % % 5(@)(@@) % هلا يا من إلى % % ذاك الفلى تنقلا % % 6(@)(@@) % كن باسمه الحق في حصول % % تجد فروعا لها أصول % % 7(@)(@@) % ألا صل على % % تاج الولا من اعتلى % % 8(@)(@@) % عبد الغني سلم الأمور % % لمن عليه الرحى تدور % % PageV01P727 البحر : - 1(@)(@@) % هو الكون والسداء هو الأمر % % ولحمته الخلق اقتضى نهيه الأمر % % 2(@)(@@) % وحائكه الأسماء أسماء ربنا % % تعالى بمكوك الوجود به الضفر % % 3(@)(@@) % وما غزله إلا من العدم الذي % % تقدر في العلم القديم له القدر ملونة أطرافه في حباكها فبيض وسود تلك والخضر والحمر % % 4(@)(@@) % ولابس ذاك الثوب حائكه على % % نهاية تنزيه وهذا هو الستر % % 5(@)(@@) % فيخلعه طورا ويلبس تارة % % كلمعة برق ما له أبدا حصر % % 6(@)(@@) % تنزل حق في 
ms150	 غيابه ذاته % % إلى فعله بالعلم سر هو الجهر % % 7(@)(@@) % إلا هكذا الآفاق فانظر جميعها % % ونفسك لا يغررك زيد ولا عمرو % % 8(@)(@@) % وحقق وجود الحق في الكون وحده % % ولا كون لا شفع هناك ولا وتر % % 9(@)(@@) % ولكنها الأقدار منه تقدرت % % فلا تلغها واعرف فإلغاؤها كفر % % 10(@)(@@) % ودع عنك أقواما عليها تزندقوا % % يقولون بالتوحيد توحيدهم نكر % % PageV01P728 11(@)(@@) % فينفون لا بالحس والذوق كل ما % % يرون من الأكوان عندهم المكر % % 12(@)(@@) % يقولون غير الله ما في قلوبنا % % بزور وبهتان وكذب هو الوزر % % 13(@)(@@) % يريدون إسقاط التكاليف بالفنا % % فنا الوهم والدعوى وما عندهم خبر % % 14(@)(@@) % ولو صدقوا ماتوا وزالت نفوسهم % % ولم يبق فيهم قائل وله فكر % % 15(@)(@@) % بلى يدعون الموت والحال كاذب % % وما الصحو عند الناس يخفى ولا السكر % % 16(@)(@@) % وهيهات أين الفتح والكشف والهدى % % وأين علوم الله يقذفها البحر وهم يزعمون اللب ما اعتقدوه من ضلالاتهم والناس عندهم القشر % % 17(@)(@@) % وأقوال محيي الدين بالجهل غيروا % % وقد ألحدوا فيها وهم كلهم غمر % % 18(@)(@@) % وأقوالنا أيضا يظنون أنها % % يوافقهم من لفظها النظم والنثر % % 19(@)(@@) % ومنهم بريء إنني وإن انتموا % % إلى على كره لدي ولي زجر % % 20(@)(@@) % عوام ولا علم لديهم يردهم % % ولا عقل ينهاهم وليس لهم عذر % % PageV01P729 البحر : - 1(@)(@@) % شرعنا أحكام حق % % لمقيم ومسافر % % 2(@)(@@) % وهو أسباب وقولوا % % منكر الأسباب كافر % % PageV01P730 البحر : - 1(@)(@@) % ثلاث عليها يدور % % وجود وحق ونور % % 2(@)(@@) % وطورا نرى هكذا % % نجوم شموس بدور % % 3(@)(@@) % هي الروح مثل الرحى % % وأجسامنا كالقدور % % 4(@)(@@) % وما ثم غير الذي % % له الأمر وهو الأمور % % 5(@)(@@) % كثير بنا واحد % % به ذو انتقام غفور % % 6(@)(@@) % تجلى فقلنا هدى % % تحجب قلنا غرور % % 7(@)(@@) % ويتلو علينا وهل % % يجازى إلا الكفور % % 8(@)(@@) % على ما عليه كان % % ما غيرته الدهور % % 9(@)(@@) % ألا والظهور البطون % % ألا والبطون الظهور % % 10(@)(@@) % شكرناه حتى لقد % % تسمى لنا بالشكور % % PageV01P731 11(@)(@@) % وأيضا صبرنا به % % فجاء باسم الصبور % % 12(@)(@@) % ولم تعم إلا القلوب % % عنه التي في الصدور % % 13(@)(@@) % وتالله ما أنكرته % % إلا خفافيش عور % % PageV01P732 البحر : - 1(@)(@@) % لا فرق عندي بين الوتر 
ms151	 والوتر % % وليلة القدر عندي ليلة القدر % % 2(@)(@@) % قد قال يفرق فيها قول خالقنا % % من كل أمر حكيم حكم مقتدر % % 3(@)(@@) % فانهض بذوقك للطنبور تسمعه % % والناي فالخبر يستوفى من الخبر % % 4(@)(@@) % وإنها حركات من يد وفم % % ومن يراع ومن رق ومن وتر % % 5(@)(@@) % وما المحرك إلا واحد هو في % % غيب الغيوب تعالى مظهر الأثر % % 6(@)(@@) % وأنت تعرف هذا لست تنكره % % لكن بفهمك مفتون وبالفكر % % 7(@)(@@) % ليس المغني وليس الدف في يده % % غير المصور فينا سائر الصور % % 8(@)(@@) % وكلها عدم يبدو الوجود بها % % ويختفي عند مغرور ومعتبر % % 9(@)(@@) % هي التصاوير شاءتها الإرادة من % % خير وشر ومن نفع ومن ضرر % % 10(@)(@@) % فافطن لها واسمها الأشياء عندك في % % حكم الكتاب كتاب الله فاعتبر % % PageV01P733 11(@)(@@) % وخذ إشارة إلا وجهه لتفز % % بما به فاز أهل الجانب الخطر % % PageV01P734 البحر : - 1(@)(@@) % أيا أحمد البدوي أنت أين % . . . % 2(@)(@@) % لقد حزت في وقتك الرتبتين % . . . % 3(@)(@@) % هما الاسم والذات من غير مين % . . . % 4(@)(@@) % وراياتك لحمر في الخافقين % % تشير بأنك قطب الورى % % 5(@)(@@) % لك العز والفخر والرونق % . . . % 6(@)(@@) % وفي تابعيك لك الصنجق % . . . % 7(@)(@@) % وأنت هو الملك الأسبق % . . . % 8(@)(@@) % وشأن الملوك الذين ارتقوا % % على المجد أن يلبسوا الأحمرا % % PageV01P735 البحر : - 1(@)(@@) % حوضي الذي ماؤه طول المدى جاري % % من عين أمر الذي لما يزل جاري % % 2(@)(@@) % هيهات يا غر أن أعطش وهو جاري % % إن كنت تقدر على هذا فلي جاري % % PageV01P736 البحر : - 1(@)(@@) % حوضي الذي فيه أنبوبان من كوثر % % نهر الجنان قليلو للسوى كوثر % % 2(@)(@@) % أنبوب روحي وأنبوب الجسد كوثر % % يسن موسى الهوى للخلق يا كوثر % % PageV01P737 البحر : - 1(@)(@@) % حججت إلى البيت المقدس حجة % . . . % 2(@)(@@) % وللحب فيه قد سلكت محجة % . . . % 3(@)(@@) % وكنت إذا ما رجني العشق رجة % . . . % 4(@)(@@) % علقت بمن أهواه عشرين حجة % % ولم أدر من أهوى ولم أعرف الصبرا % % 5(@)(@@) % ألا إنها سلمى دعيت لفقهها % . . . % 6(@)(@@) % ممنعة لم أستطع درك كنهها % . . . % 7(@)(@@) % وما العقل راج أن يفوز بشبهها % . . . % 8(@)(@@) % ولا نظرت عيني إلى حسن وجهها % % ولا سمعت أذناي قط له ذكرا % % 9(@)(@@) % تجلت جهارا والبرية في 
ms152	 عمى % . . . % 10(@)(@@) % سوى من بها ذاق الفنا فتنعما % . . . % PageV01P738 11(@)(@@) % وما زلت أسعى في رضاها مصمما % . . . % 12(@)(@@) % إلى أن تراءى البرق من جانب الحمى % % فنعمني يوما وعذبني دهرا % % PageV01P739 البحر : - 1(@)(@@) % قم تأمل في هذه الأنوار % % واخل منك المحل للأسرار % % 2(@)(@@) % لا تقل كيف أنت أصبحت أم كيف % % العدا إننا بحكم الباري % % 3(@)(@@) % نحن في جنة المعارف نزهو % % والعدا في جهنم الإنكار % % 4(@)(@@) % هم حجاب لنا عليهم كثيف % % حاجب من ظهور شمس النهار % % 5(@)(@@) % ظلمات ونحن في نور حق % % هو عنهم بكونهم متواري % % 6(@)(@@) % أنكروه لأنهم جهلوه % % وعن الجنة اكتفوا بالنار % % 7(@)(@@) % يتجلى بهم علينا فندري % % كيف عنهم بهم غدا في استتار % % 8(@)(@@) % كلما أشرقت لنا الشمس منهم % % أظلمت عندهم على الأبصار % % 9(@)(@@) % فرمتهم نفوسهم في جحيم % % لا يبالون بالعمى والعوار % % 10(@)(@@) % هكذا هم في علمه من قديم % % وكذا أنت هكذا كم تماري % % PageV01P740 البحر : - 1(@)(@@) % هو أمر وكل أمر % % وهو زيد هنا وعمرو % % 2(@)(@@) % وهو غيب مقدس % % شربته الرجال خمر % % 3(@)(@@) % وأكلناه خبزة % % وهو زبد لنا وتمر % % 4(@)(@@) % جنة في غد لنا % % وعلى الكافرين جمر % % 5(@)(@@) % غمرتنا هباته % % وبها للجميع غمر % % 6(@)(@@) % نحن تقديره له % % طبق نهي لنا وأمر % % 7(@)(@@) % نافخ في جسومنا % % روح أمر كنفخ زمر % % 8(@)(@@) % ولنا النشر في غد % % منه في التراب بعد طمر % % 9(@)(@@) % وهو لا شك قامر % % كل شيء إليه قمر % % 10(@)(@@) % حيث محض الوجود هو % % ضامر من عداه ضمر % % PageV01P741 11(@)(@@) % عدم كلنا وكامرنا % % بالوجود كمر % % PageV01P742 البحر : - 1(@)(@@) % يا خبرا عني إذا % % قلت أنا أنت الأبر % % 2(@)(@@) % لا شك أني مبتدا % % والمبتدأ عين الخبر % % 3(@)(@@) % فإنك ابتدأتني % % خلقا لهذه العبر % % 4(@)(@@) % وقائم وقاعد % % أنت إذا المر العبر % % 5(@)(@@) % وقام وقاعد % % أنت إذا المر اختبر % % 6(@)(@@) % وقال أنت فاعل % % بالوصف قولا فيه بر % % 7(@)(@@) % واختلف النحاة في % % شرط اعتماد يعتبر % % 8(@)(@@) % كحرف الاستفهام أو % % نفي وبعض ما اعتبر % % 9(@)(@@) % واعلم بأن النحو توحيد % % به الله جبر % % 10(@)(@@) % ولغة للعرب العربا لسان من غبر % . . . % PageV01P743 11(@)(@@) % والواضع الله على القول 
ms153	 % % الصحيح المعتبر % % 12(@)(@@) % وأنزل الله به القرآن % % كله عبر % % 13(@)(@@) % فكيف لا يكون للعرفان % % بحرا وهو بر % % 14(@)(@@) % فافهم كلامي إنه % % أدق من خرم الإبر % % 15(@)(@@) % واصبر عليه واصطبر % % نال المنى من اصطبر % % 16(@)(@@) % وإن تكن جهلته % % فإنها إحدى الكبر % % PageV01P744 البحر : - 1(@)(@@) % كلنا واحد هو الأمر % % وهو سر له بنا جهر % % 2(@)(@@) % نحن خلق له وكثرتنا % % وحدة إذ لموجنا بحر % % 3(@)(@@) % قف هنا يا ابن عقله أدبا % % عقلك الروض والورى زهر % % 4(@)(@@) % إن تكن كنت أمره وإذا % % لم تكن فهو ما له حصر % % 5(@)(@@) % هذه حالة سكرت بها % % لا تلمني وغرني السكر % % 6(@)(@@) % ثم إني متى صحوت أقل % % هو لا غيره ولا نكر % % 7(@)(@@) % طر به عنه في الوجود إلى % % عينه لا يصيبك المكر % % PageV01P745 البحر : - 1(@)(@@) % لقد قيل لي ما الفرق عند أولي الذكر % % فبسملة الإسلام بسملة الكفر % % 2(@)(@@) % فقلت تعالى الله ربي عن الذي % % أضل به كل النصارى مدى الدهر % % 3(@)(@@) % فبسملة الإسلام أسماء ربنا % % تبارك في القرآن جاءت عن الطهر % % 4(@)(@@) % محمد المبعوث للخلق رحمة % % بوحي هو القرآن للحمد والشكر % % 5(@)(@@) % وبسملة الكفر التي قيل إنها % % بها جاء عيسى ضمن إنجيله الزهر % % 6(@)(@@) % وما صدق الراوي لها وهو كافر % % وأخبار أهل الكفر باطلة الخبر % % 7(@)(@@) % وإني على تسليم زعم رواتها % % سأبدي لكم معنى عبارتها العبري % % 8(@)(@@) % يقولون عيسى قال باسم الأب الذي % % تولد عيسى منه بالنفخ في البكر % % 9(@)(@@) % نهم هو روح الله بالبشر السوي % % أتى وهو جبريل المؤيد بالبشر وجبريل كانت في السموات صورة له عظمت فوق السماكين والنسر % % 10(@)(@@) % وتلك له قد صورت عن حقيقة % % لأول مخلوق هو الروح فاستقر % % PageV01P746 11(@)(@@) % ألا فافهموا مخلوقة قد تثلثت % % وكانت هنا من قبل واحدة الأمر % % 12(@)(@@) % هي الروح جبريل وفي صورة امرىء % % سوي كما قد جاء في محكم الذكر % % 13(@)(@@) % بآية أرسلنا إليها فروحنا % % وجبريل والشخص الممثل كالبدر % % 14(@)(@@) % ثلاثة أشباح وهو واحد بدا % % من العدم المقدور يعظم في القدر % % 15(@)(@@) % فما الأب إلا الروح وهو أبو الورى % % جميعا 
ms154	 لمن يدري كلامي كما أدري % % 16(@)(@@) % وما الابن إلا صورة قد تمثلت % % هي البشر الآتي وجبريل ذو الفخر % % 17(@)(@@) % يؤيد هذا قوله جئت من أبي % % إليكم أبوه الروح منه أتى يبري % % 18(@)(@@) % وقد فهمت منه النصارى بأنه % % هو الله جل الله عن موجب الحصر % % 19(@)(@@) % وحاشى رسول الله وهو ابن مريم % % يقول كلام الكفر والشرك والوزر % % 20(@)(@@) % وهذا بعيد أن عيسى ابن مريم % % يظن بأن الله يدرك بالحجر % % PageV01P747 21(@)(@@) % وحاشاه من تشبيه ربي عنده % % ومن نسبة التجسيم في السر والجهر % % 22(@)(@@) % وإن لمخلوق عليه تسلطا % % بعقل فإن العقل منه لفي خسر % % 23(@)(@@) % وهيهات أن الأنبيا يجهلونه % % تعالى وكل منه في قبضة الأسر % % 24(@)(@@) % وما أنبياء الله إلا لكلهم % % عقائد تنزيه تشعشع في الصدر % % 25(@)(@@) % ولكن ذوو الطغيان والجهل والعمى % % حيارى من الإنكار للحق والغدر % % 26(@)(@@) % هم الأشقيا الضالون عن سنن الهدى % % وعن شم طيب الحق من فائح العطر % % 27(@)(@@) % أتاهم رسول الله بالحق واضحا % % فلم يفهموا ما قال من أول الأمر % % 28(@)(@@) % وظنوا بأن الله مقصده بما % % يقول وضلوا عن تنزه ذي القهر % % 29(@)(@@) % وأغواهم الشيطان حتى تكلموا % % بوسواسه المذموم من شدة المكر % % 30(@)(@@) % وقد حسبوا كفرا لديهم مشابها % % لإيماننا بالله في العسر واليسر % % PageV01P748 31(@)(@@) % وما نور تصديق كظلمة جاحد % % ولا ماء معمودية ماء ذي طهر % % 32(@)(@@) % ولا طاهر سرا وجهرا بمشبه % % لذي نجس سرا وجهرا مدى العمر % % 33(@)(@@) % فبسملة الإسلام نور مضيئة % % وبسملة الكفر اعتقاد أولي الكفر وإن كان معناها على المشرب الذي به جاء عيسى عندنا علمها يجري % % 34(@)(@@) % كما نحن قلنا وهو ذوق ابن مريم % % يشير به عن نفسه كاشف الستر % % 35(@)(@@) % فإن الذي لم يعرف النفس منه لم % % يكن يعرف الرب المحقق بالحزر % % 36(@)(@@) % محمد ذاتي فبسملة له % % أتت من مقام الذات قاصمة الظهر % % 37(@)(@@) % بأسماء ذات الله قد صرحت لنا % % وعيسى صفاتي كآدم في السبر % % 38(@)(@@) % وأسماء ربي للصفات مظاهر % % بها تظهر الآثار حدث عن البحر % % 39(@)(@@) % لآدم أنبئهم باسمائهم أتى % % وأنباء عيسى كان بالخلق 
ms155	 والأمر % % 40(@)(@@) % فبسملة الأسماء تلك إذا بدت % % تكون بآثار المؤثر في الأثر % % PageV01P749 41(@)(@@) % خذ العلم عني بالذي أنا مرشد % % إليه عن الأمر الإلهي في شعري % % 42(@)(@@) % ودع عنك أفهام العقول التي بها % % لقد أولوا المنقول بالرأي والفكر % % 43(@)(@@) % لأجل عوام الناس حيث تقاصرت % % بصائرهم عن علم صاحبة القصر % % 44(@)(@@) % فما عندهم عجز عن الغيب دائما % % كما عندنا خوفا عليهم من النكر % % 45(@)(@@) % يظنون أن العلم بالله مثل ما % % يقولون عن زيد بعلم وعن عمرو % % 46(@)(@@) % ونعلم نحن الرتبتين كلاهما % % ونعرف ما قد غاب عن جاهل غمر % % 47(@)(@@) % وإن لكل الأبيناء مشاربا % % محققة عندي لها نفحة الزهر % % 48(@)(@@) % فإن شئت أبدي بعض ذاك وربما % % ترى في كلامي منه في النظم والنثر % % 49(@)(@@) % وإني لمن من نال ميراث جامع % % فنيت به فيه فأيقنت بالنصر % % 50(@)(@@) % محمد المبعوث بالحق قاصما % % رقاب الأعادي بالمهندة البتر % % PageV01P750 51(@)(@@) % عليه صلاة الله ثم سلامه % % مدى الدهر ما غنى على عوده القمري % % 52(@)(@@) % مع الآل والأصحاب ما العبد للغني % % أتى بنظام طيب الطي والنشر % % PageV01P751 البحر : - 1(@)(@@) % صدقتهم هي الأكوان تطوى وتنشر % . . . % 2(@)(@@) % وفي صدف الأوقات للحق جوهر % . . . % 3(@)(@@) % كما قال محيي الدين وهو المقرر % . . . % 4(@)(@@) % لنا دولة في آخر الدهر تظهر % % فتظهر مثل الشمس لا تتستر % % 5(@)(@@) % ألا نحن قوم قد عرفنا بهولنا % . . . % 6(@)(@@) % بقوتنا لا نستقل وحولنا % . . . % 7(@)(@@) % تنح ولا تنكر نصبك بصولنا % . . . % 8(@)(@@) % فمن كتان منا أو يقول بقولنا % % فبشره بالدنيا والأخرى يبشر % % PageV01P752 البحر : - 1(@)(@@) % نحن أهل الصفا لا نقبل الكدرا % % أقبل علينا صفيا واسمع الخبرا % % 2(@)(@@) % وكن بأوصافنا في القرب متصفا % % تنل مرادك منا كيف منك جرى % % 3(@)(@@) % واستعمل الصبر فيما كنت تطلبه % % فإنما يبلغ الآمال من صبرا % % 4(@)(@@) % واقصد إلهك لا تقصد سواه تفز % % ويذهب الله عنك السوء والضررا % % 5(@)(@@) % إياك إياك لا تشرك به أحدا % % مما سمعت وما عيناك فيه ترى فإنه واحد فرد تنزه عن كل الحوادث بل لا يشبه الصورا % % 6(@)(@@) % وقد تكفل بالأرزاق من أزل % % لا الأغنيا هو ينساهم ولا 
ms156	 الفقرا % % 7(@)(@@) % غيب عن العقل حق والسوى عدم % % فحقق الأمر واترك كل ما خطرا % % 8(@)(@@) % واقنع به حيثما وليت معترفا % % بفضله فاز من للفضل قد شكرا % % 9(@)(@@) % ولا تكن يائسا منه وإن كثرت % % منك الذنوب لعل الذنب قد غفرا % % 10(@)(@@) % لا أنت تدري ولا يدري سواك وإن % % جل المقام فإن السر قد سترا % % PageV01P753 11(@)(@@) % واحذر من الأمن أيضا فهو مهلكة % % والله يمكر فاحسب أنه مكرا % % 12(@)(@@) % ثم استقم دائما ترجو مواهبه % % وتختشي منه تقضي عنده الوطرا % % PageV01P754 البحر : - 1(@)(@@) % نحن الملوك الفقرا % % في الناس حكمنا جرى % % 2(@)(@@) % ولا جنود عندنا % % ولا نريد عسكرا % % 3(@)(@@) % ولا لنا مال ولا % % جاه ولا قدر يرى % % 4(@)(@@) % وما لنا من مسعف % % ولا معين في الورى % % 5(@)(@@) % ومن يرد يدوسنا % % برجله دوس الثرى % % 6(@)(@@) % وكم علينا يعتدى % % وكم علينا يفترى % % 7(@)(@@) % وصبرنا حصن لنا % % من الأذى والافترا % % 8(@)(@@) % ونحن لا نحن ولا % % ذات ولا وصف سرى % % 9(@)(@@) % ولم نزل في عدم % % نقر في أم القرى % % 10(@)(@@) % وهو المحقق الذي % % به نراه لا مرا % % PageV01P755 11(@)(@@) % بل لا يراه غيره % % ومن داره ما درى % % PageV01P756 البحر : - 1(@)(@@) % إن الغني إلى المولى من افتقرا % % في كل حال وعن أغياره نفرا % % 2(@)(@@) % وما له رغبة في غير سيده % % بحكمه هو راض منه كيف جرى % % 3(@)(@@) % يا أغنياء بدرس العلم مطلبكم % % مال وجاه وتقريب إلى الأمرا % % 4(@)(@@) % خلوا المساكين في علم الإله ولا % % تكلفوهم يزيلوا حالة الفقرا % % 5(@)(@@) % تحقيركم والأذى منكم لهم حسد % % بل ذاك بغض وتقبيح بكم ظهرا % % 6(@)(@@) % هم تاركون لكم ما تفخرون به % % فلتتركوهم وكفوا عنهم الخبرا % % 7(@)(@@) % خذوا التقدم في الدنيا بأجمعه % % على الفقير وخلوه يكون ورا % % 8(@)(@@) % فكم تسيئون ظنا تغلبون به % % فيظهر القهر والدنيا لمن قهرا % % 9(@)(@@) % علومكم كلها في الله منشأها % % من العقول على مقدار ما خطرا % % 10(@)(@@) % أتحسبون بأن الدين أجمعه % % ما عندكم من علوم من أراد قرا % % PageV01P757 11(@)(@@) % دين النبي ابن عبد الله بحر هدى % % أمواجه كل بحر أن بدا بهرا % % 12(@)(@@) % لا 
ms157	 بالعقول ولا بالفكر يطلبه % % من قد أراد وإن طول الدجى سهرا % % 13(@)(@@) % وإنما هو في تقوى القلوب وما % % في الوسع من طاعة بالصدق منك ترى % % 14(@)(@@) % وبانكسار وذل في الطريقة مع % % ذوق الفناء بوجدان لديك سرى % % 15(@)(@@) % والذكر بالله لا باللفظ تورده % % مع غفلة منك عنه كلما ذكرا % % 16(@)(@@) % وراقب الله في الأحوال أجمعها % % وأحضر لديه به قد فاز من حضرا % % 17(@)(@@) % غيب الغيوب بأسرار القلوب له % % معاملات توالت تتبع القدرا % % PageV01P758 البحر : - 1(@)(@@) % لو خلق الله وجودا للورى % % لكان مثله ومثله افترا % % 2(@)(@@) % والله ليس مثله شيء كما % % قد جاء في القرآن عند من قرا % % 3(@)(@@) % والوهم في العقول ذاهب إلى % % أن الوجود اثنان هكذا جرى % % 4(@)(@@) % وجود خلق ووجود خالق % % هو اشتراك وهو شرك يمترى % % 5(@)(@@) % وإنما الخلق جميعا عدم % % مقدر له الإله قدرا % % 6(@)(@@) % وكلهم في العلم مفروضاته % % وعلمه القديم محلول العرى % % 7(@)(@@) % وقد تجلى بالتقادير التي % % قدرها جميعها فظهرا % % 8(@)(@@) % منزها مقدسا عنها وعن % % جميع ما في العقل قد تصورا % % 9(@)(@@) % فهو الوجود الحق ظاهر لنا % % وباطن عن غيرنا مستترا % % 10(@)(@@) % لأن غيرنا يرى تقديره % % ولا يراه لا رأى ولا درى % % PageV01P759 11(@)(@@) % وكل تقدير بلا مقدر % % هو المحال المحض في عقل الورى % % 12(@)(@@) % ومن يصور صورة من عدم % % فإنه وجودها الذي يرى % % 13(@)(@@) % لكنها محجوبة عنه بها % % والعلم يكشف الذي تقررا % % 14(@)(@@) % والجاهل المغرور هذا عنده % % مستعبد ضل به فأنكرا % % 15(@)(@@) % ونحن نعلم التقادير التي % % قدرها الباري الذي لها يرى % % 16(@)(@@) % ونحن من جملتها أجمعنا % % وهو الوجود الحق ما فيه امترا % % 17(@)(@@) % وإنه غيب ولا تعرفه % % وعجزنا عنه لنا تحررا % % 18(@)(@@) % فاتبع طريقنا وقل بقولنا % % إن رمت شيخنا الكبير الأكبرا % % PageV01P760 البحر : - 1(@)(@@) % إن هذا زمن الأمر العسير % % ما خلا من شره كل العشير % % 2(@)(@@) % إنهم في الحس والعقل إذا % % أبصروا أو أدركوا قالوا كثير % % 3(@)(@@) % جعلوه اثنين عنهم واحد % % غائب والآخر الجم الغفير % % 4(@)(@@) % والذي وحده ألحد في % % زعمهم ما إن له منهم نصير % % 5(@)(@@) % أصل هذا 
ms158	 أنهم يعتقدون % % سوى الله بتأثير يصير % % 6(@)(@@) % وهو جزء اختياري لهم % % حققوه وإلى الله المصير % % 7(@)(@@) % وتراهم يعبدون الله مع % % طلب المال به المال الحقير % % 8(@)(@@) % ولهذا ما له من عابد % % عندهم إلا وبالمال يشير % % 9(@)(@@) % فالعبادات جميعا خلطوها % % بتحصيل عسير ويسير % % 10(@)(@@) % أين أين المخلصون استمعوا % % يا رفاقي واتركوا الشرك المبير % % PageV01P761 11(@)(@@) % وإلى الله أرجعوا واستغفروا % % ربكم مما به نار السعير % % 12(@)(@@) % إنما قد أمروا أن يعبدوا % % مخلصين الدين في قول القدير % % 13(@)(@@) % وألا لله دين خالص % % هو معنى قوله وهو الخبير % % PageV01P762 البحر : - 1(@)(@@) % خذوا علمكم بالله لا تتأخروا % % وبالكون من كن لا من العقل تبصروا % % 2(@)(@@) % فكن قوله الحق الذي هو كلمة % % وجودية عنها الحوادث تظهر % % 3(@)(@@) % ظهور ضياء من خروق تقدرت % % لكم في جدار والضيا لا يقدر % % 4(@)(@@) % ولكنه يبدو بها وهي فعله % % وما حل فيها وهو فيها يؤثر % % 5(@)(@@) % ولا تحسبوا مني المثال ضربته % % هو الله للأمثال يضرب فانظروا % % 6(@)(@@) % ونحن أولاء العالمون بها كما % % لنا قال في القرآن وهو المصور % % 7(@)(@@) % يصور أمثالا ونعقلها به % % وما الغير إلا حائر متنكر % % 8(@)(@@) % وأمثاله مخلوقة كبعوضة % % فما فوقها يدري بها المتدبر % % 9(@)(@@) % عليكم كتاب الله أي فالزموه كي % % تكون اعتقادات لكم فيه تحصر % % 10(@)(@@) % وقال كتاب الله قدمه على % % عليكم لينفي غيره فتدبروا % % PageV01P763 11(@)(@@) % وكن فيكون الشيء يوجد نسبة % % إليه بلا استقلاله حين يؤمر % % 12(@)(@@) % ألا هكذا فافهم كلام إلهنا % % فإن كلام الله يطوي وينشر % % 13(@)(@@) % كما كل أمر ربنا آمر به % % لنا هو فينا خالق ومدبر % % 14(@)(@@) % فنفعله في ظاهر وهو فاعل % % له باطنا مثل الوجود يقدر % % 15(@)(@@) % هو الشيء ربي شاءه وهو هالك % % كما قال إلا وجهه فتبصروا % % 16(@)(@@) % ولا تحسبوا الأشياء منه تولدت % % فليس من الحق الأباطل تصدر % % 17(@)(@@) % وليس وجود من وجود يكون قل % % هو الله واقرأ ما هو المتقرر % % 18(@)(@@) % فربك لم يولد ولم يلد استمع % % مقالته في الذكر أيان تذكر % % 19(@)(@@) % وكن مثل ما قد كنت في علمه بلا % % وجود وجود 
ms159	 الله لا يتكرر % % 20(@)(@@) % ولكنه لما بدا متجليا % % حسبتم لكم صار الوجود المطهر % % PageV01P764 21(@)(@@) % وأنتم به التقدير من عدم له % % على صولة الأسماء يخفي ويظهر % % 22(@)(@@) % وقد قال أطوارا زمانا وتارة % % نموت به والله لا يتغير % % 23(@)(@@) % فنحيا به طورا زمانا وتارة % % نموت به والله لا يتغير % % 24(@)(@@) % أقم عاجزا عنه وآمن به ولا % % تشبهه بالمعنى الذي فيه تفكر % % 25(@)(@@) % ونزهه عن محسوس حسك دائما % % ومعقول عقل الكل فالله أكبر % % PageV01P765 البحر : - 1(@)(@@) % حبي الذي بين موتي والبقا خير % % والعقل مني بأنواع الجفا حير % % 2(@)(@@) % لم يكفه أن جسمي بالضنى غير % % حتى جفاني وبالأسقام لي عير % % PageV01P766 البحر : - 1(@)(@@) % هذه الآيات والسور % % ما هي الأشباح والصور % % 2(@)(@@) % لكن الألباب حائرة % % وقفت من دونها الفكر % % 3(@)(@@) % عز مطلوبي وجل فلا % % ملك يدري ولا بشر % % 4(@)(@@) % إنني بالحسن أعرفه % % وإليه الكل مفتقر % % 5(@)(@@) % بي محيط قادر وبه % % إنني في الكون أنتصر % % 6(@)(@@) % وأنا الكرسي صيغ له % % من أباطيل هي الأكر % % 7(@)(@@) % وهو مستول علي بما % % شاء لا يبقي ولا يذر % % 8(@)(@@) % عاليا فوقي أحس به % % كل ما بي شاء يشتهر % % 9(@)(@@) % غير أني دونه شبح % % غير أني تحته أثر % % 10(@)(@@) % قدر منه أنا وأنا % % لست أدري ما هو القدر % % PageV01P767 11(@)(@@) % إن أنثى النفس ولدها الروح % % وهو الصارم الذكر % % 12(@)(@@) % حيث رحمن الوجود على % % عرشنا يبدو ويستتر % % 13(@)(@@) % ظاهر بالاستواء لنا % % حيث أنا كلنا عبر % % 14(@)(@@) % إن زهدي خلقه طبعت % % فيه نفس ليس تنحصر % % 15(@)(@@) % واعترافي بالقصور ولا % % شمخة مني ولا ضرر % % PageV01P768 البحر : - 1(@)(@@) % لا تمش معه كما ترى % % وامش إليه القهقرى % % 2(@)(@@) % وإليه فاسمع تقلبون % % كما أتاك مقررا % % 3(@)(@@) % أو ما سمعت بأنه % % قد قال عنك كما ترى % % 4(@)(@@) % هذا الذي قد جاء في القرآن % % عنه بلا امترا % % 5(@)(@@) % لتراه ليس برؤية % % معهودة لك في الورى % % 6(@)(@@) % بل رؤية لا رؤية % % وجرى الحديث وما جرى % % 7(@)(@@) % إن الوجود فقط له % % لكن أبانك مظهرا % % 8(@)(@@) % فاشهده لا تشهد سواه % % وكن به كيف الكرى % % 9(@)(@@) % والكائنات 
ms160	 جميعها % % مثل الخيال إذا سرى % % 10(@)(@@) % كاللمح من بصر لمن % % قرأ الكتاب وما درى % % PageV01P769 11(@)(@@) % هو أمره والأمر قدره % % فجاء مقدرا % % 12(@)(@@) % يا مظهر الحق المبين % % انظر لربك من ورا % % 13(@)(@@) % وافهم مقالة عارف % % ودع المرا والافترا % % PageV01P770 البحر : - 1(@)(@@) % اطلب العلم بجد واجتهد % % فيه واصحب من قراه ودرى % % 2(@)(@@) % وتواضع لذوي الفضل ولا % % تصحب الجاهل واتركه ورا % % PageV01P771 البحر : - 1(@)(@@) % إن العوالم كلها موجودة % % لكن وجود الفرض والتقدير % % 2(@)(@@) % والله موجود حقيقي بلا % % شبه ولا كيف ولا تصوير % % 3(@)(@@) % وهو الذي فرض العوالم كلها % % وهو المقدر لي إليه مصيري % % 4(@)(@@) % ولأجل هذا كل شيء هالك % % والكل فان قال في التعبير % % 5(@)(@@) % وهو الذي علماؤنا يعنونه % % أهل المعارف كهف كل خبير % % 6(@)(@@) % فافهم مقالتنا وكن متحققا % % تسلم من الإنكار والتكفير % % 7(@)(@@) % أو لم تكن تفهم فإنك جاهل % % أعمى كفرت الحق غير بصير % % 8(@)(@@) % إلا إذا آمنت بالغيب الذي % % لم تدنه وقنعت بالتقصير % % 9(@)(@@) % أو لا فهيئ للجحيم أضالعا % % مملوءة بالكفر نار سعير % % PageV01P772 البحر : - 1(@)(@@) % جرد فؤادك عن الأغيار طار الطير % % في حب ليلى فلا تدخل عليها الدير % % 2(@)(@@) % هيهات لست تراها يا قليل الخير % % بالعين تلك التي تنظر بها للغير % % PageV01P773 البحر : - 1(@)(@@) % ما هذه عندنا الأجسام والصور % % وإنما هذه الآيات والسور % % 2(@)(@@) % كلام خالقنا كن أمره فيكون % % الخلق أجمعهم يا من له بصر % % 3(@)(@@) % حس فعقل فرب ليس يدركه % % حس وعقل وفيه حارت الفكر % % 4(@)(@@) % مراتب هي عين تلك واحدة % % دنياك فالبرزخ الأخرى هي العبر % % 5(@)(@@) % وقل هو الغير ثم الفصل منه له % % فالذات وانظر به يكشف لك النظر % % 6(@)(@@) % والحق حق قديم في مراتبه % % عين المراتب والفاني هو الأثر % % 7(@)(@@) % والأول الله لا ثاني له أزلا % % والآخر الله لا تبقى له أخر % % 8(@)(@@) % والظاهر الله والأغيار باطلة % % والباطن الله لا يدرى له خبر % % 9(@)(@@) % كن عارفا مثلنا بالله لا بك في % % ما قلته لك واصدق أيها البشر % % 10(@)(@@) % فإن قولي من القرآن مأخذه % % وسنة المصطفى والقهر معتبر % % PageV01P774 11(@)(@@) % فهم من الله 