ms561	 النفس بعد تحوم % لأبرد من هذا على قلبي الجمر % % 8(@)(@@) % وكم رمت صبرا إذا جفيت وما أرى % % إليه سبيلا أو يفاضحني الجهر % % 9(@)(@@) % على أن نفسي جربتها فألفيت % وليلتها دهر وساعتها شهر % % 10(@)(@@) % فصرح فتصريح الصريح شبيهه % وحاشاك ضداكالخيانة والغدر % % PageV01P2219 11(@)(@@) % وصن قدر نفس عندها عصبية % تريها بحق أن تأميلك الوفر % % 12(@)(@@) % وتقنعها بالذل وهي عزيرة % يكانفها من عزمها الصبر والنصر % % 13(@)(@@) % ولكنها منت بمنزور حظها % % لديك وهل شيء تجود به نزر % 14(@)(@@) % وطاب لها المعروف منك كأنما % % بدا فيه طعم من سجاياك أو نشر % % 15(@)(@@) % وكل غنى في ظل غيرك تافه % ولو أنني كسرى وداري اصطخر % % 16(@)(@@) % عرضت على نفسي الغنى منك تارة % ومني أخرى والغنى مني الصبر % % 17(@)(@@) % فمالت إلى نيل الغنى منكإنه % غنى خالص والصبر قدما غنى فقر % % 18(@)(@@) % وأقسم إن لم تغنني أهنأ الغنى % % لأمتطين الصبر إذ حرن الدهر % 19(@)(@@) % ألا فامتعض من قولتي لك عندها % % رويت بريقي حين أظمأني البحر % % 20(@)(@@) % ويا سوءتا للمجد والفخر بعدها % % وقد حق أن يستحسن المجد والفخر % PageV01P2220 21(@)(@@) % ويا عجبا والدهر جم عجيبه % أيسكر ماء حين لا تسكر الخمر % % 22(@)(@@) % ويا عجبا والدهر جم عجيبه % أينبت طل حين لا ينبت القطر % 23(@)(@@) % ويا عجباوالدهر جم عجيبه % أيقمر نجم حين لا يقمر البدر % 24(@)(@@) % ويا عجبا والدهر جم عجيبه % أتبهر نار حين لا يبهر الفجر % 25(@)(@@) % أأدعو لغوثي قاسما وعزيمتي % % فتغني ولا يغني ندى كفه الغمر % 26(@)(@@) % دعوت فما جاش الندى ودعوتها % % فجاش بها قلب يشيعه صبر % % 27(@)(@@) % جرى وجرت فاستهدمت وهو واقف % عجبت لهذا الأمر بل عجب الأمر % % 28(@)(@@) % ويعضدني صبري ويغفل قاسم % معاضدتي والعقر من زمني عقر % % 29(@)(@@) % وقد سار مدحي شرق أرض وغربها % % وغنى به القوم المقيمون والسفر % 30(@)(@@) % وقيل مرجي قاسم ووليه % % ونافسني في ربح صفقتي البحر % PageV01P2221 31(@)(@@) % لعمري لقدغوثت غير مقصر % ليجبر من حالي وقد أمكن الجبر % % 32(@)(@@) % وكم قائل أبلغت فيما تقوله % فقلتلقد غنيت إن ساعد الزمر % % 33(@)(@@) % أيمطر من صغرى بنانك جانبي % % وقد أمطرت 
ms562	 قوما أناملك العشر % % 34(@)(@@) % لئن كان نذرا منك ظلمك حرمتي % % ومدحي وتأميليلقد قضي النذر % % 35(@)(@@) % وإن كان ذنبا صدق ودي فإنني % % مصر وإن عافاني الصفح والغفر % % 36(@)(@@) % حنوا بني وهب علينافإنه % % على ذاك منكم يصلح الناس والعصر % % 37(@)(@@) % لقد حزر الحزار منكم لعبدكم % % وفاء وإفضالا فلا يخطىء الحزر % % 38(@)(@@) % وماأهلوا بذري لذاك وإن زكا % % ولكن لكم خيم يريع به البذر % % 39(@)(@@) % وبايع بعد الفتح قوم سبقتهم % % فلم أنا في نعماك ردفوهم صدر % % 40(@)(@@) % ولم يصف من شيء صفاء طويتي % % فلم شربهم صفو ولم مشربي كدر % % PageV01P2222 41(@)(@@) % وما جاش مد مثل مدحي فيكم % فلم كسبهم مد ولم مكسبي جزر % % 42(@)(@@) % ومالي لا أنفك أبغي مسندا % ولي مثلكم ظهر وما مثلكم ظهر % 43(@)(@@) % عفاء على الدنيا تفاحش عكسها % % فخاب بها مثليوفاز بها عمرو % % 44(@)(@@) % ألا إنها من صورة لقبيحة % من اللائي لا يرضى بها وجهك النضر % 45(@)(@@) % وما بي إلا أن يراها مميز % فيتبعها من رأيه نظر شزر % % PageV01P2223 البحر : - 1(@)(@@) % يا ابن الوزيرينلا مواربة % % قد مازج الصفو عندك الكدر % 2(@)(@@) % أليس بد من الذعاف مع الشه % د بلى والذنوب تغتفر % % 3(@)(@@) % مالي بدار الهوان مصطبر % ولا بدار الضياع مصطبر % % 4(@)(@@) % ولو كستني للسماء زينتها % % تاجا وأمضى احتكامي القدر % % 5(@)(@@) % وأنت إن شئت كان بينهما % % معدى لذي حرمة ومعتصر % 6(@)(@@) % أودى بصبري الأذى وبرح بي ال % % فقروأنت الملاذ والعصر % % 7(@)(@@) % قد رفع الله قدر مثلك بال % % قدرة يا من يطيعه القدر % % 8(@)(@@) % أن تمنح الصفو جله كدر % أو تمنح النفع جله ضرر % 9(@)(@@) % حسبي نصيرا على أخي كرم % أن ليس لي من أذاه منتصر % % 10(@)(@@) % هبني أمرأ لم يكن له خطر % ولم يزل يزدرى ويحتقر % % PageV01P2224 11(@)(@@) % جاءك مستشفعا بطولك أن % % تزهاه حتى يرى له خطر % % 12(@)(@@) % ألم يكن واجبا عليك له % % ذاك بحق إن صحح النظر % % 13(@)(@@) % بلى فما بال من له خطر % ومدحه فيك كله غرر % % 14(@)(@@) % جاءك يبغي المزيد منك فقد % % صار حديثا وعندك الخبر % % 15(@)(@@) % أضحى عدو وقد كان يحسده 
ms563	 % ودمعه رحمة له درر % % 16(@)(@@) % أظلم ليلي وأنت لي قمر % فنور الليلأيها القمر % % 17(@)(@@) % أجدب سرحي وأنت لي مطر % فزحزح الجدب أيها المطر % % 18(@)(@@) % أراب دهري وأنت لي وزر % فدافع الريبأيها الوزر % 19(@)(@@) % أخطأت قصدي وأنت لي بصر % فاركب بي القصد أيها البصر % % 20(@)(@@) % كم قائل حين جاءه خبري % % تالله ما قدرت له الخير % % PageV01P2225 21(@)(@@) % إن لا يغادر وشلوه جزر % بين سباع فقدره جزر % % PageV01P2226 البحر : - 1(@)(@@) % أمت بجود من وداد ومن شكر % وأعلم أني قد متت إلى حر % 2(@)(@@) % إلى منعم بر إلى مفضل بحر % إلى ماجد غمر إلى قمر بدر % % 3(@)(@@) % إلى معدن الآداب والعلم والحجا % % ومنتجع الآمال في البدو والحضر % % 4(@)(@@) % إلى كنف العافينأمن ذوي الحذر % % غياث من الإقتارستر من الستر % % 5(@)(@@) % إلى طيب الأعراق والسيد الذي % % أدالت يداه اليسر جودا من العسر % % 6(@)(@@) % قصدت بأسباب إليك كثيرة % ووعد قديم منك لم يقضه نكر % % 7(@)(@@) % فبادر بإنجاز لوعدك إنما % % لذي اللب من أيامه طيب الذكر % % 8(@)(@@) % وجد يا أبا إسحاق لي بعمامة % كما كان يعنى بي أخوك أبو الصقر % % 9(@)(@@) % فإنك بي أولى من الناس كلهم % % وأنت حقيق بالتلطف في أمري % % 10(@)(@@) % وإني امرؤ ليست تضيع صنيعة % لدي لجذمي بالثناء وبالنشر % % PageV01P2227 البحر : - 1(@)(@@) % أسأت فأحسن بي جهده % ولو شاء عاقبني وانتصر % 2(@)(@@) % وكان المقال له واسعا % ولكن تطول لما قدر % 3(@)(@@) % فأصبحت بالجود عبدا له % % أقر بذاك وإن كنت حر % % 4(@)(@@) % ومن كثرت نعمة عنده % عليه أقرت وإن لم يقر % % PageV01P2228 البحر : - 1(@)(@@) % فاجأ الناس خالدا وابن عشر % % قد علاه يخوض يالأير جعره % 2(@)(@@) % فرأى الناس آية من صبي % فوق شيخ له جلال وكبره % % 3(@)(@@) % طفقوا يعجبون منه فقال الش % شيخلا تنكرن لله قدره % % 4(@)(@@) % سخر الفيل وهو أعظم مني % % لضئيل الرجال يركب ظهره % % 5(@)(@@) % احذروا خالدا ولا تعذلوه % أيها الناس قد تبينت عذره % % 6(@)(@@) % هو شيخ مسخر الظهر لا ين % % فك من سخرة على إثر سخره % % 7(@)(@@) % أنا من فارس كمثلك من قح % % طان إن لم أدعك في 
ms564	 الناس شهره % % 8(@)(@@) % لست ممن لقيت قبلي أولى % % لك منيما كل سوداء تمره % PageV01P2229 البحر : - 1(@)(@@) % قل لعمار بن عما % % ر ألا تعظم قدري % % 2(@)(@@) % بحر اختك وحر والد % تك لاتعبث بشعري % % 3(@)(@@) % وأذقني فرج الزو % جة منقادا لأمري % % 4(@)(@@) % وتذكر حين تنسى % % حر عمتك وأيري % % 5(@)(@@) % حر خالتك للجي % % ران لكن لست تدري % % PageV01P2230 البحر : - 1(@)(@@) % أيامكم يابني الجراح قد جرحت % كل القلوب ففيها منكم ثار % 2(@)(@@) % ما منكم رجل تمت رياسته % إلا مشوم عظيم الكبر جبار % 3(@)(@@) % لا قدس الله بالإقبال دولتكم % فإن إقبالكم للناس إدبار % % PageV01P2231 البحر : - 1(@)(@@) % بحرمة أيري يا كنيزة إنه % لديك وجيه ذو مكان وذو قدر % 2(@)(@@) % أعضي شبا الموسى بأنفك عضة % فأنفك أولى بالختان من البظر % % 3(@)(@@) % أحلك ربي شبه أنفك عاجلا % فما شبهه شيء لدي سوى القبر % % PageV01P2232 البحر : - 1(@)(@@) % أضحى ابن شاهين للورى عجبا % بلحية لم تطل بمقدار % 2(@)(@@) % كثيفة في النبات وافرة % أوفت على طوله بأشبار % % 3(@)(@@) % لو أنها شعرة ينورها % % لم تكفها نورة بدينار % % PageV01P2233 البحر : - 1(@)(@@) % ولحية ذات أصواف وأوبار % منها يحاك أثاث البيت والدار % 2(@)(@@) % منها متاع إلى حين لصاحبها % % وللعيال وللإخوان والجار % % PageV01P2234 البحر : - 1(@)(@@) % أراني وما أحدثت بعدك سيئا % تغيرت والإبريز لا يتغير % 2(@)(@@) % فيا عجبا والدهر جم صروفه % % يفي لي إعساري وجودك يغدر % % 3(@)(@@) % وفى لي بغيض والتوى من أحبه % وللشيب أوفى والشبيبة أغدر % % PageV01P2235 البحر : - 1(@)(@@) % أحباؤنا ما كان لي عنكم صبر % وهل لصبور عن أحبته عذر % 2(@)(@@) % فيا ليت شعري عنكم كيف كنتم % وكيف التي من وجهها يطلع البدر % % 3(@)(@@) % ومن نشرها مسك وألحاظها سحر % ومبسمها در وريقتها خمر % % 4(@)(@@) % وقد زعمت ألا تزال كعهدنا % % وإن طال بي غيب وطال بها العمر % 5(@)(@@) % وإني لأخشى والزمان مغير % على النأي يوما أن يميل بها الغدر % % 6(@)(@@) % وكيف بمشتاق تضمن جسمه % على شوقه مصر ومهجته مصر % % 7(@)(@@) % أقام الحرب الزنج في دار غربة % % حوادثها في أهلها القتل والأسر % % 8(@)(@@) % ومن دونه هول ومن تحته ردى % % ومن فوقه سيف ومن تحته بحر 
ms565	 % % 9(@)(@@) % إذا شام برقا لاح من نحو أرضه % % تضايق عما ضم من وجده الصبر % % 10(@)(@@) % وبلت دما من بعد دمع رداءه % % لدى خلوات منه أجفانه الغزر % % PageV01P2236 11(@)(@@) % وإن رام من حدالبطيحة مطلعا % ثنت شأوه عنه المواصير والجسر % % 12(@)(@@) % كفى حزنا أن المقل مشرد % وذو الخفض في أحبابه من له وفر % 13(@)(@@) % إذا كان مالي لا يقوم بهمتي % % سماحا وإن أوفى على عسرتي اليسر % 14(@)(@@) % ففيم اجتهادي في محاولة الغنى % % وما للغنى عند الجواد به قدر % % 15(@)(@@) % يفوز بجمع المال من كان باخلا % وما لي إلا الحمد من ذاك والشكر % % 16(@)(@@) % وما أنا إلا محرز المجد والعلا % % وذلك كنزي لا اللجين ولا التبر % % 17(@)(@@) % فإن يقض لي الله الرجوع فإنه % % علي له أن لا أفارقكم نذر % % 18(@)(@@) % ولا أبتغي عنكم شخوصا وفرقة % يد الدهر إلا أن يفرقنا الدهر % 19(@)(@@) % فما العيش إلا قرب من أنت آلف % وما الموت إلا نأيه عنك والهجر % PageV01P2237 البحر : - 1(@)(@@) % قال الحيادعهافخالفه الهوى % % وداعي الهوى أقوى علي وأقدر % % 2(@)(@@) % حيائي في وجهي وفي قلبي الهوى % % وقلبي لا وجهي يود ويهجر % % PageV01P2238 البحر : - 1(@)(@@) % تصبرت عنك فما أصبر % وإني فيك لمستبصر % 2(@)(@@) % وإن حارب الرأي فيك الهوى % % فلا شك في أنني مقصر % % 3(@)(@@) % تصنع لرأي فإني أرا % % ه ينكر منك الذي أنكر % % 4(@)(@@) % وصانع هواي فإني أرا % % ه يغفر منك الذي أغفر % % 5(@)(@@) % وما ذاك إلا عمى في الهوى % % وأعمي الهوى مرة يبصر % % 6(@)(@@) % فناصر هواي على ضده % % فإن الهوى فيك مستنصر % 7(@)(@@) % وإلا فإني مما مضى % % منيب إلى الرأي مستغفر % % 8(@)(@@) % أيا أملي هبك لم تقض لي % % يد من يديك ألا خنصر % % PageV01P2239 البحر : - 1(@)(@@) % فعلت بنا مقل الجآذر % فعل الخناجر بالحناجر % 2(@)(@@) % ما فترت في قتلنا % % تلك المكحلة الفواتر % % 3(@)(@@) % ترمي القلوب بأسهم % يصدرن عن قسي المحاجر % % 4(@)(@@) % فكأنما قتلننا % % أبصارهن على بصائر % % PageV01P2240 البحر : - 1(@)(@@) % أفدي التي لم يعطل جيدها عوز % من الحلي ولا حلاه إعوار % 2(@)(@@) % بل الحلي عليه من تمائمه % لأنها لعيوب فيه أستار % % 3(@)(@@) % ظنوا 
ms566	 بجيد يكون الحلي عوذته % هل فوق مقداره في الأرض مقدار % PageV01P2241 البحر : - 1(@)(@@) % حليف سهاد ليله كنهاره % % يبيت شعار الهم دون شعاره % 2(@)(@@) % أصابته من ريب الزمان مصيبة % كؤود لها ما بعدها من حذاره % % 3(@)(@@) % رزية خال كان للدهر جنة % إذا الدهر أنحى مرهفات شفاره % 4(@)(@@) % وكان إذا عد الخؤول فعددت % مساعيه لم تغض الجفون لعاره % % 5(@)(@@) % ألا مات من مات الوفاء بموته % % فأعوز من يوفي بذمة جاره % % 6(@)(@@) % ألا مات من مات السماح بموته % % وكل عطاء نقده كضماره % % 7(@)(@@) % فأي قرى تقري الليالي ضيوفها % % وقد عطلت ما عطلت من عشاره % % 8(@)(@@) % فتى كان يهدي الجود قصد سبيله % % وحاشاه من أسراره وبداره % % 9(@)(@@) % فتى كان لا يطوي على الغدر كشحه % % ولا تسأم الأيام يوم فخاره % % 10(@)(@@) % فتى كان كالعذراء في ظل خدرها % % وكالأسد الرئبال في ظل داره % % PageV01P2242 11(@)(@@) % مضى قد تناهى سؤددا غير أنه % % مضى نصفا قد لاح شيب عذاره % % 12(@)(@@) % خبا قمر الدنيا لحين اتساقه % % فيا أسفا هلا لحين سراره % % 13(@)(@@) % علاه كسوف البدر عند تمامه % % ملح به حتى هوى في مغاره % % 14(@)(@@) % رزئناه يوم الأربعاء ولم تزل % % فواقر هذا الدهر يوم دباره % 15(@)(@@) % بنفسي من لم تقض بعض حقوقه % % ولم تفن أيدينا بطول اعتواره % % 16(@)(@@) % بنفسي من لم يؤذنا بأنينه % % ولم يؤذ جاري بيته بجواره % % 17(@)(@@) % حبيب دعاه مستزيرا حبيبه % فخف له مستبشرا بمزاره % % 18(@)(@@) % وقصر شكواه فكانت كأنها % % طريق أراه كيف وجه اختصاره % % 19(@)(@@) % ولم تطل البلوى عليه لعلمه % % بتسليمه فيما مضى واصطباره % % 20(@)(@@) % تبلج عند الموت وابيض وجهه % تبلج ضوء الفجر عند انفجاره % % PageV01P2243 21(@)(@@) % فشككنا في موته غير أنه % % أبان لنا في طرفه وانكساره % % 22(@)(@@) % فلو كان يدري قبره من يحله % تفرج بالترحيب قبل احتفاره % % 23(@)(@@) % أعلانعلتك الروائح صوبها % % وأنهلك الغادي روي قطاره % 24(@)(@@) % بحسبك بل حسب المريدي بالردى % % جوى حزن يصلى فؤادي بناره % % 25(@)(@@) % على أنه لا حسب لي بعدما أتت % عليه الليالي من مزيد المكاره % % 26(@)(@@) % فلا يبق مكروه علي فإنني % % لكل كريه نالني غير 
ms567	 كاره % % 27(@)(@@) % أعلان من أغشى ليؤنس وحدتي % % ويدحر عني الهم عند احتضاره % % 28(@)(@@) % أعلانمن يصغي لسمع شكيتي % % وأصغي إلى مردوده وحواره % % 29(@)(@@) % أعلانمن أفشي إليه سريرتي % % فآمن من إدلاله واغتراره % % 30(@)(@@) % ومن ذا يحامي عن ذماري غائبا % أشد محاماة امرىء عن ذماره % % PageV01P2244 31(@)(@@) % ومن ذا تظل النفس عند مغيبه % % معلقة آمالها بانتظاره % % 32(@)(@@) % نهاري لدن فارقتني لك موحش % وليلي فقيد النوم حتى انحساره % 33(@)(@@) % علي خشوع ظاهر واستكانة % % كأني أسير كانع في إساره % % 34(@)(@@) % أيسكن مسلوب سكينة ليله % % ويأنس مفجوع بأنس نهاره % % 35(@)(@@) % يقاسي زفيرا دائبا في صعوده % % يراح ودمعا دائبا في انحداره % % 36(@)(@@) % ألا تعس الدهر المفرق بيننا % % وإن كان كل عاثرا بعثاره % % 37(@)(@@) % ألح علينا مولعا بسراتنا % % كما أولع الجاني بخير ثماره % % 38(@)(@@) % أرى الدهر لا يأوي لعولة معول % ولا يرعوي للصوت عند انسماره % % 39(@)(@@) % يصول فلا يرثي لثكل كبيرة % ولا يتم طفل يا لسوء اقتداره % % 40(@)(@@) % ألا بؤس للأم التي هد ركنها % % بواحدها المخلي ع راص دياره % % PageV01P2245 41(@)(@@) % ويا بؤس للأخت الشقية بعده % من الحزن الباقي وطول استعاره % % 42(@)(@@) % ويا بؤس للطفل الصغير وشادن % تعجل بؤس اليتم قبل اتغاره % 43(@)(@@) % محمدكم قد بت ريحان صدره % % ونازعه في الليل فضل إزاره % % 44(@)(@@) % أبا قاسم كم قد فالك لبه % على فضلة من حلمه ووقاره % % 45(@)(@@) % فظل يناغيك الكلام بمنطق % رقيق الحواشي زانه بافتراره % % 46(@)(@@) % سقى الغيث ميتا خط بالدير قبره % فواراه إلا سؤددا لم يواره % % 47(@)(@@) % بأقرب دار لا أرى الدهر وجهه % فيا بعد مرآهويا قرب داره % % 48(@)(@@) % عداه البلى أن يستجيب لدعوتي % % وقد ينجد الملهوف عند اضطراره % % 49(@)(@@) % وكنت إذا استنجدته فدعوته % دعوت نصيرا نصره كانتصاره % % 50(@)(@@) % فوالله لا أنساه حتى أرى له % شبيها على أسبابه ونجاره % % PageV01P2246 51(@)(@@) % ولو أنني أيضا رأيت شبيهه % لما كان إلا مغريا بادكاره % % 52(@)(@@) % فلو كان هذا الموت قرنا أطيقه % لما فاتني أخرى الليالي بثاره % % 53(@)(@@) % ولو قبلت مني الليالي فداءه % لفاديتها من تالدي بخياره % % 54(@)(@@) % فأنى تفاديني المنايا بمثله % % وكيس المنايا كيسها 
ms568	 في اختياره % % 55(@)(@@) % ألا ليتما كنا كغاد ورائح % وكان رواحي لاحقا بابتكاره % % 56(@)(@@) % عليك سلام الله حيا وميتا % تباشرت الموتى بقرب جواره % % 57(@)(@@) % أبى لي أن أسلاك ما دمت باقيا % حلولك من قلبي مكين قراره % % PageV01P2247 البحر : - 1(@)(@@) % يا ناعي ابن رسول الله من البشر % ومعلنا باسمه في البدو والحضر % % 2(@)(@@) % لقد نعيت امرأ ظلت لمصرعه % % قواعد الدين والدنيا على خطر % % 3(@)(@@) % لقد نعيت امرأ لم تحي مكرمة % إلا بهوبه سارت إلى الحفر % % 4(@)(@@) % لقد نعيت امرأ ما كنت أحسبه % ينعاه إلا هوي الشمس والقمر % % 5(@)(@@) % لو فات شيء مدى ميقاته انكدرت % زهر النجوم . من كل منكدر % 6(@)(@@) % يا ناعي ابن رسول الله مبتهجا % لقد تفوهت بالكبرى من الكبر % % 7(@)(@@) % سمعا لها وإن سكت مسامعنا % % إن المسامع للناعين والبشر % % 8(@)(@@) % لا تشمتوا واذكروا منجى طليقكم % وجوهكم يا بني العباس للعفر % % 9(@)(@@) % إن السيوف منايا كل معتزم % يلقى المنايا بعزم غير منتشر % % 10(@)(@@) % لله همة يحيى أين وجهها % % لو أنها شيعته مدة العمر % % PageV01P2248 11(@)(@@) % بني النبيأما ينفك طاغية % مغادرا جزرا منكم على جزر % % 12(@)(@@) % بني نتيلة ثل الله عرشكم % كم للنبي لديكم من دم هدر % % 13(@)(@@) % ني نتيلةكفوا غرب جهلكم % لا يصبح السيف فيكم غير معتذر % % 14(@)(@@) % إن تفجعونا بسهم من كنانتنا % % فعندكم من ثناه أبلغ الخبر % 15(@)(@@) % أو خاننا القدر المحتوم فيه فقد % % بقاكم سمرا عفى على السمر % % 16(@)(@@) % ما زال يضربكم بالسيف عن عرض % حتى لأذعنتم بالذل والصغر % % 17(@)(@@) % أبقاكم نهزة للناس كلهم % أذلة لا عدمتم ذلة النفر % % 18(@)(@@) % وكل يوم لكم أمثال سورته % منا وسيف أبي غير مزدجر % % 19(@)(@@) % كذاك ما باخ منا بدر مملكة % إلا تلاه نظير غير منتظر % % 20(@)(@@) % نحمي حمانا بأسياف مجردة % مقيلها قلة المستأسد الأشر % % PageV01P2249 21(@)(@@) % إنا إذا صعر الجبار صفحته % شفاء صفحته من ذلك الصعر % 22(@)(@@) % بسيفنا وبنا نلتم مراتبكم % % لا بالطليق حليف العجز والخور % % 23(@)(@@) % إن السيوف التي أردت أوائلكم % % أسيافناوبها نردي ذوي البطر % % 24(@)(@@) % معدة لكم ما فل صارمها % % ونحن أبناء تلك 
ms569	 العصبة الصبر % 25(@)(@@) % جلى بنا الله تلك الجاهلية عن % % آبائكم فاستبانوا مطرح البصر % % 26(@)(@@) % وهذه جهلة طخياء ثانية % بنا تكشف بالخطية السمر % % 27(@)(@@) % لك الخمول وموت الذكر ليس لنا % % أما سمعت بنا في سائر السير % % 28(@)(@@) % لطفلنا موقف تغضى الكفاة له % % وسيفه فيهم أمضى من القدر % % 29(@)(@@) % ما ضم سيفا لنا غمد ولا برحت % % ضريبتاه من الأعداء والجزر % % 30(@)(@@) % نأوي إلى بيت مجد لا كفاء له % % أوفت به السورة العليا من السور % % PageV01P2250 31(@)(@@) % مد النبي لنا أطنابه فغدت % % معلقات العرا بالأنجم الزهر % % 32(@)(@@) % له من القابسين العلم آونة % % والمعتفين فناء غير مهتجر % % 33(@)(@@) % من زارنا فيه ألقى الله حاضره % ناهيك من حاضر فيه ومحتضر % % 34(@)(@@) % من تعتصم يده يوما بعصمتنا % % يمسك بحبل متين غير ذي غرر % 35(@)(@@) % لنا الشفاعة والحوض الروي لنا % % ونحن من خص بالتقديس والطهر % % 36(@)(@@) % يا يوم يحيى لقد أحييت داهية % دهياء للناس تبقى آخر العصر % % 37(@)(@@) % لقد أنخت على الأحياء من يمن % ومن ربيعةوالأحياء من مضر % % 38(@)(@@) % وعم فقدك أهل الأرض كلهم % لم يبق ذا نفس منهم ولم يذر % % 39(@)(@@) % إلا أناسا فساد الناس يصلحهم % % مثل الكلاب حياها ممسك المطر % % 40(@)(@@) % تالله لو أن مولاه أقيد به % % هذا الأنام لأمسى غير مثئر % PageV01P2251 41(@)(@@) % أيا قتيل رسول الله في رجب % % يا أكرم الناس مخبورا لمختبر % % 42(@)(@@) % ما خانك السيف إذ خانتك نصرته % وفيه منتصر يوما لمنتصر % 43(@)(@@) % لئن تحكمت الأعداء فيك لقد % % حكمت فيهم ظبا الهندية البتر % 44(@)(@@) % قلقلت جبارهم عن لعين مضجعه % % رعبا ووكلته بالخوف والحذر % % 45(@)(@@) % أولغت في مهج الأعداء مرهفة % من كل أزرق نظار بلا نظر % % 46(@)(@@) % يا قاتل ابن علي وابن فاطمة % تبا لسعيك في الإيراد والصدر % % 47(@)(@@) % يا قاتل ابن علي إن قتلكه % سيجني لك مرا من الثمر % % 48(@)(@@) % بأي وجه تلاقي الله معتذرا % جلت خطيئتك العظمى عن العذر % % 49(@)(@@) % خصيمك الله فانظر كيف تخصمه % بل أنت أدحض خصم فوك للحجر % % 50(@)(@@) % لو شاركتك بنو حواء في دمه % % لكبكبوا يا بن بنت 
ms570	 النار في سقر % % PageV01P2252 51(@)(@@) % ما بعدكم من يزيد في عداوته % % آل النبي وقتل السادة الغرر % % 52(@)(@@) % عليكم لعنة الرحمن واقعة % % في السر والجهر والآصال والبكر % % 53(@)(@@) % ومن سرى نحوه أو من أشار به % % ومن نوى ذاك من أنثى ومن ذكر % % 54(@)(@@) % ومن رآه فلم يسمح بمهجته % % ومن تخلف عنه غير مقتسر % 55(@)(@@) % خسرا لقوم أقاموا دينهم سفها % فيمن يزيد بوكس البيع محتقر % % 56(@)(@@) % وبارزوا الله في قربى النبي ولم % % يرعوا له حرمة القربى ولا الإصر % % 57(@)(@@) % بروا ذليلاوعقوا الله واعتصموا % % منه بحبل ضعيف واهن المرر % % 58(@)(@@) % سرى إليه عداة الله فانصلتوا % % مستأسدين عليهم جلدة النمر % % 59(@)(@@) % مجاهدين بأسياف مجردة % كأنما قصدوا للروم والخزر % 60(@)(@@) % يا عصبة الشركما أعلى جدودكم % لقد ظفرتم برب النصر والظفر % % PageV01P2253 61(@)(@@) % لقد ظفرتم بمن ما هز منصله % إلا تحكم في الهامات والقصر % % 62(@)(@@) % لقد ظفرتم بمن كانت أنامله % تقوم فينا مقام الرزق في البشر % % 63(@)(@@) % مهذب من رسول الله نسبته % بين الوصي وسبطيه إلى عمر % % 64(@)(@@) % لهفي على خير ميت بعد والده % % وخير منتسب يوما ومفتخر % % 65(@)(@@) % إني لأعذل نفسي في الحياة وقد % % قام النعي به جذلان ذا أشر % % 66(@)(@@) % لأفنين أفانين المديح له % % مجاهرا للأعادي غير مستتر % % 67(@)(@@) % وأمنح الود أهل البيت إنهم % خير البرية لا بل خيرة الخير % % 68(@)(@@) % يا ليتني كنت فيمن كان شاهده % حيا وقفيت إذ قفى على الأثر % % PageV01P2254 البحر : - 1(@)(@@) % أعيني جودا بالدموع لفقدها % % فما بعدها ذخر من الدمع مذخور % 2(@)(@@) % نصيبكما منها الذي فات فابكيا % % فأما نصيب القلب منها فموفور % % PageV01P2255 البحر : - 1(@)(@@) % سقيا لأيام خلت إذ لم أقل % % سقيا لأيام خلت وعصور % 2(@)(@@) % أيام يرعاني الشباب ممتعا % في روضة من لهوه وغدير % % 3(@)(@@) % مستقبلا أوطاره لم أنصرف % % عن وجه مأمول إلى محذور % % PageV01P2256 البحر : - 1(@)(@@) % تطلع أيري من مئزري % % وكل كمين له ثوره % 2(@)(@@) % فقال لي الجلساءاستتر % % وصاروا وجوهم صوره % % 3(@)(@@) % فقلتوهو العضو لو فاتني % % عدمت البسالة والسوره % % 4(@)(@@) % وكيف تعدونه عورة % ولولاه أصبحتم عوره % % PageV01P2257 البحر : - 1(@)(@@) % ألا أيهذا الشيب سمعا 
ms571	 وطاعة % فأنت المناوي ما علمت المظفر % 2(@)(@@) % أبى الخطر والحناء حربك إنه % بدا لهما لا شك أن سوف تظهر % % 3(@)(@@) % إذا كنت تمحو صبغة الله قادرا % فأنت على ما يصبغ الناس أقدر % % PageV01P2258 البحر : - 1(@)(@@) % لذوي الجدال إذا غدوا لجدالهم % % حجج تضل عن الهدى وتجور % 2(@)(@@) % وهن كآنية الزجاج تصادمت % فهوت وكل كاسر مكسور % % 3(@)(@@) % فالقاتل المقتول ثم لضعفه % % ولوهيهوالآسر المأسور % % PageV01P2259 البحر : - 1(@)(@@) % خذ نصيبا من عيشك المستعار % قبل ليل مصرف ونهار % 2(@)(@@) % فكأن قد سفت عليك السوافي % % في بطون الملمعات القفار % % 3(@)(@@) % ليت شعريوأين إذ ذاك شعري % % كيف يعفو البلى على آثاري % % 4(@)(@@) % ليت شعريهل توجف الكأس بعدي % % بحداء اللحون والأوتار % % 5(@)(@@) % ليت شعريهل تلبس الأرض بعدي % % حبرات الربيع ذي النوار % % 6(@)(@@) % أو تهب الشمال عندي بليل % فتميس الغصون بالأسحار % % 7(@)(@@) % در در الصبا ودر مغاني ال % % لهو لو أنها ديار قرار % % 8(@)(@@) % يا قصار الأيام متعت لو كن % % ت قصارا موصولة بقصار % % PageV01P2260 البحر : - 1(@)(@@) % ويوم كأن النوم يغتال طوله % بأمثاله يطوى الزمان فيقصرص تقسمه صحو ودجن فشمسه % % 2(@)(@@) % تبرج أحيانا وحينا تحقر % % تجدده في العين حالان خلفه % 3(@)(@@) % يخيلان أن الروض يطوى وينشر % % قرنت به خضراء بيتها الندى % % 4(@)(@@) % فأصبح في أفنانها يتمرمر % % إذا معجت فيه الشمال رأيتها % % 5(@)(@@) % كأن عليها لؤلؤا يتحدر % % ترى فوقها منه غيابة خضرة % 6(@)(@@) % فما مسها من رفرف الجو أخضر % تخايل في حمر وصفر كأنها % % 7(@)(@@) % زرابي وشي نمنمتهن عبقر % % مراد لمرتاد السرور ومرتع % % 8(@)(@@) % به مسمع للسامعين ومنظر % % ن % PageV01P2261 البحر : - 1(@)(@@) % ألا فاسقني خمرا بصفو سلافة % بماء سماءحبذا الخمر بالقطر % 2(@)(@@) % شرابان حلا طائعين كلاهما % % ولم يأتيا كرها بعصر ولا حفر % % PageV01P2262 البحر : - 1(@)(@@) % وزعفرانية في اللون تحسبها % % إذا تأملتها في ثوب كافور % 2(@)(@@) % إذا تناولها من كان يألفها % % في يوم دجن كثير الطل والنور % % 3(@)(@@) % كأن حب سقيط الطل بينهما % % دمع تحير في أجفان مهجور % % PageV01P2263 البحر : - 1(@)(@@) % تعالوا إلى من عذبت طول ليلها % % بأضيق من حبس وطيس يسعر % 2(@)(@@) % وقد جلدوها الحد وهي 
ms572	 بريئة % فحي على دفن الشهيدة تؤجروا % % PageV01P2264 البحر : - 1(@)(@@) % قد قرن المشتري إلى البدر % % ووافق السؤل ليلة القدر % 2(@)(@@) % ضم إلى خير والد ولد % حل محل الفؤاد في الصدر % % 3(@)(@@) % سيدة في الزمان أهدت إلى الس % سيد أنسا لسيد غمر % % 4(@)(@@) % أمتعه أفضل المتاع به % % معطيه إياه آخر الدهر % % PageV01P2265 البحر : - 1(@)(@@) % منظر فاتنوتحجب عنا % % بين أثناء درعها محبورا % % 2(@)(@@) % لعبة عدلت فدقت وجلت % % وإذا ما لمستها فحريرا % % 3(@)(@@) % قدر الله حسنها فتناهى % % ويد الله تحسن التقديرا % % 4(@)(@@) % ما رآها امرؤ به طائف ال % % هم إلا انكفا بها مسرورا % % 5(@)(@@) % وإخال الضرير لو قابلته % عاد من نورها الضرير بصيرا % % PageV01P2266 البحر : - 1(@)(@@) % عبثت به الحمى فورد جسمه % وعك الحمى وتلهب المحرور % 2(@)(@@) % وبدا به الجدري فهو كلؤلؤ % فوق العقيق منضد مسطور % % 3(@)(@@) % ونضاه بنثره فجاء كعصفر % قد رش رشا في بياض حرير % % 4(@)(@@) % الآن صرت البدر إذ حاكى لنا % % كلف البدور مواضع التجدير % 5(@)(@@) % فكخمرة رشت على تفاحة % % أثر يلوح بخدك المجدور % % 6(@)(@@) % فكأنه ورق المصاحف زانه % نقط وشكل في خلال عشور % % PageV01P2267 البحر : - 1(@)(@@) % لقوله نحن قسم % نا بينهم زال المرا % % 2(@)(@@) % ولو تولى غيره % قسمة أرزاق الورى % % 3(@)(@@) % جرت خطوب بيننا % % لكننا تحت العرا % % PageV01P2268 البحر : - 1(@)(@@) % في زخرف القول ترجيح لقائله % والحق قد يعتريه بعض تغيير % 2(@)(@@) % تقولهذا مجاج النحل تمدحه % وإن تعب قلتذا قيء الزنابير % % 3(@)(@@) % مدحا وذما وما جاوزت وصفهما % % سحر البيان يري الظلماء كالنور % % PageV01P2269 البحر : - 1(@)(@@) % كم ظهر ميت مقفر جاوزته % فحللت ربعا منك ليس بمقفر % 2(@)(@@) % جود كجود السيل إلا أن ذا % % كدر وأن نداك غير مكدر % % 3(@)(@@) % الفطر والأضحى قد انسلخا ولي % % أمل ببابك صائم لم يفطر % % 4(@)(@@) % عام ولم ينتج نداكوإنما % % تتوقع الحبلى لتسعة أشهر % 5(@)(@@) % جد لي ببحر واحد أغرقك في % % بحر أحيس به بسبعة أبحر % % PageV01P2270 البحر : - 1(@)(@@) % أما تراه ومر الريح يعطفه % % كأنه زعفران فوق كافور % 2(@)(@@) % إذا بدا في اختلاف من محاسنه % % أراك كيف اختلاط النار بالنور % % PageV01P2271 البحر : - 1(@)(@@) % يحول الحول في الوصل 
ms573	 % % ويبقى لي تذكاره % 2(@)(@@) % ويوم الهجر والبين % % كيوم كان مقداره % % PageV01P2272 البحر : - 1(@)(@@) % حرمان ذي أدب وحظوة جاهل % أمران بينهما العقول تحير % 2(@)(@@) % كم ذا التفكر في الزمان وإنما % % تزداد فيه عمى إذا تتفكر % % 3(@)(@@) % الأرذلون بغبطة وسعادة % والأمجدون قلوبهم تتفطر % % PageV01P2273 البحر : - 1(@)(@@) % أتود أنك تجتني ثمر العلا % % عفوا وأنك في طباع الجوهري % % 2(@)(@@) % أو كالذي فسدت قعيدة بيته % % فأحال يضرب ظهر طير أبتر % % 3(@)(@@) % لا والذي جعل البيان مقسما % بين الورى وأجل حظ البحتري % % 4(@)(@@) % ما ود ذا ذو مرة ولو انه % % نالت يداه عطاردا والمشتري % % PageV01P2274 البحر : - 1(@)(@@) % أخشى عليك اتقاد الفكر لا حذرا % % PageV01P2275 البحر : - 1(@)(@@) % يهش لذكراك العدووإنه % % ليضمر في الأحشاء نارا تسعر % PageV01P2276 البحر : - 1(@)(@@) % جمعن العلا بالجود بعد افتراقها % % إلينا كما الأيام يجمعها الشهر % PageV01P2277 البحر : - 1(@)(@@) % ومن يك رهنا لليال ومرها % % تدعه كليل القلب والسمع والبصر % PageV01P2278 البحر : - 1(@)(@@) % عيب الأناة وإن كانت مباركة % % أن لا خلودوأن ليس الفتى الحجر % PageV01P2279 البحر : - 1(@)(@@) % أرى رجالا قد خولوا نعما % % في خفة الحلم كالعصافير % 2(@)(@@) % تبارك الله كيف يرزقهم % % لكنه رازق الخنازير % % PageV01P2280 البحر : - 1(@)(@@) % يا أيها السائلي لأخبره % عنيلم لا أزال معتجرا % % 2(@)(@@) % أستر شيئا لو كان يمكنني % % تعريفه السائلين ما سترا % % PageV01P2281 البحر : - 1(@)(@@) % وسائلة عن الحسن بن وهب % وعما فيه من كرم وخير % 2(@)(@@) % فقلتهو المهذب غير أني % % أراه كثير إرخاء الستور % % 3(@)(@@) % وأكثر ما يغنيه فتاه % حسين حين يخلو بالسرير % 4(@)(@@) % لولا الريح أسمع من بحجر % صليل البيض تقرع بالذكور % % PageV01P2282 البحر : - 1(@)(@@) % إذا أبو قاسم جادت لنا يده % لم يحمد الأجودانالبحر والمطر % 2(@)(@@) % ولو أضاءت لنا أنوار غرته % % تضاءل النيرانالشمس والقمر % % 3(@)(@@) % وإن مضى رأيه أو حد عزمته % تأخر الماضيانالسيف والقدر % % 4(@)(@@) % من لم يبت حذرا من خوف سطوته % % لم يدر ما المزعجانالخوف والحذر % % 5(@)(@@) % كأنه وزمام الدهر في يده % % يرى عواقب ما يأتي وما يذر % % PageV01P2283 البحر : - 1(@)(@@) % إذا وصفت ما فوق مجرى وشاحها % % غلائلها ردت شهادتها الأزر % PageV01P2284 البحر : - 1(@)(@@) % وشربت كأس مدامة من كفها % % مقرونة بمدامة من ثغرها % % 2 
ms574	(@)(@@) % وتمايلت فضحكت من أردافها % % عجبا ولكني بكيت لخصرها % % PageV01P2285 البحر : - 1(@)(@@) % تغرق بالكيزان ناعورة % حنينها كالبربط الناعر % 2(@)(@@) % فتارة تحسبها قينة % تردد اللحن على الزامر % % 3(@)(@@) % كأنما كيزانها أنجم % % دائرة في فلك دائر % % PageV01P2286 البحر : - 1(@)(@@) % وناعورة شبهتها حين ألبست % % من الشمس ثوبا فوق أثوابها الخضر % 2(@)(@@) % بطاووس بستان يدور وينجلي % % وينفض عن أرياشه بلل القطر % % PageV01P2287 البحر : - 1(@)(@@) % نسيم الصبا حيا الندامى من الزهر % براح الندى صرفا فمالوا من السكر % 2(@)(@@) % تنقش كف الغصن في الروض عندما % % تجلت عروس الراح في الحلل الخضر % 3(@)(@@) % وفي الروض أمسى الجلنار كأنه % % مباخر تبر عودها طيب النشر % % 4(@)(@@) % وحاكى السما لما صفا ماء جدول % وفيه خيال الزهر كالأنجم الزهر % % 5(@)(@@) % تراقصت الأشجار والريح قد غدا % % يشبب لما صفق الماء في النهر % % 6(@)(@@) % وأمسى المسا والغيم للبدر حاجب % % وإشراق شمس الراح يغني عن البدر % % 7(@)(@@) % عروس بدت من دنها وهي تنجلي % % كما تنجلي بكر الزفاف من الخدر % % 8(@)(@@) % توقد في الكاسات نور شعاعها % % ومن عجب ماء توقد كالجمر % % 9(@)(@@) % يطوف بها ساق كحيل عيونه % % تناجي كليم الشوق بالغنج والسحر % % 10(@)(@@) % غزال رمت بالنبل أهداب جفنه % % وكم صادت الآساد بالشرك الشعر % % PageV01P2288 11(@)(@@) % إذا ما بدا كالصبح فرق جبينه % % دعوت على عين العواذل بالفجر % % PageV01P2289 البحر : - 1(@)(@@) % لقبها معشر مغنية % كعقرب الحسن لقبت تمره % 2(@)(@@) % تجذر فلسا على الغناء ولا % % تسكت إلا وجذرها بدره % % PageV01P2290 البحر : - 1(@)(@@) % يسمو إلى المجد أقوام فتلهزهم % % أركانهوابن يحيى غير ملهوز % 2(@)(@@) % فتى يرى ماله كالداء يحسمه % ولا يراه كعضو منه محروز % % 3(@)(@@) % يهتز للمجد من تلقاء شيمته % % والحر يهتز عفوا غير مهزوز % % 4(@)(@@) % معذل لا يفيق الدهر عاذله % وليس في قرن غاو بملزوز % % 5(@)(@@) % خلى إليه سبيل العذل نائله % والذم عنه قصي جد محجوز % % 6(@)(@@) % يلقى العفاة بترحيب إذا انصرفوا % % عن غيره بين مدفوع وموكوز % % 7(@)(@@) % لا مقبل منهم يشكو تجهمه % ولا مول إذا ولى بملموز % % 8(@)(@@) % يعدي على ماله والعز حاضره % فيستباح عزيزا غير معزوز % % 9(@)(@@) % وما يصانع عن عود به خور % هيهات 
ms575	 ذلك عود غير مغموز % % 10(@)(@@) % بل فيه خيم على الخيرات يحفزه % ناهيك من حافز في خير محفوز % PageV01P2291 11(@)(@@) % حوى من المجد كنزا لم يكن أحد % % يحويه إلا بمال غير مكنوز % % 12(@)(@@) % لو كان جز النواصي دهر أنعمه % % في الناس لم تلق منها غير مجزوز % 13(@)(@@) % ماذا ترى في اصطناعي يا أبا حسن % فكم سبقت بمثلي غير منحوز % % 14(@)(@@) % إن تولني يا ابن يحيى منك عارفة % لا تقرها في سقاء غير مخروز % % 15(@)(@@) % وليس سيفي بمغمود إذا التمست % يداك نصريولا رمحي بمركوز % % 16(@)(@@) % بل حاضر النصر من ذي مضرب خذم % وذي سنان طرير الحد مجلوز % % 17(@)(@@) % أقريهما كل من عاداك لا حرجا % من قتلهم بين مضروب وموخوز % % 18(@)(@@) % بل موتغا فيك ديني أو تبشرني % % بشرى سميك كانت لابن جرموز % % 19(@)(@@) % إذ لا أعدهم مما أحرمه % بل كالأضاحي من ضأن وأمعوز % % 20(@)(@@) % هوى أبادي به لا مضمرا لهوى % % موكى عليه حذار الناسمرموز % % PageV01P2292 21(@)(@@) % خذها أبا حسن لا زلت مبتكرا % باكورة مثلهافي ألف نيروز % 22(@)(@@) % حتى تنال بك الأيام كل مدى % مقصر عن تعاطيه ومعجوز % 23(@)(@@) % في ظل عيش مقيم لا زوال له % وفي رداء شباب غير مبزوز % 24(@)(@@) % ألحمت ما كنت تسدي من سدى وندى % % فاشرب على حسنه بالجام والكوز % 25(@)(@@) % من قهوة شرة الشبان شرتها % % وعهدها عهد سابور وفيروز % % 26(@)(@@) % لم تحل جدا ولم تحمض مذاقتها % % بل ذات طعم من الطعمين ممزوز % % PageV01P2293 البحر : - 1(@)(@@) % كنت عند الأمير عيسى بن ها % % رون وفهم وذاك في تموز % 2(@)(@@) % وتراها من الودا % % ق على العود راهزه % % 2(@)(@@) % فتغنت فهزني القر حتى المنسرح من ظن أن البغاء يخطئ منواجر فاعدده أعجز العجزه تالله ينجو من البغاء فتىمرت على باب دبره الخرزهمجزوء الرملقينة عند خالدتترك الروح تارزهقبحها سترة لهافهي للشرب بارزة حين لا يغمزونهابل هي الدهر غامز % خلت أني في وسط برد العجوز % % 2(@)(@@) % من ظن أن البغاء يخطئ من % % واجر فاعدده أعجز العجزه % 2(@)(@@) % تالله ينجو من البغاء فتى % مرت على باب دبره الخرزه % % 2 
ms576	(@)(@@) % مجزوء الرملقينة عند خالد % % تترك الروح تارزه % 2(@)(@@) % قبحها سترة لها % % فهي للشرب بارزة % % 2(@)(@@) % حين لا يغمزونها % % بل هي الدهر غامزه % 2(@)(@@) % ليس للقوم نحوها % % نظرة غير طانزه % % 2(@)(@@) % فهي تحتال للزنا % % ء واحتيال الجرابزة % % PageV01P2294 2(@)(@@) % أولجتها في كعثب الخبازه % % فأفضأت إلى استها حجازه % % 2(@)(@@) % ذات صوت كأنه % صوت بعض الجلاوزه % % 2(@)(@@) % إن عينا تغيب عن % % ها وعنه لفائزه % % 2(@)(@@) % قلت لما ترنمت % % سكتة منك جائزه % % 2(@)(@@) % قاتل الله بردها % % والحتوف المناجزه % % 2(@)(@@) % الرجزوفيشى ترضي أكف الرازه % فطحاء تشفي لاعج الحزازه % % 2(@)(@@) % أقعت على مثل عمود الفازة % % صدق القناة محصف الجلازه % % 2(@)(@@) % ينغض مثل الحية النكاره % % تقل مثل الألف باهتزازه % % 2(@)(@@) % إذا تلقاه حجاب جازه % % مثل سنان اللدنة الهزهازة % % 2(@)(@@) % كفها طول دهرها % % قفل أير محاجزه % % PageV01P2295 البحر : - 1(@)(@@) % خذ العفو واصفح عن أخ بعض عيبه % % إذا ما بدا وارفق بمن أنت غامز % 2(@)(@@) % فإن هو أدى بعض حقك فارضه % % فليس بمغبون أخ متجاوز % % 3(@)(@@) % ولا تحتقر للدهر كنزا تعده % فقد يكنز المتزور للدهر كانز % % 4(@)(@@) % صالح للفتى إذا اشتاق في الصي % % ف إلى لبس فاخرات الخزوز % % 4(@)(@@) % لا كأقوام حماهم % % حظهم ضعف النحائز % 4(@)(@@) % ودع النسك لقوم % إنما الناسك عاجز % % 4(@)(@@) % جرد الجردان باللي % % ل وضح هل من مبارز % % 4(@)(@@) % فإذا صادفت طيزا % فدع الجبن وناجز % % 4(@)(@@) % لا تقف وقفة فسل % للذاذات محاجز % % 4(@)(@@) % وهي بدر الدجى أمالك عنها % % شغل في قراحك المنزوز % % PageV01P2296 4(@)(@@) % زمهرير غناؤها يدع ال % % محرور في مثل حالة المكروز % 4(@)(@@) % لا تصادف لين الصو % % فأنت اليوم ماعز % % 4(@)(@@) % كم مشوق إلى الشتاء دعاها % % فأرته كانون في تموز % 4(@)(@@) % لا سقاك الإله غيثا ولا أر % % واك إلا من ريقها الممزوز % % 4(@)(@@) % قد وصفنا التي هويت بحق % بارز للعيون كل بروز % % 4(@)(@@) % الخفيفقل لنا يا سلامة بن سعيد % % اي شيء عشقته من كنوز % 4(@)(@@) % فالتمس ما جار في ال % % عقل ودع ما ليس جائز % % 4(@)(@@) % ماالغواني وما يقربه الفح % % ل بحرف التأود المهموز % % 4(@)(@@) % فاترك التقفيع لل 
ms577	 % % أغمار والحق بالكرارز % % 4(@)(@@) % ليس في هذا ولا % % هاتيك من حظ لحائز % % PageV01P2297 4(@)(@@) % وكذا الفلسفة ال % % أولى فكانت طنز طانز % % 4(@)(@@) % قد غمزت الدين قدما % فانثنى رخو المغامز % % 4(@)(@@) % وانتهز ما تشتهيه % % إنما العيش مناهز % 4(@)(@@) % يا أبا يحيى تمتع % واله عن قطع المفاوز % % 4(@)(@@) % من دبيب أنت مض % % روب له طورا وراهز % % 4(@)(@@) % تقطع الليل ومن % % تأوي إليه في هزاهز % 4(@)(@@) % قد فحصنا فوجدنا % % ك ركوبا للجنائز % % 4(@)(@@) % لا تسقرط يا أبا يح % % يى أخانيك العجائز % 4(@)(@@) % طلبت فأعياك الكريم غرائزامجزوء الرمللا تسقرط يا أبا يحيى أخانيك العجائز قد فحصنا فوجدناك ركوبا للجنائزتقطع الليل ومنتأوي إليه في هزاهز من دبيب أنت مضروب له طورا وراهز يا أبا يحيى تمتعواله عن قطع المفاوز وانتهز ما تشتهيهإنما العيش مناهز ق % % وأي سليم حين تبلى الغرائز % % 4(@)(@@) % واعتمد من كل شي % % ء كل ما يحيي الغرائز % % PageV01P2298 4(@)(@@) % بل اذاقتك ما كرهت من الصغ % % ر ونامت في صوفك المجزوز % % 4(@)(@@) % من محوز إلى مبر عليه % % ومناخ عليه غير محوز % % 4(@)(@@) % ضمنت كل مسمهر له وق % % ع كوقع المحدرج المجلوز % % 4(@)(@@) % هاكها مصمئلة من عرته % بات منها بليلة المنكوز % % 4(@)(@@) % ابغث الكياد تلقى القوافي % % كملاقي الجيوش في كالوز % % 4(@)(@@) % حلقت لحية عليك ودست % % أقبح الدس في استك الضيعوز % % 4(@)(@@) % غامز ليس من يديه ولا رج % % ليه بل من حتاره المحزوز % % 4(@)(@@) % ذاك ذو أبنة وذاك دعي % فاله عن ذكر غامز مغموز % % 4(@)(@@) % لا تخف ان تبز سربال خزي % أنت فيه فلست بالمبزوز % % 4(@)(@@) % يا أبا شيبة المشوب أخا الدع % % وة ذا الفقحة السروط الحروز % % PageV01P2299 4(@)(@@) % كيف تستطيع أن تحوز قحابا % بعد ذاك الحريم غير المحوز % % 4(@)(@@) % ناكها ثم قال عل ولديها % % ذاك حكم العزيز في المعزوز % % 4(@)(@@) % يا لها من طريفة تتهادى % % أبدا في طرائف النيروز % % 4(@)(@@) % واعتدد أننا كذبنا عليها % % هي شمس في يوم هرمزرور % % 4(@)(@@) % تحت ذي ميعة ينب عليها % % كنبيت التيوس في الأمعوز % % 4(@)(@@) % نتيجته خواطر من طباع % % غير مستكره ولا 
ms578	 منحوز % % 4(@)(@@) % وغدت ناشزا عليك وما را % % حت على بعلها بذات نشور % % 4(@)(@@) % جمحت جمحة فما زلت منها % % ومن الصيرفي في شبروز % % 4(@)(@@) % ولدي قحبة كستك قرونا % ل من حملها قفا ملموز % % 4(@)(@@) % جئت بالدر في عيالة نغلي % % ن وليسا للشيخ بل للعجوز % % PageV01P2300 4(@)(@@) % أطرب القوم ليس عودك بل % % جودك طوعا بخبزك المخبوز % % 4(@)(@@) % وإذا ما سطا غناؤك للشر % % ب وهموا من برده بالتروز % % 4(@)(@@) % وتغنى كأن صوتك من أن % % فك صوت الزنبور في جوف كوز % % 4(@)(@@) % فيك شوب من الجفاء مع الخن % % ث كأن قد قدمت من ترعوز % % 4(@)(@@) % ليس تنفيك هزة تتمشى % % في مثانيك من غلام رهوز % % 4(@)(@@) % أنت جيش مثقل غير مهتز % ولكن ما شئت من مهزوز % % 4(@)(@@) % فاترك الغانيات واعمر دباها % % بخليطين من نبيط وجوز % % 4(@)(@@) % فشهدت الوغى برمح طريح % % غير مستعمل ولا مركوز % % 4(@)(@@) % كم تخليت بالحسان وجوها % خلوات المباح لا المحجوز % % 4(@)(@@) % وهي تفديه منك بالنفس وال % % مال على رغم انفك المحزوز % % PageV01P2301 البحر : - 1(@)(@@) % تمليت في النيروز عيش المنورز % وعمرت إعمار السعيد المعزز % 2(@)(@@) % ولا زلت سباقا إلى كل غاية % من الجود والإفضال سبق المبرز % % 3(@)(@@) % وأعلاك من أعطاك مجدا وسؤددا % على كل علج ظاهر البغي منبز % % 4(@)(@@) % وذلت لك الأعداء ذلا ترى له % % لذكراك غيظا ظاهرات التميز % % 5(@)(@@) % هدية ذي ذخر جزيل موفر % ومال قليل عن هداياه معوز % % 6(@)(@@) % يرى بك أسباب الغنى مستتبة % ويأوي إلى ضنك من العيش مجهز % % 7(@)(@@) % له حاجة قد حال دون لقائها % % عوائق موصول من المطل مبرز % % 8(@)(@@) % ولليأس خير في الأمور مغبة % وأروح من وعد امرىء غير منجز % % 9(@)(@@) % وإني لذو شكر وإن لم أفز به % % لديك وضيق عن تأتيك معجز % % 10(@)(@@) % فلا ترضين في محرز بدنية % فلست بمعتاض وليا بمحرز % % PageV01P2302 البحر : - 1(@)(@@) % المرء يعجز لا المحالة تعجز % % والقول يعوز لا فعالك تعوز % 2(@)(@@) % فليوجز الشعراء فيك لعلهم % % إن قصروا قال المشبهأوجزوا % % PageV01P2303 البحر : - 1(@)(@@) % مديحك من تعتفي فضله % % هجاء ولكنه ملغز % 2(@)(@@) % ومن رام بالشعر رفد امرىء 
ms579	 % ففي جوده عنده مغمز % % PageV01P2304 البحر : - 1(@)(@@) % خير ما استعصمت به الكف عضب % % ذكر حدهأنيث المهز % 2(@)(@@) % ما تأملته بعينك إلا % أرعدت صفحتاه من غير هز % % 3(@)(@@) % مثله أفزع الشجاع إلى الدر % % عفغالى بها على كل بز % 4(@)(@@) % ما تبالي أصممت شفرتاه % في محز أم جارتا عن محز % PageV01P2305 البحر : - 1(@)(@@) % ما طلت باللهو والأيام تنتجز % فنل من اللهو حظا قبل تحتجز % 2(@)(@@) % لا تتركن بين طوري لذة خللا % إن الشباب وأيام الصبا نهز % % 3(@)(@@) % وقل مجيبا صه للقائلاتمه % وليلقك العذل صلبا حين تغتمز % % 4(@)(@@) % هانت على عاذلاتي حسرة صعدا % كأنما بفؤادي عندها علز % % 5(@)(@@) % إذا نضوت شبابي واعتديت غدا % والعمر لي نشب والشيب لي نبز % 6(@)(@@) % يا عاذلي احبوا غيري بنصحكما % % يصخ لما تلغوان الممسك اللحز % % 7(@)(@@) % ما بعد بيضاء أو صهباء صافية % فرع يرب ولا صفراء تكتنز % % 8(@)(@@) % ليأخذن بسمعي دون لغوكما % % حسن المزاهر والأهزاج والهزز % % 9(@)(@@) % أنبئت أنك يا يعقوب مبترك % تقصد الشعر في سبي وترتجز % % 10(@)(@@) % نظارأمطرك ودقا لا يراش به % % عاري الغصونولا تحيا به الجرز % % PageV01P2306 11(@)(@@) % قصائد مقصدات من أصيب بها % % وإن رجزت أتاك الرجز لا الرجز % % 12(@)(@@) % من كل هتر إذا غنى الرواة بها % % أصحى لها شعراء الناس قد ضمزوا % % 13(@)(@@) % يباشر الجلد دون العرض ميسمها % % وتلزم المرء ما لا تلزم النبز % 14(@)(@@) % تأتيك آبدة منها فآبدة % تتابع الموج خلف الموج تحتفز % 15(@)(@@) % وعندي الطول المرخى أعنتها % % من القصائد والسيارة الوجز % % 16(@)(@@) % تالله ما بلساني حين أشتمكم % % عي ولا بي عن سوآتكم عوز % % 17(@)(@@) % إني ليمكنني قول يحققه % نساؤك الفتيات الخور العجز % % 18(@)(@@) % تالله لولا نساء أنت قيمها % % عف الزناة وطابت منهم الحجز % % 19(@)(@@) % فتقاء يذهب فيها الفيل منزلقا % يكاد يسبق منه صدره العجز % 20(@)(@@) % لم تذكر الأير إلا مت كعثبها % % واعتادها شرق بالريق أو جأز % % PageV01P2307 البحر : - 1(@)(@@) % وتال تلا يوما فأنسي آية % فأعيت عليه حين رام انتهازها % % 2(@)(@@) % بكر على ما قبلها متدبرا % % فثاب له ذكر فأمضى مجازها % % 3(@)(@@) % فشبهته بابن السبيل تعرضت % له وهدة 
ms580	 فاستصعبت حين رازها % % 4(@)(@@) % تقهقر عنها قيس عشرين خطوة % وجاش إليها جيشة فأجازها % % PageV01P2308 البحر : - 1(@)(@@) % وحديثها السحر الحلال لو أنها % % لم تجن قتل المسلم المتحرز % 2(@)(@@) % شرك النفوس وفتنة ما مثلها % % للمطمئنوعقلة المستوفز % % 3(@)(@@) % من فتى كلما بلوت من الفت % % يان غسا ألفيته غير غس % % 3(@)(@@) % يا أخي يا أبا الحسين وإلفي % % هاكها حكمة قس % % 3(@)(@@) % وأرى أسم الحرباء في نصفه اسم % % لحبيب كأنه ظهر عس % 3(@)(@@) % قل لكس الأسنانأنت سميا % % ت حبيبي وهل حبيب ككس بذيء % % 3(@)(@@) % إن طال لم يمللوإن هي أوجزتالخفيفقل لكس الأسنانأنت سميات حبيبي وهل حبيب ككسبذيء وأرى أسم الحرباء في نصفه اسملحبيب كأنه ظهر عس يا أخي يا أبا الحسين وإلفيهاكها حكمة قس من فتى كلما بلوت من الفتيان غسا ألفيته غير غس % % ود المحدث أنها لم توجز % % PageV01P2309 البحر : - 1(@)(@@) % يسائلني فرخ الزنافيم عمتي % % أمن سقم أم زينة للأوانس % % 2(@)(@@) % فقلت لهلا من سقام لبستها % % ولا زينة للعاهرات النجائس % % 3(@)(@@) % ولكنني مذ كنت طفلا ويافعا % ومقتبلا أغرى ببغض القلانس % % 4(@)(@@) % ولا أشتهي لبس الدراريع والقبا % % ولا ذاك مما أرتضي في الملابس % % 5(@)(@@) % وأنت امرؤ ترضى بها وبلبسها % % وقلبك مشغوف بحب البرانس % % 6(@)(@@) % فكم برنس لم يأل خنقا لحلقه % % وتحبيسه في مظلمات المحابس % % 7(@)(@@) % وتقبيله لما حللت عقاله % وعليت فوديه بأصفر وارس % % 8(@)(@@) % ويرويوعليته لما حللت عقاله % بأصفر من أقذار بطنك وارس % % 9(@)(@@) % فإن أك معتما بثوب طهارة % فإنك معتم بخزي المجالس % % PageV01P2310 البحر : - 1(@)(@@) % إذا المرء لم يظهر لطالب رفده % % عبوسا ولا بشرا فكن منه يائسا % % 2(@)(@@) % فإن الذي يبدو العبوس بوجهه % % بخيل نوى جوادا فلاقاك عابسا % % 3(@)(@@) % وهاتيك حال الباخلين إذا نووا % % سدى أو ندى أبدوا وجوها عوابسا % % 4(@)(@@) % وأما الذي يبدي لك البشر فامرؤ % جواد إذا أعطاك لم يعط نافسا % % 5(@)(@@) % ومن شيمة الأجواد بسط وجوههم % % إذا سئلوا لا ينفسون النفائسا % % 6(@)(@@) % وأما الذي بين اللقاءين وجهه % فذاك الذي أبدى لك المنع يابسا % % 7(@)(@@) % وذاك الذي ألقاك عن ظهر باله % % هوانا فلم يخطرك بالبال 