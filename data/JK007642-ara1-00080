ms61	 % % 7(@)(@@) % إن السحائب لم تظهر بوارقها % % ما لم يكن للقوى فيهن معترك % % 8(@)(@@) % وللتدابير حرب لا يخيب بها % % قوم بمستنقع الآراء قد بركوا % % 9(@)(@@) % هذا هو المجلس الرحب الذي وسعت % % احكامه الناس من عاشوا ومن هلكوا % % 10(@)(@@) % هو السماء التي نعلو السماء بها % % تبدو من العدل في آفاقها حبك % % 11(@)(@@) % دارت بها شمس عز الملك حيث لها % % حرية العيش برج والنهي فلك % % PageV01P189 12(@)(@@) % قد أصبح الأمر شورى بيننا فبه % % على الرعية لا يستاثر الملك % % 13(@)(@@) % واصبح الناس في قربى وان بعدت % % اديانهم من بهم حقد ولا حسك % % 14(@)(@@) % هذا الذي جاءنا الدين الحنيف به % % وحيا من الله مبعوثا به الملك % % 15(@)(@@) % هذا به نهض الاسلام نهضته % % من قبل إذ قام يستولي ويمتلك % % 16(@)(@@) % يا قوم قد حان حين تسخرون به % % ممن بكم سخروا من قبل أو ضحكوا % % 17(@)(@@) % مات الزمان الدي من قبل كان به % % يحيا امرؤ لم يكن في السعي ينهمك % % 18(@)(@@) % هلا نظرتم لما في الغرب من سنن % % كل به سائر طلقا ومنسلك % % 19(@)(@@) % لم تلق للحق وجها فيه محتقرا % % ولم تجد حرمة للعلم تنتهك % % 20(@)(@@) % في الغرب أصوات عل يبعثون بها % % من في القبور فهل قي سمعكم سكك % % 21(@)(@@) % فشمروا يا رجال الشرق عن همم % % حجابها عند اهل الغرب منتهك % % PageV01P190 22(@)(@@) % ولست أطلب منكم فعل ما فعلوا % % ولا أحاول منكم ترك ما تركوا % % 23(@)(@@) % بل فاذكروا اوليكم كيف قد سلفوا % % ثم اسلكوا في المعالي أية سلكوا % % 24(@)(@@) % واستخلصوا عسجد المجد الذي بلغوا % % سبكا على قالب العلم الذي سبكوا % % 25(@)(@@) % لاعذر للشرق عند الغرب بعدئذ % % 26(@)(@@) % واستنجدوا العلم ان العلم شكته % % في حومة العيش تبلى دونها السنكك % % 27(@)(@@) % اما المدارس فلترفع قواعدها % % حتى تقوم وطود الجهل مؤتفك % % 28(@)(@@) % منابع العلم إن غاضت بمملكة % % فاضت بسيل الدواهي حولها برك % % 29(@)(@@) % من شاد مدرسة للعلم هد بها % % سجنا لمن أفسدوا في الأرض أو فتكوا % % 30(@)(@@) % وكم أثارت رياح الجهل من سحب % % تهطالهن دم في الأرض منسفك % % 31(@)(@@) % فالعلم والجهل كل 
ms62	 البون بينهما % % هذا الفسوق وذاك الفوز والنسك % % PageV01P191 32(@)(@@) % ضد ان ما استويا يوما ولا اجتمعا % % وهل ترى يتساوى النور والحلك % % 33(@)(@@) % نادوا البدار البدار اليوم إنكم % % يا قوم ساهون حيث الأمر مرتبك % % 34(@)(@@) % كم رددت كلمات الناصحين لكم % % حتى لقد مل من مضغ لها الحنك % % 35(@)(@@) % يا قوم قد طلعت شمس الهدى وبها % % للناس قد وضحت من رشدهم سكك % % 36(@)(@@) % وانشد الشرق مسرورا يؤرخها(@)(@@) % حرية الملك أهدى شمسها الفلك ) % PageV01P192 البحر : كامل تام 1(@)(@@) % نزلت تجر إلى الغروب ذيولا % % صفراء تشبه عاشقا مبتولا % % 2(@)(@@) % تهتز بين يد المغيب كأنها % % صب تململ في الفراش عليلا % % 3(@)(@@) % ضحكت مشارقها بوجهك بكرة % % وبكت مغاربها الدماء اصيلا % % 4(@)(@@) % مذحان في نصف النهار دلوكها % % هبطت تزيد على النزول نزولا % % 5(@)(@@) % قد غادرت كبد السماء منيرة % % تدنو قليلا للافول قليلا % % 6(@)(@@) % حتى دنت نحو المغيب ووجهها % % كالورس حال به الضياء حيولا % % 7(@)(@@) % وغدت باقصى الافق مثل عرارة % % عطشت فأبدت صفرة وذبولا % % 8(@)(@@) % غربت فأبقت الشواظ عقيبها % % شفقا بحاشية السماء طويلا % % 9(@)(@@) % شفق يروع القلب شاحب لونه % % كالسيف ضمخ بالدما مسلولا % % 10(@)(@@) % يحكى دم المظلوم ما زج أدمعا % هملت به عين اليتيم همولا % % PageV01P193 11(@)(@@) % رقت اعاليه واسفله الذى % % في الأفق أشبع عصفرا محلولا % % 12(@)(@@) % شفق كأن الشمس قد رفعت به % % ردنا بذوب ضيائها مبلولا % % 13(@)(@@) % كالخود ظلت يوم ودع إلفها % % ترنو وترفع خلفه المنديلا % % 14(@)(@@) % حتى توارت بالحجاب وغادرت % % وجه البسيطة كاسفا مخذولا % % 15(@)(@@) % فكأنها رجل تخرم عزه % % قرع الخطوب له فعاد ذليلا % % 16(@)(@@) % وانحط من غرف النباهة صاغرا % وأقام في غار الهوان خمولا % % 17(@)(@@) % لم انس قرب الاعظمية موقفي % % والشمس دانية تريد افولا % % 18(@)(@@) % وعن اليمين أرى مروج مزارع % % وعن الشمال حدائقا ونخيلا % % 19(@)(@@) % وتروع قلبي للدوالي نعرة % % في البين يحسبها الحزين عويلا % % 20(@)(@@) % ووراء ذاك الزرع راعي ثلة % % رجعت تؤم إلى المراح قفولا % % PageV01P194 21(@)(@@) % وهناك دون برذونتين قد اثنى % % بهما العشي من الكراب نحيلا % % 22(@)(@@) % وبمنتهى نظري دخان صاعد % % يعلو كثيرا تارة وقليلا % % 23(@)(@@) % مد الفروع 
ms63	 إلى السماء ولم يزل % % بالارض متصلا يمد اصولا % % 24(@)(@@) % وتراكبت في الجو سود طباقه % % تحكي تلولا قد حملن تلولا % % 25(@)(@@) % فوقفت أرسل في المحيط المدى % % نظرا كما نظر السقيم كليلا % % 26(@)(@@) % والشمس قد غربت ولما ودعت % % ابكت حزونا بعدها وسهولا % % 27(@)(@@) % غابت فأوحشت الفضاء بكدرة % % سقم الضياء بها فزاد نحولا % % 28(@)(@@) % حتى قضت روح الضياء ولم يكن % % غير الظلام هناك عزرائيلا % % 29(@)(@@) % وأتى الظلام دجنة فدجنة % % يرخي سدولا جمة فسدولا % % 30(@)(@@) % ليل بغيهبه الشخوص تلفعت % % فظللت أحسب كل شخص غولا % % PageV01P195 31(@)(@@) % ثم انثنيت اخوض غمر ظلامه % % وتخذت نجم القطب فيه دليلا % % 32(@)(@@) % إن كان أوحشني الدجى فنجومه % % بعثت لتؤنسني الضياء رسولا % % 33(@)(@@) % سبحان من جعل العوالم أنجما % % يسبحن عرضا في الاثير وطولا % % 34(@)(@@) % كم قد تصادمت العقول بشأنها % % وسعت لتكشف سرها المجهولا % % 35(@)(@@) % لا تحتقر صغر النجوم فإنما % % ارقى الكواكب ما استبان ضئيلا % % 36(@)(@@) % دارت قديما في الفضاء رحى القوى % % فغدا الاثير دقيقها المنخولا % % 37(@)(@@) % فاقرأ كتاب الكون تلق بمتنه % % آيات ربك فصلت تفصيلا % % 38(@)(@@) % ودع الظنون فلا وربك انها % % لم تغن من علم اليقين فتيلا % % PageV01P196 البحر : خفيف تام 1(@)(@@) % طرب الشعر أن يكون نسيبا % % مذ أجالت لنا القوام الرطيبا % % 2(@)(@@) % وتجلت في مرسح الرقص حتى % % أرقصت بالغرام منا القلوبا % % 3(@)(@@) % أقبلت تنثي بقد رشيق % % ألبسته البرد القصير قشيبا % % 4(@)(@@) % قصرت منه كمه عن يديها % % وأطالت إلى الهنود الجيوبا % % 5(@)(@@) % حبس الخضر حيث ضاق ولكن % % من تزيا به ، وفي الطيب طيبا % % 6(@)(@@) % خطرت والجمال يخطر منها % % في حشا القوم جيئة وذهوبا % % 7(@)(@@) % وعلى أرؤس الأصابع قامت % % تتخطى تبخترا ووثوبا % % 8(@)(@@) % يعبس الانس أن تروح ذهابا % % ويعيد ابتسامه أن تئوبا % % 9(@)(@@) % فهي إن أقبلت رأيت ابتساما % % وهي إن أدبرت رأيت قطوبا % % 10(@)(@@) % نحن منها في الحالتين ترابا % % نرقب الشمس مطلعا ومغيبا % % PageV01P197 11(@)(@@) % تضحك الحمو في الصباح طلوعا % % ثم تبكيه في المساء غروبا % % 12(@)(@@) % أظهرت في المجال من كل عضو % % لعبا كان بالقلوب لعوبا % % 13(@)(@@) % فأرتنا من الجين صباحا % % فعجيبا من رقصها 
ms64	 فعجيبا % % 14(@)(@@) % شابهت عطفة الغصون انثناء % % ما حيات أنوارهن الجدوبا % % 15(@)(@@) % تلفت الجيد للرجوع انصياعا % % كفطيم رأي على البعد ذيا % % 16(@)(@@) % تثب الوثبة الخفيفة كالبرق % % صعودا في رقصها وصبوبا % % 17(@)(@@) % حركات خلالها سكنات % % يقف العقل بينهن سليبا % % 18(@)(@@) % وخطا تفضح العقود اتساقا % نظمتها تسرعا ودبيبا % 19(@)(@@) % بسمت كوكبا ومرت نسيما % % وشدت بلبلا وفاهت خطيبا % % 20(@)(@@) % لهف نفسي على نضارة بغدا % % لتغني بوصفها عند ليبا % % PageV01P198 21(@)(@@) % أو غدا الحسن شاعرا ينظم العشق % % قريضا ابدى بها التشبيبا % % 22(@)(@@) % هي كالشمس في البعاد وإن كا % % ن إلينا منها الشعاع قريبا % % 23(@)(@@) % عمت الناس بالغرام فكل % % قد غدا عاشقا لها ورقيبا % % 24(@)(@@) % زهرة تبهج النواظر حسنا % ورواء وتنعش الروح طيبا % % 25(@)(@@) % هي دائي اذا شكوت من الداء % % وطبي اذا اردت طبيبا % % 26(@)(@@) % وأتت بعدها من الغيب أخرى % % يقتفي إثرها الجمال جنيبا % % 27(@)(@@) % فأرتنا من الجبين صباحا % % ومن الخد كوكبا مشبوبا % % 28(@)(@@) % حملت بندقية صوبتها % % نحو مستهدف لها تصويبا % % 29(@)(@@) % واستمرت رميا بها عن بنان % % لطفه ضامن له ان يصيبا % % 30(@)(@@) % تحسن الرمي تارة مستقيما % % وإلى الخلف تارة مقلوبا % % PageV01P199 31(@)(@@) % وانكبابا إلى الامام واقعاسا % % كثيرا إلى الوراء عجيبا % % 32(@)(@@) % وهي في كل ذا تصيب الرمايا % % مثلما طرفها يصيب القلويا % % 33(@)(@@) % لو أرادت رمي الغيوب وأغضت % % لاصابت خفيها المحجوبا % % 34(@)(@@) % مشهد فيه للحياة حياة % % تترك الواله الحزين طروبا % % 35(@)(@@) % قد شهدناه ليلة جعلتنا % % نحمد الدهر غافرين الذنوبا % % 36(@)(@@) % بين رهط شم العرانين ينفي ال % % عنى حديثهم والكروبا % % 37(@)(@@) % كرموا انفسا وطابوا فعالا % % وسموا محتدا وعفوا جيوبا % % 38(@)(@@) % كل ذي نجدة تراه لدى الفعل % % كريما وفى المقال اديبا % % 39(@)(@@) % تلك والله ليلة لست أدري % % في بلادي قضيتها أم غريبا % % 40(@)(@@) % كدت أنسى بها العراق وإن أن % % قى ندوبا بمهجتي فندوبا % % PageV01P200 41(@)(@@) % يا سواد العراق بيضك الدهر % % فاشبهت مقلتي يعقوبا % % 42(@)(@@) % شملت ريحك العقيم وقد كانت % % نت لقوحا تهب فيك جنوبا % % 43(@)(@@) % أين أنهارك التي تملأ الأرض % % غلالا بسيحها وحبوبا % % 44(@)(@@) % اذ حكت ارضك السماء نجوما % % 45(@)(@@) % % د 
ms65	 استحالت كذورة وشحوبا % % 46(@)(@@) % أين بغداد وهي تزهو علوما % % وزروعا واربعا ودروبا % % 47(@)(@@) % أقفرت أرضها وحاق بها الجه % % فجاشت دواهيا وخطوبا % % PageV01P201 البحر : طويل 1(@)(@@) % تذكرت في أوطاني الأهل والصحبا % % فأرسلت دمعا فاض وابله سكبا % % 2(@)(@@) % وبت طريد النوم أختلس الكرى % % بشاخص طرف في الدجى يرقب الشهبا % % 3(@)(@@) % كئيب كأن الدهر لم يلق غيره % % عدوا فآلى لن يهادنه حربا % % 4(@)(@@) % يقل كروبا بعضها فوق بعضها % % إذا ما رمى كربا رأى تحته كربا % % 5(@)(@@) % وإني إذا ما الدهر جر جريرة % لتأنف نفسي ان اكلمه عتبا % % 6(@)(@@) % وقد علم القوم الكرام بأني % % غلام على حب المكارم قد شبا % % 7(@)(@@) % وأني أخو عزم إذا ما انتضيته % % نبا كل عضب أو انكر الضرب % % 8(@)(@@) % وأني أعاف الماء في صفوه القذى % % وان كان في احواضه باردا عذبا % % 9(@)(@@) % ولكن لي في موقف الشوق عبرة % % أولى الأنام بعطف الناس أرملة % % 10(@)(@@) % وقاطرة ترمي الفضا بدخانها % % بدت نغمات ترقص الدمع منصبا % % PageV01P202 11(@)(@@) % وقاتطرة ترمي الفضا بدخانها % % وتملأ صدر الأرض في سيرها رعبا % % 12(@)(@@) % لها منخر يبدي الشواظ تنفسا % وجوف به صار اليخار لها قلبا % % 13(@)(@@) % تمشت بنا ليلا تجر وراءها % % قطارا كصف الدوح تسحبه سحبا % % 14(@)(@@) % فطورا كعصف الريح تجري شديدة % % أشارك الناس طرا في بلاياها % % 15(@)(@@) % تساوى لديها السهل والصعب في السرى % % فما استسهلت سهلا ولا استصعبت صعبا % % 16(@)(@@) % تدك متون الحزن دكا وإنها % % لتنهب سهل الأرض في سيرها نهبا % % 17(@)(@@) % يمر بها العالي فتعلو تسلقا % % ويعترض الوادي فتجتازه وثبا % % 18(@)(@@) % % اذا ولجت في جوفه النفق الرحبا % % 19(@)(@@) % لها صيحة عند الولوج كأنها % % تقول بهلا يا طود خل لي الدربا % % 20(@)(@@) % وتمضي مضي السهم فيه كأنما % % ترى افعوانا هائجا دخل الثقبا % % PageV01P203 21(@)(@@) % تغالب فعل الجذب وهي ثقيلة % % فتغلب بالدفع الذي عندها الجذبا % % 22(@)(@@) % طوت بالسير الأرض طيا كانها % % تسابق قرص الشمس ان يدرك الغربا % % 23(@)(@@) % وما إن شكت أينا ولا سئمت سرى % % ولا استهجنت بعدا ولا استحسنت قربا % % 24(@)(@@) % عشية سارت من فروق تقلنا % % وتقذف من فيها 
ms66	 بوجه الدجى شهبا % % 25(@)(@@) % فما هي إلا ليلة ونهارها % % وما قد دعونا من سلانيك قد لبى % % 26(@)(@@) % فجئنا ولم يعي السفار مطينا % % كأن لم نكن سفرا على ظهرها ركبا % % 27(@)(@@) % تغالبت يا عصر البخار مفضلا % % على كل عصر قد قضى أهله نحبا % % 29(@)(@@) % يا رب ما حيلتي فيها وقد ذبلت % % يذلل ادنى فعلها المطلب الصعبا % % 33(@)(@@) % % تمشي بأطمارها والبرد يلسعها % % PageV01P204 البحر : طويل 1(@)(@@) % اذا شئت ان تسرى بكافرة الصوى % % يدوي بقطريها هزيم الرواعد % 2(@)(@@) % وتذهب محيار الظلام تخبطا % وتعثر في ظلمائها بالجلامد % % 3(@)(@@) % وتمشي فما تدري إلى قعر هوة % % تروح بها أم للمدى المتباعد % % 4(@)(@@) % فطالع أراجيف الجرائد إنني % % ارى الويل كل الويل بين الجرلائد % % 5(@)(@@) % جرائد في دار الخلافة أضرمت % % لهيب خلاف بينهما غير خامد % % 6(@)(@@) % ولم يكفها هذا الخلاف وانما % % أطافت بنقص في الحقيقة زائد % % 7(@)(@@) % فما بين مكذوب عليه وكاذب % % وما بين مجحود عليه وجاحد % % 8(@)(@@) % ترى في فروق اليوم قراء صحفها % % فريقين من ذي حجة ومعاند % % 9(@)(@@) % جدال على مر الجديدين دائم % % بتنفيد رأي أو بتنقيد ناقد % % 10(@)(@@) % فذائد سهم عن رمي يرده % % وآخر رام سهمه نحو ذائد % % PageV01P205 11(@)(@@) % وهذا إلى هذى وذاك لغيرها % % من الصحف يدعو آتيا بالشواهد % % 12(@)(@@) % وما هي إلا ضجة كل صائت % % بها مد للدنيا حبالة صائد % % 13(@)(@@) % أضاعوا علينا الحق فيها تعمدا % % وعقبى ضياع الحق سود الشدائد % % 14(@)(@@) % ولم أر شيئا كالجرائد عندهم % % مبادئه منقوضة بالمقاصد % % 15(@)(@@) % يقولون نحن المصلحون ولم اجد % % لهم في مجال القول غير المفاسد % % 16(@)(@@) % وكيف يبين الحق من نفثاتهم % % وكل له في الحق نفثة مارد % % 17(@)(@@) % فاياك ان تغتر فيهم فكلهم % % يجر إلى قرصية نار المواقد % % 18(@)(@@) % وكن حائدا عنهم جميعا فانما % % يضل امروء عن غيهم غير حائد % % 19(@)(@@) % على رسلكم يا قوم كم سمعوننا % % مقالة محقود عليه وحاقد % % 20(@)(@@) % ألا فارحموا بالصفح عن نهج صحفكم % % فقد اوردتنا اليوم شر الموارد % % PageV01P206 21(@)(@@) % وما الصحف إلا أن تدور بنهجها % % مع الحق انى دار بين المعاهد % % 22(@)(@@) % وان 
ms67	 تنشر الاقوال لا عن طماعة % % فتأتي بها مشحونة بالفوائد % % 23(@)(@@) % وان لا تعاني غير نشر حقائق % % وتنوير افكار وانهاض قاعد % % 24(@)(@@) % أتبغون في تلفيقها نفع واحد % % وتغضون عن اضرارها الف واحد % % 25(@)(@@) % ألا إن صحف القوم رائد نجحهم % % وما جاز في حكم النهي كذب رائد % % 26(@)(@@) % لعمري ان صحف مرآة اهلها % % بها تتجلى روحهم للمشاهد % % 27(@)(@@) % كما هي ميزان لوزن رقيهم % % وديوان أخلاق لهم وعوائد % % 28(@)(@@) % الاننظرون الغرب كيف تسابقت % % به الصحف في طرق العلى والمحامد % % 29(@)(@@) % بها يهتدي القراء للحق واضحا % % كما يهتدي الساري بضوء الفراقد % % 30(@)(@@) % ولكن ابى الشرق التعيس تقدما % مع الغرب حتى في شؤون الجرائد % % PageV01P207 31(@)(@@) % فلا تحملوا حقدا على ما أقوله % % فإني عليكم خائف غير حاقد % % 32(@)(@@) % وما هي الا غيرة وطنية % % فان تجدوا منها فلست بواحد % % PageV01P208 البحر : كامل تام 1(@)(@@) % ناح الحمام وغرد الشحرور % % هذا به شجن وذا مسرور % % 2(@)(@@) % في روضة يشجى المشوق ترقرق % % للماء في جنباتها وخرير % % 3(@)(@@) % ماء قد انعكس الصفاء بوجهه % % وصفا فلاح كأنه بلور % % 4(@)(@@) % قد كاد يمكن عنذ ظني أنه % % بالماس يوشر منه لي موشور % % 5(@)(@@) % وتسلسلت في الروض منه جداول % % بين الزهور كانهن سطور % % 6(@)(@@) % حيث الغصون مع النسيم موائل % % فكأنهن معاطف وخصور % % 7(@)(@@) % ماذا أقول بروضة عن وصفها % % يعيا البيان ويعجز التعبير % % 8(@)(@@) % عني الربيع بوشيها فتنوعت % % للعين أنوار بها وزهور % % 9(@)(@@) % مثلت بها الاغصان وهي منابر % % وتلت بها الخطباء وهي طيور % % 10(@)(@@) % متعطر فيها النسيم كأنما % % جيب النسيم على شذا مزرور % % PageV01P209 11(@)(@@) % للنرجس المطلول ترنو أعين % % فيها وتبسم للاقاح ثغور % % 12(@)(@@) % تخذت خزاماها البنفسج خدنها % % وغدا يشير لوردها المنثور % % 13(@)(@@) % وكأن محمر الشقيق وحوله % % في الروض زهر الياسمين يمور % % 14(@)(@@) % شمع توقد في زجاج أحمر % % فغدا حواليه الفراش يدور % % 15(@)(@@) % وتروق من بعد بها فوارة % % في الجو يدفق ماؤها ويفور % % 16(@)(@@) % يحكى عمود الماء فيها آخذا % % صعدا عمود الصبح حين ينير % % 17(@)(@@) % ناديت لما ان رأيت صفاءه % % والنور فيه مغلغل مكسور % % 18(@)(@@) % هل ذاك ذوب 
ms68	 الماس يجمد صاعدا % % أم قد تجسم في الهواء النور % % 19(@)(@@) % تتناثر القطرات في أطرافها % % فكأنما هي لؤلؤ منثور % % 20(@)(@@) % ينحل فيها النور حتى قد ترى % % قوس السحاب لها بها تصوير % % PageV01P210 21(@)(@@) % كم قد لبست بها الضحى من روضة % % فيها علتني نضرة وسرور % % 22(@)(@@) % فاجلت في الازهار لحظ تعجبي % % ولفكرتي بصفاتهن مرور % % 23(@)(@@) % فنظرتهن تحيرا ونظرنني % % حتى كلانا ناظر منظور % % 24(@)(@@) % فكأن طرف الزهر ثمة ساحر % % لما رنا وكأنني مسحور % % 25(@)(@@) % إن الزهور تكهن براعم % % مثل العلوم تجنهن صدور % % 26(@)(@@) % وتضوع النفحات منها مثله % % تبيينها للناس والتقرير % % 27(@)(@@) % وبتلك قلب الجهل مصدوع كما % % ثوب الهموم بهذه مطرود % % 28(@)(@@) % والزهر ينبته السحاب بمائه % % يزهو فذلك في النهى تنوير % % 29(@)(@@) % أو كان هذا لا يدوم فان ذا % % ليدوم ما دامت تكر عصور % % PageV01P211 البحر : طويل 1(@)(@@) % وخرساء لم ينطق بحرف لسانها % % سوى صوت عرق نابض بحشاها % % 2(@)(@@) % حكت لهجة التمام لفظا ولم تكن % % لتفصح إلا بالزمان لغاها % % 3(@)(@@) % لها ضربان في الحشاقد حكت به % % فؤادا تغشاه الهوى وحكاها % % 4(@)(@@) % جرت حركات الدهر في ضربانها % % وبانت مواقيت الورى بعماها % % 5(@)(@@) % على وجهها خطت علائم تهتدي % % بها الناس في أوقاتها لمناها % % 6(@)(@@) % مشت بين آنات الزمان تقيسه % % وما هو إلا مشيها وخطاها % % 7(@)(@@) % بها يتقاضى الناس ما يوعدونه % % ويرشد ضلال الزمان هداها % % 8(@)(@@) % غدت كأخي الإيمان تأكل في معي % % وما أكلها إلا التواء معاها % % 9(@)(@@) % تدور عليها عقرب دور حائر % % بتيهاء غمت في الظلام صواها % % 10(@)(@@) % تريك مكان الشمس في دورانها % % إذا حجبت عنك الغيوم ضياها % % PageV01P212 11(@)(@@) % فأعجب بها مصحوبة جاء صنعها % % نتيجة أفكار الورى وحجاها % % 12(@)(@@) % بنتها النهي في الغابرين بسيطة % % فتم على مر الزمان بناها % % 13(@)(@@) % تنادي بني الأيام في نقراتها % % أن اسعوا بجد بالغين مداها % % 14(@)(@@) % ولا تهملوا الأوقات فهي بواتر % % تقطع أوصال الحياة شباها % % PageV01P213 البحر : طويل 1(@)(@@) % ذهبت لحى في فروق تزاحمت % به الخلق حتى قلت ما أكثر الخلقا % % 2(@)(@@) % ترى الناس افواجا اليه وانما % % إلى التلعات الزهر في درج ترقى % % 3 
ms69	(@)(@@) % يضئ به ثغر الحضارة باسما % بلامع نور علم السحب البرقا % % 4(@)(@@) % رأيت مبانيه وجلت بطرفه % % فما أحسن المبنى وما أوسع الطرقا ! % 5(@)(@@) % فكم فيه من صرح ترى الدهر متلعا % % يمد إلى ادراك شرفته العنقا % % 6(@)(@@) % قصور علت في الجو لم تلق بينها % % وبين النجوم الزهر في حسنها فرقا % % 7(@)(@@) % هنالك للأرضين أفق بروجه % % تضاحك أبراج السموات والأفقا % % 8(@)(@@) % بروج ولكن شارقات شموسها % % تدور بافق يجمع الغرب والشلارقا % % 9(@)(@@) % بحيث ترى حمر الطرابيش خالطت % % برانيط سودا كالسلاحف أو ورقا % % 10(@)(@@) % وتلقى الوجوه البيض حمرا خدودها % % وتلقى العيون السود والأعين الزرقا % % PageV01P214 11(@)(@@) % خدود جرى ماء الشبيبة فوقها % % ففيه عقول الناظرين من الغرقى % % 12(@)(@@) % محاسن كالأزهار قد طلها الهوى % % وان كان فيها الشعر ممتلئا عشقا % 13(@)(@@) % ومن ذي دلال رنح الحسن عطفه % % 14(@)(@@) % وكم مسرح فيه الحسان تلاعبت % % تمثل كيف الناس تسعد أو تشفى % % 15(@)(@@) % حسان علت في الحسن خلقا وخلقة % % وهل خلقة تعلو إذا سفلت خلقا % % 16(@)(@@) % تمثل ما قد مر منا وما حلا % % وما جل من امر الحياة وما دقا % % 17(@)(@@) % فتلقى دروسا لو وعتها حياتنا % % لبدل كذب في سعادتها صدقا % % 18(@)(@@) % إذ مثلت شكوى الحزين بكت لها % % عيون البلايا والزمان لها رقا % % 19(@)(@@) % وإن صورت حقا هوى كل باطل % % على رأسه حتى تجدل مندقا % % 20(@)(@@) % وما ذا ترى فيه اذا زرت حانة % ترى الانس يشدو في فم يجهل النطقا % % PageV01P215 21(@)(@@) % سكوت على قرع الكؤوس مغرد % % بلحن سرور يترك الهم منشقا % % 22(@)(@@) % عليهم سحاب الاحتشام يظلهم % % متى هم ارادواسح من قبل ودقا % % 23(@)(@@) % اوانس قد نادمن كل غرانق % فمنهن من تسقى ومنهن من تسقى % % 24(@)(@@) % فمن ذا يراهم ثم لم يك واغلا % % عيهم وان امسى يعد الفتى الاتقى % % 25(@)(@@) % الست بمعذور اذا انا زرتهم % % وساجلتهم شوقا فقل ويحك الحقا % % 26(@)(@@) % فقد لامني لما رآني بحبهم % % فتى منه قحف الرأس ممتلئ حمقا % % 27(@)(@@) % فقال أفي الحي الذي شاع فسقه % % تجول ألم تمنع عمامتك الفسقا % % 28(@)(@@) % فقلت اجل ان العمائم عندنا % % لتمنع في 
ms70	 لوثاتها الفسق والزرقا % % 29(@)(@@) % ولكنني ما جئت الا توصيلا % % لذكرى شقاء في العراق به نشقي % % 30(@)(@@) % شقاء تمطى في العراق تمطيا % % وألقي جرانا لا يزحزح واستلقي % % PageV01P216 31(@)(@@) % فان العراق اليوم قد نشبت به % % نيوب الدواهي فهي تعرقه عرقا % % 32(@)(@@) % تمشت به حتى اعادت سواده % % بياضا ومدت للبوار به ربقا % % 33(@)(@@) % فلهفي على بغداد اذ قد اضاعها % % بنوها فسحقا للبنين بها سحقا % % 34(@)(@@) % جزوها عقوقا وهي أم كريمة % % والأم أبناء الكريمة من عقا % % 35(@)(@@) % أدامت لها الأحداث مخضا كأنها % % قد اتخذتها الحادثات لها زقا % % 36(@)(@@) % سأبكي عليها كلما جلت سائحا % وشاهدت في العمران مملكة ترقى % % 37(@)(@@) % واندبها عند الاغاريد شاربا % من الدمع كأسا لا اريد لها مذقا % % PageV01P217 البحر : بسيط تام 1(@)(@@) % نجيت بالسد بغدادا من الغرق % % فعمها الأمن بعد الخوف والفرق % % 2(@)(@@) % قد قمت بالحزم فيها واليا فجرت % أمورها في نظام منك متسق % % 3(@)(@@) % لقد نجحت نجاحا لا يفوز به % % من خالق الحزم الا حازم الخلق % % 4(@)(@@) % ويح الفرات فلو كانت زواخره % % تدري بعزمك لك تطفح على الطرق % % 5(@)(@@) % ولا غدت تجرف الأسداد قاذفة % % منها بسيل على الانحاء مندفق % % 6(@)(@@) % حيث ' الحويوة ' امست منك طالبة % % رتقا لسد بطامي السيل منفتق % % 7(@)(@@) % باتت تجيش بتيار وبات لها % % أهل العراقين في هم وفي قلق % % 8(@)(@@) % حتى إذا أيقنت أرض العراق بأن % % تفنى من الظلم اليها متلع العنق % % 9(@)(@@) % فكدت تملأ فرغ الواديين بما % % حشرت من طبق يأتيك عن طبق % % 10(@)(@@) % لما خرجت وكان الخرق متسعا % والناس ما بين ذي شك ومتثق % % PageV01P218 11(@)(@@) % قالوا : نحا شقة قصوى وما علموا % % بأن عزمك يدني أبعد الشقق % % 12(@)(@@) % فصدق الله ظنا فيك أحسنه % % قوم وكذب ظن الجاهل الخرق % % 13(@)(@@) % اذ جئت والسد تحت الغمر مكتسح % % والنهر يرغو بموج فيه مصطفق % % 14(@)(@@) % وثلمة السد كالمواة واسعة % % يهوي بها السيل من فوق إلى العمق % % 15(@)(@@) % سللت صارم رأي قد أزلت به % % ما كان في السيل من طيش ومن نزق % % 16(@)(@@) % فما تموج ماء النهر من غضيب % % وانما اخذتهرعدة الفرق 
ms71	 % % 17(@)(@@) % ثبت عزمك في أمر يذل به % % عزم الحصيف لما يحوي من الزاق % % 18(@)(@@) % تقضي النهار برأب الثأي مجتهدا % وتقطع الليل بالتدبير والأرق % % 19(@)(@@) % حتى بنيت وكان النهر منفلقا % % سدا عليه رصينا غير منفلق % % 20(@)(@@) % أرسيته جبلا قامت ذراه على % % أصل مع الموج تحت الماء معتنق % % PageV01P219 21(@)(@@) % فراحت الناس تمشي فوقه طربا % % والنهر ينساب بين الغيظ والحنق % % 22(@)(@@) % وصار معكس فخرانت مرجعه % % 23(@)(@@) % من كل أحمر قان وسطه قمر % % يتلوه نجم بلون ابيض يقق % % 24(@)(@@) % فظل حاسدك المغبون منطويا % % على فؤاد بنار الجهل محترق % % 25(@)(@@) % ود الفرات حياء منك يومئذ % % 26(@)(@@) % لما اقتدحت زناد الرأي مفتكرا % % في الخطب الهبت منه فحمة الغسق % % 27(@)(@@) % فأدبر الهم وانشقت غياهبه % % كما قد انشق سجف الليل بالفلق % % 28(@)(@@) % ان الامور اذا استعصت نوافرها % % أخذتهن من التادبير في وهق % % 29(@)(@@) % وان تصاممت الايام عن طلب % % أسمعتهن بصوت منك صهصلق % % 30(@)(@@) % تنحل بالرأي منك المشكلات لنا % % كالنور ينحل ألوانا من الشرق % % PageV01P220 31(@)(@@) % وكلما زدت تفكيرا بمعضلة % % زادت وضوحا لنا حتى على الشفق % % 32(@)(@@) % فالفكر منك كأبعاد الفضاء بلا % % حد يسابق خطف البرق في الطلق % % 33(@)(@@) % يحكى الأثير إذا أجرى تلاطمه % % ابدى سواظع نور منه منبثق % % 34(@)(@@) % لك الثناء علينا ان نخلده % % نقشا على الصخر لا رقما على الورق % % 35(@)(@@) % تالله لو بلغت زهر النجوم يدي % % مكن كل جرم بصدر الليل مؤتلق % % 36(@)(@@) % رتبتها حيث كل الناس تقرؤها % % سطرا بمدحك مكتوبا على الافق % PageV01P221 البحر : كامل تام 1(@)(@@) % برزت تميس كخطرة النشوان % % هيفاء مخجلة غصون البان % % 2(@)(@@) % ومشت فخف بها الصبا فتمايلت % % مرحا فاجهد خصرها الردفان % % 3(@)(@@) % جال الوشاح على معاكفها التي % % قعدت وقام بصدرها النهدان % % 4(@)(@@) % تستبعد الحر الأبي بمقلة % % حبا أذبت بناره سلواني % % 5(@)(@@) % وإذا بدت تهفو القلوب صبابة % % فيها وتركع دونها العينان % % 6(@)(@@) % أخذ الدلال مواثقا من عينها % % أن لا تزال مريضة الاجفان % % 7(@)(@@) % تمشي فتنشر في الفضاء محاسنا % بسط الزمان لها يدي ولها % % 8(@)(@@) % ويلوح للنظر القريب بوجهها % % عقل الحليم وعصمة الصبيان % % 9(@)(@@) % لم 
ms72	 انس في قلبي صعود غرامها % % اذ تحن نصعد في ربى لبنان % % 10(@)(@@) % حيث الرياض يهز عطف غصونها % % شدو الطيور بأطرب الألحان % % PageV01P222 11(@)(@@) % لبنان تفعل بالحياة جنانه % % فعل الزلال بغلة الظمآن % % 12(@)(@@) % وترد غصن العيش بعد ذبوله % % غضا يميد بفرغه الفينان % % 13(@)(@@) % فكأن لبنانا عروس إذ غدا % % يزهو بنشر غادائر الاغصان % % 14(@)(@@) % وكأنما البحر الخضم سجنجل % % في وجه كل حلاحل ديان % % 15(@)(@@) % أم ليس يعلم أنني أحببته % % تحت البسيطة راسخ الاركان % % 16(@)(@@) % تهفو الغصون به النهلر وفي الدجى % % تهفو عليه ذوائب النيران % % 17(@)(@@) % من فوقه درر على تيجان % % من فوقه در على تيجان % % 18(@)(@@) % لله لبنان الذي هضباته % % شيئا يضيع كرامة البلدان % % 19(@)(@@) % يجري النسيم الغض بين رياضه % % مرحى الذيول معطر الأردان % % 20(@)(@@) % جلت الطبيعة في رباه بدائعا % تكسو الكهول غضاضة الشبان % % PageV01P223 21(@)(@@) % يا صاحبي أتذكران فانني % % لم انس بعد كما سوى النسيلن % % 22(@)(@@) % اذ كان يغبطنا الزمان ونحن ظلامه % % يرنو لهن بمقلة الغيران % % 23(@)(@@) % متجاولين من الحديث بساحة % % ركض البيان بها بغير عنان % % 24(@)(@@) % والليل يسمع ما نقول ولم يكن % % غير الكواكب فيهمن آذان % % PageV01P224 البحر : وافر تام 1(@)(@@) % لعمرك ان قصر البحر قصر % % به يسلو مواطنه الغريب % % 2(@)(@@) % وتمتلئ العيون به ابتهاجا % اذا نظرت وتنشرح القلوب % % 3(@)(@@) % أحاط به فكان له رقيبا % مناظر دونها العجب العجيب % % 4(@)(@@) % فمن شمس يصافحها طلوع % % ومن شمس يعانقها غروب % % 5(@)(@@) % ومن سفن تجيء بها شمال % % 6(@)(@@) % % ومن سفن تروح بها جنوب % % 7(@)(@@) % وأخرى حوله خمدت لظاها % % وأخرى في الفؤاد بها لهيب % % 8(@)(@@) % أطل على المياه فقابلته % % بوجه لا يمازجه شحوب % % 9(@)(@@) % يقبل جانبيه البحر حتى % % كأن البحر مشغوف كئيب % % 10(@)(@@) % وهذا القصر بينهم خطيب % % ومغناه الانيق له حبيب % % PageV01P225 11(@)(@@) % وما هذا التموج من هواء % % ولكن من هوى فهو الوجيب % % 12(@)(@@) % كأن الموج في الدأماء رجال % % مهذا القصر تصفيق مهيب % % 13(@)(@@) % تلم به المسرات ازديارا % فتعرفه وتجهله الكروب % % 14(@)(@@) % وما انفردت به بيروت حسنا % % ولكن القصور بها ضروب % % 15(@)(@@) % فها هو من تكاسل قاطنيه % % تجر 
ms73	 عليه كلكلها الخطوب % % 16(@)(@@) % إذا تدعو الرجال به لخير % % يجيبك من تخاذلهم مجيب % % 17(@)(@@) % فيا لهفي على بغداد امست % % من العمران ليس لها نصيب % % 18(@)(@@) % سأبكي ثم استبكي عليها % % اذا نضبت من العين الغروب % % 19(@)(@@) % أيا بغداد لا جازتك سحب % % ولا حلت بساحتك الجدوب % % 20(@)(@@) % تطاول ساكنوك على ظلما % فضاق على مغناك الرحيب % % PageV01P226 21(@)(@@) % وكم نطقوا بالسنة حداد % % يسيل بها من الأشداق حوب % % 22(@)(@@) % رماني القوم بالالحاد جهلا % وقالوا عنده شك مريب % % 23(@)(@@) % ألا يا قوم سوف يجد جدى % % وسوف يخيب منكم من يخيب % % 24(@)(@@) % فمن ذا منكم قد شق قلبي % % وهل كشفت لكم في الغيوب % % 25(@)(@@) % فعند الله لي معكم وقوف % % إذا بلغت حناجرها القلوب % % 26(@)(@@) % يقيني شر فريتكم يقيني % % بأن الله مطلع رقيب % % 27(@)(@@) % ولم تخفر لكم عندي ذمام % % ولكن عادة الريح الهبوب % % PageV01P227 البحر : وافر تام 1(@)(@@) % كأن البدر صحن من لجين % بدا فجلا برونقه الهموما % % 2(@)(@@) % به ارتقت الملائك للاعالي % % وراحت فيه تلتقط النجوما % % PageV01P228 البحر : سريع 1(@)(@@) % البحر رهو والسماء صاحية % % والفخت في الليل شبيه السديم % % 2(@)(@@) % والبدر في طلعته الزاهيه % % قد ضاحك البحر بثغر بسيم % % 3(@)(@@) % والصمت في الانحاء قد خيما % % فالليل لم يسمع ولم ينطق % % 4(@)(@@) % والبدر في مفرق هام السما % % تحسبه التاج على المفرق % % 5(@)(@@) % اغرق في أنواره الأنجما % % وبعضها عام فلم يغرق % % 6(@)(@@) % والبحر في جبهته الصافيه % قام طريق للسنا مستقيم % % 7(@)(@@) % وقفت والريح سرت سجسجا % % وقفة مبهوت على الساحل % % 8(@)(@@) % انظر ما فيه يحار الحجى % % ورد سحبان إلى باقل % % 9(@)(@@) % ما أنت إلا صحف عالية % % كم حار في حكمتها من حكيم % % 10(@)(@@) % اذا وعتها أذن واعيه % % فقد خير كتاب كريم % % PageV01P229 11(@)(@@) % وزان عرض البحر ما قد بدا % % من زورق يجرى بمجدا فتين % % 12(@)(@@) % عام بذوب الماس أو قد غدا % % يسبح في لجة ذوب اللجين % % 13(@)(@@) % في صامت الليل جرى مفردا % % وبين جنبيه حوى عاشقين % % 14(@)(@@) % من غادة في حسنها غانيه % % تبسم عن لألاء در نظيم % % 15(@)(@@) % ومن فتى أدمعه جارية % % قد صافح 
ms74	 العشق بجسم سقيم % % 16(@)(@@) % قابلها والحب قد شفه % % وقابلت طلعة بدر السما % % 17(@)(@@) % وظل يرنو تارة خلفه % % وتارة ينظرها مغرما % % 18(@)(@@) % ثم تدانى واضعا كفه % % في كفها يطلب ان يلثما % % 19(@)(@@) % وخر من وجد على الناصيه % % وقلبه يركض ركض الظليم % % 20(@)(@@) % وهي غدت من اجله جاثيه % % واحتضنه كاحتضان الفظيم % % PageV01P230 21(@)(@@) % ثم رمى نظرة مسترحم % % في الكون عن طرف له حائر % % 22(@)(@@) % وقال قول الكلف المغرم % % في حب ذات النظر الساحر % % 23(@)(@@) % أيتها الأرض قفى واسلمي % % من أجل هذا المشهد الزاهر % % 24(@)(@@) % حتى ارى ليلتنا باقيه % % محفوفة من وصلنا بالنعيم % % 25(@)(@@) % فان هذي ليلة حاليه % % تزهو ببدرين وطلق نسيم % % 26(@)(@@) % وأنت يا بدر اللطيف السنا % % في الجو قف وقفة غير الرقيب % % 27(@)(@@) % ما ابهج النور وما احسنا % % اذا دنا منك لوجه الحبيب % % 28(@)(@@) % % نحو المعالي يبتغيها النصيب % % 29(@)(@@) % فحاز منها جملة وافية % % ما حازها من أحد من قديم % % 30(@)(@@) % وصار يدعى الرجل الداهيه % % في الفكر والمجد وخلق عظيم % % PageV01P231 31(@)(@@) % يا آل مطران لكم ( ندرة % % وأكرم الناس هو النادر % 32(@)(@@) % لكن معاليكم لها كثرة % يعجز أن يحصرها الحاصر % % 33(@)(@@) % من أجلها أمست لكم شهرة % % عم البرايا صيتها الطائر % % 34(@)(@@) % حيث معاليكم غدت قاضيه % % لكم على الناس بضل عميم % % 35(@)(@@) % فراية المجد لكم عاليه % % و ' ندوة ' الشهم عليها زعيم % % 36(@)(@@) % يا من بنى المجد فأعلى البنا % % 37(@)(@@) % اقبل من العبد جميل الثنا % % وإن يكن قصر عن حده % % 38(@)(@@) % ومره ثم احكم به ان ونى % % ما يحكم السيد في عبده % % 39(@)(@@) % إذ أنت بالمنقبة السامية % % قد خصك الله العزيز العليم % % PageV01P232 40(@)(@@) % فاهنأ ودم في عيشة راضيه % % رغم المعادي وسرور الحميم % % PageV01P233 البحر : مجزوء الكامل 1(@)(@@) % من كان يأرق بالهموم % % فقد ارقت من السرور % % 2(@)(@@) % وطربت من صوت يجي % % ء إلي من غرف القصور % % 3(@)(@@) % صوت كأن الغانيا % % اعرنه هيف الخصور % % 4(@)(@@) % ونضحن من ماء الحياة % % ة عليه في شنب الثغور % % 5(@)(@@) % سرى الهموم عن الفؤاد % % يجوف حالكة الستور % % 6(@)(@@) % والعود ينطق باللحون % % ن بلهجتي نم 
ms75	 وزير % % 7(@)(@@) % يرمي به الصوت الرخيم % % م على الدجى لمعات نور % % 8(@)(@@) % ملأ الظلام توقدا % كالكهرباءة في الأثير % % 9(@)(@@) % يحكى الزلال لدى العطا % % أو الثراء لدى الفقير % % 10(@)(@@) % أصغيت منقطعا إلي % % ه عن المواطن والعشير % % PageV01P234 11(@)(@@) % فحسبت نفسي في الجنان % % ن بغير ولدان وحور % % 12(@)(@@) % وطفقت أدكر العرا % % ق فعاد صفوي ذا كدور % % 13(@)(@@) % فرجعت عن ذاك السماع % % وغبت عن ذاك الشعور % % 14(@)(@@) % وذكرت من يبكي هناك % % على بالدمع الغزير % % 15(@)(@@) % تستوقف العجلان ثم % % بالرنين عن المسير % % 16(@)(@@) % وتقول من مضض الفراق % % ق مقال ذي قلب كسير % % 17(@)(@@) % أبنى سر سير الأما % % من الطوارق في خفير % % 18(@)(@@) % ياأم لا تخشي فان الله % % يا أمي مجير % % 19(@)(@@) % ودعي البكاء فإن قل % % بي من بكائك في سعير % % 20(@)(@@) % أعلمت أني في دمش % % ق أجر أذيال الشرور % % PageV01P235 21(@)(@@) % بين الغطارفة الذي % % تخافهم غير الدهور % % 22(@)(@@) % من كل وضاح الجبين % % ن أغر كالبدر المنير % % 23(@)(@@) % حر الشمائل والفعائل % % والظواهر والضمير % % PageV01P236 البحر : طويل 1(@)(@@) % خليلي قوما بي لنشهد للربى % % بجانبي البسفور مهد اسرار % % 2(@)(@@) % أجيلا معي الأفكار فيها فإنها % % مجال عقول للأنام وأفكار % % 3(@)(@@) % خليلي ان العيش في ماء شرشر % اذا الشمس تستعلي وفي ماء خنكار % % 4(@)(@@) % سفوح جبال بعضها فوق بعضها % % مكللة حافاتهن باشجار % % 5(@)(@@) % يروق بجنبيها خرير االرطب فيها كأنه % % تبختر بيضاء الترائب معطار % % 6(@)(@@) % معاهد زرها في الهواجر تلقها % % موشحة فيها برقة اسحار % % 7(@)(@@) % نزلنا بها والشمس من فوق أرسلت % % على منحنى الوادي ذوائب أنوار % % 8(@)(@@) % وقد ظل من بين الغصون شعاعها % % يوقع دينارا لنا جنب دينار % % 9(@)(@@) % كأن التفاف الدوح والنور بينها % % جيوب من الأنوار زرت بأزرار % % 10(@)(@@) % تميل بأسماع إليها وأبصار % % فتأتي بظل في الجوانب موار % % PageV01P237 11(@)(@@) % ترانا اذا ما الطير في الدوح غردت % % 12(@)(@@) % رياض تنسمنا بها الريح ضحوة % فنمت لنا من طيبهن باسرار % % 13(@)(@@) % بلوح بها ثغر الطبيعة باسما % فيفتر منها عن منابت أزهار % % 14(@)(@@) % مشاهد في تلك الربى ومناظر % % تجلت على اطرافها قدرة البارى % % PageV01P238 البحر : بسيط تام 
ms76	 1(@)(@@) % قلبي عليك حليف الوجد يا عود % % كم شنفت أذني منك الأغاريد % 2(@)(@@) % كنت افديتك لو يفدى الذي حكمت % % فيه المقادير أن يلقاه تنكيد % % 3(@)(@@) % فكم بدت نغمات منك مطربة % % هزت بها طربا حتى الجلاميد % % 4(@)(@@) % تعيد يا عود بالأوتار إن نطقت % % ميت المسرة حيا وهو ملحود % % 5(@)(@@) % كأن ارواحنا عند استماعك من % % لطف لهن الاجسام تجريد % % 6(@)(@@) % فكيف نالتك ايدي الدهر كاسرة % % وانت في الدهر بالآذان معبود % % PageV01P239 البحر : خفيف تام 1(@)(@@) % اسمعي لي قبل الرحيل كلاما % % ودعيني أموت فيك غراما % % 2(@)(@@) % هاك صبري خذيه تذكرة لي % % وامنحي جسمي الضنى والسقاما % % 3(@)(@@) % لست ممن يرجو الحياة إذ فا % % رق أحبابه ويخشى الحماما % % 4(@)(@@) % لك يا ظبية الصريمة طرف % شد ما اوسع القلوبا غراما % % 5(@)(@@) % حب ماء الحياة منك بثغر % % طائر القلب حول سمطيه حاما % % 6(@)(@@) % شغل الكاتبين وصفك حتى % % لا دويا ابقوا ولا اقلاما % % 7(@)(@@) % كلما زاد عاذلي فيك عذلا % % زدت في حسنك البديع هياما % % 8(@)(@@) % أفأحظى بزوره منك تشفي % % صدع قلبي ولو تكون مناما % % 9(@)(@@) % رب ليل بالوصل كان ضياء % % ونهار بالهجر كان ظلاما % % 10(@)(@@) % قد شربت السهاد فيه مداما % وتخذت النجوم فيه ندامى % % PageV01P240 11(@)(@@) % ما لقلبي اذا ذكرتك يهفو % % ولعيني تذري الدموع سجاما % % 12(@)(@@) % إن شكوت الهوى تلعثمت حتى % % خلتني في تكلمي تمتاما % % PageV01P241 البحر : وافر تام 1(@)(@@) % وظبي جاء يطلب جلنارا % % يحاكي لون وجنته احمرارا % % 2(@)(@@) % وقد ملك الخلائق ملك أسر % % وأوثق في قلوبهم الإسارا % % 3(@)(@@) % بقد اخجل السمر اعتدالا % % وطرف أوجل البيض اقتدارا % % 4(@)(@@) % فقلت وما الكليم سوى فؤادي % % وقد آنست في خديه نارا % % 5(@)(@@) % فديتك كيف تطلب جلنارا % % وفي خديك أبصر جلنارا % % PageV01P242 البحر : وافر تام 1(@)(@@) % أقول لهم وقد جد الفراق % % رويدكم فقد ضاق الخناق % 2(@)(@@) % رحلتم بالبدور وما رحمتم % % مشوقا لا يبوخ له اشتياق % % 3(@)(@@) % فقلبي فوق ارؤسكم مطار % % ودمعي تحت ارجلكم مراق % % 4(@)(@@) % اقال الله من قود لحاظا % دماء العاشقين بها تراق % % 5(@)(@@) % وابقى اعينا للغيد سودا % ولو نسيت بها البيض الرقاق % % 6(@)(@@) % متى 
ms77	 يصحو الفؤاد وقد أديرت % % عليه من الهوى كأس دهاق % % 7(@)(@@) % وليس الناس الا من تصابي % % لهوج الرامسات بها اختراق % % 8(@)(@@) % كأن لم تصبني فيها كعاب % % ولم يضرب بساحتها رواق % % 9(@)(@@) % فعجت على الطلول بها مكبا % أسير عض ساعده الوثاق % % 10(@)(@@) % حديد بارد في اللوم قلبي % % فليس له اذا طرق انطرق % % PageV01P243 البحر : متقارب تام 1(@)(@@) % فتنت الملائك قبل البشر % % وهامت بك الشمس قبل القمر % % 2(@)(@@) % وسر بك السمع قبل البصر % % وغنى بك الشعر قبل الوتر % % 3(@)(@@) % فانت بحسنك بنت العبر % % 4(@)(@@) % ترف لمرآك روح الغرام % % ويهوى طلوعك بدر التمام % % 5(@)(@@) % ليطلع مثلك في الاحتشام % % ويرقب خطرة هذا القوام % % 6(@)(@@) % لكيما يهب نسيم السحر % % 7(@)(@@) % تميل بقدك خمر الدلال % فيضحك في ميله الاعتدال % % 8(@)(@@) % وفيك ارتقى الحسن عرش الجلال % % ومنه العقول غدت في عقال % % 9(@)(@@) % وكم قد نهاها وكم قد أمر % % 10(@)(@@) % إذا الوجه منك بدا للعيان % % له سجد العشق يرجو الأمان % % PageV01P244 11(@)(@@) % ويخجل من نوره النيران % % ويعنو له جبروت الزمان % % 12(@)(@@) % ويخضع حتى القضا والقدر % % 13(@)(@@) % بك الحسن ألبس ثوب الكمال % % ولو صزروك بلوح المثال % % 14(@)(@@) % لكنت مليكة كل الصور % % 15(@)(@@) % يروح الشتاء وتصحو السما % % ويأتي الربيع بما نمنما % % 16(@)(@@) % فيطلع فوق الثرى انجما % % ويبتسم الزهر بعد النما % % 17(@)(@@) % فانت ابتسامة ذاك الزهر % % 18(@)(@@) % فطرفك بالفتر كم قد روى % % نشيد غرام يهد القوى % % 19(@)(@@) % وما انت شاعرة في الهوى % % ولكنما الشعر فيك انطوى % % 20(@)(@@) % فآية حسنك إحدى الكبر % % PageV01P245 21(@)(@@) % لسانك يسحر في ظرفه % % وجفنك يفتن في ضعفه % % 22(@)(@@) % وقدك يخطر في لطفه % % فيطنب ردفك في وصفه % % 23(@)(@@) % ويوجزه خصرك المختصر % % 24(@)(@@) % سقتك الكعابة صفو الشباب % % وغطى محياك منها نقاب % % 25(@)(@@) % فانت اذا قمت للانسياب % % تبخترت في خفر والكعاب % % 26(@)(@@) % تضيء كعابتها بالخفر % % PageV01P246 البحر : بسيط تام 1(@)(@@) % وشامخ الانف ما ينفك مكتسيا % ثوب التكبر في بحبوحة النادي % % 2(@)(@@) % قد لازم الصمت عيا في مجالسه % % كأنما هو من نواب بغداد % % PageV01P247 البحر : طويل 1(@)(@@) % أيوسف ما إن أنت من فحل هجمة % % ولكن من الشول 
ms78	 الطوالب للفحل % % 2(@)(@@) % لئن كنت تنمى للعطاء فإنه % % عطاء الذي تزكو الورى فيه بالبخل % % 3(@)(@@) % وان كنت قد كفرتني بجهالة % % فبالبهت كم كفرت من مسلم قبلي % % 4(@)(@@) % وانك في تكفيرك الناس كافر % % تهاون بالله الذي جل عن مثل % 5(@)(@@) % رويدك قد كفرت يا وغد مؤمنا % وكذبت فيما تدعى سيد الرسل % % 6(@)(@@) % وأنت امرؤ لم تجهل العلم وحده % % بل اتلجهل ايضا وجهلك بالجهل % % 7(@)(@@) % وانت من الاسلام في كل حالة % % بمنزلة من يهذي وينكق بالبطل % % 8(@)(@@) % ألست الذي اعطى اللئام كرامة ووترت % % عليك القسي الماس ياجعبة النبل % % 9(@)(@@) % فيا علج أقصر عن نهيقك إنه % % أضل كإضلال الخوار من العجل % % 10(@)(@@) % أنزه عنك السيف في قتلك الذي % % تحتم لكن يا مخنث بالنعل % % PageV01P248 البحر : متقارب تام 1(@)(@@) % معارف بغداد قد جاءها % % مدير من الطيش في مسرح % % 2(@)(@@) % حمار ولكنه ناطق % % وطفل ولكنه ملتحى % % 3(@)(@@) % فيا ايها العلم عنها ارتحل % % ويأيها الجهل فيها اسلح % PageV01P249 البحر : بسيط تام 1(@)(@@) % يا ساكنا وهو مشنوق على عمد % % لأنت أبلغ من نادى ومن خطبا % % 2(@)(@@) % كم فيك يا ايها المصلوب من عبر % % للناس حيرن من أملى ومن كتبا % % 3(@)(@@) % اذ قمت تطلب شيئا انت جاهله % % طوعا لمن خان أو سمعا لمن كذبا % % 4(@)(@@) % طالبت بالشرع حتى قد قتلت به % % كذاك من جهل الشئ الذي طلبا % % 5(@)(@@) % ولو اجبت إلى ما انت طالبه % % لاصبح الشرع يدعو الويل والحربا % % 6(@)(@@) % يا ظالم الشعب مظلوما بفعلته % % عليك أم منك يبكي الشعب منتحبا % % 7(@)(@@) % قد قمت للشر لا للشرع منتصبا % % حتى علوت به في الجو منتصبا % % 8(@)(@@) % فاشكر علوك إذ يعلو به وطن % % قد كدت تورده من فعلك العطبا % % 9(@)(@@) % يا مفسدا قام تحت الدين مستترا % % ليجعل الامر في البلدان مضطربا % % 10(@)(@@) % انظر إلى ذلك المصلوب متعضا % فانما قتله في الشرع وجبا % % PageV01P250 11(@)(@@) % وآية الله في التنمزيل قائلة % % من كان يفسد في اوطانه صلبا % % PageV01P251 البحر : طويل 1(@)(@@) % كأني بهذي الأرض قد حان حينها % % فطاحت بابعاد الفضاء شظايا % % 2(@)(@@) % ونادت بأصوات الفناء فجاجها 
ms79	 % % وناحت على أطوادها هملايا % % PageV01P252 البحر : خفيف تام 1(@)(@@) % قسما بالإله عز وجلا % إن قلبي عن حبكم ما تخلى % % 2(@)(@@) % لا ولا عن هواك لي من سلو % طردت مهجتي السلو فولى % % 3(@)(@@) % أنكر العاذلون ثابت حبي % % وكفى شاهدا بدمعي عدلات % % 4(@)(@@) % ما عسى ان يضر انكار شئ % % وهو كالشمس في العيان تجلى % % 5(@)(@@) % عذلوني فما سمعت فقالوا % % انت سال عم حبهم قلت كلا % % 6(@)(@@) % كيف يسلو عن حبكم ذو فؤاد % % قد تلاشى في حبكم واضمحلا % % 7(@)(@@) % لم يزل في الوداد يرقب قلبي % % ذمة فيكم وعهدا والا % 8(@)(@@) % ايها الممتطي متون المعالي % % فائزا من قداحها بالمعلى % % 9(@)(@@) % نسمات من المسرة هبت % % وهلال من السعادة هلا % % 10(@)(@@) % يوم وافى إلى منك كتاب % % فيه آيات فضلك الجم تتلى % % PageV01P253 11(@)(@@) % قيل لي : هاك ما يزيدك شوقا % قلت اهلا بما أتيت وسهلا % % 12(@)(@@) % قال : نلت المنى ، فقلت : جميعا % قال لولا فراقهم قلت لولا % % PageV01P254 البحر : بسيط تام 1(@)(@@) % لا تشك للناس يوما عسرة الحال % % وان ادامتك في هم وبلبالل % % 2(@)(@@) % وجانب اليأس واسلك للرجا طرقا % فالدهر ما بين إدبار وإقبال % % 3(@)(@@) % واركب على صهوات الجد مغتربا % فيما تحاول ذا حل وترحال % % 4(@)(@@) % واطلب على عزه بيض الانوف ولا % % تطلب لعمرك أن تحظى بمفضال % % 5(@)(@@) % لم يبق غير الذي غلت أنامله % % اما باغلال شح أو باقلال % % 6(@)(@@) % كم قد غدوتعلى الايام منتدبا % قوما أضعت بهم شعري وآمالي % % 7(@)(@@) % افعالهم دون ان يعرى الرجاء بها % % لكن أقوالهم أقوال أقيال % % 8(@)(@@) % من كل هي ابن بي لا ثبات له % % جعد اليدين قئول غير مفعال % % 9(@)(@@) % كم بات ذا الحمق خلوا في مضاجعه % % وبات ذو العقل فيها كاسف البال % % 10(@)(@@) % هذا يميس بابراد مفوقة % % وذا يخيط شظايا طمره البالى % % PageV01P255 البحر : بسيط تام 1(@)(@@) % شوقي إليك قريب لا ينائيني % % والصبر عنك بعيد لا يدانيني % % 2(@)(@@) % يا راحلا وفؤادي في حقيبته % % رهنا لديه ولكن غير مضمون % % 3(@)(@@) % تركتني في شجوني للورى مثلا % يميتني الوجد والأشواق تحييني % % 4(@)(@@) % أقفو الملاح لكي أسلو هواك بهم 
ms80	 % % فيرجع الحسن منهم فيك يغريني % % PageV01P256 البحر : مجزوء الكامل 1(@)(@@) % شكرا لفضل ممجد % % أهدي إليه نظيم شعري % % 2(@)(@@) % فاق الاماجد وامتطى % % بالعز صهوة كل فخر % % 3(@)(@@) % اني اختبرت بني الزمان % % جميعهم في عسر ويسر % % 4(@)(@@) % وسبرت غورهم لدى ال % % الحالين من عسر ويسر % % 5(@)(@@) % وبكف تجربتي لهم % % قلبتهم بطنا لظهر % % 6(@)(@@) % فوحق من لأرجوه في % % وقع الخطوب وكل ضر % % 7(@)(@@) % ما ان رأيت بهم فتى % حسن السريرة مثلشكرى % % 8(@)(@@) % المرتقى في المكرمات % % ت إلى المقام المشمخر % % 9(@)(@@) % يرعى الذمار على كلا % % الحالين من سر وجهر % % 10(@)(@@) % ياذا الاخاء المستقر % % ر وذا الوفاء المستمر % % PageV01P257 11(@)(@@) % جاء الكتاب إلى من % % به شفيت غليل صدرى % % 12(@)(@@) % فإليك يا شكري على % % هذا الصنيع عظيم شكري % % PageV01P258 البحر : كامل تام 1(@)(@@) % لمن الديار يلحن في الصحصاح % % لعبت بهن روامس الأرواح % 2(@)(@@) % عبثت بها ايدى البلى فتركنها % % في العين أخفى من دريس نصاح % % 3(@)(@@) % ولقد وقفت بها المطي مسائلا % % شجرات واديها وهن ضواح % % 4(@)(@@) % أقتاف آثارا لهن دوارسا % كانت اليها غدوتي ورواحى % % 5(@)(@@) % لما تبينت المعالم همدا % هطلت مدامع طرفي السفاح % % 6(@)(@@) % فسقاك مرتكز الغمائم صوبه % % غدقا بكل عشية وصباح % % 7(@)(@@) % حي الديار وان تحمل اهلها % % عنها وأمست موحشات بطاح % % 8(@)(@@) % عهدي بها والعيش أخضر ناعم % % والشمل تجمعه يد الأفراح % % 9(@)(@@) % مغنى أنيقا للحسان وروضة % % نبيي بكل عرارة واقاح % % 10(@)(@@) % كم قد لثمت بها المراشف آخذا % بهضيم خصر جال تحت وشاح % % PageV01P259 11(@)(@@) % ولكم لهوت من الحسان بغادة % % لمياء ترشفني شمول الراح % % 12(@)(@@) % هل عائد زمن أتيت مع المها % % ماشئت من لعب به ومزاح % % 13(@)(@@) % قد بت فيه من ضجيع كل غريرة % % رود الشباب من الجراد رداح % % 14(@)(@@) % أيام تحضر بي بمضمار الصبا % % فرس الشبيبة وهي ذات جماح % % 15(@)(@@) % ركضوا بميدان التحاسد خيلهم % % وسبوا من الاعراض غير مباح % % 16(@)(@@) % لبسوا النفاق لهم دروعا واغتدوا % % يتطاعنون من الخنا برماح % % 17(@)(@@) % أضحوا كماة وشاية وسعاية % % ومن الضغائن هم شكاة سلاح % % 18(@)(@@) % كالجاهلية غير أن مغارهم % % في نهب كل خطيئة وجناح % % 19 