ms213	 غز ازآنک %~% در خراسان نه خطیب است کنون نه منبر(@)(@@) 23 کشته فرزند گرامی را گر ناگاهان %~% بیند از بیم خروشید نیارد مادر(@)(@@) 24 آنکه را صدره غز زر ستد و باز فروخت %~% دارد آن جنس که گوئیش خریدست به زر(@)(@@) 25 بر مسلمانان زان نوع کنند استخفاف %~% که مسلمان نکند صد یک از آن باکافر(@)(@@) 26 هست در روم و خطا امن مسلمانان را %~% نیست یک ذره سلامت به مسلمانی در(@)(@@) 27 خلق را زین غم فریادرس ای شاه‌نژاد %~% ملک را زین ستم آزاد کن ای پاک سیر(@)(@@) 28 به خدایی که بیاراست به نامت دینار %~% به خدایی که بیفراخت به فرت افسر(@)(@@) 29 که کنی فارغ و آسوده دل خلق خدا %~% زین فرومایه غز شوم پی غارت‌گر(@)(@@) 30 وقت آنست که یابند ز رمحت پاداش %~% گاه آنست که گیرند ز تیغت کیفر(@)(@@) 31 زن و فرزند و زر جمله به یک حمله چو پار %~% بردی امسال روانشان به دگر حمله ببر(@)(@@) 32 آخر ایران که ازو بودی فردوس به رشک %~% وقف خواهد شد تا حشر برین شوم حشر(@)(@@) 33 سوی آن حضرت کز عدل تو گشتست چو خلد %~% خویشتن زینجا کز ظلم غزان شد چو سقر(@)(@@) 34 هرکه پایی و خری داشت به حیلت افکند %~% چکند آنکه نه پایست مر او را و نه خر(@)(@@) 35 رحم‌کن رحم بر آن قوم که نبود شب و روز %~% در مصیبتشان جز نوحه‌گری کار دگر(@)(@@) 36 رحم‌کن رحم برآن قوم که جویند جوین %~% از پس آنکه نخوردندی از ناز شکر(@)(@@) 37 رحم‌کن رحم بر آنها که نیابند نمد %~% از پس آنکه ز اطلسشان بودی بستر(@)(@@) 38 رحم‌کن رحم بر آن قوم که رسوا گشتند %~% از پس آنکه به مستوری بودند سمر(@)(@@) 39 گرد آفاق چو اسکندر بر گرد ازآنک %~% تویی امروز جهان را بدل اسکندر(@)(@@) 40 از تو رزم ای شه و از بخت موافق نصرت %~% از تو عزم ای ملک 
ms214	 و از ملک‌العرش ظفر(@)(@@) 41 همه پوشند کفن گر تو بپوشی خفتان %~% همه خواهند امان چون تو بخواهی مغفر(@)(@@) 42 ای سرافراز جهانبانی کز غایت فضل %~% حق سپردست به عدل تو جهان را یکسر(@)(@@) 43 بهره‌ای باید از عدل تو نیز ایران را %~% گرچه ویران شد بیرون ز جهانش مشمر(@)(@@) 44 تو خور روشنی و هست خراسان اطلال %~% نه بر اطلال بتابد چو بر آبادان خور(@)(@@) 45 هست ایران به مثل شوره تو ابری و نه ابر %~% هم برافشاند بر شوره چو بر باغ مطر(@)(@@) 46 بر ضعیف و قوی امروز تویی داور حق %~% هست واجب غم حق ضعفا بر داور(@)(@@) 47 کشور ایران چون کشور توران چو تراست %~% از چه محرومست از رافت تو این کشور(@)(@@) 48 گر نیاراید پای تو بدین عزم رکاب %~% غز مدبر نکشد باز عنان تا خاور(@)(@@) 49 کی بود کی که ز اقصای خراسان آرند %~% از فتوح تو بشارت بر خورشید بشر(@)(@@) 50 پادشاه علما صدر جهان خواجه شرع %~% مایه فخر و شرف قاعده فضل و هنر(@)(@@) 51 شمس اسلام فلک مرتبه برهان‌الدین %~% آنکه مولیش بود و شمس و فلک فرمان‌بر(@)(@@) 52 آنکه از مهر تو تازه است چو از دانش روح %~% وانکه بر چهر تو فتنه است بر شمس قمر(@)(@@) 53 یاورش بادا حق عزوجل در همه کار %~% تا در این کار بود با تو به همت یاور(@)(@@) 54 چون قلم گردد این کارگر آن صدر بزرگ %~% نیزه کردار ببندد ز پی کینه کمر(@)(@@) 55 به تو ای سایه حق خلق جگرسوخته را %~% او شفیع است چنان کامت را پیغمبر(@)(@@) 56 خلق را زین حشر شوم اگر برهانی %~% کردگارت برهاند ز خطر در محشر(@)(@@) 57 پیش سلطان جهان سنجر کو پروردت %~% ای چنو پادشه دادگر حق‌پرور(@)(@@) 58 دیده‌ای خواجه آفاق کمال‌الدین را %~% که نباشد به جهان خواجه ازو کاملتر(@)(@@) 59 نیک دانی که چه و تا به کجا داشت برو %~% اعتماد آن شه 
ms215	 دین‌پرور نیکو محضر(@)(@@) 60 هست ظاهر که برو هرگز پوشیده نبود %~% هیچ اسرار ممالک چه ز خیر و چه ز شر(@)(@@) 61 روشن است آنکه بر آن جمله که خور گردون را %~% بود ایران را رایش همه عمر اندر خور(@)(@@) 62 واندر آن مملکت و سلطنت و آن دولت %~% چه اثر بود ازو هم به سفر هم به حضر(@)(@@) 63 با کمال‌الدین ابنای خراسان گفتند %~% قصه ما به خداوند جهان خاقان بر(@)(@@) 64 چون کند پیش خداوند جهان از سر سوز %~% عرضه این قصه رنج و غم و اندوه و فکر(@)(@@) 65 از کمال کرم و لطف تو زیبد شاها %~% کز کمال‌الدین داری سخن ما باور(@)(@@) 66 زو شنو حال خراسان و غزان ای شه شرق %~% که مر او را همه حالست چو الحمد ازبر(@)(@@) 67 تا کشد رای چو تیر تو در آن قوم کمان %~% خویشتن پیش چنین حادثه‌ای کرد سپر(@)(@@) 68 آنچه او گوید محض شفقت باشد ازآنک %~% بسطت ملک تو می‌خواهد نه جاه و خطر(@)(@@) 69 خسروا در همه انواع هنر دستت هست %~% خاصه در شیوه نظم خوش و اشعار غرر(@)(@@) 70 گر مکرر بود ایطا در این قافیتم %~% چون ضروریست شها پرده این نظم مدر(@)(@@) 71 هم بر آن‌گونه که استاد سخن عمعق گفت %~% خاک خون‌آلود ای باد باصفاهان بر(@)(@@) 72 بی‌گمان خلق جگرسوخته را دریابد %~% چون ز درد دلشان یابد از این‌گونه خبر(@)(@@) 73 تا جهان را بفروزد خور گیتی‌پیمای %~% از جهان‌داری ای خسرو عادل بر خور PageV1P0391(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 مست شبانه بودم افتاده بی‌خبر %~% دی در وثاق خویش که دلبر بکوفت در(@)(@@) 2 چون اصطکاک و قرع هوا از طریق صوت %~% داد از ره صماخ دماغ مرا خبر(@)(@@) 3 بر عادتی که باشد گفتم که کیست این %~% گفت آنکه نیست در غم و شادیت ازو گذر(@)(@@) 4 جستم چنان ز جای که جانم خبر نداشت %~% کان دم به پای می روم از عشق یا 
ms216	 به سر(@)(@@) 5 در باز کرد و دست ببوسید و در کشید %~% تنگش چو خرمن گل و تنگ شکر ببر(@)(@@) 6 القصه اندر آمد و بنشست و هر سخن %~% گفت و شنید از انده و شادی و خیر و شر(@)(@@) 7 پس در ملامت آمد کین چیست می‌کنی %~% یزدانت به کناد که کردست خود بتر(@)(@@) 8 یا در خمار مانده‌ای از صبح تا به شام %~% یا در شراب خفته‌ای از شام تا سحر(@)(@@) 9 تو سر به نای و نوش فرو برده‌ای و من %~% خاموش و سرفکنده که هین بوک و هان مگر(@)(@@) 10 دل گرم کرده‌ای ز تف عشق من به سست %~% سردی مکن که گرم کنی همچو دل جگر(@)(@@) 11 باری ز باده خوردن و عشرت چو چاره نیست %~% در خدمت بساط خداوند خواجه خور(@)(@@) 12 صدر زمانه ناصر دین طاهر آنکه هست %~% در شان ملک آیتی از نصرت و ظفر(@)(@@) 13 تا حضرتی ببینی بر چرخ کرده فخر %~% تا مجلسی بیابی از خلد برده فر(@)(@@) 14 بربسته پیش خدمت اسبان رتبتش %~% رضوان میان کوثر و تسنیم را کمر(@)(@@) 15 گفتم که پایمرد و وسیلت که باشدم %~% گفتا که بهتر از کرم او کسی دگر(@)(@@) 16 فردا که ناف هفته و روز سه‌شنبه است %~% روزی که هست از شب قدری خجسته‌تر(@)(@@) 17 روزی چنان که گویی فهرست عشرتست %~% یک حاشیه به خاور و دیگر به باختر(@)(@@) 18 آثار او چو عدت ایام بر قرار %~% و اوقات او چو صورت افلاک بر گذر(@)(@@) 19 بی هیچ شک نشاط صبوحی کند به‌گاه %~% دانی چه کن و گرچه تو دانی خود این قدر(@)(@@) 20 کاری دگر نداری بنشین و خدمتی %~% ترتیب کن هم امشب و فردا به گه ببر(@)(@@) 21 دوش آنچنان که از رگ اندیشه خون چکید %~% نظمی چنان که دانی رفتست مختصر(@)(@@) 22 گر زحمتت نباشد از آن تا ادا کنم %~% آهسته همچنین به همین صورت پرده‌در PageV1P0392(@)(@@)(@@)(@@) || [genre: Q] 
ms217	(@)(@@) 1 نماز شام چو کردم بسیج راه سفر %~% درآمد از درم آن سرو قد سیمین‌بر(@)(@@) 2 ز تف آتش دل وز سرشک دیده شده %~% لب چو قندش خشک و رخ چو ماهش تر(@)(@@) 3 در آب دیده همی گشت زلف مشکینش %~% چو شاخ سنبل سیراب در می احمر(@)(@@) 4 مرا دلی ز غریوش چو اندر آتش عود %~% مرا تنی ز وداعش چو اندر آب شکر(@)(@@) 5 چه گفت گفت نه سوگند خورده‌ای به سرم %~% که هرگز از خط عشق تو برندارم سر(@)(@@) 6 هنوز مدت یک هجر نارسیده به پای %~% هنوز وعده یک وصل نارسیده به سر(@)(@@) 7 بهانه سفر و عزم رفتن آوردی %~% دلت ز صحبت یاران ملول گشت مگر(@)(@@) 8 چه وقت رفتن و هنگام کردن سفرست %~% سفر مکن که شود بر دلم جهان چو سقر(@)(@@) 9 مرا درین غم وتیمار ودرد دل مگذار %~% ز عهد و بیعت و سوگند خویشتن مگذر(@)(@@) 10 وگر به رغم دل من همی بخواهی رفت %~% از آن دیار خبرده مرا وزان کشور(@)(@@) 11 کجاست مقصد و تا چند خواهی آنجا ماند %~% کجا رسیم دگر بار و کی به یکدیگر(@)(@@) 12 چو این بگفت به بر در گرفتمش گفتم %~% که جان جان و قرار دلی و نور بصر(@)(@@) 13 سفر مربی مردست و آستانه جاه %~% سفر خزانه مالست و اوستاد هنر(@)(@@) 14 به شهر خویش درون بی‌خطر بود مردم %~% به کان خویش درون بی‌بها بود گوهر(@)(@@) 15 درخت اگر متحرک شدی ز جای به جای %~% نه جور اره کشیدی و نه جفای تبر(@)(@@) 16 به جرم خاک و فلک در نگاه باید کرد %~% که این کجاست ز آرام و آن کجا ز سفر(@)(@@) 17 ز دست فتنه این اختران بی‌معنی %~% ز دام عشوه این روزگار دون‌پرور(@)(@@) 18 همی به خدمت آن صدر روزگار شوم %~% که روزگار ازو یافتست قدر و خطر(@)(@@) 19 نظام ملکت سلطان و صدر دین خدای %~% خدایگان وزیران وزیر خوب 
