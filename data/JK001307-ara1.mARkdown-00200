ms181	 وقال النسائي ليس بالقوي(@)(@@)(@@)(@@) $ 3578 - عبد الرحمن بن سليمان بن الأصبهاني عن عكرمة قال ابن معين ليس بشيء ووثقه أبو زرعة وغيره(@)(@@)(@@)(@@) $ 3579 - عبد الرحمن بن السفر كذا قيل والصواب يوسف بن السفر متروك(@)(@@)(@@)(@@) $ 3580 - عبد الرحمن بن شريك بن عبد الله القاضي عن أبيه وثق وقال أبو حاتم واه(@)(@@)(@@)(@@) $ 3581 - عبد الرحمن بن صالح الأزدي صدوق قال أبو أحمد الحاكم خولف في بعض حديثه وقال ابن عدي احترق بالتشيع(@)(@@)(@@)(@@) $ 3582 - عبد الرحمن بن ضباب الأشعري عن عبد الرحمن بن غنم قال البخاري فيه نظر(@)(@@)(@@)(@@) $ 3583 - عبد الرحمن بن طلحة الخزاعي عن بعض التابعين مجهول(@)(@@)(@@)(@@) $ 3584 - عبد الرحمن بن عامر الكوفي شيخ للهيثم بن خارجة نكرة لا يعرف PageV02P381(@)(@@)(@@)(@@) $ 3585 - ق / عبد الرحمن بن عبد الله بن عمر العمري عن أبيه تركوه واتهمه بعضهم(@)(@@)(@@)(@@) $ 3586 - خ د ت س / عبد الرحمن بن عبد الله بن دينار المدني وثق وقال ابن معين في حديثه ضعف(@)(@@)(@@)(@@) $ 3587 - عبد الرحمن بن عبد الله المجاشعي عن نافع أبي هرمز ضرب الفلاس على حديثه(@)(@@)(@@)(@@) $ 3588 - عبد الرحمن بن عبد الله بن مسلم عن سعيد بن بزيع ضعفه الدارقطني(@)(@@)(@@)(@@) $ 3589 - عه / عبد الرحمن بن عبد الله بن أبي الزناد مشهور وثق وضعفه النسائي(@)(@@)(@@)(@@) $ 3590 - عه / عبد الرحمن بن عبد الله بن عتبة بن عبد الله بن مسعود المسعودي عن عمرو بن مرة قال ابن نمير ثقة اختلط بآخره وقال ابن حبان كان صدوقا إلا أنه اختلط في آخر عمره وقال آخر كان حسن الحديث(@)(@@)(@@)(@@) $ 3591 - عبد الرحمن بن عبد الله بن عطية عن ابن جريج لا يعرف(@)(@@)(@@)(@@) $ 3592 - عبدالرحمن بن عبدالله الغافقي لا يعرف PageV02P382(@)(@@)(@@)(@@) $ 3593 - خ س / عبد الرحمن بن عبد الله أبو سعيد مولى بني هاشم قال أحمد بن حنبل كثير الخطأ وهو أيقظ من عبد الله بن رجاء(@)(@@)(@@)(@@) $ 3594 - عبد الرحمن بن عبد الصمد الدمشقي متهم(@)(@@)(@@)(@@) $ 3595 - م / عبد الرحمن بن عبد العزيز الأنصاري عن الزهري صدوق وقد لين(@)(@@)(@@)(@@) $ 3596 - د س / عبد الرحمن بن 
ms182	 عبد الحميد المهري عن عقيل وثقه أبو داود السجزي وقال أبو سعيد بن يونس أحاديثه مضطربه(@)(@@)(@@)(@@) $ 3597 - د / عبد الرحمن بن عبد المجيد السهمي لا يعرف كان في أيام مالك(@)(@@)(@@)(@@) $ 3598 - خ س / عبد الرحمن بن عبد الملك بن شيبة أبو بكر الحزامي عن ابن أبي فديك صدوق وقال أبو أحمد الحاكم ليس بالمتين عندهم(@)(@@)(@@)(@@) $ 3599 - عبد الرحمن بن عبيد الحرستاني عن مصعب بن سعد لا يعرف(@)(@@)(@@)(@@) $ 3600 - عبد الرحمن بن عثمان الحاطبي عن أبيه ضعفه أبو حاتم الرازي(@)(@@)(@@)(@@) $ 3601 - د ق / عبد الرحمن بن عثمان أبو بحر البكراوي قال أحمد طرح الناس حديثه(@)(@@)(@@)(@@) $ 3602 - د ت / عبد الرحمن بن عطاء المدني عن ابن المسيب وثقه النسائي وقال خ فيه نظر وقواه أبو حاتم PageV02P383(@)(@@)(@@)(@@) $ 3603 - عبد الرحمن بن علي عن ابن جريج لا يعرف(@)(@@)(@@)(@@) $ 3604 - عبد الرحمن بن عفان عن أبي بكر بن عياش قال ابن معين كذاب(@)(@@)(@@)(@@) $ 3605 - ق / عبد الرحمن بن عمر رسته عن ابن عيينة ثقة يغرب تكلم فيه ابن الفرات(@)(@@)(@@)(@@) $ 3606 - عبد الرحمن بن عمر بن نصر الشيباني دمشقي قال الكتاني اتهم في ابن أبي ثابت(@)(@@)(@@)(@@) $ 3607 - عبد الرحمن بن عمرو بن جبلة عن سلام بن أبي مطيع كذبه غير واحد(@)(@@)(@@)(@@) $ 3608 - خ د س / عبد الرحمن بن غزوان قراد روى عنه الإمام أحمد والناس وكان يحفظ وله مناكير سئل أحمد بن صالح عن حديث لقراد عن الليث عن مالك عن الزهري عن عروة عن عائشة أن رجلا جاء إلى النبي صلى الله عليه وسلم فقال لي مماليك أضربهم . . . فقال هذا حديث موضوع وقال أبو أحمد الحاكم روى عن الليث حديثا منكرا قلت وروى عن يونس بن أبي اسحاق حديثا منكرا في سفر النبي صلى الله عليه وسلم مع عمه إلى الشام يشهد القلب بوضعه(@)(@@)(@@)(@@) $ 3609 - عبد الرحمن بن قارب بن الأسود قال البخاري لا يصح حديثه(@)(@@)(@@)(@@) $ 3610 - عبد الرحمن بن القاسم بن عبد الله العمري قال ابن معين ليس بشيء(@)(@@)(@@)(@@) $ 3611 - عبد الرحمن بن قطامي 
ms183	 عن بعض التابعين قال الفلاس كان كذابا PageV02P384(@)(@@)(@@)(@@) $ 3612 - عبد الرحمن بن قيس الأرحبي مجهول روى عنه هشام بن البريد(@)(@@)(@@)(@@) $ 3613 - عبد الرحمن بن قيس أبو معاوية الزعفراني عن ابن عون قال أبو زرعة كذاب(@)(@@)(@@)(@@) $ 3614 - عبد الرحمن بن أبي قيس عن ابن رفاعة قال البخاري لا يتابع علي حديثه(@)(@@)(@@)(@@) $ 3615 - عبد الرحمن بن كيسان أبو حريز عن أبيه فيه جهالة(@)(@@)(@@)(@@) $ 3616 - عبد الرحمن بن مالك بن مغول عن أبيه والأعمش قال أحمد والدارقطني متروك وقال أبو داود كذاب وقال مرة يضع الحديث(@)(@@)(@@)(@@) $ 3617 - ع عبد الرحمن بن أبي ليلى ثقة إمام ذكره العقيلي في كتابه فأورد قول إبراهيم النخعي قال كان صاحب أمراء(@)(@@)(@@)(@@) $ 3618 - عبد الرحمن بن محمد المدني عن السائب بن يزيد نكرة(@)(@@)(@@)(@@) $ 3619 - عبد الرحمن بن محمد عن توبة بن علوان بخبر كذب في فاطمة(@)(@@)(@@)(@@) $ 3620 - عبد الرحمن بن محمد بن طلحة بن مصرف قال أبو حاتم ليس بقوي له عن أبيه(@)(@@)(@@)(@@) $ 3621 - عبد الرحمن بن محمد بن عبيد الله العرزمي عن أبيه ضعفه الدراقطني(@)(@@)(@@)(@@) $ 3622 - خ م / عبد الرحمن بن محمد المحاربي ثقة مشهور قال ابن معين يروي المناكير عن المجهولين وقال أبو حاتم صدوق يروي عن المجهولين أحاديث منكرة فيفسد حديثه بذلك PageV02P385(@)(@@)(@@)(@@) $ 3623 - عبد الرحمن بن محمد بن الحسن البلخي قال ابن حبان يضع الحديث على قتيبة(@)(@@)(@@)(@@) $ 3624 - عبد الرحمن بن محمد بن أبي بكر بن حزم قال البخاري روى عنه الواقدي عجائب(@)(@@)(@@)(@@) $ 3625 - عبد الرحمن بن محمد بن علوية أبو بكر قاضي بخارى عن تمتام وابن أبي الدنيا وعنه صالح بن أحمد الهمداني وقال لم يكن بصدوق تركت حديثه(@)(@@)(@@)(@@) $ 3626 - عبد الرحمن بن محمد بن منصور الحارثي قال ابن عدي حدث بما لا يتابع عليه(@)(@@)(@@)(@@) $ 3627 - عبد الرحمن بن محمد بن أحمد بن فضالة عن الغظريف حافظ لكنه رافضي مقل(@)(@@)(@@)(@@) $ 3628 - عبد الرحمن بن محمد أبو سبرة المديني متأخر قال أبو أحمد الحاكم له مناكير(@)(@@)(@@)(@@) $ 3629 - عبد الرحمن بن مرزوق الطرسوسي أبو عوف عن عبد 
ms184	 الوهاب ابن عطاء قال ابن حبان كان يضع الحديث(@)(@@)(@@)(@@) $ 3630 - قلت أما سميه البرلسي فقال فيه الدارقطني لا بأس به(@)(@@)(@@)(@@) $ 3631 - عبد الرحمن بن مريح عن جابر وعنه عبيد الله بن المغيرة مجهول(@)(@@)(@@)(@@) $ 3632 - د ت س / عبد الرحمن بن مسعود بن نيار لا يعرف وقد وثقه ابن حبان على أصله PageV02P386 -(@)(@@)(@@)(@@) $ 3633 - عبد الرحمن بن مسلم أبو مسلم الخراساني عن أبي الزبير لا ينبغي الأخذ عنه ظلوم غشوم(@)(@@)(@@)(@@) $ 3634 - عبد الرحمن بن مسلمة عن أبي عبيدة بن الجراح ذكره خ في الضعفاء(@)(@@)(@@)(@@) $ 3635 - عبد الرحمن بن أبي مسلم عن عطية ضعيف(@)(@@)(@@)(@@) $ 3636 - عبد الرحمن بن مسهر قاضي جبل شاكر نفسه قال أبو حاتم متروك(@)(@@)(@@)(@@) $ 3637 - عبد الرحمن بن المظفر الكحال مصري مشهور لينه السلفي في الحديث(@)(@@)(@@)(@@) $ 3638 - د ق / عبد الرحمن بن معاوية أبو الحويرث عن ابن عباس قال ابن معين وغيره لا يحتج به وقال مالك ليس بثقة وروى عنه شعبة(@)(@@)(@@)(@@) $ 3639 - عبد الرحمن بن ملجم ذاك المعثر لا يروى عنه(@)(@@)(@@)(@@) $ 3640 - خ عه / عبد الرحمن بن أبي الموال ثقة مشهور خرج PageV02P387 مع ابن حسن قال أحمد بن حنبل حدثيه في الاستخارة منكر قلت خرجه البخاري وقد قال ابن عدي رواه غير واحد من الصحابة كما رواه ابن أبي الموال(@)(@@)(@@)(@@) $ 3641 - عه / عبد الرحمن بن مغراء أبو زهير عن الاعمش وثقه أبو زرعة وقال ابن المديني ليس بشيء ولينه ابن عدي(@)(@@)(@@)(@@) $ 3642 - س / عبد الرحمن بن مغيث تابعي لم يرو عنه غير أبي مروان والد عطاء(@)(@@)(@@)(@@) $ 3643 - عبد الرمن بن أبي نصر عن أبيه عن علي قال ابن حبان منكر الحديث(@)(@@)(@@)(@@) $ 3644 - عبد الرحمن بن نافع بن جبير الزهري قال الدارقطني مجهول(@)(@@)(@@)(@@) $ 3645 - عبد الرحمن بن نافع بن عبد الحارث لم يرو عنه سوى أبي سلمة(@)(@@)(@@)(@@) $ 3646 - عبد الرحمن بن النعمان بن معبد عن أبيه ضعف وصدقه أبو حاتم(@)(@@)(@@)(@@) $ 3647 - خ م / عبد الرحمن بن نمر عن الزهري تفرد عنه الوليد ابن مسلم ضعفه ابن معين في الزهري وقال 
ms185	 أبو حاتم وغيره ليس بقوي(@)(@@)(@@)(@@) $ 3648 - عبد الرحمن بن هانئ أبو نعيم النخعي عن الثوري قال أحمد ليس بشيء وكذبه يحيى بن معين وقال ابن عدي عامة ما يرويه لا يتابع عليه PageV02P388(@)(@@)(@@)(@@) $ 3649 - عبد الرحمن بن واقد أبو مسلم عن ابن عيينة قال ابن عدي يسرق الحديث(@)(@@)(@@)(@@) $ 3650 - عبد الرحمن بن وردان عن أبي سلمة قال الدارقطني ليس بقوي(@)(@@)(@@)(@@) $ 3651 - عبد الرحمن بن يامين عن أنس قال البخاري وغيره منكر الحديث(@)(@@)(@@)(@@) $ 3652 - عبد الرحمن بن يحيى عن مالك قال ابن دي يحدث بالمناكير(@)(@@)(@@)(@@) $ 3653 - عبد الرحمن بن يحيى بن سعيد الأنصاري لا يعرف وأحسبه الذي قبله(@)(@@)(@@)(@@) $ 3654 - عبد الرحمن بن يحيى بن خلاد الزرقي عن عبد الله بن أنيس لا يصح حديثه(@)(@@)(@@)(@@) $ 3655 - عبد الرحمن بن يحيى العذري عن يونس الأيلي قال أبو أحمد الحاكم لا يعتمد عليه قلت هو الراوي عن مالك(@)(@@)(@@)(@@) $ 3656 - عبد الرحمن بن يحيى الصدفي أخو معاوية يروي عنه هشيم لينه أحمد بن حنبل(@)(@@)(@@)(@@) $ 3657 - س ق / عبد الرحمن بن يزيد بن تميم عن مكحول ضعفه أحمد بن حنبل وابن عدي(@)(@@)(@@)(@@) $ 3658 - عبد الرحمن بن يزيد عن جابر من ثقات الدماشقة أثنى عليه جماعة والعجب من الخباري كيف أورده في الضعفاء وما ذكر PageV02P389 ما يدل على لينه بل قال قال الوليد كان عنده كتاب سمعه وآخر لم يسمعه(@)(@@)(@@)(@@) $ 3659 - عبد الرمن بن يوسف روى عنه ابن أبي فديك قال ابن عدي ليس بالمعروف(@)(@@)(@@)(@@) $ 3660 - عبد الرحن بن يوسف بن خراش الحافظ قال عبدان كان يوصل المراسيل(@)(@@)(@@)(@@) $ 3661 - عبد الرحمن بن يونس أبو مسلم عن ابن عيينة وثق وقال أبو أحمد الحاكم ليس بالمتين(@)(@@)(@@)(@@) $ 3662 - عبد الرحمن مولى سليمان بن عبد الملك عن أنس يقال منكر الحديث(@)(@@)(@@)(@@) $ 3663 - عبد الرحمن العصاب عن أنس وعنه مرجى بن وداع مجهول(@)(@@)(@@)(@@) $ 3664 - عبد الرحمن المكي رأى الزبير(@)(@@)(@@)(@@) $ 3665 - وعبد الرحمن المدني عن أبي هريرة(@)(@@)(@@)(@@) $ 3666 - وعبد الرحمن جليس لمعمر مجهولون روى حفص ابن غياث عن الثالث خبرا منكرا(@)(@@)(@@)(@@) $ 3667 - عبد 
ms186	 الرحمن السدي عن داود بن أبي هند لا يعرف وخبره باطل ذكره العقيلي(@)(@@)(@@)(@@) $ 3668 - م س / عبد الرحمن الأصم قال يحيى بن سعيد القطان كان صاحب قدر PageV02P390(@)(@@)(@@)(@@) $ 3669 عبد الرحمن بن أخي محمد بن المنكدر لا يتابع على حديثه قلت هو كذب رواه العقيلي(@)(@@)(@@)(@@) $ 3670 - عبد الرحيم بن أحمد بن أحمد بن الاخوة سمع النعالي اتهم بتصفح الأوراق في القراءة(@)(@@)(@@)(@@) $ 3671 - عبد الرحيم بن حبيب الفاريابي عن بقية متهم قال ابن حبان كان يضع الحديث(@)(@@)(@@)(@@) $ 3672 - عبد الرحيم بن حماد الثقفي عن الأعمش كان صاحب مناكير(@)(@@)(@@)(@@) $ 3673 - عبد الرحيم بن خالد الأيلي عن يونس لا يعرف ذكره العقيلي(@)(@@)(@@)(@@) $ 3674 - ق / عبد الرحيم بن داود عن بعض التابعين لا يعرف وحديثه منكر(@)(@@)(@@)(@@) $ 3675 - ق عبد الرحيم بن زيد بن الحواري العمي عن أبيه قال البخاري تركوه(@)(@@)(@@)(@@) $ 3676 - عبد الرحيم بن سعيد الأبرص أخو محمد بن المصلوب يروي عن الزهري قال عباس عن ابن معين سمعنا منه ببغداد قلت لم أخبره بعد(@)(@@)(@@)(@@) $ 3677 - عبد الرحيم بن سليمان بن حبان عن أبيه قال الدارقطني في العلل ضعيف(@)(@@)(@@)(@@) $ 3678 - عبد الرحيم بن عمر عن الزهري وعن الزنجي له حديث واحد وهو منكر PageV02P2391(@)(@@)(@@)(@@) $ 3679 - عبد الرحيم بن كردم بن أرطبان عن الزهري مجهول كذا قال أبو حاتم مع كونه يسمي من الرواة عنه أربعة مشاهير(@)(@@)(@@)(@@) $ 3680 - عبد الرحيم بن موسى عن هشيم مجهول(@)(@@)(@@)(@@) $ 3681 - د ت ق / عبد الرحيم بن ميمون عن سهل بن معاذ ضعفه يحيى بن معين وقال أبو حاتم يكتب حديثه(@)(@@)(@@)(@@) $ 3682 - ت عبد الرحيم بن هارون الغساني عن شعبة قال الدارقطني يكذب(@)(@@)(@@)(@@) $ 3683 - عبد الرحيم بن واقد شيخ للحارث بن أبي أسامة ضعفه الخطيب(@)(@@)(@@)(@@) $ 3684 - عبد الرحيم بن يحيى الأدمي عن عثمان بن عمارة في الابدال أتهمه(@)(@@)(@@)(@@) $ 3685 - عبد الرزاق بن عمر الثقفي عن الزهري قال أبو حاتم لا يكتب حديثه(@)(@@)(@@)(@@) $ 3686 - عبد الرزاق بن عمر عن ابن المبارك قال ابن حبان لا يجوز أن يحتج به PageV02P392(@)(@@)(@@)(@@) $ 3687 - ع / عبد الرزاق 
ms187	 بن همام أحد الأئمة الثقات كان عباس العنبري أحد من رحل إليه وقال إنه لكذاب وقال النسائي فيه نظر لمن كتب عنه بآخره وقال ابن عدي في كامله حدث بأحاديث في الفضائل لم يوافق عليها(@)(@@) قلت كان يتشيع وقد قال أحمد إنه عمي في آخر عمره وكان يلقن فيتلقن فسماع من سمع منه بعد العمى لا شيء قال ابن الصلاح وجدت فيما روى الطبراني عن الدبري عنه أحاديث استنكرتها فأحلت أمرها على ذلك قال إبراهيم الحربي مات عبد الرزاق وللدبري سبع سنين(@)(@@) قال الذهبي إنما النكرة في تلك الأخبار من الدبري فإن ابن عدي ذكر الدبري في كامله وقال روى عن عبد الرزاق مناكير قلت وبكل حال لعبد الرزاق أحاديث ينفرد بها قد أنكرت عليه من ذلك الزمان حتى إن أبا حاتم قال يكتب حديثه ولا يحتج به(@)(@@)(@@)(@@) $ 3688 - ق / عبد السلام بن أبي الجنوب عن الزهري قال أبو حاتم متروك(@)(@@)(@@)(@@) $ 3689 - ع / عبد السلام بن حرب الملائي صدوق قال ابن سعد فيه ضعف وقال الدارقطني ثقة حجة PageV02P393(@)(@@)(@@)(@@) $ 3690 - عبد السلام بن أبي حازم عن أنس ثقة قال أبو حاتم يكتب حديثه(@)(@@)(@@)(@@) $ 3691 - د ت س / عبد السلام بن حفص عن عبد الله بن دينار ثقة ولكنه يأتي بغرائب(@)(@@)(@@)(@@) $ 3692 - عبد السلام بن راشد عن عبد الله بن المثنى عن ثمامة فذكر حديث الطير لا يدرى من هذا والحديث منكر(@)(@@)(@@)(@@) $ 3693 - عبد السلام بن صالح روى عنه يزيد بن هارون قال الدارقطني ليس بالقوي(@)(@@)(@@)(@@) $ 3694 - ق / عبد السلام بن صالح أبو الصلت الهروي الشيعي الرجل العابد متروك الحديث قال ابن عدي متهم(@)(@@)(@@)(@@) $ 3695 - عبد السلام بن عبد الله المذحجي عن بعض التابعين إسناد مظلم(@)(@@)(@@)(@@) $ 3696 - عبد السلام بن عبد الحميد إمام جامع حران قال ابن عدي لا أعلم به بأسا وقال أبو الفتح الأزدي تركوه(@)(@@)(@@)(@@) $ 3697 - عبد السلام بن عبد القدوس قال ابن حبان يروي الموضوعات لقي هشام بن عروة(@)(@@)(@@)(@@) $ 3698 - عبد السلام بن عبد الوهاب ابن الشيخ عبد القادر 
ms188	 عن جده مذموم السيرة احترقت كتبه(@)(@@)(@@)(@@) $ 3699 - عبد السلام بن عبيد بن أبي فروة عن ابن عيينة تأخر بنصيبين قال ابن حبان يروي الموضوعات وقال الأزدي لا يكتب حديثه(@)(@@)(@@)(@@) $ 3700 - عبد السلام بن عجلان شيخ لبدل بن المحبر كناه مسلم أبا الخليل وكناه غيره أبا الجليل بالجيم قال أبو حاتم يكتب حديثه PageV02P394(@)(@@)(@@)(@@) $ 3701 - عبد السلام بن علي شيخ للوليد له حديث منكر(@)(@@)(@@)(@@) $ 3702 - عبد السلام بن محمد الحضرمي عن الأعرج قال ابن عدي لا يعرف(@)(@@)(@@)(@@) $ 3703 - عبد السلام بن موسى بن جبير عن أبيه متهم بالرفض له حديث منكر(@)(@@)(@@)(@@) $ 3704 - عبد السلام بن هاشم الأعور بعد المائتين قال أبو حاتم ليس بقوي وقال الفلاس لا أقطع على أحد بالكذب إلا عليه(@)(@@)(@@)(@@) $ 3705 - عبد السلام أبو كيسان مجهول روى عنه محمد بن سعيد القرشي(@)(@@)(@@)(@@) $ 3706 - عبد السلام البجلي عن الزبير بن العوام(@)(@@)(@@)(@@) $ 3707 - وعبد السلام العدني عن الحكم بن أبان مجهولان(@)(@@)(@@)(@@) $ 3708 - عبد الصمد بن جابر الضبي شيخ لأبي نعيم ضعفه أبن معين(@)(@@)(@@)(@@) $ 3709 - د / عبد الصمد بن حبيب الأزدي شيخ لمسلم بن إبراهيم لينه أحمد وقواه غيره(@)(@@)(@@)(@@) $ 3710 - عبد الصمد بن حسان المروزي تركه أحمد بن حنبل وقبله غيره(@)(@@)(@@)(@@) $ 3711 - عبد الصمد بن سليمان الأزرق شيخ لسعدويه قال الدارقطني متروك(@)(@@)(@@)(@@) $ 3712 - عبد الصمد بن عبد الأعلى شيخ للوليد بن مسلم فيه جهالة(@)(@@)(@@)(@@) $ 3713 - عبد الصمد بن علي الهاشمي الأمير تفرد بحديث أكرموا الشهود ولا يصح(@)(@@)(@@)(@@) $ 3714 - عبد الصمد بن مطير عن ابن وهب متروك الحديث PageV02P395(@)(@@)(@@)(@@) $ 3715 - عبد الصمد بن الفضل عن ابن وهب له حديث يستنكر وهو صالح الحديث(@)(@@)(@@)(@@) $ 3716 - عبد الصمد بن موسى الهاشمي أبو إبراهيم قال الخطيب قد ضعفوه(@)(@@)(@@)(@@) $ 3717 - عبد الصمد بن النعمان صدوق مشهور قال النسائي ليس بالقوي(@)(@@)(@@)(@@) $ 3718 - عبد الصمد أبو معمر عن بكر المزني قال أبو حاتم منكر الحديث(@)(@@)(@@)(@@) $ 3719 - عبد العزيز بن أبان عن الثوري هو أبو خالد القرشي متروك متهم(@)(@@)(@@)(@@) $ 3720 - عبد العزيز بن إسحاق البقال بعد الستين والثلاثمائة قال ابن أبي 
ms189	 الفوارس كان له مذهب خبيث ولم يكن في الرواية بذاك(@)(@@)(@@)(@@) $ 3721 - عبد العزيز بن بشير بن كعب قال ابن المديني مجهول(@)(@@)(@@)(@@) $ 3722 - عبد العزيز بن بشير عن ابن عيينة قال أبو حاتم كان لا يصدق(@)(@@)(@@)(@@) $ 3723 - عبد العزيز بن بحر المروزي عن إسماعيل بن عياش بخبر كذب ينظر من ذا(@)(@@)(@@)(@@) $ 3724 - عبد العزيز بن بكار بن عبد العزيز بن أبي بكرة حديثه غير محفوظ(@)(@@)(@@)(@@) $ 3725 - عبد العزيز بن بكر بن الشرود قال الدارقطني هو وأبوه وجده ضعفاء(@)(@@)(@@)(@@) $ 3726 - عبد العزيز بن أبي ثابت هو ابن عمران يأتي(@)(@@)(@@)(@@) $ 3727 - عبد العزيز بن الحارث أبو الحسن التميمي الحنبلي وضع حديثا PageV02P396 أو حديثين في مسند أحمد قال ابن رزقويه كتبوا عليه محضرا بما فعل وكتب فيه الدارقطني وغيره نسأل الله الستر(@)(@@)(@@)(@@) $ 3728 - عبد العزيز بن الحصين بن الترجمان عن الزهري ضعفه يحيى والناس(@)(@@)(@@)(@@) $ 3729 - عبد العزيز بن حكيم عن زيد بن أرقم وثق وقال أبو حاتم ليس بقوي(@)(@@)(@@)(@@) $ 3730 - عه / عبد العزيز بن جريح عن عائشة في الوتر لا يتابع عليه(@)(@@)(@@)(@@) $ 3731 - عبد العزيز بن جوران الصنعاني عن وهب أشار ابن عدي إلى ضعفه(@)(@@)(@@)(@@) $ 3732 - عبد العزيز بن أبي حازم وثق وقد لينه ابن سيد الناس محدث تونس وذكره العقيلي في الضعفاء فلم يحسن وقيل كان يدلس كغيره من الثقات وقال ابن معين ليس هو بثقة في أبيه كذا رواه عنه أحمد بن زهير في تاريخه(@)(@@)(@@)(@@) $ 3733 - ت / عبد العزيز بن ربيعة البناني عن الاعمش صدوق ضعف(@)(@@)(@@)(@@) $ 3734 - عه / عبد العزيز بن أبي رواد ميمون صالح الحديث ضعفه ابن الجنيد وقال ابن حبان روى عن نافع عن ابن عمر نسخة موضوعة(@)(@@)(@@)(@@) $ 3735 - عبد العزيز بن صالح عن ابن لهيعة وكذا(@)(@@)(@@)(@@) $ 3736 - عبد العزيز بن سلمة مجهولان(@)(@@)(@@)(@@) $ 3737 - عبد العزيز بن عبد الله النرمقي الرازي أبو يحيى عن PageV02P397 يحيى البكاء قال أبو حاتم منكر الحديث(@)(@@)(@@)(@@) $ 3738 - عبد العزيز بن عبد الله بن وهب عن هشام بن حسان تكلم فيه ابن عدي(@)(@@)(@@)(@@) $ 3739 - خ د 
ms190	 ت ق / عبد العزيز بن عبد الله الأويسي ثقة مشهور قال أبو داود ضعيف وقال أيضا ثقة(@)(@@)(@@)(@@) $ 3740 - عبد العزيز بن عبد الخالق الكتاني عن أبي يزيد القراطيسي ليس بالقوي(@)(@@)(@@)(@@) $ 3741 - عبد العزيز بن عبد الرحمن البالسي عن خصيف اتهمه أحمد بن حنبل(@)(@@)(@@)(@@) $ 3742 - عبد العزيز بن عبد الملك الشيباني الدمشقي الحافظ تكلم في نقله(@)(@@)(@@)(@@) $ 3743 - عبد العزيز بن عبد الملك عن عطاء الخراساني قال الأزدي متروك(@)(@@)(@@)(@@) $ 3744 - ق / عبد العزيز بن عبيد الله بن حمزة بن صهيب عن وهب بن كيسان وشهر ضعيف قاله أبو حاتم(@)(@@)(@@)(@@) $ 3745 - عبد العزيز بن عقبة بن سلمة بن الأكوع قال البخاري لا يصح حديثه(@)(@@)(@@)(@@) $ 3746 - ع / عبد العزيز بن عمر بن عبد العزيز وثقه جماعة وضعفه أبو مسهر PageV02P398 -(@)(@@)(@@)(@@) $ 3747 - ت / عبد العزيز بن عمران هو ابن أبي ثابت المديني الزهري عن جعفر بن محمد تركوه(@)(@@)(@@)(@@) $ 3748 - عبد العزيز بن عمرو عن جرير بن عبد الحميد فيه جهالة وخبره موضوع(@)(@@)(@@)(@@) $ 3749 - س / عبد العزيز بن عياش المديني تفرد عنه ابن أبي ذئب(@)(@@)(@@)(@@) $ 3750 - عبد العزيز بن فائد عن الحكم بن أبان مجهول(@)(@@)(@@)(@@) $ 3751 - عبد العزيز بن قيس عن عبد الله بن عمرو وعنه ابنه سراج مجهول(@)(@@)(@@)(@@) $ 3752 - عبد العزيز بن محمد بن زبالة قال ابن حبان يأتي بأوابد فبطل الاحتجاج به مدني(@)(@@)(@@)(@@) $ 3753 - ع / عبد العزيز بن محمد الدراوردي صدوق غيره أقوى منه قال أحمد بن حنبل إذا حدث من حفظه يهم ليس هو بشيء وإذا حدث من كتابه فنعم وقال أيضا إذا حدث من حفظه جاء ببواطيل وقال أبو حاتم لا يحتج به(@)(@@)(@@)(@@) $ 3754 - د ق / عبد العزيز بن مسلم المدني عن بعض التابعين استجهل وهو معروف(@)(@@)(@@)(@@) $ 3755 - م متابعة ت ق / عبد العزيز بن المطلب بن عبد الله بن PageV02P399 حنطب عن أبيه قال أبو حاتم صالح للحديث وأخرج له مسلم في الشواهد لا الأصول وانفرد بحديث منكر ذكره العقيلي(@)(@@)(@@)(@@) $ 3756 - عبد العزيز بن أبي معاذ شيخ روى عنه مسلمة بن الصلت مجهول 
ms191	(@)(@@)(@@)(@@) $ 3757 - عبد العزيز بن معاوية القرشي صدوق قال أبو أحمد الحاكم روى عن أبي عاصم ما لا يتابع عليه(@)(@@)(@@)(@@) $ 3758 - عبد العزيز بن النعمان قال البخاري لا يعرف له سماع من عائشة(@)(@@)(@@)(@@) $ 3759 - عبد العزيز بن النعمان عن شعبة مجهول قلت روى عنه علي بن حرب والزعفراني(@)(@@)(@@)(@@) $ 3760 - عبد العزيز بن يحيى المدني عن مالك كذبه إبراهيم بن المنذر وقال أبو حاتم ضعيف وقال أبو زرعة ليس بصدوق وأما الحاكم فقال صدوق لم يتهم في روايته عن مالك(@)(@@)(@@)(@@) $ 3761 - د س / عبد العزيز بن يحيى أبو الأصبغ الحراني عن عيسى ابن يونس قال أبو حاتم صدوق وقال البخاري لا يتابع على حديثه فذكر حديثا واحدا(@)(@@)(@@)(@@) $ 3762 - عبد العزيز بن يحيى شيخ معاصر للثوري مجهول(@)(@@)(@@)(@@) $ 3763 - وعبد العزيز الطائي شيخ لابن عيينة مجهول(@)(@@)(@@)(@@) $ 3764 - عبد العزيز بن يزيد بن رمانة روى عنه قدامة بن موسى قال البخاري لا يصح حديثه(@)(@@)(@@)(@@) $ 3765 - عبد العظيم بن حبيب عن الزبيدي قال الدارقطني ليس بثقة PageV02P400(@)(@@)(@@)(@@) $ 3766 - عبد الغفار بن جابر عن الثوري كذبه الأزدي(@)(@@)(@@)(@@) $ 3767 - عبد الغفار بن الحسن أبو حازم عن سفيان الثوري كذبه الأزدي(@)(@@)(@@)(@@) $ 3768 - عبد الغفار بن القاسم أبو مريم الأنصاري عن عطاء تركوه قال ابن المديني كان يضع الحديث وقيل كان من رؤوس الشيعة(@)(@@)(@@)(@@) $ 3769 - عبد الغفار بن ميسرة شيخ لمبارك بن فضالة مجهول(@)(@@)(@@)(@@) $ 3770 - عبد الغفار المديني عن سعيد بن المسيب لا يعرف(@)(@@)(@@)(@@) $ 3771 - عبد الغفور أبو الصباح الواسطي عن أبي هاشم الرماني قال ابن معين ليس حديثه بشيء وقال ابن حبان كان ممن يضع الحديث(@)(@@)(@@)(@@) $ 3772 - عبد الغني بن سعيد الثقفي شيخ لبكر بن سهل الدمياطي ضعفه ابن يونس(@)(@@)(@@)(@@) $ 3773 - عبد القدوس بن حبيب الكلاعي عن التابعين تركوه(@)(@@)(@@)(@@) $ 3774 - عبد القدوس بن عبد القاهر عن ابن أبي ذئب نكرة والخبر باطل(@)(@@)(@@)(@@) $ 3775 - عبد الكبير بن محمد أبو عمير عن سليمان بن الشاذكوني متهم(@)(@@)(@@)(@@) $ 3776 - عبد الكريم بن الجراح عن يونس بن أبي إسحاق لا يعرف(@)(@@)(@@)(@@) $ 3777 - عبد الكريم بن 
