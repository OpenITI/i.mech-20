ms5801	 : احبس جشاءك ، يا أبا جحيفة ، فإن أكثركم شبعا اليوم أطولكم جوعا يوم القيامة ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 9588 عن أبي جحيفة رضي الله عنه :(@)(@@) | 30 ( أن رسول الله لعن آكل الربا وموكله ) . ( ابن جرير ) . )(@)(@@) PageV17P164(@)(@@)(@@)(@@) $ 9589 عن أبي جحيفة رضي الله عنه :(@)(@@) | 30 ( أن النبي قام في الصلاة ، فلما رفع رأسه من الركوع قال : سمع الله لمن حمده ، ربنا لك الحمد ملء السماوات وملء الأرض ، وملء ما شئت من شيء بعد ، لا مانع لما أعطيت ، ولا معطي لما منعت ، ولا ينفع ذا الجد منك الجد ) يمد بها صوته ) . ( ش ) . )(@)(@@)(@@)(@@) $ 9590 عن أبي جحيفة رضي الله عنه قال :(@)(@@) | 30 ( مر النبي علاى رجل سادل ثوبه في الصلاة فعطفه عليه ) . ( ابن النجار ، ابن جرير ) . )(@)(@@)(@@)(@@) $ 9591 عن أبي جحيفة رضي الله عنه :(@)(@@) | 30 ( أن النبي صلى إلاى عنزة أو شبهها ، والطريق من ورائها ) . ( ش ) . )(@)(@@)(@@)(@@) $ 9592 عن أبي جحيفة رضي الله عنه قال :(@)(@@) | 30 ( رأيت بلالا رضي الله عنه يوذن ، يدور ويتبع فاه هاهنا وهاهنا ، وأصبعاه في أذنيه ، ورسول الله في قبة له حمراء ، فخرج بلال بين يديه بالعنزة ، فركزها في الأبطح ، فصلى رسول الله إليها الظهر والعصر يمر بين يديه الكلب والحمار والمرأة وعليه حلة له حمراء كأني أنظر إلاى بريق ساقيه ) . ( عب ) . )(@)(@@)(@@)(@@) $ 9593 عن أبي جحيفة رضي الله عنه قال :(@)(@@) | 30 ( صليت مع النبي بالأبطح صلاة العصر ركعتين ) . ( ابن النجار ) . )(@)(@@)(@@)(@@) $ 9594 عن أبي جحيفة رضي الله عنه :(@)(@@) | 30 ( أن بلالا رضي الله عنه أذن بمنى ورسول الله ثم مرتين مرتين وأقام مثل ذالك ) . ( أبو الشيخ في الأذان ) . )(@)(@@)(@@)(@@) $ 9595 عن أبي جحيفة رضي الله عنه قال :(@)(@@) | 30 ( كان بلال رضي الله عنه إذا أذن وضع أصبعيه في أذنيه واستدار في أذانه ) . ( ض ) . )(@)(@@)(@@)(@@) $ 9596 عن مسعر عن سلمة بن كهيل عن أبي جحيفة رضي الله عنه قال : PageV17P165(@)(@@) | 30 ( كان يقال : جالس الكبراء ، وخالط العلماء ، وخالل الحكماء ) . ( العسكري ) . )(@)(@@)(@@)(@@) $ 9597 عن أبي جحيفة رضي الله عنه قال :(@)(@@) | 30 ( أمنا رسول الله في سفره الذي ناموا فيه حتى طلعت الشمس 
ms5802	 ، ثم قال : إنكم كنتم أمواتا فرد الله إليكم أرواحكم ، فمن نام عن صلاة أو نسي صلاة ، فليصلها إذا ذكرها وإذا استيقظ ) . ( ش ) . )(@)(@@)(@@)(@@) $ 9598 عن أبي جحيفة رضي الله عنه قال :(@)(@@) | 30 ( جاء رجل إلاى النبي يشكو جاره ، فقال له النبي : اطرح متاعك علاى الطريق أو في الطريق فطرحه ، فجعل الناس يمرون عليه يلعنونه ، فجاء إلاى النبي فقال : يا رسول الله ما لقيت من الناس ما لقيت ، قال : وما لقيت منهم ؟ قال : يلعنونني ، قال : لقد لعنك الله قبل الناس ، قال : فإني لا أعود يا رسول الله ، فجاء الذي شكا إلاى النبي ، فقال له النبي : ارفع متاعك فقد أمنت وكفيت ) . ( هب ) . )(@)(@@)(@@)(@@) $ 9599 عن أبي جحيفة رضي الله عنه :(@)(@@) | 30 ( أن رسول الله لعن الواشمة والمستوشمة ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 9600 عن أبي جحيفة رضي الله عنه قال :(@)(@@) | 30 ( أتينا رسول الله بالأبطح في قبة له حمراء ، فقال : من أنتم ؟ قلنا : بنو عامر ، قال : مرحبا أنتم مني ) . ( ش ) . )(@)(@@)(@@)(@@) $ 9601 عن مالك النخعي عن سلمة بن كهيل عن أبي جحيفة قال :(@)(@@) | 30 ( قال رسول الله : ( جالسوا العلماء ، وسائلوا الكبراء ، وخالطوا الحكماء ) . ( العسكري في الأمثال ) . )(@)(@@)(@@)(@@) $ 9602 عن أبي الدرداء رضي الله عنه أنه قال لرجل :(@)(@@) | 30 ( مررت بين يدي صلاة أخيك وهدمت من عملك بنيان سنة أو سنتين ) . ( كر ) . )(@)(@@) PageV17P166(@)(@@)(@@)(@@) |||| ( مسند أبو جري التميمي ، جابر بن سليم الهجيمي التميمي رضي الله عنه )(@)(@@)(@@)(@@) $ 9603 عن أبي تميمة الهجيمي قال : قال أبو جري جابر رضي الله عنه :(@)(@@) | 30 ( ركبت قعودا لي ، فأتيت مكة في طلب النبي فإذا هو جالس ، فقلت : السلام عليك يا رسول الله قال : وعليك قلت : إنا معشر أهل البادية ، قوم فينا الجفاء ، فعلمني كلاما ينفعني الله به ، قال : اتق الله ، ولا تحقرن من المعروف أو الخير شيئا ، وإياك وإسبال الإزار ، فإنه من المخيلة ، وإن الله لا يحب المختال الفخور ، فقال رجل : يا رسول الله ذكرت إسبال الإزار وقد يكون بساق الرجل القرح ، أو الشيء يستحيي منه ؟ فقال : لا بأس إلاى نصف الساق أو إلاى الكعبين ، إن رجلا 
ms5803	 كان ممن قبلكم لبس بردة فتبختر فيها ، فنظر الله إليه من فوق عرشه ، فمقته ، فأمر الأرض فأخذته ، فهو يتجلجل بين الأرض ، فاحذروا وقائع الله ) . ( أبو نعيم ) . )(@)(@@)(@@)(@@) $ 9604 عن قرة بن موساى عن أبي جري جابر بن سليم الهجيمي قال :(@)(@@) $ 30 ( انتهيت إلاى النبي وهو محتب في بردة له كأني أنظر إلاى هدابها علاى قدميه ، فقلت : يا رسول الله أوصني فقال : اتق الله ولا تحقرن من المعروف شيئا ) . ( ط ، وأبو نعيم ) .(@)(@@) أبو جعفر محمد بن علي رضي الله عنه ) 3 $(@)(@@)(@@)(@@) $ 9605 عن أبي جعفر محمد بن علي رضي الله عنه :(@)(@@) | 30 ( أن رسول الله باع خدمة المدبر ) . )(@)(@@) PageV17P167(@)(@@)(@@)(@@) |||| ( مسند 35 أبي جمعة ، حبيب بن سباع رضي الله عنه )(@)(@@)(@@)(@@) $ 9606 عن أبي جمعة رضي الله عنه :(@)(@@) | 30 ( أن رسول الله صلى المغرب ونسي العصر ، فقال لأصحابه : هل رأيتموني صليت العصر ؟ قالوا : لا يا رسول الله فأمر رسول الله المؤذن فأذن ، ثم أقام ، فصلى العصر ونقض الأولاى ، ثم صلى المغرب ) . ( أبو نعيم وابن وهب ) . )(@)(@@)(@@)(@@) $ 9607 عن خالد بن دريك قال :(@)(@@) | 30 ( قلت لأبي جمعة رجل من الصحابة : حدثنا حديثا سمعته من رسول الله ، قال : نعم ، أحدثك حديثا جيدا : تغدينا مع رسول الله ومعنا أبو عبيدة رضي الله عنه فقال : يا رسول الله هل أحد خير منا ؟ أسلمنا معك ، وجاهدنا معك قال : نعم ، قوم يكونون من بعدي يؤمنون بي ولم يروني ، يجدون كتابا بين لوحين ، فيؤمنون به ويصدقون به ، فهم خير منكم ) . ( حم ، ع ، والباوردي ، وابن قانع ، طب ، ك ، وأبو نعيم ، كر في المتفق ) . )(@)(@@)(@@)(@@) $ 9608 عن أبي جمعة رضي الله عنه قال :(@)(@@) | 30 أنبأنا سعيد بن عبد الرحمن الجمحي ، حدثنا رجل من الأنصار ، ثم من بني سلمة عن أبيه عن جده أبي جهاد ، وكان أبو جهاد من أصحاب رسول الله أن ابنه قال : ( يا أبتاه رأيتم رسول الله وصحبتموه والله لو رأيته لفعلت وفعلت ، فقال : يا بني اتق الله وسدد ، فوالذي نفسي بيده لو رأيتنا معه يوم الخندق وهو يقول : من يذهب فيأتيني بخبرهم جعله 
ms5804	 الله تعالاى رفيقي يوم القيامة ؟ فما قام من الناس أحد ، ثم قالها الثالثة فما قام من الناس أحد من صميم ما بنا من الجوع والعراء ، ثم ناداى يا حذيفة باسمه ، فقال : يا رسول الله والذي نفسي بيده ، ما منعني أن أقوم إلا خشية أن لا آتيك PageV17P168 بخبرهم ، فقال : إذهب ودعا له رسول الله بخير ) . ( ابن عساكر ) . )(@)(@@)(@@)(@@) $ 9609 عن أبي جمعة رضي الله عنه عن أبي الجهم بن الحارث بن الصمة الأسدي قال :(@)(@@) | 30 ( أقبل رسول الله من نحو بئر حميل فلقيه رجل فسلم عليه ، فلم يرد رسول الله حتى أقبل علاى الجدار ، فمسح بوجهه ويديه ثم رد عليه السلام ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 9610 عن أبي جمعة رضي الله عنه عن أبي الجهم قال :(@)(@@) | 30 ( رأيت رسول الله يبول فسلمت عليه ، فلم يرد علي حتى فرغ ، ثم قام إلاى حائط فضرب بيديه عليه فمسح بهما وجهه ، ثم ضرب بيديه علاى الحائط فمسح بهما يديه إلاى المرفقين ، ثم رد علي السلام ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 9611 عن أبي جمعة رضي الله عنه عن ابن حاضر :(@)(@@) | 30 ( أنه صلى علاى جنازة فقال : ألا أخبركم كيف كان رسول الله يصلي علاى الجنازة ؟ كان يقول : ( اللهم إنك خلقتنا ونحن عبادك ، أنت ربنا وإليك معادنا ) . ( الديلمي ) . )(@)(@@)(@@)(@@) $ 9612 عن أبي جمعة رضي الله عنه عن أبي قماش عن عسعس بن سلامة قال :(@)(@@) | 30 ( كنا في الجبانة ومعنا ابن حاضر الأسدي ، فقال رجل من القوم : وددت أن لنا في هاذ الجبان قصرا فيه من الطعام واللباس ما يكفينا حتى الموت ، فقال أبو حاضر : إن رسول الله فقد بعض أصحابه ، فسأل عنه ، فقيل : إنه قد تفرد في بعض هاذه القفران يتعبد ، فبعث إليه ، فأتي به ، قال : ما حملك علاى ما صنعت ؟ قال : يا رسول الله كبر سني ، ورق عظمي ، وقرب أجلي ، فأحببت أن أخلو بعبادة ربي ، فناداى رسول الله بأعلاى صوته وكان إذا أراد أن يعلم الناس أمرا ناداى به ألا إن موطنا من مواطن المسلمين أفضل من عبادة الرجل وحده ستين 
ms5805	 سنة ناداى به ثلاثا ) . )(@)(@@) PageV17P169(@)(@@)(@@)(@@) |||| ( 36 أبو حاضر الأزدي ، عثمان رضي الله عنه )(@)(@@)(@@)(@@) $ 9613 عن شعبة ، عن الأزرق بن قيس ، عن عسعس :(@)(@@) | 30 ( أن رسول الله فقد رجلا ، فسأل عنه فجاء ، فقال : يا رسول الله إني أردت أن آتي هاذا الجبل فأخلو فيه وأتعبد ، فقال رسول الله : يصبر أحدكم ساعة علاى ما يكره في بعض مواطن الاسلام خير من عبادته خاليا أربعين سنة ) . ( هب ) وقال : ورواه حماد بن سلمة عن الأزرق بن قيس عن عسعس عن أبي حاضر ، عن النبي وقال : ستين سنة ) . )(@)(@@)(@@)(@@) $ 9614 عن أبي حماس ، عن عسعس بن سلامة رضي الله عنه قال :(@)(@@) | 30 ( كنا في الجبانة ومعنا أبو حاضر الأزدي ، فقال رجل من القوم : وددت أن لنا في هاذه الجبانة قصرا ، فيه من الطعام واللباس ما يكفينا حتى الموت فقال ، أبو حاضر : إن رسول الله فقد بعض أصحابه ، فسأل عنه ، فقيل له : إنه قد تفرد في بعض هاذه القفران يتعبد ، فبعث إليه فأتي به ، فقال : ما حملك علاى ما صنعت ؟ فقال : يا رسول الله كبرت سني ، ورق عظمي ، وقرب أجلي ، فأحببت أن أخلو بعبادة ربي ، فناداى رسول الله بأعلاى صوته ، وكان إذا أراد أن يعلم الناس أمرا ناداى به فينا : ألا إن موطنا من مواطن المسلمين أفضل من عبادة الرجل وحده ستين سنة ناداى بها ثلاثا ) . ( هب ) . )(@)(@@)(@@)(@@) $ 9615 عن أبي حاضر رضي الله عنه :(@)(@@) | 30 ( أنه صلى علاى جنازة فقال : ألا أخبركم كيف كان رسول الله يصلي علاى الجنازة ؟ كان يقول : ( اللهم إنك خلقتنا ونحن عبادك ، أنت ربنا وإليك معادنا ) . ( الديلمي ) . )(@)(@@) PageV17P170(@)(@@)(@@)(@@) |||| ( مسند 37 أبي حدرد الأسلمي رضي الله عنه )(@)(@@)(@@)(@@) $ 9616 حدثنا أبو خالد الأحمر عن ابن إسحاق عن يزيد بن عبد الله بن أبي قسيط عن القعقاع بن عبد الله بن أبي حدرد الأسلمي عن أبيه قال :(@)(@@) | 30 ( بعثنا رسول الله في سرية إلاى أضم ، فلقينا عامر بن الأضبط فحيا بتحية الاسلام فنزعنا عنه وحمل عليه محلم بن جثامة فقتله ، فلما قتله سلبه بعيرا وأهبا ومسحا كان له 
ms5806	 ، فلما قدمنا جئتا بشأنه إلاى النبي فأخبرناه بأمره ، فنزلت هاذه الآية : { يا أيها الذين آمنوا إذا ضربتم في سبيل الله فتبينوا } ) . ( حم ، وابن المنذر ، طب ) . )(@)(@@)(@@)(@@) $ 9617 حدثنا أبو خالد الأحمر ، عن ابن إسحاق ، عن يزيد بن عبد الله بن أبي قسيط ، عن القعقاع بن عبد الله بن أبي حدرد الأسلمي عن أبيه قال :(@)(@@) | 30 ( بعثنا رسول الله في سرية إلاى أضم ، فلقينا عامر بن الأضبط ، فحيا بتحية الاسلام فنزعنا عنه ، وحمل عليه محلم بن جثامة فقتله ، فلما قتله سلبه بعيرا له وأهبا ومتيعا كان له ، فلما قدمنا جئنا بشأنه إلاى النبي فأخبرناه بأمره ، فنزلت هاذه الآية : { يا أيها الذين آمنوا إذا ضربتم في سبيل الله فتبينوا } . قال ابن إسحاق : فأخبرني محمد بن جعفر ، عن زيد بن ضمرة قال : حدثني أبي وعمي وكانا شهدا حنينا مع رسول الله قالا : صلى رسول الله الظهر ثم جلس تحت شجرة ، فقام إليه الأقرع بن حابس وهو سيد خندف يرد عن ابن محلم ، وقام عيينة بن حصن يطلب بدم عامر بن الأضبط القيسي وكان أشجعيا ، قال : فسمعت عيينة بن حصن يقول : PageV17P171 لأذيقن نساءه من الحزن مثل ما ذاق نسائي ، فقال النبي : تقبلون الدية ؟ فأبوا ، فقام رجل من بني ليث يقال له مكيتل فقال : يا رسول الله والله ما شبهت هاذا القتيل في غرة الاسلام إلا بغنم وردت فرميت فنفر آخرها ، استن اليوم وغير غدا ، فقال النبي : نديه لكم ، خمسون في سفرنا هاذا ، وخمسون إذا رجعنا ، فقبلوا الدية فقالوا : ائتوا بصاحبكم يستغفر له رسول الله ، فجيء به فوصف حليته ، وعليه حلة قد تهيأ فيها للقتل حتى أجلس بين يدي النبي ، فقال : ما اسمك ؟ فقال : محلم بن جثامة فقال النبي بيديه ووصف أنه رفعهما : اللهم لا تغفر لمحلم بن جثامة ، قال : فتحدثنا بيننا أنه إنما أظهر هاذا وقد استغفر له في السر . قال ابن إسحاق : فأخبرني عمرو بن عبيد عن الحسن قال : قال له رسول الله : آمنته بالله ثم قتلته فوالله ما مكث إلا سبع ليال حتى 
ms5807	 مات محلم ، قال : فسمعت الحسن يحلف بالله : لدفن ثلاث مرات ، كل ذالك تلفظه الأرض فجعلوه بين صداى جبل ورضموا عليه بالجحارة فأكلته السباع ، فذكروا أمره لرسول الله ، فقال : أما والله إن الأرض لتطبق علاى من هو شر منه ، ولاكن الله أراد أن يخبركم بحرمتكم ) . ( ش ) . )(@)(@@)(@@)(@@) $ 9618 عن أبي حدرد الأسلمي رضي الله عنه :(@)(@@) | 30 ( أنه استعان رسول الله في نكاح ، فقال : كم أصدقت ؟ قال : مائتي درهم ، فقال : لو كنتم تغرفون من بطحان ما زدتم ) ، ( أبو نعيم في المعرفة ) . )(@)(@@)(@@)(@@) $ 9619 عن إسماعيل بن القعقاع بن عبد الله بن أبي حدرد أنه قال :(@)(@@) | 30 ( تزوج جدي عبد الله بن حدرد امرأة بأربع أواق ، فأخبر ذالك رسول الله ، فقال رسول الله : لو كنتم تنحتون من فناء جبل أو قال : من أحد ما زدتم علاى ذالك ، عندنا نصف صداقها ، قال عبد الله : فانطلقت فجمعتها فأديتها إلى امرأتي ، ثم أنبأت رسول الله فقال : ألم أكن قلت لك : عندنا نصف الصداق ، فلعلك إنما PageV17P172 فعلت ذالك لما كان من قولي قلت : لا يا رسول الله وما كان بي إلا ذالك ) . ( كر ) . )(@)(@@)(@@)(@@) |||| ( مسند 38 أبي حريز رضي الله عنه )(@)(@@)(@@)(@@) $ 9620 عن أبي ليلاى الكندي قال :(@)(@@) | 30 ( سمعت رب هاذه الدار حريزا أو أبا حريز قال : انتهيت إلاى رسول الله وهو يخطب بمنى ، فوضعت يدي علاى رحله ، فإذا ميثرته مسك ضائنة ) . ( أبو نعيم ) . )(@)(@@)(@@)(@@) |||| ( مسند 39 أبي حميد الساعدي ، عبد الرحمن بن سعد(@)(@@) رضي الله عنه ) $(@)(@@)(@@)(@@) $ 9621 عن أبي حميد الساعدي رضي الله عنه قال :(@)(@@) | 30 ( كان رسول الله إذا جلس في الصلاة في الركعتين الأوليين نصب قدمه اليمنى ، وافترش اليسراى ، وأشار بأصبعه التي تلي الابهام ، وإذا جلس في الأخريين أفضاى بمقعدته إلاى الأرض ونصب قدمه اليمنى ) . ( عب ) . )(@)(@@)(@@)(@@) $ 9622 عن أبي حميد الساعدي رضي الله عنه :(@)(@@) | 30 ( أن النبي خرج يوم أحد ، حتى إذا جاوز ثنية الوداع ، فإذا هو بكتيبة خشناء ، قال : من هاؤلاء ؟ قالوا : عبد الله بن أبي في ستمائة من مواليه منع اليهود من بني قينقاع ، قال : وقد 
ms5808	 أسلموا ؟ PageV17P173 قالوا : لا ، يا رسول الله قال : مروهم فليرجعوا ، فإنا لا نستعين بالمشركين علاى المشركين ) . ( ابن النجار ) . )(@)(@@)(@@)(@@) $ 9623 عن أبي حميد رضي الله عنه قال :(@)(@@) | 30 ( جاء رسول الله ابن العلماء من صاحب أيلة بكتاب ، وأهداى له بغلة ، فكتب إليه رسول الله وأهداى له بردا ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) |||| ( 40 أبو دجانة الأنصاري ، سماك بن خرشة(@)(@@) رضي الله عنه ) 3 $(@)(@@)(@@)(@@) $ 9624 عن أنس رضي الله عنه :(@)(@@) | 30 ( أن رسول الله أخذ سيفا يوم أحد فقال : من يأخذ مني هاذا ؟ فبسطوا أيديهم فجعل كل إنسان منهم يقول : أنا أنا ، فقال : من يأخذه بحقه ؟ فأحجم القوم ، فقال سماك أبو دجابة : أنا آخذه بحقه ، فأخذه ففلق به هام المشركين ) . ( ش ) . )(@)(@@)(@@)(@@) $ 9625 عن عكرمة قال :(@)(@@) | 30 ( جاء علي رضي الله عنه بسيفه فقال : خذيه حميدا ، فقال النبي : إن كنت أحسنت القتال اليوم فقد أحسنه سهل بن حنيف ، وعاصم بن ثابت ، والحارث بن الصمة ، وأبو دجانة ، فقال النبي : من يأخذ هاذا السيف بحقه ؟ فقال أبو دجانة رضي الله عنه : أنا ، وأخذ السيف ، فضرب به حتى جاء به قد حناه ، فقال رسول الله : أعطيته حقه ؟ قال : نعم ) . ( ش ) . )(@)(@@)(@@)(@@) $ 9626 عن محمد بن كعب القرظي :(@)(@@) | 30 ( أن عليا رضي الله عنه لقي فاطمة يوم أحد فقال : خذي السيف غير مذموم ، فقال رسول الله : يا علي إن كنت أحسنت القتال اليوم ، فقد أحسنه : أبو دجانة ، ومصعب بن عمير ، والحارث بن الصمة ، وسهل بن حنيف ثلاثة من الأنصار ، ورجل من قريش ) . ( ش ) . )(@)(@@) PageV17P174(@)(@@)(@@)(@@) |||| ( مسند 41 أبي ذر الغفاري رضي الله عنه )(@)(@@)(@@)(@@) $ 9627 عن أبي ذر رضي الله عنه قال :(@)(@@) | 30 ( قال النبي : يا أبا ذر لا تيأس من رجل يكون علاى شر فيرجع إلاى خير فيموت عليه ، ولا تأمن رجلا يكون علاى خير فيرجع إلاى شر فيموت عليه ، ليشغلك عن الناس ما تعلم من نفسك ) . ( ابن السني )(@)(@@)(@@)(@@) $ 9628 عن أبي ذر رضي الله عنه قال :(@)(@@) | 30 ( قال النبي : ( يا أبا ذر بشر الناس أنه من قال : لا إلاه إلا الله دخل الجنة 
ms5809	 ) . ( ط عن أنس رضي الله عنه ) . )(@)(@@)(@@)(@@) $ 9629 عن أبي ذر رضي الله عنه قال :(@)(@@) | 30 ( كان عمر رضي الله عنه مما يأخذ بيد الرجل والرجلين من أصحابه ، فيقول : قم بنا نزداد إيمانا فيذكرون الله عز وجل ) . ( ش ، واللكلائي في السنة ) . )(@)(@@)(@@)(@@) $ 9630 عن أبي ذر رضي الله عنه قال :(@)(@@) | 30 ( قال النبي : ( يا أبا ذر ألا أدلك علاى كنز من كنوز الجنة ؟ لا حول ولا قوة إلا بالله ) . ( ط ، حم ، ن ، ه ، ع ، والروياني حب ، طب ، هب عن أبي ذر ) ، ( حم ، طب عن أبي أمامة رضي الله عنه ) . )(@)(@@)(@@)(@@) $ 9631 عن أبي ذر رضي الله عنه قال :(@)(@@) | 30 ( أوصاني خليلي ، أن أقول : لا حول ولا قوة إلا بالله ) . ( ابن النجار ) . )(@)(@@)(@@)(@@) $ 9632 عن أبي ذر رضي الله عنه :(@)(@@) | 30 ( أن النبي قال لأصحابه : ( أي الناس أغنى ؟ قالوا : أبو سفيان بن حرب ، قال آخر : عبد الرحمان بن عوف ، قال آخر : عثمان بن عفان رضي الله عنه ، فقال النبي : ( أغنى الناس حملة القرآن ، من جعله الله في جوفه ) . ( كر ) . )(@)(@@) PageV17P175(@)(@@)(@@)(@@) $ 9633 عن أبي ذر رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله يا أبا ذر إني لأعرف آية لو أن الناس كلهم أخذوا بها لكفتهم : { ومن يتق الله يجعل له مخرجا ويرزقه من حيث لا يحتسب } ) . ( حم ، ن ، ه ، والدارمي حب ، ض ، ك ، حل ، هب ، ص ) . )(@)(@@)(@@)(@@) $ 9634 عن أبي ذر رضي الله عنه قال :(@)(@@) | 30 ( يكفي من الدعاء مع البر ما يكفي الطعام من الملح ) . ( ش ) . )(@)(@@)(@@)(@@) $ 9635 عن أبي ذر رضي الله عنه قال :(@)(@@) | 30 ( ما من رجل يقول حين يصبح : اللهم ما قلت من قول ، أو حلفت من حلف ، أو نذرت من نذر ، فمشيئتك بين يدي ذالك كله ، ما شئت منه كان ، وما لم تشأ لم يكن ، فاغفره لي ، وتجاوز لي عنه ، اللهم من صليت عليه فصلاتي عليه ، ومن لعنته فلعنتي عليه ، إلا كان في الاستثناء بقية يومه ذالك ) . ( عب ) . )(@)(@@)(@@)(@@) $ 9636 عن أبي ذر رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : ( يا أبا ذر 
ms5810	 ألا أعلمك كلمات إذا قلتهن أدركت من سبقك ، ولا يلحق بك أحد بعدك إلا من أخذ بمثل عملك ؟ تكبر في دبر كل صلاة ثلاثا وثلاثين تكبيرة ، وتحمده ثلاثا وثلاثين تحميدة ، وتسبحه ثلاثا وثلاثين تسبيحة ، وتختمها بلا إلاه إلا الله ، وحده لا شريك له ، له الملك ، وله الحمد ، وهو علاى كل شيء قدير ) . ( حب ، هب ) . )(@)(@@)(@@)(@@) $ 9637 قال الحكيم الترمذي في نوادر الأصول : حدثنا عمرو بن أبي عمرو قال : حدثنا أبو همام الدلال ، عن إبراهيم بن طهمان ، عن عاصم بن أبي النجود ، عن زر بن حبيش ، عن علي بن أبي طالب رضي الله عنه عن رسول الله :(@)(@@) | 30 ( أنه PageV17P176 أتاه جبريل عليه السلام ، فبينا هو عنده ، إذ أقبل أبو ذر رضي الله عنه فنظر إليه جبريل ، فقال : هو أبو ذر ، قال : فقلت : يا أمين الله وتعرفون أنتم أبا ذر ؟ قال : نعم ، والذي بعثك بالحق إن أبا ذر أعرف في أهل السماء منه في أهل الأرض ، وإنما ذالك لدعاء يدعو به كل يوم مرتين ، وقد تعجبت الملائكة منه ، فادع به فاسأله عن دعائه ، فقال رسول الله : يا أبا ذر دعاء تدعو به كل يوم مرتين ؟ قال : نعم ، فدعاك أبي وأمي ، ما سمعته من بشر ، وإنما هو عشرة أحرف ألهمني ربي إلهاما ، وأنا أدعو به كل يوم مرتين ، أستقبل القبلة ، فأسبحه مليا ، وأهلله مليا ، وأحمده وأكبره مليا ، ثم أدعو بتلك عشر كلمات : اللهم إني أسألك إيمانا دائما ، وأسألك قلبا خاشعا ، وأسألك علما نافعا ، وأسألك يقينا صادقا ، وأسألك دينا قيما ، وأسألك العافية من كل بلية ، وأسألك تمام العافية ، وأسألك دوام العافية ، وأسألك الشكر علاى العافية ، وأسألك الغنى عن الناس ، قال جبريل : يا محمد والذي بعثك بالحق نبيا ، لا يدعو أحد من أمتك بهاذا الدعاء إلا غفرت له ذنوبه ، وإن كانت أكثر من زبد البحر ، وعدد تراب الأرض ، ولا يلقاى أحد من أمتك ، وفي قلبه هاذا الدعاء إلا اشتاقت له الجنان ، واستغفر له الملكان ، وفتحت له أبواب الجنة ، ونادت الملائكة : يا ولي الله ادخل أي باب 
ms5811	 شئت ) . )(@)(@@)(@@)(@@) $ 9638 عن أبي ذر رضي الله عنه ، عن النبي قال :(@)(@@) | 30 ( يا أبا ذر ألا أدلك علاى خصلتين ، هما أخف علاى الظهره ، وأثقل في الميزان من غيرهما ؟ عليك بحسن الخلق ، وطول الصمت ، فوالذي نفسي بيده ما يتجمل الخلائق بمثلهم ) . ( ع ، هب ) . )(@)(@@)(@@)(@@) $ 9639 عن أنس ، عن أبي ذر رضي الله عنه قال :(@)(@@) | 30 ( قلت : يا رسول الله أوصني ، قال : أوصيك بحسن الخلق والصمت ، قال : هما أخف الأعمال علاى الأبدان ، وأثقلها في الميزان ) . ( ابن النجار ) . )(@)(@@) PageV17P177(@)(@@)(@@)(@@) $ 9640 عن أبي ذر رضي الله عنه عن النبي قال :(@)(@@) | 30 ( يا أبا ذر لا تدعن منع المعروف شيئا إلا فعلته ، فإذا لم تقدر عليه فكلم الناس وأنت إليهم طليق ، وإذا طبخت مرقة فأكثر ماءها ، واغترف لجيرانك منها ) . ( ابن النجار ) . )(@)(@@)(@@)(@@) $ 9641 عن أبي ذر رضي الله عنه قال :(@)(@@) | 30 ( قلت : يا رسول الله الرجل يعمل الصالح لنفسه ، ويحمده الناس ؟ قال : تلك عاجل بشراى المؤمن ) . ( ط ، حم ، م ، ه ، حب ) . )(@)(@@)(@@)(@@) $ 9642 عن أبي ذر رضي الله عنه ،(@)(@@) | 30 عن النبي في قوله تعالاى : { وأن إلاى ربك المنتهاى } قال : ( لا نكرة في الله عز وجل ) . ( قط في الأفراد ) . )(@)(@@)(@@)(@@) $ 9643 عن أبي ذر رضي الله عنه ، عن النبي قال :(@)(@@) | 30 ( يا أبا ذر كن للعمل بالتقواى أشد اهتماما منك بالعلم ، يا أبا ذر إن الله إذا أراد بعبد خيرا جعل الذنوب بين عينيه ممثلة ، يا أبا ذر إن المؤمن يراى ذنبه كأنه تحت صخرة ، يخاف أن تقع عليه ، والكافر يراى ذنبه كأنه ذباب يمر علاى أنفه ، يا أبا ذر لا تنظر إلاى صغر الخطيئة ، ولاكن انظر إلاى عظم من عصيت ، يا أبا ذر لا يكون الرجل من المتقين حتى يحاسب نفسه أشد من محاسبة الشريك لشريكه ، فيعلم من أين مطعمه ، ومن أين مشربه ، ومن أين ملبسه ؟ أمن حل ذالك ، أم من حرام ؟ ) . ( الديلمي ) . )(@)(@@)(@@)(@@) $ 9644 عن الحسن بن علي أنه قيل له :(@)(@@) | 30 ( إن أبا ذر رضي الله عنه يقول : الفقر أحب إلي من الغنى ، والسقم أحب إلي من الصحة 
ms5812	 ، فقال : رحم الله أبا ذر ، أما أنا فأقول : من اتكل علاى حسن اختيار الله له ، لم يتمن أنه في غير الحالة التي اختار الله له : وهاذا حد الوقوف علاى الرضا بما تصرف به القضاء ) . ( كر ) . )(@)(@@) PageV17P178(@)(@@)(@@)(@@) $ 9645 عن أبي ذر رضي الله عنه ، عن النبي قال :(@)(@@) | 30 ( يا أبا ذر أتراى أن كثرة المال هو الغنى ، وقلة المال هو الفقر ؟ إنما الغنى غنى القلب ، والفقر فقر القلب ، من كان الغنى في قلبه فلا يضره ما لقي من الدنيا ، ومن كان الفقر في قلبه فلا يغنيه ما أكثر له في الدنيا ، وإنما يضر نفسه شحها ) . ( ن ، حب ، طب ، ص ) . )(@)(@@)(@@)(@@) $ 9646 عن أبي ذر رضي الله عنه ، عن النبي قال :(@)(@@) | 30 ( يا أبا ذر أتراى كثرة المال هو الغنى ؟ وتراى قلة المال هو الفقر ؟ ليس كذالك ، إنما الغنى غنى القلب ، والفقر فقر القلب ) . ( ك ) . )(@)(@@)(@@)(@@) $ 9647 عن أبي ذر رضي الله عنه عن النبي قال :(@)(@@) | 30 ( يا أبا ذر إنه لا يضرك من الدنيا ما كان للآخرة ، إنما يضر من الدنيا ما كان للدنيا ) . ( أبو نعيم عن ابن عباس رضي الله عنه ) . )(@)(@@)(@@)(@@) $ 9648 عن أبي ذر رضي الله عنه :(@)(@@) | 30 ( أنه قيل له : إنك امرء ما يبقاى لك ولد ؟ فقال : الحمد لله الذي يأخذهم في دار الفناء ويدخرهم في دار البقاء ) . ( أبو نعيم ) . )(@)(@@)(@@)(@@) $ 9649 عن أبي ذر رضي الله عنه ، عن النبي قال :(@)(@@) | 30 ( يا أبا ذر أقل من الطعام والكلام تكن معي في الجنة ) . ( أبو نعيم عن أنس رضي الله عنه ) . )(@)(@@)(@@)(@@) $ 9650 عن أبي ذر رضي الله عنه قال :(@)(@@) | 30 ( إن الله تعالاى يقول : يا جبريل انسخ من قلب عبدي المؤمن الحلاوة التي كان يجدها ، فيصير العبد المؤمن والها ، طالبا للذي كان يعهد من نفسه ، نزلت به مصيبة لم تنزل به مثلها قط ، فإذا نظر الله إليه علاى تلك الحالة ، قال : يا جبريل رد إلاى قلب عبدي ما نسخت منق فقد ابتليته فوجدته صادقا ، وسأمده من قبلي بزيادة ، وإذا كان عبدا كذابا لم 
ms5813	 يكترث ولم يبال ) . ( كر ) . )(@)(@@) PageV17P179(@)(@@)(@@)(@@) $ 9651 عن أبي ذر رضي الله عنه ، عن النبي قال :(@)(@@) | 30 ( يا أبا ذر لا عقل كالتدبير ، ولا حسب كحسن الخلق ) . ( هب والخرائطي في مكارم الأخلاق ) . )(@)(@@)(@@)(@@) $ 9652 عن أبي ذر رضي الله عنه ، عن النبي قال :(@)(@@) | 30 ( يا أبا ذر بلغني أنك عيرت اليوم رجلا بأمه ، يا أبا ذر ارفع رأسك فانظر ثم اعلم أنك لست بأفضل من أحمر فيها ولا أسود إلا أن تفضله بعمل ، يا أبا ذر إذا غضبت ، فإن كنت قائما فاقعد ، وإن كنت قاعدا فاتكيء ، وإن كنت متكئا فاضطجع ) . ( ابن أبي الدنيا في ذم الغضب ) . )(@)(@@)(@@)(@@) $ 9653 عن أبي ذر رضي الله عنه قال :(@)(@@) | 30 ( كنا نتحدث أن التاجر فاجر ، وفجوره أن يزين سلعته بما ليس فيها ) . ( ابن النجار ) . )(@)(@@)(@@)(@@) $ 9654 عن أبي ذر رضي الله عنه قال :(@)(@@) | 30 ( قلت : يا رسول الله أي الجهاد أفضل ؟ قال : أن يجاهد الرجل نفسه وهواه ) . ( ابن النجار ) . )(@)(@@)(@@)(@@) $ 9655 عن أبي ذر رضي الله عنه قال :(@)(@@) | 30 ( من شرب مسكرا من الشراب فهو رجس رجس رجس ، ورجس صلاته أربعين ليلة ، فإن تاب تاب الله عليه ، وإن عاد في الثالثة أو في الرابعة كان حقا علاى الله أن يسقه من طينة الخبال ) . ( عب ) . )(@)(@@)(@@)(@@) $ 9656 عن طاووس قال :(@)(@@) | 30 ( قال النبي لأبي ذر رضي الله عنه : ( مالي أراك لقا بقا ، كيف بك إذا أخرجوك من المدينة ؟ قال : آتي الأرض المقدسة ، قال : فكيف بك إذا أخرجوك منها ؟ قال : آتي المدينة ، قال : فكيف بك إذا أخرجوك منها ؟ قال : آخذ سيفي فأضرب به ، قال : لا ، ولاكن اسمع وأطع ، وإن كان عبدا أسود ، فلما خرج أبو ذر إلاى الربذة فوجد بها غلاما لعثمان رضي الله عنه أسود ؛ فأذن وأقام ثم قال : تقدم يا أبا ذر ، قال : لا ، إن رسول الله أمرني أن أسمع وأطيع وإن كان عبدا أسود ، فتقدم فصلى خلفه ) . ( عب ) . )(@)(@@) PageV17P180(@)(@@)(@@)(@@) $ 9657 عن أسماء بنت يزيد :(@)(@@) | 30 ( أن أبا ذر الغفاري رضي الله عنه كان يخدم رسول الله ، فإذا فرغ من خدمته أوى 
ms5814	 إلاى المسجد فكان هو بيته يضطجع فيه ، فدخل رسول الله ليلة إلاى المسجد ، فوجد أبا ذر نائما منجدلا في المسجد فركله رسول الله برجله حتى استواى قاعدا ، فقال له رسول الله : ألا أراك نائما فيه ؟ فقال أبو ذر : أين أنام يا رسول الله مالي من بيت غيره ؟ فجلس إليه رسول الله فقال : فكيف أنت إذا أخرجوك منه ؟ قال : إذا ألحق بالشام ، فإن الشام أرض الهجرة والمحشر وأرض الأنبياء ، فأكون رجلا من أهلها ، قال : فكيف أنت إذا أخرجوك من الشام ؟ قال : إذا أرجع إليه فيكون بيتي ومنزلي ، قال : فكيف أنت إذا أخرجوك منه ثانيا ؟ قال : آخذ سيفي فأقاتل حتى أموت ، فكشر إليه رسول الله فأثبته بيده فقال : أدلك علاى ما هو خير من ذالك ؟ قال : بلاى بأبي وأمي يا رسول الله تنقاد لهم حيث ساقوك حتى تلقاني وأنت علاى ذالك ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 9658 عن أبي ذر رضي الله عنه قال :(@)(@@) | 30 ( بينما أنا نائم في المسجد إذ خرج علي رسول الله فضربني برجله ، فقال : ( ألا أراك نائما ) ؟ فقلت : يا رسول الله غلبتني عيني ، قال : ( فكيف تصنع إذا أخرجوك منه ) ؟ قلت : ألحق بالشام ، فإنها أرض المحشر والأرض المقدسة ، قال : ( فكيف تصنع إذا أخرجوك منها ) ؟ قلت : أرجع إلاى مهاجري ، قال : ( فكيف تصنع إذا أخرجوك منها ) ؟ قلت : آخذ سيفي فأضرب به ، قال : أولا تصنع خيرا من ذالك وأقرب ؟ تسمع وتطيع وتنساق معهم حيث ساقوك ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 9659 عن أبي ذر رضي الله عنه قال :(@)(@@) | 30 ( كنت أخدم رسول الله فإذا أنا فرغت أتيت المسجد فاضطجعت فيه ، فأتاني رسول الله ذات يوم وأنا مضطجع في المسجد فغمزني برجله ، فاستويت جالسا ، ثم قال لي رسول الله : كيف تصنع إذا أخرجت منه ؟ قلت : من مسجد رسول الله ؟ فقال رسول الله : PageV17P181 نعم ، قلت : ألحق بأرض الأنبياء ، قال : فكيف تصنع إذا أخرجت منها ؟ قلت : آخذ سيفي فأضرب به من يخرجني ، فضرب بيده علاى منكبي ثم قال : غفرا يا أبا ذر تنقاد معهم حيث قادوك ، وتنساق معهم حيث ساقوك ، ولو 
ms5815	 لعبد أسود ، قال : فلما أنزلت الربذة ، أقيمت الصلاة ، فتقدم رجل أسود علاى بعض صدقاتها ، فلما رآني أخذ ليرجع ويقدمني ، فقلت : كما أنت ، بل أنقاد لأمر رسول الله ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 9660 عن أبي ذر رضي الله عنه قال :(@)(@@) | 30 ( قال له النبي : ( يا أبا ذر أنت رجل صالح ، وسيصييك بعدي بلاء في الله ، فاسمع وأطع ولو صليت وراء أسود ) . ( طس ، وابن عساكر ) . ( حل ) . )(@)(@@)(@@)(@@) $ 9661 عن أبي ذر رضي الله عنه قال :(@)(@@) | 30 ( قال لي رسول الله : ( أراك يا أبا ذر لقا بقا ، كيف بك يا أبا ذر إذا أخرجوك من المدينة ؟ قلت : آتي الأرض المقدسة ، قال : فكيف بك إذا أخرجوك منها ؟ قلت : آخذ سيفي فأضرب به حتى أقتل ، قال : لا ، إسمع وأطع ولو لعبد أسود ) . ( نعيم بن حماد في الفتن ) . )(@)(@@)(@@)(@@) $ 9662 عن أبي ذر رضي الله عنه قال :(@)(@@) | 30 ( قال النبي : ( يا أبا ذر كيف تصنع إذا أخرجت من المدينة ؟ قال : إذا آخذ سيفي فأضرب به من يخرجني ، فقال : غفرا يا أبا ذر ثلاثا بل تنقاد معهم حيث قادوك ، وتنساق معهم حيث ساقوك ، ولو لعبد أسود ) . ( حم ، كر ) . )(@)(@@)(@@)(@@) $ 9663 عن بهز بن حكيم عن أبيه عن جده :(@)(@@) | 30 ( أن رسول الله قال لأبي ذر رضي الله عنه : ( يا أبا ذر إذا رأيت البناء قد بلغ سلعا فعليك بالشام ، قلت : فإن PageV17P182 حيل بيني وبين ذاك ، أفأضرب بسيفي من حال دوني وبين ذاك ؟ قال : لا ، ولاكن اسمع وأطع ولو لعبد حبشي مجدع ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9664 عن أبي ذر رضي الله عنه قال :(@)(@@) | 30 ( قال انبي : ( يا أبا ذر هل تدري أين تذهب الشمس إذا غابت ؟ فإنها تذهب حتى تأتي العرش فتسجد بين يدي ربها عز وجل فتستأذن في الرجوع فيأذن لها وكأنها قد قيل لها : ارجعي من حيث جئت ، فترجع إلاى مطلعها فذالك مستقرها ، ثم قرأ : { والشمس تجري لمستقر لها } ) . ( ط ، حم ، خ ، م ، د ، ن : حسن صحيح ، ن ، حب ) . )(@)(@@)(@@)(@@) $ 9665 عن أبي ذر رضي الله عنه قال :(@)(@@) | 30 ( قال النبي : يا أبا ذر 
ms5816	 أتدري أين تغرب هاذه ؟ فإنها تغرب في عين حمئة ) . ( ك ) . )(@)(@@)(@@)(@@) $ 9666 عن أبي ذر رضي الله عنه قال :(@)(@@) | 30 ( كنا مع النبي في المسجد عند غروب الشمس فقال : أتدري أين تغرب الشمس ؟ قلت : الله ورسوله أعلم ، قال : تذهب حتى تسجد تحت العرش عند ربها ، وتستأذن في الرجوع فيؤذن لها ، ويوشك أن تستأذن فلا يؤذن لها حتى تستشفع وتطلب ، فإذا طال عليها قيللها : اطلعي مكانك ، فذالك قوله : { والشمس تجري لمستقر لها ذالك تقدير العزيز العليم } ) . ( أبو نعيم ) . )(@)(@@)(@@)(@@) $ 9667 عن أبي ذر رضي الله عنه قال :(@)(@@) | 30 ( قال له النبي يا أبا ذر إعقل ما أقول لك : إن المكثرين هم الأقلون يوم القيامة إلا من قال كذا وكذا ، إعقل ما أقول لك يا أبا ذر إن الخيل في نواصيها الخير إلاى يوم القيامة ، وإن الخير في نواصي الخيل ) . ( حل ) . )(@)(@@) PageV17P183(@)(@@)(@@)(@@) $ 9668 عن غزوان بن أبي حاتم قال :(@)(@@) | 30 ( بينا أبو ذر رضي الله عنه عند باب عثمان رضي الله عنه لم يؤذن له ، إذ مر به رجل من قريش فقال : يا أبا ذر ما يجلسك هاهنا ؟ قال : يأباى هاؤلاء أن يأذنوا لي ، فدخل الرجل فقال : يا أمير المؤمنين ما بال أبي ذر علاى الباب لا يؤذن له ، فأمر فأذن له ، فجاء حتى جلس ناحية القوم ، وميراث عبد الرحمان بن عوف رضي الله عنه يسم ، فقال عثمان لكعب : يا أبا إسحاق أرأيت المال إذا أدي زكاته هل يخشاى علاى صاحبه فيه تبعة ؟ قال : لا ، فقام أبو ذر ومعه عصا فضرب بها بين أذني كعب ، ثم قال : يا ابن اليهودية أنت تزعم أنه ليس حق في ماله أدى الزكاة ، والله تعالاى يقول : { ويؤثرون علاى أنفسهم ولو كان بهم خصاصة } ، والله تعالاى يقول : { ويطعمون الطعام على حبه مسكينا ويتيما وأسيرا } ، والله تعالاى يقول : { وفي أموالهم حق معلوم للسائله والمحروم } ، فجعل يذكر نحو هاذا من القرآن ، فقال عثمان للقرشي : إنما نكره أن نأذن لأبي ذر من أجل ما تراى ) . ( هب ) . )(@)(@@)(@@)(@@) $ 9669 عن أبي ذر رضي الله عنه 
ms5817	 قال :(@)(@@) | 30 ( يا رسول الله ذهب بالأجور أصحاب الدثور ، ونصلي ويصلون ، ونصوم ويصومون ولهم فضول أموال يتصدقون بها وليس لنا ما نتصدق ، فقال رسول الله : ( يا أبا ذر ألا أعلمك كلمات تقولهن تلحق من سبقك ، ولا يدركك إلا من أخذ بعملك ؟ قال : بلاى يا رسول الله قال : تكبر دبر كل صلاة ثلاثا وثلاثين ، وتسبح ثلاثا وثلاثين ، وتحمد ثلاثا وثلاثين ، وتختم بلا إلاه إلا الله وحده لا شريك له ، له الملك وله الحمد وهو علاى كل شيء قدير ، PageV17P184 فأخبر الآخرون بذالك فأتوا رسول الله فقالوا : يا رسول الله إنهم قد قالوا مثل ما قلنا ، فقال رسول الله : ذلك فضل الله يؤتيه من يشاء ، وعلاى كل نفس في كل يوم صدقة : فضل بصرك للمنقوص بصره صدقة ، وفضل سمعك للمنقوص سمعه صدقة ، وفضل شدة ذراعيك للضعيف لك صدقة ، وفضل شدة ساقيك للملهوف صدقة ، وإرشادك الضال صدقة ، وإرشادك سائلا أين فلان فأرشدته لك صدقة ، ورفعك العظام والحجر عن طريق المسلمين لك صدقة ، وأمرك بالمعروف ونهيك عن المنكر لك صدقة ، ومباضعتك أهلك لك صدقة ) . ( خ في تاريخه ، ل ، طس ، كر ، وسنده حسن ) . )(@)(@@)(@@)(@@) $ 9670 عن أبي ذر رضي الله عنه قال :(@)(@@) | 30 ( قال له النبي : ( يا أبا ذر ألا أعلمك كلمات تقولهن تلحق من سبقك ، ولا يدركك إلا من أخذ بعملك : تكبر دبر كل صلاة ثلاثا وثلاثين وتسبح ثلاثا وثلاثين ، وتحمد ثلاثا وثلاثين ، وتختم بلا إلاه إلا الله وحده لا شريك له ، له الملك وله الحمد وهو علاى كل شيء قدير ؛ وعلاى كل نفس في كل يوم صدقة ، فضل بصرك للمنقوص بصره صدقة ، وفضل سمعك للمنقوص له سمعه صدقة ، وإرشادك الضال صدقة ، وإرشادك سائلا أين فلان ؟ فأرشدته لك صدقة ، ورفعك العظام والحجر عن طريق المسلمين لك صدقة ، وأمرك بالمعروف ونهيك عن المنكر لك صدقة ، ومباضعتك أهلك صدقة ) . ( خ في التاريخ ، طس ، وابن عساكر وسنده حسن ، وروى ( د ) صدره إلاى قوله : قدير ، وزاد : غفرت له ذنوبه ولو كانت مثل زبد البحر ) . )(@)(@@)(@@)(@@) $ 9671 عن أبي ذر رضي الله 
ms5818	 عنه :(@)(@@) | 30 ( أن رسول الله قال له : ( كيف تراى جعيلا ؟ قلت : مسكينا كشكله من الناس قال : فكيف تراى فلانا ؟ قلت : سيدا من السادات ، قال : فجعيل خير من مثل هاذا ملء الأرض ، قلت : يا رسول الله ففلان هاكذا وأنت تصنع به ما تصنع ؟ قال : إنه رأس قومه فأتألفهم ) . ( أبو نعيم ) . )(@)(@@) PageV17P185(@)(@@)(@@)(@@) $ 9672 عن أبي ذر رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : ( يا أبا ذر إن أمامك عقبة كؤودا لا يقطعها إلا كل مخف ، قال يا رسول الله أمنهم أنا ؟ قال : إن لم يكن عندك قوت ثلاثة أيام فأنت منهم ) . ( ابن عساكر ) . )(@)(@@)(@@)(@@) $ 9673 عن رجل من أهل الربذة يقال له : عبد الرحمان أو أبو عبد الرحمان قال :(@)(@@) | 30 ( أتاى رجل أبا ذر رضي الله عنه يسأله ، فأعطاه شيئا ، فقيل له : إنه غني ، قال : وما أحفل أن يجيء يوم القيامة يخمش وجهه ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 9674 عن أبي ذر رضي الله عنه قال :(@)(@@) | 30 ( انظر ما تسألني ، فإنك لا تسألني عن شيء إلا زادك الله به بلاء ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9675 عن أبي ذر رضي الله عنه قال :(@)(@@) | 30 ( أرسل إلي النبي في مرضه الذي توفي فيه ، فأتيته فوجدته نائما ، فأكببت عليه ، فرفع يده فالتزمني ) . ( ع ) . )(@)(@@)(@@)(@@) $ 9676 عن أبي ذر رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : يا أبا ذر إنه سيكون بعدي أمراء يميتون الصلاة ، فصل الصلاة لوقتها ، فإن صليت لوقتها ، كانت لك نافلة ، وإلا كنت قد أحرزت صلاتك ) . ( م ، ت ) . )(@)(@@)(@@)(@@) $ 9677 عن أبي العالية قال :(@)(@@) | 30 ( سألت عبد الله بن الصامت وهو ابن أخ أبي ذر عن الأمراء إذا أخروا الصلاة ، فضرب ركبتي وقال : سألت أبا ذر رضي الله عنه عن ذالك ؟ ففعل بي كما فعلت بك ، وضرب ركبتي وقال : إنه سأل رسول الله ؟ ففعل به كما فعل بي وضرب ركبته كما ضرب ركبتي ، وقال رسول الله : ( صل الصلاة لوقتها ، فإن أدركتم معهم فصلوا ، ولا يقولن أحدكم : إني قد صليت فلا أصلي ) . ( عب ) . )(@)(@@)(@@)(@@) $ 9678 عن عبد الله بن الصامت قال :(@)(@@) | 30 ( قال 
ms5819	 أبو ذر رضي الله عنه : يقطع PageV17P186 الصلاة الكلب الأسود ، والمرأة الحائض ، فقلت لأبي ذر رضي الله عنه : فما بال الكلب الأسود ؟ قال : أما إني قد سألت رسول الله عن ذالك ؟ قال : إنه شيطان ) . ( عب ، م ، د ، ت ، ن ، ه ) . )(@)(@@)(@@)(@@) $ 9679 عن أبي ذر رضي الله عنه قال :(@)(@@) | 30 ( رخص في مسحة السجود وتركها خير من مائة ناقة سوداء العين ) . ( عب ) . )(@)(@@)(@@)(@@) $ 9680 عن أبي ذر رضي الله عنه قال :(@)(@@) | 30 ( كنا مع رسول الله في مسير فأراد بلال رضي الله عنه أن يؤذن ، فقال له رسول الله : أبرد ، ثم أراد أن يؤذن ، فقال : أبرد حتى رأينا فيء التلول ، ثم أذن فصلى الظهر ، ثم قال : إن شدة الحر من فيح جهنم ، فإذا اشتد الحر فأبردوا بالصلاة ) . ( ش ) . )(@)(@@)(@@)(@@) $ 9681 عن أبي ذر رضي الله عنه قال :(@)(@@) | 30 ( من أقبل ليشهد الصلاة فأقيمت وهو بالطريق فلا يسرع ، ولا يزيد علاى هينة مشيته الأولاى ، فما أدرك فليصل مع الامام ، وما لم يدرك فليتمه ، ولا يمسح إذا صلى وجهه ، فإن مسح فواحدة ، وإن يصبر عنها خير له من مائة ناقة سوداء الحدق ) . ( عب ) . )(@)(@@)(@@)(@@) $ 9682 عن أبي ذر رضي الله عنه قال :(@)(@@) | 30 ( دخلت علاى رسول الله وهو في المسجد فقال لي : يا أبا ذر صليت ؟ قلت : لا ، قال : فقم فصل ركعتين ) . ( ش ) . )(@)(@@)(@@)(@@) $ 9683 عن أبي ذر رضي الله عنه قال :(@)(@@) | 30 ( اغتسلوا يوم الجمعة ولو كأسا بدينار ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 9684 عن أبي سلمة بن عبد الرحمن بن عوف قال :(@)(@@) | 30 ( كان أبو ذر الغفاري رضي الله عنه جالسا إلاى جنب أبي بن كعب يوم الجمعة ورسول الله يخطب ، فتلا رسول الله آية لم يكن أبو ذر سمعها ، فقال أبو ذر لابي رضي الله عنه : متى PageV17P187 أنزلت هاذه الآية ؟ فلم يكلمه ، فلما أقيمت الصلاة ، قال له أبو ذر : ما منعك أن تكلمني حين سألتك ؟ فقال له أبي : إنه ليس لك من جمعتك إلا ما لغوت ، فانطلق أبو ذر إلاى رسول الله فأخبره ، فقال : صدق أبي ، فقال أبو 
ms5820	 ذر : أستغفر الله وأتوب إليه ، فقال رسول الله : اللهم إغفرح لاءبي ذر وتب عليه ) . ( الروياني والديلمي ) . )(@)(@@)(@@)(@@) $ 9685 عن عبيد بن عمير قال :(@)(@@) | 30 ( قلت لأبي ذر رضي الله عنه : أوصني ، فقال : سألت رسول الله كما سألتني ، فقال : من صلى الضحاى ركعتين لم يكتب من الغافلين ، ومن صلى أربعا كتب من العابدين ، ومن صلى ستا لم يلحقه ذالك اليوم ذنب ، ومن صلى ثمانيا كتب من القانتين ، ومن صلى اثنتي عشرة ركعة بناى الله تبارك وتعالاى له بيتا في الجنة ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 9686 عن أبي ذر رضي الله عنه قال :(@)(@@) | 30 ( قال النبي : ( يا أبا ذر إذا صمت من الشهر ثلاثة أيام فصم : ثلاث عشرة ، وأربع عشرة ، وخمس عشرة ) . ( ط ، ت : حسن ، ن ، ق ) . )(@)(@@)(@@)(@@) $ 9687 عن سلمة بن نباتة المحاربي قال :(@)(@@) | 30 ( لقينا أبا ذر رضي الله عنه فسأله رجل عن رجل يصوم الدهر إلا الفطر والأضحاى ، فقال : لم يصم ولم يفطر ، فعاوده فقال مثل ذالك ، فسأله بعض القوم : كيف تصوم ؟ قال : أطمع من ربي أن أصوم الدهر كله ، قال : فهاذا الذي عبت علاى صاحبي ، قال : كلا ، أصوم من كل شهر ثلاثة أيام ، وأطمع من ربي أن يجعل لي مكان كل يوم عشرة أيام ، وذالك صوم الدهر كله ، وذالك بأن الله تعالاى قال : { من جاء بالحسنة فله عشر أمثالها } ) . ( ابن جرير ) . )(@)(@@) PageV17P188(@)(@@)(@@)(@@) $ 9688 عن أبي ذر رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : صيام ثلاثة أيام من كل شهر كصيام السنة كلها ، قال : وصدق الله ورسوله في كتابه فقال : { من جاء بالحسنة فله عشر أمثالها } ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 9689 عن أبي ذر رضي الله عنه :(@)(@@) | 30 ( أنه دعي إلاى الطعام فقال : إني صائم ، ثم دعي بعد ذالك فأكل ، فقيل له ، فقال : إني أصوم ثلاثة أيام من كل شهر فذالك صوم الدهر ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 9690 عن أبي ذر رضي الله عنه :(@)(@@) | 30 ( أن النبي أمر بصيام ثلاث عشرة ، وأربع عشرة ، وخمس عشرة ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 9691 عن أبي ذر رضي الله عنه قال :(@)(@@) | 30 ( من 