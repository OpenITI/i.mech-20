ms41	 % ورجليه سلم بين حبلي مشاطن % 58(@)(@@) % يوزع بالأمراس كل عملس % من المطعمات الصيد غير الشواحن % 59(@)(@@) % معيد قمطر الرجل مختلف الشبا % % شرنبث شوك الكف شثن البراثن % 60(@)(@@) % يمر إذا حل مر مقزع % عتيق حداه أبهر القوس جارن % PageV01P132 61(@)(@@) % تؤازره صي على الصيد همها % % تفارط أحراج الضراء الدواجن % 62(@)(@@) % فأرسلها رهوا ، وسمى ، كأنها % % يعاسيب ريح عارضات الجواشن % 63(@)(@@) % وولى كنجم الرجم بعد عداده % % 64(@)(@@) % ملا بائصا ، ثم اعترته حمية % على تشحة من ذائد غير واهن % 65(@)(@@) % يهز سلاحا لم يرثه كلالة % يشك به منها غموض المغابن % 66(@)(@@) % يساقطها تترى بكل خميلة % كطعن البيطر الثقف رهص الكوادن % 67(@)(@@) % عدلن عدول اليأس ، وافتج يبتلي % % أفانين من أهلوب شد مماتن % 68(@)(@@) % فأصبح محبورا تخط ظلوفه % كما اختلفت بالطرق أيدي الكواهن % 69(@)(@@) % ويلقي نقا الحنءتين بروقه % تناويط أولاج كخيم الصيادن % 70(@)(@@) % أنا ابن أباة الضيم من آل مالك % وإن مالك كانت كرام المعادن % PageV01P133 71(@)(@@) % ذوي المأثرات الأوليات واللهى % % قديما ، وأكفاء العدو المزابن % 72(@)(@@) % وأهل الأتى اللاتي على عهد تبع % على كل ذي مال عزيب وعاهن % 73(@)(@@) % وأفلجهم في كل يوم كريهة % كرام الفحول واعتيام الحواصن % 74(@)(@@) % وطعنهم الأعداء شزرا ، وإنما % % يسام ويقني الخسف من لم يطاعن % 75(@)(@@) % هم منعوا النعمان يوم رؤية % من الماء في نجم من القيظ حاتن % 76(@)(@@) % وهم تركوا مسعود نشبة مسندا % ينوء بخطار من الخط مارن % 77(@)(@@) % وهم فاز ، لما خطت الأرض ، سهمهم % على المستوي منها ورحب المعاطن % 78(@)(@@) % بنو مالك قومي الليان عروضهم % % لمن خالطوا إلا لغير الملاين % 79(@)(@@) % بنو الحرب تذكي شدة العصب نارهم % إذا العصب دانى بين أهل الضغائن % 80(@)(@@) % إذا قيل بالغماء قد بردوا حموا % % على الضرس لا فعل السؤوم المداهن % PageV01P134 81(@)(@@) % وأي أناس وازنوا من عدوهم % على عهد ذي القرنين ما لم نوازن % 82(@)(@@) % هل المجد إلا السؤدد العود واللها % % ورأب الثأى والصبر عند المواطن % 83(@)(@@) % وحي كرام قد هنأنا جربة % ومرت لهم نعماؤنا بالأيامن % 84(@)(@@) % تلين واسترخت خطور الحيا به % ولولا عوالينا نشا غير لائن 
ms42	 % 85(@)(@@) % وما أنا بالراضي بما غيره الرضا % % ولا المظهر الشكوى ببعض الأماكن % 86(@)(@@) % ولا أعرف النعمى علي ولم تكن % وأعرف فصل المنطق المتغابن % PageV01P135 البحر : وافر تام 1(@)(@@) % أمن دمن بشاجنة الحجون % عفت منها المعارف منذ حين % 2(@)(@@) % وضنت بالكلام ، ولم تكلم % بكيت ، وكيف تبكي للضنين % 3(@)(@@) % وندى الماء جفن العين حتى % % ترقرق ، ثم فاض من الجفون % 4(@)(@@) % كما هملت وسال من الأواتي % % دموع النكس من وشل معين % 5(@)(@@) % منازل ما ترى الأنصاب فيها % % ولا حفر المبلي للمنون % 6(@)(@@) % ولا أثر الدوار ولا المآلي % % ولكن قد ترى أرب الحصون % 7(@)(@@) % عفت إلا أياصر أو نئيا % محافرها كأسرية الإيضين % 8(@)(@@) % وأخرج ، أمه لسواس سلمى % % لمعفور الضرا ضرم الجنين % 9(@)(@@) % تنكر رسمها إلا بقايا % % جلا عنها جدا همع هتون % 10(@)(@@) % كآثار النؤور له دخان % أسف متون مقترح رصين % PageV01P136 11(@)(@@) % كأن حطام قيض الصيف فيه % فراش صميم أقحاف الشؤون % 12(@)(@@) % وقفت بها فهيض جوى أطاعت % له زفرات مغترب حزين % 13(@)(@@) % أشت بأهله صرف الليالي % % فأضحى وهو منجذم القرين % 14(@)(@@) % ويوم ظعائن عللت نفسي % % بهنذ على مواشكة ذقون % 15(@)(@@) % مبرزة إذا أيدي المطايا % % شدت بقباضة ، وثنت بلين % 16(@)(@@) % ظعائن كنت أعهدهن قدما % وهن لذي الأمانة غير خون % 17(@)(@@) % حسان مواضع النقب الأعالي % % غراث الوشح ، صامتة البرين % 18(@)(@@) % طوال مشك أعناق الهوادي % % نواعم بين أبكار وعون % 19(@)(@@) % يسارقن الكلام إلي لما % % حسسن حذار مرتقب شفون % 20(@)(@@) % كأن الخيم هاج إلي منه % نعاج صرائم حم القرون % PageV01P137 21(@)(@@) % عقائل رملة نازعن منها % % دفوق أقاح معهود ودين % 22(@)(@@) % خلاط أكف شقارى احتشتها % % ملمعة الشوى بيض البطون % 23(@)(@@) % فلما أن رأين القول حالت % حوائم يتخذن الغب رفها % 24(@)(@@) % نقبن وصاوصا حذر الغيارى % % إلي من الهوادج للعيون % 25(@)(@@) % نطقن بحاجة ، وطوين أخرى % % كطي كرائم البز المصون % 26(@)(@@) % بمقتنص الهوى وصلن منه % معاتب نقبت قصب الوتين % 27(@)(@@) % بعينك ودعت في القلب . . . % وداع صريمة لفراق حين % 28(@)(@@) % بذي ذئب ينوس بجانبيه % عثاكل من أكاليل العهون % 29(@)(@@) % أحم سواد أعلى اللون منه % كلون سراة 
ms43	 ثعبان العرين % 30(@)(@@) % تخير من سرارة أثل حجر % ولاحك بينه نحت القيون % PageV01P138 31(@)(@@) % تقول لي المليحة أم جهم % وقد يرعى لذي الشفق المنين % 32(@)(@@) % كأنك لا ترى أهلا ومالا % سوى وجناء جائلة الوضين % 33(@)(@@) % ولو أني أشاء كننت جسمي % % إلى بيضاء واضحة الجبين % 34(@)(@@) % إذ قامت تأود مسبكر % من القضبان في فنن كنين % 35(@)(@@) % ولكني أسير العنس يدمى % % أظلاها ، وتركع في الحزون % 36(@)(@@) % يظل يجول فوق الحاذ منها % % بآيل بولها قطع الجنين % 37(@)(@@) % تسد بمضرحي اللون جثل % خواية فرج مقلات دهين % 38(@)(@@) % كعثكول الصفي ، زهاه هلب % به عبس المصايف كالقرون % 39(@)(@@) % تمر على الوراك إذا المطايا % % تقايسن النجاد منض الوجين % 40(@)(@@) % خريع النعو ، مضطرب النواحي % % كأخلاق الغريفة ذا غضون % PageV01P139 41(@)(@@) % نزت شعب النسا منها الأعالي % % بجانب صفح مطحرة زبون % 42(@)(@@) % تشق مغمضات الليل عنها % % إذا طرقت ، بمرداس رعون % 43(@)(@@) % يلاطم أيسر الخدين منها % % إذا ذقنت قوى مرس متين % 44(@)(@@) % كحلقوم القطاة ، أمر شزرا % كإمرار المحدرج ذي الأسون % 45(@)(@@) % كذا وكلا ، إذا حبست قليلا ، % تعللها بمسود الدرين % 46(@)(@@) % مضبرة القرى ، بنيت يداها % % إلى سند كبرج المنجنون % 47(@)(@@) % قليل العرك ، يهجر مرفقاها % % خليف رحى كفرزوم القيون % 48(@)(@@) % كأني بعد سير القوم خمسا % أحذ النعت يلمع بالمنين % 49(@)(@@) % على بيدانة ببنات قين % تسوف صلال مبتد ظنون % 50(@)(@@) % تعارض رعلة ، وتقود أخرى % % نفاف الوطء ، غائرة العيون % PageV01P140 51(@)(@@) % نواعج ، يغتلين مواكبات % بأعناق كأشرعة السفين % 52(@)(@@) % تراكل عربسيس المتن مرتا % كظهر السيح ، مطرد المتون % 53(@)(@@) % ترى أصواءه متجاورات % على الأشراف كالرفق العزين % 54(@)(@@) % بمنخرق تحن الريح فيه % حنين الجلب في البلد السنين % 55(@)(@@) % يظل غرابها ضرما شذاه % شج بخصومة الذئب الشنون % 56(@)(@@) % على حولاء يطفو السخد فيها % % فراها الشيذمان عن الجنين % 57(@)(@@) % وركب قد بعثت إلى رذايا % % طلائح مثل أخلاق الجفون % 58(@)(@@) % مخافة أن يرين النوم فيهم % بسكر سناتهم كل الريون % 59(@)(@@) % فقاموا ينفضون كرى ليال % تمكن بالطلى بعد العيون % 60(@)(@@) % وشحواء المقام بللت منها % % بسجل بطن مطرق دفين % PageV01P141 61(@)(@@) % كأن قوادم القمري فيه % على رجوي 
ms44	 مراكضها الأجون % 62(@)(@@) % سلاجم يثرب اللاتي علتها % % بيثرب كبرة بعد الجرون % 63(@)(@@) % سبقت بوردها فراط سرب % شرائح بين كدري وجوني % % 64(@)(@@) % ترى لحلوق جلتها أداوى % % ملمعة كتلميع الكرين % 65(@)(@@) % لكل إداوة منها نياط % وحلقوم أضيف إلى وتين % 66(@)(@@) % % إذا اقلولين للقرب البطين % % 67(@)(@@) % بأجنحة يمرن بهن حرد % وأعناق حنين لغير أون % 68(@)(@@) % قطا قرب تروح عن فراخ % نواهض بالفلا صفر البطون % 69(@)(@@) % كأن جلودهن إذا ازلغبت % أفاني الصيف في جرد المتون % 70(@)(@@) % % بمشتبه الظواهر والصحون % PageV01P142 البحر : وافر تام 1(@)(@@) % طربت وشاقك البرق اليماني % % بفج الريح ، فج القاقزان % 2(@)(@@) % أضوء البرق يلمع بين سلمى % % وبين الهضب من جبلي أبان % 3(@)(@@) % أضوء البرق بت تشيم وهنا % لقد دانيت ويحك غير داني % % 4(@)(@@) % لأم تر أن عرفان الثريا % % يهيج لي بقزوين احتزاني % % 5(@)(@@) % خليلي مد طرفك هل ترى لي % % ظعائن باللوى من عوكلان % 6(@)(@@) % ظعائن لو يصفن بدير ليلى % % منى لي أن ألاقيهن ماني % % 7(@)(@@) % وما لك بالظعائن من سبيل % إذا الحادي أغذ ولم يدان % 8(@)(@@) % ولو أن الظعائن عجن شيئا % علي ببطن ذي بقر كفاني % % 9(@)(@@) % ولكن الظعائن رمن صرمي % % هنالك ، واتلأب الحاديان % 10(@)(@@) % بأربعة همت عيناك لما % % تجاوب خلفها صدح القيان % PageV01P143 11(@)(@@) % ألا يا ليت شعري هل أراني % % وشعبا حينا متلائمان % 12(@)(@@) % بأبرق من براق لوى سعيد % تأزر وارتدى بالأقحوان % 13(@)(@@) % وهل أستسمعن بعيد وهن % تهزج سمر جن أو عوان % 14(@)(@@) % ألا من مبلغ عني بشيرا % علانية ، ونعم أخو العلان % 15(@)(@@) % يماني تبوع للمساعي % % يداه ، وكل ذي حسب يماني % % 16(@)(@@) % ولو خليت للشعراء وجهي % % لما اكتبلوا يدي ولا لساني % % 17(@)(@@) % إذا ما غبت عنهم أوعدوني % % وإن شارستهم كرهوا قراني % % 18(@)(@@) % ويؤذنهم علي فتاء سني % % حنانك ربنا ياذا الحنان % 19(@)(@@) % سيعلم كلهم أني مسن % إذا رفعت عنانا عن عنان % 20(@)(@@) % شقي بعد عبد بني حرام % وجدك من تكون به اليدان % PageV01P144 21(@)(@@) % حلفت لأحدثن العام حربا % مشمرة ، كناصية الحصان % 22(@)(@@) % لقوم ظاهروا ، والحرب عنهم % كهام الضرس ضاربة الجران % 23(@)(@@) % أبوا لشقائهم إلا ابتعاثي 
ms45	 % % ومثلي ذو العلالة والمتان % 24(@)(@@) % ويا عجبا ليشكر إذ أغذت % لنصرهم رواة ابني دخان % 25(@)(@@) % ألم تر لؤم يشكر دون بكر % أقام كما أقام الفرقدان % 26(@)(@@) % تحالف يشكر واللؤم قدما % كما جبلا قنا متحالفان % 27(@)(@@) % فليس ببارح عنهم سواهم % وليس بظاعن أو يظعنان % PageV01P145 البحر : وافر تام 1(@)(@@) % أتجعلنا إلى شمجى بن جرم % ونبهان ؟ فأف لذا زمانا ! % 2(@)(@@) % ويوم الطالقان حماك قومي % % ولم تخضب بها طي سنانا % % PageV01P146 البحر : وافر تام 1(@)(@@) % لقد علم المعذل يوم يدعو % % بذئبة يوم ذئبة إذ دعانا % % 2(@)(@@) % فوارس طيىء منعوه لما % % بكى جزعا ، ولولاهم لحانا % % PageV01P147 البحر : طويل 1(@)(@@) % سما للعلى من جانبيها كليهما % % سمو حبابش الماء جاشت غواربه % PageV01P148 البحر : - 1(@)(@@) % . . . . . . . . . . . . . . . . . . % وإن تونى التاليات عقبا % % PageV01P149 البحر : وافر تام 1(@)(@@) % أسرناهم ، وأنعمنا عليهم % وأسقينا دماءهم الترابا % % 2(@)(@@) % فما صبروا لبأس عند حرب % ولا أدوا لحسن يد ثوابا % % PageV01P150 البحر : طويل 1(@)(@@) % عقاب عقنباة ، كأن وظيفها % % وخرطومها الأعلى بنار ملوح % PageV01P151 البحر : طويل 1(@)(@@) % دعتنا بكهف من كنا بيل دعوة % على عجل دهماء ، والركب رائح % PageV01P152 البحر : - 1(@)(@@) % . . . . . . . . . . . . . . % . . . في جنبي مري ومسطح % PageV01P153 البحر : طويل 1(@)(@@) % فإن ي وإياكم وموعد بيننا % % كيوم لبيد يوم فارق أربدا % % 2(@)(@@) % وأخبره أن السبيل ثنية % صعود تنادي كل كهل وأمردا % % 3(@)(@@) % صعود ، فمن تلمع به اليوم يأتها % % ومن لا تلهى بالضحاء فأوردا % % PageV01P154 البحر : طويل 1(@)(@@) % وأجوبة كالزاعبية وخزها % % يبادهها شيخ العراقين أمردا % % PageV01P155 البحر : طويل 1(@)(@@) % تزجي عكاك الصيف أخصامها العلا % وما نزلت حول المقر على عمد % PageV01P156 البحر : كامل تام 1(@)(@@) % قطرت ، وأدرجها الوجيف وضمها % % شد النسوع إلى شجور الأقتد % PageV01P157 البحر : طويل 1(@)(@@) % إذا قبضت نفس الطرماح أخلقت % عرى المجد ، واسترخى عنان القصائد % PageV01P158 البحر : طويل 1(@)(@@) % فمن كان لا يأتيك إلا لحاجة % يروح لها حتى تقضى ويغتدي % % 2(@)(@@) % فإني لآتيكم تشكر ما مضى % % من البر ، واستيجاب ما كان في غد % PageV01P159 البحر : وافر تام 1(@)(@@) % وجدنا في كتاب بني تميم : % أحق الخيل بالركض المعار % PageV01P160 البحر : بسيط تام 1(@)(@@) % يطوي البعيد كطي الثوب هزته % كما تردد بالديمومة الحار % PageV01P161 البحر : طويل 
ms46	 1(@)(@@) % وإن قال عاو من تنوخ قصيدة % بها جرب عدت علي بزوبرا % % PageV01P162 البحر : طويل 1(@)(@@) % تبيت على أطرافها مجذئرة % تكابد هما مثل هم المخاطر % PageV01P163 البحر : طويل 1(@)(@@) % وروحها في المور مور حمامة % على كل إجريائها هو رائز % PageV01P164 البحر : رمل تام 1(@)(@@) % لم تعالج دمحقا بائتا % شج بالطخف للدم الدعاع % PageV01P165 البحر : منسرح 1(@)(@@) % لله در الشراة ، إنهم % إذا الكرى مال بالطلى أرقوا % % 2(@)(@@) % يرجعون الحنين آونة % وإن علا ساعة بهم شهقوا % % 3(@)(@@) % خوفا تبيت القلوب واجفة % تكاد عنها الصدور تنفلق % 4(@)(@@) % كيف أرجي الحياة بعدهم % وقد مضى مؤنسي فانطلقوا % % 5(@)(@@) % قوم شحاح على اعتقادهم % بالفوز مما يخاف قد وثقوا % % PageV01P166 البحر : طويل 1(@)(@@) % تيممت بالكديون كي لا يفوتني % % من المقلة البيضاء تقريظ باعق % PageV01P167 البحر : طويل 1(@)(@@) % غضي عن الفحشاء ، يقصر طرفه % وإن هو لاقى غارة لم يهلل % PageV01P168 البحر : طويل 1(@)(@@) % كأن بلاد الله وهي عريضة % على الخائف المذعور كفة حابل % 2(@)(@@) % يؤدى إليه أن كل ثنية % تيممها ترمي إليه بقاتل % PageV01P169 البحر : رجز تام 1(@)(@@) % أنا الطرماح ، وعمي حاتم % % 2(@)(@@) % وسمي شكي ، ولساني عارم % % 3(@)(@@) % والبحر حيث تنكد الهزائم % % PageV01P170 البحر : طويل 1(@)(@@) % عرفت لسلمى رسم دار تخالها % % ملاعب جن أو كتابا منمنما % % 2(@)(@@) % وعهدي بسلمى والشباب كأنه % عسيب نمى في ريه فتقوما % % 3(@)(@@) % يعض سواراها خدالا لوانها % % إذا بلغا الكفين أن يتقدما % % 4(@)(@@) % نزيعان من جرم بن زبان إنهم % أبو أن يريقوا في الهزاهز محجما % % PageV01P171 البحر : متقارب تام 1(@)(@@) % ويوم النسار ، ويوم الجفا % % ر ، كانا عذابا وكانا غراما % % PageV01P172 البحر : خفيف تام 1(@)(@@) % أزجر العين أن تبكي الرسوما % % إن في الصدر من يزيد هموما % % 2(@)(@@) % قتلته ملوك آل أبي العا % % ص ، وقد يقتل الكريم الكريما % % PageV01P173 البحر : خفيف تام 1(@)(@@) % ورأيت الشريف في أعين النا % % س وضيعا ، وقل منه احتشامي % % PageV01P174 البحر : طويل 1(@)(@@) % فقلت لها : يا أم بيضاء ، إنه % هريق شبابي ، واستشن أديمي % % PageV01P175 البحر : طويل 1(@)(@@) % إن بمعن إن فخرت لمفخرا % وفي غيرها تبنى بيوت المكارم % 2(@)(@@) % متى قدت يا بن العنبرية عصبة % من الناس 
ms47	 تهديها فجاج المخارم % 3(@)(@@) % إذا ما ابن جد كان ناهز طيئا % فإن الذرى قد صرن تحت المناسم % 4(@)(@@) % فقد بزمام بظر أمك ، واحتفر % بأير أبيك الفسل كراث عاسم % PageV01P176 البحر : طويل 1(@)(@@) % بقود سما باللوث حتى أباده % من العيش ، واستلهى شهود العواهن % PageV01P177 البحر : وافر تام 1(@)(@@) % وما أروى ، وإن كرمت علينا ، % بأدنى من موقفة حرون % PageV01P178 
