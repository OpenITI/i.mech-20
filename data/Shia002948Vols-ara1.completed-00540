ms521	 الشيخ (7).(@)(@@)(@@)(@@) $ 4764 / 408 - محمد بن سهل بن اليسع:(@)(@@) ابن عبد الله بن سعد بن مالك بن الأحوص الأشعري القمي (8)، روى عن الرضا وأبي جعفر عليهما السلام، له كتاب (9)، روى أحمد بن محمد بن(@)(@@) PageV04P227(@)(@@) عيسى، عن أبيه، عنه، رجال النجاشي (1).(@)(@@) له مسائل عن الرضا عليه السلام (2)، روى عنه: أحمد بن محمد، الفهرست (3).(@)(@@)(@@)(@@) $ 4765 / 409 - محمد بن سهل بن اليسع:(@)(@@) الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (4).(@)(@@)(@@)(@@) $ 4766 / 410 - محمد بن سهيل الطائي:(@)(@@) الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (5).(@)(@@)(@@)(@@) $ 4767 / 411 - محمد بن شاذان النيشابوري:(@)(@@) من وكلاء الناحية كذا في ربيع الشيعة (6) (7).(@)(@@)(@@)(@@) $ 4768 / 412 - محمد بن شبيب النهدي:(@)(@@) كوفي، أخو جعفر بن شبيب، يعرف جعفر بالبرذون، من أصحاب الصادق عليه السلام، رجال الشيخ (8).(@)(@@) PageV04P228(@)(@@)(@@)(@@) $ 4769 / 413 - محمد بن شجاع المروزي:(@)(@@) أسند عنه، من أصحاب الصادق عليه السلام، رجال الشيخ (1).(@)(@@)(@@)(@@) $ 4770 / 414 - محمد بن شريح الحضرمي (2):(@)(@@) أبو عبد الله، ثقة، روى عن أبي عبد الله عليه السلام، له كتاب، روى عنه:(@)(@@) بكار بن أبي بكر الحضرمي، رجال النجاشي (3).(@)(@@) محمد بن شريح، له كتاب (4)، روى عنه: ابن سماعة، الفهرست (5).(@)(@@) وذكره مرتين (6) ثم قال: محمد بن شريح، له كتاب (7)، روى عنه: ابن نهيك (8).(@)(@@)(@@)(@@) $ 4771 / 415 - محمد بن شعيب:(@)(@@) من أصحاب الرضا عليه السلام، رجال الشيخ (9).(@)(@@) PageV04P229(@)(@@)(@@)(@@) $ 4772 / 416 - محمد بن شعيب البوجاكني:(@)(@@) من أصحاب العياشي، في من لم يرو عن الأئمة عليهم السلام، رجال الشيخ (1) (2).(@)(@@)(@@)(@@) $ 4773 / 417 - محمد بن شمعون النجاشي:(@)(@@) من أصحاب الصادق عليه السلام، رجال الشيخ (3).(@)(@@)(@@)(@@) $ 4774 / 418 - محمد بن شهاب الجرمي:(@)(@@) الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (4).(@)(@@)(@@)(@@) $ 4775 / 419 - محمد بن شهاب الزهري:(@)(@@) عدو (5)، من أصحاب علي بن الحسين عليهما السلام، رجال الشيخ (6).(@)(@@) وكأنه الذي سيجئ بعنوان: محمد بن مسلم الزهري (7).(@)(@@) وفي رجال ابن داود: مسلم بن شهاب الزهري أحد أئمة الحديث ين جخ، يكنى أبا بكر (8).(@)(@@) ولم أجد في رجال الشيخ إلا كما نقلناه(@)(@@) PageV04P230(@)(@@)(@@)(@@) $ 4776 / 420 - محمد بن شهاب بن زيد:(@)(@@) أبو الحسن البارقي، كوفي، من أصحاب الصادق 
ms522	 عليه السلام، رجال الشيخ (1).(@)(@@)(@@)(@@) $ 4777 / 421 - محمد بن شهاب بن العلاف:(@)(@@) العبدي، أبو همام الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (2) (3).(@)(@@)(@@)(@@) $ 4778 / 422 - محمد بن صابر الأزدي:(@)(@@) الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (4).(@)(@@)(@@)(@@) $ 4779 / 423 - محمد بن صالح الأرمني:(@)(@@) من أصحاب العسكري عليه السلام، رجال الشيخ (5).(@)(@@)(@@)(@@) $ 4780 / 424 - محمد بن صالح الحلبي:(@)(@@) من أصحاب الباقر عليه السلام، رجال الشيخ (6).(@)(@@)(@@)(@@) $ 4781 / 425 - محمد بن صالح الخثعمي:(@)(@@) من أصحاب العسكري عليه السلام، رجال الشيخ (7).(@)(@@) PageV04P231(@)(@@)(@@)(@@) $ 4782 / 426 - محمد بن صالح بن محمد:(@)(@@) الهمداني، وكيل، الدهقان، من أصحاب العسكري عليه السلام، رجال الشيخ (1).(@)(@@) وفي ربيع الشيعة: أنه كان من وكلاء القائم عليه السلام (2).(@)(@@)(@@)(@@) $ 4783 / 427 - محمد بن صالح بن مسعود:(@)(@@) الجدلي الكوفي، أسند عنه، من أصحاب الصادق عليه السلام، رجال الشيخ (3).(@)(@@)(@@)(@@) $ 4784 / 428 - محمد بن صالح بن معاوية:(@)(@@) ابن عبد الله بن جعفر الجعفري المدني، من أصحاب الصادق عليه السلام، رجال الشيخ (4).(@)(@@)(@@)(@@) $ 4785 / 429 - محمد بن الصلت:(@)(@@) رجال النجاشي (5). ولم يذكر غير هذا.(@)(@@) وقال الشيخ في الرجال: محمد بن الصامت الجعفي، أسند عنه، من أصحاب الصادق عليه السلام (6).(@)(@@)(@@)(@@) $ 4786 / 430 - محمد بن الصباح (7):(@)(@@) كوفي، ثقة، له كتاب، روى عنه: إبراهيم بن سليمان، رجال(@)(@@) PageV04P232(@)(@@) النجاشي (1).(@)(@@) من أصحاب الكاظم عليه السلام، رجال الشيخ (2).(@)(@@) ففي قول ابن داود أنه لم نظر (3).(@)(@@)(@@)(@@) $ 4787 / 431 - محمد بن صدقة العنبري:(@)(@@) البصري، أبو جعفر، روى عن أبي الحسن موسى وعن الرضا عليهما السلام له كتاب عن موسى بن جعفر عليه السلام، روى عنه: الحسن بن علي بن زكريا، رجال النجاشي (4).(@)(@@) محمد بن صدقة، بصري، غال، من أصحاب الرضا عليه السلام، رجال الشيخ (5).(@)(@@) وذكره ابن داود مرة في باب الثقات كما ذكره النجاشي (6)، ومرة في باب الضعفاء كما ذكره الشيخ في الرجال (7).(@)(@@) والظاهر أنهما واحد.(@)(@@)(@@)(@@) $ 4788 / 432 - محمد بن صفوان السلمي:(@)(@@) الأنصاري عداده في المدنيين، من أصحاب الرسول صلى الله عليه وآله، رجال الشيخ (8).(@)(@@) PageV04P233(@)(@@)(@@)(@@) $ 4789 / 433 - محمد بن الصلت بن مالك:(@)(@@) القرشي الكوفي، من أصحاب الصادق عليه السلام، رجال 
ms523	 الشيخ (1).(@)(@@)(@@)(@@) $ 4790 / 434 - محمد بن صيفي الأنصاري:(@)(@@) عداده في المدنيين، من أصحاب الرسول صلى الله عليه وآله، رجال الشيخ (2).(@)(@@)(@@)(@@) $ 4791 / 435 - محمد بن صيفي:(@)(@@) كوفي، من أصحاب الهادي عليه السلام، رجال الشيخ (3).(@)(@@)(@@)(@@) $ 4792 / 436 - محمد بن ضباري (4) بن ملك:(@)(@@) الطائي الكوفي (5)، من أصحاب الصادق عليه السلام، رجال الشيخ (6).(@)(@@)(@@)(@@) $ 4793 / 437 - محمد بن ضمرة بن مالك:(@)(@@) أبو مالك العنزي (7) الكوفي، أسند عنه، من أصحاب الصادق عليه السلام، رجال الشيخ (8) (9).(@)(@@)(@@)(@@) $ 4794 / 438 - محمد بن طارق الطائي:(@)(@@) الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (10).(@)(@@) PageV04P234(@)(@@)(@@)(@@) $ 4795 / 439 - محمد بن طالب بن عمير:(@)(@@) العبدي، من أصحاب الصادق عليه السلام، رجال الشيخ (1).(@)(@@)(@@)(@@) $ 4796 / 440 - محمد بن طاهر بن جمهور:(@)(@@) من غلمان العياشي، في من لم يرو عن الأئمة عليهم السلام، رجال الشيخ (2) (3).(@)(@@)(@@)(@@) $ 4797 / 441 - محمد بن طلحة بن عبيد الله:(@)(@@) ابن عثمان بن عمرو بن كعب بن سعد بن تيم بن مرة، يكنى أبا القاسم، وقيل: يكنى أبا سليمان، قتل يوم الجمل في عسكر أهل البصرة، من أصحاب الرسول صلى الله عليه وآله، رجال الشيخ (4).(@)(@@)(@@)(@@) $ 4798 / 442 - محمد بن طلحة بن مصرف:(@)(@@) الهمداني، كوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (5).(@)(@@)(@@)(@@) $ 4799 / 443 - محمد بن طلحة النهدي:(@)(@@) أخو عبد الله بن طلحة، من أصحاب الصادق عليه السلام، رجال الشيخ (6).(@)(@@)(@@)(@@) $ 4800 / 444 - محمد بن طليب بن عمارة:(@)(@@) الخثعمي الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (7).(@)(@@) PageV04P235(@)(@@)(@@)(@@) $ 4801 / 445 - محمد الطيار (1):(@)(@@) سيجئ بعنوان: محمد بن عبد الله الطيار (2) (3).(@)(@@)(@@)(@@) $ 4802 / 446 - محمد بن ظهير:(@)(@@) أبو عمارة المزني، كوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (4).(@)(@@)(@@)(@@) $ 4803 / 447 - محمد بن عابد (5) الأزدي:(@)(@@) كوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (6).(@)(@@)(@@)(@@) $ 4804 / 448 - محمد بن عباد بن سريع:(@)(@@) البارقي، من أصحاب الصادق عليه السلام، رجال الشيخ (7) (8).(@)(@@)(@@)(@@) $ 4805 / 449 - محمد بن عباد بن عمرو:(@)(@@) الثقفي الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (9).(@)(@@)(@@)(@@) $ 4806 / 450 - محمد بن عبادة:(@)(@@) ابن أبي روق عطية بن الحارث الهمداني الكوفي، أسند عنه، من أصحاب الصادق 
ms524	 عليه السلام، رجال الشيخ (10).(@)(@@) PageV04P236(@)(@@)(@@)(@@) $ 4807 / 451 - محمد بن العباس بن علي:(@)(@@) ابن مروان بن (1) الماهيار، أبو عبد الله البزاز المعروف بابن الحجام، ثقة ثقة من أصحابنا، عين، سديد، كثير الحديث، له كتب، رجال النجاشي (2).(@)(@@) له كتب (3)، روى عنه: التلعكبري، الفهرست (4).(@)(@@) في من لم يرو عن الأئمة عليهم السلام (5)، رجال الشيخ (6).(@)(@@)(@@)(@@) $ 4808 / 452 - محمد بن العباس (7) بن عيسى:(@)(@@) أبو عبد الله، كان يسكن بني غاضرة، ثقة، روى عن أبيه والحسن بن علي بن أبي حمزة وعبد الله بن جبلة، له كتب، روى عنه: حميد، رجال النجاشي (8).(@)(@@) في من لم يرو عن الأئمة عليهم السلام (9)، رجال الشيخ (10).(@)(@@) PageV04P237(@)(@@)(@@)(@@) $ 4809 / 453 - محمد بن العباس بن مرزوق (1):(@)(@@) له روايات (2)، روى عنه: أحمد بن ميثم، الفهرست (3).(@)(@@)(@@)(@@) $ 4810 / 454 - محمد بن العباس بن الوليد:(@)(@@) النحوي، يكنى أبا الحسين، روى عنه: التلعكبري، في من لم يرو عن الأئمة عليهم السلام، رجال الشيخ (4).(@)(@@)(@@)(@@) $ 4811 / 455 - محمد بن عبد بن خالد:(@)(@@) الأسدي الصيداوي، مولاهم، كوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (5).(@)(@@)(@@)(@@) $ 4812 / 456 - محمد بن عبد الجبار:(@)(@@) وهو ابن أبي الصهبان، قمي، ثقة، من أصحاب الجواد (6) والهادي (7) والعسكري عليهم السلام (8)، رجال الشيخ.(@)(@@) له روايات (9)، روى عنه: سعد بن عبد الله والحميري ومحمد بن(@)(@@) PageV04P238(@)(@@) يحيى وأحمد بن إدريس، الفهرست (1).(@)(@@) روى عن ابن بكير، رجال الكشي (2).(@)(@@)(@@)(@@) $ 4813 / 457 - محمد بن عبد الحميد (3) بن سالم:(@)(@@) العطار (4)، أبو جعفر، روى عبد الحميد عن الكاظم عليه السلام وكان ثقة من أصحابنا الكوفيين، له كتاب النوادر، روى عنه: عبد الله بن جعفر، رجال النجاشي (5).(@)(@@) له كتاب (6)، روى عنه: أحمد بن أبي عبد الله، الفهرست (7).(@)(@@) من أصحاب الرضا (8) (9) والعسكري عليهما السلام (10)، رجال الشيخ.(@)(@@) ثم قال: محمد بن الحميد، روى عنه: ابن الوليد، في من لم يرو عن الأئمة عليهم السلام (11).(@)(@@) PageV04P239(@)(@@) ولعلهما واحد لأن مثل هذا في كلام الشيخ قدس سره كثير كما نقلنا عند ترجمة القاسم بن محمد الجوهري (1).(@)(@@) وذكره ابن داود رجلين مختلفين (2).(@)(@@) وقال العلامة في الخلاصة: طريق محمد بن علي بن بابويه إلى منصور 
ms525	 بن حازم صحيح (3)، وفيه محمد بن عبد الحميد (4).(@)(@@)(@@)(@@) $ 4814 / 458 - محمد بن عبد الحميد بن قبة:(@)(@@) الذي ذكره (5) ابن داود (6). سيجئ بعنوان: محمد بن عبد الرحمن (7).(@)(@@)(@@)(@@) $ 4815 / 459 - محمد بن عبد ربه الأنصاري:(@)(@@) أجاز التلعكبري جميع حديثه، وكان يروي عن سعد بن عبد الله وعبد الله بن جعفر الحميري ونظرائهما على يد أبي أحمد إسماعيل بن يحيى العبسي، في من لم يرو عن الأئمة عليهم السلام، رجال الشيخ (8).(@)(@@)(@@)(@@) $ 4816 / 460 - محمد بن عبد الرحمن بن أبي بكر:(@)(@@) القرشي التيمي، أبو عزارة (9) المكي، من أصحاب الصادق عليه السلام،(@)(@@) PageV04P240(@)(@@) رجال الشيخ (1).(@)(@@)(@@)(@@) $ 4817 / 461 - محمد بن عبد الرحمن بن أبي ليلى:(@)(@@) الأنصاري القاضي الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (2).(@)(@@) روى ابن عقدة عن عبد الله بن إبراهيم بن قتيبة عن ابن نمير وسئل عن ابن أبي ليلى فقال: كان صدوقا مأمونا ولكنه سئ الحفظ جدا، وهذه الرواية من المرجحات، الخلاصة (3).(@)(@@)(@@)(@@) $ 4818 / 462 - محمد بن عبد الرحمن البزاز:(@)(@@) الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (4).(@)(@@)(@@)(@@) $ 4819 / 463 - محمد بن عبد الرحمن الذهلي:(@)(@@) السهمي البصري (5)، من أصحاب الصادق عليه السلام، رجال الشيخ (6).(@)(@@) قال ابن عقدة عن محمد بن أحمد بن عبد الله بن زياد الزيات قال:(@)(@@) حدثنا محمد بن عبد الرحمن بن محمد بن عبيد الله (7) العرزمي قال: حدثنا محمد بن عبد الرحمن السهمي البصري وكان من الثقات، وهذه الرواية من المرجحات، الخلاصة (8) (9).(@)(@@) PageV04P241(@)(@@)(@@)(@@) $ 4820 / 464 - محمد بن عبد الرحمن العرزمي:(@)(@@) الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (1).(@)(@@)(@@)(@@) $ 4821 / 465 - محمد بن عبد الرحمن بن عمر:(@)(@@) ابن أذينة، من أصحاب الكاظم عليه السلام، رجال الشيخ (2).(@)(@@)(@@)(@@) $ 4822 / 466 - محمد بن عبد الرحمن بن قبة:(@)(@@) الرازي، أبو جعفر، متكلم، عظيم القدر، حسن العقيدة، قوي في الكلام، كان قديما من المعتزلة وتبصر وانتقل، له كتب في الكلام وقد سمع الحديث، واخذ عنه ابن بطة، رجال النجاشي (3).(@)(@@) من متكلمي الإمامية وحذاقهم، وكان أولا معتزليا ثم انتقل إلى القول بالإمامة وحسنت بصيرته، وله كتب في الإمامة، الفهرست 
ms526	 (4).(@)(@@) وفي رجال ابن داود: محمد بن عبد الحميد بن قبة الرازي... إلى آخره (5).(@)(@@) وكأنه سهو لأني لم أجد في كتب الرجال إلا كما نقلناه.(@)(@@)(@@)(@@) $ 4823 / 467 - محمد بن عبد الرحمن بن المغيرة:(@)(@@) ابن الحارث بن أبي ذئب (6) المدني، أبو الحارث، أسند عنه، مات ابن أبي ذئب سنة سبع وخمسين ومائة، من أصحاب الصادق عليه السلام، رجال(@)(@@) PageV04P242(@)(@@) الشيخ (1).(@)(@@)(@@)(@@) $ 4824 / 468 - محمد بن عبد السلام الكوفي:(@)(@@) من أصحاب الصادق عليه السلام، رجال الشيخ (2) (3).(@)(@@)(@@)(@@) $ 4825 / 469 - محمد بن عبد العزيز الزهري:(@)(@@) المدني، أسند عنه، من أصحاب الصادق عليه السلام، رجال الشيخ (4).(@)(@@) قال ابن عقدة عن عبد الرحمن بن يوسف عن محمد بن إسماعيل البخاري قال: محمد بن عبد العزيز الزهري منكر الحديث، الخلاصة (5).(@)(@@)(@@)(@@) $ 4826 / 470 - محمد بن عبد العزيز بن زياد:(@)(@@) البارقي الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (6) (7).(@)(@@)(@@)(@@) $ 4827 / 471 - محمد بن عبد العزيز بن هاني:(@)(@@) الكلابي الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (8).(@)(@@) PageV04P243(@)(@@)(@@)(@@) $ 4828 / 472 - محمد بن عبد الله:(@)(@@) من أصحاب الحسين عليه السلام، رجال الشيخ (1) (2).(@)(@@)(@@)(@@) $ 4829 / 473 - محمد بن عبد الله الأشعري (3):(@)(@@) من أصحاب الرضا عليه السلام، رجال الشيخ (4).(@)(@@)(@@)(@@) $ 4830 / 474 - محمد بن عبد الله الأعلم:(@)(@@) الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (5).(@)(@@)(@@)(@@) $ 4831 / 475 - محمد بن عبد الله بن جحش:(@)(@@) الأسدي عداده في المدنيين، من أصحاب الرسول صلى الله عليه وآله، رجال الشيخ (6).(@)(@@)(@@)(@@) $ 4832 / 476 - محمد بن عبد الله بن جعفر:(@)(@@) ابن أبي طالب، من أصحاب الحسين عليه السلام، قتل معه عليه السلام، رجال الشيخ (7).(@)(@@)(@@)(@@) $ 4833 / 477 - محمد بن عبد الله بن جعفر:(@)(@@) ابن الحسين بن جامع بن مالك الحميري، أبو جعفر القمي،(@)(@@) PageV04P244(@)(@@) كان ثقة وجها (1)، كاتب صاحب الأمر عليه السلام وسأله مسائل في أبواب الشريعة، قال لنا أحمد بن الحسين: وقعت هذه المسائل إلي في أصلها والتوقيعات بين السطور، وكان له إخوة جعفر والحسين وأحمد كلهم كان له مكاتبة، ولمحمد كتب، روى عنه: علي بن حاتم القزويني، رجال النجاشي (2).(@)(@@) محمد بن عبد الله بن جعفر 
ms527	 الحميري (3)، روى عنه: أحمد بن هارون الفامي وجعفر بن الحسين، روى عنهما محمد بن علي بن الحسين بن بابويه، في من لم يرو عن الأئمة عليهم السلام، رجال الشيخ (4). ثم قال: محمد ابن عبد الله بن جعفر الحميري، روى ابن بابويه أبو جعفر عن أحمد بن هارون الفامي (5) عنه، في من لم يرو عن الأئمة عليهم السلام (6) (7).(@)(@@) والظاهر أنهما واحد.(@)(@@)(@@)(@@) $ 4834 / 478 - محمد بن عبد الله الجعفري:(@)(@@) ذكرناه بعنوان: محمد بن الحسن بن عبد الله الجعفري (8).(@)(@@) PageV04P245(@)(@@)(@@)(@@) $ 4835 / 479 - محمد بن عبد الله الجلاب:(@)(@@) البصري، واقفي، من أصحاب الكاظم عليه السلام، رجال الشيخ (1).(@)(@@)(@@)(@@) $ 4836 / 480 - محمد بن عبد الله الجملي:(@)(@@) المرادي الكوفي، أسند عنه، من أصحاب الصادق عليه السلام، رجال الشيخ (2).(@)(@@)(@@)(@@) $ 4837 / 481 - محمد بن عبد الله بن الحسن:(@)(@@) ابن الحسن بن علي ابن أبي طالب عليه السلام، أبو عبد الله المدني، قتل سنة خمس وأربعين ومائة بالمدينة، من أصحاب الصادق عليه السلام، رجال الشيخ (3).(@)(@@)(@@)(@@) $ 4838 / 482 - محمد بن عبد الله بن الحسين:(@)(@@) ابن علي بن الحسين المدني، من أصحاب الصادق عليه السلام، رجال الشيخ (4).(@)(@@)(@@)(@@) $ 4839 / 483 - محمد بن عبد الله الحضرمي:(@)(@@) له كتاب الصلاة، روى عنه: علي بن عبد الرحمن البكائي، الفهرست (5) (6).(@)(@@) PageV04P246(@)(@@)(@@)(@@) $ 4840 / 484 - محمد بن عبد الله بن رباط:(@)(@@) البجلي، روى أبوه عن الصادق عليه السلام، وكان هو وأبوه ثقتين، له كتاب نوادر، روى عنه: الحسن بن محبوب، رجال النجاشي (1).(@)(@@)(@@)(@@) $ 4841 / 485 - محمد بن عبد الله:(@)(@@) روى عنه: أبان بن عثمان، فلم يثبت معرفته، من أصحاب الصادق عليه السلام، رجال الشيخ (2).(@)(@@)(@@)(@@) $ 4842 / 486 - محمد بن عبد الله بن زرارة:(@)(@@) ابن أعين، قال الشهيد الثاني رحمه الله في حاشيته على الخلاصة عند ترجمة الحسن بن علي بن فضال: إن محمد بن عبد الله بن زرارة مجهول (3).(@)(@@) وقد نقلنا ما يدل على توثيقه عند ترجمة الحسن بن علي بن فضال فلاحظها (4).(@)(@@) (وروى عنه: علي بن الحسن بن فضال كما يظهر من أوائل كتاب النكاح من التهذيب) (5).(@)(@@)(@@)(@@) $ 4843 / 487 - محمد بن عبد 
ms528	 الله بن زيد:(@)(@@) الأنصاري، يقال: إنه ولد بعهد النبي صلى الله عليه وآله، عداده في المدنيين، من أصحاب الرسول صلى الله عليه وآله، رجال الشيخ (6).(@)(@@) PageV04P247(@)(@@)(@@)(@@) $ 4844 / 488 - محمد بن عبد الله السجاد:(@)(@@) الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (1).(@)(@@)(@@)(@@) $ 4845 / 489 - محمد بن عبد الله بن سعيد بن حيان:(@)(@@) ابن أبحر الكناني، أبو الحسن الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (2).(@)(@@)(@@)(@@) $ 4846 / 490 - محمد بن عبد الله بن سلام:(@)(@@) ابن الحارث الخزرجي الأنصاري، عداده في المدنيين، من أصحاب الرسول صلى الله عليه وآله، رجال الشيخ (3).(@)(@@)(@@)(@@) $ 4847 / 491 - محمد بن عبد الله بن سوادة:(@)(@@) الهمداني الخارفي (4) الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (5).(@)(@@)(@@)(@@) $ 4848 / 492 - محمد بن عبد الله بن شهاب:(@)(@@) أبو عباد (6) العبدي الكوفي، أسند عنه، من أصحاب الصادق عليه السلام، رجال الشيخ (7) (8).(@)(@@) PageV04P248(@)(@@)(@@)(@@) $ 4849 / 493 - محمد بن عبد الله الطاهري:(@)(@@) من أصحاب الرضا عليه السلام، رجال الشيخ (1) (2).(@)(@@)(@@)(@@) $ 4850 / 494 - محمد بن عبد الله الطيار:(@)(@@) من أصحاب الباقر (3) والصادق (4) عليهما السلام، رجال الشيخ.(@)(@@) وروى الكشي عن طاهر بن عيسى، عن جعفر بن أحمد، عن الشجاعي، عن محمد بن الحسين، عن صفوان بن يحيى، عن حمزة بن الطيار، عن أبيه محمد قال: جئت إلى باب أبي جعفر عليه السلام أستأذن عليه، فلم يأذن لي وأذن لغيري، فرجعت إلى منزلي وأنا مغموم فطرحت نفسي على سرير في الدار وذهب عني النوم، فجلعت أفكر وأقول: أليس المرجئة تقول (5) كذا، والقدرية تقول كذا، والحرورية تقول كذا، والزيدية تقول كذا، فيفسد عليهم قولهم، فأنا أفكر في هذا حتى نادى المنادي، فإذا الباب يدق فقلت: من هذا؟ فقال: رسول لأبي جعفر عليه السلام يقول لك أبو جعفر عليه السلام: أجب، فأخذت ثيابي ومضيت معه فدخلت عليه فلما رآني قال يا محمد: لا إلى المرجئة ولا إلى القدرية ولا إلى الحرورية ولا إلى الزيدية، ولكن إلينا إنما حجبتك (6) لكذا وكذا، فقبلت وقلت به (7).(@)(@@) وروى عن حمدويه ومحمد ابني نصير، عن محمد بن عيسى، عن(@)(@@) PageV04P249(@)(@@) علي 
ms529	 بن الحكم، عن أبان الأحمر (1)، عن الطيار قال: قلت لأبي عبد الله عليه السلام:(@)(@@) بلغني أنك كرهت منا مناضرة الناس وكرهت الخصومة، فقال: أما كلام مثلك للناس فلا نكرهه، من إذا طار أحسن أن يقع وإن وقع يحسن أن يطير، فمن كان هكذا فلا نكره كلامه (2).(@)(@@) وروى عن محمد بن مسعود، عن محمد بن نصير، عن محمد بن الحسين، عن جعفر بن بشير، عن ابن بكير، عن حمزة بن الطيار قال:(@)(@@) سألني أبو عبد الله عليه السلام عن قراءة القرآن فقلت: ما أنا بذاك، قال: لكن أبوك. قال: وسألني عن الفرائض فقلت: وما أنا بذاك، فقال: ولكن أبوك.(@)(@@) قال: ثم قال: إن رجلا من قريش كان لي صديقا وكان عالما قارئا فاجتمع هو وأبوك عند أبي جعفر عليه السلام فقال: ليقبل (3) كل واحد منكما على صاحبه ويسأل (4) كل واحد منكما صاحبه، ففعلا، فقال القرشي لأبي جعفر عليه السلام:(@)(@@) قد علمت ما أردت، أردت أن تعلمني أن في أصحابك مثل هذا، قال: هو ذاك كيف رأيت (5)؟(@)(@@)(@@)(@@) $ 4851 / 495 - محمد بن عبد الله بن عبد الرحمن:(@)(@@) ابن أبي عقيل الثقفي الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (6).(@)(@@) PageV04P250(@)(@@)(@@)(@@) $ 4852 / 496 - محمد بن عبد الله بن عبيد:(@)(@@) ابن عمير الليثي المكي، من أصحاب الصادق عليه السلام، رجال الشيخ (1).(@)(@@)(@@)(@@) $ 4853 / 497 - محمد بن عبد الله بن علاثة (2):(@)(@@) الدمشقي، أسند عنه، من أصحاب الصادق عليه السلام، رجال الشيخ (3).(@)(@@)(@@)(@@) $ 4854 / 498 - محمد بن عبد الله بن علي:(@)(@@) ابن أبي رافع، من أصحاب الصادق عليه السلام، رجال الشيخ (4).(@)(@@)(@@)(@@) $ 4855 / 499 - محمد بن عبد الله بن علي:(@)(@@) ابن الحسين بن علي بن أبي طالب عليهم السلام الهاشمي المدني، أسند عنه، من أصحاب الصادق عليه السلام، رجال الشيخ (5).(@)(@@)(@@)(@@) $ 4856 / 500 - محمد بن عبد الله ابن عم الحسين:(@)(@@) ابن أبي العلاء، روى ابن عقدة عن الحسن بن علي بن بزيع عن عبد الله بن محمد المزخرف أبو محمد قال: حدثني محمد ابن عبد الله ابن عم الحسين بن أبي العلاء 
ms530	 وكان خيرا، الخلاصة (6).(@)(@@)(@@)(@@) $ 4857 / 501 - محمد بن عبد الله بن عمرو:(@)(@@) ابن سالم بن لاحق، أبو عبد الله اللاحقي الصفار، روى عن الرضا عليه السلام، له نسخة، روى عنه: أحمد بن محمد بن عيسى بن الغراد، رجال النجاشي (7).(@)(@@) PageV04P251(@)(@@)(@@)(@@) $ 4858 / 502 - محمد بن عبد الله بن عيسى:(@)(@@) الأشعري، قمي، من أصحاب الصادق عليه السلام، رجال الشيخ (1).(@)(@@)(@@)(@@) $ 4859 / 503 - محمد بن عبد الله بن غالب:(@)(@@) أبو عبد الله الأنصاري البزاز، ثقة في الرواية على مذهب الواقفة، له كتاب النوادر، روى عنه: حميد، رجال النجاشي (2) (3).(@)(@@)(@@)(@@) $ 4860 / 504 - محمد بن عبد الله القلاعي:(@)(@@) أخو دارم، مولى بني تيم، الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (4).(@)(@@)(@@)(@@) $ 4861 / 505 - محمد بن عبد الله بن محمد:(@)(@@) روى عن (5) ابن نوح دعاء الحريق باسناده، في من لم يرو عن الأئمة عليهم السلام، رجال الشيخ (6).(@)(@@)(@@)(@@) $ 4862 / 506 - محمد بن عبد الله بن محمد:(@)(@@) ابن أبي الكرام الجعفري الهاشمي المدني، أسند عنه، من أصحاب الصادق عليه السلام، رجال الشيخ (7).(@)(@@) PageV04P252(@)(@@)(@@)(@@) $ 4863 / 507 - محمد بن عبد الله بن محمد (1):(@)(@@) ابن عبيد الله بن البهلول بن همام بن المطلب بن همام بن بحر بن مطر بن مرة الصغرى بن همام بن مرة بن ذهل بن شيبان، أبو المفضل، كان سافر في طلب الحديث عمره، أصله كوفي، وكان في أول أمره ثبتا ثم خلط، ورأيت جل أصحابنا يغمزونه ويضعفونه.(@)(@@) له كتب كثيرة، منها: كتاب مزار الحسين عليه السلام، رأيت هذا الشيخ وسمعت منه كثيرا ثم توقفت عن الرواية عنه إلا بواسطة بيني وبينه، رجال النجاشي (2).(@)(@@) محمد بن عبد الله بن المطلب الشيباني، أبو المفضل، كثير الرواية، حسن الحفظ غير أنه ضعفه جماعة من أصحابنا، له كتب، منها كتاب المزار، أخبرنا بجميع (3) رواياته عنه: جماعة من أصحابنا، الفهرست (4).(@)(@@) محمد بن عبد الله بن المطلب الشيباني، أبو المفضل، كثير الرواية إلا أنه ضعفه قوم، أخبرنا عنه: جماعة، في من لم يرو عن الأئمة عليهم السلام، رجال الشيخ (5).(@)(@@) محمد بن عبد الله بن المطلب الشيباني، أبو 
ms531	 المفضل، وضاع، كثير المناكير، رأيت كتبه وفيه الأسانيد من دون المتون والمتون من دون الأسانيد، وأرى ترك ما ينفرد به، رجال ابن الغضائري (6).(@)(@@) PageV04P253(@)(@@) والظاهر أن ما ذكره النجاشي والشيخ في كتابيه وابن الغضائري واحد كما يظهر من كلامهم.(@)(@@) وذكره العلامة في الخلاصة مرة كما ذكره النجاشي (1)، ومرة كما ذكره الشيخ وابن الغضائري (2).(@)(@@) وذكره ابن داود ثلاث مرات، مرة في باب الموثقين (3)، ومرتين في باب المجروحين (4).(@)(@@)(@@)(@@) $ 4864 / 508 - محمد بن عبد الله بن محمد:(@)(@@) ابن علي بن الحسين بن علي بن أبي طالب عليهم السلام المدني، أسند عنه، من أصحاب الصادق عليه السلام، رجال الشيخ (5).(@)(@@)(@@)(@@) $ 4865 / 509 - محمد بن عبد الله بن محمد:(@)(@@) ابن عمر بن علي بن أبي طالب عليه السلام، أبو جعفر المدني، روى عن أبي عبد الله عليه السلام نسخة، روى أبو محمد القاسم بن جعفر، عن أبيه، عنه (6)، رجال النجاشي (7).(@)(@@)(@@)(@@) $ 4866 / 510 - محمد بن عبد الله المدائني:(@)(@@) لحق موسى بن جعفر عليه السلام، من أصحاب الرضا (8) والجواد (9) عليهما السلام، رجال الشيخ.(@)(@@) PageV04P254(@)(@@)(@@)(@@) $ 4867 / 511 - محمد بن عبد الله المسلي:(@)(@@) ومسلية قبيلة من مذحج، كان ثقة قليل الحديث، له كتاب نوادر، روى عنه: حميد، رجال النجاشي (1).(@)(@@)(@@)(@@) $ 4868 / 512 - محمد بن عبد الله المسمعي (2):(@)(@@) روى عنه: محمد بن أحمد بن يحيى، وروى عن إسماعيل بن يسار وإسماعيل بن مهران كذا يظهر من باب تلقين المحتضرين من التهذيب (3).(@)(@@)(@@)(@@) $ 4869 / 513 - محمد بن عبد الله بن المطلب:(@)(@@) الشيباني. ذكرناه بعنوان: محمد بن عبد الله بن محمد بن عبيد الله (4).(@)(@@)(@@)(@@) $ 4870 / 514 - محمد بن عبد الله المكي:(@)(@@) روى عنه: حميد نوادر (5)، الفهرست (6).(@)(@@) في من لم يرو عن الأئمة عليهم السلام، رجال الشيخ (7).(@)(@@) ويحتمل أن يكون هذا هو المسلي المذكور قبيل هذا.(@)(@@)(@@)(@@) $ 4871 / 515 - محمد بن عبد الله بن مملك:(@)(@@) الأصبهاني، أصله جرجان وسكن أصبهان، أبو عبد الله، جليل في(@)(@@) PageV04P255(@)(@@) أصحابنا، عظيم القدر والمنزلة، كان معتزليا ورجع على يد عبد الرحمن بن أحمد بن جيرويه رحمه الله (1)، له كتب، رجال النجاشي (2).(@)(@@)(@@)(@@) $ 4872 / 516 - محمد 
ms532	 بن عبد الله بن مهران:(@)(@@) الكرخي، أبو جعفر، غال، ضعيف، كذاب، له كتاب في الممدوحين والمذمومين يدل على خبثه وكذبه، رجال ابن الغضائري (3).(@)(@@) يرمى بالغلو، ضعيف، من أصحاب الجواد (4) والهادي عليهما السلام (5)، رجال الشيخ.(@)(@@) ثم قال: محمد بن عبد الله بن مهران، ضعيف، روى عنه: محمد بن أحمد بن يحيى، في من لم يرو عن الأئمة عليهم السلام (6).(@)(@@) ونبه النجاشي (7) والشيخ في الفهرست (8) على ضعفه عند ترجمة محمد بن أحمد بن يحيى (9).(@)(@@) PageV04P256(@)(@@)(@@)(@@) $ 4873 / 517 - محمد بن عبد الله بن نجيح:(@)(@@) أبو عبد الله الكوفي، المعروف بالشخير (1)، رجل من أصحابنا، قليل الحديث، له كتاب، يروي عن الحسن بن محبوب وسليمان الديلمي، روى عنه: ابن ثابت، رجال النجاشي (2).(@)(@@)(@@)(@@) $ 4874 / 518 - محمد بن عبد الله النوفلي:(@)(@@) الهمداني، من أصحاب الهادي عليه السلام، رجال الشيخ (3).(@)(@@)(@@)(@@) $ 4875 / 519 - محمد بن عبد الله الهاشمي:(@)(@@) له كتاب يرويه القميون، روى عنه: محمد بن عبد الله بن هلال، رجال النجاشي (4).(@)(@@)(@@)(@@) $ 4876 / 520 - محمد بن عبد المؤمن المؤدب:(@)(@@) قمي، ثقة، له كتاب، روى عنه: جعفر بن محمد، رجال النجاشي (5).(@)(@@)(@@)(@@) $ 4877 / 521 - محمد بن عبد الملك بن أعين:(@)(@@) الشيباني، أبو علي، من أصحاب الصادق عليه السلام، رجال الشيخ (6).(@)(@@)(@@)(@@) $ 4878 / 522 - محمد بن عبد الملك الأنصاري:(@)(@@) كوفي، نزل بغداد، أسند عنه، ضعيف، من أصحاب الصادق عليه السلام(@)(@@) PageV04P257(@)(@@) رجال الشيخ (1).(@)(@@)(@@)(@@) $ 4879 / 523 - محمد بن عبد الملك الطائي:(@)(@@) الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (2) (3).(@)(@@)(@@)(@@) $ 4880 / 524 - محمد بن عبد الملك بن محمد:(@)(@@) التبان، أبو عبد الله، كان معتزليا ثم أظهر الانتقال ولم يكن ساكنا، له كتاب في التكليف من علم الله أنه يكفر، وله كتاب في المعدوم، مات سنة تسع عشرة وأربعمائة، رجال النجاشي (4).(@)(@@) وفي الخلاصة: مات سنة عشرة وأربعمائة (5). وكأنه سقط من القلم لفظة (تسع).(@)(@@)(@@)(@@) $ 4881 / 525 - محمد بن عبد الواحد البكري:(@)(@@) الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (6) (7).(@)(@@)(@@)(@@) $ 4882 / 526 - محمد بن عبدة السابري (8):(@)(@@) من أصحاب الصادق عليه السلام، رجال الشيخ (9) (10).(@)(@@) PageV04P258(@)(@@)(@@)(@@) $ 4883 / 527 - محمد بن عبيد بن صاعد: 
ms533	(@)(@@) كوفي، واقف، يكنى أبا عبد الله، روى عن القاسم بن إسماعيل، له كتاب، روى عنه: الحسين بن أحمد بن إلياس، رجال النجاشي (1).(@)(@@)(@@)(@@) $ 4884 / 528 - محمد بن عبيد الكاتب:(@)(@@) وجه من الكوفيين، ثقة، عين، له كتب، روى عنه: محمد بن عبيد العقيقي الكندي، رجال النجاشي (2).(@)(@@)(@@)(@@) $ 4885 / 529 - محمد بن عبيد الكوفي:(@)(@@) الحذاء، من أصحاب الصادق عليه السلام، رجال الشيخ (3).(@)(@@)(@@)(@@) $ 4886 / 530 - محمد بن عبيد بن مدرك:(@)(@@) الحارثي الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (4).(@)(@@)(@@)(@@) $ 4887 / 531 - محمد بن عبيد بن نسطاس:(@)(@@) المدني، أسند عنه، من أصحاب الصادق عليه السلام، رجال الشيخ (5).(@)(@@)(@@)(@@) $ 4888 / 532 - محمد بن عبيد الله أبي القاسم:(@)(@@) ذكرناه بعنوان: محمد بن أبي القاسم (6).(@)(@@)(@@)(@@) $ 4889 / 533 - محمد بن عبيد الله (7) بن أبي رافع:(@)(@@) روى عنه: علي بن القاسم الكندي، رجال النجاشي (8).(@)(@@) PageV04P259(@)(@@)(@@)(@@) $ 4890 / 534 - محمد بن عبيد الله بن أبي سليمان:(@)(@@) العرزمي الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (1).(@)(@@)(@@)(@@) $ 4891 / 535 - محمد بن عبيد الله بن أحمد:(@)(@@) ابن محمد بن سليمان بن الحسن بن الجهم بن بكير بن أعين، أبو طاهر الزراري، كان أديبا وسمع، هو ابن ابن أبي غالب، شيخنا، له كتب، رجال النجاشي (2).(@)(@@) وقد نقلنا عند ترجمة جده أحمد بن محمد بن سليمان بعض أحواله (3).(@)(@@)(@@)(@@) $ 4892 / 536 - محمد بن عبيد الله الحقيبي (4):(@)(@@) العلوي الحسني المدني، له كتاب، روى عنه: الحسين بن الحسن بن موسى، رجال النجاشي (5) (6).(@)(@@)(@@)(@@) $ 4893 / 537 - محمد بن عبيد الله الطاهي:(@)(@@) من أهل الطاهي، من أصحاب الهادي عليه السلام، رجال الشيخ (7).(@)(@@)(@@)(@@) $ 4894 / 538 - محمد بن عبيد الله بن مروان:(@)(@@) الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (8).(@)(@@) PageV04P260(@)(@@)(@@)(@@) $ 4895 / 539 - محمد بن عبيدة الحذاء:(@)(@@) الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (1).(@)(@@) ويحتمل أن يكون هذا هو المذكور من قبل بعنوان: محمد بن عبيد الكوفي الحذاء (2).(@)(@@)(@@)(@@) $ 4896 / 540 - محمد بن عبيدة الفزاري:(@)(@@) كوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (3).(@)(@@)(@@)(@@) $ 4897 / 541 - محمد بن عتبة الزغيلي (4):(@)(@@) من أصحاب الصادق عليه السلام، رجال الشيخ (5).(@)(@@)(@@)(@@) $ 4898 / 542 - محمد 
ms534	 بن عتبة السراج:(@)(@@) مولى بني حنيفة، الكوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (6).(@)(@@)(@@)(@@) $ 4899 / 543 - محمد بن عثمان:(@)(@@) أخو حماد، قال ابن عقدة عن علي بن الحسن، إنه ثقة، الخلاصة (7).(@)(@@)(@@)(@@) $ 4900 / 544 - محمد بن عثمان بن ربيعة:(@)(@@) ابن أبي عبد الرحمن المدني، مولى آل المنكدر، واسم أبي عبد الرحمن(@)(@@) PageV04P261(@)(@@) فروخ، وربيعة هو الذي يقال له: ربيعة الرأي، من أصحاب الصادق عليه السلام، رجال الشيخ (1).(@)(@@)(@@)(@@) $ 4901 / 545 - محمد بن عثمان بن زيد:(@)(@@) الجهني الكوفي، أبو عمارة (2)، من أصحاب الصادق عليه السلام، رجال الشيخ (3).(@)(@@)(@@)(@@) $ 4902 / 546 - محمد بن عثمان بن سعيد:(@)(@@) العمري، يكنى أبا جعفر، وأبوه يكنى أبا عمرو، جميعا وكيلان من جهة صاحب الزمان عليه السلام، ولهما منزلة جليلة عند الطائفة، في من لم يرو عن الأئمة عليهم السلام، رجال الشيخ (4).(@)(@@) وقال العلامة في الخلاصة: كان محمد قد حفر لنفسه قبرا وسواه بالساج، فسئل عن ذلك فقال: للناس (5) أسباب، ثم سئل بعد ذلك فقال:(@)(@@) قد امرت أن أجمع أمري! فمات بعد ذلك بشهرين في جمادي الأول (6) سنة خمس وثلاثمائة، وقيل: إنه سنة أربع وثلاثمائة.(@)(@@) وكان يتولى هذا الأمر نحوا من خمسين سنة، وقال عند موته: امرت أن أوصي إلى أبي القاسم بن روح، وأوصى إليه، وأوصى أبو القاسم (7) بن روح إلى أبي الحسن علي بن محمد السمري، فلما حضرت السمري الوفاة(@)(@@) PageV04P262(@)(@@) سئل أن يوصي فقال: لله أمر هو بالغه.(@)(@@) والغيبة الثانية هي التي وقعت بعد مضي السمري (1)، انتهى.(@)(@@) ثم إعلم أن الذي يظهر من الكشي ورجال الشيخ وغيرهما أن العمري المشهور الوكيل اسمه حفص بن عمرو، وأن أبا جعفر المشهور بابن العمري الذي وكيل الناحية ابنه واسمه محمد بن حفص (2).(@)(@@) والذي يظهر من كلام الشيخ قدس سره هنا وعند ترجمة عثمان بن سعيد أن (3) العمري المشهور الوكيل اسمه عثمان بن سعيد، وأن أبا جعفر المشهور بابن العمري الوكيل ابنه واسمه محمد بن عثمان، ويبعد أن يكونا رجلين مشتركين في هذه الصفات.(@)(@@) ولم أجد عثمان بن سعيد في النجاشي والكشي (4)، نعم 
ms535	 في رجال الشيخ وفي كتب من تأخر عنه موجود (5)، والله أعلم بحقيقة الأمور (6).(@)(@@)(@@)(@@) $ 4903 / 547 - محمد بن عثيم الكوفي:(@)(@@) أسند عنه، من أصحاب الصادق عليه السلام، رجال الشيخ (7) (8).(@)(@@) PageV04P263(@)(@@)(@@)(@@) $ 4904 / 548 - محمد بن عجلان (1) الكوفي من أصحاب الصادق عليه السلام، رجال الشيخ (2)(@)(@@)(@@)(@@) $ 4905 / 549 - محمد بن عجلان المدني القرشي من أصحاب الباقر (3) والصادق (4) عليهما السلام، رجال الشيخ.(@)(@@)(@@)(@@) $ 4906 / 550 - محمد بن عذافر بن عيسى:(@)(@@) الصيرفي المدائني، ثقة، روى عن أبي عبد الله وأبي الحسن عليهما السلام وعمر إلى أيام الرضا عليه السلام (5) له كتاب تختلف (6) الرواة عنه فيه.(@)(@@) قال ابن نوح: هو محمد بن عذافر بن عيسى بن أفلح الخزاعي الصيرفي، أبوه عذافر كوفي يكنى أبا محمد مولى خزاعة، وأخوه عمر بن عيسى.(@)(@@) روى عنه: عمرو بن عثمان، رجال النجاشي (7).(@)(@@) له كتاب (8)، روى عنه: محمد بن إسماعيل بن بزيع، الفهرست (9).(@)(@@) محمد بن عذافر بن عثيم (10) الخزاعي الصيرفي، كوفي، مولى، من(@)(@@) PageV04P264(@)(@@) أصحاب الصادق عليه السلام، رجال الشيخ (1). ثم قال: محمد بن عذافر الصيرفي، من أصحاب الصادق عليه السلام (2).(@)(@@) ثم قال: محمد بن عذافر، له كتاب، ثقة، من أصحاب الكاظم عليه السلام (3).(@)(@@) ولعل الجميع واحد كما يظهر من النجاشي.(@)(@@)(@@)(@@) $ 4907 / 551 - محمد بن عرفة:(@)(@@) روى الكليني عن علي بن إبراهيم، عن محمد بن عيسى، عن محمد ابن عرفة قال: قال لي الرضا عليه السلام: ويحك يا ابن عرفة اعملوا لغير رياء ولا سمعة، فإنه من عمل لغير الله وكله الله إلى ما عمل، ويحك ما عمل أحد عملا إلا رده الله به (4) إن خيرا فخيرا وإن شرا فشرا (5).(@)(@@)(@@)(@@) $ 4908 / 552 - محمد بن عصام (6) الأنماطي:(@)(@@) كوفي، له كتاب، روى عنه: أبو جعفر محمد بن أحمد بن رجاء البجلي، رجال النجاشي (7).(@)(@@)(@@)(@@) $ 4909 / 553 - محمد بن عطية (الحناط) (8):(@)(@@) أخو الحسن وجعفر، كوفي، روى عن الصادق عليه السلام وهو صغير، له(@)(@@) PageV04P265(@)(@@) كتاب، روى عنه: ابن أبي عمير، رجال النجاشي (1). وهو أربع نسخ عندي.(@)(@@) وما ذكره العلامة في الخلاصة في باب الضعفاء عبارة النجاشي بعينها إلا أنه ذكر 
ms536	 في موضع وهو صغير: وهو ضعيف (2).(@)(@@) وكذا ذكره ابن داود (3)، ولعله تصحيف، ويؤيده أن النجاشي وثقه عند ترجمة أخيه الحسن حيث قال: الحسن بن عطية الحناط، كوفي، مولى، ثقة وأخواه أيضا محمد وعلي كلهم رووا عن الصادق عليه السلام، وهو الحسن بن عطية الدغشي المحاربي، أبو ناب (4).(@)(@@) ولما وجده العلامة قدس سره عند ذكر أخيه الحسن موثقا ذكره في باب الثقات أيضا ووثقه (5).(@)(@@)(@@)(@@) $ 4910 / 554 - محمد بن عطية:(@)(@@) عداده في الحجازيين، روى عن النبي صلى الله عليه وآله أنه قال: من أشراط الساعة أن يخرب العامر وأن يعمر الخراب، من أصحاب الرسول صلى الله عليه وآله، رجال الشيخ (6).(@)(@@)(@@)(@@) $ 4911 / 555 - محمد بن عقبة المدني:(@)(@@) من أصحاب الصادق عليه السلام، رجال الشيخ (7).(@)(@@) PageV04P266(@)(@@)(@@)(@@) $ 4912 / 556 - محمد بن عقبة:(@)(@@) مولى أبي جعفر [عليه السلام] (1)، كوفي، من أصحاب الصادق عليه السلام، رجال الشيخ (2).(@)(@@)(@@)(@@) $ 4913 / 557 - محمد بن عقيل الكليني:(@)(@@) من العدة الذين روى محمد بن يعقوب عنهم عن سهل بن زياد (3).(@)(@@)(@@)(@@) $ 4914 / 558 - محمد بن علي بن إبراهيم:(@)(@@) ابن محمد الهمذاني (4)، روى عن أبيه عن جده عن الرضا عليه السلام، وروى إبراهيم بن هاشم عن إبراهيم بن محمد الهمذاني عن الرضا عليه السلام، أخبرني أبو العباس أحمد بن (5) علي بن نوح قال: حدثنا أبو القاسم جعفر ابن محمد قال: حدثنا القاسم بن محمد بن علي بن إبراهيم بن محمد الذي تقدم ذكره وكيل الناحية، وأبوه وكيل الناحية، وجده علي وكيل الناحية، وجد أبيه إبراهيم بن محمد وكيل.(@)(@@) قال: وكان في وقت القاسم بهمذان معه أبو علي بسطام بن علي والعزيز (6) بن زهير وهو أحد بني كشمرد وثلاثتهم وكلاء في موضع واحد بهمذان، وكانوا يرجعون في هذا إلى أبي محمد الحسن بن هارون بن عمران الهمذاني وعن رأيه يصدرون، ومن قبله عن رأي أبيه أبي عبد الله هارون، وكان أبو عبد الله وابنه أبو محمد وكيلين.(@)(@@) PageV04P267(@)(@@) ولمحمد بن علي نوادر، روى عنه: ابنه القاسم بن محمد، رجال النجاشي (1).(@)(@@)(@@)(@@) $ 4915 / 559 - محمد بن علي بن إبراهيم: 
ms537	(@)(@@) ابن موسى، أبو جعفر القرشي، مولاهم، صيرفي، ابن أخت خلاد المقرئ وهو خلاد بن عيسى، وكان يلقب محمد بن علي أبا سمينة، ضعيف جدا، فاسد الاعتقاد، لا يعتمد في شئ.(@)(@@) وكان ورد قم وقد اشتهر بالكذب بالكوفة، ونزل على أحمد بن محمد بن عيسى (مدة، ثم تشهر بالغلو فجفي، وأخرجه أحمد بن محمد ابن عيسى) (2) عن قم، وله قصة.(@)(@@) له كتب، روى عنه: محمد بن أبي القاسم ماجيلويه وجعفر بن عبد الله المحمدي، رجال النجاشي (3).(@)(@@) محمد بن علي الصيرفي الكوفي (4)، يكنى أبا سمينة، له كتب، وقيل: إنها مثل كتب الحسين بن سعيد (5)، الفهرست (6) (7).(@)(@@) PageV04P268(@)(@@) كوفي، كذاب، غال، وكان شهيرا في الارتفاع، لا يلتفت إليه ولا يكتب حديثه، رجال ابن الغضائري (1).(@)(@@) ذكر الفضل بن شاذان في بعض كتبه: الكذابون المشهورون أبو الخطاب ويونس بن ظبيان ويزيد الصائغ ومحمد بن سنان وأبو سمينة أشهرهم، رجال الكشي (2).(@)(@@)(@@)(@@) $ 4916 / 560 - محمد بن علي بن إبراهيم:(@)(@@) الهمذاني، أبو جعفر، كانت لأبيه وصلة بأبي الحسن [عليه السلام] (3)، وحديثه يعرف وينكر، وروى عن الضعفاء كثيرا، ويعتمد المراسيل، رجال ابن الغضائري (4).(@)(@@) محمد بن علي الهمذاني، له كتاب (5)، روى عنه: أبو عبد الله بن عبد الله الملقب بماجيلويه. قال ابن بطة: هو أبو سمينة، الفهرست (6).(@)(@@) والذي يظهر من الفهرست وكتاب ابن الغضائري والخلاصة وكتاب ابن داود أنهما رجلان (7).(@)(@@) وأبو سمينة هو المذكور قبيل هذا.(@)(@@) PageV04P269(@)(@@) وقال الشيخ في الرجال: محمد بن علي الهمذاني، ضعيف، روى عنه: محمد بن أحمد بن يحيى، في من لم يرو عن الأئمة عليهم السلام (1).(@)(@@) ونبه النجاشي والشيخ في الفهرست على ضعفه عند ترجمة محمد ابن أحمد بن يحيى (2).(@)(@@)(@@)(@@) $ 4917 / 561 - محمد بن علي بن أبي الحسن:(@)(@@) الحسيني العاملي رحمه الله، سيد من ساداتنا، وشيخ من مشايخنا، وفقيه من فقهائنا رضي الله عنهم.(@)(@@) مات عن قرب إلا أنه كان بالشام، ولم يتفق لقائي إياه، له كتب (3).(@)(@@)(@@)(@@) $ 4918 / 562 - محمد بن علي بن أبي شعبة:(@)(@@) الحلبي، أبو جعفر، وجه أصحابنا وفقيههم، والثقة الذي لا يطعن عليه، هو وإخوته 
ms538	 عبيد الله وعمران وعبد الأعلى، له كتاب التفسير، روى عنه: صفوان، وله كتاب مبوب في الحلال والحرام، روى عنه: ابن مسكان، رجال النجاشي (4).(@)(@@) له كتاب (5)، وهو ثقة، روى عنه: أبو جميلة المفضل بن صالح، الفهرست (6).(@)(@@) PageV04P270(@)(@@) من أصحاب الصادق عليه السلام، رجال الشيخ (1).(@)(@@) وذكره ابن داود مرة راويا عن النجاشي (2)، ومرة عن الشيخ (3) (4).(@)(@@)(@@)(@@) $ 4919 / 563 - محمد بن علي بن أحمد:(@)(@@) ابن هشام القمي، يكنى أبا جعفر، روى عن محمد بن علي ماجيلويه، روى عنه: ابن نوح، في من لم يرو عن الأئمة عليهم السلام، رجال الشيخ (5).(@)(@@)(@@)(@@) $ 4920 / 564 - محمد بن علي بن بلال:(@)(@@) ثقة، من أصحاب العسكري عليه السلام، رجال الشيخ (6) (7).(@)(@@) وذكره العلامة في الخلاصة في باب الثقات ووثقه، ثم قال: قال الشيخ في كتاب الغيبة: من المذمومين أبو طاهر محمد بن علي بن بلال.(@)(@@) فنحن في روايته من المتوقفين (8). ثم ذكره في باب الضعفاء ولم يوثقه، ونقل عن الشيخ أنه من المذمومين (9).(@)(@@) وكذا ذكره ابن داود مرتين إلا أنه ذكر أولا راويا عن رجال الشيخ أنه روى عن العسكري عليه السلام (10)، وذكر ثانيا راويا عن رجال الشيخ أيضا أنه(@)(@@) PageV04P271(@)(@@) لم (1). ولم أجد في رجال الشيخ إلا كما نقلناه (2).(@)(@@) وفي ربيع الشيعة: أنه كان من السفراء الموجودين في الغيبة الصغرى والأبواب المعروفين الذين لا تختلف الإمامية القائلون بإمامة الحسن بن علي [عليهما السلام] فيهم (3).(@)(@@)(@@)(@@) $ 4921 / 565 - محمد بن علي التستري:(@)(@@) من أهل تستر، من أصحاب العسكري عليه السلام، رجال الشيخ (4).(@)(@@)(@@)(@@) $ 4922 / 566 - محمد بن علي بن جاك:(@)(@@) قمي، يكنى بأبي طاهر، ثقة، قليل الحديث، ذكر ذلك أبو العباس، من أهل القرآن، فاضل، له كتاب الحكمين، روى عنه: أحمد بن محمد الأيادي، رجال النجاشي (5).(@)(@@) وفي الخلاصة في موضع قمي: تيمي (6).(@)(@@) وفي رجال ابن داود كما في النجاشي (7)، ولعله الصواب.(@)(@@)(@@)(@@) $ 4923 / 567 - محمد بن علي بن جعفر:(@)(@@) من أصحاب الرضا عليه السلام، رجال الشيخ (8) (9).(@)(@@) PageV04P272(@)(@@) وقال ابن داود: محمد بن جعفر، ضا جخ، ابن عمه [عليه السلام] (1)، انتهى. وفيه ما لا يخفى (2) (3).(@)(@@)(@@)(@@) $ 4924 / 568 
ms539	 - محمد بن علي بن الحسين:(@)(@@) ابن زيد بن علي بن الحسين بن علي بن أبي طالب عليهم السلام، له نسخة يرويها عن الرضا عليه السلام، روى عنه: جعفر بن محمد الحسني، رجال النجاشي (4).(@)(@@)(@@)(@@) $ 4925 / 569 - محمد بن علي بن الحسين:(@)(@@) ابن موسى بن بابويه القمي، أبو جعفر (5)، نزيل الري، شيخنا وفقيهنا ووجه الطائفة بخراسان، وكان ورد بغداد سنة خمس وخمسين(@)(@@) PageV04P273(@)(@@) وثلاثمائة وسمع منه (1) شيوخ الطائفة وهو حدث السن.(@)(@@) وله كتب كثيرة، أخبرني بجميع كتبه، وقرأت بعضها على والدي علي بن أحمد بن العباس النجاشي رحمه الله، وقال لي: أجازني جميع كتبه لما سمعنا منه ببغداد.(@)(@@) ومات رضي الله عنه بالري سنة إحدى وثمانين وثلاثمائة، رجال النجاشي (2).(@)(@@) كان جليلا، حافظا للأحاديث، بصيرا بالرجال، ناقدا للأخبار، لم ير في القميين مثله في حفظه وكثرة علمه، له نحو من ثلاثمائة مصنف، أخبرني بجميع كتبه ورواياته: جماعة من أصحابنا، منهم: الشيخ أبو عبد الله محمد بن محمد بن النعمان وأبو عبد الله الحسين بن عبيد الله وأبو الحسين جعفر بن الحسن بن حسكة القمي وأبو زكريا محمد بن سليمان الحمراني كلهم عنه، الفهرست (3).(@)(@@) جليل القدر، حفظة، بصير بالفقه والأخبار والرجال، له مصنفات (4)، روى عنه: التلعكبري، في من لم يرو عن الأئمة عليهم السلام، رجال الشيخ (5) (6).(@)(@@)(@@)(@@) $ 4926 / 570 - محمد بن علي بن حمزة:(@)(@@) ابن الحسن بن عبيد الله بن العباس بن علي بن أبي طالب عليه السلام، أبو عبد الله، ثقة، عين في الحديث، صحيح الاعتقاد، له رواية عن أبي الحسن(@)(@@) PageV04P274(@)(@@) وأبي محمد عليهما السلام واتصال مكاتبة، وفي داره حصلت (1) أم صاحب الأمر عليه السلام بعد وفاة الحسن عليه السلام، له كتاب، روى عنه: حمزة بن القاسم، رجال النجاشي (2) (3).(@)(@@)(@@)(@@) $ 4927 / 571 - محمد بن علي بن حيان:(@)(@@) الجعفي الكوفي، أسند عنه، من أصحاب الصادق عليه السلام، رجال الشيخ (4).(@)(@@)(@@)(@@) $ 4928 / 572 - محمد بن علي الذراع:(@)(@@) من أصحاب العسكري عليه السلام، رجال الشيخ (5).(@)(@@)(@@)(@@) $ 4929 / 573 - محمد بن علي بن الربيع:(@)(@@) السلمي الكوفي (6)، من أصحاب الصادق عليه السلام، رجال 
ms540	 الشيخ (7).(@)(@@)(@@)(@@) $ 4930 / 574 - محمد بن علي الشلمغاني:(@)(@@) أبو جعفر، المعروف بابن أبي العزاقر (8)، كان مقدما في أصحابنا، فحمله الحسد لأبي القاسم الحسين بن روح على ترك المذهب والدخول في المذاهب الردية حتى خرجت فيه توقيعات، فأخذه السلطان وقتله(@)(@@) PageV04P275(@)(@@) وصلبه، وله كتب، روى عنه: أبو المفضل محمد بن عبد الله بن المطلب، رجال النجاشي (1).(@)(@@) له كتب وروايات وكان مستقيم الطريقة ثم تغير وظهرت منه مقالات منكرة إلى أن أخذه السلطان وقتله وصلبه ببغداد، وله من الكتب التي عملها في حال الاستقامة كتاب التكليف، أخبرنا به: جماعة، عن محمد بن علي ابن الحسين، عن أبيه، عنه إلا حديثا منه في باب الشهادات إنه يجوز للرجل أن يشهد لأخيه إذا كان له شاهد واحد من غير علم، الفهرست (2).(@)(@@)(@@)(@@) $ 4931 / 575 - محمد بن علي بن شهرآشوب:(@)(@@) المازندراني رشيد الدين، شيخ في هذه الطائفة وفقيهها، وكان شاعرا بليغا منشئا، روى عنه: محمد بن عبد الله بن زهرة، وروى عن (3) محمد وعلي ابني عبد الصمد، له كتب، منها: كتاب الرجال، وكتاب (4) أنساب آل أبي طالب عليهم السلام.(@)(@@)(@@)(@@) $ 4932 / 576 - محمد بن علي الصيرفي:(@)(@@) أبو سمينة. تقدم بعنوان: محمد بن علي بن إبراهيم بن موسى (5) (6).(@)(@@) PageV04P276(@)(@@)(@@)(@@) $ 4933 / 577 - محمد بن علي بن عبدك:(@)(@@) أبو جعفر الجرجاني، جليل القدر، من أصحابنا، فقيه، متكلم، له كتب، رجال النجاشي (1).(@)(@@) وفي الخلاصة في موضع فقيه متكلم: ثقة متكلم (2).(@)(@@) وفي رجال ابن داود كما في النجاشي (3)، ولعله الصواب.(@)(@@) وسيجئ بعنوان: ابن عبدك مع بعض أحواله (4).(@)(@@)(@@)(@@) $ 4934 / 578 - محمد بن علي بن عيسى:(@)(@@) القمي (5)، كان وجها بقم وأميرا عليها من قبل السلطان، وكذلك كان أبوه، يعرف بالطلحي، له مسائل لأبي محمد العسكري عليه السلام، روى عنه:(@)(@@) محمد بن أحمد بن زياد، رجال النجاشي (6).(@)(@@) له مسائل (7)، روى عنه: أحمد بن ذكرى وعنقويه، الفهرست (8).(@)(@@) وفيه أيضا: محمد بن علي الطلحي، له مسائل، روى عنه: أحمد بن محمد ابن عيسى (9). ولعلهما واحد (10).(@)(@@) PageV04P277(@)(@@)(@@)(@@) $ 4935 / 579 - محمد بن علي بن الفضل:(@)(@@) ابن تمام بن سكين، وكان لقب سكين بسبب 