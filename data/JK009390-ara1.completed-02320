ms2301	 ، ولا يأتينا يمسح جبهته ) )(@)(@@) عبد الرزاق عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21473 ) قال النبي :(@)(@@) | 30 ( من أكل من هاذه الشجرة فلا يؤذينا بها ) )(@)(@@) أبو أحمد الحاكم وابن عساكر عن خزيمة بن ثابت قال أبو أحمد : غريب من حديثه .(@)(@@)(@@)(@@) $ ( 21474 ) قال النبي :(@)(@@) | 30 ( من أكل من هاتين الشجرتين فلا يقربن مسجدنا ) )(@)(@@) ابن خزيمة والطحاوي ( طب ض ) عن عبد الله بن زيد بن عاصم رضي الله عنه .(@)(@@) PageV07P143(@)(@@)(@@)(@@) $ ( 21475 ) قال النبي :(@)(@@) | 30 ( من أكل من هاذه البقلة الخبيثة فلا يقربنا ) )(@)(@@) ( حم طب ) عن أبي ثعلبة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21476 ) قال النبي :(@)(@@) | 30 ( من أكل من هاذه البقلة يعني الثوم فلا يقربن مسجدنا ) )(@)(@@) الطحاوي والبغوي والباوردي وابن السكن وابن قانع ( طب ) وأبو نعيم عن بشير بن معبد الأسلمي عن أبيه وابن السكن عن محمد بن بشير عن أبيه عن جده بشير بن معبد قال البغوي : لا أعلم له غيره وغير حديث بئر رومة ( طب ) عن خزيمة بن ثابت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21477 ) قال النبي :(@)(@@) | 30 ( من أكل من هاذه البقلة المنكرة يعني الثوم فليجلس في بيته ) )(@)(@@) ( ن ) عن ثوبان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21478 ) قال النبي :(@)(@@) | 30 ( من أكل من هاذه الشجرة الخبيثة فلا يناجينا ) )(@)(@@) ابن سعد عن بشر بن بشير الأسلمي عن أبيه .(@)(@@)(@@)(@@) $ ( 21479 ) قال النبي :(@)(@@) | 30 ( من أكل برقية باطل فقد أكلت برقية حق ) )(@)(@@) ابن قانع عن خارجة بن الصلت عن عمه الحارث بن عمرو البرجمي رضي الله عنه قال : رقيت رجلا بأم الكتاب فبرأ فسألت النبي قال : فذكره .(@)(@@)(@@)(@@) $ ( 21480 ) قال النبي :(@)(@@) | 30 ( من أكل مما يسقط من المائدة لم يزل في سعة من الرزق ، ووقي الحمق وولده وولد ولده ) )(@)(@@) الباوردي عن الحجاج بن علاط السلمي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21481 ) قال النبي :(@)(@@) | 30 ( من أكل مما يسقط من الخوان نفي عنه الفقر ، ونفي عن ولده الحمق ) )(@)(@@) الحسن بن معروف في فضائل بني هاشم ، الخطيب وابن النجار عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21482 ) قال النبي :(@)(@@) | 30 ( من أكل مما يسقط من الخوان 
ms2302	 فرزق أولادا كانوا PageV07P144 صباحا ) )(@)(@@) الشيرازي في الألقاب والخطيب وابن عساكر عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21483 ) قال النبي :(@)(@@) | 30 ( من أكل قبل أن يشرب وتسحر ومس شيئا من الطيب قوي على الصيام ) )(@)(@@) ( هب ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21484 ) قال النبي :(@)(@@) | 30 ( من أكل بأخيه المسلم أكلة أطعمه الله بها أكلة من النار ، ومن لبس بأخيه المسلم ثوبا في الدنيا ألبسه الله يوم القيامة ثوبا من نار ، ومن سمع بأخيه المسلم سمع الله به يوم القيامة ) )(@)(@@) ابن أبي الدنيا في ذم الغيبة عن الحسن مرسلا ، ومن وجه آخر عن أنس رضي الله عنه موقوفا .(@)(@@)(@@)(@@) $ ( 21485 ) قال النبي :(@)(@@) | 30 ( من أكل أو شرب أو رمى صيدا ، فنسي أن يذكر اسم الله فليأكل منه ما لم يدع التسمية متعمدا ) )(@)(@@) ( طب ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21486 ) قال النبي :(@)(@@) | 30 ( من أكل بشماله أكل معه الشيطان ، ومن شرب بشماله شرب معه الشيطان ) )(@)(@@) ( حم ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 21487 ) قال النبي :(@)(@@) | 30 ( من أكل من أجور بيوت مكة شيئا فإنما يأكل نارا ) )(@)(@@) الديلمي عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21488 ) قال النبي :(@)(@@) | 30 ( من أكل لقمة من حرام لم يقبل له صلاة أربعين ليلة ، ولم تستجب له دعوة أربعين صباحا ، وكل لحم منبته الحرام فالنار أولى به ، وإن اللقمة الواحدة من الحرام لتنبت اللحم ) )(@)(@@) الديلمي عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21489 ) قال النبي :(@)(@@) | 30 ( من أكل طعاما فما تخلل فليلفظ ، وما لاك بلسانه PageV07P145 فليبلغ ، من فعل فقد أحسن ، ومن لا فلا حرج ) )(@)(@@) ( هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21490 ) قال النبي :(@)(@@) | 30 ( من أكل فليأكل بيمينه ) )(@)(@@) الشاشي ( ع ص ) عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21491 ) قال النبي :(@)(@@) | 30 ( من أكل درهم ربا فهو مثل ثلاث وثلاثين زنية ) )(@)(@@) ( كر ) عن محمد بن حمير عن إبراهيم بن أبي عيلة عن عكرمة عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21492 ) قال النبي :(@)(@@) | 30 ( من أكل سبع تمرات مما بين لابتي المدينة على الريق لم 
ms2303	 يضره يومه ذالك ، سم ولا سحر ، وإن أكلها حين يمسي لم يضره سم حتى يصبح ) )(@)(@@) ( حم ) عن عامر بن سعد عن أبيه .(@)(@@)(@@)(@@) $ ( 21493 ) قال النبي :(@)(@@) | 30 ( من أكل طعاما ثم قال : الحمد لله الذي أطعمني هاذا الطعام ورزقنيه من غير حول مني ولا قوة غفر له ما تقدم من ذنبه ) )(@)(@@) ( حم د ت ) حسن غريب ( ه طب ) و ابن السني ، ( ك ) عن سهل بن معاذ بن أنس عن أبيه .(@)(@@)(@@)(@@) $ ( 21494 ) قال النبي :(@)(@@) | 30 ( من أكل في شهر رمضان ناسيا فلا قضاء عليه ، إن الله أطعمه وسقاه ) )(@)(@@) ( قط ) وضعفه عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21495 ) قال النبي :(@)(@@) | 30 ( من أكل في قصعة ثم لحسها استغفرت له القصعة وصلت عليه ) )(@)(@@) الحكيم عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21496 ) قال النبي :(@)(@@) | 30 ( من أكلها وهو يعلم أنها سرقة فقد أشرك في إثم سارقها ) )(@)(@@) ( طب ) عن ميمونة بنت سعد رضي الله عنها .(@)(@@) PageV07P146(@)(@@)(@@)(@@) $ ( 21497 ) قال النبي :(@)(@@) | 30 ( من ألبسه الله نعمه فليكثر من الحمد لله ، ومن كثرت همومه فليستغفر الله ، ومن أبطأ عليه رزقه فليكثر من قول لا حول ولا قوة إلا بالله ، ومن نزل مع قوم فلا يصم إلا بإذنهم ، ومن دخل دار قوم فليجلس حيث أمروه ، فإن القوم أعلم بعورة دارهم ، وإن من الذنب المسخوط به على صاحبه الحقد والحسد والكسل في العبادة والضنك في المعيشة ) )(@)(@@) ( طس ) و ابن عساكر عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21498 ) قال النبي :(@)(@@) | 30 ( من التقط لقطة فليشهد ذوي عدل ثم لا يكتم ولا يغير ، فإن جاء صاحبها فهو أحق بها ، وإلا فهو مال الله يؤتيه من يشاء ) )(@)(@@) ( حب ) عن عياض بن حماد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21499 ) قال النبي :(@)(@@) | 30 ( من التقط لقطة سترة ثوب أو يشبهه فليعرفه ثلاثة أيام ، ومن التقط أكثر من ذالك فليعرفه سبعة أيام ، فإن جاء صاحبها وإلا فليتصدق بها ، فإن جاء صاحبها فليخبره ) )(@)(@@) ( حم طب هق ) عن يعلى بن مرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21500 ) قال النبي :(@)(@@) | 30 ( من التمس رضى الله بسخط 
ms2304	 الناس رضي الله عنه وأرضى عنه الناس ، ومن التمس رضى الناس بسخط الله سخط الله عليه وأسخط عليه الناس ) )(@)(@@) ( حب ) ابن عساكر عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 21501 ) قال النبي :(@)(@@) | 30 ( من التقط لقطة فليعرفها سنة ، فإن جاء ربها وإلا فليعرف عددها ووكاءها ثم ليأكلها فإن جاء صاحبها فليردها عليه ) )(@)(@@) ( هق ) عن زيد بن خالد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21502 ) قال النبي :(@)(@@) | 30 ( من التقط الطعام الساقط غفر الله ذنوبه ) )(@)(@@) أبو الشيخ عن نبيشة الخير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21503 ) قال النبي :(@)(@@) | 30 ( من التمس محامد الناس بمعاصي الله عاد حامده PageV07P147 من الناس له ذاما ) )(@)(@@) ابن لال والخرائطي في مساوىء الأخلاق عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 21504 ) قال النبي :(@)(@@) | 30 ( من ألطف مؤمنا أو قام له بحاجة من حوائج الدنيا والآخرة ، صغر ذالك أو كبر ، كان حقا على الله أن يخدمه خادما يوم القيامة ) )(@)(@@) ابن أبي الدنيا في قضاء الحوائج عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21505 ) قال النبي :(@)(@@) | 30 ( من أماط عن طريق المسلمين شيئا يؤذيهم كتب الله له به حسنة ) )(@)(@@) ( طب ) و ابن عساكر عن أبي الدرداء رضي الله عنه ، وفيه أبو بكر بن أبي مريم ضعيف .(@)(@@)(@@)(@@) $ ( 21506 ) قال النبي :(@)(@@) | 30 ( من أمر بالمعروف ونهى عن المنكر فهو خليفة الله في الأرض وخليفة كتابه وخليفة رسوله ) )(@)(@@) الديلمي عن ثوبان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21507 ) قال النبي :(@)(@@) | 30 ( من أم قوما فليخفف فإن فيهم الصغير والكبير والمريض وذا الحاجة ، فإذا صلى وحده فليصل كيف شاء ) )(@)(@@) ( حم ) عن عثمان بن أبي العاص رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21508 ) قال النبي :(@)(@@) | 30 ( من أم فليتق الله وليعلم أنه ضامن مسؤول ، لما ضمن ، وإذا أحسن كان له من الأجر مثل أجر من صلى خلفه من غير أن ينتقص من أجورهم شيء ، وما كان نقص فهو عليه ) )(@)(@@) ( طس ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21509 ) قال النبي :(@)(@@) | 30 ( من أم الناس فليقدر القوم بأضعفهم ، فإن فيهم الضعيف والكبير وذا الحاجة ) )(@)(@@) عبد الرزاق عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 21510 ) قال النبي :(@)(@@) | 30 
ms2305	 ( من أمسى كالا من عمل يده أمسى مغفورا له ) )(@)(@@) ابن عساكر PageV07P148 عن سليمان بن علي بن عبد الله بن عباس عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 21511 ) قال النبي :(@)(@@) | 30 ( من انتدب خارجا في سبيل الله ابتغاء وجهه وتصديق وعده ، وإيمانا برسالاته ، على الله ضامن ، فإما يتوفاه في الجيش بأي حتف شاء فيدخله الجنة ، وإما أن يسيح في ضمان الله فإن طالت غيبته ، ثم يرده إلى أهله سالما مع ما نال من أجر وغنيمة ، ومن خرج في سبيل الله فمات أو قتل فهو شهيد وله الجنة ) )(@)(@@) ( هق ) عن أبي مالك الأشعري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21512 ) قال النبي :(@)(@@) | 30 ( من انتظر الصلاة فهو في صلاة ما لم يحدث ) )(@)(@@) ( ش حب ) عن سهل بن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21513 ) قال النبي :(@)(@@) | 30 ( من انتظر الصلاة فهو في صلاة ما لم يحدث ، تدعو له الملائكة : اللهم اغفر له ، اللهم ارحمه ) )(@)(@@) ابن جرير عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21514 ) قال النبي :(@)(@@) | 30 ( من انتفى من ولده ليفضحه في الدنيا ، فضحه الله يوم القيامة على رؤوس الأشهاد ، قصاص بقصاص ) )(@)(@@) ( حم طب حل ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21515 ) قال النبي :(@)(@@) | 30 ( من انتقص شبرا من الأرض ظلما طوقه الله إياه يوم القيامة من سبع أرضين ) )(@)(@@) ابن جرير ( طب ) عن سعيد بن زيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21516 ) قال النبي :(@)(@@) | 30 ( من انصرف غريمه من عنده وهو راض صلت عليه دواب الأرض ونون الماء ، ومن انصرف غريمه من عنده وهو ساخط عليه كتب عليه في كل يوم وليلة وجمعة وشهر ظلم ) )(@)(@@) الحسن بن سفيان عن خولة رضي الله عنه .(@)(@@) PageV07P149(@)(@@)(@@)(@@) $ ( 21517 ) قال النبي :(@)(@@) | 30 ( من انتهب نهبة ذات شرف أو آوى محدثا في الإسلام ، أو تولى مولى قوم بغير إذنهم ، فعليه لعنة الله لا صرف عنها ولا عدل ) )(@)(@@) ( عب ) عن عمرو بن شعيب معضلا .(@)(@@)(@@)(@@) $ ( 21518 ) قال النبي :(@)(@@) | 30 ( من أنصف الناس من نفسه ظفر بالجنة العالية ، ومن كان الفقر أحب إليه من الغنى فلو اجتهد عباد الحرمين أن 
ms2306	 يدركوا ما أعطي ما أدركوا ) )(@)(@@) الديلمي عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21519 ) قال النبي :(@)(@@) | 30 ( من أنظر معسرا أو وضع له وقاه الله من فيح جهنم ، ألا إن عمل الجنة حزن بربوة ثلاثا ، ألا إن عمل النار سهل بشهوة ، والسعيد من وقي الفتن ، وما من جرعة أحب إلى الله عز وجل من جرعة غيظ يكظمها عبد ، ما كظم عبد لله إلا ملأ الله جوفه إيمانا ) )(@)(@@) ( حم ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21520 ) قال النبي :(@)(@@) | 30 ( من أنظر معسرا أو وضع عنه كان في ظل الله أو في كنف الله يوم القيامة ) )(@)(@@) ابن النجار عن أبي اليسر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21521 ) قال النبي :(@)(@@) | 30 ( من أنظر معسرا أو يسر عليه أظله الله تعالى في ظله يوم لا ظل إلا ظله ) )(@)(@@) ( طب ) عن كعب بن عجرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21522 ) قال النبي :(@)(@@) | 30 ( من أنظر معسرا بعد حلول أجله كان له بكل يوم صدقة ) )(@)(@@) الخطيب عن زيد بن أرقم رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21523 ) قال النبي :(@)(@@) | 30 ( من أنعم على أخيه نعمة فلم يشكرها فدعا عليه استجيب له ) )(@)(@@) ( عق ) و ابن لال والشيرازي في الألقاب والخطيب عن ابن عباس رضي الله عنهما .(@)(@@) PageV07P150(@)(@@)(@@)(@@) $ ( 21524 ) قال النبي :(@)(@@) | 30 ( من أنعم الله عليه نعمة فإن الله يحب أن يرى أثر نعمته على عبده ) )(@)(@@) ( حم ) عن عمران بن حصين رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21525 ) قال النبي :(@)(@@) | 30 ( من أنعش حقا بلسانه جرى له أجره حتى يأتي الله يوم القيامة فيوفيه ثوابه ) )(@)(@@) ( سمويه حل ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21526 ) قال النبي :(@)(@@) | 30 ( من أنفق نفقة فاضلة في سبيل الله فبسبعمائة ضعف ، ومن أنفق على نفسه أو على أهله أو عاد مريضا ، أو أماط أذى عن الطريق ، أو تصدق فهي حسنة بعشر أمثالها ، والصوم جنة ما لم يخرقها ، ومن ابتلاه الله ببلاء في جسده فهو له حطة ) )(@)(@@) ( ط حم ) و ابن منيع والدارمي ( ع ) والشاشي وابن خزيمة ( ك هب هق ض ) عن أبي عبيدة بن الجراح رضي 
ms2307	 الله عنه .(@)(@@)(@@)(@@) $ ( 21527 ) قال النبي :(@)(@@) | 30 ( من أنفق نفقة على نفسه فهي صدقة وعلى امرأته وعلى ولده ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21528 ) قال النبي :(@)(@@) | 30 ( من أنفق على نفسه نفقة يستعف بها فهي له صدقة ، ومن أنفق على امرأته وولده وأهل بيته فهي له صدقة ) )(@)(@@) أبو الشيخ ( طس ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21529 ) قال النبي :(@)(@@) | 30 ( من أنفق زوجين من شيء من الأشياء في سبيل الله دعي من أبواب الجنة : يا عبد الله هاذا خير ، وللجنة ثمانية أبواب ، فمن كان من أهل الصلاة دعي من باب الصلاة ، ومن كان من أهل الجهاد دعي من باب الجهاد ومن كان من أهل الصدقة دعي من باب الصدقة ، ومن كان من أهل الصيام دعي من باب الريان ) )(@)(@@) ( حب ) عن أبي هريرة رضي الله عنه .(@)(@@) PageV07P151(@)(@@)(@@)(@@) $ ( 21530 ) قال النبي :(@)(@@) | 30 ( من أنفق على ابنتين أو أختين أو ذواتي قرابة يحتسب النفقة عليهما حتى يكفيهما الله أو يغنيهما من فضله كانتا له سترا من النار ) )(@)(@@) ( حب طب ) عن أم سلمة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 21531 ) قال النبي :(@)(@@) | 30 ( من انقطع إلى الله كفاه الله كل مؤونة ورزقه من حيث لا يحتسب ، ومن انقطع إلى الدنيا وكله الله إليها ) )(@)(@@) الحكيم وابن أبي حاتم ( طب هب ) والخطيب عن عمران بن حصين رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21532 ) قال النبي :(@)(@@) | 30 ( من أهان قريشا أهانه الله قبل موته ) )(@)(@@) ( طب ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21533 ) قال النبي :(@)(@@) | 30 ( من أهان سلطان الله في الأرض أهانه الله ، ومن أكرم سلطان الله في الأرض أكرمه الله عز وجل ) )(@)(@@) ( طب ) عن أبي بكرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21534 ) قال النبي :(@)(@@) | 30 ( من اهتم بجوعة أخيه المسلم فأطعمه حتى يشبع غفر الله له وسقاه حتى يروى ) )(@)(@@) ( ع ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21535 ) قال النبي :(@)(@@) | 30 ( من أهديت له هدية وعنده قوم فهم شركاؤه فيها ) )(@)(@@) ( عق طب حل هق ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21536 ) قال النبي :(@)(@@) | 30 ( من أهدى تطوعا 
ms2308	 ثم ضلت فإن شاء أبدلها وإن شاء ترك ، وإن كان في نذر فليبدل ) )(@)(@@) ( ك هق ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21537 ) قال النبي :(@)(@@) | 30 ( من انهمك في أكل البطن فقد أعان على نفسه ) )(@)(@@) ( كر هق ) وضعفه عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21538 ) قال النبي :(@)(@@) | 30 ( من انهمك في طلب العربية سلب الخشوع ) )(@)(@@) ابن السني عن ابن عباس رضي الله عنهما .(@)(@@) PageV07P152(@)(@@)(@@)(@@) $ ( 21539 ) قال النبي :(@)(@@) | 30 ( من أهل بالحج والعمرة من المسجد الأقصى إلى المسجد الحرام غفر له ما تقدم من ذنبه وما تأخر ووجبت له الجنة ) )(@)(@@) ( هق هب ) عن أم سلمة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 21540 ) قال النبي :(@)(@@) | 30 ( من أوتي ثلاثا فقد أوتي مثل ما أوتي آل داود : خشية الله في السر والعلانية ، والعدل في الغضب والرضى ، والقصد في الفقر والغنى ) )(@)(@@) ابن النجار عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21541 ) قال النبي :(@)(@@) | 30 ( من أوى إلى فراشه ثم قرأ : { تبارك الذي بيده الملك } ثم قال : اللهم رب الحل والحرم والبلد الحرام ، والركن والمقام والمشعر الحرام بلغ روح محمد تحية وسلاما أربع مرات ، وكل الله به ملكين حين يأتيا محمدا فيقولان له : إن فلان ابن فلان يقرأ عليك السلام ورحمة الله ، فأقول : على فلان بن فلان بن فلان مني السلام ورحمة الله وبركاته ) )(@)(@@) أبو الشيخ في الثواب ( ض ) وقال : غريب جدا عن أبي قرصافة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21542 ) قال النبي :(@)(@@) | 30 ( من أوى إلى فراشه فقال : الحمد لله الذي كفاني وآواني ، الحمد لله الذي أطعمني وسقاني ، الحمد لله من علي فأفضل ، أسألك بعزتك أن تنجيني من النار ، إلا حمد الله بمحامد الخلق كلها ) )(@)(@@) ابن جرير عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21543 ) قال النبي :(@)(@@) | 30 ( من أوقف دابة في سبيل الله من سبل المسلمين في أسواقهم فوطئت بيد أو رجل فهو ضامن ) )(@)(@@) ( هق ) وضعفه عن النعمان بن بشير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21544 ) قال النبي :(@)(@@) | 30 ( من أولى رجلا من بني عبد المطلب معروفا في PageV07P153 الدنيا فلم يقدر المطلبي على مكافأته فأنا 
ms2309	 أكافئه عنه يوم القيامة ) )(@)(@@) ( حل ) عن عثمان بن بشير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21545 ) قال النبي :(@)(@@) | 30 ( من أولى معروفا فليكافئه ، فإن لم يقدر عليه فليذكره ، فمن ذكره فقد شكره ، ومن شبع بما لم ينل فهو كلابس ثوبي زور ) )(@)(@@) ( هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21546 ) قال النبي :(@)(@@) | 30 ( من بات طاهرا بات في شعاره ملك ، ولا يستيقظ يستغفر ساعة من الليل إلا قال الملك : اللهم اغفر لعبدك فلان فإنه بات طاهرا ) )(@)(@@) البزار ( حب قط ) عن أبي هريرة ( ك ) في تاريخه عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21547 ) قال النبي :(@)(@@) | 30 ( من بات ليلة في خفة من الطعام والشراب يصلي تداكت حوله الحور العين حتى يصبح ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21548 ) قال النبي :(@)(@@) | 30 ( من بات طاهرا على ذكر الله لم يتعار ساعة من الليل يسأل الله فيها شيئا من أمر الدنيا والآخرة إلا أعطاه الله إياه ) )(@)(@@) ( طس ) عن أبي أمامة ، الخطيب في المتفق والمفترق عن عمرو بن عبسة رضي الله عنه وسنده حسن .(@)(@@)(@@)(@@) $ ( 21549 ) قال النبي :(@)(@@) | 30 ( من بات طاهرا على ذكر الله حتى يرجع إليه روحه ، لم يسأل الله تبارك وتعالى خيرا من الدنيا والآخرة إلا آتاه إياه ) )(@)(@@) الخرائطي في مكارم الأخلاق عن عمرو بن عبسة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21550 ) قال النبي :(@)(@@) | 30 ( من بات طاهرا على ذكر الله عز وجل لم يتعار ساعة من الليل يسأل الله فيها شيئا من أمور الدنيا والآخرة إلا أعطاه إياه ) )(@)(@@) ابن شاهين في الترغيب في الذكر ( خط ) في المتفق والمفترق وابن النجار عن عمرو بن عبسة رضي الله عنه .(@)(@@) PageV07P154(@)(@@)(@@)(@@) $ ( 21551 ) قال النبي :(@)(@@) | 30 ( من بات على ظهر بيت ليس عليه ما يستره فمات فلا ذمة له ، ومن ركب البحر حين يرتج فلا ذمة له ) )(@)(@@) أبو نعيم في المعرفة عن محمد بن زهير بن أبي جبل وقال : ذكره الحسن بن سفيان في الصحابة ولا أراه له صحبة .(@)(@@)(@@)(@@) $ ( 21552 ) قال النبي :(@)(@@) | 30 ( من باع نخلا قد أبرت فثمرها للبائع إلا 
ms2310	 أن يشترط المبتاع ) )(@)(@@) مالك ( عب خ م د ) عن ابن عمر ( ن ) عن عمر ، ( طب ) عن عبادة بن الصامت رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 21553 ) قال النبي :(@)(@@) | 30 ( من باع ثمر أرضه فأصابه جائحة فلا يأخذ من مال أخيه شيئا ، على م يأكل أحدكم مال أخيه المسلم ؟ ) )(@)(@@) ابن عساكر عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21554 ) قال النبي :(@)(@@) | 30 ( من باع عبدا وله مال فماله للبائع إلا أن يشترط المبتاع ) )(@)(@@) ( ش د ) عن ابن عمر ، ( د ن ) وابن جرير في تهذيبه ، والشاشي ( ض ) عن عمر ، ( ش ) عن علي موقوفا ، ( د ش ) عن جابر ، ( طب ) عن عبادة بن الصامت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21555 ) قال النبي :(@)(@@) | 30 ( من باع أرضا أو دارا فإن جار الأرض وجار الدار هو أحق بابتياعها إذا قام بثمنها ) )(@)(@@) ( طب ) عن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21556 ) قال النبي :(@)(@@) | 30 ( من باع شيئا فلا يحل له حتى يبين ما فيه ، ولا يحل لمن يعلم ذالك أن لا يبينه ) )(@)(@@) ( هق ) و الخطيب عن واثلة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21557 ) قال النبي :(@)(@@) | 30 ( من باع سلعة لم يكن قبض من ثمنها شيئا فهي له ، PageV07P155 فإن كان قد قبض من ثمنها شيئا فهو أسوة الغرماء ) )(@)(@@) ( الخطيب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21558 ) قال النبي :(@)(@@) | 30 ( من باع مملوكا وله مال وعليه دين فالدين على البائع إلا أن يشترط البائع على المشتري ) )(@)(@@) ( طب ) عن عبادة بن الصامت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21559 ) قال النبي :(@)(@@) | 30 ( من باع نخلا قد أبرت فلم يشترط المشتري الثمن فلا شيء له ، ومن باع عبدا وله مال فلم يشترط ماله فلا شيء له ) )(@)(@@) ( ط ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21560 ) قال النبي :(@)(@@) | 30 ( من باع عقدة وهو يجد بدا من بيعها وكل بذالك المال من يتلفه ) )(@)(@@) الحكيم عن عمران بن الحصين رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21561 ) قال النبي :(@)(@@) | 30 ( من باع عقدة مال سلط الله عليها تالفا يتلفها ) )(@)(@@) ( حم ) عن عمران بن حصين رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21562 ) قال النبي :(@)(@@) | 30 ( من باع 
ms2311	 عبدا وله مال ، فماله له وعليه دينه إلا أن يشترط المبتاع ، ومن أبر نخلا فباع بعد ما يؤبره فله ثمرته إلا أن يشترط المبتاع ) )(@)(@@) ( عد هق ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21563 ) قال النبي :(@)(@@) | 30 ( من باع عبدا وله مال فماله لسيده إلا أن يشترط الذي اشتراه ) )(@)(@@) ( ش ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21564 ) قال النبي :(@)(@@) | 30 ( من باع عبدا فماله للبائع إلا أن يشترط المبتاع يقول : اشتريته منك وماله ) )(@)(@@) ( ش ) عن عطاء وابن أبي مليكة معا مرسلا .(@)(@@) PageV07P156(@)(@@)(@@)(@@) $ ( 21565 ) قال النبي :(@)(@@) | 30 ( من باع عبدا وله مال فماله للبائع إلا أن يشترط المبتاع ، ومن باع نخلا قد أبرت فثمرتها للبائع إلا أن يشترط المبتاع ) )(@)(@@) ( هق ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21566 ) قال النبي :(@)(@@) | 30 ( من باع سلعة لرجل لم ينقده ثم أفلس الرجل ، فوجد سلعته بعينها فليأخذها دون الغرماء ) )(@)(@@) ( عب ) عن أبي مليكة مرسلا .(@)(@@)(@@)(@@) $ ( 21567 ) قال النبي :(@)(@@) | 30 ( من بايع إماما فأعطاه صفقة يده ، وثمرة قلبه فليعطه ، فإن جاء آخر ينازعه فاضربوا رقبة الآخر ) )(@)(@@) ( د ش ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21568 ) قال النبي :(@)(@@) | 30 ( من بخل بعلم أوتيه أتي به يوم القيامة مغلولا ملجوما بلجام من نار ) )(@)(@@) ابن الجوزي في العل عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21569 ) قال النبي :(@)(@@) | 30 ( من بدل دينه أو رجع عن دينه فاقتلوه ولا تعذبوا بعذاب الله يعني النار ) )(@)(@@) ( عب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21570 ) قال النبي :(@)(@@) | 30 ( من أولي معروفا فليكافىء به فإن لم يستطع فليذكره ، فإذا ذكره فقد شكره ، والمتشبع بما لم ينل كلابس ثوبي زور ) )(@)(@@) ابن أبي الدنيا في قضاء الحوائج ( هب كر ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 21571 ) قال النبي :(@)(@@) | 30 ( من أولي معروفا فليذكره ، فمن ذكره فقد شكره ، ومن كتمه فقد كفره ) )(@)(@@) ( طب ض ) عن طل حة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21572 ) قال النبي :(@)(@@) | 30 ( من أودع وديعة فلا ضمان عليه ) )(@)(@@) ( ه ) عن عمرو بن شعيب عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 21573 ) قال النبي :(@)(@@) | 30 ( من 
ms2312	 أودع كريما معروفا فقد استرقه ، ومن أولى لئيما PageV07P157 معروفا فقد استجلب عداوته ، ألا وإن الصنائع لأهل السعادة ) )(@)(@@) ابن النجار عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21574 ) قال النبي :(@)(@@) | 30 ( من بات فوق آبار ليس حوله ما يدفع القدم فوقع فمات فقد برئت منه الذمة ، ومن ركب البحر عند ارتجاهه فهلك فقد برئت منه الذمة ) )(@)(@@) البغوي والباوردي ( هب ) عن زهير بن عبد الله الشنوي وما له غيره .(@)(@@)(@@)(@@) $ ( 21575 ) قال النبي :(@)(@@) | 30 ( من باع دارا ولم يشتر بثمنها دارا لم يبارك له فيها ولا في شيء من ثمنها ) )(@)(@@) ( هق ) عن حذيفة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21576 ) قال النبي :(@)(@@) | 30 ( من بدا جفا ، ومن تبع الصيد غفل ) )(@)(@@) ( ع ) و الروياني ( ض ) عن البراء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21577 ) قال النبي :(@)(@@) | 30 ( من بدل دينه فاقتلوه ، لا يقبل الله توبة عبد كفر بعد إسلامه ) )(@)(@@) ( طب ك ) عن بهر بن حكيم عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 21578 ) قال النبي :(@)(@@) | 30 ( من بر قسمها ، وقضى دينهما ، ولم يستتب لهما كتب بارا وإن كان عاقا في حياته ، ومن لم يبر قسمها ، ويقض دينهما ، واستتب لهما كتب عاقا وإن كان بارا في حياته ) )(@)(@@) ( طس ) عن عبد الرحمان بن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21579 ) قال النبي :(@)(@@) | 30 ( من بدا جفا ، ومن اتبع الصيد غفل ، ومن أتى أبواب السلطان افتتن ، وما ازداد عبد من السلطان قربا إلا ازداد من الله بعدا ) )(@)(@@) ( حم عد هق ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21580 ) قال النبي :(@)(@@) | 30 ( من برت يمنيه ، وصدق لسانه ، واستقام قلبه ، PageV07P158 وعف بطنه وفرجه فذاك من الراسخين في العلم ) )(@)(@@) ابن جرير وابن أبي حاتم ( طب ) عن أبي الدرداء وأنس وأبي أمامة وواثلة رضي الله عنهم معا .(@)(@@)(@@)(@@) $ ( 21581 ) قال النبي :(@)(@@) | 30 ( من بزق في قبلته ولم يوارها جاءت يوم القيامة أحمى ما تكون حتى تقع بين عينيه ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21582 ) قال النبي :(@)(@@) | 30 ( من بسط رضاه وكف غضبه وبذل معروفه ، وأدى أمانته ، ووصل رحمه فهو في نور الله الأعظم ) )(@)(@@) ابن 
ms2313	 أبي الدنيا في ذم الغضب عن الحسن الديلمي عن عبد الله بن الحسن بن الحسن عن أبيه عن جده عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21583 ) قال النبي :(@)(@@) | 30 ( من بكى من خشية الله تعالى غفر له ) )(@)(@@) الرافعي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21584 ) قال النبي :(@)(@@) | 30 ( من بكر يو 2 السبت في طلب حاجته فأنا ضامن بقضائها ) )(@)(@@) أبو نعيم عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21585 ) قال النبي :(@)(@@) | 30 ( من بلغ عنده النكاح وعنده ما ينكحه فلم ينكحه ثم أحدث حدثا فلا إثم عليه ) )(@)(@@) الديلمي عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21586 ) قال النبي :(@)(@@) | 30 ( من بلغ من هاذه الأمة ثمانين سنة حرم الله تعالى جسده على النار ) )(@)(@@) ابن النجار عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21587 ) قال النبي :(@)(@@) | 30 ( من بلغ الثمانين من هاذه الأمة لم يعرض ولم يحاسب وقيل ادخل الجنة ) )(@)(@@) ( حل ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 21588 ) قال النبي :(@)(@@) | 30 ( من بلغه عني حديث فكذب به فقد كذب ثلاثة : كذب الله ورسوله ، والذي حدث به ) )(@)(@@) ( طس ) و ابن عساكر عن جابر رضي الله عنه .(@)(@@) PageV07P159(@)(@@)(@@)(@@) $ ( 21589 ) قال النبي :(@)(@@) | 30 ( من بلغه معروف من أخيه من غير مسألة ولا إشراف نفس فليقبله ولا يرده ، فإنما هو رزق ساقه الله إليه ) )(@)(@@) ( حب طب ك ) عن زيد بن خالد الجهني رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21590 ) قال النبي :(@)(@@) | 30 ( من بلغه عن الله شيء فيه فضيلة فأخذ به إيمانا به ، ورجاء ثوابه ، أعطاه الله ذالك وإن لم يكن كذالك ) )(@)(@@) أبو الشيخ والخطيب وابن النجار والديلمي عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21591 ) قال النبي :(@)(@@) | 30 ( من بلغه فضل عن الله أعطاه الله ذالك وإن لم يكن كذالك ) )(@)(@@) الديلمي وابن النجار عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21592 ) قال النبي :(@)(@@) | 30 ( من بلغ بسهم فله درجة ، قيل : يا رسول الله ! ما الدرجة ؟ قال : أما إنها ليست بعتبة أمك ، الدرجتين مائة عام ) )(@)(@@) ابن حاتم وابن مردويه عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21593 ) قال النبي :(@)(@@) | 30 ( من بلغ العدو 
ms2314	 بسهم رفعه الله درجة بين الدرجتين مائة عام ، ومن رمى بسهم في سبيل الله كان كمن أعتق رقبة ) )(@)(@@) ( حم حب ) عن كعب بن مرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21594 ) قال النبي :(@)(@@) | 30 ( من بلغ بسهم في سبيل الله فهو له عدل محرر ) )(@)(@@) ( ط هق ) عن أبي نجيح رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21595 ) قال النبي :(@)(@@) | 30 ( من بنى لله مسجدا بنى الله له قصرا في الجنة من در وياقوت وزبرجد ) )(@)(@@) ابن النجار عن أبي هدبة عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21596 ) قال النبي :(@)(@@) | 30 ( من بنى لله مسجدا كمفحص قطاة بنى الله له PageV07P160 بيتا في الجنة ) )(@)(@@) ( ش ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21597 ) قال النبي :(@)(@@) | 30 ( من بنى لله مسجدا ولو كمفحص قطاة بنى الله له بيتا في الجنة ) )(@)(@@) ( ش ط ع حب ) و الروياني ( طص هق ض ) عن أبي ذر ، ( ش ) عن عثمان ، والخطيب عن عمرو بن شعيب عن أبيه عن جده ، ( طس ) والخطيب وابن النجار عن ابن عمر ، الرافعي عن محمد بن الحسن عن أبي جحيفة عن عبد الله بن أبي أوفى ا ، ( طس ) عن أنس رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 21598 ) قال النبي :(@)(@@) | 30 ( من بنى لله بيتا يعبد الله فيه ، من مال حلال بنى الله له بيتا في الجنة ومن در وياقوت ) )(@)(@@) ( ع طس هب كر ) و ابن النجار عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21599 ) قال النبي :(@)(@@) | 30 ( من بنى لله مسجدا يصلى فيه بنى الله له بيتا في الجنة أفضل منه ) )(@)(@@) ( طب حم حل ن ) عن واثلة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21600 ) قال النبي :(@)(@@) | 30 ( من بنى لله مسجدا دخل الجنة ) )(@)(@@) ( طب ) عن عمرو بن عبسة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21601 ) قال النبي :(@)(@@) | 30 ( من بنى لله مسجدا بنى الله له بيتا أوسع منه في الجنة ) )(@)(@@) ( حم ) عن ابن عمرو ، ( حم ) عن أسماء بنت يزيد رضي الله عنها .(@)(@@)(@@)(@@) $ ( 21602 ) قال النبي :(@)(@@) | 30 ( من بنى مسجدا يذكر فيه اسم الله بنى الله له بيتا في الجنة ) )(@)(@@) ( ش حب ) عن عمر رضي 
ms2315	 الله عنه .(@)(@@)(@@)(@@) $ ( 21603 ) قال النبي :(@)(@@) | 30 ( من بنى مسجدا يراه الله بنى له بيتا في الجنة ، وإن مات من يومه غفر له ، وإن حفر قبرا يراه الله بنى الله له بيتا في الجنة ، وإن PageV07P161 مات من يومه غفر له ) )(@)(@@) ( طس ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21604 ) قال النبي :(@)(@@) | 30 ( من بنى مسجدا لا يريد به رياء ولا سمعة بنى الله له بيتا في الجنة ) )(@)(@@) ( طس ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 21605 ) قال النبي :(@)(@@) | 30 ( من بنى لله مسجدا بنى الله له بيتا ، قيل : وهاذه المساجد التي في طريق مكة ؟ قال : وهاذه المساجد التي في طريق مكة ) )(@)(@@) ( ش ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 21606 ) قال النبي :(@)(@@) | 30 ( من بنى لله مسجدا بنى الله له بيتا في الجنة ، ومن علق فيه قنديلا صلى عليه سبعون ألف ملك حتى يطفأ ذالك القنديل ، ومن بسط حصيرا صلى عليه سبعون ألف ملك حتى يتقطع ذالك الحصير ، ومن أخذ منه قذاة كان له كفلان من الأجر ) )(@)(@@) الرافعي عن معاذ بن جبل رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21607 ) قال النبي :(@)(@@) | 30 ( من بنى بنيانا في غير ظلم ولا اعتداء ، أو غرس غرسا في غير ظلم ولا اعتداء كان له أجرا جاريا ما انتفع أحد من خلق الله ) )(@)(@@) ( حم طب ) و ابن جرير ( هب ) عن معاذ بن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21608 ) قال النبي :(@)(@@) | 30 ( من بنى سابطا فليدعم على جدار أخيه ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21609 ) قال النبي :(@)(@@) | 30 ( من بنى في رباع قوم بإذنهم فله القيمة ، ومن بنى بغير إذنهم فله النقض ) )(@)(@@) ( عد هق ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 21610 ) قال النبي :(@)(@@) | 30 ( من بنى في أرض الأعاجم فعمل بنيروزهم ومهرجانهم فهو منهم ) )(@)(@@) الديلمي عن ابن عمرو رضي الله عنه .(@)(@@) PageV07P162(@)(@@)(@@)(@@) $ ( 21611 ) قال النبي :(@)(@@) | 30 ( من بنى في ربع قوم بغير إذنهم فأرادوا إخراجه فله نقضه ، ومن بنى في ربع قوم بإذنهم فأرادوا إخراجه فله نفقته ) )(@)(@@) ( عب ) عن حمزة الجزري مرسلا .(@)(@@)(@@)(@@) $ ( 21612 ) قال النبي :(@)(@@) | 30 
ms2316	 ( من بهت مؤمنا أو مؤمنة أو قال فيه ما ليس فيه أقامه الله عز وجل يوم القيامة على تل من نار حتى يخرج مما قال فيه ) )(@)(@@) ابن النجار عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21613 ) قال النبي :(@)(@@) | 30 ( من تاب قبل أن يموت بسنة تاب الله عليه ، إن سنة لكثير ، من تاب قبل أن يموت بشهر تاب الله عليه ، إن الشهر لكثير ، من تاب قبل أن يموت بجمعة تاب الله عليه ، إن جمعة لكثير ، من تاب قبل أن يموت بيوم ، تاب الله عليه ، إن يوما لكثير ، من تاب قبل أن يغرغر تاب الله عليه ) )(@)(@@) الخطيب عن عبادة بن الصامت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21614 ) قال النبي :(@)(@@) | 30 ( من تاب قبل موته بعام تيب عليه حتى قال بشهر ، حتى قال بجمعة ، حتى قال بيوم ، حتى قال بساعة ، حتى قال بفواق ) )(@)(@@) ابن جرير ( ك هب ) والخطيب في المتفق والمفترق عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21615 ) قال النبي :(@)(@@) | 30 ( من تبع جنازة حتى يصلي عليها يم يرجع فله قيراط ، ومن صلى عليها ثم مشى معها حتى يدفنها فله قيراطان ، القيراط : مثل أحد ) )(@)(@@) ( طب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21616 ) قال النبي :(@)(@@) | 30 ( من تحبب إلى الناس بما يحبوه وبارز الله ، لقي الله يوم القيامة وهو عليه غضبان ) )(@)(@@) ( طب ) عن عصمة بن مالك رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21617 ) قال النبي :(@)(@@) | 30 ( من تحلى ذهبا ، أو حلى أحدا من ولده مثل PageV07P163 خربصيصة أو عين جرادة كوي به يوم القيامة ) )(@)(@@) ( طب ) عن أسماء بنت يزيد رضي الله عنها .(@)(@@)(@@)(@@) $ ( 21618 ) قال النبي :(@)(@@) | 30 ( من تحلى أو حلى بخربصيصة ذهب كوي به يوم القيامة ) )(@)(@@) ( حم ) عن عبد الرحمان بن غنم رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21619 ) قال النبي :(@)(@@) | 30 ( من تختم بالياقوت الأصفر منع من الطاعون ) )(@)(@@) ابن زنجويه في كتاب الخواتم عن علي رضي الله عنه وسنده ضعيف .(@)(@@)(@@)(@@) $ ( 21620 ) قال النبي :(@)(@@) | 30 ( من تحلى بباطل كان كلابس ثوبي زور ) )(@)(@@) العسكري في الأمثال عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21621 ) قال النبي :(@)(@@) | 30 
ms2317	 ( من تحطى رقاب الناس بعد خروج الإمام ، أو فرق بين اثنين كان كجار قصبه في النار ) )(@)(@@) ( طب ) عن عثمان بن الأزرق رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21622 ) قال النبي :(@)(@@) | 30 ( من تحلم كاذبا كلف أن يعقد شعيرة ويعذب وليس بعاقد ) )(@)(@@) ابن جرير عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21623 ) قال النبي :(@)(@@) | 30 ( من تخطر ذمتي كنت خصمه ومن خاصمته خصمته ) )(@)(@@) ( طب ) عن أبي السوار العدوي بلاغا .(@)(@@)(@@)(@@) $ ( 21624 ) قال النبي :(@)(@@) | 30 ( من تداين بدين وفي نفسه وفاؤه ثم مات تجاوز الله تعالى عنه وأرضى غريمه بما شاء ، ومن تداين بدين وليس في نفسه وفاؤه ثم مات اقتص الله تعالى لغريمه منه يوم القيامة ) )(@)(@@) ( ك ) عن أبي أمامة رضي الله عنه .(@)(@@) PageV07P164(@)(@@)(@@)(@@) $ ( 21625 ) قال النبي :(@)(@@) | 30 ( من تدين بدين وهو يريد أن يقضيه ، حريص على أن يؤديه فمات ولم يقض دينه فإن الله تعالى قادر على أن يرضي غريمه بما شاء من عنده ويغفر للمتوفى ، ومن تدين بدين وهو يريد أن لا يقضيه فمات على ذالك ولم يقض دينه ، فإنه يقال له : أظننت أنا لا نوفي فلانا حقه عنك ؟ فيؤخذ من حسناته فيجعل زيادة على حسنات رب الدين ، فإن لم يكن له حسنات أخذ من سيئات رب الدين فجعلت في سيئات المطلوب ) )(@)(@@) ( هب ) عن القاسم بن معاوية بلاغا مرسلا .(@)(@@)(@@)(@@) $ ( 21626 ) قال النبي :(@)(@@) | 30 ( من ترك مالا فلأهله ، ومن ترك دينا فعلى الله وعلى رسوله ) )(@)(@@) ( حم ع ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21627 ) قال النبي :(@)(@@) | 30 ( من ترك الجمعة من غير عذر فليتصدق بدينار ، فإن لم يجد فبنصف دينار ) )(@)(@@) ( ط حم ش د ن ه ) و الروياني وابن خزيمة ( حب طب ك هق ض ) عن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21628 ) قال النبي :(@)(@@) | 30 ( من ترك مالا فلورثته ، ومن ترك دينا فعلي وعلى الولاة من بعدي من بيت مال المسلمين ) )(@)(@@) ( طب ) عن سل مان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21629 ) قال النبي :(@)(@@) | 30 ( من ترك زينة لله ، ووضع ثيابا حسنة تواضعا له وابتغاء وجهه كان حقا على الله أن 
ms2318	 يكسوه من عبقري الجنة في تحات الياقوت ) )(@)(@@) ( حل ) تبدل بعبقري الجنة ، أبو علي الذهبي الهروي في فوائده ، وابن النجار عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21630 ) قال النبي :(@)(@@) | 30 ( من ترك التزويج مخافة العيلة فليس منا ) )(@)(@@) الديلمي عن أبي سعيد رضي الله عنه .(@)(@@) PageV07P165(@)(@@)(@@)(@@) $ ( 21631 ) قال النبي :(@)(@@) | 30 ( من ترك الصلاة فكأنما وتر أهله وماله ) )(@)(@@) ( ط هق ) في المعرفة عن نوفل رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21632 ) قال النبي :(@)(@@) | 30 ( من ترك صلاة العصر متعمدا حتى تغرب الشمس فكأنما وتر أهله وماله ) )(@)(@@) ( ط حم ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21633 ) قال النبي :(@)(@@) | 30 ( من ترك الصلاة سكرا مرة واحدة فكأن ما كانت له الدنيا وما عليها فسبلها ، ومن ترك الصلاة أربع مرات سكرا كان حقا على الله أن يسقيه من طينة الخبال ، قيل : وما طينة الخبال ؟ قال : عصارة أهل جهنم ) )(@)(@@) ( حم ك هق ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21634 ) قال النبي :(@)(@@) | 30 ( من ترك دينارا فكية ، ومن ترك دينارين فكيتين ) )(@)(@@) الحسن بن سفيان عن حبيب بن حزم بن الحارث السلمي عن عمه الحكم بن الحارث السلمي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21635 ) قال النبي :(@)(@@) | 30 ( من ترك دينارين ترك كيتين ) )(@)(@@) ( خ ) في التاريخ ( طب ) و ابن عساكر عن أسماء بنت يزيد رضي الله عنها .(@)(@@)(@@)(@@) $ ( 21636 ) قال النبي :(@)(@@) | 30 ( من ترك لغريمه أو محى عنه كان في ظل العرش يوم القيامة ) )(@)(@@) ( ع ) عن أبي قتادة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21637 ) قال النبي :(@)(@@) | 30 ( من ترك أربعين حديثا بعد موته فهو رفيقي في الجنة ) )(@)(@@) الديلمي وابن الجوزي في العلل عن جابر بن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21638 ) قال النبي :(@)(@@) | 30 ( من ترك الجمعة من غير ضرورة كتب منافقا في كتاب لا يمحى ولا يبدل ) )(@)(@@) الشافعي ( هق ) في المعرفة عن ابن عباس رضي الله عنهما .(@)(@@) PageV07P166(@)(@@)(@@)(@@) $ ( 21639 ) قال النبي :(@)(@@) | 30 ( من ترك صلاة العصر متعمدا حتى تفوته فقد أحبط عمله ) )(@)(@@) ( حم ش ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21640 ) قال النبي :(@)(@@) | 30 ( من ترك الرمي بعد أن كان 
ms2319	 يحسنه فقد ترك سنة ) )(@)(@@) القراب في فضل الرمي عن محمد بن إسحاق مرسلا .(@)(@@)(@@)(@@) $ ( 21641 ) قال النبي :(@)(@@) | 30 ( من ترك الصلاة متعمدا كتب اسمه على باب النار ممن يدخلها ) )(@)(@@) أبو نعيم عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21642 ) قال النبي :(@)(@@) | 30 ( من ترك الجمعة من غير عذر لم يكن له كفارة دون يوم القيامة ) )(@)(@@) الديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21643 ) قال النبي :(@)(@@) | 30 ( من ترك الجمعة لم يكن له في تركها عذر كتبه الله في الكتاب الذي لا يمحى ولا يبدل منافقا إلى يوم القيامة ) )(@)(@@) الديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21644 ) قال النبي :(@)(@@) | 30 ( من ترك { بسم الله الرحمان الرحيم } فقد ترك آية من كتاب الله ، وقد نزل علي ما عد من أم الكتاب { بسم الله الرحمان } ) ال| ديلمي عن طلحة بن عبيد الله رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21645 ) قال النبي :(@)(@@) | 30 ( من ترك معصية مخافة من الله أرضاه الله ) )(@)(@@) ابن لال عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21646 ) قال النبي :(@)(@@) | 30 ( من ترك العصر حتى تغيب الشمس من غير عذر فكأنما وتر أهله وماله ) )(@)(@@) ( ش ) عن ابن عمر رضي الله عنهما .(@)(@@) PageV07P167(@)(@@)(@@)(@@) $ ( 21647 ) قال النبي :(@)(@@) | 30 ( من ترك صلاة مكتوبة حتى تفوته من غير عذر فقد حبط عمله ) )(@)(@@) ( ش ) عن أبي الدرداء والحسن مرسلا .(@)(@@)(@@)(@@) $ ( 21648 ) قال النبي :(@)(@@) | 30 ( من ترك بعده كنزا مثل له يوم القيامة شجاعا أقرع له زبيبتان يتبع فاه فيقول : ويلك ما لك ؟ فيقول : أنا كنزك الذي تركته بعدك ، فلا يزال يتبعه حتى يلقمه يده ثم يتبعه سائر جسده ) )(@)(@@) ( بز ) وحسنه ، و ابن خزيمة والروياني ( ع حب طب حل كر ض ) عن ثوبان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21649 ) قال النبي :(@)(@@) | 30 ( من ترك الجمعة ثلاثا من غير علة طبع الله على قلبه ) )(@)(@@) ابن عساكر عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21650 ) قال النبي :(@)(@@) | 30 ( من ترك الجمعة ثلاث مرات من غير علة ولا مرض ولا عذر طبع الله على قلبه ) )(@)(@@) المحاملي في أماليه والخطيب وابن عساكر عن 
ms2320	 عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 21651 ) قال النبي :(@)(@@) | 30 ( من ترك أربع جمع في غير عذر فقد نبذ الإسلام وراء ظهره ) )(@)(@@) الشيرازي في الألقاب عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21652 ) قال النبي :(@)(@@) | 30 ( من ترك الصف الأول مخافة أن يؤذي مسلما فصلى في الصف الثاني أو الثالث أضعف الله له أجر الصف الأول ) )(@)(@@) ( طس ) و ابن النجار عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21653 ) قال النبي :(@)(@@) | 30 ( من تزوج امرأة وهو ينوي أن لا يعطيها الصداق لقي الله وهو زان ) )(@)(@@) ابن منده عن ميمون بن جابان الصردي عن أبيه .(@)(@@)(@@)(@@) $ ( 21654 ) قال النبي :(@)(@@) | 30 ( من تزوج امرأة بصداق يريد أن لا يؤديه جاء يوم القيامة زانيا ، ومن تسلف مالا يريد أن لا يؤذيه جاء يوم القيامة سارقا ) )(@)(@@) الرافعي وابن النجار عن صهيب رضي الله عنه .(@)(@@) PageV07P168(@)(@@)(@@)(@@) $ ( 21655 ) قال النبي :(@)(@@) | 30 ( من تزوج امرأة ومن نيته أن يذهب بصداقها لقي الله وهو زان حتى يتوب ، ومن أدان دينا وهو يريد أن لا يفي به لقي الله سارقا حتى يتوب ) )(@)(@@) ابن عساكر عن صيفي بن صهيب عن أبيه .(@)(@@)(@@)(@@) $ ( 21656 ) قال النبي :(@)(@@) | 30 ( من تزوج امرأة لدينها وجمالها كان له في ذالك سداد من عوز ) )(@)(@@) ابن النجار عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21657 ) قال النبي :(@)(@@) | 30 ( من تزوج امرأة لعزها لم يزده الله عز وجل إلا ذلا ، ومن تزوجها لمالها لم يزده الله تعالى إلا فقرا ، ومن تزوجها لحسنها لم يزده الله إلا دناءة ، ومن تزوج امرأة ليغض بصره ، ويحصن فرجه ، ويصل رحمه ، فإن ذالك منة ، وبورك له فيها ، وبارك الله لها فيه ) )(@)(@@) ابن النجار عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21658 ) قال النبي :(@)(@@) | 30 ( من تزوج امرأة ثم مات وهو لا ينوي أن يعطيها مهرها ، مات وهو زان ، ومن استقرض من رجل قرضا ثم مات وهو لا ينوي أن يعطيه مات وهو سارق ) )(@)(@@) ( هب ) عن صهيب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21659 ) قال النبي :(@)(@@) | 30 ( من تزوجت إليه أو تزوج إلي فحرمه الله على النار ؟ ) )(@)(@@) ابن 