ms81	 الدجى % % يعودان في هضبي لجين وعسجد % % 72(@)(@@) % ولكنه ود وحسن تخير % % قضى لك مني بالثناء المخلد % % 73(@)(@@) % جعلتك بين الناس حظي الذي سمت % % لإحرازه نفسي وطبعي منجدي % % 74(@)(@@) % وحرك عزمي أن أزورك قاعدا % % على فرس العز الأصيل المجدد % % 75(@)(@@) % ليخلص تأميلي إليك ووجهتي % % وبيرأ عزمي من سواك ومقصدي % % 76(@)(@@) % فلا تنس لي هذا الزمام فإنه % % لخير ذمام قد وصلت به يدي % % 77(@)(@@) % أجار علاك الله من كل حادث % % ولا زلت في سعد على الدهر مسعد % % 78(@)(@@) % وأحيا أبا يحيى لعينك قرة % % قريعك في حزم وعزم وسؤدد % % 79(@)(@@) % مؤمل أبنائي ومظهر دعوتي % % ولولا اتقائي عتبه قلت سيدي % % 80(@)(@@) % ولا زلت تجني كلما اشتجر الوغى % % جنى النصر من غرس القنا المتقصد % % PageV01P327 81(@)(@@) % وكثر من حسادك الله إنه % % إن الله أنمى خيره إليك تحسد % % PageV01P328 البحر : رمل تام 1(@)(@@) % سرق الدهر شبابي من يدي % % ففؤادي مشعر بالكمد % % 2(@)(@@) % واحتملت الأمر إذ أبصرته % % باع ما أفقدني من ولدي % % PageV01P329 البحر : كامل تام 1(@)(@@) % الشكر يصغر والهبات تزيد % % فمتى يجيد القول فيك مجيد % % 2(@)(@@) % يا من له الفخر البعيد على الورى % % إن كان مولانا ونحن عبيد % % 3(@)(@@) % إن كانت الأعياد قبلك دائما % % عيدين فالدنيا بملكك عيد % % PageV01P330 البحر : كامل تام 1(@)(@@) % هون على النفس النفيسة أمرها % % وإذا سلمت فلا ترع لفقيد % % 2(@)(@@) % لم يأت صرف الدهر بدعا محدثا % % كم من يزيد قد مضى ويزيد % % PageV01P331 البحر : طويل 1(@)(@@) % وقائلة صف لي فديتك رحلة % % عنيت بها ياشقة القلب من بعدي % % 2(@)(@@) % فقلت خذيها من لسان بلاغة % % كما نظم الياقوت والدر في عقد % % PageV01P332 البحر : مديد تام 1(@)(@@) % لا يسو ظنك من أجل سهم % % عاد مغنى السعد من غير عاده % % 2(@)(@@) % أو لست الشمس دون امتراء % % حل في برجك سهم السعاده % % PageV01P333 البحر : - 1(@)(@@) % يوم أزمعت عنك طوع البعاد % % وعدتني عن اللقاء العوادي % % 2(@)(@@) % قال صحبي وقد أطلت التفاتي % % أيى شيء تركت قلت فؤادي % % PageV01P334 البحر : - 1(@)(@@) % سميى رسول الله أحييت مهجتي % % وعاجلني منك الصريح على بعد % % 2(@)(@@) % فإن عشت أبلغ فيك نفسي عذرها 
ms82	 % % وإن لم أعش فالله يجزيك من بعد % % PageV01P335 البحر : - 1(@)(@@) % إن كان يسقي الأرض جود عمامة % % فأنا الذي أسقي غمام الجود % % 2(@)(@@) % قابلت من وجه ابن نصر قبلة % % فلها ركوعي دائما وسجودي % % PageV01P336 البحر : - 1(@)(@@) % لله درك يا ابن بطان فما % % لشهير جودك في البسيطة جاحد % % 2(@)(@@) % إن كان في الدنيا كريم واحد % % يزن الجميع فأنت ذاك الواحد % % 3(@)(@@) % أجريت فضلك جعفرا يحيا به % % ما كان من مجد فذكرك خالد % % 4(@)(@@) % فالقوم منك تجمعوا في واحد % % ولد كما شاء العلاء ووالد % % 5(@)(@@) % وهيى الليالي لا تزال صروفها % % يشقى بموقعها الكريم الماجد % % 6(@)(@@) % وبمستعين الله يصلح منك ما % % قد كان غيره الزمان الفاسد % % PageV01P337 البحر : - 1(@)(@@) % الحمد لله كم لله من وجود % % وحكمة ظهرت في كل موجود % % 2(@)(@@) % بالله يا آل مرين أبشروا وثقوا % % بكل سعد على الأيام ممدود % % 3(@)(@@) % فملككم بسليمان بن داود في % % الدهر ملك سليمان بن داود % % 4(@)(@@) % لا ينبغي لسواكم بعدكم فلكم % % فخر على الخلفاء الجلة الصيد % % 5(@)(@@) % قد حل في جبل للفتح منتسب % % بالفتح مفتخر بالفتح موعود % % 6(@)(@@) % سفينة الأمل الممدود قد سحبت % % في جوده واستوت منه على الجود % % 7(@)(@@) % شدوا عليه يد المعتد فهو لكم % % ذخر مقلد في نحر وفي جيد % % PageV01P338 البحر : - 1(@)(@@) % يا أبا الفضل إن تخب عن سواد % % العين ما غبت عن سواد الفؤاد % % 2(@)(@@) % صار يوم السرور بعدك ليلا % % ووثير المهاد شوك القتاد % % 3(@)(@@) % وكأن الجفون إذا غبت عنها % % نحرت دمعها لضيف السهاد % % PageV01P339 البحر : - 1(@)(@@) % عذار كما دب الحباب على الورد % % محاسنه أربت على الحصر والعد % % 2(@)(@@) % سعى نحو ورد الثغر وانساب نحوه % % فتحسبه نملا تدب إلى شهد % % 3(@)(@@) % فيا ألفا للقد هل من إمالة % % ويا حرف لين العطف هل لك من قد % % PageV01P340 البحر : - 1(@)(@@) % لما رأوا أنني به كلف % % وأوشكوا ينطقون من حسدي % % 2(@)(@@) % قالوا الفتى بارد فقلت لهم % % خلوه يا برده على كبدي % % PageV01P341 البحر : - 1(@)(@@) % منكانة الرمل فيها عبرة ونهى % % وشاهد أن كلا منقض كمدا % % 2(@)(@@) % لباب عمر الفتى يجري بحربتها % % كأنما العمر 
ms83	 لما أطلقت قصدا % % PageV01P342 البحر : - 1(@)(@@) % قدم البنفسج وهو نعم الوارد % % قد نم منه إلي طيب زائد % % 2(@)(@@) % فسألته ما باله فأجابني % % والحق لا يبغى عليه شاهد % % 3(@)(@@) % أقبلت أطلب من بنان محمد % % صلة فعاد إلي منه عائد % % PageV01P343 البحر : - 1(@)(@@) % أقول والليل أعياني تطاوله % % وأوسع الذم والتعنيت أسوده % % 2(@)(@@) % ما كان يجرأ ليلي أن يطاولني % % شعاركم يا بني العباس أيده % % PageV01P344 البحر : - 1(@)(@@) % قل للذي ذكر الهدى وعهوده % % فبكى وأصبح مشفقا من فقدها % % 2(@)(@@) % غصبت حقوق الله جل جلاله % % فقضى أبو الحسن الصغير بردها % % PageV01P345 البحر : - 1(@)(@@) % قالوا ولائم مولانا مجالسها % % عشرون من ضحوة الليل معدودة % % 2(@)(@@) % فقلت ألوانها في النفع أدوية % % والبعض منها بل المجموع محموده % % PageV01P346 البحر : - 1(@)(@@) % لو لم يكن واديكم باردا % % لقلت من دمعي أتى الوادي % % 2(@)(@@) % أو لم يك الشادي به أعجما % % طارحت شجوي طيرة الشادي % % PageV01P347 البحر : - 1(@)(@@) % عند رأس المزاد عادني السهد % % ولم تغن حيلتي واجتهادي % % 2(@)(@@) % حسبي الله كيف يبرى سريعا % % سهر عن صداع رأس المزاد % % 3(@)(@@) % حكى فارس الشطرنج طرفك لا يرى % % ينقل من بيضاء إلا إلى حمرا % % PageV01P348 البحر : طويل 1(@)(@@) % إذا ما تجلى النور في جنح ظلمة % % جلاها كما تجلو الدجى غرة الفجر % % 2(@)(@@) % فلا تعجبن للحبر أن حال لونه % % فوجهك يجلو غرة الليل والحبر % % PageV01P349 البحر : وافر تام 1(@)(@@) % لعمرك ما أغار على عدو % % كجيش النصر بورك من مغير % % 2(@)(@@) % ولا شرحت مدونة المعالي % % سوى فتيا أبي الحسن الصغير % % PageV01P350 البحر : - 1(@)(@@) % ومنتقش المتن كالمبرد % % إذا هب عرف النسيم الندي % % 2(@)(@@) % تدافع مسترسلا مائجا % % كما اندفع الدرع من مزود % % PageV01P351 البحر : - 1(@)(@@) % عبس الليل فلا صبح يرى % % وهوى النجم وغاب الفرقد % % 2(@)(@@) % % % PageV01P352 البحر : - 1(@)(@@) % قلت لما أتى الكتاب بعنوان % % رأيت العيون تقصد قصده % % 2(@)(@@) % طبق من أزاهر رائقات % % سقطت فوقه من الختم ورده % % PageV01P353 البحر : - 1(@)(@@) % جاء العذار بظل غير ممدود % % فمنتهى الحسن منه غير محدود % % PageV01P354 البحر : وافر تام 1(@)(@@) % لقد زار الجزيرة منك بحر % % يمد فليس نعرف منه جزرا % % 2(@)(@@) % أعدت لها بعهدك عهد موسى % % سميك فهي 
ms84	 تتلو منه ذكرا % % 3(@)(@@) % أقمت جدارها وأفدت كنزا % % ولو شئت اتخذت عليه أجرا % % PageV01P355 البحر : منسرح 1(@)(@@) % خليفة الله ساعد القدر % % علاك ما لاح في الدجى قمر % % 2(@)(@@) % ودافعت عنك كف قدرته % % ما ليس يسطيع دفعه البشر % % 3(@)(@@) % ليس لنا ملجأ نؤمله % % سواك أنت الثمال والوزر % % 4(@)(@@) % وجهك في النائبات بدر دجى % % لنا وفي المحل كفك المطر % % 5(@)(@@) % والناس طرا بأرض أندلس % % لولاك ما أوطنوا ولا عمروا % % 6(@)(@@) % وجملة الأمر أنه وطن % % في غير علياك ما له وطر % % 7(@)(@@) % ومن به مذ وصلت حبلهم % % ما جحدوا نعمة ولا كفروا % % 8(@)(@@) % وقد أهمتهم نفوسهم % % فوجهوني إليك وانتظروا % % 9(@)(@@) % ناديت قلبي إذ لاحت طلائعه % % يا صبر أيوب هذا درع داود % % PageV01P356 البحر : - 1(@)(@@) % ما غض مني أن أخلفت موعود % % وروض خدك أضحى ذاوي العود % % 2(@)(@@) % وقال صوت عذار فوق صفحته % % سفينة الحسن قد حطت على الجود % % PageV01P357 البحر : - 1(@)(@@) % أضاف إلى الجفون السود شعرا % % كجنح الليل أو صبغ المداد % % 2(@)(@@) % فقلت أمير هذا الجيش تركو الأجور % % له بتكثير السواد % % PageV01P358 البحر : - 1(@)(@@) % لما رضيت بفرقتي وبعادي % % وصرمت أمالي وخنت ودادي % % 2(@)(@@) % لاعنت أم الصبر فيك وبعده % % ورثت للأشجان كنز فؤادي % % 3(@)(@@) % فالصبر مني أجنبي بعدها % % ولواعج الأشجان من أولادي % % PageV01P359 البحر : - 1(@)(@@) % أمولاي استزد بالشكر صنعا % % فقد وعد المزيد الله بعده % % 2(@)(@@) % أبحت ذمار من ناواك لما % % نويت جهاده وقصدت قصده % % 3(@)(@@) % وما كان الذمار بمستباح % % ولكن العزيز أعز عبده % % PageV01P360 البحر : - 1(@)(@@) % قال لي صاحبي وقد بان زهدي % % عندما أمل الهمام العميد % % 2(@)(@@) % لم أعرضت واستهنت بهذا % % قلت أغناني الغني الحميد % % PageV01P361 البحر : - 1(@)(@@) % أرد ما كان وارض بما قضاه % % إلاهك هذ خلق المريد % % 2(@)(@@) % ورم بالشكر من أعطاك ستره % % فإن الشكر مفتاح المزيد % % PageV01P362 البحر : - 1(@)(@@) % رحلت فكنت في التحقيق بدرا % % منازلك المنازل والبلاد % % 2(@)(@@) % ومن أفلاك رحلتك المعالي % % ومن آثار نيرك الجهاد % % PageV01P363 البحر : طويل 1(@)(@@) % أرقت فجنح الليل قيد خطوه % % فلهفي على الجفن القريح المسهد % % 2(@)(@@) % وما بليت نفس امرىء متطرق % % بأوحش من عبد عبوس مقيد % % PageV01P364 البحر 
ms85	 : كامل تام 1(@)(@@) % قم سقني والأفق يقرع بابه % % من أول الفجرين ضيف وارد % % 2(@)(@@) % وكأنني بالصبح فيه غاطسا % % من بعد ما هب الهواء البارد % % PageV01P365 البحر : كامل تام 1(@)(@@) % ركب السفينة واستقل بأفقها % % فكأنما ركب الهلال الفرقد % % 2(@)(@@) % وشكوا إلي بميده فأجبتهم % % لا غرو أن ماد القضيب الأملد % % PageV01P366 البحر : منسرح 1(@)(@@) % في غير حفظ الله من هامة % % هام بها الشيطان في كل واد % % 2(@)(@@) % ما خلفت ذكرا ولا رحمة % % في فم إنسان ولا في فؤاد % % PageV01P367 البحر : وافر تام 1(@)(@@) % بنفسي حالك شقة السويدا % % لذلك ما يحن له الفؤاد % % 2(@)(@@) % أطيل له التفاتي والتماحي % % لأن العين ينفعها السواد % % PageV01P368 البحر : كامل تام 1(@)(@@) % قد كنت أجهد في التماس صنيعة % % نفسا شهاب ذكائها وقاد % % 2(@)(@@) % وأقول لو كان المخاطب غيركم % % عند الشدائد تذهب الأحقاد % % PageV01P369 البحر : طويل 1(@)(@@) % دعانا إلى بنيونش وهي جنه % % شريف تولى الله تطهير مجده % % 2(@)(@@) % فاذكرنا مثواه بالجنة التي % % وعدنا بها والله منجز وعده % % 3(@)(@@) % نعيما وريحانا وروحا وكلما % % يعد لمن حاباه سابق وعده % % 4(@)(@@) % فقلنا ظفرنا اليوم من أجل أحمد % % بهذه ونرجو تلك من أجل جده % % PageV01P370 البحر : خفيف تام 1(@)(@@) % شوق نفسي إلى كلامك يحكي % % ناره للجحيم ذات الوقود % % 2(@)(@@) % فإذا قيل هل تملات قالت % % في جواب السؤال هل من مزيد % % PageV01P371 البحر : كامل تام 1(@)(@@) % إنا بني نصر إذا ما أطلعت % % يوما سماء سعودنا مولودا % % 2(@)(@@) % كانت حمائلنا له وسروجنا % % بين الملوك تمائما ومهودا % % PageV01P372 البحر : خفيف تام 1(@)(@@) % يا رسول الصبا فديتك بلغ % % فرط شوقي إن استطعت ووجدي % % 2(@)(@@) % وتحمل نحو القباب سلاما % % يزدري عرفه بأزهار نجد % % 3(@)(@@) % ثم قبل بكف مولاي عني % % وتحدث بما أعيد وأبدي % % 4(@)(@@) % ولتشاهد ذاك الجمال بطرفي % % ولتطأ ذلك التراب بخدي % % 5(@)(@@) % وتلطف فإنما هي نجوى % % بثها الشوق بين مولى وعبد % % PageV01P373 البحر : طويل 1(@)(@@) % بشراك للملك في علياك تمهيد % % وفي زمانك للأفراح تجديد % % 2(@)(@@) % قد ساعد السعد ربعا أنت تعمره % % وأنجزت فيه للفتح المواعيد % % 3(@)(@@) % وصاحبتك على الأيام أربعة % % عز ونصر وتمكين وتمهيد % % 4(@)(@@) % يا 
ms86	 يوسف الملك والحسن ارتقب زمنا % % راياتك الحمر في خديه توريد % % PageV01P374 البحر : بسيط تام 1(@)(@@) % تعجلت وخط الشيب في زمن الصبا % % لخوضي غمار الهم في طلب المجد % % 2(@)(@@) % فمهما رأيتم شيبة فوق مفرقي % % فلا تنكروها إنها شيبة الحمد % % PageV01P375 البحر : رمل تام 1(@)(@@) % قل لشمس الدين وقيت الردى % % لم يدع سقمك عندي جلدا % % 2(@)(@@) % رمدت عينك هذا عجب % % أو عين الشمس تشكو الرمدا % % PageV01P376 البحر : بسيط تام 1(@)(@@) % غشيان مثواك مثوى الجود يوم ندى % % مما ينافس فيه الوالد الولدا % % 2(@)(@@) % وحبك اليوم ذخر من تأثله % % جنى به الفوز في دار النعيم غدا % % 3(@)(@@) % وقد مددت لإذن من علاك يدي % % فاسمح بها دمت أعلى العالمين يدا % % 4(@)(@@) % وحلت تجار الريع كل بضاعة % % تقر لها صنعاء بالفضل والهند % % 5(@)(@@) % فما شئت فيها من نمارق سندس % % وإستبرق من فوق غبر الربا تبدو % % 6(@)(@@) % ولائم فضل الله فيها موائد % % تقوم قيان الورق من فوقها تشدو % % 7(@)(@@) % لك الشكر يا رحمان فيما بذلته % % من الرفق فينا دائما ولك الحمد % % PageV01P377 البحر : طويل 1(@)(@@) % إذا نمت نم للأمن فوق مهاد % % وإن قمت قم للعز تحت عماد % % 2(@)(@@) % وجل فوق سرجي واجعل الوصل غايتي % % فإني للذات خير جواد % % 3(@)(@@) % حجبت بحجب الصون عن كل ناظر % % وأسكنت للترحيب أرفع ناد % % 4(@)(@@) % وحف بي الغيد الحسان لخدمتي % % فسري مكتوم وحسني باد % % 5(@)(@@) % ويسر للتوفيق والسعد مركبي % % وذلل للوصل الهني قيادي % % 6(@)(@@) % أوصل في حال الإقامة للمنى % % وأضمن للركاب كل مراد % % 7(@)(@@) % إذا قلت روضا فالنجوم أزاهر % % سقاها الصبا والدل صوب غوادي % % 8(@)(@@) % وإن قلت للأقمار أسعد مطلع % % صدعت بمحض الحق دون عناد % % 9(@)(@@) % تقر ملوك الصين بالفخر كلما % % فخرت بفضل حزته لتلاد % % 10(@)(@@) % وثامن أملاك الجهاد أقامني % % مطية سلم في محل جهاد % % PageV01P378 البحر : طويل 1(@)(@@) % أجلك عن كتب يغص من الود % % وأكرم وجه العذر منك عن الرد % % 2(@)(@@) % ولكني أهدي إليك نصيحتي % % وإن كنت قد أهديتها ثم لم تجد % % 3(@)(@@) % إذا مقول الإنسان جاوز حده % % تحولت الأغراض منك إلى الضد % % 4(@)(@@) % فأصبح منك 
ms87	 الجد هزلا مذمما % % وأصبح منه الهزل في صورة الجد % % 5(@)(@@) % فما اسطعت قبضا للعنان فإنه % % أحق السجايا بالعلاء وبالمجد % % PageV01P379 البحر : طويل 1(@)(@@) % رفلت بإبراهيم في حلل السعد % % وأفردت بالفخر المؤثل والمجد % % 2(@)(@@) % تبنى حسام النصر مني مرضعا % % وعوضت حجر المستعين من المهد % % 3(@)(@@) % فجئت مريني المضا لمن انتضى % % وإن كنت منسوب النجار إلى الهند % % 4(@)(@@) % وكم رىء من نجل أبر بفضله % % على الوالد المشهور بالفضل والحمد % % PageV01P380 البحر : طويل 1(@)(@@) % نشدتك هل أبصرت قبلي أو بعدي % % مقورة قوراء كالقمر السعد % % 2(@)(@@) % رحيبة أكناف ضميمة أنعم % % تدل على الفخر المؤثل والمجد % % 3(@)(@@) % يبشر بالشمل الجميع قدومها % % وتأتي مع العيش الخصيب على وعد % % 4(@)(@@) % تمد ببسم الله في كل مشهد % % وترفع بعد الشكر لله والحمد % % 5(@)(@@) % وتخلف جود الغيث إن أخلف الحيا % % وتكفل للعافين بالرفق والرفد % % 6(@)(@@) % ترى فوقها الطيفور أستاذ حلقة % % معاني حروف الحلق من بعض ما يبدي % % 7(@)(@@) % إذا ما ابن مسد أسندت عنه نعمة % % رأيت أكف القوم تلحم أو تسدي % % 8(@)(@@) % توارثها المولى أبو سالم الرضى % % عن الوالد المولى المقدس والجد % % 9(@)(@@) % علي بن عثمان بن يعقوب ما لها % % مفاخر قد أربت على الحصر والعد % % 10(@)(@@) % أدام لك الله البقاء وأصبحت % % مكارمه نورا على علم فرد % % PageV01P381 البحر : خفيف تام 1(@)(@@) % صدني عن لقاء نجلك عذر % % يمنع الجسم عن تمام العبادة % % 2(@)(@@) % واختصرت القرى لأن حط رحلا % % في محل الغنى ودار الزهادة % % 3(@)(@@) % ولو أني احتفلت لم يعن الدهر % % ولا نلت يعض بعض أراده % % 4(@)(@@) % وعلى كل حالة فقصوري % % عادة إذ قبولك العذر عادة % % 5(@)(@@) % لا عدمت الرضا من الله والحسنى % % كما نص وحيه والزيادة % % PageV01P382 البحر : كامل تام 1(@)(@@) % أنعام أرضك تقهر الأسادا % % طبع كسا الأرواح والأجسادا % % 2(@)(@@) % وخصائص الله بث ضروبها % % في الأرض ساد لأجلها من سادا % % 3(@)(@@) % إن الفضائل في حماك بضائع % % لم تخش من بعد النفاق كسادا % % 4(@)(@@) % كان الهزبر محاربا فجزيته % % بجزاء من في الأرض رام فسادا % % 5(@)(@@) % فابغ المزيد من الإله بشكره % % وارغم بما خولته الحسادا 
ms88	 % % PageV01P383 البحر : منسرح 1(@)(@@) % أبو عنان خير مستخلف % % أصلح من أمر الورى ما فسد % % 2(@)(@@) % لا ينكر الفضل لملاكه % % إلا امرؤ غطى عليه الحسد % % 3(@)(@@) % وحق من جمع في الخلق بين % % النفس والروح وبين الجسد % % 4(@)(@@) % لأنت يا مولاي شمس العلا % % حقا وهذا البرج برج الأسد % % PageV01P384 البحر : كامل تام 1(@)(@@) % قسما بمن يبدي الورى ويعيد % % ويقرب المأمول وهو بعيد % % 2(@)(@@) % وبخير من أدى أمانة وحيه % % إن السعيد على الورى لسعيد % % PageV01P385 البحر : بسيط تام 1(@)(@@) % ما اسم إذا زدته ألفا من العدد % % أفاد معناه لم ينقص ولم يزد % % 2(@)(@@) % وإنما اختلفا من بعد ما ائتلفا % % معنى بشيئين من قدر ومن بلد % % PageV01P386 البحر : بسيط تام 1(@)(@@) % ياذا الذؤابة إلا أنه سعد % % هل يقرب الوصل أو هل ينجز الوعد % % 2(@)(@@) % بي منك ما لو غدا بالشمس ما طلعت % % أو بالغمامة لم يسمع لها رعد % % PageV01P387 البحر : طويل 1(@)(@@) % كما شيكم من أجله انكمش السعد % % إذا ما اطرحتم شؤمه أنجز الوعد % % 2(@)(@@) % ومن لم تكن من قبل للسعد عنده % % مخيلة نجع كيف ترجى له بعد % % 3(@)(@@) % وتصريفه المشؤوم فلتتذكروا % % وما قلت إلا بالذي قد علمت سعد % % PageV01P388 البحر : منسرح 1(@)(@@) % لا ترج إلا الله في شدة % % وثق به فهو الذي أيدك % % 2(@)(@@) % حاشاك أن ترجو إلا الذي % % في ظلمة الأحشاء قد أوجدك % % 3(@)(@@) % واشكره بالرحمة في خلقه % % ووجهك ابسط بالرضا أو يدك % % 4(@)(@@) % والله لا تهمل ألطافه % % قلادة الحق الذي قلدك % % 5(@)(@@) % ما أسعد الملك الذي سسته % % يا عمر العدل وما أسعدك % % PageV01P389 البحر : متقارب تام 1(@)(@@) % أصابتك يا عين عين الحسد % % فتجر الندى والندامى كسد % % 2(@)(@@) % وكلت لكل شهير خطير % % فقمت به وسددت المسد % % 3(@)(@@) % ولما علوت وقدت الزمان % % بحبل فأوهقته من مسد % % 4(@)(@@) % رأى أسدا من أسود الرجال % % لذاك رماك بداء الأسد % % 5(@)(@@) % تعز فما ثم من كائن % % يصاحبه الكون إلا فسد % % 6(@)(@@) % وقد يتأتى صلاح النفوس % % وتطهيرها بفساد الجسد % % PageV01P390 البحر : كامل تام 1(@)(@@) % مكناسة جمعت بها زمر العدا % % فمدى بعيد فيه ألف مريد % % 2(@)(@@) % من 
ms89	 واصل للجوع لا لرياضة % % أو لابس للصوف غير مريد % % 3(@)(@@) % فإذا سلكت طريقها متصوفا % % فابن السلوك فيها على التجريد % % PageV01P391 البحر : رمل تام 1(@)(@@) % عندما لاحت بعيني بردة % % قصد الوقت بها ما قصده % % 2(@)(@@) % قلت يا قوم حصاة قذفت % % شرد النوم فيها من شرده % % 3(@)(@@) % حام سرب النوم للورد به % % ثم لما طرحت ما ورده % % PageV01P392 البحر : طويل 1(@)(@@) % شغلت بيوم العرض عمن وسيلتي % % إلى الله يوم العرض رحمة جده % % 2(@)(@@) % وإن كنت قد قصرت في فرض بره % % فوالله ما قصرت في رعي عهده % % 3(@)(@@) % ولا جهلت نفسي أياديك التي % % جعلت لساني بعدها رهن حمده % % 4(@)(@@) % وإن ضاق وسعي عن قياسي ببعضها % % فما ضاق عن عذر لها وسع مجده % % PageV01P393 البحر : طويل 1(@)(@@) % لقد زالت اللأواء وارتفع الجهد % % وأطنب في شكر الحيا الغور والنجد % % 2(@)(@@) % غداة سرت ريح النعامى لواحقا % % وجاء على آثارها الغيث من بعد % % 3(@)(@@) % سحائب أمثال القطار إذا ونت % % بمثقلة الأوقار صاح بها الرعد % % 4(@)(@@) % وهش عليها البرق بالسوط فانبرت % % تدافع في عرض الفلاة وتشتد % % 5(@)(@@) % فما كان إلا أن أناخت وعرست % % فعرست النعماء واقتضي الوعد % % 6(@)(@@) % وأبرزني كرسي سعد وملتقى % % بدور وميدانا لكل وداد % % 7(@)(@@) % وكم حكمة أبدى وكم ظلمة جلا % % بنور هدى من رأيه ورشاد % % 8(@)(@@) % فدام عزيز الأمر منفسح المدى % % يسالم في ذات الهدى ويعادي % % 9(@)(@@) % ويبلغ غايات المنى وهو وادع % % ويعقد في الأعناق بيض أياد % % 10(@)(@@) % محاسنه كحل إلى كل ناظر % % وطاعته نور بكل فؤاد % % PageV01P394 البحر : طويل 1(@)(@@) % تألق نجديا فأذكرني نجدا % % وهاج لي الشوق المبرح والوجدا % % 2(@)(@@) % وميض رأى برد الغمامة مغفلا % % فمد يدا بالتبر أعملت البردا % % 3(@)(@@) % تبسم في بحرية فتجهت % % فما بذلت وصلا ولا ضربت وعدا % % 4(@)(@@) % وراود منها فاركا قد تمنعت % % فأهوى لها نصلا وهددها رعدا % % 5(@)(@@) % وأغرى بها كف الغلاب فأصبحت % % ذلولا ولم تسطع لامرته ردا % % 6(@)(@@) % فحلتها الحمراء من شفق الضحى % % نضاها وحل المزن من جيدها عقدا % % 7(@)(@@) % لك الله من برق كأن وميضه % % يد الساهر المقرور قد قدحت زندا 
ms90	 % % 8(@)(@@) % تعلم من سكانه شيم الندى % % فغادر أجراع الحمى روضة تندى % % 9(@)(@@) % وتوج من نوارها قنن الربا % % وختم من أزهارها القضب الملدا % % 10(@)(@@) % سرعان ما كانت مناسف للصبا % % فقد ضحكت زهرا وقد خجلت وردا % % PageV01P395 11(@)(@@) % بلاد عهدنا في قراراتها الصبا % % يقل لذاك العهد أن يألف العهدا % % 12(@)(@@) % إذا ما النسيم اعتل في عرصاتها % % تناول فيها البان والشيح والرندا % % 13(@)(@@) % فكم في مجاني وردها من علاقة % % إذا ما استثيرت أرضها أنبتت وجدا % % 14(@)(@@) % أو استشعرتها النفس عاهدت الجوى % % أو التمحتها العين عاقرت السهدا % % 15(@)(@@) % ومن عاشق حر إذا ما استماله % % حديث الهوى العذري صيره عبدا % % 16(@)(@@) % ومن ذابل يحكي المحبين رقة % % فيثني إذا ما هب عرف الصبا قدا % % 17(@)(@@) % سقى الله نجدا ما نضحت بذكرها % % على كبدي إلا وجدت لها بردا % % 18(@)(@@) % وآنس قلبي فهو للعهد حافظ % % وقل على الأيام من يحفظ العهدا % % 19(@)(@@) % صبور وإن لم تبق إلا ذبالة % % إذا استنشقت مسرى الصبا اشتعلت وقدا % % 20(@)(@@) % خفوق إذا الشوق استجاش كتيبة % % تجوس ديار الصبر كان لها بندا % % PageV01P396 21(@)(@@) % وقد كنت جلدا قبل أن تذهب النوى % % ذمائي وأن تستأصل العظم والجلدا % % 22(@)(@@) % أأجحد حق الحب والدمع شاهد % % وقد وقع التسجيل من بعد ما أدى % % 23(@)(@@) % تناثر في إثر الحمول فريده % % فلله عينا من رأى الجوهر الفردا % % 24(@)(@@) % جرى يققا في ملعب الخد أشهبا % % وأجهده ركض الأسى فجرى وردا % % 25(@)(@@) % ومرتحل أجريت دمعي خلفه % % ليرجعه فاستن في إثره قصدا % % 26(@)(@@) % وقلت لقلبي طر إليه برقعتي % % فكان حماما في المسير بها هدا % % 27(@)(@@) % سرقت صواع العزم يوم فراقه % % فلج ولم يرقب سواعا ولا ودا % % 28(@)(@@) % وكحلت جفني من غبار طريقه % % فأعقبها دمعا وأورثها سهدا % % 29(@)(@@) % لي الله كم أهذي بنجد وحاجر % % وأكني بدعدا في غرامي أو سعدي % % 30(@)(@@) % وما هو إلا الشوق ثار كمينه % % فأذهل نفسا لم تبن عنده قصدا % % PageV01P397 31(@)(@@) % وما بي إلا أن سرى الركب موهنا % % وأعمل في رمل الحمى النص والوخدا % % 32(@)(@@) % وجاشت جنود الصبر والبين والأسى % % لدي فكان الصبر 
ms91	 أضعفها جندا % % 33(@)(@@) % ورمت نهوضا واعتزمت مودعا % % فصدني المقدار عن وجهتي صدا % % 34(@)(@@) % رقيق بدت للمشترين عيوبه % % ولم تلتفت دعواه فاستوجب الردا % % 35(@)(@@) % تخلف مني ركب طيبة عانيا % % أما آن للعاني المعنى بأن يفدى % % 36(@)(@@) % مخلف سرب قد أصيب جناحه % % وطرن فلم يسطع مراحا ولا مغدا % % 37(@)(@@) % نشدتك يا ركب الحجاز تضاءلت % % لك الأرض مهما استعرض السهب وامتدا % % 38(@)(@@) % وجم لك المرعى وأذعنت الصوى % % ولم تفتقد ظلا ظليلا ولا ورد % % 39(@)(@@) % إذا أنت شافهت الديار بطيبة % % وجئت بها القبر المقدس واللحدا % % 40(@)(@@) % وآنست نورا من جناب محمد % % يداوي القلوب الغلف والأعين الرمدا % % PageV01P398 41(@)(@@) % فنب عن بعيد الدار في ذلك الحمى % % وأذر به دمعا وعفر به خدا % % 42(@)(@@) % وقل يا رسول الله عبد تقاصرت % % خطاه وأضحى من أحبته فردا % % 43(@)(@@) % ولم يستطع من بعد ما بعد المدى % % سوى لوعة تعتاد أو مدحة تهدى % % 44(@)(@@) % تداركه يا غوث العباد برحمة % % فجودك ما أجدى وكفك ما أندى % % 45(@)(@@) % أجار بك الله العباد من الردى % % وبوأهم ظلا من الأمن ممتدا % % 46(@)(@@) % حمى دينك الدنيا وأقطعك الرضا % % وتوجك العلياء وألبسك الحمدا % % 47(@)(@@) % وطهر منك القلب لما استخصه % % فجلله نورا وأوسعه رشدا % % 48(@)(@@) % دعاه فما ولى هداه فما غوى % % سقاه فما يظمى جلاه فما يصدا % % 49(@)(@@) % تقدمت مختارا تأخرت مبعثا % % فقد شملت علياؤك القبل والبعدا % % 50(@)(@@) % وعلة هذا الكون أنت وكلما % % أعاد فأنت القصد فيه وما أبدا % % PageV01P399 51(@)(@@) % وهل هو إلا مظهر أنت سره % % ليمتاز في الخلق المكب من الأهدى % % 52(@)(@@) % ففي عالم الأسرار ذاتك تجتلي % % ملامح نور لاح للطور فانهدا % % 53(@)(@@) % وفي عالم الحس اغتديت مبوأ % % لتشفي من استشفى وتهدي من استهدى % % 54(@)(@@) % فما كنت لولا أن ثبت هداية % % من الله مثل الخلق رسما ولا حدا % % 55(@)(@@) % بماذا عسى يثني عليك مقصر % % ولم يأل فيك الوحي مدحا ولا حمدا % % 56(@)(@@) % بماذا عسى يجزيك هاو على شفى % % من النار قد أسكنته بعدها الخلدا % % 57(@)(@@) % عليك صلاة الله يا خير مرسل % % وأكرم هاد أوضح الحق والرشدا % % 58 
ms92	(@)(@@) % عليك صلاة الله يا خير راحم % % وأشفق من يثني على رأفة كبدا % % 59(@)(@@) % عليك صلاة الله يا كاشف العمى % % ومذهب ليل الشك وهو قد اربدا % % 60(@)(@@) % إلى كم أراني في البطالة كانعا % % وعمري قد ولى ووزري قد عدا % % PageV01P400 61(@)(@@) % تقضى زماني في لعل وفي عسى % % فلا عزمة تمضي ولا لوعة تهدا % % 62(@)(@@) % حسام جبان كلما شيم نصله % % تراجع بعد العزم والتزم الغمدا % % 63(@)(@@) % ألا ليت شعري هل أراني ناهدا % % أقود القلاص البدن والضامر النهدا % % 64(@)(@@) % رضيع لبان الصدق فوق شملة % % مضمرة وسدت من كورها مهدا % % 65(@)(@@) % فتهدي بأشواقي السراة إذا سرت % % وتحدي بأشواقي الركاب إذا تحدى % % 66(@)(@@) % إلى أن أحط الرحل في تربك الذي % % تضوع ندا ما رأينا له ندا % % 67(@)(@@) % وأطفيء في تلك الموارد غلتي % % وأحسب قربا مهجة شكت البعدا % % 68(@)(@@) % بمولدك اهتز الوجود وأشرقت % % قصور ببصرى ضاءت الهضب والوهدا % % 69(@)(@@) % ومن رعبه الأوثان خرت مهابة % % ومن هوله إيوان فارس قد هدا % % 70(@)(@@) % وضاء له الوادي وصبح عزه % % بيوتا لنار الفرس أعدمها الوقدا % % PageV01P401 71(@)(@@) % رعى الله منها ليلة أطلع الهدى % % على الأرض من آفاقها القمر السعدا % % 72(@)(@@) % وأقرض ملكا قام فينا بحقها % % لقد أحرز الفخر المؤثل والمجدا % % 73(@)(@@) % وحيا على شط الخليج محلة % % يحالف من يلفي بها العيشة الرغدا % % 74(@)(@@) % وجاد الغمام العد فينا خلائفا % % مآثرهم لا تعرف الحصر ولا العدا % % 75(@)(@@) % علي وعثمان ويعقوب لا عدا % % رضا الله ذاك النجل والأب والجدا % % 76(@)(@@) % حموا وهم في حومة البأس والندى % % فكانوا الغيوث المستهلة والأسدا % % 77(@)(@@) % ولله ما ذا خلفوا من خليفة % % حوى الإرث عنهم والوصية والعهدا % % 78(@)(@@) % وقام بأمر الله يحمي حمى الهدى % % فيكفي من استكفى ويعدي من استعدا % % 79(@)(@@) % إذا ما أراد الصعب أغرى بنيله % % صدور العوالي والمطهمة الجردا % % 80(@)(@@) % فكم معتد أردى وكم تائه هدى % % وكم حكمة أضفى وكم نعمة أبدى % % PageV01P402 81(@)(@@) % أبا سالم دين الإله بك اعتلى % % أبا سالم ظل الأمان بك امتدا % % 82(@)(@@) % فدم من دفاع الله تحت وقاية % % كفاك بها أن تسحب الحلق السردا 
ms93	 % % 83(@)(@@) % ودونكها مني نتيجة فكرة % % إذا استرشحت للنظم كانت صفا صلدا % % 84(@)(@@) % ولو تركت من الليالي صبابة % % لأجهدتها ركضا وأرهقتها شدا % % 85(@)(@@) % ولكنه جهد المقل بذلته % % وقد أوضح الأعذار من بلغ الجهدا % % PageV01P403 البحر : طويل 1(@)(@@) % دعا عزماتي والمطية والوخدا % % وإلا فكفا الشوق عني والوجدا % % 2(@)(@@) % ولا تصليا دمعي بتجريح مقلتي % % فدمعي مقبول على القلب ما أدا % % 3(@)(@@) % ألم ترياني كلما هبت الصبا % % أبل بها من نار لوعتي ال . . . % 4(@)(@@) % وأصبوا إلى البرق الحجازي كلما % % أجالت أكف الأفق في آسيها الزندا % % 5(@)(@@) % وما كان قبل اليوم جفني ساهرا % % نعم هجر سعدى علم المقلة السهدا % % 6(@)(@@) % ولما تفانى الصبر إلا صبابة % % تسهل من وقع الحوادث ما اشتدا % % 7(@)(@@) % ولم يبق مني غير رعي موافق % % تعلم منها الأس أن يحفظ العهدا % % 8(@)(@@) % حننت إلى العهد القديم الذي قضي % % حميدا فما أغنى الحنين ولا أجدا % % 9(@)(@@) % لي الله كم أهذي بنجد وحاجر % % وأكني بدعد في غرامي أو سعدا % % 10(@)(@@) % وما هي إلا زفرة هاجها الهوى % % وأبدى بها تذكار يثرب ما أبدا % % PageV01P404 11(@)(@@) % وكم قد كتمت الشوق لولا مدامع % % يروي حديثها المحاجر والخدا % % 12(@)(@@) % وتخرج من بحر الجفون جواهرا % % تحاجي بها من أذكر الجوهر الفردا % % 13(@)(@@) % أبعد سرى الركب الحجازي موهنا % % أمد لنفسي في تعللها مدا % % 14(@)(@@) % وأرجع عمري من زماني لقابل % % كأني قد أحصيت أيامه عدا % % 15(@)(@@) % ألا يا حداة الركب يبغون يثربا % % ويلقون في الله السأمة والجهدا % % 16(@)(@@) % بما بيننا من خلة طاب ذكرها % % إذا فرغت عوج المطي بكم نجدا % % 17(@)(@@) % وأبصرتم نور النبوة ساطعا % % قد اكتنف الترب المقدس واللحدا % % 18(@)(@@) % وناجيتما من مطلع الوحي روضة % % أعد لها الله السعادة والخلدا % % 19(@)(@@) % ولا قلب إلا خافق في شغافه % % ولا طرف إلا من مهابتها ارتدا % % 20(@)(@@) % معاهد مد الغيم فضل رواقه % % بها وكساها من نسيجته بردا % % PageV01P405 21(@)(@@) % وهب العليل اللدن مستشفيا بها % % فكان الدواء البان والشيح والرندا % % 22(@)(@@) % ودأرا أقام الوحي في عرصاتها % % فلم يبق عنها بعد خلتها بعدا % % 23(@)(@@) % فقولوا رسول الله يا 
ms94	 خير خلقه % % وأكرم مختار أبان به الرشدا % % 24(@)(@@) % غريب بأقصى الغرب طال اشتياقه % % فلولا تعلات المنى لقضى وجدا % % 25(@)(@@) % يؤمل نيل القرب والذنب مبعد % % وقد سد من طرق التخلص ما سدا % % 26(@)(@@) % المقدار منك مراده % % وشاقه منك القرب لا استوجب الردا % % 27(@)(@@) % ولكنه يرجو الذي أنت أهله % % وأنت الذي أعطى الجزيل وما أكدا % % 28(@)(@@) % وأنت ملاذ الخلق حيا وميتا % % وأكرمهم ذاتا وأعظمهم مجدا % % 29(@)(@@) % فلولاك ما بان الضلال من الهدى % % ولا امتاز في الأرض المكب من الأهدا % % 30(@)(@@) % ولما محت آي الشرائع فطرة % % وأصبحت الأهواء لا تعرف القصدا % % PageV01P406 31(@)(@@) % وتعبد من دون الإله حجارة % % طغام رجال يجعلون له ندا % % 32(@)(@@) % وقد شنت الغارات من كل تلعة % % فأصبح حر القوم عن كثب عبدا % % 33(@)(@@) % أراد بك الله انكحام شتاتهم % % وسل وشيكا من صدورهم الحقدا % % 34(@)(@@) % وفاض على الأديان دينك واحتوت % % جنودك أقصى الشام والصين والهندا % % 35(@)(@@) % وأنحت على ملك العراقين وانتهت % % بتبت حتى واجهت خيلها السدا % % 36(@)(@@) % وكم قد تجهمت الخطوب كوالحا % % وصابرت ليل الربع وهو قد اربدا % % 37(@)(@@) % وأدت في الله العشيرة جهدها % % فجادلتها بالحق السنة اللدا % % 38(@)(@@) % وكم قد جلوت المعجزات عليهم % % شموسا أقاموا دونها اللبس والجحدا % % 39(@)(@@) % وما يثمر البرهان إلا لجاجة % % إذا لقيت أنواره أعينا رمدا % % 40(@)(@@) % فصلى عليك الله يا خير راحم % % وأشفق من يثني على رأفة كبدا % % PageV01P407 41(@)(@@) % ويا ليت أني في جوارك ثاويا % % أوسد منه المسك والعنبر الوردا % % 42(@)(@@) % وإن فسح الرحمن في العمر برهة % % فلا بد من حث المطية لا بدا % % 43(@)(@@) % خليلي ماذا يحصر القول إن غلا % % وماذا عسى يحصي الكلام وإن ندا % % 44(@)(@@) % وماذا يعد الوصف من معجزاته % % وآي رسول الله تستغرق العدا % % 45(@)(@@) % سما فوق أطباق السماء مناجيا % % وكلم تكليما بها الأحد الفردا % % 46(@)(@@) % وما زاغ منه الطرف كلا ولا طغى % % فلله ما أجلى ولله ما أهدى % % 47(@)(@@) % ولما دعا بالجذع أقبل خاضعا % % إليه وشق البدر واستنطق الصلدا % % 48(@)(@@) % ولما شكا الجيش اللهام له الظما % % أسال له من ماء أنمله 
ms95	 وردا % % 49(@)(@@) % وأثبت منه الريق عين قتادة % % فأحكمها من بعد ما ذهبت ردا % % 50(@)(@@) % وفي ليلة الميلاد أكبر آية % % تخر الجبال الراسيات له هدا % % PageV01P408 51(@)(@@) % أشادت بها الكهان قبل طلوعها % % ومن هولها إيوان كسرى قد انهدا % % 52(@)(@@) % فيا ليلة قد عظم الله قدرها % % وأنجز للنور المبين بها وعدا % % 53(@)(@@) % وصير أوثان الضلالة خضعا % % إليها فلم يترك سواعا ولا ودا % % 54(@)(@@) % وعاجل بالإخماد نيران فارس % % فلم تر للنيران من بعدها وقدا % % 55(@)(@@) % أعدك ميلادا لخاتم رسله % % وأطلع في آفاقك الشرف السعدا % % 56(@)(@@) % فصولي على مر الزمان وفاخري % % بهذا النبي الحال والقبل والبعدا % % 57(@)(@@) % حقيق علينا أن نحل لك الحبا % % ونقريك منا البر والشكر والحمدا % % 58(@)(@@) % ونجعل فيها منك عيدا ومشهدا % % نشيع من الذكر الحكيم به شهدا % % 59(@)(@@) % ونخلع من أمداح أحمد حلة % % عليك ومن منظوم آياته عقدا % % 60(@)(@@) % وفينا سليل النصر يحفظ منك ما % % أضيع ويلقى فيك بالبدر الوفدا % % PageV01P409 61(@)(@@) % إمام أفاض الله في الأرض عدله % % فأوشك فيها الضد أن يألف الضدا % % 62(@)(@@) % أقام على حب النبي وآله % % وأشرب تقوى ربه الحل والعقدا % % 63(@)(@@) % نما سيد الأنصار سعد وسددت % % يد له في أغراضه النصر والسعدا % % 64(@)(@@) % وأروث حق النصر لا عن كلالة % % وللسبط في المشروع أن يرث الجدا % % 65(@)(@@) % أيوسف يا حامي الجزيرة حيث لا % % نصير ومصلي بأسها الضمر الجردا % % 66(@)(@@) % أفاض عليها الله ملكك ديمة % % وروى ثراها منك منسكبا عهدا % % 67(@)(@@) % فملكك فيها ما أجل جلاله % % وسيفك ما أسطى وكفك ما أندا % % 68(@)(@@) % صدعت بأمر الله في جنباتها % % فألبسك التقوى وقلدك العضدا % % PageV01P410 البحر : كامل تام 1(@)(@@) % هاجتك إذ جئت اللوى فزرودا % % ذكراك أوطانا بها وعهودا % % 2(@)(@@) % عاثت بهن يد الزمان فلم تجد % % أعلامهن عن العفاء محيدا % % 3(@)(@@) % إلا مواقد كالحمام جواتما % % وترى بأظلاف الظباء كديدا % % 4(@)(@@) % دمن غذيت بهن أخلاف الهوى % % ولبست ريعان الشباب جديدا % % 5(@)(@@) % وركضت طرف اللهوي في شأو الصبا % % مرحا فجرت مدى النعيم بعيدا % % 6(@)(@@) % مالي وتذكار الصبابة والصبا % % ومواثقا عند الهوى وعهودا % % 7(@)(@@) % وصباح شيب الفود 
ms96	 لاح بمفرقي % % فغدوت من فقد الصبا مفؤودا % % 8(@)(@@) % أنا إلى الرحمن منها أنفسا % % بذين من ظلم الجسود لحودا % % 9(@)(@@) % نسيت عوالمها الكرام فنورها % % تستامه أيدي الهوى تبديدا % % 10(@)(@@) % واستوترت شبحا خلاء لم يزل % % لخفي معناها الأثير ضديدا % % PageV01P411 11(@)(@@) % ترد الأجاج مرنقا ولطالما % % وردت بأكناف العذيب برودا % % 12(@)(@@) % هلا استظلت دوحة القدس التي % % كرعت قبيل الكون فيه . . . % 13(@)(@@) % وتذكرت عهدا بمنعرج اللوى % % لا يستحيل وموثقا مشهودا % % 14(@)(@@) % ورقت معاريج العلا لتجوز في % % سمط الجلال نظامها المعهودا % % 15(@)(@@) % ذنبي عداني عن لحاق ذوي الهوى % % فغدوت عن درك الرشاد طريدا % % 16(@)(@@) % يا مصطفى الرحمن والنور الذي % % أخفى الضلال وأظهر التوحيدا % % 17(@)(@@) % المنتقى من سر هاشم في الذرا % % حيث استقر مدى الفخار صعودا % % 18(@)(@@) % جيران بيت الله والعرب الألى % % أضحوا على قنن النجوم قعودا % % 19(@)(@@) % تخذوا السيوف تمائما لوليدهم % % والحرب ظئرا والسروج مهودا % % 20(@)(@@) % وحوى الكبير فخاره عن كابر % % وتوارث الأبناء فيه جدودا % % PageV01P412 21(@)(@@) % أعلقت كفي منك حبل محبتي % % لا واهنا خلقا ولا مجدودا % % 22(@)(@@) % وجعلت مدحك للإله وسيلتي % % فشربت في دار النعيم خلودا % % 23(@)(@@) % فإذا بدت هوج الخطوب عواصفا % % وافيت ركنا من حماك شديدا % % 24(@)(@@) % وإذا عدت أيدي الذنوب عواسفا % % لتعيث كنت الملجأ المقصودا % % 25(@)(@@) % الخلق يوم العرض جاهك تعتفي % % تأتي على قدم الصغار رقودا % % 26(@)(@@) % متأملين إلى الحساب ذواهلا % % متهيبين الموقف الموعودا % % 27(@)(@@) % راجين فيه لديك فضل شفاعة % % ومؤملين مقامك المحمودا % % 28(@)(@@) % لله در ركائب قطعت إلى % % مغنى ثراك تهائما ونجودا % % 29(@)(@@) % قوم أهاب بعزمهم داعي الهوى % % فاستشعروا التقوى وجابوا البيدا % % 30(@)(@@) % فإذا ظلام الليل مد جناحه % % كحلوا عيونهم تسهيدا % % PageV01P413 31(@)(@@) % وإذا النهار جلى الظلام وأتلعت % % من ميسمها الغزالة جيدا % % 32(@)(@@) % لبسوا الهجير وصافحوا غبر الفلا % % وصلوا لصارمها بهن وقودا % % 33(@)(@@) % وأتوا خضم الماء يزخر مزجه % % فشروا بإعدام الحياة وجودا % % 34(@)(@@) % عوجا تلح لها الرياض أعنة % % والساج جسما والهناء جلودا % % 35(@)(@@) % تفري أديم الماء وهي نواصع % % منه وتترك خده أخدودا % % 36(@)(@@) % أموا ضريحا طاب نشرا عرفه % % وزكا بنور المعجزات صعيدا % % 37(@)(@@) % جعلوا 
ms97	 الكلام به دعاء خافتا % % واستبدلوا فيه النعال خدودا % % 38(@)(@@) % شحب الجسوم تخالهم إذا أجهشوا % % بانا بأخلاف الدموع مجودا % % 39(@)(@@) % أقسمت بالنور الذي سبحانه % % أضحى لها الطور المنيف مديدا % % 40(@)(@@) % لمحمد خير البرية كلها % % ذاتا وأوسعهم سنات جودا % % PageV01P414 41(@)(@@) % أعزز بمولده الكريم وخصه % % من ذكرك التقديس والتمجيدا % % 42(@)(@@) % يا ليلة تخذ الملائك يومها % % والمرسلون إلى القيامة عيدا % % 43(@)(@@) % أضحت لها أصنام مكة سجدا % % ذللا على صفح الرغام همودا % % 44(@)(@@) % وتقاول الكهان أن رئيها % % أضحى لديك مقرنا مصفودا % % 45(@)(@@) % وبيوت فارس أرمدت نيرانها % % واعتض من لفح الضرام خمودا % % 46(@)(@@) % وأتت على إيوان كسرى رجة % % هدت قواعده وكان مشيدا % % 47(@)(@@) % صلى عليك الله ما هبت الصبا % % وهنا فهزت مائسا أملودا % % 48(@)(@@) % وبكت حمام البان بين هديلها % % شجوا يهيج ورجعت تغريدا % % PageV01P415 البحر : طويل 1(@)(@@) % نعمنا بوصل من حبيب مساعد % % وقد أقلق النفس انتظار المواعد % % 2(@)(@@) % ونلنا كما شاء الهوى عقب النوى % % على رغم أنف من عدو وحاسد % % 3(@)(@@) % الظلام كأنها % % أحاديث سر ضمها قلب جاحد % % 4(@)(@@) % نجاذب أهداب العتاب لطيفة % % فنسقي بعهد الدمع ذكر المعاهد % % 5(@)(@@) % ونمزح كأس الراح تترع بيننا % % شمولا بمعسول من الريق بارد % % 6(@)(@@) % ونلثم ما بين النحور إلى الطلى % % وإن هي غصت بالحلى والقلائد % % 7(@)(@@) % وننهل في ورد اللماغلة الظما % % فيالك من ري لغلة وارد % % 8(@)(@@) % وننعم من وصل الحبيب بجنة % % هي الخلد لكن الفتى غير خالد % % 9(@)(@@) % ولما استمال النوم والكأس جفنه % % وألقى لسلطان الكرى بالمقالد % % 10(@)(@@) % نضحت على نيران قلبي بقربه % % ووسدته ما بين نحري وساعدي % % PageV01P416 11(@)(@@) % وكانت إلى ذكر الفراق التفاتة % % قدحت بها زند الأسى غير خامد % % 12(@)(@@) % فأيقظه قلب خفوق ومقلة % % تجود بدر ذائب غير جامد % % 13(@)(@@) % وريع وقد شد العناق وثاقه % % كما ريع ظبي في حبالة صائد % % 14(@)(@@) % فأقبل يشكو ضعف ما أنا أشتكي % % ويسأل من أشواقه كل شاهد % % 15(@)(@@) % ويقسم لي أن لا يخون مواثقا % % تخذت عليه محكمات المعاقد % % 16(@)(@@) % وقال لتهن الوصل مني فإنما % % يهون إلى المحبوب خوض الشدائد % % 17(@)(@@) % إلى أن دعا 
ms98	 داعي الصباح وأقبلت % % طلائع فجر للدجنة ذائد % % 18(@)(@@) % فعانقت منه الغصن في كثب النقى % % وقبلت منه البدر بين الفراقد % % 19(@)(@@) % وودعته كرها وداع ضرورة % % وحكم النوى يجري على غير واحد % % 20(@)(@@) % وقام كما هب النسيم بسحره % % فمال بممطور من البان مائد % % PageV01P417 21(@)(@@) % وولى فرد الطرف نحوي مسلما % % به بين أطراف حسان النواهد % % 22(@)(@@) % فأما اصطباري فهو أول راحل % % وأما اشتياقي فهو أول قاعد % % 23(@)(@@) % فيا قلبي صبرا إن للدهر رجعة % % لعل زمانا للوصال بعائد % % PageV01P418 البحر : كامل تام 1(@)(@@) % لا جادك الغيث الهمول إذا سقى % % غيث بلاد الله يا بلذوذ % % PageV01P419 البحر : كامل تام 1(@)(@@) % نفحت فشبت لافح التذكار % % والنجم نضو سرى وفل سفار % % 2(@)(@@) % وأتت محملة متون أحادث % % فاهت بهن مباسم الأزهار % % 3(@)(@@) % هفافة يقضي لطيف هبوبها % % بتذكر الأوطان والأوطار % % 4(@)(@@) % فضلوع مشتقاق يشب وقودها % % ذكر العهود ودمع عين جار % % 5(@)(@@) % لله ما قد هجت يا ريح الصبا % % وقدحت ما بين جوانجي من نار % % 6(@)(@@) % أمعللي بمطامع من دونها % % قطع النفوس مراحل الأعمار % % 7(@)(@@) % أرتاح فيك للوم لوامي كما % % يرتاح نجدي لشم عرار % % 8(@)(@@) % لله من قلب تقسم ناره % % ما بين مدمع ديمة وأوار % % 9(@)(@@) % تتعاور الأفكار فيه ذبالة % % فهي الفراش تجول حول النار % % 10(@)(@@) % إما نطقت فذكر عهدك منطقي % % وإذا صمت فأنت في إضمار % % PageV01P420 11(@)(@@) % تزداد أشواقي إذا يوم خلا % % كتضاعف الأعداد بالأصفار % % 12(@)(@@) % من لي بقلب كلما نادى به % % داعي الصبابة طار كل مطار % % 13(@)(@@) % مطل الغنى ظلم ففيم ظلمتني % % ولويت ديني عن وجودي يساري % % 14(@)(@@) % جاورت قلبي واطرحت حقوقه % % والله قد وصى بحفظ الجار % % 15(@)(@@) % يا سائلي سلا عليما بالهوى % % عند العروض حقائق الأشطار % % 16(@)(@@) % إني ارمؤ أعطيت دهري مقودي % % وجريت في طلق مع الأعصار % % 17(@)(@@) % وخلعت نسكي واشتملت تولهي % % ما بين كاس فم وآس عذار % % 18(@)(@@) % والفت في شرك الجفون تخبطي % % فحذار من فتن العيون حذار % % 19(@)(@@) % أو لست من لاك الكلام وصاغه % % قيد الركاب وطرفة الأسمار % % 20(@)(@@) % فإذا مدحت هي النجوم قلادة % % وإذا نسبت فنسمة الأسحار 
ms99	 % % PageV01P421 21(@)(@@) % وظللت أطلب في الكرام نشيدتي % % حتى أنخت بعقوة الأنصار % % 22(@)(@@) % فحططت رحلي بين نيران القرى % % ورميت بينهم عصا التسيار % % 23(@)(@@) % لله مثوى جنة يممته % % حزب الرسول وأسوة المختار % % 24(@)(@@) % يا وافدي بر وبحر لذتما % % بمربع مرتبع وعز جوار % % 25(@)(@@) % نصروا الرسول وقد دجى ليل الهوى % % والروع دامي الناب والأظفار % % 26(@)(@@) % ورعوا له بعد الوفاة حقوقه % % فمرت سيوف الله كل ممار % % 27(@)(@@) % قوم من العرب اليمانيين الألى % % نصروا الهدى وتبوؤا بالدار % % 28(@)(@@) % قاموا بأمر الله والإسلام ما % % بين العدو ومزبد زخار % % 29(@)(@@) % واسترهفوا البيض العضاب كأنما % % تمضي بكفي خالد وضرار % % 30(@)(@@) % أخليفة الرحمن وابن عميدهم % % والمرتجى لجلائل الأخطار % % PageV01P422 31(@)(@@) % حياك بالإرشاد والإسعاد من % % أحيا بك الإسلام بعد تبار % % 32(@)(@@) % وحباك بالنصر العزيز مهيمن % % نعش الورى بك بعد طول عثار % % 33(@)(@@) % أرعاك أمر عباده فرعيتهم % % في حالي الإعلان والإسرار % % 34(@)(@@) % ونهجت طرق العدل مهتديا بما % % شهدت عليه صحائح الأخبار % % 35(@)(@@) % وافيت والإسلام صوح نبته % % فأتيته بالديمة المدرار % % 36(@)(@@) % لولا بنو نصر لأندلس % % لما عمر الهدى فيها قرارة دار % % 37(@)(@@) % وصدمت بحر الخطب بعد ذمامه % % ما بين غرب مثقف وغرار % % 38(@)(@@) % لله يا لله سيرة يوسف % % محي العفاة وقاتل الإقتار % % 39(@)(@@) % رحمى بلا من وأمن دونما % % رهب وحفظ أذمة وذمار % % 40(@)(@@) % نور كما متع الصباح لناظر % % وخلائق كالروض عب قطار % % PageV01P423 41(@)(@@) % إن راع خطب أو عرى جدب ترى % % كفاه تدرأ ذا % % 42(@)(@@) % لو كان في جفر الهباءة ماثلا % % لعدا على النقد الهزبر الضار % % 43(@)(@@) % أو كان في قنص بن معد ثاوبا % % دهم العفاء ربيعه بن نزار % % 44(@)(@@) % ولما تلاشوا جبلا ورمت بهم % % أيدي النبيط أقاصي الأنبار % % 45(@)(@@) % أو كان في يوم الضريم لما غدا % % حكم بن زنباع رهين إسار % % 46(@)(@@) % أو أمه عمر بن بكر ما طفت % % مهجات صبيته في ذي قار % % 47(@)(@@) % ولو أن حمير أغفلت أيامها % % لشكت إليه عياث ذي الأدعار % % 48(@)(@@) % يا ابن الخلائف والذين إذا احتبوا % % أبصرت في النادي هضاب وقار % % 49(@)(@@) % حامين يومهم الذمار ونارهم % % بالليل تهدي 
ms100	 في الظلام الساري % % 50(@)(@@) % خذها كما شاء الخلوص بديعة % % تزهى بشارتها على بشار % % PageV01P424 51(@)(@@) % سكنت معانها سواد مدادهنا % % إن المدامة سرها في القار % % 52(@)(@@) % ما ضرني أن لم أجيء متقدما % % السبق يعرف آخر المضمار % % 53(@)(@@) % ولئن غدا بحر البلاغة بلقعا % % فلرب كنز في أساس جدا % % 54(@)(@@) % وعلى احتفال المدح فيك فإنما % % هي نقطة من يحرك الزخار % % PageV01P425 البحر : كامل تام 1(@)(@@) % يا ربة البيت الممنع جاره % % وريبة الشرف العلي مناره % % 2(@)(@@) % ما بال قلبك لا يرق لهائم % % أم ما لقلبي لا يقر قراره % % 3(@)(@@) % باعدت بين جفون صبك والكرى % % حتى تساوى ليله ونهاره % % 4(@)(@@) % وحميت طير النوم ورد شؤونه % % فالنوم لا يرد الجفون غراره % % 5(@)(@@) % إن كنت تنكر ما بقلبي من جوى % % يلتاج في طي الضلوع أواره % % 6(@)(@@) % فاستشهدي الدمع السفوح بوجنتي % % واستخبري الطيف النزوح قراره % % 7(@)(@@) % وحذار من شرر الحشا أن تسألي % % فإذا قدحت الزند طار شراره % % 8(@)(@@) % تعس العذول أما درى أن الهوى % % خفيت على أربابه أسراره % % 9(@)(@@) % إن كان أبطره السلو فإنما % % سلوان مثلي في هواك تباره % % 10(@)(@@) % ما للسلو وللمشوق أتينني % % من قلبه بغرامه سناره % % PageV01P426 11(@)(@@) % يا كعبة الحسن الذي قلبي له % % مرمى الجمار وأضلعي أستاره % % 12(@)(@@) % مني بأيسر نائل تحي به % % قلبا تقسم في الهوى أعشاره % % 13(@)(@@) % قالت وقد حذرت حبال مطامعي % % لا ينكرن على الغزال نفاره % % 14(@)(@@) % لا تخدعن فإنني إنسية % % والحسن يلعب بالنهى غراره % % 15(@)(@@) % أو ما ترى الملك ابن نصر يوسفا % % أسدا وأنصار النبي نجاره % % 16(@)(@@) % ملك إذا دهم الردى ترك العدا % % جزرا تجرر بالفلا أكساره % % 17(@)(@@) % نصر الجزيرة حيث لا مستصرخ % % والباس دامية الشبا أظفاره % % 18(@)(@@) % وكفت شديد حروبها وجدوبها % % كفا الجلال يمينه ويساره % % 19(@)(@@) % حتى إذا القحت حروب الجدب عن % % أزل وغال جنابها إضراره % % 20(@)(@@) % فبكل أفق رائد لا يلتقي % % لفظته عن ساحاتها أغواره % % PageV01P427 21(@)(@@) % والضرع أصبح منه بعد جفوله % % جفت غضارته وغاض سماره % % 22(@)(@@) % عادت بمصفر القتاد لقاحه % % واسترفدت عشر الفلاة عشاره % % 23(@)(@@) % والقوت قلص للنفاد ظلاله % % والأزل قد شمل 