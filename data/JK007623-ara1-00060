ms41	 فكيف سفورها % % 4(@)(@@) % فما ضرها رفع الستور وإنما % % يردك عنها نورها لا ستورها % % 5(@)(@@) % ليهن مروط الخسرواني إنه % يباشر منها بالحرير حريرها % % 6(@)(@@) % هلالية الانساب والبعد والسنا % % فلسنا بغير الوهم يوما نزورها % % 7(@)(@@) % يحف بها في الظعن من سر عامر % بدور دجى هالاتهن خدورها % % 8(@)(@@) % إذا زين الحلي النساء فإنه % % تزينه أجيادها ونحورها % % 9(@)(@@) % وإن بقلبي نحوهن لغلة % يقوم معوج الضلوع زفيرها % % 10(@)(@@) % نزلن بروض الحزن فابتسمت به % % ثغور أقاح والعيون ثغورها % % PageV01P124 11(@)(@@) % وفتح ذيل الطل أجفان زهره % فلاحظنا زرق العيون وحورها % % 12(@)(@@) % فهل عند غصن البانة اللدن أنه % % تناسبه أجيادها وخصورها % % 13(@)(@@) % أيا من لعين لا يغيض معينها % % ورمضاء قلب ما يخف هجيرها % % 14(@)(@@) % إذا خطرت من ذكر علوة خطرة % على كبدي كاد النوى يستطيرها % % 15(@)(@@) % وأطلب منها رد نفس بكفها % % وهل رد نفسا قبلها مستعيرها % % 16(@)(@@) % وأهوى تداني أرضها لا لبغية % % ولكنقلبي حيث سارت أسيرها % % 17(@)(@@) % فطمت فطام الفلو نفسي عن الصبى % % فريعت له ثم استمر مريرها % % 18(@)(@@) % وسرت ولليل الأحم شبيبة % % على كل أفق والصباح نثيرها % % 19(@)(@@) % بفضلة مرقال أمون كأنها % % يناط على بعض الأهلة كورها % % 20(@)(@@) % تبارى فتبري كل حرف كأنما % % على سية من نبع قوس جديرها % % PageV01P125 21(@)(@@) % يخيل لي أن الفيافي مصاحف % % ودامي آثار المطي عشورها % % 22(@)(@@) % هداهن في الظلماء من دولة الهدى % % ودولة طي شمسها ومنيرها % % 23(@)(@@) % كتبنا على أعناقها وخدودها % % حرام إلى غير الأمير مسيرها % % 24(@)(@@) % نقيس عطاياه وليس مواهب % تقايس هذا الدر إلا نحورها % % 25(@)(@@) % له منطق ينبيك عن بأسه كما % % يدل على بأس الأسود زئيرها % % 26(@)(@@) % فللبيض والجدوى بطون بنانه % % معا ولتقبيل الملوك ظهورها % % 27(@)(@@) % ولو أن تقبيلا محا الكف لانمحت % % براجم كفيه وبان دثورها % % 28(@)(@@) % تقر له بالسبق طي وإنه % ليسبق أجواد الرجال حسيرها % % 29(@)(@@) % فأشرف أعضاء الرجال قلوبها % % وأشرفها إن قبلته ثغورها % % 30(@)(@@) % يقلدها طوق العطايا فإن نبت % % عن الشكر عاد الطوق غلا يديرها % % PageV01P126 31(@)(@@) % ويصغر كل الناس في جنب طيئ % ويصغر في جنب الأمير كبيرها % % 32(@)(@@) % إلا إن 
ms42	 وجه المجد طي وعينه % كرام حنين والمفرج نورها % % 33(@)(@@) % وقد كان أولاها يطول بحاتم % كما بأبي الذواد طال أخيرها % % 34(@)(@@) % فلو قيس أهل الأرض دع عنك حاتما % بخنصره أربى عليهم قصيرها % % 35(@)(@@) % فإن كنت مرتابا بقولي فهذه % % مواهب كفيه فأين نظيرها % % 36(@)(@@) % ألا إن للعلياء والمجد كتبة % % تلوح على وجه الأمير سطورها % % 37(@)(@@) % ولا دولة إلا ويهتز تاجها % % ويرتج من شوق إليه سريرها % % 38(@)(@@) % وتختال أعواد المنابر باسمه % % فيرقص تيها بالوقور وقورها % % 39(@)(@@) % وللعرب العرباء منه معاقل % تطل على الشعرى العبور قصورها % % 40(@)(@@) % شرائفها زرق الأسنة والقنا % % دعائمها والضرب والطعن سورها % % PageV01P127 41(@)(@@) % بعز أبي الذواد عز ذليلها % % وذلت أعاديها وسدت ثغورها % % 42(@)(@@) % إذا قيل في الهيجاء هذا مفرج % % فأنجب فرسان العداة فريرها % % 43(@)(@@) % تفر الأعادي باسمه قبل جسمه % وهمهمة الأسد الضواري زئيرها % % 44(@)(@@) % يزين دم الأبطال أكتاف درعه % % كما زان أثواب العروس عبيرها % % 45(@)(@@) % ويفري بيمناه الكليل من الظبى % % ويزداد طولا في يديه قصيرها % % 46(@)(@@) % كذا الليث يفري كل ظفر بكفه % % وتنبو بكف من سواه ظفورها % % 47(@)(@@) % وما ذكر الأسياف إلا كغيره % % إذا لم يؤيد بالذكور ذكورها % % 48(@)(@@) % يخوض به زرق الأسنة سابق % % على مثله خوض الوغى وعبورها % % 49(@)(@@) % شمال اذا ولى جنوب إذا أتى % % وإن يعترض فهو الصبا ودبورها % % 50(@)(@@) % يرض الحصى منه حوام كأنما % % مناسر أفواه النسور نسورها % % PageV01P128 51(@)(@@) % لقد ضاع أمر لا يكون يديره % % وأنساب مجد لا يظل يعيرها % % 52(@)(@@) % وخابت جيوش لا تكون أميرها % % لدى الروع أو يؤتى إليك أمورها % % 53(@)(@@) % فإنك ما أنسلت إلا أجادلا % تخطف بازات الملوك صقورها % % 54(@)(@@) % قعدت بمرصاد لكل فضيلة % فلا رتبة إلا إليك مصيرها % % 55(@)(@@) % وكيف يفوت المجد أبلج أروع % % شموس العلى في أصله وبدورها % % 56(@)(@@) % أبى عز طي أن تقبل منة % % لغيرك أو تحدى لغيرك غيرها % % 57(@)(@@) % فهم مثل أشبال الضراغم لم تكن % % لتطعم إلا ما يصيد كبيرها % % 58(@)(@@) % لكل امرئ منهم من المجد رتبة % على قدر أو خطة يستديرها % % 59(@)(@@) % فيلقاك بالجود الجني غنيها % % ويلقاك بالوجه الطليق فقيرها 
ms43	 % % 60(@)(@@) % تفيض على العلات ماء جنابها % % وماء أياديها على من يزورها % % PageV01P129 61(@)(@@) % تباشر بالأضياف حتى كأنما % % أتاها مع الضيف المنيخ بشيرها % % 62(@)(@@) % إذا ضاق صدر المجتدي وفناؤه % فقد رحبت ساحاتها وصدروها % % 63(@)(@@) % هي الأسد لكن يأمن الغدر جارها % % ولا يأمن الآساد من يستجيرها % % 64(@)(@@) % تنافس في عز المعالي كأنها % % عقائل لكن العطايا مهورها % % 65(@)(@@) % وأحييت بالآلاء أموات طيئ % بذكرك من قبل النشور نشورها % % 66(@)(@@) % أرى المجد إنسانا وقحطان قلبه % % وسوداؤه طي وأنت ضميرها % % PageV01P130 البحر : - 1(@)(@@) % هي البدر لكن تستسر مدى الدهر % % وكل سرار البدر يومان في الشهر % % 2(@)(@@) % هلالية نيل الأهلة دونها % % وكل نفيس القدر ذو مطلب وعر % % 3(@)(@@) % ومن دونها سوران سور من النوى % % وسور من الأسياف والأسل والسمر % % 4(@)(@@) % طوى طيفها في النوم نحوي مفاوزا % من الأرض تنضي راكب البر والبحر % % 5(@)(@@) % فيا ليلة كانت له بسوادها % % وبهجتها كالخال في وجنة الدهر % % 6(@)(@@) % لها سيف جفن لا يزال جفنه % % ولم أر سيفا قط في غمده يفري % % 7(@)(@@) % عيون هلال في القلوب ولحظها % % أحد وأمضى من سيوفهم البتر % % 8(@)(@@) % ويقصر ليلي أن المت لأنها % % صباح وهل لليل بقيا مع الفجر % % 9(@)(@@) % أقول لها والعيس تحدج للنوى % % أعدي لبيني ما استطعت من الصبر % % 10(@)(@@) % وقد كانت الأجفان للجزع معدنا % فصارت لفيض الدمع من صدف البحر % % PageV01P131 11(@)(@@) % سأنفق ريعان الشبيبة آنفا % على طلب العلياء أو طلب الأجر % % 12(@)(@@) % أليس من الخسران أن لياليا % تمر بلا نفع وتحسب من عمري % % 13(@)(@@) % تبدل وجه الأرض من كل وجهة % % ليأخذ بالتعبيس من رونق البشر % % 14(@)(@@) % وقد كان نجما واضحا كمحمد % % ومثل علاه أو خلائقه الغر % 15(@)(@@) % تميزه عن كل شبه فضائل % شهرن له في الأرض كالواو في عمرو % % 16(@)(@@) % ويعرف قبل الخير بالبشر فضله % كما يعرف الصمصامة العضب بالأثر % % 17(@)(@@) % فلا تعجبن أن يلفظ الدر قائلا % فلم يخل بحر زاخر قط من در % 18(@)(@@) % إذا جلب الأقلام نحو يمينه % % فقد جلبت من شط بحر إلى بحر % % 19(@)(@@) % تذكر أعواد المنابر جده % % وآباءه والأمر يذكر 
ms44	 بالأمر % % 20(@)(@@) % فلو أن أعواد المنابر أنصفت % % لما نصبت يوما لغير بني الطهر % % PageV01P132 21(@)(@@) % تبين في الطفل النجابة منهم % % كما يستبين العتق والسبق في المهر % % 22(@)(@@) % رأيت العلى تحتاج أصلا وبينة % % وهل يطبع الدينار إلا من التبر % % 23(@)(@@) % ونيط به أمر المظالم إنما % % ينوط أخو الحزم الحمائل للصدر % % 24(@)(@@) % فأضحى ظلام الليل نورا بعدله % % وهل لظلام الليل نفع مع الفجر % % 25(@)(@@) % وزين أقطار البلاد بحكمه % % وأحكامه في الأرض كالظلم في الثغر % % 26(@)(@@) % وإني وإذكاريك أمري كقائل % % لهذي النجوم وهي تسري ألا فاسري % % 27(@)(@@) % رعاك الذي استرعاك أمر عباده % % وحياك من أحياك للنفع والضر % 28(@)(@@) % له قلم يفري رقاب عداته % % وهل مخلب في أصبع الليث لا يفري % % 29(@)(@@) % إذا شحب القرطاس من وقعه به % % تجلبت وجوه الخطب والخطب الغر % 30(@)(@@) % تجمع أقسام العلى في كتابه % % فكان العلى في الكل والشطر في الشطر % % PageV01P133 31(@)(@@) % ألائمه في الجود دعه فإنه % على كل حال يعدل البخل بالكفر % % 32(@)(@@) % أمنتجع الغيث انتجع بحر كفه % % فما الغيث إلا في أنامله العشر % % 33(@)(@@) % وما المجد إلا روضة هو زهرها % % وليس يروق الروض إلا مع الزهر % % 34(@)(@@) % عجبت لهذا الدست كيف جفافه % % وقد ضم بحرا منك ليس بذيجزر % % 35(@)(@@) % وقالوا لنا في الدهر بخل وماسخا % % بمثلك إلا أهل ذا الزمن الحر % 36(@)(@@) % ينم عليك الفضل في كل موطن % % حللت كما نم النسيم على العطر % % 37(@)(@@) % فداؤك حي مثل ميت لبخله % % يظن اقتناء المال خيرا من الذكر % % 38(@)(@@) % يموت لئيم القوم من قبل موته % % ويقبر من قبل الدخول إلى القبر % % 39(@)(@@) % فعش عمر مدحي فيك إن مدائحي % % من الخالدات الباقيات إلى الحشر % % PageV01P134 البحر : - 1(@)(@@) % تعاتب سعدى إن تنقل دارها % % وأية شمس يستقل نهارها % % 2(@)(@@) % أعارتك سقم الجفن والجفن ضامن % محاسن أخرى جمة ما يعارها % % 3(@)(@@) % بمقلتها يقضي غرار من الكرى % % وما تقطع الأسياف لولا غرارها % % 4(@)(@@) % إذا نزلت أرضا أضاءت بوجهها % % فسيان منها ليلها ونهارها % % 5(@)(@@) % كواكب لكن الحدوج بروجها % % بدور ولكن الخدور سرارها % % 6(@)(@@) % تألق من تحت اللثام 
ms45	 كأنما % % يلاث على شمس النهار خمارها % % 7(@)(@@) % جرحت بلحظي خدها فتعمدت % % فؤادي فأصمته وذاك انتصارها % % 8(@)(@@) % فدعها وقتلي إنها من قبيلة % % إذا وترت لم يمطل الدهر ثارها % % 9(@)(@@) % بكيت فحنت ناقتي فأجابها % % صهيل جوادي حين لاحت ديارها % % 10(@)(@@) % خططنا بأطراف الأسنة أرضها % % فأهدت إلينا مسك دارين دارها % % PageV01P135 11(@)(@@) % ولاحت ثنايا الأقحوان ولو رأت % % محاسنها من أهواه طال استتارها % % 12(@)(@@) % وإني وإن عاصيت في بيشة الهوى % % ليعجبني غزلانها وصوارها % % 13(@)(@@) % أرى الحب نارا في القلوب وإنما % % تصعد أنفاس المحب شرارها % % 14(@)(@@) % توق عيون الغانيات فإنها % % سيوف وأشفار الجفون شفارها % % 15(@)(@@) % وهل للمنى إلا أبو الفضل كعبة % يكون إليه حجها واعتمارها % % 16(@)(@@) % تخيرته إن الكرام مناهل % وما تستوي غدرانها وبحارها % % 17(@)(@@) % فقبلت إذ عاينته خف ناقة % حباني به تهجيرها وابتكارها % % 18(@)(@@) % تعرق ظهرها فكأنما % % تضمن منه ذا الفقار فقارها % % 19(@)(@@) % وزناه بالدنيا فزاد وإنما % % يبين أقدار الرجال اختبارها % % 20(@)(@@) % وما يعرف الإنسان إلا بغيره % % وما فضلت يمناك لولا يسارها % % PageV01P136 21(@)(@@) % له ماء وجه مخبر عن مضائه % % ورونق ماء الماضيات شعارها % % 22(@)(@@) % يخاف عداه سيفه ولسانه % وترهب أنياب الليوث وزارها % % 23(@)(@@) % صلات يديه كالصلاة فتركها % % ذنوب لديه ما يرجى اغتفارها % % 24(@)(@@) % إذا غرست أسيافه في مغرس % % من الحرب أمست والرؤوس نثارها % % 25(@)(@@) % حكى دغفلا في بأسه ونواله % % كما تتبع الخيل الجياد مهارها % % 26(@)(@@) % إذا عدلت عنه العلى نحو غيره % % وحاشاه ألجاها إليه اضطرارها % % 27(@)(@@) % تحوز المنايا والمنى منه انمل % طوال القنا تزهى به وقصارها % % 28(@)(@@) % ولم أر أسدا غير آل مفرج % ترجى عطاياها ويؤمن زارها % % 29(@)(@@) % إذا أبرمت أمرا فللجود أمرها % % وإن هي لم تبرم ففيه اشتوارها % % 30(@)(@@) % جبال حلوم أثقل الحلم سمعها % % عن اللغو حتى قيل وقر وقارها % % PageV01P137 31(@)(@@) % ومن شأنها إسرافها في عطائها % % فإن قيل ذا عار فذلك عارها % % 32(@)(@@) % وأحمد في مدحيك والمدح حلية % صياغتها مني ومنك نضارها % % PageV01P138 البحر : - 1(@)(@@) % أتلك حدوج أم نجوم سوائر % وتلك غوان بينها أم جآذر % % 2(@)(@@) % بدور دهاهن الفراق فجأة % وقد يفجأ الإنسان مالا يحاذر 
ms46	 % % 3(@)(@@) % تهيم ببدر والتنقل والنوى % % على البدر محتوم فهل أنت صابر % % 4(@)(@@) % له من سنا الفجر المورد غرة % ومن حلك الليل البهيم غدائر % % 5(@)(@@) % ألم تر خيلي والنجوم كأنها % % على غسق الليل النجوم الحوائر % 6(@)(@@) % فثرن إليه مثل ما ثار للهدى % % ودولته داع إليه وناصر % % 7(@)(@@) % ينال من الأعداء خوف أبي الندى % % وهيبته ما لاتنال العشائر % % 8(@)(@@) % إذا ما تبدى للملوك تناثرت % % على بسطه تيجانها والمغافر % % 9(@)(@@) % تخر له الأملاك إن بصروابه % % سجودا ولو أن القنا متشاجر % % 10(@)(@@) % وتلثم بعد الأرض منه أناملا % إذا التطمت قيل البحار الزواخر % % PageV01P139 11(@)(@@) % بنان يها ألقى مراسيه الندى % % مقيما كما ألقى عصاه المسافر % % 12(@)(@@) % هو الملك البحر الذي قيل في الورى % % فإن لم أجاوره فمن ذا أجاور % % 13(@)(@@) % فألقيت رحلي منه عند موفق % % يجود بما يحوي وما هو ذاخر % % 14(@)(@@) % بعيد المدى داني الندى واكف الجدا % % له كرم ثاو وذكر مسافر % % 15(@)(@@) % أصاب العلى في أول الأمر إنما % % تصيب بأولاها الرماح الشواجر % % 16(@)(@@) % هو الطاعن النجلاء لا يبلغ امرؤ % مداها ولو أن الرماح مسابر % % 17(@)(@@) % تراه كأن الرمح سلك بكفه % % غداة الوغى والدارعون جواهر % % 18(@)(@@) % يرد أنابيب الرماح سواعدا % ومن زرد الماذي فيها أساور % % 19(@)(@@) % لها بين أوداج الكماة موارد % وبين صدور المارقين مصادر % 20(@)(@@) % تعمد حبات القلوب كأنما % % خواطرها عند القلوب خواطر % % PageV01P140 21(@)(@@) % يلبيه من آل المفرج إن دعا % % أسود لها بيض السيوف أظافر % % 22(@)(@@) % رأيتهم عقدا ولكن أبو الندى % % بمنزلة الوسطى وكل جواهر % % 23(@)(@@) % حكوا شمس دين الله بأسا كما حكى % % أسود الشرى أشبالهن الخوادر % % 24(@)(@@) % تراه لقرع البيض بالبيض مصغيا % كأن صليل الباترات مزاهر % 25(@)(@@) % توسط طيا نسبة ومكارما % كما وسطت حسن الوجوه النواظر % % 26(@)(@@) % وحفت به الأرجاء من كل جانب % % كما حف أرجاء العيون المحاجر % 27(@)(@@) % فما مات طائي وحسان خالد % ولا غاب منهم غائب وهو حاضر % % 28(@)(@@) % وكان لهم من جود كفيه أول % فصار لهم من جود كفيك آخر % % 29(@)(@@) % ولو راء ما يبنيه حاتم طيها % % لقال كذا تبنى 
ms47	 العلى والمآثر % % 30(@)(@@) % بسيفك نالت طيئ ما لو أنها % % تمنته لم تبلغ إليه الضمائر % % PageV01P141 31(@)(@@) % وعلمهاقتل الملوك وأسرها % % فتى منك في صيد الفوارس ماهر % % 32(@)(@@) % فقد تشكر الأيام أنك زنتها % % وما كل مفعول به الخير شاكر % % 33(@)(@@) % وما زلت ذخرا للإمام وعدة % لكل إمام عدة وذخائر % % 34(@)(@@) % فلما جرى ما كان أفقر قلبه % % لأنك نفاع إذا شئت ضائر % % 35(@)(@@) % تولي إماما ثم تعزل مثله % % فإن تدع مأمورا فإنك آمر % % 36(@)(@@) % يشرف أبناء الملوك إذا بدت % % لها فيك يوما ذمة وأواصر % 37(@)(@@) % ويقهر منهم من ينازع ملكه % % وأولى الورى بالملك من هو قاهر % % 38(@)(@@) % وينصرك السيف اليماني عليهم % لأن اليماني لليماني مضافر % 39(@)(@@) % لذلك يمشي في يديك كليلها % % وتنبو بكفي من سواك البواتر % % 40(@)(@@) % أحاط بك التوفيق من كل وجهة % وجاءتك من كل البلاد البشائر % % PageV01P142 41(@)(@@) % ويلقي إليك الأمر كل خليفة % فقدم وأخر فعل من لا يشاور % % 42(@)(@@) % إذا كرهت أعداؤك اسمك وانثنت % % له هربا حنت إليك المنابر % % 43(@)(@@) % وما أنا إلا روضة إن مطرتها % % تحول هذا المدح أزهر زاهر % % 44(@)(@@) % فإن جادني من جود نعماك رائح % فقد صادني من صوب يمناك باكر % % 45(@)(@@) % وإني لأرجو أن أنال من الغنى % % بشعري مالم يحوه قط شاعر % % 46(@)(@@) % إذا ما سترت المدح أثناء منطقي % % فللجود مني حين يطويه ناشر % % 47(@)(@@) % فعش عمر مدحي فيك إن مدائحي % % مخلدة ما دام في الأرض غابر % % 48(@)(@@) % طلبت العلى بالجد والجد بين % وحظك من كل الفريقين وافر % % 49(@)(@@) % كأنك مغناطيس كل فضيلة % % فلا فضل إلا وهو نحوك سائر % % PageV01P143 البحر : - 1(@)(@@) % ظفر الأسى بمتيم لم يظفر % قصر المنام وليله لم يقصر % % 2(@)(@@) % ومن الصبابة أن هاتيك الدمى % % أدمت محاجره لسفح محجر % % 3(@)(@@) % أعرضن عن متعرض ومللن من % % متململ وضحكن من مستعبر % % 4(@)(@@) % يحيا حياة تصبر فإذا أتت % % علق الصبابة مات موت تذكر % % 5(@)(@@) % شوق نأى جلدي به وتجلدي % % وهوى هوى صبري له وتصبري % % 6(@)(@@) % كادت تجد الوجد لولا فتية % % من منذر أو عصبة من مبصر % % 7(@)(@@) % مقسومة بالجنس 
ms48	 بين مخفف % ومثقل ومؤنث ومذكر % % 8(@)(@@) % تعطيك بالألفاظ غلظة ضيغم % % وتريك باللحاظ رقة جؤذر % % 9(@)(@@) % يا جائرا والدهر أجور حاكم % والحادثات بمنجد أو مغور % % 10(@)(@@) % ما ضاف بي هم به فقريته % إلا مدالجه المطي الضمر % % PageV01P144 11(@)(@@) % والصبح قد أخذت أنامل كفه % % في كل جيب للظلام مزرر % % 12(@)(@@) % فكأنما في الغرب راكب أدهم % يحتثه في الشرق راكب أشقر % % 13(@)(@@) % يسري لأبعد سؤدد من مشيه % % ويروم أقرب مورد من مصدر % % 14(@)(@@) % لعزيز دولة آل أحمد في الوغى % % والسلم بدر سريرها والمنبر % % 15(@)(@@) % شرف يريك مهلهلا في تغلب % يوم الكلاب وتبعا في حمير % % 16(@)(@@) % كم للعفاة إليه من سبابة % تومي وكم يثنى له من خنصر % % 17(@)(@@) % وكأنما يرمي العدى من بأسه % % بأسود خفان وجنة عبقر % 18(@)(@@) % في حيث ينفذ عاملا في جوشن % طعنا ويبذل صارما في مغفر % % 19(@)(@@) % محمر أطراف السيوف كأنما % % يطبعن من ورد الخدود الأحمر % % 20(@)(@@) % أنسيتني ذلي بعز صنائع % علمتنيه خبرة المتخبر % % PageV01P145 21(@)(@@) % فعلام أطلب من سواك مزيدة % وقد استزدنا منك معدن جوهر % % 22(@)(@@) % بيمينك الطولى علي وطولها % % قصرت عن تعريض كل مقصر % % 23(@)(@@) % فاسلم فكم قربت من متباعد % صعب وكم يسرت من متعسر % % 24(@)(@@) % وكما تقدمتالأنام فضائلا % فإذا هم وردوا الردى فتأخر % % PageV01P146 البحر : - 1(@)(@@) % أوقد البين في الخميس خميسا % % للأسى والفؤاد فيه وطيسا % % 2(@)(@@) % لا ذكرت الخميس إذ فجأنني % % كن فيه ولست أنسى الخميسا % % 3(@)(@@) % إذ تولت جموعهم عن محل % حل صبري وهاج وجدا رسيسا % % 4(@)(@@) % مربع بان أهله ثم أضحى % % مقفرا موحشا وكان أنيسا % % 5(@)(@@) % ثور الحزن عيس وجد مقيم % % بفؤادي لما أثاروا العيسا % % 6(@)(@@) % ونظرت الدموع إذ قطر العيس % % وحملت قطر دمعي نفوسا % % 7(@)(@@) % عدن مثل الشقيق في اللون لما % % عاد قلبي لصبغة الهم حيسا % % 8(@)(@@) % وذر الدهر يتبع اليسر عسرا % والهوى بالنوى ونعماه بؤسا % % 9(@)(@@) % يضحك اليوم ذا وفي الغد يبك % % يه فكلا ترى ضحوكا عبوسا % % 10(@)(@@) % وإذا أعقب النحوس سعودا % للفتى أتبع السعود نحوسا % % PageV01P147 11(@)(@@) % وهي تعطي الخسيس حظا نفيسا % ثم تعطي النفيس حظا خسيسا 
ms49	 % % 12(@)(@@) % فترى الفاضل الأديب أخا الفهم % % على عظم قدره منحوسا % % 13(@)(@@) % دهرنا والد ونحن بنوه % % فأت في حبه لنا التنفيسا % % 14(@)(@@) % قسم الحظ في بنيه بجور % % فبذا أصبح المروس رئيسا % % 15(@)(@@) % جعل العلم والفطانة فينا % % والنهي والحجى الجليل النفيسا % % 16(@)(@@) % ظاهر القسم فيه جور وفي البا % % طن عدل بجانب التاليسا % % 17(@)(@@) % فاستعن في الأمور بالله واصبر % % إن ذا الفضل لا يكون بؤوسا % % 18(@)(@@) % ولقد قلت للزمان مقالا % حين أكدى وعاد جدبا بئيسا % % 19(@)(@@) % أيهذا الزمان إن كنت صخرا % فبكلتا يدي آية موسى % % 20(@)(@@) % ولئن كنت ناكلا بكريم % % فمعي من حذاقة طب عيسى % % PageV01P148 21(@)(@@) % إن لي يا أبا الحسين فؤادا % فارغا من هوى الورى منكوسا % % 22(@)(@@) % وهو ملآن منك ودا مصفى % % قد نفى المذق عنه والتدليسا % % 23(@)(@@) % أنت في المجد والمعالي يتيم % قد غدا مجدها عليك حبيسا % % 24(@)(@@) % من يناويكم وأنتم أناس % لم تزالوا على النجوم جلوسا % % 25(@)(@@) % وإذا ناقص أرادك بالنقص % % ثنى المجد رأيه منكوسا % % 26(@)(@@) % صغر الناس في زمانك وازددت % % علاء وسؤددا قدموسا % % 27(@)(@@) % وأتاك المديح يختال مهرا % % ولقد رمته فكان شموسا % % 28(@)(@@) % هذه مدحة بوصفك تعلو % % كل مدح فقد غدا مطموسا % % 29(@)(@@) % هاكها كالعروس في الزي تجلى % % من جمال بها تفوق العروسا % % 30(@)(@@) % لفظها يترك الطروس رياضا % وسوى لفظها يشين الطروسا % % PageV01P149 31(@)(@@) % فتخال البيوت منها بروجا % والمعاني أهلة وشموسا % % PageV01P150 البحر : - 1(@)(@@) % أبان لنا من دره يوم ودعا % % عقودا وألفاظا وثغرا وأدمعا % % 2(@)(@@) % وأبدى لنا من دله وجبينه % % ومنطقه ملهى ومرأىومسمعا % % 3(@)(@@) % فقلت أوجه لاح من تحت برقع % % أم البدر بالغيم الرقيق تبرقعا % % 4(@)(@@) % أصم منادي بينهم حين أسمعا % % وروع قلبا بالفراق مروعا % % 5(@)(@@) % رعى الله قلبا بالحجاز عهدته % وإن كنت لا ألقاه إلا مودعا % % 6(@)(@@) % أحب النوى لا عن قلى غير أنني % % أرى أم عمرو والنوى أبدا معا % % 7(@)(@@) % يوفي هواها حقه فتصونه % % وليس يطيب الحب إلا ممنعا % % 8(@)(@@) % وفيها وفي أترابها لي منظر % هو العيش لو صادفت في الروض مربعا % % 9(@)(@@) % تحجبن ما يطلعن إلا لنية % بنفسي 
ms50	 شموس تجعل الغرب مطلعا % % 10(@)(@@) % ولما أتين الروض ينشرن بزه % % تضوعن مسكا خالصا وتضوعا % % PageV01P151 11(@)(@@) % وقدت كمام الزهر عنه فخلته % عيونا وخلت الطل منهن ادمعا % % 12(@)(@@) % وما أبدع الشمل المشتت بيننا % % ولو جمع الشمل الشتيت لأبدعا % % 13(@)(@@) % سأقلع غرس الحب قبل عتوه % % فأعجله من قبل أن يتفرعا % % 14(@)(@@) % وأورد آمالي الصوادي من يدي % % أبي غانم بحرا من الجود مترعا % % 15(@)(@@) % سحاب إذا استسقيت جاد إجابة % وإنلم ترد سقياه جاد تبرعا % % 16(@)(@@) % وبحر إذا ما غصت لقاك دره % % وإن لم تغص ألقى لك الدر مسرعا % % 17(@)(@@) % ندى الوجه من فرط الصرامة كلما % % جرى الماء في صمصامه كان أقطعا % % 18(@)(@@) % ولولا العطايا أنها سنة له % لما قال للدنيا إذا عثرت لعا % % 19(@)(@@) % فإنيلبس الدنيا فللجود لا لها % % وإن يهجر الدنيا فعنها ترفعا % % 20(@)(@@) % يقطع آناء النهار على الطوى % % صياما وآناء الظلام تضرعا % % PageV01P152 21(@)(@@) % يراقب إحياء المسا لوروده % % إذا راقب المرء المساء ليهجعا % % 22(@)(@@) % إذا كان حفظ الدين ما أنت صانع % % فلست ترى في الناس إلا مضيعا % % 23(@)(@@) % وكم قائل لي كيف مدحك هكذا % % فقلت صفوه إن للحلق مقنعا % % 24(@)(@@) % إذا ما مدحت ابن الحسين بوصفه % % البعض منه جئت بالمدح أجمعا % % 25(@)(@@) % ولو أن إنسانا لعظم محله % % ترفع عن قدر الثناء ترفعا % % 26(@)(@@) % فتى ماله للوافدين وإنما % % يضاف إليه في الكلام توسعا % % 27(@)(@@) % وليس يعد الجود جودا لأنه % % يرى ما أتاه واجبا لا تبرعا % % 28(@)(@@) % إذا شرعت أقلامه في كتابه % رأيت العوالي في الكتائب شرعا % % 29(@)(@@) % وإن صدعت أطرافهن بمدية % رأيت لها شمل الحديد مصدعا % % 30(@)(@@) % تخر غداة الروع في الطرس سجدا % لبيض كبيض الهند في الهام ركعا % % PageV01P153 31(@)(@@) % تظل سيوفالهند عند صريرها % % تتبعها فيماأراد تتبعا % % 32(@)(@@) % ولو مس أنبوب اليراع رأيته % تلبي أنابيب الرماح إذا دعا % % 33(@)(@@) % وما أحد في كتبة أو كتيبة % % بأسجع منه في الكتاب وأشجعا % % 34(@)(@@) % فصيح إذا ما جال لم ير مغنما % من العيش إلا أن يقول ويسمعا % % 35(@)(@@) % سعى للعلى حتى إذا ما أصابها % % أتته العلى تسعى 
ms51	 إليه بما سعى % % 36(@)(@@) % وتحرز ما يغنى به فكأنما % % تخال الغنى مثل الغناء مرجعا % % 37(@)(@@) % فطرت على دين الندى فاكتسبته % فحزت المعالي فطرة لا تصنعا % % 38(@)(@@) % ورتبته فوق السماوات رتبة % فلم تبق في جود لغيرك مطمعا % % 39(@)(@@) % فهنئت ذا العيد الذي هو حاضر % وهنئت ألفا مثله متوقعا % % 40(@)(@@) % زمانك أعياد فهنئت كلها % % ولست أخص اليوم إلا لأجمعا % % PageV01P154 41(@)(@@) % كرهت جوار المال من كرم فما % % يرى مالك الخزان إلا مودعا % % 42(@)(@@) % تواضع من فرط الرجاحة انه % إذا وزن الشيء الرفيع ترفعا % % 43(@)(@@) % لقد ألبس الله البلاد وأهلها % % بشخصك تاجا بالمعالي مرصعا % % PageV01P155 البحر : - 1(@)(@@) % ألم خيالها بعد الهجوع % % فعادت إذ رأت سيفي ضجيعي % % 2(@)(@@) % وهاجت لي بزورتها زفيرا % يكاد يقيم معوج الضلوع % 3(@)(@@) % فباتت بين أعناق المطايا % % تردد في المجيء وفي الرجوع % % 4(@)(@@) % فقمت مناديا فإذا سهيل % من الخفقان كالقلب المروع % % 5(@)(@@) % كأن نجوم ليلك حين ألقى % % مراسيه مسامير الدروع % % 6(@)(@@) % وفي الحي الحجازيين سرب % كأن وجوههم زهر الربيع % % 7(@)(@@) % ينوب بوجهه عن كل شمس % تغيب من الغروب إلى الطلوع % % 8(@)(@@) % شفعت إليه في نومي فأعيا % % فجاء به المنام بلا شفيع % % 9(@)(@@) % ولا أنسى بروض الحزن رئما % يبث الوجد عن قلب وجيع % % 10(@)(@@) % وأحداق الحدائق ناظرات % % إلي بأعين الزهر البديع % % PageV01P156 11(@)(@@) % ترقرق لؤلؤ الأندء فيها % % كما امتلأت عيون من دموع % % 12(@)(@@) % ولست بواثق بجفون عيني % % وقد أظهرن ما أخفت ضلوعي % % 13(@)(@@) % ومن يستكتم الأجفان حبا % فقد ألقى هواه إلى مذيع % % 14(@)(@@) % سقى الله الحيا نجدا فإني % % لذو قلب إلى نجد نزوع % % 15(@)(@@) % سقاه وابل غدق ملث % له جود كجود أبي المنيع % % 16(@)(@@) % ولو يحكي أنامله سحاب % لكان الدهر منه في ربيع % % 17(@)(@@) % نزلت به فقابلني بوجه % أغر كغرة الفجر الصديع % % 18(@)(@@) % وماء من بشاشته زلال % % وروض من مكارمه مريع % % 19(@)(@@) % له يد محسن وحياء جان % وجود مبذر وعلى جموع % % 20(@)(@@) % ورأي مجرب وقتال غر % % وذمة حافظ وندى مصيع % % PageV01P157 21(@)(@@) % إذا ذكر النوال اهتز شوقا % إليه كهزة السيف الصنيع % % 22(@)(@@) % يحن إلى العطاء 
ms52	 حنين قيس % إلى ليلى لعرفان الربوع % % 23(@)(@@) % فلا تحمده في بذل العطايا % % فليس لغير ذاك بمستطيع % % 24(@)(@@) % فمقبض سيفه مجرى العطايا % % ومضرب سيفه مجرى النجيع % % 25(@)(@@) % منى ومنية كالصل يطوى % % على الترياق والسم النقيع % % 26(@)(@@) % ولو بارى بجود يديه بحرا % لآل البحر كالآل المروع % % 27(@)(@@) % إذا وازنته بالناس طرا % رأيت البعض يعدل بالجميع % % 28(@)(@@) % يناط الرأي منه بألمعي % % يرى الحدثان من قبل الوقوع % % 29(@)(@@) % بذي حلم أصم عن الدنايا % % وذي جود لسائله سميع % % 30(@)(@@) % مفيد متلف حلو ممر % على العلات ضرار نفوع % PageV01P158 31(@)(@@) % بصدر مثل ساحته رحيب % % وبذل مثل نائله سريع % % 32(@)(@@) % إذا لاحت بنوه لنا شهدنا % % لطيب الأصل من طيب الفروع % % 33(@)(@@) % نجوم سبعة عدد الثريا % % وموضعها من الحسب الرفيع % % 34(@)(@@) % فلا زالوا كأنجمها ائتلافا % من الحدثان في حصن منيع % % 35(@)(@@) % تراه وحوله منهم ليوث % إذا انهل القنا في كل روع % % 36(@)(@@) % حكوه شمائلا وعلى وجودا % وبأسا عند معترك الجموع % % 37(@)(@@) % يراهم مثل ما اطردت كعوب % وراء سنانها الماضي الرفيع % % 38(@)(@@) % يهز أبو المنيع بهم سيوفا % لتقويم المخالف والمضيع % % 39(@)(@@) % فدام لهم به وله سرور % بهم حتى الممات بلا فجيع % % PageV01P159 البحر : - 1(@)(@@) % أما الخيال فما يغب طروقا % % يدنو بوصلك شائقا ومشوقا % % 2(@)(@@) % وافى يحقق لي الوفاء ولم يزل % % خدن الصبابة بالوفاء خليقا % % 3(@)(@@) % ومضى وقد منع الجفون خفوقها % % قلب لذكرك لا يزال خفوقا % % 4(@)(@@) % هل عهدنا بلوى الشقيقة راجع % فيعود لي فيه الوصال شقيقا % % 5(@)(@@) % أيام تسلك بي الصبابة مجهلا % لا يعرف السلوان فيه طريقا % % 6(@)(@@) % أهوى أنيق الحسن مقتبل الصبا % % وأزور مخضر الشباب أنيقا % % 7(@)(@@) % لا ألحظ الأيام لحظة وامق % حتى يعود زماننا موموقا % % 8(@)(@@) % وركائب يخرجن من غلس الدجى % % مثل السهام مرقن فيه مروقا % % 9(@)(@@) % نحو الهمام القائد القرم الذي % % قرن الإله بعزمه التوفيقا % % 10(@)(@@) % ملك يروقك منظرا ومقالة % أبدا ويوسع بالصوارم ضيقا % % PageV01P160 11(@)(@@) % يلقي الندى برقيق وجه مسفر % وإذا التقى الجمعان عاد صفيقا % % 12(@)(@@) % رحب المجالس ما أقام فإن سرى % % في جحفل ترك الفضاء مضيقا % % 13 
ms53	(@)(@@) % وإذا طما بحر الكريهة خاضه % % وأمات من عاداه فيه غريقا % % 14(@)(@@) % حجبت به شمس النهار وأشرقت % % شمس الحديد بجانبيه شروقا % % 15(@)(@@) % أضحى أبوالفضل السميدع في الورى % % فردا وأصبح في الذرى مرموقا % % 16(@)(@@) % وحسامه أبدا بوار عداته % ونواله في العالمين محيقا % % 17(@)(@@) % الله صوره جوادا خلقة % % أعلى به نور الزمان أنيقا % % 18(@)(@@) % أضحى السخاء بجعفر متخيما % فغدا به عقد الزمان وثيقا % % 19(@)(@@) % يختال في حلل الرجاء ويمتطي % % همما أقامت للمكارم سوقا % % 20(@)(@@) % فلضاع أمر لا تبيت تديره % ولضل ركب ما انتحاك طريقا % % PageV01P161 21(@)(@@) % فهناك يوم العيد يوم عائد % % أبدا عليك موفقا توفيقا % % 22(@)(@@) % فاسلم لدهر أنت درة تاجه % % لا زلت ربا للفخار حقيقا % % 23(@)(@@) % واسلم لمكرمة شغلت بحبها % % قلبا بحب المكرمات علوقا % % 24(@)(@@) % وبديع شعر يانع حبرته % فنظمت منه لؤلؤا وعقيقا % % 25(@)(@@) % شعشعت منه اللفظ ثم نظمته % % فكأنما شعشعت منه رحيقا % % PageV01P162 البحر : - 1(@)(@@) % بعثت إليك بطيفها تعليلا % % وخضاب ليلك قد أراد نصولا % % 2(@)(@@) % فأتاك وهنا والظلام كأنه % نظم النجوم لرأسه إكليلا % % 3(@)(@@) % وإذا تأملت الكواكب خلتها % % زهرا تفتح أو عيونا حولا % % 4(@)(@@) % أهدت لنا من خدها ورضابها % % وردا تحيينا به وشمولا % % 5(@)(@@) % وردا إذا ما شم زاد غضاضة % ولو انه كالورد زاد ذبولا % % 6(@)(@@) % وجلت لنا بردا يشهي برده % نفس الحصور العابد التقبيلا % % 7(@)(@@) % بردا يذيب ولا يذوب وكلما % % شرب المتيم منه زاد غليلا % % 8(@)(@@) % لم أنسها تشكو الفراق بأدمع % ماعتدن في الخد الأسيل مسيلا % % 9(@)(@@) % فرأيت سيف اللحظ ليس بمغمد % من تحت أدمعها ولا مسلولا % % 10(@)(@@) % إن دام دمعك فاحذري غرقا به % % وإذا توالى القطر عاد سيولا % % PageV01P163 11(@)(@@) % حطي النقاب لعل سرب عيوننا % % في روض حسنك يرتعين قليلا % % 12(@)(@@) % لما انتقبت حسبت وجهك شعلة % خلل النقاب وخلته قنديلا % % 13(@)(@@) % هام الفؤاد بأنجم من حيث ما % % أبصرتهن رأيتهن أفولا % % 14(@)(@@) % رحلوا ولون الليل أدهم مصمت % % فامتار منهم غرة وجحولا % % 15(@)(@@) % ينحون حيث ترى الموارد طفحا % والروض غضا والنسيم عليلا % % 16(@)(@@) % فالأقحوانة ثم تلقى أختها % % كفم يحاول من فم تقبيلا % % 17(@)(@@) % كلف 
ms54	 الفراق بمن هويت فكلما % % دانيته شبرا تأخر ميلا % % 18(@)(@@) % قتلتني الأيام حين قتلتها % % علما فأبصر قاتلا مقتولا % % 19(@)(@@) % مالت علي وقد جعلت مطيتي % % ما بين أجفان الدياجي ميلا % % 20(@)(@@) % حملت جميلا من ثناء محمد % لتزور وجها كالثناء جميلا % % PageV01P164 21(@)(@@) % ملك يروقك منظرا ومقالة % كالسيف يحسن رؤية وصليلا % % 22(@)(@@) % أضحى السخاء مخيما في كفه % % حمد المحل فما يريد رحيلا % % 23(@)(@@) % أو هل يريد الجود بعد يمينه % % وهو النهاية في العلو سولا % % 24(@)(@@) % لا أستزيد الدهر بعد لقائه % % حسبي برؤيته البهية نزولا % % 25(@)(@@) % عم الرعية والرعاة نواله % والفاضل المأمول والمفضولا % % 26(@)(@@) % كالغيث إن جادت يداه بديمة % أغنى بها المعروف والمجهولا % % 27(@)(@@) % يرتد فكرك بالفضائل حاسرا % عنه وطرفك بالضياء كليلا % % 28(@)(@@) % وتحوز من إحسانه وعيانه % % وبيانه وبنانه المأمولا % % 29(@)(@@) % زاد العفاة على الديات ولم يكن % % أردى سوى فقر العفاة قتيلا % % 30(@)(@@) % ودعا لسائله وأعلن شكره % حتى حسبنا السائل المسؤولا % % PageV01P165 31(@)(@@) % أتراه يحسب وفده شركاءه % % ويرى التفرد بالثراء عليلا % % 32(@)(@@) % يا من يفنده على صلة الندى % % أنلوم في صلة الخليل خليلا % % 33(@)(@@) % اللهصوره جوادا خلقة % وتريد منه أن يكون بخيلا % % 34(@)(@@) % خلق ابن إبراهيم جودا كله % % فمتى تطيق لخلقه تبديلا % % 35(@)(@@) % لو ذقت من طعم الندى ما ذاقه % لعصيت فيه لائما وعذولا % % 36(@)(@@) % اهرب بنفسك لا يهبك فربما % % أعطى العذول الوفد والمعذولا % % 37(@)(@@) % ولربما فتشت بعض عطائه % فوجدت فيه السيد البهلولا % % 38(@)(@@) % قتل العداة بجوده وبسيفه % % والسيف أسهل عندهم تقتيلا % % 39(@)(@@) % فانصاع قد ملئت مضارب جوده % % شكرا ومضرب سيفه تفليلا % % 40(@)(@@) % يلقى العدى من كتبه بكتائب % يجرون من زرد الحروف ذيولا % % PageV01P166 41(@)(@@) % وترى الصحيفة حلبة وجيادها % % أقلامه وصريرهن صليلا % % 42(@)(@@) % في كفه قلم أتم من القنا % % طولا وهن أتم منه طولا % % 43(@)(@@) % قلم يقلم ظفر كل ملمة % ويرد حد شباتها مفلولا % % 44(@)(@@) % ويضيء منه الطرس ساعة يكتسي % % صدأ المداد ولا يضيء صقيلا % % 45(@)(@@) % ما قط قط لكتبه أقلامه % إلا نقمن على العداة ذحولا % % 46(@)(@@) % نبل حباها من رؤوس بنانه % ريشا ومن حلك المداد نصولا 
ms55	 % % 47(@)(@@) % ففرت شواكل كل أمر مشكل % % ورددن مفصل ماله مفصولا % % 48(@)(@@) % يدعو النبي من الجدود وحيدرا % ومن العمومة جعفرا وعقيلا % % 49(@)(@@) % نسب ترى عنوانه في وجهه % % لا شبهة فيه ولا تأويلا % % 50(@)(@@) % نغنى به عن حجة ودلالة % % من ذا يريد على النهار دليلا % % PageV01P167 51(@)(@@) % يحكي النبي شمائلا وفضائلا % من لم يكن كأبيه كان دخيلا % % 52(@)(@@) % لولا الرسالة بعد جدك أحمد % ختمت لقلنا قد بعثت رسولا % % 53(@)(@@) % أشبهته خلقا وأخلاقا وما % % خالفته جملا ولا تفصيلا % % 54(@)(@@) % لولا أبوك لما امتلا سمع امرئ % في الأرض تكبيرا ولا تهليلا % % 55(@)(@@) % ياابن الذين إذا اعتراهم طارق % تركوا بيوت المال منه طلولا % % 56(@)(@@) % الطيبين مناقبا ومآربا % ومراتبا ومناسبا وأصولا % % 57(@)(@@) % والمسرعين إلى المكارم كلما % % وجدوا إلى إتيانهن سبيلا % % 58(@)(@@) % إن حاربوا ملؤوا القلوب أسنة % أو كاتبوا ملؤواالطروس فصولا % % 59(@)(@@) % كم جبت أرضا مثل صدرك في الندى % % عرضا وأخرى مثل باعك طولا % % 60(@)(@@) % حتى وصلت إليك يابدر العلى % % بمطية مثل الهلال نحولا % % PageV01P168 61(@)(@@) % جعلت رجاءك حاديا من خلفها % % وضياء وجهك هاديا ودليلا % % 62(@)(@@) % إني جدير بالنجاح لأنني % % أملت للأمر الجليل جليلا % % 63(@)(@@) % لا زال فعلك بالمقال مرصعا % أبدا وعرضك بالعفاف صقيلا % % 64(@)(@@) % ما غردت ورق الحمائم في ذرى % % فنن الأراكة بكرة وأصيلا % % PageV01P169 البحر : - 1(@)(@@) % إيها أبا حسن حللت من العلى % % بين السنام وبين ذرو الكامل % % 2(@)(@@) % أنى سخا بك ذا الزمان وإنه % لمبخل بالكامل ابن الكامل % % 3(@)(@@) % يا أيها الأستاذ لا من غفلة % والله قد يدعى وليس بغافل % % 4(@)(@@) % قل للأمير وليس كل محرك % % للسانه عند الملوك بقائل % % 5(@)(@@) % أهدي ويهدي آخرون فنستوي % % ما الفرق بين فضولهم وفضائلي % % 6(@)(@@) % واعلم يقينا أن كل صنيعة % عندي تعد ذخيرة في الحاصل % % 7(@)(@@) % لو كنت بالبيداء لم يك بدعة % عطشي ولكني بجنب الساحل % % 8(@)(@@) % وهو الربيع وكيف يحيا موضع % لم يحيه سح الربيع الهاطل % % PageV01P170 البحر : - 1(@)(@@) % إعترافي بعظم فضلك فضل % وعدولي عن كنه وصفك عدل % % 2(@)(@@) % كلما رمت وصف قدرك أفي % % ت صفاتي تدنو وقدرك يعلو % % 3(@)(@@) % فوق طرف 
ms56	 من العلاء له الزه % % ر مسامير والأهلة نعل % % 4(@)(@@) % قد حلا الدهر من حلولك فيه % % ولقد يمزج الزعاف فيحلو % % 5(@)(@@) % فظلام الزمان نور وبؤس ال % % دهر نعمى وحره منك ظل % 6(@)(@@) % وإذا هزك الإمام لحرب % أو لسلم فأنت نصر ونصل % % 7(@)(@@) % تخمد الحرب حين تغمد بأسا % وتسيل الدماء حين تسل % 8(@)(@@) % ثابت الجأش طائش الجود دا % % ني العفو نائي المدى معز مذل % 9(@)(@@) % قوله حكمة وأفعاله عد % % ل وآراؤه السديدة فصل % 10(@)(@@) % هو بعض الأنام في رؤية العي % % ن وإن عد فاضل فهو كل % PageV01P171 11(@)(@@) % لا يشين النوال منه بمطل % % إن طوق العطاء بالمطل غل % 12(@)(@@) % يهزم الجيش بالكتاب كأن ال % % كتب منه كتائب ما تفل % 13(@)(@@) % وكأن السطور فيها صفوف % وكأن الحروف خيل ورجل % % 14(@)(@@) % كل فصل فيه من القطع والوص % % ل كهام العداة قطع ووصل % 15(@)(@@) % فيه محيا قوم ومهلك قوم % أسجال من القنا أم سجل % 16(@)(@@) % وإذا راش بالأنامل أنبو % % ب يراع فإنما هو نبل % % 17(@)(@@) % قلم دبر الأقاليم حتى % % ظل فيه داعي التناسخ يغلو % % 18(@)(@@) % قلم صدره سنان وآخرا % % ه حسام وبين ذلك صل % 19(@)(@@) % يا أبا غانم أرى الغانم السا % % لم من في يمينه منك حبل % 20(@)(@@) % مدحتك العلياء من قبل مدحي % % وهو مدح بنفسه مستقل % PageV01P172 21(@)(@@) % لا أهنيك إذ وليت لعلمي % % أن ما ازددت فيه عنك يقل % 22(@)(@@) % ولو أن الإمام ولاك أمر ال % % شرق والغرب كنت عنه تجل % 23(@)(@@) % قد تهيأت للرحيل إلى الأ % % هل فجد لي بما له أنت أهل % % 24(@)(@@) % أين ما كنت في البلاد بنفسي % % فثنائي يحل حيث تحل % 25(@)(@@) % قد تملكت بالمكارم حرا % وهو رق محرم ما يحل % 26(@)(@@) % لا أذم الزمان إذ كنت فيه % % ما لدهر سخا بمثلك بخل % PageV01P173 البحر : - 1(@)(@@) % هبوا أن سجني مانع لوصاله % % فما الخطب أيضا في امتناع خياله % 2(@)(@@) % نعم لم تنم عيني فيطرق طيفه % % زوال منامي علة لزواله % 3(@)(@@) % فدى الصب من لم ينسه في بلائه % % وينسى اسمه من كان في مثل حاله 
ms57	 % % 4(@)(@@) % ومن صار سجني قطعة من صدوده % % وطول التنائي قطعة من ملاله % % 5(@)(@@) % ولم تر عيني حاسدين تباينا % % عليه سوى قلبي وترب نعاله % % 6(@)(@@) % وإني لأطويه حذارا وإنما % % يخاف اغتيال الجرح عند اندماله % % 7(@)(@@) % ألا بأبي الغصن النضير وإنما % % كنيت به عن قده واعتداله % % 8(@)(@@) % ولا بأبي بدر المحاق وإنما % % يفدى إذا حاكاه عند كماله % % 9(@)(@@) % ولا حبذا نور الأقاحي عابسا % ويا حبذاه ضاحكا في ظلاله % 10(@)(@@) % فإن فاقه ثغر الحبيب فإنما % % أقر بما أعيا وجود مثاله % PageV01P174 11(@)(@@) % وما حسن هذا الشعر إلا لنفثة % له في فمي من قبل قطع وصاله % % 12(@)(@@) % نطقت بسحر بعدها غير أنه % من السحر ما لم يختلف في حلاله % % 13(@)(@@) % كذاك ابن سيرين بنفثة يوسف % % تكلم في الرؤيا بمثل مقاله % % 14(@)(@@) % ألا اصرف إلى صدغيه لحظك كله % ودع لحظه مستعملا من نصاله % % 15(@)(@@) % ترى فيهما نونين عطل واحد % % وآخر معجوم بنقطة خاله % 16(@)(@@) % وما الوقف إلا في الوزارة إنها % % عقيلته محفوفة باعتقاله % % 17(@)(@@) % أتستغرب العلياء أحمد ناشئا % وقد بان منه الفضل قبل فصاله % % 18(@)(@@) % صغيرا تربيه المعالي وفاضلا % تسود من إقباله في اقتباله % % 19(@)(@@) % أراني وقد أعيا على الفكر أمره % % على أن فكري غائض فياحتفاله % % 20(@)(@@) % إذا ما حوى أعلى المراتب ناشئا % فماذا الذي يبقي لحين اكتهاله % % PageV01P175 21(@)(@@) % نعم إن غايات الجواد إذا انتهى % % إليها تبقى فضلة في خلاله % % 22(@)(@@) % رأوا فضله فاستحسنوه وأمسكوا % % وقوفا على أقدارهم بخصاله % % 23(@)(@@) % فأبقوا له في الفضل كثرة شكرهم % % وأبقى لهم في الفخر قلة ماله % % 24(@)(@@) % وعقل كعذب الماء من يظم عقله % % لعقل سواه فهو عذب زلاله % % 25(@)(@@) % إلى أدب مثل الهواء أو الهوى % % مع الروح يجري جائلا في مجاله % % 26(@)(@@) % وذهن لو الكافور يمنع حره % % لأزرى بفخر المسك عند اعتماله % % 27(@)(@@) % وما كان ذا التشبيه إلا تحاملا % عليه ولكن فضله في احتماله % % 28(@)(@@) % ويا سيدي عبد دعاك معولا % عليك ولم يخطر سواك بباله % % 29(@)(@@) % وهل يستعين المرء من قعر هوة % لإخراجه إلا بأقوى حباله % % 30(@)(@@) % وأنتم أناس فضلهم 
ms58	 غامر الورى % % فما بال مثلي داثرا في انخماله % % PageV01P176 31(@)(@@) % أأبصرتموه شافعا بسواكم % وأنتم بعيد وهو في ضيق حاله % % 32(@)(@@) % وإذ صار سعد وابنه معقلا له % فما العذر من إطلاقه من عقاله % % PageV01P177 البحر : - 1(@)(@@) % أذهبت رونق ماء الصبح في العذل % % فاربع فلست بمعصوم من الزلل % % 2(@)(@@) % لكل سهم يعد الناس سابغة % % ترده عنك إلا أسهم المقل % % 3(@)(@@) % هام الفؤاد بشمس ما يزايلها % % غرب من البين أو غيم من الكلل % % 4(@)(@@) % ينتاب دمع النوى واللهف وجنتها % % فقلما انفك ظهر الخد من بلل % % 5(@)(@@) % لا شيء أكفر من مسواك إسحلة % % يعله الريق لم يورق ولم يطل % % 6(@)(@@) % يخفى شهاب الهوى في برد ريقتها % % كما استكن نقيع السم في العسل % % 7(@)(@@) % وفي أصول الثنايا بارد علل % نفسي الفداء لذاك البارد العلل % % 8(@)(@@) % إياك إياك تطريقا بأعينها % % فهي الأسنة في العسالة الذبل % % 9(@)(@@) % مابال طرفك لا تنجو رميته % كأنما هو رام من بني ثعل % % 10(@)(@@) % صدت بنجد وزارت في طرابلس % % وبيننا عنق للسفن والإبل % % PageV01P178 11(@)(@@) % في خرد نهد يعكسن أعيننا % % لضوئهن كعكس الشمس للمقل % % 12(@)(@@) % تنقاد نحو هواهن القلوب كما ان % % قادت إلى هبة الله العلى بن علي % % 13(@)(@@) % غدا عن السمر بالسمر الكعوب وعن % % بيض الوجوه ببيض الهند في شغل % % 14(@)(@@) % يزين الدولة الغراء موضعه % إذا تزينت الأملاك بالدول % % 15(@)(@@) % ينبي تبسمه عن بشره أبدا % والغيث أول صوب العارض الهطل % % 16(@)(@@) % يزينها فوق ما زانته فهو بها % % في حلة وهي من علياه في حلل % % 17(@)(@@) % يبش بالوفد حتى خلت وافده % % وافى يهنيه بالتأخير في الأجل % % 18(@)(@@) % علا فلا يستقر المال في يده % % وكيف تمسك ماء قنة الجبل % % 19(@)(@@) % يقضي بحكم الهدى في المشكلات كما % % يقضي بحكم الظبى في ساعة الوهل % % 20(@)(@@) % قد حالف الفضل في أحكامه أبدا % والعدل خير اقتناء الفارس البطل % % PageV01P179 21(@)(@@) % تخشى العدى أبدا صدر الجواد فقد % % ظن العدى أنه صدر بلا كفل % % 22(@)(@@) % في جحفل لجب لولا تبسطه % لخلته شبها من كثرة الأسل % % 23(@)(@@) % كأن حمر المذاكي الخمر تحتهم % وبيضهم حبب 
ms59	 يطفو على القلل % % 24(@)(@@) % أملت فيه الغنى من قبل رؤيته % % فالآن أكبرته عن ذلك الأمل % % 25(@)(@@) % أملت ذلك علما أنه رجل % فرد فأبصرت كل الناس في رجل % % 26(@)(@@) % يصغي إلى سائل جدوى يديه كما % % يصغي المحب إلى التغريد والغزل % % 27(@)(@@) % لو شاء قال ولم يكذب بمخبره % % عن كل فضل أراده أن ذلك لي % % 28(@)(@@) % لأنه اخترع العلياء مبتدئا % وسائر الناس من تال ومنتحل % % 29(@)(@@) % قد أحكم الحاكم المنصور دولته % بآل حيدرة في السهل والجبل % % 30(@)(@@) % ورفهت كتبه أقصى كتائبه % % عن الزيارة للأعداء والقفل % % PageV01P180 31(@)(@@) % ترضى الدراريع عنهم والدروع وأص % % داف القنا وصدور البيض والأسل % % 32(@)(@@) % تاهت بهم دولة الإسلام واعتدلت % % بعزمهم كاعتدال الشمس في الحمل % % 33(@)(@@) % شادوا وسادوا بما يبنون من كرم % % أساس مجدهم المستحكم الأزلي % % 34(@)(@@) % تشابهوا في اختلاف من زمانهم % % عند اللهى والنهى والقول والعمل % % 35(@)(@@) % كالرمح أوله عون لآخره % % وآخر الرمح عون الأكعب الأول % % 36(@)(@@) % تبعت في الجود والعليا أباك ولم % % تكذب كما تبع الوسمي صوب ولي % % 37(@)(@@) % غيثان أنهما جادت أنامله % % في بلدة نبتت بالمال والخول % % 38(@)(@@) % حليتما الدين والدنيا بعزكما % % فلا أذلهما الرحمن بالعطل % % 39(@)(@@) % ولا رأينا بعيني دهرنا رمدا % فأنتما في مآقيه من الكحل % % 40(@)(@@) % وعشتما أبدا في ظل مملكة % % قد استعاذت من التغيير والدول % % PageV01P181 41(@)(@@) % مارقرق المزن فوق الأرض أدمعه % وحن ذو شجن يوما لمرتحل % % PageV01P182 البحر : - 1(@)(@@) % محل العلى أنى حللت محلها % % وفيك وإن حاز الورى البعض كلها % % 2(@)(@@) % ومذ كنت يا بكار تسمو بهمة % كثيرا إذا ماتت وفي الناس قلها % % 3(@)(@@) % لقد يممت عليا تميم وطال في % % سماء العلى من فخر فرعك أصلها % % 4(@)(@@) % وكانت سجايا الفضل بكرا فعندما % % ولدت قضى الرحمن أنك بعلها % % 5(@)(@@) % فليس يرى في الفضل مثلك ماجد % وليس يرى في غير مثلك مثلها % % 6(@)(@@) % ففضلك مشكور ولو لم يكن بها % % يمت إذا لم يسر في الناس فضلها % % 7(@)(@@) % متى ظمئت منا قرائح فهمنا % % فأنت بري من نهال تعلها % % 8(@)(@@) % وإن عقدت يوما مسائل حكمة % فأنت بلا إعمال فكر 
ms60	 تحلها % % 9(@)(@@) % تصحح أنى شئت منها سقيمها % % وتأتي إلى ما صح منها تعلها % % 10(@)(@@) % سواء إذا مارمت إيضاح علمها % % دقيق معانيها عليك وجلها % % PageV01P183 11(@)(@@) % ضمان عليها إن قدرك يرتقي % % بهافي معال لا يرام أقلها % % 12(@)(@@) % برعت على أبناء سنك رفعة % فأنت فتاها في الفخار وكهلها % % 13(@)(@@) % أبا قاسم إن تستجد وصف مدحتي % % فمنك معانيها وأنت محلها % % 14(@)(@@) % فلا فضل لي بل فضلها منك كله % % ولكن كساني حلة الفخر أهلها % % PageV01P184 البحر : - 1(@)(@@) % ألم بمضجعي بعد الكلال % % خيال من هلال بني هلال % % 2(@)(@@) % بمنطمس الصوى لو حار طيف % لحار بجوه طيف الخيال % % 3(@)(@@) % فأحيا ذكر وجد وهو ميت % وجدد رسم شوق وهو بال % % 4(@)(@@) % فتاة ما تنال وكل شيء % نفيس القدر ممتنع المنال % % 5(@)(@@) % وما تندى لسائلها بوصل % وقد يندى البخيل على السؤال % % 6(@)(@@) % ويحجب بينها أبدا وبيني % % ظلام الند أو غيم الحجال % % 7(@)(@@) % بمقلتها لعمر أبيك سحر % به تصطاد أفئدة الرجال % % 8(@)(@@) % سمعنا بالعجاب وما سمعنا % % بأن الليث من قنص الغزال % % 9(@)(@@) % لقد بذل الفراق لنا رخيصا % لقاء العامرية وهو غال % % 10(@)(@@) % وأبدى من محياها نهارا % يجاور من ذوائبها ليالي % % PageV01P185 11(@)(@@) % أحن إلى الفراق لكي أراها % % وإن كان الفراق علي لا لي % % 12(@)(@@) % أشارت بالوداع وقد تلاقت % % عقود الثغر والدمع المسال % % 13(@)(@@) % وأبكاني الفراق لها فقالت % % بكاء متيم ورحيل قال % % 14(@)(@@) % فقلت لها أودع منك شمسا % إلى شمس الهدى شمس المعالي % % 15(@)(@@) % فتى عم الملوك فمن سواهم % % نوالا منه منسكب العزالي % % 16(@)(@@) % كذاك الغيث إن أرسى بأرض % تجلل كل منخفض وعال % % 17(@)(@@) % ترى في سرجه ليثا وغيثا % وعند الغيث صاعقة تلالي % % 18(@)(@@) % مليء بالعطايا والرزايا % % وبالنعم السوابغ والنكال % % 19(@)(@@) % تبوا الجود يمناه محلا % فليس يهم عنها بارتحال % % 20(@)(@@) % كأن الجود بعض الكف منه % % فما للبعض عنها من زوال % % PageV01P186 21(@)(@@) % يصافح منه كفا من عطايا % % تحف بها بنان من نوال % % 22(@)(@@) % ولم أر قبله أسدا تلبي % % إلى الهيجاء إن دعيت نزال % % 23(@)(@@) % أظافره من البيض المواضي % % ولبدته من الزرد المذال % % 24(@)(@@) % تراه 