ms21	 % 3(@)(@@) % حجبوك إلا من توهم خاطري % % وحموك إلامن تبوء بالي % % 4(@)(@@) % والقارظان جميل صبري والكرى % % فمتى أرجي منك طيف خيال ؟ % PageV01P087 البحر : بسيط تام 1(@)(@@) % تكاد تغنى إذا شاهدت معتركا % عن أن يسل حسام أو يسال دم % 2(@)(@@) % بلحظة منك يثنى القرن منعفرا % كأن لحظك فيه صارم خذم % 3(@)(@@) % أقدمت حيث الكماة الشوس محجمة % % وجدت حيث المنايا السود تزدحم % 4(@)(@@) % وما حتدى الموت نفسا من نفوسهم % إلا وسيفك كعب الجود أو هرم % 5(@)(@@) % وهامهم في الجذوع الشم ضاحية % كأنها بقع الغربان والرخم % 6(@)(@@) % مواثلا في سبيل الركب تحسبها % % تسأل الركب عن أجسادها القمم % 7(@)(@@) % وقد تلم بها الغربان واقعة % كأنها فوق محلوقاتها لمم % 8(@)(@@) % صوامت نطق الهيئات قائلة % عقبى عصاة بن معن هذه النقم % PageV01P088 البحر : طويل 1(@)(@@) % مساعيك في نحر العدو سهام % ورأيك في هام الضلال حسام % 2(@)(@@) % ولمحك يردي القرن وهو مدجج % وذكرك يثني الجيش وهو لهام % 3(@)(@@) % كأنك لا ترضى البسيطة منزلا % إذا لم يطنبه عليك قتام % 4(@)(@@) % كأنك خلت الشمس خودا فلم يزل % % يقنعها بالنقع منك لثام % 5(@)(@@) % وقد يحسبون السلم منك سلامة % % ورب منام دب فيه حمام % PageV01P089 البحر : خفيف تام 1(@)(@@) % حيثما كنت ظاعنا أو مقيما % % دم رفيعا وعش منيعا سليما % % PageV01P090 البحر : طويل 1(@)(@@) % وبين المسيحيات لي سامرية % بعيد على الصب الحنيفي أن تدنو % % 2(@)(@@) % مثلثة وقد وحد الله حسنها % % فثنى في قلبي بها الوجد والحزن % 3(@)(@@) % وطي الخمار الجون حسن كأنما % % تجمع فيه البدر والليل والدجن % 4(@)(@@) % وفي معقد الزنار عقد صبابتي % % فمن تحته دعص ومن فوقه غصن % % 5(@)(@@) % وفي ذلك الوادي رشا أضلعي له % % كناس وقمري فؤادي له وكن % PageV01P091 البحر : متقارب تام 1(@)(@@) % وما الناس إلا فعالهم % % فدع ما تزخرفه الألسن % 2(@)(@@) % سجية أصل الفتى فعله % بما عنده يقذف المعدن % PageV01P092 البحر : كامل تام 1(@)(@@) % واصل أخاك وإن أتاك بمنكر % فخلوص شيء قلما يتمكن % 2(@)(@@) % ولكل شيء آفة موجودة % إن السراج على سناه يدخن % PageV01P093 البحر : طويل 1(@)(@@) % دوين الكثيب الفرد قضب وكثبان % عليها لورق الوجد سجع 
ms22	 وإرنان % 2(@)(@@) % وفي ظلل الأفنان خوط على نقا % منيع الجنى لدن التأود فينان % 3(@)(@@) % وفي مكنس الرقم أحور % كأن مصاليت الظبى منه أجفان % 4(@)(@@) % وبين دراري القلائد نير % % له الحسن تم والتلثم نقصان % 5(@)(@@) % على صدغه الشعرى تلوح وتلتظي % % وفي نحره الجوزاء تزهى وتزدان % 6(@)(@@) % وما بال طرفي لا يوافيك شاكيا % وطرفك في كل الأحايين وسنان ؟ % 7(@)(@@) % وفي ثغرك الوضاح ري لبانتي % % فظلمك صدآء وقلبي صديان % 8(@)(@@) % تسح بأهواء الورى منه راحة % شآبيبها فيها لجين وعقيان % 9(@)(@@) % وما كيمينيه الفرات ودجلة % وإن حكموا أن المرية بغدان % 10(@)(@@) % به عتدلت أزمانها وهواؤها % % فكانون أيلول وتموز نيسان % PageV01P094 البحر : كامل تام 1(@)(@@) % حاشا لعدلك يابن معن أن يرى % % في سلك غيري دري المكنون % 2(@)(@@) % وإليكها تشكو أستلاب مطيها % % عج بالحمى حيث الخماص العين % 3(@)(@@) % قأحكم لها واقطع لسانا لا يدا % فلسان من سرق القريض يمين % PageV01P095 
