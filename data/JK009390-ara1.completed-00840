ms821	 وكان الرجل فيهم يرى أخاه يقع على الذنب فينهاه عنه فإذا كان الغد لم يمنعه ما رأى منه أن يكون أكيله وشريبه وخليطه ، فضرب الله قلوب بعضهم ببعض ونزل فيهم القرآن لعن الذين كفروا من بني إسرائيل : الآيات ؛ إلا أن تأخذوا على يد الظالم فتأطروه على الحق أطرا ) )(@)(@@) ( ت ه ) عن ابن مسعود ( ت ه ) عن أبي عبيدة مرسلا .(@)(@@)(@@)(@@) $ ( 7447 ) قال النبي :(@)(@@) | 30 ( إن بني إسرائيل استخلفوا عليهم خليفة فقام يصلي في القمر فوق بيت المقدس فذكر أمورا صنعها فتدلى بسبب فأصبح السبب متعلقا بالمسجد وقد ذهب فانطلق حتى أتى قوما على شط البحر فوجدهم يصنعون لبنا فسألهم كيف يأخذون على هاذا اللبن فأخبروه ، فلبث معهم فكان يأكل من عمل يده حتى إذا حضرت الصلاة تطهر فصلى ، فرفع خبر ذالك العامل إلى دهقانهم ، فقال : فينا رجل يصنع كذا وكذا فأرسل إليه فأبى أن يأتيه ، ثم إنه جاء يسير على دابته ، فلما رآه فر فتب عه فسبقه فقال : انظرني أكلمك كلمة فقام حتى كلمه فأخبره أنه كان مليكا وأنه فر من رهبة ذنبه ، فقال : إني لاحق بذالك معك فعبدا الله جميعا فسألا الله عز وجل أن يميتهما جميعا فماتا جميعا ) )(@)(@@) ( طب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7448 ) قال النبي :(@)(@@) | 30 ( إن بني إسرائيل كان إذا إصاب الشيء من أحدهم البول قرضه فنهاهم صاحبهم فهو يعذب في قبره ) )(@)(@@) عبد الرزاق عن عمرو بن العاص رضي الله عنه .(@)(@@) PageV03P086(@)(@@)(@@)(@@) $ ( 7449 ) قال النبي :(@)(@@) | 30 ( إن بني إسرائيل تفرقت على إحدى وسبعين فرقة ، وإن هاذه الأمة ستزيد عليهم فرقة ، كلها في النار إلا السواد الأعظم ) )(@)(@@) ( طب ص ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7450 ) قال النبي :(@)(@@) | 30 ( إن بني إسرائيل تفرقت على إحدى وسبعين فرقة ، فهلكت سبعون فرقة وخلصت فرقة واحدة وإن أمتي ستفترق على اثنتين وسبعين فرقة وتخلص فرقة قيل : يا رسول الله من تلك الفرقة ؟ قال : الجماعة الجماعة ) )(@)(@@) ( حم ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7451 ) قال النبي :(@)(@@) | 30 ( إن بين يدي الساعة كذابين 
ms822	 ) )(@)(@@) ( طب ) عن النعمان بن بشير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7452 ) قال النبي :(@)(@@) | 30 ( إن بين يدي الساعة كذابين منهم صاحب حمير ) )(@)(@@) ( حب ض ) عن جابر بن عبيد الله رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7453 ) قال النبي :(@)(@@) | 30 ( إن بين يدي الرحمان للوحا فيه ثلاثمائة وخمس عشرة شريعة ، يقول الرحمان عز وجل : وعزتي وجلالي لا يأتي عبد من عبادي لا يشرك بي شيئا فيه واحدة منها إلا دخل الجنة ) )(@)(@@) عبد بن حميد ( ع ) عن أبي سعيد رضي الله عنه وضعف .(@)(@@)(@@)(@@) $ ( 7454 ) قال النبي :(@)(@@) | 30 ( إن بين أعلى الجنة وأسفلهم درجة كالنجم يرى في مشارق الأرض ومغاربها ) )(@)(@@) ابن جرير عن قتادة مرسلا .(@)(@@)(@@)(@@) $ ( 7455 ) قال النبي :(@)(@@) | 30 ( إن بين يدي الساعة سنين خداعة يتهم فيها الأمين ، ويؤتمن فيها الخائن ويصدق فيها الكاذب ، ويكذب فيها الصادق ، ويتكلم فيها الرويبضة ، قيل : يا رسول الله وما الرويبضة ؟ قال : السفية ينطق في أمر العامة ) )(@)(@@) PageV03P087 ( طب ) و الحاكم في الكنى وابن عساكر عن عوف بن مالك الأشجعي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7456 ) قال النبي :(@)(@@) | 30 ( إن بين أيدينا عقبة كؤودا لا يحاوزها إلا المخفون ، قال أبو ذر : أنا منهم يا رسول الله ؟ قال : لك قوت يوم وليلة ؟ قال : لا ، قال : أنت من المخفين ) )(@)(@@) ( هق ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7457 ) قال النبي :(@)(@@) | 30 ( إن بين يدي الساعة فتنا كأنها قطع الليل المظلم ، يصبح الرجل فيها مؤمنا ويمسي كافرا ، ويمسي مؤمنا ويصبح كافرا ، يبيع قوم خلاقهم بعرض من الدنيا يسير ) )(@)(@@) ( حم ) و نعيم بن حماد في الفتن ( حل ) عن النعمان بن بشير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7458 ) قال النبي :(@)(@@) | 30 ( إن بين يدي الساعة الدجال ، وبين يدي الدجال كذابون ثلاثون أو أكثر ، قيل : ما آيتهم ؟ قال : أن يأتوكم بسنة لم تكونوا عليها ، يغيرون بها سنتكم ودينكم ، فإذا رأيتموهم فاجتنبوهم وعادوهم ) )(@)(@@) ( طب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7459 ) قال النبي :(@)(@@) | 30 ( إن بين يدي الساعة ثلاثين كذابا منهم الأسود العنسي صاحب صنعاء وصاحب اليمامة ) )(@)(@@) ( طب ) عن ابن الزبير رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7460 ) قال النبي 
ms823	 :(@)(@@) | 30 ( إن بين يدي الساعة تسليم الخاصة وفشو التجارة حتى تعين المرأة زوجها على التجارة وقطع الأرحام ، وظهور شهادة الزور ، وكتمان شهادة الحق ، وظهور العلم ) )(@)(@@) ( حم ك ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7461 ) قال النبي :(@)(@@) | 30 ( إن بين يدي الساعة تسليم الخاصة وفشو التجارة حتى تعين المرأة زوجها على التجارة ، وحتى يخرج الرجل بماله إلى أطراف PageV03P088 الأرض فيرجع فيقول لم أربح شيئا ) )(@)(@@) ( ك ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7462 ) قال النبي :(@)(@@) | 30 ( إن بين يدي الساعة كذابين منهم صاحب اليمامة ، ومنهم الأسود العنسي ، ومنهم صاحب حمير ، ومنهم الدجال وهو أعظمهم فتنة ) )(@)(@@) ( ش ) عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 7463 ) قال النبي :(@)(@@) | 30 ( إن بين يدي الساعة فتنا كقطع الليل المظلم ، فتنا كقطع الدخان يموت فيها قلب الرجل كما يموت بدنه ، يصبح الرجل فيها مؤمنا ويمسي كافرا ، ويمسي مؤمنا ويصبح كافرا ، يبيع فيها قوم خلاقهم ودينهم بعرض من الدنيا ) )(@)(@@) ابن سعد ( حم طب ك ) عن الضحاك بن قيس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7464 ) قال النبي :(@)(@@) | 30 ( إن بين يدي الساعة ثلاث سنوات تمسك السماء ثلثي قطرها ، والأرض ثلثي نباتها ، والسنة الثالثة تمسك السماء قطرها ، والأرض نباتها حتى لا يبقى ذو خف ولا حافر ، إن يخرج يعني الدجال وأنا فيكم فأنا حجيجه ، وإلا فإن الله عز وجل خليفتي على كل مسلم مؤمن ، قالوا : يا رسول الله فما يجزي المؤمن يومئذ ؟ قال : ما يجزي الملائكة التسبيح والتحميد والتهليل ) )(@)(@@) ( طب ) عن أسماء بنت زيد رضي الله عنها .(@)(@@)(@@)(@@) $ ( 7465 ) قال النبي :(@)(@@) | 30 ( إن بيوتات المؤمنين لمصابيح إلى العرش يعرفها مقربو السماوات السبع يقولون : هاذا النور من بيوتات المؤمنين التي يتلى فيها القرآن الحكيم ) )(@)(@@) عن أبي هريرة وأبي الدرداء رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7466 ) قال النبي :(@)(@@) | 30 ( إن ج| ابر ا قد صنع سورا فحي هلا بكم ) )(@)(@@) ( خ ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7467 ) قال النبي :(@)(@@) | 30 ( إن رجبا شهر عظيم تضاعف فيه الحسنات ، من صام يوما منه كان كصيام سنة ) )(@)(@@) الرافعي عن سعيد رضي الله عنه .(@)(@@) PageV03P089(@)(@@)(@@)(@@) $ ( 7468 ) قال 
ms824	 النبي :(@)(@@) | 30 ( إن جبريل أتاني آنفا فبشرني أن الله قد أعطاني الشفاعة ، قيل : يا رسول الله أفي بني هاشم خاصة ؟ قال : لا ، قيل : أفي قريش عامة ؟ قال : لا ، قيل : أفي أمتك ؟ قال : هي في أمتي للمذنبين المثقلين ) )(@)(@@) ( طب ) و ابن عساكر عن عبد الله بن بسر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7469 ) قال النبي :(@)(@@) | 30 ( إن جبريل أخبرني أن الله استشهد جعفرا ، إن له جناحين يطير بهما مع الملائكة في الجنة ) )(@)(@@) ( طب ) و أبو نعيم في المعرفة ( كر ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7470 ) قال النبي :(@)(@@) | 30 ( إن جبريل جاءني فقال لي : أبشرك يا محمد بما أعطاك الله عز وجل من أمتك ، وما أعطى أمتك منك ، من صلى عليك منهم صلاة صلى الله عليه ، ومن سلم عليك سلم الله عليه ) )(@)(@@) ابن عساكر عن عبد الرحمن بن عوف رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7471 ) قال النبي :(@)(@@) | 30 ( إن جبريل أتاني فقال لي : راجع حفصة فإنها صوامة قوامة وهي زوجتك في الجنة ) )(@)(@@) ابن سعد ( طب ) عن قيس بن زيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7472 ) قال النبي :(@)(@@) | 30 ( إن جبريل نهاني أن أصلي على رجل عليه دين وقال : إن صاحب الدين مرتهن في قبره حتى يقضى عنه دينه ) )(@)(@@) ( ع ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7473 ) قال النبي :(@)(@@) | 30 ( إن جبريل أتاني فأخبرني أن فيهما خبثا ، فإذا أتى أحدكم المسجد فليقلب نعليه فلينظر فيهما فإن رأى فيهما خبثا فليمسحه بالأرض ثم ليصل فيهما ) )(@)(@@) عبد الرزاق ( طحم ) وعبد بن حميد والدارمي ( ع ) وابن جزيمة ( حب هق ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7474 ) قال النبي :(@)(@@) | 30 ( إن جبريل أخبرني أن في أحدهما قذرا فخلعتهما لذالك ، فلا تخلعوا نعالكم ) )(@)(@@) ( طب ك ) عن ابن مسعود رضي الله عنه .(@)(@@) PageV03P090(@)(@@)(@@)(@@) $ ( 7475 ) قال النبي :(@)(@@) | 30 ( إن جبريل أخبرني أن فيهما قذرا ) )(@)(@@) ( طس ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7476 ) قال النبي :(@)(@@) | 30 ( إن جبريل أخبرني أن الحجامة أنفع ما تداوى به الناس ) )(@)(@@) الخطيب عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7477 ) قال النبي :(@)(@@) | 30 ( إن جبريل 
ms825	 أمرني أن أكبر ) )(@)(@@) ابن النجار عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7478 ) قال النبي :(@)(@@) | 30 ( إن جبريل موكل بحوائج بني آدم ، فإذا دعا العبد الكافر قال الله تعالى : يا جبريل اقض حاجته فإني لا أحب أن أسمع دعاءه ، وإذا دعا العبد المؤمن قال : جبريل احبس حاجته فإني أحب أن أسمع دعاءه ) )(@)(@@) ابن النجار عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7479 ) قال النبي :(@)(@@) | 30 ( إن جبريل عن يمين ، وميكائيل عن يساري ، والملائكة قد أظلت عسكري ) )(@)(@@) ابن منده عن خابط بن خباب الكناني عن أبيه .(@)(@@)(@@)(@@) $ ( 7480 ) قال النبي :(@)(@@) | 30 ( إن جبريل أخبرني أن ابني الحسين يقتل وهاذه تربة تلك الأرض ) )(@)(@@) الخليلي في الإرشاد عن عائشة وأم سلمة رضي الله عنهما معا .(@)(@@)(@@)(@@) $ ( 7481 ) قال النبي :(@)(@@) | 30 ( إن جبريل كان معنا في البيت فقال : أتحبه ؟ فقلت : أما في الدنيا فنعم ، قال : إن أمتك ستقتل هاذا بأرض يقال لها كربلاء ، فتناول جبريل من تربتها فأرانيه ) )(@)(@@) ( طب ) عن أم سلمة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 7482 ) قال النبي :(@)(@@) | 30 ( إن جبريل أتاني فأخبرني أن الله قد برأ مارية وقريبها مما وقع في نفسي وبشرني أن في بطنها مني غلاما وأنه أشبه الخلق بي ، وأمرني أن أسمي ابني إبراهيم وكناني بأبي إبراهيم ، ولولا أني أكره أن أحول كنيتي التي عرفت بها لاكتنيت بأبي إبراهيم كما كناني جبريل ) )(@)(@@) ابن عساكر عن ابن عمرو رضي الله عنهما .(@)(@@) PageV03P091(@)(@@)(@@)(@@) $ ( 7483 ) قال النبي :(@)(@@) | 30 ( إن جبريل أخبرني أن ابني هاذا يعني الحسين يقتل وأنه اشتد غضب الله على من يقتله ) )(@)(@@) ابن عساكر عن أم سلمة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 7484 ) قال النبي :(@)(@@) | 30 ( إن جبريل أخبرني أن الله تعالى باهى بالمهاجرين والأنصار أهل السماوات السبع ، وباهى بك يا علي ويا عباس حملة العرش ) )(@)(@@) الخطيب وابن عساكر عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7485 ) قال النبي :(@)(@@) | 30 ( إن جبريل أمرني إذا حضر العباس أن أخفض صوتي ، كما أمرتم أن تخفضوا أصواتكم عندي ) )(@)(@@) ابن عساكر عن عائشة رضي الله عنها وضعف .(@)(@@)(@@)(@@) $ ( 7486 ) قال النبي :(@)(@@) | 30 ( إن جبريل ليخبرني 
ms826	 أني رجل من مضر ) )(@)(@@) ابن سعد عن يحيى بن جابر مرسلا .(@)(@@)(@@)(@@) $ ( 7487 ) قال النبي :(@)(@@) | 30 ( إن جبريل أراني التربة التي يقتل عليها الحسين فاشتد غضب الله على من يسفك دمه ، يا عائشة والذي نفسي بيده إنه ليحزنني ، فمن هاذا من أمتي يقتل حسينا بعدي ) )(@)(@@) ابن سعد عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 7488 ) قال النبي :(@)(@@) | 30 ( إن جبريل أتاني فأمرني أن أعلن بالتلبية ) )(@)(@@) ( حم ض ) عن ابن عباس رضي الله عنهما ) .(@)(@@)(@@)(@@) $ ( 7489 ) قال النبي :(@)(@@) | 30 ( إن جبريل صعد قبلي العتبة الأولى فقال : يا محمد فقلت : لبيك وسعديك ، فقال : من أدرك أبويه أو أحدهما فلم يغفر له فأبعده الله قل آمين فقلت : آمين ، فلما صعد العتبة الثانية قال : يا محمد قلت : لبيك وسعديك ، قال : من أدرك شهر رمضان فصام نهاره وقام ليله ثم مات ولم يغفر له فدخل النار فأبعده الله قل آمين ، فقلت : آمين ، فلما صعد العتبة الثالثة قال : يا محمد قلت : لبيك وسعديك ، قال : لمن ذكرت عنده فلم يصل عليك فمات PageV03P092 ولم يغفر له فدخل النار فأبعده الله قل آمين ، فقلت : آمين ) )(@)(@@) ( هب ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7490 ) قال النبي :(@)(@@) | 30 ( إن جبريل ذهب بابراهيم إلى جمرة العقبة فعرض له الشيطان فرماه بسبع حصيات فساخ ، ثم أتى به الجمرة الوسطى فعرض له الشيطان فرماه بسبع حصيات فساخ ، ثم أتى به الجمرة القصوى فعرض له الشيطان فرماه بسبع حصيات فساخ ، فلما أراد إبراهيم أن يذبح إسماعيل قال لأبيه : يا أبت أوثقني لئلا أضطرب فينتضح عليك دمي إذا ذبحتني فشده فلما أخذ الشفرة فأراد أن يذبحه نودي من خلفه أن يا إبراهيم قد صدقت الرؤيا ) )(@)(@@) ( حم ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7491 ) قال النبي :(@)(@@) | 30 ( إن جبريل أتاني فقال : من أدرك شهر رمضان ولم يغفر له فدخل النار فأبعده الله قل آمين ، فقلت : آمين ، ومن أدرك أبويه أو أحدهما فلم يبرهما فمات فدخل النار فأبعده الله قل آمين ، فقلت : آمين ، ومن ذكرت عنده فلم يصل عليك فمات فدخل النار فأبعده 
ms827	 الله قل آمين ، فقلت : آمين ) )(@)(@@) ( حب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7492 ) قال النبي :(@)(@@) | 30 ( إن جبريل عرض لي حين ارتقيت درجة فقال : بعد من أدرك رمضان فلم يغفر له ، فقلت : آمين ، فلما رقيت الثانية قال : بعد من ذكرت عنده فلم يصل عليك فقلت آمين ، فلما رقيت الثالثة قال : بعد من أدرك أبويه الكبر عنده أو أحدهما فلم يدخلاه الجنة ، فقلت : آمين ) )(@)(@@) ( طب ك هق ) عن كعب بن عجرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7493 ) قال النبي :(@)(@@) | 30 ( إن جبريل جعل يدس في فم فرعون الطين خشية أن PageV03P093 يقول لا إلاه إلا الله فيرحمه الله ) )(@)(@@) ابن جرير ( ك ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7494 ) قال النبي :(@)(@@) | 30 ( إن جبريل أتاني وأنا آكل متكئا فقال : أيسرك أن تكون ملكا فهالني قوله ) )(@)(@@) الحكيم عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 7495 ) قال النبي :(@)(@@) | 30 ( إن جبريل قد أمرني أن أقرئك لم يكن الذين كفروا ، قاله لابي ) )(@)(@@) ( حم طب ) و ابن قانع وابن مردويه عن أبي حبة البدري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7496 ) قال النبي :(@)(@@) | 30 ( إن جبريل أتاني فأخبرني أن ابني هاذا تقتله أمتي ، قلت : فأرني تربته فأتاني بتربة حمراء ) )(@)(@@) ( ع طب ) عن زينب بنت جحش رضي الله عنها .(@)(@@)(@@)(@@) $ ( 7497 ) قال النبي :(@)(@@) | 30 ( إن جبريل أتاني فأخذ بيدي فأخرجني فإذا على البيت دابة دون البغل وفوق الحمار فحملني عليها ثم انطلق حتى انتهى بي إلى بيت المقدس فأرني إبراهيم يشبه خلقي خلقه ، وأراني موسى وآدم طويلا سبط الشعر شبهته برحال أزد شنوءة ، وأراني عيسى بن مريم ربعة أبيض يضرب إلى الحمرة شبهته بعروة بن مسعود الثقفي ، وأراني الدجال ممسوح العين اليمنى شبهته بقطن بن عبد العزى ، وأنا أريد أن أخرج إلى قريش فاخبرهم بما رأيت ) )(@)(@@) ( طب ) عن أم هانىء رضي الله عنها .(@)(@@)(@@)(@@) $ ( 7498 ) قال النبي :(@)(@@) | 30 ( إن جبريل جاءني في أحسن صورة لم ينزل في مثلها قط ضاحكا مستبشرا فقال : السلام عليك يا محمد ، فقلت : وعليك السلام يا جبريل ، قال : إن الله عز وجل بعثني 
ms828	 إليك بهدية قلت : وما تلك الهدية يا جبريل ؟ قال : كلمات من كنوز العرش أكرمك الله تعالى بهن ، قلت : وما هن ؟ قال : قل : يا من أظهر الجميل وستر القبيح ، يا من لا يؤاخذ بالجريرة ، ولا يهتك الستر ، يا عظيم العفو ، يا حسن التجاوز ، يا واسع المغفرة ، يا باسط اليدين PageV03P094 بالرحمة ، يا صاحب كل نجوى ، ويا منتهى كل شكوى ، يا كريم الصفح ، ياعظيم المن ، يا مبتدىء النعم قبل استحقاقها ، يا ربنا ويا سيدنا ويا مولانا ويا غاية رغبتنا أسألك يا الله أن لا تشوي خلقي بالنار ، قلت : فما ثواب هاذه الكلمات ؟ ) )(@)(@@) ( ك ) عن ابن عمرو رضي الله عنهما وتعقب .(@)(@@)(@@)(@@) $ ( 7499 ) قال النبي :(@)(@@) | 30 ( إن جبريل أتاني فقال : يا محمد إن الله أمرني أن آتي مشارق الأرض ومغاربها ، برها وبحرها ، سهلها وجبلها ، فآتيه بخير أهل الدنيا ، فوجدت خير أهل الدنيا العرب ، ثم أمرني أن آتيه بخير العرب فوجدت خير العرب مضر ) )(@)(@@) الديلمي عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7500 ) قال النبي :(@)(@@) | 30 ( إن جبريل أخرج حشوتي في طست من ذهب فغسلها ثم ألبسها حكمة ونورا ، أو حكمة وعلما ) )(@)(@@) ( طب ) عن أنس وفيه رشد بن سعد ضعيف .(@)(@@)(@@)(@@) $ ( 7501 ) قال النبي :(@)(@@) | 30 ( إن جبلا من جبال فارس بأرص الديلم يقال له قزوين ، نبأني خليلي جبريل قال : يحشرون يوم القيامة فيقومون على أبواب الجنة صفوفا والخلائق في الحساب وهم يجدون رائحة الجنة ) )(@)(@@) الحافظ الحسن بن أحمد العطار في فضائل قزوين والرافعي عن أبان عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7502 ) قال النبي :(@)(@@) | 30 ( إن دون جسر جهنم طريقا ذا دحض ومزلة ، وإنا أن نأتي عليه وفي أحمالنا اضطمار أخرى أن ننجو من أن نأتي عليه ونحن مواقير ) )(@)(@@) ( حم ك ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7503 ) قال الن بي :(@)(@@) | 30 ( إن جهنم تسأل المزيد حتى يضع الجبار فيها قدمه فينزوي بعضها إلى بعض وتقول قط قط ) )(@)(@@) ( قط ) في الصفات عن أبي رضي الله عنه .(@)(@@) PageV03P095(@)(@@)(@@)(@@) $ ( 7504 ) قال النبي :(@)(@@) | 30 ( إن حبر هاذه الأمة لعبد الله بن عباس ) )(@)(@@) ( ك 
ms829	 ) وتعقب عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7505 ) قال النبي :(@)(@@) | 30 ( إن حوضي ما بين أيلة وصنعاء عرضه كطوله يصب فيه ميزابان من الجنة أحدهما من ورق والآخر من ذهب ، وهو أبيض من اللبن ، وأحلى من العسل ، وأبرد من الثلج ، وألين من الزبد ، أباريقه كعدد نجوم السماء من شرب منه لم يظمأ حتى يدخل الجنة ) )(@)(@@) ( حم طب ك ) عن أبي برزة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7506 ) قال النبي :(@)(@@) | 30 ( إن ( قدر ) حوضي من كذا إلى كذا ، فيه من الآنية عدد النجوم ، أطيب ريحا من المسك ، وأحلى من العسل ، وأبرد من الثلج ، وأبيض من اللبن ، من شرب منه شربة لم يظمأ أبدا ، ومن لم يشرب منه لم يرو أبدا ) )(@)(@@) ( طب ) عن أبي بردة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7507 ) قال النبي :(@)(@@) | 30 ( إن حيضتك ليست في يدك ) )(@)(@@) عبد الرزاق ( م د ت ن ) عن عائشة رضي الله عنها أن رسول الله قال لها : ناوليني الخمرة من المسجد ، فقالت : إني حائض ، قال فذكره ( م ن ) عن أبي هريرة ( طب عن أم أيمن مثله .(@)(@@)(@@)(@@) $ ( 7508 ) قال النبي :(@)(@@) | 30 ( إن خيار أئمة قريش خيار أئمة الناس ) )(@)(@@) ( طب ) عن شريح بن عبيد بن الحارث وكثير بن مرة وعمرو بن الأسود وأبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7509 ) قال النبي :(@)(@@) | 30 ( إن خيار عباد الله من هاذه الأمة الذين إذا رؤوا ذكر الله ، وإن شرار عباد الله من هاذه الأمة المشاؤون بالنميمة ، المفرقون بين الأحبة ، الباغون البرآء العنت ) )(@)(@@) الخرائطي في مساوىء الأخلاق من طريق عبد الرحمن بن غنم عن أبي مالك الأشعري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7510 ) قال النبي :(@)(@@) | 30 ( إن خياركم أحاسنكم أخلاقا وألطفكم بأهله ) )(@)(@@) PageV03P096 الخطيب عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 7511 ) قال النبي :(@)(@@) | 30 ( إن خياركم من أطعم الطعام ورد السلام ) )(@)(@@) ابن سعد عن حمزة بن صهيب عن أبيه .(@)(@@)(@@)(@@) $ ( 7512 ) قال النبي :(@)(@@) | 30 ( إن خير طيب الرجال ما ظهر ريحه وخفي لونه ، وخير طيب النساء ما ظهر لونه وخفي ريحه ) )(@)(@@) ( ت ) حسن غريب عن عمران بن حصين رضي الله 
ms830	 عنه .(@)(@@)(@@)(@@) $ ( 7513 ) قال النبي :(@)(@@) | 30 ( إن خير ما زرتم به الله في مصلاكم وفي قبوركم البياض ) ( ز ) عن أ$ بي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7514 ) قال النبي :(@)(@@) | 30 ( إن خير القوم خيرهم قضاء ) )(@)(@@) ( حم ك ) عن العرياض رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7515 ) قال النبي :(@)(@@) | 30 ( إن خير دينكم أيسره ) )(@)(@@) ( حم ) عن محجن بن الأدرع ( حم ) عن الأعرابي .(@)(@@)(@@)(@@) $ ( 7516 ) قال النبي :(@)(@@) | 30 ( إن من خير التابعين أويس القرني ) )(@)(@@) ( حم ) و ابن سعد عن عبد الرحمن بن أبي ليلى عن رجل من الصحابة .(@)(@@)(@@)(@@) $ ( 7517 ) قال النبي :(@)(@@) | 30 ( إن خير دور الأنصار عبد الأشهل ، ثم دار الحارث بن الخزرج ، ثم دار بني النجار ، ثم دور بني ساعدة ، فقال سعد : يا رسول الله جعلتنا آخر القبائل ، قال : إذا كنت من الخيار فحسبك ) )(@)(@@) ( طب ) عن عبد المهيمن ابن عباس ابن سهل ابن سعد عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 7518 ) قال النبي :(@)(@@) | 30 ( إن خير إبل ثلاثا زكاها أهلها ببعير ، واستبقوا بعيرا ، وأنطوا السائل بعيرا أدوا حقها ) )(@)(@@) الخرائطي في مكارم الأخلاق ( هب ) عن PageV03P097 عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7519 ) قال النبي :(@)(@@) | 30 ( إن خيرا لك أن لا تأخذ من الناس شيئا ، إنما ذالك أن تسأل الناس وما جاء من غير مسألة فإنما هو رزق رزقكه الله تعالى ) )(@)(@@) ( هب ) عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7520 ) قال النبي :(@)(@@) | 30 ( إن داود كان يوقظ أهله ساعة من الليل يقول : يا آل داود قوموا فصلوا ، فإن هاذه الساعة يستجاب فيها الدعاء إلا لساحر أو عشار ) )(@)(@@) ( ع كر ) عن عثمان بن أبي العاص رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7521 ) قال النبي :(@)(@@) | 30 ( إن داود سأل ربه مسألة فقال : اجعلني مثل إبراهيم وإسحاق ويعقوب فأوحى الله إليه : أني ابتليت إبراهيم بالنار فصبر ، وإسحاق بالذبح فصبر ، ويعقوب بالعمى فصبر ) )(@)(@@) ( فر ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7522 ) قال النبي :(@)(@@) | 30 ( إن دعامة أمتي عصب اليمن وأبدال الشام وهم أربعون رجلا ، كلما هلك رجل أبدل الله مكانه آخر ، ليسوا بالمتماوتين ولا المتهالكين ولا المتناوشين ، لم يبلغوا ما بلغوا بكثرة 
ms831	 صوم ولا صلاة ، وإنما بلغوا ذالك بالسخاء وصحة القلوب والمناصحة لجميع المسلمين ، وإن أمتي سيكونون على خمس طبقات ، فأنا ومن معي إلى أربعين سنة أهل إيمان وعلم ، ومن بعدهم إلى ثمانين سنة أهل بر وتقوى ، ومن بعدهم إلى عشرين ومائة سنة أهل تراحم وتواصل ومن بعدهم إلى ستين ومائة أهل تقاطع وتدابر ، ومن بعدهم إلى انقضاء الدنيا فالهرج ، النجاء النجاء ) )(@)(@@) تمام وابن عساكر عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7523 ) قال النبي :(@)(@@) | 30 ( إن دماءكم وأعراضكم عليكم حرام كحرمة يومكم هاذا ، في شهركم هاذا ، في بلدكم هاذا ) )(@)(@@) ( طب ) عن فضالة بن عبيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7524 ) قال النبي :(@)(@@) | 30 ( إن دعوة المرء مستجابة لأخيه بظهر الغيب ، عند PageV03P098 رأسه ملك يؤمن على دعائه كلما دعا له بخير قال : آمين ولك بمثل ) )(@)(@@) ( ش ) عن أبي الدرداء وأم الدرداء الصحابية رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7525 ) قال النبي :(@)(@@) | 30 ( إن دون الله عز وجل سبعين ألف حجاب من نور وظلمة ، ما تسمع نفس شيئا من حس تلك الحجب إلا زهقت ) )(@)(@@) ( طب ) عن ابن عمر وسهل بن سعد رضي الله عنهم معا .(@)(@@)(@@)(@@) $ ( 7526 ) قال النبي :(@)(@@) | 30 ( إن دين الله تعالى لن ينصره إلا من حاطه من جميع جوانبه ) )(@)(@@) الديلمي عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7527 ) قال النبي :(@)(@@) | 30 ( إن دينكم دين متين فأوغل فيه برفق ، فإن المنبت لا ظهرا أبقى ولا أرضا قطع ) )(@)(@@) العسكري في الأمثال عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7528 ) قال النبي :(@)(@@) | 30 ( إن ذالك لداء ما كان الله ليقذفني به يعني ذات الجنب لا يبقين في البيت أحد إلا لد إلا عم رسول الله ) )(@)(@@) ( حم طب ك ) عن أسماء بنت عميس رضي الله عنها .(@)(@@)(@@)(@@) $ ( 7529 ) قال النبي :(@)(@@) | 30 ( إن ذراري المؤمنين في الجنة يكفلهم إبراهيم ) )(@)(@@) ( هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7530 ) قال النبي :(@)(@@) | 30 ( إن رأس الدجال من ورائه حبك حبك ، وإنه سيقول : أنا ربكم ، فمن قال : أنت ربي افتتن ، ومن قال : كذبت ربي الله عليه توكلت إليه أنيب فلا يضره 
ms832	 ) )(@)(@@) ( حم طب هب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7531 ) قال النبي :(@)(@@) | 30 ( إن ربكم تعالى رحيم ، من هم بحسنة فلم يعملها كتبت له حسنة ، فإن عملها كتبت له عشرة أضعاف إلى سبعمائة ضعف ، إلى أضعاف كثيرة ، ومن هم بسيئة فلم يعملها كتبت له حسنة ، فإن عملها كتبت عليه PageV03P099 سيئة واحدة ، أو محاها الله ، ولا يهلك على الله إلا هالك ) )(@)(@@) ( حم طب هب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7532 ) قال النبي :(@)(@@) | 30 ( إن ربكم تعالى ليس بأعور وإنه يعني الدجال أعور مكتوب بين عينيه كافر يقرؤه الأمي والكاتب ) )(@)(@@) ( طب ) عن أبي بكرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7533 ) قال النبي :(@)(@@) | 30 ( إن ربكم خيرني بعد سبعين ألفا يدخلون الجنة عفوا بغير حساب وبين الخبيئة عنده لأمتي ، إن ربي زادني مع كل ألف سبعين ألفا والخبيئة عنده ) )(@)(@@) ( حم طب ) عن أبي أيوب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7534 ) قال النبي :(@)(@@) | 30 ( إن ربكم يقول : كل حسنة بعشر أمثالها إلى سبعمائة ضعف ، والصوم لي وأنا أجزي به ، والصوم جنة من النار ، ولخلوف فم الصائم أطيب عند الله من ريح المسك ، وإن جهل على أحدكم جاهل وهو صائم فليقل إني صائم ) )(@)(@@) ( ت ) حسن غريب عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7535 ) قال النبي :(@)(@@) | 30 ( إن ربكم عز وجل ميسر يسير فعليكم باليسير من العمل ، ألا إنه من يغالب أمر الله يغلبه ، ومن يهجر عمل الله يسؤه ) )(@)(@@) ابن قانع عن سويد بن جبلة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7536 ) قال النبي :(@)(@@) | 30 ( إن ربكم واحد ، وإن أباكم واحد ، ودينكم واحد ، ونبيكم واحد ، ولا فضل لعربي على عجمي ، ولا عجمي على عربي ، ولا أحمر على أسود ، ولا أسود على أحمر إلا بالتقوى ) )(@)(@@) ابن النجار عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7537 ) قال النبي :(@)(@@) | 30 ( إن ربكم تعالى حيي كريم يستحيي إذا رفع العبد يديه أن يردهما صفرا لا خير فيهما ، فليعط الله من نفسه الجهد ، وإذا حزبه أمر فليقل : حسبي الله ونعم الوكيل ) )(@)(@@) ( قط ) في الأفراد عن علي رضي الله 
ms833	 عنه .(@)(@@) PageV03P100(@)(@@)(@@)(@@) $ ( 7538 ) قال النبي :(@)(@@) | 30 ( إن ربكم حيي كريم يستحيي أن يرفع العبد يديه فيردهما صفرا لا خير فيهما ، فإذا رفع أحدكم يديه فليقل : يا حي لا إلاه إلا أنت ثلاث مرات ، ثم إذا رد يديه فليفرغ ذالك الخير على وجهه ) )(@)(@@) ( طب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7539 ) قال النبي :(@)(@@) | 30 ( إن ربكم تعالى يقول : لو أن عبادي أطاعوني لأسقيتهم المطر بالليل ، وأطلعت عليهم الشمس بالنهار ، ولم أسمعهم صوت الرعد ) )(@)(@@) ( ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7540 ) قال النبي :(@)(@@) | 30 ( إن ربكم حيي كريم يستحيي إذا رفع العبد يديه أن يردهما صفرا حتى يجعل فيهما خيرا ) )(@)(@@) عبد الرزاق عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7541 ) قال النبي :(@)(@@) | 30 ( إن ربي استشارني في أمتي ماذا أفعل ؟ فقلت : ما شئت يا رب ، هم خلقك وعبادك ، فاستشارني الثانية ، فقلت له كذالك ، فاستشارني الثالثة فقلت كذالك ، فقال تعالى : إني لن أخزيك في أمتك يا أحمد وبشرني أن أول من يدخل الجنة معي من أمتي سبعون ألفا مع كل ألف سبعون ألفا ليس عليهم حساب ، ثم أرسل إلي ادع تجب ، وسل تعط ، فقلت لرسوله : أومعطي ربي تعالى سؤلي ؟ قال : ما أرسل إليك إلا ليعطيك ، ولقد أعطاني من غير فخر ، غفر لي ما تقدم من ذنبي وما تأخر وأنا أمشي حيا صحيحا ، وأعطاني أن لا تخزى أمتي ولا تغلب ، وأعطاني الكوثر نهرا في الجنة يسيل وفي حوضي ، وأعطاني القوة والنصر والرعب يسير بين يدي شهرا ، وأعطاني أني أول الأنبياء دخولا الجنة ، وطيب لي ولامتي الغنيمة ، وأحل لنا كثيرا مما شدد على من كان قبلنا ، ولم يجعل علينا في الدين من حرج فلم أجد لي شكرا إلا هاذه السجدة ) )(@)(@@) ( حم ) و ابن عساكر عن حذيفة رضي الله عنه .(@)(@@) PageV03P101(@)(@@)(@@)(@@) $ ( 7542 ) قال النبي :(@)(@@) | 30 ( إن ربي عز وجل وعدني من أمتي سبعين ألفا لا يحاسبون ، مع كل ألف سبعين ألفا ) )(@)(@@) ( طب ) عن ثزبان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7543 ) قال النبي :(@)(@@) | 30 ( إن ربي عز وجل وعدني أن يدخل الجنة 
ms834	 من أمتي سبعين ألفا بغير حساب ، ويشفع كل ألف لسبعين ألفا ، ثم يحثي ربي ثلاث حثيات بكفيه ، إن ذالك إن شاء الله مستوعب مهاجري أمتي ، ويوفيني الله بشيء من أعرابنا ) )(@)(@@) البغوي ( طب ) وابن عساكر عن أبي سعد الخير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7544 ) قال النبي :(@)(@@) | 30 ( إن ربي تعالى أعطاني سبعين ألفا من أمتي يدخلون الجنة بغير حساب ، قال عمر : يا رسول الله هلا استزدته ؟ قال : قد استزدته فأعطاني مع كل رجل سبعين ألفا ، قال : هلا استزدته ؟ قال : قد استزدته فأعطاني هاكذا وبسط باعه ) )(@)(@@) ( حم طب ) عن عبد الرحمن بن بكر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7545 ) قال النبي :(@)(@@) | 30 ( إن ربي تعالى وعدني أن يدخل الجنة من أمتي سبعين ألفا بغير حساب ، ثم يشفع كل ألف بسبعين ألفا ، ثم يحثي لي ربي بكفيه ثلاث حثيات ) )(@)(@@) ( طب ) عن عتبة بن عبد السلمي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7546 ) قال النبي :(@)(@@) | 30 ( إن ربي تبارك وتعالى خيرني بين خصلتين : أن يدخل نصف أمتي الجنة ، وبين الشفاعة ) )(@)(@@) ( طب ) عن عوف بن مالك رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7547 ) قال النبي :(@)(@@) | 30 ( إن ربي حرم علي الخمر والكوبة والقيان ، وإياكم والغبيراء فإنها ثلث خمر العالم ) )(@)(@@) ( حم طب ) عن قيس بن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7548 ) قال النبي :(@)(@@) | 30 ( إن ربي قد قتل كسرى ولا كسرى بعد اليوم ، وقد PageV03P102 قتل قيصر ولا قيصر بعد اليوم ) )(@)(@@) ( طب ) عن أبي بكرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7549 ) قال النبي :(@)(@@) | 30 ( إن ربي خيرني بين سبعين ألفا يدخلون الجنة عفوا بغير حساب ، وبين الخبيئة عنده ، إن ربي زادني يتبع كل ألف سبعون ألفا ، والخبيئة عنده ) )(@)(@@) ( حل ) عن أبي أيوب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7550 ) قال النبي :(@)(@@) | 30 ( إن ربي حرم علي الخمر والميسر والقنين والكوبة ) )(@)(@@) ( ه ) عن ابن عمر وابن أبي الدنيا في ذم الملاهي ( هق ) عن قيس بن سعد بن عبادة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7551 ) قال النبي :(@)(@@) | 30 ( إن ربي حرم علي الخمر والميسر والكوبة والقنين والغبيراء ، وكل مسكر حرام ) )(@)(@@) ( هق ) عن قيس بن سعد رضي 
ms835	 الله عنه .(@)(@@)(@@)(@@) $ ( 7552 ) قال النبي :(@)(@@) | 30 ( إن رجالا ليسوا بأنبياء ولا شهداء ، يوضع لهم يوم القيامة منابر من نور ، وجوههم من نور ، يؤمنون يوم القيامة من الفزع الأكبر ، هم نزاع القبائل يتحابون في الله عز وجل ) )(@)(@@) ( طب ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7553 ) قال النبي :(@)(@@) | 30 ( إن رجالا سترتفع بهم المسألة حتى يقولون : الله خلق الخلق فمن خلقه ؟ ) )(@)(@@) ( حم ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7554 ) قال النبي :(@)(@@) | 30 ( إن رجالا يزعمون أن الشمس والقمر إذا انكسف واحد منهما فإنما ينكسف لموت عظيم من العظماء وليس كذالك ، ولاكنهما خلقان من خلق الله ، فإذا تجلى الله لشيء من خلقه خشع له ) )(@)(@@) ( حم ) عن النعمان بن بشر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7555 ) قال النبي :(@)(@@) | 30 ( إن رجالا يدخلهم الله النار فيحرقهم حتى يكونوا PageV03P103 فحما أسود وهم أعلى أهل النار فيتجاءرون إلى الله تعالى يدعونه فيقولون : ربنا أخرجنا فاجعلنا في أعلا هاذا الجدار فإذا جعلهم الله في أعلا الجدار رأوا أنه لا يغني عنهم شيئا قالوا : ربنا اجعلنا من وراء السور ولا نسألك شيئا بعده ، فيرفع له شجرة حتى تذهب عنهم سخنة النار ثم يقول : إني عهدت إلى عبادي أن لا أدخل الجنة رجلا إلا جعلت له فيها ما اشتهت نفسه ، لكم ما سألتم ومثله ) )(@)(@@) ( هناد ) عن أبي سعيد وأبي هريرة رضي الله عنهما معا .(@)(@@)(@@)(@@) $ ( 7556 ) قال النبي :(@)(@@) | 30 ( إن رجالا لا يستنفرون بعشائرهم يقولون : الخير الخير والمدينة خير لهم لو كانوا يعلمون والذي نفس محمد بيده لا يصبر على لأوائها وشدتها أحد إلا كنت له شفيعا أو شهيدا ، أو هما جميعا يوم القيامة ، والذي نفس محمد بيده إنها لتنفي خبث أهلها كما ينفي الكير خبث الحديد ، والذي نفس محمد بيده لا يخرج منها أحد راغبا عنها إلا أبدلها الله خيرا منه ) )(@)(@@) ( هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7557 ) قال النبي :(@)(@@) | 30 ( إن رجلا كان يعمل السيئات وقتل سبعة وتسعين نفسا كلها يقتل ظلما بغير حق ، فخرج فأتى ديرانيا فقال : يا راهب إن 
ms836	 الآخر قتل سبعة وتسعين نفسا كلها تقتل ظلما بغير حق ، فهل له من توبة ؟ قال : لا ليس له من توبة فضربه فقتله ، ثم جاء آخر فقال له : يا راهب إن الآخر قد قتل ثمانية وتسعين نفسا كلها يقتل ظلما بغير حق فهل له من توبة ؟ قال : لا ، ليست له توبة فضربه فقتله ، ثم أتى آخر فقال له : إن الآخر قد قتل تسعة وتسعين نفسا كلها يقتل ظلما بغير حق فهل له من توبة ؟ قال : لا ، فضربه فقتله ثم أتى راهبا آخر فقال له : إن الآخر لم يدع من الشر شيئا إلا قد عمله ، قد قتل مائة نفس كلها يقتل ظلما بغير حق فهل له من توبة ؟ فقال له : والله لئن قلت لك إن الله لا يتوب على من تاب إليه لقد كذبت ، هاهنا دير فيه قوم متعبدون فأتهم فاعبد الله معهم فخرج تائبا حتى إذا كان في نصف الطريق بعث الله إليه ملكا فقبض نفسه فحضرته ملائكة العذاب وملائكة PageV03P104 الرحمة فاختصموا فيه فبعث الله إليهم ملكا فقال لهم : إلى أي القريتين كان أقرب فهو منها فقاسوا ما بينهما فوجدوه أقرب إلى قرية التوابين بقيس أنملة فغفر له ) )(@)(@@) ( ع طب ) و ابن عساكر عن معاوية رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7558 ) قال النبي :(@)(@@) | 30 ( إن رجلا خيره ربه عز وجل بين أن يعيي في الدنيا ما شاء أن يعيي فيها ويأكل في الدنيا ما شاء أن يأكل منها ، وبين لقاء ربه ، فاختار لقاء ربه ، فبكى أبو بكر ابن أبي قحافة ، فقال : ما من الناس أحد أمن علينا في صحبته وذات يده من أبي بكر بن أبي قحافة ، ولو كنت متخذا خليلا لاتخذت أبا بكر بن أبي قحافة خليلا ، ولاكن ود وإخاء إيمان مرتين وإن صاحبكم خليل الله عز وجل ) )(@)(@@) ( حم ت ) غريب ( طب ) و البغوي عن ابن أبي المعلى عن أبيه .(@)(@@)(@@)(@@) $ ( 7559 ) قال النبي :(@)(@@) | 30 ( إن رجلا زار أخا له في قرية أخرى فأرصد الله على مدرجته ملكا فلما أتى عليه قال : أين 
ms837	 تريد ؟ قال : أريد أخا لي في هاذه القرية ، فقال له : هل له عليك من نعمة تربها ؟ قال : لا غير أني أحببته في الله ، قال لي : فإني رسول الله إليك بأن الله قد أحبك كما أحببته فيه ) )(@)(@@) ( حم ) و هناد في الأدب ( م حب هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7560 ) قال النبي :(@)(@@) | 30 ( إن رجلا ممن كان قبلكم لبس برده فتبختر فيها فنظر الله إليه من فوق عرشه فمقته ، فأمر الأرض فأخذته فهو يتجلجل بين الأرض ، فاحذرو مقت الله عز وجل ) )(@)(@@) ( طب ) عن أبي جرى الجهيمي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7561 ) قال النبي :(@)(@@) | 30 ( إن رجلا حلف بالله الذي لا إلاه إلا هو كاذبا فغفر له ) )(@)(@@) ( حم طب ض ) عن ابن الزبير رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7562 ) قال النبي :(@)(@@) | 30 ( إن رجلا ممن كان قبلكم كان له مركب في البحر وكان يبيع الخمر ويشوبه بالماء وكان معه في المركب قردينظر إلى ما يفعل ، فلما PageV03P105 استتم ما في المركب من الخمر ، أخذ القرد الكيس فصعد الذروة فجعل يرمي بدينار في البحر ودينار في المركب حتى جزأه نصفين ) )(@)(@@) الخطيب عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7563 ) قال النبي :(@)(@@) | 30 ( إن رجلا حمل معه خمرا في سفينة يبيعه ومعه قرد ، فكان الرجل إذا باع الخمر شابه بالماء ثم باعه فأخخالقرد الكيس فصعد به فوق الدقل فجعل يأخذ دينارا فيرمي به في السفينة ، ويأخذ دينارا فيرمي به في البحر حتى فرغ مما في الكيس ) )(@)(@@) ( حم هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7564 ) قال النبي :(@)(@@) | 30 ( إن رجلا فيمن كان قبلكم استضاف قوما فأضافوه ولهم كلبة تنبح ، فقالت الكلبة : والله لا أنبح ضيف أهلي الليل ، فعوى جراؤها في بطنها ، فبلغ ذالك نبيا لهم أو قيلا لهم فقال : مثل هاذه مثل أمة تكون بعدكم يقهر سفهاؤها حلماءها ، أو يغلب سفهاؤها علماءها ) )(@)(@@) الرامهرمزي في الأمثال عن عطاء بن السائب عن أبيه عن ابن عمرو رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7565 ) قال النبي :(@)(@@) | 30 ( إن رجلا كان سهلا قاضيا ومقتضيا وبائعا 
ms838	 ومبتاعا فدخل الجنة ) )(@)(@@) ( ط ) عن عثمان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7566 ) قال النبي :(@)(@@) | 30 ( إن رجلا في الجاهلية جعل يتبختر وعليه حلة قد لبسها ، فأمر الله الأرض فأخذته ، فهو يتجلجل فيها إلى يوم القيامة ) )(@)(@@) ( كر ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7567 ) قال النبي :(@)(@@) | 30 ( إن روح الله عيسى نازل فيكم فإذا رأيتموه فاعرفوه ، رجل مربوع إلى الحمرة والبياض ، عليه ثوبان ممصران كأن رأسه يقطر وإن لم يصبه بلل ، فيدق الصليب ، ويقتل الخنزير ، ويضع الجزية ، ويدعو الناس إلى الإسلام ، فيهلك الله في زمانه المسيح الدجال ، فتقع الأمنة على أهل الأرض PageV03P106 حتى ترتعي الأسود مع الإبل ، والنمور مع البقر ، والذئاب مع الغنم ، ويلعب الصبيان بالحيات لا تضرهم فيمكث أربعين سنة ثم يتوفى ويصلي عليه المسلمون ) )(@)(@@) ( ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7568 ) قال النبي :(@)(@@) | 30 ( إن روح القدس نفث في روعي أن نفسا لن تموت حتى تستوفي رزقها ، فأجملوا في الطلب ، ولا يحملنكم استبطاء الرزق على أن تطلبوا شيئا من فضل الله بمعصية الله ، فإنه ينال ما عند الله إلا بطاعته ) )(@)(@@) العسكري في الأمثال عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7569 ) قال النبي :(@)(@@) | 30 ( إن سفينة نوح طافت بالبيت سبعا ، وصلت خلف المقام ركعتين ) )(@)(@@) الديلمي عن عبد الرحمن بن زيد بن أسلم عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 7570 ) قال النبي :(@)(@@) | 30 ( إن سليمان بن داود أوثق شياطين في البحر ، فإذا كان سنة خمس وثلاثين خرجوا في صور الناس وأبشارهم ، فجالسوهم في المجالس والمساجد ، ونازعوهم القرآن والحديث ) )(@)(@@) الشيرازي في الألقاب عن ابن عمرو رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7571 ) قال النبي :(@)(@@) | 30 ( اللهم أحيني مسكينا وأمتني مسكينا واحشرني في زمرة المساكين يوم القيامة إنهم يدخلون الجنة قبل أغنيائهم بأربعين خريفا ، يا عائشة لا تردي المسكين ولو بشق تمرة ، يا عائشة أحبي المساكين وقربيهم فإن الله يقربك يوم القيامة ) )(@)(@@) ( ت ) غريب ( هب ) عن أنس رضي الله عنه وأورده ابن الجوزي في الموضوعات فأخطأ .(@)(@@)(@@)(@@) $ ( 7572 ) قال النبي :(@)(@@) | 30 ( أما ما رأيت من الطريق السهل الرحب اللاحب فذاك 
ms839	 ما حملتم عليه من الهدى فأنتم عليه ، وأما المرج الذي رأيت فالدنيا وغضارة عيشها ، مضيت أنا وأصحابي لم نتعلق بها ولم تتعلق بنا ، ولم نردها ولم تردنا ، ثم جاءت الرعلة الثانية بعد وهم أكثر منا سفافا فمنهم المربع ومنهم الآخذ PageV03P107 الضغث ونحوه على ذالك ثم جاء عظم الناس فمالوا في المرج يمينا وشمالا وأما أنت فمضيت على طريق صالحة فلم تزل عليها حتى تلقاني ، وأما المنبر الذي رأيت فيه سبع درجات وأنا في أعلاها درجة فالدنيا سبعة آلاف سنة وأنا في آخرها ألفا ، وأما الرجل الذي رأيت على يميني الأدم الشتل فذاك موسى إذا تكلم يعلو الرجال بفضل كلام الله إياه ، والذي رأيت عن يساري الشاب الربعة الكثير خيلان الوجه كأنها حمم شعره بالماء فذاك عيسى ابن مريم نكرمه لاكرام الله إياه ، وأما الشيخ الذي رأيت أشبه الناس بي خلقا ووجها فذاك أبونا إبراهيم كلنا نؤمه ونقتدي به ، وأما الناقة التي رأيت ورأيتني أنعتها فهي الساعة علينا تقوم ، لا نبي بعدي ولا أمة بعد أمتي ) )(@)(@@) ( طب ق ) عن الضحاك بن زمل .(@)(@@)(@@)(@@) $ ( 7573 ) قال النبي :(@)(@@) | 30 ( إن سليمان بن داود لما بنى بيت المقدس سأل الله عز وجل خلالا ثلاثة : سأل الله حكما يصادف حكمه فاوتيه ، وسأل الله ملكا لا ينبغي لأحد من بعده فاوتيه ، وسأل الله حين يفرغ من بناء المسجد أن يأتيه أحد لا ينهزه إلا الصلاة فيه أن يخرجه من خطيئته كيوم ولدته أمه ، أما الثنتان فقد أعطيهما ، وأرجو أن يكون قد أعطي الثالثة ) )(@)(@@) ابن زنجويه ( حم ن ه ) والحكيم ( حب ك هب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7574 ) قال النبي :(@)(@@) | 30 ( إن : الحمد لله ، وسبحان الله ، ولا إلاه إلا الله ، والله أكبر ، لتساقط من ذنوب العبد كما تساقط ورق هاذه الشجرة ) )(@)(@@) ( ت ) عن الأعمش عن أنس وقال غريب ولا يعرف للأعمش سماعا من أنس رضي الله عنه إلا أنه قد رآه .(@)(@@)(@@)(@@) $ ( 7575 ) قال النبي :(@)(@@) | 30 ( إن سعدا ضغط في قبره ضغطة فسألت الله أن يخفف عنه 
ms840	 ) )(@)(@@) ( طب ) عن ابن عمر رضي الله عنهما .(@)(@@) PageV03P108(@)(@@)(@@)(@@) $ ( 7576 ) قال النبي :(@)(@@) | 30 ( إن سمعك للمنقوص سمعه صدقة ، وإن بصرك للمنقوض بصره صدقة ) )(@)(@@) الديلمي عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7577 ) قال النبي :(@)(@@) | 30 ( إن شدة الحمى من فيح جهنم فإذا اشتد الحر فأبردوا عن الصلاة ) )(@)(@@) ( حم ) عن رجل ( ص ) عن أبي سعيد ( ص ) عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 7578 ) قال النبي :(@)(@@) | 30 ( إن شر البرية عند الله يوم القيامة من أذهب آخرته بدنيا غيره ) )(@)(@@) الخرائطي في مساوىء الأخلاق عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7579 ) قال النبي :(@)(@@) | 30 ( إن شر الناس ذو الوجهين الذي يأتي هاؤلاء بوجه وهاؤلاء بوجه ) )(@)(@@) مالك ( خ م ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7580 ) قال النبي :(@)(@@) | 30 ( إن شر الناس من يتقى لشره ) )(@)(@@) ابن عساكر عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 7581 ) قال النبي :(@)(@@) | 30 ( إن شركم الذين يتقون لكثرة شرهم ) )(@)(@@) ابن النجار عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 7582 ) قال النبي :(@)(@@) | 30 ( إن شر هاذه السباع الأثعل ) )(@)(@@) ابن سعد عن سالم بن وابصة .(@)(@@)(@@)(@@) $ ( 7583 ) قال النبي :(@)(@@) | 30 ( إن شرار أمتي الذين غذوا بالنعيم ونبتت عليهم أجسادهم ) )(@)(@@) ( ع ) و ابن عساكر عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7584 ) قال النبي :(@)(@@) | 30 ( إن شعر بصره يتبع روحه ) )(@)(@@) ( طب ) عن أبي بكرة رضي الله عنه .(@)(@@) PageV03P109(@)(@@)(@@)(@@) $ ( 7585 ) قال النبي :(@)(@@) | 30 ( إن شهداء الله في الأرض أمناء الله من خلقه ، قتلوا أو ماتوا ) )(@)(@@) البغوي عن أبي عتبة الخولاني حدثنا أصحاب نبينا رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 7586 ) قال النبي :(@)(@@) | 30 ( إن صاحب الدابة أحق بصدر دابته إلا أن تجعله لي ) )(@)(@@) ( ك ) عن بريدة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7587 ) قال النبي :(@)(@@) | 30 ( إن صاحبكم محبوس بباب الجنة بدين عليه ، إن شئتم فأسلموه إلى عذاب الله ، وإن شئتم ففكوه ) )(@)(@@) ( ط هق ) عن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7588 ) قال النبي :(@)(@@) | 30 ( إن صاحبكم تغسله الملائكة ) يعني حنظلة بن أبي عامر رضي الله عنه ( ك هق ) عن ي| حيى بن عباد بن عبد الله بن الزبير عن أبيه عن جده ( حل 