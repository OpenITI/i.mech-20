ms341	 الأسدي الكوفي " ق " وفي " تعق " في النقد يمكن اتحاده مع الذي بعيده يعني ابن عبد الله، وهو بعيد. أقول: وفي الحاوي احتمل الاتحاد، وفي المجمع جزم به.(@)(@@)(@@)(@@) $ 4027 - زحر بن مالك أبو زياد الغنوي، مولاهم الكوفي " ق ".(@)(@@)(@@)(@@) $ 4028 - زحر بن النعمان الأسدي أبو الخطاب، مولى كوفي " ق ".(@)(@@)(@@)(@@) $ 4029 - زرارة بن لطيفة أبو عامر الحضرمي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4030 - زرعة بن حميد الحارثي كوفي " ق ".(@)(@@)(@@)(@@) $ 4031 - زرعة بن محمد أبو محمد الحضرمي، ثقة، روى عن " ق " و " ظم " PageV01P462(@)(@@) عليهما السلام وكان صحب سماعة وأكثر عنه ووقف له، يروي عنه يعقوب بن يزيد، والحسن بن سعيد، وعبد الله بن محمد، وفي رواية تكذيبه الا أن في سنده ابن قياما.(@)(@@)(@@)(@@) $ 4032 - زريق بن مرزوق، له كتاب، عنه إبراهيم بن سليمان " ست " تقدم عن " صه " " جش " في عنوان الراء أولا ثم الزاي، كما أنه هنا بالعكس، ولكن الرجل واحد.(@)(@@)(@@)(@@) $ 4033 - زفر بن سويد الجعفي مولاهم " ق ".(@)(@@)(@@)(@@) $ 4034 - زفر بن عبد الله الأيادي، من رجال " ق " عليه السلام كوفي عامي " صه " قيل: وكأنه أخو زافر المتقدم، وهو غير بعيد لاتحادهما فيما ذكر من الأب والأوصاف، وحينئذ لا يبعد الاتحاد بوقوع التحريف.(@)(@@)(@@)(@@) $ 4035 - زفر بن النعمان أبو الأزهر العجلي كوفي " ق ".(@)(@@)(@@)(@@) $ 4036 - زفر بن الهذيل أبو الهذيل التميمي العنبري الكوفي " ق " وفي " قي " كوفي عامي، فهو مردود الرواية اجتهادا أيضا.(@)(@@)(@@)(@@) $ 4037 - زكار بن سلمة الهمداني، مولاهم كوفي " ق ".(@)(@@)(@@)(@@) $ 4038 - زكار بن مالك الكوفي أبو عبد الله " ق ".(@)(@@)(@@)(@@) $ 4039 - زكريا بن إبراهيم الأزدي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4040 - زكريا بن إبراهيم الخيري الكوفي " ق ".(@)(@@)(@@)(@@) $ 4041 - زكريا أبو يحيى الدعاء الخياط الكوفي " ق ".(@)(@@)(@@)(@@) $ 4042 - زكريا أبو يحيى (1) كوكب الدم " ق " و " غض " كوفي ضعيف، روى عن " ق " عليه السلام وفي خبر عن يونس قال أبو يحيى الموصلي: لقبه كوكب الدم كان شيخا من الأخيار و " قر " عليه السلام سأل الله أن يجزيه خيرا، وابن علي بن بقطين له فضل ودين.(@)(@@) PageV01P463(@)(@@)(@@)(@@) $ 4043 - زكريا بن أبي طلحة الكوفي " ق ".(@)(@@)(@@)(@@) $ 4044 - زكريا بن إدريس 
ms342	 القمي " ق " يكنى أبا جرير، وفي " جش " أنه روى عن " ق " و " ظم " و " ضا " عليهم السلام له كتاب قاله سعد، وفي " صه " كان وجها، ويأتي في الكنى ترحم الرضا عليه السلام عليه، والظاهر أنه في السابقة بل فيها أولى.(@)(@@)(@@)(@@) $ 4045 - زكريا بن إسحاق المكي " ق ".(@)(@@)(@@)(@@) $ 4046 - زكريا بن الحر الجعفي أخو أديم وأيوب، روى عن " ق " عليه السلام " جش " له كتاب فيه و " ست " وفيهما و " لم " حميد عن محمد بن موسى خورا عنه، وفي " د " كان وجها.(@)(@@)(@@)(@@) $ 4047 - زكريا بن الحسن الواسطي " ق ".(@)(@@)(@@)(@@) $ 4048 - زكريا بن سابق، جعفر وفضالة عن أبي الصباح عن ابن سابق، قال: وصفت الأئمة عليهم السلام للصادق عليه السلام حتى انتهت إلى الباقر عليه السلام فقال: حسبك قد ثبت الله لسانك وهدي قلبك " كش " وفيما نقل عنه " صه " ابن الصباح وإسحاق أبوه.(@)(@@)(@@)(@@) $ 4049 - زكريا بن سابور الأزدي ثقة " صه " " جش " روى معد عن ابن يسار بعد ذكر الوسائط أنه حضر أحد ابني سابور وكان لهما ورع واخبات، فمرض أحدهما ولا أحسبه الا زكريا، قال: فحضرته عنه موته فبسط يده ثم قال: ابيضت يديي يا علي، ثم أخبرت الصادق عليه السلام بذلك فقال: رآه والله مكررا.(@)(@@)(@@)(@@) $ 4050 - زكريا بن سوادة أبو يحيى البارقي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4051 - زكريا صاحب السابري، روى عنه ابن أبي عمير " تعق " وفي روايته عنه دليل على الوثاقة.(@)(@@)(@@)(@@) $ 4052 - زكريا بن عبد الله بن يزيد النخعي الصهباني الكوفي " ق ".(@)(@@)(@@)(@@) $ 4053 - زكريا بن مالك الجعفي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4054 - زكريا بن محمد أبو عبد الله المؤمن، روى عن " ق " و " ظم " عليهما السلام ولقى " ضا " عليه السلام في المسجد الحرام، وحكى عنه ما يدل على أنه كان PageV01P464(@)(@@) واقفا ومختلط الامر في حديثه " جش " " صه " عنه ابن عيسى محمد " ست ".(@)(@@)(@@)(@@) $ 4055 - زكريا بن ميسرة الكوفي " ق ".(@)(@@)(@@)(@@) $ 4056 - زكريا بن ميمون الأزدي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4057 - زكريا بن يحيى الحضرمي الكوفي، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 4058 - زكريا بن يحيى الكلابي الجعفري كوفي " ق ".(@)(@@)(@@)(@@) $ 4059 - زكريا بن يحيى، وكان 
ms343	 يحيى نصرانيا " ق ".(@)(@@)(@@)(@@) $ 4060 - زكريا بن يحيى النهدي، مولاهم كوفي " ق ".(@)(@@)(@@)(@@) $ 4061 - زكريا بن يحيى الواسطي، ثقة روى عن " ق " عليه السلام ذكره ابن نوح " صه " " جش " والذي في " ق " و " ست " زكار، وقد تقدم، وفي " مشكا " ابن يحيى الواسطي عنه إبراهيم بن محمد بن إسماعيل.(@)(@@)(@@)(@@) $ 4062 - زواد الكوفي " ق " لم أقف على نسبه ووصفه لا يعتمد عليه.(@)(@@)(@@)(@@) $ 4063 - زويد الفساطيطي الكوفي " ق " وهو كسابقه مجهول النسب والوصف.(@)(@@)(@@)(@@) $ 4064 - زهرة بن حوية التميمي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4065 - زهير بن محمد الخراساني أبو المنذر، سكن البصرة وفي نسخة مكة، أسند عنه " ق " له كتاب الأشربة، عنه ابن عياش القطان " ست " وعنه حماد بن عيسى.(@)(@@)(@@)(@@) $ 4066 - زهير بن معاوية أبو خيثمة الجعفي " ق " وفي " قب " ثقة ثبت نزيل الجزيرة، مات سنة ثلاث أو أربع وسبعين بعد المائة، مولده سنة مائة.(@)(@@)(@@)(@@) $ 4067 - زياد بن أبي إسماعيل الكوفي، شريك حفص الأعور " ق " والظاهر منه كونه شريكا له في المال ويحتمل في الصنعة، والله أعلم.(@)(@@)(@@)(@@) $ 4068 - زياد بن أبي الحلال الكوفي " ق " كوفي مولى ثقة، روى عن " ق " عليه السلام " صه " " جش " عنه القاسم بن إسماعيل " ست " محمد بن الوليد عنه " جش " فالحديث بملاحظتها عال السند. PageV01P465(@)(@@)(@@)(@@) $ 4069 - زياد بن أبي رجاء " ق " وزاد " صه " بالجيم بعد الراء، واسم أبي رجاء منذر، كوفي ثقة صحيح، وفي " قر " روى عنه أبان، وفي " مشكا " ابن أبي رجاء عنه أبان.(@)(@@)(@@)(@@) $ 4070 - زياد بن أبي غياث مسلم مولى آل وغش بن محارب، روى عن " ق " عليه السلام ذكره عقد وابن نوح، ثقة سليم " صه " " جش " عنه ثابت بن شريح الصائغ الأنباري " ست " والثاني، ويأتي عن " ق " ابن مسلم أبو عتاب، فتأمل.(@)(@@)(@@)(@@) $ 4071 - زياد بن أحمر العجلي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4072 - زياد بن الحسن بن فرات التميمي القزاز " ق ".(@)(@@)(@@)(@@) $ 4073 - زياد بن خيثمة الجعفي الكوفي، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 4074 - زياد بن سابور أخو بسطام، تقدم في عنوانه أنه وسائر اخوانه زكريا وزياد وحفص كلهم ثقات يروون عن الصادق عليه السلام، والله أعلم، وفي 
ms344	 " تعق " مر توثيقه عن " جش " في أخيه بسطام.(@)(@@)(@@)(@@) $ 4075 - زياد بن رجاء، ويأتي في ابن عيسى، وفي " تعق " ويحصل احتمال اتحاده مع ابن رجاء، وسيشير إليه المصنف في الكنى.(@)(@@)(@@)(@@) $ 4076 - زياد بن سعد الخراساني، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 4077 - زياد بن سويد الهلالي، مولاهم كوفي " ق ".(@)(@@)(@@)(@@) $ 4078 - زياد بن صدقة أبو مسكين الكوفي، مولى قريش " ق ".(@)(@@)(@@)(@@) $ 4079 - زياد بن عبد الرحمن العنزي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4080 - زياد بن عبد الرحمن الهلالي، مولاهم كوفي " ق ".(@)(@@)(@@)(@@) $ 4081 - زياد بن عمارة الطائي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4082 - زياد بن عيسى الكوفي بياع السابري " ق ".(@)(@@)(@@)(@@) $ 4083 - زياد بن عيسى أبو عبيدة الحذاء، كوفي ثقة، روى عنهما وحمادة بنت رجاء. وقيل: بنت الحسن روت عن الصادق عليه السلام، وقيل فيه: انه زياد بن أبي رجاء واسمه منذر، وقيل: ابن أحزم، وفي " مشكا " عنه ابن رئاب، وابن عثمان، وأبناء مسكان ورزين، والحكم، وصالح، والأحول، والخزاز. PageV01P466(@)(@@)(@@)(@@) $ 4084 - زياد الكوفي الخياط " ق " لم أقف على نسبه، مضافا إلى وصفه المفيد لقبول حديثه، فلا يعبأ بما تفرد به، والله العالم.(@)(@@)(@@)(@@) $ 4085 - زياد بن مروان القندي الأنباري أبو الفضل " ق " واقفي مولى بني هاشم، روى عن " ق " و " ظم " عليهما السلام ووقف في " ضا " عليه السلام، في الكافي أنه سمع النص عن " ظم " عليه السلام على الرضا عليه السلام وأظهره ثم خالفه.(@)(@@)(@@)(@@) $ 4086 - زياد بن موسى الأسدي، مولاهم الكوفي " ق ".(@)(@@)(@@)(@@) $ 4087 - زياد بن مسلم أبو عتاب الكوفي " ق " وفي " تعق " مر في ترجمة ابن أبي غياث، أقول: قد مضى أنه ثقة.(@)(@@)(@@)(@@) $ 4088 - زياد بن فضالة الكلبي مولاهم " ق " ويحتمل كونه زيد، والله أعلم.(@)(@@)(@@)(@@) $ 4089 - زياد بن يحيى التميمي الحنظلي " ق " " قي ".(@)(@@)(@@)(@@) $ 4090 - زياد بن يحيى الكوفي " ق ".(@)(@@)(@@)(@@) $ 4091 - زيد بن أبي الحلال المزني كوفي " ق ".(@)(@@)(@@)(@@) $ 4092 - زيد الأسدي " ق " لم أقف على غير العنوان لا يعبأ به، ولعله زيد بن سعيد الأسدي الآتي عن " ق " أو ابن صالح الأسدي الآتي عنه.(@)(@@)(@@)(@@) $ 4093 - زيد بن بكير بن الحسن الكوفي " ق ".(@)(@@)(@@)(@@) $ 4094 - زيد بن بكير السلمي 
ms345	 " ق ".(@)(@@)(@@)(@@) $ 4095 - زيد بن بيان التغلبي كوفي " ق ".(@)(@@)(@@)(@@) $ 4096 - زيد بن جهيم الهلالي كوفي " ق " ثم زيد بن جهيم الكوفي، والظاهر الاتحاد.(@)(@@)(@@)(@@) $ 4097 - زيد بن الحسن الأنماطي أخو أبي الديداء، أسند عنه " ق " ثم زيد بن الحسن الأنماطي، أسند عنه " ق " وكأنه هو الأول.(@)(@@)(@@)(@@) $ 4098 - زيد الخباز كان يبيع الخبز كوفي " ق " لم أظفر على ما يوجب قبول روايته، وكونه بايعا للخبز لعله يشعر لوهنه، فان الغالب في ذوي الميزان الفسق فهم المطففون. PageV01P467(@)(@@)(@@)(@@) $ 4099 - زيد الزراد كوفي، روى عن الصادق عليه السلام، له كتاب، محمد بن عيسى عن ابن أبي عمير عنه " جش " وفي روايته تنبيه على وثاقة الرجل.(@)(@@)(@@)(@@) $ 4100 - زيد السراج الكوفي " ق ".(@)(@@)(@@)(@@) $ 4101 - زيد بن سعيد الأسدي " ق ".(@)(@@)(@@)(@@) $ 4102 - زيد بن سوقة البجلي، مولى جرير بن عبد الله أبو الحسن كوفي " ق ".(@)(@@)(@@)(@@) $ 4103 - زيد بن سويد الأنصاري الحارثي " ق " وهو كسوابقه مجهول الحال.(@)(@@)(@@)(@@) $ 4104 - زيد بن سيف القيسي البكري الكوفي " ق ".(@)(@@)(@@)(@@) $ 4105 - زيد بن صالح الأسدي " ق ".(@)(@@)(@@)(@@) $ 4106 - زيد بن عاصم بن المهاجر الناعظي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4107 - زيد بن عبد الرحمن الأسدي الكوفي " ق " ويحتمل كونه الموصوف بالأسدي.(@)(@@)(@@)(@@) $ 4108 - زيد بن عبد الله الخياط، روى عنه أبان يكنى أبا حكيم كوفي جمحي وأصله مدني ثقة " صه " " ق ".(@)(@@)(@@)(@@) $ 4109 - زيد بن عبيد الأزدي الغامدي مولاهم كوفي " ق ".(@)(@@)(@@)(@@) $ 4110 - زيد بن عبيد الكناسي " ق ".(@)(@@)(@@)(@@) $ 4111 - زيد بن عطاء بن السائب الثقفي كوفي " ق " وفي " تعق " يأتي ابن محمد بن عطاء بن السائب، فلاحظ.(@)(@@)(@@)(@@) $ 4112 - زيد بن عطية السلمي الكوفي تابعي " ق ".(@)(@@)(@@)(@@) $ 4113 - زيد بن عياض الكناني الكوفي " ق ".(@)(@@)(@@)(@@) $ 4114 - زيد بن محمد بن عطاء بن السائب الثقفي، أسند عنه " ق " وكأنه ابن عطاء الثقفي الكوفي، فتدبر.(@)(@@)(@@)(@@) $ 4115 - زيد بن المستهل بن الكميت الأسدي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4116 - زيد النرسي، روى عن " ق " و " ظم " عليهما السلام، له كتاب يرويه PageV01P468(@)(@@) جماعة، منهم ابن أبي عمير " جش " والرجل وان لم نجد له تصريحا بتوثيقه الا أن رواية ابن أبي عمير كافية في الوثاقة 
ms346	 أو الاعتماد عليه.(@)(@@)(@@)(@@) $ 4117 - الزبرقان البصري يكنى أبا محمد " ق " وكانه بالباء الموحدة.(@)(@@)(@@)(@@) $ 4118 - سالم أبو رافع مولى أبان كوفي " ق " والمراد منه ابن عثمان الناووسي.(@)(@@)(@@)(@@) $ 4119 - سالم بن أبي واصل، وهو سالم بن شريح الآتي " تعق ".(@)(@@)(@@)(@@) $ 4120 - سالم بن الأشجعي، هو سلمة بن شريح، كما يظهر من ترجمة ابنه محمد بن سالم، أو ابن أبي الجعد المذكور " تعق " أقول: فعلى الأول يكون في هذه الطبقة، وعلى الثاني في الطبقات الآتية.(@)(@@)(@@)(@@) $ 4121 - سالم البزاز، وفي نسخة البراد الكوفي " ق ".(@)(@@)(@@)(@@) $ 4122 - سالم الحذاء، هو سلمة بن شريح، كما يظهر من ترجمة ابنه محمد " تعق ".(@)(@@)(@@)(@@) $ 4123 - سالم الخياط، كوفي ثقة يكنى أبا الفضل، روى عن " ق " كما ذكره ابن نوح، روى عنه عاصم بن حميد، وإسحاق بن عمار، و في " ق " سلم أبو الفضل الكوفي الحناط، ثم سلم أبو الفضل الخياط، وقيل: سالم، والتعدد أظهر.(@)(@@)(@@)(@@) $ 4124 - سالم بن سعيد الكوفي " ق ".(@)(@@)(@@)(@@) $ 4125 - سالم بن سلمة أبو خديجة الرواجني الكوفي مولى " ق " وفي " د " " ق " " جخ " مهمل " كش " ثقة ثقة. والظاهر بل المقطوع أن هذا غير ابن مكرم، والتوثيق في " كش " و " جش " له فارجاعه إليه مع الاختلاف فاسد.(@)(@@)(@@)(@@) $ 4126 - سالم بن شريح هو سلم، كما يظهر من ترجمة ابنه محمد، ومر في الفوائد الإشارة إلى أمثال " تعق ".(@)(@@)(@@)(@@) $ 4127 - سالم بن عبد الرحمن الأشهل، أسند عنه " ق " وثقه " صه " في ابنه عبد الرحمن كما يأتي، روى عن " قر " و " ق " عليهما السلام فهو أيضا في التالية.(@)(@@)(@@)(@@) $ 4128 - سالم بن عبد الله أبو محمد الحناط الكوفي " ق ".(@)(@@)(@@)(@@) $ 4129 - سالم بن عبد الله الأزدي الجصاص الكوفي " ق ". PageV01P469(@)(@@)(@@)(@@) $ 4130 - سالم بن عبد الواحد المرادي الأنعمي بضم العين المهملة أبو العلاء الكوفي، وكان شيعيا من السادسة، فتأمل، كذا في المنتهى.(@)(@@)(@@)(@@) $ 4131 - سالم العطار خادم " ق " عليه السلام " د ".(@)(@@)(@@)(@@) $ 4132 - سالم بن عطية أبو عبد الله مولى لبني هلال كوفي " ق ".(@)(@@)(@@)(@@) $ 4133 - سالم بن عمار الصايدي الهمداني الكوفي " ق ".(@)(@@)(@@)(@@) $ 4134 - سالم بن مكرم بن عبد الله أبو خديجة، 
ms347	 ويقال: أبو سلمة الكناسي صاحب الغنم الجمال، ثقة ثقة، روى عن " ق " و " ظم " عليهما السلام، له كتاب، عنه الحسن بن الوشاء مع واسطة ابن عائذ أو بدونها، الا أن الشيخ ضعفه.(@)(@@)(@@)(@@) $ 4135 - السائب بن عمارة الحضرمي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4136 - السائب مولى " ق " لم أجد غيره فلا اعتداد بحديثه كنظرائه.(@)(@@)(@@)(@@) $ 4137 - السائب مولى حسين بن عبد الله الكوفي " ق ".(@)(@@)(@@)(@@) $ 4138 - سحيم السندي، وفي نسخة السعدي " ق ".(@)(@@)(@@)(@@) $ 4139 - السري بن حيان الأزدي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4140 - السري بن خالد الناجي " ق " وفي " تعق " يروي عنه صفوان بن يحيى.(@)(@@)(@@)(@@) $ 4141 - السري بن عاصم، له كتاب الديباج، عنه أبو بكر أحمد بن منصور " ست ".(@)(@@)(@@)(@@) $ 4142 - السري ملعون " صه " كما يأتي في الألقاب، وقيل: يأتي في الكنى وهو سهو لا يخفى.(@)(@@)(@@)(@@) $ 4143 - السري بن عبد الله السلمي، كوفي ثقة روى عن " ق " عليه السلام ذكره أصحابنا في الرجال " صه " " جش " روى عنه حسن بن الحسين العرني، ومحمد بن يزيد الخزاعي، وعباد بن يعقوب " جش ".(@)(@@)(@@)(@@) $ 4144 - السري بن عبد الله الهمداني الكوفي " ق ".(@)(@@)(@@)(@@) $ 4145 - سعاد بن سليمان التميمي الحماني الكوفي " ق " وفي " قب " سعاد بفتح PageV01P470(@)(@@) الهمزة والتشديد ابن سليمان الجعفي، ويقال في نسبه غير ذلك كوفي صدوق، وكان شيعيا من الثمانية.(@)(@@)(@@)(@@) $ 4146 - سعاد بن عمران الكلبي كوفي " ق ".(@)(@@)(@@)(@@) $ 4147 - سعد بن إبراهيم بن عبد الرحمن بن عوف الزهري المدني " ق ".(@)(@@)(@@)(@@) $ 4148 - سعد بن أبي خلف الزهري مولاهم كوفي " ق " وفي " ظم " و " جش " ثقة يعرف بالزام روى عنهما عليهما السلام له أصل، عنه الحسن بن محبوب، وابن أبي عمير، وأحمد بن ميثم، والأخير عال السند.(@)(@@)(@@)(@@) $ 4149 - سعد بن أبي عمرو الجلاب، أو ابن عمر بدون الواو، كوفي في أصحاب " ق " عليه السلام وكأنه أيضا في أصحاب " قر " عليه السلام، وفي " تعق " يروي عنه ابن أبي عمير.(@)(@@)(@@)(@@) $ 4150 - سعد بن بكير في " يب " في الصحيح عن ابن أبي عمير عن حبيب الخثعمي " تعق ".(@)(@@)(@@)(@@) $ 4151 - سعد بياع السابري، روى عنه حماد بن عثمان، وروى عن أبي عبد الله 
ms348	 " تعق ".(@)(@@)(@@)(@@) $ 4152 - سعد الزام هو ابن أبي خلف " تعق ".(@)(@@)(@@)(@@) $ 4153 - سعد بن سيار كوفي " ق ".(@)(@@)(@@)(@@) $ 4154 - سعد بن الصلت البجلي القاضي مولى " ق ".(@)(@@)(@@)(@@) $ 4155 - سعد بن طالب أبو غيلان الشيباني الكوفي " ق ".(@)(@@)(@@)(@@) $ 4156 - سعد بن عمير الطائي السنبسي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4157 - سعد بن محمد الطاطري أبو القاسم، عم علي بن الحسن، روى عنه، وفيه اشعار بوثاقته، لما يأتي في ترجمته، وفي العمدة أن الطائفة عملت بما رواه الطاطريون " تعق ".(@)(@@)(@@)(@@) $ 4158 - سعد والد جعفر بن سعد الأسدي " ق ".(@)(@@)(@@)(@@) $ 4159 - سعد بن هاشم الأرحبي الهمداني كوفي " ق ". PageV01P471(@)(@@)(@@)(@@) $ 4160 - سعد بن يزيد أبو مجاهد أو أبو محامد كما في نسخة الطائي مولاهم كوفي " ق ".(@)(@@)(@@)(@@) $ 4161 - سعد بن يزيد الفزاري، مولاهم كوفي جعفري " ق ".(@)(@@)(@@)(@@) $ 4162 - سعدان بن عمران الطائي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4163 - سعدان المزني الكوفي " ق ".(@)(@@)(@@)(@@) $ 4164 - سعدان بن مسلم أبو الحسن العامري الكوفي، مولى أبي العلاء، كرزين بن جعيد العامري، روى عن " ق " و " ظم " عليهما السلام وعمر عمرا طويلا، له أصل، عنه محمد بن عذافر، وصفوان، وابن معروف، وابن الصلت القمي، وأحمد بن إسحاق، وابن عيسى.(@)(@@)(@@)(@@) $ 4165 - سعدان بن واصل الأزدي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4166 - سعيد أبو عمارة، مولى آل خيثم الهلالي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4167 - سعيد بن أبي الأسود الكوفي " ق ".(@)(@@)(@@)(@@) $ 4168 - سعيد بن أبي الأصبغ الكوفي " ق ".(@)(@@)(@@)(@@) $ 4169 - سعيد بن أبي الجهم القابوسي اللخمي، من ولد قابوس بن النعمان بن المنذر، كان ثقة في حديثه وجها بالكوفة، روى عن أبان، وروى عن " ق " و " ظم " عليهما السلام، له كتاب في أنواع الفقه، عنه الحسين بن سعيد " جش " وهو في السابقة.(@)(@@)(@@)(@@) $ 4170 - سعيد بن أبي حماد الأزدي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4171 - سعيد بن أبي حازم أبو حازم الأحمسي، عنه أبان " ق ".(@)(@@)(@@)(@@) $ 4172 - سعيد بن أبي الخضيب البجلي " ق ".(@)(@@)(@@)(@@) $ 4173 - سعيد بن أبي نصر السكوني، مولاهم كوفي " ق ".(@)(@@)(@@)(@@) $ 4174 - سعيد بن أبي هلال المدني، قدم مصر " ق ".(@)(@@)(@@)(@@) $ 4175 - سعيد الأعرج له أصل، عنه علي بن النعمان، وصفوان بن يحيى " ست " ويأتي عن " صه " و " جش 
ms349	 " ابن عبد الرحمن، وفي " كش " حديث يدل على كونه زيديا، والظاهر اتحاده معه، إذ في " ست " يروي عنه صفوان، وفي " جش " ذلك في ابن PageV01P472(@)(@@) عبد الرحمن، وله قرائن أخر.(@)(@@)(@@)(@@) $ 4176 - سعيد بن بيان أبو حنيفة سابق الحاج " ق " الهمداني، ثقة، روى عن " ق " عليه السلام " صه " " جش " له كتاب، عنه عبيس في الثاني، الا أنه روى " كش " حديثان يدلان على ذمه لا مجال لذكرهما، ففي أحدهما أنه خاسر الحاج.(@)(@@)(@@)(@@) $ 4177 - سعيد بن الجمحي المكي " ق " ثم ابن عبد الرحمن المكي أيضا، وظاهره التغاير، وظاهر البعض الاتحاد، فتأمل.(@)(@@)(@@)(@@) $ 4178 - سعيد بن الحسن أبو عمرو العبسي، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 4179 - سعيد بن حكيم أبو زيد العبيسي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4180 - سعيد الرومي مولى " ق " عليه السلام روى عنه حماد بن أبان " ق ".(@)(@@)(@@)(@@) $ 4181 - سعيد بن زفير البزاز الكوفي " ق ".(@)(@@)(@@)(@@) $ 4182 - سعيد بن سالم الأزدي مولاهم كوفي " ق ".(@)(@@)(@@)(@@) $ 4183 - سعيد بن سالم القداح المكي " ق ".(@)(@@)(@@)(@@) $ 4184 - سعيد بن سعيد الجرجاني " ق ".(@)(@@)(@@)(@@) $ 4185 - سعيد بن سفيان الأسلمي المدني " ق ".(@)(@@)(@@)(@@) $ 4186 - سعيد السمان هو الأعرج، وهو ابن عبد الرحمن " تعق ".(@)(@@)(@@)(@@) $ 4187 - سعيد بن شيبان، مولى أشيم كوفي " ق ".(@)(@@)(@@)(@@) $ 4188 - سعيد بن طريف التميمي الحنظلي، مولى كوفي " ق " في نسخة، قال الميرزا: والظاهر سعد فان صح فهو أخوه، ويأتي في التالية سعد بن طريف.(@)(@@)(@@)(@@) $ 4189 - سعيد بن عبد الجبار الزبيدي الحمقي " ق ".(@)(@@)(@@)(@@) $ 4190 - سعيد بن عبد الرحمن أو ابن عبد الله الأعرج السمان أبو عبد الله التميمي، مولاهم كوفي ثقة، روى عن " ق " عليه السلام ذكره عقد وابن نوح، له كتاب، عنه صفوان " جش ".(@)(@@)(@@)(@@) $ 4191 - سعيد بن عبد الله، مولى بني هاشم الكوفي " ق ".(@)(@@)(@@)(@@) $ 4192 - سعيد بن عبيد السمان الكوفي " ق " وليس هو ابن عبد الرحمن، أو PageV01P473(@)(@@) ابن عبد الله الأعرج السمان.(@)(@@)(@@)(@@) $ 4193 - سعيد بن عطارد الكوفي ويقال له: ابن أبي عطارد " ق ".(@)(@@)(@@)(@@) $ 4194 - سعيد بن عفير الأزدي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4195 - سعيد بن عمر الجعفي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4196 - سعيد بن غزوان الأسدي، مولاهم أخو فضيل، روى عن 
ms350	 " ق " ثقة، وابنه محمد بن سعيد بن غزوان روى أيضا " جش " له أصل " ست " له كتاب، عنه ابن أبي عمير فيهما، وفيه تأييد آخر للتوثيق.(@)(@@)(@@)(@@) $ 4197 - سعيد بن فماذين المكي " ق " أبوه بفتح الفاء مع تشديد الميم وبعده ألف ثم دال معجمة بعدها ياء ونون أخيرا.(@)(@@)(@@)(@@) $ 4198 - سعيد بن قيس الهمداني الصائدي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4199 - سعيد بن لقمان الكوفي " ق ".(@)(@@)(@@)(@@) $ 4200 - سعيد بن محمد بن عبد الرحمن الأنصاري المدني، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 4201 - سعيد بن مسلمة، له أصل " ست " كوفي " جش " عنه ابن أبي عمير فيهما، وفي " مشكا " ابن مسلمة الكوفي، عنه ابن أبي عمير، والفارق القرينة.(@)(@@)(@@)(@@) $ 4202 - سعيد بن مسلمة بن هشام بن عبد الملك بن مروان الدمشقي " ق ".(@)(@@) وعن ظاهر البعض اتحادهما والتغاير أظهر، وعلى الاتحاد معروف وعلى التغاير " م " كما لا يخفى.(@)(@@)(@@)(@@) $ 4203 - سعيد بن منصور زيدي " صه " وفي " كش " حمدوية عن أيوب عن حنان بن سدير قال: كنت جالسا عند الحسن بن الحسن عليه السلام فجاء سعيد بن منصور وكان من رؤساء الزيدية الحديث.(@)(@@)(@@)(@@) $ 4204 - سعيد بن هلال الثقفي كوفي " ق ".(@)(@@)(@@)(@@) $ 4205 - سعيد بن هلال بن جابان أحسبه مولى لبني أسد، وله اخوة عبد الله وإبراهيم وسليمان " ق ".(@)(@@)(@@)(@@) $ 4206 - سعيد بن هلال الدمشقي الكوفي " ق ". PageV01P474(@)(@@)(@@)(@@) $ 4207 - سعيد بن هلال بن عمرو الأزدي، كوفي أبو سعد " ق ".(@)(@@)(@@)(@@) $ 4208 - سعيد بن يحيى، أبو عمرو البزاز القطعي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4209 - سعيد بن يحيى الهمداني الشاكري الكوفي " ق ".(@)(@@)(@@)(@@) $ 4210 - سعيد بن يسار الضبعي، مولاهم كوفي " ق " " جش " " صه " الحناط.(@)(@@) روى عن " ق " و " ظم " عليهما السلام، ثقة له كتاب، عنه عدة منهم محمد بن أبي حمزة وعلي بن النعمان، وصفوان بن يحيى.(@)(@@)(@@)(@@) $ 4211 - سعير أبو مالك " ق ".(@)(@@)(@@)(@@) $ 4212 - سعير بن الخمس التميمي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4213 - سعير بن خليف المدني الكوفي " ق ".(@)(@@)(@@)(@@) $ 4214 - سفيان بن إبراهيم بن مزيد الأزدي الجريري، مولى كوفي " ق " ويحتمل الجد بالثاء المثلثة.(@)(@@)(@@)(@@) $ 4215 - سفيان الثوري، ليس من أصحابنا " صه " " د " وهو سفيان بن سعيد كما يأتي. 
ms351	 والظاهر أنه غير ابن عيينة كما يظهر منهما، وقد صرح به " طس " فقال: أما سفيان بن عيينة وسفيان الثوري، فحالهما ظاهر في كونهما ليسا من عدادنا.(@)(@@)(@@)(@@) $ 4216 - سفيان بن حسان الهمداني الكوفي " ق ".(@)(@@)(@@)(@@) $ 4217 - سفيان بن خالد الأزدي المعني " ق " وبنو معن طائفة، وفي بعض النسخ الأسدي بدل الأزدي.(@)(@@)(@@)(@@) $ 4218 - سفيان بن خالد الأسدي الكوفي، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 4219 - سفيان بن سعيد العبدي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4220 - سفيان بن سعيد بن مسروق أبو عبد الله الثوري، أسند عنه " ق " وفي " كش " أن سفيان الثوري دخل على الصادق عليه السلام وعليه ثياب جياد، فقال: ان آبائك لم يكونوا يلبسون هذه الثياب، فقال: أن آبائي يلبسون الحديث (1).(@)(@@) PageV01P475(@)(@@)(@@)(@@) $ 4221 - سفيان بن السمط البجلي الكوفي، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 4222 - سفيان بن صالح، له أصل " ست " عنه ابن أبي عمير فيه وفي " جش " وفي سندهما ابن بطة، وفيه كلام.(@)(@@)(@@)(@@) $ 4223 - سفيان بن عبد الرحمن، مولى بني هاشم الكوفي " ق ".(@)(@@)(@@)(@@) $ 4224 - سفيان بن عبد الملك الجعفي مولاهم كوفي " ق ".(@)(@@)(@@)(@@) $ 4225 - سفيان بن عطية الثقفي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4226 - سفيان بن عطية المرهبي الهمداني " ق ".(@)(@@)(@@)(@@) $ 4227 - سفيان بن عطية المزني " ق ".(@)(@@)(@@)(@@) $ 4228 - سفيان بن عماره الأزدي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4229 - سفيان بن عمارة الطائي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4230 - سفيان بن عيينة ليس من أصحابنا ولا من عدادنا " صه " " د " ابن عيينة ابن أبي عمران مولى الهلالي أبو محمد الكوفي أقام بمكة " ق " كان جده أبو عمران عاملا من عمال خالد القسري، عنه محمد بن عبد الرحمن " جش ".(@)(@@)(@@)(@@) $ 4231 - سفيان بن مالك الكوفي " ق ".(@)(@@)(@@)(@@) $ 4232 - سفيان بن مصعب العبدي الشاعر كوفي " ق " وقد ورد عن " ق " عليه السلام حديثان مشعران بل دال أحدهما على تدينه، فقال: عليه السلام: يا معشر الشيعة علموا أولادكم شعر العبدي، فإنه على دين الله، قيل: إنه من الطيارة (1).(@)(@@)(@@)(@@) $ 4233 - سفيان بن وردان الأسدي الكوفي " ق ".(@)(@@) - سكرة الجمال الكوفي.(@)(@@)(@@)(@@) $ 4234 - سكن بن أبي رباط الجعفي مولاهم " ق " وعن نسخة سكين بالياء المثناة من تحت ابن أبي فاطمة كما 
ms352	 يأتي، واستظهره في التلخيص.(@)(@@) PageV01P476(@)(@@)(@@)(@@) $ 4235 - سكن الجمال الكوفي " ق ".(@)(@@)(@@)(@@) $ 4236 - سكن بن عمارة الجعفي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4237 - سكن بن يحيى الأسدي مولاهم كوفي " ق ".(@)(@@)(@@)(@@) $ 4238 - سكين بن أبي فاطمة مولاهم كوفي " ق " " د " وقال الميرزا: فهذه نسخة هي الظاهرة.(@)(@@)(@@)(@@) $ 4239 - سكين بن إسحاق النخعي الكوفي " ق " وفي " د " أنه النخعي الآتي، واستظهره الميرزا.(@)(@@)(@@)(@@) $ 4240 - سكين بن عبد ربه المحاربي الكوفي مولاهم " ق ".(@)(@@)(@@)(@@) $ 4241 - سكين بن عبد العزيز النصري " ق " قيل: وهو سكين بن أبي الفرات صدوق، روى عن الضعفاء من السابعة.(@)(@@)(@@)(@@) $ 4242 - سكين بن عماد أبو محمد الثقفي الرحال، مولاهم كوفي " ق " وفي " تعق " يأتي ذكره في ابنه محمد عن " جش " فلاحظ. أقول: وفي كثير من النسخ ابن عمارة ويأتي بعيد ذلك.(@)(@@)(@@)(@@) $ 4243 - سكين بن عمارة أبو محمد الثقفي الرحال مولاهم كوفي " ق " (@)(@@)(@@)(@@) $ 4244 - سكين بن فضالة الأزدي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4245 - سكين النخعي، قد ذكر " كش " عن معد حديثا يدل على كمال ورعه وتقواه، وهو طويل لا مجال لذكره، والظاهر أنه في السابقة، إذ ظاهر الحديث أنه من رجال " ظم " عليه السلام، كما لا يخفى.(@)(@@)(@@)(@@) $ 4246 - سلام أبو سلمة الأزدي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4247 - سلام الحجام " ق " لا يعتد به كنظرائه.(@)(@@)(@@)(@@) $ 4248 - سلام بن سعيد المخزومي المكي مولى عطار، أسند عنه " ق " وفي " تعق " يظهر من بعض روايات الكافي كونه من الشيعة.(@)(@@)(@@)(@@) $ 4249 - سلام بن سلمة الخثعمي الكوفي " ق " وعن نسخة ابن مسلم.(@)(@@)(@@)(@@) $ 4250 - سلام بن سهم الفقيه، محمد بن إسماعيل، عن سلام بن سهم الشيخ PageV01P477(@)(@@) المتعبد أنه سمع أبا عبد الله عليه السلام. والظاهر أنه ابن بزيع، والسند إليه صحيح، فليتدبر، هكذا في التلخيص.(@)(@@)(@@)(@@) $ 4251 - سلام بن عمرو، له كتاب أخبرنا به جماعة عن التلعكبري عن عقد عن القاسم بن محمد بن الحسين بن حازم عن عبد الله بن جبلة عن سلام بن عمرو " ست " وفي " تعق " أنه ابن عميرة كما أشرنا إليه. أقول: احتمله في النقد أيضا، وهو ابن عميرة الآتي في التالية.(@)(@@)(@@)(@@) $ 4252 - سلام بن غانم الحناط " ق 
ms353	 " واحتمل الشيخ أبو علي اتحاده مع سلام الحناط الآتي في الطبقة الآتية وهو بعيد إذ لم يحتمله غيره.(@)(@@)(@@)(@@) $ 4253 - سلام بن مسلم الخثعمي الكوفي " ق " وعن نسخة ابن سلمة كما مر، ولكن الظاهر أنهما اسمان مغايران، واختلاف النسخ قرينة دالة عليه، والله أعلم.(@)(@@)(@@)(@@) $ 4254 - سلام بن يسار الكوفي " ق ".(@)(@@)(@@)(@@) $ 4255 - سلم بن أبي واصل هو ابن شريح " تعق ".(@)(@@)(@@)(@@) $ 4256 - سلم الحذاء هو ابن شريح " تعق ".(@)(@@)(@@)(@@) $ 4257 - سلم الحناط أبو الفضل، كوفي مولى ثقة، روى عن " ق " عليه السلام ذكره أبو العباس " صه " " جش " الا أن في الأخير سالم كما مر، وأن الراوي عنه عاصم، وفي " ق " سلم أبو الفضيل، ثم سلم أبو الفضل، والتغاير أقوى.(@)(@@)(@@)(@@) $ 4258 - سلم الجواز الكوفي " ق ".(@)(@@)(@@)(@@) $ 4259 - سلم بن سالم البلخي " ق ".(@)(@@)(@@)(@@) $ 4260 - سلم بن سليمان مولى كندة كوفي " ق " وعن نسخة سلمة.(@)(@@)(@@)(@@) $ 4261 - سلم بن شريح الأشجعي الكوفي " ق " وعن نسخة سلمة وفي " تعق " لاحظ ترجمة ابنه محمد بن سالم ستجد ما يناب المقام، ومنه احتمال رجوع التوفيق إليه، وأنه يعبر عنه بسلم وسلمة وابن أبي واصل وابن شريح والأشجعي والحذاء فتأمل.(@)(@@)(@@)(@@) $ 4262 - سلم بن عبد الرحمن العجلي " ق ".(@)(@@)(@@)(@@) $ 4263 - سلم مولى علي بن يقطين، يروي عنه ابن أبي عمير، وفي نسخة PageV01P478(@)(@@) أسلم، ويظهر من رواية في التهذيب في باب الحمام حسنة ومعروفيته " تعق ".(@)(@@)(@@)(@@) $ 4264 - سلمان بن بلال المدني، أسند عنه " ق " وفي " قب " سليمان بن بلال التيمي مولاهم أبو محمد وأبو أيوب المدني، ثقة من الثامنة، مات سنة سبع وسبعين ومائة وفي " هب " ابن بلال مولى آل الصديق ثقة امام، مات سنة اثنين وسبعين ومائة.(@)(@@)(@@)(@@) $ 4265 - سلمان بن حياة الكلابي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4266 - سلمان بن عبيد الحناط الكوفي " ق ".(@)(@@)(@@)(@@) $ 4267 - سلمان بن الفيض، يروي عنه صفوان، وابن أبي عمير " تعق " وفي روايتهما عنه اشعار على الوثاقة بل دليل عليها كما مر غير مرة.(@)(@@)(@@)(@@) $ 4268 - سلمة أبو المستهل الكوفي " ق ".(@)(@@)(@@)(@@) $ 4269 - سلمة بن جناح الكوفي " ق ".(@)(@@)(@@)(@@) $ 4270 - سلمة بن خالد الكوفي " ق ".(@)(@@)(@@)(@@) $ 4271 - سلمة بن 
ms354	 زياد مولى بني أمية كوفي " ق ".(@)(@@)(@@)(@@) $ 4272 - سلمة بن سليمان الهمداني الكوفي " ق ".(@)(@@)(@@)(@@) $ 4273 - سلمة بن شريح، مضى بعنوان سلم " تعق ".(@)(@@)(@@)(@@) $ 4274 - سلمة صاحب السابري، ابن أبي عمير عنه في الصحيح " تعق ".(@)(@@)(@@)(@@) $ 4275 - سلمة بن صالح الأحمر الواسطي، من أصحاب " ق " عليه السلام أصله كوفي مخلط " صه " " جخ ".(@)(@@)(@@)(@@) $ 4276 - سلمة بن صالح بن أرتبيل كوفي " ق ".(@)(@@)(@@)(@@) $ 4277 - سلمة بن عباس البصري، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 4278 - سلمة بن عبد الله بن مراد المرادي " ق ".(@)(@@)(@@)(@@) $ 4279 - سلمة بن عبيدة التميمي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4280 - سلمة بن كلثم الكوفي " ق " في نسخة، وعن أخرى كلثمة.(@)(@@)(@@)(@@) $ 4281 - سلمة بن محمد ثقة " صه " و " جش " أيضا في أخيه منصور، وفي " ست " له كتاب أخبرنا جماعة عن التلعكبري عن ابن همام عن محمد بن أحمد بن PageV01P479(@)(@@) ثابت عن محمد بن بكر بن جناح عنه، وفي " مشكا " ابن محمد الثقة، عنه محمد بن بكر، ويأتي في أخيه أنهما ثقتان.(@)(@@)(@@)(@@) $ 4282 - سلمة بن مهران الكوفي " ق ".(@)(@@)(@@)(@@) $ 4283 - سليم بن عيسى الحنفي المقري مولاهم كوفي " ق ".(@)(@@)(@@)(@@) $ 4284 - سليم الفراء كوفي " ق " روى عن " ق " و " ظم " عليهما السلام ثقة ذكره أصحابنا في الرجال " صه " " جش " له كتاب، عنه جماعة منهم ابن أبي عمير في الثاني، وفي " مشكا " مع زيادة علي بن الحكم الثقة.(@)(@@)(@@)(@@) $ 4285 - سليم مولى طربال كوفي " ق " وفي " مشكا " مولى طربال الراوي عن حريز، عنه القاسم بن محمد، ويأتي في سليمان بعنوانين.(@)(@@)(@@)(@@) $ 4286 - سليم مولى علي بن يقطين، مر بعنوان سلم " تعق ".(@)(@@)(@@)(@@) $ 4287 - سليمان بن بلال " ضا " " جخ " ثقة، وقد مر عن " ق " في سلمان، وهو فيه خال عن التوثيق، وفي " تعق " مر عن المصنف في سلمان أنه في نسخة سليمان بن بلال، وفي النقد لم أجد سليمان بن بلال في " جخ " أصلا، نعم الموجود سلمان. قلت:(@)(@@) الظاهر وجوده الخ أقول: ولعله عامي ببعض التأييدات.(@)(@@)(@@)(@@) $ 4288 - سليمان بن تابع الجملي المرادي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4289 - سليمان بن حياة الكلابي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4290 - سليمان بن داود بن الحصين المدني، أسند 
ms355	 عنه " ق ".(@)(@@)(@@)(@@) $ 4291 - سليمان بن داود المنقري الشاذكوني يكنى أبا أيوب، ثقة على قول " جش " الا انه ليس بالمتحقق بنا، و " غض " ضعفه جدا لا يلتفت إليه، والتوثيق أرجح لتأيده بما في " ضح " و " مشكا " عنه الكاسولا، والحسن بن محمد بن سماعة.(@)(@@)(@@)(@@) $ 4292 - سليمان الديلمي " ق " معد قال علي بن محمد: سليمان الديلمي من الغلاة الكبار " كش " عنه " صه " وفي " ست " سليمان الديلمي له كتاب عنه ابنه محمد، وهو ابن عبد الله كما يأتي عن " جش " ومراد " كش " بهذا أشبه، واحتمل كونه ابن زكريا الآتي. PageV01P480(@)(@@)(@@)(@@) $ 4293 - سليمان بن راشد الكوفي " ق ".(@)(@@)(@@)(@@) $ 4294 - سليمان بن زكريا الديلمي، روى عن " ق " عليه السلام كذاب غال، قال " غض ": ويحتمل كونه ما ذكره " كش " " صه ".(@)(@@)(@@)(@@) $ 4295 - سليمان بن زياد التميمي ذكره " قي " في رجال " ق " عليه السلام.(@)(@@)(@@)(@@) $ 4296 - سليمان بن سلمة الدالاني الكوفي " ق ".(@)(@@)(@@)(@@) $ 4297 - سليمان بن سويد الجعفي، أسند عنه كوفي " ق ".(@)(@@)(@@)(@@) $ 4298 - سليمان بن سويد الكلابي الجعفري " ق ".(@)(@@)(@@)(@@) $ 4299 - سليمان بن صالح الأحمري الكوفي " ق " وفيه في كتاب " قي " سليمان بن صالح امام المسجد الأحمر.(@)(@@)(@@)(@@) $ 4300 - سليمان بن صالح الجصاص، عنه الحسن بن محمد بن سماعه " ست " " لم " وعبد الله بن القاسم في الأول، واستظهر الميرزا بأنه الكوفي الآتي الثقة ولا وجه له لتغاير الراوي عنه.(@)(@@)(@@)(@@) $ 4301 - سليمان بن صالح الجصاص الكوفي " ق " روى عن " ق " عليه السلام كوفي ثقة " صه " " جش " له كتاب، عنه الحسين بن هاشم في الثاني، وليس هو السابق إذ الظاهر أن السابق لا يروي عن " ق " عليه السلام.(@)(@@)(@@)(@@) $ 4302 - سليمان بن صالح الخثعمي روى عن " ق " عليه السلام " قي ".(@)(@@)(@@)(@@) $ 4303 - سليمان بن صالح الشيباني، مولاهم كوفي " ق ".(@)(@@)(@@)(@@) $ 4304 - سليمان بن صالح المرادي الغامدي " ق ".(@)(@@)(@@)(@@) $ 4305 - سليمان بن طالب القرشي، مولاهم كوفي " ق ".(@)(@@)(@@)(@@) $ 4306 - سليمان بن طريف الكوفي " ق ".(@)(@@)(@@)(@@) $ 4307 - سليمان بن عبد الرحمن أبو داود الحمار الكوفي " ق ".(@)(@@)(@@)(@@) $ 4308 - سليمان بن عبد الرحمن الأزدي البارقي، مولاهم كوفي " ق ".(@)(@@)(@@)(@@) $ 4309 - سليمان بن عبد الرحمن العبدي أو العنزي الكوفي 
ms356	 " ق ".(@)(@@)(@@)(@@) $ 4310 - سليمان بن عبد الرحمن الهمداني كوفي " ق ". PageV01P481(@)(@@)(@@)(@@) $ 4311 - سليمان بن عبد الله، أبو حامد مولى مزينة الكوفي " ق ".(@)(@@)(@@)(@@) $ 4312 - سليمان بن عبد الله، أبو العلاء الغنوي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4313 - سليمان بن عبد الله البكري الصائغ الكوفي " ق ".(@)(@@)(@@)(@@) $ 4314 - سليمان بن عبد الله بن الحسن بن الحسن بن علي بن أبي طالب عليهما السلام، هاشمي مدني " ق ".(@)(@@)(@@)(@@) $ 4315 - سليمان بن عبد الله الديلمي أبو محمد، أصله من بجيلة ويتجر إلى خراسان ويكثر شراء سبي الديلم غمز عليه، وقيل: كان غاليا كذابا، وكذا ابنه محمد، لا يعمل بما انفردا به " صه " " جش " معنى، له كتاب، عنه ابنه محمد " ست " والثاني.(@)(@@)(@@)(@@) $ 4316 - سليمان بن عبد الله الطلحي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4317 - سليمان بن عبد الله النخعي، مولاهم كوفي " ق ".(@)(@@)(@@)(@@) $ 4318 - سليمان بن علي الأحمسي البجلي، مولاهم الكوفي " ق ".(@)(@@)(@@)(@@) $ 4319 - سليمان بن عمرو الأزدي الكوفي أبو عمارة " ق ".(@)(@@)(@@)(@@) $ 4320 - سليمان بن عمرو بن عبد الله بن وهب النخعي، أبو داود الكوفي، أسند عنه " ق " روى عن " ق " عليه السلام يلقبه المحدثون كذاب النخع، ويأتي في سليمان النخعي.(@)(@@)(@@)(@@) $ 4321 - سليمان بن عمران الفراء مولى طربال كوفي، أورده " قي " في رجال " ق " عليه السلام ولكن في " جخ " " قر " و " ق ".(@)(@@)(@@)(@@) $ 4322 - سليمان بن قرم بن سليمان الضبي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4323 - سليمان بن المتوكل الغزال الكناسي الكوفي " ق " وعن نسخة سلمان، والأول أصح وأكثر.(@)(@@)(@@)(@@) $ 4324 - سليمان بن موسى بن الذيال الهمداني المشعاري الكوفي " ق ".(@)(@@)(@@)(@@) $ 4325 - سليمان مولى طربال روى عن " ق " عليه السلام ذكره ابن نوح، له نوادر عنه عباد بن يعقوب الأسدي " جش " وقد نقل عن حواشي المقدس التقي أن سليم مولى طربال، وسليمان الموصوف بهذا الوصف، وسليم الفراء، وسليمان بن عمران PageV01P482(@)(@@) الفراء، كلهم واحد، ولكنه لا يخلو من نظر.(@)(@@)(@@)(@@) $ 4326 - سليمان بن مهران الأسدي، مولاهم الأعمش الكوفي، قال " ز ":(@)(@@) أصحابنا المصنفون تركوا ذكره وكان حريا لاستقامته وفضله، ذكره العامة وأثنوا عليه مع اعترافهم بالتشيع، و " هب " ثقة عارف بالقرآن ورع لكنه يدلس من الخامسة، 
ms357	 توفي سنة سبع أو ثمان بعد الأربعين والمائة، فتأمل.(@)(@@)(@@)(@@) $ 4327 - سليمان بن نافع الجملي المرادي الكوفي " ق " في نسخة، وفي بعض النسخ ابن تابع كما تقدم، واحتمال التعدد غير بعيد، فتأمل جدا.(@)(@@)(@@)(@@) $ 4328 - سليمان النخعي منسوب إلى نخع قبيلة مالك الأشتر. ويحتمل كونه سكين النخعي، لاتحاد ما ورد فيهما وعلى كونه سليمان، فاستظهر الميرزا كونه: اما ابن عمرو، أو عمر، واما ابن هارون أو يعقوب، والله أعلم.(@)(@@)(@@)(@@) $ 4329 - سليمان بن نصر أبو عبيدة البكري الهذلي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4330 - سليمان بن وهب العجلي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4331 - سليمان بن هارون الأزدي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4332 - سليمان بن هارون النخعي أبو داود يقال له: كذاب النخع، روى عن " ق " عليه السلام ضعيف جدا قاله " غض " " صه " وروى " كش " (1) عن معد عمن ذكره أن سليمان النخعي حج فتعبد وترك النساء والطيب والثياب والطعام والطيب، وكان لا يرفع رأسه داخل المسجد إلى السماء.(@)(@@)(@@)(@@) $ 4333 - سليمان بن هلال بن جابان الكوفي " ق ".(@)(@@)(@@)(@@) $ 4334 - سليمان بن هلال الكوفي " ق ".(@)(@@)(@@)(@@) $ 4335 - سماعة الحناط كوفي " ق ".(@)(@@)(@@)(@@) $ 4336 - سماعة بن عبد الرحمن المزني الكوفي " ق ".(@)(@@)(@@)(@@) $ 4337 - سماعة بن مهران الحضرمي، أبو محمد أو أبو ناشر، روى عن " ق "(@)(@@) PageV01P483(@)(@@) و " ظم " عليهما السلام واقفي ثقة، الا أن أحمد الغضائري ذكر أنه مات سنة خمس وأربعين بعد المائة في حياة الصادق عليه السلام وهذا مناف للوقف ولروايته عن " ظم " فترد الحكاية، عنه عثمان بن عيسى.(@)(@@)(@@)(@@) $ 4338 - سميدع الهلالي " ق " وهو ابن واهب بن سوار بن زهدم الجرمي البصري، ثقة من السابعة مات قديما، ذكر ذلك في بعض الحواشي عن " قب ".(@)(@@)(@@)(@@) $ 4339 - سنان أبو عبد الله بن سنان، روى ابنه أنه من ثقات رجال " ق ".(@)(@@) عليه السلام قال: دخلت عليه عليه السلام وأنا مع أبي، فقال: يا عبد الله ألزم أباك فإنه لا يزداد على الكبر الا خيرا وفي رواية أخرى: أن سنان بن عبد الرحمن من أهل قوله تعالى (ان الذين) الآية.(@)(@@)(@@)(@@) $ 4340 - سنان بن جميل الأزدي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4341 - سنان بن طريف 
ms358	 الثوري، روى عنه أبو حنيفة سابق الحاج " ق " ولعله أبو عبد الله بن سنان المتقدم، ويؤيده أنهم قالوا: إنه ابن سنان بن طريف كما يأتي، الا أن كونه الثوري غير معلوم.(@)(@@)(@@)(@@) $ 4342 - سنان بن عبد الرحمن الكوفي " ق " أخو مقرن " ق " " قي " ابن عبد الرحمن مولى بني هاشم الكوفي " ق " قد تقدم في سنان أبي عبد الله بن سنان بما ينبغي أن يحمل عليه، ولكنه مناف لحمل ابن طريف على أبي عبد الله بن سنان.(@)(@@)(@@)(@@) $ 4343 - سنان بن عدي الطائي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4344 - سنان بن عطية المرهبي الهمداني الكوفي " ق ".(@)(@@)(@@)(@@) $ 4345 - سنان بن وديعة الخثعمي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4346 - سنان بن هارون التميمي البرجمي " ق ".(@)(@@)(@@)(@@) $ 4347 - سندي بن عيسى الهمداني، كوفي ثقة " صه " " جش " له كتاب، عنه عباد بن يعقوب، وفي " تعق " مر في إسماعيل بن عيسى ما ينبغي أن يلاحظ، وفي " مشكا " عيسى الثقة، عنه عباد بن يعقوب.(@)(@@)(@@)(@@) $ 4348 - سوار بن مصعب الهمداني الكوفي " ق ". PageV01P484(@)(@@)(@@)(@@) $ 4349 - سورة بن كليب الأسدي، كوفي روى عنهما، وفي " قر " ابن كليب بن معاوية الأسدي، وفي " كش " روى حديثا يشهد بصحة عقيدته وحسن اعتقاده، ولكن لا يكفي في القبول، الا أن العلامة ذكره في القسم الأول وفي الوجيزة " ح " و " د " ك " صه " ولم أجد من صرح بالتوثيق، فللتوقف مجال.(@)(@@)(@@)(@@) $ 4350 - سورة بن كليب النهدي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4351 - سورة بن مجاشع الأسدي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4352 - سويد بن طالب المهري الجدي " ق ".(@)(@@)(@@)(@@) $ 4353 - سويد بن طلحة الأسدي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4354 - سويد بن عطية البارقي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4355 - سويد بن عمارة العنزي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4356 - سويد القلا الكوفي " ق " وهو ابن مسلم الآتي.(@)(@@)(@@)(@@) $ 4357 - سويد بن مسلم القلا، مولى شهاب بن عبد ربة، روى عن " ق " عليه السلام ثقة، ذكره أبو العباس في الرجال " صه " " جش " عنه علي بن النعمان في الثاني.(@)(@@)(@@)(@@) $ 4358 - سويد مولى محمد بن مسلم، له كتاب، عنه محمد بن سنان، وعلي بن النعمان. ويقال: انه مولى محمد بن مسلم المتقدم.(@)(@@)(@@)(@@) $ 4359 - سويد بن 
ms359	 النعمان الكوفي " ق ".(@)(@@)(@@)(@@) $ 4360 - سهل بن شعيب، مولى قريش الكوفي، الذي يقال له: النهمي " ق ".(@)(@@)(@@)(@@) $ 4361 - سيف التمار، له كتاب أخبرنا به جماعة عن أبي المفضل عن حميد عن الحسن بن محمد بن سماعة " صه " " ست " وفي " تعق " يظهر من روايته كونه من الشيعة، ويروي عنه صفوان بن يحيى، وفيه اشعار بثقته، وكان ابن المغيرة بن سليمان نسبه إلى الجد. أقول: كأنه ابن سليمان الآتي بعيده.(@)(@@)(@@)(@@) $ 4362 - سيف بن سلميان التمار أبو الحسن. كوفي روى عن " ق " عليه السلام ثقة " صه " وزاد وابنه الحسن بن سيف، روى عنه الحسن بن علي بن فضال، PageV01P485(@)(@@) له كتاب، محمد بن أبي حمزة عنه به، وفي " مشكا " ابن سليمان التمار الثقة، عنه محمد بن أبي حمزة، وحماد بن عثمان، وابن أبي عمير، وصفوان بن يحيى.(@)(@@)(@@)(@@) $ 4363 - سيف بن عبد الرحمن، أبو الهذيل التميمي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4364 - سيف بن عمارة الجعفي مولاهم " ق ".(@)(@@)(@@)(@@) $ 4365 - سيف بن مصعب العبدي أبو محمد، روى " كش " من طريق فيه ثلاثة غلاة عن " ق " عليه السلام أنه قال: علموا أولادكم شعر العبدي يشير إلى الشيعة، قال " صه ": وهذا لا يثبت عندي عدالته، تقدم في سفيان ولكنه أصح كما في أصل الرواية.(@)(@@)(@@)(@@) $ 4366 - سيف بن المغيرة التمار الكوفي " ق " وفي " تعق " فيه ما مر في سيف التمار.(@)(@@)(@@)(@@) $ 4367 - شبابة المعتمر العجلي " ق ".(@)(@@)(@@)(@@) $ 4368 - شبث الطحان " ق ".(@)(@@)(@@)(@@) $ 4369 - شديد بن عبد الرحمن الأزدي الكوفي " ق " ويجئ في سدير الصيرفي من دعاء الصادق عليه السلام لخلاصه، فلعله له ولأخيه، وفي " تعق " ربما يظهر من مواضع أنه من مشاهير الشيعة.(@)(@@)(@@)(@@) $ 4370 - شرحبيل بن العلاء الكوفي " ق " غير مقبول الرواية منفردا.(@)(@@)(@@)(@@) $ 4371 - شرحبيل بن مدرك الجعفي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4372 - شريس أبو عمارة العبدي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4373 - شعبة بن الحجاج بن الورد، أبو بسطام الأزدي العتكي الواسطي، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 4374 - شعيب بن أعين الحداد الكوفي، ثقة، روى عن " ق " له أصل، عنه ابنا أبي عمير وسماعة، وبكر بن جناح، وأبو خالد المكفوف " صه " " جش " " كش 
ms360	 " " ست " معنى.(@)(@@)(@@)(@@) $ 4375 - شعيب بن خالد البجلي دخل الري، أسند عنه " ق ". PageV01P486(@)(@@)(@@)(@@) $ 4376 - شعيب بن راشد التميمي الأنماطي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4377 - شعيب بن رجاء الأزدي الصيرفي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4378 - شعيب بن عبد ربه صاحب الطيالسي كوفي " ق " والظاهر أنه في الطبقة السابقة، بل في طبقة أصحاب " ري " بملاحظة تاريخ وفاة محمد بن خالد الطيالسي.(@)(@@)(@@)(@@) $ 4379 - شعيب العقرقوفي، وهو غربي الكاظميين من بغداد، ثقة عين من أصحاب " ق " و " ظم " عليهما السلام روى عنهما، لم أسمع فيه ألا خيرا " كش " له أصل، عنه ابنا أبي عمير وعيسى، وهو ابن أخت أبي بصير يحيى.(@)(@@)(@@)(@@) $ 4380 - شعيب بن فضالة الجعفي، مولاهم كوفي " ق ".(@)(@@)(@@)(@@) $ 4381 - شعيب بن مرثد، أخو مفضل بن مرثد " ق " ويأتي في أخيه أنه ابن مزيد أو يزيد، وكلاهما من أصحاب " ق " عليه السلام والظاهر أنهما شيعيان وأخوه أعلى منه.(@)(@@)(@@)(@@) $ 4382 - شعيب بن مقلاص اليربوعي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4383 - شعيب بن ميثم التمار الأسدي، مولاهم كوفي " ق ".(@)(@@)(@@)(@@) $ 4384 - شعيب بن يعقوب العقرقوفي، وهو شعيب السابق المتصف به الثقة.(@)(@@)(@@)(@@) $ 4385 - شهاب بن زيد البارقي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4386 - شهاب بن محمد الزبيدي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4387 - صابر، روى عنه شعيب الحداد " ق " وهو في التالية أيضا، لعله من أصحاب " قر " أيضا.(@)(@@)(@@)(@@) $ 4388 - صابر بن عبد الله الهاشمي، مولاهم كوفي " ق ".(@)(@@)(@@)(@@) $ 4389 - صابر مولى بسام بن عبد الله الصيرفي مولى بن أسد، روى عن " ق " عليه السلام، له كتاب، عنه أبو الصباح " جش " الا أنه قال: أخبرنا به عدة عن أصحابنا، إلى أن قال: عن صفوان بن يحيى عن أبي الصباح عن صابر.(@)(@@)(@@)(@@) $ 4390 - صابر مولى معاذ بياع الأكسية " ق ". PageV01P487(@)(@@)(@@)(@@) $ 4391 - صارم بن علوان الجوخي " ق ".(@)(@@)(@@)(@@) $ 4392 - صالح الابزاري كوفي " ق ".(@)(@@)(@@)(@@) $ 4393 - صالح بن أبي الأسود الحناط الليثي، مولاهم كوفي، أسند عنه " ق " ابن أبي الأسود، له كتاب " ست ".(@)(@@)(@@)(@@) $ 4394 - صالح بن الحكم النيلي الأحول ضعيف، روى عن " ق " عليه السلام " صه " وزاد " جش " روى عنه ابن بكير، وجميل بن دراج، له كتاب يرويه عنه جماعة 