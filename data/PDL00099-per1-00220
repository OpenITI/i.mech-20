ms201	 شرح درآمد بتم از در %~% واهنگ وفا قصد صفا ترک جفاکرد(@)(@@) 13 خجلت زده استاد سرافکده و خاموش %~% چندانکه مرا خجلتش از خویش رضا کرد(@)(@@) 14 برجستم و بگرفتم و او را بنشاندم %~% فی‌الحال بخندید و دعا گفت و ثنا کرد(@)(@@) 15 گفتم صنما بیهده از من چه رمیدی %~% گفتا به جز این قدر ندانم که قضا کرد(@)(@@) 16 دیگر سخن از چون و چرا هیچ نگفتم %~% زیراکه به خوبان نتوان چون و چراکرد(@)(@@) 17 برجست و به‌ گنجینه شد و شیشه و ساغر %~% آورد و بلورین ته مینا به هوا کرد(@)(@@) 18 می‌ریخت به پیمانه و نوشید و دگربار %~% پرگرد و به م‌ا داد و هم الح‌ق چه بج‌اکرد(@)(@@) 19 بنشست به زانوی من آنگاه ز بوسه %~% هر وام‌که برگردن خود داشت اداکرد(@)(@@) 20 روی و لبم از مهر ببویید و ببوسید %~% هی آه کشید از دل و هی شکر خدا کرد(@)(@@) 21 گه شاکر وصل آمد وگه شاکی هجران %~% گه رخ به زمین سود و گهی سر به سما کرد(@)(@@) 22 گه گفت و گهی خفت و گه افتاد و گهی خاست %~% گه دست برافشاند و گه آهنگ نوا کرد(@)(@@) 23 بنمود گهی ساعد و برچید گهی ساق %~% هر لحظه به نوع دگر اظهار صفا کرد(@)(@@) 24 گه از سر حیرت به فلک کرد اشارت %~% یعنی که مرا دور فلک از تو جدا کرد(@)(@@) 25 گه‌رقص و گهی وجد و‌ گهی خشم و گهی ناز %~% الحق نتوان گفت که از عشوه چها کرد(@)(@@) 26 گفتم صنما آگهیت هست ‌که گردون %~% چرخی زد و ایام به‌ کام شعرا کرد(@)(@@) 27 خجلت‌زده خندید که آری بشنیدم %~% جودی که به جای تو امیرالامرا کرد(@)(@@) 28 سالار نبی خلق نبی اسم‌ که جودش %~% چون رحمت یزدان به همه خلق ندا کرد(@)(@@) 29 بدر شرف از طلعت او فر و بها یافت %~% شاخ امل از شوکت او نشو و نماکرد(@)(@@) 30 جوزا ز 
ms202	 پی طاعت او تنگ ‌کمر بست %~% گردون ز پی خدمت او پشت دوتا کرد(@)(@@) 31 ای میر جوان بخت‌که یزدان به دوگیتی %~% خشم وکرمت را سبب خوف و رجاکرد(@)(@@) 32 گردون صفت عزم تو پوینده زمان‌ گفت %~% گیهان لقب تیغ تو سوزنده فنا کرد(@)(@@) 33 از جور جهانش نبود هیچ رهایی %~% هرکس‌ که ز کف دامن جود تو رها کرد(@)(@@) 34 هر روز شود رایت خورشید جهانگیر %~% از رای منیر تو مگر کسب ضیا کرد(@)(@@) 35 گر خصم تو زنده است عجب نی که وجودش %~% زشتست بدانگونه‌ کزو مرگ ابا کرد(@)(@@) 36 خورشید که کس دیدن رویش نتوانست %~% چون ماه نوش رای تو انگشت‌نماکرد(@)(@@) 37 جا کرد ز بیم کرمت کان به دل کوه %~% کوه از فزع قهر تو ترسید و صدا کرد(@)(@@) 38 میرا دو جهان را کف راد تو ببخشید %~% هشدارکه چندان نتوان جود و سخا کرد(@)(@@) 39 ملکی که ضمیر تو درو هست فروزان %~% شب را نتواندکسی از روز جداکرد(@)(@@) 40 زردست جو خجلت‌زد‌گان دیده خورشید %~% مانا که سجود درت از روی ریا کرد(@)(@@) 41 اقبال ترا وهم فلک خواند و ندانست %~% کاقبال ترا بیهده زان مدح هجا کرد(@)(@@) 42 باران همه بر جای عرق می‌چکد از ابر %~% پیداست‌ که از دست‌ کریم تو حیا کرد(@)(@@) 43 تو مایه آسایش خلقی و به ناچار %~% حود را به دعا خواست ترا سکه دعا کرد(@)(@@) 44 یارب چو خضر زنده و جاوید بماناد %~% هرکس که سر از مهر به پای تو فدا کرد PageV1P141(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 الا تدارک ماه صیام بایدکرد %~% خلاف عادت شرب مدام باید کرد(@)(@@) 2 به مصلحت دو سه روزی نماز باید کرد %~% ز می قعود و به تقوی قیام بایدکرد(@)(@@) 3 ز بانگ زیر و بم مقریان بد آواز %~% به خویش عیش شبانگه حرام باید کرد(@)(@@) 4 ز بهر حفظ سلامت جز این علاجی نیست %~% که ‌گوش هوش به وعظ امام باید کرد(@)(@@) 5 امام 
ms203	 را چو به منبر درآید از در وعظ %~% لقب خلیفه خیرالانام باید کرد(@)(@@) 6 ز می کشان به صراحت‌ گریز باید جست %~% به زاهدان به ضرورت سلام بایدکرد(@)(@@) 7 هزار مفسده خیزد ز ازدحام عوام %~% به زهد چاره این ازدحام باید کرد(@)(@@) 8 به نزد مفتی در هرکجا که بنشیند %~% ستاده دست به‌ کش احترام باید کرد(@)(@@) 9 به هرچه‌گوید تسلیم صرف باید بود %~% به هرچه خواند تصدیق تام بایدکرد(@)(@@) 10 خوش آمدی که به بهتر خواص کس نکند %~% کنون ز بیم به‌ کمتر عوام باید کرد(@)(@@) 11 چو چنگ و جام همه ننگ و نام داد به باد %~% یکی ز نو طلب ننگ و نام بایدکرد(@)(@@) 12 به بزم رندان‌گیسوی چنگ و بربط را %~% شبی پریشان در سوگ جام باید کرد(@)(@@) 13 ز فرط رندی ما آن غزال وحشی بود %~% به زهد و تقویش این ماه رام باید کرد(@)(@@) 14 به شام عید نماید چو ماه نو ابرو %~% نظر نخست به ماهی تمام بایدکرد(@)(@@) 15 بدان دو طره عاشق‌کشی‌که می‌دانی %~% بسان حبل متین اعتصام باید کرد(@)(@@) 16 طناب در گلوی شیخ شهر باید بست %~% روانه‌اش بر قایم مقام باید کرد(@)(@@) 17 به‌هوشیاری و مستی رهیست چون به خدا %~% ازین دوکار ندانم‌کدام بایدکرد(@)(@@) 18 ولی طببعت از آنجا که سرکشست و حرون %~% ز حکمتش به سر اندر لجام باید کرد(@)(@@) 19 نه در طریقه رندی حریص باید بود %~% نه در صلاح و ورع اقتحام باید کرد(@)(@@) 20 به‌خویش خوش نبود التزام هیچ عمل %~% به جز مدیح ملک‌کالتزام بایدکرد(@)(@@) 21 رضای خسرو عادل رضای بارخداست %~% درین مقدمه نیک اهتمام باید کرد(@)(@@) 22 پس از نیایش‌گیهان خدا و نعت رسول %~% ستایش شه کیوان غلام باید کرد(@)(@@) 23 خدیو راد محمد شه آفتاب ملوک %~% که شکر نعت او بر دوام باید کرد(@)(@@) 24 بلند پایه خدیوی‌که قصر جاهش را %~% قیاس از آن سوی نور و ظلام باید کرد(@)(@@) 25 ثنای حضرت او بر 
ms204	 دوام باید گفت %~% دعای دولت او صبح و شام بایدکرد(@)(@@) 26 ز اشک ‌چشم حسودن محیط‌ باید ساخت %~% ز دود مطبخ جودش غمام باید کرد(@)(@@) 27 بقای دهر اگر رو به‌کوتهی آرد %~% ز دور دولت او عمر وام باید کرد(@)(@@) 28 وگر خدای بطی زمان دهد فرمان %~% به عهد شوکت او اختتام باید کرد(@)(@@) 29 زبان تیغش چون آید از نیام برون %~% ز بیم تیغ زبان در نیام باید کرد(@)(@@) 30 ز روزه تلخ شودکام لاجرم بر شاه %~% بسیج معذرت از طبع خام باید کرد(@)(@@) 31 گدای درگه شاهنشهست قاآنی %~% چه شکرها که ازین احتشام باید کرد(@)(@@) 32 تمام باد ز شه ‌کار ملک تا محشر %~% حدیث را به همین جا تمام باید کرد PageV1P142(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 آن کیست که باز آمد و در بزم نظر کرد %~% جان و دل ما از نظری زیر و زبر کرد(@)(@@) 2 آن برق یمانست‌که افتاد به خرمن %~% یا صاعقه‌یی بود که بر کوه ‌گذر کرد(@)(@@) 3 خیزید و بگیرید و بیارید و بپرسید %~% زان فتنه که ناگاه سر از خانه بدر کرد(@)(@@) 4 نی هیچ مگویید و مپویید و مجویید %~% من یافتم آن شعبده ‌کان شعبده‌گر کرد(@)(@@) 5 آن‌یار منست‌ آن و همانست‌ و جز این نیست %~% صدبار چنین‌کرد و فزون‌کرد و بتر کرد(@)(@@) 6 این است همان یار که هر روز دو صد بار %~% ناکرده یکی‌کار ز نوکار د‌رکرد(@)(@@) 7 گه‌آمد و گه خست و گهی ‌رفت و گهی ‌بست %~% گه ساز سفرکرد و گه آهنگ حضرکرد(@)(@@) 8 گه‌صلح وگهی جنگ وگهی نوش و گهی نیش %~% گه شد ز میان بی‌خبر و گاه خبر کرد(@)(@@) 9 گاه از بر من رفت و دو صد نوع دغل باخت %~% گه بر سر من آمد و صدگونه حشر کرد(@)(@@) 10 گه خادم و گه خائن و گه دشمن و گه دوست %~% گه دست به خنجر زد و گه سینه سپر کرد(@)(@@) 11 گه‌ گفت نیم 
ms205	 خادم و صدگونه قسم خورد %~% گه گفت نیم چاکر و صد شورش‌ و شر کرد(@)(@@) 12 گه خانه‌نشین گشت و گهی خانه نشان داد %~% گه‌ خون ز رخم شست و گهی خون به ‌جگر کرد(@)(@@) 13 گه رفت به اصطبل و گهی‌‌ گشت نمدپوش %~% گاهی ز قضا شکوه وگاهی ز قدرکرد(@)(@@) 14 گاهی به فلان برد امان گاه به بهمان %~% گاهی به علی تکیه و گاهی به عمر کرد(@)(@@) 15 از فضل امیرالامرا آمد و این بار %~% از بوسئکی چند لبم پر ز شکرکرد(@)(@@) 16 یک روز چو بگذشت به ره دخترکی دید %~% مانند سگ عوعو زد و آهنگ قمرکرد(@)(@@) 17 گاهی ز پی هدیه ز من شعر و غزل خواست %~% گاهی طلب جامه و آویزگهرکرد(@)(@@) 18 گه موی سر زلف فرستاد به معشوق %~% وانرا ز گرفتاری خود نیک خبر کرد(@)(@@) 19 گه نقل فرستاد وگهی جوزی بوان %~% گه بهر عرایض طلب‌ کاغذ زر کرد(@)(@@) 20 گه نعل فکند از پی معشوق در آتش %~% گه زآتش عشقش‌ دل خود زیر و زبر کرد(@)(@@) 21 گه شد به منجم ز پی ساعت تزویج %~% گه مشت به حمدان زد و نفرین به پدر کرد(@)(@@) 22 گه خواست صد اندر صد و گه خواند عزیمه %~% گه از پی تحبیب دو صد فکر دگر کرد(@)(@@) 23 گه‌گفت خداکاش مرا چشم نمی‌داد %~% کاو دید و دلم را هدف تیر خطر کرد(@)(@@) 24 گه‌گفت مرا از همه آفاق دلی بود %~% دیدار نکویان دلم از دست بدر کرد(@)(@@) 25 گه‌ گفت ‌که دیوانه شوم‌ گر نشد این ‌کار %~% وندر رخ من خیره چو دیوانه نظر کرد(@)(@@) 26 من‌ گاه پی تسلیه‌ گفتم مکن این‌ کار %~% هشدار کزین حادثه بایست حذر‌ کرد(@)(@@) 27 عشق چه و کشک چه و پشم چه فرو هل %~% وسواس تو عرض من و خون تو هدر کرد(@)(@@) 28 رو جان پدر جلق زن و دلق به سر کش %~% هر دم به بتی دست 
ms206	 نشاید به کمر کرد(@)(@@) 29 خندید که این جان پدر جان پدر چند %~% هر چیز به من کرد همین جان پدر کرد(@)(@@) 30 این جان پدر از وطن افکند مرا دور %~% این‌ جان پدر بین ‌که چه بر جان پسر کرد(@)(@@) 31 قا آنیا تن زن و انصاف ده آخر %~% با یار خود اینقدر توان بوک و مگر کرد(@)(@@) 32 من یار تو باشم تو به کارم نکنی میل %~% یزدان دل سختت مگر از روی و حجر کرد(@)(@@) 33 این ‌گفت و خراشید رخ از ناخ‌ و پاشید %~% اشکی که به یک رشحه زمین را همه تر کرد(@)(@@) 34 گفتم چکنم نیست مرا برگ عروسی %~% خود حاضرم ار هیچ توانی خر نر کرد(@)(@@) 35 برتافت زنخدان مرا با سرانگشت %~% وندر رخ من ژرف نگاهی به عبر کرد(@)(@@) 36 گفتا تو عروس منی ای خواجه بدین‌ حسن %~% کز روی تو زنگی به شب تار حذر کرد(@)(@@) 37 خر گایم و نر گایم و آنگاه چنین زشت %~% ویحک که ترا بار خدا این همه خر کرد(@)(@@) 38 گویند حکیمی تو که آباد شود فارس %~% خرتر ز تو آن کس که تو را نام بشر‌ کرد(@)(@@) 39 گفتم به خدا هرچه‌‌ کنم فکر نیارم %~% کاری‌ که توان بر طلب سیم ظفر کرد(@)(@@) 40 گفتا نه چنینست به یک روز توانی %~% یزدان نه مگر شخص ترا زاهل هنر کرد(@)(@@) 41 شعری دو سه در مدح امیرالامرا‌ گوی %~% میری ‌که ترا صاحب این جاه و خط‌ر کرد(@)(@@) 42 گفتم‌که من این قصه نگارم به علیخان %~% کش بار خدا پاک دل و نیک سیر کرد(@)(@@) 43 شعر از من و سور از تو و سیم از کرم میر %~% نصرت ز خدایی که معانی به صور کرد(@)(@@) 44 تا صورت این حال دهد عرضه بر میر %~% میری ‌که خدایش به سخا نام سمر کرد(@)(@@) 45 گفتاکه نکوگفتی و تحقیق همین بود %~% وین ‌گفته حق در دل من 
ms207	 نیک اثر کرد(@)(@@) 46 محمود بود عاقبت میر که دایم %~% از همت او کشته‌ آمال شمر کرد(@)(@@) 47 قاآنی ازین نوع سخن گفتن شیرین %~% بالله‌که توان‌ کام تو پر در و گهر کرد PageV1P143(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ماهم ز در درآمد و بر من سلام کرد %~% مشکوی من ز طره خود مشک‌فام‌کرد(@)(@@) 2 با هم دمید ماه من و مهر آسمان %~% روشن جهان ازاین دو ندانم‌کدام‌ کرد(@)(@@) 3 رضو‌ان ندانما که به غلمان چه خشم‌کرد %~% کاو تنگدل ز خلد به‌ گیتی خرام‌ کرد(@)(@@) 4 غلمان مگو فریشته به ذکر مهین خدای %~% زی من به مدح خسرو دنیا پیام کرد(@)(@@) 5 دارای ملک فارس فریدون راستین %~% کاو را خدای بار خدای انام‌کرد(@)(@@) 6 باری نگارم آمد و بنشست و هر نفس %~% مستانه بر رسوم تواضع قیام ‌کرد(@)(@@) 7 وهم آمدم به پیش‌ ‌که دیوانه شد مگر %~% از بس نمود لابه و از بس سلام کرد(@)(@@) 8 دزدیده کرد خنده و از دیده اشک ریخت %~% دل زو رمیده بدین حیله رام‌کرد(@)(@@) 9 زخمی‌که تیر غمزه او زد به جان من %~% آن زخم را به زخم دگر التیام کر‌د(@)(@@) 10 آن عنبرین‌ دو زلف ‌که رقاص روی اوست %~% گاهی به شکل دال و گهی شکل لام کرد(@)(@@) 11 تا بوی زلف او همی از باد بشنوم %~% پا تا سرم شعور محبت مشام‌کرد(@)(@@) 12 عارض نمود و مجلس من پرفروغ ساخت %~% گیسو گشود و محفل من پرظلام کرد(@)(@@) 13 آن را ز صبح روشن نایب مناب ساخت %~% وی را زشام تاری قایم مقام کرد(@)(@@) 14 بر من نمود یک دم وصلش هزار سال %~% از بس زروی و موی عیان صبح و شام کرد(@)(@@) 15 برجست و پیش‌ خم شد و بر سرکشید می %~% از کف قرابه از گلوی خویش جام کرد(@)(@@) 16 زان پس دوید و رخشم از آخر برون کشید %~% زین بر نهاد و تنگ‌کشید و لجام‌ کرد(@)(@@) 17 باد رونده را به شکم 
ms208	 برکشید تنگ %~% برق جهنده را به سر اندر زمام کرد(@)(@@) 18 برپشت باد همچو سلیمان نهاد تخت %~% و‌آنگه به تخت همچو سلیمان مقام کرد(@)(@@) 19 تا بسته بود چون ‌کره خاک بدگران %~% چون باز شد چو گنبد گردون خرام‌ کرد(@)(@@) 20 که بود تا فسار بسر داشت رخش من %~% بادی رونده شد چو مر او را لگام‌کرد(@)(@@) 21 که هیچ بادگردد الحق نگار من %~% معجز نمود و آیت قدرت تمام‌کرد(@)(@@) 22 گفتا ز جای خیز و برون آی و برنشین %~% کامروز بخت کار جهان با قوام‌ کرد(@)(@@) 23 گفتم چه موجبست‌که باید به جان و دل %~% زحمت شمرد رحمت و راحت حرام‌کرد(@)(@@) 24 گفتا ندانیا که شهنشاه نیک بخت %~% شه را روانه از ری رخت نظام‌کرد(@)(@@) 25 و ایدون پی پذیره جهاندار ملک جم %~% پا در رکاب رخش ثریا ستام‌ کرد(@)(@@) 26 تا پشت ‌گاو و ماهی‌ کوبیده‌ گشت دشت %~% از بس‌که خاص و عام برو ازدحام‌کرد(@)(@@) 27 از بانگ چگ جان خلایق به وجد خاست %~% از بوی عود مغز ملایک زکام کرد(@)(@@) 28 رخت نظام‌ کرد به بر حکمران فارس %~% کار جهان و خلق جهان با نظام‌کرد(@)(@@) 29 گیهان به ذکر تهنیتش افتتاح جست %~% هم بر دعای دولت او اختتام‌کرد(@)(@@) 30 شاها توبی که هرکه ترا نیکنام خواست %~% او را خدای در دو جهان نیکنام کرد(@)(@@) 31 تخت ترا زمانه صفت لایزال‌گفت %~% بخت ترا ستاره لقب لا ینام‌ کرد(@)(@@) 32 آبی‌که خورده بود امل بی‌رضای تو %~% خوی شد ز خجلت تو و قصد مسام‌کرد(@)(@@) 33 یارب‌که در زمانه ملک شادکام باد %~% کز فضل در زمانه مرا شادکام‌کرد PageV1P144(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 باد نوروزی شمیم عطر جان می‌آورد %~% در چمن ‌از مشک چین صد کاروان می‌آورد(@)(@@) 2 رستم عید از برای چشم‌ کاووس بهار %~% نوشدارو از دل دیو خزان می‌آورد(@)(@@) 3 با منوچهر صبا زی آفریدون ربیع %~% فتح‌نامه سلم دی از خاوران می‌آورد(@)(@@) 4 بهر دفع بیور اسب دی ‌گلستان ‌کاوه 
ms209	 را %~% ازگل سوری درفش کاویان می‌آورد(@)(@@) 5 رستم اردیبهشتی مژده نزد طوس عید %~% از هلاک اشکبوس مهرگان می‌آورد(@)(@@) 6 بهر ناو‌ررد فرامرز خریف اینک سپهر %~% ازکمان بهمنی تیر وکمان می‌آورد(@)(@@) 7 یا پیام‌کشتن دارای دی را باد صبح %~% در بر اسکندر صاحبقران می‌آورد(@)(@@) 8 یا شماساس خزان را قارن اردیبهشت %~% دستگیر از نیزه آتش‌فشان می‌آورد(@)(@@) 9 یا نوید قتل ‌کرم هفتواد دی نستیم %~% در چمن چون اردشیر بابکان می‌آورد(@)(@@) 10 یاگروی فصل دی را بر فراز تل خاک %~% گیو فروردین به خواری موکشان می‌آورد(@)(@@) 11 نف نامیرا نگرکاینک به استمداد باد %~% نقش ها از پرده‌ در سلک عیان می‌آورد(@)(@@) 12 خواهران لاله و گل را ز هفت اندام خاک %~% همچو رویین‌تن ز راه هفتخوان می‌آورد(@)(@@) 13 خنده‌ گل راست باعث‌‌ گریه ابر ای ‌شگفت %~% کاشک چشم او خواص زعفران می‌آورد(@)(@@) 14 نفس‌نامی‌ خودنسودی نیست بل اهتو خوشیست‌ %~% صنعها بین تا ز هر حرفت چسان می‌آورد(@)(@@) 15 ‌گاه بر مانند نساجان پرند از نسترن %~% در سمن دیبا و درگل پرنیان می‌آورد(@)(@@) 16 گاه بر هنجار صرافان زر و دینار چند %~% ازگل خیری به بازار جهان می‌آورد(@)(@@) 17 از سنان لاله‌کاه از بید برگ برگ بید %~% صنعت پولادسازی در میان می‌آورد(@)(@@) 18 مطلعی از مطلع طبعم برآمدکز فروغ %~% مهر را در چادر کحلی نهان می‌آورد(@)(@@) 19 ساقی ما تا شراب ارغوان می‌آورد %~% بزم را آزرم گلگشت جنان می‌آورد(@)(@@) 20 جام‌ کیخسرو پر از خون سیاووشان‌ کند %~% در دل الماس یاقوت روان می‌آورد(@)(@@) 21 قصد اسکندر هم ظلمات بد نی آب خضر %~% طبع رمزی زین سخن را در بیان می‌آورد(@)(@@) 22 خود نمی‌دانست اسکندر مگر کاندر شراب %~% هست تاثیری‌که عمر جاودان می‌آورد(@)(@@) 23 از دل صاف صراحی در تن تابنده جام %~% دست ساقی مایه روح روان می‌آورد(@)(@@) 24 دست‌افشان‌پای‌کوبان‌هروشاقی ساده‌روی %~% رو به سوی درگه پیر مغان می‌آورد(@)(@@) 25 خلق را جشنی دگرگونست‌گویا نوبهار %~% از شمیم عطر گلشان شادمان می‌آورد(@)(@@) 26 یا نسیم صبحگاهی 
ms210	 مژدگانی نزد خلق %~% از نزول موکب شاه جهان می‌آورد(@)(@@) 27 قهرمان ملک جمشیدی بهادرشه حسن‌ %~% آنکه‌ کیوان را به درگه پاسبان می‌آورد(@)(@@) 28 آن‌ شهنشاهی ‌که ‌هرشام ‌و سحر ازروی شوق %~% سجده‌ بر خاک رهش هفت آسمان می‌آورد(@)(@@) 29 آنکه یک ‌رشح‌ کف او آشکارا صدهزار %~% گنج باد آورد و گنج شایگان می ‌آو‌رد(@)(@@) 30 هر که را الطاف او تاج شرف بر سر نهاد %~% روزگارش‌ کامکار وکامران می‌آورد(@)(@@) 31 هرچه جز نقش وجود اوست نقاش قضا %~% بر سبیل آزمون و امتحان می‌آورد(@)(@@) 32 هیچ دانی با عدو تیغ جهان‌سوزش چه‌کرد %~% آنچه بر سرکشت را برق یمان می‌آوررد(@)(@@) 33 تا به دیوان جهان نامش رقم ‌کرد آسمان %~% نام دستان را که اندر داستان می‌آورد(@)(@@) 34 رفعت ‌کاخ جلالش در سه ایوان دماغ %~% کاردانان یقین را در گمان می‌آورد(@)(@@) 35 نصرت و فیروزی‌ و فتح ‌و ظفر را روزگار %~% با رکاب شرکت او همعنان می‌آورد(@)(@@) 36 حسرت دست‌گهربارش مزاج ابر را %~% با خواص‌ ذاتی طبع دخان می‌آورد(@)(@@) 37 فره دیهم داراییش هردم صد شکست %~% بر شکوه افسر شاه اردوان می‌آورد(@)(@@) 38 خصم با وی چون ستیزد خرسواری ازکجا %~% تاب ناورد سوار سیستان می‌آورد(@)(@@) 39 مور کز سستی نیارد پر کاهی برکشید %~% کی‌گزندی بر تن شیر ژیان می‌آورد(@)(@@) 40 یا طنین پشه لاغرکه هیچش زور نیست %~% کی خلل بر خاطر پیل دمان می‌آورد(@)(@@) 41 نی‌گرفتم از در طوسست آسیب ازکجا %~% بر تن و بازوی سام پهلوان می‌آورد(@)(@@) 42 کهترین‌ کریاس دار بارگاه حشتمتش‌ %~% از جلالت پا به فرق فرقدان می‌آورد(@)(@@) 43 گردش گردون به ‌گردش کی رسد هر گه او %~% در جهان رخش عزیمت را جهان می‌آورد(@)(@@) 44 لرزه اندر پیکر هفت آسمان افتد ز بیم %~% چون به هیجا دست بر گرز گران می‌آ‌ورد(@)(@@) 45 دفتر شاهان پیشین را بشوید اندر آب %~% هرکجاکافاق نامش بر زبان می‌آورد(@)(@@) 46 ای شهنشاهی‌ که از تاثیر دولت روزگار %~% صعوه را از چنگل باز آشیان می‌آورد 
ms211	(@)(@@) 47 گر ز فرمانت فلک‌ گردن‌کشد برگردنش %~% دست دوران ی‌الهنگ ازککشان م‌ی‌آورد(@)(@@) 48 روزگار از ازدواج چار مام و هفت باب %~% با کفت طفل عطا را توامان می‌آورد(@)(@@) 49 نیست جز تاثیر تابان نجم بختت هرچه را %~% لاب ز اسطرلاب و رمز اردجان می‌آورد(@)(@@) 50 معجز تأثیر انفاس تو در تسخیر ملک %~% از دم عیسی روح‌الله نشان می‌آورد(@)(@@) 51 موسی شخص تو فرعون حوادث را ستوه %~% از ظهور معجز کلک و بنان می‌آورد(@)(@@) 52 مر قضا را در نظام حل و عقد روزگار %~% هرچه‌ویی اینچنین او آنچنان می‌آه‌ررد(@)(@@) 53 آ‌سمان جز مهر وکینت ننگرد سرمایه‌ای %~% آشکارا هرچه از سود و زیان می‌آورد(@)(@@) 54 چون فلک صاحبقرانی چون ترا نارد پدید %~% زان سبب آسوده‌ات از هر قران می‌آورد(@)(@@) 55 شاد زی شاها که دایم بر وجودت عقل پیر %~% مژده‌ها از جانب بخت جوان می‌آورد(@)(@@) 56 سوی قاآنی ز روی مرحمت چشمی فکن %~% کز در معنی نثارت هر زمان می‌آ‌ررد(@)(@@) 57 گرچه‌ نظمش‌ نیست‌ نظمی ‌کش توانستی شنعد %~% زانکه طبعش آسمان و ریسمان می‌آورد(@)(@@) 58 لیک چون هموار در مدح تو می‌راند سخن %~% روزگارش هر دو عالم رایگان می‌آورد(@)(@@) 59 روح پاک افضل‌الدینش به دست نیک‌باد %~% تهنیت هر دم ز خاک شیروان می‌آورد(@)(@@) 60 روز و ماه و سالیان درد و غم و رنجت مباد %~% تا که دوران روز و ماه و سالیان می‌آو‌ررد PageV1P145(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ساقی بده رطل گران زان می که دهقان پرورد %~% انده برد غم بشکرد شادی دهد جان پرورد(@)(@@) 2 در خم دل پیر مغان در جام مهر زر فشان %~% در دست‌ ساقی‌ قوت‌جان ‌رخسار جانان پرورد(@)(@@) 3 در جان جهد زان پیشتر کاندر گلو یابد خبر %~% نارفته از لب در جگر کز رخ ‌گلستان پرورد(@)(@@) 4 چون برفروزد مشعله یکسر بسوزد مشغله %~% دیو ار شود زو حامله حوری به زهدان پرورد(@)(@@) 5 شادی دهد غمناک راکسری‌کند ضحاک را %~% بیجاده سازد خاک را وز خاک انسان پرورد 
ms212	(@)(@@) 6 از سنگ سازد توتیا وز خاک آرد کیمیا %~% از درد انگیزد صفا وز درد درمان پرورد(@)(@@) 7 بر گل‌فشانی ‌گل‌ شود بر خس ‌چکد سنبل شود %~% زاغ ار خورد بلبل شود صدگونه الحان پرورد(@)(@@) 8 جلاب جان قلاب تن مایه ی خرد دایه ی فطن %~% طعمه بیان لقمه سخن‌کان لقمه لقمان پرورد(@)(@@) 9 تبیان‌کند تلبیس را انسان‌کند ابلیس را %~% هوش ‌هزار ادریس را در مغز نادان پرورد(@)(@@) 10 می چون دل بینا بود کاو را بدان مینا بود %~% یا آتش سینا بود کش آب حیوان پرورد(@)(@@) 11 دل را ازو زاید شعف جان‌را از او خیزد شرف %~% چونان‌ که ‌گوهر را صدف از آب نیسان پرورد(@)(@@) 12 از جان پاکان خاک او وز روح‌آب تاک او %~% کایدون عصیر پاک او جان سخندان پرورد(@)(@@) 13 زان‌جو‌هر خو‌رشیدفش ‌گر عکسی‌افتد در حبش %~% خاک‌حبش‌فردوس‌وش تا حشر غلمان پرورد(@)(@@) 14 لعل بدخشانش لقب ماه درخشانش سلب %~% ماه درخشان ای عجب لعل درخشان پرورد(@)(@@) 15 جان‌ را سرور و سور ازو دل ‌را نشاط و شور از او %~% مانا جمال حور ازو در خلد رضوان پرورد(@)(@@) 16 در خم روان دارد همی زان رو فغان دارد همی %~% در جام جان دارد همی زان جان پژمان پرورد(@)(@@) 17 دی با یکی‌گفتم بری جان به و یا می‌گفت هی %~% جان ‌پرورد تن را و می جان را دوچندان پرورد(@)(@@) 18 چون‌مطرب ‌آید در طرب‌یاری‌طلب ‌یاقوت ‌لب %~% سمین‌بری کاندر قب ماه درخشان پرورد(@)(@@) 19 عقد ثریا در لبش سی ماه نو در غبغبش %~% وان ‌زلف هندو مشربش کفری ‌که ایمان پرورد(@)(@@) 20 زلفش چو دیوی خیره سر وز دزد شب دیوانه تر %~% کز ریو یک ‌گردون قمر در زیر دامان پرورد(@)(@@) 21 گل‌ پرورد در مشک چین ‌گوهر فشاند زانگبین %~% بیضا نماید زآستین مه درگریبان پرورد(@)(@@) 22 جوزا نماید ازکمر پروین فشاند از شکر %~% کژدم‌ گذارد بر قمرگوهر به مرجان پرورد(@)(@@) 23 رویش ز دیبا نرم‌تر وز 
ms213	 فتنه بی‌آرزم‌تر %~% آبی ز آتش‌گرمترکز شعله عطشان پرورد(@)(@@) 24 خورشیدرو ذره‌دهان ناریک‌مو روشن‌روان %~% فربه‌سرین لاغرمیان کاین‌کاهد و آن پرورد(@)(@@) 25 زلفش چو طنازی‌کند بر ارغوان بازی‌کند %~% بر مه زره سازی‌کند در خلد شیطان پرورد(@)(@@) 26 پوشیده‌گلبرک طری در زیر زلف سعتری %~% گویی روان مشتری در جرم‌کیوان پرورد(@)(@@) 27 مشکین‌خطش برگردلب ‌موریست‌ جوشان بر رطب %~% گرد نمکدان ای ‌عجب یک‌ دسته ریحان پرورد(@)(@@) 28 دارد غمم را بیشتر سازد دلم را ریش‌تر %~% مانا هزاران نیشتر در نوک مژگان پرورد(@)(@@) 29 جز خط آن سمین‌بدن کافزود حسنش را ثمن %~% هرگز شنیدی اهرمن مهر سلیمان پرورد(@)(@@) 30 هرگه سخن راند زلب در من ‌فتد شور ای عجب %~% ناچار شورست ‌آن ‌رطب کش ‌درنمکدان‌ پرورد(@)(@@) 31 ون‌در وثاق‌آید همی برچیده ساق آید همی %~% تکلیف شاق آید همی آنرا که ایمان پرورد(@)(@@) 32 خیز ای نگار ده‌دله آن رسم دیرین‌کن یله %~% بگذارجنگ‌و مشغله‌کاین‌هردو خسران پرورد(@)(@@) 33 جامی بخور کامی بجو بوسی بده حرفی بگو %~% زان پیش کان روی نکو خار مغیلان پرورد(@)(@@) 34 در مشت‌خواهم‌غبغبت‌تا سخت تر بوسم‌ لبت %~% ترسم‌ز زلف‌چون‌شبت‌کاو رنگ‌عصیان‌پرورد(@)(@@) 35 از دو لبت ای هم‌نفس یک بوسه دارم ملتمس %~% بگذار تا خود را مگس در شکرستان پرورد(@)(@@) 36 بوسی بده بی‌مشغله بی‌زحمت و جنگ و گله %~% کز جان‌ برفت آن‌ حوصله‌ کاندوه حرمان پرورد(@)(@@) 37 ور بوسه‌ندهی ای پسر حالی به‌کین بندم‌کمر %~% گردد سخنور شیر نر چون رسم طغیان پرورد(@)(@@) 38 ویژه چو قاآنی ‌کسی‌ کاورا بود حرمت بسی %~% زیرا که در مجلس بسی مدح جهانبان پرورد(@)(@@) 39 ماه مهین شاه مهان غیث زمین غوث زمان %~% کز قیروان تا قیروان در ظل احسان پرورد(@)(@@) 40 دارا محمدشاه راد آن قیصر کسری‌نژاد %~% آن کز رسول عدل و داد آیین یزدان پرورد(@)(@@) 41 از حزم داند خیر و شر از عزم ‌گیرد بحر و بر %~% از جود بخشد خشک ‌و تر وز عدل ‌گیهان پرورد(@)(@@) 42 گیتی چو مهدی مهد او نظم جهان از 
