ms68	 وقال هاذا أصح ( ز ) .(@)(@@)(@@)(@@) $ ( 550 ) قال النبي :(@)(@@) | 30 ( أحب الكلام إلى الله تعالى أربع : سبحان الله ، PageV01P104 والحمد لله ، ولا إلاه إلا الله ، والله أكبر ، ولا يضرك بأيهن بدأت ) )(@)(@@) ( حم م ) عن سمرة بن جندب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 551 ) قال النبي :(@)(@@) | 30 ( أحب الكلام إلى الله أن يقول العبد سبحان الله وبحمده ) )(@)(@@) ( حم م ت ) عن أبي ذر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 552 ) قال النبي :(@)(@@) | 30 ( أحب الكلام إلى الله تعالى ما اصطفاه الله لملائكته : سبحان ربي وبحمده ، سبحان ربي وبحمده ، سبحان ربي وبحمده ) )(@)(@@) ( ت ك هب ) عن أبي ذر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 553 ) قال النبي :(@)(@@) | 30 ( أحب الله تعالى عبدا : سمحا إذا باع ، وسمحا إذا اشترى ، وسمحا إذا قضى ، وسمحا إذا اقتضى ) )(@)(@@) ( هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 554 ) قال النبي :(@)(@@) | 30 ( أحب اللهو إلى الله تعالى إجراء الخيل والرمي ) )(@)(@@) ( عد ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 555 ) قال النبي :(@)(@@) | 30 ( أحب الناس إلى الله أنفعهم للناس وأحب الأعمال إلى الله عز وجل سرور تدخله على مسلم أو تكشف عنه كربة أو تقضي عنه دينا أو تطرد عنه جوعا ، ولأن أمشي مع أخي المسلم في حاجة أحب إلي من أن أعتكف في هاذا المسجد شهرا ، ومن كف غضبه ستر الله عورته ، ومن كظم غيظه ولو شاء أن يمضيه أمضاه ملأ الله قلبه رضى يوم القيامة ، ومن مشى مع أخيه المسلم في حاجته حتى يثبتها له أثبت الله تعالى قدميه يوم تزل الأقدام ، وإن سوء الخلق ليفسد العمل كما يفسد الخل العسل ) )(@)(@@) ابن أبي الدنيا في قضاء الحوائج ( طب ) عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 556 ) قال النبي :(@)(@@) | 30 ( أحب الناس إلي عائشة ومن الرجال أبوها ) )(@)(@@) ( ق ت ) عن عمرو بن العاص ( ت ه ) عن أنس رضي الله عنهما .(@)(@@) PageV01P105(@)(@@)(@@)(@@) $ ( 557 ) قال النبي :(@)(@@) | 30 ( أحب أهل بيتي إلي الحسن والحسين ) )(@)(@@) ( ت ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 558 ) قال النبي :(@)(@@) | 30 ( أحب أهلي إلي فاطمة ) )(@)(@@) ( ت ك ) عن أسامة رضي 
