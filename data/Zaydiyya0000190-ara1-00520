ms501	 عبد الرحمن بن أبي عبد الله ميمون البصري ثقة " صه "(@)(@)(@@) --- PageV01P624 [ 625 ](@)(@)(@@) " جش " قد تقدم ابنه اسماعيل لكن بغير الهاء أخيرا، وهو أيضا في السابقة، وقد مضى في ترجمة ابنه أنه ثقة، وكذا جده عبد الرحمن. 6207 - هود أبو أيوب الانصاري المدني، روى عنه أبان الاحمر وعبد الله الكاهلي " ق " وهو في التالية. 6208 - الهيثم بن البراء " ق ". 6209 - الهيثم بن حبيب الصيرفي الكوفي، اسند عنه " ق " وفي " تعق " روى عنه ابن أبي عمير في الصحيح. 6210 - الهيثم بن عبد الجبار الطحان " ق ". 6211 - الهيثم بن عبد الله أبو كهمس، كوفي عربي، ذكره سعد بن عبد الله في الطبقات " جش " وفي " د " " لم " ويأتي عن " ق " ابن عبيد الله الشيباني ويمكن الاختلاف. 6212 - الهيثم بن عبيد الشيباني أبو كهمس الكوفي، اسند عنه " ق " تقدم ابن عبد الله، والظاهر انه غيره، وفي " تعق " في الكافي عن الحجاج الخشاب عن أبي كهمس الهيثم بن عبيد، وفيه أيضا عن ابن بكير عنه، ثم استظهر الاتحاد تبعا للميرزا، فتأمل. 6213 - الهيثم بن عروة التميمي الكوفي " ق " كوفي روى عن الصادق عليه السلام " صه " " جش " له كتاب، عنه صفوان في الثاني. 6214 - الهيثم بن واقد الجرزي " ق " مولى الصادق الخرزي روى عن الصادق عليه السلام، له كتاب يرويه محمد بن سنان " جش " وفي " د " " ق " " جش " ثقة وقد تأمل فيه الميرزا، وفي " تعق " يروي عنه الحسن بن محبوب. 6215 - يحيى بن أبي الاشعث الكندي البصري، اسند عنه " ق " وفي بعض النسخ بدون أبي في الاب، كما وقع في بعض الاسانيد أيضا. 6216 - يحيى بن أبي القاسم أبو بصير مكفوف، واسم أبيه اسحاق، ويأتي عن " ق " الصيرفي الكوفي أو الكوفي بعنوان ابن اسحاق في موضعين، ولعله ابن(@)(@)(@@) --- PageV01P625 [ 626 ](@)(@)(@@) القاسم الحذاء، وسيجئ في التالية أيضا بعنوان ابن أبي القاسم، والظاهر اتحاد الكل، وان ذكره الميرزا في عناوين متعددة، فلاحظ وتدبر. 6217 - يحيى بن أبي المساور العابد " قي " " ق " ويأتي عن " ق " ابن المساور. 6218 - يحيى أخو آدم " ق 
ms502	 ". 6219 - يحيى الازرق " ق " " ظم " هو ابن عبد الرحمن أو ابن حسان كما قيل ولا يخلو من التأمل، وفي بعض النسخ ابن الازرق. 6220 - يحيى بن اسحاق الصيرفي كوفي " ق ". 6221 - يحيى بن اسحاق الكوفي " ق ". 6222 - يحيى بن أيوب البصري، اسند عنه " ق ". 6223 - يحيى بن بشير النبال " ق ". 6224 - يحيى بياع الحلل، ويقال له القلانسي " ق " وزاد " قي " أبو شبل كوفي وقال: ويقال القلانسي. 6225 - يحيى بن تميم النهدي " ق ". 6226 - يحيى بن حبيب، وقد ورد عن الصادق عليه السلام حديث فيه وفي أبي عبد الله الحذاء وعبد الرحمن بن الحجاج أنهم من الآمنين يوم القيامة، الا أن في طريقه سهل، والامر فيه سهل. 6227 - يحيى بن الحجاج الكرخي، بغدادي ثقة، وأخوه خالد روى عن " ق " عليه السلام " صه " " جش " له كتاب، عنه محمد بن سليمان " جش " " ست " وفي " مشكا " ابن الحجاج الثقة، عنه محمد بن سليمان. 6228 - يحيى بن حسان " ق " ثم ابن حسان الكوفي، ويحتمل كونه هو الاول كما احتمل كونه الازرق، وفي كليهما مجال للتأمل لا يخفى. 6229 - يحيى بن سعيد الطائفي، اسند عنه " ق ". 6230 - يحيى صاحب الديلم العالم الشهيد ابن عبد الله بن الحسن بن الحسن بن علي بن أبي طالب عليه السلام مدني و" ق " " جخ " الا صحاب الى الشهيد(@)(@)(@@) --- PageV01P626 [ 627 ](@)(@)(@@) ويأتي في التالية بعنوان ابن عبد الله، والاتحاد محتمل. 6231 - يحيى الطويل صاحب المقري، وفي التهذيب كما عنه صاحب المصري عنه ابن أبي عمير في الحسن بابراهيم. 6232 - يحيى بن عبد الرحمن " ظم " " ق " الازرق الانصاري، مولى كوفي في الثاني ابن عبد الرحمن الازرق " ست " " جش " " صه " وزاد في الاخيرين كوفي ثقة، روى عن " ق " و" ظم " عليهما السلام، له كتاب، عنه ابن الحسن الطاطري، وسماعة، والقاسم بن اسماعيل. 6233 - يحيى بن عبد الله بن محمد بن عمر بن علي بن أبي طالب الهاشمي الكوفي " ق " وفي " تعق " حسنه خالي لان للصدوق طريقا إليه. 6234 - يحيى بن عبد الله بن معاويه 
ms503	 الكندي الاجلح أبو حجية " ق " وفي " تعق " مضى في أجلح ما ينبغي أن يلاحظ. وعن ميزان الاعتدال أنه شيعي صدوق واسم الاجلح يحيى، وقد مضى في باب الالف. 6235 - يحيى بن عبد الملك بن أبي عتبة الخزاعي، اسند عنه " ق ". 6236 - يحيى بن عتبة بن أسماء بن جويرية البصري " ق " وعن نسخة عيينة. 6237 - يحيى بن العلاء البجلي الرازي أبو جعفر ثقة، أصله كوفي " جش " له كتاب، عنه زكريا بن يحيى فيه أيضا ابن العلاء بن خالد البجلي كوفي يقال له: الرازي " ق " ويأتي عن " ست " و" قر " في التالية ابن أبي العلاء. 6238 - يحيى بن عقبة بن أبي الغيرار أبو القاسم، كوفي أسند عنه " ق ". 6239 - يحيى بن علي التميمي الربعي الكوفي " ق ". 6240 - يحيى بن عليم الكلبي العليمي، قال " جش " انه ثقة عين روى عن الصادق عليه السلام وقال " غض " ضعيف، ورجح العلامة في " صه " القبول وهو الاحق، له كتاب الزهد، عنه ابن أحمد بن نهيك، وابن أبي عمير، وذكره " ع ب " في الثقات، وفي الوجيزة ثقة، وعليم بالمهملة المضمومة وبالمعجمة وتشديد اللام غلط.(@)(@)(@@) --- PageV01P627 [ 628 ](@)(@)(@@) 6241 - يحيى بن عمران الحلبي " ق " كوفي، كانت تجارته الى حلب فنسب إليها، ثقة صحيح الحديث، روى عن " ق " و" ظم " عليهما السلام، له كتاب، عنه ابن أبي عمير، والنضر بن سويد، وجده علي بن أبي شعبة الحلبي. 6242 - يحيى بن عيينة بن أسماء بن جويرية البصري، كما عن بعض نسخ " ق " وقد تقدم ابن عتيبة. 6243 - يحيى بن القاسم " ظم " " جش " " ست " " صه " الحذاء في الاول والرابع، أبو بصير في غير الاول، يعرف بالاسدي ثقة، ولد مكفوفا فرأى الدنيا مرتين بمسح أبي عبد الله وأبيه الباقر عليهما السلام، روى عنهما وعن " ظم " قليلا، وفي الخبر: عليك بالاسدي. 6244 - يحيى اللحام الكوفي، روى عن " ق " ثقة " صه " " جش " له كتاب، عنه الحسن بن محبوب " ست " " جش " وفي " مشكا " يحيى اللحام الثقة، عنه الحسن بن محبوب. 6245 - يحيى بن محمد بن سعيد بن دينار، 
ms504	 كوفي يكنى أبا الشبل " ق ". 6246 - يحيى بن محمد بن عليم، له كتاب، عنه ابن نهيك " ست " تقدم عن " جش " و" صه " يحيى بن عليم. 6247 - يحيى بن المساور أبو زكريا التميمي، مولاهم كوفي " ق " تقدم ابن أبي مساور. 6248 - يحيى بن معمر العطار، روى عنه جعفر بن بشير في الحسن بابراهيم " تعق ". 6249 - يحيى بن مقسم الكوفي، اسند عنه " ق ". 6250 - يحيى بن مهران الثوري الكوفي أبو عبيد الحنائي " ق ". 6251 - يحيى بن يعقوب أبو طالب القاضي، خال أبي يوسف القاضي، اسند عنه " ق " " د ". 6252 - يزيد أبو خالد الاعور " ق " وفي نسخة يزداد، ولعل الاول أصح.(@)(@)(@@) --- PageV01P628 [ 629 ](@)(@)(@@) 6253 - يزيد ابو خالد مولى بني عجل بن لحيم، كوفي ثقة، روى عن الصادق عليه السلام " صه " " جش " له كتاب عنه صفوان، والظاهر أنه غير الكناسي الآتي في التالية الذي يروي عنه الحسن بن محبوب. 6254 - يزيد البزاز يكنى أبا خالد، مولى حكم بن أبي الصلت الثقفي " ق " ويأتي عن " قر " مولى الحكم. 6255 - يزيد بن خليفة الحارثي " كش " " صه " " ق " الحلواني أو الخولاني، عربي روى عن " ق " له كتاب، عنه محمد بن أبي حمزة " جش " واقفي، وفي " ظم " ابن خليفة واقفي، والظاهر أنه غير ما في " كش " و" ق " و" جش ". 6256 - يزيد بن عبد الملك النوفلي " ق ". 6257 - يزيد بن فرقد النهدي " ق " وفي " تعق " يروي عنه أبان في الصحيح 6258 - يعقوب بن ابراهيم، أبو ابراهيم الانصاري " ق ". 6259 - يعقوب أبو يوسف " ق " ويأتي ابن يزيد بن حماد أبو يوسف موثقا، كذا ذكره الميرزا، وقد مضى في طبقة ابن محمد البرقي وأضرابه، واحتمل أيضا أنه ابن اسحاق السكيت الثقة، وفي " تعق " استبعده لانه " ق " وذاك " ج " " دي " ولعله ابن عيثم الآتي، كما ذكره السيد الداماد فانه المناسب هنا. 6260 - يعقوب الاحمر الكوفي، روى عنه ابن مسكان " ق " ويأتي ابن سالم الاحمر. 6261 - يعقوب بن الياس ثقة، وقد مضى في أخيه عمرو وأشرنا أن له أخا آخر يسمى بالرقيم. 6262 
ms505	 - يعقوب بن سالم الاحمر أخو أسباط بن سالم، ثقه من أصحاب الصادق عليه السلام " صه " وفي " شه " عليها قوله " أخو أسباط " يقتضي كون أسباط أشهر منه مع أنه لم يذكره في القسمين ولا غيره، مع أنه كثير الرواية خصوصا بواسطة ولده علي، والظاهر الاتحاد مع الآتي. 6263 - يعقوب بن سالم، أخو أسباط العليم السراج، ثقة من أصحاب(@)(@)(@@) --- PageV01P629 [ 630 ](@)(@)(@@) الصادق عليه السلام وفي نسخة أبو أسباط، وهو غلط. 6264 - يعقوب السراج أو ابن السراج، كوفي ثقة وقال " غض ": ضعيف، واستقرب العلامة في الخلاصة قبول روايته، له كتاب، عنه الحسن بن محبوب وقال المفيد: انه من شيوخ أصحاب " ق " وخاصته. 6265 - يعقوب بن شعيب، له كتاب، مولى بني أسد أبو محمد ثقة، روى عن الصادق عليه السلام، عنه محمد بن أبي عمير، والحسن بن سماعة، وهو ابن شعيب بن ميثم التمار، كما في " صه " وفي " قر " الاسدي بدون التمار، وفي " ق " الكوفي أيضا ولكن بدونه أيضا. 6266 - يعقوب بن عذافر، عنه يونس بن يعقوب " ق ". 6267 - يعقوب بن عيثم، قال في " تعق ": للصدوق طريق إليه ولذا حسنه خالي، ويروي عن أبان وابن أبي عمير، وفيه اشعار بقوته ووثقاته. وفي الرواشح أبو يوسف يعقوب، ذكره الشيخ في كتاب " جخ " وفي " ق " وهو ابن عيثم، ويظهر من العلامة في " صه " صحة حديثه حيث عد طريق الصدوق إليه صحيحا، ففي " مشكا " من توصيفه بالمجهول فيه ما لا يخفى. 6268 - يعقوب بن الفضل بن يعقوب الهاشمي أخو اسماعيل، روى عن " ق " و" ظم " عليهما السلام. 6269 - يعقوب بن قيس البجلي الدهني أبو خالد، والد يونس بن يعقوب " ق ". 6270 - يعلى بن الحارث المحاربي الكوفي " ق ". 6271 - يوسف، في " كش " ذكر ما يدل على اقراره بالائمة عليه السلام الى أن انتهى الى الصادق عليه السلام وعرض له دينه، فصدقه، وقال عليه السلام له: رحمك الله مرارا، وذكر في المنتهى أنه ابن ابراهيم الآتي احتمالا، يكون داود الراوي في " كش " ابنه. ثم ذكر عن السيد الداماد في حاشيته 
ms506	 على " كش " أن هذا ابن ثابت أبو أمية الثقة. وكلاهما رجم بالغيب، وان كان الاطلاق ينصرف الى الاخير كما في(@)(@)(@@) --- PageV01P630 [ 631 ](@)(@)(@@) الحاشية. 6272 - يوسف بن ابراهيم أبو داود " ق " وفي نسخة أبي داود، وهو: إما غلط، أو الجر على سبيل الحكايه، وفي " تعق " عن " يب " يوسف بن محمد بن ابراهيم وكذا عن " ق " ثم استظهر أن نسبته الى ابراهيم نسبة الى الجد لشهرته، وكذا استظهر اتحاده مع الطاطري، كما احتمله الميرزا فيه ونشير إليه. 6273 - يوسف بن أبي القاسم " ق ". 6274 - يوسف البزاز أبو يعقوب " ق ". 6275 - يوسف بن ثابت أبو امية، كوفي ثقه، روى عن " ق " له كتاب، عنه ثعلبة بن ميمون " جش " " ست " ثم كرره في " ق " يوسف بن ثابت، والظاهر الاتحاد وان كان التكرار يفيد التغاير، وفي " مشكا " ابن ثابت الثقة، عنه ثعلبة، وهو عن الصادق عليه السلام. 6276 - يوسف الطاطري " ق " وفي سند الفقيه أولا هكذا ثم يوسف بن ابراهيم الطاطري، احتمل الميرزا اتحاده مع الاول. 6277 - يوسف بن عبد الرحمن الكناسي الكوفي " ق ". 6278 - يوسف بن يعقوب الجعفي، كوفي روى عن " ق " عليه السلام، له كتاب، يحيى بن زكريا عنه به " جش " " صه " وفيها أيضا وهو ضعيف مرتفع القول، وفي " تعق " تضعيفه من " غض " ومر الكلام فيه مرارا وفي المنتهى بعده: لو تم ما ذكره سلمه الله لخرج من الضعف الى الجهالة. أقول: يمكن أن يكون نظره بعدما في " غض " الى تأييدات أخر، فتأمل. 6279 - يونس بن أبي اسحاق السبيعي " ق " يأتي في ثوير بن أبي فاختة ما يدل على شدة تعصبه في مذهب العامة. واستظهر الميرزا أنه وأبوه من العامة، وفي نسخة أصح يكنى أبا اسحاق. 6280 - يونس بن بهمن، غال خطابي كوفي يضع الحديث، روى عن الصادق عليه السلام " صه " " غض " وفيه غال كوفي يضع الحديث.(@)(@)(@@) --- PageV01P631 [ 632 ](@)(@)(@@) 6281 - يونس بن رباط كوفي " ق " البجلي، مولاهم كوفي ثقة، روى عن الصادق عليه السلام " صه " أربعة أخوة الحسن والحسين وعلي ويونس، كلهم من أصحاب الصادق 
ms507	 عليه السلام ولهم أولاد كثيرة من حملة الحديث قاله نصر " كش ". 6282 - يونس الشيباني " ق ". 6283 - يونس بن الصباح " ق " " كش " ممدوح، وقال الميرزا عندي أنه اشتباه، أي ليس فيه مدح، فيكون مدحه في كلام " د " اشتباه. 6284 - يونس بن ظبيان الكوفي " ق " قال " كش " عن " فش " أنه من الكذابين المشهورين و" جش " أنه مولى ضعيف جدا غال كذاب وضاع، روى عن الصادق عليه السلام، عنه محمد بن موسى خورا، ورد اللعن فيه عن " ضا " عليه السلام مع أبي الخطاب. 6285 - يونس بن عبد الرحمن الصيرفي التغلبي كوفي " ق ". 6286 - يونس النسائي، روى عنه صالح بن عقبة " ق ". 6287 - يونس بن يعقوب بن قيس أبو علي الجلاب البجلي الدهني " جش " " صه " له كتب، ثقة من أصحاب " ق " و" ظم " عليهما السلام روى عنهما، مات بالمدينة في أيام الرضا عليه السلام الا أن " كش " عن معد عده من الفطحية. 6288 - أبو ابراهيم البصري " ق ". 6289 - أبو ابراهيم الموصلي، يروي عنه ابن أبي نصر " تعق " أقول: وهو البزنطي المعاصر لابن أبي عمير، ومن الستة الثالثة من أصحاب اجماع " كش ". 6290 - أبو أحمد الاشجعي الكوفي، هو محمد بن زياد، وقد مر عن " تعق " استظهار اتحاده مع أبي اسماعيل، وفيه نظر كما أشرنا في الاسماء. 6291 - أبو أحمد البصري الثقة، هو عمر بن الربيع الراوي عن " ق " عليه السلام، وقد مر في الاسماء. 6292 - أبو أحمد الصيرفي الاسدي الثقة، هو عمرو الحريث الماضي في الاسماء.(@)(@)(@@) --- PageV01P632 [ 633 ](@)(@)(@@) 6293 - أبو أحمد العبسي الكوفي مجهول، اسمه عائذ بن حبيب وأخوه الربيع عربيان " تعق " في اسمه. 6294 - أبو أحمد القلالي، وهو أسيد بن عبد الرحمن. 6295 - أبو أحمد النخعي، هو عيسى بن حيان. 6296 - أبو الاحوص المصري، من جهله متكلمي الامامية، لقيه الحسن بن موسى النوبختي وأخذ عنه، واجتمع معه في الحائر على ساكنه السلام وكان ورد للزيارة، وله مع الجبائي مجلس في الامامة بحضرة الكرخي. 6297 - أبو ادريس هو تليد بن سليمان المحاربي، عنه الحسين بن محمد 
ms508	 بن علي الازدي بكتابه في " جش " في اسمه. ويظهر من ابن نمير أن له كنية أخرى وهي أبو الحجاف، ونسبته الى الرفض في شتمه أبا بكر وعمر في كتب العامة، تدل على الجلالة وكونه اماميا شيعيا، كما في " هب " و" قب " وابن داود. 6298 - أبو ادريس الكوفي، هو عبد الرحمن بن بدر، كما في " تعق " عن النقد بدون الكوفي. 6299 - أبو أسامة زيد الشحام، وقد تقدم في الاسماء. 6300 - أبو اسحاق الخراساني من أصحاب " ق " عليه السلام " ضا " ولم يتعرض فيه لاسمه، والموصوف بهذه الكنية في هذه الطبقة كثير. 6301 - أبو اسحاق السبيعي، وقد تقدم عمرو بن عبد الله أو عمر، والسبيع بطن من همدان، وفي كتاب الاختصاص أنه ولد في الليلة التي قبض فيها أمير المؤمنين عليه السلام وقد مر أنه من الثقات، الا أنه قد نقل عن الميرزا في الكنى وفي الوسيط بكونه من العامة، فتأمل. 6302 - أبو اسحاق صاحب اللؤلو، وفي التهذيب في الصحيح، عن صفوان بن يحيى، عن ابن مسكان عنه " تعق " أقول: لم أقف على اسمه، ولم يذكره رحمه الله ولا غيره، والظاهر أن اسمه اسحاق كما يعرف من ترجمته. 6303 - أبو اسحاق الفقيه، هو ثعلبة بن ميمون، صرح به " كش " في ترجمة(@)(@)(@@) --- PageV01P633 [ 634 ](@)(@)(@@) جميل بن دراج. 6304 - أبو اسحاق المزني، هو ابراهيم بن سليمان بن أبي داحة. وداحة أمه وقيل: كانت جارية لابنه نسب إليها. وقيل: أبوه اسحاق بن أبي سليمان، فوقع الاشتباه، فحول لفظ أبي سليمان الى داحة. 6305 - أبو اسحاق النحوي، هو أيضا ثعلبة بن ميمون. 6306 - أبو اسحاق الهمداني، هو السبيعي. 6307 - أبو اسحاق اليمني، اسمه ابراهيم بن محمد بن أبي يحيى، والظاهر أنه مدني لا يمني، ولعل النسخة التي أخذناه مغلوطة، قال في المنتهى بعد كلام له وأنت إذا أحطت بما مر مما قاله فيه مشايخ الفريقين وعلماء الطائفتين لا أظنك ترتاب في تشيعه انتهى. أقول: بل وفي وثاقته. وفي " مشكا " ابن أبي يحيى عن ابن محمد الازدي عنهما. 6308 
ms509	 - أبو اسماعيل الاشجعي الحذاء، هو محمد بن سالم. 6309 - أبو اسماعيل البصري، له كتاب، عنه ابن أبي عمير " ست " ويعرف بالازدي أيضا، واسمه حماد بن زيد البصري، كما في " مشكا " وفيه أيضا أبو اسماعيل البصري الثقة، عنه ابن أبي عمير، والظاهر كونه اماميا ثقة. 6310 - أبو اسماعيل السراج عبد الله بن عثمان بن عمرو الفزاري أخو حماد، وفي الوجيزة أبو اسماعيل السراج كأنه عبد الله بن عثمان الثقة، الا أن في " تعق " في عدة من نسخ عن محمد بن اسماعيل عن أبي اسماعيل عن عبد الله بن عثمان، وكذا في نسخة من " قي " والظاهر هو ما مر. 6311 - أبو اسماعيل الشعيري، هو بشار، وفي الحديث قال الصادق عليه السلام لعن الله بشارا يامرازم قل لهم ويلكم توبوا الى الله، فانكم كافرون مشركون، وهو الاشعري الماضي في الاسماء.(@)(@)(@@) --- PageV01P634 [ 635 ](@)(@)(@@) 6312 - أبو اسماعيل الصائغ الثقة الانباري، اسمه ثابت بن شريح. 6313 - أبو اسماعيل الفراء، له كتاب، القاسم بن اسماعيل عن عبيس بن هشام عنه " ست " وفي " تعق " روى عنه الحسن بن محبوب، كما في سورة يوسف عن مجمع البيان. 6314 - أبو اسماعيل الفرائضي الثقة، هو اسحاق بن جندب من رجال " ق " عليه السلام. 6315 - أبو اسماعيل الكندي، محمد بن حيان. 6316 - أبو اسماعيل المدني كوفي، وهو محمد بن حميد. 6317 - أبو اسماعيل النوا، كثير بن قاروند. 6318 - أبو الاسود، هو عمر بن محمد بن يزيد بياع السابري، وقد مر بعنوان ابن يزيد في الاسماء. 6319 - أبو الاسود الغمشاني، جبير بن حفص. 6320 - أبو الاشعث، محمد بن حماد المزني. 6321 - أبو الاشهب النخعي، اسمه جعفر بن الحارث. 6322 - أبو الاعز النخاس، لم أقف على اسمه، الا أن في مشيخة الصدوق (ره) يوري عنه صفوان، وابن أبي عمير، وفيها تنبيه على الاعتماد. 6323 - أبو أمية، يوسف بن ثابت الثقة. 6324 - أبو أمية الاسدي، كنية لعبد الله بن عبد الرحمن على ما في " صه " أو لابيه، كما يستفاد من " جش " في ترجمة ابنه. 6325 - أبو 
ms510	 أيوب البجلي، منصور بن حازم، وهو في السابقة أيضا. 6326 - أبو أيوب الخزاز، اسمه ابراهيم بن عيسى أو عثمان، وقد مضى في الاسماء، وقيل ابن زياد كما عن المجمع، الا أنه جعل الخزاز بالمهملة ثم المعجمة بينهما ألف وذكر بالمعجمتين في عنوان على حدة. 6327 - أبو أيوب الشاذكوني، سليمان بن داود المنقري.(@)(@)(@@) --- PageV01P635 [ 636 ](@)(@)(@@) 6328 - أبو أيوب الصيرفي هلال بن مقلاص. 6329 - أبو البختري، اسمه وهب بن وهب وقد مر. 6330 - أبو بدر، لم يذكر اسمه، كوفي، له كتاب يرويه عدة، منهم محمد بن سنان، ومحمد بن عيسى بن عبيد " ست " وعن مقدمة ابن حجر أبو بدر شجاع بن وليد. 6331 - أبو بشر العبدي، مسعدة بن صدقة عامي. 6332 - أبو بصير، عبد الله بن محمد الاسدي " كش " بسنده عنه عن الصادق عليه السلام. 6333 - أبو بكر التميمي الكلبي اليربوعي عباد بن صهيب. 6334 - أبو بكر صاحب المغازي، محمد بن اسحاق، وفي " قب " أبو بكر المطلبي، مولاهم المدني نزيل العراق امام المغازي، صدوق يدلس رمي بالتشيع والقدر من صغار الخامسة. 6335 - أبو بكر الصنعاني الحافظ المشهور عبد الرزاق بن همام " تعق " وفي " هب " مات عن خمس وثمانين سنة في أحد عشر ومائتين، وكذا عن كامل التواريخ، ثم ذكر فيه كان يتشيع، وفي النقد في الاسماء يظهر من كتب العامة أنه شيعي يروي عن معمر بن راشد، وفي كونه في هذه الطبقة محل تأمل، كما أشرنا في عنوان اسمه. 6336 - أبو بكر المخزومي، قطر بن خليفة. 6337 - أبو البلاد، اسمه يحيى بن سليم أو سليمان، وفي " ق " ابن أبي سليمان كما تقدم. 6338 - أبو بلال المكي، قال في سند صحيح رأيت الصادق عليه السلام طاف بالبيت، ثم صلى فيما بين الباب والحجر الاسود ركعتين، فقلت له ما رأيت أحدا منكم صلى في هذا الموضع، فقال هذا المكان الذي تيب فيه على آدم. 6339 - أبو جعفر الاشعري، محمد بن المفضل. 6340 - أبو جعفر البغدادي، محمد بن الخليل، وفي المنتهى المشهور في لقبه أبو جعفر 
ms511	 السكاك.(@)(@)(@@) --- PageV01P636 [ 637 ](@)(@)(@@) 6341 - أبو جعفر الحلبي، محمد بن علي بن أبي شعبة. 6342 - أبو جعفر الخثعمي محمد بن حكيم، وهو في السابقة أيضا. 6343 - أبو جعفر الرواسي، محمد بن الحسن بن أبي سارة. 6344 - أبو جعفر الصيقل، أحمد بن الحسين بن عمر بن يزيد. 6345 - أبو جعفر النهدي، محمد بن عمران. 6346 - أبو جعفر اليشكري، محمد بن سنان. 6347 - أبو الجحاف، كشداد محلة بنيشابور، اسمه داود بن أبي عوف، وثقه " عقد " مع أبي حيان. 6348 - أبو جميلة، هو المفضل بن صالح ضعيف، قد تقدم في عنوانه. 6349 - أبو جند بن عمرو الذي عقر الجمل " ق " وفي " د " ابن عميدي عقر الجمل. 6350 - أبو الجهم الكوفي، ثوير بن أبي فاختة " تعق " وفي " كش " سوى ما مر في اسمه عن ثوير قال خرجت حاجا فصحبني عمرو بن ذر القاضي وابن قيس الماصر والصلت بن بهرام، وكانوا إذا نزلوا منزلا قالوا أنظر الآن فقد حررنا أربعة آلاف مسألة، فسأل أبا جعفر عليه السلام عنها عن ثلاثين كل يوم وقد قلدناك ذلك، الحديث. 6351 - أبو حبيب الاسدي روى عن الصادق عليه السلام، واسمه ناجية قد مر. 6352 - أبو حبيب الناجي، له كتاب، عنه ابن مسكان " جش " ولعله السابق فيكون ناجية بن أبي عمارة، الا أن في " تعق " قال لم أطلع الى الآن على وجه ظهور الاتحاد الذي ذكره المصنف. أقول: وما يؤمي إليه الاشتراك في الكنية والراوي وعلى التعدد هو مجهول. 6353 - أبو الحجاج، لم أقف على اسمة، الا أنه روى عنه عثمان بن عيسى الرواسي، والظاهر أنه في التالية أيضا، إذ ذكره الشيخ في " قر ".(@)(@)(@@) --- PageV01P637 [ 638 ](@)(@)(@@) 6354 - أبو حجية، يحيى بن عبد الله بن معاوية. 6355 - أبو حذيفة الكاهلي الخراساني، اسحاق بن بشر. 6356 - أبو الحارث، كثير بن كلثم، وقيل أبو الفضل. 6357 - أبو الحارث، محمد بن عبد الرحمن. 6358 - أبو الحسن الاسدي، علي بن عقبة بضم المهملة، وهو ثقة يروي عن أبيه، ومضى في ترجمة صالح بن عقبة احتمال كونه أخوه، الا 
ms512	 أنه مجهول الحال. 6359 - أبو الحسن الموصلي، روى عن " ق " عليه السلام روى عنه أحمد البزنطي في " قى " كثير، فلا بأس بالعمل بروايته إذا كان هو راوية، فانه من أهل اجماع " كش ". 6360 - أبو حفص الثوري، عمر بن سعيد. 6361 - أبو حفص الرماني، وأبو هارون السنجي، لهما كتابان، رويناهما عن جماعة عن التلعكبري عن ابن همام عن حميد عن القاسم بن اسماعيل عنهما " ست " أقول: وقد تقدم أن اسمه عمر بن حفص. 6362 - أبو الحكم الجواليقي، هشام بن سالم. 6363 - أبو الحكم الكندي، هشام بن الحكم. 6364 - أبو الحكم المجهول، عمار بن اليسع على ما في النقد. 6365 - أبو الحكيم الجمحي، زيد بن عبد الله. 6366 - أبو الحكيم الدهني، معاوية بن عمار، والظاهر أنه كنية لعمار أبي معاوية. 6367 - أبو حماد الحنفي، مفضل بن صدقة، أو ابن سعيد. 6368 - أبو حماد القيسي الجعفري، عطاء بن سالم. 6369 - أبو حنيفة التميمي، نعمان بن ثابت، أحد الاركان الاربعة باعتقاد العامة. 6370 - أبو حنيفة سابق الحاج، له كتاب، عنه ابن أبي عمير " ست " اسمه(@)(@)(@@) --- PageV01P638 [ 639 ](@)(@)(@@) سعيد بن بيان " صه " وقد تقدم. 6371 - أبو حيان، وقد تقدم توثيقه مع أبي الحجاف. 6372 - أبو خالد القماط، له كتاب، قال عقد اسمه كنكر عنه ابن سماعة، ومحمد بن سنان " ست " وفي " صه " اسمه يزيد، وتقدم عن " صه " و" جش " خالد بن يزيد أبو خالد القماط، وعن " كش " في ابن ميمون أبو خالد صالح القماط. 6373 - أبو خديجة، سالم بن مكرم " صه " ويقال لسالم بن سلمة وتقدم. 6374 - أبو الخزرج، طلحة بن زيد. 6375 - أبو الخطاب، زحر بن النعمان الاسدي، وقد تقدم عن " ق " في عنوانه. 6376 - أبو الخطاب ملعون، ويقال لمحمد بن مقلاص، ومحمد بن أبي زينب " صه " وقد تقدم، وأمره مشهور من الدساسين المعروفين. 6377 - أبو الخلاد، الحكم بن الحكيم الصيرفي، ويقال لمحمد بن خلاد. 6378 - أبو ذر الكوفي، عمار الجهني من المجاهيل. 6379 - أبو الربيع الاقطع، سليمان بن خالد. 6380 - أبو الربيع الشامي، اسمه 
ms513	 خليد ابن أوفى ويقال خالد كما قدمنا، وفي " صه " خليد بن أر في، وهو تصحيف من بعض النساخ، يروي عنه خالد بن جرير، وعبد الله بن مسكان، والحسن بن رباط. 6381 - أبو الربيع القزاز، عنه ابن أبي عمير في الصحيح " تعق ". 6382 - أبو رفاعة، الحجاج بن رفاعة وقيل أبو علي. 6383 - أبو رويم، طلاب بن حوشب الشيباني. 6384 - أبو زكريا " ق " لم أقف على اسمه. 6385 - أبو زكريا الذي حدث عنه خالد بن عيسى العكلي " ق ". 6386 - أبو زياد النهدي، عنه ابن أبي عمير في الصحيح " تعق ". 6387 - أبو زينب، اسمه مقلاص، ولعله في التالية.(@)(@)(@@) --- PageV01P639 [ 640 ](@)(@)(@@) 6388 - أبو سعيد، روى عنه عبد الله بن بكير " جخ " أقول: يحتمل كونه هو الآتي بعيده ابن تغلب، والله أعلم. 6389 - أبو سعيد البكري، هو أبان بن تغلب. 6390 - أبو سعيد البكري، في بكر بن حبيب ما يظهر منه جلالتة " تعق ". 6391 - أبو سعيد القماط، هو خالد بن سعيد " صه " وقد تقدم في الاسماء أنه ثقة. 6392 - أبو سعيد المكاري، له كتاب " جش " " ست " عنه القاسم بن اسماعيل القرشي في الثاني، اسمه هاشم بن حيان أو هشام، وقد تقدم، وفي " مشكا " أبو سعيد المكاري الواقفي، عنه المذكور، وعثمان بن عبد الملك، ويحيى بن عمران الحلبي. 6393 - أبو سليمان الحمار، له كتاب، عنه الحسن بن محبوب " ست " اسمه داود بن سليمان ثقة. 6394 - أبو سيار، هو مسمع بن عبد الملك، وهو أوجه من أخيه، وقد تقدم. 6395 - أبو شبل بياع الوشى، علي بن النعمان عنه بكتابه عن " ق " عليه السلام " جش " عنه القاسم بن اسماعيل، اسمه عبد الله بن سعيد، وقد تقدم أنه ثقة، وأنه يروي عن " ق " بلا واسطة. 6396 - أبو شعبة الحلبي ثقة " صه " تقدم مع ابنه عبيد الله بن علي توثيقة. 6397 - أبو الصباح الكناني، اسمه ابراهيم بن نعيم " صه " وقد تقدم أنه الميزان، عنه محمد بن الفضل وصفوان بكتابه. 6398 - أبو الصباح مولى آل سام، له كتاب، عنه محمد بن أبي 
ms514	 عمير، والقاسم بن اسماعيل " ست " تقدم عن " ست " و" ق " صبيح مولى بسام. 6399 - أبو صدقة، بشر بن سلمة، وفي المجمع أبو صدقة الكوفي. أقول: هو من أصحاب الصادق عليه السلام كما في الاسماء. 6400 - أبو الصقر الكوفي " ق " لم أظفر على اسمه ونسبه ووصفه.(@)(@)(@@) --- PageV01P640 [ 641 ](@)(@)(@@) 6401 - أبو ضمرة المدني، هو أنس بن عياض، ويلقب بالليثي كما في الاسماء ويكنى بأبي حمزة بالحاء المهملة لا الضاد المعجمة كما في كثير من النسخ. 6402 - أبو طالب الازدي الشعراني، له كتاب يرويه محمد بن خالد البرقي " جش " " صه " الا البصري " ست " قال أصحابنا لا نعرف هذا الرجل الا من جهته في الاولين. 6403 - أبو ظبيان، يقال لمحمد بن مقلاص، وهذا هو أبو الخطاب الملعون المشهور صاحب البدع المكنى بأبي اسماعيل أيضا. وقال أبو جعفر بن بابوية اسم أبي الخطاب زيد فلاحظ. 6404 - أبو عاصم المديني " ق ". 6405 - أبو العباس البقباق، الفضل بن عبد الملك. 6406 - أبو العباس الكوفي، الوليد بن صبيح. 6407 - أبو عبد الرحمن الاعرج الكوفي " ق " له كتاب، عنه القاسم بن اسماعيل " ست " لا بتمامه، واسمه أيوب بن عطية الثقة، وقد ذكره الميرزا في التخليص، ولعل نظر الشيخ أبي علي من نسبة الميرزا الى الغفلة عن ذكره انما هو في كتابه الكبير لا الوسيط. 6408 - أبو عبد الرحمن الحذاء، هو أيوب بن عطية " تعق " أقول احتمل في الحاوي أن يكون الاعرج غير هذا، الا أن " د " جعلهما واحدا، كما في ظاهر غيره. 6409 - أبو عبد الله " ق " لم أقف على اسمه، ولعله الذي وصفه في " تعق " بالخزاز ثم قال عنه ابن أبي عمير في الحسن كالصحيح، وعلى هذا معروف، وعلى الاول مجهول، ولذا لم يذكره في المنتهى بما في " ق ". 6410 - أبو عبد الله الذي يروي عنه سيف بن عميرة " ق ". 6411 - أبو عبد الله الشيباني، اسمه ميمون أبو عبد الرحمن بن أبي عبد الله، وقد تقدم مع ابنه. 6412 - أبو عبد الله صاحب المغازي، محمد بن اسحاق بن يسار، 
ms515	 وفي " قب "(@)(@)(@@) --- PageV01P641 [ 642 ](@)(@)(@@) أبو بكر المطلبي مولاهم المدني نزيل العراق امام المغازي صدوق يدلس ورمي بالتشيع والقدر من صغار الخامسة. 6413 - أبو عبد الله الفراء " قي " له كتاب عنه ابن أبي عمير " ست " وفي " تعق " المشهور أن الفراء " جخ " وقال جدي انه سليم الفراء وهو الظاهر، ولعله لذا حكم خالي بوثاقته، ويؤيده رواية ابن أبي عمير عنه. 6414 - أبو عبيدة الحذاء، اسمه زياد بن عيسى، أو ابن رجاء، أو ابن أبي رجاء، وقد تقدم. 6415 - أبو عتاب يقال لزياد بن مسلم من أصحاب الصادق عليه السلام ويقال لعبد الله بن بسطام أخي الحسين، وقد يجئ لغيرهما الا أنه يختلف في الطبقة كما لا يخفى. 6416 - أبو عثمان " ق " لم أقف على غيره في غيره. 6417 - أبو عثمان الاحول، له كتاب، عنه صفوان " ست " " جش " واستظهر الشيخ أبو علي أنه المعلى بن عثمان وفاقا للمجمع، ولا يخفى قربه كما يظهر من ترجمته، فلاحظ. 6418 - أبو عدي، عثمان بن زيد " تعق " أقول: قد مضى في الاسماء في " جخ " أنه اسند عنه. 6419 - أبو عرة " ق " هكذا وجدته من دون ذكر الاسم والوصف. 6420 - أبو العطارد الخياط، روى عن " ق " عليه السلام، روى عنه اسحاق بن عمار، وقد تقدم في الذوات حماد بن أبي العطارد. 6421 - أبو العلاء الشيباني الكوفي، هو الحارث بن زياد. 6422 - أبو علي الجريري الكوفي " ق ". 6423 - أبو علي الخزاز، عنه الحجال والبزنطي في الصحيح " تعق ". 6424 - أبو علي الذي حدث عنه حصين بن المخارق " ق ". 6425 - أبو علي صاحب الانماط كوفي " ق ".(@)(@)(@@) --- PageV01P642 [ 643 ](@)(@)(@@) 6426 - أبو علي صاحب الشعير، روى عن محمد بن قيس، عنه ابن أبي عمير. 6427 - أبو علي صاحب الكلل، روى عن أبان بن تغلب، روى عنه أبو أيوب، وفي " تعق " في الكافي عن ابن أبي عمير عنه عن أبان. قال جدي صاحب الكلل أي صانع أو بايع البيت الرقيق لدفع البق، ولم يذكره الاصحاب، وذكر الشيخ في الرجال أبا علي صاحب الانماط، وهو ما يلقي 
ms516	 على الهودج مثل الكلة. 6428 - أبو علي الصائغ صبيح، مجمع عنه المنتهى. 6429 - أبو علي العبسي، أحمد بن عائذ " غين " في المنتهى. 6430 - أبو عمارة الجهني، محمد بن عثمان بن زيد. 6431 - أبو عمارة العجلي، محمد بن أحمد " غين " في المنتهى. 6432 - أبو عمرو الاسدي الفاخري، حفص بن سليمان " غين " في المنتهى. 6433 - أبو عمر العبسي، سعيد بن الحسن " غين " في المنتهى. 6434 - أبو عمر الاعمى الكوفي " ق ". 6435 - أبو عمر المدني " ق ". 6436 - أبو عيسى، والظاهر أنه الوراق صاحب ثبيت بن محمد، وفي ترجمته مدح عظيم يدل على جلالته، والسيد الداماد قد بالغ فيها ثمة. 6437 - أبو عيينة، عن أبي عبد الله عليه السلام في بعض الروايات، غير مذكور في كتب الرجال. 6438 - أبو غزارة المكي، محمد بن عبد الرحمن بن أبي بكر " غين " في المنتهى. 6439 - أبو غسان، حميد بن سعيد ثقة، قد مضى في الاسماء 6440 - أبو الغمر، روى " كش " في طريق صحيح عن علي بن مهزيار قال سمعت أبا جعفر عليه السلام يلعنه، ويظهر منه أنه من أصحاب أبي الخطاب المعلون، ويأتي في جعفر بن واقد في التالية.(@)(@)(@@) --- PageV01P643 [ 644 ](@)(@)(@@) 6441 - أبو الفرج السندي، له كتاب، عنه أحمد بن رياح " ست " روى عن " ق " عليه السلام اسمه عيسى. 6442 - أبو الفضل الحناط، اسمه سالم أو سلم أو سلام، والاول أصح، روى عن " ق " عليه السلام وتقدم. 6443 - أبو الفضل الحنفي، ويقال له الحناط أيضا، عاصم بن حميد بضم الحاء وفتح الميم. 6444 - أبو الفضل الخولاني، ادريس بن الفضل، قد مر في السابقة. 6445 - أبو الفضل الساباطي، عمار بن موسى. 6446 - أبو الفضل العنزي، محمد بن الوليد. 6447 - أبو الفضل القندي الانباري، زياد بن مروان " غين " في المنتهى. 6448 - أبو القاسم البجلي، معاوية بن عمار، ويكنى أيضا أبا معاوية وأبا حكيم، وأولاده القاسم وحكيم ومحمد. 6449 - أبو القاسم البجلي، عيص بن القاسم. 6450 - أبو القاسم النهدي، العلاء بن فضيل بن يسار، عنه محمد بن سنان، وابن أبي عمير، 
ms517	 وسيجئ أن أباه من أصحاب اجماع " كش " من الستة الاولى. 6451 - أبو قتادة القمي، اسمه علي بن محمد بن حفص ثقة، روى عن " ق " عليه السلام كما تقدم. 6452 - أبو قيس مولى قريش " ق ". 6453 - أبو كهمش أو أبو كهمس، له كتاب، عنه القاسم بن اسماعيل القرشي " ست " اسمه هيثم بن عبد الله أو ابن عبيد وقد مر، وفي " مشكا " أبو كهمس عنه عبد الله بن علي الزراري وهو في السابقة. 6454 - أبو مالك الجهني، له كتاب يرويه أحمد بن محمد بن عيسى، عن ابن أبي عمير عنه " ست " " جش " وفي المنتهى ظاهرهما كونه اماميا وكذا " ب " لذكره من غير قدح، ورواية ابن أبي عمير عنه يشير الى الوثاقة، روراية جماعة كتابه الى(@)(@)(@@) --- PageV01P644 [ 645 ](@)(@)(@@) اجلاله، فتدبر. 6455 - أبو مالك الحضرمي هو الضحاك " د " وقد تقدم. 6456 - أبو المحتمل، كوفي ثقة، روى عن الصادق عليه السلام والكاظم عليه السلام أبو المحتمل ثقة من أصحاب " ظم " عليه السلام " صه ". 6457 - أبو محمد الازدي، رقيم بن عبد الرحمن المجهول، وحريز بن عبد الله السجستاني الممدوح البالغ الى أعلى درجات الوثاقة، وبكر بن محمد بن عبد الرحمن الغامدي الثقة، وكلهم في هذه الطبقة. 6458 - أبو محمد الاسدي، يعقوب بن شعيب، وعبد الله بن محمد الحجال على احتمال، إذ هو يكنى بأبي بصير، والعجب من " مشكا " حيث كناه في ترجمته بأبي بصير، وفي ترجمة ابن مهران بأبي محمد، ويأتي لصفوان الجمال أيضا. 6459 - أبو محمد البارقي، عبد الرحمن بن نصر بن عبد الرحمن. 6460 - أبو محمد البجلي، عبد الرحمن بن محمد بن أبي هاشم، والحسن بن عمارة بن أبي المضرب. 6461 - أبو محمد التميمي الاسدي، غياث بن ابراهيم، مجمع عنه المنتهى. 6462 - أبو محمد الثقفي، سكين بن عمار، مجمع عنه المنتهى. 6463 - أبو محمد الحضرمي، زرعة بن محمد. 6464 - أبو محمد الخزاز " جش " " ست " له أصل، عنه ابن أبي عمير " ست " قال " جش " وأبو محمد الفرازي بعد ما مر كتبهما مروي بهذه الاسانيد، وفي المنتهى 
ms518	 ظاهرهما كونه من الامامية، وكذا " ب " ورواية ابن أبي عمير تشير الى الوثاقة، مضافا الى رواية جماعة أصله. 6465 - أبو محمد بن خلاد الكرخي عامي " صه " وفي " ب " بعد ما فيها له كتاب في مناقب أهل البيت عليهم السلام، وهو يشعر بانصافه لا حسن عقيدته. 6466 - أبو محمد الفزاري، له كتاب، عنه ابن أبي عمير " ست " وسبق عن " جش " في أبي محمد الخزاز، واحتمل الشيخ أبو علي كونه عبد الرحمن بن محمد(@)(@)(@@) --- PageV01P645 [ 646 ](@)(@)(@@) الفزاري العرزمي، إذ الدرجة تقبله، ويلوح ذلك من " مشكا ". 6467 - أبو محمد الكاهلي، عبد الله بن يحيى، مجمع عنه المنتهى. 6468 - أبو محمد مؤذن علي بن يقطين اسمه حفص. 6469 - أبو محمد مولى أبي أيوب المكي، هو القاسم بن عروة في المنتهى. 6470 - أبو محمد النوفلي، عبد الله بن الفضيل، مجمع في المنتهى. 6471 - أبو محمد الوابشي، الظاهر أنه عبد الله بن سعيد، وربما يأتي لغيره، وفي " تعق " في الصحيح عن الحسن بن محبوب عنه، وفي " جش " الحسن بن محبوب عنه بكتابه. 6472 - أبو محمد الواسطي، الحسن بن محبوب عنه بكتابه " ست " " جش ". 6473 - أبو مخلد السراج، ابن أبي عمير عنه بكتابه " جش " عنه القاسم بن اسماعيل " ست ". 6474 - أبو مريم الانصاري، له كتاب، عنه الحسن بن محبوب ومحمد بن موسى خورا " ست " اسمه عبد الغفار بن القاسم، ويأتي في التالية لانه الراوي عنهما عليهما السلام. 6475 - أبو مسعود الطائي، روى عنه محمد بن أبي عمير، وفي " تعق " في الصحيح لكن في بعض النسخ " ابن " بدل " أبو " فالظاهر أنه محمد بن مسعود الثقة، لكن روى عنه في الصحيح جعفر بن بشير، فتدبر. أقول: وهو في محله. 6476 - أبو المضارب، مجمع عنه المنتهى. 6477 - أبو معاوية البجلي، هو عمار الدهني، وهو عمار بن أبي معاوية الدهني بضم أوله وسكون الهاء وبعدها نون في المنتهى. 6478 - أبو المعزاء، اسمه حميد " صه " ابن المثنى الصيرفي، قد تقدم أنه ثقة. 6479 - أبو المعزاء الخصاف، قد جاء في سند بعض الروايات، والظاهر 
ms519	 أنه غير المذكور فتدبر، كذا ذكره في التلخيص، وذكره في هذه الطبقة انما هو لاحتمال كونه هو الاول.(@)(@)(@@) --- PageV01P646 [ 647 ](@)(@)(@@) 6480 - أبو المغيرة، عنه حمدا في الصحيح " تعق ". 6481 - أبو المنذر جفير بن الحكم العبدي، أو جيفر كما مر. 6482 - أبو المنذر الكندي، جارود بن المنذر. 6483 - أبو المنذر الناسب، هشام بن محمد، وفي " تعق " بدل الناسب السائب. أقول: ولا منافاة بينهما ولعله يتصف بهما، كما يستفاد من ترجمته. 6484 - أبو المنذر " ق " ويحتمل كونه هو السابق والطبقة تقبله. 6485 - أبو منصور الديراني " ق ". 6486 - أبو موسى البناء حمدويه وابراهيم عن محمد بن عيسى عن ابن أبي عمير عن هشام، قال: دخل أبو موسى البناء على الصادق عليه السلام مع نفر من أصحابه، فقال لهم الصادق عليه السلام احتفظوا بهذا الشيخ، قال فذهب على وجهه في طريق مكة، فذهب من صرح، فلم ير بعد ذلك " كش ". 6487 - أبو موسى الصيقل، عمر بن يزيد بن ذبيان، مجمع في المنتهى. 6488 - أبو ناب الدغشي، اسمه الحسن بن عطية، وقد مر في السابقة، قال معد سألت علي عن أبي ناب الدغشي، قال هو الحسن بن عطية، وعلي بن عطية، ومالك بن عطية كوفيون وليسوا بالاحمسية، ثم ان الدغشي بالمهمله ثم بالمعجمتين. 6489 - أبو ناشرة، سماعة بن مهران بن عبد الله الحضرمي، مات في حياته عليه السلام. 6490 - أبو نجران أبو عبد الرحمن بن أبي نجران، واسمه عمرو بن مسلم التميمي، روى عن الصادق عليه السلام. 6491 - أبو نصر الاسدي، محمد بن قيس الكوفي، وليس أبو عبد الله البجلي الثقة، وان استظهره بعض مهرة الفن، ولكن لم يعلم وجهه، فتأمل. 6492 - أبو نعيم البصري الهذلي، ربعي بن عبد الله " غين " في المنتهى. 6493 - أبو ولاد، اسمه حفص " صه " يقال أبو ولاد الحناط، واسمه حفص(@)(@)(@@) --- PageV01P647 [ 648 ](@)(@)(@@) بن سالم، وقيل ابن يونس ثقة روى عن الصادق عليه السلام. 6494 - أبو الوليد الازدي، عمر بن عاصم، مجمع عنه المنتهى. 6495 - أبو الوليد القيسي، اسماعيل بن كثير البكري، مجمع 
ms520	 عنه المنتهى. 6496 - أبو الوليد المحاربي، ذريح بن محمد بن يزيد، مجمع عنه المنتهى. 6497 - أبو وهب الحارث بن غصين، مجمع في المنتهى. 6498 - أبو هارون السنجي، مولى بني امية، قيل ان اسمه ثابت بن ثوية " جش " له كتاب، القاسم بن اسماعيل عن عبيس عنه فيه أيضا وفي " ست " في موضع وفي آخر بلا واسطة. 6499 - أبو هارون المكفوف، له كتاب، عنه عبيس بن هشام، وفيه حديث عن الصادق عليه السلام دال على القدح العظيم فيه. 6500 - أبو الهذيل، اسمه غالب بن الهذيل، وفي المنتهى أبو الهذيل العلاف عامي مشهور وغيره مجهول. 6501 - أبو هريرة البزاز، قال " عق " ترحم عليه الصادق عليه السلام وقيل له انه يشرب الخمر النبيذ، فقال: أيعز على الله أن يغفر لمحب علي على شرب النبيذ والخمر " صه ". 6502 - أبو هلال الذي حدث عنه يعقوب بن سالم " ق ". 6503 - أبو هلال الرازي، روى عن " ق " عليه السلام، روى عنه حفص بن البختري. 6504 - أبو الهيثم، يقال أيضا لخالد بن عبد الرحمن نقد عنه " تعق " وفي المنتهى يلقب هذا بالعطار، كما تقدم في الاسماء. 6505 - أبويحيى الحناط، له كتاب، عنه الحسن بن محبوب " ست " وفي " جش " الخياط الحسن بن سماعة بكتابه، وفي " ظم " الطحان ويقال حناط، ورواية الحسن بن محبوب عنه تشير الى الجلالة، مضافا الى رواية جماعة كتابه.(@)(@)(@@) --- PageV01P648 [ 649 ](@)(@)(@@) 6506 - أبويحيى المكفوف، روى عن الصادق عليه السلام، له كتاب، عنه عمر بن طرحان " ست " " جش " وفي " تعق " مضى في عمر هذا ما يؤمي الى معروفيته، وظاهر " ست " و" جش " كونه اماميا، ورواية جماعة عنه كتابه كما في الاول تشير الى الاعتماد، فتأمل. 6507 - أبويحيى الصنعاني الذي روى حديث ألف انا أنزلناه في ليلة القدر، وروى في الكافي عنه النص على الجواد عليه السلام. وفي كشف الغمة عن الطبرسي، وكذا المفيد عده من الثقات من أصحابه الراوين النص على امامته هكذا في " تعق " ثم استظهر أنه عمر بن توبة، وهو كذلك، ولا يبعد قبول روايته ببعض الاعتبارات. 