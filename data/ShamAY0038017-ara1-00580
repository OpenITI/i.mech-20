ms561	 عبد الرحمن(@)(@@) يروي عن: سوادة بن الربيع الجرمي، وله صحبة، روى عنه: مرجى بن رجاء.(@)(@@)(@@)(@@) ||| AUTO سلم بن يزيد(@)(@@) يروي عن: أنس بن مالك، روى عنه: يزيد بن أبي حبيب.(@)(@@)(@@)(@@) ||| AUTO سلم بن رشد(@)(@@) يروي عن: ابن عمر، روى عنه: جرير بن عبد الحميد.(@)(@@)(@@)(@@) ||| AUTO سلم بن زياد(@)(@@) يروي عن: ميمونة، روى عنه: عباد بن أبي موسى.(@)(@@)(@@)(@@) ||| AUTO سيار بن معرور التميمي(@)(@@) من أهل الكوفة، يروي عن: عمر، روى عنه: سماك بن حرب.(@)(@@)(@@)(@@) ||| AUTO سيار بن روح(@)(@@) من أهل الشام، يروي عن: أصحاب رسول الله صلى الله عليه وسلم روى عنه: مسلم بن زياد.(@)(@@)(@@)(@@) ||| AUTO أبو المنهال اسمه سيار بن سلامة الرياحي(@)(@@) من أهل البصرة، يروي عن: أبي برزة، روى عنه: أهل البصرة، مات سنة تسع وعشرين ومائة.(@)(@@)(@@)(@@) ||| AUTO سيار الشامي(@)(@@) مولى خالد بن يزيد بن معاوية القرشي، يروي عن: أبي أمامة، وأبي الدرداء، روى عنه: سليمان التيمي.(@)(@@) (152) -[2: 206] ثنا ابن قتيبة، قال: ثنا ابن أبي السري، قال: ثنا معتمر بن سليمان، قال: ثنا أبي، قال: ثنا سيار الشامي، عن أبي الدرداء، أنه " قرأف ولمن خاف مقام ربه جنتانق، قال رجل: وإن زنى وإن سرق، فقال أبو الدرداء: " إذا خاف مقام ربه لم يزن ولم يسرق "(@)PageV01P002(@)(@@) [ج 2: ص 207](@)(@@)(@@)(@@) ||| AUTO سيار بن عبد الرحمن الصدفي(@)(@@) من أهل مصر، يروي المراسيل، روى عنه: سعيد بن أبي أيوب.(@)(@@)(@@)(@@) ||| AUTO سنان بن أبي سنان الدئلي(@)(@@) وهم حلفاء بني دئل، واسم أبي سنان يزيد بن أمية، يروي عن: أبي واقد الليثي، وجابر، وأبي هريرة، روى عنه: الزهري، مات سنة خمس ومائة، وهو ابن اثنتين وثمانين سنة، وكان مولده سنة ثلاث وعشرين.(@)(@@)(@@)(@@) ||| AUTO سنان بن عمرو الأنصاري(@)(@@) من بني عمرو بن عوف، ويقال: سنان بن عبد الله، يروي عن: أنس بن مالك، روى عنه: حيوة بن شريح ونافع بن يزيد المصريان.(@)(@@)(@@)(@@) ||| AUTO سنان بن سعد الكندي(@)(@@) يروي عن: أنس بن مالك، حدث عنه: المصريون، وهم مختلفون فيه، يقولون: سعد بن سنان، وسعيد بن سنان، وسنان بن سعيد، 
ms562	 وأرجو أن يكون الصحيح سنان بن سعد، وقد اعتبرت حديثه، فرأيت ما روى عن سنان بن سعد يشبه أحاديث الثقات، وما روى عن سعد بن سنان، وسعيد بن سنان فيه المناكير كأنهما اثنان فالله أعلم.(@)(@@)(@@)(@@) ||| AUTO سنان بن ربيعة، أبو ربيعة البصري(@)(@@) يروي عن: أنس بن مالك، وهو الذي يقال له: صاحب السابري، روى عنه: حماد بن زيد، وعبد الوارث.(@)(@@)(@@)(@@) ||| AUTO سنان بن أبي منصور الليثي(@)(@@) شامي، مولى واثلة بن الأسقع، يروي عن: واثلة بن الأسقع، روى عنه: أهل الشام.(@)(@@)(@@)(@@) ||| AUTO سنان بن حبيب أبو حبيب السلمي(@)(@@) يروي عن: ابن عمر، روى عنه: الثوري، وإسرائيل وغيرهما.(@)PageV01P002(@)(@@) [ج 2: ص 208](@)(@@)(@@)(@@) ||| AUTO سنان بن جرير العنسي(@)(@@) يروي عن: ابن عمر، روى عنه: عبد الملك الذماري إن كان سمع منه.(@)(@@)(@@)(@@) ||| AUTO سوار بن شبيب السعدي الأعرج(@)(@@) من بني سعد، يروي عن: ابن عمر، وابن مسعود، روى عنه: عوف الأعرابي، وعكرمة بن عمار.(@)(@@)(@@)(@@) ||| AUTO سوار بن الجعد(@)(@@) يروي عن: أبي الدرداء، روى عنه: أبو حريز.(@)(@@)(@@)(@@) ||| AUTO سوار الجرمي(@)(@@) بصري، يروي عن: مالك بن الحويرث، روى عنه: ابناه قتادة بن سوار، وأنيس بن سوار الجرميان، وأبو قلابة.(@)(@@)(@@)(@@) ||| AUTO سوار بن حنظلة العجلاني(@)(@@) يروي عن: سمرة بن جندب، روى عنه: أبو هلال الراسبي.(@)(@@)(@@)(@@) ||| AUTO سوار بن رزيق(@)(@@) يروي عن: الحسن بن علي، روى عنه: مسافر الجصاص.(@)(@@)(@@)(@@) ||| AUTO سوار الكوفي(@)(@@) يروي عن: ابن عباس، روى عنه: يحيى بن أبي كثير.(@)(@@)(@@)(@@) ||| AUTO سوار أبو إدريس المرهي(@)(@@) يروي المراسيل، روى عنه: سلمة بن كهيل.(@)(@@)(@@)(@@) ||| AUTO سيف أبو الهذيل(@)(@@) يروي عن: ابن عمر، روى عنه: مهاجر بن عبد الله العتكي.(@)(@@)(@@)(@@) ||| AUTO سيف بن سبيعة(@)(@@) قال: رأيت ابن عمر اشترى من رجل شيئا، فقال: حط لي دانقا، رواه الفضل بن موسى، عن سلمة بن ضب، عنه، هكذا قاله الشيباني، وقال: علي بن الحسن بن شقيق، عن سلمة بن ضب، عن يوسف بن سبيعة، عن ابن عمر.(@)PageV01P002(@)(@@) [ج 2: ص 209](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO سيف أبو الحسن(@)(@@) يروي عن: أبي سعيد الخدري، روى عنه: العلاء بن 
ms563	 خالد.(@)(@@)(@@)(@@) ||| AUTO سيف المازني(@)(@@) يروي عن: ابن عمر، روى عنه: حميد بن مهران.(@)(@@) سيف(@)(@@) شيخ، يروي عن: عوف بن مالك، روى عنه: خالد بن معدان.(@)(@@)(@@)(@@) ||| AUTO سيف بن وهب، أبو وهب التيمي(@)(@@) بصري، يروي عن: أبي الطفيل، روى عنه: ابنه علية، وربعي بن عبد الله بن الجارود.(@)(@@)(@@)(@@) ||| AUTO سماك بن حرب البكري(@)(@@) من أهل الكوفة، كنيته أبو المغيرة، يخطئ كثيرا، يروي عن: جابر بن سمرة، والنعمان بن بشير، روى عنه: الثوري، وشعبة، كان حماد بن سلمة، يقول: سمعت سماك بن حرب، يقول: أدركت ثمانين من أصحاب النبي صلى الله عليه وسلم ومات في آخر ولاية هشام بن عبد الملك حين ولي يوسف بن عمر على العراق، وهو سماك بن حرب بن أوس بن خالد بن نزار بن معاوية بن عامر بن ذهل.(@)(@@)(@@)(@@) ||| AUTO سماك بن الوليد الحنفي اليمامي، كنيته أبو زميل(@)(@@) يروي عن: ابن عباس، روى عنه: شعبة، ومسعر، وعكرمة بن عمار.(@)(@@)(@@)(@@) ||| AUTO سماك بن سلمة الضبي(@)(@@) من أهل الكوفة، يروي عن: ابن عباس، روى عنه: المغيرة بن مقسم، وأبو نهيك.(@)(@@)(@@)(@@) ||| AUTO سمرة بن جعونة(@)(@@) يروي عن: علي، وابن عمر، روى عنه: أبو إسحاق السبيعي.(@)PageV01P002(@)(@@) [ج 2: ص 210](@)(@@)(@@)(@@) ||| AUTO سمرة بن سهم(@)(@@) يروي عن: أبي هاشم بن عتبة من أصحاب النبي صلى الله عليه وسلم روى عنه: أبو وائل شقيق بن سلمة.(@)(@@)(@@)(@@) ||| AUTO سمرة بن سيسن(@)(@@) يروي عن: ابن عمر، روى عنه: حيوة بن شريح.(@)(@@)(@@)(@@) ||| AUTO سوادة(@)(@@) شيخ من أهل مرو، قال:(@)(@@) (153) -[2: 210] " كنت مع ابن عباس بمكة على الصفا، ومعه عصا وهو يقرع بالعصا موضعا، ويقول: إن الدابة تسمع قرع عصاي هذه، يعني دابة الأرض ". رواه إسحاق بن إبراهيم الحنظلي، قال: ثنا عمرو بن هرمز، قال: حدثني سوادة، قال: كنت مع ابن عباس بمكة(@)(@@)(@@)(@@) ||| AUTO سوادة بن حنظلة القشيري(@)(@@) من أهل البصرة، يروي عن: سمرة بن جندب، وقد سمع من علي بن أبي طالب، روى عنه: شعبة بن الحجاج.(@)(@@)(@@)(@@) ||| AUTO أبو حاجب اسمه سوادة بن عاصم العنزي(@)(@@) من أهل البصرة، ربما 
ms564	 أخطأ، يروي عن: الحكم بن عمرو الغفاري، روى عنه: سليمان التيمي، وعاصم الأحول.(@)(@@)(@@)(@@) ||| AUTO السري بن كعب الأزدي(@)(@@) يروي عن: الحسين بن علي، روى عنه: الثوري.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO سبرة بن المسيب بن نجبة الفزاري(@)(@@) من أهل الكوفة، يروي عن: ابن عباس، روى عنه: ابنه حنظلة بن سبرة.(@)(@@) سبرة(@)(@@) شيخ، يروي عن: أنس، روى عنه: السدي، لا أدرى من هو.(@)(@@)(@@)(@@) ||| AUTO سبرة بن نخف(@)(@@) يروي عن: ابن عباس، روى عنه: سماك بن حرب، وقد قيل: ابن يحيى.(@)PageV01P002(@)(@@) [ج 2: ص 211](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO سميع أبو سالم السلولي(@)(@@) من أهل الكوفة، يروي عن: الحسن بن علي، روى عنه: غالب أبو الهذيل.(@)(@@)(@@)(@@) ||| AUTO سميع الزيات أبو صالح(@)(@@) مولى ابن عباس الهاشمي، يروي عن: ابن عباس، روى عنه: الأعمش.(@)(@@) سميع(@)(@@) مولى عمرو بن حريث، يروي عن: وابصة بن معبد، روى عنه: الحجاج بن أرطأة.(@)(@@) سميع(@)(@@) شيخ، يروي عن: أبي أمامة، روى عنه: عمرو بن دينار المكي، لا أدرى من هو ولا ابن من هو.(@)(@@)(@@)(@@) ||| AUTO سليط بن عبد الله بن يسار المكي(@)(@@) يروي عن: ابن عمر، روى عنه: خالد بن أبي عمران، وبشر بن صحار، وهو أخو أيوب بن عبد الله بن يسار.(@)(@@)(@@)(@@) ||| AUTO سليط بن سليط حجازي(@)(@@) يروي عن: عثمان بن عفان، روى عنه: محمد ابن سيرين.(@)(@@)(@@)(@@) ||| AUTO سليط بن عطية الحنفي(@)(@@) يروي عن: علي وعمار بن ياسر، روى عنه: كليب بن منفعة.(@)(@@)(@@)(@@) ||| AUTO سليط بن سعد السالمي(@)(@@) يروي عن: ابن عمر، روى عنه: سعد بن إسحاق بن كعب بن عجرة.(@)(@@)(@@)(@@) ||| AUTO سحيم(@)(@@) مولى بني زهرة القرشي، يروي عن: أبي هريرة، روى عنه: الزهري.(@)PageV01P002(@)(@@) [ج 2: ص 212](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO سحيم بن نوفل الأشجعي(@)(@@) يروي عن: ابن مسعود، عداده في أهل الكوفة، روى عنه: هلال بن يساف.(@)(@@) سحيم(@)(@@) مولى أبي هريرة، يروي عن: أبي أيوب، روى عكرمة بن عمار، عن محمد بن أيوب، عنه.(@)(@@) سحيم(@)(@@) يروي عن: رويفع بن ثابت البلوي، روى عنه: بكر بن سوادة.(@)(@@)(@@)(@@) ||| AUTO سلامة بن سهم التيمي(@)(@@) يروي عن: علي، روى 
ms565	 عنه: عمر بن سويد.(@)(@@)(@@)(@@) ||| AUTO سلامة العجلي(@)(@@) شيخ، يروي عن: سلمان، روى عنه: سماك بن حرب.(@)(@@)(@@)(@@) ||| AUTO سلامة الكندي(@)(@@) شيخ، يروي عن: علي بن أبي طالب، روى عنه: نوح بن قيس الطاحي.(@)(@@)(@@)(@@) ||| AUTO سهيل بن أبي جندل(@)(@@) يروي عن: بلال، روى عنه: مكحول.(@)(@@)(@@)(@@) ||| AUTO سهيل بن هرمز(@)(@@) يروي عن: أبي هريرة، قال: عهد إلي رسول الله صلى الله عليه وسلم ثلاثا: أن " لا أنام إلا على وتر، وصيام ثلاثة أيام من كل شهر، وركعتي الضحى ". روى عنه: ابن أخيه عبد الله بن هرمز.(@)(@@)(@@)(@@) ||| AUTO سهيل بن عاصم الفقيمي، أبو السوية(@)(@@) من أهل البصرة، وقد قيل: قيس بن عاصم، يروي عن: ابن عمر، روى عنه: عبد الملك بن أبي السوية.(@)(@@)(@@)(@@) ||| AUTO سعدان بن عبد الله بن جابر(@)(@@) مولى بني عامر بن لؤي، من أهل المدينة، يروي عن: أنس بن مالك، روى عنه: ابنه محمد بن سعدان.(@)PageV01P002(@)(@@) [ج 2: ص 213](@)(@@)(@@)(@@) ||| AUTO سهم بن منجاب(@)(@@) يروي عن: العلاء بن الحضرمي في دعواته المستجابة، روى عنه: عبد الملك ابن أخت سهم بن منجاب.(@)(@@)(@@)(@@) ||| AUTO سهم بن حصين الأسدي الكوفي(@)(@@) يروي عن: أبي سعيد الخدري، روى عنه: عبد الله بن شريك.(@)(@@)(@@)(@@) ||| AUTO سريع(@)(@@) مولى عمرو بن حريث المخزومي، يروي عن: علي، وعمرو بن حريث، عداده في أهل الكوفة، روى عنه: قطري الخشاب، وفطر بن خليفة.(@)(@@)(@@)(@@) ||| AUTO سلمى بن عتاب(@)(@@) يروي عن: أبي هريرة، روى عنه: توبة العنبري.(@)(@@)(@@)(@@) ||| AUTO سعر التميمي(@)(@@) يروي عن: علي، روى عنه: علي بن زيد بن جدعان.(@)(@@)(@@)(@@) ||| AUTO سعر بن مالك العبسي(@)(@@) يروي عن: عمر بن الخطاب، روى عنه: حلام بن صالح.(@)(@@)(@@)(@@) ||| AUTO سمعان بن مشنج العمري(@)(@@) يروي عن: سمرة بن جندب، روى عنه: الشعبي، وقد قيل فيه: العنزي.(@)(@@)(@@)(@@) ||| AUTO سمعان المدني أبو يحيى(@)(@@) مولى أسلم، يروي عن: أبي سعيد الخدري، وأبي هريرة، روى عنه: ابناه محمد، وأنيس ابني أبي يحيى، وموسى بن أبي عثمان.(@)(@@)(@@)(@@) ||| AUTO سمير بن نهار(@)(@@) يروي عن: أبي هريرة، روى عنه: محمد بن واسع.(@)PageV01P002(@)(@@) [ج 2: ص 214](@)(@@)(@@)(@@) ||| AUTO سمير بن 
ms566	 معاذ(@)(@@) يروي عن: عائشة، روى عنه: المغيرة بن النعمان.(@)(@@)(@@)(@@) ||| AUTO سفر(@)(@@) مولى سعد بن أبي وقاص، يروي عن: علي، أن رجلا من الأنصار دخل على النبي صلى الله عليه وسلم وعليه خاتم من حديد، فقال رسول الله صلى الله عليه وسلم: " ما لي أرى عليك حلية أهل النار، قال: فاتخذه من شبه فلما أتى عرض على رسول الله صلى الله عليه وسلم قال: ما لي أجد منك ريح الأصنام، قال: فاتخذه من ذهب، فقال: ما لك وعليك حلية أهل الجنة، فقال: كيف أصنع يا رسول الله، قال: اتخذه من فضة ولا تتمه مثقالا ". روى عنه: عبد الله بن مسلم أبو طيبة المروزي.(@)(@@)(@@)(@@) ||| AUTO سميط بن عمير بن جبلة السدوسي(@)(@@) من أهل البصرة، كنيته أبو عبد الله، يروي عن: أنس بن مالك وعمران بن حصين، روى عنه: عاصم الأحول ويقال: سميط بن سمير.(@)(@@)(@@)(@@) ||| AUTO سراج بن مجاعة بن مرارة الحنفي(@)(@@) من أهل اليمامة، يروي عن: أبيه، وله صحبة، روى عنه: ابنه هلال بن سراج.(@)(@@)(@@)(@@) ||| AUTO سبيع السلولي(@)(@@) عن: حذيفة، وابن الزبير، روى عنه: أبو إسحاق السبيعي.(@)(@@)(@@)(@@) ||| AUTO سبيع بن خالد اليشكري(@)(@@) من أهل البصرة، يروي عن: حذيفة، روى عنه: نصر بن عاصم، وصخر بن بدر، وعلي بن زيد، ومن قال: سبيعة بن خالد فقد وهم.(@)(@@)(@@)(@@) ||| AUTO سواد الخزاعي(@)(@@) يروي عن: حفصة، روى عنه: المسيب بن رافع، وسعيد بن خالد.(@)PageV01P002(@)(@@) [ج 2: ص 215](@)(@@)(@@)(@@) ||| AUTO سواد بن رزين(@)(@@) يروي عن: الحسن بن علي، روى عنه: مسافر الجصاص.(@)(@@)(@@)(@@) ||| AUTO سليك بن مسحل الفزاري(@)(@@) يروي عن: عمر، وسعد بن أبي وقاص، وحذيفة، روى عنه: بلال بن يحيى وحلام بن صالح.(@)(@@)(@@)(@@) ||| AUTO سارية بن عبد الله(@)(@@) يروي عن: ابن مسعود، روى عنه: سالم بن أبي الجعد.(@)(@@)(@@)(@@) ||| AUTO سارية الخلجي(@)(@@) يروي عن: أنس بن مالك، روى عنه: أبو حرزة يعقوب بن مجاهد.(@)(@@)(@@)(@@) ||| AUTO السميط بن عمير(@)(@@) يروي عن: عمر بن الخطاب، بأنه جعل الجد أبا، روى عنه: عمران بن حدير.(@)(@@) (154) -[2: 215] ثنا عمر بن محمد الهمداني، قال: ثنا محمد 
ms567	 بن أشكاب، قال: ثنا يزيد بن هارون، قال: ثنا حماد بن سلمة، عن عمران بن حدير، عن السميط بن عمير، إن عمر بن الخطاب " جعل الجد أبا "(@)(@@)(@@)(@@) ||| AUTO سعيد(@)(@@) مولى خليفة، يروي عن: أبي هريرة، روى عنه: عطاء بن أبي رباح إن كان حفظه محمد بن عبد الله بن عبيد بن عمير الليثي.(@)(@@)(@@)(@@) ||| AUTO سفينة(@)(@@) مولى أم سلمة، يروي عن: أم سلمة، روى عنه: قتادة بن دعامة.(@)(@@)(@@)(@@) ||| AUTO سباع بن ثابت(@)(@@) يروي عن: أم كرز ولها صحبة، روى عنه: أبو يزيد والد عبيد الله بن أبي يزيد.(@)(@@)(@@)(@@) ||| AUTO السفر بن نسير(@)(@@) من أهل الشام، عن: جماعة من الصحابة، روى PageV01P002 [ج 2: ص 216] عنه: أهلها، مات سنة ثلاث وستين ومائة.(@)(@@)(@@)(@@) ||| AUTO سدوس بن حبيب صاحب السابري(@)(@@) من أهل البصرة، يخطئ كثيرا، يروي عن: أنس بن مالك، روى عنه: الحكم بن سنان.(@)(@@)(@@)(@@) ||| AUTO سيرين أبو عمرة(@)(@@) مولى أنس، يروي عن: عمر، روى عنه: ابناه محمد، وأنس ابنا سيرين.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO سقير الضبي(@)(@@) يروي عن: عمر، روى عنه: عمرو بن عبد الرحمن.(@)(@@) سقير(@)(@@) مولى العباس بن الوليد بن عبد الملك، يروي عن: رجل من أصحاب النبي صلى الله عليه وسلم 155 ثنا عبد الصمد بن سعيد بحمص، قال: ثنا محمد بن عوف، قال: ثنا أبي عوف بن محمد، قال: ثنا سقير مولى العباس بن الوليد، قال: سمعت الهدار صاحب رسول الله صلى الله عليه وسلم ورأى العباس أكل خبز السميذ، فقال: " توفي رسول الله صلى الله عليه وسلم ولم يشبع من خبز بر حتى لحق الله جل وتعالى "(@)(@@)(@@)(@@) ||| AUTO سقير البصري(@)(@@) يروي عن: ابن عمر، روى عنه: ابنه بكار بن سقير النميري.(@)(@@)(@@)(@@) ||| AUTO سوقة البزاز(@)(@@) من أهل الكوفة، يروي عن: عمرو بن حريث، روى عنه: ابنه محمد بن سوقة.(@)(@@)(@@)(@@) ||| AUTO سعوة بن حيدان المهري(@)(@@) من أهل مصر، يروي عن: عبد الله بن عمرو، روى عنه: ابنه عبد الرحمن بن سعوة.(@)(@@)(@@)(@@) ||| AUTO السجف(@)(@@) يروي عن: معاذ بن جبل، روى عنه: حاتم بن أبي صغيرة.(@)(@@)(@@)(@@) ||| AUTO 
ms568	 ساعدة بن حرام بن محيصة(@)(@@) يروي المراسيل، روى عنه: بشير بن يسار.(@)(@@)(@@)(@@) ||| AUTO سيابة السلمي(@)(@@) يروي المراسيل، روى عنه: عمرو بن سعيد.(@)PageV01P002(@)(@@) [ج 2: ص 217](@)(@@)(@@)(@@) ||| AUTO سندر بن أبي سندر أبو الأسود(@)(@@) يروي المراسيل، روى عنه: الزهري.(@)(@@)(@@)(@@) ||| AUTO سحامة بن عبد الرحمن بن الأصم(@)(@@) يروي عن: أنس بن مالك، روى عنه: محمد بن ربيعة، والعقدي. النساء:(@)(@@)(@@)(@@) ||| AUTO سعدى المرية(@)(@@) امرأة طلحة بن عبيد الله، تروي عن: عمر بن الخطاب، وطلحة بن عبيد الله، روى عنها: ابنها يحيى بن طلحة بن عبيد الله.(@)(@@)(@@)(@@) ||| AUTO سائبة(@)(@@) مولاة الفاكهة بن المغيرة، تروي عن: عائشة، روى عنها: نافع مولى ابن عمر.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO سلمى بنت كعب(@)(@@) أخت ناجية بن كعب، تروي عن: عائشة.(@)(@@) (156) -[2: 217] ثنا الحميدي، قال: ثنا قتيبة بن سعيد، قال: ثنا أبو عوانة، عن زهير بن أبي ثابت، عن سلمى بنت كعب أخت ناجية، قالت: خرجنا حاجين " فوجدت خاتما من ذهب فجعلته في يدي، فسألت عائشة، فقالت: عرفيه، فإن عرف فرديه، وإن لم يعرف فاستمتعي به "(@)(@@) سلمى(@)(@@) امرأة أبي رافع، تروي عن: أبي رافع، روى عنها: القعقاع بن حكيم.(@)(@@)(@@)(@@) ||| AUTO سكينة بنت الحسين بن علي بن أبي طالب(@)(@@) ماتت بالمدينة سنة سبع عشرة ومائة، تروي عن: أهل بيتها، روى عنها: أهل الكوفة.(@)(@@) سلمى(@)(@@) عمة يعلى، قالت: سمعت عبد الله بن عمرو، يقول: " ركعة بالليل PageV01P002 [ج 2: ص 218] أفضل من عشر ركعات بالنهار ". روى عنها: يعلى بن عطاء.(@)(@@)(@@)(@@) ||| AUTO سرية بنت زيد بن أرقم(@)(@@) قالت: سمعت عليا، يقول: " والذي فلق الحبة وبرأ النسمة ما قتلت عثمان ولا مالأت على قتله ". روى عنها: حصين بن عبد الرحمن الحارثي.(@)(@@)(@@)(@@) || AUTO باب الشين(@)(@@) قال أبو حاتم:(@)(@@) وممن روى عن أصحاب رسول الله صلى الله عليه وسلم ممن ابتدأ اسمه على الشين:(@)(@@)(@@)(@@) ||| AUTO شريح بن الحارث القاضي الكندي(@)(@@) حليف لهم، من بني رائش، كنيته أبو أمية، وقد قيل: أبو عبد الرحمن، كان قائفا، وكان شاعرا وكان قاضيا، يروي عن: عمر بن الخطاب، روى عنه: الشعبي، مات سنة سبع وثمانين 
ms569	 وهو ابن مائة سنة وعشر سنين، وقد قيل: إنه مات سنة ثمان وسبعين وهو ابن مائة وعشرين سنة، وكان قد بقى على القضاء خمسا وسبعين سنة ما تعطل فيها إلا ثلاث سنين في فتنة ابن الزبير.(@)(@@)(@@)(@@) ||| AUTO شريح بن هانئ بن يزيد بن كعب الحارثي(@)(@@) من أهل اليمن، عداده في أهل الكوفة، يروي عن: علي، وعائشة، روى عنه: ابنه المقدام بن شريح، قتل بسجستان سنة ثمان وسبعين، وكان في جيش بن أبي بكرة.(@)(@@)(@@)(@@) ||| AUTO شريح بن عبيد الحضرمي الشامي المقرئ، كنيته أبو الصلت(@)(@@) يروي عن: فضالة بن عبيد، ومعاوية بن أبي سفيان، روى عنه: صفوان بن عمرو السكسكي، وأهل الشام.(@)PageV01P002(@)(@@) [ج 2: ص 219](@)(@@)(@@)(@@) ||| AUTO شريح بن أرطاة(@)(@@) يروي عن: عائشة، روى عنه: الحكم بن عتيبة.(@)(@@)(@@)(@@) ||| AUTO شريح أبو أمية(@)(@@) يروي عن: علي، وليس بالقاضي، روى عنه: أبو مكين.(@)(@@)(@@)(@@) ||| AUTO شريح بن النعمان الصائدي(@)(@@) من أهل الكوفة، عن: علي، روى عنه: ابن أشوع.(@)(@@)(@@)(@@) ||| AUTO شريح الهمداني(@)(@@) يروي عن: سعد بن أبي وقاص، روى عنه: أبو عون الثقفي محمد بن عبيد الله.(@)(@@)(@@)(@@) ||| AUTO شريح بن سعيد(@)(@@) يروي عن: النواس بن سمعان، روى عنه: خالد بن معدان.(@)(@@)(@@)(@@) ||| AUTO شقيق بن سلمة أبو وائل الأسدي(@)(@@) أدرك النبي صلى الله عليه وسلم وليست له صحبة، وكانت أمه نصرانية، سكن الكوفة وكان من عبادها، وكان له خص يكون فيه هو وفرسه فإذا غزا نقضه، وإذا رجع أعاده، وكان عاصم بن أبي النجود، يقول: " مررت يوما مع أبي وائل في السوق، فسمع الناس يقولون دانق وقيراط، فقال لي: يا عاصم، أيهما أكثر، قلت: الدانق، قال: ما أدري ". يروي عن: عمر، وعبد الله، روى عنه: منصور، والأعمش، مات بعد الجماجم، وكان مولده سنة إحدى من الهجرة.(@)(@@)(@@)(@@) ||| AUTO شقيق بن ثور السدوسي أبو الفضل(@)(@@) من أهل البصرة، يروي عن: عثمان، روى عنه: السميط، مات سنة أربع وستين بعد موت يزيد بن معاوية.(@)PageV01P002(@)(@@) [ج 2: ص 220](@)(@@)(@@)(@@) ||| AUTO شقيق بن أبي عبد الله(@)(@@) مولى آل الحضرمي، من أهل الكوفة، يروي عن: أنس، روى 
ms570	 عنه: وكيع، وأبو نعيم.(@)(@@)(@@)(@@) ||| AUTO شقيق بن العيزار الكوفي(@)(@@) يروي عن: ابن عمر، روى عنه: الزبير بن عدي.(@)(@@)(@@)(@@) ||| AUTO شقيق بن عقبة العبدي(@)(@@) يروي عن: البراء، روى عنه: الأسود بن قيس.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO شعيب بن الحبحاب الأسدي الأزدي المعولي(@)(@@) من أهل البصرة، كنيته أبو صالح، يروي عن: أنس بن مالك، روى عنه: شعبة، وأهل البصرة، مات سنة ثلاثين أو إحدى وثلاثين ومائة بداء يقال له: الحميرا.(@)(@@)(@@)(@@) ||| AUTO شعيب بن يسار(@)(@@) مولى ابن عباس، يروي عن: عمر بن الخطاب، روى عنه: مساور الوراق.(@)(@@)(@@)(@@) ||| AUTO شعيب بن رزيق الثقفي الطائفي(@)(@@) يروي عن: الحكم بن حزن الكلفي، وللحكم صحبة، روى عنه: شهاب بن خراش الحوشبي.(@)(@@) شعيب(@)(@@) شيخ، يروي عن: ابن مسعود، روى عنه: أبو قبيل.(@)(@@)(@@)(@@) ||| AUTO شعيب بن أبي سعيد أبو يونس(@)(@@) يروي عن: أبي هريرة، روى عنه: حيوة بن شريح، ويقال: كنيته أبو بشر.(@)(@@)(@@)(@@) ||| AUTO شعيب بن عمرو الأموي(@)(@@) من بني أمية بن زيد الأنصاري، يروي عن: أبي PageV01P002 [ج 2: ص 221] هريرة، روى عنه: الدراوردي.(@)(@@)(@@)(@@) ||| AUTO شعيب بن زرعة(@)(@@) يروي عن: عقبة بن عامر، روى عنه: بكر بن عمرو.(@)(@@)(@@)(@@) ||| AUTO شعيب بن عمرو بن صهيب بن سنان(@)(@@) يروي عن: جده صهيب، روى عنه: يوسف بن محمد.(@)(@@)(@@)(@@) ||| AUTO شعيب بن كيسان السمان(@)(@@) يروي عن: أنس بن مالك، روى عنه: عمر بن عبيد الطنافسي.(@)(@@)(@@)(@@) ||| AUTO شعيب بن خالد الخثعمي(@)(@@) يروي عن: ابن عمر، روى عنه: عثمان بن أبي سليمان.(@)(@@)(@@)(@@) ||| AUTO شعيب بن محمد بن عبد الله بن عمرو(@)(@@) ويقال: أن شعيب بن محمد سمع جده، وليس ذلك عندي بصحيح، روى عنه: ابنه عمرو بن شعيب.(@)(@@)(@@)(@@) ||| AUTO شعيب بن العلاء(@)(@@) عن: أبي هريرة، روى عنه: عصام بن طليق.(@)(@@)(@@)(@@) ||| AUTO شعيب بياع الأنماط(@)(@@) يروي عن: علي، روى عنه: ابن أبي غنية.(@)(@@)(@@)(@@) ||| AUTO شداد بن عبد الله القرشي الدمشقي الأموي(@)(@@) مولى معاوية بن أبي سفيان، كنيته أبو عمار، يروي عن: أبي أمامة، وواثلة بن الأسقع، روى عنه: الأوزاعي، وعكرمة بن عمار.(@)(@@)(@@)(@@) ||| AUTO شداد بن معقل الأسدي(@)(@@) يروي عن: 
ms571	 ابن مسعود، عداده في أهل الكوفة، PageV01P002 [ج 2: ص 222] روى عنه: عبد العزيز بن رفيع والمسيب بن رافع(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO شداد بن عبد الرحمن أبو روبة القشيري(@)(@@) يروي عن: أبي سعيد الخدري، روى عنه: أبو حنيفة، وقد قيل: شداد بن عمران.(@)(@@)(@@)(@@) ||| AUTO شداد أبو قادم البصري الجريري(@)(@@) ولد في اليوم الذي توفي فيه رسول الله صلى الله عليه وسلم روى عبد الصمد بن عبد الوارث، عن عبد السلام، عنه، لا أدرى من عبد السلام.(@)(@@)(@@)(@@) ||| AUTO شداد بن عمارة(@)(@@) يروي عن: حذيفة، روى عنه: عبيد بن الطفيل.(@)(@@)(@@)(@@) ||| AUTO شداد بن الأزمع الوادعي(@)(@@) من أهل الكوفة، أخو الحارث بن الأزمع، يروي عن: ابن مسعود، روى عنه: علي بن الأقمر، مات في ولاية بشر بن مروان على العراق.(@)(@@)(@@)(@@) ||| AUTO شداد بن عمران التغلبي أبو روبة(@)(@@) يروي عن: حذيفة، روى عنه: يزيد بن عبد الله الشيباني، وجامع بن مطر، وليس هذا بأبي روبة الذي روى عنه: أبو حنيفة.(@)(@@) شداد(@)(@@) مولى عياض بن عامر، يروي عن: أبي هريرة، ووابصة بن معبد، روى عنه: جعفر بن برقان.(@)(@@)(@@)(@@) ||| AUTO شداد بن الأفلح المقرئ(@)(@@) من أهل الشام، يروي عن: عمرو البكالي، روى عنه: أهل الشام.(@)(@@)(@@)(@@) ||| AUTO شداد أبو بديل(@)(@@) شهد صفين، روى عنه: ابنه بديل بن شداد.(@)(@@)(@@)(@@) ||| AUTO شبيب بن نعيم، أبو روح الحمصي(@)(@@) يروي عن: أبي هريرة، روى عنه: حريز بن عثمان، وهو الذي يقال له: شبيب بن أبي روح، واسم أبي روح نعيم.(@)PageV01P002(@)(@@) [ج 2: ص 223](@)(@@)(@@)(@@) ||| AUTO شبيب بن غرقدة السلمي البارقي الكوفي(@)(@@) يروي عن: عروة البارقي، روى عنه: الثوري وشعبة.(@)(@@)(@@)(@@) ||| AUTO شبيب بن أبي رياح الباهلي(@)(@@) يروي عن: أبي أمامة، روى عنه: عبد الملك بن عمير، وعمر بن ذر.(@)(@@) (157) -[2: 223] حدثنا أبو يعلى، قال: ثنا عبد الله بن عمر بن أبان، قال: ثنا عبد الرحيم بن سليمان، عن عمر بن ذر، قال: سمعت شبيبا الباهلي، قال: سمعت أبا أمامة، يحدث، عن رسول الله صلى الله عليه وسلم أنه قال: " ما من امرئ مسلم تحضره صلاة مكتوبة، فتوضأ عندها 
ms572	 فأحسن الوضوء، ثم صلى فأحسن الصلاة، إلا غفر له ما كان بينها وبين الصلاة التي كانت قبلها من ذنوب "(@)(@@)(@@)(@@) ||| AUTO شبيب بن بشر البجلي(@)(@@) يروي عن: أنس بن مالك، يخطئ كثيرا، روى عنه: أبو عاصم النبيل وإسرائيل.(@)(@@)(@@)(@@) ||| AUTO شريك بن عبد الله بن أبي نمر القرشي(@)(@@) من أهل المدينة، ربما أخطأ، وأبو نمر جده شهد بدرا، يروي عن: أنس، روى عنه: المقبري، ومالك، وسليمان بن بلال والناس، مات بعد الأربعين ومائة، كنيته أبو عبد الله.(@)(@@)(@@)(@@) ||| AUTO شريك بن حنبل(@)(@@) من أهل الكوفة، يروي عن: علي، روى عنه: أبو إسحاق، وعمرو بن تميم، ومن قال: إنه شريك بن شرحبيل فقد وهم.(@)(@@)(@@)(@@) ||| AUTO شريك بن نميلة(@)(@@) كوفي، يروي عن: ابن عمر، وعلي، روى عنه: أهل الكوفة، وقد قيل: ابن نملة.(@)PageV01P002(@)(@@) [ج 2: ص 224](@)(@@)(@@)(@@) ||| AUTO شريك بن شهاب الحارثي(@)(@@) يروي عن: أبي برزة، روى عنه: الأزرق بن قيس.(@)(@@)(@@)(@@) ||| AUTO شريك بن شريك(@)(@@) يروي عن: عبد الله بن عمرو، روى عنه: قتادة.(@)(@@)(@@)(@@) ||| AUTO شريك بن خباشة النميري(@)(@@) يروي عن: عمر بن الخطاب، روى عنه: إبراهيم بن أبي عبلة.(@)(@@) (158) -[2: 224] حدثنا ابن قتيبة، ثنا إبراهيم بن محمد بن يوسف المقدسي، قال: ثنا زهير بن عباد، قال: ثنا رديح بن عطية، عن إبراهيم بن أبي عبلة، عن شريك بن خباشة النميري، أنه ذهب يستسقي من جب سليمان الذي في بيت المقدس، فانقطع دلوه فنزل الجب ليخرجه، فبينما هو يطلبه في نواحي الجب إذ هو بشجرة فتناول ورقة من الشجرة، فأخرجها معه فإذا هي ليس من شجر الدنيا، فأتى بها عمر بن الخطاب، فقال: أشهد أن هذا هو الحق، سمعت رسول الله صلى الله عليه وسلم يقول: " يدخل من هذه الأمة رجل الجنة قبل موته "، فجعل الورقة بين دفتي المصحف(@)(@@)(@@)(@@) ||| AUTO شريك بن خليفة الدوسي التميمي(@)(@@) كان يروي عن: عبد الله بن عمرو، كان من الأزارقة، روى عنه: قتادة.(@)(@@)(@@)(@@) ||| AUTO شريك بن نهيك الخولاني(@)(@@) يروي عن: أبي الدرداء، روى عنه: صفوان بن عمرو.(@)(@@)(@@)(@@) ||| AUTO شريك بن أرطأة الكلابي العامري 
ms573	(@)(@@) من أهل الكوفة، كنيته أبو عبد الله، يروي عن: علي، وحذيفة، روى عنه: ابنه عبد الله بن شريك.(@)(@@)(@@)(@@) ||| AUTO شعبة بن التوءم التميمي(@)(@@) يروي عن: ابن مسعود، وقيس بن عاصم، روى المغيرة بن مقسم، عن أبيه، عنه.(@)(@@)(@@)(@@) ||| AUTO شعبة بن عمرو(@)(@@) شيخ، يروي عن: أنس بن مالك، في حديثه مناكير كثيرة، روى عنه: الخليل بن مرة، البلية في أخباره من الخليل بن مرة، قد ذكرنا الخليل في كتاب PageV01P002 [ج 2: ص 225] الضعفاء بأسبابه، وما يجب الوقوف على أنبائه.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO شهاب بن شريك(@)(@@) يروي عن: أبي برزة، روى عنه: الأزرق بن قيس.(@)(@@)(@@)(@@) ||| AUTO شهاب بن عباد العصري(@)(@@) يروي عن: ابن عباس، وابن عمر، روى عنه: يحيى بن شهاب.(@)(@@)(@@)(@@) ||| AUTO شهاب البارقي(@)(@@) يروي عن: علي، روى عنه: ابن عيينة والجراح بن مليح.(@)(@@)(@@)(@@) ||| AUTO شهاب بن عبد الله الخولاني(@)(@@) من أهل اليمن، يروي عن: عمر، روى عنه: سماك بن الفضل، وليث بن أبي سليم.(@)(@@)(@@)(@@) ||| AUTO شهاب بن مدلج العنبري التميمي(@)(@@) بصري، يروي عن: ابن عباس، وأبي موسى، روى عنه: ابنه حبيب بن شهاب.(@)(@@) شهاب(@)(@@) شيخ، يروي عن: أبي هريرة، روت عنه: القلوص بنت عليبة، لا أدرى من هو.(@)(@@)(@@)(@@) ||| AUTO شرحبيل بن مسلم بن حامد الخولاني(@)(@@) من أهل اليمن، عداده في أهل الشام، اختتن في ولاية عبد الملك، يروي عن: أبي أمامة، وعبد الله بن بسر، وقد أدرك خمسة من أصحاب رسول الله صلى الله عليه وسلم روى عنه: ابن عياش وأهل الشام.(@)(@@)(@@)(@@) ||| AUTO شرحبيل بن معشر العنسي(@)(@@) من أهل الشام، يروي عن: معاذ بن جبل، روى عنه: صفوان بن عمرو، وابنه عمرو بن شرحبيل.(@)(@@)(@@)(@@) ||| AUTO شرحبيل بن سعد بن أبي وقاص(@)(@@) يروي عن: أبيه، عداده في أهل المدينة، روى عنه: أهلها.(@)(@@)(@@)(@@) ||| AUTO شرحبيل بن سعد بن عبادة الخزرجي(@)(@@) يروي عن: أبيه، روى عنه: ابنه عمرو بن شرحبيل.(@)PageV01P002(@)(@@) [ج 2: ص 226](@)(@@)(@@)(@@) ||| AUTO شرحبيل أبو سعد(@)(@@) يروي عن: ابن عباس، روى عنه: فطر بن خليفة، وهو الذي يروي عنه: يزيد بن عبد الله بن الهاد.(@)(@@)(@@)(@@) ||| AUTO 
ms574	 شرحبيل بن السمط الكندي(@)(@@) يروي عن: سلمان، وعبادة بن الصامت، روى عنه: بلال العبسي، ومكحول، وهو شرحبيل بن السمط بن الأسود بن جبلة بن عدي بن ربيعة بن معاوية، من كندة.(@)(@@)(@@)(@@) ||| AUTO شرحبيل بن شفعة العنسي الشامي الرحبي، كنيته أبو يزيد(@)(@@) يروي عن: عمرو بن العاص، وعتبة بن عبد السلمي، روى عنه: حريز بن عثمان.(@)(@@)(@@)(@@) ||| AUTO شرحبيل بن عوف الأحمسي(@)(@@) يروي عن: علي، وعبد الله، روى عنه: أهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO شرحبيل بن أيمن(@)(@@) يروي عن: أبي الدرداء، روى عنه: أهل الشام.(@)(@@)(@@)(@@) ||| AUTO شرحبيل بن سعد الخطمي الأنصاري(@)(@@) مولى لهم، المدني، كنيته أبو سعد، يروي عن: زيد بن ثابت، وجابر، وأبي سعيد، روى عنه: يحيى بن سعيد الأنصاري، ومالك بن أبي ذئب، مات سنة ثلاث وعشرين ومائة.(@)(@@)(@@)(@@) ||| AUTO شرحبيل بن القعقاع(@)(@@) قال:(@)(@@) (159) -[2: 226] سمعت عمرو بن معد يكرب، يقول: علمنا رسول الله صلى الله عليه وسلم أن نقول: " لبيك اللهم لبيك، لبيك لا شريك لك لبيك، إن الحمد والنعمة لك والملك، لا شريك لك ". رواه عمرو بن شمر أبو شمر، عن أبي طلق، عن شرحبيل بن القعقاع. لست أعرف أبا طلق هذا من هو، وعمرو بن شمر كان رافضيا يكذب، والخبر ما أراه بمحفوظ عنه PageV01P002 [ج 2: ص 227](@)(@@)(@@)(@@) ||| AUTO شرحبيل(@)(@@) رجل من الموالي، يروي عن: عمر، روى عنه: طلحة بن صالح.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO أبو الأشعث الصنعاني اسمه: شراحيل بن شرحبيل بن كليب بن آدة(@)(@@) من صنعاء الشام، يروي عن: ثوبان، وعبادة بن الصامت، روى عنه: أبو قلابة، ومن قال: شراحيل بن آدة فقد نسبه إلى جده، وكان من الأبناء، سكن صنعاء الشام، وكتب الناس بدمشق، مات في ولاية معاوية.(@)(@@)(@@)(@@) ||| AUTO شراحيل بن بلال الخولاني(@)(@@) يروي عن: ابن عمر، روى عنه: يزيد بن أبي حبيب.(@)(@@)(@@)(@@) ||| AUTO شراحيل بن معن(@)(@@) يروي عن: فضالة بن عبيد، روى عنه: شرحبيل بن مسلم.(@)(@@) شراحيل(@)(@@) شيخ، يروي عن: أبي هريرة وأبي برزة، روى عنه: هشام بن سعيد بن زيد بن أبي زيد الأنصاري.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO شيبان بن حريث(@)(@@) يروي 
ms575	 عن: عبد الله بن عمرو، روى عنه: أبو إسحاق السبيعي.(@)(@@)(@@)(@@) ||| AUTO شيبان بن قحذم(@)(@@) يروي عن: علي، روى عنه: ميمون بن مهران، وقد قيل: شيبان بن محزم.(@)(@@)(@@)(@@) ||| AUTO شيبان اليشكري(@)(@@) شيخ، يروي عن: أنس بن مالك، روى عنه: عطية بن بهرام.(@)(@@) شيبان(@)(@@) شيخ، يروي عن: عدي بن حاتم، روى عنه: محمد بن إسحاق بن يسار إن كان سمع منه.(@)(@@)(@@)(@@) ||| AUTO شمر بن يقظان أبو عبلة الشامي(@)(@@) يروي عن: عوف بن مالك، روى عنه: ابنه إبراهيم بن أبي عبلة.(@)PageV01P002(@)(@@) [ج 2: ص 228](@)(@@)(@@)(@@) ||| AUTO شمر بن جعونة(@)(@@) يروي عن: ابن عمر، روى عنه: أبو إسحاق السبيعي.(@)(@@)(@@)(@@) ||| AUTO شريق الهوزني(@)(@@) قال:(@)(@@) (160) -[2: 228] دخلت على عائشة فسألتها بم كان رسول الله صلى الله عليه وسلم يفتتح إذا هب من الليل؟ فقالت: " كان إذا هب من الليل كبر عشرا، وحمد الله عشرا، وقال: سبحان الله وبحمده عشرا، وقال: سبحان القدوس عشرا، واستغفر عشرا، وهلل الله عشرا، وقال: اللهم إني أعوذ بك من ضيق الدنيا، وضيق يوم القيامة عشرا ". رواه بقية بن الوليد، عن عمر بن جعثم، عن الأزهر بن عبد الله الحرازي، عن شريق الهوزني(@)(@@)(@@)(@@) ||| AUTO شيبة بن نصاح القارئ(@)(@@) من أهل المدينة، يروي عن: أبيه، أبوه مولى أم سلمة، روى عنه: أهل المدينة، مات في ولاية مروان بن محمد، وقد قيل: إنه سمع من أم سلمة وهو صغير.(@)(@@)(@@)(@@) ||| AUTO شجاع أبو طيبة(@)(@@) يروي عن: ابن عمر، روى عنه: السري بن يحيى.(@)(@@)(@@)(@@) ||| AUTO شبيل بن عوف بن أبي حية الأحمسي، كنيته أبو الطفيل(@)(@@) أدرك الجاهلية، وشهد القادسية مع سعد، عداده في أهل الكوفة، روى عنه: إسماعيل بن أبي خالد.(@)(@@)(@@)(@@) ||| AUTO شبيل بن عزرة الضبعي(@)(@@) ختن قتادة، ربما أخطأ، يروي عن: أنس بن مالك، روى عنه: شعبة والبصريون.(@)(@@)(@@)(@@) ||| AUTO شوذب المدني(@)(@@) مولى زيد بن ثابت، يروي عن: زيد بن ثابت، روى عنه: قدامة بن موسى.(@)(@@)(@@)(@@) ||| AUTO شوذب أبو معاذ(@)(@@) ويقال: أبو عثمان، يروي عن: البراء بن عازب، روى عنه: الثوري.(@)PageV01P002(@)(@@) [ج 2: ص 229](@)(@@)(@@)(@@) ||| AUTO الشريد الصدفي الثقفي(@)(@@) يروي عن: 
ms576	 أبي هريرة، روى عنه: يحيى بن سعيد الأنصاري.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO شماس بن لبيد(@)(@@) يروي عن: ابن مسعود، روى عنه: سعيد بن مسروق.(@)(@@) شماس(@)(@@) مولى ابن عباس، يروي عن: ابن عمر، روى عنه: ابنه عثمان بن شماس.(@)(@@)(@@)(@@) ||| AUTO شييم بن زنيم أبو مريم البكري(@)(@@) يروي عن: عمر بن الخطاب، روى عنه: سماك بن حرب، وقد قيل: ابن ذييم.(@)(@@)(@@)(@@) ||| AUTO شييم بن بيتان البلوي(@)(@@) عداده في أهل مصر، يروي عن: رويفع بن ثابت البلوى، روى عنه: عياش بن عباس القتباني.(@)(@@)(@@)(@@) ||| AUTO شمير بن عبد المدان(@)(@@) يروي عن: أبيض بن جمال المازني، روى عنه: سمى بن قيس، في أقطاع النبي صلى الله عليه وسلم الملح.(@)(@@)(@@)(@@) ||| AUTO شمير القيسي(@)(@@) يروي عن: ابن عباس، روى عنه: شيخ يقال له: عكير.(@)(@@)(@@)(@@) ||| AUTO شتير بن شكل بن حميد العبسي(@)(@@) من أهل الكوفة، يروي عن: علي، وابن مسعود، روى عنه: الشعبي، وأهل الكوفة، مات في ولاية ابن الزبير.(@)(@@)(@@)(@@) ||| AUTO شتير بن نهار(@)(@@) يروي عن: أبي هريرة في حسن الظن، روى عنه: محمد بن واسع.(@)PageV01P002(@)(@@) [ج 2: ص 230](@)(@@)(@@)(@@) ||| AUTO شويس بن حياش العدوي(@)(@@) من أهل البصرة، يروي عن: عتبة بن غزوان، كنيته أبو الرقاد، روى عنه: أبو نعامة وأبو مرحوم.(@)(@@)(@@)(@@) ||| AUTO شفي بن ماتح الأصبحي، ويقال: ماتع(@)(@@) يروي عن: عبد الله بن عمرو، وأبي هريرة، كنيته أبو سهل، عداده في أهل مصر، روى عنه: أهلها.(@)(@@)(@@)(@@) ||| AUTO شبث بن ربعي(@)(@@) من بني يربوع بن حنظلة التميمي، يروي عن: علي وحذيفة، روى عنه: محمد بن كعب القرظي، يخطئ.(@)(@@)(@@)(@@) ||| AUTO شبل بن خليد المزني(@)(@@) يروي عن: عبد الله بن مالك الأوسي، روى عنه: عبيد الله بن عبد الله، والزهري.(@)(@@)(@@)(@@) ||| AUTO شفعة السمعي(@)(@@) يروي عن: عبد الله بن عمرو، روى عنه: شرحبيل بن مسلم.(@)(@@)(@@)(@@) ||| AUTO شبر بن علقمة العبدي(@)(@@) من أهل الكوفة، يروي عن: ابن مسعود، روى عنه: الأسود بن قيس.(@)(@@) (161) -[2: 230] حدثنا محمد بن أحمد بن أبي عون، ثنا علي بن حجر، ثنا سفيان، عن الأسود بن قيس، عن شبر بن علقمة، قال: بارزت 
ms577	 رجلا يوم القادسية فقتلته فبلغ سلبه اثني عشر ألفا فنفلنيه سعد PageV01P002 [ج 2: ص 231](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO شبرمة بن الطفيل(@)(@@) يروي عن: علي، روى عنه: إياس بن نذير.(@)(@@)(@@)(@@) ||| AUTO شابة أبو رقيم المكي(@)(@@) يروي عن: ابن عباس، روى عنه: ابنه رقيم بن شابة.(@)(@@) شبر(@)(@@) شيخ، قال:(@)(@@) (162) -[2: 231] صحبت عمر بن الخطاب فكان " يتوضأ وضوءه غدوة إلى الليل، ويمسح على خفيه ". رواه الفضل بن موسى السيناني، عن الأصبغ بن علقمة، عن حميد بن مرة الربعي، عن شبر، أنه صحب عمر بن الخطاب رضي الله تعالى عنه(@)(@@)(@@)(@@) ||| AUTO شيحة بن عبد الله بن قيس أبو حبرة الضبعي(@)(@@) من أصحاب علي بن أبي طالب رضى الله تعالى عنه، وابن عباس، من أهل البصرة ممن عمر، وكان من العباد، مات هرما في عبادته، روى عنه: أهل البصرة، شبيل بن عزرة، وغيره.(@)(@@)(@@)(@@) || AUTO باب الصاد(@)(@@) قال أبو حاتم:(@)(@@) وممن روى عن الصحابة ورآهم ممن ابتدأ اسمه على الصاد:(@)(@@)(@@)(@@) ||| AUTO صالح بن خوات بن جبير المدني(@)(@@) أخو أم عمرو بنت خوات بن جبير، يروي عن: سهل بن أبي حثمة، روى عنه: القاسم بن محمد.(@)(@@)(@@)(@@) ||| AUTO صالح بن إبراهيم بن عبد الرحمن بن عوف الزهري القرشي المدني(@)(@@) أخو سعد بن إبراهيم، يروي عن: أنس بن مالك إن كان سمع منه، روى عنه: عمرو بن دينار، والماجشون، كنيته أبو عمران، مات وعلى المدينة إبراهيم بن هشام بن إسماعيل المخزومي، وأمه أم كلثوم بنت سعد بن أبي وقاص.(@)(@@)(@@)(@@) ||| AUTO صالح بن خيوان السبائي(@)(@@) يروي عن: السائب بن خباب وعبد الله بن PageV01P002 [ج 2: ص 232] عمرو، روى عنه: بكر بن سوادة.(@)(@@)(@@)(@@) ||| AUTO صالح بن أبي زيد النخعي(@)(@@) يروي عن: أم سلمة، روى عنه: موسى الجهني إن كان سمع منه.(@)(@@)(@@)(@@) ||| AUTO صالح بن حجير، كنيته أبو حجير(@)(@@) يروي عن: معاوية بن حديج، روى عنه: ثابت البناني.(@)(@@)(@@)(@@) ||| AUTO صالح بن دينار الهلالي(@)(@@) يروي عن: عمرو بن الشريد، روى عنه: عامر الأحول.(@)(@@)(@@)(@@) ||| AUTO صالح بن بشير بن فديك(@)(@@) يروي عن: فديك وهو جده، وله صحبة، روى عنه: 
ms578	 الزهري.(@)(@@)(@@)(@@) ||| AUTO صالح بن دينار التمار(@)(@@) مدني، والد داود بن صالح، عن: أبي سعيد الخدري، روى عنه: ابنه داود بن صالح.(@)(@@)(@@)(@@) ||| AUTO صالح الجذامي(@)(@@) ويقال: الحداني، وقد قيل: الحرامي، من أهل البصرة، يروي عن: أبي الدرداء، روى عنه: ثابت البناني.(@)(@@)(@@)(@@) ||| AUTO صالح أبو عبد الله(@)(@@) مولى الجندعيين، من أهل المدينة، يروي عن: أبي هريرة، روى عنه: أبو الأسود محمد بن عبد الرحمن بن نوفل، وسعيد بن أبي هلال.(@)(@@)(@@)(@@) ||| AUTO صالح بن رستم، أبو عبد الله السلمي(@)(@@) مولى بني هاشم، يروي عن: عبد الله بن حوالة، روى عنه: عبد الله بن عبد الرحمن بن يزيد بن جابر.(@)(@@)(@@)(@@) ||| AUTO صالح بن صريم الإفريقي(@)(@@) ويروي عن: عبد الله بن عمرو، روى عنه: الإفريقي.(@)PageV01P002(@)(@@) [ج 2: ص 233](@)(@@)(@@)(@@) ||| AUTO صالح بن عجلان(@)(@@) يروي عن: أبي أمامة، روى عنه: سليمان بن بلال.(@)(@@)(@@)(@@) ||| AUTO صالح بن مهران(@)(@@) مولى عمرو بن حريث، يروي عن: أبي هريرة، روى عنه: أبو بكر بن عياش.(@)(@@)(@@)(@@) ||| AUTO صالح بن أبي سليمان(@)(@@) يروي عن: ابن عمر، وأبي هريرة، وابن عباس، روى عنه: أبو بلج، وشعبة.(@)(@@)(@@)(@@) ||| AUTO صالح بن راشد القرشي(@)(@@) يروي عن: ابن عباس، روى عنه: رفدة بن قضاعة.(@)(@@)(@@)(@@) ||| AUTO صالح بن أبي أمامة(@)(@@) يروي عن: أنس بن مالك، عداده في أهل المدينة، روى عنه: محمد بن إسحاق بن يسار، هو صالح بن عبد الرحمن، اسم أبي أمامة عبد الرحمن.(@)(@@)(@@)(@@) ||| AUTO صالح بن جبير الشامي(@)(@@) يروي عن: أبي جمعة، روى عنه: الأوزاعي ومعاوية بن صالح.(@)(@@)(@@)(@@) ||| AUTO صالح بن ربيعة بن الهدير التيمي القرشي(@)(@@) يروي عن: عائشة، روى عنه: هشام بن عروة.(@)(@@)(@@)(@@) ||| AUTO صالح بن شريح(@)(@@) يروي عن: أبي عبيدة بن الجراح، وكان كاتبا لعبد الله بن قرط، وكان عبد الله أميرا على حمص لأبي عبيدة بن الجراح، روى عنه: ابنه محمد بن صالح.(@)PageV01P002(@)(@@) [ج 2: ص 234](@)(@@)(@@)(@@) ||| AUTO صالح بن أبي طريف أبو الصيداء(@)(@@) عن: أبي سعيد الخدري، روى عنه: أبو روق عطية بن الحارث الهمداني.(@)(@@)(@@)(@@) ||| AUTO صالح بن درهم الباهلي أبو الأزهر(@)(@@) يروي عن: ابن 
ms579	 عمر، روى عنه: مروان بن معاوية.(@)(@@)(@@)(@@) ||| AUTO صالح بن سعيد(@)(@@) يروي عن: عائشة، روى عنه: نافع بن عمر.(@)(@@)(@@)(@@) ||| AUTO صالح الشيباني(@)(@@) يروي عن: علي، روى عنه: ابن أبي زرعة.(@)(@@)(@@)(@@) ||| AUTO صالح بن أبي صالح السدوسي(@)(@@) يروي عن: علي، وعائشة، روى عنه: خلاد بن عمرو.(@)(@@)(@@)(@@) ||| AUTO صالح بن عتبة(@)(@@) يروي عن: عمر، روى عنه: حريز بن عثمان الرحبي.(@)(@@)(@@)(@@) ||| AUTO صالح بن عروة(@)(@@) يروي عن: ابن عمر، روى عنه: جعفر بن برقان.(@)(@@)(@@)(@@) ||| AUTO صالح بن ميسرة الخزاعي البصري(@)(@@) يروي عن: أنس، روى عنه: سعيد بن واصل.(@)(@@)(@@)(@@) ||| AUTO صالح المعلم(@)(@@) من أهل البصرة، يروي عن: ابن عمر، روى عنه: عمارة بن زاذان.(@)(@@)(@@)(@@) ||| AUTO صالح بن مسعود الجدلي(@)(@@) من أهل الكوفة، يروي عن: أبي جحيفة، روى عنه: مروان بن معاوية الفزاري.(@)(@@) (163) -[2: 234] ثنا أبو يعلى، ثنا إبراهيم بن محمد بن عرعرة، قال: ثنا مروان بن معاوية، قال: ثنا صالح بن مسعود، قال: سمعت أبا جحيفة، يقول: " أتينا رسول الله صلى الله عليه وسلم فأمر لنا بثنتي عشرة قلوصا، وكنا في استخراجها، فجاءتنا وفاته فمنعناها الناس حتى اجتمعوا "(@)(@@) (164) -[2: 234] قال: فقلت لأبي جحيفة: حدثني عن رسول الله صلى الله عليه وسلم فقال: " كان أبيض قد شمط عارضاه "(@)PageV01P002(@)(@@) [ج 2: ص 235](@)(@@)(@@)(@@) ||| AUTO صالح بن حبيب أبو موسى المدني(@)(@@) سكن الشام، يروي عن: رجل من أصحاب النبي صلى الله عليه وسلم روى عنه: لقمان بن عامر.(@)(@@)(@@)(@@) ||| AUTO صدقة بن يسار الجزري(@)(@@) سكن مكة، يروي عن: ابن عمر، روى عنه: مالك، والثوري، وهو مولى لبعض أهل مكة، مات في ولاية أبي العباس السفاح.(@)(@@)(@@)(@@) ||| AUTO صدقة أبو توبة(@)(@@) يروي عن: أنس بن مالك، روى عنه: معاوية بن صالح.(@)(@@)(@@)(@@) ||| AUTO صدقة بن عيسى أبو محرز(@)(@@) يروي عن: أنس بن مالك، روى عنه: عبيد الله بن موسى.(@)(@@)(@@)(@@) ||| AUTO الصلت بن إياس الحنفي(@)(@@) أخو عبد الله بن إياس بن أبي مريم، يروي عن: ابن عمر في الوتر، روى عنه: عبد المؤمن بن خالد.(@)(@@)(@@)(@@) ||| AUTO الصلت بن عبد الرحمن الأنصاري(@)(@@) يروي عن: أبي رافع، روى عنه: 
ms580	 حبيب بن أبي ثابت، وأبو بكر بن نافع العمري.(@)(@@)(@@)(@@) ||| AUTO الصلت بن عمر الدهان(@)(@@) يروي عن: علي، روى عنه: نصير بن زياد، وكامل بن العلاء.(@)(@@)(@@)(@@) ||| AUTO الصلت بن قديد الحنفي(@)(@@) وقد قيل: ابن قويد، كنيته أبو الأحمر، يروي عن: أبي هريرة، روى عنه: عمار بن محمد.(@)(@@)(@@)(@@) ||| AUTO الصلت بن عبد الله المخزومي(@)(@@) يروي عن: ابن عمر، روى عنه: الأوزاعي.(@)PageV01P002(@)(@@) [ج 2: ص 236](@)(@@)(@@)(@@) ||| AUTO الصلت الحرقي(@)(@@) يروي عن: علي، روى عنه: عبد الكريم بن أبي المخارق.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO صفوان بن يعلى بن أمية التيمي القرشي(@)(@@) يروي عن: أبيه، روى عنه: عطاء، ومحمد بن جبير بن مطعم.(@)(@@)(@@)(@@) ||| AUTO صفوان بن محرز بن زياد المازني(@)(@@) من أهل البصرة، يروي عن: أبي موسى، وابن عمر، وكان من العباد، اتخذ لنفسه سربا يبكى فيه، روى عنه: الحسن، وقتادة، ومات سنة أربع وسبعين في ولاية عبد الملك، وكنيته أبو عبد الله، كان إذا قام إلى تهجده قام معه سكان داره تسجد معه.(@)(@@)(@@)(@@) ||| AUTO صفوان بن عبد الله بن صفوان بن أمية بن خلف الجمحي القرشي(@)(@@) من أهل مكة، يروي عن: ابن عمر وعمه يعلى بن صفوان، وهو الذي يروي عن: أم الدرداء، روى عنه: الزهري.(@)(@@)(@@)(@@) ||| AUTO صفوان بن الأصم(@)(@@) يروي عن: أنس، روى عنه: الغاز بن جبلة وهو أبو هشام بن الغاز.(@)(@@) صفوان(@)(@@) مولى عمر بن علي، يروي عن: أبي هريرة، روى عنه: عبيد الله بن المغيرة.(@)(@@)(@@)(@@) ||| AUTO صباح بن عبد الله، أبو شراعة البجلي(@)(@@) كوفي، همداني، يروي عن: أنس بن مالك، عداده في أهل الكوفة، روى عنه: أهلها أبو إسحاق السبيعي وغيره.(@)(@@)(@@)(@@) ||| AUTO صباح بن ثابت القشيري(@)(@@) يروي عن: أنس بن مالك، روى عنه: ابن المبارك.(@)PageV01P002(@)(@@) [ج 2: ص 237](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO صهيب أبو الصهباء البكري(@)(@@) من أهل البصرة، يروي عن: علي، وابن مسعود، وابن عباس، روى عنه: سعيد بن جبير وطاوس.(@)(@@) صهيب(@)(@@) مولى العباس بن عبد المطلب، يروي عن: عثمان وعلي، روى عنه: أبو صالح السمان.(@)(@@)(@@)(@@) ||| AUTO صهيب الحذاء(@)(@@) مولى عبد الله بن عامر، يروي 