ms321	 ابن أبي عمير عنه، وهو يشعر بوثاقته، بل قد مر غير مرة أنه يدل عليها.(@)(@@)(@@)(@@) $ 3674 - الحسين بن المعلى أو المعدل كوفي " ق ".(@)(@@)(@@)(@@) $ 3675 - الحسين بن المنذر، ذكر " كش " رواية تدل على كونه من الشيعة، وذكره العلامة في القسم الأول الا ان في الحاوي أدرجه في الرابع، وفي " جش " يروي عن " ق " وأبيه وجده عليهم السلام فهو في الثلاثة، ولذا أشرنا إليه في التالية، عنه محمد بن سنان.(@)(@@)(@@)(@@) $ 3676 - الحسين بن منصور الحلاج من الكذابين، ذكر الشيخ له أقاصيص " صه " يأتي في الفوائد.(@)(@@)(@@)(@@) $ 3677 - الحسين بن موسى الأسدي الخياط كوفي " ق " مولى بني أسد، ثم بني والبة، روى عن " ق " ثم بلا واسطة ومع واسطة أبيه. PageV01P437(@)(@@)(@@)(@@) $ 3678 - الحسين بن موسى الهمداني كوفي " ق " ثم ابن موسى كوفي، وفي " تعق " ظاهر الوجيزة أنه واحد ولا يبعد بالنسبة إلى الشيخ، ويؤمي إليه ظاهر " جش " ولعله يظهر من الاخبار. أقول: الظاهر أن الأسدي والهمداني غير الواقفي المذكور في السابقة، ولتحقيق الاتحاد والتعدد مجال آخر.(@)(@@)(@@)(@@) $ 3679 - الحسين بن مهران الكوفي مولى " ق " يحتمل كونه المتقدم الواقفي في السابقة وأن يكون أخا صفوان، والله أعلم.(@)(@@)(@@)(@@) $ 3680 - الحسين بن ناجية الأسدي مولى كوفي " ق ".(@)(@@)(@@)(@@) $ 3681 - الحسين بن نعيم الصحاف الكوفي مولى بني أسد، ثقة وأخواه علي ومحمد رووا عن " ق " عليه السلام، وهو متكلم مجيد، له كتاب بروايات كثيرة، منها رواية ابن أبي عمير، وهو في السابقة.(@)(@@)(@@)(@@) $ 3682 - الحسين بن يحيى الكوفي البجلي مولى " ق ".(@)(@@)(@@)(@@) $ 3683 - الحصن الكوفي روى عنه ابن بكير " ق ".(@)(@@)(@@)(@@) $ 3684 - الحصين بن حذيفة العبسي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3685 - الحصين بن الزبال الجعفي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3686 - الحصين بن زياد الحنفي مولاهم كوفي " ق ".(@)(@@)(@@)(@@) $ 3687 - الحصين بن عامر أبو الهيثم الكلبي الكوفي " ق " " جخ ".(@)(@@)(@@)(@@) $ 3688 - الحصين بن عبد الرحمن الجعفي، أسند عنه، عنه " ق " وفي " تعق " هو والد بسطام، ومر في ترجمته أنه كان وجها وأبوه وعمومته.(@)(@@)(@@)(@@) $ 3689 - حفص أبو عمرو الكلبي " ق ".(@)(@@)(@@)(@@) $ 3690 - حفص أبو النعمان الكوفي " ق " وعن نسخة ابنه كما يأتي.(@)(@@)(@@)(@@) $ 3691 
ms322	 - حفص بن أبي إسحاق المدائني " ق ".(@)(@@)(@@)(@@) $ 3692 - حفص الأبيض " ق ".(@)(@@)(@@)(@@) $ 3693 - حفص بن الأبيض التمار الكوفي " ق " وفي نسخة النيار.(@)(@@)(@@)(@@) $ 3694 - حفص بن أبي عائشة المنقري الكوفي مولى " ق ". PageV01P438(@)(@@)(@@)(@@) $ 3695 - حفص بن أبي عيسى الكوفي " ق ".(@)(@@)(@@)(@@) $ 3696 - حفص أخو مرازم " ق " وفي " تعق " في الكافي عن ابن أبي عمير عن حفص بن مرازم، فتأمل. ولعل أمره بالتأمل أن المستفاد من هذا السند كونه ابن أخيه لا أخوه، فأشار أنه ليس أخاه.(@)(@@)(@@)(@@) $ 3697 - حفص الأعرج الجازري، روى عنه ابن مسكان " ق ".(@)(@@)(@@)(@@) $ 3698 - حفص الأعور الكناسي " ق ".(@)(@@)(@@)(@@) $ 3699 - حفص بن البختري، أصله كوفي ثقة، روى عن " ق " و " ظم " عليهما السلام وانما كان بينه وبين آل أعين بنوة، فغمزوا عليه بلعب الشطرنج، عنه ابن أبي عمير " جش " " ست ".(@)(@@)(@@)(@@) $ 3700 - حفص بن حبيب الكوفي " ق ".(@)(@@)(@@)(@@) $ 3701 - حفص بن حميد مولى همدان أبو علي الأبار الكوفي " ق ".(@)(@@)(@@)(@@) $ 3702 - حفص بن خالد بن جابر البصري " ق ".(@)(@@)(@@)(@@) $ 3703 - حفص الدهان " ق ".(@)(@@)(@@)(@@) $ 3704 - حفص بن سابور، في " صه " أخو بسطام بن سابور ثقة، ومر في أخيه عنه، وفي " جش " توثيقه فلا غبار فيه.(@)(@@)(@@)(@@) $ 3705 - حفص بن سالم أبو ولاد مولى جعفي كوفي " ق " ثقة له أصل، عنه الحسن بن محبوب، وقال ابن فضال: انه ابن يونس المخزومي روى عن " ق " عليه السلام ثقة لا بأس به " صه " " جش ".(@)(@@)(@@)(@@) $ 3706 - حفص بن سالم الثمالي الكوفي أبو علي " ق ".(@)(@@)(@@)(@@) $ 3707 - حفص بن سالم صاحب السابري الكوفي " ق ".(@)(@@)(@@)(@@) $ 3708 - حفص بن سليم العبدي الكوفي، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 3709 - حفص بن سليمان أبو عمرو الأسدي الغاضري المقري البزاز الكوفي، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 3710 - حفص بن سوقة " ق " يستفاد من " صه " وغيرها أنه الآتي بعيده ولم PageV01P439(@)(@@) أتحققه، وفي " مشكا " ابن سوقة الثقة عنه ابن أبي عمير، وعلى الاتحاد والتغاير كلاهما مقبولا الحديث.(@)(@@)(@@)(@@) $ 3711 - حفص العمري مولى عمرو بن حريث المخزومي، روى عن " ق " و " ظم " عليهما السلام، ذكره أبو العباس في رجالهما، وأخواه زياد ومحمد أكثر منه رواية عن " قر " و " ق 
ms323	 " عليهما السلام له أصل عنه ابن أبي عمير.(@)(@@)(@@)(@@) $ 3712 - حفص الضبي أبو عمرو كوفي " ق ".(@)(@@)(@@)(@@) $ 3713 - حفص بن عبد ربه الكناسي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3714 - حفص بن عبد العزيز الكوفي " ق ".(@)(@@)(@@)(@@) $ 3715 - حفص بن عاصم أبو عاصم المدني " ق " وزاد " صه " السلمي روى عن جعفر بن محمد عليهما السلام وفي " جش " مضافا إلى ذلك له كتاب رواه محمد بن علي الصيرفي أبو سمينة، وفي " مشكا " ابن عاصم الثقة عنه محمد بن علي أبو سمينة.(@)(@@)(@@)(@@) $ 3716 - حفص بن عثمان، يروي عنه ابن أبي عمير " تعق " أقول: وفيه دليل على الوثاقة على المختار.(@)(@@)(@@)(@@) $ 3717 - حفص بن العلاء كوفي ثقة " صه " " جش " له كتاب عنه ابن أبي عمير في الثاني.(@)(@@)(@@)(@@) $ 3718 - حفص بن عمرو بن بيان التغلبي الكوفي، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 3719 - حفص بن عمرو بن ميمون الابلي " ق ".(@)(@@)(@@)(@@) $ 3720 - حفص بن عمرو النخعي " ق ".(@)(@@)(@@)(@@) $ 3721 - حفص بن عمران كوفي " ق ".(@)(@@)(@@)(@@) $ 3722 - حفص بن عمران الفزاري البرجمي الأزرق الكوفي، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 3723 - حفص بن عيسى الأعور " قي " ويحتمل كونه الكناسي الآتي.(@)(@@)(@@)(@@) $ 3724 - حفص بن عيسى الحنفي مولاهم الكوفي، أخو سليم المقري " ق ".(@)(@@)(@@)(@@) $ 3725 - حفص بن عيسى الكناسي الأعور بياع القرب والأداة " ق ". PageV01P440(@)(@@)(@@)(@@) $ 3726 - حفص بن غياث عامي، له كتاب معتمد، روى عن " ق " و " ظم " عليهما السلام وولي القضاء ببغداد الشرقية لهارون، ثم ولاه قضاء الكوفة، ومات بها سنة أربع وتسعين ومائة.(@)(@@)(@@)(@@) $ 3727 - حفص بن القاسم الكوفي " ق ".(@)(@@)(@@)(@@) $ 3728 - حفص بن قرعة، روى عنه ابن أبي عمير " تعق " وفيه دليل على الاعتماد بل الوثاقة.(@)(@@)(@@)(@@) $ 3729 - حفص بن قرط الأعور، كوفي عربي جمال " ق ".(@)(@@)(@@)(@@) $ 3730 - حفص بن قرط النخعي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3731 - حفص المؤذن يستفاد من " كش " أنه ابن محمد يكنى أبا محمد، وهو مؤذن ابن يقطين وروى عنه، وروى عنه الحسن بن علي بن يقطين.(@)(@@)(@@)(@@) $ 3732 - حفص بن مسلم البجلي مولى كوفي القسري " ق ".(@)(@@)(@@)(@@) $ 3733 - حفص بن ميمون الحماني الكوفي " ق " وفيه رواية تدل على ذمه، وكونه خطابيا الا أن الرواية ضعيفة، فيرد 
ms324	 قوله فقاهة.(@)(@@)(@@)(@@) $ 3734 - حفص بن نسيب بن عمارة " ق ".(@)(@@)(@@)(@@) $ 3735 - حفص بن النعمان الكوفي " ق " وعن نسخة أبو النعمان وقد سبق.(@)(@@)(@@)(@@) $ 3736 - حفص بن هيثم الأعور " ق ".(@)(@@)(@@)(@@) $ 3737 - حفص بن يونس أبو ولاد الحناط الآجري " ق ".(@)(@@)(@@)(@@) $ 3738 - الحكم بن أبي نعيم هو ابن عبد الرحمن " تعق ".(@)(@@)(@@)(@@) $ 3739 - الحكم أخو أبي غفيلة كوفي " ق ".(@)(@@)(@@)(@@) $ 3740 - الحكم الأعمى، له أصل، عنه الحسن بن محبوب " ست " وفي " تعق " انه ابن مسكين وليس ببعيد، وكذا في النقد والحاوي، وفي " مشكا " الحكم الأعمى عنه الحسن بن محبوب، ويحتمل ابن أبي نعيم وهو ابن عبد الرحمن.(@)(@@)(@@)(@@) $ 3741 - الحكم بن أيمن، له أصل، عنه ابن أبي عمير " ست " الخياط مولى قريش أبو علي جد قضاعة الحميري، وهو أحمد بن علي بن الحكم، روى حكم عن PageV01P441(@)(@@) " ق " و " ظم " عليهما السلام.(@)(@@)(@@)(@@) $ 3742 - الحكم بن أيوب " ق ".(@)(@@)(@@)(@@) $ 3743 - الحكم بن بشار، غال لا شئ " صه ".(@)(@@)(@@)(@@) $ 3744 - الحكم بن الحكم الصيرفي الأسدي مولاهم كوفي " ق " وزاد " جش " له كتاب يرويه عنه صفوان بن يحيى، وقال ابن نوح: هو ابن خلاد بن عيسى، وفي " مشكا " ابن حكيم الثقة، عنه صفوان وحماد وابن سماعة وابن أبي عمير.(@)(@@)(@@)(@@) $ 3745 - الحكم بن حكيم أبو خلاد الصيرفي، كوفي مولى ثقة، روى عن " ق " عليه السلام وهو ابن خلاد بن عيسى، عنه ابن أبي عمير وصفوان بن يحيى.(@)(@@)(@@)(@@) $ 3746 - الحكم بن زياد، ويقال: زياد الكوفي " ق ".(@)(@@)(@@)(@@) $ 3747 - الحكم السراج الكوفي " ق ".(@)(@@)(@@)(@@) $ 3748 - الحكم بن سعد الأسدي الناشري، عربي قليل الحديث شارك أخاه مشمعلا في كتاب الديات ومشمعل أكثر رواية منه، عنهما عبيس بن هشام.(@)(@@)(@@)(@@) $ 3749 - الحكم بن شعبة الأموي " ق ".(@)(@@)(@@)(@@) $ 3750 - الحكم بن الصلت الثقفي " قر " وزاد " ق " كوفي وفي " تعق " يظهر من روايته حسن عقيدته، وروى عنه عبد الله بن مسكان.(@)(@@)(@@)(@@) $ 3751 - الحكم بن عبد الرحمن الأعور الكوفي " ق ".(@)(@@)(@@)(@@) $ 3752 - الحكم بن علباء الأسدي في " صه " الحسين بن سعيد، عن محمد بن أبي عمير، عن الحكم بن علباء الأسدي، قال: وليت البحرين الخ. وفي " تعق 
ms325	 " تأتي هذه الحكاية عن أبيه، ولعله الاظهر من الاخبار مع احتمال التعدد، أقول: إنها تدل على حسن حاله، الا أنه روايها، فتأمل.(@)(@@)(@@)(@@) $ 3753 - الحكم بن عمرو الحماني كوفي " ق ".(@)(@@)(@@)(@@) $ 3754 - الحكم بن عمير الهمداني، مولى كوفي يكنى أبا الصباح " ق ".(@)(@@)(@@)(@@) $ 3755 - الحكم بن عيص، قد حضر مجلس الصادق عليه السلام مع خاله سليمان بن خالد، فقال عليه السلام: من هذا الغلام؟ فقال: ابن أختي. فقال: هل PageV01P442(@)(@@) يعرف هذا الامر؟ فقال: نعم. فقال: الحمد لله الذي لم يخلقه شيطانا.(@)(@@)(@@)(@@) $ 3756 - الحكم بن القتات، ثقة قليل الحديث " صه " وزاد " جش " له كتاب يرويه عنه أبو القاسم عبد الرحمن بن أبي هاشم البجلي، وفي " مشكا " ابن القتات عنه عبد الرحمن بن أبي هاشم: أقول: الرواي عن عبد الرحمن محمد بن علي الكوفي، وابن أبي حمزة، ومحمد بن الحسين.(@)(@@)(@@)(@@) $ 3757 - الحكم بن مسكين المكفوف مولى ثقيف أبو محمد كوفي، روى عن " ق " عليه السلام له كتب، عنه الحسن بن موسى الخشاب " جش " والهيثم بن أبي مسروق، ومحمد بن الحسين، وفي " تعق " يروي عنه ابن أبي عمير وابن محبوب وابن فضال ومحمد بن الحسين وغيره من الأجلة، فقبول حديثه قوي ببعض الامارات.(@)(@@)(@@)(@@) $ 3758 - حكيم مؤذن بني عبس " ق ".(@)(@@)(@@)(@@) $ 3759 - حماد بن أبي حميد الهمداني المرهبي مولى كوفي " ق ".(@)(@@)(@@)(@@) $ 3760 - حماد بن أبي حنيفة النعمان بن ثابت السلمي الفضلي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3761 - حماد بن أبي زياد الشيباني " ق " وهو كالسوابق غير معلوم الحال مطروح المقال، فلا يعتمد على حديثه.(@)(@@)(@@)(@@) $ 3762 - حماد بن أبي طلحة بياع السابري " ق " كوفي ثقة " صه " " جش " له كتاب، عنه جماعة منهم أحمد بن أبي بشر " جش " وفي " مشكا " ابن أبي طلحة الثقة، عنه أحمد بن أبي بشير وهو عن زرارة.(@)(@@)(@@)(@@) $ 3763 - حماد بن أبي العطارد الطائي الكوفي " قر " كوفي يكنى أبا المستهل، مات سنة إحدى وستين ومائة وله أربع وثمانون " ق " فقد بقي بعد وفاته عليه السلام عشر ونيف بملاحظة التاريخين.(@)(@@)(@@)(@@) $ 3764 - حماد بن أبي المثنى الكوفي " ق " غير معلوم الوصف 
ms326	 فيرد ما تفرد به من حديثه.(@)(@@)(@@)(@@) $ 3765 - حماد بن أسحم التميمي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3766 - حماد الأعشى الكوفي " ق ". PageV01P443(@)(@@)(@@)(@@) $ 3767 - حماد بن ثابت الكوفي الأنصاري " ق ".(@)(@@)(@@)(@@) $ 3768 - حماد بن حكيم، كوفي " ق " وهو على طريقنا المسلوكة في علم الرجال مردود الحديث كأضرابه.(@)(@@)(@@)(@@) $ 3769 - حماد بن خليفة أبو سليمان الكوفي " ق ".(@)(@@)(@@)(@@) $ 3770 - حماد بن خليفة الكناني الكوفي " ق ".(@)(@@)(@@)(@@) $ 3771 - حماد بن زيد البصري أبو إسماعيل الأزدي " ق " وفي حاشية الوسيط عن " قب " ابن زيد بن درهم الأزدي الجهني، ثقة ثبت فقيه، ويأتي في الكنى أنه يروي عنه ابن أبي عمير، وهو امارة أخرى على قبول حديثه.(@)(@@)(@@)(@@) $ 3772 - حماد بن زيد العامي المشهور، روى في المنتهى عن ابن أبي الحديد روى المحدثون عنه أنه قال: أرى أصحاب علي عليه السلام أشد له من أصحاب العجل لعجلهم. وهذا كلام شنيع، ثم قال: فتأمل. أقول: لا وجه للتأمل مع صحة النقل أنه كلام معوج لا يصدر من أحد من العقلاء، فهو أشبه بالمجانين والحمقاء واندراجه هنا حدسي.(@)(@@)(@@)(@@) $ 3773 - حماد بن زيد بن عقيل الحارثي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3774 - حماد السراج الكوفي " ق ".(@)(@@)(@@)(@@) $ 3775 - حماد السري، روى عنه ابن أبي عمير " تعق " وفي روايته عنه امارة لوثاقته والاعتماد، الا انه غير مذكور في كتب الرجال.(@)(@@)(@@)(@@) $ 3776 - حماد بن سليمان الكوفي، تابعي كان أستاذ أبي حنيفة " د " وفيه نظر، إذ أستاد أبي حنيفة هو حماد بن مسلم، كما هو المذكور في كتبهم، فتأمل فيها.(@)(@@)(@@)(@@) $ 3777 - حماد السمندري، كان كوفيا لكن متجره بسمندر الخزر " قي " وفيه رواية لو كانت صحيحة لكانت دالة على التعديل، الا انها مع الضعف من المرجحات، فلا يمكن الاتكال به.(@)(@@)(@@)(@@) $ 3778 - حماد بن سويد العامري مولاهم كوفي " ق ".(@)(@@)(@@)(@@) $ 3779 - حماد بن سيار الجواليقي الكوفي " ق ". PageV01P444(@)(@@)(@@)(@@) $ 3780 - حماد بن شعيب أبو شعيب الحماني الكوفي، أسند عنه " ق " قال عقد عن محمد بن عبد الله بن أبي حكيمة عن ابن نمير أنه صدوق، وهذه الرواية من المرجحات أيضا " صه " فتأمل.(@)(@@)(@@)(@@) $ 3781 - حماد بن صالح الأزدي البارقي الكوفي، 
ms327	 يكنى بأبي تراب " ق ".(@)(@@)(@@)(@@) $ 3782 - حماد بن صالح الجعفي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3783 - حماد بن ضمخة الكوفي، روى عنه وهب بن حفص، وكان ثقة، وزاد العلامة في " صه " بالضاد المعجمة المفتوحة والخاء المعجمة بعد الميم، وضبطه " د " بالمهملتين عن خط بعض المشايخ، ولا اعتبار بالخط خصوصا في النقط، لوقوع الغلط في الكثير كما ترى.(@)(@@)(@@)(@@) $ 3784 - حماد بن عبد الرحمن الأنصاري الكوفي، تابعي روى عن عبد الله بن حكيم، وهو مولى آل أبي ليلى " ق ".(@)(@@)(@@)(@@) $ 3785 - حماد بن عبد العزيز الجهني، مولاهم كوفي " ق ".(@)(@@)(@@)(@@) $ 3786 - حماد بن عبد العزيز السمندلي الكوفي " ق " وهو السمندري السابق كما يفهم من " د " و " شه " فتأمل.(@)(@@)(@@)(@@) $ 3787 - حماد بن عبد العزيز الهلالي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3788 - حماد بن عبد الكريم الجلاب الكوفي " ق ".(@)(@@)(@@)(@@) $ 3789 - حماد بن عبد الله المصري " ق ".(@)(@@)(@@)(@@) $ 3790 - حماد بن عتاب البكري الكوفي " ق ".(@)(@@)(@@)(@@) $ 3791 - حماد بن عثمان بن عمرو بن خالد الفزاري مولاهم، كوفي كان يسكن عرزم فنسب إليها، وأخوه عبد الله ثقتان رويا عن " ق " عليه السلام، وروى هو عن " ظم " و " ضا " عليهما السلام، وهو في السابقة أيضا، مات سنة تسعين ومائة.(@)(@@)(@@)(@@) $ 3792 - حماد بن عثمان الناب، من أصحاب " ق " و " ظم " و " ضا " عليهم السلام ثقة جليل القدر، حكى حمدوية عن أشياخه أنه وأخويه جعفرا والحسين كلهم فاضلون ثقات خيار من أهل اجماع " كش " مات سنة تسعين ومائة بالكوفة، عنه ابن PageV01P445(@)(@@) أبي عمير.(@)(@@)(@@)(@@) $ 3793 - حماد بن عمرو الصنعاني " ق ".(@)(@@)(@@)(@@) $ 3794 - حماد بن عمرو بن معروف العبسي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3795 - حماد بن عيسى الجهني البصري، عربي ثقة، له كتب، من أصحاب اجماع " كش " وحج خمسين، مات سنة تسع أو ثمان ومائتين، وعمر وله نيف وتسعون سنة، وهو غريق الجحفة بوادي قتاة.(@)(@@)(@@)(@@) $ 3796 - حماد بن مروان البكري الكوفي " ق ".(@)(@@)(@@)(@@) $ 3797 - حماد بن ميمون بن السائب الكوفي " ق ".(@)(@@)(@@)(@@) $ 3798 - حماد النوي، روى عنه ابن فضال " ق " يعني الحسن.(@)(@@)(@@)(@@) $ 3799 - حماد بن واصل البكري الكوفي " ق ".(@)(@@)(@@)(@@) $ 3800 - حماد بن واقد البصري الصفار " ق ".(@)(@@)(@@)(@@) $ 3801 
ms328	 - حماد بن واقد اللحام الكوفي " ق " وفي " تعق " يروي عنه جعفر بن بشير، وفي الكافي في باب التقية عنه قال: استقبلت الصادق عليه السلام في طريق فأعرضت عنه بوجهي، فمضيت فدخلت عليه بعد ذلك، فقلت: جعلت فداك أني لالقاك فأصرف وجهي كراهة أن أسفه عليك، فقال لي: رحمك الله (1).(@)(@@)(@@)(@@) $ 3802 - حماد بن هارون البارقي " ق ".(@)(@@)(@@)(@@) $ 3803 - حماد بن ييس " ق " وهو كسوابقه غير معلوم الحال متروك الحديث.(@)(@@)(@@)(@@) $ 3804 - حماد بن يحيى الجعفي مولاهم كوفي " ق ".(@)(@@)(@@)(@@) $ 3805 - حماد بن يزيد من أصحاب " ق " عليه السلام عامي " صه " " جخ " ضعفه اجتهادي مطروح الرواية.(@)(@@)(@@)(@@) $ 3806 - حماد بن اليسع الكوفي " ق ".(@)(@@)(@@)(@@) $ 3807 - حماد بن يعلى السعدي الثمالي " ق ".(@)(@@) PageV01P446(@)(@@)(@@)(@@) $ 3808 - حماد بن يونس " ق ".(@)(@@)(@@)(@@) $ 3809 - حمد بن حمد الكوفي " ق ".(@)(@@)(@@)(@@) $ 3810 - حمدان بن المهلب القمي، له كتاب يرويه ابن أبي عمير " جش " وفي " مشكا " ابن المهلب عنه ابن أبي عمير.(@)(@@)(@@)(@@) $ 3811 - حمزة بن حبيب أبو عمارة التيملي مولاهم المقري الكوفي " ق " لم أقف على غير اسمه ولقبه وكنيته، فلا يقبل حديثه فقاهة.(@)(@@)(@@)(@@) $ 3812 - حمزة بن حمران بن أعين الشيباني الكوفي، روى عن " ق " عليه السلام وأخوه أيضا عقبة بن حمران، روى عنه عليه السلام له كتاب عنه صفوان بن يحيى " جش " عنه ابن سماعه " ست ".(@)(@@)(@@)(@@) $ 3813 - حمزة بن ربعي بن عبد الله بن الجارود الهذلي البصري " ق " وهو كنظائره غير مقبول الرواية.(@)(@@)(@@)(@@) $ 3814 - حمزة بن زياد البكائي مولاهم الكوفي أبو الحسن " ق ".(@)(@@)(@@)(@@) $ 3815 - حمزة بن عبادة العنزي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3816 - حمزة بن طيار، روى " كش " بطريق معتمد ان الصادق عليه السلام ترحم عليه بعد موته ودعى له بالنصرة والسداد، وقال: انه شديد الخصومة عن أهل البيت. وقيل: إن الطيار لقب حمزه لا أبيه، وهو الظاهر من ترجمة ابن محمد الطيار في " ق ".(@)(@@)(@@)(@@) $ 3817 - حمزة بن عبد الله الغنوي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3818 - حمزة بن عبيد الله بن الحسين بن علي بن الحسين بن علي بن أبي طالب عليهم السلام " ق ".(@)(@@)(@@)(@@) $ 3819 - حمزة بن عمارة الجعفي مولاهم 
ms329	 الكوفي " ق ".(@)(@@)(@@)(@@) $ 3820 - حمزة بن عمارة العامري الكوفي " ق ".(@)(@@)(@@)(@@) $ 3821 - حمزة بن عمران بن مسلم الجعفي مولاهم كوفي " ق ".(@)(@@)(@@)(@@) $ 3822 - حمزة بن محمد الطيار كوفي " ق " وهو الطيار بن الطيار وقد سبق. PageV01P447(@)(@@) كذا ذكره في المنتهى ويستفاد منه أن اللقب لهما معا.(@)(@@)(@@)(@@) $ 3823 - حمزة بن نصر الكوفي " ق ".(@)(@@)(@@)(@@) $ 3824 - حمزة واليسع، ثم حمزة بن اليسع القمي " ق " وزاد " ظم " الأشعري وفي " تعق " يروي ابن أبي نصر، ومضى في أحمد ابنه روايته عن " ضا " عليه السلام أيضا.(@)(@@)(@@)(@@) $ 3825 - حميد أبو غسان الذهلي الكوفي " ق " والظاهر أنه ابن راشد المتقدم في الطبقة السابقة.(@)(@@)(@@)(@@) $ 3826 - حميد بن الأسود أبو الأسود البصري ختن عبد الرحمن بن مهدي " ق ".(@)(@@)(@@)(@@) $ 3827 - حميد بن حماد بن حوار التميمي الكوفي، أسند عنه " ق " روى عقد عن محمد بن عبد الله بن أبي حكيمة عن ابن نمير انه ثقة " صه " وحوار بفتح الحاء المهملة والراء بعد الألف، وذكر جماعة من العامة بالمعجمة.(@)(@@)(@@)(@@) $ 3828 - حميد بن السري العبدي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3829 - حميد بن سعده يكنى أبا غسان، روى عنه جعفر بن بشير " ق " وفي " تعق " فيه إشارة إلى الوثاقة. أقول: ليس فيه إشارة بل اشعار بها كما لا يخفى.(@)(@@)(@@)(@@) $ 3830 - حميد بن سويد الكلبي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3831 - حميد بن سيار الكوفي " ق ".(@)(@@)(@@)(@@) $ 3832 - حميد بن شعيب السبيعي الهمداني، كوفي روى عن " ق " عليه السلام وعن جابر عنه عبد الله بن جبلة، وجعفر بن محمد بن شريح، والحسن بن محمد بن سماعه بلا واسطة كما في " ست " أو مع واسطة عبد الله بن جبلة كما في " جش ".(@)(@@)(@@)(@@) $ 3833 - حميد بن شيبان " ق ".(@)(@@)(@@)(@@) $ 3834 - حميد الصيرفي " ق ".(@)(@@)(@@)(@@) $ 3835 - حميد الضبي الكوفي، روى عنه أبو جميله " ق ".(@)(@@)(@@)(@@) $ 3836 - حميد بن المثنى العجلي الكوفي أبي المعزاء الصيرفي، ثقة، له أصل PageV01P448(@)(@@) روى عن " ق " و " ظم " عليهما السلام عنه صفوان وابن أبي عمير وفضالة. واحتمل الميرزا كونه هو الصيرفي المتقدم، وهو غير واضح.(@)(@@)(@@)(@@) $ 3837 - حميد بن يزيد البكري الكوفي " ق ".(@)(@@)(@@)(@@) $ 3838 - حميل بن نافع الهمداني 
ms330	 " ق ".(@)(@@)(@@)(@@) $ 3839 - حنان بن أبي معاوية القبي الكوفي " ق " الظاهر أنه بتخفيف النون.(@)(@@)(@@)(@@) $ 3840 - حنان بن سدير الصيرفي، ثقة، واقفي، روى عن " ق " و " ظم " عليهما السلام كان معمرا، عنه ابن محبوب وإسماعيل بن مهران، يكنى أبا الفضل، فحديثه موثق. وفي " مشكا " ابن سدير الموثق عنه ابن أبي عمير وابن محبوب وابن مهران، وهو عن " ق " عليه السلام و " كش " انه " ظم " و " ضا ".(@)(@@)(@@)(@@) $ 3841 - حويرث بن زياد الهمداني كوفي " ق ".(@)(@@)(@@)(@@) $ 3842 - حيان الطائي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3843 - حيان بن عبد الرحمن الكوفي المدني مولاهم، مات سنة سبع وسبعين ومائة وهو ابن أحدي وثمانين سنة يكنى أبا العلاء " ق ".(@)(@@)(@@)(@@) $ 3844 - حيان بن علي العنزي، ثقة، أسند عنه " ق " وفي " صه " روى عن " ق " عليه السلام ثقة، وفي " مشكا " ابن علي العتري الثقة عن الصادق عليه السلام العتري بالعين المهملة المفتوحة والتاء المثناة من فوق الساكنة بعدها الراء، وفي " د " بفتح المثناة.(@)(@@)(@@)(@@) $ 3845 - حيان السراج، روى " كش " أنه كان كيسانيا " صه " وفي " كش " أخبار كثيرة في ذمه بعضها صحيح، وفي " مشكا " يعرف السراج بذكر عبد الله بن مسكان وبريد العجلي وعبد الرحمن بن الحجاج في طبقته.(@)(@@)(@@)(@@) $ 3846 - حيدر بن أيوب، روى عنه صفوان بن يحيى، وفيه حديث صحيح في ذمه، وهو أنه قال علي بن الحكم دعا لي أبو إبراهيم عليه السلام اليوم سبعة عشر رجلا من ولد علي وفاطمة عليهما السلام، فاشهدنا لعلي ابنه بالوصية والوكالة في حياته وبعد موته، إلى أن قال: مات حيدر وهو شاك، وهو في السابقة. PageV01P449(@)(@@)(@@)(@@) $ 3847 - خارجة بن محمد بن عبد الله بن نافع الجهني، مولاهم الكوفي صيرفي " ق ".(@)(@@)(@@)(@@) $ 3848 - خازم بن حبيب بن صهيب الجعفي، مولاهم كوفي " ق ".(@)(@@)(@@)(@@) $ 3849 - خازم بن الحسين أبو إسحاق الخميسي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3850 - خالد أبو إسماعيل الخياط الكوفي " ق ".(@)(@@)(@@)(@@) $ 3851 - خالد بن أبي إسماعيل، كوفي ثقة " صه " له أصل عنه صفوان " ست " قيل: لا يبعد أن يكون اسم أبي إسماعيل بكر بن الأشعث المتقدم الراوي عن " ظم " عليه السلام، فيكون 
ms331	 خالد بن بكر الواقع في طرق بعض الروايات، فتأمل.(@)(@@)(@@)(@@) $ 3852 - خالد بن أبي عمرو مولى بني أسد " ق ".(@)(@@)(@@)(@@) $ 3853 - خالد بن إسماعيل بن أيوب المخزومي المدني، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 3854 - خالد البجلي، في " كش " عن أبي سلمة قال: دخل خالد البجلي على الصادق عليه السلام وأنا عنده فقال: جعلت فداك اني أريد أن أصف لك ديني الحديث. وهو يدل على ايمانه وحسن اعتقاده، وقد حمل بعض على أنه ابن جرير الآتي، ولا يخلو من قرب بنوع من التقريب.(@)(@@)(@@)(@@) $ 3855 - خالد بن جرير بن عبد الله البجلي وأخوه إسحاق، له كتاب عنه الحسن بن محبوب، قال معد: سألت علي بن الحسن عن خالد الذي يروي عنه ابن محبوب، فقال: كان من بجيلة وكان صالحا روى عن الصادق عليه السلام. الا أنه لم يثبت صلاحه.(@)(@@)(@@)(@@) $ 3856 - خالد الجواز كما في " كش " و " جخ " وعن بعض نسخ " صه " جوار.(@)(@@) والظاهر أنه جوان وأنه ابن نجيح الآتي، كما عن نسخة صحيحة وعن " شه " و " ضح " كذلك، والله أعلم.(@)(@@)(@@)(@@) $ 3857 - خالد بن حماد القلانسي الكوفي مولى ثقة " د " قيل: لا غير، وهو سهو، وهو ابن ماد كما يأتي انتهى. أقول: لم أتحققه إلى هذا الزمان، ومع الصحة يروي عن " ق " عليه السلام. PageV01P450(@)(@@)(@@)(@@) $ 3858 - خالد بن حميد الرواسي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3859 - خالد بن حيان بن أبي حية الكلبي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3860 - خالد الخواتيمي، قال " كش ": أنه من أهل الارتفاع " صه " أقول:(@)(@@) لم أر في كلامه كونه بهذا اللقب من أهل الارتفاع، نعم قد ذكر في ترجمة المفضل أن إسحاق وعبد الله وخالد من أهل الارتفاع، ولم يعلم أنه الخواتيمي الا مع الاتحاد فتتبع.(@)(@@)(@@)(@@) $ 3861 - خالد بن داود الأسدي مولاهم " ق ".(@)(@@)(@@)(@@) $ 3862 - خالد بن راشد الزبيدي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3863 - خالد بن زياد القلانسي أو ابن باد بغير الزاي مع الموحدة التحتانية روى عن " ق " و " ظم " عليهما السلام ثقة " صه " ويأتي أنه ابن ماد كما ذكره بعض الرجاليين.(@)(@@)(@@)(@@) $ 3864 - خالد بن السري العبدي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3865 - خالد 
ms332	 بن سعيد أبو سعيد القماط، كوفي ثقة، روى عن " ق " عليه السلام " صه " " جش " وفي " مشكا " ابن سعيد أبو سعيد الثقة عنه محمد بن سنان، وإسماعيل بن مهران.(@)(@@)(@@)(@@) $ 3866 - خالد بن سعيد الأسدي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3867 - خالد بن سعيد الأموي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3868 - خالد بن سفيان الطحان الكوفي يعرف بشاذان " ق ".(@)(@@)(@@)(@@) $ 3869 - خالد بن سفيان بن عمير الفزاري البرجمي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3870 - خالد بن السميدع الكناني المدني " ق ".(@)(@@)(@@)(@@) $ 3871 - خالد بن سلمة أبو سلمة الجهمي الكوفي، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 3872 - خالد بن صبيح، كوفي ثقة، له كتاب روى عن " ق " عليه السلام ابن أبي عمير عنه وفي " ست " له أصل أخبرنا به عدة من أصحابنا عن أبي المفضل عن ابن بطة عن أحمد بن عيسى عن ابن أبي عمير عنه.(@)(@@)(@@)(@@) $ 3873 - خالد العاقول، وهو أبو إسماعيل الخياط " ق ". PageV01P451(@)(@@)(@@)(@@) $ 3874 - خالد بن عامر بن عداس الأسدي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3875 - خالد بن عبد الرحمن أبو النعيم العطار " ق " وقد حكي عن ابن نمير أنه ابن عبد الرحمن ثقة ثقة، والظاهر الاتحاد كما في " د ".(@)(@@)(@@)(@@) $ 3876 - خالد بن عبد الله الأرمني " ق ".(@)(@@)(@@)(@@) $ 3877 - خالد بن عبد الله السراج الكوفي " ق ".(@)(@@)(@@)(@@) $ 3878 - خالد بن ماد القلانسي، مولى ثقة، روى عن " ق " عليه السلام و " ظم " عليه السلام، له كتاب، عنه النضر بن شعيب " جش " " ست " وفي الأول أيضا يرويه أبو هريرة عبد الله بن سلام، قال أصحابنا: فيه نظر.(@)(@@)(@@)(@@) $ 3879 - خالد بن مازن القلانسي، كوفي مولى، روى عنه حكم بن مسكين الأعمى " ق " وفي " تعق " ما مر فيه في ابن زياد.(@)(@@)(@@)(@@) $ 3880 - خالد بن محمد الأصم الضبي، مولاهم كوفي " ق ".(@)(@@)(@@)(@@) $ 3881 - خالد بن مروان الواسطي " ق ".(@)(@@)(@@)(@@) $ 3882 - خالد بن مهران البجلي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3883 - خالد بن نافع الأشعري، مولاهم كوفي " ق ".(@)(@@)(@@)(@@) $ 3884 - خالد بن نافع البجلي " ق ".(@)(@@)(@@)(@@) $ 3885 - خالد بن نجيح الجوان أبو عبد الله، يروي عن " ق " و " ظم " عليهما السلام وفي " د " ابن نجيح الجوان بالجيم والنون بياع الجون، وكذا في " ضح 
ms333	 " وفي " كش " في ترجمة ابن عمر الجون في طريق رواية، ثم: انه من أهل الارتفاع، وتقدم من الجواز والحوار في " صه ".(@)(@@)(@@)(@@) $ 3886 - خالد بن يزيد المكنى بأبي خالد القماط " ق " معنى. ويمكن أن يكون التكنية لأبيه أيضا، أو يرجع الضمير إلى يزيد، عنه علي بن رئاب، كما في طرق بعض الروايات.(@)(@@)(@@)(@@) $ 3887 - خالد بن يزيد أبو يزيد العكلي، كوفي ثقة، روى عن " ق " عليه السلام له نوادر عن " قر " عليه السلام عنه عباد بن يعقوب الأسدي " جش " وهو في PageV01P452(@)(@@) التالية أيضا. والعكل أبو قبيلة بضم العين المهملة.(@)(@@)(@@)(@@) $ 3888 - خالد بن يزيد بن جرير البجلي الكوفي " ق " وعن بعض أنه ابن جرير المتقدم الذي أخوه إسحاق.(@)(@@)(@@)(@@) $ 3889 - خباب المسلي كوفي " ق ".(@)(@@)(@@)(@@) $ 3890 - خباب النخعي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3891 - خداش بن إبراهيم الكوفي " ق " وخراش ورد بالراء والدال، عنه عبد الله بن المغيرة، وفي " تعق " رواية في قبلة المتحير تدل على كونه اماميا وعمل الأصحاب بها، يشير إلى الاعتماد عليه، مضافا إلى رواية عبد الله عنه.(@)(@@)(@@)(@@) $ 3892 - خزيمة بن حازم " ق ".(@)(@@)(@@)(@@) $ 3893 - خزيمة بن ربيعة أو ربيلة الكوفي " ق ".(@)(@@)(@@)(@@) $ 3894 - خزيمة بن عمرو الكندي مولى كوفي " ق ".(@)(@@)(@@)(@@) $ 3895 - خضر بن عمارة الطائي الكوفي أبو عامر، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 3896 - خضر بن مسلم النخعي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3897 - خضيب بن عبد الرحمن الوابشي الزاهد الكوفي، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 3898 - خطاب بن داود الكوفي " ق ".(@)(@@)(@@)(@@) $ 3899 - خطاب بن سعيد الحميري " ق ".(@)(@@)(@@)(@@) $ 3900 - خطاب بن سلمة البجلي الجريري الكوفي " ق " وفي " تعق " يظهر من الكافي في كتاب الطلاق أنه " ظم " أيضا، وأنه من الشيعة، بل وحسن حاله في الجملة، ولعله ابن مسلمة، والاشتباه في مثله غير عزيز. أقول: هو غير واضح.(@)(@@)(@@)(@@) $ 3901 - خطاب بن عبد الله الهمداني الأعور " ق ".(@)(@@)(@@)(@@) $ 3902 - خطاب العصفري الكوفي " ق ".(@)(@@)(@@)(@@) $ 3903 - خطاب بن مسروق الكرخي " ق ".(@)(@@)(@@)(@@) $ 3904 - خطاب بن مسلمة الكوفي، كوفي ثقة، روى عن " ق " " صه " " جش " معنى، له كتاب عنه عدة منهم ابن أبي عمير الثاني، ومسلمة بفتح الميم. PageV01P453(@)(@@)(@@)(@@) $ 3905 - خلاد 
ms334	 بن أبي عمير الوابشي، كوفي " ق ".(@)(@@)(@@)(@@) $ 3906 - خلاد بن أبي مسلم الصفار " ق " وعن نسخة ابن مسلم، ويأتي عن " صه " خلاد الصفار، وفي الوجيزة " ح ".(@)(@@)(@@)(@@) $ 3907 - خلاد بن خلاد أبو الأسود الكلبي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3908 - خلاد بن خالد المقري; له كتاب، عنه البرقي محمد وابن أبي عمير وصفوان " ست " وفي " تعق " لا يبعد اتحاده مع السندي، وفي " مشكا " ابن خالد المقري عنه ابن أبي عمير وصفوان جميعا.(@)(@@)(@@)(@@) $ 3909 - خلاد بن زيد الجعفي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3910 - خلاد السندي البزاز الكوفي " ق " كوفي روى عن " ق " عليه السلام وقيل: ابن خلف المقري خال محمد بن علي الصيرفي أبي سمينة، له كتاب عنه عدة منهم ابن أبي عمير " جش " وفي " مشكا " عنه ابن أبي عمير وحده.(@)(@@)(@@)(@@) $ 3911 - خلاد الصفار، قال عقد: عن عبد الله بن إبراهيم بن قتيبة عن ابن نمير أنه ثقة ثقة، وهو أيضا من المرجحات عندي " صه " تقدم في ابن أبي مسلم الصفار.(@)(@@)(@@)(@@) $ 3912 - خلاد بن عامر المسلي العبدي " ق ".(@)(@@)(@@)(@@) $ 3913 - خلاد بن عطية مولى غني الكسائي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3914 - خلاد بن عمرو بن خالد بن الملائي أو المدائني الكوفي " ق ".(@)(@@)(@@)(@@) $ 3915 - خلاد بن عمر البكري الكوفي " ق ".(@)(@@)(@@)(@@) $ 3916 - خلاد بن عمير الكندي، مولاهم الكوفي " ق ".(@)(@@)(@@)(@@) $ 3917 - خلاد بن عمارة، يروي عنه ابن أبي نصر " تعق ".(@)(@@)(@@)(@@) $ 3918 - خلاد بن واصل بن سليم التميمي المنقري الكوفي " ق ".(@)(@@)(@@)(@@) $ 3919 - خلف بن حوشب الكوفي " ق ".(@)(@@)(@@)(@@) $ 3920 - خلف بن عيسى، له كتاب عن سليمان بن جعفر " ست " " جش " الجعفري عن " ق " عليه السلام في الثاني، عنه مهدي بن عتيق فيهما.(@)(@@)(@@)(@@) $ 3921 - خلف بن ياسين بن عمرو الكوفي الزيات، أسند عنه " ق ". PageV01P454(@)(@@)(@@)(@@) $ 3922 - خليد بن أوفى أبو الربيع الشامي العنزي، روى عن " ق " له كتاب يرويه عبد الله بن مسكان وخالد بن جرير، ويأتي عن " قر " خالد بن أوفى العنزي الشامي، وفي " صه " اسمه خليل بن أرفا، قيل: كأنه سهو.(@)(@@)(@@)(@@) $ 3923 - خليل بن أحمد النحوي الصرفي العروضي، عنه سيبويه بكتبه، وفي " صه " كان أفضل الناس 
ms335	 في الأدب وقوله حجة فيه، واخترع علم العروض، وكان امامي المذهب، توفى سنة الحادية والخمسة والسبعين بعد المائة.(@)(@@)(@@)(@@) $ 3924 - خليل العبدي كوفي، روى عن " ق " عليه السلام ثقة " صه " " جش " له كتاب عنه عبيس في الثاني و " ست " وفي " مشكا " ابن خليل العبدي الثقة، عنه عبيس بن هشام.(@)(@@)(@@)(@@) $ 3925 - خيري بن علي الطحان، كوفي ضعيف في مذهبه، كان غاليا له كتاب، عنه محمد بن إسماعيل بن بزيع، ويكثر الرواية عن يونس بن ظبيان وله كتاب عن " ق " عليه السلام.(@)(@@)(@@)(@@) $ 3926 - خيثمة لا يعرف بغير هذا كتابه رواية محمد بن عبيس بن عبد الله الأشعري " جش ".(@)(@@)(@@)(@@) $ 3927 - خيثمة بن خديج الرحيل الجعفي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3928 - خيثمة بن الرحيل بن معاوية الجعفي الكوفي أبو خديج، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 3929 - خيثمة بن عدي الهجري الكوفي " ق ".(@)(@@)(@@)(@@) $ 3930 - داود بن أبي داود الدجاجي الكوفي " ق " داود الدجاجي الكوفي " قر " والظاهر أنه في التالية كنظائره.(@)(@@)(@@)(@@) $ 3931 - داود بن عبد الله، مولى الحسن بن علي بن أبي طالب الهاشمي الكوفي، أخو شفيق بن أبي عبد الله وكان صفارا " ق " أي: نخاسا.(@)(@@)(@@)(@@) $ 3932 - داود بن أبي عوف أبو الحجاف البرجمي الكوفي " ق " وثقه عقد في الكنى كما يأتي. PageV01P455(@)(@@)(@@)(@@) $ 3933 - داود بن أبي يحيى أبو سليمان اليشكري الكوفي " ق ".(@)(@@)(@@)(@@) $ 3934 - داود بن أبي يزيد العطار، مولى ثقة، روى عن " ق " و " ظم " عليهما السلام له كتاب عنه علي بن الحسن الطاطري، والقاسم بن إسماعيل والحجال " جش " ست " والظاهر أنه ابن فرقد.(@)(@@)(@@)(@@) $ 3935 - داود بن أسد بن عفير أبو الأحوص المصري، شيخ جليل متكلم من أصحاب الحديث، ثقة ثقة، وأبوه أسد بن عفير من شيوخ أصحاب الحديث الثقات " صه " " جش " الا أن فيه أعفر أولاد عفر ثانيا والبصري بدل المصري، ويأتي في ما ينبغي أن يلاحظ.(@)(@@)(@@)(@@) $ 3936 - داود بن الحصين الكوفي " ق " واقفي " ظم " الأسدي مولاهم كوفي ثقة، روى عن " ق " و " ظم " عليهما السلام " صه " " جش " عنه العباس بن عامر، والقاسم بن إسماعيل " جش " " ست " وهو في السابقة. 
ms336	(@)(@@)(@@)(@@) $ 3937 - داود الحمار، هو ابن سليمان " تعق ".(@)(@@)(@@)(@@) $ 3938 - داود بن راشد الابزاري " ق " ويأتي عن " قر " في التالية داود الابزاري.(@)(@@)(@@)(@@) $ 3939 - داود الرقي هو ابن كثير الرقي، ويأتي أنه يروي عن " ق " عليه السلام.(@)(@@)(@@)(@@) $ 3940 - داود بن الزبرقان البصري، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 3941 - داود بن زربي، روى عن " ق " عليه السلام أبو سليمان الخندقي البندار، له كتاب، عنه علي بن خالد العاقول " جش " له أصل، عنه ابن أبي عمير " ست " كان أخص الناس بالرشيد لعنه الله.(@)(@@)(@@)(@@) $ 3942 - داود بن سرحان، مولى كوفي " ق " ثقة روى عن " ق " و " ظم " عليهما السلام ذكره ابن نوح " صه " له كتاب عنه أحمد بن محمد بن أبي نصر، وابن أبي نجران، وابن نهيك، وهو في السابقة أيضا.(@)(@@)(@@)(@@) $ 3943 - داود بن سعيد أبو عبد الله الكوفي الابزاري، ويأتي عن " قر " داود PageV01P456(@)(@@) الابزاري.(@)(@@)(@@)(@@) $ 3944 - داود بن سليمان الحمار الكوفي أبو سليمان، كوفي ثقة، روى عن " ق " عليه السلام له كتاب، عنه عدة منهم الحسن بن محبوب " جش " أحمد بن ميثم " ست " والظاهر أنه في السابقة أيضا.(@)(@@)(@@)(@@) $ 3945 - داود بن سليمان أبو عمارة البكري الكوفي " ق ".(@)(@@)(@@)(@@) $ 3946 - داود بن صالح الأزدي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3947 - داود بن صالح التميمي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3948 - داود بن عبد الجبار أبو سليمان الكوفي " ق ".(@)(@@)(@@)(@@) $ 3949 - داود بن عبد الرحمن أبو سليمان المكي العطار " ق ".(@)(@@)(@@)(@@) $ 3950 - داود بن عطاء المدني أبو سليمان " ق " " صه " عباد بن يعقوب عنه عن " قر " عليه السلام بأحاديثه النوادر " جش " وقال عقد: سمعت عبد الرحمن بن يوسف يقول: داود بن عطاء المدني ليس بشئ.(@)(@@)(@@)(@@) $ 3951 - داود بن عيسى النخعي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3952 - داود بن فرقد مولى آل أبي السماك النصري، كوفي روى عن " ق " و " ظم " واخوته يزيد وعبد الرحمن وعبد الحميد، له كتاب، عنه صفوان وابن البزنطي وعلي بن عقبة وغيرهم وقوله معتبر.(@)(@@)(@@)(@@) $ 3953 - داود بن كثير الرقي، قد مر أنه الرقي ثقة من أصحاب " ق " و " ظم " و " ضا " عليهم السلام مات بعد وفاة " ضا " عليه 
ms337	 السلام بعد المائتين بقليل، وفي المرفوع إلى " ق " عليه السلام أنه قال: أنزلوا داود الرقي مني بمنزلة المقداد.(@)(@@)(@@)(@@) $ 3954 - داود بن نصير أبو سليمان الطائي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3955 - داود بن الوراع الكوفي " ق ".(@)(@@)(@@)(@@) $ 3956 - داود بن الهيثم الأزدي أبو خالد الكوفي " ق ".(@)(@@)(@@)(@@) $ 3957 - داود بن يحيى بن بشير الدهقان، كوفي يكنى أبا سليمان ثقة " صه " وزاد " جش " له كتاب حديث علي بن الحسين، وفي " مشكا " ابن يحيى الثقة، عنه زيد PageV01P457(@)(@@) بن محمد بن جعفر العامري وعن الطريحي، عنه محمد بن جعفر العامري وكلاهما " م ".(@)(@@)(@@)(@@) $ 3958 - دبيس بن حميد أبو عيسى الملائي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3959 - دبيس بن يونس البزاز الكرابيسي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3960 - درست بن أبي منصور محمد، روى عن " ق " و " ظم " عليهما السلام له كتاب، عنه سعد بن محمد الطاطري، وعلي الطاطري، وابن نهيك، وابن أبي عمير، وهو في السابقة أيضا.(@)(@@)(@@)(@@) $ 3961 - ديسم بن أبي داود الكوفي، روى عنه أبو مريم " ق ".(@)(@@)(@@)(@@) $ 3962 - دينار أبو حكيم الأزدي مولاهم كوفي " ق ".(@)(@@)(@@)(@@) $ 3963 - دينار بن عمرو، مولى شيبان كوفي " ق ".(@)(@@)(@@)(@@) $ 3964 - ذريح بن محمد بن يزيد أبو الوليد المحاربي، روى عن " ق " و " ظم " عليهما السلام عنه عبد الله بن جبلة، وفيه رواية دالة على علو مرتبته رحمه الله تعالى.(@)(@@)(@@)(@@) $ 3965 - راشد أبو الخطاب المنقري، مولاهم كوفي " ق ".(@)(@@)(@@)(@@) $ 3966 - راشد أبو معاذ الأزدي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3967 - راشد بن سعد الفزاري مولاهم كوفي أبو سلمة " ق ".(@)(@@)(@@)(@@) $ 3968 - رافع بن أشرس الهمداني الكوفي " ق ".(@)(@@)(@@)(@@) $ 3969 - رباح بن أبي نصر السكوني الكوفي مولاهم " ق ".(@)(@@)(@@)(@@) $ 3970 - رباح بن الأسود التميمي، مولاهم كوفي " ق ".(@)(@@)(@@)(@@) $ 3971 - رباح بن عاصم التميمي العبدي، مولاهم كوفي " ق ".(@)(@@)(@@)(@@) $ 3972 - ربعي بن أحمر العجلي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3973 - ربعي بن عبد الله بن الجارود العبدي البصري، أبو نعيم الهذلي، ثقة، روى عن " ق " و " ظم " عليهما السلام وصحب ابن يسار وكان خصيصا به، أكثر الاخذ عنه ابن أبي عمير، وحماد بن عيسى، وعبد الله بن محمد بن خالد الطيالسي، وهو في السابقة.(@)(@@)(@@)(@@) $ 3974 
ms338	 - الربيع أبو زبيد الكوفي " ق " غير معلوم الحال ووصفه مجهول، PageV01P458(@)(@@) فحديثه غير مقبول.(@)(@@)(@@)(@@) $ 3975 - الربيع بن أبي مدرك أبو سعيد الكوفي، يقال له: المصلوب، كان صلب بالكوفة على التشيع، ثقة، روى عن " ق " عليه السلام له كتاب " ست " " جش " العلاء عنه في الثاني، وفي " مشكا " ابن أبي مدرك عنه العلاء.(@)(@@)(@@)(@@) $ 3976 - الربيع بن أحمر الأموي مولاهم الكوفي " ق ".(@)(@@)(@@)(@@) $ 3977 - الربيع بن أسحم الشيباني، مولاهم كوفي " ق ".(@)(@@)(@@)(@@) $ 3978 - الربيع بن الأسود الليثي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3979 - الربيع الأصم، له أصل، عنه الحسن بن محبوب " ست " وفي " تعق " يحتمل كونه ابن محمد المسلمي، ورواية ابن محبوب عنه يشير إلى القوة، ورواية ابن أبي عمير ولو بواسطة إلى الوثاقة، فتأمل. أقول: وهو في محله.(@)(@@)(@@)(@@) $ 3980 - الربيع بن بدر البصري " ق ".(@)(@@)(@@)(@@) $ 3981 - الربيع بن الحاجب " ق " ولم أقف على نسبه ووصفه، فلا يقبل قوله ولا حديثه.(@)(@@)(@@)(@@) $ 3982 - الربيع بن حبيب العبسي الكوفي " ق " وعن " قب " ابن حبيب بن الملاح الكوفي العبسي مولاهم الأحول، أخو عائذ بن حبيب صدوق، ضعف بسبب روايته عن نوفل بن عبد الملك، وقيل: وثقه ابن معين ولم يعلم.(@)(@@)(@@)(@@) $ 3983 - الربيع بن الركين بن الربيع بن عميلة الفزاري، أسند عنه " ق " وفيه مدح غير واف للوثاقة.(@)(@@)(@@)(@@) $ 3984 - الربيع بن زكريا الوراق، طعن عليه بالغلو، كالراوي عنه ابن أورمة، له كتاب فيه تخليط، ذكر ذلك أبو العباس بن نوح " صه " " جش " الا التشبيه ضعفه " غض " ولعله في السابقة أيضا.(@)(@@)(@@)(@@) $ 3985 - الربيع بن زياد الضبي الكوفي، سكن البصرة " ق ".(@)(@@)(@@)(@@) $ 3986 - الربيع بن زيد الكندي البصري، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 3987 - الربيع بن سعد الجعفي مولاهم كوفي خزاز " ق ". PageV01P459(@)(@@)(@@)(@@) $ 3988 - الربيع بن سليمان بن عمرو، كوفي صحب السكوني إسماعيل وأخذ عنه وأكثر، وهو قريب الامر في الحديث، قال " غض ": أمره قد طعن عليه، ويجوز أن يخرج شاهدا، عنه ابن سليمان إبراهيم.(@)(@@)(@@)(@@) $ 3989 - الربيع بن سهل بن الربيع الفزاري الكوفي " ق ".(@)(@@)(@@)(@@) $ 3990 - الربيع بن عاصم، أبو حماد الأزدي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3991 - الربيع بن عبد الرحمن الأسدي مولاهم 
ms339	 الكوفي " ق ".(@)(@@)(@@)(@@) $ 3992 - الربيع بن عطية الكلابي الكوفي " ق ".(@)(@@)(@@)(@@) $ 3993 - الربيع بن القاسم البجلي، مولاهم الكوفي " ق ".(@)(@@)(@@)(@@) $ 3994 - الربيع بن محمد بن عمير بن حسان الأصم المسلي، ومسلية قبيلة من مذحج، روى عن " ق " عليه السلام، له كتاب، عنه عباس بن عامر " جش " " ست ".(@)(@@)(@@)(@@) $ 3995 - رجاء بن الأسود الطائي " ق ".(@)(@@)(@@)(@@) $ 3996 - الرحيل بن معاوية بن خديج الجعفي الكوفي، أسند عنه " ق ".(@)(@@)(@@)(@@) $ 3997 - رزام بن مسلم، مولى خالد بن عبد الله القسري الكوفي " ق " وقد قال: كنت أعذب بعد ما خرج منها محمد بن خالد، فكان صاحب العذاب يعلقني بالسقف ويرجع إلى أهله ويغلق علي الباب الخبر، وهو يدل على جلالته.(@)(@@)(@@)(@@) $ 3998 - رزيق بن الزبير الخلقاني أبو العباس، والزبير بن أبي الزرقاء يكنى أبا العوام، روى عن " ق " عليه السلام ذكره ابن نوح، عنه محمد بن خالد الطيالسي بكتابه " جش " و " ست " ذكره في باب الزاي، وهو في السابقة.(@)(@@)(@@)(@@) $ 3999 - رزيق بن دينار أبو جهاد الكناسي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4000 - رزيق بن مرزوق كوفي ثقة، له كتاب، عنه إبراهيم بن سليمان " جش " وفي " ست " و " د " و " ز " عن " طس " ذكره في باب الزاي وكلام " ز " يشعر بان " جش " ذكره في الزاي، وليس كذلك.(@)(@@)(@@)(@@) $ 4001 - رزين بن أسيد الكوفي صاحب الرمان " ق ". PageV01P460(@)(@@)(@@)(@@) $ 4002 - رزين بن أنس الكلبي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4003 - زرين بن عبد ربه الكوفي، أسند عنه " ق " وفيه مدح لا يخفى.(@)(@@)(@@)(@@) $ 4004 - رزين بن عدي الأسدي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4005 - رزين بن علي الأزدي " ق ".(@)(@@)(@@)(@@) $ 4006 - رزين الكوفي " ق " وكأنه أحد السوابق.(@)(@@)(@@)(@@) $ 4007 - رفاعة بن محمد الحضرمي " ق " وفي رجال " د " ثقة لا غير، وفي " تعق " في النقد وثقه " د " لا غير، وكذا قال الميرزا في الوسيط.(@)(@@)(@@)(@@) $ 4008 - رفاعة بن موسى النخاس الأسدي، روى عن " ق " و " ظم " عليهما السلام، كان ثقة في حديثه مسكونا إلى روايته، لا يعترض بشئ من الغمز، حسن الطريقة " صه " " جش " عنه ابن خالد، وابن أبي عمير، وصفوان، وابن محبوب، وابن فضال، وفضالة، وعبد الله بن المغيرة، 
ms340	 ومحمد بن أبي حمزة الثمالي.(@)(@@)(@@)(@@) $ 4009 - رفيع مولى بني سكون كوفي " ق " لم أظفر على وصفه من الذم والمدح، فلا اعتداد بحديثه.(@)(@@)(@@)(@@) $ 4010 - رقيعة أو رقيقة المحاربي " ق " وهو كسابقه.(@)(@@)(@@)(@@) $ 4011 - رقيم بن الياس بن عمرو البجلي، كوفي ثقة، روى هو وأبوه وأخواه يعقوب وعمرو عن " ق " عليه السلام " صه " " جش " له كتاب، عنه علي بن الحسن الطاطري في الثاني، وفي " مشكا " ابن الياس الثقة، عنه علي بن الحسن الطاطري، وهو عن " ق " ولو عسر التميز فلا اشكال، لان غيره لا أصل له ولا رواية.(@)(@@)(@@)(@@) $ 4012 - رقيم بن عبد الرحمن الأزدي أبو محمد الكوفي " ق ".(@)(@@)(@@)(@@) $ 4013 - رقيم بن عبد الله الكوفي " ق " غير معلوم الوصف كسابقه، فلا يعبأ بحديثه.(@)(@@)(@@)(@@) $ 4014 - ركين بن الربيع " ق " لم أقف له على أزيد من العنوان، فهو كأضرابه غير مقبول القول مطروح الحديث فقاهة.(@)(@@)(@@)(@@) $ 4015 - ركين بن سويد الكلابي الجعفي مولاهم كوفي " ق ". PageV01P461(@)(@@)(@@)(@@) $ 4016 - روح بن عبد الرحيم بن روح الكوفي " ق " كوفي ثقة، روى عن " ق " عليه السلام " صه " " جش " عنه غالب بن عثمان بكتابه في الثاني.(@)(@@)(@@)(@@) $ 4017 - روح بن القاسم " ق " غير معلوم الحال متروك المقال فقاهة.(@)(@@)(@@)(@@) $ 4018 - رومي بن زرارة بن أعين الشيباني، مولاهم كوفي، روى عن " ق " و " ظم " ثقة قليل الحديث " صه " " جش " له كتاب، عنه محمد بن بكر بياع القطن في الثاني.(@)(@@)(@@)(@@) $ 4019 - رهم الأنصاري، حمدوية قال: حدثنا محمد بن عيسى، عن الحسن بن علي بن يقطين، عن رهم، قال حمدوية: فسألته عنه، فقال: شيخ من الأنصار كان يقول بقولنا " كش " عنه " صه " يفهم من ذلك كونه شيعيا.(@)(@@)(@@)(@@) $ 4020 - زافر بن سليمان الكوفي " ق ".(@)(@@)(@@)(@@) $ 4021 - زافر بن عبد الله الأياري أو الأنباري من رجال " ق " عليه السلام عامي كوفي.(@)(@@)(@@)(@@) $ 4022 - زاهر بن أسود الطائي أبو عمارة الكوفي " ق ".(@)(@@)(@@)(@@) $ 4023 - زائدة بن عمرو الهمداني الناعظي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4024 - زائدة بن موسى الكندي الكوفي " ق ".(@)(@@)(@@)(@@) $ 4025 - الزبرقان بالموحدة هو الأصح، والأظهر بصري يكنى أبا محمد.(@)(@@)(@@)(@@) $ 4026 - زحر بن زياد أبو الحصين 