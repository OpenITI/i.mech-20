ms2861	 -(@)(@@) يعقوب بن عتبة بن المغيرة بن الاخنس بن شريق الثقفى حليف لبنى زهرة حجازى روى عن عكرمة ويزيد بن هرمزواى غطفان PageV09P211(@)(@@) روى عنه محمد بن إسحاق وابراهيم (1) بن سعد سمعت أبي يقول ذلك نا عبد الرحمن قال سمعت ابى يقول قال يعقوب بن إبراهيم بن سعد عن ابيه قال: كان يعقوب بن عتبة ورعا مسلما يستعمل على الصدقات ويستعين به الولاة.(@)(@@) نا عبد الرحمن أنا يعقوب [بن إسحاق - 2] فيما كتب(@)(@@) إلى قال نا عثمان [بن سعيد - 2] قال سألت يحيى بن معين عن يعقوب ابن عتبة كيف حديثه؟ فقال: [هو - 2] ثقة.(@)(@@) نا عبد الرحمن قال سئل ابى عنه فقال ثقة.(@)(@@)(@@)(@@) $ 884 -(@)(@@) يعقوب بن عمرو بن عبد الله بن عمرو بن أمية الضمري روى عن الزبرقان بن عبد الله بن عمرو بن امية وجعفر بن عمرو بن أمية روى عنه حاتم بن إسماعيل وعبد الله (3) بن موسى الطلحى التيمي سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 885 -(@)(@@) (4) [يعقوب بن عمرو المعافرى روى عن أبيه عن عبد الله ابن عمرو روى عنه حيوة بن شريح وابن وهب سمعت أبي يقول ذلك - 5] .(@)(@@)(@@)(@@) $ 886 -(@)(@@) يعقوب بن عوذ بن سماك الانصاري روى عن سليمان بن بحير روى عنه زيد بن حباب سمعت أبي يقول ذلك، وسمعته يقول: هو مجهول(@)(@@)(@@)(@@) ||||| [باب الغين - 2](@)(@@)(@@)(@@) $ 887 - يعقوب بن الغضبان روى عن ابن مسعود روى عنه أبو سنان ضرار بن مرة سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) ||||| [باب الفاء - 2](@)(@@)(@@)(@@) $ 888 - يعقوب بن فضالة الخزاعي روى عن..روى عنه سليمان بن PageV09P212(@)(@@) شرحبيل ومحمد بن وهب بن عطية.(@)(@@) نا عبد الرحمن قال سألت أبي عنه فقال: شيخ مجهول.(@)(@@)(@@)(@@) ||||| [باب القاف - 1](@)(@@)(@@)(@@) $ 889 - يعقوب بن القعقاع الخراساني (2) قاضى مرو ايام ابى مسلم بصرى الاصل وهو ابن القعقاع بن الاعلم الازدي كنيته أبو الحسن، ابن عم القاسم بن الفضل الحدانى، روى عن عطاء والحسن (321 م 6) وقتادة ومطر الوراق روى عنه الثوري وابن المبارك (3) سمعت أبي يقول ذلك.(@)(@@) نا عبد الرحمن أنا عبد الله بن أحمد [بن محمد - 1] بن حنبل فيما كتب 
ms2862	 إلي قال سألت يحيى بن معين عن يعقوب بن القعقاع فقال: خراساني ثقة [ثقة - 4] .(@)(@@)(@@)(@@) $ 890 -(@)(@@) يعقوب بن قيس الكوفي روى عن سعيد بن جبير والشعبي وعكرمة روى عنه سفيان بن عيينة ويحيى بن (1156 ك) سعيد القطان ومحمد بن عبيد الطنافسي سمعت أبي يقول ذلك.(@)(@@) نا عبد الرحمن أنا عبد الله بن أحمد [بن محمد - 1] بن حنبل فيما كتب إلي قال سألت ابى عن يعقوب بن قيس فقال كوفى ثقة.(@)(@@)(@@)(@@) $ 891 -(@)(@@) يعقوب بن القاسم القرشى الطلحى من ولد طلحة بن عبيد الله نزيل بغداد روى عن عاصم بن سويد وابن المبارك وخلف بن خليفة والمطلب بن زياد [وابن عيينة - 1] كتب عنه أبى ببغداد، وروى عنه محمد بن عمار بن الحارث الرازي.(@)(@@)(@@)(@@) ||||| [باب الكاف - 1](@)(@@)(@@)(@@) $ 892 - يعقوب بن كعب الانطاكي أبو يوسف الحلبي روى عن عطاء PageV09P213(@)(@@) ابن مسلم وزكريا بن منظور ومخلد بن الحسين والوليد بن مسلم وشعيب ابن اسحاق ومحمد بن سلمة كتب عنه [ابى - 1] بانطاكية وسمعته يقول: كان ثقة.(@)(@@)(@@)(@@) ||||| [باب الميم - 2](@)(@@)(@@)(@@) $ 893 - يعقوب بن محمد بن طحلاء مولى لبنى ليث أبو يوسف المدينى ويقال ان (3) محمد بن طحلاء مولى جويرة بنت الحارث روى عن ابى الرجال وخالد بن ابى حيان روى عنه ابن ابى مريم وعبد الله ابن مسلمة بن قعنب [سمعت أبي يقول ذلك - 4] .(@)(@@) نا عبد الرحمن نا محمد ابن حمويه بن الحسن قال سمعت أبا طالب يقول سألت أحمد بن حنبل عن يعقوب بن محمد بن طحلاء فقال: ثقة.(@)(@@) نا عبد الرحمن قال قرئ على العباس [بن محمد الدوري قال - 2] سمعت يحيى بن معين يقول: يعقوب بن محمد بن طحلاء ثقة.(@)(@@) نا عبد الرحمن قال سألت ابى عن يعقوب ابن محمد بن طحلاء فقال: ليس به بأس.(@)(@@)(@@)(@@) $ 894 -(@)(@@) يعقوب بن محمد بن نجيد بن عمران بن حصين الخزاعي روى عن أبيه عن جده نجيد بن عمران بن حصين عن أبيه عمران بن حصين روى عنه أبو داود الطيالسي.(@)(@@) نا عبد الرحمن سمعت أبي يقول ذلك.(@)(@@) قال أبو محمد 
ms2863	 وروى عنه عبد الصمد بن عبد الوارث.(@)(@@)(@@)(@@) $ 895 -(@)(@@) يعقوب بن محمد روى عن هشام بن عروة روى عنه محمد بن عبادة (5) .(@)(@@) نا عبد الرحمن قال سئل أبو زرعة عنه فقال [هو - 4] شيخ ضعيف.(@)(@@)(@@)(@@) $ 896 -(@)(@@) يعقوب بن محمد بن عيسى الزهري وهو ابن عيسى بن حميد بن عبد الرحمن أبو يوسف روى عن (322 م 6) صالح بن قدامة وابراهيم PageV09P214(@)(@@) ابن سعد وعبد العزيز بن محمد وعبد العزيز بن أبي حازم روى عنه احمد ابن سنان سمعت أبي يقول ذلك.(@)(@@) نا عبد الرحمن أنا عبد الله بن احمد [ابن محمد - 1] بن حنبل فيما كتب إلي قال سمعت أبي يقول يعقوب ابن محمد الزهري ليس بشئ ليس يسوى شيئا.(@)(@@) نا عبد الرحمن قال سمعت أحمد بن سنان الواسطي قال سئل يحيى بن معين عن يعقوب بن محمد الزهري فقال: ما حدثكم عن شيوخه الثقات فاكتبوه، وما لم يعرف من شيوخه فدعوه.(@)(@@) نا عبد الرحمن نا علي بن الحسين [بن الجنيد - 2] ثنا الحجاج [بن - 3] الشاعر نا يعقوب بن محمد الزهري الثقة.(@)(@@) نا عبد الرحمن قال سألت ابى عن يعقوب بن محمد الزهري فقال: هو على يدي عدل، ادركته ولم اكتب عنه.(@)(@@) نا عبد الرحمن قال سئل أبو زرعة عن يعقوب ابن محمد الزهري فقال: واهى الحديث.(@)(@@)(@@)(@@) $ 897 -(@)(@@) يعقوب بن محمد بن عقبة المدينى ابن أخي موسى بن عقبة روى عن عمه موسى بن عقبة روى عنه محمد بن الحسن بن المختار [الكوفى - 3] نزيل الرى.(@)(@@)(@@)(@@) $ 898 -(@)(@@) يعقوب بن مجمع بن يزيد بن جارية الأنصاري روى عن عمه عبد الرحمن بن يزيد روى عنه ابنه مجمع بن يعقوب، سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 899 -(@)(@@) يعقوب بن مجاهد أبو حزرة مولى لبنى مخزوم وكان قاصا بالمدينة مات بالاسكندرية روى عن عبادة بن الوليد والقاسم بن محمد ومحمد بن كعب وعبد الله بن محمد بن أبي عتيق وعبد الرحمن بن جابر روى عنه يحيى بن ايوب المصرى وحاتم بن إسماعيل ويحيى بن سعيد(@)(@@) القطان وحسين الجعفي سمعت أبي يقول 
ms2864	 ذلك.(@)(@@) قال أبو محمد وروى عنه محمد بن جعفر بن ابى كثير وعبد العزيز بن محمد الدراوردي.(@)(@@) نا عبد الرحمن قال سألت ابا زرعة عن ابى حزرة قال: لا بأس به. PageV09P215(@)(@@)(@@)(@@) $ 900 -(@)(@@) يعقوب بن ماهان البغدادي مولى بني هاشم روى عن هشيم والقاسم بن مالك المزني كتب عنه أبي.(@)(@@) نا عبد الرحمن قال سألت أبي عنه (1157 ك) فقال [هو - 1] صدوق قال [لى - 1] ابى وقال لى حجاج [بن - 2] الشاعر: ليس ببغداد مثل يعقوب بن ماهان.(@)(@@)(@@)(@@) $ 901 -(@)(@@) يعقوب بن مسعود روى عن..روى عنه ضرار سمعت أبي يقول: هو مجهول.(@)(@@)(@@)(@@) ||||| [باب النون - 3](@)(@@)(@@)(@@) $ 902 - يعقوب بن النعمان بن اخى إسماعيل بن أبي خالد روى عن قيس ابن ابى حازم روى عنه يحيى بن عبد الملك بن حميد بن أبي غنية سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) ||||| [باب الواو - 3](@)(@@)(@@)(@@) $ 903 - (323 م 6) يعقوب بن الوليد المدينى سكن بغداد روى عن ابى حازم وهشام بن عروة روى عنه محمد بن الصباح الجرجرائى واحمد ابن منيع ومحمد بن عمر الكوفي سمعت أبي يقول ذلك.(@)(@@) نا عبد الرحمن أنا عبد الله بن أحمد [بن محمد - 3] بن حنبل فيما كتب إلي قال سمعت ابى يقول يعقوب بن الوليد من اهل المدينة كان من الكذابين الكبار، يحدث عن ابى حازم عن سهل بن سعد أن النبي صلى الله عليه وسلم(@)(@@) كان يأكل البطيخ (4) بالرطب وكان يضع الحديث.(@)(@@) نا عبد الرحمن قال سألت ابى عن يعقوب بن الوليد المدينى فقال: منكر الحديث، ضعيف الحديث، كان يكذب، والحديث الذى رواه موضوع، وهو متروك [الحديث - 3] .(@)(@@) نا عبد الرحمن قال سئل أبو زرعة عن PageV09P216(@)(@@) يعقوب بن الوليد فقال: ليس بشئ.(@)(@@) وترك حديثه ولم يقرأ علينا.(@)(@@)(@@)(@@) ||||| [باب الياء - 1](@)(@@)(@@)(@@) $ 904 -(@)(@@) يعقوب بن يحيى بن عباد بن عبد الله بن الزبير روى [عن - 2] عيسى بن معمر بن معمر عن عباد بن عبد الله بن الزبير، وروى عن أبي صالح السمان روى عنه صالح بن عبد الله بن صالح سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 905 -(@)(@@) يعقوب بن ابى يعقوب المديني 
ms2865	 روى عن أبي هريرة روى عنه أيوب بن عبد الرحمن بن ابى صعصعة سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 906 -(@)(@@) يعقوب بن يوسف(@)(@@) الدشتكى [روى عن ... - 3] [قال أبو محمد - 1] روى عنه أبي وسئل عنه فقال: صدوق.(@)(@@)(@@)(@@) ||||| باب تسمية من روى عنه العلم ممن يسمى يعقوب ولا ينسبون(@)(@@)(@@)(@@) $ 907 -(@)(@@) يعقوب الا حلا في العجلى [المؤذن - 1] كوفى روى عن عطاء وعن رجل عن زيد بن أرقم روى عنه سفيان الثوري سمعت أبي(@)(@@) يقول ذلك.(@)(@@)(@@)(@@) $ 908 -(@)(@@) يعقوب روى عن ابى سيرين قوله روى عنه سليمان الجرمى سمعت أبي يقول: هو مجهول.(@)(@@)(@@)(@@) |||| باب تسمية من روى عنه العلم ممن يسمى يوسف(@)(@@)(@@)(@@) ||||| واسم ابيه على الالف(@)(@@)(@@)(@@) $ 909 -(@)(@@) يوسف بن إسحاق [بن أبي اسحاق - 3] روى عن جده أبي إسحاق الهمداني ومحمد بن المنكدر وعبد الله بن محمد بن عقيل روى عنه اسراءيل PageV09P217(@)(@@) وابنه ابراهيم وسفيان بن عيينة وعيسى بن يونس ومنصور بن وردان العطار سمعت أبي يقول ذلك.(@)(@@) نا عبد الرحمن حدثني أبي ثنا عبد الجبار بن العلاء قال نا سفيان - يعني ابن عيينة - قال: كان يوسف احفظ ولد ابى اسحاق.(@)(@@) (324 م 6) وقال غيره عن ابن عيينة - أنه [قال - 1] كان قائد جده يقوده.(@)(@@) نا عبد الرحمن نا محمد بن أحمد بن البراء قال قال على ابن المديني قال سفيان بن عيينة: لم يكن من ولد أبي إسحاق [أحد - 1] أحفظ عندي من يوسف بن إسحاق بن أبي إسحاق.(@)(@@) نا عبد الرحمن قال سئل ابى عن يوسف بن إسحاق [بن أبي اسحاق - 2] فقال: يكتب حديثه.(@)(@@)(@@)(@@) $ 910 -(@)(@@) يوسف بن اسباط روى عن عائذ بن شريح والثوري روى عنه أبو الاحوص والمسيب بن واضح سمعت أبي يقول ذلك وسمعته يقول: كان رجلا عابدا، دفن كتبه، وهو يغلط كثيرا، وهو رجل(@)(@@) صالح، لا يحتج بحديثه.(@)(@@) قال أبو محمد وروى عنه عبد الرحمن بن محمد المحاربي.(@)(@@) ثنا عبد الرحمن أنا يعقوب بن اسحاق فيما كتبب إلي (3) قال نا عثمان [بن سعيد - 1] قال قلت ليحيى بن معين يوسف بن اسباط تعرفه؟ فقال: ثقة.(@)(@@)(@@)(@@) $ 911 
ms2866	 -(@)(@@) يوسف بن ابراهيم التميمي أبو شيبة الجوهرى بصري روى عن أنس بن مالك روى عنه عقبة (4) بن خالد وابو قتيبة وعبد الحميد الحمانى واسماعيل بن عبد الاعلى العنزي (5) والعلاء بن الحصين قاضى الرى PageV09P218(@)(@@) وعلى (1) بن يزيد الصدائى الاكفائى سمعت أبي يقول ذلك.(@)(@@) نا عبد الرحمن قال سألت أبي عنه فقال: هو ضعيف الحديث، منكر الحديث، عنده عجائب(@)(@@)(@@)(@@) $ 912 - (1158 ك) يوسف بن إسحاق بن الحجاج (2) الطاحونى الرازي السرى أبو يعقوب روى عن أبي الربيع الزهراني وشيبان بن فروخ وبشر بن هلال الصواف وعبد الواحد بن غياث سمعت منه بالسر وهو صدوق.(@)(@@)(@@)(@@) $ 913 -(@)(@@) يوسف بن ابى امية الثقفي روى عن الحكم بن هشام بن هشام روى عنه أبو زرعة رحمه الله.(@)(@@)(@@)(@@) ||||| [باب الباء - 3](@)(@@)(@@)(@@) $ 914 -(@)(@@) يوسف بن بهرام الرازي أبو بشر الخلقانى بصري سكن الري روى عن حوشب عن الحسن عن النبي صلى الله عليه وسلم قال: التغابن في النسا لا في الشرى والبيع.(@)(@@) روى عنه يحيى بن المغيرة والحسين بن عيسى بن ميسرة (4) وعبد الله [بن - 5] عمران الأصبهاني، كل هؤلاء رووا هذا الحديث عن يوسف بن بهرام.(@)(@@) نا عبد الرحمن قال سمعت بعض هذا من أبي وبعضه من قبلي.(@)(@@) نا عبد الرحمن قال سألت ابى عن يوسف بن بهرام فقال: شيخ كوفى (6) يكون في سوق الخلقان وقلت ما حاله قال: شيخ.(@)(@@)(@@)(@@) $ 915 -(@)(@@) يوسف بن بحر قاضى حمص أبو القاسم بغدادي سكن حمص روى عن حجاج بن محمد وبزيد بن هارون وعلى بن عاصم (325 م 6) PageV09P219(@)(@@) والاسود بن عامر ومحمد بن مصعب القرقسانى وابى المغيرة ومروان ابن محمد الطاطرى كتبت عنه (1) بحمص.(@)(@@)(@@)(@@) $ 916 -(@)(@@) يوسف بن بهلول الانباري التميمي روى عن شريك وعبد الله ابن إدريس وابن أبي زائدة سمعت أبي يقول ذلك.(@)(@@) قال أبو محمد روى عنه أبو زرعة.(@)(@@)(@@)(@@) ||||| [باب الجيم - 2](@)(@@)(@@)(@@) $ 917 - يوسف بن جوان من اهل فلسطين روى عن أبي أمامة الباهلي(@)(@@) انه لقيه بمحص روى عنه محمد بن زياد.(@)(@@)(@@)(@@) ||||| [باب الحاء - 2](@)(@@)(@@)(@@) $ 918 - يوسف بن الحكم أبو الحكم روى عن [ابن 
ms2867	 - 3] عمر روى عن يعلى بن عطاء سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 919 -(@)(@@) يوسف بن الحكم والد الحجاج بن يوسف [وهو يوسف - 4] ابن ابى عقيل الثقفي روى عن محمد بن سعد بن أبي وقاص روى عنه محمد بن ابى سفيان بن العلاء بن جارية سمعت أبي يقول ذلك.(@)(@@) نا عبد الرحمن نا محمد بن عوف الحمصى قال قال عبد الله بن صالح كاتب الليث حدثني حرملة بن عمران عن كعب بن علقمة قال: كان يوسف والد الحجاج ابن يوسف فاضلا من خيار المسلمين.(@)(@@)(@@)(@@) $ 920 -(@)(@@) يوسف بن الحكم بن أبي سفيان، عداده في أهل الحجاز، روى عن حفص بن عمر بن عبد الرحمن بن عوف وعمرو بن حنة ويقال عمرو بن حية روى عنه ابن جريج سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 921 -(@)(@@) يوسف بن حوشب أخو العوام بن حوشب روى عن عبد الله PageV09P220(@)(@@) ابن سعيد بن أبي هند روى عنه [عبد الله بن عمر - 1] بن ابان وأبو سعيد الأشج، سمعت أبي يقول ذلك، وسألته عنه فقال شيخ.(@)(@@)(@@)(@@) $ 922 -(@)(@@) يوسف بن ابى حكيم (2) سمع زيد بن ثوب رأى عليا رضي الله عنه يطوف روى عنه أبو عبيدة الحداد ومحمد بن ربيعة وابو بحر البكراوى ويزيد بن هارون سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 923 -(@)(@@) يوسف بن الحطاب المدنى روى عن عبادة بن الوليد بن عبادة عن جابر روى عنه شبابة سمعت أبي يقول ذلك.(@)(@@) نا عبد الرحمن قال سألت أبي عنه فقال: هو مجهول.(@)(@@)(@@)(@@) $ 924 -(@)(@@) يوسف بن الحجاج الحنفي روى عن الحسن قوله روى عنه قتيبة بن سعيد سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) ||||| [باب الخاء - 3](@)(@@)(@@)(@@) $ 925 - يوسف بن خالد السمى البصري يقال انما سمى السمى للحيته وسمته وكان صاحب رأى روى عن الاعمش (326 م 6) وزياد بن سعد روى عنه القواريرى والعباس بن الوليد النرسى وابو كامل وعبد الله بن عاصم الحماني سمعت أبي يقول ذلك.(@)(@@) نا عبد الرحمن أنا عبد الله ابن أحمد [بن محمد - 3] بن حنبل فيما كتب إلي قال سمعت يحيى بن معين [يقول - 4] وذكر 
ms2868	 يوسف بن خالد السمى فقال: كذاب خبيث عدو الله رجل سوء رأيته بالبصرة مالا احصى لا يحدث عنه احد فيه خير.(@)(@@) نا عبد الرحمن قال قرئ على العباس بن محمد الدوري قال سمعت يحيى بن معين يقول: يوسف بن خالد السمى كذاب زنديق لا يكتب حديثه (5) نا عبد الرحمن قال [سمعت أبي وسألته - 6] عن يوسف بن PageV09P221(@)(@@) خالد السمتى فقال: انكرت قول يحيى بن معين فيه انه (1159 ك) زنديق حتى حمل إلى كتاب قد وضعه في التجهم بابا بابا ينكر الميزان(@)(@@) في القيامة فعلمت ان يحيى بن معين [كان - 1] لا يتكلم الاعلى بصيرة وفهم.(@)(@@) قلت ما حاله؟ قال: ذاهب الحديث.(@)(@@) نا عبد الرحمن قال سمعت ابا زرعة وسألته عن يوسف بن خالد فقال: ذاهب الحديث، ضعيف الحديث، اضرب على حديثه، كان يحيى بن معين يقول: كان يكذب.(@)(@@)(@@)(@@) ||||| [باب الذال - 2](@)(@@)(@@)(@@) $ 926 - يوسف بن ابى ذرة روى عن جعفر بن عمرو بن أمية الضمرى روى عنه انس بن عياض والحارث بن ابى الزبير المدينى.(@)(@@) نا عبد الرحمن أنا أبو بكر بن أبي خيثمة فيما كتب إلى قال سئل يحيى بن معين عن يوسف بن أبي ذرة الذى روى عنه انس بن عياض قال: لا شئ.(@)(@@)(@@)(@@) ||||| [باب الزاى - 2](@)(@@)(@@)(@@) $ 927 - يوسف بن الزبير مولى عبد الله بن الزبير المكى كان يقرأ الكتب روى عن عبد الله بن الزبير روى عنه مجاهد سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 928 -(@)(@@) يوسف بن زياد النهدي أبو عبد الله البصري كان ببغداد روى عن إسماعيل بن أبي خالد روى عنه ... (3) سمعت أبي يقول ذلك.(@)(@@) وسمعته يقول: هو منكر الحديث.(@)(@@)(@@)(@@) $ 929 -(@)(@@) يوسف بن زياد أبو المهلب العوذى روى عن محمد بن سيرين روى عنه حبان بن هلال ومسلم بن إبراهيم سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 930 -(@)(@@) يوسف بن زياد روى عن أبي الياس ابن ابنة وهب بن منبه عن وهب بن منبه روى عنه اسد بن موسى المصرى. PageV09P222(@)(@@)(@@)(@@) ||||| [باب السين - 1](@)(@@)(@@)(@@) $ 931 - يوسف بن سعد مولى قدامة بن مظعون مدينى ويقال مولى عثمان 
ms2869	 بن مظعون روى عن عبد الله (327 م 6) بن جبير بن حية عن شداد بن اوس وروى عن ابن حاطب روى عنه خالد الحذاء وعلى ابن زيد وداود بن ابى هند والقاسم بن الفضل الحدانى والربيع بن مسلم والربيع بن صبيح وحماد بن سلمة سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 932 -(@)(@@) يوسف بن سرج روى حديثا مرسلا روى عنه سليمان التيمي سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 933 -(@)(@@) يوسف بن سابور ويقال [ابن - 1] شابور من اهل ايلة قدم المدينة روى عن سعيد بن المسيب روى عنه يونس بن يزيد، وروى بعضهم عن الليث عن يونس بن يزيد عن الزهري عنه.(@)(@@) نا عبد الرحمن قال فسمعت ابى يقول: الصحيح عندي يونس بن يزيد عن يوسف نفسه سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 934 -(@)(@@) يوسف بن سعيد الجذامي روى عن عبد الملك روى عنه محمد بن شعيب بن شابور.(@)(@@) ثنا عبد الرحمن سمعت أبي يقول ذلك ويقول: هو مجهول.(@)(@@)(@@)(@@) $ 935 -(@)(@@) يوسف بن السفر أبو الفيض الشامي كاتب الاوزاعي روى عن الأوزاعي روى عنه بقية بن الوليد سمعت أبي يقول ذلك.(@)(@@) نا عبد الرحمن حدثني أبي قال سمعت دحيما يقول: يوسف بن السفر ليس بشئ.(@)(@@) نا عبد الرحمن قال سألت أبي عنه فقال: منكر الحديث جدا.(@)(@@) نا عبد الرحمن قال سمعت ابا زرعة وسئل (2) عنه فقال: ذاهب الحديث.(@)(@@)(@@)(@@) $ 936 -(@)(@@) يوسف بن سلمان الباهلى البصري روى عن حاتم بن إسماعيل(@)(@@) وعبد العزيز الدراوردى وابن عينة سمع منه أبي بالبصرة في الرحلة PageV09P223(@)(@@) الثالثة.(@)(@@) نا عبد الرحمن قال سئل أبي عنه فقال: شيخ.(@)(@@)(@@)(@@) $ 937 -(@)(@@) يوسف بن سليمان البزاز الاعرج روى عن مهدى بن عبد الله الشامي سمع منه ابى.(@)(@@)(@@)(@@) $ 938 -(@)(@@) يوسف بن سعيد بن مسلم المصيصى روى عن علي بن بكار وحجاج بن محمد وبشر بن المنذر كان بالمصيصة ولم ادخل المصيصة ولم اكتب (1) عنه ثم [كتب - 2] إلى أبي وأبي زرعة والي ببعض حديثة وهو صدوق ثقة.(@)(@@)(@@)(@@) ||||| [باب الشين - 3](@)(@@)(@@)(@@) $ 929 - يوسف بن شعيب الخولانى روى عن أرطاة بن المنذر حدثنا عنه احمد 
ms2870	 بن عبد الواحد الرملي بالرملة.(@)(@@)(@@)(@@) ||||| [باب الصاد - 3](@)(@@)(@@)(@@) $ 940 - يوسف بن صهيب الكندي روى عن عبد الله بن بريدة وحبيب ابن يسار وكليب الاودى روى عنه جرير بن عبد الحميد ومعتمر بن سليمان ويحيى بن سعيد القطان والفريابي وعبيد الله بن موسى وأبو نعيم سمعت (328 م 6) أبي يقول ذلك.(@)(@@) قال أبو محمد وروى (1160 ك) عن الشعبى وموسى بن ابى المختار وزيد العمى.(@)(@@) نا عبد الرحمن قال ذكره أبي عن إسحاق بن منصور عن يحيى بن معين أنه قال: يوسف بن صهيب ثقة.(@)(@@) نا عبد الرحمن قال سألت ابى عن يوسف بن صهيب فقال: لا بأس به.(@)(@@)(@@)(@@) ||||| [باب الطاء - 2](@)(@@)(@@)(@@) $ 941 -(@)(@@) يوسف بن طهمان روى عن أبي أمامة بن سهل بن حنيف روى عنه عبيد الله بن عبد الرحمن (4) بن موهب وموسى بن عبيدة الربذى PageV09P224(@)(@@) وعبد الله بن وهب.(@)(@@) ثنا عبد الرحمن قال سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) ||||| [باب العين - 1](@)(@@)(@@)(@@) $ 942 - يوسف بن عبد الله بن سلام المدينى أبو يعقوب رأى النبي صلى الله عليه وسلم وليست له صحبة روى أن النبي صلى الله عليه وسلم اخذ تمرة (2) وكان البخاري قال في كتابه ان له صحبة (3) نا عبد الرحمن قال فسمعت أبي يقول: ليست له صحبة [له رؤية - 4] وروى عن عثمان رضي الله عنه روى عنه ابن المنكدر وعمر بن عبد العزيز ويحيى بن ابى الهيثم ويزيد ابن ابى امية الاعور والنضير بن قيس سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 943 -(@)(@@) يوسف بن عبد الله بن [الحارث بن - 5] اخت محمد بن سيرين بصرى سمع اباه روى عنه عاصم الاحول وخالد الحذاء وسليمان بن المغيرة وحماد بن سلمة ومبارك بن فضالة سمعت أبي يقول ذلك.(@)(@@) نا عبد الرحمن قال ذكره أبي عن إسحاق بن منصور عن يحيى بن معين انه قال: يوسف ابن عبد الله بن الحارث ثقة.(@)(@@)(@@)(@@) $ 944 -(@)(@@) يوسف بن عبد الله أبو شبيب القيسي سمع الحسن قوله روى عنه عبد الصمد بن عبد الوارث وأبو داود الطيالسي سمعت أبي يقول ذلك.(@)(@@) نا عبد 
ms2871	 الرحمن قال ذكره أبي عن إسحاق بن منصور عن يحيى بن معين انه قال: يوسف بن عبد الله أبو شبيب [القيسي - 5] لا شئ.(@)(@@)(@@)(@@) $ 945 -(@)(@@) يوسف بن عبد الرحمن روى عن..روى عنه عيسى بن إبراهيم البركى.(@)(@@) نا عبد الرحمن قال سألت ابى عنه فقال: لااعرفه حدثنى عنه PageV09P225(@)(@@) عيسى بن ابراهيم بحديثين كذب لا اصل لهما.(@)(@@)(@@)(@@) $ 946 -(@)(@@) يوسف بن عبد الحميد روى عن ثوبان روى عنه طريف بن عيسى سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 947 -(@)(@@) يوسف بن عبدة أبو عبدة روى عن ثابت البنانى وحميد الطويل روى عنه خلاد بن يحيى وغسان بن الربيع.(@)(@@) نا عبد الرحمن أنا علي بن أبي طاهر فيما كتب إلى قال نا أبو بكر الأثرم قال قلت لأبي عبد الله أحمد بن حنبل: يوسف بن عبدة (1) أبو عبدة؟ (329 م 6) قال: له احاديث مناكير عن حميد وثابت وكأنه ضعفه.(@)(@@) نا عبد الرحمن قال سألت ابى عن يوسف بن عبدة فقال: شيخ ليس بالقوى ضعيف.(@)(@@)(@@)(@@) $ 948 -(@)(@@) يوسف بن أبي بردة بن ابى موسى واسم ابى بردة عامر روى عن أبيه روى عنه اسراءيل بن يونس وسعيد بن مسروق سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 949 -(@)(@@) يوسف بن عقبة صاحب الحمراء روى عن موسى بن وردان روى عنه بكير بن عبد الله بن الأشج سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 950 -(@)(@@) يوسف بن عطية أبو (2) سهل الصفار الصريمى مولى الانصار(@)(@@) بصرى روى عن قتادة وثابت البنانى وعطاء بن ابى ميمونة روى عنه يزيد بن هارون وسعيد بن سليمان الواسطي ومحمد بن سعيد بن السكن واحمد بن سليمان بن أبي الطيب سمعت أبي يقول ذلك.(@)(@@) نا عبد الرحمن قال قرئ على العباس بن محمد الدوري قال سمعت يحيى بن معين يقول: يوسف بن عطية ليس بشئ.(@)(@@) نا عبد الرحمن نا محمد بن إبراهيم أنه حدثه عمرو بن على بأن يوسف [بن عطية - 3] الصفار ابا سهل مولى الانصار كثير الوهم والخطأ.(@)(@@) نا عبد الرحمن قال سألت ابى وابا زرعة PageV09P226(@)(@@) عن يوسف بن عطية ابى سهل الصفار 
ms2872	 فقال: ضعيف الحديث.(@)(@@) (1161 ك) ثنا عبد الرحمن قال سمعت أبي يقول: هو منكر الحديث.(@)(@@)(@@)(@@) $ 951 -(@)(@@) يوسف بن عطية أبو المنذر الوراق الكوفى روى عن ميمون أبي حمزة (1) سمعت أبي يقول: لا اعرف لابي المنذر الوراق الذى روى عن (1) ابى حمزة اسما حدثنا عنه سهل بن عثمان ومحمد بن آدم الكوفى نزيل المصيصة وابو المنذر ضعيف.(@)(@@)(@@)(@@) $ 952 -(@)(@@) يوسف بن عطية الكوفى قدم البصرة فنزل المربد روى عن عمرو بن شمر سمع منه عمرو بن علي سمعت أبي يقول ذلك.(@)(@@) حدثنا عبد الرحمن نا محمد بن إبراهيم نا عمرو بن على ان يوسف بن عطية الكوفى قدم عليهم فنزل المربد، وانه اكذب من يوسف بن عطية الصفار، حدث باحاديث منكرة عن قوم معروفين.(@)(@@)(@@)(@@) $ 953 -(@)(@@) يوسف بن عدى اخو زكريا بن عدى روى عن مالك بن أنس(@)(@@) وعبيد الله بن عمرو وابى المليح وذواد (2) بن علبة وشريك وعبد الرحمن ابن أبي الزناد وأبي الأحوص روى عنه أبي وأبو زرعة.(@)(@@) نا عبد الرحمن قال سئل أبي عنه فقال: ثقة.(@)(@@) حدثنا عبد الرحمن قال سئل أبو زرعة عنه فقال: ثقة ذهب إلى مصر في التجارة ومات بها.(@)(@@)(@@)(@@) $ 954 -(@)(@@) يوسف بن عيسى (330 م 6) أبو يعقوب المروزي روى عن وكيع سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) ||||| [باب الغين - 3](@)(@@)(@@)(@@) $ 955 - يوسف بن الغرق الباهلى قاضى عسكر مكرم روى عن مرزوق ابى بكر وابى الرجال والصلت بن طريف روى عنه سلمة بن بشير واحمد بن ابى سريج.(@)(@@) نا عبد الرحمن سمعت أبي يقول ذلك.(@)(@@) وسألته عنه PageV09P227(@)(@@) فقال: ليس بقوي.(@)(@@) سمعت أبي يقول قال احمد بن حنبل: رأيته ولم اكتب عنه شيئا.(@)(@@)(@@)(@@) ||||| [باب الفاء - 1] [قال أبو محمد - 1] .(@)(@@)(@@)(@@) $ 956 -(@)(@@) يوسف بن الفيض (2) [روى عن الأوزاعي روى عنه عبد الله ابن عمران العائذى.(@)(@@) سألت أبي عنه فقال: ضعيف الحديث، هو شبه المتروك.(@)(@@)(@@)(@@) ||||| [باب الكاف](@)(@@)(@@)(@@) $ 957 -(@)(@@) يوسف - 3] بن كامل العطار روى عن سويد أبي حاتم ونافع بن عمر الجمحى روى عنه عمرو بن علي الصيرفى، وروى أبو زرعة عن رجل عنه.(@)(@@)(@@)(@@) ||||| [باب الميم 
ms2873	 - 1](@)(@@)(@@)(@@) $ 958 - يوسف بن محمد بن ثابت بن قيس بن شماس الأنصاري مديني روى عن أبيه عن جده روى عنه عمرو بن يحيى بن عمارة المازني سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 959 -(@)(@@) يوسف بن محمد بن يزيد بن صيفي بن صهيب روى عن شعيب ابن عمرو الامانى (4) وابيه وعبد الحميد بن زياد بن صيفي بن صهيب روى عنه علي بن بحر بن برى وابراهيم [بن المنذر - 1] الحزامى ويوسف بن عدى وهشام بن عمار سمعت أبي يقول ذلك.(@)(@@) نا عبد الرحمن PageV09P228(@)(@@) قال سألت ابى عن يوسف بن محمد بن يزيد بن صيفي فقال شيخ وهو من ولد صهيب لا بأس به.(@)(@@)(@@)(@@) $ 960 -(@)(@@) يوسف بن محمد بن المنكدر روى عن ابيه روى عنه معاذ بن معاذ وابن أبي فديك وعبد الله بن جعفر الرقى وسنيد بن داود سمعت أبي يقول ذلك.(@)(@@) نا عبد الرحمن قال سألت أبي عنه فقال: ليس بقوى يكتب حديثه.(@)(@@) نا عبد الرحمن قال سئل أبو زرعة عنه فقال: هو صالح وهو اقل رواية من اخيه المنكدر.(@)(@@)(@@)(@@) $ 961 -(@)(@@) يوسف بن ماهك القرشي روى عن ابن عباس وابن عمر و [عبد الله - 1] بن عمرو [وعائشة - 1] وام هانئ روى عنه أبو بشر جعفر بن اياس وابراهيم بن مهار [ويحيى بن أبي كثير - 1] وعبد الله بن عثمان بن خثيم سمعت أبي يقول ذلك.(@)(@@) نا عبد الرحمن قال ذكره أبي عن إسحاق بن منصور عن يحيى بن معين [انه - 1] قال: يوسف بن ماهك ثقة.(@)(@@)(@@)(@@) $ 962 -(@)(@@) يوسف بن مهران مكى (331 م 6) روى عن ابن عباس وابن عمر روى عنه علي بن زيد بن جدعان سمعت أبي يقول ذلك.(@)(@@) قال ابى وروى بعضهم عن على بن زيد فقال: عن يوسف بن ماهك.(@)(@@) ويوسف بن مهران اصح.(@)(@@) نا عبد الرحمن نا علي بن الحسن الهسنجاني قال [نا - 1] احمد [يعنى - 2] بن حنبل قال نا عفان نا حماد بن زيد قال سمعت على بن زيد - وذكر يوسف بن مهران فقال: كنا نشبه حفظه بحفظ عمرو بن دينار.(@)(@@) ثنا عبد 
ms2874	 الرحمن قال سألت ابى عن يوسف ابن مهران فقال: لا أعلم روى عنه غير علي بن زيد بن جدعان، يكتب حديثه ويذاكر به.(@)(@@) نا عبد الرحمن قال سئل أبو زرعة عن يوسف بن مهران فقال: مكى ثقة. PageV09P229(@)(@@)(@@)(@@) $ 963 -(@)(@@) يوسف بن مسعود بن الحكم الزرقي (1162 ك) الانصاري روى عن جدته ولها صحبة روى عنه يحيى بن سعيد الأنصاري سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 864 -(@)(@@) يوسف بن ميمون القرشى روى عن أبي عبيدة بن حذيفة روى(@)(@@) عنه أبو مالك النخعي سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 965 -(@)(@@) يوسف بن ميمون الصباغ، وكنيته أبو خزيمة، بصرى روى عن عطاء بن أبي رباح وانس بن سيرين وحماد بن أبي سليمان وأبى الزبير، روى عنه قطبة بن عبد العزيز وعلى بن مسهر والفضل بن موسى السينانى ووكيع وابو يحيى الحماني (1) سمعت أبي يقول ذلك [قال أبو محمد وروى عنه إسحاق بن موسى الأنصاري - 2] نا عبد الرحمن نا محمد بن حمويه بن الحسن قال سمعت أبا طالب قال قال احمد بن حنبل يوسف بن ميمون الصباغ [ضعيف ليس بشئ.(@)(@@) سئل ابى عن يوسف ابن ميمون الصباغ - 3] فقال: ليس بالقوي، منكر الحديث جدا، ضعيف.(@)(@@)(@@)(@@) $ 966 -(@)(@@) يوسف بن مازن بصري روى عن علي بن أبي طالب رضي الله عنه، مرسل، وعن الحسن بن علي روى عنه القاسم بن الفضل الحدانى ونوح ابن قيس سمعت أبي يقول ذلك.(@)(@@) نا عبد الرحمن قال ذكره أبي عن إسحاق بن منصور عن يحيى بن معين أنه قال يوسف بن مازن الذى PageV09P230(@)(@@) روى عنه القاسم بن الفضل مشهور.(@)(@@)(@@)(@@) $ 967 -(@)(@@) يوسف بن المهاجر الحداد روى عن القاسم بن محمد وأبي جعفر محمد بن علي وعمر بن عبد العزيز روى عنه سفيان بن عيينة وابن المبارك [ويحيى (332 م 6) بن اليمان - 1] ووكيع وأبو نعيم سمعت أبي يقول ذلك.(@)(@@) نا عبد الرحمن قال ذكره أبي عن إسحاق بن منصور عن يحيى بن معين أنه قال: يوسف بن المهاجر الحداد ثقة.(@)(@@) نا عبد الرحمن قال سألت ابى عن يوسف 
ms2875	 بن المهاجر فقال: ما بحديثه بأس ثنا عنه أبو نعيم.(@)(@@)(@@)(@@) $ 968 -(@)(@@) يوسف بن المنازل (2) أبو يعقوب التيمى كوفى روى عن حفص ابن غياث وابن إدريس سمعت أبي يقول ذلك.(@)(@@) قال أبو محمد وروى عن عبدة بن سليمان ومحمد بن فضيل سمع منه أبي في الرحلة الأولى سنة ثلاث عشرة ومائتين وروى عنه.(@)(@@) قال أبو محمد وروى عنه أبو سعيد الأشج.(@)(@@) نا عبد الرحمن أنا [أبو بكر - 3] بن أبي خيثمة فيما كتب إلي قال سمعت يحيى بن معين يقول: يوسف بن المنازل (2) ثقة.(@)(@@) نا عبد الرحمن قال سألت ابى عن يوسف بن المنازل (2) فقال: ثقة.(@)(@@)(@@)(@@) $ 969 -(@)(@@) يوسف بن موسى القطان الكوفى، وأصله اهوازي روى عن جرير بن عبد الحميد وحكام بن سلم ومهران بن ابى عمر العطار وأبي زهير عبد الرحمن بن مغراء وسلمة بن الفضل وعبد الله بن ادريس ومحمد بن فضيل ووكيع وعبد الله بن نمير روى عنه أبي وأبو زرعة.(@)(@@) نا عبد الرحمن قال سألت أبي عنه فقال: هو صدوق.(@)(@@)(@@)(@@) $ 970 -(@)(@@) يوسف بن موسى التسترى أبو غسان سكن الرى روى عن يحيى ابن سعيد القطان وعبد الرحمن بن مهدى وابى قتيبة سلم بن قتيبة واسماعيل PageV09P231(@)(@@) ابن محمد بن حجادة وابراهيم بن عيينة ووكيع وازهر السمان وعبد الصمد ابن عبد الوارث وابى داود الطيالسي روى عنه أبي وعلى بن الحسين ابن الجنيد.(@)(@@) نا عبد الرحمن قال سئل ابى عنه فقال: صدوق.(@)(@@)(@@)(@@) $ 971 -(@)(@@) يوسف بن ابى المختار روى عن أبيه قال رأيت معاوية بن ابى سفيان يصفر لحيته.(@)(@@) روى عنه نوح بن قيس سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 972 -(@)(@@) يوسف بن ابى المتئد (1) خال سفيان بن عيينة روى عن عطاء ابن ابى رباح روى عنه سفيان بن عيينة واسحاق بن منصور السلولى ويحيى بن ابى بكير وعبيد الله بن موسى سمعت أبي يقول ذلك (2) .(@)(@@)(@@)(@@) $ 973 -(@)(@@) يوسف بن ابى مريم عن ... (333 م 6) روى عنه ... سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) ||||| [باب النون - 3](@)(@@)(@@)(@@) $ 974 - يوسف بن نباتة الحدانى بصري روى عن أبيه عن معاوية 
ms2876	 روى عنه مسلم بن إبراهيم سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 975 -(@)(@@) يوسف بن نافع روى عن عبد الرحمن بن ابى الزناد روى عنه جعفر بن عبد الواحد.(@)(@@)(@@)(@@) ||||| [باب الواو - 3](@)(@@)(@@)(@@) $ 976 - يوسف بن واضح المكتب بصرى روى عن قدامة بن شهاب روى عنه أبي رحمه الله.(@)(@@) نا عبد الرحمن قال سألت ابى عنه فقال: [كان - 3] محله الصدق.(@)(@@)(@@)(@@) $ 977 -(@)(@@) يوسف بن واقد الرازي أبو يعقوب الصيقل روى عن يعقوب(@)(@@) بن عبد الله الاشعري وابن المبارك وجرير بن عبد الحميد سمعت ابى يقول PageV09P232(@)(@@) ذلك (1163 ك) قال أبو محمد وروى عن العلاء بن الحصين وعباءة (1) ابن كليب ورأى عبد العزيز بن عمر بن عبد العزيز مختضبا بالحناء (2) ورأى الحجاج بن ارطاة مختضبا بالسواد وعليه السواد.(@)(@@) نا عبد الرحمن قال سمعت ابى يقول: كان أبو يعقوب الصيقل صدوقا.(@)(@@)(@@)(@@) ||||| [باب الياء - 3](@)(@@)(@@)(@@) $ 978 - يوسف بن يعقوب [يقال ابن خاطب - 4] روى عن السائب ابن يزيد روى عنه ابن أبي ذئب وابو معشر سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 979 -(@)(@@) يوسف بن يعقوب رجل من اهل مكة روى عن..روى عنه حميد الطويل سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 980 -(@)(@@) يوسف بن يعقوب رجل من (5) اليمن، يقال انه ابن يعقوب ابن ابراهيم بن سعد (6) بن يزدويه (7) من الابناء، يكنى ابا عبد الله، كان على قضاء صنعاء، ويفتى، روى عن عمر بن عبد العزيز وطاوس [قام - 3] ولم يسمع من طاوس، روى عنه الثوري وهشام بن يوسف وعبد الرزاق ومحمد بن الحسن بن اتش سمعت أبي يقول ذلك.(@)(@@) نا عبد الرحمن قال وسئل أبي عنه فقال: لا اعرفه، هو شيخ مجهول.(@)(@@)(@@)(@@) $ 981 -(@)(@@) يوسف بن يعقوب الحنفي روى حديثا مرسلا روى عنه جعفر ابن سليمان الضبعي سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 982 -(@)(@@) يوسف بن يعقوب السدوسى صاحب السلعة روى عن سليمان(@)(@@) التيمى وشعبة وبهز بن حكيم وعيسى بن سنان روى عنه عبيد الله (8) PageV09P233(@)(@@) ابن عمر القواريرى وأحمد بن إبراهيم الدورقي ومحمد بن المثنى ومحمد بن بشار سمعت أبي يقول ذلك.(@)(@@) قال أبو محمد حدثنا عنه أحمد بن عصام. 
ms2877	(@)(@@) نا عبد الرحمن أنا علي بن أبي طاهر فيما كتب إلى قال نا أبو بكر الأثرم قال سمعت أبا عبد الله أحمد بن حنبل وذكر ابا يعقوب صاحب السلعة فقال: ثقة.(@)(@@) نا عبد الرحمن قال سألت ابى عن يوسف بن يعقوب صاحب السلعة (334 م 6) فقال: صدوق صالح الحديث.(@)(@@)(@@)(@@) $ 983 -(@)(@@) يوسف بن يعقوب بن ابراهيم القاضى توفى سنة اثنتين وتسعين ومائة (1) سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 984 -(@)(@@) يوسف بن يعقوب بن ابى سلمة الماجشون أبو سلمة روى عن محمد بن المنكدر ووهب بن كيسان وصالح بن ابراهيم روى عنه ابراهيم ابن حمزة الزبيري ومسدد وعبيد الله بن عمر بن القواريرى (2) وزكريا ابن يحيى بن صبيح ويعقوب بن حميد سمعت أبي يقول ذلك.(@)(@@) قال أبو محمد وروى عن الزهري وأبيه روى عنه يحيى بن حسان التنيسى ومسلم بن إبراهيم.(@)(@@) نا عبد الرحمن قال قرئ على العباس بن محمد الدوري قال سمعت يحيى بن معين يقول: يوسف بن الماجشون ثقة.(@)(@@) نا عبد الرحمن(@)(@@) قال سئل ابى عن يوسف بن الماجشون فقال: شيخ.(@)(@@) [قال أبو محمد - 3] .(@)(@@)(@@)(@@) $ 985 -(@)(@@) يوسف بن يعقوب الصفار روى عن أبي بكر بن عياش وعبيد ابن سعيد (4) وبكر بن سليم ومعن بن عيسى روى عنه أبي وأبو زرعة سمعت أبي يقول: يوسف بن يعقوب الصفار ثقة.(@)(@@)(@@)(@@) $ 986 -(@)(@@) يوسف بن يزيد أبو معشر البراء العطار البصري وكان يبرى العود روى عن ابى حازم وموسى بن دهقان وعبيد الله بن الاخنس وراشد PageV09P234(@)(@@) ابى محمد روى عنه عبيد الله بن عمر القواريري ومحمد بن ابى بكر المقدمى وابن عرعرة، سمعت أبي يقول ذلك.(@)(@@) قال أبو محمد وروى عن [ابن - 1] طيسلة.(@)(@@) نا عبد الرحمن قال ذكره أبي عن إسحاق بن منصور عن يحيى ابن معين انه قال: أبو معشر يوسف بن يزيد البراء ضعيف.(@)(@@) نا عبد الرحمن نا علي بن الحسين [بن الجنيد - 2] [نا - 3] المقدمي محمد بن أبي بكر قال: نا أبو معشر البراء وكان ثقة.(@)(@@) نا عبد الرحمن قال سألت أبي عن أبي معشر 
ms2878	 البراء فقال: بصرى يكتب حديثه.(@)(@@)(@@)(@@) $ 987 -(@)(@@) يوسف بن يونس بن حماس روى عن عمه روى عنه مالك [ابن أنس - 2] سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 988 -(@)(@@) يوسف بن يحيى البويطى أبو يعقوب صاحب الشافعي روى عن ابن وهب ومحمد بن إدريس الشافعي روى عنه أبي رحمه الله: نا عبد الرحمن قال سئل أبي عنه فقال: صدوق.(@)(@@)(@@)(@@) ||||| باب تسمية من روى عنه العلم ممن يسمى يوسف ولا ينسبون(@)(@@)(@@)(@@) $ 989 -(@)(@@) يوسف مولى عثمان بن عفان رضي الله عنه (1164 م ك) مدينى روى عن معاوية روى عنه ابنه محمد بن يوسف سمعت أبي يقول ذلك(@)(@@)(@@)(@@) $ 990 - يوسف الالهانى أبو الضحاك الحمصى روى عن ابن عمر وأبي امامة روى (335 م 6) عنه أرطأة بن المنذر سمعت أبي يقول ذلك [قال أبو محمد - 2] .(@)(@@)(@@)(@@) $ 991 -(@)(@@) يوسف أبو خزيمة روى عن..روى عنه وكيع.(@)(@@) سألت أبي عنه فقال: شيخ [كوفى - 3] لوكيع ليس بقوى. PageV09P235(@)(@@)(@@)(@@) $ 992 -(@)(@@) يوسف روى عن رجل لم يسمه عن أبيه عن النبي صلى الله عليه وسلم قال اد الامانة إلى من ائتمنك، سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 933 -(@)(@@) يوسف المكي روى عن سعيد بن جبير سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) |||| باب تسمية من روى عنه العلم ممن يسمى يونس(@)(@@)(@@)(@@) ||||| وابتدئ اسم ابيه على الالف(@)(@@)(@@)(@@) $ 994 -(@)(@@) يونس بن ارقم الكندى البصري روى عن يزيد(@)(@@) بن ابى زياد ومطير بن أبي خالد روى عنه القواريرى وحميد بن مسعدة ومحمد بن عقبة سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) ||||| [باب الباء - 1](@)(@@)(@@)(@@) $ 995 -(@)(@@) يونس بن بكير أبو بكر الشيباني كوفى الجمال روى عن الأعمش(@)(@@) وهشام بن عروة ومحمد بن إسحاق روى عنه عبيد بن يعيش ومحمد بن عبد الله بن نمير وأبو بكر بن أبي شيبة وعقبة بن مكرم سمعت أبي يقول ذلك.(@)(@@) نا عبد الرحمن قال قرئ على العباس بن محمد الدوري قال قال يحيى ابن معين: يونس بن بكير كان صدوقا سألت ابى عن يونس بن بكير فقال: محله الصدق.(@)(@@) نا عبد الرحمن قال سئل أبو زرعة عن يونس بن بكير أي شئ ينكر 
ms2879	 عليه؟ فقال: اما في الحديث فلا اعلمه فقيل له فيونس وعبدة بن سليمان وسلمة بن الفضل في ابن (2) إسحاق أيهم احب اليك؟ فقال: ابن ادريس احبهم إلى قيل لابي زرعة من هؤلاء الثلاثة من احب اليك؟ قال: عبدة بن سليمان.(@)(@@)(@@)(@@) ||||| [باب الجيم 1 -](@)(@@)(@@)(@@) $ 996 -(@)(@@) يونس بن جبير أبو غلاب الباهلى الكلابي روى عن ابن عمر وجندب وحطان بن عبد الله صلى عليه أنس بن مالك روى عنه محمد بن PageV09P236(@)(@@) سيرين وقتادة وابن عون سمعت أبي يقول ذلك.(@)(@@) نا عبد الرحمن قال ذكره أبي عن إسحاق بن منصور عن يحيى بن معين أنه قال: يونس بن جبير ثقة.(@)(@@)(@@)(@@) ||||| [باب الحاء 1 -](@)(@@)(@@)(@@) $ 997 -(@)(@@) يونس بن الحارث الطائفي روى عن أبي بردة وأبي عون الثقفى وعمرو بن الشريد وعمرو بن شعيب وابراهيم بن ابى ميمونة ومترس رورى عنه سفيان الثوري ووكيع [بن الجراح ومعاوية - 2] بن هشام وابو أحمد الزبيري ومحمد بن بشر العبدى والفريابي وابو عاصم النبيل(@)(@@) وأبو نعيم سمعت أبي يقول ذلك.(@)(@@) نا عبد الرحمن (336 م 6) انا عبد الله ابن أحمد بن محمد بن حنبل فيما كتب إلى قال ذكر ابى يونس بن الحارث فقال: احاديثه مضطربة قال وسألته مرة اخرى فضعفه.(@)(@@) حدثنا عبد الرحمن قال قرئ على العباس بن محمد الدوري عن يحيى بن معين أنه قال: يونس ابن الحارث ضعيف لا شئ.(@)(@@) نا عبد الرحمن قال سألت ابى عن يونس ابن الحارث فقال: ليس بالقوى.(@)(@@)(@@)(@@) $ 998 -(@)(@@) يونس بن حمران روى عن خارجة بن عبد الله بن سعد روى عنه (3) ابن أبي فديك سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 999 -(@)(@@) يونس بن حبيب النحوي أبو عبد الرحمن البصري صاحب العربية روى عن زياد بن عثمان بن زياد بن أبي سفيان روى عنه قريش (4) ابن أنس سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 1000 -(@)(@@) يونس بن حبيب الاصبهاني وهو يونس بن حبيب بن عبد القاهر ابن عبد العزيز بن عمر بن قيس الماصر العجلى أبو بشر روى عن أبي داود الطيالسي وعامر بن ابراهيم وبكر بن 
ms2880	 بكار ومحمد بن كثير الصنعانى كتبت عنه باصبهان وهو ثقة.(@)(@@) نا عبد الرحمن نا أبو بكر أحمد بن عمرو بن PageV09P237(@)(@@) ابى عاصم قال سألت ابا مسعود بن الفرات قلت مثلك إذا كان ببلد لم يجب ان نكتب عن احد حتى نسألك عنه، فعمن ترى ان اكتب؟ فقال: يونس بن حبيب - بدأ به من بين جماعة محدثيهم.(@)(@@)(@@)(@@) ||||| [باب الخاء - 1](@)(@@)(@@)(@@) $ 1001 -(@)(@@) يونس بن خباب أبو حمزة ويقال أبو الجهم مولى بني أسد(@)(@@) روى عن مجاهد وطاوس ونافع بن جبير والمنهال بن عمرو وابى عبيد الله روى عنه منصور بن المعتمر (1165 ك) والثوري وشعبة ومعمر وحماد بن زيد ومهدي بن ميمون وزيد بن ابى انيسة وليث وعباد ابن عباد المهلبى وشعيب بن صفوان سمعت أبي يقول ذلك.(@)(@@) نا عبد الرحمن نا صالح بن أحمد [بن محمد - 1] بن حنبل انا علي [يعني - 1] ابن المديني قال سمعت يحيى بن سعيد يقول: ما تعجبنا الرواية عن يونس بن خباب.(@)(@@) نا عبد الرحمن أنا عبد الله بن أحمد [بن محمد - 1] بن حنبل فيما كتب إلي قال قال ابى: كان عبد الرحمن بن مهدي لا يحدث عن يونس بن خباب.(@)(@@) نا عبد الرحمن حدثنا علي بن الحسين بن الجنيد نا محمد بن المثنى قال (2) سمعت يحيى وعبد الرحمن بن مهدي يحدثان عن سفيان عن يونس بن خباب.(@)(@@) نا عبد الرحمن قال قرئ على العباس بن محمد الدوري عن يحيى بن معين أنه قال: يونس بن خباب رجل سوء.(@)(@@) نا عبد الرحمن قال ذكره أبي عن إسحاق بن منصور (337 م 6) عن يحيى بن معين أنه قال: يونس بن خباب لا شئ.(@)(@@) حدثنا عبد الرحمن قال سألت [ابى - 3] عن يونس بن خباب فقال: مضطرب الحديث، ليس بالقوى.(@)(@@)(@@)(@@) $ 1002 -(@)(@@) يونس بن ابى خلدة روى عن محمد بن مسلمة روى عنه قريش ابن حيان سمعت أبي يقول ذلك. PageV09P238(@)(@@)(@@)(@@) ||||| [باب الراء - 1](@)(@@)(@@)(@@) $ 1003 -(@)(@@) يونس بن راشد قاضى حران روى عن خصيف وعلى بن بذيمة وعون بن محمد ابن الحنفية روى عنه عثمان 