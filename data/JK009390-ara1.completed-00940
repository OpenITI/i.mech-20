ms921	 رجل من بني أسيد .(@)(@@)(@@)(@@) $ ( 8228 ) قال النبي :(@)(@@) | 30 ( إنه سيبعث بعدي بعوث فكن في بعث يأتي خراسان ، ثم كن في بلدة يقال لها مرو ، ثم اسكن مدينتها ، فإنه بناها ذو القرنين PageV03P211 ودعا لها بالبركة وقال لا يصيب أهلها سوء ) )(@)(@@) سمويه ( عق قط ) في الأفراد عن أوس بن عبد الله بن بريدة عن أخيه سهل عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 8229 ) قال النبي :(@)(@@) | 30 ( إنه سيأتيكم أقوام يطلبون العلم فرحبوا بهم وحيوهم وعلموهم ) )(@)(@@) ( ه ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8230 ) قال النبي :(@)(@@) | 30 ( إنه لم يمنعني أن أرد عليك إلا أني كنت على غير وضوء وفي لفظ : أني كرهت أن أذكر الله وأنا على غير طهر ) )(@)(@@) ( حم ه طب ) عن المهاجر بن قنفذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8231 ) قال النبي :(@)(@@) | 30 ( إنه لم يبق من الدنيا إلا مثل الذباب تمور في جوها ، فالله الله في إخوانكم من أهل القبور ، فإن أعمالكم تعرض عليهم ) )(@)(@@) الحكيم وابن لال عن النعمان بن بشير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8232 ) قال النبي :(@)(@@) | 30 ( إنه لم يكن نبي قبلي إلا حذر أمته الدجال ، هو أعور عينه اليسرى ، بعينه اليمنى ظفرة غليظة ، بين عينيه مكتوب كافر ، يخرج معه واديان ، أحدهما جنة والآخر نار ، فجنته نار ، وناره جنة ، معه ملكان من الملائكة يشبهان نبيين من الأنبياء ، أحدهما عن يمينه ، والآخر عن شماله ، وذالك فتنة الناس ، يقول : ألست بربكم أحيي وأميت فيقول أحد الملكين : كذبت ، فما يسمعه من الناس إلا صاحبه فيقول له صاحبه : صدقت ، ويسمعه الناس فيحسبون أنه صدق الدجال ، وذالك فتنة ، ثم يسير حتى يأتي المدينة ولا يؤذن له فيها ، فيقول : هاذه قرية ذاك الرجل ، ثم يسير حتى يأتي الشام ، فيهلكه الله عز وجل عند عقبة أفيق ) )(@)(@@) ( ط حم ) و البغوي ( طب كر ) عن سفينة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8233 ) قال النبي :(@)(@@) | 30 ( إنه ستكون عليكم أمراء يميتون الصلاة عن مواقيتها ، PageV03P212 فصلوا الصلاة لوقتها ، واجعلوا صلاتكم معهم سبحة ) )(@)(@@) ( حم طب ) عن شداد بن أوس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8234 ) قال النبي :(@)(@@) | 30 
ms922	 ( إنه سيكون في أمتي أناس يقرؤون القرآن لا يجاوز تراقيهم ، ينثرونه كما ينثر الدقل ، يمرقون من الدين كما يمرق السهم من الرمية ثم لا يعودون فيه حتى يعود السهم على فوقه شر قتلى تحت السماء ، طوبى لمن قتلهم أو قتلوه ) )(@)(@@) الحكيم ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8235 ) قال النبي :(@)(@@) | 30 ( إنه لم يكن نبي إلا وقد أنذر بالدجال أمته ، وإني أنذركموه أنه أعور ذو حدقة جاحظة لا تخفى كأنها نخاعة في جنب جدار ، وعينه اليسرى كأنها كوكب دري ، ومعه مثل الجنة ومثل النار ، وجنته غبراء ذات دخان ، وناره روضة خضراء ، وبين يديه رجلان ينذران أهل القرى ، كلما خرجا من قرية دخل أوائلهم ، ويسلط على رجل لا يسلط على غيره ، فيذبحه ثم يضربه بعصا ثم يقول : قم ، فيقوم ، فيقول لأصحابه : كيف ترون ؟ فيشهدون له بالشرك ، ويقول المذبوح : يا أيها الناس إن هاذا المسيح الدجال الذي أنذرناه رسول الله ما زادني هاذا فيك إلا بصيرة ، فيعود فيذبحه ، فيضربه بعصا معه ، فيقول قم ، فيقوم ، فيقول : كيف ترون ؟ فيشهدون له بالشرك ، فيقول الرجل : يا أيها الناس إن هاذا المسيح الدجال الذي أنذرناه رسول الله ، والله ما زادني هاذا فيك إلا بصيرة ، فيعود فيذبحه ، فيضربه بعصا معه فيقول قم ، فيقول لأصحابه : كيف ترون ؟ فيشهدون له بالشرك ، فيقول المذبوح : يا أيها الناس إن هاذا المسيح الذي أنذرناه رسول الله ، والله ما زادني هاذا فيك إلا بصيرة فيعود الرابعة ليذبحه ، فيضرب الله على حلقه صفيحة من نحاس ، فيريد أن يذبحه فلا يستطيع ذبحه ) )(@)(@@) عبد بن حميد ( ع كر ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8236 ) قال النبي :(@)(@@) | 30 ( إنه سيصيب أمتي في آخر الزمان بلاء شديد لا ينجو PageV03P213 منه إلا رجل عرف دين الله فجاهد عليه بلسانه وقلبه ، فذالك الذي سبقت له السوابق ، ورجل عرف دين الله فصدق به ) )(@)(@@) أبو نصر السجزي في الإبانة وأبو نعيم عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8237 ) قال النبي :(@)(@@) | 30 ( إنه من تمام إسلامكم أن تؤدوا زكاة أموالكم ) )(@)(@@) ( طب ) عن 
ms923	 عل قمة بن ناجية الخزاعي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8238 ) قال النبي :(@)(@@) | 30 ( إنه يكون بينك وبين عائشة أمر ، فإذا كان ذالك فارددها إلي مأمنها قاله لعلي ) )(@)(@@) ( بز ) عن أبي رافع رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8239 ) قال النبي :(@)(@@) | 30 ( إنه سيصيب أمتي داء الأمم : الأشر والبطر والتكاثر والتنافس في الدنيا والتباغض والتحاسد حتى يكون البغي ثم يكون الهرج ) )(@)(@@) ابن أبي الدنيا وابن النجار عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8240 ) قال النبي :(@)(@@) | 30 ( إنه قد أوحي إلي أنه من قرأ في ليلة : { فمن كان يرجو لقاء ربه } الآية ، كان له نور من عدن أبين إلى مكة حشوه الملائكة ) )(@)(@@) ابن راهويه والبزار ( ك ) والشيرازي في الألقاب وابن مردويه عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8241 ) قال النبي :(@)(@@) | 30 ( إنه يكون للوالدين على ولدهما دين ، فإذا كان يوم القيامة يتعلقان به ، فيقول : أنا ولدكما ، فيودان أو يتمنيان لو كان أكثر من ذالك ) )(@)(@@) ( طب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8242 ) قال النبي :(@)(@@) | 30 ( إنه لا وعاء إذا ملىء شر من بطن ، فإن كنتم لا بد فاعلين ، فاجعلوه ثلثا للطعام ، وثلثا للشراب ، وثلثا للريح أو النفس ) )(@)(@@) ( طب ) عن عبد الرحمان بن المرقع رضي الله عنه .(@)(@@) PageV03P214(@)(@@)(@@)(@@) $ ( 8243 ) قال النبي :(@)(@@) | 30 ( إنه مفتوح لكم وإنكم منصورون ومصيبون ، فمن أدرك ذالك منكم فليتق الله وليأمر بالمعروف ولينه عن المنكر وليصل رحمه ، ومثل الذي يعين قومه على غير الحق كمثل البعير يتردى فهو يمد بذنبه ) )(@)(@@) ( حم ك ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8244 ) قال النبي :(@)(@@) | 30 ( إنه أتاني الليلة آتيان ملكان ، فقعد أحدهما عند رأسي ، والآخر عند رجلي ، فقال أحدهما للآخر : أضرب مثله ومثل أمته كمثل قوم سفر انتهوا إلى رأس مفازة فلم يكن معهم من الزاد ما يقطعون به المفازة ولا ما يرجعون ، فبينما هم كذالك إذ أتاهم رجل مرجل في حلة حبرة ، فقال : أرأيتم إن وردت بكم رياضا معشبة ، وحياضا رواء ، فأكلوا وشربوا وسمنوا ، فقال لهم : ألم ألقكم على تلك الحال ، فقلت لكم وصدقتكم ؟ قالوا : بلى ، فقال 
ms924	 : إن بين أيديكم رياضا أعشب من هاذا ، وحياضا أروى من هاذه ، فاتبعوني ، فقالت طائفة : صدق والله لنتبعن ، وقالت طائفة : قد رضينا بهاذا نقيم عليه ) )(@)(@@) ( ك ) عن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8245 ) قال النبي :(@)(@@) | 30 ( إنه لا يتم صلاة أحدكم حتى يسبغ الوضوء كما أمره الله تعالى ، فيغسل وجهه ويديه إلى المرفقين ، ويمسح برأسه ورجليه إلى الكعبين ، ثم يكبر الله ويحمده ويمجده ويقرأ ما تيسر من القرآن مما علمه الله وأذن له فيه ، ثم يكبر فيركع فيضع كفيه على ركبتيه ، ويرفع حتى تطمئن مفاصله وتسترخي ، لا يتم صلاة أحدكم حتى يفعل ذالك ) )(@)(@@) ( د ن ه طب ك هق ) عن رفاعة بن رافع رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8246 ) قال النبي :(@)(@@) | 30 ( إنه لا ينبغي أن يعذب بالنار إلا رب النار ) )(@)(@@) ( د ) عن عبد الرحمان بن عبد الله عن أبيه .(@)(@@)(@@)(@@) $ ( 8247 ) قال النبي :(@)(@@) | 30 ( إنه سيولد لك بعدي غلام فقد نحلته اسمي وكنيتي ، PageV03P215 ولا تحل لأحد من أمتي بعده ) )(@)(@@) ابن سعد عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8248 ) قال النبي :(@)(@@) | 30 ( إنه قد دنا مني خموق من بين أظهركم وإنما أنا بشر ، فأيما رجل كنت أصبت من عرضه شيئا ، فهاذا عرضي فليقتص ، وأيما رجل كنت أصبت من ماله شيئا فهاذا مالي فليأخذ ، واعلموا أن أولاكم لي رجل كان له من ذالك شيء فأخذه أو حللني ، فلقيت ربي وأنا محلل لي ، ولا يقولن رجل إني أخاف العداوة والشحناء من رسول الله فإنهما ليستا من طبيعتي ولا من خلقي ، ومن غلبته نفسه على شيء فليستعن بي حتى أدعو له ) )(@)(@@) ابن سعد ( طب ) عن الفضل بن عباس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8249 ) قال النبي :(@)(@@) | 30 ( إنه يأتي على الناس زمان يخرجون إلى الأرياف فيصيبون فيها مطعما وملبسا ومركبا ، فيكتبون إلى أهليهم هلموا إلينا فإنكم بأرض حجاز جدوبة ، والمدينة خير لهم لو كانوا يعلمون ، لا يصبر على ءلاوائها وشدتها أحد إلا كنت له شفيعا أو شهيدا يوم القيامة ) )(@)(@@) ابن سعد عن أبي أسيد الساعدي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8250 ) قال النبي 
ms925	 :(@)(@@) | 30 ( إنه عرضت علي الجنة فرأيت فيها دالية قطوفها دانية ، فأردت أن أتناول منها شيئا ، فأوحي ألي أن أستأخر فاستأخرت ، وعرضت علي النار فيما بينكم وبيني حتى رأيت ظلي وظلكم فيها ، فأوميت إليكم إن استأخروا فاوحي إلي أن أقرهم ، فإنك أسلمت وأسلموا وهاجرت وهاجروا وجاهدت وجاهدوا ، فلم أر لك فضلا عليهم إلا بالنبوة ، فأولت ذالك ما يلقى أمتي بعدي من الفتن ) )(@)(@@) ( ك ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8251 ) قال النبي :(@)(@@) | 30 ( إنه لا يحل لي مما أفاء الله عليكم مثل هاذه الشعرات PageV03P216 إلا الخمس ثم هو مردود عليكم ) )(@)(@@) عبد الرزاق عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 8252 ) قال النبي :(@)(@@) | 30 ( إنه سيكون في التابعين رجل من قرن يقال له أويس بن عا مر يخرج به وضح فيدعو الله أن يذهبه عنه فيذهبه ، فيقول : اللهم دع لي في جسدي ما أذكر به نعمتك علي ، فيدع له منه ما يذكر به نعمته عليه ، فمن أدركه منكم فاستطاع أن يستغفر له فليستغفر له ) )(@)(@@) ( ع ) عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8253 ) قال النبي :(@)(@@) | 30 ( إنه سيأتي على الناس زمان لا يبقى فيه أحد إلا أكل الربا ، فمن لم يأكله أصابه من غباره ) )(@)(@@) ابن عبادة ابن النجار عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8254 ) قال النبي :(@)(@@) | 30 ( إنه ليس من الكبر أن تحسن راحلتك ورحلك ، ولاكن الكبر من سفه الحق وغمض الناس ) )(@)(@@) الباوردي وابن قانع ( طب ) عن ثابت بن قيس بن شماس .(@)(@@)(@@)(@@) $ ( 8255 ) قال النبي :(@)(@@) | 30 ( إنه يكره للنساء أن ينظرن إلى الرجال ، كما يكره للرجال أن ينظروا إلى النساء ) )(@)(@@) ( طب ) عن أم سلمة وضعف .(@)(@@)(@@)(@@) $ ( 8256 ) قال النبي :(@)(@@) | 30 ( إنه لا يحل لي من غنائمكم ما يزن هاذه بعد الخمس وهو مردود فيكم ) )(@)(@@) الباوردي عن عبادة بن الصامت وأبي الدرداء والحارث بن معاوية الكندي ( طب ) عن عمرو بن عبسة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8257 ) قال النبي :(@)(@@) | 30 ( إنه سيكون في آخر الزمان قوم ينزلون مكانا يقال له قزوين ، يكتب لهم فيه قتال في سبيل الله ) )(@)(@@) الخطيب في فضائل 
ms926	 قزوين والرافعي عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8258 ) قال النبي :(@)(@@) | 30 ( إنه سيكون عليكم أمراء يكذبون ويظلمون ، فمن PageV03P217 صدقهم بكذبهم ، وأعانهم على ظلمهم فليس مني ولست منه ولا يرد علي الحوض ، ومن لم يصدقهم بكذبهم ، ولم يعنهم على ظلمهم فهو مني وأنا منه ، وسيرد علي الحوض ) )(@)(@@) ( حم ) و سمويه ( طب ض ) عن حذيفة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8259 ) قال النبي :(@)(@@) | 30 ( إنه كان فيما قبلكم من الأمم رجل متعبد ، صاحب صومعة يقال له : جريج ، وكانت له أم فكانت تأتيه فتناديه ، ويشرف عليها فيكلمها ، فأتته يوما وهو في صلاته مقبل عليها ، فنادته فجعلت تناديه رافعة رأسها إليه واضعة يدها على جبهتها : أي جريج ، ثلاث مرات ، كل ذالك يقول جريج : أي رب ، أمي أو صلاتي ؟ فغضبت فقالت : اللهم لا يموتن جريج حتى ينظر في وجوه المومسات ، وبلغت بنت ملك القرية فحملت فولدت غلاما ، فقالوا لها : من فعل هاذا بك ؟ من صاحبك ؟ قالت : هو صاحب الصومعة جريج ، فما شعر حتى سمع بالفؤوس في أصل صومعته ، فجعل يسألهم : ويلكم ما لكم ؟ فلم يجيبوه ، فلما رأى ذالك أخذ الحبل فتدلى ، فجعلوا يجئون أنفه ويضربونه ويقولون : مرائي تخادع الناس بعملك ، قال : ويلكم ما لكم ؟ قالوا : بنت صاحب القرية ، بنت الملك التي أحبلتها ، قال : فما فعلت ؟ قالوا : ولدت غلاما ، قال : الغلام حي هو ؟ قالوا : نعم ، قال : فتولوا عني ، فتولوا ، فصلى ركعتين ، ثم انتهى حتى مشى إلى الشجرة فأخذ منها غصنا ، ثم أتى الغلام وهو في مهده فضربه بذالك الغصن وقال : يا طاغية من أبوك ؟ قال : أبي فلان الراعي ، قالوا : إن شئت بنينا لك صومعتك بذهب ، وإن شئت بفضة ؟ قال : أعيدوها كما كانت ) )(@)(@@) ( طب ) عن عمران بن حصين ( طس ) عن أبي حرب بن أبي الأسود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8260 ) قال النبي :(@)(@@) | 30 ( إنه لم يكن نبي كان بعده نبي إلا عاش نصف عمر الذي كان قبله ، وإن عيسى بن مريم عاش عشرين ومائة سنة ، ولا أراني إلا ذاهبا على رأس الستين ، يا بنية إنه ليس من نساء المسلمين 
ms927	 امرأة أعظم رزية منك ، فلا تكوني من أدنى امرأة صبرا ، إنك أول أهلي لحوقا بي ، وإنك سيدة نساء أهل الجنة PageV03P218 إلا ما كان من البتول مريم بنت عمران ) )(@)(@@) ( طب ) عن فاطمة الزهراء رضي الله عنها .(@)(@@)(@@)(@@) $ ( 8261 ) قال النبي :(@)(@@) | 30 ( إنه ليهون علي الموت أني رأيتك زوجتي في الجنة ) )(@)(@@) ( طب ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 8262 ) قال النبي :(@)(@@) | 30 ( إنه ليس من امرأة أطاعت وأدت حق زوجها وتذكر حسناته ، ولا تخونه في نفسها وماله إلا كان بينها وبين الشهداء درجة واحدة في الجنة ، فإن كان زوجها مؤمنا حسن الخلق فهي زوجته في الجنة ، وإلا زوجها الله من الشهداء ) )(@)(@@) ( طب ) عن ميمونة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 8263 ) قال النبي :(@)(@@) | 30 ( إنه يصب عليه من الغلام ، ويغسل من الجارية ) )(@)(@@) ( ع طب ) عن زينب بنت جحش رضي الله عنها .(@)(@@)(@@)(@@) $ ( 8264 ) قال النبي :(@)(@@) | 30 ( إنه لا يجوز للمرأة في مالها أمرا إلا باذن زوجها ) )(@)(@@) ( طب ) عن خيرة امرأة كعب بن مالك رضي الله عنها .(@)(@@)(@@)(@@) $ ( 8265 ) قال النبي :(@)(@@) | 30 ( إنه سيلحد في الحرم رجل من قريش ، لو توزن ذنوبه بذنوب الثقلين لرجحت ) )(@)(@@) ( حم ك ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 8266 ) قال النبي :(@)(@@) | 30 ( إنه كان معك ملك يرد عنك ، فلما رددت عليه بعض قوله وقع الشيطان ، فلم أكن لأقعد مع الشيطان يا أبا بكر ، ثلاث هن حق : ما من عبد ظلم مظلمة فيغضي عنها لله عز وجل إلا أعز الله بها نصره ، وما فتح رجل باب عطية يريد بها صلة إلا زاده الله بها كثرة ، وما فتح رجل باب مسألة يريد بها كثرة إلا زاداه الله بها قلة ) )(@)(@@) ( حم ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8267 ) قال النبي :(@)(@@) | 30 ( إنه سيكون اختلاف أو أمر فإن استطعت أن تكون PageV03P219 السلم فافعل ) )(@)(@@) ( عم ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8268 ) قال النبي :(@)(@@) | 30 ( إنه ستفتح لكم مشارق الأرض ومغاربها ، وإن عمالها في النار إلا من اتقى الله وأدى الأمانة ) )(@)(@@) ( حم ) عن رجل من محارب .(@)(@@)(@@)(@@) $ ( 8269 ) قال النبي :(@)(@@) | 30 ( إنه 
ms928	 لا يصلح لنا آل محمد أن نأكل ثمن أحد من ولد إسماعيل ) )(@)(@@) ( حم ) عن أعرابي .(@)(@@)(@@)(@@) $ ( 8270 ) قال النبي :(@)(@@) | 30 ( إنه يقال للولدان يوم القيامة ادخلوا الجنة فيقولون : يا رب حتى يدخل آباؤنا وأمهاتنا فيأبون ، فيقول الله عز وجل : ما لي أراهم محبنطئين ؟ أدخلوا الجنة ، فيقولون : يا رب آباؤنا ، فيقول : أدخلوا الجنة أنتم وآباؤكم ) )(@)(@@) ( حم ) عن بعض الصحابة .(@)(@@)(@@)(@@) $ ( 8271 ) قال النبي :(@)(@@) | 30 ( إنه لم يكن نبي قبلي إلا قد أعطي سبعة رفقاء نجباء وزراء ، وإني قد أعطيت أربعة عشر : حمزة وجعفر وعلي وحسن وحسين وأبو بكر وعمر وعبد الله بن مسعود وأبو ذر والمقداد وحذيفة وعمار وبلال وصهيب ) )(@)(@@) حيثمة الاطرابلسي في فضائل الصحابة ( حل ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8272 ) قال النبي :(@)(@@) | 30 ( إنه سيكون بعدي حمامات ، ولا خير في الحمامات للنساء وإن دخلته بازار ودرع وخمار ، وما من امرأة تنزع خمارها في غير بيت زوجها إلا كشفت الستر فيما بينها وبين ربها ) )(@)(@@) ( طس ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 8273 ) قال النبي :(@)(@@) | 30 ( إنه ليس لحم لهم نبت من سحت فيدخل الجنة ) )(@)(@@) ( حل ) عن حذيفة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8274 ) قال النبي :(@)(@@) | 30 ( إنه سيكون بعدي أئمة يصلون الصلاة لغير وقتها ، PageV03P220 فإذا فعلوا ذالك فصلوا الصلاة لوقتها واجعلوا صلاتكم معهم نافلة ) )(@)(@@) طس ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8275 ) قال النبي :(@)(@@) | 30 ( إنه كان معك من يرد عنك ، فلما رددت عليه قعد الشيطان ، فلم أكن لأقعد مع الشيطان يا أبا بكر ما من عبد ظلم مظلمة فيغضي عنها لله عز وجل إلا أعز الله بها نصره ) )(@)(@@) ( ق ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8276 ) قال النبي :(@)(@@) | 30 ( إنه سيأتي قوم يطلبون العلم فإذا رأيتموهم فاستوصوا بهم ) )(@)(@@) ( ط ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8277 ) قال النبي :(@)(@@) | 30 ( إنه لا يموت رجل من أصحابي ببلد من البلدان إلا كان لهم نورا ، وبعثه الله يوم القيامة سيد أهل ذالك البلد ) )(@)(@@) ابن عساكر عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8278 ) قال النبي :(@)(@@) | 30 ( إنه سيأتيكم بعدي أقوام 
ms929	 يتعلمون منكم ، فإذا جاؤوكم فعلموهم وألطفوهم ) )(@)(@@) ابن عساكر عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8279 ) قال النبي :(@)(@@) | 30 ( إنه كان فيها نفس سبعة أناسي ) )(@)(@@) البغوي ( طب ) عن رافع بن خديج قال : دخلت يوما والقدر تفور فأعجبتني شحمة فأخذتها فازدردتها فاشتكيت سنة فذكرت ذالك لرسول الله قال فذكره .(@)(@@)(@@)(@@) $ ( 8280 ) قال النبي :(@)(@@) | 30 ( إنه لم يبق من الدنيا إلا بلاء وفتنة ، فأعدوا للبلاء صبرا ) )(@)(@@) ( حم ه طب ) و نعيم بن حماد في الفتن والحاكم في الكنى وابن عساكر عن معاوية ، الحاكم في الكنى ا عن النعمان بن بشير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8281 ) قال النبي :(@)(@@) | 30 ( إنه لينادي المنادي يوم القيامة ، أين فقراء أمة محمد ؟ قوموا فتصفحوا صفوف القيامة ألا من أطعمكم في أكلة أو سقاكم في شربة ، أو كساكم في خلقا جديدا ، خذوا بيده فأدخلوه الجنة ، فلا يزال صاحب قد PageV03P221 تعلق بصاحبه وهو يقول : يا رب هاذا شبعني ، ويقول الآخر : يا رب العالمين هاذا أرواني ، فلا يبقى من فقراء أمة محمد صغير ممن فعل ذالك ولا كبير إلا أدخلهم الله الجنة ) )(@)(@@) ابن عساكر عن إبراهيم بن هدية عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8282 ) قال النبي :(@)(@@) | 30 ( إنه لو كان أجذم منقطعا يسيل من إحدى منخريه دم ، والآخر قيح ، فمصصت ذالك لم تقض حق الله الذي عليك ) )(@)(@@) ابن عساكر عن عامر الأشعري أن النبي قال للمرأة التي سألته عن زوجها فذكره .(@)(@@)(@@)(@@) $ ( 8283 ) قال النبي :(@)(@@) | 30 ( إنه بلغني أنكم تبتاعون المثقال بالنصف أو الثلثين ، وإنه لا يصلح إلا المثقال بالمثقال ، والوزن بالوزن ) )(@)(@@) الطحاوي ( طب ض ) عن رويفع بن ثابت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8284 ) قال النبي :(@)(@@) | 30 ( إنه لم يكن نبي إلا وقد وصف الدجال لأمته ، ولأصفنه صفة لم يصفها أحد كان قبلي ، إنه أعور ، والله تعالى ليس بأعور ) )(@)(@@) ( حم ) و ابن منيع وأبو نعيم في المعرفة ( ص ) عن داود بن عامر بن سعد عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 8285 ) قال النبي :(@)(@@) | 30 ( إنه لم يكن نبي قبلي إلا وقد وصف الدجال لامته ولأصفنه صفة لم 
ms930	 يصفها من كان قبلي ، إنه أعور والله ليس بأعور ، وعينه اليمني كأنها عنبة طافية ) )(@)(@@) ( حم ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 8286 ) قال النبي :(@)(@@) | 30 ( إنه لا تصلح النهبة ) )(@)(@@) ( ك ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 8287 ) قال النبي :(@)(@@) | 30 ( إنها ستكون معادن ، وسيكون فيها شر الخلق ) )(@)(@@) ( طس ) عن ابن عمر رضي الله عنهما .(@)(@@) PageV03P222(@)(@@)(@@)(@@) $ ( 8288 ) قال النبي :(@)(@@) | 30 ( إنها ستكون فتنة وفرقة ، فإذا كان كذالك فاكسر سيفك واتخذ سيفا من خشب ) )(@)(@@) ( طب ) عن أهبان بن صيفي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8289 ) قال النبي :(@)(@@) | 30 ( إنها ستكون ب| عد ي فتن أو أمور ، خير الناس فيها الغني الخفي التقي ) )(@)(@@) ( كر ) عن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8290 ) قال النبي :(@)(@@) | 30 ( إنها ستفتح الشام ، فعليكم بمدينة يقال لها دمشق ، فإنها خير مدائن الشام ، وهي معقل المسلمين من الملاحم ، وفسطاط المسلمين بأرض منها يقال لها الغوطة ، ومعقلهم من الدجال بيت المقدس ، ومعقلهم من يأجوج ومأجوج الطور ) )(@)(@@) ( كر ) عن جعفر بن محمد عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 8291 ) قال النبي :(@)(@@) | 30 ( إنها ستكون فتن وفرقة واختلاف ، فإذا كان ذالك فأت بسيفك الأحد فاضربه حتى ينقطع ، ثم اجلس في بيتك حتى تأتيك يد خاطئة ، أو منية قاضية ) )(@)(@@) ( حم ش ه طب هق ) عن محمد بن مسلمة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8292 ) قال النبي :(@)(@@) | 30 ( إنها ستكون بعدي أمراء يصلون بكم الصلاة ، فإن أتموا ركوعها وسجودها فلكم ولهم ، وإن انتقضوا منها فلكم وعليهم ) )(@)(@@) ( حم طب ) عن عقبة بن عامر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8293 ) قال النبي :(@)(@@) | 30 ( إنها كانت امرأة مسقامة فذكرت شدة الموت وضغطة القبر ، فدعوت الله أن يخفف عنها يعني ابنته زينب ) )(@)(@@) ( ك ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8294 ) قال النبي :(@)(@@) | 30 ( إنها ستكون عليكم أمراء من بعدي يعظون بالحكمة على منابر ، فإذا نزلوا اختلست منهم وقلوبهم أنتن من الجيف ، فمن صدقهم بكذبهم وأعانهم على ظلمهم فليس مني ولست منه ولا يرد على الحوض ، ومن لم يصدقهم بكذبهم ولم يعنهم على ظلمهم فهو مني وأنا منه وسيرد علي الحوض 
ms931	 ) )(@)(@@) ( طب ) عن كعب بن عجرة رضي الله عنه .(@)(@@) PageV03P223(@)(@@)(@@)(@@) $ ( 8295 ) قال النبي :(@)(@@) | 30 ( إنها ستكون فتنة ، قيل : فما المخرج منها ؟ قال : كتاب الله ، فيه نبا من قبلكم ، وخبر من بعدكم ، وحكم ما بينكم ، هو الفضل ليس بالهزل ، من تركه من جبار قصمه الله ، ومن ابتغى الهدى في غيره أضله الله ، وهو حبل الله المتين ، وهو الذكر الحكيم ، وهو الصراط المستقيم هو الذي لا تزيغ به الأهواء ، ولا تشبع منه العلماء ، ولا تلتبس به الألسن ، ولا يخلق عن الرد ، ولا تنقضي عجائبه ، هو الذي لم تنته الجن إذ سمعته عن أن قالوا : { إنا سمعنا قرآنا عجبا يهدي إلى الرشد } ، من قال لبه صدق ، ومن حكم به عدل ، ومن عمل به أجر ، ومن دعا إليه هدي إلى صراط مستقيم ) )(@)(@@) ( ت ) و محمد بن نصر في الصلاة وابن الأنباري في المصاحف ( هب ) عن علي بن محمد بن نصر ( طب ) عن معاد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8296 ) قال النبي :(@)(@@) | 30 ( إنها أبينت لي ليلة القدر ، وإني خرجت لابينها لكم ، فتلاحى رجلان فنسيتها ، فالتمسوها في التاسعة والسابعة والخامسة ) )(@)(@@) ( حب ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8297 ) قال النبي :(@)(@@) | 30 ( إنها ستكون هنات وهنات ، فمن أراد أن يفرق أمر هاذه الأمة وهم جميع فاضربوه بالسيف كائنا من كان ) )(@)(@@) ( حب ) عن عرفجة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8298 ) قال النبي :(@)(@@) | 30 ( إنها صلاة العشاء ، فلا تغلبنكم الأعراب على اسم صلاتكم ، فإنهم يعتمون عن الإبل ) )(@)(@@) عبد الرزاق عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 8299 ) قال النبي :(@)(@@) | 30 ( إنها ستفتح عليكم أرض العجم وستجدون فيها بيوتا يقال لها الحمامات ، فلا يدخلنها الرجال إلا بالأزر ، وعلى نساء أمتي إلا نفساء أو PageV03P224 سقيمة ) )(@)(@@) ( عد خط ) في المتفق و أبو القاسم البخاري في كتاب الحمام ( كر ) عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8300 ) قال النبي :(@)(@@) | 30 ( إنها لا تضر ولا تنفع ، ولاكنها تقر عين الحي ) )(@)(@@) ابن سعد عن مكحول أن النبي كان على شفير قبر ابنه فرأى فرجة في اللحد فتناول الحفار مدرة وقال فذكره .(@)(@@)(@@)(@@) $ ( 8301 ) قال 
ms932	 النبي :(@)(@@) | 30 ( إنها مشية يبغضها الله إلا في هاذا الموضع ) )(@)(@@) ( طب ) عن خالد بن سليمان بن عبد الله بن خالد بن سماك بن خرشة عن أبيه عن جده أن أبا دجانة يوم أحد أعلم بعصابة حمراء فنظر إليه رسول الله وهو يختال في مشيته بين الصفين قال فذكره .(@)(@@)(@@)(@@) $ ( 8302 ) قال النبي :(@)(@@) | 30 ( إنها ستخرج رايات من المشرق لبني العباس ، أولها مثبور وآخرها مثبور لا تنصروهم لا ينصرهم الله ، من مشى تحت راية من راياتهم أدخله الله تعالى يوم القيامة جهنم ، ألا إنهم شرار خلق الله ، وأتباعهم شرار خلق الله ، يزعمون أنهم مني إلا أني منهم بريء وهم مني براء ، علامتهم يطيلون الشعور ، ويلبسون السواد ، فلا تجالسوهم في الملأ ، ولا تبايعوهم في الأسواق ، ولا تهدوهم الطريق ، ولا تسقوهم الماء ، يتأذى بتكبيرهم أهل السماء ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8303 ) قال النبي :(@)(@@) | 30 ( إنها أيام أكل وشرب ولا صوم فيها ، يعني أيام التشريق ) )(@)(@@) ( حم ) عن إسماعيل بن محمد بن سعد بن أبي وقاص عن أبيه عن جده ( حم طب ) عن عبد الله بن حذافة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8304 ) قال النبي :(@)(@@) | 30 ( إنها أيام طعم وذكر ) )(@)(@@) ( حم ) عن ابن عمر رضي الله عنهما .(@)(@@) PageV03P225(@)(@@)(@@)(@@) $ ( 8305 ) قال النبي :(@)(@@) | 30 ( إنها ليست أيام صيام ، إنها أيام أكل وشرب وذكر ) )(@)(@@) ( ك ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8306 ) قال النبي :(@)(@@) | 30 ( إنها ستكون أمراء بعدي يصلون الصلاة لوقتها ويؤخرونها عن وقتها ، فصلوها معهم ، فإن صلوها لوقتها وصليتموها معهم فلكم ولهم ، وإن أخروها عن وقتها فصليتموها معهم فلكم وعليهم ، من فارق الجماعة مات ميتة جاهلية ، ومن نكث العهد فمات ناكثا للعهد جاء يوم القيامة لا حجة له ) )(@)(@@) عبد الرزاق ( حم ع طب ض ) عن عامر بن ربيعة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8307 ) قال النبي :(@)(@@) | 30 ( إنها لرؤيا حق إن شاء الله ، فقم مع بلال فألق عليه ما رأيت فليؤذن به فإنه أندى صوتا منك ) )(@)(@@) ( حم حب ) عن عبد الله بن زيد بن عبد ربه .(@)(@@)(@@)(@@) $ ( 8308 ) قال النبي :(@)(@@) | 30 
ms933	 ( إنها ستكون أمراء ، فمن صدقهم بكذبهم ، وأعانهم على ظلمهم ، وغشي أبوابهم ، فليس مني ولست منه ولا يرد علي الحوض ، ومن لم يصدقهم بكذبهم ولم يمنعهم عن ظلمهم ، ولم يغش أبوابهم فهو مني وسيرد علي الحوض ) )(@)(@@) الشيرازي في الألقاب عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 8309 ) قال النبي :(@)(@@) | 30 ( إنها ستكون أمراء يميتون الصلاة يخفقونها إلى شرق الموتى ، وإنها صلاة من هو شر من حمار ، وصلاة من لم يجد بدا ، فمن أدرك منكم ذالك الزمان فليصل الصلاة لوقتها ، واجعلوا صلاتكم معهم سبحة ) )(@)(@@) ( طب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8310 ) قال النبي :(@)(@@) | 30 ( إنها ستجيء أمراء تشغلهم أشياء حتى لا يصلوا PageV03P226 الصلاة لميقاتها ، فصلوا الصلاة لوقتها ، فإن أدركتموها معهم فاجعلوا صلاتكم معهم سبحة ) )(@)(@@) ( طب ) عن عبد الله بن أم حرام .(@)(@@)(@@)(@@) $ ( 8311 ) قال النبي :(@)(@@) | 30 ( إنها ستكون فتن لا يستطيع المؤمن أن يغير فيها بيد ولا بلسان ، قيل : يا رسول الله هل ينقص ذالك من إيمانهم ؟ قال : لا ، إلا كما ينقص القطر من السقاء ، قيل : ولم ذاك ؟ قال : يكرهونه بقلوبهم ) )(@)(@@) ( طب ) عن عبادة بن الصامت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8312 ) قال النبي :(@)(@@) | 30 ( إنها ستكون فتنة بين أمتي ، أنت يا أبا موسى فيها قاعد خير منك قائما ، وقائما خير منك ماشيا ) )(@)(@@) ( طب ) عن عمار وأبي موسى ا رضي الله عنهما معا .(@)(@@)(@@)(@@) $ ( 8313 ) قال النبي :(@)(@@) | 30 ( إنها من الشيطان ، وما كان الله ليسلطه علي يعني ذات الجنب ) )(@)(@@) ( ك ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 8314 ) قال النبي :(@)(@@) | 30 ( إننا من عمل الشيطان يعني النشر ) )(@)(@@) ( ه ك ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8315 ) قال النبي :(@)(@@) | 30 ( إنها كانت صلاة رغبة ورهبة سألت الله فيها ثلاثا فأعطاني اثنتين ومنعني واحدة ، سألته أن لا يرسل عليهم سنة فيدمرهم فأعطانيها ، وسألته أن لا يجعل بأسهم بينهم فزواها عني ) )(@)(@@) ( طب ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8316 ) قال النبي :(@)(@@) | 30 ( إنها ليست أضحية إنما هي شاة لحم ، إنما الأضحية بعد الصلاة ) )(@)(@@) ( طب ) عن أبي برزة بن نيار رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8317 
ms934	 ) قال النبي :(@)(@@) | 30 ( إنها لأواهة ) )(@)(@@) ( طب ) عن راشد بن سعد قال : دخل النبي منزله ومعه عمر بن الخطاب فإذا هو بزينب بنت جحح رضي الله عنها تصلي وهي في صلاتها تدعو قال فذكره .(@)(@@) PageV03P227(@)(@@)(@@)(@@) $ ( 8318 ) قال النبي :(@)(@@) | 30 ( إنها حاجب من النار لمن أحسنها يبتغي وجه الله يعني الصدقة ) )(@)(@@) ( طب ) عن ميمونة بنت سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8319 ) قال النبي :(@)(@@) | 30 ( إنها كانت تأتينا زمن خديجة وإن حسن العهد من الإيمان ) )(@)(@@) ( ك ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 8320 ) قال النبي :(@)(@@) | 30 ( إنها أمارة من أمارات بين يدي الساعة ، قد أوشك الرجل أن يخرج فلا يرجع حتى يحدثه نعلاه وسوطه ما أحدثه أهله بعده ) )(@)(@@) ( حم ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8321 ) قال النبي :(@)(@@) | 30 ( إنها ستكون بعدي أمراء يكذبون ويظلمون ، فمن دخل عليهم فصدقهم بكذبهم وأعانهم على ظلمهم ، فليس مني ولست منه وليس بوارد علي الحوض ، ومن لم يصدقهم بكذبهم ، ولم يعنهم على ظلمهم فهو مني وأنا منه وهو وارد علي الحوض ) )(@)(@@) ( حم هق ) عن كعب بن عجرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8322 ) قال النبي :(@)(@@) | 30 ( إنها ستكون أمراء يؤخرون الصلاة عن مواقيتها ، قالوا : كيف نصنع ؟ قال : صلوها لوقتها ، فإن أدركتموها معهم فاجعلوا صلاتكم معهم سبحة ) )(@)(@@) سمويه ( ص ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8323 ) قال النبي :(@)(@@) | 30 ( إنها ستكون فتنة ، قالوا : كيف نصنع يا رسول الله ؟ قال : ترجعون إلى أمركم الأول ) )(@)(@@) ( طب ) عن أبي واقد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8324 ) قال النبي :(@)(@@) | 30 ( إنها قد بلغت محلها ) )(@)(@@) ( خ م ) عن أم عطية رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8325 ) قال النبي :(@)(@@) | 30 ( إنهما ليعذبان وما يعذبان في كبير ، أما أحدهما فكان PageV03P228 لا يستنزه من البول ، وأما الآخر : فكان يمشي بالنميمة ) )(@)(@@) ( ش حم خ م د ت ن ه ) عن ابن عباس رضي الله عنهما قال : مر النبي بقبرين قال فذكره ، وفي آخره : فأخذ جريدة خضراء رطبة فشقها نصفين ، فغرز في كل قبر واحدة وقال : لعله يخفف عنهما ما لم ييبسا ) ) $ ( حم طب ) عن أبي أمامة ( طب 
ms935	 ) عن يعلى بن مرة ( طس ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 8326 ) قال النبي :(@)(@@) | 30 ( إنهما لييعذبان في غير كبير ، أما أحدهما : فكان يأكل لحوم الناس ، وأما الآخر : فكان صاحب نميمة ) )(@)(@@) ( ط ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 8327 ) قال النبي :(@)(@@) | 30 ( إني لفي صحراء ابن عشرين وأشهرا إذا بكلام فوق رأسي ، وإذا رجل يقول لرجل : أهو هو فاستقبلاني بوجوه لم أرها لخلق قط ، وأرواح لم أجدها من خلق قط ، وثياب لم أرها على أحد قط ، فأقبلا إلي يمشيان حتى أخذ كل واحد منهما بعضدي لا أجد لأحدهما مسا ، فقال أحدهما لصاحبه : أضجعه ، فأضجعاني بلا قصر ولا هصر ، فقال أحدهما لصاحبه : إفلق صدره ، فخوى أحدهما إلى صدري ففلقه فيما أرى بلا دم ولا وجع ، فقال له : أخرج الغل والحسد ، فأخرج كهيئة العلقة ثم نبذها فطرحها ، فقال له : أدخل الرأفة والرحمة ، فإذا مثل الذي أخرج شبه الفضة ، ثم هز إبهام رجلي اليمنى وقال : اغد واسلم ، فرجعت أغدو بها رقة على الصغير ورحمة للكبير ) )(@)(@@) ( عم حب ك ض ) من طريق معاذ بن محمد بن معاذ بن محمد بن أبي بن كعب عن أبيه محمد عن جده معاذ بن محمد عن أبي بن كعب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8328 ) قال النبي :(@)(@@) | 30 ( إني أجد نفس الرحمان من هاهنا ، وأشار إلى اليمن ، ولقد أوحي إلي أني مقبوض غير ملبث وتتبعوني أفنادا ، والخيل معقود في نواصيها الخير إلى يوم القيامة ، وأهلها معانون عليها ) )(@)(@@) ( طب ) عن سل مة بن نفيل رضي الله عنه .(@)(@@) PageV03P229(@)(@@)(@@)(@@) $ ( 8329 ) قال النبي :(@)(@@) | 30 ( إني لأرجو أن لا يطلع علينا نقابها يعني نقاب المدينة الوباء ) )(@)(@@) ( ط حم ) و الروياني ( طب ض ) عن أسامة بن زيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8330 ) قال النبي :(@)(@@) | 30 ( إني سألت الله ، أيما إ| نس ان من أمتي دعوت الله عليه أن يجعلها له مغفرة ) )(@)(@@) ( حم ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8331 ) قال النبي :(@)(@@) | 30 ( إني لا أخشى على قريش إلا أنفسها أشحة بجرة ، إن طال لك عمر رأيتهم يفتنون الناس حتى 
ms936	 ترى الناس بينهم كالغنم بين الحوضين ، مرة إلى هاذا ، ومرة إلى هاذا ) )(@)(@@) ( طب ) عن عمران بن حصين رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8332 ) قال النبي :(@)(@@) | 30 ( إني والله ما يسرني أن لي أحدا ذهبا كله ثم أورثته ) )(@)(@@) ( طب ) عن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8333 ) قال النبي :(@)(@@) | 30 ( إني أتغيظ عليكم وأعذركم ثم أدعو الله بيني وبينه ، اللهم ما لعنتهم أو سببتهم أو تغيظت عليهم فاجعله لهم بركة ورحمة ومغفرة وصلاة ، فإنهم أهلي وأنا لهم ناصح ) )(@)(@@) ( طب ) عن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8334 ) قال النبي :(@)(@@) | 30 ( إني لو أحرم عليكم أحرقتكم وإن تحريم الأنبياء لا تطيقه الجبال ) )(@)(@@) ( طب ) عن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8335 ) قال النبي :(@)(@@) | 30 ( إني لألج هاذه الغرفة ما لم ألجها حينئذ إلا خشية أن يكون فيها مال فأتوفى ولم أنفقه ) )(@)(@@) ( طب ض ) عن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8336 ) قال النبي :(@)(@@) | 30 ( إني أحذركم الله أن تشقوا على أمتي من بعدي ، PageV03P230 قاله لقريش ) )(@)(@@) ( طب ) عن شريح بن عبيد قال : أخبرني جبير بن نفير وكثير بن مرة وعمرو بن الأسود والمقدام بن معدي كرب وأبو أمامة رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 8337 ) قال النبي :(@)(@@) | 30 ( إني إنما بعثت بالحنيفية السمحة ، ولم أبعث بالرهبانية المبدعة ، ألا وإن أقواما ابتدعوا الرهبانية فكتبت عليهم فما رعوها حق رعايتها ، ألا فكلوا اللحم ، وائتوا النساء ، وصوموا وأفطروا ، وصلوا وناموا ، فإني بذالك أمرت ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8338 ) قال النبي :(@)(@@) | 30 ( إني لأحسبكن تخبرن بما يفعل بكن أزواجكن فلا تفعلن ، فإن الله تعالى يمقت من يفعل ذالك ، إني لا أحسب أن إحداكن إذا أتت زوجها ليكشفان عنهما اللحاف ، ينظر أحدهما إلى عورة صاحبه كأنهما حماران فلا تفعلوا ذالك ، فإن الله يمقت على ذالك ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8339 ) قال النبي :(@)(@@) | 30 ( إني لم أبعث باليهودية ولا بالنصرانية ، ولاكن بعثت بالحنيفية السمحة ، والذي نفسي بيده ، لغدوة أو روحة في سبيل الله خير من الدنيا وما فيها ، ولمقام أحدكم في الصف خير من صلاته ستين 
ms937	 سنة ) )(@)(@@) ( حم طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8340 ) قال النبي :(@)(@@) | 30 ( إني لأكتب إلى قوم فأخاف أن يزيدوا علي أو ينقصوا ، فتعلم السريانية ) )(@)(@@) عبد بن حميد عن زيد بن ثابت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8341 ) قال النبي :(@)(@@) | 30 ( إني تارك فيكم ما إن تمسكتم به لن تضلوا : كتاب الله سبب طرفه بيد الله وطرفه بأيديكم ، وعترتي أهل بيتي ، وإنهما لن يتفرقا حتى يردا علي الحوض ) )(@)(@@) الباوردي عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8342 ) قال النبي :(@)(@@) | 30 ( إني تارك فيكم كتاب الله ، هو حبل الله ، من اتبعه PageV03P231 كان على الهدى ، ومن تركه كان على الضلالة ) )(@)(@@) ( ش حب ) عن زيد بن ثابت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8343 ) قال النبي :(@)(@@) | 30 ( إني نهيتكم عن لحوم الأضاحي وادخارها بعد ثلاثة أيام ، فكلوا وادخروا فقد جاء الله بالسعة ، ونهيتكم عن أشياء من الأشربة والأنبذة فاشربوا وكل مسكر حرام ، ونهيتكم عن زيارة القبور فزورها فإن فيها عبرة ، ولا تقولوا هجرا ) )(@)(@@) ( حم ) و عبد بن حميد ( ق ض ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8344 ) قال النبي :(@)(@@) | 30 ( إني مكاثر بكم الأمم فلا ترجعوا بعدي كفارا يضرب بعضكم رقاب بعض ) )(@)(@@) ( حم ) عن الصنابحي .(@)(@@)(@@)(@@) $ ( 8345 ) قال النبي :(@)(@@) | 30 ( إني أوشك أن أدعى فاجيب ، وإني تارك فيكم الثقلين : كتاب الله وعترتي ، كتاب الله حبل ممدود من السماء إلى الأرض ، وعترتي أهل بيتي ، وإن اللطيف الخبير خبرني أنهما لم يتفرقا حتى يردا علي الحوض ، فانظروا كيف تخلفوني فيهما ) )(@)(@@) ( ش ) و ابن سعد ( حم ع ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8346 ) قال النبي :(@)(@@) | 30 ( إني تارك فيكم ما إن تمسكتم به بعدي لن تضلوا : كتاب الله وعترتي أهل بيتي ، وإنهما لن يتفرقا حتى يردا علي الحوض ) )(@)(@@) عبد بن حميد وابن الأنباري عن زيد بن ثابت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8347 ) قال النبي :(@)(@@) | 30 ( إني لأول الناس تنشق الأرض عن جمجمتي يوم القيامة ولا فخر ، وأعطى لواء الحمد ولا فخر ، وأنا سيد الناس يوم القيامة ولا PageV03P232 فخر ، وآتي باب الجنة فإذا الجبار 
ms938	 عز وجل مستقبلي فأسجد له فيقول : ارفع رأسك فإذا بقي من أمتي في النار ، قال من في النار : ما أغنى عنكم أنكم كنتم تعبدون الله ولا تشركوا به شيئا ، فيقول الجبار : فبعزتي لأعتقنهم من النار ، فيخرجون وقد امتحشوا ، ويدخلون في نهر الحياة ، فينبتون فيه كما تنبت الحبة في غثاء السيل ، ويكتب بين أعينهم : هاؤلاء عتقاء الله عز وجل ، فيقول أهل الجنة : هاؤلاء الجهنميون ، فيقول الجبار : بل هاؤلاء عتقاء الجبار ) )(@)(@@) ( حم ن ) و الدارمي وابن خزيمة ( ض ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8348 ) قال النبي :(@)(@@) | 30 ( إني لقائم أنتظر أمتي تعبر الصراط ، إذ جاءني عيسى فقال : هاذه الأنبياء قد جاءتك يا محمد يسألون ويدعون الله أن يفرق بين جميع الأمم إلى حيث شاء الله لغم ما هم فيه ، والخلق ملجمون في العرق ، فأما المؤمن فهو كالزخمة ، وأما الكافر فيغشاه الموت ، فقال : انتظر حتى أرجع إليك ، فذهب نبي الله فقام تحت العرش ، فلقي ما لم يلق ملك مصطفى ولا نبي مرسل ، فأوحى الله إلى جبريل أن اذهب إلى محمد فقل له : ارفع رأسك ، سل تعطه ، واشفع تشفع ، فشفعت في أمتي أن أخرج من كل تسعة وتسعين إنسانا واحدا ، فما زلت أتردد إلى ربي عز وجل ، فلا أقوم منه مقاما إلا شفعت ، حتى أعطاني الله من ذالك أن قال : يا محمد أدخل من أمتك من خلق الله عز وجل من شهد أن لا إلاه إلا الله يوما واحدا مخلصا ومات على ذالك ) )(@)(@@) ( حم ) و ابن خزيمة ( ض ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8349 ) قال النبي :(@)(@@) | 30 ( إني لأعلم كلمة لو قالها هاذا الغضبان لأذهبت الذي به من الغضب ، اللهم إني أعوذ بك من الشيطان الرجيم ) )(@)(@@) ( حم طب ) عن معاذ PageV03P233 ( ك ) عن سليمان بن صرد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8350 ) قال النبي :(@)(@@) | 30 ( إني إذا حلفت فرأيت غير ذالك أفضل ، كفرت عن يميني وأتيت الذي هو أفضل ) )(@)(@@) ( طب ك هق ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8351 ) قال النبي :(@)(@@) | 30 ( إني لا أدري ما قدر 
ms939	 بقائي فيكم ، فاقتدوا باللذين من بعدي أبي بكر وعمر وتمسكوا بهدي عمار وما حدثكم ابن مسعود فصدقوه ) )(@)(@@) ( حم ع ت ) حسن ( ه حب ) عن حذيفة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8352 ) قال النبي :(@)(@@) | 30 ( إني رضيت لامتي ما رضي لهم ابن أم عبد ) )(@)(@@) ( طب هق ) و ابن عساكر عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8353 ) قال النبي :(@)(@@) | 30 ( إني لكم فرط بين أيديكم وأنا شهيد عليكم ، وإن موعدكم الحوض ، وإني والله لأنظر إلى حوضي الآن ، وإني قد أعطيت مفاتيح خزائن الأرض ، وإني والله ما أخاف عليكم أن تشركوا بعدي ، ولاكن أخاف عليكم الدنيا أن تنافسوا فيها ) )(@)(@@) ( حم خ م ) عن عقبة بن عامر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8354 ) قال النبي :(@)(@@) | 30 ( إني لكم فرط وإنكم واردون على الحوض ، عرضه ما بين صنعاء إلى بصرى ، فيه عدد الكواكب من قدحان الذهب والفضة ، فانظروا كيف تخلفوني في الثقلين ، قيل : وما الثقلان يا رسول الله ؟ قال : الأكبر كتاب الله ، سبب طرفه بيد الله ، وطرفه بأيديكم فتمسكوا به ، لن تزلوا ولا تضلوا ، والأصغر عترتي ، وإنهما لن يتفرقا حتى يردا علي الحوض ، وسألت لهما ذاك ربي فلا تقدموهما فتهلكوا ولا تعلموهما فإنهما أعلم منكم ) )(@)(@@) ( طب ) عن زيد بن أرقم رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8355 ) قال النبي :(@)(@@) | 30 ( إني على الحوض حتى أنظر من يرد علي منكم ، PageV03P234 وسيؤخذ أناس دوني فأقول : يا رب مني ومن أمتي ، فيقال : هل شعرت ما عملوا بعدك ؟ والله ما برحوا بعدك يرجعون على أعقابهم ) )(@)(@@) ( خ م ) عن أسماء بنت أبي بكر ( حم م ) عن عائشة رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 8356 ) قال النبي :(@)(@@) | 30 ( إني كنت أريت ليلة القدر ثم نسيتها ، وهي في العشر الأواخر وهي ليلة صافية بلجة ، لا حارة ولا باردة ) )(@)(@@) ابن أبي عاصم وابن خزيمة ( حب ض ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8357 ) قال النبي :(@)(@@) | 30 ( إني أخاف عليكم ثلاثا وهن كائنات : زلة عالم ، وجدال منافق بالقرآن ، ودنيا تفتح عليكم ) )(@)(@@) ( طب ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8358 ) قال النبي :(@)(@@) | 30 ( إني لأخاف على أمتي 
ms940	 من بعدي من ثلاثة : زلة العالم ، ومن حكم جائر ، ومن هوى متبع ) )(@)(@@) القاضي أبو الحسن عبد الجبار بن أحمد في أماليه عن كثير بن عبد الله بن عمرو بن عوف المزني عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 8359 ) قال النبي :(@)(@@) | 30 ( إني لأعرف أقواما يكونون في آخر الزمان قد اختلط الإيمان بلحومهم ودمائهم يقاتلون في بلدة يقال لها قزوين ، تشتاق إليهم الجنة وتحن كما تحن الناقة إلى ولدها ) )(@)(@@) أبو الشيخ في كتاب الأمصار والبلدان والحسن بن أحمد العطار في فضائل قزوين والديلمي والرافعي عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8360 ) قال النبي :(@)(@@) | 30 ( إني لسيد الناس يوم القيامة غير فخر ولا رياء ، وما من الناس من أحد إلا وهو تحت لوائي يوم القيامة ينتظر الفرج ، وإن بيدي لواء الحمد فأمشي ويمشي الناس معه ، حتى آتي باب الجنة فأستفتح ، فيقال : من هاذا ؟ فأقول : محمد ، فيقال : مرحبا بمحمد ، فإذا رأيت ربي عز وجل خررت له ساجدا شكرا له ، فيقال : إرفع رأسك ، وقل تطع واشفع تشفع ، فيخرج من النار من قد احترق برحمة الله وشفاعتي ) )(@)(@@) ( ك ) و ابن عساكر عن عبادة بن الصامت رضي الله عنه .(@)(@@) PageV03P235(@)(@@)(@@)(@@) $ ( 8361 ) قال النبي :(@)(@@) | 30 ( إني كنت أحدثه ويحدثني ويلهيني عن البكاء ، وأسمع وجبته يسجد تحت العرش ) )(@)(@@) ( ق ) في الدلائل ، و أبو عثمان الصابوني في المائتين والخطيب وابن عساكر عن العباس بن عبد المطلب قال : قلت : يا رسول الله دعاني إلى الدخول في دينك أمارة لنبوتك ، رأيتك في المهد تناغي القمر وتشير إليه باصبعك ، فحيث أشرت إليه مال ، قال : فذكره .(@)(@@)(@@)(@@) $ ( 8362 ) قال النبي :(@)(@@) | 30 ( إني لأرجو لهن من بعدي الصديقين يعني لأزواجه ومن تعدون الصديقين هم المتصدقون ) )(@)(@@) ( طب ) عن المقداد بن الأسود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 8363 ) قال النبي :(@)(@@) | 30 ( إني حين ضربت الضربة الأولى رفعت لي مدائن كسرى وما حولها ومدائن كثيرة حتى رأيتها بعيني ، ثم ضربت الضربة الثانية فرفعت لي مدائن قيصر وما حولها حتى رأيتها بعيني ، ثم ضربت الثالثة فرفعت لي مدائن الحبشة وما حولها من القرى حتى رأيتها 