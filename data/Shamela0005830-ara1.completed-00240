ms221	 - (@)(@@) عمرو بن أبي عمرو واسم أبي عمرو ميسرة مولى المطلب بن عبد الله بن حنطب مكنى أبا عثمان يروي عن المطلب قال يحيى لا يحتج بحديثه وقال مرة ليس بالقوي وليس بحجة وقال أحمد ما به بأس عمرو بن أبي عمرو واسمه ميسرة أبو عثمان مولى المطلب بن عبد الله بن حنطب المخزومي قال يحيى ليس بالقوي كان مالك يستضعفه وقال يحيى مرة ليس بحجة وقال مرة ليس به بأس وكذلك قال أحمد(@)(@@)(@@)(@@) $ 2580 - (@)(@@) عمرو بن عون بن تميم الأنصاري قال أبو حاتم الرازي مجهول(@)(@@)(@@)(@@) $ 2581 - (@)(@@) عمرو بن فائد أبو علي الأسواري البصري يروي عن مطر الوراق قال ابن المديني يضع الحديث وقال الدارقطني متروك(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 2582 - (@)(@@) عمرو بن القاسم بن حبيب أبو علي التمار الكوفي قال ابن عدي ضعيف(@)(@@)(@@)(@@) $ 2583 - (@)(@@) عمرو بن قيس بن يسير بن عمرو الكوفي الكندي قال يحيى لا شيء وقال مرة ليس بثقة وقال ابن عقدة ثقة وقال المصتف وقلت جملة من يأتي في الحديث (عمرو بن قيس) خمسة وليس فيهم من طعن فيه غير هذا(@)(@@)(@@)(@@) $ 2584 - (@)(@@) عمرو بن كعب المعافري عن علي قال الرازي مجهول(@)(@@)(@@)(@@) $ 2585 - (@)(@@) عمرو بن مالك النكري البصري قال ابن عدي منكر الحديث عن الثقات ويسرق الحديث ضعفه أبو يعلى الموصلي(@)(@@)(@@)(@@) $ 2586 - (@)(@@) عمرو بن مالك بن عثمان الواسطي البصري قال أبو حاتم لم يكن بصدوق(@)(@@)(@@)(@@) $ 2587 - (@)(@@) عمرو بن مجمع بن سليمان أبو المندر الكندي السكوني حدث عن هشام بن عروة قال يحيى ليس حديثه بشيء وقال الدارقطني ضعيف وقال ابن عدي عامة ما يرويه لا يتابع عليه إما إسنادا وإما متنا(@)(@@)(@@)(@@) $ 2588 - (@)(@@) عمرو بن محمد عن سعيد بن جبير قال أبو حاتم الرازي مجهول(@)(@@)(@@)(@@) $ 2589 - (@)(@@) عمرو بن محمد الأعسم يروي عن سليمان بن أرقم قال ابن حبان يروي عن الثقات المناكير ويضع أسامي المحدثين لا يجوز الاحتجاج به بحال وقال الدارقطني منكر الحديث(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 2590 - (@)(@@) عمرو بن مرزوق كان يحيى بن سعيد لا يرضاه في الحديث وقال الأزدي تكلموا في حديثه(@)(@@)(@@)(@@) $ 2591 - (@)(@@) عمرو 
ms222	 بن مسلم الجندي عن طاوس ضعفه احمد ويحيى قال المصنف قلت وثم ثلاثة أخر كل منهم اسمه عمرو بن مسلم لم يطعن فيهم(@)(@@)(@@)(@@) $ 2592 - (@)(@@) عمرو بن منصور الشرقي عن الشعبي قال أبو حاتم الرازي ضعيف الحديث(@)(@@)(@@)(@@) $ 2593 - (@)(@@) عمرو بن مهران الخصاف السرقطي روى عن القاسم بن زكريا الصيقل قال الأزدي ضعيف(@)(@@)(@@)(@@) $ 2594 - (@)(@@) عمرو بن نصر قال أبو حاتم الرازي مجهول(@)(@@)(@@)(@@) $ 2595 - (@)(@@) عمرو بن النعمان البصري قال ابن عدي ليس بالقوي في الحديث(@)(@@)(@@)(@@) $ 2596 - (@)(@@) عمرو بن هاشم أبو مالك الجنبي الكوفي يروي عن هشام بن عروة قال أحمد صدوق ولم يكن صاحب حديث وقال ابن حبان يقلب الأسانيد ويروي عن الثقات ما لا يشبه حديث الأثبات لا يجوز الاحتجاج بخبره(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 2597 - (@)(@@) عمرو بن هرم قال يحيى القطان ضعيف(@)(@@)(@@)(@@) $ 2598 - (@)(@@) عمرو بن واقد الدمشقي النصري مولى قريش يروي عن يونس بن ميسرة قال البخاري منكر الحديث وقال أبو مسهر ودحيم ليس بشيء وقال النسائي والدارقطني متروك وقال ابن حبان يقلب الأسانيد ويروي المناكير عن المشاهير فاستحق الترك(@)(@@)(@@)(@@) $ 2599 - (@)(@@) عمرو بن أبي الوليد قال أبو حاتم الرازي مجهول(@)(@@)(@@)(@@) $ 2600 - (@)(@@) عمرو بن وهب بن عثمان القرشي قال أبو حاتم الرازي مضطرب الحديث(@)(@@)(@@)(@@) $ 2601 - (@)(@@) عمرو بن يحيى بن عمرو بن سلمة قال يحيى ليس حديثه بشيء وقال مرة لم يكن بمرضي(@)(@@)(@@)(@@) $ 2602 - (@)(@@) عمرو بن يزيد أبو بردة التميمي عن علقمة بن مرثد قال يحيى ليس حديثه بشيء وقال الرازي منكر الحديث وقال الدارقطني ضعيف(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 2603 - (@)(@@) عمرو بن يوسف مولى عثمان(@)(@@)(@@)(@@) $ 2604 - (@)(@@) وعمرو بن أبي يوسف عن معاوية قال الرازي مجهولان(@)(@@)(@@)(@@) || من اسمه ((عمير))(@)(@@)(@@)(@@) $ 2605 - (@)(@@) عمير بن إسحاق أبو محمد البصري يروي ابن عون قال يحيى بن سعيد لم يكن لا يساوي حديثه شيئا لكنه يكتب حديثه(@)(@@)(@@)(@@) $ 2606 - (@)(@@) عمير بن سعيد يروي عن علي عليه السلام قال يحيى بن سعيد لم يكن ممن يعتمد عليه(@)(@@)(@@)(@@) $ 2607 - (@)(@@) عمير بن سويد قال ابن حبان يروي عن انس بن مالك ما ليس من حديث الثقات لا يجوز الاحتجاج به 
ms223	 وقال الدارقطني إنما هو (عمر بن سويد)(@)(@@)(@@)(@@) $ 2608 - (@)(@@) عمير بن عبد الحميد الحنفي قال يحيى بن معين ضعيف(@)(@@)(@@)(@@) $ 2609 - (@)(@@) عمير بن عمران بن الحنفي البصري يروي عن حفص بن غياث قال ابن عدي حدث بالبواطيل عن الثقات الضعف على روايته بين(@)(@@) PageV00P000(@)(@@)(@@)(@@) || [من اسمه ((عميرة)) ](@)(@@)(@@)(@@) $ 2610 - (@)(@@) هعميرة بن كوهان عن علي قال الرازي مجهول(@)(@@)(@@)(@@) || من اسمه ((عنبسة))(@)(@@)(@@)(@@) $ 2611 - (@)(@@) عنبسة بن الأزهر أبو يحيى الشيباني قال الرازي يكتب حديثه ولا يحتج به(@)(@@)(@@)(@@) $ 2612 - (@)(@@) عنبسة بن أبي رائطة الغنوي قال علي بن المديني هو ضعيف(@)(@@)(@@)(@@) $ 2613 - (@)(@@) عنبسة بن زيد بن أسلم قال الرازي ضعيف(@)(@@)(@@)(@@) $ 2614 - (@)(@@) عنبسه بن سعيد أخو أبي الربيع السمان يروي عن عمرو بن ميمون قال يحيى والدارقطني ضعيف وقال عمرو بن علي متروك وقال أبو حاتم الرازي ضعيف الحديث يأتي بالطامات وقال ابن حبان منكر الحديث لا يجوز الاحتجاج بأفراده(@)(@@)(@@)(@@) $ 2615 - (@)(@@) عنبسة بن سعيد البصري عن الزهري قال الرازي ضعيف الحديث(@)(@@)(@@)(@@) $ 2616 - (@)(@@) عنبسة بن سعيد بن غنم الكلابي يروي عن مكحول قال أبو زرعة أحاديثه منكرة(@)(@@)(@@)(@@) $ 2617 - (@)(@@) عنبسة بن عبد الرحمن بن عنبسة بن سعيد بن العاص القرشي بصري يروي عن الحسن ومحمد بن راذان قال يحيى ليس بشيء وقال النسائي متروك وقال البخاري والعقيلي تركوه وقال أبو حاتم الرازي كان يضع الحديث وقال ابن حبان هو صاحب أشياء موضوعة لا يحل الاحتجاج به وقال الدارقطني ضعيف وقال الأزدي كذاب(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 2618 - (@)(@@) عنبسة بن أبي عمرو قال أبو حاتم الرازي هو مجهول(@)(@@)(@@)(@@) $ 2619 - (@)(@@) عنبسة بن مهران الحداد البصري قال الرازي منكر الحديث وقال ابن حبان يروي عن الزهري ما ليس من حديثه(@)(@@)(@@)(@@) $ 2620 - (@)(@@) عنبسة بن هبيرة الطائي عن عكرمة قال الرازي مجهول(@)(@@)(@@)(@@) || من اسمه ((العوام))(@)(@@)(@@)(@@) $ 2621 - (@)(@@) العوام بن جويرية يروي عن الحسن قال ابن حبان كان ممن يروي الموضوعات عن الثقات على صلاح فيه كان يهم ويأتي بالشيء على التوهم لا التعمد فلا يحتج به(@)(@@)(@@)(@@) $ 2622 - (@)(@@) العوام بن حمزة المازني قال يحيى ليس حديثه بشيء قال أحمد له احاديث مناكير(@)(@@)(@@)(@@) $ 2623 
ms224	 - (@)(@@) العوام بن سليمان المزني قال الرازي مجهول(@)(@@)(@@)(@@) $ 2624 - (@)(@@) والعوام بن عبد الغفار يروي عن التابعين قال الأزدي متروك الحديث(@)(@@)(@@)(@@) $ 2625 - (@)(@@) العوام بن أبي العوام(@)(@@)(@@)(@@) $ 2626 - (@)(@@) العوام بن المقطع قال الرازي مجهولان(@)(@@) PageV00P000(@)(@@)(@@)(@@) || [من اسمه ((عوبد)) ](@)(@@)(@@)(@@) $ 2627 - (@)(@@) عوبد بن أبي عمران الجوني بصري يروي عن أبيه واسم أبي عمران عبد الملك بن حبيب قال يحيى ليس بشيء وقال البخاري والرازي منكر الحديث وقال النسائي متروك الحديث وقال ابن حبان انفرد عن أبيه بما ليس من حديثه توهما فبطل الاحتجاج به(@)(@@)(@@)(@@) || من اسمه ((عون))(@)(@@)(@@)(@@) $ 2628 - (@)(@@) عون ابو محمد البصري عن أبي موسى قال الرازي مجهول(@)(@@)(@@)(@@) $ 2629 - (@)(@@) عون بن عمارة البصري قال الرازي منكر الحديث ضعيف الحديث(@)(@@)(@@)(@@) $ 2630 - (@)(@@) عون بن عمرو القيسي ويقال فيه عون أبو عمرو أخو رياح الزاهد قال يحيى لا شيء(@)(@@)(@@)(@@) || من اسمه ((عياض))(@)(@@)(@@)(@@) $ 2631 - (@)(@@) عياض بن عبد الله القرشي الفهري قال الرازي ليس بقوي(@)(@@)(@@)(@@) $ 2632 - (@)(@@) عياض بن زيد الكلابي قال أبو حاتم الرازي مجهول(@)(@@)(@@)(@@) || من اسمه ((عيسى))(@)(@@)(@@)(@@) $ 2633 - (@)(@@) عيسى الملائي يروي عن علي بن الحسين قال الأزدي تركوه(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 2634 - (@)(@@) عيسى بن إبراهيم العبدي الكوفي عن أبي إسحاق قال ابن عدي ليس بمعروف(@)(@@)(@@)(@@) $ 2635 - (@)(@@) عيسى بن إبراهيم الهاشمي قال يحيى ليس بشيء وقال الرازي متروك الحديث وقال البخاري والنسائي منكر الحديث وقال ابن حبان يروي المناكير عن جعفر بن البرقان لا يجوز الاحتجاج به إذا انفرد(@)(@@)(@@)(@@) $ 2636 - (@)(@@) عيسى بن الأشعث قال أبو حاتم الرازي مجهول(@)(@@)(@@)(@@) $ 2637 - (@)(@@) عيسى بن جارية يروي عن يعقوب القمي قال يحيى عنده احاديث مناكير وقال النسائي متروك الحديث(@)(@@)(@@)(@@) $ 2638 - (@)(@@) عيسى بن خشنام أبو موسى المدائيني يعرف بأترجة حدث عن أحمد بن سلمة المدائني حديثا منكرا قاله أبو بكر الخطيب(@)(@@)(@@)(@@) $ 2639 - (@)(@@) عيسى بن أبي رزين الثمالي واسم أبي رزين راشد قال أبو زرعة مجهول(@)(@@)(@@)(@@) $ 2640 - (@)(@@) عيسى بن بن سعيد أبو عمار قال أبو حاتم الرازي مجهول(@)(@@)(@@)(@@) $ 2641 - (@)(@@) عيسى بن سليمان بن دينار أبو طيبة الدارمي الجرجاني سمع جعفر بن محمد قال يحيى ضعيف(@)(@@)(@@)(@@) $ 2642 - (@)(@@) عيسى بن سنان الكوفي 
ms225	 روى عنه ليث قال يحيى ضعيف الحديث(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 2643 - (@)(@@) عيسى بن سوادة بن الجعد النخعي قال الرازي منكر الحديث ضعيف(@)(@@)(@@)(@@) $ 2644 - (@)(@@) عيسى بن شعيب البصري يروي عن مطر الوراق قال ابن حبان فحش خطؤه فاستحق الترك(@)(@@)(@@)(@@) $ 2645 - (@)(@@) عيسى بن صدقة أبو محرز ويقال ابن عباد بن صدقة يروي عن جميد وعبد الحميد بن امية عن انس وأبو الوليد الطيالسي يقول صدقة بن أمية عن أنس قال أبو الوليد والرازي هو ضعيف وقال ابن حبان منكر الحديث جدا لا يجوز الاحتجاج بما يروه(@)(@@)(@@)(@@) $ 2646 - (@)(@@) عيسى بن طهمان أبو ليث الكوفي قال ابن حبان يتفرد بالمناكير عن أنس لا يجوز الاحتجاج بخبره(@)(@@)(@@)(@@) $ 2647 - (@)(@@) عيسى بن عبد الرحمن الأشعري يروي عن علقمة بن مرثد قال الأزدي ضعيف(@)(@@)(@@)(@@) $ 2648 - (@)(@@) عيسى بن عبد الرحمن بن الحكم بن النعمان بن بشير قال الأزدي منكر الحديث مجهول(@)(@@)(@@)(@@) $ 2649 - (@)(@@) عيسى بن عبد الرحمن بن فروة أبو عباد الرزقي المديني يروي عن الزهري قال البخاري منكر الحديث وقال أبو حاتم الرازي ضعيف شبيه بالمتروك وقال النسائي متروك الحديث وقال ابن حبان يروي المناكير عن المشاهير فاستحق الترك(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 2650 - (@)(@@) عيسى بن عبد الله بن سليمان القرشي العسقلاني يروي عن الوليد بن مسلم قال ابن عدي ضعيف يسرق الحديث(@)(@@)(@@)(@@) $ 2651 - (@)(@@) عيسى بن عبد الله بن محمد بن عمر بن علي بن أبي طالب كوفي قال ابن حبان يروي عن أبيه عن آبائه موضوعة وقال يهم ويخطئ فبطل الأحتجاج به وقال الدارقطني عيسى هذا يقال له (مبارك) وهو متروك الحديث(@)(@@)(@@)(@@) $ 2652 - (@)(@@) عيسى بن عون بن عمرو قال أبو حاتم الرازي مجهول(@)(@@)(@@)(@@) $ 2653 - (@)(@@) عيسى بن أبي عيسى واسم أبي عيسى ما هان أبو جعفر الرازي يروي عن الشعبي وعطاء ونافع قال علي بن المديني كان ثقة وقال مرة كان يخلط وقال يحيى مرة هو ثقة وقال مرة يكتب حديثه إلا [أنه] يخطيء وقال أحمد ليس بقوي في الحديث وقال مرة صالح الحديث وقال الفلاس سيء الحفظ وقال أبو زرعة يهم كثيرا وقال ابن حبان 
ms226	 يتفرد بالمناكير عن المشاهير(@)(@@)(@@)(@@) $ 2654 - (@)(@@) عيسى بن أبي عيسى الحناط ويقال الخياط والخياط كان في أوله خياطا ثم صار حناطا ثم صار يبيع الخبط واسم أبي عيسى ميسرة مدني(@)(@@) PageV00P000(@)(@@) يروي عن نافع والشعبي وأبي الزناد وقد فرق بينهما البخاري فجعلهما اثنين فقال (عيسى بن ميسرة) وقال بعده (عيسى بن أبي عيسى) وهما واحد قال الدارقطني عيسى بن أبي عيسى بن ميسرة وكذلك قال النسائي وقال هو متروك قال أحمد لا يساوي شيئا وقال يحيى ليس بشيء وقال الدارقطني ضعيف وقال ابن حبان كان سيء الحفظ والفهم فاستحق الترك قال المصنف وجملة من يأتي في الحديث (عيسى بن أبي عيسى) عشرة ما عرفنا أنه طعن إلا في هذا(@)(@@)(@@)(@@) $ 2655 - (@)(@@) عيسى بن قرطاس الكوفي يروي عن عكرمة قال يحيى ليس بشيء وقال مرة ليس بثقة وقال مرة لا تحل الرواية عنه وقال النسائي متروك الحديث وقال الدارقطني ضعيف وقال ابن حبان يروي الموضوعات عن الثقات لا يحل الاحتجاج به(@)(@@)(@@)(@@) $ 2656 - (@)(@@) عيسى بن محمد القرشي عن ابن أبي ملكية قال الرازي ليس بالقوي(@)(@@)(@@)(@@) $ 2657 - (@)(@@) عيسى بن مسلم الصفار قال الخطيب يعرف ب ((الأحمر)) حدث عن مالك وحماد بن زيد وإسماعيل بن عياش أحاديث منكرة روى عن ابنه مسلم ومطير الكوفي(@)(@@)(@@)(@@) $ 2658 - (@)(@@) عيسى بن مسلم الطهوي أبو داود عن شريك قال أبو حاتم الرازي ليس بالقوي وقال أبو زرعة لين(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 2659 - (@)(@@) عيسى بن المسيب البجلي الكوفي يروي عن الشعبي قال يحيى والنسائي والدارقطني ضعيف وقال يحيى مرة ليس بشيء وقال الرازي وأبو زرعة ليس بالقوي وقال ابن حبان يقلب الأخبار ولا يعلم ويخطيء ولا يفهم حتى خرج عن حد الاحتجاج(@)(@@)(@@)(@@) $ 2660 - (@)(@@) عيسى بن معمر مولى جابر يروي عنه عطاف بن خالد قال الأزدي ضعيف الحديث(@)(@@)(@@)(@@) $ 2661 - (@)(@@) عيسى بن مهران أبو موسى المستعطف روى عنه ابن جرير الطبري قال ابن عدي حدث بأحاديث موضوعة مناكير وهو محترف في الرفض وقال الدارقطني هو رجل سوء وله مذهب سوء يشير إلى الرفض وقال أبو حاتم الرازي عيسى 
ms227	 بن مهران كذاب(@)(@@)(@@)(@@) $ 2662 - (@)(@@) عيسى بن موسى غنجار قال الدارقطني لا شيء(@)(@@)(@@)(@@) $ 2663 - (@)(@@) عيسى بن موسى أبو محمد قال الرازي ضعيف(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 2664 - (@)(@@) عيسى بن ميمون أبو سلمة الخواص وقيل أبو يحيى مديني ويروي عن القاسم بن محمد والسدي قال يحيى ليس حديثه بشيء وقال البخاري منكر الحديث وقال عمرو بن علي والنسائي والأزدي متروك الحديث وقال الدراقطني ضعيف وقال ابن حبان يروي العجائب(@)(@@)(@@)(@@) $ 2665 - (@)(@@) عيسى بن ميمون القرشي المديني مولى القاسم بن محمد روى عن القاسم بن محمد والقرظي قال البخاري منكر الحديث وقال ابن حبان منكر الحديث لا يحتج بروايته قال ابن مهدي استعديت عليه فقلت ما هذه الأحاديث التي تحدث عن القاسم عن عائشة فقال لا أعود قال المصنف وربما ظن ظان أنه والذي قبله واحد وقد ذكرهما أبو حاتم ابن حبان اثنين وقال المصنف قلت وثم آخران يقال لهما عيسى بن ميمون لم يقدح فيهما(@)(@@)(@@)(@@) $ 2666 - (@)(@@) عيسى بن يزداد قال يحيى لا يعرف وقال أبو حاتم الرازي هو وأبوه مجهولان(@)(@@)(@@)(@@) $ 2667 - (@)(@@) عيسى بن يزيد بن بكر بن داب أبو الوليد يروي عن هشام بن عروة قال البخاري والرازي منكر الحديث وقال خالد الأحمر يضع الحديث(@)(@@) PageV00P000(@)(@@)(@@)(@@) | حرف الغين(@)(@@)(@@)(@@) $ 2668 - (@)(@@) غازي بن عامر يروي عن عبد الرحمن بن مغرى قال أبو الفتح الأزدي هو معروف بالكذب(@)(@@)(@@)(@@) $ 2669 - (@)(@@) غاضرة بن عروة البصري قال علي المديني هو مجهول(@)(@@)(@@)(@@) $ 2670 - (@)(@@) غالب بن حبيب اليشكري يكنى أبا غالب يروي عن العوام بن حوشب قال الرازي مجهول وقال ابن حبان كان يروي المناكير عن المشاهير فكثر ذلك في روايته فبطل الاحتجاج به(@)(@@)(@@)(@@) $ 2671 - (@)(@@) غالب بن خطاف القطان يروي عن الأعمش حديث ((شهد الله)) وهو حديث معضل قال ابن عدي الضعف على حديثه بين(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 2672 - (@)(@@) غالب بن عبيد الله العقيلي الجزري يروي عن عطاء قال يحيى ليس بثقة وقال الرازي والدارقطني متروك الحديث وقال أبو الفتح الأزدي متروك الحديث لا يحل أن يروى عنه الحديث وقال ابن حبان يروي المعضلات عن الثقات لا يجوز الاحتجاج 
ms228	 به(@)(@@)(@@)(@@) $ 2673 - (@)(@@) غالب بن فائد يروي عن سفيان الثوري قال الأزدي يتكلمون في حديثه(@)(@@)(@@)(@@) $ 2674 - (@)(@@) غالب بن قران الهذلي روى عنه نصر بن علي الجهضمي قال الأزدي مجهول ضعيف(@)(@@)(@@)(@@) $ 2675 - (@)(@@) غالب بن هلال الترمذي يروي عن الأعمش قال الأزدي ضعيف(@)(@@)(@@)(@@) $ 2676 - (@)(@@) غانم بن الأحوص الحجازي عن أبي صالح السمان قال الدارقطني ليس بالقوي(@)(@@)(@@)(@@) $ 2677 - (@)(@@) غزوان بن يوسف المازني العامري البصري يروي عن الحسن قال البخاري تركوه وقال الرازي متروك الحديث وقال ابن حبان يروي عن الثقات ما لا يشبه حديث الأثبات سقط الاحتجاج بما يرويه(@)(@@) PageV00P000(@)(@@)(@@)(@@) || من اسمه ((غسان))(@)(@@)(@@)(@@) $ 2678 - (@)(@@) غسان بن أبان بن الأرقم بن كلاب أبو روح الحنفي اليمامي قال ابن حبان يروي العجائب وقال أبو الفتح الأزدي ضعيف مجهول(@)(@@)(@@)(@@) $ 2679 - (@)(@@) غسان بن الربيع يروي عن قيس بن الربيع قال الدارقطني ضعيف(@)(@@)(@@)(@@) $ 2680 - (@)(@@) غسان بن عبيد بن عبد الرحمن الموصلي يروي عن ابن أبي ذئب وعكرمة بن عمار قال أحمد بن حنبل كتبنا عنه وحرقنا حديثه منذ حين(@)(@@)(@@)(@@) $ 2681 - (@)(@@) غسان بن عمر أبو الهذيل العجلي عن الثوري قال الرازي منكر الحديث(@)(@@)(@@)(@@) $ 2682 - (@)(@@) غسان بن عوف البصري قال الأزدي ضعيف(@)(@@)(@@)(@@) $ 2683 - (@)(@@) غسان بن مالك أبو عبد الرحمن السلمي قال الرازي ليس بقوي بين في حديثه الإنكار(@)(@@)(@@)(@@) $ 2684 - (@)(@@) غسان بن ناقد عن أبي الأشهب قال الرازي مجهول والحديث الذي رواه في القدرية حديث باطل(@)(@@)(@@)(@@) || من اسمه ((غطيف))(@)(@@)(@@)(@@) $ 2685 - (@)(@@) غطيف الجزري ويقال الطائي ويروي عن القاسم بن مالك المزني فيقول روح بن غطيف وهو ضعيف الحديث متروك(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 2686 - (@)(@@) غطيف بن أعين الكوفي يروي عن مصعب بن سعد قال الدارقطني ضعيف(@)(@@)(@@)(@@) $ 2687 - (@)(@@) غنيم بن سالم يروي عن أنس قال ابن حبان روى العجائب لا يحتج به(@)(@@)(@@)(@@) $ 2688 - (@)(@@) غورك بن الخضرم السعدي أبو عبد الله قال الدارقطني ضعيف جدا(@)(@@)(@@)(@@) || من اسمه ((غياث))(@)(@@)(@@)(@@) $ 2689 - (@)(@@) غياث بن إبراهيم أبو عبد الرحمن النخعي الكوفي يروي عن الأعمش والأوزاعي قال أحمد والبخاري والنسائي والدارقطني متروك الحديث وقال يحيى ليس بثقة وقال مرة كان كذابا وقال السعدي وابن حبان 
ms229	 يضع الحديث وقال البخاري تركوه وقال الأزدي لا تحل الرواية [عنه](@)(@@)(@@)(@@) $ 1690 - (@)(@@) غياث بن كلوب قال الدارقطني له نسخة عن مطرف بن سمرة لا يعرف إلا به وهو ضعيف(@)(@@)(@@)(@@) $ 2691 - (@)(@@) غيلان بن أبي غيلان مولى لآل عثمان بن عفان روى عن يعقوب بن عتبة قال ابن حبان كان داعية إلى القدر وصلب بالشام ولا تحل الرواية عنه(@)(@@) //(@)(@@) كتاب الضعفاء والمتروكين(@)(@@) //(@)(@@) PageV00P000(@)(@@)(@@)(@@) | حرف الفاء(@)(@@)(@@)(@@) $ 2692 - (@)(@@) فائد بن عبد الرحمن أبو الورقاء الكوفي العطار يروي عن ابن أبي أوفى قال أحمد والنسائي متروك الحديث وقال يحيى ليس بثقة وقال مرة ضعيف وكذلك الدارقطني وقال الرازي ذاهب الحديث لا يكتب حديثه وقال البخاري منكر الحديث وقال أبو زرعة لا يشتغل به وقال ابن حبان لا يجوز الاحتجاج به(@)(@@)(@@)(@@) || من اسمه ((فرات))(@)(@@)(@@)(@@) $ 2693 - (@)(@@) فرات بن الأحنف ويقال له فرات بن أبي يحيى روى عن أبيه قال النسائي ضعيف وقال ابن حبان لا تحل الرواية عنه ولا الاحتجاج به(@)(@@)(@@)(@@) $ 2694 - (@)(@@) فرات بن زهير قال ابن حبان يروي عن مالك ما لم يروه قط لا تحل الرواية عنه(@)(@@)(@@)(@@) $ 2695 - (@)(@@) فرات بن السائب أبو سليمان وقيل أبو المعلى الجزري يروي عن ميمون بن مهران قال يحيى ليس بشيء وقال البخاري منكر الحديث تركوه وقال مرة متروك وقال السعدي والرازي وأبو زرعة ضعيف الحديث وقال الدارقطني متروك(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 2696 - (@)(@@) فرات بن سليم يروي عن عمرو بن عاتكة قال ابن حبان منكر الحديث يأتي بما لا يشك انه معمول(@)(@@)(@@)(@@) $ 2697 - (@)(@@) فرات بن أبي الفرات القرشي البصري يروي عن معاوية بن قرة قال يحيى ليس بشيء قال ابن عدي الضعف على رواياته بين قال الرازي صدوق لا بأس به(@)(@@)(@@)(@@) || (@)(@@)(@@)(@@) $ 2698 - (@)(@@) فرج بن فضالة أبو فضالة الشامي الحمصي يروي عن يحيى بن سعيد النصاري قال يحيى بن معين والنسائي ضعيف الحديث وقال البخاري منكر الحديث وقال ابن حبان يقلب الأسانيد ويلزق المتون الواهية بالأسانيد الصحيحة لا يحل الاحتجاج به(@)(@@)(@@)(@@) $ 2699 - (@)(@@) الفرزدق بن غالب الشاعر بكنى أبا فراس يروي عن ابن عمر وأبي هريرة 
ms230	 قال ابن حبان كان هتاكا للحرم وقذافا للمحصنات فتجب مجانبة روايته(@)(@@)(@@)(@@) $ 2700 - (@)(@@) فرقد بن يعقوب أبو يعقوب السبخي يروي عن الحسن ومرة وسعيد بن جبير قال أيوب ليس بشيء وقال النسائي والدارقطني ضعيف وقال ابن حبان كانت فيه غفلة ورداءة حفظ فكان يرفع المرسل وهو لا يعلم ويسند الموقوف من حيث لا يفهم فبطل الاحتجاج به وقال أحمد هو رجل صالح وليس بقوي في الحديث وقال يحيى ثقة(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 2701 - (@)(@@) قروة بن يونس الكلابي يروي عنه محمد بن عبد الله بن المثنى قال الأزدي ضعيف(@)(@@)(@@)(@@) $ 2702 - (@)(@@) فضالة بن جبير أبو المهنى أحاديثه غير محفوظة قاله ابن عدي وقال ابن حبان يروي عن أبي أمامة ما ليس من حديثه لا يحل الاحتجاج به بحال(@)(@@)(@@)(@@) || من اسمه ((فضالة))(@)(@@)(@@)(@@) $ 2703 - (@)(@@) فضالة الشحام قال الأزدي لم يكن يعقل ما يحدث فضالة الشحام البصري يروي عن عطاء وطاوس والحسن قال ابن حبان يروي المناكير عن المشاهير(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 2704 - (@)(@@) فضالة بن حصين أبو معاوية الضبي البصري يروي عن محمد بن عمرو قال ابن حبان يروي عن الثقات ما ليس من أحاديثهم قال الرازي مضطرب الحديث(@)(@@)(@@)(@@) $ 2705 - (@)(@@) فضالة بن دينار قال العقيلي منكر الحديث(@)(@@)(@@)(@@) $ 2706 - (@)(@@) فضالة بن مفضل بن فضالة المصري أبو ثوابة قال أبو حاتم الرازي لم يكن بأهل أن يكتب عنه(@)(@@)(@@)(@@) || من اسمه ((الفضل))(@)(@@)(@@)(@@) $ 2707 - (@)(@@) الفضل أبو محمد عن الحسن قال أبو حاتم الرازي مجهول(@)(@@)(@@)(@@) $ 2708 - (@)(@@) الفضل بن دلهم البصري مولى لبني تيم يروي عن الحسن قال يحيى ضعيف وقال الأزدي ضعيف جدا(@)(@@)(@@)(@@) $ 2709 - (@)(@@) الفضل بن سلام البصري يروي عن معاوية بن حفص ولم يكن أهلا أن يحمل عنه(@)(@@)(@@)(@@) $ 2710 - (@)(@@) الفضل بن صالح يروي عن عطاء بن السائب قال الأزدي لا يحتج بحديثه(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 2711 - (@)(@@) الفضل بن عبد الله بن مسعود أبو العباس اليشكري ويقال له ابن حرم من اهل هراة قال ابن حبان لا يجوز الاحتجاج به بحال(@)(@@)(@@)(@@) $ 2712 - (@)(@@) الفضل بن عبيد الله أبو العباس الحميري الاستراباذي يروي عن احمد بن حنبل كان يرمى بالكذب(@)(@@)(@@)(@@) $ 2713 - (@)(@@) الفضل 
ms231	 بن عيسى بن أبان أبو عيسى الرقاشي بصري خال معتمر وابن أبي يزيد الرقاشي قال أبو أيوب لو ولد الفضل أخرس كان خيرا له وقال ابن عيينة لا شيء وقال أحمد والنسائي هو ضعيف وقال يحيى رجل سوء وقال أبو حاتم الرازي وأبو زرعة منكر الحديث(@)(@@)(@@)(@@) $ 2714 - (@)(@@) الفضل بن عطية المروزي يروي عن عطاء بن أبي رباح وسالم قال الفلاس وابن عدي ضعيف وقال يحيى ليس به بأس(@)(@@)(@@)(@@) $ 2715 - (@)(@@) الفضل بن غانم أبو علي الخزاعي روى عن مالك قال يحيى ليس بشيء وقال الدارقطني ليس بالقوي(@)(@@)(@@)(@@) $ 2716 - (@)(@@) الفضل بن مبشر أبو بكر المديني روى عن خالد قال يحيى والنسائي ضعيف وقال أبو زرعة لين(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 2717 - (@)(@@) الفضل بن مؤتمر العتكي عن أبي الخلال(@)(@@)(@@)(@@) $ 2718 - (@)(@@) والفضل بن محرز الخزاعي قال أبو حاتم الرازي مجهولان(@)(@@)(@@)(@@) $ 2719 - (@)(@@) الفضل بن محمد العطار عن مصعب بن سعد عن زهير قال الدارقطني يكذب ويضع الحديث(@)(@@)(@@)(@@) $ 2720 - (@)(@@) الفضل بن محمد بن عبد الله بن الحارث بن سليمان أبو العباس الباهلي الأنطاكي الأحدب قال ابن عدي وصل أحاديث وسرق أحاديث وزاد في المتون(@)(@@)(@@)(@@) $ 2721 - (@)(@@) الفضل بن المختار أبو سهل البصري عن ابن أبي ذئب قال ابن عدي له احاديث منكرة وعامتها لا يتابع عليها وقال أبو حاتم الرازي مجهول وأحاديثه منكرة يحدث بالأباطيل قال الأزدي منكر الحديث جدا(@)(@@)(@@)(@@) $ 2722 - (@)(@@) الفضل بن موفق الكوفي يروي عن مسعر قال أبو حاتم الرازي كان يروي أحاديث من زعمه(@)(@@)(@@)(@@) $ 2723 - (@)(@@) الفضل بن ميمون أبو سلمة قال أبو حاتم الرازي منكر الحديث(@)(@@) PageV00P000(@)(@@)(@@)(@@) || من اسمه ((فضيل)(@)(@@)(@@)(@@) $ 2724 - (@)(@@) فضيل [بن] خديج روى عن مولى الأشتر قال أبو حاتم الرازي مجهول روى عنه رجل متروك(@)(@@)(@@)(@@) $ 2725 - (@)(@@) فضيل بن سليمان أبو سليمان النميري البصري يروي عن موسى بن عقبة وأبي حازم قال يحيى ليس بثقة وقال أبو زرعة لين الحديث وقال النسائي ليس بالقوي(@)(@@)(@@)(@@) $ 2726 - (@)(@@) فضيل بن مرزوق الرقاشي الكوفي يروي عن عطية قال يحيى ضعيف وقال مرة ثقة وقال الرازي لا يحتج به وقال ابن حبان يخطيء 
ms232	 على الثقات ويروي عن عطية الموضوعات(@)(@@)(@@)(@@) $ 2727 - (@)(@@) فضيل بن والان قال أبو حاتم الرازي مجهول(@)(@@) PageV00P000(@)(@@)(@@)(@@) || من اسمه ((فطر))(@)(@@)(@@)(@@) $ 2728 - (@)(@@) فطر بن حماد بن واقد البصري قال أبو حاتم الرازي ليس بالقوي(@)(@@)(@@)(@@) $ 2729 - (@)(@@) فطر بن خليفة قال السعدي زائغ غير ثقة وقال يحيى يكتب حديثه(@)(@@)(@@)(@@) $ 2730 - (@)(@@) فطر بن محمد العطار الأحدب قال الدارقطني حدثونا عنه وهو كذاب(@)(@@)(@@)(@@) $ 2731 - (@)(@@) فليج بن سليمان أبو يحيى المديني يروي عن نافع قال يحيى ليس بقوي ولا يحتج بحديثه وقال في رواية ضعيف وقال النسائي ليس بالقوي وقال المصنف قلت وقد أخرج عنه البخاري في صحيحه(@)(@@)(@@)(@@) || من اسمه ((فهد))(@)(@@)(@@)(@@) $ 2732 - (@)(@@) فهد بن حيان أبو زيد البصري يروي عن شعبة وعمران القطان قال ابن المديني ذهب حديثه وقال أبو حاتم الرازي ضعيف الحديث وقال أبو زرعة منكر الحديث(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 2733 - (@)(@@) فهد بن عوف أبو ربيعة العامري قال علي كذاب وكان يقول ذهب الفهدان فهد بن حيان وفهد بن عوف(@)(@@)(@@)(@@) $ 2734 - (@)(@@) فياض بن محمد البصري عن يحيى بن أبي كثير قال الرزاي مجهول(@)(@@)(@@)(@@) $ 2735 - (@)(@@) الفيض بن وثيق بن عبد الله كذاب خبيث(@)(@@) PageV00P000(@)(@@)(@@)(@@) | حرف القاف(@)(@@)(@@)(@@) $ 2736 - (@)(@@) قابوس بن أبي ظبيان الجنبي الكوفي واسم أبي ظبيان خضير بن جندب قال يحيى ضعيف الحديث وقال مرة ثقة وقال أبو حاتم الرازي يكتب حديثه ولا يحتج به وقال النسائي ليس بالقوي وقال ابن حبان كان رديء الحفظ يتفرد عن أبيه بما لا أصل له وربما رفع المرسل وأسند الموقوف وأبوه ثقة وكان يحيى بن معين شديد الحمل على قابوس(@)(@@)(@@)(@@) || من اسمه ((قاسم))(@)(@@)(@@)(@@) $ 2737 - (@)(@@) القاسم أبو نوح الأنصاري عن ابن المسيب(@)(@@)(@@)(@@) $ 2738 - (@)(@@) والقاسم الكتابي عن ابن المسيب قال الرازي مجهولان(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 2739 - (@)(@@) قاسم بن إبراهيم الملطي يروي عن مالك قال الدارقطني كذاب وقال أبو بكر الخطيب كان مشهورا بوضع الحديث(@)(@@)(@@)(@@) $ 2740 - (@)(@@) قاسم بن إبراهيم بن علي بن عمار الهاشمي الكوفي يروي عن الفضل بن دكين قال ابن حبان حدث بما لا أصل له(@)(@@)(@@)(@@) $ 2741 - (@)(@@) قاسم بن أمية الحذاء قال ابن حبان يروي عن حفص بن 
ms233	 غياث المناكيرلا يجوز الإحتجاج بأفراده(@)(@@)(@@)(@@) $ 2742 - (@)(@@) قاسم بن بهرام قال ابن حبان يروي عن الزبير العجائب لا يجوز الإحتجاج به بحال(@)(@@)(@@)(@@) $ 2743 - (@)(@@) القاسم بن حبيب التمار الكوفي يروي عن فرات بن حيان قال يحيى لا شيء(@)(@@)(@@)(@@) $ 2744 - (@)(@@) القاسم بن الحكم بن أوس أبو محمد البصري يروي عن أبي عباد الزرقي(@)(@@) PageV00P000(@)(@@) قال أبة حاتم الرازي مجهول(@)(@@)(@@)(@@) $ 2745 - (@)(@@) القاسم بن عبد الرحمن عن أبيه عن أبي هريرة قال الرازي مجهول وقال يحيى ليس يساوي شيئا(@)(@@)(@@)(@@) $ 2746 القاسم بن عبد الرحمن أبو عبد الرحمن مولى خالد بن يزيد بن معاوية قال أحمد منكر الحديث حدث عنه علي بن يزيد أعاجيب وما أراها إلا من قبل القاسم وقال ابن حبان كان يروي عن أصحاب رسول الله صلى الله عليه وسلم وآله وسلم المعضلات قال المصنف قلت و (القاسم بن عبد الرحمن) ستة أنفس ليس فيهم من طعن فيه سواهما(@)(@@)(@@)(@@) $ 2747 - (@)(@@) قاسم بن عبد الله روى عنه هنيد بن القاسم قال الرازي مجهول(@)(@@)(@@)(@@) $ 2748 - (@)(@@) قاسم بن عبد الله المكفوف يروي عن سالم الخواص نسبه ابن حبان إلى وضع الحديث(@)(@@)(@@)(@@) $ 2749 - (@)(@@) قاسم بن عبد الله بن عمر العمري المديني عن عبد الله بن دينار وابن المنكدر قال أحمد ليس هو عندي بشيء كان يكذب ويضع الحديث ترك الناس حديثه وقال يحيى ليس بشيء وقال مرة كذاب خبيث وقال الرازي والنسائي والأزدي متروك الحديث وقال أبو زرعة لا يساوي شيئا متروك الحديث وقال الدراقطني ضعيف(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 2750 - (@)(@@) قاسم بن عبد الله بن محمد بن عقيل قال يحيى ليس هو بشيء(@)(@@)(@@)(@@) $ 2751 - (@)(@@) القاسم بن عوف قال أبو حاتم الرازي مضطرب الحديث وتركه شعبة(@)(@@)(@@)(@@) $ 2752 - (@)(@@) القاسم بن غصن الشامي يروي عن ابن مسعود وداود بن أبي هند قال أحمد يحدث بأحاديث مناكير وقال الرازي منكر الحديث وقال ابن حبان يروي المناكير عن المشاهير ويقلب الأسانيد لا يجوز الاحتجاج بأفراده(@)(@@)(@@)(@@) $ 2753 - (@)(@@) القاسم بن فياض بن عبد الله بن عبد الرحمن الصنعاني روى عنه هشام بن يونس قال يحيى ضعيف وقال مرة 
ms234	 ليس بشيء وقال النسائي ليس بالقوي وقال ابن حبان كان ينفرد بالمناكير عن المشاهير فلما كثر ذلك في روايته بطل الاحتجاج به(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 2754 - (@)(@@) القاسم بن محمد بن حماد الدلال الكوفي قال الدارقطني حدثونا عنه وهو ضعيف(@)(@@)(@@)(@@) $ 2755 - (@)(@@) القاسم بن محمد بن حميد المعمري قال يحيى كذاب خبيث(@)(@@)(@@)(@@) $ 2756 - (@)(@@) القاسم بن محمد بن أبي شيبة أخو أبي بكر وعثمان وهو الأكبر يروي عن البصريين والكوفيين قال أبو حاتم الرازي تركت حديثه وقال أحمد ويحيى والنسائي ضعيف وقال الدراقطني يكذب(@)(@@)(@@)(@@) $ 2757 - (@)(@@) القاسم بن محمد بن عبد الله الفرغاني يروي عن أبي عاصم النبيل قال أبو عبد الله الحاكم يضع الحديث وضعا فاحشا(@)(@@)(@@)(@@) $ 2758 - (@)(@@) القاسم بن محمد بن عبد الله بن محمد بن عقيل بن أبي طالب قال أحمد ليس بشيء وقال أبو حاتم الرازي متروك الحديث وقال أبو زرعة أحاديثه [منكرة وهو ضعيف الحديث](@)(@@)(@@)(@@) $ 2759 - (@)(@@) القاسم بن مطيب العجلي يروي عن أبي المليح قال ابن حبان يخطئ كثيرا فاستحق الترك(@)(@@)(@@)(@@) $ 2760 - (@)(@@) القاسم بن المعتمر أبو العباس قال الرازي مجهول(@)(@@)(@@)(@@) $ 2761 - (@)(@@) القاسم بن مهران القاضي يروي عن أبي الزبير قال الأزدي مجهول(@)(@@) PageV00P000(@)(@@)(@@)(@@) || (@)(@@)(@@)(@@) $ 2762 - (@)(@@) قتيبة أبو محمد الزمي عن شيبان قال أبو حاتم الرازي مجهول(@)(@@)(@@)(@@) $ 2763 - (@)(@@) قدامة بن محمد بن خشرم يروي عن أبيه ومخرمة بن بكير قال أبو حبان يروي المقلوبات لا يجوز الاحتجاج به إذا انفرد(@)(@@)(@@)(@@) $ 2764 - (@)(@@) قرة بن عبد الرحمن بن حيوئيل صاحب الزهري قال أحمد منكر الحديث جدا(@)(@@)(@@)(@@) $ 2765 - (@)(@@) قريش بن أنس أبو أنس الأنصاري مولى والبة يروي عن ابن عون قال ابن المديني كان ثقة وقال ابن حبان اختلط فظهر في حديثه مناكير فلم يجز الاحتجاج بأفراده(@)(@@)(@@)(@@) $ 2766 - (@)(@@) قر [بن] بن سهل بن قرين عن ابن أبي ذئب الأزدي كذاب وأبوه(@)(@@)(@@)(@@) $ 2767 - (@)(@@) قزعة بن سويد بن حجير الباهلي البصري وهو الذي يقال له قزعة بن أبي قزعة يروي عن عبيد الله بن عمر وحميد بن قيس قال أحمد مضطرب الحديث وقال يحيى والنسائي ضعيف ووثقه يحيى في رواية وقال 
ms235	 ارازي لا يحتج به وقال ابن حبان كان كثير خطأ فاحش الوهم فلما كثر ذلك في روايته سقط الاحتجاج بأخباره(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 2768 - (@)(@@) قطبة بن العلاء بن المنهال أبو سفيان الغنوي يروي عن الثوري قال الرازي يخطئ كثيرا ويأتي بالأشياء التي لا تشبه حديث الثقات فعدل به عن مسلك العدول عن الاحتجاج به(@)(@@)(@@)(@@) || من اسمه ((قطن))(@)(@@)(@@)(@@) $ 2769 - (@)(@@) قطن بن سعير بن الخمس قال يحيى كان رجل سوء(@)(@@)(@@)(@@) $ 2770 - (@)(@@) قطن بن صالح أبو عبد الله الدمشقي يروي عن ابن جريح قال الأزدي كذاب لا يكتب حديثه(@)(@@)(@@)(@@) $ 2771 - (@)(@@) قطن بن نسير أبو عباد الغبري روى عن جعفر بن سليمان قال ابن عدي كان يسرق الحديث ويوصله وكان أبو زرعة يعمل عليه(@)(@@)(@@)(@@) $ 2772 - (@)(@@) قنان بن عبد الله قال النسائي ليس بالقوي مدح فيه يحيى بن آدم(@)(@@)(@@)(@@) || من اسمه ((قيس))(@)(@@)(@@)(@@) $ 2773 - (@)(@@) قيس بن الحصين من بني الحارث بن كعب قال أبو حاتم الرازي مجهول(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 2774 - (@)(@@) قيس بن الربيع أبو محمد الأسدي الكوفي يروي عن أبي حصين وأبي إسحاق الهمداني قال يحيى ليس بشيء وقال مرة ضعيف وقال مرة لا يكتب حديثه وقيل لأحمد لم ترك الناس حديثه قال كان يتشيع وكان [كثير] الخطأ في الحديث وروى أحاديث منكرة وكان ابن المديني ووكيع يضعفانه وقال السعدي ساقط وقال الدارقطني ضعيف الحديث وقال النسائي متروك الحديث وكان شعبة وشريك يثنيان عليه وقال أبو داود إنما أتي قيس من قبل ابنه كان يدخل أحاديث الناس فيدخلها في فرج كتاب قيس ولا يعرف الشيخ ذلك وقال ابن حبان تتبعت حديثه فرأيته صادقا إلا أنه لما كبر ساء حفظه فيدخل عليه فيجيب فيه ثقة بابنه فوقعت في المناكير في روايته فاستحق المجانبة قال أبو الفتح الأزدي حدثنا ابن منيع حدثنا محمود بن غيلان قال قال لي محمد بن عبيد ((كان قيس بن الربيع استعمله أبو جعفر على المدائن فكان يعلق النساء بأثدائهن ويرسل عليهن الزنابير))(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 2775 - (@)(@@) قال المصنف قلت وثم آخر يقال له (قيس بن الربيع) تابعي روى حديثا فيه نظر 
ms236	(@)(@@)(@@)(@@) $ 2776 - (@)(@@) قيس بن طلق الذي روى عن أبيه حديث مس الذكر ضعفه أحمد ويحيى وقال أبو حاتم الرازي وأبو زرعة قيس لا تقوم به حجة(@)(@@)(@@)(@@) $ 2777 - (@)(@@) قيس بن عبد الله الفارسي يروي عن الضحاك بن عثمان قال الأزدي ضعيف مجهول(@)(@@)(@@)(@@) $ 2778 - (@)(@@) قيس بن كعب يروي عن معن بن عبد الرحمن قال الأزدي ضعيف مجهول(@)(@@) PageV00P000(@)(@@)(@@)(@@) | حرف الكاف(@)(@@)(@@)(@@) || من اسمه ((كادح))(@)(@@)(@@)(@@) $ 2779 - (@)(@@) كادح بن جعفر يروي عن ابن لهيعة قال الأزدي ضعيف زائغ(@)(@@)(@@)(@@) $ 2780 - (@)(@@) كادح بن رحمة الزاهد الكوفي يروي عن الثوري ومسعر قال ابن حبان يروي عن الثقات المقلوبات حتى يسبق إلى القلب أنه المتعمد لها فاستحق الترك وقال أبو الفتح الأزدي هو كذاب(@)(@@)(@@)(@@) || من اسمه ((كامل))(@)(@@)(@@)(@@) $ 2781 - (@)(@@) كامل بن طلحة الجحدري قال يحيى ليس بشيء وقال أحمد ما اعلم أحدا يدفعه بحجة(@)(@@)(@@)(@@) $ 2782 - (@)(@@) كامل بن العلاء أبو العلاء وقيل أبو عبد الله السعدي الحماني التميمي الكوفي مولى ضباعة يروي عن حبيب بن أبي ثابت قال ابن حبان كان ممن يقلب الأسانيد ويرفع المراسيل من حيث لا يدري فبطل الاحتجاج بأخباره(@)(@@) PageV00P000(@)(@@)(@@)(@@) || من اسمه ((كثير))(@)(@@)(@@)(@@) $ 2783 - (@)(@@) كثير النواء أبو إسماعيل الكوفي يروي عن عطية قال الرازي والنسائي ضعيف وقال السعدي زايغ وقال ابن حبان كان غالبا في التشيع مفرطا فيه(@)(@@)(@@)(@@) $ 2784 - (@)(@@) كثير بن حمير الأصم يروي عن حبيب بن أبي مرزوق قال ابن حبان لا يجوز الاحتجاج به(@)(@@)(@@)(@@) $ 2785 - (@)(@@) كثير بن زادان قال أبو حاتم الرازي وأبو زرعة مجهول(@)(@@)(@@)(@@) $ 2786 - (@)(@@) كثير بن زيد أبو محمد المدني مولى الأسلميين ويقال له ابن صافية وهي أمه قال يحيى ليس بذاك القوي وقال مرة ثقة وقال مرة ليس بشيء وقال النسائي ضعيف وقال أبو زرعة لين(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 2787 - (@)(@@) كثير بن سليم أبو سلمة وقيل أبو هشام الضبي المدائيني البصري يروي عن أنس قال يحيى والدارقطني ضعيف وقال النسائي والأزدي متروك الحديث وقال أبو زرعة واهي الحديث وقال ابن حبان هو الذي يقال له كثير بن عبد الله يروي عن انس ما ليس من حديثه ويضع عليه 
ms237	 وقال أبو حاتم الرازي منكر الحديث لا يروي عن انس حديثا له أصل من رواية غيره(@)(@@)(@@)(@@) $ 2788 - (@)(@@) كثير بن شنظير أبو قرة المازني بصري يروي عن الحسن وابن سيرين قال النسائي ليس بالقوي وقال أبو زرعة لين وقال يحيى ليس بشيء وقال مرة ثقة وقال احمد صالح(@)(@@)(@@)(@@) $ 2789 - (@)(@@) كثير بن عبد الله أبو هاشم الوشاء الأبلي يروي عن انس قال البخاري منكر الحديث عن انس وقال الرازي منكر الحديث وقال النسائي متروك الحديث وقال الدارقطني ضعيف وقد ذهب قوم منهم الدارقطني إلى أن كثير بن عبد الله هو كثير بن سليم المتقدم(@)(@@)(@@)(@@) $ 2790 - (@)(@@) كثير بن عبد الله بن عمرو بن عوف المزني يروي عن أبيه قال أحمد لا يحدث عنه وقال مرة منكر الحديث ليس بشيء وقال مرة لا يساوي شيئا وضرب على حديثه في المسند ولم يحدث به وقال يحيى ليس حديثه بشيء ولا يكتب(@)(@@) PageV00P000(@)(@@) وقال النسائي والدارقطني متروك الحديث وقال أبو زرعة واهي الحديث وقال الشافعي هو ركن من أركان الكذب وقال ابن حبان روى عن أبيه عن جده نسخة موضوعة لا يحل ذكرها في الكتب ولا الرواية عنه إلا على جهة النعجب قال المصنف قلت ثم ثالث يقال له (كثير بن عبد الله اليشكري) حدث عن الحسن لم نعرف فيه طعنا(@)(@@)(@@)(@@) $ 2791 - (@)(@@) كثير بن كثير أبو النضر يروي عن ربعي بن حراش قال يحيى ضعيف الحديث(@)(@@)(@@)(@@) $ 2792 - (@)(@@) كثير بن محمد العجلي قال أبو حاتم الرازي مجهول(@)(@@)(@@)(@@) $ 2793 - (@)(@@) كثير بن مروان بن محمد بن سويد أبو عبد الله الفهري السلمي المقدسي الفلسطيني يروي عن إبراهيم بن أبي عبلة وعبد الله بن يزيد الدمشقي قال يحيى والدارقطني ضعيف وقال يحيى مرة ليس بشيء كذاب كان يحدث بالمنكرات وقال يعقوب بن سفيان ليس حديثه بشيء وقال ابن حبان لا يجوز الاحتجاج به ولا الرواية عنه إلا على وجه التعجب(@)(@@)(@@)(@@) $ 2794 - (@)(@@) كثير بن معبد القيسي قال الأزدي ضعيف(@)(@@)(@@)(@@) || (@)(@@)(@@)(@@) $ 2795 - (@)(@@) كدير الضبي روى عنه أبو إسحاق السبيعي وجده ويقال أن له صحبة 
ms238	 ضعفه البخاري والنسائي(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 2796 - (@)(@@) كريب بن الطيب قال الرازي مجهول(@)(@@)(@@)(@@) $ 2797 - (@)(@@) كريم بن الحارث قال ابن عدي لم يسمع عنه غير أبي إسحاق السبيعي وهو غير معروف(@)(@@)(@@)(@@) $ 2798 - (@)(@@) كعب المديني عن أبي هريرة قال الرازي مجهول(@)(@@)(@@)(@@) || من اسمه ((كلثوم))(@)(@@)(@@)(@@) $ 2799 - (@)(@@) كلثوم بن جوشن القشيري يروي عن الحسن وأيوب السختياني قال الرازي ضعيف الحديث وقال ابن حبان يروي عن الثقات الملزوقات وعن الأثبات الموضوعات لا يحل الاحتجاج به بحال(@)(@@)(@@)(@@) $ 2800 - (@)(@@) كلثوم بن زياد يروي عن سليمان بن حبيب قال النسائي ضعيف(@)(@@)(@@)(@@) $ 2801 - (@)(@@) كلثوم بن محمد بن أبي سدرة الحلبي قال الرازي يتكلمون فيه(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 2802 - (@)(@@) كلثوم بن مرثد الكوفي قال أبو حاتم الرازي مجهول(@)(@@)(@@)(@@) $ 2803 - (@)(@@) كليب بن وائل البكري قال الرازي ضعيف وقال يحيى ثقة(@)(@@)(@@)(@@) $ 2804 - (@)(@@) كميل بن زياد الجعفي ويقال له كميل بن عبد الله من أصحاب علي عليه السلام قال ابن حبان يروي عنه المعضلات لا يحتج به(@)(@@)(@@)(@@) || من اسمه ((كنانة))(@)(@@)(@@)(@@) $ 2805 - (@)(@@) كنانة بن جبلة بن عمرو أبو النضر الخراسان الهروي يروي عن إبراهيم بن طهمان قال يحيى كذاب خبيث وقال السعدي ضعيف الأمر جدا وقال ابن حبان كان يتفرد عن الثقات بالأشياء المعضلات وقال الأزدي متروك الحديث(@)(@@)(@@)(@@) $ 2806 - (@)(@@) كنانة بن العباس بن مرداس السلمي يروي عن أبيه قال ابن حبان منكر الحديث جدا فلا أدري التخليط منه او من أبيه أو من أيهما كان فهو ساقط الاحتجاج(@)(@@)(@@)(@@) $ 2807 - (@)(@@) كوثر بن حكيم أبو مخلد الحلبي الكوفي يروي عن عطاء ونافع قال أحمد أحاديثه بواطيل ليس بشيء وقال مرة متروك الحديث وكذلك قال السعدي والنسائي وقال الرازي وأبو زرعة ضعيف بالحديث وقال البخاري والدارقطني منكر الحديث وقال ابن حبان يروي المناكير عن المشاهير ويأتي عن الثقات بما ليس من حديث الأثبات(@)(@@) PageV00P000(@)(@@)(@@)(@@) || من اسمه ((كيسان))(@)(@@)(@@)(@@) $ 2808 - (@)(@@) كيسان أبو بكر مولى هشام بن حسان يروي عن ابن سيرين قال الأزدي ضعيف(@)(@@)(@@)(@@) $ 2809 - (@)(@@) كيسان أبو عمر القصاب يروي عن يزيد بن بلال قال يحيى ضعيف الحديث وقال الدراقطني ليس بالقوي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | حرف اللام(@)(@@)(@@)(@@) $ 2810 - (@)(@@) لاحق 
ms239	 بن الحسين بن عمران أبو عمر يعرف بالمقدسي قال أبو سعد الإدريسي كان كذابا يضع الحديث على الثقات(@)(@@)(@@)(@@) $ 2811 - (@)(@@) لاهز بن عبد الله أبو عمرو التيمي حدث عن معتمر بن سليمان قال ابن عدي مجهول يروي عن الثقات المناكير روى حديثا باطلا في فضل عليا عليه السلام والبلاء من وقال أبو الفتح الأزدي لاهز غير ثقة ولا مأمون وهو أيضا مجهول(@)(@@)(@@)(@@) $ 2812 - (@)(@@) لوذان بن سليمان الشامي روى عن بقية قال الأزدي ضعيف وقال ابن عدي مجهول(@)(@@)(@@)(@@) $ 2813 - (@)(@@) لوط بن يحيى أبو مخنف قال يحيى ليس بثقة وقال مرة ليس بشيء وقال أبو حاتم الرازي متروك الحديث وقال الدارقطني ضعيف(@)(@@)(@@)(@@) || من اسمه ((ليث))(@)(@@)(@@)(@@) $ 2814 - (@)(@@) ليث بن سالم عن هشام بن عروة قال ابن عدي ليس بمعروف(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 2815 - (@)(@@) ليث بن أبي سليم بن زنيم الليثي الكوفي واسم أبي سليم أنس روى عن مجاهد وطاوس وابن سيرين ضعفه ابن عيينة والنسائي وقال أحمد مضطرب الحديث ولكن قد حدث عنه الناس وقال السعدي يضعف حديثه وقال أبو حاتم الرازي وأبو زرعة لا يشتغل به وهو مضطرب الحديث وقال ابن حبان اختلط في آخر عمره فكان يقلب الأسانيد ويرفع المراسيل ويأتي عن الثقات بما ليس من حديثهم تركه يحيى القطان ويحيى بن معين وابن مهدي وأحمد(@)(@@)(@@)(@@) $ 2816 - (@)(@@) ليث بن عمرو بن سام قال النسائي ضعيف(@)(@@)(@@)(@@) $ 2817 - (@)(@@) ليث بن محمد الموقري(@)(@@)(@@)(@@) $ 2818 - (@)(@@) وليث بن أبي مريم قال النسائي كلاهما متروك الحديث(@)(@@)(@@)(@@) $ 2819 - (@)(@@) ليث بن المساور يروي عن عبد الله بن عمر العمري قال الأزدي ضعيف(@)(@@) PageV00P000(@)(@@)(@@)(@@) | حرف الميم(@)(@@)(@@)(@@) || من اسمه ((مالك))(@)(@@)(@@)(@@) $ 2820 - (@)(@@) مالك عن عثمان(@)(@@)(@@)(@@) $ 2821 - (@)(@@) مالك بن اعين الجهني عن زيد بن وهب(@)(@@)(@@)(@@) $ 2822 - (@)(@@) ومالك بن أبي الحسن عن الحسن قال الرازي كلهم مجاهيل(@)(@@)(@@)(@@) $ 2823 - (@)(@@) مالك بن سليمان أبو غسان النهشلي بصري يروي عن يزيد الضبي قال ابن حبان يأتي عن الثقات بما لا يشبه حديث الأثبات(@)(@@)(@@)(@@) $ 2824 - (@)(@@) مالك بن الصباح عن رجل عن رسول الله صلى الله عليه وسلم(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 2825 - (@)(@@) ومالك بن عبيدة بن مسافع 
ms240	 قال الرازي مجهولان(@)(@@)(@@)(@@) $ 2826 - (@)(@@) مالك بن مالك شيخ يروي عنه أبو إسحاق السبيعي قال ابن حبان لا يجوز الاحتجاج به(@)(@@)(@@)(@@) $ 2817 - (@)(@@) مالك بن يحيى بن عمرو بن مالك أبو غسان النكري البصري يروي عن أبيه قال ابن حبان لا يجوز الاحتجاج بأفراده(@)(@@)(@@)(@@) $ 2828 - (@)(@@) مالك بن يسار البصري روى عن ابن الزبير روى عنه زيد بن هاشم قال أبو حاتم الرازي هو وزيد مجهولان(@)(@@)(@@)(@@) || من اسمه ((مؤمل))(@)(@@)(@@)(@@) $ 2829 - (@)(@@) مؤمل بن سعيد بن يوسف أبو فراس الرحبي الشامي يروي عن أبيه وأسد بن وداعة روى عنه سليمان بن سلمة الجنائزي قال أبو حاتم الرازي منكر الحديث وقال ابن حبان لا ادري منه وقع المنكر أم من سليمان لأن سليمان كان يروي الموضوعات عن الأثبات فقد بطل الاحتجاج بما يرويانه(@)(@@)(@@)(@@) $ 2830 - (@)(@@) مؤمل بن عبد الرحمن الثقفي عن حماد بن سلمة قال الرازي ضعيف الحديث(@)(@@) PageV00P000(@)(@@)(@@)(@@) || من اسمه ((مأمون))(@)(@@)(@@)(@@) $ 2831 - (@)(@@) مأمون العائذي يروي عن علي قال الأزدي زائغ لا يحتج به(@)(@@)(@@)(@@) $ 2832 - (@)(@@) مأمون بن أحمد أبو عبد الله السلمي من اهل هراة يروي عن هشام بن عروة وغيره قال ابن حبان كان دجالا من الدجالين ظاهر أحواله مذهب الكرامية وباطنها لا يوقف على حقيقته حدث عمن لم يره(@)(@@)(@@)(@@) || من اسمه ((مبارك))(@)(@@)(@@)(@@) $ 2833 - (@)(@@) مبارك بن حسان يروي عن عطاء قال الأزدي متروك الحديث لا يحتج به يرمي بالكذب(@)(@@)(@@)(@@) $ 2834 - (@)(@@) مبارك بن أبي حمزة عن عبد الله بن فروخ قال أبو حاتم الرازي وهما مجهولان ضعيفان(@)(@@)(@@)(@@) $ 2835 - (@)(@@) مبارك بن سحيم بن عبد الله أبو سحيم البناني البصري مولى عبد العزيز ابن صهيب يروي عنه قال البخاري وأبو حاتم الرازي منكر الحديث وقال أبو زرعة الرازي واهي الحديث منكر الحديث ما اعرف له حديثا صحيحا وقال النسائي متروك الحديث وقال ابن حبان يتفرد بالمناكير لا يجوز الاحتجاج به(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 2836 - (@)(@@) مبارك بن فضالة وهو ابن أبي أمية مولى عمر بن الخطاب رضي الله عنه يكنى أبا فضالة كان يحيى بن سعيد لا يرضاه وضعفه أحمد بن حنبل وقال لرجل 