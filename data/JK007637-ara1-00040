ms21	 النبي محمد % % من ابنته ما كان أنحلها قبل % % 13(@)(@@) % تمالوا عليها غاصبين لحقها % % وقالوا معاذ الله أن تورث الرسل % % 14(@)(@@) % وحكمهم لا شك في ذاك باطل % % وكيف يصح الفرع والأصل مختل % % 15(@)(@@) % أليس أمير المؤمنين هو الذي % % له دونهم في ذلك العقد والحل % % 16(@)(@@) % وهم قتلوا من آل أحمد سادة % % كراما بهم يستدفع الضر والأزل % % 17(@)(@@) % سقوا كل أرض من دماء رقابهم % % وشيعتهم حتى ارتوى الحزن والسهل % % 18(@)(@@) % فصبرا بني المختار إن أمامنا % % لموقف عدل عنده يقع الفصل % % 19(@)(@@) % وعندي لمن عاداكم نصل مقول % % إذا ما انبرى يوما يحاذره النصل % % PageV01P107 البحر : - 1(@)(@@) % لو كان يعلم أنها الأحداق % % يوم النقا ما خاطر المشتاق % % 2(@)(@@) % جهل الهوى حتى غدا في أسره % % والحب ما لأسيره إطلاق % % 3(@)(@@) % يا صاحبي وما الرفيق بصاحب % % إن لم يكن من دأبه الإشفاق % % 4(@)(@@) % هذا النقا حيث النفوس تباح % % والألباب تسلب والدماء تراق % % 5(@)(@@) % حيث الظباء لهن سوق في الهوى % % فيها لألباب الرجال نفاق % % 6(@)(@@) % فخذا يمينا عن مضاربه فمن % % دون المضارب تضرب العناق % % 7(@)(@@) % وحذار من تلك الظباء فمالها % % في الحب لا عهد ولا ميثاق % % 8(@)(@@) % وبمهجتي من شاركتني لومي % % وجدا عليه فكلنا عشاق % % 9(@)(@@) % كالبدر إلا أنه في تمه % % لا يختشي أن يعتريه محاق % % 10(@)(@@) % كالغصن لكن حسنه في ذاته % % والغصن زانت قده الأوراق % % PageV01P108 11(@)(@@) % مهما شكوت له الجفاء يقول لي % % ما الحب إلا جفوة وفراق % % 12(@)(@@) % أو أشتكي سهري عليه يقل متى % % نامت لمن حمل الهوى آماق % % 13(@)(@@) % أو قلت قد أشرقتني بمدامعي % % قال الأهلة شأنها الإشراق % % 14(@)(@@) % ما كنت أدري قبله أن الهوى % % مهج تصدع أو دم مهراق % % 15(@)(@@) % كنت الخلي فعرضتني للهوى % % يوم النقا الوجنات والأحداق % % 16(@)(@@) % ومن التدله في الغرام وهكذا % % سكر الصبابة ماله إفراق % % 17(@)(@@) % إني أعبر بالنقا عن غيره % % وأقول شام والمراد عراق % % 18(@)(@@) % ما للنقا قصدي ولا بمحجر % % وجدي ولا أنا للحمى مشتاق % % 19(@)(@@) % برح الخفا نعمان أقصى مطلبي لو ساعدتني صحبة ورفاق يا برق نعمان أفق حتى متى 
ms22	 % % وإلى متى الأرعاد والإبراق % % 20(@)(@@) % قل لي عن الأحباب هل عهدي على % % عهدي وهل ميثاقي الميثاق % % PageV01P109 21(@)(@@) % يا ليت شعري إن ليت وأختها % % لسمير من لعبت به الأشواق % % 22(@)(@@) % أيعود لي بعد الصدود تواصل % % ويعاد لي بعد البعاد عناق % % 23(@)(@@) % إني أقول لعصبة زيدية % % وخدت بهم نحو العراق نياق % % 24(@)(@@) % بأبي وبي وبطارفي وبتالدي % % من يمموه ومن إليه ساقوا % % 25(@)(@@) % هل منة في حمل جسم حل في % % أرض الغري فؤاده الخفاق % % 26(@)(@@) % أسمعتهم ذكر الغري وقد سرت % % بعقولهم خمر السرى فأفاقوا % % 27(@)(@@) % حبا لمن يسقي الأنام غدا ومن % % تشفى بترب نعاله الأحداق % % 28(@)(@@) % لمن استقامت ملة الباري به % % وعلت وقامت للعلى أسواق % % 29(@)(@@) % ولمن إليه حديث كل فضيلة % % من بعد خير المرسلين يساق % % 30(@)(@@) % لمحطم الردن الرماح وقد غدا % % للنقع من فوق الرماح رواق % % PageV01P110 31(@)(@@) % لفتى تحيته لعظم جلاله % % من زائريه الصمت والإطراق % % 32(@)(@@) % صهر النبي وصنوه يا حبذا % % صنوان قد وشجتهما الأعراق % % 33(@)(@@) % وأبو الأولى فاقوا وراقوا والألى % % بمديحهم تتزين الأوراق % % 34(@)(@@) % انظر إلى غايات كل سيادة % % أسواه كان جوادها السباق % % 35(@)(@@) % وامدحه لا متحرجا في مدحه % % إذ لا مبالغة ولا إغراق % % 36(@)(@@) % ولاه أحمد في الغدير ولا ية % % أضحت مطوقة بها الأعناق % % 37(@)(@@) % حتى إذا أجرى إليها طرفه % % حادوه عن سنن الطريق وعاقوا % % 38(@)(@@) % ما كان أسرع ما تناسوا عهده % % ظلما وحلت تلكم الأطواق % % 39(@)(@@) % شهدوا بها يوم الغدير لحيدر % % إذ عم من أنوارها الإشراق % % PageV01P111 البحر : - 1(@)(@@) % % % 2(@)(@@) % حتى إذا قبض المذل سطاهم % % وغدت عليه من الثرى أطباق % % PageV01P112 البحر : - 1(@)(@@) % % % 2(@)(@@) % يا ليت شعري ما يكون جوابهم % % حين الخلائق للحساب تساق % % 3(@)(@@) % حين الخصيم محمد وشهوده % % أهل السما والحاكم الخلاق % % 4(@)(@@) % قد قيدت إذ ذاك ألسنهم بما % % نكثوا العهود فما لها إطلاق % % 5(@)(@@) % وتظل تذرف بالدما آماقهم % % للكرب لا رقأت لهم آماق % % 6(@)(@@) % راموا شفاعة أحمد من بعدما % % سفكوا دما أبنائه وأراقوا % % 7(@)(@@) % فهناك يدعو كيف كانت فيكم % % تلك العهود وذلك الميثاق % % 8(@)(@@) % الآن حين نكثتم عهدي وذاق 
ms23	 أقاربي من ظلمكم ما ذاقوا % . . . % 9(@)(@@) % وأخي غدت تسعى له من نكثكم % % حيات غدر سمهن زعاق % % 10(@)(@@) % وأصاب بنتي من دفائن غردكم % % وجفاءكم دهياء ليس تطاق % % PageV01P113 11(@)(@@) % وسننتم من ظلم أهلي سنة % % بكم اقتدى في فعلها الفساق % % 12(@)(@@) % وبسعيكم رمي الحسين وأهله % % بكتائب غصت بها الآفاق % % 13(@)(@@) % فغدت تنوشهم هناك ذوابل % % سمر ومرهفة المتون رقاق % % 14(@)(@@) % وكذاك زيد أحرقته معاشر % % ما إن لهم يوم الحساب خلاق % % 15(@)(@@) % من ذلك الحطب الذي جمعتم % % يوم الفعلية ذلك الإحراق % % 16(@)(@@) % ولكم دم شركتم في وزره % % لبني في الحرم الشريف يراق % % 17(@)(@@) % ولكم أسير منهم وأسيرة % % تدعو ألا من ألا إعتاق % % 18(@)(@@) % أجزاء نصحي أن ينال أقاربي % % من بعدي الإبعاد والإزهاق % % 19(@)(@@) % فالآن جئتم تطلبون شفاعتي % % لما علا كرب وضاق خناق % % 20(@)(@@) % أترون بعد صنيعكم يرجى لكم % % أبدا خلاص أو يحل وثاق % % PageV01P114 21(@)(@@) % يا رب جرعهم بعدلك غب ما % % قد جرعوه أقاربي وأذاقوا % % PageV01P115 البحر : - 1(@)(@@) % أيغنيك دمع أنت في الربع ساكبه % % وقد رحلت غزلانه ورباربه % % 2(@)(@@) % تهون أمر الحب مدعيا له % % وما الحب أهل أن يهون جانبه % % 3(@)(@@) % لكل محب كأس هجر وفرقة % % فإن تصدق الدعوى فإنك شاربه % % 4(@)(@@) % عجبت لصب يستلذ معاشه % % وقد ذهبت أحبابه وحبائبه % % 5(@)(@@) % فلا حب مهما لم يبت وهو في الهوى % % قريح المآقي ذاهل القلب ذاهبه % % 6(@)(@@) % ومكتئب يشكو الزمان وقد غدت % % مشارقه مسلوكة ومغاربه % % 7(@)(@@) % وملتزم الأوطان يشكو همومه % % وقد ضمنت تفريجهن ركائبه % % 8(@)(@@) % فشق أديم الخافقين مجردا % % من العزم سيفا لا تكل مضاربه % % 9(@)(@@) % وحسبك أدراع من الصبر إنها % % لتحمد في جلى الخطوب عواقبه % % 10(@)(@@) % فأي لئيم ما الزمان مسالم % % له وكريم ما الزمان محاربه % % PageV01P116 11(@)(@@) % فلا كان من دهر به قد تسودت % % على الأسد في آجامهن ثعالبه % % 12(@)(@@) % كفى بالنبي المصطفى وبآله % % فهل بعدهم تصفو لحر مشاربه % % 13(@)(@@) % دعا كل باغ في الأنام ومعتد % % إلى حربهم والدهر جم عجائبه % % 14(@)(@@) % فكم غادر أبدى السخائم واغتدت % % تنوشهم أظفاره ومخالبه % % 15(@)(@@) % سيلقون يوم الحشر غب فعالهم % % وكل امرء 
ms24	 يجزى بما هو كاسبه % % 16(@)(@@) % أهين أبو السبطين فيهم وفاطم % % وأهمل من حق القرابة وأجبه % % 17(@)(@@) % تجاروا على ظلم الوصي وربما % % تجارى على الرحمن من لا يراقبه % % 18(@)(@@) % ولم يرجعوا ميراث بنت محمد % % وقد يرجع المغصوب من هو غاصبه % % 19(@)(@@) % فما كان أدنى ما أذوها بأخذ ما % % أبوها لها دون البرية واهبه % % PageV01P117 البحر : - 1(@)(@@) % % % 2(@)(@@) % أما لو درى يوم الفعلية ما جنى % % لشابت من الأمر الفظيع ذوائبه % % 3(@)(@@) % أغير علي كان بعد محمد % % له كاهل المجد الأثيل وغاربه % % 4(@)(@@) % ومن بعد طه كان أولى بإرثه % % أأصحابه قولوا لنا أم أقاربه % % 5(@)(@@) % وشتان بين البيعتين لمنصف % % إذا أعطي الإنصاف من هو طالبه % % 6(@)(@@) % فبيعة هذا أحكم الله عقدها % % وبيعة ذاكم فلتة قال صاحبه % % 7(@)(@@) % فلا تدعوا إجماع أمة أحمد % % فأكثر ممن شاهد الأمر غائبه % % PageV01P118 البحر : - 1(@)(@@) % % % PageV01P119 البحر : - 1(@)(@@) % % % 2(@)(@@) % وقام ابن حرب بعدهم فتضعضعت قوى الدين وانهدت لذاك جوانبه % . . . % 3(@)(@@) % فقاد إلى حرب الوصي كتائبا % % ولم تغنه عند النزال كتائبه % % 4(@)(@@) % وما زال حتى جرع الحسن الردى % % ودبت إليه بالسموم عقاربه % % 5(@)(@@) % وما أنس لا أنس الشهيد بكربلاء % % وهيهات إني ما حييت لناديه % % 6(@)(@@) % سبوا بعد قتل ابن النبي حريمه % % وما بليت تحت التراب ترائبه % % 7(@)(@@) % وبات يزيد في سرور ولو درى % % بما قد جرى قامت عليه نوادبه % % 8(@)(@@) % وحسبك من زيد فخارا وسؤددا % % تزاحم هامات النجوم مناكبه % % 9(@)(@@) % مضى في رجال صالحين تحكمت % % عوالي هشام فيهم وقواضبه % % 10(@)(@@) % ويحي بن زيد جللوه بقسطل % % من النفع تهمي بالمنون سحائبه % % PageV01P120 11(@)(@@) % وصاحب فخ صبحته وقومه % % عساكر موسى جهرة وعصائبه % % 12(@)(@@) % وكم قتلوا من آل أحمد سيدا % % إماما زكت أعراقه ومناقبه % % 13(@)(@@) % فلم لا تمور الأرض حزنا وكيف لا % % من الفلك الدوار تهوي كواكبه % % 14(@)(@@) % وكل مصاب نال آل محمد % % فليس سوى يوم السقيفة جالبه % % PageV01P121 البحر : - 1(@)(@@) % % % 2(@)(@@) % أيبطل ذحل والنبي وليه % % ويهمل وتر والمهيمن طالبه % % 3(@)(@@) % فهذا اعتقادي ما حييت ومذهبي % % إذا اضطربت بالناصبي مذاهبه % % PageV01P122 البحر : - 1(@)(@@) % يا دار سلمى بسفح ذي 
ms25	 سلم حياك % % حياك واكف الديم % % 2(@)(@@) % نداء صب لا يستجاب له % % وغير مجد نداء ذا صمم % % 3(@)(@@) % أين الألى أقفروك وارتحلوا % % وأوحشوا الربع بعد أنسهم % % 4(@)(@@) % أنأتهم عنك أينق رسم % % مالي وما للأيانق الرسم % % 5(@)(@@) % سرت بمن لو بدت لبدر دجى % % في تمه لاستجن في الظلم % % 6(@)(@@) % مريضة الجفن لحظ مقلتها % % يحل صيد القلوب في الحرم % % 7(@)(@@) % كتمت منها خوف الوشاة هوى % % أصبح بالدمع غير منكتم % % 8(@)(@@) % وجاهل بي يلومني سفها % % ولو درى ما أجن لم يلم % % 9(@)(@@) % أوقفني ما رآه من غزلي % % ومن نسيبي مواقف التهم % % 10(@)(@@) % أستغفر الله لم يكن أبدا % % سلوك وادي الغرام من شيمي % % PageV01P123 11(@)(@@) % وقد أقول النسيب مفتتحا % % مدحا وليس النسيب من هممي % % 12(@)(@@) % هيهات قلبي ما دام يصحبني % % بغير آل النبي لم يهم % % 13(@)(@@) % لا كنت لا كنت إن جرى أبدا % % بمدح قوم سواهم قلمي % % 14(@)(@@) % إن قلت مدحا ففيهم وإذا % % أقسمت يوما فإنهم قسمي % % 15(@)(@@) % حسبهم أن يكون فضلهم % % في الناس فضل الشفا على الألم % % 16(@)(@@) % قد عدل الله في بريته % % والله في العدل غير متهم % % 17(@)(@@) % إذ خص خير الورى وعترته % % من كل فضل بأوفر القسم % % 18(@)(@@) % لو قلت ما قلت فيهم قصرت % % عن عشر معشار فضلهم كلمي % % 19(@)(@@) % وحقهم ما أبره قسما % % وما أحيلا وحقهم بفمي % % 20(@)(@@) % لا حلت عن ودهم ولو تلفت % % روحي في ذاك أو أريق دمي % % PageV01P124 21(@)(@@) % حبهم شيمتي ومعتقدي % % ومذهبي في الورى وملتزمي % % 22(@)(@@) % وهو جوازي على الصراط إذا % % زلت بما قد جنيته قدمي % % 23(@)(@@) % لا يبعد الله غير زعنفة % % من كل رجس عن الرشاد عمي % % 24(@)(@@) % قد كتموا من سنا فضائلهم % % ما لم يكن نوره بمنكتم % % 25(@)(@@) % وأسسوا ظلمهم فكم هتكت % % من حرم للنبي في الحرم % % 26(@)(@@) % واستوجسوا من عقاب خالقهم % % ما أوعدوا في قطيعة الرحم % % 27(@)(@@) % وحللوا عقد عهد أفضل من % % وصى بحفظ العهود والذمم % % 28(@)(@@) % وزحزحوا منصب الإمامة عن % % معدن فصل الخطاب والحكم % % PageV01P125 البحر : - 1(@)(@@) % % % 2(@)(@@) % أكان من لم يسجد إلى صنم % % أولى بميراث 
ms26	 سيد الأمم % % 3(@)(@@) % أم الذي ما انحنى لخالقه % % حتى انحنى في السجود للصنم % % 4(@)(@@) % أف لها إمرة مضت عجلا % % دامت مراراتها ولم تدم % % 5(@)(@@) % ذاك متاع الغرور حين مضى % % مضى بلا توبة ولا ندم % % 6(@)(@@) % وعارض أقشعت سحابته % % كأنما أبصروه في الحلم % % 7(@)(@@) % نفسي فداء الغرى إن به % % خير إمام مشى على قدم % % 8(@)(@@) % نفسي فداء الغري إن به % % من لا يسامى في القدر والعظم % % 9(@)(@@) % نفسي فداء الغري من بلد % % ما ضم من سؤدد ومن كرم % % 10(@)(@@) % نفسي فداء الغري من بلد % % ما ضم من سؤدد ومن كرم % % PageV01P126 11(@)(@@) % نفسي فدى من ثوى به فلقد % % ثوت به المكرمات عن أمم % % 12(@)(@@) % يا تربة قد حوت له رمما % % بوركت من تربة ومن رمم % % 13(@)(@@) % ليس سوى طيبة تفوقك في الفضل فتيهي ما شئت واحتكمي % . . . % 14(@)(@@) % ففيك كشاف كل نازلة % % عن البرايا وفارج الغمم % % 15(@)(@@) % ومن إذا الحرب أضرمت لهبا % % لم يتأخر عنها ولم يخم % % 16(@)(@@) % قطب رحاها إذا الكماة بها % % بين قتيل وبين منهزم % % 17(@)(@@) % من نام في مرقد النبي دجى % % وأعين المشركين لم تنم % % 18(@)(@@) % فداه بالنفس لم يخف أبدا % % ما دبروا من عظيم كيدهم % % 19(@)(@@) % يا سيد الأوصياء دعوة من % % إن هام شوقا إليك لم يلم % % 20(@)(@@) % أنت ملاذي في كل نائبة % % أنت عياذي وأنت معتصمي % % PageV01P127 21(@)(@@) % بك استفام الهدى وقام ولو % % لا أنت لم يستقم ولم يقم % % 22(@)(@@) % وسابق العالمين أنت إلى % % كل محل في الفضل لم يرم % % 23(@)(@@) % ونفس خير الأنام أنت فمن % % مثلك في العالمين كلهم % % 24(@)(@@) % كم رتبة في الفخار سامية % % بلغتها قبل مبلغ الحلم % % 25(@)(@@) % فكيف يخفى ما فيك من كرم % % ومن خلال غر ومن شيم % % PageV01P128 البحر : - 1(@)(@@) % % % 2(@)(@@) % وخالفوا النص فيك وهو سنى % % كالبدر يجلو حنادس الظلم % % 3(@)(@@) % وستروا من علاك ما علموا % % وهي لعمري نار على علم % % 4(@)(@@) % راموا انتقاما بالثار منك كما % % قتلت منهم في الله كل كمي % % 5(@)(@@) % فحين لا ناصر لجأت إلى % % خير عزيز وخير منتقم % % 6(@)(@@) % سينصف 
ms27	 الله من عداك وما % % أعدل رب العباد من حكم % % PageV01P129 البحر : - 1(@)(@@) % حتام عن جهل تلوم % % مهلا فإن اللوم لوم % % 2(@)(@@) % طرفي الذي يشكو السهاد % % وقلبي المضنى الكليم % % 3(@)(@@) % إن الشقا في الحب عند العاشقين هو النعيم % . . . % 4(@)(@@) % ما الحب إلا مقلة % % عبراء أو جسم سقيم % % 5(@)(@@) % وبلابل بين الجوانح لا تنام ولا تنيم % . . . % 6(@)(@@) % يا من أكتم حبه % % والله بي وبه عليم % % 7(@)(@@) % ما لي وما للوائمي % % أعليك ذو عقل يلوم % % 8(@)(@@) % يا هل تراه يعود لي % % بك ذلك الزمن القديم % % 9(@)(@@) % وهني عيش با للوى % % لو أن عيش هنى يدوم % % 10(@)(@@) % وبرامة إذ نلت من % % وصل الأحبة ما أروم % % PageV01P130 11(@)(@@) % يا حبذا تلك الربوع وحبذا تلك الرسوم % . . . % 12(@)(@@) % يا تاركين بمهجتي % % شررا يذوب له الجحيم % % 13(@)(@@) % طال المطال ولم يهب لصدق وعدكم نسيم % . . . % 14(@)(@@) % مطل الغني غريمه حاشاكم خلق ذميم % . . . % 15(@)(@@) % أيخاف طول المطل من % % أهل الغري له غريم % % 16(@)(@@) % بأبي وبي ذاك المحل ومن بتربته مقيم % . . . % 17(@)(@@) % يا ليت شعري هل إلى % % تلك المواطن لي قدوم % % 18(@)(@@) % ومتى أنال بهن من % % تعفير خدي ما أروم % % 19(@)(@@) % ومتى أراني خادما % % بإزاء تربته أقوم % % 20(@)(@@) % حياك قبرا بالغري من الحيا هطل سجوم % . . . % PageV01P131 21(@)(@@) % يا قبر فيك المرتضى % % والسيد السند الكريم % % 22(@)(@@) % فيك الوصي أخو النبي المختار والنبأ العظيم % . . . % 23(@)(@@) % فيك النجاة من الردى % % فيك الصراط المستقيم % % 24(@)(@@) % فيك الموازر والمواخي والمواسي والحميم % . . . % 25(@)(@@) % فيك الشجاعة والندى % % والعلم والدين القويم % % 26(@)(@@) % فيك المكارم والعلا % % والمجد والشرف الصميم % % 27(@)(@@) % فيك الإمامة والزعامة والكرامة لا تريم % . . . % 28(@)(@@) % فيك الذي يشفى بترب نعاله الطرف السقيم % . . . % 29(@)(@@) % فيك الذي لو أنصفت % % لهوت لمصرعه النجوم % % 30(@)(@@) % فيك الذي كانت تحاذر بأسه الصيد القروم % . . . % PageV01P132 31(@)(@@) % فيك الذي كانت تخف لهول موقفه الحلوم % . . . % 32(@)(@@) % فيك الخصيم عن المهيمن يوم تجتمع الخصوم % . . . % 33(@)(@@) % لمحبه دار البقا % % ولمن يعاديه الجحيم % % 34(@)(@@) % من ذا سواه لهذه % % ولتلك في الأخرى قسيم % % PageV01P133 البحر : - 1(@)(@@) % % % 2(@)(@@) % صرفته أرباب الشقا % % عما حباه به العليم % % 3 
ms28	(@)(@@) % لم ترع تلك المكرمات % % وذلك السبق القديم % % 4(@)(@@) % خذها أمير المؤمنين % % كما زها الدر النظيم % % 5(@)(@@) % كالروض باكره الحيا % % وتخطرت فيه النسيم % % 6(@)(@@) % عذراء لم يفتضها % % أهل الحجاز ولا تميم % % 7(@)(@@) % من مخلص لك لم تخالجه الشكوك ولا الوهوم % . . . % 8(@)(@@) % واعذر فكل مفوه % % لسن بحقك لا يقوم % % 9(@)(@@) % من ذا يفي بعظيم حقك إنه الحق العظيم % . . . % 10(@)(@@) % فأجزه واقبل عذره % % فالعذر يقبله الكريم % % PageV01P134 11(@)(@@) % واشفع له إذ ليس ينفعه الصديق ولا الحميم % . . . % 12(@)(@@) % فعساه يظفر من رضى % % رب الأنام بما يروم % % PageV01P135 البحر : - 1(@)(@@) % لحيدرة الفضل دون الورى % % على أقرب الناس والأبعد % % 2(@)(@@) % فدن بمحبته إن من % % يدن بمحبته يرشد % % 3(@)(@@) % أخو المصطفى وخدين الهدى % % وهادي البرية والمهتدي % % 4(@)(@@) % إذا ما دجت ظلم المشكلات جلى دجى ليلها الأسود % . . . % 5(@)(@@) % ومهما ينادي لأكرومة % % فناهيك بالعلم المفرد % % 6(@)(@@) % وحسبك من فضله أنه % % لغير المهيمن لم يسجد % % 7(@)(@@) % وأن من المصطفى صنوه % % لفي ذروة الشرف الأتلد % % 8(@)(@@) % أبن لي من فاز دون الورى % % بنص الإمامة من أحمد % % 9(@)(@@) % حباه الإمامة من بعده % % وكانا من الناس في مشهد % % 10(@)(@@) % ومن ذا سواه يرى قائما % % على الحوض يسقي الورى عن يد % % PageV01P136 11(@)(@@) % ومن ذا غدا حبه في الورى % % دليلا على شرف المولد % % 12(@)(@@) % ونفس الرسول بنص الكتاب وما النفس كالصاحب الأبعد % . . . % 13(@)(@@) % ومن نام في مرقد المصطفى % % وعين أولي الغدر لم ترقد % % 14(@)(@@) % وأهوى العقاب إلى نعله % % ليدفع عنه أذى الأسود % % 15(@)(@@) % وفي الصوح من شب نار الوغى % % وقد أحجم الناس من عن يد % % 16(@)(@@) % وعمرو غداة دعا للقا % % أتيم له برزت أم عدي أبينوا لنا ويلكم إنني أرى الحق أبلج للمهتدي % % 17(@)(@@) % حسدتم عليا على فضله % % ومن نال ما ناله يحسد % % 18(@)(@@) % وخالفتموه بأهوائكم % % خلاف العبيد على السيد % % 19(@)(@@) % وأنكرتمو من سنا فضله % % ضياءا أناف على الفرقد % % 20(@)(@@) % ولا عار للشمس إن أنكرت % % سنا ضوءها مقلة الأرمد % % PageV01P137 21(@)(@@) % فهلا وقد رمتمو شأوه % % سبقتم إلى غاية السؤدد % % 22(@)(@@) % وهل جنب منكم غيره % % أحل له اللبث في 
ms29	 المسجد % % PageV01P138 البحر : - 1(@)(@@) % قد آن آن تلوي العنان وتقصرا % % أوما كفاك الشيب ويحك منذرا % % 2(@)(@@) % كم ذا يعيد لك الصبا مر الصبا % % مهما سرى والبرق وهنا إن شرى % % 3(@)(@@) % حتام لا ينفك قلبك دائما % % لهوى الغواني موردا أو مصدرا % % 4(@)(@@) % وإلام يعذلك المناصح مشفقا % % فتقول دعني ليس إلا ما ترى % % 5(@)(@@) % وإلى متى تزداد من مقل الظبا % % وخدودهن تدلها وتحيرا % % 6(@)(@@) % ولكم تذوب تشوقا وصبابة % % وتظل تجري من عيونك أنهرا % % 7(@)(@@) % أضحى حديث غدير دمعك شهرة % % يحكي حديث غدير خم في الورى % % 8(@)(@@) % أكرم به من منزل في ظله % % نصب المهيمن للإمامة حيدرا % % 9(@)(@@) % نص النبي بها إذا عن أمره % % في حيدر نصا جليا نيرا % % 10(@)(@@) % إذ قام في لفح الهجيرة رافعا % % يده لأمر ما أقام وهجرا % % PageV01P139 11(@)(@@) % صنو النبي محمد ووصيه % % وأبو سليليه شبير وشبرا % % 12(@)(@@) % من ذا سواه من البرية كلها % % زكى بخاتمه ومد الخنصرا % % 13(@)(@@) % من غيره ردت له شمس الضحى % % وكفاه فضلا في الأنام ومفخرا % % 14(@)(@@) % من قام في ذات الإله مجاهدا % % ولحصد أعداء الإله مشمرا % % 15(@)(@@) % من نام فوق فراش طه غيره % % مزملا في برده مدثرا % % 16(@)(@@) % من قط في بدر رؤوس حماتها % % حتى علا بدر اليقين وأسفرا % % 17(@)(@@) % من قد في أحد ورود كماتها % % إذ قهقر الأسد الكمي وأدبرا % % 18(@)(@@) % من في حنين كان ليث نزالها % % والصيد قد رجعت هناك إلى الورى % % 19(@)(@@) % من كان فاتح خيبر إذ أدبرت % % عنها الثلاثة سل بذلك خيبرا % % 20(@)(@@) % من ذا بها المختار أعطاه اللوا % % هل كان ذلك حيدرا أم حبترا % % PageV01P140 21(@)(@@) % أفهل بقى عذر لمن عرف الهدى % % ثم انثنى عن نهجه وتغيرا % % 22(@)(@@) % لا يبعد الرحمن إلا عصبة % % ضلت وأخطأت السبيل الأنورا % % 23(@)(@@) % نبذوا كتاب الله خلف ظهورهم % % ليخالفوا النص الجلي الأظهرا % % 24(@)(@@) % والله لو تركوا الإمامة حيثما % % جعلت لما فرعت أمية منبرا % % PageV01P141 البحر : - 1(@)(@@) % % % PageV01P142 @ 4 47 @ PageV01P143 @ 4 48 @ PageV01P144 @ 9 94 @ PageV01P145 @ 9 95 @ PageV01P146 @ 9 96 @ PageV01P147 البحر : - 1(@)(@@) % ألا تعجبن لعمرو وقد % % رمى بالدعابة خير البشر % % 2(@)(@@) % ولم 
ms30	 يخترعها ولكنه % % تلقفها عن أخيه عمر % % PageV01P148 البحر : - 1(@)(@@) % % % PageV01P149 @ 9 99 @ PageV01P150 @ 1 100 0 @ @ PageV01P151 @ 1 101 1 @ @ PageV01P152 البحر : - 1(@)(@@) % قالوا ذكرت أبا بكر فقلت لهم % % لا غافلا أبدا عنه ولا لاهي % % 2(@)(@@) % قالوا كذاك أبا حفص وصاحبه % % عثمان قلت نعم والحمد لله % % PageV01P153 البحر : - 1(@)(@@) % قالوا أتنكر ذكر الشيخ قلت لهم % % لا منكر ذكره يوما ولا ناهي % % 2(@)(@@) % وإن ذكر أبي حفص وصاحبه % % عثمان يعلو به يوم اللقا جاهي % % PageV01P154 البحر : - 1(@)(@@) % % % PageV01P155 @ 1 105 5 @ @ PageV01P156 @ 1 106 6 @ @ PageV01P157 @ 1 107 7 @ @ PageV01P158 @ 1 108 8 @ @ PageV01P159 البحر : - 1(@)(@@) % إني رضيت عليا % % دون البرايا إماما % % 2(@)(@@) % الحمد لله إني % % ما كنت ممن تعامى % % PageV01P160 البحر : - 1(@)(@@) % عجبت من الفعلاء إذ حديت بها % % إلى حرب خير الأوصياء الطلائح أتت نحوه ركضا يحف برحلها من القوم غاد في الفعال ورائح % % 2(@)(@@) % وقد أمرت أن لا تفارق بيتها % % فسارت لأبطال الحروب تكافح % % 3(@)(@@) % توبخها حتى الكلاب لفعلها % % وتنصح لو أجدت هناك النصائح % % 4(@)(@@) % فيا عجبا ممن يحسن فعلها % % وقد لامها حتى الكلاب النوابح % % PageV01P161 البحر : - 1(@)(@@) % يا أخا المصطفى الذي % % لسماء العلى سمك % % 2(@)(@@) % بأبي أنت ما أجلك % % قدرا وأعظمك % % PageV01P162 البحر : - 1(@)(@@) % % % PageV01P163 البحر : - 1(@)(@@) % % % 2(@)(@@) % ذلك الجور والشقاق % % استحلوا به دمك % % 3(@)(@@) % حسدا منهم لنص به الله أكرمك % . . . % 4(@)(@@) % فلذاك ابن ملجم % % بشبا السيف ألجمك % % PageV01P164 البحر : - 1(@)(@@) % أبعد مديح جدكم % % أرى أني أوفيكم % % 2(@)(@@) % تركت مديحكم من أجل % % إني تارك فيكم % % 3(@)(@@) % ولكني لمحض الود % % دون الناس أصفيكم % % PageV01P165 البحر : - 1(@)(@@) % وافاك يصحبه الإسعاد والظفر % % عيد به سحب الإقبال تنهمر % % 2(@)(@@) % فالبس به حلل المجد المؤثل لا % % يعرو فؤادك لا بؤس ولا ضجر % % 3(@)(@@) % واحكم مطاعا بما تهوى على زمن % % أيام ملكك في أيامه غرر % % 4(@)(@@) % واستقبل الملك مخضرا جوانبه % % يزهو ويزهر حسنا عطفه النضر % % 5(@)(@@) % ولا برحت قرير العين ممتدحا % % تأتي إليك الأماني وهي تعتذر % % 6(@)(@@) % يعنو لفضلك من في أنفه شمم % % طوعا ويسجد من في خده صعر % % 7(@)(@@) % ترقى إلى فلك العلياء مرتفعا % % عزا ويجري على ما تشتهي القدر % % 8 
ms31	(@)(@@) % الحمد لله وجه السعد مقتبل % % كما تشاء وقلب النحس منكسر % % 9(@)(@@) % يا نعمة بك لا نسطيع نشكرها % % في جنبها سيئات الدهر تغتفر % % 10(@)(@@) % أخفيت ذكر ملوك الأرض قاطبة % % إن الكواكب يخفي ضوءها القمر % % PageV01P166 11(@)(@@) % تكبو جياد المعالي دون غايتها % % وأنت تبلغ أقصاها وتنتظر % % 12(@)(@@) % وكيف يدرك ما أصبحت مدركه % % بطول باعك من في باعه قصر % % 13(@)(@@) % والناس دونك جسم لا حياة به % % وأنت روح العلى والسمع والبصر % % 14(@)(@@) % وكل معنى فخيم منك مكتسب % % منك المعاني ومن أقرانك الصور % % 15(@)(@@) % كادت تحكاكيك كف المزن هاطلة % % والبحر جودا ويحكي خلقك الزهر % % 16(@)(@@) % هيهات هيهات وجه الفرق متضح % % والصبح لا يختفي عمن له نظر % % 17(@)(@@) % أيشبه البحر والأنوا يديك وقد % % جادت وما كان لا بحر ولا مطر % % 18(@)(@@) % قل للمغالين في العلياء حسبكم % % فقد حمى سوحها الصمصامة الهصر % % 19(@)(@@) % وقد تكفل أرزاق الورى ملك % % مسود في يديه النفع والضرر % % 20(@)(@@) % لا تكثروا في اكتساب الفخر سعيكم % % فما لغير إمام الحق مفتحر % % PageV01P167 21(@)(@@) % وخلفوا البيض في الأجفان مغمدة % % فإنها لسواه ليس تأتمر % % 22(@)(@@) % ملك يجود وكف القطر حابسة % % ويستهل ونار الحرب تستعر % % 23(@)(@@) % أيام دولته غر محجلة % % على معاطفها من عدله حير % % 24(@)(@@) % لو لاذت الغيد من خوف المشيب به % % إذا لما مسهن الشيب والكبر % % 25(@)(@@) % لو كان صارمه عونا لفاطمة % % لم يغتصبها أبو بكر ولا عمر % % 26(@)(@@) % يا جنة الخلد وافاها الورى فرأوا % % فوق الذي سمعوا منها الذي نظروا % % 27(@)(@@) % رأتك فوق ادعاء المسع أعينهم % % ورب خبر لديه يصغر الخبر % % 28(@)(@@) % ما زلت سيفا لدين الله منصلتا % % إذا تقلده الإسلام ينتصر % % 29(@)(@@) % كم معشر نقضوا ميثاقهم وبغوا % % أذقتهم غب ما خانوا وما غدروا % % 30(@)(@@) % جاؤا لحربك من خوف ومن حذر % % كذا على الأسد خوفا تقدم الحمر % % PageV01P168 31(@)(@@) % قتلت حاضرهم ضربا وغائبهم % % خوفا فسيان إن غابوا وإن حضروا % % 32(@)(@@) % أصليتهم جمرات من سيوفك لا % % تبقى على أحد منهم ولا تذر % % 33(@)(@@) % نغصت في هذه الدنيا معيشتهم % % ومستقرهم من بعدها سقر % % 34(@)(@@) % فروا حذارا وهل 
ms32	 يثنيك ويلهم % % فرارهم عنك أو يغنيهم الحذر % % 35(@)(@@) % شردتهم في الفلا حتى لو اعترضت % % لهم جهنم في نيرانها عبروا % % 36(@)(@@) % ودوا وحاشاك أن ترضى ومن لهم % % أن يجعلوا لك ما صلوا وما نحروا % % 37(@)(@@) % وهكذا لم تزل في كل ملحمة % % غراء يسعدك الإقبال والظفر % % 38(@)(@@) % حتى أضاء محيا الدين مبتلجا % % وزال عن مقلتيه السوء والضرر % % 39(@)(@@) % يا ناثر الدر إن وافاه ممتدح % % ومن لتاج علاه تنظم الدرر % % 40(@)(@@) % قد حبر الناس فيك المدح واجتهدوا % % وعنك قصر ما قالوا وما شعروا % % PageV01P169 41(@)(@@) % وقد مدحت بآي الذكر محكمة % % فما عسى قدر ما تأتي به الفكر % % 42(@)(@@) % هيهات أن يدعي حصرا لفضلك من % % قد كان يعجزه من وصفك العشر % % 43(@)(@@) % فلا تكلفهم ما لا يطاق وعذ % % بفضل صفحك واعذر إنهم بشر % % 44(@)(@@) % وانعم بمقدم عيد النحر يا ملكا % % يخاف سطوته الصمصامة الذكر % % 45(@)(@@) % وافى يجرر أذيال السرور لكي % % يفوز منك ببر ليس ينحصر % % 46(@)(@@) % واحمد إلاهك واشكره فقد وعد % % العباد منه مزيد الفضل إن شكروا % % 47(@)(@@) % واستجلها بنت فكر لا يقاس بها % % يكاد يخجل منها المندل العطر % % 48(@)(@@) % وابسط لي العذر في تركي إطالتها % % لأن كل طويل فيك مختصرا % % 49(@)(@@) % لكنها حلوة الألفاظ ما طمعت % % ربيعة أن تدانيها ولا مضر % % 50(@)(@@) % لو أنها أدركتها لم تكن أبدا % % بغيرها العرب العرباء تفتخر % % PageV01P170 51(@)(@@) % فإن تكن أنت فوق الناس قاطبة % % فإنها فوق ما قالوا وما شعروا % % 52(@)(@@) % لا زال سوحك معمورا ولا برحت % % سحب الصلاة على ناديك تنهمر % % 53(@)(@@) % بعد النبي المصطفى الهادي وعترته % % ما لاح برق شرى أو ما سرى قمر % % PageV01P171 البحر : - 1(@)(@@) % لكسب العلى فاجعل همومك تحمد % % وتجن ثمار الشكر من روضها الندي % % 2(@)(@@) % وما المرؤ إلا من يخلد ذكره % % فما اسطعت من ذكر جميل فخلد % % 3(@)(@@) % بيومك فاحفل إن أمسك قد مضى % % ولم تدر ما يقضي المهيمن في غد % % 4(@)(@@) % سأسلك من سبل المعالي محجة % % أبي لي سواها طيب أصلي ومحتدي % % 5(@)(@@) % وقل لعمري في المعالي لو أنني % % أجوب إليها فدفدا بعد 
ms33	 فدفد % % 6(@)(@@) % تركت الهوى من قبل أن أعرف الهوى % % فنام وشاتي واستراح مفندي % % 7(@)(@@) % فما خطرت يوما ببالي بلابل % % ولا بت منها رب طرف مسهد % % 8(@)(@@) % فلا كنت إن ملكت يوما يد الهوى % % زمامي وأعطيت الصبابة مقودي % % 9(@)(@@) % أبي الله أن أسلو عن المجد والعلى % % بقد نضير أو بخد مورد % % 10(@)(@@) % وإن تزدهيني والتقى لي رادع % % معاطف خود أو سوالف أغيد % % PageV01P172 11(@)(@@) % وإني وإن أزرى بي الفقر وانتحت % % علي الليالي بالمصائب عن يد % % 12(@)(@@) % فما أنا من روح الاله بآيس % % وإن جاءني ما لم يطقه تجلدي % % 13(@)(@@) % سأدرؤ في نحر الخطوب إذا عدت % % بأروع من أبناء أحمد أصيد % % 14(@)(@@) % بأسمح من تثني العناصر باسمه % % وخير إمام قام من آل أحمد % % 15(@)(@@) % إمام حمى الإسلام عن كل ملحد % % وألف منه عقد شمل مبدد % % 16(@)(@@) % أقام قناة الدين بعد اعوجاجها % % وقال لباغيها كفيتك فاقعد % % 17(@)(@@) % بسعد على مر الزمان مساعد % % وجد على طول المدى متجدد % % 18(@)(@@) % وكل طويل القد أسمر ذابل % % وكل رقيق الشفرتين مهند % % 19(@)(@@) % وأزرق من طبع المنية نافذ % % وذي شرة من نسل أعوج أجرد % % 20(@)(@@) % فلو كان في وقت الوصي حسامه % % لما طمعت في الأمر تيم ولا عدي % % PageV01P173 البحر : - 1(@)(@@) % % % 2(@)(@@) % لقد بشر الإقبال يوم ولاده % % بأشرف مولد لأسعد مولد % % 3(@)(@@) % وقد زينت الأيام منه بسيد % % تقرضه المداح في كل مشهد % % 4(@)(@@) % وأروع يمضي فعله قبل قوله % % إذا جاد لا يصغي لرأي مفند % % 5(@)(@@) % به كل بدر زاهر الأوج يهتدي % % وكل خضم زاخر الموج يقتدي % % 6(@)(@@) % تمثله الأبطال في كل معرك % % وتدعو له النساك في كل مسجد % % 7(@)(@@) % يعانق قد الرمح في الحرب أسمرا % % ويصبو إلى خد الحسام المورد % % 8(@)(@@) % ويغني عن البيض الصوارم والقنا % % بأبيض من آرائه غير مغمد % % 9(@)(@@) % ولا ينتهي جدوى يديه لغاية % % ومهما انتهى من غاية فيه يبتدي % % 10(@)(@@) % لأعطى إلى أن مل سائله العطا % % وكاد يقول المستميح له قد % % PageV01P174 11(@)(@@) % وأغنى الورى طرا فأصبح سيدا % % لكل مسود منهم ومسود % % 12(@)(@@) % ورام الحيا يحكيه قلت 
ms34	 له اتئد % % أترمي إلى شأو من المجد أبعد % % 13(@)(@@) % فبينكما في الجود أي تفاوت % % فأقصر عن السير السريع وأقصد % % 14(@)(@@) % فأنت تروي هذه دون هذه % % وهذا يروي ساحة الأرض عن يد % % 15(@)(@@) % وتفقد أحيانا على حين حاجة % % ولم يخل أحوال الورى ن تفقد % % 16(@)(@@) % وأنت بإخلاف المواعيد في الورى % % عرفت ولم يعرف بإخلاف موعد % % 17(@)(@@) % ويطلق كفيه وأنت مقيد % % وما مطلق في فعله كمقيد % % 18(@)(@@) % ونارك شر وهو إن جئت ناره % % تجد خير نار عندها خير موقد % % 19(@)(@@) % ومن عنه تروي الجود قل لي فإنه % % إذا جاد يروي عن أبيه محمد % % 20(@)(@@) % فصل وسلم خلف سابق جوده % % وقبل ثرى أرض بها حل واسجد % % PageV01P175 21(@)(@@) % فسلم لما استوضح الأمر وانثنى % % بأدمع محزون وأنفاس مكمد % % 22(@)(@@) % ومن كأمير المؤمنين لمفخر % % أصيل ومعروف جزيل وسؤدد % % 23(@)(@@) % ومن كأمير المؤمنين لعزمة % % يحوط بها الإسلام عن كل ملحد % % 24(@)(@@) % إليك عقيد المكرمات قصيدة % % كمنتظم العقد الفريد المنضد % % 25(@)(@@) % ألذ مذاقا من جنى النحل ذوقها % % وأطرب من رجع الهزار المغرد % % 26(@)(@@) % أتتك على بعد الديار وإنما % % إليك بأنوار الخلافة تهتدي % % 27(@)(@@) % أما والعلى إن القصائد أسهم % % متى ترم أغراض المقاصد تقصد % % 28(@)(@@) % وأنت لعمر الله أولى بعقدها % % وأحرى به من كل جيد مقلد % % 29(@)(@@) % فإنك لي ركني الأشد وعدتي % % وكعبة آمالي وقبله مقصدي % % 30(@)(@@) % وأنت الذي يهدي لك المدح والثنا % % ولولاك لم يحفل به كل منشد % % PageV01P176 31(@)(@@) % تهن بهذا العيد لا زال عائدا % % عليك بإقبال وعز مؤبد ولازالت الأفواه من كل ناظم تهنيك بالمجد الرفيع المشيد % % 32(@)(@@) % وسمعا أمير المؤمنين فإنني % % دعوتك للطرف القريح المسهد % % 33(@)(@@) % تنمر لي دهري فكن أنت ناصري % % وأسلمني حظي فكن أنت منجدي % % 34(@)(@@) % فإن أنت لم تقمع زماني يعتدي % % وإن لم تنبه طرف حظي يرقد % % 35(@)(@@) % وإن بعدت عن رأي عينك فاقتي % % فإن افتقاري من نداك بمشهد % % 36(@)(@@) % وأشكوك دينا أثقل الظهر حمله % % فحالي إذا حال الطريد المشرد % % 37(@)(@@) % وقد ضمنت عنك الأماني قضاءه % % فأنجز مواعيد الأماني وأنجد % % 38(@)(@@) % ودم وابق 
ms35	 في عز منيع ومقعد % % رفيع وإفضال تروح وتغتدي % % 39(@)(@@) % وصلى عليك الله بعد محمد % % نبي الهدى المختار والآل عن يد % % PageV01P177 البحر : - 1(@)(@@) % كم ذا يذوب أسى وكم يتجلد % % أين المعين له وأين المسعد % % 2(@)(@@) % أأهيل وادي المنحنى وحياتكم % % إني على ما تعهدون وأعهد % % 3(@)(@@) % لا تنكروا كلفي بكم وصبابتي % % هذا الضنى ودموع عيني تشهد % % 4(@)(@@) % ما خان قلبي عهدكم أبدا ولا % % مدت لسلواني إلى صبري يد % % 5(@)(@@) % أأخونكم وأود قوما غيركم % % أنى وعهدكم لدي مؤكد % % 6(@)(@@) % يا هاجرين وليس لي ذنب سوى % % دمع يفيض ولوعة تتجدد % % 7(@)(@@) % ومحملي الصب الكئيب صبابة % % بين الجوانح حرها لا يبرد % % 8(@)(@@) % أكذا يكون جزاء من حفظ الهوى % % ورعى عهودكم يهان ويبعد % % 9(@)(@@) % وبمهجتي الرشأ الذي من خده % % في كل قلب جمرة تتوقد % % 10(@)(@@) % الطرف منه مهند والخد منه % % مورد والجيد منه مقلد % % PageV01P178 11(@)(@@) % يمسي ويصبح آمنا في سربه % % وأخاف وهو القاتل المتعمد % % 12(@)(@@) % يسبي القلوب بمقلة سحارة % % هاروت فتنتها يحل ويعقد % % 13(@)(@@) % وبقامة ألفية فتانة % % من فوق أرداف تقيم وتقعد % % 14(@)(@@) % سكرت معاطفة بكاس رضابه % % فلها اعتدال تارة وتأود % % 15(@)(@@) % فكأن ذكرى أحمد خطرت لها % % ولذكره يندى الجماد الجلمد % % 16(@)(@@) % يا مالك الملك العقيم ومن له % % في كل أرض أنعم لا تجحد % % 17(@)(@@) % مهلا فما فوق السماك لطالب % % قصد ولا فوق الثريا مقعد % % 18(@)(@@) % أنفقت مالك في الندى مستخلفا % % ربا خزائن فضله لا تنفد % % 19(@)(@@) % أو يمم الطلاب يم مكارم % % إلا وأنت مناهم والمقصد % % 20(@)(@@) % علما وحلما باهرا وسماحة % % فليهتدوا وليقتدوا وليجتدوا % % PageV01P179 21(@)(@@) % سجعوا بذكرك في البلاد وإنما % % طوقتهم بالمكرمات فغردوا % % 22(@)(@@) % وتعلموا منك المديح فمنك ما % % تعطيهم كرما وأنت المنشد % % 23(@)(@@) % ما سوحك المحروس إلا جنة % % لو أن من يأتي إليه يخلد % % 24(@)(@@) % ما زال سيفك منذ كان مجردا % % في غير أفئدة العدى لا يغمد % % 25(@)(@@) % ماذا أقول وكل قول قاصر % % والفضل أكثر فيك منه وأزيد % % 26(@)(@@) % الدهر من خطار رمحك خائف % % والموت من بتار سيفك يرعد % % 27(@)(@@) % كم موقف يوهي الجليد وقفته 
ms36	 % % للموت فيه توعد وتهدد % % 28(@)(@@) % ما زال عنك النصر فيه كأنما % % في الكف منك زمامه والمقود % % 29(@)(@@) % حتى تردد من رآك أأنت للفتح المبين أم السيوف تجرد % . . . % 30(@)(@@) % وهي الرماح الزاعبية أم هي الأقدار ترمي من أردت فتقصد % . . . % PageV01P180 31(@)(@@) % وهي السعادة إذ قصدت إلى الوغى % % حملتك أم سامي المقلد أجرد % % 32(@)(@@) % وهي الجيوش أم المنايا قدتها % % للحرب أم بحر خضم مزبد % % 33(@)(@@) % هيهات لا يقوى لما تأتي به % % بشر ولكن الملائك تعضد % % 34(@)(@@) % يا خير من ركب الجياد ومن له % % في الكون ألوية الولاية تعقد % % 35(@)(@@) % ذللت في الأرضين كل ممنع % % فجميع أملاك الورى لك أعبد % % 36(@)(@@) % لم يبق إلا مكة فانهض لها % % فالله جل بنصره لك منجد % % 37(@)(@@) % جرد لها أسياف عزمك إنها % % لطلوع نجمك بالسعادة ترصد % % 38(@)(@@) % والدهر فيما تبتغيه طائع % % والسعد فيما تنتحيه مسعد % % 39(@)(@@) % أيصدكم عنها أناس ما لهم % % قدم إلى العليا تسير ولا يد % % 40(@)(@@) % ولأنتم دون الورى أولى بها % % فبها مقر أبيكم والمعهد % % PageV01P181 41(@)(@@) % طهر من الترك الطغام بقاعها % % فلطال ما عاثوا هناك وأفسدوا % % 42(@)(@@) % عود عداة الله من إهلاكهم % % ما كان عودهم أبوك محمد % % 43(@)(@@) % جرد حسامك إنه في غمده % % للغيظ منهم جمرة تتوقد % % 44(@)(@@) % وأدر عليهم بالصوارم والقنا % % حربا يشيب إذا رآها الأمرد % % 45(@)(@@) % ومر الزمان بهم فإن لصرفه % % سيفا يشتت شملهم ويبدد % % 46(@)(@@) % أين المفر لهم وسيفك خلفهم % % في كل ارض أغوروا أو انجدوا % % 47(@)(@@) % إن أشهروا جهلا عليك سيوفهم % % فلسوف في الهامات منهم تغمد % % 48(@)(@@) % أو اشرعوا سمر الرماح فإنها % % لا بد في لباتهم تتفصد % % 49(@)(@@) % أو أوقدوا نار الحروب فإنها % % بدمائهم عما قريب تخمد % % 50(@)(@@) % ماذا عسى أن يوقدوا من كيدهم % % نارا وربك مطفىء ما أوقدوا % % PageV01P182 51(@)(@@) % لا تبتإس بفعالهم فلربما % % يكفيك شأنهم القضاء المرصد % % 52(@)(@@) % ما فعلهم ويد الإله عليهم % % ما فعل سيف ليس تحمله يد % % 53(@)(@@) % وهم الكلاب العاويات وإنما % % ذاقوا حلاوة حلمكم فاستأسدوا % % 54(@)(@@) % الله أسعدكم وأشقى جمعهم % % والله يشقي من يشاء ويسعد % % 55(@)(@@) % وأراد منك 
ms37	 الله جل جلاله % % من نصر هذا الدين ما تتعود % % 56(@)(@@) % ولسوف تقدح فيهم أسيافكم % % شررا لأيسره يذوب الجلمد % % 57(@)(@@) % ويقال قوم قتلوا منهم وقوم % % أوثقوا أسرا وقوم شردوا % % 58(@)(@@) % وإليكها ملك البرية مدحة % % كادت لها الشمس المنيرة تسجد % % 59(@)(@@) % من صادق في ود آل محمد % % يفنى الزمان ووده يتجدد % % 60(@)(@@) % نظما تود الغانيات لو أنها % % يوما بدر عقوده تتقلد % % PageV01P183 61(@)(@@) % يشكوك فقرا قد تحمل قلبه % % من اجله كربا تقيم وتقعد % % 62(@)(@@) % فقرا أناخ على العيال بكلكل % % وسطا فقلت لسيفه ما يولد % % 63(@)(@@) % أرسل عليه من نوالك غارة % % شعوا تفرق جيشه وتبدد % % 64(@)(@@) % وأفض علي بحار جودك منعما % % حتى يموت بغيظه من يحسد % % 65(@)(@@) % لا زلت مرجوا لكل عظيمة % % تبني معالم للعلي وتشيد % % 66(@)(@@) % وعليك صلى الله بعد محمد % % ما دام ذكرك في البرية ينشد % % 67(@)(@@) % والآل ما هبت صبا نجدية % % وشدا بذكرك مغور أو منجد % % PageV01P184 البحر : - 1(@)(@@) % هذا العقيق فقف بنا يا حادي % % فبه سليت حشاشتي ورقادي % % 2(@)(@@) % واحبس بكاظمة قلوصك منشدا % % ما للدموع تسيل سيل الوادي % % 3(@)(@@) % وأعد أحاديث الغوير لمغرم % % أضحى حليف صبابة وسهاد % % 4(@)(@@) % وحذار من وادي النقا والسفح من % % أضم فثم مصارع الآساد % % 5(@)(@@) % وأنا الفداء لبابلي لواحظ % % يسطو ببيض من رناه حداد % % 6(@)(@@) % ظبي من الأتراك غصن قوامه % % يزري بغصن البانة المياد % % 7(@)(@@) % فارقت قلبي عندما فارقته % % فكأنما كانا على ميعاد % % 8(@)(@@) % كم ذا أكابد من هواه على النوى % % حرقا تفتت قلب كل جماد % % 9(@)(@@) % رشأ بليت بهجره وبعاده % % وبرائح بالعذل فيه وغادي % % 10(@)(@@) % يا عاذلي خل الملامة إنني % % أدري بغيي في الهوى ورشادي % % PageV01P185 11(@)(@@) % دعني وشأني أو فكن لي مسعدا % % إن الكئيب أحق بالإسعاد % % 12(@)(@@) % حسبي صروف الدهر تهضم جانبي % % وتحول ما بيني وبين مرادي % % 13(@)(@@) % كم اشتكي جور الزمان ولا أرى % % لي من يعين على الزمان العادي % % 14(@)(@@) % حتى دعاني السعد لا تخضع ولذ % % بحمى الصفي وناد زين النادي % % 15(@)(@@) % السيد العلم الهمام المنتقى % % حرم الطريد وكعبة الوفاد % % 16(@)(@@) % الملك سيف الدين أفضل 
ms38	 من نضا % % سيفا على الأعداء يوم جلاد % % 17(@)(@@) % ملك حديث فخاره يرويه بالإسناد عن آبائه الأمجاد % . . . % 18(@)(@@) % ليث مخالبه إذا حضر الوغى % % بيض مهندة وسمر صعاد % % 19(@)(@@) % كرم يود البحر لو يحكيه مع % % بأس يذيب البيض في الأغماد % % 20(@)(@@) % ملك علا رتب الفخار بهمة % % رفعته فوق الكوكب الوقاد % % PageV01P186 21(@)(@@) % وقفا مآثر سالفين تقدموا % % من كل ذي شمم طويل نجاد % % 22(@)(@@) % وتقدم الأملاك طرا في الندى % % سبقا وهل سبق لغير جواد % % 23(@)(@@) % لو كان في الزمن القديم تشرفت % % بشريف خدمته بنو عباد % % 24(@)(@@) % لله كم منن أفاض على الورى % % غراء كالأطواق في الأجياد % % 25(@)(@@) % لو قصر العافون عن طلب الندى % % لأقام فيهم للنوال منادي % % 26(@)(@@) % يستقبل الجلي ببيض صوارم % % كفلت له بغناء كل معادي % % 27(@)(@@) % وبسالة أغنته عن حمل القنا % % توهي القوي وتفت في الأعضاد % % 28(@)(@@) % فلتفخر منه العلى بأغر رحب الكف رحب الصدر رحب النادي % . . . % 29(@)(@@) % بغضنفر شرس له من نصره % % عين على الأعداء بالمرصاد % % 30(@)(@@) % يقظان في طلب العلى لم تكتحل % % من غير سوء عينه برقاد % % PageV01P187 31(@)(@@) % تالله ما عمرو أخا بأس ولا % % كعب بن مامة عنده بجواد % % 32(@)(@@) % من معشر سبقوا الملوك إلى العلى % % سبق الجياد الضمر يوم طراد % % 33(@)(@@) % وحووا تراث المجد عن آبائهم % % ووراثة الآباء للأولاد % % 34(@)(@@) % وتبوأوا في المجد أشرف مقعد % % ورقوا من الجوزاء فوق مهاد % % 35(@)(@@) % أمبلغ الأمل الطويل ووارث المجد % % الأثيل وملجأ القصاد % % 36(@)(@@) % أمجرد الأسياف لم يغمدن في % % شيء سوى الهامات والأكباد % % 37(@)(@@) % لك في العزائم عن سيوفك غنية % % فذر السيوف تقر في الأغماد % % 38(@)(@@) % ماذا عسى مدحي المقصر قائل % % وثناك بين غوائر ونجاد % % 39(@)(@@) % ما زال ذكرك حيث كنت مصاحبي % % في في كل رابية علوت ووادي % % 40(@)(@@) % فافخر على قوم مضوا ما إن لهم % % في الفخر غير تقدم الميلاد % % PageV01P188 41(@)(@@) % واسمع شكية ذي وداد صادق % % وأسير فقر ما له من فادي % % 42(@)(@@) % عبد تخطى نحوه صرف القضا % % وعدت عليه من الزمان عوادي % % 43(@)(@@) % طال البقاء وقد وعدت ولم تزل % % معطي الأماني 
ms39	 صادق الميعاد % % 44(@)(@@) % فانظر إلى حالي وعجل أوبتي % % فضلا وفك من الخطوب قيادي % % 45(@)(@@) % أرسل على أرض افتقاري غارة % % بسحائب المعروف والإمداد % % 46(@)(@@) % واللبث لم يطل لملالة % % أيمل عذب الماء قلب الصادي % % 47(@)(@@) % لكن إلي طلب العلوم وكسبها % % طال اشتياقي واستطال سهادي % % 48(@)(@@) % أيطيب لي زمني ولم أجري به % % في حلبة العلم الشريف جوادي % % 49(@)(@@) % مولاي قد وافيت بابك وافدا % % وعلى الكريم كرامة الوفاد % % 50(@)(@@) % وركبت من عزمي إليك مطية % % وجعلت ذكرك في المفاوز زادي % % PageV01P189 51(@)(@@) % وتركت أملاك البرية عن يد % % إذ كنت قبلة مقصدي ومرادي % % 52(@)(@@) % وطويت نحوك كل أغبر قاتم % % عن حر أكباد وضر بادي % % 53(@)(@@) % وقصدت حضرتك الشريفة عندما % % جار الزمان ولج في إبعادي % % 54(@)(@@) % وافيتها والنحس موهن ساعدي % % فحللتها والسعد من أعضادي % % 55(@)(@@) % وسلوت عن أهلي وأوطاني بها % % إذ حيث كنت من البلاد بلادي % % 56(@)(@@) % وآستأمنت مني صروف الدهر إذ % % نهضت جيوش نداك في إنجادي % % 57(@)(@@) % وأنلتني الحسنى وكم منن بها % % قلدت أعناق الورى وأيادي % % 58(@)(@@) % شكرا أبا حسن لنعماك التي % % عاد الصديق بهن من حسادي % % 59(@)(@@) % عادات فضل منك لم تخرج بها % % عن عادة الآباء والأجداد % % 60(@)(@@) % وجميل رأيك في يا من لم تزل % % أراؤه مقرونة برشاد % % PageV01P190 61(@)(@@) % واستجلها عذراء شاب لحسنها % % فود الوليد وبان نقص زياد % % 62(@)(@@) % واسلم عليك سلام ربك دائما % % وصلاته بعد النبي الهادي % % PageV01P191 البحر : - 1(@)(@@) % يا صفي الإسلام دعوة عبد % % قد حسا كأس صفو ودك صرفا % % 2(@)(@@) % قد أتاكم من المديح بعقد % % حسنه مثل وصفكم ليس يخفي % % 3(@)(@@) % كالصبا رقة وكالروض نشرا % % وكأخلاقك الشريفة لطفا % % 4(@)(@@) % كعقود الجمان يعجز عنه % % كل من صرع القريض وقفي % % 5(@)(@@) % خذله من عصابة خالفوا الأمر وأخطوا خطيئة ليس تعفا % . . . % 6(@)(@@) % قوم سوء أصغوا إناي وقد أترعته من نوالكم فتكفا % . . . % 7(@)(@@) % قد أنالت كفاك عبدك خمسين فأخفوا نصفا وأعطوه نصفا % . . . % 8(@)(@@) % وأبى الله أن تكون عطياتكم خمسة وعشرين حرفا % . . . % 9(@)(@@) % وأراها تخالفت دونك الأيدي على نقصها ومثلك وفي % . . . % 10(@)(@@) % ولأنت الذي يدفع الفقر ويعطي الأموال ألفا 
ms40	 فألفا % . . . % PageV01P192 11(@)(@@) % أين منك السما سموا وجودا % % أنت أسمى قدرا وأسمح كفا % % PageV01P193 البحر : - 1(@)(@@) % رميت أسهم آمالي فلم تصب % % ورحت أدعو الندى جهرا فلم يجب % % 2(@)(@@) % وخاب ظني فيمن كنت أحسبه % % أبر من رحمي الأدنى وأرحم بي % % 3(@)(@@) % أهل الفضائل والخيل الصواهل والسمر الذوابل والخطية القضب % . . . % 4(@)(@@) % ومن إليهم تناهى كل مكرمة % % ومن بهم عز قلب الجحفل اللجب % % 5(@)(@@) % ومن أناملهم جودا لآملهم % % في كل مخمصة تغني عن السحب % % 6(@)(@@) % ما لي وقد جئت ناديكم ألوذ به % % رجعت عنه أسير الهم والكرب % % 7(@)(@@) % حبرت فيكم برود المدح معلمة % % فما حصلت على شيء سوى التعب % % 8(@)(@@) % حاشاكم مالبخل تمنعون فتى % % وفاكم ببديع النظم منتخب % % 9(@)(@@) % أين النوال الذي ما زال دأبكم % % به ملكتم رقاب العجم والعرب % % 10(@)(@@) % وأين ما قد عهدنا من تلطفكم % % بكل منتزح الأوطان مغترب % % PageV01P194 11(@)(@@) % وكيف خابت ظنوني في أكفكم % % وظن غيري فيكم قط لم يخب % % 12(@)(@@) % وما أقول لمن قد جاء يسألني % % عنكم ومثلي لا يصبو إلى الكذب % % 13(@)(@@) % أما بكم تضرب الأمثال سائرة % % في المجد والجود والعلياء والحسب % % 14(@)(@@) % والله ما قصرت مني مدائحكم % % وإنما أدركتني حرفة الأدب % % 15(@)(@@) % يا ويح قلبي كم ظلت تقلبه % % أيدي الهموم على فرش من اللهب % % 16(@)(@@) % ولهف نفسي لو أجدي وواحربا % % لو كان ينفعني إن قلت واحربي % % 17(@)(@@) % أفي المروءة أن تظمي وقد صدرت % % عن بحر جود بعيد القعر مضطرب % % 18(@)(@@) % فإن أعد خائبا عن بابكم فلقد % % قلدتكم بعقود الدر والذهب % % 19(@)(@@) % وقلت فيكم مديحا لو مدحت به % % شمس الضحى لسخت بالأنجم الشهب % % 20(@)(@@) % وقد رميت عدي فقري بنائلكم % % لكنني لسواد الحظ لم أصب % % PageV01P195 21(@)(@@) % هي السعادة إن تبدو مطالعها % % يحظ الفتى ببلوغ السول والرب % % 22(@)(@@) % وإن يكن غيرها والحر ممتحن % % فما على من أقام العذر بالطلب % % 23(@)(@@) % يا دهر كم أتلقى كل نائبة % % بعزم ذي جلد يوهي قوى النوب % % 24(@)(@@) % وكم أصبر نفسا طال ما طعمت % % طعم البلا في طلاب المجد كالضرب % % 25(@)(@@) % وكم أومل والآمال تعكس آمالي وتمنعني 