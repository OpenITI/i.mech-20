ms341	 نصر الله والفتح تعدل ربع القرآن .(@)(@@) % ( هب ) عن أنس .(@)(@@) 2718 - من قرأ قل يا أيها الكافرون فكأنما قرأ ربع القرآن ، ومن قرأ قل هو الله أحد فكأنما قرأ ثلث القرآن .(@)(@@) % ( هب ) عن سعد .(@)(@@) 2719 - من لقي الله ومعه سورتان فلا حساب عليه { قل يا أيها الكافرون } { وقل هوالله أحد } .(@)(@@) % ( أبونعيم ) عن زيد بن أرقم .(@)(@@) | 1 ( قل هوالله أحد ) 1(@)(@@) 2720 - ما يمنع أحدكم أن يقرأ قل هو الله أحد في كل ليلة فإنها تعدل القرآن كله .(@)(@@) % ( ابن الأنباري في المصاحف ) عن أنس .(@)(@@) 2721 - من قرأ بقل هو الله أحد الله الصمد فقد قرأ ثلث القرآن .(@)(@@) % ( طب ) عن ابن عمر .(@)(@@) 2722 - والذي نفسي بيده إنها لتعدل ثلث القرآن يعني قل هو الله أحد .(@)(@@) % ( حب ) عن أبي سعيد .(@)(@@) PageV01P297(@)(@@) 2723 - أيعجز أحدكم أن يقرأ في كل ليلة ثلث القرآن قالوا : نحن أعجز من ذلك وأضعف ، قال : إن الله عز وجل جزأ القرآن ثلاثة أجزاء فجعل قل هو الله أحد جزء من أجزاء القرآن .(@)(@@) % ( حم م ) عن أبي الدرداء .(@)(@@) 2724 - أيعجز أحدكم أن يقرأ ثلث القرآن في ليلة فشق ذلك عليهم فقال : يقرآ قل هو الله أحد ؛ فهي تعدل ثلث القرآن .(@)(@@) % ( حم خ ع ) عن أبي سعيد ( حب وابن السني حل طب ) عن ابن مسعود ( هب ) عن أبي أيوب ( الخطيب ) عن أبي هريرة .(@)(@@) 2725 - أما يستطيع أحدكم أن يقرأ ثلث القرآن في كل ليلة .(@)(@@) % ( طس ص ) عن أنس .(@)(@@) 2726 - نعم السورتان قل هو الله أحد تعدل ثلث القرآن وقل يا أيها الكافرون تعدل ربع القرآن .(@)(@@) % ( طب ) عن ابن عمر .(@)(@@) 2727 - لا يتأمن ( كذا وفي المستدرك لا ينامن . . . وكيف يستطيع أحدنا أن يقرأ ثلث القرآن ) أحدكم حتى يقرأ ثلث القرآن قالوا : وكيف نستطيع قال : ألا يستطيع أن يقرأ قل هوالله أحد وقل أعوذ برب الفلق وقل أعوذ برب الناس .(@)(@@) % ( ك هب عن أبي هريرة ) .(@)(@@) 2728 - من قرأ قل هو الله أحد مرة واحدة فكأنما قرأ ثلث القرآن ومن قرأها مرتين فكأنما قرأ ثلثي القرآن ومن 
ms342	 قرأها ثلاثا فكأنما قرأ القرآن كله .(@)(@@) % ( الرافعي عن علي ) .(@)(@@) 2729 - من قرأ في ليلة أو يوم قل هو الله أحد ثلاث مرات كان بمقدار القرآن .(@)(@@) % ( ابن النجار عن كعب بن عجرة ) .(@)(@@) 2730 - من قرأ قل هو الله أحد ثلاث مرات فكأنما قرأ القرآن أجمع .(@)(@@) % ( عق عن رجاء الغنوي ) .(@)(@@) 2731 - من قرأ قل هو الله أحد عشر مرات بنى الله له بيتا في الجنة قال عمر : إذا نستكثر قال الله : أكثر وأطيب .(@)(@@) % ( حم طب وابن السني عن معاذ بن أنس ) .(@)(@@) 2732 - من قرأ قل هو الله أحد دبر كل صلاة مكتوبة عشر مرات أوجب الله له رضوانه ومغفرته .(@)(@@) % ( ابن النجار ) عن ابن عباس .(@)(@@) 2733 - من قرأ قل هو الله أحد اثنتي عشرة مرة بعد صلاة الفجر فكأنما قرأ القرآن أربع مرات وكان أفضل أهل الأرض يومئذ إذا اتقى .(@)(@@) % ( هب ) عن أبي هريرة .(@)(@@) 2734 - من قرأ قل هو الله أحد مائة مرة بعد صلاة الغداة قبل أن يتكلم رفع له ذلك اليوم عمل خمسين صديقا .(@)(@@) % ( البراء بن عازب ) وفيه سليمان بن الربيع ( وهكذا في لسان الميزان ) وهوضعيف عن كادح بن رحمة وهوكذاب .(@)(@@) 2735 - من قرأ قل هو الله أحد على طهارة مائة مرة كطهرة الصلاة يبدأ بفاتحة الكتاب كتب الله له بكل حرف عشر حسنات ومحى عنه عشر سيئات ورفع له عشر(@)(@@) PageV01P298 درجات وبنى له مائة قصر في الجنة ورفع له من العمل في يومه ذلك مثل عمل بني آدم وكأنما قرأ القرآن ثلاثا ( في المنتخب ثلاثة ) وثلاثين مرة وبراءة من الشرك ومحضرة الملائكة ومنفرة الشيطان ( في المنتخب الشياطين ) ولها دوي حول العرش تذكر صاحبها ( في المنتخب لصاحبها ) حتى ينظر الله إليه وإذا نظر الله إليه لم يعذبه أبدا .(@)(@@) % ( عد هب عن أنس ) .(@)(@@) 2736 - ما من عبد مسلم وأمة قرأ في يوم وليلة مائتي مرة قل هو الله أحد إلا غفر الله له خطاياه خمسين سنة .(@)(@@) % ( ابن السني ) عن أنس .(@)(@@) 2737 - من قرأ قل هو الله أحد عشية عرفة ألف مرة أعطاه 
ms343	 الله عز وجل ما سأل .(@)(@@) % ( أبو الشيخ عن ابن عمر ) .(@)(@@) 2738 - من قرأ قل هو الله أحد مرة بورك عليه فإن قرأها مرتين بورك عليه وعلى أهله فإن قرأها ثلاثا بورك عليه وعلى أهله وجيرانه وإن قرأها اثنتي عشرة مرة بنى الله له بها اثني عشر قصرا في الجنة وتقول الحفظة انطلقوا بنا ننظر إلى قصور أخينا ، فإن قرأها مائة مرة كفر عنه ذنوب خمس وعشرين سنة ما خلا الدماء والأموال فإن قرأها مائتي مرة كفر عنه ذنوب خمسين سنة ما خلا الدماء والأموال وإن قرأها ثلاثمائة مرة كتب الله له أجر أربع مائة شهيد كل قد عقر جواده وأهريق دمه وإن قرأها ألف مرة لم يمت حتى يرى مكانه من الجنة أو يرى له .(@)(@@) % ( ابن عساكر عن ابان عن أنس ) .(@)(@@) 2739 - من قرأ قل هو الله أحد حين يدخل منزله نفت الفقر عن أهل ذلك المنزل والجيران .(@)(@@) % ( طب عن جرير ) .(@)(@@) 2740 - حبك إياها أدخلك الجنة يعني قل هو الله أحد .(@)(@@) % ( حم خ تعليقا والدارمي وعبد بن حميد ت حسن غريب ع وابن خزيمة حب ك وابن السني عن أنس ) .(@)(@@) 2741 - نزل جبريل فقال : يا محمد مات معاوية بن معاوية المزني أتحب أن تصلى عليه فضرب بجناحه ( في الاصابة - بجناحيه ) فلم تبق شجرة ولا أكمة إلا تضعضعت ورفع سريره ( في الاصابة - حتى نظر إليه فصلى ) وصلى عليه صفان من الملائكة كل صف سبعون ألف ملك فقلت يا جبريل بما نال هذه المنزلة من الله قال لحبه قل هو الله أحد وقراءته إياها جائيا وذاهبا وقائما وقاعدا وعلى كل حال .(@)(@@) % ( سمويه ق عن أنس ) .(@)(@@) | 1 ( المعوذتين ) 1(@)(@@) 2742 - آيات أنزلت علي الليلة لم ير مثلهن قط أعوذ برب الفلق وأعوذ برب الناس .(@)(@@) % ( ن عن عقبة بن عامر ) .(@)(@@) 2743 - استكثروا من السورتين يبلغكم الله بهما في الآخرة المعوذتين ينوران القبر ويطردان الشيطان ويزيدان في الحسنات والدرجات ويثقلان الميزان ويدلان صاحبهما إلى الجنة .(@)(@@) % ( الديلمي عن ابن مسعود ) .(@)(@@) PageV01P299(@)(@@) 2744 - اقرأ يا جابر قل أعوذ 
ms344	 برب الفلق وقل أعوذ برب الناس ولن تقرأ بمثلهما .(@)(@@) % ( ن حب ) عن جابر .(@)(@@) 2745 - يا عقبة بن عامر إنك لن تقرأ بسورة أحب إلى الله ولا أبلغ عنده من أن تقرأ قل أعوذ برب الفلق وقل أعوذ برب الناس فإن استطعت أن لا تفوتك في صلاة فافعل .(@)(@@) % ( حب طب ك هب عن عقبة بن عامر ) .(@)(@@) 2746 - إنك لن تقرأ بشيء أبلغ عند الله من قل أعوذ برب الفلق .(@)(@@) % ( حب هب طب عن عقبة بن عامر ) .(@)(@@) 2747 - ما سأل سائل ولا استعاذ مستعيذ بمثلهما يعني المعوذتين .(@)(@@) % ( ش عن عقبة بن عامر ) .(@)(@@) | 1 ( الفصل الثالث في آداب التلاوة ) 1(@)(@@) 2748 - إن أحسن الناس قراءة من إذا قرأ القرآن يتحزن فيه .(@)(@@) % ( طب عن ابن عباس ) .(@)(@@) 2749 - أحسن الناس قراءة من قرأ القرآن يتحزن فيه ( ن - به ) .(@)(@@) % ( طب عن ابن عباس ) .(@)(@@) 2750 - أحسن الناس قراءة الذي إذا قرأ رأيت أنه يخشى الله .(@)(@@) % ( محمد بن نصر في كتاب الصلاة هب خط عن ابن عباس ) ( السجزي في الابانة خط عن ابن عمر فر عن عائشة ) .(@)(@@) 2751 - إن أفواهكم طرق القرآن فطيبوها بالسواك .(@)(@@) % ( أبو نعيم في كتاب السواك والسجزي في الابانة عن علي ) .(@)(@@) 2752 - طيبوا أفواهكم فإن أفواهكم طريق القرآن .(@)(@@) % ( الكجي في سننه عن وضين مرسلا السجزي في الابانة عنه عن بعض الصحابة ) .(@)(@@) 2753 - طيبوا أفواهكم بالسواك فإنها طرق القرآن .(@)(@@) % ( هب عن سمرة ) .(@)(@@) 2754 - إن مثل صاحب القرآن كمثل صاحب الإبل المعقلة إن عاهد عليها أمسكها وإن أطلقها ذهبت .(@)(@@) % ( مالك حم ق ن ه عن ابن عمر ) .(@)(@@) 2755 - تعاهدوا القرآن فو الذي نفسي بيده لهو أشد تفصيا من قلوب الرجال من الابل من عقلها .(@)(@@) % ( حم ق عن أبي موسى ) .(@)(@@) 2756 - تعلموا كتاب الله وتعاهدوه وتغنوا به فو الذي نفسي بيده لهو أشد تفلتا من المخاض في العقل ( ن - المعقل ) .(@)(@@) % ( حم عن عقبة بن عامر ) .(@)(@@) 2757 - استدركوا ( كذا - وفي الجامع الصغير استذكروا ) القرآن فلهو أشد تفصيا من صدر الرجال من النعم من عقلها .(@)(@@) % ( حم ق ت ن عن 
ms345	 ابن مسعود ) .(@)(@@) PageV01P300(@)(@@) 2758 - الجاهر بالقرآن كالجاهر بالصدقة والمسر بالقرآن كالمسر بالصدقة .(@)(@@) % ( د ت ن عن عقبة بن عامر ) ( ك عن معاذ ) .(@)(@@) 2759 - حفظ الغلام الصغير كالنقش في الحجر وحفظ الرجل بعدما يكبر كالكتاب على الماء .(@)(@@) % ( خط في الجامع عن ابن عباس ) .(@)(@@) 2760 - من سره أن يحب الله ورسوله فليقرأ في المصحف .(@)(@@) % ( حل هب عن ابن مسعود ) .(@)(@@) 2761 - في هذا مرة وفي هذا مرة يعني القرآن والشعر .(@)(@@) % ( ابن الأنباري في الوقف عن أبي بكرة ) .(@)(@@) 2762 - لله أشد أذنا إلى الرجل الحسن الصوت يتغنى بالقرآن يجهر به من صاحب ( القينة : بفتح القاف واسكان الياء : هي الأمة المغنية أ ه ) القينة إلى قينته .(@)(@@) % ( حب ك هب عن فضالة بن عبيد ) .(@)(@@) 2763 - ما أذن الله لشيء ما أذن لنبي حسن الصوت يتغنى بالقرآن يجهر به .(@)(@@) % ( حم د ق ن عن أبي هريرة ) .(@)(@@) 2764 - حسن الصوت زينة القرآن .(@)(@@) % ( طب عن ابن مسعود ) .(@)(@@) 2765 - حسنوا القرآن بأصواتكم فإن الصوت الحسن يزيد القرآن حسنا .(@)(@@) % ( الدارمي وابن نصر في الصلاة ك عن البراء ) .(@)(@@) 2766 - زينوا القرآن بأصواتكم .(@)(@@) % ( حم د ن حب ك عن البراء ) ( أبو نصر السجزي في الابانة عن أبي هريرة ) ( قط في الأفراد ) ( طب عن ابن عباس ) ( حل عن عائشة ) .(@)(@@) 2767 - زينوا القرآن بأصواتكم فإن الصوت الحسن يزيد القرآن حسنا .(@)(@@) % ( ك عن البراء ) .(@)(@@) 2768 - لكل شيء حلية وحلية القرآن الصوت الحسن .(@)(@@) % ( عب والضياء عن أنس ) .(@)(@@) 2769 - ليس منا من لم يتغن بالقرآن .(@)(@@) % ( خ عن أبي هريرة ) ( حم د حب ك عن سعد ) ( د عن أبي لبابة بن المنذر ) ( ك عن ابن عباس ) ( د عن عائشة ) .(@)(@@) 2770 - اقرأ القرآن على كل حال إلا وأنت جنب .(@)(@@) % ( أبو الحسن ابن صخر في فوايده عن علي ) .(@)(@@) 2771 - اقرأ القرآن في كل شهر اقرأه في عشر اقرأه في سبع ولا تزد على ذلك .(@)(@@) % ( ق د عن ابن عمر ) .(@)(@@) 2772 - اقرأ القرآن في كل شهر اقرأه في خمس وعشرين اقرأه في خمس عشرة اقرأه في عشر اقرأه في سبع لا يفقهه من 
ms346	 يقرأه في أقل من ثلاث .(@)(@@) % ( حم عن أبي هريرة - ( ن - عن ابن عمر ) ) .(@)(@@) PageV01P301(@)(@@) 2773 - اقرأ القرآن في أربعين .(@)(@@) % ( ت عن ابن عمر ) .(@)(@@) 2774 - اقرأ القرآن في خمس .(@)(@@) % ( طب عن ابن عمر ) .(@)(@@) 2775 - اقرأ القرآن في ثلاث إن استطعت .(@)(@@) % ( حم طب عن سعد بن المنذر ) .(@)(@@) 2776 - اقرأ القرآن ما نهاك فإن ( ن - فإذا ) لم ينهك فلست تقر - انتهى [ تقرأ ؟ ؟ ] .(@)(@@) % ( فر عن ابن عمرو ) .(@)(@@) 2777 - أقرؤوا القرآن بالحزن فإنه نزل بالحزن .(@)(@@) % ( ع حل طس عن بريدة ) .(@)(@@) 2778 - اقرؤوا القرآن ما ائتلفت عليه قلوبكم فإذا اختلفت ( وهكذا في المنتخب وفي الجامع الصغير اختلفتم ) فقوموا .(@)(@@) % ( حم ق ن عن جندب ) .(@)(@@) 2779 - اقرؤوا القرآن بلحون العرب وأصولتها وإياكم ولحون أهل الكتابين وأهل الفسق فإنه سيجيء بعدي قوم يرجعون بالقرآن ترجيع الغناء والرهبانية والنوح لا يجاوز حناجرهم مفتونة قلوبهم وقلوب من يعجبهم شأنهم .(@)(@@) % ( طس هب عن حذيفة ) .(@)(@@) 2780 - اقرؤوا القرآن وابتغوا به الله تعالى من قبل أن يأتي قوم يقيمونه إقامة القدح يتعجلونه ولا يتأجلونه .(@)(@@) % ( حم د عن جابر ) .(@)(@@) 2781 - اعربوا القرآن والتمسوا غرائبه .(@)(@@) % ( ش ك هب عن أبي هريرة ) .(@)(@@) 2782 - اعربوا القرآن والتمسوا غرائبه وغرائبه فرائضه وحدوده فإن القرآن نزل على خمسة أوجه حلال وحرام ومحكم ومتشابه وأمثال فاعملوا بالحلال واجتنبوا الحرام واتبعوا المحكم وآمنوا بالمتشابه واعتبروا بالأمثال .(@)(@@) % ( هب عن أبي هريرة ) .(@)(@@) 2783 - اعربوا الكلام كي تعربوا القرآن .(@)(@@) % ( ابن الأنباري في الوقف والمرهبي في فضل العلم عن أبي جعفر ) معضلا .(@)(@@) 2784 - إذا ختم أحدكم فليقل : اللهم آنس وحشتي في قبري .(@)(@@) % ( فر عن أبي أمامة ) .(@)(@@) 2785 - إذا قام صاحب القرآن فقرأ بالليل والنهار ذكره وإن لم يقم به نسبه .(@)(@@) % ( محمد بن نصر في الصلاة عن ابن عمر ) .(@)(@@) 2786 - أحب الأعمال إلى الله ( عند الترمذي أول الحديث : الحال المرتحل . رقمه / 2949 / وعن ابن عباس ) الحال المرتحل الذي يضرب من أول القرآن إلى آخره ومن آخره إلى أوله كلما حل ارتحل .(@)(@@) % ( ت عن ابن عباس ) ( د عن زرارة بن أبي ( كذا وفي المنتخب زرارة بن أوفى - وهكذا في 
ms347	 التهذيب ) أوفي ) مرسلا وقال هذا أصح .(@)(@@) 2787 - اقرؤوا القرآن واسئلوا الله به قبل أن يأتي قوم يقرؤون القرآن فيسألون به الناس .(@)(@@) % ( حم هب طب عن عمران بن حصين ) .(@)(@@) 2788 - إن من أحسن الناس صوتا بالقرآن الذي إذا سمعته يقرأ رأيت أنه يخشى الله .(@)(@@) % ( ه عن جابر ) .(@)(@@) PageV01P302(@)(@@) 2789 - إن هذا نزل بحزن وكآبة فإذا قرأتموه فابكوا فإن لم تبكوا فتباكوا وتغنوا به فمن لم يتغن به فليس منا .(@)(@@) % ( ه ومحمد بن نصر في كتاب الصلاة هب عن سعد ) .(@)(@@) 2790 - إنه طرأ على حزبي من القرآن فكرهت أن أخرج حتى أتمه .(@)(@@) % ( حم د ه عن أويس بن حذيفة ) .(@)(@@) 2791 - ألا إن كلكم مناج ربه فلا يوذين بعضكم بعضا ولا يرفع بعضكم على بعض في القراءة .(@)(@@) % ( حم د ك عن أبي سعيد ) .(@)(@@) 2792 - من قرأ منكم بالتين والزيتون فانتهى إلى آخرها أليس الله بأحكم الحاكمين . فليقل : بلى ، وأنا على ذلك من الشاهدين ، ومن ( حديث الترمذي أوله من قرأ سورة والتين إلى . . . من الشاهدين . والباقي الحديث زيادة أبي داود . راجع تحفة الأحوذي شرح الترمذي رقم / 3344 / و / 276 . ) قرأ لا أقسم بيوم القيامة ، فانتهى إلى أليس ذلك بقادر على أن يحيى الموتى فليقل بلى ، ومن قرأ والمرسلات فبلغ فبأي حديث بعده يؤمنون ، فليقل آمنا بالله .(@)(@@) % ( د ت عن أبي هريرة ) .(@)(@@) 2793 - رحم الله فلانا لقد ذكرني كذا وكذا آية كنت أسقطتها من سورة كذا وكذا .(@)(@@) % ( حم ق د عن عائشة ) .(@)(@@) | 1 ( الإكمال ) 1(@)(@@) 2794 - اقرؤوا القرآن وابكوا فإن لم تبكوا فتباكوا ليس منا من لم يتغن بالقرآن .(@)(@@) % ( ابن نصر عن سعد بن أبي وقاص ) .(@)(@@) 2795 - إن الله ليأذن للرجل يكون حسن الصوت يتغنى بالقرآن .(@)(@@) % ( عب عن البراء ) .(@)(@@) 2796 - إن هذا القرآن نزل بحزن فاقرؤوه بحزن .(@)(@@) % ( ابن مردويه عن ابن عباس ) .(@)(@@) 2797 - ليس منا من لم يتغن بالقرآن .(@)(@@) % ( عب ش ط حم وعبد بن حميد والعدني والدارمي ( د ) وأبو عوانة ( حب ك ق ص ) عن سعد ابن أبي وقاص ( د ) والبغوي وابن قانع طب ق 
ms348	 عن أبي لبابة بن عبد المنذر ( الخطيب وابن نصر في الابانة ك ق عن أبي هريرة ) ( طب ك وأبو نصر في الابانة عن ابن عباس ) ( أبو نصر عن ابن الزبير ) ( ابن النضر وأبو نصر ك عن عائشة ) ( الخطيب في المتفق والمفترق عن أنس ) ) .(@)(@@) 2798 - ما أذن الله لشيء ما أذن لرجل حسن الترنم بالقرآن .(@)(@@) % ( عب عن أبي سلمة مرسلا أبو نصر السجزي في الابانة عن أبي سلمة ) .(@)(@@) 2799 - ما أذن الله لشيء كأذنه لعبد يترنم بالقرآن .(@)(@@) % ( ش عن أبي سلمة ) .(@)(@@) 2800 - ما أذن الله لشيء كأذنه للذي يتغنى بالقرآن يجهر به .(@)(@@) % ( حب عن أبي هريرة - ( ورواه مسلم في صحيحه عن أبي هريرة كذلك وبلفظه 1 / 546 ) ) .(@)(@@) PageV01P303(@)(@@) 2801 - ويحك يا شهاب ( وفي المنتخب - يا شاب هلا بالقرآن تتغنى أبو نعيم عن زيد بن أرقم عن سالم ابن أبي سلام وذكر سالما صاحب الاستيعاب ) هلا بالقرآن تغني .(@)(@@) % ( أبو نعيم عن زيد بن أرقم عن سالم بن أبي سلام ) .(@)(@@) 2802 - لا يسمع القرآن من رجل أشهى منه ممن يخشى الله عز وجل .(@)(@@) % ( ابن المبارك عن طاوس مرسلا ) ( أبو نصر السجزي في الابانة عن طاوس عن أبي هريرة ) .(@)(@@) 2803 - يا أهل القرآن لا توسدوا القرآن واتلوه حق تلاوته آناء الليل والنهار وافشوه وتغنوا به وتدبروا ما فيه لعلكم تفلحون ولا تعجلوا ثوابه فإن له ثوابا .(@)(@@) % ( طب هب ) وأبو نعيم وابن عساكر عن عبيدة المليكي .(@)(@@) 2804 - نظفوا أفواهكم فإنها طرق القرآن .(@)(@@) % ( الديلمي عن أنس ) .(@)(@@) 2805 - اجتمعوا على القرآن ما ائتلفتم ( ورواه البخاري في صحيحه عن جندب بن عبد الله . كتاب فضائل القرآن وأول الحديث : اقرؤوا القرآن . باب اقرؤوا القرآن . وصحيح مسلم كتاب العلم رقم / 2667 / . ومر عز والمصنف برقم / 2778 / . ) عليه فإذا اختلفتم فقوموا .(@)(@@) % ( طب حل عن جندب ) .(@)(@@) 2806 - أعربوا القرآن .(@)(@@) % ( الرافعي عن ابن مسعود ) .(@)(@@) 2807 - اقرأ يا معاذ ولا تهمز .(@)(@@) % ( خط عن ابن مسعود ) .(@)(@@) 2808 - تعلموا اللحن كما تتعلمون حفظه .(@)(@@) % ( الديلمي عن أبي ) .(@)(@@) 2809 - ارشدوا أخاكم .(@)(@@) % ( ك عن أبي الدرداء ) قال : سمع النبي صلى 
ms349	 الله عليه وسلم رجلا قرأ فلحن قال : فذكره .(@)(@@) 2810 - إذا أشكلت عليك آية من القرآن تؤنثها أو تذكرها فذكر القرآن .(@)(@@) % ( ابن قانع عن بشير أو بشير بن الحارث ) .(@)(@@) 2811 - إذا قام أحدكم من الليل فاستعجم القرآن على لسانه فلم يدر ما يقول فلينصرف ، فليضطجع .(@)(@@) % ( عب حم م د ه حب عن أبي هريرة ) .(@)(@@) 2812 - أفضل العمل الحال المرتحل قيل وما الحال المرتحل قال الخاتم المفتتح .(@)(@@) % ( محمد بن نصر من طريق ابن المبارك ) .(@)(@@) 2813 - حدثنا رجل من أهل الإسكندرية : أفضل الأعمال الحال المرتحل صاحب القرآن يضرب من أوله إلى آخره حتى يبلغ آخره ومن آخره حتى يبلغ أوله كلما ارتحل حل .(@)(@@) % ( ك عن ابن عباس ) وتعقب ( ك عن أبي هريرة ) وتعقب .(@)(@@) 2814 - عليك بالحال المرتحل صاحب القرآن يضرب في أوله حتى يبلغ آخره ويضرب في آخره حتى يبلغ أوله كلما حل ارتحل .(@)(@@) % ( هب عن ابن عباس ) .(@)(@@) 2815 - اقرأ القرآن في كل شهر قال قلت : إني أجد قوة قال : اقرأه في عشرين ليلة قال قلت : إني أجد قوة قال : فاقرأه في عشر ليال قال : إني أجد قوة قال : فاقرأه في سبع ولا تزد على ذلك .(@)(@@) % ( خ م ( صحيح مسلم كتاب الصيام [ 2 / 814 ] ) د عن ابن عمرو ) .(@)(@@) PageV01P304(@)(@@) 2816 - اقرأ القرآن في شهر قال : إن لي قوة قال : اقرأه في ثلاث .(@)(@@) % ( د حل عن ابن عمرو ) .(@)(@@) 2817 - اقرأ القرآن في أربعين .(@)(@@) % ( ت حسن غريب عن ابن عمرو ) .(@)(@@) 2818 - اقرأ القرآن في خمس .(@)(@@) % ( طب عن ابن عمرو ) .(@)(@@) 2819 - لا تحمل عليك ما لا تطيق وعليك بالسجود .(@)(@@) % ( طب وابن عساكر عن أبي ريحانة ) قال : شكوت إلى النبي صلى الله عليه وسلم تفلت القرآن ومشقته علي قال فذكره .(@)(@@) 2820 - اقرؤوا القرآن واتبعوا ما فيه .(@)(@@) % ( الديلمي عن أبي هريرة ) .(@)(@@) 2821 - اقرؤوا القرآن واسألوا الله به فإنه سيقرأه أقوام يقيمونه إقامة القدح يتعجلونه ولا يتأجلونه .(@)(@@) % ( ش عن محمد بن المكندر مرسلا ) .(@)(@@) 2822 - قراءتك نظرا تضاعف على قراءتك ظاهرا كفضل المكتوبة على النافلة .(@)(@@) % ( ابن مردويه عن عثمان بن عبد 
ms350	 الله بن أوس الثقفي عن عمرو بن أوس ) .(@)(@@) 2823 - ما لي أراكم سكوتا للجن كانوا أحسن ردا منكم ما قرأت عليهم هذه الآية من مرة { فبأي آلاء ربكما تكذبان } إلا قالوا ولا بشيء من نعمك ربنا نكذب فلك الحمد .(@)(@@) % ( الحسن بن سفيان ك هب عن جابر ) .(@)(@@) 2824 - ما من عين فاضت من قراءة القرآن إلا قرت يوم القيامة .(@)(@@) % ( الديلمي عن أنس ) .(@)(@@) 2825 - لا تقولوا سورة البقرة ولا سورة آل عمران ولا سائر القرآن وقولوا السورة التي تذكر فيها البقرة والسورة التي يذكر فيها آل عمران والقرآن على نحو هذا .(@)(@@) % ( هب وضعفه عن أنس ) .(@)(@@) 2826 - اقرأ علي القرآن قال : يا رسول الله اقرأ عليك وعليك أنزل قال : إني أشتهي أن أسمعه من غيري .(@)(@@) % ( خ م د عن ابن مسعود ) أما إني على ما ترون بحمد الله فقد قرأت البارحة السبع الطوال ( ابن خزيمة ع حب ك هب ص عن أنس ) .(@)(@@) | 1 ( فرع في محظورات التلاوة وبعض حقوق القراءة ) 1(@)(@@) 2827 - في أمتي قوم يقرؤون القرآن ينثرونه نثر الدقل ( بفتحتين هو ردي التمر ويابسه - مجمع ) .(@)(@@) % ( ع عن حذيفة ) .(@)(@@) 2828 - لا يفقه من قرأ القرآن في أقل من ثلاث .(@)(@@) % ( د ت ه ) عن ابن عمر .(@)(@@) 2829 - لا تمس القرآن إلا وأنت طاهر .(@)(@@) % ( طب قط ك ) عن حكيم بن حزام .(@)(@@) 2830 - لا يمس القرآن إلا طاهر .(@)(@@) % ( د ت ) عن ابن عمر .(@)(@@) PageV01P305(@)(@@) 2831 - بئسما لأحدكم أن يقول نسيت آية كيت وكيت بل هو نسي .(@)(@@) % ( حم ق ت ) عن ابن مسعود .(@)(@@) 2832 - لا يقل أحدكم نسيت آية كيت وكيت بل هو نسي .(@)(@@) % ( م ) عن ابن مسعود .(@)(@@) 2833 - عرضت علي أجور أمتي حتى القذاة يخرجها الرجل من المسجد ، وعرضت علي ذنوب أمتي فلم أر ذنبا أعظم من سورة من القرآن أو آية أوتيها رجل ثم نسيها .(@)(@@) % ( د ت - ( رقم / 2917 / و 8 / 233 - تحفة الأحوزي ) ) عن أنس .(@)(@@) 2834 - ما من أحد تعلم القرآن ثم نسي إلا لقي الله يوم القيامة أجذم .(@)(@@) % ( م والدارمي طب هب عن سعد 
ms351	 بن عبادة ) .(@)(@@) 2835 - ما من امرء يقرأ القرآن ثم ينساه إلا لقي الله يوم القيامة أجذم .(@)(@@) % ( د عن سعد بن عبادة ) .(@)(@@) 2836 - لا تجادلوا في القرآن فإن جدلا فيه كفر .(@)(@@) % ( الطيالسي هب عن ابن عمرو ) .(@)(@@) 2837 - الجدال في القرآن كفر .(@)(@@) % ( ه ك عن أبي هريرة ) .(@)(@@) 2838 - المراء في القرآن كفر .(@)(@@) % ( د ك عن أبي هريرة ) .(@)(@@) 2839 - نهى عن الجدال في القرآن .(@)(@@) % ( السجزي في الابانة عن أبي سعيد ) .(@)(@@) 2840 - نهى أن يسافر بالقرآن إلى أرض العدو .(@)(@@) % ( ق د ه عن ابن عمر ) .(@)(@@) 2841 - من أخذ على تعليم القرآن قوسا قلده الله مكانها قوسا من نار جهنم يوم القيامة .(@)(@@) % ( حل هق عن أبي الدرداء ) .(@)(@@) 2842 - من أخذ على القرآن أجرا فذاك حظه من القرآن .(@)(@@) % ( حل عن أبي هريرة ) .(@)(@@) 2843 - من قرأ القرآن يتأكل به الناس جاء يوم القيامة ووجهه عظم ليس عليه لحم .(@)(@@) % ( هب عن بريدة ) .(@)(@@) 2844 - ما آمن بالقرآن من استحل محارمه .(@)(@@) % ( ت عن صهيب ) .(@)(@@) 2845 - الغرباء في الدنيا أربعة قرآن في جوف ظالم ، ومسجد في نادي قوم لا يصلى فيه ومصحف في بيت لا يقرأ فيه ورجل صالح مع قوم سوء .(@)(@@) % ( فر عن أبي هريرة ) .(@)(@@) | 1 ( الإكمال ) 1(@)(@@) 2846 - إن من أكبر ذنب توافيني به أمتي يوم القيامة لسورة من كتاب الله كانت مع أحدهم فنسيها .(@)(@@) % ( محمد بن نصر عن أنس ) .(@)(@@) 2847 - عرضت علي الذنوب فلم أر فيها شيئا أعظم من حامل القرآن وتاركه .(@)(@@) % ( ش عن الوليد بن عبد الله بن أبي مغيث ) .(@)(@@) PageV01P306(@)(@@) 2848 - ما من أحد يقرأ القرآن ثم ينساه إلا لقي الله وهو أجذم .(@)(@@) % ( محمد بن نصير عن سعد بن عبادة ) .(@)(@@) 2849 - بئسما لأحدكم أن يقول نسيت آية كيت وكيت بل هو نسي استذكروا القرآن فو الذي نفسي بيده لهو أشد تفصيا من صدور الرجال من النعم من عقلها .(@)(@@) % ( حم خ م ن حب ) عن ابن مسعود .(@)(@@) 2850 - تعاهدوا هذا القرآن فإنه وحشي فلهو أسرع تفصيا من صدور الرجال من الابل من عقلها ولا يقولن أحدكم نسيت آية 
ms352	 كيت وكيت بل نسي .(@)(@@) % ( محمد بن نصر طب ك ) عن ابن مسعود ( ش ) عنه موقوفا .(@)(@@) 2851 - لا يقولن أحدكم نسيت آية كيت وكيت فإنه ليس هو نسي ولكنه نسي .(@)(@@) % ( طب ) عن ابن مسعود .(@)(@@) 2852 - تعاهدوا القرآن فو الذي نفسي بيده لهو أشد تفصيا من صدور الرجال من الابل النوازع إلى أوطانها .(@)(@@) % ( طب والخطيب ) عن ابن مسعود ( ش ) عنه موقوفا .(@)(@@) 2853 - تعاهدوا هذا القرآن فو الذي نفس محمد بيده لهو أشد تفلتا من قلوب الرجال من النعم من عقلها .(@)(@@) % ( طب ) عن أبي موسى .(@)(@@) 2854 - مثل القرآن إذا عاهد عليه صاحبه فقرأه بالليل والنهار كمثل رجل له إبل فإن عقلها حفظها وإن أطلق عقالها ذهبت فكذلك القرآن .(@)(@@) % ( ش حم خ م ) عن ابن عمر .(@)(@@) 2855 - مثل القرآن كمثل الإبل المعقلة إن تعاهد صاحبها عقلها أمسكها وإن أغفلها ذهبت وإذا قام صاحب القرآن يقرأه آناء الليل وآناء النهار ذكره وإن لم يقم به نسيه .(@)(@@) % ( الرامهرمزي ) عن ابن عمر .(@)(@@) 2856 - انفر الشيطان انفر الشيطان انفر الشيطان يا عمر القرآن كله صواب ما لم يجعل المغفرة عذابا والعذاب مغفرة .(@)(@@) % ( البغوي عن إسحاق بن حارثة ( كذا وفي المنتخب جارية وهكذا في تاريخ البخاري ) الأنصاري عن أبيه عن جده ) .(@)(@@) 2857 - يا عمر إن القرآن كله صواب ما لم يجعل عذاب مغفرة ومغفرة عذابا .(@)(@@) % ( حم ) وسمويه عن إسحاق بن عبد الله بن أبي طلحة عن أبيه عن جده .(@)(@@) 2858 - دعوا المراء في القرآن فإن الأمم قبلكم لم يلعنوا حتى اختلفوا في القرآن إن مراء في القرآن كفر .(@)(@@) % ( أبو نصر السجزي ) في الابانة .(@)(@@) 2859 - لا تجادلوا بالقرآن ولا تبدلوا ( تكذبوا ) كتاب الله بعضه ببعض فوالله إن المؤمن ليجادل به فيغلب وإن المنافق ليجادل به فيطلب .(@)(@@) % ( الديلمي ) عن عبد الرحمن بن جبير بن نفير عن أبيه عن جده .(@)(@@) PageV01P307(@)(@@) 2860 - لا تماروا في القرآن فإن المراء فيه كفر .(@)(@@) % ( طب عن زيد بن ثابت ) ( الحسن بن سفيان عن سعد مولى عمرو بن العاص ) وقيل إنه تابعي .(@)(@@) 2861 - يا قوم بهذا أهلكت الأمم 
ms353	 قبلكم إن القرآن ليصدق بعضه بعضا فلا تكذبوا بعضه ببعض .(@)(@@) % ( طب ) عن ابن عمرو قال : خرج رسول الله صلى الله عليه وآله وسلم على قوم يتنازعون في القرآن قال : فذكره .(@)(@@) 2862 - لا تحملوا شيئا من القرآن إلى بلاد العدو .(@)(@@) % ( ابن أبي داود في المصاحف ) عن ابن عمر وهو صحيح .(@)(@@) 2863 - لا تسافروا بالقرآن إلى أرض العدو فإني أخاف أن يناله العدو .(@)(@@) % ( حل ابن أبي داود في المصاحف ك ) عن ابن عمر .(@)(@@) 2864 - إن أخذتها أخذت قوسا من نار .(@)(@@) % ( هق ) وضعفه عن أبي بن كعب قال علمت رجلا القرآن فاهدى لي قوسا فذكرت ذلك لرسول الله صلى الله عليه وسلم قال فذكره .(@)(@@) 2865 - جمرة بين كتفيك تقلد بها .(@)(@@) % ( طب ك ق ) عن عبادة ابن الصامت قال : اقرأت رجلا فأهدى لي قوسا فقال النبي صلى الله عليه وسلم : فذكره .(@)(@@) 2866 - إن كنت تحب أن تطوق بها طوقا من نار فاقبلها .(@)(@@) % ( حم ) وابن منيع وعبد بن حميد طب ( ك ص ق د ه ع ) عن عبادة بن الصامت مثل قصة أبي .(@)(@@) 2867 - إن أردت أن يقلدك الله قوسا من نار فخذها .(@)(@@) % ( حل ) عن أبي الدرداء مثله .(@)(@@) 2868 - من يأخذ على تعليم القرآن قوسا قلده الله قوسا من النار .(@)(@@) % ( طب ) عن أبي الدرداء .(@)(@@) 2869 - من أخذ على تعليم القرآن أجرا فقد تعجل حسناته في الدنيا والقرآن يحاجه يوم القيامة .(@)(@@) % ( أبو نعيم ) عن ابن عباس .(@)(@@) 2870 - علم القرآن على ثلاثة أجزاء حلال فاتبعه وحرام فاجتنبه ومتشابه يشكل عليك فكله إلى عالمه .(@)(@@) % ( الديلمي ) عن معاذ .(@)(@@) 2871 - من فسر القرآن برأيه وهو على وضوء فليعد وضوءه .(@)(@@) % ( الديلمي ) عن أبي هريرة .(@)(@@) 2872 - هلاك أمتي في الكتاب واللبن ، أما الكتاب فيقرؤون القرآن ويتألونه [ ويتأولونه ؟ ؟ ] على غير تأويله ويحبون اللبن فيبدون ( هامش المنتخب أي يسكنون البادية ) ويدعون الجماعات والجمع .(@)(@@) % ( حم هب ) أبونصر السجزي في الابانة عن عقبة بن عامر .(@)(@@) 2873 - لا تقرأ القرآن وأنت جنب .(@)(@@) % ( البزار عن علي وأبي موسى ) .(@)(@@) PageV01P308(@)(@@) 2874 - لا تمس المصحف وأنت غير طاهر .(@)(@@) % ( ابن أبي داود 
ms354	 في المصاحف عن عثمان بن العاص ) .(@)(@@) 2875 - لعن الله من فعل هذا لا تضعوا كتاب الله إلا موضعه .(@)(@@) % ( الحكيم ) عن عمر بن عبد العزيز قال : مر رسول الله صلى الله عليه وسلم بكتاب في الأرض قال فذكره .(@)(@@) 2876 - لا تمحوا كتاب الله بالأقدام .(@)(@@) % ( أبو نصر السجزي ) في الابانة وقال غريب عن معاذ .(@)(@@) 2877 - يا حامل القرآن تزين بالقرآن يزينك الله ولا تزين به للناس فيشينك الله وينبغي لحامل القرآن أن يكون أطول الناس ليلا إذا كان الناس ناموا وأن يكون أطول الناس حزنا إذا الناس فرحوا .(@)(@@) % ( الديلمي عن ابن مسعود ) .(@)(@@) 2878 - لا يجهر بعضكم على بعض فإن ذلك يؤذي المصلي .(@)(@@) % ( الخطيب عن جابر ) .(@)(@@) 2879 - أجل أنا اقرأه لبطن وأنتم تقرؤونه لظهر قالوا يا رسول الله ما البطن ؟ ( في المنتخب - ما البطن من الظهر ) قال اقرأ ( في المنتخب اقرأه ) اتدبره واعمل بما فيه وتقرؤونه أنتم هكذا وأشار بيده فأمرها .(@)(@@) % ( محمد بن نصر عن عمير بن هانئ ) قال : قالوا يا رسول الله إنا لنجد للقرآن منك ما لا نجده من أنفسنا إذا نحن خلونا قال : فذكره .(@)(@@) 2880 - حملة القرآن ثلاثة : أحدهم اتخذه متجرا ، والآخر يزهو به حتى لهو أزهى به من مزامير ( في المنتخب - من أمير على منبر ) على منبر فيقول : والله لا ألحن ولا يعييني فيه حرف فتلك الطائفة شرار أمتي ، وحمله آخر فسر له ( في المنتخب - فسربله ) جوفه وألهمه قلبه فاتخذ قلبه محرابا ، [ قلبه ؟ ؟ ] منه في عافية ونفسه منه في بلاء فأولئك أقل في أمتي من الكبريت الأحمر .(@)(@@) % ( أبو نصر السجزي في الابانة وابن السني والديلمي عن الحسن عن أنس ) قال أبو نصر غريب لم يروه غير مؤمل بن عبد الرحمن وفيه مقال والمحفوظ عن الحسن قوله .(@)(@@) 2881 - حملة العلم في الدنيا خلفاء الأنبياء وفي الآخرة من الشهداء .(@)(@@) % ( الخطيب عن ابن عمر ) .(@)(@@) 2882 - قراء القرآن ثلاثة : رجل قرأ القرآن فاتخذه بضاعة فاستحرمه ( في لسان الميزان فاستجر به الملوك ) الملوك واستمال به الناس ، ورجل قرأ القرآن فأقام حروفه وضيع حدوده كثر 
ms355	 هؤلاء من قراء القرآن لا كثرهم الله تعالى ورجل قرأ القرآن فوضع دواء القرآن على داء قلبه فاسهر به ليله واظمأ به نهاره وقاموا ( لسان الميزان - وقاموه ) في مساجدهم وحبوا به ( في المنتخب - فخنوا به وفي المجمع فخنوا يبكون - هو ضرب من البكاء ) تحت برانسهم فهؤلاء يدفع الله بهم البلاء ويزيل ( في المنتخب - يديل ) من الأعداء وينزل غيث السماء فوالله لهؤلاء ( ن - من قراء القرآن ) من القراء أعز من الكبريت الأحمر .(@)(@@) % ( حب في الضعفاء وأبو نصر السجزي في الابانة والديلمي عن بريدة ) وقال السجزي : غريب لم يروه غير أحمد بن متيم ( كذا وفي لسان الميزان ميثم وهو الصواب ) وفيه مقال ، ( هب عن الحسن قوله ) .(@)(@@) PageV01P309(@)(@@) | 1 ( المجلد الثاني ) 1(@)(@@)(@)(@@) | 1 ( الفصل الرابع في التفسير من فصول الباب السابع في القرآن وفضائله ، من الكتاب الثاني من حرف الهمزة في الأذكار من قسم الأقوال من كنز العمال في سنن الأقوال والأفعال ) 1(@)(@@) 2883 - الحمد لله رب العالمين ، هي السبع المثاني ، الذي أوتيت والقرآن العظيم .(@)(@@) % ( خ د عن سعيد ( بهامش الأصل ومنتخب كنز العمال ونسخة النظامية نظ ' عن أبي سعيد ' ) بن المعلى ) .(@)(@@) 2884 - السبع المثاني فاتحة الكتاب .(@)(@@) % ( ك عن أبي ) .(@)(@@) 2885 - اليهود مغضوب عليهم ، والنصارى ضلال .(@)(@@) % ( ت عن عدي بن حاتم ) .(@)(@@) 2886 - ( بقرة ) قيل لبني إسرائيل { ادخلوا الباب سجدا ، وقولوا حطة } . فبدلوا ، فدخلوا يزحفون على استاههم ، وقالوا حبة في شعيرة .(@)(@@) % ( حم ق د ت عن أبي هريرة ) .(@)(@@) 2887 - يجيء نوح وأمته ، فيقول الله : هل بلغت ؟ فيقول : نعم ، أي رب ، فيقول لأمته : هل بلغكم ؟ فيقولون : لا ، ما جاءنا من نبي ، فيقول : لنوح من يشهد لك ، فيقول : محمد وأمته ، وهو قوله تعالى : { وكذلك جعلناكم أمة وسطا لتكونوا شهداء على الناس } ، والوسط : العدل ، فتدعون فتشهدون له بالإبلاغ ، ثم أشهد عليكم .(@)(@@) % ( حم خ ت ن ه عن أبي سعيد ) .(@)(@@) 2888 - يجيء النبي ، يوم القيامة ، ومعه الرجل ، والنبي ومعه الرجلان ، ويجيء النبي ومعه الثلاثة ، وأكثر من ذلك ، فيقال له : هل بلغت قومك ؟ فيقول : نعم فيدعى قومه ، فيقال لهم : هل 
ms356	 بلغكم هذا ، فيقولون لا ، فيقال له : من يشهد لك ؟ فيقول : محمد وأمته ، فيدعى محمد وأمته ، فيقال لهم : هل بلغ هذا قومه ؟ فيقولون نعم ، فيقال(@)(@@) PageV02P003 وما علمكم ؟ فيقولون : جاءنا نبينا فأخبرنا : أن الرسل قد بلغوا ، فصدقناه ، فذلك قوله : { وكذلك جعلناكم أمة وسطا لتكونوا شهداء على الناس ويكون الرسول عليكم شهيدا } .(@)(@@) % ( حم ن ه عن أبي سعيد ) .(@)(@@) 2889 - إن وسادك إذا لعريض طويل ، إنما هو سواد الليل وبياض النهار .(@)(@@) % ( حم د عن عدي بن حاتم ) .(@)(@@) 2890 - ( آل عمران ) السبيل الزاد والراحلة .(@)(@@) % ( الشافعي ت عن ابن عمر ) ( هق عن عائشة ) .(@)(@@) 2891 - القنطار ألف أوقية .(@)(@@) % ( ك عن أنس ) .(@)(@@) 2892 - القنطار اثنتا عشرة ألف أوقية ، كل أوقية خير مما بين السماء والأرض .(@)(@@) % ( حب ه عن أبي هريرة ) .(@)(@@) 2893 - القنطار ألف أوقية ومائتا ( ومأتا ) أوقية .(@)(@@) % ( ابن جرير عن أبي ) .(@)(@@) 2894 - القنطار ألف ومائتا دينار .(@)(@@) % ( ابن جرير عن الحسن مرسلا ) .(@)(@@) 2895 - ( الأنعام ) قاتل الله اليهود ، إن الله عز وجل لما حرم عليهم الشحوم جملوها ثم باعوها ، فأكلوا أثمانها .(@)(@@) % ( حم ق - 4 - عن جابر ) ( ق عن أبي هريرة حم ق ن ه عن عمر ) .(@)(@@) 2896 - الطوفان الموت .(@)(@@) % ( ابن جرير وابن أبي حاتم وابن مردويه عن عائشة ) .(@)(@@) 2897 - ( الأعراف ) أصحاب الأعراف قوم قتلوا في سبيل الله ، بمعصية آبائهم ، فمنعهم من النار قتلهم في سبيل الله ، ومنعهم من الجنة معصية آبائهم .(@)(@@) % ( ص وعبد بن حميد ( هكذا في نظ - والمنتخب في الاصل ( وعبد الرحمن بن حميد - ح ) وابن منيع والحارث ( طب هق في البعث عن الرحمن المزني ) .(@)(@@) 2898 - لما حملت حواء طاف بها إبليس ، وكان لا يعيش لها ولد ، فقال : سميه عبد الحارث ، فإنه يعيش ، فسمته عبد الحارث ، فعاش ، وكان ذلك من وحي الشيطان وأمره .(@)(@@) % ( حم ت ك والضياء عن سمرة ) .(@)(@@) 2899 - ( الأنفال ) ألا إن القوة الرمي ، ألا إن القوة الرمي ، ألا إن القوة الرمي .(@)(@@) % ( حم م د ه عن عقبة بن عامر ) . زاد ( ت ( المنتخب ق ) ) ألا إن الله سيفتح لكم الأرض ، وستكفون المؤنة ، فلا يعجزن أحدكم أن يلهو بأسهمه 
ms357	 .(@)(@@) 2900 - ما منعك يا أبي أن تجيبني إذ دعوتك ؟ ألم تجد فيما أوحى الله إلي أن { استجيبوا لله وللرسول إذا دعاكم لما يحييكم } .(@)(@@) % ( حم ت ك عن أبي هريرة ) .(@)(@@) 2901 - ( التوبة ) يوم الحج الأكبر يوم النحر .(@)(@@) % ( ت عن علي ) .(@)(@@) PageV02P004(@)(@@) 2902 - أخر عني يا عمر ، إني خيرت فاخترت ، فقد قيل لي : { استغفر لهم أولا تستغفر لهم سبعين مرة فلن يغفر الله لهم } لو أعلم أني لو زدت على السبعين غفر له لزدت .(@)(@@) % ( ت ن عن عمر ) .(@)(@@) 2903 - إنما خيرني الله فقال { استغفر لهم أو لا تستغفر لهم إن تستغفر لهم سبعين مرة } وسأزيد على السبعين .(@)(@@) % ( م عن ابن عمر ) .(@)(@@) 2904 - السائحون هم الصائمون .(@)(@@) % ( ك عن أبي هريرة ) .(@)(@@) 2905 - ( يونس ) لما أغرق الله فرعون { قال آمنت أنه لا إله إلا الذي آمنت به بنو إسرائيل } قال جبريل : يا محمد لو رأيتني وأنا آخذ من حال البحر ، فأدسه في فيه ، مخافة أن تدركه الرحمة .(@)(@@) % ( حم ت عن ابن عباس ) .(@)(@@) 2906 - قال لي جبريل ( لفظة جبريل فيها ثمان لغات وأفصحها ما نطق بها القرآن في قراءة حفص وما جاء في الصحيحين وغيرهما في حديث الإسراء والمعراج وحديث الإسلام وغيرهما بكسر الجيم وسكون الباء وكسر الراء . ) لو رأيتني وأنا آخذ من حال البحر ، فأدسه في في فرعون مخافة أن تدركه الرحمة .(@)(@@) % ( حم ك عن ابن عباس ) .(@)(@@) 2907 - ( سبحان ) زوال الشمس دلوكها .(@)(@@) % ( فر عن ابن عمر ) .(@)(@@) 2908 - طائر كل إنسان في عنقه .(@)(@@) % ( ابن جرير عن جابر ) .(@)(@@) 2909 - طير كل عبد في عنقه .(@)(@@) % ( عبد بن حميد عن جابر ) .(@)(@@) 2910 - ( الكهف ) الغلام الذي قتله الخضر طبع يوم طبع كافرا ، ولو عاش لأرهق أبويه طغيانا وكفرا .(@)(@@) % ( م ت د عن أبي ) .(@)(@@) 2911 - ( مريم ) الورود الدخول ، لا يبقى بر ولا فاجر إلا دخلها ، فتكون على المؤمنين بردا وسلاما ، كما كانت على إبراهيم ، حتى إن للنار ضجيجا من بردهم ، { ثم ينجي الله الذين اتقوا ، ويذر الظالمين فيها جثيا } .(@)(@@) % ( حم ه في تفسيره ك عن جابر ) .(@)(@@) 2912 - إذا أحب الله عز وجل 
ms358	 عبدا نادى جبرئيل : أني قد أحببت فلانا فأحبه ، فينادي في السماء ، ثم تنزل له المحبة في أهل الأرض ، فذلك قوله تعالى : { إن الذين آمنوا وعملوا الصالحات سيجعل لهم الرحمن ودا } . وإذا أبغض الله عبدا نادى جبرئيل : أني قد أبغضت فلانا فينادي في السماء ، ثم تنزل له البغضاء في الأرض .(@)(@@) % ( ت عن أبي هريرة ) .(@)(@@) 2913 - ( المؤمنون ) ما منكم من أحد إلا وله منزلان ، منزل في الجنة ، ومنزل في النار ، فإذا مات فدخل النار ورث أهل الجنة منزله فذلك قوله : { هم الوارثون } .(@)(@@) % ( ه عن أبي هريرة ) .(@)(@@) 2914 - الربوة الرملة .(@)(@@) % ( ابن جرير وابن أبي حاتم وابن مردويه عن مرة البهزي ) .(@)(@@) PageV02P005(@)(@@) 2915 - ( النور ) البغايا اللاتي ينكحن أنفسهن بغير بينة .(@)(@@) % ( ت عن ابن عباس ) .(@)(@@) 2916 - ( النمل ) أحد أبوي بلقيس كان جنيا .(@)(@@) % ( أبو الشيخ في العظمة وابن مردويه في التفسير وابن عساكر عن أبي هريرة ) .(@)(@@) 2917 - ( القصص ) سألت جبرئيل أي الأجلين قضى موسى ؟ قال أكملهما وأتمهما .(@)(@@) % ( ع ( من المنتخب ونظ ) ك عن ابن عباس ) .(@)(@@) 2918 - ( الروم ) البضع ما بين الثلاث إلى التسع .(@)(@@) % ( طب وابن مردويه عن دينار بن مكرم ) .(@)(@@) 2919 - ألا أحطت ( المنتخب ونظ ' احتطت ' ) يا أبا بكر ؟ فإن البضع ما بين الثلاث إلى التسع .(@)(@@) % ( ت عن ابن عباس ) .(@)(@@) 2920 - ( لقمان ) من تمام النعمة دخول الجنة والفوز من النار .(@)(@@) % ( ت عن معاذ ) .(@)(@@) 2921 - خمس لا يعلمهن إلا الله ، إن الله عنده علم الساعة ، وينزل الغيث ، ويعلم ما في الأرحام ، وما تدرى نفس ماذا تكسب غدا ، وما تدري نفس بأي أرض تموت .(@)(@@) % ( حم والروياني عن بريدة ) .(@)(@@) 2922 - مفاتيح الغيب خمس لا يعلمها إلا الله : لا يعلم أحد ما يكون في غد إلا الله ، ولا يعلم أحد ما يكون في الأرحام إلا الله ، ولا يعلم متى تقوم الساعة إلا الله ولا تدري نفس أي شيء تكسب غدا ، ولا تدري نفس بأي ( هكذا في نظ وفي الأصل ' ولا في أرض ' - ح ) أرض تموت إلا الله ولا يعلم أحد متى يجيء المطر إلا الله تعالى .(@)(@@) % ( حم خ عن ابن عمر 
ms359	 ) .(@)(@@) 2923 - ( الأحزاب ) إني ذاكر لك أمرا ، ولا عليك ألا تعجلي حتى تستأمري أبويك ، إن الله تعالى قال : { يا أيها النبي قل لأزواجك } إلى قوله { عظيما } .(@)(@@) % ( ت ( المنتخب ونظ ' ق ' ) ن ه عن عائشة ) .(@)(@@) 2924 - ( فاطر ) إذا كان يوم القيامة نودي أين أبناء الستين ( كذا وفي المنتخب ونظ وفي الأصل ' السبيل ' ) وهو العمر الذي قال الله تعالى : { أو لم نعمركم ما يتذكر فيه من تذكر } .(@)(@@) % ( الحكيم طب هب عن ابن عباس ) .(@)(@@) 2925 - سابقنا سابق ، ومقتصدنا ناج ، وظالمنا مغفور له .(@)(@@) % ( ابن مردويه والبيهقي في البعث عن عمر ) .(@)(@@) 2926 - ( السجدة ) قد قال الناس ثم كفر أكثرهم ، فمن مات عليها فهو ممن استقام .(@)(@@) % ( ش ( بهامش الأصل ' ت ن ' وكذا في المنتخب ونظ ) عن أنس ) .(@)(@@) 2927 - ( واقعة ) لو طرح فراش من أعلاها لهوى إلى قرارها مائة خريف ، يعني { وفرش مرفوعة } .(@)(@@) % ( طب عن أبي أمامة ) .(@)(@@) PageV02P006(@)(@@) 2928 - إن من المنشآت اللاتي كن في الدنيا عجائز عمشا رمصا .(@)(@@) % ( ت عن أنس ) .(@)(@@) 2929 - ( الطور ) الركعتان قبل صلاة الفجر إدبار النجوم ، والركعتان بعد المغرب إدبار السجود .(@)(@@) % ( ك عن ابن عباس ) .(@)(@@) 2930 - إدبار النجوم الركعتان قبل الفجر ، وإدبار السجود الركعتان بعد المغرب .(@)(@@) % ( خط ( بهامش الاصل والمنتخب ونظ ' ت ' ) عن ابن عباس ) .(@)(@@) 2931 - ( اقترب ) آخر أربعاء في الشهر يوم نحس مستمر .(@)(@@) % ( وكيع في الغرر ( هكذا في المنتخب ونظ - وفي الأصل بدلها ' الضرر ' ) وابن مردويه في التفسير خط عن ابن عباس ) .(@)(@@) 2932 - ( ن والقلم ) العتل الزنيم الفاحش اللئيم .(@)(@@) % ( ابن أبي حاتم عن موسى بن عقبة مرسلا ) .(@)(@@) 2933 - العتل كل رحيب ( المنتخب ونظ - رغيب ) الجوف ، وثيق الحلق ( هكذا في المنتخب ونظ - وفي الاصل - الحلق ) أكول شروب جموع للمال ، منوع له .(@)(@@) % ( ابن مردويه عن أبي الدرداء ) .(@)(@@) 2934 - ( المدثر ) فتر عني الوحي فترة ، فبينا أنا أمشي سمعت صوتا من السماء ، فرفعت بصري قبل السماء ، فإذا أنا بالملك الذي أتاني في غار حراء على سرير ، بين السماء والأرض ، فجثت منه فرقا ، حتى هويت إلى الأرض ، فأتيت خديجة فقلت دثروني دثروني ، فدثرت ، فجاء جبرئيل فقال برجله : { يا أيها 
ms360	 المدثر قم فأنذر وربك فكبر وثيابك فطهر والرجز فاهجر } .(@)(@@) % ( الطيالسي حم م عن جابر ) .(@)(@@) 2935 - الصعود جبل من نار ، يتصعد فيه الكافر سبعين خريفا ، ثم يهوي فيه كذلك أبدا .(@)(@@) % ( حم ت حب ك عن أبي سعيد ) .(@)(@@) 2936 - ( النازعات ) كلمتان قالهما فرعون ما علمت لكم من إله غيري إلى قوله { أنا ربكم الأعلى } كان بينما أربعون عاما ، فأخذه الله نكال الآخرة والأولى .(@)(@@) % ( ابن عساكر عن ابن عباس - ( هكذا في هامش الأصل والمنتخب ونظ وفي الأصل بدلها عن أنس ) ) .(@)(@@) 2937 - ( المطففين ) ويل ، واد في جهنم يهوي فيه الكافر أربعين خريفا ، قبل أن يبلغ قعره .(@)(@@) % ( حم ت حب ك عن أبي سعيد ) .(@)(@@) 2938 - الران ( كذا في الاصل ونظ ، وهذه قطعة اقتطعت من الحديث لا يظهر معناها بدون ذكر باقيه وهو ' أن العبد إذا أذنب ذنبا نكتت في قلبه نكتة سوداء فإن تاب ونزع واستغفر الله صقل قلبه وإن عاد زادت حتى تعلو قلبه فذلك الران ' كما في تفسير الألوسي - ح ) الذي ذكر الله { كلا بل ران على قلوبهم ما كانوا يكسبون } .(@)(@@) % ( حم ت ك ن ه حب هب عن أبي هريرة ) .(@)(@@) 2939 - ( البروج ) اليوم الموعود يوم القيامة ، والشاهد يوم الجمعة ، والمشهود يوم عرفة ، ويوم الجمعة ذخره الله لنا ، وصلاة الوسطى صلاة العصر .(@)(@@) % ( طب عن أبي مالك الأشعري ) .(@)(@@) PageV02P007(@)(@@) 2940 - اليوم الموعود يوم القيامة ، واليوم المشهود يوم عرفة ، والشاهد يوم الجمعة ، وما طلعت الشمس ، ولا غربت ، على يوم أفضل منه ، فيه ساعة لا يوافقها عبد مسلم ، يدعو الله بخير ، إلا استجاب الله له ، ولا يستعيذ من شيء إلا أعاذه الله منه .(@)(@@) % ( ت هق عن أبي هريرة ) .(@)(@@) 2941 - الشاهد يوم عرفة ، ويوم الجمعة والمشهود هو الموعود ، يوم القيامة .(@)(@@) % ( ك هق عن أبي هريرة ) .(@)(@@) 2942 - ( الطارق ) ضمن الله خلقه أربعا : الصلاة والزكاة وصوم رمضان والغسل من الجنابة ، وهن السرائر ، التي قال الله : { يوم تبلى السرائر } .(@)(@@) % ( هب عن أبي الدرداء ) .(@)(@@) 2943 - ( الفجر ) العشر عشر الأضحى ، والوتر يوم عرفة ، والشفع يوم النحر .(@)(@@) % ( حم ك عن جابر ) .(@)(@@) 2944 - إن العشر 