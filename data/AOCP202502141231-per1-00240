ms221	 فرق نهاده کژ، کلاه سنجاب(@)(@@)(@@)(@@) | سعد لحافی(@)(@@) ~~2205 می آمد و، مشک بر قمر می افکند شام سر زلف، بر سحر می افکند(@)(@@) (@@) پیش قد او، سرو همی کرد سجود %~% وز شرم رخش، ماه سپر می افکند(@)(@@)(@@)(@@) | جمال خلیل(@)(@@) (@@) 2206 می آمد و، شیوههای موزون می کرد %~% در بردن دل، هزار افسون می کرد(@)(@@) ~~2207 می آمد دوش، آنکه به رخ ماه سماست در هر قدمی، به عشوه می برد(@)(@@) دلی %~% اوله %~% نابرده هنوز، در زمان خون می کرد %~% می کرد نظاره آنگهی، از چپ و راست(@)(@@) (@@) ابروش، به تیر غمزه خونم می ریخت %~% وله %~% چشمش به زبان حال عذرم می خواست(@)(@@) ~~22،8 دل شاد شود، چواندر آیی زدرم یکن، چو کنی به باز رفتن خبرم(@)(@@) (@@) آواز همی دهد به تو، جان زبرم %~% کآهسته همی رو، که منت بر اثرم!(@)(@@)(@@)(@@) | وله(@)(@@) ~~2209 چون برگذری بخندم و برگذرم یعنی که: من از عشق تو آهسته ترم!(@)(@@) (@@) ورخنده کنی، نگاه کن بر اثرم %~% ول %~% کاندر پی تو، چگونه گریان نگرم PageV01P379(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0383.jpg)(@)(@)(@@)(@@)(@@) | صدر خجندی(@)(@@) (@@) 2211 از نزد من ای دلبر دلدار، مرو %~% این بار منه بر من، این بار مرو(@)(@@) (@@) گر تو بروی، جان و دل من برود %~% زنهار مخور با من، زنهار مرو!(@)(@@)(@@)(@@) | شمس سجاسی(@)(@@) (@@) 2212 ای دیدهآ من، زدیده چون آب مرو %~% در کار دلم، چو بخت در خواب مرو(@)(@@) (@@) تو دولتی، آهسته بیا چون دولت %~% توعمر منی، چوعمر مشتاب، مروا(@)(@@) (@@) 2213 دی، از برم آن یار پسندیده برفت %~% اوله %~% آرام و قرار، از دل شوریده برفت(@)(@@) (@@) نتوانستم ز اشک، دیدن رویش %~% تا چشم زدم، چو اشکم از دیده برفت(@)(@@) وجمال] عبد الرزاق(@)(@@) (@@) 2214 دلدار، ز دور روی بنمود و برفت %~% یک لحظه به نزد ما نیاسود و، برفت(@)(@@) (@@) آن صبر که خود نداشتم، پاک ببرد %~% وان دل که مرا نبود، بر بود و برفت(@)(@@)(@@)(@@) | سید اشرف(@)(@@) (@@) 2215 آن بت، که به انصاف نکوبود برفت %~% حورا صفت وفرشته خوبود، برفت 
ms222	(@)(@@) (@@) آسایش عمرم همه او داشت، ببرد %~% و آرامش جانم همه او بود، برفت(@)(@@)(@@)(@@) | صدر خجندی(@)(@@) (@@) 2216 ای عشق تو آمیخته با گوهر من %~% از بوی تو، خشک شد دماغتر من(@)(@@) (@@) آن زهره ندارم، که من [آیم] برتو %~% وان بخت ندارم، که توآیی بر من(@)(@@)(@@)(@@) | کمال(@)(@@) (@@) 2217 آن سرو سهی، چو در چمن می آمد %~% رخ چون گل و، عارض چو سمن می آمد(@)(@@) (@@) زیر قدمش، زمین جان می بوسید %~% الغیره %~% کاواز لبش، به گوش من می آمد(@)(@@) (@@) 2218 می رفت و، زمین به زلف مشکین می رفت %~% با سیمبران، به خنده گوهر می سفت(@)(@@) (@@) دل، بر حرکات او ثناها می خواند %~% جان، بر لب ودندانش دعاها می گفت PageV01P380(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0384.jpg)(@)(@)(@@)(@@)(@@) | کمال(@)(@@) ~~2219 ز آمد شدن تو، گرچه باشم در وایتاظن نبری، کز تو بگردانم رای(@)(@@) (@@) چندان که روی و آیی، ای شهر آرای %~% همچون نفست، در دل من باشد جای(@)(@@) (@@) 222 تیری، که چو در خود کشمت دور شوی %~% وله %~% ماهی، که شوی غریب هر مه به نوی(@)(@@) (@@) اشکی، که چو در چشم من آیی بدوی %~% عمری، که همان دم که در آیی، بروی!(@)(@@)(@@)(@@) | اوله(@)(@@) ~~بنشین، که تو نور دیدهای، اشک نه ای 2221 شرط است که چون رخ بنمایی،(@)(@@) بروی %~% کان لحظه که در چشم من آیی، بروی! %~% وزدیدهآ من خون بگشایی، بروی(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 2221 بی آنکه به آمدن قدم رنجانی %~% هر روز، مرا به وعدهای بنشانی(@)(@@) (@@) صد عذر نکو، نیامدن را دانی %~% یک حیله، برای آمدن نتوانی!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 2222 در هر عمری، دمی که دمساز آیی %~% آن هم، به دو صد کرشمه و ناز آیی(@)(@@) (@@) وانگه که شوی رنجه، نیایی بر من %~% چندانکه بپرسمت که: کی باز آیی؟(@)(@@)(@@)(@@) | غیره(@)(@@) (@@) چون غنچه، نقاب بسته آیی بر من 2229 هر دم ز برم رخت نوردی بروی %~%(@)(@@) وآنگه چونقاب باز کردی، بروی %~% در نامده، زود باز گردی بروی(@)(@@)(@@)(@@) | ایمین(@)(@@) ~~2225 غافل بودم، که یاربر ما بگذشتچون برق، به رهگذار برما بگذشت 
ms223	(@)(@@) (@@) نادیده رخش تمام، تا چشم زدیم %~% چون راحت روزگار برما بگذشت(@)(@@)(@@)(@@) | عزیز(@)(@@) (@@) 2226 عهدی با [ما چوآبستی، ای بینایی %~% باید که بدان عهد، وفا بنمایی(@)(@@) (@@) یا چون جانم، مقیم باشی دربر %~% بیا چون نسفا، گر بسر وی بازاسح PageV01P381(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0385.jpg)(@)(@)(@@)(@@)(@@) | نمط نوزدهم(@)(@@) درنشست وخاست او(@)(@@)(@@)(@@) | لااعرف(@)(@@) (@@) 2227 نزدیک من ای راحت جانم که تویی %~% تو آمدهای، من نه برآنم که تویی(@)(@@) (@@) در پیش من خستهآ برخاسته دل %~% چندان بنشین، که من بدانم که تویی!(@)(@@)(@@)(@@) | اشهری(@)(@@) (@@) 2228 یک دم، دل تو چه مصلحت می بیند؟ %~% کآزار دل خستهآ من برچیند(@)(@@) (@@) نشین که از این نشست اگر برخیزی %~% صد غصه، ز برخاستنت بنشیند(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~2229 بوسه، زلب نگار خویشم باید چون بوسه دهد هزار، بیشم باید(@)(@@) ~~زان سان، که نشسته است اندردل من هر جا که بود نشسته، پیشم باید(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 2230 جانا، به هوای دل نهانی بنشین %~% با خسته دل سوخته جانی بنشین(@)(@@) (@@) چون آمدهای، از سر پا باز مگرد %~% دست من و دامنت، زمانی بنشین!(@)(@@)(@@)(@@) | الغیره(@)(@@) ~~2231 آمد بر من آنکه از او دین برود هوش از دل مستمند مسکین برود(@)(@@) (@@) نتوانم گفتنش که: بنشین و مرو %~% ترسم که چو گویمش که بنشین، برود!(@)(@@)(@@)(@@) | کمال خجندی(@)(@@) ~~2232 دلدار، چو در نشاط می آویزدبس شور که از دو زلف می انگیزد(@)(@@) (@@) گر بنشیند، صبر زمن بنشیند %~% گر برخیزد، قیامتی برخیزد!(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~2236 گفتی که: من از غمت حمایت بکنم در حق تو، این یکی عنایت بکنم(@)(@@) (@@) باری چو نمی کنی خدا[یا]، بر من %~% چندان بنشین، که این حکایت بکنم(@)(@@)(@@)(@@) | پسر افضل(@)(@@) (@@) گفتم که: مبرجان مرا، گفتا: هی 2234 آمد چو سهی سرو، بت دل شکنم %~%(@)(@@) بنشست زدور، تا برد جان زتنم %~% جانی دگرت هست، جزاین جان که منم؟(@)(@)PageV01P382(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0386.jpg)(@)(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~2235 آمد بر من نشست، کردم واخواست تعجیل کنان، باز ز پیشم برخاست(@)(@@) (@@) ویخته صد پردهآ کژ، از سر عذر %~% پرداخته صد دروغ، از پردهآ راست(@)(@@) (@@) 2236 با خوش پسری 
ms224	 که اهل باشد، بنشین %~% لغیره %~% چندانکه زعمر مهل باشد، بنشین(@)(@@) (@@) گر نرد گرو ببازد، این نکته بگو: %~% کزمن زرو از توسهل باشد، بنشین!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 2237 هر دم به تو، خشمی دگرم برخیزد %~% ترسم، که زعشقت اثرم برخیزد(@)(@@) (@@) آن روز، که ساعتی برم بنشینی %~% الغیره %~% بیم است، که عالم به سرم برخیزد(@)(@@) (@@) 2238 یارب، چه بود که گفت و گوبنشیند %~% در پیش من، آن یار نکو بنشیند(@)(@@) (@@) آخر، نه قیامت ازجهان برخیزد %~% گر با من دلسوخته، او بنشیند!(@)(@@)(@@)(@@) | شمس سجاسی(@)(@@) (@@) 223 یاری که مرا به دیدن او هوسی است %~% آمد بر من یک دم و، این لطف بسی است(@)(@@) (@@) گفتم که: یکی نفس نشستی، بمرو %~% گفتا: بروم، که جانم و جان نفسی است!(@)(@@)(@@)(@@) | جمال خلیل(@)(@@) ~~224 عمری است، که آن نگار با ما ننشست هر گزبه مراد ما، به یک جا ننشست(@)(@@) (@@) امروز، که بعد مدتی باز آمد %~% پر بود زدمتتم، از سر پا ننشست(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 2241 عمری، به برم نیایی و بستیزی %~% تا در دم و دام دوریم آویزی(@)(@@) (@@) وانگه که بیایی، آتش آرزوم %~% ننشسته هنوز، از برم برخیزی!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) «224 بنشست برم، آنکه دل و جانم خواست %~% برخاست دگر باره، دل و جانم کاست(@)(@@) (@@) برخاست غم از دلم، چوپیشم بنشست %~% غم در دل من نشست، چون او برخاست(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 22،3 بنشست برم، آنکه مرا کام و هواست %~% حالی برخاست یار، رفتن آراست(@)(@@) (@@) بنشست غبار غم من، چون بنشست %~% برخاست قیامتی زمن، چون برخاست PageV01P383(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0387.jpg)(@)(@)(@@)(@@)(@@) | نمط بیستم(@)(@@) درخنده وشادی او(@)(@@)(@@)(@@) | لاادری(@)(@@) (@@) 2244 هرگه که بخندد، آن نگار دلبند %~% از شکر و یاقوت، فرو بارد قند(@)(@@) (@@) خورشید ز چرخ گوید: ای سر و بلند %~% خوش می خندی، باز دگر بار بخند(@)(@@)(@@)(@@) | کمال اسماعیل(@)(@@) ~~2245 با نوش لب تو، چشمهآ حیوان کیست؟پیش دهن تو، غنچهآ خندان کیست؟(@)(@@) ~~وانجا، که شکر خنده زند یاقوتت طوطی که بود، شکر چه باشد، جان کیست؟(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 2246 دلدار، زچهره پرده بگشود به روز %~% صد نور 
ms225	 دگر، زنو در افزود به روز(@)(@@) (@@) از زلف ورخش، نمود مهتاب به شب %~% وزخنده، لبش ستاره بنمود به روز(@)(@@)(@@)(@@) | اثیر(@)(@@) ~~2247 با هر که بخنبدی، اگرم خویش بود آن بر دل من، ز مرگ من بیش بود(@)(@@) (@@) من خود دانم، کزتوخطایی ناید %~% لیکن، دل عاشقان بداندیش بود!(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~2248 سیماب رخت خون زنظر می ریزد تومی روی و، جمال و فر می ریزد(@)(@@) (@@) یارب، که زبهر نقل جانها هر دم %~% لغیره %~% آن پستهآ خندان، چه شکر می ریزد!(@)(@@) ~~2249 جانا، زتو خنده گرچه نیکوست مخنددشمن چو گریست بر من، ای دوست مخند(@)(@@) ~~یکرو یه چولاله شو، برون آی زپوست دو رو یه چو گل مباش، در پوست مخند!(@)(@@)(@@)(@@) | الغیره(@)(@@) ~~2250 ای طوق هلاک گرد پروین بسته دل در تو، چومن هزار مسکین بسته(@)(@@) ~~بگشای به خنده لب، که خوش نیست چنین ای خسرو خوبان، لب شیرین بسته(@)(@@)(@@)(@@) | الغیره(@)(@@) ~~2251 با من، چو گل ارشبی بپیوندد یار ننشسته هنوز، رخت بر بندد یار(@)(@@) (@@) چون کوزه، به ده دیده همی گریم من %~% چون گل، به هزارلب همی خندد یارا PageV01P384(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0388.jpg)(@)(@)(@@)(@@)(@@) | شرف محمد(@)(@@) ~~2252 بر گریهآ زار من، توای دوست مخند وین خندهآ خوش گرچه تورا خوست، مخند(@)(@@) (@@) س خنده مزن، بدین دل غمخواره %~% ور زانکه ضرورت است، در پوست مخند!(@)(@@)(@@)(@@) | شهاب مؤید(@)(@@) (@@) 225 چشمم، ز غمت چوابر نوروز گریست %~% هر قطره چو شمع، ازیکی سوز گریست(@)(@@) (@@) خوش خند مها، که بر من اندرغم تو %~% دشمن، به هزار دیده امروز گریست(@)(@@)(@@)(@@) | مجیر بیلقانی(@)(@@) (@@) 2254 با من چوشبی به وصل در پیوندد %~% ننشسته هنوز، رخت بر می بندد(@)(@@) (@@) بنشینم و، در فراق او می گریم %~% برخیزد و، بر گریهآ من میخندد!(@)(@@)(@@)(@@) | رشید وطواط(@)(@@) (@@) وهست بهار حسن و، خالی نبود 2255 چون ابر، زعشق یار می گریم زار %~%(@)(@@) از گریهآ ابر وخندهآ برق، بهار! %~% وز گریهآ من، چو برق می خندد یار(@)(@@)(@@)(@@) | مهذب شروانی(@)(@@) (@@) 225 ای دوست مکن ستم، که من بندهآ تو %~% بیچاره 
ms226	 و آواره و افکندهآ تو(@)(@@) (@@) بر گریهآ زار من ببخشای و، مخند %~% ای جان و دلم فدای یک خندهآ تو!(@)(@@)(@@)(@@) | معین(@)(@@) (@@) 2251 صد لطف، در آن عارض فرخنده نگر %~% در پای کشان، زلف پراکنده نگر(@)(@@) (@@) بر گریهآ من، از آن دو بادام فراخ %~% آن پستهآ تنگ را، شکر خنده نگر(@)(@@)(@@)(@@) | عایشه(@)(@@) ~~2251 ای روی لطافت همه سوی لب تو تشویر خورد لعل، زروی لب تو(@)(@@) (@@) یک خنده بزن هین، که پر وبال بزد %~% جان بر لب من، در آرزوی لب تو!(@)(@@)(@@)(@@) | حلیل(@)(@@) (@@) 2251 با من، سر زلفش از سر کین می گفت: %~% (خون می خور وجان می ده!» تا این می گفت(@)(@@) (@@) می کرد به غمزه، نرگسش نفرینم %~% لعلش، به زبان خنده آمین می گفت!(@)(@@)(@@)(@@) | اله(@)(@@) ~~2260 طبع تو، چو گه گهی مشوش باشد پای دل من، بر سر آتش باشد(@)(@@) ~~توطوطی حسنی، ای شکر خنده بخندطوطی که شکر خنده زند، خوش باشد!(@)(@)PageV01P385(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0389.jpg)(@)(@)(@@) (@@) 2261 چون لعل شکر خند تو، بر خنده زند %~% وله %~% بر شکر و بر پستهآ تر، خنده زند(@)(@@) (@@) مه پسته مه شکر [و]، مه طوطی، چولبت %~% برگریهآ عاشقان، شکر خنده زند!(@)(@@) نمط بیست ویکم(@)(@@)(@@)(@@) | در غم و گریه(@)(@@)(@@)(@@) | لاادری(@)(@@) (@@) 2662 ای کرده دلم خراب، آباد بزی! %~% وی بند تو بر جان من، آزاد بزی!(@)(@@) (@@) بر دل ززمانه گرغمی هست، تورا %~% آن نیز به من حواله کن، شاد بزی!(@)(@@)(@@)(@@) | جمال اشهری(@)(@@) (@@) 2263 آکنده به غم، چون دل من کم بینی %~% زین غم، همه دیدهها پرازنم بینی(@)(@@) (@@) چندین غم خویشتن چه گویی؟ یک ره %~% گرد دل من بر آی، تا غم بینی!(@)(@@)(@@)(@@) | غیره(@)(@@) (@@) 2264 جانا، دل من همیشه تیمار خورد %~% تا بتواندی انده دلدار خورد(@)(@@) (@@) بر گریه مکن تکیه، که آن نرگس تر %~% پژمرده شود، چو آب بسیار خورد!(@)(@@)(@@)(@@) | بغیره(@)(@@) ~~2265 در عشق تو، آن دمم که پروای خود است7 جانم ز تو، مشغول به غمهای خود است(@)(@@) ~~هر غم، که تورا مطابق رای خود است بر 
ms227	 خاطر بنده نه، که بر جای خود است!(@)(@@)(@@)(@@) | هستی(@)(@@) ~~2266 جانا، تو ز دیده اشک بیهوده مباردلتنگی من بس است، دل تنگ مدار(@)(@@) (@@) تومعشوقی، گریستن کار تونیست %~% کار من بیچاره، به من باز گذار!(@)(@@)(@@)(@@) | شمس(@)(@@) ~~2267 یار ار بکشد تورا، چوجیحون گرید نی نی غلطم، چواو کشد چون گرید؟(@)(@@) ~~آری! چه عجب؟ وی آهنین دل ترنیست از تیغ، که برکشتهآ خود خون گرید!(@)(@@)(@@)(@@) | للهیر(@)(@@) (@@) 2228 آن روز، که بخت من زمن برگردد %~% در عشق تو مردنم، میسر گردد(@)(@@) (@@) در حسرت آنم که، که خواهد عذرت؟ %~% چون چشم ثو، درماتم من تر گردد!(@)(@)PageV01P386(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0390.jpg)(@)(@)(@@)(@@)(@@) | الغیره(@)(@@) ~~2669 ای اصل نشاط و کامگاری، خوش باشوی گوهر تاج شهریاری، خوش باش(@)(@@) (@@) من ناخوش از آنم، که دلی نیست مرا %~% باری تو که صد هزار داری، خوش باش!(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 227 گر زانکه تورا، غم دلی روی نمود %~% بس تنگدلی، از آن ببایست فزود(@)(@@) (@@) پر بوی دل سوخته می آمد، غم %~% زان پیش توآمد، که دلم پیش توبود(@)(@@)(@@)(@@) | کمال اسماعیل(@)(@@) (@@) 2271 آمد بر من مست خراب، از مجلس %~% پرسید که: در هجر که داری مونس؟(@)(@@) (@@) حالم چو بدید، غمزهای بر هم زد %~% بر لاله، شکوفه می فشاند از نرگس(@)(@@)(@@)(@@) | لغیر5(@)(@@) (@@) 2272 گر من مردم، ز مردنم بی غم باش %~% برخیز و بیا و، ساعتی خرم باش(@)(@@) (@@) از مردن من، که گفت: درماتم باش؟ %~% رندی زمیان عاشقان، گو کم باش!(@)(@@) ~~گفتا که: مبر به دیدهآ من این ظن 2272 گفتم که: در آن دو چشم پرحیله(@)(@@) و فن %~% الغیره %~% عایشه %~% کان، عکس دو چشم توست در دیدهآ من! %~% اشک از چه قبل گرفت ای ماه، وطن؟(@)(@@) ~~2270 جان را چه خطر؟ اگر تو سرکش نه امی ا اینهمه بدخویی وبد عهدی تو(@)(@@) %~% من خوشدلمی، اگر تو ناخوش نه امی! %~% خوش خوش دلمی، گر تو مشوش نه امی(@)(@@)(@@)(@@) | سنایی(@)(@@) ~~گفتم به ضرورتش که: ای مشکین خال 227 دیدمش: دریده پیرهن، رفته زحال(@)(@@) %~% امروز چنانی، که من از 
ms228	 تو همه سال! %~% وز خون دو دیده، نرگسش مالامال(@)(@@)(@@)(@@) | جمال خلیل(@)(@@) (@@) 2276 تا کی، زمیانه بر کرانت بینم؟ %~% وز شکر لب، سرکه فشانت بینمم(@)(@@) (@@) با اینهمه، دلگران نیم از غم تو %~% هم دل ندهد، که دلگرانت بینم.(@)(@)PageV01P387(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0391.jpg)(@)(@)(@@) نمط بیست ودوم(@)(@@) دربیماری وبهی او(@)(@@)(@@)(@@) | لاادری(@)(@@) (@@) 2271 از رنج تن ارچه ناتوانی، ای دوست %~% خوش باش، که جاوید بمانی ای دوست(@)(@@) (@@) جان را نبود زوال، دانی ای دوست %~% الغیره %~% تو جانی، پیدا نه نهانی ای دوست!(@)(@@) (@@) 2278 شک نیست، که در دیده و دل نوری تو %~% این دیده، مبیناد دگر دوری تو!(@)(@@) (@@) یارب، که همیشه دشمنانت را باد %~% ای راحت جان بنده، رنجوری توا(@)(@@) (@@) 2279 عیشم زغمت، همیشه ناخوش بادا %~% بغیره %~% چون زلف تو، حال من مشوش بادا!(@)(@@) (@@) وان رنج، که از تب به تو دلدار رسید %~% هم، بر تن وجان من غمکش بادا!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 2280 شد همچو کمان، این قد همچون تیرم %~% آمد گه آن که دل زجان برگیرم(@)(@@) (@@) نالنده تویی، ولیک من می کاهم %~% بیمارتویی، ولیک من میمیرم!(@)(@@)(@@)(@@) | الغیره(@)(@@) ~~2281 تا رنگ به روی یار می آید بازبویی، زگل و بهار می آید باز(@)(@@) (@@) جانی، به دل فگار می آید باز %~% دل، با سر کار و بارمی آید باز(@)(@@)(@@)(@@) | رکن [خویی؟](@)(@@) ~~2282 تا ناوک سینه ها بود مژگانتافسونگر دردها بود مرجانت(@)(@@) ~~چون، درد بدید آن لب افسون خوانت از بیم لبت، گریخت در دندانت(@)(@@)(@@)(@@) | صدرخجندی(@)(@@) ~~2283 چشم سیه تو را ندانم که چه بود کامروز به چشم بندهات سرخ نمود(@)(@@) (@@) از خواب در آمدهست، یا خود نغنود %~% یا جامه بر او فتاده، یا خون که بود؟(@)(@@) (@@) 2284 از چشم تو، صد زخم درشت است مرا %~% چون زلف تو، زان خمیده پشت است مرا(@)(@@) (@@) با چشم بگو، نهفته دار آن سرخی %~% تا کس بنداند که، که کشتهست مرا PageV01P388(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0392.jpg)(@)(@)(@@)(@@)(@@) | دردرد چشم(@)(@@) ~~2285 چشم ترکت، به کینه دوش از سردستتیر مژه، در کمان ابرو پیوست(@)(@@) (@@) تا گوش کشید، بر 
ms229	 دلم زد زانسان %~% کزخون دلم، دو قطره در چشم تو جست(@)(@@)(@@)(@@) | ایضا(@)(@@) (@@) 2286 چشم تو، که پر سحر و فسون افتاده ست %~% با سحر و فسون، شیفته چون افتاده ست؟(@)(@@) (@@) تا عاقبت کار، از آن شیفتگی %~% امروز چو در میان خون افتادهست(@)(@@)(@@)(@@) | حاجی شروانی(@)(@@) (@@) 2287 چشم توز درد، اگر چه بد می بیند %~% یک جرم زمن، نکرده صد می بیند(@)(@@) (@@) صد درد نهاد بر دل من، چه عجب %~% سنایی %~% چشم تو، اگر یکی به خود می بیند(@)(@@) (@@) 2288 چشمت که جهان جمله فسونش بگرفت %~% خواهی که بگویمت، که چونش بگرفت؟(@)(@@) (@@) آن سرخی چشم، از تبش صفرا نیست %~% عشاق زبس که کشت، خونش بگرفت!(@)(@@)(@@)(@@) | مهستی(@)(@@) (@@) 2289 با تب گفتم: رنجه مکن بسیارش %~% از بهر خدای، بگذر و بگذارش!(@)(@@) (@@) تب گفت که: برتنش زمن بیش ملرز %~% غیرها %~% آخر، زتو [من] گرمترم در کارش!(@)(@@) (@@) 2290 تا در لب توشهد سخن ور باشد %~% نشگفت، اگر شهد تب آور باشد!(@)(@@) (@@) شاید، که تب تو حسن پرور باشد %~% خورشید، به تب لرزه نکوتر باشد!(@)(@@)(@@)(@@) | الغیرها(@)(@@) (@@) 2291 شد صحت من، در سر بیماری تو %~% آسانی من بود، ز دشخواری تو(@)(@@) (@@) بیخواب شدم، زرنج بیداری تو %~% خونریز شدم، زناله و زاری تو(@)(@@)(@@)(@@) | سیفی(@)(@@) ~~2292 بیداری من به شب، زبیداری توست وین زار گرستنم، هم از زاری توست(@)(@@) (@@) من بیمارم به دل، توبیمار به تن %~% اوله %~% بیماری من، نیز ز بیماری توست(@)(@@) ~~2293 گر یافت به جانب تو، بیماری راه از بیماری نشد، جمال توتباه(@)(@@) (@@) رخسارهآ ماه بود بیماری ابر %~% هر گز نفتد تغتر از ابربه ماه PageV01P389(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0393.jpg)(@)(@)(@@) ~~2294 از درد گلو، برتوهمی رنج آیدبشنو زرهی، تا سببش بنماید(@)(@@) (@@) شیرین لب تو، تو را همی بگزاید %~% از شیرینی، درد گلو افزاید!(@)(@@)(@@)(@@) | عزیز شروانی(@)(@@) ~~2295 از روی لطافت، ای مه گل رخسار بر روی تو دارد، آتش و آب قرار(@)(@@) ~~روی، از نفس گرم نگه دار این بارآتش چو به گل رسد، زکام آرد بار(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 2296 بر وصل 
ms230	 تو فتنه بود، جانا تب تو %~% کردش زتو دور، خواهش و یارب تو(@)(@@) (@@) بگریست، ز هجر زلف همچون شب تو %~% اشکش در گشت، بر عقیق لب تو(@)(@@)(@@)(@@) | معزی(@)(@@) (@@) 2297 چشمم که به بوسه دادن، ای سیمین بر %~% یک قطره چکانید، به یاقوت تو بر(@)(@@) (@@) زان اشک، هنوز بر لبت هست اثر %~% بفسرد زباد سردم آن اشک، مگر؟(@)(@@) نمط بیست وسوم(@)(@@) درسفر ووداع وباز آمدن(@)(@@) اسعد گنجه ای(@)(@@) ~~2298 ای راحت جان، دلم مرنجان به سفر منمای مرا بلای هجران، به سفر(@)(@@) ~~رحم آر، بر آنکه بی جمالت او را(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 2209 گر هجر توام، نماید ایام به چشم %~% از بخت بد اوفتم، سرانجام به چشم(@)(@@) (@@) عزم سفرت شنیدم ای ماه، به گوش %~% آن را که شنیده ام، مبینام به چشم!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 2300 حاشا، که به عشقت از غم جان ترسم %~% وز محنت وانده فراوان ترسم(@)(@@) (@@) تو جان منی و، میروی از بر من %~% معذورم، اگر ز رفتن جان ترسم(@)(@@) (@@) 230 ای راه جفا سپرده، زین راه برو %~% اوله %~% یک گام، به کام این نکو خواه برو(@)(@@) (@@) سا ترک سفر بگوی و، فارغ بنشین %~% یا ماتم من بدار و، آنگاه بروا PageV01P390(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0394.jpg)(@)(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 2302 رفتم، به وداع روی شهر آرایش %~% بگرفته، عنان رخش مه پیمایش(@)(@@) ~~او جیب دلم گرفت و، من دامن اواو در سر من فتاد و، من در پایش(@)(@@)(@@)(@@) | شمس سجاسی(@)(@@) ~~230 ای از بر من شکسته پیمان، رفته دشوار شمرده هجر، آسان رفته(@)(@@) (@@) گر بی تو بمیرم، نبود هیچ عجب %~% کس زنده بدید، آدمی جان رفته؟(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~230 رفتی و، دلم در آرزوی تو بماند در شهر تو، بر امید روی تو بماند(@)(@@) (@@) یوسته، در انتظار باز آمدنت %~% چون شیفتگان، بر سر کوی تو بماند(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 2304 در کام من، از فراق توزهر بماند %~% مسکین دلم، از نشاط بی بهر بماند(@)(@@) (@@) ای دوست، غم غریبی وتنهایی %~% لغیره %~% آن را باشد، که بی تو در شهر بماند!(@)(@@) (@@) 230 
ms231	 چون بشنیدم، که یار می آید باز %~% آبیم، به روی کار می آید باز(@)(@@) (@@) دم دم، ز دو چشمم آب می گردد کم %~% خوش خوش، به دلم قرار می آید باز!(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 2307ای دل، ز ره دراز می آید یار %~% خوش باش، که دلنواز می آید یار(@)(@@) (@@) ای صبر ز دل رمیده، در فرقت او %~% بازآی به تگ، که باز می آید یار!(@)(@@)(@@)(@@) | ادیب ابوبکر شروانی(@)(@@) (@@) 2308 آن مایهآ عیش وناز، خواهد آمد %~% وان آرزو و نیاز، خواهد آمد(@)(@@) (@@) شاد است دلم، چو کبک بر کوه غمش %~% لغیره %~% اومید بدان که باز خواهد آمد!(@)(@@) ~~2300 چاکر، چو نیارست وداع جان کرد روی از تو گه وداع، زان پنهان کرد(@)(@@) (@@) جانی تو و بنده زین سبب معذور است %~% کآسان آسان، وداع جان نتوان کرد!(@)(@@)(@@)(@@) | صدر زنگانی(@)(@@) (@@) 2310 یارب، که تو در سفر میازار او را %~% در عصمت خود بدار از آزان، اورا(@)(@@) (@@) چون کام دل خبود ز سفر بردارد %~% نزدیک من غمزده، باز آر او را PageV01P391(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0395.jpg)(@)(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 2311 هر جا که بود منزل و مأوا او را %~% بادا همه کام دل، مهیا او را(@)(@@) (@@) یارب، به خداییت به زودی برسان %~% ما را بر او، یا به بر ما او را(@)(@@)(@@)(@@) | صدر خجندی(@)(@@) (@@) 2312 بگذاشت مرا به دست بیداد و، برفت %~% خون جگرم ز دیده بگشاد و، برفت(@)(@@) (@@) بر آتش من، آب زد ار روز وصال %~% چون خاک، مرا به باد برداد و برفت(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 2313 دلبر دل من ببرد و، آزاد برفت %~% بکذاشت مرا به درد و او شاد برفت(@)(@@) (@@) چشمم پرآب گشت و، دل پر آتش %~% خاکم بر سر فشاند و، چون باد برفت(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 2314 اکنون، که وداع ناگهان آمد پیش %~% رفتی، ز جدایی تو شد جانم ریش(@)(@@) (@@) دل را، توبه یاد گار می دار که من %~% درد تو، به یادگار دارم با خویش!(@)(@@)(@@)(@@) | الغیره(@)(@@) ~~2315 بیچاره کسی، که دلستانش برود یا سرو قدی ز بوستانش برود 
ms232	(@)(@@) (@@) تو جان منی، از بر من دور شدی %~% چون باشد حال آنکه جانش برود؟(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 2316 با من به گه وداع گفت آن دلجوی: %~% من زود آیم، تو دل ز اندیشه بشوی!(@)(@@) (@@) گفتم: صنما، تواین سخن آن را گوی %~% کاو زنده بود، چون تو بگردانی روی!(@)(@@)(@@)(@@) | الغیره(@)(@@) ~~2317 آن شب، که وداع کرد دلدار مرا دل گفت، پس از خروش بسیار مرا:(@)(@@) (@@) گر تو ز پیش نمی روی، من باری %~% رفتم، به دعا یاد همی دار مرا!(@)(@@)(@@)(@@) | فخرهروی(@)(@@) (@@) 2318 هنگام وداع آنچه دلبر می کرد %~% می کرد خروش و خاک بر سر می کرد(@)(@@) (@@) گاه از تف سینه خشک می گشت لبش %~% گاه از نم دیده آستین تر می کرد(@)(@@)(@@)(@@) | الغیره(@)(@@) ~~2310 از سینه، دل ریش پریشان بردی(@)(@@) ~~جانم بردی، ولی من اینک زپیات PageV01P392(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0396.jpg)(@)(@)(@@)(@@)(@@) | شرف شفروه(@)(@@) ~~2320 سوی سفر دراز، رای آوردیما را چو زمین، به زیر پای آوردی(@)(@@) (@@) روزی گفتی به ناز: من می بروم %~% الغیره %~% از هرچه بگفتی، این به جای آوردی!(@)(@@) (@@) 232 می رفت و، زدیده اشک باران می کرد %~% گریان گریان، وداع یاران می کرد(@)(@@) (@@) آنجا، به وصال مرده را جان می داد %~% اینجا، زفراق زنده بیجان می کرد(@)(@@)(@@)(@@) | نصیر گنجه ای(@)(@@) (@@) 2321 از گرد ره، آن نگار دمساز آمد %~% در خنده و [با] کرشمه و ناز آمد(@)(@@) (@@) آن نور ز چشم رفته، آمد وا چشم %~% وان جان زتن رفته، به تن باز آمد(@)(@@) (@@) 2322 ای بر دل من جور توز اندازه برون %~% الغیره %~% افتاد میی زحمیت (4) آوازه برون(@)(@@) (@@) تو عزم سفر کردی و، می خواهد رفت %~% الغیره %~% جان با تو، عیان زبام و دروازه برون(@)(@@) (@@) 2324 ای رفته و، دل ز مهر ما کرده بری %~% پیوسته زعشق، در دل بنده دری(@)(@@) (@@) ترسم که تو آیی و، نباشم برجای %~% کاین دنیا منزل است و، ما رهگذری!(@)(@@)(@@)(@@) | سید اشرف(@)(@@) (@@) 2326 دل، خیمه میان سنبل و سوسن زد %~% خاریم نهاد و، تکیه بر گلشن زد(@)(@@) (@@) این 
ms233	 رای سفر بین که، برای من زد %~% جان بار برون نهاد [ه] و دل تن زد(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~2320 گفتم که مگر داد وصالت بدهم روزی دو سه، از جور غمت باز رهم(@)(@@) (@@) اکنون که همی روی، مرا در بر گیر %~% الغیره %~% تا هم [ز فراق] سنگ بر دل ننهم(@)(@@) (@@) 2327 در نامدن وداعت، ای شمع طراز %~% دانی که چه عذر بودم، ای مایهآ ناز؟(@)(@@) (@@) زان ترسیدم، که اشک من سیل شود %~% ثی %~% گرد تو در آید، زرهت دارد باز!(@)(@@) ~~2328 هنگام شدن، داد نگار ختنم یک حلقه ززلف خویش، پیچان چوتنم PageV01P393(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0397.jpg)(@)(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~2329 آن سرو خرامان، به چمن باز رسید وان جان سفر کرده، به تن باز رسید(@)(@@) (@@) ضایع نشد آن آه شب و، گریهآ روز %~% دولت نظری کرد و، به من باز رسید!(@)(@@) (@@) 2330 دیدم که دلم، ز دست غم می برود %~% الغیره %~% جان عزم درست کرد، هم می برود(@)(@@) (@@) گفتم: چه فتادهست؟ سگ کویت گفت: %~% از من نشنیدی! آن صنم می برود!(@)(@@)(@@)(@@) | جمال خلیل(@)(@@) ~~2331 آن روز، که دهر کرد از او فرد مرا نگذاشت، ذخیره ای به جز درد مرا(@)(@@) (@@) امروز عجبتر، که پس از عهد دراز %~% هم درد دل آورد، بهاورد مرا!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 2332 تا چند کنی چومه تمنای سفر %~% تا کی پزی ای نگار، سودای سفر(@)(@@) (@@) هم، طالع ماست این، وگرنه زین پیش %~% وله %~% نه روی سفر بودت و، نه رای سفر!(@)(@@) (@@) 2333 ای از پی دانه طالب دام سفر %~% وی گشته دل تو، توسن رام سفر(@)(@@) (@@) جان ازتن من، عزم سفر خواهد کرد %~% زین بیش، اگر بری دگر نام سفر!(@)(@@) نمط بیست وچهارم(@)(@@) در هر جاییی و بیوفایی او(@)(@@)(@@)(@@) | صدر خجندی(@)(@@) (@@) 2334 ای دریتیم، ماه را می مانی %~% وی خرمن سیم، ماه را می مانی(@)(@@) (@@) 2335 ای تازه گل شکفته، جز خارنه ای هرجایی و بی حفاظی و نیکوروی %~%(@)(@@) وله %~% سیبی به دو نیم ماه را می مانی %~% وی همچو مه دو 
ms234	 هفته، بی بار نه ای(@)(@@) (@@) حانی، نه شگفت اگر پدیدار نهای %~% عمری، چه عجب اگر وفادار نه ای!(@)(@@)(@@)(@@) | ساوی(@)(@@) ~~2336 عشق تو، همی برد مرا جای به جای گردان چودل توای صنم، رای به رای!(@)(@)PageV01P394(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0398.jpg)(@)(@)(@@) (@@) لیکن، چو فلک لعب نمایی دگری 2324 چون زهره، بتا طرب فزایی دگری %~%(@)(@@) رشید %~% وز چهره، چو صبح دلگشایی دگری %~% چون ماه به هر دو روز، جایی دگری(@)(@@)(@@)(@@) | بوالبقا(@)(@@) (@@) 233 بیهوده به هر جای، هوا کس نکند %~% یاران قدیم را، رها کس نکند(@)(@@) (@@) شادند ایشان و، این قدر نشناسند %~% با ما چو وفا نکرد، با کس نکند!(@)(@@)(@@)(@@) | برهان گنجه ای(@)(@@) (@@) 2339 ای هر نفسی بستهآ بند هوسی هر روز به جایی و، به کس پیوندی %~%(@)(@@) لغیره %~% تا کی باشی، در هوسی هر نفسی %~% زینگونه، به جایی نرسد هیچ کسی!(@)(@@) (@@) 234 در کار، من سوخته خرمن غلطم %~% راضی شدن از توبه دل وتن، غلطم(@)(@@) (@@) گفتم، به غلط مگر وفایی بکنی %~% توبر سر عادت خودی، من غلطم!(@)(@@) ~~234 آن به که دل از توبر کنم، تا برهم چون بر سر من، پای نداری به(@)(@@) وفا %~% الغیره %~% انوری %~% نام تو ز خود بیفگنم، تا برهم %~% دست از توبه دیگری زنم، تا برهم(@)(@@) (@@) 23 من، عهد بدت به نیک برداشته ام %~% گفتار کژتو، راست پنداشته ام(@)(@@) (@@) ل، تا برود ز چشم من چشمهآ خون %~% تا از تو، چرا چشم وفا داشتهام!(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~زو چشم وفا دارم، هم خود گویم: 23،3 آن بت، که بود بی رخ او خوارم(@)(@@) چشم %~% سنگرز که؟ و آنگاه چه می دارم چشم! %~% بی او، بدل اشک همی بارم چشم(@)(@@)(@@)(@@) | بوحنیفهآ اسکاف(@)(@@) (@@) 2344 گر گل نشدی، مساز با هر خاری %~% ور ماهی، منمای به جز دیداری(@)(@@) (@@) چون دولت، هر دو روز گیری جایی %~% ظهیر %~% بد مهر تر از زمانه ای، بسیاری!(@)(@@) (@@) 23،5 معشوقه، چو سر بکرد با باد چوگل %~% تن با همه کس به وصل در داد، چوگل(@)(@@) (@@) چون غنچه کشیده داشت دامن، 
ms235	 یک چند %~% امروز، به دست هر کس افتاد چو گل!(@)(@)PageV01P395(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0399.jpg)(@)(@)(@@)(@@)(@@) | علیا(@)(@@) (@@) 2346 دل، در کف [آن] مه که کنون افتادهست %~% از دایرهآ وفا، برون افتادهست(@)(@@) (@@) هرگز نبرد به عمرها، نام وفا %~% پنداری، با وفاش خون افتادهست!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 2347 یک چند، وفای توبه جان می جستم %~% از خاک سیه، آب روان می جستم(@)(@@) (@@) دیوانه بدم ز عشق تو، دور ازتو %~% کزعالم نیستی، نشان می جستم(@)(@@) نمط بیست وپنجم(@)(@@) در عهد شکستن و کناره گرفتن او(@)(@@)(@@)(@@) | خوارزمشاه(@)(@@) (@@) 2348 من، عهد تو سخت سست می دانستم %~% بشکتن آن، درست می دانستم(@)(@@) (@@) این بد عهدی، که کردی ای دوست به من %~% آخر کردی، نخست می دانستم!(@)(@@)(@@)(@@) | غیره(@)(@@) (@@) 2349 یارم، به وفا دری که نگشاد ببست %~% بگسست طناب صحبت ناپیوست(@)(@@) (@@) افسوس، که وصل ناپدیدش گم شد %~% هیهات، که عهد نادرستش بشکست!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 2350 شب نیست، که من یاد وصالت نکنم %~% وزتو گلهآ تو، با خیالت نکنم(@)(@@) (@@) از من بحلی، به هر جفایی که کنی %~% برکشتن بی سبب حلالت نکنم!(@)(@@)(@@)(@@) | شهاب(@)(@@) (@@) 2351 در لطف، به نکتهآ سخن می مانی %~% در خشم، به مهر تیغ زن می مانی(@)(@@) (@@) در پرده دری، به اشک من می مانی %~% وزبد عهدی، به خویشتن می مانی!(@)(@@) (@@) 2352 زین پس، نه غم توای ستم جوونه من %~% عزیز %~% نه گفت و شنید با توبد خوو، نه من(@)(@@) (@@) رویی، که کسی دگر ببوسید و گزید %~% گر خون شود این دو دیده، نه او و نه من!(@)(@@)(@@)(@@) | صدر(@)(@@) ~~235 از یک دل و نیم جان، چه برخواهد خاست وزکشتن عاشقان، چه برخواهد خابست؟(@)(@@) ~~بکباره اره جست و، بنشست به عیش PageV01P396(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0400.jpg)(@)(@)(@@)(@@)(@@) | کمال اصفهانی(@)(@@) (@@) 235 نزدیک من، از شرم و زتیمار نهان %~% باریک کنی همه تن خود، چومیان(@)(@@) (@@) وزشادی و عیش، در کنار دگران %~% چندان باشی، که در نگنجی به جهان(@)(@@) (@@) 2357 شادی خواندم به نام، غمهای تورا %~% اوله %~% دادم لقب انصاف، ستمهای تورا(@)(@@) (@@) رفتی تو و، بر من دگری بگزیدی %~% اوله %~% 