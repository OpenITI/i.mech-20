ms61	 خصرها برمانتين ، فطلقني ونكحها ، فنكحت بعده رجلا سريا ، ركب شريا ، وأخذ خطيا ، وأراح علي نعما ثريا ، وأعطاني من كل رائحة زوجا ، فقال كلي أم زرع وميري أهلك ، فلو جمعت كل شيء أعطانيه ما ملأ أصغر إناء من آنية أبي زرع ) ، ( طب ) عن ع$ ائشة رضي الله عنها ، ورواه ( خ ت ) في الشمائل موقوفا ، إلا قوله كنت لك كأبي زرع لام زرع فرفعه قالوا : وهو يؤيد رفع الحديث كله .(@)(@@)(@@)(@@) $ ( 472 ) قال النبي :(@)(@@) | 30 ( اجتمعوا على طعامكم واذكروا اسم الله يبارك لكم فيه ) )(@)(@@) ( حم د ه حب ك ) عن وحشي بن حرب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 473 ) قال النبي :(@)(@@) | 30 ( اجتنب الغضب ) )(@)(@@) ( ابن أبي الدنيا في ذم الغضب وابن عساكر ) عن رجل من الصحابة .(@)(@@) PageV01P095(@)(@@)(@@)(@@) $ ( 474 ) قال النبي :(@)(@@) | 30 ( اجتنبوا التكبر فإن العبد لا يزال يتكبر حتى يقول الله تعالى : اكتبوا عبدي هاذا في الجبارين ) )(@)(@@) ( أبو بكر بن لآل في مكارم الأخلاق وعبد الغنى بن سعيد في إيضاح الإشكال ) ( عد ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 475 ) قال النبي :(@)(@@) | 30 ( اجتنبوا الخمر فإنها مفتاح كل شر ) )(@)(@@) ( ك هب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 476 ) قال النبي :(@)(@@) | 30 ( اجتنبوا السبع الموبقات : الشرك بالله ، والسحر ، وقتل النفس التي حرم الله إلا بالحق ، وأكل الربا ، وأكل مال اليتيم ، والتولي يوم الزحف ، وقذف المحصنات المؤمنات الغافلات ) )(@)(@@) ( ق د ن ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 477 ) قال النبي :(@)(@@) | 30 ( اجتنبوا الكبائر السبع : الشرك بالله ، وقتل النفس ، والفرار من الزحف ، وأكل مال اليتيم ، وأكل الربا ، وقذف المحصنة ، والتعرب بعد الهجرة ) )(@)(@@) ( طب ) عن سهل بن أبي حثمة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 478 ) قال النبي :(@)(@@) | 30 ( اجتنبوا الكبائر وسددوا وأبشروا ) )(@)(@@) ( ابن جرير ) عن قتادة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 479 ) قال النبي :(@)(@@) | 30 ( اجتنبوا الوجوه لا تضربوها ) )(@)(@@) ( عد ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 480 ) قال النبي :(@)(@@) | 30 ( اجتنبوا دعوات المظلوم ما بينها وبين الله حجاب ) )(@)(@@)(@@)(@@) $ ( 4 ) عن أبي سعيد وأبي هريرة معا رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 481 ) قال النبي :(@)(@@) | 30 ( اجتنبوا كل 
ms62	 مسكر ) )(@)(@@) ( طب ) عن عبد الله بن مغفل رضي الله عنه .(@)(@@)(@@)(@@) $ ( 482 ) قال النبي :(@)(@@) | 30 ( اجتنبوا ما أسكر ) )(@)(@@) ( الحلواني ) عن علي رضي الله عنه .(@)(@@) PageV01P096(@)(@@)(@@)(@@) $ ( 483 ) قال النبي :(@)(@@) | 30 ( اجتنبوا مجالس العشيرة ) )(@)(@@) ( ص ) عن أبان بن عثمان مرسلا .(@)(@@)(@@)(@@) $ ( 484 ) قال النبي :(@)(@@) | 30 ( اجتنبوا هاذه القاذورات التي نهى الله تعالى عنها ، فمن ألم بشيء منها فليستتر بستر الله وليتب إلى الله فإنه من يبد لنا صفحته نقم عليه كتاب الله ) )(@)(@@) ( ك هق ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 485 ) قال النبي :(@)(@@) | 30 ( اجثوا على الركب ثم قولوا يا رب يا رب ) )(@)(@@) ( أبو عوانة والبغوي عن سعد ) رضي الله عنه .(@)(@@)(@@)(@@) $ ( 486 ) قال النبي :(@)(@@) | 30 ( أجرؤكم على الفتيا أجرؤكم على النار ) )(@)(@@) ( الدارمي عن عبد الله بن جعفر مرسلا ) .(@)(@@)(@@)(@@) $ ( 487 ) قال النبي :(@)(@@) | 30 ( أجرؤكم على قسم الجد أجرؤكم على النار ) )(@)(@@) ( ص ) عن سعيد بن المسيب مرسلا .(@)(@@)(@@)(@@) $ ( 488 ) قال النبي :(@)(@@) | 30 ( اجعل بين أذانك وإقامتك نفسا حتى يقضي المتوضىء حاجته في مهل ، ويفرغ الآكل من طعامه في مهل ) )(@)(@@) ( عم ) عن أبي وأبو الشيخ في الأذان عن سلمان وعن أبي هريرة رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 489 ) قال النبي :(@)(@@) | 30 ( اجعل في دعائك : اللهم ارزقني لذة النظر إلى وجهك ، والشوق إلى لقائك ) )(@)(@@) ( الحكيم ) عن زيد بن ثابت رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 490 ) قال النبي :(@)(@@) | 30 ( اجعلوا آخر صلاتكم بالليل وترا ) )(@)(@@) ( ق د ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 491 ) قال النبي :(@)(@@) | 30 ( اجعلوا أئمتكم خياركم فإنهم وفدكم فيما بينكم وبين ربكم ) )(@)(@@) ( قط هق ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 492 ) قال النبي :(@)(@@) | 30 ( اجعلوا بينكم وبين الحرام سترا من الحلال من فعل PageV01P097 ذالك استبرأ لعرضه ودينه ، ومن أرتع فيه كان كالمرتع إلى جنب الحمى يوشك أن يقع فيه ، وإن لكل ملك حمى ، وإن حمى الله في الأرض محارمه ) )(@)(@@) ( حب طب ) عن النعمان بن بشير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 493 ) قال النبي :(@)(@@) | 30 ( اجعلوا بينكم وبين النار حجابا ولو بشق تمرة ) )(@)(@@) ( طب ) عن فضالة بن عبيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 494 ) قال النبي 
ms63	 :(@)(@@) | 30 ( اجعلوا من صلاتكم في بيوتكم ولا تتخذوها قبورا ) )(@)(@@) ( حم ق د ) عن ابن عمر رضي الله عنهما . ( ع ) والروياني والضياء عن زيد بن خالد ومحمد بن نصر في الصلاة عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 495 ) قال النبي :(@)(@@) | 30 ( اجلدوا في قليل الخمر وكثيره فإن أولها حرام وآخرها حرام ) )(@)(@@) ( هق ) عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 496 ) قال النبي :(@)(@@) | 30 ( اجلس فقد آذيت وآنيت ) )(@)(@@) قاله للذي تخطى يوم الجمعة ( حم د ن حب ك هق ) عن عبد الله بن بسر ( ه ) عن جابر رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 497 ) قال النبي :(@)(@@) | 30 ( اجلس يا أبا تراب ) )(@)(@@) قاله لعلي ( خ ) عن سهل بن سعد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 498 ) قال النبي :(@)(@@) | 30 ( اجلس يا خال فإن الخال والد ) )(@)(@@) ( قط ) في الأفراد عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 499 ) قال النبي :(@)(@@) | 30 ( أجلوا الله يغفر لكم ) )(@)(@@) ( حم ( 4 ) ع طب ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 500 ) قال النبي :(@)(@@) | 30 ( أجملوا في طلب الدنيا فإن كلا ميسر لما كتب له منها ) ) PageV01P098(@)(@@) ( ه ك طب هق ) عن أبي حميد الساعدي رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 501 ) قال النبي :(@)(@@) | 30 ( أجوع الناس طالب العلم ، وأشبعهم الذي لا يبتغيه ) )(@)(@@) ( أبو نعيم ) في كتاب العلم ( فر ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 502 ) قال النبي :(@)(@@) | 30 ( أجيبوا الداعي ولا تردوا الهدية ولا تضربوا المسلمين ) )(@)(@@) ( حم خد طب هب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 503 ) قال النبي :(@)(@@) | 30 ( أجيبوا هاذه الدعوة إذا دعيتم لها ) )(@)(@@) ( ق ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 504 ) قال النبي :(@)(@@) | 30 ( أجيفوا أبوابكم ، واكفؤوا آنيتكم ، وأوكوا أسقيتكم ، وأطفئوا سرجكم ، فإنهم لم يؤذن لهم بالتسور عليكم ) )(@)(@@) ( حم ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 505 ) قال النبي :(@)(@@) | 30 ( اجتمع في يومكم هاذا عيدان فمن شاء منكم أجزأه الجمعة فإنا مجمعون إن شاء الله ) )(@)(@@) ( خط ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 506 ) قال النبي :(@)(@@) | 30 ( اجتمعوا على القرآن ما ائتلفتم عليه فإذا اختلفتم 
ms64	 فقوموا ) )(@)(@@) ( طب ) ( حل ) عن جندب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 507 ) قال النبي :(@)(@@) | 30 ( اجتنبوا دعوات المظلوم ) )(@)(@@) ( ش ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 508 ) قال النبي :(@)(@@) | 30 ( اجتنبوا اللاعنين الذي تبرز في طريق الناس أو في PageV01P099 مجلس قوم ) )(@)(@@) ابن الجارود وأبو عوانة عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 509 ) قال النبي :(@)(@@) | 30 ( اجتنبوا هاذه الكعبات الموسومة التي يزجر بها زجرا فإنها من الميسر ) )(@)(@@) ( طب ) عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 510 ) قال النبي :(@)(@@) | 30 ( اجتنبوا هاذه القاذورة التي نهى الله عنها فمن ألم بشيء منها فليستتر بستر الله ولا يعد ) )(@)(@@) الديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 511 ) قال النبي :(@)(@@) | 30 ( اجعل صديعها قميصا وأعط صاحبتك صديعا ، مرها تجعل تحتها شيئا لئلا يصف هاذا ) )(@)(@@) ( ك ) عن دحية رضي الله عنه .(@)(@@)(@@)(@@) $ ( 512 ) قال النبي :(@)(@@) | 30 ( أجعلتني لله عدلا بل ما شاء الله وحده ) )(@)(@@) ( هق ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 513 ) قال النبي :(@)(@@) | 30 ( اجعلها في قرابتك ) )(@)(@@) ( ن ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 514 ) قال النبي :(@)(@@) | 30 ( اجعلوا مكان الدم خلوقا ) )(@)(@@) ( حب ) عن عائشة رضي الله عنها قالت : كانوا في الجاهلية إذا عقوا عن الصبي خضبوا قطنة بدم العقيقة فاذا حلقوا رأس الصبي وضعوها على رأسه فقال النبي فذكره .(@)(@@)(@@)(@@) $ ( 515 ) قال النبي :(@)(@@) | 30 ( اجعلوا ثلثين في الطيب وثلثا في الثياب ) )(@)(@@) ابن سعد عن علباء بن أحمر اليشكري أن عليا رضي الله عنه تزوج فاطمة فباع بعيرا له بثمانين وأربعمائة درهم فقال النبي فذكره .(@)(@@)(@@)(@@) $ ( 516 ) قال النبي :(@)(@@) | 30 ( اجعلوا في بيوتكم من صلاتكم واعمروها بالقرآن فان أفقر البيوت بيت لا يقرأ فيه كتاب الله عز وجل ) )(@)(@@) الديلمي عن أبي هريرة رضي الله عنه ، وفيه جبارة بن المغلس .(@)(@@)(@@)(@@) $ ( 517 ) قال النبي :(@)(@@) | 30 ( اجعلوها على وجهه واجعلوا على قدميه من هاذا الشجر ) )(@)(@@) ( طب ) عن أبي أسيد الساعدي رضي الله عنه قال : إنا مع رسول الله PageV01P100 على قبر حمزة رضي الله عنه فجعلوا يجرون النمرة على وجهه فتنكشف قدماه ، ويجرونها على قدميه فينكشف وجهه قال 
ms65	 فذكره .(@)(@@)(@@)(@@) $ ( 518 ) قال النبي :(@)(@@) | 30 ( أجل ولاكني مسست ذكري فنسيت أن أتوضأ ) )(@)(@@) ( هب ) عن يحيى بن أبي كثير أن النبي صلى الصبح ثم عاد لها فقيل له إنك قد كنت صليت قال فذكره .(@)(@@)(@@)(@@) $ ( 519 ) قال النبي :(@)(@@) | 30 ( أجل أنا أقرؤه لبطن وأنتم تقرؤونه لظهر ، قالوا : يا رسول الله ما البطن من الظهر ؟ قال : أقرؤه وأتدبره وأعمل بما فيه ، وتقرؤونه أنتم هاكذا وأشار بيده فأمرها ) )(@)(@@) محمد بن نصر عن عمير بن هانىء قال : قالوا : يا رسول الله إنا لنجد للقرآن منك ما لا نجده من أنفسنا إذا نحن خلونا قال فذكره .(@)(@@)(@@)(@@) $ ( 520 ) قال النبي :(@)(@@) | 30 ( أجل فلا تقل له مثل ما قال لك ولاكن قل : يغفر الله لك يا أبا بكر ) )(@)(@@) ( ط حم طب ك ) و البغوي والباوردي عن ربيعة بن كعب الأسلمي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 521 ) قال النبي :(@)(@@) | 30 ( اجلس أحدثك عن الصلاة وعن الصوم ، إن الله وضع شطر الصلاة عن المسافر ، ووضع الصوم عن المسافر والمريض والحامل ) )(@)(@@) ( طب ) عن أنس بن مالك رجل من كعب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 522 ) قال النبي :(@)(@@) | 30 ( اجلس يا خال فان الخال والد ، يا خال ألا أعلمك كلمات من أراد الله به خيرا علمه إياهن ، قل اللهم إني ضعيف فقو في رضاك ضعفي ، وخذ إلى الخير بناصيتي واجعل إلاسلام منتهى رضاي ، وبلغني برحمتك الذي أرجو من رحمتك ) )(@)(@@) ( قط ) في الأفراد عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 523 ) قال النبي :(@)(@@) | 30 ( اجلسوا في منازلكم فإنكم أوتادها ، من خطا إلى المسجد خطوة كان له بها أجر ) )(@)(@@) ( سمويه ض ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 524 ) قال النبي :(@)(@@) | 30 ( اجلسوا كلوا بسم الله ، كلوا من جوانبها ولا تأكلوا من PageV01P101 فوقها فإن البركة تنزل من فوقها ) )(@)(@@) ( ك ) عن واثلة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 525 ) قال النبي :(@)(@@) | 30 ( اجلسوا اذكروا اسم الله وكلوا من أسفلها ولا تأكلوا من أعلاها فإن البركة تنزل عليها من أعلاها ) )(@)(@@) ( هب ) عن واثلة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 526 ) قال النبي :(@)(@@) | 30 ( اجلسي لا يتحدث الناس أن محمدا يغزو 
ms66	 بامرأة ) )(@)(@@) ابن سعد عن أم كبشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 527 ) قال النبي :(@)(@@) | 30 ( أجملوا في طلب الدنيا فإن الله قد تكفل بأرزاقكم ، وكل ميسر له عمله الذي كان عاملا ، استعينوا الله على أعمالكم فانه يمحو ما يشاء ويثبت وعنده أم الكتاب ) )(@)(@@) ( هق كر ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 528 ) قال النبي :(@)(@@) | 30 ( أجيبوا الداعي وعودوا المريض وأطعموا الجائع وفكوا العاني ) )(@)(@@) ( طب ) عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) ||| ( الهمزة مع الحاء(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 529 ) قال النبي :(@)(@@) | 30 ( أحب الأديان إلى الله تعالى الحنيفية السمحة ) )(@)(@@) ( حم خد طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 530 ) قال النبي :(@)(@@) | 30 ( أحب الأسماء إلى الله عبد الله وعبد الرحمان ) )(@)(@@) ( م د ت ه ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 531 ) قال النبي :(@)(@@) | 30 ( أحب الأسماء إلى الله عبد الله وعبد الرحمان والحارث ) )(@)(@@) ( ع ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 532 ) قال النبي :(@)(@@) | 30 ( أحب الأسماء إلى الله ما تعبد له ، وأصدق الأسماء همام وحارث ) )(@)(@@) الشيرازي في الألقاب ( طب ) عن ابن مسعود رضي الله عنه .(@)(@@) PageV01P102(@)(@@)(@@)(@@) $ ( 533 ) قال النبي :(@)(@@) | 30 ( أحب الأعمال إلى الله أدومها وإن قل ) )(@)(@@) ( هق ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 534 ) قال النبي :(@)(@@) | 30 ( أحب الأعمال إلى الله الحب في الله والبغض في الله ) )(@)(@@) ( حم ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 535 ) قال النبي :(@)(@@) | 30 ( أحب الأعمال إلى الله الصلاة لوقتها ، ثم بر الوالدين ، ثم الجهاد في سبيل الله ) )(@)(@@) ( حم ه ق د ن ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 536 ) قال النبي :(@)(@@) | 30 ( أحب الأعمال إلى الله أن تموت ولسانك رطب من ذكر الله ) )(@)(@@) ( حب ) و ابن السنى في عمل يوم وليلة ( طب هب ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 537 ) قال النبي :(@)(@@) | 30 ( أحب الأعمال إلى الله إيمان بالله ، ثم صلة الرحم ، ثم الأمر بالمعروف والنهي عن المنكر ، وأبغض الأعمال إلى الله الإشراك بالله ، ثم قطي