ms511	 این جمله رهی هست گواه(@)(@@) 21 زان چو افگند کسی را فلک از عجز همی %~% نتواند ز یکی حادثه آورد به راه(@)(@@) 22 او چو من بی‌هنری را به چنان صدر رفیع %~% به یکی نکته رسانید بدین رتبت و جاه(@)(@@) 23 گر همی پای نهم پیش تو آنجا که نهند %~% شهریاران ز پی جاه بر آن جای جباه(@)(@@) 24 اینت بی‌حد کرم و لطف و بزرگی و شرف %~% در یکی شخص مرکب شده سبحان الاه(@)(@@) 25 که برافزون شدم از یک سخنش در یک روز %~% همچو پنجی که دوم مرتبه گردد پنجاه(@)(@@) 26 ای به صحرای سخای تو شب و روز چو من %~% زده امید همه از در آن لشگرگاه(@)(@@) 27 تا بدین وقت ز هر نوع شنیدی اشعار %~% شعر نیکو شنو اکنون که فراز آمدگاه(@)(@@) 28 برگها زرد شد اکنون ز کف سبز خطی %~% تا سپیدی نبود زان گهر لعل بخواه(@)(@@) 29 تا گه حمله قوی نبود روباه چو شیر %~% تا گه حیله فزون نبود شیر از روباه(@)(@@) 30 گهر تاج ترا اوج فلک بادا کان %~% صورت قدر ترا عرش ملک بادا گاه(@)(@@) 31 یاور بخت تو باد از پی تو دور فلک %~% حافظ جان تو باد از پی ما فضل الاه PageV1P0609(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای ایزدت را رحمت آفریده %~% در سایه لطف بپروریده(@)(@@) 2 ای نور جمالت از رخ تو %~% انگشت اشارت کنان بریده(@)(@@) 3 آوازه تو در هوای وحدت %~% پیش از ازل و ابد خنیده(@)(@@) 4 عرشی که سر آسیمه بود ز اول %~% در زیر قدمهایت آرمیده(@)(@@) 5 بر فرش خرد گرد بر نشسته %~% تا عشق بساط تو گستریده(@)(@@) 6 اندر ازل از بهر چاکرت خود %~% لبیک همه عاشقان شنیده(@)(@@) 7 ای دست فرو شسته ز آفرینش %~% گشته ملکی هر کجا که دیده(@)(@@) 8 بی روی تو عقلی ندیده صبحی %~% از مشرق روح‌القدس دمیده(@)(@@) 9 بی زلف تو جانی ندیده دینی %~% با کفر عزازیل آرمیده(@)(@@) 10 لاغر 
ms512	 شده عقل از همه فضولی %~% از بس که ز تو فاقه‌ها کشیده(@)(@@) 11 فربی شده روح از همه معانی %~% از بس که ز بستان تو چریده(@)(@@) 12 آنجا که تو بر خوانده و زند و پازند %~% زردشت به مخرق زبان بریده(@)(@@) 13 با داد تو اندر جهان نیابند %~% جز چشم بتان هیچ پژمریده(@)(@@) 14 آنجا که کریمیت خوان نهاده %~% ابلیس طفیلی بدو رسیده(@)(@@) 15 و آنجا که سمند تو سم نموده %~% آدم علم خویش خوابنیده(@)(@@) 16 مردم تویی از کل آفرینش %~% در آینه چشم اهل دیده(@)(@@) 17 موسی به کنار تو برنشسته %~% از نیل و عصا آدمش کشیده(@)(@@) 18 فراش تو نوح از نهیب طوفان %~% در زورق اقبال تو خزیده(@)(@@) 19 در برزگریت آمده براهیم %~% ریحان و گل از آتشش دمیده(@)(@@) 20 موسی به سقاییت بوده روزی %~% بس باده که از جام تو چشیده(@)(@@) 21 از چاکری تو براق عیسی %~% چون شمس به چارم فلک رسیده(@)(@@) 22 از لطف تو عقل اندر آفرینش %~% ناخوانده ترا نام آفریده(@)(@@) 23 در پیش قدت چون الف بگویم %~% در کامم دالی شود خمیده(@)(@@) 24 لعل تو بسی توبه‌ها شکسته %~% جزع تو بسی پرده‌ها دریده(@)(@@) 25 در زلف تو سیصد هزار خم هست %~% در هر چم او یوسفی چمیده(@)(@@) 26 در مجلس تو جبرییل سامی %~% بر درت مگس گیر بر تنیده(@)(@@) 27 در رسته سنت سنایی از دل %~% داده خرد و عشق تو خریده PageV1P0610(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای دل غافل مباش خفته درین مرحله %~% طبل قیامت زدند خیز که شد غافله(@)(@@) 2 روز جوانی گذشت موی سیه شد سپید %~% پیک اجل در رسید ساخته کن راحله(@)(@@) 3 آنکه ترا زاد مرد و آنکه ز تو زاد رفت %~% نیست ازین جز خیال نیست از آن جز خله(@)(@@) 4 خیزو درین گورها در نگر و پند گیر %~% ریخته بین زیر خاک ساعد و ساق و کله(@)(@@) 5 آنکه سر زلف داشت سلسله بر گرد رو %~% سلسله آتشین 
ms513	 دارد از آن سلسله(@)(@@) 6 تکیه مکن بر بقا زان که در آرد به خاک %~% صولت شیر عرین پیکر اسب گله(@)(@@) 7 زود کند او خراب این فلک کوژ را %~% هم زحل و مشتری هم اسد و سنبله(@)(@@) 8 این همه آهنگ تو سوی سماع و سرود %~% وینهمه میلت مدام سوی می و ولوله(@)(@@) 9 خانه خریدی و ملک باغ نهادی اساس %~% ملک به مال ربا خانه به سود غله(@)(@@) 10 فرش تو در زیر پا اطلس و شعر و نسیج %~% بیوه همسایه را دست شده آبله(@)(@@) 11 او همه شب گرسنه تو ز خورشهای خوب %~% کرده شکم چارسو چون شکمه حامله(@)(@@) 12 سعی کنی وقت بیع تا چنه‌ای چون بری %~% باز ندانی ز شرع صومعه از مزبله(@)(@@) 13 دزد به شمشیر تیز گر بزند کاروان %~% بر در دکان زند خواجه به زخم پله(@)(@@) 14 در همه عمر ار شبی قصد به مسجد کنی %~% گر چه به روی و ریا بر کنی از مشعله(@)(@@) 15 در رمضان و رجب مال یتیمان خوری %~% روزه به مال یتیم مار بود در سله(@)(@@) 16 مال یتیمان خوری پس چله داری کنی %~% راه مزن بر یتیم دست بدار از چله(@)(@@) 17 صوفی صافی شوی بر در میر و وزیر %~% صوف کنی جامه را تا ببری زان زله(@)(@@) 18 گر بخوری شکر کن ور نخوری صبر کن %~% پس مکن از کردگار از پی روزی گله(@)(@@) 19 چند شوی ای پسر از پی این لقمه چند %~% همچو خران زیر بار همچو سگان مشغله(@)(@@) 20 دامن توحید گیر پند سنایی شنو %~% تا که بیابی به حشر ز آتش دوزخ یله PageV1P0611(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 گر هیچ نگارینم بر خلق عیانستی %~% ای شاد که خلقستی ای خوش که جهانستی(@)(@@) 2 از خلق نهان زان شد تا جمله ترا باشد %~% گر هیچ پدیدستی زان همگانستی(@)(@@) 3 جان دید جمالش را ور نه به همه دانش %~% دربان و غلامش را زو 
ms514	 باز که دانستی(@)(@@) 4 دل قهر و دو زلفش دید انگشت گزان زان شد %~% گر لطف لبش دیدی انگشت زنانستی(@)(@@) 5 زیر و زبر عالم بهر طلبست ارنی %~% تنگا که زمینستی لنگا که زمانستی(@)(@@) 6 گر نور پذیرفتی زو شش جهت عالم %~% پستی همه باغستی بالا همه کانستی(@)(@@) 7 گر گل نپذیرفتی زو نور تجلی کی %~% گل کعبه چرخستی دل گشن جانستی(@)(@@) 8 گفت ست که یک روزی جانت ببرم چون دل %~% من بنده آن روزم ایکاش چنانستی(@)(@@) 9 جانیست سنایی را در دیده سنان او %~% پس گر چنینستی بی‌جان چو جنانستی(@)(@@) 10 او گر نه چنینستی چون نیزه سلطان کی %~% بر رفته و برجسته بر بسته میانستی(@)(@@) 11 بهرامشه مسعود آن شه که گه عشرت %~% ساقیش سپهرستی گر هیچ جوانستی(@)(@@) 12 ور هیچ کرا کردی در درگه چون خلدش %~% هم رایت رایستی هم خانه خانستی(@)(@@) 13 چرخ ار چو ملک بودی شاگرد سنانش را %~% پریدن مرغانش تا حشر ستانستی PageV1P0612(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ایا بی حد و مانندی که بی مثلی و همتایی %~% تو آن بی مثل و بی شبهی که دور از دانش مایی(@)(@@) 2 ز وهمی کز خرد خیزد تو زان وهم و خرد در وی %~% ز رایی کز هوا خیزد تو دور از چشم آن رایی(@)(@@) 3 پشیمانست دل زیرا که تو اسرارها دانی %~% به هر جایی که جویمت این به علم ای عالم آن جایی(@)(@@) 4 به هرچ انفاسها داند تو آن انفاس میدانی %~% به هر چه ارواحها داند به خوبی هم تو اعلایی(@)(@@) 5 هر آن کاری که شد دشوار آسانی ز تو جوید %~% هر آن بندی که گردد سخت آنرا هم تو بگشایی(@)(@@) 6 بدانی هر چه اسرارست اندر طبع هر بنده %~% ببینی هر چه پنهان تو درین اجسام پیدایی(@)(@@) 7 همه ملکی زوال آید زوالی نیست ملکت را %~% هم خلقان بفرسایند و تو بی‌شک نفرسایی(@)(@@) 8 که آمرزد خداوندا رهی را گر تو 
ms515	 نامرزی %~% که بخشاید درین بیدادمان گر تو نبخشایی(@)(@@) 9 چراغی گر شود تیره مر او را هم تو افروزی %~% شعاعی گر فرو میرد مر آن را هم تو افزایی(@)(@@) 10 فروغ از تست انجم را برین ایوان مینوگون %~% شعاع از تست مر مه را برین گردون مینایی(@)(@@) 11 بدایع را به گیتی در به حکمتها تو بر سازی %~% کواکب را به گردون بر به قدرتها تو آرایی(@)(@@) 12 هیولا را تو دادستی به حکم عنصر و جوهر %~% مر اسطقسات را پستی گهی و گاه بالایی(@)(@@) 13 بسان تخت جمشیدی تو گردون را کنی جلوه %~% بسان تاج نوشروان زمینها را بپیرایی(@)(@@) 14 ز خار ار چاکری جوید همی گل تو برون آری %~% به بحر ار بنده‌ای جوید همی در تو بپیمایی(@)(@@) 15 تو آن حیی خداوندا که از الهامها دوری %~% تو آن فردی خداوندا که خود را هم تو می‌شایی(@)(@@) 16 جهاندارا جهانداری که عالم مر ترا شاید %~% خداوندا خداوندی که خود را می تو بستایی(@)(@@) 17 فرستی گر یکی مرغی بگیرد ملک پرویزی %~% وگر یک پشه را گویی بگیرد ملک دارایی(@)(@@) 18 شکیبا را به حکم تست جبارا شکیبایی %~% توانا را به امر تست ستارا توانایی(@)(@@) 19 همی ترسیم از عدلت امید ماست بر فضلت %~% از آن شادیم ما جمله که تو آخر مکافاتی(@)(@@) 20 ز عدلت بود هر عدلی که آن می‌کرد نوشروان %~% ز گنجت بود هر گنجی که دادی حاتم طایی(@)(@@) 21 صبوری هست از جمعی بدی آرند بسیاری %~% نهایت نیست از دشمن پدید آرند غوغایی(@)(@@) 22 خلیلت را به آتش در فکندند آزمایش را %~% ندانستند از فضلت ز رعنایی و رسوایی(@)(@@) 23 فراوان ناکسی کردند هر کس در جهان از خود %~% نهان گشتند سر تا سر حسودان و تو بر جابی(@)(@@) 24 پیاپی تا کند ظالم فراوان ظلم بر هر کس %~% چو بی حد گشت ظلم او پس آن گه جانش بربایی(@)(@@) 25 نبودند کافی الاکبر سپهداران 
ms516	 گیتی زان %~% به خاک تیره‌شان کردی ملیک‌الملک مولایی(@)(@@) 26 پدید آرنده خورشید و ماه و کوکب سیار %~% نهان دارنده گوگرد سرخ و شخص عنقایی(@)(@@) 27 قدیم حال گردانی رحیم و راحم و ارحم %~% بصیر و مفضل و منعم خدای دین و دنیایی(@)(@@) 28 اگر طاعت کند بنده خدایا بی‌نیازی تو %~% وگر عصیان کند بنده به عذری باز بخشایی(@)(@@) 29 یکی اعدات پیل آورد زی کعبه فراوان را %~% یکی از کرکسان آورد بر گردنت پیمایی(@)(@@) 30 تولا کردای نهمار بر افلاک و بر گردن %~% ز خود برخیز یک چندی اگر مرد تولایی(@)(@@) 31 زمستان آری و حله بپوشانی جهان را در %~% بهار آری بیارایی چنان جنات حورایی(@)(@@) 32 ز ابر تیره بارانی به هر جایی همی لولو %~% به باغ و راغ از آن لولو نمایی لاله حمرایی(@)(@@) 33 ز خشکی داده‌ای یارب همیشه طبع من تری %~% چون من گریان مضطر را فراوان نعمت طایی(@)(@@) 34 به فضلت کوهها گردد بسان عرش بلقیسی %~% ز حکمت باغها گردد چنان چون جان ببخشایی(@)(@@) 35 ایا چشمی که پیوسته طلبکار جمالی تو %~% ایا دستی که روز و شب بروی رطلها مایی(@)(@@) 36 اگر تیغی به فرق آید گمانی بر که جرجیسی %~% اگر ارت به سر آید گمانی بر زکریایی(@)(@@) 37 برندت گر سوی زندانی گمانی بر که صدیقی %~% وگر رانندت از شهرت گمانی بر که تنهایی(@)(@@) 38 وگر در راحتی افتی گمان بر کابن یامینی %~% وگر بهتان سرایندت چنان می‌دان مسیحایی(@)(@@) 39 به دنیا در نگر ایدون که تا دل در نبندی هیچ %~% اگر مردی تو دامن را به دنیا در نیالایی(@)(@@) 40 نثار درگه آثار همه شبهت به کامه زر %~% نثار درگه عالی پشیمانی به هر رایی(@)(@@) 41 کسی کو دامن از عالم کشید ای دوست نتواند %~% کجا داند نمود از جیب هرگز ید بیضایی(@)(@@) 42 تنت را اژدهایی کن برو بنشین تو چون مردان %~% وگرنه دوری از اقصای عالم درد سینایی(@)(@@) 43 شبی 
ms517	 نفروختی هرگز چراغی بهر یزدانت %~% همه روزت همی بینم که در مهر تجلایی(@)(@@) 44 به نزد زمره آدم همی تازی پی روزی %~% کی آید ناقد مردان به طبایی و طیایی(@)(@@) 45 ز خلقان گر همی ترسی ز نااهلان ببر صحبت %~% مترس از خار و خس هرگز اگر بر طمع حلوایی(@)(@@) 46 نمانی زنده در دنیا اگر ماهی و خورشیدی %~% بخاید مرگ ناچارت اگر آهن همی خایی(@)(@@) 47 اگر ترسیت از مرگت طلب کن آب حیوان را %~% تو از مرگی شوی ایمن اگر نزدیک ما آیی(@)(@@) 48 خضروار ار همی گردی به دست آری نشان من %~% سکندروار صحرا را شب و روز ار بپیمایی(@)(@@) 49 ایا راوی ببر شعر من و در شهرها می‌خوان %~% به پیش کهتر و مهتر سزد گر دیر بستایی(@)(@@) 50 چنان کاین آسمان هرگز ز کشت خود نیاساید %~% تو نیز از خواندن توحید شاید گر نیاسایی(@)(@@) 51 خداوندا جهاندارا سنایی را بیامرزی %~% بدین توحید کو کردست اندر شعر پیدایی PageV1P0613(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای ز عشق دین سوی بیت‌الحرام آورده رای %~% کرده در دل رنجهای تن گداز جانگزای(@)(@@) 2 تن سپر کرده به پیش تیغهای جان سپر %~% سر فدا کرده به پیش نیزه‌های سرگرای(@)(@@) 3 گه تمامی داده مایه آب دستت را فلک %~% گه غلامی کرده سایه خاکپایت را همای(@)(@@) 4 از تو بی‌دل دوستانت همچو قفچاقان ز خان %~% وز تو پر دل همرهانت همچو چندالان زرای(@)(@@) 5 ای خصالت خوشدلان را چون محبت پای بند %~% وی جمالت دوستان را چون مفرح دلگشای(@)(@@) 6 از بدن یزدان پرستی وز روان یزدان طلب %~% از خرد یزدان‌شناسی وز زبان یزدان سنای(@)(@@) 7 چون تویی هرگز نبیند عالم فرزانه بین %~% چون تویی هرگز نزاید گنبد آزاده‌زای(@)(@@) 8 بنده جود تو زیبد آفتاب نور بخش %~% مطرب بزم تو شاید زهره بربط سرای(@)(@@) 9 چون طبایع سر فرازی چون شرایع دلفروز %~% از لطافت جانفزایی وز سخاوت غمزدای(@)(@@) 10 تا تو کم بودی ز 
ms518	 عقد دوستان در شهر بلخ %~% بود هر روز فراغت دوستان را غم فزای(@)(@@) 11 منت ایزد را که گشتند از قدومت دوستان %~% همچو بی‌جانان ز جان و بی دلان از دلربای(@)(@@) 12 چون به حج رفتی مخور غم گر نبودت حج از آنک %~% کار رفتن از تو بود و کار توفیق از خدای(@)(@@) 13 مصلحت آن بود کایزد کرد خرم باش از آنک %~% می نداند رهرو آن حکمت که داند رهنمای(@)(@@) 14 سخت خامی باشد و تر دامنی در راه عشق %~% گر مریدی با مراد خود شود زور آزمای(@)(@@) 15 سوی خانه دوست ناید چون قوی باشد محب %~% وز ستانه در نجنبد چون وقح باشد گدای(@)(@@) 16 احمد مرسل بیامد سال اول حج نیافت %~% گر نیابد احمد عارف شگفتی کم نمای(@)(@@) 17 دل به بلخ و تن به کعبه راست ناید بهر آنک %~% سخت بی رونق بود آنجا کلاه اینجا قبای(@)(@@) 18 در غم حج بودن اکنون از ادای حج بهست %~% من بگفتم این سخن گو خواه شایی خوا مشای(@)(@@) 19 از دل و جان رفت باید سوی خانه ایزدی %~% چون به صورت رفت خواهی خوا به سر شو خوابه پای(@)(@@) 20 نام و بانگ حاجیان از لاف بی معنی بود %~% ور نداری استوارم بنگر اندر طبل و نای(@)(@@) 21 حج به فریاد و به رفتن نیست کاندر راه حج %~% رفتن از اشتر همی بینم و فریاد از درای(@)(@@) 22 صدهزار آوازه یابی در هوای حج ولیک %~% عالم‌السر نیک داند های هوی از های های(@)(@@) 23 رنج بردی کشت کردی آب دادی بر درو %~% گرت دونی از حد خامی درآید گو درای(@)(@@) 24 کو یکی فاضل که خارش نیست مشتی ریش گاو %~% کو یکی صالح که خصمش نیست قومی ژاژخای(@)(@@) 25 چون فرستادی به حج حج کرد و آمد نزد تو %~% دل مجاور گشت آنجا گر نیاید گو میای(@)(@@) 26 این شرف بس باشدت کآواز خیزد روز حشر %~% کاحمد عارف 
ms519	 به دل حج کرد و دیگر کس به پای(@)(@@) 27 تا بگردد چرخ بر گیتی تو بر گیتی بگرد %~% نا بپاید کعبه در عالم تو در عالم بپای PageV1P0614(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای ز آواز و جمال تو جهان پر طربی %~% وز پی هر دو شده جان و دلم در طلبی(@)(@@) 2 چشم و گوش همه از لحن و رخت پر در و گل %~% پس چرا قسمتم از هر دو عنا و تعبی(@)(@@) 3 گر ز آهن دل من در کف تو گشت چو موم %~% ور چو یعقوب ز عشق تو کنم واهربی(@)(@@) 4 ناید از خود عجبم زان که به آواز و به روی %~% داری از یوسف و داوود پیمبر نسبی(@)(@@) 5 آنچه با این دل من چشم چو بادام تو کرد %~% نکند هرگز با مهره کف بوالعجبی(@)(@@) 6 پس دل خون شده تافته تیره من %~% کو همی در دو صفت داشت ز زلفت حسبی(@)(@@) 7 شد مگر حلقه‌ای از زلف تو و شاید از آنک %~% خون اگر مشک شود طبع ندارد عجبی(@)(@@) 8 صد دل خون ده در یک شکن زلف تو هست %~% همچو عناب در آویخته اندر عنبی(@)(@@) 9 تا همی رقص کند در چمن عشرت و عیش %~% ماه رقاص نهادست سپهرت لقبی(@)(@@) 10 شدم از طمع وصال تو چو یک برگ از کاه %~% تا بر آن سیم تو دیدم زد و بیجاده لبی(@)(@@) 11 بند بندم همه بگشاد چو تو زی از ماه %~% تا تو بر تارک خورشید ببستی قصبی(@)(@@) 12 چاک ماندست دلم چون دل خرما تا تو %~% چاک داری ز پس و پیش ببسته سلبی(@)(@@) 13 جان بابا مکن این کبر مبادا که به عدل %~% روزگارت کند از رنج دل من ادبی(@)(@@) 14 ابلهم خوانی و گویی که به باغ آر زرم %~% خار ندهند تو بی‌سیم چه جویی رطبی(@)(@@) 15 ابله اکنون تویی ای جان جهان کز پی زر %~% طعنه بر من زنی اکنون و 
