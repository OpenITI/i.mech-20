ms850	 الدين الشهير بمير بزرگ (أي السيد الكبير) الحسيني المرعشي. ثاني الملوك المعروفين بالسادة المرعشية في طبرستان مازندران. جلس ببلدة ساري بعد أبيه المير بزرگ دفين آمل 781. وله تصانيف منها «زاد القراء» (ذ 12: 6) فرغ من تأليفه 765 و«منية الحكيم وبغية الفقيه» للجمع بين العلم والدين و«هداية الأديب» و«دليل الحيران» . وحارب الأمير تيمور وأسر مع أقربائه كما في «مجالس المؤمنين» .(@)(@)PageV05P168(@)(@)(@@)(@@)(@@) $ الكوسج (ابن... ) :(@)(@)(@@) -حيدر بن علي بن حيدر.(@)(@)(@@)(@@)(@@) $ الكوفي (1) :(@)(@)(@@) -الفضل بن يحيى بن علي الطيبي.(@)(@)(@@)(@@)(@@) $ الكوفي: -محمد بن علي بن الغزال.(@)(@)(@@)(@@)(@@) $ الكوفي: -محمد بن محمد بن أحمد...(@)(@)(@@)(@@)(@@) $ الكيمياوي:(@)(@)(@@) -ايدمر بن علي الجلدكي.(@)(@)(@@)(@@)(@@) $ الكيمياوي: -الحسن الكرماني...(@)(@)PageV05P169(@)(@)(@@)(@@)(@@) || «گ»(@)(@)(@@)(@@)(@@) $ گلستانه:(@)(@)(@@) -حيدر بن محمد بن حيدر بن اسماعيل.(@)(@)(@@)(@@)(@@) $ گلستانه: -عباد بن أحمد بن اسماعيل.(@)(@)(@@)(@@)(@@) $ گلستانه: -عباد بن يحيى بن عباد بن أحمد.(@)(@)(@@)(@@)(@@) $ گل سرخ (1) :(@)(@)(@@) -علي يزدي.(@)(@)PageV05P170(@)(@)(@@)(@@)(@@) || «ل»(@)(@)(@@)(@@)(@@) $ لامي:(@)(@)(@@) -وشاح بن علي بن محمود بن موسى.(@)(@)(@@)(@@)(@@) $ الليثي:(@)(@)(@@) -الحسين بن علي بن الحسين بن حماد.(@)(@)(@@)(@@)(@@) $ الليثي: -علي بن الحسين بن حماد...(@)(@)(@@)(@@)(@@) $ الليثي: -علي بن حماد بن الحسين.(@)(@)PageV05P171(@)(@)(@@)(@@)(@@) || «م»(@)(@)(@@)(@@)(@@) $ المازندراني (1) :(@)(@)(@@) -الحسن بن علي.(@)(@)(@@)(@@)(@@) $ المازندراني: -علي بن فاضل. زين الدين.(@)(@)(@@)(@@)(@@) $ المازندراني: -كمال الدين بن قوام الدين.(@)(@)(@@)(@@)(@@) $ مبارك (ابن... ) :(@)(@)(@@) -موسى بن جعفر بن عيسى...(@)(@)(@@)(@@)(@@) $ المتأله (2) :(@)(@)(@@) -حيدر بن علي بن حيدر الآملي.(@)(@)(@@)(@@)(@@) $ المتكلم:(@)(@)(@@) -عبد الرزاق بن أحمد بن محمد (ابن الفوطي) .(@)(@)(@@)(@@)(@@) $ المتكلم: -الحسن بن محمد بن عدنان.(@)(@)(@@)(@@)(@@) $ المتكلم: -محمد بن حبيب الله.(@)(@)PageV05P172(@)(@)(@@)(@@)(@@) $ المتوج (ابن... ) :(@)(@)(@@) -أحمد بن عبد الله بن سعيد...(@)(@)(@@)(@@)(@@) $ المتوج (ابن... ) : -أحمد بن عبد الله بن محمد بن علي...(@)(@)(@@)(@@)(@@) $ المتوج (ابن... ) : -عبد الله بن سعيد البحراني.(@)(@)(@@)(@@)(@@) $ المتوج (ابن... ) : -عبد الله بن محمد بن علي بن الحسن البحراني.(@)(@)(@@)(@@)(@@) $ المجتهد:(@)(@)(@@) -طومان بن أحمد. نجم الدين.(@)(@)(@@)(@@)(@@) $ المجتهد: -هارون بن الحسن بن علي.(@)(@)(@@)(@@)(@@) $ المجد (ابن أبي... ) :(@)(@)(@@) -الحسن بن محمد بن...(@)(@)(@@)(@@)(@@) $ مجد الأكابر:(@)(@)(@@) -محمود بن محمد بن علي بن يوسف الطبري.(@)(@)(@@)(@@)(@@) $ مجد الدين:(@)(@)(@@) -أحمد بن علي بن عرفة...(@)(@)(@@)(@@)(@@) $ مجد الدين: -عباد بن أحمد بن اسماعيل.(@)(@)(@@)(@@)(@@) $ مجد الدين: -عباد بن يحيى بن عباد بن أحمد.(@)(@)(@@)(@@)(@@) $ مجد الدين: -الفضل بن يحيى بن علي الطيبي.(@)(@)(@@)(@@)(@@) $ مجد الدين: -محمد بن علي 
ms851	 بن محمد بن أحمد بن علي.(@)(@)(@@)(@@)(@@) $ مجد الدين: -محمد بن علي بن محمد بن حسن بن زهرة.(@)(@)PageV05P173(@)(@)(@@)(@@)(@@) $ محاسن (ابن أبي... ) :(@)(@)(@@) -عبد الله بن اسماعيل...(@)(@)(@@)(@@)(@@) $ محاسن (ابن أبي... ) : -علي بن ابراهيم بن محمد بن زهرة.(@)(@)(@@)(@@)(@@) $ محاسن (ابن أبي... ) : -محمد بن ابراهيم بن محمد بن علي...(@)(@)(@@)(@@)(@@) $ محاسن (ابن أبي... ) : -محمود بن محمد بن علي بن يوسف الطبري.(@)(@)(@@)(@@)(@@) $ محاسن (ابن أبي... ) : -يوسف بن ناصر بن محمد بن حماد.(@)(@)(@@)(@@)(@@) $ أبو المحاسن الجرجاني.(@)(@)(@@) على مؤلف «تكملة السعادات في كيفية العبادات المسنونات) الفارسي (ذ 4: 414-415) الذي فرغ من تأليفه 702 قال صاحب «الرياض» إنه رأى نسخة منه بخط المولى أبي سعيد الحسن بن الحسين الشيعي السبزواري فرغ من كتابته 747، لكن في بعض المجاميع نسبته إلى الشيخ ابن الحسن الجرجاني من معاصري العلامة الحلي.(@)(@)(@@) وليس المؤلف هو الشيخ الشافعي شهرة عبد الواحد بن اسماعيل الروياني الذي قتل بيد فدائية الاسماعيلية في جامع آمل 502 (الثقا 168) الذي ترجمه صاحب «الرياض» مفصلا ومصرا على تشيعه في باب الأسماء من القسم الأول ولم يذكر الكتاب له ولكنه ذكر على سبيل الاختصار في باب الكنى:(@)(@)(@@) الشيخ أبا المحاسن الجرجاني معاصر الحلي، ونسب إليه الكتاب مصرحا بأنه فرغ منه 702 ومع ذلك طبقه على أبي المحاسن الروياني. وذكر هنا بعض وقائع قتله. وكأنه كتب ذلك غير مراجع إلى ترجمته المفصلة.(@)(@)(@@) (ذ 4: 414-415) .(@)(@)(@@)(@@)(@@) $ محب الدين:(@)(@)(@@) -أحمد بن يوسف بن أبي بكر.(@)(@)PageV05P174(@)(@)(@@)(@@)(@@) $ المحدث:(@)(@)(@@) -عبد الرزاق بن أحمد بن محمد بن الفوطي.(@)(@)(@@)(@@)(@@) $ المحقق:(@)(@)(@@) -أحمد بن بلكو.(@)(@)(@@)(@@)(@@) $ المحقق: -الحسن الكاشي.(@)(@)(@@)(@@)(@@) $ المحقق: -الحسين بن ابراهيم بن يحيى.(@)(@)(@@)(@@)(@@) $ المحقق: -حيدر بن علي بن محمد بن ابراهيم.(@)(@)(@@)(@@)(@@) $ المحقق: -عبد الرحمان بن محمد بن ابراهيم (ابن العتايقي) .(@)(@)(@@)(@@)(@@) $ المحقق: -علي بن محمد البندهي.(@)(@)(@@)(@@)(@@) $ المحقق: -علي بن محمد الرشيدي الآوي.(@)(@)(@@)(@@)(@@) $ المحقق: -علي بن محمد بن علي نصير الدين الكاشي.(@)(@)(@@)(@@)(@@) $ المحقق: -محمد بن هلال الآوي.(@)(@)(@@)(@@)(@@) $ محمد الآوي النقيب شمس الدين.(@)(@)(@@) كان له صلة بالسلطان علي بن مؤيد ملك خراسان وما والاها (م 795) . وقد كتب شيخنا الشهيد «اللمعة الدمشقية» بالتماس من صاحب الترجمة لعلي 
ms852	 بن المؤيد في 782 كما في أول «الروضة البهية في شرح اللمعة الدمشقية» (ذ 11: 290-292) وذلك حكاية عن الشيخ أبي طالب محمد ابن الشهيد. فيكون تأليفه أربع سنوات قبل شهادته وليس في سبعة أيام من محبسه قبل قتله كما ذكر في «الأمل 1: 183» ونقلنا عنه في (ذ 18: 352) . وقد عبر القاضي عن المترجم له بمير شمس الدين الآوي عند ذكره لبلدة آوه وقال ان الشهيد ألف اللمعة بالتماسه وبعثها معه إلى السلطان وهو المقصود من «بعض الديانين» في خطبة الكتاب. ولصفي الدين الحلي (ص 116) قصيدة رثى بها عبد الكريم(@)(@)PageV05P175(@) ابن محمد بن عبد الحميد الثاني الشهيد (ص 119-120) واستغاث فيها بشمس الدين الآوي، وجاءت القصيدة في ديوان صفي الدين (ص 226) ومنها:(@)(@)(@@) فلو كان شمس الحق والدين شاهدا %~% لمصرع ذاك الندب ساعة ندبه(@)(@)(@@) لشن على عرب العذارين غارة %~% يضيق بها في البر واسع رحبه(@)(@)(@@) ومنها يظهر مكانة هذا النقيب الاجتماعية وقدرته العسكرية.(@)(@)(@@) أقول: لعل المترجم له من أولاد تاج الدين الآوجي محمد بن الحسين بن علي بن زيد الآتي. وراجع محمد بن محمود بن الحسن الآوي الآتي.(@)(@)(@@)(@@)(@@) $ محمد بن ابراهيم بن الحسام.(@)(@)(@@) شمس الدين العاملي الدمشقي. وصفه فخر المحققين في إجازته لعز الدين حسن بن صاحب الترجمة في 753 بالشيخ الإمام السعيد شمس الدين محمد بن ابراهيم إلى آخر الترجمة.(@)(@)(@@)(@@)(@@) $ محمد بن ابراهيم بن محسن المطار آبادي.(@)(@)(@@) عده صاحب «الرياض» ممن يروي عنه حسن بن سليمان الحلي تلميذ الشهيد، وقال إنه يروي الحسن بن سليمان عن الشهيد وعن جماعة أخرى غير الشهيد، فعد منهم بهاء الدين علي ابن عبد الكريم والمطار آبادي صاحب الترجمة. وبهذا يظهر طبقته وعصره.(@)(@)(@@)(@@)(@@) $ محمد بن ابراهيم بن محمد الدشتكي الشيرازي.(@)(@)(@@) هو صدر الدين محمد بن ابراهيم ابن صدر الدين محمد أبو ابراهيم بن اسحاق الحسيني الدشتكي. يروي عن والده ابراهيم عن جده صدر الدين محمد أبو ابراهيم الدشتكي المجاز من العلامة الحلي في 724 وهو صدر الدين الأول والمترجم له صدر الدين الثاني وله ولدان، اسحاق والد نظام 
ms853	 الدين أحمد، والمير غياث الدين منصور الأول والد صدر الدين الثالث الشهيد 903. وقد قرأ الصدر الشهيد على والده غياث الدين منصور وعلى ابن عم والده نظام الدين أحمد بن اسحاق. فيكون بين الصدر الثاني(@)(@)PageV05P176(@) والصدر الثالث أب واحد. والصدر الثالث هو والد غياث الدين منصور الثاني (م 948) والملقب بمعلم البشر والعقل الحادي عشر (ذ 9: 795) وهو جد السيد علي خان المدني (ذ 9: 753-755) .(@)(@)(@@)(@@)(@@) $ محمد بن ابراهيم بن محمد بن علي.(@)(@)(@@) هو بدر الدين أبو عبد الله محمد بن ابراهيم بن محمد بن أبي الحسن علي بن أبي علي الحسن بن أبي المحاسن زهرة الحلبي الحسيني المجاز هو وأخوه علاء الدين علي وأولادهما عن العلامة الحلي في 723 بالإجازة الكبيرة المعروفة بإجازة بني زهرة. والمترجم له ثالث الخمسة المجازين، وولداه أحمد (ص 9-10) والحسن (ص 45) هما الرابع والخامس على الترتيب. ووصف المجيز صاحب الترجمة بعد أخيه علاء الدين علي بقوله:(@)(@)(@@) [ولأخيه الكبير الأمجد والسيد المعظم المجد بدر الدين أبي عبد الله محمد]الخ.(@)(@)(@@)(@@)(@@) $ محمد بن أحمد بن علي بن محمد بن أبي الفتح الأخرس.(@)(@)(@@) شمس الدين الذي كان حيا في 754. وإليه ينسب آل خرسان في النجف نسبهم.(@)(@)(@@) أرخه وذكر تصنيفه «زاد السبيل» (ذ 12: 4) المير محمد قاسم المختاري السبزواري النسابة المعاصر للقاضي نور الله الشوشتري الشهيد 1019 وكان حيا زمن تأليف القاضي لمجالس المؤمنين يعني 982 كتبه بخطه في حاشية «عمدة الطالب» المؤلف 812. وتأريخ خط المختاري 950 وهذا نصه بعد الترجمة: وهذا كان من أجلاء عصره علما وعملا في 754 وله تآليف منها كتاب «زاد السبيل» في الفقه وله ذيل طويل.(@)(@)(@@)(@@)(@@) $ محمد بن أحمد بن أبي المعالي.(@)(@)(@@) شمس الدين العلوي الحسيني الموسوي.(@)(@)(@@) رأيت بخطه الإجازة والإنهاء لبعض تلاميذه في آخر الجزء الثالث من «التحرير» للعلامة الحلي، كتبها في 21 شعبان 757. ولعل مرجع ضمير الإنهاء هو الكاتب، وهو حسن بن علي الخانقاهي. والنسخة موجودة عند (هبة الدين الشهرستاني) . وصاحب الترجمة من مشائخ الشهيد. وصورة(@)(@)PageV05P177(@) إجازته له مذكورة في «إجازات البحار» في طي «إجازة صاحب المعالم» 
ms854	 (ذ 1: 230) ومات صاحب الترجمة في رمضان 769 كما نقل عن خط الشهيد في «مجموعة الجباعي» . ويروي المترجم له عن كمال الدين علي بن شرف الدين حسين بن حماد الليثي الواسطي (ص 138-139) وعن خاله صفي الدين محمد بن الحسن بن أبي الرضا البغدادي بإجازة مبسوطة أدرج في أولها نسب المجاز بقوله: [السيد الكبير المعظم الفاضل الفقيه الحامل لكتاب الله شرف العترة الطاهرة مفخر الأسرة النبوية شمس الدين محمد بن السيد الكريم الحسيب النسيب جمال الدين أحمد بن أبي المعالي بن أبي جعفر بن علي أبي القاسم بن علي أبي الحسن بن علي أبي القاسم بن محمد أبي الخير بن علي أبي القاسم بن علي أبي الحسن بن الحسن الحائري بن محمد أبي جعفر الحائري ابن ابراهيم المجاب ابن محمد الصالح بن الإمام موسى الكاظم (ع) .(@)(@)(@@)(@@)(@@) $ محمد بن اسحاق الدشتكي.(@)(@)(@@) صدر الدين أبو إبراهيم الحسيني، المعروف بصدر الدين الأول وهو والد ابراهيم الذي هو والد صدر الدين الثاني محمد (المذكور في ص 176-117) وهذا نسبه: محمد بن اسحاق بن علي بن عربشاه بن عمير بن الحسن بن الحسين بن علي بن زيد الأعثم بن علي بن محمد بن علي نجران نقيب نصيبين بن أبي عبد الله جعفر بن أحمد مسكين بن أبي عبد الله جعفر الشاعر بن محمد بن محمد بن زيد الشهيد بن علي بن الحسين بن علي بن أبي طالب (ع) . وقد كتب العلامة الحلي للمترجم له إجازة تأريخها 15 ج 1-724 على ظهر نسخة «قواعد الأحكام» هذه صورتها:(@)(@)(@@) [قرأ علي السيد العالم الفقيه... الزاهد الورع العلامة أفضل المتأخرين لسان المتقدمين مولانا ملك الأئمة والفضلاء صدر الدين محمد أبو ابراهيم الدشتكي... هذا الكتاب... وقد اجزت له رواية هذا الكتاب وغيره من مصنفاتي وقراآتي...(@)(@)(@@) وكتب العبد الفقير إلى الله تعالى حسن بن يوسف بن علي بن المطهر مصنف الكتاب في منتصف جمادى الاولى سنة أربع وعشرين وسبعماية ببغداد حامدا الله ومصليا... ](@)(@)PageV05P178(@) والنسخة موجودة بالمكتبة المركزية لجامعة طهران تحت رقم 704 
ms855	 وطبع الصفحة التي تحتوي على هذه الإجازة فتوغرافيا في «ريحانة الأدب ج 6 ص 360» وفي مقدمة طبع كتاب «إيضاح المقاصد» للعلامة الحلي (1) ص 18.(@)(@)(@@)(@@)(@@) $ محمد بن إسماعيل بن الحسين بن الحسن بن علي الهرقلي.(@)(@)(@@) رأيت نسبه كذلك بخطه في آخر الجزء الأول من «الشرائع» الذي كتبه بخطه في آخر نهار الخميس 15 رمضان 670 ثم قرأه على مصنفه المحقق جعفر بن سعيد الحلي م 776 فكتب المحقق بخطه الإنهاء والإجازة عليه يوم الأربعاء عيد الغدير في النجف 671 (ذ 1: 164) وإنهاء آخر أيضا بخطه في الحائر. والنسخة في خزانة السيد مهدي آل حيدر بالكاظمية. ورأيت أيضا بخطه «المراسم العلوية» لسالار الديلمي (ذ 20: 298) في مكتبة (الطهراني بكربلا) كتبه في بغداد وفرغ منه ليلة الأربعاء 14-ج 2- 677 وذكر نسبه كذلك إلا أنه عبر عن جده الحسن بأبي الحسين بن علي، يعني أنه ذكر كنيته بدل اسمه الحسن. ورأيت أيضا بخطه الجزء الأول من «قواعد الأحكام» للحلي (ذ 17: 176-177) فرغ من كتابته ضاحي نهار السبت 11 صفر 702 والجزء الثاني فرغ منه ضاحي نهار الثلاثاء 14 ع 1-706 وقرأ الجزء الأول على المصنف الحلي فكتب عليه بخطه الإنهاء له في ع 1-707 والنسخة في خزانة (الصدر) . ترجمه في «الأمل 2: 245» وقال رأيت بخطه «المختلف» للحلي (ذ 20:(@)(@)(@@) 218-221) وقد قرأه عليه أو على ولده. انتهى. وحكى لي المرحوم ميرزاي محمد الطهراني بسامراء أنه رأى. في مكتبة شيخنا النورس نسخة من(@)(@)PageV05P179(@) «نهاية الأحكام» للطوسي بخط المترجم له، وعليه «إجازة العلامة الحلي للهرقلي» هذا.(@)(@)(@@)(@@)(@@) $ محمد بن أبي بكر بن أبي القاسم الهمداني الشهيد.(@)(@)(@@) قال ابن كثير:(@)(@)(@@) [الشيخ الفاضل شمس الدين أبو عبد الله الهمداني أبوه، الصالحي المعروف بالسكاكيني. ولد بالصالحية 635 واشتغل ونظم قويا وسمع الحديث... ثم دخل التشيع، فقرأ على أبي صالح الحلي شيخ الشيعة وصحب عدنان (ص 128-129) وطلبه أمير المدينة الأمير منصور بن حماد فأقام عنده نحوا من سبع سنين ثم عاد إلى دمشق وقد ضعف سمعه. وله «سؤال في الخبر» أجابه تقي الدين ابن تيمية... 
ms856	 وظهر له بعد موته كتاب فيه انتصار لليهود وأهل الأديان الفاسدة فغسله السبكي... ولما مات لم يشهد جنازته القاضي.(@)(@)(@@) توفي يوم الجمعة 16 صفر-721 ودفن بسفح قاسيون. وقتل ابنه قايماز على قذفه امهات المؤمنين]. هذا ما قاله أبو الفداء ابن كثير في حوادث 721 من «البداية والنهاية» . وقال اليافعي م 768 في «مرآة الجنان» في حوادث تلك السنة: [مات شيخ الشيعة وفاضلهم الشمس محمد بن أبي بكر بن أبي القاسم الهمداني ثم الدمشقي]. وقال العسقلاني في «الدرر الكامنة 3: 30» :(@)(@)(@@) ولد 635 بدمشق وطلب الحديث وتأدب وهو شاب... وأقعد في صناعة السكاكين عند شيخ رافضي فأفسد عقيدته فأخذ عن جماعة من الإمامية.(@)(@)(@@) وله نظم وفضائل... إلا أنه كان يناظر في القدر وينكر الجبر!وعنده تعبد وسعة علم... ووجد بعد موته بمدة في 750 بخط يشبه خطه، كتاب يسمى «الطرائف في معرفة الطوائف» يتضمن الطعن على الإسلام وأورد فيه أحاديث مشكلة وتكلم على متونها بكلام عارف بما يقول، إلا أن وضع الكتاب يدل على زندقة فيه. وقال في آخره: وكتبه مصنفه عبد الحميد ابن داود المصري. وهذا الاسم لا وجود له وشهد جماعة من أهل دمشق أنه(@)(@)PageV05P180(@) خطه فأخذه تقي الدين السبكي عنده وقطعه في الليل وغسله بالماء و...(@)(@)(@@) ومات 721. انتهى كلام العسقلاني.(@)(@)(@@) وقد أوردت هنا قطعا من نص العسقلاني وابن كثير حتى ينتبه القارىء ويعرف كيف عاش علماء الشيعة في تلك القرون السوداء تحت ظل الاضطهاد من قبل جهلاء قشريين يسفكون الدماء ويحرقون العلماء أحياء وأمواتا ويغسلون الكتب العلمية ويحرقونها لا لسبب إلا لأنهم لم يفهموها، ويصفون كل ما خالف السنة معارضا للاسلام. فكما ترى إن كل ما أخذوه على المترجم له هو أنه أنكر الجبر!ومر في ص 45-46 أنهم ضربوا عنق ولده الحسن لأنه تبرأ من مظالم الحكام من الصحابة ومن انحرافهم، ومثله ما مر في ص 146 لعلي بن الحسن بن أبي الفضل. هذا وأما الكتاب الذي سبب استنساخه تكفير هذا العالم المجتهد وانتهى إلى ضرب عنق ولده العالم الفاضل، إنما 
ms857	 هو «الطرائف في معرفة الطوائف» لرضي الدين ابن طاوس (أنوار: 116-118) وقد طبع هو وترجمته الفارسية في 1301 (ذ 4: 115) رغم غسل السبكي نسخته بالماء. وقد ذكرنا في (ذ 15: 154) سبب تسمي المؤلف فيه باسم مستعار كما فعل قبله العلماء من الشيعة كمؤلفي «إخوان الصفا» و«توحيد المفضل» و«كتاب فكر» و«مصباح الشريعة» وبعض الأصول الأربعمائة مثل «كتاب سليم بن قيس» و«الأهليلجة» وغيرها من الكتب التي أخفى مؤلفوها اسماءهم الحقيقية خوفا من حكومة الجهلاء الحشويين وتزمتهم وقساوتهم في القتل والحرق.(@)(@)(@@)(@@)(@@) $ محمد بن جعفر النباطي.(@)(@)(@@) المعاصر لكمال الدين ابن العتايقي الحلي.(@)(@)(@@) وقد كتب على ظهر كتاب «الإيماقي في شرح الإيلاقي» (ذ 2: 509-510) الذي ألفه ابن العتايقي في 755 تقريظا لطيفا وثناء بليغا قال في آخره:(@)(@)(@@) [كتبه عبده الأصغر ومحبه الأكبر محمد بن جعفر النباطي]. والنسخة في الخزانة (الغروية) .(@)(@)PageV05P181(@)(@)(@@)(@@)(@@) $ محمد الحافظ الشيرازي.(@)(@)(@@) هو الخواجه شمس الدين محمد الشاعر الشيرازي المتخلص في شعره بالحافظ. قضى حياته حدود (729-792) وقبره معروف بشيراز مزار يتبرك به وبديوانه وديوانه يلقب بلسان الغيب لما فيه من العرفان والغنوص الإشراقي. وأشعاره في مديح الإمام الرضا وأفكاره العرفانية وقوله بالولاية لا يدع مجالا للشك في تشيعه. وقيل انه لما يتهمه أهل السنة والحشويون بالكفر علمه التايبادي (ص 135) كيف يتقي بزيادة بيت في غزله ليتظاهر بأنه قد نقل ذلك المعنى عن غيره.(@)(@)(@@) وقد فصلنا أحواله وما كتب عنه وعن ديوانه في (ذ 9: 222-224) ومر شروح ديوانه في (ذ 13: 180-181) وقد دافع المولى محمد الدارابي عن عقائد حافظ في «لطيفه غيبي» (ذ 18: 317-320 و326) وفرق بين قوله بالجبر وبين قول الأشاعرة به، بمثل ما نقلنا عن السيد حيدر الآملي عن أفضل الدين تركه الأصفهاني في (ص 68-69) فجبر الأشعري جبر يهودي وجبر حافظ جبر هندي أي أنه ما وراء الجبر والاختيار، لأن توحيد الحافظ توحيد إشراقي وتوحيد الأشعري توحيد عددي أبطله أمير المؤمنين في كثير من خطبه الموجودة في نهج البلاغة.(@)(@)(@@)(@@)(@@) $ محمد بن حبيب الله.(@)(@)(@@) هو أفضل الدين أبو حامد المعروف بتركه الأصفهاني الحكيم المتكلم، 
ms858	 مصنف «قواعد التوحيد» (ذ 17: 181) الذي شرحه حفيد المؤلف وهو صاين الدين علي بن محمد بن أفضل الدين محمد ابن حبيب الله تركه (ذ 9: 570) والآتي في التاسعة وسماه «تمهيد القواعد» والمطبوع 1315 (ذ 4: 434) . ويأتي في العاشرة أفضل الدين محمد تركه قاضي عسكر الشاه طهماسب الصفوي م 984.(@)(@)(@@)(@@)(@@) $ محمد بن الحسن بن اسفنديار بهاء الدين.(@)(@)(@@) المؤرخ مؤلف «تاريخ طبرستان» (ذ 3: 262) يظهر من مقدمته أنه كان في 606 ببغداد حين(@)(@)PageV05P182(@) سمع بتقل رستم بن اردشير ملك طبرستان، فلما سمع بذلك قصد العراق (اراك) وبقي شهرين بالري يجمع مواد كتابه ثم ذهب إلى خوارزم وبقي خمسة أعوام يجمع مصادره من الوراقين، ومنها «نامهء تنسر» وهو ما كتبه وزير أردشير بابكان إلى گشنسب شاه طبرستان فابتدأ كتابه به وختم الكتاب بتاريخ العائلة الباوندية. وأورد فيه أشعارا فارسية وعربية وپهلوية طبرية (ذ 9: 873) وتأريخ الملوك المرعشية وغيرهم إلى 750. وأنكر هدايت في «مجمع الفصحاء 1: 465» كون الرجل هو محمد بن محمد الاسفندياري الآتي. طبع المستر ادوارد براون ترجمة الكتاب بالانكليزية في 1905، ثم طبع أصله الفارسي بطهران 1320 شمسية هجرية-1940 م في 332 ص.(@)(@)(@@) ثم طبع ذيلا له في 75 ص. بعنوان الجزء الثاني. وهي مطالب إضافية.(@)(@)(@@)(@@)(@@) $ محمد بن الحسن بن علي بن محمد الزرقني(@)(@)(@@) (أو الزرقاني، أو السرقني) الداودي رضي الدين العلوي الحسيني المجاز من محمد بن مطرف الحسني في 695 (ذ 1: 246) و(انوار: 174) . وصفه في إجازته له بقوله: [الولد العزيز الأجل الأوحد العالم الفاضل رضي الدين أبو عبد الله محمد بن الحسن... ] توجد هذه الإجازة على ظهر «مختصر المراسم» (ذ 20: 207-208) الذي كتبه محمد بن مطرف بخطه وقرأه على مصنفه المحقق الحلي وفرغ من الكتابة 672 أي قبل وفاة المحقق بأربع سنين.(@)(@)(@@)(@@)(@@) $ محمد بن الحسن بن محمد بن أبي الرضا.(@)(@)(@@) ولقبه شمس الدين أوصفي الدين العلوي البغدادي. يروي عنه ابن أخته شمس الدين محمد بن جلال الدين أحمد ابن أبي المعالي العلوي الموسوي م 769 بالإجازات الأربع الصادرة له في 730 المذكورة في «إجازات البحار-ص 35» وقبلها بالإجازة الكبيرة التي استظهر 
ms859	 المجلسي كونها لهذا المجيز والمجاز (ذ 1: 234) وهو يروي عن نجيب الدين يحيى بن أحمد بن سعيد الحلي م 690 (أنوار: 204) . ويروي أيضا عن(@)(@)PageV05P183(@) عبد الحميد بن فخار بن معد. وقد كتب إجازة على «نهج البلاغة» الذي كتبه نجم الدين الحسين بن أردشير الطبري في 677 أوردها في «الرياض» بظن أن الكاتب هو المجاز، مع أن الكاتب المذكور مجاز عن يحيى بن السعيد الذي هو شيخ صاحب الترجمة فالإجازة لغير الكاتب (ذ 1: 234) .(@)(@)(@@) ولصفي الدين محمد بن الحسن بن أبي الرضا العلوي قصيدة في رثاء محفوظ بن وشاح الهرملي معاصر المحقق الحلي والمتوفي بعد المحقق لأنه أنشأ قصيدة في رثاء المحقق أيضا. رأيت رثاء أبي الرضا لمحفوظ ورثاء محفوظ للمحقق بخط الحر العاملي على ظهر نسخة من «الشرائع» عند الشيخ عباس القمي مؤلف «الكنى والألقاب» بخراسان. ولصاحب الترجمة «شرح القصايد السبع العلويات» لعبد الحميد بن أبي الحديد (انوار: 88-89) اسمه «التنبيهات» (ذ 4: 450 و13: 391-392) .(@)(@)(@@)(@@)(@@) $ محمد بن الحسن بن محمد بن كجيل.(@)(@)(@@) الشيخ سلطان العارفين جاگير بن ناكير الكردي الأدرازي الحلي المعروف بشمس الدين ابن نعيم صاحب ديوان المدايح الكبير المشتمل على جميع حروف القافية الموسوم على ظهر الكتاب «شرف المزية في المدايح العربية» (ذ 14: 181-182) لأنه في مدايح المولى الصاحب الصدر الكبير عز الدين أبي محمد الحسن بن الحسين بن نجم الدين مظفر بن أبي المعالي ابن العروي بن قيصر الاسدي الحلي. ولكنه سماه في أول خطبة الكتاب «نزهة الجليس وفرصة الأنيس» وفرغ من نظمه في أواخر رمضان 695. وكتب العلامة الحلي بخطه تقريظا على ظهر الكتاب ليس له تأريخ وصف فيه الناظم ومدحه بقوله: [لقد أحسنت أيها الشيخ العالم الفاضل البارع النحرير اللقن الفصيح العلامة المحقق ملك العلماء شمس الملة والدين فيما نظمته... وقد انضم صرد مقالك إلى صدقك في مدح المولى الصاحب الصدر الكبير العالم المعظم المرتضى كهف الفقراء وملاذ المؤمنين، عز الملة والحق والدين، أعز الله ببقائه الاسلام والمسلمين...(@)(@)PageV05P184(@)(@)(@@) وكتب الفقير... حسن بن مطهر حامدا... ]. والنسخة موجودة في مكتبة 
ms860	 الحاج محمد حسن كبة ببغداد بقلم اسماعيل بن يوسف الدين الحلي.(@)(@)(@@) فرغ من الكتابة في رمضان 695 وكتب عنوان «شرف المزية» فوق خط العلامة الحلي وتقريظه. ويظهر أن الممدوح من رؤساء الأكراد بالحلة في أوائل تعريبهم وقبيله.(@)(@)(@@)(@@)(@@) $ محمد بن الحسن بن يوسف بن علي بن المطهر.(@)(@)(@@) فخر الدين ابو طالب الحلي الشهير بفخر المحققين ابن العلامة الحلي ولد ليلة الاثنين 20 ج 1- 182، كما ذكره والده في «جواب المسائل المهنائية» وتوفي ليلة الجمعة 25 ج 2-771. يروي عن والده آية الله العلامة. ويروي عنه جمع كثير.(@)(@)(@@) منهم محمد بن مكي الشهيد وفخر الدين أحمد بن عبد الله بن سعيد بن المتوج البحراني وظهير الدين علي بن يوسف بن عبد الجليل النيلي، ونظام الدين علي بن عبد الحميد النيلي وبهاء الدين علي بن عبد الكريم بن عبد الحميد النيلي النجفي وهو من أواخر تلاميذه كما يظهر من رجاله (ذ 10: 157) . وله «الفخرية في أمر النية» و«إيضاح القواعد» ، «الحاشية على الارشاد» ، «الكافية» في الكلام. ومكانته ومكانة والده الاجتماعية سببت لهما حرمة عظيمة حتى عند العامة فنرى الفيروز آبادي محمد بن يعقوب الشيرازي مؤلف «القاموس المحيط» في اللغة يفتخر بتتلمذه عليه، فيقول في إجازة كتبها بخطه على ظهر كتاب «التكملة والذيل والصلة لكتاب تاج اللغة» لبعض أصحابه فأجازه أن يروي عنه هذا الكتاب بحق روايته إياه عن شيخه الذي وصفه بما لفظه:(@)(@)(@@) [عن شيخي ومولاي علامة الدنيا، بحر العلوم وطود العلى فخر الدين أبي طالب محمد بن الشيخ الامام الأعظم، برهان علماء الأمم جمال الدين أبي منصور الحسن بن يوسف بن المطهر الحلي، بحق روايته عن والده، بحق روايته عن مؤلفه الامام الحجة... الحسن بن محمد الصنعاني]. غ(@)(@)PageV05P185(@) وتأريخ خط الفيروزآبادي 757 (1) .(@)(@)(@@)(@@)(@@) $ محمد بن الحسين بن حديد الأسدي.(@)(@)(@@) هو فخر الدين أبو جعفر محمد بن الفاضل السعيد زين الدين حسين بن حديد، جد صاحب «عمدة الطالب» م 828 من طرف أمه ويروى عنه في «العمدة» الطبعة الأولى ص 113.(@)(@)(@@) قال: وهو يروي عن السيد السعيد بهاء 