ms861	 و نظام‌الملک ماه %~% آسمان این دو نیر چیست خاک پای شاه(@)(@@) 2 آن پدر را از نطاق‌کهکشان شاید کمر %~% وین پسر را بر مدار فرقدان سایدکلاه(@)(@@) 3 صدهزاران باره‌گیرد آن پدر با یک قلم %~% صدهزاران بنده بخشد این پسر از یک نگاه(@)(@@) 4 آن‌پدر را صدراعظم‌کرد شه زان پگه بود %~% اعتماد دین و دولت ناظم‌ گنج و سپاه(@)(@@) 5 آن پسر را هم نظام‌الملک داد اول لقب %~% تا نظام‌الملک ثانی‌ گردد از اجلال و جاه(@)(@@) 6 پس به بازوی جلالش بست دری شاهوار %~% کز یکی درج شرف دارد نسب با پادشاه(@)(@@) 7 آنچنان دری‌که‌گر بودی فلک رادسترس %~% همچو تاجش ‌برنهادی‌بر سر خورشید و ماه(@)(@@) 8 خوشی دلی چندان فراوان‌شدکه نتواند غریب %~% از هجوم عیش و شادی برکشد از سینه آه(@)(@@) 9 گویی امشب از فلک با وجد می‌تابد نجوم %~% گویی امشب از زمین با رقص می‌روید گیاه(@)(@@) 10 گر قصوری ‌رفته در این شعر ای صدر جلیل %~% عذر من بشنو که تا دانی نکردستم‌ گناه(@)(@@) 11 اسب رنجانید دی پای مراگفتم بدو %~% چون‌ شوم در بزم صدر از لنگی پا عذرخواه(@)(@@) 12 گفت ‌فرداشب قدم از فرق سرکن چون قلم %~% کز ادب دورست آنجا با قدم رفنن به راه(@)(@@) 13 پا چسان سایی به خاکی‌کاندرو بهر سجود %~% تا همی‌ببن‌خدو دست‌و عونست و جباه(@)(@@) 14 از خدا خواهم سرایم در ثنایت شعرها %~% کت به وجد آرد روان چون مژده فتح هراه(@)(@@) 15 سایه را پیوسته تا در قعر چه باشد مکان %~% روز و شب چون‌ سایه‌خصمت‌باد اندر قعرچاه(@)(@@) 16 شام احبابت چو صبح غره خوبان سپید %~% صبح اعدایت چو شام طره ترکان سیاه(@)(@@) 17 روزوشب در باغ‌‌گردی‌ تا بگردد روز و شب %~% سال و مه خشنود مانی تا بماند سال و ماه PageV1P395(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 مگوگناه بود بر رخ نگار نگاه %~% که بر شمایل غلمان نگاه نیست‌گناه(@)(@@) 2 سرشک ریز دم از دیده هر زمان ‌که ‌کنم %~% در آفتاب جمال تو 
ms862	 خیره خیره نگاه(@)(@@) 3 رخت زداید گرد رخم چو آب روان %~% خطت فزاید مهر دلم چو مهر گیاه(@)(@@) 4 چو چهره تو بود چهر من ز اشک سفید %~% چو طره تو بود روز من ز آه سیاه(@)(@@) 5 ز عشق روی منیر تو روز من تاریک %~% ز فکر زلف دراز تو عمر من‌کوتاه(@)(@@) 6 ترا شکنج به‌گیسو مرا شکنجه به جان %~% مراکلال به خاطر تراکلاله به ماه(@)(@@) 7 تراست چشم‌کحیل و مراست جسم علیل %~% تراست خال سیاه و مراست حال تباه(@)(@@) 8 اگر نه چشم تو افراسیاب ترک چرا %~% به ‌گردش از مژه صف بسته از دو روی سپاه(@)(@@) 9 شدست حاجب سلطان چهره ابرویت %~% که بی اشاره این کس بدو نجویند راه(@)(@@) 10 مرا ز هجر تو جیحون‌شدست‌دیده ز اشک %~% مرا ز عشق تو کانون شدست سینه ز آه(@)(@@) 11 ز تیر ‌زلف دلم را مخوان به سوی زنخ %~% مباد آنکه درافتد شبان تیره به چاه(@)(@@) 12 ‌و یا نقاب درافکن ز چهره تا بیند %~% شبان تیره به ره چاه را ز تابش ماه(@)(@@) 13 گشاده رویت ای مه به تاب می‌ماند %~% به دشت همت دستور آسمان درگاه(@)(@@) 14 سپهر فضل و هنر میرزا ابوالقاسم %~% که فضل او زده بر اوج آسمان خرگاه(@)(@@) 15 خدایگان وزیران‌که خور ز رشگ رخش %~% به چرخ مات شود چون ز فر فرزین شاه(@)(@@) 16 دلیل دعوی یکتاییش بس اینکه سپهر %~% کند ز بحر سجودش هماره ‌پشت دوتاه(@)(@@) 17 به دعوت نعمش هرکه در زمانه مزیل %~% به دعوی‌کرمش هرچه در جهان آگاه(@)(@@) 18 به جود دست و دلش فقر کان و بحر دلیل %~% به نور رای و رخش‌ خسف ماه و مهر گواه(@)(@@) 19 زهی‌ گذشته ترا از کمال عز و شرف %~% ز جبهه نور جبین وز طرفه طرف ‌کلاه(@)(@@) 20 به جنب جاه تو هیچست آسمان بلند %~% ولی عجب نه گر او مر ترا فزاید جاه(@)(@@) 21 چنانکه صفر بود هیچ بر سبیل 
ms863	 مثل %~% چو پیش پنج نهی پنج ازو شود پنجاه(@)(@@) 22 که مثل تست‌که تاگویمت بر از امثال %~% که شبه تست‌که تا دانمت به از اشباه(@)(@@) 23 ز دیده بسکه ببارند حاسدان تو خون %~% ز سینه بسکه برآرند دشمنان تو آه(@)(@@) 24 شفاهشان شده از دود آن به رنگ جفون %~% جفونشان شده از رنگ این به لون شفاه(@)(@@) 25 چو شهد عهد تو در کام دوستان شیرین %~% چو زهر قهر تو در جان دشمنان جانکاه(@)(@@) 26 ز حسرت‌ دل ‌و دست‌ تو بحر و کان شب و روز %~% به مهر و ماه رسانند بانگ و اغوثاه(@)(@@) 27 روان به مهر تو پیوند جسته با اجسام %~% زبان به مدح تو میثاق بسته با افواه(@)(@@) 28 پی نظاره تو خلق‌کرده‌اند عیون %~% ز بهر سجده تو آفریده‌اند جباه(@)(@@) 29 قلم به دست تو هنگام جود در جنبش %~% بدان مثابه‌که ماهی‌کند به بحر شناه(@)(@@) 30 اگر به چشم تعنت‌ کنی به‌ کوه نظر %~% اگر به عین عنایت‌کنی به‌کاه نگاه(@)(@@) 31 شود ز خشم‌ تو چون جسم بدسگال تو کوه %~% شود ز مهر تو چون بخت نیکخواه تو کاه(@)(@@) 32 بزرگوارا هستم من از تو سخت دژم %~% ولی چه سود که قادر نیم به باد افراه(@)(@@) 33 نه بحر و کانم تا همچو بحر و کان بشوم %~% ز جود دست و دلت خوار و زار بیگه و گاه(@)(@@) 34 نه بحرم آبروی من ز جود خویش مبر %~% نه ‌کانم ازکرمت خاک من به باد مخواه(@)(@@) 35 نه روزگارم تا همچو روزگار کنی %~% ز ذیل قدرت خود دست جور من ‌کوتاه(@)(@@) 36 نه آفتاب حرورم نه آسمان غرور %~% که رای و قدر تو بنشاندم به خاک سیاه(@)(@@) 37 نه دهرم از غضبت جان من چو دهر مسوز %~% نه‌کوهم از سخطت جسم‌ من چوکاه مخواه(@)(@@) 38 نه بخلم از چه ز من خاطر ترا اعراض %~% نه ظلمم از چه ز من طینت ترا اکراه(@)(@@) 39 بخوان بخوان نوالم 
ms864	 ‌که ‌کم نخواهد شد %~% زکاسه‌لیسی درویش خوان نعمت شاه(@)(@@) 40 الا به ‌گیتی تا در طبیعت محرور %~% هم فزایدکافور بر به قوه باه(@)(@@) 41 به دهر امر تو قاهر چو باز بر تیهو %~% به چرخ حکم تو غالب چو شیر بر روباه(@)(@@) 42 سزد که مدح‌ کنم این مدیح دلکش را %~% به مدح خاتم پیغمبران جعلت فداه(@)(@@) 43 کمال مطلق فیض بسیط عقل نخست %~% محیط امکان مصداق‌کان حبیب‌الله(@)(@@) 44 وجود آگهش از سر هر وجود خبیر %~% ضمیر روشنش از فکر هر ضمیر آگاه(@)(@@) 45 به خاک بندگی او مزینست خدود %~% به داغ پیره‌ری از موسمست جباه(@)(@@) 46 ولای او بود از هر بلا وقایه تن %~% ز بیم آنکه اجل تاختن‌ کند ناگاه(@)(@@) 47 کمند وهم به بام جلال او نرسد %~% زهی کمال شرف لا اله الا الله PageV1P396(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 شاها ز ساغر لب ساقی شراب خواه %~% آخر سکندری تو ازین چشمه آب خواه(@)(@@) 2 از لعل یار بوسه همچون شکرستان %~% ز الماس جام جوهر یاقوت ناب خواه(@)(@@) 3 ساقی بخواه باده و بوس وکنار جوی %~% مطرب بخوان و بربط و چنگ و رباب خواه(@)(@@) 4 دیشب هلال عید ز بام افق نمود %~% از دست مهوشی می چون آفتاب خواه(@)(@@) 5 از آب تیغ در دل آتش شرر فکن %~% وز خاک‌ کوی خویش شکست گلاب خواه(@)(@@) 6 اقبال و بخت و شوکت و فر همعنان طلب %~% تایید و عون و فتح و ظفر همرکاب خواه(@)(@@) 7 از عزم خود شتاب و ز‌ گردون درنگ جوی %~% از حزم خود درنگ و ز غبرا شتاب خواه(@)(@@) 8 بدخواه را ز چشمه رخشان تیغ خویش %~% سیراب ساز و چشمه عمرش سراب خواه(@)(@@) 9 از روی و رای خویش مه و آفتاب جوی %~% از قدر و بذل خویش سپهر و سحاب خواه(@)(@@) 10 از لطف خود به جان مؤالف ثواب بخش‌ %~% وز قهر خود به جای مخالف عقاب خواه(@)(@@) 11 تا ناورد ز حکم 
ms865	 تو گردن‌ کشد برون %~% از کهکشان به گردن گردون طناب خواه(@)(@@) 12 تا صدهزار کشتی جان از بلا رهد %~% پنهان نهنگ تیغ به بحر قراب خواه(@)(@@) 13 جز بخت خود که قرعه بیداریش زدند %~% از امن عدل خویش ‌جهان را به‌خواب خواه(@)(@@) 14 بادا دوام عمر تو تا روز رستخیز %~% یارب دعای بنده خود مستجاب خواه PageV1P397(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ماه من در جمع تا چون شمع چهر افروخته %~% یک جهان ‌بروانه را از سوز غیرت سوخته(@)(@@) 2 سوزن مژگان او با رشته مشکین زلف %~% دیده ما را به روی او ز حیرت دوخته(@)(@@) 3 چند از این‌خامان دلا جو‌یی علاج ‌سوز عشق %~% چاره این آتش سوزان بجو از سوخته(@)(@@) 4 در دل من سوز عشق و برزخ من داغ مهر %~% او چو شمع و لاله دارد رخ چرا افروخته(@)(@@) 5 آب‌ آتش را کند خاموش اینک آب چشم %~% در دل من آتشی از عشق یار افروخته(@)(@@) 6 غمزه‌ او بی‌سبب‌ خونخواره و دلدوز نیست %~% غالبا این شیوه از تیر امیر آموخته(@)(@@) 7 معتمد آن اعتماد دولت شه‌کآسمان %~% خاک راهش را به صد ملک جهان نفروخته(@)(@@) 8 آصف دیوان ملک جم‌که مور تیغ او %~% روز هیجا با هزاران اهرمن ‌کین توخته(@)(@@) 9 عالمی ‌در دولت ‌او سیم و زر اندوختند %~% غیر قاآنی‌ که‌ گنج و شکر و صبر اندوخته PageV1P398(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 عبدس و ساقی در قدح‌ صهبا ز مینا ریخته %~% در گوهر الماس‌گون لعل مصفا ریخته(@)(@@) 2 کرده پی اکسیر جان در طلق زرنیخ روان %~% در ساغر سیماب‌سان‌ گوگرد حمرا ریخته(@)(@@) 3 آب از سر‌اب انگیخه آتش ز آب انگیخته %~% زآتش حباب انگیخته وز جرعه دریا ریخته(@)(@@) 4 می موج ‌زن در مشربه زان موج فوج غم تبه %~% اندر هلال یکشبه عقد ثریا ریخته(@)(@@) 5 پیمانه ‌کأس من معین غلمان عذاران حو‌ر عین %~% در بزم چون خلد برین طرح ثما را ریخته(@)(@@) 6 مجلس به‌خوبی ‌چون ارم زرین پیاله جام‌جم 
ms866	 %~% زنجیرها بر پای غم از موج صهبا ریخته(@)(@@) 7 خم مریم تهمت زده دوشیزه آبستن شده %~% وز طفل می در میکده آب مسیحا ریخته(@)(@@) 8 دف بر شبیه دایره در چنبرش صد چنبره %~% با هم به طرح مشوره طرح مواسا ریخته(@)(@@) 9 چنگست زالی پشت خم در پی عقابی متهم %~% هردم ز بانگ زیر و بم بنیاد غوغا ریخته(@)(@@) 10 صهبا به سیمین بلبله بکری به شادی حامله %~% از نقش زرین مشعله نیرنگ بیضا ریخته(@)(@@) 11 خنیاگران بربسته صف در چنگ‌چنگ و نای و دف %~% طرح نشاط از هر طرف در بزم دارا ریخته(@)(@@) 12 دارای‌اسکندر حشم هوشنگ طهمورث‌خدم %~% کز ابرکف‌گاه‌کرم لولوی لالا ریخته(@)(@@) 13 صبحست‌و بر طرف‌افق‌خونست عمدا ریخته %~% یا اطلس چینی فلک بر فرش دیبا ریخته(@)(@@) 14 شنگرف بر قرطاس بین بیجاده بر الماس بین %~% گرد زمزد طاس بین یاقوت حمرا ریخته(@)(@@) 15 تیغ سحر پرتاب شد نجم از فلک پرتاب شد %~% زان زهره شب آب شد وز زهره صفرا ریخته(@)(@@) 16 افراخت فروردین علم شد لشکر وی منهزم %~% صبح از شفق آتش ز دم بر دفع سرما ریخته(@)(@@) 17 رخشان سیه شد ناگهان کز وی سوادی ‌شد عیان %~% از نشتر خور آسمان بر دفع سودا ریخته(@)(@@) 18 یانی شجاع‌السلطنه چون شیر دشت ارجنه %~% خون دلیران یک‌تنه در دشت هیجا ریخته(@)(@@) 19 آنکو ز تیغ جانستان وانکو ز قدر بیکران %~% هم خون سلطان ارسلان هم آب بغرا ریخته(@)(@@) 20 رمخش چو ماری جان‌گزا آتش‌فشان چون اژدها %~% بر پیکر خصم دغا زان زهر افعی ریخته(@)(@@) 21 تیغش‌سمندرطینتی‌طوسی هندی‌فطرتی %~% رومی زنگی‌ هیأ‌تی آتش ز اعضا ریخته(@)(@@) 22 آتشدل‌ و پولادرگ وانگه به هیات چون ‌کجک %~% وز فرق پیلان یک به یک خون پیل بالا ریخته(@)(@@) 23 اقبال‌و دولت شایقش تایید و نصرت عاشقش %~% پیوسته اشک وامقش بر روی عذرا ریخته(@)(@@) 24 جرم‌ کو‌اکب‌ نیست هان ‌چون‌ گوهر از هرسو عیان %~% رشحی ‌ز دست درفشان بر طلق خضرا ریخته(@)(@@) 25 طبعش 
ms867	 نهالی بارور جودش شکوفه لطف‌بر %~% پیوسته در شاخش ثمر در باغ دیبا ریخته(@)(@@) 26 هم پایش از دانشوری بر فرق مهر و مشتری %~% هم آب ابر آذری از طبع والا ریخته(@)(@@) 27 رمحش به قتل دشمنان با زهر آلوده سنان %~% لیکن به‌ کام دوستان زان زهر حلوا ریخته(@)(@@) 28 در قعر دریا شد صدف‌ بر خجلت خود معترف %~% باشد لآلی ز ابر کف شرقا و غربا ریخته(@)(@@) 29 تیغش هلال‌آساستی از لمعه چون بیضاستی %~% برجش تن اعداستی زان شکل جوزا ریخته(@)(@@) 30 در عهدش اصنام ستم افتاد بر خاک عدم %~% چونانکه از طاق حرم شد لات و عزی ریخته(@)(@@) 31 ای حرز جانها نام تو دور طرب ایام تو %~% دست فلک در جام تو شهد مصفا ریخته(@)(@@) 32 از سده‌ات نازان زمین بر سده عرش برین %~% بر فره‌ات جان‌آفرین فر موفا ریخته(@)(@@) 33 تیغت به خون آبستنی وز خو‌ن ‌کنارش ‌گلشنی %~% صد رود خون از هر تنی روز محابا ریخه(@)(@@) 34 کلکت‌کشیدس‌از رقم بر نقش انگلیون قلم %~% در قالب موتی ز دم روح معلا ریخته(@)(@@) 35 زان هندی دریانشین تیر فلک عزلت‌گزین %~% سر برده اندر آستین‌ گوهر ز شهلا ریخته(@)(@@) 36 ماری بود خوش خال و خط بر وی ز هر زنگی نقط %~% درکام خصم بی‌غلط زهر آشکارا ریخته(@)(@@) 37 مشک ‌آورند از ملک‌ چین‌ او رفته‌ در مغرب‌ زمین %~% مشک ارمغان آورده بین در چین طغرا ریخته(@)(@@) 38 گه رفته در هندوستان آلوده از عنبر دهان %~% طوطی‌صفت درکام جان شکر ز آوا ریخته(@)(@@) 39 روزی‌ که از گرد سپه جلباب بندد مهر مه %~% گردد ز هرسو خاک ره در چشم بینا ریخته(@)(@@) 40 هامون شود آمون خون صحرا شود سیحون خون %~% وز هر جهت ‌جیحون‌ خون ‌بر خاک ‌و خارا ریخته(@)(@@) 41 اندر زمین دست فلک بر آتش افشاند نمک %~% سیماب درگوش ملک بینی ز هرا ریخته(@)(@@) 42 پولاد سنجان در وغا بر باره پولاد خا %~% هریک ز هندی 
ms868	 اژدها چون پیل بالا ریخته(@)(@@) 43 هنگام رزم از هرکران‌گردد ز تیغ خونفشان %~% خون از تن قربانیان چون عید اضحی ریخته(@)(@@) 44 هر صارم هندی ‌نسب پوشد به ‌تن چینی سلب %~% ناری شود ذات لهب برکشت جانها ریخته(@)(@@) 45 چون تو برون آیی ز صف کف بر لب و خنجر به کف %~% بر چهر چون ماهت‌ کلف ازگرد غبرا ریخه(@)(@@) 46 از خون خصم بوالهوس جاری کند رود ارس %~% تیغت‌ که‌ اندر یک‌ نفس صد خون به تنها ریخته(@)(@@) 47 هرکس پی اخذ بقا کالا فشاند در وغا %~% از ابلهی خصم دغا جان جای کالا ریخته(@)(@@) 48 ای ‌خنگ‌ گردون ‌مرکبت ‌نصرت ‌روان‌ در موکبت %~% بر طور جانها کوکبت نور تجلی ریخته(@)(@@) 49 مانا به مرگ ناگهان تیغت بود جان در میان %~% کز بدکنش بگرفته جان خونش مفاجا ریخته(@)(@@) 50 با همتت ای دادگر دریای اعظم در نظر %~% آبیست اندر رهگذر از مشک سقا ریخته(@)(@@) 51 پیرار فروردین‌به‌ری‌کردی چو جشن عید طی %~% زی‌ملک‌‌ خور راندی‌به ری طرح تماشا ریخته(@)(@@) 52 هم پار در آتشکده آراسته جشن سده %~% از قهر نار موصده بر جان اعدا ریخته(@)(@@) 53 در شثن‌طراز امسال‌هم دادی طراز جشن جم %~% در کام جانها از کرم نقل مهنا ریخته(@)(@@) 54 ساغر ز می اندوخته‌ کندر به‌ کندر سوخته %~% در مجمره افروخته عود مطرا ریخته(@)(@@) 55 مانی‌به‌عشرت‌همچنین‌تاسال دیگر طرح دین %~% از نصرت جان ‌آفرین اندر بخارا ریخته(@)(@@) 56 ای شاه قاآنی منم خاقانی ثانی منم %~% نی آب خاقانی منم زین نظم غرا ریخته(@)(@@) 57 اکنون منم در شاعری قایم مقام عنصری %~% از نقش الفاظ دری بیرنگ معنا ریخته(@)(@@) 58 تا هست ازین اشعار تر در صفحه گیتی اثر %~% هردم ازوگنج‌گهر در سمع دانا ریخته(@)(@@) 59 فرخنده‌ بادا فال تو پاینده ماه و سال تو %~% نور هدی بر حال تو زاسما حسنی ریخته(@)(@@) 60 کاخ ریاست منزلت بزم‌ کیاست محفلت %~% فیض‌کرامت بر دلت ایزد تعالی ریخته PageV1P399(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 عیدست 
ms869	 و جام زرنشان از می‌گران‌بار آمده %~% هر زاهدی دامن ‌کشان در دیر خمار آمده(@)(@@) 2 زاهدکه‌کرد انکار می حیرت بدش ازکار می %~% از هرچه جزگفتار می اینک در انکار آمده(@)(@@) 3 عیدست و یار دلستان بر دست جام ارغوان %~% با قد چون سرو روان بر طرف ‌گلزار آمده(@)(@@) 4 گل بیقرار از روی او سنبل اسیر موی او %~% اندر خم‌ گیسوی او دلها گرفتار آمده(@)(@@) 5 برگ صبوح از می بود جان را فتوح از می بود %~% تفریح روح از می بود هرگه‌ که افکار آمده(@)(@@) 6 می جان بود پیمانه تن دست بتانش پیرهن %~% زانگشتهایش بر بدن رگهای بسیار آمده(@)(@@) 7 آن لجه سیماب بین آن آتشین‌گرداب بین %~% آتش میان آب بین هردم شرربار آمده(@)(@@) 8 عید مبارک ‌پی نگر رخشنده جام می نگر %~% نالان نوای نی نگرکز هجر دلدار آمده(@)(@@) 9 چنگست زالی ناتوان رگهاش پیدا زاستخوان %~% از ناتوانی هر زمان در ناله زار آمده(@)(@@) 10 نایی که بستد هوش نی‌گفتا چه اندرگوش نی %~% کز سینه پرجوش نی آه شرربار آمده(@)(@@) 11 بربد به‌ کف بربط نگر خون بط اندر بط نگر %~% می تا به هفتم خط نگر در جام شهوار آمده(@)(@@) 12 بیجاده‌کانی است می یاقوت رمانی است می %~% لعل بدخشانی است می کایینه کردار آمده(@)(@@) 13 از مطلع طبعم دگر زد مطلعی تابنده‌سر %~% خورشید گویی جلوه‌گر بر چرخ دوار آمده(@)(@@) 14 خرم دو عید دلگشا اینک پدیدار آمده %~% فرخ دو جشن جانفزا اینک نمودار آمده PageV1P400(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 جشنی ز نوروز عجم‌ کاراستش جمشید جم %~% جشنی که با کون و علم شاه جهاندار آمده(@)(@@) 2 یعنی شجاع‌السلطنه آنکو ز قلب و میمنه %~% همرزم صد تن یک‌تنه در دشت پیکار آمده(@)(@@) 3 اسکندر دارا خدم دارای اسکندر حشم %~% سالار افریدون علم سلم سپهدار آمده(@)(@@) 4 از لطف ‌و قهرش ‌این ‌زمان ‌شد آشکارا در جهان %~% زان مرکز آب روان زین مرکز نار آمده(@)(@@) 5 لرزان تن ‌کاووس 
