ms1407	 عنه .(@)(@@)(@@)(@@) $ ( 12612 ) قال النبي :(@)(@@) | 30 ( الرؤيا الصالحة من الله ، والرؤيا السوء من الشيطان ، فمن رأى رؤيا فكره منها شيئا فلينفث عن يساره ، وليتعوذ بالله من الشيطان فإنها لا تضره ولا يخبر بها أحدا ؛ فإن رأى رؤيا حسنة فليبشر ولا يخبر بها إلا من يحب ) )(@)(@@) ( م ) عن أبي قتادة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12613 ) قال النبي :(@)(@@) | 30 ( الرؤيا ثلاثة : فبشرى من الله ، وحديث النفس ، وتخويف من الشيطان ؛ فإذا رأى أحدكم رؤيا تعجبه فليقصها إن شاء على أحد ، وأن أرى شيئا يكرهه فلا يقصه على أحد وليقم يصلي ، وليقم يصلي ، وأكره PageV04P432 الغل ، وأحب القيد ، القيد ثبات في الدين ) )(@)(@@) ( ت ه ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12614 ) قال النبي :(@)(@@) | 30 ( الرؤيا ثلاثة : منها تهاويل من الشيطان ليحزن ابن آدم ، ومنها ما يهم به الرجل في يقظته فيراه في منامه ، ومنها جزء من ستة وأربعين جزءا من النبوة ) )(@)(@@) ( ه ) عن عوف بن مالك رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12615 ) قال النبي :(@)(@@) | 30 ( الرؤيا ستة : المرأة خير ، والبعير حرب ، واللبن فطرة ، والخضرة جنة ، والسفينة نجاة ، والتمر رزق ) )(@)(@@) ( ع ) في معجمه عن رجل من الصحابة .(@)(@@)(@@)(@@) $ ( 12616 ) قال النبي :(@)(@@) | 30 ( الرؤيا على رجل طائر ما لم تعبر ، فإذا عبرت وقعت ، ولا تقصها إلا على واد أو ذي رأي ) )(@)(@@) ( د ه ) عن أبي رزين رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12617 ) قال النبي :(@)(@@) | 30 ( الرؤيا من الله ، والحلم من الشيطان ؛ فإذا رأى أحدكم شيئا يكرهه فليبصق عن يمينه ثلاثا ، وليستعذ بالله من الشيطان الرحيم ثلاثا ، وليتحول عن جنبه الذي كان عليه ) )(@)(@@) ( ه ) عن أبي قتادة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 12618 ) قال النبي :(@)(@@) | 30 ( الربا اثنان وسبعون بابا ، أدناها مثل إتيان الرجل أمه ، وإن أربى الربا استطالة الرجل في عرض أخيه ) )(@)(@@) ( طس ) عن البراء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12619 ) قال النبي :(@)(@@) | 30 ( الربا ثلاثة وسبعون بابا ) )(@)(@@) ( ه ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12620 ) قال النبي :(@)(@@) | 30 ( الربا ثلاثة وسبعون بابا ، أيسرها مثل أن ينكح PageV04P433 الرجل أمه ، وإن أربى الربا عرض الرجل المسلم ) )(@)(@@) ( ك ) عن 
ms1408	 ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12621 ) قال النبي :(@)(@@) | 30 ( الربا سبعون بابا ، والشرك مثل ذالك ) )(@)(@@) البزار عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12622 ) قال النبي :(@)(@@) | 30 ( الربا سبعون حوبا ، أيسرها أن ينكح الرجل أمه ) )(@)(@@) ( ه ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12623 ) قال النبي :(@)(@@) | 30 ( الربا وإن كثر فإن عاقبته تصير إلى قل ) )(@)(@@) ( ك ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12624 ) قال النبي :(@)(@@) | 30 ( الربوة الرملة ) )(@)(@@) ابن جرير وابن أبي حاتم وابن مردويه عن مرة البهزي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12625 ) قال النبي :(@)(@@) | 30 ( الرجل أحق بصدر دابته وأحق بمجلسه إذا رجع ) )(@)(@@) ( حم ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12626 ) قال النبي :(@)(@@) | 30 ( الرجل أحق بصدر دابته ، وبصدر فراشه ، وأن يؤم في رحله ) )(@)(@@) الدارمي ( هق ) عن عبد الله بن حنظلة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12627 ) قال النبي :(@)(@@) | 30 ( الرجل أحق بصدر دابته ، وصدر فراشه ، والصلاة في منزله إلا إماما يجمع الناس عليه ) )(@)(@@) ( طب ) عن فاطمة الزهراء رضي الله عنها .(@)(@@)(@@)(@@) $ ( 12628 ) قال النبي :(@)(@@) | 30 ( الرجل أحق بمجلسه وإن خرح لحاجته ثم عاد فهو أحق بمجلسه ) )(@)(@@) ( ت ) عن وهب بن حذيفة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12629 ) قال النبي :(@)(@@) | 30 ( الرجل أحق بهبته ما لم يثب منها ) )(@)(@@) ( ه ) عن أبي هريرة PageV04P434 رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12630 ) قال النبي :(@)(@@) | 30 ( الرجل الصالح يأتي بالخبر الصالح ، والرجل السوء يأتي بالخبر السوء ) )(@)(@@) ( حل ) و ابن عساكر عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12631 ) قال النبي :(@)(@@) | 30 ( الرجل جبار ) )(@)(@@) ( د ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12632 ) قال النبي :(@)(@@) | 30 ( الرجل على دين خليله ، فلينظر أحدكم من يخالل ) )(@)(@@) ( د ت ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12633 ) قال النبي :(@)(@@) | 30 ( الرجم كفارة ما صنعت ) )(@)(@@) ( ن ) و الضياء عن الشريد بن سويد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12634 ) قال النبي :(@)(@@) | 30 ( الرحم شجنة معل