ms241	 بن العربي رحمه الله قال حدثنا الشيخ الأجل الأمين أبو محمد هبة الله بن أحمد الأكفاني قال أخبرني ببعضه الشيخ الحافظ أبو محمد عبد العزيز بن أحمد الكتاني وبباقيه أبو العباس أحمد بن منصور الغساني المالكي عنه(@)(@@)(@@)(@@) | 589 - (@)(@@) فضائل مالك بن أنس تأليف أحمد بن مروان المالكي(@)(@@) حدثني بها الشيخ أبو محمد بن عتاب رحمه الله عن أبيه عن القاضي أبي الوليد يونس بن عبد الله بن مغيث قال حدثنا أبو القاسم خلف بن محمد قال محمد بن عتاب وحدثنا بها محمد بن سعيد بن نبات قال حدثنا محمد بن أحمد بن الحزاز القروي قالا حدثنا أحمد بن مروان مؤلفها رحمه الله(@)(@@)(@@)(@@) | 590 - (@)(@@) فضائل مالك للقشيري(@)(@@) حدثني بها أبو محمد بن عتاب رحمه الله عن أبيه عن القاضي أبي الوليد يونس بن عبد الله بن مغيث عن أبي جعفر أحمد بن عون الله قال حدثنا بكر بن محمد القشيري(@)(@@)(@@)(@@) | 591 - (@)(@@) فضائل مالك للزبيدي(@)(@@) حدثني بها أبو محمد بن عتاب رحمه الله عن أبيه قال حدثنا أبو عثمان سعيد ابن رشيق قال حدثنا الراوية أبو محمد عبد الله بن محمد بن علي الباجي قال حدثنا أبو القاسم الحسين بن عبد الله الزبيدي مؤلفها والحسن هذا والد أبي بكر محمد بن الحسن الزبيدي النحوي الأديب(@)(@@) PageV00P000(@)(@@) ولم يسمع منه ابن أبو بكر الأديب لصغره قال ابن الفرضي أخبرني بذلك ابنه أبو بكر قال الراوية أبو محمد الباجي توفي أبو القاسم الزبيدي المذكور سنة 318(@)(@@)(@@)(@@) | 592 - (@)(@@) كتاب الانتقاء في فضائل الثلاثة الفقهاء مالك والشافعي وأبي حنيفة تأليف الشيخ الحافظ أبي عمر بن عبد البر النمري الحافظ رحمه الله(@)(@@) حدثني به الشيخ أبو محمد بن عتاب وأبو الحسن علي بن عبد الله بن موهب رحمهما الله إجازة عن أبي عمر بن عبد البر مؤلفه رحمه الله(@)(@@)(@@)(@@) | 593 - (@)(@@) كتاب فضائل مالك وأخباره تأليف أبي الحسن بن فهد رحمه الله(@)(@@) حدثني به أبو الحسن علي بن عبد الله بن موهب رحمه الله عن أبي العباس أحمد ابن 
ms242	 عمر بن أنس العذري عن أبي الحسن علي بن فهد الحافظ مؤلفه رحمه الله(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 17 - ومن تواليف أبي بكر بن أبي الدنيا رحمه الله(@)(@@)(@@)(@@) | 594 - (@)(@@) كتاب البكاء(@)(@@)(@@)(@@) | 595 - (@)(@@) وكتاب التهجد له(@)(@@)(@@)(@@) | 596 - (@)(@@) وكتاب العقوبات له(@)(@@)(@@)(@@) | 597 - (@)(@@) وكتاب السحاب والرعد والبرق له(@)(@@) حدثني بها كلها أبو بكر محمد بن أحمد بن طاهر رحمه الله عن أبي علي الغساني عن أبي العاصي حكم بن محمد الجذامي عن عبيد الله بن محمد بن خلف بن سهل بن أبي غالب البزار عن أحمد بن مروان المالكي عن أبي بكر بن أبي الدنيا رحمه الله(@)(@@)(@@)(@@) | 598 - (@)(@@) كتاب محاسبة النفس لابن أبي الدنيا أيضا جزء(@)(@@)(@@)(@@) | 599 - (@)(@@) وكتاب الخائفين له جزءان(@)(@@)(@@)(@@) | 600 - (@)(@@) وكتاب الورع له جزء(@)(@@)(@@)(@@) | 601 - (@)(@@) وكتاب الهواتف له جزء(@)(@@)(@@)(@@) | 602 - (@)(@@) وكتاب قصد الأمل له جزء(@)(@@)(@@)(@@) | 603 - (@)(@@) وكتاب القبور له أربعة أجزاء(@)(@@)(@@)(@@) | 604 - (@)(@@) وكتاب العوابد له(@)(@@)(@@)(@@) | 605 - (@)(@@) وكتاب ذكر الموت له سبعة أجزاء(@)(@@) حدثني بها كلها الشيخ أبو جعفر أحمد بن محمد بن عبد العزيز رحمه الله عن أبي علي الغساني عن أبي العاصي حكم بن محمد الجذامي عن أبي القاسم عبيد الله بن محمد ابن جعفر السقطي عن أبي عمر محمد بن العباس بن محمد بن زكرياء بن حيويه الحزاز عن أبي بكر عمر بن سعد القراطيسي عن أبي بكر بن أبي الدنيا رحمه الله(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 606 - (@)(@@) كتاب مجابي الدعوة له(@)(@@)(@@)(@@) | 607 - (@)(@@) وكتاب الفرج بعد الشدة له(@)(@@)(@@)(@@) | 608 - (@)(@@) وكتاب ذم المسكر له(@)(@@)(@@)(@@) | 609 - (@)(@@) وكتاب اليقين له(@)(@@)(@@)(@@) | 610 - (@)(@@) وكتاب حسن الظن له(@)(@@)(@@)(@@) | 611 - (@)(@@) وكتاب الذكر له(@)(@@)(@@)(@@) | 612 - (@)(@@) وكتاب الملاهي له(@)(@@)(@@)(@@) | 613 - (@)(@@) وكتاب المحاسبة له(@)(@@) حدثني بذلك كله القاضي أبو بكر بن العربي رحمه الله قال حدثنا بها أبو الفوارس طراد بن محمد الزينبي قراءة عليه وأنا أسمع قال حدثنا أبو الحسين بن بشران قال حدثنا أبو علي حسين بن صفوان البرذعي عن أبي بكر بن أبي الدنيا مؤلفها رحمه الله(@)(@@)(@@)(@@) | 614 - (@)(@@) كتاب قرى الضيف له(@)(@@) حدثني به القاضي أبو بكر بن العربي رحمه الله قال حدثني به 
ms243	 أبو الفوارس الزينبي عن أبي الحسين بن بشران عن أبي الحسن أحمد بن محمد بن جعفر الجوزي عن أبي بكر بن أبي الدنيا رحمه الله(@)(@@)(@@)(@@) | 615 - (@)(@@) كتاب القناعة والتعفف عن المسألة والرضى بالقسم في الرزق له(@)(@@) حدثني به القاضي أبو بكر بن العربي رحمه الله عن أبي عبد الله الحسين بن أحمد بن محمد بن طلحة بن عثمان النعالي عن أبي سهل محمود بن عمر العكبري عن أبي الحسن علي بن الفرج بن علي بن أبي روح العكبري عن ابن أبي الدنيا(@)(@@)(@@)(@@) | 616 - (@)(@@) وكتاب الشكر له(@)(@@) حدثني به القاضي أبو بكر بن العربي رحمه الله عن أبي الحسن بن أيوب عن أبي علي بن شاذان عن أبي بكر أحمد بن سليمان النجاد عن أبي بكر بن أبي الدنيا(@)(@@)(@@)(@@) | 617 - (@)(@@) كتاب قصد الأمل له(@)(@@) حدثني به القاضي أبو بكر بن العربي رحمه الله عن أبي الحسن بن أيوب عن أبي علي بن شاذان عن أبي جعفر عبد الله بن إسماعيل الهاشمي عن ابن أبي الدنيا(@)(@@)(@@)(@@) | 618 - (@)(@@) كتاب الآيات ومن تكلم بعد الموت له(@)(@@)(@@)(@@) | 619 - (@)(@@) وكتاب الحذر والشفقة له(@)(@@)(@@)(@@) | 620 - (@)(@@) وكتاب التقوى له(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 621 - (@)(@@) وكتاب ذم الفحش له(@)(@@)(@@)(@@) | 622 - (@)(@@) وكتاب ذم الغضب له(@)(@@)(@@)(@@) | 623 - (@)(@@) وكتاب التوكل له(@)(@@)(@@)(@@) | 624 - (@)(@@) وكتاب مداراة الناس له(@)(@@)(@@)(@@) | 625 - (@)(@@) وكتاب الوجل له(@)(@@) حدثني بذلك كله القاضي أبو بكر بن العربي أيضا رحمه الله عن أبي الحسين أحمد ابن عبد القادر بن محمد بن يوسف عن ابن بشران عن البرذعي عن ابن أبي الدنيا(@)(@@)(@@)(@@) | 626 - (@)(@@) كتاب مواعظ الخلفاء لابن أبي الدنيا(@)(@@) حدثني به أبو محمد بن عتاب رحمه الله عن أبيه عن أبي عثمان سعيد بن سلمة قراءة منه عليه عن أبي بكر محمد بن معاوية القرشي قال حدثنا إبراهيم بن موسى بن جميل قال حدثنا أبو بكر بن أبي الدنيا رحمه الله(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 18 - ومن تواليف أبي سعيد بن الأعرابي رحمه الله في معاني الزهد(@)(@@)(@@)(@@) | 627 - (@)(@@) كتاب الاختصاص في ذكر الفقر والغنى(@)(@@)(@@)(@@) | 628 - (@)(@@) وكتاب الإخلاص ومعاني علم الباطن له 
ms244	(@)(@@)(@@)(@@) | 629 - (@)(@@) وكتاب اختصار الطريق(@)(@@)(@@)(@@) | 630 - (@)(@@) وكتاب المحبة(@)(@@)(@@)(@@) | 631 - (@)(@@) وكتاب الصبر والتصبر له(@)(@@)(@@)(@@) | 632 - (@)(@@) وكتاب العمر والشيب له(@)(@@) حدثني بذلك كله أبو بكر محمد بن أحمد بن طاهر رحمه الله عن أبي علي الغساني عن أبي العاصي حكم بن محمد الجذامي عن أبي إسحاق بن التمار المصري عن أبي سعيد بن الأعرابي(@)(@@)(@@)(@@) | 633 - (@)(@@) وكتاب معاني الزهد والمقالات فيه من تأليفه أيضا(@)(@@) حدثني به أبو جعفر أحمد بن عبد العزيز رحمه الله عن أبي علي الغساني عن أبي العاصي حكم بن محمد الجذامي عن أبي محمد بن النحاس عن أبي سعيد بن الأعرابي(@)(@@)(@@)(@@) | 634 - (@)(@@) وكتاب طبقات النساك من تأليفه أيضا(@)(@@) حدثني به الشيخ أبو محمد بن عتاب رحمه الله قال حدثنا أبي رحمه الله قال حدثنا القاضي أبو الوليد يونس بن عبد الله بن مغيث قال حدثنا أحمد بن عون الله عن أبي سعيد بن الأعرابي رحمه الله(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 19 - من تواليف أبي بكر محمد بن الحسين الأجري رحمه الله(@)(@@) - كتاب الشريعة(@)(@@)(@@)(@@) | 635 - (@)(@@) وكتاب التوبة له(@)(@@) - وكتاب أخلاق حملة القرآن له(@)(@@)(@@)(@@) | 636 - (@)(@@) وكتاب فضل العلم(@)(@@)(@@)(@@) | 637 - (@)(@@) وكتاب أخلاق أهل البر والتقى له(@)(@@)(@@)(@@) | 638 - (@)(@@) وكتاب فضل العلم له(@)(@@)(@@)(@@) | 639 - (@)(@@) وكتاب أوصاف السبعة له(@)(@@)(@@)(@@) | 640 - (@)(@@) وكتاب التفرد والعزلة له(@)(@@)(@@)(@@) | 641 - (@)(@@) وكتاب قيام الليل وفضل قيام رمضان له(@)(@@)(@@)(@@) | 642 - (@)(@@) وكتاب التهجد له(@)(@@)(@@)(@@) | 643 - (@)(@@) وكتاب حسن الخلق له(@)(@@)(@@)(@@) | 644 - (@)(@@) وشرح قصيدة السجستاني له(@)(@@)(@@)(@@) | 645 - (@)(@@) وكتاب صفة الغرباء من المؤمنين له(@)(@@)(@@)(@@) | 646 - (@)(@@) وكتاب الشبهات له(@)(@@)(@@)(@@) | 647 - (@)(@@) وكتاب قصة الحجر الأسود وزمزم وبدء شأنها له(@)(@@)(@@)(@@) | 648 - (@)(@@) وكتاب رسالته إلى أهل بغداذ له(@)(@@)(@@)(@@) | 649 - (@)(@@) وكتاب رجوع ابن عباس عن الصرف له(@)(@@) - وكتاب تغيير الأزمنة له(@)(@@) حدثني بذلك كله أبو بكر محمد بن أحمد بن طاهر رحمه الله عن أبي علي الغساني عن أبي العاصي حكم بن محمد الجذامي عن أبي عبد الله محمد بن خليفة البلوي وأبي القاسم عبيد الله بن محمد السقطي وأبي الفرج عبدوس بن محمد الطليطلي قالوا كلهم حدثنا أبو بكر الأجري رحمه الله(@)(@@) PageV00P000(@)(@@) - كتاب النصيحة الكبير 
ms245	 من تأليفه أيضا(@)(@@) حدثني به أبو بكر محمد بن أحمد بن طاهر أيضا رحمه الله عن أبي علي الغساني قال حدثني به أبو الخطاب هبة الله بن عار الكرماني فيما كتب إلي بخطه من مدينة الإسكندرية في عقب شعبان من سنة 449 قال حدثنا أبو القاسم عبد الملك بن محمد ابن عبد الله بن بشران المعدل البغداذي عن أبي بكر الأجري رحمه الله وكان أبو الخطاب المذكور يحدث بجميع تواليف أبي بكر الأجري بهذا السند(@)(@@) حدثني بذلك كله أيضا الشيخ أبو محمد بن عتاب أيضا رحمه الله عن أبي عمر بن عبد البر النمري الحافظ عن أبي عبد الله محمد بن خليفة البلوي وأبي القاسم عبيد الله بن محمد السقطي كليهما عن أبي بكر الأجري رحمه الله(@)(@@) وقد تقدم ذكري لكتاب الأربعين حديثا من تأليفه وكتاب الشريعة له وكتاب التوبة له وكتاب النصيحة الكبير له وكتاب تغيير الأزمنة له وقراءتي لهذه الكتب على أبي بكر يحيى بن موسى بن عبد الله الإمام وقراءتي لكتاب الأربعين حديثا أيضا على أبي الحسن يونس بن محمد بن مغيث وذكرت الأسانيد في ذلك كله فيما تقدم عند ذكر كتب منثور الحديث وما يتصل بذلك(@)(@@) PageV01P253(@)(@@)(@@)(@@) $ 20 - ومن تواليف أبي ذر عبد بن أحمد الهروي رحمه الله(@)(@@) - كتاب مناسك الحج وقد تقدم ذكري له قبل هذا مع كتب الفقه(@)(@@)(@@)(@@) | 650 - (@)(@@) وكتاب الدعوات له(@)(@@) وكتاب الرؤيا والمنامات له(@)(@@)(@@)(@@) | 651 - (@)(@@) وكتاب دلائل النبوة له(@)(@@)(@@)(@@) | 652 - (@)(@@) وكتاب العيدين له(@)(@@)(@@)(@@) | 653 - (@)(@@) وكتاب الزناء واليمين الفاجرة وشهادة الزور له(@)(@@) - وكتاب سيرة النبي صلى الله عليه وسلم وأصحابه في عيشهم وتخليهم عن الدنيا له وقد تقدم ذكري له أيضا قبل هذا(@)(@@)(@@)(@@) | 654 - (@)(@@) وكتاب بيعة العقبة له(@)(@@)(@@)(@@) | 655 - (@)(@@) وحديث المعدانة وحنين له(@)(@@)(@@)(@@) | 656 - (@)(@@) وكتاب المسند المؤلف على الصحيحين له(@)(@@) حدثني بذلك كله شيخنا أبو القاسم أحمد بن محمد بن بقي وأبو الحسن علي بن عبد الله بن موهب رحمهما الله قالا حدثنا أبو العباس أحمد بن عمر بن أنس العذري عن أبي ذر 
ms246	 مؤلفها رحمه الله(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 21 - في الحكمة والمواعظ وغيرها(@)(@@)(@@)(@@) | 657 - (@)(@@) كتاب الابتهاج بمحبة الله تعالى تأليف القاضي أبي الوليد يونس بن عبد الله بن مغيث رحمه الله(@)(@@)(@@)(@@) | 658 - (@)(@@) وكتاب المنقطعين إلى الله تعالى تأليفه(@)(@@)(@@)(@@) | 659 - (@)(@@) وكتاب المتهجد من تأليفه أيضا(@)(@@)(@@)(@@) | 660 - (@)(@@) وكتاب التيسير والتسبيب والاختصاص والتقريب من تأليفه أيضا(@)(@@) حدثني بذلك كله شيخنا أبو الحسن يونس بن محمد بن مغيث رحمه الله مناولة منه لي من يده إلى يدي قال حدثني بها جدي مغيث بن محمد بن يونس عن جده القاضي أبي الوليد يونس بن عبد الله مؤلفها رحمه الله(@)(@@)(@@)(@@) | 661 - (@)(@@) كتاب التهجد لإبراهيم بن الجنيد(@)(@@) وحدثني به أبو بكر محمد بن أحمد بن طاهر رحمه الله عن أبي علي الغساني عن أبي العاصي حكم بن محمد الجذامي عن خلف بن قاسم بن عبد الله بن محمد المفسر الدمشقي عن محمد بن حامد بن السري عن ابن الجنيد مؤلفه(@)(@@)(@@)(@@) | 662 - (@)(@@) كتاب البكاء لدحيم(@)(@@) حدثني به أبو بكر بن طاهر رحمه الله عن أبي علي الغساني عن حكم بن محمد الجذامي عن أبي بكر أحمد بن محمد بن إسماعيل بن الفرج عن سعيد عن هشام بن مرثد الطبراني عن دحيم مؤلفه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 663 - (@)(@@) كتاب العزلة للخطابي(@)(@@) حدثني به الشيخ أبو محمد بن عتاب رحمه الله عن أبي عمرو عثمان بن أبي بكر السفاقسي قال حدثنا محمد بن علي بن عبد الله الفارض الحافظ عن أبي سليمان حمد بن محمد الخطابي رحمه الله(@)(@@) قال أبو محمد بن عتاب وحدثني به أيضا أبو محمد بن عبد الله ابن سعيد الشنتجالي عن أبي جعفر بن محمد المروروذي الفقيه بمكة عن أبي سليمان الخطابي(@)(@@)(@@)(@@) | 664 - (@)(@@) كتاب آداب النفوس لمحمد بن جرير الطبري وهو أيضا كتاب أعمال الجوارح بالآداب النفيسة والأخلاق الحميدة وهو كتاب جليل في معناه(@)(@@) حدثني به الشيخ أبو محمد بن عتاب عن أبيه رحمهما الله عن أبي المطرف عبد الرحمن بن مروان القنازعي عن أبي الطيب أحمد بن عمرو الحريري عن الطبري(@)(@@) قال أبو محمد 
ms247	 بن عتاب وحدثني أيضا به أبو عمر بن عبد البر النمري الحافظ عن خلف بن قاسم الحافظ عن أبي العباس أحمد بن إبراهيم بن علي الكندي وسليل بن أحمد ابن سليل جميعا عن أبي جعفر الطبري رحمه الله(@)(@@) وحدثني به أيضا أبو بكر محمد بن أحمد بن طاهر رحمه الله عن أبي علي الغساني قال قال لي حكم بن محمد قرأته علي الفضل أحمد بن قاسم البزار وحدثني به عن أحمد بن الفضل الدينوري عن محمد بن جرير الطبري(@)(@@)(@@)(@@) | 665 - (@)(@@) كتاب الدليل إلى طاعة الجليل فيما تنطوي عليه الجوانح وتباشره بالعمل الجوارح وهو كتاب يوم وليلة تأليف أبي عمر أحمد بن محمد المقرىء الطلمنكي رحمه الله ستون جزءا(@)(@@) حدثني به شيخنا أبو الحسن يونس بن محمد بن مغيث رحمه الله عن القاضي أبي عمر أحمد بن محمد بن يحيى بن الحذاء التميمي عن مؤلفه أبي عمر الطلمنكي(@)(@@) وحدثني به أيضا شيخنا الخطيب أبو الحسن شريح بن محمد بن شريح المقرئ رحمه الله عن خاله الراوية أبي عبد الله أحمد بن محمد الخولاني عن أبي عمر الطلمنكي مؤلفه رحمه الله(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 666 - (@)(@@) كتاب الواعظ لابن أبي زمنين(@)(@@)(@@)(@@) | 667 - (@)(@@) وكتاب حياة القلوب له(@)(@@)(@@)(@@) | 668 - (@)(@@) وكتاب أنس المريد له وغيرهما من تواليفه رحمه الله(@)(@@) حدثني بذلك شيخنا أبو محمد بن عتاب رحمه الله عن أبي زكرياء يحيى بن محمد ابن حسين القليعي رحمه الله(@)(@@)(@@)(@@) | 669 - (@)(@@) كتاب سبل الخيرات لابن نجاح(@)(@@) حدثني به أبو محمد بن عتاب رحمه الله قال حدثني به أبو محمد عبد الله بن سعيد الشنتجالي عن مؤلفه أبي الحسين يحيى بن نجاح رحمه الله(@)(@@)(@@)(@@) | 670 - (@)(@@) كتاب شرف المصطفى صلى الله عليه وسلم تأليف أبي سعد عبد الملك بن محمد الواعظ رحمه الله(@)(@@) حدثني به أبو محمد بن عتاب رحمه الله عن الشيخ أبي محمد عبد الله بن سعيد الشنتجالي عن مؤلفه أبي سعد المذكور(@)(@@)(@@)(@@) | 671 - (@)(@@) كتاب اختصار شرف المصطفى صلى الله عليه وسلم تأليف القاضي الإمام الحافظ أبي الفضل عياض بن 
ms248	 موسى بن عياض اليحصبي رحمه الله(@)(@@) حدثني به مؤلفه رضي الله عنه إجازة ومشافهة وإذنا(@)(@@)(@@)(@@) | 672 - (@)(@@) كتاب شفاء الصدور في الوصايا والمواعظ والزهد والرقائق وغير ذلك من العلم وهو كتاب جليل شريف كبير تأليف شيخنا أبي محمد بن عتاب(@)(@@) حدثني به مؤلفه رضي الله عنه إجازة فيما كتب به إلي مع جميع تواليفه ورواياته ومجموعاته(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 673 - (@)(@@) كتاب الهداية إلى سبيل العناية في الزهد والرقائق وفضائل الأعمال وغير ذلك من العلوم وهو كتاب جليل لا نظير له في علم التذكير تأليف الشيخ الفقيه الزاهد أبي محمد عبد الله بن فرج بن غزلون اليحصبي ويعرف بابن الغسال رحمه الله(@)(@@) حدثني به الشيخ الفقيه المقرئ أبو بكر يحيى بن خلف بن النفيس الحميدي الخلوف رحمه الله إجازة فيما كتب به إلي عن مؤلفه أبي محمد بن العسال رحمه الله ومغفرته ورضوانه عليه(@)(@@)(@@)(@@) | 674 - (@)(@@) كتاب العقل وفضله تأليف أبي الوليد الخراساني(@)(@@) حدثني به أبو محمد بن عتاب عن أبيه رحمهما الله عن أبي سعيد خلف الجعفري قال حدثنا أبو العباس أحمد بن العباس بن إلياس الأملوكي بمصر قال حدثنا أبو الحسن أحمد بن عبد الله بن علي الناقد قال حدثنا إسماعيل بن محمد الخراساني مؤلفه(@)(@@)(@@)(@@) | 675 - (@)(@@) كتاب ما روي في العقل تأليف أبي قتيبة سلم بن الفضل البغداذي(@)(@@) حدثني به أبو محمد بن عتاب عن أبيه رحمهما الله قال قرأه علينا أبو عثمان سعيد بن سلمة من كتابه سنة 398 قال حدثنا أبو عمر أحمد بن خالد التاجر قال حدثنا أبو قتيبة سلم بن الفضل مؤلفه رحمه الله(@)(@@)(@@)(@@) | 676 - (@)(@@) كتاب فضائل بقي بن مخلد رحمه الله وتسمية رجاله(@)(@@) حدثني به شيخنا الفقيه أبو القاسم أحمد بن محمد بن أحمد بن مخلد بن عبد الرحمن ابن أحمد بن بقي بن مخلد بن يزيد رحمه الله قراءة مني عليه قال حدثني به أبي محمد ابن أحمد عن أبيه أحمد وعمه أبي الحسن عبد الرحمن ابني مخلد عن أبيهما مخلد عن أبيه عبد الرحمن بن أحمد بن 
ms249	 بقي جامعها رحمه الله(@)(@@)(@@)(@@) | 677 - (@)(@@) كتاب مكارم الأخلاق لعبد الملك بن حبيب(@)(@@) حدثني به أبو محمد بن عتاب عن أبيه رحمهما الله عن أبي عبد الله محمد بن سعيد ابن نبات قال حدثنا أبو الحسن علي بن معاذ عن سعيد بن فحلون عن المغامي عن ابن حبيب(@)(@@)(@@)(@@) | 678 - (@)(@@) كتاب النفخ في الصور وذكر الحساب وصفة الجنة لزهير بن عباد جزءان(@)(@@) حدثني به أو محمد بن عتاب عن أبيه عن أبي بكر عبد الرحمن بن(@)(@@) PageV00P000(@)(@@) أحمد التجيبي قال حدثنا أبو جعفر التميمي قال حدثنا أبي عن سليمان بن سلام الغساني قال حدثنا زهير بن عباد قال أبو جعفر التميمي وحدثنا الفقيه أبو الغصن نفيس السوسي الغرابيلي بمدينة سوسة المرابط في رمضان سنة 306 قال حدثنا محمد بن رزيق عن زهير بن عباد مؤلفه(@)(@@)(@@)(@@) | 679 - (@)(@@) كتاب آداب الإسلام للفريابي(@)(@@) حدثني به أبو محمد بن عتاب رحمه الله عن أبيه عن أبي أيوب سليمان بن خلف ابن غمرون قال حدثنا محمد بن معاوية القرشي قال حدثنا أبو بكر جعفر بن محمد الفريابي مؤلفه رحمه الله(@)(@@)(@@)(@@) | 680 - (@)(@@) كتاب قصص الأنبياء لأحمد بن خالد(@)(@@) حدثني به أبو محمد بن عتاب عن أبيه رحمهما الله عن القاضي أبي الوليد يونس ابن عبد الله بن مغيث رحمه الله قال حدثنا أبو بكر محمد بن أحمد بن خالد عن أبيه مؤلفه رحمه الله(@)(@@)(@@)(@@) | 681 - (@)(@@) كتاب مواعظ الأنبياء لأبي عبيد(@)(@@) حدثني بها أبو محمد عن أبيه رحمهما الله قال حدثنا به أبو القاسم خلف بن يحيى قال حدثنا عبد الرحمن بن عيسى قال حدثنا ابن الأعرابي قال حدثنا علي بن عبد العزيز عن أبي عبيد مؤلفه(@)(@@)(@@)(@@) | 682 - (@)(@@) فضائل أبي بكر وعمر وعثمان وعلي وغيرهم من الصحابة رضي الله عنهم تأليف أبي عثمان سعيد بن محمد بن حرب(@)(@@) حدثني به أبو محمد بن عتاب عن أبيه رحمه الله عن أبي عثمان سعيد بن سلمة قال حدثنا أبو الحسن الأنطاكي المقرئ قال حدثنا أبو عثمان مؤلفه رحمه الله(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 683 - (@)(@@) حكمة وهب 
ms250	 بن منبه رحمة الله أربعة أجزاء(@)(@@) حدثني بها أبو محمد بن عتاب رحمه الله قال حدثني بها أبي رحمه الله قال قرأت على أبي القاسم خلف بن يحيى قال حدثنا أبو بكر محمد بن أحمد بن خالد عن أبيه أحمد بن خالد قال حدثنا أبو محمد عبيد الله بن محمد الكشوري قال حدثنا أبو قدامة همام بن مسلمة بن عقبة بن همام قال حدثنا غوث بن جابر بن غيلان بهذه الحكمة قرأها علينا من أولها إلى آخرها وأخبرنا أنه عرضها عل عقيل بن معقل فاخبره عقيل أنه عرضها على وهب بن منبه رحمه الله(@)(@@)(@@)(@@) | 684 - (@)(@@) حكمة لقمان(@)(@@) حدثني بها أبو محمد بن عتاب رحمه الله قال حدثني بها أبي رحمه الله عن أبي عثمان سعيد بن سلمة عن القاضي أبي عبد الله محمد بن أحمد بن يحيى بن مفرج قال حدثنا عبد العزيز بن أبي رافع بمصر قال حدثنا أبو الحسن محمد بن أحمد بن البراء قال حدثنا عبد المنعم بن إدريس عن وهب بن منبه رحمه الله(@)(@@)(@@)(@@) | 685 - (@)(@@) موعظة لداود بن جهور الفارسي تشتمل على منثور ومنظوم من الوعظ والحكم فإن قرأت المنظوم استغنيت به عن المنثور وإن قرأت المنثور استغنيت به عن المنظوم فإذا قرأت هذه الحكاية بمنثورها ومنظومها كأنه لا يستغني بعضها عن بعض(@)(@@) حدثني بها الشيخ أبو محمد بن عتاب رحمهما الله قال علي عبد الرحمن بن أحمد وقرأها علينا قال حدثنا أبو عيسى يحيى بن عبد الله بن أبي عيسى قرئ عليه وأنا أسمع في داره قال حدثنا صاحبنا أحمد بن محمد بن عبادل قال حدثنا أبو بكر محمد بن أبي مسهد النجاد بمدينة فلسطين قال كان بأتاوى وهي مدينة بإزاء عنبر رجل من أبناء فارس شاعر حكيم ومما يؤثر عنه هذه الموعظة وفيها بيت وهو من // الطويل //(@)(@@) (فتلك مغانيهم وهذي قبورهم ... تعاورها إعصارها وحريقها)(@)(@@) قال أبو عبد الله محمد بن عتاب أخبرني القاضي يونس بن عبد الله قال لقي رجل أبا وهب الرجل الصالح 
ms251	 في المقبرة المنسوبة إلى ابن عباس فقال له أبا وهب عظني(@)(@@) PageV00P000(@)(@@) فقال هذه دورهم وأشار إلى دار بها وهذه قبورهم فلا أدري إن كان أبو وهب أخذ من هذا البيت أو حكمة جرت على لسانه(@)(@@) - وموعظة أخرى كبيرة تشبهها(@)(@@) حدثني بها شيخنا أبو محمد بن عتاب رحمه الله قال حدثني أبي رحمه الله بها قال كتبت بها إلى أبي عمرو معوذ بن داود التاكرني الشيخ الصالح رحمه الله فكتب إلى يخبرني بها قال حدثنا أبو سلمة بن أحمد بن سليمان قال حدثنا أبو بكر سيد بن أبي مهدي بهذه الموعظة عن نفسه(@)(@@) قال أبو عبد الله محمد بن عتاب نهضت يوما إلى أبي عثمان سعيد بن سلمة لأقرأ عليه حزبي من القرآن إذ كان يقرئ فوجدته في الجامع في البلاط لاأوسط وهو يكتب عن رجل عليه سيماء النساك فلما سلمت وجلست أسلم إلي الكتاب وقال لي دمصة واقرأه يكون لك ولنا رواية وذلك في شهر رمضان من سنة ثمان وتسعين فكتبت وقرأته عليه عن أبي عمرو معوذ بن داود التاكرتي أنه قال لي وصيته أنه قال أقبل على آخرتك وحسن خلقك واستر ذنبك إلى آخر الوصية ووصيه أخرى أولها أقبل على آخرتك التي إليها مصيرك وتوجه نحو سفرك إلى آخرها(@)(@@) وهذا الرجل الذي كتبتها عنه كان اسمه محمد بن مخاوف الفارسي وأحسبه كان قدم لشهود رمضان في الجامع ثم لم أره بعد ذلك ثم كتبت إلى أبي عمرو معوذ في الإجازة فكتب إلى بها رحمه الله(@)(@@)(@@)(@@) | 686 - (@)(@@) موعظة لوهب بن منبه(@)(@@) حدثني بها أبو محمد بن عتاب بن محسن قال حدثنا أبو القاسم حاتم بن محمد الطرابلسي قال حدثنا أبو عمر أحمد بن عبد الله الطلمنكي المقرئ قال حدثني أبو جعفر أحمد بن عون الله قال حدثني أبو علي عبد الواحد بن أحمد بن أبي الخطيب التننسي قال حدثنا أحمد بن عيسى بن محمد الوشاء قال حدثنا هارون بن داود بن أبي طببة قال حدثنا الحسن بن علي الكوفي قال 
ms252	 حدثنا عبد الواحد بن حبيب عن أبي إلياس عن وهب بن منبه اليماني قال فيما أنزله الله تعالى على خليله إبراهيم عليه السلام(@)(@@)(@@)(@@) | 687 - (@)(@@) كتاب روضة الحقائق للخلال(@)(@@) حدثني بها القاضي أبو بكر بن العربي رحمه الله قال حدثنا أبو الحسين المبارك بن عبد الجبار الصيرفي عن الخلال مؤلفه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 688 - (@)(@@) كتاب من صبر ظفر تأليف أبي بكر الغازي المطوعي رحمه الله(@)(@@) حدثني به الشيخ أبو بحر سفيان بن العاصي الأسدي إجازة فيما كتب به إلي قال حدثني به الشيخ أبو عبد الله محمد بن سعدون بن علي القروي رحمه الله قال حدثني به أبو بكر مؤلفة رحمه الله سماعا عليه(@)(@@)(@@)(@@) | 689 - (@)(@@) كتاب زبور عليه السلام ترجمة وهب بن منبه(@)(@@) حدثني به الشيخ الفقيه المشاور أبو الحسن يونس بن محمد مغيث رحمه الله مناولة منه لي في أصل كتابه قال حدثني به جدي مغيث بن محمد بن يونس عن جده القاضي أبي الوليد يونس بن عبد الله بن مغيث عن أبي محمد عبد الله نصر قراءة منه عليه في سنة 360 وحدثني به عن شيوخه رحمهم الله(@)(@@) وحدثني به أيضا الفقيه أبو الحسين عبد الملك بن محمد بن هشام الشلبي رحمه الله مشافهة وإذنا عن الشيخ أبي القاسم خلف بن محمد بن عبد الله بن صواب اللخمي عن المقرىء أبي عبد الله الطرقي عن أبي الوليد بن الصفار القاضي عن عبد الله بن نصر الزاهد عن شيوخه رحمهم الله(@)(@@)(@@)(@@) | 690 - (@)(@@) كتاب المقالات في المقامات(@)(@@)(@@)(@@) | 691 - (@)(@@) وكتاب أخبار الشبلي(@)(@@)(@@)(@@) | 692 - (@)(@@) وكتاب الشيب والشيب(@)(@@)(@@)(@@) | 693 - (@)(@@) وكتابان فيهما كل من وقف بالناس بعرفات من سنة تسع من الهجرة إلى سنة 435 وكل ذلك من تأليف أبي بحر الغازي المطوعي(@)(@@) حدثني بذلك كله الشيخ أبو بحر سفيان بن العاصي الأسدي عن أبي عبد الله بن سعدون قال سمعتها على مؤلفها أبي بكر رحمه الله بقراءته علينا في المسجد الحرام مع كتاب من صب ظفر المتقدم الذكر(@)(@@)(@@)(@@) | 694 - (@)(@@) كتاب طبقات الصوفية لأبي عبد الرحمن السلمي(@)(@@) حدثني 
ms253	 به أبو بحر سفيان بن العاصي الأسدي رحمه الله عن أبي عبد الله محمد ابن سعدون القروي عن أبي بكر الغازي المطوعي سماعا عليه عن أبي عبد الرحمن السلمي مؤلفه رحمه الله(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 695 - (@)(@@) كتاب الأنوار وبهجة الأسرار في أخبار الصالحين لابن جهضم أربعون جزءا(@)(@@) حدثني به أبو بحر سفيان بن العاصي الأسدي عن أبي عبد الله محمد بن سعدون قال حدثنا به أبو الحسن علي بن بندار عن مؤلفه(@)(@@)(@@)(@@) | 696 - (@)(@@) كتاب الحكاية في عشرة أجزاء تأليف أبي بكر محمد بن أحمد بن اللباد(@)(@@) حدثني به أبو بحر سفيان بن العاصي الأسدي عن أبي عبد الله بن سعدون القروي قال حدثنا بها أبو بكر محمد بن محمد بن الناظور عن أبيه عن ابن اللباد مؤلفها رحمه الله(@)(@@)(@@)(@@) | 697 - (@)(@@) رسالة الذكر والدعاء مما فيه للسائل مكتفي تأليف أبي الحسن القابسي(@)(@@)(@@)(@@) | 698 - (@)(@@) وكتاب رتب العلم له(@)(@@)(@@)(@@) | 699 - (@)(@@) وكتاب مناسك الحج له(@)(@@)(@@)(@@) | 700 - (@)(@@) ورسالة في حسن الظن بالله تعالى له(@)(@@)(@@)(@@) | 702 - (@)(@@) ورسالة في الاعتقادات سماها النافعة(@)(@@)(@@)(@@) | 701 - (@)(@@) ورسالة أخرى له الناصرة(@)(@@) حدثني بذلك كله أبو بحر سفيان بن العاصي رحمه الله عن أبي عبد الله محمد بن سعدون القروي قال حدثني بذلك كله أبو بكر أحمد بن محمد بن يحيى القرشي عنه(@)(@@) وحدثني بها أيضا شيخنا أبو محمد بن عتاب رحمه الله إجازة عن أبي القاسم حاتم بن محمد الطرابلسي عن أبي الحسن علي بن أبي بكر محمد بن خلف القابسي الفقيه(@)(@@)(@@)(@@) | 703 - (@)(@@) كتاب الرسالة إلى الصوفية بأفق الإسلام(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 704 - (@)(@@) وكتاب التحبير في علم التذكير تأليف القشيري رحمه الله(@)(@@) حدثني به القاضي أبو بكر بن العربي رحمه الله قال حدثنا الشيخ أبو الفضائل محمد بن أحمد بن عبد الباقي بن طوق بهما عن مؤلفهما أبي القاسم عبد الكريم بن هوازن القشيري رحمه الله(@)(@@)(@@)(@@) | 705 - (@)(@@) كتاب أدب الدين والدنيا للماوردي(@)(@@) حدثنا به القاضي أبو بكر محمد بن عبد الله بن العربي شيخنا رحمه الله قال أخبرني به أبو بكر بن طرخان قال حدثنا الأديب أبو 
ms254	 الفوارس شجاع بن فارس بن الحسن الذهلي عن القاضي أبي الحسن بن محمد بن حبيب الماوردي البصري مؤلفه رحمه الله(@)(@@)(@@)(@@) | 706 - (@)(@@) كتاب العروس في الزهد تأليف أبي بكر أحمد بن محمد بن الفضل الأهوازي(@)(@@) حدثني به شيخنا الخطيب أبو الحسن شريح بن محمد بن شريح المقرئ رحمه الله عن خاله الراوية أبي عبد الله أحمد بن محمد الخولاني قال حدثنا به أبو عمر أحمد بن محمد المقرئ الطلمنكي قال حدثنا به أبو محمد عبد الله بن قاسم القلعي قال حدثنا محمد بن عبد الله بن محمد البصري بالبصرة مناولة قال حدثنا أبو الحسين أحمد بن الفضل إمام مسجد الجامع بالأهواز قال حدثنا أبو بكر أحمد بن محمد بن الفضل الأهوازي النحوي مؤلفه رحمه الله(@)(@@)(@@)(@@) | 707 - (@)(@@) كتاب مناقب سحنون بن سعيد وسيرته وأدبه من تأليف أبي العرب محمد بن أحمد بن تميم(@)(@@) حدثني به شيخنا أبو القاسم أحمد بن محمد بن بقي رحمه الله عن الفقيه أبي عبد الله(@)(@@) PageV00P000(@)(@@) محمد بن فرج عن القاضي أبي الوليد يونس بن محمد بن مغيث عن أبي جعفر تميم بن محمد ابن أحمد بن تميم عن أبيه أبي العرب محمد بن أحمد بن تميم مؤلفه رحمه الله(@)(@@)(@@)(@@) | 708 - (@)(@@) رسالة مالك بن أنس رضي الله عنه إلى هارون الرشيد(@)(@@) حدثني بها الشيخ المحدث أبو الحسن عباد بن سرحان المعافري رحمه الله قراءة عليه وأنا أسمع قال قرأت على الشيخ الجليل الثقة أبي الحسن علي بن الحسين بن علي بن أيوب قال حدثنا أبو بكر محمد بن عمر بن بكير بن ود بن وداد المقرئ قراءة عليه قال حدثنا أبو بكر أحمد بن جعفر بن محمد بن سلم الختلي قراءة عليه وأنا أسمع قال حدثنا أبو مسلم إبراهيم بن عبد الله الكجي البصري قال حدثنا عمرو بن محمد العثماني قاضي مكة قال حدثنا عبد الله بن نافع الزبيدي قال حدثنا أبو بكر عبد العزيز بن عبد الله بن عمر بن الخطاب عن مالك بن أنس رضي الله 
ms255	 عنه أنه كتب بهذه الرسالة إلى أمير المؤمنين هارون الرشيد رضي الله عنه(@)(@@) وحدثني بها أيضا أبو محمد بن عتاب رحمه الله إجازة قال حدثنا أبو عمر بن عبد البر النمري الحافظ إجازة قال حدثنا أبو القاسم خلف بن القاسم الحافظ قراءة عليه قال حدثنا أبو علي الحسن بن علي القطربلي عن أبي مسلم الكشي عن عمر بن محمد العثماني عن عبد الله بن نافع عن عبد العزيز بن عبد الله بن عمر عن مالك بن أنس رضي الله عنه(@)(@@) قال أبو محمد بن عتاب وحدثني بها أيضا أبو القاسم حاتم بن محمد الطرابلسي عن أبي عمر أحمد بن محمد المقرئ الطلمنكي عن أبي جعفر أحمد بن عون الله وأبي عبد الله محمد بن أحمد بن يحيى بن مفرج القاضي قالا حدثنا أبو عمر عبد الله بن أحمد بن ديزويه الدمشقي قال حدثنا أبو جعفر محمد بن عبد الحميد الفرغاني بدمشق قال حدثنا عثمان بن محمد بن عبد الله بن سعيد بن المغيرة بن عون بن عثمان بن عفان قال حدثنا عبد الله بن نافع الزبيدي قال هذا كتاب وضعه مالك بن أنس رضي الله عنه أدبا للناس(@)(@@)(@@)(@@) | 709 - (@)(@@) رسالة مالك بن أنس إلى الليث بن سعد وجواب الليث بن سعد له(@)(@@) حدثني بها أبو محمد بن عتاب رحمه الله قال حدثنا أبو القاسم حاتم بن محمد الطرابلسي قال حدثنا أبو عمر أحمد بن محمد المقرئ الطلمنكي قال حدثنا أبو جعفر أحمد بن عون الله بن حدير عن أبي سعيد بن الأعرابي عن عباس بن محمد الدوري عن أبي صالح عبد الله بن صالح كاتب الليث بن سعد(@)(@@)(@@)(@@) | 710 - (@)(@@) كتاب الحسن بن أبي الحسن البصري إلى بعض إخوانه يرغبه في المقام بمكة حرسها الله تعالى(@)(@@) حدثني بها أبو بكر محمد بن أحمد بن طاهر رحمه الله عن أبي علي الغساني عن(@)(@@) PageV00P000(@)(@@) أبي العاصي حكم بن محمد الجذامي قال حدثنا عبدوس بن محمد قال حدثنا أبو بكر محمد بن إبراهيم البصري 
ms256	 بمكة قال حدثنا أبو علي الحسين بن أحمد بن حوذان الفرقدي بالبصرة قال حدثنا جعفر بن الحسين بن زياد بمكة يوم التروية قال حدثنا أبو الوليد صالح بن سعيد التيمي قال حدثنا عبد الله بن عبد الحميد الحنفي قال حدثنا أبو عبيدة الناجي قال كتب الحسن بن أبي الحسن إلى رجل من الزهاد فذكرها(@)(@@)(@@)(@@) | 711 - (@)(@@) رسالة أسد بن موسى إلى أسد بن الفرات في لزوم السنة والتحذير من البدع(@)(@@) حدثني بها أبو محمد بن عتاب عن أبيه رحمهما الله قال سمعتها على أبي القاسم خلف بن يحيى قال حدثنا أبو عمر أحمد بن مطرف قال حدثنا أبو عثمان الأعناقي قال حدثنا محمد بن وضاح قال حدثنا غير واحد عن أسد(@)(@@) قال أبو عبد الله محمد بن عتاب وأخبرني بها القاضي أبو الوليد يونس بن عبد الله بن إسماعيل بن بدر عن أبي وضاح على ما تقدم(@)(@@)(@@)(@@) | 712 - (@)(@@) رسالة الفقيه أبي بكر محمد الطرطوشي رحمه الله إلى ابن تاشفين(@)(@@) حدثني بها القاضي أبو بكر محمد بن العزيز رحمه الله قراءة عيه وأنا أسمع غير مرة قال أخبرني بها أبو بكر الطرطوشي رحمه الله(@)(@@)(@@)(@@) | 713 - (@)(@@) جزء فيه منتخب من عيون خصائص العباد(@)(@@)(@@)(@@) | 714 - (@)(@@) وثلاثة أجزاء فيها الكلام عن الغنى والفقر تولى جمعها الفقيه أبو بكر الطرطوشي رحمه الله(@)(@@) حدثني بها القاضي أبو بكر بن العربي رحمه الله(@)(@@)(@@)(@@) | 715 - (@)(@@) كتاب الزهد لإبراهيم بن آدهم جزءان من تأليف محمد بن الحسن بن قتيبة(@)(@@) حدثني بها أبو محمد بن عتاب رحمه الله عن أبي عمر بن عبد البر النمري الحافظ عن خلف بن قاسم الحافظ عن أبي علي عبد الواحد بن أحمد بن محمد بن الخصيب عن محمد بن الحسن بن قتيبة العسقلاني مؤلفه رحمه الله(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 267 - - (@)(@@) حديث الزهاد الثمانية الذين انتهى إليهم الزهد(@)(@@) حدثني به أبو بكر محمد بن أحمد بن طاهر عن أبي علي الغساني قال حدثنا به حكم بن محمد الجذامي قال حدثنا أبو القاسم عبيد الله بن محمد بن محمد بن 
ms257	 خلف بن سهل البزار قال حدثنا أبو الحسن محمد بن محمد بن النفاح الباهلي قال حدثنا أبو شعيب صالح بن زياد المقرىء سنة 248 قال حدثنا أبو زكرياء يحيى بن سعيد العطار الحمصي قال حدثنا يزيد بن عطاء عن علقمة بن مرثد قال انتهى الزهد إلى ثمانية من التابعين رضي الله عنهم(@)(@@)(@@)(@@) | 717 - (@)(@@) كتاب الإستقامة لخشيش بن أصرم في الرد على أهل الأهواء والبدع(@)(@@) حدثني به أبو محمد بن عتاب رحمه الله قال حدثنا أبو حفص عمر بن عبيد الله الزهراوي وكتب لي الإسناد بخطه قال قرأت على أبي القاسم مسلمة بن سعيد الأستجي حدثكم أبو الحسن بن رشيق قال حدثنا أبو الفضل العباس بن محمد قال حدثنا أبوعاصم خشيش بن أصرم رحمه الله(@)(@@)(@@)(@@) | 718 - (@)(@@) كتاب البر والصلة(@)(@@) حدثني به أبو محمد بن عتاب رحمه الله عن أبي القاسم حاتم بن محمد الطرابلسي عن أبي الحسن أحمد بن فراس المكي عن محمد بن إبراهيم الديبلي عن الحسين بن الحسن المروزي مؤلفة رحمه الله(@)(@@)(@@)(@@) | 719 - (@)(@@) كتاب ما روي في الحوض والكوثر جمع بقي بن مخلد رحمه الله(@)(@@) حدثني به أبو محمد بن عتاب رحمه الله قال حدثنا به أبي رحمه الله سماعا عليه قال قرأته على أبي عثمان سعيد بن سلمة حدثكم أبو الحسن عبد الرحمن بن أحمد ابن بقي بن مخلد عن أبيه عن جده مؤلفه رضي الله عنه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 720 - (@)(@@) كتاب فيه ذكر الآذان بالليل ووقت السحور وقيام رمضان إملاء عبد الرحمن عيسى بن مدراج(@)(@@) حدثني به أبو محمد بن عتاب رحمه الله عن أبيه قال قرأته على أبي القاسم خلف بن يحيى قال حدثنا ابن مدراج مؤلفه رحمه الله(@)(@@)(@@)(@@) | 721 - (@)(@@) كتاب المحن لأبي العرب محمد بن تميم(@)(@@) حدثني به أبو محمد بن عتاب عن أبيه رحمه الله قال قرأته على أبي القاسم خلف بن يحيى قال حدثنا أبو جعفر تميم بن محمد بن تميم عن أبيه مؤلفه رحمه الله(@)(@@)(@@)(@@) | 722 - (@)(@@) كتاب محنة أحمد بن حنبل رحمه الله(@)(@@) حدثني به 
ms258	 أبو محمد بن عتاب رحمه الله قال حدثني به أبي رحمه الله قال حدثنا أبو القاسم خلف بن يحيى قال حدثنا عبد الرحمن بن عيسى قال حدثنا محمد بن قاسم قال حدثنا أبو القاسم عبد الله بن محمد الوراق قال حدثنا أبو علي حنبل بن إسحاق بن حنبل ابنعم أحمد بن حنبل قال حنبل سمعت أحمد بن وذكر المحنة فقال رأيت قبل المحنة في المنام علي بن عاصم فأولتها علي علو وعاصم عصمة من الله فالحمد لله على ذلك إلى آخر الكتاب(@)(@@)(@@)(@@) | 723 - (@)(@@) كتاب محنة الشافعي رحمه الله(@)(@@) حدثني به القاضي أبو بكر بن العربي رحمه الله قال حدثنا أبو الحسين بن الطيوري قال حدثنا أبو عبد الله محمد بن علي بن الحسين بن سكينة الأنماطي قال حدثنا أبو القاسم بكر بن شاذان الواعظ قال حدثنا أبو محمد جعفر بن أحمد بن نصر قال حدثنا أبو بكر محمد بن الحسن بن بكر الشيباني قال حدثنا محمد بن إسماعيل بن الجبان الحميدي عن أبيه قال كان الشافعي قد ذكرها(@)(@@) قال أبو بكر بن العربي وأخبرني بها أيضا الشيخ الحافظ الأمين أبو محمد هبة الله بن أحمد الدمشقي إجازة عن ابن سكينة الشيخ الصالح(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 724 - (@)(@@) كتاب الزهد وما يجب على المتناظرين من حسن الأدب تصنيف محمد بن سحنون(@)(@@)(@@)(@@) | 725 - (@)(@@) وكتاب آداب المتعلمين من ديوان محمد بن سحنون أيضا(@)(@@) حدثني بها الشيخ أبو محمد بن عتاب عن أبيه رحمهما الله عن أبي القاسم خلف ابن يحيى عن أبي جعفر تمام بن محمد التميمي قال حدثنا محمد بن أحمد بن خالد قال حدثنا محمد بن سحنون رحمه الله(@)(@@)(@@)(@@) | 726 - (@)(@@) كتاب آداب القارئ والمقرىء والعالم والمتعلم تأليف أبي بكر الأدفوي المقرئ رحمه الله(@)(@@) حدثني به أبو محمد بن عتاب عن أبيه رحمهما الله قال قرأت على أبي سعيد الجعفري حدثني به عنه قال أبو محمد بن عتاب رحمه الله وأخبرني به أبو محمد مكي ابن أبي طالب المقرئ رحمه الله إجازة عن أبي بكر الأدفوي 
ms259	 مؤلفة رحمه الله(@)(@@)(@@)(@@) | 727 - (@)(@@) كتاب الغريب المنتقى من كلام أهل التقى تأليف الشيخ الزاهد أبي عبد الله محمد بن سعيد بن خميس اليابري رحمه الله(@)(@@) حدثني به القاضي أبو الفضل عياض بن موسى بن عياض اليحصبي رحمه الله إذنا قال سمعت بعضه من لفظ مؤلفه أبي عبد الله محمد بن خميس المذكور رحمه الله(@)(@@)(@@)(@@) | 728 - (@)(@@) كتب اعتلال القلوب للخرائطي(@)(@@) حدثني به الشيخ الفاضل أبو عبد الله محمد بن عبد الرحمن بن معمر رحمه الله عن الوزير أبي بكر محمد بن هشام المصحفي عن أبيه رحمه الله عن أبي الوليد عبد الله بن محمد بن يوسف بن الفرضي قال أخبرني به أبو علي الحسين بن علي بن محمد بن دحيم الحلبي عن الخرائطي مؤلفه رحمه الله(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 729 - (@)(@@) كتاب فضل العلم والعلماء تأليف أبي الفضل يوسف بن مسرور العابد بالمستنير(@)(@@) حدثني به أبو محمد بن عتاب رحمه الله عن أبيه سماعا عليه قال قرأته على أبيالقاسم خلف بن يحيى وأبي عثمان سعيد بن سلمة قالا حدثنا محمد بن أحمد بن الحزاز قال حدثنا ابن مسرور مؤلفه(@)(@@)(@@)(@@) | 730 - (@)(@@) كتاب رغائب العلم وفضله لابن مزين(@)(@@) حدثني به أبو محمد بن عتاب عن أبيه عن أبي عثمان سعيد بن رشيق عن الراوية أبي محمد الباجي قال حدثنا سليمان بن عبد السلام قال حدثنا ابن مزين مؤلفه رحمه الله(@)(@@)(@@)(@@) | 731 - (@)(@@) كتاب فضل عاشوراء لأبي ذر عبد بن أحمد الهروي رحمه الله(@)(@@) حدثني به أبو محمد بن عتاب رحمه الله قال قرأته على أبي القاسم حاتم بن محمد الطرابلسي وحدثني به عن أبي ذر عبد بن أحمد الهروي مؤلفه رحمه الله(@)(@@)(@@)(@@) | 732 - (@)(@@) كتاب رياض الأنس في ميدان القدس في الوعظ والتذكير تصنيف أبي سعيد الحسن بن علي المطوعي الواعظ رحمه الله(@)(@@)(@@)(@@) | 733 - (@)(@@) كتاب الشفاعة لإسماعيل القاضي(@)(@@) حدثني به أبو بكر محمد بن أحمد بن طاهر رحمه الله عن أبي علي الغساني قال حدثني به أبو مروان عبد الملك بن زياد الطبني قراءة منه علي قال حدثنا أبو 
ms260	 الحسن علي بن محمد بن بقي الوراق قال حدثنا أبو أحمد عمر بن محمد بن عمر بن محمد بن موسى الترمذي قال حدثنا أبو القاسم إسماعيل بن يعقوب البغداذي المعروف بابن الجراب عن إسماعيل القاضي مؤلفه رحمه الله(@)(@@)(@@)(@@) | 734 - (@)(@@) جزء فيه حديث أبي حازم بن عبد الملك رحمه الله(@)(@@) حدثني به أبو محمد بن عتاب رحمه الله عن أبيه عن أبي المطرف القنازعي عن أبي محمد عبد الله بن محمد بن عثمان قال حدثنا أبو الحسن طاهر بن عبد العزيز قال(@)(@@) PageV00P000(@)(@@) حدثنا أبو بكر الخلال قال أملي علينا أبو سلمة يحيى بن المغيرة المخزومي قال حدثنا عبد الجبار بن عبد العزيز بن أبي حازم قال حدثني أبي عن جدي أبي حازم رحمه الله وعندي هو بخط القنازعي رحمه الله(@)(@@)(@@)(@@) | 735 - (@)(@@) كتاب الصلاة على النبي صلى الله عليه وسلم لإسماعيل القاضي(@)(@@) حدثني به أبو بكر محمد بن أحمد بن طاهر رحمه الله عن أبي علي الغساني قال حدثني به أبو العاصي حكم بن محمد عن أبي محمد بن النحاس عن أبي القاسم إسماعيل بن يعقوب البغداذي عن إسماعيل القاضي رحمه الله(@)(@@)(@@)(@@) | 736 - (@)(@@) جزء فيه من كلام يحيى بن معاذ الرازي وغيره من أقرانه في الزهد رضي الله عنهم(@)(@@) انتقيته من كلامهم نفع الله به لعزته(@)(@@) PageV00P000(@)(@@)(@@)(@@) | بسم الله الرحمن الرحيم(@)(@@)(@@)(@@) | صلى الله على سيدنا ومولانا محمد وعلى آله وسلم(@)(@@)(@@)(@@) | ومن كتب الأنحاء واللغات والآداب والشروحات وأشعار العرب والمحدثين وما يتصل بذلك من نوعه(@)(@@)(@@)(@@) | 737 - (@)(@@) كتاب سيبويه أبي بشير عمرو بن عثمان بن قنبر رحمه الله(@)(@@) حدثني به رواية عنه قراءة عليه الشيخ الأديب الحسن أبو بكر محمد بن عبد الغني بن عمر بن فندلة رحمه الله قال حدثني به الشيخ الأستاذ أبو الحجاج بن سليمان بن عيسى النحوي الأعلم قال حدثني به الشيخ الوزير أبو القاسم إبراهيم بن محمد بن زكرياء ابن الإفليلي إجازة عن أبي عبد الله محمد بن عاصم العاصمي النحوي عن أبي عبد الله محمد بن يحيى الرباحي(@)(@@) قال 