ms361	 آر و پاک باش و علم جوی %~% فوج دیوان را بدین معروف لشکرها شکن(@)(@@) 41 گر دلت بر نیک همسایه ز حسد کینه گرفت %~% کینه‌ت از بد فعل جان خویش باید آختن(@)(@@) 42 ای منافق یا مسلمان باش یا کافر به دل %~% چونت باید با خداوند این دوالک باختن(@)(@@) 43 از دل همسایه گر می‌کند خواهی کین خویش %~% از دل خویش این زمانه کین همسایه بکن(@)(@@) 44 همچنان باشم تو را من چون تو باشی مر مرا %~% گر همی دیبات باید جز که ابریشم متن(@)(@@) 45 شعر حجت را بخوان ای هوشیار و یاد گیر %~% شعر او در دل تو را شهد است و اندر لب لبن PageV1P186(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 در دلم تا به سحرگاه شب دوشین %~% هیچ نارامید این خاطر روشن بین(@)(@@) 2 گفت: بنگر که چرا می‌نگرد گردون %~% به دو صد چشم در این تیره زمین چندین(@)(@@) 3 خاک را قرصه خورشید همی درزد %~% روز تا شام به زر آب زده ژوپین(@)(@@) 4 وز گه شام بپوشد به سیه چادر %~% تا به هنگام سحر روی خود این مسکین(@)(@@) 5 روز رخشان سپس تیره شبان گوئی %~% آفرین است روان بر اثر نفرین(@)(@@) 6 خاک را شوی همین دوست که می‌زاید %~% شور و تلخ و خوب و زشت و ترش و شیرین(@)(@@) 7 گم ازین شد ره مانی که زیک گوهر %~% به یکی صانع ناید شکر و رخپین(@)(@@) 8 از دو شو نه زین بجه بچه برون ناید %~% این جنین ناید پورا و نه آن جنین(@)(@@) 9 میوه زین است یکی تلخ و دگر شیرین %~% خلق از این است یکی شاد و دگر غمگین(@)(@@) 10 طین اگر شوی نباشدش به روز و شب %~% کی پدید اید زیتون و نه تین از طین(@)(@@) 11 نه چو کافور شود کوه به بهمن ماه %~% نه شود دشت چو زنگار به فروردین(@)(@@) 12 کس ندیده است چنین طرفه زناشوئی %~% نه زنی هرگز زاده است 
ms362	 بدین آئین(@)(@@) 13 وین خردمند و سخن گوی بهشتی جان %~% از چه مانده است چنین بسته در این سجین(@)(@@) 14 زن جان است تن تیره‌ت با زندان %~% چند خسپی بنگر نیک و نکو بنشین(@)(@@) 15 عمر خود خواب جهان است چرا خسپی %~% بر سر خواب جهان خواب دگر مگزین(@)(@@) 16 بی‌گمان گردی اگر نیک بیندیشی %~% که بدل خفته است این خلق همه همگین(@)(@@) 17 گر کسی غسلین خورده است به مستی در %~% تو که هشیاری بر خیره مخور غسلین(@)(@@) 18 بلبل و هدهد و مرغند بلی لیکن %~% گل همی جوید یکی و یکی سرگین(@)(@@) 19 طبع تشرین به چه ماند به مه نیسان %~% گرچه در سال بود نیسان با تشرین(@)(@@) 20 از نبشته است نه ز اواز و نه از معنی %~% سوی هشیار دلان سیرین چو نسرین(@)(@@) 21 تا سحرگه ز بس اندیشه نجست از من %~% سر من جز که سر زانوی من بالین(@)(@@) 22 ای برادر به چنین راه درون مرکب %~% فکرتت باید و از عقل بدو بر زین(@)(@@) 23 جز بر این مرکب و زین زین چه زشت و ژرف %~% جان دانا نشود بر فلک پروین(@)(@@) 24 دهر تنین خورنده است بر این مرکب %~% بایدت جست به صد حیلت از این تنین(@)(@@) 25 ای پسر جان و تنت هر دو زناشوی‌اند %~% شوی جان است و زنش تنت و خرد کابین(@)(@@) 26 زین زن و شوی بدین کابین فرزندی %~% چه همی باید دانی که بزاید دین(@)(@@) 27 گر بترسی ز بلا بر تن خویش و جان %~% هر دو را باید کردنت ز دین پرچین(@)(@@) 28 کیمیای زر دین است بدو زر شو %~% کیمیا نیست چنین نیز به قسطنطین(@)(@@) 29 نرهد ز آتش نه سیم و نه مس جز زر %~% برهی زاتش دوزخ چو شدی زرین(@)(@@) 30 تن بیچاره‌ت از این شوی همی یابد %~% این همه زینت و آرایش و این تحسین(@)(@@) 31 جفت جان حورالعین هم اندر جان %~% زانش 
ms363	 برطاعت وعده است به حورالعین(@)(@@) 32 آنک ازو خاک سیه حورالعین گشته است %~% حور ازو یابد در خلد برین تزیین(@)(@@) 33 جان تو گوهر علم است چنینش ایزد %~% در تو می از قبل علم کند تسکین(@)(@@) 34 مر تو را دین محمد چو دبستان است %~% دین کند جان تو را زنده و علم آگین(@)(@@) 35 طلب علمت فرمود رسول حق %~% گر سفر باید کردن به مثل تا چین(@)(@@) 36 سوی چین دین من راه بیاموزم %~% مر تو را گر نکنی روی چنین پرچین(@)(@@) 37 آل یاسین مر چین را دومین چین است %~% تو به چین دومین شو نه بدان پیشین(@)(@@) 38 چین تو ظاهر و ماچین به مثل باطن %~% تو به چین بودی و مانده‌است تو را ماچین(@)(@@) 39 جانت خاک است و خرد تخم گل و لاله %~% خاک را تخم گل و لاله کند رنگین(@)(@@) 40 چون نمودم که تن و جانت زن و شوی‌اند %~% عمل و علم پدید آمده زان و زین(@)(@@) 41 گر همی آرزو آیدت عروسی نو %~% دین عروست بس و دل خانه و علم آئین(@)(@@) 42 راه ظاهر پسرا راه ستوران است %~% ناصبی از من ازین است جگر پر کین(@)(@@) 43 ز آل یاسین خبرش نی و به تقلیدش %~% بر سر سوره همی خواند یا و سین(@)(@@) 44 هان و هینش کنم از حکمت ازیرا خر %~% باز گردد ز ره کژ به هان و هین(@)(@@) 45 آب دریا را خورشید بجوشاند %~% تا برآردش سوی چرخ و شود نوشین(@)(@@) 46 پند میتین و دل نادان چون سنگ است %~% بر دل سنگین از پند سزد میتین(@)(@@) 47 جز که بر سخته نگویم سخنی زیرا %~% سخن حکمت زر است و خرد شاهین(@)(@@) 48 جز به تلقین نرهد بی‌خرد از تقلید %~% که چراغ است به تقلید درون تلقین(@)(@@) 49 هر که را آتش تقلید بجوشاند %~% مرد داناش به تاویل دهد تسکین(@)(@@) 50 ای پسر گفت در این شعر تو 
ms364	 را حجت %~% آنچه دل گفت مر او را به شب دوشین PageV1P187(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 چه گوئی ای شده زین گوی گردان پشت تو چوگان %~% به دست سالیان شسته زمان از موی تو قطران(@)(@@) 2 ز قول رفته و مانده چه بر خواندی و چه شنودی %~% چه گفتند این و آن هر دو چه چیز است این چه چیز است آن(@)(@@) 3 گر این نزدیک را گوئی و آن مر دور را گوئی %~% پس این نزدیک پیدا باشد و آن دورتر پنهان(@)(@@) 4 به دشواری توانی یافتن مر دور چیزی را %~% ولیکن زود شاید یافتن نزدیک را آسان(@)(@@) 5 چه چیز است این و پیدائی چه چیز است آن و پنهانی %~% چه گفته است اندرین تازی چه گفته است اندران دهقان(@)(@@) 6 تو را نزدیک و آسان است پیدا این جهان پورا %~% ز تو پنهان و دشوار است و دور است آن دگر گیهان(@)(@@) 7 تو پنهانی و پیدائی و دشواری و آسانی %~% تو را این است پیدا تن تو را آن است پنهان جان(@)(@@) 8 مگر کز بهر اندر یافتن دشوار و پنهان را %~% در این پیدا و آسان فضل دانا نیست بر نادان(@)(@@) 9 ز دانا نیست پنهان جان چنانک از چشم بینائی %~% ز نادان است پنهان جان چنان کز گوش کر الحان(@)(@@) 10 ز نابیناست پنهان رنگ و بانگ از کر پنهان است %~% همی بینند کران رنگ را و بانگ را عمیان(@)(@@) 11 ز بهر دیدن جانت همی چشمی دگر باید %~% که بی لون است چشم سر نبیند جز همه الوان(@)(@@) 12 ز پنهان آمد اینجا جان و پیدا شد زتن زان‌سان %~% که پنهان بر شود واندر هوا پیدا شود باران(@)(@@) 13 اگر حکمت بیاموزی تو تخمی چرخ گردان را %~% توی ظاهر توی باطن توی ساران توی پایان(@)(@@) 14 در این پیدا و نزدیکت ببین آن دور پنهان را %~% که بند از بهر اینت کرد یزدان اندر این 
ms365	 زندان(@)(@@) 15 چو پنهان را نمی‌بینی درو رغبت نمی‌داری %~% مرین را زین گرفته‌ستی به ده چنگال و سی دندان(@)(@@) 16 تو گریانی جهان خندان موافق کی شود با تو %~% جهان بر تو همی خندد چرائی تو برو گریان(@)(@@) 17 ز بهر آنکه بنمایندمان آن جای پنهانی %~% دمادم شش تن آمد سوی ما پیغمبر از یزدان(@)(@@) 18 به دل در چشم پنهان بین ازیشان آیدت پیدا %~% بدیشان ده دلت را تا به دل بینا شوی زیشان(@)(@@) 19 از این پنگان برون نور است و نعمت‌های جاویدی %~% همه تنگی و تاریکی است اندر زیر این پنگان(@)(@@) 20 تو را خلقان شد این جامه ز طاعت جامه‌ای نو کن %~% که عریان بایدت بودن چو بستانندت این خلقان(@)(@@) 21 در این ایوان بسی گشتی و خلقان شد تنت واخر %~% نبینم با تو چیزی من همی جز باد در انبان(@)(@@) 22 مثل هست این که: جامه تن زیان آید مران کس را %~% که سال و مه نباشد جز به خان این و آن مهمان(@)(@@) 23 تنت کز بهر طاعت بد به عصیانش بفرسودی %~% چه عذر آری اگر فردا بخواهند از تو این تاوان(@)(@@) 24 اگر گوئی «فلان کس داد و بهمان مر مرا رخصت» %~% بدان جا هم فلان بیزار گردد از تو هم بهمان(@)(@@) 25 چرا مر اهل عصیان را به عصیان هم‌رهی کردی %~% نرفتی یک قدم با اهل ایمان در ره ایمان(@)(@@) 26 به راه معصیت در گر ز میرانی و سرهنگان %~% به راه طاعت اندر چون ز کورانی و از کران(@)(@@) 27 اگر چون خر به خور مشغولی و طاعت نمی‌داری %~% قبا بفگن که در خور تر تو را از صد قبا پالان(@)(@@) 28 ز بهر آن کاوری طاعت که چون تو خر نکرده‌ستی %~% چرا کرد ایزد از بهر تو چرخ و انجم و ارکان(@)(@@) 29 اگر چه خر به نیسان شاد و سران و دنان باشد %~% ز بهر خر نمی‌گردد به نیسان 
