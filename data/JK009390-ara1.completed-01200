ms1195	 ، وتغل فيي الشياطين وينادي مناد كل ليلة : يا باغي الخير هلم ، ويا باغي الشر أقصر ) )(@)(@@) ( ن طب ) عن عتبة بن فرقد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10510 ) قال النبي :(@)(@@) | 30 ( تفتح فيه أبواب السماء ، وتغلق فيه أبواب النار ، ويصفد فيه كل شيطان مريد ، وينادي مناد في كل ليلة : يا طالب الخير هلم ، ويا طالب الشر أمسك ) )(@)(@@) ( ن ) عن عتبة بن فرقد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10511 ) قال النبي :(@)(@@) | 30 ( تفتح أبواب الجنة في أول ليلة من رمضان إلى آخر ليلة ، وتغل فيه مردة الشياطين ، ويبعث الله مناديا ينادي : يا باغي الخير هلم ، هل من داع فيستجاب له ، هل من مستغفر يغفر له ، هل من تائب يتاب عليه ، ولله عند PageV04P112 وقت الفطر في كل ليلة من رمضان عتقاء يعتقهم من النار ) )(@)(@@) ابن صصرى في أماليه وابن النجار عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 10512 ) قال النبي :(@)(@@) | 30 ( تفتح على الأرض فتن كصياصي البقر ، هاذا يومئذ على الحق يعني عثمان ) )(@)(@@) ( ك ) عن مرة البهزي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10513 ) قال النبي :(@)(@@) | 30 ( تفتح أبواب الجنة كل اثنين وخميس ، وتعرض الأعمال في كل اثنين وخميس ) )(@)(@@) ( حب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10514 ) قال النبي :(@)(@@) | 30 ( تفترق أمتي على ثلاث وسبعين فرقة كلهن في النار إلا واحدة ، ما أنا عليه اليوم وأصحابي ) )(@)(@@) ( طس ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10515 ) قال النبي :(@)(@@) | 30 ( تفترق هاذه الأمة على ثلاث وسبعين فرقة ) )(@)(@@) ابن النجار عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10516 ) قال النبي :(@)(@@) | 30 ( تفترق أمتي على بضع وسبعين فرقة ، أعظمها فتنة على أمتي قوم يقيسون الأمور برأيهم فيحلون الحرام ويحرمون الحلال ) )(@)(@@) ( طب ك ) عن عوف بن مالك رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10517 ) قال النبي :(@)(@@) | 30 ( تفتيك نفسك ، ضع يدك على صدرك فإنه يسكن للحلال ويضطرب من الحرام ، دع ما يريبك إلى ما لا يريبك وإن أفتاك المفتون ، إن المؤمن يذر الصغير مخافة أن يقع في الكبير ) )(@)(@@) الحكيم عن عثمان بن عطاء عن أبيه مرسلا .(@)(@@)(@@)(@@) $ ( 10518 ) قال النبي :(@)(@@) | 30 ( تفسحوا في سجودكم 
ms1196	 ولا تجعلوا ظهوركم كأحنية الدواب ) )(@)(@@) الديلمي عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10519 ) قال النبي :(@)(@@) | 30 ( تفضل صلاة الجماعة على الوحدة سبعة وعشرين PageV04P113 درجة ) )(@)(@@) ( حم ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10520 ) قال النبي :(@)(@@) | 30 ( تفضل صلاة الجماعة على صلاة الرجل وحده خمسا وعشرين صلاة ) )(@)(@@) البزار عن أنس وعن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10521 ) قال النبي :(@)(@@) | 30 ( تفكر ساعة خير من قيام ليلة ) )(@)(@@) صالح بن أحمد في كتاب التبصرة عن أنس رضي الله عنه مرفوعا أبو الشيخ في العظمة عن ابن عباس رضي الله عنهما موقوفا .(@)(@@)(@@)(@@) $ ( 10522 ) قال النبي :(@)(@@) | 30 ( تفكروا في خلق الله ولا تفكروا في الله ) )(@)(@@) ابن النجار والرافعي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10523 ) قال النبي :(@)(@@) | 30 ( تفترق أمتي على نيف وسبعين فرقة ، أضرها على أمتي قوم يقيسون الأمور برأيهم ، فيحلون الحرام ويحرمون الحلال ) )(@)(@@) ( كر ) عن عوف بن مالك رضي الله عنه .(@)(@@)(@@)(@@) ||| ( التاء مع القاف(@)(@@) م ن الجام ع الصغي ر وزوائ ده ) 3 $(@)(@@)(@@)(@@) $ ( 10524 ) قال النبي :(@)(@@) | 30 ( تقاتلون اليهود فتسلطون عليهم حتى تختبىء أحدهم وراء الحجر ، فيقول الحجر : يا عبد الله هاذا يهودي ورائي فاقتله ) )(@)(@@) ( ق ت ) عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 10525 ) قال النبي :(@)(@@) | 30 ( تقبلوا لي بست أتقبل لكم بالجنة : إذا حدث أحدكم فلا يكذب ، وإذا وعد فلا يخلف ، وإذا ائتمن فلا يخن ، عضوا أبصاركم ، وكفوا أيديكم ، واحفظوا فروجكم ) )(@)(@@) ( ك هب ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10526 ) قال النبي :(@)(@@) | 30 ( تقتل عمارا الفئة الباغية ) )(@)(@@) ( حم ) عن خزيمة بن ثابت PageV04P114 وعن عمرو بن العاص وعن ابنه وعن عمرو بن حزم ( م ) عن أم سلمة رضي الله عنهم ( ز ) .(@)(@@)(@@)(@@) $ ( 10527 ) قال النبي :(@)(@@) | 30 ( تقدموا فأتموا بي وليأتم بكم من بعدكم ، ولا يزال قوم يتأخرون حتى يؤخرهم الله ) )(@)(@@) ( حم م د ن ه ) عن أبي سعيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 10528 ) قال النبي :(@)(@@) | 30 ( تقربوا إلى الله ببغض أهل المعاصي ، والقوهم بوجوه مكفهرة ، والتمسوا رضا الله بسخطهم ، وتقربوا إلى الله بالتباعد منهم ) )(@)(@@) ( ابن شاهين 
ms1197	 في الأفراد ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10529 ) قال النبي :(@)(@@) | 30 ( تقطع اليد في ثمن المجن ) )(@)(@@) ( حم ه ) عن سعيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 10530 ) قال النبي :(@)(@@) | 30 ( تقطع يد السارق في ربع دينار فصاعدا ) )(@)(@@) ( خ د ن ) عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 10531 ) قال النبي :(@)(@@) | 30 ( تقعد الملائكة على أبواب المساجد يوم الجمعة فيكتبون الأول والثاني والثالث حتى إذا خرج الإمام رفعت الصحف ) )(@)(@@) ( حم ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10532 ) قال النبي :(@)(@@) | 30 ( تقول النار يوم القيامة للمؤمن : جز يا مؤمن فقد أطفأ نورك لهبي ) )(@)(@@) ( طب حل ) عن يعلى بن منية رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10533 ) قال النبي :(@)(@@) | 30 ( تقوم الساعة والروم أكثر الناس ) )(@)(@@) ( حم م ) عن PageV04P115 المستورد رضي الله عنه .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 10534 ) قال النبي :(@)(@@) | 30 ( تقاتلون جزيرة العرب فيفتحها الله ، ثم تقاتلون الروم فيفتحها الله ، ثم تقاتلون فارس فيفتحهم الله ، ثم تقاتلون الدجال فيفتحهم الله ) )(@)(@@) ( ش ه ك ) عن نافع بن عتبة بن أبي وقاص رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10535 ) قال النبي :(@)(@@) | 30 ( تقاس الجراحات ثم يستأنى بها سنة ثم يقضى بها بقدر ما انتهت إليه ) )(@)(@@) ( عد هق ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10536 ) قال النبي :(@)(@@) | 30 ( تقبل الرايات السود من المشرق ، يقودهم كالبخت المجللة أصحاب شعور ، أنسابهم القرى ، وأسماؤهم الكنى يفتتحون مدينة دمشق ، ترفع عنهم الرحمة ثلاث ساعات ) )(@)(@@) نعيم بن حماد في الفتن عن عمر وابن شعيب عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 10537 ) قال النبي :(@)(@@) | 30 ( تقبيل المسلم يد أخيه : المصافحة ) )(@)(@@) الديلمي عن الحسن بن علي رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 10538 ) قال النبي :(@)(@@) | 30 ( تقتلك الفئة الباغية . قاتلك في النار قاله لعمار ) )(@)(@@) ابن عساكر عن أم سلمة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 10539 ) قال النبي :(@)(@@) | 30 ( تقتلك الفئة الباغية ) )(@)(@@) ( ع ) و أبو عوانة ( طب ) عن أبي رافع عن أم سلمة بن سعد ( حم ض ) عن أبي سعيد ( طب ) والباوردي وابن قانع ( قط ) في الأفراد عن اليسر وزياد بن الفرد معا ( طب ) عن عمرو ( ع ) وابن غفلة في 
ms1198	 كتاب الموالاة ( طب هق ) في الأفراد عن عمار بن ياسر ، ابن عساكر عن PageV04P116 ابن عباس وعن حذيفة وعن أبي هريرة وعن جابر بن سمرة وعن جابر بن عبد الله وعن أبي أمامة رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 10540 ) قال النبي :(@)(@@) | 30 ( تقتلك الفئة الباغية ، وآخر زادك من الدنيا ضيح من لبن ) )(@)(@@) تمام وابن عساكر عن عبد الله بن كعب بن مالك عن أبيه ابن عساكر عن عمرو بن العاص رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10541 ) قال النبي :(@)(@@) | 30 ( تقتل عمارا الفئة الباغية عن الطريق ، وإن آخر رزقه ضياح من لبن ) )(@)(@@) الخطيب عن حذيفة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10542 ) قال النبي :(@)(@@) | 30 ( تقولون أو يقول قائلكم : الشحيح أغدر من الظالم ، وأي ظلم أظلم عند الله من الشح ، يحلف الله تعالى بعزته وعظمته وجلاله أن لا يدخل الجنة شحيح ولا بخيل ) )(@)(@@) الخطيب في كتاب البخلاء عن أبي الزاهرية عن أبي شجرة .(@)(@@)(@@)(@@) $ ( 10543 ) قال النبي :(@)(@@) | 30 ( تقدم إلى مصلاك لا يقطع الشيطان عليك صلاتك ) )(@)(@@) البغوي وابن قانع ( طب ) عن سهل بن الحنظلية رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10544 ) قال النبي :(@)(@@) | 30 ( تقدموا فأتموا بي وليأتم بكم من بعدكم ، ولا يزال قوم يتأخرون حتى يؤخرهم الله يوم القيامة ) )(@)(@@) ( ط حم ) و عبد بن حميد ( م د ن ه ) وابن خزيمة عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10545 ) قال النبي :(@)(@@) | 30 ( تقعد الملائكة يوم الجمعة على أبواب المساجد يكتبون الناس على منازلهم ، فالناس فيه كرجل قدم بدنة ، وكرجل قدم بقرة ، وكرجل قدم شاة ، وكرجل قدم دجاجة ، وكرجل قدم عصفورا ، وكرجل قدم PageV04P117 بيضة ) )(@)(@@) ( ن ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10546 ) قال النبي :(@)(@@) | 30 ( تقعد أيام أقرائها ثم تغتسل وتصلي عند طهرها ) )(@)(@@) ( ك ) عن فاطمة بنت قيس رضي الله عنها في المستحاضة .(@)(@@)(@@)(@@) $ ( 10547 ) قال النبي :(@)(@@) | 30 ( تقطع الآجال من شعبان إلى شعبان حتى إن الرجل لينكح ويولد له وقد خرج اسمه في الموتى ) )(@)(@@) ابن زنجويه عن سعيد بن المسيب عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10548 ) قال النبي :(@)(@@) | 30 ( تقوم الساعة يوم الجمعة 
ms1199	 وليس بهيمة إلا وهي رافعة رأسها يوم الجمععة تشفق من الساعة حتى يغيب الشفق ) )(@)(@@) الديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10549 ) قال النبي :(@)(@@) | 30 ( تقعد الملائكة على أبواب المسجد يوم الجمعة يكتبون مجيء الناس حتى يخرج الإمام ، فإذا خرج الإمام طويت الصحف ورفعت الأقلام ، فتقول الملائكة : اللهم إن كان مريضا فاشفه ، وإن كان ضالا فاهده ، وإن كان عائلا فأغنه ) )(@)(@@) ( هق ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10550 ) قال النبي :(@)(@@) | 30 ( تقع النطفة في الرحم أربعين ليلة ثم يتصور عليها الملك الذي يخلقها فيقول : يا رب أذكر أم أنثى فجعلها ذكرا أو أنثى ؟ فيقول : يا رب إسوي أم غير سوي ؟ فيجعله سويا أو غير سوي ، فيقول : يا رب أشقي أم سعيد ؟ فيجعله الله تعالى شقيا أو سعيدا ) )(@)(@@) ( طب ) عن حذيفة بن أسيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10551 ) قال النبي :(@)(@@) | 30 ( تقول الملائكة : يا رب عبدك المؤمن تزوي عنه الدنيا وتعرضه للبلاء وهو مؤمن بك ، فيقول : اكشفوا عن ثوابه ، فإذا رأوا ثوابه تقول الملائكة : يا رب ما يضره ما أصابه في الدنيا ، وتقول الملائكة : يا رب عبدك الكافر تبسط له في الدنيا وتزوي عنه البلاء وقد كفر بك ، فيقول : اكشفوا عن ثوابه ، فإذا PageV04P118 رأوا ثوابه قالوا : يا رب ما ينفعه ما أصابه في الدنيا ) )(@)(@@) ( حل ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10552 ) قال النبي :(@)(@@) | 30 ( تقول : الله أكبر الله أكبر الله أكبر الله أكبر ، وارفع بها صوتك ، ثم تقول : أشهد أن لا إلاه إلا الله ، أشهد أن لا إلاه إلا الله ، أشهد أن محمدا رسول الله أشهد أن محمدا رسول الله ، حي على الصلاة حي على الصلاة ، حي على الفلاح حي على الفلاح ، فإن كانت صلاة الصبح قلت : الصلاة خير من النوم ، الله أكبر ، الله أكبر ، لا إلاه إلا الله ) )(@)(@@) ( حب ) عن محمد بن عبد الملك بن أبي محذورة عن أبيه عن جده قال : قلت : يا رسول الله علمني سنة الأذان ، قال : فذكره ؛ .(@)(@@)(@@)(@@) $ ( 10553 ) قال النبي :(@)(@@) | 30 ( تقولون : اللهم صل على محمد 
ms1200	 وعلى آل محمد ، كما صليت على إبراهيم ، وبارك على محمد وآل محمد كما باركت على إبراهيم ثم تسلمون علي ) )(@)(@@) الشافعي ( هق ) في المعرفة عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10554 ) قال النبي :(@)(@@) | 30 ( تقولون : اللهم إنا نسألك مما سألك به محمد عبدك ورسولك ، ونستعيذك مما استعاذك منه محمد عبدك ورسولك ) )(@)(@@) الخرائطي في مكارم الأخلاق عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) ||| ( التاء مع الكاف(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 10555 ) قال النبي :(@)(@@) | 30 ( تكفل الله لمن جاهد في سبيله لا يخرجه من بيته إلا الجهاد في سبيله وتصديق كلماته بأن يدخله الجنة أو يرجعه إلى مسكنه الذي خرج منه مع ما نال من أجر أو غنيمة ) )(@)(@@) ( ق ن ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@) PageV04P119(@)(@@)(@@)(@@) $ ( 10556 ) قال النبي :(@)(@@) | 30 ( تكفير كل لحاء ركعتان ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10557 ) قال النبي :(@)(@@) | 30 ( تكون إبل للشياطين وبيوت للشياطين ) )(@)(@@) ( د ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 10558 ) قال النبي :(@)(@@) | 30 ( تكون الأرض يوم القيامة خبزة واحدة يتكفؤها الجبار بيده كما يتكفا أحدكم خبزته في السفر نزلا لأهل الجنة ) )(@)(@@) ( حم ق ) عن أبي سعيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 10559 ) قال النبي :(@)(@@) | 30 ( تكون النسم طيرا تعلق بالشجر ، حتى إذا كان يوم القيامة دخلت كل نفس في جسدها ) )(@)(@@) ( طب ) عن أم هانىء رضي الله عنها .(@)(@@)(@@)(@@) $ ( 10560 ) قال النبي :(@)(@@) | 30 ( تكون أمراء يقولون ولا يرد عليهم ، يتهافتون في النار يتبع بعضهم بعضا ) )(@)(@@) ( طب ) عن معاوية رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10561 ) قال النبي :(@)(@@) | 30 ( تكون بينكم وبين بني الأصفر هدنة فيغدرون بكم فيسيرون إليكم في ثمانين غاية تحت كل غاية منهم اثنا عشر ألفا ) )(@)(@@) ( ه ) عن عوف بن مالك رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 10562 ) قال النبي :(@)(@@) | 30 ( تكون بين يدي الساعة أيام يرفع فيها العلم وينزل فيها الجهل ، ويكثر فيها الهرج والهرج : القتل ) )(@)(@@) ( ه ) عن ابن مسعود رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 10563 ) قال النبي :(@)(@@) | 30 ( تكون بين يدي الساعة فتن كقطع الليل المظلم ، يصبح الرجل فيها 