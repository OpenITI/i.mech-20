ms1161	 المقاسم وسط الز % نج يقسمن بينهم بالسهام % % PageV01P4401 31(@)(@@) % من رآهن يتخذن إماء % بعد ملك الإماء والخدام % % 32(@)(@@) % ما تذكرت ما أتى الزنج إلا % أضرم القلب أيما إضرام % % 33(@)(@@) % ماتذكرت ما أتى الزنج إلا % أوجعتني مرارة الإرغام % % 34(@)(@@) % رب بيع هناك قد أرخصوه % طال ما قد غلا على السوام % % 35(@)(@@) % رب بيت هناك قد أخرجوه % كان مأوى الضعاف والأيتام % % 36(@)(@@) % رب قصر هناك قد دخلوه % % كان من قبل ذاك صعب المرام % % 37(@)(@@) % رب ذي نعمة هناك ومال % تركوه محالف الإعدام % % 38(@)(@@) % رب قوم باتوا بأجمع شمل % تركوا شملهم بغير نظام % % 39(@)(@@) % عرجا صاحبي بالبصرة الزه % راء تعريج مدنف ذي سقام % % 40(@)(@@) % فاسألاها ولا جواب لديها % % لسؤال ومن لها بالكلام % % PageV01P4402 41(@)(@@) % أين ضوضاء ذلك الخلق فيها % % أين أسواقها ذوات الرخام % % 42(@)(@@) % أين فلك فيها وفلك إليها % % منشآت في البحر كالأعلام % % 43(@)(@@) % أين تلك القصور والدور فيها % % أين ذاك البنيان ذو الإحكام % % 44(@)(@@) % بدلت تلكم القصور تلالا % % من رماد ومن تراب ركام % 45(@)(@@) % سلط البثق والحريق عليهم % % فتداعت أركانها بانهدام % 46(@)(@@) % وخلت من حلولها فهي قفر % لاترى العين بين تلك الأكام % % 47(@)(@@) % غير أيد وأرجل بائنات % نبذت بينهن أفلاق هام % % 48(@)(@@) % ووجوه قد رملتها دماء % بأبي تلكم الوجوه الدوامي % % 49(@)(@@) % وطئت بالهوان والذل قسرا % بعد طول التبجيل والإعظام % % 50(@)(@@) % فتراها تسفي الرياح عليها % % جاريات بهبوة وقتام % % PageV01P4403 51(@)(@@) % خاشعات كأنها باكيات % % باديات الثغور لا لابتسام % % 52(@)(@@) % بل ألما بساحة المسجد الجا % % مع إن كنتما ذوي إلمام % % 53(@)(@@) % فاسألاه ولا جواب لديه % أين عباده الطوال القيام % % 54(@)(@@) % أين عماره الألى عمروه % دهرهم في تلاوة وصيام % % 55(@)(@@) % أين فتيانه الحسان وجوها % أين أشياخه أولو الأحلام % % 56(@)(@@) % أي خطب وأي رزء جليل % نالنا في أولئك الأعمام % % 57(@)(@@) % كم خذلنا من ناسك ذي اجتهاد % وفقيه في دينه علام % % 58(@)(@@) % واندامي على التخلف عنهم % وقليل عنهم غناء ندامي % % 59(@)(@@) % واحيائي منهم إذا ما التقينا % % وهم عند حاكم الحكام % % 60(@)(@@) % أي عذر لنا وأي جواب % حين ندعى على رؤوس الأنام 
ms1162	 % PageV01P4404 61(@)(@@) % يا عبادي أما غضبتم لوجهي % % ذي الجلال العظيم والإكرام % % 62(@)(@@) % أخذلتم إخوانكم وقعدتم % عنهم ويحكم قعود اللئام % % 63(@)(@@) % كيف لم تعطفوا على أخوات % في حبال العبيد من آل حام % % 64(@)(@@) % لم تغاروا لغيرتي فتركتم % % حرماني لمن أحل حرامي % % 65(@)(@@) % إن من لم يغر على حرماتي % % غير كفء لقاصرات الخيام % % 66(@)(@@) % كيف ترضى الحوراء بالمرء بعلا % وهو من دون حرمة لا يحامي % % 67(@)(@@) % واحيائي من النبي إذا ما % % لامني فيهم أشد الملام % % 68(@)(@@) % وانقطاعي إذا هم خاصموني % % وتولي النبي عنهم خصامي % % 69(@)(@@) % مثلوا قوله لكم أيها النا % % س إذا لامكم مع اللوام % % 70(@)(@@) % أمتي أين كنتم إذ دعتني % % حرة من كرائم الأقوام % % PageV01P4405 71(@)(@@) % صرختيامحمداهفهلا % قام فيها رعاة حقي مقامي % % 72(@)(@@) % لم أجبها إذ كنت ميتا فلولا % % كان حي أجابها عن عظامي % % 73(@)(@@) % بأبي تلكم العظام عظاما % % وسقتها السماء صوب الغمام % % 74(@)(@@) % وعليها من المليك صلاة % وسلام مؤكد بسلام % % 75(@)(@@) % انفروا أيها الكرام خفافا % وثقالا إلى العبيد الطغام % % 76(@)(@@) % أبرموا أمرهم وأنتم نيام % سوءة سوءة لنوم النيام % % 77(@)(@@) % صدقوا ظن إخوة أملوكم % % ورجوكم لنبوة الأيام % 78(@)(@@) % أدركوا ثأرهم فذاك لديهم % % مثل رد الأرواح في الأجسام % 79(@)(@@) % لم تقروا العيون منهم بنصر % فأقروا عيونهم بانتقام % % 80(@)(@@) % أنقذوا سبيهم وقل لهم ذا % % ك حفاظا ورعية للذمام % % PageV01P4406 81(@)(@@) % عارهم لازم لكم أيها النا % % س لأن الأديان كالأرحام % % 82(@)(@@) % إن قعدتم عن اللعين فأنتم % شركاء اللعين في الآثام % 83(@)(@@) % بادروه قبل الروية بالعز % م وقبل الإسراج بالإلجام % % 84(@)(@@) % من غدا سرجه على ظهر طرف % % فحرام عليه شد الحزام % % 85(@)(@@) % لا تطيلوا المقام عن جنة الخل % % د فأنتم في غير دار مقام % % 86(@)(@@) % فاشتروا الباقيات بالعرض الأد % % نى وبيعوا انقطاعه بالدوام % % PageV01P4407 البحر : - 1(@)(@@) % مديحك من تطالبه برفد % هجاء منك فيه بلا كلام % 2(@)(@@) % ضل حلم لك أضحى % % يعبد الأير وعلم % % 2(@)(@@) % أهويت الأير حتى % % قلت إن الله جرم % 2(@)(@@) % اتق الله ففي قو % لك ان عدوان وإثم % % 2(@)(@@) % أيها القائل بالجس % م لأن الأير جسم % 2 
ms1163	(@)(@@) % لأنك لم تثق منه بمجد مجزوء الرمل أيها القائل بالجسم لأن الأير جسم بذيء اتق الله ففي قولك ان عدوان وإثم أهويت الأير حتى قلت إن الله جرم ضل حلم لك أضحى يعبد الأير وعلم بذيء % % فتقنع باللقاء وبالسلام % % PageV01P4408 البحر : - 1(@)(@@) % صلوا نصف كنيته باسمه % % إذا اجتمعا وانظروا ماهما % % 2(@)(@@) % هما عبد سوء إذ ألفا % % يوافق معناه معناهما % % PageV01P4409 البحر : - 1(@)(@@) % يابن كسرى كسرى الملوك ذوي العز % ز أين لي في هذه الأكرومه % % 2(@)(@@) % قد أضاءت وأشرقت فاهتدى السا % % ري بها في مهالك الديمومه % % 3(@)(@@) % راقت الناس منظرا ومشما % فهي ريحانة لهم مشمومه % % 4(@)(@@) % قسما إن خلة علقت من % ك بحبل لخلة مرحومه % % 5(@)(@@) % ظلمت بالرجاء فيك وإن كن % ت كنفس فأصبحت مظلومه % % 6(@)(@@) % ياسمي الفتى الذي كان بابا % لجحود المكارم المعدومه % % 7(@)(@@) % كيف حالت بك الخلائق حتى % % أصبحت بعد حمدها مذمومه % % 8(@)(@@) % كيف زالت تلك المعالي فأضحت % بعدما قد بنيتها مهدومه % 9(@)(@@) % كيف مرت تلك المذاقة حتى % % أصبحت بعد طيبها مسمومه % % 10(@)(@@) % قد لعمري طمست مني وجها % كنت فيما مضى تقيم رسومه % % PageV01P4410 11(@)(@@) % صرت قطعا من الظلام لأفق % بعدما كنت بدره ونجومه % % 12(@)(@@) % قلدتني يداك سمطا من العا % % ر خلاف اللآليء المنظومة % % 13(@)(@@) % ولأنت الشريك في ذاك فاعلم % غير مظنونة ولا موهومه % % 14(@)(@@) % لم تضعني إلا بوضعك من نف % % سك فافهم جلية مفهومه % % 15(@)(@@) % بك حل الملام لا بي بل النف % س التي أملتك عين الملومه % % 16(@)(@@) % كلمات تذم فعلك لا أص % % لك كلا ولا تذم الأرومه % % 17(@)(@@) % سوأتي سوأتي على أي شيء % منك أضحت أناملي مضمومه % % 18(@)(@@) % لهف نفسي على الدماثة والحك % % مة كلتاهما مذمومه % % 19(@)(@@) % كيف لم يردعاك عن فعل شنعا % % ء قبيح رواؤها مشؤومه % % 20(@)(@@) % أبقدري وزنت خمسين رطلا % % من حطام يا ظالما في الحكومه % % PageV01P4411 21(@)(@@) % وهو جزء مما وعدت ضئيل % غرق في صلاتك المقسومه % % 22(@)(@@) % دم على ما أراه منك فمالي % % حاجة في هدية بخصومه % % 23(@)(@@) % واطرح الهم عنك وافرح بنصحي % % فرج الله نفسك المهمومه % % 24 
ms1164	(@)(@@) % للئام الرجال لا لي وجوه % عانيات وآنف مخزومه % % 25(@)(@@) % أو لم تدر أن نفسي عن الما % % ء إذا شابه القذى معصومه % % 26(@)(@@) % لا يسود امرؤ يعد الرزايا % % في المعالي مغانما مغنومه % 27(@)(@@) % فطمت رغبتي إليك أبا يحي % % ى ويا رب رغبة مفطومه % % 28(@)(@@) % ويمينا مبرورة إن نفسا % % حرمتني الطفيف للمحرومه % % 29(@)(@@) % ومتى ما غدت وقد شتمتني % % باحتقار فإنها المشتومه % % 30(@)(@@) % ما استخف امرؤ بقدري حتى % % بوأ النفس موقف المرحومه % % PageV01P4412 31(@)(@@) % وأراك المليء إن قلت قولا % لمجازاة حتمة محتومه % % 32(@)(@@) % غير أني أرى جنودك إن طا % % لت بنا حربنا هي المهزومه % % 33(@)(@@) % من أساء الفعال والقول ولى % عن أخيه ذا حجة مخصومه % % 34(@)(@@) % أنا من قد عرفته يا أبا يحي % % ى إذا استهدر الهجاء قرومه % % 35(@)(@@) % سطوتي سطوة المجاهر لاذي % % بغية من مناوىء مكتومه % % 36(@)(@@) % هاكها حرة لحر تبدت % % لانتصار فجعجعت مزمومه % % 37(@)(@@) % زمها عنك ما فعلت وما أس % % ديت أيام مجدك الموسومه % % 38(@)(@@) % بلغت بي رضاي منك وإن كا % % نت بعيني مفتوحة مختومه % % 39(@)(@@) % خطبة لو كظمتها كان أولى % % بي ولكن مرة مكظومه % % 40(@)(@@) % وعليك السلام من ذي فراق % ووداع لخلة مصرومه % % PageV01P4413 البحر : - 1(@)(@@) % وفي أبي سعد لؤم % وإن قرى وتبسم % 2(@)(@@) % يقري الضيوف ولكن % يقري الضيوف ويندم % % 3(@)(@@) % وليس يندم سرا % لكنه يتكلم % 4(@)(@@) % فمن أراد قراه % % والشتم فليتقدم % 5(@)(@@) % وليس يرضيه عرض % ولا أديم مكلم % % 6(@)(@@) % بل اللحوم تفرى % % بل العظام تحطم % 7(@)(@@) % وكيف ينجو مغير % على فريسة ضيغم % % 8(@)(@@) % إياك إياك إن زر % ته تلم بمطعم % % 9(@)(@@) % إن الحلال لديه % % على الضيوف محرم % % 10(@)(@@) % فمن أباح حماه % كان القصاص من الدم % % PageV01P4414 11(@)(@@) % يا رب شهد أكلنا % % ه عنده كان علقم % % 12(@)(@@) % أضافنا فأكلنا % % فنحن نهجى ونشتم % % 13(@)(@@) % ولم يكن من كريم % % لكنه يتكرم % % 14(@)(@@) % سائل بذاك ابنه الحر % ر فهو أدرى وأعلم % % 15(@)(@@) % وإنما الغصن يسقى % % من عرقه فتفهم % % PageV01P4415 البحر : - 1(@)(@@) % قل خالد وخلاك ذم % والصبح أجلح لا أغم % 2(@)(@@) % العار قدما والشنا % % ر لخالد خال وعم 
ms1165	 % 3(@)(@@) % شيخ يناك عياله % وكأنه تيس أحم % 4(@)(@@) % نيك أذان صلاته % ضم وتقبيل وشم % % 5(@)(@@) % وكأنه إذ ذاك زم % مم أنفه خطم وزم % 6(@)(@@) % سيرى المدلس أينا % % يحزى إذا احتشك المضم % % 7(@)(@@) % لا ينثني عنه الرقا % % ة فإنه حنش أصم % % PageV01P4416 البحر : - 1(@)(@@) % شغل المحب عن الرسو % % م وإن غدت مثل الوشوم % 2(@)(@@) % شكوى الظلامة منظلو % % مفي حكومتها غشوم % 3(@)(@@) % ظلمت لتحقيق اسمها % % فغدت تبر على سدوم % 4(@)(@@) % هل حاكم عدل الحكو % % مة منصف لي من ظلوم % % 5(@)(@@) % باتت لظاهرها وسا % % وس من حلي كالنجوم % % 6(@)(@@) % والباطني منها وسا % % وس من هموم كالخصوم % % 7(@)(@@) % شتان بين الحالتي % ن من المواصل والصروم % 8(@)(@@) % كم بين وسواس الحلي % ي وبين وسواس الهموم % % 9(@)(@@) % سقيا لها إذ طالعت % ك ضحى من الخدر الكتوم % % 10(@)(@@) % وكأن غرة وجهها % % شمس تطالع من غيوم % PageV01P4417 11(@)(@@) % وقفت لقلبك موقفا % يهدي الصبا لذوي الحلوم % % 12(@)(@@) % واستعجمت لكنها % % كتبت إليك بلا رسوم % % 13(@)(@@) % أهدت لروحك روحها % % وحيا يدق عن الجسوم % % 14(@)(@@) % وعلمته رجما وكم % % لك من علوم في رجوم % % 15(@)(@@) % إن لا تلم من راح في % % ك محملا عبء الملوم % % 16(@)(@@) % أشكو إليك ظماءة % من مثلة ريا سجوم % % 17(@)(@@) % ووشاية العطر النمو % % م علي والحلي النموم % % 18(@)(@@) % لولاهما لأطعت فيك % نزاع صادية حؤوم % % 19(@)(@@) % قلت اصدفي ودعيهما % % ليسا بحتم في الحتوم % % 20(@)(@@) % ما الحلي والعطر الفصي % % ح بضربة من ذي لزوم % % PageV01P4418 21(@)(@@) % إن كان قلبك من هوا % % ه كقلبي الدامي الكلوم % % 22(@)(@@) % فتبرئي من واشيي % ك فليس تركهما بلوم % % 23(@)(@@) % أو ما رأيت ذوي الخصا % % ئص في الهوى وذوي العموم % 24(@)(@@) % يتبرأون من الجلو % % د لمن هووا ومن اللحوم % 25(@)(@@) % فتبسمت علما بصد % % قك وانقطعت إلى الوجوم % % 26(@)(@@) % دع ذا لبدر قد أضا % % ء فما عليه من قتوم % % 27(@)(@@) % وافى سناه ودونه % حجب السرور مع الجروم % % 28(@)(@@) % فتحكمت خفف المطا % % مع والأماني الجثوم % % 29(@)(@@) % ثم استقل فكان نو % % را للسهول وللحزوم % % 30(@)(@@) % فتجوبت بهم الدجى % % وتكثفت غمم الغموم % % PageV01P4419 31(@)(@@) % قدم 
ms1166	 الأمير فمرحبا % بالقادمين وبالقدوم % % 32(@)(@@) % ملك غدا فوق البري % ية والأخشة في الخطوم % % 33(@)(@@) % كالوالد البر الرؤو % % ف بنا وكالأم الرؤوم % % 34(@)(@@) % والخسف دون قبوله % % طرفا من الخسف المشوم % % 35(@)(@@) % ليث الليوث إذا الحرو % % ب تسعرت قرم القروم % % 36(@)(@@) % غيث الأنام إذا الغيو % % ث بخلن في السنة الأزوم % % 37(@)(@@) % ما في قراه لطارق % ولمستميح من عتوم % % 38(@)(@@) % خفت خطاه إلى الوغى % % والحلم أرجح من يسوم % % 39(@)(@@) % وجد السلامة في الكرا % % هة والفخامة في السهوم % % 40(@)(@@) % فتراه يبرز وجهه % تحت السيوف وللسموم % PageV01P4420 41(@)(@@) % لم تلهه خمر المرا % % شف لا ولا خمر الكروم % % 42(@)(@@) % وأخو الرفاهة بين مس % % معة وإبريق رذوم % % 43(@)(@@) % ممن يغادي المزهر الحن % نان للقوس الزجوم % % 44(@)(@@) % تكفيه أوتار القس % % ي من المثالث والبموم % % 45(@)(@@) % ظفرت تزال في اللقا % % ء بسهم فلاج سهوم % % 46(@)(@@) % ما إن تزال عداته % % بين الهزائم والهزوم % % 47(@)(@@) % يغزو العدا في ليل زن % ج حالك ونهار روم % % 48(@)(@@) % فالليل عون والنها % % ر له على الأمر المروم % % 49(@)(@@) % وابنا الزمان هما هما % % غلبا المعاقل بالهجوم % % 50(@)(@@) % يرمي العدا بجوائح % % تأتي الفروع من الأروم % % PageV01P4421 51(@)(@@) % كالريح أهلكت الهوا % % لك في لياليها الحسوم % % 52(@)(@@) % يا دهر جارى من عدا % % تك ساحلا بحر طموم % 53(@)(@@) % بحر يجم على العطا % % ء ويستغيض على الجموم % % 54(@)(@@) % من هاشم في أنفها % % فارجع بأنف ذي هشوم % % 55(@)(@@) % خير الفروع بالباسقا % % ت سما به خير الجذوم % % 56(@)(@@) % تضحي يداه لماله % ما شئت من جار هضوم % % 57(@)(@@) % لم يحسب المجد الشرا % % ء ولم يبع كرما بلوم % % 58(@)(@@) % نفحاته فوق المنى % % وظنونه فوق العلوم % 59(@)(@@) % سم البرية سخطه % ورضاه درياق السموم % % 60(@)(@@) % رجعت حقائب وفده % كوما على أمطاء كوم % % PageV01P4422 61(@)(@@) % يشكون أثقال الغنى % % طورا وأثقال السجوم % % 62(@)(@@) % ما مثله عن بخس مث % % لك حق مثلي بالنؤوم % 63(@)(@@) % عافيه من بذل اللهى % % والمرتجيه على التخوم % % 64(@)(@@) % لا تستحيل عهوده % % والمسك معدوم الحموم % % 65(@)(@@) % يأسو ويكلم غير مذ % موم الإساءة والكلوم % % 66(@)(@@) % ساس الورى بيد وهو % % ب للهى 
ms1167	 ويد ضموم % % 67(@)(@@) % فيد كصفحة سيفه % % ويد كشفرته الحذوم % % 68(@)(@@) % فذوو السعادة ذاهبو % % ن عن القصوم إلى العصوم % % 69(@)(@@) % وذوو الشقاوة ذاهبو % % ن عن العصوم إلى القصوم % % 70(@)(@@) % يا صاحب الفضل الخصو % % ص وصاحب البذل العموم % % PageV01P4423 71(@)(@@) % يا ناصر الدين الذي % % ذاد السباع عن اللحوم % % 72(@)(@@) % وأجد أعلام الهدى % % بعد الخلوقة والطسوم % % 73(@)(@@) % كم من مقام قمته % ماكان قبلك بالمقوم % 74(@)(@@) % خذها كأوشية الريا % % ض وفوق أوشية الرقوم % 75(@)(@@) % مطبوعة مصنوعة % تختال في الحقل الضموم % % PageV01P4424 البحر : - 1(@)(@@) % للناس فيما يكلفون مغارم % عند الكرام لها قضاء ذمام % 2(@)(@@) % ومغارم الشعراء في أشعارهم % % إنفاق أغمار وهجر منام % % 3(@)(@@) % وجفاء لذات ورفض مكاسب % لو خولفت حرست من الإعدام % % 4(@)(@@) % وتشاغل عن ذكر رب لم يزل % % حسن الصنائع سابغ الإنعام % % 5(@)(@@) % من لو بخدمته تشاغل معشر % خدموكم أجدى على الخدام % % 6(@)(@@) % أفما لذلك حرمة مرعية % % إن الكرام إذا لغير كرام % % 7(@)(@@) % لم أحتسب فيك الثواب بمدحتي % % إياك يابن أكارم الأقوام % % 8(@)(@@) % لو كان مدحي حسبة لم أكسه % % أحدا أحق به من الأيتام % % 9(@)(@@) % فاقبل مديحا والقه بثوابه % % أو لا فدعه لغارم غنام % % 10(@)(@@) % لا تقبلن المدح ثم تعقه % وتنام والشعراء غير نيام % % PageV01P4425 11(@)(@@) % واحذر معرتهم إذا دانيتهم % فلهم أشد معرة العرام % % 12(@)(@@) % واعلم بأنهم إذا لم ينصفوا % % حكموا لأنفسهم على الحكام % 13(@)(@@) % وظلامة العادي عليهم تنقضي % % وعقابهم يبقى على الأيام % % PageV01P4426 البحر : - 1(@)(@@) % تمادى الصبا بي في غيه % % وأسلمني للهوى لومي % % 2(@)(@@) % وراجعت لهوي ولذاته % % ونزهت نفسي عن المحرم % % 3(@)(@@) % وقال العواتق أهلا بمن % تناهى إلى الخلق الأكرم % % 4(@)(@@) % فكم لي فيهن من قاضيات % نذورا لذاك ولم أعلم % % 5(@)(@@) % وقائلة بين أترابها % % أما يتقي الله ذا في دمي % % 6(@)(@@) % ألا ليته زار مستخفيا % إذا رقدت أعين النوم % % 7(@)(@@) % فأنقع من قربه غلة % بقلبي من حبه الأقدم % % 8(@)(@@) % أتتني الرسالة عنها بذاك % % على منطق ليس بالأعجمي % % 9(@)(@@) % فأنبأتها أنني حافظ % % لأشياخها ذمة المسلم % % 10(@)(@@) % وأودعتها حسرة بالعفاف % ووفرت ديني فلم أثلم % PageV01P4427 11(@)(@@) % ألا فاسقني من بنات 
ms1168	 الكروم % % ورو بكاساتها أعظمي % % 12(@)(@@) % على لحن صوت تخيرته % وإلا فلا تدنها من فمي % % 13(@)(@@) % غشيت المنازل بالأنعم % % كمنعرج الوشي في المعصم % % PageV01P4428 البحر : - 1(@)(@@) % يا رب ما أطول البلاء وما % % أكثر في أن بليت لوامي % % 2(@)(@@) % يلومني الناس أن حرمت وما % % ألزمني الله غير إحرامي % % 3(@)(@@) % كم بكتوني وعيروا أدبي % % لما جفاني محل إعظامي % % 4(@)(@@) % قالوا ألا شغل يجتبيك له % % وقد رأوا غلتي وتحوامي % % 5(@)(@@) % فقلت لا تعجبوا لأفهمكم % وقد يمس القلوب إفهامي % % 6(@)(@@) % أجلني قاسم وأكرمني % % أكرمه من أراه إكرامي % % 7(@)(@@) % هم بشغلي بمعمل فرأى % % أن أطرافي تجم آثامي % % 8(@)(@@) % وأن دأبي يجر لي تعبا % يكثر بعد الصحاح أسقامي % % 9(@)(@@) % فصان عمري عن أن يقسمه % بين ذنوبي وبين آلامي % % 10(@)(@@) % صافي العطايا يظل يمنع إخ % % ساري من أن ينوب إغنامي % % PageV01P4429 11(@)(@@) % يدر رزقي علي في دعة % منفلي ماله وأيامي % % 12(@)(@@) % فالنفس في عيشة مغفلة % تمر لي كالشهور أعوامي % % 13(@)(@@) % أنفق من ماله ومن عمري % % فيما ترى شهوتي وإغرامي % % 14(@)(@@) % سامية في مآربي هممي % % نافذة في هواي أحكامي % % 15(@)(@@) % في غير عيب يعيب منزلتي % % وغير ريب يريب إسلامي % % 16(@)(@@) % يا آل وهب حماة حوزتنا % % نكب عنكم بسهمه الرامي % % 17(@)(@@) % كم أجلب العذر من مذاقته % % لكم وتستشعرون إتهامي % % 18(@)(@@) % أضحى اجتهادي لنفي عيبكم % مثل اجتهادي لنفي إعدامي % % PageV01P4430 البحر : - 1(@)(@@) % على الطائر الأيمن المرتجى % % وسعد من الطالع الناجم % % 2(@)(@@) % أتاك أبو غالب كالهلال % % بداليلة الفطر للصائم % % 3(@)(@@) % يبشر بالخير بعد السرور % وبالرخص بعد الغلا الدائم % % 4(@)(@@) % وبالخصب بعد السنين التي % % توالت جدوبا على العالم % % 5(@)(@@) % فآذن بالفرج المرتجى % % وصدق رؤياي في الخاتم % % 6(@)(@@) % وسر الصديق وساء العدا % % وراغم ذا المعطس الراغم % % 7(@)(@@) % سليل تقى نقي الجيو % % ب من دنس العاب والمأثم % % 8(@)(@@) % كريم لأكرم من يرتجى % % وأجود في الجود من حاتم % % 9(@)(@@) % وبدر لبدر بدا مشبها % لوالده غير ما ظالم % % 10(@)(@@) % فهنئته يا أبا الصقر من % % بشير بثان له قادم % % PageV01P4431 11(@)(@@) % وعمره الله حتى ترى % % بنيه رعاة بني آدم % % 12(@)(@@) % وبلغه مبلغ 
ms1169	 الصالحين % % وأرقد عينيه من نائم % % PageV01P4432 البحر : - 1(@)(@@) % غدوت إليك ولي واعدا % % ن رب رحيم ورجس رجيم % 2(@)(@@) % فللرجس وعد بنكرائه % % ليحرمني وهو خب لئيم % % 3(@)(@@) % ولله وعد بمعروفه % % ألا فليصدق كريما كريم % 4(@)(@@) % وأنت بتحقيق ما أرتجيه % % وإبطال أسوأ ظن زعيم % PageV01P4433 البحر : - 1(@)(@@) % قلبي من الطرف السقيم سقيم % لو أن من أشكو إليه رحيم % 2(@)(@@) % أضحى ينغصني النسيم نسيمه % % أفلا يهنيني النسيم نسيم % % 3(@)(@@) % من وجهها أبدا نهار واضح % من فرعها ليل عليه بهيم % % 4(@)(@@) % إن أقبلت فالبدر لاح وإن مشت % فالغصن راح وإن رنت فالريم % % 5(@)(@@) % نعمت بها عيني فطال عذابها % % ولكم عذاب قد جناه نعيم % % 6(@)(@@) % نظرت فأقصدت الفؤاد بسهمها % % ثم انثنت نحوي فكدت أهيم % % 7(@)(@@) % ويلاه إن نظرت وإن هي أعرضت % وقع السهام ونزعهن أليم % % 8(@)(@@) % ومما دهتني دون عيني عينها % % لكن غب النظرتين وخيم % % 9(@)(@@) % ولما البلية من خصيم واحد % مالم يكن للمرء منه خصيم % % 10(@)(@@) % يا مستحل دمي محرم رحمتي % % ما أنصف التحليل والتحريم % % PageV01P4434 11(@)(@@) % إن الذي وهبت يداه مثلكم % % يا آل وهب للعلا لكريم % % 12(@)(@@) % ولئن تهيأ للزمان ولادكم % % إن الزمان بمثلكم لعقيم % 13(@)(@@) % لترون سائلكم أحق بمالكم % % من بعضكم حتى يقال غريم % % 14(@)(@@) % ويحل في عليا مراتب ودكم % وخصوصكم حتى يقال حميم % 15(@)(@@) % كم من مهيب منكم تعنو له % % غلب الأسود وإنه لحليم % % 16(@)(@@) % ومخدع عند السؤال كأنه % % غر هناك وإنه لحكيم % % 17(@)(@@) % ومغفل عن كل عثرة عاثر % دأب الغبي وإنه لعليم % % 18(@)(@@) % ممن أقام له الطباع قناته % % لا من أقام قناته التقويم % % 19(@)(@@) % لله أمركم الذي لو أنه % رجل لقال له الرجال وسيم % % 20(@)(@@) % لا كان فيه مع النماء نقيصة % وصفا له التخليد والتتميم % % PageV01P4435 21(@)(@@) % كم تسكتون عن الذي تولونه % لتصغروه وإنه لجسيم % % 22(@)(@@) % والله يعظم قدر معروف لكم % % لم تعظموه وإنه لعظيم % % 23(@)(@@) % والله يبعثني عليكم إنني % % بإذاعة العرف الستير زعيم % % 24(@)(@@) % ولحسبكم بنميم ما تخفونه % % منا وللمسك الذكي نميم % % PageV01P4436 البحر : - 1(@)(@@) % آليت أهجو كريما عند نبوته % % ولا لئيما وإن أكدى 
ms1170	 وإن شتما % % 2(@)(@@) % أنفت من أن يقول الناس لي كلب % وبصرتني صروف الدهر بعد عمى ص وقومتني يد من سيد حدب % 3(@)(@@) % بل شيمة منه أعدت شيمتي كرما % % فلن أرى ما تولاني به ترة % 4(@)(@@) % بل نعمة تستحق الشكر بل نعما % % لله در ثقاف منه قومني % % 5(@)(@@) % لئن لؤمت لقد أبقى وما لؤما % % ما زال يرفق في تقويمه أودي % % 6(@)(@@) % حتى تقوم لي عودي وما تحطما % % ن % PageV01P4437 البحر : - 1(@)(@@) % لا تحسب النبط الأوغاد أنهم % أولى من العرب الأمجاد بالقلم % 2(@)(@@) % وإن غدوا دون أهل الأرض إخوته % % أبوهم وأبيهم منبت الأجم % % 3(@)(@@) % كم من أخ لو أخوه كان هاديه % % إذا لضل ضلالا ليس بالأمم % % 4(@)(@@) % هداه أقصى غريب قصد وجهته % من بعد ما حار في داج من الظلم % % 5(@)(@@) % هذا أبو الصقر فرد في كتابته % % وهو ابن شيبان بين الطلح والسلم % % 6(@)(@@) % ما جاورت نبطي الزل نبعته % % بل جاورت . . النبع والبشم % % 7(@)(@@) % هو الذي حمل الأقلام ضاحية % عن الطريق وقد جارت عن اللقم % % 8(@)(@@) % أمسى وأصبح بين الناس أرفعهم % ذكرا وأشهرهم بالمجد والكرم % % 9(@)(@@) % كأنه الشمس في الأوج المنيف بها % % على البرية لا نار على علم % 10(@)(@@) % فزاده الله تشريفا وأصحبه % % رشدا يثبت منه وطأة القدم % % PageV01P4438 البحر : - 1(@)(@@) % يا أبا الصقر إن شكري لمعرو % فك شكر باق على الأيام % 2(@)(@@) % فاستدمه فإنما تصحب النع % مة من كان دائم الإنعام % % 3(@)(@@) % لك صفو المديح والشكر مني % % في نظام وصلته بنظام % 4(@)(@@) % وعيون ما مثلها من عيون % آخذات مختار كل كلام % % 5(@)(@@) % لا اذم الزمان ما كنت ترعى % % يا أبا الصقر حرمتي وذمامي % % 6(@)(@@) % لم أزل منك في نعيم مقيم % % لم يزل عند رحلتي ومقامي % % 7(@)(@@) % ضل من قد دعوت دونك عني % % ووجدت الكرام غير كرام % % 8(@)(@@) % وضمان على مديحي وشكري % % لك حسن الثناء في الأقوام % % 9(@)(@@) % وبحسبي بأن شكري لمعرو % % فك مما أريته في المنام % % 10(@)(@@) % ناب عن صدقه وصدق وفائي % % لك بالشكر صادق الأحلام % % PageV01P4439 11(@)(@@) % صمت عمن سواك من سائر النا 
ms1171	 % % س ففطري بذاك عند صيامي % % 12(@)(@@) % لست ممن ينام عن واجب الحق % % ق عليه وأنت غيث الأنام % % 13(@)(@@) % قد يحث الجواد غير بطيء % ويهز الحسام غير كهام % % PageV01P4440 البحر : - 1(@)(@@) % أيها المنصف إلا رجلا % واحدا أصبحت ممن ظلمه % 2(@)(@@) % كيف ترضى العسر خدنا لامرىء % % وهو لا يرضى لك الدنيا أمه % % PageV01P4441 البحر : - 1(@)(@@) % أبا العباس ما هذا التواني % % وقد أوسعت من كرم وفهم % 2(@)(@@) % أتقلب ذا محافظة عدوا % لعمرو أبيك ما هذا بحزم % % 3(@)(@@) % عزمت ندى فما أمضيت عزما % وكنت مشهرا بمضاء عزم % 4(@)(@@) % قصدتك راجيا واليأس رجم % فلم تترك رجاء غير رجم % % 5(@)(@@) % وواترت السؤال فلم تجبني % % كأني سائل آيات رسم % % 6(@)(@@) % أما والله ما هذا بحقي % % عليك إذا شجيت بظلم خصم % % 7(@)(@@) % زأرت على عدوك غير وان % وأتبعت الزئير له بكلم % % 8(@)(@@) % فما أخليته من نهش لحم % % ولا أخليته من حطم عظم % % 9(@)(@@) % وخفت عليك عادية الليالي % % فبت الليل أرقب كل نجم % % 10(@)(@@) % حراسة ليث صدق لا يبالي % % بسيف في الحفاظ ولا بسهم % % PageV01P4442 11(@)(@@) % فما كافأتني إلا بجوع % % كأني كنت عندك كلب طسم % % 12(@)(@@) % إليك إليك من وسم القوافي % % إليك فإنه من شر وسم % % 13(@)(@@) % ولم أخش الهجاء عليك لكن % خشيت المدح من نثر ونظم % % 14(@)(@@) % ومن تحرمه رفدك بعد مدح % % فحسبك مدحه من كل شتم % % 15(@)(@@) % أليس يقال قيل له فأكدى % % فتصبح والذي تهجى برقم % % 16(@)(@@) % أترضى ان تروح وفضل مثلي % % عليك وليس فضلك غير وهم % % 17(@)(@@) % لئن خيبتني ورفدت غيري % % لقد صدقت قول جهم % % 18(@)(@@) % ألا لا فعل حي باختيار % % متى خيبتني لكن بحتم % % 19(@)(@@) % أتلقى وجه مسبوق بمسح % % وتلقى وجه سباق بلطم % 20(@)(@@) % لقد أضحت عقول الناس باخت % بما فيهن من عيب ووصم % % PageV01P4443 21(@)(@@) % وكم من قائل لي في مسيء % لقد فخمت منه غير فخم % 22(@)(@@) % فقلت بنيت مأثرة بشعري % % فلا تعرض لمأثرتي بهدم % % 23(@)(@@) % ودع ذم المسيء فما مسيء % رأى غب الإساءة غير وخم % % 24(@)(@@) % عفوت فلا أقابله بلوم % % وإن أوسعت من لوم وعدم % % 25(@)(@@) % وما 
ms1172	 عفوي لشيء غير أني % % أرى لحم اللئيم أغث لحم % % PageV01P4444 البحر : - 1(@)(@@) % خليل من الخلان أصفيه خلتي % % فأبدى لي السر الذي أنا كاتمه % 2(@)(@@) % ويحزنني طورا وطورا يسرني % % مغانمه طورا وطورا مغارمه % % 3(@)(@@) % بليت ببلوى والبلايا كثيرة % وكانت مرجاة لدينا مقاومه % % 4(@)(@@) % فلم أتخير من ثقاتي غيره % ولم أر أني عند ذلك ظالمه % % 5(@)(@@) % وقال لي التأميل فيه ألا ادعه % لخطبك لا تعظم عليك عظائمه % % 6(@)(@@) % فلم أتخير بين يأس ومطمع % % ولا قلت جبس بارد القلب نائمه % % 7(@)(@@) % فبكيته حيا كميت فقدته % % وما الميت إلا من تموت مكارمه % % 8(@)(@@) % فلا تلحه يابن الكرام وأعفه % فما لوم من لم تبق إلا رمائمه % % 9(@)(@@) % نعائي أبا يحيى إليك فإنه % تداعت معانيه وبادت معالمه % % 10(@)(@@) % فخذ في مراثي من تبدل بالعلا % % سفالا فما تجدى عليك ملاومه % % PageV01P4445 11(@)(@@) % غدا خادما للشح والشح ربه % % وعهدي به الأمس والجود خادمه % % PageV01P4446 البحر : - 1(@)(@@) % إني أراك بعين لا يراك بها % % إلا امرؤ جددت من طرفه الحكم % 2(@)(@@) % ومن رآك بعين غير كاذبة % % رأى الذي كل شيء بعده أمم % % 3(@)(@@) % في الناس قوم يريهم إفك ظنهم % شمس النهار تباري قطرها الركم % % 4(@)(@@) % ولست منهم معاذ الله إنهم % سيان فيما رووا من ذاك والنعم % % 5(@)(@@) % بل هندسي تريني الشمس هندستي % % على الحقيقة في شخص له عظم % % 6(@)(@@) % ومن تحلى بعين أبصرها % % من حيث لا يتوارى شخصها العمم % 7(@)(@@) % ملأت صدري جلالا يا أبا حسن % هدت له مني الأركان والدعم % % 8(@)(@@) % فكلما رمت أن ألقاك أقعدني % % ما لا يقوم له ساق ولا قدم % % 9(@)(@@) % وليس ذاك ببدع لا ولا عجب % % كذاك قدما تهاب السادة الخدم % % 10(@)(@@) % متى أقبل كفا منك فتئت % % ركنا يقبل للجدوى ويستلم % % PageV01P4447 11(@)(@@) % للناس في كل سر من أسرتها % % واد ترف على أرجائه النعم % % PageV01P4448 البحر : - 1(@)(@@) % وطئت أبا إسحق أثبت وطأة % وأثقلها ثقلا على رغم راغم % % 2(@)(@@) % وهنئت ما أعطيته من كرامة % وهنئك المعطاك بأني المكارم % 3(@)(@@) % سبقت به الكتاب عفوا كسبقه % بل السادة الأملاك من آل هاشم % % 4 
ms1173	(@)(@@) % وأصبحتما مستبشرين كلاكما % % بصاحبه قد فاز فوزة غانم % 5(@)(@@) % وإنك للحظ النفيس لسيد % كما أنه الحظ النفيس لخادم % % 6(@)(@@) % فمن شاء فليبك الدماء نفاسة % ومن شاء فليضحك إلى فهر هائم % % 7(@)(@@) % أما والهدايا الداميات نحورها % % ضحى والمطايا الداميات المناسم % % 8(@)(@@) % لقد أيدت منك الخلافة طودها % % بركن وثيق غير واهي الدعائم % % 9(@)(@@) % كأني بمصر قد تجليت طالعا % عليها بوجه مسفر غير قاتم % % 10(@)(@@) % فظلت بيوم من ضيائك شامس % رهينا بيوم من سماحك غائم % % PageV01P4449 11(@)(@@) % رحلت إليها العيس أيمن راحل % ويقدمها من بعد أسعد قادم % % 12(@)(@@) % فتنجز لي وعد الرجاء بميرة % من العرف فوق الساحجات الرواسم % % 13(@)(@@) % تعجلها موفورة وتديمها % % ولا خير في المعروف ليس بدائم % % PageV01P4450 البحر : - 1(@)(@@) % دامت لك الصالحات والنعم % ولا أغبتك منهما الديم % 2(@)(@@) % يابن الذين اشمخر مجدهم % بهم إلى حيث تنتهي الهمم % % 3(@)(@@) % أحين أملت أن أجير على الد % دهر بعز الأمير أهتضم % % 4(@)(@@) % تهدم داري وفي يدي معا % % منك العرا المحصدات والذمم % % 5(@)(@@) % من بعد ما اطوف الطريد بها % % وقال قوم فناؤها حرم % % 6(@)(@@) % إن يكن الهدم نال ذروتها % % فقد أراها مهيبة بكم % % 7(@)(@@) % إذا أظل السحاب خطتها % % همهم بالرعد وهو مكتتم % 8(@)(@@) % يا لهفتي أن يكون مسني الظ % % ظلم وما مس ظالمي ندم % % 9(@)(@@) % كيف أحير الجواب منتصفا % من ذي خطاب وكيف أبتسم % 10(@)(@@) % وابن أبي كامل تظلمني % % ألأم عبد مشت به قدم % % PageV01P4451 11(@)(@@) % وجاء ما شفني وأرمضني % % منه فنار الغليل تضطرم % % 12(@)(@@) % إخفاره ذمة الأمير ولم % % يمر وريديه صارم خذم % % 13(@)(@@) % وملء داري وحق سيدي ال % % أكبر ذي المجد والعلا حرم % % 14(@)(@@) % يهتفن باسم الأمير آونة % وتارة عندهن ملتزم % 15(@)(@@) % لو كن أسمعن من هتفن به % لهزه للحفيظة الكرم % % 16(@)(@@) % ها أنا عبد الأمير قد وضحت % % ظلامتي فهي عنده علم % % 17(@)(@@) % فليأت في العبد ما تقر به ال % % عين ويشفى الغليل والسقم % % 18(@)(@@) % وبعد فالعبد طوع سيده % % فاحكم بما شئت وانقضى الكلم % % 19(@)(@@) % ظني بعدل الأمير بل ثقتي % % بحرمتي أنه سينتقم % % PageV01P4452 البحر : - 1(@)(@@) % كثرت فتوح 
ms1174	 أميرنا وتتابعت % فجزاه رب الناس دار كرامته % 2(@)(@@) % ما إن يزال معزيا خلفاءنا % % عن كورة ومهنئا بسلامته % 3(@)(@@) % لا فتح إلا هكذا ولمثله % % فتح الفتوح ببأسه وصرامته % 4(@)(@@) % ضرط كتشقيق الحرير وسلحة % في عارضيه وفي مفارق هامته % % PageV01P4453 البحر : - 1(@)(@@) % ما بحريث نال ابنه الكرما % % لكن بما قد أباحنا الحرما % % 2(@)(@@) % جاد بأشياء لا يجاد بها % % لشيمة فيه بذت الشيما % % 3(@)(@@) % كل جواد في ملكه حرم % وليس شيء في ملكه حرما % % 4(@)(@@) % أصبح قدام من تقدمه % % جودا وإن هم تقدموا قدما % % 5(@)(@@) % يا أيها العائبون شيمته % ضعوا المقاييس بيننا حكما % % 6(@)(@@) % أسمح من تعلمون حاتمكم % % وإنما كان يمنح النعما % % 7(@)(@@) % فمن سخت نفسه بحرمته % % فهو الذي ليس بعده كرما % % 8(@)(@@) % ثلاثة يعرف السخاء بها % % فقوموها ورتبوا القيما % % 9(@)(@@) % المال والنفس وهي تفضله % والحرمات التي تفي بهما % % 10(@)(@@) % وذاك أن النفوس تخطر عن % % هن وتستمطر السيوف دما % % PageV01P4454 11(@)(@@) % والله أن لو رآه حاتمكم % وكعبكم ألقيا له السلما % % 12(@)(@@) % أثني عليه ببعض نعمته % % فأرغم الله أنف من رغما % % 13(@)(@@) % والحمد لله لا شريك له % % من لم يقلها فنفسه ظلما % % PageV01P4455 البحر : - 1(@)(@@) % وليس حراما شتم من كان مفحما % % على شاعر قد سامه الضيم سائم % 2(@)(@@) % وما ضعف قرني إن تصدى لقوتي % % بمنجيه مني أو ترن مآتم % 3(@)(@@) % وفي الله كاف إن أحيلت حوائل % ودست مقالات ونمت نمائم % 4(@)(@@) % وراصد صدق لا يزال بظالم % % عقوباته أو يرعوي وهو نادم % % 5(@)(@@) % ولم خلقت للناس أيد وألسن % إذا هي لم تمنع بهن المحارم % % 6(@)(@@) % إذا أعطيت غلب الأسود سلاحها % % وقل قوى إن رام ضيمك رائم % 7(@)(@@) % وأدركها ضيم فلم تنتصر له % % فلم يشكر الله الليوث الضراغم % % 8(@)(@@) % لضعف وإعزار أقل مضرة % من الأيد أوتاه ولي منه ضائم % % PageV01P4456 البحر : - 1(@)(@@) % وكنت إذا ما هجاني امرؤ % لئيم عرفت دواء اللئيم % % 2(@)(@@) % أعد هجائي له نائلا % وأبذله بذل سمح كريم % % 3(@)(@@) % فأبلغ من شتمه حاجتي % % ولم أهد في ذاك هدي المليم % % PageV01P4457 البحر : - 1(@)(@@) % واتر ظالم وناقض وتر % أي هذين يستحق 
ms1175	 الندامه % 2(@)(@@) % أحليم أصاب منه سفيه % فاسترد الحليم منه الظلامه % 3(@)(@@) % أم سفيه أصاب عرض حليم % % فأصاب السفيه طفر عرامه % 4(@)(@@) % خالد اللؤم أنت هيجت حربي % % ولقد كنت وادعا في سلامه % % 5(@)(@@) % فاشتريت السهاد بالنوم جهلا % % ورئمت الهوان بعد الكرامه % % PageV01P4458 البحر : - 1(@)(@@) % تعرض لي دونه معشر % كرام وما ذاك أن أكرموه % 2(@)(@@) % ولكنهم أعظموا منطقي % % وكان جديرا بأن يعظموه % % 3(@)(@@) % فصانوا هجائي عن عرضه % % بأعراضه شد ما استلأموه % % 4(@)(@@) % لئن رحموا الشعر من لؤمه % % لحق وحقوا بأن يرحموه % % PageV01P4459 البحر : - 1(@)(@@) % يا نبي الله في الشع % % ر ويا عيسى بن مريم % 2(@)(@@) % أنت من أشعر خلق ال % % له ما لم تتكلم % % 3(@)(@@) % إن من يزعم أن لي % % س إلى العيوق سلم % % 4(@)(@@) % لو رأى قرن الحريثي % ي استحى أن يترمم % % PageV01P4460 البحر : - 1(@)(@@) % كأن أباه حين واقع أمه % % أتاها وفي إحليله كوز بلغم % 2(@)(@@) % فجاءت به قردا قبيحا مقبحا % على ما به من قلة وتبظرم % % PageV01P4461 البحر : - 1(@)(@@) % و فتى يمنع الطعا % % م ولا يمنع الحرم % % 2(@)(@@) % فجميع النساء في ال % حل والمطبخ الحرم % % PageV01P4462 البحر : - 1(@)(@@) % رأت عينيلمنكرة قواما % % ووجها يشبه البدر التماما % % 2(@)(@@) % فلم أبرح صريع هوى كأني % % شربت به معتقة مداما % % 3(@)(@@) % شكا قلبي جناية طرف عيني % % وقال رأى فأغرى بي غراما % % 4(@)(@@) % فقلت وقد جنى شرا عليه % % ألست تراه قد هجر المناما % % 5(@)(@@) % فقال الجسمأشكو ذا وهذا % % فإنهما أعاراني سقاما % % 6(@)(@@) % فقلت ثلاثة كل جناه % أقام بكم بلاؤكم وداما % % 7(@)(@@) % فطرفي ساهر والجسم مضنى % وقلبي ليس يبرح مستهاما % % 8(@)(@@) % ومنكرة تظن الحب لعبا % وقد قعد الهوى فيها وقاما % % 9(@)(@@) % أظن اليوم قد غابته شهرا % وشهرا لا أراها فيه عاما % % 10(@)(@@) % تحل بقرية النعمان عمدا % تطيل بها على رغمي المقاما % % PageV01P4463 11(@)(@@) % رمى الرحمن مولاها بموت % وعجل لي من الوعد انتقاما % % 12(@)(@@) % لئن نعمت لما رثت حبال % لها عندي ولا أمست رماما % % 13(@)(@@) % ولكني أجدد كل يوم % بها وجدا وشوقا واهتماما % % 14(@)(@@) % بقلبي جمرة للشوق تذكى % % تزيد على تباعدها اضطراما % % 15(@)(@@) % ترى 
ms1176	 الأيام تدني بعد بعد % وتعطينا اجتماعا والتئاما % % 16(@)(@@) % وتشفي من جوى الأبراح صبا % يكاد يموت س قما واغتماما % % 17(@)(@@) % فكفا بالذي أبلى وعافى % % عن المشغول بالحب الملاما % % 18(@)(@@) % تراني أبدع العشاق عشقا % وأول هائم في الحب هاما % % PageV01P4464 البحر : - 1(@)(@@) % أقام مشيبي علي القيامه % وعممني منه أخزى عمامه % 2(@)(@@) % فأفسد بيني وبين الملاح % % وأوحش مني كؤوس المدامه % % 3(@)(@@) % ظلمت ولا حاكم عادل % % على الشيب يسمع مني الظلامه % % 4(@)(@@) % ولما رأيت سهام المشيب % % جعلت الخضاب مجنا ولامه % % 5(@)(@@) % وما زلت ألطف في حيلة % تعيد الشبيبة لي والوسامه % % 6(@)(@@) % تبينت منذ خضبت المشي % % ب بعد اعوجاج أموري استقامه % % 7(@)(@@) % وعادت إلي خلال الشباب % % جميعا سوى فتكه والعرامه % % 8(@)(@@) % سوادك فيه دليل على % % شباب وفيه عليه علامه % % 9(@)(@@) % ستندم إن أنت لم تختضب % % فسود خضابك قبل الندامة % % 10(@)(@@) % ولا تلحني في طلاب الشباب % % فنفسي به لم تزل مستهامه % % PageV01P4465 البحر : - 1(@)(@@) % سلني قد مللت طول الغرام % واحتمال الأحزان والأسقام % 2(@)(@@) % اسقني سلوة فإن أنت لم تق % % در عليها فداوني بالمدام % % 3(@)(@@) % ربما كان في المدام شفاء % للمحبين من جوى وغرام % % 4(@)(@@) % يعجز العقل من ذوي العقل عما % % يتأتى لغيرهم بالكلام % % 5(@)(@@) % ليس لي في جوار صاحبة الصد % غ مع الهجر والجفا من مقام % % 6(@)(@@) % قد سقتني من عينها كأس وجد % فعلت في فعل كأس المدام % % 7(@)(@@) % أسكرتني سكر الشمول من الخم % % ر ودبت دبيبها في عظامي % % 8(@)(@@) % إن ما لا يكون نقصان وجدي % % كيف أرجو نقصان ما هو نامي % % 9(@)(@@) % كل يوم يزيد وجدي وشوقي % % وغرامي وصبوتي وهيامي % % 10(@)(@@) % ليس من حيلة تنهنه عني ال % وجد إلا غروب دمع سجام % % PageV01P4466 11(@)(@@) % فاستعن بالدموع وافزع إليها % % فهي عون للعاشق المستهام % % 12(@)(@@) % إن يكن داني الهوى فتيقن % أنه منذ كان داء الكرام % % PageV01P4467 البحر : - 1(@)(@@) % أفسدت توبتي عليغلام % غصن ناعم وبدر تمام % % 2(@)(@@) % يفضح البدر وجهها مستتما % والقضيب الرطيب منها القوام % 3(@)(@@) % كعبة النيك للزناة بها في % % كل يوم وليلة استلام % 4(@)(@@) % وهي أنثى وما تثنت تمشى % % قط 
ms1177	 إلا بدا لعيني غلام % % 5(@)(@@) % عجبا من سقام عينيك تضني % % ويداوى بها الضنى والسقام % % 6(@)(@@) % امزج الراح لي بريق غلام % % فألذ الهوى المعاصي التؤام % % 7(@)(@@) % تسكر الخمر شاربيها وخمر الر % ريق يصحو بشربها المستهام % % 8(@)(@@) % فوق خدي لجة من دموع % يغرق الصبر وسطها والملام % 9(@)(@@) % لن يطيب الهوى إذا لم ينره % % وتسدي أثوابه الآثام % % 10(@)(@@) % لست مستعذبا وصال حبيب % أو ترى فيه لي ذنوب عظام % % PageV01P4468 11(@)(@@) % ما ملكت الهوى وما ذقت فيه % % فتساوى حلاله والحرام % % 12(@)(@@) % حله بارد فما كان لي من % ذ كنت فيه بما يحل غرام % % 13(@)(@@) % فحلال الهوى نبذ مدار % وحرام الهوى شمول مدام % % 14(@)(@@) % من أطال ارتضاع أخلاف لهو % شق فيما أرى عليه الفطام % % 15(@)(@@) % فت بلذاتك العواذل والعذ % ل وإلا فاتت بها الأيام % 16(@)(@@) % سيمحي الذنوب منك صلاة % وخضوع وخيفة وصيام % % 17(@)(@@) % من قس الجحيم ظني جلدا % قد كساه أثوابه الإسلام % % PageV01P4469 البحر : - 1(@)(@@) % أفي هوى يوسف ألام % بدر تجلى له الظلام % 2(@)(@@) % للغصن منه إذا تثنى % % في مشيه اللين والقوام % % 3(@)(@@) % يدير من طرفه كؤوسا % % تفعل ما تفعل المدام % 4(@)(@@) % بعارضيه رياض حسن % للنور من زهرها ابتسام % % 5(@)(@@) % من زغبات منظمات % % في خده زانها النظام % % 6(@)(@@) % والشعر نقص لكل خد % % والشعر في خده تمام % % 7(@)(@@) % لها وما إن لهوت عنه % ونام عني وما أنام % % 8(@)(@@) % يدنو فإن رمت منه نيلا % أعياك في نيله المرام % % 9(@)(@@) % تملك مني القياد سلمى % % ولا كما يملك الغلام % % 10(@)(@@) % يا ليته ليلة ضجيعي % % وللعدى آنف رغام % % PageV01P4470 11(@)(@@) % أضمه بعد لثم فيه % إلى حشا حشوه الغرام % % 12(@)(@@) % يقنعني منه حين ينأى % % في عيشتي زورة لمام % % 13(@)(@@) % ليس على عاشق تمنى % % زورة معشوقه آثام % % 14(@)(@@) % إن الذي شفني هواه % يحل في مثله الحرام % % PageV01P4471 البحر : - 1(@)(@@) % كان هزلا فعاد جدا غرامي % % وعذاب الهوى غلام غلام % 2(@)(@@) % أمرت قدها يقود إليها ال % قلب مني فقاده بزمام % % 3(@)(@@) % لو سألت القضيب قال ولم % % يكذبك منها استعرت حسن القوام % % 4(@)(@@) % جمعت طرة وقدا ووجها % ونهودا ونغمة 
ms1178	 في نظام % % 5(@)(@@) % فهي أولى في الوضف إن صدق الوص % ف من البدر بالبها والتمام % 6(@)(@@) % اسقني من مدام ريقتها العذ % بة إذ قد حرمت شرب المدام % % 7(@)(@@) % فمدام الكروم غير حلال % % وهي تسقي المدام غير حرام % % 8(@)(@@) % وترشف منها لمى فهو كأس % ليس في شرب خمرها من آثام % % 9(@)(@@) % ما أرى لي في ربع حب إذا لم % % أحظ فيه بنائل من مقام % % 10(@)(@@) % وعدتني وعدا فهاجت حروبا % % بين عيني فيه وبين المنام % % PageV01P4472 11(@)(@@) % بت شر المبيت ما ذقت غمضا % طول ليل والليل ليل تمام % % 12(@)(@@) % صيرت لي اللقاء في كل شهر % وأراه يصير في كل عام % % 13(@)(@@) % ليس في العالمين أسوأ حالا % من محب بقينة مستهام % % 14(@)(@@) % شارب طول دهره كأس غيظ % وعتاب ما ينقضي واهتمام % 15(@)(@@) % سأسلي نفسي وأسبق يأسا % لسلوي ملامة اللوام % % PageV01P4473 البحر : - 1(@)(@@) % قولا لقرة عيني % % سميت أو لم أسمي % % 2(@)(@@) % كم قلت عند بكائي % % أصبت عيني بكمي % % 3(@)(@@) % حتى يقول جليسي % % علي أيضا تعمي % % PageV01P4474 البحر : - 1(@)(@@) % خذي وصالي فإنني رجل % أود ود العفاف والكرم % 2(@)(@@) % أنسى نصيبي من الفتاة سوى % % نصيب عيني وناظري وفمي % % 3(@)(@@) % ليس يحب الكرام من شبق % % ولا يصيد الملوك من قرم % % PageV01P4475 البحر : - 1(@)(@@) % إن امرأ رفض المكاسب واغتدى % % يتعلم الآداب حتى أحكما % % 2(@)(@@) % فكسا وحلى كل اروع ماجد % من خير ما حاك الضمير ونظما % % 3(@)(@@) % متشاغلا عما يمارس غيره % حتى لقد أثرى اللئام وأعدما % % 4(@)(@@) % ثقة برعي الأكرمين حقوقه % % لأحق ملتمس بأن لا يحرما % % PageV01P4476 البحر : - 1(@)(@@) % ولقد يظن بي الغيور ظنونه % % فيحوز جل ظنونه آثاما % % 2(@)(@@) % أبدي ظواهر تحتها إن فتشت % مني بطائن تكذب الإيهاما % % PageV01P4477 البحر : - 1(@)(@@) % للنرجس الفضل برغم من رغم % على صنوف الورد والفضل قسم % % 2(@)(@@) % العين قبل السن وهي المبتسم % % فما لها والخد وهي الملتدم % 3(@)(@@) % ما هو إلا نعمة من النعم % % ما أحسن الشكل وما أذكى النسم % % PageV01P4478 البحر : - 1(@)(@@) % عاد عودي إلى ثراه القديم % وصفت لذتي وطاب نعيمي % % 2(@)(@@) % وتنسمت من مشارق بغدا % % د نسيما يشفي رداع 
ms1179	 السقيم % % PageV01P4479 البحر : - 1(@)(@@) % أعمل فيهم ذكرا حساما % % عضب الغرارين يقد الهاما % % 2(@)(@@) % كأن في صفحته غماما % % وبي يسمى ذكرا حساما % % PageV01P4480 البحر : - 1(@)(@@) % ثلاثة أشياء في اثنين منهما % % رضائي وسخطي في المثلث منهما % % 2(@)(@@) % هما برد يأس أو حلاوة نائل % % وما أقبح الميعاد عندي والأما % % PageV01P4481 البحر : - 1(@)(@@) % ليس تغني الشعر الأسود شيئا % إذا استشن الأديم % 2(@)(@@) % أفيرجو مسود أن يزكى % % شاهد الخطر أين ضل الحليم % 3(@)(@@) % لا لعمري ما للخضاب لذي الأب % صار إلا التكذيب والتأثيم % 4(@)(@@) % يدعى للكبير شرخ شباب % قد تولى به الزمان البهيم % % 5(@)(@@) % والسواد المخضوب أوجب تكذي % % با كذب السواد الصميم % % PageV01P4482 البحر : - 1(@)(@@) % شربت الراح مرتاحا إليها % % ولم أجنح إلى حث النديم % 2(@)(@@) % مشعشة حياة الروح فيها % % وعنها صحة البدن السقيم % % 3(@)(@@) % إذا ما الهم أضرم فيك نارا % فصب عليه من ماء الكروم % % 4(@)(@@) % فلا أشفى لدائك من شمول % ولا أطفى لنيران الهموم % % PageV01P4483 البحر : - 1(@)(@@) % فلو أني وليت الحكم يوما % ووليت العقوبة والخصاما % % 2(@)(@@) % لقرت عين من يهوى الجواري % % وعاقبت الذي يهوى الغلاما % % 2(@)(@@) % مص % % أجنت لك الوجد أغصان وكثبان % 3(@)(@@) % فيهن نوعان تفاح ورمان % وفوق ذينك أعناب مهدلة % 3(@)(@@) % سألتك أيما أشجى حديثا % % وأطيب حين يعتنق التزاما % % 4(@)(@@) % سود لهن من الظلماء ألوان % % وتحت هاتيك أعناب تلوح به % % 4(@)(@@) % أجارية مغنجة رداح % تزيدك للغرام بها غراما % % 5(@)(@@) % أم آمرد قد أجاف الإبط منه % % له أير كأيرك حين قاما % % 5(@)(@@) % أطرافهن قلوب القوم قنوان % غصون بان عليها الدهر فاكهة % 6(@)(@@) % يريدك للدارهم لا لشيء % وتلك تذوب عشقا واهتماما % % PageV01P4484 6(@)(@@) % وما الفواكه مما يحمل البان % ونرجس بات ساري الطل يضربه % 7(@)(@@) % وأقحوان منير النور ريان % % ألفن من كل شيء طيب حسن % 8(@)(@@) % فهن فاكهة شتى وريحان % % ثمار صدق إذا عاينت ظاهرها % % 9(@)(@@) % لكنها حين تبلو الطعم خطبان % % بل حلوة مرة طورا يقال لها % % 10(@)(@@) % شهد وطورا يقول الناس ذيفان % % يا ليت شعري وليت غير مجدية % 11(@)(@@) % إلا استراحة قلب وهو أسوان % % لأي أمر مراد بالفتى جمعت % % 12(@)(@@) % تلك 
ms1180	 الفنون فضمتهن أفنان % % تجاورت في غصون لسن من شجر % 13(@)(@@) % لكن غصون لها وصل وهجران % % تلك الغصون اللواتي في أكمتها % % 14(@)(@@) % نعم وبؤس وأفراح وأحزان % % يبلو بها الله قوما كي يبين له % 15(@)(@@) % ذو الطاعة البر ممن فيه عصيان % % وما ابتلاهم لإعنات ولا عبث % % PageV01P4485 16(@)(@@) % ولا لجهل بما يطويه إبطان % لكن ليثبت في الأعناق حجته % 17(@)(@@) % ويحسن العفو والرحمن رحمن % % ومن عجائب ما يمنى الرجال به % % 18(@)(@@) % مستضعفات له منهن أقران % % مناضلات بنبل لا تقوم له % % 19(@)(@@) % كتائب الترك يزجيهن خاقان % % مستظهرات برأي لا يقوم به % % 20(@)(@@) % قصير عمرو ولا عمرو ووردان % % من كل قاتلة قتلى وآسرة % 21(@)(@@) % أسرى وليس لها في الأرض إثخان % يولين ما فيه إغرام وآونة % 22(@)(@@) % يولين ما فيه للمشعوف سلوان % % ولا يدمن على عهد لمعتقد % % 23(@)(@@) % أنى وهن كما شبهن بستان % % يميل طورا بحمل ثم يعدمه % % 24(@)(@@) % ويكتسى ثم يلفى وهو عريان % % حالا فحالا كذا النسوان قاطبة % 25(@)(@@) % نواكث دينهن الدهر أديان % % يغدرن والغدر مقبوح يزينه % % PageV01P4486 26(@)(@@) % للغاويات وللغافين شيطان % % تغدو الفتاة لها حل فإن غدرت % 27(@)(@@) % راحت ينافس فيها الحل خلان % % ما للحسان مسيئات بنا ولنا % % 28(@)(@@) % إلى المسيئات طول الدهر تحنان % % يصبحن والغدر بالخلصان في قرن % % 29(@)(@@) % حتى كأن ليس غير الغدر خلصان % % فإن تبعن بعهد قلن معذرة % % 30(@)(@@) % إنا نسينا وفي النسوان نسيان % % يكفي مطالبنا للذكر ناهية % 31(@)(@@) % أن اسمنا الغالب المشهور نسوان % % لا نلزم الذكر إنا لم نسم به % % 32(@)(@@) % ولا منحناه بل للذكر ذكران % % فضل الرجال علينا أن شيمتهم % 33(@)(@@) % جود وبأس وأحلام وأذهان % % وأن فيهم وفاء لا نقوم به % % 34(@)(@@) % ولن يكون مع النقصان رجحان % % لا ندعي الفضل بل فينا لطائفة % 35(@)(@@) % منهم أبو الصقر تسليم وإذعان % % هو الذي توج الله الرجال به % % PageV01P4487 36(@)(@@) % تيجان فخر وللتفضيل تيجانن أجنت لك الوجد أغصان وكثبان % فيهن نوعان تفاح ورمان % 37(@)(@@) % وفوق ذينك أعناب مهدلة % سود لهن من الظلماء ألوان % % 38(@)(@@) % وتحت هاتيك أعناب تلوح به % % أطرافهن قلوب القوم قنوان % 39(@)(@@) % غصون 