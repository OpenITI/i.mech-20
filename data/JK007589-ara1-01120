ms1101	 % 295(@)(@@) % لمن أضحى لعلته احتدام % % له العفوات من شعري بعرف % 296(@)(@@) % إلى العفوات منه والجمام % % أخ كم بات ضيفي في قراه % % 297(@)(@@) % قرير العين ليس به اعتمام % % وقد أجممته زمنا وأنى % % 298(@)(@@) % وليس يفارق البحر الجمام % % وحق علي إهداء اعتذار % 299(@)(@@) % وإن لم يهد لي منه اتهام % % إليك أبا الحسين أقود قولا % 300(@)(@@) % له من حبلك الألوى خطام % % شهدت لقد منحتك صفو ودي % % PageV01P4204 301(@)(@@) % ولا لوم علي ولا أثام % وما قصرت في التأميل كلا % % 302(@)(@@) % ولا أمسيت عن حقي تنام % جعلتك قبلة الآمال مني % % 303(@)(@@) % فهن مصليات لاصيام % % وكيف تصوم آمال غراث % 304(@)(@@) % ونائلك الهنيء لها طعام % % طعام لا وخامة فيه تخشى % % 305(@)(@@) % وفي المعروف أطعمة وخام % % وكنت إذا أنخت إليك عيسى % % 306(@)(@@) % وآمالي غراث أو عيام % % أنخت بحيث تبيض الأيادي % % 307(@)(@@) % وتسود المطابخ والبرام % % خلا أني أهابك لا لسوء % % 308(@)(@@) % كما تتهيب البحر الهيام % % ويملكني حيائي حين تربي % % 309(@)(@@) % على شكري دسائعك الضخام % % ألم تر أننا لما التقينا % % 310(@)(@@) % فغنتني صنائعك الجسام % % رأيت الشكر قد ضعفت قواه % % PageV01P4205 311(@)(@@) % فشمر للفرار ولا يلام % % وكنت الغالب المنصور جندا % % 312(@)(@@) % إذا لاقى تذممك الذمام % % وما تنفك تغلب كل شكر % 313(@)(@@) % بعرف ما لعروته انفصام % % وذاك بأن أبيح فليس يحمى % % 314(@)(@@) % وليس بأن أعز فما يرام % % وكنت إذا نوى المحسان ظعنا % % 315(@)(@@) % عن الحسنى فنيتك المقام % % فإن راث اللفاء فلا تلمني % % 316(@)(@@) % فإن تخلفي عنك انهزام % ووكدك طرد زورك بالعطايا % % 317(@)(@@) % كذلك يطرد الزور الكرام % وكم تبع المولي منك سيب % 318(@)(@@) % فلم يقدر له منه انعصام % غمام جد في آثار سار % 319(@)(@@) % أغد سرى فأدركه الغمام % % وهل ينجو من الركبان ناج % 320(@)(@@) % وطالبه الغمام أو الظلام % % شكوت نداك لا أن قل لكن % % PageV01P4206 321(@)(@@) % لأن كثرت أياديه العظام % % وأني قد بعلت به فأضحى % % 322(@)(@@) % كأن مغانمي منه غرام % % كما يشكو امرؤ طغيان سيل % 323(@)(@@) % تساوى الوهد فيه والأكام % % وما أشكوه منك إلى رحيم % % 324(@)(@@) % وشكري في ذراه مستضام % % وما لم تهتضم شكري بطول % 325 
ms1102	(@)(@@) % فليس ينالني منك اهتضام % % ولست بمعتبي من بدء عرف % 326(@)(@@) % بغير العود ماسجع الحمام % % فعاود كيف شئت فلست أشكو % % 327(@)(@@) % وهل يشكو الندى إلا اللئام % % ومامعروفك الممدود عني % % 328(@)(@@) % بمنقطع إذا انقطع الكلام % % خدعتك وانخداعك لي خليق % 329(@)(@@) % على الله الزيادة والتمام % % وقلت كأنني يوم بسيل % 330(@)(@@) % لأعلاه وأسفله التطام % % ولم أبرم بعرفك غير أني % % PageV01P4207 331(@)(@@) % برمت بحمل شكرك والسلام % % وكم أنطقتني بلهى توالت % % 332(@)(@@) % وما صمتي وللقول انتظام % وكم أسكتني بلهى تغالت % % 333(@)(@@) % وما نطقي وللبحر التطام % وما ينفك يلحمنا ويجري % % 334(@)(@@) % ندى لك لا ينهنهه لجام % يبر فنستكين وغير نكر % 335(@)(@@) % إذا شب الجلاد خبا اللطام % % وما أعطيت إلا ارتاش حر % % 336(@)(@@) % وأطرق والحياء له كعام % % تسد فقورنا وتغض منا % % 337(@)(@@) % فنستعفي هناك ونستذام % % ونلقى منك محتقر الهاه % 338(@)(@@) % وحول أخسها قدرا يحام % % بنى لاحاتم كان ابتناها % % 339(@)(@@) % ولا أوس وحارثة ولام % % ولكن كسروي ذو فعال % 340(@)(@@) % له بدء وليس له اختتام % % فيا عجبي أأستحيي لعجزي % % PageV01P4208 341(@)(@@) % وفيك لأن تسامحني اغتنام % % تحب الشكر لا ما كد حرا % % 342(@)(@@) % بل المجرى يعاقبه المصام % % متى ناقشت ذا شكر حسابا % % 343(@)(@@) % فيدخلني من العجز احتشام % % ألست المرء يكرم في حياء % % 344(@)(@@) % كأن صنيعك الحسن اجترام % % ويكتم عرفه فيفوح منه % % 345(@)(@@) % وليس لساطع المسك اكتتام % % ونبخس شكره فله اغتفار % 346(@)(@@) % ونظلم ماله فله اظطلام % % بلى فسقاك ربك حيث تسقى % % 347(@)(@@) % جحاجحة المروءة لا الطغام % فقد يسقى الرجال وهم رسوم % 348(@)(@@) % وقد يرعى الرجال وهم سوام % غدا الساعون خلفك في المعالي % % 349(@)(@@) % كمثل الصف يقدمه الإمام % % وسامني الزمان رجال مجد % 350(@)(@@) % فكنت نصيتي فما أسام % % أهلة أسعد ونجوم يمن % % PageV01P4209 351(@)(@@) % ولكن بذها قمر تمام % % ومن يخترك لا يحمد وأنى % % 352(@)(@@) % وقد هدى توسمه الوسام % % وليس وإن عداه الحمد ممنه كبرت فغيرك الغر الغلام % 353(@)(@@) % وغير قناعك الجعد السخام % وأمسى ماء وجهك غاض عنه % % 354(@)(@@) % فماء شؤونك الفيض السجام % % وأصبحت الظباء مجانبات % 355(@)(@@) % جنابك مالها فيه بغام % وقد يألفنني ومعي سهامي % % 356(@)(@@) % فما هذا 
ms1103	 النفار ولاسهام % % أأوحشها وقد نصلت نبالي % % 357(@)(@@) % وأونسها وفي نبلي الحمام % % ليالي لاتزال لدي صرعى % % 358(@)(@@) % لرشقي في مقاتلها احتكام % % ألا جاد الحيا تلكم ظباء % 359(@)(@@) % تزينها المقاصر لا الخيام % % عتقن فهن من قرب ملاح % 360(@)(@@) % ورقن فهن من بعد فخام % % إلى الله الشكاة من اللواتي % % PageV01P4210 361(@)(@@) % مساكنها الرصافة لا الرجام % % بحيث تجبح الهدي قذما % % 362(@)(@@) % وهاشم الأكارم لا هشام % % مريضات الجفون لغير داء % 363(@)(@@) % لمن لابسنه الداء العقام % % سقام عيونهن سقام قلبي % % 364(@)(@@) % وقد يهدي السقام لك السقام % % أعاذلتي وحبلي قد تداعى % % 365(@)(@@) % وللحبل اتصال وانجذام % كأن مناعمي حلم تقضى % % 366(@)(@@) % وأسراري مع الخلل احتلام % % كسيت البيض أخلاقا رماما % % 367(@)(@@) % فوصل البيض أخلاق رمام % % فلا يتشتتن عليك رأي % 368(@)(@@) % فما للبيض والبيض التئام % % بليت سوى المشيب غدا جديدا % % 369(@)(@@) % علي الفد منه والتؤام % وكنت كروضة للعين أضحت % 370(@)(@@) % وما من نورها إلا النغام % % وعبست الحسان إلى مشيبي % % PageV01P4211 371(@)(@@) % فما لثغورها برق يشام % % وما يرجى من البيض ابتسام % 372(@)(@@) % لمن أمسى لمفرقه ابتسام % % كأن محاسني لم تضح يوما % % 373(@)(@@) % وفي لحظاتهن لها اقتسام % % كأني لمأر اللمحات نحوي % % 374(@)(@@) % وفي اللمحات لثم والتزام % % لئن ودعت جهلي غير قولي % % 375(@)(@@) % ألا سقيت معاهدنا القدام % لقد يهتزلي غصن رطيب % 376(@)(@@) % وقد يرتج لي دعص ركام % % ويسقيني شفاء النفس ثغر % 377(@)(@@) % ويسقيني شفاء الوجد جام % % ويسمعني رقاة الهم شدوا % % 378(@)(@@) % تغادر كل يوم وهو رام % سماع إن أردت إدام عيش % % 379(@)(@@) % فذاك من السماع له إدام % % عجيب كالحبيب له هنات % 380(@)(@@) % بها يشفى الجوى وبها يهام % % بأخضر جاده طل ووبل % PageV01P4212 381(@)(@@) % وما جرمته بينهما الرهام % % غواد لاتفرط أو سوار % 382(@)(@@) % روائم لا يزال لها رزام % % فوردته وشقرته احمرار % 383(@)(@@) % وحمرته وخضرته ادهمام % تقسم أمره شجر وروض % 384(@)(@@) % عليه من زواهره فدام % كساه الغيث كسوته فأضحى % % 385(@)(@@) % له منها ائتزار واعتمام % % يظل وللرياح به اصطخاب % % 386(@)(@@) % وللعجم الفصاح به اختصام % % وللقضب اللدان به اعتناق % 387(@)(@@) % وللأنوار فيهن التئام % % تراه إذا تجاوب طائراه % 388(@)(@@) % تجاوب عثعثا 
ms1104	 فيه زنام % حمام الأيك يسعده هزار % 389(@)(@@) % فدى المكاء ذينك والسمام % % وأخلاط من الغردات شتى % % 390(@)(@@) % حواسر أو عليهن الكمام % % ألا لا عيش لي إلا زهيدا % % PageV01P4213 391(@)(@@) % ودون لثام من أهوى لثام % % وكم نادمت راح الروح فاه % 392(@)(@@) % ولكن خانني ذاك الندام % % كأني لم أبت أسقى رضابا % 393(@)(@@) % يموت به ويحيا المستهام % % تعللنيه واضحة الثنايا % % 394(@)(@@) % كأن لقاءها حولا لمام % % تنفس كالشمول ضحى شمال % 395(@)(@@) % إذا ما فض عن فمها الختام % % وتسقيك الذي يشفي ويدوي % % 396(@)(@@) % ففي الأحشاء برد واضطرام % وقالوا لو أدار الراح كانت % % 397(@)(@@) % له عوضا وفارقه الهيام % فقلت مدام أفواه الغواني % % 398(@)(@@) % مدام لا يعادله مدام % عزاؤك عن شباب نال منه % % 399(@)(@@) % رمان فيه لين واعتزام % % فقبلك قام أقوام قعود % 400(@)(@@) % لريب الدهر أوقعد القيام % % وما ينفك يلقى الكره فيه % PageV01P4214 401(@)(@@) % فئام قد تقدمه فئام % % إذا أدار على بني حام وسام % 402(@)(@@) % كؤوسا مرة حام وسام % % نهار شكله في اللون سام % 403(@)(@@) % وليل شكله في اللون حام % % وهذا الدهر أطوار تراها % % 404(@)(@@) % وفيها الشهد يجنى والسمام % % فأعوام كأن العام يوم % 405(@)(@@) % وأيام كأن اليوم عام % % كدأب النحل أري أو حمات % 406(@)(@@) % ودأب النخل شوك أو جرام % % ولاتجزع فصرف الدهر كلم % 407(@)(@@) % وتعفية وإن دميت كلام % % سيسليك الشبيبة أريحي % 408(@)(@@) % بجود يديه أورقت السلام % % يحل من المكارم والمعالي % % 409(@)(@@) % بحيث الرأس منها والسنام % % له ذكر إليها مستراح % 410(@)(@@) % وناحية إليها مستنام % % مدبر دولة وقوام ملك % PageV01P4215 411(@)(@@) % كهمتك المدبر والقوام % % يروقك أو يروعك لابظلم % % 412(@)(@@) % كما يتلون السيف الحسام % % يضاحك تارة ويكون أخرى % % 413(@)(@@) % بحيث تهزه قصر وهام % % فآونة لصفحته انبلاج % 414(@)(@@) % وآونة لشفرته اصطلام % % أخو قلم صروف الدهر منه % % 415(@)(@@) % ففيه العيش والموت الزؤام % % كتابته مناقفة العوالي % % 416(@)(@@) % وليست ما يرقشه القلام % % ضئيل شأنه شأن نبيل % 417(@)(@@) % يطوع لأمره الجيش اللهام % به تبدو الصوارم حين تخفى % % 418(@)(@@) % وتخفى حين تبدو والخدام % % إذا سكنات صاحبه أملت % 419(@)(@@) % على حركاته سكن الأنام % % أخو ثقة إذا الأقلام أضحت % 420(@)(@@) % بني حمان 
ms1105	 عمهم الزكام % % أمين في معابيه أمون % PageV01P4216 421(@)(@@) % سليم الأنف ليس به زكام % % تمج الفيء والمعروف مجا % % 422(@)(@@) % وللأقلام حطم وانتقام % % بكف فتى له نفع وضر % 423(@)(@@) % وإنعام يؤمل وانتقام % يقلبه برأي لاتجزا % % 424(@)(@@) % ولايخبو لقدحته ضرام % % وزير للوزير يرى فيغني % % 425(@)(@@) % إذا طرقت مجلحة جلام % % له عزم إذا نفذ ارتياء % 426(@)(@@) % وإمضاء إذا وقع اعتزام % % فما لعزيمة منه انفلال % 427(@)(@@) % ولا لضريمة منه اقتحام % % ولا في عقدة منه انحلال % 428(@)(@@) % ولا في عروة منه انفصام % % متى ما انشام في غيب صواب % 429(@)(@@) % نعاه ابن الحسين فلا انشيام % % يبيت أبو الحسين يرى أمورا % 430(@)(@@) % لها في سدفة الغيب اكتمام % % يراه أبو الحسين وإن توارى % % PageV01P4217 431(@)(@@) % بعين لا تكل ولاتنام % % ولولا حمله الأثقالأضحت % % 432(@)(@@) % ظهور معاشر ولها انحطام % % ولكن قد تحملها ضليع % 433(@)(@@) % له في الخطب حزم واحتزام % % محمد بن أحمد بن يحيى % % 434(@)(@@) % لأنف عدو نعمته الرغام % % وغرس الأصبغي كفاك غرسا % % 435(@)(@@) % إذا غرس الهشيم أو الحطام % % تخيره الوزير وزير صدق % 436(@)(@@) % وللوزراء خبط واعتيام % % فرأفته بنا فوق التمني % % 437(@)(@@) % إذا كثر التغطرس والعرام % % ونائله لنا فلنا اقتراع % 438(@)(@@) % على نفحاته ولنا استهام % % ولاعات يصول على ضعيف % 439(@)(@@) % صيال الفيل هاج به اغتلام % % نساس ولانجاس وكم عداء % 440(@)(@@) % غدا لمآثم منه الندام % % وقد نحدى كما تحدى المطايا % % PageV01P4218 441(@)(@@) % وقد نرعى كما ترعى البهام % % فتى ضامت يداه الدهر حتى % % 442(@)(@@) % تعز به المضيم فما يضام % % يزيدك كلما أغليت حمدا % % 443(@)(@@) % به ربحا وفيه لك انهضام % كذا أخلاق مبتاعي المعالي % % 444(@)(@@) % ترفع كلما رفع استيام % % يجود فجوده كرم ودين % 445(@)(@@) % بعض الجود بذخ أو وئام % % تناهب ماله شرق وغرب % 446(@)(@@) % ولما يعفه يمن وشام % % فأصبح والثناء عليه فرض % 447(@)(@@) % على هذا الورى حتم لزام % % جديرا أن يحوز الحمد عفوا % 448(@)(@@) % إذا ماعز من حمد مرام % % بمال لا يشد عليه عقد % 449(@)(@@) % وجاه لا يحل له حزام % % أقامهما لملتمس جداه % 450(@)(@@) % كريم للكرام به ائتمام % % تقاسم وجهه ويداه منه % % PageV01P4219 451(@)(@@) % محاسن لا يعفيها القتام 
ms1106	 % % فأقسام المكارم في يديه % 452(@)(@@) % وللوجه الوضاءة والقسام % فليست تشرق الآفاق إلا % % 453(@)(@@) % إذا طلعت محاسنه الوسام % % رأى الضليل قصد هداه فيه % % 454(@)(@@) % وأسهب في ممادحه العبام % % مكارمه إذا ذكرت جبال % 455(@)(@@) % وكم قوم مكارمهم رضام % % تعودت المحامد والعطايا % % 456(@)(@@) % أنامل منه نائلها انسجام % % فليس لها عن الحمد انفراج % 457(@)(@@) % وليس لها على المال انضمام % % لبدأته حيا ومتى عرضنا % % 458(@)(@@) % لعودته فليس لها جهام % % يبادر أن يصل المال حتى % % 459(@)(@@) % كأن المال يملكله لحام % % وليس يصل صفو التبر لكن % % 460(@)(@@) % له في ماله حد هذام % % وليس أمام نائله عبوس % PageV01P4220 461(@)(@@) % وليس وراءه منه ندام % % يساقطه الندى حتى تراه % 462(@)(@@) % وليس لجانب منه ادعام % % ويمسكه الحجا حتى تراه % % 463(@)(@@) % ومافي جانب منه انثلام % % لذلك لاتزال له عطايا % % 464(@)(@@) % لهن على مؤمله ازدحام % % كما ليست تزال له دواة % 465(@)(@@) % لداه في مهالكها ارتطام % % وبادي الجهل جاوده فقلنا % % 466(@)(@@) % متى استعلى على النخل البشام % % وساهي العقل ناجده فقلنا % % 467(@)(@@) % متى أربى على النبع الثمام % % أما وأبي الحسين فداه قوم % 468(@)(@@) % لهم نعم وأكثرهم نعام % % لمولني إلى أن قال أهلي % % 469(@)(@@) % أأحلام يخيلها منام % % وقومني إلى أن قام عودي % % 470(@)(@@) % فما في متنه أود يقام % % برأي لست أبرح منه أضحى % % PageV01P4221 471(@)(@@) % وجود لا أزال له أغام % % نفت جهلي نهاه وشيبتني % % 472(@)(@@) % لهاه فها أنا الكهل الغلام % % فدته النفس من بان كريم % % 473(@)(@@) % مبانيه المكارم لا الرخام % % بني لي همتي حتى تعالت % 474(@)(@@) % وكانت مرة وهي اهتمام % % أسائلتي حججت البيت إني % % 475(@)(@@) % حججت فتى المروءة يا أدام % % حججت أبا الحسين وكان حجي % % 476(@)(@@) % إليه لا يذم ولا يذام % % أقبل كفه وأعل منها % % 477(@)(@@) % ندى يشفى به مني الأوام % % فلي من بطن راحته ارتواء % % 478(@)(@@) % ولي في ظهر راحته استلام % % ظللت بمأمن منه حريز % 479(@)(@@) % يخيل أنه البيت الحرام % % وزمزم والحطيم لدي منه % % 480(@)(@@) % هنالك والمشاعر والمقام % % مقام تنشد الأمداح تترى % % PageV01P4222 481(@)(@@) % ويرعى الحق فيه والذمام % % وكم نضو أناخ بها إليه % % 482(@)(@@) % تضيفها المجادب والسآم % % أتته 
ms1107	 تجوب عرض الأرض جوبا % 483(@)(@@) % إليه لها خبيب وارتئام % % إذا قطعت من الموماة مرتا % 484(@)(@@) % من الأمرات ليس به علام % % ولليعفور في الكز انغماس % 485(@)(@@) % وللحرباء في الضح اصطخام % % تطاير عن مناسمها حصاه % 486(@)(@@) % وسافر عن مشافرها اللغام % % على ثقة بأن سترى وترعى % % 487(@)(@@) % ربيعا للطليح به مسام % % وأن ستفيء تامكة الأعالي % % 488(@)(@@) % كأن سنامها الرعن الخشام % % فوافت لا ربيع الحول لكن % % 489(@)(@@) % ربيع الدهر ليس له انصرام % % مراد معيشة ومعان علم % % 490(@)(@@) % يدل على فضيلته الزحام % % معان في موارده شفاء % PageV01P4223 491(@)(@@) % لمن أضحى لعلته احتدام % % له العفوات من شعري بعرف % 492(@)(@@) % إلى العفوات منه والجمام % % أخ كم بات ضيفي في قراه % % 493(@)(@@) % قرير العين ليس به اعتمام % % وقد أجممته زمنا وأنى % % 494(@)(@@) % وليس يفارق البحر الجمام % % وحق علي إهداء اعتذار % 495(@)(@@) % وإن لم يهد لي منه اتهام % % إليك أبا الحسين أقود قولا % 496(@)(@@) % له من حبلك الألوى خطام % % شهدت لقد منحتك صفو ودي % % 497(@)(@@) % ولا لوم علي ولا أثام % وما قصرت في التأميل كلا % % 498(@)(@@) % ولا أمسيت عن حقي تنام % جعلتك قبلة الآمال مني % % 499(@)(@@) % فهن مصليات لاصيام % % وكيف تصوم آمال غراث % 500(@)(@@) % ونائلك الهنيء لها طعام % % طعام لا وخامة فيه تخشى % % PageV01P4224 501(@)(@@) % وفي المعروف أطعمة وخام % % وكنت إذا أنخت إليك عيسى % % 502(@)(@@) % وآمالي غراث أو عيام % % أنخت بحيث تبيض الأيادي % % 503(@)(@@) % وتسود المطابخ والبرام % % خلا أني أهابك لا لسوء % % 504(@)(@@) % كما تتهيب البحر الهيام % % ويملكني حيائي حين تربي % % 505(@)(@@) % على شكري دسائعك الضخام % % ألم تر أننا لما التقينا % % 506(@)(@@) % فغنتني صنائعك الجسام % % رأيت الشكر قد ضعفت قواه % % 507(@)(@@) % فشمر للفرار ولا يلام % % وكنت الغالب المنصور جندا % % 508(@)(@@) % إذا لاقى تذممك الذمام % % وما تنفك تغلب كل شكر % 509(@)(@@) % بعرف ما لعروته انفصام % % وذاك بأن أبيح فليس يحمى % % 510(@)(@@) % وليس بأن أعز فما يرام % % وكنت إذا نوى المحسان ظعنا % % PageV01P4225 511(@)(@@) % عن الحسنى فنيتك المقام % % فإن راث اللفاء فلا تلمني % % 512(@)(@@) % فإن تخلفي عنك انهزام % ووكدك طرد زورك بالعطايا % % 513(@)(@@) % كذلك 
ms1108	 يطرد الزور الكرام % وكم تبع المولي منك سيب % 514(@)(@@) % فلم يقدر له منه انعصام % غمام جد في آثار سار % 515(@)(@@) % أغد سرى فأدركه الغمام % % وهل ينجو من الركبان ناج % 516(@)(@@) % وطالبه الغمام أو الظلام % % شكوت نداك لا أن قل لكن % % 517(@)(@@) % لأن كثرت أياديه العظام % % وأني قد بعلت به فأضحى % % 518(@)(@@) % كأن مغانمي منه غرام % % كما يشكو امرؤ طغيان سيل % 519(@)(@@) % تساوى الوهد فيه والأكام % % وما أشكوه منك إلى رحيم % % 520(@)(@@) % وشكري في ذراه مستضام % % وما لم تهتضم شكري بطول % PageV01P4226 521(@)(@@) % فليس ينالني منك اهتضام % % ولست بمعتبي من بدء عرف % 522(@)(@@) % بغير العود ماسجع الحمام % % فعاود كيف شئت فلست أشكو % % 523(@)(@@) % وهل يشكو الندى إلا اللئام % % ومامعروفك الممدود عني % % 524(@)(@@) % بمنقطع إذا انقطع الكلام % % خدعتك وانخداعك لي خليق % 525(@)(@@) % على الله الزيادة والتمام % % وقلت كأنني يوم بسيل % 526(@)(@@) % لأعلاه وأسفله التطام % % ولم أبرم بعرفك غير أني % % 527(@)(@@) % برمت بحمل شكرك والسلام % % وكم أنطقتني بلهى توالت % % 528(@)(@@) % وما صمتي وللقول انتظام % وكم أسكتني بلهى تغالت % % 529(@)(@@) % وما نطقي وللبحر التطام % وما ينفك يلحمنا ويجري % % 530(@)(@@) % ندى لك لا ينهنهه لجام % يبر فنستكين وغير نكر % PageV01P4227 531(@)(@@) % إذا شب الجلاد خبا اللطام % % وما أعطيت إلا ارتاش حر % % 532(@)(@@) % وأطرق والحياء له كعام % % تسد فقورنا وتغض منا % % 533(@)(@@) % فنستعفي هناك ونستذام % % ونلقى منك محتقر الهاه % 534(@)(@@) % وحول أخسها قدرا يحام % % بنى لاحاتم كان ابتناها % % 535(@)(@@) % ولا أوس وحارثة ولام % % ولكن كسروي ذو فعال % 536(@)(@@) % له بدء وليس له اختتام % % فيا عجبي أأستحيي لعجزي % % 537(@)(@@) % وفيك لأن تسامحني اغتنام % % تحب الشكر لا ما كد حرا % % 538(@)(@@) % بل المجرى يعاقبه المصام % % متى ناقشت ذا شكر حسابا % % 539(@)(@@) % فيدخلني من العجز احتشام % % ألست المرء يكرم في حياء % % 540(@)(@@) % كأن صنيعك الحسن اجترام % % ويكتم عرفه فيفوح منه % % PageV01P4228 541(@)(@@) % وليس لساطع المسك اكتتام % % ونبخس شكره فله اغتفار % 542(@)(@@) % ونظلم ماله فله اظطلام % % بلى فسقاك ربك حيث تسقى % % 543(@)(@@) % جحاجحة المروءة لا الطغام % فقد يسقى الرجال وهم رسوم % 544(@)(@@) % وقد 
ms1109	 يرعى الرجال وهم سوام % غدا الساعون خلفك في المعالي % % 545(@)(@@) % كمثل الصف يقدمه الإمام % % وسامني الزمان رجال مجد % 546(@)(@@) % فكنت نصيتي فما أسام % % أهلة أسعد ونجوم يمن % % 547(@)(@@) % ولكن بذها قمر تمام % % ومن يخترك لا يحمد وأنى % % 548(@)(@@) % وقد هدى توسمه الوسام % % وليس وإن عداه الحمد ممن % % 549(@)(@@) % يقال لرأيه رأي كهام % % وكم متخير أمرا حميدا % % 550(@)(@@) % تحلى الحمد منه والملام % % ولم أك كالتي اختارت فأضحى % % PageV01P4229 551(@)(@@) % من الأسماء خيرتها جذام % % بل اخترت الذي الآراء طرا % % 552(@)(@@) % عليه فلا هوى سرف وحام % % وحساد سناءك خاصمونا % % 553(@)(@@) % وهل في الصبح منبلجا خصام % % وقالوا مافضائله فقلنا % % 554(@)(@@) % هي الحسنات مافيهن ذام % % وقالوا مافواضله فقلنا % % 555(@)(@@) % رضاع لا يعاقبه فطام % % صنائع في الصنائع سيدات % 556(@)(@@) % صنائع من سواه لهن آم % % وأفعال يبيت لحاسديه % % 557(@)(@@) % بها سمر إذ هجع النيام % % ومعروف له ديوان أصل % 558(@)(@@) % وليس عليه من عذل زمام % % فموتوا أيها الحساد موتوا % % 559(@)(@@) % بداء لا يموت ولا ينام % % ولاتبنوا مقال الإفك فيه % % 560(@)(@@) % فليس لما بنى الله انهدام % منحتك من حلى الشعر عقدا % % PageV01P4230 561(@)(@@) % غدا لك درة ولي النظام % % وقد قصرت لا عمدا ولكن % % 562(@)(@@) % بهرت وعزني ملك همام % % وما قصرت قبلك في جزاء % 563(@)(@@) % ولكن المسامي ليشمام % % وكل مطاول لك فهو خاف % 564(@)(@@) % خفاء الحرف لابسه ادغام % % وبعد فليس في ملكي عناق % 565(@)(@@) % وكيف بها وما عندي شبام % % وما يخشى على جملي قلاف % 566(@)(@@) % ولا يخشى على فرسي صدام % % هما نعلان جلهما انخراق % 567(@)(@@) % إلى خفين جلهما انخرام % % وقد هجم الشتاء وكم لئيم % 568(@)(@@) % عليه الخز والوبر اللوام % % وما لاقى امرؤ لاقاك قوما % % 569(@)(@@) % فقالوا ما وراءك يا عصام % % كفاه مسائليه بيان نعمى % % 570(@)(@@) % تكلم كلما عدم الكلام % % وكم أغريت بالمرحوم منا % % PageV01P4231 571(@)(@@) % أخا حسد لمرجله اهتزام % % فعش للمكرمات فليس يخشى % % 572(@)(@@) % عليها ما بقيت لها احتزام % % أضحى وزيرا أبو يعلى وحق له % % 573(@)(@@) % بعد المشارط والمقراض والجلم % % قد قال قوم وغاظتهم كتابته % % 574(@)(@@) % لو شئت يارب ما علمت بالقلم % ن 
ms1110	 % % PageV01P4232 البحر : - 1(@)(@@) % أساي أسى يوم التفرق وحده % ولكن شوقي شوق فرقة أعوام % % PageV01P4233 البحر : - 1(@)(@@) % إن يخدم القلم السيف الذي خضعت % له الرقاب ودانت خوفه الأمم % 2(@)(@@) % فالموت والموت لاشيء يغالبه % مازال يتبع مايجري به القلم % 3(@)(@@) % كذا قضى الله للأقلام مذ بريت % أن السيوف لها مذ أرهفت خدم % PageV01P4234 البحر : - 1(@)(@@) % أبا العباس عمرت % صحيح الرأي والجسم % 2(@)(@@) % ولازلت من الخيرا % % ت طرا وافر القسم % 3(@)(@@) % توعدت بك الدهر % % فأعطى بيد السلم % % 4(@)(@@) % وأعفى بالتي أهوى % % وباع الجهل بالحلم % % 5(@)(@@) % فيا بابي إلى المال % % ويا بابي إلى العلم % % 6(@)(@@) % أدم عزمك في أمري % % على ماكان في القدم % % 7(@)(@@) % فما في عودتي يوما % % إلى فضلك من إثم % % 8(@)(@@) % وما الحكرة بالحل % % ولا المسكة بالحرم % % 9(@)(@@) % كفاف العيش كالعرس % % وفضل العيش كالحلم % % 10(@)(@@) % وما للكهل والفضل % % إذا عض على جذم % % PageV01P4235 11(@)(@@) % وزادت قوة الرأي % % وبادت قوة الجرم % % 12(@)(@@) % كفى مثلي كفى مثلي % % من الهجمة بالصرم % % 13(@)(@@) % بلى أبكي لأن أصبح % % ت من قدري في هدم % % 14(@)(@@) % ولي ظرف ولي رأي % وثيق كعرا العكم % % 15(@)(@@) % أترضى أن ترى الدهر % % وما نوه لي باسم % % 16(@)(@@) % وفي لطفك طلسم % بحالي أي طلسم % % PageV01P4236 البحر : - 1(@)(@@) % الحمد لله الذي % % أدى ركابك سالما % % 2(@)(@@) % لازلت في قبح إلى % % دعة وأمن قادما % % PageV01P4237 البحر : - 1(@)(@@) % ودرع إذا أنا أسملتها % % وقتني وإن أحمها أكلم % 2(@)(@@) % هو المال إن أعطه أهله % يفرني وإن أعفه أذمم % % PageV01P4238 البحر : - 1(@)(@@) % يقول علني مرة وأنالني % % وكان عليا في معانيه كاسمه % 2(@)(@@) % أرى فضل مال المرء داء لعرضه % % كما أن فضل الزاد داء لجسمه % % 3(@)(@@) % فليس لفضل المال شيء كبذله % % وليس لداء العرض شيء كحسمه % % 4(@)(@@) % فرحت برفديه ومازلت رائحا % % برفدين شتى من نداه وعلمه % % PageV01P4239 البحر : - 1(@)(@@) % ياليت شعري حين فارقتكم % % هل أخذ البصري في حطمي % % 2(@)(@@) % أم هل حماه غيبتي سيد % يحمي إذا ماقل من يحمي % % 3(@)(@@) % قولا له إن كان لا ينتهي % % عن أكل لحمي طالبا عظمي % % 4(@)(@@) % مائدة السيد مشحونة % تغنيك باللحمان عن لحمي % % 5 
ms1111	(@)(@@) % فإن أبيت السلم فاعزم بنا % % فإن حربي في قفا سلمي % % 6(@)(@@) % أضرب من يضربني سادرا % وتارة أرمي الذي يرمي % % 7(@)(@@) % فليخش مني من دنا منصلي % % وليخش مني من نأي سهمي % % 8(@)(@@) % ولست بالظالم إخوانه % % لكنني أمنع من ظلمي % % 9(@)(@@) % سيفي لساني والهدى قائدي % % والحق محتج على خصمي % % 10(@)(@@) % أعذر من أنذر فليحتنك % غر وعزمي بعدها عزمي % % PageV01P4240 11(@)(@@) % فلا يشم عرضي على غرة % % من لا ينافي وشمه وشمي % % 12(@)(@@) % وسوسي الحلم ويا ربما % % أصبح يحكي كلمه كلمي % % 13(@)(@@) % قد جعل الله الذي سبني % % شيخا يتيما وأبى يتمي % % 14(@)(@@) % فامسح بكف الرحم يافوخه % % وادع بأن يدركه رحمي % % 15(@)(@@) % فرب ذي حين غدا حينه % مستملحا في جلده رقمي % % 16(@)(@@) % أشعرته من قذعي مرمضا % صار به الحائن طلسمي % % 17(@)(@@) % أضحى لمن أبصره آية % تبصر الآية أو تعمي % % 18(@)(@@) % وناثر أعجبه نثره % أذهله عن نثره نظمي % % 19(@)(@@) % وسار محمولا على منطقي % % يجري عليه صاغرا حكمي % % 20(@)(@@) % نقيصة في الشعر من ذكره % % أقبح في شعري من خرم % % PageV01P4241 21(@)(@@) % يارويح حسادي وياويلهم % % من ذا أراهم قسمهم قسمي % % 22(@)(@@) % ثعالب أطمعها حتفها % % في قسور لحظته تصمي % % 23(@)(@@) % أحلف بالله وآلائه % % مافهم الزاري على فهمي % % 24(@)(@@) % أعين أعدائي على غيبهم % % طلائعي توحي إلى وهمي % % 25(@)(@@) % فكيف لا أعرف أضغانهم % % مع الأقاويل التي تنمي % % 26(@)(@@) % فريسة الليث له وحده % فليبأس الجاهل من غشمي % % 27(@)(@@) % وربما كفكف من غايتي % % بطش لساني ويدي علمي % % 28(@)(@@) % إني بناني من بنى يذبلا % فليس تستطيع يد هدمي % % 29(@)(@@) % وإنني مازلت مستحسنا % مغفرتي مستقبحا نقمي % % 30(@)(@@) % والحزم في نقمي ولكنني % % أوثر إحساني على حزمي % % PageV01P4242 31(@)(@@) % فليقل البصري ما يشتهي % % سوغته المعسول من طعمي % % 32(@)(@@) % سوغته القول ولو أنه % % يعرق الجبهة أو يدمي % % 33(@)(@@) % ولايخلها جاهل نهزة % فلا يمهل داءه حسمي % % 34(@)(@@) % قد يفرق المجنون من كيتي % % ويصعق العفريت من رجمي % % 35(@)(@@) % ولو نجا أقسم لا يأتلي % % إن ما رأى أثقب من نجمي % % 36(@)(@@) % لولا قضاء الله في معشر % ماطمع الطامع في هضمي % % 37(@)(@@) % طفت بأكنافك لاهاجما 
ms1112	 % وداء عمرو أمنه هجمي % % 38(@)(@@) % وليس شأني الجهل لكنني % % قد يقدح الإحراج في حلمي % % 39(@)(@@) % واعلم إذا استخففت بي أنه % % قد تحقر الشيء وقد ينمي % % PageV01P4243 البحر : - 1(@)(@@) % أفيضا دما إن الرزايا لها قيم % فليس كثيرا أن تجودا لها بدم % 2(@)(@@) % ولاتستريحا من بكاء إلى كرى % % فلا حمد مالم تسعداني على السأم % % 3(@)(@@) % ويا لذة العيش التي كنت أرتضي % % تقطع مابيني وبينك فانصرم % 4(@)(@@) % رميت بخط لا يقوم لمثله % شرورى ولارضوى ولا الهضب من خيم % % 5(@)(@@) % بأنكر ذي نكر وأقطع ذي شبا % وأمقر ذي طعم وأوخم ذي وخم % 6(@)(@@) % رزيئة أم كنت أحيا بروحها % % وأستدفع البلوى وأستكشف الغمم % % 7(@)(@@) % وما الأم إلا إمة في حياتها % % وأم إذا فادت وما الأم بالأمم % % 8(@)(@@) % بنفسي غداة الأمس من بان من غد % وبت مع الأمس القرينة فانجذم % % 9(@)(@@) % ولما قضى الحاثون حثو ترابهم % % عليها وحالت دونها مرة الوذم % % 10(@)(@@) % أظلت غواشي رحمة الله قبرها % % فأضحى جناباه من النار في حرم % % PageV01P4244 11(@)(@@) % أقول وقد قالوا أتبكي كفاقد % رضاعا وأين الكهل من راضع الحلم % % 12(@)(@@) % هي الأم يا للناس جرعت ثكلها % % ومن يبك أما لم تذم قط لا يذم % % 13(@)(@@) % فقدت رضاعا من سرور عهدتها % % تعللنيه فانقضى غير مستتم % % 14(@)(@@) % رضاع بنات القلب بان ببينها % % حميدا وما كل الرضاع رضاع فم % % 15(@)(@@) % إلى الله أشكو جهد بلواي إنه % % بمستمع الشكوى ومستوهب العصم % 16(@)(@@) % وإني لم إيتم صغيرا وإنني % % يتمت كبيرا أسوأ اليتم واليتم % % 17(@)(@@) % على حين لم ألق المصيبة جاهلا % ولا آهلا والدهر دهر قد اعترم % 18(@)(@@) % أقاسي وصنوي منه كل شديدة % تبرح بالجلد الصبور وبالبرم % % 19(@)(@@) % خليلي هذا قبر أمي فورعا % % من العذل عني واجعلا جابتي نعم % % 20(@)(@@) % فما ذرفت عيني على رسم منزل % ولاعكفت نفسي هناك على صنم % % PageV01P4245 21(@)(@@) % خليلي رقا لي أعينا أخاكما % % نشدتكما من ترعيان من الحرم % % 22(@)(@@) % أمن كرى الشكوى تملاني جزتما % % سبيل اغتنام الحمد والحمد يغتنم % % 23(@)(@@) % فكيف اصطباري للمصاب وأنتما % % تملان شكواه وفي جانبي ثلم % % 24(@)(@@) % عجبت لذي سمع 
ms1113	 يمل شكاية % ويعجب من صدر يضيق بما كظم % % 25(@)(@@) % ألا رب أيام سحبت ذيولها % % سليما من الأرزاء أملس كالزلم % % 26(@)(@@) % أرشح آمالا طوالا وأجتني % % جنى العيش في ظل ظليل من النعم % % 27(@)(@@) % ولو كنت أدري أن ماكان كائن % لقمت لروعات الخطوب على قدم % % 28(@)(@@) % غدا الدهر لي خصما وفى محكما % فكيف بخصم ضالع وهو الحكم % % 29(@)(@@) % يجور فأشكو جوره وهو دائبا % يرى جوره عدلا إذا الجور منه عم % % 30(@)(@@) % عذيري من دهر غشوم لأهله % % يرى أنه إذ عم بالغشم ماغشم % % PageV01P4246 31(@)(@@) % غدا يقسم الأسواء قسم سوية % وماعدل من سوى وسواء ماقسم % % 32(@)(@@) % تعم ببلواه يد منه سلطة % % يصول بها فظ إذا اقتدر اهتضم % % 33(@)(@@) % وليست من الأيدي الحميد بلاؤها % % يد قسمت سوءا وإن سوت القسم % 34(@)(@@) % أمال عروشي ثم ثنى بهدمها % % وكم من عروش قد أمال وقد هدم % % 35(@)(@@) % وأصبح يهدي لي الأسى متنصلا % فمن سوقة أردى ومن ملك قصم % % 36(@)(@@) % وإني وإن أهدى أساه لساخط % عليه ولكن هل من الدهر منتقم % % 37(@)(@@) % هو الدهر إما غابط ذا شبيبة % % بإحدى المنايا أو مميت أخا هرم % % 38(@)(@@) % كأن الفتى نصب الليالي بنية م أفيضا دما إن الرزايا لها قيم % فليس كثيرا أن تجودا لها بدم % 39(@)(@@) % ولاتستريحا من بكاء إلى كرى % % فلا حمد مالم تسعداني على السأم % % 40(@)(@@) % ويا لذة العيش التي كنت أرتضي % % تقطع مابيني وبينك فانصرم % PageV01P4247 41(@)(@@) % رميت بخط لا يقوم لمثله % شرورى ولارضوى ولا الهضب من خيم % % 42(@)(@@) % بأنكر ذي نكر وأقطع ذي شبا % وأمقر ذي طعم وأوخم ذي وخم % 43(@)(@@) % رزيئة أم كنت أحيا بروحها % % وأستدفع البلوى وأستكشف الغمم % % 44(@)(@@) % وما الأم إلا إمة في حياتها % % وأم إذا فادت وما الأم بالأمم % % 45(@)(@@) % بنفسي غداة الأمس من بان من غد % وبت مع الأمس القرينة فانجذم % % 46(@)(@@) % ولما قضى الحاثون حثو ترابهم % % عليها وحالت دونها مرة الوذم % % 47(@)(@@) % أظلت غواشي رحمة الله قبرها % % فأضحى جناباه من النار في حرم % % 48(@)(@@) % أقول وقد قالوا أتبكي كفاقد % رضاعا وأين الكهل 
ms1114	 من راضع الحلم % % 49(@)(@@) % هي الأم يا للناس جرعت ثكلها % % ومن يبك أما لم تذم قط لا يذم % % 50(@)(@@) % فقدت رضاعا من سرور عهدتها % % تعللنيه فانقضى غير مستتم % % PageV01P4248 51(@)(@@) % رضاع بنات القلب بان ببينها % % حميدا وما كل الرضاع رضاع فم % % 52(@)(@@) % إلى الله أشكو جهد بلواي إنه % % بمستمع الشكوى ومستوهب العصم % 53(@)(@@) % إني لم إيتم صغيرا وإنني % % يتمت كبيرا أسوأ اليتم واليتم % % 54(@)(@@) % على حين لم ألق المصيبة جاهلا % ولا آهلا والدهر دهر قد اعترم % 55(@)(@@) % أقاسي وصنوي منه كل شديدة % تبرح بالجلد الصبور وبالبرم % % 56(@)(@@) % خليلي هذا قبر أمي فورعا % % من العذل عني واجعلا جابتي نعم % % 57(@)(@@) % فما ذرفت عيني على رسم منزل % ولاعكفت نفسي هناك على صنم % % 58(@)(@@) % خليلي رقا لي أعينا أخاكما % % نشدتكما من ترعيان من الحرم % % 59(@)(@@) % أمن كرى الشكوى تملاني جزتما % % سبيل اغتنام الحمد والحمد يغتنم % % 60(@)(@@) % فكيف اصطباري للمصاب وأنتما % % تملان شكواه وفي جانبي ثلم % % PageV01P4249 61(@)(@@) % عجبت لذي سمع يمل شكاية % ويعجب من صدر يضيق بما كظم % % 62(@)(@@) % ألا رب أيام سحبت ذيولها % % سليما من الأرزاء أملس كالزلم % % 63(@)(@@) % أرشح آمالا طوالا وأجتني % % جنى العيش في ظل ظليل من النعم % % 64(@)(@@) % ولو كنت أدري أن ماكان كائن % لقمت لروعات الخطوب على قدم % % 65(@)(@@) % غدا الدهر لي خصما وفى محكما % فكيف بخصم ضالع وهو الحكم % % 66(@)(@@) % يجور فأشكو جوره وهو دائبا % يرى جوره عدلا إذا الجور منه عم % % 67(@)(@@) % عذيري من دهر غشوم لأهله % % يرى أنه إذ عم بالغشم ماغشم % % 68(@)(@@) % غدا يقسم الأسواء قسم سوية % وماعدل من سوى وسواء ماقسم % % 69(@)(@@) % تعم ببلواه يد منه سلطة % % يصول بها فظ إذا اقتدر اهتضم % % 70(@)(@@) % وليست من الأيدي الحميد بلاؤها % % يد قسمت سوءا وإن سوت القسم % PageV01P4250 71(@)(@@) % أمال عروشي ثم ثنى بهدمها % % وكم من عروش قد أمال وقد هدم % % 72(@)(@@) % وأصبح يهدي لي الأسى متنصلا % فمن سوقة أردى ومن ملك قصم % % 73(@)(@@) % وإني وإن أهدى أساه لساخط % عليه ولكن هل من الدهر منتقم % % 74(@)(@@) % هو الدهر 
ms1115	 إما غابط ذا شبيبة % % بإحدى المنايا أو مميت أخا هرم % % 75(@)(@@) % كأن الفتى نصب الليالي بنية ه % % بمصطفق من موج بحر وملتطم % % 76(@)(@@) % تقاذف عنها موجة بعد موجة % % إلى موجة تأتي ذراها من الدعم % % 77(@)(@@) % كذاك الفتى نصب الليالي يمرها % % إلى ليلة ترمي به سالف الأمم % % 78(@)(@@) % فيا آملا أن يخلد الدهر كله % سل الدهر عن عاد وعن أختها إرم % % 79(@)(@@) % يخبرك أن الموت رسم مؤبد % % ولن تعدو الرسم القديم الذي رسم % 80(@)(@@) % رأيت طويل العمر مثل قصيره % إذا كان مفضاه إلى غاية تؤم % % PageV01P4251 81(@)(@@) % وما طول عمر لا أبا لك ينقضي % % وماخير عيش قصر وجدانه العدم % % 82(@)(@@) % ألا كل حي ماخلا الله ميت % وإن زعم التأميل ذو الإفك مازعم % % 83(@)(@@) % يروح ويغدو الشيء يبنى فربما % % جنى وهيه الباني وإن أغفل انهدم % % 84(@)(@@) % إذا أخطأته ثلمة لا يجرها % % له غيره جاءته من ذاته الثلم % 85(@)(@@) % تضعضعه الأوقات وهي بقاؤه % وتغتاله الأقوات وهي له طعم % 86(@)(@@) % فيا من يداوي مايجر بقاؤه % فناء وما يفذي به فيه قديسم % 87(@)(@@) % جشمت عناء لاعناء وراءه % فدع عنك ما أعيا ولاتجشم الجشم % % 88(@)(@@) % سقى قبلك الساقي وأسعط بل كوى % % ليحسم أدواء القرون فما حسم % 89(@)(@@) % إذا ما رأيت الشيء يبليه عمره % ويفنيه أن يبقى ففي دائه عقم % % 90(@)(@@) % يروح ويغدو وهو من موت عبطة % وموت فناء بين فكين من جلم % % PageV01P4252 91(@)(@@) % ألا إن بالأبصار عن عبرة عمى % % ألا إن بالأسماع عن عظة صمم % % 92(@)(@@) % تحد لنا أيدي الزمان شفاره % % ونرتع في أكلائه رتعة النعم % % 93(@)(@@) % نراع إذا ما الدهر صاح فنرعوي % % وإن لم يصح يوما براتعنا خضم % % 94(@)(@@) % سيكشف عن قلب الغبي غطاؤه % % إذا حتفه يوما على صدره جثم % % 95(@)(@@) % ألا كم أذل الدهر من متعزز % % وكم زم من أنف حمي وكم خطم % % 96(@)(@@) % وكم ساور العقبان في اللؤم صرفه % % وكم غاوص الحيتان في زاخر الحوم % % 97(@)(@@) % وكم ظلم الظلمان حق صحاحها % % ومثل خصيم الدهر أذعن واظلم % % 98(@)(@@) % وكم غلبت غلب القيول هناته % % ولم تقتبس 
ms1116	 من قبل ذاك ولم ترم % 99(@)(@@) % وكم نهش الحيات في هضباتها % % وكم فرس الأسد الخوادر في الأجم % % 100(@)(@@) % وكم أدرك الوحش التي لج نفرها % % يغور لها طورا ويطلع الأكم % % PageV01P4253 101(@)(@@) % وكم قعص الأبطال إما شجاعة % وإما بمقدار إذا اضطره اقتحم % % 102(@)(@@) % وكم صال بالأملاك وسط جنودها % % وأخنى على أهل النبوات والحكم % % 103(@)(@@) % وكم نعمة أذوى وكم غبطة طوى % % وكم سند أهوى وكم عروة فصم % 104(@)(@@) % وكم هد من طود منيف عانه % وكم قض من قصر منيف وكم وكم % % 105(@)(@@) % أرى الدهر لا يبقى على حدثانه % % شعيب الأعالي جهوري إذا بغم % % 106(@)(@@) % جريء على العرم العوارم لا يني % % كأن ذعاف السم يشفيه من قرم % % 107(@)(@@) % إذا احترش الأفعى بمرجوع نفخة % % دهاها بأضراس حداد أو التهم % % 108(@)(@@) % معد عتادي هارب ومقاتل % متى كر يوما كرة أو متى انهزم % % 109(@)(@@) % قرون كأرماح الهياج شوائك % % وآونة شد يجم إذا انهزم % % 110(@)(@@) % رعى مارعى حتى رمى الحين نفسه % بحتف فما أنبا هناك ولاشرم % % PageV01P4254 111(@)(@@) % أدل بقرنيه فلاقاه ناطح % من الدهر غلاب فسواه بالأجم % % 112(@)(@@) % ولانقنق خاظي البضيع صمحمح % % من الآكلات النار تأتج في الفحم % 113(@)(@@) % يصوم فلا يحوي ويملأ بطنه % بماشاء من زاد ولا يرهب البشم % 114(@)(@@) % ويبلغ أفلاذ الحديد جوامدا % فيسبكها في قعر كير قد احتدم % % 115(@)(@@) % ويشترط المرو الركود كأنما % % يراه طعاما قد أعد له لقم % % 116(@)(@@) % ويتخذ التنوم والشري مرتعا % فيخذم من هذا وهذاك ماخذم % % 117(@)(@@) % ترامت به الأحوال حتى بنينه % نهارا وليلا بنية الفحل ذي القطم % % 118(@)(@@) % من العاديات الطائرات إذا نجا % % بصرت به بين النجاءين مقتسم % % 119(@)(@@) % إذا شب منها جاد ماهو قادح % بزنديه من شد تلهب فاطرم % % 120(@)(@@) % جناحان خفاقان محثحثا % ورجلان لاتستحسران إذا اعتزم % PageV01P4255 121(@)(@@) % نجا ما نجا حتى ابتغى الدهر كيده % % فدس إليه العنقفير ابنة الرقم % % 122(@)(@@) % ولاقسور إن لم يجد مايكفه % من الصيد أضحى والسباع له لحم % % 123(@)(@@) % عليه الدماء الجاسدات كأنما % % مواقعها منه المدمى من الرخم % % 124(@)(@@) % إذا ما اغتدى قبل العطاس لصيده % % فللمغتدي تلقاءه 
ms1117	 عطسة اللجم % % 125(@)(@@) % أتاحت له الأحداث منهن قرنه % كفاحا فلم يكدح بظفر ولاضغم % % 126(@)(@@) % وقد كان خطاف الخطاطيف ضيغما % % إذا ساهم الأقران عن نفسه سهم % % 127(@)(@@) % ولا أعصل النابين حامل مخطم % % به حجن طورا وطورا به فقم % % 128(@)(@@) % يقلب جثمانا عظيما موثقا % % يهد بركنيه الجبال إذا مازحم % % 129(@)(@@) % ويسطو بخرطوم يثنيه طوعه % ومتشبهات ما أصاب بها غنم % % 130(@)(@@) % ولست ترى بأسا يقوم لبأسه % إذا أعمل النابين في البأس أو صدم % % PageV01P4256 131(@)(@@) % بقى مابقى حتى انتحى الدهر شخصه % فلم ينتصر إلا بأن أن أو نأم % % 132(@)(@@) % هوى هائل المهوى يجود بنفسه % % تخال به قيدا تقوض من إضم % % 133(@)(@@) % مضيما هضيما بعد عز ومنعة % % ومن ضامه مالا يطاق ولم يضم % % 134(@)(@@) % ولاصل أصلال يبيت مراقبا % بنهشته مقدار نفس متى يحم % 135(@)(@@) % يشول بأنياب شواها مقاتل % يقطر من أصرافها السم كالدسم % % 136(@)(@@) % زحوف لدى الممسي كأن سحيفه % إذا انساب في جنح الظلام نشيش حم % % 137(@)(@@) % يميز المنايا القاضيات سمامه % من الرقش ألوانا أو السود كالحمم % % 138(@)(@@) % أتاه وقد ظن الحمام شقيقه % % حمام ولاقى لا شقيقا ولا ابن عم % % 139(@)(@@) % سقاه بكأس كان يسقي بمثلها % % إذا ما سقى الساقي بأمثالها فطم % % 140(@)(@@) % كمين ردى في جسمه أو مبارز % نجيد من الأقران غادره جذم % PageV01P4257 141(@)(@@) % ولا لقوة شعواء تلحم فرخها % % خدارية شماء في شاهق أشم % % 142(@)(@@) % بكور على الأقناص غير مخلة % % كأن بها في كل شارقة وجم % % 143(@)(@@) % تبيت إذا ما أحجر القر غيرها % % ترقرق رفض الطل في ريشها الأحم % % 144(@)(@@) % تعالت عن الأيدي العواطي وأعطيت % على الطير تفضيلا فأعطينها الرمم % % 145(@)(@@) % سما نحوها خطب من الدهر فاتك % فطاحت جبارا مثل صاحبها درم % % 146(@)(@@) % ولا غرق ناج من الكرب عيشه % بحيث يكون الموت في الأخضر القطم % % 147(@)(@@) % سبوح مروج رعيه حيث ورده % % رغيب المعا مهما استطف له التقم % % 148(@)(@@) % مجوشن أعلى الجلد غير محمل % % سلاحا سوى فيه ومزوده اللهم % % 149(@)(@@) % نفت جلة الحيتان عنه شذاته % % وخلي في مرعى من الوحش والقزم % 150(@)(@@) % إذا أوجس النوتي 
ms1118	 يوما حسيسه % وقد عارض البوصي شمر واحتزم % % PageV01P4258 151(@)(@@) % أتيح له قرن من الدهر لم يكن % % لينكل عن أهوال يم ولا ابن يم % % 152(@)(@@) % فألقاه في منجى السفين وإنما % % بحيث يشم الروح ركبانها يغم % % 153(@)(@@) % لقى طافيا مثل الجزيرة فوقه % أبابيل شتى من نسور ومن رخم % % 154(@)(@@) % ولاملك لامجد إلا وقد بنى % % ولا رأس سامي الطرف إلا وقد وقم % % 155(@)(@@) % تياسره الأشياء منقادة له % % فإن عاسرته مرة خش أو خزم % % 156(@)(@@) % إذا سار غضت كل عين مهابة % وأسكتت الأفواه من غير مابكم % % 157(@)(@@) % سوى صهلات الخيل في عرض جحفل % % له لجب يسترجف الأرض ذي هزم % % 158(@)(@@) % كأن مثار النقع فوق سواده % سحاب على ليل تطخطخ فادلهم % 159(@)(@@) % وإن حل أرضا حلها وهو قادر % على البؤس والنعمى فأهلك أوعصم % % 160(@)(@@) % ترى خرزات الملك فوق جبينه % تلوح عليه من فرادى ومن تؤم % % PageV01P4259 161(@)(@@) % طواه الردى من بعدما أثخن العدا % % وقوم من أمريه ذا الزيغ والضجم % % 162(@)(@@) % قد أمن الأيام أن تخترمنه % وبرئت الدنيا لديه من التهم % % 163(@)(@@) % رمى حاكم الحكام مهجة نفسه % % بحكم له ماض فدانت لما حكم % % 164(@)(@@) % ولا مرسل بالوحي مليكه % % سراجا منيرا نوره الساطع الأتم % % 165(@)(@@) % له دعوة يشفي بها من شكى الضنى % % ويرزق من أكدى وينعش من رزم % 166(@)(@@) % هو الرزء لا يسطيع نهضا بثقله % سوى ابن يقين عاذ بالله واعتصم % % 167(@)(@@) % تمثلت أمثالي معيدا ومبدئا % فما اندمل الجرح الذي بي ولا التأم % % 168(@)(@@) % وكم قارع سمعي بوعظ يجيده % % ولكنه في الماء يرقم ما رقم % % 169(@)(@@) % إذا عاد ألفى القلب لم يقن وعظه % وقد ظنه كالوحي في الحجر الأصم % % 170(@)(@@) % وكيف بأن يقنى الفؤاد عظاة % % وقد ذاب حتى لو ترقرق لانسجم % % PageV01P4260 171(@)(@@) % وهل راقم في صفحة الماء عائد % % ليقرأ ماقد خط إلا وقد طسم % % 172(@)(@@) % أحاملتي أصبحت حملا لحفرة % % إذا حملت يوما فليس لها قتم % % 173(@)(@@) % أحاملتي أستحمل الله روحة % إلى تلكم الروح الزكية والنسم % % 174(@)(@@) % أمرضعتي أسترضع الغيث درة % لرمسك بل أستغزر الدمع ماسجم % % 175(@)(@@) % وإني لأستحييك أن 
ms1119	 أطلب الأسى % % لأسلى ولو داويت جرحي لم ألم % % 176(@)(@@) % حفاظا وهل لي أسوة لو طلبتها % % ألا لا وهل من قيمة لك في القيم % % 177(@)(@@) % وإني لأستحييك أن أنقع الصدى % % وأن أتحبى بالنسيم إذا نسم % % 178(@)(@@) % أأستنشق الأرواح بعدك طائعا % وأشرب عذب عذب الماء إني لذونهم % % 179(@)(@@) % وإني لأستحييك يا أم أن يرى % % قريني إلا من بكى لك أو وجم % % 180(@)(@@) % وأن أتلهى بالحديث عن الأسى % % وألقى جليسي بابتسام إذا ابتسم % % PageV01P4261 181(@)(@@) % أأمرح فوق الأرض يا أم والثرى % % عليك مهيل قد تطابق وارتكم % % 182(@)(@@) % أبى ذاك من نفسي خصيم منازع % ألد إذا جاثى خصيما له خصم % 183(@)(@@) % حفاظي خصيمي عنك يا أم إنه % % أبى لي إلا الهم بعدك والسدم % % 184(@)(@@) % عزيز علينا أن تموتي وأننا % % نعيش ولكن حكم الموت فاحتكم % % 185(@)(@@) % ولو قبل الموت الفداء بذلته % ولكنما يعتام رائده العيم % % 186(@)(@@) % أيا موت ما أسلمتها لك طائعا % % هواك فمالي زفرتي زفرة الندم % % 187(@)(@@) % سأبكي بنثر الدمع طورا وتارة % بنظم المراثي دائم الحزن والوكم % % 188(@)(@@) % وتسعدني نفس على ذاك سمحة % بما نثر الشجو الدخيل ومانظم % % 189(@)(@@) % لأنفي نومي لا لأشفي غلتي % % على أن عيني مذ فقدتك لم تنم % % 190(@)(@@) % ولو نظرت عيناك يا أم نظرة % إلى ماتوارى عنك مني واكتتم % % PageV01P4262 191(@)(@@) % فقست بما ألقاه ماقد لقيته % % شهدت بحق أن داهيتي أطم % % 192(@)(@@) % وكم بين مكروه يحس وقوعه % وآخر معدوم الإطاقة واللمم % % 193(@)(@@) % يحس البلى ميت الحياة ولم يكن % % يحس البلى ميت الممات إذا أرم % % 194(@)(@@) % ألا من أراه صاحبا غير خائن % ألا من أراه مؤنسا غير محتشمص ألا من تليني منه في كل حالة % 195(@)(@@) % أبر يد برت بذي شعث يلمع فيفرج عني كل غم وكل همص نبا ناظري يا يم عن كل منظر % ألا من إليه أشتكي ما ينوبني % % 196(@)(@@) % وسمعي عن الأصوات بعدك والنغم % % وأصبحت الآمال مذ بنت والمنى % % 197(@)(@@) % غوادر عندي غير وافية الدمم % وصارمت خلاني وهم يصلونني % % 198(@)(@@) % وقد كنت وصال الخليل وإن صرم % % وآنسني فقد الجليس وأوحشت 
ms1120	 % 199(@)(@@) % مشاهده نفسي ولم أدر ما اجترم % % سوى أنه يدعو إلى الصبر واعظا % 200(@)(@@) % فإن لج مابي لج في العدل أو عذم % % ولو أنني جمعت وعظي ووعظه % PageV01P4263 201(@)(@@) % ليشعب صدعا في فؤادي لما التأم % % وإني وقد زودتني منك لوعة % % 202(@)(@@) % لها وقدة في القلب كالنار في الضرم % % يريد المعزي برء كلمي بوعظه % 203(@)(@@) % ولم يك غير الله يبرىء ماكلم % % هو الواهب السلوان والصبر وحده % 204(@)(@@) % لذي الرزء المهدي الشفاء لذي السقم % % ولست أراني مذهلي عنك مذهل % 205(@)(@@) % يد الدهر إلا أخذة الموت بالكظم % % هناك ذهولي أو إذا قيل قد قضى % % 206(@)(@@) % وإلا فلا ماطاف ساع أو استلم % % وسويت عندي عرف دهري بنكره % % 207(@)(@@) % فأضحى وأمسى كلما أحسن استذم % % أرى الخيرة المهداة لي منه عبرة % 208(@)(@@) % ونعمته المسداة من واقع النقم % % أتبهجني نعماء دهر حماكها % % 209(@)(@@) % وأشكر ما أعطى وأنت الذي حرم % % أبى ذاك أن الخير بعدك حسرة % % 210(@)(@@) % لدي ومعدود من المحن العظم % % فقدناك فاسودت عليك قلوبنا % % PageV01P4264 211(@)(@@) % وحقت بأن تسود وابيضت اللمم % % وأظلمت الدنيا وباخ ضياؤها % % 212(@)(@@) % نهارا وشمس الصحو حيرى على القمم % % وأجدبت الأرض التي كنت روضة % 213(@)(@@) % عليها وأبدت مكلحا بعد مبتسم % % ومادت لك الأجبال حتى كأنما % % 214(@)(@@) % شواهقها كان بمحياك تدعم % وأصبح يبكيك السحاب مجاودا % 215(@)(@@) % فأرزم إرزام العجول ومارذم % % وناحت عليك الريح عبري وأصبحت % 216(@)(@@) % لدن عدمت رياك تجري فلا تشم % وقامت عليك الجن والإنس مأتما % 217(@)(@@) % تبكي صلاة الليل والخمص والهضم % % وأضحت عليك الوحش والطير ولها % % 218(@)(@@) % تبكي الرواء النضر والمخبر العمم % وأبدى اكتئابا كل شيء علمته % % 219(@)(@@) % وأضعاف ما أبداه من ذاك ماكتم % % كذاك أرى الأشياء إما حقيقة % 220(@)(@@) % بدت لي وإما حلم مستيقظ حلم % % ولن يحلم اليقظان إلا وقد أتت % PageV01P4265 221(@)(@@) % على لبه دهياء هائلة الفقم % % وأما السموات العلى فتباشرت % 222(@)(@@) % بروحك لما ضمها ذلك المضم % % وماكنت إلا كوكبا كان بيننا % % 223(@)(@@) % فبان وأمسى بين أشكاله نجم % % رأى المسكن العلوي أولى بمثله % 224(@)(@@) % فودعنا جادت معاهده الرهم % % تأمل خليلي في الكواكب كوكبا 