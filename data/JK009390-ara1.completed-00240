ms221	 النبي :(@)(@@) | 30 ( إذا أصيب أحدكم بمصيبة فليذكر مصيبته بي فإنها من أعظم المصائب ) )(@)(@@) ( طس ) عن سابط الجمحى بن سعد عن عطاء بن أبي رباح مرسلا .(@)(@@)(@@)(@@) $ ( 2063 ) قال النبي :(@)(@@) | 30 ( إذا أطاق الغلام صيام ثلاثة أيام متتابعات فقد وجب عليه صوم شهر رمضان ) )(@)(@@) أبو نعيم فى المعرفة والديلمى عن يحيى بن عبدالرحمان عن لبيبة الأنصارى عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 2064 ) قال النبي :(@)(@@) | 30 ( إذا اضطررتم إليها فاغسلوها بالماء واطبخوا فيها يعنى آنية المجوس ) )(@)(@@) ( حم ) عن ابن عمرو رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2065 ) قال النبي :(@)(@@) | 30 ( إذا أعتق الرجل أمته ثم تزوجها بمهر جديد كان له أجران ) )(@)(@@) ( ط حل هق ) عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2066 ) قال النبي :(@)(@@) | 30 ( إذا أعتق الرجل العبد تبعه ماله إلا أن يكون شرطه المعتق ) )(@)(@@) ( قط ) في الأفراد و الديلمي عن ابن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2067 ) قال النبي :(@)(@@) | 30 ( إذا أعجل أحدكم أو أقحط فلا يغتسل ) )(@)(@@) عبد الرزاق عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2068 ) قال النبي :(@)(@@) | 30 ( إذا اعترف الرجل بالزنا سبع مرات فأمر به ليرجم ثم هرب ترك ) )(@)(@@) الديلمي عن أبي هريرة رضي الله عنه .(@)(@@) PageV01P303(@)(@@)(@@)(@@) $ ( 2069 ) قال النبي :(@)(@@) | 30 ( إذا أعيا أحدكم فليهرول فإنه يذهب العيا ) )(@)(@@) الديلمي عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2070 ) قال النبي :(@)(@@) | 30 ( إذا اغتاب أحدكم أخاه فليستغفر له ) )(@)(@@) ( عد ) عن سهل بن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2071 ) قال النبي :(@)(@@) | 30 ( إذا اغتسل أحدكم فليغسل كل عضو منه ثلاث مرات ) )(@)(@@) الديلمي عن أم هانىء رضي الله عنها .(@)(@@)(@@)(@@) $ ( 2072 ) قال النبي :(@)(@@) | 30 ( إذا اغتسل أحدكم ثم ظهر من ذكره شيء فليتوضأ ) )(@)(@@) ( طب ) عن الحكيم بن عمير الثمالي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2073 ) قال النبي :(@)(@@) | 30 ( إذا اغتسلت المرأة من حيضها نقضت شعرها نقضا وغسلته بخطمي وإشنان ، وإذا اغتسلت من الجنابة صبت الماء على رأسها صبا وعصرته ) )(@)(@@) ( قط ) في الأفراد ( طب هق ) و الخطيب في التلخيص ( ض ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2074 ) قال النبي :(@)(@@) | 30 ( إذا أفضى أحدكم بيده إلى ذكره 
ms222	 فليتوضأ ) )(@)(@@) الشافعي ( هق ) في المعرفة عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2075 ) قال النبي :(@)(@@) | 30 ( إذا أفضى أحدكم إلى ذكره فلا يصل حتى يتوضأ ) )(@)(@@) ( ك ) عن بسرة بنت صفوان رضي الله عنها .(@)(@@)(@@)(@@) $ ( 2076 ) قال النبي :(@)(@@) | 30 ( إذا أفطر أحدكم فليفطر على تمر ، فإن لم يجد فليحس حسوة من ماء ) )(@)(@@) ( حب ) عن سل مان بن عامر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2077 ) قال النبي :(@)(@@) | 30 ( إذا أفلس الرجل فوجد البائع سلعته بعينها فهو أحق بها دون الغرماء ) )(@)(@@) ( عب خ م ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2078 ) قال النبي :(@)(@@) | 30 ( إذا اقترب الزمان كثر لبس الطيالسة وكثرت التجارة ، PageV01P304 وكثر المال ، وعظم رب المال لماله ، وكثرت الفاحشة ، وكانت إمارة الصبيان ، وكثر النساء ، وجار السلطان ، وطفف المكيال والميزان ، ويربي الرجل جروا خيرا له من أن يربي ولدا له ، ولا يوقر كبير ، ولا يرحم صغير ويكثر أولاد الزنا حتى إن الرجل ليغشى المرأة على قارعة الطريق ، ويلبسون جلود الضأن على قلوب الذئاب أمثلهم في ذالك الزمان المداهن ) )(@)(@@) ( طب ك ) وتعقب عن منتصر بن عمارة بن أبي ذر عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 2079 ) قال النبي :(@)(@@) | 30 ( إذا اقترب الزمان لم تكد رؤيا المسلم تكذب ، وأصدقكم رؤيا أصدقكم حديثا ، ورؤيا المسلم جزء من خمسة وأربعين جزءا من النبوة ، والرؤيا ثلاث : فالرؤيا الصالحة بشرى من الله ، ورؤيا تحزين من الشيطان ، ورؤيا مما يحدث المرء نفسه ، فإذا رأى أحدكم ما يكره فليقم وليتفل ولا يحدث بها الناس ، وأحب القيد في النوم ، وأكره الغل القيد ثبات في الدين ) )(@)(@@) ( حم م د ت ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2080 ) قال النبي :(@)(@@) | 30 ( إذا اقتربت الساعة تقارب الزمان ، فتكون السنة كالشهر ، والشهر كالجمعة ، والجمعة إلى الجمعة كاحتراق السعفة في النار ) )(@)(@@) ( ع ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2081 ) قال النبي :(@)(@@) | 30 ( إذا أقحط أحدكم أو أكسل فإنما يكفي منه الوضوء ) )(@)(@@) عبد الرزاق عن رجل من الصحابة .(@)(@@)(@@)(@@) $ ( 2082 ) قال النبي :(@)(@@) | 30 ( إذا أقيمت الصلاة فلا تقوموا حتى تروني وعليكم السكينة ) )(@)(@@) ( حب ) عن أبي قتادة 
ms223	 رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2083 ) قال النبي :(@)(@@) | 30 ( إذا أقيمت الصلاة وأحدكم صائم فليبدأ بالعشاء ) )(@)(@@) ( طس ) عن أنس رضي الله عنه .(@)(@@) PageV01P305(@)(@@)(@@)(@@) $ ( 2084 ) قال النبي :(@)(@@) | 30 ( إذا أقيمت الصلاة فتحت أبواب السماء واستجيب الدعاء ، وإذا انصرف المنصرف من الصلاة ولم يقل : اللهم أجرني من النار وأدخلني الجنة وزوجني من الحور العين ، قالت الملائكة : يا ويح هاذا ، أعجز أن يستجير الله من جهنم ، وقالت الجنة : يا ويح هاذا أعجز أن يسأل الله الجنة ، وقالت الحور العين : يا ويح هاذا أعجز أن يسأل الله أن يزوجه من الحور العين ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2085 ) قال النبي :(@)(@@) | 30 ( إذا أقيمت الصلاة فلا صلاة إلا المكتوبة ، قيل : يا رسول الله ولا ركعتي الفجر ؟ فقال : ولا ركعتي الفجر ) )(@)(@@) ( عد هق ) وضعفاه عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2086 ) قال النبي :(@)(@@) | 30 ( إذا أقيمت الصلاة فلا صلاة إلا المكتوبة إلا ركعتي الصبح ) )(@)(@@) ( هق ) وضعفه عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2087 ) قال النبي :(@)(@@) | 30 ( إذا أقيمت الصلاة فليمش أحدكم على هينته فليصل ما أدرك وليقض ما سبق به ) )(@)(@@) ( طس ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2088 ) قال النبي :(@)(@@) | 30 ( إذا أكثبوكم فعليكم بالنبل ) )(@)(@@) ( خ ) عن حمزة بن أسيد عن أبيه .(@)(@@)(@@)(@@) $ ( 2089 ) قال النبي :(@)(@@) | 30 ( إذا أكثبوكم فارموهم بالنبل ولا تسلوا السيوف حتى يغشوكم ) )(@)(@@) ( د هق ) عن مالك بن حمزة بن أبي أسيد الساعدي عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 2090 ) قال النبي :(@)(@@) | 30 ( إذا أكل أحدكم فلا يمسح يده حتى يلعق أصابعه الثلاث ) )(@)(@@) ( حم ) و الدارمي وأبو عوانة ( حب ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2091 ) قال النبي :(@)(@@) | 30 ( إذا أكل الصائم ناسيا أو شرب ناسيا فإنما هو رزق ساقه الله ولا قضاء عليه ) )(@)(@@) ( قط ) وصححه عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2092 ) قال النبي :(@)(@@) | 30 ( إذا أكل أحدكم طعاما فلا يأكل من أعلا الصحفة PageV01P306 ولاكن ليأكل من أسفلها فإن البركة تنزل من أعلاها ) )(@)(@@) ( د ت ن ه ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2093 ) قال النبي :(@)(@@) | 30 ( إذا 
ms224	 أكل أحدكم مع أصحابه رطبا أو تمرا فقرن فليقل إني قارن ) )(@)(@@) ( حم م ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2094 ) قال النبي :(@)(@@) | 30 ( إذا أكل أحدكم فلا يأكل بشماله ، وإذا شرب فلا يشرب بشماله ، وإذا أخذ فلا يأخذ بشماله ، وإذا أعطى فلا يعط بشماله ) )(@)(@@) ( حب ) عن أبي قتادة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2095 ) قال النبي :(@)(@@) | 30 ( إذا أكل عند الصائم صلت عليه الملائكة ) )(@)(@@) ابن المبارك في الزهد وعبد الرزاق في المصنف عن أم عمارة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 2096 ) قال النبي :(@)(@@) | 30 ( إذا أكل أحدكم الطعام فليمص أصابعه فإنه لا يدر في أي طعامه تكون البركة ) )(@)(@@) ( هب ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2097 ) قال النبي :(@)(@@) | 30 ( إذا أكلت طعاما أو شربت شرابا فقل : بسم الله وبالله الذي لا يضر مع اسمه شيء في الأرض ولا في السماء ، يا حي يا قيوم ، لم يصبك منه داء ولو كان فيه سم ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2098 ) قال النبي :(@)(@@) | 30 ( إذا التقى الختانان فقد وجب الغسل ) )(@)(@@) الشافعي ( ه قط ) في الأفراد ( هق ) في المعرفة عن عائشة رضي الله عنها الخطيب في المتفق والمفترق عن إسماعيل بن رافع بن خديج عن أبيه .(@)(@@)(@@)(@@) $ ( 2099 ) قال النبي :(@)(@@) | 30 ( إذا التقى الختانان وتوارت الحشفة فقد وجب الغسل ) )(@)(@@) ( حم ش ه ) عن عمرو بن شعيب عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 2100 ) قال النبي :(@)(@@) | 30 ( إذا المسلمان حمل أحدهما على أخيه السلاح فهما PageV01P307 في جوف جهنم ، فإذا قتل أحدهما صاحبه دخلاها جميعا ) )(@)(@@) ( حم م ) عن أبي بكرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2101 ) قال النبي :(@)(@@) | 30 ( إذا أماط أحدكم الأذى عن لحية أخيه أو عن رأسه فليره إياه ثم يرم به فإن له بأخذه إياه حسنة وهي عشر وإذا أراه إياه ، حسنة وهي عشر ، وإذا رمى به فله حسنة وهي عشر ) )(@)(@@) الديلمي عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2102 ) قال النبي :(@)(@@) | 30 ( إذا أمسك الرجل وقتله الآخر يقتل الذي قتل ويحبس الذي أمسك ) )(@)(@@) ( عد هق ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2103 
ms225	 ) قال النبي :(@)(@@) | 30 ( إذا أم الرجل القوم فلا يختص بدعاء دونهم فإن فعل فقد خانهم ، ولا يدخل عينه في بيت قوم بغير إذنهم فإن فعل فقد خانهم ) )(@)(@@) ( هق ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2104 ) قال النبي :(@)(@@) | 30 ( إذا أنت قمت في صلاتك فكبر الله ثم اقرأ ما تيسر عليك من القرآن ، ثم إذا أنت ركعت فأثبت يديك على ركبتيك حتى يطمئن كل عضو منك ، ثم إذا رفعت رأسك فاعتدل حتى يرجع كل عضو فيك ، ثم إذا سجدت فاطمئن حتى يعتدل كل عضو منك ، ثم إذا رفعت ذالك فاثبت حتى يرفع كل عظم إلى موضعه ، ثم مثل ذالك ، فإذا جلست في وسط الصلاة فاطمئن وافترش فخذك اليسرى ثم تشهد ، ثم إذا قمت فمثل ذالك حتى تفرغ من صلاتك ) )(@)(@@) ( طب ) عن رفاعة بن رافع رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2105 ) قال النبي :(@)(@@) | 30 ( إذا أنزلت الماء فلتغسل ) )(@)(@@) ( ن ) عن أنس أن أم سليم رضي الله عنهما سألت رسول الله عن المرأة تحتلم قال فذكره .(@)(@@)(@@)(@@) $ ( 2106 ) قال النبي :(@)(@@) | 30 ( إذا انصرفت من صلاة المغرب فقل : اللهم أجرني من النار سبع مرات فإنك إذا قلت ذالك ثم مت في ليلتك كتب لك جوار منها ، وإذا صليت الصبح فقل كذالك فإنك إن مت من يومك كتب لك جوار منها ) )(@)(@@) ( د ) عن PageV01P308 الحارث بن مسلم بن الحارث التميمي عن أبيه .(@)(@@)(@@)(@@) $ ( 2107 ) قال النبي :(@)(@@) | 30 ( إذا أنعم الله على عبد نعمة فليبدأ بنفسه وأهل بيته ) )(@)(@@) ( طب ) عن جابر بن سمرة رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2108 ) قال النبي :(@)(@@) | 30 ( إذا أنكح الوليان فهو للأول منهما ، وإذا باع الرجل بيعا من رجلين فهو للأول منهما ) )(@)(@@) ( حم هق ) عن عقبة بن عامر ( ط هق ) عن سمرة رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2109 ) قال النبي :(@)(@@) | 30 ( إذا أنكح الوليان فهي امرأة الأول ، وإذا باع المجيران فالبيع للأول ) )(@)(@@) ( ص ) عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 2110 ) قال النبي :(@)(@@) | 30 ( إذا أنكح الوليان فالأول أحق ، وإذا باع المجيران فالأول أحق ) )(@)(@@) الشافعي ( هق ) عن رجل له صحبة ( طب ك ) عن سمرة 
ms226	 بن جندب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2111 ) قال النبي :(@)(@@) | 30 ( إذا أوى الرجل إلى فراشه أتاه ملك وشيطان فيقول الملك : إختم بخير ، ويقول الشيطان : اختم بشر ، فإذا ذكر الله ثم نام ذهب الشيطان وبات يكلؤه الملك ، فإذا استيقظ ابتدره ملك وشيطان قال الملك : افتح بخير ، وقال الشيطان : افتح بشر ، فإن قال إذا قام الحمد لله الذي رد علي نفسي ولم يمتها في منامها ، الحمد لله الذي يمسك السماء أن تقع على الأرض إلا باذنه إن الله بالناس لرؤوف رحيم ، الحمد لله الذي يمسك السماوات والأرض أن تزولا ولئن زالتا إن أمسكهما من أحد من بعده إنه كان حليما غفورا ، الحمد لله الذي يحيي الموتى وهو على كل شيء قدير ، فإن وقع عن سريره فمات دخل الجنة ، فإن قام فصلى صلى في الفضائل ) )(@)(@@) ابن نصر ( ع حب ك ض ) عن جابر رضي الله عنه .(@)(@@) PageV01P309(@)(@@)(@@)(@@) $ ( 2112 ) قال النبي :(@)(@@) | 30 ( إذا أوى أحدكم إلى فراشه فليأخذ داخلة إزاره فلينفض بها فراشه ويسمي الله فإنه لا يدري ما خلفه بعده على فراشه ، وإذا أراد أن يضطجع فليضطجع على شقه الأيمن وليقل : سبحانك ربي بك وضعت جنبي وبك أرفعه ، إن أمسكت نفسي فاغفر لها ، وإن أرسلتها فاحفظها بما حفظت به عبادك الصالحين ) )(@)(@@) ( حب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2113 ) قال النبي :(@)(@@) | 30 ( إذا أويت إلى فراشك فاقرأ قل يا أيها الكافرون ثم نم على خاتمها فإنها براءة من الشرك ) )(@)(@@) ( ت حب ك هب ) عن فروة بن نوفل عن أبيه ( طب ) عن جبلة بن حارثة الكلبي وهو أخو زيد بن حارثة رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2114 ) قال النبي :(@)(@@) | 30 ( إذا أويت إلى فراشك فقل : أعوذ بكلمات الله التامات من غضبه وعقابه ومن شر عباده ومن همزات الشياطين وأعوذ بك رب أن يحضرون ، فإنه لا يضرك وبالحرى أن لا يقربك ) )(@)(@@) ابن السنى وأبو نصر السجزى فى الإبانة عن محمد بن يحيى بن حبان مرسلا أن الوليد بن الوليد بن المغيرة شكى إلى رسول الله الأرق وحديث النفس بالليل 
ms227	 قال فذكره ابن السني عن محمد بن المنكدر قال : جاء رجل إلى النبي فشكى إليه أهاويل يراها في المنام قال فذكره ابن السني عن ابن عمرو رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2115 ) قال النبي :(@)(@@) | 30 ( إذا بات الضيف محروما فحق على المسلمين نصرته حتى يأخذوا قراه من ضرعه وزرعه ) )(@)(@@) ابن عساكر عن المقداد بن الأسود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2116 ) قال النبي :(@)(@@) | 30 ( إذا بادر أحدكم الحاجة فشاء أن يؤخر المغرب ويعجل العشاء ثم يصليهما جميعا فعل ) )(@)(@@) ابن جرير عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2117 ) قال النبي :(@)(@@) | 30 ( إذا بال أحدكم فليمسح ذكره ثلاث مرات ) )(@)(@@) ( ص ) عن يزداد رضي الله عنه .(@)(@@) PageV01P310(@)(@@)(@@)(@@) $ ( 2118 ) قال النبي :(@)(@@) | 30 ( إذا بال أحدكم أو تغوط فلا يستقبل القبلة ولا يستدبرها بفرجه ) )(@)(@@) ( طب ) عن أبي أيوب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2119 ) قال النبي :(@)(@@) | 30 ( إذا بايعت فقل لا خلابة ثم أنت بالخيار في كل سلعة ابتعتها ثلاث ليال ، فإن رضيت فأمسك ، وإن سخطت فاردد ) )(@)(@@) ( ت ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2120 ) قال النبي :(@)(@@) | 30 ( إذا بعت بيعا فلا تبعه حتى تقبضه ) )(@)(@@) ( ط ن ) عن حكيم بن حزام رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2121 ) قال النبي :(@)(@@) | 30 ( إذا بعث الله الخلائق يوم القيامة نادى مناد من تحت العرش ثلاثة أصوات : يا معشر الموحدين إن الله قد عفا عنكم فليعف بعضكم عن بعض ) )(@)(@@) ابن أبي الدنيا في ذم الغضب عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2122 ) قال النبي :(@)(@@) | 30 ( إذا بقي نصف من شعبان فلا تصوموا ) )(@)(@@) ( ت ) حسن صحيح عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2123 ) قال النبي :(@)(@@) | 30 ( إذا بعثتم إلي بريدا فابعثوه حسن الوجه ، حسن الإسم ) )(@)(@@) الديلمي وابن النجار عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2124 ) قال النبي :(@)(@@) | 30 ( إذا بقي ثلث الليل ينزل الله إلى سماء الدنيا فيقول : من ذا الذي يدعوني أستجيب له ، من ذا الذي يستغفرني أغفر له ، من ذا الذي يستكشف الضر أكشفه عنه ، من ذا الذي يسترزقني أرزقه حتى ينفجر الفجر ) )(@)(@@) ( ابن النجار ) عن أبي هريرة 
ms228	 رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2125 ) قال النبي :(@)(@@) | 30 ( إذا بقي ثلث الليل قال الله تبارك وتعالى : من الذي يستكشف الضر أكشف عنه ، من ذا الذي يسترزقني أرزقه ، من ذا الذي يسألني أعطيه ) )(@)(@@) ( ط هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2126 ) قال النبي :(@)(@@) | 30 ( إذا بقي ثلث الليل الباقي نزل الرحمان تبارك وتعالى PageV01P311 إلى سماء الدنيا فيبسط يده ألا داع يدعوني فأستجيب له ، ألا تائب يتوب فأتوب عليه ، ألا مستغفر يستغفرني فأغفر له ، حتى إذا طلع الفجر صعد على عرشه ) )(@)(@@) البغوي عن عبد الحميد بن أبي سلمة عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 2127 ) قال النبي :(@)(@@) | 30 ( إذا بلغ العبد أربعين سنة أمنه الله تعالى من البلايا الثلاث : الجنون والجذام والبرص ، فإذا بلغ خمسين سنة خفف الله عنه الحساب ، فإذا بلغ ستين سنة رزقه الله الإنابة إليه لما يحب ، وإذا بلغ سبعين سنة أحبه أهل السماء ، فإذا بلغ ثمانين سنة أثبت الله له حسناته ومحا سيئاته ، فإذا بلغ تسعين سنة غفر الله له ما تقدم من ذنبه وما تأخر ، وشفع في أهل بيته ، وناداه مناد من السماء هاذا أسير الله في أرضه ) )(@)(@@) ( ع ) و الخطيب عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2128 ) قال النبي :(@)(@@) | 30 ( إذا بلغ المرء المسلم خمسين سنة صرف الله عنه ثلاثة أنواع من البلاء : الجنون والجذام والبرص ، فإذا بلغ ستين سنة رزقه الله الإنابة إليه ، فإذا بلغ سبعين سنة محيت سيئاته وكتبت حسناته ، فإذا بلغ تسعين سنة غفر الله له ذنبه ما تقدم منه وما تأخر ، وكان أسير الله في الأرض وشفيعا لأهل بيته ) ( طب ) عن ع$ بد الله بن أبي بكر الصديق رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2129 ) قال النبي :(@)(@@) | 30 ( إذا بلغ البقر ثلاثين ففيها تبيع من البقر جذع أو جذعة حتى تبلغ أربعين فإذا بلغت أربعين ففيها بقرة مسنة ، فإذا كثرت البقر ففي كل أربعين من البقر بقرة مسنة ) )(@)(@@) ( حم ) ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2130 ) قال النبي :(@)(@@) | 30 ( إذا بلغ الغلام سبع سنين فأمروه بالصلاة ، فإذا بلغ عشرا 
ms229	 فاضربوه عليها ) )(@)(@@) ( ش ) عن سبرة بن معبد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2131 ) قال النبي :(@)(@@) | 30 ( إذا بلغ المؤمن ثمانين سنة فإنه أسير الله في الأرض تكتب له الحسنات وتمحى عنه السيئات ) )(@)(@@) ( ع ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2132 ) قال النبي :(@)(@@) | 30 ( إذا بلغ المرء المسلم أربعين سنة صرف الله عنه PageV01P312 ثلاثة أنواع من البلاء : الجنون والجذام والبرص ) )(@)(@@) ( ص ) الحكيم عن أبي بكر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2133 ) قال النبي :(@)(@@) | 30 ( إذا بلغ بنو الحكم ثلاثين رجلا اتخذوا مال الله بينهم دولا ، وعباد الله خولا ، وكتاب الله دخلا ، فإذا بلغوا تسعة وتسعين وأربعمائة كان هلاكهم أسرع من لوك تمرة ) )(@)(@@) ( طب هق ط ) عن ابن عباس ومعاوية رضي الله عنهما معا .(@)(@@)(@@)(@@) $ ( 2134 ) قال النبي :(@)(@@) | 30 ( إذا بلغ بنو أبي العاصي ثلاثين كان دين الله دغلا ، ومال الله نحلا وعباد الله خولا ) )(@)(@@) ( ع ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2135 ) قال النبي :(@)(@@) | 30 ( إذا بلغت بنو أمية أربعين رجلا ، اتخذوا عباد الله خولا ، ومال الله نحلا ، وكتاب الله نفلا ) )(@)(@@) نعيم بن حماد في الفتن عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2136 ) قال النبي :(@)(@@) | 30 ( إذا بلغت بنو أمية أربعين رجلا ، اتخذوا عباد الله خولا ، ومال الله دخلا وكتاب الله دغلا ) )(@)(@@) ( كر ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2137 ) قال النبي :(@)(@@) | 30 ( إذا تخوفت من أحد شيئا فقل : اللهم رب السماوات السبع وما فيهن ، ورب العرش العظيم ، ورب جبريل وميكائيل وإسرافيل كن لي جارا من فلان وأشباعه أن يفرطوا علي أو أن يطغوا علي أبدا عز جارك وجل ثناؤك ولا إلاه إلا أنت ولا حول ولا قوة إلا بك ) )(@)(@@) الخرائطي في مكارم الأخلاق عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2138 ) قال النبي :(@)(@@) | 30 ( إذا ترك العبد الدعاء للوالدين فإنه ينقطع عنه الرزق ) )(@)(@@) ( ك ) في التاريخ و الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2139 ) قال النبي :(@)(@@) | 30 ( إذا تزوج أحدكم عج شيطانه يقول : يا ويله عصم ابن آدم مني ثلثي دينه ) )(@)(@@) ( ع ) عن جابر رضي الله عنه 
ms230	 .(@)(@@) PageV01P313(@)(@@)(@@)(@@) $ ( 2140 ) قال النبي :(@)(@@) | 30 ( إذا تزوج أحدكم أو اشترى جارية أو فرسا أو خادما فليضع يده على ناصيتها وليدع بالبركة ) )(@)(@@) ( عد ) عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2141 ) قال النبي :(@)(@@) | 30 ( إذا تزوج أحدكم امرأة أو اشترى خادما فليقل : اللهم أسألك خيرها وخير ما جبلتها عليه ، وأعوذ بك من شرها وشر ما جبلتها عليه ، وإذا اشترى بعيرا فليأخذ بذروة سنامه وليقل مثل ذالك ) )(@)(@@) ( د ) عن عمرو بن شعيب عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 2142 ) قال النبي :(@)(@@) | 30 ( إذا تزوح العبد بغير إذن سيده كان عاهرا ) )(@)(@@) ( ه ) عن ابن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2143 ) قال النبي :(@)(@@) | 30 ( إذا تشهد المؤذن فقولوا بمثل ما يقول ) )(@)(@@) ابن النجار عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2144 ) قال النبي :(@)(@@) | 30 ( إذا تصدقت المرأة من بيت زوجها غير مفسدة فلها أجرها ولزوجها أجر ما اكتسب ولها أجر ما نوت وللخازن مثل ذالك ) )(@)(@@) ( حب ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 2145 ) قال النبي :(@)(@@) | 30 ( إذا تطهر أحدكم فليذكر اسم الله فإنه يطهر جسده كله ، وإن لم يذكر أحدكم اسم الله على طهوره لم يطهر إلا ما مر عليه الماء ، فإذا فرغ أحدكم من طهوره فليشهد أن لا إلاه إلا الله وأن محمدا عبده ورسوله ، فإذا قال ذالك فتحت له أبواب الرحمة ) )(@)(@@) الشيرازي في الألقاب ( هق ) وضعفه عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2146 ) قال النبي :(@)(@@) | 30 ( إذا تطهر الرجل فأحسن الطهور ثم أتى الجمعة ولم يلغ ولم يجهل حتى ينصرف الإمام كانت كفارة لما بينها وبين الجمعة ، وفي الجمعة ساعة لا يوافقها رجل يسأل الله عز وجل شيئا إلا أعطاه إياه ، والمكتوبات كفارات لما PageV01P314 بينهن ) )(@)(@@) ( حم ) و ابن خزيمة عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2147 ) قال النبي :(@)(@@) | 30 ( إذا تعلمت بابا من العلم كان خيرا لك من أن تصلي ألف ركعة تطوعا متقبلة ، وإذا علمت الناس عمل به أو لم يعمل به فهو خير لك من ألف ركعة تصليها تطوعا متقبلة ) )(@)(@@) الديلمي عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2148 
ms231	 ) قال النبي :(@)(@@) | 30 ( إذا تغوط الرجلان فليتوار كل منهما عن صاحبه ) )(@)(@@) ابن السكن عن جابر رضي الله عنه وصححه هو وابن القطان .(@)(@@)(@@)(@@) $ ( 2149 ) قال النبي :(@)(@@) | 30 ( إذا تغوط الرجلان فليتوار أحدهما عن صاحبه ولا يتحدثان على طرفهما فإن الله يمقت عليه ) )(@)(@@) الخطيب عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2150 ) قال النبي :(@)(@@) | 30 ( إذا تغوط أحدكم فليمسح بثلاثة أحجار فإن ذالك كافيه ) )(@)(@@) ( طب ) عن أبي أيوب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2151 ) قال النبي :(@)(@@) | 30 ( إذا تغولت لكم الغيلان فنادوا بالأذان ) )(@)(@@) ( ش ) و البزار عن جابر ( عد ) عن سعد بن أبي وقاص رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2152 ) قال النبي :(@)(@@) | 30 ( إذا تقارب الزمان أناخ بكم الشرف ، جاءتكم فتن كقطع الليل المظلم ) )(@)(@@) نعيم بن حماد في الفتن ( طب ) عن أبي هريرة رضي الله عنه ( وهو ضعيف ) .(@)(@@)(@@)(@@) $ ( 2153 ) قال النبي :(@)(@@) | 30 ( إذا تمضمض أحدكم واستنثر فليفعل ذالك مرتين بالغتين أو ثلاثا ) )(@)(@@) ( هق ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2154 ) قال النبي :(@)(@@) | 30 ( إذا تمضمض أحدكم حط ما أصاب بيديه ، وإذا غسل وجهه حط ما أصاب بوجهه ، وإذا غسل يديه حط ما أصاب بيديه ، وإذا مسح برأسه تناثرت خطاياه من أصول الشعر ، وإذا غسل قدميه حط ما أصاب برجليه ) )(@)(@@) ( طس ) عن أبي أمامة رضي الله عنه .(@)(@@) PageV01P315(@)(@@)(@@)(@@) $ ( 2155 ) قال النبي :(@)(@@) | 30 ( إذا تناول العبد كأس الخمر بيده ناشده الإيمان بالله لا تدخله علي فإني لا أستقر أنا وهو في وعاء واحد ، فإن أبى وشربه نفر الإيمان منه نفرة لن يعود إليه أربعين صباحا فإن تاب تاب الله عليه وسلبه من عقله شيئا لا يعود إليه أبدا ) )(@)(@@) الديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2156 ) قال النبي :(@)(@@) | 30 ( إذا تواجه المسلمان بسيفيهما فقتل أحدهما صاحبه فالقاتل والمقتول في النار ، قيل : يا رسول الله هاذا القاتل فما بال المقتول ؟ قال : إنه أراد قتل صاحبه ) )(@)(@@) ( ش حم ن طب ) عن أبي موسى ا ( ن طب ) عن أبي بكرة رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2157 ) قال النبي :(@)(@@) | 30 ( إذا توجهت إلى القبلة فكبر ثم 
ms232	 اقرأ بما شاء الله أن تقرأ ، فإذا ركعت فاجعل راحتيك على ركبتيك وامدد ظهرك وتمكن لركوعك ، فإذا رفعت فاجلس على فخذك اليسرى وافعل مثل ذالك في كل ركعة وسجدة ) )(@)(@@) ( طب ) عن رفاعة بن رافع رضي الله عنه .(@)(@@)(@@)(@@) $ 2158 قال النبي :(@)(@@) | 30 ( إذا توضأ العبد المؤمن فمضمض واستنشق تناثرت الخطايا من فيه ومنخره ، فإذا غسل وجهه تناثرت الخطايا من أشفار عينيه ، فإذا غسل يديه تناثرت الخطايا من أظفاره ، فإذا مسح رأسه تناثرت الخطايا من شعر رأسه ، فإذا غسل رجليه تناثرت الخطايا من أظفار رجليه ، فإذا انتهى عند ذالك كله كان ذالك حظه من وضوئه ، فإن قام وصلى ركعتين يقبل بقلبه وطرفه إلى الله خرج من الذنوب كما ولدته أمه ) )(@)(@@) ( هب ) عن عمرو بن عبسة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2159 ) قال النبي :(@)(@@) | 30 ( إذا توضأ العبد فأحسن الوضوء ثم قام إلى الصلاة فأتم ركوعها وسجودها والقراءة فيها ، قالت حفظك الله كما حفظتني ، ثم أصعد بها إلى السماء ولها ضوء ونور وفتحت لها أبواب السماء ، وإذا لم يحسن العبد الوضوء PageV01P316 ولم يتم الركوع والسجود والقراءة قالت : ضيعك الله كما ضيعتني ، ثم أصعد بها إلى السماء وعليها ظلمة ، وغلقت أبواب السماء ، ثم تلف كما يلف الثوب الخلق ثم يضرب بها وجه صاحبها ) )(@)(@@) ( عق طب ) عن عبادة بن الصامت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2160 ) قال النبي :(@)(@@) | 30 ( إذا توضأ العبد فغسل يديه خرت خطايه من يديه ، فإذا غسل وجهه خرت خطاياه من وجهه ، وإذا غسل ذراعيه خرت خطاياه من ذراعيه ، وإذا غسل رجليه خرت خطاياه من ذراعيه ، وإذا غسل رجليه خرت خطاياه من رجليه ) )(@)(@@) ( ش ) عن عمرو بن عبسة ( حم ) عن مرة بن كعب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2161 ) قال النبي :(@)(@@) | 30 ( إذا توضأ المسلم فغسل يديه كفرت به ما عملت يداه ، فإذا غسل وجهه كفرت عنه ما نظرت إليه عيناه ، فإذا مسح برأسه كفر به ما سمعت أذناه ، فإذا غسل رجليه كفرت عنه ما مشت إليه قدماه ، ثم يقوم إلى الصلاة فهي فضيلة ) )(@)(@@) ( طس ) عن أبي أمامة 
ms233	 رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2162 ) قال النبي :(@)(@@) | 30 ( إذا توضأ أحدكم للصلاة فليمضمض ثلاثا فإن الخطايا تخرج من وجهه ، ويغسل وجهه ويديه ثلاثا ، ويمسح برأسه ثلاثا ، ثم يدخل يديه في أذنيه ثم يفرغ على رجليه ثلاثا ) )(@)(@@) ( طس ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2163 ) قال النبي :(@)(@@) | 30 ( إذا توضأ الرجل فأحسن الوضوء ثم خرج إلى الصلاة لا يخرجه أو لا ينهزه إلا إياها ، لم يخط خطوة إلا رفعه الله بها درجة وحط عنه بها خطيئة ) )(@)(@@) ( ت ) حسن صحيح ( ه ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2164 ) قال النبي :(@)(@@) | 30 ( إذا توضأ أحدكم فليستنثر ، وإذا استجمر فليوتر ) )(@)(@@) عبد الرزاق عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2165 ) قال النبي :(@)(@@) | 30 ( إذا توضأ أحدكم فليستنشق بمنخريه من الماء ثم ليستنثر ، وإذا استجمر فليوتر ) )(@)(@@) عبد الرزاق عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2166 ) قال النبي :(@)(@@) | 30 ( إذا توضأت فأحسنت وضوءك ثم عمدت إلى المسجد PageV01P317 فإنك في صلاة فلا تشبك أصابعك ) )(@)(@@) عبد الرزاق عن كعب بن عجرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2167 ) قال النبي :(@)(@@) | 30 ( إذا توضأ أحدكم في بيته ثم خرج يريد الصلاة فلا يزال في صلاة حتى يرجع فلا تقولوا هاكذا ، ثم شبك الأصابع إحدى أصابع يديه بالأخرى ) )(@)(@@) عبد الرزاق عن كعب بن عجرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2168 ) قال النبي :(@)(@@) | 30 ( إذا توضأتم فأشربوا أعينكم الماء من الوضوء ، ولا تنفضوا أيديكم فإنها مراوح الشيطان ) )(@)(@@) الديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2169 ) قال النبي :(@)(@@) | 30 ( إذا توضأت فأبلغ في المضمضة والاستنشاق ما لم تكن صائما ) )(@)(@@) أبو بشير الدولابي فيما جمع من حديث الثوري عن عاصم بن لقيط عن أبيه .(@)(@@)(@@)(@@) $ ( 2170 ) قال النبي :(@)(@@) | 30 ( إذا توضأت فسال الناسور من قرنك إلى قدمك فلا وضوء عليك ) )(@)(@@) ( طب ) و ابن عساكر عن ابن عباس رضي الله عنهما أن رجلا قال : يا رسول الله إن بي الناسور وإني أتوضا فيسيل مني قال فذكره .(@)(@@)(@@)(@@) $ ( 2171 ) قال النبي :(@)(@@) | 30 ( إذا جاء أحدكم إلى القوم فاوسع له فليجلس فإنه كرامة من الله أكرمها 
ms234	 أخوه المسلم فإن لم يوسع له فلينظر أوسعها مكانا فليجلس فيه ) )(@)(@@) البغوي عن ابن شيبة .(@)(@@)(@@)(@@) $ ( 2172 ) قال النبي :(@)(@@) | 30 ( إذا جاء أحدكم الجمعة فليغتسل اغتساله من الجنابة ) )(@)(@@) أبو بكر العاقولي في فوائده عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2173 ) قال النبي :(@)(@@) | 30 ( إذا جاء شهر رمضان فتحت أبواب الجنة وغلقت أبواب النار وصفدت الشياطين ، ونادى مناد : يا طالب الخير هلم ، ويا طالب الشر أقصر حتى ينسلخ الشهر ) )(@)(@@) ( طب ) عن عتبة بن عبد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2174 ) قال النبي :(@)(@@) | 30 ( إذا جاء الرطب فهنئوني وإذا ذهب فعزوني ) )(@)(@@) ابن لآل في مكارم الأخلاق عن أنس وعائشة رضي الله عنهما معا .(@)(@@) PageV01P318(@)(@@)(@@)(@@) $ ( 2175 ) قال النبي :(@)(@@) | 30 ( إذا جاءك الرسول فهو إذنك ) )(@)(@@) ( ك ) في تاريخه و الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2176 ) قال النبي :(@)(@@) | 30 ( إذا جاءكم من ترضون دينه وخلقه فأنكحوه إلا تفعلوا تكن فتنة في الأرض وفساد عريض ) )(@)(@@) ( ت ) حسن غريب ( هق ) عن أبي حاتم المزني رضي الله عنه وما له غيره .(@)(@@)(@@)(@@) $ ( 2177 ) قال النبي :(@)(@@) | 30 ( إذا جامع أحدكم فأكسل فليتوضأ وضوءه للصلاة ) )(@)(@@) ( عب ) عن أبي أيوب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2178 ) قال النبي :(@)(@@) | 30 ( إذا جامع أحدكم أهله من الليل ثم أراد أن يعود فليتوضأ بينهما وضوءا ) ( ش ) عن أ$ بي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2179 ) قال النبي :(@)(@@) | 30 ( إذا جئتم والإمام راكع فاركعوا ، وإن كان ساجدا فاسجدوا ، ولا تعتدوا بالسجود إذا لم يكن معه الركوع ) )(@)(@@) ( هق ) عن رجل .(@)(@@)(@@)(@@) $ ( 2180 ) قال النبي :(@)(@@) | 30 ( إذا جئتم الجمعة فاغتسلوا ) )(@)(@@) ( حب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2181 ) قال النبي :(@)(@@) | 30 ( إذا جامع أحدكم فليستتر ولا يتجرد تجرد العيرين ) )(@)(@@) ابن سعد عن أبي قلابة مرسلا .(@)(@@)(@@)(@@) $ ( 2182 ) قال النبي :(@)(@@) | 30 ( إذا جاوز الختان الختان فقد وجب الغسل ، وأما الصلاة في ثوب واحد فتوشح به ، وأما ما يحل من الحائض فإنه يحل منها ما فوق الإزار واستعفاف عن ذالك أفضل ) )(@)(@@) ( طب ) عن معاذ رضي الله عنه ، حسن الهيثمي إسناده في مجمع الزوائد .(@)(@@)(@@)(@@) $ ( 2183 ) قال النبي :(@)(@@) | 30 ( إذا جاوز 
ms235	 الختان الختان وجب الغسل أنزل أو لم ينزل ) )(@)(@@) ( قط ) في الأفراد عن أبي هريرة وابن عباس رضي الله عنهم معا .(@)(@@) PageV01P319(@)(@@)(@@)(@@) $ ( 2184 ) قال النبي :(@)(@@) | 30 ( إذا جلس الإمام في آخر ركعة ثم أحدث رجل من خلفه قبل أن يسلم الإمام فقد تمت صلاته ) )(@)(@@) الخطيب عن ابن عمرو رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2185 ) قال النبي :(@)(@@) | 30 ( إذا جلس بين فروجها الأربع ثم أجهد فقد وجب الغسل أنزل أو لم ينزل ) )(@)(@@) ( ص ش ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2186 ) قال النبي :(@)(@@) | 30 ( إذا جلس أحدكم عند محتضر فلا يلح عليه بالشهادة فإنه يقولها بلسانه أو يومي بيده أو بطرفه أو بقلبه ) )(@)(@@) الديلمي عن أنس رضي الله عنه وفيه أبو بكر النقاش .(@)(@@)(@@)(@@) $ ( 2187 ) قال النبي :(@)(@@) | 30 ( إذا جلست المرأة في الصلاة وضعت فخذها على فخذها الأخرى فإذا سجدت ألصقت بطنها على فخذيها كأستر ما يكون لها ، فإن الله تعالى ينظر إليها يقول : يا ملائكتي أشهدكم أني قد غفرت لها ) )(@)(@@) ( عد هق ) وضعفه عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2188 ) قال النبي :(@)(@@) | 30 ( إذا جلستم إلى العلم أو في مجالس العلم فادنوا وليجلس بعضكم خلف بعض ، ولا تجلسوا متفرقين كما يجلس أهل الجاهلية ) )(@)(@@) أبو نعيم في آداب العالم والمتعلم والديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2189 ) قال النبي :(@)(@@) | 30 ( إذا جمع الله الأولين والآخرين فقضى بينهم وفرغ من القضاء قال المؤمنون : قد قضى بيننا ربنا تعالى فمن يشفع لنا إلى ربنا ؟ فيقولون : انطلقوا بنا إلى آدم فإنه أبونا وخلقه الله بيده وكلمه ، فيأتونه فيكلمونه أن يشفع لهم ، فيقول لهم آدم عليكم بنوح فيأتون نوحا فيدلهم على إبراهيم ، ثم يأتون إبراهيم فيدلهم على موسى ، ثم يأتون موسى فيدلهم على عيسى ، ثم يأتون عيسى فيقول أدلكم على النبي الأمي فيأتوني فيأذن الله لي أن أقوم إليه فيفور مجلسي من أطيب ريح شمها أحد قط حتى آتي ربي عز وجل فيشفعني ويجعل لي نورا من شعر PageV01P320 رأسي إلى ظفر قدمي ، ثم يقول الكافرون هاذا قد وجد المؤمنون 
ms236	 من يشفع لهم فمن يشفع لنا ؟ ما هو إلا إبليس فهو الذي أضلنا ، فيأتون إبليس فيقولون قد وجد المؤمنون من يشفع لهم فقم أنت فاشفع لنا فأنت أضللتنا فيقوم فيفور من مجلسه من أنتن ريح شمها أحد قط ثم يعظم لجهنم ويقول : الشيطان لما قضى الأمر إن الله وعدكم وعد الحق ووعدتكم فأخلفتكم إلى آخر الآية ) )(@)(@@) ابن المبارك وابن جرير وابن أبي حاتم ( طب ) وابن مروية وابن عساكر عن عقبة بن عامر رضي الله عنه وفيه عبد الرحمن بن زياد ( ضعيف ) .(@)(@@)(@@)(@@) $ ( 2190 ) قال النبي :(@)(@@) | 30 ( إذا جمع الله الناس فى صعيد واحد يوم القيامة أقبلت النار يركب بعضها بعضا وخزنتها يكفونها وهي تقول : وعزة ربي لتخلن بيني وبين أزواجي أو لأغشين الناس عنقا واحدا ، فيقولون : من أزواجك ؟ فتقول : كل متكبر جبار ، فيخرج لسانها فتلقطهم به من بين ظهراني الناس فتقذفهم في جوفها ، ثم تستأجر ثم تقبل يركب بعضها بعضا وخزنتها يكفونها وهي تقول : وعزة ربي لتخلن بيني وبين أزواجي أو لأغشين الناس عنقا واحدا ، فيقولون : ومن أزواجك ؟ فتقول : كل ختار كفور فتلقطهم بلسانها من بين ظهراني الناس فتقذفهم في جوفها ثم تستأخر ويقضي الله بين العباد ) )(@)(@@) ( ع ض ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2191 ) قال النبي :(@)(@@) | 30 ( إذا حاضت الجارية لم تقبل لها صلاة إلا بخمار ) )(@)(@@) ( ش ) عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 2192 ) قال النبي :(@)(@@) | 30 ( إذا حدث الإنسان حديثا فرأى المحدث المحدث يلتفت حوله فهي أمانة ) )(@)(@@) ( هب ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2193 ) قال النبي :(@)(@@) | 30 ( إذا حدثتك حديثا فلا تزيدن على أربع هن من أطيب الكلام وهن من القرآن ، لا يضرك بأيهن بدأت : سبحان الله والحمد لله ولا إلاه إلا الله والله أكبر ) )(@)(@@) ( ط ) عن سمرة رضي الله عنه .(@)(@@) PageV01P321(@)(@@)(@@)(@@) $ ( 2194 ) قال النبي :(@)(@@) | 30 ( إذا حدثتم عني بحديث تعرفونه ولا تنكرونه قلته أو لم أقله فصدقوا به فإني أقول ما يعرف ولا ينكر ، وإذا حدثتم عني بحديث تنكرونه ولا تعرفونه فكذبوا به ، فإني لا أقول ما ينكر ولا يعرف ) )(@)(@@) الحكيم 
ms237	 عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2195 ) قال النبي :(@)(@@) | 30 ( إذا حدثتم عني حديثا يوافق الحق فأنا قلته ) )(@)(@@) ( بز ) عن أبى هريرة رضى الله عنه وضعف .(@)(@@)(@@)(@@) $ ( 2196 ) قال النبي :(@)(@@) | 30 ( إذا حضر الانسان الوفاة جمع له كل شىء يمنعه عن الحق فيجعل بين عينيه ، فعند ذالك يقول : رب ارجعوني لعلي أعمل صالحا فيما تركت ) )(@)(@@) الديلمي عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2197 ) قال النبي :(@)(@@) | 30 ( إذا حضرت الجنازة فالإمام أحق بالصلاة عليها من غيره ) )(@)(@@) ابن منيع عن الحسين بن علي رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2198 ) قال النبي :(@)(@@) | 30 ( إذا حضرت الصلاة وحضر العشاء فابدؤوا بالعشاء ) )(@)(@@) ( حم م ) عن سل مة بن الأكوع ( حم طب ) عن أم سلمة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 2199 ) قال النبي :(@)(@@) | 30 ( إذا حضرت الصلاة وكان يأخذكم الغائط فليبدأ به ثم ليصل بعد ولا يأتي الصلاة وهو يدافع ) )(@)(@@) ( طب ) عن عبد الله بن الأرقم رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2200 ) قال النبي :(@)(@@) | 30 ( إذا حضرت الصلاة فلم تجدوا إلا مرابض الغنم وأعطان الإبل فصلوا في مرابض الغنم ولا تصلوا في أعطان الإبل ) )(@)(@@) ( هق ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2201 ) قال النبي :(@)(@@) | 30 ( إذا حضرت الصلاة والخلاء فابدؤوا بالخلاء ) )(@)(@@) الخطيب في المتفق والمفترق عن عبد الله بن الأرقم رضي الله عنه .(@)(@@) PageV01P322(@)(@@)(@@)(@@) $ ( 2202 ) قال النبي :(@)(@@) | 30 ( إذا حضرتم الميت فقولوا : سبحان ربك رب العزة عما يصفون وسلام على المرسلين والحمد لله رب العالمين ) )(@)(@@) ( ص ش ) و المروزي عن أم سلمة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 2203 ) قال النبي :(@)(@@) | 30 ( إذا حضر أحدكم الأمر يخشى فوته فليصل هاذه الصلاة ، يعني الجمع بين الصلاتين ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2204 ) قال النبي :(@)(@@) | 30 ( إذا حك في صدرك شيء فدعه ) )(@)(@@) ( هب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2205 ) قال النبي :(@)(@@) | 30 ( إذا حملتم فأخروا فإن اليدين مطلقة والرجلين موثقة ) )(@)(@@) الشيرازي في الألقاب والخطيب عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2206 ) قال النبي :(@)(@@) | 30 ( إذا حملتم فأخروا فإن اليد معلقة والرجل موثقة ) )(@)(@@) ( هق ) وضعفه عن أبي هريرة 
ms238	 رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2207 ) قال النبي :(@)(@@) | 30 ( إذا خرج العبد في حاجة أهله كتب الله تعالى له بكل خطوة درجة فإذا فرغ من حاجتهم غفر الله له ) )(@)(@@) الديلمي عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2208 ) قال النبي :(@)(@@) | 30 ( إذا خرج العبد من دار الشرك قبل سيده فهو حر ، وإذا خرج من بعده رد إليه ، وإذا خرجت المرأة من دار الشرك قبل زوجها تزوجت من شاءت ، وإذا خرجت من بعده ردت إليه ) )(@)(@@) ( قط ) في الإفراد و الديلمي عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2209 ) قال النبي :(@)(@@) | 30 ( إذا خرج أحدكم إلى سفر ثم قدم على أهله فليهدهم وليطرفهم ولو حجارة ) )(@)(@@) الديلمي عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 2210 ) قال النبي :(@)(@@) | 30 ( إذا خرج الرجل من بيته أو أراد سفرا فقال : بسم الله حسبي الله توكلت على الله قال الملك كفيت وهديت ووقيت ) )(@)(@@) ابن صصرى في أماليه وحسنه عن عون بن عبد الله بن عتبة مرسلا .(@)(@@) PageV01P323(@)(@@)(@@)(@@) $ ( 2211 ) قال النبي :(@)(@@) | 30 ( إذا خرج عليكم خارج وأنتم مع رجل جميعا يريد أن يشق عصى المسلمين ويفرق جمعهم فاقتلوه ) )(@)(@@) ( طب ) عن عبد الله بن عمير الأشجعي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2212 ) قال النبي :(@)(@@) | 30 ( إذا خرج الرجل إلى أخيه يعوده لم يزل يخوض الرحمة حتى إذا جلس عنده غمرته ) )(@)(@@) ابن جرير ( هب ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2213 ) قال النبي :(@)(@@) | 30 ( إذا خرجت إلى العشاء فلا تمسين طيبا ) )(@)(@@) ( حب ) عن زينب الثقفية رضي الله عنها .(@)(@@)(@@)(@@) $ ( 2214 ) قال النبي :(@)(@@) | 30 ( إذا خرجت إلى سفر فقل لمن تخلفه : أستودعكم الله الذي لا تضيع ودائعه ) )(@)(@@) ( حم ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2215 ) قال النبي :(@)(@@) | 30 ( إذا خرجتم في حج أو عمرة فتمتعوا لكيلا تتكلوا ، وأكرموا الخبز فإن الله تعالى سخر له بركات السماوات والأرض ) )(@)(@@) ( حل ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2216 ) قال النبي :(@)(@@) | 30 ( إذا خص العالم بالعلم طائفة دون طائفة لم ينتفع به العالم ولا المتعلم ) )(@)(@@) الديلمي عن ابن عمر رضي الله عنها .(@)(@@)(@@)(@@) $ ( 2217 ) قال النبي :(@)(@@) | 30 ( إذا 
ms239	 خطب إليكم من ترضون دينه وخلقه فزوجوه ، إلا تفعلوا تكن فتنة في الأرض وفساد عريض ) )(@)(@@) ( ت ه ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2218 ) قال النبي :(@)(@@) | 30 ( إذا دخل رمضان فتحت أبواب الجنة وغلقت أبواب النار وصفدت الشياطين ) )(@)(@@) ( ن ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2219 ) قال النبي :(@)(@@) | 30 ( إذا دخل أهل الجنة الجنة وأهل النار النار نادى مناد من تحت العرش : يا أهل المظالم تتاركوا مظالمكم وادخلوا الجنة ) )(@)(@@) ابن جرير عن أنس رضي الله عنه .(@)(@@) PageV01P324(@)(@@)(@@)(@@) $ ( 2220 ) قال النبي :(@)(@@) | 30 ( إذا دخل الإنسان قبره حف به عمله الصالح : الصلاة والصيام ، فيأتيه الملك عن نحو الصلاة فترده ، ومن نحو الصيام فيرده فيناديه اجلس فيجلس فيقول له : ما تقول في هاذا الرجل ؟ قال من ؟ قال : محمد ، فيقول : أشهد أنه رسول الله ، فيقول : وما يدريك أدركته ؟ قال : أشهد أنه رسول الله ، يقول على ذالك عشت وعليه مت وعليه تبعث ، وإن كان فاجرا أو كافرا جاءه الملك ليس بينه وبينه شيء يرده فأجلسه ويقول : ما تقول في هاذا الرجل ؟ قال وأي رجل ؟ قال : محمد ، فيقول : والله ما أدري ؟ سمعت الناس يقولون شيئا فقلته فيقول الملك : على ذالك عشت وعليه مت وعليه تبعث ، ويقيض له دابة في قبره سوداء مظلمة معها سوط ثمرته جمرة مثل عرف البعير فيضربه ما شاء الله مما لا تسمع صوته فترحمه ) )(@)(@@) ( حم طب ) عن أسماء بنت أبي بكر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2221 ) قال النبي :(@)(@@) | 30 ( إذا دخل أهل الجنة الجنة مر رجل فقال : يا رب ائذن لي في الزرع ، فقال الله له : هاذه الجنة كل منها حيث شئت ، فقال : يا رب ائذن لي في الزرع فأذن له ، فيبذر حبه فلا يلتفت حتى يعود كل سنبلة طولها ثنتا عشرة ذراعا ، ثم لا يبرح مكانه حتى يكون منه ركام أمثال الجبال ) )(@)(@@) أبو الشيخ في العظمة عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2222 ) قال النبي :(@)(@@) | 30 ( إذا دخل أحدكم المسجد كان في صلاة ما كانت الصلاة تحبسه والملائكة يصلون على أحدكم ما دام 
ms240	 في مجلسه الذي صلى فيه ، يقولون اللهم اغفر له ، اللهم ارحمه ، اللهم تب عليه ما لم يؤذ فيه ، ما لم يحدث فيه ) )(@)(@@) ( ش ) و ابن جرير عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2223 ) قال النبي :(@)(@@) | 30 ( إذا دخل أحدكم المسجد والامام على المنبر فلا صلاة ولا كلام حتى يفرغ الإمام ) )(@)(@@) ( طب ) عن ابن عمر رضي الله عنهما .(@)(@@) PageV01P325(@)(@@)(@@)(@@) $ ( 2224 ) قال النبي :(@)(@@) | 30 ( إذا دخل أحدكم المسجد فليقل : صلى الله على محمد ، اللهم افتح لي أبواب رحمتك واغلق عني أبواب سخطك ، واصرف عني الشيطان ووسوسته ) )(@)(@@) الديلمي عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2225 ) قال النبي :(@)(@@) | 30 ( إذا دخل أحدكم على أخيه المسلم فلا يخلع نعليه إلا باذنه ) )(@)(@@) الديلمي عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2226 ) قال النبي :(@)(@@) | 30 ( إذا دخل أحدكم المسجد صلى على النبي وقال : اللهم اغفر لنا ذنوبنا ، وافتح لنا أبواب رحمتك ، وإذا خرج صلى على النبي وقال : اللهم افتح لنا أبواب فضلك ) )(@)(@@) ( طس ) عن ابن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2227 ) قال النبي :(@)(@@) | 30 ( إذا دخل أحدكم الخلاء فليتمسح بثلاثة أحجار ) )(@)(@@) البغوي ( طب ) عن السائب بن خلاد الجهني قال البغوي وما له غيره .(@)(@@)(@@)(@@) $ ( 2228 ) قال النبي :(@)(@@) | 30 ( إذا دخل أحدكم على مريض فليصافحه وليضع يده على جبهته ، وليسأله كيف هو ؟ ولينسيء له في الأجل ، وليسأله أن يدعو له فإن دعاء المريض كدعاء الملائكة ) )(@)(@@) ( هب ) وضعفه عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2229 ) قال النبي :(@)(@@) | 30 ( إذا أدخل الميت القبر مثلت له الشمس عند غروبها فيجلس يمسح عينيه ويقول : دعوني أصلي ) )(@)(@@) ( ه حب ض ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2230 ) قال النبي :(@)(@@) | 30 ( إذا دخل أحدكم في الصلاة فلا يبزقن بين يديه ولا عن يمينه ، ولاكن تحت قدمه ) )(@)(@@) البزار عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2231 ) قال النبي :(@)(@@) | 30 ( إذا دخل شهر رمضان أمر الله حملة العرش أن يكفوا عن التسبيح ويستغفروا لامة محمد والمؤمنين ) )(@)(@@) الديلمي عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2232 ) قال النبي :(@)(@@) | 30 ( إذا دخل قوم منزل رجل كان رب المنزل أميرهم 