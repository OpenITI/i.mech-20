ms521	 بالأعمال ، ولاكن إنما دخلوها برحمة الله وسخاوة الأنفس وسلامة الصدور ورحمة لجميع المسلمين ) )(@)(@@) ( هب ) عن أبي سعيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4863 ) قال النبي :(@)(@@) | 30 ( إن إبراهيم ابني وإنه مات في الثدي ، وإن له ظئرين يكملان رضاعه في الجنة ) )(@)(@@) ( حم م ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4864 ) قال النبي :(@)(@@) | 30 ( إن إبر اهيم حرم بيت الله وأمنه وإني حرمت المدينة ما بين لابتيها ، لا يقلع عضاهها ، ولا يصاد صيدها ) )(@)(@@) ( م ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4865 ) قال النبي :(@)(@@) | 30 ( إن إبراهيم حرم مكة ، وإني حرمت ما بين لابتيها ، يريد المدينة ) )(@)(@@) ( حم م ) عن رافع بن خديج رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4866 ) قال النبي :(@)(@@) | 30 ( إن إبراهيم حرم مكة ودعا لها ، وإني حرمت المدينة كما حرم إبراهيم مكة ودعوت لها في مدها وصاعها مثل ما دعا إبراهيم لمكة ) )(@)(@@) ( حم ق ) عن عبد الله بن زيد المازني رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4867 ) قال النبي :(@)(@@) | 30 ( إن إبراهيم لما ألقي في النار لم يكن في الأرض دابة إلا أطفأت النار عنه غير الوزغ فإنها كانت تنفخ عليه ) )(@)(@@) ( حم ه حب ) عن PageV02P204 عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 4868 ) قال النبي :(@)(@@) | 30 ( إن أبر البر أن يصل الرجل أهل ود أبيه بعد أن يولي الأب ) )(@)(@@) ( حم خد م د ت ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4869 ) قال النبي :(@)(@@) | 30 ( إن أبغض الخلق إلى الله تعالى العالم يزور العمال ) )(@)(@@) ( ابن لال ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4870 ) قال النبي :(@)(@@) | 30 ( إن أبغض عباد الله إلى الله العفريت النفريت الذي لم يرزأ في مال ولا ولد ) )(@)(@@) ( هب ) عن أبي عثمان النهدي مرسلا .(@)(@@)(@@)(@@) $ ( 4871 ) قال النبي :(@)(@@) | 30 ( إن إبليس يبعث أشد أصحابه وأقوى أصحابه إلى من يصنع المعروف في ماله ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4872 ) قال النبي :(@)(@@) | 30 ( إن إبليس يضع عرشه على الماء ثم يبعث سراياه فأدناهم منه منزلة أعظمهم فتنة ، يجيء أحدهم فيقول فعلت كذا وكذا ، فيقول : ما صنعت شيئا ، ويجيء 
ms522	 أحدهم فيقول : ما تركته حتى فرقت بينه وبين أهله ، فيدنيه منه ويقول : نعم أنت ) )(@)(@@) ( حم م ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4873 ) قال النبي :(@)(@@) | 30 ( إن ابن آدم إن أصابه حر قال حس ، وإن أصابه برد قال حس ) )(@)(@@) ( حم طب ) عن خولة بنت قيس الأنصارية رضي الله عنها .(@)(@@)(@@)(@@) $ ( 4874 ) قال النبي :(@)(@@) | 30 ( إن ابن آدم لحريص على ما منع ) )(@)(@@) ( فر ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4875 ) قال النبي :(@)(@@) | 30 ( إن ابني آدم ضربا مثلا لهاذه الأمة فخذوا بالخير PageV02P205 منهما ) )(@)(@@) ( ابن جرير ) عن الحسن مرسلا ( ز ) .(@)(@@)(@@)(@@) $ ( 4876 ) قال النبي :(@)(@@) | 30 ( إن ابني هاذا سيد يعني الحسن ولعل الله أن يصلح به بين فئتين عظيمتين من المسلمين ) )(@)(@@) ( حم خ 3 ) عن أبي بكرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4877 ) قال النبي :(@)(@@) | 30 ( إن ابني هاذين ريحانتاي من الدنيا ) )(@)(@@) ( عد ) و ابن عساكر عن أبي بكرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4878 ) قال النبي :(@)(@@) | 30 ( إن أبواب الجنة تحت ظلال السيوف ) )(@)(@@) ( حم م ت ) عن أبي موسى ا رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4879 ) قال النبي :(@)(@@) | 30 ( إن أبواب الربا اثنان وسبعون حوبا ، أدناه كالذي يأتي أمه في الإسلام ) )(@)(@@) ( طب ) عن عبد الله بن سلام رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4880 ) قال النبي :(@)(@@) | 30 ( إن أبواب السماء تفتح عند زوال الشمس ، فلا ترتج حتى يصلي الظهر ، فاحب أن يصعد لي فيها خير ) )(@)(@@) ( حم ) عن أبي أيوب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4881 ) قال النبي :(@)(@@) | 30 ( إن أتقاكم وأعلمكم بالله أنا ) )(@)(@@) ( خ ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 4882 ) قال النبي :(@)(@@) | 30 ( إن أحب أسمائكم عند الله عبد الله وعبد الرحمان ) )(@)(@@) ( م ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4883 ) قال النبي :(@)(@@) | 30 ( إن أحب الضحايا إلى الله أغلاها وأسمنها ) )(@)(@@) ( هق ) PageV02P206 عن رجل ( ز ) .(@)(@@)(@@)(@@) $ ( 4884 ) قال النبي :(@)(@@) | 30 ( إن أحب الناس إلى الله تعالى يوم القيامة وأدناهم منه مجلسا : إمام عادل ، وأبغض الناس إلى الله تعالى وأبعدهم منه : إمام جائر ) )(@)(@@) ( حم ت ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4885 ) قال النبي :(@)(@@) | 30 
ms523	 ( إن أحب عباد الله إلى الله أنصحهم لعباده ) )(@)(@@) ( عم ) في زوائد الزهد عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 4886 ) قال النبي :(@)(@@) | 30 ( إن أحب عباد الله إلى الله من حبب إليه المعروف وحبب إليه فعاله ) )(@)(@@) ( ابن أبي الدنيا في قضاء الحوائج وأبو الشيخ ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4887 ) قال النبي :(@)(@@) | 30 ( إن أحبكم إلي وأقربكم مني الذي يلحقني على العهد الذي فارقني عليه ) )(@)(@@) ( ع ) عن أبي ذر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4888 ) قال النبي :(@)(@@) | 30 ( إن أحبكم إلي وأقربكم مني في الآخرة مجالس ، أحاسنكم أخلاقا ، وإن أبغضكم إلي وأبعدكم مني في الآخرة أسوؤكم أخلاقا : الثرثارون المتفيهقون المتشدقون ) ( حم حب طب هب ) عن أ$ بي ثعلبة الخشني رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4889 ) قال النبي :(@)(@@) | 30 ( إن أحب ما يقول العبد إذا استيقظ من نومه سبحان الذي يحيي الموتى وهو على كل شيء قدير ) )(@)(@@) ( خط ) عن ابن عمر رضي الله عنهما .(@)(@@) PageV02P207(@)(@@)(@@)(@@) $ ( 4890 ) قال النبي :(@)(@@) | 30 ( إن أحدا جبل يحبنا ونحبه ) )(@)(@@) ( ق ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4891 ) قال النبي :(@)(@@) | 30 ( إن أحدا جبل يحبنا ونحبه ، وهو على ترعة من ترع الجنة ، وعير على ترعة من ترع النار ) )(@)(@@) ( ه ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4892 ) قال النبي :(@)(@@) | 30 ( إن أحدكم إذا أراد أن يخرج من المسجد تداعت جنود إبليس واجتمعت كما تجتمع النحل على يعسوبها ، فإذا قام أحدكم على باب المسجد فليقل اللهم إني أعوذ بك من إبليس وجنوده فإنه إذا قالها لم يضره ) )(@)(@@) ( ابن السني ) عن أبي أمامة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4893 ) قال النبي :(@)(@@) | 30 ( إن أحدكم إذا قام في صلاته فإنه يناجي ربه ، وإن ربه بينه وبين القبلة ، فلا يبزقن أحدكم قبل قبلته ولاكن عن يساره أو تحت قدميه ) )(@)(@@) ( ق ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4894 ) قال النبي :(@)(@@) | 30 ( إن أحدكم إذا قام يصلي إنما يناجي ربه فلينظر كيف يناجيه ) )(@)(@@) ( ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4895 ) قال النبي :(@)(@@) | 30 ( إن أحدكم إذا قام يصلي جاء الشيطان فلبس عليه 
ms524	 حتى لا يدري كم صلى ، فإذا وجد ذالك أحدكم فليسجد سجدتين وهو جالس ) )(@)(@@) ( مالك ق د ن ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4896 ) قال النبي :(@)(@@) | 30 ( إن أحدكم إذا كان في الصلاة فإن الله قبل وجهه فلا يتنخمن أحد منكم قبل وجهه في الصلاة ) )(@)(@@) ( حم خ د ه ) عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 4897 ) قال النبي :(@)(@@) | 30 ( إن أحدكم إذا كان في صلاته فإنه يناجي ربه ، فلا PageV02P208 يبزقن بين يديه ولا عن يمينه ، ولاكن عن يساره وتحت قدمه ) )(@)(@@) ( ق ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4898 ) قال النبي :(@)(@@) | 30 ( إن أحدكم سيوشك أن يحب أن ينظر إلي نظرة بما له من أهل ومال ) )(@)(@@) ( طب ) و الضياء عن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4899 ) قال النبي :(@)(@@) | 30 ( إن أحدكم مرأة أخيه فإذا رأى به أذى فليمطه عنه ) )(@)(@@) ( ت ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4900 ) قال النبي :(@)(@@) | 30 ( إن أحدكم يأتيه الشيطان فيقول : من خلقك ؟ فيقول : الله ، فيقول : فمن خلق الله ؟ فإذا وجد ذالك أحدكم فليقل : آمنت بالله ورسوله ، فإن ذالك يذهب عنه ) )(@)(@@) ( م ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 4901 ) قال النبي :(@)(@@) | 30 ( إن أحدكم يأتيه الله برزق عشرة أيام في يوم ، فإن هو حبس عاش خمسة أيام بخير ، وإن هو وسع وأسرف قتر عليه تسعة أيام ) )(@)(@@) ( فر ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4902 ) قال النبي :(@)(@@) | 30 ( إن أحدكم يجمع خلقه في بطن أمه أربعين يوما نطفة ، ثم يكون علقة مثل ذالك ، ثم يكون مضغة مثل ذالك ، ثم يبعث الله إليه ملكا ويؤمر بأربع كلمات ويقال له : اكتب عمله ورزقه وأجله وشقي أو سعيد ، ثم ينفح فيه الروح ، فإن الرجل منكم ليعمل بعمل أهل الجنة حتى لا يكون بينه وبينها إلا ذراع فيسبق عليه الكتاب فيعمل بعمل أهل النار فيدخل النار ، وإن الرجل ليعمل بعمل أهل النار حتى ما يكون بينه وبينها إلا ذراع فيسبق عليه الكتاب فيعمل بعمل أهل الجنة فيدخل الجنة ) )(@)(@@) ( ق 4 ) عن ابن مسعود 
ms525	 رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4903 ) قال النبي :(@)(@@) | 30 ( إن أحساب أهل الدنيا الذي يذهبون إليه هاذا PageV02P209 المال ) )(@)(@@) ( حم ن حب ك ) عن بريدة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4904 ) قال النبي :(@)(@@) | 30 ( إن أحسن الحسن الخلق الحسن ) )(@)(@@) ( المسنغفري في مسلسلاته وابن عساكر ) عن الحسن بن علي رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4905 ) قال النبي :(@)(@@) | 30 ( إن أحسن الناس قراءة من إذا قرأ القرآن يتحزن فيه ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4906 ) قال النبي :(@)(@@) | 30 ( إن أحسن ما اختضبتم به هاذا السواد ، أرغب لنسائكم فيكم ، وأ هيب لكم في صدور عدوكم ) )(@)(@@) ( ه ) عن صهيب رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4907 ) قال النبي :(@)(@@) | 30 ( إن أحسن ما دخل الرجل على أهله إذا قدم من سفر أول الليل ) )(@)(@@) ( د ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4908 ) قال النبي :(@)(@@) | 30 ( إن أحسن ما زرتم به الله في قبوركم ومساجدكم البياض ) )(@)(@@) ( ه ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4909 ) قال النبي :(@)(@@) | 30 ( إن أحسن ما غيرتم به هاذا الشيب الحناء والكتم ) ( حم ( 4 ) حب ) عن أ$ بي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4910 ) قال النبي :(@)(@@) | 30 ( إن أحق الشروط أن توفوا به ما استحللتم به الفروج ) )(@)(@@) ( حم ق 4 ) عن عقبة بن عامر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4911 ) قال النبي :(@)(@@) | 30 ( إن أحق ما أخذتم عليه أجرا كتاب الله ) )(@)(@@) ( خ ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4912 ) قال النبي :(@)(@@) | 30 ( إن أخا صداء هو أذن ، ومن أذن فهو يقيم ) )(@)(@@) ( حم PageV02P210 ن ت ه ) عن زياد بن الحارث الصدائي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4913 ) قال النبي :(@)(@@) | 30 ( إن أخاكم النجاشي قد مات فقوموا فصلوا عليه ) )(@)(@@) ( م ن ) عن جابر رضي الله عنه ( حم م ت ن ه ) عن عمران بن حصين ( ه ) عن مجمع بن جارية رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4914 ) قال النبي :(@)(@@) | 30 ( إن أخاك محبوس بدينه فاقض عنه ) )(@)(@@) ( حم ه هق ) عن سعد بن الأطول رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4915 ) قال النبي :(@)(@@) | 30 ( إن أخوف ما أخاف على أمتي الأئم