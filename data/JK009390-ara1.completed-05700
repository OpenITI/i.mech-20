ms5681	 : ( يا طلحة لو قلت : ( بسم الله ) أو ذكرت الله لرفعتك الملائكة والناس ينظرون حتى تلج بك في جو السماء ) . ( أبو نعيم ) . )(@)(@@)(@@)(@@) $ 8944 عن سلمة بن الأكوع قال :(@)(@@) | 30 ( ابتاع طلحة بن عبيد الله رضي الله عنه بئرا بناحية الجبل وأطعم الناس ، فقال رسول الله : ( إنك يا طلحة الفياض ) . ( الحسن بن سفيان وأبو نعيم في المعرفة ، كر ) . )(@)(@@)(@@)(@@) $ 8945 عن أبي هريرة رضي الله عنه قال :(@)(@@) | 30 ( نظر رسول الله إلاى طلحة رضي الله عنه بمنى فقال : ( هاذا شهيد يمشي علاى وجه الأرض ) . ( كر ) . )(@)(@@) PageV17P016(@)(@@)(@@)(@@) $ 8946 عن أبي هريرة رضي الله عنه :(@)(@@) | 30 ( أن رسول الله قال : طلحة في الجنة ) ، فأقبل عمر علاى طلحة يهنئه ) . ( عد ، كر ) . )(@)(@@)(@@)(@@) $ 8947 عن عائشة رضي الله عنها قالت :(@)(@@) | 30 ( والله إني لفي بيتي ذات يوم ، ورسول الله وأصحابه في الفناء ، والستر بيني وبينهم ، إذ أقبل طلحة بن عبيد الله رضي الله عنه فقال رسول الله : ( من سره أن ينظر إلاى رجل يمشي علاى ظهر الأرض وقد قضاى نحبه فلينظر إلاى طلحة ) . ( ع ، كر ) . )(@)(@@)(@@)(@@) $ 8948 عن الزهري قال :(@)(@@) | 30 ( لما كان يوم أحد وانهزم المسلمون عن رسول الله حتى بقي في اثني عشر من المهاجرين والأنصار ، منهم طلحة بن عبيد الله رضي الله عنه ، فذهب رجل من المشركين يضرب وجه رسول الله بالسيف ، فوقاه طلحة بيده ، فلما أصاب طلحة السيف قال : حس ، فقال رسول الله : ( مه يا طلحة ألا قلت : ( بسم الله ) ؟ لو قلت : ( بسم الله ) وذكرت الله لرفعتك الملائكة والناس ينظرون ) . ( كر ) . )(@)(@@)(@@)(@@) $ 8949 عن أنس رضي الله عنه قال :(@)(@@) | 30 ( بينا طلحة رضي الله عنه يوم أحد واقف علاى النبي يستره من المشركين ، فأقبل رجل من المشركين يريد أن يضرب رسول الله ، فوقاه طلحة بيده ، فضرب المشرك يد طلحة فقال : حس ، فقال النبي : ( لو قلت : ( بسم الله ) لحملتك الملائكة ) . ( كر ) . )(@)(@@)(@@)(@@) $ 8950 عن أبي سعيد رضي الله عنه قال :(@)(@@) | 30 ( كنا جلوسا عند رسول الله ، فمر طلحة بن عبيد الله ، رضي الله عنه ، فقال : هاذا شهيد يمشي علاى 
ms5682	 وجه الأرض ) . ( كر ) . )(@)(@@)(@@)(@@) $ 8951 عن أسماء بنت أبي بكر رضي الله عنها قالت :(@)(@@) | 30 ( دخل طلحة بن عبيد الله علاى النبي ، فقال : ( يا طلحة أنت ممن قضاى نحبه ) . ( ابن منده ، كر ) . )(@)(@@) PageV17P017(@)(@@)(@@)(@@) $ 8952 عن طلحة رضي الله عنه قال :(@)(@@) | 30 ( كان بيني وبين عبد الرحمان بن عوف رضي الله عنه مال فقاسمته إياه ، فأراد شربا في أرضي فمنعته ، فأتاى النبي فشكاني إليه ، فقال النبي : ( أتشكو رجلا قد أوجف ) ؟ فأتاني فبشرني ، فقلت : يا أخي بلغ من هاذا المال ما تشكوني إلاى رسول الله ؟ قال : قد كان ذالك ، قال : فإني أشهد الله وأشهد رسول الله أنه لك ) . ( أبو نعيم كر وفيه سليمان الطلحي ) . )(@)(@@)(@@)(@@) $ 8953 عن طلحة رضي الله عنه قال :(@)(@@) | 30 ( كان رسول الله إذا رآني قال : سلفي في الدنيا ، وسلفي في الآخرة ) . ( أبو نعيم ، كر ، وفيه سليمان الطلحي ) . )(@)(@@)(@@)(@@) $ 8954 عن طلحة رضي الله عنه قال :(@)(@@) | 30 ( لما كان يوم أحد حملت النبي علاى عنقي حتى وضعته علاى الصخرة ، فاستتر بها عن المشركين ، فقال لي هاكذا وأومأ بيده إلاى وراء ظهره : ( هاذا جبريل يخبرني أنه لا يراك يوم القيامة في هول إلا أنقذك منه ) . ( كر ) . )(@)(@@)(@@)(@@) $ 8955 عن طلحة رضي الله عنه قال : $ 30 ( لما كان يوم أحد ارتجزت بهاذا الشعر :(@)(@@) نحن حماة غالب ومالك %~% نطذب عن رسولنا المبارك(@)(@@) نضرب عنه القوم في المعارك %~% ضرب صفاح الكوم في المبارك(@)(@@) وما انصرف رسول الله يوم أحد حتى قال لحسان : قل في طلحة رضي الله عنه ، فقال :(@)(@@) وطلحة يوم الشعب آساى محمدا %~% علاى ساعة ضاقت عليه وشقت(@)(@@) يقيه بكفيه الرماح وأسلمت %~% أشاجعه تحت السيوف فشلت(@)(@@) وكان إمام الناس إلا محمدا %~% أقام رحاى الاسلام حتى استقلت PageV17P018(@)(@@) وقال أبو بكر الصديق :(@)(@@) حماى نبي الهداى والخيل تتبعه %~% حتى إذا ما لقوا حامي عن الدين(@)(@@) صبرا علاى الطعن إذ ولت حماتهم %~% والناس من بين مهدي ومفتون(@)(@@) يا طلحة بن عبيد الله قد وجبت %~% لك الجنان وزوجت المها العين(@)(@@) وقال عمر رضي الله عن :(@)(@@) حماى نبي الهداى بالسيف منصلتا %~% لما تولى 
ms5683	 جميع الناس وانكشفوا(@)(@@) قال : فقال النبي : ( صدقت يا عمر ) . ( كر ، وفيه سليمان بن أيوب الطلحي ) . ) $(@)(@@)(@@)(@@) $ 8956 عن الزبير رضي الله عنه قال :(@)(@@) | 30 ( سمعت رسول الله يقول يومئذ يعني يوم أحد : أوجب طلحة حين صنع برسول الله ما صنع ) . ( ش ، ع ) . )(@)(@@)(@@)(@@) $ 8957 عن طلحة بن عبيد الله رضي الله عنه قال :(@)(@@) | 30 ( إن النبي مر بمجلس فيه أخلاط من المسلمين واليهود فسلم عليهم ) . ( ت : حسن صحيح ) . )(@)(@@)(@@)(@@) $ 8958 عن طلحة بن عبيد الله رضي الله عنه قال :(@)(@@) | 30 ( خرج رسول الله يعود عبدالله بن أبي من مرضه الذي مات فيه ، فلما دخل عليه عرف فيه الموت ، فقال : ( قد كنت أنهاك عن حب يهود ) قال : فقد أبغضهم أسعد بن زرارة فمات فما نفعه ، فلما مات أتاه ابنه فقال : يا رسول الله إن عبد الله بن أبي قد مات ، فأعطني قميصك أكفنه فيه ، فنزع رسول الله قميصه فأعطاه إياه ) . ( حم ، د ، والروياني ، طب ، ق في الدلائل ، ض ) . )(@)(@@)(@@)(@@) $ 8959 عن موساى بن طلحة عن أبيه قال :(@)(@@) | 30 ( سمى رسول الله ابنى موساى وعمران ) . ( ابن منده كر ) . )(@)(@@) PageV17P019(@)(@@)(@@)(@@) $ 8960 عن محمد بن الحنفية قال :(@)(@@) | 30 ( وقع بين علي وطلحة رضي الله عنها كلام ، فقال طلحة لعلي : ومن جرأتك أنك سميت باسمه وكنيت بكنيته ، وقد قال : ( لا يجتمعان وفي لفظ : قد نهاى رسول الله : أن يجمعهما أحد من أمته بعده فقال علي رضي الله عنه : إن الجريء من اجترأ علاى الله ورسوله ، ادعوا لي فلانا وفلانا لنفر من قريش فجاءوا فشهدوا أن رسول الله قال لعلي : إنه سيولد لك بعدي غلام وفي لفظ : ولد نحلته اسمي وكنيتي ، ولا يحل لأحد من أمتي بعده ) . ( ابن سعد ، كر ) . )(@)(@@)(@@)(@@) $ 8961 عن ابن الحنفية قال :(@)(@@) | 30 ( وقع بين طلحة وبين علي رضي الله عنهما كلام ، فقال لعلي : إنك تسمي باسمه ، وتكني بكنيته وقد نهاى رسول الله عن ذالك أن يجمعا لأحد من أمته فقال علي : إن الجريء من اجترأ علاى الله وعلاى رسوله ، يا فلان ادع لي فلانا وفلانا فجاء نفر 
ms5684	 من أصحاب رسول الله من قريش ، فشهدوا أن رسول الله رخص لعلي أن يجمعهما وحرمهما علاى أمته من بعده ) . ( كر ) . )(@)(@@)(@@)(@@) $ 8962 عن الربيع بن منذر عن أبيه قال :(@)(@@) | 30 ( كان بين علي وبين طلحة رضي الله عنهما كلام ، فقال علي : إن الجريء من اجترأ علاى الله وعلاى رسوله ، يا فلان ادع لي فلانا وفلانا فدعا نفرا من قريش ، فقال : بم تشهدون ؟ قالوا : نشهد أن رسول الله قال : سم باسمي وكن بكنيتي ولا تحل لأحد بعدك ) . ( كر ) . )(@)(@@)(@@)(@@) $ 8963 عن عبد الله بن شداد قال :(@)(@@) | 30 ( جاء ثلاثة نفر من بني عذرة إلاى النبي فأسلموا ، فقال النبي : من يكفيني هاؤلاء ؟ فقال طلحة رضي الله عنه : أنا ، قال : فكانوا عندي ، قال : فضرب علاى الناس بعثا ، فخرج فيهم أحدهم فاستشهد ، ثم مكثوا ما شاء 2 الله ، ثم ضرب بعثا آخر فخرج فيه الثاني فاستشهد وبقي الثالث حتى PageV17P020 مات علاى فراشه ، قال طلحة : فرأيت كأني أدخل الجنة فرأيتهم ، أعرفهم بأسمائهم وسيماهم ، قال : فإذا الذي مات علاى فراشه دخل أولهم ، وإذا الثاني من المستشهدين علاى إثره ، وإذا أولهم آخرهم ، قال : فدخلني من ذالك ، فأتيت النبي فذكرت ذالك له ، فقال رسول الله : ليس أحد أفضل عند الله من مؤمن يعمر في الإسلام لتكبيره وتحميده وتسبيحه وتهليله ) . ( ابن زنجويه ) . )(@)(@@)(@@)(@@) $ 8964 عن طلحة رضي الله عنه قال :(@)(@@) | 30 ( لقد عقرت يوم أحد في جميع جسدي حتى في ذكري ) . ( أبو نعيم ، كر ) . )(@)(@@)(@@)(@@) $ 8965 عن طلحة رضي الله عنه قال :(@)(@@) | 30 ( لما كان يوم أحد سماني النبي : طلحة الخير ، ويوم غزوة ذات العشيرة : طلحة الفياض ، ويوم حنين : طلحة الجود ) . ( أبو نعيم ، كر ) . )(@)(@@)(@@)(@@) $ 8966 عن موساى بن طلحة :(@)(@@) | 30 ( أن طلحة رضي الله عنه نحر جزورا ، وحفر بئرا يوم ذي قرد فأطعمهم وسقاهم ، فقال النبي : يا طلحة الفياض ، فسمي طلحة الفياض ) . ( أبو نعيم ) . )(@)(@@)(@@)(@@) $ 8967 عن طلحة رضي الله عنه قال :(@)(@@) | 30 ( كان رسول الله إذا قعد سأل عني وقال : ( مالي لا أراى الصبيح المليح الفصيح ) . ( أبو نعيم ، كر ، وفيه سليمان بن أيوب 
ms5685	 الطلحي ) . )(@)(@@)(@@)(@@) $ 8968 عن طلحة رضي الله عنه قال :(@)(@@) | 30 ( أتيت النبي وهو في جماعة من أصحابه وبيده سفرجلة يقلبها ، فلما أن جلست إليه رما بها نحوي ثم قال : ( دونكما أبا مجد فإنها تشد القلب ، وتطيب النفس ، وتذهب بطخاء الصدر ) . ( خط في المتفق ) . )(@)(@@) PageV17P021(@)(@@)(@@)(@@) $ 8969 عن طلحة رضي الله عنه قال :(@)(@@) | 30 ( الكسوة تظهر النعمة ، والدهن يظهر البؤس ، والإحسان إلاى الخادم يكبت الأعداء ) . ( كر ) . )(@)(@@)(@@)(@@) $ 8970 عن أبي عثمان النهدي قال :(@)(@@) | 30 ( لم يبق مع رسول الله في بعض تلك المواطن التي قاتل فيها غير سعد بن أبي وقاص ، وطلحة بن عبيد الله ، قيل له : وما أعلمك بهاذا ؟ قال : هما أخبراني بذالك ) . ( ع ، كر ) . )(@)(@@)(@@)(@@) $ 8971 عن طلحة رضي الله عنه قال :(@)(@@) | 30 ( لما رجع النبي من أحد ، صعد المنبر ، فحمد الله وأثنى عليه ثم قرأ هاذه الآية : { رجال صدقوا ما عاهدوا الله عليه } الآية كلها ، فقام إليه رجل فقال : يا رسول الله من هاؤلاء ؟ فأقبلت وعلي ثوبان دخضران ، فقال : ( أيها السائل هاذا منهم ) . ( كر ) . )(@)(@@)(@@)(@@) $ 8972 عن طلحة رضي الله عنه :(@)(@@) | 30 ( أن أصحاب رسول الله قالوا لأعرابي جاء يسأله عمن قضاى نحبه من هو ؟ وكانوا لا يجترئون علاى مسألته ، يوقرونه ويهابونه ، فسأله الأعرابي فأعرض عنه ، ثم سأله فأعرض عنه ، ثم إني طلعت من باب المسجد علاى ثياب خضر ، فلما رآني رسول الله قال : أين السائل عمن قضاى نحبه ؟ قال الأعرابي : أنا يا رسول الله قال : هاذا ممن قضاى نحبه ) . ( ت ، ع ، كر ) . )(@)(@@)(@@)(@@) $ 8973 عن طلحة رضي الله عنه قال : $ 30 ( كان النبي إذا رآني قال : ( من أحب أن ينظر إلاى شهيد يمشي علاى وجه الأرض فلينظر إلاى طلحة بن عبيد الله ) . ( كر ) .(@)(@@)(@@)(@@) $ 8974 عن طلحة رضي الله تعالى عنه :(@)(@@) | 30 ( كانت رحلة رسول الله وطنه إلي ، فأتاه رجلان يسأله أحدهما ، فقال : ذاك إلى طلحة بن عبيد الله ، فأتاني PageV17P022 فأعلمني فأبيت ، فرجع إلى النبي فأعلمه ، فقال له مثل ذلك ورجع إلي ، فقلت في نفسي : ما بعثه إلي وهو يحب أن يقضي حاجته ، وكان رسول 
ms5686	 الله لا يكاد يسأل شيئا إلا فعله ، فقلت : لأن ألي أمر رسول الله أحب إلي من أن ألي أمر رحلته ، فدفعتها إليه ، فأراد النبي سفرا فأمر أن يرحل له ، فأتاني فقيل : أي الرحلتين كانت أحب إلى رسول الله ؟ فقلت الطائفية ، فرحلها له ثم قربها إليه ، فلما نارت به ، انكبت به ، فقال : من رحل به ؟ قالوا : فلان ، قال : ردوها إلى طلحة ، والله ما غششت أحدا في الإسلام غيره لكي ترجع رحله رسول الله إلي ) ( كر ، وفيه سليمان بن أيوب الطلحي ) . )(@)(@@)(@@)(@@) $ 8975 عن السائب بن يزيد قال :(@)(@@) | 30 ( صحبت طلحة بن عبيد الله وسعدا والمقداد وعبد الرحمان بن عوف ، فما سمعت أحدا منهم يحدث عن رسول الله ، إلا أني سمعت طلحة رضي الله عنه يحدث عن يوم أحد ) . ( الشاشي ، كر ) . )(@)(@@)(@@)(@@) $ 8976 عن ربيعة بن أبي عبد الرحمان قال : $ 30 ( سمعت رجلا من آل الهدير يقول : صحبت طلحة بن عبيد الله رضي الله عنه فما سمعته يحدث عن رسول الله قط غير حديث واحد ) . ( كر ) .(@)(@@) PageV17P023(@)(@@)(@@)(@@) |||| ( 8 مسند الزبير بن العوام رضي الله عنه )(@)(@@)(@@)(@@) $ 8977 عن الزبير رضي الله عنه قال :(@)(@@) | 30 ( سألت جابرا عن الورود ؟ قال جابر رضي الله عنه : سمعت رسول الله يقول : يتجلى لهم ربهم ضاحكا ) . ( ت ، ط في الصفات ) . )(@)(@@)(@@)(@@) $ 8978 عن أبي رجاء قال :(@)(@@) | 30 ( صلى بنا الزبير رضي الله عنه صلاة فخفف ، فقيل له ، فقال : إني أبادر الوسواس ) . ( عب ) . )(@)(@@)(@@)(@@) $ 8979 عن الزبير رضي الله عنه :(@)(@@) | 30 ( أن رجلا قال له : ما شأنكم يا أصحاب رسول الله أخف الناس صلاة ؟ قال : نبادر الوسواس ) . ( كر وابن النجار ) . )(@)(@@)(@@)(@@) $ 8980 عن هشام بن عروة بن الزبير قال :(@)(@@) | 30 ( جاء عمر بن عبد العزيز قبل أن يستخلف إلاى أبي ، فقال له : رأيت البارحة عجبا ، كنت فوق سطحي مستلقيا علاى فراشي ، فسمعت جلبة في الطريق ، فأشرفت فظننت عسكر العسس ، فإذا الشياطين تجول كردوسا كردوسا حتى اجتمعوا إلاى خربة خلف منزلي ، قال : ثم جاء إبليس ، فلما اجتمعوا هتف إبليس بصوت عال ، فتسارعوا ، فقال : من لي بعروة 
ms5687	 بن الزبير ؟ فقالت طائفة منهم : نحن فذهبوا ورجعوا ، وقالوا : ما قدرنا منه علاى شيء ، فصاح الثانية أشد من الأولاى ، فقال : من لي بعروة بن الزبير ؟ فقالت طائفة أخراى : نحن فذهبوا فلبثوا طويلا ، ثم رجعوا وقالوا : ما قدرنا منه علاى شيء ، فصاح الثالثة صيحة ظننت أن الأرض قد انشقت ، فتسارعوا ، فقال : من لي بعروة بن الزبير ؟ فقال جماعتهم : نحن ، فذهبوا فلبثوا طويلا ، ثم رجعوا ، فقالوا : ما قدرنا منه علاى شيء ، فذهب إبليس مغضبا ، فاتبعوه ، فقال عروة بن الزبير لعمر بن عبد العزيز : حدثني أبي الزبير بن العوام رضي الله عنه ، قال : سمعت رسول الله يقول : ما من PageV17P024 رجل يدعو بهاذا الدعاء ، في أول ليله وأول نهاره إلا عصمه الله من إبليس وجنوده : بسم الله الرحمان الرحيم ذي الشأن ، عظيم البرهان ، شديد السلطان ، ما شاء الله كان ، أعوذ بالله من الشيطان ) . ( كر ) . )(@)(@@)(@@)(@@) $ 8981 عن عروة قال :(@)(@@) | 30 ( كان الزبير رضي الله عنه قاعدا ورجل يقول : قال رسول الله عامة مجلسه ، فسكت الزبير حتى انقضت مقالته ، فقال الزبير : ما قال رسول الله شيئا من هاذا ، قال : والله إنك لحاضر المجلس يومئذ ، قال : صدقت ، إنما قال رسول الله قبل أن تجيء ، قال رجل من أهل الكتاب فجعل يذكر عنه فجئت وهو يذكر ذالك ، فذكر الذي يمنعني من الحديث عن النبي ) . ( كر ) . )(@)(@@)(@@)(@@) $ 8982 عن الزبير رضي الله عنه قال :(@)(@@) | 30 ( سخا رسول الله بأنفسنا عن أولادنا ، فقال : من مات له ثلاثة من الولد لم يبلغوا الحنث كانوا له حجابا من النار ) . ( أبو عوانة عن أنس رضي الله عنه ، قط في الأفراد عن الزبير بن العوام رضي الله عنه ) . )(@)(@@)(@@)(@@) $ 8983 عن منكدر ، عن محمد بن المنكدر قال :(@)(@@) | 30 ( دخل الزبير رضي الله عنه علاى رسول الله فقال : كيف أصبحت جعلنا الله فداك ؟ فقال : ( ما تركت أعرابيتك ) . ( ابن جرير وقال : هاذا مرسل رواه المنكدر بن محمد عند أهل النقل ممن لا يعتمد علاى نقله ) . )(@)(@@)(@@)(@@) $ 8984 عن سليمان بن يسار :(@)(@@) | 30 ( أن زيد بن ثابت والزبير بن العوام 
ms5688	 رضي الله عنهما قالا : إذا ابتاع الرجل الثمرة علاى رؤس النخل فلا بأس أن يبيعها قبل أن يصرمها ) . ( عب ) . )(@)(@@)(@@)(@@) $ 8985 عن سفيان بن وهب الخولاني ، قال :(@)(@@) | 30 ( لما فتحنا مصر بغير عهد ، قام PageV17P025 الزبير بن العوام رضي الله عنه ، فقال : اقسمها يا عمرو بن العاص ، فقال عمرو : لا أقسمها ، فقال الزبير : والله لتقسمنها كما قسم رسول الله خيبر ، فقال : والله لا أقسمها حتى أكتب إلاى أمير المؤمنين ، فكتب عمر رضي الله عنه إليه : أقرها حتى تغزو منها حبل الحبلة ) . ( ابن عبد الحكم في فتوح مصر وابن وهب وأبو عبيدة وابن زنجويه معا في الأموال ق ، كر ) . )(@)(@@)(@@)(@@) $ 8986 عن سعد بن إبراهيم بن عبد الرحمان بن عوف :(@)(@@) | 30 أن عبد الرحمان بن عوف كان مع عمر بن الخطاب رضي الله عنهما وأن محمد بن مسلمة كسر سيف الزبير ، ثم قام أبو بكر رضي الله عنه فخطب الناس واعتذر إليهم وقال : ( والله ما كنت حريصا علاى الإمارة يوما ولا ليلة قط ، ولا كنت فيها راغبا ، ولا سألتها الله في سر ولا علانية ، ولاكني أشفقت من الفتنة ، وما لي في الإمارة من راحة ، ولاكني قلدت أمرا عظيما ما لي به طاقة ، ولا يد ، إلا بتقوية الله عز وجل ، ولوددت أن أقواى الناس عليها مكاني اليوم ، فقبل المهاجرون منه ما قال وما اعتذر به ، وقال علي والزبير رضي الله عنه وما غضبنا إلا لأنا أخرنا عن المشاورة ، وإنا نراى أبا بكر رضي الله عنه أحق الناس بها بعد رسول الله ، إنه لصاحب الغار ، وثاني اثنين ، وإنا لنعرف شرفه وكبره ، ولقد أمره رسول الله بالصلاة بالناس وهو حي ) . ( ك ، هق ) . )(@)(@@)(@@)(@@) $ 8987 عن عبد الله بن الزبير قال :(@)(@@) | 30 ( قدمت مع الزبير رضي الله عنه من الشام من غزوة اليرموك ، فكنت أراه يصلي علاى راحلته حيث توجهت به ) . ( كر ) . )(@)(@@)(@@)(@@) $ 8988 عن الزبير رضي الله عنه :(@)(@@) | 30 ( أنه ملك يوم الطائف خالات له فأعتقهن بملكه إياهن ) . ( ش ) . )(@)(@@)(@@)(@@) $ 8989 عن الحكم بن عتبة قال :(@)(@@) | 30 ( اختصم علي والزبير 
ms5689	 إلاى عمر رضي الله عنه في موالي صفية ، فقال علي رضي الله عنهم : عمتي وأنا أعقل عنها وأرثها ، PageV17P026 وقال الزبير رضي الله عنه : أمي وأنا أرثها ، فقال عمر لعلي : أما علمت أن رسول الله جعل الولاء تبعا للميراث فقضاى به للزبير ) . ( ابن رالويه ) . )(@)(@@)(@@)(@@) $ 8990 عن عروة :(@)(@@) | 30 ( أن الزبير ورافع بن خديج رضي الله عنه اختصما إلاى عثمان رضي الله عنهما في مولاة لرافع بن خديج كانت تحت عبد فولدت منه أولادا ، ااشتراى الزبير العبد فأعتقه فقضاى عثمان رضي الله عنه بالولاء للزبير ) . ( ق ) . )(@)(@@)(@@)(@@) $ 8991 عن عبد الله بن الزبير :(@)(@@) | 30 ( أن الزبير رضي الله عنه كانت عليه ملاءة صفراء يوم بدر فاعتم بها ، فنزلت الملائكة معتمين بعمائم صفر ) . ( كر ) . )(@)(@@)(@@)(@@) $ 8992 عن أبي جعفر قال :(@)(@@) | 30 ( كانت علاى الزبير بن العوام يوم بدر عمامة صفراء ، فنزلت الملائكة وعليهم عمائم صفر ) . ( كر ) . )(@)(@@)(@@)(@@) $ 8993 عن أبي المليح عن أبيه قال :(@)(@@) | 30 ( نزلت الملائكة يوم بدر عليها العمائم ، وكانت علاى الزبير يومئذ عمامة صفراء ) . ( طب ، ك ) . )(@)(@@)(@@)(@@) $ 8994 حدثنا أبو كريب ، حدثنا وكيع عن سفيان عن عبد الكريم الجزري ، عن عكرمة قال :(@)(@@) | 30 ( لما كان يوم الخندق قام رجل من المشركين فقال : من يبارز ؟ فقال رسول الله : ( قم يا زبير ) ، فقالت صفية : يا رسول الله واجدي ، فقال رسول الله : ( قم يا زبير ) ، فقام ، فقال رسول الله : ( أيهما علا صاحبه قتله ) ، فعلاه الزبير رضي الله عنه فقتله ، ثم جاء النبي بسلبه فنفله إياه ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 8995 عن عكرمة قال :(@)(@@) | 30 ( لما كان يوم بنى قريظة قال رجل من يهود : من يبارز ؟ فقام إليه الزبير رضي الله عنه فبارزه فقالت صفية : واجدي ، فقال رسول PageV17P027 الله : ( أيهما علا صاحبه قتله ) ، فعلاه الزبير فقتله ، فنفله النبي سلبه ) . ( كر ) . )(@)(@@)(@@)(@@) $ 8996 قال الزبير بن بكار : حدثني إبراهيم بن حمزة ، حدثني محمد بن عثمان بن أبي حرملة مولاى بني عثمان عن الحسين بن علي رضي الله عنهما قال :(@)(@@) | 30 ( كان ممن ثبت مع رسول الله يوم حنين : العباس وعلي وأبو سفيان 
ms5690	 بن الحارث ، وعقيل بن أبي طالب ، وعبد الله بن الزبير بن عبد المطلب ، والزبير بن العوام ، وأسامة بن زيد رضي الله عنهم ) . ( كر ) . )(@)(@@)(@@)(@@) $ 8997 عن محمد بن عثمان بن أبي حرملة مولاى بني عثمان عن الحسين بن علي رضي الله عنهما قال :(@)(@@) | 30 ( كان ممن ثبت مع النبي يوم حنين : العباس ، وعلي ، وأبو سفيان بن الحارث ، وعقيل بن أبي طالب ، وعبد الله بن الزبير بن عبد المطلب ، والزبير بن العوام ، وأسامة بن زيد رضي الله عنهم ) . ( كر ) . )(@)(@@)(@@)(@@) $ 8998 عن قتادة قال :(@)(@@) | 30 ( لما ولي الزبير يوم الجمل بلغ عليا فقال : لو كان ابن صفية يعلم أنه علاى الحق ما ولي وذالك أن النبي لقيهم في سقيفة بني ساعدة فقال : أتحبه يا زبير ؟ قال : وما يمنعني ؟ قال : فكيف بك إذا قاتلته وأنت ظالم له ؟ قال : فيرون أنه إنما ولي لذالك ) . ( ق في الدلائل ) . )(@)(@@)(@@)(@@) $ 8999 عن أبي الأسود الدؤلي قال :(@)(@@) | 30 ( لما دنا علي رضي الله عنه وأصحابه من طلحة والزبير ، ودنت الصفوف بعضها من بعض خرج علي وهو علاى بغلة رسول الله فناداى : ادعوا لي الزبير بن العوام فدعي له الزبير رضي الله عنه فأقبل ، فقال علي : يا زبير نشدتك بالله ، أتذكر يوم مر بك رسول الله ونحن في مكان كذا وكذا ، فقال : ( يا زبير أتحب عليا ) ؟ فقلت : ألا أحب ابن خالي وابن عمتي وعلاى ديني ؟ فقال : ( يا علي أتحبه ) ؟ فقلت : يا رسول الله ألا أحب ابن PageV17P028 عمتي وعلاى ديني ؟ فقال : ( يا زبير أما والله لتقاتلنه وأنت ظالم له ) قال : بلاى والله لقد نسيته منذ سمعته من رسول الله ثم ذكرته الآن ، والله لا أقاتلك فرجع الزبير ، فقال له ابنه عبد الله : مالك ؟ فقال : ذكرني علي حديثا سمعته من رسول الله ، سمعته يقول : لتقاتلنه وأنت له ظالم ، قال : وللقتال جئت ؟ إنما جئت تصلح بين الناس ، ويصلح الله بك هاذا الأمر ، قال : لقد حلفت أن لا أقاتله ، قال : فأعتق غلامك وقف حتى تصلح بين الناس ، فأعتق غلامه ووقف ، فلما اختلف أمر الناس 
ms5691	 ذهب علاى فرسه ) . ( هق في الدلائل ، كر ) . )(@)(@@)(@@)(@@) $ 9000 عن الوليد بن عبد الله عن أبيه :(@)(@@) | 30 ( أن ابن جرموز لما قتل الزبير رضي الله عنه جاء إلاى علي ومعه سيف الزبير ، فقال علي : سيف طالما جلي به الكرب عن وجه رسول الله ولاكن لكل جنب مصرع ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9001 عن أبي نضرة قال :(@)(@@) | 30 ( جيء برأس الزبير إلاى علي رضي الله عنهما فقال : يا أعرابي حدثني رسول الله وأنا إلاى جنبه قاعد أن قاتل الزبير في النار ، يا أعرابي تبوأ مقعدك من النار ) . ( كر ، ورجاله ثقات وله طرق عن علي ) . )(@)(@@)(@@)(@@) $ 9002 عن مسلم بن نذير قال :(@)(@@) | 30 ( جاء ابن جرموز فاستأذن علاى علي رضي الله عنه فأبطأ عليه الاذن ، فقال : أنا قاتل الزبير فقال علي : أبقتل ابن صفية تفتخر ؟ فلتبوأ مقعدك من النار إن لكل نبي حواريا ، وإنه حواري رسول الله ) . ( ابن أبي خيثمة ، كر ) . )(@)(@@)(@@)(@@) $ 9003 عن زر قال :(@)(@@) | 30 ( استأذن ابن جرموز قاتل الزبير ابن العوام رضي الله عنه علاى علي بن أبي طالب ، فقال علي : ليدخلن قاتل ابن صفية النار إني سمعت رسول الله يقول : ( لكل نبي حواري ، وحواريي الزبير ) . ( ط : ش والشاشي : ع وابن جرير ، وصححه ) . )(@)(@@) PageV17P029(@)(@@)(@@)(@@) $ 9004 عن حسن بن علي بن حسن بن حسن بن الحسنبن علي بن أبي طالب قال :(@)(@@) | 30 ( جاء عمرو بن جرموز إلاى علي بن أبي طالب بسيف الزبير رضي الله عنهما فأخذه علي فنظر إليه ثم قال : أما والله لرب كربة وكربة قد فرجها صاحب هاذا السيف عن وجه رسول الله ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9005 عن الحسن قال :(@)(@@) | 30 ( لما ظفر علي بالجمل ، دخل الدار والناس معه ، قال علي رضي الله عنه : إني لأعلم قائد فتنة دخل الجنة وأتباعه إلاى النار ، فقال الأحنف : من هو يا أمير المؤمنين ؟ قال : الزبير ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9006 عن نذير الضبي :(@)(@@) | 30 ( أن عليا دعا الزبير رضي الله عنهما وهو بين الصفين فقال : أنت آمن تعال حتى أعلمك فأتاه فقال علي رضي الله عنه : أنشدك بالله الذي بعث محمدا بالحق 
ms5692	 نبيا أخرج النبي يمشي وأنا وأنت معه فضرب كتفك ثم قال لك : ( كأنك يا زبير قد قاتلت هاذا ) ؟ قال : اللهم نعم ، فرجع ) ( كر ) . )(@)(@@)(@@)(@@) $ 9007 عن ابن عباس رضي الله عنهما قال :(@)(@@) | 30 ( قال علي للزبير رضي الله عنهما : نشدتك بالله هل تعلم أني كنت أنا وأنت في سقيفة بني فلان تعالجني وأعالجك ، فمر بي رسول الله فقال لي : ( كأنك تحبه ) قلت : وما يمنعني ؟ قال : ( أما إنه ليقاتلنك وهو الظالم ) ؟ قال الزبير : اللهم نعم ، ذكرتني ما قد نسيت ، فولى راجعا ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9008 عن أم راشد قالت :(@)(@@) | 30 ( سمعت طلحة والزبر رضي الله عنه يقول أحدهما لصاحبه : بايعته أيدينا ولم تبايعه قلوبنا ، فقلت لعلي رضي الله عنه ، فقال علي : ( من نكث فإنما ينكث علاى نفسه ومن أوفى بما عاهد عليه الله فسيؤتيه أجرا عظيما ) . ( ش ) . )(@)(@@)(@@)(@@) $ 9009 عن ابن جرير المازني قال :(@)(@@) | 30 ( شهدت عليا والزبير حين توافقا ، فقال له PageV17P030 علي رضي الله عنه : يا زبير أنشدك الله ، أسمعت رسول الله يقول : ( إنك تقاتل عليا وأنت ظالم له ) ؟ قال : نعم ، ولم أذكر ذاك إلا في مقامي هاذا ، ثم انصرف ) . ( ع ، عق ، ق في الدلائل ، كر ) . )(@)(@@)(@@)(@@) $ 9010 عن الأسود بن قيس قال :(@)(@@) | 30 ( حدثني من رأى الزبير رضي الله عنه يوم الجمل فنوه به علي : يا أبا عبد الله فأقبل حتى التقت أعناق دوابهما ، فقال له علي رضي الله عنه : أتذكر يوما أتانا رسول الله وأنا أناجيك ؟ فقال : ( أتناجيه والله ليقاتلنك يوما وهو لك ظالم ) فضرب الزبير وجه دابته فانصرف ) . ( ش ، كر ) . )(@)(@@)(@@)(@@) $ 9011 عن عبد السلام رجل من حية ؟ قال :(@)(@@) | 30 ( خلا علي بالزبير رضي الله عنه يوم الجمل ، فقال : أنشدك الله كيف سمعت رسول الله يقول وأنت لاوي يدي في سقيفة بني ساعدة : ( لتقاتلنه وأنت له ظالم ، ثم ينصرن عليك ) فقال : قد سمعت ، لا جرم لا أقاتلك ) . ( ش وابن منيع ، عق ، وقال : لا يروى هاذا المتن من وجه يثبت ) . )(@)(@@)(@@)(@@) $ 9012 عن أبي كنانة قال :(@)(@@) | 30 ( قال الزبير رضي الله عنه يوم الجمل : قد 
ms5693	 كنا نحذر هاذا اليوم ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9013 عن عبد الله بن سلمة ، عن علي بن أبي طالب أو الزبير بن العوام رضي الله عنهم قال :(@)(@@) | 30 ( كان رسول الله يخطبنا فيذكرنا بأيام الله حتى يعرف ذالك في وجهه ، كأنما يذكر قوما يصبحهم الأمر غدوة أو عشية ، فكان إذا كان حديث عهد بجبريل لم يبتسم ضاحكا حتى يرتفع عنه ) . ( ابن أبي الفوارس ) . )(@)(@@)(@@)(@@) $ 9014 عن عبد الله بن سلمة عن الزبير رضي الله عنه قال :(@)(@@) | 30 ( كان رسول الله يخطبنا فيذكرنا بأيام الله حتى نعرف ذالك في وجهه وكأنه رجل يتخوف أن يصبحهم الأمر غدوة ، وكان إذا كان حديث عهد بجبريل لم يبتسم ضاحكا حتى PageV17P031 يرتفع عنه ) . ( أبو نعيم وقال : هذا الحديث تابع حجاج بن نصير فيه وهب بن جرير فقال : عن علي أو الزبير رضي الله عنهما ، رواه عن إسحاق بن راهويه في مسنده علاى الشك ، ورواه حجدج بن نصير علاى ما ذكرنا بغير شك ، قال : وعبد الله بن سلمة إن كان صاحب علي وسعد وابن مسعود فهو المرادي الجملي انتهاى ) . )(@)(@@)(@@)(@@) $ 9015 عن الزبير رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : ( اللهم أعز الاسلام بعمر بن الخطاب ) . ( خيثمة في فضائل الصحابة ، كر ) . )(@)(@@)(@@)(@@) $ 9016 عن إسحاق العزري ، عن أم عروة بنت جعفر بن الزبير بن العوام ، عن أبيها جعفر ، عن الزبير بن العوام ، عن أمه صفية بنت عبد المطلب رضي الله عنهما قالت :(@)(@@) | 30 ( لما خرج رسول الله إلاى أحد خلفني أنا ونساءه في أطم يقال له فارع عند المسجد ، فأدخلنا فيه ومعنا حسان بن ثابت ، فترقى إلينا يهودي من اليهود حتى أطل علينا في الأطم ، فقلت لحسان بن ثابت : قم إليه فاقتله ، فقال : ما ذاك في ، لو كان ذالك في لكنت مع رسول الله ، فقلت : فاربط السيف علاى ذراعي ، فربطه ، فقمت إليه حتى قطعت رأسه ، فقلت : خذ بأذنه فارم به عليهم ، فسقطوا وهم يقولون : لقد ظننا أن محمدا ، لم يكن ليترك أهله خلوفا لا رجل معهم ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9017 عن ابن إسحاق 
ms5694	 ، حدثني يحي ى بن عباد بن الزبير عن أبيه عن صفية بنت عبد المملب رضي الله عنهما أنها قالت :(@)(@@) | 30 ( كنا مع حسان بن ثابت رضي الله عنه في حصن فارع ، والنبي بالخندق ، فإذا بيهودي يطوف بالحصن ، فخفنا أن يدل علاى عورتنا ، فقلت لحسان : لو نزلت إلاى هاذا اليهودي فإني أخاف أن يدل علاى عورتنا ، فقال : يا بنت عبد المطلب لقد علمت ما أنا بصاحب هاذا ، قالت : فتحزمت ثم نزلت وأخذت عمودا فقتلته ، ثم قالت لحسان : اخرج عليه فاسلبه ، قال : لا حاجة لي في سلبه ) . ( كر ) . )(@)(@@) PageV17P032(@)(@@)(@@)(@@) $ 9018 عن محمد الحسن المخزومي ، حدثتني أم عروة عن أبيها عن جدها الزبير رضي الله عنهم قال :(@)(@@) | 30 ( لما خلف رسول الله نساءه يوم أحد بالمدينة خلفهن في فارع ، فيهن صفية بنت عبد المطلب ، وخلف فيهن حسان بن ثابت ، وأقبل رجل من المشركين فيدخل عليهن ، فقالت صفية لحسان : عندك الرجل فجبن حسان عنه وأباى عليها ، فتناولت صفية السيف فضربت به المشرك حتى قتلته ، فأخبر بذالك رسول الله فضرب لصفية بسهم كما يضرب للرجال ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9019 عن الزبير ضي الله عنه قال :(@)(@@) | 30 ( سمعت رسول الله يقول يومئذ يعني يوم أحد : ( أوجب طلحة ) حين صنع برسول الله ما صنع ) . ( ش ، ع ) . )(@)(@@)(@@)(@@) $ 9020 عن عروة أن مطيع بن الأسود قال :(@)(@@) | 30 ( سمعت عمر بن الخطاب رضي الله عنه يقول : لو عهدت عهدا ، أو تركت تركة لكان أحب إلي من أن أجعلها إليه الزبير فإنه ركن من أران الدين ) . ( يعقوب بن سفيان وأبو نعيم في المعرفة ، كر ) . )(@)(@@)(@@)(@@) $ 9021 عن عروة قال :(@)(@@) | 30 ( أوصاى عثمان بن عفان إلاى الزبير بن العوام رضي الله عنه ، وكذالك ابن مسعود ، وعبد الرحمان بن عوف ، ومطيع بن الأسود ، فقال الزبير لمطيع : لا أقبل لك وصية ، قال : أنشد الله ما أبتغي في ذالك إلا قول عمر ، سمعت عمر رضي الله عنه يقول : قال رسول الله : ( لو عهدت عهدا ، أو تركت تركة ما أوصيت إلا إلاى الزبير ، إن الزبير رضي الله عنه ركن من 
ms5695	 أركان الدين ) . ( يعقوب بن سفيان وأبو نعيم ، ق ) . )(@)(@@)(@@)(@@) $ 9022 عن مطيع بن الأسود قال :(@)(@@) | 30 ( سمعت عمر بن الخطاب رضي الله عنه يقول : من عهد منكم إلاى الزبير ، فإن الزبير رضي الله عنه عمود من عمد الاسلام ) . ( قط في الأفراد وأبو نعيم ، كر ) . )(@)(@@) PageV17P033(@)(@@)(@@)(@@) $ 9023 عن أبي لهيعة قال :(@)(@@) | 30 ( سمع عمر بن الخطاب رضي الله عنه رجلا يقول : أنا ابن الحواري ، فقال له : ولدك الزبير ضي الله عنه من قبل الرجال ؟ قال : لا ، قال : فمن قبل النساء ؟ قال : لا ، قال : فلا أسمعنك تقول : أنا ابن الحواري ، سمعت رسول الله يقول للزبير : ( الحواري ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9024 عن عمر رضي الله عنه قال :(@)(@@) | 30 ( نعم ، ولي تركة المرء المسلم الزبير ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9025 عن ابن عمر قال :(@)(@@) | 30 ( جاء الزبير إلاى عمر رضي الله عنهما فقال : ائذن لي أن أخرج فأقاتل في سبيل الله ، قال : حسبك قد قاتلت مع رسول الله ، لولا أني ممسك لفم هاذا الشعب لهلكت أمة محمد ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9026 عن ذر قال :(@)(@@) | 30 ( استأذن ابن جرموز قاتل الزبير بن العوم علاى علي بن أبي طالب رضي الله عنه ، فقال علي : ليدخلن قاتل ابن صفية النار ، إني سمعت رسول الله يقول : ( لكل نبي حواري ، وحواري ، الزبير ) . ( ط ، ش والشاشي ، ع ، وابن جرير وصححه ) . )(@)(@@)(@@)(@@) $ 9027 عن موساى بن عبيدة ، عن عبد الله بن عبيدة ، عن جابر رضي الله عنه :(@)(@@) | 30 ( أن النبي قال يوم الخندق : ( هل من رجل يأتينا بخبر بني قريظة ) ؟ قال الزبير رضي الله عنه : أنا ، فذهب علاى فرسه فجاء بخبرهم ، ثم قال 2 الثانية ، فقال الزبير : أنا ، فذهب ، ثم قال الثالثة ، فقال النبي : ( لكل نبي حواري ، وحواري الزبير ) . ( ز ) . )(@)(@@)(@@)(@@) $ 9028 عن عبد الله بن الزبير :(@)(@@) | 30 ( أن النبي قال يوم الخندق : من رجل يذهب فيأتينا بخبر القوم ؟ فركب الزبير رضي الله عنه فجاء بخبرهم من بين الناس كلهم ، فعل ذالك مرتين أو ثلاثا ، فلما ركب الزبير في آخر مرة ، قال رسول الله : ( لكل نبي حواري ، وحواري الزبير وابن عمتي ) ، قال 
ms5696	 : وجمع النبي PageV17P034 يومئذ للزبير أبويه ، فقال : ( فداك أبي وأمي ) ، ورسول الله أمن وأفضل ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9029 عن عبد الله بن الزبير رضي الله عنه :(@)(@@) | 30 ( أن رسول الله قال : ( إن لكل نبي حواري والزبير حواري وابن عمتي ) ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 9030 عن ابن عباس رضي الله عنهما :(@)(@@) | 30 ( أن رجلا من المشركين شتم النبي ، فقال النبي : ( من يكفيني عدوي ) ؟ فقام الزبير فقال : أنا ، فبارزه فقتله ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 9031 عن أسماء بنت أبي بكر رضي الله عنها قالت :(@)(@@) | 30 ( أقبل رجل من المشركين وعليه السلاح حتى صعد علاى مكان مرتفع من الأرض فقال : من يبارز ؟ فقال رسول الله لرجل من القوم : ( أتقوم إليه ) ؟ فقال له الرجل : إن شئت يا رسول الله فأخذ الزبير يتطلع ، فنظر إليه رسول الله فقال : ( قم يا ابن صفية ) فانطلق إليه حتى استواى معه فاضطربا ، ثم عانق أحدهما الآخر ثم تدحرجا ، فقال رسول الله : ( أيهما وقع الحضيض أولا فهو المقتول ، فدعا النبي ودعا الناس ، فوقع الكافر ووقع الزبير علاى صدره فقتله ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 9032 عن سعيد بن المسيب قال : $ 30 ( إن أول من سل سيفا في الله الزبير بن العوام ، بينا هو ذات يوم قائل إذ سمع نغمة : قتل رسول الله ، فخرج متجردا بالسيف صلتا ، فلقيه النبي كنة كنة ، فقال : ( مالك يا زبير ) ؟ قال : سمعت أنك قتلت ، قال : ( فما أردت أن تصنع ) ؟ قال : أردت والله أستعرض أهل مكة فدعا له النبي بخير ، وفي ذالك يقول الأسدي :(@)(@@) هاذاك أول سيف سل في غضب %~% لله سيف الزبير المنتضاى أنفا(@)(@@) حمية سبقت من فضل نجدته %~% قد يحبس النجدات المحبس الأرفا(@)(@@) . ) $(@)(@@) PageV17P035(@)(@@)(@@)(@@) $ 9033 عن عروة :(@)(@@) | 30 ( أن رسول الله قال يوم الخندق : ( من رجل يذهب فيأتينا بخبر بني قريظة ) ؟ فركب الزبير رضي الله عنه فجاءه بخبرهم ثم عاد ، فقال ثلاث مرات : ( من يجيئني بخبرهم ) ؟ فقال الزبير : نعم ، قال : وجمع النبي للزبير أبويه فقال : ( فداك أبي وأمي ) وقال للزبير : ( لكل نبي حواري ، وحواري الزبير وابن عمتي ) . ( ش ) . )(@)(@@)(@@)(@@) $ 9034 عن عروة قال :(@)(@@) | 30 ( أول سيف سل 
ms5697	 في الاسلام بمكة سيف الزبير رضي الله عنه ، بلغه أن النبي قتل ، فسل سيفه وقال : لا ألقاى أحدا إلا قتلته فبلغ ذالك النبي فأخذ سيفه فمسحه ودعا له ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9035 عن عروة قال :(@)(@@) | 30 ( لم يهاجر أحد من المهاجرين معه أمه إلا الزبير رضي الله عنه ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9036 عن عروة قال :(@)(@@) | 30 ( لم يكن مع النبي يوم بدر غير فرسين ، أحدهما عليه الزبير ) . ( ابن سعد ، كر ) . )(@)(@@)(@@)(@@) $ 9037 عن عروة قال :(@)(@@) | 30 ( نزل جبريل عليه السلام يوم بدر علاى سيماء الزبيحر وهو معتجر بعمامة صفراء ) . ( كر ) ، )(@)(@@)(@@)(@@) $ 9038 عن عروة قال :(@)(@@) | 30 ( كانت علاى الزبير رضي الله عنه ريطة صفراء متعجرا بها يوم بدر ، فقال النبي : ( إن الملائكة تنزل علاى سيماء الزبير ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9039 عن عروة قال :(@)(@@) | 30 ( نزلت الملائكة يوم بدر علاى سيماء الزبير رضي الله PageV17P036 عنه ، عليهم عمائم صفر قد أرخوها من ظهورهم ، وكانت علاى الزبير عمامة صفراء ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9040 عن عروة قال :(@)(@@) | 30 ( أعطاى رسول الله الزبير بن العوام رضي الله عنه يوم بدر يلمق حريرا محشوا بالقز يقاتل فيه ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9041 عن أسماء بنت أبي بكر رضي الله عنهما قالت :(@)(@@) | 30 ( عندي للزبير رضي الله عنه ساعدان من ديباج كان النبي أعطاهما إياهما يقاتل فيهما ) . ( حم ، كر ) . )(@)(@@)(@@)(@@) $ 9042 عن ابن شهاب قال :(@)(@@) | 30 ( هاجر الزبير بن العوام رضي الله عنه إلاى أرض الحبشة ، ثم قدم علاى النبي ، ثم هاجر إلاى المدينة ) . ( أبو نعيم في المعرفة ) . )(@)(@@)(@@)(@@) $ 9043 عن أنس رضي الله عنه :(@)(@@) | 30 ( أن النبي آخى بين الزبير وبين عبد الله بن مسعود رضي الله عنهما ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9044 عن الزبير رضي الله عنه قال :(@)(@@) | 30 ( جمع لي رسول الله أبويه يوم قريظة فقال : فداك أبي وأمي ) . ( ش ) . )(@)(@@)(@@)(@@) $ 9045 عن جبير بن مطعم قال :(@)(@@) | 30 ( سمعت العباس بن عبد المطلب يقول للزبير رضي الله عنهم : يا أبا عبد الله أهاهنا أمرك رسول الله أن تركز الراية ) . ( أبو نعيم في المعرفة ) . )(@)(@@)(@@)(@@) $ 9046 عن محمد بن كعب قال :(@)(@@) | 30 ( كان الزبير رضي 
ms5698	 الله عنه لا يغير ) . ( أبو نعيم ) . )(@)(@@) PageV17P037(@)(@@)(@@)(@@) $ 9047 عن عروة قال :(@)(@@) | 30 ( كان الزبير طويلا تخط رجلاه الأرض إذا ركب الدابة ) . ( أبو نعيم كر ) . )(@)(@@)(@@)(@@) $ 9048 عن عروة قال :(@)(@@) | 30 ( إن أول رجل سل السيف الزبير بن العوام رضي الله عنه ، سمع نفخة نفخها الشيطان : أخذ رسول الله ، فخرج الزبير يشق الناس بسيفه ، والنبي بأعلاى مكة ، فقال له : ( مالك يا زبير ) ؟ قال : أخبرت أنك أخذت فصلى عليه ، ودعا له ولسيفه ) . ( أبو نعيم ، كر ) . )(@)(@@)(@@)(@@) $ 9049 عن عروة :(@)(@@) | 30 ( أن الزبير بن العوام رضي الله عنه سمع نفخة من الشيطان : أن محمدا أخذ ، بعد ما أسلم وهو ابن ثنتي عشرة سنة ، فسل سيفه وخرج يشتد الأزقة حتى أتاى النبي وهو بأعلاى مكة والسيف في يده ، فقال له النبي : ( ما شأنك ) ؟ قال : سمعت أنك قد أخذت ، فقال النبي : ( ما كنت تصنع ) ؟ قال : كنت أضرب بسيفي هاذا من أخذك ، فدعا له رسول الله ولسيفه وقال : ( انصرف ) ، وكان أول سيف سل في سبيل الله ) . ( أبو نعيم ، كر ) . )(@)(@@)(@@)(@@) $ 9050 عن حفص بن حليمة قال : حدثني شيخ قدم علينا من الموصل قال :(@)(@@) | 30 ( صحبت الزبير بن العوام في بعض أسفاره ، فأصابته جنابة بأرض قفر فقال : استرني ، فسترته فحانت مني إليه التفاتة فرأيته مجدعا بالسيوف ، قلت : والله لقد رأيت بك آثارا ما رأيتها بأحد قط ، قال : وقد رأيت ذالك ؟ قلت : نعم ، قال : أما والله ما منها جراحة إلا مع رسول الله وفي سبيل الله ) . ( أبو نعيم ، كر ) . )(@)(@@)(@@)(@@) $ 9051 عن الزبير رضي الله عنه قال :(@)(@@) | 30 ( قال النبي : ( من يأتي بني قريظة ) ؟ قلت : أنا ، فذهبت ، فلما جئت إليه قال لي : ( فداك أبي وأمي ) . ( أبو نعيم ) . )(@)(@@)(@@)(@@) $ 9052 عن الزبير رضي الله عنه قال :(@)(@@) | 30 ( أخذ النبي بيدي فقال : ( لكل نبي PageV17P038 حواري ، وحواري الزبير وابن عمتي ) ، فقيل له : يا أبا عبد الله أتعلم أن النبي قالها لأحد غيرك ؟ قال : لا ) . ( كر ، وسنده صحيح ) . )(@)(@@)(@@)(@@) $ 9053 عن عروة قال :(@)(@@) | 30 ( قال الزبير رضي الله عنه : ما تخلفت عن غزوة غزاها المسلمون إلا أن أقبل فألقاى 
ms5699	 ناسا يعصون ) ( كر ) . )(@)(@@)(@@)(@@) $ 9054 عن الزبير بن العوام رضي الله عنه قال :(@)(@@) | 30 ( دعا لي رسول الله ولولدي ولولد ولدي ) . ( ع ، كر ) . )(@)(@@)(@@)(@@) $ ( 9055 ) عن أسماء بنت أبي بكر رضي الله عنهما قالت : ' مر الزبير بن العوام رضي الله عنه بمجلس من أصحاب رسول الله & وحسان رضي الله عنه ينشدهم من شعره وهم غير نشاط لما يسمعون منه ، فجلس معهم الزبير ثم قال : مالي أراكم غير أذنين لما تسمعون من شعر ابن الفريعة ؟ فقد كان يعرض به رسول الله & فيحسن استماعه ، ويجزل عليه ثوابه ، ولا يشتغل عنه بشيء ' . ( ابن جرير وأبو نعيم ، كر ) .(@)(@@)(@@)(@@) $ 9056 عن الحسن قال :(@)(@@) | 30 ( كان بين الزبير وبين خالد بن الوليد رضي الله عنهما شيء ، فقال رسول الله : ( ما شأنكم وشأن أصحابي ؟ ذروا لي أصحابي ، فوالذي نفسي بيده ، لو أنفق أحدكم مثل أحد ذهبا ما أدرك مثل عمل أحدهم يوما واحدا ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9057 عن عروة :(@)(@@) | 30 ( أن عبد الله بن الزبير قال يوم الخندق للزبير رضي الله عنه : يا أبت لقد رأيتك وأنت تحمل علاى فرسك الأشقر ، قال : هل رأيتني أي بني ؟ قال : نعم قال : كان رسول الله يجمع لأبيك أبويه ويقول : احمل فداك أبي وأمي ) . ( ابن جرير ) . )(@)(@@) PageV17P039(@)(@@)(@@)(@@) $ 9058 عن الزبير بن العوام رضي الله عنه :(@)(@@) | 30 ( أن رسول الله قتل رجلا من قريش يوم فتح مكة وقال : ( لا يقتل أحد من قريش بعد اليوم صبرا إلا قاتل عثمان فاقتلوه ، فإن لم تقتلوه فأبشروا بذبح مثل ذبح الشاة ) . ( عد ، كر ) . )(@)(@@)(@@)(@@) $ 9059 عن أنس رضي الله عنه :(@)(@@) | 30 ( أن النبي رخض للزبير بن العوام رضي الله عنه في الحرير ، ولعبد الرحمان بن عوف رضي الله عنه لحكة كانت بجلودهما ) . ( ابن جرير في تهذيبه ) . )(@)(@@)(@@)(@@) $ 9060 عن الزبير رضي الله عنه عن سليمان بن يسار قال :(@)(@@) | 30 ( سأل نيار الأسلمي عثمان رضي الله عنه عن الأختين من ملك اليمين أيجمع بينهما ؟ فقال عثمان : أما أنا أو أحد من ولدي فلا نفعل ذالك ، ثم خرج نيار فلقي علي بن أبي طالب 
ms5700	 والزبير بن العوام رضي الله عنهما فسألهما عن ذالك فكلاهما نهاه عن ذالك ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 9061 عن ميمون بن مهران ، عن الزبير رضي الله عنهما :(@)(@@) | 30 ( أنه كانت تحته أم كلثوم بنت عقبة ، فقالت : طيب نفسي بواحدة ، فطلقها واحدة ، فوضعت حملها ، وجاء فقال : خدعتني خدعها الله فجاء النبي فقال : ( سبق الكتاب ، اخطبها إلاى نفسها ) . ( عب ) . )(@)(@@)(@@)(@@) $ 9062 عن محمد بن الحسن قال :(@)(@@) | 30 ( كان معدان بن حواس التغلبي وامرأته نصرانيين ، فأسلمت امرأته في ولاية عمر بن الخطاب رضي الله عنه وفرت منه إلاى عمر ، فخرج معدان يطلبها حتى قدم المدينة ، فنزل علاى الزبير بن العوام رضي الله عنه فاستجار به فقال له الزبير : هل انقضت عدتها منك ؟ قال : لا ، قال : فأسلم تكن أولاى بها ، فأسلم ، فغدا به الزبير إلاى عمر ، فرد عليه امرأته ) . ( كر ) . )(@)(@@) PageV17P040(@)(@@)(@@)(@@) $ 9063 عن عروة قال :(@)(@@) | 30 ( أسلم الزبير رضي الله عنه وهو ابن ست عشرة سنة ، ولم يتخلف عن غزوة غزاها النبي ) . ( ش ويعقوب بن سفيان وأبو نعيم كر ) . )(@)(@@)(@@)(@@) $ 9064 عن الزبير رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : ( تركنا بالمدينة أقواما ، لا نقطع واديا ، ولا نصعد صعودا ، ولا نهبط إلا كانوا معنا ) ، فقالوا : يا رسول الله كيف يكون أن يكونوا معنا ولم يشهدوا ؟ قال : ( نياتهم ) . ( الحسن بن سفيان وأبو نعيم وسنده ضعيف ) . )(@)(@@)(@@)(@@) $ 9065 عن الزبير رضي الله عنه :(@)(@@) | 30 ( أنه علم الناس علاى المنبر يقول : ليركع ثم ليمس راكعا ، وإنه رأى الزبير يفعله ) . ( عب ) . )(@)(@@)(@@)(@@) $ 9066 عن عروة قال :(@)(@@) | 30 ( كان الزبير رضي الله عنه قاعدا ورجل يقول : ( قال رسول الله عامة مجلسه ، فسكت الزبير حتى انقضت مقالته ) ، فقال الزبير : ما قال رسول الله شيئا من هاذا ؟ قال : ( والله إنك لحاضر المجلس يومئذ ، قال : صدقت ، إنما قال رسول الله قبل أن تجيء ، قال رجل من أهل الكتاب فجعل يذكر عنه ) ، فجئت وهو يذكر ذالك ، فذكر الذي يمنعني من الحديث عن النبي ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9067 عن الزبير رضي الله عنه :(@)(@@) | 30 ( أن رسول الله أعطاه يوم فتح مكة لواء 