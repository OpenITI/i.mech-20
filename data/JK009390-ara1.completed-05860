ms5841	 معي ، فقال لي النبي : من هاذا معك يا أبا راشد ؟ فقلت : هاذا عبد لي يقال له : سرحان ، فقال النبي : هل لك يا أبا راشد أن تعتقه فيعتق الله منك بكل عضو منه عضوا منك من النار ، قال أبو راشد : فأعتقه ، وقلت : إشهد يا رسول الله أنه حر لوجه الله وانصرفت إلاى أصحابي فأدركت منهم قوما وفاتني منهم قوم ، فأخوا النبي فأسلموا ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9766 عن أبي راشد الأزدي :(@)(@@) | 30 ( أنه وفد علاى النبي فقال : ما اسمك ؟ قلت : عبد العزى ، قال : أبو من ؟ قلت : أبو مغوية ، قال : كلا بل أنت عبد الرحمان أبو راشد ، قال : فمن هاذا معك ؟ قلت : مولاي ، قال : فما اسمه ؟ قلت : قيوم ، قال : كلا ولاكنه عبد القيوم ) . ( أبو عبيد ، كر ) . )(@)(@@)(@@)(@@) |||| ( مسند 45 أبي رافع رفاعة رضي الله عنه )(@)(@@)(@@)(@@) $ 9767 عن إسحاق بن سويد العدوي عن أبي رفاعة عبد الله بن الحارث العدوي رضي الله عنه قال : $ 30 ( دخلت علاى رسول الله وهو علاى كرسي خلت أن قوائمه حديد ، فسمعته يقول : إنك لن تدع شيئا لله إلا أبدلك الله خيرا منه ) .(@)(@@) ( خط في المتفق والمفترق ، وقال : كذا واسم أبي رفاعة تميم أسد ، لا عبد الله بن الحارث ، حدث عنه حميد بن هلال ، ولا أعلم روى عنه إسحاق بن سويد شيئا ) . ) $(@)(@@)(@@)(@@) $ 9768 عن حميد بن هلال ، عن أبي رفاعة رضي الله عنه قال :(@)(@@) | 30 ( انتهيت إلاى PageV17P212 رسول الله وهو يخطب ، فقلت : يا رسول الله رجل غريب جاء يسأل عن دينه لا يدري مد دينه ، ( فجاء رسول الله وترك خطبته ، ثم أتي بكرسي خلت قوائمه حديدا ، فصعد رسول الله فجعل يعلمني مما علمه الله ، ثم أتاى خطبته فأتمها ) . ( طب ، وأبو نعيم ) . )(@)(@@)(@@)(@@) $ 9769 عن أبي رفاعة رضي الله عنه قال :(@)(@@) | 30 ( قتل المؤمن أخاه كفر وسبابه فسوق ، وحرمة ماله كحرمة دمه ) . ( الخطيب في المتفق والمفترق ، كر ) . )(@)(@@)(@@)(@@) |||| ( مسند 46 أبي رافع رضي الله عنه )(@)(@@)(@@)(@@) $ 9770 عن أبي رافع رضي الله عنه قال :(@)(@@) | 30 ( أن عبد الله بن جعفر زوج ابنته من الحجاج بن يوسف 
ms5842	 ، فقال لها إذا دخل بك فقولي : لا إلاه إلا الله الحليم الكريم ، سبحان الله رب العرش العظيم ، والحمد لله رب العالمين ، وزعم أن رسول الله كان إذا حزبه أمر ، قال هاذا ، قال : فلم يصل إليها ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9771 عن أبي رافع رضي الله عنه قال :(@)(@@) | 30 ( قلت لعمر بن الخطاب رضي الله عنه : يا أمير المؤمنين إني أصوغ الذهب فأبيعه بالثمن بوزنه ، وآخذ لعملي أجرا ، قال : لا تبع الذهب بالذهب إلا وزنا بوزن ، والفضة بالفضة إلا وزنا بوزن ، ولا تأخذ فضلا ) . ( عب ، ق ) . )(@)(@@)(@@)(@@) $ 9772 عن أبي رافع رضي الله عنه :(@)(@@) | 30 ( أن رسول الله سئل كم للمؤمن من ستر ؟ ( قال : هي أكثر من أن تحصاى ، ولاكن المؤمن إذا عمل خطيئة هتك منها ستر ، فإذا تاب رجع إليه ذالك الستر ، وتسعة معه ، فإذا لم يتب ، هتك عنه منها ستر واحد ، حتى إذا لم يبق عليه شيء ، قال الله لمن شاء من ملائكته : حفوه بأجنحتكم ، فيفعلون به ذالك ، فإن تاب رجعت إليه الأستار كلها ، وإن لم يتب PageV17P213 عجب منه الملائكة ، فيقول الله تعالاى لهم : أسلموه ، فيسلموه حتى لا يستر منه عورة ) . ( ابن أبي الدنيا في التوبة ) . )(@)(@@)(@@)(@@) $ 9773 عن أبي رافع رضي الله عنه قال :(@)(@@) | 30 ( مر رسول الله بالبقيع ، فقال : أف أف أف ، وليس معه أحد غيري ، فراعني ، فقلت : بأبي أنت وأمي ، قال : صاحب هاذ الحفرة استعملته علاى بني فلان فخان بردة ، فأريتها عليه تلتهب ) . ( طب ) . )(@)(@@)(@@)(@@) $ 9774 عن عبيد الله بن أبي رافع ، عن أبي رافع رضي الله عنه :(@)(@@) | 30 ( أن رسول الله وقف عشية عرفة ، وأردف أسامة بن زيد فقال : ( هاذا الموقف ، وكل عرفة موقف ، وارفعوا عن بطن عرنة ثم دفع رسول الله حين وجبت الشمس يسير العنق ، والناس يضربون يمينا وشمالا ، ورسول الله يلتفت يمينا وشمالا ويقول : أيها الناس عليكم السكينة حتى جاء المزدلفة ، فجمع بين المغرب والعشاء ، حتى إذا أصبح رسول الله غدا حتى وقف علاى قزح ، وأردف الفضل بن عباس ، ثم قال : هاذا الموقف ، وكل المزدلفة موقف ، وارفعوا عن 
ms5843	 بطن محسر ، ثم دفع رسول الله حين أسفر يسير العنق ، والناس يضربون يمينا وشمالا ، ورسول الله يلتفت يمينا وشمالا ويقول : السكينة عليكم أيها الناس حتى جاء بطن محسر ، فحرك ناقته ورسمت به حتى إذا جاوز بطن محسر ردها إلاى سيرها الأول ، حتى جاء العقبة فرماها بسبع حصيات ، ثم انصرق إلاى المنحر فقال : هاذا المنحر ، وكل منى منحر ، جاءته جارية من خثعم فقالت : يا رسول الله أبي شيخ كبير ، وأدركته فريضة الاسلام التي افترض الله عليه ، أفيجزيء عنه أن أحج عنه ؟ فقال رسول الله : نعم ، وكان الفضل غلاما جميلا ، فإذا جاءت PageV17P214 الجارية صرف رسول الله وجهه إلاى الشق الآخر ، ثم سار رسول الله حتى جاء البيت فطاف به سبعا ، ثم انصرف إلاى زمزم فأتى بسجل من ماء زمزم فتوضأ ثم قال : انزعوا علاى سقايتكم يا بني عبد المطلب ، فلولا أن يغلبكم الناس عليها لنزعت ، فقال له العباس رضي الله عنه : يا رسول الله رأيتك تصرف وجه ابن عمك ، فقال رسول الله : رأيت جارية حدثة وغلاما حدثا ، فخشيت أن يدخل بينهما الشيطان ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 9775 عن أبي رافع رضي الله عنه قال :(@)(@@) | 30 ( ذبح رسول الله كبشا ثم قال : هاذا عني وعن أمتي ) . ( طب ) . )(@)(@@)(@@)(@@) $ 9776 عن أبي رافع رضي الله عنه قال :(@)(@@) | 30 ( ذبحت شاة بوتد فجئت رسول الله فقلت : يا رسول الله إني ذبحت شاة بوتد ، قال : ( كلوها ) . ( طب ) . )(@)(@@)(@@)(@@) $ 9777 عن أبي رافع رضي الله عنه :(@)(@@) | 30 ( أن عمر رضي الله عنه كان مستندا إلاى ابن عباس وعنده ابن عمر وسعيد بن زيد رضي الله عنهم قال : اعلموا أني لم أقل في الكلالة شيئا ، ولم أستخلف من بعدي أحدا ، وأنه من أدرك وفاتي من سبي العرب فهو حر من مال الله ، فقال سعيد بن زيد : أما إنك لو أشرت برجل من المسلمين لائتمنك الناس وقد فعل ذالك أبو بكر رضي الله عنه وائتمنه الناس ، فقال عمر : قد رأيت من أصحابي حرصا سي ئا ، وإني جاعل هاذا الأمر إلاى هاؤلاء النفر الستة 
ms5844	 الذين مات رسول الله وهو عنهم راض ، ثم قال عمر رضي الله عنه : لو أدركني أحد رجلين ثم جعلت هاذا الأمر إليه لوثقت به : سالم مولاى أبي حذيفة ، وأبو عبيدة بن الجراح ) . ( حم ، حب ، ك ) . )(@)(@@)(@@)(@@) $ 9778 عن أبي رافع رضي الله عنه قال :(@)(@@) | 30 ( استلف النبي من رجل بكرا ، PageV17P215 فجاءته إبل الصدقة ، فأمرني أن أقضيه بكرا ، فقلت : لم أجد إلا جملا خيارا رباعيا ، فقال : اقضه إياه ، فإن خير الناس أحسنهم قضاء ) . ( مالك ، عب ، ورواه عب من وجه آخر بلفظ : فأمر بلالا أن يقضيه ) . )(@)(@@)(@@)(@@) $ 9779 عن أبي رافع رضي الله عنه قال :(@)(@@) | 30 ( بعث النبي رجلا من بني مخزوم علاى الصدقة ، فأراد أبو رافع أن يتبعه ، فسأل النبي ؛ فقال : ( أما علمت أنا لا يحل لنا أكل الصدقة ، وإن مولاى القوم من أنفسهم ) . ( ش ) . )(@)(@@)(@@)(@@) $ 9780 عن أبي رافع رضي الله عنه :(@)(@@) | 30 ( أن النبي وأبا بكر وعمر وعثمان وعليا رضي الله عنهم قنتوا بعد الركوع ) . ( ابن النجار ) . )(@)(@@)(@@)(@@) $ 9781 عن أبي رافع رضي الله عنه قال :(@)(@@) | 30 ( مر بي رسول الله وأنا ساجد قد عقصت شعري فحله ونهاني عن ذالك ) . ( طب ) . )(@)(@@)(@@)(@@) $ 9782 عن أبي رافع رضي الله عنه قال :(@)(@@) | 30 ( نهاى رسول الله أن يصلي الرجل ورأسه معقوص ) . ( عب ) . )(@)(@@)(@@)(@@) $ 9783 عن أبي رافع رضي الله عنه قال :(@)(@@) | 30 ( كان النبي إذا سمع المنادي قال مثل ما يقول ، فإذا قال : حي علاى الفلاح ، قال : لا حول ولا قوة إلا بالله ) . ( أبو الشيخ وابن النجار ) . )(@)(@@)(@@)(@@) $ 9784 عن أبي رافع رضي الله عنه قال :(@)(@@) | 30 ( رأيت بلالا يؤذن بين يدي النبي مثنى مثنى ، ويقيم واحدة ) . ( أبو الشيخ في الأذان ) . )(@)(@@)(@@)(@@) $ 9785 عن محمد بن عبيد الله بن أبي رافع عن أبيه عن جده أبي رافع رضي الله عنه قال :(@)(@@) | 30 ( خرجت مع رسول الله من بيته ، يومئذ المسجد ، حتى أتينا البقيع ، فعطس رسول الله فمكث طويلا ، فقلت له : بأبي أنت وأمي ، قلت شيئا لم PageV17P216 أفهمه ؟ فقال : نعم أتاني من ربي أو أخبرني جبريل قال : إذا عطست فقل 
ms5845	 : الحمد لله ككرمه ، والحمد لله كعز جلاله ، قال : فإن الرب تبارك وتعالاى يقول : صدق عبدي ، صدق عبدي مغفورا له ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 9786 عن أبي رافع رضي الله عنه قال :(@)(@@) | 30 ( رأيت رسول الله يتوضأ ثلاثا ثلاثا ، ورأيته يتوضأ مرة مرة ) . ( ص ) . )(@)(@@)(@@)(@@) $ 9787 عن أبي رافع رضي الله عنه قال :(@)(@@) | 30 ( طبخت لرسول الله بطن شاة فأكل منها ، ثم صلى العشاء فلم يتوضأ ) . ( طب ) . )(@)(@@)(@@)(@@) $ 9788 عن أبي رافع رضي الله عنه قال :(@)(@@) | 30 ( رأيت النبي أكل كتفا ثم قام إلاى الصلاة ولم يمس ماء ) . ( ش ) . )(@)(@@)(@@)(@@) $ 9789 عن أبي رافع رضي الله عنه قال :(@)(@@) | 30 ( ذبحنا للنبي عناقا ، فأكل ولم يتوضأ ، ولم يمس ماء ، ولم يتمضمض ) . ( طب ) . )(@)(@@)(@@)(@@) $ 9790 عن أبي رافع رضي الله عنه فال :(@)(@@) | 30 ( ذبحت للنبي شاة بشظاظ ، وشويته ، فأكل ولم يتمضمض ولم يتوضأ ) . ( طب ) . )(@)(@@)(@@)(@@) $ 9791 عن أبي رافع رضي الله عنه قال :(@)(@@) | 30 ( إن رسول الله طاف علاى نسائه في ليلة ، فاغتسل عند كل امرأة منهن غسلا ، فقلت : يا رسول الله أو اغتسلت غسلا واحدا ؟ فقال : هاذا أطهر وأطيب أو : أطهر وأنظف ) . ( ش ) . )(@)(@@)(@@)(@@) $ 9792 عن أبي رافع رضي الله عنه قال :(@)(@@) | 30 ( بعث رسول الله عليا رضي الله عنه مبعثا ، فلما قدم قال له رسول الله : الله ورسوله وجبريل عنك راضون ) . ( طب ) . )(@)(@@)(@@)(@@) $ 9793 عن أبي رافع رضي الله عنه قال :(@)(@@) | 30 ( بعث النبي عليا رضي الله PageV17P217 عنه إلاى اليمن يعقد له لواء ، فلما مضاى قال : يا أبا رافع إلحقه ولا تدعه من خلفه ، وليقف ولا يلتفت حتى أجيئه ، فأتاه فأوصاه بأشياء فقال : يا علي لأن يهدي الله تعالاى علاى يديك رجلا خير لك مما طلعت عليه الشمس ) . ( طب ) . )(@)(@@)(@@)(@@) $ 9794 عن محمد بن عبد الله بن أبي رافع ، عن جده :(@)(@@) | 30 ( أن رسول الله قال لعلي رضي الله عنه : أنت تقتل علاى سنتي ) . ( عد ، كر ) . )(@)(@@)(@@)(@@) $ 9795 عن أبي رافع رضي الله عنه قال :(@)(@@) | 30 ( بشرت النبي بإسلام العباس رضي الله عنه فأعتقني ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9796 عن محمد بن عبيد الله بن 
ms5846	 أبي رافع عن أبيه عن جده قال :(@)(@@) | 30 ( قال رسول الله للعباس رضي الله عنه : ( ولك يا عم من الله تعالاى حتى ترضاى ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9797 عن أبي رافع رضي الله عنه قال :(@)(@@) | 30 ( بعث النبي عمر ساعيا علاى الصدقة ، فأتاى العباس رضي الله عنه يطلب صدقة ماله ، فأغلظ له ، فأتاى النبي فذكر له ذالك ، فقال له النبي : أما علمت أن عم الرجل صنو أبيه ؟ إن العباس أسلفنا صدقة العام عام أول ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9798 عن أبي رافع رضي الله عنه قال :(@)(@@) | 30 ( قتل رسول الله عقربا وهو يصلي ) . ( طب ) . )(@)(@@)(@@)(@@) $ 9799 عن أبي رافع رضي الله عنه قال :(@)(@@) | 30 ( بينما النبي يمشي في بقيع الغرقد وأنا أمشي خلفه ، فقال رسول الله : لا هديت ، لا هديت ثلاثا ، قلت : يا رسول الله مالي ؟ قال : ليس إياك أريد ، إنما أريد صاحب القبر ، سئل عني ، فزعم أنه لا يعرفني ؛ فإذا هو قبر قد رش عليه الماء حين دفن صاحبه ) . ( طب ، وأبو نعيم ، ق في كتاب عذاب القبر ) . )(@)(@@) PageV17P218(@)(@@)(@@)(@@) $ 9800 عن أبي رافع رضي الله عنه :(@)(@@) | 30 ( أن النبي أذن في أذن الحسن والحسين حين ولدا وأمر به ) . ( طب ، وأبو نعيم ) . )(@)(@@)(@@)(@@) $ 9801 عن أبي رافع رضي الله عنه قال :(@)(@@) | 30 ( قالت لي مولاتي نبلة ابنة العجماء : كل مملوك لها حر ، وكل مال لها هدي ، وهي يهودية ونصرانية إن لم تطلق امرأتك وتفرق بينك وبين امرأتك ، فأتيت زينب بنت أم سلمة وكان إذا ذكرت امرأة بفقه ذكرت زينب فجاءت معي إليها فقالت : أفي البيت هاروت وماروت ؟ فقال : يا زينب جعلني الله فداك إنها قالت : كل مملوك لها حر وهي يهودية ونصرانية ، فقالت زينب : يهودية ونصرانية خلي بين الرجل وامرأته ، فكأنها لم تقبل ذالك ؛ فلقيت حفصة فأرسلت معي إليها ، فقال : يا أم المؤمنين جعلني الله فداك قالت : كل مملوك لها حر ، وكل مال لها هدي وهي يهودية ونصرانية ، فقالت حفصة : يهودية ونصرانية خلي بين الرجل وبين امرأته ، فكأنها أبت ؛ فأتيت عبد الله بن عمر رضي الله عنهما فانطلق معي إليها 
ms5847	 ، فلما سلم عرفت صوته فقالت : بأبي أنت وبأمي أبوك فقال : أمن حجارة أنت أم من حديد أم من أي شيء أنت ؟ أفتتك زينب ، وأفتتك أم المؤمنين فلم تقبلي منهما ، قلت : يا أبا عبد الرحمان جعلني الله فداك إنها قالت : كل مملوك لها حر ، وكل مال لها هدي وهي يهودية ونصرانية ، قال : يهودية ونصرانية كفري عن يمينك ، وخلي بين الرجل وامرأته ) . ( عب ) . )(@)(@@)(@@)(@@) $ 9802 عن أبي رافع رضي الله عنهما :(@)(@@) | 30 ( أنه مر بحسن بن علي ، وحسن رضي الله عنهم يصلي قائما وقد غرز ضفيرته في قفاه ، فحلها أبو رافع ، فالتفت إليه مغضبا ، فقال له أبو رافع : أقبل علاى صلاتك ولا تغضب ، فإني سمعت رسول الله يقول : ( ذالك كفل الشيطان ، يقول : مقعد الشيطان يعني : مغرز ضفيرته ) . ( عب وأبو نعيم في المعرفة ) . )(@)(@@) PageV17P219(@)(@@)(@@)(@@) $ 9803 عن أبي رافع رضي الله عنه قال :(@)(@@) | 30 ( نهاى رسول الله أن يصلي الرجل وشعره معقوص ، ورأسه معقوص ) . ( عب ) . )(@)(@@)(@@)(@@) |||| ( مسند 47 أبي رزين رضي الله عنه )(@)(@@)(@@)(@@) $ 9804 عن أبي رزين رضي الله عنه قال :(@)(@@) | 30 ( قلت : يا رسول الله ما الإيمان ؟ قال : ( أن تعبد الله ولا تشرك به شيئا ، ويكون الله ورسوله أحب إليك مما سواهما ، وتكون أن تحرق بالنار أحب إليك من أن تشرك بالله شيئا ، وتحب غير ذي نسب لا تحبه إلا لله ، فإذا فعلت ذالك فقد دخل حب الايمان في قلبك كما دخل قلب الظمآن حب الماء في اليوم القائظ ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9805 عن أبي رزين رضي الله عنه :(@)(@@) | 30 ( أن رسول الله قال : ( ضحك ربنا من قنوط عباده وقرب عفوه ، قلت : يا رسول الله ويضحك الرب ؟ قال : نعم ، قلت : لن نعدم من رب يضحك خيرا ) . ( قط في الصفات ) . )(@)(@@)(@@)(@@) $ 9806 عن أبي رزين العقيلي رضي الله عنه :(@)(@@) | 30 ( أنه أتاى النبي فقال : يا رسول الله إن أبي شيخ كبير ولا يستطيع الحج ولا العمرة ولا الظعن ، وقد أدركه الاسلام ، أفأحج عنه ؟ قال : حج عن أبيك واعتمر ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 9807 عن أبي رزين العقيلي رضي الله عنه قال :(@)(@@) | 30 
ms5848	 ( قلت : يا رسول الله كيف بأن أعلم أني مؤمن ؟ فقال رسول الله : ما من أمتي أو قال : ما من هاذه الأمة رجل يعمل حسنة فيعلم أنها حسنة وأن الله جازيه بها خيرا ، وعلا يعمل سيئة فيعلم أنها سيئة فيستغفر الله تعالاى منها ويعلم أنه لا يغفرها إلا هو ، إلا وهو مؤمن ) . ( ابن جرير ، كر ) . )(@)(@@) PageV17P220(@)(@@)(@@)(@@) |||| ( 48 أبو روح ، شبيب بن نقيم رضي الله عنه )(@)(@@)(@@)(@@) $ 9808 عن شبيب بن أبي روح ، عن رجل من أصحاب النبي قال :(@)(@@) | 30 ( صلى النبي صلاة الفجر فقرأ سورة الروم فالتبس فيها ، فلما انصرف قال : ما بال أقوام يصلون بغير طهور ، من صلى معنا فليحسن طهوره ، فإنما يلبس علينا القرآن أولائك ) . ( عب ) . )(@)(@@)(@@)(@@) $ 9809 عن أبي روح ، عن رجل من أصحاب محمد قال :(@)(@@) | 30 ( صلى النبي الفجر فقرأ بالروم والتبس عليه ، فلما انصرف قال : ما بال أقوام يصلون الصلاة معنا بغير طهور من صلى معنا فليحسن وضوءه ، وفي لفظ : إنما يؤذينا سوء ظهوركم ) . ( عب ) . )(@)(@@)(@@)(@@) |||| ( 49 أبو ريحانة الأزدي رضي الله عنه )(@)(@@)(@@)(@@) $ 9810 عن أبي ر يحانة رضي الله عنه قال :(@)(@@) | 30 ( جاء رجل إلاى النبي فقال : يا رسول الله أوصني ، فقال رسول الله : ( لا تشركن بالله شيئا وإن قطعت أو حرقت بالنار ، وأطع والديك وإن أمراك أن تتخلى من أهلك ودنياك ، ولا تدعن صلاة متعمدا ، فإنه من يتركها برئت منه ذمة الله وذمة رسوله ، ولا تشربن خمرا ، فإنها رأس كل خطيئة ، ولا تزدادن في تخوم أرضك ، فإنك تأتي بها يوم القيامة من مقدار سبع أرضين ) . ( ابن النجار ) . )(@)(@@)(@@)(@@) |||| ( 50 أبو زرعة رضي الله عنه )(@)(@@)(@@)(@@) $ 9811 عن أبي زرعة بن سيف بن ذي يزن ، قال :(@)(@@) | 30 ( كتب إلي رسول الله كتابا هاذه نسخته فذكرها ، وفيه : ومن يكن علاى يهوديته أو نصرانيته فإنه لا يفتن عنها وعليه الجزية ، علاى كل حالم : ذكر وأنثى ، حر أو عبد ، دينار أو قيمته من المعافر ) . ( كر ) . )(@)(@@) PageV17P221(@)(@@)(@@)(@@) |||| ( 51 أبو زمعة البلوي رضي الله عنه )(@)(@@)(@@)(@@) $ 9812 عن أبي زمعة البلوي رضي الله عنه قال :(@)(@@) | 30 ( قتل رجل 
ms5849	 من بني إسرائيل سبعة وتسعين نفسا فذهب إلاى راهب ، فقال : إني قتلت سبعة وتسعين نفسا ، فهل تجد لي من توبة ؟ قال : لا ، فقتله ، ثم ذهب إلاى راهب آخر ، فقال : إني قتلت ثمانية وتسعين نفسا ، فهل تجد لي من توبة ؟ قال : لا ، فقتله ، ثم ذهب إلاى الثالث ، فقال : إني قتلت تسعة وتسعين نفسا ، منهم راهبان ، فهل تجد لي من توبة ؟ فقال : لقد عملت شرا ، ولئن قلت إن الله ليس بغفور رحيم لقد كذبت ، فتب إلاى الله ، فقال : أما أنا فلا أفارقك بعد قولك هاذا ، فلزمه علاى أن لا يعصيه ، فكان يخدمه في ذالك ، وهلك يوما رجل والثناء عليه قبيح ، فلما دفن قعد علاى قبره فبكا بكاء شديدا ، ثم توفي آخر والثناء عليه حسن ، فلما دفن قعد علاى قبره فضحك ضحكا شديدا ، فأنكر أصحابه ذالك ، فاجتمعوا إلاى راهبهم فقالوا : كيف يأوي إليك قاتل النفوس وقد صنع ما رأيت ؟ فوقع ذالك في نفسه وأنفسهم ، فأتاى إلاى صاحبهم مرة من ذالك ومعه صاحب له ، فكلمه ، فقال له : ما تأمرني ؟ فقال : إذهب فأوقد تنورا ، ففعل ، ثم أتاه يخبره أنه قد فعل ، قال : إذهب فألق نفسك فيها ، فلها عنه الراهب ، وذهب الآخر فألقاى نفسه في التنور ، ثم استفاق الراهب ، فقال : إني لأظن أن الرجل قد ألقاى نفسه في التنور ، بقولي له ، فذهب إليه ، فوجده حيا يعرق ، فأخذ بيده فأخرجه من التنور ، فقال : ما ينبغي أن تخدمني ، ولاكن أنا أخدمك ، أخبرني عن بكائك علاى المتوفى الأول ، وعن ضحكك علاى الآخر ، قال : أما الأول ، فإنه لما دفن رأيت ما يلقاى به من الشر فذكرت ذنوبي فبكيت ، وأما الآخر : فإني رأيت ما يلقاى به من الخير ، فضحكت ، وكان بعد ذالك منح عظماء بني إسرائيل ) . ( طب ) . )(@)(@@)(@@)(@@) $ 9813 عن أبي زمعة البلوي رضي الله عنه قال :(@)(@@) | 30 ( قتل الصبر لا يمر بذنب إلا محاه ) . ( ك في تاريخه عن عائشة رضي الله عنها ) . )(@)(@@) PageV17P222(@)(@@)(@@)(@@) |||| ( 52 أبو زيد الأنصاري رضي الله عنه )(@)(@@)(@@)(@@) $ 9814 عن أبق زيد الأنصاري رضي الله عنه قال :(@)(@@) | 30 ( قال رسول 
ms5850	 الله : ( يدعون إلاى الله وليسوا من الله في شيء ، ومن قاتلهم كان أولاى بالله منهم ) يعني الخوارج ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) |||| ( مسند 53 أبي سبرة رضي الله عنه )(@)(@@)(@@)(@@) $ 9815 عن عيساى بن سبرة عن أبيه عن جده أبي سبرة رضي الله عنه قال : ( قال رسول الله :(@)(@@) | 30 ( ألا لا صلاة إلا بوضوء ، ولا وضوء لمن لم يذكر اسم الله عز وجل ، ألا لا يؤمن بالله من لا يؤمن بي ، ولا يؤمن بي من لمح يعرف حق الأنصار ) )(@)(@@)(@@)(@@) |||| ( 54 أبو سعيد الأنصاري رضي الله عنه )(@)(@@)(@@)(@@) $ 9816 عن مهاجر بن دينار :(@)(@@) | 30 ( أن أبا سعيد الأنصاري رضي الله عنه قال لعبد الملك بن مروان : إحفظ في وصية رسول الله قال : وما ذاك ؟ قال : اقبلوا من محسنهم ، وتجاوزوا عن مسيئهم وكان أبو سعيد زوج أسماء بنت يزيد بن السكن ) . ( كر ) . )(@)(@@)(@@)(@@) |||| ( مسند 55 أبي سعيد الخدري رضي الله عنه )(@)(@@)(@@)(@@) $ 9817 عن أبي سعيد رضي الله عنه قال : $ 30 ( قال رسول الله : ( أيها الناس إني تارك فيكم أمرين ، إن أخذتم بهما لم تضلوا بعدي أبدا ، وأحدهما أفضل من PageV17P223 الآخر : كتاب الله ، هو حبل الله الممدود من السماء إلاى الأرض ، وأهل بيتي عترتي ، ألا وإنهما لن يتفرقا حتى يردا علي الحوض ) ) .(@)(@@) ( ابن جرير ) . ) $(@)(@@)(@@)(@@) $ 9818 عن أبي سعيد رضي الله عنه قال :(@)(@@) | 30 ( سمعت رسول الله وهو يقول علاق المنبر : ما بال رجال يقولون 2 رحم رسول الله لا ينفع يوم القيامة علاى الحوض ، والله إن رحمي لموصولة في الدنيا والآخرة ، وإني أيها الناس فرط لكم يوم القيامة علاى الحوض ، وإن رجالا يقولون : يا رسول الله أنا فلان ابن فلان ، فأقول : أما النسب فقد عرفته ، ولاكنكم أحدثتم بعدي وارتددتم القهقراى ) . ( ابن النجار ) . )(@)(@@)(@@)(@@) $ 9819 عن أبي سعيد رضي الله عنه قال :(@)(@@) | 30 ( اعتكف رسول الله في المسجد ، فسمعهم يجهرون بالقراءة ، وهو في قبة له ، فكشف الستور فقال : ( ألا إن كلكم يناجي ربه ، فلا يؤذ بعضكم بعصا ولا يرفعن بعضكم علاى بعض في القراءة ) أو قال : في الصلاة ) . ( عب ) . )(@)(@@)(@@)(@@) $ 9820 عن 
ms5851	 أبي سعيد الخدري رضي الله عنه قال :(@)(@@) | 30 ( لما نزلت هذه الآية : { إذا جاء نصر الله والفتح } قرأها رسول الله حتى ختمها فقال : ( أنا وأصحابي خير والناس في خير ، لا هجرة بعد الفتح ) . ( ش ، ط ، وأبو نعيم في المعرفة ) . )(@)(@@)(@@)(@@) $ 9821 عن أبي سعيد رضي الله عنه قال :(@)(@@) | 30 ( لما نزلت هاذه السورة : { إذا جاء نصر الله والفتح } قرأها رسول ا لله حتى ختمها وقال : ( الناس خير ، وأنا وأصحابي خير ، وقال : لا هجرة بعد الفتح ، ولاكن جهاد ونية ، فقال له مروان : PageV17P224 كذبت ، وكان زيد بن ثابت ورافع بن خديج قاعدين ، قالا : صدق ) . ( ش ، حم ) . )(@)(@@)(@@)(@@) $ 9822 عن أبي سعيد الخدري رضي الله عنه قال :(@)(@@) | 30 ( ما وضع رجل جبهته لله تعالاى ساجدا فقال : يا رب اغفر لي ، يا رب اغفر لي ، يا رب اغفر لي ثلاثا إلا رفع رأسه وقد غفر له ) . ( ش ) . )(@)(@@)(@@)(@@) $ 9823 عن عمرو بن عطية العوفي ، عن أبيه ، عن أبي سعيد رضي الله عنه :(@)(@@) | 30 ( أن النبي كان يقول إذا قضاى صلاته : ( اللهم إني أسألك بحق السائلين عليك ، فإن للسائل عليك حقا ، أيما عبد أو أمة من أهل البر والبحر تقبلت دعوتهم ، واستجبت دعاءهم ، أن تشركنا في صالح ما يدعونك ، وأن تشركهم في صالح ما ندعوك ، وان تعافينا وإياهم ، وأن تقبل منا ومنهم ، وأن تجاوز عنا وعنهم ، فإنا آمنا بما إنزلت ، واتبعنا الرسول ، فاكتبنا مع الشاهدين ، وكان يقول : لا يتكلم بها أحد من خلق الله إلا أشركه الله في دعوة أهل بحرهم ، وأهل برهم ، وهو مكانه ) . ( الديلمي ) قال في المغني : عمرو بن عطية العوفي ضعفه قط ) . )(@)(@@)(@@)(@@) $ 9824 عن أبي سعيد الخدري رضي الله عنه قال :(@)(@@) | 30 ( يأتي علاى الناس زمان ، خيرهم من لا يأمر بالمعروف ولا ينهاى عن المنكر ) . ( ابن أبي الدنيا في كتاب الأمر بالمعروف والنهي عن المنكر ) . )(@)(@@)(@@)(@@) $ 9825 عن أبي سعيد رضي الله عنه ، عن النبي قال :(@)(@@) | 30 ( ما من شيء يصيب المؤمن في جسده إلا كفر الله تعالاى عنه به من الذنوب ) ، فقال أبي بن كعب 
ms5852	 رضي الله عنه : ( اللهم إني أسألك أن لا تزال الحمى مصارعة لجسد أبي بن كعب حتى يلقاك ، لا تمنعه من صلاة ولا صيام ، ولا حج ، ولا عمرة ، ولا جهاد في سبيلك ، فارتكبته الحمى مكانه ، فلم تفارقه حتى مات ، وكان في ذالك يشهد الصلاة ، ويصوم ، ويحج ، ويعتمر ، ويغزو ) . ( كر ) . )(@)(@@) PageV17P225(@)(@@)(@@)(@@) $ 9826 عن أبي سعيد رضي الله عنه قال :(@)(@@) | 30 ( قال رجل : يا رسول الله أرأيت هاذه الأمراض التي تصيبنا ، ما لنا بها ؟ قال : كفارات قال له أبي رضي الله عنه : وإن قلت ؛ قال : وإن شوكة فما فوقها ، فدعا أبي علاى نفسه أن لا يفارقه الوعك حتى يموت في أن لا يشغله عن حج ولا عمرة ولا جهاد في سبيل الله ، ولا صلاة مكتوبة في جماعة ، فما مسه إنسان إلا وجد حره حتى مات ) . ( حم ، كر ، ع ) . )(@)(@@)(@@)(@@) $ 9827 عن أبي سعيد رضي الله عنه :(@)(@@) | 30 ( أنه دخل علاى رسول ا لله وهو موعوك عليه قطيفة ، فوضع يده عليه فوجد حرارته فوق القطيفة ، فقال أبو سعيد : ما أشد حر حماك يا رسول الله ؟ فقال رسول الله : إنا كذالك يشدد علينا البلاء ويضاعف لنا الأجر ، فقال : يا رسول الله من أشد بلاء ؟ قال : الأنبياء ، قال : ثم من ؟ قال : الصالحون ، لقد كان أحدهم يبتلاى بالفقر حتى ما يجد إلا العباءة يجوبها فيلبسها ، ويبتلاى بالقمل حتى يقتله ، لأحدهم أشد فرحا بالبلاء من أحدكم بالعطاء ) . ( هب ) . )(@)(@@)(@@)(@@) $ 9828 عن أبي سعيد رضي الله عنه :(@)(@@) | 30 ( أن رسول الله بايع الناس وفيهم رجل ذو جثمان ، فقال له النبي : يا عبد الله أرزئت في نفسك شيئا قط ؟ قال : لا ، قال : ففي ولدك ؟ قال : لا ، قال : ففي أهلك ؟ قال : لا ، قال : يا عبد الله إن أبغض عباد الله إلاى الله : العفريت النفريت ، الذي لمح يرزأ في نفسه ولا أهله ، ولا ماله ، ولا ولده ) . ( الرامهرمزي في الأمثال ورجاله ثقات ) . )(@)(@@)(@@)(@@) $ 9829 عن أبي سعيد رضي الله عنه قال :(@)(@@) | 30 ( لما نزلت : { وآت ذا القرباى حقه } ، قال النبي : ( يا فاطمة لك فدك ) ) . ( ك في تاريخه 
ms5853	 وقال : تفرد به PageV17P226 إبراهيم بن محمد بن ميمون عن علي بن عابس ( ابن النجار ) . )(@)(@@)(@@)(@@) $ 9830 عن أبي سعيد رضي الله عنه :(@)(@@) | 30 ( أن النبي غرس عودا بين يديه ، وآخر إلاى جانبه ، وآخر بعده ، وقال : أتدرون ما هاذا ؟ قالوا : الله ورسوله أعلم ، قال : هاذا الانسان ، وهاذا الأجل ، يتعاطاى الأمل فيختلجه الأجل دون الأمل ) . ( الرامهرمزي في الأمثال ) . )(@)(@@)(@@)(@@) $ 9831 عن أبي سعيد رضي الله عنه قال :(@)(@@) | 30 ( لما اشتراى أسامة بن زيد رضي الله عنه وليدة بمائة دينار إلاى شهر ، فقال رسول ا لله : ( ألا تعجبون من أسامة المشتري إلاى شهر ، إن أسامة لطويل الأمل ، والذي نفسي بيده ما طرفت عيناي إلا ظننت أن شفري لا يلتقيان ، حتى يقبض الله تعالاى روحي ، ولا رفعت طرفي فظننت أني واضعه حتى أقبض ، ولا لقمت لقمة إلا ظنتت أني لا أسيغها حتى أغص بها من الموت ، ثم قال : يا بني آدم إن كنتم تعقلون فعدوا أنفسكم من الموتاى ، والذي نفسي بيده ، إنما توعدون لآت وما أنتم بمعجزين ) . ( كر ) وفيه أبو عقبة أحمد بن الفرج ضعيف ) . )(@)(@@)(@@)(@@) $ 9832 عن أبي سعيد رضي الله عنه قال :(@)(@@) | 30 ( بينما نحن مع رسول ا لله في الفرح إذ عرض له شاعر ينشد ، قال رسول ا لله : ( خذوا الشيطان ، أو امسكوا الشيطان ، لأن يمتليء جوف أحدكم قيحا خير له من أن يمتليء شعرا ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 9833 عن أبي سعيد رضي الله عنه قال :(@)(@@) | 30 ( نهاى النبي عن بيع الثمرة حتى يبدو صلاحها ، قالوا : وما صلاحها ؟ قال : تذهب علتها ، ويتخلص طيبها ) . ( ش ) . )(@)(@@)(@@)(@@) $ 9834 عن أبي سعيد رضي الله عنه قال :(@)(@@) | 30 ( مر النبي بغلام وهو يسلخ PageV17P227 شاة وهو ينفخ فيها ، فقال : ليس منا من غشنا ودحس بين جلدها ولحمها ولم يمس ماء ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9835 عن أبي سعيد رضي الله عنه قال :(@)(@@) | 30 ( نهاى رسول ا لله عن بيع الغنائم حتى تقسم ، وعن بيع الصدقات حتى تقبض ، وعن بيع العبد وهو آبق ، وعن بيع ما في بطون الأنعام حتى تضع ، وعن بيع ما في 
ms5854	 ضروعها إلا بكيل ، وعن ضربة القانص ) . ( عب ) . )(@)(@@)(@@)(@@) $ 9836 عن أبي سعيد الخدري رضي الله عنه قال :(@)(@@) | 30 ( خطبنا عمر بن الخطاب رضي الله عنه فقال : إني لعلي أنهاكم عن أشياء تصلح ، وآمركم بأشياء لا تصلح لكم ، وإن من آخر القرآن نزولا آية الربا ، وأنه قد مات رسول ا لله ولم يبينها لنا ، فدعوا ما يريبكم إلاى ما لا يريبكم ) . ( خط ) . )(@)(@@)(@@)(@@) $ 9837 عن أبي سعيد رضي الله عنه قال :(@)(@@) | 30 ( سمعت رسول ا لله مرتين علاى المنبر يقول : ( الذهب بالذهب ، والفضة بالفضة وزنا بوزن ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9838 عن أبي سعيد رضي الله عنه قال :(@)(@@) | 30 ( أتي النبي بصاع من تمر ريان ، وكان تمرنا بعلا ، فقال : أنى لكم هاذا ؟ قالوا : يا رسول الله بعنا صاعين من تمرنا بصاع من هاذا ، فقال : لا تفعلوا ، ولاكن بيعوا من تمركم ثم اشتروا من هاذا ) . ( ن ) . )(@)(@@)(@@)(@@) $ 9839 عن أبي سعيد رضي الله عنه قال :(@)(@@) | 30 ( دخل رسول الله علاى بعض أهله ، فوجد عندهم تمرا أجود من تمرهم ، فقال : من أين لكم هاذا ؟ فقالوا : أبدلنا صاعين بصاع ، فقال : لا صاعين بصاع ، ولا درهمين بدرهم ) . ( عب ) . )(@)(@@)(@@)(@@) $ 9840 عن أبي سعيد رضي الله عنه قال :(@)(@@) | 30 ( كان فيمن سلف من الناس رجل PageV17P228 رغسه الله مالا وولدا ، فلما حضره الموت جمع بنيه فقال : أي أب كنت لكم ؟ قالوا : خير أب ، فقال : إنه والله ما ابتار عند الله خيرا قط وإن ربه يعذبه ، فإذا أنا مت فأحرقوني ثم اسحقوني ، ثم اذروني في ريح عاصف ، قال الله : كن ، فإذا رجل قائم ، قال : ما حملك علاى ما صنعت ؟ قال : مخافتك ، فوالذي نفسي بيده إن تلقاه غيران غفر له ) . ( حب ) . )(@)(@@)(@@)(@@) $ 9841 عن أبي سعيد رضي الله عنه قال :(@)(@@) | 30 ( خطب عمر الناس فقال : إن الله رخص لنبيه ما شاء الله ، وإن نبي الله قد مضاى لسبيله وأتموا الحج والعمرة كما أمركم الله ، وحصنوا فروج هاذه النساء ) . ( حم ومسدد وابن أبي داود في المصاحف والطحاوي ) . )(@)(@@)(@@)(@@) $ 9842 عن أبي سعيد الخدري رضي الله عنه قال :(@)(@@) | 30 ( حججنا 
ms5855	 مع عمر بن الخطاب ، فلما دخل الطواف استقبل الحجر فقال : إني لأعلم أنك حجر لا تضر ولا تنفع ، ولولا أني رأيت رسول الله يقبلك ما قبلتك ، ثم قبله ، فقال علي بن أبي طالب رضي الله عنه : يا أمير المؤمنين إنه يضر وينفع ، قال : بم ؟ قال : بكتاب الله عز وجل ، قال : وأين ذالك من كتاب الله ؟ قال : قال الله تعالاى : { وإذ أخذ ربك من بني آدم منح ظهورهم ذريتهم } إلاى قوله : { بلاى } ، خلق الله آدم ومسح علاى ظهره فقررهم بأنه الرب وأنهم العبيد ، وأخذ عهودهم ومواثيقهم وكتب ذالك في رق ، وكان لهاذا الحجر عينان ولسانان ، فقال : افتح فاك ، ففتح فاه ، فألقمه ذالك الرق ، فقال : اشهد لمن وافاك بالموافاة يوم القيامة ، وإني أشهد لسمعت رسول الله يقول : يؤتاى يوم القيامة بالحجر الأسود وله لسان ذلق يشهد لمن استلمه PageV17P229 بالتوحيد ، فهو يا أمير المؤمنين يضر وينفع ، فقال عمر : أعوذ بالله أن أعيش في قوم لست فيهم يا أبا الحسن ) . ( الهندي في فضائل مكة ، أبو الحسن القطان في الطوالات ، ك ولم يصححه عب وضعفه ) . )(@)(@@)(@@)(@@) $ 9843 عن أبي سعيد رضي الله عنه :(@)(@@) | 30 ( أن رسول الله كان يدعو بعرفة ويرفع يديه هاكذا : يجعل ظاهرهما مما يلي وجهه ، وباطنهما مما يلي الأرض ) . ( ش ) . )(@)(@@)(@@)(@@) $ 9844 عن أبي سعيد وأبي هريرة رضي الله عنها قالا :(@)(@@) | 30 ( خطبنا رسول الله يوم النحر فقال : إن دماءكم وأموالكم عليكم حرام ، كحرمة يومكم هاذا ، في شهركم هاذا ، في بلدكم هاذا ) . ( ابن النجار ) . )(@)(@@)(@@)(@@) $ 9845 عن أبي سعيد الخدري رضي الله عنه :(@)(@@) | 30 ( أنه قدم من سفر فقدم إليه أهله لحما من لحوم الأضاحي فقال : ما أنا بآكله حتى أسأل ، فانطلق إلاى أخيه لامه وكان بدريا قتادة بن النعمان ، فسأله عن ذالك ؟ فقال : إنه قد حدث بعدك أمر نقضا لما كانوا نهوا عنه من أكل لحوم الأضاحي بعد ثلاثة أيام ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9846 عن أبي سعيد رضي الله عنه :(@)(@@) | 30 ( أن النبي حلق يوم الحديبية هو وأصحابه إلا عثمان وأبا قتادة ، فقال رسول الله : يرحم 
ms5856	 الله المحلقين ، قالوا : والمقصرين يا رسول الله ؟ قال : يرحم الله المحلقين ، قالوا : والمقصرين ؟ قال : المحلقين والمقصرين ) . ( ش ) . )(@)(@@)(@@)(@@) $ 9847 عن أبي سعيد رضي الله عنه قال :(@)(@@) | 30 ( من عمل ذالك من قوم لوط إنما كانوا ثلاثين رجلا ونيفا ، لا يبلغون أربعين ، فأهلكهم الله جميعا ، وقال رسول الله : لتأمرن بالمعروف ولتنهون عن المنكر أو لتعمنكم العقوبة جميعا ) . ( إسحاق بن بشر ، كر ) . )(@)(@@) PageV17P230(@)(@@)(@@)(@@) $ 9848 عن أبي سعيد الخدري رضي الله عنه :(@)(@@) | 30 ( أن رسول الله ضرب في الخمر بنعلين أربعين ، فجعل عمر رضي الله عنه مكان كل نعل سوطا ) . ( ش ) . )(@)(@@)(@@)(@@) $ 9849 عن أبي سعيد رضي الله عنه قال :(@)(@@) | 30 ( نهاى رسول الله عن الزهو والتمر والزبيب والتمر ) . ( ش ) . )(@)(@@)(@@)(@@) $ 9850 عن أبي سعيد الخدري رضي الله عنه :(@)(@@) | 30 ( أن وفد عبد القيس لما أتوا النبي قالوا : يا نبي الله جعلنا الله فداك ، ماذا يصلح لنا من الأشربة ؟ فقال : لا تشربوا في النقير ، قالوا : يا رسول الله جعلنا الله فداك ، أوتدري ما النقير ؟ قال : نعم الجذع ينقر وسطه ، ولا الدباء ولا الحنتمة ، وعليكم بالموكي ) . ( عب ) . )(@)(@@)(@@)(@@) $ 9851 عن أبي سعيد رضي الله عنه قال :(@)(@@) | 30 ( كنا جلوسا عند النبي فقال : جاءكم وفد عبد القيس ولا نراى شيئا ، فمكثنا ساعة ، فإذا هم قد جاءوا فسلموا علاى النبي ، فقال لهم النبي : أبقي معكم شيء من تمركم أو قال : من زادكم ؟ قالوا : نعم ، فأمر بنطع فبسط ، ثم صبوا فيه بقية تمر كان معهم ، فجمع النبي أصحابه وجعل يقول لهم : تسمون هاذا التمر البرني ، وهاذه كذا ، وهاذه كذا الألوان التمر ؟ قالوا : نعم ، ثم أمر بكل رجل منهم رجلا من المسلمين ينزله عنده ويقرئه ويعلمه الصلاة ، فمكثوا جمعة ثم دعاهم فوجدهم قد قرءوا وفقهوا ، فحولهم إلاى غيره ، ثم تركهم جمعة أخراى ثم دعاهم ، فوجدهم قد قرءوا وتفهموا فقالوا : يا رسول الله إنا قد اشتقنا إلاى بلادنا وقد علمنا الله خيرا وفقيهنا ، فقال إرجعوا إلى بلادكم ، قالوا : لو سألنا رسول الله عن شراب نشربه بأرضنا ، فقالوا : يا رسول الله إنا نأخذ النخلة فنجوبها 
ms5857	 ، ثم نضع التمر فيها ونصب عليه الماء ، فإذا صفا PageV17P231 شربناه ، قال : وماذا ؟ قالوا : ونأخذ هاذه الدباء فنضع فيه التمر ، ثم نصب عليه الماء ، فإذا صفا شربناه ، قال : وماذا ؟ قالوا : نأخذ هاذه الحنتمة فنضع فيها التمر ثم نصب عليه الماء ، فإذا صفا شربناه ، فقال النبي : لا تنبذوا في الدباء ولا في النقير ولا في الحنتم ، وانتبذوا في هاذه الأسقية التي يراث علاى أفواهها ، فإن رابكم فاكسروه بالماء ) . ( عب ) . )(@)(@@)(@@)(@@) $ 9852 عن أبي سعيد الخدري رضي الله عنه قال :(@)(@@) | 30 ( قال أبو بكر : ألست أحق الناس بها ؟ ألست أول من أسلم ؟ ألست صاحب كذا ؟ ) . ( ت والبزار حب وأبو نعيم في المعرفة وابن منده في غرائب شعبه ص ، د ) . )(@)(@@)(@@)(@@) $ 9853 عن أبي سعيد الخدري رضي الله عنه قال :(@)(@@) | 30 ( لما توفي رسول الله قام خطباء الأنصار ، فجعل الرجل منهم يقول : يا معشر المهاجرين إن رسول الله كان إذا استعمل رجلا منكم قرن معه رجلا منا ، فنراى أن يلي هاذا الأمر رجلان : أحدهما منكم ، والآخر منا ، فتتابعت خطباء الأنصار علاى ذالك ، فقام زيد بن ثابت فقال : إن رسول الله كان من المهاجرين ، وإن الامام يكون من المهاجرين ونحن أنصاره ، كما كنا أنصار رسول الله ، فقام أبو بكر رضي الله عنه فقال : جزاكم الله يا معشر الأنصار خيرا ، وثبت قائلكم ، ثم قال : أما والله لو فعلتم غير ذالك لما صالحناكم ، ثم أخذ زيد بن ثابت بيد أبي بكر فقال : هاذا صاحبكم فبايعوه ، ثم انطلقوا ، فلما قعد أبو بكر علاى المنبر نظر في وجوه القوم ، فلم ير عليا رضي الله عنه ، فسأل عنه ، فقام الناس من الأنصار فأتوا به ، فقال أبو بكر : ابن عم رسول الله وختنه ، أردت أن تشق عصا المسلمين ، فقال : لا تثريب يا خليفة رسول الله فبايعه ، ثم لم ير الزبير بن العوام فسأل عنه حتى جاءوا به ، فقال : ابن عمة رسول الله وحواريه أردت أن تشق عصا المسلمين ، فقال مثل قوله : لا تثريب يا خليفة رسول الله فبايعاه ) . ( ط وابن سعد ش وابن 
ms5858	 جرير ق ، ك ، كر ) . )(@)(@@) PageV17P232(@)(@@)(@@)(@@) $ 9854 عن أبي سعيد الخدري رضي الله عنه قال :(@)(@@) | 30 ( سمعت منادي أبي بكر رضي الله عنه ينادي بالمدينة حين قدم عليه مال البحرين : من كانت له عدة عند رسول الله فليأت ، فيأتيه رجال فيعطيهم ، فجاء أبو بشير المازني فقال : إن رسول الله قال لي : يا أبا بشير إذا جاءنا شيء فأتنا ، فأعطاه أبو بكر حفنتين أو ثلاثا ، فوجدها ألفا وأربع مائة ( درهم ) . ( ابن سعد ) . )(@)(@@)(@@)(@@) $ 9855 عن أبي سعيد الخدري رضي الله عنه قال :(@)(@@) | 30 ( لما بويع أبو بكر الصديق رضي الله عنه قال : أين علي لا أراه ؟ قالوا : لم يحضر قال : ابن الزبير ؟ قالوا : لم يحضر ، قال : ما حسبت إلا أن هاذه البيعة عن رضا جميع المسلمين ، إن هاذه البيعة ليست كبيع الثوب الخلق ، إن هاذه البيعة لا مردود لها ؛ فلما جاء علي قال : يا علي ما أبطأ بك عن هاذه البيعة ؟ قلت : إني ابن عم رسول الله وختنه علاى ابنته ، لقد علمت أني كنت في هاذا الأمر قبلك ، قال : لا تزري بي يا خليفة رسول الله ، فمد يده فبايعه ، فلما جاء الزبير قال : ما أبطأ بك عن هاذه البيعة ؟ قلت : إني ابن عمة رسول الله وحواريه ، أما علمت أني كنت في هاذا الأمر قبلك ؟ قال : لا تزري بي يا خليفة رسول الله ومد يده فبايعه ) . ( المحاملي ) قال ابن كثير : إسناده صحيح ) . )(@)(@@)(@@)(@@) $ 9856 عن أبي سعيد رضي الله عنه :(@)(@@) | 30 ( أن رسول الله قال : ( سيكون أمراء يظلمون ويكذبون ويغشاهم غواش ) أو قال : حواش من الناس ، فمن أعانهم علاى ظلمهم ، وصدقهم بكذبهم ، فليس مني ولا أنا منه ، ومن لم يصدقهم بكذبهم ولم يعنهم علاى ظلمهم فهو مني وأنا منه ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 9857 عن أبي سعيد رضي الله عنه :(@)(@@) | 30 ( أن رسول الله بعث علقمة بن محرز علاى بعث أنا فيهم ، فلما انتهاى إلاى رأس غرامة أو كان ببعض الطريق استأذنته طائفة من الجيش ، فأذن لهم ، وأمر عليهم عبد الله بن حذافة بن قيس PageV17P233 السهمي ، فكنت فيمن 
ms5859	 غزا معه ، فلما كنا ببعض الطريق ، أوقد القوم نارا ليصطلوا أو ليصطنعوا عليه صنيعا لهم ، فقال عبد الله وكانت فيه دعابة أليس لي عليكم السمع والطاعة ؟ قالوا : بلاى ، قال : فما نأمركم بشيء إلا صنعتموه ؟ قالوا : نعم ، قال : فإني أعزم عليكم إلا تواثبتم في هاذه النار ، فلما قدمنا ذكرنا ذالك لرسول الله فقال : من ( أمركم منهم بمعصية فلا تطيعوه ) . ( ش ) . )(@)(@@)(@@)(@@) $ 9858 عن أبي المتوكل الناجي ، عن أبي سعيد الخدري رضي الله عنه :(@)(@@) | 30 ( أن ملك الروم أهداى إلاى رسول الله جرة من زنجبيل فقسمها رسول الله بين أصحابه ، فأعطاى كل رجل قطعة وأعطاني قطعة ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 9859 عن أبي سعيد الخدري رضي الله عنه قال :(@)(@@) | 30 ( حضر النبي جنازة ، فقال : ( علاى صاحبكم دين ؟ قالوا : نعم ، قال : صلوا عليها ، قال علي رضي الله عنه : علي الدين يا رسول الله ، فصلى عليها ، قال : فك الله رهانك يا علي كما فككت رهان أخيك في الدنيا ، من فك رهان أخيه في الدنيا فك الله تعالاى رهانه يوم القيامة ، فقال رجل : يا رسول الله لعلي خاصة أم للناس عامة ؟ قال : بل للناس عامة ) . ( كر وقال : فيه محمد بن خالويه لا أعرفه في أصحاب الحديث انتهاى ، وفيه أيضا : عبيد الله بن الوليد الرصافي عن عطية العوفي ضعيفان ) . )(@)(@@)(@@)(@@) $ 9860 عن أبي سعيد رضي الله عنه قال :(@)(@@) | 30 ( شهدت جنازة فيها النبي ، فلما وضعت سأل النبي هل عليه دين ؟ قالوا : نعم ، فعدل عنها وقال : صلوا علاى صاحبكم ، فلما رآه علي رضي الله عنه يمضي قال : يا رسول الله هو بريء من دينه أنا ضامن لما عليه ، فأقبل النبي فصلى عليه ، فلما انصرف قال : يا علي جزاك الله والاسلام خيرا ، فك الله رهانك من النار كما فككت رهان أخيك المسلم ، ليس من عبد مسلم يقضي عن أخيه دينا إلا فك الله رهانه يوم القيامة ، فقام رجل من الأنصار فقال : يا رسول الله لعلي هاذا خاصة ؟ قال : لا ، بل لعامة PageV17P234 المسلمين ) ، قال : لا ، بل لعامة المسلمين . ( ابن زنجويه وفيه عبيد بن 
ms5860	 الوليد الرصافي عن عطية ضعيفان ) . )(@)(@@)(@@)(@@) $ 9861 عن أبي سعيد رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : ( والله إن أحدكم ليخرج بمسألته من عندي متأبطها وما هي له إلا نار ) ، قال عمر رضي الله عنه : فلم تعطيهم يا رسول الله وهي نار ؟ قال : ما أصنع ؟ يسألوني وأنا كاره فأعطيهم ، ويأباى الله لي البخل ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 9862 عن أبي سعيد رضي الله عنه قال :(@)(@@) | 30 ( أتاى رجلان رسول الله يسألانه في ثمن بعير فأعطاهما دينارين ، فخرجا من عنده فلقيهما عمر بن الخطاب رضي الله عنه فأثنيا علاى رسول الله ، فدخل عمر علاى رسول الله فأخبره بما قالا ، فقال رسول الله : ولاكن فلانا أعطيته ما بين عشرة إلاى مائة فلم يثن بذالك يعني : أبا سفيان ؛ ( ثم قال رسول الله : أما إن أحدكم يخرج من عندي متأبطا مسألته وهي نار ) ، فقال عمر : فلم تعطيناها يا رسول الله وهي نار ؟ قال : إنكم تسألوني والله يأباى لي البخل ) . ( ابن جرير هب ) . )(@)(@@)(@@)(@@) $ 9863 عن أبي سعيد رضي الله عنه قال :(@)(@@) | 30 ( بينا رسول الله يقسم ذهبا ، إذ جاءه رجل فقال : يا رسول الله أعطني فأعطاه ، ثم قال : زدني فزاده مرارا ، ثم ولى مدبرا ، ( فقال رسول الله : إن الرجل ليأتيني فيسألني فأعطيه ، ثم يسألني فأعطيه يقولها ثلاث مرات ثم يولي مدبرا وقد أخذ بيده نارا ووضع في ثوبه نارا ، وانقلب إلاى أهله بنار ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 9864 عن أبي سعيد رضي الله عنه :(@)(@@) | 30 ( أن ناسا من الأنصاره سألوا رسول الله فأعطاهم ، ثم سألوه فأعطاهم ، حتى إذا نفد ما عنده ، قال : إن يكن عندي من خير فلن أدخره عنكم ، ومن يستعفف يعفه الله ، ومن يستغن يغنه الله ، ومن يتصبر يصبره الله ، وما أعطي أحد عطاء هو خير وأوسع من الصبر ) . ( ابن جرير ) . )(@)(@@) PageV17P235(@)(@@)(@@)(@@) $ 9865 عن أبي سعيد رضي الله عنه قال :(@)(@@) | 30 ( أرسلني أهلي إلاى رسول الله أسأله لهم طعاما ، فجئت والنبي يخطب الناس ، فسمعته يقول في خطبته : من يتصبر يصبره الله ، ومن يستعف يعفه الله ، ومن يستغن يغنه 