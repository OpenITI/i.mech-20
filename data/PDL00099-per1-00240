ms221	 تو بی‌قرین خیزد(@)(@@) 14 ز رشک نازکی و نوبهار طلعت تو %~% طراوت و طرب از طبع فرودین خیزد(@)(@@) 15 مدام از نی‌ کلکم‌ که رشک نیشکرست %~% به وصف لعل تو گفتار شکرین‌ خیزد(@)(@@) 16 بدان رسیده‌ که بر طبع خویش رشک برم %~% کزان سفینه چسان گوهری چنین خیزد(@)(@@) 17 سزد که سجده برم پیش طبع‌ قاآنی %~% کزو نهفته همی مدح شاه دین خیزد(@)(@@) 18 علی‌که‌ گر کندش‌ مدح طفل ابجدخوان %~% ز آسمان و زمین بانگ آفرین خیزد(@)(@@) 19 شهی که خاتم قدرت کند چو در انگشت %~% هزار ملک سلیمانش از نگین خیزد(@)(@@) 20 اگر بر ادهم ‌گردون ‌کند به خشم نگاه %~% نشان داغ مه و مهرش از سرین خیزد(@)(@@) 21 به روی زین جو نشیند‌ گمان بری‌ که مگر %~% هزار بیشه غضنفر ز پشت زین خیزد(@)(@@) 22 شبیه پیکر یکران اوست‌ کوه ‌گران %~% زکوه اگر روش صرصر بزین خیزد(@)(@@) 23 شها دوبینی ذات و رسول خدای %~% نه از دو دیده که از دیده دوبین خیزد(@)(@@) 24 به روز عرض سخا صد هزار گنج‌ گهر %~% ز آستین تو ای شاه راستین خیزد(@)(@@) 25 به جای موج ز رشک کف تو بحر محیط %~% زمان زمان عرق شرمش از جبین خیزد(@)(@@) 26 به روز رزم تو هر خون که خورده در زهدان %~% ز بیم خشم تو از چشم هر جنین خیزد(@)(@@) 27 به نزد شورش رزم تو شور و غوغایی %~% کز آسمان و زمین روز واپسین خیزد(@)(@@) 28 هزار بار به نسبت از آن بود کمتر %~% که روز معرکه از پشه‌یی طنین خیزد(@)(@@) 29 برای آنکه ترا روز و شب سلام‌کنند %~% ز جن و انس و ملایک صفیر سین خیزد(@)(@@) 30 مخالفان ترا هر زمان به جای نفس %~% ز سینه ناله برآید ز دل انین خیزد(@)(@@) 31 ز من که غرق گناهم ثنای حضرت تو %~% چنان غریب‌ که ‌گوهر ز پارگین خیزد(@)(@@) 32 تو آن شهی‌ که ‌گدایان آستان ترا %~% هزار دامن ‌گوهر 
ms222	 ز آستین خیزد(@)(@@) 33 گدای راه‌نشینم ولی به همت تو %~% یسار گنج‌ گهربارم از یمین خیزد(@)(@@) 34 شها ثناگر خود را ممان به درگه خلق %~% که شرمسار کند جان و شرمگین خیزد(@)(@@) 35 چنان به یک نظر لطف بی‌نیازش‌کن %~% که از سر دو جهان از سر یقین خیزد(@)(@@) 36 هزار سال بقا باد دوستان ترا %~% به شرط آنکه ز هر آنش صد سنین خیزد PageV1P149(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای صفاهان مژده کاینک شاه دوران می رسد %~% جسم بیجان ترا از نو به تن جان می‌رسد(@)(@@) 2 غصه را بدرود کن‌کاید مسرت این زمان %~% درد را پیغام‌ ده‌ کاین‌ لحظه درمان می‌رسد(@)(@@) 3 گرد نعل توسنش بنشست بر اندام ما %~% خاک راه موکبش تا چرخ‌گردان می‌رسد(@)(@@) 4 ظل چتر رایتش ‌‌گسترده تا ترشم برین %~% دور باش حضرتش‌‌تاکاخ‌کیوان می‌رسد(@)(@@) 5 با جلال‌کیقباد و شوکت افراسیاب %~% با شکوه قیصر و فر سلیمان می‌رسد(@)(@@) 6 خسره پرویز آ‌ید زی مداین این زمان %~% یا سوی کابلستان سام نریمان می‌رسد(@)(@@) 7 یا نه پور زادشم پوید به حصن گنگ دژ %~% یا نه‌گرد زابلی سوی سجستان می‌رسد(@)(@@) 8 یا نه تیمور دوم‌ گردد سمرقندش‌ مکان %~% یا نه قاآن نخسش زی‌کلوران می‌رسد(@)(@@) 9 یا نه سلطان آتسز روزی هزار اسب آورد %~% یا مگر شاه اخستان نزد شروان می‌رسد(@)(@@) 10 اردوان کاردان اکنون شتابد سوی ری %~% اردشیر شیردل نک سوی‌کرمان می‌رسد(@)(@@) 11 یا به سوی باره استخر تازد جم شید %~% یا به سوی‌ کشور تبریز غازان می‌رسد(@)(@@) 12 یا مگر سنجر به نیشابور راند بادپای %~% یا مگر سلطان جلال‌الدین به‌ ملتان می‌رسد(@)(@@) 13 یا اتابک جانب شیراز فرماید نزول %~% یا حسن شاه بهادر زی سپاهان می‌رسد(@)(@@) 14 آن‌جهانداری ‌که از خاک ره جان‌پرورش %~% سرزنش‌ها هر زمان بر آب حیوان می‌رسد(@)(@@) 15 آن جهانجویی ‌که از بوی نسیم رافتش %~% هر نفس بیغارها بر باغ رضوان می‌رسد(@)(@@) 16 آنکه از یاقوت‌باریهای نوک تیغ او %~% طعنها هر لحظه برکوه بدخشان می‌رسد(@)(@@) 17 نسبت 
ms223	 رایش نخواهم داد با تابنده مهر %~% زانکه راث را آریا تشبیه نقصان می‌رسد(@)(@@) 18 آشکارا هر زمان از جانب بخت سعید %~% بر روان او اشارت‌های پنهان می‌رسد(@)(@@) 19 تا به‌کی قاآنیا بیهوده می‌رانی سخن %~% کی‌از ای‌ت‌توصیف‌اوصاف‌به‌پایان می‌رمبد(@)(@@) 20 باد تابان اخترت تا هر سحر از خاوران %~% سوی ملک باختر خورشید تابان می‌رسد PageV1P150(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 مگر شرمنده از تیغ شه و ابروی جانان شد %~% که امشب ماه عید اندر نقاب ابر پنهان شد(@)(@@) 2 و یا ابراز پی ایثار بزم جشن عید شه %~% به‌رغم سیم ماه نو ز باران ‌گوهرافشان شد(@)(@@) 3 و یا بهر مبارک‌باد عید از عالم بالا %~% نزول رحمت حق شامل احوال سلطان شد(@)(@@) 4 حس شاه غضنفرفر که خا‌ک نعل شبرنگش %~% طراز افسر فغفور و زیب تاج خاقان شد(@)(@@) 5 قضا امری که رایش مظهر خورشید و ماه آمد %~% قدرقدری‌که‌طبعش‌ مخزن انعام و احسان شد(@)(@@) 6 جهان داور جهانداری‌ که از معماری عدلش %~% سرای امن‌گشت آباد وکاخ فتنه ویران شد(@)(@@) 7 به میزان سعادت هم ترازو گشت با تختش %~% از آنرو منزل ناهید اندر برج میزان شد(@)(@@) 8 گرایان می‌نشد دست تطاول بر گریبانی %~% از آنرو کامن با دوران او دست و گریبان شد(@)(@@) 9 ز انصافش چنان رسم ستم برخاست ازگیتی %~% که با شیر ژیان بن‌گاه آهو در نیستان شد(@)(@@) 10 مگرمی خواست کردن آشنا در بحر خون تیغش %~% که همچون مردم آبی ز پا تا فرق عریان شد(@)(@@) 11 حسامش ‌حامی ‌دینست ‌و زینم‌ بس‌ شگفت آید %~% که ‌همچون ‌کافر حربی‌ به‌ خون‌ خلق‌ عطشان شد(@)(@@) 12 برابرکی شود با ابر دست راد او عمان %~% که ‌از هر قطره‌اش زاینده صد دریای عمان شد(@)(@@) 13 نظر بر عفو شه دارند زین پس صالح و طالح %~% که لطف و قهر خسرو ناسخ فردوس و نیران شد(@)(@@) 14 بریدی بادپاکوتا به ملک زاوه بشتابد %~% سراید بدسگال شاه را کز اهل طغیان شد(@)(@@) 15 که ای ازکید 
ms224	 اهریمن زنخ پیچیده از فرمان %~% چه شد کاخر روانت غرقه دریای خذلان شد(@)(@@) 16 چرا ‌پیچیدی از فرهان شاهی سکه فرمانش %~% روان در نه سپهر و شش جهات و چار ارکان شد(@)(@@) 17 تو از کابل خدا افزون نیی‌ کز کینه لشکرکش %~% زهند وقندهار و سند و لاهور و سجستان شد(@)(@@) 18 دمان با چل هزار افغان آتش‌خوی آهن‌دل %~% که ‌هر یک ‌لاشه ‌بیجان‌شان ‌همدست دستان شد(@)(@@) 19 به ناپاک اعتقاد خویش ‌کز نیرنگ قیر آگین %~% به عزم رزم‌شاه و ترکتاز ملک ایران شد(@)(@@) 20 سرانجام از هراس غازیان شاه شیر اوژن %~% گریزان از در دست و غار و تابملتان شد(@)(@@) 21 هم از خوارزم‌شه برتر نیی ‌کز کین سپاه ‌آرا %~% ز مرو و اندخود و قندز و بلخ‌ و شبرقان‌ شد(@)(@@) 22 روان با سی‌ هزار اهرن منش عفریت جادوگر %~% به عزم رزم‌ شاه و فتح اقلیم خراسان شد(@)(@@) 23 سرانجام آن‌هم‌از آسیب‌مال‌و جان‌و تاج و سر %~% گریزان چون ‌گراز از بیم شیر نر گرازان شد(@)(@@) 24 چگو‌یم‌چو‌ن‌تو خو‌د زین ‌پیش‌دیدستی‌و می‌‌دانی %~% که ‌از الماس‌گون ‌تیغش ‌جهان کوه بدخشان شد(@)(@@) 25 مگر این نی همان شهزاده کاندر بند قهر او %~% تنت همچون برهمن بسته زنجیر رهبان شد(@)(@@) 26 مگر این نی‌همان‌شاهی که اندر دشت کافردژ %~% ز سهم ‌سهم ‌خونریزش به‌ چرخ‌ افغان افغان شد(@)(@@) 27 مگر این ن‌ی هم‌ان‌گردنکش‌ی‌کز تیشه قهرش %~% برابر با زمین بنیان بام و بوم ملان شد(@)(@@) 28 مگر این نی همان پیل پلنگ‌آویز شیرافکن %~% که‌از صد میل‌پیل از صدمه‌ گرزش گریزان شد(@)(@@) 29 مگر این نی همان ارغنده شبر بیشه مردی %~% که‌اندر بیشه‌شیر ازبیم‌شمشیرش‌هراسان شد(@)(@@) 30 مگر این ‌نی ‌همان ‌اسب افکنی ‌کز گرد شبرنگش %~% هوای پهنه هیجا فضای بربرستان شد(@)(@@) 31 مگر این ‌نی ‌همان ‌خاور خداوندی‌ که ‌فوجش را %~% غنیمت از دیار خاوران تا ملک ختلان شد(@)(@@) 32 مگر نی ‌این‌ همان‌ گیتی ‌کنارنگی که خصمش را %~% هزیمت از دیار روس تا مرز 
ms225	 کلوران شد(@)(@@) 33 مگر این نی همال جمشید افرنگی که جیشش‌ را %~% به مفتاح ظفر مفتوح هفت اقلیم دوران شد(@)(@@) 34 مگر این نی همان کیخسروی کاسفندیارآسا %~% ز ایران لشکرآرا از پی تاراج توران شد(@)(@@) 35 شها افسرستانا تاج‌بخشا مملکت‌گیرا %~% تویی ‌کز تابش رایت خجل خورشد تابان شد(@)(@@) 36 ز بس طوفان خون آورد شمشیر جهانسوزت %~% ز خاطر باستان را داستان نوح و طوفان شد(@)(@@) 37 چنان شد بی‌نیاز از جود دشت آز در عالم %~% که‌در چشم ‌مساکین سنگ و گوهر هر ‌دو یکسان شد(@)(@@) 38 زمین ملک از طراحی دهقان عدل تو %~% طراز خانه ارژنگ و زیب باغ رضوان شد(@)(@@) 39 بدانسان آمد آباد از ازل ملک وسیم تو %~% که هر چیز اندرو پیدا بغیر از نام پایان شد(@)(@@) 40 عدو آشفته زلف پر خمت را خواب دید آنگه %~% به‌صد آشفتگی‌بیدار از آن خواب پریشان شد(@)(@@) 41 شراری در جهان جست از تف تیغ شرربارت %~% هویدا آنگه از خاکسترش الوند و ثهلان شد(@)(@@) 42 بقای جاودانی ملک را بخشد جهانسوزت %~% به‌ظلمات نیام از آن نهان چون آب حیوان شد(@)(@@) 43 الا تا مردمان‌گویند فتح قلعه خیبر %~% به عون بازوی‌کشورگشای شیر یزدان شد(@)(@@) 44 چنان ‌مفتوح ‌گردد ملک خصم از تیغ و بازویت %~% که‌گوید هرکسی زه‌زه عجب فتح‌نمایان شد PageV1P151(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 به ‌گوش از هاتف غیبم سحرگه این ندا آمد %~% که‌وقت عشرت جانبخش و جشن جانفزا آمد(@)(@@) 2 به سالاری سپهسالار دارای تهمتن تن %~% گو سهراب دل شهزاده ارغون میرزا آمد(@)(@@) 3 ظفرمندی‌که هندی اژدهای اژدر اوبارش %~% به فرق بدکنش آتش‌فشان چون اژدها آمد(@)(@@) 4 عدوبندی‌که خطی رمح او در پهنه هیجا %~% دم آهنج اژدری بیجان و ماری جانگزا آمد(@)(@@) 5 به ‌نزد خضر دانش مؤبدان این بس شگفتی زو %~% که زندان سکندر منبع آب بقا آمد(@)(@@) 6 شگفتی اینکه قیرآگین نیام ظلمت‌آیینش %~% به کام تیره‌بختان چشمه آب فنا آمد(@)(@@) 7 به شکل عین از آ‌نرو آمد از روز 
ms226	 ازل تیغش %~% که عین عون و عین فعل و عین مدعا آمد(@)(@@) 8 کشد در دیده خاک راه آهو از شرف ضیغم %~% به‌ گیتی عدل او تا حاکم و فرمانروا آمد(@)(@@) 9 سکندر خوانمش زانروکه از رای جهان‌آرا %~% نمایان مظهر آیینه‌ گیتی‌نما آمد(@)(@@) 10 وگر افراسیابش نیز خوانم بس عجب نبود %~% که آهن‌خود و آهن‌جوشن و آهن‌قبا آمد(@)(@@) 11 دلش سرچشمه فیض و نوال و بخشش و احسان %~% کفش کان عطا و ریزش و جود و سخا آمد(@)(@@) 12 عبیر خلق او را تالی مشک ختن خواندم %~% خرد چین بر جبین افکند کاین عین خطا آمد(@)(@@) 13 تعالی‌الله بنام ایزد زهی ای آسمان قدری %~% که حکم نافذت پهلوزن امر قضا آمد(@)(@@) 14 به تیر راست رو خم کرده پشت بدسگالان را %~% ک‌مانت‌ کز ازل چو‌ن پشت نه‌گردون دو تا آمد(@)(@@) 15 نهنگی اژدها شکلست شمشر شرربارت %~% که‌ هم‌ خود بحر خون‌ آورد و هم‌ خود آشنا آمد(@)(@@) 16 فکر سرسام‌ جست‌ از صدمه ‌گرزت‌ از آن بر تن %~% صلیب‌افکن ز خط قطب و خط استوا آمد(@)(@@) 17 ر‌باید مغفر از فرق دلیران تیغ رخشانت %~% خهی آهن سلب اعجوبیی کاهن‌ ‌ربا آمد(@)(@@) 18 شها خصم پدرت آن تیره بخت بدکنش‌‌کایدر %~% سرش بر تن گران از کید و دیوش‌ رهنما آمد(@)(@@) 19 بسیج رزم را سازد که با وی ‌کینه آغازد %~% نداندکاو بت از داور خداگان خدا آمد(@)(@@) 20 ز بهر دفع او اکنون بر آن تازی‌نسب بنشین %~% که در دشت دغا همپویه با باد صبا آمد(@)(@@) 21 دمی زن با پدرت آن شر‌زه شیر‌ بیشه مردی %~% که از گرزش تن الوند و ثهلان توتیا آمد(@)(@@) 22 که هان ای شاه لختی بر به جان‌افشان تابین %~% که روز آزمون ما به میدان دغا آمد(@)(@@) 23 عنان ‌در دست ‌ما بگذار و خود بنشین ‌رکابی زن %~% یکی بر جوهر ما بین که وقت کارها آمد(@)(@@) 24 نه آخر بچه شیر ژیان شیر ژیان‌ردد 
