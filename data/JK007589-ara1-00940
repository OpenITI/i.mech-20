ms921	 % % مالا يصان وحر وجه يبتذل % % PageV01P3631 البحر : - 1(@)(@@) % قطع الله عذر من أبواه % هاشميان أن يكون بخيلا % % 2(@)(@@) % خرجا سالمين من كل ذم % % وأحالا عليه ذما ثقيلا % % PageV01P3632 البحر : - 1(@)(@@) % إذا ما مدحت الناقصين فإنما % % تذكرهم مافي سواهم من الفضل % 2(@)(@@) % فتهدي لهم حزنا طويلا وحسرة % وإن منعوا منك النوال فبالعدل % PageV01P3633 البحر : - 1(@)(@@) % قلبت بطون الشعر قبل ظهوره % فلم أر قولا لم تقدمه بالفعل % 2(@)(@@) % وما استطرف الأقوام لي فيك مدحة % لأني بما علمتهم بك من جهل % 3(@)(@@) % أعرفهم منك الذي يعرفونه % % وأسلافهم من قبل شعري ومن قبلي % % 4(@)(@@) % فيعرض عنه السامعون وإنني % % لذو المذهب المحمود والمنطق الجزل % PageV01P3634 البحر : - 1(@)(@@) % لاتغش إلا ملكا في منزله % يعرض في مشربه ومأكله % 2(@)(@@) % وفي تلهيه وفي تعلله % % ومايريه الحق من تفضله % 3(@)(@@) % على أخ يأوي إلى تطوله % % عن أمه وعرسه وعدله % % 4(@)(@@) % لاعبده مستمكن من مقتله % ولا ملاهيه لدى تنقله % 5(@)(@@) % ومن عجيب الأمر بل من معضله % % مخول يصغي إلى مخوله % % 6(@)(@@) % يوهم بالصبر على تدلله % إن به داهية في أسفله % % 7(@)(@@) % ماذاك من أمر الفتى بأجمله % % ولا بأسناه لدى تأمله % % PageV01P3635 البحر : - 1(@)(@@) % قذفك بالفحشاء من لم يكن % يعرف بالفحشاء تضليل % 2(@)(@@) % بل سوءة غابت فأحضرتها % % جهلا وغرتك الأباطيل % 3(@)(@@) % وأنت لا شك أخو ريبة % بادر أن يبدره القيل % 4(@)(@@) % ينحل مافيه ليخفى له % % وقل ما تغني التعاليل % % 5(@)(@@) % هيهات لن يرجع ماقد مضى % % قد سبقت فيك الأقاويل % 6(@)(@@) % إن التي تبغي مواراتها % % كأنها في الليل قنديل % 7(@)(@@) % صاح بما جمجمت من سوءة % ذكر وتوراة وإنجيل % 8(@)(@@) % وليس تأويل أخي شبهة % لكنه نص وتنزيل % PageV01P3636 البحر : - 1(@)(@@) % أحمل الوزر والأمانة والدي % % ن جميعا وكل ثقل ثقيل % 2(@)(@@) % غيركم يا بني ثوابة يامن % ليس شيء لبغضهم بعديل % 3(@)(@@) % لو تسمون بالذي تستحقو % % ن خصصتم بأحرف التثقيل % 4(@)(@@) % شهد الله أنكم كل شيء % % بارد جامد ثقيل وبيل % PageV01P3637 البحر : - 1(@)(@@) % يحجبني عمرو وقد عاش حقبة % حبيبته خف ومركبه نعل % PageV01P3638 البحر : - 1(@)(@@) % تلون أخلاق الفتى من ملاله % ووشك ملال المرء 
ms922	 شر خلاله % 2(@)(@@) % وإني لمشتاق إلى ظل صاحب % مشوق إلى تشبيه حالي بحاله % 3(@)(@@) % إذا الدهر أعطاني رأى مثل رأيه % فباراه جودا واقتدى بفعاله % % 4(@)(@@) % وإن ضن دهر مرة بعطية % تناولني في ضيقتي بنواله % % 5(@)(@@) % إلى أن يسد الله فقري فلا يرى % % صديقي في حالي مسدا لماله % 6(@)(@@) % وأكره للسمح اليدين اعتلاله % على صاحب قد عده من عياله % 7(@)(@@) % أمستكثر لي أن منحت منيحة % أخ لا أرى الدنيا تفي بقباله % % 8(@)(@@) % حمى جانبا قد كان أرعاه مرة % لأن سحابا بلني ببلاله % % 9(@)(@@) % وقد كان أحجى أن يباري في الندى % % فيسقيني من مرويات سجاله % 10(@)(@@) % ومن ضن أن أعطى سواه كمن رأى % % جمال أخيه كافيا من جماله % PageV01P3639 11(@)(@@) % وما ترك علق منفس كاقتنائه % % ولا رفض فعل صالح كامتثاله % % 12(@)(@@) % أبى لأبي سهل سوى الطول أنه % % يلاقي اعتلال المال دون اعتلاله % 13(@)(@@) % سيعطفه أني محق وأنه % % حكيم وأن العدل من حال باله % 14(@)(@@) % وما مثل إسماعيل جار قضاؤه % % وعدل الفتى في حكمه كاعتداله % PageV01P3640 البحر : - 1(@)(@@) % أيها السيد الذي اختاره السي % يد إلفا وموضعا للخلال % 2(@)(@@) % لم يوفقك للموفق إلا ص % % دق ذاك التوفيق والإقبال % 3(@)(@@) % جمع الله فيك للناصر الد % % ين خصالا حميدة في الخصال % 4(@)(@@) % فيك للناظرين والقلب حظ % ظان على رغم حاسد مغتال % 5(@)(@@) % منظر معجب من الحسن حال % تحته مخبر من الفضل حالي % % 6(@)(@@) % وإذا ما الجليس حلي هاتي % % ن أبى أن يباع بالأبدال % 7(@)(@@) % أنت مرأى ومسمع كل مافي % % ك مسل لهم ذي الهم جالي % % 8(@)(@@) % فيك جد لمن أجد وهزل % لا كهزل المهازل البطال % 9(@)(@@) % شهد الله والأمير جميعا % والوزير الخبير بالأحوال % % 10(@)(@@) % أنك الصاحب الخفيف على القل % % ب وإن كنت راجح المثقال % % PageV01P3641 11(@)(@@) % لست في ناظر قذاه ولا أن % % ت على خاطر من الأثقال % % 12(@)(@@) % يصطفيك الأمير للأنس والعو % ن على الحادث العياء العضال % 13(@)(@@) % وحقيق كلاكما بأخيه % % شكل أهل الكمال أهل الكمال % 14(@)(@@) % فليالي أميرنا بك في الطي % % ب كأسحارها ذوات الظلال % % 15(@)(@@) % ولأيام دهره 
ms923	 بك روح % مثل روح الغدو والآصال % 16(@)(@@) % ليس فيهن وقدة تلفح الأو % % جه بل كلهن من أظلال % 17(@)(@@) % لم يعبهن عند ذي الجهل إلا % أن ساعاتهن غير طوال % 18(@)(@@) % إن أراد الحديث منك تنكب % % ت سبيل الإخباث والإقلال % 19(@)(@@) % وتحدثت مكثرا ومطيبا % بأحاديث جمة الأشكال % 20(@)(@@) % من طراز الملوك فيها الفكاها % % ت وفيها سوائر الأمثال % PageV01P3642 21(@)(@@) % يجتلبن النشاط من أبعد البع % % د ويدفعن في نحور الملال % 22(@)(@@) % كنسيم الرياض في غلس الليل % % إذا ساقه نسيم الشمال % % 23(@)(@@) % ثم تأتيه بالحديث فتأتي % % برحاه على سواء الثفال % 24(@)(@@) % ذا مقال موافق لمقام % ومقام موافق لمقال % % 25(@)(@@) % عن لسان أرق حدا من السي % % ف دليل على طباع زلال % % 26(@)(@@) % حامل نغمة يشبهها السم % % ع هديل الحمام فوق الهدال % % 27(@)(@@) % رافدتها إشارة ألبستها % % كل نور وكل رقراق آل % 28(@)(@@) % ببنان كأنهن مدار % وأساريع في دماث الرمال % 29(@)(@@) % فلذك الحديث حسن الملاهي % % وله دونهن فضل الجلال % 30(@)(@@) % فهو شيء تلذه أذن السا % % مع من ذي هدى ومن ذي ضلال % PageV01P3643 31(@)(@@) % كالسماع الذي يحرك للهي % ياب إطرابهم وللبخال % 32(@)(@@) % فيهشون عند ذلك للجو % % د على القانعين والسؤال % 33(@)(@@) % ويراحون للقتال لدى الحر % % ب ويغشون هائل الأهوال % 34(@)(@@) % ذاك أغرى بك الأمير فأصبح % % ت بيمنى يديه دون الشمال % 35(@)(@@) % وله فيك آلتان لحرب % ولكيد كهمة المؤتال % % 36(@)(@@) % قفل سر أخوه مفتاح رأي % % والمفاتيح إخوة الأقفال % 37(@)(@@) % لك إطراقة إذا ناب خطب % هي أدهى من سورة الأبطال % 38(@)(@@) % يستثير المكايد الصمع منها % % أي صل هناكف العرزال % 39(@)(@@) % أبصر الفرصة الأمير لعمري % % فيك وهو المسدد الأفعال % 40(@)(@@) % وتجلى بعين صقر أبو الصق % % ر على رأس مرقب متعالي % % PageV01P3644 41(@)(@@) % فرأى فيك ما رأى مجتبيه % فاجتبي منك حظه غير آل % 42(@)(@@) % فالتقى فيك حسن رأي أمير % ووزير كلاهما خير والي % % 43(@)(@@) % فإذا ماذكرت بالغيب قالا % ذاك حقا يتيمة اللئال % 44(@)(@@) % يا ثمال المؤملين أبا إس % % حاق عند انقطاع كل ثمال % 45(@)(@@) % أنت ذاك الذي عهدتك قدما % لايغاليك في المعالي معالي % % 46 
ms924	(@)(@@) % لو تجاريك في مكارمك الري % % ح لخيلت معقولة بعقال % 47(@)(@@) % رب ذي حاجة أرقت لها لي % % لا طويلا وبات ناعم بال % 48(@)(@@) % نام عما عناه منها وما نم % ت ولو نمت بات في بلبال % 49(@)(@@) % فلأكن بعض من غرسته بين فض % % ل شكريك يا أخا الإفضال % 50(@)(@@) % سيرى كل شاكر لك عرفا % أنني سابق له وهو تال % PageV01P3645 51(@)(@@) % لم أكلفك أن تكون شفيعا % لي إلا إلى امرىء مفضال % 52(@)(@@) % أبلج الوجه كالهلال بل البد % % ر بل الشمس بل فقيد المثال % 53(@)(@@) % لايضاهيه في المحاسن إلا ما % % تسديه كفه من فعال % 54(@)(@@) % أريحي يعطي العطية في العط % % لة أضعاف أختها وهو وال % 55(@)(@@) % محسن مجمل وليس ببدع % ذاك من مثله ولا بمجال % 56(@)(@@) % ذانك الحسن والجمال حقيقا % ن بكنه الإحسان والإجمال % 57(@)(@@) % أحسن الله خلقه فبداه % % في انتساخ لحسنه وامتثال % 58(@)(@@) % يستملان فعله من كتاب % خط في وجهه بلا استملال % 59(@)(@@) % ليس ممن إذا ألح شفيع % أخلق الوجه عنده بابتذال % 60(@)(@@) % من رجال توقلوا في المعالي % % بالمساعي توقل الأوعال % PageV01P3646 61(@)(@@) % بل ترقى إلى العلا طالبوها % % وتدلى على العلا من معالي % % 62(@)(@@) % يتبارى إليه وفدان شتى % % وفد شكر يحث وفد سؤال % 63(@)(@@) % بل عطاياه لاتزال تبارى % % وافدات إلى ذوي الآمال % 64(@)(@@) % بالغات إلى المقصر عنها % % نائلات بعيد كل منال % 65(@)(@@) % يرقد الطالبون وهي إليهم % % أرقات الوجيف والإرقال % % 66(@)(@@) % رحلت نحو من تثاقل عنها % % وكفته مؤونة الترحال % % 67(@)(@@) % لا تزل عنه نعمة لو أزيلت % % لم تجد عنه وجهة للزوال % % 68(@)(@@) % فالق في حاجتي أخاك أبا الصق % % ر مجدا مشمر الأذيال % 69(@)(@@) % فهو مستعذب لقاءك إي % ياه يراه كالبارد السلسال % 70(@)(@@) % متصد لحاجة لك قد أش % % فى جداه على شفا منهال % % PageV01P3647 71(@)(@@) % ومتى ما لقيته كان غيثا % أمرته الجنوب بالتهطال % 72(@)(@@) % ليس من كنت ريحه ببعيد % من سماء تبله ببلال % 73(@)(@@) % وامرؤ يستقي بجاهك أه % % ل بسجال روية وسجال % 74(@)(@@) % لك وجه مشفع من رآه % % زاح عنه هناك كل اعتلال % 75(@)(@@) % ينزل القطر من 
ms925	 ذرى المزن في ال % % محل على كل جردة ممحال % 76(@)(@@) % ليس ينفك للشفاعة مبذو % % لا وما إن يزاد غير صقال % 77(@)(@@) % وكذاك الكريم سئال حاجا % % ت سواه وليس بالسئال % 78(@)(@@) % صنت نفسا أذلت في العرف منها % % لا عدمناك من مصون مذال % 79(@)(@@) % كم منيع الجدا شفعت إليه % % لخليل رأيته ذا اختلال % 80(@)(@@) % جاد إذ صافحت يداك يديه % % ورأى وجهك العظيم الجلال % PageV01P3648 81(@)(@@) % ففككت البخيل من غل بخل % وفككت الخليل من سوء حال % 82(@)(@@) % فإذا أنت قد فككت أسير % % ين وقدما فككت من أغلال % 83(@)(@@) % ومنحت الذميم منحة حمد % ومنحت العديم منحة مال % 84(@)(@@) % فإذا أنت قد أنلت نوالي % % ين وقدما أنلت كل نوال % % 85(@)(@@) % قائل المدح فيك بدءا وعودا % غير مستكره ولامحتال % 86(@)(@@) % بل إذا قاله أتته المعاني % % والقوافي تنثال أي انثيال % 87(@)(@@) % فابق مابقيت مآثرك الغر % ر فقد خلدت خلود الجبال % % 88(@)(@@) % أنا من أتبع الولاء الموالا % % ة فلا تنس حق مولى موالي % % PageV01P3649 البحر : - 1(@)(@@) % تجلد عمر وللهجاء تجملا % وما زلت أرعى حرمة المتجمل % 2(@)(@@) % فأقسمت لا أهجوه ماعشت بعدها % % وقد تسفر الحسناء للمتأمل % 3(@)(@@) % ومن عادتي تكذيب ظن محاذري % % كما عادتي تصديق ظن المؤمل % 4(@)(@@) % فقولا لعمرو أنت حر سيابه % % لشيمة حر محسن الحلم مجمل % 5(@)(@@) % فإن هو لم يحفل بنقمي ونعمتي % % فعندي له عود المتم المكمل % 6(@)(@@) % هجاء إذا ما استافه قبل ذوقه % رأى فيه شوبا من ذعاف المثمل % 7(@)(@@) % ولست أراه لا يبالي وإن بدا % % تضرمه في ظاهر متعمل % 8(@)(@@) % رأيت بعينيه الكذوبين مايرى % % متى حلت كياتي له لم يململ % % PageV01P3650 البحر : - 1(@)(@@) % عدلت عن الصبا صعري وميلي % % وشمرت الخطوب فضول ذيلي % % 2(@)(@@) % وأوضح لي المشيب سبيل رشد % وكنت كخابط عشواء ليل % % PageV01P3651 البحر : - 1(@)(@@) % كسل الأير أو ينشطه أير % وكذا لم تأنس الأشكال % 2(@)(@@) % فهو يعلو طورا ويعلوه طورا % قرنه هكذا البقاع تدال % PageV01P3652 البحر : - 1(@)(@@) % حي المعاهد والمنازل % المقفرات بل الأواهل % 2(@)(@@) % بدلن آراما خوا % % ذل بعد آرام خواذل % 3(@)(@@) % حركن شجوك للسؤا % % ل وما أحرن جواب 
ms926	 سائل % 4(@)(@@) % فابعث بهن من الدمو % % ع وقف بهن من الرواحل % % 5(@)(@@) % وسل الملائح بالملا % % ئح والعطابل بالعطابل % 6(@)(@@) % اللائي أشبهن الغصو % % ن المستقيمات الموائل % 7(@)(@@) % وكملن كل وسامة % في غير أسنان كوامل % 8(@)(@@) % حلين حليا خلقة % مجبولة لانحل ناحل % 9(@)(@@) % فإذا عطلن من الحلي % % ي فلسن منه بالعواطل % % 10(@)(@@) % وإذا غدون يمسن في % % تلك الغلائل والمراسل % PageV01P3653 11(@)(@@) % غارت عليهن الثدي % ي هناك من مس الغلائل % 12(@)(@@) % وإذا لبسن خلاخلا % كذبن أسماء الخلاخل % % 13(@)(@@) % تأبى تخلخلهن أس % وق مرجحنات بخادل % % 14(@)(@@) % لكنهن بخائل % لهفي على تلك البخائل % 15(@)(@@) % قد غلظت تلك القلو % % ب ولطفت تلك الأنامل % 16(@)(@@) % لي شاغل في حبهن % ن عن التي تدعى بشاغل % % 17(@)(@@) % بظراء تمسخ لامها % % راء إذا رأت الفياشل % % 18(@)(@@) % ولربما جنت لها % % فترى عواليها سوافل % % 19(@)(@@) % عجبا لبرد غنائها % % وغناؤها ثكل الثواكل % 20(@)(@@) % ما باله كالزمهري % % ر مهيجا وجع المفاصل % % PageV01P3654 21(@)(@@) % هلا استحر لأنه % % ثكل وللشبق المداخل % 22(@)(@@) % حلقت ذوائبها التي % % خلقت لصناع المناخل % % 23(@)(@@) % بل لحية الرجل الذي % % أضحى بها جم البلابل % % 24(@)(@@) % ماذا يضبع من الوسا % % ئل في هواها والرسائل % % 25(@)(@@) % لكن شهوته اللبا % % ء فما يحب سوى الحوامل % % 26(@)(@@) % وهي التي قد أقسمت % أن لا تعد مع الحوائل % % 27(@)(@@) % أتراك تسلم يا سلا % % مة أن تكون من الثياتل % % 28(@)(@@) % وقد احتملت بها قرو % % نا لا ينوء بهن حامل % 29(@)(@@) % كنت القصير فقد غدو % ت بطولهن من الأطاول % % 30(@)(@@) % لا تخلون بشاغل % حتى تعدلها قوابل % PageV01P3655 31(@)(@@) % إن التي علقتهاقالوا تعاهر في الدورب فقلت كلا بل تعاظل % تزني الفرائض والنوافل % 31(@)(@@) % قالوا تعاهر في الدور % % ب فقلت كلا بل تعاظل % 32(@)(@@) % لكن أراك تحبها % % حب المشاكل للمشاكل % % 33(@)(@@) % أشبهتها في برد أعلا % % ها اوفي حر الأسافل % 34(@)(@@) % كم قد سترت معايبا % لمعت بها فيك المخائل % % 35(@)(@@) % ووقفت دونك للخصو % % م بموقف الخصم المجادل % % 36(@)(@@) % قالوا صديقك سيد % بادي النباهة غير خامل % 37(@)(@@) % نمت بذاك شواهد % فيه أنم من الجلاجل % 38(@)(@@) % ولرب عيب قد 
ms927	 تبي % ين بالشواهد والدلائل % % 39(@)(@@) % صدقوا وماكذبوا علي % ك فلم أناضح أو أناضل % PageV01P3656 40(@)(@@) % إني لأعلم أنك المطعو % % ن في غير المقاتل % 41(@)(@@) % ما إن تزال فريسةوإن استترت بقحبة لك عند ناكتها طوائل بذيء % % في خلوة تحت الكلاكل % 41(@)(@@) % وإن استترت بقحبة % لك عند ناكتها طوائل % % 42(@)(@@) % أنشأت تخدعنا وأم % رك بين بادي الشواكل % % 43(@)(@@) % وعدلت من طبل إلى عو % % د وأنت من الطوابل % 44(@)(@@) % بل ليت كنت من الطوا % % بل بل أنت من سقط الزوامل % % 45(@)(@@) % وخضبت خنثك بالتغز % زل والبغاء هناك ناصل % 46(@)(@@) % مثل التي أضحت تكا % % تم حملها والضرع حافل % % 47(@)(@@) % نتنحل المتعشقا % % ت وأنت بغاء حلاحل % % 48(@)(@@) % أنى يصلنك لا وصل % ن ولو بقين بلا مواصل % % PageV01P3657 49(@)(@@) % أنت الذي فاق الورى % % في القبح من حاف وناعل % 50(@)(@@) % ولقد شهدنك راكبا % فوق الغلاط من الغرامل % % 50(@)(@@) % وأرى غناءك في المجاوتناك غير مساتر للغانيات ولا مخاتلبذيء فعلام يمنحن الهوى غير الجميل ولا المجامل ولقد شهدنك راكبا فوق الغلاط من الغرامل تبغى بها تقويم أيرك وهو كالسكران مائل فبصرن فيك بفارس يغشى الحروب ولا يقاتل % لس مثل ذكرك في المحافل % 50(@)(@@) % وتناك غير مساتر % للغانيات ولا مخاتل % 50(@)(@@) % تبغى بها تقويم أي % رك وهو كالسكران مائل % % 50(@)(@@) % فبصرن فيك بفارس % يغشى الحروب ولا يقاتل % 50(@)(@@) % فعلام يمنحن الهوى % % غير الجميل ولا المجامل % % 51(@)(@@) % وأراك فيه ناهقا % وتظن أنك فيه صاهل % 52(@)(@@) % وتراك فيه فارسا % والحق أنك فيه راجل % 53(@)(@@) % وتراك فيه عاليا % والحق أنك فيه سافل % PageV01P3658 54(@)(@@) % وأراك تعمل صالحا % تعتد فيه أضل عامل % 55(@)(@@) % أكفلت نغلي شيخة % ولدتهما من غير طائل % 56(@)(@@) % ولدتهما من غير شي % % خك ذي الفضائل والفواضل % 57(@)(@@) % وكذا الكريم ابن الكرا % % م يعول أيتام القبائل % % 58(@)(@@) % اذهب فإنك بعدها % % كهف اليتامى والأرامل % 59(@)(@@) % أقسمت أنك جاهل % والممتري في ذاك جاهل % % 60(@)(@@) % أتعول ويحك إخوة % لا من أبيك وأنت غافل % % 61(@)(@@) % ويريبني كل الإرا % % بة منك تأنيث الشمائل % % 62(@)(@@) % قد كان شيخك باسلا % بطلا فمالك 
ms928	 غير باسل % % 63(@)(@@) % إني لأحسب أن أم % مك لبست حقا بباطل % % PageV01P3659 64(@)(@@) % واغتالت الشيخ الشقي % ي فقيرته وهو غافل % % 65(@)(@@) % خذها إليك تحية % تلقى المعاطس بالجنادل % % 66(@)(@@) % يامعشر السفهاء وال % % متمردين ذوي المجاهل % 67(@)(@@) % الموت يغشاها وخاطر قلبها % % ذكر الأيور كأنها لم تشغل % % 67(@)(@@) % لو أمهلتك مدى ثوائك في استها % % لسلمت لكن داؤها لم يمهل % 67(@)(@@) % وراتك ايسر مهلكا ورزية % % من دعستين بأير عير أغرل % 67(@)(@@) % فاعصب ملامة ناظريك برأسها % % لا بالإله وبالنبي المرسل % 67(@)(@@) % ما استوجبا منك الكفور بجرمها % % فدع الهوادة في الحكومة واعدل % 67(@)(@@) % سقيا لأمك من صديد جهنم % % لا من صبيب البارق المتهلل % 67(@)(@@) % لمضت من الدنيا وما أسفت على % % مستمتع من مشرب أو مأكل % PageV01P3660 67(@)(@@) % إلا مباضعة العبيد فإنها % % عنها وعن خطراتها لم تذهل % % 67(@)(@@) % واستخلفتك وما نسلت مكانها % % فابذل لناكتها عجانك وابذل % 67(@)(@@) % ولقد حبوتهم بفاعلة التي % % ذاعت لها مدح الجواد المفضل % 67(@)(@@) % أزناة باب الشام طرا أبشروا % % من بنت شاعركم بخير مقبل % 67(@)(@@) % خلفت عليكم أمه وتكفلت % % بكم وعدة عشرها لم تكمل % 67(@)(@@) % أأبي يوسف دعوة من حاقر % مستصغر يأبى دعاءك من عل % 67(@)(@@) % خذها إليك تذود غاشية الكرى % % عن أهلها وتضيق رحب المنزل % 67(@)(@@) % لا تسخطن على الإله فإنما % % أعمال طعن فحولها بالفيشل % % 67(@)(@@) % ولقد وزعت الشعر عنك تعظما % وتنزها وكففت غرب المقول % 67(@)(@@) % وأنا المقابل في أكاسر فارس % وابن الملوك الصيد غير تنحل % % PageV01P3661 67(@)(@@) % وتخيلك الماء النقاح كأنه % % في فيك مازجه نقيع الحنظل % 67(@)(@@) % رفعوا يفاعي كابرا عن كابر % حتى استقل إلى السماك الأعزل % % 67(@)(@@) % أنذرتكم قبل الخسو % % ف بما ترون من الزلازل % 67(@)(@@) % أسألت رسم الدار أم لم تسأل % % دمنا عفت فكأنها لم أتحلل % 67(@)(@@) % درسا براهن البلى بري الضنا % % جسمي لبين قطينها المتحمل % 67(@)(@@) % فلو استطاعت إذ بكيت دثورها % % لبكت نحولي بالدموع الهمل % 67(@)(@@) % ولقد عهدت عراصها مأنوسة % أيام تعهدني كسيف الصيقل % % 67(@)(@@) % رود الشبيبة لا أعاصي لذة % تدعو هواي ولا أدين لعذلي % % 67(@)(@@) % وإذا أشاء غدوت غير منهنه % فأروح 
ms929	 مقتنص الغزال المطفل % % 67(@)(@@) % في حيث يقصر باع كل مساور % دوني ويحسر ناظر المتأمل % % PageV01P3662 67(@)(@@) % فأبت جوامح للقريض غوالب % جاش الضمير بهن جيش المرجل % 67(@)(@@) % حرى تسكن نعظ ألف حزور % شبق وغلة دائها لم تبلل % % 67(@)(@@) % فضلا له بك يا ابن طاحنة الرحى % % رومي وبيتك بالحضيض الأسفل % % 67(@)(@@) % يا بن السفاح شهادة مقبولة % مثل الشهادة بالكتاب المنزل % 67(@)(@@) % إن التي ولدتك تخبر أنها % % حملتك من نطف لعدة أفحل % % 67(@)(@@) % بظراء لو نطحت بمقدم بظرها % % ثهلان حلحله ولم يتحلحل % 67(@)(@@) % بخراء لو نكهت على صم الصفا % % صدعت بنكهتها متون الجندل % % 67(@)(@@) % ذفراء لو بلت برشح أديمها % % جسد امريء لم ينق منه بجدول % 67(@)(@@) % خضراء لون الريق لو نفثت به % % ميثاء ألقحها الحيا لم تبقل % % 67(@)(@@) % بؤسي الزمان وليس يبرح آخر % من صرفه يعفو محاسن أول % % PageV01P3663 البحر : - 1(@)(@@) % ليس الكريم من اشترى بنواله % حمد الرجال وإن أنال جزيلا % % 2(@)(@@) % واتخذ حشوة واعف جعرا % % ك من الطعن بالأيور قليلا % % 2(@)(@@) % لا تلمهم فإن لومك لا ين % % فع وآرفق باكلك الطفشيلا % % 2(@)(@@) % وتغضبت من كلام أناس % أكثروا إذ ضرطت قالا وقيلا % % 2(@)(@@) % خفيف لمت يا وهب اهل دهرك فيما % % أنت أوجدتهم إليه السبيلا % % 2(@)(@@) % يا ليت شعري عن وهب وفقحته % وكيف عاتبها في الحش حين خلا % % 2(@)(@@) % بئس التحية حياها الوزير ضحى % % والحفل من سروات القوم قد حفلا % % 2(@)(@@) % ثم استمرت فصارت في البلاد له % % كأنها ارسلت من دبره مثلا % % 2(@)(@@) % حيا أبو حسن وهب أبا حسن % بضراطة طيرت عثنونه خصلا % % 2(@)(@@) % لكنه من جاد جود طبيعة بسيطحيا أبو حسن وهب أبا حسن بضراطة طيرت عثنونه خصلا بذيءثم استمرت فصارت في البلاد لهكأنها ارسلت من دبره مثلابذيءبئس التحية حياها الوزير ضحى والحفل من سروات القوم قد حفلا يا ليت شعري عن وهب وفقحتهوكيف عاتبها % % ورأى الفعال من الفعال جميلا % % PageV01P3664 البحر : - 1(@)(@@) % أبوه بلبل ضاو ويكنى % % أبا صقر فكنيته محاله % 2(@)(@@) % يجود بعرضه للشتم عفوا % ويبخل بالقلامة والخلاله % 3(@)(@@) % وللأوغاد أموال تراها % % مصونات بأعراض مذاله 
ms930	 % % 4(@)(@@) % ولم يك من نماه أب كريم % ليبذل عرضه ويصون ماله % % 5(@)(@@) % تمحل نسبة أعيت أباه % % وكان المرء يعجز لا المحاله % % PageV01P3665 البحر : - 1(@)(@@) % إذا شاخ قوم شيبوا وابن بلبل % تشيبن لما شاخ بالتنحل % 2(@)(@@) % ولا جور إلا جوره في اكتنائه % % أبا الصقر أنى ذاك وهو ابن بلبل % PageV01P3666 البحر : - 1(@)(@@) % قل لابن بلبل لم غلطت % وأنت شهم قلقل % 2(@)(@@) % أنى يكون أبا الصق % % ر من أبوه بلبل % 3(@)(@@) % نسب يناقض كنية % ما مثل ذا بك يجمل % % 4(@)(@@) % أغفلت عما فيهما % % ما عذر مثلك يقبل % PageV01P3667 البحر : - 1(@)(@@) % شهر الصيام مبارك لكنما % % جعلت لنا بركاته في طوله % 2(@)(@@) % سافر بفكرك منه في نأي المدى % % ممدوده ممطوله موصوله % 3(@)(@@) % من كان يألفه فكيف خروجه % عني بجدع الأنف قبل دخوله % 4(@)(@@) % إني ليعجبني تمام هلاله % وأسر بعد تمامه بنحوله % 5(@)(@@) % شهر يصد المرء عن مشروبه % مما يحل له ومن مأكوله % 6(@)(@@) % لا أستثيب على قبول صيامه % حسبي تصرمه ثواب قبوله % PageV01P3668 البحر : - 1(@)(@@) % سؤلي أن توقن أني امرؤ % قد امحي من صدره الغل % 2(@)(@@) % كيلا ترى أني مستأهل % يوما عصيبا ماله ظل % 3(@)(@@) % وأنت في حل وإن نالني % % منك الذي لا يسع الحل % 4(@)(@@) % لا يغضب العبد على ربه % ويغضب الصاحب الخل % 5(@)(@@) % ولست بالصارف عنك الهوى % % والرأي أنت الدق والجل % 6(@)(@@) % والإل والذمة قد أكدا % % فلترقب الذمة والإل % % 7(@)(@@) % قد كان برسام وبحرانه % % فلا يكن بعدهما سل % PageV01P3669 البحر : - 1(@)(@@) % دع لباك رسومه وطلوله % ولحاد ركابه وحموله % 2(@)(@@) % ولغاو سفاهه وصباه % وللاه سماعه وشموله % 3(@)(@@) % وإذا ما صمدت للشعر يوما % فتيمم فصوله لا فضوله % % 4(@)(@@) % إنما أحمد المحمد شخص % من سماح ونجدة مجبوله % 5(@)(@@) % فارس المجد لم يزل غير نكر % يركب المجد صعبه وذلوله % % 6(@)(@@) % فلسؤاله إذا ما استماحو % % ه عطاء سيوبه المبذوله % % 7(@)(@@) % ولأعدائه إذا ما أرادو % % ه بكبد سيوفه المسلوله % % 8(@)(@@) % شغل المجد قلبه ويدي % % ه والقوافي بمدحه مشغوله % % 9(@)(@@) % سهلته ووعرته سجايا % % خالطتها وعورة وسهوله % % 10(@)(@@) % لم نجدها مذمومة قط في النا % % س 
ms931	 ولكن محمودة معذوله % % PageV01P3670 11(@)(@@) % لم يزل غرة يتيه بها الده % % ر إذا ما الكرام كانوا حجوله % % 12(@)(@@) % أيها السيد الذي ليس تنفك % ك أياديه عندنا موصوله % % 13(@)(@@) % فهي معروفة لدينا وإن كا % % نت لديه مجحودة مجهوله % % 14(@)(@@) % نعم في الوجوه يقرها النا % % س جميعا منقوطة مشكوله % % 15(@)(@@) % شهد الله والملائكة الأبرا % % ر طرا شهادة مقبوله % % 16(@)(@@) % أنك الحاكم الذي أوتي الحك % % م به حكمه فأعطي سوله % % 17(@)(@@) % وأصابت آراؤه مفصل الحق % ق فكم خطة به مفصوله % 18(@)(@@) % لبست تاج فخرها بك بغدا % % د وأثواب زينها المصقوله % % 19(@)(@@) % ثبت الله دولة لك أضحت % % كل بلوى بعدلها معدوله % % 20(@)(@@) % فالرعايا محمية في حماها % % والمراعي مطلولة موبوله % % PageV01P3671 21(@)(@@) % ما تزال الدماء مضمونة في % % ها وأرزاق أهلها مكفوله % % 22(@)(@@) % عاقني أن أطيل أنك تستغ % % رق عرض الثناء مجدا وطوله % % 23(@)(@@) % وارتياعي في كل يوم من الإز % % عاج عن منزل أحب نزوله % % 24(@)(@@) % فيه عافاني الإله من الشك % % و وفك البلاء عني كبوله % % 25(@)(@@) % بعد جهد حملت منه ضروبا % ليس أثقالهن بالمحموله % % 26(@)(@@) % ومصاب بشقة الروح مني % % ضمن الجسم سقمه ونحوله % % 27(@)(@@) % بأخي بل بوالدي بل بنفسي % % ليت نفسي من قبله مثكوله % % 28(@)(@@) % رابني صائني ظهيري وزيري % % غالني الدهر فيه لقي غوله % % 29(@)(@@) % لم أرثه سوى شجاة أرتني % % عسكر الموت رجله وخيوله % % 30(@)(@@) % وإليك الشكاة منها ومن أش % % ياء تبتز ذا الحجى معقوله % % PageV01P3672 31(@)(@@) % بعضها أن عزمة منك أقذت % مقلتي فهي بالقذى مكحوله % % 32(@)(@@) % لا تذوق المنام إلا غرارا % حسرتي فيه غير ما معسوله % % 33(@)(@@) % كل يوم تزورني منك روعا % % ت على مأمن الحشا مدلوله % % 34(@)(@@) % أنا بالله عائذ وبحقوي % % ك وآلاء كفك المسئولة % % 35(@)(@@) % لاتردنني إلى ظلم الكر % % خ وأخلاق أهله المرذوله % % 36(@)(@@) % سيما في حريم شهرك ذي الحر % % مة غير المذالة المخذوله % 37(@)(@@) % حرم الله حرم الله ذو العر % % ش على الظلم والعداء دخوله % % 38(@)(@@) % وحقيق برعيه من غدا في % % ه ومافيه خلة مفضوله % % 39(@)(@@) % ولعمري لأنت ذاك وما أن % % شر عنك المحاسن 
ms932	 المنحوله % % 40(@)(@@) % لم تزل من فعالك البدأة % الحر يشرى بعودة مأموله % % PageV01P3673 41(@)(@@) % فاحتسب فيه ترك إزعاج مثلي % % بعض أعمال برك المعموله % % 42(@)(@@) % يا بن أنصار دولة الحق بالني % % ية ذات الصفاء لا المدخوله % % 43(@)(@@) % والذي برزوا سماحا وبأسا % فأحاديث مجدهم منقوله % % 44(@)(@@) % لاتطل الدماء إن طلبوها % % وعطايا أكفهم مطلوله % % 45(@)(@@) % ليس فيهم مطالب الناس % بالشكر ولافيهم المسمى قبوله % % 46(@)(@@) % لاتكن عارضا رجوت حياه % فغدا مرسلا علي سيوله % % 47(@)(@@) % بينما النفس في بهائك ترجو % % ملك دار معمورة مأهوله % % 48(@)(@@) % وتراعى آمالها منك نجا % % ز مواعيد للمنى ممطوله % % 49(@)(@@) % إذ يتاني الرسول منك بأمر % يشبه الموت نفسه أو رسوله % % 50(@)(@@) % وهو إزعاجها بأعنف عنف % عن محل قد استطابت حلوله % % PageV01P3674 51(@)(@@) % ويح نفسي وما لراجيك ويح % أتراها بسيفها مقتوله % % 52(@)(@@) % حاش لله إنها لتريني % % بك إشراق نجمها لا أفوله % % 53(@)(@@) % ليس من عادة الأمير المرجى % % أن يغول امرءا رجا أن يعوله % % 54(@)(@@) % أنا إن لم تذد يميناك عني % % غير شك فريسة مأكوله % % 55(@)(@@) % فليصل كفي الأمير بحبل % عاصم من حباله المجدوله % 56(@)(@@) % كم وكم قدرت بدفعك عنها % % رد أظفار دهرها مغلوله % % 57(@)(@@) % كم وكم قدرت بسعيك فيما % % ترتجيه من الأمور حصوله % % PageV01P3675 البحر : - 1(@)(@@) % لازلت تفخم والثناء ضئيل % ويعز عرضك والثراء ذليل % 2(@)(@@) % حملتني ما لا أطيق وإنما % % شأن الكريم الحمل لا التحميل % 3(@)(@@) % كلفتني ماتستحق وبعضه % % ثقل على المتكلفين ثقيل % 4(@)(@@) % إن كنت تطلب في المديح مشاكلا % لك في الرجال فما إليه سبيل % 5(@)(@@) % أترى عديلك في المديح مواتيا % هيهات مالك في الأمور عديل % 6(@)(@@) % اعجزت وعيشك عن حقوقك طاقتي % % أأطيقها وحدي وأنت قبيل % 7(@)(@@) % بل موسم بل أمة بل عالم % بل عالمون وكل ذا فقليل % 8(@)(@@) % وكذاك معروف الكرام كفاية % أبدا وأكثر مدحهم تعليل % 9(@)(@@) % يأتي القليل من الضئيل بحقه % كيما يكون من الجزيل جزيل % 10(@)(@@) % ويد البخيل لما استفاد قرارة % ويد الجواد لما استفاد مسيل % PageV01P3676 11(@)(@@) % هل أنت مستمع فأنطق بالتي % % يشفى بها من ذي الغليل غليل % 12(@)(@@) % فلكم نطقت من 
ms933	 الصواب بخطبة % فيها البيان إذا أحال محيل % 13(@)(@@) % إن العيوب مع التتبع جمة % وكثيرهن إذا اغتفرت قليل % % 14(@)(@@) % فاجعل تصفحك المديح تفرسا % في غيب ما تسدي غدا وتنيل % 15(@)(@@) % فلذاك أجدر أن يعانيه الفتى % % ولذاك أخلق أن يقال نبيل % 16(@)(@@) % دع مادحيك يقصرون ولاتكن % ممن يقال مقصر وبخيل % 17(@)(@@) % إني أعيذك أن يقولوا كاتب % ألف الحساب فشأنه التحصيل % % 18(@)(@@) % وأجل منها أن يقولوا ماجد % ألف السماح فشأنه التسهيل % % 19(@)(@@) % والبس جمالك عند كل قبيحة % إن التجمل بالرجال جميل % 20(@)(@@) % ماذا يضر فتى جليلا قدره % من أن يدق المدح وهو جليل % PageV01P3677 21(@)(@@) % وأحق زوج أن ينتج شكله % % حسناء تذكر عاثر ومقيل % 22(@)(@@) % وإذا نظرت فإن أخلق منهما % % لنتاج مجد جاحد ومنيل % % 23(@)(@@) % أفيغفر الكفران وهو كبيرة % ويؤاخذ التشبيه والتمثيل % 24(@)(@@) % فعلام أعذل في امتثال مقالة % قد قالها جيل سواي وجيل % 25(@)(@@) % ضرب الركام لكل تهمة متهم % مثلا وشاع بذاك قبلي قيل % 26(@)(@@) % أفضل وأغض جفون عينك رأفة % بذوي العيوب يجب لك التفضيل % 27(@)(@@) % ولقد تصيب بديل كل مبرز % من مادحيك وليس منك بديل % 28(@)(@@) % كم قال جودك للمنهنه بدأة % هيهات ليس لسنتي تبديل % 29(@)(@@) % وكذا يقول لمن ينهنه عوده % % هيهات ليس لنعمتي تحويل % 30(@)(@@) % ولراحتيك بدأة وعوادة % وليوم عرفك بكرة وأصيل % PageV01P3678 31(@)(@@) % يامن يطالب نفسه بحقوقنا % % مثل الغريم فرفده تعجيل % 32(@)(@@) % وينام عنا حين نلوي شكره % فعل الكريم فكشره تأجيل % 33(@)(@@) % يامن إذا حركته لكريمة % ألفيته والجول منه مهيل % 34(@)(@@) % حتى إذا نبهته لعظيمة % ألفيته والرأي منه أصيل % 35(@)(@@) % آمال نفسي فيك غير مطامع % لكنهن مزارع ونخيل % 36(@)(@@) % أجملت من وصفي خلالك جملة % وعلى التجارب بعدها التفصيل % 37(@)(@@) % فليختبرك السائلون فإنهم % % إن جربوك أتاهم التأويل % 38(@)(@@) % ليفسرن لهم فعالك أنه % % أبدا بصدق المادحيك كفيل % 39(@)(@@) % لازلت مرغوبا إليك ميمما % مثل الصباح عليك منك دليل % 40(@)(@@) % وإذا تأملك المعاشر أملوا % % ولمن تأمل ماجدا تأميل % PageV01P3679 41(@)(@@) % ما وجه التأميل نحوك آمل % إلا التقى التأميل والتمويل % 42(@)(@@) % شهدت بخير غرة وضاحة % من حقها التعظيم 
ms934	 والتبجيل % 43(@)(@@) % ووفت بموعدها يد نفاحة % من حقها الإفضال والتقبيل % 44(@)(@@) % ترجو سواك لدى التفكه بالمنى % % لكن عليك يحصحص التعويل % 45(@)(@@) % لازال تعويل عليك مصدقا % وعلى عداك وحاسديك عويل % PageV01P3680 البحر : - 1(@)(@@) % قني يا إلهي شح نفسي فإنني % % أرى الجود لي حظا وشيمتي البخل % 2(@)(@@) % وما ذاك أني لاأجود بنائل % % ولكن لي ما لا يحصنه قفل % 3(@)(@@) % وقد كان حق الجود بذلي ذخائري % % إلى أن يراني الله يعوزني الأكل % 4(@)(@@) % ولكن نفسي آثرت نبل مالها % % وماحيث نبل المال مايوجد النبل % PageV01P3681 البحر : - 1(@)(@@) % يامن يعيب لدينا الراح مجتهدا % أسأت قولا وقد أحسنت في العمل % % 2(@)(@@) % تركتها مؤثرا للأكرمين بها % % وعبتها عيب ذي جهل وذي خطل % 3(@)(@@) % فبؤ بحمد وذم وتستحقهما % % كما خلطت الذي أسديت بالعذل % % 4(@)(@@) % ماكنت إلا كساق خاض مجدحه % % شوبا من الصاب في شرب من العسل % PageV01P3682 البحر : - 1(@)(@@) % خانك الصبر يوم قيل الرحيل % إن خطب الفراق خطب جليل % 2(@)(@@) % وتزودت من سليماك زادا % فيه للطالب الشفاء غليل % 3(@)(@@) % نظرت حضرة الوداع بعين % غسلتها الدموع وهي كحيل % 4(@)(@@) % يحدر الماء من محاجر عيني % % ها على خدها مسيل أسيل % PageV01P3683 البحر : - 1(@)(@@) % إذا ما أخو الخمسين أمل مثلها % % فيا ويحه إن خاب أو أدرك الأمل % 2(@)(@@) % هو الموت أو نيل التي في منالها % % ذهاب الشباب الغض واللهو والغزل % PageV01P3684 البحر : - 1(@)(@@) % لازلت تبلغ أقصى السؤل والأمل % ممتع النفس بالسراء والجذل % 2(@)(@@) % ولاعدمت نماء لاانتهاء له % % في الحال والمال والأحباب والخول % 3(@)(@@) % يامن تزينت الدنيا بدولته % % فأصبحت وهي في حلي وفي حلل % % 4(@)(@@) % أوراد بحركم مثلي ومنصرف % في الصادرين بلا عل ولانهل % 5(@)(@@) % ألست أصلح سمسارا لبركم % ولاوكيلا ولاعونا على عمل % 6(@)(@@) % بلى وإن كان راعي الناس أهملني % % فليس حقي إهمالي مع الهمل % 7(@)(@@) % أني لأخوض للأهوال من أسد % عاد وأنهض بالأثقال من جمل % 8(@)(@@) % مازلت أنهض في الجلى أحملها % % بنجدة وبرأي غير ذي خلل % % 9(@)(@@) % عندي إذا غرر الكافون أو عجزوا % % حزم الجبان تليه جرأة البطل % 10(@)(@@) % ولست كالمرء يؤتى عند عزمته % % من التهور 
ms935	 يوما لا ولا الفشل % PageV01P3685 11(@)(@@) % إني بما شئت من إتقان ذي خلل % كل الوفاء ومن تقويم ذي ميل % 12(@)(@@) % وإن نفثت إلي السر مؤتمنا % لم أفش سرك عن عمد ولازلل % 13(@)(@@) % فهب لراجيك إذنا منك تلق به % % مؤدبا غير ذي جهل ولاخطل % 14(@)(@@) % لايسأل الحاجة المعوج مسلكها % % ولايحاول أمرا بين الحول % 15(@)(@@) % بل كل مايوجب الإنصاف منك له % % مع الوسائل والأسباب والوصل % % 16(@)(@@) % من ارتجاع عقار لج غاصبه % % ورد دين له في الظلم معتقل % % 17(@)(@@) % وشعبة من معاش لاتكلفه % % مر السؤال ولامستثقل الرحل % 18(@)(@@) % وكل ذاك خفيف إن نشطت له % % يامن يخف عليه كل ذي ثقل % 19(@)(@@) % أقول إذ غصبتني كف جارية % % الله أكبر من ود ومن هبل % % 20(@)(@@) % فاز الغواني بما أملن من أمل % فما يبالين ما لاقين من أجل % PageV01P3686 21(@)(@@) % متى غلبن رجال الجد في زمن % كما غلبن رجال اللهو والغزل % 22(@)(@@) % وإن أعجب شيء أنت مبصره % % في كل ما حملته الأرض من ثقل % 23(@)(@@) % كف خضيب من الحناء غاصبة % كفا خضيبا من الأبطال والعضل % 24(@)(@@) % ياحسرتا لي ويا لهفا ويا عجبا % إن هذه الحال لم تنكر ولم تزل % 25(@)(@@) % في دولتي أنا مغصوب وفي زمني % % عودي ظمىء بلا ري ولا بلل % 26(@)(@@) % أمسي وأصبح مظلوما بلاجنف % من الوزير ومحروما بلا نحل % % 27(@)(@@) % لكن لأمر خفي لا يحيط به % % علمي وإن كنت ذا علم وذا جدل % 28(@)(@@) % وإنني لأرجي أن يصبحني % % سعد السعود بحظ منه مقتبل % % 29(@)(@@) % وما أرجي سماحا منه مطرفا % لكن سماحا تليدا فيه لم يزل % 30(@)(@@) % ومافمي بمفيق من معاتبة % حتى يشافه تلك الكف بالقبل % PageV01P3687 31(@)(@@) % فليأمر السيد الحجاب حضرته % % بصون وجه مصون غير مبتذل % 32(@)(@@) % حتى يلاقيني أجفى جفاتهم % بلا فتور يرى فيه ولا كسل % 33(@)(@@) % وليجعل الإذن رسما لا زوال له % % كالإذن للقوم من أصحابه النبل % 34(@)(@@) % وما خرقت ولا ضيقت في مهل % بل قد رققت وقد أوسعت في المهل % 35(@)(@@) % ولو عجلت وجدت الله يعذرني % % في قولهخلق الإنسان من عجل % % 36(@)(@@) % ها 
ms936	 أنت تعلم أن الصبر من صبر % تمزجه بالنجح إن النجح من عسل % 37(@)(@@) % وما علي ملام إنني رجل % ظمئت خمسا ولم أشرع على وشل % % 38(@)(@@) % لكل شرعت على بحر له حدب % تغشى غواربه الركبان كالظلل % 39(@)(@@) % متى أنال الذي أملت من أمل % إن لم أنل بك ما أملت من أمل % % 40(@)(@@) % أنى يكون ربيعي ممرعا غدقا % إن لم يكن هكذا والشمس في الحمل % PageV01P3688 41(@)(@@) % يا آل وهب أعينوني على رجل % أعلى وأثقل في الميزان من جبل % 42(@)(@@) % حرمت منه وقد عمت فواضله % وتلكم المثلة الكبرى من المثل % 43(@)(@@) % ألحاظه لا تراعيني ونائله % لا في التفاريق تأتيني ولا الجمل % 44(@)(@@) % مضت سنون أراعي نجم دولتكم % % فيها وأعتدها قسمي من الدول % 45(@)(@@) % إن غاب حظكم استعبرت من أسف % له وإن قفل استبشرت بالقفل % 46(@)(@@) % وإن رمى الدهر من يرمي صفاتكم % % ناديته لا رماك الله بالشلل % 47(@)(@@) % حتى إذا أطلع الله السعود لكم % % خصصت بالعطلة الطولى من العطل % 48(@)(@@) % طال المطال على حقي ودافعه % % من ليس منه دفاع الحق بالعلل % % 49(@)(@@) % ولم يفت فائت تأسى النفوس به % % كنائل الكف ذات العرف والنفل % 50(@)(@@) % مال مول وأسباب مخيبة % في دولة الفوز ما هذا بمحتمل % PageV01P3689 51(@)(@@) % حتام يا سائس الدنيا تؤخرني % % وإنني لنظير الصدر لا الكفل % 52(@)(@@) % لكل قوم رسوم أنت راسمها % % ولست فيهم بذي رسم ولا طلل % 53(@)(@@) % لا في التجار ولا العمال تنصبني % % وإنني لقليل المثل والبدل % 54(@)(@@) % أنا المشار إليه بالبنان إذا % % عد المراجيح والمرموق بالمقل % 55(@)(@@) % وما وفاني بمدخول إذا كلحت % دهياء تفتر للأقوام عن عصل % 56(@)(@@) % يدوم عهدي على حال لمصطنعي % % ولا أعرد عنه ساعة الوهل % 57(@)(@@) % ولا أقول إذا نابته نائبة % مالي بعادية الأيام من قبل % 58(@)(@@) % كم في احتيالي وتدبيري لذي فزع % من ملجأ ومغارات ومدخل % 59(@)(@@) % وما أقرض نفسي كي أدلسها % % ولا أريغ لديك الحظ بالحيل % 60(@)(@@) % لكن تنصحت في نفسي لأهديها % % إليك والنفس علق ليس بالجلل % PageV01P3690 61(@)(@@) % ومن تسوق مرتاعا بسلعته % % مستشعر الخوف مملوءا من الوجل 
ms937	 % 62(@)(@@) % فقد تقدمت في أمري على ثقة % مني يشيعها أمن من الخجل % % 63(@)(@@) % فاخبر وجرب تجدني حين تخبرني % % أمضى من السيف في الأعناق والقلل % 64(@)(@@) % وارم المهمات بي في كل حادثة % ترتاع منها أسود الغاب والأسل % 65(@)(@@) % تجد لدي كفايات مجربة % أشفى من البارد المثلوج للغلل % % 66(@)(@@) % لا تطرحني فإني غير مطرح % ولا تذلني فإني العلق لم يذل % 67(@)(@@) % خذني عتادا لما في الدهر من نوب % محذورة ولما في الحال من نقل % 68(@)(@@) % هذا على أنني أرجو لكم مهلا % موصولة مدة الدنيا إلى مهل % 69(@)(@@) % وحقكم ذاك إن الله فضلكم % % تفضيله الضحوة الأولى على الطفل % 70(@)(@@) % براكم الله من حزم ومن كرم % أزكى من الماء بل أذكى من الشعل % % PageV01P3691 71(@)(@@) % وما افتقرتم إلى مدح يزينكم % % تالله يا زينة الأيام في الحفل % 72(@)(@@) % وكيف ذاك ومنكم كل مقتبس % من السناء وعنكم كل ممتثل % % 73(@)(@@) % تغنون عن كل تقريظ بفضلكم % % غنى الظباء عن التكحيل بالكحل % % 74(@)(@@) % تلوح في دولة الأيام دولتكم % كأنها ملة الإسلام في الملل % % 75(@)(@@) % فأنتم أولياء الله كلكم % في جنة الخلد سكناهم بلا حول % % 76(@)(@@) % ما إن لدولتكم إبان منقرض % كلا لعمري ولا ميقات مرتحل % 77(@)(@@) % أنجى الإله من المريخ زهرتكم % % ومشتريكم فقد أنجاه من زحل % 78(@)(@@) % خذها فما عجزت كلا ولا قصرت % عن رتبة السبع في أترابها الطول % 79(@)(@@) % واسلم سلامة مأمول فواضله % إذا رأوه لبني الآمال كالقبل % PageV01P3692 البحر : - 1(@)(@@) % بني طاهر إما منعتم نوالكم % فلا تمنعوا مني شفاء غليلي % % 2(@)(@@) % دعوني ألوم النفس إذ أملتكم % % وأندب مدحي فيكم بعويل % 3(@)(@@) % ولاتبخلوا عني بعرض فكلكم % % بني طاهر بالعرض غير بخيل % 4(@)(@@) % صلوني بأعراض لكم قد تمزقت % تمزق أطمار على ابن سبيل % 5(@)(@@) % يكن مناديلي إذا ما تنازعت % لحومكم كفي وكف أكيلي % % 6(@)(@@) % ولاتستقلوها رياء وسمعة % فما مثلها في مثلكم بقليل % 7(@)(@@) % بني طاهر مهما أخال على امرىء % فلومكم في الناس غير مخيل % % 8(@)(@@) % لعمر قواف عاجت العيس نحوكم % % لقد وقفت من ربعكم بمحيل % PageV01P3693 البحر : - 1(@)(@@) % م طل دمع 
ms938	 هريق في الأطلالص بعد إقوائها من الحلال % فل ما طلت الدماء اللواتي % % 2(@)(@@) % سفكتها سواكن الأطلال % % أي حق لها فيرعاه راع % 3(@)(@@) % من نوال لأهلها ووصال % فانصرافا عن الوقوف عليها % % 4(@)(@@) % إنها من مواقف الضلال % لن ترى الدهر موقفا لرشيد % 5(@)(@@) % يشتري النكس فيه بالإبلال % ليس تجدي على المسائل دار % 6(@)(@@) % غير هيج السقام بعد اندمال % % وكفاه بما تسلف منها % % 7(@)(@@) % من قديم الخبال بعد الخبال % تهجر الوحش كل واد عراه % 8(@)(@@) % مرة ذو حبالة أو نبال % وعساها لم تمن فيه برمي % % 9(@)(@@) % نالها صبرة ولا باحتبال % % وترى الناس يرأمون عراصا % 10(@)(@@) % يختبلن الصحيح أي اختبال % % بعدما لقوا بها البرح المبر % PageV01P3694 11(@)(@@) % رح من حابل ومن نبال % ولعمري لكانت الإنس أحجى % % 12(@)(@@) % باجتناب الأمور ذات الوبال % بل يظل الأسير منهم إذا فك % 13(@)(@@) % ك طويل الأسى على الأكبال % واقفا في معاهد الأسر يبكي % % 14(@)(@@) % من هوى آسراته غير سال % يتبع النفس كل بيضاء شالت % 15(@)(@@) % من دماء الرجال ذات انتقال % مع أني وإن رزئت عليهم % % 16(@)(@@) % واحتلبت الصبا بغير اكتهال % غير ناس على تناسي جهلي % % 17(@)(@@) % عهد أسماء بالحمى والمطال % من فتاة تحل كل ربيع % 18(@)(@@) % بمغان من المها ومحلال % حين يغدو بنو الظباء فيلقو % % 19(@)(@@) % ن خليطي جآذر ورئال % % وكذاك الزمان يمحل بالإل % % 20(@)(@@) % فين محلا يجني بعاد زيال % % حبذا عهدها الذي عاد شوقا % PageV01P3695 21(@)(@@) % وحنينا إلى العهود الخوالي % % والزمان الذي لبسنا به العي % % 22(@)(@@) % ش جديدا كأنه برد حال % والمحل الذي تبدل عينا % 23(@)(@@) % بعد عين من الأنيس الخوالي % % إن نبادل بسكنه فعلى ضن % 24(@)(@@) % ن بتلك الأعلاق عند البدال % ليت شعري هل ذلك العهد مرجو % % 25(@)(@@) % ع بعطف من النوى وانفتال % إذ غصون اللجين لا البان منه % % 26(@)(@@) % فوق كثبان لؤلؤ لا رقال % % ليس غير العيون فيهن من نو % 27(@)(@@) % ر وغير الثدي من أحمال % بينها غادة تشارك فيها % % 28(@)(@@) % بهجة الشمس صورة التمثال % % من ذوات الحظوظ في البدن إلا % % 29(@)(@@) % طي بين الصدور والأكفال % تقسم الحلي 
ms939	 بين قب خماص % 30(@)(@@) % تحت أثنائه وجسم خدال % يتشاكى وشاحها وأخوه ضد % PageV01P3696 31(@)(@@) % شكوى السوار والخلخال % جاع شاك وكظ شاك % 32(@)(@@) % وما ذاك لخبث الغذاء والإرقال % بلكلا الشاكيين نزل منها % % 33(@)(@@) % نزلا طيبا من الأنزال % % شد من متنها هوى بعضها بعضا % 34(@)(@@) % وقد هم خصرها بانخزال % كاد لولاه أن يلين قضيب % 35(@)(@@) % من كثيب على شفير انهيال % بل حمى جسمها وقد أسلمته % 36(@)(@@) % رقة سابرية لانحلال % مستعار رنوها من مهاة % 37(@)(@@) % مستعار عطوها من غزال % % بل هي المستعار ذلك منها % % 38(@)(@@) % للمها والظباء غير انتحال % ظبية إن عطت جنت ثمرات % 39(@)(@@) % من قلوب ولم تنش غصن ضال % ذات جيد عطوله أحسن الحل % % 40(@)(@@) % ي عليه وليس بالمعطال % روضة الليل عاطر النشر فيه % % PageV01P3697 41(@)(@@) % حين تعتل نكهة المنفال % % أيما منظر تزودت منه % % 42(@)(@@) % يوم ردت جمالها لاحتمال % % ذات يوم رأيتها فيه مليء % 43(@)(@@) % للعين من بهجة وحسن دلال % لبست حلة الشباب وظلت % 44(@)(@@) % تتهادى في غصنه الميال % صبغة أرجوانية في صفاء % 45(@)(@@) % وقوام مهفهف في اعتدال % وزهاها سواد فرع بهيم % 46(@)(@@) % فهي سكرى لذاك سكر اختيال % لتزد في اختيالها ولعمري % % 47(@)(@@) % إنها في مزية المختال % أقبلت في القبول تمشي الهوينا % % 48(@)(@@) % وهي حسنا كالحظ في الإقبال % قد تجلت على محاسن ليست % 49(@)(@@) % عند فقد الحلي والإعطال % ظاهرت شكة عليها بأخرى % % 50(@)(@@) % لامرىء غير مؤذن بقتال % ويح أعدائها أذلك منها % % PageV01P3698 51(@)(@@) % فرط حشد لحاسر معزال % لاتظاهر سلاحها لمحب % 52(@)(@@) % فكفاه بسهمها القتال % أيها العائبي بخفة لحمي % % 53(@)(@@) % بجلى منه كسوة الأوصال % وهنيئا لك الفضول من اللح % % 54(@)(@@) % م ففاخر بها ذوات الحجال نه طل دمع هريق في الأطلال % بعد إقوائها من الحلال % 55(@)(@@) % فل ما طلت الدماء اللواتي % % سفكتها سواكن الأطلال % % 56(@)(@@) % أي حق لها فيرعاه راع % من نوال لأهلها ووصال % 57(@)(@@) % فانصرافا عن الوقوف عليها % % إنها من مواقف الضلال % 58(@)(@@) % لن ترى الدهر موقفا لرشيد % يشتري النكس فيه بالإبلال % 59(@)(@@) % ليس تجدي على المسائل دار % غير هيج السقام بعد اندمال % % 60 
