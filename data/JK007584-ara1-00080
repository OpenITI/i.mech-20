ms61	 ، بكل أرض : % فليس عليك خائنة الليالي % % 21(@)(@@) % وأنت أشد هذا الناس بأسا ، % به بين الأراقم والصلال % 22(@)(@@) % وأهجمهم على جيش كثيف % وأغورهم على حي حلال % 26(@)(@@) % ضربت فلم تدع للسيف حدا % وجلت بحيث ضاق عن المجال % PageV01P282 27(@)(@@) % فقلت ، وقد أظل الموت : صبرا ! % وإن الصبر عند سواك غال % 28(@)(@@) % ألا هل منكر يابني نزار ، % مقامي ، يوم ذلك ، أو مقالي ؟ % 29(@)(@@) % ألم أثبت لها ، والخيل فوضى ، % بحيث تخف أحلام الرجال ؟ % 30(@)(@@) % تركت ذوابل المران فيها % % مخضبة ، محطمة الأعالي % % 31(@)(@@) % وعدت أجر رمحي عن مقام ، % تحدث عنه ربات الحجال % 32(@)(@@) % وقائلة تقول : جزيت خيرا % لقد حاميت عن حرم المعالي ! % 33(@)(@@) % ومهري لا يمس الأرض ، زهوا ، % كأن ترابها قطب النبال % 34(@)(@@) % كأن الخيل تعرف من عليها ، % ففي بعض على بعض تعالي % % 35(@)(@@) % % رخيص عنده المهج الغوالي % % 36(@)(@@) % فإن عشنا ذخرناها لأخرى ، % وإن متنا فموتات الرجال % PageV01P283 البحر : طويل 1(@)(@@) % فلما رأتنا اجفلت كل مجفل فبين قتيل بالدماء مضرج ، إباء إباء البكر ، غير مذلل ، % وعزم كحد السيف ، غير مفلل % 2(@)(@@) % أأغضي على الأمر ، الذي لا أريده ، % ولما يقم بالعذر رمحي ومنصلي % % 3(@)(@@) % أبى الله ، والمهر المنيعي ، والقنا ، % وأبيض وقاع على كل مفصل % 4(@)(@@) % وفتيان صدق من غطاريف وائل % إذا قيل ركب الموت قالوا له : انزل % 5(@)(@@) % يسوسهم بالخير والشر ماجد ، % جرور لأذيال الخميس المذيل % 6(@)(@@) % له بطش قاس ، تحته قلب راحم ، % ومنع بخيل ، بعده بذل مفضل % 7(@)(@@) % وعزمة خراج من الضيم ، فاتك ، % وفي ، أبي ، يأخذ الأمر من عل % 8(@)(@@) % عزوف ، أنوف ، ليس يقرع سنه ، % جريء ، متى يعزم على الأمر يفعل % 9(@)(@@) % شديد على طي المنازل صبره ، % إذا هو لم يظفر بأكرم منزل % 10(@)(@@) % بكل محلاة السراة بضيغم ، % وكل معلاة الرحال بأحدل % PageV01P284 12(@)(@@) % كأن أعالي رأسها وسنامها % % منارة قسيس ، قبالة هيكل % 13(@)(@@) % سريت بها ، من ساحل البحر ، أغتد % % على ' كفر طاب ' ، صوبها لم يحول % 14(@)(@@) % وقدمت نذري أن يقولوا : غدرتنا % % وأقبلت ، لم أرهق ، ولم أتحيل % 15(@)(@@) % إلى عرب ، لا تختشي غلب غالب ، % وفي ، أبي ، يأخذ الأمر من 
ms62	 عل % 16(@)(@@) % تواصت بمر الصبر ، دون حريمها % % 17(@)(@@) % % وفي ، أبي ، يأخذ الأمر من عل % 18(@)(@@) % فلما أطعت الجهل والغيظ ، ساعة ، % دعوت بحلمي : أيها الحلم أقبل ! % 19(@)(@@) % بنيات عمي هن ، ليس يرينني : % بعيد التجافي ، أو قليل التفضل % 20(@)(@@) % شفيع النزاريات ، غير مخيب ، % وداعي النزاريات ، غير مخذل % 21(@)(@@) % رددت ، برغم الجيش ، ما حاز كله ، % وكلفت مالي غرم كل مضلل % PageV01P285 22(@)(@@) % فأصبحت ، في الأعداء ، أي ممدح % وإن كنت في الأصحاب ، أي معذل % 23(@)(@@) % مضى فارس الحيين ' زيد بن منعة ' % ومن يدن من نار الوقيعة يصطل % 24(@)(@@) % وقرما ' بني البنا : تميم بن غالب ' % همامان ، طعانان في كل جحفل % 25(@)(@@) % ولو لم تفتني سورة الحرب فيهما % % جريت على رسم من الصفح أول % 26(@)(@@) % وعدت ، كريم البطش ، والعفو ، ظافرا ، % أحدث عن يوم أغر ، محجل % PageV01P286 البحر : مجزوء الكامل 1(@)(@@) % هل تعطفان على العليل ؟ % لا بالأسير ، ولا القتيل ! % 2(@)(@@) % باتت تقبله الأك % % ف ، سحابة الليل الطويل % % 3(@)(@@) % يرعى الندجوم السائرا % % ت من الطلوع إلى الأفول % 4(@)(@@) % فقد الضيوف مكانه ، % وبكاه أبناء السبيل % 5(@)(@@) % واستوحشت لفراقه ، % يوم الوغى ، سرب الخيول % 6(@)(@@) % وتعطلت سمر الرما % % ح ، وأغمدت بيض النصول % 7(@)(@@) % يا فارج الكرب العظي % % م ، وكاشف الخطب الجليل % 8(@)(@@) % كن ، يا قوي ، لذا الضعي % % ف ، ويا عزيز ، لذا الذليل ! % 9(@)(@@) % قربه من سيف الهدى ، % في ظل دولته الظليل ! % 10(@)(@@) % أوما كشفت عن ابن دا % % ود ' ثقيلات الكبول ؟ ! % PageV01P287 11(@)(@@) % لم أرو منه ولا شفي % % ت بطول خدمته ، غليلي % % 12(@)(@@) % ألله يعلم : أنه % أملي من الدنيا وسولي % % 13(@)(@@) % ولئن حننت إلى ذرا % % ه لقد حننت إلى وصول % 14(@)(@@) % لا بالغضوب ، ولا الكذو % % ب ، ولا القطوب ، ولا الملول % 15(@)(@@) % يا عدتي في النائبا % % ت ، وظلتي عند المقيل ! % 16(@)(@@) % أين المحبة ، والذما % % م وما وعدت من الجميل ؟ ! % 17(@)(@@) % أجمل على النفس الكري % % مة في ، والقلب الحمول ! % 18(@)(@@) % أما المحب فليس يص % غي في هواه إلى عذول % 19(@)(@@) % يمضي بحال وفائه ، % ويصد عن قال وقيل ! % PageV01P288 البحر : رجز تام 1(@)(@@) % أروح القلب ببعض الهزل ، % تجاهلا مني 
ms63	 ، بغير جهل ! % 2(@)(@@) % أمزح فيه ، مزح أهل الفضل ، % والمزح ، أحيانا ، جلاء العقل % PageV01P289 البحر : خفيف تام 1(@)(@@) % قل لأحبابنا الجفاة : رويدا ! % درجونا على احتمال الملال ! % 2(@)(@@) % إن ذاك الصدود ، من غير جرم % لم يدع في مطمعا بالوصال % 3(@)(@@) % أحسنوا في فعالكم أو أسيئوا ! % لا عدمناكم على كل حال ! % PageV01P290 البحر : خفيف تام 1(@)(@@) % قاتلي شادن ، بديع الجمال ، % أعجمي الهوى ، فصيح الدلال % 2(@)(@@) % سل سيف الهوى علي ونادى : % يا لثأر الأعمام والأخوال ! % 3(@)(@@) % كيف أرجو ممن يرى الثأر عندي % % خلقا من تعطف أو وصال ؟ % 4(@)(@@) % بعدما كرت السنون ، وحالت % دون ذي قار الدهور الخوالي % % 6(@)(@@) % أيها الملزمي جرائر قومي ، % بعدما قد مضت عليها الليالي ! % 7(@)(@@) % لم أكن من جناتها ، علم الله ، % و إني لحرها ، اليوم ، صال % PageV01P291 البحر : كامل تام 1(@)(@@) % الفكر فيك مقصر الآمال ، % والحرص بعدك غاية الجهال % 2(@)(@@) % لو كان يخلد بالفضائل فاضل % وصلت لك الآجال بالآجال ! % 3(@)(@@) % أو كنت تفدى لافتدتك سراتنا % % بنفائس الأرواح والأموال % 4(@)(@@) % أو كان يدفع عنك بأس أقبلت ، % شرعا ، تكدس بالقنا العسال % 5(@)(@@) % أعزز ، على سادات قومك ، أن ترى % % فوق الفراش ، مقلب الأوصال % 6(@)(@@) % و السابغات مصونة ، لم تبتذل ، % و البيض سالمة مع الأبطال % 7(@)(@@) % و إذا المنية أقيلت لم يثنها % % حرص الحريص ، وحيلة المحتال % 8(@)(@@) % ما للخطوب ؟ وما لأحداث الردى % % أعجلن جابر غاية الإعجال ؟ % 10(@)(@@) % لما تسربل بالفضائل ، وارتدى % % برد العلا ، وأعتم بالإقبال % 11(@)(@@) % وتشاهدت صيد الملوك بفضله % و أرى المكارم ، من مكان عال % PageV01P292 12(@)(@@) % أأبا المرجى ! غير حزني دارس ، % أبدا عليك ، وغير قلبي سال % 14(@)(@@) % لا زلت مغدو الثرى ، مطروقه ، % بسحابة مجرورة الأذيال % 15(@)(@@) % و حجبن عنك السيئات ولم يزل % لك صاحب من صالح الأعمال % PageV01P293 البحر : وافر تام 1(@)(@@) % سلي عنا سراة بني كلاب % ببالس ، عند مشتجر العوالي ! % 2(@)(@@) % لقيناهم بأسياف قصار ، % كفين مؤونة الأسل الطوال % 3(@)(@@) % وولى ب ' آبن عوسجة كثير ' % وساع الخطو في ضنك المجال % 4(@)(@@) % يرى ' البرغوث ' إذ نجاه منا ، % أجل عقيلة ، وأحب مال % 5(@)(@@) % تدور به إماء من ' قريظ ' ؛ % وتسأله النساء 
ms64	 عن الرجال ! % 6(@)(@@) % يقلن له : السلامة خير غنم ! % و إن الذل في ذاك المقال % 7(@)(@@) % و ' جهمان ' تجافت عنه بيض ، % عدلن عن الصريح إلى الموالي % % 8(@)(@@) % وعادوا ، سامعين لنا ، فعدنا % % إلى المعهود من شرف الفعال % 9(@)(@@) % و نحن متى رضينا بعد سخط % أسونا ما جرحنا بالنوال % PageV01P294 البحر : مجزوء الكامل 1(@)(@@) % نفسي فداؤك قد بعث % % ت بعهدتي بيد الرسول % 2(@)(@@) % أهديت نفسي ، إنما % % يهدى الجليل إلى الجليل % 3(@)(@@) % وجعلت ما ملكت يدي ، % بشرى المبشر بالقبول % PageV01P295 البحر : هزج 1(@)(@@) % غنى النفس ، لمن يعق % % ل ، خير من غنى المال ! % 2(@)(@@) % وفضل الناس ، في الأنف % س ، ليس الفضل في الحال % % PageV01P296 البحر : طويل 1(@)(@@) % يلوح بسيماه الفتى من بني أبي ، % وتعرفه من غيره بالشمائل % 2(@)(@@) % مفدى ، مردى ؛ يكثر الناس حوله % طويل نجاد السيف ، سبط الأنامل % % PageV01P297 البحر : وافر تام 1(@)(@@) % ألا لله ، يوم الدار يوما % بعيد الذكر ، محمود المآل % 2(@)(@@) % تركت به نساء ' بني كلاب ' ، % فوارك ، ما يرغن إلى الرجال % 3(@)(@@) % تركنا الشبخ ، شيخ ' بني قريظ ' % ببطن القاع ممنوع الذمال % 4(@)(@@) % مقاطعة أحبته ، ولكن % يبيت من الخوامع في وصال % 5(@)(@@) % تخف إذا تطاردنا ' كلاب ' ؛ % فكيف بها إذا قلنا نزال % 6(@)(@@) % تركناها ، ولم يتركن إلا % لأبناء العمومة ، والخوالي ! % 7(@)(@@) % فلم ينهضن عن تلك الحشايا ؛ % ولم يبرزن من تلك الحجال % PageV01P298 البحر : طويل 1(@)(@@) % إذا كان فضلي لا أسوغ نفعه % فأفضل منه أن أرى غير فاضل % 2(@)(@@) % ومن أضيع الأشياء مهجة عاقل ، % يجوز على حوبائها حكم جاهل ! % PageV01P299 البحر : متقارب تام 1(@)(@@) % هواك هواي ، على كل حال % وإن مسني فيك بعض الملال % 3(@)(@@) % وكم لك عندي من غدرة ، % وقول ، تكذبه بالفعال ! % 4(@)(@@) % ووعد يعذب فيه الكريم % إما بخلف ، وإما مطال % 5(@)(@@) % صبرنا لسخطك ، صبر الكرام ، % فهذا رضاك ، فهل من نوال ؟ % 6(@)(@@) % وذقنا مرارة كأس الصدود ، % فأين حلاوة كأس الوصال ؟ % PageV01P300 البحر : طويل 1(@)(@@) % أقول وقد ناحت بقربي حمامة : % أيا جارتا هل بات حالك حالي ؟ % 2(@)(@@) % معاذ الهوى ! ماذقت طارقة النوى ، % ولا خطرت منك الهموم ببال % 3(@)(@@) % أتحمل محزون الفؤاد قوادم % على 
ms65	 غصن نائي المسافة عال ؟ % 4(@)(@@) % أيا جارتا ، ما أنصف الدهر بيننا ! % تعالي أقاسمك الهموم ، تعالي ! % 5(@)(@@) % تعالي تري روحا لدي ضعيفة ، % تردد في جسم يعذب بالي % % 6(@)(@@) % أيضحك مأسور ، وتبكي طليقة ، % ويسكت محزون ، ويندب سال ؟ % 7(@)(@@) % لقد كنت أولى منك بالدمع مقلة ؛ % ولكن دمعي في الحوادث غال ! % PageV01P301 البحر : طويل 1(@)(@@) % ولله عندي في الإسار وغيره % مواهب ، لم يخصص بها أحد قبلي ! % 2(@)(@@) % حللت عقودا ، أعجز الناس حلها ، % وما زال عقدي لا يذم ولا حلي % % 3(@)(@@) % إذا عاينتني الروم كفر صيدها ، % كأنهم أسرى لدي وفي كبلي % % 4(@)(@@) % وأوسع ، أيا ما حللت ، كرامة ، % كأنني من أهلي نقلت إلى أهلي % % 5(@)(@@) % فقل لبني عمي ، وأبلغ بني أبي : % بأني في نعماء يشكرها مثلي % % 6(@)(@@) % وما شاء ربي غير نشر محاسني ، % وأن يعرفوا ما قد عرفت من الفضل % PageV01P302 البحر : مجزوء الكامل 1(@)(@@) % إنا ، إذا اشتد الزما % % ن ، وناب خطب وادلهم % % 2(@)(@@) % ألفيت ، حول بيوتنا ، % عدد الشجاعة ، والكرم % 3(@)(@@) % للقا العدى بيض السيو % % ف ، وللندى حمر النعم % 4(@)(@@) % هذا وهذا دأبنا ، % يودى دم ، ويراق دم % 5(@)(@@) % قل لابن ورقا جعفر ، % حتى يقول بما علم % 6(@)(@@) % إني ، وإن شط المزا % % ر ولم تكن داري أمم % 7(@)(@@) % أصبو إلى تلك الخلا % % ل ، وأصطفي تلك الشيم ' % 8(@)(@@) % ' وألوم عادية الفرا % % ق ، وبين أحشائي ألم % 9(@)(@@) % ' ولعل دهرا ينثني ، % ولعل شعبا يلتئم ' % 10(@)(@@) % ' هل أنت ، يوما ، منصفي % % من ظلم عمك ؟ يا بن عم % PageV01P303 11(@)(@@) % أبلغه عني ما أقو % % ل ، فأنت من لا يتهم ! ' % 12(@)(@@) % أني رضيت ، وإن كره % ت ، أبا محمد الحكم % PageV01P304 البحر : مجزوء الكامل 1(@)(@@) % يهني الأمير بشارة ، % قرت بها عين المكارم % 2(@)(@@) % أعلى الورى شرفا ، ومن % قد بشروه بخير قادم % 3(@)(@@) % إني ، وإن كنت المشا % % رك في الأبوة ، والمساهم % 4(@)(@@) % لأقول قولا لا يرد ، % ولا يرى لي فيه لاثم : % 5(@)(@@) % لأبي المعالي ، في العلا ، % و ' أبي المكارم ' في المكارم % 6(@)(@@) % بيت ، رفيع سمكه ، % عالي الذرى ، ثبت الدعائم % PageV01P305 البحر : كامل تام 1(@)(@@) % إبنان ، أم شبلان ذان ؟ فإنني % % لأرى دماء 
ms66	 الدارعين غذاهما % % 2(@)(@@) % تنبي الفراسة : أن في ثوبيهما % % ليثين ، تجتنب الليوث حماهما % % 3(@)(@@) % لم لا يفوقان الأنام ، مكارما ! % والسيدان ، كلاهما ، جداهما % % 4(@)(@@) % تلقى ' أبا الهيجاء ' في هيجاهما ، % ويريك فضل أبي العلاء علاهما % % 5(@)(@@) % زدناهما ، شرفا رفيعا سمكه ، % ثبت الدعائم ، إذ تخولناهما % % 6(@)(@@) % ميزت بينهما فلم يتفاضلا % % كالفرقدين تشاكلت حالاهما % % 7(@)(@@) % إني ، وإن كان التعصب شيمتي ، % لا أدفع الشرف المنيف أخاهما ! % 8(@)(@@) % أنى يقصر عن مكان في العلا % % والمجد ، من أضحى أبوه أباهما ؟ % 9(@)(@@) % لكن لذين بنا مكان باذخ ، % لايدعيه ، من الأنام ، سواهما % % PageV01P306 البحر : وافر تام 1(@)(@@) % أسرت فلم أذق للنوم طعما ، % ولا حل الطعان لنا حزاما % % 2(@)(@@) % وسرنا ، معلمين ، إليك حتى % % ضربنا ، خلف ' خرشنة ' الخياما ! % PageV01P307 البحر : مجزوء الكامل 1(@)(@@) % يا سيدي ! أراكما % % لا تذكران أخاكما ! % 2(@)(@@) % أوجدتما بدلا به ، % يبني سماء علاكما ؟ % 3(@)(@@) % أوجدتما بدلا به ، % يفري نحور عداكما ! ؟ % 4(@)(@@) % ما كان بالفعل الجمي % % ل ، بمثله ، أولاكما ! % 5(@)(@@) % من ذا يعاب ، بما لقي % % ت من الورى ، إلا كما ؟ % 6(@)(@@) % لا تقعدا بي ، بعدها ، % وسلا ' الأمير ' ، أباكما ! % 7(@)(@@) % وخذا فداي ، جعلت من % ريب الزمان فداكما ! % PageV01P308 البحر : بسيط تام 1(@)(@@) % وشادن قال لي ، لما رأى سقمي % % وضعف جسمي والدمع الذي انسجما % % 2(@)(@@) % أخذت دمعك من خدي ، وجسمك من % % خصري وسقمك من طرفي الذي سقما % % PageV01P309 البحر : وافر تام 1(@)(@@) % ألا من مبلغ سروات قومي % % وسيف الدولة الملك ، الهماما ! % 2(@)(@@) % بأني لم أدع فتيات قومي ، % إذا حدثن ، جمجمن الكلاما % % 3(@)(@@) % شريت ثناءهن ببذل نفسي ، % و نار الحرب تضطرم اضطراما % % 4(@)(@@) % ولما لم أجد إلا فرارا % أشد من المنية أو حماما % % 5(@)(@@) % حملت ، على ورود الموت ، نفسي % % وقلت لعصبتي : ' موتوا كراما ! ' % 6(@)(@@) % ولم أبذل ، لخوفهم ، مجنا ، % ولم ألبس حذار الموت ، لاما % % 7(@)(@@) % وعذت بصارم ، ويد ، وقلب % حماني أن ألام ، وأن أضاما % % 8(@)(@@) % ألفهم وأنشرهم كأني % % أطرد منهم الإبل السواما % % 9(@)(@@) % وأنتقد الفوارس ، بيد أني % % رأيت اللوم أن ألقى اللئاما % % 10(@)(@@) % ومدعو إلى أجاب لما % % رأى أن قد تذمم واستلاما % % PageV01P310 11(@)(@@) % عقدت على مقلده يميني ، % وأعفيت 
ms67	 المثقف والحساما % % 12(@)(@@) % وهل عذر ، و ' سيف الدين ركني ، % إذا لم أركب الخطط العظاما ؟ % 13(@)(@@) % وأتبع فعله ، في كل أمر ، % وأجعل فضله ، أبدا ، إماما % % 14(@)(@@) % وقد أصبحت منتسبا إليه ، % وحسبي أن أكون له غلاما % % 15(@)(@@) % أراني كيف أكتسب المعالي ، % وأعطاني ، على الدهر ، الذماما % % 16(@)(@@) % ورباني ففقت به البرايا ، % وأنشأني فسدت به الأناما % % 17(@)(@@) % فعمره الإله لنا طويلا ، % وزاد الله نعمته دواما ! % PageV01P311 البحر : بسيط تام 1(@)(@@) % لمثلها يستعد البأس والكرم ، % وفي نظائرها تستنفد النعم % 2(@)(@@) % هي الرئاسة لا تقنى جواهرها ، % حتى يخاض إليها الموت والعدم % 3(@)(@@) % تقاعس الناس عنها فانتدبت لها % % كالسيف ، لا نكل فيه ولا سأم % 4(@)(@@) % ما زال يجحدها قوم ، وينكرها % % حتى أقروا ، وفي آنافهم رغم % 5(@)(@@) % شكرا فقد وفت الأيام ما وعدت ، % أقر ممتنع ؛ وانقاد معتصم ! % 6(@)(@@) % وما الرئاسة إلا ما تقر به % شمس الملوك ، وتعنو تحته الأمم % 7(@)(@@) % مغارم المجد يعتد الملوك بها % % مغانما في العلا ، في طيها نعم % 8(@)(@@) % هذي شيوخ ' بني حمدان ' قاطبة ، % لاذوا بدارك عند الخوف واعتصموا % % 9(@)(@@) % حلوا بأكرم من حل العباد به % بحيث حل الندى واستوثق الكرم % 10(@)(@@) % فكنت منهم وإن أصبحت سيدهم ، % تواضع الملك في أصحابه عظم ! % PageV01P312 11(@)(@@) % شيخوخة سبقت ، لا فضل يتبعها % % وليس يفضل فينا الفاضل الهرم % 12(@)(@@) % ولم يفضل ' عقيلا ' في ولادته % على علي أخيه ، السن والقدم % 13(@)(@@) % وكيف يفضل من أزرى به بخل % وقعدة اليد ، والرجلين ، والصمم % 14(@)(@@) % لا تنكروا ، يا بنيه ، ما أقول فلن % تنسى الترات ولا إن حال شيخكم % 15(@)(@@) % كادت مخازيه ترديه فأنقذه % منها ، بحسن دفاع عنه ، عمكم % 16(@)(@@) % أستودع الله قوما ، لا أفسرهم ، % الظالمين ، ولو شئنا لما ظلموا % % 17(@)(@@) % القائلين ، ونغضي عن جوابهم , % والجائرين ، ونرضى بالذي حكموا % % 18(@)(@@) % إني ، على كل حال ، لست أذكرهم ؛ % إلا وللشوق دمعي واكف ، سجم % 19(@)(@@) % الأنفس اجتمعت يوما ، أو افترقت % إذا تأملت ، نفس ، والدماء دم % 20(@)(@@) % رعاهم الله ، ما ناحت مطوقة ، % وحاطهم ، أبدا ، ما أورق السلم % PageV01P313 البحر : طويل 1(@)(@@) % يقولون لا تخرق بحلمك هيبة % وأحسن شيء زين الهيبة الحلم 
ms68	 % 2(@)(@@) % فلا تتركن العفو عن كل زلة % فما العفو مذموم ، وإن عظم الجرم % PageV01P314 البحر : طويل 1(@)(@@) % نفى النوم عن عيني خيال مسلم % تأوب من أسماء ، والركب نوم % 2(@)(@@) % ظللت وأصحابي عباديد في الدجى % % ألذ بجوال الوشاح ، وأنعم % 3(@)(@@) % وسائلة عني فقلت ، تعجبا : % كأنك لا تدرين كيف المتيم ؟ % 4(@)(@@) % أعرني ، أقيك السوء ، نظرة وامق % لعلك ترثي ، أو لعلك ترحم ! % 5(@)(@@) % فما أنا إلا عبدك القن في الهوى ، % وما أنت إلا المالك ، المتحكم % 6(@)(@@) % وأرضى بما ترضى على السخط والرضا % % وأغضي ، على علم بأنك تظلم % 7(@)(@@) % يئست من الإنصاف بيني وبينه ، % ومن لي بالإنصاف والخصم يحكم ؟ % 8(@)(@@) % وخطب من الأيام أنساني الهوى ، % وأحلى بفي الموت ، والموت علقم % 9(@)(@@) % ووالله ، ماشببت إلا علاله ، % ومن نار غير الحب قلبي يضرم % 10(@)(@@) % ألا مبلغ عني الحسين ألوكة ، % تضمنها در الكلام المنظم % PageV01P315 11(@)(@@) % لذيذ الكرى ، حتى أراك ، محرم % ونار الأسى بين الحشا تتضرم % 12(@)(@@) % وأترك أن أبكي عليك ، تطيرا ، % وقلبي يبكي ، والجوانح تلطم % 14(@)(@@) % وإن جفوني إن ونت للئيمة ، % وإن فؤادي إن سلوت لألأم % 15(@)(@@) % وأظهر للأعداء فيك جلادة ، % وأكتم ما ألقاه والله يعلم % 16(@)(@@) % سأبكيك ، ما أبقى لي الدهر مقلة ، % فإن عزني دمع ، فما عزني دم % 17(@)(@@) % وحكمي بكاء الدهر فيما ينوبني ، % وحكم لبيد فيه حول مجرم % 18(@)(@@) % و ما نحن إلا ' وائل ' و ' مهلهل ' % صفاء ، وإلا مالك ومتمم ! % 19(@)(@@) % وإني وإياه لعين وأختها ، % وإني وإياه لكف ومعصم % 20(@)(@@) % تصاحبنا الأيام في ثوب ناصح % ويختلنا منها ، على الأمن ، أرقم % 21(@)(@@) % وما أغربت فيك الليالي ، وإنها % % لتصدعنا من كل شعب وتثلم % PageV01P316 22(@)(@@) % طوارق خطب ، ما تغب وفودها ، % وأحداث أيام تغذ وتتئم % 23(@)(@@) % فما عرفتني غير ما أنا عارف % ولا علمتني غير ما كنت أعلم % 24(@)(@@) % متى لم تصب من الليالي ابن همة % يجشمها صرف الردى فتجشم % 25(@)(@@) % تهين علينا الحرب نفسا عزيزة % إذا عاضنا منها الثناء المنمنم % 26(@)(@@) % وإني لغر إن رضيت بصاحب % يبش ، وفيه جانب متجهم % 27(@)(@@) % ونحن أناس ، لا تزال سراتنا % % لها مشرب ، بين 
ms69	 المنايا ، ومطعم % 28(@)(@@) % نظرناإلى هذا الزمان ، وأهله % فهان علينا ما يشت وينظم % 29(@)(@@) % وندعو كريما من يجود بماله ، % ومن يبذل النفس الكريمة أكرم % 30(@)(@@) % وما لي لا أمضي حميدا ومطلبي % % بعيد ، و ما فعلي بحال مذمم % 31(@)(@@) % إذا لم يكن ينجي الفرار من الردى ، % على حالة ، فالصبر أرجى وأحزم % PageV01P317 32(@)(@@) % لك الله إنا بين غاد ورائح % نعد المغازي في البلاد ونغنم % 33(@)(@@) % وأرماحنا في كل لبة فارس % تثقب تثقيب الجمان وتنظم % 34(@)(@@) % سنضربهم ، مادام للسيف قائم ، % ونطعنهم ، مادام للرمح لهذم % 35(@)(@@) % ونقفوهم ، خلف الخليج بضمر % تخوض بحارا بعض خلجانها دم % 36(@)(@@) % بكل غلام من ' نزار ' وغيرها % % عليه من الماذي درع مختم % 37(@)(@@) % ونجنب ما ألقى ' الوجيه ' و ' لاحق ' % إلى كل ما أبقى الجديل وشدقم % 38(@)(@@) % ونعتقل الصم العوالي إنها % % طريق إلى نيل المعالي وسلم % 39(@)(@@) % رأيتهم يرجون ثأرا بسالف ، % وفي كل يوم يأخذ السيف منهم % 40(@)(@@) % فقل ل ' ابن فقاس ' : دع الحرب جانبا ! % فإنك رومي ، وخصمك مسلم % 41(@)(@@) % فوجهك مضروب ، وأمك ثاكل ، % وسبطك مأسور ، وعرسك أيم % PageV01P318 42(@)(@@) % ولم تنب عنك البيض في كل مشهد % ولكن قتل الشيخ فينا محرم % 43(@)(@@) % إذا ضربت فوق الخليج قبابنا ، % وأمسى عليك الذل ، وهو مخيم % 44(@)(@@) % وأدى إلينا ' الملك ' جزية رأسه ، % وفك عن الأسرى الوثاق وسلموا % % 45(@)(@@) % فإن ترغبوا في الصلح فالصلح صالح % وإن تجنحوا للسلم فالسلم أسلم % 46(@)(@@) % أعادات سيف الدولة القرم إنها % % لإحدى الذي كشفت بل هي أعظم ! % 47(@)(@@) % وإن لسيف الدولة القرم عادة % تروم علوق المعجزات فترأم % 48(@)(@@) % وقيل لها : سيف الهدى ، قلت : إنه % % ليفعل خير الفاعلين ويكرم % 49(@)(@@) % أما انتاش من مس الحديد وثقله % ' أبا وائل ' والبيض في البيض تحكم % 50(@)(@@) % تجر عليه الحرب ، من كل جانب ، % فلا ضجر جاف ، ولا متبرم % 51(@)(@@) % أخو عزمات في الحروب إذا أتى % % أتى حادث ، من جانب الله مبرم % PageV01P319 52(@)(@@) % نخف ، إذا ضاقت علينا أمورنا ، % بأبيض وجه الرأي والخطب مظلم % 53(@)(@@) % ونرمي بأمر لا نطيق احتماله % إلى قرمنا ، والقرم بالأمر أقوم % 54(@)(@@) % إلى رجل يلقاك 
ms70	 في شخص واحد % ولكنه في الحرب جيش عرمرم % 55(@)(@@) % نثيل على الأعداء أعقاب وطئه ، % صليب على أفواهها حين تعجم % 56(@)(@@) % ونمسك عن بعض الأمور مهابة ، % فيعلم ما يخفي الضمير ، ويفهم % 57(@)(@@) % ونجني جنايات عليه يقيلها ، % ونخطيء أحيانا إليه فيحلم % 58(@)(@@) % يسوموننا فيك الفداء ، وإننا % % لنرجوك قسرا والمعاطس ترغم % 59(@)(@@) % أترضى بأن نعطى السواء قسيمنا % % إذا المجد بين الأغلبين يقسم ؟ % 60(@)(@@) % وما الأسر غرم ، والبلاء محمد ، % ولا النصر غنم ، والهلاك مذمم % 61(@)(@@) % % وأقدمت لو أن الكتائب تقدم % PageV01P320 62(@)(@@) % دعوت خلوفا ، حين تختلف القنا ، % وناديت صما عنك ، حين تصمم % 63(@)(@@) % وما عابك ، ابن السابقين إلى العلا ، % تأخر أقوام وأنت مقدم % 64(@)(@@) % و مالك لا تلقى بمهجتك الردى ، % وأنت من القوم الذين هم هم ! % 65(@)(@@) % لعا ، يا أخي ! - لامسك السوء - إنه % هو الدهر في حاليه : بؤس وأنعم % 66(@)(@@) % و ما ساءني أني مكانك ، عانيا % وأسلم نفسي للإسار وتسلم % 67(@)(@@) % طلبتك حتى لم أجد لي مطلبا ، % وأقدمت حتى قل من يتقدم % 68(@)(@@) % % ولكن قضاء فاتني فيك مبرم ! % 69(@)(@@) % فإن جل هذا الأمر فالله فوقه ، % وإن عظم المطلوب فالله أعظم ! % 70(@)(@@) % وإني أخفي فيك ، ماليس خافيا % وأكتم وجدا ، مثله لا يكتم % 71(@)(@@) % ولو أنني وفيت رزءك حقه % لما خط لي كف ، ولا فاه لي فم ! % PageV01P321 البحر : وافر تام 1(@)(@@) % وراءك يا ' نمير ' ! فلا إمام % فقد حرم الجزيرة والشآم % 2(@)(@@) % لنا الدنيا ، فما شئنا حلال % لساكنها ، وما شئنا حرام % 3(@)(@@) % وينفذ أمرنا ، في كل حي ، % فيدنيه ويقصيه الكلام % 4(@)(@@) % أراجية خويلفة ذماما % وراءك ، لا أمان ولا ذمام ! % 5(@)(@@) % ألم تخبرك خيلك عن مقامي % % ببالس يوم ضاق بها المقام ! % 6(@)(@@) % وولت تتقي ، بعضا ببعض ، % لهم - والأرض واسعة - زحام % 7(@)(@@) % سروا والليل يجمعنا ، ولمن % يبوح بهم ، ويكتمنا الظلام % 8(@)(@@) % إلى أن صبحتهم بالمنايا % % كرائم ، فوق أظهرها كرام % 9(@)(@@) % من العرشات تلحق ما رأته % إذا طلبت ، وتعطى ما تسام % 10(@)(@@) % تنازع بي وبالفرسان حولي % % تجفلهم ، كما جفل النعام % PageV01P322 11(@)(@@) % بطحنا منهم ' مرج بن جحش ' % فلم يقفوا عليه ، ولم يحاموا 
ms71	 % % 12(@)(@@) % أقول لمطعم لما التقينا ، % وقد ولى وفي يدي الحسام % 13(@)(@@) % أتجعل بيننا عشرين كعبا % وتهرب ! سوءة لك يا غلام ! % 14(@)(@@) % أحلكم بدار الضيم ، قسرا ، % همام لا يضام ، ولا يرام ! % PageV01P323 البحر : بسيط تام 1(@)(@@) % أشدة ، ما أراه منك ، أم كرم ! % تجود بالنفس ، والأرواح تصطلم % 2(@)(@@) % يا باذل النفس والأموال مبتسما ، % أما يهولك لا موت ، ولا عدم ؟ ! % 3(@)(@@) % لقد ظننتك ، بين الجحفلين ، ترى % % أن السلامة ، من وقع القنا ، تصم % 4(@)(@@) % نشدتك الله ، لا تسمح بنفس علا ، % حياة صاحبها تحيا بها الأمم % 5(@)(@@) % هي الشجاعة إلا أنها سرف ، % وكل فضلك لا قصد ولا أمم % 6(@)(@@) % إذا لقيت رقاق البيض ، منفردا ، % تحت العجاجة لم تستكثر الخدم % 7(@)(@@) % تفدي بنفسك أقواما صنعتهم % وكان حقهم أن يفتدوك هم % 8(@)(@@) % ومن يقاتل من تلقى القتال به ، % وليس يفضل عنك الخيل والبهم % 9(@)(@@) % تضن بالحرب عنا ، ضن ذي بخل ، % ومنك ، في كل حال ، يعرف الكرم ! % 10(@)(@@) % لا تبخلن على قوم إذا قتلوا % % أثنى عليك بنو الهيجاء ، دونهم % PageV01P324 11(@)(@@) % ألبست ما لبسوا ، أركبت ما ركبوا % % عرفت ما عرفوا ، علمت ما علموا % % 12(@)(@@) % كما أريت ببيض ، أنت واهبها ، % على خيولك خاضوا البحر وهو دم % 13(@)(@@) % هم الفوارس ، في أيديهم أسل ، % فإن رأوك فأسد ، والقنا أجم % 14(@)(@@) % قالوا المسير ! فهز الرمح عامله ، % وارتاح في جفنه الصمصامة الخذم % 15(@)(@@) % فطالبتني بما ساء العداة ، وقد % عودتها ما تشاء الذئب والرخم % 16(@)(@@) % حقا ، لقد ساءني أمر ، ذكرت له ، % لولا فراقك لم يوجد له ألم % 17(@)(@@) % لا تشغلني بأمر ' الشام ' أحرسه % إن الشآم على من حله حرم % 18(@)(@@) % فإن للثغر سورا من مهابته ، % صخوره من أعادي أهله قمم % 19(@)(@@) % لا يحرمني ' سيف الدين ' صحبته % فهي الحياة التي تحيا بها النسم % 20(@)(@@) % و ماا عترضت عليه في أوامره % لكن سألت ، ومن عاداته ، نعم ! % PageV01P325 البحر : بسيط تام 1(@)(@@) % الدين مخترم ، والحق مهتضم ، % وفيء آل ' رسول الله ' مقتسم % 2(@)(@@) % والناس عندك لا ناس ، فيحفظهم % سوم الرعاة ، ولا شاء ، ولا نعم % 3(@)(@@) % إني أبيت قليل النوم ، أرقني % % قلب 
ms72	 ، تصارع فيه الهم والهمم ! % 4(@)(@@) % و عزمة ، لا ينام الليل صاحبها % % إلا على ظفر ، في طيه كرم % 5(@)(@@) % يصان مهري لأمر لا أبوح به ، % والدرع ، والرمح ، والصمصامة الخذم % 6(@)(@@) % وكل مائرة الضبعين ، مسرحها % % رمث الجزيرة ، والخذراف والغنم % 7(@)(@@) % و فتية ، قلبهم قلب إذا ركبوا % % يوما ؛ ورأيهم رأي إذا عزموا % % 8(@)(@@) % يا للرجال ! أما لله منتصف % من الطغاة ؟ أما للدين منتقم ؟ ! % 9(@)(@@) % ' بنو علي ' رعايا في ديارهم ، % والأمر تملكه النسوان ، والخدم ! % 10(@)(@@) % محلؤون ، فأصفى شربهم وشل ، % عند الورود ؛ وأوفى ودهم لمم % PageV01P326 11(@)(@@) % فالأرض ، إلا على ملاكها ، سعة ، % والمال ، إلا أربابه ، ديم % 12(@)(@@) % وما السعيد بها إلا الذي ظلموا ، % وما الغني بها إلا الذي حرموا % % 13(@)(@@) % للمتقين ، من الدنيا ، عواقبها % % وإن تعجل منها الظالم الأثم % 14(@)(@@) % لا يطغين ' بني العباس ' ملكهم ! % ' بنو علي ' مواليهم وإن زعموا % % 15(@)(@@) % أتفخرون عليهم ؟ - لا أبا لكم - % حتى كأن ' رسول الله ' جدكم % 16(@)(@@) % وما توازن ، يوما ، بينكم شرف ، % ولا تساوت بكم ، في موطن ، قدم % 17(@)(@@) % ولا لكم مثلهم ، في المجد ، متصل % ولا لجدكم مسعاة جدهم % 18(@)(@@) % ولا لعرقكم من عرقهم شبه % ولا ' نفيلتكم ' من أمهم أمم % 19(@)(@@) % قام النبي بها ' يوم الغدير ' لهم % والله يشهد ، والأملاك ، والأمم % 20(@)(@@) % حتى إذا أصبحت في غير صاحبها % % باتت تنازعها الذؤبان والرخم % PageV01P327 21(@)(@@) % وصيرت بينهن شورى كأنهم % لا يعرفون ولاة الحق أيهم ! % 22(@)(@@) % تالله ، ماجهل الأقوام موضعها % % لكنهم ستروا وجه الذي علموا % % 23(@)(@@) % ثم ادعاها بنو العباس إرثهم ، % و مالهم قدم ، فيها ، ولا قدم % 24(@)(@@) % لا يذكرون ، إذا ما معشر ذكروا ، % ولا يحكم ، في أمر ، لهم حكم % 25(@)(@@) % ولا رآهم ' أبو بكر ' وصاحبه % أهلا لما طلبوا منها ، وما زعموا % % 26(@)(@@) % فهل هم مدعوها غير واجبة % أم هل أئمتهم في أخذها ظلموا ؟ % 27(@)(@@) % أما ' علي ' فقد أدنى قرابتكم ، % عند الولاية ، إن لم تكفر النعم ! % 28(@)(@@) % هل جاحد ، يا ' بني العباس ' نعمته ! % أبوكم ، أم عبيد الله ، أم قثم ؟ % 29(@)(@@) % بئس الجزاء جزيتم في بني ' حسن ' ! % أباهم العلم الهادي وأمهم % 30(@)(@@) % لا بيعة ردعتكم 
ms73	 عن دمائهم ، % ولا يمين ، ولا قربى ، ولا ذمم % PageV01P328 31(@)(@@) % هلا صفحتم عن الأسرى بلا سبب ، % للصافحين ببدر عن أسيركم ؟ % 32(@)(@@) % هلا كففتم عن ' الديباج ' سوطكم ؟ % وعن بنات رسول الله شتمكم ؟ % 33(@)(@@) % ما نزهت لرسول الله مهجته % عن السياط ! فهلا نزه الحرم ؟ % 34(@)(@@) % ما نال منهم بنو حرب ، وإن عظمت % تلك الجرائر ، إلا دون نيلكم % 35(@)(@@) % كم غدرة لكم في الدين واضحة ! % وكم دم ل ' رسول الله ' عندكم ؟ ! % 36(@)(@@) % أأنتم آله فيما ترون ، وفي % % أظفاركم ، من بنيه الطاهرين ، دم ؟ % 37(@)(@@) % هيهات ! لاقربت قربى ، ولا رحم ، % يوما ، إذا أقصت الأخلاق والشيم ! % 38(@)(@@) % كانت مودة سلمان له رحما ، % ولم يكن بين نوح وابنه رحم ! % 39(@)(@@) % ياجاهدا في مساويهم يكتمها ! % غدر الرشيد ب ' يحيى ' كيف ينكتم ؟ % 40(@)(@@) % ليس الرشيد كموسى في القياس ولا % ' مأمونكم ك ' الرضا ' إن أنصف % PageV01P329 41(@)(@@) % ذاق الزبيري غب الحنث وانكشفت % عن ' ابن فاطمة ' الأقوال والتهم % 42(@)(@@) % باؤوا بقتل ' الرضا ' من بعد بيعته % وأبصروا بعض يوم رشدهم وعموا % % 43(@)(@@) % يا عصبة شقيت ، من بعدما سعدت ، % ومعشرا هلكوا من بعدما سلموا ! % 44(@)(@@) % لبئس ما لقيت منهم ، وإن بليت % بجانب ' الطف ' تلك الأعظم الرمم ! % 45(@)(@@) % لاعن ' أبي مسلم ' في نصحه صفحوا ، % ولا الهبيري نجى الحلف والقسم % 46(@)(@@) % ولاالأمان لأزد ' الموصل ' اعتمدوا % % فيه الوفاء ، ولاعن عمهم حلموا % % 47(@)(@@) % أبلغ لديك بني العباس مألكة : % لاتدعوا ملكها ! ملاكها العجم ! % 48(@)(@@) % أي المفاخر أمست في منابركم ، % وغيركم آمر فيهن ، محتكم ؟ % 49(@)(@@) % وهل يزيدكم من مفخر علم ، % وفي الخلاف ، عليكم يخفق العلم ؟ % 51(@)(@@) % خلوا الفخار لعلامين ، إن سئلوا % % يوم السؤال ، وعمالين إن علموا % % PageV01P330 52(@)(@@) % لايغضبون لغيرالله ، إن غضبوا ، % ولا يضيعون حكم الله إن حكموا % % 53(@)(@@) % تبدوا التلاوة من أبياتهم ، أبدا ، % وفي بيوتكم الأوتار ، والنغم % 57(@)(@@) % مافي ديارهم للخمر معتصر ؛ % ولا بيوتهم للسوء معتصم % 58(@)(@@) % و لا تبيت لهم خنثى ، تنادمهم ؛ % و لا يرى لهم قرد ، له حشم % 59(@)(@@) % الركن ، والبيت ، والأستار منزلهم ، % وزمزم ، والصفا ، والحجر ، والحرم % 61(@)(@@) % صلى الإله عليهم ، أينما ذكروا ، % لأنهم للورى كهف ، ومعتصم % PageV01P331 البحر : مخلع 
ms74	 البسيط 1(@)(@@) % أللوم للعاشقين لوم ، % لأن خطب الهوى عظيم % 2(@)(@@) % فكيف ترجون لي سلوا % وعندي المقعد المقيم ؟ % 3(@)(@@) % و مقلتي ، ملؤها دموع ؛ % وأضلعي ، حشوها كلوم ! % 4(@)(@@) % يا قوم ! إني امرؤ كتوم ، % تصحبني مقلة نموم % 5(@)(@@) % ألليل للعاشقين ستر ، % يا ليت أوقاته تدوم ! % 6(@)(@@) % نديمي النجم ، طول ليلي ، % حتى إذا غارت النجوم % 7(@)(@@) % أسلمني الصبح للبلايا ، % فلا حبيب ، ولا نديم % 8(@)(@@) % ب ' رملتي عالج ' رسوم ، % يطول من دونها الرسيم ! % 9(@)(@@) % أنخت فيهن يعملات ، % ما عهد إرقالها ذميم ! % 10(@)(@@) % آجدها قطع كل واد ، % أخصبه نبته العميم % PageV01P332 11(@)(@@) % ردت على الدهر ، في سراها ، % ما وهب النجم ، والنجوم ! % 12(@)(@@) % تلك سجايا من الليالي ، % للبؤس ما يخلق النعيم % 13(@)(@@) % بين ضلوعي هوى مقيم % لآل ' ورقاء ' لا يريم % 14(@)(@@) % يغير الدهر كل شيء ، % و هو صحيح لهم ، سليم ! % 15(@)(@@) % أمنع من رامه سواهم % منه ، كما تمنع الحريم % 16(@)(@@) % وهل يساويهم قريب ؟ % أم هل يدانيهم حميم ؟ % 17(@)(@@) % و نحن في عصبة وأهل ، % تضم أغصاننا أروم % 18(@)(@@) % لم تتفرق بنا خؤول ، % في جذم عز ، ولا عموم ! % 19(@)(@@) % سمت بنا وائل ، وفازت % بالعز أخوالنا ' تميم ' ! % 20(@)(@@) % ودادهم خالص ، صحيح ، % وعهدهم ثابت ، مقيم ! % PageV01P333 21(@)(@@) % فذاك منهم بنا حديث ، % وهو لآبائنا قديم % 22(@)(@@) % نرعاه ، ما طرقت بحمل % أنثى ، وما أطفلت بغوم % 23(@)(@@) % ندني بني عمنا إلينا ، % فضلا ، كما يفعل الكريم % 24(@)(@@) % أيد لهم ، عند كل خطب ، % يثني بها الفادح الجسيم ! % 25(@)(@@) % وألسن ، دونهم ، حداد % لد إذا قامت الخصوم % 26(@)(@@) % لم تنأ ، عنا ، لهم قلوب ، % وإن نأت منهم ، جسوم % 27(@)(@@) % فلا عدمنا لهم ثناء ، % كأنه اللؤلؤ النظيم % 28(@)(@@) % لقد نمتنا لهم أصول ، % ما مس أعراقهن لوم % 29(@)(@@) % تبقى ويبقون في نعيم % ما بقي الركن ، والحطيم ! % PageV01P334 البحر : سريع 1(@)(@@) % لما تبينت بأني له % أزداد حبا ، كلما لاموا ، % 2(@)(@@) % وددت إذ ذاك ، بأن الورى % % فيك ، مدى الأيام ، لوام % PageV01P335 البحر : طويل 1(@)(@@) % أما إنه ربع الصبا ومعالمه % فلا عذر إن لم ينفذ الدمع ساجمه % 2(@)(@@) % لئن بت تبكيه خلاء فطالما % % نعمت به ، دهرا ، وفيه نواعمه 
ms75	 % 3(@)(@@) % رياح عفته ، وهي أنفاس عاشق % ووبل سقاه ، والجفون غمائمه % 4(@)(@@) % وظلامة ، قلدتها حكم مهجتي ، % ومن ينصف المظلوم والخصم حاكمه ؟ % 5(@)(@@) % مهاة ، لها من كل وجه مصونه ، % وخود لها من كل دمع كرائمه % 6(@)(@@) % وليل كفرعيها قطعت وصاحبي % % رقيق غرار ، مخذم الحد صارمه % 7(@)(@@) % تغذ بي القفر الفضاء شملة % سواء عليها نجده وتهائمه % 8(@)(@@) % تصاحبني آرامه وظباؤه ، % وتؤنسني أصلاله وأراقمه % 9(@)(@@) % وأي بلاد الله لم أنتقل بها ! % ولا وطئتها من بعيري مناسمه ! % 10(@)(@@) % ونحن أناس ، يعلم الله أننا ، % وخود لها من كل دمع كرائمه % PageV01P336 11(@)(@@) % إذا ولد المولود منا فإنما ال % وتؤنسني أصلاله وأراقمه % 12(@)(@@) % إلا مبلغ عني ، ابن عمي ، رسالة % بثثت بها بعض الذي أنا كاتمه % 13(@)(@@) % أيا جافيا ! ما كنت أخشى جفاؤه % وإن كثرت عذاله ، ولوائمه % 14(@)(@@) % كذلك حظي من زماني وأهله % يصارمني الخل الذي لا أصارمه % 15(@)(@@) % وإن كنت مشتاقا إليك فإنه % ليشتاق صب إلفه ، وهو ظالمه % 16(@)(@@) % أودك ودا ، لا الزمان يبيده ، % ولا النأي يفنيه ، ولا الهجر ثالمه % 17(@)(@@) % وأنت وفي لا يذم وفاؤه ، % وأنت كريم ليس تحصى مكارمه % 18(@)(@@) % أقيم به أصل الفخار وفرعه ، % وشد به ركن العلا ، ودعائمه % 19(@)(@@) % أخو السيف تعديه نداوة كفه % فيحمر خداه ، ويخضر قائمه % 20(@)(@@) % أعندك لي عتبى فأحمل ما مضى % % وأبني رواق الود ، إذ أنت هادمه % PageV01P337 البحر : مجزوء الرمل 1(@)(@@) % أيها الغازي ، الذي يغ % زو بجيش الحب جسمي ! % 2(@)(@@) % ما يقوم الأجر في غز % % وك للروم بإثمي ! % 4(@)(@@) % كم ليلة شهباء ، إذ برزت لنا ، % سقتك الغوادي من متون الغمائم % 9(@)(@@) % من ثغرها في جنح ليل مظلم % % 27(@)(@@) % كتمت هواي وقابلته بهجرة ، % في جمرها المتلهب المتضرم % PageV01P338 البحر : كامل تام 1(@)(@@) % و أديبة إخترتها عربية % تعزى إلى الجد الكريم ، وتنتمي % % 2(@)(@@) % محجوبة لم تبتذل ، أمارة % لم تأتمر ، مخدومة لم تخدم % 3(@)(@@) % لو لم يكن لي فيك إلا أنني % % بك قد غنيت عن ارتكاب المحرم % 4(@)(@@) % و لقد نزلت فلا تظني غيره % مني بمنزلة المحب المكرم % PageV01P339 البحر : وافر تام 1(@)(@@) % تسمع ، في 
ms76	 بيوت بني كلاب ، % بني البنا تنوح على تميم % 2(@)(@@) % بكرهي إن حملت بني أبيه % وأسرته على النأي العظيم % 3(@)(@@) % رجعت ، وقد ملكتهم جميعا ، % إلى الأعراق والأصل الكريم % PageV01P340 البحر : وافر تام 1(@)(@@) % يعز على الأحبة ، ب ' الشام ' ، % حبيب ، بات ممنوع المنام % 4(@)(@@) % وإني للصبور على الرزايا ، % ولكن الكلام على الكلام % 5(@)(@@) % جروح لا يزلن يردن مني % % على جرح قريب العهد ، دام % 8(@)(@@) % تاملني ' الدمستق ' إذ رآني ، % فأبصر صيغة الليث ، الهمام % 9(@)(@@) % أتنكرني كأنك لست تدري % % بأني ذلك البطل ، المحامي % % 10(@)(@@) % وأني إذ نزلت على دلوك ، % تركتك غير متصل النظام % 11(@)(@@) % ولما أن عددت صليب رأيي % % تحلل عقد رأيك في المقام % 12(@)(@@) % وكنت ترى الأناة ، وتدعيها ، % فأعجلك الطعان عن الكلام % 13(@)(@@) % و بت مؤرقا ، من غير سهد ، % حمى جفنيك طيب النوم حام % 14(@)(@@) % و لا أرضى الفتى ما لم يكمل ، % برأي الكهل ، إقدام الغلام % PageV01P341 15(@)(@@) % فلا هنئتها نعمى بأسري ، % ولا وصلت سعودك بالتمام % 16(@)(@@) % أما من أعجب الأشياء علج ، % يعرفني الحلال من الحرام % 17(@)(@@) % و تكنفه بطارقة تيوس ، % تباري بالعثانين الضخام % 18(@)(@@) % لهم خلق الحمير فلست تلقى % % فتى منهم يسير بلا حزام % 19(@)(@@) % يريغون العيوب ، وأعجزتهم ، % وأي العيب يوجد في الحسام ! ؟ % 20(@)(@@) % و أصعب خطة ، وأجل أمر % مجالسة اللئام على الكرام % 22(@)(@@) % أبيت مبرأ من كل عيب ، % و أصبح ، سالما من كل ذام % 24(@)(@@) % ومن لقي الذي لاقيت هانت % عليه موارد الموت الزؤام % 25(@)(@@) % ثناء طيب ، لا خلف فيه ، % وآثار كآثار الغمام % 26(@)(@@) % و علم فوارس الحيين أني % % قليل من يقوم لهم مقامي % % PageV01P342 27(@)(@@) % وفي طلب الثناء مضى بجير % وجاد بنفسه كعب بن مام % 28(@)(@@) % ألام على التعرض للمنايا ، % ولي سمع أصم عن الملام % 31(@)(@@) % بنو الدنيا إذا ماتوا سواء % ولو عمر المعمر ألف عام % 33(@)(@@) % إذا ما لاح لي لمعان برق % بعثت إلى الأحبة بالسلام % PageV01P343 البحر : خفيف تام 1(@)(@@) % لست بالمستضيم من هو دوني ، % اعتداء ، ولست بالمستضام % 2(@)(@@) % أبذل الحق للخصوم ، إذا ما % % عجزت عنه قدرة الحكام % 3(@)(@@) % لا تخطى إلى 
ms77	 المظالم كفي ، % حذرا من أصابع الأيتام % PageV01P344 البحر : خفيف تام 1(@)(@@) % ودعوا ، خشية الرقيب ، بإيما % % ء ، فودعت ، خشية اللوام % 2(@)(@@) % لم أبح بالوداع ، جهرا ولكن % كان جفني فمي ، ودمعي كلامي ! % PageV01P345 البحر : سريع 1(@)(@@) % أيا معافي من رسيس الهوى ! % يهنيك حال السالم الغانم % 2(@)(@@) % أعانك الله بخير ، أما % % تكون لي عونا على الظالم ؟ ! % PageV01P346 البحر : كامل تام 1(@)(@@) % و خريدة ، كرمت على آبائها ؛ % وعلى بوادر خيلنا لم تكرم % 2(@)(@@) % خطبت بحد السيف حتى زوجت % كرها ، وكان صداقها للمقسم % 3(@)(@@) % راحت وصاحبها بعرس حاضر ، % يرضي الآله ، وأهلها في مأتم % PageV01P347 البحر : وافر تام 1(@)(@@) % لنا بيت ، على عنق الثريا ، % بعيد مذاهب الأطناب ، سام % 2(@)(@@) % تظلله الفوارس بالعوالي ، % وتفرشه الولائد بالطعام % PageV01P348 البحر : مجزوء الكامل 1(@)(@@) % يا من رضيت بفرط ظلمه % ودخلت ، طوعا ، تحت حكمه % 2(@)(@@) % ألله يعلم ما لقي % % ت من الهوى ، وكفى بعلمه ! % 3(@)(@@) % هب للمقر بذنبه ! % واصفح له عن عظم جرمه % 4(@)(@@) % إني أعيذك أن تبو % % ء بقتله ، وبحمل إثمه % PageV01P349 البحر : كامل تام 1(@)(@@) % هبه أساء ، كما زعمت ، فهب له % % وارحم تضرعه ، وذل مقامه ! % 2(@)(@@) % بالله ، ربك ، لم فتكت بصبره % ونصرت بالهجران جيش سقامه ؟ % 3(@)(@@) % فرقت بين جفونه ومنامه % وجمعت بين نحوله وعظامه % PageV01P350 البحر : بسيط تام 1(@)(@@) % إذا مررت بواد ، جاش غاربه % فاعقل قلوصك وانزل ، ذاك وادينا % % 2(@)(@@) % وإن عبرت بناد لا تطيف به % أهل السفاهة ، فاجلس ، ذاك نادينا ! % 3(@)(@@) % نغير في الهجمة الغراء ننحرها % % حتى ليعطش ، في الأحيان ، راعينا % % 4(@)(@@) % و تجفل الشول بعد الخمس صادية % إذا سمعن على الأمواه حادينا % % 5(@)(@@) % و نفتدي الكوم أشتاتا مروعة % لا تأمن الدهر إلا من أعادينا % % 6(@)(@@) % ويصبح الضيف أولانا بمنزلنا ، % نرضى بذاك ، ويمضي حكمه فينا % % PageV01P351 البحر : كامل تام 1(@)(@@) % و كنى الرسول عن الجواب تظرفا % ولئن كنى ، فلقد علمنا ما عنى % % 2(@)(@@) % قل يا رسول ، ولا تحاش ! فإنه % لا بد منه أساء بي أم أحسنا ! % 3(@)(@@) % ألذنب لي فيما جناه ، لأنني % % مكنته من مهجتي فتمكنا % % PageV01P352 البحر : طويل 1(@)(@@) % ويغتابني من لو كفاني غيبه % لكنت له 
ms78	 العين البصيرة والأذنا % % 2(@)(@@) % و عندي من الأخبار ما لو ذكرته % إذا قرع المغتاب من ندم سنا % % PageV01P353 البحر : مجزوء الرمل 1(@)(@@) % اطرحوا الأمر إلينا ، % و احملوا الكل علينا % % 2(@)(@@) % إننا قوم ، إذا ما % % صعب الأمر ، كفينا % % 3(@)(@@) % و إذا ما ريم منا % % موطن الذل أبينا % % 4(@)(@@) % وإذا ما هدم ال % عز بنو العز بنينا % % PageV01P354 البحر : وافر تام 1(@)(@@) % يعيب علي أن سميت نفسي % % وقد أخذ القنا منهم ومنا % % 2(@)(@@) % فقل للعلج : لو لم أسم نفسي % % لسماني السنان لهم وكنى % % PageV01P355 البحر : خفيف تام 1(@)(@@) % قد أعانتني الحمية لما % % لم أجد من عشيرتي أعوانا % % 2(@)(@@) % لا أحب الجميل من سر مولى % لم يدع ما كرهته إعلانا % % 3(@)(@@) % إن يكن صادق الوداد فهلا % ترك الهجر للوصال مكانا ! ؟ % PageV01P356 البحر : وافر تام 1(@)(@@) % فإن أهلك فعن أجل مسمى سلي فتيات هذا الحي عني % % يقلن بما رأين وما سمعنه % 2(@)(@@) % ألست أمدهم ، لذوي ، ظلا ، % ألست أعدهم ، للقوم ، جفنه % 3(@)(@@) % ألست أقرهم بالضيف ، عينا % ألست أمرهم ، في الحرب لهنه % 5(@)(@@) % رضيت العاذلات ، وما يقلنه ، % وإن أصبحت عصاء لهنه % 6(@)(@@) % و كم فجر سبقن إلى ملامي % % فعدت ضحى ولم أحفل بهنه % 7(@)(@@) % وراجعة إلي ، تقول سرا : % أعود إلى نصيحته لعنه % 8(@)(@@) % فلما لم تجد طمعا تولت ، % وقالت في ، عاتبة وقلنه % 9(@)(@@) % أريتك ما تقول بنات عمي % % إذا وصف النساء رجالهنه % 10(@)(@@) % أما والله لا يمسين ، حسرى ، % يلفقن الكلام ، ويعتذرنه % 11(@)(@@) % و لكن سوف أوجدهن وصفا % و أبسط في المديح كلامهنه % PageV01P357 12(@)(@@) % متى ما يدن من أجل كتابي % % أمت ، بين الأعنة والأسنه % PageV01P358 البحر : وافر تام 1(@)(@@) % بكرن يلمنني ، ورأين جودي % % على الأرماح بالنفس المضنه % 2(@)(@@) % فقلت لهن : هل فيكن باق % على نوب الزمان ، إذا طرقنه ؟ % 3(@)(@@) % و إن يكن الحذار من المنايا % % سبيلا للحياة ، فلم تمتنه ؟ % 4(@)(@@) % سأشهدها على ما كان مني % % ببسطي في الندى ، بكلامهنه % 5(@)(@@) % و أجعلكن أصدق في قولا % إذا وصف النساء رجالهنه % 6(@)(@@) % فإن أهلك فعن أجل مسمى % % سيأتيني ، ولو ما بينكنه % 7(@)(@@) % و إن 
ms79	 أسلم فقرض سوف يوفى ، % و أتبعكن إن قدمتكنه % 8(@)(@@) % فلا يأمرنني بمقام ذل % فما أنا بالمطيع إذا أمرنه % 9(@)(@@) % وموت في مقام العز أشهى ، % إلى الفرسان ، من عيش بمهنه % PageV01P359 البحر : بسيط تام 1(@)(@@) % يا من رجعت ، على كره ، لطاعته ، % قد خالف القلب لما طاوع البدن % 2(@)(@@) % وكل ما شئت من أمر رضيت به ، % وكل ما اخترته ، عندي هو الحسن % 3(@)(@@) % وكلما سرني أو ساءني سبب % فأنت فيه علي ، الدهر ، مؤتمن % PageV01P360 البحر : طويل 1(@)(@@) % وإني لأنوي هجره فيردني وإني لأنوي هجره فيردني % % هوى ، بين أثناء الضلوع ، دفين % 2(@)(@@) % فيغلظ قلبي ، ساعة ثم ينثني % % وأقسو عليه ، تارة ، ويلين % 3(@)(@@) % وقد كان لي عن وده كل مذهب ، % و لكن مثلي بالإخاء ضنين % 4(@)(@@) % و لا غرو أن أعنو له ، بعد عزة ، % فقدري ، في عز الحبيب ، يهون ! % PageV01P361 البحر : طويل 1(@)(@@) % بخلت بنفسي أن يقال مبخل ، % وأقدمت جبنا أن يقال جبان % 2(@)(@@) % وملكي بقايا ما وهبت : مفاضة ، % % PageV01P362 البحر : طويل 1(@)(@@) % أيا راكبا ، نحو الجزيرة ، جسرة % عذافرة ، إن الحديث شجون ! % 2(@)(@@) % من الموخدات الضمر اللاء وخدها % % كفيل بحاجات الرجال ضمين % 3(@)(@@) % تحمل إلى ' القاضي ' سلامي وقل له : % ألا إن قلبي ، مذ حزنت ، حزين % 4(@)(@@) % و إن فؤادي ، لافتقاد أسيره ، % أسير ، بأيدي الحادثات ، رهين % 5(@)(@@) % أحاول كتمان الذي بي من الأسى % % وتأبى غروب ثرة وشؤون % 6(@)(@@) % بمن أنا في الدنيا على السر واثق ، % و طرفي نموم ، والدموع تخون % 7(@)(@@) % يضن زماني بالثقات ؛ وإنني % % بسري ، على غير الثقات ، ضنين % 8(@)(@@) % لعل زمانا بالمسرة ينثني ؛ % وعطفة دهر باللقاء تكون % 9(@)(@@) % ألا لا يرى الأعداء فيك غضاضة ، % فللدهر بؤس ، قد علمت ، ولين % 10(@)(@@) % و أعظم ما كانت همومك تنجلي ، % وأصعب ما كان الزمان يهون % PageV01P363 11(@)(@@) % ألا ليت شعري هل أنا الدهر ، واجد % قرينا ، له حسن الوفاء قرين ؟ % 12(@)(@@) % فأشكو ويشكو ما بقلبي وقلبه ، % كلانا ، على نجوى أخيه ، أمين % 13(@)(@@) % و في بعض من يلقي إليك مودة % عدو ، إذا كشفت عنه ، مبين % 14(@)(@@) % إذا غير البعد الهوى فهوى أبي % % حصين منيع 
ms80	 ، في الفؤاد ، حصين % 15(@)(@@) % فلا برحت بالحاسدين كآبة ، % ولا هجعت للشامتين عيون % PageV01P364 البحر : مجزوء الكامل 1(@)(@@) % أشفقت من هجري فغل % % بت الظنون على اليقين % 2(@)(@@) % وضننت بي ، فظننت بي ، % و الظن من شيم الضنين ! % PageV01P365 البحر : مخلع البسيط 1(@)(@@) % لطيرتي بالصداع نالت % فوق منال الصداع مني % % 2(@)(@@) % و جدت فيه اتفاق سوء % صدعني مثل صد عني % % PageV01P366 البحر : كامل تام 1(@)(@@) % الحر يصبر ، ما أطاق تصبرا % في كل آونة وكل زمان % 2(@)(@@) % ويرى مساعدة الكرام مروءة ، % ما سالمته نوائب الحدثان % 3(@)(@@) % ويذوب بالكتمان إلا أنه % أحواله تنبي عن الكتمان % 4(@)(@@) % فإذا تكشف ، واضمحلت حاله % ألفيته يشكو بكل لسان % 6(@)(@@) % وإذا نبا بي منزل فارقته ؛ % والله يلطف بي بكل مكان % PageV01P367 البحر : مجزوء الكامل 1(@)(@@) % لا غرو إن فتنتك بال % لحظات فاترة الجفون % 2(@)(@@) % فمصارع العشاق ما % % بين الفتور إلى الفتون % 3(@)(@@) % اصبر ! فمن سنن الهوى % % صبر الظنين على الظنين % PageV01P368 البحر : سريع 1(@)(@@) % علي من عيني عينان % تبوح للناس بكتمان % 2(@)(@@) % يا ظالمي ، للشرب سكر ولي % % من غنج ألحاظك سكران % 3(@)(@@) % وجهك والبدر ، إذا أبرزا ، % لأعين العالم ، بدران % PageV01P369 البحر : متقارب تام 1(@)(@@) % أنافس فيك بعلق ثمين ، % ويغلبني فيك ظن الظنين % 3(@)(@@) % وكنت حلفت على غضبة % فعدت ، وكفرت عنها يميني % % PageV01P370 البحر : متقارب تام 1(@)(@@) % حللت من المجد أعلى مكان ، % وبلغك الله أقصى الأماني % % 2(@)(@@) % فإنك ، لا عدمتك العلا ، % أخ لا كإخوة هذا الزمان % 3(@)(@@) % صفاؤك في البعد مثل الدنو ، % وودك في القلب مثل اللسان % 4(@)(@@) % كسونا أخوتنا بالصفاء % كما كسيت بالكلام المعاني % % PageV01P371 البحر : بسيط تام 1(@)(@@) % ما كنت مذ كنت إلا طوع خلاني ، % ليست مؤاخذة الإخوان من شاني % % 2(@)(@@) % يجني الخليل ، فأستحلي جنايته % حتى أدل على عفوي وإحساني % % 3(@)(@@) % ويتبع الذنب ذنبا حين يعرفني % % عمدا ، وأتبع غفرانا بغفران % 4(@)(@@) % يجني علي وأحنو ، صافحا أبدا ، % لا شيء أحسن من حان على جان % PageV01P372 البحر : بسيط تام 1(@)(@@) % بني زرارة لو صحت طرائقكم % لكنتم عندنا في المنزل الداني % % 2(@)(@@) % لكن جهلتهم لدينا حق أنفسكم ، % وباع بائعكم ربحا بخسران 