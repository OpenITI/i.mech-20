ms101	 حكمت أن يسحب الساحب % 59(@)(@@) % تقتص من واترها صرعة % ليس لها باك ولا نادب % 60(@)(@@) % إلا حمام الأيك في أيكه % أو عازف للشرب أو قاصب % PageV01P413 61(@)(@@) % ذات نسيم مسكه فائح % وذات لون ورسه خاضب % 62(@)(@@) % هاتيك هاتيك على مثلها % % حام ولاب الحائم اللائب % 63(@)(@@) % والنقل والريحان من شأنهم % % فلا يعب فقدها عائب % 64(@)(@@) % ولا تنم عن نرجس مؤنس % يضحك عنه الزمن القاطب % 65(@)(@@) % ريحان روح منهب عطره % % والروح إذ ذاك هو الناهب % 66(@)(@@) % لم يلفح الصيف له صفحة % ولا سقاه عوده الشاسب % 67(@)(@@) % قد ناصب الورد فمن قوله % لا يلتقي الشيعي والناصب % 68(@)(@@) % وزخرف البيت كما زخرفت % روضة حزن جادها هاضب % 69(@)(@@) % واجلب لهم حسناء في شدوها % % لكل ما سرهم جالب % 70(@)(@@) % محسنة ليست بخطاءة % % طائرها الهادل لا الناعب % PageV01P414 71(@)(@@) % بيضاء خودا ردفها ناهد % غيداء رودا ثديها كاعب % 72(@)(@@) % مملوكة بالسيف مغصوبة % لها دلال مالك غاصب % 73(@)(@@) % تستوهب الجيد إذا أتلعت % من ظبية أفزعها طالب % 74(@)(@@) % كأن من عولج من سحرها % % زجاجة يشعبها شاعب % 75(@)(@@) % نعيم من نادمها دائم % وبرح من فارقها واصب % 76(@)(@@) % كأنها والبيت مستضحك % والعود في قبضتها صاخب % 77(@)(@@) % أدمانة تنزب في روضة % جاوبها خشف لها نازب % 78(@)(@@) % واصبب عليهم تحفا جمة % يحمى بهن الموعد الكاذب % 79(@)(@@) % ولا يكن فيما يعانى لهم % % ضيق ولا ما يخشب الخاشب % 80(@)(@@) % فما رأينا مرتعا مجدبا % إلا وفيه راتع جادب % PageV01P415 81(@)(@@) % واغرم لهم من بعد ذا كله % % ما نفل الملاح والقارب % 82(@)(@@) % وتب من الذنب الذي جئته % فقد يقال المذنب التائب % 83(@)(@@) % كيما يقولوا حين ترضيهم % يا حبذا المنهزم التائب % 84(@)(@@) % وإن رجوا أخرى فمن قولهم % % أفلح هذا الغائب الآئب % 85(@)(@@) % أعتب بيوم صالح فيهم % ليس على أمثاله عاتب % 86(@)(@@) % ولا يكن يوما إذا ما انقضى % % صيح به لا رجع الذاهب % 87(@)(@@) % إلا يكن ذاك لهم واجبا % فإن تطفيلهم واجب % 88(@)(@@) % عجل لهم ذاك ولا تهجهم % % ولا يثب منك بهم واثب % 89(@)(@@) % فليس من يأدب إخوانه % مؤدبا للقوم بل آدب % 90 
ms102	(@)(@@) % أخلفنا نوؤك موعده % فلا تصبنا ريحك الحاصب % PageV01P416 91(@)(@@) % حاشاك أن يلقاك مستمطر % % ومزنك الصاعق لا الصائب % 92(@)(@@) % أو فادعهم ثم اهجهم راشدا % وأنت أنت الجابر الحارب % 93(@)(@@) % كي يذكروا من مأرب معهدا % إن غرقت في سيلها مأرب % 94(@)(@@) % دع عنك خبط الجور في أمرنا % % فقد أضاء السنن اللاحب % % 95(@)(@@) % لا تطعمنا لحمك المتقى % % فليس مما يأكل الساغب % 96(@)(@@) % وكيف أكل الناس لحم امرىء % % مقوله صمصامة قاضب % 97(@)(@@) % واعلم بأن الناس من طينة % يصدق في الثلب لها الثالب % 98(@)(@@) % لولا علاج الناس أخلاقهم % % إذا لفاح الجمأ اللازب % 99(@)(@@) % ومن غدا مثلك في مجده % % حمل ما لا يحمل الصاقب % 100(@)(@@) % فقاتل الشح بجند الندى % % ينصر عليه إلبك الآلب % % PageV01P417 101(@)(@@) % واغرم حطاما واغتنم سمعة % فالزاد ماض والثنا راتب % 102(@)(@@) % هذا مزاح يا أخي كله % لشانئيك الشجب الشاجب % 103(@)(@@) % فاستصلح المال فمن دونه % أسد عليها الأشب الآشب % 104(@)(@@) % إن الإخاء المصطفى بيننا % % ليس له من غيره شائب % 105(@)(@@) % أقسمت والحق له فضله % إذا التقى المحتج والشاغب % 106(@)(@@) % إنك مما يجتني المجتني % % ولست مما يحطب الحاطب % 107(@)(@@) % فاعمر من النعماء في دولة % منصورة ليس لها قالب % PageV01P418 البحر : - 1(@)(@@) % إذا ما كساك الله سربال صحة % ولم تخل من قوت يحل ويعذب % 2(@)(@@) % فلا تغبطن المترفين فإنهم % % على حسب ما يكسوهم الدهر يسلب % PageV01P419 البحر : - 1(@)(@@) % رأيتك شبهت الضمير وحفظه % حسائكه بالحوض في حفظه الشربا % % 2(@)(@@) % وقرضت منه أن يصادف حفظه % كحفظ حياض المورد الملح والعذبا % % 3(@)(@@) % ألا كان كالغربال ينفي زؤانه % وما كان من قصرى ويحتبس الحبا % % 4(@)(@@) % ألا كان مثل القدر تنفي غثاءها % % وتقنى عراق اللحم والمرق العذبا % % PageV01P420 البحر : - 1(@)(@@) % وقتك يد الإله أبا علي % ولا جنحت بساحتك الخطوب % 2(@)(@@) % وزحزحت المكاره عنك طرا % ونفست الشدائد والكروب % 3(@)(@@) % شركتك في البلاء المر حتى % % لكاد القلب من ألم يذوب % 4(@)(@@) % ولم أمنن بذاك وكيف مني % % على من عرفه عندي ضروب % 5(@)(@@) % ولكني شكوت إليك شكوى % % أخي كرب تضيق بها الجنوب % 6(@)(@@) % وكيف الصبر والقاضي وقيذ % % أبى لي 
ms103	 ذلك الجزع الغلوب % 7(@)(@@) % تطرقت النوائب منه شخصا % بعيدا أن تطرقه العيوب % 8(@)(@@) % ولكن في دفاع الله كاف % وإن شبت لنائرة حروب % 9(@)(@@) % وفي المعروف واقية لشاك % وللسراء غائبة تؤوب % 10(@)(@@) % وقد يخفي ضياء الشمس دجن % تزول ولم يحن منها غروب % PageV01P421 11(@)(@@) % فقل للحاكم العدل القضايا % % فداه من يجور ومن يحوب % 12(@)(@@) % أبا إسحاق محقت الخطايا % % بما تشكو ومحصت الذنوب % 13(@)(@@) % ولقيت الإفالة من قريب % موقى كل نائبة تنوب % 14(@)(@@) % فإنك ما اعتللت بل المعالي % % وإنك ما مرضت بل القلوب % 15(@)(@@) % وحقك أن تقال فأنت آس % له رفق إذا دميت ندوب % 16(@)(@@) % تصيب إذا حكمت وإن طلبنا % % لديك العرف كنت حيا تصوب % 17(@)(@@) % هنيئا آل حماد هنيئا % فقد زكت الشواهد والغيوب % 18(@)(@@) % متى توضع جنوبكم بشكو % فما فيكم لنازلة هيوب % 19(@)(@@) % وإن ترفع جنوبكم ببرء % فما فيكم لفاحشة ركوب % 20(@)(@@) % وليس على صريع الله بأس % إذا مهدت مصارعها الجنوب % PageV01P422 21(@)(@@) % وليس على نقيذ الله عتب % وفيه عن محارمه نكوب % 22(@)(@@) % أحبكم وأشكر أن صفوتم % علي وسائر الدنيا مشوب % 23(@)(@@) % نسيمي منكم أبدا شمال % وريحي حين أستسقي جنوب % % 24(@)(@@) % ولا يلفى بساحتكم شقي % ولا يغرى بمدحكم كذوب % PageV01P423 البحر : - 1(@)(@@) % ما أنس لا أنس هندا آخر الحقب % على اختلاف صروف الدهر والعقب % 2(@)(@@) % يوم انتحتني بسهميها مسالمة % تأتي جديداتها من أوجه اللعب % 3(@)(@@) % وعيرتني بشيب الرأس ضاحكة % من ضاحك فيه أبكاني وأضحك بي % % 4(@)(@@) % قد كنت تسقين خدي مرة وفمي % % يا هند من وشل طورا ومن ثغب % 5(@)(@@) % يعل ريقك أنيابي وآونة % يستن دمعك في خدي كالسرب % 6(@)(@@) % فالآن أهزأ بي شيبي وأوبقني % % عيبي وإن كنت لم أوبق ولم أعب % 7(@)(@@) % بالجلد أنداب دهر لست أنكرها % % وما بعرضي لعمر الله من ندب % 8(@)(@@) % يا ظبية من ظباء كان مكنسها % % في ظل ذي ثمر مني وذي هدب % 9(@)(@@) % فيئي إليك فقد هبت مصوحة % أضحى لها مجتني لهو كمحتطب % 10(@)(@@) % سن بنتني وعادت بعد تهدمني % % حتى رزحت رزوح العودذي الجلب % PageV01P424 11(@)(@@) % وأعدت الرأس لوني 
ms104	 دهره فغدا % % قد حال عن دهمة كانت إلى شهب % 12(@)(@@) % والدهر يبلي الفتى من حيث ينشئه % حتى تكر عليه ليلة القرب % 13(@)(@@) % يغذوه في كل أني وهو يأكله % % ويحتسي نغبا منه على نغب % 14(@)(@@) % يودي بحال فحال من شبيبته % % تسرب الماء من مستأنف الكتب % 15(@)(@@) % بيناه كالأجدل الغطريف ماطله % عصراه فارتد مثل الفرخ ذي الزغب % 16(@)(@@) % أعجب بآمن دهر وهو مبترك % يعريه من ورق طورا ومن نجب % 17(@)(@@) % حسب امرىء من جنى دهر تطاوله % وإن أجم فلم ينكب ولم ينب % 18(@)(@@) % في هدنة الدهر كاف من وقائعه % والعمر أفدح مبراة من الوصب % 19(@)(@@) % قضيت ذلك من قولي إلى فنق % تلهو بمكتحل طورا ومختضب % 20(@)(@@) % حوراء في وطف قنواه في ذلف % لفاء في هيف عجزاء في قبب % PageV01P425 21(@)(@@) % كالشمس ما سفرت والبدر ما انتقبت % ناهيك من مسفر حسنا ومنتقب % 22(@)(@@) % جاءت تدافع في وشي لها حسن % تدافع الماء في وشي من الحبب % 23(@)(@@) % فأعرضت حلوة الإعراض مرته % بزفرة كنسيم الروض ذي الربب % 24(@)(@@) % تأسى على عهدي الماضي ويذهلها % % تفوق العيش لا الأحلاب في العلب % 25(@)(@@) % يا ذا الشباب الذي أضحت مناسبه % قد بدلت فيه أنواعا من الندب % 26(@)(@@) % مهلا فقد عاد ذاك الشرخ واقتربت % % من مجتنيها الأماني كل مقترب % 27(@)(@@) % بآل وهب غدت دنيا زمانهم % منضورة وتغنت بعد منتحب % 28(@)(@@) % وعادت الأرض إذ عمت مصالحهم % % دار اصطلاح وكانت دار محترب % 29(@)(@@) % قوم يحلون من مجد ومن شرف % ومن غناء محل البيض واليلب % 30(@)(@@) % حلوا محلهما من كل جمجمة % دفعا ونفعا وإطلالا على الرتب % PageV01P426 31(@)(@@) % لا بل هم الرأس إذ حسادهم ذنب % ومن يمثل بين الرأس والذنب % % 32(@)(@@) % تالله ما انفكت الأشياء شاحبة % حتى جلوها فأضحت وضح النقب % 33(@)(@@) % بهم أطاع لنا المعروف وامتنعت % % جوانب الملك ذي الأركان والشذب % 34(@)(@@) % كم فيهم من مقيم كل ذي حدب % من الأمور برأي غير ذي حدب % 35(@)(@@) % ما زال أحمد المحمود يحمدهم % مذ بويء التاج منه خير معتصب % 36(@)(@@) % وقبل ذلك كانوا يمهدون له % % وتلكم 
ms105	 القربة الكبرى من القرب % 37(@)(@@) % صغا إليهم وولاهم أمانته % دون الأنام فلم يرتب ولم يرب % 38(@)(@@) % ما انفك تدبيرهم يجري على مهل % % حتى غدا الصقر منصورا على الخرب % 39(@)(@@) % لو كنت تعلم ما أغنى يراعهم % أيقنت أن القنا كل على القصب % 40(@)(@@) % إن كنت أذنبت في مدحي ذوي ضعة % فمدحتي آل وهب أنصح التوب % % PageV01P427 41(@)(@@) % الحارسي الدين لا يلهو نهارهم % % عنه ولا ليلهم بالنائم الرقب % % 42(@)(@@) % الحافظي الملك والحامين حوزته % % من الأعادي ذوي الأضغان والكلب % 43(@)(@@) % الحالبي لفحات الفيء حافلة % بالرفق واليمن منهم ثرة الحلب % 44(@)(@@) % المجتني الحمد بعد الأجر غايتهم % % صون الإمام عن الآثام والسبب % 45(@)(@@) % ومن جبى المال للسلطان دونهم % % أعداه إثما وعارا لازب الجرب % 46(@)(@@) % كم نضو شكر نضوا عنه وليته % فظهره مستريح غير معتقب % 47(@)(@@) % وما شكا العسر بعد اليسر صاحبهم % % ولا تحول عن رحل إلى قتب % 48(@)(@@) % وما يربغون بالنعمى مكافأة % لكن يقضون ما للمجد من أرب % 49(@)(@@) % أقسمت حقا لئن طابت ثمارهم % لقد سرى عرقهم في أكرم الترب % 50(@)(@@) % دع من قوافيك ما يكفيك إن لها % % في مدح مولاك شوطا ملهب الخبب % PageV01P428 51(@)(@@) % يا سائلي أعرب الإحسان عن حسن % أبي محمد المحمود في النوب % 52(@)(@@) % سألت عنه رفيع الذكر قد خطبت % به النباهة قبل الشعر والخطب % 53(@)(@@) % أغنى الصباح عن المصباح بل طلعت % شمس الضحى تسلك الأسلاك في الثقب % 54(@)(@@) % هلا سألت ثناء غير مجتلب % أضحى له وفناء غير مجتنب % 55(@)(@@) % فتى إذا ما مدحناه أتيح له % % من أرضه المدح فاستغنى عن الجلب % 56(@)(@@) % معروفه في جميع الناس مقتسم % فحمده في جميع الناس لا العصب % 57(@)(@@) % خرق حوت يده ملكا فجاد به % % فأصبح الملك ملكا غير مغتصب % 58(@)(@@) % أغر أبلج يكسو نفسه حلالا % % من المحامد لا تبلى على الحقب % 59(@)(@@) % أمواله في رقاب الناس من منن % لا في الخزائن من عين ومن نشب % 60(@)(@@) % فليس يملك إلا غير منتزع % % وليس يلبس إلا غير مستلب % PageV01P429 61(@)(@@) % كذا المكارم ملك لا زوال له % % باق يدوم لباق 
ms106	 غير منشعب % 62(@)(@@) % ذاك الذي باين الأسواء وانتسبت % إليه بيض الأيادي كل منتسب % 63(@)(@@) % كم شد للسعي في أكرومة لببا % أضحى كريما به مسترخي اللبب % 64(@)(@@) % ما انفك من سهر يخليك من سهر % كلا ولا دأب يعفيك من دأب % 65(@)(@@) % مذلل للمساعي وهو مشتمل % بالعز في ظل عيص محصد الأشب % 66(@)(@@) % قد وطأ المجد للعافي خلائقه % فللتسحبي فيها لين منسحب % 67(@)(@@) % ماض على الهول نحو المجد يطلبه % % من شأنه السربة البعدى من السرب % 68(@)(@@) % لا يتقي في جميل هول مرتكب % إذا اتقى في رغيب قبح مرتكب % 69(@)(@@) % أحمى فأرعى وآوى من يطيف به % % في حيث يأمن من خوف ومن سغب % 70(@)(@@) % فضيفه في ربيع طول مدته % % وجاره كل حين منه في رجب % PageV01P430 71(@)(@@) % الأمن والخصب للثاوي بعقوته % وقفين قد كفياه كل مضطرب % 72(@)(@@) % فليس كشحاه مطويين عن رغد % ولا جناحاه مضمومين من رتب % 73(@)(@@) % أغر يجتلب المداح نائله % وأكثر الناس مدحا غير مجتلب % 74(@)(@@) % تلقاه من نهضه للمجد في صعد % ومن تواضعه للحق في صبب % 75(@)(@@) % كأنه وهو مسؤول وممتدح % غناه إسحاق والأوتار في صخب % 76(@)(@@) % يهتز عطفاه عند الحمد يسمعه % من هزة المجد لا من هزة الطرب % 77(@)(@@) % زول يقسم أمرا واحدا شعبا % وقادر أن يضم الأمر ذا الشعب % 78(@)(@@) % معان خيرين للرواد مكتسب % من العوارف يسديها ومكتتب % 79(@)(@@) % كالبحر منفجرا من كل منفجر % والغيث منسكبا من كل منسكب % 80(@)(@@) % جاء السوادان يمتاران فاحتقبا % % من علمه ونداه خير محتقب % PageV01P431 81(@)(@@) % يقظان ما زال تغنيه قريحته % عن التجارب يلقاهن والدرب % 82(@)(@@) % ذو لمحة تدرك العقبى إذا احتجبت % عن العقول بغيب كل محتجب % 83(@)(@@) % تغزى الخطوب إذا اشتدت معرتها % % من كيده بخميس غير ذي لجب % 84(@)(@@) % رمى من الحق أغراضا فقرطسها % % وطالما رميت قدما فلم تصب % 85(@)(@@) % بصائب من سهام الرأي أيده % بالبحث والفحص لا بالريش والعقب % 86(@)(@@) % فأي عدل وفصل في قضيته % % إذا تجاثى بنو الجلى على الركب % 87(@)(@@) % فإن عصت بدهات الرأي معضلة % أذكى لها فكرا أذكى من اللهب 
ms107	 % 88(@)(@@) % وما الحقوق إذا استقصى بضائعة % ولا الكلام إذا أحصى بمنتهب % 89(@)(@@) % يجد جد بعيد الهم منتدب % لكل خطب جليل كل منتدب % 90(@)(@@) % ويفكه الحال بعد الحال مقتفرا % آثار من قرن السلاء بالرطب % PageV01P432 91(@)(@@) % مسدد في جوابات يجيب بها % % كأنها أبدا مأخوذة الأهب % 92(@)(@@) % فيها حلاوة ظرف غير منتحل % إلى فخامة علم غير مؤتشب % 93(@)(@@) % يزينها بإشارات ملحنة % كأنها نغم التأليف ذي النسب % 94(@)(@@) % كم موطن قد جرى فيه مجاريه % يمر فيه مرورا غير ذي نكب % 95(@)(@@) % محدثا أو مبينا عن مجمجمة % أو هازلا هزل صداف عن الحوب % 96(@)(@@) % فما تطاير كالمخلوق من شرر % % ولا تواقر كالمنحوت من خشب % 97(@)(@@) % بل ظل يوزن بالقسطاط مأخذه % مجاوزا عتبا منه إلى عتب % 98(@)(@@) % بين الخفاف وبين الطيش مجتذبا % عرا القلوب إليه كل مجتذب % 99(@)(@@) % تعضل الأرض ضيقا عن جلالته % % ويسلك الخرت عفوا لطف منسرب % 100(@)(@@) % ساه وما تتقى في الرأي سقطته % داه وما ينطوى منه على ريب % PageV01P433 101(@)(@@) % فدهيه للدواهي الربد يدمغها % % وسهوه عن عيوب الناس والغيب % 102(@)(@@) % لولا عجائب لطف الله ما نبتت % تلك الفضائل في لحم وفي عصب % 103(@)(@@) % ليبهج الدين والدنيا فإنهما % % قد أصبحا في جنابيه بمصطحب % 104(@)(@@) % يا ابن الوزير الذي أضحت صنائعه % مقلدات رقاب العجم والعرب % 105(@)(@@) % مهما وعدت فمذكور ومحتسب % وما اصطنعت فشيء غير محتسب % 106(@)(@@) % تعطي ووجهك مبسوط يصانعنا % % كأن كفك لم تفضل ولم تهب % 107(@)(@@) % لقاء جان إلى العافين معتذر % وفعل مجن جنى أحلى من الضرب % 108(@)(@@) % يا من إذا ما سألناه استهل لنا % % وإن سكتنا تجنى علة الطلب % 109(@)(@@) % أجاد تكمين نعمى ثم أطلعها % % لنا بلا مد أعناق ولا تعب % 110(@)(@@) % كأنها نعمة الله التي خلصت % في جنة الخلد من هم ومن نصب % PageV01P434 111(@)(@@) % مبرة لطفت منه وتصفية % لمورد العرف لم نعرفهما لأب % 112(@)(@@) % أثابك الله عنا ما يثاب به % % ذو الفضل والطول والعافي عن الريب % % 113(@)(@@) % وما عجبنا وإن أصبحت تعجبنا % % أن يجتنى ذهب من معدن الذهب % % 114(@)(@@) % لكن عجبنا لعرف لا 
ms108	 نكافئه % ونستزيدك منه أكثر العجب % 115(@)(@@) % لو فر مصطنع من عرف مصطنع % عجزا عن الشكر لم نسبق إلى الهرب % 116(@)(@@) % لكنك المرء يسدي عرفه ويرى % % ترك الحساب عليه أفضل الحسب % 117(@)(@@) % وقد كفاك ائتناف المجد سيدنا % % فلم تواكل ولم تعمل على النسب % 118(@)(@@) % لكن فعلت كآباء لكم فعل % بيض الصنائع كشافين للكرب % 119(@)(@@) % وما عدوت من الآراء أصوبها % % عند امرىء كان ذا عقل وذا أدب % 120(@)(@@) % إذا ابن قوم وإن كانوا ذوي كرم % لم يفعل الخير أمسى غير منتجب % PageV01P435 121(@)(@@) % وكل شعبة أصل مثمر عقمت % % فليس تعتد إلا أرذل الشعب % 122(@)(@@) % لذاك من قضب الرمان مكتنف % يحمى ويسقى ومنبوذ مع الحطب % 123(@)(@@) % لولا الثمار التي ترجى منافعها % % ما فضل الناس تفاحا على غرب % 124(@)(@@) % ها إن تاخطبة قام الخطيب بها % % صريحة الصدق لم تمذق ولم تشب % 125(@)(@@) % والغرس نفل ورب الغرس مفترض % فاربب غراسك تجن الشكر من كثب % 126(@)(@@) % أسديت أمرا فالحمه بلحمته % % لنا وسببت فاجدل مرة السبب % 127(@)(@@) % كلم فتى طيء فينا وسيدها % % تكليم راض مليح صفحة الغضب % 128(@)(@@) % جدا وحدا إذا ما شئت هزهما % % طباعك الحر هز العضب ذي الشطب % 129(@)(@@) % واعلم بأنك مأمول ومرتقب % فاشفع شفاعة مأمول ومرتقب % 130(@)(@@) % الله في مال قوم أنت كاسبه % % يا خير مكتسب من خير مكتسب % PageV01P436 131(@)(@@) % حافظ عليه حفاظا لا وراء له % % إلا النجاح وأنقذه من العطب % 132(@)(@@) % لا تسلبن يد قد أملت بكم % ما أملته فلا حرمان كالسلب % 133(@)(@@) % ولو سئلنا لقلنا الفقر فاقرة % لكن أعظم منه حسرة الحرب % 134(@)(@@) % وليس يشجب جار أنت مانعه % لا زال جارك ممنوعا من الشجب % 135(@)(@@) % واسلم على الدهر في نعماء سابغة % وارجع موقى ملقى خير منقلب % 136(@)(@@) % وآنس الله نفسا أنت صاحبها % % فإنها من معاليها بمغترب % 137(@)(@@) % خذها هديا ولم أنكحكها عزبا % يا ابن الوزير وكم أنكحت من عزب % 138(@)(@@) % ما زلت تنكح من قبلي نظائرها % % وأي داع إليك المدح لم يجب % 139(@)(@@) % وما خسست الثواب المستثاب بها % % وأي مهد إليك الصدق لم 
ms109	 يثب % 140(@)(@@) % ومن يقاتل عن العليا ليملكها % % بمثل خيمك لم يسبق إلى الغلب % PageV01P437 البحر : - 1(@)(@@) % فتحت أبواب مدح لا انغلاق لها % % من إخوة لك جاؤوا بالأعاجيب % 2(@)(@@) % فجازني بمديحي أو مديحهم % إن المسبب محقوق بتثويب % 3(@)(@@) % سبب أو افعل بل اسمح لي بجمعهما % % فعلا بفعل وتسبيبا بتسبيب % % 4(@)(@@) % يا من يقول بما فيه مقرظه % ولا يمت إليه بالأكاذيب % PageV01P438 البحر : - 1(@)(@@) % سأثلج باصطناع العرف صدري % % وأعدم كاهلي ثقل الذنوب % 2(@)(@@) % وأحسن لا بحظك بل بحظي % % وللإحسان آنس للقلوب % 3(@)(@@) % إذا ذكرت أياديها نفوس % % أفاقت من معالجة الكروب % 4(@)(@@) % وآمن ما يكون المرء يوما % إذا لبس الحذار من الخطوب % 5(@)(@@) % أمور أقبلت بعد التولي % % وشمس أشرقت بعد الغروب % 6(@)(@@) % ومن يك ذخره رمحا وسيفا % فنصر الله ذخري للحزوب % PageV01P439 البحر : - 1(@)(@@) % أبا الصقر لست أرى مهديا % لك المدح غيري إلا مثابا % % 2(@)(@@) % وقد كدت من فرط ما شفني % % جفاؤك ألا أسيغ الشرابا % % 3(@)(@@) % ولو كنت أعرف لي إسوة % صبرت وعزيت قلبا مصابا % % 4(@)(@@) % ولكن منعت الأسا مثلما % % حرمت اللهى من يديك الرغابا % % 5(@)(@@) % وكنت قليل إسا المرتجي % % إذا فاته صيب منك صابا % % 6(@)(@@) % وأين إسا من عممت الورى % % سواه بسيب يفوت السحابا % % 7(@)(@@) % فلا زلت لا يجد الحاسدو % % ن فيك سوى ذلك العاب عابا % % 8(@)(@@) % بل الله يفديك بالحاسدي % % ن من كل عاب دعاء مجابا % % 9(@)(@@) % وإن كنت حلأتني صاديا % وأوردت غيري حياضا عذابا % 10(@)(@@) % تجأجىء بالوارديها سوا % % ي ظلما وتفرغ فيها الذنابا % % PageV01P440 11(@)(@@) % وإني لأرأفهم منسما % بساق وأعفاهم عنه نابا % % 12(@)(@@) % وأغزرهم درة بعد ذا % % ك عفوا إذا الدر عاصى العصابا % % 13(@)(@@) % فما لعطاياك أضحت حمى % علي وأضحت لغيري نهابا % % 14(@)(@@) % أظنك خبرت أني امرؤ % أبر الرجال بشعري احتسابا % % 15(@)(@@) % وذلك أحسن ما في الظنون % % إذا ما أخ بأخيه استرابا % % 16(@)(@@) % ولو غيرك السائمي ما أرى % % لشعبت للظن فيه شعابا % % 17(@)(@@) % فقلت غبي كسا جهله % نواظره دون شمسي ضبابا % % 18(@)(@@) % وران على قلبه رينه % فليس يريه صوابي صوابا % % 19(@)(@@) % أذلك أو قلت 
ms110	 كان امرأ % رأى الجود ذنبا عظيما فتابا % % 20(@)(@@) % هفا هفوة بالندى ثم قال % % أنبت إلى الله فيمن أنابا % % PageV01P441 21(@)(@@) % أذلك أو قلت بل لم يزل % أخا البخل إلا عدات كذابا % % 22(@)(@@) % يريغ ثناء بلا نائل % % يمني أماني تلفى سرابا % % 23(@)(@@) % إلى كل ذاك تميل النفو % % س أخطأ ظن بها أم أصابا % % 24(@)(@@) % ولكن تنخلت فيك الظنون % تنخلي المدح فيك اللبابا % % 25(@)(@@) % وما ظن من حسن الظن فيك % % فأنت الحقيق به لا المحابى % % 26(@)(@@) % على أنني رجل عاتب % وعتبي أهدى إليك العتابا % % 27(@)(@@) % سأبدي معاتب مكنونة % إذا هي لم تبد عادت ضبابا % % 28(@)(@@) % قبلت مديحي وأنشدته % أناسا وأمسكت عني الثوابا % % 29(@)(@@) % وفيه سرائر أفشيتهن % ن إليك وكاتمتهن الحجابا % % 30(@)(@@) % فلله أنت وما جئته % إلي لقد جئت شيئا عجابا % % PageV01P442 31(@)(@@) % أتهتك ستري عن خلتي % % وتغلق دون عطاياك بابا % % 32(@)(@@) % فلو كنت إما أنلت امرأ % وإما سترت عليه وخابا % % 33(@)(@@) % عذرت ولكن كشفت الغطا % % ء عنه ولما تنله الثوابا % % 34(@)(@@) % سوى أن خالك لي مبرق % بوارق يخطفن طرفي التهابا % % 35(@)(@@) % يشير إلي بإيماضه % % ويعمد غير جنابي مصابا % % 36(@)(@@) % وإن جنابي لو جاده % % لأزكى نباتا وأزكى ترابا % % 37(@)(@@) % جناب إذا راده رائد % % رأى المسك عند ثراه ملابا % % 38(@)(@@) % وإن جاده العرف أجنى جنى % من الشكر مستعذبا مستطابا % % 39(@)(@@) % فحتام تخطف تلك البرو % % ق طرفي ويسقين غيري الذهابا % % 40(@)(@@) % رضيت بوعدك لي نائلا % إذا شمت في أفقيك السحابا % % PageV01P443 41(@)(@@) % وما كنت بعتك ستر القنوع % % لتنقدني منه وعدا خلابا % % 42(@)(@@) % ومن باع سترا على خلة % بوعد فأخسر به حين آبا % % 43(@)(@@) % ومن عجب كدت تجني به % % علي مشيبا يعفي الشبابا % % 44(@)(@@) % دوام احتجابك عن رائدي % % ولولاي لم ير منك احتجابا % % 45(@)(@@) % وقد كان من قبل إيصاله % هداياي أدنى جليسيك قابا % % 46(@)(@@) % فأقصاه ما كان يرجو به % % إليك دنوا ومنك اقترابا % % 47(@)(@@) % فاعجب بهاتيك من خطة % واعجب بألا تشيب الغرابا % % 48(@)(@@) % حلفت لئن أنت لم ترضني % % لتنصرفن القوافي غضابا % % PageV01P444 البحر : - 1(@)(@@) % أبا جعفر واصفح عن الفاء إنها 
ms111	 % % تزيدك في جعر من الأف جانبا % % 2(@)(@@) % رأيتك للفعل الجميل مجانبا % فآليت لا ألقاك إلا مجانبا % % PageV01P445 البحر : - 1(@)(@@) % لي خادم لا أزال أحتسبه % يغيب حتى يرده سغبه % 2(@)(@@) % نرسله لاشتراء فاكهة % فقصرنا أن تجيئنا كتبه % 3(@)(@@) % كم قال ضيفي وقد بعثت به % % هيهات يوم الحساب منقلبه % 4(@)(@@) % وخلته قد سما إلى كرم رض % % وان لكي يجتنى له عنبه % 5(@)(@@) % وإنما زار مالكا فرأى % % زقوم صدق فظل ينتخبه % 6(@)(@@) % ثم أتاني وقد طما غضبي % % عليه والضيف قد طما غضبه % 7(@)(@@) % فقال هاكم وليس في يده % % إلا نوى كان مرة رطبه % 8(@)(@@) % أو عجم رمانة وقشرتها % % بغير ماء لقد خلا عجبه % 9(@)(@@) % ضل فما يهتدي لطيبة % كأنما مجتناه محتطبه % 10(@)(@@) % غيبته سرمد وخيبته % لا تنقضي أو يغوله عطبه % PageV01P446 11(@)(@@) % يبطىء حتى أكاد أحسبه % % صادف تيسا فظل يحتلبه % 12(@)(@@) % أو أعرض الردم دون حاجته % % أو لقي الليث هائجا كلبه % 13(@)(@@) % أو لكمت لقوة لهازمه % أو سقطت من زمانة ركبه % 14(@)(@@) % هل مشتر والسعيد بائعه % هل قابل والسعيد من يهبه % 15(@)(@@) % أساء بالمسلمين جالبه % % لا كان من جالب ولا جلبه % PageV01P447 البحر : - 1(@)(@@) % تأمل العيب عيب % ما في الذي قلت ريب % 2(@)(@@) % والشعر كالشعر فيه % % مع الشبيبة شيب % 3(@)(@@) % فليصفح الناس عنه % % فطعنهم فيه غيب % 4(@)(@@) % حتى يعيش جرير % لعيبه أو نصيب % 5(@)(@@) % كم عائب كل شيء % وكل ما فيه عيب % 6(@)(@@) % والجيب ذيل لديه % % للنوك والذيل جيب % 7(@)(@@) % إياك يا بن بويب % أن يستثار بويب % 8(@)(@@) % فإنما أنا ليث % عاد وأنت كليب % 9(@)(@@) % لا تحقرن سبيبا % كم جر سبا سبيب % 10(@)(@@) % ولا تظن بجهل % أن اللسان زبيب % PageV01P448 11(@)(@@) % قد تحسن الروم شعرا % ما أحسنته العريب % 12(@)(@@) % يا منكر المجد فيهم % % أليس منهم صهيب % PageV01P449 البحر : - 1(@)(@@) % إذا بركت في صوم لقوم % دعوت لهم بتطويل العذاب % 2(@)(@@) % وما التبريك في شهر طويل % يطاول يومه يوم الحساب % 3(@)(@@) % فليت الليل فيه كان شهرا % ومر نهاره مر السحاب % % 4(@)(@@) % فلا أهلا بمانع كل خير % وأهلا بالطعام وبالشراب % % PageV01P450 البحر 
ms112	 : - 1(@)(@@) % لي طيلسان ليس يترك لي % % رفوي له مالا ولا نشبا % % 2(@)(@@) % طرب تغني منه ناحية % وتشق أخرى جيبها طربا % % 3(@)(@@) % كيف السبيل إلى عمارته % وإذا عمرت خرابه خربا % % 4(@)(@@) % كان ابن حرب حين جاد به % لا شك فيه يريد بي الحربا % % PageV01P451 البحر : - 1(@)(@@) % طربت إلى ريحانة الأنف والقلب % وأعمالها بين العوازف والشرب % 2(@)(@@) % ولا عيش إلا بين أكواب قهوة % توارثها عقب من الفرس عن عقب % 3(@)(@@) % من الكمت قبل المزج صهباء بعده % سليلة جون غير كمت ولا صهب % 4(@)(@@) % سلالة كرم شارف غير أنها % % علالة عود من دنان القرى ثلب % 5(@)(@@) % تأتت أكف القاطفين قطافها % % فسالت بلا عصر ودرت بلا عصب % 6(@)(@@) % أطافت بها الأيام حتى كأنها % % حشاشة نفس شارفت منقضى نحب % 7(@)(@@) % لها منظر في العين يشهد حسنه % على مخبر يهدي السرور إلى القلب % 8(@)(@@) % ترد صفاء العيش مثل صفائها % % وتكشف عن ذي الكرب غاشية الكرب % 9(@)(@@) % جلاها من الأطباع طول ثوائها % % وإمرارها الأحقاب حقبا إلى حقب % 10(@)(@@) % فلو رفعت في رأس علياء لاهتدى % % بكوكبها السارون في الشرق والغرب % PageV01P452 11(@)(@@) % غني عن الريحان مجلس شربها % % بنشر كنشرالمسك في محتوى نهب % 12(@)(@@) % ولم تر موموقا إلى النفس مثلها % % تشم فتلقى بالعبوس وبالقطب % 13(@)(@@) % يناضل عنها الماء حين يشجها % % نفي لها مثل الدبا لج في الوثب % 14(@)(@@) % لها مكرع سهل يخبر أنها % % ذلول وفيها سورة الجامح الصعب % 15(@)(@@) % سأعصي إليها اللوم في بطن روضة % كساها الحيا نورا كأدرية العصب % 16(@)(@@) % وكم مثلها من بنت كرم جلوتها % % على كل خرق ماجد الجد من صحبي % % 17(@)(@@) % له خلق عذب المذاق ولن ترى % % مزاج كؤوس الراح كالخلق العذب % 18(@)(@@) % يسرك في السراء حلو ندامه % وأنجد في العزاء من صارم عضب % 19(@)(@@) % بمونقة الرواد حو تلاعها % % تراعي بها الأدمان آمنة السرب % 20(@)(@@) % صففنا أباريق اللجين حيالها % % فمثلن سربا مشرئبا إلى سرب % PageV01P453 21(@)(@@) % تظل ترانيها الظباء تخالها % % ظباء وتدنو فهي منا على قرب % 22(@)(@@) % إذا نحن شئنا عللتنا صوادح % من الطير جمات الأهازيج والنصب % 23 
ms113	(@)(@@) % فذاك نصيب السلم عندي ولم أكن % لأنسى نصيب الحرب في نوب الحرب % 24(@)(@@) % أخي دون إخواني إذا الحرب شمرت % % حسام بحديه فلول من الضرب % 25(@)(@@) % له حين يعلو قونس القرن هبة % تواصل ما بين الذؤابة والعجب % 26(@)(@@) % إذا شيم فيه بارق الموت أو مضت % به صفحة مثل العقيقة في الجلب % 27(@)(@@) % ومطرد مثل الرشاء تهزه % % كعوب تدانت فيه مثل نوى القسب % 28(@)(@@) % عليه سنان يرعف الموت لهذم % قليل التخفي بالجوانح والجنب % 29(@)(@@) % وكل ابن ريح يسبق الطرف معجه % % تطوحه عطوى منوعا لدى الجدب % 30(@)(@@) % صنيع مريش قوم القين متنه % % فجاء كما سل النخاع من الصلب % PageV01P454 31(@)(@@) % يغلغله في الدرع نصل كأنه % % لسان شجاع مخرج هم باللسب % 32(@)(@@) % وموضونة مثل الغدير حصينة % تفل شباة السيف ذي المضرب العضب % 33(@)(@@) % فذاك عتادي فوق أجرد سابح % يريح زفير الجري من منخر رحب % 34(@)(@@) % ذنوب يمس الأرض عند صيامه % % بضاف يواري فرجه سبط الهلب % 35(@)(@@) % له عند إيغال الطريدة في الوغى % % أجاري مضمون لها درك الطلب % 36(@)(@@) % يدل على صم الصفا بحوافر % % من اللائي أعطين الأمان من النكب % 37(@)(@@) % بذلك إن دارت رحى الحرب مرة % ثبت ثبات القطب في مركز القطب % 38(@)(@@) % إذا أخرت سرج الجبان وجدتني % % أغامسها في حومة الطعن والضرب % 39(@)(@@) % متى يلقني قرني فإن قصاره % على ضربة أو طعنة ثرة الشخب % 40(@)(@@) % وإني لذو حلم وشغب وراءه % % فحلم لذي حلم وشغب لذي شغب % PageV01P455 41(@)(@@) % وإني لنحار لدى الأزب لا يني % % قراي من الكوم المقاصيد كالهضب % 42(@)(@@) % إذا حاردت خور العشار حلبتها % % دماء وقدما كان ذلك من حلبي % % 43(@)(@@) % وقد يرجع الوجناء سيري وعينها % % مهوكة مثل الصبابة في الوقب % 44(@)(@@) % طويت حشاها طية البرد بعدما % % طويت بها سهبا عريضا إلى سهب % 45(@)(@@) % أنا ابن شهاب الحرب قومي ذوو العلا % % ولا فخر إن الفخر فرع من العجب % 46(@)(@@) % وكم من أب لي ماجد وابن ماجد % % له شرف يربي على الشرف المربي % % 47(@)(@@) % إذا مطرت كفاه بالبذل نورت % له الأرض واهتزت رباها من الخصب 
ms114	 % 48(@)(@@) % وإن حاول الأعداء يوما بكيده % % أحل بمن عاداه راغية السقب % 49(@)(@@) % وحر من الفتيان ليس بقعدد % ولا قائل من فعل مكرمة حسبي % % 50(@)(@@) % أخي ثقة لو أصبح الناس كلهم % % علي معا حزبا لأصبح من حزبي % % PageV01P456 51(@)(@@) % أنوء به فيما عرا وأعده % لسانا وسيفا في الخطاب وفي الخطب % 52(@)(@@) % أبحت حمى قلبي له دون غيره % % وأنزلته في السهل منه وفي الرحب % 53(@)(@@) % إذا اشترك الوراد في الشرب أخلصت % له النفس ودا غير مشترك الشرب % 54(@)(@@) % وقد حاول الواشون إفساد بيننا % % فأعيى على ذي المكر منهم وذي الإرب % 55(@)(@@) % سوى أنهم قد آذنونا بجفوة % أدالت رضانا ما حيينا من التعب % 56(@)(@@) % وشوا فعرفنا للتجافي مرارة % وهبنا لها مهما أتيناه من ذنب % 57(@)(@@) % فعدنا وأصبحنا بحيث يسرنا % % من الوصل والواشون في مزجر الكلب % PageV01P457 البحر : - 1(@)(@@) % أصبحت شيخا له سمت وأبهة % يدعونني البيض عما تارة وأبا % % 2(@)(@@) % وتلك دعوة إجلال وتكرمة % وددت أني معتاض بها لقبا % % PageV01P458 البحر : - 1(@)(@@) % للموز إحسان بلا ذنوب % ليس بمعدود ولا محسوب % 2(@)(@@) % يكاد من موقعه المحبوب % يدفعه البلع إلى القلوب % PageV01P459 البحر : - 1(@)(@@) % وهب يا واهب الهبات اللواتي % % قصرت دونها الهبات الرغاب % 2(@)(@@) % هب لراجيك ما عليه فإن اس % مك وهب ووسمك الوهاب % % 3(@)(@@) % أنت بحر ومن له تجتبي الأم % % وال بحر لجانبيه عباب % % 4(@)(@@) % فارغبا عن مداد شعبي فليست % % فيه إلا صبابة بل سراب % 5(@)(@@) % وارثيا لامرىء ألح عليه % % للزمان الصؤول ظفر وناب % 6(@)(@@) % سلبته الخطوب ما في يديه % % وله من تجمل أثواب % 7(@)(@@) % وإذا الصبر والتجمل داما % % للفتى الحر هانت الأسلاب % 8(@)(@@) % إن بحرا يمد بحرا بشعب % فيه أدنى صبابة لعجاب % 9(@)(@@) % فلك الحجة الصحيحة إن قل % % ت كذا تحلب البحور الشعاب % 10(@)(@@) % ومن المرة الضعيفة فالمر % رة تلوى فتحكم الأسباب % PageV01P460 11(@)(@@) % غير أن ليس في خراجي وحدي % % ما بإغلاقه يسوغ الشراب % 12(@)(@@) % لك في مكثري الرعية دوني % % حلب كيف شئت بل أحلاب % 13(@)(@@) % ومتى رام رائم كخصوصي % % قلت ما كل دعوة تستجاب % 14(@)(@@) % بل لقوم وسائل 
ms115	 يستحقو % % ن إذا ما دعوا بها أن يجابوا % % 15(@)(@@) % ومفاتيح للخصوص وكانت % % بالمفاتيح تفتح الأبواب % 16(@)(@@) % منهم معشر ومنهم أناس % فضلتهم بفضلها الألباب % 17(@)(@@) % وأديب له ثناء بما يس % دى إليه وللثناء ثواب % 18(@)(@@) % ولبعض الرجال فضل على بع % % ض بما نفلتهم الآداب % 19(@)(@@) % ولقد جاء في الرواية والآ % % ثار أنا على العقول نثاب % 20(@)(@@) % وأحاشيك أن أفهمك الحج % جة أنى يفهم الكتاب % PageV01P461 21(@)(@@) % سيما الكاتب المبر على النا % % س بما لا يعده الحساب % 22(@)(@@) % لا تحلني على سواك فما أص % % بح للطالبين غيرك باب % 23(@)(@@) % أنت في العدل بالمكارم أولى % % من ولاة دعاتهم لا تجاب % 24(@)(@@) % يقصد القاصدون منهم لئاما % ما لهم من وجوههم حجاب % 25(@)(@@) % مستهينين للهجاء فما من % % هم له خائف ولا هياب % 26(@)(@@) % كلهم حين يسأل العرض الأد % % نى جمود البنان لا يستذاب % 27(@)(@@) % يتلقى مسائل الناس منه % عرض سالم وعرض مصاب % 28(@)(@@) % مستخفين بالمديح وهل كا % % نت تثيب العبادة الأنصاب % 29(@)(@@) % لهف نفسي إن اجتبيت خراجي % % وحوته عفاتك الخياب % 30(@)(@@) % أنا جار قريب دار وتجبي % % ني ويجبيك نازح منتاب % PageV01P462 31(@)(@@) % ألشكر فعندي الشكر والحم % % د الذي لم يزل له خطاب % 32(@)(@@) % لا تضعني فإن شكري كنز % يتهادى تراثه الأعقاب % 33(@)(@@) % واستجد اليد التي سلفت من % % ك على أنها فتاة كعاب % 34(@)(@@) % لك عندي صنيعة ما سقاها % % غير وسميك القديم سحاب % 35(@)(@@) % فاسقها من وليك الجود واربب % ها تهدل لها ثمار عذاب % 36(@)(@@) % وهي الشكر والمحامد تنثو % % ها أقاويلي الرصان الصياب % 37(@)(@@) % مدح من بنات فكري أبكا % % ر حسان كواعب أتراب % PageV01P463 البحر : - 1(@)(@@) % أتاني مقال من أخ فاغتفرته % وإن كان فيما دونه وجه معتب % 2(@)(@@) % وذكرت نفسي منه عند امتعاضها % % محاسن تعفو الذنب عن كل مذنب % % 3(@)(@@) % ومثلي رأى الحسنى بعين جلية % وأغضى عن العوراء غير مؤنب % 4(@)(@@) % فيا هاربا من سخطنا متنصلا % هربت إلى أنجى مفر ومهرب % 5(@)(@@) % فعذرك مبسوط لدينا مقدم % وودك مقبول بأهل ومرحب % 6(@)(@@) % ولو بلغتني عنك أذني أقمتها % % لدي مقام الكاشح 
ms116	 المتكذب % 7(@)(@@) % ولست بتقليب اللسان مصارما % خليلي إذا ما القلب لم يتقلب % PageV01P464 البحر : - 1(@)(@@) % دع اللوم إن اللوم عون النوائب % % ولا تتجاوز فيه حد المعاتب % 2(@)(@@) % فما كل من حط الرحال بمخفق % ولا كل من شد الرحال بكاسب % 3(@)(@@) % وفي السعي كيس والنفوس نفائس % وليس بكيس بيعها بالرغائب % 4(@)(@@) % وما زال مأمول البقاء مفضلا % على الملك والأرباح دون الحرائب % 5(@)(@@) % حضضت على حطبي لناري فلا تدع % لك الخير تحذيري شرور المحاطب % 6(@)(@@) % وأنكرت إشفاقي وليس بمانعي % % طلابي أن أبغي طلاب المكاسب % 7(@)(@@) % ومن يلق ما لاقيت في كل مجتنى % من الشوك يزهد في الثمار الأطايب % 8(@)(@@) % أذاقتني الأسفار ما كره الغنى % % إلي وأغراني برفض المطالب % 9(@)(@@) % فأصبحت في الإثراء أزهد زاهد % وإن كنت في الإثراء أرغب راغب % 10(@)(@@) % حريصا جبانا أشتهي ثم أنتهي % % بلحظي جناب الرزق لحظ المراقب % PageV01P465 11(@)(@@) % ومن راح ذا حرص وجبن فإنه % % فقير أتاه الفقر من كل جانب % 12(@)(@@) % ولما دعاني للمثوبة سيد % % يرى المدح عارا قبل بذل المثاوب % 13(@)(@@) % تنازعني رغب ورهب كلاهما % % قوي وأعياني اطلاع المغايب % 14(@)(@@) % فقدمت رجلا رغبة في رغيبة % وأخرت رجلا رهبة للمعاطب % 15(@)(@@) % أخاف على نفسي وأرجو مفازها % % وأستار غيب الله دون العواقب % 16(@)(@@) % ألا من يريني غايتي قبل مذهبي % % ومن أين والغايات بعد المذاهب % 17(@)(@@) % ومن نكبة لاقيتها بعد نكبة % رهبت اعتساف الأرض ذات المناكب % 18(@)(@@) % وصبري على الإقتار أيسر محملا % علي من التغرير بعد التجارب % 19(@)(@@) % لقيت من البر التباريح بعدما % % لقيت من البحر ابيضاض الذوائب % 20(@)(@@) % سقيت على ري به ألف مطرة % شغفت لبغضيها بحب المجادب % PageV01P466 21(@)(@@) % ولم أسقها بل ساقها لمكيدتي % % تحامق دهر جد بي كالملاعب % 22(@)(@@) % إلى الله أشكو سخف دهري فإنه % % يعابثني مذ كنت غير مطايب % 23(@)(@@) % أبى أن يغيث الأرض حتى إذا ارتمت % برحلي أتاها بالغيوث السواكب % % 24(@)(@@) % سقى الأرض من أجلي فأضحت مزلة % تمايل صاحيها تمايل شارب % 25(@)(@@) % لتعويق سيري أو دحوض مطيتي % % وإخصاب مزور عن المجد ناكب % 26(@)(@@) % فملت إلى خان مرث 
ms117	 بناؤه % % مميل غريق الثوب لهفان لاغب % 27(@)(@@) % فلم ألق فيه م ستراحا لمتعب % % ولا نزلا أيان ذاك لساغب % 28(@)(@@) % فما زلت في خوف وجوع ووحشة % وفي سهر يستغرق الليل واصب % 29(@)(@@) % يؤرقني سقف كأني تحته % % من الوكف تحت المدجنات الهواضب % 30(@)(@@) % تراه إذا ما الطين أثقل متنه % تصر نواحيه صرير الجنادب % PageV01P467 31(@)(@@) % وكم خان سفر خان فانقض فوقهم % % كما انقض صقر الدجن فوق الأرانب % 32(@)(@@) % ولم أنس ما لاقيت أيام صحوه % من الصر فيه والثلوج الأشاهب % 33(@)(@@) % وما زال ضاحي البر يضرب أهله % بسوطي عذاب جامد بعد ذائب % % 34(@)(@@) % فإن فاته قطر وثلج فإنه % % رهين بساف تارة أو بحاصب % 35(@)(@@) % فذاك بلاء البر عندي شاتيا % وكم لي من صيف به ذي مثالب % 36(@)(@@) % ألا رب نار بالفضاء اصطليتها % % من الضح يودي لفحها بالحواجب % 37(@)(@@) % م % % ولا تتجاوز فيه حد المعاتب % 38(@)(@@) % فما كل من حط الرحال بمخفق % ولا كل من شد الرحال بكاسب % 39(@)(@@) % وفي السعي كيس والنفوس نفائس % وليس بكيس بيعها بالرغائب % 40(@)(@@) % وما زال مأمول البقاء مفضلا % على الملك والأرباح دون الحرائب % PageV01P468 41(@)(@@) % حضضت على حطبي لناري فلا تدع % لك الخير تحذيري شرور المحاطب % 42(@)(@@) % وأنكرت إشفاقي وليس بمانعي % % طلابي أن أبغي طلاب المكاسب % 43(@)(@@) % ومن يلق ما لاقيت في كل مجتنى % من الشوك يزهد في الثمار الأطايب % 44(@)(@@) % أذاقتني الأسفار ما كره الغنى % % إلي وأغراني برفض المطالب % 45(@)(@@) % فأصبحت في الإثراء أزهد زاهد % وإن كنت في الإثراء أرغب راغب % 46(@)(@@) % حريصا جبانا أشتهي ثم أنتهي % % بلحظي جناب الرزق لحظ المراقب % 47(@)(@@) % ومن راح ذا حرص وجبن فإنه % % فقير أتاه الفقر من كل جانب % 48(@)(@@) % ولما دعاني للمثوبة سيد % % يرى المدح عارا قبل بذل المثاوب % 49(@)(@@) % تنازعني رغب ورهب كلاهما % % قوي وأعياني اطلاع المغايب % 50(@)(@@) % فقدمت رجلا رغبة في رغيبة % وأخرت رجلا رهبة للمعاطب % PageV01P469 51(@)(@@) % أخاف على نفسي وأرجو مفازها % % وأستار غيب الله دون العواقب % 52(@)(@@) % ألا من يريني غايتي قبل مذهبي % % ومن أين والغايات بعد المذاهب % 53 
ms118	(@)(@@) % ومن نكبة لاقيتها بعد نكبة % رهبت اعتساف الأرض ذات المناكب % 54(@)(@@) % وصبري على الإقتار أيسر محملا % علي من التعرير بعد التجارب % 55(@)(@@) % لقيت من البر التباريح بعدما % % لقيت من البحر ابيضاض الذوائب % 56(@)(@@) % سقيت على ري به ألف مطرة % شغفت لبغضيها بحب المجادب % 57(@)(@@) % ولم أسقها بل ساقها لمكيدتي % % تحامق دهر جد بي كالملاعب % 58(@)(@@) % إلى الله أشكو سخف دهري فإنه % % يعابثني مذ كنت غير مطايب % 59(@)(@@) % أبى أن يغيث الأرض حتى إذا ارتمت % برحلي أتاها بالغيوث السواكب % % 60(@)(@@) % سقى الأرض من أجلي فأضحت مزلة % تمايل صاحيها تمايل شارب % PageV01P470 61(@)(@@) % لتعويق سيري أو دحوض مطيتي % % وإخصاب مزور عن المجد ناكب % 62(@)(@@) % فملت إلى خان مرث بناؤه % % مميل غريق الثوب لهفان لاغب % 63(@)(@@) % فلم ألق فيه م ستراحا لمتعب % % ولا نزلا أيان ذاك لساغب % 64(@)(@@) % فما زلت في خوف وجوع ووحشة % وفي سهر يستغرق الليل واصب % 65(@)(@@) % يؤرقني سقف كأني تحته % % من الوكف تحت المدجنات الهواضب % 66(@)(@@) % تراه إذا ما الطين أثقل متنه % تصر نواحيه صرير الجنادب % 67(@)(@@) % وكم خان سفر خان فانقض فوقهم % % كما انقض صقر الدجن فوق الأرانب % 68(@)(@@) % ولم أنس ما لاقيت أيام صحوه % من الصر فيه والثلوج الأشاهب % 69(@)(@@) % وما زال ضاحي البر يضرب أهله % بسوطي عذاب جامد بعد ذائب % % 70(@)(@@) % فإن فاته قطر وثلج فإنه % % رهين بساف تارة أو بحاصب % PageV01P471 71(@)(@@) % فذاك بلاء البر عندي شاتيا % وكم لي من صيف به ذي مثالب % 72(@)(@@) % ألا رب نار بالفضاء اصطليتها % % من الضح يودي لفحها بالحواجبه % % 73(@)(@@) % إذا ظلت البيداء تطفو إكامها % % وترسب في غمر من الآل ناضب % 74(@)(@@) % فدع عنك ذكر البر إني رأيته % لمن خاف هول البحر شر المهاوب % 75(@)(@@) % كلا نزليه صيفه وشتاؤه % خلاف لما أهواه غير مصاقب % 76(@)(@@) % لهاث مميت تحت بيضاء سخنة % وري مفيت تحت أسحم صائب % 77(@)(@@) % يجف إذا ما أصبح الريق عاصبا % ويغدق لي والريق ليس بعاصب % 78(@)(@@) % ويمنع مني الماء واللوح جاهد % ويغرقني والري رطب المحالب % % 79(@)(@@) % وما زال يبغيني 
ms119	 الحتوف مواربا % يحوم على قتلي وغير موارب % 80(@)(@@) % فطورا يغاديني بلص مصلت دع اللوم إن اللوم عون النوائب % % ولا تتجاوز فيه حد المعاتب % PageV01P472 81(@)(@@) % فما كل من حط الرحال بمخفق % ولا كل من شد الرحال بكاسب % 82(@)(@@) % وفي السعي كيس والنفوس نفائس % وليس بكيس بيعها بالرغائب % 83(@)(@@) % وما زال مأمول البقاء مفضلا % على الملك والأرباح دون الحرائب % 84(@)(@@) % حضضت على حطبي لناري فلا تدع % لك الخير تحذيري شرور المحاطب % 85(@)(@@) % وأنكرت إشفاقي وليس بمانعي % % طلابي أن أبغي طلاب المكاسب % 86(@)(@@) % ومن يلق ما لاقيت في كل مجتنى % من الشوك يزهد في الثمار الأطايب % 87(@)(@@) % أذاقتني الأسفار ما كره الغنى % % إلي وأغراني برفض المطالب % 88(@)(@@) % فأصبحت في الإثراء أزهد زاهد % وإن كنت في الإثراء أرغب راغب % 89(@)(@@) % حريصا جبانا أشتهي ثم أنتهي % % بلحظي جناب الرزق لحظ المراقب % 90(@)(@@) % ومن راح ذا حرص وجبن فإنه % % فقير أتاه الفقر من كل جانب % PageV01P473 91(@)(@@) % ولما دعاني للمثوبة سيد % % يرى المدح عارا قبل بذل المثاوب % 92(@)(@@) % تنازعني رغب ورهب كلاهما % % قوي وأعياني اطلاع المغايب % 93(@)(@@) % فقدمت رجلا رغبة في رغيبة % وأخرت رجلا رهبة للمعاطب % 94(@)(@@) % أخاف على نفسي وأرجو مفازها % % وأستار غيب الله دون العواقب % 95(@)(@@) % ألا من يريني غايتي قبل مذهبي % % ومن أين والغايات بعد المذاهب % 96(@)(@@) % ومن نكبة لاقيتها بعد نكبة % رهبت اعتساف الأرض ذات المناكب % 97(@)(@@) % وصبري على الإقتار أيسر محملا % علي من التعرير بعد التجارب % 98(@)(@@) % لقيت من البر التباريح بعدما % % لقيت من البحر ابيضاض الذوائب % 99(@)(@@) % سقيت على ري به ألف مطرة % شغفت لبغضيها بحب المجادب % 100(@)(@@) % ولم أسقها بل ساقها لمكيدتي % % تحامق دهر جد بي كالملاعب % PageV01P474 101(@)(@@) % إلى الله أشكو سخف دهري فإنه % % يعابثني مذ كنت غير مطايب % 102(@)(@@) % أبى أن يغيث الأرض حتى إذا ارتمت % برحلي أتاها بالغيوث السواكب % % 103(@)(@@) % سقى الأرض من أجلي فأضحت مزلة % تمايل صاحيها تمايل شارب % 104(@)(@@) % لتعويق سيري أو دحوض مطيتي % % وإخصاب مزور عن المجد ناكب % 105(@)(@@) % فملت إلى خان مرث بناؤه % % مميل 
ms120	 غريق الثوب لهفان لاغب % 106(@)(@@) % فلم ألق فيه م ستراحا لمتعب % % ولا نزلا أيان ذاك لساغب % 107(@)(@@) % فما زلت في خوف وجوع ووحشة % وفي سهر يستغرق الليل واصب % 108(@)(@@) % يؤرقني سقف كأني تحته % % من الوكف تحت المدجنات الهواضب % 109(@)(@@) % تراه إذا ما الطين أثقل متنه % تصر نواحيه صرير الجنادب % 110(@)(@@) % وكم خان سفر خان فانقض فوقهم % % كما انقض صقر الدجن فوق الأرانب % PageV01P475 111(@)(@@) % ولم أنس ما لاقيت أيام صحوه % من الصر فيه والثلوج الأشاهب % 112(@)(@@) % وما زال ضاحي البر يضرب أهله % بسوطي عذاب جامد بعد ذائب % % 113(@)(@@) % فإن فاته قطر وثلج فإنه % % رهين بساف تارة أو بحاصب % 114(@)(@@) % فذاك بلاء البر عندي شاتيا % وكم لي من صيف به ذي مثالب % 115(@)(@@) % ألا رب نار بالفضاء اصطليتها % % من الضح يودي لفحها بالحواجب % 116(@)(@@) % إذا ظلت البيداء تطفو إكامها % % وترسب في غمر من الآل ناضب % 117(@)(@@) % فدع عنك ذكر البر إني رأيته % لمن خاف هول البحر شر المهاوب % 118(@)(@@) % كلا نزليه صيفه وشتاؤه % خلاف لما أهواه غير مصاقب % 119(@)(@@) % لهاث مميت تحت بيضاء سخنة % وري مفيت تحت أسحم صائب % 120(@)(@@) % يجف إذا ما أصبح الريق عاصبا % ويغدق لي والريق ليس بعاصب % PageV01P476 121(@)(@@) % ويمنع مني الماء واللوح جاهد % ويغرقني والري رطب المحالب % % 122(@)(@@) % وما زال يبغيني الحتوف مواربا % يحوم على قتلي وغير موارب % 123(@)(@@) % فطورا يغاديني بلص مصلت % وطورا يمسيني بورد الشوارب % 124(@)(@@) % إلى أن وقاني الله محذور شره % بعزته والله أغلب غالب % 125(@)(@@) % فأفلت من ذؤبانه وأسوده % وحرابه إفلات أتوب تائب % 126(@)(@@) % وأما بلاء البحر عندي فإنه % % طواني على روع مع الروح واقب % 127(@)(@@) % ولو ثاب عقلي لم أدع ذكر بعضه % ولكنه من هوله غير ثائب % % 128(@)(@@) % ولم لا ولو ألقيت فيه وصخرة % لوافيت منه القعر أول راسب % 129(@)(@@) % ولم أتعلم قط من ذي سباحة % سوى الغوص والمضعوف غير مغالب % 130(@)(@@) % فأيسر إشفاقي من الماء أنني % % أمر به في الكوز مر المجانب % PageV01P477 131(@)(@@) % وأخشى الردى منه على كل شارب % % فكيف بأمنيه على 