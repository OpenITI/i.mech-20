ms136	 في حديثه نظر.(@)(@@)(@@)(@@) || فطر(@)PageV01P321(@)(@@)(@@)(@@) $ 3394 - فطر بن حماد بن واقد البصري: قال أبو حاتم: ليس بالقوي.(@)(@@)(@@)(@@) $ 3395 - فطر بن خليفة: ثقة، شيعي، قال الجوزجاني: زائغ غير ثقة. -عه- خ مقرونا-(@)(@@)(@@)(@@) $ 3396 - فطر بن محمد العطار الأحدب: قال الدارقطني: حدثونا عنه.(@)(@@)(@@)(@@) || فليح(@)PageV01P322(@)(@@)(@@)(@@) $ 3397 - فليح بن سليمان المدني: له غرائب، قال ابن معين والنسائي: ليس بقوي. -ع-(@)(@@)(@@)(@@) || فهد(@)PageV01P322(@)(@@)(@@)(@@) $ 3398 - فهد بن حيان البصري: عن شعبة، ضعفوه.(@)(@@)(@@)(@@) $ 3399 - فهد بن عوف العامري: قال ابن المديني: كذاب، قلت: اسمه زيد.(@)(@@)(@@)(@@) || فياض(@)PageV01P322(@)(@@)(@@)(@@) $ 3400 - فياض بن محمد البصري: عن يحيى بن أبي كثير: مجهول.(@)(@@)(@@)(@@) || الفيض(@)PageV01P322(@)(@@)(@@)(@@) $ 3401 - الفيض بن وثيق: قال ابن معين: كذاب خبيث، له عن أبي عوانة.(@)(@@)(@@)(@@) | حرف القاف(@)PageV01P322(@)(@@)(@@)(@@) || قابوس(@)PageV01P322(@)(@@)(@@)(@@) $ 3402 - قابوس بن أبي ظبيان: قال النسائي وغيره: ليس بالقوي. -د، ت، ق-(@)(@@)(@@)(@@) || قاسم(@)PageV01P322(@)(@@)(@@)(@@) $ 3403 - قاسم بن إبراهيم الملطي: عن مالك، قال الدارقطني: كذاب.(@)(@@)(@@)(@@) $ 3404 - قاسم بن إبراهيم الهاشمي الكوفي: عن أبي نعيم، جرحه ابن حبان.(@)(@@)(@@)(@@) $ 3405 - قاسم بن أمية الحذاء: عن حفص بن غياث، جرحه ابن حبان. -ت-(@)(@@)(@@)(@@) $ 3406 - قاسم بن بهرام: عن أبي الزبير، يأتي بعجائب، وهاه ابن حبان.(@)(@@)(@@)(@@) $ 3407 - قاسم بن حبيب التمار: عن نزار بن حيان، قال يحيى: لا شيء. -ت-(@)(@@)(@@)(@@) $ 3408 - قاسم بن الحسن الفلكي الهمذاني: معاصر للطبراني، تكلم فيه.(@)(@@)(@@)(@@) $ 3409 - قاسم بن الحكم: عن أبي عبادة الزرقي: مجهول.(@)(@@)(@@)(@@) $ 3410 - قاسم بن عبد الله بن محمد بن عقيل: قال ابن معين: ليس بشيء.(@)(@@)(@@)(@@) $ 3411 - قاسم بن عبد الله بن عمر العمري: عن ابن المنكدر، قال أحمد: كان يكذب ويضع. -ق-(@)(@@)(@@)(@@) $ 3412 - قاسم بن عبد الله المكفوف: عن سلم الخواص، اتهمه ابن حبان.(@)(@@)(@@)(@@) $ 3413 - قاسم بن عبد الله: مجهول، يروي عنه هنيد بن القاسم. - ق-(@)(@@)(@@)(@@) || القاسم(@)PageV01P323(@)(@@)(@@)(@@) $ 3414 - القاسم بن عبد الله بن مهدي الإخميمي: شيخ ابن عدي، فيه ضعف.(@)(@@)(@@)(@@) $ 3415 - القاسم بن عبد الرحمن، أبو عبد الرحمن: مولى خالد بن يزيد بن معاوية، قال أحمد: حدث عنه علي بن يزيد بأعاجيب ما أراها إلا من قبل القاسم. -ع(@)(@@)(@@)(@@) $ 3416 - القاسم بن عبد الرحمن: عن أبيه، عن أبي هريرة: مجهول. 
ms137	(@)(@@)(@@)(@@) $ 3417 - القاسم بن عمر الأنصاري: معمر متهم، قال أبو حاتم: مضطرب الحديث.(@)(@@)(@@)(@@) $ 3418 - القاسم بن عوف: تابعي، قال أبو حاتم: مضطرب الحديث. -م، ق-(@)(@@)(@@)(@@) $ 3419 - القاسم بن غصن: عن مسعر، ضعفه أبو حاتم وغيره.(@)(@@)(@@)(@@) $ 3420 - القاسم بن غنام: مدني، تابعي، قال العقيلي: في حديثه اضطراب. -د، ت-(@)(@@)(@@)(@@) $ 3421 - القاسم بن فياض: شيخ لهشام بن يوسف الصنعاني، ضعفوه. -د، س-(@)(@@)(@@)(@@) $ 3422 - القاسم بن محمد بن حفص: عن أبيه، وأبوه تابعي، كلاهما مجهولان.(@)(@@)(@@)(@@) $ 3423 - القاسم بن محمد بن حماد الدلال: قال الدارقطني: ضعيف حدثونا عنه.(@)(@@)(@@)(@@) $ 3424 - القاسم بن محمد بن حميد المعمري: قال ابن معين: كذاب خيث.(@)(@@)(@@)(@@) $ 3425 - القاسم بن محمد بن عبد الله بن محمد بن عقيل: قال أبو حاتم وغيره: متروك، وقال أحمد: ليس بشيء. قلت: هو القاسم بن عبد الله، نسب إلى جده.(@)(@@)(@@)(@@) $ 3426 - القاسم بن محمد بن أبي شيبة: أخو أبي بكر، قال أبو حاتم: تركت حديثه.(@)(@@)(@@)(@@) $ 3427 - القاسم بن محمد الفرغاني: عن أبي عاصم النبيل، قال الحاكم: كان يضع.(@)(@@)(@@)(@@) $ 3428 - القاسم بن مطيب: عن أبي المليح الهذلي، تركه ابن حبان.(@)(@@)(@@)(@@) $ 3429 - القاسم بن مندة الأصبهاني: عن الشاذكوني، ضعيف.(@)(@@)(@@)(@@) $ 3430 - القاسم بن مهران: عن أبي الزبير، قال الأزدي: مجهول.(@)(@@)(@@)(@@) $ 3431 - القاسم، أبو نوح. والقاسم بن المعتمر، وقاسم الكناني: مجهولون.(@)(@@)(@@)(@@) $ 3432 - القاسم بن هانئ: عن الليث بن سعد، لينه العقيلي.(@)(@@)(@@)(@@) $ 3433 - القاسم بن يزيد بن عبد الله بن قسيط: عن أبيه، حديثه منكر.(@)(@@)(@@)(@@) $ 3434 - القاسم بن يزيد: عن علي، وما أدركه، فهو منقطع. -ق-(@)(@@)(@@)(@@) || قبيصة(@)PageV01P325(@)(@@)(@@)(@@) $ 3435 - قبيصة بن حريث: عن سلمة بن المحبق، في حديثه نظر، وهو فيمن أصاب جارية زوجته، قاله البخاري. -د، س، ق-(@)(@@)(@@)(@@) || قتيبة(@)PageV01P326(@)(@@)(@@)(@@) $ 3436 - قتيبة بن سعيد التيمي: عن يحيى بن أبي أنيسة: مجهول.(@)(@@)(@@)(@@) $ 3437 - قتيبة، أبو محمد: عن شيبان: مجهول.(@)(@@)(@@)(@@) || قتير(@)PageV01P326(@)(@@)(@@)(@@) $ 3438 - قتير، صاحب معاوية: كذلك.(@)(@@)(@@)(@@) || قحافة(@)PageV01P326(@)(@@)(@@)(@@) $ 3439 - قحافة: عن الزبير، لا يعرف.(@)(@@)(@@)(@@) || قدامة(@)PageV01P326(@)(@@)(@@)(@@) $ 3440 - قدامة بن محمد المدني: عن أبيه، ومخرمة بن بكير، جرحه ابن حبان. -س-(@)(@@)(@@)(@@) $ 3441 - قدامة بن وبرة: عن سمرة: مجهول. -د، س-(@)(@@)(@@)(@@) || قرثع(@)PageV01P326(@)(@@)(@@)(@@) $ 3442 - قرثع الضبي: 
ms138	 عن سلمان الفارسي، ذكره ابن حبان في الضعفاء. -د، س، ق-(@)(@@)(@@)(@@) || قرة(@)PageV01P326(@)(@@)(@@)(@@) $ 3443 - قرة بن بشر: عن أبي بردة: مجهول.(@)(@@)(@@)(@@) $ 3444 - قرة بن عبد الرحمن بن حيوئيل: قال أحمد: منكر الحديث جدا.(@)(@@)(@@)(@@) || قريش(@)PageV01P327(@)(@@)(@@)(@@) $ 3445 - قريش بن أنس: عن ابن عون، وثقه ابن معين، وقال أبو داود: تغير. -خ، م، د، س، ت-(@)(@@)(@@)(@@) || قرين(@)PageV01P327(@)(@@)(@@)(@@) $ 3446 - قرين بن سهل: عن أبيه، عن ابن أبي ذئب، كذبه الأزدي. -م-(@)(@@)(@@)(@@) || قزعة(@)PageV01P327(@)(@@)(@@)(@@) $ 3447 - قزعة بن سويد الباهلي: قال أحمد: مضطرب الحديث. وقال النسائي: ضعيف، وقال أبو حاتم: لا يحتج به. -ت، ق-(@)(@@)(@@)(@@) || قطبة(@)PageV01P327(@)(@@)(@@)(@@) $ 3448 - قطبة بن العلاء: عن الثوري، ضعفه النسائي، وغيره.(@)(@@)(@@)(@@) || قطن(@)PageV01P327(@)(@@)(@@)(@@) $ 3449 - قطن بن سعير بن الخمس: قال ابن معين: رجل سوء.(@)(@@)(@@)(@@) $ 3450 - قطن بن صالح الدمشقي: عن ابن جريج، قال الأزدي: كذاب.(@)(@@)(@@)(@@) $ 3451 - قطن بن نسير، أبو عباد الغبري: قال ابن معين: يسرق الحديث ويوصله، وكان أبو زرعة يحمل عليه. -م، د، ت-(@)(@@)(@@)(@@) || قرظة(@)PageV01P328(@)(@@)(@@)(@@) $ 3452 - قرظة: عن عكرمة، لا يعرف.(@)(@@)(@@)(@@) || قنان(@)PageV01P328(@)(@@)(@@)(@@) $ 3453 - قنان بن عبد الله النهمي: عن التابعين، قال النسائي: ليس بالقوي.(@)(@@)(@@)(@@) || قنبر(@)PageV01P328(@)(@@)(@@)(@@) $ 3454 - قنبر: عن علي رضي الله عنه، وعنه ابنه عبد الله، حديثه منكر جدا.(@)(@@)(@@)(@@) || قيس(@)PageV01P328(@)(@@)(@@)(@@) $ 3455 - قيس بن الحصين الكعبي: مجهول.(@)(@@)(@@)(@@) $ 3456 - قيس بن الربيع: تابعي، له حديث وهو منكر.(@)(@@)(@@)(@@) $ 3457 - قيس بن الربيع الأسدي الكوفي: صدوق، لا يحتج به. -د، ت، ق-(@)(@@)(@@)(@@) $ 3458 - قيس بن رومي: عن علقمة: مجهول. -ق-(@)(@@)(@@)(@@) $ 3459 - قيس بن سالم: عن أي أمامة بن سهل، ينفرد بحديث في الدعاء.(@)(@@)(@@)(@@) $ 3460 - قيس بن طلق بن علي: عن أبيه، ضعفه أحمد وابن معين. -عه-(@)(@@)(@@)(@@) $ 3461 - قيس بن عبد الرحمن: عن الضحاك بن عثمان: مجهول، ضعفه الأزدي.(@)(@@)(@@)(@@) $ 3462 - قيس بن كعب: عن معن بن عبد الرحمن: مجهول، وحديثه منكر.(@)(@@)(@@)(@@) $ 3463 - قيس بن ميناء: عن سلمان يرفعه قال: «وصيي علي» لا يصح.(@)(@@)(@@)(@@) $ 3464 - قيس، أبو عمارة: عن عبد الله بن أبي بكر بن حزم، لا يصح. -ق-(@)(@@)(@@)(@@) | حرف الكاف(@)PageV01P329(@)(@@)(@@)(@@) || كادح(@)PageV01P329(@)(@@)(@@)(@@) $ 3465 - كادح بن جعفر: عن ابن لهيعة، قال الأزدي: ضعيف زائغ.(@)(@@)(@@)(@@) $ 3466 - كادح بن رحمة: عن 
ms139	 الثوري، قال الأزدي: كذاب.(@)(@@)(@@)(@@) || كامل(@)PageV01P329(@)(@@)(@@)(@@) $ 3467 - كامل بن طلحة الجحدري: قال أحمد: ما أعلم أحدا يدفعه بحجة. -ل-(@)(@@)(@@)(@@) $ 3468 - كامل بن العلاء، أبو العلاء السعدي الكوفي: جرحه ابن حبان. -د، ت، ق-(@)(@@)(@@)(@@) || كثير(@)PageV01P329(@)(@@)(@@)(@@) $ 3469 - كثير بن حمير الأصم: شيخ لموسى بن أيوب النصيبي، قال ابن حبان: لا يجوز الاحتجاج به.(@)(@@)(@@)(@@) $ 3470 - كثير بن زاذان: كوفي، من التابعين، لا يعرف. -ت، ق-(@)(@@)(@@)(@@) $ 3471 - كثير بن زيد الأسلمي المدني: ضعفه النسائي وغيره. -ق-(@)(@@)(@@)(@@) $ 3472 - كثير بن سليم الضبي: قال ابن معين والدارقطني: ضعيف، وقال النسائي: متروك، وقال ابن حبان: له عن أبيه عن جده نسخة موضوعة، وقال آخرون: ضعيف -ق- أما كثير بن عبد الله اليشكري عن الحسن، فلم يضعف. -د، ت، ق-(@)(@@)(@@)(@@) $ 3473 - كثير بن أبي كثير عبد الرحمن: عن عطاء، قال العقيلي: تفرد بحديث.(@)(@@)(@@)(@@) $ 3474 - كثير بن كثير: عن ربعي بن حراش، ضعفه ابن معين.(@)(@@)(@@)(@@) $ 3475 - كثير بن محمد العجلي: مجهول.(@)(@@)(@@)(@@) $ 3476 - كثير بن مروان الفهري. والد محمد بن كثير: ضعفوه.(@)(@@)(@@)(@@) $ 3477 - كثير بن معبد القيسي: ضعفه الأزدي.(@)(@@)(@@)(@@) $ 3478 - كثير النواء، أبو إسماعيل: عن عطية، ضعفوه زائغ.(@)(@@)(@@)(@@) || كدير(@)PageV01P330(@)(@@)(@@)(@@) $ 3479 - كدير الضبي: تفرد عنه أبو إسحاق، ضعفه البخاري، والنسائي، وعده بعضهم صحابيا.(@)(@@)(@@)(@@) || كريب(@)PageV01P330(@)(@@)(@@)(@@) $ 3480 - كريب بن الطيب: مجهول.(@)(@@)(@@)(@@) || كريد(@)PageV01P331(@)(@@)(@@)(@@) $ 3481 - كريد بن رواحة: عن شعبة وغيره، له مناكير.(@)(@@)(@@)(@@) || كريم(@)PageV01P331(@)(@@)(@@)(@@) $ 3482 - كريم بن الحارث: شيخ لأبي إسحاق: مجهول.(@)(@@)(@@)(@@) || كعب(@)PageV01P331(@)(@@)(@@)(@@) $ 3483 - كعب، أبو عامر المدني: عن أبي هريرة رضي الله عنه: مجهول. -ت، ق-(@)(@@)(@@)(@@) || كلثوم(@)PageV01P331(@)(@@)(@@)(@@) $ 3484 - كلثوم بن جوشن العنبري: عن الحسن، ضعفه أبو حاتم. -ق-(@)(@@)(@@)(@@) $ 3485 - كلثوم بن زياد: قاضي دمشق، ضعفه النسائي.(@)(@@)(@@)(@@) $ 3486 - كلثوم بن محمد بن أبي سدرة: قال أبو حاتم: يتكلمون فيه.(@)(@@)(@@)(@@) $ 3487 - كلثوم بن مرثد الكوفي: مجهول.(@)(@@)(@@)(@@) || كليب(@)PageV01P331(@)(@@)(@@)(@@) $ 3488 - كليب بن وائل البكري: وثقه ابن معين، وضعفه أبو حاتم.(@)(@@)(@@)(@@) || كميل(@)PageV01P331(@)(@@)(@@)(@@) $ 3489 - كميل بن زياد: صاحب علي، تكلم فيه ابن حبان.(@)(@@)(@@)(@@) || كنانة(@)PageV01P332(@)(@@)(@@)(@@) $ 3490 - كنانة بن جبلة: عن إبراهيم بن طهمان، قال ابن معين: كذاب.(@)(@@)(@@)(@@) $ 3491 - كنانة بن العباس بن مرداس السلمي: جرحه ابن حبان. -د، ق-(@)(@@)(@@)(@@) || كوثر(@)PageV01P332(@)(@@)(@@)(@@) $ 3492 
ms140	 - كوثر بن حكيم: عن عطاء، ونافع، ضعيف متروك.(@)(@@)(@@)(@@) || كلاب(@)PageV01P332(@)(@@)(@@)(@@) $ 3493 - كلاب بن تليد: مجهول، عداده في تابعي أهل المدينة. -س-(@)(@@)(@@)(@@) $ 3494 - كلاب بن علي: عن أبي سلمة: مجهول.(@)(@@)(@@)(@@) $ 3495 - كلاب بن علي العامري: قديم لا يعرف، روى عنه منصور.(@)(@@)(@@)(@@) || كيسان(@)PageV01P332(@)(@@)(@@)(@@) $ 3496 - كيسان، أبو عمرو القصار: عن يزيد بن بلال، ضعفه ابن معين.(@)(@@)(@@)(@@) $ 3497 - كيسان، أبو بكر: عن ابن سيرين، قال الأزدي: ضعيف.(@)(@@)(@@)(@@) | حرف اللام(@)PageV01P332(@)(@@)(@@)(@@) || لمازة(@)PageV01P332(@)(@@)(@@)(@@) $ 3498 - لمازة بن زبار، أبو لبيد: بصري، ناصبي، يشتم عليا. -د، ت، ق-(@)(@@)(@@)(@@) || لوذان(@)PageV01P332(@)(@@)(@@)(@@) $ 3499 - لوذان بن سليمان: شيخ لبقية، لا يعرف.(@)(@@)(@@)(@@) || لوط(@)PageV01P333(@)(@@)(@@)(@@) $ 3500 - لوط بن يحيى، أبو مخنف: متروك، وقال الدارقطني: ضعيف.(@)(@@)(@@)(@@) || ليث(@)PageV01P333(@)(@@)(@@)(@@) $ 3501 - ليث بن أنس: عن ابن سيرين، كان قدريا صفريا زائغا.(@)(@@)(@@)(@@) $ 3502 - ليث بن سالم: عن هشام بن عروة: مجهول.(@)(@@)(@@)(@@) $ 3503 - ليث بن أبي سليم الكوفي: حسن الحديث، ومن ضعفه فإنما ضعفه لاختلاطه بآخرة. -عه، م- مقرونا.(@)(@@)(@@)(@@) $ 3504 - ليث بن عمرو بن سام: قال النسائي: ضعيف.(@)(@@)(@@)(@@) $ 3505 - ليث بن محمد الموقري. وليث بن أبي مريم: قال النسائي: متروكان.(@)(@@)(@@)(@@) $ 3506 - ليث بن أبي المساور: عن عبد الله العمري، ضعفه الأزدي.(@)(@@)(@@)(@@) | حرف الميم(@)PageV01P333(@)(@@)(@@)(@@) || الماضي(@)PageV01P333(@)(@@)(@@)(@@) $ 3507 - الماضي بن محمد المصري: شيخ لابن وهب: مجهول. -ق-(@)(@@)(@@)(@@) || مالك(@)PageV01P333(@)(@@)(@@)(@@) $ 3508 - مالك بن أعين الجهني: عن زيد بن وهب: مجهول.(@)(@@)(@@)(@@) $ 3509 - مالك بن دينار الزاهد: حسن الحديث، وثقه النسائي. -عه-(@)(@@)(@@)(@@) $ 3510 - مالك بن الحسن بن مالك بن الحويرث: عن أبيه، عن جده، تفرد بالرواية عنه عمران بن أبان.(@)(@@)(@@)(@@) $ 3511 - مالك بن أبي الحسن: عن الحسن البصري، لا يكاد يعرف.(@)(@@)(@@)(@@) $ 3512 - مالك بن حمزة: عن أبي أسيد، لا يتابع على حديثه. -د، ق-(@)(@@)(@@)(@@) $ 3513 - مالك بن زبيد الهمداني: عن أبي ذر: مجهول.(@)(@@)(@@)(@@) $ 3514 - مالك بن سعير بن الخمس: صدوق، ضعفه حتى ولو أبو داود. -م، ت، ق-(@)(@@)(@@)(@@) $ 3515 - مالك بن سليمان: عن يزيد الضبي، بصري، جرحه ابن حبان.(@)(@@)(@@)(@@) $ 3516 - مالك بن الصباح: عن بعض الصحابة، لا يعرف.(@)(@@)(@@)(@@) $ 3517 - مالك بن عبيدة: عن أبيه، عن جده، ومالك بن عثمان: مجهولان.(@)(@@)(@@)(@@) $ 3518 - مالك بن غسان: عن ثابت، كمجهول، 