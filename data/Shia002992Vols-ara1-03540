ms3525	 عنه أحمد بن محمد.(@)(@@) الكافي: ج 4، ك 3، ب 92، ح 9.(@)(@@) * وروى عن الحسن الصيقل، وروى عنه أحمد بن محمد بن أبي نصر.(@)(@@) الكافي: ج 5، ك 3، ب 81، ح 2.(@)(@@) * وروى عن الحسين بن حماد، وروى عنه أحمد بن محمد بن أبي نصر.(@)(@@) التهذيب: ج 2، ح 1465.(@)(@@) * وروى عن زرارة، وروى عنه ابن أبي نصر. PageV11P432(@)(@@) الكافي: ج 6، ك 2، ب 69، ح 5.(@)(@@) * وروى عن سليمان بن خالد، وروى عنه الوشاء.(@)(@@) الكافي: ج 1، ك 4، ب 24، ج 2.(@)(@@) * وروى عن سماعة، وروى عنه ابن أبي نصر.(@)(@@) الكافي: ج 7، ك 7، ب 14، ح 3.(@)(@@) والتهذيب: ج 8، ح 1011.(@)(@@) وروى عنه أحمد بن محمد بن أبي نصر.(@)(@@) الكافي: ج 5، ك 2، ب 127، ح 1، و ج 7، ك 4، ب 48، ح 4. والتهذيب: ج 5، ح 164 (الاستبصار: ج 2، ح 536)، و ج 7، ح 861 (الاستبصار: ج 3، ح 457)، و ج 8، ح 1177 (الاستبصار:(@)(@@) ج 2، ح 536)، و ج 10، ح 699.(@)(@@) * وروى عن عبد الله بن سليمان الصيرفي، وروى عنه أحمد بن محمد بن أبي نصر.(@)(@@) الكافي: ج 6، ك 2، ب 4، ح 2.(@)(@@) * وروى عن محمد بن حكيم، وروى عنه أحمد بن محمد بن أبي نصر البزنطي.(@)(@@) الكافي: ج 6، ك 2، ب 34، ح 2.(@)(@@) والتهذيب: ج 8، ح 405.(@)(@@) * وروى عن محمد بن مسلم، وروى عنه أحمد بن محمد بن أبي نصر.(@)(@@) الكافي: ج 5، ك 3، ب 82، ح 5.(@)(@@) والتهذيب: ج 7، ح 1277 (الاستبصار:(@)(@@) ج 3، ح 680).(@)(@@) * وروى عن يزيد بن خليفة، وروى عنه محمد بن أحمد.(@)(@@) التهذيب: ج 5، ج 1242 (الاستبصار:(@)(@@) ج 2، ح 695).(@)(@@) * وروى عن الحلبي، وروى عنه ابن أبي نصر.(@)(@@) الكافي: ج 6، ك 2، ب 74، ح 8.(@)(@@) والتهذيب: ج 5، ح 1452 (الاستبصار:(@)(@@) ج 2، ح 1147، وفيه أحمد بن محمد بن أبي نصر)، و ج 8، ح 672، و ج 10، ح 296.(@)(@@) وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 5، ك 2، ب 132، ح 6، و ج 6، ك 2، ب 65، ح 2. والتهذيب: ج 8، ح 682.(@)(@@) وروى عنه أحمد بن محمد بن أبي نصر.(@)(@@) الكافي: ج 4، ك 3، ب 66، ح 1، و ج 6، ك 2، ب 4، ح 6، وك 3، ب 14، ح 2، و ج 7، ك 3، ب 29، ح 7. والتهذيب:(@)(@@) ج 8، ح 145 و 776.(@)(@@) وروى عنه أحمد بن محمد بن أبي نصر 
