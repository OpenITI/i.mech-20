ms511	 و امسال همی %~% بوسها رشوه دهد تاش در آرم به ‌کنار(@)(@@) 5 زانسوی بوسه مرا کار کشیدست‌ کنون %~% بس‌ که می‌بینم‌ کز بوسه ندارد انکار(@)(@@) 6 شعر کردست شعار خود و زینرو با من %~% رام ‌گشتست بدانگونه‌ که ‌گویند اغیار(@)(@@) 7 یارب این آبله رو ابلهک مفلس زشت %~% بچه تدبیر به شیرین پسران ‌گردد یار(@)(@@) 8 هر کجا هست غزلگوی غزالی در شهر %~% پی صیدش همه دم دام نهد از اشعار(@)(@@) 9 لب خوبان مگس نحل و ندیدم جز او %~% عنکبوتی‌که نماید مگس نحل شکار(@)(@@) 10 راست گویند حکیمان جهان دیده که نیست %~% لاله بی‌داغ و شکر بی‌مگس وگل بی‌خار(@)(@@) 11 نشود شاهد زیبارو جز همدم زشت %~% نخورد خربزه شیرین الا کفتار(@)(@@) 12 الغرض پار اگر یار مرا دادی بوس %~% از سر خشم یکی را دو همی‌ کرد شمار(@)(@@) 13 وینک امسال چو بر روی و لبش بوسه زنم %~% شصت را شش شمرد سی را سه چل را چار(@)(@@) 14 هی همی شعر ز من گیرد و هی بوسه دهد %~% خرم آنکو چو منش شعر فروشیست شعار(@)(@@) 15 هرکه یک شعر مرا بیند اندر بر او %~% حالی‌اندر عوض او دهدش بوسه هزار(@)(@@) 16 کاغذ شعر مرا پار اگر می‌بردند %~% به یکی کاغذ دارو نخریدی عطار(@)(@@) 17 لیکن امسال به تقلید بت ساده من %~% کمترین شعر مرا هست رواج دینار(@)(@@) 18 یار تنها نه چنینست‌ که هر جا صنمی است %~% از پی شعر و غزل در بر من جوید بار(@)(@@) 19 هر پریرو که بدو شعر مرا برخوانی %~% به تو مشتاق بود چون به ‌گل سرخ هزار(@)(@@) 20 شعر من همچو عزایم شده افسون پری %~% که پری‌وار کند ساده رخان را احضار(@)(@@) 21 شعر من‌ گر به سر زلف نکویان بندی %~% با تو آنگونه شود رام ‌که با افسون مار(@)(@@) 22 هر کسی شعر من امروز فروشد به سلم %~% ده دو افزون خرد از نقره خالص تجار(@)(@@) 23 خادم خانه همی 
ms512	 شعر مرا می‌دزدد %~% کش فروشد عوض سیم و طلا در بازار(@)(@@) 24 هرشب آید بر من دوست چو یک خرمن گل %~% وز لب خود دهدم قند و شکر یک خروار(@)(@@) 25 من‌کنون ‌کرم قزم آن لب یاقوتی توت %~% زان خورم توت و ز اشعار تنم هر دم تار(@)(@@) 26 شعر من راست به ابریشم‌ گیلان ماند %~% که خرندش به‌سلف ‌پیله‌وران در امصار(@)(@@) 27 غالبآ شعر من اینگونه از آن رایج شد %~% که پسند افتاد در حضرت مخدو‌م‌ کبار(@)(@@) 28 آن حسن اسم و حسن رسم‌ که‌گویی ز ازل %~% خلق‌گشتست ز خلق خوش او باد بهار(@)(@@) 29 آنکه یارد ز پی منع حوادث شب و روز %~% گرد بر گرد جهان را کشد از حزم حصار(@)(@@) 30 ابر نیسان اگر از همت او جوید فیض %~% عوض‌گل همه یاقوت دمد از گلزار(@)(@@) 31 کف او گویی آتش بود و سیم سپند %~% زان نگیرد نفسی در بر او سیم قرار(@)(@@) 32 پنج ماهیست به دریای‌ کفش پنج انگشت %~% گر چه ماهی نشنیدم ‌که بود گوهربار(@)(@@) 33 در سه ماهیش یکی مار بود نامش‌کلک %~% لیک ماری‌ که از و مشک بود در رفتار(@)(@@) 34 مار دیدی‌ که‌ گهر بارد بر صفحه سیم %~% یا شنیدی ‌که ‌کند مشک به‌ کافور نثار(@)(@@) 35 مار دیدی‌که فشاند به دل زهر شکر %~% یا خورد در عوض خاک سیه مشک تتار(@)(@@) 36 مار دیدستی چون نحل فرو ریزد شهد %~% مار دیدستی چون نخل رطب آرد بار(@)(@@) 37 نی نه مارس یکی طوطی شکر شکنست %~% زان دمادم به سوی هند پرد طوطی‌وار(@)(@@) 38 طوطی ار پرش سبزستی و منقارش سرخ %~% او بود طوطی زرین پر مشکین منقار(@)(@@) 39 عنبر آرد اگر از بحر کفش نیست عجب %~% عنبر آرند بلی مردم از دریا بار(@)(@@) 40 ای ‌که ‌گر آیت حزم تو بر اعدا بدمند %~% در نهانخانه تقدیر ببینند اسرار(@)(@@) 41 تا که‌ کالای وجود تو به بازار آمد %~% آسمان بر در دکان 
ms513	 عدم زد مسمار(@)(@@) 42 کلک سحار تو چون شعر نویسدگویی %~% صورت روح‌ کند بر پر جبریل نگار(@)(@@) 43 گر تو گویی نبی استم من و شعرم معجز %~% بر به پیغمبریت من‌ کنم اول اقرار(@)(@@) 44 عوض ‌کوزه همه جام جم آرد بیرون %~% گر مثل‌کوزه‌یی از فخر تو سازد فخار(@)(@@) 45 صاحبا خواستم از شاه تیولی در فارس %~% پیش از آنی‌ که به شیراز ز ری بندم بار(@)(@@) 46 شاه فرمود تیول تو بود ملک سخن %~% مر ترا همچو رعیت شعرا باج‌گزار(@)(@@) 47 چه تیولست ازین به ‌که محول داریم %~% وجه مرسوم تو بر صنفی از اصناف دیار(@)(@@) 48 از قضا زنده بد آن روز مهین مستوفی %~% کش بیامرزاد از فضل فراوان دادار(@)(@@) 49 گفت آن به‌که به قصابانش فرمان بدهیم %~% تا همی چرب زبانتر شود اندر اشعار(@)(@@) 50 شاه پذرفت و از آن پس‌ که ‌گرفتم فرمان %~% از پی آمدن فارس ز شه جستم بار(@)(@@) 51 چون به شیراز رسیدم در هرجایی من %~% گشت مایل به بتی سنگدلی سیم عذار(@)(@@) 52 دلبری ساده ‌که بد موی سیه بر رویش %~% چون یکی دسته سنبل‌ که دمد از گلنار(@)(@@) 53 لب او با همه گلشکر و گلقند که داشت %~% در شگفتم‌ که چرا بود دو چشمش بیمار(@)(@@) 54 جز خطش در شکن زلف ندیدم‌که روند %~% فوجی از مورچگان در شب تاری به قطار(@)(@@) 55 جز رخش در خم‌گیسو نشنیدم‌ که ‌کسی %~% روز رخشنده‌ کند تعبیه اندر شب تار(@)(@@) 56 اطلسی جز رخ زیباش ندیدم همه عمر %~% کز ملاحت بودش پود وز نیکویی تار(@)(@@) 57 زلف پیچانش طومار صفت خم در خم %~% ثبت ‌کرده غم دلها همه در آن طومار(@)(@@) 58 الغرض از پی مرسوم نرفتم دیگر %~% زانکه دیوانه خوبان نرود از پی‌کار(@)(@@) 59 لیکن امسال‌که شدکیسه ام از زر خالی %~% من شدم بی‌زر و مهروی من از من بیزار(@)(@@) 60 سرو گلچهره من غنچه صفت شد دلتنگ %~% تا شد ازسیم تهی پنجه 
ms514	 من همچو چنار(@)(@@) 61 خویش را گفتم لاقیدی و رندی تاکی %~% زین محبت بگذر انده و محنت بگذار(@)(@@) 62 چون حوالت شده مرسوم تو بر میش ‌‌کشان %~% اینک امضا را شو خویش‌کشان زی سالار(@)(@@) 63 خویشتن در عوض میش فدا کن بر میر %~% تا مگر از کرم میر شوی برخوردار(@)(@@) 64 ناظم‌کشور جم میر عجم شیر اجم %~% خصم یم ‌کان همم بحر کرم ‌کوه وقار(@)(@@) 65 رفتم وگفتم و پذرفت و هماندم فرمود %~% به مهین منشی عبدالله توقیع نگار(@)(@@) 66 که ز قاآنی فرمان مبارک بستان %~% بهمان نوع‌ که خواهد دلش امضا میدار(@)(@@) 67 او قلم قط زد و زانو زد و فرفر بنوشت %~% نامه‌یی چون پر طاووس پر از نقش و نگار(@)(@@) 68 برد زی میرش و زد مهر وز مهر آمد و داد %~% زود بگرفتم و بوسیدمش از جان صدبار(@)(@@) 69 لیک بازم زعنا بار گرانیست بدل %~% باری از یاری تو بو که سبک ‌گردد بار(@)(@@) 70 عشر آن راتبه هر سال‌کند کم دیوان %~% هست از آن کم شدنم بر دل رنجی بسیار(@)(@@) 71 دارم امیدکه بخشد به تو آن عشر امیر %~% تو به من بخشی و من نیز به طفلان صغار(@)(@@) 72 خواهش دیگرم آنست ‌که آن امضا را %~% میر از خامه خود زیب‌ دهد چون فرخار(@)(@@) 73 به خط خویش نماید به کلانتر مرقوم %~% که تو مرسوم فلان را بده و عذر میار(@)(@@) 74 بدو قسط اول سال آن را از میش کشان %~% بستان وجه بکن سعی و محصل بگمار(@)(@@) 75 هم بدینسان بدهش نقد به هر سال دگر %~% تا کند از دل و جان مدح شهنشاه شعار(@)(@@) 76 هم مرا بود بهر ساله ز شه انعامی %~% که نه امسال رسیدست و نه پیرار و نه پار(@)(@@) 77 میر فرمود تو بنویسی و خود بنویسد %~% نامه‌یی چند به دربار شه شیرشکار(@)(@@) 78 تا مگر عاطفت خواجه اعظم‌ گردد %~% مر مرا یمن یمینش سبب یسر یسار(@)(@@) 79 
ms515	 بر به مرسوم من انعام من افزوده شود %~% تنم از رنج شود ایمن و جان از تیمار(@)(@@) 80 یا مرخص‌ کندم میر که در خدمت تو %~% به ری آیم مگرم‌ کار شود همچو نگار(@)(@@) 81 این سه‌ کار ار شود از لطف عمیم تو درست %~% به سر و جان تو کز چرخ برین دارم عار(@)(@@) 82 هیچ دانی چکنم مختصری شرح دهم %~% تا ز طول سخنت می‌نشود طبع فکار(@)(@@) 83 بخرم خانئکی همچو یکی باغ بهشت %~% صورت ساده‌ رخان نقش‌کنم بر دیوار(@)(@@) 84 شاهدی غضبان گیرم ‌که زند سیلی و مشت %~% نه‌که هرلحظه‌گشاید ز میان بند ازار(@)(@@) 85 گلرخ و سرو قد و لاله لب و نسرین بر %~% دلکش ومهو‌ش مشکین خط و سیمین رخسار(@)(@@) 86 لب میگونش چو بر مه نقطی از شنگرف %~% گرد آن نقطه خطش دایره‌یی از زنگار(@)(@@) 87 همه اسباب طرب‌ گرد کنم در خانه %~% از می و بربط و رود و نی و عود و دف و تار(@)(@@) 88 صد خم‌ کهنه ستانم همه قیر اندوده %~% قرب صد خروار انگور خرم از خلار(@)(@@) 89 آنگه انگورکنم دانه و ریزم در خم %~% هی همی لب زنمش بیگه وگه لیل و نهار(@)(@@) 90 تا بدان گه ‌که چو دیوانه ‌کف آرد بر لب %~% و آب انگور شود سرخ‌تر از آب انار(@)(@@) 91 زان شوم مست بدانگونه‌که در بیداری %~% می ندانم‌که به شیراز درم یا بلغار(@)(@@) 92 هر زمانی‌که خورم باده به یاد تو خورم %~% هم به‌جای تو زنم بوسه به رخسار نگار(@)(@@) 93 هی زنم‌ ساغر و هی بوسه‌ زنم بر رخ‌ دوست %~% هی خورم باده و هی نقل خورم از لب یار(@)(@@) 94 بر سر تخت سرینتث‌ن بکشم هرشب رخت %~% هم بدانسان ‌که رود کبک دری بر کهسار(@)(@@) 95 تا خدایم به صف حشر بیامرزد جرم %~% همه مدح تو کنم در عوض استغفار(@)(@@) 96 سال عمر تو چو تضعیف بیوت شطرنج %~% باد چندانکه به صد جهد 
ms516	 درآید به شمار(@)(@@) 97 فرخی گرچه بدین وزن و قوافی گفته %~% شهر غزنین نه‌همانست‌ که‌ من دیدم پار(@)(@@) 98 لیک بر تربتش این شعر کس ار بر خواند %~% آفرین گوید و از وجد بجنبد به مزار PageV1P257(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 یک دو مه پیشترک زانکه رسد فصل بهار %~% دلکی داشتم و دلبرکی باده‌گسار(@)(@@) 2 چون بهار آمد و گل رست ز من دل ببرید %~% بی‌وفایی ز گل آموخت مگر یا ز بهار(@)(@@) 3 بی‌ وفایی ‌گل آن بس ‌که‌ کند زود سفر %~% چون بهاران‌ که سه مه آید و بربندد بار(@)(@@) 4 الغرض دلبرکی بود غزلخوان و لطیف %~% گلرخ و سرو قد و سنگدل و سیم عذار(@)(@@) 5 به دو زلفش‌ عوض شانه همه تاب و شکن %~% به ‌دو چشمش‌ بدل سرمه ‌همه خواب و خمار(@)(@@) 6 ماری از ماه در آویخته‌ کاینم ‌گیسو %~% ناری از سرو برافراخته‌کاینم رخسار(@)(@@) 7 چهرش آنسان‌ که‌ کشی نقش‌ مهی از شنگرف %~% خطش آنسان‌ که ‌کنی طرح شبی از زنگار(@)(@@) 8 زلف بر چهره او هندوی خورشیدپرست %~% حسن در صورت او مانی تصویر نگار(@)(@@) 9 نه لبی داشت‌ کزان بوسه توان‌ کرد دریغ %~% نه رخی داشت‌ کزو صبر توان برد به ‌کار(@)(@@) 10 شوق بوسیدن آن لب دل من داشت نژند %~% ذوق بوییدن آن رخ تن من داشت نزار(@)(@@) 11 لب او مرکز خوبی به دو خط چنبر حسن %~% گرد آن چنبر زلفین سیه چون پرگار(@)(@@) 12 چشم عاشق‌کشش از دور به‌ایمابی‌گفت %~% که من از حسرت نادیدن خویشم بیمار(@)(@@) 13 خال بر چهره او در خم‌ گیسو گفتی %~% نقب بر گنج زند در شب دزدی عیار(@)(@@) 14 چشم می‌دوختم از وی ‌که نبینمش دگر %~% بی‌خبر در رخش از دیده دویدی دیدار(@)(@@) 15 مه نگویمش‌که مه را نبود نطق بشر %~% گل نخوانمش ‌که‌ گل را نبود صوت هزار(@)(@@) 16 مرغکی عاشق آبست‌که بوتیمارش %~% نام از آنست که پیوسته بود با تیمار(@)(@@) 17 بر لب نهر نشیند 
ms517	 نخورد آب از آن %~% که اگر آب خورم کم شود آب از انهار(@)(@@) 18 من هم‌از مر رخش‌اکم جرستم شب و روز %~% همچنان‌ کاب روان را نخورد بوتیمار(@)(@@) 19 نور و ظلمات من او بود بهرحال‌که بود %~% کز رخش چشم روشن شد و از زلفش تار(@)(@@) 20 طره‌یی داشت چو شب‌های زمستان ‌تاریک %~% وندران طره رخی تازه‌تر از روز بهار(@)(@@) 21 زلف و رخساره او بود چو باغی‌که در او %~% یک طرف سنبل تر روید و یک سو گلنار(@)(@@) 22 من به دو یار چو بلبل‌که بود عاشق‌گل %~% او به من رام چو گلبن که بود همدم خار(@)(@@) 23 گاه می‌گفتمش ای ترک بیا بوسه بده %~% گاه می‌گفتمش ای شوخ بیا باده بیار(@)(@@) 24 از پس می عوض نقل مرا دادی بوس %~% نه یکی بوسه نه ده بوسه نه صد بلکه هزار(@)(@@) 25 گر همی ‌گفتمش ای ماه مرا ده دو سه بوس %~% ده و سی دادی و خواندی دو سه در وقت شمار(@)(@@) 26 خلق‌گویند حکیمی به سوی خوزستان %~% آمد از هند و در آن شهر شکر کرد انبار(@)(@@) 27 زان شکر کژدم جراره همی‌گشت پدید %~% تا ازان شهر شکر کس نخرد بار به بار(@)(@@) 28 گفتم این حرف دروغست و ندارم باور %~% تا شبی زلف و لبش دیدم و کردم اقرار(@)(@@) 29 زانکه آن زلف سیه نیست از جراره %~% که به‌ گرد شکرین لعلش‌ گردد هموار(@)(@@) 30 باری او بود بهرحال مرا مایه عیش %~% چه به هنگام تفرج چه به هنگام شکار(@)(@@) 31 هر شب از هجر سخن گفت و نمی‌دانستم %~% کز چه رو می‌کند آن حرف دمادم تکرار(@)(@@) 32 تا بهار آمد و گل رست و جهان‌ گشت جوان %~% باد چون طره او شد به چمن غالیه‌بار(@)(@@) 33 رفت و با لاله‌رخان دامن صحرا بگرفت %~% با می و چنگ و نی و بربط و رود و دف و تار(@)(@@) 34 سبزه از شرم خطش‌ خواست رود زیر 
ms518	 زمین %~% گلبن از رشک رخش خواست فرو ریزد بار(@)(@@) 35 وز خیالی ‌که به دامانش درآویزد سرو %~% خواست کر شوق همی پنجه برآرد چو چنار(@)(@@) 36 تا قضا را شبی آمد بر من با دل تنگ %~% گفتم ای مه ز چه از صحبت من داری عار(@)(@@) 37 گفت تا بود خزان برگ و نوا بود ترا %~% چون بهار آمد برگ تو فرو ریخت ز بار(@)(@@) 38 خرج می کردی و معشوق هر آن چیز که بود %~% تو کنون بی‌ زری و من ز تو هستم بیزار(@)(@@) 39 من‌گرفتم‌ گل سرخم تو خریدار منی %~% مشتری تا ندهد زر نبرد گل به کنار(@)(@@) 40 گفتم ای ماه به تحقیق‌کنون دانستم %~% که ترا همچو گل سرخ وفا نیست شعار(@)(@@) 41 باورم‌‌ گشت ‌که بی ‌مهری و بدعهد چو گل %~% که به جز تربیتش نبود دهقان را کار(@)(@@) 42 پس یک سال‌ که بر‌گش به در آید ز درخت %~% دست دهقان را هردم‌ کند از خار فکار(@)(@@) 43 چون‌ کند غنچه و دهقان به تماشا رودش %~% کند از صحبت وی تنگدلی‌ها اظهار(@)(@@) 44 باز بعد از دو سه روزی ‌که به گلزار شکفت %~% بهر یک مشت زر از باغ رود در بازار(@)(@@) 45 به ‌عبث نیست‌ که در دیگ سیه زآتش سرخ %~% به مکافات بجوشاندش آخر عطار(@)(@@) 46 تو کنون آن ‌گل سرخی و من آن دهقانم %~% که ز بدعهدی خود رنج مراکردی خوار(@)(@@) 47 خار طعنم زدی و تنگدلی‌ها کردی %~% تا به بار آمدی و بر دلم افزودی بار(@)(@@) 48 چون شکفتی پی زر زود به بازار شدی %~% بس کن ای شاهد بازاری و جانم مازار(@)(@@) 49 گل‌ که عطار به جوشاندش آخر در دیگ %~% او ز عطار بترسد تو بترس از ستار(@)(@@) 50 گفت ای شاعرک خام مرا عشوه مده %~% حرف بیهوده مزن ریش مکن چانه مخار(@)(@@) 51 تا ترا کیسه ز زر پر نشود چون نرگس %~% تا ترا کاسه ز می 
ms519	 پر نشود چون ‌گلنار(@)(@@) 52 گر همه بدر شوی با تو نخواهم شد دوست %~% ور همه صدر شوی با تو نخواهم شد یار(@)(@@) 53 نام زر در لغت فارس از آنست درست %~% که به زر کار درست آید و بی‌زر دشوار(@)(@@) 54 مالک سیم نیی یاوه چه می‌بازی عشق %~% مفتی شهر نیی خیره چه بندی دستار(@)(@@) 55 گفتمش‌ گر نبود سیم و زرم عیب مکن %~% چهره من زر شمر و اشک مرا سیم انگار(@)(@@) 56 ‌گفت بس عاشق مفلس ‌که همین‌ عذر آورد %~% که به جز طعنه و تسخر نشنید از دلدار(@)(@@) 57 گفتم اکنون چکنم چاره این‌کار بگو %~% که ز تحصیل زر و سیم فروماندم زار(@)(@@) 58 گفت این حرف مزن‌ کاهلی و راحت دوست %~% کاهلی رنج تن و انده جان آرد بار(@)(@@) 59 نه مگر هر که ازین پیش بدی حاکم فارس %~% به‌ تو مرسوم تو پیش از همه‌ کردی ایثار(@)(@@) 60 نقد دادی به تو مرسوم و تشاریف ترا %~% پیش‌ از آنی‌ که ‌گل سرخ دمد در گلزار(@)(@@) 61 تا تو هر شام بتی ساده ‌کشی در آغوش %~% تا تو هر صبح بطی باده خری از خمار(@)(@@) 62 بلکه مرسوم دگر دادی از خویش به تو %~% تا ترا چیره شود کام و زبان در گفتار(@)(@@) 63 نیز انعام دگر داشتی از شاه بری %~% که نه امسال رسیدست و نه پیرار و نه پار(@)(@@) 64 بگذر از این همه آخر نه ترا حاکم فارس %~% زر به قنطار همی بخشد و اشتر به قطار(@)(@@) 65 کی ترا ملتمسی بود که رفتی بر او %~% گفتی و گفت برو رسم تکدی بگذار(@)(@@) 66 کی شنیدی‌ که بود حاکمی این‌گونه همیم %~% که رسد فیض ‌عمیمش چه به مو و چه به مار(@)(@@) 67 کی شنیدی‌که بود داوری این‌گونه کریم %~% که دهد یمن یمینش همه را یسر یسار(@)(@@) 68 اینک این هرچه مرادی ‌که ترا هست بدل %~% خیز درگوش خداوند بگو یا بنگار 
