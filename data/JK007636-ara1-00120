ms101	 آل يحيى كتاب الفضل متصل % % فيهم بكف قوي العزم طماح % % 25(@)(@@) % أنأى البرية عن آمال ملتمح % % تلك المعالي وأدناهم لممتاح % % 26(@)(@@) % قام الكفاة له طوعا ولو قعدوا % % قامت عليهم نواحيهم بأنواح % % 27(@)(@@) % ذو الرأي والقلم الهادي فواصف ذا % % و ذاك ما بين منصور وسفاح % % 28(@)(@@) % مدبر الملك في سر وفي علن % % و محكم الأمر من خاف ومن ضاحي % % 29(@)(@@) % و متبع البر للعافي بتهنئة % و سائق الهلك للعادي باسجاح % % 30(@)(@@) % فيالها من يد بالجود فائضة % وزند رأي لداجي الرأي قداح % % PageV01P461 31(@)(@@) % لا عيب فيه سوى علياء مخجلة % % بمعرب البر نطق اللاحن اللاحي % % 32(@)(@@) % و سحر لفظ بأدنى ما ينمقه % % عقاد ألسنة نفاث أرواح % % 33(@)(@@) % و بذل جاه و مال مع توفره % % أربى وزاد فقلنا بذل مزاح % % 34(@)(@@) % نجل الخلائف نبه عندها عمرا % و افخر بكل عمير البيت جحجاح % % 35(@)(@@) % المترعين جفانا كل داجية % % و المفزعين جفونا عند إصباح % % 36(@)(@@) % و الفاتحين بأقلام لهم وطنا % ممالكا لم يحلها عزم فتاح % % 37(@)(@@) % فان حموا بيضة الاسلام إنهم % من سادة في صميم العرب أمحاح % % 38(@)(@@) % أو كلموا بمواضيهم وألسنهم % % فانهم أهل إبلاغ وإفصاح % % 39(@)(@@) % أحييتهم يا ابن يحيى فابق مستبقا % للفضل ذا غرر فيه وأوضاح % % 40(@)(@@) % فرعا تلافي العلى أصلا لقد سجعت % % سواجع الحمد فيكم بين أدواح % % PageV01P462 41(@)(@@) % يا من له القلم المنهل بارقه % % بوابل في الوغى والسلم سحاح % % 42(@)(@@) % يا ذا البلاغة اسلاكا على حلل % % فالفضل ما بين وشاء ووشاح % % 43(@)(@@) % لا غروان نشأت منشا الرياض وفي % % يمناك كل نمير الودق دلاح % % 44(@)(@@) % إني لأشهد منها غير ماشهدت % % أفكار كل حسير الفكر لماح % % 45(@)(@@) % فليت شعري توفي حقها مدحا % و ليت شعري متى بالقرب أرباحي % % 46(@)(@@) % طال اطراحي وإبعادي فهل سبب % % لممسك بشباك اللغو طراح % % 47(@)(@@) % يا سيدا سر حسادي عليه فقد % % تمكنوا من قصي الغوث ملتاح % % 48(@)(@@) % قد كنت أروي لهم عن جابر زمنا % عنكم وها أنا أرويها لجراح % % 49(@)(@@) % و ليتني عارفا ذنبي فأجعله % % باب التقاضي لسهل العفو مرتاح % % 50 
ms102	(@)(@@) % إن كنت أعرف ذنبا أستحق به % % فراق عطفك لا فارقت أتراحي % % PageV01P463 51(@)(@@) % فالعفو منك لقد سد الصدود على % % ذهني مذاهب ينحو مثلها الناحي % % 52(@)(@@) % أرويت أرض نبات لو عنيت به % % كنت المحيا بزهر منه نفاح % % 53(@)(@@) % من غير سمعك يدري ما أرجعه % % في الخصب من مستطاب الحمد صداح % % 54(@)(@@) % بباهر البر جد ديا علي قوي % % شعر تجد خير عمار لأمداح % % 55(@)(@@) % و ليهنك العام ساعي العام منشرحا % بمجمل اليمن لم يحتج لشراح % % 56(@)(@@) % عام حلفنا بمسطور الثلاث به % % بأنه عام إقبال وأفراح % % 57(@)(@@) % للملتجي لك فيه سعد أخبية % من الأذى ولباغي البعد ذباح % % PageV01P464 البحر : - 1(@)(@@) % لا وأجفانك المراض الصحاح % % لست أدري ماذا تقول اللواحي % % 2(@)(@@) % لي شغل يا صاح بالنظر المنص % % ور عنهم بالمدمع السفاح % % 3(@)(@@) % مادرى من يلوم حمرة دمعي % % أن قلبي عليك دامي الجراح % % 4(@)(@@) % يا مليحا صدغاه قبلة حسن % % سجدت نحوها وجوه الملاح % % 5(@)(@@) % لك شعر وقامة إن يكونا % % راية فهي راية الأفراح % % 6(@)(@@) % و جبين اذا ذكرت سناه % % بت أبكى صبابة للصباح % % 7(@)(@@) % خلق في للهوى مثلما رك % % ب في ابن الأثير خلق السماح % % 8(@)(@@) % الرئيس الذي به نفق الشع % % ر وراجت بضائع المداح % % 9(@)(@@) % و الجواد الذي يحدث راجي % % سيب كفيه عن عطا بن رباح % % 10(@)(@@) % باذل المال بالبنان الذي قد % % حفظ الملك من جميع النواحي % % PageV01P465 11(@)(@@) % همة تعتلى على شرف الشه % % ب ورفد يدنو إلى الممتاح % % 12(@)(@@) % كم قصدنا له مشاهد فضل % % فحصلنا على النجا والنجاح % % 13(@)(@@) % و هرعنا إلى أنامل يمنا % % ه ففزنا بالخمسة الأشباح % % 14(@)(@@) % ليس ينفك بين عرض مصون % يترقى وبين مال مباح % % 15(@)(@@) % فلكفيه والثراء حروب % % نحن منها في غاية الإصلاح % % 16(@)(@@) % قال للباسم البروق نداها % % طرق الجد غير طرق المزاح % % 17(@)(@@) % جرت الشهب بالعلى لعلي % و لباغي مداه بالإفتضاح % % 18(@)(@@) % و أقامت يد الزمان عليا % % لقضايا قرعن سن الرماح % % 19(@)(@@) % فجلاها في الروع رايات رأي % % و نضاها صحائفا كالصفاح % % 20(@)(@@) % كل محبوكة الصدور تهادي % % بين أدراعها أكف الكفاح % % PageV01P466 21 
ms103	(@)(@@) % فهي سور على الممالك تحمي % % و لباب الأرزاق كالمفتاح % % 22(@)(@@) % يا ملاذ العفاة دعوة عبد % مستغيث من الزمان مجاح % % 23(@)(@@) % ذي حسان من القصائد تجلى % % و هي محتاجة لحظ القباح % % 24(@)(@@) % يتشكى الصدى لنغبة جاه % أصبح الناس فيه كالسباح % % 25(@)(@@) % فأعني على الحوادث وانظر % % لثوابي لديك لا لا متداحي % % 26(@)(@@) % جل من صاغ نور بشرك في الخل % % ق وسبحان فالق الإصباح % % PageV01P467 البحر : - 1(@)(@@) % إنسان عيني ساهر بك سافح % % يا أيها الانسان إنك كادح % % 2(@)(@@) % و جوانح ملئت عليك تحسرا % % هذا وهن إلى لقاك جوانح % % 3(@)(@@) % يا معرضا قلبي عليه ومدمعي % % هذا مقيم هوى وهذا نازح % % 4(@)(@@) % يا يوسف الحسن البديع جماله % % و الله ما عيشي بهجرك صالح % % 5(@)(@@) % ان كان وجهك بدر سعد إنه % % من لحظك الفتاك سعد الذابح % % 6(@)(@@) % ماضر مثلك لائم إلا كما % % قد ضر أقمار الدجنة نابح % % 7(@)(@@) % و لقد يجدد فيك جرح حشاشتي % % طير على البان المرنح صادح % % 8(@)(@@) % يا فرط ضعفي حيث صرت فريسة % % و حمام بانات الحمى لي جارح % % 9(@)(@@) % عجبا لشخصك نافرا جرح الحشا % % فهو الغزال لدي وهو الجارح % % 10(@)(@@) % و تغزل الأشعار فيك كواسد % % و لهن في مدح الجمال منادح % % PageV01P468 11(@)(@@) % و في ابن محمود المحامد حقها % % فغدت إلى علياه وهي طوامح % % 12(@)(@@) % وزكت أحاديث الورى عن مجده % % فجميع ما يحكون عنه مدائح % % 13(@)(@@) % الكاتم الصدقات وهي شهيرة % كالمسك يكتم وهو شيء فائح % % 14(@)(@@) % و القائل الكلمات يقدر قدرها % % سور الكلام كأنهن فواتح % % 15(@)(@@) % من كل ساجعة السطور كأنما % % همزاتها ورق هناك صوادح % % 16(@)(@@) % و فريدة قد أقرحت عن مثلها % % فطن الورى فلذاك قيل قرائح % % 17(@)(@@) % واري الزناد فضائلا وفواضلا % % هذا وما فيه لعمرك قادح % % 18(@)(@@) % يجدي ويسبح في الثناء فيحتوي % % أمد العلى فهو الجواد السابح % % 19(@)(@@) % و يزين رفعة بيته بجلاله % % فكأنما هي في السماء مصابح % % 20(@)(@@) % في كفه قلم كأن رشاءه % % للرزق والدرر النفيسة مائح % % PageV01P469 21(@)(@@) % خافت مهابته الرماح فأذعنت % % حتى تخوفه السماك الرامح % % 22(@)(@@) % يا مانحي غرر اللهى متبسما 
ms104	 % و العام مغبر الأسرة كالح % % 23(@)(@@) % جردتني سيفا بمدحك قائما % حتى تضم علي ثراي صفائح % % 24(@)(@@) % فلأ شكرنك في القريض بسبق % % مع أنها عما بلغت طلائح % % 25(@)(@@) % و من المكارم أن تسامح عجزها % % إن الكريم ابن الكريم مسامح % % PageV01P470 البحر : - 1(@)(@@) % تاوب كالبدر في جنحه % % و أين العواصم من سفحه % % 2(@)(@@) % خيال يزور أخير الدجى % % فتحسبه مبتدا صبحه % % 3(@)(@@) % و قد ضم جفني يزير الكرى % % فيعرب في الحال عن فتحه % % 4(@)(@@) % هوى شارح لي حديث الغرام % % فلا تسأل القلب عن شرحه % % 5(@)(@@) % تعشقه شاهر الوجنتين % % بما لقى القلب من جرحه % % 6(@)(@@) % له سيف لحظ أراق الدماء % فحمرة خديه من نضجه % % 7(@)(@@) % كأن عذاريه خط الجمال % % تميل النفوس إلى لمحه % % 8(@)(@@) % رئيس له في العلى منزل % تزل الكواكب عن صرحه % % 9(@)(@@) % يرجى وإن زاد في سخطه % % و يخشى وإن لان في مزحه % % 10(@)(@@) % ترقى بن محمود مرقى الهلال % % فلاحظه الضد في نبحه % % PageV01P471 11(@)(@@) % و أعدى على نائبات الزمان % % فما تشتكي الناس من فدحه % % 12(@)(@@) % براحته قلم قد دعا % % شكاة الزمان إلى صلحه % % 13(@)(@@) % يقول الرجاء لممتاحه % % طغى سيل غيثك فاستصحه % % 14(@)(@@) % و يوضح للناس نهج الثناء % فنظم القصائد من منحه % % 15(@)(@@) % له كتب في ديار العدى % % غني بها الجيش عن كدحه % % 16(@)(@@) % تثقف مثل أعالي الشآم % % بما اشتعل الدهر من لفحه % % 17(@)(@@) % لك الله من واضح مجده % % كما اتضح الأفق عن صبحه % % 18(@)(@@) % و برك في الفضل بر رفيع % % فليس المعاند من طرحه % % 19(@)(@@) % و كم لك عندي من منة % كما أسرف الغيث في سحه % % 20(@)(@@) % ينطقي جودك المرتجى % % و يدعو اللسان إلى صدحه % % PageV01P472 21(@)(@@) % فأجلب نظمي ونثري له % % و أورى الصحيحين عن مدحه % % PageV01P473 البحر : - 1(@)(@@) % نجوم تراعيها جفون سوافح % % و لا طيفكم دان ولا الليل نازح % % 2(@)(@@) % أباخلة عني بطيف خيالها % % عسى ولعل الدهر فيك يسامح % % 3(@)(@@) % و تاركة قلبي كليما وناظري % % ذبيحا ولا في العيش بعدك صالح % % 4(@)(@@) % لمحتك للبين المصادف لمحة % % فطاحت بأحشائي اليك الطوائح % % 5(@)(@@) % و ما أنت 
ms105	 إلا الظبي جيدا ومقلة % فلا غرو أن أهوت اليك الجوارح % % 6(@)(@@) % جوارح ينمو شجوها وسقامها % % علي ودوني جندل وصفائح % % 7(@)(@@) % و قلب عصى نصحي عليك وسلوتي % % فأبعد شيء صبره والنصائح % % 8(@)(@@) % و قلت جبين المالكية عذره % % فقال الورى عذر لعمرك واضح % % 9(@)(@@) % و ضاقت علينا عينها فتمنعت % % و هيهات أن تسخو النفوس الشحائح % % 10(@)(@@) % و لم أنس يوم البين إيماء طرفها % % و عيس المطايا للفلاة جوانح % % PageV01P474 11(@)(@@) % فليت الردى أجرى دم العيس ناحرا % % فسالت بأعناق المطى الأباطح % % 12(@)(@@) % و مما شجاني في الضحى صوت ساجع % % كأني له بعد الحبيب أطارح % % 13(@)(@@) % يساعدني نوحا يكاد يجيبنا % % بأمثاله بان الحمى المتناوح % % 14(@)(@@) % فليت حمام الأيك يوما أعارني % % جناحا إلى الركب الذي هو نازح % % 15(@)(@@) % و ليت النجوم الزهر تدنو قوافيا % لنا فتنقى في ابن خضر المدائح % % 16(@)(@@) % رئيس تجلى بشره ونواله % % فلا الأفق مغبر ولا العام كالح % % 17(@)(@@) % على المزن من تلك البنان تشابه % % و في البدر من ذاك الجبين ملامح % % 18(@)(@@) % و في الأرض من أخلاقه وثنائه % % سمات فنغم المزهرات الفوائح % % 19(@)(@@) % ولله أقلام الحماسة والندى % % على يده حيث السطا والمنائح % % 20(@)(@@) % حمين الحمى لما فتحن بلاده % % و قد أقصرت عنها القنا والصفائح % % PageV01P475 21(@)(@@) % فهن على اللآئي فتحن مغالق % و هن على اللآتي غلقن مفاتح % % 22(@)(@@) % و طوقنا أطواق جود فكلنا % % على شبه الأغصان بالحمد صادح % % 23(@)(@@) % و روضن أقطار الشآم بأحرف % % سقى أصلها طاف من النيل طافح % % 24(@)(@@) % و صدر لما يلقى من السر لائق % % و كوكب فضل في سما الملك لائح % % 25(@)(@@) % علي المدى لا بالملة جازع % و لا بالتي يثني لها العطف فارح % % 26(@)(@@) % وزاكي النهى إما لمعنى سيادة % % و إما لأكباد المعادين شارح % % 27(@)(@@) % بليغ اذا نص المقال وبالغ % % مدى الرأي حيث النيرات الطوامح % % 28(@)(@@) % و أبيض وجه العرض والوجه والتقى % % اذا لفحت سفع الوجوه اللوافح % % 29(@)(@@) % على دولة الأملاك كل فصوله % % ربيع وفي الأعدا سعود ذوابح % % 30(@)(@@) % و للطالبي العمى غمام كأنه % % لما جد في جود 
ms106	 وحاشاه مازح % % PageV01P476 31(@)(@@) % إلى عدله يشكو الزمان فانه % % خديم يغادي أمره ويراوح % % 32(@)(@@) % تعودت أن تسري اليه ركائبي % % فترجع وهي المثقلات الروازح % % 33(@)(@@) % و آخذ من قبل المديح جوائزا % تقصر عن أدنى مداها الممادح % % 34(@)(@@) % فلا غرو أن آتي بهن مضيئة % % كأن المعاني في البيوت مصابح % % 35(@)(@@) % أمولاي ان يسكت لساني صابرا % فان لسان الحال مني صادح % % 36(@)(@@) % ألم تر أني معمل الفكر في كرى % % حمار أماسي غبنه وأصابح % % 37(@)(@@) % ركوبي على أمثاله في زمانكم % % كما ركبت في العالمين القبائح % % 38(@)(@@) % فهل لي ببيت المال حق فيقتضى % % و هل أملي في أرذل الخيل جامح % % 39(@)(@@) % ولي في بديع الوصف كالصخر قوة % % و لكنه سيل على الأرض سائح % % 40(@)(@@) % أقدم فيه الوصف فيل أوانه % % على ثقة مني بأنك مانح % % PageV01P477 البحر : - 1(@)(@@) % سقى عهدها داني العهاد سفوحها % % خياما برغمي نأيها ونزوحها % % 2(@)(@@) % و بلغها عني أتم تحية % عليل الصبا يروي بفيه صحيحها % % 3(@)(@@) % معدلة في مرسلات مدامعي % % و لكن قلبي المستهام جريحها % % 4(@)(@@) % أسكان قلب لا يداوي كليمه % % ليهنكم من مقلتي ذبيحها % % 5(@)(@@) % و يهن الليالي أن فيها لواصف % % جمالا به يخفى ويعفى قبيحها % % 6(@)(@@) % فدى لابن ريان الكرام لأنه % % فتى حيها راعي حماها صريحها % % 7(@)(@@) % سليمان ملاك المعالي وإنه % % بآية طوفان المكارم نوحها % % 8(@)(@@) % أخو الدين للساري به يستنيره % % نعم وأخو الدنيا لمن يستميحها % % 9(@)(@@) % أمولاي قد أنشرت ميت فكرتي % % بأبيات نظم حل فيها مسيحها % % 10(@)(@@) % فيا لك نظما من نسيب سيادة % حقيق له من كل نفس مديحها % % PageV01P478 11(@)(@@) % تذكرني النعمى وأنت غمامها % % بروضة ألفاظ وأنت صدوحها % % 12(@)(@@) % بقيت مدى الدنيا لمجد تصونه % % و اعلاق مال للعفاة تبيحها % % 13(@)(@@) % فما الدهر الا ناظر أنت لحظه % % و ما الفضل الا صورة أنت روحها % % PageV01P479 البحر : - 1(@)(@@) % هل بعد وجهك للرجاء نجاح % % أو بعد شخصك في الحياة صلاح % % 2(@)(@@) % يا راحلا تجب القلوب لفقده % % الصبر يمنع والبكاء يباح % % 3(@)(@@) % لا غروان تذري الدموع أجاجها % % و نداك عذب في الاكف قراح % % 4(@)(@@) % لهفي عليك لراحة 
ms107	 مزنية % تعيي الغيوث وغيثها سحاح % % 5(@)(@@) % لهفي عليك لهمة علوية % % تغضي النجوم وطرفها طماح % % 6(@)(@@) % لهفي عليك لئن خلعت شبيبة % % كان الزمان لحسنها يرتاح % % 7(@)(@@) % لهفي عليك لئن أثرت مراثيا % كنا نؤمل أنها أمداح % % 8(@)(@@) % ما كان سلخ العام الا طالعا % لقلوبنا فيه عليك جراح % % 9(@)(@@) % آها لفقدك إنه الفقد الذي % % نسخت بيوم عزائه الأفراح % % 10(@)(@@) % ما كان يا ابن الفتح يومك بالذي % % فيه لباب تصبر مفتاح % % PageV01P480 11(@)(@@) % تبكي عليك يراعة وبراعة % و فصاحة ورجاحة وسماح % % 12(@)(@@) % تبكي عليك من العلوم صحائف % و من الجيوش أسنة وصفائح % % 13(@)(@@) % تمسي اذا ذكرت يراعك بينها % % و دموعها بدل السلاح سلاح % % 14(@)(@@) % تبكيك للنعماء آل مقاصد % كانت بسجلك في الندى تمتاح % % 15(@)(@@) % تبكيك للود الصحيح صحابة % لبكائها نسب عليك صراح % % 16(@)(@@) % هذاك عوام بمدمعه وذا % % حد الهموم لقلبه جراح % % 17(@)(@@) % تبكي عليك منازل بالرغم أن % % هبط التراب هلالها الوضاح % % 18(@)(@@) % كان الحمام بها يغرد فرحة % فاليوم تغريد الحمام نواح % % 19(@)(@@) % هل تعلم الورقاء أني مثلها % % لو كان لي بعد الفقيد جناح % % 20(@)(@@) % واحسرتاه لجوهري فضائل % % ما بعد رؤياه القلوب صحاح % % PageV01P481 21(@)(@@) % واحسرتاه ليوسفي محاسن % % عاداه صرف زمانه المجتاح % % 22(@)(@@) % أيام كمل فضله وتباشرت % % قصاده فغدوا اليه وراحوا % % 23(@)(@@) % و ثناه عن عذل العواذل في الندى % % رأي يرى أن السماح رباح % % 24(@)(@@) % و غدا ودولة عيشة أموية % حتى انتضى سيف الردى السفاح % % 25(@)(@@) % هن الليالي الضاربات على الورى % % بنجومها فكأنهن قداح % % 26(@)(@@) % يسطو على الآجال رمح سماكها % % و لتسطون على السماك رماح % % 27(@)(@@) % ما أعدل الدنيا وان جارت بنا % % لم يبق مجزاع ولا مفراح % % 28(@)(@@) % أعظم بها من حكمة محجوبة % ما للتعمق نحوها إيضاح % % 29(@)(@@) % اما الجسوم فللتراب غيابها % % و إلى مقدر خلقها الأرواح % % 30(@)(@@) % جادت صلاح الدين تربك مزنة % % فيها لأحوال الثرى إصلاح % % PageV01P482 31(@)(@@) % تبكي على خد التراب غيومها % % فتظل باسمة ربى وبطاح % % 32(@)(@@) % حتى كأن ربيعها ونسيمها % % نعمى يديك وذكرك الفياح % % PageV01P483 البحر : - 1(@)(@@) % بروحي طرس جاءني متضمنا % بدائع يسري الفكر فيها ويسرح 
ms108	 % % 2(@)(@@) % به من غريب اللفظ والحظ مجتلى % % فيالك طرسا للغريبين يشرح % % 3(@)(@@) % و لغز هداني نحو معناه أنه % % أتى وبه عرف من الروض ينفح % % 4(@)(@@) % يشف على مكتوبه طيب ما حوى % % و كل إناء بالذي فيه ينضح % % 5(@)(@@) % و لو كنت تبغي كتم مخبره لما % % بعثت بنمام يقول ويفصح % % 6(@)(@@) % هو الاسم لكن نصفه فعل كله % % اذا جعلت أسرار معناه تلمح % % 7(@)(@@) % و مقلوبة أحجية مثل لم يجد % % فدونك نظما عاجزا ليس يصلح % % 8(@)(@@) % أجاب فان قال الصواب أو الخطأ % % فمثلك هدي أو فمثلك يفصح % % PageV01P484 البحر : - 1(@)(@@) % مرحبا بالنظم يأتي % % نفحة من بعد نفحة % % 2(@)(@@) % من بياض باكرتها % % سحرا بالسفح سفحه % % 3(@)(@@) % و لآل نظمتها % % بركات ضمن سبحه % % 4(@)(@@) % و عروس جعلت لي % % من بياض الوصل صبحه % % 5(@)(@@) % مع أني عاجز عن % % ضمة دع ذكر فتحه % % 6(@)(@@) % كنت في الشعر جوادا % يحرز السبق بلمحه % % 7(@)(@@) % فثناني العسر والاو % % لاد لا أملك فسحه % % 8(@)(@@) % كل إبن لي وبنت % % كشكال لي وشبحه % % 9(@)(@@) % و زناد القول لا يس % % مح في وجهي بقدحه % % 10(@)(@@) % و دعائي بك عن قا % % فية يغني وصدحه % % PageV01P485 11(@)(@@) % خذ صفاء الود كاسا % % ت وفيها ألف صحه % % 12(@)(@@) % و احتملني ان تحالي % % ت وأغربت بملحه % % 13(@)(@@) % سيدي ما في النوى وال % % قرب للمشتاق فرحه % % 14(@)(@@) % إن تغب عني وان تق % % دم فلي بالهجر قرحه % % 15(@)(@@) % أيها الفتح المفدى % % خف من العاتب فتحه % % PageV01P486 البحر : - 1(@)(@@) % عجبت من طرفي وخد المليح % % كلاهما هذا بهذا جريح % % 2(@)(@@) % هذا دم الراح به واقف % و ذا دم الأدمع فيه يسيح % % 3(@)(@@) % تغزلي المنظوم فيه وفي % % سلطاننا الناصر نظم المديح % % 4(@)(@@) % في دعة الله وفي حفظه % % مسراك والعود بعزم نجيح % % 5(@)(@@) % يا موعدا منه بقرب اللقا % % قابلتنا اليوم بصبح صبيح % % 6(@)(@@) % لو جاز أن تسلك أجفاننا % % اذا فرشنا كل جفن قريح % % 7(@)(@@) % لكنها بالبعد معتلة % و أنت لا تسلك غير الصحيح % % PageV01P487 البحر : - 1(@)(@@) % يا إماما في مدح علياه صدق % قد محا كذب غير مدحك ماح 
ms109	 % % 2(@)(@@) % ان أرجوزتي بدار حديث ال % % شام تملي عوالي الأمداح % % 3(@)(@@) % و كتاب الصحاح أوتي فما ين % % فك يروى عنكم كتاب الصحاح % % 4(@)(@@) % لم يضع غير نشرها إنما غا % % بت وعادت للباب ذا مفتاح % % 5(@)(@@) % كلما أذبل الزمان نباتي % % جاءني منكمو بسحب سحاح % % PageV01P488 البحر : - 1(@)(@@) % بأيمن طالع عقد سني % جلي اليمن متصل النجاح % % 2(@)(@@) % ظفرت عن قران السعد فيه % % بشمس الحسن من شمس السماح % % 3(@)(@@) % فنعم الاهل قد أضحت وماذا % % يقول المدح في أهل الصلاح % % PageV01P489 البحر : - 1(@)(@@) % أحاشيك يا نجل الوزارة من أذى % % تمكن من أسرارنا والجوانح % % 2(@)(@@) % دفنت النوى والتمر فيمن تحبه % % و دفن النوى يا مي إحدى الفضائح % % PageV01P490 البحر : - 1(@)(@@) % يا سيدي وابن ساداتي الذين على % % أبوابهم صح عندي باب أفراحي % % 2(@)(@@) % قد كنت في الباب مع ياقوت متحدا % فعوضوا عبد أبواب بمفتاح % PageV01P491 البحر : - 1(@)(@@) % طلبت سكنى مكان أو كراه عسى % % يسكن الحال قلبا ظل مجتاحا % 2(@)(@@) % فقال اسكن امام قد درى طلبي % % و كيف يسكن من لم يلق مفتاحا % PageV01P492 البحر : - 1(@)(@@) % أرى الحسن مجموعا بجامع جلق % و في صدره معنى الملاحة مشروح % % 2(@)(@@) % فإن يتغالى في الجوامع معشر % فقل لهم باب الزيادة مفتوح % % PageV01P493 البحر : - 1(@)(@@) % بصالح حمص نستعين على الثنا % % لديك ونرجوه لنظم المدائح % % 2(@)(@@) % و والله ما نوفي أياديك حقها % % إذا نحن أثنينا عليك بصالح % % PageV01P494 البحر : - 1(@)(@@) % مضى منجح ثم اقتضى الحال بعده % % سواه قريب المثل للقصد ينتحي % % 2(@)(@@) % له عاذر من نفسه باجتهاده % % و مبلغ نفس عذرها مثل منجح % % PageV01P495 البحر : - 1(@)(@@) % سيقا لأيامي التي سلفت % % ما بين ذاك النعيم والمرح % % 2(@)(@@) % لا بنزل الدهر عن يدي قدما % كأنني صورة على قدح % % 3(@)(@@) % و راهبة طرقناها بليل % % و دون مزارها أرج يفوح % % 4(@)(@@) % فهبت في الظلام إلى مدام % كأن شعاعها قبس يلوح % % 5(@)(@@) % و حيتنا بعافية شمول % % كما يترقرق الدمع السفوح % % 6(@)(@@) % كأنا قد سلبنا الديك عينا % فقام من الكرى فزعا يصيح % % PageV01P496 البحر : - 1(@)(@@) % و ظيفتي المدح الذي أنا ناظم % % عليك وحسبي في الانام به مدحا 
ms110	 % % 2(@)(@@) % اذا عدلت أقلام خطي لضبطه % % ملأت قلوب الحاسدين بها جرحا % % 3(@)(@@) % ألا فابق طول الدهر للملك حافظا % اذا حملت يداك من قلم رمحا % % PageV01P497 البحر : - 1(@)(@@) % شغل القرائح بالدعاء الصالح % % إشغال وقتك عن قريض المادح % % 2(@)(@@) % شغلا وتدبيرا بمملكة رأت % % منك الجميل فأعرضت عن طامح % % 3(@)(@@) % لا طعن في قلم شرعت بدولة % ان كان يطعن في السماك الرامح % % 4(@)(@@) % يا صاحب الدعوات والبركات أي % % مدائح تولي وأي قرائح % % 5(@)(@@) % يا موثرا كتم الهبات وكتمها % % كالمسك لا يزداد غير نوافح % % 6(@)(@@) % الله يعلم ما تكن من الدعا % % و الحمد عجز أو مخافة كاشح % % 7(@)(@@) % أقسمت يا موسى الزمان لقدوفا % % بالصدق من أثنى عليك بصالح % % PageV01P498 البحر : - 1(@)(@@) % كن كيف شئت فلا براح % % أنت المنى والإقتراح % % 2(@)(@@) % أنت الذي لا بأس في % % تلفى عليك ولا جناح % % 3(@)(@@) % لك وجنة خسران قل % % بي في محبتها رباح % % 4(@)(@@) % من صد عن نيرانها % % فأنا ابن قيس لا براح % % PageV01P499 البحر : - 1(@)(@@) % سرت لك آمالي وان عاقني الضنى % % على ثقة أن يستنير نجاحها % % 2(@)(@@) % ألم تر أني من قديم ووالدي % % وجدي أناس في رباكم رباحها % % 3(@)(@@) % فان أجدبت كفي فأنت غياثها % % و ان فسدت حالي فأنت صلاحها % % PageV01P500 البحر : - 1(@)(@@) % أترضى يا وزير الشام أني % % بدهرك أشتكي حالا قبيحه % % 2(@)(@@) % و أن الناس تذبح في الضحايا % % و ما لي غير أجفان ذبيحة % % 3(@)(@@) % و يمضي العيد في أكل وشرب % و ما لي في الشريحة منه ريحه % % PageV01P501 البحر : - 1(@)(@@) % حيي الحيا قبرا بررت نزيله % % بمنائح مبرورة ومناح % % 2(@)(@@) % و عزا كبت به العدى لما رأوا % % من رفع منزلة وفيض سماح % % 3(@)(@@) % من كان يكبت بالعزاء عداته % % و الحاسدين فكيف بالافراح % % PageV01P502 البحر : - 1(@)(@@) % لعمري لقد حفت بأمن وصحة % ليالي وصال للهناء مبيح % % 2(@)(@@) % أحاشيك عن تعريض سقم وأرتجي % % عوائد عيش للهناء منيح % % 3(@)(@@) % فلا سقم الا يجفن مليحة % و لا عارض الا بخد مليح % % PageV01P503 البحر : - 1(@)(@@) % يا سيد العلماء راق شعاره % و كلامه كأبيه لما يمدح % % 2(@)(@@) % ما أحسن العذبات لائقة 
ms111	 بكم % % اما شعارا أو لسانا يفتح % % PageV01P504 البحر : - 1(@)(@@) % يا من غدت ألفاظه حلوة % قد أبدعت معنى وايضاحا % % 2(@)(@@) % تفتح آمالي فأحسن بها % % سكرة تصحب مفتاحا % % PageV01P505 البحر : - 1(@)(@@) % لحا الله ألا فا بما يصنعونه % % من الماء صرفا فعل من لا يناصح % % 2(@)(@@) % أغني له والمال ضاع بشربه % % أماوي إن المال غاد ورآئح % % PageV01P506 البحر : - 1(@)(@@) % أستودع الله أحبابي الذين نأوا % % و خلفوني في نيران تبريح % % 2(@)(@@) % أستنشق الريح من تلقاء أرضهم % لقد قنعت من الأحباب بالريح % % PageV01P507 البحر : - 1(@)(@@) % عشت للآداب تحمي سرحها % % ببيان خط أو خطو فسيح % % 2(@)(@@) % ليت شعري أنت يا باعثها % % بعد ما ماتت خليل أو مسيح % % PageV01P508 البحر : - 1(@)(@@) % قلت اذ حدثني الفت % % ح ووفاني بمنح % % 2(@)(@@) % كيف أثمار حديثي % % قال فضي وفتحي % % PageV01P509 البحر : - 1(@)(@@) % أقاضي قضاة الدين فضلك مسفر % و شانيك مكبوت وراجيك فارح % % 2(@)(@@) % و قد طاب ديوان المصالح نفخة % فضاعت وما ضاعت عليه المصالح % % PageV01P510 البحر : - 1(@)(@@) % بشرنا الفتح بعاداتنا % % لديك وهي المن والمنح % % 2(@)(@@) % فقلت تبت يد خذلاننا % % و جاء نصر الله والفتح % % PageV01P511 البحر : - 1(@)(@@) % دعوتك يا مولاي للحال عالما % بانك ماحي عسرة الحال بالمنح % % 2(@)(@@) % اذا أغلقت أبواب رزقي عشيرة % فأنت أبو تسهيلها وأبو االفتح % % PageV01P512 البحر : - 1(@)(@@) % بأبي نائم على الطرق راحت % % في هواه وليس يعلم روحي % % 2(@)(@@) % فاتح في الكرى فما سكريا % ياله من مسكر مفتوح % PageV01P513 البحر : - 1(@)(@@) % ضعيتكم قد أشبهت ليلتي % % مخوفة مسودة كالحه % % 2(@)(@@) % كلاهما في وصفه واحد % ما أشبه الليلة بالبارحه % % PageV01P514 البحر : - 1(@)(@@) % نسيت ولست أنسى حسن بكر % % و حسن عشية معها وصحبه % % 2(@)(@@) % ضممت الخصر ثم نحوت أمرا % فيالك ضمة كانت وفتحه % % PageV01P515 البحر : - 1(@)(@@) % ليت شعري ذا كم يكابد حالي % % في حمى الشام ذلة وإجاجه % % 2(@)(@@) % ليتني رحت في المنية عنه % % إن في قول راح للمرء راحة % % PageV01P516 البحر : - 1(@)(@@) % ملك الزمان وجيشه في أحمر % يبدو وللاسلام نصر واضح % % 2(@)(@@) % فكأن بحرا قد جرى بدم العدى % % والقوم فيه والجياد سوابح % % PageV01P517 البحر : - 1(@)(@@) % صبرا وان جل الأسى وانتضى % % لكل قلب حده الجارح % % 2 
ms112	(@)(@@) % كل إلى هذا الثرى صائر % لا صالح يبقى ولا طالح % % PageV01P518 البحر : - 1(@)(@@) % مالي نديم سوى ورقاء ساجعة % % من بعد مغتبقي فيكم ومصطبحي % % 2(@)(@@) % اذا أدار ادكار الوصل لي قدحا % من أحمر الدمع غناني على قدحي % % PageV01P519 البحر : - 1(@)(@@) % وحديقة واصلت خلوتها % % ما بين مغتبق ومصطبح % % 2(@)(@@) % فاذا أخذت بظلها قدحا % غنت حمائمها على قدحي % % PageV01P520 البحر : - 1(@)(@@) % بشرني الدهر بقصد به % % بدا على أصحابي النجح % % 2(@)(@@) % وقال إن تستفتحوا في رجا % % خير فقد جاءكم الفتح % % PageV01P521 البحر : - 1(@)(@@) % قم هاتها في الليل راحا كما % % توقدت شعلة مصباح % % 2(@)(@@) % ودافع الهم فاني امرؤ % أدفع صدر الهم بالراح % % PageV01P522 البحر : - 1(@)(@@) % مولاي قاضي القضاة ما فعلت % % عوارف منك كنت أمتاح % % 2(@)(@@) % أغلق بابي في وجه مطلبي % % وصد مع من يصد مفتاح % % PageV01P523 البحر : - 1(@)(@@) % ياصاحبا لي بل يا سيدا يده % يد الخلائف في بري واصلاحي % % 2(@)(@@) % ان كان جاهك مهدي المصير إلى % % قصدي فان ندى كفيك اصلاحي % % PageV01P524 البحر : - 1(@)(@@) % لمولودكم يا آل يحيى مزية % من الفضل لا تخفى على كل لامح % % 2(@)(@@) % اذا ماشرعتم في علاه عقيقة % % شرعنا له في درة من مدائح % % PageV01P525 البحر : - 1(@)(@@) % ترك الأسى انسان عيني بعدكم % % أ بدا يغادي لوعة ويراوح % % 2(@)(@@) % تعبان ذا سهر وسح مدامع % يا أيها الانسان انك كادح % % PageV01P526 البحر : - 1(@)(@@) % أقول لمعشر جلدوا ولاطوا % % وباتوا عاكفين على الملاح % % 2(@)(@@) % لأنتم خير من ركب المطايا % % وأندى العالمين بطون راح % % PageV01P527 البحر : - 1(@)(@@) % البرق في كانونه قد نفخ % % والثلج في جيب الغوادي نفخ % % 2(@)(@@) % قد زمجر الرعد بآفاقه % كأنه مما دهاه صرخ % % 3(@)(@@) % هذا وقوس النوء في أفقه % % كأنما قد نصبوا منه فخ % % 4(@)(@@) % قد شد عقدا عاليا أو بنى % % قنطرة في الحال ثم انفسخ % % 5(@)(@@) % و الأرض كالمنفوش أو هذه % % خميرة من فوقه قد لطخ % % 6(@)(@@) % لم تبق أرض قد زكا زرعها % % حتى طواها ثم رد السبخ % % 7(@)(@@) % قد نسخ الليل بأضوائه % لا صححت يا قوم هذي النسخ % % 8(@)(@@) % و امتلأ الوادي بإمداده % % كأنه القربة مما انتفخ % % 9(@)(@@) % و جاءنا النوء 
ms113	 بإرعابه % % لا شك أن النوء مما بذخ % % 10(@)(@@) % بحر من القدرة لكنه % % من كل عين للبواكي نضخ % % PageV01P528 11(@)(@@) % و سحبه تفتح أبوابها % % والبرق فيما بيننا كالخوخ % % 12(@)(@@) % و بان في الطود وعرنينه % % بما كساه شمم أو طبخ % % 13(@)(@@) % و كلنا منتثر لحمه % وهو على كانونه قد طبخ % % 14(@)(@@) % دامت ليالي الثلج لا أصبحت % % و لانهار بأذاه التطخ % % 15(@)(@@) % و حكمت فيه أيادي الحيا % % ولا أجاب الله مما اصطرخ % % 16(@)(@@) % و مكنت فيه مدى برقه % % حتى أرى من جلده ما انسلخ % % 17(@)(@@) % هل مطر يغسل في الأرض من % % بياضه أسود هذا الوسخ % % 18(@)(@@) % و هل أرى ريحا وقد زعزعت % % في الطرق منه كل طود رسخ % % 19(@)(@@) % و هل فتى يشكي اليه الذي % % تم له أدراج تتلى وبخ % % 20(@)(@@) % بى جمال الدين أنعم به % % مولى كريما ونسيبا وأخ % % PageV01P529 21(@)(@@) % لو قابلت سنوننا شمسه % % أو نوءها أبصرته قد نسخ % % 22(@)(@@) % جاء جواب منه كم حافظ % له وكم رب بديع نسخ % % 23(@)(@@) % فدام ما امتد ردآء الدجى % % مدبرا بالنجم ثم انسلخ % % PageV01P530 البحر : - 1(@)(@@) % لغرة الأفق بياض شدخ % % جسمي به من قبل شهري انسلخ % % 2(@)(@@) % ويلاه من ثلج صميم إذا % % تساكت الناس لديه صمخ % % 3(@)(@@) % قامت به شعرة أجسامنا % % بزرقة فالويل منها خوخ % % 4(@)(@@) % كأنني محراك فرن إذا % قالوا عجين الثلج في الأرض طخ % % 5(@)(@@) % كم يبصق الثلج على لحية % وكم يقول الرعد في الوجه إخ % 6(@)(@@) % كم تعقد الآفاق عقد اللبا % % منه وكم ينثر نثر اللبخ % % 7(@)(@@) % كم بشر بالثلج لما غدا % % كالحجر المطروح قبل المسخ % % 8(@)(@@) % كم أثر نيران اذا مارعى % % بالثلج يجري ماءه قبل سخ % % 9(@)(@@) % و حاول البربخ في الماء أن % % يحكي مجاري رشحه فانبرخ % % 10(@)(@@) % لا كان ذاك البخ منه ولا % % كرر في أيامه قول بخ % % PageV01P531 11(@)(@@) % كم ليلة بالثلج شابت وكم % % مداد جنح بضياه انتسخ % % 12(@)(@@) % صكت به الاجرام من فوقنا % % ودار بالآفاق منا فلخ % % 13(@)(@@) % و جاز في آذاننا واغلا % كأنه يقلع منها زنخ % % 14(@)(@@) % مالي بباب الثلج 
ms114	 من طاقة % وخوفه من كبدي قد رسخ % % 15(@)(@@) % فعوذوني دونه بالرقى % % أو بخروني بالحصى والكلخ % % 16(@)(@@) % متى أرى من مطر رحمة % % تطرد من قاعدة ما انفسخ % % 17(@)(@@) % متى أرى جيب الغوادي انفرى % % وروع أفراخي لديه انفرخ % % 18(@)(@@) % اللائذين اليوم من حاتم % كأنه شعوآء فيها فنخ % % 19(@)(@@) % تكوموا في البيت من خوفه % % فالبيت أو ناظمه كوم فخ % % 20(@)(@@) % عادوا بنعمى أحمد فاقتضوا % % منها لدفع الثلج عادات رخ % PageV01P532 21(@)(@@) % ذو القلم الراقي حيا أو علا % فيا له غصنا دنا أو شمخ % % 22(@)(@@) % وأنفق الخاءآت لكنه % % لعبده من وفرها ما رضخ % % 23(@)(@@) % فحيث من مصر ينخى الذي % % عارض من شرقيها ثوب نخ % % 24(@)(@@) % من أين للقوم الأولى قوضوا % % كذهنك المقتدح الممترخ % % 25(@)(@@) % هذا وفي الأقوام ذو قوة % وانما الشيخ عدي شيخ % % PageV01P533 البحر : - 1(@)(@@) % شكرا لها نعمى يد من سيد % أغنى عن التطفيل والتشريخ % % 2(@)(@@) % ولقد وثقت بجوده متبصرا % من قبل شم روائح البطيخ % % PageV01P534 البحر : - 1(@)(@@) % أخط سؤالي بالرقاع ولا أرى % % جفاءك يا هذا بوصلك ينسخ % % 2(@)(@@) % ويذبح جفني بالدموع وما له % % سوى الشهر بعد الشهر في البعد يسلخ % % 3(@)(@@) % ترى هل لعامي من جبينك غرة % % بها لا بدمعي المستهل يؤرخ % % 4(@)(@@) % لئن اشبهت منك الغصون معاطفا % لقد أصبحت أيضا تتيه وتشمخ % % PageV01P535 البحر : - 1(@)(@@) % ولا عبة بنفس المرء يمشي % % هواها مثل ما يمشي الرخيخ % % 2(@)(@@) % تصيد طائر القلب المعنى % % بحبة خالها الصدغ الفخيخ % % 3(@)(@@) % كأن سيوف سيف الدين رشت % % حفافي خدها منه لطيخ % % 4(@)(@@) % أمير ما لأهل القصد صفر % لديه ولا لأهل الكبر طيخ % % 5(@)(@@) % قضى عدلا فلا عين بظلم % % بها خزر ولا أنف شميخ % % 6(@)(@@) % حمدت الله حين بدا لعيني % % شريح قضى وفي عمري شريخ % % 7(@)(@@) % فتى في يوم جود أو نزال % ويوم العلم والآراء شيخ % % 8(@)(@@) % فجود بنانه بحر فرات % وجود بنان أقوام فصيخ % % PageV01P536 البحر : - 1(@)(@@) % كأنك بي سكنت بخانقات % ووعظك قد ملا سمع المصيخ % % 2(@)(@@) % كسرت كؤوس شعري بعد دور % وتبت على يدي شيخ الشيوخ % % PageV01P537 البحر : - 1(@)(@@) % أفدي جمالا مذ عرفت 
ms115	 جميله % مااحتجت للتطفيل والتشريخ % % 2(@)(@@) % قال الرجا ان كنت عن إحسانه % % أعمى فشم روائح البطيخ % % PageV01P538 البحر : - 1(@)(@@) % طمعت بالعدل والاحسان منك معا % فكنت عندي بالإحسان غير سخي % % 2(@)(@@) % وقلت يكفي فقام العدل ينشدني % % حاشاه يفرق متا بيني وبين أخي % % PageV01P539 البحر : - 1(@)(@@) % سألته عن قومه فانثنى % % يعجب من افراط دمعي السخي % % 2(@)(@@) % وأبصر المسك وبدر الدجى % % فقال ذا خالي وهذا أخي % % PageV01P540 البحر : - 1(@)(@@) % مازلت أقلع شيبة نسخت بها % % سوداء عقد شبابها مفسوخ % % 2(@)(@@) % حتى غدت صفحات وجهي آية % لا ناسخ وفيها ولا منسوخ % % PageV01P541 البحر : - 1(@)(@@) % مولاي محي الدين دعوة مسمع % % نعمى يديك وللجواب مصيخ % % 2(@)(@@) % أصبحت من هجرانكم وبلادتي % % أعمى يشم روائح البطيخ % % PageV01P542 البحر : - 1(@)(@@) % أستغفر الله لا مالي ولا ولدي % % آسي عليه إذا ضم الثرى جسدي % % 2(@)(@@) % عفت الاقامة في الدنيا لو انشرحت % % حالي فكيف وماحظي سوى النكد % % 3(@)(@@) % وقد صدئت ولي تحت التراب جلا % إن التراب لجلاء لكل صدي % % 4(@)(@@) % لا عار في أدبي إن لم ينل رتبا % وإنما العار في دهري وفي بلدي % % 5(@)(@@) % هذا كلامي وذا حظي فيا عجبا % مني لثروة لفظ وافتقار يد % % 6(@)(@@) % انسان عيني أعشته مكابدة % وانما خلق الانسان في كبد % % 7(@)(@@) % وما عجبت لدهر ذبت منه أسى % لكن عجبت لضد ذاب من حسد % % 8(@)(@@) % تدور هامته غيظا علي ولا % % والله ما دار في فكري ولا خلدي % % 9(@)(@@) % من لي بمر الردى كيما يجاورني % % ربا كريما ويكفيني جوار ردي % % 10(@)(@@) % حياة كل امرىء سجن بمهجته % فاعجب لطالب طول السجن والكمد % % PageV01P543 11(@)(@@) % أما الهموم فبحر خضت زاخره % أما ترى فوق رأسي فائض الزبد % % 12(@)(@@) % وعشت بين بني الأيام منفردا % ورب منفعة في عيش منفرد % % 13(@)(@@) % لأتركن فريدا في التراب غدا % ولو تكثر ما بين الورى عددي % % 14(@)(@@) % ما نافعي سعة في العيش أو حرج % إن لم تسعني رحمى الواحد الصمد % 15(@)(@@) % يا جامع المال إن العمر منصرم % فابخل بمالك مهما شئت أو فجد % 16(@)(@@) % ويا عزيزا بخيط العجب ناظره % أذكر هوانك تحت الترب واتئد % % 17 
ms116	(@)(@@) % قالوا ترقى فلان اليوم منزلة % فقلت ينزله عنها لقاء غد % 18(@)(@@) % كم واثق بالليالي مد راحته % إلى المرام فناداه الحمام قد % 19(@)(@@) % وباسط يده حكما ومقدرة % ووارد الموت أدنى من فم ليد % % 20(@)(@@) % كم غير الدهر من دار وساكنها % % لا عن عميد ثنى بطشا ولا عمد % % PageV01P544 21(@)(@@) % زال الذي كان للعليا به سند % وزالت الدار بالعلياء فالسند % % 22(@)(@@) % تبارك الله كم تلقى مصائدها % % هذي النجوم على الدانين والبعد % % 23(@)(@@) % تجري النجوم بتقريب الحمام لنا % % وهن من قربه منها على أمد % 24(@)(@@) % لا بد أن يغمس المقدار مديته % % في لبة الجدي منها أو حشى الأسد % % 25(@)(@@) % عجبت من آمل طول البقاء وقد % % أخنى عليه الذي أخنى على لبد % % 26(@)(@@) % يجر خيط الدجى والفجر أنفسنا % % للترب ما لا يجر الحبل من مسد % % 27(@)(@@) % هذي عجائب تثني النفس حائرة % وتقعد العقل من عي على ضمد % 28(@)(@@) % مالي أسر بيوم نلت لذته % % وقد ذوى معه جزء من الجسد % % 29(@)(@@) % أصبحت لا أحتوي عيش الخمول ولا % إلى المراتب أرمي طرف مجتهد % % 30(@)(@@) % جسمي إلى جدثي مهواي من كثب % % فكيف يعجبني مهواي من صعد % % PageV01P545 31(@)(@@) % لا تخدعن بشهد العيش ترشفه % % فأي سم ثوى في ذلك الشهد % % 32(@)(@@) % و لا تراع أخا دنيا يسر بها % % ولا تمار أخا غي ولا لدد % % 33(@)(@@) % وان وجدت غشوم القوم في بلد % حلا فقل أنت في حل من البلد % % 34(@)(@@) % لأنصحنك نصحا إن مشيت به % % فياله من سبيل للعلى جدد % % 35(@)(@@) % إغضاب نفسك فيما أنت فاعله % % رضى مليكك فاغضبها ولا تزد % PageV01P546 البحر : - 1(@)(@@) % لام العذار أطالت فيك تسهيدي % % كأنها لغرامي لام توكيد % % 2(@)(@@) % وخلف وعدك خلق منك أعرفه % % فليت كان التجافي منك موعودي % % 3(@)(@@) % يا من أفند في وجدي عليه وما % % أبقى الاسى في ما يصغى لتفنيد % % 4(@)(@@) % عاب العدى منك أصداغا مجعدة % % عيب المقصر عن نيل العناقيد % % 5(@)(@@) % وعقد بند على خصر رجعت به % % ذا ناظر بنجوم الليل معقود % % 6(@)(@@) % كأنه تحت وجدان القبا عدم % واحيرتي بين معدوم وموجود % % 7 
ms117	(@)(@@) % رد الجفاء سؤالي فيك أجمعه % فما لسائل دمعي غير مردود % % 8(@)(@@) % لقد خضعت إلى وجدي كما خضعت % % إلى المؤيد أعناق الصناديد % % 9(@)(@@) % داعي المقاصد في علم وفي كرم % % إلى لقاء ملي الفضل مقصود % % 10(@)(@@) % تسري سفين الأماني نحو منزله % % فتستوي من أياديه على الجودي % % PageV01P547 11(@)(@@) % ذاك الذي أسعدت أعمارنا يده % % فما نفكر في حكم المواليد % % 12(@)(@@) % ملك اذا تليت أوصاف سودده % ألقى السراة اليها بالمقاليد % % 13(@)(@@) % ذو العلم قلد طلاب الهدى مننا % حتى وصفناه عن علم وتقليد % % 14(@)(@@) % و الجود راش ذوي الجدوى وطوقهم % % فما يزالون في سجع وتغريد % % 15(@)(@@) % و الجيش قد ألفت باليسر رايته % % تألف الطرف في مغراه بالسيد % % 16(@)(@@) % يبدو وقد سخر الله العباد له % % فالطير والوحش في الآفاق والبيد % % 17(@)(@@) % حتى يقول مواليه وحاسده % % هذا ابن أيوب أم هذا ابن داود % % 18(@)(@@) % لا تنكر المدحة الحسنى وقد قرنت % % بشاهد من معاليه ومشهود % % 19(@)(@@) % أغنى العفاة فلولا ناهيات تقى % أستنغفر الله سموه بمعبود % % 20(@)(@@) % و واصل الحرب حتى كل معركة % % كأنها بيت معنى ذات ترديد % % PageV01P548 21(@)(@@) % يهوى الرماح قدودا ذات منعطف % % والمرهفات خدودا ذات توريد % % 22(@)(@@) % اذا انتشى من دم الأوداج صارمه % % رمى العدى بشديد السطو عربيد % % 23(@)(@@) % و إن أفاض حديثا أو نوال يد % وردت من حالتيه غير مورود % % 24(@)(@@) % جواهرا لا يحد الوصف غايتها % % فاعجب لجوهر شيء غير محدود % % 25(@)(@@) % و أنعما دأبها اسداء بكر يد % لكنهن أياد ذات توليد % % 26(@)(@@) % لو أن للبحر جدواه لفاض على % % وجه الثرى بنفيس الدر منضود % % 27(@)(@@) % ولو أمر على صلد الصفا يده % لأنبت العشب منها كل جلمود % % 28(@)(@@) % يا حبذا الملك الساري على شيم % % تروى وتنقل عن آبائه الصيد % % 29(@)(@@) % أدنيت من نار فكري عود مبعثه % % عند الثناء ففاحت نفحة العود % % 30(@)(@@) % نعم العماد لراج مد رغبته % % فمد نحو لقاها طرف معمود % % PageV01P549 31(@)(@@) % يممت في حال مرحوم منازله % % ثم انثنيت وحالي حال محسود % % 32(@)(@@) % و رحت أنقل عن أيوب أنعمه % % نحو الصلات فمن عطف وتوكيد % % 33(@)(@@) % ان شئت 
ms118	 تنظر في زهر الربى مطرا % فانظر نوال يديه في أناشيدي % % 34(@)(@@) % و ان أردت عيانا أو محادثة % % فاهرع إلى سندي واسمع أسانيدي % % 35(@)(@@) % يا من تحليت من ألفاظه وندى % % كفيه حلية فضل ذات تجديد % % 36(@)(@@) % ان كان لفظك مثل القرط في أذني % % فإن جدواك مثل العقد في جيدي % % PageV01P550 البحر : - 1(@)(@@) % عذيري من ساجي اللواحظ أغيد % % يصول بأسياف الجفون ولا يد % % 2(@)(@@) % غزال يناجيني بلفظ معرب % % ولكنه يسطو بلحظ مهند % % 3(@)(@@) % وقد روت عن لينه واعتداله % % صحاح العوالي مسندا بعد مسند % % 4(@)(@@) % إذا قعدت أردافه قام عطفه % % فيا طول شجوي من مقيم ومقعد % % 5(@)(@@) % كلفت به من قبل ما طال قده % % فطو له فرط العناق المردد % % 6(@)(@@) % وعاينت من فيه العقيقي خاتما % فصغت له باللثم فص زبرجد % % 7(@)(@@) % وحدثني من ثغره ورضا به % % عن الجوهري المنتقى والمبرد % % 8(@)(@@) % وكنت حذرت الخود حين تمردت % % فأوقعني طرفي لأمرد أمرد % % 9(@)(@@) % يخيل لي أني له لست عاشقا % لأن ليس لي في حبه من مفند % % 10(@)(@@) % ولولا الهوى ما بت بالدمع غارقا % عليه وأشكو للورى غلة الصدي % % PageV01P551 11(@)(@@) % وألثم عطفيه وجفنيه بعد ما % % قتلت برمح منهما ومهند % % 12(@)(@@) % وأبصر فيما تحت صدغيه من سنا % خيالي خلوقا تحت محراب مسجد % % 13(@)(@@) % ورب مدام من يديه شربتها % % معتعة تدعو لعيش مجدد % % 14(@)(@@) % إذا جئته تعشو إلى ضوء كاسه % % تجد خير نار عندها خير موقد % % 15(@)(@@) % تحدثك الأنفاس فيها عن اللما % % ويأتيك بالأخبار من لم تزود % % 16(@)(@@) % فشم بارقا قد خولتك ولا تشم % % لخولة اطلال ببرقة ثهمد % % 17(@)(@@) % من اللآء خفت في يمين مديرها % % فلو أهرقتها الكأس لم تتبدد % % 18(@)(@@) % مصعدة من حيث تم كيانها % % تطاف علينا في إناء مجسد % % 19(@)(@@) % فأحسن بها من كف ساق كأنه % % إذا حفها محتاب ثوب مورد % % 20(@)(@@) % إذا قهقه الإبريق في فمه انثنى % % فقل في قضيب ماس تحت مغرد % % PageV01P552 21(@)(@@) % كأن سنا راووقها وصبيبها % % حبال شعاع الشمس تفتل باليد % 22(@)(@@) % كأن بقايا ما نضامن كؤسها % % أساور تبر في معاصم خرد % % 23(@)(@@) % كأن 
ms119	 مليك الفرس صور نفسه % على جامها عمدا فمن يدن يسجد % 24(@)(@@) % سقى الغيث عني ذلك العيش إنه % % تولى هنيءالورد غير مصرد % % 25(@)(@@) % و فرق إلا مقلتي وسهادها % % وجمع إلا مهجتي وتجلدي % % 26(@)(@@) % و بدر سرى في طية البين متهما % فيا صاحبي دمعا لعلك منجدي % % 27(@)(@@) % و قال التسلي بعدنا لجفونه % % سهرت زمانا يا نواعس فارقدي % % 28(@)(@@) % حبيب قسمت الشعر ما بين حسنه % وأوصاف ملك شامخ القدر أصيد % 29(@)(@@) % فلا غزل إلا له من قصيدة % ولا مدح إلا للمليك المؤيد % 30(@)(@@) % مليك رأى أن لا مباري في الورى % % فظل يباري سؤدد اليوم بالغد % PageV01P553 31(@)(@@) % أخو عزمات في العلى جد جدها % % فلا دد منها لا ولا هي من دد % 32(@)(@@) % سما وعلا حتى كأن ذيوله % غمائم قد لينت على فرق فرقد % % 33(@)(@@) % يطوف رجآء المعتفين مقامه % % بأبلج هطال اليدين ممجد % 34(@)(@@) % لو اختصمت أهل المكارم في الندى % % لقال مقال الحق ملكي وفي يدي % % 35(@)(@@) % و لو قصدته الوحش والطير لم ترع % % بمفترس يوما ولا متصيد % % 36(@)(@@) % كذلك فليحفظ تراث جدوده % مليك بني فوق الأساس الموطد % % 37(@)(@@) % توافقت الأهواء في ذات فضله % % فمن حاكم عن علمه ومقلد % % 38(@)(@@) % متى شئت يا راعي الكرام وجدته % % غمام الندى في دسته قمر الندي % % 39(@)(@@) % يؤم حماه طالب بعد طالب % فذو الحال يستجدي وذو العلم يقتدي % % 40(@)(@@) % مباحث علم بلدت كل مفصح % % على أنها قد فصحت كل أبلد % % PageV01P554 41(@)(@@) % و لفظ كان السحر فيه محلل % ألم تره في الذوق غير معقد % % 42(@)(@@) % كأن النجوم الزهر في كبد الدجى % % شرار لظى من ذهنه المتوقد % % 43(@)(@@) % و لا عيب فيه غير إسراف جوده % % وأن مدى علياه غير محدد % % 44(@)(@@) % تجول ثغور اللثم حول بنانه % % كما جال عقد في ترائب أجيد % % 45(@)(@@) % هي النفس ماأفنت ثراء مفرقا % فعوضها إلا بمجد منضد % % 46(@)(@@) % و ما المال بين الناس إلا أزاهر % بروض متى لم تجن تهو وتفقد % % 47(@)(@@) % رعى الله أيام المؤيد إنها % % أحق وأولى بالثناء المؤيد % % 48(@)(@@) % حمت وهمت فالناس ما 
ms120	 بين هاجد % أمانا وداع في الدجى متهجد % % 49(@)(@@) % و ما عرفت يومي ندى وشجاعة % % بأخلاق موعود ولا متوعد % % 50(@)(@@) % ورب وغى موهي السوابغ حرها % % ويترك أعطاف الحسام كمبرد % % PageV01P555 51(@)(@@) % تيممها الملك المؤيد وادعا % تيمم منصور اللواء مطود % % 52(@)(@@) % جلت بمساويك الرماح جيوشه % % خلوف العدى من كل ثغر ممهد % % 53(@)(@@) % وصلت بأوطان الشهادة بيضهم % % تماما كأن البيض زوار مشهد % % 54(@)(@@) % تقوم بأيديهم وتركع في الطلا % % وتسجد في بطن الجواد المزرد % % 55(@)(@@) % دع المبتغي نحو الاركام شافعا % وجئه فقيرا بالرجاء المجرد % % 56(@)(@@) % هنالك تلقى نعمة إثر نعمة % لداعي الندى مثل النداء المؤكد % % 57(@)(@@) % و مبيض آثار الصنائع أحمدت % % مناقبه أيام كل مسود % % 58(@)(@@) % اذا شام رأيا في الملمات كفها % % بأفتك من صرف الزمان واكيد % % 59(@)(@@) % و ان طلب الاعداء راع جيادهم % % فذو السبق في تمحيله كالمقيد % % 60(@)(@@) % و خلفهم تبكي على الجسد الطلا % % بكاء لبيد يوم فرقة أربد % PageV01P556 61(@)(@@) % و قصر عن هيجائه شعر مادح % فأصغى إلى مدح الوشيج المقصد % % 62(@)(@@) % و حدثنا يوم الفخار جبينه % % أخاديث صدق عن طهارة محتد % % 63(@)(@@) % و لولا تكاليف العلى وشجونها % % لما كان فيها مرصد فوق مرصد % % 64(@)(@@) % ليهنك ود الناصر الملك انه % دليل على وصل الهنا المتودد % % 65(@)(@@) % أخذت به من كل ريب براءة % فيالك من أنفال رأي مسدد % % 66(@)(@@) % و قطعت أسباب الحوادث بعدما % % علقت بحبل من حبال محمد % % 67(@)(@@) % و هزك غصنا في مهمات ملكه % % فصان بمسلول وزان بمعمد % % 68(@)(@@) % و مازلت للألقاب في الفضل صالحا % تشرفها ما بين مثنى وموحد % % 69(@)(@@) % كأني بأوطان العراق وقد عنت % لشام وأقصى شرقها وكأن قد % % 70(@)(@@) % و لست اذا عد المقال بكاهن % ولكن من تزجر بيمنك يرشد % % PageV01P557 71(@)(@@) % اليك سلكت الخلق سمحا وباخلا % وجبت المرامي فدفدا بعد فدفد % % 72(@)(@@) % فوفيتني وعد الاماني وانها % % سجية اسماعيل في صدق موعد % % 73(@)(@@) % و جاد بك الدهر البخيل وطالما % % تدفق عذب الماء من قلب جامد % % 74(@)(@@) % فيا ليت قومي يعلمون بأنني % % تعجلت من نعماك أضعاف مقصدي % % 75(@)(@@) % و جملت فيك 