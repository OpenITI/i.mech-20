ms121	 أبكي عليه ، وأبكي % % 2(@)(@@) % قلت للكأس ، وهو يكرع فيها : % ذقت ، والله ، منه اطيب منك % % PageV01P699 البحر : بسيط تام 1(@)(@@) % لبيك ، يا من دعاني عند عثرته ، % لبيك ألفين ، يا مولاي ، لبيكا % % 2(@)(@@) % لو كنت منك قريبا حين تسمعني ، % جعلت خدي أرضا تحت رجليكا % % 3(@)(@@) % جسمي يقيك الذي تشكوه من ألم ، % ودمع عيني يفدي دمع عينيكا % % PageV01P700 البحر : وافر تام 1(@)(@@) % صددت ، وإن صددت برغم أنفي ، % فكم في الصد من نظر إليكا % % 2(@)(@@) % أراك بعين قلب لا تراها % % عيون الناس من حذر عليكا % % 3(@)(@@) % فأنت الحسن لا صفة بحسن ، % و أنت الخمر ، لا ما في يديكا % % PageV01P701 البحر : مجتث 1(@)(@@) % ما حان لي أن أراكا ، % وأن أقبل فاكا % % 2(@)(@@) % قلبي بكفيك ، فانظر % هل فيه خلق سواكا % % PageV01P702 البحر : بسيط تام 1(@)(@@) % قالت : تبدلت أخرى ؛ قلت : أفديك % من كل سوء ومكروه ، وأحميك % 2(@)(@@) % قالت : وسميتها في الشعر ، قلت لها : % سميت غيرك لكن كنت أعنيك % 3(@)(@@) % دعي العتاب لطي الكتب ، واغتنمي % % يوم التلاقي وروي فاي من فيك % % PageV01P703 البحر : وافر تام 1(@)(@@) % أغار عليك من قلبي ، إذا ما % % رآك ، وقد نأيت ، وما أراك % 2(@)(@@) % وطيفي ، حين نمت فبات ليلا % يسير ، ولم أسر حتى أتاك % 3(@)(@@) % و غيثا جاد ربعا منك قفرا ، % أليس كما بكيتك قد بكاك % 4(@)(@@) % و من عين الرسول ومن كتاب ، % إذا ما فض مسته يداك % 5(@)(@@) % ومن طرف القضيب من الأراك % إذا أعطيته ، يا شر ، فاك % PageV01P704 البحر : رجز تام 1(@)(@@) % ويحك ، بل ويبك ، بل وويكا ، % إن يديك قد جنت عليكا % % 2(@)(@@) % شرا تعض دونه كفيكا ، % فلا تدعني كربة إليكا % % 3(@)(@@) % و من كلا أذنيك لا لبيكا % . . . . . . . . . . . . % PageV01P705 البحر : بسيط تام 1(@)(@@) % يا قرمطيون هلا قام قبلكم % كمثل ما قام قبل البعث أو تركا % % 2(@)(@@) % أما علمتم بأن الله أطلقه ، % لا تذكروا بعده ملكا ولا ملكا % % PageV01P706 البحر : طويل 1(@)(@@) % أدبرا علي الكأس ليس لها ترك ، % و يا لائمي ! لي فتنتي ولك النسك % 2(@)(@@) % دعوني ونفسي ، وبارك الله فيكم ، % أما لأسير الغي من لومكم فك % 3(@)(@@) % إذا لم يكن 
ms122	 للرشد والنصح قابلا ، % فسخطكم جهل ولومكم محك % 4(@)(@@) % فخلوا فتى باللهو والكأس مغرما ، % فما عنده سمع فهل عندكم ترك % 5(@)(@@) % معتقة صاغ المزاج لرأسها % % أكاليل در ما لمنظومها سلك % 6(@)(@@) % جرت حركات الدهر فوق سكونها % % فذاب كذوب التبر أخلصه السبك % 7(@)(@@) % وأدرك منها الآخرون بقية % من الروح في جسم أضر به النهك % 8(@)(@@) % فقد خفيت من صفوها ، فكأنها % % بقايا يقين كاد يدركه الشك % 9(@)(@@) % و طاف بها ساق أديب بمبزل ، % كخنجر عيار ، صناعته الفتك % 10(@)(@@) % وردت إلينا الشمس ترفل في الدجى ، % فكان لستر الليل من نورها هتك % PageV01P707 11(@)(@@) % إذا سكنت قلبا ترحل همه ، % وطابت له دنياه وانقمع الضنك % 12(@)(@@) % وما الملك في الدنيا بهم وحسرة ، % و لكنما ملك السرور هو الملك % PageV01P708 البحر : - 1(@)(@@) % بخلا بهذا الدهر لست أراك ، % وإذا سلا أحد ، فلست كذاك % 2(@)(@@) % غادرت ذا سقم بحبك مدنفا ، % غياك من دم مثله إياك % 3(@)(@@) % سحرت عيون الغانيات وقتلت ، % لا مثل ما فعلت به عيناك % 4(@)(@@) % لم تقلعا حتى تخضب من دمي % % سهماهما ، وحسبت من قتلاك % 5(@)(@@) % باتت يغنيها الحلي ، وأصبحت % كالشمس تنظم جواهراص بأراك % 6(@)(@@) % لا مثل منزلة الدويرة منزل ، % يا دار جادك وابل وسقاك % 7(@)(@@) % بؤسا لدهر غيرتك صروفه ، % لم يمح من قلبي الهوى ومحاك % 8(@)(@@) % لم يحل لعينين بعدك منظر ، % ذم المنازل كلهن سواك % 9(@)(@@) % أي المعاهد منك أندب طيبه ، % ممساك في الآصال أم مغداك % 10(@)(@@) % أم برد ظلك ذي العيون وذي الحيا ، % أم أرضك الميثاء أم رياك % PageV01P709 11(@)(@@) % فكانما سقطت مجامر عنبر ، % أو فت فأر المسك فوق ثراك % 12(@)(@@) % وكأنما حصباء أرضك جوهر ، % وكأن ماء الورد دمع نداك % 13(@)(@@) % و كأنما ايدي الربيع ، ضحية ، % نشرت ثياب الوشي فوق رباك % 14(@)(@@) % وكأن درعا مفرغا من فضة ، % ماء الغدير جرت عليه صباك % PageV01P710 البحر : مجتث 1(@)(@@) % نقطت صدغك ذالا ، % فالويل من شكل ذالك % % 2(@)(@@) % لو أن ذالك ذالي ، % سجدت من أجل ذلك % % PageV01P711 البحر : وافر تام 1(@)(@@) % ألا تسلو فتقصر عن هواكا ، % ألا ومشيب رأسك خان ذاكا % % 2(@)(@@) % أراك تزيد 
ms123	 حذقا بالمعاصي ، % إذا ما طال في الدنيا مداكا % % PageV01P712 البحر : بسيط تام 1(@)(@@) % يا نفس صبرا لعل الخير عقباك ، % خانتك من بعد طول الأمن دنياك % 2(@)(@@) % لكن هو الدهر لقياه على حذر ، % فرب حارس نفسي تحت أشراك % PageV01P713(@)(@@)(@@)(@@) | البحر : منسرح 1(@)(@@) % تعاهدتك العهاد يا طلل ، % حدث عن الظاعنين ، ما فعلوا % % 2(@)(@@) % فقال : لم أدر غير أنهم % صاح غراب بالبين ، فاحتملوا % % 3(@)(@@) % لا طال ليلي ، ولا نهاري من % % يسكنني ، أو يردهم قفل % 4(@)(@@) % و لا تحليت بالرياض ، ولا النو % % ر ، ومغناي منهم عطل % 5(@)(@@) % علي هذا ، فما عليك لهم ؟ % قلت : حنين ودمعة تشل % 6(@)(@@) % و غنني مقفل الضمائر من % % حب سواهم ، ما حنت الإبل % 7(@)(@@) % فقال : مهلا تبعتهم أبدا ، % إن نزلوا منزلا ، وإن رحلوا % % 8(@)(@@) % هيهات ! إن المحب ليس له % هم بغير الهوى ، ولا شغل % 9(@)(@@) % تركت أيدي النوى تعودهم ، % وجئتني عن حديثهم تسل % 10(@)(@@) % فقلت للركب : لا قرار لنا ، % من دون سلمى ، وإن أبى العذل % PageV01P714 11(@)(@@) % و لم نزل نخبط البلاد بأخفا % % ف المطايا ، والظل معتدل % 12(@)(@@) % كأنما طار تحتنا قزع ، % على اكف الرياح ينتقل % 13(@)(@@) % يفري بطون النقا النقي ، كما % % يطعن بين الجوانح الأسل % 14(@)(@@) % حتى تبدى في الفجر ظعنهم ، % وسائق الصبح بالدجى عجل % 15(@)(@@) % و فوقهن البدور يحجبها % % هوادج تحت رقمها الكلل % 16(@)(@@) % فلم يكن بيننا سوى اللحظ والدم % % ع كلام لنا ، ولا رسل % 17(@)(@@) % هذا هذا ، فما لذي إحن % يدس لي كيده ، ويختتل % 18(@)(@@) % و غن حضرت الندي وكل بي % % لحظا بنبيل الشحناء ينتضل % 19(@)(@@) % يا ويله من وثوب مفترس ، % رب سكون من تحته عمل % 20(@)(@@) % استبق حلمي لا تفنه سرفا ، % فبعد حلمي لأمك الثكل % PageV01P715 21(@)(@@) % وقد ترديت بابن صاعقة ، % أخضر ما في غراره فلل % 22(@)(@@) % كم من عداة أبادهم غضبي ، % فلم أقل : أين هم ، وما فعلوا % % PageV01P716 البحر : - 1(@)(@@) % أسألت طللا ، % بالبرق قد خلا % % 2(@)(@@) % محولا جرت به ال % % رياح ذيلا معجلا % % 3(@)(@@) % هل أصاب بعدنا % % من سليمى منزلا % % 4(@)(@@) % ساءك الدهر بها ، % و قديما فعلا % % 5(@)(@@) % غادة قد 
ms124	 جعلت % لفؤادي شغلا % % 6(@)(@@) % موقرا بمائه ، % قد أتم حيلا % % 7(@)(@@) % عطش الشوق به ، % و سقى أهل الملا % % 8(@)(@@) % ولقد أغدو على % % غارب قد كملا % % 9(@)(@@) % مرح مسحله ، % لا يروم مرحلا % % 10(@)(@@) % قد رأينا مشربا % غدقا وماكلا % % PageV01P717 11(@)(@@) % فهو في حاجاته ، % مدبرا ومقبلا % % 12(@)(@@) % فلحقنا نفسه % بدم مزملا % % 13(@)(@@) % و دفعنا خلفهث % % صلتانا هيكلا % % 14(@)(@@) % قدرت أربعه % للوحوش أجلا % % 15(@)(@@) % عاصف السير ، إذا % % ما به السير غلا % % 16(@)(@@) % و لقد بلغني الظا % % عنون أملا % % 20(@)(@@) % حل قلبي ، ثم قد % % PageV01P718 البحر : رجز تام 1(@)(@@) % سقيا لأيام مضت قلائل ، % أذ ألا في عذر الشباب الجاهل % 2(@)(@@) % وأملي مطيع قلب الآمل ، % و لمتي مصقولة السلاسل % 3(@)(@@) % أحكم في أحكام دهر غافل ، % فقصر الحق عنان الباطل % 4(@)(@@) % ووعظ الدهر بشيب شامل ، % و شكني بأسهم قواتل % 5(@)(@@) % صوائب تهتز في المقاتل ، % أفلست من ذاك الزمان القاتل % 6(@)(@@) % إلا بطول الذكر والبلابل ، % قد كنت حيادا عن الحبائل % 7(@)(@@) % لا تلتقي بي طرق المناهل ، % و لا أرى فريسة لآكل % 8(@)(@@) % من معشر هم جلة القبائل ، % منفردا بحسب ونائل % 9(@)(@@) % و أدب يكثر غيظ الجاهل ، % وقوت نفس كان غير واصل % 10(@)(@@) % يقعدني عنه قيام السائل ، % و يفتديني من رجاء الباخل % PageV01P719 11(@)(@@) % ورأي قلب كالحسام فاصل ، % مهذب ، يرسب في المفاصل % 12(@)(@@) % كم قد عرفت من صديق باخل % و حاسد يشير بالأنامل % 13(@)(@@) % يرجمني بكذب وباطل % . . . . . . . . . . . . . . . . % PageV01P720 البحر : رجز تام 1(@)(@@) % في اليأس لي عز كفاني ذلي ، % يشركني في الموت كل خل % 2(@)(@@) % و لست ممن فضله من فضلي ، % والسيف راع إبلي في المحل % 3(@)(@@) % يسوقها إلى قدور تغلي ، % ترقل فيها بالقدور الجزل % 4(@)(@@) % إرقالها والسير تحت الرحل ، % رأيت بالجود عيوب البخل % PageV01P721 البحر : رجز تام 1(@)(@@) % جل امرؤ منفردا وجلا % في زمن لم ير فيه مثلا % % 2(@)(@@) % قد أكل الحمد تلادي أكلا ، % و العضب لا يثنيه إن يفلا % PageV01P722 البحر : رجز تام 1(@)(@@) % فقري غني ، وشبابي كهل ، % و كل فضل لي عليه فضل % 2(@)(@@) % أشكو لجودي حين يشكو البخل ، % وليس عندي لخؤون وصل 
ms125	 % 3(@)(@@) % و لا ، إذا عز أخ أذل ، % إن كنت لم تبل فسوف تبلو % % PageV01P723 البحر : طويل 1(@)(@@) % أهاجك أم لا بالدويرة منزل ، % يجد هبوب الريح فيه ويهزل % 2(@)(@@) % قضيت زمان الشوق في عرصاته ، % بدمع همول فوق خدي يهطل % 3(@)(@@) % وقفت بها عيسي تطير بزجرها ، % و يأمرها وحي الزمان فترقل % 4(@)(@@) % طلوبا برجليها يديها ، كما اقتضت % يد الخصم حقا عند آخر يمطل % 5(@)(@@) % وبالقصر ، إذا خاط الخلي جفونه ، % عناني برق بالدجيل مسلسل % 6(@)(@@) % وإني لضوء البرق من نحو دارها ، % غذا ما عناني لمحه ، لموكل % 7(@)(@@) % تشقق ، واستدعى كما صدع الدجى % % سنى قبس في جذوة يتأكل % 8(@)(@@) % و لله ميثاق لدي نقضته ، % وقلت : دعوه خاليا يتنقل % 9(@)(@@) % ووعد ، وخلف بعده ، وتمنع % وسرعة هجران ، ووصل موصل % 10(@)(@@) % وقد أشهد الغازات والموت شاهد ، % يجور بأطراف الرماح ، ويعدل % PageV01P724 11(@)(@@) % بطعن تضيع الكف في لهواته ، % وضرب كما شق الرداء المرعبل % 12(@)(@@) % وخيل طواها القور حتى كأنها % % انابيب سمر من قنا الخط ذبل % 13(@)(@@) % صببنا عليها ظالمين سياطنا ، % فطارت بها ايد سراع وارجل % 14(@)(@@) % و كل الذي سر الفتى قد أصبته ، % وساعدني منه أخير وأول % 15(@)(@@) % فمن اي شيء يا ابنة القوم أحتوي % % على مهجتي ، أو أي شيء أومل % 16(@)(@@) % إذا المرء أفنى صبح يوم وثانيا ، % أتاه صباح ، بعد ذلك ، مقبل % 17(@)(@@) % ويتبع الآمال موقع لحظه ، % فليس له عاش في الناس منزل % 18(@)(@@) % وللدهر سر سوف يظهر أمره ، % وللناس جائر سوف يعدل % PageV01P725 البحر : وافر تام 1(@)(@@) % ألم تحزن على الربع المحيل ، % وأطلال وآثار محول % 2(@)(@@) % عفته الريح تعدل كل يوم ، % وجالت فيه أعناق السيول % 3(@)(@@) % و بدلض ، بعد أسباب التصابي ، % بأسباب التذكر بالقليل % 4(@)(@@) % أنار من تهامة لم تغمض % % بدت لك ، أم سنى برق كليل % 5(@)(@@) % تقاضاك الهوى عن أهل نجد ، % فلم تصرف إلى دمع مطول % 6(@)(@@) % أيقتل كل مشتاق هواه ، % كما حدثت عن يوم الرحيل % 7(@)(@@) % و يوم دارس الآثار خال ، % كدمع حار في جفن كحيل % % 8(@)(@@) % طرقت بيعملات ناجيات ، % و أفق الصبح أدهم ذو حجول % 9 
ms126	(@)(@@) % و جمع سار يقدمه لواء ، % كفضل عمامة الرجل الطويل % 10(@)(@@) % مريض الخوف تخفق رايتاه % على أهل الضغائن والتبول % PageV01P726 11(@)(@@) % شهدت فلم أنم ثأرا بفخر ، % ولم أغلب على العفو الجميل % 12(@)(@@) % ومال قد حللت الوعد عنه ، % غذا انعقدت به نفس البخيل % 13(@)(@@) % وأوثر صاحبي بفضل زادي ، % وأحيي النفس بالبلل القليل % 14(@)(@@) % أقمنا الميل آخرة وبدءا ، % من الأحياء في الزمن الطويل % 15(@)(@@) % بمشعلة تزف إلى الأعادي % % كأن رجالها آساد غيل % 16(@)(@@) % و كنا ، والقبائل من معد ، % كذي رحل تقدم بالزميل % PageV01P727 البحر : كامل تام 1(@)(@@) % وغدت كجلمود القذاف يقلهاهاتيك دارهم ، فعرج واسأل ، % مقسومة بين الصبا والشمأل % 2(@)(@@) % و كأننا لم نغن بين عراصها ، % في غبطة ، وكأننا لم نحلل % 3(@)(@@) % لجت جفونك بالبكاء فخلها % % تسفح على طلل ، لشر ، محول % 4(@)(@@) % ولرب مهلكة يحار بها القطا ، % مسجورة بالشمس ، خرق مجهل % 5(@)(@@) % خلفتها بشملة تطأ الدجى ، % مرتاعة الحركات ، حلس ، عيطل % 6(@)(@@) % ترنو بناظرة كأن حجاجها % % وقب أناف بشاهق لم يحلل % 7(@)(@@) % و كأن مسقطها ، إذا ما عرست ، % آثار مسقط ساجد متبتل % 8(@)(@@) % و كأن آثار النسوع بدفها ، % مسرى الأساود في هيام أهيل % 9(@)(@@) % ويشد حاديها بحبل كامل ، % كعسيب نخل خوصه لم ينجل % 10(@)(@@) % وكأنها عدوا قطاة صبحت % زرق المياه وهمها في المنزل % PageV01P728 11(@)(@@) % ملأت دلاء تستقل بحملها ، % قدام كلكلها كصغرى الحنظل % 12(@)(@@) % وغدت كجلمود القذاف يقلها % % واف كمثل الطيلسان المخمل % 13(@)(@@) % حملتها ثقل الهموم ، فقطعت % أسبابهن بنا تخب وتعتلي % % 14(@)(@@) % عن عزم قلب لم اصله بغيره ، % عضب المضارب ، صائب للمفصل % 15(@)(@@) % حتى إذا اعتدلت عليهم ليلة % سقطوا إلى أيدي قلائص نحل % 16(@)(@@) % حتى استشارهم دليل فارط ، % يسمو لغايته بعيني أجدل % 17(@)(@@) % وكأنها عدوا قطاة صبحت % مسرى الأساود في هيام أهيل % 18(@)(@@) % لبس الشحوب من الظهائر وجهه ، % فكأنه ماوية لم تصقل % 19(@)(@@) % سار بلحظته ، إذا استبه الهدى ، % بين المجرة والسماك الأعزل % 20(@)(@@) % و لرب قرن قد تركت مجدلا ، % جزرا لضارية الذئاب العسل % PageV01P729 21(@)(@@) % عهدي به والموت يخفر روحه ، % وبرأسه كفم الفنيق الأهزل % 22(@)(@@) % و لقد قفوت الغيث 
ms127	 ينطف دجنه ، % والصبح ملتبس كعين الأشهل % 23(@)(@@) % بطمرة ترمي الشخوص بمقلة % كحلاء تغرب عن ضمير المشكل % 24(@)(@@) % فوهاء يفرق بعين شطري وجهها % % نور ، تخال سناه سلة منصل % 25(@)(@@) % وكأنما ، تحت العذار ، صفيحة % عنيت بصفحتها مداوس صيقل % PageV01P730 البحر : منسرح 1(@)(@@) % و زائر زارني على عجل ، % منقب الوجنتين بالخجل % 2(@)(@@) % قد كانض يستكثر الكتاب لنا ، % فجاد بالاعتناق والقبل % 3(@)(@@) % يقوده الشوق خائفا وجلا ، % تحت الدجى ، والعيون في شغل % 4(@)(@@) % فنلت منه الذي أؤمله ، % بل الذي كان دونه أملي % % PageV01P731 البحر : خفيف تام 1(@)(@@) % لي حبيب يكدني بمطاله ، % غش ديني بحسنه وجماله % 2(@)(@@) % قمر يلبس الظلام ضياء ، % عجب النقص في الورى من كماله % 3(@)(@@) % نازح الوصل ليس يرحم آما % % لي من طول هجره واعتلاله % 4(@)(@@) % وجهت نفسي الرجاء إليه ، % فاقامت على انتظار نواله % PageV01P732 البحر : مجزوء الرجز 1(@)(@@) % تفاحة معضوضة ، % كانت رسول القبل % 2(@)(@@) % لو كان فيها وجنة ، % تنقبت بالخجل % 3(@)(@@) % تناولت كفي بها % % ناحية من أملي % % 4(@)(@@) % لست أرجي غير ذا ، % يا ليت هذا دام لي % % PageV01P733 البحر : مديد تام 1(@)(@@) % ما قليل منك لي بقليل ، % يا منى نفسي ، وغاية سؤلي % % 2(@)(@@) % سل بحق الله عينك عني ، % هل أحست في الورى بقتيل % 3(@)(@@) % أنت أفسدت الحياة بهجر ، % و مماتي بحساب طويل % PageV01P734 البحر : متقارب تام 1(@)(@@) % عناء المحب طويلق طويل ، % و صبر المحب قليل قليل % 2(@)(@@) % وزلات رسل الهوى لا تقا % % ل ، وكم من محب نفاه الرسول % 3(@)(@@) % أسأت بي الظن ، يا سيدي ، % وما سوء ظن بمثلي جميل % 4(@)(@@) % إذا أنا خنت ، فمن ذا يفي ، % أتدري ، فديتك ، ماذا تقول % PageV01P735 البحر : مجزوء الرمل 1(@)(@@) % أيها الليل الطويل % سر وخفف ، يا ثقيل % 2(@)(@@) % أين ضوء الصبح عني ، % غالت الأصباح غول % PageV01P736 البحر : طويل 1(@)(@@) % أعاذلتي لا تعذلي عاشقا مثلي ، % ولكن دعيه واعذري الحب من أجلي % % 2(@)(@@) % و نوحي على صب بكت عائداته ، % صريع قدود البان والأعين النجل % 3(@)(@@) % رمين ، فلما أن أصبن مقاتلي ، % تولين ، فانضمت جراحي على النبل % PageV01P737 البحر : خفيف تام 1(@)(@@) % أي ورد على خدود الغزال ، % أي ميل 
ms128	 في قده واعتدال % 2(@)(@@) % أي در ، إذا تبسم يبدي % % ه ، وسحر في طرفه ودلال % PageV01P738 البحر : مجزوء الخفيف 1(@)(@@) % لا تعاتب ، غذا هوي % % ت ولا تكثر العذل % % 2(@)(@@) % لا تذكر بوصلك ال % % هجر ما دام قد عقل % % PageV01P739 البحر : سريع 1(@)(@@) % يا مفردا في الحسن والشكل ، % من دل عينيك على قتلي % % 2(@)(@@) % البدر من شمس الضحى نوره ، % و الشمس من نورك تستملي % % PageV01P740 البحر : بسيط تام 1(@)(@@) % جسم المحب بثوب السقم مشتمل ، % وجفنه بدموع الشوق مكتحل % 2(@)(@@) % و كيف يبقى على ذا مدنف كمد ، % لم يبق من صبره رسم ولا طلل % 3(@)(@@) % وظل عذاله ، لا كان عذله ، % لو يعلمون الذي ألقى لما عذلوا % % PageV01P741 البحر : مجزوء الرجز 1(@)(@@) % كم لي من عذول ، % بت له عذولا % % 2(@)(@@) % فرق لي ، وأمسى % % على الهوى دليلا % % 3(@)(@@) % و صار لي رسولا ، % و ترك الفضولا % % 4(@)(@@) % وقاد لي حبيبي ، % ولم يكن ثقيلا % % PageV01P742 البحر : متقارب تام 1(@)(@@) % أطلت ، وعذبتني ، يا عذول ، % بليت ، فدعني حديثي يطول % 3(@)(@@) % فما بال ذا الليل لا ينقضي ، % كذا ليل كل محب طويل % 4(@)(@@) % أبيت أساهر بدر الدجى % % إلى الصبح وحدي ودمعي يسيل % PageV01P743 البحر : خفيف تام 1(@)(@@) % قم ، ففرج عن كربتي ، يا رسول ، % إن عبد الهوى عبيد ذليل % 2(@)(@@) % صد عني ، فما يرد جوابي ، % ليت شعري متى تقول تقول % PageV01P744 البحر : خفيف تام 1(@)(@@) % صد عني تبرما ، وتملا % قمر لاح في الدجى وتجلى % % 2(@)(@@) % أسرعت عينه المليحة قتلي ، % لم تدعني في الحب أضنى وابلى % % 3(@)(@@) % أنا عبد لسيد لي جاف ، % كلما رمت وصله زاد بخلا % % PageV01P745 البحر : طويل 1(@)(@@) % بكاه على ما في الضميرش دليل ، % و لكن مولاه عليه بخيل % 2(@)(@@) % ولي كبد أمسى يقطعه الهوى ، % ودمع عصى الأجفان ، وهو يسيل % 3(@)(@@) % فيا عاذلي ، لا تحزنني بغادتي ، % فما ذاك بين العاشقين جميل % 4(@)(@@) % فهل لي إلا أن امون بحبها % % ضياعا ، ولا يدري بذاك خليل % 5(@)(@@) % إليك امتطينا العيس تنفخ في السرى ، % ولليل طرف بالصباح كحيل % 6(@)(@@) % وفتيان هيج باذلين نفوسهم ، % كأنهم تحت الرماح وعول % 7(@)(@@) % وجردت من أغماده 
ms129	 كل مرهف ، % إذا ما نتضته الكف كاد يسيل % 8(@)(@@) % ترى فوق متنيه الفرند ، كأنما % % تنفس فيه القين ، وهو ثقيل % 9(@)(@@) % فأعلمته كيف التصافح بالقنا ، % وكيف تروى البيض وهي محول % 10(@)(@@) % سريع إلى الأعداء ، أما جنانه % فماض ، وأما وجهه فجميل % PageV01P746 البحر : طويل 1(@)(@@) % كريم سليل للملوك مهذب ، % سريع العطايا عند كل سؤال % 2(@)(@@) % و جاءت به أم من السود أنجبت % كليلة سر طوقت بهلال % PageV01P747 البحر : كامل تام 1(@)(@@) % ضلوا وقادهم إمام ضلالة ، % قد كان بدل دينهم تبديلا % % 2(@)(@@) % ما زال يحمل دائبا أوزارهم ، % حتى أتيت برأسه محمولا % % 3(@)(@@) % فليهنك الظفر الذي أوتيته ، % وتردد الأعداء عنك نكولا % % PageV01P748 البحر : بسيط تام 1(@)(@@) % أقول لما تبدى راكب الفيل ، % وصح ما كان من قال ومن قيل % 2(@)(@@) % يزف في القيد محمولا إلى سقر ، % مقسما بين تنضيج وتبطيل % 3(@)(@@) % وأقبل المكتفي بالله يتبعه ، % فأكثر الناس من حمد وتهليل % 4(@)(@@) % انظر إلى حكمة الأقدار في ملك ، % كالشمس حسنا ، وفي قرد على فيل % PageV01P749 البحر : كامل تام 1(@)(@@) % ياصاح ! ودعت الغواني والصبا ، % وسلكت غير سبيلهن سبيلا % % 2(@)(@@) % و ثنيت أعناق الهوى نحو العلى ، % و رأيت شأو العاشقين طويلا % % 3(@)(@@) % فأجبت واعظة النهى ، فاستجمعت % ألفاظ عينك وانثنى مغلولا % % 4(@)(@@) % عهدان ماتا للأوانس والصبا ، % فاندبهما ، لا تندبن طويلا % % 5(@)(@@) % ذهبا بمعسول الحياة وأيسا ، % من رجعة وتعجل تحويلا % % 6(@)(@@) % بدلت ، من ليل الشباب بمفرقي ، % صبح النهى ، أحبب بذاك بديلا % % 7(@)(@@) % لكن في قلبي ، إذا صد الرشا % % عني ، أسى يعتادني ، وغليلا % % 8(@)(@@) % و لرب ليل لا تجف جفونه % من دمعة ملق عليه سدولا % % 9(@)(@@) % ماتت كواكبه ، وأمسى بدره ، % في الأفق ، متهم الحياة عليلا % % 10(@)(@@) % دبت بنا في غمرة مشمولة ، % حتى توهمنا الصباح أصيلا % % PageV01P750 11(@)(@@) % صفراء تحسبها ، إذا ما صفقت ، % ذهبا حوته كأسها محلولا % % 12(@)(@@) % أهلا وسهلا بالإمام ومرحبا ، % لو أستطيع غلى اللقاء سبيلا % % 13(@)(@@) % لا يمتطي حفظا ولا يمسي له % طرف بمرود رقدة مكحولا % % 14(@)(@@) % ومشمر أذياله يوم الوغى ، % جرت عليه السافيات ذيولا % % PageV01P751 البحر : كامل تام 1(@)(@@) % إن الفراق دعا الخليط ، فزالا ، % وقعدت 
ms130	 تسأل بعده الأطلالا % % 2(@)(@@) % طالت بهم ، والفجر قد أخذ الدجى ، % عيدية قود يخلن خلالا % % 3(@)(@@) % وكأن في الأحداج ، يوم ترحلوا ، % آرام سدر قد لبسن ظلالا % % 4(@)(@@) % يبدين بيضات الخدود كأنها % % صفحات هندي كسين صقالا % % 5(@)(@@) % بانت شريرة عنك ، إذ بانوا بها ، % واستخلفت في مقلتيك خيالا % % 6(@)(@@) % بيضاء آنسة الحديث كأنها % % قد أشعلت ، من حسنها ، إشعالا % % 7(@)(@@) % في وجهها ورق النعيم ملا العيو % % ن ملاحة ، وظرافة ، وجمالا % % 8(@)(@@) % عجبت شريرة ، إذ رأتني شاحبا ، % يا شر قد قلب الزمان ، وحالا % % 9(@)(@@) % يا شر قد حملت بعدك كربة ، % وهموم أشغال علي ثقالا % % 10(@)(@@) % وفساد قوم قد تمزق ودهم % % فعلا ، وضاعوا من يدي ضلالا % % PageV01P752 11(@)(@@) % ما تطمئن نفوسهم من نفرة ، % قطعت وسائل خلة وحبالا % % 12(@)(@@) % قوم هم كدر الحياة وسقمها ، % عرض البلاء بهم علي وطالا % % 13(@)(@@) % يتآكلون ضغينة وخيانة ، % و يرون لحم الغافلينض حلالا % % 14(@)(@@) % وهم فراش السوء يوم ملمة ، % يتهافتون تعاشيا وخيالا % % 15(@)(@@) % وهم غرابيل الحديث إذا دعوا % % شرا تقطر منهم ، أو سالا % % 16(@)(@@) % صرفت وجوه اليأس وجهي عنهم ، % وقطعت منهم خلة ، ووصالا % % 17(@)(@@) % و وهبتهم للصرم ، وابتل الثرى ، % ووجدت عذرا فيهم ومقالا % % 18(@)(@@) % و لقد أجازي بالضغائن أهلها ، % و اكون للمتعرضين نكالا % % PageV01P753 البحر : وافر تام 1(@)(@@) % شخوص ولا ية كشخوص عزل ، % على دهش وعز مثل ذل % 2(@)(@@) % و مجنون يخلص بعد حبس % وأقياد ، وسلسلة وغل % 3(@)(@@) % ولم تقض الحقوق ولا اقتضاها % % بتسليم وتوديع لخل % 4(@)(@@) % ولم أر قبله ريحا عصوفا % مجسمة ، وطومارا برحل % 5(@)(@@) % و أحبسها سيسلوها سريعا ، % ويرجع خائبا يرغو ويغلي % % 6(@)(@@) % و وجه العزل يضحك كل يوم % ويطبز في قفا الوالي المدل % PageV01P754 البحر : مجزوء الخفيف 1(@)(@@) % أف من وصف منزل ، % بعكاظ ، فحومل % 2(@)(@@) % غير الريح رسمه ، % بجنوب وشمأل % 3(@)(@@) % و سقى الله نهر عر % شى ، فباب التحول % 4(@)(@@) % حيث لا لوم في المجون ، % فما شئت فاجهل % 5(@)(@@) % يا خليلي أسقيا % % ني رحيق السلسل % 6(@)(@@) % ماترى البدر قد أتا % % ك بماء مصندل % 7(@)(@@) % و مليح مقرطق ، % احور العين أكحل % 8(@)(@@) % قلت 
ms131	 لم لا تزورني ؟ % قال : من لي ، وكيف لي ؟ % 9(@)(@@) % ورفاقي ، وغفلة ، % ليس يدرون من يلي % % PageV01P755 البحر : مجزوء الرمل 1(@)(@@) % من لأذني بعذول ، % ولكفي بشمول % 2(@)(@@) % قهوة تذهب عنا % % بهموم وعقول % 3(@)(@@) % استعن بالراح يا صا % % ح على الليل الطويل % 4(@)(@@) % قل لمن يبخل عني % % بقليل من قليل % 5(@)(@@) % بسلام من كلام ، % و بلحظ من رسول % 6(@)(@@) % هل إلى وصل ، وإلا ، % فسلوا : هل من سبيل ؟ % 7(@)(@@) % ويح نفسي من حبيب % ناقض العهد ، ملول % 8(@)(@@) % ظبي إنس ، فاتر الأل % % حاظ ذي جفن كحيل % 9(@)(@@) % عيروا عارضه بالمس % ك في خد أسيل % 10(@)(@@) % تحت صدغين يشيرا % % ن إلى وجه جميل % PageV01P756 11(@)(@@) % عندي الشوق إليه ، % و التناسي عنده لي % % 12(@)(@@) % فلقد قلت ليحيى ، % عند تقريب الحمول % 13(@)(@@) % إنما ينعون نفسي ، % إذ تداعوا بالرحيل % PageV01P757 البحر : وافر تام 1(@)(@@) % أعاذل قد أبحت اللهو مالي ، % و هان علي مأثور المقال % 2(@)(@@) % دعيني هكذا خلقي ، دعيني % % فما لك حيلة فيه ، ولا لي % % 3(@)(@@) % و يوم فاختي اللون مرخ % عزاليه بطل ، وانهمال % 4(@)(@@) % ربحت سروره ، وظللتث فيه ، % برغم العاذلات ، رخي بال % 5(@)(@@) % و ساق يجفل المنديل منه % مكان حمائل السيف الطوال % 6(@)(@@) % غلالة خده صبغت بورد ، % ونون الصدغ معجمة بخال % 7(@)(@@) % غدا والصبح تحت الليل باد ، % كطرف أبلق ملقى الجلال % 8(@)(@@) % بكأس من زجاج فيه أسد ، % فرائسهن ألباب الرجال % 9(@)(@@) % إذا ما صرعت منا نديما % توسد باليمين ، وبالشمال % 10(@)(@@) % ألم ترني بليت بذي دلال ، % خلي لا يرق ، ولا يبالي % % PageV01P758 11(@)(@@) % أقول ، وقد أخذت الكأس منه : % وقتك السوء ربات الجمال % PageV01P759 البحر : منسرح 1(@)(@@) % أكثرت يا عاذلي من العذل ، % أني عن العاذلين في شغل % 2(@)(@@) % أحسن من وقفة على طلل ، % و من بكاء في غثر محتمل % 3(@)(@@) % كاس مدام أحظيت فضلتها % % كف حبيب والفعل من قبلي % % 4(@)(@@) % في مجلس حثت الكؤوس به ، % فالقوم من مائل ومنجدل % 5(@)(@@) % يطوف بالراح بينهم رشأ % محكم في القوب والعقل % 6(@)(@@) % أفرغ نورا في قشر لؤلؤة ، % تجل عن قيمة وعن مثل % 7(@)(@@) % يكاد لحظ العيون حين 
ms132	 بدا % % يسفك من خده دم الخجل % PageV01P760 البحر : طويل 1(@)(@@) % صحا عاذلي عني ولم أصح من ضلي ، % و يا حبذا شر على المنع والبذل % 2(@)(@@) % وهبت لها قلبي ، فلا تطلبوا دمي ، % و ليس عليها من فداء ولا قتل % 3(@)(@@) % و لم أر مثل العاذلين على الهوى ، % جعلت لهم شغلا ، وخلاهم شغلي % % 4(@)(@@) % خليلي طوفا بالمدام ، وبادرا % % بقية عمري ، والسلام على مثلي % % 5(@)(@@) % ألا إنها جسمي لروحي مطية ، % ولا بد يوما أن تعرى من الرحل % % 6(@)(@@) % ويا عاذلي ! هلا اشتغلت بسامع ، % كما أنا مشغول بكأسي عن العذل % PageV01P761 البحر : طويل 1(@)(@@) % ألا عللاني ! إنما العيش تعليل ، % وما لحياة ، بعدها ميتة ، طول % 2(@)(@@) % دعاني من الدنيا أنل من نعيمها ، % فإني عنها بعد ذلك مشغول % 3(@)(@@) % خذا لذة من ساعة مستعارة ، % فليس لتعويق الحوادث تمثيل % PageV01P762 البحر : مجتث 1(@)(@@) % عذبتني باعتلالك ، % و طول عمر مطالك % % 2(@)(@@) % لا تنكري شيب رأسي ، % فإنه من فعالك % % PageV01P763 البحر : مجتث 1(@)(@@) % قم ، واسقني ، يا خليلي % % من المدام الشمول % 2(@)(@@) % أولى الشهور تقضت % شعبان في أيلول % 3(@)(@@) % قد زاد في الليل ليل ، % وطاب ظل المقيل % PageV01P764 البحر : مجزوء الوافر 1(@)(@@) % شغلت بلذة القبل ، % ووعد الكتب والرسل % 2(@)(@@) % و معشوق يواصلني ، % بلا وعد ولا علل % 3(@)(@@) % أتى عجلا ، يطير به % جناح الخوف والوجل % PageV01P765 البحر : مجزوء الكامل 1(@)(@@) % واصل نهارك ، يا خليلي ، % و اطرد همومك بالشمول % 2(@)(@@) % ودع العذول ، فإنه % سيمل من قال وقيل % PageV01P766 البحر : طويل 1(@)(@@) % ألا حي من أهل المحبة منزلا ، % تبدل من أيامه ما تبدلا % % 2(@)(@@) % أبن لي ، سقاك الغيثث حتى تمله ، % عن الآنس المفقود أين تحملا % % 3(@)(@@) % كأن التصابي كان تعريس نازل % ثوى ساعة من ليلة وترحلا % % 4(@)(@@) % وماء كأفق الصبح صاف جمامه % % دفعت القطا عنه وخففت كلكلا % % 5(@)(@@) % إذا استجفلته الريح جالت قذاته % % و جرد من أغماده فتسلسلا % % 6(@)(@@) % زجرت به سياح قفر كأنه % يخاف لجاقا ، أو يبادر آفلا % % 7(@)(@@) % وبيداء ممحال أطار بها القطا ، % كما قذفت أيدي المرامين جندلا % % 8(@)(@@) % كأني على حقباء تتلو لواحقا ، % غدون بإمساء يطالبن منهلا 
ms133	 % % 9(@)(@@) % يسوقها طاو أقب كأنما % % يحرك في حيزومه النهق جلجلا % % 10(@)(@@) % أتيح له لهفان يخطر قوسه % % بأصغر حنان القرا غير أعزلا % % PageV01P767 11(@)(@@) % فأودعه سهما كمدرى مواشط ، % بعثن به في مفرق ، فتغلغلا % % 12(@)(@@) % بطيئا إذا أسرعت إطلاق فوقه ، % و لكن إذا أبطأت في الريح عجلا % % 13(@)(@@) % أذلك أم فرد بقفر أجاده % من الغيث أيك فرعه قد تهللا % % 14(@)(@@) % لدى ليلة خوارة المزن ، كلما % % تنفس في أرجائها البرق أسبلا % % 15(@)(@@) % كأن عليها ، من سقيط قطارها ، % جمانا وهت أسلاكه فتفصلا % % 16(@)(@@) % فبات بليل العاشقين مسهدا ، % إلى أن أرى صبحا أغر محجلا % % 17(@)(@@) % فنفض عن سرباله لؤلؤ الندى ، % و آيس ذعرا قلبه ، فتأملا % % 18(@)(@@) % إذا هز قرنيه حسبت أساودا % سمت في معاليه لتحتل مقتلا % % 19(@)(@@) % كأن عروق الدوح من تحته الثرى % % قوى من حبال أعجلت أن تفتلا % % 20(@)(@@) % وداع دعا ، والليل بيني وبينه ، % فكنت مكان الظن منه وأفضلا % % PageV01P768 21(@)(@@) % دعا ماجدا لا يعلم الشح قلبه ، % إذا ما عراه الحق يوما تهللا % % 22(@)(@@) % وأعددت للحرب العوان مهندا ، % و أسمر خطيا ، إذا هز أرفلا % % 23(@)(@@) % و جيشا كركن الطود رحباص طريقه ، % إذا ما علا حزنا من الأرض أسهلا % % 24(@)(@@) % و جروا إلينا الحرب حتى إذا غلت % و فارت رأوا صبرا على الحرب أفضلا % % 25(@)(@@) % و عاذوا عياذا بالفرار ، وقبله % أضاعوا بدار السلم حرزا ومعقلا % % 26(@)(@@) % بني عمنا أيقظتم الشر بيننا ، % فكانت إليكم عدوة الشر أعجلا % % 27(@)(@@) % فصبرا على ما قد جررتم ، % فتحتم لنا بابا من الشر مقفلا % % 28(@)(@@) % و ما كنت أخشى أن تكون سيوفنا % % ترد علينا بأسها وتقتلا % % 29(@)(@@) % ولما أسنوا الضغن تحت صدورهم % % حسمناهث عنا قبل أن يتكهلا % % PageV01P769 البحر : سريع 1(@)(@@) % يا رب غير كل شيء سوى % % رأي أبي العباس ، فاتركه لي % % 2(@)(@@) % قد كان لي ذا مشرع طيب ، % حينا ، فشيب الآن بالحنظل % 3(@)(@@) % عين أصابت وده ، لا رأت % وجه حبيب ، أبدا ، مقبل % 4(@)(@@) % إن كان يرضى لي بذا أحمد ، % فليس يرضى لي بهذا علي % % PageV01P770 البحر : طويل 1(@)(@@) % عذلت بني عمي وطاب بهم عذلي 
ms134	 ، % لعلهم يوما يفيقون من جهل % 2(@)(@@) % معافين إلا من عقول مريضة ، % و كم من صحيح الجسم خلو من العقل % PageV01P771 البحر : بسيط تام 1(@)(@@) % إني أرى فتنة بالشر قد أرقت % كحامل متئم في تاسع الحبل % 2(@)(@@) % فكيف أنتم لها عند اللقاء ترى ، % إياكم وخداع البغي والأمل % PageV01P772 البحر : كامل تام 1(@)(@@) % و لقد غدوت على طمر قارح ، % عقدت حوافره غمامة قسطل % 2(@)(@@) % متلثم لجم الحديد يلوكها ، % لوك الفتاة مساوكا من إسحل % 3(@)(@@) % ومحجل ، غير اليمين ، كأنه % متبختر يمشي بكم مسبل % PageV01P773 البحر : كامل تام 1(@)(@@) % أفدي الذي أهدى إلي مظلة ، % أهدت إلى قلبي المشوق بلابلا % % 2(@)(@@) % فكانما هي زورق من فضة ، % قد أودعوه في اللجين سلاسلا % % PageV01P774 البحر : مديد تام 1(@)(@@) % رب ركب عرسوا ثم هبوا % % نحو إسراج وشد رحال % 2(@)(@@) % و عدونا فوق متن نياق ، % تأخذ الأرض بأيد عجال % 3(@)(@@) % زينتها غرر ضاحكات ، % كبدور في وجوه ليال % PageV01P775 البحر : خفيف تام 1(@)(@@) % من أحب البقاء دام عليه ، % مع طول البقاء هم طويل % 2(@)(@@) % عطل الدهر موضعا من فؤادي ، % ليس فيه بعد ابن يحيى خليل % 3(@)(@@) % أكل الموت زين كل حياة ، % لا هنا الموت شلوه المأكول % PageV01P776 البحر : متقارب تام 1(@)(@@) % أيا ليلتي لست مثل الليالي ، % وطلت ، ولا كالليالي الطوال % 2(@)(@@) % خليلي لا ترتجي نائلا ، % فقد قطع الموت كف النوال % PageV01P777 البحر : بسيط تام 1(@)(@@) % سقيا لمن في الثرى أمست منازله ، % ومن بدار البلى قرت رواحله % 2(@)(@@) % أمسيت خلوا من الأحباب منفردا ، % والسيف يبقى ، ولا تبقى حمائله % PageV01P778 البحر : سريع 1(@)(@@) % قد استوى الناس ، ومات الكمال ، % ونادت الأيام أين الرجال % 2(@)(@@) % هذا أبو القاسم في نعشه ، % قوموا انظروا كيف تسير الجبال % 3(@)(@@) % يا ناصر الملك بآرائه ، % بعدك للملك ليال طوال % PageV01P779 البحر : مجزوء الكامل 1(@)(@@) % إصبر على حسد الحسود ، % فإن صبرك قاتله % % 2(@)(@@) % فالنار تأكل بعضها ، % إن لم تجد ما تأكله % % PageV01P780 البحر : طويل 1(@)(@@) % ترحل من الدنيا بزاد من التقى ، % فعمرك أيام تعد قلائل % 2(@)(@@) % ودع عنك ما تجري به لجج الهوى % % إلى غمرات ليس فيهن عاقل % PageV01P781 البحر : متقارب 
ms135	 تام 1(@)(@@) % دع الناس ! قد طال ما اتعبوك ، % ورد إلى الله وجه الأمل % % 2(@)(@@) % ولا تطلب الرزق من طالبي % % ه ، واطلبه ممن به قد كفل % % PageV01P782 البحر : سريع 1(@)(@@) % يا طالبا مستعجلا رزقه ، % الموت يأتيك على مهل % 2(@)(@@) % أعقل في قولي ، ولكنني % % من بعده أجهل في فعلي % % PageV01P783 البحر : بسيط تام 1(@)(@@) % لا تسألن سوى الأسفار من رجل ، % فالمرء ما دام حيا خادم الأمل % 2(@)(@@) % قالت : عزمت على بين ، فقلت لها : % لي عزمة قد أجاز الله لي عملي % % PageV01P784 البحر : كامل تام 1(@)(@@) % من يشتري حسبي بأمن خمول ، % من يشتري أدبي بحظ جهول % 2(@)(@@) % ساء الزمان وأوجعتك صروفه ، % وعسى الزمان يسر بعد قليل % PageV01P785(@)(@@)(@@)(@@) | البحر : وافر تام 1(@)(@@) % أعاذل ليس سمعي للملام ، % عففت عن الغواني والمدام % 2(@)(@@) % و بنت عن الشباب ، فليس مني ، % و آخر كل شيء لانصرام % 3(@)(@@) % رأيت الدهر ينقص ، كل يوم ، % قوى حبل البقاء ، وكل عام % 4(@)(@@) % يقتل بعضنا بأكف بعض ، % ويشحذ بيننا سيف الحمام % 5(@)(@@) % و حرب قد قرنت الموت فيها ، % بجيش يهمر الهيجا لهام % 6(@)(@@) % وفتيان يجيبون المنايا ، % إذا غضبوا بأنفسهم كرام % 7(@)(@@) % وطرف كالهراوة أعوجي ، % حثيث السير يرقى في اللجام % 8(@)(@@) % وهاجرة يصد العيس فيها % % حرور من لوافح كالضرام % 9(@)(@@) % تقيم على رؤوس الركب شمسا ، % كصول القرن بالذكر الحسام % 10(@)(@@) % قطعت هجيرها بذوات صبر % على أمثالها ، واليوم حامي % % PageV01P786 11(@)(@@) % يصافحن الظلال بكل خرق ، % مصافحة المحيا بالسلام % 12(@)(@@) % رمت أرض بها أرضا فأرضا ، % كنبذ القوم صائبة السهام % 13(@)(@@) % أبيت الضيم بأس يد وصبر ، % إذا التقت المحامي بالمحامي % % 14(@)(@@) % بأن مكان بيتي في المعالي ، % مكان السلك في خرز النظام % 15(@)(@@) % أباعد بين مني والعطايا ، % وأجمع بين برقي وانسجامي % % 16(@)(@@) % وساس الملك منا كل خرق ، % كمثل البدر أشرق في الظلام % 17(@)(@@) % تهد الأرض غدوته بجمع % كلج البحر يرجح بالأنام % PageV01P787 البحر : طويل 1(@)(@@) % لنا عزمة صماء لا تسمع الرقى ، % تبيت قلوب العاذلين على رغم % 2(@)(@@) % و غنا لنعطي الحق من غير حاكم % علينا ، ولو شئنا كتمنا على ظلم % PageV01P788 البحر : وافر تام 1 
ms136	(@)(@@) % و بكر ، قلت موتي قبل بعل ، % وإن أثرى وعد من الصميم % 2(@)(@@) % أأمزج باللئام دمي ولحمي ، % فما عذري على النسب الكريم % % PageV01P789 البحر : خفيف تام 1(@)(@@) % طال ليلي ، وساورتني الهموم ، % وكأني لكل نجم غريم % 2(@)(@@) % ساهرا هاجرا لنومي حتى % % لاح تحت الظلام فجر سقيم % 3(@)(@@) % دام كر النهار والليل محثو % % ثين ، ذا منبه ، وهذا منيم % 4(@)(@@) % ورحى تحتنا ، وأخرى علينا ، % كل مرء فيها طحين هشيم % 5(@)(@@) % و سرور ، وكربة ، وافتقار ، % وبريق كزخرف لا يدوم % 6(@)(@@) % و معافى ، وذو سقام ، وحي ، % و حبيس تحت التراب مقيم % 7(@)(@@) % وغوي عاص ، وبر تقي ، % و استبان المحمود والمذموم % 8(@)(@@) % و بخيل ، وذو سخاء ، ولولا % % بخل هذا ما قيل هذا كريم % 9(@)(@@) % و نرى صنعة تخبر عن خا % % لقنا أنه لطيف حكيم % 10(@)(@@) % كيف نومي ، وقد حللت ببغدا % % د ، مقيما في أرضها لا أريم % PageV01P790 11(@)(@@) % ببلاد فيها الركايا عليه % ن أكاليل من بعوض يحوم % 12(@)(@@) % ويح دار الملك التي تنفح المس % % ك ، إذا ما جرى عليها النسيم % 13(@)(@@) % وكأن الربيع فيها ، إذا ن % ور ، وشي ، أو جوهر منظوم % 14(@)(@@) % كيف قد أقفرت ، وحار بها الده % % ر ، وغنى الجنان فيها البوم % 15(@)(@@) % فهي هاتيك أصبحت تتناجى ، % بالتشكي خرابها المهدوم % 16(@)(@@) % طرفاها بر وبحر ، ويجنى ال % % ورد فيها والشيح والقيصوم % 17(@)(@@) % نحن كنا سكانها ، فانقضى ذا % % ك ، وبنا ، وأي شيء يدوم % 18(@)(@@) % رب خوف خرجت منه فزال ال % % بأس مني وأقحم الترخيم % 19(@)(@@) % وجه الصنع لي ، وجلى لي الكر % ب إله ، رب ، لطيف ، رحيم % 20(@)(@@) % أنا من تعلمون أسهر للمج % % د ، إذا غط في الفراش اللئيم % PageV01P791 21(@)(@@) % و ملي بصمتة الحلم إن طا % % رت سريعا مثل الفراش الحلوم % 22(@)(@@) % يا بني عمنا إلى كم وحتى ، % ليس ما تطلبونه يستقيم % 23(@)(@@) % أبدا فارغين إن تطعموا المل % ك ، كما ذيد عن رضاع فطيم % 24(@)(@@) % أأبو طالب كمثل أبي الفض % % ل ، أما منكم بهذا عليم % 25(@)(@@) % شائلوا مالكا ورضوان عن ذا ، % أين هذا ، وأين هذا مقيم % 26(@)(@@) % وعلي ، فكابنه ، غير شك 
ms137	 ، % واجب حقه علينا عظيم % 27(@)(@@) % فدعوا الملك نحن بالملك أولى ، % قد أقرت لنا بذاك الخصوم % 28(@)(@@) % واحذروا ماء غابة لم يزل طا % % ئر حرص عليه منكم يحوم % 29(@)(@@) % إن فيها أسدا ضراغم أشبا % % ل رعيل لم ينج منها كليم % 30(@)(@@) % وعزيز علي أن يصبغ الأر % % ض دم منكم علي كريم % PageV01P792 31(@)(@@) % غير أنا من قد علمتم ، ولا يص % % لح من زعمكم علينا زعيم % 32(@)(@@) % لو تهيا هذا ، ولا يتهيا ، % لتهاوت من السماء النجوم % PageV01P793 البحر : طويل 1(@)(@@) % دعوا آل عباس وحق أبيهم ، % وإياكم منهم ، فإنهم هم % 2(@)(@@) % ملوك ، إذا خاضوا الوغى ، فسيوفهم % % مقابضها مسك ، وسائرها دم % PageV01P794 البحر : مجزوء المديد 1(@)(@@) % خان عهدي ، وظلم ، % جائر فيما حكم % 2(@)(@@) % أصدق الناس : بلا ؛ % أكذب الناس : نعم % 3(@)(@@) % قل لمن يحلف لي % % صادقا ، فيما زعم % 4(@)(@@) % إنه يعشقني % % عاشق لي ولكم % 5(@)(@@) % خل قلبي هكذا ، % لا تزد قلبي هم % PageV01P795 البحر : طويل 1(@)(@@) % ألا تسألون الله برء متيم ، % تمكن منه السقم في اللحم والدم % 2(@)(@@) % و ردوا دموع الشوق بين جفونه ، % يفق ، أو فردوا لحمه فوق أعظم % 3(@)(@@) % و قد قيدوا غير الفقيه بأمره ، % و من يلق ما لاقى من الناس يعلم % PageV01P796 البحر : طويل 1(@)(@@) % وقالوا : تصبر : قلت : كيف ، وإنما % % أريد الهوى حتى ألذ ، وأنعما % % 2(@)(@@) % ويأخد لحظ العين ممن أحبه % شفاء ، وألقى زائرا ومسلما % % 3(@)(@@) % ولو كنت ممن يتقي الناس في الهوى % % لكان تقى ربي أعف وأكرما % % PageV01P797 البحر : رجز تام 1(@)(@@) % يا من رمتني عينه بسهم % أصاب جسمي فتداعى جسمي % % 2(@)(@@) % هل لك في مغفرة عن جرم ، % وقبلة تريحني عن همي % % PageV01P798 البحر : متقارب تام 1(@)(@@) % أقول ، وقد طال ليل الهموم ، % و قاسيت حزن فؤاد سقيم % 2(@)(@@) % عسى الشمس قد مسخت كوكبا % وقد طلعت في عداد النجوم % PageV01P799 البحر : بسيط تام 1(@)(@@) % لحظ المحب على الأسرار متهم ، % إذا استشفوا الهوى من نحوه علموا % % 2(@)(@@) % من كان يكتم في القلب من حرق ، % ففي دموعي حديث ليس ينكتم % PageV01P800 البحر : كامل تام 1(@)(@@) % يا لائمي قد لمت غير مليم ، % كم 
ms138	 جاهل مغرى بلوم حكيم % 2(@)(@@) % ضنت شرير بوصلها ، ولطالما % % لعبت مواعدها بكل غريم % PageV01P801 البحر : مجزوء الرجز 1(@)(@@) % البرق في مبتسمه ، % و الخمر في ملتثمه % 2(@)(@@) % ووجهه في شعره % % كقمر في ظلمه % % 3(@)(@@) % نام رقيبي سكرا ، % يحرسني في حلمه % % 4(@)(@@) % وبات من أهوى معي ، % يذيقني ريق فمه % % PageV01P802 البحر : منسرح 1(@)(@@) % يا خالي القلب عن جوى كبدي ، % و طول وجدي يغري بي السقما % % 2(@)(@@) % أغراك مني الهوى ، فكيف ترى ، % و الجمر يعدي بلونه الفحما % % PageV01P803 البحر : طويل 1(@)(@@) % ألا حبذا الناعي ، وأهلا ومرحبا ، % كأنك قد بشرتني بغلام % 2(@)(@@) % و كم دولة للجور ، من قبل هذه ، % مضت ، وانقضت عنا بغير سلام % 3(@)(@@) % و هل يحمل الضيم الفتى ، وهو آخذ % بقائم سيف ، أو عنان لجام % PageV01P804 البحر : طويل 1(@)(@@) % قضى وطرا من لذة ونعيم ، % و ساق ، وجلاس ، وماء كروم % 2(@)(@@) % و مصطبح للراح لما أدارها ، % قرنت يدي من كاسها بنديم % 3(@)(@@) % فقلت له : لست الذي كنت مرة % سوى رجل باقي السماح كريم % 4(@)(@@) % سلام على اللذات واللهو والصبا ، % سلام وداع لا سلام قدوم % 5(@)(@@) % هنتك ، أمير المؤمنين ، سلامة ، % برغم عدو في الحديد كظيم % 6(@)(@@) % وثبت إليه وثبة أسدية ، % طوت خبرا ، واستأثرت بعلوم % 7(@)(@@) % و ما راعه إلا أسنة عسكر % كظلمة ليل نقبت بنجوم % 8(@)(@@) % كأن سليمان النبي أطاره % بحنانة تنضو الرياح عقيم % 9(@)(@@) % ويمناك مفتاح الفتوح وما حنت % على قلم إلا لكشف هموم % PageV01P805 البحر : طويل 1(@)(@@) % أبا حسن أنت ابن مهدي فارس ، % فرفقا بنا لست ابن مهدي هاشم % 2(@)(@@) % وأنت أخي في يوم كأس ولذة ، % و لست أخي في النائبات العظائم % PageV01P806 البحر : متقارب تام 1(@)(@@) % أمن فقد جود الحسان الملاح % سقطت مكبا على خيثمه % % 2(@)(@@) % وظلت تسابق رحل الحدا % % ة ، حرصا ، وما هي بالمطعمه % 3(@)(@@) % إذا ما أذعت لها درهما ، % وجدت عزيزته محكم % 4(@)(@@) % إذا رزقت درهما زائفا % يظل عليه لها زمزمه % % 5(@)(@@) % و لو ملكت كفها سمسما ، % لما ضيعت كفها سمسمه % 6(@)(@@) % لها منزل ساذج ليس فيه % سواها ، ومقنعة معلمه % 7(@)(@@) % كأنك إن جئتها سائلا 
ms139	 ، % تقطر في عينها حصرمه % 8(@)(@@) % يطيعك تمريض ألحاظها ، % وتحت سؤال لها حمحمه % % 9(@)(@@) % ترى بين أسنانها للعشا ، % إذا فتحت فمها ، قرطمه % PageV01P807 البحر : رمل تام 1(@)(@@) % يا بخيلا ليس يدري ما الكرم ، % حرم اللؤم على فيه نعم % 2(@)(@@) % حدثوني عنه في العيد بما % % سرني من يقظة فيما حكم % 3(@)(@@) % واستخار الله في عزمته ، % ثم ضحى بقفاه واحتجم % PageV01P808 البحر : طويل 1(@)(@@) % ودبسية بالإسم لكن صوتها % % كصوت حمار قطع النهق مفحما % % 2(@)(@@) % يلامس منها الكف عيدان مصخب % كنباش ناووس يقلب أعظما % % 3(@)(@@) % وعابدة لكن تصلي على القفا ، % وتدعوا برجليها ، إذا الليل أظلما % % PageV01P809 البحر : مجزوء الخفيف 1(@)(@@) % يا خليلي هبا ، % واسقياني المداما % % 2(@)(@@) % إذ تروم الثريا % % في الغروب مراما % % 3(@)(@@) % كاسيات طمر % كاد يلقي اللجاما % % PageV01P810 البحر : مجزوء الكامل 1(@)(@@) % مولاي أجود من حكم % صبرا عليه ، وإن ظلم % 2(@)(@@) % لعب القلى بوعوده ، % فكأنما كانت حطم % 3(@)(@@) % و مصرعين من الخما % % ر على السواعد واللمم % 4(@)(@@) % قتلتهم خمارة % عمدا ، ولم تؤخذ بدم % 5(@)(@@) % و سقتهم مشمولة % ظلت تحدث عن إرم % 6(@)(@@) % لما أرتهم كأسها ، % شربوا ، وما قالوا بكم % % PageV01P811 البحر : مجزوء الرجز 1(@)(@@) % يا جائرا في حكمه ، % وساخطا في جرمه % 2(@)(@@) % و عاملا بظنه ، % و جاهلا بعلمه % 3(@)(@@) % و قاتلا لعبده ، % ومسرفا في ظلمه % 4(@)(@@) % ماذا ترى في مدنف ، % يشكوك طول سقمه % 5(@)(@@) % أضنيته ، فلم يطق % من ضعفه حمل اسمه % 6(@)(@@) % و لا تراه عائدا ، % إلا بعين وهمه % 7(@)(@@) % و رب عين في الهوى % % ساهر عين نجمه % 8(@)(@@) % بدر تمشى مرحا ، % ملتويا بكمه % 9(@)(@@) % سقيا لعمي منزلا ، % أظلاله من كرمه % 10(@)(@@) % كم فيه من يوم مضى ، % بحمده ، ولا ذمه % PageV01P812 11(@)(@@) % يدير كأسا برقا ، % لحظته كسهمه % 12(@)(@@) % مشمولة كريقه ، % في طعمها وطعمه % 13(@)(@@) % كم من حليم خامرت ، % فذهبت بحلمه % 14(@)(@@) % و رفعت همته ، % و بطشت بهمه % 15(@)(@@) % ألطف في روح الفتى ، % من روحه في جسمه % PageV01P813 البحر : مجزوء الكامل 1(@)(@@) % يا رب يوم قد مضى % % بالقادسية لو يدوم % 2(@)(@@) % في ظل كرم لا يطو % % ف به الهجير ولا السمومث 
ms140	 % % 3(@)(@@) % و سماؤه الورق الجدي % % د ، وأرضه الورق الهشيم % 4(@)(@@) % ويحثني بالكأس سا % % ق لحظ مقلته سقيم % 5(@)(@@) % أغرى بقبلته كما % % يغرى بمرضعة يتيم % 6(@)(@@) % يا من يلوم على الهوى ، % دعني ، فذا داء قديم % PageV01P814 البحر : بسيط تام 1(@)(@@) % الآن سرت فؤادي مقلة الريم ، % واهتز كالغصن في ميل وتقويم % 2(@)(@@) % الآن ناجى بوحي الحب عاشقه ، % واستعجل اللحظ في ود وتسليم % 3(@)(@@) % قد بت ألثمه ، والليل حارسنا ، % حتى بدا الصبح مبيض المقاديم % 4(@)(@@) % و قام ناعي الدجى فوق الجدار كما % % نادى على مرقب شاد بتحكيم % 5(@)(@@) % و البدر يأخذه غيم ويتركه ، % كأنه سافر عن وجه ملطوم % 6(@)(@@) % فظن ما شئت ما حاجات ذي طرب % مقضية ، وسؤال غير محروم % 7(@)(@@) % يا ليلة الوصل ليت الصبح يهجرها ، % ياليلة الوصل دومي ، هكذا دومي % % 8(@)(@@) % باتت أباريقنا حمرا عصائبها ، % حيث السقاة بتكبير تعظيم % 9(@)(@@) % فلم نزل ليلنا نسقى مشعشعة ، % كأنما الماء يغريها بتصريم % 10(@)(@@) % كأن في كأسها ، والماء يفرعها ، % أكارع النمل ، أو نقش الخواتيم % PageV01P815 11(@)(@@) % لا صاحبتني يد لم تغن ألف يد ، % ولم ترد القنا حمر الخياشيم % 12(@)(@@) % بادر بجودك ، بادر قبل عائقة ، % فإن وعد الفتى عندي من اللوم % PageV01P816 البحر : مجزوء الرمل 1(@)(@@) % قد نعى الديك الظلاما ، % فاسقني الراح المداما % % 2(@)(@@) % قهوة بنت دنان ، % عتقت خمسين عاما % % 3(@)(@@) % خلتها في البيت جندا ، % صفقوا حولي قياما % % PageV01P817 البحر : مديد تام 1(@)(@@) % لم ينم همي ، ولم أنم ، % نهب كف الوجد والسقم % 2(@)(@@) % في سبيل العاشقين هوى ، % لم انل منه سوى التهم % 3(@)(@@) % ولقد أغدو على أثر ، % للحيا راض عن الديم % 4(@)(@@) % حين دب الفجر منبلجا ، % كدبيب النار في الفحم % 5(@)(@@) % وغصون الروض يرقصها % % نشر ريح ظله الوهم % 6(@)(@@) % فاسقني للراح صافية ، % تنشر الإصباح في الظلم % 7(@)(@@) % فإذا ما الماء خالطها ، % راض منها سهلة الشيم % 8(@)(@@) % ونفى مكروه سورتها ، % ثم هداها إلى الكرم % 9(@)(@@) % واكتسب من شكله حببا % بين منثور ومنتظم % 10(@)(@@) % رحلها كف تسير به % من فم الأبريق نحو فمي % % PageV01P818 11(@)(@@) % وكساها قشر لؤلؤة ، % ليس فيها سر مكتتم % 12 