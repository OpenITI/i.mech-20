ms468	 روز %~% ناکام و کام از پس ایشان همی چمی(@)(@@) 25 آگاه نیستی که چگونه کجا شدند %~% بگذشت بر تو چرخ و زمانه به مبهمی(@)(@@) 26 هر کس رهی دگرت نمودند نو به نو %~% از یکدیگر بتر به سیاهی و مظلمی(@)(@@) 27 این گفت «اگر به خانه مکه درون شوی %~% ایمن شوی از آتش اگر چند مجرمی»(@)(@@) 28 وان گفت که «ت‌ز قول شهادت عفو کنند %~% گر تو گناه‌کارترین خلق عالمی»(@)(@@) 29 رفتن به سوی خانه مکه است آرزوت %~% ز اندیشه دراز نشسته به ماتمی(@)(@@) 30 وز بیم تشنگی قیامت به روز و شب %~% در آرزوی قطرگکی آب زمزمی(@)(@@) 31 گر راست گفتت آنکه تورا این امید کرد %~% درویش تشنه ماند و تو رستی که منعمی(@)(@@) 32 فردات امید سندس و حور و ستبرق است %~% و امروز خود به زیر حریری و ملحمی(@)(@@) 33 رستن به مال نیست به علم است و کارکرد %~% خیره محال و بیهده تا چند بر خمی(@)(@@) 34 چون روی ناوری به سوی آسمان دین %~% که‌ت گفت آن دروغ و که کرد آن منجمی(@)(@@) 35 آن روز هیچ حکم نباشد مگر به عدل %~% ایزد سدوم را نسپرده است حاکمی(@)(@@) 36 گمراه گشته‌ای ز پس رهبران کور %~% گم نیست راه راست ولیکن تو خود گمی(@)(@@) 37 هرچند جو به سوی خران به ز گندم است %~% گندم ز جو به است سوی ما به گندمی(@)(@@) 38 بد را ز نیک باز ندانی همی ازانک %~% جستی به جهل خویش ز جاهل معلمی(@)(@@) 39 دست خدای گیر و از این ژرف چه بر آی %~% گر با هزار جور و جفا و مظالمی(@)(@@) 40 داند به عقل مردم دانا که بر زمین %~% دست خدای هر دو جهان است فاطمی(@)(@@) 41 ای دردمند دور مشو خیره از طبیب %~% زیرا نشسته بر در عیسی مریمی(@)(@@) 42 ایمن برو به راه ز کس بدرقه مجوی %~% هرچند بد دلی که تو همراه رستمی(@)(@@) 43 ای حجت 
ms469	 زمین خراسان به شعر زهد %~% جز طبع عنصریت نشاید به خادمی(@)(@@) 44 گر سوی اهل جهل به دین متهم شوی %~% سوی خدای به ز براهیم ادهمی(@)(@@) 45 گر جز که دین توست و رسول تو در دلم %~% ای کردگار حق به سرم تو عالمی PageV1P247(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 گرت باید که تن خویش به زندان ندهی %~% آن به آید که دل خویش به شیطان ندهی(@)(@@) 2 دیو مهمان دل توست نگر تا به گزاف %~% این گزین خانه بدان بیهده مهمان ندهی(@)(@@) 3 آرزو را و حسد را مده اندر دل جا %~% گر همی خواهی تا خانه به ماران ندهی(@)(@@) 4 گر تو مر آز و حسد را بسپاری دل خویش %~% ندهند آنچه تو خواهی به تو تا جان ندهی(@)(@@) 5 آز بر جانت نگهبان بلا گشت بکوش %~% تا مگر جانت بدین زشت نگهبان ندهی(@)(@@) 6 گر نبرده است تو را دیو فریبنده ز راه %~% چونکه از طاعت و دانش حق یزدان ندهی(@)(@@) 7 شاه را پیش جز از بخته پخته ننهی %~% مؤمنی را که ضعیف است یکی نان ندهی(@)(@@) 8 آشکارا دهی آن اندک و بی‌مایه زکات %~% رشوت حاکم جز در شب و پنهان ندهی(@)(@@) 9 هرچه کان را ببری تو همی از حق خدای %~% بی‌گمان جز که به سلطان و تاوان ندهی(@)(@@) 10 از غم مزد سر ماه که آن یک درم است %~% کودک خویش به استاد و دبستان ندهی(@)(@@) 11 هرچه کان را به دل خوش ندهی از پی مزد %~% آن به کار بزه جز کز بن دندان ندهی(@)(@@) 12 گر تو را دیو سلیمان ز سلیمان نفریفت %~% چون همی حق سلیمان به سلیمان ندهی(@)(@@) 13 پرفضول است سرت هیچ نخواهی شب و روز %~% که نو این را بستانی و کهن آن ندهی(@)(@@) 14 پیشه‌ای سخت نکوهیده گزیدی چه بود %~% کز فلان زر نستانی و به بهمان ندهی(@)(@@) 15 دل درویش مسوز و مستان زو و مده %~% گرت باید 
ms470	 که تنت به آتش سوزان ندهی(@)(@@) 16 چه بود نیک بیندیش به تدبیر خرد %~% که ز حامد نستانی و به حمدان ندهی(@)(@@) 17 جان پرمایه همی چون بفروشی بنچیز %~% چیز پرمایه همان به که به ارزان ندهی(@)(@@) 18 دیو بی‌فرمان بنشیند بر گردن تو %~% چو تو گردن به خداونده فرمان ندهی(@)(@@) 19 شاخ زنبور به انگور تو افگنده‌ستی %~% چو نیت کردی کانگور به دهقان ندهی(@)(@@) 20 نیت نیک رساند به تو نیکی و صلاح %~% دل هشیار نگر خیره به مستان ندهی(@)(@@) 21 نخوری از رز و ز ضعیت و ز کشت و درود %~% بر تابستان تاش آب زمستان ندهی(@)(@@) 22 چه طمع داری در حله صد رنگ بهشت %~% چون به درویش یکی پاره خلقان ندهی(@)(@@) 23 مر مؤذن را جو نانی دشوار دهی %~% مر فسوسی را دینار جز آسان ندهی(@)(@@) 24 از تو درویشان کرباس نیابند و گلیم %~% مطربان را جز دیبای سپاهان ندهی(@)(@@) 25 وام خواهی و نخواهی مگر افزونی و چرب %~% باز اگر باز دهی جز که به نقصان ندهی(@)(@@) 26 وز پی داوری و درد سر و جنگ و جلب %~% جز همه عاریتی چیز گروگان ندهی(@)(@@) 27 دعوی دوستی یاران داری همه روز %~% چونکه دانگی به کسی از پی ایشان ندهی(@)(@@) 28 ای فضولی تو چه دانی که که بودند ایشان %~% چون تو دل در طلب طاعت و ایمان ندهی(@)(@@) 29 از تنت چون ندهی حق شریعت به نماز %~% وز زبان چونکه به خواندن حق فرقان ندهی(@)(@@) 30 تو که نادانی شاید که فسار خر خویش %~% به یکی دیگر بیچاره و نادان ندهی(@)(@@) 31 گرگ بسیار فتاده است در این صعب رمه %~% آن به آید که خر خویش به گرگان ندهی(@)(@@) 32 سخن حجت بپذیر و نگر تا به گزاف %~% سخنش را به ستوران خراسان ندهی(@)(@@) 33 خر نداند خطر سنبل و ریحان زنهار %~% که مراین خر رمه را سنبل و ریحان ندهی(@)(@@) 34 همه افسار بدادند 
ms471	 به نعمان تو بکوش %~% بخرد تا مگر افسار به نعمان ندهی PageV1P248(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 چه چیز بهتر و نیکوتر است در دنیی %~% سپاه نی ملکی نی ضیاع نی رمه نی(@)(@@) 2 سخن شریف‌تر و بهتر است سوی حکیم %~% ز هرچه هست در این ره گذار بی‌معنی(@)(@@) 3 بدین سخن شده‌ای تو رئیس جانوران %~% بدین فتادند ایشان به زیر بیع و شری(@)(@@) 4 سخن که بانگ توست او جدا نگر به چه شد %~% ز بانگ آن دگران جز به حرف‌های هجی(@)(@@) 5 نگاه کن که بدین حرف‌ها چگونه خبر %~% به جان زید رساند زبان عمرو همی(@)(@@) 6 وز این حدیث خبر نیست سوی جانوران %~% خرد گوای من است اندر این قوی دعوی(@)(@@) 7 سخن زجمله حیوان به ما رسید چنانک %~% ز ما به جمله به جان نبی رسید نبی(@)(@@) 8 سخن نهان ز ستوران به ما رسید چو وحی %~% نهان رسید ز ما زی نبی به کوه حری(@)(@@) 9 دو وحی خوب نمودم ضمیر بینا را %~% ببین تو گر چه نبیندش خاطر اعمی(@)(@@) 10 ستور و مردم و پیغمبر این سه مرتبت است %~% بدین دو وحی جدا مانده هر یک از دگری(@)(@@) 11 اگر گزیده به وحی است زی خدای رسول %~% تو گزیده و حیوان به جملگی پژوی(@)(@@) 12 به دل ببین که نه دیدن همه به چشم بود %~% به دست بیند قصاب لاغر از فربی(@)(@@) 13 به لوح محفوظ‌اندر نگر که پیش تست %~% درو همی نگرد جبرئیل و بویحیی(@)(@@) 14 به پیش توست ولیکن خط فریشتگان %~% همی ندانی خواندن گزافه بی‌املی(@)(@@) 15 مگر که یاد نداری که چشم تو نشناخت %~% به خط خویش الف را مگر بجهد از بی(@)(@@) 16 خط فریشتگان را همی بخواهی خواند %~% چنین به بی‌ادبی کردن و لجاج و مری(@)(@@) 17 به چشم قول خدای از جهان او بشنو %~% که نه سخن نشنوده است کس مگر به ندی(@)(@@) 18 به راه چشم شنو قول این جهان 
ms472	 که حکیم %~% به راه چشم شنوده است گفته دنیی(@)(@@) 19 به راه چشم شنود از درخت قول خدای %~% که «من خدای جهانم» به طور بر موسی(@)(@@) 20 سخن نگوید جز با زبان و کام شکر %~% نگفت نیز مگر با کفت سخن حنی(@)(@@) 21 به نزد شکر رازی است کز جهان آن را %~% شکر همی نکند جز به سوی کام انهی(@)(@@) 22 روا بود که نیابد ز خلق راز خدای %~% مگر که سوی یکی بهتر از همه مجری(@)(@@) 23 شنود قول الهی و کار کرد بران %~% جهان به جمله ز چرخ بروج تا به ثری(@)(@@) 24 ندارد این زمی و آب هیچ کار جز آنک %~% به جهد روح‌نما را همی دهند اجری(@)(@@) 25 زحل همی چکند آنچه هست کار زحل %~% سهی همی چکند آنچه هست کار سهی(@)(@@) 26 همیت گوید هریک که کار خویش بکن %~% اگرت چشم درست است درنگر باری(@)(@@) 27 خدای ما سوی ما نامه‌ای نوشت شگفت %~% نوشته‌هاش موالید و آسمانش سحی(@)(@@) 28 شریفتر سخنی مردم است کاین نامه %~% ز بهر این سخنان کرد کردگار انشی(@)(@@) 29 سخن که دید سخن گوی و عالم و زنده %~% چنین سزد سخن کردگار خلق بلی(@)(@@) 30 رسول خود سخنی باشد از خدای به خلق %~% چنانکه گفت خداوند خلق در عیسی(@)(@@) 31 تو را سخن نه بدان داده‌اند تا تو زبان %~% برافگنی به خرافات خندناک جحی(@)(@@) 32 سخن به منزلت مرکب است جان تو را %~% برو توانی رفتن به سوی شهر هدی(@)(@@) 33 در هدی بگشاید مگر کلید سخن %~% همو گشاید درهای آفت و بلوی(@)(@@) 34 گهی سخن حسک و زهر و خنجر است و سنان %~% گهی سخن شکر و قند و مرهم است و طلی(@)(@@) 35 زبان به کام در افعی است مرد نادان را %~% حذرت باید کردن همی از آن افعی(@)(@@) 36 سخن سپارد بی‌هوش را به بند و بلا %~% سخن رساند هشیار را به عهد و لوی(@)(@@) 37 مباش بر 
ms473	 سخن خویش فتنه چون طوطی %~% سخن نخست بیاموز و پس بده فتوی(@)(@@) 38 به اسپ و جامه نیکو چرا شدی مشغول %~% سخنت نیکو باید نه طیلسان و ردی(@)(@@) 39 سخن مجوی فزون زانکه حق توست از من %~% که آن ربی بود و نیست‌مان حلال ربی(@)(@@) 40 روا بود که ز بهر سخن به مصر شوی %~% وگر همه به مثل جان و دل همی به کری(@)(@@) 41 که کیمیای سعادت در این جهان سخن است %~% بزرجمهر چنین گفته بود با کسری(@)(@@) 42 دریغ‌دار ز نادان سخن که نیست صواب %~% به پیش خوگ نهادن نه من و نه سلوی(@)(@@) 43 زنا بود که سخن را به اهل جهل دهی %~% زنا مکن که نه خوب است زی خدای زنی(@)(@@) 44 سخن ز دانا بشنو زبون خویش مباش %~% مگیر خیره چو مجنون سخنت را لیلی(@)(@@) 45 رها شد از شکم ماهی و شب و دریا %~% به یک سخن چو شنودیم یونس بن متی(@)(@@) 46 اگر نخواهی تا خیره و خجل مانی %~% مگوی خیره سخن جز که براساس و بنی(@)(@@) 47 برادرند به یک‌جا دروغ و رسوائی %~% جدا ندید مرین را ازان هگرز کسی(@)(@@) 48 دروغ سوی هنرپیشگان روا نشود %~% وگرچه روی و ریا را همی کند آری(@)(@@) 49 دروغ‌گوی به آخر نکال و شهره شود %~% چنانکه سوی خردمند شهره شد مانی(@)(@@) 50 بگیر هدیه ز حجت به وصف‌های سخن %~% بر از معانی شعری به روشنی شعری PageV1P249(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 شبی تاری چو بی‌ساحل دمان پر قیر دریائی %~% فلک چون پر ز نسرین برگ نیل اندوده صحرائی(@)(@@) 2 نشیب و توده و بالا همه خاموش و بی‌جنبش %~% چو قومی هر یکی مدهوش و درمانده به سودائی(@)(@@) 3 زمانه رخ به قطران شسته وز رفتن برآسوده %~% که گفتی نافریده ستش خدای فرد فردائی(@)(@@) 4 نه از هامون سودائی تحیر هیچ کمتر شد %~% نه نیز از صبح صفرائی بجنبید ایچ صفرائی(@)(@@) 5 نه نور از چشم‌ها یارست 
ms474	 رفتن سوی صورت‌ها %~% نه سوی هیچ گوشی نیز ره دانست آوائی(@)(@@) 6 بدل کرده جهان سفله هستی را به ناهستی %~% فرو مانده بدین کار اندرون گردون چو شیدائی(@)(@@) 7 برآسوده ز جنبش‌ها و قال و قیل دهر ایدون %~% که گفتی نیست در عالم نه جنبائی نه گویائی(@)(@@) 8 ندید از صعب تاریکی و تنگی زیر این خیمه %~% نه چشم باز من شخصی نه جان خفته رؤیائی(@)(@@) 9 مرا چون چشم دل زی خلق چشم سر به سوی شب %~% چو اندر لشکری خفته یکی بیدار تنهائی(@)(@@) 10 کواکب را همی دیدم به چشم سر چو بیداران %~% به چشم دل نمی‌بینم یکی بیدار دانائی(@)(@@) 11 ندیدم تا ندیدم دوش چرخ پر کواکب را %~% به چشم سر در این عالم یکی پر حور خضرائی(@)(@@) 12 اگر سرا به ضرا در ندیده‌ستی بشو بنگر %~% ستاره زیر ابر اندر چو سرا زیر ضرائی(@)(@@) 13 چو خوشه نسترن پروین درفشنده به سبزه بر %~% به زر و گوهران آراسته خود را چو دارائی(@)(@@) 14 نهاده چشم سرخ خویش را عیوق زی مغرب %~% چو از کینه معادی چشم بنهد زی معادائی(@)(@@) 15 چو در تاریک چه یوسف منور مشتری در شب %~% درو زهره بمانده زرد و حیران چون زلیخائی(@)(@@) 16 کنیسه مریمستی چرخ گفتی پر ز گوهرها %~% نجوم ایدون چو رهبانان و دبران چون چلیبائی(@)(@@) 17 مرا بیدار مانده چشم و گوش و دل که چون یابم %~% به چشم از صبح برقی یا به گوش از وحش هرائی(@)(@@) 18 که نفس ار چه نداند عقل پر دانش همی داند %~% که در عالم نباشد بی‌نهایت هیچ مبدائی(@)(@@) 19 چو زاغ شب به جابلسا رسید از حد جابلقا %~% برآمد صبح رخشنده چو از یاقوت عنقائی(@)(@@) 20 گریزان شد شب تیره ز خیل صبح رخشنده %~% چنان چون باطل از حقی و ناپیدا ز پیدائی(@)(@@) 21 خجل گشتند انجم پاک چون پوشیده رویانی %~% که مادرشان بیند روی بگشاده مفاجائی(@)(@@) 22 همه همواره 
ms475	 در خورشید پیوستند و ناچاره %~% به کل خویش پیوندد سرانجامی هر اجزائی(@)(@@) 23 چنین تا کی کنی حجت تو این وصف نجوم و شب %~% سخن را اندر این معنی فگندی در درازائی(@)(@@) 24 ز بالای خرد بنگر یکی در کار این عالم %~% ازیرا از خرد برتر نیابی هیچ بالائی(@)(@@) 25 یکی دریاست این عالم پر از لولوی گوینده %~% اگر پر لولوی گویا کسی دیده است دریائی(@)(@@) 26 زمانه است آب این دریا و این اشخاص کشتی‌ها %~% ندید این آب و کشتی را مگر هشیار بینائی(@)(@@) 27 ز بهر بیشی و کمی به خلق اندر پدید آمد %~% که ناپیدا بخواهد شد بر این سان صعب غوغائی(@)(@@) 28 فلان از بهر بهمان تا مرو را صید چون گیرد %~% ازو پوشیده هر ساعت همی سازد معمائی(@)(@@) 29 همی بینی به چشم دل به دلها در ز بهر آن %~% که بستاند قبای ژنده یا فرسوده یکتائی(@)(@@) 30 محسن را دگر مکری و حسان را دگر کیدی %~% و جعفر را دگر روئی و صالح را دگر رائی(@)(@@) 31 رئیسان و سران دین و دنیا را یکی بنگر %~% که تا بینی مگر گرگی همی یا باد پیمائی(@)(@@) 32 به چشم سر نگه کن پس به دل بیندیش تا یابی %~% یکی با شرم پیری یا یکی مستور برنائی(@)(@@) 33 کجا باشد محل آزادگان را در چنین وقتی %~% که بر هر گاهی و تختی شه و میر است مولائی(@)(@@) 34 مدارا کن مده گردن خسیسان را چو آزادان %~% که از تنگی کشیدن به بسی کردن مدارائی(@)(@@) 35 اگر دانی که نا مردم نداند قیمت مردم %~% مبر مر خویشتن را خیره زی مردم همانائی(@)(@@) 36 نبینی بر گه شاهی مگر غدار و بی‌باکی %~% نیابی بر سر منبر مگر رزاق و کانائی(@)(@@) 37 یجوز و لایجوز ستش همه فقه از جهان لیکن %~% سر استر ز مال وقف گشته‌ستش چو جوزائی(@)(@@) 38 تهی تر دانش از دانش ازان کز مغز ترب 
