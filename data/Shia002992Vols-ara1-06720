ms6710	(@)(@@) الكافي: ج 3، ك 1، ب 14، ح 6، و ج 5، ك 2، ب 151، ح 3، و ج 7، ك 6، ب 19، ح 17. والتهذيب: ج 6، ح 801، و ج 7، ح 908، و ج 8، ح 416.(@)(@@) وروى عنه محمد بن الحسين بن أبي الخطاب.(@)(@@) التهذيب: ج 6، ح 842.(@)(@@) وروى عنه محمد بن علي.(@)(@@) الكافي: ج 5، ك 2، ب 54، ح 16.(@)(@@) وروى عنه موسى.(@)(@@) التهذيب: ج 5، ح 1027.(@)(@@) وروى عنه موسى بن القاسم.(@)(@@) التهذيب: ج 5، ح 1323.(@)(@@) * وروى عن هارون بن حمزة الغنوي، وروى عنه محمد بن أبي يونس.(@)(@@) التهذيب: ج 7، ح 382.(@)(@@) وروى عنه محمد بن الحسين.(@)(@@) الكافي: ج 3، ك 4، ب 83، ح 4، و ج 7، ك 6، ب 8، ح 2. والتهذيب: ج 3، ح 378 (الاستبصار: ج 1، ح 1763)، و ج 6، ح 519، و ج 7، ح 351، و 728.(@)(@@) * وروى عن هارون بن خارجة، وروى عنه علي بن عبيد الله.(@)(@@) الكافي: ج 3، ك 4، ب 75، ح 3.(@)(@@) يزيد بن إسحاق شعر * روى عن الحسن بن عطية، وروى عنه الخشاب.(@)(@@) الكافي: ج 5، ك 3، ب 112، ح 15.(@)(@@) والتهذيب: ج 7، ح 1066. PageV21P269(@)(@@) * وروى عن حماد بن عثمان، وروى عنه يحيى بن زكريا بن شيبان.(@)(@@) التهذيب: ج 4، ح 470.(@)(@@) وروى عنه يحيى بن زكريا اللؤلؤي.(@)(@@) التهذيب: ج 4، ح 471.(@)(@@) * وروى عن عبد الله بن المنذر، وروى عنه النهدي.(@)(@@) الكافي: ج 2، ك 1، ب 124، ح 17.(@)(@@) * وروى عن هارون بن حمزة، وروى عنه محمد بن الحسين.(@)(@@) الكافي: ج 5، ك 2، ب 156، ح 1، و ج 6، ك 2، ب 34، ح 11. والتهذيب: ج 3، ح 994، و ج 7، ح 981.(@)(@@) وروى عنه محمد بن الحسين بن أبي الخطاب.(@)(@@) التهذيب: ج 4، ح 449 و 476.(@)(@@) * وروى عن هارون بن حمزة الغنوي، وروى عنه ابن أبي نجران.(@)(@@) التهذيب: ج 8، ح 422 (الاستبصار:(@)(@@) ج 3، ح 1161).(@)(@@) وروى عنه الحسن بن موسى الخشاب.(@)(@@) التهذيب: ج 1، ح 690 (الاستبصار:(@)(@@) ج 1، ح 59، و 113، وفيهما يزيد بن إسحاق فقط)، و ج 9، ح 493.(@)(@@) وروى عنه محمد بن الحسين.(@)(@@) الكافي: ج 5، ك 2، ب 138، ح 5، و ب 149، ح 4. والتهذيب: ج 3، ح 864 (الاستبصار: ج 1، ح 1721)، و ج 7، ح 341، و ج 9، ح 493.(@)(@@) وروى عنه محمد بن الحسين بن أبي الخطاب.(@)(@@) مشيخة الفقيه: في طريقه إلى هارون ابن حمزة الغنوي. والتهذيب: 
ms6711	 ج 1، ح 690 (الاستبصار: ج 1، ح 690 (الاستبصار:(@)(@@) ج 1، ح 59، و 113، وفيهما يزيد بن إسحاق فقط)، و ج 4، ح 467.(@)(@@) * وروى عن هارون بن حمزة الغنوي الصيرفي، وروى عنه محمد بن علي الصيرفي.(@)(@@) التهذيب: ج 8، ح 483.(@)(@@) يزيد بن خليفة * روى عن أبي عبد الله عليه السلام، وروى عنه أبو المغراء.(@)(@@) الكافي: ج 2، ك 1، ب 116، ح 3.(@)(@@) وروى عنه ابن مسكان.(@)(@@) الكافي: ج 4، ك 3، ب 21، ح 20، و ج 5، ك 2، ب 107، ح 4. والفقيه: ج 2، PageV21P270(@)(@@) ح 745.(@)(@@) وروى عنه حنان بن سدير.(@)(@@) الكافي: ج 6، ك 7، ب 21، ح 16.(@)(@@) وروى عنه صفوان.(@)(@@) الفقيه: ج 2، ح 1235. والتهذيب: ج 5، ح 443، و 1241 (الاستبصار: ج 2، ح 694).(@)(@@) وروى عنه صفوان بن يحيى.(@)(@@) الكافي: ج 2، ك 1، ب 37، ح 3، و ج 4، ك 2، ب 59، ح 6.(@)(@@) وروى عنه عاصم بن حميد.(@)(@@) التهذيب: ج 3، ح 1043 (الاستبصار:(@)(@@) ج 1، ح 1880).(@)(@@) وروى عنه عبد الكريم.(@)(@@) التهذيب: ج 5، ح 1242 (الاستبصار:(@)(@@) ج 2، ح 695).(@)(@@) وروى عبد الله بن المغيرة، عمن حدثه، عنه.(@)(@@) التهذيب: ج 2، ح 1550.(@)(@@) وروى عنه يونس.(@)(@@) الكافي: ج 3، ك 4، ب 1، ح 4، وب 5، ح 1، وب 6، ح 6، وب 7، ح 4.(@)(@@) والتهذيب: ج 2، ح 56 (الاستبصار:(@)(@@) ج 1، ح 932)، و ح 95 (الاستبصار:(@)(@@) ج 1، ح 965)، و ح 112 (الاستبصار:(@)(@@) ج 1، ح 991).(@)(@@) يزيد بن عبد الملك * روى عن أبي جعفر عليه السلام، وروى عنه صالح بن عقبة.(@)(@@) الكافي: ج 1، ك 4، ب 114، ح 6.(@)(@@) * وروى عن أبي عبد الله عليه السلام، وروى عنه صالح بن عقبة.(@)(@@) الكافي: ج 2، ك 1، ب 81، ح 2، وب 86، ح 19، و ج 4، ك 3، ب 109، ح 13، و ب 114، ح 3، وب 233، ح 3.(@)(@@) والتهذيب: ج 5، ح 1292، و 1627.(@)(@@) وروى عنه صالح بن عقبة الخياط (القماط).(@)(@@) الكافي: ج 6، ك 6، ب 101، ح 15.(@)(@@) * وروى عن أبي جعفر وأبي عبد الله وأبي الحسن عليهم السلام، وروى عنه صالح بن عقبة.(@)(@@) التهذيب: ج 10، ح 510.(@)(@@) * وروى عن أبيه، وروى عنه الخيبري.(@)(@@) التهذيب: ج 6، ح 18. PageV21P271(@)(@@) يزيد الكناسي * روى عن أبي جعفر عليه السلام، وروى عنه أبو أيوب.(@)(@@) الكافي: ج 3، ك 3، ب 95، ح 38، و ج 7، ك 3، ب 14، ح 2. والتهذيب: ج 10، ح 61، و 133.(@)(@@) وروى عنه أبو أيوب 
