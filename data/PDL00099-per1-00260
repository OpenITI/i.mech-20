ms241	 خصمت اگر جای چون شرار کند(@)(@@) 59 حساب نیک و بد خلق را به روز جزا %~% به نیم لحظه تواندکه‌‌ کردگار کند(@)(@@) 60 ولیک روز جزا زان دراز شد کایزد %~% عطا و جود تو ‌را یک‌ به یک شمار کند(@)(@@) 61 بزرگوارا این خادمت ز بیجایی %~% بدان رسیده ‌که از مملکت فرار کند(@)(@@) 62 نه آتشست‌که بالا رود به چرخ اثیر %~% نه صرصرست که در بحر و بر گذار کند(@)(@@) 63 نه شیر شرزه‌ که در بیشه معتکف‌ گردد %~% نه مارگرزه‌که آرامگه به غارکند(@)(@@) 64 نه قمری است ‌که بر شاخ سرو گیرد جای %~% نه مرغ‌زارکه مأوا به مرغزار کند(@)(@@) 65 نهنگ نیست که ساکن شود به لجه بحر %~% پلنگ نیست ‌که مسکن به ‌کوهسار کند(@)(@@) 66 فرشته نیست‌که بر آسمان‌گشاید بال %~% ستاره نیست‌ که گرد فلک مدار کند(@)(@@) 67 نه خاک تاری تا رو نهد به مرکز خویش %~% نه آب جاری تا جا به جویبار کند(@)(@@) 68 نه عقل صرف‌که در لامکان مکان‌گیرد %~% نه جان پاک‌ که بی‌جایی اختیار کند(@)(@@) 69 نهنگ لجه فضلست و دست او دریا %~% از آن عزیمت دریا نهنگ‌وار کند(@)(@@) 70 گرفتم آنکه بود در شاهوار سخن %~% نه جایگه به صدف در شاهوار کند(@)(@@) 71 گرفتم آنکه بود مهر نوربار هنر %~% نه جایگه به فلک مهر نور بار کند(@)(@@) 72 ز التفات تو دارد طمع‌که چون خورشید %~% به خانه‌یی چو چهارم فلک مدارکند(@)(@@) 73 حکیم‌ گوید کاینده را همی زیبد %~% که حال خود را از رفته اعتبارکند(@)(@@) 74 هزار خانه وکشور بدان‌کسی دادی %~% که مرگشان به دو قرن دگر شکار کند(@)(@@) 75 همان نه خانه بجا ماند و نه خانه خدای %~% که انقلاب جهان هر دو را غبارکند(@)(@@) 76 مگر مدایح من در زمانه ماند و بس %~% کش از محامد تو چرخ یادگار کند(@)(@@) 77 سپهر از آن همه دلکش قصور محمودی %~% به مدح عنصری امروز افتخار کند(@)(@@) 78 جهان از آن همه آواز سنج 
ms242	 سنجرشاه %~% به شعر انوری امروز اختصارکند(@)(@@) 79 بسی ز بخت خود اندر زمانه نومیدم %~% مگر که لطف تو بازم امیدوار کند(@)(@@) 80 به هرکه تاکه بود نام از یسار و یمین %~% قضا یمین ترا مایه یسار کند PageV1P158(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 هر کرا ایزد اختیار کند %~% در دوگیتیش‌ بختیارکند(@)(@@) 2 وانکه را کردگار کرد عزیز %~% نتواند زمانه خوارکند(@)(@@) 3 بس نماید مدار چرخ‌کهن %~% تا یکی را جهان مدار کند(@)(@@) 4 صه‌ چون شاه خاوران ملک %~% که بدو ملک افتخار کند(@)(@@) 5 قهرمان میرزاکه از سخطش %~% ملک الموت زینهارکند(@)(@@) 6 آنکه چون پا به ‌کارزار نهد %~% بر بداندیش کارزار کند(@)(@@) 7 خنگش از گرد در بسیط زمین %~% هرچه دشت‌است کوهسار کند(@)(@@) 8 تبرش از سهم در دیار عدو %~% هرچه چشمست‌اشکبار کند(@)(@@) 9 تیغش ار نیست نو بهار چرا %~% دامن خاک لاله‌زارکند(@)(@@) 10 باش‌ تا بوم روم را ز غبار %~% تیره چون اهل زنگبارکند(@)(@@) 11 باش تا عزم مملکت‌گیرش %~% فتح‌ کشمیر و قندهار کند(@)(@@) 12 باش تا موکب جهانگردش %~% عزم فرغانه و حصارکند(@)(@@) 13 جیشش از مور تیغ و مار سنان %~% پهنه را پر ز مور و مار کند(@)(@@) 14 قتل و تاراج و اخذ مال و منال %~% به یکی حمله هر چهارکند(@)(@@) 15 در مذاق عدو مهابت او %~% شهد را زهر ناگوارکند(@)(@@) 16 دشمن از ملک او برون نرود %~% مگر از این جهان فرارکند(@)(@@) 17 نفس باد عنبرین ‌گردد %~% چون به خاک درش گذار کند(@)(@@) 18 با تن دشمنان‌ ک‌ند قهرش %~% آنچه با پرنیان شرارکند(@)(@@) 19 با دل دوستان ‌کند مهرش %~% آنچه با بوستان بهارکند(@)(@@) 20 کس نیارد که تا به روز شمار %~% جود یک‌روزه‌اش شمارکند(@)(@@) 21 آ‌فتابیست بر فراز سپهر %~% جا چو بر خنگ راهوار کند(@)(@@) 22 ای امیری‌که یک پیاده تو %~% کار یکم مملکت سوارکند(@)(@@) 23 در جهان هیچ راز پنهان نیست %~% کش نه رای تو آشکارکند(@)(@@) 24 نبرد جان عدو ز سطوت تو %~% گر ز پولاد صد حصار کند 
ms243	(@)(@@) 25 فلک سفله را قضا نه عجب %~% گر به کاخ تو پرده‌دار کند(@)(@@) 26 لاجرم عنکبوت پرده زند %~% چون نبی جایگاه به غار کند(@)(@@) 27 بس ‌عجب نیست‌ کز رعایت تو %~% پشه سیمرغ را شکار کند(@)(@@) 28 در صف کینه خنجرت کاری %~% با تن خصم نابکار کند(@)(@@) 29 کافریدون به خیره سر ضحاک %~% همی ازگرزگاو سارکند(@)(@@) 30 گوش آفاق را مشاطه صنع %~% از عطای تو گوشوار کند(@)(@@) 31 شهریارا سزدکه دولت تو %~% فخر از صدر روزگار کند(@)(@@) 32 دولت تست چرخ و او اختر %~% چرخ از اختر افتخارکند(@)(@@) 33 آن امیری‌که‌کوه را سخطش %~% همچو سیماب بی‌قرارکند(@)(@@) 34 آنکه در چشم فتنه انصافش %~% اثر برگ کوکنار کند(@)(@@) 35 خرد پیر راکیاست او %~% سخره طفل شیرخوار کند(@)(@@) 36 بحر عمان‌کهین عطیه اوست %~% که به هنگام اضطرار کند(@)(@@) 37 ورنه‌در یک نفس دو عالم را %~% خود به یک سایلی نثارکند(@)(@@) 38 حزم او آبگینه را به مثل %~% همچو البرز استوار کند(@)(@@) 39 نکند تکیه برکسی الاک %~% تکیه بر عون‌کردگارکند(@)(@@) 40 به دو انگشت نی سرانگشتش %~% کار صد تیغ آبدارکند(@)(@@) 41 هست یک‌تن ولی به‌جودت رای %~% روز کین کار صدهزار کند(@)(@@) 42 ابر دستش به دشت اگر بارد %~% دشت را بحر بی‌کنار کند(@)(@@) 43 خسروا به‌که در محامد تو %~% فکر قاآنی اختصارکند(@)(@@) 44 تا همی خاک را عبیرآگین %~% نفس باد نوبهارکند(@)(@@) 45 ابر اردیبهشت بستان را %~% مخزن در شاهوار کند(@)(@@) 46 دولتت را چو حزم آصف عهد %~% ملک العرش پایدارکند PageV1P159(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 قضا چو مسند اقبال در جهان افکند %~% به عزم داوری شاه‌کامران افکند(@)(@@) 2 ابو الشجاع حسن‌ شه که شیر گردون را %~% مهابتش تب و لرز اندر استخوان افکند(@)(@@) 3 تهمتنی ‌که به یک چین چهره سطوت او %~% هزار لرزه بر اندام آسمان افکند(@)(@@) 4 دلاوری‌که ز یک خم خام پر خم و تاب %~% هزار سلسله بر بال‌کهکشان افکند(@)(@@) 5 به نیم‌کاوش فکرت ز رای موی‌شکاف %~% هزار رخنه در ابداع کن‌فکان افکند 
ms244	(@)(@@) 6 ز قطره‌ای‌ که چکد ز ابر دست او بر خاک %~% توان بنای دوصد بحر بیکران افکند(@)(@@) 7 فتد زکاخ وی ار سنگ‌ریزه‌یی به زمین %~% ازو اساس جهان دگر توان افکند(@)(@@) 8 تنی که کرد خیال خلاف او به ضمیر %~% اجل به دوده او مرگ ناگهان افکند(@)(@@) 9 ز بس که دهره او بحر بهرمان آورد %~% به دهر طنطنه در کان بهرمان افکند(@)(@@) 10 گره‌ گشود ز کار زمانه شمشیرش %~% گره چو در خم ابروی جانستان افکند(@)(@@) 11 فلک‌ ز بهر زمین‌بوس آستانه او %~% به لابه خود را در پای پاسبان افکند(@)(@@) 12 بر آستان ز فرومایگی چو بار نیافت %~% به عذر فعل خطا خاک در دهان افکند(@)(@@) 13 تویی ‌که ابر کفت دوده دنائت را %~% ز یک افاضه فیضی ز خانمان افکند(@)(@@) 14 تویی‌که نسخه دیباچه جلادت تو %~% حدیث رستم دستان ز داستان افکند(@)(@@) 15 اساس فتنه برافتاد آن زمان ز جهان %~% که جوش جیش تو آشوب در جهان افکند(@)(@@) 16 سنان قهر تو در خرق و التیام فلک %~% حکیم فلسفه را باز درگمان افکند(@)(@@) 17 نبود خون عدو آنچه روزکین بر خاک %~% پرند قهر تو چون نقش پرنیان افکند(@)(@@) 18 حسامت از تب لازم چو گشت لاغر و زرد %~% پی علاج خو‌د از چهره ناردان افکند(@)(@@) 19 فضای درگهت از نه فلک وسیع‌ترست %~% عجب ‌که وقعه درین تیره خاکدان افکند(@)(@@) 20 نیام تیغ تو آن برغمان تیره دلست %~% که‌گاه‌کینه‌وری دوزخ از دهان افکند(@)(@@) 21 بلارک تو اگر نیست خیره‌سر بهمن %~% گذر ز بهر چه در کام برغمان افکند(@)(@@) 22 زمانه عرض غلامان درگهت می‌داد %~% سپهر خود را دزدیده در میان افکند(@)(@@) 23 شها ز قهر پرندوشت آتشین آهم %~% شرار در دل ابنای انس و جان افکند(@)(@@) 24 روا مدار که خلقی زنند شکرخند %~% که ذره را ز نظر شاه خاوران افکند(@)(@@) 25 کسی‌که معدن چندین هزار فضل بود %~% نشایدش به چنین رنج بیکران افکند(@)(@@) 26 ز من جهانی 
ms245	 در خنده زانکه سطوت تو %~% به سرخ چهره من رنگ زعفران افکند(@)(@@) 27 ز یک شکنج به روی مهابت تو به من %~% دو قوم را به‌گمان عقل نکته‌دان افکند(@)(@@) 28 یکی بر آنکه به ظاهر ز بهر سود نهان %~% به‌نام او ملک این قرعه زیان افکند(@)(@@) 29 برای برتری پایه سایه بر سر او %~% همای تربیت شاه‌کامران افکند(@)(@@) 30 یکی بر آنکه به باطن شه از ظهور خطا %~% مرا ز چشم مقیمان آستان افکند(@)(@@) 31 ز قهر بارخدایی بسان بارخدای %~% چو پست پایه عزازیلش از جنان افکند(@)(@@) 32 به‌راستی‌که خود اندر تحیرم‌که ملک %~% به من ز بهر چه این خشم ناگهان افکند(@)(@@) 33 خلاصه کز پی تشکیک خلق از در لطف %~% به ناتوان تن من خلعتی توان افکند(@)(@@) 34 به دهر تاکه سرایند ان‌س و جان‌که رسول %~% صلای دین شریعت در انس و جان افکند(@)(@@) 35 ز امن عدل تو افکنده باد رسم ستم %~% چنانکه معدلت‌کسری از جهان افکند PageV1P160(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 آدمی باید به‌گیتی عمر جاویدان‌ کند %~% تا یکی از صد تواند مدح آقاخان کند(@)(@@) 2 محکمران خطه‌کرمان‌که ابر دست او %~% خاک را بیجاده سازد سنگ را مرجان‌ کند(@)(@@) 3 در بر اوکمترست از پیر زالی پور زال %~% او زکین‌گر بهر هیجا جای بر یکران‌کند(@)(@@) 4 خصم ‌را گو پیش تیغش جوشن و خفتان مپرس %~% مرگ را کی چاره هرگز جوشن و خفتان کند(@)(@@) 5 خنجر آتش‌فشانش از لباس زندگی %~% خصم‌راعریان‌کند چون‌خویش راعریان‌کند(@)(@@) 6 صیت اه بگرفت‌م‌یتی را چو ور مهر و ماه %~% نور مهر و ماه را حاسد چسان پنهان‌کند(@)(@@) 7 خاک ره را مهر او همسان‌ کند با آسمان %~% واسمان را قهر او با خاک ره یکسان کند(@)(@@) 8 گردش چشمش به‌ یک ایمای ابروگاه خشم %~% موی مژگان را به چشم بدکنش سوهان کند(@)(@@) 9 خود به سیر لاله و ریحان ندارد احتیاج %~% کز نگاهی خاک وگل را لاله و ریحان کند(@)(@@) 10 آب تیغش ملک ویران 
ms246	 را ز نو آباد کرد %~% هرکجا ویرانه آری آبش آبادان کند(@)(@@) 11 نسبت‌جودش به‌عمان‌کی دهم‌کاو هر زمان %~% جیب سائل را ز گوهر غیرت عمان‌ کند(@)(@@) 12 اوج‌‌ردون‌در حضیض جا او مشکل رسد %~% بر فلک بیچاره خود را چند سر‌گردان‌ کند(@)(@@) 13 نرم‌‌ گر‌دد خصم‌شوم‌از ضرب‌‌ گرز او چو موم %~% گر براز آهن دل از رو پیکر از سندان‌کند(@)(@@) 14 چرخ ‌با وی ‌چون ستیزد کانکه خاید پتک را %~% ز ابلهی بیچاره باید چاره دندان‌ کند(@)(@@) 15 صاحبا قاآنی از شوق تو در اقلیم فارس %~% روز و شب در دل خیال خطه ‌کرمان ‌کند(@)(@@) 16 یاد آن شب کز خیالت چشم من پر نور بود %~% تیره چشمم را ز سیل قطره چون قطران کند(@)(@@) 17 عیش‌ آن‌شب را اگر با صد زبان خواهد بیان %~% نیستش پایان و گر خود عمر بی‌پایان کند(@)(@@) 18 دارد از جود دو دستت‌آرزو یکدست فرش %~% تا طراز بزمگاه و زینت ایوان‌کند(@)(@@) 19 هم ز بهر گلرخی ‌کز وی و ثاقم‌ گلشنست %~% تحفه‌یی بایدکه او را همچوگل خندان‌کند(@)(@@) 20 تحفه‌اش شالیست تا سالی ببندد بر میان %~% برتری زامثال جوید فخر بر اقران‌کند(@)(@@) 21 خود تو دانی گر دلی باشد مرا در پیش اوست %~% اختیار او راست‌ گر آباد و گر ویران ‌کند(@)(@@) 22 من به قدر همت خودکردم استدعا و تو %~% همتت دیگر ندانم تا چه حد احسان‌ کند(@)(@@) 23 باد دور دولتت ایمن زکید روزگار %~% تا به‌ گرد خاک ساکن آسمان جولان‌ کند PageV1P161(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ن‌هرچون‌نیرگ‌سازد چرخ‌چون‌دستان‌کند %~% مغز را آشفته سازد عقل را حی‌ران‌م‌ند(@)(@@) 2 آن‌ کلاه نامرادی بر سر دانا نهد %~% این قبای کامرانی در بر نادان‌ کند(@)(@@) 3 گاه آن بر خواری دانا دوصد بهتان زند %~% گاه این بر یاری نادان دو‌صد برهان ‌کند(@)(@@) 4 در بر دانا اگر بیند لباس عبقری %~% تارتارش را به سختی اره و سوهان کند(@)(@@) 5 بر تن نادان اگر یابد پلاس دیلمی %~% موی مویش را به نرمی 
ms247	 توزی و کتان‌ کند(@)(@@) 6 گه به ‌کین ناصر خسرو فروبندد کمر %~% تا مر او را در بدخشان محبس‌ از یمگان کند(@)(@@) 7 گه سعایتها کند درباره مسعود سعد %~% تا مر او را در لهاور سکنه در زندان‌ کند(@)(@@) 8 گه نماید انوری را سخره اوباش بلخ %~% تیره‌رای روشنش را چون شب تاران ‌کند(@)(@@) 9 گه‌کند فردوسی فردوس فکرت را غمین %~% تا مر آن میمندی ناپاک را شادان‌کند(@)(@@) 10 گاه در بزم امیری لولوی همچون مرا %~% همچو لالا زیر دست لولی‌ کرمان ‌کند(@)(@@) 11 تا نپنداری‌ کنون ‌کفران نعمت می‌کنم %~% نعمتی ناچار باید تاکسی ‌کفران کند(@)(@@) 12 چون‌کند کفران‌نعمت ‌آنکه در ده سال و اند %~% مدح بی‌انعام‌ گوید شکر بی‌احسان‌ کند(@)(@@) 13 گر سگی یک‌ هفته بر خوانی نیابد استخوان %~% از پی تحصیل ستخوان ترک آن سامان ‌کند(@)(@@) 14 آدمی آخر کم از سگ نیست چون ناچار شد %~% رو به درگاه فلان از خدمت بهمان‌ کند(@)(@@) 15 چون سگان راضی بدم بالله به‌جای نان خشک %~% میر دیرینم غذا از پاره ستخوان‌کند(@)(@@) 16 تا نگوید جاهلی در حق من ‌کاین ناسپاس %~% از چه ترک میر دیرین از در عصیان‌کند(@)(@@) 17 کس شنیدستی ‌چو من هر بامداد ازفرط‌ جوع %~% قرصه خورشید تابان را خیال نان‌ کند(@)(@@) 18 کس ‌شنیدستی‌چو م‌ن بی‌خرگه و بی‌سایبان %~% در صحاری جایگه ایام تابستان کند(@)(@@) 19 کس‌شنیدستی‌چو من‌در سردفصل مهرگان %~% بر شواهق خواجگه با پیکر عریان‌ کند(@)(@@) 20 کس تواند صد هزاران نامه آراید چو من %~% در مدیح‌خواجه‌هریک‌را دوصدعنوان‌کند(@)(@@) 21 دوش ‌گفتم با خرد کای آفتاب همتت %~% خاک را بیجاده سازد سنگ را مرجان‌ کند(@)(@@) 22 تا یکی برق سحابی ‌گر همی بینم ز دور %~% جان عطشانم ‌گمان چشمه حیوان‌ کند(@)(@@) 23 با چنین شعری‌ که گر بر خاره برخواند کسی %~% لب‌گشاید وافرین بر قدرت یزدان‌ کند(@)(@@) 24 کیست تا درد درون و زخم بیرون مرا %~% ازکرم مرهم‌ گذارد وز وفا درمان‌ کند(@)(@@) 25 کیست‌ کز نیشم نماید 
ms248	 نوش و از خارم رطب %~% محنتم را چاره سازد مشکلم آسان‌ کند(@)(@@) 26 صاحبی کو تا ز بهر دفع ماران عجم %~% نطق را سازد کلیم و خامه را ثعبان‌ کند(@)(@@) 27 عقل گفتا حل این مشکل نیارد کرد کس %~% هم مگر بوالفضل راد از فضل بی‌پایان‌ کند(@)(@@) 28 آسمان فضل و دانش آنکه از باران فضل %~% ذره را خورشید سازد قطره را عمان ‌کند(@)(@@) 29 آ‌نکه رایش در اصابت خنده بر بیضا زند %~% آنکه‌ظقث‌در فصاحت‌م‌‌یه بر سحبان‌کند(@)(@@) 30 آنکه نبال خلافش بر تن اهل نفاق %~% صد هزاران تیر توزی از رگ شریان‌ کند(@)(@@) 31 آنکه معمار رضایش از پی اهل وفاق %~% صد هزاران باغ سوری از تف نیران ‌کند(@)(@@) 32 د‌ست‌ جودش در سخاوت ‌طعنه ‌بر حاتم زند %~% طبع رادش در کرامت فخر بر قاآن‌ کند(@)(@@) 33 گفت او برهان‌ گفت عیسی مریم بود %~% رای او اثبات دست موسی عمران ‌کند(@)(@@) 34 خلق‌و خویش ‌را نظرکن تا بدانی ‌کاسمان %~% هم ز خاک ری تواند بوذر و سلمان‌ کند(@)(@@) 35 جهدها دارد جهان تا درگه عالیش را %~% قبله احرار سازد کعبه ایمان‌ کند(@)(@@) 36 آسمان قدرا روا باد فریدی همچو من %~% خنده بر کار جهان و گریه بر سامان‌ کند(@)(@@) 37 چون پسندی ‌کاسمان در دولت صاحبقران %~% بی‌قرینی چون مرا دست‌افکن اقران‌ کند(@)(@@) 38 آنکه‌قهر و خشمش ‌‌اندرچشم‌وجسم‌بدسگال %~% روح را سندان نماید مژه را پیکان‌کند(@)(@@) 39 باش تاختلی سمندش از غبار کارزار %~% طرح‌ گردونی دگر در ساحت ختلان‌ کند(@)(@@) 40 باش تا بینی ز لاش شیر مردان ختن %~% دیو و دد را تا قیامت ناچخش مهمان‌ کند(@)(@@) 41 باش تا از بانگ شیپورش به مرز قندهار %~% هر نفس افغان خدا از بیم جان‌افغان‌کند(@)(@@) 42 باش تا شیران تبت را کشد در پالهنگ %~% واهوان تبتی را شیر در پستان‌کند(@)(@@) 43 سعیها دارد فلک‌ کز همت صاحبقران %~% بر جهانش از قیروان تا قیروان سلطان‌کند(@)(@@) 44 تا همی‌ گوی زمین زیر فلک ساکن بود 
ms249	 %~% تا همی خنگ فلک‌ گرد زمین جولان ‌کند(@)(@@) 45 از امیران باج‌ گیرد جان ستاند بر خورد %~% بر دلیران ملک بخشد زر دهد فرمان‌کند PageV1P162(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 آنچه با برگ درختان ابر نوروزی‌کند %~% با تهیدستان کف فیاض فیروزی‌ کند(@)(@@) 2 زان سبب فیروز شد نامش‌ که از آیات او %~% بخت هر روز آشکار آیات فیروزی‌ کند(@)(@@) 3 هست چهرش گنج فیروزی و گردد آشکار %~% هرکرا آن‌گنج ‌روزی خدا روزی‌کند(@)(@@) 4 آفتاب روی جانبخش به‌ هر مجلس ‌که تافت %~% شمع نتواند که دیگر مجلس‌ افروزی کند(@)(@@) 5 بر بسوزان خنجر او امر فرماید خدای %~% قهر جباریش اگر عزم جهانسوزی ‌کند(@)(@@) 6 سنگلاخ‌ کوهساران را تواند زیر پای %~% باد رفقش نرمتر از قاقم و توزی‌ کند(@)(@@) 7 ای که هر کس یاد جودت کرد یزدان تا به حشر %~% بی‌نیازش زاکتساب رنج هر روزی‌کند(@)(@@) 8 گر بخواهد پیر عقلت‌ دانش آموزد خطاست %~% طفل نتواند به لقمان حکمت آموزی کند(@)(@@) 9 چنگ عزراییل گویی در دم شمشیر توست %~% زان بمیراند جهانی را چو کین ‌توزی ‌کند(@)(@@) 10 گر به شکل گوژ خواهد به سطح کاخ تو %~% گنبد پیروزه‌گون اظهار پیروزی کند(@)(@@) 11 عقل داند عین نقص‌است از فضولی نطفه‌‌یی %~% از شکم بر پشت آید بچه را قوزی‌کند(@)(@@) 12 یا چو خیاطست تیغت ‌کز حریر سرخ خون %~% حصم را بی‌رشته و سوزن کفن‌دوزی کند(@)(@@) 13 سرو ر‌ا سرسبزی بخت سرافراز تو نیست %~% ذره چون‌ شمسی نماید سبزه‌کی توزی‌کند(@)(@@) 14 شهدگفتار توزهرکژدم اهواز را %~% در حلاوت قند مصر و شکر خوزی‌ کند(@)(@@) 15 گنج ‌هر رو‌زیست ‌جودت‌ وانکه ‌را روزی‌ شود %~% رحمت حق بی‌نیاز از رنج هر روزی‌کند(@)(@@) 16 شیر چرخ‌از مهر و مه قلاده سازد ماه و سال %~% بویه در نخجیرگه روزی ترا یوزی‌کند(@)(@@) 17 هر که روزی پوز جنباندکه بدگوید ترا %~% چون سگ آلوده‌دهان از باد بد پوزی‌کند(@)(@@) 18 از پی خاموشی جاوید فرماید خدای %~% تا بر اطراف دهانش مرگ بتفوزی‌کند(@)(@@) 19 عزم بازی‌ 
ms250	 گرکنی ساعات روز و شب بهم %~% جمع‌‌مردد ناه نردی وه دوزی‌کند(@)(@@) 20 قافیه تنگست و من دلتنگ‌تر زانرو که طبع %~% خواهد استیفای وصفت بهر بهروزی‌کند(@)(@@) 21 می‌تواند وضع لفظ خوش ز بهر قافیه %~% هم بود ازکودنی‌گر قافیه بوزی ‌کند(@)(@@) 22 مرچه برخی از قوافی نیز زشت افتاد لیک %~% با قبولت چون رخ زیبا دل‌افروزی‌کند(@)(@@) 23 تا دهان غنچه پرگردد ز مروارید تر %~% چون به زیر لب ثنای ابر نوروزی ‌کند(@)(@@) 24 غنچه‌سان خندان و کامش پر ز مروارید باد %~% چون‌صدف‌هر کاوبه‌مدحت‌گو‌هراندوزی‌کند PageV1P163(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 هر دل اسیر زلف تو بیدادگر بود %~% کارش ز تار زلف تو آشفته‌تر بود(@)(@@) 2 آشوب ملک شاهی و بیدادکار تست %~% ترکی و ترک لابد بیدادگر بود(@)(@@) 3 در ملک حسن شاهی زان شور و شرکنی %~% شک نیست حس چونین با شور و شر بود(@)(@@) 4 شمشاد مهرچهری و خورشید مه‌جبین %~% مانات مهر مادر و ماهت پدر بود(@)(@@) 5 باور نیفتدم ‌که بدین حسن و دلبری %~% نقشی به چین و سروی در غاتفر بود(@)(@@) 6 در چین و کاشغر ز پی چون تو دلفریب %~% همواره پای اهل نظر رهسپر بود(@)(@@) 7 ورنه چو بست صورت با چون تویی وصال %~% خواهم نه چین بماند و نه‌کاشغر بود(@)(@@) 8 هرجاکه جلوه سازکنی‌گشت قندهار %~% هر جا خرام ناز کنی‌ کاشمر بود(@)(@@) 9 هرگه به زلف شانه زنی تبتست ‌کوی %~% ور برکشی نقاب سرا شوشتر بود(@)(@@) 10 رویت به نور با مه‌ گردون برابرست %~% زلفت به رنگ دایه مشک تتر بود(@)(@@) 11 ماه فلک نه حاشاکی مشک پرورد %~% مشک تتر نه‌ کلاکی با قمر بود(@)(@@) 12 ر‌وی تو ماه باشد و طرفه بود که ماه %~% برجرم روشنش زره از مشک تر بود(@)(@@) 13 چندان ‌که وصف خوبی یوسف نموده‌اند %~% ستوار نایدم‌که ز تو خوبتر بود(@)(@@) 14 یوسف اگر به چاهی وقتی نهفت چهر %~% چاهی ترا به‌گرد زنخ مستتر بود(@)(@@) 15 یاقوت را به‌ گونه همی ماند آن دو لب %~% الا 
