ms561	(@)(@@) 19 جوانان را زبون بینی زمین دریای خون بینی %~% چنان دلبر هزاران بیش در زیر قدم بینی(@)(@@) 20 نخواهد بودن این حالت بترسید ای مسلمانان %~% چو این مشکل بیان گردد کجا زلف صنم بینی(@)(@@) 21 سنایی خود یکی بنگر که فردا چون بود حالت %~% ازین گفتار بی معنی بسی در دیده نم بینی(@)(@@) 22 مگر فضلی کند ایزد کزین حالت رها گردی %~% وگر نه با چنین خصلت نجات خویش کم بینی PageV1P0635(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 دلا تا کی درین زندان فریب این و آن بینی %~% یکی زین چاه ظلمانی برون شو تا جهان بینی(@)(@@) 2 جهانی کاندرو هر دل که یابی پادشا یابی %~% جهانی کاندرو هر جان که بینی شادمان بینی(@)(@@) 3 درو گر جامه‌ای دوزی ز فضلش آستین یابی %~% درو گر خانه‌ای سازی ز عدلش آستان بینی(@)(@@) 4 نه بر اوج هوا او را عقابی دل شکر یابی %~% نه اندر قعر بحر او را نهنگی جان ستان بینی(@)(@@) 5 اگر در باغ عشق آیی همه فراش دل یابی %~% وگر در راه دین آیی همه نقاش جان بینی(@)(@@) 6 گهی انوار عرشی را ازین جانب مدد یابی %~% گهی اشکال حسی را ازین عالم بیان بینی(@)(@@) 7 سبک رو چون توانی بود سوی آسمان تا تو %~% ز ترکیب چهار ارکان همی خود را گران بینی(@)(@@) 8 اگر صد قرن ازین عالم بپویی سوی آن بالا %~% چو دیگر سالکان خود را هم اندر نردبان بینی(@)(@@) 9 گر از میدان شهوانی سوی ایوان عشق آیی %~% چو کیوان در زمان خود را به هفتم آسمان بینی(@)(@@) 10 درین ره گرم رو می‌باش لیک از روی نادانی %~% نگر نندیشیا هرگز که این ره را کران بینی(@)(@@) 11 وگر زی حضرت قدسی خرامان گردی از عزت %~% ز دارالملک ربانی جنیبتها روان بینی(@)(@@) 12 ز حرص و شهوت و کینه ببر تازان سپس خود را %~% اگر دیوی ملک یابی وگر گرگی شبان بینی(@)(@@) 13 ور امروز اندرین منزل 
ms562	 ترا جانی زیان آمد %~% زهی سرمایه و سودا که فردا زان زیان بینی(@)(@@) 14 زبان از حرف پیمایی یکی یک چند کوته کن %~% چو از ظاهر خمش گردی همه باطن زبان بینی(@)(@@) 15 گر اوباش طبیعت را برون آری ز دل زان پس %~% همه رمز الاهی را ز خاطر ترجمان بینی(@)(@@) 16 مرین مهمان علوی را گرامی دار تا روزی %~% چو زین گنبد برون پری مر او را میزبان بینی(@)(@@) 17 به حکمتها قوی پر کن مرین طاووس عرشی را %~% که تا زین دامگاه او را نشاط آشیان بینی(@)(@@) 18 نظرگاه الاهی را یکی بستان کن از عشقی %~% که در وی رنگ و بوی گل ز خون دوستان بینی(@)(@@) 19 که دولتیاری آن نبود که بر گل بوستان سازی %~% که دولتیاری آن باشد که در دل بوستان بینی(@)(@@) 20 چو درج در دین کردی ز فیض فضل حق دل را %~% مترس از دیو اگر به روی ز عصمت پاسبان بینی(@)(@@) 21 ز حسی دان نه از عقلی اگر در خود بدی یابی %~% ز هیزم دان نه از آتش اگر در وی دخان بینی(@)(@@) 22 بهانه بر قضا چهی چو مردان عزم خدمت کن %~% چو کردی عزم بنگر تا چه توفیق و توان بینی(@)(@@) 23 تو یک ساعت چو افریدون به میدان باش تا زان پس %~% به هر جانب که رو آری درفش کاویان بینی(@)(@@) 24 عنان گیر تو گر روزی جمال درد دین باشد %~% عجب نبود که با ابدال خود را همعنان بینی(@)(@@) 25 خلیل ار نیستی چه بود تو با عشق آی در آتش %~% که تا هر شعله‌ای ز آتش درخت ارغوان بینی(@)(@@) 26 عطا از خلق چون جویی گر او را مال ده گویی %~% به سوی عیب چون پویی گر او را غیب‌دان بینی(@)(@@) 27 ز بخشیدن چه عجز آید نگارنده دو گیتی را %~% که نقش از گوهران دانی و بخش اختران بینی(@)(@@) 28 ز یزدان دان نه 
ms563	 از ارکان که کوته دیدگی باشد %~% که خطی کز خرد خیزد تو آن را از بنان بینی(@)(@@) 29 چو جان از دین قوی کردی تن از خدمت مزین کن %~% که اسب تازی آن بهتر که با بر گستوان بینی(@)(@@) 30 اگر صد بار در روزی شیهد راه حق گردی %~% هم از گبران یکی باشی چو خود را در میان بینی(@)(@@) 31 امین باش ار همی ترسی ز مار آن جهان کز تو %~% به کار اینجا امین باشی ز مار آنجا امان بینی(@)(@@) 32 هوا را پای بگشادی خرد را دست بر بستی %~% گر آنرا زیر کام آری مرین را کامران بینی(@)(@@) 33 تو خود کی مرد آن باشی که دل را بی هوا خواهی %~% تو خود کی درد آن داری که تن را در هوان بینی(@)(@@) 34 که از دونی خیال نان چنان رستست در چشمت %~% که گر آبی خوری در وی نخستین شکل نان بینی(@)(@@) 35 مسی از زر بیالودی و می لافی چه سود اینجا %~% که آن گه ممتحن گردی که سنگ امتحان بینی(@)(@@) 36 نقاب قوت حسی چو از پیش تو بردارند %~% اگر گبری سقر یابی وگر مومن جنان بینی(@)(@@) 37 بهشت و دوزخت با تست در باطن نگر تا تو %~% سقرها در جگر یابی جنانها در جنان بینی(@)(@@) 38 امامت گر ز کبر و حرص و بخل و کین برون ناید %~% به دوزخ دانش از معنی گرش در گلستان بینی(@)(@@) 39 وگر چه طیلسان دارد مشو غره که این آنجا %~% یکی طوقیست از آتش که آنرا طیلسان بینی(@)(@@) 40 به چشم عافیت بنگر درین دنیا که تا آنجا %~% نه کس را نام و نان دانی نه کس را خانمان بینی(@)(@@) 41 یکی از چشم دل بنگر بدین زندان خاموشان %~% که تا این لعل گویا را به تابوت از چه سان بینی(@)(@@) 42 نه این ایوان علوی را به چادر زیب و فر یابی %~% نه این میدان 
ms564	 سفلی را مجال انس و جان بینی(@)(@@) 43 سر زلف عروسان را چو برگ نسترن یابی %~% رخ گلرنگ شاهان را به رنگ زعفران بینی(@)(@@) 44 بدین زور و زر دنیا چو بی عقلان مشو غره %~% که این آن نوبهاری نیست کش بی‌مهرگان بینی(@)(@@) 45 که گر عرشی به فرش آیی و گر ماهی به چاه افتی %~% وگر بحری تهی گردی وگر باغی خزان بینی(@)(@@) 46 یکی اعضات را حمال موران زمین یابی %~% یکی اجزات را اثقال دوران زمان بینی(@)(@@) 47 چه باید نازش و بالش بر اقبالی و ادباری %~% که تا بر هم زنی دیده نه این بینی نه آن بینی(@)(@@) 48 سر الب ارسلان دیدی ز رفعت رفته بر گردون %~% به مروآ تا کنون در گل تن الب ارسلان بینی(@)(@@) 49 چه باید تنگدل بودن که این یک مشت رعنا را %~% همی باد خداوندی کنون در بادبان بینی(@)(@@) 50 که تا یک چند از اینها گر نشانی باز جویی تو %~% ز چندان باد لختی خاک و مشتی استخوان بینی(@)(@@) 51 پس آن بهتر که از مردم سخن ماند نکو زیرا %~% که نام دوستان آن به نیک از دوستان بینی(@)(@@) 52 بسان علت اولا سخن ران ای سنایی زان %~% که تا چون زاده ثانی بقای جاودان بینی(@)(@@) 53 وگر عیبت کند جاهل به حکمت گفتن آن مشنو %~% که کار پیر آن بهتر که با مرد جوان بینی(@)(@@) 54 حکیمی گر ز کژ گویی بلا بیند عجب نبود %~% که دایم تیر گردون را وبال اندر کمان بینی(@)(@@) 55 به رای و عقل معنی را تویی راوی روایت کن %~% که معنی دان همان باشد کش اندر دل همان بینی PageV1P0636(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 فضل یحیاست بر ضعیف و قوی %~% فضل یحیای صاعد هروی(@)(@@) 2 پادشاه قضات و خواجه شرع %~% که چو صدرست و دیگران چو روی(@)(@@) 3 از صعود حیات و فضل دلش %~% نیست جز صورت صراط سوی(@)(@@) 4 پیش ادراک خاطر علویش 
