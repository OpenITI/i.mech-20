ms113	 جان و جهانم(@)(@@) 108 مرا از وصل خود یک ذره بنمای %~% چرا اندازیم از جای بر جای(@)(@@) 109 مرا از وصل جانان شاد گردان %~% دل و جانم بکل آبادگردان(@)(@@) 110 مرا از وصل جانان رخ نمودی %~% گره این لحظه از کارم گشودی(@)(@@) 111 مرا از وصل خود گردان فنا تو %~% که تا بینم ز تو عین بقا تو(@)(@@) 112 چو بنمودی جمال اندر جمالت %~% برون آور مرا هان ازوبالت(@)(@@) 113 جلالت یافتم طاقت ندارم %~% تو گوئی این زمان من پایدارم(@)(@@) 114 کنون من پایدارم گر بگوئی %~% ندانم کاین زمان با من چگوئی(@)(@@) 115 رهی بگذاشته و استاده اینجا %~% نمود من در اینجا داده غوغا(@)(@@) 116 عیانی در دل و در جان گرفته %~% حقیقت کفر با ایمان گرفته(@)(@@) 117 ز ایمانم ملال آمد بیکبار %~% شدم کافر حجاب از پیش بردار(@)(@@) 118 ز وصلت کافری دارم چگویم %~% در این میدان تو مانند گویم(@)(@@) 119 عنان عقل از دستم برون شد %~% چو دریا این دلم پر موج خون شد(@)(@@) 120 عنان عقل از دستم شد ای جان %~% کنون از دیدن تو مستم ای جان(@)(@@) 121 عنان عقل رفت و عشق آمد %~% مرا کل ازنهاد خویش بستد(@)(@@) 122 عیان عشق دیدم از نمودت %~% یقین من خویش دیدم دید دیدت(@)(@@) 123 عیان عشقی و دریای نوری %~% عجب در عشق اینجاگه صبوری(@)(@@) 124 خدایا بیش از این چیزی ندانم %~% ز بعد صورت و معنی بیانم(@)(@@) 125 ندانم جز خدایت آشکاره %~% گر این مردم کنندم پاره پاره(@)(@@) 126 ندانم جز خدایت در همه من %~% توئی قلب و توئی جان و توئی تن(@)(@@) 127 توئی افلاک و انجم در نمودار %~% توئی بنموده رخ از چرخ دوار(@)(@@) 128 توئی ماه و توئی خورشید جانها %~% که پیدا میکنی سر نهانها(@)(@@) 129 توئی عرش و توئی فرش و توئی لوح %~% که جانها رادهی در عین تن روح(@)(@@) 130 توئی عین قلم چون کل نوشتی %~% نمود جسم را از طین سرشتی(@)(@@) 131 
ms114	 توئی کرسی و دائم در خروجی %~% که در عین همه ذات البروجی(@)(@@) 132 توئی عین بهشت و عین ناری %~% چرا با ما دمی در دم نیاری(@)(@@) 133 توئی آتش توئی در جملگی باد %~% که از تو شد جهان عشق آباد(@)(@@) 134 توئی آب و توئی دیدار در خاک %~% نمود صنع خود در عالم پاک(@)(@@) 135 توئی هستی در این دریای جوهر %~% نمودی از نمود هفت اختر(@)(@@) 136 توئی کوه و زکان گوهر نمائی %~% که جان را اندرو رهبر نمائی(@)(@@) 137 توئی اصل و نمودتست دیدار %~% کنون اسرار کل ما را پدیدار(@)(@@) 138 نمودخود نما اینجا بتحقیق %~% که گفتم از تو بیشک راز توفیق(@)(@@) 139 توئی دید بهشت و عین یاری %~% چرا بابا دمی دردم نیاری(@)(@@) 140 جوابم ده که گفتار از تو دارم %~% نهانم کن که انوار از تو دارم(@)(@@) 141 جوابم ده چرا خاموش هستی %~% توئی دریا منم در عین مستی(@)(@@) 142 بیانم کن که اصل واصلانی %~% مرا برگوی این راز نهانی PageV01P034(@)(@@) 1 جوابش داد کای پیر پراسرار %~% چه جوهرها فشاندستی ز گفتار(@)(@@) 2 ترا زیبد که گوهر میفشانی %~% که راز من در اینجا می تو دانی(@)(@@) 3 گواه من توئی اینجا حقیقت %~% سپردستی یقین راه شریعت(@)(@@) 4 میان این همه تو بینظیری %~% که همدانائی و با عشق پیری(@)(@@) 5 زپیری راه دانستی در اسرار %~% ترا پیدابود اعیان ز گفتار(@)(@@) 6 توئی ره برده در اسرار معنی %~% توئی هم نقطه و پرگار معنی(@)(@@) 7 توئی دریافته اسرار یارا %~% توئی بشناخته سر خدا را(@)(@@) 8 توئی این دم زده در دید کشتی %~% درین اسرار ما واقف تو گشتی(@)(@@) 9 توئی دریافته معنای باطن %~% ز دید شرع و در تقوای باطن(@)(@@) 10 تو داری و تو گفتی آنچه دیدست %~% یقین جان تو این معنی شنیدست(@)(@@) 11 مرا تو دید جانی در هدایت %~% که داری ره عیان سوی سعادت(@)(@@) 12 زهی دریافته اسرار معنی %~% تو کردستی عیان اسرار معنی(@)(@@) 13 عیانست این 
ms115	 بیان و مگذر از او %~% که جز جانان نباشد هیچ نیکو(@)(@@) 14 ز جانان هرچه جوئی آن بیابی %~% که این دم در میان غرق آبی(@)(@@) 15 ز دید واصلان ما را نظر کن %~% همه جان مرا سمع و بصر کن(@)(@@) 16 مرا اندر میانه با تو کارست %~% که گر معنی بیابم بیشمارست(@)(@@) 17 منم منصور با من راست گفتی %~% در اسرار ربانی تو سفتی(@)(@@) 18 منم منصور اینجا رخ نموده %~% گره از کار عالم برگشوده(@)(@@) 19 مرا این ابتدای واصلانست %~% که ذاتم با همه ذرات پیوست(@)(@@) 20 نمود عشق دارم این زمان من %~% شده مخفی بر خلق جهان من(@)(@@) 21 سفر کرده منم در ابتدایش %~% عیان دیدم جمال انتهایش(@)(@@) 22 ز بود خود سفر در خویش کردم %~% نمود عشق را در پیش کردم(@)(@@) 23 ولی در معنوی و هم بصورت %~% کنون افتاد کارم را ضرورت(@)(@@) 24 از این پس در سفر چالاک خواهم %~% ز جمله من نمود پاک خواهم(@)(@@) 25 پدر آورد امروزم چنین بین %~% در این دریا مرا عین الیقین بین(@)(@@) 26 مرا اینست اول راه صورت %~% که بگرفتم من از کل تو نورت(@)(@@) 27 مرا بنمودهاند این راز اینجا %~% که دیدم غایت آغاز اینجا(@)(@@) 28 کنون در عین دریایی چنینم %~% که درحق اولین و آخرینم(@)(@@) 29 دراین دریا بسی نایاب گفتم %~% در اسرار حق را من بسفتم(@)(@@) 30 بسر مردی بزرگست از نمودار %~% ولی ما را نداند یمن اسرار(@)(@@) 31 ترا این بکر معنی دست دادست %~% که حق در دیده جانت نهادست(@)(@@) 32 تو داری زین میان معنی تو داری %~% حقیقت دید این تقوی تو داری(@)(@@) 33 مرا در عین دریا هست اسرار %~% اگر اینجا درافزایم به گفتار(@)(@@) 34 کجا حاصل کنم من دیدن دوست %~% که مغز آمد مرا این صورت و پوست(@)(@@) 35 ایا سالک بیان راز بشنو %~% نمود شاه از شهباز بشنو(@)(@@) 36 مرا بنمودهاند اسرار باقی %~% مئی در دادم اینجا باده ساقی(@)(@@) 37 مئی خوردم 
