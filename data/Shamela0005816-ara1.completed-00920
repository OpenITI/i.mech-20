ms901	 نوفل يروي عن عبيد الله بن مقسم روى عنه أبو القاسم بن أبي الزناد(@)(@@)(@@)(@@) $ 6665 - إسحاق بن يسار مولى قيس بن مخرمة القرشي المدني يروي عن عبيد الله بن عبد الله وعبد الله بن الحارث روى عنه ابنه محمد بن إسحاق(@)(@@)(@@)(@@) $ 6666 - إسحاق بن سليمان بن أبي سليمان الشيباني من أهل الكوفة وهو الذي يقال له إسحاق بن أبي إسحاق يروي عن أبيه روى عنه عقبة بن المغيرة والمسعودي(@)(@@)(@@)(@@) $ 6667 - إسحاق بن عبيد الله المدني يروى عن بن أبي مليكة روى عنه الوليد بن مسلم(@)(@@)(@@)(@@) $ 6668 - إسحاق بن سعيد بن عمرو بن سعيد بن العاص الأموي PageV06P048 من أهل مكة يروي عن أبيه عن بن عمر وأبي هريرة روى عنه أبو نعيم وأبو الوليد الطيالسي(@)(@@)(@@)(@@) $ 6669 - إسحاق بن عثمان مصري يروي عن إسماعيل بن عبد الرحمن بن عطية عن جدته أم عطية روى عنه أبو الوليد الطيالسي(@)(@@)(@@)(@@) $ 6670 - إسحاق بن يحيى الكلبي من أهل حمص يروي عن الزهري روى عنه يحيى بن صالح الوحاظي(@)(@@)(@@)(@@) $ 6671 - إسحاق بن أبي إسحاق السبيعي من أهل الكوفة يروي عن أبيه روى عنه عقبة بن المغيرة الشيباني(@)(@@)(@@)(@@) $ 6672 - إسحاق بن عمر يروي عن موسى بن وردان روى عنه سعيد بن أبي هلال(@)(@@)(@@)(@@) $ 6673 - إسحاق بن عويمر شيخ يروي المراسيل روى عنه عبد الملك بن جريج PageV06P049(@)(@@)(@@)(@@) $ 6674 - إسحاق بن خالد شيخ يروي عن بن مطيع عن بن عمر روى عنه سعيد بن أبي هلال(@)(@@)(@@)(@@) $ 6675 - إسحاق بن شرقي ويقال بن شرفى مولى آل عمر يروي عن أبي بكر بن عبد الرحمن بن عبد الله بن عمر عن بن عمر روى عنه عبد الواحد بن زياد(@)(@@)(@@)(@@) $ 6676 - إسحاق بن إبراهيم أبو النضر الدمشقي من موالي بني أمية يروي عن عمر بن عبد العزيز روى عنه يحيى بن حمزة(@)(@@)(@@)(@@) $ 6677 - إسحاق بن أسيد كنيته أبو عبد الرحمن أصله من خراسان سكن مصر يروي عن عبد الكريم عن أنس وهو الذي يروي عنه الليث بن سعد ويقول ثنا أبو عبد 
ms902	 الرحمن الخراساني كان يخطىء(@)(@@)(@@)(@@) $ 6678 - إسحاق بن يزيد الهذلي يروي عن عون بن عبد الله روى عنه بن أبي ذئب PageV06P050(@)(@@)(@@)(@@) $ 6679 - إسحاق بن عثمان الكلابي كنيته أبو يعقوب من أهل البصرة يروي عن ميمون أبي عبد الله والحسن روى عنه أبو عاصم وأبو الوليد(@)(@@)(@@)(@@) $ 6680 - إسحاق بن أبي جعفر الفراء كوفي يروي عن أبي إسحاق السبيعي روى عنه سعيد بن سليمان الواسطي وأهل الكوفة(@)(@@)(@@)(@@) $ 6681 - إسحاق أبو الغصن شيخ يروي عن شريح روى عنه يحيي بن سعيد القطان(@)(@@)(@@)(@@) $ 6682 - إسحاق بن راشد الجزري أخو النعمان بن راشد من أهل حران يروي عن الزهري روى عنه موسى بن أعين الجزري(@)(@@)(@@)(@@) $ 6683 - إسحاق بن الوزير أبو يعقوب التيمي من أهل الكوفة يروي عن إسماعيل بن عبد الرحمن السدي روى عنه الكوفيون(@)(@@)(@@)(@@) $ 6684 - إسحاق بن إبراهيم شيخ يروي عن الزهري روى عنه معاوية بن صالح قاضى الأندلس PageV06P051(@)(@@)(@@)(@@) $ 6685 - إسحاق بن يوسف الأزرق أبو محمد الأعمى من أهل واسط يروي عن الأعمش وابن أبي خالد روى عنه أحمد بن حنبل وأهل العراق مات سنة أربع أو خمس وتسعين ومائة(@)(@@)(@@)(@@) $ 6686 - إسحاق بن المستورد يروي عن محمد بن عبد الرحمن بن جارية روى عنه عبد العزيز بن محمد الدراوردي(@)(@@)(@@)(@@) $ 6687 - إسحاق بن محمد بن أبي محمد المزني كنيته أبو عبد الرحمن يروي المراسيل روى عنه عمر بن محمد(@)(@@)(@@)(@@) $ 6688 - إسحاق بن الأزرق يروي عن أبي سالم الجيشاني روى عنه عمرو بن الحارث(@)(@@)(@@)(@@) $ 6689 - إسحاق أبو أيمن شيخ يروي عن أبيه روى عنه حريز بن عثمان الرحبي PageV06P052(@)(@@)(@@)(@@) $ 6690 - أيوب بن موسى بن عمرو بن سعيد بن العاص القرشي الأموي من أهل مكة يروي عن الزهري ونافع روى عنه سفيان الثوري وابن عيينة مات في حبس داود بن علي مع إسماعيل بن أمية(@)(@@)(@@)(@@) $ 6691 - أيوب بن أبي تميمة السختياني كنيته أبو بكر واسم أبي تميمة كيسان مولى لعنزة من أهل البصرة وكان ينزل في بني حريش يروى عن بن سيرين وأبي قلابة وقد قيل إنه سمع من 
ms903	 أنس ولا يصح ذلك عندي لذلك أدخلناه في هذه الطبقة كان مولده قبل الجارف سنة ثمان وستين ومات سنة إحدى أو اثنتين وثلاثين ومائة يوم الجمعة في شهر رمضان سنة الطاعون وهو بن ثلاث وستين سنة وكان الحسن يقول أيوب سيد شباب أهل البصرة ولعمري كان من ساداتها فقها وعلما وفضلا وورعا وكان يحلق رأسه كل سنة مرة فإذا طال عليه فرقه وله عقب بالبصرة(@)(@@)(@@)(@@) $ 6692 - أيوب بن أبي أمامة بن سهل بن حنيف الأنصاري من أهل المدينة يروي المقاطيع والمراسيل روى عنه محمد بن أبي بكر PageV06P053(@)(@@)(@@)(@@) $ 6693 - أيوب بن خالد بن أبي أيوب الأنصاري يروي عن أبيه عن جده أبي أيوب روى عنه إسماعيل بن أمية والوليد بن أبي الوليد وهو الذي يروي عن عبد الله بن رافع مولى أم سلمة عن أبي هريرة(@)(@@)(@@)(@@) $ 6694 - أيوب بن يناق الهذلي يروى عن الحسن وسعيد بن المسيب روى عنه يونس بن الحارث الطائفي وقد قيل إنه سمع من أبي هريرة وليس يصح ذلك عندي(@)(@@)(@@)(@@) $ 6695 - أيوب بن أبي سهلة يروي عن عطاء بن أبي رباح روى عنه حماد بن سلمة(@)(@@)(@@)(@@) $ 6696 - أيوب بن كريز ويقال كريز يروي عن عبد الرحمن بن غنم عن معاذ بن جبل روى عنه سعيد بن مسروق من حديث المبارك بن فضالة عن سعيد بن مسروق(@)(@@)(@@)(@@) $ 6697 - أيوب بن وهب بن منبه الصنعاني يروي عن أبيه قوله روى PageV06P054 عنه يوسف بن زكريا الصنعاني قاله زيد بن المبارك عن يوسف بن زكريا عن أيوب بن وهب عن وهب في قوله تعالى وقالوا الحمد لله الذي اذهب عنا الحزن قال حزن الموقف(@)(@@)(@@)(@@) $ 6698 - أيوب بن صفوان مولى عبد الله بن الحارث بن نوفل يروي عن عبد الله بن الحارث بن نوفل روى عنه سعيد بن أبي عروبة(@)(@@)(@@)(@@) $ 6699 - أيوب بن أبي حسين المدني يروي عن أبي نهيك روى عنه يحيى بن واضح أبو تميلة(@)(@@)(@@)(@@) $ 6700 - أيوب بن سعد يروي عن هشام بن عروة وموسى بن عقبة روى عنه عبد 
ms904	 الله بن وهب(@)(@@)(@@)(@@) $ 6701 - أيوب بن أبي كثير يروي عن الحسن روى عنه آدم بن الحكم(@)(@@)(@@)(@@) $ 6702 - أيوب بن هانئ يروي عن مسروق بن الأجدع عن بن مسعود PageV06P055 روى عنه بن جريج(@)(@@)(@@)(@@) $ 6703 - أيوب بن بشير بن كعب العدوي من أهل البصرة يروي عن رجل عن أبي ذر روى عنه حماد بن سلمة(@)(@@)(@@)(@@) $ 6704 - أيوب بن أبي العوجاء القرشي يروي عن علباء بن أحمر روى عن مبارك بن مجاهد وأهل مرو وهو الذي يروي عن أبي مجلز في قوله تعالى والمحصنات من النساء قال نساء أهل الكتاب رواه عيسى بن عبيد(@)(@@)(@@)(@@) $ 6705 - أيوب الشامي يروي عن القاسم أبي عبد الرحمن روى عنه زيد بن أبي أنيسة(@)(@@)(@@)(@@) $ 6706 - أيوب بن عبد الله الهمداني يروي عن الشعبي روى عنه عمر بن بشير(@)(@@)(@@)(@@) $ 6707 - أيوب بن سرجس يروي عن الحسن وعكرمة روى عنه محمد بن سليم PageV06P056(@)(@@)(@@)(@@) $ 6708 - أيوب بن نجيح النجراني يروي عن سعيد بن جبير روى عنه مروان بن معاوية الفزاري(@)(@@)(@@)(@@) $ 6709 - أيوب بن عبد الرحمن شيخ يروي عن مالك بن أوس بن الحدثان روى عنه أبو مراية العجلي حدثنا بن قتيبة قال ثنا بن أبي السري قال ثنا معتمر حدثني أبي عن أسلم عن أبي مراية عن أيوب بن عبد الرحمن عن مالك بن أوس بن حدثان قال سمعت علي بن أبي طالب يقول الشاب الذيال أمير المصرين يلبس فروتها ويأكل خضرتها ويقتل أشراف أهلها قال أبو المعتمر أظنه الحجاج(@)(@@)(@@)(@@) $ 6710 - أيوب بن مرثد يروي عن امرأة عن عائشة روى عنه منصور بن المعتمر(@)(@@)(@@)(@@) $ 6711 - أيوب بن عبد الرحمن بن صعصعة الأنصاري بن أخى مالك PageV06P057 بن صعصعة من أهل المدينة يروي عن يعقوب بن أبي يعقوب عن أبي هريرة روى عنه فليح بن سليمان(@)(@@)(@@)(@@) $ 6712 - أيوب بن زياد أبو زيد الحمصي يروي عن جبير بن نفير وعبادة بن الوليد روى عنه معاوية بن صالح ويزيد بن سنان(@)(@@)(@@)(@@) $ 6713 - أيوب بن زيد القرشي يروي عن جابر بن زيد روى عنه المنذر بن 
ms905	 ثعلبة(@)(@@)(@@)(@@) $ 6714 - أيوب بن بشير شامي يروي عن شفى بن ماتع روى عنه ثعلبة بن مسلم(@)(@@)(@@)(@@) $ 6715 - أيوب بن حبيب الزهري مولى سعد بن أبي وقاص من أهل المدينة يروي عن أبي المثنى الجهني عن أبي هريرة روى عنه مالك بن أنس وفليح بن سليمان PageV06P058(@)(@@)(@@)(@@) $ 6716 - أيوب بن تميم القارىء من أهل الشام يروي عن يحيى بن الحارث الذماري روى عنه عبد الله بن ذكوان الدمشقي(@)(@@)(@@)(@@) $ 6717 - أيوب بن دينار يروي عن أبيه عن علي من أهل الكوفة كنيته أبو سليمان وكان مكتبا روى عنه حفص بن غياث(@)(@@)(@@)(@@) $ 6718 - أيوب بن عائذ بن مدلج الطائي يروي عن الشعبي وقيس بن مسلم روى عنه عبد الواحد بن زياد وابن عيينة وكان مرجيا يخطىء(@)(@@)(@@)(@@) $ 6719 - أيوب بن أبي العالية يروي عن جماعة من التابعين روى عنه أهل مصر كنيته أبو قنان(@)(@@)(@@)(@@) $ 6720 - أيوب بن مخراق يروي عن عكرمة وسعيد بن جبير المقاطيع روى عنه أهل العراق PageV06P059(@)(@@)(@@)(@@) $ 6721 - أيوب بن سلمة المخزومي كنيته أبو سلمة من أهل المدينة يروي عن عامر بن سعد بن أبي وقاص روى عنه عمر بن عثمان المدني(@)(@@)(@@)(@@) $ 6722 - أيوب بن أبي هند يروي عن الحجازيين روى عنه عبيد الله بن عبد الله بن موهب(@)(@@)(@@)(@@) $ 6723 - أيوب الأنصاري يروي عن سعيد بن جبير روى عنه مهدي بن ميمون لا أدري من هو ولا بن من هو(@)(@@)(@@)(@@) $ 6724 - أيوب بن مسكين أبو العلاء القصاب من أهل واسط وهو الذي يقال له أيوب بن أبي مسكين يروي عن قتادة روى عنه يزيد بن هارون مات سنة أربع وأربعين ومائة كان يخطىء(@)(@@)(@@)(@@) $ 6725 - أيوب بن ثابت المكي مولى لبني شيبة يروي عن عطاء وخالد بن كيسان وصفية بنت بحره روى عنه أبو سعيد مولى بني هاشم وأبو عامر العقدي وأبو حذيفة(@)(@@)(@@)(@@) $ 6726 - أيوب بن وائل يروي عن نافع روى عنه حماد بن زيد PageV06P060 وأبو هلال الراسبي ومرجى بن وداع الراسبي وكان من عباد أهل البصرة وكان مجاب الدعوة(@)(@@)(@@)(@@) $ 6727 - أيوب بن سليمان 
ms906	 بن ميناء يروي المقاطيع روى عنه عبد الله بن نافع الصائغ(@)(@@)(@@)(@@) $ 6728 - أيوب بن نهيك من أهل حلب يروي عن عطاء والشعبي روى عنه مبشر بن إسماعيل الحلبي يخطىء وكان مولى سعد بن أبي وقاص يعتبر بحديثه من غير رواية أبي قتادة الحراني عنه(@)(@@)(@@)(@@) $ 6729 - أيوب بن صالح يروي عن عمر بن عبد العزيز روى عنه داود بن عبد الرحمن العطار(@)(@@)(@@)(@@) $ 6730 - أيوب بن شرحبيل الأصبحي عامل عمر بن عبد العزيز روى عن عمر بن عبد العزيز روى عنه الشاميون PageV06P061(@)(@@)(@@)(@@) $ 6731 - أشعث بن عبد الملك الحمراني مولى حمران بن أبان من أهل البصرة كنيته أبو هانئ يروي عن الحسن وابن سيرين وكان فقيها متقنا روى عنه معاذ بن معاذ العنبري البصري وأهل البصرة مات سنة ست وأربعين ومائة وكان يحيى بن سعيد القطان يقول ما رأيت أحدا يحدث عن الحسن أثبت من أشعث الحمراني وإنما قيل له الحمراني لأنه كان مولى لحمران بن أبان(@)(@@)(@@)(@@) $ 6732 - أشعث بن أبي الشعثاء المحاربي من أهل الكوفة واسم أبي الشعثاء سليم بن أسود يروي عن أبيه وأبوه سمع من بن عمر روى عنه الثوري وشعبة مات سنة خمس وعشرين ومائة(@)(@@)(@@)(@@) $ 6733 - أشعث بن جابر الحداني من أهل البصرة كنيته أبو عبد الله وكان مكفوفا يروي عن الحسن وشهر بن حوشب روى عنه نوح بن قيس الطاحي(@)(@@)(@@)(@@) $ 6734 - أشعث بن إسحاق بن سعد بن أبي وقاص القرشي من أهل المدينة PageV06P062 يروي عن عمه عامر بن سعد روى عنه عبد الرحمن بن هرمز الأعرج(@)(@@)(@@)(@@) $ 6735 - أشعث بن أسلم العجلي البصري يروي عن أبيه عن أبي موسى روى عنه سعيد بن أبي عروبة(@)(@@)(@@)(@@) $ 6736 - أشعث بن عبد الرحمن الجرمي من أهل البصرة يروي عن أبي قلابة وأبيه روى عنه حماد بن سلمة(@)(@@)(@@)(@@) $ 6737 - أشعث بن حسان الخراساني مولى بني أسد من أهل مرو يروي عن عبد الله بن بريدة روى عنه بن المبارك والمغيرة بن مسلم كنيته أبو عتبة(@)(@@)(@@)(@@) $ 6738 - أشعث بن يزيد الشامي من أهل دمشق 
ms907	 يروي عن أبي سلام الأعرج عن علي روى عنه القاسم بن مالك المزني(@)(@@)(@@)(@@) $ 6739 - أشعث بن عبد الله شيخ من أهل البصرة يروي عن أم بكر بنت PageV06P063 عبد الله الجهضمية عن عائشة روى عنه موسى بن إسماعيل التبوذكي(@)(@@)(@@)(@@) $ 6740 - أشعث بن عمر التميمي من أهل البصرة يروي عن عمر بن عبد العزيز روى عنه عبيس بن بيهس(@)(@@)(@@)(@@) $ 6741 - إياس بن قتادة العبشمي بن أخت الأحنف بن قيس من أهل البصرة وكان على قضا الري يروي عن قيس بن عباد مات في أيام مصعب بن الزبير وقتل مصعب سنة إحدى وسبعين(@)(@@)(@@)(@@) $ 6742 - إياس بن معاوية بن قرة بن إياس المزني كنيته أبو واثلة من أهل البصرة وكان على القضاء بها يروي عن سعيد بن المسيب وأبيه روى عنه شعبة ومحمد بن عجلان وكان من دهاة الناس PageV06P064 مات سنة اثنتين وعشرين ومائة وله عقب بالبصرة(@)(@@)(@@)(@@) $ 6743 - إياس بن دغفل البصري كنيته أبو دغفل يروي عن الحسن وعطاء روى عنه وكيع بن الجراح حدثنا بن قتيبة بعسقلان قال ثنا بن أبي السري قال ثنا معتمر بن سليمان قال ثنا إياس بن دغفل قال سألت عطاء بن أبي الرباح عن الرجل يركب إلى واسط في السفينة قال صاحب السفينة مطمئن وإنما هي رخصة من شاء صام ومن شاء أفطر ومن شاء أتم ومن شاء قصر(@)(@@)(@@)(@@) $ 6744 - إياس بن نذير الضبي من أهل الكوفة يروي عن شبرمة بن الطفيل عن علي روى عنه أبو حيان التميمي(@)(@@)(@@)(@@) $ 6745 - إياس بن جويرية أبو هنيدة يروي عن أبي ماوية عن بن عباس واسم أبي ماوية مالك بن حريث روى عنه أهل العراق(@)(@@)(@@)(@@) $ 6746 - إياس بن خارجة يروي عن سعيد بن المسيب روى عنه يزيد بن أبي حبيب(@)(@@)(@@)(@@) $ 6747 - إياس بن جعفر شيخ يروي المراسيل روى عنه أبو عمرو بن العلاء PageV06P065(@)(@@)(@@)(@@) $ 6748 - إياس بن عباس شيخ يروي المقاطيع روى عنه الأعمش(@)(@@)(@@)(@@) $ 6749 - الأسود بن عبد الرحمن العدوي يروي عن هصان بن كاهن عن أبي موسى الأشعري روى عنه الحسن 
ms908	 بن دينار يعتبر بحديثه من غير رواية الحسن بن دينار عنه والحسن بن دينار هو الحسن بن واصل(@)(@@)(@@)(@@) $ 6750 - الأسود بن قيس يروي عن نبيح العنزي عن جابر روى عنه شعبة بن الحجاج(@)(@@)(@@)(@@) $ 6751 - الأسود بن مسعود العنزي يروي عن حنظلة بن خويلد روى عنه العوام بن حوشب(@)(@@)(@@)(@@) $ 6752 - الأسود بن العلاء بن جارية الثقفي يروي عن أبي سلمة بن عبد الرحمن روى عنه بن أبي ذئب(@)(@@)(@@)(@@) $ 6753 - الأسود بن أبي الأسود أخو منصور بن أبي الأسود من أهل الكوفة يروي عن عطية العوفي روى عنه أخوه منصور بن أبي الأسود PageV06P066(@)(@@)(@@)(@@) $ 6754 - الأسود شيخ كان يشترى حوائج عمر بن عبد العزيز روى عنه أبو عاصم(@)(@@)(@@)(@@) $ 6755 - أبان بن صالح بن عمير من أهل الكوفة أبو محمد يروي عن مجاهد ونافع أصله من المدينة ولكنه سكن الكوفة روى عنه بن إسحاق والحارث بن يعقوب يعتبر بحديثه من غير رواية درست بن زياد وأضرابه من الضعفاء عنه(@)(@@)(@@)(@@) $ 6756 - أبان بن تغلب بن رياح القاري الربعي من أهل الكوفة روى عن أبي إسحاق السبيعي والحكم روى عنه شعبة بن الحجاج وحماد بن زيد مات سنة إحدى وأربعين ومائة ولأبان بن تغلب أخ يقال له نوح بن تغلب بن رياح يروي عن الأعمش(@)(@@)(@@)(@@) $ 6757 - أبان بن صمعة البصري الأنصاري والد عتبة الغلام المتعبد يروي عن عكرمة وابن سيرين روى عنه وكيع بن الجراح وأبو عاصم النبيل مات سنة ثلاث وخمسين ومائة PageV06P067(@)(@@)(@@)(@@) $ 6758 - أبان بن الوليد يروي عن الشعبي روى عنه مالك بن مغول(@)(@@)(@@)(@@) $ 6759 - أبان بن يزيد العطار من أهل البصرة كنيته أبو يزيد يروي عن قتادة وعمرو بن دينار روى عنه عفان وأهل العراق(@)(@@)(@@)(@@) $ 6760 - أبان أبو مسعر الصريمي يروي عن الحسن روى عنه المعتمر بن سليمان(@)(@@)(@@)(@@) $ 6761 - أبان بن كثير المكتب يروي عن أبي هاشم الرماني وقد سمع من بن أبي خالد روى عنه خلف بن خليفة(@)(@@)(@@)(@@) $ 6762 - أبان بن خالد أبو بكر السعدي من أهل البصرة يروي عن عبيد الله بن 
ms909	 رواحة عن أنس روى عنه التبوذكي(@)(@@)(@@)(@@) $ 6763 - أبان بن عمران الطحان من أهل واسط كنيته أبو محمد يروي عن العراقيين روى عنه ابنه عمران بن أبان مات سنة ثلاث وسبعين ومائة(@)(@@)(@@)(@@) $ 6764 - الأزهر بن راشد الكندي يروي عن سليم بن عامر وأبي أمامة روى عنه إسماعيل بن عياش PageV06P068(@)(@@)(@@)(@@) $ 6765 - الأزهر شيخ من أهل الكوفة يروي عن محارب بن دثار روى عنه سفيان الثوري(@)(@@)(@@)(@@) $ 6766 - الأزهر أبو معبد جار إبراهيم النخعي يروي عن إبراهيم النخعي روى عنه يزيد بن كيسان(@)(@@)(@@)(@@) $ 6767 - الأزهر شيخ يروي عن أنيسة روى عنه ثابت بن زيد(@)(@@)(@@)(@@) $ 6768 - الأزهر السمان هو بن سعد من أهل البصرة كنيته أبو بكر يروى عن حميد الطويل ولد سنة إحدى عشرة ومائة ومات في شوال سنة ثلاث ومائتين وقد قيل سنة سبع ومائتين روى عنه أهل العراق(@)(@@)(@@)(@@) $ 6769 - أمية بن عبد الله بن عمرو بن عثمان بن عفان يروي عن أبيه وعكرمة روى عنه بن إسحاق ويحيى بن سليم(@)(@@)(@@)(@@) $ 6770 - أمية بن محمد بن عبد الله بن مطيع القرشي الحجازي PageV06P069 العدوي يروي عن أبيه وعكرمة روى عنه العطاف بن خالد(@)(@@)(@@)(@@) $ 6771 - أمية بن عمرو بن سعيد بن العاص القرشي الأموي من أهل مكة أخو سعيد وموسى ومحمد بن سعيد بن العاص يروي عن الحجازيين روى عنه أهل بلده(@)(@@)(@@)(@@) $ 6772 - أمية بن هند بن سهل بن حنيف يروي عن عبد الله بن عامر بن ربيعة روى عنه عبد الله بن عيسى إن كان سمع من عبد الله بن عامر(@)(@@)(@@)(@@) $ 6773 - أمية بن مسلم يروي عن أمه عن عائشة روى شعبة عن خالد الحذاء عنه(@)(@@)(@@)(@@) $ 6774 - أمية الأزدي شيخ يروي عن جابر بن زيد روى عنه حسان بن إبراهيم الكرماني(@)(@@)(@@)(@@) $ 6775 - أمية بن يزيد القرشي من أهل الشام وهو الذي يقال له أمية بن أبي عثمان يروي عن أبي المصبح المقرأى عن ثوبان روى عنه PageV06P070 أيوب بن سويد قتله صالح بن علي أو عبد الله بن علي(@)(@@)(@@)(@@) $ 6776 - أمية القرشي شيخ يروي عن 
ms910	 مكحول لست أدري من هو روى عنه بن المبارك(@)(@@)(@@)(@@) $ 6777 - أسيد بن أبي أسيد البراد من أهل المدينة يروي عن عبد الله بن أبي قتادة روى عنه بن أبي ذئب وسليمان بن بلال حدثنا إبراهيم بن خزيم بخرتنك قال ثنا عبد بن حميد قال ثنا عبد الملك بن عمرو قال ثنا زهير بن محمد عن أسيد بن أبي أسيد عن عبد الله بن أبي قتادة عن جابر بن عبد الله أن النبي صلى الله عليه وسلم الله عليه وآله وسلم قال من ترك الجمعة ثلاث مرات من غير عذر طبع الله على قلبه(@)(@@)(@@)(@@) $ 6778 - أسيد بن رافع الأنصاري من أهل المدينة يروى عن الحجازيين PageV06P071 روى عنه بكير بن عبد الله بن الأشج(@)(@@)(@@)(@@) $ 6779 - أسيد بن شبرمة المازني يروي عن سالم بن عبد الله عن بن عمر عن النبي صلى الله عليه وسلم قال الذي تفوته صلاة العصر فكأنما وتر أهله وماله حدثنا مكحول قال ثنا محمد بن غالب الأنطاكي قال ثنا حسين بن عباس قال ثنا زهير بن معاوية قال ثنا أسيد بن شبرمة المازني قال سمعت سالم بن عبد الله(@)(@@)(@@)(@@) $ 6780 - أسيد بن عبد الرحمن الخثعمي من أهل فلسطين يروى عن بن محيريز وفروة بن مجاهد وخالد بن دريك روى عنه الأوزاعي وأهل الشام مات سنة أربع وأربعين ومائة(@)(@@)(@@)(@@) $ 6781 - أسيد بن طارق يروي عن أمه عمرة عن عائشة عداده في أهل البصرة روى عنه عمران بن أبي الجارود(@)(@@)(@@)(@@) $ 6782 - أسيد بن علي بن عبيد مولى أبي أسيد الساعدي من أهل المدينة PageV06P072 يروي عن أبيه عن أبي أسيد روى عنه موسى بن يعقوب الزمعي وعبد الرحمن بن سليمان الغسيل(@)(@@)(@@)(@@) $ 6783 - أوس بن ثابت الأنصاري يروي عن حكيم بن عقال القرشي عن علي روى عنه شعبة وعبد الوارث بن سعيد التنوري(@)(@@)(@@)(@@) $ 6784 - أوس بن عبد الله السلولي من أهل البصرة يروي عن عمه بريد بن أبي مريم روى عنه مسلم بن إبراهيم كلما كان من رواية العراقيين فهو بريد بن 
ms911	 أبي مريم وكلما كان من رواية الشاميين فهو يزيد بن أبي مريم وهما اثنان(@)(@@)(@@)(@@) $ 6785 - أسامة بن محمد بن أسامة بن زيد بن حارثة بن شراحيل بن عبد العزى مولى رسول الله صلى الله عليه وسلم يروي عن أبيه عن جده أسامة روى عنه محمد بن إسحاق PageV06P073(@)(@@)(@@)(@@) $ 6786 - أسامة بن زيد مولى الليثيين من أهل المدينة يروي عن الزهري ونافع روى عنه الثوري وابن المبارك يخطىء كان يحيى القطان يسكت عنه مات سنة ثلاث وخمسين ومائة وكان له يوم مات بضع وسبعون سنة(@)(@@)(@@)(@@) $ 6787 - أسامة بن أبي عطاء يروي عن رجل عن على روى عنه عبيدة بن الأسود(@)(@@)(@@)(@@) $ 6788 - أسامة جار لشعبة يروي عن شهاب بن عباد عن بن عباس روى عنه شعبة(@)(@@)(@@)(@@) $ 6789 - أسلم يروي عن بشر بن شغاف عن عبد الله روى عنه سليمان التيمي(@)(@@)(@@)(@@) $ 6790 - أسلم المنقري من أهل الكوفة يروي عن سعيد بن جبير وعطاء روى عنه سفيان الثوري مات سنة اثنتين وأربعين ومائة(@)(@@)(@@)(@@) $ 6791 - الأحنف يروي عن عبد الله بن بشر الهلالي عن عبد الله بن PageV06P074 مسعود إنه كان لا يرى بأسا أن يتطوع مكانه روى عنه ابنه الفرات بن أحنف(@)(@@)(@@)(@@) $ 6792 - الأحنف مولى آل أبي المعلى يروي عن عروة بن الزبير روى الجعيد بن عبد الرحمن عن رجل عنه(@)(@@)(@@)(@@) $ 6793 - أنس بن أبي آنس واسم أبي أنس مالك بن أبي عامر الأصبحي حليف عثمان بن عبيد الله القرشي التيمي من أهل المدينة يروي عن أبيه روى عنه ابنه مالك بن أنس وهو الذي يروي الزهري عنه فقال حدثنا أنس بن أبي أنس عن أبيه عن أبي هريرة في فضل رمضان(@)(@@)(@@)(@@) $ 6794 - أنس بن سعد المرادي من أهل الكوفة يروي عن سعيد بن جبير روى عنه بن عيينة(@)(@@)(@@)(@@) $ 6795 - أنس بن عبيد يروي عن الحسن يروي عنه محمد بن حمران(@)(@@)(@@)(@@) $ 6796 - أنس أبو القاسم شيخ يروي عن عبد الرحمن بن الأسود روى عنه سهل بن حماد PageV06P075(@)(@@)(@@)(@@) $ 6797 - أنس بن عبد الحميد الضبي أخو جرير بن 
ms912	 عبد الحميد يروي عن هشام بن عروة عن أبيه عن عائشة قالت قال رسول الله صلى الله عليه وسلم ما افتقر بيت فيه خل حدثنا الحسن بن سفيان قال ثنا أحمد بن عبد الله بن حكيم قال ثنا أنس بن عبد الحميد أخو جرير بن عبد الحميد ثنا هشام بن عروة(@)(@@)(@@)(@@) $ 6798 - أنس بن عياض الليثي أبو ضمرة من أهل المدينة يروي عن ربيعة بن أبي عبد الرحمن وشريك بن أبي نمر روى عنه العراقيون وأهل بلده ولد سنة أربع ومائة ومات سنة ثمانين ومائة وقد وهم من زعم أنه أخو يزيد بن عياض بن جعدبه هما جميعا من بني ليث من أهل المدينة وليس بينهما قرابة إلا القبيلة لأنها تجمعهما لا الأبوة(@)(@@)(@@)(@@) $ 6799 - أبي بن أبي عبيد الكندي يروى عن نوف البكالي PageV06P076 روى عنه صفوان بن عمرو السكسكي(@)(@@)(@@)(@@) $ 6800 - أبي بن عبد الله النخعي يروي عن الحجازيين روى عنه حفص بن غياث(@)(@@)(@@)(@@) $ 6801 - أصبغ بن علقمة بن علي بن علقمة بن شريك بن الحارث بن عاصم بن عبيد بن ثعلبة بن يربوع بن حنظلة الحنظلي اليربوعي من أهل مرو وكنيته أبو المقدام يروي عن سعيد بن المسيب وعكرمة روى عنه بن المبارك وعيسى بن موسى غنجار(@)(@@)(@@)(@@) $ 6802 - إدريس بن سنان بن بنت وهب بن منبه يروي عن جده وهب بن منبه روى عنه أبو بكر بن عياش وابنه عبد المنعم يتقى حديثه من رواية ابنه عبد المنعم عنه(@)(@@)(@@)(@@) $ 6803 - إدريس بن أبي إدريس الخولاني يروي عن أبيه عداده في أهل الشام PageV06P077 روى عنه يحيى بن الحارث الذماري وعبد الرحمن بن يزيد بن جابر حدثنا الحسن بن سفيان قال ثنا حبان بن موسى قال ثنا عبد الله قال ثنا عبد الرحمن بن يزيد بن جابر قال حدثني إدريس بن أبي إدريس الخولاني عن أبيه قال ليعقبن الله الذين يمشون إلى المساجد في الظلم نورا تاما يوم القيامة(@)(@@)(@@)(@@) $ 6804 - إدريس شيخ يروي عن الحسن روى عنه جرير بن عبد الحميد الضبي 
ms913	(@)(@@)(@@)(@@) $ 6805 - إدريس بن يزيد بن عبد الرحمن الأودي الزعافري من أهل الكوفة والد عبد الله بن إدريس يروي عن أبيه عن أبي هريرة روى عنه ابنه عبد الله بن إدريس وهو أخو داود الأودي(@)(@@)(@@)(@@) $ 6806 - إدريس بن صبيح الأودي يروي عن سعيد بن المسيب روى هشام بن عمار عن حماد بن عبد الرحمن عنه يغرب ويخطىء على قلته PageV06P078(@)(@@)(@@)(@@) $ 6807 - إدريس بن محمد بن يونس بن محمد بن فضالة الظفري الأنصاري يروي عن جده عن أبيه وله صحبة روى عنه يعقوب بن محمد الزهري(@)(@@)(@@)(@@) $ 6808 - إدريس شيخ يروي عن أبي الحنفية روى عنه عبد العزيز بن رفيع(@)(@@)(@@)(@@) $ 6809 - إسرائيل بن موسى أبو موسى شيخ من أهل البصرة كان يسافر إلى الهند يروي عن الحسن روى عنه سفيان بن عيينة(@)(@@)(@@)(@@) $ 6810 - إسرائيل بن يونس بن أبي إسحاق السبيعي الهمداني من أهل الكوفة أخو عيسى بن يونس يروي عن أبي إسحاق وسماك يروي عنه أهل العراق ولد سنة مائة ومات سنة ستين ومائة وقد قيل سنة اثنتين وستين ومائة كنيته أبو يوسف سمعت بن خزيمة يقول سمعت الدورقي يقول سمعت بن مهدي يقول قال عيسى بن يونس قال إسرائيل كنت أحفظ حديث يونس بن أبي إسحاق كما أحفظ السورة من القرآن PageV06P079(@)(@@)(@@)(@@) $ 6811 - الأعشى بن عبد الرحمن بن مكمل يروي عن الأزهر بن عبد الله عن عبادة بن الصامت وعثمان بن عفان روى عنه شريك بن أبي نمر(@)(@@)(@@)(@@) $ 6812 - آدم بن سليمان مولى خالد بن خالد والد يحيى بن آدم من أهل الكوفة يروي عن سعيد بن جبير روى عنه الثوري ويونس بن أبي إسحاق(@)(@@)(@@)(@@) $ 6813 - آدم بن الزبرقان أبو شيبة الكوفي يروي عن الشعبي روى عنه سعيد بن أبي أيوب(@)(@@)(@@)(@@) $ 6814 - آدم أبو الجهم صاحب الكرابيس من أهل البصرة يروي عن هشام بن زياد بن مطر عن بن عمر روى عنه موسى بن إسماعيل(@)(@@)(@@)(@@) $ 6815 - أشرس بن أبي الأشرس يروي عن معاوية بن قرة عداده في أهل البصرة روى عنه الثوري(@)(@@)(@@)(@@) $ 6816 - أشرس 
ms914	 بن صهيب مولى سعيد بن العاص يروي عن يحيى بن سعيد PageV06P080 بن العاص وسالم بن عبد الله روى عنه أبو نعيم الفضل بن دكين(@)(@@)(@@)(@@) $ 6817 - أشرس أبو شيبان من أهل البصرة يروي عن الحسن وثابت روى عنه يزيد بن هارون والتبوذكي وعبيد الله بن موسى(@)(@@)(@@)(@@) $ 6818 - أشرس بن الحسن المازني يروي عن يزيد الرقاشي روى عنه بن المبارك(@)(@@)(@@)(@@) $ 6819 - أشرس بن كيسان الأسدي يروى عن مجاهد عن بن عمر أن رسول الله صلى الله عليه وسلم قال في حجة الوداع لا ترجعوا بعدي كفارا يضرب بعضكم رقاب بعض حدثنا الحسن بن سفيان ثنا أحمد بن سيار ثنا عبدان عن أبي حمزة عن أشرس بن كيسان(@)(@@)(@@)(@@) $ 6820 - أنيس بن أبي يحيى مولى أسلم ويقال مولى خزاعة أخو محمد وعبد الله كنيته أبو يونس يروي عن أبيه عن أبي سعيد الخدري روى عنه يحيى بن سعيد القطان والدراوردي مات سنة أربع وأربعين ومائة وهو عم إبراهيم بن أبي يحيى الأسلمي وقيل مات سنة ست وأربعين ومائة(@)(@@)(@@)(@@) $ 6821 - أنيس أبو العريان يروي عن الحسن بن محمد بن على روى PageV06P081 عنه خالد الحذاء(@)(@@)(@@)(@@) $ 6822 - أنيس بن خالد يروي عن محارب بن دثار والمسيب بن رافع روى عنه زيد بن حباب(@)(@@)(@@)(@@) $ 6823 - أنيس بن سوار الجرمي يروي عن أبيه عن مالك بن الحويرث روى عنه أبو بكر بن أبي الأسود عبد الله بن محمد بن حميد بن الأسود حدثنا عبد الله بن محمد بن مرة بالبصرة ثنا نصر بن علي الجهضمي قال ثنا أنيس بن سوار الجرمي ثنا سليمان التيمي عن أبي عثمان النهدي عن أسامة بن زيد قال قال رسول الله صلى الله عليه وسلم ما تركت بعدي فتنة أضر على الرجال من النساء(@)(@@)(@@)(@@) $ 6824 - أعين بن عبد الله العقيلي يروي عن الحسن وأبي المليح روى عنه أمية بن خالد والتبوذكي PageV06P082(@)(@@)(@@)(@@) $ 6825 - أعين أبو عبد الله الحناط يروي عن مالك بن دينار روى عنه حبان بن هلال وهو الذي يخطىء داود بن المحبر حيث 
ms915	 روى عنه فقال أعين أبو حفص الخياط وهو حناط لا خياط(@)(@@)(@@)(@@) $ 6826 - أسماء بن عبيد بن مخراق الضبعي من أهل البصرة كنيته أبو المفضل يروي عن الشعبي روى عنه ابنه جويرية بن أسماء مات سنة إحدى وأربعين ومائة وكان مكفوفا(@)(@@)(@@)(@@) $ 6827 - أفلح بن حميد بن نافع مولى صفوان بن أوس النجاري الأنصاري من أهل المدينة يروي عن القاسم بن محمد روى عنه وكيع وأبو نعيم وكان مكفوفا مات سنة ستين ومائة وهو بن ثمانين سنة وقيل مات سنة ثمان وخمسين ومائة(@)(@@)(@@)(@@) $ 6828 - الأغر بن الصباح المنقري مولى آل قيس بن عاصم PageV06P083 من أهل البصرة يروي عن خليفة بن حصين روى عنه الثوري(@)(@@)(@@)(@@) $ 6829 - أسهب الضبعي يروي عن يزيد بن بشر أو بشر بن يزيد من أهل البصرة روى عنه محمد بن سواء(@)(@@)(@@)(@@) $ 6830 - أويس بن مالك بن أبي عامر الأصبحي حليف بني تيم من قريش يروي عن أبيه وهو عم مالك بن أنس وجد إسماعيل بن أبي أويس لأن إسماعيل بن أبي أويس هو إسماعيل بن عبد الله بن أويس روى عنه مصعب بن محمد(@)(@@)(@@)(@@) $ 6831 - الأزور بن عياض الكعبي من أهل البصرة يروي عن مروح بن سبرة عن عمر روى عنه أبو داود الطيالسي(@)(@@)(@@)(@@) $ 6832 - أمي بن ربيعة الصيرفي كنيته أبو عبد الرحمن من أهل الكوفة يروي عن الشعبي روى عنه بن عيينة PageV06P084(@)(@@)(@@)(@@) $ 6833 - أسباط بن محمد بن عبد الرحمن القرشي مولى لهم كنيته أبو محمد كوفي يروي عن الشيباني ومطرف روى عنه أهل بلده مات سنة مائتين في أولها(@)(@@)(@@)(@@) $ 6834 - أسباط بن نصر الهمداني كنيته أبو نصر من أهل الكوفة يروي عن سماك بن حرب والسدي روى عنه عمرو بن محمد العنقزي وعمرو بن حماد بن طلحة القناد(@)(@@)(@@)(@@) $ 6835 - أرطأة بن المنذر بن الأسود بن ثابت السكوني من أهل الشام كنيته أبو عدي يروي عن عطاء ونافع روى عنه أهل الشام مات سنة ثنتين وستين ومائة حدثنا بن جوصا قال ثنا يوسف بن سعيد بن مسلم قال سمعت 
ms916	 محمد بن كثير يقول ما رأيت أحدا أعبد ولا أزهد ولا الخوف عليه أبين منه على أرطأة بن المنذر ما دخلت عليه إلا ورأيت يديه هكذا على رأسه ووضع يوسف على رأسه يديه(@)(@@)(@@)(@@) $ 6836 - أبيض بن الصباح يروي عن مجاهد روى عنه مروان بن معاوية الفزاري ومن زعم أن هذا الأبيض بن الأغر فقد وهم PageV06P085(@)(@@)(@@)(@@) $ 6837 - أبيض بن أبان يروي عن عطاء وابن الحنفية روى عنه أبو شهاب الحناط(@)(@@)(@@)(@@) $ 6838 - أبيض بن الأغر بن الصباح المنقري يروي عن حميد الطويل روى عنه يحيى بن حسان حدثنا عبد الجبار بن أحمد بتنيس قال ثنا جعفر بن مسافر قال ثنا يحيى بن حسان قال ثنا الأبيض بن الأغر بن الصباح المنقري ثنا حميد الطويل عن أنس قال كان رسول الله صلى الله عليه وسلم يستحب أن يليه المهاجرون والأنصار ليأخذوا عنه(@)(@@)(@@)(@@) $ 6839 - إستبرق مولى آل عمر بن سعد يروي عن سالم بن عبد الله روى عنه محمد بن عبيد الطنافسي(@)(@@)(@@)(@@) $ 6840 - أسد بن عبدة البجلي يروي عن يحيى بن عفيف الكندي PageV06P086 عن أبيه وله صحبة روى عنه سعيد بن خثيم الهلالي(@)(@@)(@@)(@@) $ 6841 - الأسور بن عبد الرحمن يروي عن هصان بن كاهن عن أبي موسى الأشعري روى عنه الحسن بن دينار وقد قيل الأسود بن عبد الرحمن والصواب الأسور بن عبد الرحمن(@)(@@)(@@)(@@) $ 6842 - أسير بن الربيع بن عميلة الفزاري من أهل الكوفة يروي عن أبيه روى عنه شعبة بن الحجاج وقد قيل يسير(@)(@@)(@@)(@@) $ 6843 - أكيل مؤذن إبراهيم النخعي يروي عن الشعبي وإبراهيم روى عنه الزبير بن عدي ومالك بن مغول حدثنا عبد الله بن محمد ثنا أحمد بن حنبل ثنا إسماعيل بن زكريا ثنا مالك بن مغول عن أكيل عن الشعبي قال قال بن عمر الخمر من العنب والمسكر من التمر والبتع من العسل والمزر من الذرة والجعة من الشعير PageV06P087(@)(@@)(@@)(@@) $ 6844 - أوفى بن دلهم العدوي من أهل البصرة يروي عن نافع ومعاذة روى عنه قرة بن خالد والحسين بن واقد(@)(@@)(@@)(@@) $ 6845 - أدهم السدوسي 
ms917	 أبو بشر مولى شقيق بن ثور يروي عن عبد الله بن بريدة روى عنه شعبة وهشيم بن بشير(@)(@@)(@@)(@@) $ 6846 - أفلت بن خليفة أبو حسان يروي عن جسرة ابنة دجاجة عن عائشة روى عنه عبد الواحد بن زياد(@)(@@)(@@)(@@) $ 6847 - الأعجف بن رزين يروي عن أم الدرداء عن أبي PageV06P088 الدرداء أنه قال لا تدخل الملائكة بيتا فيه بول منقع روى عنه أبو حصين موقوف(@)(@@)(@@)(@@) $ 6848 - الأخضر بن عجلان الشيباني أخو شميط بن عجلان من بني تيم بن شيبان من أهل البصرة وكان طحانا يروي عن أبي بكر الحنفي عن أنس روى عنه يحيى القطان وأهل البصرة وهو عم عبيد الله بن شميط بن عجلان(@)(@@)(@@)(@@) $ 6849 - أثال بن قرة يروي عن شهر بن حوشب روى عنه عكرمة بن عمار(@)(@@)(@@)(@@) $ 6850 - الأحوص بن جواب التيمي يروي عن الأعمش وسليمان بن قرم والكوفيين روى عنه بن نمير وأهل العراق كنيته PageV06P089 أبو الجواب وكان متقنا وربما وهم(@)(@@)(@@)(@@) ||| (النساء)(@)(@@)(@@)(@@) $$ 6851 - أذينة بنت عليبة تروي عن زيدة بنت قيلة بنت مخرمة عن أمها قيلة بنت مخرمة بن قرط روى عنها كثير بن قيس بن الصلت العنبري(@)(@@)(@@)(@@) || (باب الباء)(@)(@@) قال أبو حاتم ومن أتباع التابعين الذين رووا عن التابعين ممن ابتدأ اسمه على الباء(@)(@@)(@@)(@@) $ 6852 - بلال بن يحيى بن طلحة بن عبيد الله التيمي القرشي من أهل الحجاز يروي عن أبيه عن جده روى أبو عامر العقدي عن سليمان بن سفيان عنه في رؤية الهلال PageV06P090(@)(@@)(@@)(@@) $ 6853 - بلال بن يسار بن زيد مولى رسول الله صلى الله عليه وسلم يروي عن أبيه عن جده روى عنه عمرو بن مرة(@)(@@)(@@)(@@) $ 6854 - بلال بن أبي بردة بن أبي موسى الأشعري أخو سعيد بن أبي بردة وكان على قضاء البصرة واسم أبي بردة عامر بن عبد الله بن قيس يروي عن أبيه روى عنه قتادة ومحمد بن الزبير الحنظلي(@)(@@)(@@)(@@) $ 6855 - بلال بن عبد الله بن أنيس الجهني يروي عن أخيه عطية بن عبد الله بن أنيس روى عنه أهل الحجاز(@)(@@)(@@)(@@) $ 6856 - بلال بن 
ms918	 وهب بن كيسان يروي عن أبيه عن جابر بن عبد الله في العمر روى عنه أبو حنيفة(@)(@@)(@@)(@@) $ 6857 - بلال بن أبي مسلم مولى عبد الرحمن بن حبيب الفهري من أهل المدينة يروي عن أبان بن عثمان روى عنه معن بن عيسى PageV06P091 حدثنا أبو خليفة قال ثنا علي بن المديني قال ثنا معن بن عيسى قال ثنا بلال بن أبي مسلم قال كنت أرى عمر بن عبد العزيز وأبان بن عثمان وأبا بكر بن محمد يمشي بين أيديهم بمصباح فإذا أفضوا إلى المسجد مشوا بغير شمعة(@)(@@)(@@)(@@) $ 6858 - بلال بن صيفي يروي عن الحسن روى عنه سلام بن مسكين(@)(@@)(@@)(@@) $ 6859 - بلال بن مرداس الفزاري يروي عن شهر بن حوشب روى عنه السدي وعبد الأعلى الثعلبي(@)(@@)(@@)(@@) $ 6860 - بلال مولى بن أبي عتيق القرشي التيمي من أهل المدينة كنيته أبو سليمان يروي عن القاسم بن محمد روى عنه سحبل بن أبي يحيى الأسلمي(@)(@@)(@@)(@@) $ 6861 - بشر بن عاصم بن سفيان بن عبد الله بن ربيعة الثقفي الحجازي أخو عمرو بن عاصم يروي عن أبيه عن جده سفيان بن عبد الله روى PageV06P092 عنه ثور بن زيد الديلي وعمر بن سعيد بن أبي حسين وابن عيينة مات بعد الزهري سنة أربع وعشرين ومائة(@)(@@)(@@)(@@) $ 6862 - بشر بن أبي العالية يروي عن بن سيرين روى عنه كهمس بن الحسن(@)(@@)(@@)(@@) $ 6863 - بشر بن قرة الكلبي يروي عن أبي بردة روى عنه إسماعيل بن أبي خالد عن أخيه عنه(@)(@@)(@@)(@@) $ 6864 - بشر بن دريد يروي عن عقيصا التيمي عن على روى عنه محمد بن فضيل بن غزوان(@)(@@)(@@)(@@) $ 6865 - بشر بن مجاهد شيخ يروي المقاطيع كأنه من أهل الشام روى PageV06P093 عنه أرطاة بن المنذر السكوني(@)(@@)(@@)(@@) $ 6866 - بشر بن بشير بن معبد يروي عن أبيه روى عنه محمد بن بشر(@)(@@)(@@)(@@) $ 6867 - بشر بن زيد بن معاوية يروي عن أبيه عن حذيفة وابن مسعود روى عنه المسعودي(@)(@@)(@@)(@@) $ 6868 - بشر بن زياد يروي عن سليمان بن عبد الله بن عتر ويقال عتريس روى عنه عبد الرحمن 
ms919	 بن يزيد بن جابر(@)(@@)(@@)(@@) $ 6869 - بشير بن كثير بن عمير الأسيدي يروي عن عبد الله بن شقيق العقيلي روى عنه النضر بن شميل وأبو سعيد مولى بنى هاشم PageV06P094 ومن قال إنه يسير فقد وهم كنيته أبو طلحة(@)(@@)(@@)(@@) $ 6870 - بشر بن قيس التغلبي يروي عن أبيه عن سهل بن الحنظلية روى عنه هشام بن سعد(@)(@@)(@@)(@@) $ 6871 - بشر بن حلال العدوي قال جالست الحسن عشرين سنة فسمعته يقول لقد سبقت لعثمان سوابق قل من أدركها روى عنه عيسى بن عبيد المروزي(@)(@@)(@@)(@@) $ 6872 - بشر الأفوه بصري يروي عن مالك بن دينار روى عنه سعيد بن سليمان الواسطي(@)(@@)(@@)(@@) $ 6873 - بشر بن حميد بن أبي مريم يروي عن سعيد بن المسيب وعروة بن الزبير روى عنه سليمان بن بلال وعباد بن إسحاق(@)(@@)(@@)(@@) $ 6874 - بشر بن عبد الله بن يسار الشامي يروي عن عبادة بن نسي PageV06P095 والشاميين مكحول وغيره روى عنه إسماعيل بن عياش وأبو المغيرة(@)(@@)(@@)(@@) $ 6875 - بشر بن عمير بن كثير الأسيدي يروي عن عبد الله بن شقيق العقيلي روى عنه النضر بن شميل ويشبه أن يكون هذا هو الأول قلب اسمه واسم أبيه(@)(@@)(@@)(@@) $ 6876 - بشر بن العلاء بن زبر أخو عبد الله بن العلاء بن زبر من أهل الشام يروي عن حرام بن حكيم عن أبي ذر يروي عنه يحيى بن حمزة القاضي وبشر أسن من عبد الله بن العلاء(@)(@@)(@@)(@@) $ 6877 - بشر بن عبد الله بن أبي أيوب الأنصاري يروي عن أبيه عن جده عن النبي صلى الله عليه وسلم قال ساعات الأمراض يذهبن بساعات الخطايا روى عنه فضال بن جبر وفضال لا شيء(@)(@@)(@@)(@@) $ 6878 - بشر بن عبيد يروي عن طاوس روى عنه سلمة بن PageV06P096 سيسن الحناط(@)(@@)(@@)(@@) $ 6879 - بشر بن سباع يروى عن بن أبي مليكة روى عنه عبد الله بن عمر أبو عثمان صاحب الأكفان(@)(@@)(@@)(@@) $ 6880 - بشر بن عبد الملك العتبي يروي عن يحيى بن سعيد الأنصاري فعله روى عنه أبو سعيد الأشج(@)(@@)(@@)(@@) $ 6881 - بشر بن المفضل بن لاحق مولى بني رقاش كنيته 
ms920	 أبو إسماعيل من أهل البصرة يروي عن حميد الطويل ومحمد بن المنكدر وداود بن أبي هند روى عنه أهل العراق مات في شهر ربيع الأول سنة سبع وثمانين ومائة بعد المعتمر بشهرين ومات المعتمر في المحرم سنة سبع وثمانين ومائة(@)(@@)(@@)(@@) $ 6882 - بشير بن ربيعة البجلي يروى عن رافع بن سلمة عن علي روى عنه المعافى بن عمران PageV06P097(@)(@@)(@@)(@@) $ 6883 - بشير بن حليس يروي عن بشير بن كعب روى عنه غيلان بن جرير(@)(@@)(@@)(@@) $ 6884 - بشير بن سلمان النهدي كنيته أبو إسماعيل من أهل الكوفة يروي عن عكرمة وأبي حازم روى عنه وكيع وأبو نعيم(@)(@@)(@@)(@@) $ 6885 - بشير بن المهاجر الغنوي من أهل الكوفة يروي عن عبد الله بن بريدة وقد روى عن أنس ولم يره دلس عنه روى عنه بن نمير وخلاد بن يحيى يخطىء كثيرا(@)(@@)(@@)(@@) $ 6886 - بشير بن الكوسج أبو نصر من أهل مرو قال قلت للحسن إن حب عثمان وعلي لا يجتمعان في قلب فقال يا بن أخ إن رسول الله صلى الله عليه وسلم قد زوج ابنته من عثمان فماتت ثم زوجه الأخرى أفجاهل كان رسول الله صلى الله عليه وسلم روى عنه الفضل بن موسى السيناني وأهل مرو PageV06P098(@)(@@)(@@)(@@) $ 6887 - بشير بن أبي الجعد يروي عن الحسن وابن المنكدر روى عنه الحسن بن حبيب بن ندبة(@)(@@)(@@)(@@) $ 6888 - بشير بن عقبة الأزدي كنيته أبو عقيل أصله من دورق سكن البصرة يروي عن بن سيرين وأبي نضرة روى عنه مسلم بن إبراهيم(@)(@@)(@@)(@@) $ 6889 - بشير بن ثابت الأنصاري من أهل البصرة يروي عن حبيب بن سالم روى عنه أبو بشر جعفر بن أبي وحشية ومن زعم أنه بشر بن ثابت فقد وهم (@)(@@)(@@)(@@) $ 6890 - وحيوة بن شريح حدثنا بن قتيبة قال ثنا حرملة قال ثنا بن وهب قال حدثني حيوة بن شريح أن بشير بن أبي عمرو الخولاني حدثه أن الوليد بن قيس PageV06P099 التجيبي حدثه أن أبا سعيد الخدري حدثه أنه سمع رسول الله صلى الله عليه وسلم يقول خمس من عملهن في يوم 