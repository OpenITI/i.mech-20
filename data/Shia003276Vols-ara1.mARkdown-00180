ms175	 الجزري عن ابن عمر وطاووس وعنه شعبة ومالك. م د س ق (@)(@@)(@@)(@@) $ 2390 -(@)(@@) صدي بن عجلان أبو أمامة الباهلي من بقايا الصحابة بحمص عنه محمد بن زياد ومكحول ولقمان بن عامر توفي 86. ع (@)(@@)(@@)(@@) $ 2391 -(@)(@@) صرد بن أبي المنازل عن حبيب بن أبي فضالة وعنه الأنصاري وثق حب. د (@)(@@)(@@)(@@) $ 2392 -(@)(@@) الصعب بن جثامة الليثي نزيل ودان عنه ابن عباس. ع (@)(@@)(@@)(@@) $ 2393 -(@)(@@) صعصعة بن صوحان العبدي عن عثمان وعلي وعنه الشعبي وأبو إسحاق ثقة. س PageV01P502(@)(@@)(@@)(@@) $ 2394 -(@)(@@) صعصعة بن مالك عن أبي هريرة وعنه ابنه زفر وابن أخيه صابئ ثقة. د(@)(@@)(@@)(@@) $ 2395 -(@)(@@) صعصعة بن معاوية عم الأحنف صحابي عنه الحسن البصري ومروان الأصفر. س ق (@)(@@)(@@)(@@) $ 2396 -(@)(@@) الصعق بن حزن البكري البصري عن الحسن وعمر بن عبد العزيز وعنه عارم وشيبان ثقة عابد. م س (@)(@@)(@@)(@@) $ 2397 -(@)(@@) صفوان بن أمية بن خلف الجمحي أحد أشراف الطلقاء شهد اليرموك أميرا عنه بنوه وسعيد بن المسيب توفي 41. خت م 4 (@)(@@)(@@)(@@) $ 2398 - صفوان بن سليم الزهري مولاهم المدني الإمام القدوة ومن يستسقي بذكره عن ابن عمر و عبد الله بن جعفر وابن المسيب وعنه مالك والداروردي يقال: إنه لم يضع جنبه أربعين سنة وقيل: إن جبهته ثقبت من كثرة السجود وكان قانعا لا يقبل جوائز السلطان ثقة حجة ولد سنة ستين وتوفي 132. ع (@)(@@)(@@)(@@) $ 2399 -(@)(@@) صفوان بن صالح أبو عبد الملك الثقفي مؤذن جامع دمشق ومحدثها عن الوليد وابن عيينة ووكيع وعنه أبو داود والفريابي وابن قتيبة العسقلاني وخلق قال أبو داود: حجة مات 239.(@)(@@) د ت س (@)(@@)(@@)(@@) $ 2400 -(@)(@@) صفوان بن عبد الله بن صفوان بن أمية بن خلف عن جده وعلي وأبي الدرداء وعنه الزهري وأبو الزبير وثق. م س ق * - صفوان بن عبد الله بن يعلى بن أمية التميمي عن عمته وعنه عطاء الصواب: صفوان بن يعلى . س ق. [= 2409](@)(@@)(@@)(@@) $ 2401 - صفوان بن عسال المرادي الصحابي له اثنتا عشرة غزوة عنه زر بن حبيش وعبد الله بن سلمة وطائفة. ت س ق (@)(@@)(@@)(@@) $ 2402 -(@)(@@) صفوان بن عمرو السكسكي أبو عمرو 
ms176	 الحمصي عن عبد الله بن بسر وجبير بن نفير والكبار PageV01P503(@)(@@) وعنه الوليد بن مسلم وبقية وأبو اليمان وثقوه مات 155. م 4 (@)(@@)(@@)(@@) $ 2403 -(@)(@@) صفوان بن عمرو الحمصي الصغير عن أحمد بن خالد وأبي المغيرة وعنه النسائي ومكحول البيروتي. س (@)(@@)(@@)(@@) $ 2404 -(@)(@@) صفوان بن عيسى الزهري البصري القسام عن يزيد بن أبي عبيد وابن عجلان وعنه أحمد وبندار والذهلي وثق مات سنة مائتين. م 4 (@)(@@)(@@)(@@) $ 2405 -(@)(@@) صفوان بن محرز البصري عن ابن مسعود وأبي مسعود وابن عمرو وعنه قتادة وعاصم الأحول ثقة بكاء خاشع واعظ مات 74. خ م ت س ق (@)(@@)(@@)(@@) $ 2406 -(@)(@@) صفوان بن موهب عن عبد الله بن عصمة وغيره وعنه عطاء وعمرو بن دينار وثق. س (@)(@@)(@@)(@@) $ 2407 -(@)(@@) صفوان بن هبيرة التيمي عن أبيه وابن جريج وعنه الذهلي وأبو قلابة وجماعة قال أبو حاتم:(@)(@@) شيخ. ق (@)(@@)(@@)(@@) $ 2408 -(@)(@@) صفوان بن أبي يزيد عن أبي سعيد وابن اللجلاج وعنه ابنه حجاج ومحمد بن عمرو وطائفة. س (@)(@@)(@@)(@@) $ 2409 -(@)(@@) صفوان بن يعلى بن أمية التميمي عن أبيه وعنه عطاء والزهري وثق. خ م د ت س (@)(@@)(@@)(@@) $ 2410 -(@)(@@) الصلت بن دينار الأزدي البصري المجنون عن عبد الله بن شقيق وأبي عثمان النهدي وعنه وكيع ومسلم وجماعة قال أحمد: تركوا حديثه. ت ق (@)(@@)(@@)(@@) $ 2411 -(@)(@@) الصلت بن عبد الله بن نوفل بن الحارث الهاشمي عن ابن عباس وعنه الزهري وابن إسحاق وثق. د ت (@)(@@)(@@)(@@) $ 2412 -(@)(@@) الصلت بن محمد أبو همام الخاركي - وخارك من ساحل البصرة - عن حماد بن زيد ومهدي بن ميمون وعنه البخاري وروح بن حاتم وجماعة صالح الحديث. خ س PageV01P504(@)(@@)(@@)(@@) $ 2413 -(@)(@@) الصلت بن مسعود الجحدري قاضي سامرا عن حماد بن زيد وديلم بن غزوان وعنه مسلم وأبو يعلى والبغوي وثق مات 239. م (@)(@@)(@@)(@@) $ 2414 -(@)(@@) صلة بن زفر العبسي عن علي و عبد الله وعمار وعنه شتير بن شكل وأبو إسحاق وأيوب وثق قيل: توفي زمن مصعب فعلى هذا لم يلقه أيوب. ع (@)(@@)(@@)(@@) $ 2415 -(@)(@@) الصنابح بن الأعسر البجلي الأحمسي صحابي عنه قيس بن أبي حازم فقط. ق (@)(@@)(@@)(@@) $ 2416 -(@)(@@) صهيب 
ms177	 بن سنان النمري الرومي المنشأ سبته الروم من نينوى وأمه مازنية بدري من السابقين عنه بنوه: حمزة وزياد وصيفي وسعد وسعيد بن المسيب مات بالمدينة وكان أشقر أصهب يخضب مات 38. ع (@)(@@)(@@)(@@) $ 2417 -(@)(@@) صهيب أبو الصهباء عن مولاه ابن عباس وعلي وابن مسعود وعنه سعيد بن جبير وطاوس وجماعة وثقه أبو زرعة قال النسائي: بصري ضعيف. م د س(@)(@@)(@@)(@@) $ 2418 -(@)(@@) صهيب أبو موسى الحذاء المكي عن عبد الله بن عمرو وعنه عمرو بن دينار وثق. س (@)(@@)(@@)(@@) $ 2419 -(@)(@@) صهيب العتواري عن أبي هريرة وأبي سعيد وعنه نعيم المجمر وأبو يعفور وثق. س PageV01P505(@)(@@)(@@)(@@) $ 2420 -(@)(@@) صيفي بن ربعي كوفي عن ابن أبي ذئب وشعبة وعنه أبو كريب وجماعة صدوق. ت (@)(@@)(@@)(@@) $ 2421 -(@)(@@) صيفي بن زياد المدني مولى الأنصار عن أبي اليسر وأبي سعيد وعنه عبيد الله بن عمر ومالك ثقة. م د ت س (@)(@@)(@@)(@@) $ 2422 -(@)(@@) صيفي بن صهيب بن سنان عن أبيه وعنه بنوه: حذيفة وزياد و عبد الحميد وثق. ق PageV01P506(@)(@@)(@@)(@@) | الضاد(@)(@@)(@@)(@@) $ 2423 -(@)(@@) ضبارة بن عبد الله أبو شريح الحمصي عن أبيه وغيره وعنه ابنه محمد وبقية وغيرهما وثق . د س ق (@)(@@)(@@)(@@) $ 2424 -(@)(@@) ضبة بن محصن العنزي البصري عن عمر وأبي موسى وعنه الحسن وقتادة وجماعة ثقة له في الكتب حديث. م د ت (@)(@@)(@@)(@@) $ 2425 -(@)(@@) ضبيعة بن حصين ويقال: ثعلبة بن ضبيعة عن حذيفة وابن مسلمة وعنه أبو بردة بن أبي موسى وثق. د (@)(@@)(@@)(@@) $ 2426 -(@)(@@) ضحاك بن أيمن عن الضحاك بن عبد الرحمن وعنه ابن لهيعة لم يثبت. ق (@)(@@)(@@)(@@) $ 2427 -(@)(@@) الضحاك بن حمرة الأملوكي عن عمرو بن شعيب وقتادة وعنه بقية وأبو المغيرة وجماعة PageV01P507(@)(@@) قال غير واحد: ليس بثقة وأما ابن حبان فذكره في " الثقات ". ت (@)(@@)(@@)(@@) $ 2428 -(@)(@@) الضحاك بن سفيان الكلابي ولي نجدا للنبي صلى الله عليه وسلم عنه ابن المسيب والحسن في الدية. 4 (@)(@@)(@@)(@@) $ 2429 -(@)(@@) الضحاك بن شراحيل ويقال ابن شرحبيل المشرقي ومشرق: بطن من همدان عن أبي سعيد وغيره وعنه الزهري والأعمش وجماعة. خ م(@)(@@)(@@)(@@) $ 2430 -(@)(@@) الضحاك بن شرحبيل الغافقي عن أبي هريرة 
ms178	 وابن عمر وعنه سعيد بن أبي هلال وابن لهيعة وعدة صدقه أبو زرعة. د ق (@)(@@)(@@)(@@) $ 2431 -(@)(@@) الضحاك بن عبد الرحمن بن أبي حوشب رأى واثلة وسمع مكحولا وطبقته وعنه الوليد وابن شابور والوليد بن مزيد وثقه دحيم. س (@)(@@)(@@)(@@) $ 2432 -(@)(@@) الضحاك بن عبد الرحمن بن عرزب الأشعري الأردني أمير دمشق لعمر بن عبد العزيز عن أبيه وأبي هريرة وجماعة وعنه مكحول وحريز والأوزاعي وثق. ت ق (@)(@@)(@@)(@@) $ 2433 -(@)(@@) الضحاك بن عثمان الحزامي المدني عن شرحبيل بن سعد ونافع والمقبري وعنه ابنه محمد وابن وهب وثقه ابن معين وقال أبو زرعة: ليس بقوي مات 153، وسمع منه حفيده الضحاك بن عثمان. م 4 PageV01P508(@)(@@)(@@)(@@) $ 2434 -(@)(@@) الضحاك بن فيروز الديلمي عن أبيه وعنه أبو وهب الجيشاني وغيره وثق. د ت ق (@)(@@)(@@)(@@) $ 2435 -(@)(@@) الضحاك بن قيس الفهري الأمير يقال: له صحبة سمع عمر وعنه عروة والشعبي وجماعة قتل يوم مرج راهط في آخر سنة 64. س (@)(@@)(@@)(@@) $ 2436 -(@)(@@) الضحاك بن مخلد أبو عاصم الشيباني البصري النبيل الحافظ عن يزيد بن أبي عبيد وبهز وابن عجلان وعنه البخاري وعبد وعباس الدوري قال عمر بن شبة: والله ما رأيت مثله وقال أبو عاصم: ما دلست قط وما اغتبت أحدا منذ عقلت أن الغيبة حرام مات في ذي الحجة 212. ع (@)(@@)(@@)(@@) $ 2437 -(@)(@@) الضحاك بن مزاحم الهلالي الخراساني عن أبي هريرة وابن عباس وابن عمر وأنس وطاوس وعنه علي بن الحكم البناني وقرة بن خالد ومقاتل بن حيان وثقه أحمد وابن معين قال عبد الملك بن ميسرة: قلت له: أسمعت من ابن عباس؟ قال ل: لا. وقال شعبة: كان عندنا ضعيفا وأما أبو جناب الكلبي فروى عن الضحاك قال: جاورت ابن عباس سبع سنين مات 105. 4 (@)(@@)(@@)(@@) $ 2438 -(@)(@@) الضحاك بن المنذر بن جرير بن عبد الله البجلي عن جرير وعنه أبو حيان التيمي. س ق (@)(@@)(@@)(@@) $ 2439 -(@)(@@) الضحاك المعافري دمشقي عن سليمان بن موسى وعنه محمد بن مهاجر. ق (@)(@@)(@@)(@@) $ 2440 -(@)(@@) ضرار بن مرة أبو سنان الشيباني الكوفي عن عبد الله بن شداد وأبي الأحوص وسعيد بن 
ms179	 جبير وعنه شعبة وابن فضيل من العباد الثقات. م ت س(@)(@@)(@@)(@@) $ 2441 -(@)(@@) ضريب بن نقير - ويقال: نفير بفاء وابن نفيل - أبو السليل الجريري البصري أرسل عن أبي ذر وسمع صلة بن أشيم وزهدما الجرمي، وعنه عوف والجريري وثقوه. م 4 PageV01P509(@)(@@)(@@)(@@) $ 2442 -(@)(@@) ضمرة بن حبيب الزبيدي الحمصي عن عوف بن مالك وشداد بن أوس وأبي أمامة وعنه أرطاة ابن المنذر ومعاوية بن صالح وثقه ابن معين. 4 (@)(@@)(@@)(@@) $ 2443 -(@)(@@) ضمرة بن ربيعة الرملي أبو عبد الله عن مولاه علي بن أبي حملة وإبراهيم بن أبي عبلة وابن شوذب وعنه أيوب الوزان ودحيم وأمم قال أحمد: صالح من الثقات لم يكن بالشام رجل يشبهه هو أحب إلي من بقية وقال ابن يونس: كان فقيههم في زمانه مات في رمضان 202. 4 (@)(@@)(@@)(@@) $ 2444 -(@)(@@) ضمرة بن سعيد المازني عن أبي سعيد الخدري وأنس وعنه مالك وفليح وابن عيينة وثقوه. م 4 (@)(@@)(@@)(@@) $ 2445 -(@)(@@) ضمرة بن عبد الله بن أنيس الجهني عن أبيه وعنه الزهري وابن الأشج وثق. د س (@)(@@)(@@)(@@) $ 2446 -(@)(@@) ضمضم بن جوس اليمامي عن أبي هريرة وعنه يحيى بن أبي كثير وعكرمة بن عمار قال أحمد: ليس به بأس. 4 (@)(@@)(@@)(@@) $ 2447 -(@)(@@) ضمضم بن زرعة الحمصي عن شريح بن عبيد وعنه إسماعيل بن عياش ويحيى بن حمزة مختلف فيه. د (@)(@@)(@@)(@@) $ 2448 -(@)(@@) ضمضم أبو المثنى الأملوكي عن عتبة بن عبد وغيره وعنه هلال بن يساف وصفوان بن عمرو وثق. د ق (@)(@@)(@@)(@@) $ 2449 -(@)(@@) ضميرة شهد حنينا وروى قصة محلم بن جثامة عنه ابنه سعد. د ق PageV01P510(@)(@@)(@@)(@@) | الطاء(@)(@@)(@@)(@@) $ 2450 -(@)(@@) طارق بن أشيم الأشجعي له صحبة عنه ابنه أبو مالك فقط. م ت س ق (@)(@@)(@@)(@@) $ 2451 -(@)(@@) طارق بن سويد ويقال سويد بن طارق له صحبة عنه علقمة بن وائل. د ق(@)(@@)(@@)(@@) $ 2452 -(@)(@@) طارق بن شهاب الأحمسي عن أبي بكر وعمر وله رؤية وعنه قيس بن مسلم وابن أبي خالد وعدة مات 82 وقيل 83. ع (@)(@@)(@@)(@@) $ 2453 -(@)(@@) طارق بن عبد الله المحاربي صحابي عنه ربعي بن حراش وأبو صخرة جامع. 4 (@)(@@)(@@)(@@) $ 2454 -(@)(@@) طارق 
ms180	 بن عبد الرحمن الحجازي عن ميمونة مولاة النبي صلى الله عليه وسلم ورافع بن رفاعة وعنه عكرمة بن عمار وثق. د (@)(@@)(@@)(@@) $ 2455 -(@)(@@) طارق بن عبد الرحمن البجلي عن ابن أبي أوفى وابن المسيب وعنه شعبة وابن المبارك وعدة وثقوه وقال أحمد: ليس حديثه بذاك. ع PageV01P511(@)(@@)(@@)(@@) $ 2456 -(@)(@@) طارق بن عمرو المكي القاضي عن جابر وعنه سليمان بن يسار وحميد بن قيس وثقه أبو زرعة. م د (@)(@@)(@@)(@@) $ 2457 -(@)(@@) طارق بن مخاشن عن أبي هريرة وعنه الزهري وغيره وثق. د (@)(@@)(@@)(@@) $ 2458 -(@)(@@) طارق بن مرقع عن صفوان بن أمية وعنه عطاء. س (@)(@@)(@@)(@@) $ 2459 -(@)(@@) طالب بن حبيب الأنصاري عن ابني جابر وعنه موسى بن إسماعيل ويونس المؤدب قال البخاري: فيه نظر. د (@)(@@)(@@)(@@) $ 2460 -(@)(@@) طالب بن حجير العبدي عن هود العصري وعنه موسى بن إسماعيل وجماعة قال أبو حاتم :(@)(@@) شيخ. ت (@)(@@)(@@)(@@) $ 2461 -(@)(@@) طاوس بن كيسان الإمام أبو عبد الرحمن اليماني من أبناء الفرس وقيل: اسمه ذكوان فلقب فقال ابن معين: لأنه كان طاوس القراء عن أبي هريرة وابن عباس وعائشة وعنه الزهري PageV01P512(@)(@@) وسليمان التيمي و عبد الله ابنه قال عمرو بن دينار: ما رأيت أحدا مثله قط مات بمكة 106. ع (@)(@@)(@@)(@@) $ 2462 -(@)(@@) طخفة بن قيس الغفاري له صحبة حديثه في النوم منبطحا في حديثه واسمه اضطراب. د س (@)(@@)(@@)(@@) $ 2463 -(@)(@@) طرفة بن عرفجة بن أسعد أصيب أنفه يوم الكلاب عنه ابنه. د (@)(@@)(@@)(@@) $ 2464 -(@)(@@) طريف بن شهاب وقيل ابن سعد أبو سفيان السعدي عن الحسن وأبي نضرة وعنه علي بن مسهر وأبو معاوية وعدة ضعفوه. ت ق (@)(@@)(@@)(@@) $ 2465 -(@)(@@) طريف بن مجالد أبو تميمة الهجيمي عن أبي هريرة وابن عمر وطائفة وعنه بكر بن عبد الله وقتادة والحذاء وثق مات 97. خ 4 (@)(@@)(@@)(@@) $ 2466 -(@)(@@) طعمة بن عمرو كوفي عن يزيد بن الأصم ونافع وعنه وكيع وأبو بلال الأشعري وعدة قال أبو حاتم: صالح الحديث مات 169. د ت (@)(@@)(@@)(@@) $ 2467 -(@)(@@) الطفيل بن أبي بن كعب عن أبيه وعمر وعنه ابن عقيل وإسحاق بن عبد الله بن أبي طلحة وثقه ابن سعد. ت ق 