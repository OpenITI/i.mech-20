ms6748	(@)(@@) ج 1، ح 453، و ج 6، ح 680.(@)(@@) وروى عنه صالح بن سعيد.(@)(@@) الكافي: ج 3، ك 4، ب 5، ح 7، و ج 6، ك 2، ب 73، ح 36. والفقيه: ج 4، ح 727. والتهذيب: ج 2، ح 67.(@)(@@) وروى عنه محمد بن عيسى.(@)(@@) الكافي: ج 1، ك 4، ب 129، ح 6، و ج 5، ك 3، ب 111، ح 2، و ج 7، ك 6، ب 19، ح 15. والتهذيب: ج 1، ح 271 (الاستبصار: ج 1، ح 316)، و ج 6، ح 781 (الاستبصار: ج 3، ح 35)، و ح 798 (الاستبصار: ج 3، ح 35)، و ح 1135.(@)(@@) * وروى عن بعض رجاله، عن أبي عبد الله وأبي جعفر عليهما السلام، وروى عنه إسماعيل.(@)(@@) التهذيب: ج 1، ح 851.(@)(@@) * وروى عن بعض من رواه، عن أبي عبد الله عليه السلام، وروى عنه محمد ابن عيسى.(@)(@@) الكافي: ج 3، ك 4، ب 61، ح 4.(@)(@@) * وروى عن رجل عن أبي جعفر عليه السلام، وروى عنه إسماعيل بن مرار.(@)(@@) الكافي: ج 6، ك 1، ب 17، ح 4.(@)(@@) وروى عنه محمد بن عيسى.(@)(@@) التهذيب: ج 2، ح 716 (الاستبصار:(@)(@@) ج 1، ح 1392، وفيه أبو عبد الله، بدل أبي جعفر عليه السلام).(@)(@@) * وروى عن رجل، عن أبي عبد الله عليه السلام، وروى عنه إسماعيل بن مرار.(@)(@@) الكافي: ج 5، ك 2، ب 152، ح 2، و ج 7، ك 2، ب 11، ح 2. والتهذيب: ج 7، PageV21P317(@)(@@) ح 1016.(@)(@@) وروى عنه محمد بن عيسى.(@)(@@) الكافي: ج 2، ك 1، ب 203، ح 22، و ج 3، ك 4، ب 39، ح 4، وب 43، ح 5، و ج 6، ك 2، ب 46، ح 9، و ج 7، ك 4، ب 43، ح 1. والتهذيب: ج 3، ح 187، و ج 7، ح 1877 (الاستبصار: ج 3، ح 568، و 770)، و ج 9، ح 978 (الاستبصار: ج 3، ح 641)، و ج 10، ح 885 (الاستبصار: ج 4، ح 1080، و 1082)، و ح 927 (الاستبصار: ج 4، ح 1080، و 1082).(@)(@@) وروى عنه محمد بن عيسى بن عبيد.(@)(@@) الكافي: ج 5، ك 2، ب 17، ح 1، و ج 6، ك 1، ب 33، ح 1.(@)(@@) وروى عنه يحيى بن أبي عمران.(@)(@@) الفقيه: ج 4، ح 679. والتهذيب: ج 9، ح 1130.(@)(@@) * وروى عن رجل، عن زرارة، وروى عنه محمد بن عيسى.(@)(@@) الكافي: ج 2، ك 1، ب 171، ح 2، و ب 174، ح 1، وب 176، ح 1 و 3، و ب 178، ذيل ح 2.(@)(@@) * وروى عن رجل، عن سعد الاسكاف، وروى عنه إسماعيل بن مرار.(@)(@@) الكافي: 
ms6749	 ج 6، ك 6، ب 76، ح 3.(@)(@@) * وروى عن رجل، عن محمد بن مسلم، وروى عنه محمد بن عيسى.(@)(@@) الكافي: ج 1، ك 4، ب 54، ح 4.(@)(@@) * وروى عن عدة، عن أبي عبد الله عليه السلام، وروى عنه محمد.(@)(@@) الكافي: ج 1، ك 3، ب 30، ح 11.(@)(@@) * وروى عن غير واحد، عن أبي عبد الله عليه السلام، وروى عنه محمد ابن عيسى.(@)(@@) الكافي: ج 3، ك 2، ب 9، ح 1. والتهذيب:(@)(@@) ج 1، ح 1183.(@)(@@) وروى مرسلا.(@)(@@) الكافي: ج 5، ك 2، ب 95، ذيل ح 17.(@)(@@) وروى عنه إسماعيل بن مرار.(@)(@@) الكافي: ج 5، ك 2، ب 73، ح 15، و ب 107، ح 13، وك 3، ب 133، ح 1، و ب 191، ح 1، و ج 6، ك 2، ب 82، ح 2، وك 3، ب 10، ح 10، وب 15، ح 6.(@)(@@) والتهذيب: ج 8، ح 579، و 944.(@)(@@) وروى عنه الريان بن الصلت.(@)(@@) الكافي: ج 4، ك 2، ب 26، ح 4.(@)(@@) والتهذيب: ج 4، ح 593 (الاستبصار:(@)(@@) ج 2، ح 304). PageV21P318(@)(@@) وروى عنه سيف.(@)(@@) التهذيب: ج 5، ح 863 (الاستبصار:(@)(@@) ج 2، ح 806).(@)(@@) وروى عنه محمد بن عيسى.(@)(@@) الكافي: ج 5، ك 3، ب 86، ح 8، و ج 7، ك 2، ب 11، ح 1، وب 58، ذيل ح 4.(@)(@@) والتهذيب: ج 9، ح 1238 (الاستبصار:(@)(@@) ج 4، ح 689).(@)(@@) وروى عنه محمد بن عيسى بن عبيد.(@)(@@) الكافي: ج 7، ك 2، ب 41، ذيل ح 2.(@)(@@) وروى مرفوعا، عن أبي عبد الله عليه السلام، وروى عنه الريان بن الصلت.(@)(@@) الروضة: ح 177.(@)(@@) وروى مرفوعا، عن أمير المؤمنين عليه السلام، وروى عنه محمد بن عيسى.(@)(@@) الكافي: ج 2، ك 1، ب 111، ح 28.(@)(@@) وروى مرفوعا، عن علي بن الحسين عليهما السلام، وروى عنه محمد بن عيسى.(@)(@@) الكافي: ج 1، ك 2، ب 22، ح 7.(@)(@@) وروى مرفوعة مضمرة، وروى عنه محمد بن عيسى.(@)(@@) الكافي: ج 1، ك 2، ب 8، ح 1.(@)(@@) وروى مضمرة، وروى عنه إسماعيل ابن مرار.(@)(@@) الكافي: ج 5، ك 2، ب 95، ح 4، و ج 6، ك 2، ب 55، ح 4، وك 3، ب 16، ح 14.(@)(@@) والتهذيب: ج 7، ح 278 (الاستبصار:(@)(@@) ج 3، ح 278)، و ح 612، و ج 8، ح 250 (الاستبصار: ج 3، ح 1068)، و ح 830، و 863 (الاستبصار: ج 4، ح 39).(@)(@@) وروى عنه الحسين بن سعيد.(@)(@@) التهذيب: ج 10، ح 284.(@)(@@) وروى عنه علي بن أحمد.(@)(@@) التهذيب: ج 7، ح 1874.(@)(@@) وروى عنه علي بن أحمد بن أشيم.(@)(@@) التهذيب: ج 3، ح 866.(@)(@@) وروى 
ms6750	 عنه محمد بن عيسى.(@)(@@) الكافي: ج 3، ك 3، ب 88، ح 16.(@)(@@) والتهذيب: ج 4، ح 752 (الاستبصار:(@)(@@) ج 2، ح 369).(@)(@@) وروى عنه محمد بن عيسى بن عبيد.(@)(@@) الكافي: ج 4، ك 2، ب 52، ح 9.(@)(@@) وروى عمن أخبره، عن أبي الحسن عليه السلام، وروى عنه ابن مياح.(@)(@@) الكافي: ج 6، ك 8، ب 37، ح 8.(@)(@@) وروى عمن حدثه، عن أبي عبد الله عليه السلام، وروى عنه إسماعيل بن مرار. PageV21P319(@)(@@) الكافي: ج 3، ك 2، ب 6، ح 1.(@)(@@) وروى عمن ذكره، عن أبي بصير، وروى عنه عبد الله بن الصلت.(@)(@@) الروضة: ح 470.(@)(@@) وروى عمن ذكره، عن أبي عبد الله عليه السلام، وروى أحمد بن أبي عبد الله، عن أبيه، عنه.(@)(@@) الكافي: ج 6، ك 6، ب 102، ح 10، و ك 8، ب 66، ح 4.(@)(@@) وروى عنه إسماعيل بن مرار.(@)(@@) الكافي: ج 6، ك 8، ب 66، ح 4.(@)(@@) وروى عنه محمد بن عيسى.(@)(@@) الكافي: ج 1، ك 2، ب 9، ح 5، و ج 2، ك 1، ب 9، و 3، ح 3، و ج 4، ك 2، ب 75، ح 14. والتهذيب: ج 4، ح 220 (الاستبصار: ج 2، ح 136).(@)(@@) وروى عنه محمد بن عيسى بن عبيد.(@)(@@) الكافي: ج 2، ك 1، ب 102، ح 1.(@)(@@) وروى عمن ذكره، عن الرضا عليه السلام، وروى عنه محمد بن عيسى.(@)(@@) الكافي: ج 2، ك 1، ب 30، ح 11.(@)(@@) وروى عمن ذكره، عن سليمان بن خالد، وروى عنه محمد بن عيسى.(@)(@@) الكافي: ج 1، ك 4، ب 40، ح 4.(@)(@@) وروى عمن رأى أبا الحسن عليه السلام، وروى عنه محمد بن عيسى.(@)(@@) الكافي: ج 3، ك 1، ب 19، ح 7.(@)(@@) والتهذيب: ج 1، ح 160 (الاستبصار:(@)(@@) ج 1، ح 170)، و ح 183 (الاستبصار:(@)(@@) ج 1، ح 170، و ح 216 (الاستبصار:(@)(@@) ج 1، ح 170).(@)(@@) وروى عمن رفعه، عن أبي عبد الله عليه السلام، وروى عنه محمد بن جمهور.(@)(@@) الكافي: ج 1، ك 4، ب 108، ح 49، و 50.(@)(@@) وروى عمن رواه، عن أبي عبد الله عليه السلام.(@)(@@) التهذيب: ج 10، ح 940.(@)(@@) وروى عن محمد بن عيسى.(@)(@@) وروى عنه: ج 1، ح 818 (الاستبصار:(@)(@@) ج 1، ح 661).(@)(@@) وروى عمن رواه، عن زرارة، وروى علي بن إبراهيم باسناده، عنه.(@)(@@) الكافي: ج 7، ك 3، ب 2، ح 4.(@)(@@) الكافي: ج 7، ك 3، ب 2، ح 4.(@)(@@) وروى عمن رواه مرسلا، وروى عنه محمد بن عيسى. 
ms6751	(@)(@@) الكافي: ج 7، ك 6، ب 13، ح 3.(@)(@@) والتهذيب: ج 6، ح 562.(@)(@@) وروى عمن رواه مضمرة. PageV21P320(@)(@@) التهذيب: ج 10، ح 778.(@)(@@) وروى عنه محمد بن عيسى.(@)(@@) الكافي: ج 7، ك 4، ب 24، ح 5.(@)(@@) * روى الحسين بن أحمد المنقري، عن يونس أو المفضل، عن أبي عبد الله عليه السلام.(@)(@@) الكافي: ج 1، ك 4، ب 42، ح 3.(@)(@@) وروى العباس بن موسى، عن يونس أو غيره، عن ابن بكير، وهاشم التهذيب: ج 7، ح 1665 (الاستبصار:(@)(@@) ج 3، ح 875).(@)(@@) * وروى محمد بن عيسى، عن يونس أو غيره، عن ابن مسكان.(@)(@@) الكافي: ج 7، ك 4، ب 40، ح 2.(@)(@@) * وروى الريان عن يونس أو غيره.(@)(@@) عمن ذكره، عن أبي عبد الله عليه السلام.(@)(@@) الكافي: ج 3، ك 5، ب 47، ح 2.(@)(@@) (يونس بن ظبيان) * روى عن أبي عبد الله عليه السلام.(@)(@@) الفقيه: ج 2، ح 1616، و ج 4، ح 836.(@)(@@) وروى عنه ابن أبي عمير.(@)(@@) التهذيب: ج 3، ح 95 (الاستبصار: ج 2، ح 513).(@)(@@) وروى عنه ابن سنان.(@)(@@) الكافي: ج 2، ك 1، ب 157، ح 2.(@)(@@) وروى عنه إسماعيل بن جابر.(@)(@@) الكافي: ج 2، ك 1، ب 118، ح 1.(@)(@@) وروى عنه جميل بن دراج.(@)(@@) الكافي: ج 6، ك 8، ب 26، ح 2.(@)(@@) وروى عنه الحسن بن راشد.(@)(@@) التهذيب: ج 6، ح 119.(@)(@@) وروى عنه الحسين بن أحمد.(@)(@@) الكافي: ج 3، ك 3، ب 91، ح 6.(@)(@@) والتهذيب: ج 1، ح 1526.(@)(@@) وروى عنه الحسين بن أحمد المنقري.(@)(@@) الكافي: ج 3، ك 3، ب 40، ح 2، و ج 6، ك 6، ب 47، ح 21، وك 8، ب 21، ح 3.(@)(@@) والروضة: ح 561.(@)(@@) وروى عنه ذبيان بن حكيم.(@)(@@) التهذيب: ج 6، ح 53.(@)(@@) وروى عنه زياد بن مروان.(@)(@@) التهذيب: ج 3، ح 469 (الاستبصار:(@)(@@) ج 1، ح 1869)، و ح 694.(@)(@@) وروى عنه زياد بن مروان القندي.(@)(@@) التهذيب: ج 1، ح 1504 (الاستبصار:(@)(@@) ج 1، ح 1869).(@)(@@) وروى عنه صالح بن سعيد القماط. PageV21P321(@)(@@) التهذيب: ج 6، ح 74.(@)(@@) وروى عنه صفوان.(@)(@@) التهذيب: ج 5، ح 95 (الاستبصار: ج 2، ح 513).(@)(@@) وروى عنه عبد الله بن القاسم.(@)(@@) الكافي: ج 2، ك 1، ب 184، ح 7، و ب 200، ح 1.(@)(@@) وروى عنه عبد الله بن محمد بن بقاح.(@)(@@) التهذيب: ج 6، ح 204.(@)(@@) وروى عنه عثمان بن سليمان النخاس.(@)(@@) الكافي: ج 2، ك 4، ب 28، ح 7.(@)(@@) وروى عنه عثمان 