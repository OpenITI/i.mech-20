ms41	 % 47(@)(@@) % بأقب يعصي الكف ثم يطيعه ، % فتراه بين تسرع وتوان % 48(@)(@@) % قد أكسبته رياضة سواسه ، % فتكاد تركضه بغير عنان % 49(@)(@@) % كالصقر في الطيران ، والطاووس في ال % % خطران ، والخطاف في الروغان % 50(@)(@@) % يرنو إلى حبك السماء توهما % لمشى عليه مشية السرطان % PageV01P137 51(@)(@@) % وفللت حد جموعهم بصوارم ، % ككراك ، نافرة عن الأجفان % 52(@)(@@) % ضلت فظنت في مقارعة العدى % % أن الغمود معاقد التيجان % 53(@)(@@) % صيرت هامات الكماة صوامعا ، % وكواسر العقبان كالرهبان % 54(@)(@@) % يا ذا الذي خطب المديح سماحه ، % فنداه قبل نداي قد لباني % % 55(@)(@@) % أقصيتني بالجود ثم دعوتني ، % فنداك أبعدني ، وإن أدناني % % 56(@)(@@) % ضاعفت برك لي ، ولو لم تولني % % إلا القبول عطية لكفاني % % 57(@)(@@) % فنأيت عنك ، ولست أول حازم % خاف النزول بمهبط الطوفان % 58(@)(@@) % علمي بصرف الدهر أخلى معهدي % % مني ، وصرف في البلاد عناني % % 59(@)(@@) % ولربما طلب الحريص زيادة ، % فغدت مؤدية إلى النقصان % 60(@)(@@) % فلئن رحلت ، فقد تركت بدائعا % غصبت فصول الحكم من لقمان % PageV01P138 61(@)(@@) % وخريدة هي في الجمال فريدة ، % فهي الغريبة وهي في الأوطان % 62(@)(@@) % معتادة تهب الخليل صداقها ، % فخرا على الأكفاء والأقران % 63(@)(@@) % لاعيب فيها ، وهو شاهد حسنها ، % إلا تبرجها بكل مكان % 64(@)(@@) % قلت ، وإن حلت صنائع لفظها % % لكم ، وإن نطقت بسحر بيان % 65(@)(@@) % فجميل صنعكم أجل صنائعا ، % وبديع فضلكم أدق معان % PageV01P139 البحر : كامل تام 1(@)(@@) % ملك يروض فوق طرف قارع % كرة بجو كان حكاه ضبابا % % 2(@)(@@) % فكأن بدرا ، في سماه ، راكبا % برقا ، يزحزح بالهلال شهابا % % PageV01P140 البحر : خفيف تام 1(@)(@@) % أيهذا العزيز قد صح رقي % % لك من موقع اسمي المرموز % 2(@)(@@) % أنا من يوم مولدي لك عبد ، % ولهذا دعيت عبد العزيز % PageV01P141 البحر : رجز تام 1(@)(@@) % كم قد أفضنا من دموع ودما % على رسوم للديار ودمن % 2(@)(@@) % وكم قضينا للبكاء منسكا ، % لما تذكرنا بهن من سكن % 3(@)(@@) % معاهدا تحدث للصبر فنا ، % إن ناحت الورق بها على فنن % 4(@)(@@) % تذكارها أحدث في الحلق شجا ، % وفي الحشا قرحا وفي القلب شجن % 5(@)(@@) % لله أيام لنا على منن ، % فكم لها عندي أياد ومنن % 6(@)(@@) % كم كان 
ms42	 فيها من فتاة وفتى ، % كل لقلب المستهام قد فتن % 7(@)(@@) % شربت فيها لذة العيش حسا ، % وما رأيت بعدها مرأى حسن % 8(@)(@@) % فما ارتكبنا بالوصال مأثما ، % بل بعتهم روحي بغير ما ثمن % 9(@)(@@) % وعاذل أضمر مكرا ودها ، % فنمق الغش بنصح ودهن % 10(@)(@@) % لاح غدا يعرف للقلب لحا ، % إن أعرب القول بعذلي أو لحن % PageV01P142 11(@)(@@) % يزيدني بالزجر وجدا وأسى ، % إن كان ماء الود منه قد أسن % 12(@)(@@) % سئمت منه اللوم ، إذ طال مدى ، % فلم أجبه بل بدوت إذ مدن % 13(@)(@@) % بحسرة تشتد في السر قرى ، % إذ لم تذلل بزمام وقرن % 14(@)(@@) % لا تتشكى نصبا ولا وجى ، % إذا دجا الليل على الركب وجن % 15(@)(@@) % كم سبقت إلى المياه من قطا ، % فأوردت بالليل ، وهو في قطن % 16(@)(@@) % حثت فأعطت في السرى خير عطا % إن حن يوما غيرها إلى عطن % 17(@)(@@) % وأصبحت من بعد أين وعيا ، % للملك الناصر ضيفا وعين % 18(@)(@@) % ملك غدا لسائر الناس أبا ، % إن سار في كسب الثناء ، أو أبن % 19(@)(@@) % الناصر الملك الذي فاض جدا ، % فخلته ذا يزن أو ذا جدن % 20(@)(@@) % ملك علا جدا وقدرا وسنا ، % فجاء في طرق العلى على سنن % PageV01P143 21(@)(@@) % لا جور في بلاده ، ولا عدا ، % إن عد في العدل زبيد وعدن % 22(@)(@@) % كم بدر أعطى الوفود ولهى ، % وكان يرضيهم كفافا ولهن % 23(@)(@@) % جنيت من إنعامه خير جنى ، % وكنت من قبل كميت في جنن % 24(@)(@@) % فما شكيت في حماه لغبا ، % ولو أطاق الدهر غبني لغبن % 25(@)(@@) % دعوته بالمدح عن صدق ولا ، % فلم يجب يوما بلم ، ولا ، ولن % 26(@)(@@) % أنظم في كل صباح ومسا ، % كأنه لصارم الدهر مسن % 27(@)(@@) % يا ملكا فاق الملوك ورعا ، % إن شان أهل الملك طيش ورعن % 28(@)(@@) % أكسبتني بالقرب مجدا وعلا ، % فصغت فيك المدح سرا وعلن % 29(@)(@@) % إن أولك المدح الجميل فخرا ، % وإن كبا فكر سواي أو حرن % 30(@)(@@) % لا زلت في ملكك خلوا من عنا ، % وليس للهم لديك من عنن % PageV01P144 31(@)(@@) % ونلت فيه ما تروم منن منى ، % وعشت في عز وبأس ومن % PageV01P145 البحر 
ms43	 : بسيط تام 1(@)(@@) % إن لم أزر ربعكم سعيا على الحدق ، % فإن ودي منسوب إلى الملق % 2(@)(@@) % تبت يدي إن ثنتني عن زيارتكم % بيض الصفاح ، ولو سدت بها طرقي % % 3(@)(@@) % يا جيرة الحي هلا عاد وصلكم % لمدنف من خمار الوجد لم يفق % 4(@)(@@) % لاتنكروا فرقي من بعدكم ، % إن الفراق لمشتق من الفرق % 5(@)(@@) % لله ليلتنا بالقصر كم قصرت ، % فظلت مصطبحا في زي مغتبق % 6(@)(@@) % وبات بدرث الدجى فيها يسامرني ، % منادما فيزين الخلق بالخلق % 7(@)(@@) % فكم خرقنا حجابا للعتاب بها ، % وللعفاف حجاب غير منخرق % 8(@)(@@) % والصبحث قد أخلقت ثوب الدجى يده ، % وليته جاد للعشاق بالخلق % 9(@)(@@) % أبلى الظلام وماذا لو يجود به % على جفون لطيب الغمض لم تذق % 10(@)(@@) % ما أحسن الصبح لولا قبح سرعته ، % وأعذب الليل لولا كثرة الأرق % PageV01P146 11(@)(@@) % هب النسيم عراقيا ، فشوقني ، % وطالما هب نجديا فلم يشق % 12(@)(@@) % فما تنقست ، والأرواح سارية ، % إلا اشتكت نسمات الريح من حرقي % % 13(@)(@@) % ذر أيها الصب تذكار الديار ، إذا % % متعت فيها بعيش غير متسق % 14(@)(@@) % فكم ضممت وشاحا في الظلام بها % % ما زاد قلبك إلا كثرة القلق % 15(@)(@@) % فخل تذكار زوراء العراق ، إذا % % جاءت نسيم الصبا بالمندل العبق % 16(@)(@@) % فهذه شهب الشهباء ساطعة ، % وهذه نسمة الفردوس ، فانتشق % 17(@)(@@) % فتلك أفلاك سعد لا يلوذ بها % % من مارد لخفي السمع مسترق % 18(@)(@@) % سماء مجد بدا فيها ، فزينها % % نجم تخر لديه أنجم الأفق % 19(@)(@@) % ملك غدا الجود جزءا من أنامله ، % فلو تكلف ترك الجود لم يطق % 20(@)(@@) % أعاد ليل الورى صبحا ، وكم ركضت % جياده ، فأرتنا الصبح كالغسق % PageV01P147 21(@)(@@) % مشتت العزم والأموال ما تركت % يداه للمال شملا غير مفترق % 22(@)(@@) % إذا رأى ماله قالت خزائنه : % أفديك من ولد بالثكل ملتحق % 23(@)(@@) % لولا أبو الفتح نجم الدين ما فتحت % أبواب رزق عليها اللوم كالغلق % 24(@)(@@) % ملك به اكتست الأيام ثوب بها % مثل اكتساء غصون البان بالورق % 25(@)(@@) % تهوى الحروب مواضيه ، فإن ذكرت % حنت ، فلم تر منها غير مندلق % 26(@)(@@) % حتى إذا جردت في الروع أغمدها % % في كل سابغة 
ms44	 مسرودة الحلق % 27(@)(@@) % يا أيها الملك المنصور طائره ، % ومن أياديه كالأطواق في عنقي % % 28(@)(@@) % أحييت بالجود آثار الكرام ، وقد % % كان الندى بعدهم في آخر الرمق % 29(@)(@@) % لو أشبهتك بحار الأرض في كرم ، % لأصبح الدر مطروحا على الطرق % 30(@)(@@) % لو أشبه الغيث جودا منك منهمرا % لم ينج في الأرض مخلوق من الغرق % PageV01P148 31(@)(@@) % كم قد أبدت من الأعداء من فئة % تحت العجاج ، وكم فرقت من فرق % 32(@)(@@) % رويت يوم لقاهم كل ذي ظمإ % في الحرب حتى حلال الخيل بالعرق % 33(@)(@@) % ويوم وقعة عباد الصليب ، وقد % % أركبتهم طبقا في البيد عن طبق % 34(@)(@@) % مزقت بالموصل الحدباء شملهم % في مأزق بوميض البيض ممتزق % 35(@)(@@) % بكل أبيض دامي الحد تحسبه % صبحا ، عليه دم الأبطال كالشفق % 36(@)(@@) % آلى على غمده ألا يراجعه % إلا إذا عاد محمرا من العلق % 37(@)(@@) % فاستبشرت فئة الإسلام ، إذ لمعت % ذكرا ، إذا قبض الله الأنام بقي % % 38(@)(@@) % وأصبح العدل مرفوعا على نشز ، % لما وليت ، وبات الجور في نفق % 39(@)(@@) % كم قد قطعت إليك البيد ممتطيا % عزما إذا ضاق رحب الأرض لم يضق % 40(@)(@@) % يدلني في الدجى مهري ويؤنسني % % حد الحسام ، إذا ما بات معتنقي % % PageV01P149 41(@)(@@) % والليل أطول من عذل العذول على % % سمعي ، وأظلم من مرآه في حدقي % % 42(@)(@@) % أهدي قلائد أشعار فرائدها % % در نهضت به من أبحر عمق % 43(@)(@@) % يضمها ورق لولا محاسنه % ما لقبوا الفضة البيضاء بالورق % 44(@)(@@) % نظمتها فيك ديوانا أزف به % مدائحا في سوى علياك لم ترق % 45(@)(@@) % ولو قصدت به تجديد وصفكم % لكان ذلك منسوبا إلى الحمق % 46(@)(@@) % % ومثلها عدد الأبيات في النسق % 47(@)(@@) % لم أقتنع بالقوافي في أواخرها ، % حتى لزمت أواليها ، فلم تعق % 48(@)(@@) % ما أدركت فصحاء العرب غايتها % % قبلي ، ولا أخذوا في مثلها سبقي % % 49(@)(@@) % جرت لتركض في ميدان حومتها % % قوم فأوقفتهم في أول الطلق % 50(@)(@@) % فليحسن العذر في إيرادهن ، إذا % % رأيت جري لساني غير منطلق % PageV01P150 51(@)(@@) % فلو رأت بأسك الآساد لاضطربت % به فرائصها من شدة الفرق % 52(@)(@@) % يا آل أرتق ! لولا فيض جودكم % لدام 
ms45	 خرق المعالي غير مرتتق % 53(@)(@@) % لقد رفعتم بإسداء الجميل لكم % % ذكرا ، غذا قبض الله الأنام بقي % % 54(@)(@@) % لا زال يهمي على الوفاد نائلكم ، % بوابل من سحاب الجود مندفق % PageV01P151 البحر : رجز تام 1(@)(@@) % دارت على الدوح سلاف القطر % فرنحت أعطافه بالسكر % 2(@)(@@) % ونبه الورق نسيم الفجر ، % فغردت فوق الغصون الخضر % 3(@)(@@) % تغني عن العود وصوت الزمر % % 4(@)(@@) % تبسمت مباسم الأزهار ، % وأشرق النوار بالأنوار % 5(@)(@@) % وظل عقد الطل في نثار ، % وباكرتها ديم الأمطار % 6(@)(@@) % فكللت تيجانها بالدر % % 7(@)(@@) % قد أقبلت طلائع الغيوم % إذ أذن الشتاء بالقدوم % 8(@)(@@) % فمذ حداها سائق النسيم ، % عفت ربى العقيق والغميم % 9(@)(@@) % وباكرت أرض ديار بكر % % 10(@)(@@) % أما ترى الغيم الجديد قد أتى % % مبشرا بالقرب من فصل الشتا % % PageV01P152 11(@)(@@) % فاعقر همومي بالعقار ، يا فتى ، % فترك أيام الهنا إلى متى ؟ % 12(@)(@@) % فإنها محسوبة من عمري % % 13(@)(@@) % فانهض لنهب فرصة الزمان ، % فلست من فجواه في أمان % 14(@)(@@) % واشرب على النايات والمثاني ، % إن الخريف لربيع ثان % 15(@)(@@) % فاتمم حلاه بكؤوس الخمر % % 19(@)(@@) % فصل لنا في طيه سعود ، % بعوده أفراحنا تعود % 20(@)(@@) % يقدم فيه الطائر البعيد ، % في كل يوم للرماة عيد % 21(@)(@@) % كأنه بالصرع عيد النحر % % 22(@)(@@) % هذي الكراكي نحونا قد قدمت % فاقدة لإلفها قد عدمت % 23(@)(@@) % لو علمت بما تلاقي ندمت ، % فانظر إلى أخياطها قد نظمت % PageV01P153 24(@)(@@) % شبه حروف نظمت في سطر % % 25(@)(@@) % تذكرت مرتعها ، فشاقها ، % فأقبلت حاملة أشواقها % % 26(@)(@@) % تجيل في مطارها أحداقها ، % تمد من حنينها أعناقها % % 27(@)(@@) % لم تدر أن مداها للجزر % % 28(@)(@@) % يا سعد كن في حبها مساعدي ، % فإنه مذ عشت من عوائدي % % 29(@)(@@) % ولا تلم من بات فيها حاسدي ، % فلو ترى طير عذار خالد % 30(@)(@@) % أقمت في حب العذار عذري % % 31(@)(@@) % طير بقدر أنجم السماء ، % مختلف الأشكال والأسماء % 32(@)(@@) % إذا جلا الصبح دجى الظلماء ، % يلوح من فوق طفيح الماء % 33(@)(@@) % شبه نقوش خيلت في ستر % % PageV01P154 34(@)(@@) % في لجة الأطيار كالعساكر ، % فهن بين وارد وصادر % 35(@)(@@) % جليلها ناء عن الأصاغر ، % محدودة منذ عهود الناصر % 36(@)(@@) % معدودة في أربع 
ms46	 وعشر % % 37(@)(@@) % شبيطر ومرزم وكركي ، % وصنف تم مع إوز تركي % % 38(@)(@@) % ولغلغ يشبه لون المسك ، % والكي والعناز ، يا ذا الشك % 39(@)(@@) % ثم العقاب ملحق بالنسر % % 40(@)(@@) % ويتبع الأرنوق صنف مبدع ، % أنيسة إنسية إذ تصرع % 41(@)(@@) % والضو والحبرج فهي أجمع ، % خمس وخمس كملت وأربع % 42(@)(@@) % كأنها أيام عمر البدر % % 43(@)(@@) % فابكر إلى دجلة ، والأقطاع ، % فإنها من أحد المساعي % % PageV01P155 44(@)(@@) % واعجب لما فيها من الأنواع % من سائر الخليل والمراعي % % 45(@)(@@) % وضجة الشيق وصوت الخضر % % 46(@)(@@) % ما بين تم ناهض وواضع % وبين نسر طائر وواقع % 47(@)(@@) % وبين كي خارج وراجع ، % ونهضة الطير من المراتع % 48(@)(@@) % كأنها أقطاع غيم تسري % % 49(@)(@@) % أما ترى الرماة قد ترسموا ، % ولارتقاب الطير قد تقسموا % % 50(@)(@@) % بالجفت قد تدرعوا وعمموا % % لما على سفك دماها صمموا % % 51(@)(@@) % جاؤوا إليها في ثياب حمر % % 52(@)(@@) % قد فزعوا عن كل عرب وعجم % وأصبحوا بين الطراف والأجم % 53(@)(@@) % من كل نجم بالسعود قد نجم % وكل بدر بالشهاب قد رجم % PageV01P156 54(@)(@@) % عن كل محنتي شديد الظهر % % 55(@)(@@) % محنية في رفعها قد أدمجت ، % أدركها التثقيف لما عوجت % 56(@)(@@) % قد كبست بيوتها وسرجت % كأنها أهلة قد أخرجت % 57(@)(@@) % بنادقا مثل النجوم الزهر % % 58(@)(@@) % قد جودت أربابها متاعها ، % وأتعبت في حزمها صناعها % % 59(@)(@@) % وهذبت رماتها طباعها ، % إذا لمست خابرا أقطاعها % % 60(@)(@@) % حسبتها مطبوعة من صخر % % 61(@)(@@) % إذا سمعت صرخة الجوارح % تصبو إلى أصواتها جوارحي % % 62(@)(@@) % وإن رأيت أجم البطائح ، % ولم أكن ما بينها بطائح % 63(@)(@@) % يضيق عن حمل الهموم صدري % % PageV01P157 64(@)(@@) % من لي بأني لا أزال سائحا ، % بين المرامي غاديا ورائحا % % 65(@)(@@) % لو كان لي دهري بذاك سامحا ، % فالقرب عندي أن أبيت نازحا % % 66(@)(@@) % أقطع في البيداء كل قفر % % 67(@)(@@) % نذرت للنف ، إذا تم الهنا ، % وزمت العيس لإدراك المنى % % 68(@)(@@) % أن أقرن العز لديها بالغنى % % حتى رأت أن الرحيل قد دنا % % 69(@)(@@) % فطالبتني بوفاء نذري % % 70(@)(@@) % تقول لي لما جفاني غمضي ، % وأنكرت طول مقامي أرضي % % 71(@)(@@) % وعاقني صرف الردى عن نهضي : % ما لليالي أولعت بخفضي % % 72(@)(@@) % كأنها بعض 
ms47	 حروف الجر % % 73(@)(@@) % فانهض ركاب العزم في البيداء ، % وأزور بالعيس عن الزوراء % PageV01P158 74(@)(@@) % ولا تقم بالموصل الحدباء ، % إن شهاب القلعة الشهباء % 75(@)(@@) % يحرق شيطان صروف الدهر % % 76(@)(@@) % نجم به الأنام تستدل ، % من عز في حماه لا يذل % 77(@)(@@) % في القر شمس والمصيف ظل ، % وبل على العفاة مستهل % 78(@)(@@) % أغنى الأنام عن هتون القطر % % 79(@)(@@) % لو قابل الأعمى غدا بصيرا ، % ولو رأى ميتا غدا منشورا % % 80(@)(@@) % ولو يشا الظلام كان نورا ، % ولو أتاه الليل مستجيرا % % 81(@)(@@) % أمنه من سطوات الفجر % % 82(@)(@@) % لذ بربوع الملك المنصور ، % محيي الأنام قبل نفخ الصور % 83(@)(@@) % باني العلا ، قبل بنا القصور ، % قاتل كل أسد هصور % PageV01P159 84(@)(@@) % ملكه الله زمام النصر % % 85(@)(@@) % ملك كأ ، المال من عداته ، % يرى حياة الذكر في مماته % 86(@)(@@) % قد ظهر العز على أوقاته ، % وأشرق النور على ليلاته % 87(@)(@@) % كأنها بعض ليالي القدر % % 88(@)(@@) % أصبح في الأرض لنا خليفة ، % نعز في أربعه المألوفه % % 89(@)(@@) % قد سمحت أكفه الشريفه ، % وألهمت عزمته المنيفه % % 90(@)(@@) % بكسر جبار وجبر كسر % % 91(@)(@@) % يخضع هام الدهر فوق بابه ، % وتسجد الملوك في أعتابه % % 92(@)(@@) % وتخدم الأقدار في ركابه ، % تروم فضل العز من جنابه % % 93(@)(@@) % وتستمد اليسر بعد العسر % % PageV01P160 94(@)(@@) % محكم ناء عن الأغراض ، % وجوهر خال من الأعراض % 95(@)(@@) % يهاب كالساخط وهو راض ، % قد مهدت أراؤه الأراضي % % 96(@)(@@) % وأهلكت كفاه جيش الفقر % % 97(@)(@@) % لما رأى أيامه جنودا ، % والناس في أعتابه سجودا % % 98(@)(@@) % أرادي دولته مزيدا ، % فأعتقت أكفه العبيدا % % 99(@)(@@) % واستعبدت بالجود كل حر % % 100(@)(@@) % يا ملكا تحسده الأملاك ، % وتقتدي بعزمه الأفلاك % 101(@)(@@) % يهابه الأعراب والأتراك ، % له بما تضمره إدراك % 102(@)(@@) % كأنه موكل بالسر % % 103(@)(@@) % قربي إليكم لا العطاء سولي ، % وودكم لا غيره مأمولي % % PageV01P161 104(@)(@@) % إذا جليت كاعب الفصول % % لا أبتغي مهرا سوى القبول % 105(@)(@@) % إن القبول لا لأجل مهر % % 106(@)(@@) % لا برحت أفراحكم مجددة ، % وأنفس الضد بكم مهدده % % 107(@)(@@) % وأربع المجد بكم مشيده ، % والأرض من آرائكم ممهده % % 108(@)(@@) % والدهر بالأمن ضحوك الثغر % % PageV01P162 البحر : كامل تام 1(@)(@@) % لا تخش يا ربع الحبيب 
ms48	 همودا ، % فلقد أخذت على العهاد عهودا % % 2(@)(@@) % وليفنين ثراك عن صوب الحيا % % صوب المدامع إن طلبت مزيدا % % 3(@)(@@) % كما غادرت بفناك ، يوم وداعنا ، % سحب المدامع منهلا مورودا % % 4(@)(@@) % ولكم سكبت عليك وافر أدمعي ، % في ذلك اليوم الطويل مريدا % % 5(@)(@@) % ولقد عهدت بك الظباء سوانحا ، % بظلال شعبك ، والحسان الغيدا % % 6(@)(@@) % حورا ، إذا غوزلن كن جآذرا ؛ % وإذا أردن الفتك كن أسودا % % 7(@)(@@) % أخجلن زهر الأقحوان مباسما % زهرا وضاهين الشقيق خدودا % % 8(@)(@@) % وحسدن كثبان النقا وغصونه ، % فثقلن أردافا ومسن قدودا % % 9(@)(@@) % من كل واضحة ، إذا هي أقبلت % عاينت درا في الثغور نضيدا % % 10(@)(@@) % حذرت عيون العاشقين فصيرت % برج الهلال تمائما وعقودا % % PageV01P163 11(@)(@@) % كم قد سهرت الليل أرقب زورة % منها ، فلم أر للصباح عمودا % % 12(@)(@@) % ورعيت أنجمه فأكسبت السها % % فكأنما كسيت بهن جلودا % % 13(@)(@@) % وحملت أعباء الغرام وثقله ، % فردا ، وحاربت الزمان وحيدا % % 14(@)(@@) % فجعلت نجم الدين سهمي عندما % % عاينت شيطان الخطوب مريدا % % 15(@)(@@) % نجم تدين له النجوم خواضعا ، % ملك تخر له الملوك سجودا % % 16(@)(@@) % غيث يريك من السيوف بوارقا ، % ومن الجياد زلازلا ورعودا % % 17(@)(@@) % يقظان ألقى في حبائل عزمه % شركا يصيد بها الكماة الصيدا % % 18(@)(@@) % رأي يرى ما تحت أطباق الثرى ، % وعلا تريد إلى السماء صعودا % % 19(@)(@@) % وعد الصوارم أن يقد بها الطلا ، % وعدا أراه للعداة وعيدا % % 20(@)(@@) % ما شدد النون الثقيل لأنه % إن قال يسبق فعله التأييدا % % PageV01P164 21(@)(@@) % يا أيها الملك الذي ملك الورى ، % فغدت لدولته العباد عبيدا % % 22(@)(@@) % وافيت ، إذ مات السماح وأهله ، % فأعدته خلقا لديك جديدا % % 23(@)(@@) % وقدمت نحو ديار بكر مظهرا % عدلا يمهد أرضها تمهيدا % % 24(@)(@@) % عطلت ، فولا أن ذلك جوهر % لله ، ما حلى لها بك جيدا % % 25(@)(@@) % كم غارة شعواء حين شهدتها ، % أعطيت فيها النصر والتأكيدا % % 26(@)(@@) % في نارها كنت الخليل ، وإنما % % عند التماس حديدها داودا % % 27(@)(@@) % أخفيت وجه الأرض من جثث العدى % % حتى جعلت لك الوحوش وفودا % % 28(@)(@@) % زوجت أبكار العدى بنفوسهم ، % وجعلت أطراف الرماح شهودا % % 29(@)(@@) % كفروا ، فأمنت الرؤوس لأنها % % خرت لسيفك ركعا وسجودا % % 30(@)(@@) % وبغوا ، فولكت 
ms49	 الحمام بحربهم ، % ثم ارتضيت له السيوف جنودا % % PageV01P165 31(@)(@@) % ضاقت على القتلى الفلاة بأسرها ، % % 32(@)(@@) % ياويح قوم أغضبوك بجهلهم ، % ورأوا قريب الفتح منك بعيدا % % 33(@)(@@) % وتحصنوا في قلعة لم يعلموا % % أن سوف تشهد يومها الموعودا % % 34(@)(@@) % حتى رميت حصونها بكتائب % شهب ، وقدت لها الجياد القودا % % 35(@)(@@) % بقساور قلت عديدا في اللقا ، % ومن الشجاعة أن تقل عديدا % % 36(@)(@@) % من فتية كسروا غمود سيوفهم ، % واستبدلوا قلل الرؤوس غمودا % % 37(@)(@@) % رفضوا الدروع عن الجسوم ، وأسبغوا % % فوق الجسوم من القلوب حديدا % % 38(@)(@@) % مروا بها حزر العيون ، فأوجست % جزعا ، وكادت بالكماة تميدا % % 39(@)(@@) % لو لم يورد خدها منهم حيا ، % جعلوا الدماء لخدها توريدا % % 40(@)(@@) % قذفت بمن فيها إليك ، كأنما % % علمتها من راحتيك الجودا % % PageV01P166 41(@)(@@) % قالوا ، وقد وجدوا لبأسك رهبة % ومخافة تذر الفصيح بليدا % % 44(@)(@@) % سألوا البقاء ، فكان مانعك الحيا % % من أن يرى لك سائل مردودا % % 45(@)(@@) % لو شئت ما أبقت صفاحك يافعا % منهم ، ولا تركت قناك وليدا % % 46(@)(@@) % نبذوا السلاح مخافة لما رأوا % % رايات جيشك قد ملأن البيدا % % 47(@)(@@) % طنوا السحاب ، إذا نشأن ، عجاجة ، % والبرق بيضا ، والرعود بنودا % % 48(@)(@@) % سكروا وما سكروا بكأس مدامة ، % لكن عذاب الله كان شديدا % % 49(@)(@@) % ورأوك معتصم العزائم فاختشوا % % بك يوم عمورية المشهودا % % 50(@)(@@) % أوليتهم لما أطاعوا أنعما % لا تستطيع لبعضها تحديدا % % 51(@)(@@) % فانظر تجد مع كل نفس منهم % من فيض برك سائقا وشهيدا % % 52(@)(@@) % أكسبت أفق الملك ، يا نجم الهدى ، % نورا جلا ظلم الخطوب السودا % % PageV01P167 53(@)(@@) % وطردت جور الحادثات عن الورى ، % ولكم أجرت من الزمان طريدا % % 54(@)(@@) % ما دام جودك يا ابن أرتق واصلي ، % من شاء يمنحني جفا وصدودا % % 55(@)(@@) % ما فك مدحي فيك قيد تعبدي ، % إلا وضعت من النوال قيودا % % 56(@)(@@) % لازلت محسودا على نيل العلى ، % فدوام عزك أن ترى محسودا % % PageV01P168 البحر : كامل تام 1(@)(@@) % كيف الضلال وصبح وجهك مشرق ، % وشذاك في الأكوان مسك يعبق % 2(@)(@@) % يا من إذا سفرت محاسن وجهه ، % ظلت به حدق الخلائق تحدق % 3(@)(@@) % أوضحت عذري في هواك بواضح % ماء الحيا بأديمه يترقرق % 4(@)(@@) % فإذا 
ms50	 العذول رأى جمالك قال لي : % عجبا لقلبك كيف لا يتمزق % 5(@)(@@) % أغنيتني بالفكر فيك عن الكرى ، % يا آسري ، فأنا الغني المملق % 6(@)(@@) % يا آسرا قلب المحب ، فدمعه ، % والنوم منه مطلق ومطلق % 7(@)(@@) % لولاك ما نافقت أهل مودتي ، % وظللت فيك نفيس عمري أنفق % 8(@)(@@) % وصحبت قوما لست من نظرائهم ، % فكأنني في الطرس سطر ملحق % 9(@)(@@) % قولا لمن حمل السلاح ، وخصره % % من قد ذابله أدق وأرشق % 10(@)(@@) % لا توه جسمك بالسلاح وثقله ، % إني عليك من الغلالة أشفق % PageV01P169 11(@)(@@) % حسدت أهيل ديار بكر منطقي % % نار يخر لها الكليم ويصعق % 12(@)(@@) % تلقاه ، وهو مزرد ومدرع ، % وتراه ، وهو مقرط ومقرطق % 13(@)(@@) % لم تترك الأتراك بعد جمالها % % حسنا لمخلوق سواها يخلق % 14(@)(@@) % إن نوزلوا كانوا أسود عريكة ، % أو غوزلوا كانوا بدورا تشرق % 15(@)(@@) % قوم ، إذا ركبوا الجياد ظننتهم % أسدا بألحاظ الجآذر ترمق % 16(@)(@@) % قد خلقت بدم لقلوب خدودهم ، % ودروعهم بدم الكماة تخلق % % 17(@)(@@) % جذبوا القسي إلى قسي حواجب ، % من تحتها نبل اللواحظ ترشق % 18(@)(@@) % نشروا الشعور ، فكل قد منهم % لدن ، عليه من الذوائب سنجق % 19(@)(@@) % لي منهمث رشأ ، إذا غازلته % كادت لواحظه بسحر تنطق % 20(@)(@@) % إن شاء يلقاني بخلق واسع ، % عند السلام ، نهاه طرف ضيق % PageV01P170 21(@)(@@) % لم أنس ليلة زارني ورقيبه % يبدي الرضا ، وهو المغيظ المحنق % 22(@)(@@) % وافى ، وقد أبدى الحياء بوجهه % ماء ، له في القلب نار تحرق % 23(@)(@@) % أمسى يعاطيني المدام ، وبيننا % % عتب ألذ من المدام وأروق % 24(@)(@@) % حتى إذا عبث الكرى بجفونه % % كان الوسادة ساعدي والمرفق % 25(@)(@@) % عانقته ، وضممته ، فكأنه % من ساعدي مطوق وممنطق % 26(@)(@@) % حتى بدا فلق الصباح ، فراعه ؛ % إن الصباحض هو العدو الأزرق % 27(@)(@@) % فهناك أوما للوداع مقبلا % كفي ، وهي بذيله تتعلق % 28(@)(@@) % يا من يقبل للوداع أناملي ! % إني إلى تقبيل ثغرك أشوق % 29(@)(@@) % % للعاشقين غراب بين ينعق % 30(@)(@@) % وغفرت ذنب الدهر حين بدت به % % من طلعة السلطان شمس تشرق % PageV01P171 31(@)(@@) % المالك المنصور ، والملك الذي % % من خوفه طرف النوائب مطرق % 32(@)(@@) % نجم له فلك السعادة مطلع ، % بدر له أفق المعالي مشرق % 33 
ms51	(@)(@@) % من معشر حازوا الفخار بسعيهم ، % وبنى لهم فلك المعالي أرتق % 34(@)(@@) % قوم هم الدهر العبوس ، إذا سطوا ، % وإذا سخوا ، فهم السحاب المغدق % 35(@)(@@) % وإذا استغاث المستغيث تسرعوا ؛ % وإذا استجار المستجير ترفقوا % % 36(@)(@@) % ملك تحف به الملوك ، كأنه % بدر به زهر الكواكب تحدق % 37(@)(@@) % قد ، ظللته سحابة من خيره ، % تسري ، وآيته السماح المطلق % 38(@)(@@) % والقبة العلياء ، والطير الذي % % من حوله رايات نصر تخفق % 39(@)(@@) % % يفلى ، به فود الفلا والمفرق % 40(@)(@@) % فلوحشها أجناده وجياده ، % ولطيرها بازيه والزرق % PageV01P172 41(@)(@@) % ملك يجل عن العيان ، فنغتدي % % بقلوبنا ، لا بالنواظر ، نرمق % 42(@)(@@) % فإذا تطلع قلت ليث ناظر ؛ % وإذا تفكر قل صل مطرق % 43(@)(@@) % كالشمس ، إلا ، أنه لا يختفي ، % والبدر ، إلا أنه لا يمحق % 44(@)(@@) % والغيث ، إلا أنه لا ينتهي ، % % 45(@)(@@) % والسيف ، إلا أنه لا ينثني ، % % 46(@)(@@) % والدهر ، إلا أنه لا يعتدي ، % والبحر ، إلا أنه لا يزهق % 47(@)(@@) % ترجى فوائده ، ويخشى بأسه ، % كالنار تمنحك الضياء وتحرق % 48(@)(@@) % % بالبيض في يوم الكريهة ألبق % 49(@)(@@) % كف لما حفظ اليراع مضيعة ، % ولما تجمعه الصفاح تفرق % 50(@)(@@) % لا يحتوي الأموال ، إلا مثلما % % يحوي بأطراف البنان الزيبق % PageV01P173 51(@)(@@) % جرت الملوك لسبق غايات العلى ، % فمشمر في جريه ومحلق % 52(@)(@@) % حتى إذا نكص المكافح جاءها % % متهاديا في خطوه يترفق % 53(@)(@@) % يا من به شرفت معاقد تاجه ، % وبها يشرف من سواه المفرق % 54(@)(@@) % أنست بمقدمك العراق وأهلها ، % واستوحشت لك حرزم والجوسق % 55(@)(@@) % أرض تحل بربعها فلباسنا % % من سندس وفراشنا الإستبرق % 56(@)(@@) % فالناس تستسقي الغمام ومن بها % % يدعو الإله بأنه لا يغرق % 57(@)(@@) % يا من يقايس ماردين بجلق % بعد القياس وأين منه جلق % 58(@)(@@) % لم يذكر الشهباء في سبق العلى ، % إلا كبت شقراؤها والأبلق % 59(@)(@@) % كم ماردين لماردين تواثبوا ، % ومن المحال طلاب ما لا يلحق % 60(@)(@@) % % سور لها ، ودم الفوارس خندق % PageV01P174 61(@)(@@) % وتجمعوا حتى مددت لهم يدا ، % في كل خافقة لواء يخفق % 62(@)(@@) % ما أنت يوم السلم غلا واحد % فرد ، وفي يوم الكريهة فيلق % 63(@)(@@) % أغلقت باب العذر مع تصحيفه ، % % 64(@)(@@) % مولاي سمعا من وليك مدحة 
ms52	 % عن صدق ودي في علاكم تنطق % 65(@)(@@) % أنا عبد أنعمك القديم وداده ، % وسواي في أقواله يتملق % 66(@)(@@) % عبد مقيم بالعراق ومدحه % فيكم يغرب تارة ويشرق % 67(@)(@@) % فلقد وقفت على علاك بدائعا % يعيا بأيسرها النصيح المفلق % 68(@)(@@) % من كل هيفاء الكلام رشيقة % في طيها معنى أدق وأرشق % 69(@)(@@) % % فيها ، كما حسد الهزار اللقلق % 70(@)(@@) % أعيت أكابرهم أصاغر لفظها ، % ولربما أعيا الرخاخ البيدق % PageV01P175 71(@)(@@) % جاؤوك باللفظ المعاد لأنني % % غربت في طلب الغريب وشرقوا % % 72(@)(@@) % لهم بذاك جبلة جبلية ، % ولنا عراق والفصاحة معرق % 73(@)(@@) % ما كنت أرضى بالقريض فضيلة ، % لكن رأيت الفضل عندك ينفق % 74(@)(@@) % قالوا : خلقت موفقا لمديحه ، % فأجبتهم : إن السعيد موفق % 75(@)(@@) % إني ليقنعني القبول إجازة ، % إن التصدق بالوداد تصدق % 76(@)(@@) % لا زال أمرك بالسعادة نافذا % في الأرض تمنع من تشاء وترزق % PageV01P176 البحر : رمل تام 1(@)(@@) % شق جيب الليل عن نحر الصباح % أيها الساقون % 2(@)(@@) % وبدا للطل في جيد الأقاح % لؤلؤ مكنون % 3(@)(@@) % ودعانا للذيذ الإصطباح % طائر ميمون % 4(@)(@@) % فاخضب المبزل من نحر الدنان % % بدم الزرجون % 5(@)(@@) % تتلقى دمها حور الجنان % في صحاف جون % 6(@)(@@) % فاسقنيها قهوة تكسو الكؤوس % بسنا الأنوار % 7(@)(@@) % وتميت العقل ، إذ تحيي النفوس % راحة الأسرار % 8(@)(@@) % غرست كرمتها بين القيان % يد أفلاطون % 9(@)(@@) % وبماء الصرح قد كان يطان % دنها المخزون % 10(@)(@@) % اخبرتنا عن بني العصر القديم % خبرا مأثور % PageV01P177 11(@)(@@) % وروت يوم مناجاة الكليم % كيف دك الطور % 12(@)(@@) % ولماذا أتخذت أهل الرقيم % كهفها المذكور % 13(@)(@@) % وندا يونس عند الإمتحان % بالتقام النون % 14(@)(@@) % مذ جلا شمس الضحى بدر التمام % في الليالي السود % 15(@)(@@) % وغدا يصبغ أذيال الظلام % بدم العنقود % 16(@)(@@) % قلت يا بشراكم هذا غلام % وفتاة رود % 17(@)(@@) % مزجا الكأس رواحا يسقيان % في حمى جيرون % 18(@)(@@) % فبذلنا في القناني والقيان % ما حوى قارون % 19(@)(@@) % نال فعل الخمر من ذات الخمار % عند شرب الراح % 20(@)(@@) % فغدت تستر من فرط الخمار % وجهها الوضاح % PageV01P178 21(@)(@@) % خلتها ، إذ لم تدع بالإختمار % غير صلت لاح % 22(@)(@@) % قمرا تم لسبع وثمان ، % في الليالي الجون % 23 
ms53	(@)(@@) % قدرته الشمس في حال القران % فهو كالعرجون % % 24(@)(@@) % أفعم الزامر بالنفخ المدار % نايه المخصور % 25(@)(@@) % فغدا ، وهو لأموات الخمار % مثل نفخ الصور % 26(@)(@@) % أو كما عاش الورى بعد البوار % بندى المنصور % 27(@)(@@) % ملك هذب أخلاق الزمان % عدله المسنون % 28(@)(@@) % وأعاد الناس في ظل الأمان % عضبه المسنون % 29(@)(@@) % ملك أنجد طلاب الندى % % غاية الإنجاد % 30(@)(@@) % متلف ، إن جال ، آجال العدى % % واللهي إن جاد % PageV01P179 31(@)(@@) % مهد الأرضين بالعدل ، فكان % أمنها مضمون % 32(@)(@@) % ذيبها والشاة ترعى في مكان ، % غدره مأمون % 33(@)(@@) % باذل الأموال من قبل السؤال % بأكف الجود % 34(@)(@@) % ما رجاه آمل إلا ونال % غاية المقصود % 35(@)(@@) % فإذا ما أمه راجي النوال % سادة أنجاد % 36(@)(@@) % يهب الولدان والحور الحسان % في بيوت النار % 37(@)(@@) % وسواه إن دعاه ذو لسان % يمنع الماعون % 38(@)(@@) % يا مليكا لبني الدر ملك ، % فشرى الأحرار % 39(@)(@@) % ملك أنت عظيم أم ملك % ساطع الأنوار % 40(@)(@@) % بالذي تختاره دار الفلك ، % وجرى المقدار % PageV01P180 41(@)(@@) % مذ رأى بأسك سلطان الأوان ، % وهو كالمحزون % 42(@)(@@) % حاول النصر كموسى ، فاستعان % بك يا هارون % PageV01P181 البحر : كامل تام 1(@)(@@) % حوشيت من زفرات قلبي الواله ، % وكفيت ما يلقاه من بلباله % 2(@)(@@) % وأعيذ سرك أن يكابد بعض ما % % لاقيت من قيل العذول وقاله % 3(@)(@@) % يا من يعير الغصن لين قوامه ، % ويغير بدر التم عند كماله % 4(@)(@@) % ما حلت الواشون ما عقد الهوى ، % تفنى الليالي والغرام بحاله % 5(@)(@@) % صل عاشقا لولاك ما ذكر الحمى ، % ولما غدا متغزلا بغزاله % 6(@)(@@) % واجعل كناسك في القلوب ، فإنها % % تغنيك عن شيح العذيب وضاله % 7(@)(@@) % لله بالزوراء ليلتنا ، وقد % جردت غصن البان من سرباله % 8(@)(@@) % ورشفت برد الراح من معسوله ، % وضممت قد اللدن من عساله % 9(@)(@@) % رشأ كبدر التم في إشراقه ، % وكمال طلعته وبعد مناله % 10(@)(@@) % ما اهتز وافر ردفه في خطوه ، % إلا تشكى الخصر من أثقاله % PageV01P182 11(@)(@@) % ما باله أضحى يشين وعيده % بنجازه ووعوده بمطاله % 12(@)(@@) % ويذيقني طعم الملال تدللا ، % فأذوب بين دلاله وملاله % 13(@)(@@) % ما ضر طيف خياله لو أنه % يسخو علي ، ولو بطيف خياله 
ms54	 % 14(@)(@@) % ما كان من فعل الجميل يضره ، % لو كان يجعله زكاة جماله % 15(@)(@@) % قسما بضاد ضياء صبح جبينه ، % ووحق سين سواد عنبر خاله % 16(@)(@@) % لأكابدن لهيب نار صدوده ، % ولأركبن عباب بحر ملاله % 17(@)(@@) % ولأحملن اليم فرط عذابه ، % وأدوم مصطبرا على أهواله % 18(@)(@@) % حتى تقول جميع أرباب الهوى : % هذا الذي لا ينتهي عن حاله % 19(@)(@@) % في ظل ملك ، مذ حللت بربعه ، % قتل الأسود ، وما دنت لقتاله % 20(@)(@@) % رشأ تفرد في المحاسن فاغتدى % % تفصيل رسم الحسن في إجماله % PageV01P183 21(@)(@@) % ما حركت سكنات فاتر طرفه ، % إلا وأصمى القلب وقع نباله % 22(@)(@@) % حكمت فجارت في القلوب لحاظه % كأكف نجم الدين في أمواله % 23(@)(@@) % المالك المنصور ، والملك الذي % % تخشى النجوم الشهب شهب نصاله % 24(@)(@@) % ملك يسير النصر عن تلقائه ، % وورائه ، ويمينه ، وشماله % 25(@)(@@) % ملك تتون الأرض إذ يمشي بها : % حسبي من التشريف مس نعاله % 26(@)(@@) % فإذا دعا الدهر العبوس أجابه % متعثرا بالرعب في أذياله % 27(@)(@@) % سلطان عصر عزمه راض الورى ، % فكفاه ماضيه عن استقباله % 28(@)(@@) % أضحى حمى الحدباء عند إيابه ، % يستنجد الإقبال من إقباله % 29(@)(@@) % ضرب الخيام على الحمى ، فأكفه % كمياهه ، وحلومه كجباله % 30(@)(@@) % أعطى وأجزل في العطاء تبرعا ، % حتى سئمت نزاله بنواله % PageV01P184 31(@)(@@) % ذلت صروف الدهر لما عاينت ، % دون الأنام ، تعلقي بحباله % 32(@)(@@) % وافيته ، وكأنني من رقه ، % فأعزني ، فكأنني من آله % 33(@)(@@) % يا ليت قومي يعلمون بأنني % % أدركت طيب العيش بعد زواله % 34(@)(@@) % ما ضل فكري في جميل صفاته ، % إلا اهتدى شعري بحسن خلاله % 35(@)(@@) % أو أصدأ الأيام سيف قريحتي ، % إلا جعلت مديحه كصقاله % 36(@)(@@) % يا أيها الملك الذي غدت العلى % % مقرونة بجلاده وجداله % 37(@)(@@) % أغرقت بالإنعام عبدك ، فاغتدى ، % من بحرك التيار ، در مقاله % 38(@)(@@) % طوقته بنداك طوق كرامة ، % وجعلت فيض الجود من أغلاله % 39(@)(@@) % أصفى لمحض ولاك عقد ضميره ، % فسوى مديحك لا يمر بباله % PageV01P185 البحر : مجزوء الخفيف 1(@)(@@) % خذ من الدهر لي نصيب ، % واغتنم غفلة القدر % 2(@)(@@) % ليس طول المدى نصيب % صفو عيش بلا كدر % 3(@)(@@) % فاجل لي كاعبا عروس ، % لم ترعها يد 
ms55	 المزاج % 4(@)(@@) % نشرها عطر الكؤوس ، % وكسا نورها الزجاج % 5(@)(@@) % في الضحى تشبه الشموس % وهي تحت الدجى سراج % 6(@)(@@) % فارشف الراح ، يا حبيب ، % إن في ذاك معتبر % 7(@)(@@) % لترى الشمس ، إذ يغيب % نورها في فم القمر % 8(@)(@@) % في رياض بها الشقيق ، % قد جلا بهجة التمام % 9(@)(@@) % وزها زهرها الأنيق ، % إذ بكت أعين الغمام % 10(@)(@@) % وانثنى غصنها الوريق ، % فشدت فوقه الحمام % PageV01P186 11(@)(@@) % قام شحرورها خطيب ، % راقيا منبر الشجر % 12(@)(@@) % كلما ناح عندليب % نقط الدوح بالزهر % 13(@)(@@) % قم ، فإني أرى الزمان ، % محسنا بعدما أسا % % 14(@)(@@) % قد أضا ليله ، وكان % صحبه يشبه المسا % % 15(@)(@@) % تاه من عجبه ، فلان % صعبه بعدما قسا % % 16(@)(@@) % قد بدا عزه المهيب ، % وبمنصوره انتصر % 17(@)(@@) % ورأى فتحه القريب % من أبي الفتح ينتظر % 18(@)(@@) % ملك أضحك السيوف ، % فبكت أعين العدى % % 19(@)(@@) % جدعت بيضه الأنوف ، % وروت كفه الصدى % % 20(@)(@@) % صارم يمطر الحتوف ، % ويد تمطر الندى % % PageV01P187 21(@)(@@) % لو دعا عزمه النجيب % لقضا الله والقدر % 22(@)(@@) % جاءه طائعا مجيب ، % سامعا ما به أمر % 23(@)(@@) % قد حمى ربعه الحصون ، % فهو للناس ملتجا % % 24(@)(@@) % وإذا خابت الظنون ، % عنده يصدق الرجا % % 25(@)(@@) % المنى فيه والمنون ، % فهو يخشى ويرتجى % % 26(@)(@@) % حبذا ربعه الخصيب % فيه يستبشر البشر % 27(@)(@@) % فاق في جوده الخصيب ، % وسمت أرضه مضر % 28(@)(@@) % قد علا مجده ، فكاد % هامة المجد يرتقي % % 29(@)(@@) % وله أضحت العباد % بين راج ومتقي % % 30(@)(@@) % باسط العدل في البلاد ، % % PageV01P188 31(@)(@@) % ملك صدره رحيب ، % منه يستمطر المطر % 32(@)(@@) % قلبه بالنهى قليب ، % وهو يوم الوغى حجر % 33(@)(@@) % لو رأينا يا ابن الكرام % مثل علياك في الدول % 34(@)(@@) % لنظمنا من الكلام % ضعف ما نظم الأول % 35(@)(@@) % در لفظ من النظام % مخجل سبعها الطول % 36(@)(@@) % فاعتبر ، أيها اللبيب ، % هذه السبعة القصر % 37(@)(@@) % فيكم لفظها يطيب ، % لا بمعنى بها ظهر % PageV01P189 البحر : بسيط تام 1(@)(@@) % في مثل حضرتكم لا يزأر الأسد ، % فكيف يسجع فيها الطائر الغرد % 2(@)(@@) % لذاك أحجم عن قدحي ، فيبعثني % % صدق الولاء ، وإني فيك معتقد % 3(@)(@@) % وكيف أفصح أشعاري لدى ملك ، % يغدو له التبر زيفا حين ينتقد 
ms56	 % 4(@)(@@) % يقظان يقرأ من عنوان فكرته ، % في يومه ، ما طواه في الضمير غد % 5(@)(@@) % بحر ، ولكنه بالدر منفرد ، % والبحر يجمع فيه الدر والربد % 6(@)(@@) % من معشر إن دعوا جادوا لآملهم % قبل السؤال ، وأعطوا فوق ما وجدوا % % 7(@)(@@) % تضاعف الرفد للوفاد راحته ، % فكلما وفدوا من جوده رفدوا % % 8(@)(@@) % عادوا وفي كل عضو بالثناء فم ، % وقد أتو ، وكل بالسؤال يد % 9(@)(@@) % ولو رأوا ما أرى من فرط لذته % بالجود ما شكروا يوما ولا حمدوا % % 10(@)(@@) % يا أيها الملك المنصور طائره ، % ومن بآرائه الأملاك تعتضد % PageV01P190 11(@)(@@) % ومن يسابق بالإنعام ، مبتدئا ، % نطق العفاة ، ويعطي قبل ما يعد % 12(@)(@@) % أنت الفريد الذي حازت خلائقه % ما لا يحيط به الإحصاء والعدد % 13(@)(@@) % وواحد العصر ، حتى لو حلفت به % % يوما ، لما شك خلق أنه الأحد % 14(@)(@@) % لك اليراع الذي إن هز عامله ، % لم تغن عنه صلاب البيض والزرد % 15(@)(@@) % المستطيل ، وي حد الظبي قصر ، % والمستقيم ، وفي قد القنا أود % 16(@)(@@) % إذا اغتدى نافثا بالسحر في عقد ، % حلت ، بنجواه ، من آمالنا العقد % 17(@)(@@) % يقظان منه عيون الناس راقدة ، % ولو توعد أهل الكهف ما رقدوا % % 18(@)(@@) % ربيب سمر المعالي ، وهو يحطمها ، % وربما جر حتف الوالد الولد % 19(@)(@@) % بالأمسش كان بوطء الأسد مرتعدا ، % واليوم منه فريص الأسد ترتعد % 20(@)(@@) % ضم الأسود فما زال الزمان له % ينوي المكافاة حتى ضمه الأسد % PageV01P191 21(@)(@@) % إذا انثنى ساجدا قام الملوك له % طوعا ، وإن قام في أمر لهم سجدوا % % 22(@)(@@) % يا باني المجد من قبل الديار ، ومن % % له المعالي التي لم يرقها أحد % 23(@)(@@) % بنيت بعد بناء المجد ، مبتدئا ، % دارا لها العز أس ، والعلى عمد % 24(@)(@@) % أسست بالدين والتقوى قواعدها ، % فكان عقباك منها عيشة رغد % 25(@)(@@) % دارا توهمتها الدنيا لزينتها ، % وما سمعت بدنيا ضمها بلد % 26(@)(@@) % بها صنائع أبدتها صنائعكم ، % يفنى المدى ، وبها آثاركم جدد % 27(@)(@@) % تدفق الماء في سلسالها ، فحكى % % سماح كفك فينا حين يطرد % 28(@)(@@) % تجمع الأسد فيها والظباء ، كما % % من فرط عدلك يرعى الذئب والنقد % 29(@)(@@) % مولاي ! دعوة عبد غير مفتتن % بشعره 
ms57	 وله الحساد قد شهدوا % % 30(@)(@@) % قد صنت شعري وجل الناس تخطبه ، % وذاك لولاك لم يعبأ به أحد % PageV01P192 31(@)(@@) % والشعر كالتبر يخفى حين تنظره % عين الغبي ، ويغلو حين ينتقد % 32(@)(@@) % فكيف يذهب ما نفع الأنام به ، % منه جفاء ، ويرسو عندك الزبد % 33(@)(@@) % إن شبهوني بمن دوني ، فلا عجب ، % فالدر يشبهه في المنظر البرد % 34(@)(@@) % بك انتصرت على الأيام منتصفا ، % وصار لي فوق أيدي الحادثات يد % 35(@)(@@) % وكيف تعجز كفي أن أنال بها % % هام السماك ، وأنت الباع والعضد % PageV01P193 البحر : كامل تام 1(@)(@@) % ما بين طيفك والجفون مواعد ، % فيفي ، إذا خبرت أني راقد % 2(@)(@@) % إني لأطمع في الرقاد لأنه % شرك يصاد به الغزال الشارد % 3(@)(@@) % فأظل أقنع بالخيال ، وإنه % طمع يولده الخيال الفاسد % 4(@)(@@) % هيات لا يشفي المحب من الأسى % % قرب الخيال ، وربه متباعد % 5(@)(@@) % ولقد تعرض للمحبة معشر % عدموا من اللذات ما أنا واجد % 6(@)(@@) % عابوا ابتهاجي بالغرام ، وإنني % % ما عشت من سكر المحبة مائد % 7(@)(@@) % قالوا : تعشق كل رب ملاحة ، % فأبجتهم : إن المحرك واحد % 8(@)(@@) % فالحسن حيث وجدته في حيز ، % هو لي بأرسان الصبابة قائد % 9(@)(@@) % ما كنت أعلم أن ألحاظ الظبا ، % هي للأسود حبائل ومصايد % 10(@)(@@) % إن الذي خلق البرية ناطها % % بوسائط هي للكمال شواهد % PageV01P194 11(@)(@@) % فتدبر الأفلاك سبعة أنجم ، % ويدبر الأرضين نجم واحد % 12(@)(@@) % نجم له في الملك أنجم عزمة % هن الرجوم ، إذا تطرق مارد % 13(@)(@@) % المالك المنصور ملك جوده % داني المنال ، ومجده متباعد % 14(@)(@@) % المالك لديه مواهب ومكارم ، % هي للعداة مواهن ومكايد % 15(@)(@@) % كالغيث فيه للطغاة زلازل ، % ولمن يؤمله الزلال البارد % 16(@)(@@) % يخشى وترجى بطشه وهباته ، % كالبحر فيه مهالك وفوائد % 17(@)(@@) % آراؤه للكائنات طلائع ، % وهمومه بالغانيات شواهد % 18(@)(@@) % لا يؤيسنك بأسه من جوده ، % دون السحاب بوارق ورواعد % 19(@)(@@) % يهب المطي ، وركبهن وصائف ، % والصافنات ، وحملهن ولائد % 20(@)(@@) % لك يا ابن أرتق بالمكارم نسبة ، % فلذاك جودك كاسم جدك زائد % PageV01P195 21(@)(@@) % أورثت مجد سراة أرتق إذ خلت ، % وبنيته ، فهو الطريف التالد % 22(@)(@@) % قوم تعودت الهبات أكفهم ؛ % إن المكارم للكرام عوائد % 23 
ms58	(@)(@@) % عاشوا ، وفضلهم ربيع للورى ، % فلهم ثنا يحيا وذكر خالد % 24(@)(@@) % فأكفهم ، يوم السماح ، جداول ، % وقلوبهم ، يوم الكفاح ، جلامد % 25(@)(@@) % وكفلت من كلف الزمان بحفظه ، % حتى كأنك للبرية والد % 26(@)(@@) % فيداك في عنق الزمان غلائل ، % ونداك في جيد الأنام قلائد % 27(@)(@@) % وعنيت بي ورفعت قدري في الورى ، % فعواذلي في القرب منك حواسد % 28(@)(@@) % وعلمت أني في محبتك الذي ، % فنداك لي صلة وبرك عائد % 29(@)(@@) % فاعذر محبا إن تباعد شخصه ، % جاءتك منه قصائد ومقاصد % 30(@)(@@) % فإذا ثنائي عنك هم سائق ، % جذب العنان إليك شوق قائد % PageV01P196 31(@)(@@) % ولقد وقفت عليك لفظي كله ، % مما أحل به ، وما أنا عاقد % 32(@)(@@) % فإذا نظمت ، فإنني لك مادح ، % وإذا نثرت ، فإنني لك حامد % PageV01P197 البحر : كامل تام 1(@)(@@) % لاقيتنا ملقى الكريم لضيفه ، % وضممتنا ضم الكمي لسيفه % 2(@)(@@) % وجعلت ربعك للمؤمل كعبة ، % هي رحلة لشتائه ولصيفه % 3(@)(@@) % يا من إذا اشتبه الصواب أعاره % رأيا يخلص نقده من زيفه % 4(@)(@@) % وإذا غزا أرض العدو ، فوحشها % % من وفده ، ونسورها من ضيفه % 5(@)(@@) % هطلت على العافين منك سحائب ، % يغني الولي وليها عن صيفه % 6(@)(@@) % وسماح غيرك خطرة لوساوس ، % فكأنها في النوم زورة طيفيه % 7(@)(@@) % كم مجرم قضت الذنوب بحتفه ، % فغدا يعض بنانه من حيفه % 8(@)(@@) % أمنته من خوفه ، فكأنه % قد حل في الإحرام مسجد خيفه % PageV01P198 البحر : طويل 1(@)(@@) % وليس عجبا إن طغت أعين الحمى ، % وقد أكسبتها الجود أنملك العشر % % 2(@)(@@) % إذا علمت كفاك جلمده الندى ، % فليس لعين لم يفض ماؤها عذر % PageV01P199 البحر : منسرح 1(@)(@@) % لله ملاحك اللبيب ، وقد % % أبدى لنا من فعاله حسنا % % 2(@)(@@) % قد حمل البحر في سفينته ، % وعادة البحر يحمل السفنا % % PageV01P200 البحر : طويل 1(@)(@@) % فتى لم تجد فيه العدى ما يعيبه ، % ولكنهم عابوا الذي عنه قصروا % % 2(@)(@@) % إذا ذمه الأعداء قالوا : مفرط ، % وإن بالغوا بالذم قالوا : مبذر % 3(@)(@@) % وإن شاء قوم أن يعيبوا مكانه % من المجد قالوا : شامخ متعذر % PageV01P201 البحر : وافر تام 1(@)(@@) % ألا بلغ هديت سماة قومي ، % بحلة بابل ، عند الورود % 2(@)(@@) % ألا لا تشغلوا قلبا لبعدي ، % فإني كل 
ms59	 يوم في مزيد % 3(@)(@@) % لأني قد حللت حى ملوك ، % ربوع عبيدهم كهف الطريد % 4(@)(@@) % فمن يك نازلا بحمى كليب ، % فإني قد نزلت حمى الأسود % PageV01P202 البحر : كامل تام 1(@)(@@) % دبت عقارب صدغه في خده ، % وسعى على الأرداف أرقم جعده % 2(@)(@@) % وبدا محياه ، ففوق لحظه % نبلا يذود بشوكه عن ورده % 3(@)(@@) % صنم أضل العاشقين ، فلم يروا ، % مذ لاح ، بدا من عبادة بده % 4(@)(@@) % ما بين إقبال الحياة ووصله % فرق ، ولا بين الحمام وصده % 5(@)(@@) % ظبي من الأتراك ليس بتارك % حسنا لمخلوق أتى من بعده % 6(@)(@@) % غض الحيا ، قحل الوداد ، كأنما % % نهلت بشاشة وجهه من وده % 7(@)(@@) % حمل السلاح على قوام مترف ، % كاد الحرير يؤده من إده % 8(@)(@@) % فترى حمائل سيفه في نحره ، % أبهى وأزهى من جواهر عقده % 9(@)(@@) % من آل خاقان الذين صغيرهم % % في سرجه ، وكأنه في مهده % 10(@)(@@) % جعلوا ركوب الخيل حد بلوغهم ، % هو للفتى منهم بلوغ أشده % % PageV01P203 11(@)(@@) % فإذا صغيرهم أتى متخضبا % بدم الفوارس قيل : بالغ رشده % 12(@)(@@) % سيان منهم في الوقائع حاسر % في سرجه ، أو دارع في سرده % 13(@)(@@) % من كل مسنون الحسام كلحظه ، % أو كل معتدل القناة كقده % 14(@)(@@) % ومخلق بدم الكماة كأنما % % صبغت فواضل درعه من خده % 15(@)(@@) % ومقابل ليل العجاج بوجهه ، % فكأنما غشى الظلام بضده % 16(@)(@@) % ومواجه صدر الحسام ووجهه % يبدي صقالا مثل ماء فرنده % 17(@)(@@) % يلقى الرماح بنهده وبصدره ، % والمرهفات بصدره وبنهده % 18(@)(@@) % وإذا المنية شمرت عن ساقها % % غشي الهياج مشمرا عن زنده % 19(@)(@@) % قرن يخاف قرينه من قربه ، % أضعاف خوف محبه من بعده % 20(@)(@@) % يبدو ، فيزجره العدو بنحسه % خوفا ، ويزجره المحب بسعده % PageV01P204 21(@)(@@) % يردي الكماة بنبله وحسامه : % ذا في كنانته ، وذا في غمده % 22(@)(@@) % حتى إذا لقي الكمي مبارزا % شغلته بهجة حسنه عن رده % 23(@)(@@) % ما زلت أجهد في رياضة خلقه ، % وأحول في هذا العتاب وجده % 24(@)(@@) % حتى تيسر بعد عسر صعبه ، % وافتر مبسم لفظه عن وعده % 25(@)(@@) % وأتى يستر سالفيه بفرعه ، % حذرا ، فيحجب سبطها في جعده % 26(@)(@@) % وغدا يزف من المدامة مثل ما 
ms60	 % % في فيه من خمر الرضاب وشهده % 27(@)(@@) % لاعبته بالنرد ، ثم ، وبيننا % % رهن قد ارتضت النفوس بعقده % 28(@)(@@) % حتى رأيت نقوش سعدي قد بدت ، % ويدي قد حلت تششدر بنده % 29(@)(@@) % فأجل شطرنجي هنالك بعته % بأقل ما أبدته كعبة نرده % 30(@)(@@) % ولقد أروح إلى السرور وأغتدي ، % وأقيل في ظل النعيم وبرده % PageV01P205 31(@)(@@) % وأعاجل العز المقيم ، ولم أبع % نقد المسرة والهناء بفقده % 32(@)(@@) % حتى إذا ما العز قلص ظله ، % ما إن يغيب رأيه عن رشده % 33(@)(@@) % أخمدت بالإدلاج أنفاس الفلا ، % وكحلت طرفي في الظلام بسهده % 34(@)(@@) % بأغر أدهم ذي خجول أربع ، % مبيضها يزهو على مسوده % 35(@)(@@) % خلع الصباح عليه سائل غرة % منه ، وقمصه الظلام بجلده % 36(@)(@@) % فكأنه لما تسربل بالدجى ، % وطىء الضحى فابيض فاضل برده % 37(@)(@@) % قلق المراح ، فإن تلاطم خطوه % % ظن المطارد أنه في مهده % 38(@)(@@) % أرمي الحصى من حافريه بمثله ، % وأروع ضوء الصبح منه بصده % 39(@)(@@) % وأظل في جوب البلاد كأنني % % سيف ابن أرتق لا يقر بغمده % 40(@)(@@) % الصالح الملك الذي صلحت به % % رتب العلاء ولاح طالع سعده % PageV01P206 41(@)(@@) % ملك حوى رتب الفخار بسعيه ، % والملك إرثا عن أبيه وجده % 42(@)(@@) % متسهل في دست رتبة ملكه ، % متصعب من فوق صهوة جرده % 43(@)(@@) % فإذا بدا ملأ العيون مهابة ؛ % وإذا سخا ملأ الأكف برفده % 44(@)(@@) % كالغيث يولي الناس جودا بعدما % % بهر العقول ببرقه وبرعده % 45(@)(@@) % فالدهر يقسم أنه من رقة ، % والموت يحلف أنه من جنده % 46(@)(@@) % والوحش تعلن أنها من رهطه ، % والطير تدعو أنها من وفده % 47(@)(@@) % نشوان من خمر السماح ، وسكره % % 48(@)(@@) % يا ابن الذي كفل الأنام كأنما % % أوصاه آدم في كلاية ولده % 49(@)(@@) % المالك المنصور ، والملك الذي % % حاز الفخار بحده وبجده % % 50(@)(@@) % أصل به طابت مآثر مجدكم ، % والغصن يظهر طيبه من ورده % PageV01P207 51(@)(@@) % بذل الجزيل على القليل من الثنا ، % وأتيت تنفق في الورى من نقده % 52(@)(@@) % وهو الذي شغل العدو بنفسه % عني ، كما شغل الصديق بحمده % 53(@)(@@) % وأجارني إذ حاولت دمي العدى ، % ورأت شفاء صدورها في ورده % 54(@)(@@) % من كل مذاق تبسم 