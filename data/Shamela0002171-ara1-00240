ms222	 داود وغيره توفي 277 د(@)(@@)(@@)(@@) | 302- (@)(@@) إسحاق بن الضيف عن النضر بن شميل وطبقته وعنه أبو داود فيما قيل(@)(@@)(@@)(@@) | 303- (@)(@@) إسحاق بن طلحة بن عبيد الله عن أبيه وعائشة وعنه ابنه معاوية وابنا أخيه توفي زمن معاوية ت ق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 304- (@)(@@) إسحاق بن عبد الله بن جعفر عن أبيه وعنه أخوه إسماعيل وكثير بن زيد ق(@)(@@)(@@)(@@) | 305- (@)(@@) إسحاق بن عبد الله بن الحارث بن كنانة مدني عن عامر بن سعد وغيره وعنه ابنه عبد الرحمن وجماعة صدوق 4(@)(@@)(@@)(@@) | 306- (@)(@@) إسحاق بن عبد الله بن الحارث بن نوفل عن أبيه وأبي هريرة وعنه ثابت وحميد وعوف ثقة د(@)(@@)(@@)(@@) | 307- (@)(@@) إسحاق بن عبد الله بن أبي طلحة عن عمه أنسوأبيه وعدة وعنه مالك وابن عيينة حجة توفي 134 ع(@)(@@)(@@)(@@) | 308- (@)(@@) إسحاق بن عبد الله بن أبي فروة أدرك معاوية عن مجاهد ونافع وعنه الوليد بن مسلم وخلق تركوه توفي 144 د ت ق(@)(@@)(@@)(@@) | 309- (@)(@@) إسحاق بن عبد الواحد الموصلي عن أبي الاحوص والمعافى وعدة وعنه تمتام وعدة توفي 226 وقد لين س(@)(@@)(@@)(@@) | 310- (@)(@@) إسحاق بن عبيد الله بن أبي مليكة عن بنأبي مليكة وعنه أسد بن موسى ويعقوب بن محمد مقبول ق(@)(@@)(@@)(@@) | 311- (@)(@@) إسحاق بن عثمان الكلابي عن الحسن وعدة وعنه بن مهدي وأبو الوليد وعدة ثقة د(@)(@@)(@@)(@@) | 312- (@)(@@) إسحاق بن عمر بن سليط بصري عن مبارك بن فضالة وسليمان بن المغيرة وعنه مسلم وأبو زرعة وموسى بن هارون ثقة توفي 229 م(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 313- (@)(@@) إسحاق بن عمر عن عائشة وعنه سعيد بن أبي هلالمجهول ت(@)(@@)(@@)(@@) | 314- (@)(@@) إسحاق بن عيسى بن الطباع البغدادي بأذنة عن جرير بن حازم وطبقته وعنه أحمد والدارمي(@)(@@) وعدة ثقة توفي 215 م ت س ق(@)(@@)(@@)(@@) | 0- (@)(@@) إسحاق بن أبي عيسىهو بن جبريل(@)(@@)(@@)(@@) | 315- (@)(@@) إسحاق بن الفرات التجيبي قاضي مصر عن مالك والليث وعنبن عبد الحكم وبحر بن نصر وعدة ثقة يغرب توفي 204 س(@)(@@)(@@)(@@) | 316- (@)(@@) إسحاق بن أبيالفرات عن المقبري عنه عبد الملك بن قدامة يجهل ق(@)(@@)(@@)(@@) | 317- (@)(@@) إسحاق بن قبيصة بن ذؤيب عن أبيه وعنه أسامة بن زيد الليثي وعدة ق(@)(@@)(@@)(@@) | 318- (@)(@@) إسحاق بن كعب بن 
ms223	 عجرة عن أبيه وعنه ابنه سعد د ت س(@)(@@)(@@)(@@) | 319- (@)(@@) إسحاق بن محمد بن إسماعيل بن عبد الله بن أبي فروة المدني عن مالك وعدة وعنه البخاري وعلي البغوي قال أبو حاتم صدوق وربما لقن لذهاب بصره وقال مرة مضطرب ووهاه أبو داود مات 226 خ ت ق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 320- (@)(@@) إسحاق بن محمد المسيبي المخزومي القارئ عن بن أبي ذئب وعدة وعنه ابنه محمد وابن ذكوان د(@)(@@)(@@)(@@) | 321- (@)(@@) إسحاق بن محمد الانصاري عن ربيح وعنه عبد الله بنإبراهيم الغفاري د(@)(@@)(@@)(@@) | 322- (@)(@@) إسحاق بن منصور الكوسج الحافظ عن بن عيينة فمن بعدهوعنه البخاري ومسلم والترمذي والنسائي وابن ماجة وابن أبي داود وأحمد بن حمدوالاعمشي وخلق توفي 251 خ م ت س ق(@)(@@)(@@)(@@) | 323- (@)(@@) إسحاق بن منصور السلولي الكوفي عن إسرائيل وعمر بن أبي زائدة وعدة وعنه عباس الدوري وخلق توفي 205 ع(@)(@@)(@@)(@@) | 324- (@)(@@) إسحاق بن موسى الخطمي عن بن عيينة وجرير وعنه مسلم والترمذي والنسائي وابن ماجة وابنه موسى وابن خزيمة ولي قضاء نيسابور وكان حجة مات 244 م ت س ق(@)(@@)(@@)(@@) | 325- (@)(@@) إسحاق بن نجيح عن مالك بن حمزة وعنه محمد بن الطباع د(@)(@@)(@@)(@@) | 326- (@)(@@) إسحاق بن وهب الواسطي العلاف عن يزيد بن هارون ونحوه وعنه البخاري وابن ماجة وابن أبي حاتم خ ق(@)(@@)(@@)(@@) | 327- (@)(@@) اسحاق بن يحيى بن طلحة عن أعمامه موسى وإسحاق وعائشة وعنه معن وعدة ضعفوه توفي 164 ت ق(@)(@@)(@@)(@@) | 328- (@)(@@) إسحاق بن يحيى عن عبادة بن الصامت مرسلا وعنه موسى بن عقبة ق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 329- (@)(@@) اسحاق بن يحيى الكلبي العوصي سمع الزهري وعنه يحيى الوحاظي لا يعرف خت(@)(@@)(@@)(@@) | 330- (@)(@@) إسحاق بن يزيد عن عون بن عبد الله وعنه بن أبي ذئب د ت ق(@)(@@)(@@)(@@) | 331- (@)(@@) إسحاق بن يعقوب عن عفان وعنه النسائي ووثقه س(@)(@@)(@@)(@@) | 332- (@)(@@) إسحاق الازرق عن الاعمش وابن عون وخلق وعنه أحمد وسعدان وخلق ثقة عابد رفيع القدر إمام مات 195 ع(@)(@@)(@@)(@@) | 333- (@)(@@) إسحاق مولى زائدة عن سعد وأبي هريرة وعنه ابنه عمروالعلاء بن عبد الرحمن وأسامة الليثي م د س(@)(@@)(@@)(@@) | 0- (@)(@@) إسحاق أبو يعقوب هذا بن أبي إسرائيل د(@)(@@)(@@)(@@) | 0- (@)(@@) إسحاق عن 
ms224	 أبي عاصم وعبد الله بن بكر وعنه البخاري فهذا الكوسجأو إسحاق بن إبراهيم بن نصر خ(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 334- (@)(@@) أسد بن موسى بن إبراهيم بن الوليد بن عبد الملك الاموي المرواني أسد السنة عن معاوية بن صالح وابن أبي ذئب وعنه أحمد بن صالح ومقدام الرعيني وخلق قال النسائي ثقة لو لم يصنف لكان خيرا له مات 212 عاش ثمانين سنة د س(@)(@@)(@@)(@@) | 335- (@)(@@) إسرائيل بن موسى أبو موسى بصري نزل الهند عن أبي حازم الاشجعي وجماعة وعنه يحيى القطان وجماعة خ د ت س(@)(@@)(@@)(@@) | 336- (@)(@@) إسرائيل بن يونس عن جده وزياد بن علاقة وآدم بن علي وعنه يحيى بن آدم ومحمد بن كثير وأمم قال أحفد حديث أبي إسحاق كما أحفظ السورة وقال أحمد ثقة وتعجب من حفظه وقال أبو حاتم همن أتقن أصحاب أبي إسحاق وضعفه بن المديني توفي 162 ع(@)(@@)(@@)(@@) | 337- (@)(@@) أسعد بن سهل بن حنيف أبو أمامة ولد زمن النبي صلى الله عليه وسلم وروى عن عمر وعدة وعنه الزهري(@)(@@) PageV00P000(@)(@@) ويحيى بن سعيد وخلق مات سنة مائة ع(@)(@@)(@@)(@@) | 338- (@)(@@) الاسقع بن الاسلع عن سمرة وعنه سويدبن حجير وثق س(@)(@@)(@@)(@@) | 0- (@)(@@) أسلم أبو رافع في الكنى(@)(@@)(@@)(@@) | 339- (@)(@@) أسلم بن يزيد أبوعمران التجيبي عن أبي أيوب وأم سلمة وعنه يزيد بن أبي حبيب وجماعة وثقه النسائي د تس(@)(@@)(@@)(@@) | 340- (@)(@@) أسلم عن بشر بن شغاف وعدة وعنه سليمان التيمي وغيره ثقة قاله بن معين د ت س(@)(@@)(@@)(@@) | 341- (@)(@@) أسلم عن مولاه عمر وأبي بكر ومعاذ وعنه ابنه زيد ونافع مات سنة ثمانين ع(@)(@@)(@@)(@@) | 342- (@)(@@) أسلم المنقري عن علي بن الحسين وعدة وعنه أبو إسحاق الفزار وعبثر ثقة د(@)(@@)(@@)(@@) | 343- (@)(@@) أسماء بن الحكم عن علي وعنه علي بن ربيعة وثقه العجلي 4(@)(@@)(@@)(@@) | 344- (@)(@@) أسماء بن عبيد الضبعي عن الشعبي وعدة وعنه ابنه جويرية وحماد بن سلمة وعدة ثقة توفي 141 م(@)(@@)(@@)(@@) | 345- (@)(@@) إسماعيل بن أبان الوراق عن مسعر وعدةوعنه البخاري وأبو حاتم وخلق ثقة مات 216 خ ت(@)(@@)(@@)(@@) | 346- (@)(@@) إسماعيل بن إبراهيم أبو إبراهيم الترجماني عن أبي عوانة وطائفة وعنه الدارمي وأبو يعلى وخلق صدوق توفي 
