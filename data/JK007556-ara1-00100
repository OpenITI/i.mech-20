ms81	 % % 3(@)(@@) % لهند ، إن ذكرتها % % ترى من شيمتي خلقا % % 6(@)(@@) % وحبا راضيا للقل % % ب ، لم أخلط به ملقا % % 7(@)(@@) % إذا ما زينب ذكرت % سكبت الدمع متسقا % % 8(@)(@@) % كأن سحابة ، تهمي % % إذا برزت ، ولا عنقا % % 10(@)(@@) % ترى إنسان مقلتها ، % % PageV01P342 البحر : خفيف تام 1(@)(@@) % أدخل الله ، رب موسى وعيسى ، % جنة الخلد من ملاني خلوقا % % 2(@)(@@) % مسحته من كفها بقميصي ، % حين طافت ب لبيت مسحا رفيقا % % 3(@)(@@) % غضبت أن نظرت نحو نساء ، % ليس يعرفنني ، سلكن الطريقا % % 4(@)(@@) % وأرى بينها وبين نساء ، % كنت أهذي بهن ، بونا سحيقا % % PageV01P343 البحر : منسرح 1(@)(@@) % إن الخليط الذين كنت بهم % صبا دعوا للفراق ف نطلقوا % % 2(@)(@@) % عصاهم من شتيت أمرهم % يوم الملا مستطيرة شقق % 3(@)(@@) % إستربعوا ساعة ، فأزعجهم % سيارة تسحق النوى ، قلق % % 4(@)(@@) % أتبعتهم مقلة مدامعها % % منها ، بماء الشون تستبق % 5(@)(@@) % تحسب مطروفة ، وما طرفت ، % إنسانها من دموعها شرق % 6(@)(@@) % بانوا بنعم ، فلست ناسيها ، % ما اهتز في غصن أيكة ورق % % 7(@)(@@) % آلفة للحجال واضحة % ب لعنبر الورد جلدها عبق % 8(@)(@@) % الظبي فيه من خلقها شبه : % النحر ، والمقلتان ، والعنق % % 9(@)(@@) % من عوهج فردة أطاع لها % % بمدفع السيل ناقع أنق % 10(@)(@@) % شيعها مطلقا ، وجاد لها % % منابت البقل ، كوكب غدق % PageV01P344 11(@)(@@) % يجهدها المشي للقريب ، كما % % ينهض من الوعث مصعب لثق % % 12(@)(@@) % ويا لها خلة توافقنا % % أو صفقة ، بالديار ، تنصفق % % 13(@)(@@) % تعطي قليلا نزرا إذا سئلت ، % و لبخل فيها سجية خلق % 14(@)(@@) % فقد أرانا ، والدار جامعة ، % وليس في صفو عيشنا رنق % PageV01P345 البحر : طويل 1(@)(@@) % لعمري ، لو أبصرتني يوم بنتم ، % وعيني بجاري دمعها تترقرق % 2(@)(@@) % وكيف غداة البين وجدي ، وكيف إذ % % نأت داركم عن شدة الوجد آرق % 3(@)(@@) % لأيقنت أن القلب عان بذكركم ، % وأني رهين في حبالك موثق % 4(@)(@@) % فصدت صدود الرئم ، ثم تبسمت ، % وقالت لتربيها : اسمعا ، ليس يرفق ! % 5(@)(@@) % فقالت لها إحداهما : هو محسن ، % وأنت به ، فيما ترى العين ، أخرق % % 6(@)(@@) % وقالت لها الأخرى : ارجعيه بما اشتهى ، % فإن هواه بين حين ينطق % 7(@)(@@) % شفعنض إليها حين أبصرن عبرتي ، % وقلبي ، حذار العين ، منهن مشفق % % 8 
ms82	(@)(@@) % فلما تقضى الليل ، قالت فتاتها : % أرى قبل أن يستيقظ الحي أرفق % 9(@)(@@) % وعضت على إبهامها ، وتنكبت % قريبا ، وقالت : إن شرك ملحق % 10(@)(@@) % تبين هوى منا ، وتبدي شمائلا ، % ووجها له من بهجة الحسن رونق % % PageV01P346 11(@)(@@) % فألفت لها من خالص الود والهوى % % جديدا ، على شحط النوى ليس يخلق % 12(@)(@@) % لدى عاشق أحمى لها من فؤاده % % على مسرح ذي صفوة لا يرنق % 13(@)(@@) % حلاها الهوى منه ، فليس لغيرها % % به من هواه حيث نحى معلق % 14(@)(@@) % تكاد غداة البين تنطق عينه % بعبرته ، لو كانت العين تنطق % % PageV01P347 البحر : طويل 1(@)(@@) % أفي رسم دار دمعك المترقرق % سفاها ، وما استنطاق ما ليس ينطق ؟ % 2(@)(@@) % بحيث التقى جمع ، وأقصى محسر ، % معالمه كادت ، على البعد ، تخلق % 3(@)(@@) % ذكرت به ما قد مضى ، وتذكر ل % حبيب ورسم الدار مما يشوق % 4(@)(@@) % ليالي من دهر ، إذ الحي جيرة ، % وإذ هو مأمول الخميلة ، مونق % 5(@)(@@) % مقاما لنا ، عند العشاء ، ومجلسا % به لم يكدره علينا معوق % 6(@)(@@) % وممشى فتاة ب لكساء تكننا % % به تحت عين برقها يتألق % 7(@)(@@) % يبل أعالي الثوب قطر ، وتحته % % شعاع بدا يعشي العيون ، ويشرق % % 8(@)(@@) % فأحسن شيء بدء أول ليلنا ، % وآخره حزم ، إذا نتفرق % PageV01P348 البحر : خفيف تام 1(@)(@@) % أيها الباكر المريد فراقي ، % بعدما هجت بالحديث اشتياقي % % 2(@)(@@) % ليت شعري غداة بانوا ، وفيهم % صورة الشمس ، أين يرجى التلاقي % % 3(@)(@@) % جزع يعتريك ، يا قلب ، منها ، % إن يحثوا جمالهم لانطلاق % 4(@)(@@) % قد شفينا النفوس ، إن كان يشفي % % من هواها عناقها و عتناقي % % 5(@)(@@) % حين كفت دموعها ، ثم قالت : % أزف البين و نطلاق الرفاق % 6(@)(@@) % إن قلبي لفيكم اليوم رهن % لشقائي ، وحب أهل العراق % PageV01P349 البحر : طويل 1(@)(@@) % أراني وهندا أكثر الناس قالة % علينا ، وقول الناس بالمرء ملحق % 2(@)(@@) % تكننها نسوانها ، ويلومني % % صحابي ، وكل ما ستطاع معوق % 3(@)(@@) % فنحن ، على بغي الوشاة وسعيهم ، % هوانا جميع ، أمرنا حيث يصفق % 4(@)(@@) % فإن نحن جئنا سنة لم تكن مضت ، % فنحن إذا مما يقولون أخرق % % 5(@)(@@) % وإن كان أمرا سنه الناس قبلنا % % ففيم مقال الناس فينا : تفرقوا % % 6 
ms83	(@)(@@) % أحقا بأن لم تهو غانية فتى ، % وأن أناسا لم يحبوا ويعشقوا % % 7(@)(@@) % فمن ذا الذي ، إن جئت ما أمروا به ، % يبيت بهم آخر الليل يأرق ؟ % 8(@)(@@) % وإن التي نهيتها عن وصالنا % % تبيت ، إذا شتاقت إلينا ، تشوق % 9(@)(@@) % فإنا لمحقوقون أن لا يردنا % % أقاويل ما سدوا علينا وألصقوا % % PageV01P350 البحر : طويل 1(@)(@@) % ألا قاتل الله الهوى حيث أخلقا ، % فما ان ترى إلا مشويا ممذقا % % 2(@)(@@) % فما من محب يستزيد حبيبه % يعاتبه في الود ، إلا تفرقا % % 3(@)(@@) % تعلق هذا القلب للحب ، معلقا % % غزالا ، تحلى عقد در وبارقا % % 4(@)(@@) % من الأدم تعطو ب لعشي وبالضحى % % من الضال ، غصنا ناعم النبت مورقا % % 5(@)(@@) % ألوف لأظلال الكناس وللثرى ، % إذا ما لعاب الشمس بالصيف أشرقا % % PageV01P351 البحر : منسرح 1(@)(@@) % يا ليلة نامها الخلي من الحزن ، % ونومي مسهد أرق % 2(@)(@@) % أرقب نجما ، كأن آخره ، % بعد السماكين ، لؤلؤ نسق % % 3(@)(@@) % يا نعم لا أخلف الصديق ولا % يطمع في الوشاة إن نطقوا % % 4(@)(@@) % لا والذي أحرم العباد له ، % بكل فج من حجة رفق % % 5(@)(@@) % والبدن إن نزعت أجلتها ، % بالخيف ، يغشى نحورها العلق % % 6(@)(@@) % ما بات عندي سر أضمنه % إلا وفي الصدر دونه غلق % % PageV01P352 البحر : طويل 1(@)(@@) % ألم تسأل الاطلال والمنزل الخلق ، % ببرقة أعواء فيخبر إن نطق ؟ % 2(@)(@@) % ذكرت به هندا ، وظلت كأنني % % أخو نشوة لاقى الحوانيت فاغتبق % % 3(@)(@@) % وموقفها وهنا علينا ، ودمعها % % سريع ، إذا كفت تحدره ، تسق % 4(@)(@@) % وموقف أتراب لها ، إذ رأيتني ، % بكين وأبدين المعاصم والحدق % 5(@)(@@) % رأين لها شجوا ، فعجن لشجوها % % جميعا ، وأقلتن التنازع والنزق % % 6(@)(@@) % إذ الحبل موصول وإذ ودنا معا ، % جميعا ، وإذ تعطي التراسل والملق % % 7(@)(@@) % وقلن : امكثي ما شئت لا من أمامنا % % نخاف ، ولا نخشى من الآخر للحق % PageV01P353 البحر : وافر تام 1(@)(@@) % لقد دب الهوى لك في فؤادي % % دبيب دم الحياة إلى العروق % PageV01P354 البحر : خفيف تام 1(@)(@@) % حدثيني ، وأنت غير كذوب % أتحبينني ، جعلت فداك ؟ % 2(@)(@@) % واصدقيني ، فإن قلبي رهين ، % ما يطيق الكلام فيمن سواك % 3(@)(@@) % كلما لاح ، أو تغور نجم ، % صدع القلب ذكركم ، فبكاك % 4(@)(@@) % قد 
ms84	 تمنيت في العتاب فراقي ، % فلقد نلت ، يا ثريا ، مناك % % 5(@)(@@) % لا تطيعي الوشاة فيما أرادوا ، % يا ثريا ، ولا الذي ينهاك % 6(@)(@@) % كم فتى ماجد الخلائق ، عف ، % يتمنى في مجلس أن يراك % % 7(@)(@@) % حال من دون ذاك ما قدر % % ه ، بحق ، فما يطيق لقاك % PageV01P355 البحر : خفيف تام 1(@)(@@) % أيها العاتب الذي رام هجري ، % وبعادي ، وما علمت بذاكا % % 7(@)(@@) % وإذا ما سمعت إسما كإسمي ، % لي بالدمع أخضلت عيناكا % % PageV01P356 البحر : مجزوء الرمل 1(@)(@@) % أرسلت أسماء : إنا % % قد تبدلنا سواكا % % 2(@)(@@) % بدلا ، فاستغن عنا % % بدلا ، يغني غناكا % % 3(@)(@@) % لن ترى أسماء ، حتى % % تبلغ النجم يداكا % % 4(@)(@@) % ف جتنبني وأطيعن % ناصح الجيب نهاكا % % 5(@)(@@) % إن في الدار رجالا % كلهم يهوى رداكا % % 6(@)(@@) % لا تلمني واجتنبني ، % أنت ما سديت ذاكا % % PageV01P357 البحر : خفيف تام 1(@)(@@) % أرسلت هند إلينا رسولا % عاتبا : أن ما لنا لا نراكا % % 2(@)(@@) % فيم قد أجمعت عنا صدودا ؟ % أأردت الصرم ، أم ما عداكا ؟ % 3(@)(@@) % إن تكن حاولت غيظي ، بهجري ، % فلقد أدركت ما قد كفاكا % % 4(@)(@@) % كاذبا ، قد يعلم الله ربي % % أنني لم اجن ما كنه ذاكا % % 5(@)(@@) % وألبي داعيا إن دعاني % % وتصامم عامدا إن دعاكا % % 6(@)(@@) % وأكذب كاشحا إن أتاني ، % وتصدق كاشحا إن اتاكا % % 7(@)(@@) % إن في الأرض مساحا عريضا % ومناديح كثيرا سواكا % % 8(@)(@@) % غير أني فاعلمن ذاك حقا % لا أرى النعمة ، حتى أراكا % % 9(@)(@@) % قلت : مهما تجدي بي ، فإني % % أظهر الود لكم فوق ذاكا % % 10(@)(@@) % أنت همي ، وأحاديث نفسي % % ما تغيبت ، وإذ ما أراكا % % PageV01P358 البحر : وافر تام 1(@)(@@) % ألا يا سلم قد شطحت نواك ، % فلا وصل لغانية سواك % 2(@)(@@) % ولا حب لدي ، ولا تصاف % لغيرك ، ما علا قدمي شراكي % % 3(@)(@@) % لقد ماطلتني ، يا حب ، عصرا % فليت الله بالحب ابتلاك ! % 4(@)(@@) % لتلقي بعض ما ألقى ووجدي ، % ولا والله ، ما أهوى رداك % % 5(@)(@@) % ولكن ، قد منحت هواي صفوا % فليت الله يمنحني هواك ! % 6(@)(@@) % وليت العاذلات ، غداة بنتم ، % وأظهرن الملامة لي فداك ! % 7(@)(@@) % وليت مخبري بالصرم منكم ، % علانية ، نعاني ، إذ نعاك % % 8(@)(@@) % فأتبعه ، لكي تجزين ودي 
ms85	 ، % وما سلمى تجازيني بذاك % PageV01P359 البحر : متقارب تام 1(@)(@@) % أأنكرت ، من بعد عرفانكا ، % منازل كانت لجيرانكا % % 2(@)(@@) % منازل بيضاء ، كانت تكو % % ن بسر هواك ، وإعلانكا % % 3(@)(@@) % تريد رضاك ، إذا ما خلون ، % طلاب هواك وعصيانكا % % 4(@)(@@) % وإن شئت عاطتك ، أو داعبت ، % لعوب على كل أحيانكا % % 5(@)(@@) % تريك ، أحايين ، عرضية ، % وحينا ترى دون إمهانكا % % 6(@)(@@) % إذا ما تضاغنت ، ألفيتها % % صناعا ، بتسليل أضغانكا % % 7(@)(@@) % وكنت ، وكانت ، وكان الزمان ، % فأحسن بها ، وبأزمانكا ! % 8(@)(@@) % ليالي ، أنت لها موطن ، % وإذ هي أفضل أوطانكا % % 9(@)(@@) % وإذ هي شأنك تعنى به ، % وإذ غيرها ليس من شانكا % % 10(@)(@@) % وإذ هي تربك ترب الصفاء ، % وخدنك من دون أخدانكا % % PageV01P360 11(@)(@@) % وإذ كل مرعى رعته السراة ، % وإن طاب ، ليس كسعدانكا % % 12(@)(@@) % خزاماك مونقة ظلها ، % وقريانهم دون قريانكا % % 13(@)(@@) % فدب لها ولك الكاشحون ، % فحلوا حبائل أقرانكا % % 14(@)(@@) % لججت ، ولجت ، وكان اللجا % % لجاج فيه قطيعة خلصانكا % % 15(@)(@@) % وأظهرت هجرانها : ظالما % ولم تك أهلا لهجرانكا % % 16(@)(@@) % أأدنيتها ، ثم جانبتها ، % فسوف ترى غب إدنائكا % % 17(@)(@@) % أظنك تحسبها في الوداد % مراجعة بعد عهدانكا % % 18(@)(@@) % فهيهات ، هيهات ، حتى الممات ، % ت ، بهمك منها ، وأحزانكا ! % PageV01P361 البحر : خفيف تام 1(@)(@@) % أيها العاتب المكثر فيها ، % بعض لومي ، فما بلغت مناكا ! % 2(@)(@@) % لم يكن من عتابنا بسبيل ، % فترى أن ما عنانا عناكا % % 3(@)(@@) % عند غيري ، ف بغ النقيصة فيها % % إن رأيي لا يستقيد لذاكا % % PageV01P362 البحر : متقارب تام 1(@)(@@) % تقول ، غداة التقينا ، الرباب : % ب : أيا ذا أفلت أفول السماك % 2(@)(@@) % وكفت سوابق من عبرة ، % كما رفض نظم بعيد المساك % 3(@)(@@) % فقلت لها : من يطع بالصديق % ق أعداءه يجتنبه كذاك % 4(@)(@@) % أغرك أني عصيت الملا % % م فيك ، وأن هوانا هواك % % 5(@)(@@) % ولم أر لي لذة في الحيا % % ة ، تلتذها العين ، حتى أراك % % 6(@)(@@) % وكان من الذنب لي عندكم % % مكارمتي واتباعي رضاك % 7(@)(@@) % فليت الذي لام من اجلكم ، % وفي أن تزاري ، برغم ، وقاك % 8(@)(@@) % هموم الحياة ، وأسقامها ، % وإن كان حتفا جهيزا ، فداك % PageV01P363 البحر : مديد تام 1(@)(@@) % زارنا زور سررت به ، % ليت ذاك الزور لم يعجل % 2(@)(@@) % إذ 
ms86	 أتانا ليلة وجلا ، % من عيون الخانة العذل % 3(@)(@@) % وأتانا وهو منخرق ، % وبغال الحي لم ترحل : % 4(@)(@@) % يا أبا الخطاب هل لكم % من رسول ناصح يرسل % % 5(@)(@@) % ب لذي أخفي وأكتمه % من جميع الناس لم أقبل % % 6(@)(@@) % فأذاقتني ، على مهل ، % طيب الأنياب ، لم يثعل % 7(@)(@@) % نحسب الراح الذكي به % وسلاف الراح والسلسل % % PageV01P364 البحر : مجزوء الرجز 1(@)(@@) % قد زاد قلبي حزنا % رسم وربع محول % 2(@)(@@) % ربع لهند مقفر % قد كان حينا يؤهل % 3(@)(@@) % ما إن به من أهله % إلا الظباء الخذل % % 4(@)(@@) % قد كنت فيهم ناعما % ألهو بهم ، واجذل % % 5(@)(@@) % أيام هند ، والهوى % % منا لهند يبذل % % 6(@)(@@) % فحال دهر دونها % % دهر ، لعمري ، معضل % 7(@)(@@) % بتنا ، وقلبي مشفق ، % من صرم هند أوجل % % 8(@)(@@) % إذ أرسلت في خفية ، % إن المحب المرسل % 9(@)(@@) % تقول هند ئتنا % % فقلت ، لا ، لا أفعل % % 10(@)(@@) % والله لا آتيكم ، % حتى يزور الأول ! % PageV01P365 11(@)(@@) % عن حبكم ، يا هند ، ما % % عمرت حيا ، أغفل ! % PageV01P366 البحر : مجزوء الوافر 1(@)(@@) % ألم تربع على الطلل ، % ومغنى الحي كالخلل % 2(@)(@@) % تعفي رسمه الأرواح ، % من صبإ ، ومن شمل % 3(@)(@@) % وانداء تباكره ، % وجون واكف السبل % % 4(@)(@@) % لهند ، إن هندا حب % % ها ، قد كان من شغلي % % 5(@)(@@) % ليالي تستبي عقلي % % بوحف وارد جثل % 6(@)(@@) % وعيني مغزل حورا % % لم تكحل ، من الخذل % % 7(@)(@@) % فلما أن عرفت الدار ، % ر ، عجتت لرسمها جملي % % 8(@)(@@) % وقلت لصحبتي عوجوا % % فعاجوا هزة الإبل % % 9(@)(@@) % وقالوا : قف ولا تعجل ، % وإن كنا على عجل % 10(@)(@@) % قليل في هواك اليو % ما نلقى من العمل ! % PageV01P367 البحر : طويل 1(@)(@@) % لقد أرسلت ، في السر ، ليلى بأن أقم ، % ولا تنأنا ، إن التجنب أمثل % 2(@)(@@) % لعل العيون الرامقات لودنا % % تكذب عنا ، أو تنام فتغفل % 3(@)(@@) % أناس أمناهم ، فبثوا حديثنا ، % فلما قصرنا السير عنهم ، تقولوا % % 4(@)(@@) % فقلت ، وقد ضاقت علي برحبها % % بلادي بما قد قيل ، ف لعين تهمل % 5(@)(@@) % سأجتنبب الدار التي أنتم بها % % ولكن طرفي نحوكم سوف يعدل % % 6(@)(@@) % ألم تعلمي أني ، فهل ذاك نافع % لديك وما أخفي من الوجد أفضل ، % 7(@)(@@) % أرى مستقيم 
ms87	 الطرف ما ام نحوكم ، % فإن أم طرفي غيركم ، فهو أحول % % PageV01P368 البحر : طويل 1(@)(@@) % جرى ناصح بالود بيني وبينها ، % فقرني يوم الحصاب إلى قتلي % % 2(@)(@@) % فطارت بحد من قؤادي ، وقارنت % قريبتها حبل الصفاء إلى حبلي % % 3(@)(@@) % فما انس ملأشياء لا أنس موقفي ، % وموقفها يوما بقارعة النخل % 4(@)(@@) % فلما توافقنا عرفت الذي بها ، % كمثل الذي بي حذوك النعل ب لنعل % 5(@)(@@) % فعاجت بأمثال الظباء نواعم ، % إلى موقف بين الحجون إلى النخل % % 6(@)(@@) % فقالت لأتراب لها شبه الدمى ، % أطلن التمني والوقوف على شغلي % % 7(@)(@@) % وقالت لهن : ارجعن شيئا ، لعلنا % % نعاتب هذا ، أو يراجع في وصل % % 8(@)(@@) % فقلن لها : هذا عشاء ، وأهلنا % % قريب ، ألما تسأمي مركب البغل ؟ % 9(@)(@@) % فقالت : فما شئتن ، قلن لها : انزلي ، % فللأرض خير من وقوف على رحل % % 10(@)(@@) % وقمن إليها ، ك لدمى ، ف كتنفنها % % وكل يفدي ب لمودة والأهل % PageV01P369 11(@)(@@) % نجوم دراري تكنفن صورة % من البدر وافت ، غير هوج ولا نكل % % 12(@)(@@) % فسلمت و ستأنست خيفة أن يرى % % عدو مكاني أو يرى كاشح فعلي % % 13(@)(@@) % فقالت ، وأرخت جانب الستر : إنما % % معي فتحدث غير ذي رقبة أهلي % % 14(@)(@@) % فقلت لها : ما بي لهم من ترقب ، % ولكن سري ليس يحمله مثلي % % 15(@)(@@) % فلما قتصرنا دونهن حديثنا ، % وهن طبيبات بحاجة ذي التبل % 16(@)(@@) % عرفن الذي تهوى ، فقلن لها : ئذني % % نطف ساعة في طيب ليل وفي سهل % % 17(@)(@@) % فقالت : فلا تلبثن ، قلن ، تحدثي ، % اتيناك ، وانسبن انسياب مها الرمل % % 18(@)(@@) % فقمن ، وقد أفهمن ذا اللب أنما % % فعلن الذي يفعلن في ذاك من أجلي % % 19(@)(@@) % وباتت تمج المسك في في غادة ، % بعيدة مهوى القرط صامتة الحجل % % 20(@)(@@) % تقلب عيني ظبية ترتعي الخلى ، % وتحنو على رخص الشوى أغيد طفل % % PageV01P370 21(@)(@@) % وتفتر عن ك لأقحوان بروضة % جلته الصبا والمستهل من الوبل % % 22(@)(@@) % أهيم بها : في كل ممسى ومصبح ، % وأكثر دعواها إذا خدرت رجلي % % PageV01P371 البحر : طويل 1(@)(@@) % أشر ، يا ابن عمي ، في سلامة ما ترى % % لنا ، وتبديها لتسلبني عقلي % % 2(@)(@@) % على حين لاح الشيب و ستنكر الصبا % % وراجعني حلمي وأقصرت 
ms88	 عن جهلي % % 3(@)(@@) % وآلت كما آل المجرب ، بعدما % % صحوت ، ومل العاذلات من العذل % 4(@)(@@) % وأبديت عصيانا لهن ، سببنني ، % وألقين من يأس على غاربي حبلي % % 5(@)(@@) % وأقبلن يمشين الهوينا عشية ، % يقتلن من يرمين ب لحدق النجل % 6(@)(@@) % غرائب من حيين شتى لقينني % % على حالة ما خاف من مثلها مثلي % % 7(@)(@@) % فسلمن تسليما ضعيفا وأعين % نحاذرها من أهلهن ، ومن أهلي % % 8(@)(@@) % وقلن : لو ان الله شاء لقيتنا % % على غير هذا من مقام ومن شغل % 9(@)(@@) % إذا لبثثناك الاحاديث ، واشتفت % نفوس ، ولكن المقام على رجل ! % 10(@)(@@) % وقلن : متى بعد العشية نلتقي % % لميعادنا ؟ هيهات ، هيهات ، للوصل ! % PageV01P372 البحر : طويل 1(@)(@@) % ألم يسلني نأي المزار صبابتي % % إلى أم عبد الله ، والنأي قد يسلي ؟ % 2(@)(@@) % من المرعدات الطرف ، تنفذ عينها % % إلى نحو حيزوم المجرب ذي العقل % 3(@)(@@) % فلا هي لانت بعض لين يصيرها % % إلينا ، ولا أبدت لنا جانب البخل % % PageV01P373 البحر : خفيف تام 1(@)(@@) % كدت يوم الرحيل أقضي حياتي ، % ليتني مت قبل يوم الرحيل % 2(@)(@@) % لا أطيق الكلام ، من شدة الوج % د ، ودمعي يسيل كل مسيل % 3(@)(@@) % ذرفت عينها ، ففاضت دموعي ، % وكلانا يلقى بلب أصيل % 4(@)(@@) % لو خلت خلتي ، أصبت نوالا ، % أو حديثا يشفي مع التنويل % % 5(@)(@@) % ولقد قالت الحبيبة : لولا % % كثرة الناس جدت بالتقبيل % 6(@)(@@) % ليس طعم الكافور والمسك شيبا ، % ثم علا بالراح والزنجبيل % % 7(@)(@@) % حين تنتابها ، بأطيب من في % % ها طروقا ، إن شئت ، أو بالمقيل % % 8(@)(@@) % ذاك ظني ، ولم أذق طعم فيها ، % لا وما في الكتاب من تنزيل % 9(@)(@@) % وبفرع ، حدثته ، كالمثاني ، % عل بالمسك ، فهو مثل السديل % % 10(@)(@@) % ربعة ، أو فويق ذاك قليلا % ونؤوم الضحى ، وحق كسول % % PageV01P374 11(@)(@@) % لا يزال الخلخال فوق الحشايا % % مثل أثناء حية مقتول % 12(@)(@@) % زان ما تحت كعبها قدماها % % حين تمشي ، والكعب غير نبيل % PageV01P375 البحر : خفيف تام 1(@)(@@) % إن طرفي دل الفؤاد عليها ، سر قليلا ، ولا تلمني خليلي % % لوداع الرباب قبل الرحيل % 2(@)(@@) % إن في النفس حاجة ما تقضى ، % ما دعا في الغصون داعي هديل % 3(@)(@@) % إن طرفي دل الفؤاد عليها ، % ففؤادي 
ms89	 كالهائم المقتول % PageV01P376 البحر : مجزوء الخفيف 1(@)(@@) % ذكر القلب ذكرة % من حبيب مزايل % 2(@)(@@) % ماجد قد صبا بكم ، % والصبى غير طائل % % 3(@)(@@) % مستمر لطية ، % سالك في الغوائل % 4(@)(@@) % ولقد خفت خلة ، % لست منها بوائل % % 5(@)(@@) % إن نأتكم ديارنا % % و لتباس الحبائل % 6(@)(@@) % وصرمتم مشيعا ، % وده غير زائل % % 7(@)(@@) % أحدث الصرم بيننا ، % إذ بدا ، قول قائل % 8(@)(@@) % إذ بدت بين نسوة % جازئات ، عقائل % % PageV01P377 البحر : مجزوء الخفيف 1(@)(@@) % هاج ذا القلب منزل % دارس الآي محول % 2(@)(@@) % غيرت آيه الصبا ، % وجنوب ، وشمال % 3(@)(@@) % ولقد كان آهلا % فيه ظبي مبتل % 4(@)(@@) % طيب النشر ، واضح ، % أحور العين ، أكحل % % 5(@)(@@) % فلئن بان أهله % فبما كان يؤهل % 6(@)(@@) % قد أرانا بغبطة % فيه نلهو ، ونجذل % % 7(@)(@@) % بجوار خرائد ، % ذاك ، والود يبذل % 8(@)(@@) % إذ فؤادي بزينب ، % أم يعلى موكل % 9(@)(@@) % وهي فينا ، فلا تبا % % ليه ، تلحى ، وتعذل % % 10(@)(@@) % قبل أن يستفزها % % قول واش يحمل % PageV01P378 11(@)(@@) % حين أرسلت ثهللا ، % واخو الود مرسل % 12(@)(@@) % ب عتذار من سخطها % % عل أسماء تقبل % % 13(@)(@@) % فأتتني بما هوي % % من القول ، ثهلل % 14(@)(@@) % حين قالت : تقول زي % % نب : إنا سنفعل % % 15(@)(@@) % أنا من ذاك آيس % غير أني أعلل % 16(@)(@@) % وأخ يستحثني ، % وينادي ، ويبذل % % 17(@)(@@) % كلما قال لي : انطلق ، % قلت : إربع ، سأفعل % PageV01P379 البحر : سريع 1(@)(@@) % يا أيها العاذل في حبها % % لست مطاعا ، أيها العاذل % 2(@)(@@) % أنت صحيح من جوى حبها ، % وحبها لي سقم داخل % 3(@)(@@) % إن الذي لاقيت من حبها % % لم يلقه حاف ولا ناعل % 4(@)(@@) % الموت خير من حياة كذا ، % لا أنا موصول ، ولا ذاهل % % 5(@)(@@) % لما أتاني قائل ب لذي % % أكره مما يخبر السائل % 6(@)(@@) % قلت ، وعيني مسبل دمعها ، % كالدر من أرجائها هامل : % 7(@)(@@) % يا ليتني مت ، ومات الهوى ، % ومات ، قبل الملتقى ، واصل % % 8(@)(@@) % يا دار امست دارسا رسمها ، % وحشا قفارا ما بها آهل % 9(@)(@@) % قد جرت الريح بها ذيلها % % و ستن في أطلالها الوابل % PageV01P380 البحر : خفيف تام 1(@)(@@) % مرحبا ، ثم مرحبا بالتي قالت ، غ % % لت ، غداة الوداع ، يوم الرحيل % 2(@)(@@) % للثريا : قولي له انت 
ms90	 همي ، % ومنى النفس خاليا ، وخليلي % % 3(@)(@@) % ف لتقينا ، فرحبت ، ثم قالت : % عمرك الله ، ائتنا في المقيل % 4(@)(@@) % في خلاء ، كيما يرينك عندي ، % فيصدقنني ، فداك قبيلي ! % 5(@)(@@) % لم يرعهن ، عند ذاك ، وقد جئ % % جئت لميعادهن ، إلا دخولي % % 6(@)(@@) % قلن : هذا الذي نلومك فيه ؟ % لا تحجي من قولنا بفتيل % 7(@)(@@) % فصليه ، فلن تلامي عليه ، % فهو أهل الصفاء والتنويل % 8(@)(@@) % قالت : انصتن واستمعن مقالي ، % لست أرضى من خلتي بقليل % 9(@)(@@) % قد صفا العيش ، والمغيري عندي ، % حبذا هو من صاحب وخليل % % PageV01P381 البحر : طويل 1(@)(@@) % تصابى ، وما بعض التصابي بطائل ، % وعاود من هند جوى غير زائل % 2(@)(@@) % كما نكست هيماء ، أحدث ردعها % % بمستنقع ، أعراضه للهوامل % 3(@)(@@) % عشية قالت : صدعت غربة النوى ، % فما من لقاء بيننا دون قابل % 4(@)(@@) % وما أنس ملأشياء لا أنس مجلسا % لنا مرة منها بقرن المنازل % % 5(@)(@@) % بنخلة ، بين النخلتين ، تكننا % % من العين ، خوف العين ، برد المراجل % % PageV01P382 البحر : طويل 1(@)(@@) % قل للذي يهوى تفرق بيننا % % بحبل ودادي : أي ذلك يفعل ؟ % 2(@)(@@) % فويل امها أمنية ، لو تفهمت % معانيها ، أو كانت اللب تعمل % % 3(@)(@@) % أغيظي تمنت أم أرادت فراقها % % إلي ، فلا حاشاي ، بل أنا أقبل % 4(@)(@@) % أؤمن ، فادع الله يجمع بيننا % % بحبل شديد العقد ، لا يتحلل % 5(@)(@@) % وددنا ونعطى ما يجود ، لو انه % لنا رائم ، حتى يؤوب المنخل % % 6(@)(@@) % فلست بناس ، ما حييت ، مقالها % % لنا ، ليلة البطحاء ، والدمع يهمل : % 7(@)(@@) % لقد غنيت نفسي ، وأنت بهمها ، % فقد جعلت ، والحمد لله ، تذهل % 8(@)(@@) % أراك تسويني بمن لست مثله % وللحفظ أهل ، والصبابة منزل % % 9(@)(@@) % ولو كنت صبا بي كما أنا صبة % أطعت ، ولكني أجد وتهزل % 10(@)(@@) % فقلت لها قول امرىء متحفظ ، % تجلد عمدا ، وهو للصلح أشكل : % PageV01P383 11(@)(@@) % أبيني لنا ، إن كان هذا تجنبا % % لصرم ، فتصريح الصريمة أجمل % % 12(@)(@@) % وإن كان إنكارا لأمر كرهته % فرابك أني تائب متنصل % % 13(@)(@@) % وقد علمت ، إذ باعدتني تجنبا ، % فدت نفسها نفسي على من تعول % % 14(@)(@@) % هنيئا لقلب ، كنت احسب أنه ، % إذا شاء سال عنك ، أو متبدل % 15(@)(@@) % فمت كمدا ، يا قلب ، أو 
ms91	 عش ، فإنما % % رأيتك ب لجافي البخيل موكل % PageV01P384 البحر : طويل 1(@)(@@) % أتاني كتاب منك فيه تعتب % علي وإسراع ، هديت إلى عذلي ! % 2(@)(@@) % فعزيت نفسي ثم مال بي الهوى % % وقبلي قاد الحب من كان ذا تبل % 3(@)(@@) % فقلت : إذا كافأت من هو مذنب % مسيء ، بما أسدى إلي ، فما فضلي ؟ % 4(@)(@@) % لم أرتجي حلمي إذا أنا لم أعد % عليك ، ولم يجمع لجهلكم جهلي % % 5(@)(@@) % فلا تقتليني ، إن رأيت صبابتي % % إليك ، فإني لا يحل لكم قتلي % % 6(@)(@@) % وقلت لها : والله ، ما زلت طائعا % لكم ، سامعا في رجع قول وفي فعل % % 7(@)(@@) % فما أنس من ود تقادم عهده % فلست بناس ، ما هدت قدمي نعلي % % 8(@)(@@) % عشية قالت ، والدموع بعينها : % هنيئا لقلب ، عنك لم يسله مسلي % % 9(@)(@@) % لقد كان في إقراضك الود غيرنا % % وفعلك ناه لي ، لو ان معي عقلي % % 10(@)(@@) % فهذا الذي في غير ذنب علمته % % صنيعك بي حتى كأني أخو ذحل % % PageV01P385 11(@)(@@) % هل الصرم إلا مسلمي ، إن صرم % % تني ، إلى سقم ما عشت أو بالغ قتلي % % 12(@)(@@) % ساملك نفسي ما استطعت ، فإن تصل % % أصلك ، وإن تصرم حبالك من حبلي % % 13(@)(@@) % أكن ك لذي أسدى إلى غير شاكر % يدا لم يثب فيها بحمد ولا بذل % PageV01P386 البحر : مجزوء الرمل 1(@)(@@) % فجعتنا أم بشر % بعد قرب ب حتمال % 2(@)(@@) % بينما نحن جميعا % جيرة في خير حال % 3(@)(@@) % إذ سمعنا من مناد % % أن تهيوا لارتحال % % 4(@)(@@) % فزعوا للبين ، لما % % نزلوا بزل الجمال % % 5(@)(@@) % وبغالا ملجمات ، % جنبوها بالجلال % % 6(@)(@@) % فاستقلوا ، ودموعي % % قد أربت ب نهمال % 7(@)(@@) % من هوى خود لعوب % غادة مثل الهلال % 8(@)(@@) % أشبه الخلق جميعا % حين تبدو ، ب لمثال % 9(@)(@@) % إنما ألوت بعقلي % % بعد حلم واكتهال % 10(@)(@@) % حين لاح الشيب مني % % في شواتي وقذالي % % PageV01P387 11(@)(@@) % أيها الناصح ، قبلي % % فتنت شمط الرجال % % 12(@)(@@) % ففؤادي في هواها % % هائم أخرى الليالي % % PageV01P388 البحر : سريع 1(@)(@@) % أرسلت لما عيل صبري إلى % % أسماء ، والصب بأن يرسلا ، % 2(@)(@@) % أذكر أن لا بد من مجلس ، % يكون عن سامركم معزلا % % 3(@)(@@) % لأأبثكم فيه جوى شفني ، % حملته 
ms92	 من حبكم ، مثقلا % % 4(@)(@@) % ف بتسمت عن نير واضح % مفلج ، عذب ، إذا قبلا % % 5(@)(@@) % كأقحوان الرمل في جائر % أو كسنا البرق إذا هللا % % 6(@)(@@) % ثم دعت ، من عجب ، أختها % % وواعديه سرحتي مالك % 7(@)(@@) % يسومني ، معتذرا ، مجلسا ، % كأنه يأمن أن نبخلا % % 8(@)(@@) % فأرسلت أروى وقالت لها ، % من قبل أن ترضى وأن تقبلا : % 9(@)(@@) % إيتيه ب لله وقولي له : % والله ، لا يفعله ، ثم لا % % 10(@)(@@) % وواعديه سرحتني مالك ، % أو الربى دونهما ، منزلا % % PageV01P389 11(@)(@@) % وليأت ، إن جاء ، على بغلة % إني أخاف المهر أن يصهلا % % 12(@)(@@) % لما لتقينا رحبت تربها % % هند وقالت : قلبا حولا % % 13(@)(@@) % وأعرضت من غير ما بغضة ، % لكاشح لم يأل أن يمحلا % % 14(@)(@@) % بلغها كذبا ، ولم يألها % % غشا ، وشر الناس من حملا % % PageV01P390 البحر : وافر تام 1(@)(@@) % ألا إني عشية دار زيد ، % على عجل أردت بأن أقولا : % 2(@)(@@) % أنيلي قبل وشك لبين إني % % أرى مكثي بأرضكم قليلا % % 3(@)(@@) % فهزت رأسها عجبا ، وقالت : % عذرتك ، لو ترى منهم غفولا % % 4(@)(@@) % ولكن ليس يعرف لي خروج ، % ولا تسطيع في سر دخولا % % 5(@)(@@) % هلم ، فأعطني واسترض مني % % مواثيقا ، على أن لا تحولا % % 6(@)(@@) % وأن نرعى الأمانة ، ما نأينا ، % ونعمل في تجاورنا الرسولا % % 7(@)(@@) % فقلت لها : وددت ، ولي أني % % وجدت إلى لقائكم سبيلا % % PageV01P391 البحر : بسيط تام 1(@)(@@) % يا أم نوفل ، فكي عانيا مثلت % به قريبة ، أو هو هالك عجلا % % 2(@)(@@) % كما دعوت التي قامت بقرقرها ، % تمشي كمشي ضعيف خر فانجدلا % % 3(@)(@@) % فمجت المسك بحتا ليس يخلطه % % إلا سحيق من الكافور قد نخلا % % 4(@)(@@) % والزنجبيل مع التفاح تحسبه ، % من طيب ريقتها ، قد خالط العسلا % % 5(@)(@@) % يا طيب طعم ثناياها ، وريقتها ، % إذا ستقل عمود الصبح ف عتدلا % % 6(@)(@@) % مجاجة المسك ، لا تقلى شمائلها ، % تزداد عندي ، إذا ما ماحل محلا % % 7(@)(@@) % لو كان يخبل طيب النشر ذا كلف ، % لكنت من طيب رياها الذي خبلا % % 8(@)(@@) % لها من الرئم عيناه وسنته % ونخوة السابق المختال إذ صهلا % % 9(@)(@@) % مطلت ديني ، وأنت اليوم موسرة ، % أحبب بها من غريم موسر مطلا ! % 10(@)(@@) % مطلته سنة 
ms93	 حولا ، مجرمة ، % وبعض أخرى ، تجني الذنب والعللا % % PageV01P392 البحر : طويل 1(@)(@@) % خليلي ، عوجا ، نسأل اليوم منزلا % % أبى ب لبراق العفر أن يتحولا % % 2(@)(@@) % بفرع النبيت ، فالشرى خف أهله ، % وبدل أرواحا جنوبا وشمالا % % 3(@)(@@) % ضرائر أوطن العراص ، كأنما % % أجلن على ما غادر الحي منخلا % % 4(@)(@@) % ديار التي قامت إلى السجف غدوة ، % لتنكأ قلبا كان قدما مقتلا % % 5(@)(@@) % أرادت ، فلم تسطع كلاما ، فأومأت % إلي ، ولم تأمن رسولا فترسلا : % 6(@)(@@) % بأن بت عسى أن يستر الليل مجلسا % لنا ، أو تنام العين عنا فتغفلا % % 7(@)(@@) % فوطنت نفسي للمبيت فولجوا % % لي الربض الاعلى مطيا وأرحلا % % 8(@)(@@) % وقالت لتربيها : اعلما أن زائرا ، % على رقبة تيكما متغفلا % % 9(@)(@@) % فقولا له ، إن جاء : أهلا ومرحبا ، % ولينا له كي يطمئن وسهلا % % 10(@)(@@) % فراجعتاها : أن نعم ، فتيممي % % لنا منزلا عن سامر الحي معزلا % % PageV01P393 11(@)(@@) % ولا تعجلي أن تهدأ العين ، و تركي % % رقيبا بأبواب البيوت موكلا % % 12(@)(@@) % فبتث أفاتيها ، فلا هي ترعوي % % لجود ، ولا تبدي إباء ، فتبخلا % % 13(@)(@@) % وأكرمها من أن ترى بعض شدة ، % وتبدي مواعيد المنى والتعللا % % 14(@)(@@) % فلم أر مأتيا يؤمل بذله ، % إذا سئلت ، أبدى إباء ، وأبخلا % % 15(@)(@@) % وأمنع للشيء الذي لا يضيرها ، % وأسبى لذي الحلم الذي قد تذللا % % 16(@)(@@) % إذا طمعت ، عادت إلى غير مطمع % بجود ، وتأبى النفس أن تتحللا % % PageV01P394 البحر : سريع 1(@)(@@) % عوجا نحي الطلل المحولا ، % والربع من أسماء ، والمنزلا % % 2(@)(@@) % ومجلس النسوة بعد الكرى % % أمن فيه الأبطح الأسهلا % % 3(@)(@@) % بجانب البوباة ، لم يعده % تقادم العهد بأن يؤهلا % 4(@)(@@) % إياي ، لا إياكما ، هيج ل % زل للشوق ، فلا تعجلا % % 5(@)(@@) % إن كنتما خلوين من حاجتي ، ال % % يوم ، فإن الحق أن تجملا % % 6(@)(@@) % ذكرني المنزل ما غبتما % % عنه ، فعوجا ساعة واسألا % % 7(@)(@@) % إن يصبح المنزل من أهله % وحشا مغاني رسمه ممحلا % % 8(@)(@@) % فقد أراه ، وبه ربرب % مثل لمها ، يقرو الملا لمبقلا % % 9(@)(@@) % أيام أسماء به شادن % خود ، تراعي رشأ أكحلا % % 10(@)(@@) % قالت لتربينلها عندها : % هل تعرفان الرجل المقبلا ؟ % PageV01P395 11(@)(@@) % قالت فتاة ، عندها ، معصر ، % تدير حوراوين ، لم تخذلا : % 12(@)(@@) % هذا أبو 
ms94	 الخطاب ، قالت : نعم ، % قد جاء من نهوى ، وما أغفلا % PageV01P396 البحر : كامل تام 1(@)(@@) % ودع لبابة قبل أن تترحلا ، % و سأل ، فإن قليله أن تسألا % % 2(@)(@@) % أمكث ، بعمرك ، ليلة ، وتأنها ، % فلعل ما بخلت به أن يبذلا % % 3(@)(@@) % قال : ائتمر ما شئت غير نازع % فيما هويت ، فإننا لن نعجلا % % 4(@)(@@) % لسنا نبالي ، حين تدرك حاجة ، % ما بات ، أو ظل المطي معقلا % % 5(@)(@@) % نجزي بأيد كنت تبذلها لنا ، % حق علينا ، واجب أن نفعلا ! % 6(@)(@@) % حتى إذا ما الليل جن ظلامه ، % ورقبت غفلة كاشح أن يمحلا % % 7(@)(@@) % و ستنكح النوم الذين نخافهم ، % ورمى الكرى بوابهم ، فتخبلا % % 8(@)(@@) % خرجت تأطر في الثياب ، كأنها % % ريح تسنت عن كثيب أهيلا % % 9(@)(@@) % فجلا القناع سحابة مشهورة % غراء تعشي الطرف أن يتأملا % % 10(@)(@@) % سلمت حين لقيتها ، فتهللت % لتحيتي ، لما رأتني مقبلا % % PageV01P397 11(@)(@@) % فلبثت أرقيها بما لو عاقل % يرقى به ما سطاع ألا ينزلا % % 12(@)(@@) % تدنو فتطمع ، ثم تمنع بذلها % % نفس أبت بالجود لأن تتحللا % % PageV01P398 البحر : طويل 1(@)(@@) % أرقت ولم آرق لسقم أصابني ، % أراقب ليلا ما يزول طويلا % % 2(@)(@@) % إذا خفقت منه نجوم ، فحلقت ، % تبينت من تالي النجوم رعيلا % % 3(@)(@@) % فلما مضت من أول الليل هجعة ، % وأيقنت من حس العيون غفولا % % 4(@)(@@) % دخلت على خوف ، فأرقت كاعبا ، % هضيم الحشا ، ريا العظام ، كسولا % % 5(@)(@@) % فهبت تطيع الصوت نشوى من الكرى ، % كمغتبق الراح المدام شمولا % % 6(@)(@@) % فعضت على الإبهام منها مخافة % علي ، وقالت : قد عجلت دخولا % % 7(@)(@@) % فهلا ، إذا ستيقنت أنك داخل ، % دسست إلينا ، في الخلاء ، رسولا % % 8(@)(@@) % فنقصر عنا عين من هو كاشح % وتاتي ، ولا نخشى عليك دليلا % % 9(@)(@@) % فقلت : دعاني حبكم ، فأجبته % إليك ، فقالت : بل خلقت عجولا % % 10(@)(@@) % فلما أفضنا في الهوى نستبثه ، % وعاد لنا صعب الحديث ذلولا % % PageV01P399 11(@)(@@) % شكوت إليها ، ثم أظهرت عبرة ، % وأخفيت منه في الفؤاد غليلا % % 12(@)(@@) % فقلت : صلي من قد أسرت فؤاده ، % وعاد له فيك النصوح عذولا % % 13(@)(@@) % فصدت ، وقالت : ما تزال متيما ، % بنجد ، وإن كنت الصحيح ، قتيلا % % 14(@)(@@) % صدود شموس ، ثم لانت ، وقربت % إلي ، وقالت 
ms95	 لي : سألت قليلا ! % 15(@)(@@) % قدرت على ما عندنا من مودة ، % ودائم وصل ، إن وجدت وصولا % % 16(@)(@@) % لقد حليتك العين اول نظرة ، % وأعطيت مني ، يا ابن عم ، قبولا % % 17(@)(@@) % فأصبحت هما للفؤاد ، ومنية ، % وظلا من النعمى علي ، ظليلا % % 18(@)(@@) % أميرا على ما شئت مني مسلطا % فسل ، فلك الرحمن يمنح سولا % % 19(@)(@@) % فقلت لها : يا سكن إني لسائل % سؤال كريم ، ما سألت ، جميلا % % 20(@)(@@) % سألت بأن تعصي بنا قول كاشح ، % وإن كان ذا قربى لكم ، ودخيلا % % PageV01P400 21(@)(@@) % وأن لا تزال النفس منك مضيفة % علي ، وتبدي ، إن هلكت ، عويلا % % 22(@)(@@) % وأن تكرمي ، يوما ، إذا ما أتاكم % رسول ، لشجو ، مقصرا ومطيلا % % 23(@)(@@) % وأن تحفظي ب لغيب سري وتمنحي % % جليسك طرفا ، في الملام ، كليلا % % PageV01P401 البحر : بسيط تام 1(@)(@@) % يا صاحبي ، قفا نستخبر الطللا % % عن بعض من حله ب لأمس ، ما فعلا % % 2(@)(@@) % فقال لي الربع ، لما ان وقفت به : % إن الخليط أجد البين ف حتملا % % 3(@)(@@) % وخادعتك النوى حتى رأيتهم % في الفجر ، يحتث حادي عيرهم زجلا % % 4(@)(@@) % لما وقفنا نحييهم ، وقد شحطت % نعامة البين ، ف ستولت بهم أصلا % % 5(@)(@@) % قامت تراءى لحين ساقه قدر ، % وقد نرى انها لن تسبق الأجلا % % 6(@)(@@) % بفاحم مكرع سود غدائره % تثني على المتن منه واردا جثلا % % 7(@)(@@) % ومقلتي نعجة أدماء ، أسلمها % % أحوى المدامع ، طاوي الكشح قد خذلا % % 8(@)(@@) % ونير النبت عذب بارد خصر ، % ك لأقحوان عذاب طعمه رتلا % % 9(@)(@@) % كأن إسفنطة شيبت بذي شبم % من صوب أزرق هبت ريحه شملا % % 10(@)(@@) % والعنبر الاكلف المسحوق خالطه ، % والزنجبيل ، وراح الشام ، والعسلا % % PageV01P402 11(@)(@@) % تشفي الضجيع به ، وهنا ، عوارضها ، % إذا تغور هذا النجم و عتدلا % % 12(@)(@@) % قالت على رقبة يوما لجارتها : % ما تأمرين ؟ فإن القلب قد تبلا % % 13(@)(@@) % وهل لي اليوم من أخت مواسية % منكن ، أشكو إليها بعض ما عملا ؟ % 14(@)(@@) % فجاوبتها حصان غير فاحشة ، % برجع قول ، وأمر لم يكن خطلا : % 15(@)(@@) % إقني حياءك في ستر ، وفي كرم ، % فلست اول أنثى علقت رجلا % % 16(@)(@@) % لا تظهري حبه ، حتى أراجعه ، % إني سأكفيكه ، إن لم أمت 
ms96	 عجلا % % 17(@)(@@) % صدت بعادا ، وقالت للتي معها : % ب لله لوميه في بعض الذي فعلا % % 18(@)(@@) % وحدثيه بما حدثت ، و ستمعي % % ماذا يقول ، ولا تعيي به جدلا % % 19(@)(@@) % حتى يرى أن ما قال الوشاة له % فينا ، لديه إلينا كله نقلا % % 20(@)(@@) % وعرفيه به كالهزل ، واحتفظي % % في غير معتبة أن تغضبي الرجلا % % PageV01P403 21(@)(@@) % فإن عهدي به ، و لله يحفظه ، % وإن أتى الذنب ممن يكره العذلا % % 22(@)(@@) % لو عندنا غتيب ، أو نيلت نقيصته ، % ماى ب مغتابه من عندنا جذلا % % 23(@)(@@) % قلت : اسمعي فلقد أبلغت في لطف ، % وليس يخفى على ذي اللب من هزلا % % 24(@)(@@) % هذا أرادت به بخلا لنعذرها ، % وقد نرى أنها لن تعدم العللا % % 25(@)(@@) % ما سمي القلب إلا من تقلبه % ولا الفؤاد فؤادا غير ان عقلا % % 26(@)(@@) % أما الحديث الذي قالت أتيت به ، % فما عنيت به ، إذ جاءني ، حولا % % 27(@)(@@) % ما أطعت بها بالغيب ، قد علمت % مقالة الكاشح الواشي إذا محلا % % 28(@)(@@) % إني لأرجعه فيها بسخطته % وقد أتاني يرجي طاعتي نفلا % % PageV01P404 البحر : خفيف تام 1(@)(@@) % جن قلبي ، فقلت : يا قلب مهلا : % لا تبدل ب لحلم والعزم جهلا ! % 2(@)(@@) % حلفت أن ما اتاها يقين ، % قلت : لا تحلفي ، فديتك ، كلا ! % 3(@)(@@) % أسأل الله من بداك بصرم % أن يرى في الحياة ، ما عاش ، ذلا % 4(@)(@@) % فاتقي الله ، واقبلي العذر مني ، % وتجافي عن بعض ما كان زلا % 5(@)(@@) % لم أرحب بان سخطت ، ولكن % % مرحبا ، إن رضيت عنا ، وأهلا % % 6(@)(@@) % إن وجها أبصرته ليلة البد % ر عليه بتنى الجمال وحلا % 7(@)(@@) % وجهك الوجه لو به تسأل المز % % ن من الحسن والجمال استهلا % % 8(@)(@@) % وأسيل من الوجوه نضير ، % دق فيه حسن الجمال وجلا % 9(@)(@@) % إنني بالسلام منك لراض ، % وأرى ذاك من نوالك جزلا % % 10(@)(@@) % لا أخون الخليل ما عشت حتى % % ينقل البحر بالغرابيل نقلا % % PageV01P405 11(@)(@@) % ثم قالت : لا تعلمن بسري ، % يا ابن عمي ، اقسمت ! قلت : أجل ، لا % % 12(@)(@@) % إن أكن قد سأيتكم فلك العت % بى ، وهان الذي سألت ، وقلا % % 13(@)(@@) % من أراد الفجور في الود منا ، % ضرب 
ms97	 الله في ذراعيه غلا % 14(@)(@@) % حدثيني ، فدتك نفسي وأهلي ، % أتحبينني كحبك عدلا ؟ % 15(@)(@@) % إن في الصرم راحة من عناء ، % ونعم في الجواب ، أحسنث من لا % % PageV01P406 البحر : بسيط تام 1(@)(@@) % حي المنازل أضحى رسمها مثلا ، % إربع نسائلها ، لا بأس أن تسلا % % 2(@)(@@) % عن التي لم ير الرائي كصورتها % % إنسية ، وطئت سهلا ، ولا جبلا % % 3(@)(@@) % بيضاء جازئة ، نضح العبير بها ، % ممكورة الخلق ممن يألف الحجلا % % PageV01P407 البحر : بسيط تام 1(@)(@@) % هل تعرف اليوم رسم الدار والطللا ، % كما عرفت بجفن الصيقل الخللا ؟ % 2(@)(@@) % دار لمروة ، إذ أهلي وأهلهم % بالكانسية ، نرعى اللهو والغزلا % % 3(@)(@@) % أمسى شبابك عنا الغض قد رحلا % % ولاح في الرأس شيب ، حل ف شتعلا % % 4(@)(@@) % إن الشباب ، الذي كنا نزن به ، % ولى ، ولم نقض من لذاته أملا % 5(@)(@@) % ولى الشباب حميا غير مرتجع ، % واستبدل الرأس مني شر ما بدلا % % 6(@)(@@) % شيب تفرع أبكاني مواضحه % أضحى ، وحال سواد الرأس فانتقلا % % 7(@)(@@) % ليت الشباب بنا حلت رواحله ، % وأصبح الشيب عنا اليوم منتقلا % % 8(@)(@@) % أودى الشباب وأمسى الموت يخلفه % لا مرحبا بمحل الشيب إذ نزلا % % 9(@)(@@) % ما بال عرسي قد طالت مطالبتي % % أمست تجنى علي الذنب والعللا % % PageV01P408 البحر : خفيف تام 1(@)(@@) % يا خليلي ، سائلا الأطلالا ، % ب لبليين ، إن أجزن سؤالا % % 2(@)(@@) % وسفاه ، لولا الصبابة ، حبسي ، % في رسوم الديار ، ركبا عجالا % % 3(@)(@@) % بعدما أوحشت من آل الثريا ، % وأجدت فيها النعاج الظلالا % % 4(@)(@@) % يفرح القلب ، إن رآك ، وتستع % بر عيني ، إذا أردت احتمالا % % 5(@)(@@) % ولئن كان ينفع القرب ، ما أز % % داد ، فيما أراك ، إلا خبالا % % 6(@)(@@) % غير اني ما دمت جالسة عن % % دي ، سألهو ما لم تريدي زيالا % % 7(@)(@@) % فإذا ما نصرفت ، لم أر للعي % ش التذاذا ، ولا لشيء جمالا % % 8(@)(@@) % أنت عيشي ، نعم ، ورؤيتك الخل % % د ، وكنت الحديث والأشغالا % % 9(@)(@@) % حلت دون الفؤاد ، و لتذك القل % ب ، وخلى لك النساء الوصالا % % 10(@)(@@) % وتخلقت لي خلائق أعطت % % ك قيادي ، فما ملكت احتمالا % % PageV01P409 11(@)(@@) % أيها العاذلي ، أقل عتابي ، % لم أطع في وصالها العذالا % % 12(@)(@@) % إن ما قلت و 
ms98	 لذي عبت منها ، % لم يزدها في العين إلا جلالا % % 13(@)(@@) % لا تعبها ، فلن اطيعك فيها ، % لم أجد للوشاة فيها مقالا % % 14(@)(@@) % فيم ، بالله ، تقتلين محبا % لك ، بالول مخلصا ، بذالا % % 15(@)(@@) % ولعمري ، لئن هممت بقتلي ، % لبما قد قتلت قبلي الرجالا % % 16(@)(@@) % حدثيني عن هجركم ووصالي ، % أحراما ترينه أم حلالا ؟ % 17(@)(@@) % ف حكمي بيننا وقولي بعدل % هل جزاء المحب إلا الوصالا % % 18(@)(@@) % ليتني مت يوم ألثم فاها ، % إذ خشينا في منظر أهوالا % % 19(@)(@@) % إذ تمنيت أنني لك بعل ، % آه ، بل ليتني بخدك خالا ! % 20(@)(@@) % وبنو الحارث بن ذهل تبنى % % في ذرى المجد فرعها فاستطالا % % PageV01P410 البحر : كامل تام 1(@)(@@) % إن الحبيب تروحت اثقاله ، % أصلا ، فدمعك دائم إسباله % 2(@)(@@) % قد راح في تلك الحمول عشية % شخص يسرك حسنه وجماله % 3(@)(@@) % شخص غضيض الطرف مضطرب الحشا % % عبل المدملج مشبع خلخاله % 4(@)(@@) % ف قن الحياء ، فقد بكيت بعولة % لو كان ينفع باكيا إعواله % % 5(@)(@@) % يا حبذا تلك الحمول ، وحبذا % % شخص هناك ، وحبذا أمثاله % PageV01P411 البحر : كامل تام 1(@)(@@) % يا نعم ، قد طالت مماطلتي ، % إن كان ينفع عاشقا مطله % 2(@)(@@) % كان الشفاء لنا ومنيتنا % % منك ، الحديث ، فغالنا غيله % % 3(@)(@@) % ففديت من أشفى برؤيته % وأبى ، وكان كثيرة عدله % % 4(@)(@@) % ظبي تزينه عوارضه ، % والعين زين لحظها كحله % % 5(@)(@@) % ولو نها برزت لمنتصب % قس ، طويل الليل ، يبتهله % 6(@)(@@) % سيار أرض لا انيس بها ، % فيها شريعته ومبتقله % 7(@)(@@) % لصبا وألقى عنه برنسه ، % وسعى ، واهون سعيه رمله % % 8(@)(@@) % حتى يعاينها معاينة ، % غزلا ، وحق لقسهم غزله % % 9(@)(@@) % كنا نؤمل أن نفوز به ، % في من نؤمله ونختتله % 10(@)(@@) % حتى أتيح لظبينا رجل ، % من اهل مكة زانه حلله % % PageV01P412 11(@)(@@) % يغدو عليه الخز يسحبه ، % ويروح في عصب ويبتذله % 12(@)(@@) % فرمى ، فأقصدها برميته ، % ورنا ، فمهد للفتى أجله % % 13(@)(@@) % قالت لقينات يطفن بها % % حولي ، ودمعي دائم سبله : % 14(@)(@@) % أنتن زينتن فرقتنا ، % ولكل صاحب زينة عمله % 15(@)(@@) % لا تعجلاه أن يسائلنا ، % إن كان شف فؤاده ثقله % 16(@)(@@) % ففديت حامله وحاضره ، % وفديت ما يسمو به جمله % 17(@)(@@) % وفديت من كانت مساكنه 
ms99	 % ب لسهل ، أو مستوعر جبله % PageV01P413 البحر : كامل تام 1(@)(@@) % إن الخليط أجد ، فاحتملا ، % وأراد غيظك بالذي فعلا % % 2(@)(@@) % قد كنت آمل طول مكثهم ، % والنفس مما تامل الأملا % % 3(@)(@@) % فإذا البغال تشد واقفة ، % وإذا الحداة قد اعتبوا الإبلا % % 4(@)(@@) % فهناك كاد الحب يقتلني % % لو كان حب قبله قتلا % % 5(@)(@@) % إن الذين رجوت مكثهم % قد أجمعوا للبين محتملا % % PageV01P414 البحر : طويل 1(@)(@@) % خليلي ، مرا بي على رسم منزل ، % وربع لشنباء ابنة الخير ، محول % 2(@)(@@) % أتى دونه عصر ، فأخنى برسمه % خلوجان من ريح جنوب وشمال % 3(@)(@@) % سرا جل ضاحي جلده ملتقاهما ، % ومر صبا ب لمور هوجاء محمل % 4(@)(@@) % وبدل بعد الحي عينا سواكنا ، % وخيط نعام ب لأماعز همل % 5(@)(@@) % بما قد أرى شنباء حينا تحله ، % وأترابها ، في ناضر النبت مبقل % 6(@)(@@) % أعالي تصطاد الفؤاد نساؤهم % بعيني خذول مؤنق الجم مطفل % 7(@)(@@) % ووحف يثنى في العقاص كأنه % دواني قطوف ، أو أنابيب عنصل % 8(@)(@@) % تضل مداريها ، خلال فروعها ، % إذا أرسلتها ، أو كذا غير مرسل % % 9(@)(@@) % وتنكل عن غر ، شتيت نباته ، % عذاب ثناياه ، لذيذ المقبل % 10(@)(@@) % كمثل أقاحي الرمل ، يجلو متونه % سقوط ندى من آخر لليل مخضل % PageV01P415 11(@)(@@) % إذا ابتسمت ، قلت انكلال غمامة ، % خفا برقها في عارض متهلل % 12(@)(@@) % كأن سحيق المسك خالط طعمه % وريح الخزامى في جديد القرنفل % 13(@)(@@) % بصهباء ، درياق المدام ، كأنها % % إذا ما صفا راووقها ، ماء مفصل % % 14(@)(@@) % وتمشي على برديتين غذاهما % % يهاميم أنهار بأبطح مسهل % 15(@)(@@) % من الحور ، مخماص ، كأن وشاحها % % بعسلوج غاب ، بين غيل وجدول % 16(@)(@@) % قليلة إزعاج الحديث يروعها % % تعالي الضحى لم تنتطق عن تفضل % 17(@)(@@) % نؤوم الضحى ، ممكورة الخلق ، غادة ، % هضيم الحشا حسانة المتجمل % 18(@)(@@) % فأمست أحاديث الفؤاد وهمه ، % وإن كان منها قد غدا لم ينول % 19(@)(@@) % وقد هاجني منها على النأي دمنة % لها بقديد ، دون نعف المشلل % % 20(@)(@@) % أرادت ، فلم تسطع كلاما فأومأت % % إلينا ، ونصت جيد أحور مغزل % % PageV01P416 21(@)(@@) % فقلت لأصحابي : اربعوا بعض ساعة % علي ، وعوجوا من سواهم ذبل % 22(@)(@@) % قليلا ، فقالوا : إن أمرك طاعة ، % لما تشتهي فاقض الهوى 
ms100	 ، وتأمل % % 23(@)(@@) % لك اليوم حتى الليل ، إن شئت ، فأتهم % وصدر غد أو كله غير معجل % % 24(@)(@@) % فإنا على أن نسعف النفس ب لهوى % % حراص ، فما حاولت من ذاك فافعل % % 25(@)(@@) % ونص المطايا في رضاك وحبسها % % لك ، اليوم ، مبذول ، ولكن تجمل % 26(@)(@@) % فلما رأيت الحبس في رسمش منزل % سفاها وجهلا بالفؤاد الموكل % % 27(@)(@@) % فقلت لهم : سيروا فإن لقاءها % % توافي الحجيج ، بعد حول مكمل % % 28(@)(@@) % فما ذكره شنباء ، و لدار غربة ، % عنوج ، وإن يجمع يضر وينحل % % 29(@)(@@) % وإن تنأ ، تحدث للفؤاد زمانة ، % وإن تقترب تعد العوادي وتشغل % 30(@)(@@) % وإن يحضر الواشي تطعه ، وإن يقل % % بها كاشح عندي يجب ثم يعزل % % PageV01P417 31(@)(@@) % وإن تعد لا تحفل ، وإن تدن لا تصل ، % وإن تنأ لا نصبر ، وغن تدن أجذل % % 32(@)(@@) % وإن تلتمس منا المودة ، نعطها ، % % 33(@)(@@) % فقد طال ، لو تبكي إلى متجود ، % بكاك إلى شنباء ، يا قلب ، فاحتل % % 34(@)(@@) % أفق إنما تبكي إلى متمنع ، % من البخل ، مألوس الخليقة ، حول % % 35(@)(@@) % فقد كاد يسلو القلب عنها ، ومن يطل % % عليه التنائي والتباعد ، يذهل % % 36(@)(@@) % على أنه ، إن يلقها بعد غيبة ، % يعد لك داء عائد ، غير مرسل % % 37(@)(@@) % فإنك لو تدرين أن رب فتية % عجالى ، ولولا انت ، لم اتعجل % % 38(@)(@@) % منعتهم التعريس ، حتى بدا لهم % % قوارب معروف من الصبح منجل % 39(@)(@@) % ينصون ب لموماة خوصا كأنها % % شرائح ينع ، أو سراء معطل % % 40(@)(@@) % دقاقا براها السير ، منها منعل الس % السريح ، وواق من حفى لم ينعل % % PageV01P418 41(@)(@@) % وأضحوا جميعا تعرف العين فيهم % كرى النوم ، مسترخي العمائم ، ميل % 42(@)(@@) % على هدم جعد الثرى ذي مسافة % مخوف الردى ، عاري البنائق ، مهمل % % 43(@)(@@) % ترى جيف الحيتان فيه كأنها % % خيام على ماء حديث منهل % % 44(@)(@@) % إرادة أن ألقاك ، يا أثل ، و لهوى % % كذلك حمال الفتى كل محمل % % 45(@)(@@) % فبعض البعاد ، يا أثيل ، فإنني % % تروك الهوى ، عن الهوان بمعزل % 46(@)(@@) % أبى لي عرضي أن أضام ، وصارم % حسام ، وعز من حديث وأول % 47(@)(@@) % مقيم ، بإذن الله ، ليس ببارح ، % مكان الثريا قاهر كل منزل % 48(@)(@@) % أقرت معد 