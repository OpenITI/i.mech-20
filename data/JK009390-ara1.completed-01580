ms1561	 ' القضاعي عن ابن | مسعود رضي الله عنه . |(@)(@@)(@@)(@@) $ 14177 - قال النبي صلى الله عليه وسلم : ' علموا أبناءكم السباحة والرماية ونعم لهو المؤمنة | في بيتها المغزل ، وإذا دعاك أبواك فأجب أمك ' ابن منده في المعرفة وأبو موسى | في الذيل ( فر ) عن بكر بن عبد الله بن الربيع الأنصاري رضي الله عنه . |(@)(@@)(@@)(@@) $ 14178 - قال النبي صلى الله عليه وسلم : ' علموا أبناءكم السباحة والرمي ، والمرأة المغزل ' | ( هب ) عن ابن عمر رضي الله عنهما . |(@)(@@)(@@)(@@) $ ( 14179 ) قال النبي :(@)(@@) | 30 ( علموا الصبي الصلاة ابن سبع سنين ، واضربوه عليها ابن عشر ) )(@)(@@) ( حم ت طب ك ) عن سبرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14180 ) قال النبي :(@)(@@) | 30 ( علموا أولادكم الصلاة إذا بلغوا سبعا ، واضربوهم عليها إذا بلغوا عشرا ، وفرقوا بينهم في المضاجع ) )(@)(@@) البزار عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 14181 ) قال النبي :(@)(@@) | 30 ( علموا بنيكم الرمي فإنه نكاية العدو ) )(@)(@@) ( فر ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14182 ) قال النبي :(@)(@@) | 30 ( علموا رجالكم سورة المائدة وعلموا نساءكم سورة النور ) )(@)(@@) ( ص هب ) عن مجاهد مرسلا .(@)(@@)(@@)(@@) $ ( 14183 ) قال النبي :(@)(@@) | 30 ( علموا نس اءكم سورة الواقعة فإنها سورة الغنى ) )(@)(@@) ( فر ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 14184 ) قال النبي :(@)(@@) | 30 ( علموا ويسروا ولا تعسروا ، وبشروا ولا تنفروا ، PageV05P181 وإذا غضب أحدكم فليسكت ) )(@)(@@) ( حم خد ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 14185 ) قال النبي :(@)(@@) | 30 ( علموا ولا تعنفوا ، فإن المعلم خير من المعنف ) )(@)(@@) الحارث ( عد هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14186 ) قال النبي :(@)(@@) | 30 ( علمي حفصة رقية النملة ) )(@)(@@) أبو عبيد في الغرائب عن أبي بكر بن سليمان بن أبي حثمة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14187 ) قال النبي :(@)(@@) | 30 ( على الخمسين جمعة ) )(@)(@@) ( قط ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14188 ) قال النبي :(@)(@@) | 30 ( على الركت اليماني ملك موكل به منذ خلق الله السماوات والأرض ، فإذا مررتم به فقولوا ربنا آتنا في الدنيا حسنة وفي الآخرة حسنة وقنا عذاب النار ، فإنه يقول آمين آمين ) )(@)(@@) ( خط هب ) عن ابن عباس رضي الله عنهما موقوفا ( ض ) .(@)(@@)(@@)(@@) $ ( 14189 ) قال النبي :(@)(@@) | 30 ( على 
ms1562	 المقتتلين أن يحتجروا الأول فالأول وإن كانت امرأة ) )(@)(@@) ( د ن ) عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 14190 ) قال النبي :(@)(@@) | 30 ( على النساء ما على الرجال إلا الجمعة والجنائز والجهاد ) )(@)(@@) ( عب ) عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 14191 ) قال النبي :(@)(@@) | 30 ( على الوالي خمس خصال : جمع الفيء من حقه ، ووضعه في حقه ، وأن يستعين على أمورهم بخير من يعلم ، ولا يجمرهم فيهلكهم ، ولا يؤخر أمر يوم لغد ) )(@)(@@) ( عق ) عن واثلة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14192 ) قال النبي :(@)(@@) | 30 ( على اليد ما أخذت حتى تؤديه ) )(@)(@@) ( حم ( 4 ) ك ) عن PageV05P182 سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14193 ) قال النبي :(@)(@@) | 30 ( على أنقاب المدينة ملائكة لا يدخلها الطاعون ولا الدجال ) )(@)(@@) مالك ( حم ق ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14194 ) قال النبي :(@)(@@) | 30 ( على أهل كل بيت أن يذبحوا شاة في كل رجب ، وفي كل أضحى شاة ) )(@)(@@) ( طب ) عن مخنف بن سليم رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14195 ) قال النبي :(@)(@@) | 30 ( على ذروة كل بعير شيطان فامتهنوهن بالركوب فإنما يحمل الله تعالى ) )(@)(@@) ( ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14196 ) قال النبي :(@)(@@) | 30 ( على ظهر كل بعير شيطان فإذا ركبتموها فسموا بالله ولا تقصروا عن حاجاتكم ) )(@)(@@) ( حم ن حب ) عن حمزة بن عمرو الأسلمي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14197 ) قال النبي :(@)(@@) | 30 ( على كل باب من أبواب المسجد ملكان يكتبان الأول فالأول ، فكرجل قدم بدنة ، وكرجل قدم بقرة ، وكرجل قدم شاة ، وكرجل قدم طيرا ، وكرجل قدم بيضة ، فإذا قعد الإمام طويت الصحف ) )(@)(@@) ( حب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14198 ) قال النبي :(@)(@@) | 30 ( على كل بطن عقولة ) )(@)(@@) ( حم م ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14199 ) قال النبي :(@)(@@) | 30 ( على كل رجل مسلم في كل سبعة أيام غسل يوم PageV05P183 وهو يوم الجمعة ) )(@)(@@) ( حم ن حب ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14200 ) قال النبي :(@)(@@) | 30 ( على كل سلامى من ابن آدم في يوم صدقة ، ويجزي عن ذالك كله ركعتا الضحى ) )(@)(@@) ( طس ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 14201 ) قال النبي :(@)(@@) | 30 ( على كل محتلم رواح 
ms1563	 الجمعة وعلى كل من راح الجمعة الغسل ) )(@)(@@) ( د ) عن حفصة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 14202 ) قال النبي :(@)(@@) | 30 ( على كل مسلم صدقة ، فإن لم يجد فيعمل بيده فينفع نفسه ويتصدق ، فإن لم يستطع فيعين ذا الحاجة الملهوف ، فإن لم يفعل فيأمر بالخير ، فإن لم يفعل فيمسك عن الشر فإنه له صدقة ) )(@)(@@) ( حم ق ن ) عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14203 ) قال النبي :(@)(@@) | 30 ( على كل نفس في كل يوم طلعت عليه الشمس صدقة منه على نفسه ، من أبواب الصدقة التكبير ، وسبحان الله ، والحمد لله ، ولا إلاه إلا الله ، وأستغفر الله ، ويأمر بالمعروف وينهى عن المنكر ، ويعزل الشوك عن طريق الناس ، والعظم والحجر ، وتهدي الأعمى ، وتسمع الأصم والأبكم حتى يفقه ، وتدل المستدل على حاجة له قد علمت مكانها ، وتسعى بشدة ساقيك إلى اللهفان المستغيث ، وترفع بشدة ذراعيك مع الضعيف ، كل ذالك من أبواب الصدقة منك على نفسك ، ولك في جماعك زوجتك أجر ، أرأيت لو كان لك ولد فأدرك ورجوت أجره فمات أكنت تحتسب به ؟ فأنت خلقته ؟ فأنت هديته ، فأنت كنت رزقته ؟ فكذالك فضعه في حلاله ، وجنبه حرامه ، فإن شاء الله أحياه ، وإن شاء أماته ولك أجر ) )(@)(@@) ( حم ن حب ) عن أبي ذر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 14204 ) قال النبي :(@)(@@) | 30 ( على مثل جعفر فلتبك الباكية ) )(@)(@@) ابن عساكر عن PageV05P184 أسماء بنت عميس رضي الله عنها .(@)(@@)(@@)(@@) $ ( 14205 ) قال النبي :(@)(@@) | 30 ( عليك السمع والطاعة في عسرك ويسرك ، ومنشطك ومكرهك وأثرة عليك ) )(@)(@@) ( حم م ن ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14206 ) قال النبي :(@)(@@) | 30 ( عليك بالإياس مما في أيدي الناس ، وإياك والطمع فإنه الفقر الحاضر ، وصل صلاتك وأنت مودع ، وإياك وما يعتذر منه ) )(@)(@@) ( ك ) عن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14207 ) قال النبي :(@)(@@) | 30 ( عليك بالبر ، فإن صاحب البر يعجبه أن يكون الناس بخير وفي خصب ) )(@)(@@) ( خط ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14208 ) قال النبي :(@)(@@) | 30 ( عليك بالخيل فإن الخيل معقود في نواصيها الخير إلى يوم القيامة ) )(@)(@@) ( طب ) و الضياء عن سوادة بن 
ms1564	 الربيع رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14209 ) قال النبي :(@)(@@) | 30 ( عليك بالرفق إن الرفق لا يكون في شيء إلا زانه ، ولا ينزع من شيء إلا شانه ) )(@)(@@) ( م ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 14210 ) قال النبي :(@)(@@) | 30 ( عليك بالرفق ، وإياك والعنف والفحش ) )(@)(@@) ( خد ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 14211 ) قال النبي :(@)(@@) | 30 ( عليك بالصعيد فإنه يكفيك ) )(@)(@@) ( ق ن ) عن عمران بن حصين رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14212 ) قال النبي :(@)(@@) | 30 ( عليك بالصوم فإنه لا مثل له ) )(@)(@@) ( حم ن حب ك ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14213 ) قال النبي :(@)(@@) | 30 ( عليك بالصوم فإنه مخصى ) )(@)(@@) ( هب ) عن قدامة بن مظعون PageV05P185 عن أخيه عثمان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14214 ) قال النبي :(@)(@@) | 30 ( عليك بالصلاة فإنها أفضل الجهاد ، واهجري المعاصي فإنها أفضل الهجرة ) )(@)(@@) المحاملي في أماليه عن أم أنس رضي الله عنها .(@)(@@)(@@)(@@) $ ( 14215 ) قال النبي :(@)(@@) | 30 ( عليك بالعلم فإن العلم خليل المؤمن ، والحلم وزيره ، والعقل دليله ، والعمل قيمه ، والرفق أبوه ، واللين أخوه ، والصبر أمير جنوده ) )(@)(@@) الحكيم عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 14216 ) قال النبي :(@)(@@) | 30 ( عليك بالهجرة فإنه لا مثل لها ، عليك بالجهاد فإنه لا مثل له ، عليك بالصوم فإنه لا مثل له ، عليك بالسجود فإنك لا تسجد لله سجدة إلا رفعك الله بها درجة وحط عنك بها خطيئة ) )(@)(@@) ( طب ) عن أبي فاطمة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 14217 ) قال النبي :(@)(@@) | 30 ( عليك بأول السوم فإن الربح مع السماح ) )(@)(@@) ( ش د ) في مراسيله ( هق ) عن الزهري مرسلا .(@)(@@)(@@)(@@) $ ( 14218 ) قال النبي :(@)(@@) | 30 ( عليك بتقوى الله فإنها جماع كل خير ، وعليك بالجهاد فإنه رهبانية المسلمين ، وعليك بذكر الله وتلاوة كتاب الله فإنه نور لك في الأرض وذكر لك في السماء ، واخزن لسانك إلا من خير ، فإنك بذالك تغلب الشيطان ) )(@)(@@) ابن الضريس ( ع ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14219 ) قال النبي :(@)(@@) | 30 ( عليك بتقوى الله عز وجل ما استطعت ، واذكر الله عند كل حجر وشجر ، وإذا عملت سيئة فأحدث عندها توبة ، السر بالسر والعلانية بالعلانية ) )(@)(@@) ( حم ) في الزهد ( طب ) عن معاذ 
ms1565	 رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14220 ) قال النبي :(@)(@@) | 30 ( عليك بتقوى الله تعالى والتكبير على كل شرف ) )(@)(@@) ( ت ) عن أبي هريرة رضي الله عنه .(@)(@@) PageV05P186(@)(@@)(@@)(@@) $ ( 14221 ) قال النبي :(@)(@@) | 30 ( عليك بجمل الدعاء وجوامعه قولي : اللهم إني أسألك من الخير كله عاجله وآجله ما علمت منه وما لم أعلم ، وأعوذ بك من الشر كله عاجله وآجله ما علمت منه وما لم أعلم ، وأسألك الجنة وما قرب إليها من قول أو عمل ، وأعوذ بك من النار وما قرب إليها من قول أو عمل ، وأسألك مما سألك به محمد ، وأعوذ بك مما تعوذ به محمد ، وما قضيت لي من قضاء فاجعل عاقبته رشدا ) )(@)(@@) ( خد ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 14222 ) قال النبي :(@)(@@) | 30 ( عليك بحسن الخلق ، فإن أحسن الناس خلقا أحسنهم دينا ) )(@)(@@) ( طب ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14223 ) قال النبي :(@)(@@) | 30 ( عليك بحسن الخلق وطول الصمت ، فوالذي نفسي بيده ما تجمل الخلائق بمثلهما ) )(@)(@@) ( ع ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14224 ) قال النبي :(@)(@@) | 30 ( عليك بحسن الكلام وبذل الطعام ) )(@)(@@) ( خد ك ) عن هانىء بن يزيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14225 ) قال النبي :(@)(@@) | 30 ( عليك بركعتي الفجر فإن فيهما فضيلة ) )(@)(@@) ( طب ) عن ابن عمر رضي الله عنهما . |(@)(@@)(@@)(@@) $ 14226 - قال النبي صلى الله عليه وسلم : ' عليك بسبحان الله والحمد لله ولا إله إلا الله والله | أكبر فإنهن يحططن الخطايا كما تحط الشجرة ورقها ' ( ه ) عن أبي الدرداء رضي | الله عنه . |(@)(@@)(@@)(@@) $ 14227 - قال النبي صلى الله عليه وسلم : ' عليك بطيب الكلام ، وبذل السلام ، وإطعام | الطعام ' ( حب ) عن هانئ بن يزيد رضي الله عنه ( ز ) . | PageV05P187 |(@)(@@)(@@)(@@) $ 14288 - قال النبي صلى الله عليه وسلم : ' عليك بكثرة السجود فإنك لا تسجد لله سجدة إلا | رفعك الله بها درجة وحط بها عنك خطيئة ' ( حم م ت ن ه ) عن ثوبان وأبي | الدرداء رضي الله عنهما . |(@)(@@)(@@)(@@) $ 14229 - قال النبي صلى الله عليه وسلم : ' عليكم بأبوال الإبل البرية وألبانها ' ابن السني | وأبو نعيم عن صهيب رضي الله عنه . |(@)(@@)(@@)(@@) $ 14230 - قال النبي صلى الله عليه وسلم : ' عليكم بأسقية 
ms1566	 الأدم التي يلاث على | أفواهها ' ( د ) عن ابن عباس رضي الله عنهما . |(@)(@@)(@@)(@@) $ 14231 - قال النبي صلى الله عليه وسلم : ' عليكم باصطناع المعروف فإنه يمنع مصارع | السوء ، وعليكم بصدقة السر فإنها تطفئ غضب الرب عز وجل ' ابن أبي الدنيا في | قضاء الحوائج عن ابن عباس رضي الله عنهما . |(@)(@@)(@@)(@@) $ 14232 - قال النبي صلى الله عليه وسلم : ' عليكم بالأبكار ، فإنهن أعذب أفواها ، وأنتق | أرحاما ، وأسخن أقبالا ، وأرضى باليسير من العمل ' ابن السني وأبو نعيم في | الطب عن ابن عمر رضي الله عنهما . |(@)(@@)(@@)(@@) $ 14233 - قال النبي صلى الله عليه وسلم : ' عليكم بالأبكار ، فإنهن أنتق أرحاما ، وأعذب | أفواها ، وأقل خبا ، وأرضى باليسير ' ( طس ) والضياء عن جابر رضي الله عنه . |(@)(@@)(@@)(@@) $ 14234 - قال النبي صلى الله عليه وسلم : ' عليكم بالأترج فإنه يشد الفؤاد ' ( فر ) عن | عبد الرحمن بن دلهم رضي الله عنه معضلا . |(@)(@@)(@@)(@@) $ 14235 - قال النبي صلى الله عليه وسلم : ' عليكم بالإثمد عند النوم ، فإنه يجلو البصر وينبت | PageV05P188 | الشعر ' ( ه ) عن جابر ( ه ك ) عن ابن عمر رضي الله عنهما . |(@)(@@)(@@)(@@) $ 14236 - قال النبي صلى الله عليه وسلم : ' عليكم بالإثمد فإنه منبتة للشعر ، مذهبة للقذى ، | مصفاة للبصر ' ( طب حل ) عن علي رضي الله عنه . |(@)(@@)(@@)(@@) $ 14237 - قال النبي صلى الله عليه وسلم : ' عليكم بالإثمد فإنه يجلو البصر وينبت الشعر ' | ( حل ) عن ابن عباس رضي الله عنهما . |(@)(@@)(@@)(@@) $ 14238 - قال النبي صلى الله عليه وسلم : ' عليكم بالأسود البهيم ذي النقطتين فإنه شيطان ' | ( م ) عن جابر رضي الله عنه ( ز ) . |(@)(@@)(@@)(@@) $ 14239 - قال النبي صلى الله عليه وسلم : ' عليكم بالباءة ، فمن لم يستطع فعليه بالصوم فإنه | له وجاء ' ( طس ) والضياء عن أنس رضي الله عنه . |(@)(@@)(@@)(@@) $ 14240 - قال النبي صلى الله عليه وسلم : ' عليكم بألبان الإبل والبقر فإنها ترم من الشجر كله | وهو دواء من كل داء ' ابن عساكر عن طارق بن شهاب رضي الله عنه . |(@)(@@)(@@)(@@) $ 14241 - قال النبي صلى الله عليه وسلم : ' عليكم بألبان البقر فإنها ترم من كل الشجر ، وهو | شفاء من كل داء ' ( ك ) عن ابن مسعود رضي الله عنه . |(@)(@@)(@@)(@@) $ 14242 
ms1567	 - قال النبي صلى الله عليه وسلم : ' عليكم بألبان البقر فإنها دواء ، وأسمانها فإنها | شفاء ، وإياكم ولحومها فإن لحومها داء ' ابن السني وأبو نعيم ( ك ) عن ابن مسعود | رضي الله عنه . |(@)(@@)(@@)(@@) $ 14243 - قال النبي صلى الله عليه وسلم : ' عليكم بألبان البقر فإنها شفاء ، وسمنها دواء ، | ولحمها داء ' ابن السني وأبو نعيم عن صهيب رضي الله عنه . |(@)(@@)(@@)(@@) $ 14244 - قال النبي صلى الله عليه وسلم : ' عليكم بالبغيض النافع التلبينة ، فوالذي نفسي | PageV05P189 | بيده إنه ليغسل بطن أحدكم كما يغسل أحدكم الوسخ عن وجهه بالماء ' ( ه ك ) | عن عائشة رضي الله عنها . |(@)(@@)(@@)(@@) $ 14245 - قال النبي صلى الله عليه وسلم : ' عليكم بالبياض من الثياب فليلبسها أحياؤكم ، | وكفنوا فيها موتاكم فإنها خير ثيابكم ' ( حم ن ك ) عن سمرة رضي الله عنه . |(@)(@@)(@@)(@@) $ 14246 - قال النبي صلى الله عليه وسلم : ' عليكم بالتسبيح والتهليل والتقديس ، واعقدن | بالأنامل فإنهن مسؤولات مستنطقات ولا تغفلن فتنسين الرحمة ' ( ت ك ) عن يسير | رضي الله عنه . |(@)(@@)(@@)(@@) $ ( 14247 ) قال النبي :(@)(@@) | 30 ( عليكم بالتواضع ، فإن التواضع في القلب ، ولا يؤذين مسلم مسلما ، فلرب متضاعف في أطمار لو أقسم على الله لأبره ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14248 ) قال النبي :(@)(@@) | 30 ( عليكم بالثفاء ، فإن الله جعل فيه شفاء من كل داء ) )(@)(@@) ابن السني وأبو نعيم عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14249 ) قال النبي :(@)(@@) | 30 ( عليكم بالجهاد في سبيل الله فإنه باب من أبواب الجنة يذهب الله به الهم والغم ) )(@)(@@) ( طس ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14250 ) قال النبي :(@)(@@) | 30 ( عليكم بالحجامة في جوزة القمحدوة فإنها دواء من اثنين وسبعين داء وخمسة أدواء من الجنون والجذام والبرص ووجع الأضراس ) )(@)(@@) ( طب ) و ابن السني وأبو نعيم عن صهيب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14251 ) قال النبي :(@)(@@) | 30 ( عليكم بالحزن فإنه مفتاح القلب ، أجيعوا أنفسكم PageV05P190 وأظمئوها ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 14252 ) قال النبي :(@)(@@) | 30 ( عليكم بالحناء فإنه ينور رءوسكم ، ويطهر قلوبكم ، ويزيد في الجماع ، وهو شاهد في القبر ) )(@)(@@) ابن عساكر عن واثلة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14253 
ms1568	 ) قال النبي :(@)(@@) | 30 ( عليكم بالدلجة فإن الأرض تطوى بالليل ) )(@)(@@) ( د ك هق ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14254 ) قال النبي :(@)(@@) | 30 ( عليكم بالرمي فإنه من خير لعبكم ) )(@)(@@) ( طس ) عن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14255 ) قال النبي :(@)(@@) | 30 ( عليكم بالرمي فإنه من خير لهوكم ) )(@)(@@) البزار عن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14256 ) قال النبي :(@)(@@) | 30 ( عليكم بالزبيب فإنه يكشف المرة ويذهب بالبلغم ، ويشد العصب ، ويذهب بالعياء ، ويحسن الخلق ، ويطيب النفس ، ويذهب بالهم ) )(@)(@@) أبو نعيم عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14257 ) قال النبي :(@)(@@) | 30 ( عليكم بالسراري فإنهن مباركات الأرحام ) )(@)(@@) ( طس ك ) عن أبي الدرداء ( د ) في مراسيله والعدني عن رجل من بني هاشم مرسلا .(@)(@@)(@@)(@@) $ ( 14258 ) قال النبي :(@)(@@) | 30 ( عليكم بالسكينة ، عليكم بالقصد في المشي بجنائزكم ) )(@)(@@) ( طب هق ) عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14259 ) قال النبي :(@)(@@) | 30 ( عليكم بالسنا والسنوت فإن فيهما شفاء من كل داء إلا السام وهو الموت ) )(@)(@@) ( ه ك ) عن عبد الله بن أم حرام رضي الله عنه .(@)(@@) PageV05P191(@)(@@)(@@)(@@) $ ( 14260 ) قال النبي :(@)(@@) | 30 ( عليكم بالسواك فإنه مطيبة للفم ، مرضاة للرب ) )(@)(@@) ( حم ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 14261 ) قال النبي :(@)(@@) | 30 ( عليكم بالسواك فنعم الشيء السواك ، يذهب بالحفر ، وينزع البلغم ، ويجلو البصر ، ويشد اللثة ، ويذهب بالبخر ، ويصلح المعدة ، ويزيد في درجات الجنة ، ويحمد الملائكة ، ويرضي الرب ويسخط الشيطان ) )(@)(@@) عبد الجبار الخولاني في تاريخ داريا عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14262 ) قال النبي :(@)(@@) | 30 ( عليكم بالشام ) )(@)(@@) ( طب ) عن معاوية بن حيدة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14263 ) قال النبي :(@)(@@) | 30 ( عليكم بالشام فإنها صفوة بلاد الله يسكنها خيرته من خلقه فمن أبى فليلحق بيمنه ، وليسق من غدره ، فإن الله عز وجل تكفل لي بالشام وأهله ) )(@)(@@) ( طب ) عن واثلة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14264 ) قال النبي :(@)(@@) | 30 ( عليكم بالشفاءين : العسل والقرآن ) )(@)(@@) ( ه ك ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14265 ) قال النبي :(@)(@@) | 30 ( عليكم بالصدق ، فإن الصدق يهدي إلى البر ، وإن البر يهدي إلى الجنة ، وما يزال الرجل يصدق ويتحرى الصدق حتى يكتب عند الله 
ms1569	 صديقا ، وإياكم والكذب فإن الكذب يهدي إلى الفجور ، وإن الفجور يهدي إلى النار ، وما يزال الرجل يكذب ويتحرى الكذب حتى يكتب عند الله كذابا ) )(@)(@@) ( حم خد م ت ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14266 ) قال النبي :(@)(@@) | 30 ( عليكم بالصدق فإنه باب من أبواب الجنة ، وإياكم PageV05P192 والكذب فإنه باب من أبواب النار ) )(@)(@@) ( خط ) عن أبي بكر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14267 ) قال النبي :(@)(@@) | 30 ( عليكم بالصدق فإنه مع البر وهما في الجنة ، وإياكم والكذب فإنه مع الفجور وهما في النار ، وسلوا الله اليقين والمعافاة ، فإنه لم يؤت أحد بعد اليقين خيرا من المعافاة ، ولا تحاسدوا ولا تباغضوا ، ولا تقاطعوا ولا تدابروا وكونوا عباد الله إخوانا كما أمركم الله ) )(@)(@@) ( حم خد ه ) عن أبي بكر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14268 ) قال النبي :(@)(@@) | 30 ( عليكم بالصف الأول ، وعليكم بالميمنة ، وإياكم والصف بين السواري ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 14269 ) قال النبي :(@)(@@) | 30 ( عليكم بالصلاة فيما بين العشاءين فإنها تذهب بملاغاة النهار ) )(@)(@@) ( فر ) عن سل مان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14270 ) قال النبي :(@)(@@) | 30 ( عليكم بالصوم فإنه محسمة للعروق ومذهبة للأشر ) )(@)(@@) أبو نعيم في الطب عن شداد بن عبد الله رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14271 ) قال النبي :(@)(@@) | 30 ( عليكم بالعمائم فإنها سيماء الملائكة ، وأرخوا لها خلف ظهوركم ) )(@)(@@) ( طب ) عن ابن عمر ( هب ) عن عبادة رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 14272 ) قال النبي :(@)(@@) | 30 ( عليكم بالغنم فإنها من دواب الجنة ، وصلوا في مراحها ، وامسحوا رغامها ) )(@)(@@) ( طب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 14273 ) قال النبي :(@)(@@) | 30 ( عليكم بالقرآن فاتخذوه إماما وقائدا فإنه كلام رب العالمين الذي هو منه وإليه يعود ، فآمنوا بمتشابهه ، واعتبروا بأمثاله ) )(@)(@@) ابن شاهين في السنة وابن مردويه عن علي رضي الله عنه .(@)(@@) PageV05P193(@)(@@)(@@)(@@) $ ( 14274 ) قال النبي :(@)(@@) | 30 ( عليكم بالقرع فإنه يزيد في الدماغ ، وعليكم بالعدس فإنه قدس على لسان سبعين نبيا ) )(@)(@@) ( طب ) عن و اثلة رضي الله عنه .(@)(@@)(@@)(@@) $ (