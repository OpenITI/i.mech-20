ms661	 بالغبري، يروي عن: أبي ثعلبة الخشني، روى عنه: أبو الزبير.(@)(@@)(@@)(@@) ||| AUTO عمر بن محرز الأشجعي(@)(@@) يروي عن: جماعة من أصحاب النبي صلى الله عليه وسلم روى عنه: الزهري، وهو أول مولود ولد في الإسلام بحمص.(@)(@@)(@@)(@@) ||| AUTO عمر بن الهجنع(@)(@@) يروي عن: أبي بكرة، روى عنه: عطاء بن السائب.(@)(@@)(@@)(@@) ||| AUTO عمر بن معدان(@)(@@) من أهل البصرة، يروي عن: أنس بن مالك، روى عنه: قتادة، مات قبل ابن سيرين.(@)(@@)(@@)(@@) ||| AUTO عمر بن هارون الزرقي الأنصاري(@)(@@) من أهل المدينة، يروي عن: أبي هريرة، روى عنه: يحيى بن حمزة.(@)(@@)(@@)(@@) ||| AUTO عمر بن مهاجر أبو حفص الأنصاري(@)(@@) من أهل البصرة، يروي عن: أنس بن مالك، روى عنه: الثوري.(@)PageV01P002(@)(@@) [ج 2: ص 356](@)(@@)(@@)(@@) ||| AUTO عمر بن أبان(@)(@@) يروي عن: ابن عمر، روى عنه: ابنه إبراهيم بن عمر.(@)(@@)(@@)(@@) ||| AUTO عمر بن خالد الوهبي(@)(@@) يروي عن: أنس بن مالك، عداده في أهل الشام، روى عنه: الحسن بن حاتم الألهاني.(@)(@@) (193) -[2: 356] ثنا عبد الصمد بن سعيد بحمص، قال: ثنا أحمد بن إبراهيم، قال: ثنا الحسن بن حاتم الألهاني، قال: ثنا عمر بن خالد الوهبي، قال: ثنا أنس بن مالك، قال: قال النبي صلى الله عليه وسلم: " إذا سمعتم المؤذن أذن فقولوا: اللهم افتح أقفال قلوبنا لذكرك، وأتمم علينا نعمتك وفضلك، واجعلنا في عبادك الصالحين "(@)(@@)(@@)(@@) ||| AUTO عمر بن نافع الثقفي(@)(@@) يروي عن: أنس بن مالك، روى عنه: أبو معاوية، ويحيى بن مصعب.(@)(@@)(@@)(@@) ||| AUTO عمر بن يحيى الزرقي الأنصاري(@)(@@) يروي عن: عمر إن كان سمع منه، روى عنه: عبد الله بن عون.(@)(@@)(@@)(@@) ||| AUTO عمر التميمي(@)(@@) شيخ، يروي عن: الحسن بن علي، روى عنه: ابنه يزيد بن عمر.(@)(@@)(@@)(@@) ||| AUTO عثمان بن إبراهيم بن محمد بن حاطب القرشي(@)(@@) يروي عن: عمر، روى عنه: ابنه عبد الرحمن بن عثمان، ويعلى بن عبيد.(@)(@@)(@@)(@@) ||| AUTO عثمان بن أبي سودة(@)(@@) أخو زياد بن أبي سودة سمع عبادة بن الصامت، أبوهما مولى لعبد الله بن عمرو بن العاص، وأمهما مولاة لعبادة بن الصامت، عداده في أهل بيت المقدس، روى عنه: زيد 
ms662	 بن واقد، وأهل الشام.(@)(@@)(@@)(@@) ||| AUTO عثمان بن عبد الله بن سراقة المدني العدوي(@)(@@) يروي عن: ابن عمر، روى عنه: الزهري، وعبيد الله بن عمر، كنيته أبو عبد الله، أمه زينب بنت عمر بن الخطاب، وهو عثمان بن عبد الله بن سراقة بن المعتمر بن أداة بن رباح بن عبد الله بن قرط بن رزاح بن عدي بن كعب.(@)PageV01P002(@)(@@) [ج 2: ص 357](@)(@@)(@@)(@@) ||| AUTO عثمان بن صهيب بن سنان(@)(@@) يروي عن: أبيه، روى عنه: ابن الهاد.(@)(@@)(@@)(@@) ||| AUTO عثمان بن وكيع العبدي(@)(@@) من أهل البصرة، يروي عن: سبعة من أصحاب رسول الله صلى الله عليه وسلم روى عنه: السكن بن أبي السكن.(@)(@@)(@@)(@@) ||| AUTO عثمان بن جابر(@)(@@) يروي عن: أنس بن مالك، روى عنه: صفوان بن عمرو.(@)(@@)(@@)(@@) ||| AUTO عثمان بن أجيل(@)(@@) يروي عن: عتبة بن عبد، عداده في أهل الشام، روى عنه: فرج بن يزيد.(@)(@@)(@@)(@@) ||| AUTO عثمان بن جحاش(@)(@@) ابن أخي سمرة بن جندب، يروي عن: سمرة بن جندب، روى عنه: عقبة بن سيار.(@)(@@)(@@)(@@) ||| AUTO عثمان بن حفص بن خلدة الزرقي(@)(@@) يروي عن: معاوية، روى عنه: عبد العزيز الماجشون.(@)(@@)(@@)(@@) ||| AUTO عثمان بن حاضر الحميري، أبو حاضر(@)(@@) يروي عن: ابن عباس، روى عنه: زياد بن سعد، وإسماعيل بن أمية.(@)(@@)(@@)(@@) ||| AUTO عثمان بن سليمان بن أبي حثمة القرشي(@)(@@) أخو أبي بكر بن سليمان، يروي عن: رجل من أصحاب النبي صلى الله عليه وسلم روى عنه: الزهري.(@)(@@)(@@)(@@) ||| AUTO عثمان بن يزدويه أبو عمرو(@)(@@) يروي عن: أنس بن مالك، روى عنه: عبد الرزاق، عن أبيه عنه، وقد روى عنه: معمر، وابن أبي رواد.(@)PageV01P002(@)(@@) [ج 2: ص 358](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO عثمان بن ربيعة بن الهدير التيمي القرشي(@)(@@) يروي المراسيل، روى عنه: كثير بن زيد.(@)(@@) عثمان(@)(@@) مولى آل الزبير، يروي عن: ابن عمر، روى عنه: إسماعيل بن أبي خالد.(@)(@@)(@@)(@@) ||| AUTO عثمان بن سليمان بن صبيح(@)(@@) يروي عن: أبي سعيد الخدري، روى عنه: عثمان بن حكيم.(@)(@@)(@@)(@@) ||| AUTO عثمان الطويل(@)(@@) من أهل الجزيرة، عداده في أهل البصرة، يروي عن: أنس بن مالك، ربما أخطأ، روى 
ms663	 عنه: شعبة بن الحجاج، وزهير بن معاوية.(@)(@@)(@@)(@@) ||| AUTO عثمان بن عبيد الله(@)(@@) مولى سعد بن أبي وقاص، يروي عن: أبي أسيد، وأبي قتادة، وأبي قتادة، روى عنه: ابن أبي ذئب.(@)(@@)(@@)(@@) ||| AUTO عثمان بن الأرقم بن أبي الأرقم، كنيته أبو عمر(@)(@@) يروي عن: أبيه، روى عنه: أهل الحجاز، وابن ابنه يحيى بن عمران بن عثمان.(@)(@@)(@@)(@@) ||| AUTO عثمان بن البهي بن أبي رافع(@)(@@) مولى رسول الله صلى الله عليه وسلم يروي عن: جده، روى عنه: حماد بن موسى المديني، ويروي أيضا، عن أبيه وقد قيل: إن اسم البهي: عبيد الله.(@)(@@)(@@)(@@) ||| AUTO عثمان بن عبد الرحمن التيمي(@)(@@) يروي عن: أنس بن مالك، روى عنه: فليح بن سليمان.(@)(@@)(@@)(@@) ||| AUTO عثمان بن شماس(@)(@@) مولى عبد الله بن عباس، يروي عن: أبي هريرة، PageV01P002 [ج 2: ص 359] روى عنه: ابنه موسى بن عثمان.(@)(@@)(@@)(@@) ||| AUTO عثمان بن قيس(@)(@@) من أهل الكوفة، يروي عن: جرير بن عبد الله، روى عنه: إسماعيل بن أبي خالد.(@)(@@)(@@)(@@) ||| AUTO عثمان بن أبي الصهباء القرشي(@)(@@) من أهل البصرة، يروي عن: أبي هريرة، روى عنه: البصريون.(@)(@@)(@@)(@@) ||| AUTO عثمان بن أبي صفية الأنصاري(@)(@@) يروي عن: ابن عباس، عداده في أهل الكوفة، روى عنه: صالح بن حي، وصالح بن جبير.(@)(@@)(@@)(@@) ||| AUTO عثمان بن محمد بن أبي سويد(@)(@@) يروي المراسيل، روى عنه: الزهري.(@)(@@)(@@)(@@) ||| AUTO عثمان بن سليمان بن جرموز(@)(@@) يروي عن: أنس بن مالك، روى عنه: أهل البصرة.(@)(@@)(@@)(@@) ||| AUTO عثمان بن عبد الله بن موهب القرشي(@)(@@) مولى طلحة بن عبيد الله، أصله من المدينة، انتقل إلى العراق، يروي عن: أبي هريرة، روى عنه: الثوري، وابنه عمرو بن عثمان.(@)(@@)(@@)(@@) ||| AUTO عثمان بن عامر بن زيد الأنصاري(@)(@@) من بني عمرو بن عوف، يروي عن: أنس بن مالك، عداده في أهل المدينة، روى عنه: ابن أخيه عاصم بن سويد المدني، قال: " جاءنا أنس بن مالك بقباء وعليه جبة أفواف، وسراويل أفواف فتنحى فبال، ثم قام إلى الجدار فنثر ذكره مرتين أو ثلاثا، ثم أتى بتور من ماء فتوضأ، ومسح على الخفين ثم 
ms664	 دخل المسجد فصلى ".(@)(@@)(@@)(@@) ||| AUTO عثمان بن عبيد الراسبي(@)(@@) يروي عن: أبي الطفيل، روى عنه: مهدي بن ميمون، وحماد بن زيد.(@)PageV01P002(@)(@@) [ج 2: ص 360](@)(@@)(@@)(@@) ||| AUTO عثمان بن محصن(@)(@@) يروي عن: ابن عباس، روى عنه: نوح بن قيس الطاحي.(@)(@@)(@@)(@@) ||| AUTO عثمان بن إبراهيم بن محمد بن حاطب(@)(@@) يروي عن: ابن عمر، روى عنه: ابنه عبد الرحمن بن عثمان.(@)(@@)(@@)(@@) ||| AUTO علي بن حسين بن علي بن أبي طالب الهاشمي المدني، كنيته أبو الحسن، وقد قيل: أبو محمد(@)(@@) وكان من أفاضل بني هاشم، من فقهاء أهل المدينة وعبادهم، يروي عن: جماعة من أصحاب رسول الله صلى الله عليه وسلم روى عنه: الزهري، وأهل المدينة، مات سنة ثنتين وتسعين وله ثمان وخمسون سنة، وقد قيل: إنه مات سنة أربع وتسعين، وأمه أم ولد، وكان يقال بالمدينة: إن علي بن الحسين سيد العابدين في ذلك الزمان.(@)(@@)(@@)(@@) ||| AUTO علي بن عبد الله بن عباس بن عبد المطلب الهاشمي، كنيته أبو محمد، وقد قيل: أبو عبد الله(@)(@@) ولد ليلة قتل علي بن أبي طالب فسمى باسمه، يروي عن: أبيه، روى عنه: الزهري، وابنه محمد بن علي، وكان من العباد يصلى في كل يوم ألف ركعة، وكان يخضب بالوسمة، مات بالشام سنة ثمان عشرة ومائة، وقد قيل: سنة أربع عشرة ومائة، وقد قيل: سنة سبع عشرة ومائة، أمه زرعة بنت مشرح بن معد يكرب.(@)(@@)(@@)(@@) ||| AUTO علي بن ربيعة الوالبي الأسدي(@)(@@) ووالبة من أسد بن خزيمة، كنيته أبو المغيرة، عداده في أهل الكوفة، يروي عن: علي، وابن عمر، روى عنه: سعيد بن عبيدة، وسلمة بن كهيل، وهو علي بن ربيعة بن لقيط بن ربيعة بن خالد بن مالك بن عامر بن خراش بن نمير بن والبة بن الحارث بن ثعلبة بن دودان بن أسد بن خزيمة.(@)PageV01P002(@)(@@) [ج 2: ص 361](@)(@@)(@@)(@@) ||| AUTO علي بن رفاعة بن رافع(@)(@@) يروي عن: أبيه، وله صحبة، روى عنه: يحيى بن جعدة.(@)(@@)(@@)(@@) ||| AUTO أبو المتوكل الناجي، اسمه علي بن داود، ويقال: داود(@)(@@) من بني سامة بن لؤي بن غالب، 
ms665	 عداده في أهل البصرة، يروي عن: ابن عباس، وأبي سعيد، روى عنه: بكر بن عبد الله المزني، مات أبو المتوكل سنة ثمان ومائة.(@)(@@)(@@)(@@) ||| AUTO علي بن رباح اللخمي(@)(@@) من أهل مصر، كنيته أبو موسى، وهو الذي يقال له: علي، وكان علي يقول: من قال لي: علي فليس مني في حل، يروي عن: عمرو بن العاص، وعقبة بن عامر، روى عنه: ابنه موسى بن علي.(@)(@@)(@@)(@@) ||| AUTO علي بن سلمة القرشي(@)(@@) يروي عن: أبي هريرة، روى عنه: يحيى بن أبي كثير.(@)(@@)(@@)(@@) ||| AUTO علي بن الأقمر الوادعي الهمداني(@)(@@) من أهل الكوفة، يروي عن: أبي جحيفة، روى عنه: منصور، والثوري، وشعبة، وهو أخو كلثوم بن الأقمر.(@)(@@)(@@)(@@) ||| AUTO علي بن خالد الدؤلي(@)(@@) يروي عن: أبي هريرة، وأبي أمامة، روى عنه: الضحاك بن عثمان، وسعيد بن أبي أيوب، وبكير بن الأشج.(@)(@@)(@@)(@@) ||| AUTO علي بن سليم الحرار، كنيته أبو سليم(@)(@@) يروي عن: أنس بن مالك، روى عنه: مسعر، وأبو عوانة.(@)PageV01P002(@)(@@) [ج 2: ص 362](@)(@@)(@@)(@@) ||| AUTO علي بن سليك(@)(@@) يروي عن: علي بن أبي طالب، روى عنه: عثمان بن إبراهيم الحاطبي.(@)(@@)(@@)(@@) ||| AUTO علي بن خالد الأولي(@)(@@) شيخ، يروي عن: أبي أمامة، روى عنه: سعيد بن أبي أيوب، وبكير بن الأشج.(@)(@@)(@@)(@@) ||| AUTO علي بن شماخ السلمي(@)(@@) يروي عن: أبي هريرة، روى عنه: عقبة أبو الجلاس، وعثمان بن شماس.(@)(@@)(@@)(@@) ||| AUTO علي الأسدي(@)(@@) يروي عن: جابر بن عبد الله، روى عنه: سعيد بن أبي أيوب.(@)(@@)(@@)(@@) ||| AUTO علي بن عمارة(@)(@@) يروي عن: جابر بن سمرة، روى عنه: عمران بن رباح.(@)(@@)(@@)(@@) ||| AUTO علي بن علقمة الأنماري(@)(@@) يروي عن: علي بن أبي طالب، روى عنه: سالم بن أبي الجعد.(@)(@@)(@@)(@@) ||| AUTO علي بن الصلت(@)(@@) يروي عن: أبي أيوب الأنصاري، روى عنه: المسيب بن رافع.(@)(@@) (194) -[2: 362] ثنا أبو يعلى، قال: ثنا بشر بن الوليد، قال: ثنا شريك، عن الأعمش، عن المسيب بن رافع، عن علي بن الصلت، عن أبي أيوب الأنصاري، أنه رآه يصلي أربع ركعات، قال: فقلت: له إنك لتديم صلاتهن، فقال: رأيت رسول الله صلى الله عليه 
ms666	 وسلم يصليهن حين تزول الشمس، فقلت: يا نبي الله، إنك لتديم هذه الصلاة، فقال: " إنها ساعة تفتح فيها أبواب السماء، فأحب أن يرفع لي فيها عمل صالح "(@)(@@)(@@)(@@) ||| AUTO علي بن عبد الله، أبو حميدة(@)(@@) ولد في عهد علي، وفرض له علي، روى عنه: عبيدة بن أبي رائطة.(@)(@@)(@@)(@@) ||| AUTO علي بن عبد الله بن سعد بن عدي بن حارثة بن عمرو بن عامر بن ثعلبة بن امرئ القيس بن مازن بن الأزد البارقي PageV01P002 [ج 2: ص 363](@)(@@) وبارق جبل كان ينزله الأزد فنسب إليه، كنيته أبو عبد الله، من رهطه جماعة منهم محمد بن واسع، يروي عن: ابن عمر، روى عنه: قتادة، ويعلى بن عطاء،(@)(@@) (195) -[2: 363] ثنا الحسن بن سفيان، قال: ثنا أبو بكر بن أبي شيبة، قال: ثنا عبيدة بن حميد، عن منصور، عن مجاهد، قال: " كان علي الأزدي يختم القرآن في رمضان كل ليلة "(@)(@@)(@@)(@@) ||| AUTO علي بن قيس العبدي(@)(@@) من أهل الكوفة، يروي عن: ابن الزبير، روى عنه: أخوه الأسود بن قيس.(@)(@@)(@@)(@@) ||| AUTO علي بن أبي أمية(@)(@@) يروي عن: أبي قرصافة، روى عنه: الطيب بن زبان.(@)(@@)(@@)(@@) ||| AUTO علي بن كردوس الحنفي، كنيته أبو كردوس(@)(@@) من أهل اليمامة، يروي عن: ابن عمر، روى عنه: عكرمة بن عمار.(@)(@@)(@@)(@@) ||| AUTO علي بن يزيد بن ركانة(@)(@@) يروي عن: جده، وله صحبة فيما يقال، روى عنه: ابنه عبد الله بن علي.(@)(@@)(@@)(@@) ||| AUTO علي بن أبي كثير(@)(@@) عن: أبي مسعود الأنصاري، روى عنه: إسماعيل بن سميع.(@)(@@)(@@)(@@) ||| AUTO علي بن مدرك النخعي الكوفي، وكنيته أبو مدرك(@)(@@) سمع أبا مسعود صاحب رسول الله صلى الله عليه وسلم روى عنه: شعبة بن الحجاج، مات سنة عشرين ومائة.(@)PageV01P002(@)(@@) [ج 2: ص 364](@)(@@)(@@)(@@) ||| AUTO علي بن عبد الرحمن(@)(@@) مولى ربيعة بن الحارث، يروي عن: حذيفة بن اليمان، روى عنه: حكيم بن حكيم.(@)(@@)(@@)(@@) ||| AUTO أبو ماجدة اسمه علي بن ماجدة السهمي(@)(@@) يروي عن: عمر، روى عنه: العلاء بن عبد الرحمن.(@)(@@)(@@)(@@) ||| AUTO علي بن عبد الرحمن المعاوي الأنصاري(@)(@@) من أهل المدينة، يروي عن: ابن عمر، روى عنه: 
ms667	 مسلم بن أبي مريم.(@)(@@)(@@)(@@) ||| AUTO علي بن عبيد الساعدي(@)(@@) يروي عن: أبي أسيد الساعدي، روى عنه: ابنه أسيد بن علي.(@)(@@)(@@)(@@) ||| AUTO علي بن مسلم(@)(@@) يروي عن: ابن عمر، روى عنه: كثير أبو إسماعيل.(@)(@@)(@@)(@@) ||| AUTO عمرو بن ميمون الأودي(@)(@@) من أود، كنيته أبو عبد الله، أدرك الجاهلية، دخل مكة خمسا وخمسين مرة بين حج وعمرة، سكن الشام ثم انتقل إلى الكوفة، يروي عن: ابن مسعود، ومعاذ بن جبل، روى عنه: أبو إسحاق السبيعي، وأهل الكوفة، مات سنة أربع أو خمس وسبعين.(@)(@@)(@@)(@@) ||| AUTO عمرو بن بشر الضبي(@)(@@) كان على قضاء البصرة بعد كعب بن سور، روى عنه: أهل البصرة.(@)(@@)(@@)(@@) ||| AUTO عمرو بن دينار المكي الأثرم(@)(@@) مولى ابن باذان من مذحج، PageV01P002 [ج 2: ص 365] وكان باذان عامل كسرى على اليمن، كنيته أبو محمد، يروي عن: ابن عباس، وابن عمر، وابن الزبير، وجابر، روى عنه: أيوب، وابن جريج، والثوري، والناس، مات سنة ست وعشرين ومائة، وقد جاوز السبعين وكان مولده سنة ست وأربعين.(@)(@@)(@@)(@@) ||| AUTO عمرو بن سليم بن عمرو بن خلدة بن عامر بن مخلد بن عامر بن زريق الزرقي الأنصاري، وهو الذي يقال له: ابن خلدة(@)(@@) يروي عن: أبي قتادة، عداده في أهل المدينة، روى عنه: عامر بن عبد الله بن الزبير، وسعيد المقبري، وقيل: إنه راهق الحلم يوم قتل عمر بن الخطاب.(@)(@@)(@@)(@@) ||| AUTO عمرو بن شرحبيل، أبو ميسرة الهمداني(@)(@@) من أهل الكوفة، من العباد، كان ركبته كركبة البعير من كثرة الصلاة، يروي عن: عمرو بن مسعود، روى عنه: أبو إسحاق السبيعي، مات في الطاعون قبل أبي جحيفة سنة ثلاث وستين، وقد قيل: إن اسم أبي ميسرة عمرو بن شراحيل، وهذا ليس بصحيح والصحيح شرحبيل.(@)(@@)(@@)(@@) ||| AUTO عمرو بن عثمان بن عفان الأموي القرشي(@)(@@) من أهل المدينة، يروي عن: أبيه وأسامة بن زيد، روى الزهري، عن علي بن حسين عنه، وأم عمرو، وأبان، وخالد، وعمر بنو عثمان بن عفان: أسماء بنت عمرو بن حممة الدوسية، وقد قيل: إن أم عمرو بن عثمان أم النجوم بنت 
ms668	 جندب بن عمرو.(@)(@@)(@@)(@@) ||| AUTO عمرو بن عطية التيمي بن النمر بن قاسط(@)(@@) عداده في أهل الكوفة، يروي عن: عمر، وسلمان، روى عنه: ربعي بن خراش، وعاصم الأحول، وحماد بن أبي سليمان.(@)PageV01P002(@)(@@) [ج 2: ص 366](@)(@@)(@@)(@@) ||| AUTO عمرو بن سعد بن عبادة الخزرجي(@)(@@) يروي عن: أبيه، روى عنه: ابنه سعيد بن عمرو، وكان كنيته أبو عباد.(@)(@@)(@@)(@@) ||| AUTO عمرو بن أبان بن عثمان(@)(@@) يروي عن: جابر بن عبد الله، روى عنه: الزهري.(@)(@@)(@@)(@@) ||| AUTO أبو الأعور السلمي اسمه عمرو بن سفيان بن عبد شمس بن سعد بن قائف بن الأوقص بن مرة بن هلال بن فالج بن ذكوان(@)(@@) سمع جماعة من الصحابة، وكان ممن شهد صفين، وبئست الصفين لأهل الشام كانت، وقد قيل: إن لأبي الأعور صحبة.(@)(@@)(@@)(@@) ||| AUTO عمرو بن عبد الله بن قيس أبو بكر بن أبي موسى الأشعري(@)(@@) يروي عن: أبيه، عداده في أهل الكوفة، روى عنه: عطاء بن السائب.(@)(@@)(@@)(@@) ||| AUTO عمرو بن وهب الثقفي(@)(@@) يروي عن: المغيرة بن شعبة، روى عنه: محمد ابن سيرين.(@)(@@)(@@)(@@) ||| AUTO ابن أكيمة الخولاني(@)(@@) يروي عن: أبي هريرة، اسمه عمرو بن مسلم بن عمارة بن أكيمة، روى عنه: الزهري، وأخوه عمرو بن مسلم بن عمارة، يروي عن: سعيد بن المسيب، وسعيد بن أبي هلال، ومحمد بن عمرو بن علقمة، روى عنه: مالك، وقال: عمرو بن مسلم وإنما هو عمر بن مسلم، لا عمرو لأن مالكا لم يدرك عمرا.(@)(@@)(@@)(@@) ||| AUTO عمرو بن عاصم بن سفيان بن عبد الله الثقفي(@)(@@) أخو بشر بن عاصم، يروي عن: أبي هريرة، روى عنه: يعلى بن عطاء، وابن أبي حسين.(@)PageV01P002(@)(@@) [ج 2: ص 367](@)(@@)(@@)(@@) ||| AUTO عمرو بن النعمان بن مقرن المزني(@)(@@) يروي عن: جماعة من أصحاب رسول الله صلى الله عليه وسلم عداده في أهل البصرة، وكان من قرائهم، روى عنه: معاوية بن قرة.(@)(@@) (196) -[2: 367] ثنا الحسن بن سفيان، قال: ثنا أبو بكر بن أبي شيبة، قال: ثنا محمد بن بشر، قال: ثنا عبد الله بن الوليد، قال: ثنا يحيى، عن أيوب، قال: ثنا معاوية بن قرة، 
ms669	 قال: كنت نازلا على عمرو بن النعمان بن مقرن فلما حضر رمضان جاء رجل بألفي درهم من قبل مصعب بن الزبير، فقال: إن الأمير يقرئك السلام ويقول: إنا لم ندع قارئا شريفا إلا وقد وصل إليه منا معروف، فاستعن بهذين على بقية شهرك، فقال عمرو: " اقرأ على الأمير السلام، وقل: والله ما قرأنا القرآن نريد به الدنيا، وردها عليه "(@)(@@)(@@)(@@) ||| AUTO عمرو بن أبي جندب الهمداني، ويقال: عمر بن جندب أبو عطية الوادعي(@)(@@) وقد قيل: اسمه مالك بن أبي جندب، يروي عن: جماعة من أصحاب رسول الله صلى الله عليه وسلم روى عنه: علي بن الأقمر، وأبو إسحاق، مات في ولاية مصعب بن الزبير على العراق.(@)(@@)(@@)(@@) ||| AUTO عمرو بن الأسود العنسي، كنيته أبو عياض، وقد قيل: أبو عبد الرحمن(@)(@@) من عباد أهل الشام وزهادهم، وكان يقسم على الله فيبره، يروي عن: عمرو، ومعاوية، روى عنه: خالد بن معدان، والشاميون، وكان إذا خرج من بيته وضع يمينه على شماله مخافة الخيلاء.(@)(@@)(@@)(@@) ||| AUTO عمرو بن بعجة اليشكري البارقي(@)(@@) وبارق جبل ينزله الأزد، يروي عن: علي، روى عنه: أبو إسحاق السبيعي.(@)(@@)(@@)(@@) ||| AUTO عمرو بن وابصة بن معبد(@)(@@) يروي عن: أبيه، روى عنه: أهل الجزيرة، أمه الشعثاء بنت عمرو بن بشر ذي الرمحين بن قيس.(@)PageV01P002(@)(@@) [ج 2: ص 368](@)(@@)(@@)(@@) ||| AUTO عمرو بن الحارث(@)(@@) من أصحاب معاذ بن جبل، يروي عن: معاذ، روى عنه: الزهري، وعيسى بن حصين.(@)(@@)(@@)(@@) ||| AUTO عمرو بن بجدان العامري(@)(@@) يروي عن: أبي ذر، وأبي زيد الأنصاري، عداده في أهل البصرة، روى عنه: أبو قلابة.(@)(@@)(@@)(@@) ||| AUTO عمرو بن سفيان(@)(@@) يروي عن: ابن عباس، روى عنه: الأسود بن قيس.(@)(@@)(@@)(@@) ||| AUTO عمرو بن تميم(@)(@@) يروي عن: ابن الزبير، عداده في أهل مكة، روى عنه: عثمان بن الأسود.(@)(@@)(@@)(@@) ||| AUTO عمرو بن سلمة بن الحارث الهمداني(@)(@@) من أهل الكوفة، يروي عن: علي، وابن مسعود، روى عنه: أهل الكوفة، مات سنة خمس وثمانين، ودفن مع عمرو بن حريث في يوم واحد، وهو أخو عبد الله بن سلمة سمعا جميعا، عن 
ms670	 علي.(@)(@@)(@@)(@@) ||| AUTO عمرو بن ثابت العتواري الليثي(@)(@@) يروي عن: ابن عمر، وأبي سعيد الخدري، روى عنه: ابناه محمد بن عمرو، ونافع بن عمرو.(@)(@@)(@@)(@@) ||| AUTO عمرو بن عبد الرحمن بن سابط الجمحي المكي(@)(@@) يروي عن: ابن عباس إن كان سمع منه، روى عنه: خالد بن يزيد.(@)(@@)(@@)(@@) ||| AUTO عمرو بن طلحة(@)(@@) يروي عن: أمه حمنة بنت جحش حديث الاستحاضة، روى عنه: إبراهيم بن محمد بن طلحة، وأحسبه وهما، إنما هو عمران بن طلحة.(@)PageV01P002(@)(@@) [ج 2: ص 369](@)(@@)(@@)(@@) ||| AUTO عمرو بن حبشي الزبيدي(@)(@@) يروي عن: ابن عباس، وابن عمر، روى عنه: عبد الله بن مقدام، وهو الذي يقال له: عمرو بن حريش.(@)(@@)(@@)(@@) ||| AUTO عمرو بن حسان(@)(@@) شيخ، يروي عن: أنس بن مالك، روى عنه: يحيى بن سعيد الأنصاري.(@)(@@)(@@)(@@) ||| AUTO عمرو بن حنظلة(@)(@@) يروي عن: حذيفة، روى عنه: أبو قيس الأودي.(@)(@@)(@@)(@@) ||| AUTO عمرو بن أوس بن حذيفة(@)(@@) يروي عن: أبيه، والمغيرة بن شعبة، روى عنه: عثمان بن عبد الله بن أوس.(@)(@@)(@@)(@@) ||| AUTO عمرو بن عتبة بن فرقد السلمي(@)(@@) من العباد، يروي عن: جماعة من الصحابة، روى عنه: أهل العراق، قتل بتستر في خلافة عثمان، وكان يرعى ركائب الصحابة وسحابة تظله، وربما بات وإلى جنبه سبع يحميه.(@)(@@)(@@)(@@) ||| AUTO عمرو بن الخطاب السدوسي(@)(@@) يروي عن: ابن عمر، وعائشة، وابن عباس، روى عنه: ابن سيرين، ويحيى بن أبي كثير.(@)(@@)(@@)(@@) ||| AUTO عمرو بن علقمة بن وقاص الليثي(@)(@@) والد محمد بن عمرو، يروي عن: بلال بن الحارث المزني، روى عنه: ابنه محمد بن عمرو.(@)(@@)(@@)(@@) ||| AUTO عمرو بن زنيب(@)(@@) يروي عن: أنس بن مالك، روى عنه:(@)PageV01P002(@)(@@) [ج 2: ص 370] الحجاج بن الحجاج الأسلمي، وهو الذي يروي عنه: يحيى بن أبي كثير، ويقول: عمرو بن بلال الغبري.(@)(@@)(@@)(@@) ||| AUTO عمرو بن أبي خبيب(@)(@@) يروي عن: عوف بن مالك الأشجعي، روى عنه: برد بن أبي زياد، أخو يزيد بن أبي زياد.(@)(@@)(@@)(@@) ||| AUTO عمرو بن زرارة(@)(@@) يروي عن: ابن مسعود، روى عنه: أبو إسحاق السبيعي.(@)(@@)(@@)(@@) ||| AUTO عمرو بن سليم الحضرمي(@)(@@) يروي عن: ابن عمر، ورجاء بن حيوة، 
ms671	 عداده في أهل مصر، روى عنه: أهلها.(@)(@@)(@@)(@@) ||| AUTO عمرو بن أبي مغيث(@)(@@) يروي عن: عمر بن الخطاب، روى عنه: محمد بن أبي يحيى.(@)(@@)(@@)(@@) ||| AUTO عمرو بن راشد الأشجعي(@)(@@) مولى أشجع، كنيته أبو راشد، يروي عن: عمر، وعلي، ووابصة بن معبد، عداده في أهل الكوفة، روى عنه: هلال بن يساف، ونصير بن دعلوق أبو طعمة.(@)(@@)(@@)(@@) ||| AUTO عمرو بن عبيد الأنصاري(@)(@@) وليس بالبصري، والد محمد بن عمرو الأنصاري، يروي عن: أنس بن مالك، روى عنه: ابنه محمد بن عمرو، وكان من ساكني الأهواز.(@)(@@)(@@)(@@) ||| AUTO عمرو بن زياد اليحصبي(@)(@@) يروي عن: رجل من أصحاب النبي صلى الله عليه وسلم عداده في أهل مصر، روى عنه: أهلها، وكنيته أبو فراس.(@)(@@)(@@)(@@) ||| AUTO عمرو بن أوس الثقفي(@)(@@) يروي عن: عبد الله بن عمرو، روى عنه: عمرو بن دينار، وهو الذي روى عن: عنبسة بن أبي سفيان، عن أم حبيبة.(@)(@@)(@@)(@@) ||| AUTO أبو قرة اسمه عمرو بن سلمة القاضي(@)(@@) يروي عن: جماعة من الصحابة، روى عنه: أهل الكوفة.(@)PageV01P002(@)(@@) [ج 2: ص 371](@)(@@)(@@)(@@) ||| AUTO عمرو بن رافع المدني(@)(@@) مولى عمر بن الخطاب، يروي عن: حفصة بنت عمر، روى عنه: أبو سلمة بن عبد الرحمن، وزيد بن أسلم.(@)(@@)(@@)(@@) ||| AUTO عمرو بن عبيد الله الأنصاري(@)(@@) من بني الحارث بن الخزرج، من أهل المدينة، يروي عن: ابن عباس، روى عنه: مالك بن أنس، وسليمان بن بلال.(@)(@@)(@@)(@@) ||| AUTO عمرو بن سفيان بن عبد الله بن ربيعة الثقفي(@)(@@) أخو عاصم، وعبد الله، يروي عن: أبيه، وله صحبة، عداده في أهل الحجاز، روى عنه: أهلها، وعمرو بن شعيب.(@)(@@)(@@)(@@) ||| AUTO عمرو بن شداد الليثي(@)(@@) يروي عن: المسور بن مخرمة، روى عنه: وهب بن كيسان.(@)(@@)(@@)(@@) ||| AUTO عمرو بن أبي عبيد(@)(@@) والى أهل المدينة، يروي عن: أبي هريرة، روى عنه: يحيى بن سعيد الأنصاري، وابن أبي ذئب.(@)(@@)(@@)(@@) ||| AUTO عمرو بن عبد الله بن أبي طلحة(@)(@@) يروي عن: أنس بن مالك، وابن الزبير، روى عنه: محمد بن إسحاق، وجرير بن زيد قصة الغرض.(@)(@@)(@@)(@@) ||| AUTO عمرو بن الحارث بن المصطلق(@)(@@) يروي.(@)(@@) (197) -[2: 371] عن 
ms672	 ابن مسعود: " ما صمت مع رسول الله صلى الله عليه وسلم تسعة وعشرين، أكثر مما صمت معه ثلاثين ". رواه ابن المبارك، عن عيسى بن دينار، عن أبيه، وقال: سمعت عمرو بن الحارث بن المصطلق(@)(@@)(@@)(@@) ||| AUTO أبو إسحاق السبيعي اسمه عمرو بن عبد الله الهمداني PageV01P002 [ج 2: ص 372] وسبيع بطن من همدان، مولده سنة تسع وعشرين في خلافة عثمان، رأى عليا، وأسامة بن زيد، وابن عباس، والبراء بن عازب، وزيد بن أرقم، وأبا جحيفة، وابن أبي أوفى، روى عنه: الأعمش، ومنصور، والثوري، والناس، مات سنة سبع وعشرين ومائة يوم ظفر الضحاك بن قيس بالكوفة، وكان مدلسا، كان الشعبي أكبر منه بسنة أو سنتين، ويقال: كان مولده سنة اثنتين وثلاثين.(@)(@@)(@@)(@@) ||| AUTO عمرو بن عبد الله بن صفوان بن أمية بن خلف القرشي الجمحي(@)(@@) أخو صفوان بن عبد الله بن صفوان بن أمية بن خلف، يروي عن: أبيه، وجماعة من أصحاب النبي صلى الله عليه وسلم عداده في أهل مكة، روى عنه: عمرو بن دينار.(@)(@@)(@@)(@@) ||| AUTO عمرو بن عبد الرحمن(@)(@@) ابن أخي يعلى بن أمية، يروي عن: عمه يعلى بن منية، روى عنه: الزهري.(@)(@@)(@@)(@@) ||| AUTO عمرو بن رافع(@)(@@) مولى عمر بن الخطاب، يروي عن: حفصة بنت عمرو، روى عنه: نافع مولى ابن عمر، وأبو جعفر محمد بن علي.(@)(@@)(@@)(@@) ||| AUTO عمرو أبو الأسود الديلي، اسمه عمرو بن سفيان، وقد قيل: عمرو بن ظالم(@)(@@) ويقال: ظالم بن عمرو، يروي عن: علي، وأبي موسى، وأبي ذر، وعمران بن حصين، ويقال: إنه أول من تكلم في النحو، روى عنه: الناس، وكانت أمه من بني عبد الدار بن قصي.(@)(@@)(@@)(@@) ||| AUTO عمرو بن سعيد بن العاص(@)(@@) يروي عن: عثمان بن عفان، روى عنه: ابنه سعيد بن عمرو.(@)(@@)(@@)(@@) ||| AUTO عمرو بن سعيد الجاري(@)(@@) مولى عمر بن الخطاب، يروي عن: ابن عمر، وأبي PageV01P002 [ج 2: ص 373] هريرة، وعبد الله بن عمرو، روى عنه: زيد بن أسلم، وعبد الملك بن أعين.(@)(@@)(@@)(@@) ||| AUTO أبو أسماء الرحبي اسمه عمرو بن مرثد، وقد قيل: عمرو بن أسماء 
ms673	(@)(@@) يروي عن: ثوبان وشداد بن أوس، روى عنه: أبو قلابة.(@)(@@)(@@)(@@) ||| AUTO عمرو بن عبيد العبشمي(@)(@@) من أهل الشام، يروي عن: ثوبان، روى عنه: أبو الأشهب.(@)(@@)(@@)(@@) ||| AUTO أبو عبد الجبار اسمه عمرو بن عبد الله الحضرمي(@)(@@) يروي عن: أبي هريرة، روى عنه: يحيى بن أبي عمرو السيباني.(@)(@@)(@@)(@@) ||| AUTO عمرو بن خالد بن عرفطة(@)(@@) يروي عن: أبيه، وله صحبة، روى عنه: ابنه كلاب بن عمرو.(@)(@@)(@@)(@@) ||| AUTO عمرو بن أبي الوليد(@)(@@) عن: عمر بن الخطاب، روى عنه: يزيد بن أبي حبيب.(@)(@@)(@@)(@@) ||| AUTO عمرو بن حريث المدني المخزومي(@)(@@) يروي عن: ابن عباس، وأبي هريرة، روى عنه: سعيد بن أبي سعيد المقبري، وأهل مصر.(@)(@@)(@@)(@@) ||| AUTO عمرو بن الشريد بن سويد الثقفي(@)(@@) يروي عن: ابن عباس، وأبيه، روى عنه: إبراهيم بن ميسرة.(@)(@@)(@@)(@@) ||| AUTO عمرو بن أبي سفيان الجمحي(@)(@@) يروي عن: ابن الزبير " أنه أتى بسارق فقطع يده ". روى عنه: سفيان الثوري.(@)PageV01P002(@)(@@) [ج 2: ص 374](@)(@@)(@@)(@@) ||| AUTO عمرو بن غالب الهمداني(@)(@@) من أهل الكوفة، يروي عن: عائشة، روى عنه: أبو إسحاق السبيعي.(@)(@@)(@@)(@@) ||| AUTO عمرو بن أبي سفيان بن أسيد بن جارية الثقفي(@)(@@) حليف بني زهرة، يروي عن: أبي هريرة، وأبي موسى، روى عنه: الزهري، والحجاج بن فرافصة، عداده في أهل المدينة.(@)(@@)(@@)(@@) ||| AUTO عمرو بن قيس الكندي الحمصي، كنيته أبو ثور، وهو الذي يقال له: عمرو بن قيس السكوني(@)(@@) يروي عن: عبد الله بن عمر، روى عنه: الأوزاعي، وأهل الشام، مات سنة أربعين ومائة، وهو ابن مائة سنة، وكان مولده سنة أربعين سنة الجماعة.(@)(@@)(@@)(@@) ||| AUTO أبو حية الوادعي عمرو بن عبد الله الأصم الهمداني الكوفي(@)(@@) يروي عن: ابن مسعود، روى عنه: أبو إسحاق السبيعي، وأهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO عمرو بن عبد الله بن ذؤيب المليكي(@)(@@) من أهل الشام، يروي عن: أبي الدرداء، روى عنه: صفوان بن عمرو.(@)(@@)(@@)(@@) ||| AUTO عمرو بن مرداس(@)(@@) يروي عن: بلال، روى عنه: أبو الورد بن ثمامة.(@)(@@)(@@)(@@) ||| AUTO عمرو بن صليع البصري(@)(@@) يروي عن: حذيفة بن اليمان، روى عنه: صخر بن الوليد.(@)PageV01P002(@)(@@) [ج 2: ص 375](@)(@@)(@@)(@@) ||| AUTO عمرو بن عبد 
ms674	 الملك بن حريث المخزومي(@)(@@) يروي عن: عمه عمرو بن حريث، روى عنه: حصين بن عبد الرحمن.(@)(@@)(@@)(@@) ||| AUTO عمرو بن أبي قرة الكندي(@)(@@) يروي عن: عمر، وحذيفة، روى عنه: الشيباني.(@)(@@)(@@)(@@) ||| AUTO عمرو بن عبد الملك الأسدي(@)(@@) " إن عمر لما افتتح السواد بعث عثمان بن حنيف، فمسح ما دون دجلة ووضع على كل جريب من الأرض يبلغه الماء عامرا كان أو غامرا درهما وقفيزا ". روى عنه: عبد الله بن الوليد المزني.(@)(@@)(@@)(@@) ||| AUTO عمرو بن سعيد بصري(@)(@@) يروي عن: أنس بن مالك، روى عنه: أيوب السختياني.(@)(@@)(@@)(@@) ||| AUTO عمرو بن معاذ بن سعد بن معاذ الأشهلي الأنصاري(@)(@@) من أهل المدينة، يروي عن: جدته ولها صحبة، روى عنه: زيد بن أسلم.(@)(@@)(@@)(@@) ||| AUTO عمرو بن ماتع المعافري(@)(@@) يروي عن: عبد الله بن عمرو، عداده في أهل مصر، روى عنه: خالد بن يزيد، وعبد الله بن سليمان.(@)(@@)(@@)(@@) ||| AUTO عمرو بن عامر الأنصاري(@)(@@) يروي عن: أنس بن مالك، روى عنه: الثوري، وشعبة.(@)(@@)(@@)(@@) ||| AUTO عمرو بن مالك الجنبي، أبو علي الهمداني(@)(@@) من أهل مصر، يروي عن: عقبة بن عامر، وفضالة بن عبيد، روى عنه: حميد بن هانئ، وأهل مصر.(@)PageV01P002(@)(@@) [ج 2: ص 376](@)(@@)(@@)(@@) ||| AUTO عمرو بن مرة الجملي المرادي(@)(@@) من أهل الكوفة، كنيته أبو عبد الرحمن، ويقال: أبو عبد الله، يروي عن: ابن أبي أوفى، روى عنه: الأعمش، ومنصور، مات سنة ست عشرة ومائة، وكان مرجئا.(@)(@@)(@@)(@@) ||| AUTO عمرو بن سفيان(@)(@@) يروي عن: علي، روى عنه: سعيد بن عمرو بن سفيان.(@)(@@)(@@)(@@) ||| AUTO عمرو بن كيسان(@)(@@) يروي عن ابن عباس: " يا أهل مكة لا يغرنكم أن لا تعتمروا ". روى عنه: عمرو بن دينار.(@)(@@)(@@)(@@) ||| AUTO عمرو بن مساحق(@)(@@) يروي عن: عمر بن الخطاب، روى عنه: النضر بن عبد الله.(@)(@@)(@@)(@@) ||| AUTO عمرو بن الوليد بن عبدة(@)(@@) يروي عن: عبد الله بن عمرو، روى عنه: يزيد بن أبي حبيب.(@)(@@)(@@)(@@) ||| AUTO عمرو بن عبد الله، أبو سعيد،(@)(@@) شيخ، يروي عن: جابر بن عبد الله، روى عنه: سعيد بن أبي هلال.(@)(@@)(@@)(@@) ||| AUTO عمرو بن أبي يوسف(@)(@@) أحد بني 
ms675	 نوفل، يروي عن: معاوية بن أبي سفيان، روى عنه: ابن صيفى، أبو صيفى.(@)(@@)(@@)(@@) ||| AUTO عمرو بن أبي عمرو(@)(@@) مولى المطلب بن عبد الله بن حنطب PageV01P002 [ج 2: ص 377] المخزومي، من أهل الحجاز، واسم أبي عمرو ميسرة، يروي عن: أنس بن مالك، روى عنه: مالك، وابن الهاد، والناس، مات في ولاية أبي جعفر، ربما أخطأ، يعتبر حديثه من رواية الثقات عنه.(@)(@@)(@@)(@@) ||| AUTO عامر بن شراحيل بن عبد الشعبي من شعب همدان(@)(@@)(@@)(@@) ||| AUTO من أهل الكوفة، كنيته أبو عمرو، وكان أكبر من أبي إسحاق السبيعي بسنتين، روى عنه: الناس، وكان فقيها شاعرا، مولده سنة عشرين، وقد قيل: سنة إحدى وعشرين، ومات سنة تسع ومائة، وقد قيل: سنة خمس ومائة، ويقال: أربع ومائة على دعابة فيه وقد نيف على الثمانين، وكانت أمه من سبى جلولاء، روى عن: خمسين ومائة من أصحاب رسول الله صلى الله عليه وسلم(@)(@@) عامر بن سعد بن أبي وقاص الزهري القرشي،(@)(@@)(@@)(@@) ||| AUTO أخو مصعب، ومحمد، ويحيى، وعمر، وإبراهيم، وعائشة، أولاد سعد، يروي عن: عثمان بن عفان، وأبيه، روى عنه: الزهري، مات سنة أربع ومائة، أمه أم ولد.(@)(@@) عامر بن عبد الله بن الزبير بن العوام القرشي،(@)(@@)(@@)(@@) ||| AUTO من أهل المدينة، كنيته أبو الحارث، كان عالما فاضلا، يروي عن: أبيه، روى عنه: زياد بن سعد، ومالك، مات سنة إحدى وعشرين ومائة، أمه حنتمة بنت عبد الرحمن بن الحارث بن هشام بن المغيرة.(@)(@@) عامر بن عبد الله بن عبد قيس التميمي العنبري، كنيته أبو عبد الله،(@)(@@) من عباد أهل البصرة وزهادهم، كثرت الأخبار عنه في الصلاح يعنى عن الاشتغال بذكرها، وهو من(@)PageV01P002(@)(@@)(@@)(@@) ||| AUTO [ج 2: ص 378] الزهاد الثمانية، رأى جماعة من أصحاب رسول الله صلى الله عليه وسلم روى عنه: الحسن، وابن سيرين، وأهل البصرة، لست أحفظ له خبرا مسندا حدث به.(@)(@@) عامر بن أبي أمية المخزومي القرشي،(@)(@@)(@@)(@@) ||| AUTO أخو أم سلمة، يروي عن: أم سلمة، روى عنه: سعيد بن المسيب.(@)(@@) أبو بردة بن أبي موسى، اسمه عامر بن عبد الله بن قيس 
ms676	(@)(@@) يروي عن: علي، وأبيه، وابن عمر، روى عنه: الناس، وكان على قضاء الكوفة، مات سنة أربع ومائة وقد نيف على الثمانين، وقد قيل: إن اسم أبي بردة الحارث، والصحيح عامر.(@)(@@)(@@)(@@) ||| AUTO عامر بن النباح(@)(@@) مؤذن علي، يروي عن: علي بن أبي طالب، روى عنه: الكوفيون.(@)(@@)(@@)(@@) ||| AUTO عامر بن عبد الرحمن اليحصبي(@)(@@) يروي عن: ابن عباس، عداده في أهل مصر، روى عنه: خالد بن سليمان.(@)(@@)(@@)(@@) ||| AUTO عامر بن عبد الله بن لحي، أبو اليمان الهوزني(@)(@@) من أهل الشام، يروي عن: سلمان، وصفوان بن أمية، روى عنه: أبو عبد الرحمن الحبلي، والشاميون، وأبوه أبو عامر الهوزني، اسمه عبد الله بن لحى، قد ذكرناه فيما قبل.(@)(@@)(@@)(@@) ||| AUTO عامر بن سعد البجلي(@)(@@) من أهل الكوفة، يروي عن: جرير بن عبد الله البجلي، روى عنه: أبو إسحاق السبيعي.(@)(@@)(@@)(@@) ||| AUTO أبو العشراء الدارمي، اسمه عامر بن أسامة بن مالك بن قهطم PageV01P002 [ج 2: ص 379] يروي عن أبيه، وله صحبة، روى عنه: حماد بن سلمة، وكان نزل الجفرة على طريق البصرة.(@)(@@)(@@)(@@) ||| AUTO عامر بن عبدة، أبو إياس البجلي(@)(@@) من أهل الكوفة، يروي عن: ابن مسعود، روى عنه: المسيب بن رافع.(@)(@@)(@@)(@@) ||| AUTO عامر بن مسعود(@)(@@) يروي المراسيل، روى عنه: عبد العزيز بن رفيع، ونمير بن غريب الهمداني، ومن زعم أن له صحبة بلا دلالة فقد وهم.(@)(@@)(@@)(@@) ||| AUTO أبو المليح اسمه عامر بن أسامة بن عمير الهذلي(@)(@@) من أهل البصرة، يروي عن: أبيه، وبريدة، وعوف بن مالك، روى عنه: أبو قلابة، وقتادة، وكان عامل الحجاج على الأبلة، مات سنة ثمان وتسعين، ومن زعم أن اسمه زياد، أو زيد بن أسامة فقد وهم، ومنهم من زعم أنه مات سنة ثمان ومائة، وقد قيل: إنه مات سنة ثنتي عشرة ومائة.(@)(@@)(@@)(@@) ||| AUTO عامر بن أبي عامر الأشعري(@)(@@) يروي عن: أبيه، ومعاوية، روى عنه: مالك بن مسروح.(@)(@@)(@@)(@@) ||| AUTO عامر بن مطر الشيباني(@)(@@) يروي عن: ابن مسعود، روى عنه: الشعبي، وجبلة بن سحيم.(@)(@@)(@@)(@@) ||| AUTO عامر بن زيد البكالي(@)(@@) يروي عن: عتبة بن عبد، روى عنه: 
ms677	 أبو سلام ويحيى بن أبي كثير، عداده في أهل الشام.(@)(@@)(@@)(@@) ||| AUTO عامر بن جشيب(@)(@@) من أهل الشام، يروي عن: أبي أمامة، روى عنه: أهلها.(@)(@@)(@@)(@@) ||| AUTO عامر بن مالك(@)(@@) يروي عن: صفوان بن أمية، روى عنه: أبو عثمان النهدي.(@)(@@)(@@)(@@) ||| AUTO عامر بن ذؤيب العجلي(@)(@@) يروي عن: ابن عباس، روى عنه: حصين بن عبد الرحمن.(@)PageV01P002(@)(@@) [ج 2: ص 380](@)(@@)(@@)(@@) ||| AUTO عامر بن عبيدة الباهلي(@)(@@) قاضي البصرة، يروي عن: أنس، روى عنه: شعبة بن الحجاج.(@)(@@)(@@)(@@) ||| AUTO عامر بن لدين الأشعري(@)(@@) يروي عن: أبي هريرة، عداده في أهل الشام، روى عنه: أهلها، وأبو بشر.(@)(@@)(@@)(@@) ||| AUTO عامر بن مصعب(@)(@@) يروي عن: عائشة، لم أعلم له راويا إلا إبراهيم بن المهاجر، وربما قال مصعب بن عامر: لا يعجبني الاعتبار بحديث إبراهيم بن المهاجر.(@)(@@)(@@)(@@) ||| AUTO عامر بن رزيق(@)(@@) مولى ابن عامر، يروي عن: أنس بن مالك، روى عنه: القاسم.(@)(@@)(@@)(@@) ||| AUTO عامر بن طهفة السهمي(@)(@@) شيخ، يروي عن: أبي الطفيل، روى عنه: شيخ يقال له: الربيع حكاية.(@)(@@)(@@)(@@) ||| AUTO عامر بن عبد الواحد الأحول(@)(@@) شيخ، يروي عن: عائذ بن عمرو، روى عنه: أبو الأشهب.(@)(@@)(@@)(@@) ||| AUTO عامر بن عمرو(@)(@@) يروي عن: أبي هريرة، عداده في أهل الحجاز، روى عنه: هدبة بن الحكم.(@)(@@)(@@)(@@) ||| AUTO عامر بن خارجة بن سعد(@)(@@) يروي عن: جده، عن النبي صلى الله عليه وسلم حديثا منكرا في المطر، روى عنه: حفص بن النضر السلمي، لا يعجبني ذكره.(@)(@@)(@@)(@@) ||| AUTO عروة بن الزبير بن العوام القرشي(@)(@@) من أهل المدينة، كنيته أبو عبد الله، أخو عبد الله بن الزبير، أمهما أسماء بنت أبي بكر الصديق، يروي عن: عائشة، وأبيه، وعبد الله بن عمرو، روى عنه: الزهري، وكان من أفاضل أهل المدينة، وعلمائهم، ويقرأ PageV01P002 [ج 2: ص 381] كل يوم ربع القرآن في المصحف نظرا ويقوم به ليلة، ما ترك نصيبه من الليل ولا ليلة قطعت رجله، وذلك أن الأكلة وقعت فيها فنشرها فما زاد على أن قال: الحمد لله، وكان إذا أيام الرطب ثلم حائطه، وأذن للناس أن يدخلوا، فيأكلوا ويحملوا، واختلف فمنهم من 
ms678	 قال: إنه مات سنة تسع وتسعين، ومنهم من قال: سنة إحدى ومائة، وقيل: سنة خمس وتسعين، وقيل: سنة مائة، وقيل: سنة أربع وتسعين.(@)(@@)(@@)(@@) ||| AUTO عروة بن المغيرة بن شعبة الثقفي، كنيته أبو يعفور(@)(@@) وكان من أفاضل أهل بيته، وكان عاملا لعلي على الكوفة، يروي عن: أبيه، روى عنه: الشعبي، والناس، وأولاد المغيرة: عروة، وعقار، وحمزة، ويعقوب، وقد حدثوا كلهم، وروى عنهم.(@)(@@)(@@)(@@) ||| AUTO عروة بن عامر القرشي(@)(@@) من بني عامر بن لؤي، يروي عن: ابن عباس وعبيد بن رفاعة، روى عنه: عمرو بن دينار وحبيب بن أبي ثابت، قال الثوري: عن حبيب، عن عروة القرشي، وقال الأعمش: عن حبيب، عن عروة الجهني.(@)(@@)(@@)(@@) ||| AUTO عروة بن النزال(@)(@@) يروي عن: معاذ بن جبل، روى عنه: الحكم بن عتيبة.(@)(@@)(@@)(@@) ||| AUTO عروة بن رويم اللخمي(@)(@@) من أهل الشام، يروي عن: أبي ثعلبة الخشني، روى عنه: الأوزاعي، وابن شبرمة، مات سنة خمس وعشرين ومائة، سكن في آخر عمره البصرة، كان يخرج بالليل إذا هدأت العيون، فينادي: يا أهل البصرة "ف أفأمن أهل القرى أن يأتيهم بأسنا بياتا وهم نائمونق الصلاة الصلاة ".(@)(@@)(@@)(@@) ||| AUTO عروة بن مسعود(@)(@@) يروي عن: ابن عمر، روى عنه: داود بن أبي عاصم.(@)PageV01P002(@)(@@) [ج 2: ص 382](@)(@@)(@@)(@@) ||| AUTO أبو فروة، اسمه عروة بن الحارث الجهني(@)(@@) يروي عن: عبد الله بن عكيم، ورجل من أصحاب النبي صلى الله عليه وسلم روى عنه: أهل الكوفة: سفيان بن عيينة، وغيره.(@)(@@)(@@)(@@) ||| AUTO عروة بن عياض(@)(@@) يروي عن: ابن عمر، وجابر، وأبي سعيد، روى عنه: ابن أبي مليكة، وعمرو بن دينار.(@)(@@)(@@)(@@) ||| AUTO عروة بن رويم اللخمي(@)(@@) من أهل الشام، يروي عن: أنس بن مالك، وعبد الله بن قرط، روى عنه: أهل الشام، مات سنة خمس وثلاثين ومائة بذي خشب، فحمل ودفن في المدينة، وكان يسكن قرية، يقال لها: سرية من كور غزة من بلاد فلسطين، وقد قيل: إنه مات سنة ثنتين وثلاثين ومائة.(@)(@@)(@@)(@@) ||| AUTO عطاء بن أبي رباح القرشي(@)(@@) مولى أبي خثيم الفهري، واسم أبي رباح أسلم، كنيته أبو محمد، مولده 
ms679	 بالجند من اليمن، ونشأ بمكة، وكان أسود أعور أشل، أعرج، ثم عمي في آخر عمره، وكان من سادات التابعين فقها وعلما وورعا وفضلا، لم يكن له فراش إلا المسجد الحرام إلى أن مات سنة أربع عشرة ومائة، وقد قيل: إنه مات سنة خمس عشرة ومائة، وكان مولده سنة سبع وعشرين.(@)(@@)(@@)(@@) ||| AUTO عطاء بن يسار، أبو محمد(@)(@@) مولى ميمونة زوج النبي صلى الله عليه وسلم أخو سليمان، وعبد الملك، وعبد الله بني يسار، يروي عن: أبي سعيد، وأبي هريرة، روى عنه: عمرو بن دينار، ومحمد بن عمرو بن عطاء، قدم الشام وكان أهلها يكنونه بأبي عبد الله، وقدم PageV01P002 [ج 2: ص 383] مصر وكان أهلها يكنونه بأبي يسار، وكان صاحب قصص وعبادة وفضل، مات سنة ثلاث ومائة، وكان مولده سنة تسع عشرة، وكان موته بالإسكندرية وبها دفن، وكان له يوم مات أربع وثمانين سنة.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO عطاء بن يزيد الجندعي الليثي(@)(@@) أصله من المدينة، سكن الشام، كنيته: أبو محمد، وقد قيل: أبو يزيد، يروي عن: أبي أيوب، وأبي سعيد، وتميم الداري، وأبي هريرة، روى عنه: سهيل بن أبي صالح، والناس، مات سنة خمس ومائة، وهو ابن ثمانين سنة، وكان مولده سنة خمس وعشرين، وهو من بني جندع بن ليث.(@)(@@)(@@)(@@) ||| AUTO عطاء بن ميناء(@)(@@) مولى البختري بن أبي ذباب، من أهل المدينة، يروي عن: أبي هريرة، روى عنه: أيوب بن موسى، وسعيد بن أبي سعيد، وأخوه سعيد بن ميناء.(@)(@@)(@@)(@@) ||| AUTO عطاء بن يحنس(@)(@@) يروي عن: أبي هريرة، روى عنه: عطاء بن أبي رباح.(@)(@@)(@@)(@@) ||| AUTO عطاء بن يزيد السكسكي(@)(@@) يروي عن: رجل من أصحاب النبي صلى الله عليه وسلم عداده في أهل الشام، روى عنه: أهلها.(@)(@@) عطاء(@)(@@) مولى أم صبية الجهنية، يروي عن: أبي هريرة، عداده في أهل المدينة، روى عنه: سعيد المقبري.(@)(@@)(@@)(@@) ||| AUTO عطاء بن السائب الكناني(@)(@@) ثم الليثي، من أهل المدينة، مسح علي بن أبي طالب رأسه وقال: " بارك الله فيك، وعليك، وعلى ذريتك من بعدك ". روى عنه: ابنه محمد بن عطاء، ومحمد، 
ms680	 سكن مرو، ولمحمد ابن يقال له: السائب، وللسائب ابن يقال له: عطاء بن السائب بن محمد بن عطاء بن السائب، عدادهم في أهل مرو.(@)PageV01P002(@)(@@) [ج 2: ص 384](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO عطاء بن بخت(@)(@@) يروي عن: أبي سعيد الخدري، روى عنه: عمر بن عطاء بن أبي الخوار.(@)(@@)(@@)(@@) ||| AUTO عطاء المدني(@)(@@) يروي عن: عثمان بن عفان، روى عنه: ابنه حسن بن عطاء.(@)(@@)(@@)(@@) ||| AUTO عطاء العامري(@)(@@) يروي عن: عبد الله بن عمرو، روى عنه: ابنه يعلى بن عطاء.(@)(@@)(@@)(@@) ||| AUTO عطاء القداحي(@)(@@) يروي عن: عبد الله بن عمرو، روى عنه: عروة بن قيس، أحسبه والد يعلى بن عطاء.(@)(@@) عطاء(@)(@@) مولى السائب بن يزيد، ابن أخت النمر بن قاسط، يروي عن: السائب بن يزيد، وسلمة بن الأكوع، روى عنه: عكرمة بن عمار.(@)(@@)(@@)(@@) ||| AUTO عطاء بن صهيب(@)(@@) مولى رافع بن خديج الأنصاري، أبو النجاشي، يروي عن: رافع بن خديج، روى عنه: الأوزاعي، وعكرمة بن عمار، وكان قد صحب رافع بن خديج ست سنين.(@)(@@)(@@)(@@) ||| AUTO عطاء بن الزيان(@)(@@) قال: رأيت الوليد بن عتبة يصلى على أبي هريرة، روى عنه: يزيد بن أبي حبيب.(@)(@@)(@@)(@@) ||| AUTO عطاء بن أبي ميمونة(@)(@@) من أهل البصرة، كنيته أبو معاذ، مولى أنس، وقد قيل: مولى عمران بن حصين، يروي عن: أنس بن مالك، وأبي هريرة، وأبي رافع، روى عنه: قتادة، وشعبة، وابنه روح بن عطاء بن أبي ميمونة، مات بعد الطاعون، وكان الطاعون سنة إحدى وثلاثين ومائة.(@)PageV01P002(@)(@@) [ج 2: ص 385](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO عطاء بن أبي راشد(@)(@@) يروي عن: عبد الله بن الحارث بن جزء، روى عنه: محمد بن عمرو بن علقمة.(@)(@@)(@@)(@@) ||| AUTO عطاء بن فروخ(@)(@@) مولى قريش، عداده في أهل المدينة، وكان انتقل إلى البصرة، يروي عن: عثمان بن عفان، روى عنه: يونس بن عبيد، وعلي بن زيد.(@)(@@)(@@)(@@) ||| AUTO عطاء الحمصي(@)(@@) شيخ، يروي عن: عائشة، روى عنه: زيد بن رفيع، إن كان متصلا فحسن.(@)(@@)(@@)(@@) ||| AUTO عطاء بن عثمان القرشي(@)(@@) يروي عن: أنس بن مالك، روى عنه: عفيف بن سالم.(@)(@@)(@@)(@@) ||| AUTO عطاء بن زهير بن الأصبغ العامري 