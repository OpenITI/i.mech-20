ms381	 بن يعلى بن زنبور .(@)(@@)(@@)(@@) $ * وأبو علي محمد بن الفرات الكوفي .(@)(@@)(@@)(@@) $ * وأبو علي محمد بن معاوية النيسابوري .(@)(@@)(@@)(@@) $ * وأبو علي ( 2 / 32 ) مهدي بن إبراهيم العماني .(@)(@@) أخبرني أحمد بن شعيب ، قال : أنبأ ابن المعلى ، قال : أنبأ أبو عمير ، قال : أخبرنا أبو علي مهدي بن إبراهيم العماني .(@)(@@)(@@)(@@) $ * وأبو علي هلال بن أبي ميمون .(@)(@@)(@@)(@@) $ * وأبو علي هارون بن معروف .(@)(@@)(@@)(@@) $ * وأبو علي هشيم بن هشام بن السري بن أبي ساسان .(@)(@@) 1300 - حدثنا عمرو بن علي ، قال : حدثنا محمد بن سواء ، قال : حدثنا أبو علي الهذلي ، قال : أبو حفص ، وهو هلال بن أبي ميمون ، قال : قدمت المدينة ، فأتيت سعيد بن المسيب ، فسألته فقال : ممن أنت ؟ قلت : من PageV02P750 أهل العراق ، من [ أهل ] البصرة ، قال : تسألني وفيكم قتادة .(@)(@@) 1301 - أخبرني أحمد بن شعيب ، قال : أنبأ محمد بن عيسى ، قال : أنبأ إسحاق ، قال : حدثنا هشيم بن هشام بن السري بن أبي ساسان ، ويكنى أبا علي قال : قلت لابن جريج : يا أبا الوليد ! ما تقول في رجل يؤدي زكاته في غير مصره ؟ قال : قال عطاء : هم المسلمون فاعط حيث أحببت . PageV02P751(@)(@@)(@@)(@@) |||| ( من كنيته أبو علقمة ، وأبو علوان )(@)(@@)(@@)(@@) $ * أبو علقمة موسى بن ميمون بن موسى .(@)(@@)(@@)(@@) $ * وأبو علقمة عبد الله بن محمد بن عبد الله بن أبي فروة .(@)(@@)(@@)(@@) $ * وأبو علقمة نصر بن علقمة .(@)(@@)(@@)(@@) $ * وأبو علوان عبد الله بن عاصم .(@)(@@) 1302 - أخبرني أحمد بن شعيب ، قال : أنبأ قتيبة بن سعيد ، قال : حدثنا عبد الله أبو علقمة بن محمد ، عن محمد بن المنكدر ، عن جابر ، قال : رأيت رسول الله [ صلى الله عليه وسلم ] أكل مما مست النار ثم صلى ولم يتوضأ .(@)(@@) سمعت العباس ، قال : سمعت يحيى قال : أبو علقمة الفروي [ عبد الله ] : ثقة .(@)(@@) قال يحيى : وأبو علقمة شيخ كان يكون في المسجد ، مسجد الرصافة لا يكاد يفارقه ، ليس حديثه بشيء .(@)(@@) 1303 - أخبرني أحمد بن شعيب ، قال : أنبأ الفضل بن سهل ، PageV02P752 قال : حدثنا أبو علقمة موسى بن ميمون بن موسى بن عبد الرحمن بن صفوان ، قال : حدثني أبي ميمون المرائي ، عن أبيه موسى ، عن أبيه عبد 
ms382	 الرحمن بن صفوان ، قال : قال رسول الله [ صلى الله عليه وسلم ] : المرء مع من أحب .(@)(@@) 1304 - أخبرني أحمد بن شعيب ، قال : أنبأ عمر بن محمد بن الحسن ، قال : حدثنا أبي ، قال : حدثنا شريك ، عن أبي علوان ، عن عبد الله بن عمر ، عن النبي [ صلى الله عليه وسلم ] قال : إن في ثقيف كذابا ومبيرا . PageV02P753(@)(@@)(@@)(@@) ||| ( حرف الكاف في العين )(@)(@@)(@@)(@@) |||| ( [ من كنيته أبو عكرمة ] )(@)(@@)(@@)(@@) $ * أبو عكرمة ، يروي عنه : الأصمعي .(@)(@@) 1305 - حدثنا أبو يعلى زكريا بن خلاد ، قال : حدثنا عبد الملك بن قريب الأصمعي ، قال : حدثنا أبو عكرمة ، عن الحسن الجعفري ، عن أبي معمر ، عن الحسن ، عن الأحنف ، قال : كنت عند عمر بن الخطاب فرأيت عنده امرأة وهي تقول : يا أمير المؤمنين اذكر إذ كنت في أصلاب المشركين ، وأرحام المشركات ، حتى من الله عليك بمحمد [ صلى الله عليه وسلم ] ، فقلت : قد أكثرت على أمير المؤمنين ، فقال عمر : دعها أما تعرفها هذه التي سمع الله منها ، فأنا أحق أن أسمع منها . انتهى ( 2 / 37 ) . PageV02P754(@)(@@)(@@)(@@) ||| ( حرف الميم [ في العين ] )(@)(@@)(@@)(@@) |||| ( من كنيته أبو عمارة )(@)(@@)(@@)(@@) $ * أبو عمارة حجر ، عن أبي هريرة .(@)(@@)(@@)(@@) $ * وأبو عمارة محمد بن تميم ، عن : الحسن ، يروي عنه : حماد بن زيد .(@)(@@)(@@)(@@) $ * وأبو عمارة قيس مولى الأنصار .(@)(@@)(@@)(@@) $ * وأبو عمارة عبد خير بن يزيد الهمداني .(@)(@@)(@@)(@@) $ * وأبو عمارة حمزة ، عن شهر ، روى عنه : الأعمش .(@)(@@)(@@)(@@) $ * وأبو عمارة حمزة بن حبيب الزيات .(@)(@@)(@@)(@@) $ * [ وأبو عمارة حمزة ، عن : عبد الرحمن بن حرملة ، روى عنه : ابن المبارك ] .(@)(@@)(@@)(@@) $ * وأبو عمارة [ حمزة ] بن الحارث بن عمير ، سمع : أباه ، روى عنه : إسحاق بن أبي إسرائيل .(@)(@@)(@@)(@@) $ * وأبو عمارة [ الربعي ] سوار بن عمارة الرملي ، يروي عن : مسرة بن معبد اللخمي .(@)(@@)(@@)(@@) $ * وأبو عمارة الوليد ، عن : سليمان بن بريدة ، روى عنه : جعفر الأحمر .(@)(@@)(@@)(@@) $ * وأبو عمارة يعقوب بن إسحاق ، عن أبي عون ، روى عنه : حجاج بن محمد . PageV02P755(@)(@@) 1306 - حدثنا أحمد ، وعلي ابنا حرب ، قالا : حدثنا القاسم بن يزيد ، عن شريك ، عن عبيد الله بن سعد ، عن حجر أبي عمارة ، قال : جلبت غنما إلى المدينة ، فجئت إلى أبي هريرة ، فسألني ، فأخبرته ، قال : ما 
ms383	 فعل سمرة بن جندب ؟ قلت : حي ، قال : ما على الأرض أحد أحب إلي حياة منه ، قلت : لم ذاك ؟ قال : لأن رسول الله [ صلى الله عليه وسلم ] ، قال لي وله ولآخر : آخركم موتا في النار .(@)(@@) 1307 - حدثنا معاوية بن صالح ، قال : حدثنا خالد بن مخلد ، قال : حدثنا قيس أبو عمارة مولى الأنصار ، قال : سمعت عبد الله بن أبي بكر ، عن أبيه ، عن جده ، قال : قال رسول الله [ صلى الله عليه وسلم ] : ما من رجل يعزي أخاه المسلم بمصيبة ، إلا كساه الله جل ثناؤه حلل الكرامة يوم القيامة .(@)(@@) حدثنا العباس ، قال : سمعت يحيى يقول : أبو عمارة صاحب الزعفراني ليس بشيء .(@)(@@) وأبو عمارة حمزة بن حبيب الزيات ، مولى بني تيم الله بن ربيعة ، مات سنة ست وخمسين ومائة .(@)(@@) حدثني أبو عمران موسى بن سهل الرملي ، قال : حدثنا سوار بن عمارة أبو عمارة الربعي ، قال : حدثنا مسرة بن معبد اللخمي .(@)(@@) 1308 - وحدثنا أبو داود سليمان بن أشعث ، قال : حدثنا الحسن ابن علي الخلال الحلواني ، قال : حدثنا مسهر بن عبد الله بن سلع ، عن أبيه ، PageV02P756 قال : قلت لعبد خير بن يزيد : يا أبا عمارة ! أراك حسن الجسم ، قال : أتى علي إلى يومي هذا مائة سنة وعشرون سنة ، قلت : تذكر من أمر الجاهلية شيئا ؟ قال : لأذكر كنا ببلادنا باليمن ، وأنا غلام إذ جاءنا كتاب النبي [ صلى الله عليه وسلم ] فجمع الناس إلى خير واسع .(@)(@@) 1309 - أخبرني أحمد بن شعيب ، قال : أنبأ القاسم بن زكريا ، قال : حدثنا إسحاق بن منصور ، عن جعفر الأحمر ، عن الوليد أبي عمارة ، عن سليمان بن بريدة ، عن أبيه قال : قال رسول الله [ صلى الله عليه وسلم ] : من خبب امرأة [ رجل ] مسلم ، أو مملوكه فليس منا .(@)(@@) 1310 - أخبرني أحمد بن شعيب ، قال : أنبأ إبراهيم بن الحسن ، قال : حدثنا حجاج بن محمد ، عن أبي عمارة يعقوب بن إسحاق ، عن ابن عون ، قال : كان ابن سيرين لا يرى لأصحاب الأهواء حرمة . PageV02P757(@)(@@)(@@)(@@) |||| ( من كنيته أبو عمار )(@)(@@)(@@)(@@) $ * أبو عمار غريب بن حميد ، يروي عنه : عمارة بن عمير 
ms384	 .(@)(@@)(@@)(@@) $ * وأبو عمار شداد بن عبد الله ، يحدث عنه : يحيى بن أبي كثير ، والأوزاعي .(@)(@@)(@@)(@@) $ * وأبو عمار عكرمة بن عمار .(@)(@@)(@@)(@@) $ * وأبو عمار زياد بن ميمون الأبرص ، يحدث عن : أنس بن مالك .(@)(@@) 1311 - حدثنا أبو موسى محمد بن المثنى ، قال : حدثنا حجاج بن فروخ ، قال : حدثنا زياد أبو عمار الأبرص ، عن أنس بن مالك ، قال : قال رسول الله [ صلى الله عليه وسلم ] [ الحديث ] .(@)(@@) سمعت العباس ، قال : سمعت يحيى ، يقول : شداد الذي ( 2 / 38 ) روى عنه : عكرمة بن عمار ، وعوف الأعرابي ، هو واحد ، وهو شداد أبو عمار ، وهو الذي يروي عنه الأوزاعي [ والنهاس بن قهم ] . PageV02P758(@)(@@)(@@)(@@) |||| ( من كنيته أبو عمران )(@)(@@)(@@)(@@) $ * أبو عمران الجوني عبد الملك بن حبيب .(@)(@@)(@@)(@@) $ * وأبو عمران سليمان بن عبد الله ، يروي عنه : أبي الدرداء .(@)(@@)(@@)(@@) $ * وأبو عمران عبد الله بن رجاء .(@)(@@)(@@)(@@) $ * [ وأبو عمران حفص بن عمر الإمام ] .(@)(@@)(@@)(@@) $ * وأبو عمران حفص بن عمران الرازي .(@)(@@)(@@)(@@) $ * وأبو عمران إبراهيم بن يزيد النخعي الكوفي الفقيه .(@)(@@)(@@)(@@) $ * وأبو عمران أسلم التجيبي ، عن عقبة .(@)(@@)(@@)(@@) $ * وأبو عمران أيمن بن نابل [ المكي ] .(@)(@@)(@@)(@@) $ * وأبو عمران زكريا بن سليم .(@)(@@)(@@)(@@) $ * وأبو عمران معافى بن عمران الحمصي .(@)(@@)(@@)(@@) $ * وأبو عمران موسى بن عبد الله ، عن : ابن سعيد الأشج ، يحدث عنه : الفضل بن سهل .(@)(@@) 1312 - حدثنا عمرو بن علي ، قال : حدثنا عمير بن أبي خليفة ، قال : سمعت زكريا أبا عمران صاحب الجيلي ، قال : سألت الحسن ، قلت : إن لي رحما فأعطيهم من زكاتي ، قال : نعم ، إلا أن يكونوا في عيالك أو نفقتك ، قلت : أفأقوتهم [ قال : نعم ] إياه . PageV02P759(@)(@@) 1313 - قال : حدثني محمد بن إسماعيل بن علية القاضي ، قال : حدثنا زيد بن الحباب ، قال : حدثني أيمن بن نابل أبو عمران المكي ، قال : أقيمت الصلاة ، فدخلت مع الناس في الصلاة ثم ذكرت أن ثوبي ليس بطاهر ، فخرجت ، فسألت عطاء ، فقال : ليتك لم تخرج ، وصليت مع الناس .(@)(@@) حدثنا أبو حميد بن سيار ، قال : حدثنا المعافى بن عمران أبو عمران .(@)(@@) 1314 - أخبرني أحمد بن شعيب ، قال : أنبأ سويد بن نصر ، قال : حدثنا عبد الله ، عن الحسن بن عمرو ، عن فضيل بن عمرو ، قال : جئت 
ms385	 إلى إبراهيم وهو في البيت يصلي ، فقلت : يا أبا عمران ! أصحابك يكرهون هذه الصلاة ، فقال : إني لأدع وردي من الليل رجاء أن يحثني على صلاة النهار .(@)(@@) 1315 - حدثنا محمد بن عوف الطائي ، قال : حدثنا علي بن عياش ، [ قال : حدثنا إسماعيل بن عياش ] قال : حدثنا ثعلبة بن مسلم ، عن أبي عمران سليمان بن عبد الله ، عن أبي الدرداء ، عن النبي [ صلى الله عليه وسلم ] ، قال : إن الله خلق الداء والدواء ، فتداووا ، ولا تتداووا بحرام .(@)(@@) 1316 - أخبرني أحمد بن شعيب ، قال : أنبأ الحسن بن إسماعيل ابن سليمان ، قال : حدثنا عبد الله بن رجاء أبو عمران ، عن موسى بن عقبة ، عن أبي سلمة ، عن عائشة يرفعه إلى النبي [ صلى الله عليه وسلم ] ، قال : اعلموا أن أحب أعمالكم إلى الله ما داوم عليه صاحبه ، وإن قل . PageV02P760(@)(@@) 1317 - أخبرني أحمد بن شعيب ، قال : أنبأ إسحاق بن إبراهيم ، قال : حدثنا عبد العزيز بن عبد الصمد ، قال : حدثنا أبو عمران الجوني عبد الملك ابن حبيب ، عن أبي بكر بن عبد الله بن قيس ، عن أبيه ، أن رسول الله [ صلى الله عليه وسلم ] قال : ما بين القوم وبين أن ينظروا إلى ربهم إلا رداء الكبرياء ، على وجهه في جنات عدن .(@)(@@) 1318 - [ و ] أخبرني أحمد شعيب ، قال : حدثنا الحسن بن إسحاق ، قال : حدثنا حفص بن عمران الإمام [ أبو عمران ] ، قال : حدثنا عنبسة الحداد ، عن الزهري ، عن سعيد ، وأبي سلمة ، عن أبي هريرة ، قال : قال رسول الله [ صلى الله عليه وسلم ] : آخر كلام القدرية لشرار هذه الأمة في آخر الزمان .(@)(@@) 1319 - حدثنا أحمد بن شعيب ، قال : حدثنا سوار ، قال : حدثنا حفص بن عمران الرازي أبو عمران ، عن العوام ، قال : سوار وهو ابن حوشب ، قال : حدثني رجل من آل النعمان بن بشير ، عن النعمان بن بشير ، قال : قال رسول الله [ صلى الله عليه وسلم ] : ألا إن سبحان الله والحمد لله ، ولا إله إلا الله والله أكبر ، هن الباقيات الصالحات ( 2 / 39 ) .(@)(@@) 1320 - حدثنا أحمد بن منصور أبو بكر الرمادي ، قال : حدثنا 
ms386	 يونس ابن محمد المعلم ، قال : حدثنا أبو شهاب ، قال : أخبرني شيخ ، عن إبراهيم ، أنه حدث يوما حديثا حسنا ، فقطعه قبل أن يتمه فقالوا : لولا أتممته يا أبا عمران ! قال : دعوني فإن نفسي قد أعجبتني . PageV02P761(@)(@@) سمعت العباس [ بن محمد ] ، عن يحيى [ بن معين ] ، قال : اسم أبي عمران الجوني : عبد الملك بن حبيب .(@)(@@) قال : وأيمن بن نابل كنيته أبو عمران(@)(@@) قال : وكنية إبراهيم النخعي أبو عمران .(@)(@@) 1321 - حدثني إبراهيم بن الجنيد ، قال : حدثني الهيثم بن خارجة قال : حدثنا أبو عمران سعيد بن ميسرة البكري الموصلي ، عن أنس بن مالك ، [ قال ] : إنه دخل عليه شاب قد سكن عليه شعره ، فقال : مالك والسكينة افرقه أوجزه ، فقال له رجل : يا أبا حمزة ! فيمن كانت السكينة ؟ قال : في قوم لوط ، قال : كانوا يسكنون شعورهم ، ويمضغون العلك في الطرق والمنازل ، ويخذفون [ ويفرجون ] [ ولكن حوت ] أقبيتهم إلى خواصرهم .(@)(@@) 1322 - حدثنا الحسن بن علي بن عفان ، قال : حدثنا عبد الله بن نمير ، عن الأعمش ، عن إبراهيم ، قال : لا بأس بالكفيل والرهن في السلم ، فقال رجل : يا أبا عمران ! قال سعيد بن جبير : ذلك الربا المضمون ، قال إبراهيم : لم يقل شيئا ، ربما ارتهن الرجل ، ثم قال : حدثني الأسود ، عن عائشة ، قالت : رهن رسول الله [ صلى الله عليه وسلم ] درعا وأخذ طعاما . PageV02P762(@)(@@)(@@)(@@) |||| ( من كنيته أبو عمير )(@)(@@)(@@)(@@) $ * أبو عمير الحارث بن عمير .(@)(@@)(@@)(@@) $ * وأبو عمير مجالد بن سعيد .(@)(@@)(@@)(@@) $ * وأبو عمير عيسى بن محمد النحاس ، يحدث عن : ضمرة ، والوليد بن مسلم . (@)(@@) 1323 - حدثنا علي بن سهل الرملي أبو الحسن ، قال : حدثنا مؤمل بن إسماعيل ، عن أبي عمير الحارث بن عمير ، عن عبيد الله بن عمر ، عن نافع ، عن ابن عمر .(@)(@@) 1324 - حدثنا ربيع بن سليمان أبو محمد الأزدي ، قال : حدثنا يعقوب بن إسحاق بن أبي عباد ، قال : حدثنا أبو عمير الحارث بن عمير ، عن أيوب ، عن ابن سيرين ، عن أبي هريرة ، عن رسول الله [ صلى الله عليه وسلم ] ، قال : لا يبولن أحدكم في الماء الدائم ، ثم يغتسل فيه .(@)(@@) حدثنا العباس [ بن محمد ] ، عن يحيى 
ms387	 بن معين ، قال : الحارث بن عمير أبو عمير ، وكان بصريا ، نزل مكة ، وكان يعلى بن عبيد يروي عنه . PageV02P763(@)(@@)(@@)(@@) |||| ( من كنيته أبو العميس )(@)(@@)(@@)(@@) $ * أبو العميس عتبة بن عبد الله بن عتبة بن عبد الله بن مسعود .(@)(@@) 1325 - حدثنا أحمد بن سليمان الرهاوي ، قال : حدثنا جعفر بن عون ، قال : أنبأ أبو عميس عتبة بن عبد الله ، عن ابن أبي مليكة قال : سألت عائشة من كان رسول الله [ صلى الله عليه وسلم ] مستخلفا لو استخلف ؟ قالت : أبا بكر ، قيل لها : من بعد أبي بكر ؟ قالت : عمر ، قيل : ثم من ؟ قالت : أبا عبيدة بن الجراح ، وانتهت إلى ذا .(@)(@@) حدثنا العباس [ بن محمد ] ، قال : حدثنا يحيى [ بن معين ] ، قال : أبو العميس اسمه عتبة بن عبد الله ، أخو المسعودي [ والمسعودي اسمه : ] عبد الرحمن بن عبد الله . PageV02P764(@)(@@)(@@)(@@) |||| ( من كنيته أبو عميرة )(@)(@@)(@@)(@@) $ * أبو عميرة حبيب الحذاء .(@)(@@)(@@)(@@) $ * وأبو عميرة رشيد بن مالك ، له صحبة ( 2 / 40 ) .(@)(@@) 1326 - حدثني أبو نعيم ، عن معروف بن واصل السعدي ، قال : حدثتني حفصة بنت طلق ، سنة تسعين ، عن أبي عميرة رشيد بن مالك ، قال : كنت عند رسول الله [ صلى الله عليه وسلم ] ذات يوم ، [ الحديث ] . PageV02P765(@)(@@)(@@)(@@) |||| ( من كنيته أبو عمر )(@)(@@)(@@)(@@) $ * أبو عمر سالم بن عبد الله بن عمر .(@)(@@)(@@)(@@) $ * وأبو عمر سالم بن محرز بن أبي هريرة ، يحدث عنه : صبيح بن صهيب .(@)(@@)(@@)(@@) $ * وأبو عمر شهاب بن عباد العبدي .(@)(@@)(@@)(@@) $ * وأبو عمر شكر ، يحدث عنه : عبد الرحمن بن مهدي .(@)(@@)(@@)(@@) $ * وأبو عمر شبيب .(@)(@@)(@@)(@@) $ * وأبو عمر [ برد ، أخو ] يزيد بن أبي زياد .(@)(@@)(@@)(@@) $ * وأبو عمر يحيى بن عبيد النهرواني ، يروي عنه : أبو إسحاق ، وشعبة .(@)(@@)(@@)(@@) $ * وأبو عمر بكر بن الأسود بصري ، يروي عنه : أبو زرعة الرازي .(@)(@@)(@@)(@@) $ * وأبو عمر يزيد بن حمير شامي ، يروي عنه : شعبة .(@)(@@)(@@)(@@) $ * وأبو عمر يزيد بن مسلم الصنعاني .(@)(@@)(@@)(@@) $ * وأبو عمر يونس بن القاسم .(@)(@@)(@@)(@@) $ * وأبو عمر دينار .(@)(@@)(@@)(@@) $ * وأبو عمر ذر بن عبد الله ، والد عمر بن ذر .(@)(@@)(@@)(@@) $ * وأبو عمر النضر الخزاز . PageV02P766(@)(@@)(@@)(@@) $ * وأبو عمر زاذان الكندي ، روى عنه : المنهال بن عمرو .(@)(@@)(@@)(@@) $ * وأبو عمر زياد بن أبي مسلم ، وقيل : ابن مسلم ، يروي 
ms388	 عنه : ابن مهدي ، وابن أبي عدي .(@)(@@)(@@)(@@) $ * وأبو عمر قيس بن رافع ، يروي عنه : عبد الكريم بن الحارث .(@)(@@)(@@)(@@) $ * وأبو عمر مروان بن جعفر بن سعد بن سمرة بن جندب .(@)(@@)(@@)(@@) $ * وأبو عمر محمد ، يروي عنه : شعيب بن حرب .(@)(@@)(@@)(@@) $ * وأبو عمر محمد بن يحيى بن قيس المازني .(@)(@@)(@@)(@@) $ * وأبو عمر محمد بن أبان بن صالح .(@)(@@)(@@)(@@) $ * وأبو عمر عبد الله مولى أسماء ، يحدث عنه : المغيرة بن زياد ، والحجاج بن أرطأة ، وهو عبد الله بن كيسان .(@)(@@)(@@)(@@) $ * وأبو عمر عبد الله بن عبيد ، مولى أهبان بن صيفي .(@)(@@)(@@)(@@) $ * وأبو عمر عثمان بن عبد الرحمن الجمحي ، روى عنه : محرز بن عون أبو الفضل .(@)(@@)(@@)(@@) $ * وأبو عمر عباد بن عمر بن أبي حليمة ، يروي عنه : العباس بن عبد العظيم .(@)(@@)(@@)(@@) $ * وأبو عمر عبد الحميد بن الحسن الهلالي ، روى عنه : علي بن حجر .(@)(@@)(@@)(@@) $ * وأبو عمر عبد العزيز بن فائد .(@)(@@)(@@)(@@) $ * وأبو عمر عيسى بن عمر ، أخو حاجب بن عمر .(@)(@@)(@@)(@@) $ * وأبو عمر عيسى بن عمر القاري ، كوفي . PageV02P767(@)(@@)(@@)(@@) $ * وأبو عمر عاصم بن النضر ، يروي عن : معتمر بن سليمان .(@)(@@)(@@)(@@) $ * وأبو عمر عاصم بن عمر العمري .(@)(@@)(@@)(@@) $ * وأبو عمر إبراهيم بن أبي الوزير .(@)(@@)(@@)(@@) $ * وأبو عمر إسماعيل بن مجالد بن سعيد .(@)(@@)(@@)(@@) $ * وأبو عمر حماد بن واقد البصري .(@)(@@)(@@)(@@) $ * وأبو عمر حمزة الضبي .(@)(@@)(@@)(@@) $ * وأبو عمر حمزة العائذي ، روى عنه : عوف .(@)(@@)(@@)(@@) $ * وأبو عمر حصين بن عمر الأحمسي .(@)(@@)(@@)(@@) $ * وأبو عمر حجين بن المثنى .(@)(@@)(@@)(@@) $ * وأبو عمر كيسان ، عن يزيد بن بلال الفزاري .(@)(@@)(@@)(@@) $ * وأبو عمر خالد بن أبي عمران ، يحدث عنه : حيوة بن شريح .(@)(@@)(@@)(@@) $ * وأبو عمر حفص بن عمر الخطابي بغدادي ، يروي عن : معاوية بن سلام .(@)(@@)(@@)(@@) $ * وأبو عمر حفص بن عمر الحوضي بصري ، يروي عن : شعبة .(@)(@@)(@@)(@@) $ * وأبو عمر حفص بن عمر الضرير ، يروي عن : حماد بن سلمة .(@)(@@)(@@)(@@) $ * وأبو عمر حفص بن غياث كوفي ، يروي عن : جعفر بن محمد ، والأعمش .(@)(@@)(@@)(@@) $ * وأبو عمر حفص بن عبيد الله الأنصاري ، عن أنس بن مالك .(@)(@@)(@@)(@@) $ * وأبو عمر حفص بن ميسرة الشامي ، ابن وهب عنه .(@)(@@)(@@)(@@) $ * وأبو عمر حفص بن سليمان ، متروك .(@)(@@)(@@)(@@) $ * وأبو عمر حفص بن أبي الصهباء العدوي ، يحدث عنه : العلاء بن 
ms389	 أسد . PageV02P768 قال : وحدثنا حفص بن أبي الصهباء العدوي ، أبو عمر ، قال : حدثنا أبو غالب [ أن ] العلاء بن زياد ، قال : لأنس يا أبا حمزة ! عذاب القبر حق ؟ قال : سبحان الله ، نعم .(@)(@@)(@@)(@@) $ * وأبو عمر حبيب يروي عنه : عثمان بن عمر .(@)(@@) 1327 - حدثنا محمد بن بشار ، قال : حدثنا يحيى بن سعيد ، قال : حدثنا عوف ، قال : حدثنا حمزة أبو عمر العائذي ، قال : حدثنا علقمة بن وائل ، [ عن وائل ] قال : كنت عند ( 2 / 41 ) رسول الله [ صلى الله عليه وسلم ] [ في حاجة ] حتى جيء بالقاتل يقوده ولي المقتول في نسعه ، فقال رسول الله [ صلى الله عليه وسلم ] : أتعفو ؟ قال : لا ، قال : فتأخذ الدية ؟ قال : لا ، قال : فتقتله ؟ قال : نعم ، قال : اذهب به ، فلما ذهب به وتولى من عنده دعا به ، فقال : أتعفو ؟ قال : لا ، قال : أتأخذ الدية ؟ قال : لا ، قال : أتقتله ؟ قال : نعم ، فلما أدبر ، قال رسول الله [ صلى الله عليه وسلم ] عند ذلك : أما أنك إن عفوت يبوء بإثمه وإثم صاحبك ، فعفا عنه ، فتركه ، قال : فأنا رأيته يجره بنسعه .(@)(@@) 1328 - حدثنا علي بن معبد ، قال : حدثنا أبو أحمد الزبيري ، قال : حدثنا كيسان أبو عمر ، قال : حدثني مولاي يزيد بن بلال ، قال : رأيت عليا PageV02P769 عليه السلام ، يتوضأ فخلل لحيته ، قال : ورأيت عليه قلنسوة بيضاء مضربة .(@)(@@) 1329 - حدثنا الحسن بن علي بن عفان أبو محمد ، قال : حدثنا أسباط ابن محمد ، قال : حدثنا كيسان أبو عمر ، عن يزيد بن بلال ، قال : رأيت على علي عليه السلام يوم صفين قلنسوة بيضاء مضربة .(@)(@@) 1330 - حدثنا العباس بن محمد ، قال : حدثنا يحيى [ بن معين ] ، قال : حدثنا علي بن ثابت ، عن كيسان أبي عمر ، عن يزيد بن بلال مولاه ، وكان قد شهد صفين مع علي ، عن علي رضي الله عنه قال : لا يستاك الصائم بالعشي ، ولكن بالليل ، فإن يبوسة شفتي الصائم نور بين عينيه يوم القيامة .(@)(@@) وفي موضع آخر : كيسان أبو عمر كوفي ، يروي عن : يزيد بن بلال مولاه .(@)(@@) 1331 - حدثنا أبو القاسم بن عبد الرحمن بن عبد الله بن عبد 
ms390	 الحكم ، قال : حدثنا إدريس بن يحيى ، قال : حدثنا حيوة بن شريح ، قال : دخلنا على خالد بن أبي عمران ، فقلنا : يا أبا عمر ! هل من غداء قال : فقدم إلينا كسرا ، فأكلنا ، ثم دعا ، فلما فرغ ، قال : اللهم إن كنت أجبت دعوتنا ، فأرنا علامة ، قال : فرفع رجل من القوم رأسه فإذا بنور ساطع ، قال أبو عمر : فظننت أنه حيوة .(@)(@@) 1332 - حدثنا الحسن بن علي بن عفان ، قال : حدثنا أسباط بن PageV02P770 محمد ، عن إسماعيل بن سليمان الأزرق ، عن أبي عمر البزار ، عن محمد ابن الحنفية ، قال : اختضب علي عليه السلام مرة ، ثم تركه .(@)(@@) 1333 - حدثنا أبو جعفر هارون بن سعيد الأيلي ، قال : أنبأ خالد ابن نزار ، قال : حدثني أبو عمر القارئ ، واسمه المبارك بن يزيد ، قال : حدثني سليمان بن الحجاج الطائفي ، عن أيوب بن موسى ، عن عطاء أخبره ، أن أبا هريرة كان يسلم واحدة ينفخ فيها قبل وجهه .(@)(@@) 1334 - حدثنا يونس بن عبد الأعلى ، قال : أنبأ ابن وهب ، قال : أخبرني عمرو بن الحارث ، عن عبد الكريم بن الحارث ، أن أبا عمر قيس بن رافع ، قال : اجتمع ناس من أصحاب النبي [ صلى الله عليه وسلم ] عند ابن عباس فتذاكروا .(@)(@@) 1335 - حدثنا الحسن بن علي ، قال : حدثنا عبد الحميد الحماني ، عن النضر أبي عمر الخزاز [ ، عن عكرمة ، عن ابن عباس ، قال : الشجرة التي نهي عنها آدم السنبلة .(@)(@@) 1336 - حدثنا أبو زرعة الرازي ] ، قال : حدثنا أبو عمر بكر بن الأسود بالبصرة ، قال : حدثنا أبو بكر بن عياش ، عن الأعمش ، عن أبي صالح ، عن أبي هريرة قال : قال رسول الله [ صلى الله عليه وسلم ] : إن الله رفيق يحب الرفق ، ويعطي على الرفق ما لا يعطي على الخرق .(@)(@@) 1337 - حدثنا محمد بن بشار ، قال : حدثنا عبد الرحمن بن مهدي ، PageV02P771 قال : حدثنا شكر أبو عمر ، قال : سألت عطاء عن الرجل يشك في الطواف الواجب ؟ قال : يعيد .(@)(@@) 1338 - وحدث عبد الرحمن بن إبراهيم بن دحيم ، عن محمد بن شعيب ابن شابور ، قال : حدثنا صبيح بن صهيب ، قال : حدثنا سالم أبو 
ms391	 عمر ، قال : اشتكى محرز بن أبي هريرة فدعيت له ارقيه فذهبت ، وأنا متخوف أن يكره ذلك أبو هريرة ، فقال : ارقه يا بني ! إني سمعت رسول الله [ صلى الله عليه وسلم ] يقول : العين حق .(@)(@@) 1339 - حدثنا أبو بكر بن أبي الدنيا ، قال : حدثنا أبو عمر حفص بن عمر المقرئ ، قال : حدثنا إسماعيل بن عياش ، قال ( 2 / 42 ) : حدثنا مشيختنا ، أن رسول الله [ صلى الله عليه وسلم ] قال : من خاف الله جل ثناؤه أخاف الله منه كل شيء ، ومن لم يخف الله أخافه الله من كل شيء .(@)(@@) أخبرني عبد الله بن أحمد بن حنبل ، قال : سمعت أبي يقول : حفص بن سليمان أبو عمر القارئ ، متروك الحديث .(@)(@@) حدثنا العباس [ بن محمد ] ، عن يحيى بن معين ، قال : حفص بن غياث كنيته أبو عمر .(@)(@@) قال العباس ، وسألت يحيى : عن حديث رواه الحجاج ، عن أبي عمر الأزدي ، أنه سمع ابن عمر ، قال : هو صحيح ، قلت : من أبو عمر PageV02P772 الأزدي ؟ قال : قد سمع من ابن عمر ، لم يزدني على هذا .(@)(@@) قال : وسمعت يحيى يقول : في حديث شعبة ، عن زياد أبي عمر ، قال يحيى : هذا زياد الذي يقال له : زياد الفراء ، [ و ] قد روى عن هذا الشيخ : وكيع بن الجراح ، ويحيى بن سعيد ، وعبد الرحمن بن مهدي .(@)(@@) قال : وسمعت يحيى قال : قد روى سفيان الثوري ، عن حفص بن ميسرة الصنعاني ، وكنيته أبو عمر ، [ وكان ] ينزل عسقلان .(@)(@@) 1340 - أخبرني محمد بن إبراهيم بن هاشم ، عن أبيه ، عن محمد بن عمر ، قال : زاذان أبو عمر الفارسي مولى لكندة ، أدرك عمر ، وكان من أصحاب عبد الله وكان من شيعة علي ، هلك في سلطان عبد الملك .(@)(@@) 1341 - حدثنا علي بن معبد ، قال : حدثنا أبو أحمد الزبيري ، قال : حدثنا كيسان أبو عمر ، قال : حدثني مولاي يزيد بن بلال ، قال : شهدت مع علي عليه السلام صفين ، فكان إذا أتي بالأسير ، قال : لن أقتلك صبرا إني أخاف الله رب العالمين وكان إذا أخذ الأسير أخذ سلاحه ، وحلفه أن لا يقاتله ، وأعطاه دراهم ويخلي سبيله .(@)(@@) 1342 
ms392	 - حدثنا محمد بن عبد الله الحضرمي مطين ، قال : حدثنا طاهر ابن أبي أحمد قال : حدثنا أبي ، قال : حدثنا [ عمي ] الفضيل بن الزبير ، قال : أخبرني أبو عمر البزار ، قال : سمعت الشعبي ، يقول : حدثني الحارث ، PageV02P773 وكان والله كذابا ، قال : سمعت عليا عليه السلام يقول : لا يموت رجل يبغضني حتى يراني حيث يبغض أن يراني ، ولا يموت رجل يحبني حتى يراني حيث يحب أن يراني .(@)(@@) 1343 - وروى عثمان بن عمر ، قال : حدثنا حبيب أبو عمر ، عن رميثة ، عن عائشة ، قالت قال رسول الله [ صلى الله عليه وسلم ] : ناوليني ثوبي فإذا فيه جنابة ففركته ، ثم ناولته .(@)(@@) 1344 - حدثنا إبراهيم بن عبد الله أبو مسلم ، قال : حدثنا إبراهيم بن حميد الطويل ، قال : حدثنا زياد ، أبو عمر ، عن إبراهيم بن محمد ، عن أبيه ، قال : بينا أنا عند عبد الله بن عمر إذا جاءه رجل يسأله عن القدر ، فقال ابن عمر : إن القدر أمر أبى الله أن يطلعكم عليه ، فلا تريدوا من الله من أبى عليكم .(@)(@@) 1345 - حدثنا أحمد بن شعيب ، قال : حدثنا العباس بن عبد العظيم ، قال : حدثنا عمر [ بن يونس ] ، قال : حدثنا سابق مولى يحيى ابن يزيد القرشي ، قال : حدثنا أبو عمر ، قال : قال عمر بن يونس : وهو حفص بن عبيد الله الأنصاري ، عن أنس بن مالك ، قال : سمعت رسول الله [ صلى الله عليه وسلم ] يقول : إن الله يحب أن تقبل رخصه ، كما يحب العبد أن تقبل توبته .(@)(@@) 1346 - [ و ] أخبرني أحمد بن شعيب ، قال : أنبأ العباس بن PageV02P774 عبد العظيم ، قال : حدثنا عباد بن أبي حليمة أبو عمر ، قال : حدثنا مالك بن مغول ، عن بيان ، عن الشعبي : ما رأيت أكثر فقها ، ولا أعظم أحلاما من أصحاب عبد الله .(@)(@@) 1347 - أخبرنا أحمد بن شعيب ، قال : أخبرني محمد بن عبيد الله بن عبد العظيم ، قال : سمعت أبا عمر مروان بن جعفر بن سعد بن سمرة بالكوفة سنة خمس وعشرين ومائتين ، حديث الوصية .(@)(@@) أخبرني أحمد بن شعيب ، قال : أنبأ محمد بن العلاء ، قال : حدثنا ابن إدريس ، عن شعبة 
ms393	 ، قال : سألت الحكم ، عن زاذان أبي عمر ، فقال : أكثر ، قال : وسألت سلمة بن كهيل عنه ، فقال أبو البختري أعجب إلي منه .(@)(@@) 1348 - [ و ] أخبرني ( 2 / 43 ) أحمد بن شعيب ، قال : حدثنا قتيبة ابن سعيد ، قال : حدثنا ابن أبي عدي ، عن زياد أبي عمر القارئ ، أنه سأل أبا العالية وخلاسا عن الوتر ؟ فقالا : اصنع في وترك ما تصنع في صلاة المغرب . PageV02P775(@)(@@)(@@)(@@) |||| ( من كنيته أبو عمرو )(@)(@@)(@@)(@@) $ * أبو عمرو الأسود بن يزيد .(@)(@@)(@@)(@@) $ * وأبو عمرو أيوب بن مدرك .(@)(@@)(@@)(@@) $ * وأبو عمرو بشر بن حرب الندبي ، ضعيف .(@)(@@)(@@)(@@) $ * وأبو عمرو بشر بن نمير ، ليس بثقة متروك .(@)(@@)(@@)(@@) $ * وأبو عمرو بشر بن السري .(@)(@@)(@@)(@@) $ * وأبو عمرو بلال بن سعد .(@)(@@)(@@)(@@) $ * وأبو عمرو بكر بن بكار .(@)(@@)(@@)(@@) $ * وأبو عمرو بزيع ، معتمر عنه .(@)(@@)(@@)(@@) $ * وأبو عمرو جعفر بن عطية .(@)(@@)(@@)(@@) $ * وأبو عمرو الحكم ، عن ضرار بن عمرو .(@)(@@)(@@)(@@) $ * وأبو عمرو حماد بن يحيى .(@)(@@)(@@)(@@) $ * وأبو عمرو الحارث بن مسكين ، قاضي مصر .(@)(@@)(@@)(@@) $ * وأبو عمرو خلاد بن يزيد بن سيف الباهلي .(@)(@@)(@@)(@@) $ * وأبو عمرو ذكوان ، حاجب عائشة .(@)(@@)(@@)(@@) $ * وأبو عمرو زياد ، عن صالح أبي الخليل ، حدث عنه : عبد الرحمن بن مهدي .(@)(@@)(@@)(@@) $ * وأبو عمرو سعيد بن سلمة بن أبي الحسام ، ضعيف .(@)(@@)(@@)(@@) $ * وأبو عمرو سعيد بن حفص ، يحدث عنه : زكريا بن يحيى ، خياط السنة . PageV02P776(@)(@@)(@@)(@@) $ * وأبو عمرو السائب .(@)(@@)(@@)(@@) $ * وأبو عمرو السكن بن أبي كريمة .(@)(@@)(@@)(@@) $ * وأبو عمرو سهيل بن ذكوان واسطي ، روى عنه : هشيم .(@)(@@)(@@)(@@) $ * [ وأبو عمرو شبابة بن سوار الفزاري .(@)(@@)(@@)(@@) $ * وأبو عمرو صفوان بن عمرو السكسكي ] .(@)(@@)(@@)(@@) $ * وأبو عمرو عبد الرحمن بن عمرو الأوزاعي .(@)(@@)(@@)(@@) $ * وأبو عمرو عبد الرحمن بن نمير اليحصبي .(@)(@@)(@@)(@@) $ * وأبو عمرو عبد الملك بن عمير ، ويقال : أبو عمر .(@)(@@)(@@)(@@) $ * وأبو عمرو عبد الله بن معاذ .(@)(@@)(@@)(@@) $ * وأبو عمرو عبد المجيد ، قال : كنا بالرجيح ، حدث عن : العداء بن خالد ، يروي عنه : عثمان بن عمر .(@)(@@)(@@)(@@) $ * وأبو عمرو عتبة بن اليقظان .(@)(@@)(@@)(@@) $ * وأبو عمرو عيسى بن إبراهيم بن سيار ، مولى قريش .(@)(@@)(@@)(@@) $ * وأبو عمرو عيسى بن يونس بن أبي إسحاق .(@)(@@)(@@)(@@) $ * وأبو عمرو عثمان بن عمرو المديني ، عن زيد بن أسلم .(@)(@@)(@@)(@@) $ * وأبو عمرو عثمان بن عبد الرحمن .(@)(@@)(@@)(@@) $ * وأبو عمرو عثمان بن عثمان الغطفاني 
ms394	 .(@)(@@)(@@)(@@) $ * وأبو عمرو عثمان بن الهيثم المؤذن ، عن : ابن جريج .(@)(@@)(@@)(@@) $ * وأبو عمرو عثمان بن طالوت .(@)(@@)(@@)(@@) $ * وأبو عمرو عثمان بن سليمان البتي . PageV02P777(@)(@@)(@@)(@@) $ * وأبو عمرو عثمان بن إبراهيم الأنماطي ، عن : عصام بن قدامة ، ويروي عنه : أبو بكر الصنعاني .(@)(@@)(@@)(@@) $ * وأبو عمرو عامر بن شراحيل الحميري الشعبي .(@)(@@)(@@)(@@) $ * وأبو عمرو عامر بن سهل كوفي ، عن أبي بكر بن عياش .(@)(@@)(@@)(@@) $ * وأبو عمرو عاصم بن يوسف .(@)(@@)(@@)(@@) $ * وأبو عمرو عون بن عمرو القيسي .(@)(@@)(@@)(@@) $ * وأبو عمرو قيس بن رافع ، ويقال : أبو عمر .(@)(@@)(@@)(@@) $ * وأبو عمرو كلثوم بن زياد .(@)(@@)(@@)(@@) $ * وأبو عمرو كرز .(@)(@@)(@@)(@@) $ * وأبو عمرو محمد بن ميسرة .(@)(@@)(@@)(@@) $ * وأبو عمرو محمد بن إبراهيم بن أبي عدي .(@)(@@)(@@)(@@) $ * وأبو عمرو محمد بن عرعرة بن البرند .(@)(@@)(@@)(@@) $ * وأبو عمرو معاوية بن صالح الحمصي .(@)(@@)(@@)(@@) $ * وأبو عمرو مسلمة بن عمرو .(@)(@@)(@@)(@@) $ * وأبو عمرو مبارك ، عن مالك بن دينار ، يروي عنه : أبو عامر العقدي .(@)(@@)(@@)(@@) $ * وأبو عمرو ملازم بن عمرو [ بن عمير ] .(@)(@@)(@@)(@@) $ * وأبو عمرو مروان بن شجاع .(@)(@@)(@@)(@@) $ * وأبو عمرو مسلم بن إبراهيم .(@)(@@)(@@)(@@) $ * وأبو عمرو معاوية بن عمرو ، عن زائدة . PageV02P778(@)(@@)(@@)(@@) $ * وأبو عمرو مولى المطلب ، واسمه : ميسرة .(@)(@@)(@@)(@@) $ * وأبو عمرو نعيم بن ميسرة .(@)(@@)(@@)(@@) $ * وأبو عمرو نبيح العنزي .(@)(@@)(@@)(@@) $ * وأبو عمرو يزيد بن أبان الرقاشي .(@)(@@)(@@)(@@) $ * وأبو عمرو يعمر بن بشر المروزي .(@)(@@)(@@)(@@) $ * وأبو عمرو يحيى بن العلاء ، ضعيف .(@)(@@)(@@)(@@) $ * وأبو عمرو هلال [ الجهبذ ] .(@)(@@)(@@)(@@) $ * وأبو عمرو هلال ، حدث عنه : عثمان بن عمر بن فارس .(@)(@@)(@@)(@@) $ * وأبو عمرو هارون بن عنترة .(@)(@@)(@@)(@@) $ * وأبو عمرو الحكم ، يروي عنه : محمد بن طلحة ، وروى الحكم أبو عمر ، عن ضرار أبي عمرو ، عن أبي عبيد الله الشامي ، عن تميم الداري .(@)(@@)(@@)(@@) $ * [ وأبو عمرو الشيباني سعد بن إياس ] .(@)(@@) 1349 - حدثنا محمد بن منصور أبو عبد الله الجواز ، قال : حدثنا سفيان بن عيينة ، عن ابن شبرمة ، قال : قلت للشعبي : يا أبا عمرو ! ( 2 / 44 ) رجلان استشهدا على شهادة ، فمات أحدهما ، واستقضى الآخر ، قال : [ أتى شريح فيها ، وأنا جالس ، فقال ] أنت الأمير ولأشهد لك ، فقال : يا أبا أمية ! أذكرك الله فقال : أنت الأمير ولأشهد لك . PageV02P779(@)(@@) 1350 - حدثني أبو شيبة بن أبي بكر بن أبي شيبة ، قال : حدثنا عمر بن حفص بن 
ms395	 غياث ، قال : حدثني أبي ، قال : حدثنا الأعمش ، عن أبي عمرو الشيباني سعد بن إياس ، عن أبي مسعود الأنصاري ، قال : جاء رجل إلى النبي [ صلى الله عليه وسلم ] فقال : ابدع بي فاحملني ، فقال : ما عندي ما أحملك ، ولكن ائت فلانا ، قال : فأتاه فحمله ، ثم أتى رسول الله [ صلى الله عليه وسلم ] فذكر ذلك له ، فقال رسول الله [ صلى الله عليه وسلم ] : من دل على خير ، فله كأجر فاعله .(@)(@@) 1351 - حدثنا علي بن سعيد النسائي ، قال : حدثنا عيسى بن إبراهيم ابن سيار أبو عمرو مولى قريش ، قال : حدثنا عمرو بن النعمان ، قال : حدثنا موسى بن دهقان ، قال : حدثنا الربيع بن كعب بن عجرة ، عن أبيه قال : كنا مع رسول الله [ صلى الله عليه وسلم ] ، فقال لي : أتزوجت ؟ قلت : نعم ، قال : أبكر أم ثيب ، قلت : ثيب ، قال : فهلا بكرا تعضها وتعضك .(@)(@@) 1352 - حدثنا أبو خالد يزيد بن سنان ، قال : حدثنا خلاد بن يزيد الباهلي ، قال : حدثنا هشام بن الغاز ، عن عمرو بن شعيب ، عن أبيه ، عن جده ، قال : انطلقت مع رسول الله [ صلى الله عليه وسلم ] عقبه إذ أخروا علي ريطة مضرجة ، فالتفت إلي رسول الله [ صلى الله عليه وسلم ] ، فقال : ما هذا الثوب ؟ فعرفت كراهيته ، فأتيت رحلي وهم يسجرون التنور ، فألقيتها فيه ، ثم أتيته ، فقال : ما فعلت الريطة ؟ فقلت : ألقيتها في التنور ، قال : أفلا أعطيتها بعض أهلك . PageV02P780(@)(@@) 1353 - حدثنا إسحاق بن سيار النصيبي ، قال : حدثنا عمرو بن عاصم الكلابي ، قال : حدثنا الربيع بن مسلم ، قال : حدثني أبو عمرو مولى أنس بن مالك ، قال : قال رسول الله [ صلى الله عليه وسلم ] : من كف غضبه كف الله جل ثناؤه عنه عذابه ، ومن خزن لسانه ستر الله عورته ، ومن اعتذر إلى الله قبل الله عذره .(@)(@@) 1354 - حدثنا أحمد بن حرب الطائي ، قال : حدثنا محمد بن ربيعة ، عن كلثوم بن زياد أبي عمرو ، قال : سألت الزهري عن رجل تزوج أمه ، ثم اشتراها على أي شيء تكون عليه ، قال : سرية ، بذلك قضى زيد بن ثابت .(@)(@@) 1355 - حدثنا 
ms396	 أبو داود سليمان بن سيف ، قال : حدثنا أبو عاصم ، عن كرز أبي عمرو قال : حدثني عطاء الخشك ، قال : كنا محتبسين في السجن ، فكنا نلعب الشطرنج ، وكان ابن سيرين يمر بنا فيقول : ادفع الفرس افعل كذا ، يعني : في الشطرنج .(@)(@@) 1356 - حدثنا عمرو بن علي ، قال : حدثنا عون بن عمرو أبو عمرو القيسي ، يعرف بعوين ، قال : حدثني أبو مصعب المكي ، قال : أدركت زيد بن أرقم ، والمغيرة بن شعبة ، وأنس بن مالك .(@)(@@) أخبرني عبد الله بن أحمد بن حنبل ، قال : [ سألت أبي عن هارون بن عنترة ، فقال : شيخ ثقة ، وهو هارون بن أبي وكيع ] ويكنى بأبى عمرو الشيباني .(@)(@@) وأخبرني عبد الله ، عن أبيه ، قال : حدثنا محمد بن مصعب PageV02P781 القرقساني ، قال : حدثنا أبو عمرو السبيعي ، قال أبي : وهو عيسى بن يونس .(@)(@@) حدثنا العباس بن محمد ، قال : حدثني يحيى بن معين ، قال : عثمان البتي أبو عمرو . وبشر بن حرب ، كنيته أبو عمرو الندبي ، يروي عنه : شعبة يكنيه ، يقول : حدثنا أبو عمرو الندبي .(@)(@@) 1340 - حدثنا العباس [ بن محمد ] ، قال : حدثنا يحيى بن معين ، قال : حدثنا الأصمعي ، قال : أخبرني أبو عمرو التغلبي ، عن يونس بن عبيد ، قال : كان يقال : لا يزال في الناس بقية ما إذا تلجلج في نفس الرجل شيء ، ووجد من يفرجه عنه .(@)(@@) قال يحيى [ بن بكير ] : وكنية الشعبي أبو عمرو ، واسمه عامر ( 2 / 45 ) ابن شراحيل .(@)(@@) حدثنا العباس ، قال : سمعت [ يحيى بن معين ] ، يقول : أبو عمرو القاص الذي يروي عنه سليمان التيمي ، هو والد أسباط بن محمد ، قال يحيى : وكان التيمي يقول : حدثني أبو عمرو ، وكان يقص .(@)(@@) وفي موضع آخر ، قال : سمعت يحيى يقول : أسباط بن محمد أبوه PageV02P782 يروي عنه سليمان التيمي ، يقول : أبو عمرو ، عن عكرمة ، وهو أبو عمرو القاص ، واسمه : محمد ، وهو أبو أسباط بن محمد ، [ و ] قد روى عنه أيضا ابن عيينة ، وابن فضيل(@)(@@) قال : وسمعت يحيى [ يقول ] : الأسود بن يزيد يكنى أبا عمرو .(@)(@@) 1358 - حدثني علي بن سعيد النسائي ، قال : حدثنا مسلم بن إبراهيم ، قال : حدثنا نوح بن قيس ، قال 
ms397	 : حدثنا عبد الرحمن أبو عمرو الحداني ، عن زياد النميري ، عن أنس بن مالك ، قال : قال رسول الله [ صلى الله عليه وسلم ] : من بنى لله جل ثناؤه مسجدا في الدنيا صغيرا أو كبيرا ، بنى الله له بيتا في الجنة .(@)(@@) 1359 - أخبرني محمد بن إبراهيم بن هاشم ، عن أبيه ، عن محمد بن عمر ، قال : الأسود بن يزيد عم علقمة بن قيس ، كنيته : أبو عمرو وكان عثمانيا ، استأذن عليا عند خروجه إلى صفين ، فخرج إلى الديلم ، وكان بعد مع مصعب بن الزبير ، فانتهى معه إلى با خمير بالأنبار ، ثم أحرم منها وانصرف إلى مكة ، وكان مصعب عسكر بباخمير ، يريد أن يقاتل عبد الملك ابن مروان .(@)(@@) 1360 - وأخبرني محمد بن إبراهيم بن هاشم ، عن أبيه ، عن محمد بن عمر ، قال : أبو عمرو الشيباني سعد بن إياس ، سمع من : عمر ، وعلي رضي الله عنهما ، وكان من أصحاب عبد الله ، وشهد مع علي مشاهده ، هلك في إمارة الوليد أو سليمان . PageV02P783(@)(@@) 1361 - [ أخبرني أحمد بن شعيب ، قال : أخبرنا بشر بن الحكم ، قال : حدثنا خالد بن يزيد الأزدي ، قال : حدثنا أبو عمرو الندبي بشر بن حرب ، قال : سألت رافع بن خديج ، عن كراء الأرض ، فقال : نهى رسول الله [ صلى الله عليه وسلم ] عن كراء الأرض .(@)(@@) 1362 - وأخبرني أحمد بن شعيب ، قال : أخبرنا إسحاق بن إبراهيم ، قال : أخبرنا المعتمر ، عن أبي عمرو بزيع ، وكان أحد الصالحين ، عن يزيد الرقاشي أنه كان إذا كتب ، كتب : أوصيك بتقوى الله ، قال : ومن تركها ، فقد ترك السنة .(@)(@@) أخبرني أحمد بن شعيب ، قال : أخبرنا العباس بن عبد العظيم ، عن علي ابن المديني ، عن يحيى بن آدم ، عن شريك ، قال : نبيح أبو عمرو ] .(@)(@@) أخبرني أحمد بن شعيب ، قال : أنبأ محمد بن معدان ، قال : حدثنا الحسين بن أعين ، قال : حدثنا زهير ، قال : حدثنا عبد الله ، وهو ابن خثيم ، قال : حدثني ابن أبي مليكة ، أنه حدثه ذكوان أبو عمرو ، حاجب عائشة .(@)(@@) 1363 - وأخبرني أحمد بن شعيب ، قال : أخبرنا الحسين بن منصور ، قال : حدثنا حفص بن عبد الله 
ms398	 ، قال : حدثنا ابن إسحاق ، عن أبي عمرو مولى المطلب ، [ و ] اسمه ميسرة ، قال : إني لجالس إلى جنب عبد الله بن عمر إلى حجرة عائشة ، وطارق بن عمر يخطب الناس ، إذ قرأ : @QB@ والنجم إذا هوى @QE@ فلما ختمها وقع عبد الله ساجدا ، وسجدنا ولم يتحرك طارق .(@)(@@) 1364 - أخبرني أحمد بن شعيب ، قال : أنبأنا علي بن حجر ، قال : PageV02P784 أنبأ مسلمة بن عمرو ، قال : شهدت مع عمير بن هانئ جنازة ، فلما دفن قلت : أشهد أنك كنت تحب الله ورسوله ، فقال لي عمير : أحسنت يا أبا عمرو اشهدوا لأخيكم بأحسن ما تعلمون منه ، فإن شهادتكم نافعة له .(@)(@@) 1365 - [ و ] قال : أنبأ العباس بن عبد العظيم ، قال : حدثنا عبد الملك ابن عمرو ، قال : حدثنا مبارك أبو عمرو ، قال : حدثنا مالك بن دينار ، عن عكرمة ، عن ابن عباس ، قال : من مات وفي يده ريح الفضيخ فضحه الله جل ثناؤه على رؤس الأشهاد يوم القيامة .(@)(@@) 1366 - أخبرني أحمد [ بن شعيب ] ، قال : حدثنا العباس بن عبد العظيم ، قال : حدثنا عثمان بن عمر ، قال : ثنا هلال أبو عمرو ، قال : حدثنا أبو بردة ، عن أبي موسى ، قال : من جاء بلا إله إلا الله وحده ، وأن محمدا عبده ورسوله دخل الجنة .(@)(@@) 1367 - أخبرنا أحمد بن شعيب ، قال : أنبأ عمر بن محمد ابن الحسن ، قال : حدثنا أبي ، قال : حدثنا عتبة أبو عمرو ، وهو ابن اليقظان ، عن الشعبي ، عن أنس ، قال : كنت مع رسول الله [ صلى الله عليه وسلم ] في سفر ، فقال : من يكلأنا ، فقلت : أنا فنام ونام الناس ونمت فلم أستيقظ إلا بحر الشمس ، فقال رسول الله [ صلى الله عليه وسلم ] : يا أيها الناس إن هذه الأرواح عارية في أجساد العباد ، فيقبضها إذا شاء ، ويرسلها إذا شاء ، PageV02P785 فاقضوا حوائجكم على رسلكم ، فقضينا حوائجنا ( 2 / 46 ) على رسلنا وتوضأنا وتوضأ النبي [ صلى الله عليه وسلم ] ، ثم صلى ركعتي الفجر قبل الصلاة ، ثم صلى بنا .(@)(@@) 1368 - وأخبرني أحمد ، قال : أخبرنا عقبة بن سيار ، قال : أنبأ عثمان بن عثمان أبو عمرو الغطفاني ، قال : حدثنا محمد بن 
ms399	 عمرو ، عن أبي سلمة ، عن أبي هريرة ، قال : جاء الحارث الغطفاني إلى رسول الله [ صلى الله عليه وسلم ] ، فقال لرسول الله [ صلى الله عليه وسلم ] : شاطرنا ثمر المدينة وإلا ملأتها عليك خيلا ورجالا وإبلا ، فقال رسول الله [ صلى الله عليه وسلم ] : حتى أستأمر السعود .(@)(@@) 1369 - أخبرني أحمد ، قال : أنبأ الجارود بن معاذ الترمذي ، قال : حدثنا سعيد بن يحيى أبو سفيان الواسطي ، قال : حدثنا عثمان بن عثمان أبو عمرو البصري ، قال : صلى أعرابي إلى جنب الحسن يوم الجمعة ، فزحم الأعرابي ، فقال : حبلتها تحطم والجئوهما ، فتبسم الحسن .(@)(@@) 1370 - أخبرني أحمد بن شعيب ، قال : أنبأ أحمد بن بكار ، قال : حدثنا أبو عمرو عثمان بن عمرو المديني ، عن زيد بن أسلم ، قال : سمعت عبد الله بن عمر قال : قال رسول الله [ صلى الله عليه وسلم ] : الناس كإبل مائة لا تكاد تجد منها راحلة . PageV02P786(@)(@@) 1371 - حدثني أبو جعفر أحمد بن يحيى الأودي ، قال : سمعت أبا نعيم ضرار بن صرد ، يقول : قال لي عثمان : يا أبا نعيم ! إن المأمون قد طلب رجلا جامعا لبعض ولده ، وفي هذا جبره الأهل والإخوان ، قال : قلت : ألهذا تعلمت العلم يا أبا عمرو ؟ فسكت . PageV02P787(@)(@@)(@@)(@@) ||| ( حرف النون في العين )(@)(@@)(@@)(@@) |||| ( أبو العنبس ، وأبو العنبر )(@)(@@)(@@)(@@) $ * أبو العنبس عبد الله بن عبد الله بن الأصم .(@)(@@)(@@)(@@) $ * وأبو العنبس عمرو بن مروان ، روى عنه : حفص بن غياث .(@)(@@)(@@)(@@) $ * وأبو العنبس حجر ، روى عنه : سلمة بن كهيل .(@)(@@)(@@)(@@) $ * وأبو العنبس الحارث ، روى عنه : مسعر بن كدام .(@)(@@)(@@)(@@) $ * وأبو العنبس سعيد بن كثير ، يروي عنه : عبيد الله بن موسى ، وأبو نعيم .(@)(@@)(@@)(@@) $ * وأبو العنبر غنيم بن قيس .(@)(@@) حدثنا محمد بن بشار ، قال : حدثنا يحيى بن سعيد ، ومحمد بن جعفر ، قالا : حدثنا شعبة ، عن سلمة بن كهيل ، عن حجر أبي العنبس .(@)(@@) حدثنا العباس بن محمد ، قال : سمعت يحيى [ بن معين ] ، يقول : أبو العنبس عمرو بن مروان ، روى عنه : وكيع .(@)(@@) وأبو العنبس سعيد بن كثير ، روى عنه : حفص بن غياث ، وأبو نعيم .(@)(@@) وأبو العنبس الذي يروي عنه : شعبة ، ومسعر ، لا أعرف اسمه .(@)(@@) وفي موضع آخر 
ms400	 : سمعت يحيى [ بن معين ] يقول : قد روى أبو عوانة PageV02P788 وشعبة ومسعر ، عن أبي العنبس ، وليس هو من أمر أبوي العنبس الصغيرين في شيء أحد ذينك ، يقال له : عمرو بن مروان ، يروي عنه : وكيع ، والآخر : سعيد بن كثير ، يروي عنه : حفص بن غياث ، وثلاثتهم كوفيون .(@)(@@) وأبو العنبس الذي يروي عنه يعلى بن عبيد وهو سعيد بن كثير .(@)(@@) حدثنا العباس بن محمد ، قال : سمعت يحيى بن معين ، يقول : غنيم بن قيس ، يقال له : أبو العنبر .(@)(@@) 1372 - حدثنا إبراهيم بن مرزوق ، قال : حدثنا عثمان بن [ عمر ] ابن فارس ، قال : حدثنا ثابت بن عمارة ، عن غنيم بن قيس ، قال : كان أبو موسى يقرئنا القرآن ، فقلنا له ذات يوم : أنتم اليوم عدة أصحاب طالوت يوم جالوت ، قال : قلنا : كم كنتم يا أبا العنبر ؟ قال : خمسين وثلاثمائة ( 2 / 47 ) . PageV02P789(@)(@@)(@@)(@@) ||| ( حرف الواو في العين )(@)(@@)(@@)(@@) |||| ( من كنيته أبو العوام )(@)(@@)(@@)(@@) $ * أبو العوام عمران بن داود القطان .(@)(@@)(@@)(@@) $ * وأبو العوام فائد بن كيسان [ الجزار الباهلي ] .(@)(@@)(@@)(@@) $ * وأبو العوام أمية بن حكيم العبدي .(@)(@@)(@@)(@@) $ * وأبو العوام عبد العزيز بن الربيع الباهلي ، يحدث عنه : النضر بن [ شميل ] .(@)(@@)(@@)(@@) $ * [ وأبو العوام جعفر بن ميمون ] .(@)(@@)(@@)(@@) $ * وأبو العوام شيبان بن زهير بن شقيق بن ثور ، عن عبد الرحمن بن أبي بكرة ، يحدث عنه : الحارث بن مرة .(@)(@@)(@@)(@@) $ * وأبو العوام [ حسان ] بن مخارق ، عن أم سلمة ، يحدث عنه : سليمان الشيباني .(@)(@@) حدثني صالح بن أحمد بن حنبل ، قال : سمعت علي بن المديني ، يقول : أبو العوام الجزار فائد بن كيسان ، مولى باهلة ، وأبو العوام القطان عمران بن داود .(@)(@@) حدثنا العباس [ بن محمد ] ، عن يحيى بن معين قال : أبو العوام PageV02P790 الباهلي ، هو شيخ ، يروي عنه : وكيع وغيره ، وليس هو عمران القطان ، هو عبد العزيز الباهلي .(@)(@@) 1373 - حدثنا محمد بن عبد الله بن يزيد ، قال : حدثنا سفيان ، عن ابن العجلان ، عن رجل ، يقال له : أبو العوام ، قال : سألوا ابن عمر عن رجل يعزب في إبله لا يكون معه ماء أيأتي أهله ؟ فقال له : [ أما ] ابن عمر فلم يكن يفعل ذلك ، وأما أنت فاتق الله ، فإذا 