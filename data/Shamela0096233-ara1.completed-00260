ms241	 عنه عبد الصمد الطستي.(@)(@@)(@@)(@@) $ 4 - ومقاتل بن صالح بن مازنة، أبو عمرو المروزي.(@)(@@) حدث ببغداد عن محمد بن نصر بن العباس المروزي. روى عنه عيسى بن حامد بن القنبيطي.(@)(@@)(@@)(@@) || مفضل بن فضالة، ثلاثة(@)(@@) (1):(@)(@@)(@@)(@@) $ 1 - أحدهم بصري، يكنى أبا مالك وهو أخو المبارك بن فضالة بن أبي أمية.(@)(@@) حدث عن: يزيد بن أبي زياد، وحبيب بن الشهيد، وعاصم بن بهدلة وغيرهم. PageV02P255(@)(@@) روى عنه: حماد بن زيد، وسلم بن قتيبة، وعبد الرحمن بن مهدي، ويونس بن محمد، ونصر بن حماد الوراق، وموسى بن إسماعيل [123 - ب] التبوذكي.(@)(@@)(@@)(@@) $ 2 - ومفضل بن فضالة، أبو معاوية القتباني المصري، قاضيها.(@)(@@) حدث عن: يزيد بن أبي حبيب، وربيعة بن سيف، وعياش بن عباس، وعقيل بن خالد، ويونس بن يزيد، وغيرهم.(@)(@@) روى عنه: يحيى بن غيلان البغدادي، ويحيى بن بكير، والنضر بن عبد الجبار، وعبد الرحمن بن أبي الغمر المصريون، ويزيد بن خالد الرملي، وعبد الأعلى بن حماد النرسي، وقتيبة بن سعيد، وزكريا بن يحيى كاتب العمري.(@)(@@) قال الخطيب: أنا علي بن طلحة المقرئ: أنا محمد بن إبراهيم الغازي: أنا محمد بن محمد بن داود الكرجي: ثنا عبد الرحمن بن يوسف بن خراش، قال مفضل بن فضالة القتباني، من أهل مصر، صدوق في الحديث.(@)(@@)(@@)(@@) $ 3 - ومفضل بن فضالة، أبو الحسن النسوي.(@)(@@) حدث عن: إبراهيم بن الهيثم البلدي، ويحيى بن أكثم.(@)(@@) روى عنه عبد الله بن عدي الجرجاني.(@)(@@)(@@)(@@) || المفضل بن محمد، ثلاثة(@)(@@) (1):(@)(@@) منهم:(@)(@@)(@@)(@@) $ 1 - المفضل بن محمد الهمداني. PageV02P256(@)(@@) حدث عن أبي أمامة الباهلي. روى عنه سوار بن مصعب الكوفي.(@)(@@)(@@)(@@) $ 2 - والمفضل بن محمد بن يعلى الضبي.(@)(@@) حدث عن: أبي رجاء العطاردي، وعاصم بن بهدلة، وإبراهيم بن مهاجر، ومغيرة بن مقسم، ومجاهد بن رومي، وسليمان الأعمش.(@)(@@) روى عنه: أبو زيد النحوي، وأبو الحسن المدائني، وأبو كامل الجحدري، وغيرهم.(@)(@@)(@@)(@@) $ 3 - والمفضل بن محمد بن إبراهيم، أبو سعيد الجندي، وجده إبراهيم هو ابن مفضل بن سعيد بن عامر الشعبي.(@)(@@) حدث عن أبي حمة محمد بن يوسف اليماني، ومحمد بن ميمون بن الخياط 
ms242	 المكي، وصامت بن معاذ الجندي.(@)(@@) روى عنه: محمد بن عبد الله الصفار الأصبهاني، وجعفر الخلدي، وأبو سليمان الحراني، وأبو بكر محمد بن الحسين الآجري، وأبو محمد بن السقا الواسطي وغيرهم.(@)(@@)(@@)(@@) || معلى بن عبد الرحمن، اثنان(@)(@@) (1):(@)(@@)(@@)(@@) $ 1 - أحدهما واسطي.(@)(@@) حدث عن: سفيان الثوري، وشريك القاضي.(@)(@@) روى عنه: الدقيقي محمد بن عبد الملك، وخلف بن محمد بن [124 - أ] عيسى المعروف بكردوس. PageV02P257(@)(@@) والآخر:(@)(@@)(@@)(@@) $ 2 - معلى بن عبد الرحمن بن حميد، أظنه واسطيا أيضا.(@)(@@) حدث عن الحسين بن زياد الطويل. روى عنه أحمد بن كعب الواسطي.(@)(@@)(@@)(@@) || معلى بن الفضل، اثنان(@)(@@) (1):(@)(@@)(@@)(@@) $ 1 - أحدهما: بصري، يكنى أبا الحسن.(@)(@@) حدث عن: شعبة، والثوري، ومالك بن أنس، وأبي بكر الهذلي، ومسلم بن خالد، وعبد الله بن المبارك.(@)(@@) روى عنه: هارون بن سليمان، وأحمد بن عصام الأصبهانيان، وأبو العباس الكديمي.(@)(@@) والآخر:(@)(@@)(@@)(@@) $ 2 - معلى بن الفضل بن حسان.(@)(@@) حدث عن أحمد بن محمد بن يحيى بن حمزة الدمشقي. روى عنه محمد بن محمد بن سليمان الباغندي.(@)(@@)(@@)(@@) || مطرف بن عبد الله، أربعة(@)(@@) (2):(@)(@@) منهم:(@)(@@)(@@)(@@) $ 1 - مطرف بن عبد الله بن الشخير، أبو عبد الله العامري البصري. PageV02P258(@)(@@) حدث عن: أبيه، وعن عثمان بن عفان، وعلي بن أبي طالب، وعمران بن حصين.(@)(@@) روى عنه: قتادة، وثابت البناني، وسعيد بن أبي هند، وأبو سلمة سعيد بن يزيد، وغيلان بن جرير.(@)(@@)(@@)(@@) $ 2 - ومطرف بن عبد الله الكعبي.(@)(@@) حدث عن عكرمة مولى ابن عباس. روى عنه عبد الرحمن بن عمرو بن جبلة البصري.(@)(@@)(@@)(@@) $ 3 - ومطرف بن عبد الله بن مطرف بن مسلم بن يسار، مولى ميمونة زوج النبي صلى الله عليه وسلم، مديني، يكنى أبا مصعب.(@)(@@) سمع: مالك بن أنس، وعبد الرحمن بن أبي الزناد، وعبد الرحمن بن أبي الموالي، وعبد الله بن عمر العمري، وعبد الرحمن بن سعيد الديلي.(@)(@@) روى عنه: محمد بن يحيى الذهلي، ومحمد بن إسماعيل البخاري، وأبو زرعة، وأبو حاتم الرازيان، ويعقوب بن سفيان، وعيسى بن عبد الله الطيالسي، وبشر بن موسى الأسدي.(@)(@@)(@@)(@@) $ 4 - ومطرف بن عبد الله النيسابوري.(@)(@@) حدث عن عبد 
ms243	 الله بن المبارك، وسلم بن سالم البلخي.(@)(@@) روى عنه: أحمد بن حرب الزاهد، وأحمد بن حفص السلمي، وأيوب بن الحسن النيسابوريون.(@)(@@) PageV02P259(@)(@@)(@@)(@@) || معاوية بن عمرو، خمسة(@)(@@) (1):(@)(@@) منهم:(@)(@@)(@@)(@@) $ 1 - أبو المهلب معاوية بن عمرو الجرمي [124 - ب] البصري، عم أبي قلابة، وقيل: إن اسم أبي المهلب عبد الرحمن بن عمرو، وقيل: النضر بن عمرو، ومعاوية أصح.(@)(@@) حدث عن: عمر بن الخطاب، وعثمان بن عفان، وأبي بن كعب، وعمران بن حصين.(@)(@@) روى عنه: الحسن، ومحمد بن سيرين، وأبو قلابة، وعوف الأعرابي.(@)(@@)(@@)(@@) $ 2 - ومعاوية بن عمرو بن غلاب، جد المفضل بن غسان الغلابي، وهو ابن أخي الحكم بن الأعرج، من أهل البصرة.(@)(@@) حدث عن عمه. روى عنه: حماد بن سلمة، ويحيى بن سعيد القطان.(@)(@@) قال الخطيب: أنا الحسن بن أبي بكر: أنا عبد الصمد بن علي الطستي: ثنا محمد بن غالب: حدثنا غسان بن المفضل: ثنا معاوية بن عبد الكريم الضال، قال: ما رأيت أعرابيا بالبصرة شريفا أفضل من معاوية بن عمرو بن غلاب.(@)(@@)(@@)(@@) $ 3 - ومعاوية بن عمرو العاجي البصري.(@)(@@) حدث عن: طلحة بن زيد الرقي، وسفيان بن عيينة.(@)(@@) روى عنه: يعقوب بن سفيان، وأبو العباس الكديمي، وذكر أبو حاتم الرازي أنه كتب عنه فأخذ كتابه عمرو بن علي فخط عليه؛ لأنه لم يكن PageV02P260(@)(@@) عنده بصدوق.(@)(@@)(@@)(@@) $ 4 - ومعاوية بن عمرو بن المهلب، أبو عمرو الأزدي، من أنفسهم بغدادي.(@)(@@) سمع: زائدة بن قدامة، والمسعودي، وزهير بن معاوية، وأبا إسحاق الفزاري.(@)(@@) روى عنه: محمد بن إسحاق الصغاني، وأبو زرعة، وأبو حاتم الرازيان، والحسن بن مكرم، والحارث بن أبي أسامة، ومحمد بن أحمد بن النضر، وكان ثقة ثبتا.(@)(@@)(@@)(@@) $ 5 - ومعاوية بن عمرو بن وهب الجرمي البصري.(@)(@@) حدث عن أنيس بن سوار.(@)(@@) روى عنه جعفر بن أحمد بن محمد بن الصباح الجرجاني.(@)(@@)(@@)(@@) || مجمع بن جارية، اثنان </span>(1):(@)(@@) أحدهما له صحبة، وهو:(@)(@@)(@@)(@@) $ 1 - مجمع بن جارية بن عامر بن مجمع بن العطاف الأنصاري الأوسي، أخو يزيد بن جارية.(@)(@@) روى عنه ابن أخيه عبد الرحمن بن يزيد.(@)(@@) والآخر: PageV02P261(@)(@@)(@@)(@@) $ 2 - مجمع 
ms244	 بن جارية.(@)(@@) حدث عن رجل، عن ابن عمر. روى عنه حفص بن غياث.(@)(@@) قال الخطيب: أنا الحسن بن أبي بكر أنا عبد الله بن [125 - أ] إسحاق البغوي: أنا علي بن عبد العزيز: ثنا أبو عبيد، قال: ثنا حفص بن غياث، عن مجمع بن جارية،(@)(@@) عن فلان، عن ابن عمر، قال: من أدى الزكاة، وقرى الضيف، وأعطى في النائبة فقد برئ من الشح.(@)(@@) قال الخطيب: وقال البخاري في «تاريخه» مجمع بن يحيى بن زيد بن جارية الأنصاري، سمع أبا أمامة بن سهل بن حنيف، وخالد بن زيد.(@)(@@) روى عنه: وكيع، وابن عيينة، ويعلى، ومحمد.(@)(@@) قال الخطيب: فلعله هذا، روى عنه حفص بن غياث، ونسبه إلى جده والله أعلم.(@)(@@)(@@)(@@) || منهال بن عمرو، اثنان(@)(@@) (1):(@)(@@)(@@)(@@) $ 1 - أحدهما الأسدي الكوفي.(@)(@@) حدث عن: سعيد بن جبير، وزر بن حبيش، وعبد الرحمن بن أبي ليلى، وقيس بن السكن، وعباد بن عبد الله.(@)(@@) روى عنه: منصور بن المعتمر، والأعمش، وميسرة بن حبيب، وحجاج بن أرطأة، وأبو خالد الدالاني، والقاسم بن الوليد الهمداني، ومحمد بن عبد الرحمن بن أبي ليلى، وغيرهم. PageV02P262(@)(@@) والآخر:(@)(@@)(@@)(@@) $ 2 - منهال بن عمرو بن سلام القشيري البصري.(@)(@@) حدث عن: عبد الله بن عون، وشعبة.(@)(@@) روى عنه: محمد بن سعد كاتب الواقدي، والحسن بن مكرم البغداديان.(@)(@@)(@@)(@@) || مخلد بن مالك، اثنان(@)(@@) (1):(@)(@@) أحدهما:(@)(@@)(@@)(@@) $ 1 - أبو جعفر الجمال الرازي، سكن نيسابور، وحدث بها عن عبد العزيز الدراوردي، وسفيان بن عيينة، ويحيى بن سعيد القطان، وعبد الرحمن بن مهدي، ووكيع، وأبي أسامة، وعبد الله بن نمير، وعبدان بن عثمان، والوليد بن مسلم.(@)(@@) روى عنه: محمد بن إسماعيل البخاري، ومسلم بن الحجاج، ومحمد بن عبد الوهاب الفراء، والحسن بن سفيان وغيرهم.(@)(@@) ومات مخلد بنيسابور في سنة إحدى وأربعين ومائتين.(@)(@@)(@@)(@@) $ 2 - ومخلد بن مالك بن جابر بن شيبان، أبو محمد القرشي، وقيل: السكسكي الحراني.(@)(@@) حدث عن: حفص بن ميسرة، وعطاف بن خالد، ومحمد بن سلمة، وعثمان بن عبد الرحمن الطرائفي، وأبي خالد الأحمر.(@)(@@) روى عنه: أبو زرعة الرازي، وإبراهيم بن يوسف الهسنجاني، 
ms245	 ويعقوب بن سفيان، وأبو عروبة الحراني [125 - ب]. PageV02P263(@)(@@) قال الخطيب: أنا أبو الحسن أحمد بن علي بن البادا، وأبو بكر البرقاني، وإسحاق بن مخلد الفارسي، وأبو القاسم التنوخي، قالوا: ثنا محمد بن عبد الله الأبهري: أنا أبو عروبة الحراني الحسين بن محمد بن مودود، قال: مخلد بن مالك أبو محمد كان يسكن سلمسين قرية إلى جانب حران، وقد رأيته وسمعت منه، مات في سنة اثنتين وأربعين في جمادى الآخرة.(@)(@@)(@@)(@@) || المثنى بن سعيد، اثنان(@)(@@) (1):(@)(@@) بصريان، أحدهما:(@)(@@)(@@)(@@) $ 1 - أبو غفار الطائي. حدث عن: أبي عثمان النهدي، وأبي قلابة الجرمي، وأبي تميمة الهجيمي، وأبي الشعثاء، مولى ابن معمر.(@)(@@) روى عنه: حماد بن زيد، وعيسى بن يونس، وأبو خالد الأحمر، ويحيى بن سعيد القطان، وسهل بن يوسف.(@)(@@) قال الخطيب: أنا محمد بن عبد الواحد الأكبر: أنا محمد بن العباس: ثنا ابن مرابا: ثنا عباس بن محمد، قال: سمعت يحيى بن معين يقول: أبو غفار الطائي بصري اسمه المثنى بن سعيد، يحدث عنه يحيى، وقال يحيى: المثنى بن سعيد ثقة.(@)(@@) والآخر:(@)(@@)(@@)(@@) $ 2 - أبو سعيد الضبي القسام.(@)(@@) رأى أنس بن مالك، وأبا مجلز، وسمع قتادة، وأبا سفيان طلحة بن نافع. PageV02P264(@)(@@) روى عنه: يزيد بن زريع، وعبد الرحمن بن مهدي، وأبو داود الطيالسي، ومسلم بن إبراهيم، وعمرو بن حكام.(@)(@@) قال الخطيب: أنا أبو طاهر حمزة بن محمد بن طاهر، وأبو عبد الله محمد بن عبد الواحد، قال حمزة: ثنا، وقال محمد: أنا الوليد بن بكر: ثنا علي بن أحمد بن زكريا: ثنا أبو مسلم صالح بن أحمد بن عبد الله العجلي: حدثني أبي قال: المثنى بن سعيد الضبعي بصري ثقة.(@)(@@)(@@)(@@) || معاذ بن معاذ، ثلاثة(@)(@@) (1):(@)(@@) بصريون، أحدهم:(@)(@@)(@@)(@@) $ 1 - أبو المثنى معاذ بن معاذ بن نصر بن حسان العنبري، قاضي البصرة.(@)(@@) سمع: سليمان التيمي، وعبد الله بن عون، وعمران بن حدير، وشعبة، وسعيد بن أبي عروبة، وقرة بن خالد.(@)(@@) روى عنه: علي بن المديني، وعمرو بن علي، وبندار بن بشار، ومحمد بن المثنى، وابناه عبيد الله والمثنى ابنا معاذ 
ms246	 [126 - أ]، وأبو بكر وعثمان ابنا أبي شيبة، وسعدان بن نصر، وغيرهم.(@)(@@)(@@)(@@) $ 2 - ومعاذ بن معاذ بن صقير، أبو صقير القرشي.(@)(@@) حدث عن البراء بن يزيد الغنوي. روى عنه أبو العباس الكديمي.(@)(@@)(@@)(@@) $ 3 - (ومعاذ بن معاذ أخي خلاد الأعمى.(@)(@@) حدث عن بزيع أبي الخليل. روى عنه أبو خليفة الفضل بن الحباب PageV02P265(@)(@@) الجمحي) (1).(@)(@@)(@@)(@@) || معن بن عيسى، اثنان(@)(@@) (2):(@)(@@) أحدهما:(@)(@@)(@@)(@@) $ 1 - أبو يحيى معن بن عيسى بن يحيى بن دينار الأشجعي مولاهم، من أهل المدينة.(@)(@@) سمع: مالك بن أنس، وابن أبي ذئب، ومخرمة بن بكير، ومعاوية بن صالح، ومحمد بن هلال.(@)(@@) روى عنه: الحميدي، وإبراهيم بن المنذر، وأحمد بن حنبل، وعلي بن المديني، ومحمد بن عبد الله بن نمير، وأبو بكر بن أبي شيبة، ونصر بن علي، وإسحاق بن موسى الأنصاري، وإسحاق بن البهلول التنوخي.(@)(@@) والآخر:(@)(@@)(@@)(@@) $ 2 - معن بن عيسى، أبو سعيد البجلي النهاوندي.(@)(@@) صاحب أخبار وحكايات.(@)(@@)(@@)(@@) || مزاحم بن زفر، اثنان(@)(@@) (3):(@)(@@) كوفيان:(@)(@@) حدث عن أحدهما سفيان الثوري، وحدث الآخر عن سفيان.(@)(@@)(@@)(@@) $ 1 - فأما الأول: فيروي عن مجاهد بن جبر، والقاسم بن عبد الرحمن بن عبد الله PageV02P266(@)(@@) بن مسعود.(@)(@@) وشارك الثوري في الرواية عنه عبد الله بن جعفر الزهري، وعبد الرحمن بن عبد الله المسعودي.(@)(@@)(@@)(@@) $ 2 - وأما الآخر: فيروي عنه أبو مسهر الدمشقي، وأبو الربيع الزهراني البصري، وضرار بن صرد الكوفي.(@)(@@) قال الخطيب: وحدث مزاحم هذا أيضا عن جرير بن حازم البصري.(@)(@@)(@@)(@@) || محمود بن الربيع، اثنان(@)(@@) (1):(@)(@@)(@@)(@@) $ 1 - أحدهما أنصاري خزرجي.(@)(@@) أدرك رسول الله صلى الله عليه وسلم، وهو طفل صغير، ورآه وحكى عنه، حدث عنه ابن شهاب، ومكحول، ورجاء بن حيوة، وعبد الله بن عمرو بن الحارث.(@)(@@) والآخر:(@)(@@)(@@)(@@) $ 2 - محمود بن الربيع، أبو علي الجرجاني، صاحب إبراهيم بن أدهم.(@)(@@) حدث عن سفيان الثوري. روى عنه عبد الرحمن بن الفتح [126 - ب] البيروتي. PageV02P267(@)(@@)(@@)(@@) || مسعود بن مالك، اثنان(@)(@@) (1):(@)(@@) كوفيان.(@)(@@) حدث عنهما: سليمان الأعمش، أحدهما:(@)(@@)(@@)(@@) $ 1 - يكنى أبا رزين مولى أبي وائل شقيق بن سلمة، ويقال: مولى زر بن حبيش.(@)(@@) حدث عن: علي بن أبي طالب، وعبد 
ms247	 الله بن مسعود، وأبي هريرة، وابن عباس.(@)(@@) وروى عنه سوى الأعمش: منصور بن المعتمر، وإسماعيل بن أبي خالد، وابنه عبد الله بن أبي رزين، وعاصم بن بهدلة، وقل ما سماه أحد في الرواية عنه وإنما يكنيه.(@)(@@) قال الخطيب: أنا عبد الله بن يحيى بن عبد الجبار السكري: أنا أبو بكر الشافعي: ثنا جعفر بن محمد الأزهر: ثنا ابن الغلابي، قال: قال يحيى بن معين: كان أبو رزين مولى أبي وائل، وكان يبيع السويق، وقد سمع من عبد الله بن معسود.(@)(@@) قال الخطيب: أنا أبو حازم عمر بن أحمد العبدوي (2): نا محمد بن عبد الله الجوزقي، قال: أنا مكي بن عبدان، قال: سمعت مسلم بن الحجاج يقول: أبو رزين مسعود بن مالك الأسدي، سمع أبا هريرة. روى عنه الأعمش، ومنصور. PageV02P268(@)(@@) والآخر:(@)(@@)(@@)(@@) $ 2 - مسعود بن مالك بن معبد، مولى سعيد بن جبير.(@)(@@) حدث عن سعيد بن جبير، وشارك الأعمش في الرواية عنه سفيان الثوري.(@)(@@) قال الخطيب: أنا أبو بكر البرقاني، قال: قرأت على أبي محمد عبد الله بن محمد بن زياد حدثكم عبد الله بن محمد بن شيرويه: ثنا إسحاق: أنا أبو معاوية: ثنا الأعمش، عن مسعود بن مالك، عن سعيد بن جبير، عن ابن عباس، عن رسول الله صلى الله عليه وسلم قال: «نصرت بالصبا وأهلكت عاد بالدبور».(@)(@@) قال الخطيب: قال لنا أبو بكر البرقاني ومسعود بن مالك هذا ليس بمسعود بن مالك أبي رزين، أبو رزين يروي عن علي وابن مسعود، وأبي هريرة، وهو مولى أبي وسائل، أسدي.(@)(@@) قال البخاري في «تاريخه»: أبو رزين أكبر من أبي وائل.(@)(@@) وقد قيل: إن راوي هذا الحديث هو أبو رزين وهذا خطأ من قائله، دليل ذلك أن الثوري يرويه عن مسعود [127 - أ] بن مالك هذا كما رواه الأعمش عنه، فكيف يكون الثوري مدركا لمن هو أكبر من أبي وائل، أو لمن يروي عن علي وابن مسعود، وأبي هريرة وإنما اشتبه على قائل هذا أن كليهما مسعود بن مالك، ويروي عن كل واحد 
ms248	 منهما الأعمش، وقيل: إن راوي هذا الحديث مسعود بن مالك بن معبد، وأنه مولى لسعيد بن جبير. روى عنه: الأعمش، وسفيان الثوري، وصالح بن حيان.(@)(@@) PageV02P269(@)(@@) قال الخطيب: هذا كله كلام البرقاني.(@)(@@)(@@)(@@) || المعافى بن عمران، اثنان(@)(@@) (1):(@)(@@) أحدهما:(@)(@@)(@@)(@@) $ 1 - أبو مسعود المعافى بن عمران بن نفيل بن جابر بن جبلة بن عبيد بن لبيد (2) الأزدي.(@)(@@) فقيه أهل الموصل وزاهدهم، رحل في طلب العلم إلى الآفاق البعيدة، وجالس العلماء، ولزم سفيان الثوري، فتفقه به وتأدب بآدابه، وأكثر الكتاب عنه.(@)(@@) وحدث عن: مغيرة بن زياد الموصلي، وابن جريج المكي، وأفلح بن حميد ومالك بن أنس، وهشام بن سعد، وابن أبي ذئب، وعثمان بن الأسود، وخالد بن دينار، وأبي عمرو الأوزاعي، وجعفر بن برقان، ومسعر بن كدام.(@)(@@) روى عنه: ابنه عبد الكبير، ووكيع، وأحمد بن يونس، ومحمد بن جعفر الوركاني، وعيسى بن إبراهيم المزكي، وموسى بن مروان الرقي، وعبد الوهاب بن فليح المكي، وغيرهم.(@)(@@) والآخر:(@)(@@)(@@)(@@) $ 2 - المعافى بن عمران الظهري الحمصي، وظهر قبيل من حمير.(@)(@@) حدث عن: مالك بن أنس، وعبد الله بن لهيعة، وإسماعيل بن عياش. PageV02P270(@)(@@) روى عنه: يزيد بن عبد الله الزبيدي، وأبو تقي هشام بن عبد الملك اليزني، وعيسى بن براد الحمصيون.(@)(@@)(@@)(@@) || مالك بن أنس، اثنان(@)(@@) (1):(@)(@@) أحدهما:(@)(@@)(@@)(@@) $ 1 - مالك بن أنس بن مالك بن أبي عامر، أبو عبد الله الأصبحي، إمام أهل المدينة في الفقه.(@)(@@) سمع ابن شهاب، وعبد الله بن دينار مولى ابن عمر، ونافعا مولى ابن عمر، ومحمد بن المنكدر، وأبا الزبير المكي، وعبد الرحمن بن القاسم، وربيعة بن أبي عبد الرحمن، وأبا الزناد [127 - ب]، وهشام بن عروة، وخلقا يتسع ذكرهم.(@)(@@) روى عنه: يحيى بن سعيد الأنصاري، ويزيد بن الهاد، وسفيان الثوري، وشعبة، ويحيى القطان، وعبد الرحمن بن مهدي، وسفيان بن عيينة، وعبد الله بن المبارك، ومعن بن عيسى، وعبد الله بن وهب، وجماعة كثيرة غيرهم، وحديثه كثير في كتابه «الموطأ» وفي غيره.(@)(@@) والآخر:(@)(@@)(@@)(@@) $ 2 - مالك بن أنس الكوفي.(@)(@@) يروي عنه حديث واحد عن هانئ بن حزام، وقيل: حرام. 
ms249	 ورواه سفيان الثوري عن مغيرة بن النعمان النخعي، عن مالك، وقد وهم بعض أهل العلم فأدخل حديثه في حديث مالك بن أنس الفقيه. PageV02P271(@)(@@)(@@)(@@) || مروان بن الحكم، اثنان(@)(@@) (1):(@)(@@) أحدهما:(@)(@@)(@@)(@@) $ 1 - أبو عبد الملك بن مروان بن الحكم بن أبي العاص بن أمية بن عبد شمس بن عبد مناف، أبو الخلفاء، من بني مروان.(@)(@@) سمع: عمر بن الخطاب، وعثمان بن عفان، وعلي بن أبي طالب، وزيد بن ثابت.(@)(@@) روى عنه: سهل بن سعد، وعلي بن الحسين بن علي، وعروة بن الزبير، وعبيد الله بن عبد الله بن عتبة.(@)(@@) والآخر:(@)(@@)(@@)(@@) $ 2 - مروان بن الحكم الحراني.(@)(@@) حدث عن: يحيى بن عبد الله البابلتي، وأبي جعفر النفيلي.(@)(@@) روى عنه: محمد بن جرير الطبري.(@)(@@)(@@)(@@) || مرثد بن عبد الله، اثنان(@)(@@) (2):(@)(@@) أحدهما:(@)(@@)(@@)(@@) $ 1 - أبو الخير اليزني المصري.(@)(@@) حدث عن: عبد الله بن عمرو بن العاص، وعقبة بن عامر، وأبي بصرة PageV02P272(@)(@@) الغفاري. روى عنه يزيد بن أبي حبيب.(@)(@@)(@@)(@@) $ 2 - ومرثد بن عبد الله.(@)(@@) شيخ آخر ذكر في «تاريخ المراوزة». روى عنه أبو تميلة.(@)(@@) PageV02P273(@)(@@)(@@)(@@) | باب النون(@)(@@)(@@)(@@) || نصر بن علي، اثنان(@)(@@) (1):(@)(@@) أحدهما:(@)(@@)(@@)(@@) $ 1 - نصر بن علي الجهضمي البصري.(@)(@@) حدث عن: النضر بن شيبان، وأشعث بن جابر الحدانيين.(@)(@@) روى عنه: عبد الصمد بن عبد الوارث، وأبو نعيم الفضل بن دكين، ونوح بن قيس.(@)(@@) والآخر:(@)(@@)(@@)(@@) $ 2 - نصر بن علي بن نصر بن علي، أبو عمرو الجهضمي.(@)(@@) وهو ابن ابن الذي ذكرته آنفا [128 - أ]. حدث عن أبيه، وعن عبد العزيز بن محمد الدراوردي، وسفيان بن عيينة، ومعتمر بن سليمان، ويزيد بن زريع، وإسماعيل بن علية، وعبد الوهاب الثقفي، ويحيى بن سعيد القطان، وعبد الرحمن بن مهدي، ومحمد بن جعفر غندر.(@)(@@) روى عنه: محمد بن يحيى الذهلي، ومحمد بن إسماعيل البخاري، PageV02P274(@)(@@) وأبو زرعة، وأبو حاتم الرازيان، وإسماعيل بن إسحاق القاضي، وأبو داود السجستاني، وأبو عبد الرحمن النسوي، ومحمد بن إسحاق بن خزيمة، وزكريا بن يحيى الساجي، وأبو بكر بن أبي داود، ويحيى بن صاعد، وغيرهم.(@)(@@)(@@)(@@) || نصر بن المغيرة، اثنان(@)(@@) (1):(@)(@@) من أهل بخارا، أحدهما:(@)(@@)(@@)(@@) $ 1 
ms250	 - يكنى أبا الفتح.(@)(@@) حدث عن: جرير بن حازم، ومسلم بن خالد، وسفيان بن عيينة، وحاتم بن وردان.(@)(@@) روى عنه: أحمد بن أبي خيثمة، وأحمد بن سعيد الجمال، وعباس بن محمد الدوري، وغيرهم.(@)(@@) والآخر:(@)(@@)(@@)(@@) $ 2 - نصر بن المغيرة بن سليمان، أبو السري النجار.(@)(@@) حدث عن: علي بن جرير، وشداد بن حكيم، وحماد بن قيس، وخلف بن أيوب، وعيسى بن موسى غنجار.(@)(@@) روى عنه: موسى بن أفلح، وسيف بن حفص، وعمر بن هناد البخاريون. PageV02P275(@)(@@)(@@)(@@) || النضر بن سلمة، خمسة(@)(@@) (1):(@)(@@) منهم:(@)(@@)(@@)(@@) $ 1 - النضر بن سلمة المروزي، يلقب شاذان.(@)(@@) سكن مكة، وحدث عن إبراهيم بن خثيم بن عراك، وعبد الله بن نافع، ويحيى بن إبراهيم بن أبي قتيلة، وإسحاق بن محمد الفروي.(@)(@@) روى عنه: محمد بن مسلم بن وارة الرازي، وأحمد بن محمد بن يحيى الواسطي، ومحمد بن محمد الباغندي، وغيرهم.(@)(@@)(@@)(@@) $ 2 - والنضر بن سلمة بن عروة، أبو سعيد النيسابوري.(@)(@@) سمع: حفص بن عبد الرحمن، وحفص بن عبد الله، وعلي بن الحسن بن شقيق، وعبيد الله بن موسى، وأبا نعيم، وأبا غسان، وإسماعيل بن أبي أويس.(@)(@@) روى عنه: أبو بكر بن خزيمة، وأبو عمرو أحمد بن محمد الحيري، وأبو حامد الشرقي، ومكي بن عبدان النيسابوريان، وغيرهم.(@)(@@)(@@)(@@) $ 3 - والنضر بن سلمة بن الجارود بن يزيد [128 - ب]، والد أبي بكر محمد بن النضر الجارودي الحافظ النيسابوري.(@)(@@) حدث عن: جده الجارود، وعن يحيى بن يحيى التميمي، وأبي الوليد الطيالسي، ويحيى بن معين.(@)(@@) روى عنه: أبو أحمد البربري البغدادي، وغير واحد من أهل بلده. PageV02P276(@)(@@)(@@)(@@) $ 4 - والنضر بن سلمة المؤدب النيسابوري.(@)(@@) حدث عن: عبدان بن عثمان، ومصعب بن خارجة بن مصعب.(@)(@@) روى عنه محمد بن سليمان بن منصور المذكر.(@)(@@)(@@)(@@) $ 5 - والنضر بن سلمة بن عبد الله، أبو سلمة التميمي اللغوي النيسابوري.(@)(@@) حدث عن أحمد بن سعيد الدارمي. روى عنه أبو سهل محمد بن سليمان الصعلوكي وغيره.(@)(@@)(@@)(@@) || النعمان بن المنذر، اثنان(@)(@@) (1):(@)(@@)(@@)(@@) $ 1 - أحدهما البارقي الكوفي.(@)(@@) حدث عن علي بن أبي طالب. روى عنه دثار الضبي.(@)(@@) والآخر:(@)(@@)(@@)(@@) $ 2 - النعمان بن المنذر 
ms251	 اللخمي الشامي.(@)(@@) حدث عن: سالم بن عبد الله بن عمر، وعطاء، ويحيى بن الحارث، ومكحول، والزهري، وسليمان بن موسى.(@)(@@) روى عنه: الهيثم بن حميد، ومحمد بن الوليد الزبيدي، ويحيى بن حمزة الحضرمي، ومروان بن ثوبان الحمصي. PageV02P277(@)(@@)(@@)(@@) || نصير بن أبي نصير، اثنان(@)(@@) (1):(@)(@@) أحدهما:(@)(@@)(@@)(@@) $ 1 - حدث عن إسماعيل بن عبد الرحمن السدي. روى عنه عيسى بن يونس.(@)(@@) قال الخطيب: أنا محمد بن عبد الواحد الأكبر: أنا محمد بن العباس: أنا ابن مرابا: ثنا عباس بن محمد، قال: سألت يحيى بن معين عن شيخ يروي عنه عيسى بن يونس يقال له نصير بن أبي نصير فقال: هو كوفي.(@)(@@) والآخر:(@)(@@)(@@)(@@) $ 2 - نصير بن أبي نصير، أبو المنذر المقرئ، وهو نصير بن يوسف الرازي.(@)(@@) حدث عن علي بن حمزة الكسائي. روى عنه: أحمد بن محمد بن رستم الطبري، وعلي بن أبي نصر النحوي. PageV02P278(@)(@@)(@@)(@@) | باب الواو(@)(@@)(@@)(@@) || الوليد بن مسلم، ثلاثة(@)(@@) (1):(@)(@@) منهم:(@)(@@)(@@)(@@) $ 1 - الوليد بن مسلم بن شهاب، أبو بشر العنبري.(@)(@@) يعد في البصريين، حدث عن: جندب بن عبد الله، وحمران مولى عثمان بن عفان، وأبي الصديق الناجي، وحصين بن أبي الحر.(@)(@@) روى عنه: يونس بن عبيد، وأبو بشر جعفر بن [129 - أ] إياس، ومحمد بن عبد الله بن أبي يعقوب، وخالد الحذاء، وسعيد بن أبي عروبة، ومنصور بن زاذان، وغيرهم.(@)(@@)(@@)(@@) $ 2 - والوليد بن مسلم بن أبي رباح، مولى آل الحارث بن أبي ذباب.(@)(@@) عن المطلب بن عبد الله بن حنطب.(@)(@@) سمع محمد بن عبد العزيز، سأل أبا بكر بن عبد الرحمن بن الحارث بن هشام عن الكبائر؟ فقال: سمعت عبد الله بن عمرو (2) يقول: «الإشراك PageV02P279(@)(@@) بالله» (1) ذكر ذلك البخاري.(@)(@@)(@@)(@@) $ 3 - والوليد بن مسلم، أبو العباس الدمشقي، مولى بني أمية.(@)(@@) سمع: أبا عمرو الأوزاعي، ومحمد بن عجلان، وابن جريج، وسفيان الثوري، والليث بن سعد، وشيبان بن عبد الرحمن، وسعيد بن عبد العزيز، وعبد الرحمن بن يزيد بن جابر، وسفيان بن عيينة.(@)(@@) روى عنه: الليث بن سعد، وعبد الله بن وهب، والحميدي، وأحمد بن حنبل، وعلي بن المديني، 
ms252	 وأبو خيثمة زهير بن حرب، وهشام بن عمار، ودحيم وغيرهم، مات سنة خمس وتسعين ومائة، وله ثلاث وتسعون سنة.(@)(@@)(@@)(@@) || الوليد بن كثير، اثنان(@)(@@) (2):(@)(@@) مدنيان سكنا الكوفة، أحدهما:(@)(@@)(@@)(@@) $ 1 - الوليد بن كثير، أبو محمد مولى بني مخزوم.(@)(@@) حدث عن: محمد بن كعب القرظي، ومحمد بن عمرو بن حلحلة، ونافع مولى ابن عمر، ويزيد بن عبد الله بن قسيط، ومحمد بن إبراهيم التيمي، وسعيد المقبري، ومحمد بن جعفر بن الزبير.(@)(@@) روى عنه: إبراهيم بن سعد، وعيسى بن يونس، وأبو أسامة حماد بن أسامة، ومحمد بن عمر الواقدي (3). PageV02P280(@)(@@) قال الخطيب: أنا علي بن محمد بن عبد الله المعدل: أنا الحسين بن صفوان: أنا عبد الله بن محمد بن أبي الدنيا: ثنا محمد بن سعد، قال: الوليد بن كثير، ويكنى أبا محمد مولى لبني مخزوم، ومات بالكوفة سنة إحدى وخمسين ومائة.(@)(@@) والآخر:(@)(@@)(@@)(@@) $ 2 - الوليد بن كثير بن سنان، أبو سعيد يعرف بالراني.(@)(@@) حدث عن: ربيعة بن أبي عبد الرحمن، والضحاك بن عثمان، وعبيد الله العمري.(@)(@@) روى عنه: زكريا ويوسف ابنا عدي، وأبو سعيد الأشج.(@)(@@)(@@)(@@) || [الوليد بن عبد الملك، اثنان](@)(@@) (1)(@)(@@) الوليد بن عبد الملك، والوليد بن عبد الملك(@)(@@) أما أحدهما فهو:(@)(@@)(@@)(@@) $ 1 - الوليد بن عبد الملك بن مروان بن الحكم، أمير المؤمنين والخليفة بعد أبيه عبد الملك بن مروان.(@)(@@) والثاني:(@)(@@)(@@)(@@) $ 2 - الوليد بن عبد الملك بن مسرح الحراني] (2). PageV02P281(@)(@@)(@@)(@@) || وهب بن جرير، اثنان(@)(@@) (1):(@)(@@) أحدهما:(@)(@@)(@@)(@@) $ 1 - أبو العباس وهب بن جرير بن [129 - ب] حازم بن يزيد الأزدي البصري.(@)(@@) سمع: أباه، وهشاما الدستوائي، وعبد الله بن عون، وهشام بن حسان، وشعبة.(@)(@@) روى عنه: سليمان بن حرب، وعبد الأعلى بن حماد، وعلي بن المديني، وأحمد بن حنبل، ويحيى بن معين، وأبو خيثمة، وإسحاق بن راهويه، وبندار بن بشار، ومحمد بن المثنى، ومن بعدهم.(@)(@@) مات سنة ست ومائتين بالمنجشانية بعد انصرافه من الحج، وحمل إلى البصرة، فدفن بها.(@)(@@) والآخر:(@)(@@)(@@)(@@) $ 2 - وهب بن جرير بن حفص البجلي.(@)(@@) حدث عن عبد الملك بن إبراهيم الجدي. روى عنه الحسين بن المثنى الهيتي. 
ms253	 PageV02P282(@)(@@)(@@)(@@) | باب الهاء(@)(@@)(@@)(@@) || هلال بن أبي هلال، أربعة(@)(@@) (1):(@)(@@) منهم:(@)(@@)(@@)(@@) $ 1 - هلال بن أبي هلال، مولى ابن كعب المذحجي المدني.(@)(@@) حدث عن أبي هريرة. روى عنه: محمد، وخالد بن سعيد بن أبي مريم.(@)(@@)(@@)(@@) $ 2 - وهلال بن أبي هلال، وهو هلال بن علي بن أسامة، ويقال له أيضا: هلال بن أبي ميمونة مديني.(@)(@@) حدث عن: أنس بن مالك، وعطاء بن يسار.(@)(@@) روى عنه: يحيى بن أبي كثير، وزياد بن سعد، ومالك بن أنس، وعبد العزيز بن عبد الله بن أبي سلمة الماجشون.(@)(@@)(@@)(@@) $ 3 - وهلال بن أبي هلال، أبو ظلال القسملي الأعمى البصري.(@)(@@) حدث عن أنس بن مالك. روى عنه: عبد العزيز بن مسلم القسملي، ومروان بن معاوية، ويحيى بن المتوكل، ويزيد بن هارون. PageV02P283(@)(@@)(@@)(@@) $ 4 - وهلال بن أبي هلال، شيخ مجهول.(@)(@@) حدث عن أنس بن مالك. روى عنه المتوكل بن أبي سورة.(@)(@@)(@@)(@@) || الهيثم بن أبي الهيثم، أربعة(@)(@@) (1):(@)(@@)(@@)(@@) $ 1 - منهم، شيخ كوفي.(@)(@@) حدث عن: هبيرة بن يريم، أو الحارث بن عبد الله الهمداني. روى عنه سوار بن مصعب.(@)(@@)(@@)(@@) $ 2 - والهيثم بن أبي الهيثم، وهو الهيثم بن حبيب الصيرفي الكوفي.(@)(@@) حدث عن: محارب بن دثار، وحماد بن أبي سليمان، والحكم بن عتيبة.(@)(@@) روى عنه: شعبة، وأبو عوانة، والمسعودي، وزيد بن أبي أنيسة، وحفص بن سليمان القارئ [130 - أ].(@)(@@)(@@)(@@) $ 3 - والهيثم بن أبي الهيثم، وهو الهيثم بن جماز البكاء البصري.(@)(@@) حدث عن: الحسن، ويزيد الرقاشي، وعمران القصير، ويحيى بن أبي كثير.(@)(@@) روى عنه: هشيم، ووكيع، والنضر بن شميل، ومسلم بن إبراهيم.(@)(@@) قال الخطيب: أنا أبو القاسم عبيد الله بن عمر بن أحمد الواعظ: أنا أبي: ثنا الحسن بن أحمد هو أبو سعيد الإصطخري، قال: قرئ على العباس بن محمد قال: سمعت يحيى بن معين يقول: الهيثم بن جماز ضعيف. PageV02P284(@)(@@)(@@)(@@) $ 4 - والهيثم بن أبي الهيثم، أبو محمد السمرقندي.(@)(@@) ولي قضاء بخارا، وحدث بها عن أبي مقاتل حفص بن سالم السمرقندي، ومعروف بن حسان، وإبراهيم بن الأشعث البخاري.(@)(@@) روى عنه سعيد بن سليمان الشرغي وغيرهم.(@)(@@)(@@)(@@) || همام بن يحيى، ثلاثة 
ms254	(@)(@@) (1):(@)(@@) منهم:(@)(@@)(@@)(@@) $ 1 - همام بن يحيى بن دينار، أبو عبد الله العوذي البصري.(@)(@@) حدث عن: الحسن، وقتادة، وإسحاق بن عبد الله بن أبي طلحة، ويحيى بن أبي كثير.(@)(@@) روى عنه: عبد الرحمن بن مهدي، ووكيع، وأبو نعيم، وعفان بن مسلم بن إبراهيم، وموسى بن إسماعيل، وسهل بن بكار، وعلي بن الجعد، وهدبة بن خالد، وشيبان بن فروخ وغيرهم.(@)(@@)(@@)(@@) $ 2 - وهمام بن يحيى بن زكريا، أبو محمد النيسابوري.(@)(@@) حدث عن: عبد الله السلمي، ومحمد بن القاسم الطايكاني.(@)(@@) روى عنه: أبو العباس محمد بن أحمد بن همام، وأبو الطيب محمد بن عبد الله الشعيري النيسابوريان.(@)(@@)(@@)(@@) $ 3 - وهمام بن يحيى بن همام بن مسلمة بن سلمة بن عقبة بن همام بن منبه الصنعاني.(@)(@@) حدث عن حريز بن المسلم الصنعاني. روى عنه أبو القاسم الطبراني. PageV02P285(@)(@@)(@@)(@@) || هشام بن يوسف، ثلاثة(@)(@@) (1):(@)(@@) منهم:(@)(@@)(@@)(@@) $ 1 - هشام بن يوسف الشامي.(@)(@@) حدث عن: عبد الله بن بسر، وعن عوف بن مالك الأشجعي.(@)(@@) وذكر أبو حاتم الرازي أن روايته عن عوف مرسلة.(@)(@@) روى عنه: سفيان بن حسين، وهشيم بن بشير، وزعم هشيم أن هشاما كان قاضيا عليهم بواسط.(@)(@@)(@@)(@@) $ 2 - وهشام بن [130 - ب] يوسف، أبو عبد الرحمن، قاضي صنعاء، وكان من أبناء الفرس.(@)(@@) حدث عن: معمر بن راشد، وابن جريج، وسفيان الثوري، وعمران بن أبي الهذيل، وعقيل بن معقل.(@)(@@) روى عنه: علي بن المديني، وإبراهيم بن موسى الفراء، وعلي بن بحر بن بري، وعبد الله بن محمد المسندي، وغيرهم.(@)(@@) قال الخطيب: أنا ابن الفضل: أنا جعفر الخلدي: ثنا محمد بن عبد الله الحضرمي قال: وفي سنة سبع وتسعين ومائة أخبرت أنه مات هشام بن يوسف قاضي صنعاء.(@)(@@)(@@)(@@) $ 3 - وهشام بن يوسف العتكي، يشبه أن يكون بصريا.(@)(@@) حدث عن أبي المنيب العتكي. روى عنه محمد بن يحيى بن عبد الكريم PageV02P286(@)(@@) الأزدي.(@)(@@)(@@)(@@) || هناد بن السري، اثنان(@)(@@) (1):(@)(@@) كوفيان، يكنى كل واحد منهما أبا السري، أحدهما:(@)(@@)(@@)(@@) $ 1 - هناد بن السري بن مصعب التميمي.(@)(@@) حدث عن: أبي الأحوص، سلام بن سليم، وعبدة بن سليمان، وعبد الله بن 
ms255	 المبارك.(@)(@@) روى عنه: محمد بن عبد الله مطين الكوفي، وأبو داود السجستاني، ومحمد بن صالح بن ذريح العكبري، وعبدان بن أحمد الأهوازي، ومحمد بن إسحاق السراج النيسابوري.(@)(@@) والآخر:(@)(@@)(@@)(@@) $ 2 - هناد بن السري يحيى بن السري التميمي ابن ابن أخي الذي ذكرناه آنفا.(@)(@@) حدث عن أبي سعيد عبد الله بن سعيد الأشج. روى عنه محمد بن عمر بن يحيى العلوي الكوفي وغيره. PageV02P287(@)(@@)(@@)(@@) | باب الياء(@)(@@)(@@)(@@) || يحيى بن يحيى، خمسة(@)(@@) (1):(@)(@@) منهم:(@)(@@)(@@)(@@) $ 1 - يحيى بن يحيى الغساني، قاضي دمشق.(@)(@@) حدث عن: سعيد بن المسيب، وعروة بن الزبير، وأبي بكر بن محمد بن عمرو بن حزم وغيرهم.(@)(@@) روى عنه: ابنه هشام، ومحمد بن إسحاق، وسفيان بن عيينة، ومحمد بن راشد الخزاعي.(@)(@@) قال الخطيب: أنا أبو خازم محمد بن الحسين بن محمد بن الفراء: أنا الحسين بن علي بن أبي أسامة الحلبي: ثنا أبو عمران بن الأشيب القاضي: ثنا عبد الله بن محمد بن عبيد: ثنا محمد بن سعد، قال: يحيى بن يحيى الغساني، كان بدمشق، عالم بالفتيا والقضاء، مات سنة خمس وثلاثين ومائة.(@)(@@)(@@)(@@) $ 2 - ويحيى بن يحيى بن سعيد بن خالد بن عبد الله القسري.(@)(@@) حدث عن [131 - أ] أبيه. روى عنه أحمد بن صالح المصري. PageV02P288(@)(@@)(@@)(@@) $ 3 - ويحيى بن يحيى بن محمد المدني.(@)(@@) حدث عن عمه إبراهيم، روى عنه الزبير بن بكار.(@)(@@)(@@)(@@) $ 4 - ويحيى بن يحيى بن بكر بن عبد الرحمن، أبو زكريا الحنظلي النيسابوري.(@)(@@) سمع: مالك بن أنس، وسليمان بن بلال، وزهير بن معاوية، والليث بن سعد، وابن لهيعة، وأبا عوانة، وشعيب بن رزيق، ووكيع بن الجراح، وأبا يحيى الحماني.(@)(@@) روى عنه: محمد بن إسماعيل البخاري، ومسلم بن الحجاج، ويعقوب بن سفيان الفسوي، وأحمد بن سلمة، وإبراهيم بن علي الذهلي، وجعفر بن محمد الترك، وإسماعيل بن إسحاق السراج النيسابوريون.(@)(@@) قال الخطيب: حدثني الأزهري: ثنا أحمد بن إبراهيم بن شاذان: ثنا عبد العزيز بن أحمد الغافقي، قال: سمعت علي بن شيبة بن الصلت البغدادي يقول: كان أحمد بن حنبل إذا ذكر يحيى بن يحيى النيسابوري 
ms256	 قال: ذاك ريحانة خراسان.(@)(@@) أنا القاضي أبو العلاء الواسطي، قال: أنا محمد بن الحسين النيسابوري: أنا محمد بن يعقوب الأخرم الحافظ قال: سمعت يحيى بن محمد بن يحيى يقول: سمعت إسحاق بن إبراهيم الحنظلي يقول: ما رأيت مثل يحيى بن يحيى، ولا رأى يحيى بن يحيى مثل نفسه.(@)(@@) أنا أبو بكر البرقاني قال: قرأت على أبي حامد أحمد بن عمر المروزي بها، سمعت أبا يزيد محمد بن يحيى بن خالد يقول: ومات يحيى بن يحيى سنة ست وعشرين ومائتين.(@)(@@) PageV02P289(@)(@@)(@@)(@@) $ 5 - ويحيى بن يحيى بن كثير، أبو محمد الأندلسي، مولى بني ليث.(@)(@@) حدث عن: مالك بن أنس، وسفيان بن عيينة، وعبد الله بن وهب، وعبد الرحمن بن القاسم العتيقي.(@)(@@) روى عنه ابنه عبيد الله. ويقال: إنه مات في رجب من سنة أربع وثلاثين ومائتين.(@)(@@)(@@)(@@) || يحيى بن أبي يحيى، خمسة(@)(@@) (1):(@)(@@)(@@)(@@) $ 1 - أحدهم قديم، يروي عن أبيه. حدث عنه سماك بن حرب.(@)(@@)(@@)(@@) $ 2 - ويحيى بن أبي يحيى(@)(@@) القيسي البصري.</span>(@)(@@) حدث عن أبيه وعن مسلم بن عطية. روى عنه أبو سلمة التبوذكي.(@)(@@)(@@)(@@) $ 3 - ويحيى بن أبي يحيى التميمي الخراساني.(@)(@@) حكى عن سفيان الثوري. روى عنه علي بن معبد [131 - ب] العبدي.(@)(@@)(@@)(@@) $ 4 - ويحيى بن أبي يحيى.(@)(@@) حدث عن خلاد الصفار. روى عنه محمد بن يونس الإمام.(@)(@@)(@@)(@@) $ 5 - ويحيى بن أبي يحيى الأسدي البلخي.(@)(@@) حدث عن حام بن نوح. روى عنه علي بن الفضل بن طاهر. PageV02P290(@)(@@)(@@)(@@) || يحيى بن أبي كثير، ثلاثة(@)(@@) (1):(@)(@@)(@@)(@@) $ 1 - أحدهم الأنصاري النجاري من أهل مدينة رسول الله صلى الله عليه وسلم.(@)(@@) حدث عن عويمر بن أشقر. روى عنه عمرو بن يحيى بن عمارة المازني.(@)(@@)(@@)(@@) $ 2 - ويحيى بن أبي كثير، أبو نصر اليمامي، واسم أبيه صالح بن المتوكل، ويقال: يسار، ويقال: نشيط، ويقال: دينار، وهو مولى لطبي (2).(@)(@@) كان بالبصرة، فانتقل إلى اليمامة.(@)(@@) رأى أنس بن مالك، وسمع السائب بن يزيد، وأبا سلمة بن عبد الرحمن، وعبد الله بن أبي قتادة، وأبا قلابة الجرمي، وعكرمة مولى ابن عباس، وسليمان بن يسار.(@)(@@) روى عنه: أيوب 
ms257	 السختياني، وهشام الدستوائي، وجرير بن حازم، وأبو عمرو الأوزاعي، وشيبان بن عبد الرحمن التميمي، ومعمر بن راشد، وحرب بن شداد، ومعاوية بن سلام، وهمام بن يحيى، وغيرهم.(@)(@@) قال الخطيب: أنا أبو الحسين محمد بن الحسين بن محمد بن الحسين بن علي الحراني المعدل: أنا أبو محمد عبد الله بن إبراهيم بن أيوب بن ماسي البزاز: ثنا إبراهيم بن موسى الجوزي البغدادي: ثنا محمد بن منصور الجواز بمكة: ثنا سفيان قال: كان أيوب السختياني يذكر يحيى بن PageV02P291(@)(@@) أبي كثير ويقول: ما أعلم أحدا اليوم بعد الزهري أعلم بحديث المدينة من يحيى بن أبي كثير.(@)(@@)(@@)(@@) $ 3 - ويحيى بن أبي كثير، أبو محمد البصري.(@)(@@) قال الخطيب: أنبأنا أبو سعد الماليني: أنا أبو عبد الله محمد بن إسحاق بن محمد2 بن يحيى بن منده الأصبهاني الحافظ قال: أبو محمد يحيى بن أبي كثير جليس هشام القردوسي (1)، حدث عن ابن طاوس، روى عنه مثنى بن معاذ.(@)(@@)(@@)(@@) || يحيى بن سليم، أربعة(@)(@@) (2):(@)(@@) منهم:(@)(@@)(@@)(@@) $ 1 - يحيى بن سليم بن رياح.(@)(@@) حديثه في المصريين. حدث عن عبد الرحمن بن هرمز الأعرج.(@)(@@) روى عنه نافع بن سليمان [132 - أ].(@)(@@)(@@)(@@) $ 2 - ويحيى بن سليم بن زيد، مولى رسول الله صلى الله عليه وسلم.(@)(@@) حدث عن إسماعيل بن بشير مولى بني مغالة. روى عنه الليث بن سعد.(@)(@@)(@@)(@@) $ 3 - ويحيى بن سليم الباهلي.(@)(@@) حدث عن يحيى بن أبي كثير. روى عنه عمر بن يونس اليمامي. PageV02P292(@)(@@)(@@)(@@) $ 4 - ويحيى بن سليم، أبو زكريا، ويقال: أبو محمد القرشي الحذاء الطائفي.(@)(@@) حدث عن: موسى بن عقبة، وعبيد الله بن عمر بن حفص، وعبد الله بن عثمان بن خثيم، وابن جريج، وإسماعيل بن كثير.(@)(@@) روى عنه: الحميدي، وهارون بن معروف، وأبو بكر بن أبي شيبة، وأبو خيثمة زهير بن حرب، والحسن بن عرفة، وعبد الله بن محمد بن أيوب المخرمي وغيرهم.(@)(@@) قال الخطيب: أنا أبو بكر أحمد بن محمد الأشناني قال: سمعت أبا الحسن الطرائفي يقول: سمعت عثمان بن سعيد يقول: سألت يحيى بن معين عن يحيى بن 
ms258	 سليم الطائفي فقال: ثقة.(@)(@@)(@@)(@@) || يحيى بن أبي سليم، اثنان(@)(@@) (1):(@)(@@) أحدهما:(@)(@@)(@@)(@@) $ 1 - أبو بلج الفزاري الواسطي.(@)(@@) حدث عن محمد بن حاطب، وعمرو (2) بن ميمون وغيرهما.(@)(@@) روى عنه: سفيان الثوري، وشعبة، وزهير بن معاوية، وأبو عوانة، وهشيم، وأبو حمزة السكري، وسويد بن عبد العزيز.(@)(@@) والآخر: PageV02P293(@)(@@)(@@)(@@) $ 2 - يحيى بن أبي سليم المروزي.(@)(@@) حدث عن كثير بن سليم. روى عنه أبو يحيى القصري المروزي.(@)(@@)(@@)(@@) || يحيى بن حسان، خمسة(@)(@@) (1):(@)(@@) منهم:(@)(@@)(@@)(@@) $ 1 - يحيى بن حسان البكري الفلسطيني.(@)(@@) سمع أبا قرصافة جندرة بن خيشنة، وأبا ريحانة، وربيعة بن عامر، وسعيد بن المسيب، وأرسل الرواية عن عبادة بن الصامت.(@)(@@) حدث عنه: الريان بن الجعد الكناني، وبلال بن كعب العكي، وهشام بن سعد، وعبد الله بن المبارك.(@)(@@)(@@)(@@) $ 2 - ويحيى بن حسان التنيسي.(@)(@@) حدث عن: معاوية بن سلام، وسليمان بن بلال، وعبد الله بن جعفر المخرمي، وحماد بن سلمة، وأبي شهاب الحناط.(@)(@@) روى عنه: محمد بن إدريس الشافعي، وعبد العزيز بن عمران، وسعيد بن أسد بن موسى [132 - ب]، والربيع بن سليمان المرادي.(@)(@@)(@@)(@@) $ 3 - ويحيى بن حسان، أبو زكريا القصاب، أراه خراسانيا.(@)(@@) حدث عن شعبة أحاديث منكرة. روى عنه سليمان بن داود المهري. PageV02P294(@)(@@)(@@)(@@) $ 4 - ويحيى بن حسان بن سهيل، أبو زكريا الحرشي الحساني الكوفي.(@)(@@) حدث عن: عبد المجيد بن عبد العزيز بن أبي رواد، ومالك بن سعير بن الخمس، ووكيع بن الجراح.(@)(@@) روى عنه: ابنه علي، وأبو حازم إبراهيم بن محمد الحضرمي، ويحيى بن صاعد.(@)(@@)(@@)(@@) $ 5 - ويحيى بن حسان، أبو جابر البصري.(@)(@@) قال الخطيب: أخبرني أبو يعلى أحمد بن عبد الواحد الوكيل: أنا عبيد الله بن عثمان الدقاق: ثنا محمد بن أحمد الحكيمي: أنا ميمون بن هارون الكاتب، عن ابن أبي طاهر، قال: حدثني أبو جابر يحيى بن حسان البصري، قال: رأى أبو نواس غلاما حسنا فأنشدني من ساعته بديها:(@)(@@) ومستطيل به الجمال على ... كل جميل عديم أشباه(@)(@@) لو كان للشمس حسن صورته ... لاستنكفت عن عبادة الله(@)(@@) قال: فقلت: كفرت ويلك. فقال: إن الله يغفر الذنوب جميعا. فقلت: إن الله 
ms259	 لا يغفر أن يشرك به. قال: أنت لا تعرف الشرك.(@)(@@)(@@)(@@) || يحيى بن معاذ، ثلاثة(@)(@@) (1):(@)(@@) منهم:(@)(@@)(@@)(@@) $ 1 - يحيى بن معاذ بن مسلم العابد النيسابوري.(@)(@@) حدث عن عبد الصمد بن علي بن عبد الله بن عباس. روى عنه ابنه PageV02P295(@)(@@) سليمان.(@)(@@)(@@)(@@) $ 2 - ويحيى بن معاذ، أبو زكريا الواعظ الرازي.(@)(@@) كان حكيم زمانه، دون الناس كلامه وجمعوا ألفاظه، وقد أسند أحاديث يسيرة عن إسحاق بن سليمان الرازي، ومكي بن إبراهيم البلخي، وعلي بن محمد الطنافسي.(@)(@@) روى عنه الحسن بن علويه الدامغاني.(@)(@@)(@@)(@@) $ 3 - ويحيى بن معاذ بن الحارث التستري.(@)(@@) حدث عن: يحيى بن المغيرة المدني، ومحمد بن يحيى القطعي، ويحيى بن غيلان العسكري، وعبد الله بن عبد الوهاب الخوارزمي.(@)(@@) روى عنه: محمد بن داود النيسابوري، ومحمد بن إسحاق بن إبراهيم الأهوازي، وأحمد بن محمود بن [133 - أ] خرزاد السينيزي.(@)(@@)(@@)(@@) || يحيى بن عبيد، أربعة(@)(@@) (1):(@)(@@) منهم:(@)(@@)(@@)(@@) $ 1 - أبو عمر البهراني الكوفي.(@)(@@) حدث عن عبد الله بن عباس. روى عنه: أبو إسحاق السبيعي، والأعمش، وشعبة، وابن أبي ليلى، وحجاج بن أرطأة، وزيد بن أبي أنيسة، وأبو إسرائيل الملائي. PageV02P296(@)(@@)(@@)(@@) $ 2 - ويحيى بن عبيد، مولى السائب، من أهل مكة.(@)(@@) حدث عن أبيه. روى عنه ابن جريج.(@)(@@)(@@)(@@) $ 3 - ويحيى بن عبيد الجهضمي البصري.(@)(@@) حدث عن أبيه، وعن علقمة بن عبد الله المزني.(@)(@@) روى عنه: واصل مولى أبي عيينة، وجرير بن حازم.(@)(@@)(@@)(@@) $ 4 - ويحيى بن عبيد، أبو زياد الغساني الشامي.(@)(@@) حدث عن يزيد بن قطيب. روى عنه صفوان بن عمرو الحمصي.(@)(@@)(@@)(@@) || يحيى بن آدم، اثنان(@)(@@) (1):(@)(@@)(@@)(@@) $ 1 - أحدهما بلخي.(@)(@@) حدث عن نصر بن مشارس، وجويبر بن سعيد. روى عنه محمد بن أبان البلخي.(@)(@@) والآخر:(@)(@@)(@@)(@@) $ 2 - يحيى بن آدم بن سليمان، أبو زكريا الكوفي المخزومي، مولاهم.(@)(@@) حدث عن: مسعر، والثوري، وإسرائيل، ومالك بن مغول، والحسن بن صالح، وزهير بن معاوية، وإبراهيم بن سعد، وأبي بكر بن عياش، وعبد الله بن المبارك.(@)(@@) روى عنه: أحمد بن حنبل، ويحيى بن معين، وإسحاق بن راهويه، وأبو PageV02P297(@)(@@) بكر بن أبي شيبة، وأبو كريب محمد بن العلاء، وأحمد بن 
ms260	 محمد بن يحيى بن سعيد القطان، والحسن بن علي بن عفان العامري، وغيرهم.(@)(@@) قال الخطيب: أنا أبو بكر أحمد بن محمد بن محمد الأشناني، قال: سمعت أبا الحسن الطرائفي يقول: سمعت عثمان بن سعيد الدارمي يقول: قلت ليحيى بن معين: فيحيى بن آدم ما حاله في سفيان؟ فقال: ثقة.(@)(@@)(@@)(@@) || يحيى بن غيلان، اثنان(@)(@@) (1):(@)(@@)(@@)(@@) $ 1 - أحدهما بغدادي.(@)(@@) حدث عن: مالك بن أنس، وأبي عوانة، ورشدين بن سعد.(@)(@@) روى عنه: أحمد بن حنبل، ومحمد بن الفرج الأزرق، وإسحاق بن الحسن الحربي وغيرهم.(@)(@@) والآخر:(@)(@@)(@@)(@@) $ 2 - يحيى بن غيلان، من أهل عسكر مكرم.(@)(@@) حدث عن إبراهيم بن أبي يحيى، وعبد الله بن بزيع.(@)(@@) روى عنه: محمد بن نوح بن حرب، والحسن بن سهل العسكريان، ويحيى بن معاذ [133 - ب] التستري. PageV02P298(@)(@@)(@@)(@@) || يحيى بن صالح، ثلاثة(@)(@@) (1):(@)(@@) منهم:(@)(@@)(@@)(@@) $ 1 - يحيى بن صالح الأيلي.(@)(@@) حدث عن إسماعيل بن أمية. روى عنه يحيى بن عبد الله بن بكير المصري.(@)(@@)(@@)(@@) $ 2 - ويحيى بن صالح الوحاظي الدمشقي.(@)(@@) حدث عن: مالك بن أنس، وسعيد بن عبد العزيز، وسليمان بن بلال، ومعاوية بن سلام، وزهير بن معاوية، والحسن بن أيوب، وفليح بن سليمان.(@)(@@) روى عنه: أحمد بن أبي الحواري، ومحمد بن عوف الحمصي، ويعقوب بن سفيان الفسوي، وأبو زرعة الدمشقي، ومحمد بن مسلم بن واره، وأبو حاتم الرازيان وغيرهم.(@)(@@)(@@)(@@) $ 3 - ويحيى بن صالح، أبو زكريا الصائغ البلخي.(@)(@@)(@@)(@@) || يحيى بن عباد، خمسة(@)(@@) (2):(@)(@@) منهم:(@)(@@)(@@)(@@) $ 1 - أبو هبيرة الأنصاري الكوفي.(@)(@@) حدث عن: أنس بن مالك، وعطاء بن أبي رباح، وأم الدرداء.(@)(@@) روى عنه: سليمان التيمي، ومنصور بن المعتمر، وإسماعيل السدي، PageV02P299(@)(@@) وليث بن أبي سليم، وأشعث بن سوار، وسيار أبو الحكم، ومسعر بن كدام.(@)(@@)(@@)(@@) $ 2 - ويحيى بن عباد بن جارية الليثي.(@)(@@) حدث عن أبيه. روى عنه إبراهيم بن إسماعيل بن مجمع.(@)(@@)(@@)(@@) $ 3 - ويحيى بن عباد بن عبد الله بن الزبير بن العوام الأسدي المدني.(@)(@@) حدث عن أبيه. روى عنه محمد بن إسحاق بن يسار.(@)(@@) قال الخطيب: أنا أبو بكر الأشناني، قال: سمعت أحمد بن محمد بن عبدوس 