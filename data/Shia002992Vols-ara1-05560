ms5541	 8، ب 67، ح 2.(@)(@@) * وروى عن علي بن حديد، وروى أبو علي الأشعري.(@)(@@) الكافي: ج 2، ك 3، ب 6، ح 6، و ج 3، ك 3، ب 39، ح 2، و ج 7، ك 3، ب 10، ح 2. والروضة: ح 413، و 414، و 415، PageV17P435(@)(@@) و 538، و 552. والتهذيب: ج 1، ح 1476 (الاستبصار: ج 1، ح 765)، و ج 10، ح 50.(@)(@@) * وروى عن علي بن مهزيار، وروى عنه أبو علي الأشعري.(@)(@@) الكافي: ج 4، ك 2، ب 55، ح 6، و ج 7، ك 1، ب 37، ح 3، وك 7، ب 17، ح 10، و 11. والتهذيب: ج 8، ح 1134، و ج 9، ح 911.(@)(@@) وروى عنه أحمد بن إدريس.(@)(@@) الكافي: ج 3، ك 4، ب 60، ح 8.(@)(@@) وروى عنه محمد بن أحمد بن يحيى.(@)(@@) التهذيب: ج 2، ح 708 (الاستبصار:(@)(@@) ج 1، ح 1446)، و ج 3، ح 395، و ج 4، ح 714، و 937، و ج 5، ح 1484 (الاستبصار: ج 2، ح 1180)، و ج 7، ح 913، و 1308 (الاستبصار: ج 3، ح 711).(@)(@@) * وروى عن علي بن النعمان، وروى عنه أبو علي الأشعري.(@)(@@) الكافي: ج 5، ك 2، ب 70، ح 14، و ب 118، ح 7. والتهذيب: ج 6، ح 451.(@)(@@) * وروى عن محمد بن أبي عمير، وروى عنه سعد بن عبد الله.(@)(@@) مشيخة الفقيه: في طريقه إلى محمد بن أبي عمير.(@)(@@) وروى عنه محمد بن الحسن الصفار.(@)(@@) مشيخة الفقيه: في طريقه إلى أبان بن عثمان.(@)(@@) * وروى عن محمد بن إسماعيل، وروى عنه أبو علي الأشعري.(@)(@@) الكافي: ج 1، ك 4، ب 44، ح 4، و ج 2، ك 1، ب 31، ح 6، وب 97، ح 23، و ب 134، ح 3، وك 2، ب 48، ح 19، و ك 4، ب 25، ح 13، و 14، و ج 3، ك 3، ب 88، ح 3، و ج 4، ك 3، ب 7، ح 19، و ج 5، ك 2، ب 112، ح 7، وك 3، ب 190، ح 21، و ج 6، ك 2، ب 46، ح 4، وب 56، ح 2، وك 5، ب 9، ح 3، و ب 11، ح 1، وب 15، ح 10، وك 6، ب 14، ح 4، وك 7، ب 21، ح 5، وك 8، ب 27، ح 1، وب 64، ح 6، و ج 7، ك 1، ب 13، ح 5، وك 2، ب 61، ح 2، وك 7، ب 9، ح 3. والتهذيب: ج 8، ح 551، و ج 9، ح 865، و 1248 (الاستبصار:(@)(@@) ج 4، ح 699).(@)(@@) وروى عنه أحمد بن إدريس.(@)(@@) الكافي: ج 1، ك 4، ب 65، ح 5.(@)(@@) وروى عنه عبد الله بن جعفر الحميري. PageV17P436(@)(@@) مشيخة الفقيه: في طريقه إلى عمر بن يزيد.(@)(@@) وروى عنه 
ms5542	 محمد بن علي بن محبوب.(@)(@@) التهذيب: ج 7، ح 1815.(@)(@@) وروى عنه محمد بن يحيى.(@)(@@) الكافي: ج 1، ك 4، ب 33، ح 5.(@)(@@) * وروى عن محمد بن إسماعيل بن بزيع.(@)(@@) التهذيب: ج 5، ح 1729.(@)(@@) وروى عنه أبو علي الأشعري.(@)(@@) الكافي: ج 2، ك 1، ب 57، ح 4، و ج 6، ك 2، ب 4، ح 16.(@)(@@) وروى عنه محمد بن الحسن الصفار.(@)(@@) التهذيب: ج 6، ح 266.(@)(@@) وروى عنه الصفار.(@)(@@) التهذيب: ج 7، ح 355.(@)(@@) * وروى عن محمد بن حسان، وروى عنه أبو علي الأشعري.(@)(@@) الكافي: ج 3، ك 3، ب 83، ح 2، و 3.(@)(@@) * وروى عن محمد بن خالد، وروى عنه أحمد بن إدريس.(@)(@@) الكافي: ج 1، ك 4، ب 11، ح 5.(@)(@@) * وروى عن محمد بن سالم، وروى عنه أبو علي الأشعري.(@)(@@) الكافي: ج 6، ك 6، ب 21، ح 1، وب 23، ح 6، وب 101، ح 6، وك 7، ب 6، ح 2.(@)(@@) * وروى عن محمد بن سنان، وروى عنه أبو على الأشعري.(@)(@@) الكافي: ج 4، ك 3، ب 232، ح 2.(@)(@@) وروى عنه محمد بن علي بن محبوب.(@)(@@) التهذيب: ج 1، ح 1311 (الاستبصار:(@)(@@) ج 1، ح 53)، و ج 3، ح 931 (الاستبصار: ج 1، ح 1778).(@)(@@) * وروى عن محمد بن يحيى.(@)(@@) التهذيب: ج 5، ح 1699.(@)(@@) * وروى عن منصور بن حازم، وروى عنه أبو علي الأشعري.(@)(@@) الكافي: ج 6، ك 7، ب 28، ح 3.(@)(@@) والتهذيب: ج 9، ح 519.(@)(@@) * وروى عن النضر بن شعيب، وروى عنه عبد الله بن جعفر الحميري.(@)(@@) مشيخة الفقيه: في طريقه إلى خالد بن ماد القلانسي.(@)(@@) * وروى عن الحجال، وروى عنه أبو علي الأشعري.(@)(@@) الكافي: ج 2، ك 1، ب 113، ح 3، و ب 139، ح 22، وك 2، ب 48، ح 7، و ك 4، ب 4، ح 11، و ج 3، ك 3، ب 31، ح 5، وب 40، ح 6، وب 44، ح 3، و ب 70، ح 3، وب 88، ح 1، و ج 6، ك 1، PageV17P437(@)(@@) ب 38، ح 8، وك 6، ب 112، ح 6، و ك 7، ب 33، ح 2، وك 8، ب 12، ح 9، و ب 67، ح 2، وك 9، ب 2، ح 11، وب 4، ح 2، و ج 7، ك 1، ب 5، ح 6. والروضة:(@)(@@) ح 252، و 272. والتهذيب: ج 1، ح 904.(@)(@@) * وروى عن بعض أصحابنا، عن علي بن محمد العسكري عليهما السلام.(@)(@@) الفقيه: ج 2، ح 28.(@)(@@) * وروى عن بعض أصحابنا، عن عيص بن القاسم، وروى عنه أبو علي الأشعري.(@)(@@) الكافي: ج 5، ك 2، ب 44، ح 6.(@)(@@) * وروى عن بعض 
ms5543	 أصحابنا مرفوعا عن أبي عبد الله عليه السلام، وروى عنه أحمد بن إدريس.(@)(@@) الكافي: ج 1، ك 1، ب (0)، ح 3.(@)(@@) * وروى عن بعض أصحابنا، عن مروك بن عبيد، وروى عنه أبو علي الأشعري.(@)(@@) الكافي: ج 5، ك 2، ب 88، ح 1.(@)(@@) * وروى عن بعض أصحابه، عن خلف بن حمار، وروى عنه أبو علي الأشعري.(@)(@@) الكافي: ج 5، ك 2، ب 22، ح 1.(@)(@@) والتهذيب: ج 6، ح 407.(@)(@@) * وروى عن بعض أصحابه، عن ميمون القداح، وروى عنه أبو علي الأشعري.(@)(@@) الكافي: ج 2، ك 1، ب 38، ح 7.(@)(@@) * وروى محمد بن عبد الجبار أو غيره، عن ابن فضال، وروى عنه أبو علي الأشعري.(@)(@@) الكافي: ج 5، ك 3، ب 157، ح 7.(@)(@@) وروى محمد بن عبد الجبار أو غيره، عن الحسن بن علي، وروى عنه أبو علي الأشعري.(@)(@@) الكافي: ج 6، ك 2، ب 73، ح 28.(@)(@@) محمد بن عبد الحميد * روى عن أبي جميلة، وروى عنه سعد بن عبد الله.(@)(@@) مشيخة الفقيه: في طريقه إلى زيد الشحام.(@)(@@) وروى عنه عبد الله بن محمد.(@)(@@) التهذيب: ج 8، ح 899.(@)(@@) وروى عنه علي بن الحسن بن فضال.(@)(@@) التهذيب. ج 4، ح 817 (الاستبصار:(@)(@@) ج 2، ح 375). PageV17P438(@)(@@) وروى عنه محمد بن أحمد.(@)(@@) الكافي: ج 3، ك 4، ب 58، ح 6، وك 5، ب 33، ح 6، و ج 5، ك 2، ب 93، ح 18، وك 3، ب 53، ح 4. والتهذيب: ج 4، ح 151.(@)(@@) وروى عنه محمد بن أحمد بن يحيى.(@)(@@) التهذيب: ج 2، ح 961، و ج 3، ح 269 (الاستبصار: ج 1، ح 1710)، و 363 (الاستبصار: ج 1، ح 1636)، و ج 7، ح 1401.(@)(@@) وروى عنه موسى بن الحسن.(@)(@@) الكافي: ج 7، ك 4، ب 30، ح 5.(@)(@@) والتهذيب: ج 10، ح 1060.(@)(@@) * وروى عن أبي خالد مولى علي بن يقطين، وروى عنه علي.(@)(@@) التهذيب: ج 5، ح 860 (الاستبصار:(@)(@@) ج 2، ح 803).(@)(@@) وروى عنه عدة من أصحابنا.(@)(@@) التهذيب: ج 5، ح 1764 (الاستبصار:(@)(@@) ج 2، ح 803).(@)(@@) وروى عنه محمد بن عيسى.(@)(@@) التهذيب: ج 5، ح 311.(@)(@@) * وروى عن ابن أبي عمير.(@)(@@) التهذيب: ج 1، ح 1533.(@)(@@) * وروى عن إبراهيم بن السندي، وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 4، ك 1، ب 29، ح 5.(@)(@@) * وروى عن أحمد بن عيسى، وروى عنه سلمة بن الخطاب.(@)(@@) التهذيب: ج 5، ح 1771.(@)(@@) * وروى عن أحمد بن محمد 
ms5544	 بن أبي نصر، وروى عنه سعد بن عبد الله.(@)(@@) التهذيب: ج 6، ح 830 (الاستبصار:(@)(@@) ج 3، ح 150).(@)(@@) * وروى عن الحسن بن الجهم، وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 1، ك 4، ب 47، ح 4.(@)(@@) وروى عنه محمد بن علي بن محبوب.(@)(@@) التهذيب: ج 3، ح 765 (الاستبصار:(@)(@@) ج 1، ح 1647).(@)(@@) * وروى عن الحكم بن مسكين، وروى عنه علي بن الحسن بن علي بن فضال.(@)(@@) الروضة: ح 231.(@)(@@) * وروى عن حمزة بن أحمد، وروى عنه عدة من أصحابنا.(@)(@@) التهذيب: ج 1، ح 1143.(@)(@@) * وروى عن سعد بن زيد، وروى عنه إسماعيل بن مهران.(@)(@@) الكافي: ج 2، ك 2، ب 48، ح 29. PageV17P439(@)(@@) * وروى عن سيف، وروى عنه محمد ابن أحمد بن يحيى.(@)(@@) التهذيب: ج 5، ح 863 (الاستبصار:(@)(@@) ج 2، ح 806).(@)(@@) * وروى عن سيف بن عميرة.(@)(@@) التهذيب: ج 6، ح 738 (الاستبصار:(@)(@@) ج 6، ح 106).(@)(@@) وروى عنه عبد الله بن جعفر.(@)(@@) التهذيب: ج 6، ح 91.(@)(@@) وروى عنه محمد بن أحمد.(@)(@@) الكافي: ج 3، ك 4، ب 21، ح 12.(@)(@@) ومشيخة الفقيه: في طريقه إلى منصور ابن حازم.(@)(@@) وروى عنه محمد بن أحمد بن يحيى.(@)(@@) التهذيب: ج 1، ح 701 (الاستبصار:(@)(@@) ج 1، ح 89)، و 1278 (الاستبصار: ج 1، ح 583)، و ج 2، ح 882 (الاستبصار:(@)(@@) ج 1، ح 583)، و 1247 (الاستبصار:(@)(@@) ج 1، ح 1247)، و ج 3، ح 561 (الاستبصار: ج 1، ح 859).(@)(@@) وروى عنه محمد بن جعفر.(@)(@@) الكافي: ج 4، ك 3، ب 110، ح 9، و ج 6، ك 7، ب 19، ح 2. والتهذيب: ج 5، ح 1191، و ج 9، ح 477.(@)(@@) وروى عنه محمد بن جعفر أبو العباس.(@)(@@) الكافي: ج 6، ك 8، ب 30، ح 9.(@)(@@) وروى عنه محمد بن جعفر الرزاز.(@)(@@) الكافي: ج 5، ك 2، ب 109، ح 18.(@)(@@) والتهذيب: ج 7، ح 766 (الاستبصار:(@)(@@) ج 3، ح 431).(@)(@@) وروى عنه محمد بن جعفر الكوفي.(@)(@@) الكافي: ج 7، ك 3، ب 39، ح 6.(@)(@@) والتهذيب: ج 10، ح 460 (الاستبصار:(@)(@@) ج 4، ح 929).(@)(@@) وروى عنه محمد بن الحسين.(@)(@@) التهذيب: ج 4، ح 734 (الاستبصار:(@)(@@) ج 2، ح 353).(@)(@@) وروى عنه محمد بن علي بن محبوب.(@)(@@) التهذيب: ج 2، ح 240.(@)(@@) وروى عنه بعض أصحابنا.(@)(@@) الكافي: ج 6، ك 7، ب 28، ح 9، و ج 7، ك 5، ب 8، ح 6. والتهذيب: ج 9، ح 520.(@)(@@) * وروى صفوان، وروى عنه سهل ابن زياد.(@)(@@) الكافي: ج 
ms5545	 3، ك 4، ب 32، ح 9.(@)(@@) والتهذيب: ج 2، ح 401.(@)(@@) * وروى عن صفوان بن يحيى، وروى عنه أحمد بن أبي عبد الله.(@)(@@) الكافي: ج 6، ك 6، ب 121، ح 2. PageV17P440(@)(@@) * وروى عن عاصم بن حميد، وروى عنه محمد بن جعفر.(@)(@@) الكافي: ج 2، ك 1، ب 124، ح 14.(@)(@@) * وروى عن عبد الله بن جندب، وروى عنه أحمد بن محمد بن خالد.(@)(@@) الكافي: ج 4، ك 3، ب 38، ح 47.(@)(@@) * وروى عن العلاء بن رزين، وروى عنه أحمد بن محمد البرقي.(@)(@@) الكافي: ج 1، ك 2، ب 4، ح 4.(@)(@@) وروى عنه محمد بن خالد.(@)(@@) الكافي: ج 1، ك 3، ب 8، ح 7.(@)(@@) * وروى عن علي بن الفضل الواسطي، وروى عنه عمران بن موسى.(@)(@@) الكافي: ج 3، ك 4، ب 90، ح 7.(@)(@@) والتهذيب: ج 5، ح 782 (الاستبصار:(@)(@@) ج 2، ح 993).(@)(@@) وروى عنه عدة من أصحابنا.(@)(@@) التهذيب: ج 3، ح 878.(@)(@@) * وروى عن محمد بن إسماعيل بن بزيع، وروى عنه سعد.(@)(@@) التهذيب: ج 2، ح 1366.(@)(@@) * وروى عن محمد بن حفص، وروى عنه محمد بن يحيى المعاذي.(@)(@@) التهذيب: ج 1، ح 880 (الاستبصار ج 1، ح 728).(@)(@@) * وروى عن محمد بن شعيب.(@)(@@) الفقيه: ج 3، ح 1270.(@)(@@) وروى عنه عمران بن موسى.(@)(@@) الكافي: ج 5، ك 3، ب 190، ح 24.(@)(@@) * وروى عن محمد بن علي، وروى عنه محمد بن علي بن محبوب.(@)(@@) التهذيب: ج 7، ح 275.(@)(@@) * وروى عن محمد بن عمارة، وروى عنه علي بن مهزيار.(@)(@@) التهذيب: ج 3، ح 88.(@)(@@) * وروى عن محمد بن عمر بن يزيد، وروى عنه عبد الله بن جعفر الحميري.(@)(@@) مشيخة الفقيه: في طريقه إلى عمر بن يزيد.(@)(@@) وروى عنه محمد بن علي بن محبوب.(@)(@@) التهذيب: ج 1، ح 1042، و ج 2، ح 1398.(@)(@@) * وروى عن محمد بن الفضيل، وروى عنه علي بن مهزيار.(@)(@@) الكافي: ج 2، ك 1، ب 168، ح 2.(@)(@@) والتهذيب: ج 4، ح 474.(@)(@@) وروى عنه عمران.(@)(@@) التهذيب: ج 5، ح 417 (الاستبصار:(@)(@@) ج 2، ح 775). PageV17P441(@)(@@) وروى عنه عمران بن موسى.(@)(@@) الكافي: ج 5، ك 3، ب 36، ح 4.(@)(@@) وروى عنه محمد بن الحسن الصفار.(@)(@@) التهذيب: ج 1، ح 319 (الاستبصار:(@)(@@) ج 1، ح 345، وفيه الصفار عن محمد بن عبد الحميد الطائي).(@)(@@) وروى عنه محمد بن الحسين.(@)(@@) التهذيب: ج 4، ح 67 (الاستبصار: ج 2، ح 85).(@)(@@) * وروى عن محمد الخزاز، 
ms5546	 وروى عنه أبو عبد الله.(@)(@@) التهذيب: ج 6، ح 1134.(@)(@@) * وروى عن المفضل بن صالح أبي جميلة، وروى عنه علي بن الحسن بن فضال.(@)(@@) التهذيب: ج 9، ح 1225 (الاستبصار:(@)(@@) ج 4، ح 678).(@)(@@) وروى عنه موسى بن القاسم.(@)(@@) التهذيب: ج 1، ح 412 (الاستبصار:(@)(@@) ج 1، ح 405)، و ج 5، ح 312 (الاستبصار: ج 2، ح 585)، و 493 (الاستبصار: ج 2، ح 830)، و 507 (الاستبصار: ج 2، ح 837).(@)(@@) * وروى عن المفضل بن صالح أبي جميلة الأسدي النخاس، وروى عنه علي بن الحسن.(@)(@@) التهذيب: ج 1، ح 797 (الاستبصار:(@)(@@) ج 1، ح 653، وفيه النحاس بدل النخاس).(@)(@@) * وروى عن منصور بن يونس، وروى عنه محمد البرقي.(@)(@@) الكافي: ج 1، ك 4، ب 95، ح 5.(@)(@@) وروى عنه محمد بن الحسن.(@)(@@) الكافي: ج 1، ك 4، ب 49، ح 3.(@)(@@) وروى عنه محمد بن الحسين.(@)(@@) الكافي: ج 1، ك 4، ب 19، ح 3.(@)(@@) * وروى عن يحيى بن عمرو، وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 2، ك 1، ب 49، ح 9، و ب 121، ح 8، وب 129، ح 5.(@)(@@) * وروى عن يونس، وروى عنه سهل.(@)(@@) الروضة: ح 279، و 281.(@)(@@) وروى عنه سهل بن زياد.(@)(@@) الروضة: ح 280.(@)(@@) * وروى عن يونس بن يعقوب، وروى عنه ابن أبي عمير.(@)(@@) التهذيب: ج 4، ح 253.(@)(@@) وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 2، ك 1، ب 53، ح 2، و ج 6، PageV17P442(@)(@@) ك 7، ب 21، ح 13.(@)(@@) وروى عنه عبد الله بن محمد بن عيسى.(@)(@@) الكافي: ج 1، ك 4، ب 109، ح 4.(@)(@@) وروى عنه محمد بن أحمد بن يحيى.(@)(@@) التهذيب: ج 1، ح 667 (الاستبصار:(@)(@@) ج 1، ح 70)، و 998.(@)(@@) وروى عنه موسى بن الحسن.(@)(@@) التهذيب: ج 4، ح 450.(@)(@@) * وروى عن بعض أصحابه، عن أبي عبد الله عليه السلام، وروى عنه علي ابن محمد.(@)(@@) الكافي: ج 5، ك 3، ب 17، ح 2.(@)(@@) * وروى مرفوعا، عن أبي عبد الله عليه السلام، وروى عنه موسى بن الحسن.(@)(@@) الروضة: ح 579.(@)(@@) محمد بن عبد الله * روى عن أبي عبد الله عليه السلام، وروى عنه الحسين بن المختار.(@)(@@) الكافي: ج 2، ك 3، ب 10، ح 1.(@)(@@) وروى عنه عمر بن سلمة.(@)(@@) الكافي: ج 6، ك 6، ب 94، ح 1.(@)(@@) وروى عنه محمد بن مروان بن مسلم.(@)(@@) التهذيب: ج 1، ح 1112.(@)(@@) * وروى عن أبي الحسن عليه السلام، وروى 
