ms46	 % % 269(@)(@@) % أشبعوه خيانة ورياء % % ماأتى منهم نذير بعتب % % 270(@)(@@) % فيلقى هناك داء دواء % % لا ولا جاء بعد ذاك بشير % % PageV01P183 271(@)(@@) % برضا ثابت يقيم الذماء % % لا ولا جاء بين ذاك وهذا % % 272(@)(@@) % مترت يعلل الحوباء % % لم يواسوا ولم يؤسوا خليلا % % 273(@)(@@) % سوءة سوءة لهم سواء % % منعوا خيرهمولا تأمن الضر % % 274(@)(@@) % ر من المانعين منك الجداء % % فأتى شرهم على كل بقيا % % 275(@)(@@) % لا لقوا من ملمة إبقاء % % خلفوني خلافة الذئب في الش % % 276(@)(@@) % شاءوكانوا في جهل حقي شاء % % وإذا ما حماك عود جناه % % 277(@)(@@) % فاخش من حد شوكه أنكاء % % وكأني غدا أراهم وكل % % 278(@)(@@) % ينشر العذر طاويا شحناء % % سعر الله في الجوانح منهم % % 279(@)(@@) % سعرة النارتلكم البغضاء % % لاعدتهم هناك هاتيك نارا % % 280(@)(@@) % وأصابت من شخصي الإخطاء % % حرقتهم وأرقتهم ولا زا % % PageV01P184 281(@)(@@) % لت وبالا عليهم ووباء % % رتعوا في وخيمة الغيب مني % % 282(@)(@@) % لا تلقي من ارتعاها مراء % % أظهروا للوزير جهلا وغدرا % % 283(@)(@@) % هوعما هم يراهم أدباء % % فجلوا عورة لطرف جل ي % % 284(@)(@@) % حسبوا شمسه تغشت عماء % % جعلوا العبد كفء مولاهفانظر % % 285(@)(@@) % هل تراهم لعاقل أكفاء % % ما تعدوا بذاك أن وزنوني % % 286(@)(@@) % بكضلت عقولهم عقلاء % % غفلة فوق غفلة ثم سهوا % % 287(@)(@@) % فوق سهوعدمتهم أذكياء % % فلهم لائمون فيما أتوه % % 288(@)(@@) % ورأوهلا يعدموا اللوماء % % خذلوني وطأطئوا البدر جهلا % % 289(@)(@@) % وتظنوه يخبط الظلماء % % لاعفا الله عنهم بل عفاهم % % 290(@)(@@) % وزوى العفو عنهم لا العفاء % % ما ائتلاك الإخوانكلا بل الخو % % PageV01P185 291(@)(@@) % وان قاسوا أمثالهم خلطاء % % آفتي فيك أن رأيت محبا % % 292(@)(@@) % لايرى عنك بالغنى استغناء % % لاتطاول بحسن وجهك والدو % % 293(@)(@@) % لة واذكر من شانئيك الفناء % % واحتشم أن يراك معطيك ما أع % % 294(@)(@@) % طاك تجزي نعماءه خيلاء % % وارتفع أن يراك تكسو الفتى الحر % % 295(@)(@@) % ر إذا ما ملكته الإزراء % % إن من أضعف الضعاف لدى الل % 296(@)(@@) % ه قويا يستضعف الضعفاء % % ولأهل العقول فيه رجاء % % 297(@)(@@) % وعزاء يقاوم العزاء % % وتعلم متى حميت على عب % % 298(@)(@@) % دك تلك المياه والأكلاء % % أن لله غير مرعاك مرعى % % 299(@)(@@) % يرتعيهوغير مائك ماء % % وتيقن متى 
ms47	 جنيت على عبد % % 300(@)(@@) % ك ضيما وضيعة وعناء % % أن لله بالبرية لطفا % % PageV01P186 301(@)(@@) % سبق الأمهات والآباء % % قد أطلت العتاب جداوأكثر % % 302(@)(@@) % ت فضولي لكن لي شركاء % % من دعاني إلى الذي كان مني % % 303(@)(@@) % فهو مثلي جلية لاامتراء % % أنا ذو القصد غير أني متى آ % % 304(@)(@@) % نست جورا رأيت لي غلواء % % والحليم العليم من يحسن الإي % % 305(@)(@@) % قاد بدءاويحسن الإطفاء % % والطبيب اللبيب من يتبع الدا % % 306(@)(@@) % ء دواء يشفيه لا الداء داء % % وعسى قائل يقول بجهل % % 307(@)(@@) % إنما يطلب الغنى والغناء % % ولهذين مطلب عند قوم % % 308(@)(@@) % لست ألفى لرحلهم غشاء % % والغنى واسع بكفي جواد % % 309(@)(@@) % يرزق الأغنياء والفقراء % % لي خمسون صاحبا لو سألت ال % % 310(@)(@@) % قوت فيهم ألفيتهم سمحاء % % أترى كل صاحب لي منهم % % PageV01P187 311(@)(@@) % يمنع الشهر بلغتي إجراء % % لي في درهمين في كل شهر % % 312(@)(@@) % من فئام ما يطرد الحوجاء % % والغناء الشديد شدوا وضربا % 313(@)(@@) % سحنة قد ملأت منها الإناء % % ولحسبي عرفان آل بنان % % 314(@)(@@) % وبنان شربا معينا رواء % % ظلت عشرا كواملا في مغاني % % 315(@)(@@) % ه أغني وأسمع الأنجاء % % فليقم كاشحي بنقض الذي قل % % 316(@)(@@) % ت وإلا فليطرق استحياء % % أو فرغما له هناك ودغما % % 317(@)(@@) % ألحم الله أنفه البوغاء % % لاتقدر بحسن وجهك صيدي % % 318(@)(@@) % بعد نفري كما تصيد الظباء % % صد بذاك المها تصدهاوهيها % % 319(@)(@@) % ت تصيد المصمم الأباء % % أنا ليث الليوث نفساوإن كن % % 320(@)(@@) % ت بجسمي ضئيلة رقشاء % % إنني إن نفرت أمعنت في النف % % PageV01P188 321(@)(@@) % رومثلي عمن تناءى تناءى % % لست باللقطة الخسيسة فاعرف % % 322(@)(@@) % لي قدريواسأل به الفهماء % % وانتفع بالعلا بذهنكواذمم % % 323(@)(@@) % كل ذهن لا ينفع الذهناء % % قد بغى قبلك الدعي فلم أح % % 324(@)(@@) % فل بأن كان باغيا بغاء % % بل تصبرت وانتظرت من الل % % 325(@)(@@) % ه نآدا تصيبه دهياء % % فاعتبر بابن بلبل إن فيه % % 326(@)(@@) % عبرة لامرىء أعد وعاء % % والعلاء بن صاعد قبل هذا % % 327(@)(@@) % قد حمى دون رائدي الأحماء % % فارم بالطرف شخصه هل تراه % % 328(@)(@@) % وادعه الدهر هل يجيب دعاء % % ليس إلا لأنني كنت شمسا % 329(@)(@@) % قابلت منه مقلة 
ms48	 عشواء % % فأرانيه ناصري وأباه % % 330(@)(@@) % وله الحمد مثلة شوهاء % % أنا عبد الإنصافقرن التعدي % % PageV01P189 331(@)(@@) % فاسلك القصد بيوعد العداء % % أنا ذو صفحتينملساء حس % % 332(@)(@@) % ناءوأخرى تمسها خشناء % % خاشع تارة وجبار أخرى % % 333(@)(@@) % فتراني أرضا وطورا سماء % % لا بحول ولا بقوة ركن % % 334(@)(@@) % غير لبسي تجلدا وحياء % % أنا جلد على عناد الأحاظي % % 335(@)(@@) % وأبي أن أرأم النكراء % % فمتى شئت فامتحنيوأولى % % 336(@)(@@) % بك عفو يقابل استعفاء % % أنا ذاك الذي سقته يد السق % 337(@)(@@) % م كؤوسا من المرار رواء % % ورأيت الحمام في الصور الشن % 338(@)(@@) % عوكانت لولا القضاء قضاء % % ورماه الزمان في شقة النف % 339(@)(@@) % س فأصمى فؤاده إصماء % % وابتلاه بالعسر في ذاك والوح % 340(@)(@@) % شة حتى أمل منه البلاء % % وثكلت الشباب بعد رضاع % PageV01P190 341(@)(@@) % كان قبل الغذاء قدما غذاء % كل هذا لقيته فأبت نف % % 342(@)(@@) % سي إلا تعززا لااختتاء % % وأرى ذلتي تريك هواني % % 343(@)(@@) % ودنوي يزيدني إقصاء % % ومتى ما فزعت منك إلى الصب % 344(@)(@@) % ر فناديته أجاب النداء % % ومتى ما دعوت ربي على الده % % 345(@)(@@) % ر الخطوب لبى الدعاء % % وإباء الهوان عدوى أتتني % % 346(@)(@@) % منكوالعبد يقبل الإعداء % % أنت علمتني إباء الدنايا % % 347(@)(@@) % يا مليكيفما أسأت الأداء % % وعزيز علي أن قلت ما قل % % 348(@)(@@) % موالذي ضم وده الأهواء % % والذي ساد غير مستنكر السؤ % % 349(@)(@@) % دد في الناسواعتلى كيف شاء % % قمر نجتليه ملء عيون % 350(@)(@@) % وصدور براعة وضياء % % لم يزل يجعل المساء صباحا % PageV01P191 351(@)(@@) % كلما بدل الصباح مساء % % قتل اليأس وهو مستحكم الأم % % 352(@)(@@) % روأحيا المطامع الأنضاء % % وارتضاه الأمير حين رآه % % 353(@)(@@) % وارتأى فيه رؤية وارتياء % % قال رأس الرؤوس لما رآه % % 354(@)(@@) % وصف البدر نفسه لاخفاء % % بشر البرق بالحياوسنا الصب % % 355(@)(@@) % ح بأن يقلب الدجى أضواء % % كل شيء أراه منك بشير % % 356(@)(@@) % صدق الله هذه البشراء % % وإذا مخابر الناس غابت % % 357(@)(@@) % عنك فاستشهد الوجوه الوضاء % % قال بالحق فيه ثم اجتباه % % 358(@)(@@) % واصطفاهوما أساء اصطفاء % % فغدا يوسع الرعية عدلا % % 359(@)(@@) % غير أني لقيت منه اعتداء % % أجميل بك اطراحيوقد قد % 360(@)(@@) % دمت في رأيك الجميل رجاء % % ولي 
ms49	 الطائر السعيد الذي كا % % PageV01P192 361(@)(@@) % ن بريدا بدولة زهراء % % ما تعرفت مذ تعيفت طيري % % 362(@)(@@) % غير نعماء ظاهرت نعماء % % ثم أدنيتني فزادك يمني % % 363(@)(@@) % من أمير مؤيد إدناء % % وتناولتني ببر فبرت % % 364(@)(@@) % ك يد الله ثرة بيضاء % % وكذا كلما نويت لمولا % % 365(@)(@@) % ك مزيدا أوتيتهوالهناء % % أنا مولاكأنت أعتقت رقي % % 366(@)(@@) % بعدما خفت حالة نكراء % % فعلام انصراف وجهك عني % % 367(@)(@@) % وتناسيكحاجتي إلغاء % % كان يأتيني الرسول فيهدي % % 368(@)(@@) % لي سروراويكبت الأعداء % % فقطعت الرسول عني ضنا % % 369(@)(@@) % باتخاذيه مفخرا وبهاء % % إن أكن غير محسن كل ما تط % % 370(@)(@@) % لب إني لمحسن أجزاء % % فمتى ما أردت صاحب فحص % % PageV01P193 371(@)(@@) % كنت ممن يشارك الحكماء % % ومتى ما أردت قارض شعر % % 372(@)(@@) % كنت ممن يساجل الشعراء % % ومتى ما خطبت منى خطيبا % 373(@)(@@) % جل خطبي ففاق بي الخطباء % % ومتى حاول الرسائل رسلي % % 374(@)(@@) % بلغتني بلاغتي البلغاء % % غير أني جعلت أمري إلى صف % % 375(@)(@@) % حك عن كل عورة إلجاء % % أنت ذاك الذي إذا لاح عيب % % 376(@)(@@) % جعل الستر دونه الإغضاء % % أنا عار من كل شيء سوى فض % % 377(@)(@@) % لكلا زلت كسوة وغطاء % % ولقائي إياك ماء الحياتي % % 378(@)(@@) % ن فلا تقطعن عني اللقاء % % سمني الخسف كله أقبل الخس % % 379(@)(@@) % ف بشكرولا تسمني الجفاء % % ليس بالناظرين صبر عن الوج % % 380(@)(@@) % ه الذي يجمع السنا والسناء % % منظر يملأ القلوب مع الأب % % PageV01P194 381(@)(@@) % صار نوراويضرح الأقذاء % % ليت شعري عن الفراسي والزج % 382(@)(@@) % جاج هل يرعيان مني الإخاء % % فيقولونإن موضع مولا % % 383(@)(@@) % ك عميرا أشف منه خلاء % % يالقوم أأثقل الأرض شخصي % % 384(@)(@@) % أم شكت من جفاء خلقي امتلاء % % أنا من خف واستدق فما يث % 385(@)(@@) % قل أرضا ولا يسد فضاء % % إن أكن عاطلا لديك من الآ % % 386(@)(@@) % لات حاشاك أن تجور غباء % % فلأكن عوذة لمجلسك المو % % 387(@)(@@) % نق أردد عين الردى عمياء % % أنا مولاكك بالمحبة والمي % 388(@)(@@) % ل فحمل عواتقي الأعباء % % وأنا المرء لا يحمل إلا % % 389(@)(@@) % شكر آلائكم لكم آلاء % % أدن شخصي إذا شدت لك بستا % % 390(@)(@@) % نوغنت غناءها غناء % فاستثارت من اللحود 
ms50	 المغن % PageV01P195 391(@)(@@) % نين فأضحى أمواتهم أحياء % يالإحضارها مع إبن سريج % 392(@)(@@) % معبدا والغريض والميلاء % وتلتها عجائب فتغنت % 393(@)(@@) % مشبهات اسمها صيابا ولاء % فحكت هذه وتلك يميني % 394(@)(@@) % ك إذا ما تبارتا إعطاء % وأبى الله عند ذلك أشبا % % 395(@)(@@) % ه غناء معلل إغناء % ما مغن غناك ندا لمغن % 396(@)(@@) % رفده يجمع الغنى والغناء % ذاولا تنسني إذا نشر البس % % 397(@)(@@) % تان أوصناف وشيه وتراءى % % وحكتك الرياض في الحسن والطي % % 398(@)(@@) % ب وإن كان ذاك منها اعتداء % وتغنى القمري فيها أخاه % % 399(@)(@@) % وأجابت مكاءة مكاء % % وأبدتكلحظها قضب النر % % 400(@)(@@) % جس ميلا إليك تحكي النساء % بقعة لا تني تفاخر عطا % % PageV01P196 401(@)(@@) % را وتشجيبوشيها وشاء % % لم تزل تستعير منك جمالا % 402(@)(@@) % تكتسيهوتستمير ثناء % % فجمال لمنظر وثناء % 403(@)(@@) % لمشم يحكي نثاك ذكاء % % واهو قربي إذا شرعت على دج % 404(@)(@@) % لة في ظل ليلة قمراء % % وحكت دجلة انهلالك بالنا % % 405(@)(@@) % ئل والعلمواكتست لألاء % % وأعارت هواء دارك ثوبا % 406(@)(@@) % من نداهافكان ماء هواء % % فحكى منك نعمة الخلق النا % % 407(@)(@@) % عم في كل حالة إثناء % % وأجاب الملاح في بطنها المل % 408(@)(@@) % لاح يحتث بالسفين الحداء % % وادكرني إذا استثرت سحابا % 409(@)(@@) % ذات يوم عشية أو ضحاء % % فتعالت فوارة تحسد الخض % % 410(@)(@@) % راء إغداق مائها الغبراء % % كلما أخلفت سماء زمانا % PageV01P197 411(@)(@@) % خلفت فيه ديمة هطلاء % % سحسحت ماءها على أرض % 412(@)(@@) % بعدما صافحت به الجوزاء % % فحكت كفك التي تخلف المز % % 413(@)(@@) % ن علينا فترغم الأنواء % % وتأمل إذا لحظت بعيني % % 414(@)(@@) % ك صحونا لاتعرف الانتهاء % % وحكتك الصمان في سعة الصد % % 415(@)(@@) % ر وإن كان صدرك الدهناء % % جعل الله كل ذاك فداء % % 416(@)(@@) % لكإن كان للفداء كفاء % % لو بذلنا فداءك الشمس والبد % % 417(@)(@@) % رلقال الزمانزيدوا فداء % % لا تجاهل هناكيا من أبي الل % % 418(@)(@@) % ه عليه أن يشبه الجهلاء % % حسن علمي إذ ذاك بالحسن المو % % 419(@)(@@) % قع مما يروي القلوب الظماء % % وارتفاعي عن الجفاة المسوي % % 420(@)(@@) % ن بشدو المجيدة الضوضاء % % موجب أن أكون أدنى جليس % % PageV01P198 421(@)(@@) % لكأعلو بحقي الجلساء % % أركيكا رأيت عبدكصفرا % % 422(@)(@@) % لاجنى فيه 
ms51	 أم جنى شنعاء % % لاتدع مغرس الكريم من الغر % % 423(@)(@@) % س خلاء من الكريم قواء % % أين مثلي مفاتش لك أم أي % % 424(@)(@@) % ن نديم تعده ندماء % % شهد الله والموازين والقس % % 425(@)(@@) % ط جميعا شهادة إمضاء % % أن رأيي لذو الرجاحة وزنا % % 426(@)(@@) % دع يمينيوزنه والآراء % % أنت شهم محصل فاترك الأس % % 427(@)(@@) % ماء للبلهواكشف الأنباء % % ما تقصيت ما لدي ولا استق % % 428(@)(@@) % صيتفاجعل إقصاءك استقصاء % % وانتبه لي من رقدة الملك تعلم % % 429(@)(@@) % أن لله معشرا علماء % % وتذكر معاهدي إنك المر % % 430(@)(@@) % ء الذي ما عهدته نساء % % وارع لي حرمة المودة والخد % % PageV01P199 431(@)(@@) % مة والمدح تعجب الكرماء % % وجديرون بالرعاية قوم % % 432(@)(@@) % جعلتهم رعاة ملك رعاء % % قد تجرعت من جفائك لما % % 433(@)(@@) % سمتني ذاك شربة كدراء % % ولقد يقلب الكريم من السا % % 434(@)(@@) % دات نعماء عبده بأساء % % ظالما أو مقوما ثم يرعا % % 435(@)(@@) % ه ويقنى حرية وحياء % % فإذا زالت المسرة عادت % % 436(@)(@@) % وإذا ما تحسر الظل فاء % % فلماذا رمى هناك صفاتي % % 437(@)(@@) % أصفيائي عدمتهم أصفياء % % إنما كان حق مثلي أن ير % % 438(@)(@@) % حملاقوا أعداءهم رحماء % % بل رأوا رحمة الأعاديولا قو % % 439(@)(@@) % هم ملاء بعسفهم أوفياء % % وجزاهم رب الحزاء على ذا % % 440(@)(@@) % لك ما يشبه اللئيم جزاء % % معشر كنت خلتهم قبل بلوا % % PageV01P200 441(@)(@@) % ي أوداء صفوة أصدقاء % % صادفو نكبتي فكانت لديهم % % 442(@)(@@) % للقلوب المراض منهم شفاء % % وأظنوك أن ذاك وفاء % % 443(@)(@@) % من موال يصححون الولاء % % فبدا منهم بلاء ذميم % % 444(@)(@@) % أشبعوه خيانة ورياء % % ماأتى منهم نذير بعتب % % 445(@)(@@) % فيلقى هناك داء دواء % % لا ولا جاء بعد ذاك بشير % % 446(@)(@@) % برضا ثابت يقيم الذماء % % لا ولا جاء بين ذاك وهذا % % 447(@)(@@) % مترت يعلل الحوباء % % لم يواسوا ولم يؤسوا خليلا % % 448(@)(@@) % سوءة سوءة لهم سواء % % منعوا خيرهمولا تأمن الضر % % 449(@)(@@) % ر من المانعين منك الجداء % % فأتى شرهم على كل بقيا % % 450(@)(@@) % لا لقوا من ملمة إبقاء % % خلفوني خلافة الذئب في الش % % PageV01P201 451(@)(@@) % شاءوكانوا في جهل حقي شاء % % وإذا ما حماك عود جناه % % 452(@)(@@) % فاخش من حد شوكه أنكاء % % وكأني 
ms52	 غدا أراهم وكل % % 453(@)(@@) % ينشر العذر طاويا شحناء % % سعر الله في الجوانح منهم % % 454(@)(@@) % سعرة النارتلكم البغضاء % % لاعدتهم هناك هاتيك نارا % % 455(@)(@@) % وأصابت من شخصي الإخطاء % % حرقتهم وأرقتهم ولا زا % % 456(@)(@@) % لت وبالا عليهم ووباء % % رتعوا في وخيمة الغيب مني % % 457(@)(@@) % لا تلقي من ارتعاها مراء % % أظهروا للوزير جهلا وغدرا % % 458(@)(@@) % وعما هم يراهم أدباء % % فجلوا عورة لطرف جل ي % % 459(@)(@@) % حسبوا شمسه تغشت عماء % % جعلوا العبد كفء مولاهفانظر % % 460(@)(@@) % هل تراهم لعاقل أكفاء % % ما تعدوا بذاك أن وزنوني % % PageV01P202 461(@)(@@) % بكضلت عقولهم عقلاء % % غفلة فوق غفلة ثم سهوا % % 462(@)(@@) % فوق سهوعدمتهم أذكياء % % فلهم لائمون فيما أتوه % % 463(@)(@@) % ورأوهلا يعدموا اللوماء % % خذلوني وطأطئوا البدر جهلا % % 464(@)(@@) % وتظنوه يخبط الظلماء % % لاعفا الله عنهم بل عفاهم % % 465(@)(@@) % وزوى العفو عنهم لا العفاء % % ما ائتلاك الإخوانكلا بل الخو % % 466(@)(@@) % وان قاسوا أمثلهم خلطاء % % آفتي فيك أن رأيت محبا % % 467(@)(@@) % لايرى عنك بالغنى استغناء % % لاتطاول بحسن وجهك والدو % % 468(@)(@@) % لة واذكر من شانئيك الفناء % % واحتشم أن يراك معطيك ما أع % % 469(@)(@@) % طاك تجزي نعماءه خيلاء % % وارتفع أن يراك تكسو الفتى الحر % % 470(@)(@@) % ر إذا ما ملكته الإزراء % % إن من أضعف الضعاف لدى الل % PageV01P203 471(@)(@@) % ه قويا يستضعف الضعفاء % % ولأهل العقول فيه رجاء % % 472(@)(@@) % وعزاء يقاوم العزاء % % وتعلم متى حميت على عب % % 473(@)(@@) % دك تلك المياه والأكلاء % % أن الله غير مرعاك مرعى % % 474(@)(@@) % يرتعيهوغير مائك ماء % % وتيقن متى جنيت على عبد % % 475(@)(@@) % ك ضيما وضيعة وعناء % % أن لله بالبرية لطفا % % 476(@)(@@) % سبق الأمهات والآباء % % قد أطلت العتاب جداوأكثر % % 477(@)(@@) % ت فضولي لكن لي شركاء % % من دعاني إلى الذي كان مني % % 478(@)(@@) % فهو مثلي جلية لاامتراء % % أنا ذو القصد غير أني متى آ % % 479(@)(@@) % نست جورا رأيت لي غلواء % % والحليم العليم من يحسن الإي % % 480(@)(@@) % قاد بدءاويحسن الإطفاء % % والطبيب اللبيب من يتبع الدا % % PageV01P204 481(@)(@@) % ء دواء يشفيه لا الداء داء % % وعسى قائل يقول بجهل % % 482(@)(@@) % إنما يطلب الغنى والغناء % % ولهذين مطلب عند قوم % % 483(@)(@@) % لست ألفي لرحلهم 
ms53	 غشاء % % والغنى واسع بكفي جواد % % 484(@)(@@) % يرزق الأغنياء والفقراء % % لي خمسون صاحبا لو سألت ال % % 485(@)(@@) % قوت فيهم ألفيتهم سمحاء % % أترى كل صاحب لي منهم % % 486(@)(@@) % يمنع الشهر بلغتي إجراء % % لي في درهمين في كل شهر % % 487(@)(@@) % من فئام ما يطرد الحوجاء % % والغناء الشديد شدوا وضربا % 488(@)(@@) % سحنة قد ملأت منها الإناء % % ولحسبي عرفان آل بنان % % 489(@)(@@) % وبنان شربا معينا رواء % % ظلت عشرا كواملا في مغاني % % 490(@)(@@) % ه أغني وأسمع الأنجاء % % فليقم كاشحي بنقض الذي قل % % PageV01P205 491(@)(@@) % ت وإلا فليطرق استحياء % % أو فرغما له هناك ودغما % % 492(@)(@@) % ألحم الله أنفه البوغاء % % لاتقدر بحسن وجهك صيدي % % 493(@)(@@) % بعد نفري كما تصيد الظباء % % صد بذاك المها تصدهاوهيها % % 494(@)(@@) % ت تصيد المصمم الأباء % % أنا ليث الليوث نفساوإن كن % % 495(@)(@@) % ت بجسمي ضئيلة رقشاء % % إنني إن نفرت أمعنت في النف % % 496(@)(@@) % رومثلي عمن تناءى تناءى % % لست باللقطة الخسيسة فاعرف % % 497(@)(@@) % لي قدريواسأل به الفهماء % % وانتفع بالعلا بذهنكواذمم % % 498(@)(@@) % كل ذهن لا ينفع الذهناء % % قد بغى قبلك الدعي فلم أح % % 499(@)(@@) % فل بأن كان باغيا بغاء % % بل تبصرت وانتظرت من الل % % 500(@)(@@) % ه نآدا تصيبه دهياء % % فاعتبر بابن بلبل إن فيه % % PageV01P206 501(@)(@@) % عبرة لامرىء أعد وعاء % % والعلاء بن صاعد قبل هذا % % 502(@)(@@) % قد حمى دون رائدي الأحماء % % فارم بالطرف شخصه هل تراه % % 503(@)(@@) % وادعه الدهر هل يجيب دعاء % % ليس إلا لأنني كنت شمسا % 504(@)(@@) % قابلت منه مقلة عشواء % % فأرانيه ناصري وأباه % % 505(@)(@@) % وله الحمد مثلة شوهاء % % أنا عبد الإنصافقرن التعدي % % 506(@)(@@) % فاسلك القصد بيوعد العداء % % أنا ذو صفحتينملساء حس % % 507(@)(@@) % ناءوأخرى تمسها خشناء % % خاشع تارة وجبار أخرى % % 508(@)(@@) % فتراني أرضا وطورا سماء % % لا بحول ولا بقوة ركن % % 509(@)(@@) % غير لبسي تجلدا وحياء % % أنا جلد على عناد الأحاظي % % 510(@)(@@) % وأبي أن أرأم النكراء % % فمتى شئت فامتحنيوأولى % % PageV01P207 511(@)(@@) % بك عفو يقابل استعفاء % % أنا ذاك الذي سقته يد السق % 512(@)(@@) % م كؤوسا من المرار رواء % % ورأيت الحمام في الصور الشن % 513(@)(@@) % عوكانت لولا القضاء قضاء % % ورماه الزمان في 
ms54	 شقة النف % 514(@)(@@) % س فأصمى فؤاده إصماء % % وابتلاه بالعسر في ذاك والوح % 515(@)(@@) % شة حتى أمل منه البلاء % % وثكلت الشباب بعد رضاع % 516(@)(@@) % كان قبل الغذاء قدما غذاء % كل هذا لقيته فأبت نف % % 517(@)(@@) % سي إلا تعززا لااختتاء % % وأرى ذلتي تريك هواني % % 518(@)(@@) % ودنوي يزيدني إقصاء % % ومتى ما فزعت منك إلى الصب % 519(@)(@@) % ر فناديته أجاب النداء % % ومتى ما دعوت ربي على الده % % 520(@)(@@) % ر الخطوب لبى الدعاء % % وإباء الهوان عدوى أتتني % % PageV01P208 521(@)(@@) % منكوالعبد يقبل الإعداء % % أنت علمتني إباء الدنايا % % 522(@)(@@) % يا مليكيفما أسأت الأداء % % وعزيز علي أن قلت ما قل % % 523(@)(@@) % هتولكن حرقتني إحماء % % أنت شجعتني على الصدق في القو % % 524(@)(@@) % لوأركبت جنبي العوصاء % % قد نفثت الأدواء نفث ولي % 525(@)(@@) % والعدو المكمن الأدواء % % أنت أعلى من أن تقول أعدا % % 526(@)(@@) % ءك قولا يضرب الأولياء % % إن وزني في الرأي وزن ثقيل % % 527(@)(@@) % فاسأل الرأي عنه لا الأهواء % % يا جوادا هجا مديحيه بالحر % % 528(@)(@@) % مان ما اسطاع لاتكن هجاء % % إن بخس الثواب إن دام ظلما % 529(@)(@@) % قلب المدح ذات يوم هجاء % % ليس من قائل المديح ولكن % 530(@)(@@) % من أناس تدعوهم الغوغاء % أو من المنكرين وعظ المحقي % % PageV01P209 531(@)(@@) % ن وإن لم يلقبوا شعراء % % وبرغمي هناك تسمع أذنا % % 532(@)(@@) % ي ولكن من يضبط الدهماء % % والتكاليف لاتحد اتساعا % 533(@)(@@) % وكثير من ينصر البعداء % % كم رأيت المكلفين جنودا % 534(@)(@@) % ينصرون الأباعد الغرباء % % ولحى الله مسمعا لي فيكم % % 535(@)(@@) % يتوخى بمسخط إرضاء % % ولما سر جائعا رفد كف % 536(@)(@@) % أطعمته من شلوه أعضاء % % لو سواي استمال مال إليه % % 537(@)(@@) % ولألقى لناره حلفاء % % لكن الله شاهد أن نفسي % % 538(@)(@@) % تمنح السيف عند ذاك انتضاء % % لي عين هواي فيكم يريها % % 539(@)(@@) % من جلاها بلومكم إقذاء % % وجميل المقال فيكم وحظي % % 540(@)(@@) % من جداكم مما أراه سواء % % وأرى حر أن تلاموا حريقا % PageV01P210 541(@)(@@) % وأرى حر ظلمكم رمضاء % % فاظلموا جهدكم فلن تستطيعوا % % 542(@)(@@) % أبدا أن توغروا الأحشاء % % رسخ الحب في عظاميوجارى % % 543(@)(@@) % في عروقي قبل ذاك الغذاء % % ومن الجور أن تجازى يد 
ms55	 بي % % 544(@)(@@) % ضاء من مخلص يدا سوداء % % موالذي ضم وده الأهواء % % 545(@)(@@) % والذي ساد غير مستنكر السؤ % % دد في الناسواعتلى كيف شاء % % 546(@)(@@) % قمر نجتليه ملء عيون % وصدور براعة وضياء % % 547(@)(@@) % لم يزل يجعل المساء صباحا % كلما بدل الصباح مساء % % 548(@)(@@) % قتل اليأس وهو مستحكم الأم % % روأحيا المطامع الأنضاء % % 549(@)(@@) % وارتضاه الأمير حين رآه % % وارتأى فيه رؤية وارتياء % % 550(@)(@@) % قال رأس الرؤوس لما رآه % % وصف البدر نفسه لاخفاء % % PageV01P211 551(@)(@@) % بشر البرق بالحياوسنا الصب % % ح بأن يقلب الدجى أضواء % % 552(@)(@@) % كل شيء أراه منك بشير % % صدق الله هذه البشراء % % 553(@)(@@) % وإذا مخابر الناس غابت % % عنك فاستشهد الوجوه الوضاء % % 554(@)(@@) % قال بالحق فيه ثم اجتباه % % واصطفاهوما أساء اصطفاء % % 555(@)(@@) % فغدا يوسع الرعية عدلا % % غير أني لقيت منه اعتداء % % 556(@)(@@) % أجميل بك اطراحيوقد قد % دمت في رأيك الجميل رجاء % % 557(@)(@@) % ولي الطائر السعيد الذي كا % % ن بريدا بدولة زهراء % % 558(@)(@@) % ما تعرفت مذ تعيفت طيري % % غير نعماء ظاهرت نعماء % % 559(@)(@@) % ثم أدنيتني فزادك يمني % % من أمير مؤيد إدناء % % 560(@)(@@) % وتناولتني ببر فبرت % % ك يد الله ثرة بيضاء % % PageV01P212 561(@)(@@) % وكذا كلما نويت لمولا % % ك مزيدا أوتيتهوالهناء % % 562(@)(@@) % أنا مولاكأنت أعتقت رقي % % بعدما خفت حالة نكراء % % 563(@)(@@) % فعلام انصراف وجهك عني % % وتناسيكحاجتي إلغاء % % 564(@)(@@) % كان يأتيني الرسول فيهدي % % لي سروراويكبت الأعداء % % 565(@)(@@) % فقطعت الرسول عني ضنا % % باتخاذيه مفخرا وبهاء % % 566(@)(@@) % إن أكن غير محسن كل ما تط % % لب إني لمحسن أجزاء % % 567(@)(@@) % فمتى ما أردت صاحب فحص % % كنت ممن يشارك الحكماء % % 568(@)(@@) % ومتى ما أردت قارض شعر % % كنت ممن يساجل الشعراء % % 569(@)(@@) % ومتى ما خطبت منى خطيبا % جل خطبي ففاق بي الخطباء % % 570(@)(@@) % ومتى حاول الرسائل رسلي % % بلغتني بلاغتي البلغاء % % PageV01P213 571(@)(@@) % غير أني جعلت أمري إلى صف % % حك عن كل عورة إلجاء % % 572(@)(@@) % أنت ذاك الذي إذا لاح عيب % % جعل الستر دونه الإغضاء % % 573(@)(@@) % أنا عار من كل شيء سوى فض % % لكلا زلت كسوة وغطاء % % 574(@)(@@) % ولقائي إياك ماء الحياتي % % ن فلا تقطعن عني اللقاء 
ms56	 % % 575(@)(@@) % سمني الخسف كله أقبل الخس % % ف بشكرولا تسمني الجفاء % % 576(@)(@@) % ليس بالناظرين صبر عن الوج % % ه الذي يجمع السنا والسناء % % 577(@)(@@) % منظر يملأ القلوب مع الأب % % صار نوراويضرح الأقذاء % % 578(@)(@@) % ليت شعري عن الفراسي والزج % جاج هل يرعيان مني الإخاء % % 579(@)(@@) % فيقولونإن موضع مولا % % ك عميرا أشف منه خلاء % % 580(@)(@@) % يالقوم أأثقل الأرض شخصي % % أم شكت من جفاء خلقي امتلاء % % PageV01P214 581(@)(@@) % أنا من خف واستدق فما يث % قل أرضا ولا يسد فضاء % % 582(@)(@@) % إن أكن عاطلا لديك من الآ % % لات حاشاك أن تجور غباء % % 583(@)(@@) % فلأكن عوذة لمجلسك المو % % نق أردد عين الردى عمياء % % 584(@)(@@) % أنا مولاكك بالمحبة والمي % ل فحمل عواتقي الأعباء % % 585(@)(@@) % وأنا المرء لا يحمل إلا % % شكر آلائكم لكم آلاء % % 586(@)(@@) % أدن شخصي إذا شدت لك بستا % % نوغنت غناءها غناء % 587(@)(@@) % فاستثارت من اللحود المغن % نين فأضحى أمواتهم أحياء % 588(@)(@@) % يالإحضارها مع إبن سريج % معبدا والغريض والميلاء % 589(@)(@@) % وتلتها عجائب فتغنت % مشبهات اسمها صيابا ولاء % 590(@)(@@) % فحكت هذه وتلك يميني % ك إذا ما تبارتا إعطاء % PageV01P215 591(@)(@@) % وأبى الله عند ذلك أشبا % % ه غناء معلل إغناء % 592(@)(@@) % ما مغن غناك ندا لمغن % رفده يجمع الغنى والغناء % 593(@)(@@) % ذاولا تنسني إذا نشر البس % % تان أوصناف وشيه وتراءى % % 594(@)(@@) % وحكتك الرياض في الحسن والطي % % ب وإن كان ذاك منها اعتداء % 595(@)(@@) % وتغنى القمري فيها أخاه % % وأجابت مكاءة مكاء % % 596(@)(@@) % وأبدتكلحظها قضب النر % % جس ميلا إليك تحكي النساء % 597(@)(@@) % بقعة لا تني تفاخر عطا % % را وتشجيبوشيها وشاء % % 598(@)(@@) % لم تزل تستعير منك جمالا % تكتسيهوتستمير ثناء % % 599(@)(@@) % فجمال لمنظر وثناء % لمشم يحكي نثاك ذكاء % % 600(@)(@@) % واهو قربي إذا شرعت على دج % لة في ظل ليلة قمراء % % PageV01P216 601(@)(@@) % وحكت دجلة انهلالك بالنا % % ئل والعلمواكتست لألاء % % 602(@)(@@) % وأعارت هواء دارك ثوبا % من نداهافكان ماء هواء % % 603(@)(@@) % فحكى منك نعمة الخلق النا % % عم في كل حالة إثناء % % 604(@)(@@) % وأجاب الملاح في بطنها المل % لاح يحتث بالسفين الحداء % % 605(@)(@@) % وادكرني إذا استثرت سحابا % ذات يوم 
ms57	 عشية أو ضحاء % % 606(@)(@@) % فتعالت فوارة تحسد الخض % % راء إغداق مائها الغبراء % % 607(@)(@@) % كلما أخلفت سماء زمانا % خلفت فيه ديمة هطلاء % % 608(@)(@@) % سحسحت ماءها على أرض % بعدما صافحت به الجوزاء % % 609(@)(@@) % فحكت كفك التي تخلف المز % % ن علينا فترغم الأنواء % % 610(@)(@@) % وتأمل إذا لحظت بعيني % % ك صحونا لاتعرف الانتهاء % % PageV01P217 611(@)(@@) % وحكتك الصمان في سعة الصد % % ر وإن كان صدرك الدهناء % % 612(@)(@@) % جعل الله كل ذاك فداء % % لكإن كان للفداء كفاء % % 613(@)(@@) % لو بذلنا فداءك الشمس والبد % % رلقال الزمانزيدوا فداء % % 614(@)(@@) % لا تجاهل هناكيا من أبي الل % % ه عليه أن يشبه الجهلاء % % 615(@)(@@) % حسن علمي إذ ذاك بالحسن المو % % قع مما يروي القلوب الظماء % % 616(@)(@@) % وارتفاعي عن الجفاة المسوي % % ن بشدو المجيدة الضوضاء % % 617(@)(@@) % موجب أن أكون أدنى جليس % % لكأعلو بحقي الجلساء % % 618(@)(@@) % أركيكا رأيت عبدكصفرا % % لاجنى فيه أم جنى شنعاء % % 619(@)(@@) % لاتدع مغرس الكريم من الغر % % س خلاء من الكريم قواء % % 620(@)(@@) % أين مثلي مفاتش لك أم أي % % ن نديم تعده ندماء % % PageV01P218 621(@)(@@) % شهد الله والموازين والقس % % ط جميعا شهادة إمضاء % % 622(@)(@@) % أن رأيي لذو الرجاحة وزنا % % دع يمينيوزنه والآراء % % 623(@)(@@) % أنت شهم محصل فاترك الأس % % ماء للبلهواكشف الأنباء % % 624(@)(@@) % ما تقصيت ما لدي ولا استق % % صيتفاجعل إقصاءك استقصاء % % 625(@)(@@) % وانتبه لي من رقدة الملك تعلم % % أن لله معشرا علماء % % 626(@)(@@) % وتذكر معاهدي إنك المر % % ء الذي ما عهدته نساء % % 627(@)(@@) % وارع لي حرمة المودة والخد % % مة والمدح تعجب الكرماء % % 628(@)(@@) % وجديرون بالرعاية قوم % % جعلتهم رعاة ملك رعاء % % 629(@)(@@) % قد تجرعت من جفائك لما % % سمتني ذاك شربة كدراء % % 630(@)(@@) % ولقد يقلب الكريم من السا % % دات نعماء عبده بأساء % % PageV01P219 631(@)(@@) % ظالما أو مقوما ثم يرعا % % ه ويقنى حرية وحياء % % 632(@)(@@) % فإذا زالت المسرة عادت % % وإذا ما تحسر الظل فاء % % 633(@)(@@) % فلماذا رمى هناك صفاتي % % أصفيائي عدمتهم أصفياء % % 634(@)(@@) % إنما كان حق مثلي أن ير % % حملاقوا أعداءهم رحماء % % 635(@)(@@) % بل رأوا رحمة الأعاديولا قو % % هم ملاء بعسفهم أوفياء % % 636(@)(@@) % وجزاهم رب الحزاء 
ms58	 على ذا % % لك ما يشبه اللئيم جزاء % % 637(@)(@@) % معشر كنت خلتهم قبل بلوا % % ي أوداء صفوة أصدقاء % % 638(@)(@@) % صادفو نكبتي فكانت لديهم % % للقلوب المراض منهم شفاء % % 639(@)(@@) % وأظنوك أن ذاك وفاء % % من موال يصححون الولاء % % 640(@)(@@) % فبدا منهم بلاء ذميم % % أشبعوه خيانة ورياء % % PageV01P220 641(@)(@@) % ماأتى منهم نذير بعتب % % فيلقى هناك داء دواء % % 642(@)(@@) % لا ولا جاء بعد ذاك بشير % % برضا ثابت يقيم الذماء % % 643(@)(@@) % لا ولا جاء بين ذاك وهذا % % مترت يعلل الحوباء % % 644(@)(@@) % لم يواسوا ولم يؤسوا خليلا % % سوءة سوءة لهم سواء % % 645(@)(@@) % منعوا خيرهمولا تأمن الضر % % ر من المانعين منك الجداء % % 646(@)(@@) % فأتى شرهم على كل بقيا % % لا لقوا من ملمة إبقاء % % 647(@)(@@) % خلفوني خلافة الذئب في الش % % شاءوكانوا في جهل حقي شاء % % 648(@)(@@) % وإذا ما حماك عود جناه % % فاخش من حد شوكه أنكاء % % 649(@)(@@) % وكأني غدا أراهم وكل % % ينشر العذر طاويا شحناء % % 650(@)(@@) % سعر الله في الجوانح منهم % % سعرة النارتلكم البغضاء % % PageV01P221 651(@)(@@) % لاعدتهم هناك هاتيك نارا % % وأصابت من شخصي الإخطاء % % 652(@)(@@) % حرقتهم وأرقتهم ولا زا % % لت وبالا عليهم ووباء % % 653(@)(@@) % رتعوا في وخيمة الغيب مني % % لا تلقي من ارتعاها مراء % % 654(@)(@@) % أظهروا للوزير جهلا وغدرا % % وعما هم يراهم أدباء % % 655(@)(@@) % فجلوا عورة لطرف جل ي % % حسبوا شمسه تغشت عماء % % 656(@)(@@) % جعلوا العبد كفء مولاهفانظر % % هل تراهم لعاقل أكفاء % % 657(@)(@@) % ما تعدوا بذاك أن وزنوني % % بكضلت عقولهم عقلاء % % 658(@)(@@) % غفلة فوق غفلة ثم سهوا % % فوق سهوعدمتهم أذكياء % % 659(@)(@@) % فلهم لائمون فيما أتوه % % ورأوهلا يعدموا اللوماء % % 660(@)(@@) % خذلوني وطأطئوا البدر جهلا % % وتظنوه يخبط الظلماء % % PageV01P222 661(@)(@@) % لاعفا الله عنهم بل عفاهم % % وزوى العفو عنهم لا العفاء % % 662(@)(@@) % ما ائتلاك الإخوانكلا بل الخو % % وان قاسوا أمثلهم خلطاء % % 663(@)(@@) % آفتي فيك أن رأيت محبا % % لايرى عنك بالغنى استغناء % % 664(@)(@@) % لاتطاول بحسن وجهك والدو % % لة واذكر من شانئيك الفناء % % 665(@)(@@) % واحتشم أن يراك معطيك ما أع % % طاك تجزي نعماءه خيلاء % % 666(@)(@@) % وارتفع أن يراك تكسو الفتى الحر % % ر إذا ما ملكته الإزراء % % 667 
ms59	(@)(@@) % إن من أضعف الضعاف لدى الل % ه قويا يستضعف الضعفاء % % 668(@)(@@) % ولأهل العقول فيه رجاء % % وعزاء يقاوم العزاء % % 669(@)(@@) % وتعلم متى حميت على عب % % دك تلك المياه والأكلاء % % 670(@)(@@) % أن الله غير مرعاك مرعى % % يرتعيهوغير مائك ماء % % PageV01P223 671(@)(@@) % وتيقن متى جنيت على عبد % % ك ضيما وضيعة وعناء % % 672(@)(@@) % أن لله بالبرية لطفا % % سبق الأمهات والآباء % % 673(@)(@@) % قد أطلت العتاب جداوأكثر % % ت فضولي لكن لي شركاء % % 674(@)(@@) % من دعاني إلى الذي كان مني % % فهو مثلي جلية لاامتراء % % 675(@)(@@) % أنا ذو القصد غير أني متى آ % % نست جورا رأيت لي غلواء % % 676(@)(@@) % والحليم العليم من يحسن الإي % % قاد بدءاويحسن الإطفاء % % 677(@)(@@) % والطبيب اللبيب من يتبع الدا % % ء دواء يشفيه لا الداء داء % % 678(@)(@@) % وعسى قائل يقول بجهل % % إنما يطلب الغنى والغناء % % 679(@)(@@) % ولهذين مطلب عند قوم % % لست ألفي لرحلهم غشاء % % 680(@)(@@) % والغنى واسع بكفي جواد % % يرزق الأغنياء والفقراء % % PageV01P224 681(@)(@@) % لي خمسون صاحبا لو سألت ال % % قوت فيهم ألفيتهم سمحاء % % 682(@)(@@) % أترى كل صاحب لي منهم % % يمنع الشهر بلغتي إجراء % % 683(@)(@@) % لي في درهمين في كل شهر % % من فئام ما يطرد الحوجاء % % 684(@)(@@) % والغناء الشديد شدوا وضربا % سحنة قد ملأت منها الإناء % % 685(@)(@@) % ولحسبي عرفان آل بنان % % وبنان شربا معينا رواء % % 686(@)(@@) % ظلت عشرا كواملا في مغاني % % ه أغني وأسمع الأنجاء % % 687(@)(@@) % فليقم كاشحي بنقض الذي قل % % ت وإلا فليطرق استحياء % % 688(@)(@@) % أو فرغما له هناك ودغما % % ألحم الله أنفه البوغاء % % 689(@)(@@) % لاتقدر بحسن وجهك صيدي % % بعد نفري كما تصيد الظباء % % 690(@)(@@) % صد بذاك المها تصدهاوهيها % % ت تصيد المصمم الأباء % % PageV01P225 691(@)(@@) % أنا ليث الليوث نفساوإن كن % % ت بجسمي ضئيلة رقشاء % % 692(@)(@@) % إنني إن نفرت أمعنت في النف % % رومثلي عمن تناءى تناءى % % 693(@)(@@) % لست باللقطة الخسيسة فاعرف % % لي قدريواسأل به الفهماء % % 694(@)(@@) % وانتفع بالعلا بذهنكواذمم % % كل ذهن لا ينفع الذهناء % % 695(@)(@@) % قد بغى قبلك الدعي فلم أح % % فل بأن كان باغيا بغاء % % 696(@)(@@) % بل تبصرت وانتظرت من الل % % ه نآدا تصيبه دهياء % % 697(@)(@@) % فاعتبر 
ms60	 بابن بلبل إن فيه % % عبرة لامرىء أعد وعاء % % 698(@)(@@) % والعلاء بن صاعد قبل هذا % % قد حمى دون رائدي الأحماء % % 699(@)(@@) % فارم بالطرف شخصه هل تراه % % وادعه الدهر هل يجيب دعاء % % 700(@)(@@) % ليس إلا لأنني كنت شمسا % قابلت منه مقلة عشواء % % PageV01P226 701(@)(@@) % فأرانيه ناصري وأباه % % وله الحمد مثلة شوهاء % % 702(@)(@@) % أنا عبد الإنصافقرن التعدي % % فاسلك القصد بيوعد العداء % % 703(@)(@@) % أنا ذو صفحتينملساء حس % % ناءوأخرى تمسها خشناء % % 704(@)(@@) % خاشع تارة وجبار أخرى % % فتراني أرضا وطورا سماء % % 705(@)(@@) % لا بحول ولا بقوة ركن % % غير لبسي تجلدا وحياء % % 706(@)(@@) % أنا جلد على عناد الأحاظي % % وأبي أن أرأم النكراء % % 707(@)(@@) % فمتى شئت فامتحنيوأولى % % بك عفو يقابل استعفاء % % 708(@)(@@) % أنا ذاك الذي سقته يد السق % م كؤوسا من المرار رواء % % 709(@)(@@) % ورأيت الحمام في الصور الشن % عوكانت لولا القضاء قضاء % % 710(@)(@@) % ورماه الزمان في شقة النف % س فأصمى فؤاده إصماء % % PageV01P227 711(@)(@@) % وابتلاه بالعسر في ذاك والوح % شة حتى أمل منه البلاء % % 712(@)(@@) % وثكلت الشباب بعد رضاع % كان قبل الغذاء قدما غذاء % 713(@)(@@) % كل هذا لقيته فأبت نف % % سي إلا تعززا لااختتاء % % 714(@)(@@) % وأرى ذلتي تريك هواني % % ودنوي يزيدني إقصاء % % 715(@)(@@) % ومتى ما فزعت منك إلى الصب % ر فناديته أجاب النداء % % 716(@)(@@) % ومتى ما دعوت ربي على الده % % ر الخطوب لبى الدعاء % % 717(@)(@@) % وإباء الهوان عدوى أتتني % % منكوالعبد يقبل الإعداء % % 718(@)(@@) % أنت علمتني إباء الدنايا % % يا مليكيفما أسأت الأداء % % 719(@)(@@) % وعزيز علي أن قلت ما قل % % تولكن حرقتني إحماء % % 720(@)(@@) % أنت شجعتني على الصدق في القو % % لوأركبت جنبي العوصاء % % PageV01P228 721(@)(@@) % قد نفثت الأدواء نفث ولي % والعدو المكمن الأدواء % % 722(@)(@@) % أنت أعلى من أن تقول أعدا % % ءك قولا يضرب الأولياء % % 723(@)(@@) % إن وزني في الرأي وزن ثقيل % % فاسأل الرأي عنه لا الأهواء % % 724(@)(@@) % يا جوادا هجا مديحيه بالحر % % مان ما اسطاع لاتكن هجاء % % 725(@)(@@) % إن بخس الثواب إن دام ظلما % قلب المدح ذات يوم هجاء % % 726(@)(@@) % ليس من قائل المديح ولكن % من أناس تدعوهم الغوغاء % 727(@)(@@) % أو من 