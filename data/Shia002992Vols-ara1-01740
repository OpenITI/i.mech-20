ms1730	 الفضيل، وروى عنه أحمد بن أبي عبد الله.(@)(@@) الكافي: ج 6، ك 4، ب 10، ح 2.(@)(@@) والتهذيب: ج 9، ح 52 (الاستبصار:(@)(@@) ج 4، ح 231)، و 86 (الاستبصار: ج 4، ح 231).(@)(@@) وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 5، ك 2 ب 24، ح 2.(@)(@@) وروى عنه أحمد بن محمد بن عيسى.(@)(@@) التهذيب: ج 6، ح 401.(@)(@@) وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 3، ك 3، ب 43، ح 3.(@)(@@) والتهذيب: ج 1، ح 1482.(@)(@@) * وروى عن محمد بن يحيى، وروى PageV06P321(@)(@@) عنه الحسن بن محبوب.(@)(@@) التهذيب: ج 10، ح 52.(@)(@@) * وروى عن مروان بن مسلم، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 2، ك 1، ب 98، ح 9.(@)(@@) وروى عنه الهيثم بن أبي مسروق.(@)(@@) الكافي: ج 3، ك 5، ب 44، ح 1.(@)(@@) والتهذيب: ج 4، ح 293.(@)(@@) * وروى عن معاذ بن مسلم، وروى عنه محمد بن خالد.(@)(@@) التهذيب: ج 2، ح 762 (الاستبصار:(@)(@@) ج 1، ح 1426).(@)(@@) * وروى عن مفضل بن صالح أبي جميلة، وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 3، ك 3، ب 87، ح 1.(@)(@@) * وروى عن الوليد بن مدرك، وروى عنه الحسين بن سعيد.(@)(@@) التهذيب: ج 6، ح 999.(@)(@@) * وروى عن وهب الحريري، وروى عنه صالح.(@)(@@) التهذيب: ج 6، ح 1156.(@)(@@) وروى عنه صالح بن أبي حماد.(@)(@@) الكافي: ج 5، ك 2، ب 18، ح 4.(@)(@@) * وروى عن وهيب بن حفص.(@)(@@) وروى عنه أحمد بن محمد الكافي: ج 3، ك 5، ب 35، ح 9.(@)(@@) * وروى عن هشام بن سالم، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 6، ك 6، ب 18، ح 4.(@)(@@) والتهذيب: ج 9، ح 380.(@)(@@) وروى عنه أحمد بن محمد بن عيسى.(@)(@@) التهذيب: ج 5، ح 34 (الاستبصار: ج 2، ح 466).(@)(@@) * وروى عن هشام الجواليقي، وروى عنه أحمد بن محمد بن عيسى.(@)(@@) الكافي: ج 2، ك 2، ب 56، ح 14.(@)(@@) * وروى عن يوسف بن عبد السلام، وروى عنه محمد بن علي.(@)(@@) الكافي: ج 2، ك 4، ب 29، ح 2.(@)(@@) * وروى عن يونس، وروى عنه محمد ابن أحمد.(@)(@@) الكافي: ج 1. ك 4، ب 115، ح 9.(@)(@@) وروى عنه معلى بن محمد.(@)(@@) الكافي: ج 6، ك 6، ب 32، ح 6.(@)(@@) * وروى عن يوسف بن الربيع، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 4، ك 3، ب 237، ح 4.(@)(@@) وروى عن يونس بن يعقوب، وروى عنه أحمد.(@)(@@) الكافي: ج 4، ك 3، ب 56، ح 3. PageV06P322(@)(@@) وروى 
ms1731	 عنه أحمد بن محمد.(@)(@@) الكافي: ج 3، ك 5، ب 12، ح 3، والكافي:(@)(@@) ج 4، ك 3، ب 27، ح 3، وب 54، ح 1.(@)(@@) وروى عنه أحمد بن محمد بن عيسى.(@)(@@) التهذيب: ج 5، ح 1540.(@)(@@) وروى عنه علي بن مهزيار.(@)(@@) التهذيب: ج 4، ح 453.(@)(@@) وروى عنه محمد بن الحسين.(@)(@@) التهذيب: ج 5، ح 1670.(@)(@@) وروى عنه محمد بن خالد التهذيب: ج 1، ح 558 (الاستبصار:(@)(@@) ج 1، ح 550).(@)(@@) وروى عنه محمد بن عبد الجبار.(@)(@@) الروضة: ح 174.(@)(@@) وروى عنه محمد بن يحيى.(@)(@@) الكافي: ج 4، ك 3، ب 58، ح 3.(@)(@@) * وروى عن عمه سليمان بن جعفر، وروى عنه أبو علي الأشعري.(@)(@@) التذهيب: ج 9، ح 6.(@)(@@) * وروى عن كرام، وروى عنه إبراهيم بن هاشم.(@)(@@) الكافي: ج 2، ك 2، ب 60، ح 24.(@)(@@) وروى عنه الحسين بن سعيد.(@)(@@) التهذيب: ج 10، ح 724.(@)(@@) وروى عنه سهل بن زياد.(@)(@@) الروضة: ح 328.(@)(@@) * وروى عن النوفلي، وروى عنه محمد بن أحمد بن يحيى.(@)(@@) التهذيب: ج 7، ح 194.(@)(@@) * وروى عن اليعقوبي، وروى عنه إبراهيم بن هاشم.(@)(@@) الكافي: ج 1، ك 3، ب 8، ح 9.(@)(@@) * وروى عن بعض أصحابنا عن أبي عبد الله عليه السلام، وروى عنه أحمد ابن محمد.(@)(@@) الكافي: ج 4، ك 3، ب 102، ح 1.(@)(@@) وروى عنه أحمد بن محمد بن عيسى.(@)(@@) التهذيب: ج 5، ح 1136.(@)(@@) * وروى عن بعض أصحابنا عن الرضا عليه السلام، وروى عنه علي بن إسماعيل الميثمي.(@)(@@) التهذيب: ج 7، ح 1575 (الاستبصار:(@)(@@) ج 3، ح 860 وفيه عن بعض أصحابه).(@)(@@) * وروى عن بعض أصحابنا عن بعضهم عليهم السلام، وروى عنه أحمد ابن محمد.(@)(@@) الكافي: ج 4، ك 3، ب 83، ح 1.(@)(@@) وروى عنه أحمد بن محمد بن عيسى.(@)(@@) التهذيب: ج 5، ح 213.(@)(@@) * وروى عن بعض أصحابنا عن PageV06P323(@)(@@) سعيد الأعرج، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 4، ك 3، ب 73، ح 4.(@)(@@) والتهذيب: ج 5، ح 144، (الاستبصار:(@)(@@) ج 2، ح 521).(@)(@@) * وروى عن بعض أصحابه عن أبي عبد الله عليه السلام، وروى عنه أحمد ابن محمد.(@)(@@) الروضة: ح 423.(@)(@@) * وروى عن بعض رجاله عن أبي عبد الله عليه السلام، وروى عنه أحمد ابن محمد.(@)(@@) الكافي: ج 4، ك 3، ب 114، ح 5.(@)(@@) * وروى هو أو غيره عن أبان بن عثمان، وروى عنه معلى بن محمد.(@)(@@) الكافي: ج 6، ك 
ms1732	 2، ب 46، ح 3.(@)(@@) * وروى هو أو غيره عن حماد بن عثمان، وروى عنه معلى بن محمد.(@)(@@) الكافي: ج 4، ك 3، ب 123، ح 17.(@)(@@) * وروى هو أو غيره عن داود بن فرقد، وروى عنه أحمد بن محمد. الكافي:(@)(@@) ج 6، ك 6، ب 125، ح 1.(@)(@@) الحسن بن علي بن أبي حمزة * وروى عن أبي الحسن عليه السلام، وروى عنه أحمد بن محمد بن أبي نصر.(@)(@@) التهذيب: ج 8، ح 953.(@)(@@) * وروى عن أبي بصير، وروى محمد ابن يحيى عن بعض أصحابنا عنه.(@)(@@) الكافي: ج 3، ك 4، ب 102، ح 3.(@)(@@) * وروى عن أبي بكر الأرمني، وروى عنه أبو عبد الله الرازي.(@)(@@) التهذيب: ج 8، ح 1083.(@)(@@) * وروى عن أبي عبد الله المؤمن، وروى عنه أبو عبد الله الرازي.(@)(@@) الكافي: ج 7، ك 3، ب 63، ح 12.(@)(@@) * وروى عن أبيه.(@)(@@) الفقيه: ج 3، ح 380.(@)(@@) وروى عنه أبو عبد الله الجاموراني.(@)(@@) الكافي: ج 6، ك 9، ب 7، ح 7.(@)(@@) وروى عنه أبو عبد الله الرازي.(@)(@@) الكافي: ج 1، ك 4، ب 105، ح 4.(@)(@@) والتهذيب: ج 9، ح 497.(@)(@@) وروى عنه أبو علي الأشعري عن بعض أصحابنا.(@)(@@) الكافي: ج 6، ك 7، ب 20، ح 1. PageV06P324(@)(@@) وروى عنه إبراهيم بن هاشم.(@)(@@) الكافي: ج 6، ك 7، ب 20، ح 1.(@)(@@) وروى عنه أحمد بن الميثم الطلحي.(@)(@@) التهذيب: ج 6، ح 68.(@)(@@) وروى عنه إسماعيل بن مهران.(@)(@@) الكافي: ج 2، ك 2، ب 20، ح 6.(@)(@@) وروى عنه الحسين بن يزيد.(@)(@@) الفقيه: ج 4، ح 457.(@)(@@) وروى محمد بن أحمد عن بعض أصحابنا عنه.(@)(@@) الكافي: ج 6، ك 4، ب 1، ح 19.(@)(@@) والتهذيب: ج 9، ح 105، إلا أن فيها بعض أصحابه بدل بعض أصحابنا.(@)(@@) وروى عنه محمد بن أورمة.(@)(@@) الكافي: ج 2، ك 1، ب 83، ح 10.(@)(@@) وروى عنه الجاموراني.(@)(@@) الكافي: ج 5، ك 2، ب 4، ح 10.(@)(@@) * وروى عن إبراهيم، وروى عنه الحسين بن يزيد.(@)(@@) الكافي: ج 1، ك 3، ب 22، ح 2، والكافي:(@)(@@) ج 2، ك 1، ب 1، ح 7، والكافي: ج 6، ك 8، ب 51، ح 3.(@)(@@) * وروى عن إبراهيم بن عمر، وروى عنه الحسين بن يزيد.(@)(@@) الكافي: ج 1، ك 3، ب 15، ح 1.(@)(@@) * وروى عن الحسين بن أبي العلاء، وروى عنه إسماعيل بن مهران.(@)(@@) الكافي: ج 2، ك 2، ب 20، ح 6.(@)(@@) * وروى عن رفاعة بن موسى، وروى عنه محمد بن عبد الله الرازي.(@)(@@) التهذيب: ج 
ms1733	 4، ح 571.(@)(@@) * وروى عن زرعة، وروى عنه الجاموراني.(@)(@@) الكافي: ج 5، ك 2، ب 42، ح 3.(@)(@@) * وروى عن سيف بن عميرة، وروى عنه أبو عبد الله الرازي.(@)(@@) التهذيب: ج 1، ح 1020 (الاستبصار:(@)(@@) ج 1، ح 285)، والتهذيب: ج 8، ح 782 (الاستبصار: ج 4، ح 1).(@)(@@) وروى عنه الجاموراني.(@)(@@) الكافي: ج 6، ك 8، ب 2، ح 4.(@)(@@) * وروى عن صندل، وروى عنه أبو عبد الله الجاموراني.(@)(@@) الكافي: ج 5، ك 3، ب 157، ح 8.(@)(@@) وروى عنه الجاموراني.(@)(@@) الكافي: ج 2، ك 2، ب 13، ح 9.(@)(@@) * وروى عن عبد الله بن وضاح، وروى عنه أبو عبد الله الجاموراني.(@)(@@) الكافي: ج 7، ك 6، ب 19، ح 14.(@)(@@) والتهذيب: ج 6، ح 802 (الاستبصار: PageV06P325(@)(@@) ج 3، ح 175).(@)(@@) * وروى عن علي بن ميمون الصائغ، وروى عنه محمد بن العباس.(@)(@@) التهذيب: ج 6، ح 97.(@)(@@) * وروى عن عمرو بن جبير العرزمي، وروى عنه الجاموراني.(@)(@@) الكافي: ج 4، ك 2، ب 65، ح 5، والكافي:(@)(@@) ج 5، ك 3، ب 152، ح 2.(@)(@@) * وروى عن كليب بن معاوية الأسدي، وروى عنه الجاموراني.(@)(@@) الكافي: ج 5، ك 3، ب 9، ح 2.(@)(@@) * وروى عن محمد بن مسكين، وروى عنه إسماعيل بن مهران.(@)(@@) الكافي: ج 2، ك 3، ب 12، ح 3.(@)(@@) * وروى عن محمد بن يوسف التميمي، وروى عنه الجاموراني.(@)(@@) الكافي: ج 5، ك 3، ب 10، ح 5، والكافي:(@)(@@) ج 2، ك 4، ب 15، ح 2.(@)(@@) * وروى عن المؤمن، وروى عنه أبو عبد الله الجاموراني.(@)(@@) الكافي: ج 5، ك 3، ب 10، ح 4.(@)(@@) * وروى عن منصور بن حازم، وروى عنه إسماعيل بن مهران.(@)(@@) الكافي: ج 2، ك 3، ب 12، ح 10.(@)(@@) * وروى مرفوعا عن أبي عبد الله عليه السلام، وروى عنه إسماعيل بن مهران.(@)(@@) الكافي: ج 2، ك 3، ب 12.(@)(@@) الحسن بن علي ابن بنت إلياس * وروى عن أبي الحسن عليه السلام.(@)(@@) الفقيه: ج 3، ح 580.(@)(@@) وروى عنه عبد الله بن الصلت.(@)(@@) الكافي: ج 1، ك 4، ب 117، ح 5.(@)(@@) * وروى عن جميل بن دراج، وروى عنه علي بن الحسن.(@)(@@) التهذيب: ج 9، ح 1061 (الاستبصار:(@)(@@) ج 4، ح 563 وفيه علي بن الحسن بن فضال).(@)(@@) * وروى عن عبد الله بن سنان، وروى عنه أحمد بن محمد.(@)(@@) التهذيب: ج 1، ح 867 (الاستبصار:(@)(@@) ج 1، ح 738)، والتهذيب: ج 2، ح 1407.(@)(@@) وروى عنه أحمد بن محمد بن عيسى.(@)(@@) 