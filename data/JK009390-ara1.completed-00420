ms401	 فجعلت تنفر فإذا ضبابة غشيته فذكره للنبي قال فذكره .(@)(@@)(@@)(@@) $ ( 3787 ) قال النبي :(@)(@@) | 30 ( إقرأ يا أسيد فإن الملائكة لم تزل يسمعون صوتك ، فلو قرأت أصبحت ظله بين السماء والأرض يتراآها الناس فيها الملائكة ) )(@)(@@) ( طب ) عن محمود بن لبيد عن أسيد بن حضير رضي الله عنه أنه قرأ ليلة وفرسه مربوط فأدار الفرس في رباطه فانصرف فذكر ذلك لرسول الله قال فذكره .(@)(@@)(@@)(@@) $ ( 3788 ) قال النبي :(@)(@@) | 30 ( إقرأ يا أسيد فإن ذالك ملك استمع القرآن ) )(@)(@@) عبد الرزاق في المصنف ( طب ) عن أبي سلمة قال : بينا أسيد بن حضير رضي الله عنه يصلي بالليل قال : إذ غشي مثل السحابة فيها مثل المصابيح فانصرفت فذكرت ذالك للنبي حين أصبحت قال فذكره .(@)(@@)(@@)(@@) $ ( 3789 ) قال النبي :(@)(@@) | 30 ( إقرإ القرآن في كل شهر قال : إني أجد قوة ، قال PageV02P048 فاقرأه في عشرين ، قال إني أجد قوة قال فاقرأه في عشر ، قال إني أجد قوة قال فاقرأه في سبع ولا تزد على ذالك ) )(@)(@@) ( خ م د ) عن ابن عمرو رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 3790 ) قال النبي :(@)(@@) | 30 ( إقرإ القرآن في شهر قال إن لي قوة قال اقرأه في ثلاث ) )(@)(@@) ( د حل ) عن ابن عمرو رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 3791 ) قال النبي :(@)(@@) | 30 ( إقرأ علي القرآن ، قال : يا رسول الله أقرأ عليك ، وعليك أنزل ؟ قال : إني اشتهيت أن أسمعه من غيري ) )(@)(@@) ( حم ه د ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3792 ) قال النبي :(@)(@@) | 30 ( إقرأ { قل يا أيها الكافرون } ثم نم على خاتمتها فإنها براءة من الشرك ) )(@)(@@) ( حم د ت ك هب ) عن فروة بن نوفل عن أبيه .(@)(@@)(@@)(@@) $ ( 3793 ) قال النبي :(@)(@@) | 30 ( إقرأ يا ج| ابر { قل أعوذ برب الفلق } و { قل أعوذ برب الناس } ولن تقرأ بمثلهما ) )(@)(@@) ( ن حب ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3794 ) قال النبي :(@)(@@) | 30 ( اقرأ يا معاذ ولا تهمز ) )(@)(@@) الخطيب عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3795 ) قال النبي :(@)(@@) | 30 ( اقرؤوا القرآن وابكوا فإن لم تبكوا فتباكوا ، ليس منا من لم يتغن بالقرآن ) )(@)(@@) ابن نصر عن سعد 
ms402	 بن أبي وقاص رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3796 ) قال النبي :(@)(@@) | 30 ( اقرىء قومك السلام فإنهم ما علمت أعفة صبر ) )(@)(@@) ( ط حم ) عن أنس ( ت ) حسن غريب ( طب ك ض ) عن أنس عن أبي طلحة رضي الله عنه .(@)(@@) PageV02P049(@)(@@)(@@)(@@) $ ( 3797 ) قال النبي :(@)(@@) | 30 ( اقرؤوا القرآن وابتغوا ما فيه ) )(@)(@@) الديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3798 ) قال النبي :(@)(@@) | 30 ( اقرؤوا القرآن واسألوا الله به فإنه سيقرؤوه أقوام يقيمونه إقامة القدح يتعجلونه ولا يتأجلونه ) )(@)(@@) ( ش ) عن محمد بن المنكدر مرسلا .(@)(@@)(@@)(@@) $ ( 3799 ) قال النبي :(@)(@@) | 30 ( أقرب الناس من درجة النبوة أهل الجهاد وأهل العلم ، لأن أهل الجهاد يجاهدون على ما جاءت به الرسل ، وأما أهل العلم فدلوا الناس على ما جاءت به الأنبياء ) )(@)(@@) الديلمي عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 3800 ) قال النبي :(@)(@@) | 30 ( أقرب ما يكون العبد من الله تعالى إذا كان ساجدا ) )(@)(@@) ابن النجار عن عائشة ( طب ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3801 ) قال النبي :(@)(@@) | 30 ( أقرب ما يكون الرب عز وجل من العبد جوف الليل الآخر ، فإن استطعت أن تكون ممن يذكر الله في تلك الساعة فكن فإن الصلاة محضورة مشهودة إلى طلوع الشمس فإنها تطلع بين قرني شيطان وهي ساعة صلاة الكفار فدع الصلاة حتى ترتفع قيد رمح ويذهب شعاعها ، ثم الصلاة محضورة مشهودة حتى تعتدل الشمس اعتدال الرمح نصف النهار فإنها ساعة تفتح فيها أبواب جهنم وتسجر ، فدع الصلاة حتى يفيء الفيء ، ثم الصلاة محضورة مشهودة حتى تغيب الشمس فإنها تغيب بين قرني الشيطان وهي صلاة الكفار ) )(@)(@@) ( ن ) عن أبي أمامة عن عمرو بن عبسة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3802 ) قال النبي :(@)(@@) | 30 ( أقربكم مني مجلسا يوم القيامة من خرج من الدنيا كهيئة ما تركته فيها ) )(@)(@@) ( ش ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3803 ) قال النبي :(@)(@@) | 30 ( اقرؤا على سكينتكم فقد انقطعت الهجرة ولاكن جهاد ونية وإذا استنفرتم فانفروا ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@) PageV02P050(@)(@@)(@@)(@@) $ ( 3804 ) قال النبي :(@)(@@) | 30 ( اقض بينهما يا ع| مرو فإذا قضيت بينهما فإن أصبت 
ms403	 بينهما القضاء فلك عشر حسنات وإن اجتهدت فأخطأت فلك حسنة ) )(@)(@@) ( حم طب ) عن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3805 ) قال النبي :(@)(@@) | 30 ( إقض بينهما على أنك إن أصبت فلك عشر أجور ، وإن اجتهدت فأخطأت فلك أجر ) )(@)(@@) ( ك ) وتعقب عن ابن عمرو رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 3806 ) قال النبي :(@)(@@) | 30 ( إقطع بالسكين واذكر اسم الله تعالى عليه وكل ) )(@)(@@) ( حل هب ) عن ميمونة أم المؤمنين رضي الله عنها قالت : سئل رسول الله عن الجبن قال فذكره .(@)(@@)(@@)(@@) $ ( 3807 ) قال النبي :(@)(@@) | 30 ( أقل من الدين تعع حرا ، وأقل من الذنوب يهن عليك الموت ، وانظر في أي نصاب تضع ولدك فإن العرق دساس ) )(@)(@@) الديلمي عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 3808 ) قال النبي :(@)(@@) | 30 ( أقلوا الخروج إذا هدأت الرجل إن الله يبث من خلقه بالليل ما شاء ) )(@)(@@) ( ك ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3809 ) قال النبي :(@)(@@) | 30 ( أقم الصلاة وآت الزكاة واهجر السوء واسكن من أرض قومك حيث شئت ) )(@)(@@) ( طب ) عن فديك رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3810 ) قال النبي :(@)(@@) | 30 ( أقيلوا ذوي الهيئات زلاتهم ) )(@)(@@) ( قط ) في الخطيب عن ابن مسعود والحاكم في الكنى ا عن أنس رضي الله عنه ( حب هق ) والعسكري في الأمثال عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 3811 ) قال النبي :(@)(@@) | 30 ( أقيلوا ذوي الهيئة عثراتهم إلا حدا من حدود الله ) )(@)(@@) ابن جرير والعسكري عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 3812 ) قال النبي :(@)(@@) | 30 ( أقول كما قال أخي يوسف : لا تثريب عليكم : اليوم PageV02P051 يغفر الله لكم وهو أرحم الراحمين ) )(@)(@@) ابن أبي الدنيا في ذم الغضب عن أبي هريرة ابن السني في عمل يوم وليلة عن ابن عمرو رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 3813 ) قال النبي :(@)(@@) | 30 ( أقيموا صفوفكم وتراصوا فوالذي نفسي بيده إني لأرى الشياطين بين صفوفكم كأنها غنم عفر ) )(@)(@@) ( ط ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3814 ) قال النبي :(@)(@@) | 30 ( أقيموا صفوفكم فإن من حسن الصلاة إقامة الصفوف ) )(@)(@@) ( ش ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3815 ) قال النبي :(@)(@@) | 30 ( أقيموا صفوفكم فإن تسوية الصف من تمام الصلاة ) )(@)(@@) ( حب ) عن أنس رضي 
ms404	 الله عنه .(@)(@@)(@@)(@@) $ ( 3816 ) قال النبي :(@)(@@) | 30 ( أقيموا صفوفكم فإن من تمام الصلاة إقامة الصف ) )(@)(@@) ( حل ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3817 ) قال النبي :(@)(@@) | 30 ( أقيموا صفوفكم أو ليخالفن الله بين وجوهكم يوم القيامة ) )(@)(@@) ( طب ) عن النعمان بن بشير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3818 ) قال النبي :(@)(@@) | 30 ( أقيموا الحدود على ما ملكت أيمانكم ) )(@)(@@) ( ش ) و ابن جرير ( هق ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3819 ) قال النبي :(@)(@@) | 30 ( أقيموا الصفوف فإنما تصفون بصفوف الملائكة حاذوا بين المناكب وسدوا الخلل ولا تذروا الفرجات للشياطين ومن وصل صفا وصله الله ) )(@)(@@) البغوي عن أبي شجرة كثير بن مرة وقال شك في صحبته .(@)PageV02P052(@)(@@)(@@)(@@) ||| ( الهمزة مع الكاف(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 3820 ) قال النبي :(@)(@@) | 30 ( أكبر الكبائر الإشراك بالله ، وقتل النفس ، وعقوق الوالدين ، وشهادة الزور ) )(@)(@@) ( خ ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3821 ) قال النبي :(@)(@@) | 30 ( أكبر الكبائر الشرك بالله ، وعقوق الوالدين ، ومنع فضل الماء ، ومنع الفحل ) )(@)(@@) ( البزار ) عن بريدة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 3822 ) قال النبي :(@)(@@) | 30 ( أكبر الكبائر حب الدنيا ) )(@)(@@) ( فر ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3823 ) قال النبي :(@)(@@) | 30 ( أكبر الكبائر سوء الظن بالله ) )(@)(@@) ( فر ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 3824 ) قال النبي :(@)(@@) | 30 ( أكثر أمتي الذين لم يعطوا فيبطروا ، ولم يقتر عليهم فيسألوا ) )(@)(@@) ( تخ ) و البغوي وابن شاهين عن الجدع الأنصاري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3825 ) قال النبي :(@)(@@) | 30 ( أكتب فوالذي نفسي بيده ما يخرج منه إلا حق ) )(@)(@@) ( حم د ك ) عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 3826 ) قال النبي :(@)(@@) | 30 ( أكتبوا العلم قبل ذهاب العلماء إنما ذهاب العلم موت العلماء ) )(@)(@@) ( ابن النجار ) عن حذيفة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 3827 ) قال النبي :(@)(@@) | 30 ( إكتحلوا بالإثمد المروح فإنه يجلو البصر وينبت الشعر ) )(@)(@@) ( حم ) عن أبي النعمان الأنصاري رضي الله عنه .(@)(@@) PageV02P053(@)(@@)(@@)(@@) $ ( 3828 ) قال النبي :(@)(@@) | 30 ( إكتحلوا بالإثمد فإنه يجلو البصر وينبت الشعر ) )(@)(@@) ( ت ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 3829 ) قال النبي :(@)(@@) | 30 ( أكتم الخطبة ثم توضأ فأحسن وضوءك ، ثم صل ما كتب الله 
ms405	 لك ، ثم احمد ربك ومجده ثم قل : اللهم إنك تقدر ولا أقدر وتعلم ولا أعلم وأنت علام الغيوب فإن رأيت لي في فلانة يسميها باسمها خيرا في ديني ودنياي وآخرتي فاقدرها لي وإن كان غيرها خيرا لي منها في ديني ودنياي وآخرتي فاقدرها لي ) )(@)(@@) ( حم حب ك هق ) عن أبي أيوب رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 3830 ) قال النبي :(@)(@@) | 30 ( أكثر الدعاء بالعافية ) )(@)(@@) ( ك ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 3831 ) قال النبي :(@)(@@) | 30 ( أكثر الصلاة في بيتك يكثر خير بيتك ، وسلم على من لقيت من أمتي تكثر حسناتك ) )(@)(@@) ( هب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 3832 ) قال النبي :(@)(@@) | 30 ( أكثر الناس ذنوبا يوم القيامة أكثرهم كلاما فيما لا يعنيه ) )(@)(@@) ( ابن لال وابن النجار ) عن أبي هريرة ( السجزي في الإبانة ) عن عبد الله بن أبي أوفى ا ( حم ) في الزهد عن سلمان رضي الله عنهم موقوفا .(@)(@@)(@@)(@@) $ ( 3833 ) قال النبي :(@)(@@) | 30 ( أكثر الناس شبعا في الدنيا أطولهم جوعا في الآخرة ) )(@)(@@) ( حل ) عن سل مان رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 3834 ) قال النبي :(@)(@@) | 30 ( أكثر أن تقول : سبحان الملك القدوس ، رب الملائكة والروح ، جللت السماوات والأرض بالعزة والجبروت ) )(@)(@@) ( ابن السني والخرائطي في مكارم الأخلاق وابن عساكر ) عن البراء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3835 ) قال النبي :(@)(@@) | 30 ( أكثر أهل الجنة البله ) )(@)(@@) ( البزار ) عن أنس رضي الله عنه .(@)(@@) PageV02P054(@)(@@)(@@)(@@) $ ( 3836 ) قال النبي :(@)(@@) | 30 ( أكثرت عليكم في السواك ) )(@)(@@) ( حم خ ن ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3837 ) قال النبي :(@)(@@) | 30 ( أكثر جنود الله في الأرض الجراد لا آكله ولا أحرمه ) )(@)(@@) ( ده هق ) عن سل مان رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 3838 ) قال النبي :(@)(@@) | 30 ( أكثر خرز أهل الجنة العقيق ) )(@)(@@) ( حل ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 3839 ) قال النبي :(@)(@@) | 30 ( أكثر خطايا ابن آدم في لسانه ) )(@)(@@) ( طب هب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3840 ) قال النبي :(@)(@@) | 30 ( أكثر ذكر الموت فإن ذكره يسليك مما سواه ) )(@)(@@) ( ابن أبي الدنيا في ذكر الموت ) عن سفيان عن شريح مرسلا .(@)(@@)(@@)(@@) $ ( 3841 ) قال النبي :(@)(@@) | 30 
ms406	 ( أكثر عذاب القبر من البول ) )(@)(@@) ( حم ه ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3842 ) قال النبي :(@)(@@) | 30 ( أكثر ما أتخوف على أمتي من بعدي رجل يتناول القرآن يضعه على غير موضعه ، ورجل يرى أنه أحق بهاذا الأ مر من غيره ) )(@)(@@) ( طس ) عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3843 ) قال النبي :(@)(@@) | 30 ( أكثر منافقي أمتي قراؤها ) )(@)(@@) ( حم ( 1 ) طب هب ) عن ابن عمرو رضي الله عنهما ( حم طب ) عن عقبة بن عامر ( طب عد ) عن عصمة بن مالك رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 3844 ) قال النبي :(@)(@@) | 30 ( أكثر من أكلة كل يوم سرف ) )(@)(@@) ( هب ) عن عائشة PageV02P055 رضي الله عنها .(@)(@@)(@@)(@@) $ ( 3845 ) قال النبي :(@)(@@) | 30 ( أكثر من الدعاء فإن الدعاء يرد القضاء المبرم ) )(@)(@@) ( أبو الشيخ ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3846 ) قال النبي :(@)(@@) | 30 ( أكثر من السجود فإنه ليس من مسلم يسجد لله تعالى سجدة إلا رفعه الله بها درجة في الجنة وحط عنه بها خطيئة ) )(@)(@@) ( ابن سعد حم ) عن فاطمة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 3847 ) قال النبي :(@)(@@) | 30 ( أكثر من لا حول ولا قوة إلا بالله فإنها من كنز الجنة ) )(@)(@@) ( ع طب حب ) عن أبي أيوب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3848 ) قال النبي :(@)(@@) | 30 ( أكثر من يموت من أمتي بعد قضاء الله وقدره بالعين ) )(@)(@@) ( الطيالسي تخ والحكيم والبزار والضياء ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3849 ) قال النبي :(@)(@@) | 30 ( أكثروا استلام هاذا الحجر فإنكم يوشك أن تفقدوه بينما الناس ذات ليلة يطوفون به إذ أصبحوا وقد فقدوه ، إن الله لا يترك شيئا من الجنة في الأرض إلا أعاده فيها قبل يوم القيامة ) )(@)(@@) ( فر ) عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 3850 ) قال النبي :(@)(@@) | 30 ( أكثروا الصلاة علي فإن الله وكل بي ملكا عند قبري فإذا صلى علي رجل من أمتي قال لي ذالك الملك : يا محمد إن فلان بن فلان صلى عليك الساعة ) )(@)(@@) ( فر ) عن أبي بكر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 3851 ) قال النبي :(@)(@@) | 30 ( أكثروا الصلاة علي فإن صلاتكم علي مغفرة لذنوبكم ، واطلبوا لي الدرجة والوسيلة فإن 
