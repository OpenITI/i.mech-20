ms364	 عنه الحسين القتات تركه الدارقطني(@)(@@) PageV00P000(@)(@@) - م عه / يزيد بن كيسان عن أبي حازم الأشجعي صدوق قال أبو حاتم لا يحتج به أما(@)(@@)(@@)(@@) | 7140 - (@)(@@) يزيد بن كيسان أبو منين فقة روى عنه يحيى القطان والظاهر أنه هو(@)(@@)(@@)(@@) | 7141 - (@)(@@) يزيد بن ابي مالك الدمشقي القاضي واسم أبيه عبد الرحمن صدوق مشهور من التابعين الأئمة قال الفسوي فيه لين(@)(@@)(@@)(@@) | 7142 - (@)(@@) يزيد بن محمد عن عمر بن عبد العزيز لا يدرى من هو(@)(@@)(@@)(@@) | 7143 - (@)(@@) يزيد بن مروان الخلال عن ابن أبي الزناد قال ابن معين كذاب(@)(@@)(@@)(@@) | 7144 - (@)(@@) يزيد بن أبي مريم الدمشقي عن أبي إدريس الخولاني وثقه ابن معين وأبو حاتم وقال الدارقطني ليس بذاك(@)(@@)(@@)(@@) | 7145 - (@)(@@) يزيد بن مسهر مجهول(@)(@@)(@@)(@@) | 7146 - (@)(@@) يزيد بن معاوية أبو شيبة عن عطاء قال أبو حاتم ليس بالقوي(@)(@@)(@@)(@@) | 7147 - (@)(@@) يزيد بن مغلس الباهلي عن مالك قال ابن حبان لا يحتج به(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7148 - (@)(@@) يزيد بن مهران الخباز كوفي ضعفه أبو داود(@)(@@)(@@)(@@) | 7149 - (@)(@@) يزيد بن ميمون مجهول يروي عن ابن سيرين وعنه أبو سلمة(@)(@@)(@@)(@@) | 7150 - (@)(@@) يزيد بن هرمز أحد الفقهاء كذا سماه أبو حاتم وقال ليس بالقوي يكتب حديثه(@)(@@)(@@)(@@) | 7151 - (@)(@@) يزيد بن يثيع قال ابن خراش لم يرو عنه إلا أبو إسحاق السبيعي(@)(@@)(@@)(@@) | 7152 - (@)(@@) يزيد بن يزيد البلوي عن أبي إسحاق الفزراي في حديث كذاب خرجه الحاكم(@)(@@)(@@)(@@) | 7143 - (@)(@@) يزيد بن يزيد بن جابر صدوق مشهور لينه ابن قانع(@)(@@)(@@)(@@) | 7154 - (@)(@@) يزيد بن يزيد عن خولة في الظهار قال البخاري في صحته نظر(@)(@@)(@@)(@@) | 7155 - (@)(@@) يزيد بن يعفر عن الحسن شيخ بصري ليس بحجة قال الدارقطني يعتبر به(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7156 - (@)(@@) ت / يزيد بن يوسف الصنعاني الشامي عن الأوزاعي تركوه(@)(@@)(@@)(@@) | 7157 - (@)(@@) يزيد بن يوسف المصري عن بعض التابعين مجهول(@)(@@)(@@)(@@) | 7158 - (@)(@@) يزيد بن يحيى بن الصباح بيض له ابن أبي حاتم قال أبو حاتم ليس بقوي(@)(@@)(@@)(@@) | 7159 - (@)(@@) يزيد أبو خالد السراج عن مكحول قال أبو حاتم منكر الحديث(@)(@@)(@@)(@@) | 7160 - 