ms3021	 عن ابن عمرو رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28220 قال النبي :(@)(@@) | 30 ( يؤتاى بالقرآن يوم القيامة وأهله الذين كانوا يعملون به تقدمه سورة البقرة وآل عمران كأنهما غمامتان أو ظلتان سوداوان بينهما شرق أو كأنهما فرقان من طير صاف يحاجان عن صاحبهما ) )(@)(@@) . ( حم ، م ، عن النواس بن سمعان رضي الله عنه ) .(@)(@@) PageV09P234(@)(@@)(@@)(@@) $ 28221 قال النبي :(@)(@@) | 30 ( يؤتاى بجهنم يومئذ لها سبعون ألف زمام ، مع كل زمام سبعون ألف ملك يجرونها ) )(@)(@@) . ( م ، ت ، عن ابن مسعود رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28222 قال النبي :(@)(@@) | 30 ( يؤتاى بالرجل من أمتي يوم القيامة وما له من حسنة ترجاى له الجنة ، فيقول الرب تعالاى : أدخلوه الجنة فإنه كان يرحم عياله ) )(@)(@@) . ( ابن لال والخطيب وابن عساكر عن ابن مسعود رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28223 قال النبي :(@)(@@) | 30 ( يؤتاى بأقوام من ولد آدم يوم القيامة معهم حسنات كالجبال حتى إذا دنوا وأشرفوا على الجنة نودوا ألا نصيب لكم فيها ) )(@)(@@) . ( ابن قانع عن سالم مولاى أبي حذيفة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28224 قال النبي :(@)(@@) | 30 ( يؤتاى بعلماء السوء يوم القيامة فيقذفون في نار جهنم فيدور أحدهم في جهنم بقصبه كما يدور الحمار بالرحاى ، فيقال له : ويلك بك اهتدينا فما بالك ؟ قال : إني كنت أخالف ما كنت أنهاكم ) )(@)(@@) . ( ابن النجار عن أبي أمامة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28225 قال النبي :(@)(@@) | 30 ( يؤتاى بالنعم يوم القيامة وبالحسنات والسيئات فيقول الله تعالاى لنعمة من نعمه : خذي حقك من حسنات عبدي ، فما تترك له حسنة إلا ذهبت بها ) )(@)(@@) . ( أبو الشيخ وابن النجار عن أنس رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28226 قال النبي :(@)(@@) | 30 ( يؤتاى يوم القيامة بالممسوخ عقلا وبالهالك في الفترة وبالهالك صغيرا ، فيقول الممسوخ عقلا : يا رب لو آتيتني عقلا ما كان من آتيته عقلا بأسعد بعقله مني ، ويقول الهالك في الفترة : يا رب لو أتاني منك عهد ما كان من أتاه منك عهد بأسعد بعهدك مني ، ويقول الهالك صغيرا : يا رب لو آتيتني عمرا ما كان من آتيته عمرا بأسعد بعمره مني ، فيقول الرب سبحانه : إني آمركم بأمر أفتطيعوني 
ms3022	 ؟ فيقولون نعم وعزتك ، فيقول : اذهبوا فادخلوا النار ، ولو دخلوها ما ضرهم ، فيخرج عليهم قوابس يظنون أنها قد أهلكت ما خلق الله من شيء ، فيرجعون سراعا فيقولون : خرجنا يا رب وعزتك نريد دخولها فخرجت علينا قوابس ظننا أنها قد أهلكت PageV09P235 ما خلق الله عز وجل من شيء ، فيأمرهم الثانية فيرجعون كذالك فيقولون مثل قولهم ، فيقول الله سبحانه : قبل أن تخلقوا علمت ما أنتم عاملون ، وعلاى علمي خلقتكم وإلاى علمي تصيرون ، ضميهم فتأخذهم النار ) )(@)(@@) . ( الحكيم ، طب ، حل ، عن معاذ بن جبل رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28227 قال النبي :(@)(@@) | 30 ( يؤتاى بصاحب القلم يوم القيامة في تابوت من نار مقفل عليه بأقفال من نار ، فينظر قلمه فيما أجراه ، فأن كان أجراه في طاعة الله ورضوانه فك عن التابوت ، وإن كان أجراه في معصية الله هواى به التابوت سبعين خريفا حتى يأوي القلم ولائق الدواة ) )(@)(@@) . ( طب عن ابن عباس رضي الله عنهما ) .(@)(@@)(@@)(@@) $ 28228 قال النبي :(@)(@@) | 30 ( يؤتاى بالشهيد يوم القيامة فينصب للحساب ، ويؤتاى بالمتصدق فينصب للحساب ، ثم يؤتاى بأهل البلاء فلا ينصب لهم ميزان ولا ينشر لهم ديوان فيصب عليهم الاجر صبا ، حتى إن أهل العافية ليتمنون في الموقف أن أجسادهم قرضت بالمقاريض من حسن ثواب الله لهم ) )(@)(@@) . ( طب عن ابن عباس رضي الله عنهما ) .(@)(@@)(@@)(@@) $ 28229 قال النبي :(@)(@@) | 30 ( يؤتاى بصاحب الدين يوم القيامة فيقول الله : فيم أتلفت أموال الناس ؟ فيقول يا رب إنك تعلم أنه أتاى علي إما حرق وإما غرق ، فيقول : فإني سأقضي عنك اليوم فيقضي عنه ) )(@)(@@) . ( طب عن عبد الرحمان بن أبي بكر رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28230 قال النبي :(@)(@@) | 30 ( يؤتاى بالقاتل والمقتول يوم القيامة ، فيقول : أي رب سل هاذا فيم قتلني ؟ فيقول : أي رب أمرني هاذا ، فيؤخذ بأيديهما جميعا فيقذفان في النار ) )(@)(@@) . ( طب ، عن أبي الدرداء رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28231 قال النبي :(@)(@@) | 30 ( يؤتاى يوم القيامة بالحجر الاسود وله لسان ذلق يشهد لمن يستلمه بالتوحيد ) )(@)(@@) . ( ك ، هب ، عن علي رضي الله عنه ) .(@)(@@) PageV09P236(@)(@@)(@@)(@@) $ 28232 قال النبي :(@)(@@) | 30 ( يؤتاى بابن آدم يوم القيامة 
ms3023	 فيوقف بين كفتي الميزان ويوكل به ملك ، فإن ثقل ميزانه ناداى الملك بسوط يسمع الخلائق : سعد فلان سعادة لا يشقاى بعدها أبدا ، وإن خف ميزانه ناداى الملك بصوت يسمع الخلائق : شقي فلان شقاوة لا يسعد بعدها أبدا ) )(@)(@@) . ( حل ، عن أنس رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28233 قال النبي :(@)(@@) | 30 ( يؤتاى بالدنيا يوم القيامة فيميز ما كان منها لله ثم يرماى بسائر ذالك في النار ) )(@)(@@) . ابن المبارك عن عبادة بن الصامت ، الديلمي عن أبي هريرة رضي الله عنهما .(@)(@@)(@@)(@@) $ 28234 قال النبي :(@)(@@) | 30 ( يؤتاى بابن آدم يوم القيامة إلاى الميزان كأنه بذج ، فيقول الله تعالاى : يا ابن آدم أنا خير شريك ، ما عملت لي فأنا أجزيك به ، وما عملت لغيري فاطلب ثوابه ممن عملت له ) )(@)(@@) . ( هناد عن أنس رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28235 قال النبي :(@)(@@) | 30 ( يؤتاى برجل كان واليا فيلقاى في النار ، فتندلق أقتابه فيدور في النار كما يدور الحمار بالرحاى فيجتمع إليه أهل النار فيقولون : ألست كنت تأمرنا بالمعروف وتنهانا عن المنكر ؟ قال : كنت آمركم بالمعروف ولا آتيه ، وأنهاكم عن المنكر وآتيه ) )(@)(@@) . ( الحميدي والعدني عن أسامة بن زيد رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28236 قال النبي :(@)(@@) | 30 ( يؤتاى بالحكام يوم القيامة بمن قصر وبمن تعدى فيقول : أنتم خزان أرضي ، ورعاة عبدي وفيكم بغيتي ، فيقول للذي قصر : ما حملك علاى ما صنعت ؟ فيقول : رحمة ، فيقول الله : أنت أرحم بعبادي مني ، ويقول للذي تعدى : ما حملك علاى الذي صنعت ؟ فيقول : غضبة مني ، فيقول : انطلقوا بهم فسدوا بهم ركنا من أركان جهنم ) )(@)(@@) . ( أبو سعيد النقاش في كتاب القضاة من طريق عبدة بن عبد الرحيم المروزي عن بقية ، حدثنا سلمة بن كلثوم عن أنس وعبدة ، قال أبو داود : لا أحدث عنه ، وسلمة شامي ثقة أبو بقية روايته عن الشاميين PageV09P237 مقبولة وقد صرح بهاذا الحديث بالتحديث ) .(@)(@@)(@@)(@@) $ 28237 قال النبي :(@)(@@) | 30 ( يأخذ إلية كبش عربي ليست بأعظمها ولا أصغرها فيقطعها صغارا ثم يذيبها فيجيد إذابتها ويجعلها ثلاثة أجزاء ، فيشرب كل يوم جزءا علاى ريق النفس في عرق ال| نس ا ) )(@)(@@) . ( ك 
ms3024	 غن أنس رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28238 قال النبي :(@)(@@) | 30 ( يؤذن المؤذن ويقيم الصلاة قوم وما هم بمؤمنين ) )(@)(@@) . ( طب ، حل ، عن ابن عمرو رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28239 قال النبي : $ 30 ( يأكل التراب كل شيء من الا &(@)(@@)(@@)(@@) $ 1764 نسان إلا عجب ذنبه مثل حبة خردل منه تنبتون ) )(@)(@@) | . ( حم ، ع ، حب ، ك ، ض ، عن أ$ بي سعيد رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28240 قال النبي :(@)(@@) | 30 ( يأكل الوالدان من مال ولدهما بالمعروف ، وليس للولد أن يأكل من مال والديه إلا بإذنهما ) )(@)(@@) . ( الديلمي عن جابر رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28241 قال النبي :(@)(@@) | 30 ( يؤم القوم أقرؤهم لكتاب الله ) )(@)(@@) . ( البزار عن أبي هريرة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28242 قال النبي :(@)(@@) | 30 ( يؤم القوم أكثرهم قرآنا ، فإن كانوا في القرآن واحدا فأقدمهم هجرة ، فإن كانوا في الهجرة واحدا فأفقههم ، فإن كانوا في الفقه واحدا فأكبرهم سنا ) )(@)(@@) . ( ك ، هق ، عن أبي مسعود الانصاري رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28243 قال النبي :(@)(@@) | 30 ( يؤم القوم أقدمهم هجرة ، فإن كانوا في الهجرة سواء فأفقههم في الدين ، فإن كانوا في الدين سواء فأقرؤهم للقرآن ، ولا يؤم الرجل في سلطانه ، ولا يقعد علاى تكرمته إلا بإذنه ) )(@)(@@) . ( ك عن أبي مسعود الانصاري رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28244 قال النبي : $ 30 ( يؤم الناس في الطعام الا &(@)(@@)(@@)(@@) $ 1764 مام أو رب الطعام أو خيرهم ) )(@)(@@) | . ( ابن عساكر عن الاءوزاعي عن ثابت بن ثوبان العنسي عن أبيه مرسلا ) .(@)(@@) PageV09P238(@)(@@)(@@)(@@) $ 28245 قال النبي :(@)(@@) | 30 ( يؤم القوم أكبرهم سنا ) )(@)(@@) . ( طب عن مالك بن الحويرث رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28246 قال النبي :(@)(@@) | 30 ( يؤمكم أقرؤكم وإن كان ولد زنا ) )(@)(@@) . ( ابن حزم في كتاب الأغراب ، والديلمي عن ابن عمر رضي الله عنهما ) .(@)(@@)(@@)(@@) $ 28247 قال النبي :(@)(@@) | 30 ( يؤمكم أكثركم قرآنا ) )(@)(@@) . ( البغوي والخطيب عن عمرو بن سلمة عن أبيه عن جده وما له غيره ) .(@)(@@)(@@)(@@) $ 28248 قال النبي :(@)(@@) | 30 ( يؤمكم أقرؤكم لكتاب الله إذا لم يكن عليكم أمير ) )(@)(@@) . ( الديلمي عن أبي سعيد رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28249 قال النبي :(@)(@@) | 30 ( يؤمر بناس من الناس يوم القيامة إلاى الجنة ، حتى إذا دنوا منها واستنشقوا 
ms3025	 ريحها ونظروا إلاى قصورها وإلاى ما أعد الله لاهلها فيها نودوا ن اصرفوهم عنها لا نصيب لهم فيها ، فيرجعون بحسرة ما رجع الاولون بمثلها فيقولون : ربنا لو أدخلتنا النار قبل أن ترينا ما أريتنا من ثوابك ، وما أعددت فيها لاوليائك كان أهون علينا ، قال : ذاك أردت منكم يا أشقياء ، كنتم إذا خلوتم بارزتموني بالعظائم وإذا لقيتم الناس لقيتموهم مخبتين ، تراؤون الناس بخلاف ما تعطوني من قلوبكم ، هبتم الناس ولم تهابوني ، وأجللتم الناس ولم تجلوني ، وتركتم للناس ولم تتركوا لي ، فاليوم أذيقكم العذاب مع ما حرمتم من الثواب ) )(@)(@@) . ( طب ، حل ، هب ، و ابن عساكر وابن النجار عن عدي بن حاتم رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28250 قال النبي :(@)(@@) | 30 ( يؤمر بأهل النار فيصعقون فيمر بهم الرجل المسلم ، فيقول له الرجل منهم يا فلان اشفع لي ، فيقول : من أنت ؟ فيقول : أما تعرفني ؟ أنا الذي استسقيتني ماء فسقيتك ، فيشفع له ، ويقول الرجل مثل ذالك ، فيقول : أنا الذي استوهبتني فوهبت لك ) )(@)(@@) . ( ابن أبي الدنيا في قضاء الحوائج عن أنس رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28251 قال النبي :(@)(@@) | 30 ( يؤمر جبريل في كل غداة يدخل بحر النور فينغمس PageV09P239 فيه انغماسة ثم يخرج فينتفض انتفاضة فيسقط منه سبعون ألف قطرة ، يخلق الله من كل قطرة ملكا فيؤمر بهم إلاى البيت المعمور فيصلون فيه ، ثم يؤمر بهم إلاى حيث شاء فيسبحون إلاى يوم القيامة ) )(@)(@@) . ( الديلمي عن أبي هريرة ) .(@)(@@)(@@)(@@) ||| ( الياء مع الباء(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ 28252 قال النبي :(@)(@@) | 30 ( يبصر أحدكم القذاى في عين أخيه وينساى الجذع في عينه ) )(@)(@@) . ( حل عن أبي هريرة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28253 قال النبي :(@)(@@) | 30 ( يبعث الناس علاى نياتهم ) )(@)(@@) . ( حم عن أبي هريرة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28254 قال النبي :(@)(@@) | 30 ( يبعث كل عبد علاى ما مات عليه ) )(@)(@@) . ( م ، ه ، عن جابر رضي الله عنه ) .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ 28255 قال النبي :(@)(@@) | 30 ( يبايع لرجل من أمتي بين الركن والمقام كعدة أهل بدر ، فيأتيه عصب العراق وأبدال الشام ، فيأتيهم جيش من الشام حتى إذا كانوا بالبيداء خسف 
ms3026	 بهم ثم يسير إليه رجل من قريش أخواله كلب فيهزمهم الله فكان يقال : الخائب من خاب من غنيمة كلب ) )(@)(@@) . ( ش ، طب ، ك ، عن أم سلمة رضي الله عنها ) .(@)(@@)(@@)(@@) $ 28256 قال النبي :(@)(@@) | 30 ( يبايع رجل بين الركن والمقام ، ولن يستحل هاذا PageV09P240 البيت إلا أهله ، فإذا استحلوه فلا تسأل عن هالكة العرب ثم تجيء الحبشة فيخربونه خرابا لا يعمر بعده أبدا وهم الذين يستخرجون كنزه ) )(@)(@@) . ( ش ، حم ، ك ، عن أبي هريرة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28257 قال النبي :(@)(@@) | 30 ( يبصر أحدكم القذاي في عين أخيه وينساى الجذع ، أو قال الجذل في عينه ) )(@)(@@) . ( ابن المبارك عن أبي هريرة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28258 قال النبي :(@)(@@) | 30 ( يبطىء أحدكم ثم يتخطى رقاب الناس ويؤذيهم ) )(@)(@@) . ( طس عن ابن عباس رضي الله عنهما ) .(@)(@@)(@@)(@@) $ 28259 قال النبي :(@)(@@) | 30 ( يبعث الله الانبياء يوم القيامة علاى الدواب ، ويبعث ابني فاطمة الحسن والحسين علاى ناقتين من نوق الجنة ، وعلي بن أبي طالب علاى ناقتي ، وأنا علاى البراق ، ويبعث بلالا علاى ناقة فينادي بالاذان وشاهده حقا حقا حتى إذا بلغ أشهد أن محمدا رسول الله شهد بها جميع الخلائق من المؤمنين الاولين والآخرين فقبلت ممن قبلت منه ) )(@)(@@) . ( طب وأبو الشيخ ك وتعقب والخطيب وابن عساكر عن أبي هريرة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28260 قال النبي :(@)(@@) | 30 ( يبعث الله ناقة صالح فيشرب من لبنها هو ومن آمن به من قومه ، ولي حوض كما بين عدن إلاى عمان ، أكوابه عدد نجوم السماء ، فيستسقي الانبياء ، ويبعث الله صالحا علاى ناقته ، قيل يا رسول الله وأنت علاى العضباء ؟ قال : أنا أبعث علاى البراق ، يخصني الله به من بين الاءنبياء ، وفاطمة بنتي علاى العضباء ، ويؤتاى بلال بناقة من نوق الجنة فيركبها وينادي بالاذان فيصدقه من سمعه من المؤمنين حتى يوافي المحشر ، ويؤتاى بلال بحلتين من حلل الجنة فيكساهما ، فأول من يكساى من المؤذنين بلال فصالح المؤمنين بعد ) )(@)(@@) . ( أبو نعيم وابن عساكر عن عبد الله بن بريدة عن أبيه ) .(@)(@@)(@@)(@@) $ 28261 قال النبي :(@)(@@) | 30 ( يبعث الله الحجر الاسود والركن اليماني يوم 
ms3027	 القيامة PageV09P241 ولهما عينان ولسان وشفتان يشهدان لمن استلمهما بالوفاء ) )(@)(@@) . ( طب ، عن ابن عباس رضي الله عنهما ) .(@)(@@)(@@)(@@) $ 28262 قال النبي :(@)(@@) | 30 ( يبعث الله تعالاى العباد يوم القيامة ثم تميز العلماء فيقول : يا معشر العلماء إني لم أضع فيكم علمي وأنا أريد أن أعذبكم ، اذهبوا فقد غفرت لكم ) )(@)(@@) . ( طب عن أبي موساى رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28263 قال النبي :(@)(@@) | 30 ( يبعث الله تعالاى يوم القيامة عبدين من عباده كانا علاى سيرة واحدة ، أحدهما مقتور عليه ، والآخر موسع عليه إلاى الجنة لا ينثني عنها حتى ينتهي إلاى أبوابها فيقول له حجبتها إليك إليك ، فيقول إذن لا أرجع وسيفه في عنقه يقول : إني أعطيت هاذا السيف في الدنيا أجاهد به ، فلم أزل أجاهد به حتى قبضت وأنا علاى ذالك فيرمي بسيفه إلاى الخزنة وينطلق لا يثنونه ولا يحبسونه عن الجنة فيدخلها فيمكث فيها دهرا ثم يمر به أخوه الموسع عليه فيقول له : يا فلان ما حبسك ؟ فيقول : ما خلي سبيلي إلا الآن ، ولقد حبست ما لو أن ثلاثمائة بعير أكلت حمصا لا تردن الماء إلا خمسا ووردن علاى عرقي لصدرن منه رواء ) )(@)(@@) . ( ابن المبارك عن ضمرة والمحاجر بن أبي حبيب وحكيم بن عمير مرسلا ) .(@)(@@)(@@)(@@) $ 28264 قال النبي :(@)(@@) | 30 ( يبعث الله عز وجل من هاذه البقعة ومن هاذا الحرم سبعين ألفا يدخلون الجنة بغير حساب يشفع كل واحد منهم في سبعين ألفا وجوههم كالقمر ليلة البدر ) )(@)(@@) . ( الديلمي عن ابن مسعود رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28265 قال النبي :(@)(@@) | 30 ( يبعث الله الايام علاى هيئتها ، ويبعث يوم الجمعة زهراء منيرة ، ولاهل الجمعة محفوفون بها كالعروس تهداى إلاى بيت كريمها تضيء لهم يمشون في صوئها ألوانهم كالثلج ، ورائحتهم تسطع كالمسك يخوضون في الكافور ولا يخالطهم إلا المؤذنون المحتسبون ) )(@)(@@) . ( أبو الشيخ في الاذان عن أبي موساى رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28266 قال النبي :(@)(@@) | 30 ( يبعث الله تعالاى يوم القيامة عبدا لا ذنب له ، فيقول PageV09P242 الله له : بأي الامرين أحب إليك أن أجزيك : بعملك أم بنعمتي عندك ؟ قال : يا رب إنك تعلم أني 
ms3028	 لم أعصك ، قال : خذوا عبدي بنعمة من نعمي ، فما تبقاى له حسنة إلا استفرغتها تلك النعمة ، فيقول : رب بنعمتك ورحمتك ، فيقول : بنعمتي ورحمتي ، ويؤتاى بعبد محسن في نفسه لا يراى أن له سيئة ، فيقال له : هل كنت توالي أوليائي ؟ قال : يا رب كنت من الناس سلما ، قال : فهل كنت تعادي أعدائي ؟ قال : يا رب لم أكن أحب أن يكون بيني وبين أحد شيء ، فيقول الله تعالاى : وعزتي وجلالي لا ينال رحمتي من لم يوال أوليائي ويعادي أعدائي ) )(@)(@@) . ( الحكيم ، طب ، عن واثلة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28267 قال النبي :(@)(@@) | 30 ( يبعث الله تعالاى يوم القيامة قوما من قبورهم تأجج أفواههم نارا ، ألم تر أن الله تعالاى يقول : { إن الذين يأكلون أموال اليتاماى ظلما إنما يأكلون في بطونهم نارا وسيصلون سعيرا ) )(@)(@@) . ( ش ، ع ، حب ، طب ، عن أبي برزة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28268 قال النبي :(@)(@@) | 30 ( يبعث العالم والعابد ، فيقال للعابد : ادخل الجنة ، ويقال للعالم : اثبت حتى تشفع للناس كما أحسنت أدبهم ) )(@)(@@) . ( عد ، هب ، وضعفه عن جابر رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28269 قال النبي :(@)(@@) | 30 ( يبعث إلاى مكة جيش من الشام ، حتى إذا كانوا بالبيداء خسف بهم ) )(@)(@@) . ( نعيم بن حماد في الفتن عن قتادة مرسلا ) .(@)(@@)(@@)(@@) $ 28270 قال النبي :(@)(@@) | 30 ( يبعث الناس يوم القيامة والسماء تطش عليهم ) )(@)(@@) . ( حم ، ع ، ض ، عن أنس رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28271 قال النبي :(@)(@@) | 30 ( يبعث الناس يوم القيامة فأكون أنا وأمتي علاى تل ، PageV09P243 ويكسوني ربي حلة خضراء ثم يؤذن لي فأقول ما شاء الله أن أقول ، فذالك المقام المحمود ) )(@)(@@) . ( حم ، طب ، ك ، وابن عساكر عن كعب بن مالك رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28272 قال النبي :(@)(@@) | 30 ( يبعث أهل الجنة يوم القيامة علاى صورة آدم في ميلاد ثلاثة وثلاثين مردا جردا مكحلين ، ثم يذهب بهم إلاى شجرة في الجنة فيكتسون منها ، لا تبلاى ثيابهم ، ولا يفنى شبابهم ) )(@)(@@) . ( أبو الشيخ في العظمة وتمام وابن عساكر وابن النجار عن أنس رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28273 قال النبي :(@)(@@) | 30 ( يبعث يوم القيامة أمة وحده بيني وبين عيساى 
ms3029	 ) )(@)(@@) . ( ع وتمام عن جابر رضي الله عنه قال : سئل النبي عن زيد بن عمرو بن نفيل قال فذكره ، حم ، طب ، عن سعيد بن زيد رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28274 قال النبي :(@)(@@) | 30 ( يبعث كل عبد علاى ما مات عليه ، المؤمن علاى إيمانه ، والمنافق علاى نفاقه ) )(@)(@@) . ( حب عن جابر رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28275 قال النبي :(@)(@@) | 30 ( يبعث جند إلاى هاذا الحرم فإذا كانوا ببيداء من الارض خسف بأولهم وآخرهم ولم ينج أوسطهم ، قيل : أرأيت إن كان فيهم مؤمنون ، قال : يكون لهم قبورا ثم يبعث الله تعالاى كل امرىء منهم علاى نيته ) )(@)(@@) . ( ن ، عن حصة بنت عمر رضي الله عنهما ) .(@)(@@)(@@)(@@) $ 28276 قال النبي :(@)(@@) | 30 ( يبعث الناس حفاة عراة غرلا قد ألجمهم العرق وبلغ شحوم الآذان ، قالت سودة واسوأتاه ينظر بعضنا إلاى بعض ، قال : شغل الناس عن ذالك ، لكل امرىء منهم يومئذ شأن يغنيه ) )(@)(@@) . ( طب ، ك ، وابن مردويه ، هق في البعث عن سودة بنت زمعة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28277 قال النبي :(@)(@@) | 30 ( يبعث الناس يوم القيامة حفاة عراة غرلا ، قالت عائشة : فكيف بالعورات ؟ قال : لكل امرىء منهم يومئذ شأن يغنيه ) )(@)(@@) . ( ك وابن مردويه عن عائشة رضي الله عنها ) .(@)(@@) PageV09P244(@)(@@)(@@)(@@) $ 28278 قال النبي :(@)(@@) | 30 ( يبعث مناد عند حضرة كل صلاة فيقول : يا بني آدم قوموا فأطفئوا عنكم ما أوقدتم علاى أنفسكم ، فيقومون فيتطهرون فتسقط خطاياهم من أعينهم ويصلون فيغفر لهم ما بينهما ، ثم يوقدون فيما بين ذالك ، فإذا كان عند صلاة الاولاى ناداى يا بني آدم قوموا فأطفئوا ما أوقدتم علاى أنفسكم ، فيقومون فيتطهرون ويصلون فيغفر لهم ما بينهما ، فإذا حضرت العصر فمثل ذالك ، فإذا حضرت المغرب فمثل ذالك ، فإذا حضرت العتمة فمثل ذالك فينامون وقد غفر لهم ، فمدلج في خير ، ومدلج في شر ) )(@)(@@) . ( طب عن ابن مسعود رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28279 قال النبي :(@)(@@) | 30 ( يبقاى من الجنة ما شاء الله أن يبقاى ، ثم ينشىء الله لها خلقا مما يشاء ) )(@)(@@) . ( عبد بن حميد م ، ع ، حب ، عن أنس رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28280 قال النبي :(@)(@@) | 30 ( يبل 
ms3030	 أصول الشعر وينقي البشرة ، فإن مثل الذين لا يحسنون الغسل كمثل شجرة أصابها ماء ، فلا ورقها ينبت ، ولا أصلها يرواى ، فاتقوا الله وأحسنوا الغسل فإنها من الامانة التي حملتم ، والسرائر التي استودعتم ) )(@)(@@) . ( طب عن ميمونة بنت سعد رضي الله عنها ) .(@)(@@)(@@)(@@) $ 28281 قال النبي :(@)(@@) | 30 ( يبلغه الله قوما ينفعهم به ) )(@)(@@) . ( طب و الخطيب عن أبي الدرداء أن النبي مر بنهر ومعه قعب فتوضأ وفضلت فضلة فردها في النهر وقال فذكره ) .(@)(@@)(@@)(@@) $ 28282 قال النبي :(@)(@@) | 30 ( يبيت قوم من هاذه الامة علاى طعم وشرب ولهو ولعب فيصبحون قد مسخوا قردة وخنازير وليصيبنهم خسف وقذف حتى يصبح الناس فيقولون : خسف الليلة ببني فلان ، وخسف الليلة بدار فلان خاصة وليرسلن عليهم حاصب حجارة من السماء كما أرسلت علاى قوم لوط وعلاى قبائل فيها ، وعلاى دور فيها ، وليرسلن عليهم الريح العقيم التي أهلكت عادا علاى قبائل فيها وعلاى دور فيها بشربهم الخمر ولبسهم الحرير ، واتخاذهم القينات ، وأكلهم الربا ، وقطيعتهم الرحم ) )(@)(@@) . ( ط ، عم ، وسموية والخرائطي في مساوىء الاخلاق ، ك ، هب ، عن PageV09P245 أبي أمامة ، ط عن سعيد بن المسيب مرسلا ، عم عن عبادة بن الصامث رضي الله عنه ) .(@)(@@)(@@)(@@) ||| ( الياء مع التاء(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ 28283 قال النبي :(@)(@@) | 30 ( يتبع الدجال من يهود أصبهان سبعون ألفا عليهم الطيالسة ) )(@)(@@) . ( حم ، م عن أنس رضي الله عنه ، ز ) .(@)(@@)(@@)(@@) $ 28284 قال النبي :(@)(@@) | 30 ( يتبع الميت ثلاثة : أهله ، وعمله ، وماله ، فيرجع اثنان ويبقاى واحد ، يرجع أهله وماله ويبقاى عمله ) )(@)(@@) . ( حم ، ق ، ت ، ن ، عن أنس رضي الله عنه ز ) .(@)(@@)(@@)(@@) $ 28285 قال النبي :(@)(@@) | 30 ( يتجلى لنا ربنا ضاحكا يوم القيامة ) )(@)(@@) . ( طب ، عن أبي موسى ا رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28286 قال النبي :(@)(@@) | 30 ( يترك للمكاتب الربع ) )(@)(@@) . ( ك عن علي رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28287 قال النبي :(@)(@@) | 30 ( يتعاقبون فيكم ، ملائكة بالليل وملائكة بالنهار ، ويجتمعون في صلاة الفجر وصلاة العصر ثم يعرج الذين باتوا فيكم فيسألهم ربهم وهو أعلم بهم ، كيف تركتم عبادي ؟ فيقولون : تركناهم وهم يصلون وأتيناهم وهم يصلون ) )(@)(@@) . ( ق ، ن ، عن أبي هريرة رضي 
ms3031	 الله عنه ، ز ) .(@)(@@)(@@)(@@) $ 28288 قال النبي :(@)(@@) | 30 ( يتقارب الزمان ، ويقبض العلم ، ويلقاى الشح ، وتظهر الفتن ، ويكثر الهرج ، قيل : وما الهرج ؟ قال : القتل ) )(@)(@@) . ( حم ، ق ، د ، عن أبي هريرة رضي الله عنه ، ز ) .(@)(@@) PageV09P246(@)(@@)(@@)(@@) $ 28289 قال النبي :(@)(@@) | 30 ( يتنزل ربنا تبارك وتعالاى كل ليلة إلاى السماء الدنيا حين يبقاى ثلث الليل الآخر فيقول : من يدعوني فأستجيب له ، من يسألني فأعطيه ، من يستغفرني فأغفر له ) )(@)(@@) . ( ق عن أبي هريرة رضي الله عنه ، ز ) .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ 28290 قال النبي :(@)(@@) | 30 ( يتخذ أحدكم السائمة فيشهد الصلاة في الجماعة فيتعذر عليه سائمته ، فيقول لو طلبت لسائمتي مكانا هو أكلا من هاذا فيتحول فلا يشهد الجمعة ولا الجناعة ، فيطبع الله علاى قلبه ) )(@)(@@) . ( حم ، عن حارثة بن النعمان رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28291 قال النبي :(@)(@@) | 30 ( يتزاور أهل الجنة علاى نوق عليها الحشايا فيزور أهل عليين من أسفل منهم ، ولا يزور من أسفل منهم أهل عليين إلا المتحابين في الله ، فإنهم يتزاورون من الجنة حيث شاءوا ) )(@)(@@) . ( طب عن أبي أمامة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28292 قال النبي :(@)(@@) | 30 ( يتعاقبون فيكم ، إذا كانت صلاة الفجر نزلت ملائكة النهار فشهدت معكم الصلاة جميعا وصعدت ملائكة الليل ومكثت معكم ملائكة النهار فيسألهم ربهم وهو أعلم : ما تركتم عبادي يصنعون ؟ فيقولون : جئناهم وهم يصلون ، وتركناهم وهم يصلون فاغفر لهم يوم الدين ) )(@)(@@) . ( حب ، عن أبي هريرة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28293 قال النبي :(@)(@@) | 30 ( يتلاعب بكم الشيطان في صلاتكم ، من صلى فلم يدر أشفع أم وتر ؟ فليسجد سجدتين فإنهما تمام صلاته ) )(@)(@@) . ( خ في التاريخ ، طس ، وتمام وابن عساكر عن عثمان رضي الله عنه ) .(@)(@@) PageV09P247(@)(@@)(@@)(@@) $ 28294 قال النبي :(@)(@@) | 30 ( يتكلم الرجل بتسبيحة وتكبيرة وتحميدة ويتنحنح ويؤذن أهل البيت ) )(@)(@@) . ( ه ، عن أبي أيوب رضي الله عنه قال : قلنا : يا رسول الله ما الاستئناس ؟ قال : فذكره ) .(@)(@@)(@@)(@@) $ 28295 قال النبي :(@)(@@) | 30 ( يتوضأ وضوءه للصلاة ) )(@)(@@) . ( طب ، عن عدي بن حاتم رضي الله عنه قال : سألت رسول الله عن الجنب ينام ؟ قال : فذكره ) .(@)(@@)(@@)(@@) ||| ( الياء مع الجيم(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ 28296 
ms3032	 قال النبي :(@)(@@) | 30 ( يجاء بابن آدم يوم القيامة كأنه بذج ، فيوقف بين يدي الله ، فيقول الله : أعطيتك وخولتك وأنعمت عليك فماذا صنعت ؟ فيقول : جمعته وثمرته وتركته أكثر ما كان فارجعني آتك به ، فيقول : جمعته وثمرته وتركته أكثر ما كان فارجعني آتك به ، فيقول : أرني ما قدمت فيقول : رب جمعته وثمرته وتركته أكثر ما كان فارجعني آتك به ، فإذا عبد لم يقدم خيرا فيمضاى به إلاى النار ) )(@)(@@) . ( ت عن أنس رضي الله عنه ، ز ) .(@)(@@)(@@)(@@) $ 28297 قال النبي :(@)(@@) | 30 ( يجاء بالرجل يوم القيامة فيلقاى في النار ، فتندلق أقتابه فيدور بها في النار كما يدور الحمار برحاه ، فيطيف به أهل النار فيقولون : يا فلان ما أصابك ألم تكن تأمرنا بالمعروف وتنهانا عن المنكر ؟ فيقول : بلاى قد كنت آمركم بالمعروف ولا آتيه ، وأنهاكم عن المنكر وآتيه ) )(@)(@@) . ( حم ، ق ، عن أسامة بن زيد رضي الله عنه ، ز ) .(@)(@@)(@@)(@@) $ 28298 قال النبي :(@)(@@) | 30 ( يجزىء عن الجماعة إذا مروا أن يسلم أحدهم ، PageV09P248 ويجزىء عن الجلوس أن يرد أحدهم ) )(@)(@@) . ( د ، وابن السني في عمل يوم وليلة عن علي رضي الله عنه ، ز ) .(@)(@@)(@@)(@@) $ 28299 قال النبي :(@)(@@) | 30 ( يجزىء في الوضوء رطلان من ماء ) )(@)(@@) . ( ت عن أنس رضي الله عنه ، وقال غريب : لا نعرفه إلا من حديث شريك بهذا اللفظ ) .(@)(@@)(@@)(@@) $ 28300 قال النبي :(@)(@@) | 30 ( يجزىء من السواك الاصابع ) )(@)(@@) . ( الضياء ، عن أنس رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28301 قال النبي :(@)(@@) | 30 ( يجزىء من الوضوء مد ، ومن الغسل صاع ) )(@)(@@) . ( ه ، عن عقيل رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28302 قال النبي :(@)(@@) | 30 ( يجمع الله الناس يوم القيامة في صعيد واحد ثم يطلع عليهم رب العالمين فيقول : ألا يتبع كل إنسان ما كان يعبد ، فيمثل لصاحب الصليب صليبه ولصاحب التصاوير تصاويره ، ولصاحب النار ناره ، فيتبعون ما كانوا يعبدون ، ويبقاى المسلمون فيطلع عليهم رب العالمين فيقول : ألا تتبعون الناس ؟ فيقولون : نعوذ بالله منك ، ونعوذ بالله منك ، الله ربنا ، وهاذا مكاننا حتى نراى ربنا ، وهو يأمرهم ويثبتهم ، قالوا : وهل نراه يا رسول الله ؟ قال : وهل تضارون في رؤية القمر ليلة البدر 
ms3033	 ؟ قالوا : لا ، قال : فإنكم لا تضارون في رؤيته تلك الساعة ، ثم يتواراى ، ثم يطلع فيعرفهم نفسه ، ثم يقول : أنا ربكم فاتبعوني ، فيقوم المسلمون ويوضع الصراط فيمر عليه مثل جياد الخيل والركاب ، وقولهم عليه : سلم سلم ويبقاى أهل النار فيطرح فيها منهم فوج ، ثم يقال : هل امتلات فتقول : هل من مزيد ؟ ثم يطرح فيها فوج فيقال : هل امتلات فتقول : هل من مزيد ؟ حتى إذا أوعبوا فيها وضع الرحمان قدمه فيها ، وأزواى بعضها إلاى بعض ثم قال : قط ، قالت : قط قط ، فإذا أدخل الله أهل الجنة الجنة ، وأهل النار النار ، أتي بالموت ملببا ، فيوقف علاى السور الذي بين أهل الجنة وأهل النار ، ثم يقال : يا أهل الجنة فيطلعون خائفين ، ثم يقال : يا أهل النار فيطلعون مستبشرين يرجون الشفاعة ، فيقال لاهل الجنة وأهل PageV09P249 النار : هل تعرفون هاذا ؟ فيقول هاؤلاء وهاؤلاء : قد عرفناه هو الموت الذي وكل بنا ، فيضجع فيذبح ذبحا علاى السور ، ثم يقال : يا أهل الجنة خلود لا موت ويا أهل النار خلود لا موت ) )(@)(@@) . ( ت ، حسن صحيح عن أبي هريرة رضي الله عنه ، ز ) .(@)(@@)(@@)(@@) $ 28303 قال النبي :(@)(@@) | 30 ( يجمع المؤمنون يوم القيامة ، فيهتمون لذالك فيقولون : لو استشفعنا علاى ربنا فأراحنا من مكاننا هاذا ، فيأتون آدم عليه السلام فيقولون : يا آدم أنت أبو البشر خلقك الله بيده ، وأسجد لك ملائكته ، وعلمك أسماء كل شيء فاشفع لنا عند ربك حتى يريحنا من مكاننا هاذا ، فيقول لهم آدم عليه السلام : لست هناكم ويذكر ذنبه الذي أصابه فيستحيي ربه عز وجل من ذالك ويقول : ولاكن ائتوا نوحا فإنه أول رسول بعثه الله إلاى أهل الارض ، فيأتون نوحا عليه السلام فيقول : لست هناكم ويذكر لهم خطيئة سؤاله ربه ما ليس به علم فيستحيي ربه من ذالك ولاكن ائتوا إبراهيم خليل الرحمان ، فيأتونه فيقول : لست هناكم ولاكن ائتوا موساى عبدا كلمه الله وأعطاه التوراة ، فيأتون موساى عليه السلام فيقول : لست هناكم ويذكر لهم النفس التي قتل بغير نفس فيستحيي ربه من ذالك ، ولاكن ائتوا عيساى عبد الله 
ms3034	 ورسوله وكلمته وروحه ، فيأتون عيساى عليه السلام فيقول لهم : لست هناكم ، ولاكن ائتوا محمدا عبدا غفر الله له ما تقدم من ذنبه وما تأخر ، فأقوم فأمشي بين سماطين من المؤمنين ، حتى أستأذن علاى ربي فيؤذن لي ، فإذا رأيت ربي وقعت ساجدا لربي تبارك وتعالاى ، فيدعني ما شاء أن يدعني ثم يقول : ارفع محمد قل يسمع ، وسل تعطه ، واشفع تشفع ، فأرفع رأسي فأحمده بتحميد يعلمنيه ، ثم أشفع فيحد لي حدا ، فأدخلهم الجنة ، ثم أعود إليه أدعو الثانية ، فإذا رأيت ربي وقعت ساجدا لربي تبارك وتعالاى ، فيدعني ما شاء الله أن يدعني ثم يقول : ارفع محمد قل يسمع ، وسل تعطه ، واشفع تشفع ، فأرفع رأسي فأحمده بتحميد يعلمنيه ، ثم أشفع فيحد لي حدا فأدخلهم الجنة ، ثم أعود أدعو الثالثة ، فإذا رأيت ربي تبارك وتعالاى وقعت ساجدا لربي فيدعني ما شاء أن يدعني ، ثم يقول : ارفع محمد قل يسمع ، وسل تعطه ، واشفع تشفع ، فأرفع رأسي فأحمده بتحميد PageV09P250 يعلمنيه ، ثم أشفع فيحد لي حدا فأدخلهم الجنة ، ثم أعود الرابعة فأقول : يا رب ما بقي إلا من حبسه القرآن فيخرج من النار من قال : لا إلاه إلا الله وكان في قلبه من الخير ما يزن شعيرة ، ثم يخرج من النار من قال : لا إلاه إلا الله وكان في قلبه من الخير ما يزن برة ، ثم يخرج من النار من قال : لا إلاه إلا الله وكان في قلبه من الخير ما يزن ذرة ) )(@)(@@) . ( حم ، ق ، ن ، ه ، عن أنس رضي الله عنه ، ز ) .(@)(@@)(@@)(@@) $ 28304 قال النبي :(@)(@@) | 30 ( يجمع الله الناس يوم القيامة فيقوم المؤمنون حتى تزلف لهم الجنة فيأتون آدم عليه السلام فيقولون : يا أبانا استفتح لنا الجنة ، فيقول : وهل أخرجكم من الجنة إلا خطيئة أبيكم آدم لست بصاحب ذالك ، اذهبوا إلاى ابني إبراهيم خليل الله ، قال : فيقول إبراهيم : لست بصاحب ذالك ، إنما كنت خليلا من وراء وراء ، اعمدوا إلاى موساى عليه السلام الذي كلمه الله تكليما ، فيأتون موساى فيقول : لست بصاحب ذالك ، اذهبوا إلاى عيساى كلمة 
ms3035	 الله وروحه ، فيقول عيساى عليه السلام : لست بصاحب ذالك ، اذهبوا إلاى محمد ، فيأتون محمدا فيقوم فيؤذن له وترسل الامانة والرحم فتقومان جنبتي الصراط يمينا وشمالا ، فيمر أولكم كالبرق ، ثم كمر الريح ، ثم كمر الطير يقول : يا رب سلم حتى تعجز أعمال العباد وحتى يجيء الرجل فلا يستطيع السير إلا زحفا ، وقال في حافتي الصراط كلاليب معلقة مأمورة بأخذ من أمرت بأخذه ، فمخدوش ناج ومكدوس في النار ) )(@)(@@) . ( م عن أبي هريرة وحذيفة رضي الله عنهما معا ، ز ) .(@)(@@)(@@)(@@) $ 28305 قال النبي :(@)(@@) | 30 ( يجيء الدجال فيطأ الارض إلا مكة والمدينة ، فيأتي المدينة فيجد بكل نقب من أنقابها صفوفا من الملائكة ، فيأتي سبخة الجرف فيضرب PageV09P251 رواقه فترجف المدينة ثلاث رجفات فيخرج إليه كل منافق ومنافقة ) )(@)(@@) . ( حم ، ق ، عن أنس رضي الله عنه ، ز ) .(@)(@@)(@@)(@@) $ 28306 قال النبي :(@)(@@) | 30 ( يجيء الرجل آخذا بيد الرجل فيقول : يا رب هاذا قتلني ، فيقول الله له : لم قتلته ؟ فيقول : قتلته لتكون العزة لك ، فيقول فإنها لي ، ويجيء الرجل آخذا بيد الرجل فيقول : أي رب ، إن هاذا قتلني ، فيقول الله : لم قتلته ؟ فيقول : لتكون العزة لفلان ، فيقول : إنها ليست لفلان فيبوء بإثمه ) )(@)(@@) . ( ن ، عن ابن مسعود رضي الله عنه ، ز ) .(@)(@@)(@@)(@@) $ 28307 قال النبي :(@)(@@) | 30 ( يجيء القرآن يوم القيامة فيقول : يا رب حله ، فيلبس تاج الكرامة ، ثم يقول : يا رب زده فيلبس حلة الكرامة ، ثم يقول : يا رب ارض عنه ، فيرضاى عنه ، فيقول : اقرأ وارق ويزاد بكل آية حسنة ) )(@)(@@) . ( ت ، ك ، عن أبي هريرة رضي الله عنه ، ز ) .(@)(@@)(@@)(@@) $ 28308 قال النبي :(@)(@@) | 30 ( يجيء القرآن يوم القيامة كالرجل الشاحب فيقول لصاحبه : أنا الذي أسهرت ليلك وأظمأت نهارك ) )(@)(@@) . ( ه ، ك ، عن بريدة رضي الله عنه ، ز ) .(@)(@@)(@@)(@@) $ 28309 قال النبي :(@)(@@) | 30 ( يجيء المقتول بالقاتل يوم القيامة ، ناصيته ورأسه بيده ، وأوداجه تشخب دما فيقول : يا رب سل هاذا فيم قتلني حتى يدنيه من العرش ) )(@)(@@) . ( ت ، ن ، ه ، عن ابن عباس رضي الله عنهما ، ز ) .(@)(@@)(@@)(@@) $ 28310 قال النبي :(@)(@@) | 30 ( يجيء المقتول يوم القيامة متعلقا بقاتله فيقول : يا 
ms3036	 رب سل هاذا فيم قتلتي ، فيقول الله : فيم قتلت هاذا ؟ فيقول : في ملك فلان ) )(@)(@@) . ( ن ، طب ، عن جندب رضي الله عنه ، ز ) .(@)(@@)(@@)(@@) $ 28311 قال النبي :(@)(@@) | 30 ( يجيء النبي يوم القيامة ومعه الرجل ، والنبي ومعه PageV09P252 الرجلان ، والنبي ومعه الثلاثة وأكثر من ذالك ، فيقال له : هل بلغت قومك ؟ فيقول : نعم ، فيدعاى قومه فيقال لهم : هل بلغكم هاذا ؟ فيقولون لا ، فيقال له : من يشهد لك ؟ فيقول : محمد وأمته ، فيدعاى محمد وأمته فيقال لهم : هل بلغ هاذا قومه ؟ فيقولون نعم ، فيقال : وما علمكم بذالك ؟ فيقولون : جاءنا نبينا فأخبرنا أن الرسل قد بلغوا فصدقناه ، فذالك قوله : { وكذالك جعلناكم أمة وسطا لتكونوا شهداء علاى الناس ويكون الرسول عليكم شهيدا } ) )(@)(@@) . ( حم ، ن ، ه ، عن أبي سعيد رضي الله عنه ، ز ) .(@)(@@)(@@)(@@) $ 28312 قال النبي :(@)(@@) | 30 ( يجيء نوح وأمته فيقول الله هل بلغت ؟ فيقول : نعم أي رب ، فيقول لأمته : هل بلغكم ؟ فيقولون لا ، ما جاءنا من نبي ، فيقول لنوح : من يشهد لك ؟ فيقاول : محمد وأمته وهو قوله تعالاى : { وكذالك جعلناكم أمة وسطا لتكونوا شهداء علاى الناس } ، والوسط : العدل ، فيدعون فيشهدون له بالبلاغ ، قال : ثم أشهد عليكم ) )(@)(@@) . ( حم ، خ ، ت ، ن ، ه ، عن أبي سعيد رضي الله عنه ، ز ) .(@)(@@)(@@)(@@) $ 28313 قال النبي :(@)(@@) | 30 ( يجيء يوم القيامة ناس من المسلمين بذنوب أمثال الجبال يغفرها الله لهم ويضعها علاى اليهود ) )(@)(@@) . ( م ، عن أبي موساى رضي الله عنه ، ز ) .(@)(@@)(@@)(@@) $ 28314 قال النبي :(@)(@@) | 30 ( يجير علاى أمتي أدناهم ) )(@)(@@) . ( حم ، ك ، عن أبي هريرة رضي الله عنه ) .(@)(@@) PageV09P253(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ 28315 قال النبي :(@)(@@) | 30 ( يجاء يوم القيامة بصحف مختومة فتنصب بين يدي الله عز وجل ، فيقول الله للملائكة : ألقوا هاذا واقبلوا هاذا ، فتقول الملائكة : وعزتك ما رأينا إلا خيرا ، فيقول وهو أعلم إن هاذا كان لغيري ، ولا أقبل اليوم من العمل إلا ما كان ابتغي به وجهي ) )(@)(@@) . ( قط ، كر ، عن أنس رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28316 قال النبي :(@)(@@) | 30 ( يجاء بصاحب المال الذي أطاع الله فيه ، وماله بين يديه ، كلما انكفأ به الصراط قال له 
ms3037	 ماله امض فقد أديت حق الله في ، ثم يجاء بصاحب المال الذي لم يطع الله فيه ، وماله بين كتفيه كلما انكفأ به الصراط قال له ماله : ويلك ألا أديت حق الله في ، فما يزال كذالك حتى يدعو بالويل والثبور ) )(@)(@@) . ( ص ، هق ، حل ، و ابن عساكر عن أبي الدرداء رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28317 قال النبي :(@)(@@) | 30 ( يجاء بالموت يوم القيامة في صورة كبش أملح فيوقف بين الجنة والنار ، فيقال : يا أهل الجنة هل تعرفون هاذا ؟ فيشرئبون وينظرون ويقولون : نعم ، ويقال : يا أهل النار هل تعرفون هاذا ؟ فيشرئبون وينظرون ويقولون نعم : هاذا الموت ، فيؤمر به فيذبح ثم يقال : يا أهل الجنة خلود فلا موت ، ويا أهل النار خلود فلا موت ) )(@)(@@) . ( م ، طب ، عن ابن عمر رضي الله عنهما ) .(@)(@@)(@@)(@@) $ 28318 قال النبي :(@)(@@) | 30 ( يجاء بالدنيا مصورة يوم القيامة فتقول : يا رب اجعلني لرجل من أدناى أهل الجنة منزلة ، فيقول الله : أنت أنتن من ذالك ، بل أنت وأهلك في النار ) )(@)(@@) . ( حم ، عن أنس رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28319 قال النبي :(@)(@@) | 30 ( يجاء بجهنم تقاد بسبعين ألف زمام ، مع كل زمام سبعون ألف ملك يجرونها ) )(@)(@@) . ( طب ، عن ابن مسعود رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28320 قال النبي :(@)(@@) | 30 ( يجاء بالعبد يوم القيامة فتوضع حسناته في كفة وسيئاته في كفة فترجح السيئات فتجيء بطاقة فتقع في كفة الحسنات فترجح بها ، PageV09P254 فيقول : يا رب ما هاذه البطاقة ؟ فما من عمل عملته في ليلي ونهاري إلا وقد استقبلت به ، قال : هاذا ما قيل فيك وأنت منه بريء فينجو بذالك ) )(@)(@@) . ( الحكيم عن ابن عمر رضي الله عنهما ) .(@)(@@)(@@)(@@) $ 28321 قال النبي :(@)(@@) | 30 ( يجاء بالاءمير يوم القيامة فيلقاى في النار فيطحن فيها كما يطحن الحمار بطاحونته ، فيقال له : ألم تكن تأمر بالمعروف وتنهاى عن المنكر ؟ قال : بلاى ولاكن لم أكن لافعله ) )(@)(@@) . ( حل ، عن أسامة بن زيد رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28322 قال النبي :(@)(@@) | 30 ( يجاء بالدنيا يوم القيامة فيقال : ميزوا ما كان منها لله ، وألقوا سائرها في النار ) )(@)(@@) . ( أبو سعيد بن الاعرابي في الزهد عن 
ms3038	 عبادة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28323 قال النبي :(@)(@@) | 30 ( يجتمعون يوم القيامة فيقال : أين فقراء هاذه الامة ومساكينها ؟ فيقومون ، فيقال لهم ماذا عملتم ؟ فيقولون : ربنا ابتلينا فصبرنا ، ووليت الامور والسلطان غيرنا ، فيقول الله عز وجل : صدقتم ، فيدخلون الجنة قبل الناس بزمان ، وتبقاى شدة الحساب علاى ذوي الامور والسلطان ، قالوا : فأين المؤمنون يومئذ ؟ قال : يوضع لهم كراسي من نور مظلل عليهم الغمام ، يكون ذالك اليوم أقصر علاى المؤمنين من ساعة من نهار ) )(@)(@@) . ( طب عن ابن عمرو رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28324 قال النبي :(@)(@@) | 30 ( يجري هلاك هاذه الأمة علاى يدي أغيلمة من قريش ) )(@)(@@) . ( حم عن أبي هريرة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28325 قال النبي :(@)(@@) | 30 ( يجري علاى المختلعة الطلاق ما كانت في العدة ) )(@)(@@) . ( عبد الرزاق عن علي بن طلحة الهاشمي مرسلا وعن ابن مسعود رضي الله عنه موقوفا ) .(@)(@@)(@@)(@@) $ 28326 قال النبي :(@)(@@) | 30 ( يجزىء من السترة مثل مؤخرة الرجل ولو بدقة شعر ) )(@)(@@) . ( ك ، وابن عساكر عن أبي هريرة وابن عباس رضي الله عنهما ) .(@)(@@)(@@)(@@) $ 28327 قال النبي :(@)(@@) | 30 ( يجزىء من الوضوء المد ، ومن الجنابة الصاع ) )(@)(@@) PageV09P255 . ( ش ، وعبد بن حميد وابن خزيمة ك ، هق ، عن جابر رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28328 قال النبي :(@)(@@) | 30 ( يجزىء في الوضوء مد وفي الغسل صاع ) )(@)(@@) . ( طس ، عن ابن عباس رضي الله عنهما ) .(@)(@@)(@@)(@@) $ 28329 قال النبي :(@)(@@) | 30 ( يجزىء من الضرورة غبوق أو صبوح ) )(@)(@@) . ( ك عن سمرة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28330 قال النبي :(@)(@@) | 30 ( يجزىء عنك الثلث ) )(@)(@@) . ( ك ، هق ، عن أبي لبابة أنه لما تاب الله عليه قال : إني أنخلع من مالي ، قال رسول الله فذكره ) .(@)(@@)(@@)(@@) $ 28331 قال النبي :(@)(@@) | 30 ( يجمع الناس غدا في الموقف ثم يلتقط منهم قذفة أصحابي ومبغضوهم فيحشرون إلاى النار ) )(@)(@@) . ( القاضي أبو سعيد محمد بن أحمد بن ساعد عن سعيد بن المسيب عن عمر رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28332 قال النبي :(@)(@@) | 30 ( يجمع الله الناس للحساب فيجيء فقراء المؤمنين يزفون كما يزف الحمام ، فيقال لهم : قفوا للحساب ، فيقولون : ما عندنا شيء للحساب ، ولا آتيتمونا شيئا نحاسب به ، فيقول الله : صدق عبادي 
ms3039	 فيفتح لهم باب الجنة فيدخلونها قبل الناس بسبعين عاما ) )(@)(@@) . ( ع ، و الحسن بن سفيان وابن سعد ، طس ، حل ، وابن عساكر عن سعيد بن عامر بن جذيم رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28333 قال النبي :(@)(@@) | 30 ( يجمع الله الناس يوم القيامة فينادي مناد : يا أيها الناس ألم ترضوا من ربكم الذي خلقكم وصوركم ورزقكم أن يولي كل إنسان ما كان يعبد في الدنيا ويتولى ، أليس ذالك عدلا من ربكم ؟ قالوا : بلاى ، قال : فلينطلق كل إنسان منكم إلاى ما كانوا يعبدون ) )(@)(@@) .(@)(@@) PageV09P256(@)(@@)(@@)(@@) $ 28334 قال النبي :(@)(@@) | 30 ( يجمع الناس في صعيد واحد لينفذ لهم البصر ويسمعهم الداعي ، ثم ينادي مناد سيعلم أهل الجمع لمن الكرم اليوم ثلاث مرات ثم يقول : أين الذين كانوا تتجافاى جنوبهم عن المضاجع ، ثم يقول : أين الذين كانت لا تلهيهم تجارة ولا بيع عن ذكر الله ، ثم ينادي مناد : سيعلم أهل الجمع لمن الكرم اليوم ؟ ثم يقول : أين الحمادون الذين كانوا يحمدون ربهم ) )(@)(@@) . ( ك وابن مردويه ، هب ، حل ، عن عقبة بن عامر رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28335 قال النبي :(@)(@@) | 30 ( يجمع الله الامم في صعيد واحد يوم القيامة ، فإذا بدأ الله أن يصدع بين خلقه مثل لكل قوم ما كانوا يعبدون فيتبعونهم حتى يقتحموهم النار ثم يأتينا ربنا عز وجل ونحن علاى مكان رفيع ، فيقول : من أنتم ؟ فيقولون : نحن المسلمون ، فيقول : ما تنتظرون ؟ فنقول : ننتظر ربنا عز وجل ، فيقول : وهل تعرفونه إن رأيتموه ؟ فيقولون : نعم ، فيقول : كيف تعرفونه ولم ترونه ، فيقولون نعم إنه لا عدل له ، فيتجلى لنا ضاحكا فيقول : أبشروا معشر المسلمين فإنه ليس منكم أحد إلا جعلت في النار يهوديا أو نصرانيا مكانه ) )(@)(@@) . ( حم ، عن أبي موساى رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28336 قال النبي :(@)(@@) | 30 ( يجمع الله يوم القيامة الناس فاي صعيد واحد يسمعهم الداعي وينفذهم البصر ، فيقوم مناد فينادي : أين الذين كانوا يحمدون الله في السراء والضراء ؟ فيقومون وهم قليل ، فيدخلون الجنة بغير حساب ، ثم يعود فينادي : أين الذين كانت تتجافاى جنوبهم عن المضاجع يدعون ربهم خوفا وطمعا ومما رزقناهم ينفقون 
ms3040	 ؟ فيقومون وهم قليل ، فيدخلون الجنة بغير حساب ، ثم يعود فينادي : ليقم الذين كانوا لا تلهيهم تجارة ولا بيع عن ذكر الله ، فيقومون وهم قليل ، فيدخلون الجنة بغير حساب ، ثم يقوم سائر الناس فيحاسبون ) )(@)(@@) PageV09P257 . ( هناد ومحمد بن نصر في الصلاة وابن أبي حاتم وابن مردويه عن أسماء بنت يزيد رضي الله عنها ) .(@)(@@)(@@)(@@) $ 28337 قال النبي :(@)(@@) | 30 ( يجمع الله أطفال أمة محمد في حياض تحت العرش فيطلع الله عليهم اطلاعة فيقول : مالي أراكم رافعي رؤوسكم ؟ فيقولون : يا ربنا الآباء والأمهات في عطش ونحن في هاذه الحياض ، فيوحي إليهم أن اغرفوا في هاذه الآنية من هاذا الماء من خلال الصفوف فاسقوا الآباء والأمهات ) )(@)(@@) . ( الديلمي من طريقين عن ابن عمر رضي الله عنهما ) .(@)(@@)(@@)(@@) $ 28338 قال النبي :(@)(@@) | 30 ( يجند الناس أجنادا : جند باليمن ، وجند بالشام ، وجند بالمشرق ، وجند بالمغرب ، عليكم بالشام فإنها صفوة الله من بلاده يسوق إليها صفوته من عباده ، عليكم بالشام فإن الله تكفل لي بالشام وأهله ، فمن أباى فليلحق بيمنه ) . ) )(@)(@@) ( طب عن واثلة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28339 قال النبي :(@)(@@) | 30 ( يجوز الجذع من الضأن أضحية ) )(@)(@@) . ( ه ، و الحسن بن سفيان عن هلال رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28340 قال النبي :(@)(@@) | 30 ( يجوز اللعب في كل شيء غير ثلاث خلال ، فمن لعب بشيء منهن جاز وإن كره : إن نكح فقد جاز نكاحه ، وإن طلق فقد جاز طلاقه ، وإن أعتق فقد جاز عتاقه ) )(@)(@@) . ( الديلمي عن أبي الدرداء رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28341 قال النبي :(@)(@@) | 30 ( يجيء الرجل يوم القيامة من الحسنات بما يظن أنه ينجو بها ، فلا يزال رجل يجيء قد ظلمه بمظلمة فيؤخذ من حسناته فيعطاى المظلوم حتى لا يبقاى له حسنة ، ثم يجيء من يطلبه ولم يبق من حسناته شيء فيؤخذ من سيئات المظلوم فتوضع علاى سيئاته ) )(@)(@@) . ( طب ، عن سل مان رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28342 قال النبي :(@)(@@) | 30 ( يجيء القاتل يوم القيامة مكتوبا بين عينيه : آيس اليوم من رحمة الله عز وجل ) )(@)(@@) . ( الخطيب عن أبي سعيد رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28343 قال النبي :(@)(@@) | 30 ( يجيء المقتول 