ms61	(@)(@@)(@@)(@@) $DIC_NIS$ الخنبي (@)(@@) بالفتح والسكون وموحدة إلى خنب جد.(@)(@@)(@@)(@@) $DIC_NIS$ الخنبوني (@)(@@) بضم أوله والموحدة ثالثة آخره نون إلى خنبون قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الخنجي (@)(@@) بالضم والسكون وجيم إلى خنجة جد.(@)(@@)(@@)(@@) $DIC_NIS$ الخندفي (@)(@@) بكسر أوله والمهملة وفاء إلى خندف امرأة الياس بن مضر وبفتحهما وقاف إلى الخندف موضع بجرجان.(@)(@@)(@@)(@@) $DIC_NIS$ الخنذعي (@)(@@) بضم أوله والمعجمة ومهملة إلى بني خنذع بطن من طيء. PageV01P097(@)(@@)(@@)(@@) $DIC_NIS$ الخنقاباذي (@)(@@) مر في الخمقاباذي.(@)(@@)(@@)(@@) $DIC_NIS$ الخنليقي (@)(@@) بالضم والفتح وكسر اللام وتحتية وقاف إلى خنليق بلد بدربند.(@)(@@)(@@)(@@) || باب الخاء والواو(@)(@@)(@@)(@@) $DIC_NIS$ الخواتيمي (@)(@@) إلى جمع الخاتام.(@)(@@)(@@)(@@) $DIC_NIS$ الخوارزمي (@)(@@) إلى خوارزم بلد.(@)(@@)(@@)(@@) $DIC_NIS$ الخواري (@)(@@) بالضم والتخفيف وراء إلى خوار بلد بالري وجد.(@)(@@)(@@)(@@) $DIC_NIS$ الخواشتي (@)(@@) بفتح الخاء والواو ومعجمة وفوقية إلى خواشت قرية ببلخ.(@)(@@)(@@)(@@) $DIC_NIS$ الخواص (@)(@@) إلى الخوص.(@)(@@)(@@)(@@) $DIC_NIS$ الخوافي (@)(@@) بالفتح والتخفيف وفاء إلى خواف ناحية بنيسابور.(@)(@@)(@@)(@@) $DIC_NIS$ الخواقندي (@)(@@) بالضم والتخفيف وفتح القاف وسكون النون ومهملة إلى خواقند بلد بفرغانة.(@)(@@)(@@)(@@) $DIC_NIS$ الخوجاني (@)(@@) بفتح أوله والواو والجيم المشددة إلى خوجان قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الخوجاني (@)(@@) بالضم والسكون وتخفيف الجيم إلى خوجان بلد بنيسابور.(@)(@@)(@@)(@@) $DIC_NIS$ الخورسفلقي (@)(@@) بالضم والراء وفتح المهملة واللام قبلها فاء ساكنة وبعدها قاف إلى خورسفلق قرية باستراباذ.(@)(@@)(@@)(@@) $DIC_NIS$ الخورنقي (@)(@@) بفتح أوله والواو والنون وسكون الراء وقاف إلى خورنق قرية ببلخ وقصر بالحيرة.(@)(@@)(@@)(@@) $DIC_NIS$ الخوري (@)(@@) بالضم والراء إلى خور قرية ببلخ.(@)(@@)(@@)(@@) $DIC_NIS$ الخوزاني (@)(@@) بالضم والزاي إلى خوزان من قرى بنج ديه.(@)(@@)(@@)(@@) $DIC_NIS$ الخوزياني (@)(@@) بالضم وكسر الزاي وتخفيف التحتية إلى خوزيان قصر بنسف.(@)(@@)(@@)(@@) $DIC_NIS$ الخوزي (@)(@@) بالضم والزاي إلى خوزستان بلاد بين فارس والبصرة وسكة الخوز بأصبهان وشعب الخوز بمكة شرفها الله تعالى.(@)(@@)(@@)(@@) $DIC_NIS$ الخوستي (@)(@@) بفتح الخاء والمهملة وسكون الواو وفوقية إلى خوست بلد ببلخ.(@)(@@)(@@)(@@) $DIC_NIS$ الخوشي (@)(@@) بالضم والمعجمة إلى خوش قرية بإسفراين. PageV01P098(@)(@@)(@@)(@@) $DIC_NIS$ الخوصي (@)(@@) بالفتح والسكون إلى أبي الخوصاء جد.(@)(@@)(@@)(@@) $DIC_NIS$ الخوميني (@)(@@) بالضم وكسر الميم وتحتية ونون إلى خومين قرية بالري.(@)(@@)(@@)(@@) $DIC_NIS$ الخونجاني (@)(@@) بالفتح والكسر وسكون النون وجيم ونون إلى خونجان قرية بأصبهان.(@)(@@)(@@)(@@) $DIC_NIS$ الخولاني (@)(@@) بالفتح والسكون إلى خولان قبيلة نزلت بالشام.(@)(@@)(@@)(@@) $DIC_NIS$ الخويلدي (@)(@@) بالتصغير إلى خويلد 
ms62	 بن عوف بن عامر بن عقيل والخويلديين طائفة.(@)(@@)(@@)(@@) $DIC_NIS$ الخوبي (@)(@@) بالضم وفتح الواو وتشديد الياء الأولى إلى خوي مدينة بأذربيجان.(@)(@@)(@@)(@@) || باب الخاء واللام لف(@)(@@)(@@)(@@) $DIC_NIS$ الخلادي (@)(@@) بالفتح والتشديد ودال مهملة إلى خلاد جد وبسين مهملة إلى خلاس جد وبلام إلى الخل كالخلال.(@)(@@)(@@)(@@) $DIC_NIS$ الخلاوي (@)(@@) بالفتح والتخفيف إلى خلاوة بطن من بني سعد بن تجيب.(@)(@@)(@@)(@@) || باب الخاء والياء(@)(@@)(@@)(@@) $DIC_NIS$ الخياري (@)(@@) بالكسر وتخفيف التحتية وراء إلى الخيار بطن من همذان.(@)(@@)(@@)(@@) $DIC_NIS$ الخيابري (@)(@@) بالفتح والتخفيف وكسر الموحدة إلى خيبر المعروفة لأنها سبعة حصون فتجمع على خيابر.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الخياذاني (@)(@@) بذال معجمة ونون آخره إلى خياذان قرية بأصبهان.(@)(@@)(@@)(@@) $DIC_NIS$ والخيازجي (@)(@@) بالكسر وفتح الزاي وجيم إلى خيازج قرية بقزوين انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الخياطي (@)(@@) بالتشديد إلى خياطة الثياب كالخياط.(@)(@@)(@@)(@@) $DIC_NIS$ الخيام (@)(@@) إلى الخيمة المعروفة وبيعها.(@)(@@)(@@)(@@) $DIC_NIS$ الخيبري(@)(@@) بفتح الباء الموحدة إلى خيبر المعروفة وخيبري بطن من طيء.(@)(@@)(@@)(@@) $DIC_NIS$ الخيدشتري (@)(@@) بفتح أوله والمهملة والفوقية قبل الراء وسكون التحتية والمعجمة إلى خيدشتر قرية بنواحي سمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ الخيري (@)(@@) بالكسر والراء إلى خيرة جد.(@)(@@)(@@)(@@) $DIC_NIS$ الخيراني (@)(@@) بالراء إلى خيران جد. PageV01P099(@)(@@)(@@)(@@) $DIC_NIS$ الخيزاخزي (@)(@@) بفتح الخاءين والزاي الأولى إلى خيزاخزا بالقصر قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الخيزراني (@)(@@) بالفتح وضم الزاي ثم راء إلى الخيزران المعروف.(@)(@@)(@@)(@@) $DIC_NIS$ الخيشي (@)(@@) بالفتح ومعجمة إلى الخيش المعروف وكذا الخيشاني قلت: بل هو إلى خيشان موضع بسمرقند انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الخيلي (@)(@@) بوزنه إلى الخيل المعروفة وقرية الخيل بالري.(@)(@@)(@@)(@@) $DIC_NIS$ الخيليلي (@)(@@) بزيادة تحتية ولام إلى خيليل بطن من غسان.(@)(@@)(@@)(@@) $DIC_NIS$ الخيني (@)(@@) بالفتح والسكون ونون إلى خين قرية بطوس.(@)(@@)(@@)(@@) $DIC_NIS$ الخيواني (@)(@@) بالفتح والسكون إلى خيوان بطن من همذان.(@)(@@)(@@)(@@) $DIC_NIS$ الخيوطي (@)(@@) بضمتين إلى الخيوط المعروفة.(@)(@@)(@@)(@@) $DIC_NIS$ الخيوي (@)(@@) بالكسر وضم التحتية المشددة إلى خيو جد.(@)(@@)(@@)(@@) $DIC_NIS$ الخيلامي (@)(@@) بالفتح والسكون إلى خيلام بلد بفرغانة.(@)(@@)(@@)(@@) | حرف الدال المهملة(@)(@@)(@@)(@@) || باب الدال والألف(@)(@@)(@@)(@@) $DIC_NIS$ الدابوي (@)(@@) بضم الموحدة إلى دابويه جد.(@)(@@)(@@)(@@) $DIC_NIS$ الدابي (@)(@@) إلى داب جد.(@)(@@)(@@)(@@) $DIC_NIS$ الداجوني (@)(@@) بضم الجيم إلى داجون قرية بالرملة.(@)(@@)(@@)(@@) $DIC_NIS$ الدارابجردي (@)(@@) بفتح الموحدة وكسر الجيم وسكون الراء الثانية ومهملة إلى دارابجرد بلد بفارس ومحلة بنيسابور أيضا. 
ms63	(@)(@@)(@@)(@@) $DIC_NIS$ الداراني (@)(@@) بتخفيف الراء إلى داريا قرية بدمشق. PageV01P100(@)(@@)(@@)(@@) $DIC_NIS$ الدارزنجي (@)(@@) بفتح الراء والزاي وسكون النون وجيم إلى دارزنج قرية بالصغانيان.(@)(@@)(@@)(@@) $DIC_NIS$ الدارسي (@)(@@) بكسر الراء إلى درس العلم.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الدارقزي (@)(@@) إلى دار القز محلة ببغداد انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الدارقطني (@)(@@) بفتح الراء وضم القاف وسكون الطاء إلى دار القطن محلة ببغداد.(@)(@@)(@@)(@@) $DIC_NIS$ الداركاني (@)(@@) بفتح الراء إلى داركان قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الداركي (@)(@@) بفتح الراء إلى دارك قرية بأصبهان.(@)(@@)(@@)(@@) $DIC_NIS$ الدارمي (@)(@@) بكسر الراء إلى دارم بطن من تميم.(@)(@@)(@@)(@@) $DIC_NIS$ قتل: الداروني (@)(@@) إلى الدارون منزل القيروان ذكره الزبيدي في طبقات النحاة انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الداري (@)(@@) إلى قرية يقال لها دار واشكيدان قلت: هي بهراة انتهى وإلى الدار بن هاني جد تميم الصحابي وإلى بيع العطر لأنه يجلب من دارين قلت: هي فرضة بالبحرين يجلب إليها المسك من الهند انتهى وإلى عبد الدار بن قصي والأكثر عبدري.(@)(@@)(@@)(@@) $DIC_NIS$ الداسي (@)(@@) إلى داسة جد أبي بكر راوي أب داود.(@)(@@)(@@)(@@) $DIC_NIS$ الداغوني (@)(@@) بضم المعجمة إلى بيع المداسات بلغة أهل مرو.(@)(@@)(@@)(@@) $DIC_NIS$ الداماني (@)(@@) إلى دامان قرية بالجزيرة.(@)(@@)(@@)(@@) $DIC_NIS$ الدامغاني (@)(@@) بفتح الميم والمعجمة إلى دامغان مدينة من بلاد قومس.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الداموسي (@)(@@) إلى داموس بلد بالمغرب انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الداناج (@)(@@) بجيم بالفارسية العالم.(@)(@@)(@@)(@@) $DIC_NIS$ الدانوي (@)(@@) بضم النون إلى دانويه جد.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الداني (@)(@@) إلى دانية مدينة بالأندلس انتهى. PageV01P101(@)(@@)(@@)(@@) $DIC_NIS$ الداوداني (@)(@@) بفتح الواو والمهملة إلى داودان مدينة من أعمال البصرة.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الداوري (@)(@@) إلى داور ناحية بسجستان.(@)(@@)(@@)(@@) $DIC_NIS$ والداورداني(@)(@@) إلى داوردان موضع شرقي واسط انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الداودي (@)(@@) إلى جد ومذهب داود.(@)(@@)(@@)(@@) $DIC_NIS$ الداهري (@)(@@) بكسر الهاء وراء إلى داهر قلت: بل إلى الداهرية قرية ببغداد مشهورة انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الدالاني (@)(@@) بنون إلى دالان قبيلة من همذان.(@)(@@)(@@)(@@) || باب الدال والباء(@)(@@)(@@)(@@) $DIC_NIS$ الدباس (@)(@@) إلى الدبس المأكول.(@)(@@)(@@)(@@) $DIC_NIS$ الدباغ (@)(@@) إلى دباغ الجلود.(@)(@@)(@@)(@@) $DIC_NIS$ الدباوندي (@)(@@) بالضم وفتح الموحدة والواو وسكون النون ومهملة إلى دباوند ناحية تلي طبرستان.(@)(@@)(@@)(@@) $DIC_NIS$ الدبثاوي (@)(@@) بالكسر وسكون الموحدة ومثلثة إلى دبثا قرية بسواد بغداد وواسط.(@)(@@)(@@)(@@) $DIC_NIS$ الدبري (@)(@@) بفتح أوله والموحدة وراء إلى دبر قرية بصنعاء اليمن. 
ms64	(@)(@@)(@@)(@@) $DIC_NIS$ الدبزني (@)(@@) بالضم وسكون الموحدة وفتح الزاي ونون إلى دبزن ويقال دبزند قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الدبساني (@)(@@) بالكسر والسكون ومهملة إلى دبسان جد.(@)(@@)(@@)(@@) $DIC_NIS$ الدبوسي (@)(@@) بالفتح والضم ومهملة إلى دبوسية بلد بين بخارى وسمرقند ودبوسة جد.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الدبيثي (@)(@@) بالضم والفتح وسكون التحتية ومثلثة إلى دبيثاء قرية بواسط انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الدبيري (@)(@@) بالفتح والكسر وراء إلى دبير قرية بنيسابور وبالضم والفتح إلى دبير بطن من أسد.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الدبيقي (@)(@@) بالفتح وقاف إلى دبقا قرية بمصر قرب تنيس وإلى الدبيقية قرية بالرملة.(@)(@@)(@@)(@@) || باب الدال والثاء(@)PageV01P102(@)(@@)(@@)(@@) $DIC_NIS$ الدثيني (@)(@@) بالفتح وكسر المثلثة وتحتية ونون إلى الدثينة قرية باليمن.(@)(@@)(@@)(@@) || باب الدال والجيم(@)(@@)(@@)(@@) $DIC_NIS$ الدجاجي (@)(@@) إلى بيع الدجاج.(@)(@@)(@@)(@@) $DIC_NIS$ الدجاكني (@)(@@) بالضم وتخفيف الجيم إلى دجاكن قرية بنسف.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الدجرجاي (@)(@@) بالفتح وكسر الجيم الأولى إلى دجرجا بلد بصعيد مصر.(@)(@@)(@@)(@@) $DIC_NIS$ والدجوي (@)(@@) بالضم والسكون إلى دجوة قرية على شط النيل الشرقي على بحر رشيد انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الدجيلي (@)(@@) بالضم والفتح والسكون إلى دجيل نهر كبير بنواحي بغداد عليه قرى كثيرة.(@)(@@)(@@)(@@) || باب الدال والحاء(@)(@@)(@@)(@@) $DIC_NIS$ الدحروجي (@)(@@) بضم أوله والراء وسكون المهملة بنيهما آخره جيم إلى دحروج جد.(@)(@@)(@@)(@@) $DIC_NIS$ الدحني (@)(@@) بالفتح والسكون ونون إلى دحنة جد.(@)(@@)(@@)(@@) $DIC_NIS$ الدحيمي (@)(@@) مصغرا إلى دحيم القاضي.(@)(@@)(@@)(@@) || بال الدال والخاء(@)(@@)(@@)(@@) $DIC_NIS$ الدخاني (@)(@@) بالضم وتخفيف المعجمة إلى دخان جد.(@)(@@)(@@)(@@) $DIC_NIS$ الدخفندوني (@)(@@) بفتح أوله والفاء وسكون المعجمة والنون وضم الدال المهملة إلى دخفندون قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الدخمسيني (@)(@@) بالضم والباقي بلفظ العدد لقب به بكر بن محمد بن حمدان المروزي لأنه أمر لرجل بخمسين فاستزاده فزاده خمسين فسمي الدخمسيني.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الدخميسي (@)(@@) إلى دخميس قرية بالغربية بمصر انتهى.(@)(@@)(@@)(@@) || باب الدال والراء(@)(@@)(@@)(@@) $DIC_NIS$ الدرابجردي (@)(@@) تقدم بإثبات الألف بعد أوله وهما مستعملان.(@)(@@)(@@)(@@) $DIC_NIS$ الدراجي (@)(@@) بالتشديد وجيم إلى دارج جد.(@)(@@)(@@)(@@) $DIC_NIS$ الدربي (@)(@@) بالفتح والسكون وموحدة إلى درب موضع ببغداد وبنهاوند أيضا.(@)(@@)(@@)(@@) $DIC_NIS$ الدراوردي (@)(@@) بفتح أوله والراء والواو وسكون الراء الثانية ومهملة عبد العزيز كان أبوه من درابجرد فاستثقلوا فقالوا دراوردي وقيل هو من أندرابة.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الدربيشي (@)(@@) بالضم والسكون وكسر الباء الموحدة 
ms65	 وسكون التحتية الأولى وفتح الثانية المخففة بينهما معجمة قرية ببغداد. PageV01P103(@)(@@)(@@)(@@) $DIC_NIS$ والدربندي (@)(@@) إلى دربند وهو باب الأبواب انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الدربيقاني (@)(@@) بالضم والسكون وكسر الموحدة وتحتية وفتح القاف إلى دربيقان قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الدرداي (@)(@@) بالضم والسكون ومهملة إلى دردا قرية ببغداد قلت: ويقال درنا بالفوقية.(@)(@@)(@@)(@@) $DIC_NIS$ والدرزبيني (@)(@@) إلى الدرزبينية قرية بها انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الدرزدهي (@)(@@) بكسر أوله والراء وسكون الزاي وفتح المهملة إلى درزده قرية بنسف.(@)(@@)(@@)(@@) $DIC_NIS$ الدرزيوي (@)(@@) بالفتح وسكون الراء وكسر الزاي وتحتية ساكنة إلى درزيو قرية بسمرقند وقد يزاد في النسبة نون بعد الواو.(@)(@@)(@@)(@@) $DIC_NIS$ الدرزيجاني (@)(@@) بالفتح والسكون وكسر الزاي وتحتية ساكنة وجيم إلى درزيجان قرية ببغداد.(@)(@@)(@@)(@@) $DIC_NIS$ الدرستوي (@)(@@) بضم أوله والراء والفوقية وسكون المهملة إلى درستويه لقب.(@)(@@)(@@)(@@) $DIC_NIS$ الدرسيناني (@)(@@) بالفتح والسكون وكسر المهملة وتحتية ونونين بينهما ألف درسينان قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الدرعي (@)(@@) إلى درعة مدينة بالغرب.(@)(@@)(@@)(@@) $DIC_NIS$ والدرغاني (@)(@@) بالفتح والسكون ومعجمة إلى درغان مدينة بشاطئ جيحون انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الدرغمي (@)(@@) بفتح أوله والمعجمة وسكون الراء بينهما إلى درغم ناحية بسمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ الدرفسي (@)(@@) بالضم والفتح وسكون الفاء ومهملة إلى درفس جد.(@)(@@)(@@)(@@) $DIC_NIS$ الدرقزي (@)(@@) بالفتح والسكون وفتح القاف وزاي مخففة إلى دار القز محلة ببغداد قلت وكذا الدارقزي بفتح الراء والقاف وتشديد الزاي انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الدركي (@)(@@) بالضم والفتح إلى درك جد.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الدركزيني (@)(@@) بالفتح وسكون الراء وكسر الكاف والزاي إلى دركزين بلد بهمذان انتهى. PageV01P104(@)(@@)(@@)(@@) $DIC_NIS$ الدروازقي (@)(@@) بالفتح والسكون وفتح الواو والزاي وقاف إلى دروازق قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الدروقي (@)(@@) بفتحتين وقاف إلى دروقة بلد بالأندلس انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الدرهمي (@)(@@) بالكسر والسكون وفتح الهاء إلى درهم جد.(@)(@@)(@@)(@@) $DIC_NIS$ الدريجقي (@)(@@) بفتح أوله والجيم وكسر الراء وتحتية وقاف إلى دريجق قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الدريدي (@)(@@) بالضم والفتح وسكون التحتية ومهملة إلى ديريد جد الإمام المشهور.(@)(@@)(@@)(@@) || باب الدال والزاي(@)(@@)(@@)(@@) $DIC_NIS$ الدزقي (@)(@@) بالكسر وفتح الزاي وقاف إلى دزق حفص ودزق مسكين ودزق باران قرى بمرو والدرق قرية بطريق الشاش.(@)(@@)(@@)(@@) || باب الدال والسين(@)(@@)(@@)(@@) $DIC_NIS$ الدستجردي (@)(@@) بالفتح وسكون المهملة والراء وكسر الفوقية والجيم آخره مهملة إلى دستجرد اسم لعدة 
ms66	 قرى ثنتان بمرو وثنتان بطوس وأخرى ببلخ.(@)(@@)(@@)(@@) $DIC_NIS$ الدستواني (@)(@@) بالفتح والسكون وضم الفوقية إلى دستوا بلد بالأهواز وإلى ثياب تجلب منها.(@)(@@)(@@)(@@) $DIC_NIS$ الدسكري (@)(@@) بفتح أوله والكاف وسكون المهملة وراء إلى الدسكرة قرية من عمل بغداد بطريق خراسان وأخرى بنهر الملك.(@)(@@)(@@)(@@) || باب الدال والشين(@)(@@)(@@)(@@) $DIC_NIS$ الدشتكي (@)(@@) بفتح أوله والفوقية وسكون المعجمة إلى دشتك قرية بالري ومحلة باستراباذ.(@)(@@)(@@)(@@) $DIC_NIS$ الدشتي (@)(@@) بالفتح والسكون وفوقية إلى دشت قرية بأصبهان ودردشت محلة بها وباب دشت محلة بها أيضا ودشت جد.(@)(@@)(@@)(@@) || باب الدال والعين(@)(@@)(@@)(@@) $DIC_NIS$ الدعاء (@)(@@) إلى كثرة الدعاء.(@)(@@)(@@)(@@) || باب الدال والغين(@)(@@)(@@)(@@) $DIC_NIS$ الدغاني (@)(@@) بالضم والمعجمة إلى دغان رجل.(@)(@@)(@@)(@@) $DIC_NIS$ الدغشي (@)(@@) بالفتح وسكون المعجمة ومعجمة إلى دغش بطن من طيئ.(@)(@@)(@@)(@@) $DIC_NIS$ الدغولي (@)(@@) بالفتح والمعجمة إلى دغول رجل وإلى بيع الخبز الخشكار بسرخس.(@)(@@)(@@)(@@) || باب الدال والفاء(@)(@@)(@@)(@@) $DIC_NIS$ الدفني (@)(@@) بفتح أوله والفاء ونون إلى دفينة بلد بالشام قاله ابن السمعاني قال ابن الأثير لا أعرفه قلت: قال ياقوت موضع على خمس مراحل من مكة شرفها الله إلى البصرة انتهى.(@)(@@)(@@)(@@) || باب الدال والقاف(@)PageV01P105(@)(@@)(@@)(@@) $DIC_NIS$ الدقاق (@)(@@) إلى بيع الدقيق وكذلك الدقيقي.(@)(@@)(@@)(@@) $DIC_NIS$ الدقاني (@)(@@) بالفتح وتخفيف القاف ونون إلى دقانية قرية بدمشق.(@)(@@)(@@)(@@) $DIC_NIS$ الدقي (@)(@@) بالضم والتشديد إلى دق جد.(@)(@@)(@@)(@@) || باب الدال والكاف(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الدكالي (@)(@@) بالفتح والتشديد إلى دكالة بلد بالمغرب انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الدكي (@)(@@) بالفتح والتشديد إلى دكة جد.(@)(@@)(@@)(@@) || باب الدال واللام(@)(@@)(@@)(@@) $DIC_NIS$ الدلجي (@)(@@) بالضم وفتح اللام وجيم إلى دلجة جد قلت: وبالفتح والسكون إلى دلجة قرية بالصعيد انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الدلغاطاني (@)(@@) بفتح أوله والمعجمة والمهملة وسكون اللام إلى دلغاطان قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الدلفي (@)(@@) بالضم والفتح وفاء إلى دلف جد.(@)(@@)(@@)(@@) $DIC_NIS$ الدلوي (@)(@@) بالفتح والسكون إلى الدلو لقب جد وبالكسر وضم اللام المشددة إلى دلويه جد.(@)(@@)(@@)(@@) $DIC_NIS$ الدلهاثي (@)(@@) بالكسر والسكون آخره مثلثة إلى أبي الدلهاث جد.(@)(@@)(@@)(@@) $DIC_NIS$ الدليجاني (@)(@@) بالضم والكسر وتحتية وجيم إلى دليجان بلد بأصبهان.(@)(@@)(@@)(@@) $DIC_NIS$ الدليلي (@)(@@) بالضم وفتح اللام وسكون التحتية إلى دليل جد.(@)(@@)(@@)(@@) || باب الدال والميم(@)(@@)(@@)(@@) $DIC_NIS$ الدمائي (@)(@@) بالفتح إلى دما قرية بعمان.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الدماطي (@)(@@) إلى دماط قرية بمصر 
ms67	 الغربية. PageV01P106(@)(@@)(@@)(@@) $DIC_NIS$ والدماميني (@)(@@) بالفتح إلى دمامين بلد بصعيد مصر.(@)(@@)(@@)(@@) $DIC_NIS$ والدمسيسي (@)(@@) بالفتح والسكون ومهملتين بينهما تحتية إلى دمسيس قرية قرب سمنود انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الدمشقي (@)(@@) بالكسر وفتح الميم إلى دمشق المشهورة.(@)(@@)(@@)(@@) $DIC_NIS$ الدمكاني (@)(@@) بالفتح والسكون إلى دمكان جد.(@)(@@)(@@)(@@) $DIC_NIS$ الدممي (@)(@@) بالكسر والفتح وتشديد الميم الثانية إلى دمما قرية ببغداد.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الدمنهوري (@)(@@) بفتحتين إلى دمنهور بلد قرب الإسكندرية انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الدمياطي (@)(@@) بالكسر والسكون وتخفيف التحتية إلى دمياط بلد مشهورة بمصر قلت ضبطها بعضهم بالذال المعجمة انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الدميكي (@)(@@) مصغرا إلى أبي الدميك جد.(@)(@@)(@@)(@@) $DIC_NIS$ الدميري (@)(@@) بالفتح والكسر إلى دميرة قرية بمصر.(@)(@@)(@@)(@@) || باب الدال والنون(@)(@@)(@@)(@@) $DIC_NIS$ الدنباوندي (@)(@@) بالضم وسكون النونين وتخفيف الباء الموحدة وفتح الواو آخره مهملة إلى دنباوند ناحية بالري.(@)(@@)(@@)(@@) $DIC_NIS$ الدندانقاني (@)(@@) بفتح المهملتين والقاف وسكون النون الأولى إلى الدندانقان بلد بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الدنداني (@)(@@) مثله إلى ...(@)(@@)(@@)(@@) $DIC_NIS$ الدنقشي (@)(@@) بفتح أوله والنون وسكون القاف ومعجمة إلى دنقش جد.(@)(@@)(@@)(@@) $DIC_NIS$ الدنوقي (@)(@@) بالفتح والضم وقاف إلى دنوقا جد.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الدنيسري (@)(@@) بالضم إلى دنيسر بلد قرب ماردين انتهى.(@)(@@)(@@)(@@) || باب الدال والواو(@)PageV01P107(@)(@@)(@@)(@@) $DIC_NIS$ الدؤادي (@)(@@) بالضم وفتح الهمزة إلى أبي دؤاد جد.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الدوباني (@)(@@) بالضم إلى دوبان قرية بالشام انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الدوداني (@)(@@) إلى دودان بالضم وفتح المهملة ابن أسد بن خزيمة بطن مشهور.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الدوربستي (@)(@@) بالضم إلى دوربست قرية بالري انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الدورقي (@)(@@) بفتح أوله وقاف إلى دورق بدل بخوزستان وإلى القلانس الدورقية قلت: وإلى دورقة بلد بالأندلس انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الدوري (@)(@@) بالضم والراء إلى الدور محلة ببغداد منها المقرئ وإلى دور سر من رأى وإلى بيع الدور قلت: وإلى الدور محلة بنيسابور أيضا.(@)(@@)(@@)(@@) $DIC_NIS$ والدوراني (@)(@@) بالتشديد إلى دوران قرية بواسط انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الدوسي (@)(@@) بالفتح والسكون ومهملة إلى دوس بطن من الأزد.(@)(@@)(@@)(@@) $DIC_NIS$ الدوشابي (@)(@@) بالضم ومعجمة وباء موحدة إلى دوشاب وهو الدبس.(@)(@@)(@@)(@@) $DIC_NIS$ الدوغي (@)(@@) بالضم والمعجمة إلى الدوغ وهو اللبن الحامض.(@)(@@)(@@)(@@) $DIC_NIS$ الدؤلي (@)(@@) بالضم وفتح الهمزة إلى أبي الأسود ورهطه وهو إلى الدئل بن كنانة بكسر الهمزة.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الدولعي (@)(@@) بمهملة إلى الدولعية قرية بالموصل 
ms68	 انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الدوماني (@)(@@) بالضم إلى دومان بطن من همذان.(@)(@@)(@@)(@@) $DIC_NIS$ الدومي (@)(@@) بالضم إلى دومة الجندل موضع فاصل بين الشام والعراق قلت: وإلى دومة قرية بغوطة دمشق غيرها ذكرها ياقوت انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الدونقي (@)(@@) بالضم وفتح النون وقاف إلى دونق قرية بنهاوند.(@)(@@)(@@)(@@) $DIC_NIS$ الدوني (@)(@@) بالضم إلى دونة قرية بنهاوند أيضا ودون قرية بدينور. PageV01P108(@)(@@)(@@)(@@) $DIC_NIS$ الدولابي (@)(@@) صوابه بفتح أوله والناس يضمونه إلى عمل الدولاب ودولاب قرية بالري.(@)(@@)(@@)(@@) $DIC_NIS$ الدويري (@)(@@) بالفتح والكسر وتحتية وراء إلى الدويرة قرية بنسابور قلت: ضم ياقوت أولها انتهى.(@)(@@) وبالضم والفتح إلى الدويرة موضع ببغداد.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الدويسي (@)(@@) مصغرا إلى الدويس قرية ببيهق انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الدويني (@)(@@) بالضم والكسر وتحتية ونون إلى دوين مدينة بأذربيجان قلت فتح ياقوت أولها ولفظها دوين انتهى.(@)(@@)(@@)(@@) || باب الدال والهاء(@)(@@)(@@)(@@) $DIC_NIS$ الدهاسي (@)(@@) بالفتح ومهملة إلى دهاس.(@)(@@)(@@)(@@) $DIC_NIS$ الدهان (@)(@@) إلى بيع الدهن.(@)(@@)(@@)(@@) $DIC_NIS$ الدهجي (@)(@@) بالكسر والفتح وجيم إلى دهجية قرية بأصبهان.(@)(@@)(@@)(@@) $DIC_NIS$ الدهراني (@)(@@) بالفتح والسكون وراء إلى دهران قرية باليمن.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الدهروطي (@)(@@) بالفتح إلى دهروط بلد قرب البهنسا انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الدهستاني (@)(@@) بكسرتين وسكون المهملة وفوقية إلى دهستان مدينة عند مازندران.(@)(@@)(@@)(@@) $DIC_NIS$ الدهشوري (@)(@@) بالكسر والسكون وضم المعجمة وراء إلى دهشور قرية بجيزة مصر.(@)(@@)(@@)(@@) $DIC_NIS$ الدهكي (@)(@@) بفتحتين إلى دهك قرية بالري.(@)(@@)(@@)(@@) $DIC_NIS$ الدهماني (@)(@@) بالضم والسكون إلى دهمان بطن من أشجع ومن الأزد وغيرهما.(@)(@@)(@@)(@@) $DIC_NIS$ الدهني (@)(@@) مثله إلى دهن بطن من بجيلة وبالكسر إلى دهنة بطن من غافق.(@)(@@)(@@)(@@) $DIC_NIS$ الدهيري (@)(@@) مكبرا إلى دهير بطن من بهراء.(@)(@@)(@@)(@@) $DIC_NIS$ الدهيي (@)(@@) بالفتح والكسر إلى دهي بطن من مذحج.(@)(@@)(@@)(@@) || باب الدال واللام ألف(@)(@@)(@@)(@@) $DIC_NIS$ الدلاصي (@)(@@) بالفتح والتخفيف ومهملة إلى دلاص قرية بصعيد مصر. PageV01P109(@)(@@)(@@)(@@) $DIC_NIS$ الدلاني (@)(@@) بالكسر والتشديد ونون إلى دلان جد.(@)(@@)(@@)(@@) $DIC_NIS$ الدلائي (@)(@@) بالفتح إلى دلاية بلد بالأندلس.(@)(@@)(@@)(@@) || باب الدال والياء(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الدياربكري (@)(@@) إلى ديار بكر بلاد وساعة من بلاد الجبل إلى دجلة تنسب إلى بكر بن وائل انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الديباجي (@)(@@) بالكسر وتحتية وباء موحدة آخره جيم إلى صنعة الديباج الحرير وإلى الديباج من ولد عثمان بن عفان.(@)(@@)(@@)(@@) $DIC_NIS$ الديبلي (@)(@@) بالفتح وسكون 
ms69	 التحتية وضم الموحدة ولام إلى ديبل مدينة قريبة من السند.(@)(@@)(@@)(@@) $DIC_NIS$ الديرعاقولي (@)(@@) بالفتح والسكون وراء ومهملة وقاف إلى دير العاقول قرية ببغداد.(@)(@@)(@@)(@@) $DIC_NIS$ الديري (@)(@@) إلى الدير قرية بالبصرة قلت: وإلى دير البلوط قرية بالرملة.(@)(@@)(@@)(@@) $DIC_NIS$ والديريني (@)(@@) بالسكر إلى ديرين بلد بالديار المصرية انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الديزكي (@)(@@) بفتح أوله والزاي إلى ديزك قرية بسمرقند وديزك جد.(@)(@@)(@@)(@@) $DIC_NIS$ الديزيلي (@)(@@) بالفتح وكسر الزاي بين تحتيتين ساكنتين ولام إلى ديزيل جد.(@)(@@)(@@)(@@) $DIC_NIS$ الديلماني (@)(@@) بفتح أوله واللام إلى ديلمان قرية بأصبهان.(@)(@@)(@@)(@@) $DIC_NIS$ الديلمي (@)(@@) بفتح أوله واللام إلى الديلم بلاد معروفة.(@)(@@)(@@)(@@) $DIC_NIS$ الدئلي (@)(@@) بالكسر كالدؤلي.(@)(@@)(@@)(@@) $DIC_NIS$ الديماسي (@)(@@) بالكسر إلى الديماس الحمام وجد قلت: وإلى ديماس موضع عسقلان عال انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الديمسي (@)(@@) بالكسر وفتح الميم ومهملة إلى الديمس قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الديناري (@)(@@) بالى الدينار المعروف ودينار جد وبطن من الأنصار ودرب دينار ببغداد وديناراباذ قرية قرب أسداباذ قلت: وقد ينسب إليه بكماله وسكة دينار بالري.(@)(@@)(@@)(@@) $DIC_NIS$ والدينباري (@)(@@) إلى دينبار قرية بمرو انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الدينمزداني (@)(@@) بالكسر وسكون الياء والزاي وفتح النون والميم والدال المهملة إلى دينه مزدان قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الدينوري (@)(@@) بفتح أوله والنون وراء إلى الدينور من بلاد الجبل. PageV01P110(@)(@@)(@@)(@@) $DIC_NIS$ الدينوي (@)(@@) بالفتح وضم النون إلى دينو جد.(@)(@@)(@@)(@@) $DIC_NIS$ الديواني (@)(@@) بالكسر إلى ديوان سكة بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الديوانجي (@)(@@) إلى ديوانجة قرية بهراة انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الديوري (@)(@@) بالكسر والسكون وفتح الواو وراء إلى ديور قرية بنيسابور.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الديوقاني (@)(@@) إلى ديوقان قرية بهراة انتهى.(@)(@@)(@@)(@@) | حرف الذال المعجمة(@)(@@)(@@)(@@) || باب الذال والألف(@)(@@)(@@)(@@) $DIC_NIS$ الذارع والذراع: إلى ذرع الثياب والأرض.(@)(@@)(@@)(@@) || باب الذال والباء(@)(@@)(@@)(@@) $DIC_NIS$ الذبحاني (@)(@@) بالضم وسكون الموحدة ومهملة إلى ذبحان بطن من رعين.(@)(@@)(@@)(@@) $DIC_NIS$ الذبياني (@)(@@) بالضم وقيل بالكسر والسكون وتخفيف التحتية إلى ذبان اسم لعدة بطون.(@)(@@)(@@)(@@) || باب الذال والخاء(@)(@@)(@@)(@@) $DIC_NIS$ الذخكتي (@)(@@) بفتح أوله والكاف وسكون المعجمة وفوقية إلى ذخكت قرية بالروذبار.(@)(@@)(@@)(@@) $DIC_NIS$ الذخيري (@)(@@) بالضم والفتح وتحتية وساكنة وراء إلى ذخير بطن من الصدف.(@)(@@)(@@)(@@) $DIC_NIS$ الذخينوي (@)(@@) بفتح أوله والنون وكسر المعجمة ثم تحتية إلى ذخينوى قرية بسمرقند.(@)(@@)(@@)(@@) || باب الذال والراء(@)(@@)(@@)(@@) $DIC_NIS$ الذرعيني (@)(@@) بفتح أوله 
ms70	 والمهملة وسكون الراء والتحتية إلى ذرعين قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الذروي (@)(@@) إلى ذروة بلد باليمن انتهى.(@)(@@)(@@)(@@) || باب الذال والكاف(@)(@@)(@@)(@@) $DIC_NIS$ الذكواني (@)(@@) بالفتح والسكون إلى ذكوان جد وبطن من سليم.(@)(@@)(@@)(@@) || باب الذال والميم(@)(@@)(@@)(@@) $DIC_NIS$ الذماري (@)(@@) بالكسر والتخفيف وراء إلى ذمار قرية باليمن.(@)(@@)(@@)(@@) $DIC_NIS$ الذمي (@)(@@) بالفتح والتشديد إلى ذما قرية بسمرقند.(@)(@@)(@@)(@@) || باب الذال والنون(@)(@@)(@@)(@@) $DIC_NIS$ الذنبي (@)(@@) بفتح الذال والنون وموحدة إلى.. ..(@)(@@)(@@)(@@) || باب الذال والواو(@)(@@)(@@)(@@) $DIC_NIS$ الذويدي (@)(@@) بالضم والفتح وسكون التحتية PageV01P111 ومهملة إلى ذويد بن سعيد بن عدي بن عثمان بن عمرو بن أد.(@)(@@)(@@)(@@) || باب الذال والهاء(@)(@@)(@@)(@@) $DIC_NIS$ الذهباني (@)(@@) بالضم والسكون وباء موحدة إلى ذهبان بطن من حضرموت.(@)(@@)(@@)(@@) $DIC_NIS$ الذهبي (@)(@@) إلى سبك الذهب وتخليصه.(@)(@@)(@@)(@@) $DIC_NIS$ الذهلي (@)(@@) بالضم والسكون إلى ذهل بن ثعلبة وذهل بن شيبان وذهل بن معاوية بطن من كندة وذهل بن الحارث بطن من جعفي.(@)(@@)(@@)(@@) || باب الذال والياء(@)(@@)(@@)(@@) $DIC_NIS$ الذيالي (@)(@@) بالفتح والتشديد إلى الذيال جد.(@)(@@)(@@)(@@) $DIC_NIS$ الذيبي (@)(@@) بالكسر إلى ذيب بن عمرو بطن من الأزد.(@)(@@)(@@)(@@) $DIC_NIS$ الذيبدواني (@)(@@) بالكسر وفتح الموحدة والواو وسكون المهملة إلى ذيبدوان قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الذيموني (@)(@@) بالفتح والسكون والضم إلى ذيمون قرية قرب بخارى.(@)(@@)(@@)(@@) | حرف الراء(@)(@@)(@@)(@@) || باب الراء والألف(@)(@@)(@@)(@@) $DIC_NIS$ الراجياني (@)(@@) بكسر الجيم وتخفيف التحتية إلى الراجيان جد.(@)(@@)(@@)(@@) $DIC_NIS$ الراذاني (@)(@@) بالمعجمة إلى رازان قرية ببغداد.(@)(@@)(@@)(@@) $DIC_NIS$ الراذكاني (@)(@@) بفتح الذال المعجمة إلى الراذكان بلد بنواحي طوس.(@)(@@)(@@)(@@) $DIC_NIS$ الراراني (@)(@@) براءين مهملتين إلى راران قرية بأصبهان.(@)(@@)(@@)(@@) $DIC_NIS$ الرازاني (@)(@@) بزاي إلى رازان محلة ببروجرد.(@)(@@)(@@)(@@) $DIC_NIS$ الرازي (@)(@@) بالزاي إلى الري مدينة من بلاد الديلم.(@)(@@)(@@)(@@) $DIC_NIS$ الراسبي (@)(@@) بكسر المهملة وباء موحدة إلى راسب بطن من الأزد.(@)(@@)(@@)(@@) $DIC_NIS$ الراسي (@)(@@) إلى رأس عين بلد بالجزيرة ويقال أيضا الرسعني.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الراشتيناني (@)(@@) إلى راشتينان بكسر المعجمة والفوقية وتحتية ونونين بينهما ألف قرية بأصبهان انتهى. PageV01P112(@)(@@)(@@)(@@) $DIC_NIS$ الراشدي (@)(@@) إلى الراشدية قرية ببغداد.(@)(@@)(@@)(@@) $DIC_NIS$ الراغسرسني (@)(@@) بفتح الراء الأولى والمعجمة والمهملتين ونون إلى الراغسرسنة قرية بنسف.(@)(@@)(@@)(@@) $DIC_NIS$ الراغني (@)(@@) بفتح المعجمة ونون إلى راغن قرية بصعيد مصر.(@)(@@)(@@)(@@) $DIC_NIS$ الرافعي (@)(@@) إلى رافع وأبي رافع قلت: الرافعي إمام الشافعية إلى رافع بن خديج وقال 
ms71	 النووي رحمه الله إلى رافعان قرية بقزوين وأنكروه انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الرافقي (@)(@@) بالفاء المكسورة والقاف إلى رافقة بلد على الفرات يقال لها الآن الرقة.(@)(@@)(@@)(@@) $DIC_NIS$ الرامراني (@)(@@) بفتح الراءين والميم إلى رامران قرية بنسا.(@)(@@)(@@)(@@) $DIC_NIS$ الرامشي (@)(@@) بضم الميم ومعجمة إلى رامش جد وقرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الرامشيني (@)(@@) إلى رامشين قرية بهمذان انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الرامكي (@)(@@) بفتح الميم إلى رامك جد.(@)(@@)(@@)(@@) $DIC_NIS$ الرامني (@)(@@) بفتحها إلى رامن قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الرامهرمزي (@)(@@) بفتح الميم الأولى وضم الهاء والثاني وسكون الراء بينهما وزاي إلى رامهرمز كورة بالأهواز.(@)(@@)(@@)(@@) $DIC_NIS$ الراميثني (@)(@@) بكسر الميم وتحتية ومثلثة مفتوحة ونون إلى راميثنة قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الرامي (@)(@@) إلى رمي النشاب.(@)(@@)(@@)(@@) $DIC_NIS$ الراني (@)(@@) بالنون قلت: إلى الران مدينة بين مراغة وزنجار انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الراوساني (@)(@@) بفتح الواو والمهملة ونون إلى راوسان قرية بنيسابور. PageV01P113(@)(@@)(@@)(@@) $DIC_NIS$ الراوندي (@)(@@) بفتح الواو وسكون النون ومهملة إلى راوند قرية بقاسان.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الراونسري (@)(@@) إلى راونسر قرية بأرغيان انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الراونيري (@)(@@) بفتح الواو وكسر النون وتحتية وراء إلى راونير قرية بأرغيان.(@)(@@)(@@)(@@) $DIC_NIS$ الراوني (@)(@@) بفتح الواو ونون إلى راون مدينة من طخارستان بلخ.(@)(@@)(@@)(@@) $DIC_NIS$ الراهبي (@)(@@) بكسر الهاء وموحدة إلى راهب جد.(@)(@@)(@@)(@@) $DIC_NIS$ الراهوي (@)(@@) بضم الهاء إلى راهويه جد.(@)(@@)(@@)(@@) $DIC_NIS$ الرالاني (@)(@@) إلى رالان بطن من مازن.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الراياني (@)(@@) إلى رايان قرية بهمذان انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الرائشي (@)(@@) بكسر التحتية ومعجمة إلى بني رائش بطن من كندة.(@)(@@)(@@)(@@) $DIC_NIS$ الرائضي (@)(@@) بكسر التحتية ومعجمة إلى رياضة الخيل وتعليمها.(@)(@@)(@@)(@@) || باب الراء والباء(@)(@@)(@@)(@@) $DIC_NIS$ الربابي (@)(@@) بالكسر وموحدتين إلى تيم الرباب قبيلة من مضر.(@)(@@)(@@)(@@) $DIC_NIS$ الرباحي (@)(@@) بفتحتين ومهملة إلى قلعة رباح بالأندلس.(@)(@@)(@@)(@@) $DIC_NIS$ الرباطي (@)(@@) بالكسر إلى موضع الرباط وهو الثغر.(@)(@@)(@@)(@@) $DIC_NIS$ الربالي (@)(@@) بالفتح ولام إلى ربال جد.(@)(@@)(@@)(@@) $DIC_NIS$ الربذي (@)(@@) بفتحتين ومعجمة إلى الربذة قرية بالمدينة.(@)(@@)(@@)(@@) $DIC_NIS$ الربضي (@)(@@) بفتحتين ومعجمة إلى الربض محلة بقرطبة قلت: وبشيراز وبمرو انتهى. PageV01P114(@)(@@)(@@)(@@) $DIC_NIS$ الربعي (@)(@@) بفتحتين ومهملة إلى ربيعة بن نزار وربعة الأزد وربيعة الجوع من تميم وربعة بن رشدان بطن من جهينة وربيعة بن حصن بطن من كلب وربيع بطن من طيء.(@)(@@)(@@)(@@) $DIC_NIS$ الربنجني (@)(@@) بالفتح والكسر 
ms72	 وسكون النون الأولى وفتح الجيم إلى ربنجن بلد بسغد سمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ الربيعي (@)(@@) إلى الربيع جد.(@)(@@)(@@)(@@) || باب الراء والجيم(@)(@@)(@@)(@@) $DIC_NIS$ الرجالي (@)(@@) إلى أبي الرجال بلفظ جمع رجل كنية جد.(@)(@@)(@@)(@@) $DIC_NIS$ الرجاني (@)(@@) بفتحتين ونون قلت: وتشديد الجيم إلى رجان قال ياقوت رحمه الله أظنها أرجان التي بين الأهواز وفارس انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الرجائي (@)(@@) بفتحتين إلى رجا جد وقرية بسرخس.(@)(@@)(@@)(@@) $DIC_NIS$ الرجوعي (@)(@@) بضمتين إلى رجوعة لقب جد.(@)(@@)(@@)(@@) || باب الراء والحاء(@)(@@)(@@)(@@) $DIC_NIS$ الرحال (@)(@@) إلى الرحلة والرحل.(@)(@@)(@@)(@@) $DIC_NIS$ الرحائي (@)(@@) إلى الرحا المعروفة قلت: وإلى رحا موضع بسجستان انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الرحبي (@)(@@) بسكون المهملة إلى رحبة بن مالك بن طوق بلد على الفرات قلت: ورحبة قرية بدمشق وبضم الراء إلى رحبة بلد على مرحلة من الكوفة انتهى وبفتحتين إلى رحبة بطن من حمير.(@)(@@)(@@)(@@) || باب الراء والخاء(@)(@@)(@@)(@@) $DIC_NIS$ الرخاني (@)(@@) بفتح الراء والمعجمة إلى رخان قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الرخجي (@)(@@) بالضم وتشديد المعجمة وتشديد المعجمة المفتوحة وجيم إلى الرخجية قرية ببغداد والرخج بلاد بسجستان.(@)(@@)(@@)(@@) $DIC_NIS$ الرخشبوذي (@)(@@) بضم أوله والباء الموحدة وفتح الشين المعجمة وآخره ذال معجمة إلى رخشبوذ قرية بترمذ. PageV01P115(@)(@@)(@@)(@@) $DIC_NIS$ الرخشي (@)(@@) بالفتح والسكون إلى خان رخش بنيسابور.(@)(@@)(@@)(@@) $DIC_NIS$ الرخينوني (@)(@@) بالفتح والكسر وتحتية ونون إلى رخينوى قرية بسمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ الرخي (@)(@@) بالضم والتشديد إلى الرخ ناحية بنيسابور.(@)(@@)(@@)(@@) || باب الراء والدال(@)(@@)(@@)(@@) $DIC_NIS$ الردادي (@)(@@) بالفتح والتشديد إلى الرداد جد.(@)(@@)(@@)(@@) $DIC_NIS$ الردماني (@)(@@) بالفتح والسكون إلى ردمان بطن من رعين.(@)(@@)(@@)(@@) || باب الراء والذال(@)(@@)(@@)(@@) $DIC_NIS$ الرذاني (@)(@@) بفتح الراء والمعجمة إلى رذان قرية بنسا.(@)(@@)(@@)(@@) || باب الراء والزاي(@)(@@)(@@)(@@) $DIC_NIS$ الرزاباذي (@)(@@) بفتح الراء والزاي والموحدة آخره معجمة إلى رزاباذ سكة بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الرزاز والرزي:(@)(@@) إلى الرز المعروف.(@)(@@)(@@)(@@) $DIC_NIS$ الرزامي (@)(@@) بكسر الراء وفتح الزاي إلى حوض رزام محلة بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الرزجاهي (@)(@@) بفتح أوله والجيم وسكون الزاي إلى رزجاه قرية ببسطام.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الرزماباذي (@)(@@) إلى رزماباذ قرية بأصبهان انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الرزمازي (@)(@@) بالفتح وسكون الزاي الأولى إلى رزماز قرية بسمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ الرزماناخي (@)(@@) بالفتح وسكون الزاي ونون بين الألفين آخره معجمة إلى رزماناخ قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الرزيقي (@)(@@) بالفتح وكسر الزاي آخره قاف إلى رزيق 
ms73	 محلة بمرو.(@)(@@)(@@)(@@) || باب الراء والسين(@)(@@)(@@)(@@) $DIC_NIS$ الرستغفري (@)(@@) بفتح الراء والفوقية والفاء وسكون المهملة والغين المعجمة آخره راء إلى رستغفر قرية باشتيخن.(@)(@@)(@@)(@@) $DIC_NIS$ الرستغفني (@)(@@) بضم الراء والفوقية وسكون المهملة والغين المعجمة آخره نون إلى رستغفن قرية بسمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ الرستمي (@)(@@) بضم الراء الفوقية إلى رستم جد.(@)(@@)(@@)(@@) $DIC_NIS$ الرستي (@)(@@) مثله بلا ميم إلى رستة جد.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الرستني (@)(@@) بالفتح آخره نون إلى رستن بلد بين حماة وحمص انتهى. PageV01P116(@)(@@)(@@)(@@) $DIC_NIS$ الرسعني (@)(@@) بفتح الراء والعين وسكون المهملة إلى رأس عين مدينة بالجزيرة وقرية بفلسطين.(@)(@@)(@@)(@@) $DIC_NIS$ الرسولي (@)(@@) إلى جد كان رسولا للملوك.(@)(@@)(@@)(@@) $DIC_NIS$ الرسي (@)(@@) بالفتح والتشديد إلى بطن من العلوية.(@)(@@)(@@)(@@) || باب الراء والشين(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الرشاطي (@)(@@) إلى رشاطة بلد بالغرب.(@)(@@)(@@)(@@) $DIC_NIS$ والرشتاني (@)(@@) بالكسر وسكون المعجمة وفوقية إلى رشتان قرية بمرغينان انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الرشيدي (@)(@@) إلى الرشيد الخليفة ورشيد بلد بمصر على ساحل البحر وبضم الراء وفتح المعجمة إلى رشيد رجل من الخوارج رأس الرشيدية.(@)(@@)(@@)(@@) $DIC_NIS$ الرشيقي (@)(@@) بالفتح وكسر المعجمة وقاف إلى رشيق رجل.(@)(@@)(@@)(@@) || باب الراء والصاد(@)(@@)(@@)(@@) $DIC_NIS$ الرصافي (@)(@@) بالضم وتخفيف المهملة وفاء إلى الرصافة مدينة بالشام وبالأندلس أيضا ومحلة ببغداد وقرية بالبصرة وبواسط أيضا.(@)(@@)(@@)(@@) || باب الراء والضاد(@)(@@)(@@)(@@) $DIC_NIS$ الرضائي (@)(@@) بالضم وتخفيف المعجمة إلى رضا بطن من مراد.(@)(@@)(@@)(@@) $DIC_NIS$ الرضراضي (@)(@@) بفتح الراءين وسكون المعجمة الأولى إلى الرضراضة موضع بسمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ الرضوي (@)(@@) بفتحتين إلى الرضي العلوي.(@)(@@)(@@)(@@) || باب الراء والعين(@)(@@)(@@)(@@) $DIC_NIS$ الرعلي (@)(@@) بالكسر وسكون المهملة إلى رعل حي من سليم.(@)(@@)(@@)(@@) $DIC_NIS$ الرعيلي (@)(@@) مصغرة إلى رعيل بطن من الصدف.(@)(@@)(@@)(@@) $DIC_NIS$ الرعيني (@)(@@) مثله بنون إلى ذي رعين من أقيال اليمن.(@)(@@)(@@)(@@) || باب الراء والغين(@)(@@)(@@)(@@) $DIC_NIS$ الرغباني (@)(@@) بالضم وسكون الغين المعجمة وباء موحدة إلى رغبان جد.(@)(@@)(@@)(@@) || باب الراء والفاء(@)(@@)(@@)(@@) $DIC_NIS$ الرفاء (@)(@@) إلى رفو الثياب.(@)(@@)(@@)(@@) $DIC_NIS$ الرفاعي (@)(@@) بالكسر وتخفيف الفاء إلى رفاعة جد وبطن من جهينة.(@)(@@)(@@)(@@) $DIC_NIS$ الرفني (@)(@@) بفتحتين ونون إلى رفينة بلد بأطرابلس الشام.(@)(@@)(@@)(@@) $DIC_NIS$ الرفوني (@)(@@) بضمتين ونون إلى رفون قرية بسمرقند.(@)(@@)(@@)(@@) || باب الراء والقاف(@)(@@)(@@)(@@) $DIC_NIS$ الرقاشي (@)(@@) بالفتح وتخفيف القاف ومعجمة إلى رقاش بنت قيس بن ثعلبة. PageV01P117(@)(@@)(@@)(@@) $DIC_NIS$ الرقاعي (@)(@@) بالكسر وقاف إلى الرقاع بطن 
ms74	 من جشم وإلى كتابة الرقاع وإلى الرقاع جد.(@)(@@)(@@)(@@) $DIC_NIS$ الرقيقي (@)(@@) إلى بيع الرقيق وشارع دار الرقيق محلة ببغداد.(@)(@@)(@@)(@@) $DIC_NIS$ الرقي (@)(@@) بالفتح والتشديد إلى الرقة مدينة على الفرات.(@)(@@)(@@)(@@) || باب الراء والكاف (@)(@@)(@@)(@@) $DIC_NIS$ قلت: الركاني(@)(@@) بالنون إلى ركانة مدينة بالأندلس.(@)(@@)(@@)(@@) $DIC_NIS$ والركبي (@)(@@) إلى ركبة بلفظ العضو بين مكة والطائف.(@)(@@)(@@)(@@) $DIC_NIS$ والركلي (@)(@@) إلى ركلة بلد من عمل سرقسطة انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الركندي (@)(@@) بضمتين وسكون النون ومهملة إلى ركندة قرية بسمرقند.(@)(@@)(@@)(@@) || باب الراء والميم(@)(@@)(@@)(@@) $DIC_NIS$ الرماح (@)(@@) إلى الرمح.(@)(@@)(@@)(@@) $DIC_NIS$ الرماحسي (@)(@@) بالضم والتخفيف وكسر المهملة ومهملة إلى رماحس جد.(@)(@@)(@@)(@@) $DIC_NIS$ الرماحي (@)(@@) بالفتح والتشديد إلى الرماح بطن من كلب.(@)(@@)(@@)(@@) $DIC_NIS$ الرمادي (@)(@@) بالفتح والتخفيف ومهملة إلى رماد قرية باليمن وبفلسطين وبالغرب أيضا.(@)(@@)(@@)(@@) $DIC_NIS$ الرماني (@)(@@) بالفتح والتخفيف إلى رمان بطن من مذحج ومن السكون وبالضم والتشديد إلى الرمان المعروف وقصر الرمان بواسط.(@)(@@)(@@)(@@) $DIC_NIS$ الرمجاري (@)(@@) بفتح الراء والجيم وسكون الميم آخره راء إلى رمجار محلة بنيسابور.(@)(@@)(@@)(@@) $DIC_NIS$ الرمقي (@)(@@) بفتحتين وقاف.(@)(@@)(@@)(@@) $DIC_NIS$ الرملي (@)(@@) بالفتح والسكون ولام إلى الرملة مدينة بفلسطين ومحلة بسرخس ورملة جدة.(@)(@@)(@@)(@@) $DIC_NIS$ الرميلي (@)(@@) مصغرا إلى الرميلة بالأرض المقدسة.(@)(@@)(@@)(@@) || باب الراء والنون(@)PageV01P118(@)(@@)(@@)(@@) $DIC_NIS$ الرناني (@)(@@) بالضم وتخفيف النون إلى رنان قرية بأصبهان.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الرندي (@)(@@) بالضم والسكون ومهملة إلى رندة حصن بالأندلس انتهى.(@)(@@)(@@)(@@) || باب الراء والواو(@)(@@)(@@)(@@) $DIC_NIS$ الرواجني (@)(@@) بفتح الراء والواو وكسر الجيم ونون إلى الرواجن بطن.(@)(@@)(@@)(@@) $DIC_NIS$ الروادي (@)(@@) بالفتح والتشديد ومهملة إلى رواد رجل.(@)(@@)(@@)(@@) $DIC_NIS$ الرواسي (@)(@@) بالفتح والتشديد إلى بيع الرؤوس كالرواس وبالضم والتخفيف إلى رواس بطن من قيس عيلان ومن همذان.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الروبي (@)(@@) بالضم إلى روب موضع بنواحي بلخ.(@)(@@)(@@)(@@) $DIC_NIS$ والروبائي (@)(@@) إلى روبا قرية ببغداد انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الروبانجاهي (@)(@@) بالضم وفتح الموحدة وجيم إلى الروبج لقب جد.(@)(@@)(@@)(@@) $DIC_NIS$ الروحي (@)(@@) بالفتح والسكون ومهملة إلى روح بن القاسم قلتك وإلى روحة قرية بقيروان.(@)(@@)(@@)(@@) $DIC_NIS$ والروحاي (@)(@@) إلى الروحا من قرة الرحبة انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الروذباري (@)(@@) بالضم وسكون الواو والمعجمة وفتح الموحدة آخره راء إلى روذبار بلد عند طوس. PageV01P119(@)(@@)(@@)(@@) $DIC_NIS$ الروذراوري (@)(@@) بالضم وسكون الواو والمعجمة وفتح الراء والواو ثم راء إلى روذراور بلد 
ms75	 بهمذان.(@)(@@)(@@)(@@) $DIC_NIS$ الروذدشتي (@)(@@) بالضم وفتح المعجمة والمهملة وسكون المعجمة وفوقية إلى روذدشت قرية بأصبهان.(@)(@@)(@@)(@@) $DIC_NIS$ الروذفغكدي (@)(@@) بالضم وفتح المعجمة والفاء والكاف وسكون الغين المعجمة بينهما آخره مهملة إلى روذفغكدا قرية بسمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ الروذكي (@)(@@) بالضم وفتح المعجمة إلى روذك ناحية بسمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ الروذي (@)(@@) بالضم ومعجمة إلى روذة محلة بالري.(@)(@@)(@@)(@@) $DIC_NIS$ الروزوي (@)(@@) بضم الراء والزاي إلى روزويه جد.(@)(@@)(@@)(@@) $DIC_NIS$ الروزجاري (@)(@@) بالضم وسكون الواو والزاي وجيم وراء إلى روزجار وهو الذي يعمل بالنهار.(@)(@@)(@@)(@@) $DIC_NIS$ الروقي (@)(@@) بالفتح والسكون وقاف إلى روق جد.(@)(@@)(@@)(@@) $DIC_NIS$ الرومي (@)(@@) بالضم إلى بلاد الروم.(@)(@@)(@@)(@@) $DIC_NIS$ الروياني (@)(@@) بالضم وسكون الواو وتخفيف التحتية إلى رويان مدينة بنواحي طبرستان.(@)(@@)(@@)(@@) $DIC_NIS$ الرويدشتي (@)(@@) بالضم وفتح الواو والمهملة وسكون التحتية والشين المعجمة وفوقية إلى رويدشت قرية بأصبهان.(@)(@@)(@@)(@@) $DIC_NIS$ الرويطي (@)(@@) مصغرا إلى رويط جد.(@)(@@)(@@)(@@) || باب الراء والهاء(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الرهاطي (@)(@@) بالضم إلى رهاط قرية قرب مكة على طريق المدينة انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الرهامي (@)(@@) بالضم إلى رهام جد.(@)(@@)(@@)(@@) $DIC_NIS$ الرهاوي (@)(@@) بالفتح إلى رها بن يزيد بطن من مذحج وبالضم إلى الرها مدينة بالجزيرة.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الرهني (@)(@@) بالضم والسكون إلى رهنة قرية بكرمان انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الرهيني (@)(@@) بالفتح والكسر إلى رهين جد.(@)(@@)(@@)(@@) || باب الراء والياء(@)(@@)(@@)(@@) $DIC_NIS$ الرياحي (@)(@@) بكسر وتخفيف التحتية ومهملة إلى رياح بطن من تميم ومن جرم قلت: وإلى محلة لهم بالبصرة انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الرياشي(@)(@@) بوزنه بمعجمة الى رياش رجل من جذام.(@)(@@)(@@)(@@) $DIC_NIS$ الرياني(@)(@@) بالفتح والتشديد الى ريان قرية بنسا قلت ومحلة ببغداد انتهى. PageV01P120(@)(@@)(@@)(@@) $DIC_NIS$ الريحاني (@)(@@) إلى الريحان المعروف وجد.(@)(@@)(@@)(@@) $DIC_NIS$ الريخشني (@)(@@) بالكسر وسكون التحتية والخاء المعجمة وفتح الشين المعجمة ونون إلى ريخشن قرية بسمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ الريساني (@)(@@) بالكسر ومهملة إلى ريسان جد.(@)(@@)(@@)(@@) $DIC_NIS$ الريغذموني (@)(@@) بالكسر وسكون التحتية والمعجمة وفتح الذال المعجمة وضم الميم إلى ريغذمون قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الريغي (@)(@@) إلى ريغة إقليم بالمغرب انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الريكنزي (@)(@@) بالكسر وفتح الكاف وسكون النون وزاي إلى ريكنز قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الريمي (@)(@@) إلى ريمة ناحية باليمن انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الريوددي (@)(@@) بالكسر وفتح الواو والمهمة الأولى إلى ريودد قرية بسمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ الريودي (@)(@@) مثله بدال 
ms76	 واحدة إلى ريودا قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الريوذي (@)(@@) مثله والذال معجمة إلى ريوذى من قرى بيهق.(@)(@@)(@@)(@@) $DIC_NIS$ الريورثوني (@)(@@) بالكسر وفتح الواو وسكون الراء وضم المثلثة إلى ريورثون قرية.(@)(@@)(@@)(@@) $DIC_NIS$ الريوقاني (@)(@@) بالكسر والسكون وفتح الواو وقاف إلى ريوقان قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الريونجي (@)(@@) بالكسر وفتح الواو وسكون التحتية قبلها والنون ثم جيم إلى ريونج.(@)(@@)(@@)(@@) $DIC_NIS$ الريوندي (@)(@@) بوزنه بدال مهملة إلى ريوند ناحية بنيسابور.(@)(@@)(@@)(@@) $DIC_NIS$ الريوي (@)(@@) بالسكر والسكون إلى ريو محلة ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الربي (@)(@@) بالفتح والتشديد إلى رية مدينة بالأندلس.(@)(@@)(@@)(@@) | حرف الزاي(@)(@@)(@@)(@@) || باب الزاي والألف(@)(@@)(@@)(@@) $DIC_NIS$ الزابي (@)(@@) إلى الزاب بموحدة ناحية بواسط وبالأندلس. PageV01P121(@)(@@)(@@)(@@) $DIC_NIS$ الزاذاني (@)(@@) بمعجمة إلى زاذان جد.(@)(@@)(@@)(@@) $DIC_NIS$ الزاذبهي (@)(@@) بفتح المعجمة وكسر الموحدة إلى زاذبه جد.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الزاذقاني (@)(@@) إلى زاذقان قرية انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الزاذكي (@)(@@) بفتح المعجمة إلى زاذك قرية بما وراء النهر.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الزارجاني (@)(@@) إلى زارجان قرية بأصبهان انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الزارياني (@)(@@) بسكر الراء وتخفيف التحتية إلى زاريان قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الزازي (@)(@@) بزاءين إلى زاز قرية بصغد سمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ الزاطي (@)(@@) إلى زاطيا جد.(@)(@@)(@@)(@@) $DIC_NIS$ الزاغرسرسني (@)(@@) بفتح الزاي والمعجمة والسينين المهملتين وسكون الراءين ونون إلى زاغرسرسن قرية بسمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ الزاغولي (@)(@@) بضم المعجمة إلى قرية من قرى بنج ديه وبالنون إلى زاغونا قرية ببغداد.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الزقفي (@)(@@) بقاف ثم فاء إلى زاقف قرية بنواحي بابل.(@)(@@)(@@)(@@) $DIC_NIS$ والزاكاني (@)(@@) إلى زاكان قبيلة من العرب سكنوا قزوين انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الزامراني (@)(@@) براء بعد الميم إلى زامران قرية قرب نسا.(@)(@@)(@@)(@@) $DIC_NIS$ الزاميني (@)(@@) بكسر الميم وسكون التحتية ونون إلى زامين بلد بنواحي سمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ الزامي (@)(@@) إلى زام ناحية بنيسابور.(@)(@@)(@@)(@@) $DIC_NIS$ الزاوري (@)(@@) بفتح الواو وراء إلى زاور قرية بالصغد وبالهاء إلى زاوة من قرى بوشنج. PageV01P122(@)(@@) قلت الزاوطي: بفتح الواو إلى زاوطا بلد قرب الطيب.(@)(@@)(@@)(@@) $DIC_NIS$ والزاوهي (@)(@@) بوزنه إلى زاوه كورة بنيسابور انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الزاهري (@)(@@) بكسر الهاء وراء إلى زاهر رجل.(@)(@@)(@@)(@@) $DIC_NIS$ الزاهي (@)(@@) كالقاضي إلى زاه قرية بنيسابور.(@)(@@)(@@)(@@) || باب الزاي والباء(@)(@@)(@@)(@@) $DIC_NIS$ الزبادي (@)(@@) بالفتح وتخفيف الموحدة ومهملة إلى زباد موضع بالغرب.(@)(@@)(@@)(@@) $DIC_NIS$ الزباري (@)(@@) بالضم والتخفيف وراء إلى زبارة بطن من العلويين 
ms77	 وبالفتح والتشديد إلى زبار جد.(@)(@@)(@@)(@@) $DIC_NIS$ الزبالي (@)(@@) بالفتح وقيل الضم والتخفيف ولام إلى جد وبالضم قطعا إلى زبالة موضع بطريق مكة شرفها الله تعالى قلت: من ناحية الكوفة انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الزيببي (@)(@@) بكسرتين إلى زيببا جد.(@)(@@)(@@)(@@) $DIC_NIS$ الزبحي (@)(@@) بفتح الزاي والباء الموحدة ومهملة إلى الزبح قرية بجرجان.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الزبداني (@)(@@) بفتحتين إلى الزبداني مثله كورة بني دمشق وبعلبك.(@)(@@)(@@)(@@) $DIC_NIS$ والزبدقاني (@)(@@) إلى زبدقان قرية على نهر الخابور انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الزبرقاني (@)(@@) بكسر الزاي والراء وسكون الموحدة وقاف إلى زبرقان جد.(@)(@@)(@@)(@@) $DIC_NIS$ الزبريقي (@)(@@) مثله وتحتية بعد الراء إلى زبريق جد.(@)(@@)(@@)(@@) $DIC_NIS$ الزبري (@)(@@) بالضم والفتح إلى زبر بطن من بني سامة بن لؤي وبالفتح والسكون إلى زبر جد. PageV01P123(@)(@@)(@@)(@@) $DIC_NIS$ الزبغدواني (@)(@@) بفتح الزاي والموحدة والواو وسكون المعجمة وضم الدال المهملة إلى زبغدوان قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الزبوري (@)(@@) إلى زبور بلفظ الكتاب جد.(@)(@@)(@@)(@@) $DIC_NIS$ الزبوي (@)(@@) بالفتح والضم إلى زبويه قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الزبيبي (@)(@@) بالفتح إلى الزبيب المأكول وبالنون آخره إلى زبينة جد.(@)(@@)(@@)(@@) $DIC_NIS$ الزبيدي (@)(@@) بالفتح والكسر ومهملة إلى زبيد مدينة باليمن وبالتصيغير إلى زبيد قبيلة من مذحج.(@)(@@)(@@)(@@) $DIC_NIS$ الزبيري (@)(@@) مصغرا إلى الزبير بن العوام وجد غيره قلت: والزبيرية قرية بمصر انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الزبيني (@)(@@) مر في الزبيبي.(@)(@@)(@@)(@@) $DIC_NIS$ الزبيلاذاني (@)(@@) بالضم والكسر وذال معجمة إلى زييلاذان قرية ببلخ.(@)(@@)(@@)(@@) || باب الزاي والجيم(@)(@@)(@@)(@@) $DIC_NIS$ الزجاج (@)(@@) بالفتح والتشديد إلى خرط الزجاج.(@)(@@)(@@)(@@) $DIC_NIS$ الزجاجي (@)(@@) بالفتح والتشديد صاحب الجمل إلى الزجاج شيخه قلت: وأبو شجاع الزجاجي إلى الزجاجة قرية بصعيد مصر قرب قوص انتهى.(@)(@@) وبضم الزاي وتخفيف الجيم إلى عمل الزجاج.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الزجالي (@)(@@) إلى الزجاجلة محلة بقرطبة انتهى.(@)(@@)(@@)(@@) || باب الزاي والراء(@)(@@)(@@)(@@) $DIC_NIS$ الزراد (@)(@@) بالفتح والتشديد إلى صنعة الدروع.(@)(@@)(@@)(@@) $DIC_NIS$ الزراري (@)(@@) بالضم ومهملتين إلى زرارة جد والزرارية من الشيعة أصحاب زرارة بن أعين.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الزرجاهي (@)(@@) بالفتح وسكون الراء وجيم إلى زرجاه قرية ببسطام انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الزرجيني (@)(@@) بفتح الزاي والجيم وسكون الراء والتحتية إلى زرين محلة بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الزرخشي (@)(@@) بفتح الزاي والراء وسكون المعجمة ثم معجمة إلى زرخش قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الزردي (@)(@@) بالفتح والسكون ومهملة 
ms78	 إلى زرد قرية بأسفراين وأبي الزرد جد.(@)(@@)(@@)(@@) $DIC_NIS$ الزرزمي (@)(@@) بفتح الزاي والراء وسكون الزاي إلى زرزم قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الزرقاني (@)(@@) بالفتح والسكون وقاف إلى زرقان.(@)(@@)(@@)(@@) $DIC_NIS$ الزرقي (@)(@@) بالفتح والسكون إلى زرق قرية بمرو PageV01P124(@)(@@)(@@)(@@) $DIC_NIS$ [الزرقي] (@)(@@) وبالضم والفتح إلى بني زريق بطن من الأنصار.(@)(@@)(@@)(@@) $DIC_NIS$ الزركواني (@)(@@) بفتح الزاي والكاف والواو وسكون الراء إلى زركوان قرية بسمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ الزرماني (@)(@@) بالفتح والسكون إلى زرمان قرية بسمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ الزرنجراي (@)(@@) بفتح الزاي والراء الأولى والجيم وسكون النون إلى زرنجرا قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الزرنجي (@)(@@) بفتحتين ونون ساكنة وجيم إلى زرنج ناحية بسجستان وبدال مهملة إلى زرند بلد بأصبهان.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الزرهوني (@)(@@) إلى زرهون جبل قرب فارس انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الزرواني (@)(@@) بالضم والسكون إلى زروان جد.(@)(@@)(@@)(@@) $DIC_NIS$ الزروديزكي (@)(@@) بفتح الزاي الأولى والأخيرة وضم الراء وكسر المهملة إلى زروديزة قرية بسمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ الزريقي (@)(@@) مصغرا إلى زريق جد.(@)(@@)(@@)(@@) $DIC_NIS$ الزري (@)(@@) بالفتح والتشديد إلى زر جد وبالكسر إلى زر جد.(@)(@@)(@@)(@@) || باب الزاي مع الزاي(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الززي (@)(@@) بمعجمتين ثانيتهما مشددة الزز ولاية بنواحي همذان انتهى.(@)(@@)(@@)(@@) || باب الزاي والطاء(@)(@@)(@@)(@@) $DIC_NIS$ الزطني (@)(@@) بفتح الزاي والطاء المشددة إلى زطن.(@)(@@)(@@)(@@) || باب الزاي والعين(@)(@@)(@@)(@@) $DIC_NIS$ الزعافري (@)(@@) بفتح الزاي والمهملة وكسر الفاء وراء إلى الزعافر بطن من أود. PageV01P125(@)(@@)(@@)(@@) $DIC_NIS$ الزعبلي (@)(@@) بفتح الزاي والباء الموحدة ولام إلى زعبل بطن من سامة بن لؤي وبكسرهما إلى زعبل جد.(@)(@@)(@@)(@@) $DIC_NIS$ الزعبي (@)(@@) مثله إلى زعب بطن من سليم.(@)(@@)(@@)(@@) $DIC_NIS$ الزعفراني (@)(@@) بفتح الزاي والفاء والراء إلى الزعفران المعروف وإلى الزعفرانية قرية قرب بغداد وأخرى بين همذان وأسداباذ وفرقة من المبتدعة.(@)(@@)(@@)(@@) $DIC_NIS$ الزعلي (@)(@@) بالكسر والسكون ولام إلى زعل بطن من سامة بن لؤي وبالفتح وكسر إلى زعل بطن منهم أيضا.(@)(@@)(@@)(@@) $DIC_NIS$ الزعوري (@)(@@) بالفتح والضم وراء إلى زعورا جد أبي زيد قيس بن السكن الأنصاري جامع القرآن.(@)(@@)(@@)(@@) $DIC_NIS$ الزعلاني (@)(@@) بالفتح والسكون إلى زعلان جد.(@)(@@)(@@)(@@) $DIC_NIS$ الزعيمي (@)(@@) بالفتح والكسر إلى زعيم الدولة.(@)(@@)(@@)(@@) || باب الزاي والغين(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الزغرتاني (@)(@@) إلى زغرتان قرية بهراة انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الزغريماشي (@)(@@) بفتح الزاي وسكون المعجمة وكسر الراء آخره معجمة إلى زغريماش 
ms79	 محلة بسمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ الزغبي (@)(@@) بالكسر وسكون المعجمة وباء موحدة إلى زغبة بطن من القين.(@)(@@)(@@)(@@) $DIC_NIS$ الزغنداني (@)(@@) بفتحتين وسكون النون ومهملة إلى زغندان قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الزغوري (@)(@@) بالفتح والضم وراء إلى زغورة.(@)(@@)(@@)(@@) $DIC_NIS$ الزغيثي (@)(@@) بالضم والفتح وتحتية ساكنة ومثلثة إلى زغيث بطن.(@)(@@)(@@)(@@) || باب الزاي والفاء(@)(@@)(@@)(@@) $DIC_NIS$ الزفتي (@)(@@) بالكسر وسكون الفاء وفوقية إلى الزفت المعروف.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الزفتاوي (@)(@@) بالكسر والسكون إلى زفتا قرية بمصر انتهى.(@)(@@)(@@)(@@) || باب الزاي والقاف(@)(@@)(@@)(@@) $DIC_NIS$ الزقاق (@)(@@) إلى الزق وبيعه.(@)(@@)(@@)(@@) $DIC_NIS$ الزقيقي (@)(@@) بالضم وفتح القاف الأولى وتحتية ساكنة إلى زقيق جد.(@)(@@)(@@)(@@) || باب الزاي والكاف(@)(@@)(@@)(@@) $DIC_NIS$ الزكاري (@)(@@) بالفتح والتشديد وراء إلى زكار جد.(@)(@@)(@@)(@@) || باب الزاي والكاف(@)PageV01P126(@)(@@)(@@)(@@) $DIC_NIS$ الزكاني (@)(@@) بالفتح إلى زكان قرية بسمرقند.(@)(@@)(@@)(@@) || باب الزاي واللام(@)(@@)(@@)(@@) $DIC_NIS$ الزليقي (@)(@@) بالضم آخره قاف إلى زليقة بطن من هذيل.(@)(@@)(@@)(@@) || باب الزاي والميم(@)(@@)(@@)(@@) $DIC_NIS$ الزماني (@)(@@) بالكسر والتشديد إلى زمان بطن من ربيعة ومن الأزد وهوازن.(@)(@@)(@@)(@@) $DIC_NIS$ الزمخشري (@)(@@) بفتح الزاي والميم والشين المعجمة وسكون الخاء المعجمة وراء إلى زمخشر قرية بخوارزم.(@)(@@)(@@)(@@) $DIC_NIS$ الزمزمي (@)(@@) إلى زمزم بئر وزمزمة جد الزمعي: بالفتح والسكون ومهملة إلى زمعة جد.(@)(@@)(@@)(@@) $DIC_NIS$ الزملقي (@)(@@) بكسر الزاي واللام وسكون الميم وقاف إلى زملقا قرية ببخارى قلت: وبضم أوله وثانيه وسكون اللام إلى زملق قرية بمرو انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الزملكاني (@)(@@) بفتح الزاي واللام إلى زملكا قرية بدمشق وأخرى ببلخ.(@)(@@)(@@)(@@) $DIC_NIS$ الزميلي (@)(@@) مصغرا إلى بني زميل بطن من تجيب.(@)(@@)(@@)(@@) $DIC_NIS$ الزمي (@)(@@) بالفتح والتشديد إلى زم بلد على طرف جيحون. قلت: ...(@)(@@)(@@)(@@) || باب الزاي والنون(@)(@@)(@@)(@@) $DIC_NIS$ الزناتي (@)(@@) بالفتح إلى زنات ناحية بسرقسطة انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الزنبري (@)(@@) بفتح الزاي والموحدة وسكون النون بينهما وراء إلى أبي زنبر جد قلت: وزنبر محلة بمصر انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الزنبقي (@)(@@) بفتح الزاي والموحدة وسكون والنون بينهما وقاف إلى بيع الأدهان الطيبة.(@)(@@)(@@)(@@) $DIC_NIS$ الزنجاني (@)(@@) بالفتح والسكون إلى زنجان مدينة على حد أزربيجان.(@)(@@)(@@)(@@) $DIC_NIS$ الزنجفري (@)(@@) بالكسر وفتح الجيم وسكون النون والفاء إلى عمل الزنجفر المعروف.(@)(@@)(@@)(@@) $DIC_NIS$ الزنجوي (@)(@@) بالفتح وضم الجيم إلى زنجويه جد.(@)(@@)(@@)(@@) $DIC_NIS$ الزنجي (@)(@@) بالفتح إلى الزنج نوع من السودان.(@)(@@)(@@)(@@) $DIC_NIS$ الزندخاني (@)(@@) بفتح الزاي والدال المهملة 
ms80	 والخاء المعجمة إلى زندخان قرية بسرخس قلت: وبالجيم بدل الخاء قرية ببوشنج انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الزندرميثي (@)(@@) بفتح الزاي والمهملة والمثلثة PageV01P127 وسكون النون والراء والتحتية بعد الميم لى زندرميثن قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الزندوردي (@)(@@) بفتح الزاي والدال المهملة الأولى والواو وسكون النون والراء إلى زندورد قرية ببغداد.(@)(@@)(@@)(@@) $DIC_NIS$ الزندنياي (@)(@@) بفتح الزاي والمهملة والتحتية وسكون النونين إلى زندنيا قرية بنسف.(@)(@@)(@@)(@@) $DIC_NIS$ الزندني (@)(@@) بفتح الزاي والمهملة وسكون النون إلى زندنة قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الزندي (@)(@@) مثله بلا نون إلى زند قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الزنكلوني (@)(@@) يتلو في السنكلومي.(@)(@@)(@@)(@@) || باب الزاي والواو(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الزواحي (@)(@@) بالفتح إلى الزواحي قرية باليمن انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الزوالقنجي (@)(@@) بالضم وفتح الواو واللام والقاف وسكون النون وجيم إلى زوالقنج محلة بالسنج.(@)(@@)(@@)(@@) $DIC_NIS$ الزورابذي (@)(@@) بالضم وفتح الراء والباء الموحدة ثم معجمة إلى زورابذ ناحية بسرخس وبنيسابور أيضا.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الزوزاني (@)(@@) إلى زوزا قرية بحران انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الزوزني (@)(@@) بفتح الزاءين وسكون الواو إلى زوزن بلد بين هراة ونيسابور.(@)(@@)(@@)(@@) $DIC_NIS$ الزوشي (@)(@@) بالضم ومعجمة إلى زوش قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الزوفي (@)(@@) بالفتح والسكون وفاء إلى زوف بطن من مراد ومن حضرموت.(@)(@@)(@@)(@@) $DIC_NIS$ الزولهي (@)(@@) بالضم وفتح اللام إلى زولاه قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الزولابي (@)(@@) بالضم وموحدة إلى زولاب موضع بخراسان انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الزولاقي (@)(@@) بالضم وقاف إلى زولاق جد.(@)(@@)(@@)(@@) $DIC_NIS$ الزويلي (@)(@@) بالضم والكسر إلى زويل محلة بهمذان انتهى.(@)(@@)(@@)(@@) || باب الزاي والهاء(@)(@@)(@@)(@@) $DIC_NIS$ الزهراني (@)(@@) بالفتح والسكون إلى زهران بطن من الأزد.(@)(@@)(@@)(@@) $DIC_NIS$ الزهري (@)(@@) بالضم إلى زهرة بن كلاب بن مرة بن PageV01P128 كعب بن لؤي وزهرة بن بديل بن سعد بن عدي قلت: وبالفتح إلى الزهراء مدينة بقرطبة انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الزهموي (@)(@@) بالفتح والسكون إلى زهمويه جد.(@)(@@)(@@)(@@) $DIC_NIS$ الزهيري (@)(@@) مصغرا إلى زهير بن خشم بن بكر وزهير بن جناب بن هبل بطن من كلب.(@)(@@)(@@)(@@) || باب الزاي والياء(@)(@@)(@@)(@@) $DIC_NIS$ الزيات (@)(@@) إلى بيع الزيت الزياداباذي: بالكسر وفتح التحتية والمهملة والباء الموحدة آخره معجمة إلى زياداباذ قرية بشيراز.(@)(@@)(@@)(@@) $DIC_NIS$ الزيادي (@)(@@) بالكسر إلى زياد جد وبطن من الأزد ومن بني كعب والزيادية من الخوارج إلى زياد بن الأصفر. 