ms101	 ومهملة آخره إلى نون إلى صنعاء بالمد مدينة باليمن وقرية بدمشق.(@)(@@)(@@)(@@) $DIC_NIS$ الصنعي (@)(@@) بالفتح والسكون.(@)(@@)(@@)(@@) $DIC_NIS$ الصنمي (@)(@@) بفتحتين إلى بني الصنم بطن من الأشعريين في المعافر.(@)(@@)(@@)(@@) $DIC_NIS$ الصنوبري (@)(@@) بفتح أوله والنون والموحدة إلى الصنوبر المعروف.(@)(@@)(@@)(@@) $DIC_NIS$ الصنهاجي (@)(@@) بالكسر والسكون وجيم إلى صنهاجة قبيلة من حمير بالغرب.(@)(@@)(@@)(@@) || باب الصاد والواو(@)(@@)(@@)(@@) $DIC_NIS$ الصواف (@)(@@) إلى بيع الصوف.(@)(@@)(@@)(@@) $DIC_NIS$ الصوراني (@)(@@) بالضم وراء إلى صوران قرية باليمن وصورا قرية بين بغداد والكوفة.(@)(@@)(@@)(@@) $DIC_NIS$ الصوري (@)(@@) مثله إلى صور مدينة بساحل الشام.(@)(@@)(@@)(@@) $DIC_NIS$ الصوفي (@)(@@) إلى التصوف.(@)(@@)(@@)(@@) $DIC_NIS$ الصولي (@)(@@) بالضم إلى صول جد قلت: وبالفتح إلى صول قرية بالصعيد والصولي أيضا بلغة أهل الإسكاف انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الصوناخي (@)(@@) بالضم ونون وخاء معجمة إلى صوناخ قرية بفاراب.(@)(@@)(@@)(@@) || باب الصاد الهاء(@)PageV01P163(@)(@@)(@@)(@@) $DIC_NIS$ الصهباني (@)(@@) بالضم والسكون وموحدة ونون إلى صهبان بطن من النخع.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الصهرجتي (@)(@@) إلى صهرجت قرية بمصر انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الصهيبي (@)(@@) بالتصغير إلى صهيبة بطن من أنمار.(@)(@@)(@@)(@@) || باب الصاد والياء(@)(@@)(@@)(@@) $DIC_NIS$ الصياد (@)(@@) إلى الصيد.(@)(@@)(@@)(@@) $DIC_NIS$ الصيداني والصيداوي(@)(@@) بالفتح والسكون ومهملة إلى صيداء مدينة بساحل الشام والثاني إلى الصيداء بطن من أسد بن خزيمة.(@)(@@)(@@)(@@) $DIC_NIS$ الصيدناني (@)(@@) بفتح أوله والمهملة والنون.(@)(@@)(@@)(@@) $DIC_NIS$ واصيدلاني (@)(@@) بوزنه ولام إلى بيع الأدوية والعقاقير.(@)(@@)(@@)(@@) $DIC_NIS$ الصيرفي (@)(@@) بالفتح إلى بيع الذهب.(@)(@@)(@@)(@@) $DIC_NIS$ الصيغوني (@)(@@) بالفتح والسكون وضم المعجمة إلى صيغون جد.(@)(@@)(@@)(@@) $DIC_NIS$ الصيقل (@)(@@) بفتح أوله والقاف إلى صقل السيف.(@)(@@)(@@)(@@) $DIC_NIS$ الصيمري (@)(@@) بالفتح والسكون وراء آخره إلى الصيمرة نهر بالبصرة عليه عدة قرى وبلد بخوزستان قلت ميمه مفتوحة انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الصيني (@)(@@) بالكسر إلى بلاد الصين إقليم بالمشرق وصينية مدينة بالعراق. PageV01P164(@)(@@)(@@)(@@) | حرف الضاد المعجمة(@)(@@)(@@)(@@) || باب الضاد والألف(@)(@@)(@@)(@@) $DIC_NIS$ الضال (@)(@@) معاوية بن عبد الكريم تاه في طرق مكة فلقب به.(@)(@@)(@@)(@@) || باب الضاد والباء(@)(@@)(@@)(@@) $DIC_NIS$ الضبابي (@)(@@) بالفتح وموحدتين إلى الضباب بطن من بني الحارث ومن قريش وبالكسر إلى ضباب بن عامر بن صعصعة وقلعة الضباب محلة بالكوفة وضباب جد.(@)(@@)(@@)(@@) $DIC_NIS$ الضباثي (@)(@@) بالضم آخره مثلثة إلى ضباث بطن من جشم.(@)(@@)(@@)(@@) $DIC_NIS$ الضبعي (@)(@@) بالضم والفتح ومهملة إلى ضبيعة بن قيس بطن من بكر بن وائل 
ms102	 وضبيعة بن ربيعة بن نزار بن معد بن عدنان.(@)(@@)(@@)(@@) $DIC_NIS$ الضبني (@)(@@) بفتحتين ونون إلى ضبينة بطن من جذام.(@)(@@)(@@)(@@) $DIC_NIS$ الضبيسي (@)(@@) بالفتح والكسر وتحتية ومهملة إلى ضبيس بطن من عذرة.(@)(@@)(@@)(@@) $DIC_NIS$ الضبي (@)(@@) بالفتح والتشديد إلى ضبة بن أد بن طابخة بن الياس بن مضر وضبة بن الحارث في قريش وضبة بن عمرو في هذيل وضبة قرية بالحجاز وجد.(@)(@@)(@@)(@@) || باب الضاد والخاء(@)(@@)(@@)(@@) $DIC_NIS$ الضخمي (@)(@@) بالفتح وسكون المعجمة إلى الضخم جد.(@)(@@)(@@)(@@) || باب الضاد والراء(@)(@@)(@@)(@@) $DIC_NIS$ الضراب (@)(@@) إلى ضرب الدارهم والدنانير.(@)(@@)(@@)(@@) $DIC_NIS$ الضراري (@)(@@) بالكسر والتخفيف إلى ضرار جد وبسين مهملة آخره إلى ضراس قرية باليمن وبالميم إلى ضرام بطن من جهينة.(@)(@@)(@@)(@@) || باب الضاد والفاء(@)(@@)(@@)(@@) $DIC_NIS$ الضفادعي (@)(@@) بكسر الدال المهملة إلى درب الضفادع محلة ببغداد.(@)(@@)(@@)(@@) || باب الضاد والميم(@)(@@)(@@)(@@) $DIC_NIS$ الضمري (@)(@@) بالفتح والسكون إلى ضمرة بن بكر بن عبد مناة بن كنانة بن خزيمة بن مدركة بن الياس بن مضر.(@)(@@)(@@)(@@) $DIC_NIS$ الضميري (@)(@@) مصغرا إلى ضمير قرية بدمشق وإلى الأضمور بطن من رعين.(@)(@@)(@@)(@@) || باب الضاد والنون(@)(@@)(@@)(@@) $DIC_NIS$ الضني (@)(@@) بالكسر وتشديد النون إلى ضنة بطن من قضاعة ومن الأزد ومن عذرة ومن أسد بن خزيمة ومن بكر بن وائل.(@)(@@)(@@)(@@) || باب الضاد والياء(@)PageV01P165(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الضيقي (@)(@@) بالفتح والسكون وقاف إلى الضيقة قرب عيذاب انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الضييمي (@)(@@) بالضم وفتح التحتية الأولى وسكون الثانية إلى ضييم بطن من فهم.(@)(@@)(@@)(@@) | باب الطاء المهملة(@)(@@)(@@)(@@) || باب الطاء والألف:(@)(@@)(@@)(@@) $DIC_NIS$ الطابراني:(@)(@@) بفتح الموحدة والراء إلى طابران بلد بطوس.(@)(@@)(@@)(@@) $DIC_NIS$ الطابقي (@)(@@) بفتح الموحدة وقاف إلى الطابق ببغداد.(@)(@@)(@@)(@@) $DIC_NIS$ الطاحوني (@)(@@) بضم المهملة إلى الطاحونة.(@)(@@)(@@)(@@) $DIC_NIS$ الطاحي (@)(@@) كالقاضي إلى طاحية بطن من الأزد ومحلة لهم بالبصرة.(@)(@@)(@@)(@@) $DIC_NIS$ الطاذي (@)(@@) بالمعجمة إلى طاذ قرية بأصبهان.(@)(@@)(@@)(@@) $DIC_NIS$ الطارابي (@)(@@) براء وموحدة إلى طاراب قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الطارفي (@)(@@) إلى طارف بالفاء قرية بإفريقية انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الطاسبندي (@)(@@) بسكون المهملة والنون بينهما موحدة مفتوحة آخره مهملة إلى طاسبندا قرية بهمذان.(@)(@@)(@@)(@@) $DIC_NIS$ الطاطري (@)(@@) بفتح الطاءين هو بياع الثياب البيض بدمشق ومصرز قلت: الطاعلي: إلى طاعلة بالأندلس انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الطالبي (@)(@@) بكسر اللام إلى أبي طالب جد. 
ms103	(@)(@@)(@@)(@@) $DIC_NIS$ الطالقاني (@)(@@) بسكون اللام وقاف إلى طالقان بلد بخراسان وبقزوين أيضا.(@)(@@)(@@)(@@) $DIC_NIS$ الطامذي (@)(@@) بفتح الميم ومعجمة إلى طامذ قرية بأصبهان.(@)(@@)(@@)(@@) $DIC_NIS$ الطاواني (@)(@@) إلى طاوان جد.(@)(@@)(@@)(@@) $DIC_NIS$ الطاهري (@)(@@) إلى طاهر جد والحريم الطاهري ببغداد. PageV01P166(@)(@@)(@@)(@@) $DIC_NIS$ الطائفي (@)(@@) بالفاء إلى الطائف مدينة بالحجاز.(@)(@@)(@@)(@@) $DIC_NIS$ الطايكاني (@)(@@) بتحتية قبل الكاف إلى طايكان بلد بنواحي بلخ.(@)(@@)(@@)(@@) $DIC_NIS$ الطائي (@)(@@) إلى طيء.(@)(@@)(@@)(@@) || باب الطاء والباء(@)(@@)(@@)(@@) $DIC_NIS$ الطباع(@)(@@) بالعين المهملة إلى عمل السيوف.(@)(@@)(@@)(@@) $DIC_NIS$ الطبائي (@)(@@) بالكسر وتخفيف الموحدة إلى طبا قرية باليمن.(@)(@@)(@@)(@@) $DIC_NIS$ الطبراخي (@)(@@) بفتح أوله والراء بينهما موحدة ساكنة آخره معجمة إلى طبراخ جد.(@)(@@)(@@)(@@) $DIC_NIS$ الطبراني (@)(@@) بفتحات إلى طبرية مدينة بالأردن.(@)(@@)(@@)(@@) $DIC_NIS$ الطبري (@)(@@) بفتحتين إلى طبرستان.(@)(@@)(@@)(@@) $DIC_NIS$ الطبرخزي (@)(@@) بفتح الطاء والباء والخاء المعجمة قبلها راء ساكنة وبعدها زاي هو أبو بكر محمد بن العباس الشاعر لأن أباه من خوارزم وأمه من طبرستان.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الطبركي (@)(@@) بفتحتين إلى طبرك قلعة على جبل قرب الري انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الطبسي (@)(@@) بفتحتين ومهملة إلى طبس مدينة بين نيسابور وأصبهان وكرمان.(@)(@@)(@@)(@@) $DIC_NIS$ الطبني (@)(@@) بضمتين ونون إلى طبنة بلد بالمغرب.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الطبيري (@)(@@) بالفتح والكسر إلى طبيرة بلد بالأندلس انتهى.(@)(@@)(@@)(@@) || باب الطاء والحاء(@)(@@)(@@)(@@) $DIC_NIS$ الطحان (@)(@@) إلى طحن الحب.(@)(@@)(@@)(@@) $DIC_NIS$ الطحاوي (@)(@@) بالفتح إلى طحا قرية بصعيد مصر قلت: ليس منها بل من طحطوط قرية بقربها فكرة أن يقال طحطوطي انتهى.(@)(@@)(@@)(@@) || باب الطاء والخاء(@)(@@)(@@)(@@) $DIC_NIS$ الطخارستاني (@)(@@) بفتح الطاء والمعجمة والفوقية وضم الراء وسكون المهملة إلى طخارستان ناحية كبيرة على جيحون.(@)(@@)(@@)(@@) $DIC_NIS$ الطخروذي (@)(@@) بالفتح والسكون والضم ومعجمة إلى طخروذ قرية بنيسابور.(@)(@@)(@@)(@@) $DIC_NIS$ الطخشي (@)(@@) بالفتح والسكون ومعجمة إلى طخش قرية بمرو.(@)(@@)(@@)(@@) || باب الطاء والراء(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الطرابلسي (@)(@@) تقدم في الأطرابلسي.(@)(@@)(@@)(@@) $DIC_NIS$ والطرابنشي (@)(@@) بمعجمة إلى طرابنش مدينة بجزيرة صقلية انتهى. PageV01P167(@)(@@)(@@)(@@) $DIC_NIS$ الطرازي (@)(@@) بفتح الطاء والراء ثم زاي إلى طراز مدينة على حد بلاد الترك وسكة طراز بأصبهان وبكسر الطاء إلى عمل الثياب المطرزة.(@)(@@)(@@)(@@) $DIC_NIS$ الطرائفي (@)(@@) بفتحتين وفاء إلى بيع الطرائف وهي الأشياء الحسنة المتخذة من الخشب.(@)(@@)(@@)(@@) $DIC_NIS$ الطرخاباذي (@)(@@) بفتح الطاء والخاء المعجمة والموحدة وسكون الراء آخره معجمة إلى طرخاباذ قرية 
ms104	 بجرجان.(@)(@@)(@@)(@@) $DIC_NIS$ الطرخاني (@)(@@) بفتح أوله والمعجمة بينهما راء ساكنة إلى طرخان جد.(@)(@@)(@@)(@@) $DIC_NIS$ الطرخوني (@)(@@) بالفتح والسكون والضم إلى طرخون جد.(@)(@@)(@@)(@@) $DIC_NIS$ الطرسوسي (@)(@@) بفتح الطاء والراء وضم المهملة الأولى إلى طرسوس مدينة بناحية الروم.(@)(@@)(@@)(@@) $DIC_NIS$ الطرطوسي (@)(@@) بالفتح والسكون والضم آخره مهملة إلى طرطوس مدينة وبالمعجمة آخره إلى طرطوشة مدينة بالأندلس.(@)(@@)(@@)(@@) $DIC_NIS$ الطرقي (@)(@@) بالفتح والسكون وقاف إلى طرق قرية بأصبهان قلت: وبفتح الراء وفاء إلى مسجد طرقة بقرطبة انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الطرماحي (@)(@@) بكسرتين وتشديد الميم آخره مهملة إلى الطرماح جد.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الطرميسي (@)(@@) إلى طرميس قرية بدمشق انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الطرواحي (@)(@@) بالضم والسكون وفتح الواو آخره مهملة إلى طرواح قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الطرياني (@)(@@) إلى طريانة بإشبيلية انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الطريثيثي (@)(@@) بالضم والفتح وسكون التحتية ومثلثة مكسورة وتحتية ومثلثة إلى طريثيث ناحية بنيسابور.(@)(@@)(@@)(@@) $DIC_NIS$ الطريفي (@)(@@) بالفتح والكسر وفاء إلى طريف بطن من طيء وبالقاف علي بن المنذر لأنه ولد بالطريق. PageV01P168(@)(@@)(@@)(@@) || باب الطاء والزاي(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الطزياني (@)(@@) بالضم وزاي إلى طزيان قرية بديار بكر انتهى.(@)(@@)(@@)(@@) || باب الطاء والسين(@)(@@)(@@)(@@) $DIC_NIS$ الطساس (@)(@@) إلى عمل الطست وكذا الطستي.(@)(@@)(@@)(@@) || باب الطاء والغين(@)(@@)(@@)(@@) $DIC_NIS$ الطغامي (@)(@@) بالفتح ومعجمة إلى طغاما من سواد بخارى.(@)(@@)(@@)(@@) || باب الطاء والفاء(@)(@@)(@@)(@@) $DIC_NIS$ الطفال (@)(@@) إلى بيع الطفال وهو طين يؤكل.(@)(@@)(@@)(@@) $DIC_NIS$ الطفاوي (@)(@@) بالضم وفاء إلى طفاوة من قيس عيلان.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الطفرباذي (@)(@@) بالفتح وسكون الفاء وموحدة ومعجمة إلى طفراباذ محلة بهمذان انتهى.(@)(@@)(@@)(@@) || باب الطاء واللام(@)(@@)(@@)(@@) $DIC_NIS$ الطلحي (@)(@@) بالفتح والسكون ومهملة إلى طلحة بن عبيد الله.(@)(@@)(@@)(@@) $DIC_NIS$ الطلقي (@)(@@) بفتحتين وقاف قلت: كأنه إلى طلقان قرية بالزهراء.(@)(@@)(@@)(@@) $DIC_NIS$ والطلمنكي (@)(@@) بفتحات وسكون النون إلى طلمنكة مدينة بالأندلس.(@)(@@)(@@)(@@) $DIC_NIS$ والطلياطي (@)(@@) بالفتح والسكون إلى طلياطة ناحية قرب قرطبة بالغرب انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الطليطلي (@)(@@) بالضم والفتح والسكون وكسر الطاء ولام إلى طليطلة مدينة بالأندلس.(@)(@@)(@@)(@@) $DIC_NIS$ الطلي (@)(@@) بالفتح والتشديد إلى بيت طل قرية بغزة.(@)(@@)(@@)(@@) || باب الطاء والميم(@)(@@)(@@)(@@) $DIC_NIS$ الطميسي (@)(@@) بالفتح والكسر آخره مهملة إلى طميس قرية بمازندران.(@)(@@)(@@)(@@) || باب الطاء والنون(@)(@@)(@@)(@@) $DIC_NIS$ الطناجيري (@)(@@) بالفتح وتخفيف النون وكسر الجيم وتحتية وراء إلى الطناجير وهي الدسوت.(@)(@@)(@@)(@@) $DIC_NIS$ الطنافسي (@)(@@) بفتحتين 
ms105	 وكسر الفاء ومهملة إلى الطنفسة المعروفة.(@)(@@)(@@)(@@) $DIC_NIS$ الطنبذي (@)(@@) بضم الطاء والموحدة بينهما نون PageV01P169 ساكنة آخره معجمة إلى طنبذا قرية بمصر.(@)(@@)(@@)(@@) $DIC_NIS$ الطنبي (@)(@@) بالضم والسكون وموحدة إلى الطنب موضع بطريق مكة.(@)(@@)(@@)(@@) $DIC_NIS$ الطنجي (@)(@@) بالفتح والسكون وجيم إلى طنجة.(@)(@@)(@@)(@@) $DIC_NIS$ الطنزي (@)(@@) مثله بالزاي إلى طنزة بلد بديار بكر قلت: وإلى شارع الطنز ببغداد انتهى.(@)(@@)(@@)(@@) || باب الطاء والواو(@)(@@)(@@)(@@) $DIC_NIS$ الطوابيقي (@)(@@) بفتحتين وكسر الموحدة وتحتية وقاف إلى الطوابيق وهي الآجر الكبار.(@)(@@)(@@)(@@) $DIC_NIS$ الطواويسي (@)(@@) بوزنه آخره مهملة إلى طواويس قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الطوبي (@)(@@) بالضم وموحدة إلى قصر الطوب موضع بإفريقية قلت: وبالخاء إلى طوخ عدة قرى بمصر.(@)(@@)(@@)(@@) $DIC_NIS$ والطوراني (@)(@@) بالضم إلى طوران قرية بهراة انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الطورخاري (@)(@@) بالضم وسكون الواو والراء الأولى وخاء معجمة إلى طورخار جد.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الطورقي (@)(@@) إلى طورق قرية بنواحي أبيورد وبالكاف إلى طورك سكة ببلخ اتنهى.(@)(@@)(@@)(@@) $DIC_NIS$ الطوريني (@)(@@) بالضم وكسر الراء وتحتية ونون إلى طورين قرية بالري.(@)(@@)(@@)(@@) $DIC_NIS$ الطوساني (@)(@@) بالضم ومهملة إلى طوسان قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الطوسي (@)(@@) مثله إلى طوس قرية ببخارى قلت: ومدينة بخراسان غيرها منها الغزالي رحمه الله وغيره وبفتح الطاء.(@)(@@)(@@)(@@) $DIC_NIS$ والطوطالقي (@)(@@) بالضم إلى طوطالقة بالأندلس.(@)(@@)(@@)(@@) $DIC_NIS$ والطولقي (@)(@@) بالفتح إلى طولقة مدينة بالغرب انتهى. PageV01P170(@)(@@)(@@)(@@) $DIC_NIS$ الطولوني (@)(@@) بضم الطاء واللام إلى أحمد بن طولون.(@)(@@)(@@)(@@) $DIC_NIS$ الطوماري (@)(@@) بالضم آخره راء إلى طومار جد.(@)(@@)(@@)(@@) $DIC_NIS$ الطويتي (@)(@@) بالضم والفتح وسكون التحتية وفوقية إلى طويت جد وبطاء آخره بدلها أيضا.(@)(@@)(@@)(@@) || باب الطاء والهاء(@)(@@)(@@)(@@) $DIC_NIS$ الطهراني (@)(@@) بالكسر والسكون وراء إلى طهران قرية بأصبهان وبالري أيضا.(@)(@@)(@@)(@@) $DIC_NIS$ الطهرمسي (@)(@@) بضم الطاء والهاء والميم وسكون الراء آخره مهملة إلى طهرمس قرية بمصر.(@)(@@)(@@)(@@) $DIC_NIS$ الطهماني (@)(@@) بالفتح والسكون إلى طهمان رجل.(@)(@@)(@@)(@@) $DIC_NIS$ الطهوي (@)(@@) بالضم والفتح إلى طهية بطن من تميم.(@)(@@)(@@)(@@) || باب الطاء والياء(@)(@@)(@@)(@@) $DIC_NIS$ الطيالسي (@)(@@) بفتح الطاء والتحتية إلى الطيالسة المعروفة.(@)(@@)(@@)(@@) $DIC_NIS$ الطيان (@)(@@) إلى عمل الطين.(@)(@@)(@@)(@@) $DIC_NIS$ الطيبي (@)(@@) بالفتح والسكون وموحدة إلى أبي طيبة جد وبالكسر إلى الطيب بلد بين واسط وكور الأهواز.(@)(@@)(@@)(@@) $DIC_NIS$ الطيراني (@)(@@) بالكسر والسكون وراء ونون إلى طيرا قرية بأصبهان.(@)(@@)(@@)(@@) $DIC_NIS$ الطيري (@)(@@) بالفتح والسكون إلى 
ms106	 الطير جد وبالكسر إلى الطيرة قرية بدمشق.(@)(@@)(@@)(@@) $DIC_NIS$ الطيسفوني (@)(@@) بفتح الطاء والمهملة وفاء إلى طيسفون قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الطيشي (@)(@@) بالفتح والسكون ومعجمة إلى طيشة جد.(@)(@@)(@@)(@@) $DIC_NIS$ الطيفوري (@)(@@) بالفتح والسكون وضم الفاء وراء آخره إلى طيفور جد.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الطيفوراباذي (@)(@@) إلى طيفورآباذ قرية بأصبهان أو محلة بهمذان انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الطيبي (@)(@@) بالكسر آخره نون إلى بيع الطين المالح الذي يؤكل وإلى موضع بالغرب قلت: بل بقرب تنيس يقال له الطينة قاله ياقوت انتهى.(@)(@@)(@@)(@@) | حرف الظاء المعجمة(@)(@@)(@@)(@@) || باب الظاء والألف(@)(@@)(@@)(@@) $DIC_NIS$ الظاهري (@)(@@) إلى مذهب داود لقوله بالظاهر ونفي القياس.(@)(@@)(@@)(@@) $DIC_NIS$ الظبياني (@)(@@) بالفتح وسكون الموحدة وتخفيف التحتية إلى ظبيان بطن من الأزد.(@)(@@)(@@)(@@) || باب الظاء والفاء (@)PageV01P171(@)(@@)(@@)(@@) $DIC_NIS$ الظفري (@)(@@) بفتح الظاء والفاء وراء إلى ظفر بطن من الأنصار ومن سليم ومن جمير والظفرية محلة ببغداد.(@)(@@)(@@)(@@) || باب الظاء واللام(@)(@@)(@@)(@@) $DIC_NIS$ الظليمي (@)(@@) بالضم والفتح والسكون إلى ظليم بطن من تميم.(@)(@@)(@@)(@@) || باب الظاء والنون(@)(@@)(@@)(@@) || باب الظاء والهاء(@)(@@)(@@)(@@) $DIC_NIS$ الظني (@)(@@) بالفتح والتشديد إلى ظنة قبيلة.(@)(@@)(@@)(@@) $DIC_NIS$ الظهراني (@)(@@) بالكسر والسكون إلى ظهران قرية قرب مكة وليست بمر الظهران.(@)(@@)(@@)(@@) $DIC_NIS$ الظهري (@)(@@) مثله إلى ظهر بطن من حمير.(@)(@@)(@@)(@@) || باب الظاء والياء(@)(@@)(@@)(@@) $DIC_NIS$ الظيقي (@)(@@) بالفتح والسكون وقاف إلى ظيقة منزل على عشرة فراسخ من عيذاب قلت: صحح ياقوت أنها بالضاد وتقدمت انتهى.(@)(@@)(@@)(@@) | حرف العين المهملة(@)(@@)(@@)(@@) || باب العين والألف(@)(@@)(@@)(@@) $DIC_NIS$ العابدي (@)(@@) بكسر الموحدة ودال مهملة إلى عابد بن عبد الله بن عمر بن مخزوم.(@)(@@)(@@)(@@) $DIC_NIS$ العابري (@)(@@) بفتح الموحدة وراء إلى عابر بن أفخشذ بن سام بن نوح.(@)(@@)(@@)(@@) $DIC_NIS$ العاجي (@)(@@) إلى بيع العاج.(@)(@@)(@@)(@@) $DIC_NIS$ العادائي (@)(@@) إلى بني عاداة.(@)(@@)(@@)(@@) $DIC_NIS$ العادلي (@)(@@) إلى عادل جد.(@)(@@)(@@)(@@) $DIC_NIS$ العادي (@)(@@) إلى عادية بطن من بجيلة.(@)(@@)(@@)(@@) $DIC_NIS$ العاصمي (@)(@@) إلى عاصم جد وبطن من تميم.(@)(@@)(@@)(@@) $DIC_NIS$ العاصي (@)(@@) إلى العاص بطن من الأزد.(@)(@@)(@@)(@@) $DIC_NIS$ العاقولي (@)(@@) بضم القاف إلى دير العاقول بلد قرب بغداد. PageV01P172(@)(@@)(@@)(@@) $DIC_NIS$ العامري (@)(@@) إلى عامر بن لؤي بن غالب.(@)(@@)(@@)(@@) $DIC_NIS$ وعامر (@)(@@) بن صعصعة من قيس عيلان وعامر بن عدي من تجيب وعامر بن ثعلبة وعامر بن سعد من النخع وعامر بن ملك 
ms107	 من همدان.(@)(@@)(@@)(@@) $DIC_NIS$ العاملي (@)(@@) بكسر الميم إلى عاملة من قضاعة.(@)(@@)(@@)(@@) $DIC_NIS$ العاني (@)(@@) إلى عانة مدينة على الفرات.(@)(@@)(@@)(@@) $DIC_NIS$ العائذي (@)(@@) بالتحتية والمعجمة إلى عائذ بن عمران بن مخزوم وعائذة من بني شيبان وعائذة من ضبة وعائذ بن ثعلبة من بكر بن وائل وعائذ الله بن سعد العشيرة وعائذ الله أخي جعفي.(@)(@@)(@@)(@@) $DIC_NIS$ العائشي (@)(@@) مثله إلى عائشة بنت طلحة بن عبيد الله وبني عائش بن مالك بن تيم الله.(@)(@@)(@@)(@@) || باب العين والباء(@)(@@)(@@)(@@) $DIC_NIS$ العبابي (@)(@@) بالفتح وتشديد الموحدة الأولى إلى عباب رجل.(@)(@@)(@@)(@@) $DIC_NIS$ البعاداني (@)(@@) مثله وداله مهملة إلى عبادان بلد بنواحي البصرة.(@)(@@)(@@)(@@) $DIC_NIS$ العبادي (@)(@@) إلى عباد جد وسنج العبادي قرية بمرو قلت: وإلى العبادية قرية بدمشق انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ العبادي (@)(@@) بالضم والتخفيف إلى عباد بن ضبيعة وعبادة بن الصامت وعبادة حي من العرب وبالضم والتشديد إلى عباد بن ضبيعة في قول منكر وبالكسر إلى عباد عدة بطون.(@)(@@)(@@)(@@) $DIC_NIS$ العباسي (@)(@@) إلى العباس بن عبد المطلب قلت: وإلى العباسة قرية بمصر انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ العبائي (@)(@@) بالفتح إلى بيع العباءة. PageV01P173(@)(@@)(@@)(@@) $DIC_NIS$ العبداني (@)(@@) بفتح المهملتين إلى عبدان قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ العبدري (@)(@@) بفتحهما وراء إلى عبد الدار بن قصي وبشين معجمة إلى عبد شرية رجل وبكاف إلى عبدك رجل وبلام إلى قرية عبد الله بواسط العراق وإلى عبد الله بطن من خولان وأبي عبد الله بن كرام رأس الكرامية.(@)(@@)(@@)(@@) $DIC_NIS$ العبدملكي (@)(@@) إلى عبد الملك بوزنه جد.(@)(@@)(@@)(@@) $DIC_NIS$ العبدوسي (@)(@@) بالفتح وضم المهملة آخره مهملة إلى عبدوس جد.(@)(@@)(@@)(@@) $DIC_NIS$ العبدوي (@)(@@) مثله إلى عبدويه جد. PageV01P174(@)(@@)(@@)(@@) $DIC_NIS$ العبدي (@)(@@) إلى عبد القيس من ربيعة بن نزار.(@)(@@)(@@)(@@) $DIC_NIS$ العبرتاي (@)(@@) بفتح أوله والباء والفوقية قبلها راء ساكنة إلى عبرتا قرية بنواحي النهروان.(@)(@@)(@@)(@@) $DIC_NIS$ العبري (@)(@@) بالضم والسكون إلى عبرة بطن من الأزد.(@)(@@)(@@)(@@) $DIC_NIS$ العبسي (@)(@@) بالفتح والسكون إلى عبس بطن من غطفان ومن الأزد ومن مراد.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: العبسقاني (@)(@@) بالفتح والسكون إلى عبسقان قرية بمالين انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ العبشمي (@)(@@) بفتح أوله والمعجمة إلى عبد شمس بن عبد مناف وعبد شمس بن سعد بن زيد مناة.(@)(@@)(@@)(@@) $DIC_NIS$ العبقري (@)(@@) بفتح أوله والقاف 
ms108	 وراء إلى عبقر بطن من بجيلة.(@)(@@)(@@)(@@) $DIC_NIS$ العبقسي (@)(@@) بوزنه إلى عبد القيس.(@)(@@)(@@)(@@) $DIC_NIS$ العبقي (@)(@@) بفتحتين وقاف إلى عبق جد وبلام إلى عبل بطن من رعين.(@)(@@)(@@)(@@) $DIC_NIS$ العبودي (@)(@@) بالفتح وضم الباء المشددة إلى عبود جد.(@)(@@)(@@)(@@) $DIC_NIS$ العبيدي (@)(@@) مصغرا إلى عبيد بن ثعلبة بطن من تميم وعبيد بن عدي بطن من الأنصار وعبيد بن عبرة بطن من الأزد وعبيد بن سلامة بطن من نهد.(@)(@@)(@@)(@@) || باب العين والتاء(@)(@@)(@@)(@@) $DIC_NIS$ العتابي (@)(@@) بالفتح وتشديد الفوقية إلى عتاب بن أسد بن أبي العيص بن أمية بن عبد شمس وعتاب بن سعيد بن زهير بن جشم والعتابيين محلة ببغداد ودار عتاب محلة.(@)(@@)(@@)(@@) $DIC_NIS$ العتائدي (@)(@@) بفتحتين وكسر التحتية ومهملة إلى عتائد.(@)(@@)(@@)(@@) $DIC_NIS$ العتبي (@)(@@) بالضم والسكون وموحدة إلى عتبة PageV01P175 ابن غزوان الصحابي وعتبة بن أبي سفيان.(@)(@@)(@@)(@@) $DIC_NIS$ العتري (@)(@@) بفتحتين وراء إلى عتر بطن من الأشعريين وبسكون الفوقية إلى عترة بطن من خزاعة وبالضم والفتح إلى عتر بطن من كلب وبالكسر والسكون إلى عترة بطن من بكر بن هوازن ومن بلي ومن هوازن.(@)(@@)(@@)(@@) $DIC_NIS$ العتقي (@)(@@) بالضم والفتح وقاف إلى العتقيين والعتقاء عدة قبائل.(@)(@@)(@@)(@@) $DIC_NIS$ العتكي (@)(@@) بفتحتين إلى العتيك بطن من الأزد.(@)(@@)(@@)(@@) $DIC_NIS$ العتواري (@)(@@) بالضم والسكون وراء آخره إلى عتوارة بطن من كنانة.(@)(@@)(@@)(@@) $DIC_NIS$ العتودي (@)(@@) بالفتح والضم آخره دال مهملة إلى عتود بطن من طيء.(@)(@@)(@@)(@@) $DIC_NIS$ العتيقي (@)(@@) بالفتح والكسر آخره قاف إلى عتيق جد.(@)(@@)(@@)(@@) || باب العين والثاء(@)(@@)(@@)(@@) $DIC_NIS$ العثري (@)(@@) بفتح أوله والمثلثة وراء إلى عثر مدينة باليمن وبسكون المثلثة إلى عثر مدينة باليمن أيضا.(@)(@@)(@@)(@@) $DIC_NIS$ العثماني (@)(@@) إلى عثمان بن عفان رضي الله تعالى عنه نسبا أو ولاء.(@)(@@)(@@)(@@) $DIC_NIS$ العثمي (@)(@@) بالفتح والسكون إلى عثم جد وبطن من جهينة.(@)(@@)(@@)(@@) || باب العين والجيم(@)(@@)(@@)(@@) $DIC_NIS$ العجبي (@)(@@) بفتحتين وموحدة إلى عجب جد.(@)(@@)(@@)(@@) $DIC_NIS$ العجردي (@)(@@) بفتح أوله والراء وسكون الجيم آخره مهملة إلى طائفة من الخوارج رأسهم عبد الكريم بن عجرد.(@)(@@)(@@)(@@) $DIC_NIS$ العجرمي (@)(@@) بوزنه إلى عجرم جد.(@)(@@)(@@)(@@) $DIC_NIS$ العجسي (@)(@@) بالفتح وتشديد الجيم المفتوحة ومهملة إلى عجس قرية بعسقلان.(@)(@@)(@@)(@@) $DIC_NIS$ العجلي (@)(@@) بفتحتين إلى عمل العجل التي تجرها الدواب 
ms109	 وبالكسر والسكون إلى عجل بن بكر بن وائل.(@)(@@)(@@)(@@) $DIC_NIS$ العجمي (@)(@@) بفتحتين إلى العجم وبلاد فارس ومن لسانه لا يحسن العربية.(@)(@@)(@@)(@@) $DIC_NIS$ العجنسي (@)(@@) بفتح أوله والجيم والنون المشددة ومهملة إلى عجنس جد.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: العجيسي (@)(@@) بالفتح والكسر وتحتية ومهملة إلى عجيس قبيلة من البربر انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ العجوزي (@)(@@) بالزاي إلى أبي العجوز جد.(@)(@@)(@@)(@@) $DIC_NIS$ العجلاني (@)(@@) بالفتح والسكون إلى بني العجلان بطن من الأنصار.(@)(@@)(@@)(@@) || باب العين والدال(@)(@@)(@@)(@@) $DIC_NIS$ العداس والعدسي(@)(@@) بفتحتين إلى العدس المعروف. PageV01P176(@)(@@)(@@)(@@) $DIC_NIS$ العدبسي (@)(@@) بفتح أوله والمهملة والموحدة المشددة ومهملة إلى عدبس جد.(@)(@@)(@@)(@@) $DIC_NIS$ العدثاني (@)(@@) بالضم والسكون ومثلثة إلى عدثان بطن من الأزد.(@)(@@)(@@)(@@) $DIC_NIS$ العدني (@)(@@) بالفتح والسكون إلى عمل البرد بنيسابور وبفتحتين إلى عدن مدينة باليمن.(@)(@@)(@@)(@@) $DIC_NIS$ العدواني (@)(@@) بالفتح والسكون إلى عدوان قبيلة من قيس عيلان.(@)(@@)(@@)(@@) $DIC_NIS$ العدوي (@)(@@) بفتحتين إلى عدي بن كعب بن لؤي بن غالب وعدي بن عبد مناة بن أد بن طابخة وعدي بن عمرو بن ملك بطن من الأنصار وعدي بن النجار منهم وعدي بن عمرو بن ربيعة بطن من خزاعة وعدي بن أخرم بطن من طيء وعدي بن أفلت منهم وعدي بن أسامة بطن من تغلب وعدي بن ربيعة بطن من كندة وعدي بن جناب بطن من كلب وعدي بن حنيفة وعدي بن جندب بطن من تميم قلت: وإلى العدوية قرية بمصر انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ العديسي (@)(@@) بالتصغير إلى عديس لقب.(@)(@@)(@@)(@@) || باب العين والذال(@)(@@)(@@)(@@) $DIC_NIS$ العذاري (@)(@@) بالكسر ومعجمة إلى عذار جد.(@)(@@)(@@)(@@) $DIC_NIS$ العذري (@)(@@) بفتح أوله والمعجمة إلى عذر بطن من الأشعريين وبالضم والسكون إلى عذرة قبيلة من قضاعة.(@)(@@)(@@)(@@) || باب العين والراء(@)(@@)(@@)(@@) $DIC_NIS$ العرابي (@)(@@) بالفتح وتخفيف الراء وموحدة إلى عرابة جد قلت: وبتشديد الراء إلى عرابة قرية من الشام انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ العرادي (@)(@@) إلى عمل العرادة التي ترمى بها الحجارة إلى الحصون.(@)(@@)(@@)(@@) $DIC_NIS$ العرافي (@)(@@) بالفتح والتشديد وفاء وبالكسر والتخفيف وقاف إلى العراق المشهور.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: العرباني (@)(@@) بفتحتين وموحدة إلى عربان بلد بالخابور انتهى. PageV01P177(@)(@@)(@@)(@@) $DIC_NIS$ العرجي (@)(@@) بالفتح والسكون وجيم إلى العرج موضع بمكة شرفها الله.(@)(@@)(@@)(@@) $DIC_NIS$ العرزبي (@)(@@) بالفتح والسكون وفتح الزاي 
ms110	 وموحدة إلى عزرب جد وبالميم آخره إلى عرزم بطن من فزارة.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: العرشاني (@)(@@) إلى عرشان بلد باليمن انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ العرضي (@)(@@) بالضم والسكون ومعجمة إلى عرض ناحية بدمشق.(@)(@@)(@@)(@@) $DIC_NIS$ العرفطي (@)(@@) بضم أوله والفاء إلى عرفطة جد.(@)(@@)(@@)(@@) $DIC_NIS$ العرفي (@)(@@) بفتحتين وفاء إلى عرفات شرفها الله تعالى وبالكسر والسكون وقاف إلى عرقة بلد بالشام وعرق رجل.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: العرماني (@)(@@) بالفتح وتشديد الراء إلى عرمان قرية بصرخد انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ العرني (@)(@@) بالضم والفتح ونون إلى عرينة بطن من بجيلة.(@)(@@)(@@)(@@) $DIC_NIS$ العرواني (@)(@@) بالضم والسكون إلى عروان من كندة.(@)(@@)(@@)(@@) $DIC_NIS$ العروضي (@)(@@) إلى علم العروض.(@)(@@)(@@)(@@) $DIC_NIS$ العريبي (@)(@@) بالتصغير وموحدة إلى عريب رجل.(@)(@@)(@@)(@@) $DIC_NIS$ العريجي (@)(@@) بوزنه وجيم إلى عريج من كنانة ومن جمح.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: العريشي (@)(@@) بالفتح والكسر إلى العريش موضع بناحية الشام انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ العريفي (@)(@@) بالفتح والكسر وفاء إلى عريف بن جشم وبالتصغير إلى عريف بطن من الصدف.(@)(@@)(@@)(@@) $DIC_NIS$ العريني (@)(@@) بوزنه ونون إلى عرين بطن من قضاعة ومن تميم.(@)(@@)(@@)(@@) || باب العين والزاي(@)(@@)(@@)(@@) $DIC_NIS$ العزازي (@)(@@) بالفتح وتخفيف الزاي الأولى إلى عزاز قلعة قرب حلب. PageV01P178(@)(@@)(@@)(@@) $DIC_NIS$ العزاقري (@)(@@) بفتح أوله والزاي وكسر القاف وراء إلى جعفر بن أبي العزاقر صاحب التناسخ.(@)(@@)(@@)(@@) $DIC_NIS$ العزري (@)(@@) بالفتح وسكون الزاي وراء إلى باب عزرة محلة بنيسابور.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: العزفي (@)(@@) بفتحتين وفاء.. انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ العزوري (@)(@@) بفتح أوله والواو بينهما زاي ساكنة آخره راء إلى عزورة جد.(@)(@@)(@@)(@@) $DIC_NIS$ العزيزي (@)(@@) بالتصغير آخره راء إلى عزير المختلف في نبوته وصاحب الغريب إلى أبيه ومن قاله بزاءين أخطأ قلت: بل أصاب وجزم به الداقطني وابن ماكولا وغيرهما.(@)(@@)(@@)(@@) || باب العين والسين(@)(@@)(@@)(@@) $DIC_NIS$ العسال (@)(@@) إلى بيع العسل.(@)(@@)(@@)(@@) $DIC_NIS$ العساني (@)(@@) بالضم وتحفيف المهملة ونون إلى عسان بطن من الصدف قلت: وبالفتح والتشديد إلى عسان قرية بحلب انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ العسقلاني (@)(@@) بفتح أوله والقاف إلى عسقلان مدينة من فلسطين.(@)(@@)(@@)(@@) $DIC_NIS$ العسكري (@)(@@) بفتح أوله والكاف وراء إلى عسكر مكرم مدينة بالأهواز وإلى عسكر مصر قلت: هي خطة بها انتهى وعسكر سر من رأى وعسكر المهدي.(@)(@@)(@@)(@@) $DIC_NIS$ العسيلي (@)(@@) بالتصغير ولام إلى عسيل بطن من سامة بن 
ms111	 لؤي.(@)(@@)(@@)(@@) || باب العين والشين(@)(@@)(@@)(@@) $DIC_NIS$ العشاري (@)(@@) بالضم وتخفيف المعجمة وراء أبو طالب كان جده طويلا فلقب به.(@)(@@)(@@)(@@) $DIC_NIS$ العشي (@)(@@) بالضم والتشديد إلى عش بطن من قضاعة.(@)(@@)(@@)(@@) || باب العين والصاد(@)(@@)(@@)(@@) $DIC_NIS$ العصاب (@)(@@) بالتشديد. PageV01P179(@)(@@)(@@)(@@) $DIC_NIS$ العصار (@)(@@) إلى عصر الدهن.(@)(@@)(@@)(@@) $DIC_NIS$ العصاري (@)(@@) إلى العصار.(@)(@@)(@@)(@@) $DIC_NIS$ العصائدي (@)(@@) بالدال المهملة إلى عمل العصيدة.(@)(@@)(@@)(@@) $DIC_NIS$ العصبي (@)(@@) بفتحتين وموحدة إلى عصبة بطن من قضاعة ومن تميم والعصب جد.(@)(@@)(@@)(@@) $DIC_NIS$ العصري (@)(@@) بوزنه إلى عصر بطن من عبد القيس ومن طيء وبسكون الصاد إلى عصر بطن من بلي.(@)(@@)(@@)(@@) $DIC_NIS$ العصفري (@)(@@) بضم أوله والفاء إلى العصفر المعروف.(@)(@@)(@@)(@@) $DIC_NIS$ العصفوري (@)(@@) بضمهما إلى عصفور رجل.(@)(@@)(@@)(@@) $DIC_NIS$ العصمي (@)(@@) بالضم والسكون إلى عصم جد.(@)(@@)(@@)(@@) || باب العين والطاء(@)(@@)(@@)(@@) $DIC_NIS$ العطار (@)(@@) إلى بيع العطر والطيب.(@)(@@)(@@)(@@) $DIC_NIS$ العطاردي (@)(@@) بالضم إلى عطارد جد وبطن من تميم.(@)(@@)(@@)(@@) $DIC_NIS$ العطشي (@)(@@) بفتحتين ومعجمة إلى سوق العطش موضع ببغداد.(@)(@@)(@@)(@@) $DIC_NIS$ العطوفي (@)(@@) بالفتح والضم وفاء إلى عطوف.(@)(@@)(@@)(@@) $DIC_NIS$ العطوي (@)(@@) بفتحتين إلى عطية جد وعطية بن الأسود اليمامي رأس العطوية من الخوارج.(@)(@@)(@@)(@@) || باب العين والفاء(@)(@@)(@@)(@@) $DIC_NIS$ العفصي (@)(@@) بالفتح وسكون الفاء ومهملة إلى العفص المعروف.(@)(@@)(@@)(@@) || باب العين والقاف(@)(@@)(@@)(@@) $DIC_NIS$ العقابي (@)(@@) بالضم وقاف وموحدة إلى عقاب بطن من حضرموت.(@)(@@)(@@)(@@) $DIC_NIS$ العقبي (@)(@@) بفتحتين إلى بيعة العقبة وعقبة وراء نهر عيسى ببغداد وبكسر القاف إلى عقب بطن من كنانة قلت: وبالضم والسكون إلى منية عقبة انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ العقدي (@)(@@) بفتحتين ودال مهملة إلى عقد بطن من بجيلة وقيل من قيس وبالضم والفتح إلى عقدة جد قال ابن الأثير المعروف سكون القاف وبسكون القاف إلى عقدة بطن من طيء ومن باهلة.(@)(@@)(@@)(@@) $DIC_NIS$ العقرقوفي (@)(@@) بفتحتين وسكون الراء وضم القاف الثانية آخره فاء إلى عقرقوف قرية قرب بغداد. PageV01P180(@)(@@)(@@)(@@) $DIC_NIS$ العقري (@)(@@) بفتحتين وراء إلى عقر قري بالرملة وبسكون القاف إلى عقر قرية على طريق بغداد إلى الدسكرة.(@)(@@)(@@)(@@) $DIC_NIS$ العقفاني (@)(@@) بالضم والسكون وفتح الفاء إلى عقفان بطن من يربوع.(@)(@@)(@@)(@@) $DIC_NIS$ العقيلي (@)(@@) مكبرا إلى عقيل بن أبي طالب ومصغرا إلى عقيل بن كعب بن ربيعة بن عامر بن صعصعة قلت: وإلى عقيل قرية بحوران انتهى. 
ms112	(@)(@@)(@@)(@@) || باب العين والكاف(@)(@@)(@@)(@@) $DIC_NIS$ العكاشي (@)(@@) بالضم والتشديد إلى عكاشة بن محصن.(@)(@@)(@@)(@@) $DIC_NIS$ العكاوي (@)(@@) بوزنه إلى عكا مدينة بساحل الشام.(@)(@@)(@@)(@@) $DIC_NIS$ العكبري (@)(@@) بالضم والسكون وفتح الموحدة وراء إلى عكبرا بلد على دجلة فوق بغداد.(@)(@@)(@@)(@@) $DIC_NIS$ العكبي (@)(@@) بالكسر والفتح وتشديد الموحدة إلى عكب بن أسد بن الحارث بن العتيك.(@)(@@)(@@)(@@) $DIC_NIS$ العكلي (@)(@@) بالضم والسكون إلى عكل بطن من تميم قال ابن الأثير بل أمة لامرأة من حمير.(@)(@@)(@@)(@@) $DIC_NIS$ العكي (@)(@@) بالفتح والتشديد إلى عك ين عدنان أخي معد وإلى عكا السابقة أيضا.(@)(@@)(@@)(@@) || باب العين واللام(@)(@@)(@@)(@@) $DIC_NIS$ قلت: العلثي (@)(@@) بالفتح والسكون ومثلثة إلى علث قرية بين عكبرا وسامرا انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ العلفي (@)(@@) بالضم وتشديد اللام المفتوحة وفاء إلى علفة بطن من قيس بفتحتين وقاف إلى علقة بطن من بجيلة.(@)(@@)(@@)(@@) $DIC_NIS$ العلكي (@)(@@) بالفتح والشتديد إلى علك جد.(@)(@@)(@@)(@@) $DIC_NIS$ العلمي (@)(@@) بفتحتينن إلى علم جد.(@)(@@)(@@)(@@) $DIC_NIS$ العلوي (@)(@@) إلى علي بن أبي طالب رضي الله تعالى عنه وبني علي بطن من الأزد وبضم اللام المشددة إلى علويه.(@)(@@)(@@)(@@) $DIC_NIS$ العلياني (@)(@@) بالفتح والسكون وتحتية إلى عليان بطن من همدان.(@)(@@)(@@)(@@) $DIC_NIS$ العليجي (@)(@@) بالفتح والكسر وتحتية وجيم إلى عليجة تصغير علي. PageV01P181(@)(@@)(@@)(@@) $DIC_NIS$ العليصي (@)(@@) بالضم والفتح والسكون ومهملة إلى عليص بن صمصم بن عدي.(@)(@@)(@@)(@@) $DIC_NIS$ العليمي (@)(@@) بوزنه إلى عليم بطن من كلب ومن باهلة وجد.(@)(@@)(@@)(@@) $DIC_NIS$ العلي (@)(@@) بالضم والتخفيف إلى علة بطن ن مذحج وبالكسر والتشديد إلى علة بطن من قضاعة.(@)(@@)(@@)(@@) || باب العين والميم(@)(@@) : بالفتح والتشديد إلى عمار جد.(@)(@@)(@@)(@@) $DIC_NIS$ العماني (@)(@@) بوزنه إلى عمان مدينة البلقاء بالشام وبالضم والتخفيف إلى عمان قرية تحت البصرة.(@)(@@)(@@)(@@) $DIC_NIS$ العمائمي (@)(@@) إلى العمامة المعروفة.(@)(@@)(@@)(@@) $DIC_NIS$ العمراني (@)(@@) بالكسر والسكون إلى العمرانية ناحية بالموصل.(@)(@@)(@@)(@@) $DIC_NIS$ العمروسي (@)(@@) بالفتح والسكون وضم الراء آخره مهملة إلى عمروس جد.(@)(@@)(@@)(@@) $DIC_NIS$ العمري (@)(@@) بالفتح والسكون إلى عمرو بن عامر بن ربيعة وعمرو بن عوف بطن من الأنصار وعمرو بن الخزرج منهم وعمرو بن أسد من الأزد وعمرو بن عبيد المعتزلي وإلى قراءة أبي عمرو وبالضم والفتح إلى عمر بن الخطاب وعمر بن علي بن أبي طالب رضي الله 
ms113	 عنهم قلت: وإلى العمرية محلة ببغداد انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ العميري (@)(@@) مكبرا إلى عميرة بطن من ربيعة.(@)(@@)(@@)(@@) $DIC_NIS$ العمي (@)(@@) بالفتح والتشديد إلى العم بطن من تميم أما زيد العمي فلقب به لأنه كان يسأل عن الشيء فيقول حتى أسأل عمي.(@)(@@)(@@)(@@) || باب العين والنون(@)(@@)(@@)(@@) $DIC_NIS$ العنابي (@)(@@) بالضم وتشديد النون إلى العناب المعروف.(@)(@@)(@@)(@@) $DIC_NIS$ العنبري (@)(@@) بفتح العين والموحدة بينهما نون ساكنة إلى العنبر بن عمرو بن تميم وعنبر جد.(@)(@@)(@@)(@@) $DIC_NIS$ العنبي (@)(@@) بالكسر وفتح النون إلى العنب المعروف.(@)(@@)(@@)(@@) $DIC_NIS$ العنتري (@)(@@) بفتح أوله والفوقية ثالثة إلى عنترة جد. PageV01P182(@)(@@)(@@)(@@) $DIC_NIS$ العنزي (@)(@@) بفتحتين وزاي إلى عنزة بن أسد بن ربيعة بن نزار بن معد بن عدنان وبسكون النون إلى عنز بن وائل أخي بكر بن وائل وبه بسين مهملة إلى عنس حي من مذحج.(@)(@@)(@@)(@@) $DIC_NIS$ العنقزي (@)(@@) بفتح أوله والقاف وزاي إلى العنقز وهو الريحان.(@)(@@)(@@)(@@) $DIC_NIS$ العنيني (@)(@@) بالضم وفتح النون الأولى إلى عنين بطن من طيء.(@)(@@)(@@)(@@) || باب العين والواو(@)(@@)(@@)(@@) $DIC_NIS$ العودمي (@)(@@) بالضم وفتح المهملة.(@)(@@)(@@)(@@) $DIC_NIS$ العوذي (@)(@@) بالفتح والسكون معجمة إلى عوذ بطن من الأزد.(@)(@@)(@@)(@@) $DIC_NIS$ العوسجي (@)(@@) بفتح أوله والمهملة وجيم إلى عوسجة جد.(@)(@@)(@@)(@@) $DIC_NIS$ العوصي (@)(@@) بالفتح والسكون ومهملة إلى عوص بطن من كلب وبالفاء إلى عبد الرحمن بن عوف وإلى عوف بن سعد بطن من قيس عيلان وآخر من ذبيان وبالنون إلى عون وبالهاء إلى عوه بطن.(@)(@@)(@@)(@@) $DIC_NIS$ العوقي (@)(@@) بفتحتين وقاف إلى العوقة بطن من عبد القيس ومحلة لهم بالبصرة.(@)(@@)(@@)(@@) $DIC_NIS$ العوني العوهي:(@)(@@) بالفتح والتشديد إلى العوة بطن من سامة بن لؤي مجد.(@)(@@)(@@)(@@) || باب العين واللام ألف(@)(@@)(@@)(@@) $DIC_NIS$ العلاثي (@)(@@) بالضم آخره مثلثة إلى علاثة رجل.(@)(@@)(@@)(@@) $DIC_NIS$ العلاطي (@)(@@) بالكسر إلى علاط رجل.(@)(@@)(@@)(@@) $DIC_NIS$ العلاف (@)(@@) إلى بيع العلف.(@)(@@)(@@)(@@) $DIC_NIS$ العلاقي (@)(@@) بالكسر وقاف إلى بني علاقة.(@)(@@)(@@)(@@) $DIC_NIS$ العلالي (@)(@@) بالضم أي علالة جد بالفتح والتشديد إلى علان وأبي علانة وأبي جهل رجل العلاني: بالفتح إلى سكة العلاء ببخارى.(@)(@@)(@@)(@@) || باب العين والياء(@)(@@)(@@)(@@) $DIC_NIS$ العيابي (@)(@@) بالفتح آخره موحدة إلى عيابة بن عامر بن زيد بن عدوان.(@)(@@)(@@)(@@) $DIC_NIS$ العياضي (@)(@@) بالكسر ومعجمة إلى عياض جد. PageV01P183(@)(@@)(@@)(@@) $DIC_NIS$ العيداني 
ms114	 (@)(@@) بالفتح والسكون ومهملة ونون إلى عيدان بطن من حضرموت.(@)(@@)(@@)(@@) $DIC_NIS$ العيذي (@)(@@) بالفتح والسكون ومعجمة إلى عيذ الله بن سعد العشيرة من مذحج.(@)(@@)(@@)(@@) $DIC_NIS$ العيشوني (@)(@@) بالفتح وضم المعجمة إلى عيشون رجل.(@)(@@)(@@)(@@) $DIC_NIS$ العيشي (@)(@@) بالفتح إلى عائشة الصديقة وبني عائش بن مالك بن تيم الله وبالكسر إلى عيش بطن من حرام ومن سعد هذيم ومن مزينة ومن أشجع ومن قضاعة.(@)(@@)(@@)(@@) $DIC_NIS$ العين زربي:(@)(@@) بفتح الزاي وسكون الراء وموحدة إلى عين زربى بلد قرب طرسوس.(@)(@@)(@@)(@@) $DIC_NIS$ العينوتي (@)(@@) بالفتح والسكون وضم النون الأولى إلى عينون قرية بالقدس.(@)(@@)(@@)(@@) $DIC_NIS$ العيني (@)(@@) بالفتح إلى عين التمر بلد بالحجاز قلت: وإلى عين تاب قلعة بين حلب وأنطاكية وإلى عين توماء قرية بدمشق انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ العيلاني (@)(@@) بالفتح والسكون إلى قيس عيلان بن مضر.(@)(@@)(@@)(@@) | حرف الغين المعجمة(@)(@@)(@@)(@@) || باب الغين والألف(@)(@@)(@@)(@@) $DIC_NIS$ الغابي (@)(@@) كالقاضي قلت: إما إلى غاب موضع باليمن أو إلى غابة موضع قرب المدينة انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الغاتفري (@)(@@) بفتح الفوقية وسكون الفاء وراء إلى غاتفر محلة بسمرقند قلت: قال باقوت: بنون ساكنة وفاء مفتوحة انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الغازي (@)(@@) إلى الغزو وإلى الغز جد.(@)(@@)(@@)(@@) $DIC_NIS$ الغاضري (@)(@@) بمعجمة وراء إلى غاضرة بن ملك بن ثعلبة وغاضرة بطن من خزاعة.(@)(@@)(@@)(@@) $DIC_NIS$ الغافري (@)(@@) بكسر الفاء إلى غافر بطن من سامراء بن لؤي.(@)(@@)(@@)(@@) $DIC_NIS$ الغافقي (@)(@@) بفاء وقاف إلى غافق من الأزد قلت: وحصن بالأندلس انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الغالي (@)(@@) إلى الغلو وغالية أم.(@)(@@)(@@)(@@) $DIC_NIS$ العامدي (@)(@@) بكسر الميم ومهملة إلى غامد بطن من الأزد.(@)(@@)(@@)(@@) $DIC_NIS$ الغانمي (@)(@@) بوزنه إلى غانم جد.(@)(@@)(@@)(@@) || باب الغين والباء (@)PageV01P184(@)(@@)(@@)(@@) $DIC_NIS$ الغبابي (@)(@@) بالضم وتخفيف الموحدة الأولى إلى غباب لقب ثعلبة بن الحارث بن تيم الله.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الغباغبي (@)(@@) إلى غباغب قرية بحوران انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الغبري (@)(@@) بالضم وفتح الموحدة وراء إلى غبر بطن من يشكر.(@)(@@)(@@)(@@) || باب الغين والثاء(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الغثوي (@)(@@) بمثلثة إلى الغثاة قرية بحوران انتهى.(@)(@@)(@@)(@@) || باب الغين والجيم(@)(@@)(@@)(@@) $DIC_NIS$ الغجدواني (@)(@@) بالضم وسكون الجيم وفتح المهملة والواو إلى غجدوان قرية ببخارى.(@)(@@)(@@)(@@) || باب الغين والدال(@)(@@)(@@)(@@) $DIC_NIS$ الغداني (@)(@@) بالضم وتخفيف المهملة إلى غدانة بن يربوع بن حنظلة.(@)(@@)(@@)(@@) || باب 
ms115	 الغين والذال(@)(@@)(@@)(@@) $DIC_NIS$ الغذاني (@)(@@) بفتح المعجمتين إلى غذانة قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الغذاوذي (@)(@@) بالضم ومعجمتين وفتح الواو إلى غذاوذ محلى بسمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ الغذشفردري (@)(@@) بالضم وفتح الذال المعجمة والفاء والدال المهملة وسكون الراء قبلها والشين المعجمة آخره راء غذشفردر قرية ببخارى.(@)(@@)(@@)(@@) || باب الغين والراء(@)(@@)(@@)(@@) $DIC_NIS$ الغراء (@)(@@) إلى عمل الغراء.(@)(@@)(@@)(@@) $DIC_NIS$ الغرابي (@)(@@) إلى غراب بلفظ الطائر بطن من فزارة والغرابية من الشيعة.(@)(@@)(@@)(@@) $DIC_NIS$ الغراد (@)(@@) إلى عمل الحائط القصب.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الغرافي (@)(@@) بالفتح والتشديد وفاء إلى الغراف نهر تحت واسط عليه قرى كبيرة الغربي بفتحتين وموحدة إلى باب الغربة محلة بغداد انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الغربي (@)(@@) بالفتح والسكون وكسر المهملة وتحتية إلى غرديان قرية بما وراء النهر.(@)(@@)(@@)(@@) $DIC_NIS$ الغرزي (@)(@@) بفتحتين وزاي إلى غرزة جد أحمد بن حازم.(@)(@@)(@@)(@@) $DIC_NIS$ الغرقي (@)(@@) يالفتح والسكون وقاف إلى غرق قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الغرمينوي (@)(@@) بالضم والسكون والكسر وتحتية ونون مفتوحة إلى غرمينوى من رستاق سمرقند. PageV01P185(@)(@@)(@@)(@@) $DIC_NIS$ الغرناطي (@)(@@) بالفتح والسكون إلى غرناطة مدينة بالغرب.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الغروي (@)(@@) إلى الغرية قرية بدمشق انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الغريري (@)(@@) بالتصغير وراء إلى غرير بن المغيرة بن حميد بن عبد الرحمن بن عوف.(@)(@@)(@@)(@@) || باب الغين والزاي(@)(@@)(@@)(@@) $DIC_NIS$ الغزاء (@)(@@) إلى كثرة الغزو.(@)(@@)(@@)(@@) $DIC_NIS$ الغزالي (@)(@@) بالتشديد إلى الغزل كالغزال وقيل: هو بالتخفيف إلى غزالة قرية بطوس.(@)(@@)(@@)(@@) $DIC_NIS$ الغرقي (@)(@@) بفتح المعجمتين وقاف إلى غرق قرية بفرغانة.(@)(@@)(@@)(@@) $DIC_NIS$ الغزنوي (@)(@@) بفتح أوله والنون إلى غرنة مدينة بالهند.(@)(@@)(@@)(@@) $DIC_NIS$ الغزنياني (@)(@@) بفتح أوله والنون الأولى والتحتية إلى غزنيا قرية بما وراء النهر.(@)(@@)(@@)(@@) $DIC_NIS$ الغزوي (@)(@@) بفتحتين إلى غزية قبيلة من طيء وفخذ من هوازن.(@)(@@)(@@)(@@) $DIC_NIS$ الغزينزي (@)(@@) بالفتح والكسر وتحتية ساكنة ونون مكسورة وزاي إلى غزينز قرية بخوارزم.(@)(@@)(@@)(@@) $DIC_NIS$ الغزيلي (@)(@@) بالضم والفتح كسر التحتية المشددة إلى غزيل بطن من مراد.(@)(@@)(@@)(@@) $DIC_NIS$ الغزي (@)(@@) بالفتح والتشديد إلى غزة مدينة بالشام.(@)(@@)(@@)(@@) || باب الغين والسين(@)(@@) </span>(@)(@@)(@@)(@@) $DIC_NIS$ الغساني (@)(@@) بالفتح والتشديد إلى غسان قبيلة من الأزد وجد وغسان رأس الغسانية من المرجئة وبضم أوله إلى غسان بن جذام بن العدف.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الغسولي (@)(@@) إلى الغسولة قرية بدمشق انتهى.(@)(@@)(@@)(@@) || باب الغين والسين(@)PageV01P186(@)(@@)(@@)(@@) $DIC_NIS$ الغسيلي 
ms116	 (@)(@@) بالفتح والكسر إلى حنظلة بن أبي عامر غسيل الملائكة.(@)(@@)(@@)(@@) $DIC_NIS$ الغشتي (@)(@@) بالفتح وسكون المعجمة وفوقية الغشراني بالضم والسكون ودال مهملة إلى غشدان قرية بسمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ الغشيدي (@)(@@) بالفتح والكسر ودال مهملة إلى غشيدا قرية ببخارى.(@)(@@)(@@)(@@) || باب الغين والضاد(@)(@@)(@@)(@@) $DIC_NIS$ الغضائري (@)(@@) بضاد معجمة وراء إلى الغضار وهو الإناء الذي يؤكل فيه.(@)(@@)(@@)(@@) $DIC_NIS$ الغضبي (@)(@@) بالفتح والسكون وموحدة إلى غضب بطن من الأنصار ومن سليم.(@)(@@)(@@)(@@) $DIC_NIS$ الغضنفري (@)(@@) بفتح المعجمتين والفاء وسكون النون آخره راء إلى الغضنفر جد.(@)(@@)(@@)(@@) $DIC_NIS$ الغضيضي (@)(@@) بالفتح وكسر المعجمة الأولى إلى غضيض رجل.(@)(@@)(@@)(@@) || باب الغين والطاء(@)(@@)(@@)(@@) $DIC_NIS$ الغطريفي (@)(@@) بكسر أوله والراء آخره فاء إلى الغطريف جد.(@)(@@)(@@)(@@) $DIC_NIS$ الغطفاني (@)(@@) بفتحات وفاء إلى غطفان قبيلة كبيرة من قيس عيلان وبطن من جهينة ومن جذام. PageV01P187(@)(@@)(@@)(@@) $DIC_NIS$ الغطيفي (@)(@@) مصغرا إلى غطيف بطن من مراد.(@)(@@)(@@)(@@) || باب الغين والفاء(@)(@@)(@@)(@@) $DIC_NIS$ الغفاري (@)(@@) بالكسر وتخفيف الفاء وراء إلى غفار بن مليك بن ضمرة بن بكر بن عبد مناة بن كنانة.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: العفجموني (@)(@@) إلى غفجمون قبيلة من البربر بالمغرب انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الغفيلي (@)(@@) بالضم وفتح الفاء وسكون التحتية ولام إلى غفيلة بطن من السكون ومن ربيعة وجد.(@)(@@)(@@)(@@) || باب الغين واللام(@)(@@)(@@)(@@) $DIC_NIS$ الغلبوني (@)(@@) بالفتح وسكون اللام وضم الموحدة إلى غلبون جد.(@)(@@)(@@)(@@) $DIC_NIS$ الغلطاني (@)(@@) بالضم والسكون إلى غلطان قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الغلفي (@)(@@) الضم والسكون.(@)(@@)(@@)(@@) $DIC_NIS$ الغليمي (@)(@@) مصغرا إلى غليم بن سام بن نوح.(@)(@@)(@@)(@@) $DIC_NIS$ الغلي (@)(@@) بالضم والتشديد إلى الغل.(@)(@@)(@@)(@@) $DIC_NIS$ الغلوي (@)(@@) بفتحتين إلى الغلي رجل.(@)(@@)(@@)(@@) || باب الغين والميم(@)(@@)(@@)(@@) $DIC_NIS$ الغمري (@)(@@) بالفتح والسكون وراء إلى الغمر بطن من غافق قلت: وإلى منية غمر قرية بمصر انتهى.(@)(@@)(@@)(@@) || باب الغين والنون(@)(@@)(@@)(@@) $DIC_NIS$ الغناجي (@)(@@) بالفتح والتشديد وجيم إلى غناج بلد بالشاش.(@)(@@)(@@)(@@) $DIC_NIS$ الغنادوستي (@)(@@) بفتحتين وضم المهملة وسكون الواو والسين المهملة وفوقية إلى غنادوست قرية بسرخس.(@)(@@)(@@)(@@) $DIC_NIS$ الغنثي (@)(@@) بالفتح والسكون ومثلثة إلى بطن من مالك بن كنانة. PageV01P188(@)(@@)(@@)(@@) $DIC_NIS$ الغنجيري (@)(@@) بالفتح والسكون وكسر الجيم وتحتية وراء إلى غنجير قرية بالسغد.(@)(@@)(@@)(@@) $DIC_NIS$ الغنداني (@)(@@) بالفتح والسكون ومهملة وموحدة إلى عنداب محلة بمرعينان.(@)(@@)(@@)(@@) $DIC_NIS$ الغندجاني (@)(@@) بالضم والسكون وفتح المهملة وجيم إلى 
ms117	 عندجان مدينة بالأهواز.(@)(@@)(@@)(@@) $DIC_NIS$ الغندروذي (@)(@@) بفتح أوله والدال المهملة وضم الراء آخره معجمة إلى غندروذ قرية بهراة.(@)(@@)(@@)(@@) $DIC_NIS$ الغندلي (@)(@@) بالضم والسكون وفتح الدال المهملة ولام إلى غندلك جد.(@)(@@)(@@)(@@) $DIC_NIS$ الغنفري (@)(@@) بفتح أوله والفاء وراء إلى غنفر جد.(@)(@@)(@@)(@@) $DIC_NIS$ الغنمي (@)(@@) بالفتح والسكون إلى غنم بطن من الأزد ومن الأنصار ومن بني أسد بن خزيمة ومن كندة ومن عبد القيس.(@)(@@)(@@)(@@) $DIC_NIS$ الغنوي (@)(@@) بفتحتين إلى غني بن أعصر(@)(@@)(@@)(@@) || باب الغين والواو(@)(@@)(@@)(@@) $DIC_NIS$ الغوبديني (@)(@@) بالضم وسكون الواو والموحدة وكسر المهملة إلى غوبدين قرية بنسف.(@)(@@)(@@)(@@) $DIC_NIS$ الغوثي (@)(@@) بالفتح والسكون ومثلثة إلى الغوث.(@)(@@)(@@)(@@) $DIC_NIS$ الغورجي (@)(@@) بالضم وفتح الراء وجيم إلى غورة قرية بهراة.(@)(@@)(@@)(@@) $DIC_NIS$ العورجكي (@)(@@) بفتح أوله والراء وسكون الواو والجيم إلى غورجك بلد بالسغد من سمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ الغورشكي (@)(@@) بوزنه إلى غورشك من نواحي سمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الغورواني (@)(@@) إلى غوران قرية بهراة انتهى. PageV01P189(@)(@@)(@@)(@@) $DIC_NIS$ الغوري (@)(@@) بالضم والسكون وراء إلى الغور بلاد بخراسان.(@)(@@)(@@)(@@) $DIC_NIS$ الغوزمي (@)(@@) بالضم وفتح الزاي إلى غوزم من نواحي هراة.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الغوسناني (@)(@@) إلى غوسنان قرية بهراة انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الغوطي (@)(@@) بالضم إلى غوطة دمشق.(@)(@@)(@@)(@@) || باب الغين واللام ألف(@)(@@)(@@)(@@) $DIC_NIS$ الغلابي (@)(@@) بالفتح والتخفيف وموحدة إلى غلاب جد أبي بكر محمد بن زكرياء شيخ الطبراني وبالتشديد إلى غلاب والد خالد بن غلاب الصحابي واسم أبيه الحارث.(@)(@@)(@@)(@@) $DIC_NIS$ الغلاظي (@)(@@) بالكسر ومعجمة إلى غلاظ.(@)(@@)(@@)(@@) || باب الغين والياء(@)(@@)(@@)(@@) $DIC_NIS$ الغياثي (@)(@@) بالكسر ومثلثة إلى غياث جد.(@)(@@)(@@)(@@) $DIC_NIS$ الغياني (@)(@@) بالفتح والتشديد ونون إلى غيان بطن من جهينة ومن الخزرج ومن خطمة.(@)(@@)(@@)(@@) $DIC_NIS$ الغيثي (@)(@@) إلى غيث بلفظ المطر بطن من عبس وبتشديد التحتية وكسرها إلى غيث بطن من طيء.(@)(@@)(@@)(@@) $DIC_NIS$ الغيري (@)(@@) بالكسر وفتح التحتية وراء إلى غيرة بطن من كنانة ومن بلي ومن ثقيف.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الغيزاني (@)(@@) بالكسر وزاي إلى غيزان قرية بهراة انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الغيشتي (@)(@@) بالكسر والسكون وفتح المعجمة وفوقية إلى غيشتا قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الغيفي (@)(@@) بالفتح والسكون وفاء إلى غيفة قرية قرب بلبيس بديار مصر قلت: وباللام إلى الغيل قرية باليمن انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الغيماني (@)(@@) بالفتح والسكون إلى غيمان من حمير. 
ms118	 PageV01P190(@)(@@)(@@)(@@) $DIC_NIS$ الغيلاني (@)(@@) بوزنه إلى غيلان جد أبي طالب راوي الغيلانيات وإلى غيلان بن دعمي بن إياد بن نزار بن معد وإلى غيلان القدري رأس الغيلانية.(@)(@@)(@@)(@@) | حرف الفاء(@)(@@)(@@)(@@) || باب الفاء والألف(@)(@@)(@@)(@@) $DIC_NIS$ الفابجاني (@)(@@) بفتح الموحدة والجيم إلى فابجان قرية بأصبهان ويقال فابزان.(@)(@@)(@@)(@@) $DIC_NIS$ الفاتني (@)(@@) بكسر الفوقية ونون إلى فاتن مولى المطيع نسب إليه مولاه بشرى الرومي.(@)(@@)(@@)(@@) $DIC_NIS$ الفاخراني (@)(@@) بكسر الخاء والفاخوري إلى بيع الفخار.(@)(@@)(@@)(@@) $DIC_NIS$ الفاداري (@)(@@) بدال مهمة وراء إلى فادار جد.(@)(@@)(@@)(@@) $DIC_NIS$ الفاذجاني (@)(@@) بفتح المعجمة وجيم إلى فاذجان قرية بأصبهان.(@)(@@)(@@)(@@) $DIC_NIS$ الفاذوني (@)(@@) بمعجمة مضمومة إلى فاذونة جد.(@)(@@)(@@)(@@) $DIC_NIS$ الفاذي (@)(@@) بها إلى فاذ جد.(@)(@@)(@@)(@@) $DIC_NIS$ الفارابي (@)(@@) براء وموحدة إلى فاراب مدينة فوق الشاش وبنون آخره إلى فاران جبال بالحجاز وقرية بسمرقند وإلى فاران بطن من قضاعة كما قال ابن الأثير ويتلو في القاراني: الفارزي: بكسر الراء وزاي إلى قصر فارزة محلة ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الفارجي (@)(@@) بسكون الراء وجيم إلى باب فارجك محلة ببخارى وبكسر الراء إلى فارج بطن من القين.(@)(@@)(@@)(@@) $DIC_NIS$ الفارسجيني (@)(@@) بكسر الراء والجيم وسكون المهملة بينهما إلى فارسجين بنواحي همدان.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الفارسكوري (@)(@@) إلى فارسكر بلد قرب دمياط انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الفارسي (@)(@@) إلى بلاد فارس. PageV01P191(@)(@@)(@@)(@@) $DIC_NIS$ الفارفاني (@)(@@) بسكون الراء وفاء ثانية إلى فارفان قرية بأصبهان.(@)(@@)(@@)(@@) $DIC_NIS$ الفارقي (@)(@@) بكسر الراء وقاف إلى ميافارقين.(@)(@@)(@@)(@@) $DIC_NIS$ الفارمذي (@)(@@) بفتح الراء والميم ومعجمة إلى فارمذ قرية بطوس.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الفاروثي (@)(@@) بمثلثة قرية على دجلة انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الفاروزي (@)(@@) بضم الراء آخره إلى فاروز قرية بنسا.(@)(@@)(@@)(@@) $DIC_NIS$ الفاروي (@)(@@) بضم الراء إلى فاروية سكة بنيسابور وفارو قرية بنسف.(@)(@@)(@@)(@@) $DIC_NIS$ الفاريابي (@)(@@) بفتح الراء والتحتية وموحدة والفريابي بكسر الفاء والفيريابي بلد بنواحي بلخ.(@)(@@)(@@)(@@) $DIC_NIS$ الفازي (@)(@@) بزاي إلى فاز قرية بطوس قلت: وأخرى بمرو انتهى وبالمهملة إلى فاس مدينة بالغرب.(@)(@@)(@@)(@@) $DIC_NIS$ الفاشاني (@)(@@) بمعجمة إلى فاشان قرية بمرو وبهراة أيضا.(@)(@@)(@@)(@@) $DIC_NIS$ الفاشوقي (@)(@@) بضم المعجمة وقاف إلى فاشوق قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الفاطمي (@)(@@) بكسر الطاء إلى سيدة نساء العالمين رضي الله تعالى عنها.(@)(@@)(@@)(@@) $DIC_NIS$ الفاغي (@)(@@) بمعجمة إلى فاغ قرية بسمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الفاقوسي (@)(@@) بمهملة إلى 
ms119	 فاقوس بلد بحوف مصر انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الفاكهي (@)(@@) إلى بيع الفاكهة.(@)(@@)(@@)(@@) $DIC_NIS$ الفالي (@)(@@) بلام إلى فالة بلد بفارس.(@)(@@)(@@)(@@) $DIC_NIS$ الفاميني (@)(@@) بكسر الميم إلى فامين قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الفامي (@)(@@) هو البقال وإلى فامية قرية بواسط وبالشام أيضا.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الفايائي (@)(@@) إلى فايا كورة بين حلب ومنبج انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الفائشي (@)(@@) بكسر التحتية ومعجمة إلى فائش بطن من همدان.(@)(@@)(@@)(@@) || باب الفاء والباء(@)(@@)(@@)(@@) $DIC_NIS$ الفبي (@)(@@) بضم الفاء وتشديد الموحدة إلى الفبين بطن من همدان ومحلة لهم بالكوفة.(@)(@@)(@@)(@@) || باب الفاء والتاء (@)PageV01P192(@)(@@)(@@)(@@) $DIC_NIS$ الفتياني (@)(@@) بالكسر وسكون الفوقية وفتح التحتية إلى فتيان بطن من بجيلة.(@)(@@)(@@)(@@) || باب الفاء والجيم(@)(@@)(@@)(@@) $DIC_NIS$ الفجكشي (@)(@@) إلى فجكش قرية بنيسابور.(@)(@@)(@@)(@@) || باب الفاء والحاء(@)(@@)(@@)(@@) $DIC_NIS$ الفحام (@)(@@) إلى بيع الفحم.(@)(@@)(@@)(@@) $DIC_NIS$ الفحلي (@)(@@) بالكسر وسكون المهملة ولام إلى فحل موضع بالشام.(@)(@@)(@@)(@@) || باب الفاء والدال(@)(@@)(@@)(@@) $DIC_NIS$ الفدكي (@)(@@) بفتحتين إلى فدك موضع قرب المدينة.(@)(@@)(@@)(@@) $DIC_NIS$ الفدوي (@)(@@) بالفتح وضم الدال المهملة الشديدة إلى فدويه جد.(@)(@@)(@@)(@@) $DIC_NIS$ الفديكي (@)(@@) مصغرا إلى فديك صحابي.(@)(@@)(@@)(@@) || باب الفاء والذال(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الفذاي (@)(@@) بمعجمة إلى فذايا قرية بدمشق انتهى.(@)(@@)(@@)(@@) || باب الفاء والراء(@)(@@)(@@)(@@) $DIC_NIS$ الفراء (@)(@@) إلى الفراء.(@)(@@)(@@)(@@) $DIC_NIS$ الفرابي (@)(@@) بفتحتين وموحدة إلى فراب قرية بسمرقند قلت: وبتشديد الراء إلى فراب قرية بأصبهان وبالضم والفوقية إلى الفرات النهر وجد.(@)(@@)(@@)(@@) $DIC_NIS$ الفراديسي (@)(@@) بفتحتين وكسر المهملة وسين كذلك إلى باب الفراديس بدمشق.(@)(@@)(@@)(@@) $DIC_NIS$ الفراسي (@)(@@) بالكسر وسين مهملة إلى فراس بن غنم بن كنانة قلت: وقرية بإفريقية انتهى.(@)(@@) وبالفتح والمعجمة إلى فراشة جد وفراشا قرية بين بغداد والحلة ودرب فراشا محلة ببغداد وبالنون والراء مخففة ومشددة إلى فران بطن من قضاعة.(@)(@@)(@@)(@@) $DIC_NIS$ الفراوي (@)(@@) بالضم إلى فراوة بلد قرب خوارزم.(@)(@@)(@@)(@@) $DIC_NIS$ الفراهيذي (@)(@@) بفتحتين وكسر الهاء وتحتية ساكنة ومعجمة إلى فراهيذ بطن من الأزد.(@)(@@)(@@)(@@) $DIC_NIS$ الفراهيناني (@)(@@) بالضم وكسر الهاء وتحتية ونون وألف إلى فراهينان قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الفرائضي والفرضي(@)(@@) إلى علم الفرائض.(@)(@@)(@@)(@@) $DIC_NIS$ الفربري (@)(@@) بفتحتين وسكون الموحدة وراء ثانية إلى فربر بلد قرب بخارى.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الفريباي (@)(@@) إلى فريبا بعسقلان انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الفرجي (@)(@@) بفتحتين وجيم إلى الفرج رجل قلت: PageV01P193 ومدينة بالأندلس انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ 
ms120	 [الفرجي] (@)(@@) وبسكون الراء إلى فرج قرية قلت: بفارس انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الفرجاي (@)(@@) بفتح أوله والجيم وبهمزة إلى فرجيا قرية بسمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ الفرخاني (@)(@@) بالفتح وضم الراء المشددة ومعجمة إلى فرخان جد.(@)(@@)(@@)(@@) $DIC_NIS$ الفرخشي (@)(@@) بفتحتين وسكون الخاء وشين معجمتين إلى فرخشة.(@)(@@)(@@)(@@) $DIC_NIS$ الفرخوزديزجي (@)(@@) بالفتح وسكون الراء والواو والزاي بعدها وضم الخاء المعجمة وكسر الدال المهملة وتحتية ساكنة وفتح الزاي وجيم إلى فرخوزديزة قرية بنسف.(@)(@@)(@@)(@@) $DIC_NIS$ الفرخي (@)(@@) بالفتح والسكون ومعجمة إلى فرخ جد.(@)(@@)(@@)(@@) $DIC_NIS$ الفرداجي (@)(@@) بالكسر والسكون ومهملة وجيم إلى فرداج جد.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الفردجاني (@)(@@) إلى فردجان قلعة بهمذان انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الفرددي (@)(@@) بفتح أوله والمهملة الأولى والراء ساكنة إلى فردد قرية بسمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ الفردمي (@)(@@) بوزنه إلى بني الفردم بطن من تجيب.(@)(@@)(@@)(@@) $DIC_NIS$ الفرزاميثني (@)(@@) بالفتح والسكون وفتح الزاي وكسر الميم وتحتية ساكنة ومثلثة مفتوحة ونون إلى فرزاميثن محلة بسمرقند. PageV01P194(@)(@@)(@@)(@@) $DIC_NIS$ الفرزكي (@)(@@) بالضم والسكون وفتح الزاي إلى فرزك جد.(@)(@@)(@@)(@@) $DIC_NIS$ الفرساباذي (@)(@@) بالضم والسكون ومهملة وموحدة وذال معجمة إلى فرساباذ قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الفرساني (@)(@@) بالكسر إلى فرسان قرية بأصبهان وبالضم إلى فرسان قرية بإفريقية.(@)(@@)(@@)(@@) $DIC_NIS$ الفرسي (@)(@@) بفتحتين ومهملة.(@)(@@)(@@)(@@) $DIC_NIS$ الفرشي (@)(@@) بالضم والسكون ومعجمة إلى الفرش.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الفرضي (@)(@@) بوزنه إلى الفرضة قرية بالبحرين.(@)(@@)(@@)(@@) $DIC_NIS$ والفرضي (@)(@@) قد تقدم في الفرائضي.(@)(@@)(@@)(@@) $DIC_NIS$ والفرطسي (@)(@@) بالفتح والسكون إلى فرطس قرية ببغداد انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الفرعي (@)(@@) بالكسر والفتح ومهملة إلى فرع جد.(@)(@@)(@@)(@@) $DIC_NIS$ الفرغاني (@)(@@) بالفتح والسكون ومعجمة إلى فرغانة بلاد وراء الشاش وفرغانة قرية بفارس.(@)(@@)(@@)(@@) $DIC_NIS$ الفرغليظي (@)(@@) بضم أوله والمعجمة وكسر اللام وإعجام الظاء إلى فرغليظ قرية بالأندلس.(@)(@@)(@@)(@@) $DIC_NIS$ الفرغولي (@)(@@) بالفتح والسكون وضم المعجمة ولام إلى فرغول قرية بدهستان.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الفرفقاباذي (@)(@@) إلى فرفقاباذ قرية بأرمية انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الفرقدي (@)(@@) بفتح الفاء والقاف ودال مهملة إلى فرقد جد.(@)(@@)(@@)(@@) $DIC_NIS$ الفركي (@)(@@) بفتحتين إلى فرك قرية بأصبهان وبالكسر والسكون إلى الفرك موضع ببغداد. PageV01P195(@)(@@)(@@)(@@) $DIC_NIS$ الفرماوي والفرمي:(@)(@@) بفتحتين إلى فرما بلد بمصر.(@)(@@)(@@)(@@) $DIC_NIS$ الفرمنكي (@)(@@) بفتح الفاء والميم وسكون الراء والنون إلى فرمنك جد.(@)(@@)(@@)(@@) $DIC_NIS$ الفرمي (@)(@@) مر آنفا في الفرماوي.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الفرميثكاني (@)(@@) إلى فرميثكان قرية قال ياقوت: 