ms601	 أهل المدينة، يروي عن: أبيه، روى عنه: عبد العزيز بن عقبه بن سلمة، مات سنة إحدى عشرة ومائه وهو ابن خمس وثمانين سنة، وكانت كنيته أبا محمد.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن سبع، ويقال: ابن سبيع(@)(@@) يروي عن: علي، روى عنه: سالم بن أبي الجعد.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن جرهد الأسلمي(@)(@@) يروي عن: أبيه، روى عنه: عبد الله بن محمد بن عقيل إن كان حفظه.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن شريك العامري(@)(@@) يروي عن: ابن عمر، عداده في أهل الكوفة، روى عنه: الثوري، وشريك(@)(@@)(@@)(@@) ||| AUTO عبد الله بن قدامه العنبري(@)(@@) والد سوار بن عبد الله، قاضي البصرة، يروي عن: أبي برزة، روى عنه: توبة العنبري.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن الساعدي المالكي(@)(@@) يروي عن: عمر بن الخطاب، وكان عامله، روى عنه: بشر بن سعد.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن فيروز الديلمي، كنيته أبو بشر(@)(@@) عن: أبيه، روى PageV01P002 [ج 2: ص 267] عنه: يحيى بن عمرو الشيباني، كان يسكن بيت المقدس.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن سرجس(@)(@@) يروي عن: أبي هريرة، روى عنه: عثمان بن حكيم.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن كعب الحميري(@)(@@) يروي عن: عمر بن أبي سلمه، أنه سأل رسول الله صلى الله عليه وسلم: أيقبل الصائم، الحديث، روى عنه: عبد الله بن سعيد.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن زرير الغافقي(@)(@@) يروي عن: علي، عداده في أهل مصر، روى عنه: أبو الخير مرثد بن عبد الله اليزني، مات سنة ثلاث وثمانين بمصر.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن أبي عتبه(@)(@@) مولى أنس بن مالك، يروي عن: أنس وجابر وأبي سعيد، عداده في أهل البصرة، روى عنه: قتادة، وحميد، ومن قال: عبد الله بن عتبه، فقد وهم.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن الحارث الزبيدي المكتب(@)(@@) من أهل الكوفة، يروي عن: عبد الله بن عمرو، روى عنه: عمرو بن مرة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن غابر أبو غابر الألهاني(@)(@@) يروي عن: ثوبان، عداده في أهل الشام، روى عنه: أهلها.(@)PageV01P002(@)(@@) [ج 2: ص 268](@)(@@)(@@)(@@) ||| AUTO عبد الله بن مرداس المحاربي(@)(@@) يروي عن: ابن مسعود، روى عنه: أهل 
ms602	 الكوفة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن زيد بوذان(@)(@@) يروي عن: ابن عباس، عداده في أهل اليمن، روى عنه: موسى بن عبد العزيز القنباري.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن جبير(@)(@@) يروي عن: ابن عمر، روى عنه: أبو الزناد.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن زيد الطائي(@)(@@) يروي عن: أبي هريرة، روى عنه: النضر بن أنس.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن سخبرة الأزدي(@)(@@) من أزد شنوءه، كنيته أبو معمر، يروي عن: ابن مسعود، وخباب، عداده في أهل الكوفة، روى عنه: إبراهيم النخعي.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عبد الرحمن بن أسيد الأنصاري(@)(@@) يروي عن: أنس، روى عنه: خالد بن عبيد.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن أبي بكر(@)(@@) يروي عن: أنس بن مالك: " يتبع الميت ثلاثة ". روى عنه: سفيان بن عيينة ويشبه أن يكون هذا عبد الله بن أبي بكر بن محمد بن عمرو بن حزم.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن أبي الهذيل العبدي(@)(@@) يروي عن: جماعه من الصحابة، روى عنه: أهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO أبو بحرية الكندي اسمه عبد الله بن قيس(@)(@@) يروي عن: معاذ، عداده PageV01P002 [ج 2: ص 269] في أهل الشام، روى عنه: أهلها.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن سراقه(@)(@@) يروي عن: أبي عبيده بن الجراح، روى عنه: عبد الله بن شقيق ال عقيلي.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عبد الرحمن بن الحباب الأنصاري(@)(@@) يروي عن: عبد الله بن أنيس، عداده في أهل المدينة، روى عنه: موسى بن جبير.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن الحارث نسيب ابن سيرين(@)(@@) كنيته أبو الوليد، عداده في أهل البصرة، يروي عن: ابن عباس، وعائشه، روى عنه: عاصم الأحول، وخالد الحذاء.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن الحارث بن أزد شنوءة(@)(@@) أخو عائشة لأمه، يروي عن: عائشة، روى عنه: الزهري، أمه أم رومان.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن الحارث الأزدي(@)(@@) يروي عن: غرفه بن الحارث، روى عنه: حرملة بن عمران.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن سهل بن عبد الرحمن بن سهل الأنصاري(@)(@@) أحد بني حارثة، يروي عن: عائشة، وسهل بن أبي حثمة، كنيته أبو ليلى، روى عنه: مالك، وابن إسحاق.(@)PageV01P002(@)(@@) [ج 2: ص 270](@)(@@)(@@)(@@) ||| AUTO 
ms603	 عبد الله بن سعيد(@)(@@) يروي عن: ابن أبي أوفى، روى عنه: إياد بن لقيط.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن رباح الأنصاري(@)(@@) كانت الأنصار تفقهه، يروي عن: أبي قتادة، روى عنه: ثابت البناني، وخالد بن سمير.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عصمة(@)(@@) شيخ، يروي عن: حكيم بن حزام، روى عنه: يوسف بن ماهك.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن حلام(@)(@@) يروي عن: ابن مسعود، روى عنه: أبو إسحاق السبيعي.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن ربيعة الحضرمي(@)(@@) يروي عن: أبي هريرة، روى عنه: صفوان بن عمرو السكسكي.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن قتادة المحاربي(@)(@@) يروي عن: ابن مسعود، روى عنه: أهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن بشر الأزرق الأنصاري(@)(@@) يروي عن: ابن مسعود، روى عنه: أهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن حنظلة(@)(@@) يروي عن: سلمان، روى عنه: العلاء بن بدر.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن سعد بن نوفل الجاري(@)(@@) كان يسكن الجار، يروي عن: أبي هريرة، ويروي أيضا، عن أبيه، عن عمر، روى عنه: عبد الملك بن أعين.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن سعد التيمي(@)(@@) مولى عائشة، يروي عن: أبي هريرة، روى عنه: بكير بن الأشج.(@)PageV01P002(@)(@@) [ج 2: ص 271](@)(@@)(@@)(@@) ||| AUTO عبد الله بن خليفه الهمداني(@)(@@) يروي عن: عمر، عداده في أهل الكوفة، روى عنه: أبو إسحاق السبيعي.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عبد الله بن يسار(@)(@@) يروي عن: عمر، روى عنه: ابن جريج.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن المسيب العابدي(@)(@@) يروي عن: عبد الله بن السائب، وله صحبة، روى عنه: محمد بن عباد بن جعفر، مات في زمن ابن الزبير.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عبد الله بن جابر بن عتيك الأنصاري المدني(@)(@@) عن: ابن عمر، وأنس، روى عنه: أهل المدينة، ويقولون: عبد الله بن عبد الله بن جابر بن عتيك، روى عنه العراقيون: شعبة، ومسعر، وذووهما، فقالوا: عبد الله بن عبد الله بن جبر بن عتيك.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن قرط(@)(@@) يروي عن: أبي ذر، روى عنه: إبراهيم بن مهاجر.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن الخليل بن أبي الخليل(@)(@@) يروي عن: علي، روى عنه: 
ms604	 أبو إسحاق السبيعي، وأهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن راشد الهاشمي(@)(@@) مولى عثمان بن عفان، يروي عن: أبيه، روى عنه: ابن إسحاق، والأفريقي.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عبد الله بن الحارث بن نوفل الهاشمي(@)(@@) يروي عن:(@)PageV01P002(@)(@@) [ج 2: ص 272] عبد المطلب بن ربيعه بن الحارث، روى عنه: الزهري.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن مالك بن الحويرث الليثي(@)(@@) عداده في أهل البصرة، يروي عن: أبيه، روى عنه: أهل البصرة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن الصامت الغفاري(@)(@@) ابن أخي أبي ذر، يروي عن: أبي ذر، روى عنه: أبو عمران الجوني، وحميد بن هلال، عداده في أهل البصريين.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن معج، أبو عبد الجبار(@)(@@) يروي عن: أبي هريرة، روى عنه: يحيى بن أبي عمرو السيباني.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عبد الله بن خبيب الجهني(@)(@@) أخو مسلم بن عبد الله، ومعاذ بن عبد الله، يروي عن: أبيه، وله صحبه، كنيته: أبو معاذ، روى عنه: معاذ بن عبد الله أخوه.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن نجي الحضرمي(@)(@@) يروي عن: علي، روى عنه: أهل الكوفة، يروي أيضا عن: أبيه، عن علي.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن رافع بن أبي رافع(@)(@@) من أهل المدينة، يروي عن: أبي هريرة، وأم سلمة، وأنس، روى عنه: سعيد المقبري، وأهل المدينة، وكان مولى أم سلمه عتاقة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن سلمة الجملي(@)(@@) من مراد، يروي عن: علي، وابن مسعود، عداده في أهل الكوفة، روى عنه: أبو إسحاق السبيعي.(@)PageV01P002(@)(@@) [ج 2: ص 273](@)(@@)(@@)(@@) ||| AUTO عبد الله بن عمرو أبو مرايه العجلي(@)(@@) يروي عن: عمران بن حصين، وسلمان، عداده في أهل البصرة، روى عنه: قتادة، وأسلم العجلي.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عبد الله بن أبي طلحة الأنصاري(@)(@@) أخو إسحاق، وإسماعيل، وعمر، يروي عن: أنس بن مالك، روى عنه: أهل البصرة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن سفيان بن عبد الله بن ربيعه الثقفي(@)(@@) أخو عاصم بن سفيان وعمرو بن سفيان، يروي عن: أبيه، وعبد الله بن السائب، روى عنه: يعلى بن عطاء.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عامر الهمداني(@)(@@) يروي عن: 
ms605	 معاوية، روى عنه: سليمان بن موسى.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن سيدان المطرودي(@)(@@) ومطرود، فخذ من سليم، يروي عن: أبي ذر، وحذيفة، عداده في أهل الربذة، روى عنه: ميمون بن مهران، وحبيب بن أبي مرزوق.(@)(@@)(@@)(@@) ||| AUTO أبو طواله اسمه عبد الله بن عبد الرحمن بن معمر بن حزم الأنصاري(@)(@@) من أهل المدينة، يروي عن: أنس بن مالك، روى عنه: مالك، وعبد الله بن عبد العزيز العمري الزاهد، وكان خليفة لأبي بكر بن محمد بن عمرو بن حزم على القضاء بالمدينة، مات في ولاية أبي العباس بن السفاح.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن السائب بن يزيد(@)(@@) حليف بني أمية، كنيته: أبو محمد، يروي عن: أبيه، وجماعة من التابعين، روى عنه: أهل المدينة، مات سنة ست وعشرين ومائة.(@)PageV01P002(@)(@@) [ج 2: ص 274](@)(@@)(@@)(@@) ||| AUTO عبد الله بن السائب الكندي(@)(@@) عن: عبد الله بن معقل، روى عنه: الثوري.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عباد بن جعفر(@)(@@) أخو محمد بن عباد بن جعفر، يروي عن: أبي هريرة، عداده في أهل مكة، روى عنه: ابن جريج، وعكرمة بن عمار.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن صفوان بن أمية بن خلف الجمحي القرشي(@)(@@) يروي عن: حفصة بنت عمر بن الخطاب، روى عنه: أمية بن صفوان بن عبد الله بن صفوان، وهو ابن ابنه، قتل وهو متعلق بأستار الكعبه، وكان مع ابن الزبير سنة ثلاث وسبعين.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن أبي سليمان القرشي(@)(@@) مولى عثمان بن عفان، كنيته أبو أيوب، يروي عن: أبي هريرة، روى عنه: حماد بن زيد، وإسحاق بن عثمان.(@)(@@)(@@)(@@) ||| AUTO عبد الله البهي(@)(@@) يروي عن: عائشة، روى عنه: العباس بن ذريح.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عطاء(@)(@@) يروي عن: ابن عمر، عداده في أهل مكة، روى عنه: القاسم بن أبي بزة، وأبو إسحاق السبيعي، ولم ير عقبة بن عامر.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن ربيعه السلمي(@)(@@) يروي عن: ابن مسعود، روى عنه: أهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن أبي عثمان القرشي(@)(@@) يروي عن: ابن عمر، من سكان البصرة، روى PageV01P002 [ج 2: ص 275] عنه: يحيى القطان، 
ms606	 إن كان متصلا.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عثمان بن خثيم بن القارة، كنيته أبو عثمان(@)(@@) يروي عن: أبي الطفيل، عداده في أهل مكة، روى عنه: معمر، والناس، مات قبل سنة أربع وأربعين ومائة، وقد قيل: سنة خمس وثلاثين ومائة، وكان يخطئ.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن ضمرة السلولي(@)(@@) يروي عن: أبي هريرة، وكان راويا عن: كعب، روى عنه: عطاء بن قرة، وعبد الرحمن بن سابط.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن علي بن السائب بن عتيك بن عبد يزيد(@)(@@) يروي عن: عثمان بن عفان، روى عنه: سعيد بن أبي هلال.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن أبي أمامة(@)(@@) يروي عن: عبد الله بن أنس، روى عنه: محمد بن زيد، ويشبه أن يكون بن أبي أمامة بن سهل بن حنيف.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عبيد(@)(@@) يروي عن: عمر وأبي هريرة وأبي طلحة، روى عنه: يحيى بن جعدة، وابنه محمد بن عبد الله بن عبيد.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن المغيره بن أبي ذئاب الدوسي(@)(@@) من أهل المدينة، عن: أبي هريرة، روى عنه: ابن أخيه الحارث بن عبد الرحمن بن المغيرة بن أبي ذئاب.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن غالب الألهاني(@)(@@) يروي عن: أبي أمامة، وعتبة بن عبد، عداده في أهل الشام، روى عنه: حريز بن عثمان، والأحوص بن حكيم.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عبد الله بن أبي أمية المخزومي القرشي(@)(@@) يروي عن: عمر بن الخطاب، وأم سلمة، روى عنه: سليمان بن يسار، ومحمد بن عبد الرحمن بن ثوبان.(@)PageV01P002(@)(@@) [ج 2: ص 276](@)(@@)(@@)(@@) ||| AUTO عبد الله بن معقل بن مقرن المزني(@)(@@) يروي عن: ابن مسعود، كنيته أبو الوليد، عداده في أهل الكوفة، روى عنه: الشيباني، والسبيعي، مات بالبصرة سنة بضع وثمانين.(@)(@@) (171) -[2: 276] ثنا الحسن بن سفيان، قال: ثنا أبو بكر بن أبي شيبة، قال: ثنا وكيع، قال: ثنا أبي، قال: ثنا أبو إسحاق، عن عبد الله بن معقل، أنه " صلى بالناس في شهر رمضان، فلما كان يوم الفطر بعث إليه عبيد الله بن زياد بحلة وخمس مائة درهم فردها عليه، وقال: إنا 
ms607	 لا نأخذ على القرآن أجرا "(@)(@@)(@@)(@@) ||| AUTO عبد الله بن كيسان(@)(@@) مولى أسماء بنت أبي بكر، كنيته أبو عمر، وهو ختن عطاء بن أبي رباح، يروي عن: أسماء بنت أبي بكر، روى عنه: عمرو بن دينار، وابن جريج.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن أبي كبشة الأنماري(@)(@@) واسم أبي كبشة سعيد بن عمرو، يروي عن: أبيه وله صحبة، عداده في أهل الشام، روى عنه: حبيب بن عبد الله بن أبي كبشة.(@)(@@)(@@)(@@) ||| AUTO أبو ريحانة اسمه عبد الله بن مطر السعدي(@)(@@) يروي عن: سفينة، إن كان سمع منه، عداده في البصريين، ربما أخطأ، روى عنه: ابن علية.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عبيد بن هرمز(@)(@@) يروي عن: عبادة بن الصامت، ومعاوية، روى عنه: محمد ابن سيرين.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن مرثد(@)(@@) يروي عن: جابر بن عبد الله، روى عنه: سعيد بن أبي كرب.(@)PageV01P002(@)(@@) [ج 2: ص 277](@)(@@)(@@)(@@) ||| AUTO عبد الله بن ضمعج(@)(@@) يروي عن: ابن عمر، روى عنه: حبيب بن سندر.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن معانق الأشعري(@)(@@) يروي عن: أبي مالك الأشعري وله صحبة، روى عنه: أبو سلام الحبشي.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن خباب(@)(@@) عن: أبي بن كعب، روى عنه: عبد الرحمن بن أبزى.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن ضرار(@)(@@) يروي عن: ابن مسعود، روى عنه: ابنه سعيد بن عبد الله بن ضرار.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO عبد الله بن عبيد الله الأنصاري(@)(@@) حضر دفن ثابت بن قيس بن الشماس يوم اليمامة، روى عنه: حصين بن عبد الرحمن.(@)(@@) عبد الله بن عبيد الله(@)(@@) يروي عن: أنس بن مالك، روى عنه: حصين بن نمير، وليس هذا بالشاهد، دفن ثابت بن قيس.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عبد الله بن أنيس الجهني(@)(@@) يروي عن: أبيه في ليلة القدر وله صحبة، روى عنه: محمد بن إبراهيم بن الحارث التيمي.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عامر أبو عمران اليحصبي(@)(@@) يروي عن: معاوية، عداده في أهل الشام، روى عنه: جعفر بن ربيعة، وربيعة بن يزيد، أحسبه الذي روى عن: أبي أيوب في الوتر من رواية سعيد بن 
ms608	 السباق.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن كعب الحميري(@)(@@) مولى عثمان بن عفان، يروي عن: رجل من PageV01P002 [ج 2: ص 278] أصحاب النبي صلى الله عليه وسلم ويروي عن: خارجة بن زيد، روى عنه: يحيى بن سعيد، ومحمد بن إسحاق بن يسار.(@)(@@)(@@)(@@) ||| AUTO عبيد بن نضيلة الخزاعي(@)(@@) يروي عن: ابن مسعود، روى عنه: أهل الكوفة، مات في ولاية بشر بن مروان.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن معبد بن العباس بن عبد المطلب الهاشمي(@)(@@) يروي عن: ابن عباس، روى عنه: ابنه إبراهيم بن عبد الله بن معبد.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن الفضل بن ربيعة الهاشمي(@)(@@) يروي عن: أنس بن مالك، روى عنه: موسى بن عقبة، ومالك، عداده في أهل المدينة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عبيد الله بن عمر بن الخطاب(@)(@@) يروي عن: رجل من أصحاب النبي صلى الله عليه وسلم روى عنه: بكير بن عبد الله بن الأشج.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عبيد الله بن عباس بن عبد المطلب الهاشمي(@)(@@) والد حسين بن عبد الله، يروي عن: ابن عباس، روى عنه: يحيى بن سعيد الأنصاري، وموسى بن سالم.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن الديلمي، هو عبد الله بن ديلم بن هوشع الحميري(@)(@@) لأبيه صحبة، عداده في أهل مصر، روى عنه: ربيعة بن يزيد الدمشقي، وأهل فلسطين.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عائذ الثمالي(@)(@@) من أهل الشام، يقال: إن له صحبة، قاله: صفوان بن عمرو السكسكي، يروي عن: المقدام بن معد يكرب، وجماعة من الصحابة، روى عنه:(@)PageV01P002(@)(@@) [ج 2: ص 279] راشد بن سعد، وأهل الشام، ومن الناس من قال: إن أبا عامر الهوزني هو عبد الله بن عائذ.(@)(@@) (172) -[2: 279] ثنا العباس بن الخليل الطائي بحمص، قال: ثنا نصر بن خزيمة بن علقمة بن محفوظ بن علقمة الحضرمي، قال: ثنا أبي، عن نصر بن علقمة، عن أخيه محفوظ بن علقمة، عن ابن عائذ، عن المقدام بن معد يكرب، عن النبي صلى الله عليه وسلم قال: " من كذب الناس حديثا فحدثوا بكذبه، فإن إثم من يحدث عليه "(@)(@@)(@@)(@@) ||| AUTO عبد الله بن فيروز الداناج 
ms609	(@)(@@) يروي عن: أبي برزة، عداده في أهل البصرة، وهو الذي يقال له: الدانا بلا جيم، روى عنه: حماد بن سلمة، وابن أبي عروبة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عمرو بن علقمة بن الفغواء الخزاعي(@)(@@) يروي عن: رجل من أصحاب النبي صلى الله عليه وسلم روى عنه: زيد بن أسلم ومسلم بن نبهان.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن فضالة الليثي(@)(@@) يروي عن: أبيه، وله صحبة، روى عنه: عوف الأعرابي، وأبو حرب بن أبي الأسود.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن أبي مريم(@)(@@) مولى بني ساعدة، كنيته أبو خليفة، عداده في أهل المدينة، عن: أبي هريرة، وأبي حميد، وأبي حميد، روى عنه: بكر بن سوادة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن علي بن رفاعة من بني عبد شمس(@)(@@) يروي عن: معاوية، روى عنه: ابنه علي بن عبد الله.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن كناز(@)(@@) يروي عن: عثمان بن أبي العاص، روى عنه: أبو عيسى الخراساني.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن الفضل بن العباس الهاشمي(@)(@@) يروي عن: ابن عمر، PageV01P002 [ج 2: ص 280] وأنس إن كان سمع منهما، روى عنه: إسحاق بن سويد، ويزيد بن أبي زياد، وموسى بن عقبة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عمرو بن أمية الضمري(@)(@@) أخو جعفر بن عمرو، يروي عن: أبيه، روى عنه: الزبرقان بن عبد الله ابنه.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن محمد بن عبد الرحمن بن أبي بكر الصديق(@)(@@) يروي عن: عائشة، روى عنه: ابناه عبد الرحمن، ومحمد وهو الذي روى عنه: أبو حزرة، ويقول: عبد الله بن أبي عتيق، وأبو عتيق محمد بن عبد الرحمن بن أبي بكر الصديق.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن كعب العبدي(@)(@@) يروي عن: علي، وحذيفة، روى عنه: الزبرقان بن عبد الله.(@)(@@)(@@)(@@) ||| AUTO أبو صادق الأزدي، اسمه عبد الله بن ناجد(@)(@@) يروي عن: علي، روى عنه: أهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عمرو بن عثمان بن عفان الأموي القرشي(@)(@@) يروي عن: ابن عمر، روى عنه: ابن أبي لبيبة، ومحمد بن يوسف.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عمرو بن عوف بن ملحة المزني(@)(@@) يروي عن: أبيه، 
ms610	 وله صحبة، عداده في أهل المدينة، روى عنه: ابنه كثير بن عبد الله.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن قيس النخعي(@)(@@) عن: ابن مسعود، والحارث بن أقيش، عداده في أهل البصرة، روى عنه: داود بن أبي هند، وأبو حرب، وأحسبه الذي روى عنه: أبو إسحاق السبيعي، عن ابن عباس قوله.(@)PageV01P002(@)(@@) [ج 2: ص 281](@)(@@)(@@)(@@) ||| AUTO عبد الله بن عوف القاري(@)(@@) من أهل المدينة، كنيته: أبو القاسم، يروي عن: رجل من أصحاب النبي صلى الله عليه وسلم روى عنه: الزهري، ورجاء بن أبي سلمة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن مرة الهمداني الخارفي(@)(@@) يروي عن: عبد الله بن عمر، روى عنه: الأعمش، وأبو إسحاق.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عميرة بن حصن القيسي(@)(@@) من بني قيس بن ثعلبة، كنيته: أبو المهاجر، عداده في أهل الكوفة، يروي عن: عمر، وحذيفة، وهو الذي يروي عن: الأحنف بن قيس، روى عنه: سماك بن حرب، وهو الذي يقول فيه إسرائيل: عبد الله بن حصين العجلي.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن قيس، أبو حميضة(@)(@@) يروي عن: علي، روت عنه: أم السكن بن أبي كريمة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن مليل(@)(@@) يروي عن: علي، عداده في أهل الكوفة، روى عنه: سالم بن أبي حفصة، والأعمش، وكثير النواء.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عوسجة الجهني(@)(@@) يروي عن: زيد بن خالد، وأبي هريرة، روى عنه: زيد بن أسلم.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن السمح، أبو السمح، الذي يقال له: الدراج(@)(@@) يروي عن: عبد الله بن الحارث بن جزء، يقال اسمه: عبد الله، وهو مذكور فيمن اسمه عبد الرحمن.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن غالب(@)(@@) وليس بالحداني، يروي عن: رجل من أصحاب النبي صلى الله عليه وسلم روى عنه: أبو إسحاق السبيعي.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن معبد الزماني(@)(@@) يروي عن: أبي قتادة، عداده في أهل PageV01P002 [ج 2: ص 282] البصرة، روى عنه: قتادة، وغيلان بن جرير.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن قتادة المحاربي(@)(@@) يروي عن: ابن مسعود، روى عنه: عبد الله بن السائب.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن مساور(@)(@@) يروي عن: ابن عباس وابن الزبير، روى 
ms611	 عنه: عبد الملك بن أبي بشر.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن قيس بن مخرمة بن المطلب القرشي(@)(@@) من بني عبد مناف، والد حكيم بن عبد الله بن قيس، يروي عن: أبيه، وزيد بن خالد الجهني، روى عنه: ابنه المطلب بن عبد الله، وأبو بكر بن محمد بن عمرو بن حزم.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن محمد بن صيفي(@)(@@) يروي عن: حكيم بن حزام، روى عنه: ابنه يحيى بن عبد الله.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عمار القرشي(@)(@@) يروي عن: ابن عمر، روى عنه: عكرمة بن عمار.(@)(@@)(@@)(@@) ||| AUTO أبو الكنود الأزدي واسمه عبد الله بن عمران، وقد قيل: عبد الله بن عويمر(@)(@@) يروي عن: علي، عداده في أهل الكوفة، روى عنه: أهلها.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن أبي قيس(@)(@@) مولى عطيف بن عفيف، كنيته أبو الأسود، يروي عن: عائشة، عداده في أهل الشام، روى عنه: معاوية بن صالح، وراشد بن سعد، ومن قال: عبد الله بن قيس فقد وهم، وقد قيل: إنه مولى عازب بن مدرك بن عفيف.(@)PageV01P002(@)(@@) [ج 2: ص 283](@)(@@)(@@)(@@) ||| AUTO عبد الله بن أبي مرة الزوفي(@)(@@) يروي عن: خارجة بن حذافة في الوتر إن كان سمع منه، روى عنه: يزيد بن أبي حبيب، إسناد منقطع ومتن باطل.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن قيس اللخمي(@)(@@) من أهل الشام، يروي عن: النعمان بن بشير وجماعة من الصحابة، روى عنه أهل الشام: ربيعة بن يزيد وغيره، مات سنة أربع وعشرين ومائة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن جريح بن حمال(@)(@@) ابن أخي أبيض بن حمال المأربي(@)(@@) (173) -[2: 283] سأل ابن عمر عن قصر الصلاة في السفر، فقال ابن عمر: " صلاة السفر مثنى مثنى، إلا المغرب ". روى فرج بن سعيد بن علقمة بن سعيد بن أبيض بن حمال، عن عمه جبير بن سعيد، عنه(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عبيدة الربذي(@)(@@) يروي عن: جابر، وعقبة بن عامر، روى عنه: أخوه موسى بن عبيدة، قتلته الحرورية بقديد سنة ثلاثين ومائة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن المستورد(@)(@@) مولى الأنصار، كنيته أبو ضمرة، يروي عن: رجل من أصحاب 
ms612	 النبي صلى الله عليه وسلم عداده في أهل المدينة، روى عنه: مجمع بن يعقوب، ومحمد بن عبيد الطنافسي.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن القاسم(@)(@@) مولى أبي بكر الصديق، يروي عن: ابن عمر، وابن عباس، وابن الزبير، روى عنه: فضيل بن غزوان.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عبد الرحمن(@)(@@) يروي عن: عبد الله بن المغفل، روى عنه: عبيدة بن أبي رائطة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن لبيد(@)(@@) يروي عن: حذيفة، روى عنه: أبو إسحاق السبيعي.(@)PageV01P002(@)(@@) [ج 2: ص 284](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO عبد الله بن أبي لبيد(@)(@@) أخو عبد الرحمن بن أبي لبيد، يروي عن: البراء بن عازب، روى عنه: الزبير بن عدي.(@)(@@) عبد الله بن أبي لبيد(@)(@@) مولى لآل الأخنس بن شريق الثقفي، من أهل المدينة، كنيته أبو المغيرة، من عباد أهل المدينة، يروي عن: جماعة من الصحابة، روى عنه: أهل الحجاز، مات في ولاية أبي جعفر، ويروي عن: أبي سلمة بن عبد الرحمن، قدم الكوفة فكتب عنه أهلها: الثوري وغيره، مات بالمدينة ولم يشهد صفوان بن سلمة جنازته لأنه كان يرمى بالقدر.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن مسلم بن عبيد الله بن عبد الله بن شهاب القرشي الزهري(@)(@@) أخو محمد بن مسلم، يروي عن: ابن عمر وأنس بن مالك، روى عنه: ابنه محمد بن عبد الله بن مسلم.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن أبي سليط(@)(@@) روى عنه: عبد الله بن ضميرة الفزاري.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن نهيك(@)(@@) يروي عن: علي، روى عنه: أبو إسحاق السبيعي.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن أبي محل(@)(@@) يروي عن: علي، روى عنه: عبد الله بن شريك.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن سويد الخطمي(@)(@@) يروي عن: أبي أيوب، روى عنه: محمد بن ثابت بن شرحبيل.(@)PageV01P002(@)(@@) [ج 2: ص 285](@)(@@)(@@)(@@) ||| AUTO عبد الله بن مطيع بن الأسود القرشي(@)(@@) يروي عن: أبيه وهو رجل من أصحاب النبي صلى الله عليه وسلم روى عنه: الشعبي، ومحمد بن أبي موسى.(@)(@@)(@@)(@@) ||| AUTO عبد الله البهي(@)(@@) مولى مصعب بن الزبير بن العوام، كنيته أبو محمد، يروي عن: ابن عمر، وابن الزبير، وعائشة، روى 
ms613	 عنه: أبو إسحاق السبيعي، ويزيد بن أبي زياد، وقد قيل: إنه عبد الله بن يسار، والبهي لقب، كان يجالس عائشة كثيرا، وكذلك عروة، وروى عنه: عائشة، وعن عروة، عن عائشة جميعا.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن الوليد بن عثمان بن عفان(@)(@@) يروي عن: أسماء بنت أبي بكر، روى عنه: محمد بن إسحاق.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن حسين القرشي(@)(@@) يروي المراسيل، روى عنه: عبد الملك بن عمير.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن مولة القشيري(@)(@@) يروي عن: بريدة بن الحصيب الأسلمي، روى عنه: أبو نضرة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن منبه بن كامل بن شيخ بن سبجان(@)(@@) أخو وهب بن منبه، وهمام بن منبه، يروي عن: أبي هريرة، وعبد الله بن عمرو، روى عنه: يوسف بن ماهك.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن وهب بن زمعة القرشي الأسدي(@)(@@) يروي عن: أم سلمة، روى عنه: الزهري.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن المسيب بن أبي السائب العابدي القرشي(@)(@@) يروي عن: عمر، روى عنه: ابن أبي مليكة.(@)PageV01P002(@)(@@) [ج 2: ص 286](@)(@@)(@@)(@@) ||| AUTO عبد الله بن أبي بلال الخزاعي(@)(@@) يروي عن: العرباض بن سارية، روى عنه: خالد بن معدان.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن بديل(@)(@@) يروي عن: ابن عباس، روى عنه: البصريون.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عمرو القارئ(@)(@@) يروي عن: أبي هريرة، روى عنه: يحيى بن جعدة.(@)(@@)(@@)(@@) ||| AUTO أبو تميم الجيشاني اسمه عبد الله بن مالك(@)(@@) وكان من عباد أهل مصر، يروي عن: أبي ذر، روى عنه: عبد الله بن هبيرة السبائي.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن أبي الهذيل الغنوي، كنيته أبو المغيرة(@)(@@) من أهل الكوفة، يروي عن: عمر، وابن مسعود، وأبي بن كعب، روى عنه: أبو سنان، وأبو فروة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن مسروق(@)(@@) يروي عن: عقبة بن عامر، روى عنه: مرثد بن عبد الله اليزني.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن واقد بن عبد الله بن عمر بن الخطاب(@)(@@) يروي عن: ابن عمر، روى عنه: الزهري، وعبد الله بن أبي بكر، وفضيل بن غزوان، مات سنة تسع عشرة ومائة، أمه أمة الله بنت عبد الله بن 
ms614	 عياش بن أبي ربيعة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن أبي بكر بن حفص بن عمر بن سعد بن أبي وقاص(@)(@@) يروي عن: معاوية، إن كان سمع منه أنه صلى للناس بالمدينة فلم يقرأ {بسم الله الرحمن الرحيم}، فقالوا: يا معاوية، أسرقت الصلاة أم نسيت، فلم يعد معاوية لذلك بعد. روى عنه: عبد الله بن عثمان بن خثيم.(@)PageV01P002(@)(@@) [ج 2: ص 287](@)(@@)(@@)(@@) ||| AUTO عبد الله بن رقيش(@)(@@) يروي عن: أنس بن مالك، روى عنه: فضيل بن سليمان النميري.(@)(@@) (174) -[2: 287] ثنا عمر بن محمد الهمداني، قال: ثنا أحمد بن المقدام العجلي، قال: ثنا الفضيل بن سليمان، عن عبد الله بن رقيش، قال: رأيت أنس بن مالك أتي بقباء، قال: ثم قال: " ائتوني بقباء بماء من بئر غرس، فإني رأيت رسول الله صلى الله عليه وسلم يشرب منها ويتوضأ "، فأتي بماء فصب على يديه ثم أدخلها في إزاره فلمس ذكره ثم توضأ، ومسح على خفيه(@)(@@)(@@)(@@) ||| AUTO عبد الله بن يسار الجهني الكوفي(@)(@@) يروي عن: سليمان بن صرد، وخالد بن عرفطة، روى عنه: أبو صخرة جامع بن شداد.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن مالك اليحصبي، أبو سعيد الرعيني(@)(@@) يروي عن: عقبة بن عامر، عداده في أهل مصر، روى عنه: عبيد الله بن زحر.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن يسار، أبو همام(@)(@@) يروي عن: عمرو بن حريث، روى عنه: يعلى بن عطاء.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن ضمرة(@)(@@) يروي عن: أبي هريرة، روى ابن ثوبان، عن عطاء بن قرة، عنه.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن مالك الهمداني(@)(@@) يروي عن: علي، وابن عمر، روى عنه: أبو إسحاق السبيعي.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن جنادة الفهري(@)(@@) يروي عن: أبي هريرة، روى عنه: ابنه سليم بن عبد الله.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن يزيد أبو عبد الرحمن الحبلي(@)(@@) يروي عن:(@)PageV01P002(@)(@@) [ج 2: ص 288] عبد الله بن عمر، عداده في أهل مصر، روى عنه: أهلها.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن وهبان(@)(@@) يروي عن: ابن عباس، روى عنه: عبد العزيز بن رفيع.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن كنانة(@)(@@) يروي عن: ابن عباس، روى 
ms615	 عنه: ابنه هشام بن عبد الله بن كنانة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن يعلى النهدي(@)(@@) يروي عن: علي، روى عنه: عيسى بن عبد الرحمن، عداده في أهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن الرومي(@)(@@) يروي عن: أبي هريرة، روى عنه: ابنه عمر بن عبد الله، أصله من خراسان، مات هو وبديل بن ميسرة في يوم واحد سنة خمس وثلاثين ومائة، حدثنا به عن قتيبة، قال: ثنا عمر بن عبد الله بن الرومي، عن أبيه، عن أبي هريرة بنسخة محمد بن إسحاق بن إبراهيم.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن مالك بن الأشتر النخعي(@)(@@) يروي عن: ابن عمر، روى عنه: بكير بن عبد الله بن الأشج، ويزيد بن عبد الله بن قسيط.(@)(@@)(@@)(@@) ||| AUTO عبد الله الوراس(@)(@@) يروي عن: علي، وطلحة، والزبير، روى عنه: عاصم الأحول.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن ميسرة(@)(@@) يروي عن: ابن عمر، روى عنه: عكرمة بن عمار.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عنبسة(@)(@@) يروي عن: ابن عباس، روى عنه: ربيعة بن أبي عبد الرحمن.(@)PageV01P002(@)(@@) [ج 2: ص 289](@)(@@)(@@)(@@) ||| AUTO عبد الله بن مغيرة بن أبي بردة الليثي(@)(@@) يروي عن: المدلجي رجل من أصحاب النبي صلى الله عليه وسلم عداده في أهل المدينة، روى عنه: أهلها.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن يحنس(@)(@@) مولى معاوية، يروي عن: أبي هريرة، روى عنه: داود بن أبي عاصم.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن منقد القيسي(@)(@@) قوله، عداده في أهل الكوفة، روى عنه: الحكم بن عتيبة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن يسار(@)(@@) مولى ميمونة، أخو سليمان، وعبد الملك، وعطاء، بنو يسار، يروي عن: رجل من أصحاب النبي صلى الله عليه وسلم عداده في أهل المدينة، روى عنه: أهلها، وليس هو بصاحب سليمان بن صرد، وخالد بن عرفطة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن يزيد بن أسد القسري(@)(@@) يروي عن: أبيه وله صحبة، روى عنه: ابنه خالد بن عبد الله القسري، والى العراق.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن وديعة بن خدام الأنصاري(@)(@@) أخو يزيد بن وديعة، يروي عن: سلمان، عداده في أهل الكوفة، روى عنه: أهلها، وأبو سعيد المقبري. 
ms616	(@)(@@)(@@)(@@) ||| AUTO عبد الله بن أبي الجعد(@)(@@) يروي عن: ثوبان، روى عنه: عبد الله بن عيسى بن عبد الرحمن.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن أبي هند(@)(@@) يروي عن: أبي عبيدة بن الجراح، روى عنه: أبو مالك الأشجعي.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عمير(@)(@@) مولى أم الفضل بنت الحارث بن حزن، يروي عن:(@)PageV01P002(@)(@@) [ج 2: ص 290] ابن عباس، روى ابن أبي ذئب، عن القاسم بن عباس عنه، مات سنة سبع عشرة ومائة، كنيته أبو محمد.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن هبيرة السبائي(@)(@@) يروي عن: أبي هريرة، عداده في أهل مصر، روى عنه: يحيي بن سعيد الأنصاري، وبكر بن عمرو، مات في ولاية معاوية.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن يزيد(@)(@@) رضيع عائشة، يروي عن: عائشة، عداده في أهل البصرة، روى عنه: أبو قلابة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن صبيح أو صبيح(@)(@@) يروي عن: أبي هريرة، روى عنه: وائل بن داود.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عمرو الأودي(@)(@@) يروي عن: ابن مسعود، روى عنه: موسى بن عقبة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن حنش الأودي(@)(@@) يروي عن: ابن عمر، روى عنه: أبو عوانة الوضاح.(@)(@@) (175) -[2: 290] حدثني محمد بن عبد الله بن الجنيد، قال: ثنا قتيبة بن سعيد، قال: ثنا أبو عوانة، عن عبد الله بن حنش الأودي، قال: سمعت ابن عمر وسأله رجل عن " الصرف، فقال: كنا ندعوه الربا "(@)(@@) (176) -[2: 290] وسأله رجل عن " السلم، فقال: ليس به بأس أن يبايع بدراهم كيلا معلوما إلى أجل معلوم "(@)(@@)(@@)(@@) ||| AUTO عبد الله بن أسامة بن مالك بن قهطم، أبو العشراء الدارمي(@)(@@) يروي عن: أبيه، عن النبي صلى الله عليه وسلم روى عنه: حماد بن سلمة، عداده في أهل البصرة، قيل: إن اسم أبي العشراء الدارمي: عبد الله، وقيل: عامر، واسم أبيه أسامة بن مالك بن قهطم، وقد قيل: إن اسم أبيه PageV01P002 [ج 2: ص 291] عطارد بن برز، ويقال: يسار بن بكر بن مسعود بن خولي بن حرملة بن قتادة من بني مولة ابن عبد الله بن دارم، روى عنه: حماد بن سلمة بهذا الإسناد ثلاثة أحاديث، المشهور منها ما: 
ms617	(@)(@@) (177) -[2: 291] حدثنا أحمد بن علي بن المثنى، قال: ثنا علي بن الجعد، وهدبة بن خالد، وعبد الأعلى بن حماد، وحوثرة بن أشرس، قالوا: حدثنا حماد بن سلمة، عن أبي العشراء الدارمي، عن أبيه، قال: قلت: يا رسول الله، " أما تكون الذكاة إلا في الحلق أو اللبة، فقال: لو طعنت في فخذها لأجزأك "(@)(@@)(@@)(@@) ||| AUTO عبد الله بن سنان(@)(@@) قال: سمعت ابن عباس، يقول: " حسب المؤمن من الخير أن يكون شجاعا مسلما، وحسب المؤمن من الشر أن يكون جبانا فاجرا ". روى عنه: الحسين بن واقد.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن الحسن بن الحسن بن علي(@)(@@) يروي عن: أبيه، روى عنه: ليث بن سليم.(@)(@@) (178) -[2: 291] ثنا ابن قتيبة، قال: ثنا ابن أبي السري، قال: ثنا معتمر بن سليمان، عن ليث، عن عبد الله بن الحسن بن علي، أنه كان إذا دخل المسجد يبدأ فيسلم على النبي صلى الله عليه وسلم ثم صلى عليه، ثم قال: " اللهم اغفر لي ذنوبي، وافتح لي أبواب فضلك ورحمتك، وقال: كان النبي صلى الله عليه وسلم يقول ذلك، ويأمرنا أن نقوله "(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عصم الحنفي(@)(@@) من أهل اليمامة، يروي عن: أبي سعيد الخدري، روى عنه: شريك بن عبد الله النخعي، يخطئ كثيرا.(@)(@@) (179) -[2: 291] حدثنا إبراهيم بن خزيم، قال: ثنا عبد بن حميد، قال: ثنا هاشم بن القاسم، قال: ثنا شريك، عن عبد الله بن عصم الحنفي، قال: سمعت أبا سعيد الخدري، يقول: قال رسول الله صلى الله عليه وسلم: " لا يحل صرار ناقة بغير إذن أهلها، فإنه خاتم أهلها عليها، وإن كنتم مرملين فرأيتم الراوية أو الوطب أو السقاء من اللبن فنادوا صاحب الإبل ثلاثا فإن سقاكم فاشربوا، وإن كنتم مرملين ولم يكن معكم طعاما فليمسكه رجلان منكم ثم اشربوا ثم صروها "(@)(@@)(@@)(@@) ||| AUTO عبد الله بن زياد الأسدي، أبو مريم(@)(@@) من أهل الكوفة، يروي عن: ابن PageV01P002 [ج 2: ص 292] مسعود، روى عنه: أشعث بن سليم، وأبو حصين، ومسعر بن كدام،(@)(@@) (180) -[2: 292] ثنا محمد بن أحمد بن أبي عون، ثنا علي بن حجر، 
ms618	 ثنا شريك، عن أشعث بن سليم، عن عبد الله بن زياد الأسدي، قال: " صليت إلى جنب ابن مسعود في الظهر أو العصر فسمعت قراءته "(@)(@@)(@@)(@@) ||| AUTO عبد الله بن حميد الحميري(@)(@@) يروي المراسيل، روى عنه: قتادة بن دعامة،(@)(@@) (181) -[2: 292] قال: ثنا ابن قتيبة، ثنا ابن أبي السري، ثنا معتمر بن سليمان، ثنا كهمس بن الحسن، عن قتادة، قال: أتاني عبد الله بن حميد الحميري فسلم علي، وأنا أصلي لم أرد فرددت عليه، فقال: " إنما سلمت عليك لأنظر كيف تصنع، أما أني لو سلم علي وأنا أصلي، لم أرد حتى أفرغ من صلاتي "(@)(@@)(@@)(@@) ||| AUTO عبد الله بن قنطس الهذلي(@)(@@) يروي عن: أنس بن مالك، عداده في أهل المدينة، وكان يتهم بأمر سوء، روى عنه: الثوري، وحاتم بن إسماعيل.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن سويد الأنصاري الخطمي(@)(@@) يروي عن: عمته، أم حميد امرأة أبي حميد الساعدي، وعن أبي أيوب الأنصاري، روى عنه: داود بن قيس الفراء، ومن قال: عبد الله بن شريك، فقد وهم، وهذا شيخ، روى عنه: محمد بن ثابت بن شرحبيل، من أهل المدينة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن قيس بن طغفة الغفاري(@)(@@) يروي عن: أبيه، روى عنه: يحيى بن أبي كثير.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن ساعدة الهذلي، كنيته أبو محمد(@)(@@) يروي عن: عمر بن الخطاب، روى عنه: أهل الشام، مات سنة مائة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن نيار بن مكرم الأسلمي(@)(@@) يروي عن: أبيه، روى عنه: أهل المدينة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن أبي سلمة الماجشون(@)(@@) أخو يعقوب بن أبي سلمة، يروي PageV01P002 [ج 2: ص 293] عن: أسماء بنت أبي بكر، روى عنه: ابنه عبد العزيز بن عبد الله، واسم أبي سلمة دينار، والماجشون المورد الوجنتين.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن مسلم بن عبيد الله بن عبد الله بن شهاب الزهري(@)(@@) أخو محمد بن مسلم الزهري، وكان أسن من محمد، سمع ابن عمر، وأنسا، روى عنه أخوه: محمد بن مسلم، أمهما من بني الديل من كنانة، مات قبل أخيه، وأخوه مات سنة أربع وعشرين ومائة في شهر رمضان. 
ms619	(@)(@@)(@@)(@@) ||| AUTO عبد الله بن أبي سفيان(@)(@@) مولى ابن جحش، يروي عن: جماعة من الصحابة، روى عنه: أهل المدينة، مات سنة تسع وثلاثين ومائة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن علي بن أبي رافع(@)(@@) مولى رسول الله صلى الله عليه وسلم سمع جده أبا رافع، روى عنه: أهل المدينة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن مسلم بن يسار(@)(@@) أدرك أنس بن مالك، روى عنه: أهل البصرة، أبوه مولى طلحة بن عبيد الله، وقد ذكرناه في التابعين في باب الميم إن شاء الله.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن حفص(@)(@@) يروي عن: يعلى بن مرة، روى عنه: عطاء بن السائب.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن أبي عباد(@)(@@) يروي عن: جابر بن سمرة، روى عنه: فرات القزاز.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن الأحوص(@)(@@) يروي عن: زيد بن ثابت، روى عنه: سليمان بن يسار، وقد روى الزهري، عن منصور بن عبد الله بن الأحوص، عن أبيه.(@)PageV01P002(@)(@@) [ج 2: ص 294](@)(@@)(@@)(@@) ||| AUTO عبد الله التميمي(@)(@@) يروي عن: عمر، روى عنه: عدي بن ثابت.(@)(@@)(@@)(@@) ||| AUTO عبد الله أبو الصهباء الباهلي(@)(@@) والد عقبة بن عبد الله الأصم، يروي عن: علي بن أبي طالب، وعائشة، عداده في أهل البصرة، روى عنه: ابنه عقبة بن الأصم.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن الحارث(@)(@@) مولى بني قيس بن ثعلبة، يروي عن: علي، روى عنه: عمرو بن مرة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عامر بن ربيعة(@)(@@) يروي عن: عائشة، روى عنه: يحيى بن سعيد الأنصاري.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن ربيعة(@)(@@) يروي عن: عبيد بن خالد، وله صحبة، روى عنه: منصور، وعطاء بن السائب.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن أبي إسحاق(@)(@@) عن: أنس، عداده في أهل البصرة، روى عنه: أهلها، مات سنة تسع وعشرين ومائة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن عياش بن أبي ربيعة المخزومي(@)(@@) يروي عن: عمر بن الخطاب، روى عنه: سليمان بن يسار، ومحمد بن طلحة بن يزيد بن ركانة، وهو الذي يقول: مر بي أبو ذر وأنا أصلي، فقال: " إن الأرض لا تمسح إلا مسحة ". وليس هذا بعبد الله بن الحارث بن عياش بن 
ms620	 أبي ربيعة، ذلك من أتباع التابعين، روى عنه: أهل المدينة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن حكل(@)(@@) يروي عن: رجل من أصحاب النبي صلى الله عليه وسلم روى عنه: خالد بن معدان.(@)PageV01P002(@)(@@) [ج 2: ص 295](@)(@@)(@@)(@@) ||| AUTO عبد الله بن أبي سفيان السلولي(@)(@@) يروي عن: أبي زيد عمرو بن أخطب، وله صحبة، روى عنه: موسى بن أبي عائشة.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن يعيش(@)(@@) يروي عن: أبي أيوب الأنصاري، روى عنه: القاسم بن مخيمرة من حديث يزيد بن جابر، والخبر عنده عن القاسم بن مخيمرة، عن عبد الله بن يعيش، عن أبي أيوب، وعنده أيضا عن مكحول، عن عبد الله بن يعيش، عن أبي أيوب.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن حميد أبو عمار الهمداني(@)(@@) يروي عن: حذيفة، عداده في أهل الكوفة، روى عنه: الأعمش.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن أبي عبد الله الدمشقي(@)(@@) يروي عن: الضحاك بن قيس، روى عنه: ابن ابنه الهيثم بن عمران.(@)(@@)(@@)(@@) ||| AUTO عبد الله بن شفيع الطبيب(@)(@@) كان يقطع عرق النسا لأسيد بن حضير، روى عنه: محمود بن لبيد الأنصاري.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن عمر بن الخطاب العدوي القرشي(@)(@@) أمه بنت حارثة بن وهب الخزاعي، قتل يوم صفين، وكان مع معاوية.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن عبد الله بن عتبة بن مسعود الهذلي الأعمى، كنيته أبو عبد الله(@)(@@) من سادات التابعين، وكان يعد من الفقهاء السبعة، وربما قال الشعر، يروي عن: ابن عباس، وأبي هريرة، وجماعة، روى عنه: الزهري، والناس، مات سنة ثمان وتسعين، وقد قيل: إنه مات قبل علي بن الحسين، وعلي مات سنة تسع وتسعين بعد أن كف، وأمه أم ولد.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن عبد الله بن عمر بن الخطاب العدوي(@)(@@) يروي عن: أبيه، عداده في PageV01P002 [ج 2: ص 296] أهل المدينة، روى عنه: الزهري، ومحمد بن جعفر بن الزبير، مات قبل سالم بن عبد الله بسنة، وكان هو وسالم من أم واحدة أمهما أم ولد.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن أبي بكرة الثقفي(@)(@@) يروي عن: أبيه، وكان والى زياد، عداده في أهل البصرة، 