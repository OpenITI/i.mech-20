ms61	 النواظم % 12(@)(@@) % عشية لو تلقى الوشاة لبينت % عيون الهوى ذات الصدور الكواتم % 13(@)(@@) % عهدنا بها لو تسعف العوج بالهوى % % رقاق الثنايا واضحات المعاصم % 14(@)(@@) % هجان جعلن السور والعاج والبرى % % على مثل بردي البطاح النواعم % 15(@)(@@) % إذا الخز تحت الأتحميات لثنه % بمردفة الأفخاذ ميل المآكم % 16(@)(@@) % لحفن الحصى أنياره ثم خضنه % نهوض الهجان الموعثات الجواشم % 17(@)(@@) % رويدا كما اهتزت رماح تسفهت % أعاليها مر الرياح النواسم % 18(@)(@@) % إذا غاب عنهن الغيوران تارة % وعنا وأيام النحوس الأشائم % 19(@)(@@) % أرين الذي استودعن سودآء قلبه % % هوى مثل شك الأزأني النواجم % 20(@)(@@) % عيون المها والمسك يندى عصيمه % على كل خد مشرق غير واجم % PageV01P186 21(@)(@@) % وحوا تجلي عن عذاب كأنها % % إذا نغمة جاوبنها بالجماجم % 22(@)(@@) % ذرى أقحوان الرمل هزت فروعه % صبا طلة بين الحقوف اليتائم % 23(@)(@@) % كأن الرقاق الملحمات ارتجعنها % % على حنوة القريان تحت الهمآئم % 24(@)(@@) % وريح الخزامى رشها الطل بعدما % % دنا الليل حتى مسها بالقوادم % 25(@)(@@) % أولا ئك آجال الفتى إن أردنه % بقتل وأسباب السقام الملازم % 26(@)(@@) % يقربن حتى يطمع التابع الصبى % % وتهتز أحشاء القلوب الحوائم % 27(@)(@@) % حديثا كطعم الشهد حلوا صدوره % وأعجازه الخطبان دون المحارم % 28(@)(@@) % وهن إذا ما قارف القول ريبة % % 29(@)(@@) % تجوز منها زائر بعد ما دنت % من الغور أرداف النجوم العوائم % 30(@)(@@) % إلى هاجع في مسلهمين وقعوا % % إلى جنب أيدي يعملات سواهم % PageV01P187 31(@)(@@) % إذا قال : يا . . . ، قد حل ديني ؛ قضينه % أماني عند الزاهرات العواتم % 32(@)(@@) % وكائن نضت من جوز رمل وجاوزت % إليك المهارى من رعان المخارم % 33(@)(@@) % ومجهولة تيهاء تغضي عيونها % % على البعد إغضاء الدوى غير نائم % 34(@)(@@) % فلاة مروراة ترامى إذا مرت % بها الآل أيدي المصغيات الرواسم % 35(@)(@@) % قطعت بصهباء العثانين أسأرت % سرى الليل منها آل قرم ضبارم % 36(@)(@@) % تراهن بالأكوار يخفضن تارة % وينصبن أخرى مثل وخد النعائم % 37(@)(@@) % من الأدمى والرمل حتى كأنها % % قسي برايا بعد خلق ضبارم % 38(@)(@@) % ورحلي على عوجاء حرف شملة % من الجرشعيات العظام المحازم % 39(@)(@@) % غريرية صهبآء فيها تعيس % وسوج إذا اغبرت أنوف المخارم % 40(@)(@@) % كأن 
ms62	 ارتحال الركب يرمي برحلها % % على بازل قرم جلال علاكم % PageV01P188 41(@)(@@) % طوي البطن عافي الظهر أقصى صريفه % عن الشول شذان البكار العوارم % 42(@)(@@) % إذا شم أنف البرد ألحق بطنه % مراس الأوابي وامتحان الكواتم % 43(@)(@@) % أقول لدهناوية عوهج جرت % لنا بين أعلى عرفة فالصرائم % 44(@)(@@) % أيا ظبية الوعساء بين جلاجل % وبين النقا آأنت أم أم سالم % 45(@)(@@) % هي الشبه إلا مدرييها وأذنها % % سواء وإلا مشقة في القوائم % 46(@)(@@) % أعاذل إن ينهض رجائي بصدره % إلى ابن حريث ذي الندى والمكارم % 47(@)(@@) % فرب امرئ تنزو من الخوف نفسه % جلا الغم عنه ضوء وجه الملازم % 48(@)(@@) % أغر لجيمي كأن قميصه % على نصل صافي نقبة اللون صارم % 49(@)(@@) % يوالي إذا اصطك الخصوم أمامه % وجوه القضايا من وجوه المظالم % 50(@)(@@) % صدوع بحكم الله في كل شبهة % ترى الناس في ألباسها كالبهائم % PageV01P189 51(@)(@@) % سقى الله من حي حنيفة إنهم % مساميح ضرابون هام الجماجم % 52(@)(@@) % أناس أصدوا الناس بالضرب عنهم % صدود السواقي عن رؤوس المخارم % 54(@)(@@) % هم قرنوا بالبكر عمرا وأنزلوا % % بأسيافهم يوم العروض ابن ظالم % 55(@)(@@) % مقار إذا العام المسمى تزعزعت % بشفانه هوج الرياح العقآئم % 56(@)(@@) % أحار بن عمرو لامرئ القيس تبتغي % % بشتمي إدراك العلى والمكارم % 57(@)(@@) % كأن أباها نهشل أو كأنها % % بشقشقة من رهط قيس بن عاصم % 58(@)(@@) % وغير امرئ القيس الروابي وغيرها % % يداوى به صدع الثأى المتفاقم % 59(@)(@@) % عذرت الذرى لو خاطرتني قرومها % % فما بال أكارين فدع القوائم % 60(@)(@@) % بني آبق من أهل حوران لم يكن % ظلوما ولا مستنكرا للمظالم % PageV01P190 البحر : بسيط تام 1(@)(@@) % زرق العيون إذا جاورتهم سرقوا % % ما يسرق العبد أو نابأتهم كذبوا % % 2(@)(@@) % تيك امرؤ القيس محمرا عنافقها % % كأن آنفها فوق اللحى الصلب % PageV01P191 البحر : طويل 1(@)(@@) % خليلي عوجا عوجة ناقتيكما % % على طلل بين القلات وشارع % 2(@)(@@) % به ملعب من معصفات نسجنه % كنسج اليماني برده بالوسآئع % 3(@)(@@) % وقفنا فقلنا إيه عن أم سالم % وما بال تكليم الديار البلاقع % 4(@)(@@) % فما كلمتنا دارها غير أنها % % ثنت هاجسات من خيال مراجع % 5(@)(@@) % ظللت كأني واقف عند 
ms63	 رسمها % % بحاجة مقصور له القيد نازع % 6(@)(@@) % تذكر دهر كان يطوي نهاره % رقاق الثنايا غافلات الطلائع % 7(@)(@@) % عفت غير آجال الصريم وقد يرى % % بها وضح اللبات حور المدامع % 8(@)(@@) % كأنا رمتنا بالعيون التي بدت % جآذر حوضى من جيوب البراقع % 9(@)(@@) % إذا الفاحش المغيار لم يرتقبنه % مددن حبال المطمعات الموانع % 10(@)(@@) % تمنيت بعد النأي من أم سالم % بها بعض ريعات الديار الجوامع % PageV01P192 11(@)(@@) % فما القرب يشفي من هوى أم سالم % وما البعد منها من دوآء بنافع % 12(@)(@@) % من البيض مبهاج عليها ملاحة % نضار وريعان الحسان الروآئع % 13(@)(@@) % هي الشمس إشراقا إذا ما تزينت % وشبه النقا مغترة فى الموادع % 14(@)(@@) % ولما تلاقينا جرت من عيوننا % % دموع كففنا مآءها بالأصابع % 15(@)(@@) % ونلنا سقاطا من حديث كأنه % جنى النحل ممزوجا بماء الوقائع % 16(@)(@@) % فدع ذا ولكن رب وجنآء عرمس % دواء لغول النازح المتواضع % 17(@)(@@) % زجول برجليها نهوز برأسها % % إذا ائتزر الحادي ائتزار المصارع % 18(@)(@@) % كأن الولايا حين يطرحن فوقها % % على ظهر برج من ذوات الصوامع % 19(@)(@@) % قطعت بها أرضا ترى وجه ركبها % % إذا ما علوها مكفأ غير ساجع % 20(@)(@@) % كأن قلوب القوم من وجل بها % % هوت في خوافي مطعمات لوامع % PageV01P193 21(@)(@@) % من الزرق أو صقع كأن رؤوسها % % من القهز والقوهي بيض المقانع % 22(@)(@@) % إذا قال حادينا لتشبيه نبأة % صه لم يكن إلا دوي المسامع % 23(@)(@@) % كأني ورحلي فوق أحقب لاحه % من الصيف شل المخلفات الرواجع % 24(@)(@@) % ممر أمرت متنه أسدية % يمانية حلت جنوب المضاجع % 25(@)(@@) % دعاها من الأصلاب أصلاب شنظب % أخاديد عهد مستحيل المواقع % 26(@)(@@) % كسا الأرض بهمى غضة حبشية % تؤاما ونقعان الظهور الأقارع % 27(@)(@@) % وبالروض مكنان كأن حديقه % زرابي وشتها أكف الصوانع % 28(@)(@@) % إذا استنصل الهيف السفا برحت به % % عراقية الأقياظ نجد المرابع % 29(@)(@@) % موشحة حقب كأن ظهورها % % صفا رصف مجرى سيول دوافع % 30(@)(@@) % فلما رأى الرائي الثريا بسدفة % ونشت نطاف المبقيات الوقائع % PageV01P194 31(@)(@@) % وساقت حصاد القلقلان كأنما % % هو الخشل أعراف الرياح الزعازع % 32(@)(@@) % تردفن خرشوما تركن بمتنه % كدوحا كآثار الفؤوس القواطع % 33 
ms64	(@)(@@) % ومن آئل كالورس نضحا كسونه % متون الصفا من مضمحل وناقع % 34(@)(@@) % على ذروة الصلب الذي واجه المعا % % سواخط من بعد الرضا للمراتع % 35(@)(@@) % صياما تذب البق عن نخراتها % % بنهز كإيماء الرؤوس الموانع % 36(@)(@@) % يذببن عن أقرابهن بأرجل % وأذناب زعر الهلب زرق المقامع % 37(@)(@@) % فلما رأين الليل والشمس حية % حياة الذي يقضي حشاشة نازع % 38(@)(@@) % نحاها لثأج نحوة ثم إنه % توخى بها العينين عيني متالع % 39(@)(@@) % إذا واضخ التقريب واضخن مثله % وإن سح سحا خذرفت بالأكارع % 40(@)(@@) % وعاورنه من كل قاع هبطنه % جهامة جون يتبع الريح ساطع % PageV01P195 41(@)(@@) % فما انشق ضوء الصبح حتى تعرفت % جداول أمثال السيوف القواطع % 42(@)(@@) % فلما رأين الماء قفرا جنوبه % ولم يقض إكراء العيون الهواجع % 43(@)(@@) % فحومن واستنفضن من كل جانب % وبصبصن بالأذناب حول الشرائع % 44(@)(@@) % صففن الخدود والنفوس نواشز % على شط مسجور صخوب الضفادع % 45(@)(@@) % فخضخضن برد الماء حتى تصوبت % على الهول في الجاري شطور المذارع % 46(@)(@@) % يداوين من أجوافهن حرارة % بجرع كأثباج القطا المتتابع % 47(@)(@@) % فلما نضحن الماء أنصاف نضحه % بجون لأدوآء الصرآئر قاصع % 48(@)(@@) % توجسن ركزا من خفي مكانه % وإرنان إحدى المعطيات الموانع % 49(@)(@@) % يحاذرن أن يسمعن ترنيم نبعة % حدت فوق حشر بالفريصة واقع % 50(@)(@@) % % وإلا زجوما سهوة في الأصابع % PageV01P196 51(@)(@@) % فأجلين عن حتف المنية بعدما % % دنا دنوة المنصاع غير المراجع % 52(@)(@@) % فجالت على الوحشي تهوي كأنما % % بروق تحاكى أو أصابع لامع % 53(@)(@@) % أولئك أشباه القلاص التي طوت % بنا البعد من نعفي قسا فالمضاجع % 54(@)(@@) % لأخفافها بالليل وقع كأنه % على البيد ترشاف الظماء السوابع % 55(@)(@@) % أغذ بها الإدلاج كل شمردل % من القوم ضرب اللحم عاري الأشاجع % 56(@)(@@) % فما أبن حتى إضن أنقاض شقة % حراجيج واحدودبن تحت البراذع % 57(@)(@@) % فطارت برود العصب عنا وبدلت % شحوبا وجوه الواضحين السمادع % 58(@)(@@) % تجلى السرى عن كل خرق كأنه % صفيحة سيف طرفه غير خاشع % 59(@)(@@) % تغلس أسدام المياه وتختطي % % معان المها والمرئلات الخواضع % 60(@)(@@) % بمجلوزة الأفخاذ بعد اقورارها % % مؤللة الآذان عفر نزائع % PageV01P197 61(@)(@@) % مضبرة شم أعالي عظامها % % معرقة الألحي 
ms65	 طوال الأخادع % 62(@)(@@) % إذا ما نضونا جوز رمل علت بنا % % طريقة قف مبرح بالرواكع % 63(@)(@@) % ترى رعنه الأقصى كأن قموسه % تحامل أحوى يتبع الخيل ظالع % 64(@)(@@) % وحسرت عنها الني حتى تركتها % % على حال إحدى المنضيات الضوارع % 65(@)(@@) % إذا اغتبقت نجما فغار تسحرت % علالة نجم آخر الليل طالع % 66(@)(@@) % إذا ماعددنا ياابن بشر ثقاتنا % % عددتك في نفسي بأولى الأصابع % 67(@)(@@) % أغر ضياء من أمية أشرفت % به الذروة العليا على كل يافع % 68(@)(@@) % أتتناك نرجو من نوالك نفحة % تكون كأعوام الحيا المتتابع % 71(@)(@@) % فجاد كما جاد الفؤاد فإنما % % يداه كغيث في البرية واسع % PageV01P198 البحر : بسيط تام 1(@)(@@) % أمنكر أنت ربع الدار عن عفر % لا بل عرفت فدمع العين مسكوب % 2(@)(@@) % بالأشيمين انتحاها بعد ساكنها % % هيج من النجم والجوزآء مهبوب % 3(@)(@@) % قفرا كأن أراعيل النعام به % قبائل الزنج والحبشان والنوب % 4(@)(@@) % هيهات خرقآء إلا أن يقربها % % ذو العرش والشعشعانات الهراجيب % % 5(@)(@@) % من كل نضاخة الذفرى يمانية % كأنها أسفع الخدين مذؤوب % 6(@)(@@) % إذا اكتست عرقا جونا على عرق % يضحي بأعطافها منه جلابيب % 7(@)(@@) % تختال بالبعد من حادي صواحبها % % إذا ترقص بالآل الأنابيب % 8(@)(@@) % كم دون مية من خرق ومن علم % كأنه لامع عريان مسلوب % 9(@)(@@) % ومن ملمعة غبرآء مظلمة % ترابها بالشعاف الغبر معصوب % 10(@)(@@) % كأن حربآءها في كل هاجرة % ذو شيبة منء رجال الهند مصلوب % PageV01P199 البحر : طويل 1(@)(@@) % وقفت على ربع لمية ناقتي % % فما زلت أبكي عنده وأخاطبه % 2(@)(@@) % وأسقيه حتى كاد مما أبثه % تكلمني أحجاره وملاعبه % 3(@)(@@) % بأجرع مقفار بعيد من القرى % % فلاة وحفت بالفلاة جوانبه % 4(@)(@@) % به عرصات الحي قوبن متنه % وجرد أثباج الجراثيم حاطبه % 5(@)(@@) % تمشي به الثيران كل عشية % كما اعتاد بيت المرزبان مرازبه % 6(@)(@@) % كأن سحيق المسك ريا ترابه % إذا هضبته بالطلال هواضبه % 7(@)(@@) % إذا سير الهيف الصهيل وأهله % من الصيف عنه أعقبته نوازبه % 8(@)(@@) % نظرت إلى أظعان مي كأنها % % مولية ميس تميل ذوائبه % 9(@)(@@) % فأبديت من عيني والصدر كاتم % بمغرورق نمت عليه سواكبه % 10(@)(@@) % هوى آلف جآء الفراق 
ms66	 فلم تجل % جوآئلها أسراره ومعاتبه % PageV01P200 11(@)(@@) % ظعآئن لم يحللن إلا تنوفة % عذاة إذا ما البرد هبت حنائبه % 12(@)(@@) % تعرجن بالصمان حتى تعذرت % عليهن أرباع اللوى ومشاربه % 13(@)(@@) % وحتى رأين القنع من فاقىء السفا % % قد انتسجت قريانه ومذانبه % 14(@)(@@) % ولا زال في أرضي عدو أحاربه % أساريع معروف وصرت جنادبه % 15(@)(@@) % فأصبحن بالجرعاء جرعاء مالك % وآل الضحى تزهى الشبوح سبائبه % 16(@)(@@) % فلما عرفنا آية البين بغتة % وردت لأحداج الفراق ركائبه % 17(@)(@@) % وقربن للأظعان كل موقع % من البزل يوفي بالحوية غاربه % 18(@)(@@) % ولم يستطع إلف لإلف تحية % من الناس إلا أن يسلم حاجبه % 19(@)(@@) % تراءى لنا من بين سجفين لمحة % غزال أحم العين بيض ترائبه % 20(@)(@@) % إذا نازعتك القول مية أو بدا % % لك الوجه منها أو نضا الدرع سالبه % PageV01P201 21(@)(@@) % فيا لك من خد أسيل ومنطق % رخيم ومن خلق تعلل جادبه % 22(@)(@@) % ألا لا أرى مثل الهوى دآء مسلم % كريم ولا مثل الهوى ليم صاحبه % 23(@)(@@) % متى يعصه تبرح معاصاته به % وإن يتبع أسبابه فهو غالبه % 24(@)(@@) % متى تظعني يا مي عن دار جيرة % لنا والهوى برح على من يغالبه % 25(@)(@@) % أكن مثل ذي الألاف لزت كراعه % إلى أختها الأخرى وولى صواحبه % 26(@)(@@) % تقاذفن أطلاقا وقارب خطوه % عن الذود تقييد وهن حبائبه % 27(@)(@@) % نأين فلا يسمعن إن حن صوته % ولا الحبل منحل ولا هو قاضبه % 28(@)(@@) % وأشعث قد قايسته عرض هوجل % سوآء علينا صحوه وغياهبه % 29(@)(@@) % ومخترق خاوي الممر قطعته % بمنعقد خلف الشراسيف حالبه % 30(@)(@@) % يكاد من التصدير ينسل كلما % % ترنم أو مس العمامة راكبه % PageV01P202 31(@)(@@) % طويل النسا والأخدعين عذافر % مضبرة أوراكه ومناكبه % 32(@)(@@) % كأن يماميا طوى فوق ظهره % صفيحا يداني بينه ويقاربه % 33(@)(@@) % إذا عجت منه أو رأى فوق رحله % تحرك شيء ظن أني ضاربه % 34(@)(@@) % كأني ورحلي فوق سيد عانة % من الحقب زمام تلوح ملاحبه % 35(@)(@@) % رعى موقع الوسمي حيث تبعقت % عزالي السواحي وارثعنت هواضبه % 36(@)(@@) % له واحف فالصلب حتى تقطعت % خلاف الثريا من أريك مآربه % 37(@)(@@) % يقلب بالصمان قودا جريدة 
ms67	 % ترامى به قيعانه وأخاشبه % 38(@)(@@) % ويوم يزير الظبي أقصى كناسه % وتنزو كنزو المعلقات جنادبه % 39(@)(@@) % أغر كلون الملح ضاحي ترابه % إذا استوقدت حزانه وسباسبه % 40(@)(@@) % تلثمت فاستقبلت من عنفوانه % أوارا إذا ما أسهل استن حاصبه % PageV01P203 41(@)(@@) % إذا جعل الحرباء يبيض لونه % ويخضر من لفح الهجير غباغبه % 42(@)(@@) % ويشبح بالكفين شبحا كأنه % أخو فجرة عالى به الجذع صالبه % 43(@)(@@) % على ذات ألواح طوال وكاهل % أنافت أعاليه ومارت مناكبه % 44(@)(@@) % وأعيس قد كلفته بعد شقة % تعقد منه أبيضاه وحالبه % 45(@)(@@) % متى يبلني الدهر الذي يرجع الفتى % % على بدئه أو تشتعبني شواعبه % 47(@)(@@) % ركبت به عوصاء ذات كريهة % وزورآء حتى يعرف الضيم جانبه % 48(@)(@@) % وأزور يمطو في بلاد عريضة % تعاوى به ذؤبانه وثعالبه % 49(@)(@@) % إلى كل ديار تعرفن شخصه % من القفر حتى تقشعر ذوائبه % 50(@)(@@) % تعسفته أسري على كور نضوة % تعاطي زمامي تارة وتجاذبه % 52(@)(@@) % أخو قفرة مستوحش ليس غيره % ضعيف النداء أصحل الصوت لاغبه % PageV01P204 53(@)(@@) % % من الليل جوز واسبطرت كواكبه % 54(@)(@@) % % إلى كوكب يزوي له الوجه شاربه % 55(@)(@@) % % إلى المآء حتى انقد عنها طحالبه % 56(@)(@@) % فجاءت بسجل طعمه من أجونه % كما شاب للمورود بالبول شائبه % 57(@)(@@) % وجاءت بنسج من صناع ضعيفة % تنوس كأخلاق الشفوف ذعالبه % 58(@)(@@) % هي انتسجته وحدها أو تعاونت % على نسجه بين المثاب عناكبه % 59(@)(@@) % دفقناه في بادي النشيئة داثر % قديم بعهد الناس بقع نصآئبه % 60(@)(@@) % على ضمر هيم فراو وعائف % ونائل شيء سيء الشرب قاصبه % 61(@)(@@) % سحيرا وآفاق السماء كأنها % % بها بقر أفتآؤه وقراهبه % 62(@)(@@) % تؤم فتى من آل مروان أطلقت % يداه وطابت في قريش مضاربه % PageV01P205 63(@)(@@) % % بنا مصدرا والقرن لم يبد حاجبه % 64(@)(@@) % ألا رب من يهوى وفاتي ولو أتت % وفاتي لذلت للعدو مراتبه % 65(@)(@@) % وقآئلة تخشى علي أظنه % سيودي به ترحاله ومذاهبه % PageV01P206 البحر : طويل 1(@)(@@) % أتعرف دار الحي بادت رسومها % % عفت بعدنا جرعاؤها وهشومها % % 2(@)(@@) % وأقفر عهد الدار من أم سالم % وأقصر عن طول التقاضي غريمها % % 3(@)(@@) % أطلت علينا كل يوم مقالة % غذائر لا يقضى لخير صريمها 
ms68	 % % 4(@)(@@) % لك الخير كم كلفت عيني عبرة % إذا انحدرت عادت سريعا جمومها % % 5(@)(@@) % وكلقتني من سير ظلماء والدجا % % يصيح الصدى فيها ويضبح بومها % % 6(@)(@@) % بمائرة الضبعين معوجة النسا % % يشج الحصا تخويدها ورسيمها % % 7(@)(@@) % وخودا إذا ما الشاة لاذ من اللظى % % بعبرية أو ضالة لا يريمها % % 8(@)(@@) % يلوذ حذار الشمس فيها ويتقي % % بها الريح إذا هبت عليه سمومها % % PageV01P207 البحر : طويل 1(@)(@@) % أمن دمنة جرت بها ذيلها الصبا % % لصيداء - مهلا - ماء عينيك سافح % 2(@)(@@) % ديار التي هاجت خبالا لذي الهوى % % كما هاجت الشأو البروق اللوامح % 3(@)(@@) % بحيث استفاض القنع غربي واسط % نهآء ومجت في الكثيب الأباطح % 4(@)(@@) % حدا بارح الجوزاء أعراف موره % بها وعجاج العقرب المتناوح % 5(@)(@@) % ثلاثة أحوال وحولا وستة % كما جرت الريط العذارى الموارح % 6(@)(@@) % جرى أدعج الروقين والعين واضح ال % قرا أسفع الخدين بالبين بارح % 7(@)(@@) % بتفريق طيات تياسرن قلبه % وشق العصا من عاجل البين قادح % 8(@)(@@) % غداة امترى الغادون بالشوق عبرة % جموما لها في أسود العين مآئح % 9(@)(@@) % لعمرك والأهواء من غير واحد % ولا مسعف بي مولعات سوانح % 10(@)(@@) % لقد منح الود الذي ما ملكته % على النأي ميا من فؤادك مانح % PageV01P208 11(@)(@@) % وإن هوى صيدآء في ذات نفسه % بسائر أسباب الصبابة راجح % 12(@)(@@) % لعمرك ما أشواني البين إذ غدا % % بصيدآء مجذوذ من الوصل جامح % 13(@)(@@) % ولم يبق مما كان بيني وبينها % % من الود إلا ما تجن الجوانح % 14(@)(@@) % وما ثعب باتت تصفقه الصبا % % قرارة نهي أتأقته الروآئح % 15(@)(@@) % بأطيب من فيها ولا طعم قرقف % برمان لم ينظر بها الشرق صابح % 16(@)(@@) % أصيداء هل قيظ الرمادة راجع % لياليه أو أيامهن الصوالح % 17(@)(@@) % سقى دارها مستمطر ذو غفارة % أجش تحرى منشأ العين رآئح % 18(@)(@@) % هزيم كأن البلق مجنوبة به % % يحامين أمهارا فهن ضوارح % 19(@)(@@) % إذا ما استدرته الصبا وتذآءبت % يمانية تمري الذهاب المنآئح % 20(@)(@@) % وإن فارقته فرق المزن شايعت % به مرجحنات الغمام الدوالح % PageV01P209 21(@)(@@) % عدا النأي عن صيدآء حينا وقربها % % إلينا ولكن ما إلى ذاك رابح % 22(@)(@@) % سوآء عليك اليوم 
ms69	 أنصاعت النوى % % بصيدآء أم أنحى لك السيف ذابح % 23(@)(@@) % ألا طالما سؤت الغيور وبرحت % بي الأعين النجل المراض الصحائح % 24(@)(@@) % وساعفت حاجات الغواني وراقني % % على البخل رقراقاتهن الملائح % 25(@)(@@) % وسايرت ركبان الصبى واستهشني % % مسرات أضغان القلوب الطوامح % 26(@)(@@) % إذا لم نزرها من قريب تناولت % بنا دار صيداء القلاص الطلائح % 27(@)(@@) % محانيق ينفضن الخدام كأنها % % نعام وحاديهن بالخرق صادح % 28(@)(@@) % وهاجرة غرآء ساميت حدها % % إليك وجفن العين بالمآء سافح % 29(@)(@@) % وتيه خبطنا غولها وارتمى بنا % % أبو البعد من أرجائه المتطاوح % 30(@)(@@) % فلاة لصوت الجن في منكراتها % % هزيز وللأبوام فيها نوابح % PageV01P210 31(@)(@@) % إذا ما ارتمى لحياه ياءين قطعت % نطاف المراح الضامنات القوارح % 32(@)(@@) % % ذوات البرى والركب والظل ماصح % 33(@)(@@) % ترى الناعجات الأدم ينحى خدودها % % سوى قصد أيديها سعار مكافح % 34(@)(@@) % لظى تلفح الحربآء حتى كأنه % أخو جرمات بز ثوبيه شابح % 35(@)(@@) % إذا ذات أهوال ثكول تغولت % بها الربد فوضى والنعام السوارح % 36(@)(@@) % تبطنتها والقيظ ما بين جالها % % إلى جالها سترا من الآل ناصح % 37(@)(@@) % بمقورة الألياط عوج من البرى % % تساقط في آثارهن السرآئح % 38(@)(@@) % نهزن العنيق الرسل حتى أملها % % عراض المثاني والوجيف المراوح % 39(@)(@@) % وترجاف ألحيها إذا ما تنصبت % على رافع الآل التلال الزراوح % 40(@)(@@) % وطول اغتماسي في الدجا كلما دعت % من الليل أصداء المتان الضوابح % PageV01P211 41(@)(@@) % وسيري وأعرآء المتان كأنها % % إضآء أحست نفح ريح ضحاضح % 42(@)(@@) % على حميريات كأن عيونها % % ذمام الركايا أنكزتها المواتح % 43(@)(@@) % محانيق تضحي وهي عوج كأنها % % بجوز الفلا مستأجرات نوآئح % 44(@)(@@) % موارق من داج حدا أخرياته % وما بتن معروف السماوة واضح % 45(@)(@@) % تراءى كوجه الصدع في منصف الصفا % % بحيث المها والملقيات الروازح % 46(@)(@@) % تجلى السرى عني وعن شدنية % طواء يداها للفلا وهو نازح % 47(@)(@@) % إذا انشقت الظلمآء أضحت كأنها % % وأى منطو باقي الثميلة قارح % 48(@)(@@) % من الحقب لاحته برهبى مربة % تهز السفا والمرتجات الروامح % 49(@)(@@) % رعى مهراق المزن من حيث أدجنت % مرابيع دلوياتهن النواضح % 50(@)(@@) % جدا قضة الآساد وارتجزت له % بنوء السماكين الغيوث الروائح % PageV01P212 51(@)(@@) % عناق فأعلى 
ms70	 واحفين كأنه % من البغى للأشباح سلم مصالح % 52(@)(@@) % يصادي بنتي قفر عقيما مغارة % وطيا أجنت فهي للحمل ضارح % 53(@)(@@) % نحوصين حقباوين غار عليهما % % طوي البطن مسحوج المقذين سابح % 54(@)(@@) % إذا الجازئات القمر أصبحن لا يرى % % سواهن أضحى وهو بالقفر باجح % 55(@)(@@) % تتلين أخرى الجزء حتى إذ انقضت % بقاياه والمستمطرات الروآئح % 56(@)(@@) % دعاهن من ثأج فأزمعن ورده % أو الأصهبيات العيون السوائح % 57(@)(@@) % فظلت بأجماد الزجاج سواخطا % صياما تغني تحتهن الصفآئح % 58(@)(@@) % يعاورن حد الشمس خزرا كأنها % % قلات الصفا عادت عليها المقادح % 59(@)(@@) % فلما لبسن الليل أو حين نصبت % له من خذا آذانها وهو جانح % 60(@)(@@) % حداهن شحاج كأن سحيله % على حافتيهن رتجاز مفاضح % PageV01P213 61(@)(@@) % يحاذرن من أدفى إذا ما هو نتحى % % عليهن لم تنج الفرود المشآئح % 62(@)(@@) % كما صعصع البازي القطا أو تكشفت % عن المقرم الغيران عيط لواقح % 63(@)(@@) % فجاءت كذود الخاربين يشلها % % مصك تهاداه صحار صرادح % 64(@)(@@) % وقد أسهرت ذا أسهم بات طاويا % له فوق زجي مرفقيه وحاوح % 65(@)(@@) % له نبعة عطوى كأن رنينها % % بألوى تعاطته الأكف المواسح % 66(@)(@@) % تفجع ثكلى بعد وهن تخرمت % بنيها بأمس الموجعات القرائح % 67(@)(@@) % أخا شقوة يرمي على حيث تلتقي % % من الصفحة اليسرى صحار وواضح % 68(@)(@@) % فلما ستوت آذانها في شريعة % لها غيلم للبتر فيها صوآئح % 69(@)(@@) % تنحى لأدناها فصادف سهمه % بخاطئة من جانب الكيح ناطح % 70(@)(@@) % فأجلين إن يعلون متنا يثرنه % أو الأكم ترفض الصخور الكوابح % PageV01P214 71(@)(@@) % ينصبن جونا من عبيط كأنه % حريق جرت فيه الرياح النوافح % 72(@)(@@) % فأصبحن يطلعن النجاد وترتمي % % بأبصارهن المفضيات الفواسح % PageV01P215 البحر : طويل 1(@)(@@) % ألا ظعنت مي فهاتيك دارها % % بها السحم تردي والحمام الموشم % 2(@)(@@) % كأن أنوف الطير في عرصاتها % % خراطيم أقلام تخط وتعجم % 3(@)(@@) % ألا لا أرى مثلي يحن من الهوى % % ولا مثل هذا الشوق ولا يتصرم % 4(@)(@@) % ولا مثل ما ألقى إذا الحي فارقوا % % على أثر الأظعان يلقاه مسلم % 5(@)(@@) % كفى حزة في النفس يا مي إنني % % وإياك في الأحياء لا نتكلم % 6(@)(@@) % أزور حواليك البيوت كأنني % % إذا 
ms71	 جئت عن إتيان بيتك محرم % 7(@)(@@) % ونقض كريم النضو ناج زجرته % إذا العين كادت من سرى الليل تعسم % 8(@)(@@) % ولم يك إلا في السماء لمدلج % لمثل الذي يعلو من الأرض معلم % 9(@)(@@) % جلال خفيف الحلم حين تروعه % إذا جعلت هوج المراسيل تحلم % 10(@)(@@) % إذا لحمه لم يبق إلا سواده % وساد القرى عظم السراة المقدم % PageV01P216 11(@)(@@) % إذا عجت منه لج وهم ومشرف % طويل اللجان أهدل الشدق سرطم % 12(@)(@@) % صموت إذا التصدير في صعدآئه % تصعد إلا أنه يتزغم % 13(@)(@@) % وخوصآء قد كلفتها الهم دونه % من البعد شهرا للمراسيل مجذم % 14(@)(@@) % مصابيحه خوص العيون كأنها % % قطا خامس سرى به متيمم % 15(@)(@@) % حراجيج مما ذمرت في نتاجها % % بناحية الشحر الغرير وشدقم % 16(@)(@@) % قليل على أكوارهن اتقآؤنا % % صلا القيظ إلا أننا نتلثم % 17(@)(@@) % إذا ما الأريم الفرد ظل كأنه % زميلة رتاك من الجون يرسم % PageV01P217 البحر : طويل 1(@)(@@) % أخرقاء للبين استقلت حمولها % % نعم غربة فالعين يجري مسيلها % % 2(@)(@@) % كأن لم يرعك الدهر بالبين قبلها % % لمي ولم تشهد فراقا يزيلها % % 3(@)(@@) % بلى فاستعار القلب يأسا ومانحت % على إثرها عين طويل همولها % % 4(@)(@@) % كأني أخو جريالة بابلية % من الراح دبت في العظام شمولها % % 5(@)(@@) % غداة اللوى إذ راعني البين بغتة % ولم يود من خرقآء شيئا قتيلها % % 6(@)(@@) % ولا مثل وجدي يوم جرعاء مالك % وجمهور حزوى يوم سارت حمولها % % 7(@)(@@) % فأضحت بوعسآء النميط كأنها % % ذرى الأثل من وادي القرى ونخيلها % % 8(@)(@@) % وفي الجيرة الغادين حور تهيمت % قلوب الصبى حتى استخفت عقولها % % 9(@)(@@) % كأن نعاج الرمل تحت خدورها % % بوهبين أو أرطى رماح مقيلها % % 10(@)(@@) % عواطف يستثبتن في مكنس الضحى % % إلى الهجر أفيآء بطيئا ضهولها % % PageV01P218 11(@)(@@) % يزيد التنائي وصل خرقآء جدة % إذا خان أرماث الحبال وصولها % % 12(@)(@@) % خليلي عدا حاجتي من هواكما % % ومن ذا يؤاسي النفس إلا خليلها % % 13(@)(@@) % ألما بمي قبل أن تطرح النوى % % بنا مطرحا أو قبل بين يزيلها % % 14(@)(@@) % وإن لم يكن إلا تعلل ساعة % قليلا فإني نافع لي قليلها % % 15(@)(@@) % لقد أشربت نفسي لمي مودة % تقضى الليالي 
ms72	 وهو باق وسيلها % % 16(@)(@@) % ولو كلمت مستوعلا في عماية % تصباه من أعلى عماية قيلها % % 17(@)(@@) % ألا رب هم طارق قد قريته % مواكبة ينضو الرعان ذميلها % % 18(@)(@@) % رتاج الصلا مكنوزة الحاذ يستوي % % على مثل خلقاء الصفاة شليلها % % 19(@)(@@) % وأبيض تستحيي من اللوم نفسه % إذا صير الوجناء حرفا نحولها % % 20(@)(@@) % ندي المحل بسام إذا القوم قطعت % أحاديثهم يهمآء عار مقيلها % % PageV01P219 21(@)(@@) % إذا انجاب أظلال السرى عن قلوصه % وقد خاضها حتى تجلى ثقيلها % % 22(@)(@@) % غدا وهو لا يعتاد عينيه كسرة % إذا ظلمة الليل استقلت فضولها % % 23(@)(@@) % نقي المآقي سامي الطرف إذ غدا % % إلى كل أشباح بدت يستحيلها % % 24(@)(@@) % دعاني بأجواز الفلا ودعوته % لهاجرة حانت وحان رحيلها % % 25(@)(@@) % فقمنا إلى مثل الهلالين لاحنا % % وإياهما عرض الفيافي وطولها % % 26(@)(@@) % وسوجين أحيانا ملوعين بالتي % % على مثل حرف السيف يمسي دليلها % % 27(@)(@@) % وصافي الأعالي أنجل العين رعته % بعانكة ثبجاء قفر أميلها % % 28(@)(@@) % وأبيض موشي القميص نصبته % على خصر مقلات سفيه جديلها % % 29(@)(@@) % قذوف بعينيها إذا اسود غرضها % % جؤوب الموامي حين يدمى نقيلها % % 30(@)(@@) % وبيضاء لا تنحاش منا وأمها % % إذا ما رأتنا زيل منا زويلها % % PageV01P220 31(@)(@@) % فلاة تقد الآل عنها وترتمي % % إذا نتجت ماتت وحي سليلها % % 32(@)(@@) % أريت المهارى والديها كليهما % % بصحرآء غفل يرمح الآل ميلها % % 33(@)(@@) % إذا الشخص فيها هزه الآل أغمضت % عليه كإغماض المقضي هجولها % % 34(@)(@@) % % بنا بين عبريها رجاها وجولها % % 35(@)(@@) % على حميريات كأن عيونها % % قلات الصفا لم يبق إلا سمولها % % 36(@)(@@) % كأنا نشد الميس فوق مراتج % من الحقب أسفى حزنها وسهولها % % 37(@)(@@) % رعت واحفا فالجزع حتى تكملت % جمادى وحتى طار عنها نسيلها % % 38(@)(@@) % وحتى استبان الجأب بعد امتنآئها % % من الصيف ما اللاتي لقحن وحولها % % 39(@)(@@) % أبت بعد هيج الأرض إلا تعلقا % بعهد الثرى حتى طواها ذبولها % % 40(@)(@@) % حشتها الزبانى حرة في صدورها % % وسيرها من صلب رهبى ثميلها % % PageV01P221 41(@)(@@) % فلما حدا الليل النهار وأسدفت % هوادي الدجى ما كاد يدنو أصيلها % % 42(@)(@@) % حداها جميع الأمر مجلوذ السرى % % حداء إذا ما استسمعته يهولها % % 43(@)(@@) % مصك كمقلاء الفتى 
ms73	 ذاد نفسه % عن الورد حتى ائتج فيها غليلها % % 44(@)(@@) % تغنيه من بين الصبيين أبنة % نهوم إذا ما ارتد فيها سحيلها % % 45(@)(@@) % فظلت تفالى حول جأب كأنه % % ربيئة أثآر عظام ذحولها % % 46(@)(@@) % محانيق أمثال القنا قد تقطعت % قوى الشك عنها لو يخلى سبيلها % % 47(@)(@@) % تراقب بين الصلب والهضب والمعى % % معى واحف شمسا بطيئا نزولها % % 48(@)(@@) % ترى القلوة القوداء فيها كفارك % تصدى لعينيها فصدت حليلها % % 49(@)(@@) % فأوردها مسجورة ذات عرمض % تغول سيول المكفهرات غولها % % 50(@)(@@) % فأزعجها رام بسهم فأدبرت % لها روعة ينفي السلام حفيلها % % PageV01P222 51(@)(@@) % تقول سليمى إذ رأتني كأنني % % لنجم الثريا راقب أستحيلها % % 52(@)(@@) % أشكوى حمتك النوم أم نفرت به % % هموم تعنى بعد وهن دخيلها % % 53(@)(@@) % فقلت لها : لا بل هموم تضيفت % ثويك والظلمآء ملقى سدولها % % 54(@)(@@) % أتى دون طعم النوم تيسيرى القرى % % لها واحتيالي أي جال أجيلها % % 55(@)(@@) % فطاوعت همي فانجلى وجه بازل % من الأمر لم يترك خلاجا بزولها % % 56(@)(@@) % فقالت : عبيد الله من آل معمر % لرفد القرى والريح صاف بليلها % % 57(@)(@@) % فتى بين بطحاوي قريش كأنه % صفيحة ذي غربين صاف صقيلها % % 58(@)(@@) % إذا ما قريش قيل : أين خيارها % % أقرت به شبانها وكهولها % % PageV01P223 البحر : طويل 1(@)(@@) % خليلي عوجا عوجة ثم سلما % % عسى الربع بالجرعاء أن يتكلما % % 2(@)(@@) % تعرفته لما وقفت بربعه % كأن بقاياه تماثيل أعجما % % 3(@)(@@) % ديارا لمي قد تعفت رسومها % % 4(@)(@@) % دعاني الهوى من حب مية والهوى % % أرى غالب مني الفؤاد المتيما % % 5(@)(@@) % فلم أرى مثلي لما بين طائر % غدا غدوة وحف الجناحين أسخما % % 6(@)(@@) % ولا مثل دمع العين يوم أكفه % وتأتى سواقيه العلى أن تصرما % % 7(@)(@@) % ففيما ولولا أنت لم أكثر الأسى % % على من ورآئي من فصيح وأعجما % % 8(@)(@@) % فرب بلاد قد قطعت لوصلكم % على ضامر منها السنام تهدما % % 9(@)(@@) % ككدرية أوحت لورد مباكر % كلاما أجابت داجنا قد تعلما % % 10(@)(@@) % إذا القوم قالوا لاعرامة عندها % % فساروا رأوا منها أساري عرما % % PageV01P224 البحر : طويل 1(@)(@@) % أتعرف أطلالا بوهبين والحضر % لمي كأنيار المفوفة الخضر % 2(@)(@@) % فلما عرفت الدار واعتزني الهوى % % تذكرت 
ms74	 هل لي أن تصابيت من عذر % 3(@)(@@) % فلم أر عذرا بعد عشرين حجة % مضت لي وعشر قد مضين إلى عشر % 4(@)(@@) % وأخفيت شوقي من رفيقي وإنه % لذو نسب دان إلي وذو حجر % 5(@)(@@) % محل الحواءين الذي لست رائيا % محلهما إلا غلبت على الصدر % 6(@)(@@) % وضبحا ضبته النار في ظاهر الحصى % كباقية التنوير أو نقط الحبر % 7(@)(@@) % وغير ثلاث بينهن خصاصة % تجاورن في ربع زمانا من الدهر % 8(@)(@@) % كساهن لون السود بعد تعيس % بوهبين إحماش الوليدة بالقدر % 9(@)(@@) % أربت عليها كل هوجاء رادة % شمال وأنفاس اليمانية الكدر % 10(@)(@@) % تسح بها بوغاء قف وتارة % تسن عليها ترب آملة عفر % PageV01P225 11(@)(@@) % هجان من الدهنا كأن متونها % % إذا برقت أثباج أحصنة شقر % 12(@)(@@) % فهاجت عليك الدار ما لست ناسيا % من الحاج إلا أن تناسي على ذكر % 13(@)(@@) % هواك الذي ينهاض بعد اندماله % كما هاض حاد متعب صاحب الكسر % 14(@)(@@) % ا قلت قد ودعته رجعت به % شجون وأذكار تعرض في الصدر % 15(@)(@@) % لمستشعر داء الهوى عرضت له % % سقاما من الأسقام صاحبة الخدر % 16(@)(@@) % إذا قلت يسلو ذكر مية قلبه % أبى حبها ألا بقآء على الهجر % 17(@)(@@) % تميمية نجدية دار أهلها % % إذا موه الصمان من سبل القطر % 18(@)(@@) % بأدعاص حوضى ثم يورد أهلها % % جراميز يطفو فوقها ورق السدر % 19(@)(@@) % من الواضحات البيض تجري عقودها % % على ظبية بالرمل فاردة بكر % 20(@)(@@) % تبسم إيماض الغمامة جنها % % رواق من الظلماء في منطق نزر % PageV01P226 21(@)(@@) % يقطع موضوع الحديث ابتسامها % % تقطع مآء المزن في نزف الخمر % 22(@)(@@) % فلو كلمت مي عواقل شاهق % رغاثا من الأروى سهون عن الغفر % 23(@)(@@) % خبرنجة خود كأن نطاقها % % على رملة بين المقيد والخصر % 24(@)(@@) % لها قصب فعم خدال كأنه % مسوق بردي على حآئر غمر % 25(@)(@@) % سقية أعداد يبيت ضجيعها % % ويصبح محبورا وخيرا من الحبر % 26(@)(@@) % تعاطيه براق الثنايا كأنه % أقاحي وسمي بسائفة قفر % 27(@)(@@) % كأن الندى الشتوي يرفض مآؤه % على أشنب الأنياب متسق الثغر % 28(@)(@@) % هجان تفت المسك في متناعم % سخام القرون غير صهب ولا زعر 
ms75	 % 29(@)(@@) % وتشعره أعطافها وتسوفه % وتمسح منه بالترائب والنحر % 30(@)(@@) % لها سنة كالشمس في يوم طلقة % بدت من سحاب وهي جانحة العصر % PageV01P227 31(@)(@@) % فما روضة من حر نجد تهللت % عليها سماء ليلة والصبا تسري % % 32(@)(@@) % بها ذرق غض النبات وحنوة % تعاورها الأمطار كفرا على كفر % 33(@)(@@) % بأطيب منها نكهة بعد هجعة % ونشرا ولا وعساء طيبة النشر % 34(@)(@@) % فتلك التي يعتادني من خيالها % % على النأي داء السحر أو شبه السحر % 35(@)(@@) % إلى ابن أبي موسى بلال تكلفت % بنا البعد أنقاض الغريرية السجر % 36(@)(@@) % مدئبة الأيام واصلة بنا % % لياليها حتى ترى وضح الفجر % 37(@)(@@) % يؤوبن تأويبا قليلا غراره % ويجتبن أثناء الحنادس والقمر % 38(@)(@@) % يقطعن أجواز الفلاة بفتية % لهم فوق أنضآء السرى قمم ت % % 39(@)(@@) % مر بنا الأيام ما لمحت لنا % % بصيرة عين من سوانا إلى شفر % 40(@)(@@) % تقضين من أعراف لبنى وغمرة % فلما تعرفن اليمامة عن عفر % PageV01P228 41(@)(@@) % تزاورن عن قران عمدا ومن به % % من الناس وازورت سراهن عن حجر % 42(@)(@@) % فأمسين بالحومان يجعلن وجهة % لأعناقهن الجدي أو مطلع النسر % 43(@)(@@) % فصممن في دوية الدو بعدما % % لقين التي بعد اللتيا من الضمر % 44(@)(@@) % فرغن أبا عمر بما بين أهلنا % % وبينك من أطراقهن ومن شهر % 45(@)(@@) % فأصبحن يعزلن الكواظم يمنة % وقد قلقت أجوازهن من الضفر % 46(@)(@@) % فجئنا على خوص كأن عيونها % % صبابات زيت في أواقي من صفر % 47(@)(@@) % مكلين مضبوحي الوجوه كأننا % % بنو غب حمى من سهوم ومن فتر % 48(@)(@@) % وقد كنت أهدي في المفاوز بيننا % % ثناء امرئ باقي المودة والشكر % 49(@)(@@) % ذخرت أبا عمر و لقومك كلهم % بقاء الليالي عندنا أحسن الذخر % 50(@)(@@) % فلا تيأسن من أنني لك ناصح % ومن أنزل الفرقان في ليلة القدر % PageV01P229 51(@)(@@) % أقول وشعر والعرائس بيننا % % وسمر الذرى من هضب ناصفة الحمر % 52(@)(@@) % إذا ذكر الأقوام فاذكر بمدحة % بلالا أخاك الأشعري أبا عمرو % % 53(@)(@@) % أخا وصله زين الكريم وفضله % يجيرك بعد الله من تلف الدهر % 54(@)(@@) % رأيت أبا عمر و بلالا قضى له % % ولي القضايا بالصواب وبالنصر % 55(@)(@@) % إذا 
ms76	 حارب الأقوام يسقي عدوه % سجالا من الذيفان والعلقم الخضر % 56(@)(@@) % وحسبي أبا عمر و على من تصيبه % كمنبعق الغيث الحيا النابت النضر % 57(@)(@@) % وإن حارد المعطون ألفيت كفه % هضوما تسح الخير من خلق بحر % 58(@)(@@) % ومختلق للملك أبيض فدغم % أشم أبج العين كالقمر البدر % 59(@)(@@) % تصاغر أشراف البرية حوله % لأزهر صافي اللون من نفر زهر % 60(@)(@@) % خلفت أبا موسى وشرفت ما بنى % % أبو بردة الفياض من شرف الذكر % PageV01P230 61(@)(@@) % وكم لبلال من أب كان طيبا % على كل حال في الحياة وفي القبر % 62(@)(@@) % لكم قدم لا ينكر الناس أنها % % مع الحسب العادي طمت على الفخر % 63(@)(@@) % خلال النبي المصطفى عند ربه % وعثمان والفاروق بعد أبي بكر % 64(@)(@@) % وأنتم ذوو الأكل العظيم وأنتم % أسود الوغى والجابرون من الفقر % 65(@)(@@) % أبوك تلافى الدين والناس بعدما % % تشاءوا وبيت الدين منقلع الكسر % 66(@)(@@) % فشد إصار الدين أيام أذرح % ورد حروبا قد لقحن إلى عقر % 67(@)(@@) % تعز ضعاف الناس عزة بنفسه % ويقطع أنف الكبريآء عن الكبر % 68(@)(@@) % إذا المنبر المحظور أشرف رأسه % على الناس فوقه نظر الصقر % 69(@)(@@) % تجلت عن البازي طشاش وليلة % فآنس شيئا وهو طاو على وكر % 70(@)(@@) % فسلم فاختار المقالة مصقع % رفيع البنى ضخم الدسيعة والأمر % PageV01P231 71(@)(@@) % ليوم من الأيام شبه قوله % ذوو الرأي والأحجاء منقلع الصخر % 72(@)(@@) % ومثل بلال سوس الأمر فاستوت % مهابته الكبرى وجلى عن الثغر % 73(@)(@@) % إذا التكت الأوراد فرجت بينها % % مصادر ليست من عبام ولا غمر % 74(@)(@@) % ونكلت فساق العراق فأقصروا % % وغلقت أبواب النساء على ستر % 75(@)(@@) % فلم يبق إلا داخر في مخيس % ومنحجر من غير أرضك في حجر % 76(@)(@@) % يغار بلال غيرة عربية % على العربيات المغيبات بالمصر % PageV01P232 البحر : طويل 1(@)(@@) % عليكن يا أطلال مي بشارع % على ما مضى من عهدكن سلام % 2(@)(@@) % ولا زال نوء الدلو يبعق ودقه % بكن ومن نوء السماك غمام % 3(@)(@@) % بكل جدي غير ذات براية % عليكن مجرى جارح ومنام % 4(@)(@@) % علام سألناكن عن أم سالم % ومي فلم يرجع لكن كلام % 5(@)(@@) % هوى لك 
ms77	 لا ينفك يدعوك ما دعا % % حماما بأجزاع العقيق حمام % 6(@)(@@) % إذا هملت عيني لها قال صاحبي : % بمثلك هذا فتنة وغرام % 7(@)(@@) % علام وقد فارقت ميا وفارقت % ومية في طول البكآء تلام % 8(@)(@@) % أطاعت بك الواشين حتى كأنما % % كلامك إياها عليك حرام % PageV01P233 البحر : بسيط تام 1(@)(@@) % يا حاديي بنت فضاض أما لكما % % حتى نكلمها هم بتعريج % 2(@)(@@) % خود كأن اهتزاز الرمح مشيتها % % لفاء ممكورة في غير تهبيج % 3(@)(@@) % كأنها بكرة أدمآء زينها % % عتق النجار وعيش غير تزليج % 4(@)(@@) % في ربرب مخطف الأحشآء ملتبس % منه بنا مرض الحور المباهيج % 5(@)(@@) % كأن أعجازها والريط يعصبها % % بين البرين وأعناق العواهيج % 6(@)(@@) % أنقاء سارية حلت عزاليها % % من آخر الليل ريح غير حرجوج % 7(@)(@@) % تسقي إذا عجن من أجيادهن لنا % % عوج الأعنة أعناق العناجيج % 8(@)(@@) % صوادي الهام والأحشاء خافقة % تناول الهيم أرشاف الصهاريج % 9(@)(@@) % من كل أشنب مجرى كل منتكث % يجري على واضح الأنياب مثلوج % 10(@)(@@) % كأنه بعدما تغضي العيون به % على الرقاد سلاف غير ممزوج % PageV01P234 11(@)(@@) % ومهمه طامس الأعلام في صخب ال % % أصداء مختلط بالترب ديجوج % 12(@)(@@) % أمرقت من جوزه أعناق ناجية % تنجو إذا قال حاديها لها هيجي % 13(@)(@@) % كأنه حين يرمي خلفهن به % حادي ثمان من الحقب السماحيج % 14(@)(@@) % وراكد الشمس أجاج نصبت له % حواجب القوم بالمهرية العوج % 15(@)(@@) % إذا تنازع جالا مجهل قذف % أطراف مطرد بالحر منسوج % 16(@)(@@) % تلوي الثنايا بأحقيها حواشيه % لي الملاء بأبواب التفاريج % 17(@)(@@) % كأنه والرهاء المرت يركضه % أعراف أزهر تحت الريح منتوج % 18(@)(@@) % يجري ويرتد أحيانا وتطرده % نكبآء ظمأى من القيظية الهوج % 19(@)(@@) % في صحن يهماء يهتف السهام بها % % في قرقر بلعاب الشمس مضروج % 20(@)(@@) % يغادر الأرحبي المحض أركبها % % كأن غاربه يأفوخ مشجوج % PageV01P235 21(@)(@@) % رفيق أعين ذيال تشبهه % فحل الهجان تنحى غير مخلوج % 22(@)(@@) % ومنهل آجن الجمات مجتنب % غلسته بالهبلات الهماليج % 23(@)(@@) % ينفخن أشكل مخلوطا تقمصه % مناخر العجرفيات الملاجيج % 24(@)(@@) % كأنما ضربت قدام أعينها % % عهنا بمستحصد الأوتار محلوج % 25(@)(@@) % كأن أصوات من إيغالهن بنا % % أواخر الميس إنقاض الفراريج % 26 
ms78	(@)(@@) % تشكو البرى وتجافى عن سفائفها % % تجافي البيض عن برد الدماليج % 27(@)(@@) % إذا مطونا نسوع الميس مصعدة % يسلكن أخرات أرباض المداريج % PageV01P236 البحر : طويل 1(@)(@@) % لعمري وما عمري علي بهين % لقد نال أصحاب العصا شر مغنم % 2(@)(@@) % فإن لم يردوها علينا ندع بهم % هجآء ككي الناحز المتلوم % 3(@)(@@) % وإلا يدعني عرجل إنز عرجلا % على أمه نزو العريض المزلم % PageV01P237 البحر : طويل 1(@)(@@) % مررنا على دار لمية مرة % وجاراتها قد كاد يعفو مقامها % % 2(@)(@@) % فلم يدر إلا الله ما هيجت لنا % % أهلة أنآء الديار وشامها % % 3(@)(@@) % وقد زودت مي على النأي قلبه % علاقات حاجات طويل سقامها % % 4(@)(@@) % فأصبحت كالهيماء لا الماء مبري % صداها ولا يقضي عليه هيامها % % 5(@)(@@) % كأني غداة الزرق يا مي مدنف % يكيد بنفس قد أجم حمامها % % 6(@)(@@) % حذار اجتذام البين أقران طية % مصيب لوقرات الفؤاد انجذامها % % 7(@)(@@) % خليلي لما خفت أن تستفزني % % أحاديث نفسي بالنوى واحتمامها % % 8(@)(@@) % تداويت من مي بتكليمة لها % % فما زاد إلا ضعف دائي كلامها % % 9(@)(@@) % أناة كأن المسك أو نور حنوة % بميثاء مرجوع عليه التثامها % % 10(@)(@@) % كأن على فيها تلألؤ مزنة % وميضا إذا زان الحديث ابتسامها % % PageV01P238 11(@)(@@) % ألا خيلت مي وقد نام صحبتي % % فما نفر التهويم إلا سلامها % % 12(@)(@@) % طروقا وجلب الرحل مشدودة به % % سفينة بر تحت خدي زمامها % % 13(@)(@@) % أنيخت فألقت بلدة فوق بلدة % قليل بها الأصوات إلا بغامها % % 14(@)(@@) % يمانية في وثبها عجرفية % إذا انضم إطلاها وأودى سنامها % % 15(@)(@@) % ودوية تيهآء يدعو بجوزها % % دعآء الثكالى آخر الليل هامها % % 16(@)(@@) % أطلت اعتقال الرحل في مدلهمها % % إذا شرك الموماة أودى نظامها % % 17(@)(@@) % ولست بمحيار إذا ما تشابهت % أماليس مخضر عليها ظلامها % % 18(@)(@@) % أقيم السرى فوق المطايا لفتية % إذا اضطربوا حتى تجلى قتامها % % 19(@)(@@) % على مستظلات العيون سواهم % شويكية يكسو براها لغامها % % 20(@)(@@) % يطرحن حيرانا بكل مفازة % سقابا وحولا لم يكمل تمامها % % PageV01P239 21(@)(@@) % ترى طيرها من بين عاف وحاجل % إلى حية الأنفاس موتى عظامها % % 22(@)(@@) % وأشعث قد ساميته جوز قفرة % سوآء علينا ضحوها وظلامها % % 23(@)(@@) % تهاوى به حرف 
ms79	 قذاف كأنها % % نعامة بيد ضل عنها نعامها % % PageV01P240 البحر : طويل 1(@)(@@) % أللربع ظلت عينك المآء تهمل % رشاشا كم استن الجمان المفصل % 2(@)(@@) % لعرفان أطلال كأن رسومها % % بوهبين رشي أو رداء مسلسل % 3(@)(@@) % أربت بها الهوجاء واستوفضت بها % % حصى الرمل نجرانية حين تجهل % 4(@)(@@) % جفول كساها لون أرض غريبة % سوى أرضها منها الهباء المغربل % 5(@)(@@) % نبت نبوة عيني بها ثم بينت % يحاميم جون أنها الدار أمثل % 6(@)(@@) % جنوح على باق سحيق كأنه % إهاب ابن آوى كاهب اللون أطحل % 7(@)(@@) % وللنؤي مجنوبا كأن هلاله % وقد نسفت أعضاده الريح جدول % 8(@)(@@) % مقيم تغنيه السواري وتنتحي % % به منكبا نكبآء والذيل مرفل % 9(@)(@@) % عهدت به الحي الحلول بسلوة % جميعا وآيات الهوى ما تزيل % 10(@)(@@) % وبيضا تهادى بالعشي كأنها % % غمام الثريا الرائح المتهلل % PageV01P241 11(@)(@@) % خدالا قذفن السور منهن والبرى % % على ناعم البردي بل هن أخدل % 12(@)(@@) % قصار الخطى يمشين هونا كأنه % دبيب القطا بل هن في الوعث أوحل % 13(@)(@@) % إذا نهضت أعجازها خرجت بها % % بمنبهرات غير أن لا تخزل % 14(@)(@@) % ولا عيب فيها غير أن سريعها % % قطوف وأن لاشيء منهن أكسل % 15(@)(@@) % نواعم رخصات كأن حديثها % % جنى الشهد في ماء الصبا متشمل % 16(@)(@@) % رقاق الحواشي منفذات صدورها % % وأعجازها عما بها اللهو خزل % 17(@)(@@) % أولئك لا يوفين شيئا وعدنه % وعنهن لا يصحو الغوي المعذل % 18(@)(@@) % فما أم أولاد ثكول وإنما % % تبوء بما في بطنها حين تثكل % 19(@)(@@) % أسرت جنينا في حشا غير خادج % فلا هو منتوج ولا هو معجل % 20(@)(@@) % تموت وتحيا حائل من بناتها % % ومنهن أخرى عاقر وهي تحمل % PageV01P242 21(@)(@@) % عمانية مهرية دوسرية % على ظهرها للحلس والكور محمل % 22(@)(@@) % مفرجة حمراء عيساء جونة % صهابية العثنون دهمآء صندل % 23(@)(@@) % تراها أمام الركب في كل منزل % ولو طال إيجاف بها وترحل % 24(@)(@@) % ترى الخمس بعد الخمس لا يفتلانها % % ولو فار للشعرى من الحر مرجل % 25(@)(@@) % تقطع أعناق الركاب ولا ترى % % على السير إلا صلدما ما تزيل % 26(@)(@@) % ترى أثر الأنساع فيها كأنه % على ظهر عادي يعاليه جندل % 27(@)(@@) % ولو 
ms80	 جعل الكور العلافي فوقها % % وراكبه أعيت به ما تحلحل % 28(@)(@@) % يرى الموت إن قامت وإن بركت به % يرى موته على ظهرها حين ينزل % 29(@)(@@) % ترى ولها ظهر وبطن وذروة % وتشرب من برد الشراب وتأكل % PageV01P243 البحر : طويل 1(@)(@@) % لمية أطلال بحزوى دواثر % عفتها السوافي بعدنا والمواطر % 2(@)(@@) % كأن فؤادي هاض عرفان ربعها % % به وعي ساق أسلمتها الجبآئر % 3(@)(@@) % عشية مسعود يقول وقد جرى % % على لحيتي من عبرة العين قاطر % 4(@)(@@) % أفي الدار تبكي أن تفرق أهلها % % وأنت امرؤ قد حلمتك العشائر % 5(@)(@@) % فلا صبر إن تستعبر العين إنني % % على ذاك إلا جولة الدمع صابر % 6(@)(@@) % فيا مي هل يجزى بكائي بمثله % % مرارا وأنفاسي إليك الزوافر % 7(@)(@@) % وأني متى أشرف على الجانب الذي % % به أنت من بين الجوانب ناظر % 8(@)(@@) % وأن لا يني يا مي دون صحبتي % % لك الدهر من أحدوثة النفس ذاكر % 9(@)(@@) % وأن لا ينال الركب تهويم وقعة % من الليل إلا اعتادني منك زائر % 10(@)(@@) % وإن تك مي حال بيني وبينها % % تشائي النوى والعاديات الشواجر % PageV01P244 11(@)(@@) % فقد طالما رجيت ميا وشاقني % % رسيس الهوى منه دخيل وظاهر % 12(@)(@@) % وقد أورثتني مثل ما بالذي به % % هوى غربة دانى له القيد قاصر % 13(@)(@@) % لقد نام عن ليلي لقيط وشاقني % % من البرق علوي السنا متياسر % 14(@)(@@) % أرقت له والثلج بيني وبينه % % وحومان حزوى فاللوى والحرائر % 15(@)(@@) % وقد لاح للساري سهيل كأنه % قريع هجان عارض الشول جافر % 16(@)(@@) % نظرت ورائي نظرة الشوق بعدما % % بدا الجو من حي لنا والدساكر % 17(@)(@@) % لأنظر هل تبدو لعيني نظرة % بحومانة الزرق الحمول البواكر % 18(@)(@@) % أجدت بأغباش فأضحت كأنها % % مواقير نخل أو طلوح نواضر % 19(@)(@@) % ظعآئن لم يسلكن أكناف قرية % بسيف ولم تنغض بهن القناطر % 20(@)(@@) % تصيفن حتى صفر أقواع مطرق % وهاجت لأعداد المياه الأباعر % PageV01P245 21(@)(@@) % وطار عن العجم العفاء وأوجفت % بريعان رقراق السراب الظواهر % 22(@)(@@) % ولم تبق ألواء الثماني بقية % من الرطب إلا بطن واد وحاجر % 23(@)(@@) % فلما رأين القنع أسفى وأخلفت % من العقربيات الهيوج الأواخر % 24(@)(@@) % جذبن الهوى 