ms121	 % لا يرتضى الدمع من أن يكون دما % % 8(@)(@@) % قالوا ندمت على من كان من زمن % فقلت مالي أن لا أظهر الندما % % 9(@)(@@) % جاد الغمام على سفح البشام إلى % % شعب الخزامى فروى الضال والسلما % % 10(@)(@@) % و لا عدا الأثلات الخضر عارضة % حتى يحيي رسوم الحي والخيما % % PageV01P382 11(@)(@@) % ياحادي العيس لا ترتع بذي سلم % و لا بنجد وزم الأينق الرسما % % 12(@)(@@) % واقصد ربا الخيمة الغراء مقتبسا % من نور أبلج يلقى الوفد مبتسما % % 13(@)(@@) % ذاك المعلم عبد الله أجود من % أعطى وأشرف من فوق الثرى شيما % % 14(@)(@@) % الفاضل الكامل المحمود سيرته % سامي الفخار الأغر العالم العلما % % 15(@)(@@) % الصائم القائمالتاليإذا هجعت % عنه العيون وجن الليل وادهما % % 16(@)(@@) % نقر عينك منهعند رؤيته % كأنهالبدرفي جو السماء سما % % 17(@)(@@) % أتى به الله نورا لا خفاء به % و كان سرا من الأسرار منكتما % % 18(@)(@@) % باللهبالله إن شاهدت طلعته % لا تلثم الكف حتى تلثم القدما % % 19(@)(@@) % واجعلزيارتهللهخالصة % و كن به بعد حبلاللهمعتصما % % 20(@)(@@) % الله أكبر هذا خير من فخرتهذا الذي تظهر الأشيا فراسته كأنه بخفي الغيب قد علما % % به المذاهب هذا سيد العلماسقط بيت ص % % PageV01P383 البحر : - 1(@)(@@) % راح الزمان ولا علم عن العلم % و لا سلام على سلمى بذي سلم % 2(@)(@@) % باتت تقسم قلبي نية وقفت % قلبيعلى الجيرة الغادين عن إضم % 3(@)(@@) % فبتأندب وصلا غير متصل % بالمنجدين لصرم غير منصرم % 4(@)(@@) % رضيت حكم الهوى العذري لي ولهم % فما ارتضوا سفح دمعي دون سفك دمي % % 5(@)(@@) % أدرج القلب من شهر إلى سنة % عنهم وأرضيه دون الوصل بالحلم % 6(@)(@@) % يانازلا بربانجد أعد خبرا % عن معهد بعقيق الرمل منهدم % 7(@)(@@) % و دمنة قسمت بالبين أربعها % % بين الزمان وبين الريح والديم % 8(@)(@@) % لم يبق منها سوى الأطلال خامدة % أو الجآ ذر والآرام في الأطم % 9(@)(@@) % و ما رعيت هواها إذ مررت بها % % إلا بدمع على الخدين منسجم % 10(@)(@@) % أطارح الدار تسليمي ولو عقلت % لأخبرتني عن عاد وعن إرم % PageV01P384 11(@)(@@) % يالائمي دع فؤادي للهموم فلو % لاقيت بعض الذي لاقيت لم تلم % 12(@)(@@) % و خل 
ms122	 قلبي لنار الوجد محرقة % و الجفن للدمع والأعضاء للسقم % 13(@)(@@) % كم حول الدهر حالاتي وها أنا ذا % % ألقاهحين لقاني غير مهتضم % 14(@)(@@) % و كم تغيرت الايام والتبست % فما تغيرت أخلاقي ولا شيمي % % 15(@)(@@) % لا أشرب المر موثوقا به طعما % % ولا أقول على ما فات وا ندمي % % 16(@)(@@) % و لا يخوفني دهر يحول ولا % % هول يهول ولا تهديد مصطلم % 17(@)(@@) % وفي قعار جناب ما نزلت به % إلا أمنت أمان الصيد في الحرم % 18(@)(@@) % ألوذ بالمشهد المحروس منتصرا % كأنني منه في ركن وملتزم % 19(@)(@@) % حيث الجلالة مضروب سرادقها % % و النور مبتسم يجلو دجى الظلم % 20(@)(@@) % الله أكبر ذا الطود المنيف ذرا % ذا العالم العلم ابن العالم العلم % PageV01P385 21(@)(@@) % هذا النهاري الذي في ضمن تربته % حج ومعتمر للأينق الرسم % 22(@)(@@) % ذا البدر ذا القطر ذا البحر المحيط غنى % % زاكى المناصب سامي القدر والهمم % 23(@)(@@) % هذا محمد السامي فتى عمر % لب اللباب ابن أم الجود والكرم % 24(@)(@@) % ذا الكامل الفاضل الفياض نائله % غوث الشعائر غيث الخير والنعم % 25(@)(@@) % ذا الأبلج المنتقى من أمة وسط % مخاطبين بكنتم خير في القدم % 26(@)(@@) % أغر كالشمس لا يخفى على أحد % إلا على أحد عما يراه عمي % 27(@)(@@) % لو صور الخلق من قول ومن كلم % لكان معنى لمعنى القول والكلم % 28(@)(@@) % و إن يكن بشرا من قوم اشتبهوا % % خلقا فما صفر كالأشهر الحرم % 29(@)(@@) % لم تلهه بهجة الدنيا وزخرفها % % و لا التفاخر بالأتباعو الخدم % 30(@)(@@) % له الكرامات والأحوال ظاهرة % في الشرق والغرب بين العرب والعجم % PageV01P386 31(@)(@@) % فالكائنات لديه غير غائبة % و الأرض بين يديه خطوة القدم % 32(@)(@@) % و الحجب والعرش والكرسي بارزة % في عينه في بروز اللوح والقلم % 33(@)(@@) % يدعو الفتى باسمه حقا وينسبه % صدقا على بعده والبعد كالامم % 34(@)(@@) % مكاشف بخفيات الأمور فما % % غيب يخاف ولا سر بمكتتم % 35(@)(@@) % تبدي فراسته أنوار حكمته % و ما أمين على غيب بمتهم % 36(@)(@@) % مولاي مولاي كم أدعوك مفتقرا % و كم أشافهك الشكوى فما لفم % 37(@)(@@) % فاسمع ولب ندائي بالإجابة يا % % منزه 
ms123	 السمع عن وقر وعن صمم % 38(@)(@@) % إن الفقير الحجازي صاحبي عثرت % به كبائره فضلا عن اللمم % 39(@)(@@) % و قد وصلت إلى هذا الجناب ولي % فيك الظنون ومن وافى حماك حمى % % 40(@)(@@) % مستنجدا بك من هول المعاد فخذ % بذمة منك لي يا وافي الذمم % PageV01P387 41(@)(@@) % إن لم تقم بي نهوضا كلما اعترضت % لي الحوادث لم أنهض ولم أقم % 42(@)(@@) % و كيف حيلة من يمسى ويصبح في % % بحر محيط من الأوزار ملتطم % 43(@)(@@) % فانظر إلى بعين اللطف منك لكي % يلقاني الخطب نحوي ملقى السلم % 44(@)(@@) % و اكف السنا حي عليا طول غربته % و صنه من جور دهر خائن خصم % 45(@)(@@) % و كن لقائلها عبد الرحيم إذا % % ضاق الخناق له من أمنع العصم % 46(@)(@@) % فلم يزل بك في أمن وفي دعة % و في جناب عزيز القدر محترم % 47(@)(@@) % فأنت يا موسم الزوار ملجؤنا % % عما نحاذر في الدارين من نقم % 48(@)(@@) % قل أنتما من أصيحابي وحاشيتي % و من خصائص أتباعي ومن حشمي % 49(@)(@@) % و عم بالخير أهلينا وجيرتنا % % و من يلينا من الأصحاب والرحم % 50(@)(@@) % منى السلام على أنوار قبرك ما % % تجاوبت ساجعات الأيكبالنعم % PageV01P388 51(@)(@@) % و جاد مشهدك الميمون منسجم % يخص مستودع الأحكام والحكم % PageV01P389 البحر : - 1(@)(@@) % قال مستودع الغيوب النهاري % % وهو في حضرة العزيز الباري % % 2(@)(@@) % حين أوتى مفاتح الأسرار % طمحت رفعتي على الأبصار % % 3(@)(@@) % و اصطلى كل عاشق من ناري % % 4(@)(@@) % كل من في مقام صدق صديقي % و فريق الموحدين فريقي % 5(@)(@@) % نفر الضد خوف شهب حريقي % و انتحى كل فارس عن طريقي % 6(@)(@@) % و خيولي تحيط بالأقطار % % 7(@)(@@) % رفعت رؤيتي بمقعد صدق % و سما بي سر اعتقادي ونطقي % 8(@)(@@) % فثنائي في كل غرب وشرق % و شموسي تضيء في كل أفق % 9(@)(@@) % و حسامي يلوحفي الأبصار % % PageV01P390 البحر : - 1(@)(@@) % مضى زمن الصبا فدع التصابي % % قبيح منك شبت وأنت صابي % 2(@)(@@) % تظل تغازل الغزلان لهوا % % و تكثر ذكر زينب والرباب % 3(@)(@@) % و تلبس للبطالة كل ثوب % و تنسى ما يسود في الكتاب % 4(@)(@@) % و قد 
ms124	 بدلت بعد قواك ضعفا % و دل الشيب منك على الثباب % 5(@)(@@) % فخذ زادا يكون به بلاغ % و تب فلعل فوزك في المتاب % 6(@)(@@) % و أجمع للرحيل ولا تعول % على دار اغترار واغتراب % 7(@)(@@) % فخير الناس عبد قال صدقا % و قدم صالحا قبل الذهاب % 8(@)(@@) % و راقب ربه وعصى هواه % و حاسب نفسه قبل الحساب % 9(@)(@@) % خليلي اربعا بربوع نجد % نجدد عهد معهدها الخراب % 10(@)(@@) % و تنزل منزل الخلان منها % % و نروي من مناهلها العذاب % PageV01P391 11(@)(@@) % مآثر جيرتي وديار أنسى % % و مألف كل عيش مستطاب % 12(@)(@@) % سقى شعب الأراك وما يليه % من الأقطار منسجم السحاب % 13(@)(@@) % و روى روضة العلمين حتى % % تناهى الري مخضر الروابي % 14(@)(@@) % يناغى الشمس منها در ظل % يريك النور يسفر بالتهاب % 15(@)(@@) % كأن فواتح الأزهار منها % % خلائق سيدي عمر العرابي % 16(@)(@@) % إمام نوره ملأ النواحي % % وأوضح هدية سبل الصواب % 17(@)(@@) % يعز مكانة ويجل قدرا % برفعة منصب زاكى النصاب % 18(@)(@@) % و يكبر أن يخاطب أو يسمى % % بسر السر أو لب اللباب % 19(@)(@@) % كرامات له ومكاشفات % فشت في الكون بالعجب العجاب % 20(@)(@@) % فراسة مؤمن بحضور قلب % يشاهد في ابتعاد واقتراب % PageV01P392 21(@)(@@) % و غوث يستغاث به وسيف % يصول على النوائب غير نابي % % 22(@)(@@) % و بدر يستضاء به وبحر % من الخيرات ملتطم العباب % 23(@)(@@) % و أمة أمة عملا وعلما % نقى العرض عن عار وعاب % 24(@)(@@) % نلوذ به إلى جبل منيف % جوانبه محصنة الهضاب % 25(@)(@@) % و نستسقي الغمام إذا جدبنا % % بدعوته ونفتح كل باب % 26(@)(@@) % و نستعدي به وبتابعيه % على الأعداء في النوب الصعاب % 27(@)(@@) % فإن لسره خضعت وذلت % رقاب العجم والعرب الصلاب % 28(@)(@@) % و من شرف الولاية أن هذا % % لسان أولى الحقائق في الخطاب % 29(@)(@@) % يخاصم خصمها ويجيب عنها % % إذا افتقر السؤال إلى جواب % 30(@)(@@) % و يكسو المذهب السني حسنا % و ينشر ظل رايته العقاب % PageV01P393 31(@)(@@) % و يبني دون دين الله سورا % بيوت علاه سامية القباب % 32(@)(@@) % لقد شرف الزمان به وأضحت % وجوه الخير سافرة النقاب % 33(@)(@@) % توافيه الوفود بحسن ظن 
ms125	 % فترجع غير خائبة الركاب % 34(@)(@@) % و ترعى ريف رأفته البرايا % % فتنعم في خلائقه الرحاب % 35(@)(@@) % و عز حماه ملجأ كل راج % و شعب نداه مجتمع الشعاب % 36(@)(@@) % فيا مولاي قربني نجيا % و أكرمني بأنعمك الرغاب % 37(@)(@@) % فلم أسألك دينارا ودارا % و لا ثوبا سوى ثوب الثواب % 38(@)(@@) % و فقد وافيت بحرك وهو طام وجئتك زائرا بغريب مدح حواشيه أرق من العتاب % % و غيري غره لمع السرابسقط ص % % 39(@)(@@) % و أشهى من فكاهة بنت عشر % و تقبيل المعسلة الرضاب % 40(@)(@@) % تغادر أنفس الأحبار سكرى % % بكاس المدح لا كأس الشراب % PageV01P394 41(@)(@@) % فصل حبلي بحبلك واصطنعني % % فكم لك من صنائع في الرقاب % 42(@)(@@) % و قل عبد الرحيم ومن يليه % معي يرجو غدا كرم المآب % 43(@)(@@) % و اقض حوائجي فعساك تجزى % % بمغفرة وأجر واحتساب % 44(@)(@@) % لأدرك منك في الدنيا والاخرى % % نصيبي من دعاء مستجاب % 45(@)(@@) % بقيت لملة الإسلام نورا % % و جيه الوجه محترم الجناب % 46(@)(@@) % و دمت مكرما بعلو قدر % و بورك في صحابك من صحاب % 47(@)(@@) % و صلى الله لمحة كل طرف % تخص الدر من صدف التراب % 48(@)(@@) % محمد الذي فضل البرايا % % و فاق المرسلين بقرب قاب % 49(@)(@@) % و آل الهاشمي وتابعيه % غيوث رغائب وليوث غاب % PageV01P395 البحر : - 1(@)(@@) % بارق بالأبرق الفرد سرى % % و تراءى لي بنجد سحرا % % 2(@)(@@) % و سقى خيف مني عارضة % % و أثيلات النقا والسمرا % % 3(@)(@@) % و أتيحت بالمصلى ديمة % % غادرت وادي المصلى خضرا % % 4(@)(@@) % فأنار النور من فيضه % في ربا تلك النواحيزهرا % % 5(@)(@@) % فرياض الشعب رضوانية % ينثر الطل عليها دررا % % 6(@)(@@) % يا نسيم الريح من كاظمة % أهد لي ذاك النسيم العطرا % % 7(@)(@@) % وأعد لي بالحمى ساجعة % فرقت بين جفوني والكرى % % 8(@)(@@) % من عذيري من حبيب راحل % أخذ النوم وأعطى السهرا % % 9(@)(@@) % وعذولي لا منى في الحب لو % ذاق كأس الحب مثلي عذرا % % 10(@)(@@) % لا يظن الدهر أني مهمل % بعد مدحي من يجيز الشعرا % % PageV01P396 11(@)(@@) % قيل لي مانلت من نائله % قلت كل الصيد في جوف الفرا % % 12(@)(@@) % ذا الوجيه الوجه في 
ms126	 الدارين ذا % % سيدي الشيخ العرابي عمرا % % 13(@)(@@) % صفوة الحق الذي أنواره % عمت الدنيا فشاعت في الورى % % 14(@)(@@) % واحد الأمة زهدا وهدى % % غوث أهل الأرض كهف الفقرا % % 15(@)(@@) % قبلة الوفد المرجي جوده % بل إمام الصالحين الكبرا % % 16(@)(@@) % كعبة المجدالذي من زاره % حج في زورته واعتمرا % % 17(@)(@@) % و الذي ماجئتهمستسلما % كفه إلا استلمت الحجرا % % 18(@)(@@) % غيم بر طلهمرحمة % لم يزل صيبهمنهمرا % % 19(@)(@@) % سادتيلا تهملوا مادحكم % فلقدلذت بكممنتصرا % % 20(@)(@@) % إنأدنى واجب الخدمةأن % تبلغوا عبد الرحيم الوطرا % % PageV01P397 21(@)(@@) % فصلوا حبلي وشدوا عروتي % % وارفعوا قدري إذا خطب عرا % % 22(@)(@@) % لا تخصوابالدعا أنفسكم % و اذ كروا من غاب فيمن حضرا % % 23(@)(@@) % واسألوا الرحمن يهديرحمة % تشمل الأمو ات في بطن الثرى % % 24(@)(@@) % و صلاة الله تغشى روضة % أحمد المختار فيها قبرا % % 25(@)(@@) % و ضجيعيه وسبطيه ومن % آثر الهجرة أو من نصرا % % 26(@)(@@) % و جميع الصحب والآلإذا % % بارق بالأبرق الفرد سرى % % PageV01P398 البحر : - 1(@)(@@) % وجد تحرك في قلبي فما سكنا % % فقدا لمن بنواحي مكة سكنا % % 2(@)(@@) % أحبة هم مني قلبي وهمأملي % % و هم علاقة نفسي إذ نأوا وطنا % % 3(@)(@@) % علقت في الركب آمالي غداة غدوا % % كأن في الركب روحا فارق البدنا % % 4(@)(@@) % أجرى دموعي فرادى بعدهم وتنى % % و ما ثنى العذل عطف الصبر حين ثنى % % 5(@)(@@) % أود طيف خيال لو يزور وهل % يستضعف الطيف طيف حارب الوسنا % % 6(@)(@@) % كم قلت واحزنا للقلب بعدهم % وليس ينفعني إن قلت واحزنا % % 7(@)(@@) % أحباب قلبي عسى من نحوكم خبر % لهائم يندب الأطلال والدمنا % % 8(@)(@@) % و هل يعيد علي الدهر قربكم % بعد النوى فهواكم زادني شجنا % % 9(@)(@@) % فبي غنى عن جميع الكون غيركم % و ليس لي عنكم يا مالكي غنى % % 10(@)(@@) % قلوب امتزجت بالود ما بلغت % و إن بعدتم فمعنى سر كم معنا % % PageV01P399 11(@)(@@) % و أنتم أنا وأنا أنتم ولا عجب % إن كنت أنتم وأنتم في الوجود أنا % % 12(@)(@@) % روحي هنا بعض أرواح هناك وأر % % واح هناك هي الروح المقيم هنا % % 13(@)(@@) % أحبكم وأحب الدار آنسة % منكم وأسأل عنكم من نأى ودنا % % 14(@)(@@) % فليت 
ms127	 شعري هل في الدار متسع % حتى تعود الليالي الذاهبات لنا % % 15(@)(@@) % أم ترحمون أحيبابي جوى كبد % كادت تذوب إليكم لوعة وضنى % % 16(@)(@@) % فو الذي حجت الركبان كعبته % و ما حواه المصلى والبقا ومنى % % 17(@)(@@) % ما حلت في الحب عن حال الوداد لكم % و لا خلعت لماضي حبكم رسنا % % 18(@)(@@) % يا خائضا غمرات الشوق متخذا % حسن التوكل زادا والرضا سفنا % % 19(@)(@@) % دع المقادير تجري وارض ما فعلت % و اكتم هواك ولا تستعتب الزمنا % % 20(@)(@@) % إن الفضائل في الأخطارمودعة % فابغ الفضائل واجعل روحك الثمنا % % PageV01P400 21(@)(@@) % و إن أراد الهوى منك الهوان فقل % حكم المنية في حب الحبيب منى % % 22(@)(@@) % و الراح يستلب الأرواح عندهم % حيث الحضور مغيب والبقاء فنى % % 23(@)(@@) % فاحفظ هواهم ومت في حبهم كمدا % % إن كنت حرا على الأسرار مؤتمنا % % 24(@)(@@) % فالكون مسترق منهم محاسنه % و الدين يلبس منهم بهجة وسنا % % 25(@)(@@) % أرائح الشام بلغ سيدي عمرا % % تحية من محب يسكن اليمنا % % 26(@)(@@) % و الثم يمين إمام ماجد علم % أحيا الهوى والندى والفرض والسننا % % 27(@)(@@) % مبارك الوجه تستكفي الخطوب به % و نستقي بدعاه العارض الهتنا % % 28(@)(@@) % مولاي أنت مرادي حيث كنت وكم % و شى الوشاة وقالوا عابدا وثنا % % 29(@)(@@) % لا أشكر الدهر يهدي ظل أنعمه % إلى ما لم يريني وجهك الحسنا % % 30(@)(@@) % فاذكر أبا القاسم الخاطي عبيدك في % % تلك المساكن كم من خائف أمنا % % PageV01P401 31(@)(@@) % و صل بمرحمة عبد الرحيم ورش % منه الجناح فكم أوليته مننا % % 32(@)(@@) % مني عليك سلام الله ما سجعت % ورق الحمى وثنى روح الصبا غصنا % % PageV01P402 البحر : - 1(@)(@@) % ذروني أبكي بعد جيرة ثهمد % و أحدث عهدا في بقية معهدي % % 2(@)(@@) % و أندب آثار الفريق بلوعة % و لاعج وجد بعدهم متجدد % 3(@)(@@) % و مالي لا أبكي وقد عزموا النوى % % غداة افترقنا من مغير ومنجد % 4(@)(@@) % فما ودعوني يوم جدرحيلهم % ولا زودوني نظرة المتزود % 5(@)(@@) % و لا رحموا قلبا يحوم على الحمى % % و لا حفظوا ميثاق عهد مؤكد % 6(@)(@@) % فليت الهوى العذري أعقب راحة % لمطلق دمع عن غرام مقيد 
ms128	 % 7(@)(@@) % و ليت زمان الوصل أرخى عنانه % فتبلغني الآمال غاية مقصدي % % 8(@)(@@) % خليلي من حي ابن خولان أسعدا % % رفيقكما فالدهر ليس بمسعد % 9(@)(@@) % و لا تسألاني عن فؤاد مضيع % فإن فؤادي في الطراف الممدد % 10(@)(@@) % و يا ممرضي بالغور غور تهامة % أعد مرضي فيهم وعد لي تعودي % % PageV01P403 11(@)(@@) % و خل عيون العين تسترق النهى % % و ترمي العميد الصب في كل معمد % 12(@)(@@) % فقد لاح لي تحت الستائر طلعة % أذابت بنور الحسن قلبي وأكبدي % % 13(@)(@@) % إذا نزل العشاق في عرصاتها % % رأوا عجبا من نورها المتصعد % 14(@)(@@) % فكم حولها من هائمين بحبها % % و بين يديها من ركوع وسجد % 15(@)(@@) % رعى الله أيامأ مضت بسويقة % و لذة عيش بالأباطح مرغد % 16(@)(@@) % يقولون كم تحكى وكم تذكر الحمى % % و تستنشد الأشعار من كل منشد % 17(@)(@@) % فقلت لهم خلوا سبيلي فإنني % % أروح على حكم الغرام وأغتدي % % 18(@)(@@) % و ما شاقني برق بأبرق رامة % و لا نغمات من حمام مغرد % 19(@)(@@) % و لا نسمات الريح تنثر لؤلؤا % من الطل عن زهر كدر منضد % 20(@)(@@) % بلى شاقني الوجه السعيد الذي به % % تشعشع نور الحق في كل مشهد % PageV01P404 21(@)(@@) % أعاد علينا الله من بركاته % و أوردنا من بره خير مورد % 22(@)(@@) % فذلك يستسقى الغمام بوجهه % و يفتح في أسراره كل موصد % 23(@)(@@) % إذا ما رأت عيناك بهجة وجهه % رأت بدر تمفي منازل أسعد % 24(@)(@@) % و إن لثمت يمناك يمناه فالتزم % بركن سوى ركن من البيت أسود % 25(@)(@@) % له سيرة مرضية وسريرة % تضيء بنور السنةالمتوقد % 26(@)(@@) % إمام به الدنيا تجلى ظلامها % % و لاح سبيل الرشد عن خير مرشد % 27(@)(@@) % سما بشعار الصالحين وهديهم % و أحيا منار الدين بعد محمد % 28(@)(@@) % إذا ما ذكرنا الأكرمين فإنه % هو الكوثر الفياض والعارض الندي % % 29(@)(@@) % و مهما امتدحنا الصالحين فمدحه % % به نختم الذكر الجميل ونبتدي % % 30(@)(@@) % فلله من غوث لكل مؤمل % و سيف على الأعداء ليس بمغمد % PageV01P405 31(@)(@@) % و معقل عز يلتجا بجنابه % و يروى ببحر من عطاياه مزبد % 32(@)(@@) % فيا سيدي إن 
ms129	 الزمان معاندي % % و أنت لنا نور بك الناس تهتدي % % 33(@)(@@) % وظلك ممدود على كل مسلم % وفضلك مبذول لكل موحد % 34(@)(@@) % ولكنني أشكو إليك نوائبا % يعز لها صبري ويفنى تجلدي % % 35(@)(@@) % فلا قر قلبي بل ولا كف مدمعي % % ولا لذ لي عيشي وشربي ومرقدي % % 36(@)(@@) % و في بيت رغم إخوتي وأحبتي % % مقيمون في ليل من الهم سرمد % 37(@)(@@) % وإن الفقيه المعجلى ضاق ذرعه % لعتبك يا مصباح غور وأنجد % 38(@)(@@) % أتاهم كلام منك يا با محمد % يهد الرواسي فاقتصد وترود % 39(@)(@@) % فإن كانعن ذنب فعفوك واسع % و إن لم يكن ذنب فلا ترض حسدي % % 40(@)(@@) % و حاشاك تحمى الأرض شرقا ومغربا % و تهمل إخوتي وتظلم مسجدي % % PageV01P406 41(@)(@@) % فأسبل عليهم ستر صفحك واحمهم % بجاهك يا مولاي من كل معتدي % % 42(@)(@@) % و قم بي فإني وابن عمي وكل من % يلينا نرجي جاه وجهك سيدي % % 43(@)(@@) % و هاك من الدر النضيدغرائبا % مؤلفها عبد الرحيم بن أحمد % 44(@)(@@) % و لم أبغ منكمغير صالح دعوة % يطول بها باعي وتعلو بها يدي % % 45(@)(@@) % و بعد صلاة الله ثم سلامه % على خير فرع طال من خير محتد % 46(@)(@@) % محمد السامي الفخار وآله % حماة ثغور الدين من كل ملحد % PageV01P407 البحر : - 1(@)(@@) % سلام حواشيه كدر منضد % يروح إلى قطري لهاب ويغتدي % % 2(@)(@@) % تحية مجروح الفؤاد هدية % إلى ابن سليمان بن راشد سيدي % % 3(@)(@@) % تخص خضم العلم القطوف ومن جنى % % جنى ثمرات الخير منبسط اليد % 4(@)(@@) % إمام يحل المشكلات غوامضا % غزير المعاني فاتح كل موصد % 5(@)(@@) % له حجج علمية في خفيها % % طلائع نور السنة المتوقد % 6(@)(@@) % و ماهو إلا سر شكل نبي الورى % % و عروة عز الدين دين محمد % 7(@)(@@) % له الطرق المثلى له الفضل والعلى % % له الشرف الأعلى به الناس تهتدي % % 8(@)(@@) % متى تأته تعشو إلى نار فضله % تجد خير نار عندها خير موقد % 9(@)(@@) % إليك عفيف الدين حامل خدمة % على البعد من عبد الرحيم بن أحمد % 10(@)(@@) % فتى من بني الأسد وافاك زائرا % لتأسيس عهد لا لعهد مجدد % PageV01P408 11(@)(@@) % توسل 
ms130	 بي قربا إليك لعله % عليك احتسابا في القراءة يبتدي % % 12(@)(@@) % فآنس غريبا لا بليت بغربة % و أسعده بالتدريب يا خير مسعد % 13(@)(@@) % ودمت منيع الدار والجار والحمى % % حميد المساعي فائض العارض الندي % % 14(@)(@@) % و طلت مكانا في العلى ومكانة % كأنك شمس في منازل أسعد % 15(@)(@@) % و حييت ماغنت مطوقة الحمى % % على عذبات الأثل في شعب ثهمد % PageV01P409 البحر : - 1(@)(@@) % رياض نجد بكم جنان % فضية نورها حسان % 2(@)(@@) % و ترب واديكم بنجد % مسك وحصباؤهجمان % 3(@)(@@) % و الروح من شعبكم عبير % و الزهر ورد وزعفران % 4(@)(@@) % و الجار في ربعكم عزيز % و الحر في أرضكم يصان % 5(@)(@@) % فكم سفكتم دمي ودمعي % % أما على القاتل الضمان % 6(@)(@@) % كم حن قلبي إلى لقاكم % و دوننا الغور والرعان % 7(@)(@@) % و كدت أخفي الهوى ودمعي % % من شدة الوجد ترجمان % 8(@)(@@) % يالائمين اقصروا ملامي % % رفقا بمن قلبه ملان % 9(@)(@@) % لا تذكروا الظاعنين عندي % % فلي وللظاعنين شان % 10(@)(@@) % قالوا هواهم علي حتم % قلت عهود الهوى رزان % PageV01P410 11(@)(@@) % قالوا فكم تكتب المعاني % % قلت المعنى بهم المعان % % 12(@)(@@) % قالوا فدعهمفقلت كلا % لعل دهرا قسا فلانوا % 13(@)(@@) % قالوا فقد فارقوك ربعا % قلت هم الناس حيث كانوا % % 14(@)(@@) % ليت الصبا الجاجري ينبى % % عن جيرة البان يوم بانوا % % 15(@)(@@) % هل عهدهم عهدهم بنجد % باق أم استئمنوا فخانوا % % 16(@)(@@) % يا محسنا بالزمانظنا % % لم تدرما يفعلالزمان % 17(@)(@@) % لاتتبع النفس في هواها % % إن اتباع الهوى هوان % 18(@)(@@) % واخجلتي من عتاب ربيإلى متى أنت في المعاصي تسير مرخى لك العنان % % إنقالأسرفتيا فلانسقط بيت ص % % 19(@)(@@) % لم ينهك الشيب عن حدودي % % و لا رسوليو لا القرآن % 20(@)(@@) % لو خوفتك الجحيم بطشي % % لشوقت قلبك الجنان % PageV01P411 21(@)(@@) % أنت شجاع على المعاصي % % و أنت عن طاعتي جبان % 22(@)(@@) % عندي لك الصلح وهو بري % % و عندك السيف والسنان % 23(@)(@@) % ترضى بأن تنقضي الليالي % % و ما انقضت حربك العوان % 24(@)(@@) % فاستحي من كاتب كريم % يحصى به الفعل واللسان % 25(@)(@@) % فاستحي من شيبة تراها % % في النار مسجونةتهان % 26(@)(@@) % أي أوان تتوب فيه % هلبعد قطع الرجا 
ms131	 أوان % 27(@)(@@) % آثرت غيري علي لكن % كما يدين الفتى يدان % 28(@)(@@) % ياسيدي هذه عيوبي % % و أنت في الخطب مستعان % 29(@)(@@) % يا من له في العصاة شأن % و شأنهالعطف والحنان % 30(@)(@@) % يا منملابره النواحي % % لم يخل من بره مكان % PageV01P412 31(@)(@@) % عفوا فإنيرهين ذنبي % % حاشاك أن يغلق الرهان % 32(@)(@@) % فاغفر لعبد الرحيم والطف % بخائف ما لهأمان % 33(@)(@@) % و سامح الكل في ذنوب % غدا بها تشهد البنان % 34(@)(@@) % وصل يا ذا العلا وسلم % على من أخلاقه حسان % 35(@)(@@) % محمد من عليه أنزل % طه وطس والدخان % PageV01P413 البحر : - 1(@)(@@) % علعرس الظاعن المشيم % بالأبرق الفرد يا نسيم % 2(@)(@@) % أم راح في الركب يوم راحوا % % لهم لرسم الحمى رسيم % 3(@)(@@) % فليتني كنت في المطايا % % أو خلف آثارهم أهيم % 4(@)(@@) % فكم دعا البين من قلوب % في ركبهم مالها من جسوم % 5(@)(@@) % يا نازلين اللوى اليماني % هل عند أحيبابنا علوم % 6(@)(@@) % ما حال ربع الفريق بعدى % و كيف الاطلال والرسوم % 7(@)(@@) % ليت الصبا الحاجري حيا % % أرضا فؤادي بها مقيم % 8(@)(@@) % و ليت عيني ترى بنجد % روضا تناعت به الغيوم % 9(@)(@@) % و حيث ماء العذيب عذب % عليه ورق الحمى تحوم % 10(@)(@@) % إذا دعت بالسجوع قلبي % أجابها دمعي السجوم % PageV01P414 11(@)(@@) % أحباب قلبي مضى زماني % و نغصت عيشي الهموم % 12(@)(@@) % و فرق الموت أهل عصري % % فلا صديق ولا حميم % 13(@)(@@) % و خلف الدهر خلف سوء % كأنني بينهم يتيم % 14(@)(@@) % و الآن حان الرحيل مني % % و هذه الدار لا تدوم % 15(@)(@@) % و ما تزودتغير ذنب % عذابه دائم أليم % 16(@)(@@) % يصرخ الواعظ بي وقلبي % كأنه صخرة صميم % 17(@)(@@) % أبارز الله بالخطايا % % و الله سبحانه حليم % 18(@)(@@) % فكم خلعت العذار جهلا % و لمت في الغي من يلوم % 19(@)(@@) % و كم تعاميت عن رشادي % % و منهج الحق مستقيم % 20(@)(@@) % لا أنتهي عن قبيح فعلى % و لا أصلي ولا أصوم % PageV01P415 21(@)(@@) % عصيت طفلا وصرت أعصي % و الشيب في مفرقي يحوم % 22(@)(@@) % شيب وعيب و حمل ذنب % و الذنب بعد المشيب شوم % 23(@)(@@) % يا جامع المال من حرام 
ms132	 % سيقتضى مالك الغريم % 24(@)(@@) % و تقتضيوزرهو تلقى % % في النار يغليبك الحميم % 25(@)(@@) % و كيف يهنيك صفو عيش % ختامهعلقم عقيم % 26(@)(@@) % ياواسع اللطف جد ليبفضل % و رحمة منكيا كريم % 27(@)(@@) % إن قال عبد الرحيم ذنبي % % فقلأناالمشفقا الرحيم % 28(@)(@@) % و إنشكامن خصوم سوء % فحلماتعقدالخصوم % 29(@)(@@) % و سامحالكل في ذنوب % أنتبهاسيديعليم % 30(@)(@@) % و صليا ذاالعلى و سلم % على الذيفضله عميم % PageV01P416 31(@)(@@) % محمد سيد البرايا % % و آلهالسادةالنجوم % PageV01P417 البحر : - 1(@)(@@) % تنبهوا يا رقود % إلى متى ذا الجمود % 2(@)(@@) % فهذه الدار جمع % % 3(@)(@@) % تفنى ومابها يبيد % الخير فيها قليل % 4(@)(@@) % و الشر فيها عتيد % % 5(@)(@@) % و العمرينقص فيها % % وسيئاتيتزيد % 6(@)(@@) % و كلما مر يوم % % 7(@)(@@) % منها فليس يعود % فاستكثروا الزاد فيها % % 8(@)(@@) % إن الطريق بعيد % % 9(@)(@@) % و لا تطيعوا نفوسا % شيطانهنمريد % 10(@)(@@) % يا من يريد خلودا % % PageV01P418 11(@)(@@) % هيهات منك الخلود % سل ابن آدم جدا % % 12(@)(@@) % تعزى إليه الجدود % % 13(@)(@@) % و أين شيث ونوح % و أين عاد وهود % 14(@)(@@) % و مدين و شعيب % % 15(@)(@@) % و صالح وثمود % و أين فرعونمصر % 16(@)(@@) % و تبع والجنود % % 17(@)(@@) % يا تائها في المعاصي % % عد واعتذر يا طريد % 18(@)(@@) % و جاهد النفس فيها % % 19(@)(@@) % تمت وأنت شهيد % من قبل تلقى بقبر % 20(@)(@@) % يذرى عليك الصعيد % % PageV01P419 21(@)(@@) % و العظم في الترب يبلى % % و يأكل اللحم دود % 22(@)(@@) % يا من تعدى حدودا % % 23(@)(@@) % أما نهتك الحدود % لنا عليكم عهود % 24(@)(@@) % فأين تلك العهود % % 25(@)(@@) % ذلوا ولوذوابعزي % % يلقى المريد المريد % 26(@)(@@) % و استمطروا غيم بري % % 27(@)(@@) % إن الجواد يجود % و استعطفونيبعذر % 28(@)(@@) % إن كان عذري يفيد % % 29(@)(@@) % واخشوا عواقب مكر % أبدي به وأعيد % 30(@)(@@) % إن كان فضلي عظيما % % PageV01P420 31(@)(@@) % فإنبطشي شديد % أين الألى نازعوني % % 32(@)(@@) % ملكي وهم لي عبيد % % 33(@)(@@) % أنساهم الذكر عز % و عدة و عديد % 34(@)(@@) % فالفال فيهم سعيد % % 35(@)(@@) % و الطالعاتسعود % و المال يجبى إليهم % 36(@)(@@) % و العيش حلو رغيد % % 37(@)(@@) % ماتوا وضاقت عليهم % بعد القصور اللحود % 38(@)(@@) % و الملك ملكي ويبقى % % 39(@)(@@) % وجهي ويفنى الوجود % ولي وللخلق يوم % 40(@)(@@) % يشيب منه 
ms133	 الوليد % % PageV01P421 41(@)(@@) % و يشمل الناس وعد % يرجى ويخشى وعيد % 42(@)(@@) % و الصحف تلقى إليهم % % 43(@)(@@) % منهن بيض وسود % غدا ينادى المنادي % % 44(@)(@@) % و هم إليه وفود % % 45(@)(@@) % كل عليهحفيظ % و سائق وشهيد % 46(@)(@@) % و حوله عن يمين % % 47(@)(@@) % و عن شمال قعيد % يا منكر البعث هذا % % 48(@)(@@) % ما كنت منه تحيد % % 49(@)(@@) % الحق يقضى والاعضا % % منهم عليهم شهود % 50(@)(@@) % و في جهنم نار % % PageV01P422 51(@)(@@) % لها العصاة وقود % إذا نضجت جلود % 52(@)(@@) % بدلت فيها جلود % % 53(@)(@@) % و الظل فيها سموم % و الحلي فيها حديد % 54(@)(@@) % و ذا طعام ضريع % % 55(@)(@@) % و ذا شراب صديد % يا واسعاللطف يا من % 56(@)(@@) % هو الولي الحميد % % 57(@)(@@) % يا من له في البرايا % % عطف و بر وجود % 58(@)(@@) % قل حين يمحى شقائي % % 59(@)(@@) % عبد الرحيم سعيد % اعطف عليه % 60(@)(@@) % بفضل ورحمة يا ودود % % PageV01P423 61(@)(@@) % وأبلغ الكل منا ياسيدي % % ما يريد وصل فضلا على من % 62(@)(@@) % بذكرهنستفيد محمد % ما تلالا برق وحنت رعود % PageV01P424 البحر : - 1(@)(@@) % كم إذا أراها نحو طيبة يرتمي % % عنقا بنيات الجديل وشدقم % 2(@)(@@) % طرقت سحيرا وهي تبتدر الفلا % % و لها حنين الراعد المتزرجم % 3(@)(@@) % من كان في أرض الحجاز مناديا % فلقد دعاها يا مطية قدمي % % 4(@)(@@) % نادى بها صوتا فأرق جفنها % % فبكت ولبت بالضمير المبهم % 5(@)(@@) % شكرت من النيابتين فلم تزل % تطوى المهامة معلما في معلم % 6(@)(@@) % و استقبلت أرض الحطيم وزمزم % فصبت إلى أرض الحطيم وزمزم % 7(@)(@@) % حادى المطى قف المطى لعلها % % تحظى بحظ من غرام المغرم % 8(@)(@@) % و أمل إلى حرم الأمين صدورها % % فإذا بدا الحرم الأمين فيمم % 9(@)(@@) % و اشغل ببيت الله طرفك خشية % و طف القدوم به طواف المحرم % 10(@)(@@) % و هناك فاستغفر لذنبك ربما % % تحظى بغفران الذنوب وتكرم % PageV01P425 11(@)(@@) % فإذا انتهيت إلى الحجاز فحي من % فيه وصل على النبي وسلم % 12(@)(@@) % الأبطحي المنتقى من غالب % % تاج النبوة عصمة المستعصم % 13(@)(@@) % سمت السموات العلى أنواره % فتبسمت من نوره المبتسم % 14(@)(@@) % و أضاء في الآفاق صبح جبينه % نورا وليس الصبح بالمتكتم 
ms134	 % 15(@)(@@) % و سرائر التقوى سرت بمحمد % حتى استنار دجى الهزيع المظلم % 16(@)(@@) % فخرت بأحمد آل كعب ياله % اسما سمت فيه الصفات عن السمى % 17(@)(@@) % إذ كان آل كنانة بن خزيمة % % تاهت بفرع من خزيمة ينتمي % % 18(@)(@@) % عقدت لؤي لوا الفخار بفخره % و أناف عبد مناف فوق الأنجم % 19(@)(@@) % و سما بنهر كل فخر شامخ % و رقت خزيمة فيه ذروة أخزم % 20(@)(@@) % و بهاشم هشمت ثرائد جودهم % كرما ولولا هاشم لم تهشم % PageV01P426 21(@)(@@) % و لغالب غلب الرقاب خواضع % هو باسم قال النصر أول من سمى % % 22(@)(@@) % هو أهل دين الله لما اختاره % داع إلى الدين الحنيف القيم % 23(@)(@@) % هو في يمين الله سيف مصلت % يفري به الرحمن هام المجرم % 24(@)(@@) % ليث الفراسة يوم يشتجر القنا % % متفيئا ظل القنا المتحطم % 25(@)(@@) % ماضي العزيمة حين يقتحم الوغى % % غلب الكتائب ياله من معلم % 26(@)(@@) % خلقت من الشيم الشريفة نفسه % هو للخليفة عروة لم تفصم % 27(@)(@@) % السيد العدل التقى المنتقى % % و الأكرم ابن الأكرم ابن الأكرم % 28(@)(@@) % أعظم به يوم القيامة إنه % أهل الشفاعة عند أعظم أعظم % 29(@)(@@) % أعنى المظلل بالغمامة والذي % فاضت أنامله بغيث مسجم % 30(@)(@@) % و بفضله درت حليمة حين مس % % س الضرع منها بالبنان وبالفم % PageV01P427 31(@)(@@) % و النوق حين تكلمت بفخاره % و لغير ذاك البدر لم تتكلم % 32(@)(@@) % و كلام عضو الخيبرية عندما % % مدت بعضو للرسول مسمم % 33(@)(@@) % و الخمسة الأفراص والشاة التي % % كانت لحزب الله أحسن مطعم % 34(@)(@@) % و سمعت أن الشاة أرسل كفه % بحياتها قبل انتهاش الأعظم % 35(@)(@@) % و دعا بإذن الله ابني جابر % بعد الفنا فهناك وجد المعدم % 36(@)(@@) % و التفت الأشجار عنه لحاجة % فأتت كعقد عند ذاك منظم % 37(@)(@@) % و رجال مكة أخجلوا إذا أحضروا % % لهبوط بدر في السماء متمم % 38(@)(@@) % أفتنكر التزميل من جبريله % لما تمثل بالهزبر الضيغم % 39(@)(@@) % و دعاه فاقرأ باسم ربك معلنا % و افخر بتنزيل الكتاب المحكم % 40(@)(@@) % ناداه باسم الله يا علم الهدى % % أعلمت من ناداك أم لم تعلم % PageV01P428 41(@)(@@) % يامن إذا ناديته 
ms135	 لملمة % لبى نداي برحمة وتكرم % 42(@)(@@) % مولاي لا والله مالي ملجأ % إلا حماك فجد وأول وأنعم % 43(@)(@@) % و اعطف على عبد الرحيم برحمة % يا ملجأ المستعطف المسترحم % 44(@)(@@) % إن كنت جار الجنب في نيابتي % % برع فمن حصني سواك وملزمي % % 45(@)(@@) % قصدي ومقصودي رضاك ولم أزل % مالي ومأمولي إليك ومغنمى % 46(@)(@@) % أنا في جوارك من مكايدة الورى % % أنا في زمامك من زفير جهنم % 47(@)(@@) % أنا في حماك من المكاره إنه % من جاء مضطرا حماك فقد حمى % % 48(@)(@@) % و عليك صلى الله يا علم الهدى % % ما انهل فياض الحيا المتسجم % PageV01P429 البحر : - 1(@)(@@) % لي في نوالك يا مولاي آمال % من حيث لا ينفع الأهلون والمال % 2(@)(@@) % أوصى إليك لعلمي أن لطفك بي % دون الورى لم يحل عني إذا حالوا % % 3(@)(@@) % فأرض عني خصومي واقض يا أملي % ديني فإن حقوق الخلق أثقال % 4(@)(@@) % و لم يضق بي منك العفو إن ختمت % % لي بالشهادة أقوال وأفعال % 5(@)(@@) % كن لي إذا أغمضوا عيني أو انصرفوا % % باكين أسمع منهم كل ما قالوا % % 6(@)(@@) % و امنن بروح وريحان على إذا % % ضاق الخناق فهول الموت أهوال % 7(@)(@@) % و جاءني ملك الموت الموكل بي % % و بالنفوس فللأعمار آجال % 8(@)(@@) % و استخرج النفس أملاك مطهرة % لها إلى لطفك المأمول ترحال % 9(@)(@@) % جاؤا إليك بها يا ربي يقدمها % % لحضرة القدس جبريل وميكال % 10(@)(@@) % ثم انثنت عن قريب نحو مغتسل % في حيث يرجوك مغسول وغسال % PageV01P430 11(@)(@@) % و ليس لي ولمثلي غير جودك يا % % من لا تدانيه أشباه وأمثال % 12(@)(@@) % أصبحت بين يديك اليوم مطرحا % و لي بنفسي عن الأغيار أشغال % 13(@)(@@) % فأولني يا غفور العفو منك فلا % يبقي على من الأوزار مثقال % 14(@)(@@) % وإن نزلت إلى بيت الخراب ولا % % أب هناك ولا عم ولا خال % 15(@)(@@) % و عاودت حركاتي وهي ساكنة % ولا عدو يعاديني ولا مال % 16(@)(@@) % ألهمني يا خالقي ذكر الجواب ففي % % ذاك المقام جوا بات وتسآل % 17(@)(@@) % هناك لا أمل يرجى ولا عمل % يجزي ولا حيلة عندي فأحتال % 18(@)(@@) % إفتح لروحي 
ms136	 إلى الفردوس باب رضا % % يهدي رياح رياض ظلها ضال % 19(@)(@@) % و الطف ورائي بأطفال وأمهم % إن كان خلفي أو يلاد وأطفال % 20(@)(@@) % حتى إذا نشر الأموات وارتعدت % فرائض الخلق من بعض الذي نالوا % % PageV01P431 21(@)(@@) % وعادت الروح في الجسم الضعيف وقد % تفرقت منه أعضاء وأوصال % 22(@)(@@) % مربى الصراط إلى حوض ابن آمنة % لأستقى منه ريا فهو سلسال % 23(@)(@@) % يا واسع اللطف قد قدمت معذرتي % % إن كان يغني عن التفصيل إجمال % 24(@)(@@) % فجد على ولا طفنى بعفوك عن % ذنبي فشأنك إنعام وإفضال % 25(@)(@@) % و قل كفيتك يا عبد الرحيم أذى الد % ارين فانزل حمى ما فيه إهمال % 26(@)(@@) % و احنبني العجب والشح المطاع ومر % نفسي تخالف هواها فهو قتال % 27(@)(@@) % وعد على بنور منك مبتهج % يزكو به بصرى والسمع والبال % 28(@)(@@) % و ارحم بني وآبائيحاشيتي % % يعمهم يا إلهي منك إقبال % 29(@)(@@) % ماذا أقول ومني كل معصية % و منك يا سيدي حلم وإمهال % 30(@)(@@) % و من أكون وما قدري وماعملي % في يوم توضع في الميزان أعمال % PageV01P432 31(@)(@@) % و هل يطيق خلودا في لظى بشر % من نطفة أصلها المسكين صلصال % 32(@)(@@) % أم كيف ييأس من روح الإله غدا % عبد عليه من الإسلام سر بال % 33(@)(@@) % رباه رباه أنت الله معتمدي % % في كل حال إذا حالت بي الحال % 34(@)(@@) % ثم الصلاة على المختار من مضر % ما لاح في الغور آل بعده آل % 35(@)(@@) % يس خاتم رسل الله كلهم % و الصحب والآل نعم الصحب والآل % PageV01P433 
