ms41	(@)(@@) % أدنت نقابا على الخدين وانتسبت % للناظرين بقد ليس ينتسب % 8(@)(@@) % ولو تبسم عجنا الطرف في برد % وفي أقاح سقتها الخمر والضرب % 9(@)(@@) % من شكله الدر في رصف النظام ومن % صفاته الفتنتان : الظلم والشنب % 10(@)(@@) % كانت لنا ملعبا نلهو بزخرفه % وقد ينفس عن جد الفتى اللعب % PageV01P131 11(@)(@@) % وعاذل هاج لي باللوم مأربة % باتت عليها هموم النفس تصطخب % 12(@)(@@) % لما أطال ارتجال العذل قلت له : % الحزم يثني خطوب الدهر لا الخطب % 13(@)(@@) % لم يجتمع قط في مصر ولاطرف % محمد بن أبي مروان والنوب % 14(@)(@@) % لي من أبي جعفر آخية سبب % إن تبق يطلب إلى معروفي السبب % 15(@)(@@) % صحت ، فما تمارى من تأملها % % من نحو نائله في أنها نسب % 16(@)(@@) % أمت نداه ، بي العيس التي شهدت % لها السرى والفيافي أنها نجب % 17(@)(@@) % هم سرى ثم أضحى همة أمما % أضحت رجاء وأمست وهي لي نشب % 18(@)(@@) % أعطى ونطفة وجهي في قرارتها % % تصونها الوجنات الغضة القشب % 19(@)(@@) % لن يكرم الظفر المعطى وإن أخذت % به الرغائب حتى يكرم الطلب % 20(@)(@@) % إذا تباعدت الدنيا فمطلبها % % إذا توردته من شعبه كثب % PageV01P132 21(@)(@@) % ردء الخلافة في الجلى إذا نزلت % وقيم الملك لا الواني ولا النصب % 22(@)(@@) % جفن يعاف لذيذ النوم ناظره % شحا عليها وقلب حولها يحب % 23(@)(@@) % طليعة رأيه من دون بيضتها % % كما انتمى رابئ في الغزو منتصب % 24(@)(@@) % حتى إذا ما انتضى التدبير ثاب له % جيش يصارع عنه ما له لجب % 25(@)(@@) % شعارها اسمك إن عدت محاسنها % % إذ اسم حاسدك الأدنى لها لقب % 26(@)(@@) % وزير حق ووالي شرطة ورحا % % ديوان ملك وشيعي ومحتسب % 27(@)(@@) % كالأرحبي المذكي سيره المرطى % % والوخد والملع والتقريب والخبب % 28(@)(@@) % عود تساجله أيامه فبها % % من مسه وبه من مسها جلب % 29(@)(@@) % ثبت الجنان إذا اصطكت بمظلمة % في رحله ألسن الأقوام والركب % 30(@)(@@) % لا المنطق اللغو يزكو في مقاومه % يوما ولا حجة الملهوف تستلب % PageV01P133 31(@)(@@) % كأنما هو في نادي قبيلته % لا القلب يهفو ولا الأحشاء تضطرب % 32(@)(@@) % وتحت ذاك قضاء حز شفرته % كما يعض بأعلى الغارب 
ms42	 القتب % 33(@)(@@) % لا سورة تتقى منه ولابله % ولا يحيف رضا منه ولاغضب % 34(@)(@@) % ألقى إليك عرى الأمر الإمام ، فقد % شد العناج من السلطان والكرب % 35(@)(@@) % يعشو إليك وضوء الراي قائده % خليفة إنما آراؤه شهب % 36(@)(@@) % إن تمتنع منه في الأوقات رؤيته % فكل ليث هصور غيله أشب % 37(@)(@@) % أو تلق من دونه حجب مكرمة % يوما فقد ألقيت من دونك الحجب % 38(@)(@@) % والصبح تخلف نور الشمس غرته % وقرنها من وراء الأفق محتجب % 39(@)(@@) % أما القوافي فقد حصنت عذرتها % % فما يصاب دم منها ولا سلب % 40(@)(@@) % منعت إلا من الأكفاء ناكحها % % وكان منك عليها العطف والحدب % PageV01P134 41(@)(@@) % ولو عضلت عن الأكفاء أيمها % % ولم يكن لك في أطهارها أرب % 42(@)(@@) % كانت بنات نصيب حين ضن بها % % عن الموالي ، ولم تحفل بها العرب % 43(@)(@@) % أما وحوضك مملوء ، فلا سقيت % خوامسي إن كفى أرسالها الغرب % 44(@)(@@) % لو أن دجلة لم تحوج وصاحبها % % أرض العراقين لم تحفر بها القلب % 45(@)(@@) % لم ينتدب عمر للإبل يجعل من % هذا اللجين فدارت فيهم العلب % 47(@)(@@) % إن الأسنة والماذي مذ كثرا % % فلا الصياصي لها قدر ولا اليلب % 48(@)(@@) % لا نجم من معشر إلا وهمته % عليك دائرة يا أيها القطب % 49(@)(@@) % وما ضميري في ذكراك مشترك % ولا طريقي إلى جدواك منشعب % 50(@)(@@) % لي حرمة بك لولا ما رعيت وما % % أوجبت من حفظها ما خلتها تجب % 51(@)(@@) % بلى لقد سلفت في جاهليتهم % للحق ليس كحقي نصرة عجب % PageV01P135 52(@)(@@) % أن تعلق الدلو بالدلو الغريبة أو % يلابس الطنب المستحصد الطنب % 53(@)(@@) % إن الخليفة قد عزت بدولته % دعائم الدين ، فليعزز بك الأدب % 54(@)(@@) % مالي أرى جلبا فعما ولست أرى % % سوقا وما لي أرى سوقا ولاجلب ! % 55(@)(@@) % أرض بها عشب جرف وليس بها % % ماء وأخرى بها ماء ولا عشب % 56(@)(@@) % خذها مغربة في الأرض آنسة % بكل فهم غريب حين تغترب % 57(@)(@@) % من كل قافية فيها إذا اجتنيت % % من كل مايجتنيه المدنف الوصب % 58(@)(@@) % الجد والهزل في توشيع لحمتها % % والنبل والسخف والأشجان والطرب % 59(@)(@@) % لايستقى من جفير الكتب 
ms43	 رونقها % % ولم تزل تستقي من بحرها الكتب % 60(@)(@@) % حسيبة في صميم المدح منصبها % % إذ أكثر الشعر ملقى ما له حسب % PageV01P136 البحر : طويل 1(@)(@@) % متى أنت عن ذهلية الحي ذاهل % وقلبك منها مدة الدهر آهل ! % 2(@)(@@) % تطل الطلول الدمع في كل موقف % وتمثل بالصبر الديار المواثل % 3(@)(@@) % دوارس لم يجف الربيع ربوعها % % ولامر في أغفالها وهو غافل % 4(@)(@@) % فقد سحبت فيها السحائب ذيلها % % وقد أخملت بالنور فيها الخمائل % 5(@)(@@) % تعفين من زاد العفاة إذا انتحى % % على الحي صرف الأزمة المتماحل % 6(@)(@@) % لهم سلف سمر العوالي وسامر % وفيهم جمال لا يغيض وجامل % 7(@)(@@) % ليالي أضللت العزاء وجولت % بعقلك آرام الخدور العقائل % 8(@)(@@) % من الهيف لو أن الخلاخل صيرت % لها وشما جالت عليا الخلاخل % 9(@)(@@) % مها الوحشي إلا أن هاتا أوانس % قنا الخط إلا أن تلك ذوابل % 10(@)(@@) % هوى كان خلسا إن من أحسن الهوى % % هوى جلت في أفنائه ، وهو خامل % PageV01P137 11(@)(@@) % أبا جعفر إن الجهالة أمها % % ولود وأم العلم جداء حائل % 12(@)(@@) % أرى الحشو والدهماء أضحوا كأنهم % شعوب تلاقت دوننا وقبائل % 13(@)(@@) % غدوا وكأن الجهل يجمعهم به % أب وذوو الآداب فيهم نواقل % 14(@)(@@) % فكن هضبة نأوي إليها وحرة % يعرد عنها الأعوجي المناقل % 15(@)(@@) % فإن الفتى في كل ضرب مناسب % مناسب روحانية من يشاكل % 16(@)(@@) % ولم تنظم العقد الكعاب لزينة % كما تنظم الشمل الشتيت الشمائل % 17(@)(@@) % وأنت شهاب في الملمات ثاقب % وسيف إذا ما هزك الحق قاصل % 18(@)(@@) % من البيض لم تنض الأكف كنصله % ولا حملت مثلا إليه الحمائل % 19(@)(@@) % مؤرث نار والإمام يشبها % % وقائل فصل والخليفة فاعل % 20(@)(@@) % وإنك إن صد الزمان بوجهه % لطلق ومن دون الخليفة بباسل % PageV01P138 21(@)(@@) % لئن نقموا حوشية فيك دونها % % لقد علموا عن أي علق تناضل % 22(@)(@@) % هي الشيء ، مولى المرء قرن مباين % له وابنه فيها عدو مقاتل % % 23(@)(@@) % إذا فضلت عن رأي غيرك أصبحت % % ورأيك عن جهاتها الست فاضل % 24(@)(@@) % وخطب جليل دونها قد شغلته % وفي دونه شغل لغيرك شاغل % 25(@)(@@) % رددت السنا في شمسه بعد كلفة 
ms44	 % كأن انتصاف اليوم فيها أصائل % 26(@)(@@) % ترى كل نقص تارك العرض والتقى % % كمالا إذا الملك اعتدى وهو كامل % 27(@)(@@) % جمعت عرى أعمالها بعد فرقة % إليك كما ضم الأنابيب عامل % 28(@)(@@) % فأضحت وقد ضمت إليك ولم تزل % تضم إلى الجيش الكثيف القنابل % 29(@)(@@) % وما برحت صورا إليك نوازعا % أعنتها مذ راسلتك الرسائل % 30(@)(@@) % لك القلم الأعلى الذي بشباته % % تصاب من الأمر الكلى والمفاصل % PageV01P139 31(@)(@@) % له الخلوات اللاء لولا نجيها % % لما احتفلت للملك تلك المحافل % 32(@)(@@) % لعاب الأفاعي القاتلات لعابه % وأري الجنى اشتارته أيد عواسل % 33(@)(@@) % له ريقة طل ولكن وقعها % % بآثاره في الشرق والغرب وابل % 34(@)(@@) % فصيح إذا استنطقته وهو راكب % وأعجم إن خاطبته وهو راجل % 35(@)(@@) % إذا ما امتطى الخمس اللطاف وأفرغت % عليه شعاب الفكر وهي حوافل % 36(@)(@@) % أطاعته أطراف القنا وتقوضت % لنجواه تقويض الخيام الجحافل % 37(@)(@@) % إذا استغزر الذهن الذكي وأقبلت % أعاليه في القرطاس وهي أسافل % 38(@)(@@) % وقد رفدته الخنصران وشددت % ثلاث نواحيه الثلاث الأنامل % 39(@)(@@) % رأيت جليلا شأنه وهو مرهف % ضنى وسمينا خطبه وهو ناحل % 40(@)(@@) % أرى ابن أبي مروان أما عطاؤه % فطام وأما حكمه فهو عادل % PageV01P140 41(@)(@@) % هو المرء لا الشورى استبدت برأيه % ولا قبضت من راحتيه العواذل % 42(@)(@@) % معرس حق ماله ولربما % % تحيف منه الخطب والخطب باطل % 43(@)(@@) % لقاح ، فلم تخدجه بالضيم منة % % ولانال أنفا منه بالذل نائل % 44(@)(@@) % ترى حبله غرثان من كل غدرة % إذا نصبت تحت الحبال الحبائل % 45(@)(@@) % فتى لا يرى أن الفريصة مقتل % ولكن يرى أن العيوبا لمقاتل % 46(@)(@@) % ولا غمر قد رقص الخفض قلبه % % ولاطارف في نعمة الله جاهل % 47(@)(@@) % أبا جعفر إن الخليفة إن يكن % لورادنا بحرا فإنك ساحل % 48(@)(@@) % وما راغب أسرى إليك براغب % ولاسائل أم الخليفة سائل % 49(@)(@@) % تقطعت الأسباب إن لم تغر لها % % قوى ويصلها من يمينك واصل % 50(@)(@@) % سوى مطلب ينضي الرجاء بطوله % % وتخلق إخلاق الجفون الوسائل % PageV01P141 51(@)(@@) % وقد تألف العين الدجى وهو قيدها % % ويرجى شفاء السم السم قاتل % 52(@)(@@) % ولي همة تمضي العصور وإنها % % كعهدك 
ms45	 من أيام وعدك حامل % 53(@)(@@) % سنون قطعناهن حتى كأنما % % قطعنا لقرب العهد منها مراحل % 54(@)(@@) % وإن جزيلات الصنائع لامرئ % إذا ما الليالي ناكرته معاقل % 55(@)(@@) % وإن المعالي يوم بناءها % % وشيكا كما قد تسترم المنازل % 56(@)(@@) % ولو حاردت شول عذرت لقاحها % % ولكن حرمت الدر والضرع حافل % 57(@)(@@) % منحتكها تشفي الجوى ، وهو لاعج % وتبعث أشجان الفتى ، وهو ذاهل % 58(@)(@@) % ترد قوافيها إذا هي أرسلت % هوامل مجد القوم وهي هوامل % 59(@)(@@) % فكيف إذا حليتها بحليها % % تكون وهذا حسنها وهي عاطل % 60(@)(@@) % أكابرنا عطفا علينا فإننا % % بنا ظمأ مرد وأنتم مناهل % PageV01P142 البحر : كامل تام 1(@)(@@) % أما وقد ألحقتني بالموكب % ومددت من ضبعي إليك ومنكبي % % 2(@)(@@) % فلأعرضن عن الخطوب وجورها % % ولأصفحن عن الزمان المذنب % 3(@)(@@) % ولألبسنك كل بيت معلم % يسدى ويلحم بالثناء المعجب % 4(@)(@@) % من بزة المدح التي مشهورها % % متمكن في كل قلب قلب % 5(@)(@@) % نوار أهل المشرق الغض الذي % % يجنونه ريحان أهل المغرب % 6(@)(@@) % أبديت لي عن جلدة الماء الذي % % قد كنت أعهده كثير الطحلب % 7(@)(@@) % ووردت بي بحبوحة الوادي ولو % خليتني لوقفت عند المذنب % 8(@)(@@) % وبرقت لي برق اليقين وطالما % % أمسيت مرتقبا لبرق الخلب % 9(@)(@@) % وجعلت لي مندوحة من بعد ما % % أكدى علي تصرفي وتقلبي % % 10(@)(@@) % والحر يسلبه جميل عزائه % ضيق المحل فكيف ضيق المذهب ؟ % PageV01P143 11(@)(@@) % هيهات يأبى أن يضل بي السرى % % في بلدة وسناك فيها كوكبي % % 12(@)(@@) % ولقد خشيت بأن تكون غنيمتي % % حر الزمان بها وبردالمطلب % 13(@)(@@) % أما وأنت وراء ظهري معقل % فأنهضن بفقار صلب صلب % 14(@)(@@) % وكذلك كانوا لا يخشون الوغا % % إلا إذا عرفوا طريق المهرب % PageV01P144 البحر : كامل تام 1(@)(@@) % آلت أمور الشرك شر مآل % وأقر بعد تخمط وصيال % 2(@)(@@) % غضب الخليفة للخلافة غضبة % رخصت لها المهجات وهي غوالي % % 3(@)(@@) % لما انتضى جهل السيوف لبابك % أغمدن عنه جهالة الجهال % 4(@)(@@) % فلأذربيجان اختيال بعدما % % كانت معرس عبرة ونكال % 5(@)(@@) % سمجت ونبهنا على استسماجها % % ما حولها من نضرة وجمال % 6(@)(@@) % وكذاك لم تفرط كآبة عاطل % حتى يجاورها الزمان بحالي % % 7(@)(@@) % أطلقتها من كيده 
ms46	 وكأنما % % كانت به معقولة بعقال % 8(@)(@@) % خرق من الأيام مد بضبعه % % صعدا وأعطاه بغير سؤال % 9(@)(@@) % خاف العزيز به الذليل وغودرت % نبعات نجد سجدا للضال % 10(@)(@@) % قد أترعت منه الجوانح رهبة % بطلت لديها سورة الأبطال % PageV01P145 11(@)(@@) % لو لم يزاحفهم لزاحفهم له % ما في صدورهم من الأوجال % 12(@)(@@) % بحر من المكروه عب عبابه % % ولقد بدا وشلا من الأوشال % 13(@)(@@) % جفت به النعم النواعم وانثنت % سرج الهدى فيه بغير ذبال % 14(@)(@@) % وأباح نصل السيف كل مرشح % لم يحمرر دمه من الأطفال % 15(@)(@@) % ما حل في الدنيا فواق بكية % حتى دعاه السيف بالترحال % 16(@)(@@) % رعبا أراه أنه لم يقتل الآ % % ساد من أبقى على الأشبال % 17(@)(@@) % لو عاين الدجال بعض فعاله % لانهل دمع الأعور الدجال % 18(@)(@@) % أعطى أمير المؤمنين سيوفه % فيه الرضا وحكومة المقتال % 19(@)(@@) % مستيقنا أن سوف يمحو قتله % % ماكان من سهو ومن إغفال % 20(@)(@@) % مثل الصلاة إذا أقيمت أصلحت % % ماقبلها من سائر الأعمال % PageV01P146 21(@)(@@) % فرماه بالأفشين بالنجم الذي % % صدع الدجى صدع الرداء البالي % % 22(@)(@@) % لاقاه بالكاوي العنيف بدائه % % لما رآه لم يفق بالطالي % % 23(@)(@@) % يا يوم أرشق كنت رشق منية % للخرمية صائب الآجال % 24(@)(@@) % أسرى بنو الإسلام فيه وأدلجوا % % بقلوب أسد في صدور رجال % 25(@)(@@) % قد شمروا عن سوقهم في ساعة % أمرت إزار الحرب بالإسبال % 26(@)(@@) % وكذاك ما تنجر أذيال الوغى % % إلا غداة تشمر الأذيال % 27(@)(@@) % لما رآهم بابك دون المنى % % هجر الغواية بعد طول وصال % 28(@)(@@) % تخذ الفرار أخا وأيقن أنه % صري عزم من أبي سمال % 29(@)(@@) % قد كان حزن الخطب في أحزانه % % فدعاه داعي الحين للإسهال % 30(@)(@@) % لبست له خدع الحروب زخارفا % فرقن بين الهضب والأوعال % PageV01P147 31(@)(@@) % ووردن موقانا عليه شوازبا % شعثا بشعب كالقطا الأرسال % 32(@)(@@) % يحملن كل مدجج سمر القنا % % بإهابه أولى من السربال % 33(@)(@@) % خلط الشجاعة بالحياء فأصبحا % % كالحسن شيب لمغرم بدلال % 34(@)(@@) % فنجا ولو يثقفنه لتركنه % % بالقاع غير موصل الأوصال % 35(@)(@@) % وانصاع عن موقان وهي لجنده % % وله أب بر وأم عيال % 36(@)(@@) % كم أرضعته الرسل لو 
ms47	 أن القنا % % ترك الرضاع له بغير فصال ! % 37(@)(@@) % هيهات روع روعه بفوارس % في الحرب لا كشف ولا أميال % 38(@)(@@) % جعلوا القنا الدرجات للكذجات ذا % % ت الغيل والحرجات والأدحال % 39(@)(@@) % فأولاك هم قد أصبحوا وشروبهم % يتنادمون كؤوس سوء الحال % 40(@)(@@) % ماطال بغي قط إلا غادرت % غلواؤه الأعمار غير طوال % PageV01P148 41(@)(@@) % وبهضبتي أبرشتويم ودروذ % لقحت لقاح النصر بعد حيال % 42(@)(@@) % يوم أضاء به الزمان وفتحت % فيه الأسنة زهرة الآمال % 43(@)(@@) % لولا الظلام وقلة علقوا بها % % باتت رقابهم بغير قلال % 44(@)(@@) % فليشكروا جنح الظلام ودروذا % فهم لدروذ الظلام موالي % % 45(@)(@@) % وسروا بقارعة البيات فزحزحوا % % بقراع لا صلف ولا مختال % 46(@)(@@) % مهر البيات الصبر في متعطف % الصبر وال فيه فوق الوالي % % 47(@)(@@) % ماكان ذاك الهول أجمع عنده % % مع عزمه إلا طروق خيال % 48(@)(@@) % وعشية التل الذي نعش الهدى % % أصل لها فخم من الآصال % 49(@)(@@) % نزلت ملائكة السماء عليهم % لما تداعى المسلمون نزال % 50(@)(@@) % لم يكس شخص فيئه حتى رمى % % وقت الزوال نعيمهم بزوال % PageV01P149 51(@)(@@) % برزت بهم هفوات علجهم وقد % يردي الجمال تعسف الجمال % 52(@)(@@) % فكأنما احتالت عليه نفسه % % إذ لم تنله حيلة المحتال % 53(@)(@@) % فالبذ أغبر دارس الأطلال % ليد الردى أكل من الآكال % 54(@)(@@) % ألوت به ، يوم الخميس ، كتائب % أرسلنه مثلا من الأمثال % 55(@)(@@) % محو من البيض الرقاق أصابه % فعفاه لا محو من الأحوال % 56(@)(@@) % ريحان من صبر ونصر أبليا % % ربعيه لا ريحا صبا وشمال % 57(@)(@@) % لفحت سموم المشرفية وسطه % وهجا وكن سوابغ الأظلال % 58(@)(@@) % كم صارم غصب أناف على فتى % % منهم لأعباء الوغى حمال % 59(@)(@@) % سبق المشيب إليه حتى ابتزه % وطن النهى من مفرق وقذال % 61(@)(@@) % % قد مات صبرا ميتة الرئبال % PageV01P150 62(@)(@@) % أبنا بكل خريدة قد أنجزت % فيها عدات الدهر بعد مطال % 63(@)(@@) % خاضت محاسنها مخاوف غادرت % ماء الصبا والحسن غير زلال % 64(@)(@@) % أعجلن عن شد الإزار وربما % % عودن أن يمشين غير عجال % 65(@)(@@) % مستر دفات فوق جرد أوقرت % أكفالها من رجح الأكفال % 66(@)(@@) % بدلن طول إذالة بصيانة % وكسور خيم من كسور خجال 
ms48	 % 67(@)(@@) % ونجا ابن خائنة البعولة لو نجا % % بمهفهف الكشحين والآطال % 68(@)(@@) % خلى الأحبة سالما لا ناسيا % عذر النسي خلاف عذر السالي % % 69(@)(@@) % هتكت عجاجته القنا عن وامق % أهدى الطعان له خليقه قال % 70(@)(@@) % إن الرماح إذا غرسن بمشهد % فجنى العوالي في ذراه معال % 71(@)(@@) % لما قضى رمضان منه قضاءه % شالت به الأيام في شوال % PageV01P151 72(@)(@@) % مازال مغلول العزيمة سادرا % حتى غدا في القيد والأغلال % 73(@)(@@) % مستسبلا للبأس طوقا من ذم % لما استبان فظاظة الخلخال % 74(@)(@@) % ما نيل حتى طار من خوف الردى % % كل المطار وجال كل مجال % 75(@)(@@) % والنحر أصلح للشرود ، وما شفى % % منه كنحر بعد طول كلال % 76(@)(@@) % لاقى الحمام بسر من راء التي % % 77(@)(@@) % قطعت به أسبابه لما رمى % % 78(@)(@@) % % من عاف متن الأسمر العسال % 79(@)(@@) % لا كعب أسفل موضعا من كعبه % % مع أنه عن كل كعب عال % 80(@)(@@) % سام كأن العز يجذب ضبعه % وسموه من ذلة وسفال % 81(@)(@@) % متفرغ أبدا وليس بفارغ % من لاسبيل له إلى الأشغال % PageV01P152 82(@)(@@) % فاسلم أمير المؤمنين لأمة % أبدلتها الإمراع بالإمحال % 83(@)(@@) % أمسى بك الإسلام بدرا بعد ما % % محقت بشاشته محاق هلال % 84(@)(@@) % أكملت منه بعد نقص كل ما % % نقصته أيدي الكفر بعد كمال % 85(@)(@@) % ألبسته أيامك الغر التي % % أيام غيرك عندهن ليالي % % 86(@)(@@) % وعزائما في الروع معتصمية % ميمونة الإدبار والإقبال % 87(@)(@@) % فتعمق الوزراء يطفوا فوقها % % طفو القذى وتعقب العذال % 88(@)(@@) % والسيف مالم يلف فيه صيقل % من طبعه لم ينتفع بصقال % PageV01P153 البحر : منسرح 1(@)(@@) % إن بكاء في الدار من أربه % فشايعا مغرما على طربه % 2(@)(@@) % ما سجسج الشوق مثل جاحمه % ولاصريح الهوى كمؤتشبه % 3(@)(@@) % جيدت بذاني الأكناف ساحتها % % نائي المدى واكف الجدى سربه % 4(@)(@@) % مزن إذا ما استطار بارقه % أعطى البلاد الأمان من كذبه % 5(@)(@@) % يرجع حرى التلاع مترعة % ريا ويثني الزمان عن نوبه % 6(@)(@@) % متى يضف بلدة فقد قريت % بمستهل الشؤبوب منسكبه % 7(@)(@@) % لا تسلب الأرض بعد فرقته % عهد متابيعه ولا سلبه % 8(@)(@@) % مزمجر المنكبين صهصلق % يطرق أزل الزمان من صخبه % 9 
ms49	(@)(@@) % عاذت صدوع الفلا به ولقد % صح أديم الفضاء من جلبه % 10(@)(@@) % قد سلبته الجنوب والدين والدن % يا وصافي الحياة في سلبه % PageV01P154 11(@)(@@) % وحرشته الدبور واجتنبت % ريح القبول الهبوب من رهبه % 12(@)(@@) % وغادرت وجهه الشمال فقل % لا في نزور الندى ولا حقبه % 13(@)(@@) % دع عنك دع ذا إذا انتقلت إلى % % المدح وشب سهلة بمقتضبه % 14(@)(@@) % إني لذو ميسم يلوح على % % صعود هذا الكلام أو صببه % 15(@)(@@) % لست من العيس أو أكلفها % % وخدا يداوي المريض من وصبه % 16(@)(@@) % إلى المصفى مجدا أبي الحسن % انصعن انصياع الكدري في قربه % 17(@)(@@) % ترمي بأشباحنا إلى ملك % نأخذ من ماله ومن أدبه % 18(@)(@@) % نجم بني صالح وهم أنجم العلا % % لم من عجمه ومن عربه % 19(@)(@@) % رهط الرسول الذي تقطع أس % % باب البرايا غدا سوى سببه % 20(@)(@@) % مهذب قدت النبوة والإس % % لام قد الشراك من نسبه % PageV01P155 21(@)(@@) % له جلال إذا تسربله % أكسبه البأو غير مكتسبه % 22(@)(@@) % والحظ يعطاه غير طالبه % ويحرز الدر غير محتلبه % 23(@)(@@) % كم أعطبت راحتاه من نشب % سلامة المعتفين في عطبه % 24(@)(@@) % أي مداو للمحل نائله % وهانىء للزمان من جربه ! % 25(@)(@@) % مشمر ما يكل في طلب ال % % علياء والحاسدون في طلبه % 26(@)(@@) % أعلاهم دونه وأسبقهم % إلى العلى واطىء على عقبه % 27(@)(@@) % يريح قوم والجود والحق وال % % حاجات مشدودة إلى طنبه % 28(@)(@@) % وهل يبالي إقضاض مضجعه % % من راحة المكرمات في تعبه ؟ % 29(@)(@@) % تلك بنات المخاض راتعة % والعود في كوره وفي قتبه % 30(@)(@@) % منء ذا كعباسه إذا اصطكت ال % % أحساب أم من كعبد مطلبه ؟ % PageV01P156 31(@)(@@) % هيهات أبدى اليقين صفحته % وبان نبع الفخار من غربه % 32(@)(@@) % عبد المليك بن صالح بن علي % مبن قسيم النبي في نسبه % 33(@)(@@) % ألبسه المجد لا يريد به % بردا وصاغ السماح منه وبه % 34(@)(@@) % لقمان صمتا وحكمة فإذا % % قال لقطنا المرجان من خطبه % 35(@)(@@) % إن جد رد الخطوب تدمى وإن % يلعب فجد العطاء في لعبه % 36(@)(@@) % يتلو رضاه الغنى بأجمعه % وتحذر الحادثات في غضبه % 37(@)(@@) % تزل عن عرضه العيوب وقد % تنشب كف 
ms50	 الغني في نشبه % 38(@)(@@) % تأتيه فراطنا فتحكم في % % لجينه تارة وفي ذهبه % 39(@)(@@) % بأي سهم رميته في نصله ال % % ماضي وفي ريشه وفي عقبه ؟ ! % 40(@)(@@) % لا يكمن الغدر للصديق ولا % % يخطو اسم ذي وده إلى لقبه % PageV01P157 41(@)(@@) % يأبر غرس الكلام فيك فخذ % واجتن من زهوه ومن رطبه % 42(@)(@@) % أما ترى الشكر من ربائطه % جاء وسرح المديح من جلبه ؟ ! % PageV01P158 البحر : طويل 1(@)(@@) % جعلت فداك أنت من لا ندله % على الحزم في التدبير بل نستدله % 2(@)(@@) % وليس امرؤ بهديك غير مذكر % إلى كرم إلا امرؤ ضل ضله % 3(@)(@@) % ولكننا من يوسف بن محمد % على أمل كالفجر لاح مطله % 4(@)(@@) % هلال لنا قد كاد يخمد ضوؤه % وكنا نراه البدر إذ نستهله % 5(@)(@@) % هو السيف عضبا قد أرثت جفونه % وضيع حتى كل شيء يفله % 6(@)(@@) % فصنه ، فإنا نرتجي في غراره % % شفاء من الأعداء يوم تسله % 7(@)(@@) % له خلق رحب ونفس رأيتها % % إذا رزحت نفس اللئيم تقله % 8(@)(@@) % ففيم ولم صيرت سمعك ضيعة % ووقفا على الساعي به يستغله % 9(@)(@@) % قرارة عدل سيل كل ثنية % إليها وشعب كل زور يحله % 10(@)(@@) % لذلك ذا المولى المهان يهينه % % فيحظى وذا العبد الذليل يذله % PageV01P159 11(@)(@@) % أتغدو به في الحرب قبل اتغاره % وفي الخطب قعد أعيا الأولى مصمئله % 12(@)(@@) % وتعقده حتى إذا استحصدت له % مرائره أنشأت بعد تحله ! % 13(@)(@@) % هو النفل الحلو الذي إن شكرته % فقد ذاب في أقصى لهاتك حله % 14(@)(@@) % وفيء فوقره وإني لواثق % بأن لا يراك الله ممن يغله % 15(@)(@@) % فلو كان فرعا من فروعك لم يكن % لنا منهم إلا ذراه وظله % 16(@)(@@) % فكيف وإن لم يرزق الله إخوة % له ، فهو بعد اليوم فرعك كله ؟ % PageV01P160 البحر : وافر تام 1(@)(@@) % شهدت لقد لبست أبا سعيد % خلائق تبهر الشرف الطوالا % 2(@)(@@) % أتعتع في الحوائج إن خفافا % غدوت بها عليك وإن ثقالا % % 3(@)(@@) % أحين رفعت من شأوي وعادت % حويلي من ندى كفيك حالا ؟ ! % 4(@)(@@) % بفضلك صرت أكثرهم عطاء % وقبلك كنت أكثرهم سؤالا % % 5(@)(@@) % فلا يكدر قليبك لي ، فإني % % أمد إليك 
ms51	 أسبابا طوالا % % PageV01P161 البحر : طويل 1(@)(@@) % هل اجتمعت أحياء عدنان كلها % % بملتحم إلا وأنت أميرها ؟ % 2(@)(@@) % بك اليمن استعلت على كل موطن % و صار لطي تاجها وسريرها % % 3(@)(@@) % محرمة أكفال خيلك في الوغى % % ومكلومة لباتها ونحورها % % 4(@)(@@) % حرام على ارماحنا طعن مدبر % و تندق في أعلى الصدور صدورها % % PageV01P162 البحر : وافر تام 1(@)(@@) % سلام الله عدة رمل خبت % على ابن الهيثم الملك اللباب % 2(@)(@@) % ذكرتك ذكرة جذبت ضلوعي % % إليك كأنها ذكرى تصابي % % 3(@)(@@) % فلا يغبب محلك كل يوم % من الأنواء ألطاف السحاب % 4(@)(@@) % سقت جودا نوالا منك جودا % وربعا غير مجتنب الجناب % 5(@)(@@) % فثم الجود مشدود الأواخي % % وثم المجد مضروب القباب % 6(@)(@@) % وأخلاق كأن المسك فيها % % بصفو الراح والنطف العذاب % 7(@)(@@) % وكم أحييت من ظن رفات % بها وعمرت من أمل خراب % 8(@)(@@) % يمين محمد بحر خضم % طموح الموج ، مجنون العباب % 9(@)(@@) % تفيض سماحة والمزن مكد % وتقطع والحسام العضب ناب % 10(@)(@@) % فداك أبا الحسين من الرزايا % % ومن داجي حوادثها الغضاب % PageV01P163 11(@)(@@) % حسود قصرت كفاه عنه % وكفك للنوال وللضراب % 12(@)(@@) % ويحسب ما يفيد بلا نوال % % وتعطي ماتفيد بلا حساب % 13(@)(@@) % ويغدو يستثيب بلا نوال % % ونيلك كله لا للثواب % 14(@)(@@) % ذكرت صنيعة لك ألبستني % % أثيث المال والنعم الرغاب % 15(@)(@@) % تجدد كلما لبست وتبقى % % إذا ابتذلت وتخلق في الحجاب % 16(@)(@@) % إذا ما أبرزت زادت ضياء % وتشحب وجنتاها في النقاب % 17(@)(@@) % وليست بالعوان العنس عندي % % ولا هي منك بالبكر الكعاب % 18(@)(@@) % فلا يبعد زمان منك عشنا % % بنضرته ورونقه العجاب % 19(@)(@@) % كأن العنبر الهندي فيه % وفأر المسك مفضوض الرضاب % 20(@)(@@) % لياليه ليالي الوصل تمت % بأيام كأيام الشباب % PageV01P164 21(@)(@@) % أقول ببعض ما أسديت عندي % % وما أطلبتني قبل الطلاب % 22(@)(@@) % ولو أني استطعت لقام عني % % بشكرك من مشى فوق التراب % 23(@)(@@) % إذا شكرتك مذحج حيث كانت % بنو ديانها وبنو الضباب % 24(@)(@@) % وجئتك في قضاعة قد أطافت % بركني عامر وبني جناب % 25(@)(@@) % ولاستنجدت حنظل وعمرا % ولم أعدل بسعد والرباب % 26(@)(@@) % ولاسترفدت من قيس ذراها % % بني بدر وصيد بني كلاب % 27(@)(@@) % ولاحتفلت 
ms52	 ربيعة لي جميعا % بأيام كأيام الكلاب % 28(@)(@@) % فأشفي من صميم الشكر نفسي % % وترك الشكر أثقل للرقاب % 29(@)(@@) % إليك أثرت من تحت التراقي % % قوافي تستدر بلا عصاب % 30(@)(@@) % من القرطات في الآذان تبقى % % بقاء الوحي في الصم الصلاب % PageV01P165 31(@)(@@) % عراض الجاه تجزع كل واد % مكرمة وتفتح كل باب % 32(@)(@@) % مضمن كلال الركب تغني % % غناء الزاد عنهم والركاب % 33(@)(@@) % إذا عارضتها في يوم فخر % مسحت خدود سابقة عراب % 34(@)(@@) % تصير بها وهاد الأرض هضبا % وأعلاما وتثلم في الروابي % % 35(@)(@@) % كتبت ولو قدرت جوى وشوقا % إليك لكنت سطرا في كتابي % % PageV01P166 البحر : كامل تام 1(@)(@@) % دمن ألم بها فقال سلام % كم حل عقدة صبره الإلمام % 2(@)(@@) % نحرت ركاب القوم حتى يغبروا % % رجلى ، لقد عنقوا علي ولامور % % 3(@)(@@) % عشقوا ، ولارزقوا ، أيعذل عاشق % رزقت هواه معالم وخيام ؟ ! % 4(@)(@@) % وقفوا علي اللوم حتى خيلوا % % أن الوقوف على الديار حرام ! % 5(@)(@@) % ما مر يوم واحد إلا وفي % % أحشائه لمحلتيك غمام % 6(@)(@@) % حتى تعمم صلع هامات الربا % % من نوره وتأزر الأهضام % 7(@)(@@) % ولقد أراك ، فهل أراك بغبطة % والعيش غض والزمان غلام ؟ ! % 8(@)(@@) % أعوام وصل كان ينسي طولها % % ذكر النوى ، فكأنها أيام % 9(@)(@@) % ثم انبرت أيام هجر أردفت % بجوى أسى ، فكأنها أعوام % 10(@)(@@) % ثم انقضت تلك السنون وأهلها % % فكأنها وكأنهم أحلام % PageV01P167 11(@)(@@) % أتصعصعت عبرات عينك أن دعت % ورقاء حين تصعصع الإظلام . ؟ ! % 12(@)(@@) % لاتنشجن لها فإن بكاءها % % ضحك ، وإن بكاءك استغرام % 13(@)(@@) % هن الحمام فإن كسرت عيافة % من حائهن فإنهن حمام % 14(@)(@@) % الله أكبر جاء أكبر من جرت % فتحيرت في كنهه الأوهام % 15(@)(@@) % من لا يحيط الواصفون بقدره % حتى يقولوا قدره إلهام % 16(@)(@@) % من شرد الإعدام عن أوطانه % % بالبذل حتى استطرف الإعدام % 17(@)(@@) % وتكفل الأيتام عن آبائهم % حتى وددنا أننا أيتام % 18(@)(@@) % مستسلم لله ، سائس أمة % لذوي تجهضمها له استسلام % 19(@)(@@) % يتجنب الآثام ثم يخافها % % فكأنما حسناته آثام % 20(@)(@@) % يأيها الملك الهمام وعدله % % ملك عليه في القضاء همام % PageV01P168 21(@)(@@) % ما زال حكم الله يشرق وجهه % % في الأرض مذ نيطت بك الأحكام 
ms53	 % 22(@)(@@) % أسرت لك الآفاق عزمه همة % جبلت على أن المسير مقام % 23(@)(@@) % إلا تكن أرواحها لك سخرت % فالعزم طوع يديك والإجذام % 24(@)(@@) % الشرق غرب حين تلحظ قصده % % ومخالف اليمن القصي شآم % 25(@)(@@) % بالشدقميات العتاق كأنما % % أشباحها بين الإكام إكام % 26(@)(@@) % والأعوجيات الجياد كأنها % % تهوي وقد ونت الرياح سمام % 27(@)(@@) % لما رأيت الدين يخفق قلبه % % والكفر فيه تغطرس وعرام % 28(@)(@@) % أوريت زند عزائم تحت الدجى % % أسرجن فكرك والبلاد ظلام % 29(@)(@@) % فنهضت تسحب ذيل جيش ساقه % حسن اليقين وقاده الإقدام % 30(@)(@@) % مثعنجر لجب ترى سلافه % ولهم بمنخرق الفضاء زحام % PageV01P169 31(@)(@@) % ملأ الملا عصبا فكاد بأن يرى % % لاخلف فيه ولا له قدام % 32(@)(@@) % بسواهم لحق الأياطل شزب % تعليقها الإسراج والإلجام % 33(@)(@@) % ومقاتلين إذا انتموا لم يخزهم % في نصرك الأخوال والأعمام % 34(@)(@@) % سفع الدؤوب وجوههم فكأنهم % وأبوهم سام أبوهم حام % 35(@)(@@) % تخذوا الحديد من الحديد معاقلا % سكأنها الأرواح والأجسام % 36(@)(@@) % مسترسلين إلى الحتوف ، كأنما % % بين الحتوف وبينهم أرحام % 37(@)(@@) % آساد موت مخدرات مالها % % إلا الصوارم والقنا آجام % 38(@)(@@) % حتى نقضت الروم منك بوقعة % % شنعاء ليس لنقضها إبرام % 39(@)(@@) % في معرك أما الحمام فمفطر % في هبوتيه والكماة صيام % 40(@)(@@) % والضرب يقعد قرم كل كتيبة % شرس الضريبة والحتوف قيام % PageV01P170 41(@)(@@) % ففصمت عروة جمعهم فيه وقد % جعلت تفصم عن عراها الهام % 42(@)(@@) % ألقوا دلاء في بحورك أسلمت % ترعاتها الأكرا والأوذام % 43(@)(@@) % ما كان للإشراك فوزة مشهد % والله فيه وأنت والإسلام % 44(@)(@@) % لما رأيتهم تساق ملوكهم % حزقا إليك كأنهم أنعام % 45(@)(@@) % جرحى إلى جرحى كأن جلودهم % يطلى بها الشيان والعلام % 46(@)(@@) % متساقطي ورق الثياب كأنهم % دانوا فأحدث فيهم الإحرام % 47(@)(@@) % أكرمت سيفك غربه وذبابه % عنهم وحق لسيفك الإكرام % 48(@)(@@) % فرددت حد الموت وهو مركب % في حده فارتد وهو زؤام % 49(@)(@@) % أيقظت هاجعهم وهل يغنيهم % سهر النواظر والعقول نيام % 50(@)(@@) % جحدتك منهم ألسن لجلاجة % أقررن أنك في القلوب إمام % PageV01P171 51(@)(@@) % إسلم أمير المؤمنين لأمة % نتجت رجاءك والرجاء عقام % 52(@)(@@) % إن المكارم للخليفة لم تزل % والله يعلم ذاك والأقوام % 53 
ms54	(@)(@@) % كتبت له ولأوليه وراثة % في اللوح حتى جفت الأقلام % 54(@)(@@) % متوطئو عقبيك في طلب العلا % والمجد ثمت تستوي الأقدام % PageV01P172 البحر : خفيف تام 1(@)(@@) % ديمة سمحة القياد سكوب % مستغيث بها الثرى المكروب % 2(@)(@@) % لو سعت بقعة لإعظام نعمى % % لسعى نحوها المكان الجديب % 3(@)(@@) % لذ شؤبوبها وطاب فلو تس % % طيع قامت فعانقتها القلوب % 4(@)(@@) % فهي ماء يجري وماء يليه % وعزال تهمي وأخرى تذوب % 5(@)(@@) % كشف الروض رأسه واستسر % المحل منها كما استسر المريب % 6(@)(@@) % فإذا الرى ، بعد محل وجرجا % % ن لديها يبرين أو ملحوب % 7(@)(@@) % أيها الغيث حي أهلا بمغدا % % ك وعند السرى وحين تؤوب % 8(@)(@@) % لأبي جعفر خلائق تحكي % % هن قد يشبه النجيب النجيب % 9(@)(@@) % أنت فينا في ذا الأوان غريب % وهو فينا في كل وقت غريب % 10(@)(@@) % ضاحك في وائب الدهر طلق % وملوك يبكين حين تنوب % PageV01P173 11(@)(@@) % فإذا الخطب راث نال الندى وال % % بذل منه ما لا تنال الخطوب % 12(@)(@@) % خلق مشرق ورأي حسام % ووداد عذب وريح جنوب % 13(@)(@@) % كل يوم له وكل أوان % خلق ضاحك ومال كئيب % 14(@)(@@) % إن تقاربه أو تباعده ما لم % تأت فحشاء فهو منك قريب % 15(@)(@@) % ما التقى وفره ونائله مذ % % كان إلا ووفره المغلوب % 16(@)(@@) % فهو مدن للجود وهو بغيض % وهو مقص للمال وهو حبيب % 17(@)(@@) % يأخذ الزائرين قسرا ولو كف % م دعاهم إليه واد خصيب % 18(@)(@@) % غير أن الرامي المسدد يحتا % % ط مع العلم أنه سيصيب % PageV01P174 البحر : وافر تام 1(@)(@@) % أرامة كنت مألف كل ريم % لو استمتعت بالأنس القديم % 2(@)(@@) % أدار البؤس حسنك التصابي % % إلي فصرت جنات النعيم % 3(@)(@@) % لئن أصبحت ميدان السوافي % % لقد أصبحت ميدان الهموم % 4(@)(@@) % ومما ضرم البرحاء أني % % شكوت فما شكوت إلى رحيم % 5(@)(@@) % أظن الدمع في خدي سيبقى % % رسوما من بكائي في الرسوم % 6(@)(@@) % وليل بت أكلؤه كأني % % سليم أو سهرت على سليم % 7(@)(@@) % أراعي من كواكبه هجانا % سواما ما تريع إلى المسيم % 8(@)(@@) % فأقسم لو سألت دجاه عني % % لقد أنباك عن وجد عظيم % 9(@)(@@) % أنخنا في ديار 
ms55	 بني حبيب % بنات السير تحت بني العزيم % 10(@)(@@) % وما إن زال في جرم ابن عمرو % كريم من بني عبد الكريم % PageV01P175 11(@)(@@) % يكاد نداه يتركه عديما % إذا هطلت يداه على عديم % 12(@)(@@) % تراه يذب عن حرم المعالي % % فتحسبه يدافع عن حريم % 13(@)(@@) % غريم للملم به وحاشى % % نداه من مماطلة الغريم % 14(@)(@@) % سفيه الرمح جاهله إذا ما % % بدا فضل السفيه على الحليم % 15(@)(@@) % إذا ما قيل أرعفت العوالي % % فليس المرعفات سوى الكلوم % 16(@)(@@) % إذا ما الضرب حش الحرب أبدى % % أغر الرأي في الخطب البهيم % 17(@)(@@) % تقفى الحرب منه حين تغلي % % مراجلها بشيطان رجيم % 18(@)(@@) % فإن شهد المقامة يوم فصل % رأيت نظير لقمان الحكيم % 19(@)(@@) % إذا نزل النزيع بهم قروه % رياض الريف من أنف جميم % 20(@)(@@) % فلو شاهدتهم والزائريهم % لما مزت البعيد من الحميم % PageV01P176 21(@)(@@) % أولئك قد هدوا في كل مجد % إلى نهج الصراط المستقيم % 22(@)(@@) % أحلهم الندى سطة المعالي % % إذا نزل البخيل على التخوم % 23(@)(@@) % فروع لا ترف عليك إلا % % شهدت لها على طيب الأروم % 24(@)(@@) % وفي شرف الحديث دليل صدق % لمختبر على الشرف القديم % % 25(@)(@@) % لهم غرر تخال إذا استنارت % بواهرها ضرائر للنجوم % 26(@)(@@) % قروم للمجير بهم أسود % نكال للأسود وللقروم % 27(@)(@@) % إذا نزلوا بمحل روضوه % بآثار كآثار الغيوم % 28(@)(@@) % لكل من بني حواء عذر % ولاعذر لطائي لئيم % 29(@)(@@) % أحق الناس بالكرم امرؤ لم % % يزل يأوي إلى أصل كريم % PageV01P177 البحر : بسيط تام 1(@)(@@) % لا عيش أو يتحامى جسمك الصب % فتنجلي بك عن خلصانك الكرب % 2(@)(@@) % لعا أبا جعفر واسلم فقد سلمت % بك المروءة وستعلى بك الحسب % 3(@)(@@) % إنا جهلنا فخلناك اعتللت ولا % % والله ما اعتل إلا الملك والأدب % PageV01P178 البحر : بسيط تام 1(@)(@@) % أصغى إلى البين مغترا فلا جرما % % أن النوى أسأرت في قلبه لمما % % 2(@)(@@) % أصمني سرهم أيام فرقتهم % هل كنت تعرف سرا يورث الصمما % % PageV01P179 البحر : رجز تام 1(@)(@@) % كان لنفسي أمل فانقضى % % فأصبح اليأس لها معرضا % % 2(@)(@@) % اسخطني دهري بعد الرضا % % وارتجع العرف الذي قد مضى % % 3(@)(@@) % لم يظلم الدهر 
ms56	 ولكنه % أقرضني الإحسان ثم اقتضى ! % PageV01P180 البحر : سريع 1(@)(@@) % يا مغرس الظرف وفرع الحسب % ومن به طال لسان الأدب % 2(@)(@@) % إنا عهدناك أخا علة % بالإمس نالتك ببعض الوصب % 3(@)(@@) % فكيف أصبحت ولا زلت في % % عافي أذيالها تنسحب % PageV01P181 البحر : طويل 1(@)(@@) % ألم يأن أن تروى الظماء الحوائم % وأن ينظم الشمل المشتت ناظم ؟ ! % 2(@)(@@) % لئن أرقأ الدمع الغيور وقد جرى % % لقد رويت منه خدود نواعم % 3(@)(@@) % لقد كان ينسى عهد ظمياء باللوى % % ولكن أملته عليه الحمائم % 4(@)(@@) % بعثن الهوى في قلب من ليس هائما % فقل في فؤاد رعنه وهو هائم % 5(@)(@@) % لها نغم ليست دموعا فإن علت % مضت حيث لاتمضي الدموع السواجم % 6(@)(@@) % أما وأبيها لو رأتني لأيقنت % بطول جوى ينفض منه الحيازم % 7(@)(@@) % رأت قسمات قد تقسم نضرها % % سرى الليل والإسآد فهي سواهم % 8(@)(@@) % وتلويح أجسام تصدع تحتها % % قلوب رياح الشوق فيها سمائم % 9(@)(@@) % ينال الفتى من عيشه وهو جاهل % ويكدي الفتى في دهره وهو عالم % 10(@)(@@) % ولو كانت الأرزاق تجري على الحجا % % هلكن إذن من جهلهن البهائم % PageV01P182 11(@)(@@) % جزى الله كفا ملؤها من سعادة % سعت في هلاك المال والمال نائم % 12(@)(@@) % فلم يجتمع شرق وغرب لقاصد % ولا المجد في كف امرئ والدراهم % 13(@)(@@) % ولم أر كالمعروف تدعى حقوقه % % مغارم في الأقوام وهي مغانم % 14(@)(@@) % ولا كالعلى مالم ير الشعر بينها % % فكالأرض غفلا ليس فيها معالم % 15(@)(@@) % وما هو إلا القول يسري فتغتدي % % له غرر في أوجه ومواسم % 16(@)(@@) % يرى حكمة مافيه وهو فكاهة % ويقضي بما يقضي به ، وهو ظالم % 17(@)(@@) % إلى أحمد المحمود رامت بنا السرى % % نواعب في عرض الفلا ورواسم % 18(@)(@@) % خوانف يظلمن الظليم إذا عدا % % وسيج أبيه وهو للبرق شائم % 19(@)(@@) % نجائب قد كانت نعائم مرة % من المر أو أماتهن نعائم % 20(@)(@@) % إلى سالم الأخلاق من كل عائب % وليس له مال على الجود سالم % PageV01P183 21(@)(@@) % جدير بأن لا يصبح المال عنده % جديرا بأن يبقى وفي الأرض غارم % 22(@)(@@) % وليس ببان للعلى خلق امرئ % % وإن جل إلا وهو للمال هادم 
ms57	 % 23(@)(@@) % له من إياد قمة المجد حيثما % % سمت ولها منه البنا والدعائم % 24(@)(@@) % أناس إذا راحوا إلى الروع لم ترح % % مسالمة أسيافهم والجماجم % 25(@)(@@) % بنو كل مشبوح الذراع إذ القنا % % ثنت أذرع الأبطال ، وهي معاصم % 26(@)(@@) % إذا سيفه أضحى على الهام حاكما % غدا العفو منه وهو في السيف حاكم % 27(@)(@@) % أخذت بأعضاد العريب وقد خوت % عيون كليلات وذلت جماجم % 28(@)(@@) % فأضحوا لو استطاعوا لفرط محبة % لقد علقت خوفا عليك التمائم % 29(@)(@@) % ولو علم الشيخان أد ويعرب % لسرت إذن تلك العظام الرمائم % 30(@)(@@) % تلاقى بك الحيان في كل محفل % جليل وعاشت في ذراك العماعم % PageV01P184 31(@)(@@) % فما بال وجه الشعر أغبر قاتما % وأنف العلى من عطلة الشعر راغم % 32(@)(@@) % تداركه إن المكرمات أصابع % وإن حلى الأشعار فيها خواتم % 33(@)(@@) % إذا أنت لم تحفظه لم يك بدعة % ولا عجبا أن ضيعته الأعاجم % 34(@)(@@) % فقد هز عطفيه القريض توقعا % لعدلك مذ صارت إليك المظالم % 35(@)(@@) % ولولا خلال سنها الشعر ما درى % % بغاة الندى من أين تؤتى المكارم % PageV01P185 البحر : طويل 1(@)(@@) % أصب بحميا كأسها مقتل العذل % تكن عوضا إن عنفوك من النبل % 2(@)(@@) % وكأس كمعسول الأماني شربتها % % و لكنها اجلت وقد شربت عقلي % % 3(@)(@@) % إذا عوتبت بالماء كان اعتذارها % % لهيبا كوقع النار في الحطب الجزل % 4(@)(@@) % اذا هيت دبت في القتى خال جسمه % لما دب فيه قرية من قرى النمل % 5(@)(@@) % اذا ذاقها وهي الحياة رأيته % يعبس تعبيس المقدم للقتل % 6(@)(@@) % إذا اليد نالتها بوتر توقرت % على ضعفها ثم استقادت من الرجل % 7(@)(@@) % و تصرع ساقيها بانصاف شربها % % وصرعهم بالجور في صورة العدل % 8(@)(@@) % سقى الرائح الغدي المهجر بلدة % سقتني أنفاس الصبابة والخيل % 9(@)(@@) % سحاب اذا ألقت عل خلفه الصبا % % يدا قالت الدنيا أتى قاتل المحل % 10(@)(@@) % اذا ما ارتدى بالبرق لم يزل الندى % % له تبعا أو يرتدي الروض بالبقل % PageV01P186 11(@)(@@) % إذا انتشرت أعلامه حوله انطوت % بطون الثرى منه وشيكا على حمل % 12(@)(@@) % ترى الأرض تهتز ارتياحا لوقعه % كما ارتاحت البكر الهدي إلى البعل % 13 
ms58	(@)(@@) % فجاد دمشقا كلها جود أهلها % % بأنفسهم عند الكريهة والبذل % 14(@)(@@) % سقاهم كما أسقاهم في لظى الوغى % % ببيض صفيح الهند والسمر الذبل % 15(@)(@@) % فلم يبق في أرض البقاعين بقعة % % وجاد قرى الجولان بالمسبل الوبل % 16(@)(@@) % بنفسي أرض الشام لا أيمن الحمى % % و لا أيسرث الدهنا ولا أوسط الرمل % 17(@)(@@) % و لم أر مثلي مستهاما بمثلكم % % و لا مثل قلبي فيه لا يغلي % % 18(@)(@@) % عدتني عنكم مكرها غربة النوى % % لها طربة في أن تمر ولا تحلي % % 19(@)(@@) % اذا لحظت حبلا من الحي محصدا % رمته فلم تسلم بناقضة الفتل % 20(@)(@@) % أتت بعد هجر من حبيب فحركت % % صبابة ما أبقى الصدود من الوصل % PageV01P187 21(@)(@@) % أخمسة أحوال مضت لمغيبه % وشهران بل يومان نكل من النكل ! % 22(@)(@@) % توانى وشيك النجع عنه ووكلت % به عزمات أوقفته على رجل % 23(@)(@@) % ويمنعه من أن يبيت زماعه % % على عجل ان القضاء على رسل % 24(@)(@@) % قضى الدهر مني نحبه يوم فتله % هواي بارقال الغريرية الفتل % 25(@)(@@) % لقد طلعت في وجه مصر بوجهه % بلا طالع سعد ولا طائر سهل % 26(@)(@@) % وساوس آمال ومذهب همة % تخيل لي بين المطية والرحل % 27(@)(@@) % وسورة علم لم تسدد فأصبحت % وما يتمارى أنها سورة الجهل % 28(@)(@@) % نأيت فلا مالا حويت ولم أقم % % فأمتع إذ فجعت بالمال والأهل % 29(@)(@@) % بخلت على عرضي بما فيه صونه % % رجاء اجتناء الجود من شجر البخل % 30(@)(@@) % عصيت شبا عزمي لطاعة حيرة % % دعتني إلى أن افتح القفل بالقفل % PageV01P188 31(@)(@@) % و أبسط من وجهي الذي لو بذلته % إلى الأرض من نعلي لما نقبت نعلي % % 32(@)(@@) % عدات كريعان السراب إذا جرى % % تنشر عن منع وتطوى على مطل % 33(@)(@@) % لئام طغام أو كرام بزعمهم % % سواسية ما أشبه الحول بالقبل ! % 34(@)(@@) % فلو شاء من لو شاء لم يثن أمره % % لصيرت فضل المال عند ذوي الفضل % 35(@)(@@) % و لو أنني اعطيت بأسي نصيبه % إذن لأخذت الحزم من مأخذ سهل % 36(@)(@@) % وكان ورائي من صريمة طييء % ومعن ووهب عن أمامي ما يسلي % % 37(@)(@@) % فلم يك ما جزعت نفسي من 
ms59	 الأسى % % ولم يك ما جرعت قومي من الثكل ! % PageV01P189 البحر : طويل 1(@)(@@) % أبا جعفر أضحى بك الظن ممرعا % فمل برواعيه عن الأمل الجذب % 2(@)(@@) % فو الله ما شيء سوى الحب وحده % بأعلى محلا من رجائك في قلبي % % PageV01P190 البحر : بسيط تام 1(@)(@@) % سلم على الربع من سلمى بذي سلم % عليه وسم من الأيام والقدم % 2(@)(@@) % ما دام عيش لبسناه بساكنه % لدنا ولو أن عيشا دام لم يدم % 3(@)(@@) % يامنزلا أعنقت فيه الجنوب على % % رسم محيل وشعب غير ملتئم % 4(@)(@@) % هرمت بعدي والربع الذي أفلت % منه بدورك معذور على الهرم % 5(@)(@@) % عهدي بمغناك حسان المعالم من % حسانة الورد والبردي والعنم % 6(@)(@@) % بيضاء كان لها من غيرنا حرم % فلم تكن نستحل الصيد في الحرم % 7(@)(@@) % كانت لنا صنما نحتو عليه ، ولم % نسجد كما سجد إلافشين للصنم % 8(@)(@@) % زار الخيال لها لابل أزاركه % % فكر إذا نام فكر الخلق لم ينم % % 9(@)(@@) % ظبي تقنصته لما نصبت له % في آخر الليل أشراكا من الحلم % 10(@)(@@) % ثم اغتدى وبنا من ذكر سقم % باق ، وإن كان مشغولا عن السقم % PageV01P191 11(@)(@@) % اليوم يسليك عن طيف ألم وعن % بلى الرسوم بلاء الأينق الرسم % 12(@)(@@) % من القلاص اللواتي في حقائبها % % بضاعة غير مزجاة من الكلم % 13(@)(@@) % إذا بلغن أبا كلثوم اتصلت % تلك المنى وأخذنا لحاج من أمم % 14(@)(@@) % بنى به الله في بدو وفي حضر % لوائل سور عز غير منهدم % % 15(@)(@@) % رأته في المهد عتاب ، فقال لها % % ذوو الفراسة : هذا صفوة الكرم % 16(@)(@@) % خذوا هنيئا مرئيا يا بني جشم % منه أمانين من خوف ومن عدم % 17(@)(@@) % فجاء والنسب الوضاح جاء به % كأنه بهمة فيهم من البهم % 18(@)(@@) % طعان عمرو بن كلثوم ونائله % حذو السيور التي قدت من الأدم % 19(@)(@@) % لو كان يملك عمرو مثله شبها % من صلبه لم يجد للموت من ألم % 20(@)(@@) % بنانه خلج تجري وغيرته % % ستر من الله ممدود على الحرم % PageV01P192 21(@)(@@) % نال الجزيرة إمحال فقلت لهم % شيموا نداه إذا ما البرق لم يشم % 22(@)(@@) % فما الربيع على أنس البلاد 
ms60	 به % أشد خضرة عود منه في القحم % % 23(@)(@@) % ولا أرى ديمة أمحى لمسغبة % منه على أن ذكرا طار للديم % 24(@)(@@) % لغلب سؤدد طابت منابته % % في منتهى قلل منها وفي قمم % 25(@)(@@) % مجد رعى تلعات الدهر وهو فتى % % حتى غدا الدهر يمشي مشية الهرم % 26(@)(@@) % بناه جود وبأس صادق ومتى % % تبن العلى بسوى هذين تنهدم % 27(@)(@@) % وقف على آل سعد إن أيديهم % سم لمستكبر شهد لمؤتدم % 28(@)(@@) % لاجارهم للرزايا في جوارهم % ولاعهودهم مذمومة الذمم % 29(@)(@@) % أصفوا ملوك بني العباس كلهم % ذخيرة ذخروها عن بني الحكم % 30(@)(@@) % مهلا بني مالك لاتجلبن إلى % % حي الأراقم دؤلول ابنة الرقم % PageV01P193 31(@)(@@) % فأي حقد أثرتم من مكامنه % % وأي عوصاء جشمتم بني جشم % 32(@)(@@) % لم يألكم مالك صفحا ومغفرة % لو كان ينفخ قين الحي في فحم % % 33(@)(@@) % لا بالمعاود ولغا في دمائكم % ولا إلى لحم خلق منكم قرم % 34(@)(@@) % أخرجتموه بكره من شجيته % % والنار قد تنتضى من ناضر السلم % 35(@)(@@) % أوطأتموه على جمر العقوق ولو % لم يحرج الليث لم يبرح من الأجم % 36(@)(@@) % قذعتم فمشيتم مشية أمما % كذاك يحسن مشي الخيل في اللجم % 37(@)(@@) % إذ لا معول إلا كل معتدل % أصم يبرئ أقواما من الصمم % 38(@)(@@) % من الردينية اللاتي إذا عسلت % تشم بو صغار الأنف ذا الشمم % % 39(@)(@@) % إن أجرمت لم تنصل من جرائمها % % وإن أساءت إلى الأقوام لم تلم % 40(@)(@@) % كان الزمان بكم كلبا فادركم % بالسيف والدهر فيكم أشهر الحرم % PageV01P194 41(@)(@@) % أمن عمى نزل الناس الربا فنجوا % % وأنتم نصب سيل الفتنة العرم ؟ ! % 42(@)(@@) % أم ذاك من همم جاشت ، فكم ضعة % أدى إليها علو القوم في الهمم ! % 43(@)(@@) % تنبون عنه وتعطون القياد إذا % % كلب عوى وسطكم من أكلب العجم ! ! % 44(@)(@@) % قد انثنى بالمنايا في أسنته % وقد أقام حياراكم على اللقم ! % 45(@)(@@) % جذلان من ظفر حران إن رجعت % مخضوبة منكم أظفاره بدم % 46(@)(@@) % دين يكفكف منه كل بائقة % ورحمة رفرفت منه على الرحم ! % 47(@)(@@) % لولا مناشدة القربى لغادركم % % حصائد المرهفين : السيف والقلم % 48(@)(@@) % لأصبحت كالأثافي السفع أو جهكم 