ms201	 در دو عالم زان که تو %~% با قناعت همنشینی با فراغت آشنا(@)(@@) 8 سیم نااهلان نجویی زان که نپسندد خرد %~% خاکروبی کردن آن کس را که داند کیمیا(@)(@@) 9 شعر تو روحانیان گر بشنوند از روی صدق %~% بانگ برخیزد ازیشان کای سنایی مرحبا(@)(@@) 10 حجتی بر خلق عالم زان دو فعل خوب خویش %~% شاعری بی‌ذل طمع و پارسایی بی‌ریا(@)(@@) 11 عیسی عصری که از انفاس روحانیت هست %~% مردگان آز و معلولان غفلت را شفا(@)(@@) 12 بس طبیب زیرکی زیرا که بی‌نبض و علیل %~% درد هر کس را ز راه نطق می‌سازی دوا(@)(@@) 13 نظم گوهربار عقل افزای جان افروز تو %~% کرد شعر شاعران بوده را یکسر هبا(@)(@@) 14 معجز موسی نمایست این و آنها سحر و کی %~% ساحری زیبا نماید پیش موسی و عصا(@)(@@) 15 هر که او شعر ترا گوید جواب از اهل عصر %~% نزد عقل آنکس نماید یافه گوی و هرزه لا(@)(@@) 16 زان که بشناسند بزازان زیرک روز عرض %~% اطلس رومی و شال ششتری از بوریا(@)(@@) 17 شاعران را پایه بی‌شرمی بود تا زان قبل %~% حاصل و رایج کنند از مدح ممدوحان عطا(@)(@@) 18 صورت شرمی تو اندر سیرت پاکی بلی %~% با چنان ایمان کامل این چنین باید حیا(@)(@@) 19 شعر و سحر و شرع و حکمت آمدت اندر خبر %~% ره برد اسرار او چون بنگرد عین‌الرضا(@)(@@) 20 کاین چهارست ای سنایی چار حرف و یافتند %~% زین چهار آن هر چهار از نظم و نثر اوستا(@)(@@) 21 تا حریم کعبه باشد قبله اهل سنن %~% تا نعیم سدره باشد طعمه اهل بقا(@)(@@) 22 سدره بادت دستگاه بخشش دارالبقا %~% کعبه بادت پایگاه کوشش دارالفنا(@)(@@) 23 کعبه و سدره مبادت مقصد همت که نیست %~% جز «و یبقی وجه ربک» مر ترا کام و هوا(@)(@@) 24 نظم عشق‌آمیز عارف را ز راه لطف و بر %~% برگذر از عیبهاش و در گذر از وی خطا(@)(@@) 25 تا که باشد عارف اندر سال 
ms202	 و ماه و روز و شب %~% شاکر افضال تو اندر خلا و اندر ملا PageV1P0441(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 تا ز سر شادی برون ننهند مردان صفا %~% دست نتوانند زد در بارگاه مصطفا(@)(@@) 2 خرمی چون باشد اندر کوی دین کز بهر حق %~% خون روان گشتست از حلق حسین در کربلا(@)(@@) 3 از برای یک بلی کاندر ازل گفتست جان %~% تا ابد اندر دهد مرد بلی تن در بلا(@)(@@) 4 خاک را با غم سرشت اول قضا اندر قدر %~% غم کند ناچار خاکی را بنسبت اقتضا(@)(@@) 5 اهل معنی می‌گدازند از پی اعلام را %~% زهره نی کس را که گوید از ازل یک ماجرا(@)(@@) 6 نیم روز اندر بهشت آدم عدیل ملک بود %~% هفتصد سال از جگر خون راند بر سنگ و گیا(@)(@@) 7 لحظه‌ای گمشد ز خدمت هدهد اندر مملکت %~% در کفارت ملکتی بایست چون ملک سبا(@)(@@) 8 بیست سال اندر جهان بی‌کفش باید گشت از آنک %~% پای روح‌الله ازین بر دوخت نعلین هوا(@)(@@) 9 دانه در در بن دریای الا الله درست %~% لاالهی غور باید تا برآرد بی‌ریا(@)(@@) 10 از کن اول برآرد شعبده استاد فکر %~% وز پی آخر درآرد تیر مه باد صبا(@)(@@) 11 دیده گوید تا چه می‌جوید برون از لوح روح %~% نفس گوید تا چه می‌خواند برون دل ذکا(@)(@@) 12 آنچه بیرونست از هندوستان هم کرگدن %~% و آنچه افزونست از ده هفتخوان هم اژدها(@)(@@) 13 روح داند گشت گرد حلقه هفت آسمان %~% ذهن داند خواند نقش نفخ جان چون انبیا(@)(@@) 14 گر کوه دجله آن گردد که دارد مردوار %~% در درون مجنون محرم وز برون فرهاد را(@)(@@) 15 کار هر موری نباشد با سلیمان گفتگو %~% یار هر سگ‌بان نباشد رازدار پادشا(@)(@@) 16 بابل نفس‌ست بازار نکورویان چین %~% حاصل روحست گفتار عزیزان ختا(@)(@@) 17 تا ز اول برنخیزد از ره ابجد مسیح %~% شرح مسح سر نداند خواند بر لوح صبا(@)(@@) 18 دور باید بود از انکار بر درگاه 
ms203	 عشق %~% کانچه اینجا درد باشد هست دیگر جا دوا(@)(@@) 19 آن نمی‌بینند کز انکارشان پوشیده ماند %~% با جمال یوسف چاهی ترنج از دست و پا(@)(@@) 20 نقل موجودات در یک حرف نتوان برد سهل %~% گر بود در نیم خرما چشم باز و دل گوا(@)(@@) 21 برخلاف امر یزدان در دل خود ره نداد %~% چشم زخمی در حیات خویش یحیا از حیا(@)(@@) 22 باز این خودکامگی بین کز برای اعتبار %~% با چنین پیغمبری چون گفته باشد برملا(@)(@@) 23 ظاهر ابر جسم آدم خواند کز گندم مخور %~% نعرها از حکم سابق کالصلا اصحابنا(@)(@@) 24 آن سیه کاری که رستم کرد با دیو سپید %~% خطبه دیوان دیگر بود و نقش کیمیا(@)(@@) 25 تا برون ناری جگر از سینه دیو سپید %~% چشم کورانه نبینی روشنی زان توتیا(@)(@@) 26 مهره اندر حقه استاد آن بیند بعدل %~% کز کمند حلقه نظارگان گردد رها(@)(@@) 27 یا تمنای سبک دستی توان کردن به عقل %~% یا برون از حلقه نظاره چون طفلان دوتا(@)(@@) 28 غوطه خورده در بن دریا دو تن در یک زمان %~% این در اشکار نهنگ افتاده و آن اندر ضیا(@)(@@) 29 خیرگی بار آرد آن را کز برای علم خویش %~% دیده بر خورشید تابان افگند بی‌مقتدا(@)(@@) 30 آب چاهی باید اندر پیش کز یک قطره‌اش %~% جان چندین جانور حاصل شود در یک ندا(@)(@@) 31 وانگهی چون بیند اندر آبدان خورشید را %~% دل در و بندد به درد و جان ازو گردد جدا(@)(@@) 32 ارزد اندر شب ز بهر شاهدی شمعی به جان %~% یوسفی شاید زلیخا را به صد گوهر بها(@)(@@) 33 بس نباشد قیمت گوهر به رونقهای درد %~% در نیابد بخشش بوبکر حق اصطفا(@)(@@) 34 از سپیدی اویس و از سیاهی بلال %~% مصطفا داند خبر دادن ز وحی پادشا(@)(@@) 35 سوز باید در بهای پیرهن تا با مشام %~% بوی دلبر یابد آن لبریز دامن در بکا(@)(@@) 36 آتش نفس ار نمیرد آب طوفان در رسد %~% باد 
ms204	 کبر ار کم نگردد خاک بر فرق کیا(@)(@@) 37 مرگ در خاک آرد آری مرد را لیکن ازو %~% چون برآید با خود آرد ساخته برگ بقا(@)(@@) 38 در نوای گردش گردون فروشد سیمجور %~% لاجرم تا در کنار افتاد روزی بینوا(@)(@@) 39 اینهمه در زیر سنگ آخر برآید روزگار %~% وینهمه بر بام زنگ آخر برآید این صدا(@)(@@) 40 تا برون آیند از این تنگ آشیان یکبارگی %~% تا فرو آیند ازین بام گران چون آسیا(@)(@@) 41 چون پدید آمد ملال آدم از حور و قصور %~% جفت او حوا نکوتر قصر او دارالفنا(@)(@@) 42 هر چه در دین پیشم آید گر چه نه سجده صواب %~% هر چه نزد حق پیشم افتد گر چه طاعت آن خطا(@)(@@) 43 عمر در کار غم دین کرد خواهم تا مگر %~% چون نمانم بنده‌ای گوید سنایی شد فنا(@)(@@) 44 آشنا شو چون سنایی در مثال راه عشق %~% تا شوی نزد بزرگان رازدار و آشنا(@)(@@) 45 تنگ شد بر ما فضای عافیت بی‌هیچ جرم %~% این چنین باشد «اذا جا القضا ضاق الفضا»(@)(@@) 46 این جواب آن سخن گفتم که گفته اوستاد %~% «ای نهاده پای همت بر سر اوج سما» PageV1P0442(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای سنایی گر همی جویی ز لطف حق سنا %~% عقل را قربان کن اندر بارگاه مصطفا(@)(@@) 2 هیچ مندیش از چنین عیاری ابرا بس بود %~% عاقله عقل ترا ایمان و سنت خون بها(@)(@@) 3 مصطفا اندر جهان آن گه کسی گوید که عقل %~% آفتاب اندر فلک آن گه کسی گوید سها(@)(@@) 4 طوقداران الاهی از زبان ذوق و شوق %~% عل را در شرع او خوانند غمخوار و کیا(@)(@@) 5 در شریعت ذوق دین‌یابی نه اندر عقل از آنک %~% قشر عالم عقل دارد مغز روح انبیا(@)(@@) 6 عقل تا با خود منی دارد عقالش دان نه عقل %~% چون منی زو دور گشت آن گه دوا خوانش نه دا(@)(@@) 7 عقل تا کو هست او را شرع نپذیرد ز 
ms205	 عز %~% باز چون که گشت گردد شرع پیشش کهربا(@)(@@) 8 در خدای آباد یابی امر و نهی دین و کفر %~% و احمد مرسل خدای آباد را بس پادشا(@)(@@) 9 چون نباشی خاک درگاه سرایی را که هست %~% پاسبان بام روح‌القدس و دربان مرتضا(@)(@@) 10 دی همه او بودی و امروز چون دوری ازو %~% تا جوانمردی بود دی دوست امروز آشنا(@)(@@) 11 «رحمة للعالمین» آمد طبیبت زو طلب %~% چه ازین عاصی وز آن عاصی همی جویی شفا(@)(@@) 12 کان شفا کز عقل و نفس و جسم و جان جویی شفا %~% چون نه از دستور او باشد شفا گردد شقا(@)(@@) 13 کان نجات و کان شفا کارباب سنت جسته‌اند %~% بوعلی سینا ندارد در «نجات» و در «شفا»(@)(@@) 14 ناشتا نزدیک او شو زان که خود نبود طبیب %~% مفتی ذوق و دلیل نبض جز در ناشتا(@)(@@) 15 مسجد حاجت روا جویی مجو اینجا که نیست %~% راه سنت گیر و آن گه مسجد حاجت روا(@)(@@) 16 گر دعاهای تهی‌دستان بر آن در بگذرد %~% باز گردد زاستان با آستین پر دعا(@)(@@) 17 چنگ در فتراک او زن تا بحق یابی رهی %~% سنگ بر قندیل خود زن تا ز خود گردی رها(@)(@@) 18 کانکه رست از رسم و عادت گوید او را سنتش %~% کای قفس بشکسته اینک شاخ طوبا مرحبا(@)(@@) 19 این یکی گوید به فرمان «استجیبواللرسول» %~% و آن دگر خواند ز ایمان «یفعل الله مایشا»(@)(@@) 20 تا بدانجایت فرود آرد که باشد اندرو %~% ناوک اندازانش قهر و خنجر آهنجان بلا(@)(@@) 21 زهره مردان چو بر زنگار پاشی ناردان %~% گرده گردان چو بر شنگرف مالی لوبیا(@)(@@) 22 حربه بهرام را بشکسته لطفش قبضه‌گاه %~% بربط ناهید را بشکسته قهرش گردنا(@)(@@) 23 بارگاه او دو در دارد که مردان در روند %~% یک در اندر کوفه یابی و دگر در کربلا(@)(@@) 24 در حریم مصطفا بوبکروار اندر خرام %~% تا سیه رویی جفا بینی و خوشخویی وفا(@)(@@) 25 عشق را 
ms206	 بینی علم بر کرده اندر کوی صدق %~% عقل را بینی قلم بشکسته در صدر رضا(@)(@@) 26 با وفاداران دین چندان بپر در راه او %~% تا نه بال خوف ماند با تو نه پر رجا(@)(@@) 27 دور کن بوی ریا از خود که تا آزاده‌وار %~% مسجد و میخانه را محرم شوی چون بوریا(@)(@@) 28 تو چه دیدستی هنوز از طول و عرض ملک او %~% کنکه در سدره‌ست هم آن را نداند منتها(@)(@@) 29 گر دو عالم را ببینی با ولایتهای او %~% هفت گلخن دیده باشی زانهمه هفت آسیا(@)(@@) 30 صورت احمد ز آدم بد ولیک اندر صفت %~% آدم از احمد پدید آمد چو ز آصف بر خیا(@)(@@) 31 جوهرش چون ز اضطرار عقل و نفس اندر گذشت %~% گفت و گوشش که «الرحمن علی العرش استوا»(@)(@@) 32 خاک آدم ز آفتاب جود او زر گشت از آنک %~% خاک آدم را چنان بود او که مس را کیمیا(@)(@@) 33 باز چون خود ز آفتاب جود زرین رخ شده‌ست %~% عارف زرگرش خواند: پرده‌دار کبریا(@)(@@) 34 عارفی و زرگری گویی کزو آموختست %~% خواجه و حامی و صدر و مهتر و استاد ما(@)(@@) 35 عارف زرگر که در دنیا چو عقل و آفتاب %~% عارفست اندر احاطت زرگرست اندر عطا(@)(@@) 36 ملک او ارباب دین را هم صلاح و هم سلاح %~% کلکل او دور زمان را هم صباح و هم مسا(@)(@@) 37 شکرها با بذل او چون پیش موسا جادوی %~% شعرها با فضل او چون نزد عیسا توتیا(@)(@@) 38 بخشش خود را به شکر کس نیالاید که هست %~% در ره آزاد مردان شکر جزوی از جزا(@)(@@) 39 اینهمه تابش ز روی و رای او نشگفت از آنک %~% بدر گردد مه چو با خورشید سازد ملتقا(@)(@@) 40 مقتدای عالم آمد مقتدی در دین او %~% من غلام مقتدی و خاکپای مقتدا(@)(@@) 41 فضل یحیا صاعد آن قاضی که خود بیرون ز فضل %~% صدهزاران فضل و یحیی بر مکست اندر 
ms207	 سخا(@)(@@) 42 قاضی مکرم که چون فوت صلات ایزدی %~% هست در شرع کرم فوت صلاتش را قضا(@)(@@) 43 روح او بر غیب واقف همچو لوح آسمان %~% کاک او در شرع منصف همچو خط استوا(@)(@@) 44 چون گران گردد رکابش روی بگشاید امید %~% چون سبک گردد عنانش پشت بنماید عنا(@)(@@) 45 مرتع حلمش چرا خواران صورت را ربیع %~% منبع علمش جزاخواهان معنی را جزا(@)(@@) 46 ای چو سودا کرده خصم سردرابی گرم گرم %~% وی چو طوبا داده شاخ خشک را بی‌نم نما(@)(@@) 47 ای مرا ممدوح و مادح وی را پیرو مرید %~% ای مرا قاضی و مقضی وی مرا خصم و گوا(@)(@@) 48 گرد تو گردم همی زیرا مرا هنگام سعی %~% از مروت وز صفا هم مروه‌ای و هم صفا(@)(@@) 49 اندرین غربت مرا همچون عصای موسیئی %~% دوستانم را عصا و دشمنم را اژدها(@)(@@) 50 از تو بودم بستانه خواجه عارف معرفت %~% وز تو کردم در فرات نعمت او آشنا(@)(@@) 51 بر تو خوانم شعر آن شعری شعار چرخ قدر %~% با تو گویم شکر آن شکر شکار خوش لقا(@)(@@) 52 پارسا خواندستم اندر شعر و من بر صدر او %~% هر که در فردوس باشد چون نباشد پارسا(@)(@@) 53 چون نباشم پارسا چون عقل او را داده‌ام %~% چون فرو دستان ملک امسال باژو پار سا(@)(@@) 54 با حیا گفت او مرا و چشم من روشن بدو %~% هر که روشن دیده تر شد بیشتر دارد حیا(@)(@@) 55 چون عصای موسی و برهان عیسی گفت او %~% ساحران را اژدها شد شاعران را متکا(@)(@@) 56 خاصه اندر حق این خادم که هست از مکرمت %~% دیگران را یک ولی نعمت مرا خود اولیا(@)(@@) 57 هم ولی اکرام نعمت هم ولی کتب علوم %~% هم ولی دارو درمان هم ولی شکر و ثنا(@)(@@) 58 هست کار من برو چونانکه وقتی پیش ازین %~% دهخدایی گفت با غوری فضولی در نسا(@)(@@) 59 کی فضولی کو خراجت غور گفتا: برگرفت %~% شاه 
ms208	 و پیغمبر زکوة از غور و احداث از بغا(@)(@@) 60 دهخدا گفت ار نمکساری شود انبان کون %~% گوزهای بی‌نمک پراند اهل روستا(@)(@@) 61 غورک بی‌مغز را صفرا بشورید و بگفت %~% کی مموه باژگونه یافه‌گوی هرزه لا(@)(@@) 62 ریش تو داند که گوز بینمک مان در مزه %~% کم نیابد آخر از تیز نمک سود شما(@)(@@) 63 ده خدا در خشم شد با غور گفتا: هم‌کنون %~% راست گردانم به یک باهو من این پشت دوتا(@)(@@) 64 غورک بی‌شرم کان بشنید گفت: احسنت و زه %~% خود چنین به هم طبیب و هم عوان هم ده خدا(@)(@@) 65 هزل بودست این ولیکن بر مثال جد سزید %~% همچنین بود آن ولی نعمت درین مدت مرا(@)(@@) 66 همچنان کان پیر حلوایی همی گفتا به مرو %~% هست ما را هم دعا و هم عصید و هم عصا(@)(@@) 67 گر ندادی پرورش جان و دماغم را به مرغ %~% مرغ‌وار اکنون گرفتستی دماغ و جان هوا(@)(@@) 68 از شراب آب روحانی و حیوانی بشست %~% روح نفسانیم را از نقش مالیخولیا(@)(@@) 69 جان و دل را بود دارو لیکن از بهر جگر %~% آنچه می‌باید نبود آن چیست کسنی و کما(@)(@@) 70 یک دو هفته طبع از آن بگریخت کز سلوی و من %~% چون ستوران باز در زد در پیاز و گندنا(@)(@@) 71 ای ز راه خلق و خلق و لحن خوش داوود وار %~% در دو جایم جلوه کرده در جهان چون اوریا(@)(@@) 72 معنی دعوت بسی بنموده ما را در حضور %~% ای عفی‌الله دعوی دعوات در غیبت چرا(@)(@@) 73 هر چه جویند از دعا ما را خود از تو رایجست %~% ابلهی باشد ز چون تو قبله دزدیدن دعا(@)(@@) 74 خشمت ار چه بر نخواند بر دلم بعد از طمع %~% همچو دیوانی بری منک بربر صیصیا(@)(@@) 75 آخر ارچه عقل ما گم شد ولی از روی حس %~% سر ز بالش باز می‌دانیم و پای از لالکا(@)(@@) 76 من همان گویم که 
ms209	 آن مز من بدان پرسنده گفت %~% کش بپرسید آنهمه عرق الرجال آخر کجا(@)(@@) 77 گفت لاتسأل حبیبی کآن همه برکند و سوخت %~% سبلت عرق الرجالم علت عرق النسا(@)(@@) 78 تنگ شد بر ما فضای عافیت بی‌هیچ جرم %~% وین چنین باشد «اذا جا القضا ضاق الفضا»(@)(@@) 79 مالشی بایست ما را زان که بربط را همی %~% گوشمالی شرط باشد تا درآید در نوا(@)(@@) 80 ای به ماهی جان ما را کرده چون ماهی شیم %~% وی ز شعری عقل ما را داده چون شعری سنا(@)(@@) 81 ما جواب آن چنان شعر چنینی گفته باز %~% شعر تو آواز داوود آن ما آن را صدا(@)(@@) 82 از تو آن آید ز ما این زان که در شرط قمار %~% پختگان را صرف بهتر خام دستان را دغا(@)(@@) 83 تو فشاندی نور خود چون ماه و اندر جرم خویش %~% مرده ریگش ماند آن گر بیش ازین دارد سها(@)(@@) 84 کی شود صفرای تو ساکن ز خوان ما چو هست %~% مطبخ ما را به جای زیر با تقصیر با(@)(@@) 85 تا چو هدهد عاقلان را هم ز سر خیزد کلاه %~% تا چو طوطی قانعان را هم ز تن روید قبا(@)(@@) 86 همچو تصحیف قبا باد و چو مقلوب کلاه %~% دشمنت اعنی هلاک و حاسدت اعنی فنا(@)(@@) 87 آنت باد از راه دنیا کت کند عقل آرزو %~% و آنت باد از روی حکمت کت کند دین اقتضا(@)(@@) 88 عالم و آدم ز خلق و خلق تو آباد و خوش %~% همچو از مادر صبی و همچو از گلبن صبا(@)(@@) 89 تو نهاده بر سر ما پای و ما گفته به تو %~% «ای نهاده پای همت بر سر اوج سما» PageV1P0443(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 منسوخ شد مروت و معدوم شد وفا %~% زین هر دو مانده نام چو سیمرغ و کیمیا(@)(@@) 2 شد راستی خیانت و شد زیرکی سفه %~% شد دوستی عداوت و شد مردمی جفا(@)(@@) 3 گشته‌ست باژگونه همه رسمهای خلق 
ms210	 %~% زین عالم نبهره و گردون بی‌وفا(@)(@@) 4 هر عاقلی به زاویه‌ای مانده ممتحن %~% هر فاضلی به داهیه ای گشته مبتلا(@)(@@) 5 آنکس که گوید از ره معنی کنون همی %~% اندر میان خلق ممیز چو من کجا(@)(@@) 6 دیوانه را همی نشناسد ز هوشیار %~% بیگانه را همی بگزیند بر آشنا(@)(@@) 7 با یکدگر کنند همی کبر هر گروه %~% آگاه نه کز آن نتوان یافت کبریا(@)(@@) 8 هرگز بسوی کبر نتابد عنان خویش %~% هرک آیتی نخست بخواند «ز هل اتی»(@)(@@) 9 با این همه که کبر نکوهیده عادتست %~% آزاده را همی ز تواضع بود بلا(@)(@@) 10 گر من نکوشمی به تواضع نبینمی %~% از هر خسی مذلت و از هر کسی عنا(@)(@@) 11 با جاهلان اگرچه به صورت برابرم %~% فرقی بود هرآینه آخر میان ما(@)(@@) 12 آمد نصیب من ز همه مردمان دو چیز %~% از دوستان مذلت و از دشمنان جفا(@)(@@) 13 قومی ره منازعت من گرفته‌اند %~% بی‌عقل و بی‌کفایت و بی‌فضل و بی‌دها(@)(@@) 14 بر دشمنان همی نتوان بود موتمن %~% بر دوستان همی نتوان کرد متکا(@)(@@) 15 من جز به شخص نیستم آن قوم را نظیر %~% شمشیر جز به رنگ نماند به گندنا(@)(@@) 16 با من همه خصومت ایشان عجب ترست %~% ز آهنگ مورچه به سوی جنگ اژدها(@)(@@) 17 گردد همی شکافته دلشان ز خشم من %~% همچون مه از اشارت انگشت مصطفا(@)(@@) 18 چون گیرم از برای حکیمی قلم به دست %~% گردد همه دعاوی آن طایفه هبا(@)(@@) 19 ناچار بشکند همه ناموس جاودان %~% در موضعی که در کف موسا بود عصا(@)(@@) 20 ایشان به نزد خلق نیابند رتبتی %~% تا طبعشان بود ز همه دانشی خلا(@)(@@) 21 زیرا که بی مطر نبود میغ را خطر %~% چونان که بی‌گهر نبود تیغ را بها(@)(@@) 22 زیشان نبود باک رهی را به ذره‌ای %~% کز آبگینه ظلم نیاید بر آسیا(@)(@@) 23 آنم که برده‌ام علم علم در جهان %~% بر گوشه ثریا از مرکز ثرا(@)(@@) 24 با عقل 
ms211	 من نباشد مریخ را توان %~% با فضل من نباشد خورشید را ذکا(@)(@@) 25 شاهان همی کنند به فضل من افتخار %~% حران همی کنند به نظم من اقتدا(@)(@@) 26 با خاطرم منیرم و با رای صافیم %~% کالبرق فی الدجی والشمس فی‌الضحی(@)(@@) 27 عالیست همتم به همه وقت چون فلک %~% صافیست نظم من به همه وقت چون هوا(@)(@@) 28 بر همت منست سخاهای من دلیل %~% بر نظم من بست سخنهای من گوا(@)(@@) 29 هرگز ندیده و نشنید این کسی ز من %~% کردار ناستوده و گفتار ناسزا(@)(@@) 30 این فخر بس مرا که ندیدست هیچکس %~% در نثر من مذمت و در نظم من هجا(@)(@@) 31 در پای ناکسان نپراکنده‌ام گهر %~% از دست مهتران نپذیرفته‌ام عطا(@)(@@) 32 آنرا که او به صحبت من سر درآورد %~% گویم ثنای نیک و شناسم به دل وفا(@)(@@) 33 ار ذلتی پدید شود زو معاینه %~% انگارمش صواب و نبینم ازو خطا(@)(@@) 34 اهل سرخس می نشناسند حق من %~% تا رحلتی نباشد ازین جایگه مرا(@)(@@) 35 مقدار آفتاب ندانند مردمان %~% تا نور او نگردد از آسمان جدا(@)(@@) 36 آنگاه قدر او بشناسند با یقین %~% کاید شب و پدید شود بر فلک سها(@)(@@) 37 اندر حضر نباشد آزاده را خطر %~% وندر حجر نباشد یاقوت را بها(@)(@@) 38 شد گفته سنایی چون کعبه نزد خلق %~% زین بیشتر فصول که باید ز ابتدا(@)(@@) 39 تا کلک او به گاه فصاحت روان بود %~% بازار او به نزد بزرگان بود روا(@)(@@) 40 آن گه به کام او نفسی بر نیاورند %~% در دوستی کجا بود این قاعده روا(@)(@@) 41 آزار او کشند به عمدا به خویشتن %~% زانسان که که کشد به سوی خویش کهربا(@)(@@) 42 در فضل او کنند به هر موضعی حسد %~% بر نقص او دهند ز هر جانبی رضا(@)(@@) 43 عاقل که این شنید بداند حقیقتی %~% کاین حرف دشمنان و حسودان بی‌نوا(@)(@@) 44 چون جوهر سخا شد نزدیک اهل بخل %~% چون عنصری ز ظلمت 
ms212	 در جنب صد ضیا(@)(@@) 45 تا ناصحان او نسگالند جز نفاق %~% تا دشمنان او ننمایند خود صفا(@)(@@) 46 ور اوفتد ورا بهمه عمر حاجتی %~% بی‌حجتی کنند همه صحبتش رها(@)(@@) 47 مرد آن بود که دوستی او بود بجای %~% لوبست الجبال و انشقت السما PageV1P0444(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 مکن در جسم و جان منزل که این دونست و آن والا %~% قدم زین هر دو بیرون نه نه آنجا باش و نه اینجا(@)(@@) 2 بهرچ از راه دور افتی چه کفر آن حرف و چه ایمان %~% بهرچ از دوست وا مانی چه زشت آن نقش و چه زیبا(@)(@@) 3 گواه رهرو آن باشد که سردش یابی از دوزخ %~% نشان عاشق آن باشد که خشکش بینی از دریا(@)(@@) 4 نبود از خواری آدم که خالی گشت ازو جنت %~% نبود از عاجزی وامق که عذرا ماند ازو عذرا(@)(@@) 5 سخن کز روی دین گویی چه عبرانی چه سریانی %~% مکان کز بهر حق جویی چه جابلقا چه جابلسا(@)(@@) 6 شهادت گفتن آن باشد که هم ز اول در آشامی %~% همه دریای هستی را بدان حرف نهنگ آسا(@)(@@) 7 نیابی خار و خاشاکی در این ره چون به فراشی %~% کمر بست و به فرق استاد در حرف شهادت لا(@)(@@) 8 چو لا از حد انسانی فکندت در ره حیرت %~% پس از نور الوهیت به الله آی ز الا(@)(@@) 9 ز راه دین توان آمد به صحرای نیاز ار نی %~% به معنی کی رسد مردم گذر ناکرده بر اسما(@)(@@) 10 درون جوهر صفرا همه کفرست و شیطانی %~% گرت سودای این باشد قدم بیرون نه از صفرا(@)(@@) 11 چه مانی بهر مرداری چو زاغان اندرین پستی %~% قفس بشکن چو طاووسان یکی بر پر برین بالا(@)(@@) 12 عروس حضرت قرآن نقاب آن گه براندازد %~% که دارالملک ایمان را مجرد بیند از غوغا(@)(@@) 13 عجب نبود گر از قرآن نصیبت نیست جز نقشی %~% که از خورشید جز گرمی نیابد چشم نابینا 
ms213	(@)(@@) 14 بمیر ای دوست پیش از مرگ اگر می زندگی خواهی %~% که ادریس از چنین مردن بهشتی گشت پیش از ما(@)(@@) 15 به تیغ عشق شو کشته که تا عمر ابد یابی %~% که از شمشیر بویحیا نشان ندهد کس از احیا(@)(@@) 16 چه داری مهر بد مهری کزو بی جان شد اسکندر %~% چه بازی عشق با یاری کزو بی‌ملک شد دارا(@)(@@) 17 گرت سودای آن باشد کزین سودا برون آیی %~% زهی سودا که خواهی یافت فردا از چنین سودا(@)(@@) 18 سر اندر راه ملکی نه که هر ساعت همی باشی %~% تو همچون گوی سرگردان و ره چون پهنه بی‌پهنا(@)(@@) 19 تو در کشتی فکن خود را مپای از بهر تسبیحی %~% که خود روح‌القدس گوید که بسم‌الله مجریها(@)(@@) 20 اگر دینت همی باید ز دنیا دار پی بگسل %~% که حرصش با تو هر ساعت بود بی‌حرف و بی‌آوا(@)(@@) 21 همی گوید که دنیا را بدین از دیو بخریدم %~% اگر دنیا همی خواهی بده دین و ببر دنیا(@)(@@) 22 ببین باری که هر ساعت ازین پیروزه گون خیمه %~% چه بازیها برون آرد همی این پیر خوش سیما(@)(@@) 23 جهان هزمان همی گوید که دل در ما نبندی به %~% تو خود می پند ننیوشی ازین گویای ناگویا(@)(@@) 24 گر از آتش همی ترسی به مال کس مشو غره %~% که اینجا صورتش مالست و آنجا شکلش اژدرها(@)(@@) 25 از آتش دان حواست را همیشه مستی و هستی %~% ز دوزخ دان نهادت را هماره مولد و منشا(@)(@@) 26 پس اکنون گر سوی دوزخ‌گرایی بس عجب نبود %~% که سوی کل خود باشد همیشه جنبش اجزا(@)(@@) 27 گر امروز آتش شهوت بکشتی بی‌گمان رستی %~% و گرنه تف آن آتش ترا هیزم کند فردا(@)(@@) 28 تو از خاکی بسان خاک تن در ده درین پستی %~% مگر گردی چو جان و عقل هم والی و هم والا(@)(@@) 29 که تا پستست خاک اینجا همه نفعست لیک آن گه %~% بلای 
ms214	 دیده‌ها گردد چو بالا گیرد از نکبا(@)(@@) 30 ز باد فقه و باد فقر دین را هیچ نگشاید %~% میان دربند کاری را که این رنگست و آن آوا(@)(@@) 31 مگو مغرور غافل را برای امن او نکته %~% مده محرور جاهل را ز بهر طبع او خرما(@)(@@) 32 چو علمت هست خدمت کن چو دانایان که زشت آید %~% گرفته چینیان احرام و مکی خفته در بطحا(@)(@@) 33 نه صوت از بهر آن آمد که سوزی مزهر زهره %~% نه حرف از بهر آن آمد که دزدی چادر زهرا(@)(@@) 34 ترا تیغی به کف دادند تا غزوی کنی با خود %~% تو چون از وی سپر سازی نمانی زنده در هیجا(@)(@@) 35 به نزد چون تو بی‌حسی چه دانایی چه نادانی %~% به دست چون تو نامردی چه نرم آهن چه روهینا(@)(@@) 36 ترا بس ناخوشست آواز لیکن اندرین گنبد %~% خوش آوازت همی دارد صدای گنبد خضرا(@)(@@) 37 ولیک آن گه خجل گردی که استادی ترا گوید %~% که با داوود پیغمبر رسیلی کن درین صحرا(@)(@@) 38 تو چون موری و این راهست همچون موی بت رویان %~% مرو زنهار بر تقلید و بر تخمین و بر عمیا(@)(@@) 39 چو علم آموختی از حرص آن گه ترس کاندر شب %~% چو دزدی با چراغ آید گزیده‌تر برد کالا(@)(@@) 40 از این مشتی ریاست جوی رعنا هیچ نگشاید %~% مسلمانی ز سلمان جوی و درد دین ز بودردا(@)(@@) 41 به صاحب دولتی پیوند اگر نامی همی جویی %~% که از یک چاکری عیسی چنان معروف شد یلدا(@)(@@) 42 قدم در راه مردی نه که راه و گاه و جاهش را %~% نباشد تا ابد مقطع نبودست از ازل مبدا(@)(@@) 43 ز بهر قالب اوراست این ارواح مستوفی %~% ز بهر حالت اوراست این انفاس مستوفا(@)(@@) 44 ز بهر کشت آنجا راست اینجا کشتن آدم %~% ز بهر زاد آنجا راست اینجا زادن حوا(@)(@@) 45 تو پنداری که بر بازیست این میدان چون مینو %~% تو 
ms215	 پنداری که بر هرزه‌ست این الوان چون مینا(@)(@@) 46 وگر نز بهر دینستی در اندر بنددی گردون %~% وگر نز بهر شرعستی کمر بگشایدی جوزا(@)(@@) 47 چو تن جان را مزین کن به علم دین که زشت آید %~% درون سو شاه عریان و برون سو کوشک در دیبا(@)(@@) 48 ز طاعت جامه‌ای نو کن ز بهر آن جهان ورنه %~% چو مرگ این جامه بستاند تو عریان مانی و رسوا(@)(@@) 49 خود از نسل جهانبانان نزاید هیچ تا باشد %~% مر او را کوی پر عنین و ما را خانه پر عذرا(@)(@@) 50 نبینی طبع را طبعی چو کرد انصاف رخ پنهان %~% نیابی دیو را دیوی چو کرد اخلاص رخ پیدا(@)(@@) 51 ترا یزدان همی گوید که در دنیا مخور باده %~% ترا ترسا همی گوید که در صفرا مخور خلوا(@)(@@) 52 ز بهر دین بنگذاری حرام از گفته یزدان %~% ولیک از بهر تن مانی حلال از گفته ترسا(@)(@@) 53 گرت نزهت همی باید به صحرای قناعت شو %~% که آنجا باغ در باغست و خوان در خوان و وا در وا(@)(@@) 54 گر از زحمت همی ترسی ز نااهلان ببر صحبت %~% که از دام زبون گیران به عزلت رسته شد عنقا(@)(@@) 55 مرا باری بحمدالله ز راه رافت و رحمت %~% به سوی خطه وحدت برد عقل از خط اشیا(@)(@@) 56 به دل نندیشم از نعمت نه در دنیا نه در عقبا %~% همی خواهم به هر ساعت چه در سرا چه رد ضرا(@)(@@) 57 که یارب مر سنایی را سنایی ده تو در حکمت %~% چنان کز وی به رشک افتد روان بوعلی سینا(@)(@@) 58 مگردانم درین عالم ز بیش آزی و کم عقلی %~% چو رای عاشقان گردان چو طبع بیدلان شیدا(@)(@@) 59 ز راه رحمت و رافت چو جان پاک معصومان %~% مرا از زحمت تن‌ها بکن پیش از اجل تنها(@)(@@) 60 زبان مختصر عقلان ببند اندر جهان بر من %~% که تا چون خود نخوانندم حریص 
ms216	 و مفسد و رعنا(@)(@@) 61 مگردان عمر من چون گل که در طفلی شود کشته %~% مگردان حرص من چون مل که در پیری شود برنا(@)(@@) 62 بحرص ار شربتی خوردم مگیر از من که بد کردم %~% بیابان بود و تابستان و آب سرد و استسقا(@)(@@) 63 به هرچ از اولیا گویند «رزقنی» و «وفقنی» %~% به هرچ از انبیا گویند «آمنا» و «صدقنا» PageV1P0445(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای بنام و خوی خوش میراث دار مصطفا %~% بر تو عاشق هر دو گیتی و تو عاشق بر سخا(@)(@@) 2 ای چو آب اندر لطافت ای چو خاک اندر درنگ %~% وی چو آتش در بلندی و چو باد اندر صفا(@)(@@) 3 رشوت از حکمت چنان دورست کز گردون فساد %~% بدعت از علمت چنان پاکست کز جنت وبا(@)(@@) 4 برفکندی رسم ظلم و اسم رشوت از جهان %~% تا شدی بر مسند حکم شریعت پادشا(@)(@@) 5 ای که بر صحرا نزیبد جز برای خدمتت %~% هیچ هدهد را کلاه و هیچ طوطی را قبا(@)(@@) 6 دوست رویی آن چنان کز پشت ماهی تا به ماه %~% بر تو هر موجود را عشقی همی بینم جدا(@)(@@) 7 گر چه ناهموار بود از پیشکاران کار حکم %~% پیش از این لیکن ز فر عدل تو در وقت ما(@)(@@) 8 آن چنان شد خاندان حکم کز انصاف و عدل %~% می‌کند مر خاک را از باد عدل تو جدا(@)(@@) 9 جز دعای تو نمی‌گویند شیران در زئیر %~% جز ثنای تو نمی‌خواهند مرغان در نوا(@)(@@) 10 ای در حکمست و این دعوی که کردم راست بود %~% گر نداری استوارم بگذرانم صد گوا(@)(@@) 11 عقل اندر کارگاه جان روایی خواست یافت %~% از برای خدمت صدرت نه از بهر بها(@)(@@) 12 ناگهان دیدم که گردان گشت بر گردون نطق %~% بیست و نه کوکب همه تاری ولیک اصل ضیا(@)(@@) 13 بغضی از وی چون بنات النعش و بعضی چون هلال %~% بعضی از وی چون ثریا بعضی از وی 
ms217	 چون سها(@)(@@) 14 شکلهاشان در مخارج نقش نفس ناطقه %~% ذاتهاشان بر منابر شرح شرع مصطفا(@)(@@) 15 چشم من چون گوش گشتی چون ندیدی بر زمین %~% گوش من چون چشم گشتی چون شدندی بر سما(@)(@@) 16 ترجمان کفر و دین بودند و جاسوس ضمیر %~% قهرمان عقل و جان بودند و فرزند هوا(@)(@@) 17 عقل چون در یافتن شد این همه گرد آمدند %~% نزد او از بهر عز سرمد و کسب بقا(@)(@@) 18 عقل عاجز شد ازیشان زان که ریشه آن ردا %~% این یکی گفتی: مرا ساز آن دگر گفتی : مرا(@)(@@) 19 عقل چون مرسیرتت را چاکریها کرده بود %~% کرد چون خلقت امید هر یکی زیشان روا(@)(@@) 20 مبهم و رمز از چه گویم چون نگویم آشکار %~% نه کسی اینجای بیگانه‌ست ماییم و شما(@)(@@) 21 و آنکه شعری خواستم گفتن ترا از بهر شکر %~% نز برای آنکه تا بار دگر جویم عطا(@)(@@) 22 حرفها دیدم که خود را یک به یک بر می‌زند %~% پیش من زاری کنان زانسان که پیران در دعا(@)(@@) 23 گاه تاج از سر همی انداخت شین بر سان سین %~% گاه پیشم سرنگون میشد الف مانند لا(@)(@@) 24 همچو جیم و دال و را و قاف و عین و لام و نون %~% از الف تا یا دگرها مانده در پیشم دوتا(@)(@@) 25 این همی گفت ای سنایی الله الله زینهار %~% از جمال مدح او ما را نصیبی کن سنا(@)(@@) 26 و آن دگر گفتی مرا کن قافیت در مدح او %~% تا بدرم همچو اقبالش مخالف را قفا(@)(@@) 27 وین دگر گفتی: مرا حرف روی کن تا چنو %~% در میان حرفها بازار من گردد روا(@)(@@) 28 چون ز خلق معنویت آن دیده بودم در زمان %~% از پی تشریف ایشان مثنوی گفتم ثنا(@)(@@) 29 ز آنچنان سیرت چنین معنی همی زاید یلی %~% ز آسمان چون نوش بارد نوش باشد نوشبا(@)(@@) 30 تا بیابی گر بجویی از برای حج و غزو %~% در 
ms218	 مناسک حکم حج و در سیر حکم غزا(@)(@@) 31 این چنین انصافها چون غازیان بادت ثواب %~% وز چنان کردارها چون حاجیان بادت جزا(@)(@@) 32 اخترت بادا منیر و طالعت بادا قوی %~% رتبتت بادا بلند و حاجتت بادا روا PageV1P0446(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 آراست جهاندار دگرباره جهان را %~% چو خلد برین کرد زمین را و زمان را(@)(@@) 2 فرمود که تا چرخ یکی دور دگر کرد %~% خورشید بپیمود مسیر دوران را(@)(@@) 3 ایدون که بیاراست مر این پیر خرف را %~% کاید حسد از تازگیش تازه جوان را(@)(@@) 4 هر روز جهان خوشتر از آنست چو هر شب %~% رضوان بگشاید همه درهای جنان را(@)(@@) 5 گویی که هوا غالیه آمیخت بخروار %~% پر کرد از آن غالیه‌ها غالیه‌دان را(@)(@@) 6 گنجی که به هر کنج نهان بود ز قارون %~% از خاک برآورد مر آن گنج نهان را(@)(@@) 7 ابری که همی برف ببارید ببرید %~% شد غرقه بحری که ندید ایچ کران را(@)(@@) 8 آن ابر درر بار ز دریا که برآید %~% پر کرده ز در و درم و دانه دهان را(@)(@@) 9 از بس که ببارید به آب اندر لولو %~% چون لولو تر کرد همه آب روان را(@)(@@) 10 رنجی که همی باد فزاید ز بزیدن %~% بر ما بوزید از قبل راحت جان را(@)(@@) 11 کوه آن تل کافور بدل کرد به سیفور %~% شادی روان داد مر آن شاد روان را(@)(@@) 12 بر کوه از آن توده کافور گرانبار %~% خورشید سبک کرد مر آن بار گران را(@)(@@) 13 خاکی که همه ژاله ستد از دهن ابر %~% تا بر کند آن لاله خوش خفته ستان را(@)(@@) 14 چندان ز هوا ژاله ببارید بدو ابر %~% تا لاله ستان کرد همه لاله ستان را(@)(@@) 15 از رنگ گل و لاله کنون باز بنفشه %~% چون نیل شود خیره کند گوهر کان را(@)(@@) 16 شبگیر زند نعره کلنگ از دل مشتاق %~% وز نعره زدن طعنه زند نعره زنان را 
ms219	(@)(@@) 17 آن لکلک گوید که: لک الحمد لک الشکر %~% تو طعمه من کرده‌ای آن مار دمان را(@)(@@) 18 قمری نهد از پشت قبای خز و قاقم %~% اکنون که بتابید و بپوشید کتان را(@)(@@) 19 طاووس کند جلوه چو از دور به بیند %~% بر فرق سر هدهد آن تاج کیان را(@)(@@) 20 موسیجه همی گوید: یا رازق رزاق %~% روزی ده جانبخش تویی انسی و جان را(@)(@@) 21 زاغ از شغب بیهده بربندد منقار %~% چون فاخته بگشاده به تسبیح زبان را(@)(@@) 22 پیوسته هما گوید: یکیست یگانه %~% تا در طرب آرد به هوا بر ورشان را(@)(@@) 23 گنجشک بهاری صفت باری گوید %~% کز بوم به انگیزد اشجار نوان را(@)(@@) 24 هر گوید هو صد بدمی سرخ کبوتر %~% در گفتن هو دارد پیوسته لسان را(@)(@@) 25 چرغان به سر چنگ درآورده تذروان %~% تسبیح شده از دهن مرغ مر آن را(@)(@@) 26 شارک چو موذن به سحر حلق گشاده %~% آن ژولک و آن صعوه از آن داده اذان را(@)(@@) 27 آن شیشککان شاد ازین سنگ به آن سنگ %~% پاینده و پوینده مر آن پیک دوان را(@)(@@) 28 آن کبک مرقع سلب برچده دامن %~% از غالیه غل ساخته از بهر نشان را(@)(@@) 29 بنگر به هوا بر به چکاوک که چه گوید %~% خیر و حسنت بادا خیرات و حسان را(@)(@@) 30 نازیدن ناز و نواهای سریچه %~% ناطق کند آن مرده بی‌نطق و بیان را(@)(@@) 31 آن کرکی گوید که: توی قادر قهار %~% از مرگ همی قهر کنی مر حیوان را(@)(@@) 32 پیوسته همی گوید آن سر شب تشنه %~% بی‌آب ملک صبر دهد مر عطشان را(@)(@@) 33 مرغابی سرخاب که در آب نشیند %~% گوید که خدایی و سزایی تو جهان را(@)(@@) 34 در خوید چنین گوید کرک که: خدایا %~% تو خالق خلقانی صد قرن قران را(@)(@@) 35 گویند تذروان که تو آنی که بدانی %~% راز تن بی‌قوت و بی‌روح و روان را(@)(@@) 36 آن باز چنین 
ms220	 گوید یارب تو نگهدار %~% بر امت پیغمبر ایمان و امان را(@)(@@) 37 آن کرکس با قوت گوید که به قدرت %~% جبار نگهدار این کون و مکان را(@)(@@) 38 بنگر که عقاب از پس تسبیح چه گوید %~% آراسته دارید مر این سیرت و سان را(@)(@@) 39 بلبل چه مذکر شده و قمری قاری %~% برداشته هر دو شغب و بانگ و فغان را(@)(@@) 40 آید به تو هر پاس خروشی ز خروسی %~% کی غافل بگذار جهان گذران را(@)(@@) 41 آوازه برآورد که: ای قوم تن خویش %~% دوزخ مبرید از پی بهمان و فلان را(@)(@@) 42 دنیا چو یکی بیشه شمارید و ژیان شیر %~% در بیشه مشورید مر آن شیر ژیان را(@)(@@) 43 در جستن نان آب رخ خویش مریزید %~% در نار مسوزید روان از پی نان را(@)(@@) 44 ایزد چو به زنار نبستست میانتان %~% در پیش چو خود خیره مبندید میان را(@)(@@) 45 زان پیش که جانتان بستاند ملک الموت %~% از قبضه شیطان بستانید عنان را(@)(@@) 46 مجدود بدینحال تو نزدیکتری زانک %~% پیریت به نهمار فرستاده خزان را PageV1P0447(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 شاه را خواهی که بینی خاک شو درگاه را %~% ز آبرو آبی بزن درگاه شاهنشاه را(@)(@@) 2 نعل کن چون چتر او دیدی کلاه چرخ را %~% چاک زن چون روی او دیدی قبای ماه را(@)(@@) 3 چون کله بر سر نشین دزدان افسر جوی را %~% چون خرد در جان نشان رندان لشکرگاه را(@)(@@) 4 از برای عز دیدار سیاوخشی و شش %~% همچو بیژن بند کن در چاه خواری جاه را(@)(@@) 5 عافیت را سر بزن بهر کمال عشق را %~% عاقبت را دم بزن بهر جمال راه را(@)(@@) 6 هم به چشم شاه روی شاه خواهی دید و بس %~% دیده اندر کار شه کن کوری بدخواه را(@)(@@) 7 آه غمازست اندر راه عشق و عاشقی %~% بند برنه در نهانخانه خموشی آه را(@)(@@) 8 از سر آزاد مردی تیغی از غیرت بزن %~% هم 