ms6361	 البحار إلى أعدائهم فيهم صلاة لو كانت في قوم نوح ما أهلكوا بالطوفان ، ولو كانت في عاد ما أهلكوا بالريح ، ولو كانت في ثمود ما أهلكوا بالصيحة ، بسم الله وقوله الحق ) . فقال رسول الله : ضعوها بين ظهري ورق المصحف ) . ( أبو نعيم ) .(@)(@@)(@@)(@@) $ 12580 عن جعفر بن عبد الله بن الحكم بن رافع رضي الله عنه قال : ( رآني الحكم وأنا غلام اكل من ههنا وههنا ، فقال لي : يا غلام ! لا تأكل هكذا كما يأكل الشيطان ، إن النبي كان إذا أكل لم تعد أصابعه بين يديه ) . ( أبو نعيم ) .(@)(@@)(@@)(@@) |||| 83 ( الحكم بن سعيد بن العاص بن أمية رضي الله عنه )(@)(@@)(@@)(@@) $ 12581 عن الحكم بن سعيد بن العاص رضي الله عنه قال : ( أتيت رسول الله لأبايعه فقال : ما اسمك ؟ قلت : الحكم قال : بل أنت عبد الله ، فقلت : أنا عبد الله يا رسول الله ) . ( أبو نعيم ) .(@)(@@)(@@)(@@) |||| 84 ( الحكم بن سفيان الثقفي رضي الله عنه )(@)(@@)(@@)(@@) $ 12582 عن الحكم بن سفيان الأوري رضي الله عنه : ( أنه رأى النبي بال ثم توضأ ، ثم أخذ كفا من ماء فنضح به فرجه ) . ( ص ، ش ، وأبو نعيم ) .(@)PageV18P347(@)(@@)(@@)(@@) |||| 85 ( الحكم بن عمرو بن الشريد رضي الله عنه )(@)(@@)(@@)(@@) $ 12583 عن الحكم بن عمرو بن الشريد قال : ( صليت خلف النبي فعطس رجل فقال : يرحمك الله ، فضحك بعض القوم ) . ( الحسن بن سفيان وأبو نعيم ) .(@)(@@)(@@)(@@) |||| 86 ( الحكم بن عمير الثمالي رضي الله عنه )(@)(@@)(@@)(@@) $ 12584 عن موسى بن أبي حبيب ، عن الحكم بن عمير رضي الله عنه قال : ( قال رسول الله : الأمر المفظع ، والحمل المضلع والشر الذي لا ينقطع إظهار البدع ) . ( الحسن بن سفيان وأبو نعيم ) .(@)(@@)(@@)(@@) $ 12585 عن أبي ليلى ، عن الحكم رضي الله عنه قال : ( بعث النبي معاذا رضي الله عنه وأمره أن يأخذ من البقر من كل ثلاثين بقرة تبيعا أو تبيعة ، ومن كل أربعين مسنة ، فسألوه عن فضل ما بينهما ، فأبى أن يأخذ ، حتى سأل النبي فقال : لا تأخذ شيئا ) . ( ش ) .(@)(@@)(@@)(@@) $ 12586 عن موسى بن أبي حبيب ، عن الحكم بن عمير الثمالي رضي الله عنه 
ms6362	 قال : ( كان رسول الله يعلمنا : إذا قمتم إلى الصلاة فكبروا ، وارفعوا أيديكم ولا تجوزوا آذانكم ، وقولوا : سبحانك اللهم ، وبحمدك ، وتبارك اسمك ، وتعالى جدك ، ولا إلاه غيرك ) . ( أبو نعيم ) .(@)(@@)(@@)(@@) $ 12587 عن موسى بن أبي حبيب ، عن الحكم بن عمير الثمالي رضي الله عنه وكان بدريا قال : صليت خلف النبي فجهر في الصلاة PageV18P348 ب { بسم الله الرحمان الرحيم } في صلاة الليل ، وصلاة الغداة ، وصلاة الجمعة ) . ( أبو نعيم ) .(@)(@@)(@@)(@@) |||| 87 ( الحكم بن مرة رضي الله عنه )(@)(@@)(@@)(@@) $ 12588 عن شيبة بن مساور ، عن الحكم بن مرة صاحب رسول الله : ( أنه رأى رجلا يصلي فأساء الصلاة ، فانفتل ، فقال له : صل ، فقال : قد صليت ، قال : صل ، قال : قد صليت ، فأعاد عليه مرارا ، فقال : والله لا تصلين ، والله ! لتعصى الله جهارا ) . ( أبو نعيم ) .(@)(@@)(@@)(@@) |||| 88 ( الحكم أبو شبيث رضي الله عنه )(@)(@@)(@@)(@@) $ 12589 عن شبيث بن الحكم ، عن أبيه : ( أن رجلا من أسلم أصيب فرقاه رسول الله ) . ( أبو نعيم ) .(@)(@@)(@@)(@@) |||| 89 ( السائب بن يزيد رضي الله عنه )(@)(@@)(@@)(@@) $ 12590 عن اسائب بن يزيد رضي الله عنه قال : ( كنت عاملا على سوق المدينة زمن عمر رضي الله عنه فكنا نأخذ من النبط العشر ) . ( الشافعي وأبو عبيد ) .(@)(@@)(@@)(@@) $ 12591 عن السائب بن يزيد رضي الله عنه قال : ( أمر النبي أن لا ندخل صلاة حتى نتكلم أو نخرج ) . ( كر ) .(@)(@@) PageV18P349(@)(@@)(@@)(@@) $ 12592 عن السائب بن يزيد رضي الله عنه قال : ( ما كان لرسول الله إلا مؤذن واحد يؤذن إذا قعد على المنبر ، ويقيم إذا نزل ثم أبو بكر رضي الله عنه كذلك ، ثم عمر رضي الله عنه حتى كان عثمان رضي الله عنه وفشا الناس وكثروا ، زاد النذاء الثالث عند الزوراء ) . ( ش ، وأبو الشيخ في الأذان ) .(@)(@@)(@@)(@@) $ 12593 عن السائب بن يزيد رضي الله عنه قال : ( كان بلال رضي الله عنه يؤذن إذا جلس النبي على المنبر يوم الجمعة ، وإذا نزل أقام ، ثم كان كذلك في زمن أبي بكر وعمر رضي الله عنهما ، وإنما أمر بالتأذين الثالث عثمان رضي الله عنه حين كثر أهل المدينة ، وإنما كان التأذين يوم 
ms6363	 الجمعة حين يجلس الإمام على المنبر ) . ( أبو الشيخ ) .(@)(@@)(@@)(@@) $ 12594 عن السائب بن يزيد رضي الله عنه قال : ( عوذني رسول الله بأم الكتاب تفلا ) . ( قط ، في الأفراد ، كر ) .(@)(@@)(@@)(@@) $ 12595 عن السائب بن يزيد رضي الله عنه قال : ( رأيت رسول الله قتل عبد الله بن خطل يوم الفتح ، وأخرجوه من تحت أستار الكعبة ، فضرب عنقه بين زمزم والمقام ، ثم قال : لا يقتلن قرشي بعد هذا صبرا ) . ( كر ) .(@)(@@)(@@)(@@) $ 12596 عن الجيد بن عبد الرحمن قال : ( مات السائب بن يزيد رضي الله عنه وهو ابن أربع وتسعين سنة ، وكان جلدا معتدلا ، وقال : قد علمت ، ما متعت به من سمعي وبصري إلا بدعاء رسول الله ، ذهبت بي خالتي إلى رسول الله فقالت : إن ابن أختي شاك فادع الله له ، فدعا لي ) . ( الحسن بن سفيان ، كر ) .(@)(@@)(@@)(@@) $ 12597 عن عطاء مولى السائب بن يزيد رضي الله عنه قال : ( كان وسط رأس السائب أسود ، وبقية رأسه ولحيته أبيض ، فقلت له : قال : إني كنت مع PageV18P350 الصبيان ألعب ، فمر بي النبي فعرضت له فسلمت عليه ، فقال : وعليك ، من أنت ؟ قلت : أنا السائب بن يزيد ابن أخت النمر بن قاسط ، فمسح رسول الله رأسي وقال : بارك الله فيك ، فهو لا يشيب أبدا ) . ( كر ) .(@)(@@)(@@)(@@) $ 12598 عن يوسف بن السائب عن السائب رضي الله عنه قال : ( كنا نتحلق يوم الجمعة قبل الصلاة ) . ( ش ) .(@)(@@)(@@)(@@) |||| 90 ( السائب بن أبي السائب صيفي بن عائذ المخزومي رضي الله عنه )(@)(@@)(@@)(@@) $ 12599 عن مجاهد ، عن السائب رضي الله عنه : ( أنه كان يشارك النبي قبل الإسلام في التجارة ، فلما كان يوم الفتح أتاه فقال : مرحبا بأخي وشريكي ، كان لا يداري ولا يماري ، يا سائب ! قد كنت تعمل أعمالا في الجاهلية لا يتقبل منك ، وهي اليوم تتقبل منك ؛ وكان ذا سلف وصلة ) . ( ش ) .(@)(@@)(@@)(@@) |||| 91 ( الشريد بن سويد رضي الله عنه )(@)(@@)(@@)(@@) $ 12600 عن الشريد رضي الله عنه قال : ( أردفني النبي ، فقال : هل معك من شعر أمية بن أبي الصلت ؟ وفي لفظ : هل تروي من شعر أمية شيئا ؟ قلت : نعم ، فأنشدته ، قال : هيه 
ms6364	 ، فلم يزل يقول هيه ، حتى أنشدته مائة بيت ، فقال : إن كاد ليسلم ، وفي لفظ : لقد كاد أن يسلم في شعره ) . ( ع ، وابن جرير ، كر ) .(@)(@@)(@@)(@@) $ 12601 عن الشريد رضي الله عنه قال : ( خرجت مع رسول الله في حجة الوداع ، فبينا أنا أمشي ذات يوم إذ وقع ناقة خلفي ، فتلفت فإذا PageV18P351 رسول الله فقال : الشريد ؟ قلت ؟ نعم ، قال : ألا أحملك ؟ قلت : بلى ، وما بي من إعياء ولا لغوب ولكن أردت البركة في ركوبي مع رسول الله ، فأناخ فحملني فقال : أمعك من شعر أمية بن أبي الصلت ؟ قلت : نعم ، قال : هات ، فأنشدته مائة بيت ، قال : عند الله علم أمية بن أبي الصلت ، عند الله علم أمية بن أبي الصلت ) . ( ابن صاعد ، وقال : غريب ، كر ) .(@)(@@)(@@)(@@) |||| 92 ( الضحاك بن سفيان الكلابي رضي الله عنه )(@)(@@)(@@)(@@) $ 12602 عن أسعد بن زرارة : ( كتب رسول الله إلى الضحاك بن سفيان رضي الله عنه أن يورث امرأة أشيم الضبابي من دية زوجها ) . ( طب ) .(@)(@@)(@@)(@@) $ 12603 عن المغيرة بن شعبة ، عن أبي ثابت بن حزن ، أو ابن حزم : ( أن النبي كتب إلى الضحاك بن سفيان رضي الله عنه أن يورث امرأة أشيم الضبابي من ديته ) . ( كر ؛ وقال : لم يتابع خالد بن عبد الرحمن المخزومي على أبي ثابت وخالد ضعيف ) .(@)(@@)(@@)(@@) $ 12604 عن ابن المسيب : ( أن عمر بن الخطاب رضي الله عنه قال : ما أرى الدية إلا للعصبة لأنهم يعقلون عنه ، فهل سمع أحد منكم من رسول الله في ذلك شيئا ؟ فقال الضحاك بن سفيان الكلابي وكان النبي استعمله على الأعراب : كتب إلي رسول الله أن أورث امرأة أشيم الضبابي من دية زوجها ، وكان قتل خطأ ، فأخذ بذلك عمر رضي الله عنه ) . ( عب ، ص ) .(@)(@@)(@@)(@@) $ 12605 عن الضحاك : ( أن أبا بكر وعليا رضي الله عنهما أوصيا بالخمس من أموالهما وأن لا يرث من ذوي قرابتهما ) . ( ص ) .(@)PageV18P352(@)(@@)(@@)(@@) |||| 93 ( الضحاك بن قيس رضي الله عنه )(@)(@@)(@@)(@@) $ 12606 عن الضحاك بن قيس رضي الله عنه قال : ( كان بالمدينة امرأة يقال لها أم عطية تخفض الجواري ، فقال لها رسول الله 
ms6365	 : يا أم عطية ! إذا خفضت فلا تنهكي ، فإنه أحظى للزوج وأسرى للزوجة ) . ابن منده ، ( كر ) .(@)(@@)(@@)(@@) |||| 94 ( الطفيل بن عمرو الدوسي رضي الله عنه )(@)(@@)(@@)(@@) $ 12607 عن إسماعيل بن عياش قال : حدثني عبد ربه بن سليمان ، عن الطفيل بن عمرو الدوسي رضي الله عنه ، قال : ( أقرأني أبي بن كعب رضي الله عنه القرآن ، فأهديت له قوسا ، فغدا إلى النبي متقلدها ، فقال له النبي : من سلحك هذه القوس يا أبي ؟ فقال : الطفيل بن عمرو الدوسي ، أقرأته القرآن ، فقال له رسول الله : تقلدها شلوة من جهنم ، فقال : فلا بأس أن تأكله ، وأما ما صنع لك فإنك إن أكلته فإنما تأكل بخلاقك ) . ( البغوي ، وقال : حديث غريب ، وعبد ربه بن سليمان بن زيتون أحسبه من أهل حمص ، ولم يسمع من الطفيل ، كر ) .(@)(@@)(@@)(@@) |||| 95 ( العباس بن عبد المطلب رضي الله عنه )(@)(@@)(@@)(@@) $ 12608 عن الشعبي قال : ( انطلق العباس مع النبي إلى الأنصار PageV18P353 فقال : تكلموا ولا تطيلوا الخطبة ، إن عليكم عيونا وإني أخشى عليكم كفار قريش ، فتكلم رجل منهم يكنى أبا أمامة ، وكان خطيبهم يومئذ ، وهو أسعد بن زرارة ، فقال للنبي : سلنا لربك ، وسلنا لنفسك ، وسلنا لأصحابك ، وما الثواب على ذلك ؟ فقال النبي : أسألكم لربي أن تعبدوه ولا تشركوا به شيئا ، ولنفسي أن تؤمنوا بي وتمنعوني مما تمنعون منه أنفسكم ، وأسألكم لأصحابي المواساة في ذات أيديكم قالوا : فما لنا إذا فعلنا ذلك ؟ قال : لكم على الله الجنة ) . ( ش ، كر ) .(@)(@@)(@@)(@@) $ 12609 عن عروة قال : ( أخذ العباس بن عبد المطلب رضي الله عنه بيد رسول الله في العقبة حين وافاه السبعون على الأنصار ، فأخذ لرسول الله واشترط له ، وذلك والله غرة الإسلام وأوله من قبل أن يعبد الله أحد علانية ) . ( كر ) .(@)(@@)(@@)(@@) $ 12610 عن ابن عباس رضي الله عنهما قال : ( كان العباس بن عبد المطلب كثيرا ما يقول : ما رأيت أحدا أحسنت إليه إلا أضاء ما بيني وبينه ، وما رأيت أحدا أسأت إليه إلا أظلم ما بيني وبينه ، فعليك بالإحسان واصطناع المعروف ، فإن ذلك يقي مصارع السوء ) . ( كر ) .(@)(@@)(@@)(@@) $ 12611 عن العباس بن 
ms6366	 عبد المطلب رضي الله عنه قال : ( خرجت مع رسول الله من المدينة ، فالتفت إليها فقال : إن الله تبارك وتعالى نزه هذه الجزيرة وفي لفظ : لقد برأ الله أهل هذه المدينة من الشرك ، ولكني أخاف أن تضلهم النجوم ، قالوا : وكيف تضلهم يا رسول الله ؟ قال : ينزل الله الغيث فيقولون : مطرنا بنوء كذا وكذا ) . ( ابن جرير ) .(@)(@@)(@@)(@@) $ 12612 عن عم بن إبراهيم ، عن أيوب بن سيار ، عن محمد بن المنكدر ، عن جابر قال : ( جاء العباس بن عبد المطلب رضي الله عنه إلى النبي وعليه PageV18P354 ثياب بيض ، فلما نظر إليه تبسم ، فقال العباس : يا رسول الله ! ما الجمال ؟ قال : صواب القول بالحق ، قال : فما الكمال ؟ قال : حسن الفعال بالصدق ) . ( هق ، وقال : تفرد به عمر وليس بالقوي ، كر ، ابن النجار ) .(@)(@@)(@@)(@@) $ 12613 عن أبي جعفر محمد بن علي بن الحسين قال : ( أقبل العباس بن عبد المطلب رضي الله عنه وهو أبيض بض ، وعليه حلة ، وله ضفيرتان ، فلما رآه رسول الله تبسم ، فقال له العباس : يا رسول الله ! مم ضحكت يا رسول الله ، أضحك الله سنك قال : أعجبني جمالك يا عم ، فقال العباس : يا رسول الله ! ما الجمال في الرجل ؟ قال : اللسان ) . ( كر ) .(@)(@@)(@@)(@@) $ 12614 عن العباس بن عبد المطلب رضي الله عنه قال : ( كنت عند النبي عند وفاته ، فجعلت سكرة الموت تذهب به طويلا ، ثم سمعته يهمس : { مع الذين أنعم الله عليهم من النبيين والصديقين والشهداء والصالحين وحسن أولئك رفيقا } ، ثم يغلب عليه ، ثم يعود فيقول مثلها ، ثم قال : أوصيكم بالصلاة ، أوصيكم بما ملكت أيمانكم ، ثم قضى عندها ) ، ( كر ) .(@)(@@)(@@)(@@) $ 12615 عن العباس بن عبد المطلب رضي الله عنه قال : ( دخلت على رسول الله وعنده نساء فيهن أسماء وهي تدق سعطة لها ، فقال : لا يبقى أحد في البيت شهد اللد إلا لد ، فإني قد أقسمت أن يميني لم تصب العباس ) . ( كر ) .(@)(@@)(@@)(@@) $ 12616 عن العباس بن عبد المطلب رضي الله عنه قال : ( قال لي رسول الله : يا عم لا تمش عريانا ) . ( ابن النجار ) .(@)(@@) PageV18P355(@)(@@)(@@)(@@) $ 12617 عن أبي اليسر قال : ( نظرت 
ms6367	 إلى العباس بن عبد المطلب رضي الله عنه يوم بدر وهو قائم وعيناه تذرفان ، فقلت : جزاك الله من ذي رحم شرا ، تقاتل ابن أخيك مع عدوه ؟ قال : مما فعل ، وهل أصابه القتل ؟ قلت : الله أعز له وأنصر من ذلك ، قال : ما تريد إلي ؟ قلت : استأسر ، فإن رسول الله نهى عن قتلك ، قال : ليست بأول صلته ، فأسرته ثم جئت به إلى رسول الله ) . ( كر ) .(@)(@@)(@@)(@@) $ 12618 عن أبي اليسر : ( أن عمر بن الخطاب رضي الله عنه نادى ، أو نادى مناد يوم بدر : يا رسول الله ! بأبي أنت البشرى قد سلم الله عمك العباس ! فكبر رسول الله وقال : بشرك الله بخير يا عمر في الدنيا والآخرة ، وسلمك يا عمر في الدنيا والآخرة ، اللهم أعن عمر وأيده ) . ( الديلمي ) .(@)(@@)(@@)(@@) $ 12619 عن عكرمة رضي الله عنه : ( أن النبي قال يوم بدر : من لقي منكم أحدا من بني هاشم فلا يقتله ، فإنهم أخرجوا كرها ) . ( ش ) .(@)(@@)(@@)(@@) $ 12620 عن مجاهد ، عن النبي : ( أنه لما أسر الأسارى يوم بدر ، أسر العباس رجل من الأنصار ، وقد أوعدوه أن يقتلوه ، فقال رسول الله : إني لم أنم الليلة من أجل العباس ، وقد زعمت الأنصار أنهم قاتلوه ، فقال عمر : ائتهم يا رسول الله ! فأتى الأنصار ، فقال : أرسلوا العباس ، قالوا : إن كان لرسول الله رضا فخذه ) . ( كر ) .(@)(@@)(@@)(@@) $ 12621 عن يحياى بن أبي كثير : ( لما كان يوم بدر أسر المسلمون من المشركين سبعين رجلا ، فكان ممن أسر عباس عم رسول الله ، فولي وثاقه عمر بن الخطاب ، فقال عباس : أما والله يا عمر ! ما يحملك على شد وثاقى إلا لطمي إياك في رسول الله ، فقال عمر رضي الله عنه : والله ! ما زادتك تلك علي إلا كرامة ، ولكن الله أمرني بشد الوثاق ، قال : فكان رسول الله PageV18P356 يسمع أنين العباس ، فلا يأتيه النوم ، فقالوا : يا رسول الله ! ما يمنهك من النوم ؟ فقال رسول الله : كيف أنام وأنا أسمع أنين عمي ، قال : فزعموا أن الأنصار أطلقوه من وثاقه ، وباتت تحرسه ) . ( كر ) .(@)(@@)(@@)(@@) $ 12622 عن مصعب بن شيبة ، عن أبيه قال : ( خرجت 
ms6368	 مع رسول الله يوم حنين ، والله ما خرجت إسلاما ، ولكني خرجت انفا أن تظهر هوازن على قريش ، فوالله ! إني لواقف مع رسول الله إذ قلت : يا نبي الله ! إني لأرى خيلا بلقا ، قال : يا شيبة ! إنه لا يراها إلا كافر ، فضرب بيده في صدري ، فقال : اللهم اهد شيبة ، ففعل ذلك ثلاثا ، فما رفع النبي يده عن صدري الثالثة حتى ما أحد من خلق الله تعالى أحب إلي منه ، فالتقى المسلمون ، فقتل من قتل ، ثم أقبل النبي وعمر رضي الله عنه آخذ باللجام ، والعباس آخذ بالثفر ، فنادى العباس رضي الله عنه : أين المهاجرون ؟ أين أصحاب سورة البقرة ، بصوت عال ؟ هذا رسول الله ، فأقبل الناس والنبي يقول قدمناها :(@)(@@) [ شعأنا النبي لا كذب [ ع(@)(@@) أنا ابن عبد المطلب [ / شع(@)(@@) فأقبل المسلمون فاصطكوا بالسيوف ، فقال النبي : الآن حمي الوطيس ) . ( كر ) .(@)(@@)(@@)(@@) $ 12623 عن عبادة بن الصامت قال : ( أخذ العباس رضي الله عنه بعنان دابة رسول الله يوم حنين حين انهزم المسلمون ، فلم يزل آخذا بعنان دابته حتى نصر الله رسوله وهزم المشركون ) . ( الزبير بن بكار ، كر ) .(@)(@@)(@@)(@@) $ 12624 عن العباس بن عبد المطلب رضي الله عنه قال : ( شهدت مع PageV18P357 رسول الله يوم حنين ، وما معه إلا أنا وأبو سفيان بن الحارث ، فلزمنا النبي فلم نفارقه ، وهو على بغلة شهباء ، وأنا آخذ بلجامها أكفها ، وهو لا يألو ما أسرع نحو المشركين ، فقال لي : ناد أصحاب السمرة ، فأقبل المسلمون فنظر وهو كالمتطاول إلى قتالهم ، فقال هذا حين حمي الوطيس ، ثم أخذ حصيات فرمى بها وجوههم ، وقال : هزموا ورب الكعبة ، فهزمتهم الله تعالى ، فكأني أنظر إلى النبي خلفهم يركض على بغلته ) . ( العسكري في الأمثال ) .(@)(@@)(@@)(@@) $ 12625 عن العباس بن عبد المطلب رضي الله عنه قال : ( ولد النبي مختونا مسرورا ، قال : وأعجب عبد المطلب وحظي عنده وقال : ليكونن لابني هذا شأن ، فكان ) . ( ابن سعد ) .(@)(@@)(@@)(@@) $ 12626 عن العباس رضي الله عنه قال : ( جئت أنا وعلي رضي الله عنهما إلى النبي ، فلما رانا قال : بخ لكما ! أنا سيد ولد آدم ، وأنتما سيدا العرب 
ms6369	 ) . ( كر ) .(@)(@@)(@@)(@@) $ 12627 عن أسلم : ( أن عمر بن الخطاب رضي الله عنه قال للعباس بن عبد المطلب : إني سمعت رسول الله يقول : نزيد في المسجد ، ودارك قريبة من المسجد ، فأعطناها نزدها في المسجد ، وأقطع لك أوسع منها ، قال : لا أفعل ، قال : إذن أغلبك عليها ، قال : ليس ذاك لك ، فاجعل بيني وبينك من يقضي بالحق ، قال : ومن هو ؟ قال : حذيفة بن اليمان ، فجاؤوا إلى حذيفة فقصوا عليه ، فقال حذيفة : عندي في هذا خبر ، قال : وما ذاك ؟ قال : إن داود عليه السلام أراد أن يزيد في بيت المقدس ، وقد كان بيت قريب من المسجد ليتيم ، فطلب إليه فأبى ، فأراد داود أن يأخذها منه ، فأوحى الله إليه أن أنزه البيوت عن الظلم لبيتي ، فتركه ، فقال له العباس : فبقي شيء ؟ قال : لا ، فدخل المسجد فإذا ميزاب للعباس رضي الله عنه شارع في مسجد رسول الله PageV18P358 يسيل ماء المطر منه في مسجد رسول الله ، فقام عمر بيده فقلع الميزاب ، فقال : هذا الميزاب لا يسيل في مسجد رسول الله ، فقال له العباس : والذي بعث محمدا بالحق ! إنه هو الذي وضع هذا الميزاب في هذا المكان ، ونزعته أنت يا عمر ! فقال عمر : ضع رجليك على عنقي لنرده إلى ما كان ، ففعل ذلك العباس ، ثم قال العباس : قد أعطيتك الدار تزيدها في مسجد رسول الله ، فزادها عمر في المسجد ، ثم قطع للعباس دارا أوسع منها بالزوراء ) . ( ك ، كر ، وأورد ، ك ، هق ، له شاهدا ) .(@)(@@)(@@)(@@) $ 12628 عن سعيد بن المسيب : ( أن عمر رضي الله عنه لما أراد أن يزيد قال : فذكر الحديث بنحوه وتمامه عند ( خط ، في المتفق كر ، في المسجد أراد أن يأخذ من العباس داره ، فقال : لا أبيعها . قال : إذن آخذها منك ، قال : ليس ذاك لك ، قال : فاجعل بيني وبينك أبي بن كعب ، فجعل بينهما فقضى بها للعباس ، قال : أما إذ قضيت بها لي فهي للمسلمين صدقة ) .(@)(@@)(@@)(@@) $ 12629 عن أنس : ( أن عمر بن الخطاب رضي الله عنه كان إذا قحطوا استسقى بالعباس بن عبد المطلب رضي الله عنه ، فقال 
ms6370	 : اللهم ! إنا كنا إذا قحطنا على عهد نبينا نتوسل إليك بنبينا فتسقينا ، وإنا نتوسل إليك اليوم بعم نبينا فاسقنا ، فيسقون ) . ( خ ، وابن سعد وابن خزيمة وأبو عوانة ، حب ، طب ، هق ) .(@)(@@)(@@)(@@) $ 12630 عن ابن عمر رضي الله عمر رضي الله عنهما قال : ( استسقى عمر بن الخطاب رضي الله عنه عام الرمادة بالعباس بن عبد المطلب فقال : اللهم ! هذا عم نبيك نتوجه إليك به فاسقنا ، فما برحوا حتى سقاهم الله ، فخطب عمر الناس فقال : أيها الناس ! إن رسول الله كان يرى للعباس ما يرى الولد لوالده ، يعظمه ويفخمه ويبر قسمه ، فاقتدوا أيها الناس برسول الله في عمه PageV18P359 العباس ، واتخذوه وسيلة إلى الله عز وجل فيما نزل بكم ) . ( ك ، والبانياسي في جزئه ، كر ، وابن النجار ) .(@)(@@)(@@)(@@) $ 12631 عن عبد الله بن عباس رضي الله عنهما قال : ( كان للعباس ميزاب على طريق عمر رضي الله عنه فلبس عمر ثيابه يوم الجمعة ، وقد كان ذبح للعباس فرخان ، فلما وافى الميزاب صب فيه من دم الفرخين فأصاب عمر ، فأمر عمر بقلعه ، ثم رجع فطرح ثيابه ولبس غيرها ، ثم جاء فصلى بالناس ، فأتاه العباس فقال : والله إنه للموضع الذي وضعه فيه رسول الله ! فقال عمر للعباس رضي الله عنه : عزمت عليك لما صعدت على ظهري حتى تضعه في الموضع الذي وضعه فيه رسول الله ! ففعل ذلك العباس ) . ( ابن سعد ، حم ، كر ) .(@)(@@)(@@)(@@) $ 12632 عن سالم أبي النضرر قال : ( لما كثر المسلمون في عهد عمر رضي الله عنه ضاق بهم المسجد ، فاشترى عمر ما حول المسجد من الدور إلا دار العباس بن عبد المطلب وحجر أمهات المؤمنين رضي الله عنهن ، فقال عمر للعباس : يا أبا الفضل ! إن مسجد المسلمين قد ضاق بهم ، وقد ابتعت ما حوله من المنازل نوسع به على المسلمين في مسجدهم إلا دارك وحجر أمهات المؤمنين ، فأما حجر أمهات المؤمنين فلا سبيل إليها ، وأما دارك فبعنيها بما شئت من بيت مال المسلمين أوسع بها في مسجدهم ! فقال العباس رضي الله عنه : ما كنت لأفعل ، قال : فقال له 
ms6371	 عمر : اختر مني إحدى ثلاث : إما أن تبيعنيها بما شئت من بيت مال المسلمين ، وإما أن أخطك حيث شئت من المدينة وأبنيها لك من بيت مال المسلمين ، وإما أن تصدق بها على المسلمين فتوسع بها في مسجدهم فقال : لا ، ولا واحدة منها ، فقال عمر رضي الله عنه : اجعل بيني وبينك من شئت ، فقال : أبي بن كعب ، فانطلقا إلى أبي فقصا عليه القصة ، فقال PageV18P360 أبي رضي الله عنه : إن شئتما حدثتكما بحديث سمعته من رسول الله ! فقالا : حدثنا ! فقال : سمعت رسول الله يقول : إن الله أوحى إلى داود أن ابن لي بيتا أذكر فيه ، فخط له هذه الخطة ، خطة بيت المقدس ، فإذا تربيعها يزريه بيت رجل من إسرائيل ، فسأله داود أن يبيعه إياه فأبى ، فحدث داود عليه السلام نفسه أن يأخذه منه ، فأوحى الله إليه : يا داود ! أمرتك أن تبني لي بيتا أذكر فيه ، فأردت أن تدخل في بيتي الغصب ، وليس من شأني الغصب ، وإن عقوبتك أن لا تبنيه ؛ قال : يا رب ! فمن ولدي ؟ قال : من ولدك . فأخذ عمر رضي الله عنه بمجامع ثياب أبي بن كعب وقال : جئتك بشيء فجئت بما هو أشد منه ، لتخرجن مما قلت ، فجاء يقوده حتى أدخله المسجد ، فأوقفه على حلقة من أصحاب رسول الله ت فيهم أبو ذر رضي الله عنه ، فقال : إني نشدت الله رجلا سمع رسول الله يذكر حديث بيت المقدس حين أمر الله داود أن يبنيه إلا ذكره ! فقال أبو ذر : أنا سمعته من رسول الله ، وقال آخر : أنا سمعته ، وقال آخر : أنا سمعته يعني من رسول الله ، قال : فأرسل أبيا ، وقال : وأقبل أبي على عمر رضي الله عنه فقال : يا عمر ! أتتهمني على حديث رسول الله فقال عمر : يا أبا المنذر ! لا والله ما اتهمتك عليه ، ولكني كرهت أن يكون الحديث عن رسول الله غير ظاهر ، وقال عمر للعباس رضي الله عنهما : اذهب فلا أعرض لك في دارك ! فقال العباس : أما إذ فعلت هذا ، فأنا قد تصدقت بها على المسلمين أوسع 
ms6372	 بها عليهم في مسجدهم ، فأما وأنت تخاصمني فلا ، فخط عمر له داره التي هي له اليوم ، وبناها من بيت مال المسلمين ) . ( ابن سعد ، كر ، وسنده صحيح إلا أن سالما أبا النضر لم يدرك عمر رضي الله عنه ) .(@)(@@)(@@)(@@) $ 12633 عن ابن عباس رضي الله عنه قال : ( كانت للعباس بن PageV18P361 عبد المطلب دار بالمدينة إلى جنب المسجد ، فقال عمر رضي الله عنه : هبها لي أو بعنيها حتى أدخلها في المسجد ، فأبى ، قال : فاجعل بيني وبينك رجلا من أصحاب رسول الله ، فجعلا أبيا بن كعب رضي الله عنه بينهما ، قال : فقضى أبي على عمر ، قال : فقال عمر : ما من أصحاب رسول الله أحد أجرأ علي من أبي ، قال : أو أنصح لك مني يا أمير المؤمنين ! أما علمت قصة المرأة أن داود لما بنى بيت المقدس أدخل فيه بيت امرأة بغير إذنها ، فلما بلغ حجز الرجاب منع بناءه ، فقال : أي رب ! إذ منعتني بناءه فاجعله في عقبي من بعدي ، فلما كان بعد قال له العباس : أليس قد قضيت لي بها ؟ قال : بلى ، قال : فهي لك قد جعلتها لله ) . ( ابن سعد ويعقوب بن سفيان ، ق ، كر ، وسنده حسن ) .(@)(@@)(@@)(@@) $ 12634 عن أبي جعفر محمد بن علي : ( أن العباس جاء إلى عمر رضي الله عنه فقال له : إن النبي أقطعني البحرين ، قال : من يعلم ذلك ؟ قال : المغيرة بن شعبة ، فجاء به فشهد له ، قال : فلم يمض له عمر رضي الله عنه ذاك كأنه لم يقبل شهادته ، فأغلظ العباس لعمر ، فقال عمر : يا عبد الله ! خذ بيد أبيك ، وقال عمر : والله يا أبا الفضل ! لأنا بإسلامك كنت أسر مني بإسلام الخطاب لو أسلم لمرضاة رسول الله ) . ( ابن سعد وابن راهوية ) .(@)(@@)(@@)(@@) $ 12635 عن موسى بن عمر قال : ( أصاب الناس قحط فخرج عمر بن الخطاب رضي الله عنه يستسقي ، فأخذ بيد العباس رضي الله عنه فاستقبل به القبلة ، فقال : هذا عم نبيك جئننا نتوسل به إليك فاسقنا ، قال : فما رجعوا حتى سقوا ) . ( ابن سعد ) .(@)(@@)(@@)(@@) $ 12636 عن عبد الرحمن بن حاطب 
ms6373	 قال : ( رأيت عمر آخذا بيد العباس PageV18P362 رضي الله عنهما فقام به فقال : اللهم ! إنا نستشفع بعم رسولك إليك ) . ( ابن سعد ) .(@)(@@)(@@)(@@) $ 12637 عن الأحنف بن قيس قال : ( سمعت عمر بن الخطاب رضي الله عنه يقول : إن قريشا رؤوس الناس ، لا يدخل أحد منهم في باب إلا دخل معه فيه طائفة من الناس ، فلم أدر ما تأويل قوله في ذلك حتى طعن ، فلما احتضر أمر صهيبا أن يصلي بالناس ثلاثة أيام ، وأمر أن يجعل للناس طعام فيطعموا حتى يستخلفوا إنسانا ، فلما رجعوا من الجنازة جيء بالطعام ووضعت الموائد ، فأمسك الناس عنها للحزن الذي هم فيه ، فقال العباس بن عبد المطلب رضي الله عنه : أيها الناس ! إن رسول الله قد مات فأكلنا بعده وشربنا ، ومات أبو بكر رضي الله عنه فأكلنا بعده وشربنا ، وإنه لا بد من الأجل فكلوا من هذا الطعام ، ثم مد العباس يده فأكل ، ومد الناس أيديهم فأكلوا ، فعرفت قول عمر رضي الله عنه : إنهم رؤوس الناس ) . ( ابن سعد وابن منيع وأبو بكر في الغيلانيات ، كر ) .(@)(@@)(@@)(@@) $ 12638 عن عامر الشعبي أن العباس تحفى عمر رضي الله عنه في بعض الأمر فقال له : ( يا أمير المؤمنين ! أرأيت لو جاءك عم موسى عليه السلام مسلما ما كنت صانعا به ؟ قال : كنت والله محسنا إليه ، قال : فأنا عم محمد النبي ! قال : وما رأيك يا أبا الفضل ؟ فوالله لأبوك أحب إلي من أبي ! قال : الله الله ! لأني كنت أعلم أنه أحب إلى رسول الله من أبي فإني أوثر حب رسول الله على حبي ) . ( ابن سعد ) .(@)(@@)(@@)(@@) $ 12639 عن الحسن رضي الله عنه قال : ( بقي في بيت المال على عهد PageV18P363 عمر رضي الله عنه شيء بعد ما قسم بين الناس ، فقال العباس لعمر وللناس : أرأيتم لو كان فيكم عم موسى عليه السلام أكنتم تكرمونه ؟ قالوا : نعم ، قال : فأنا أحق به أنا عم نبيكم ، فكلم عمر الناس ، فأعطوه تلك البقية التي بقيت ) . ( ابن سعد ، كر ) .(@)(@@)(@@)(@@) $ 12640 عن العباس بن عبد الله بن معبد قال : ( لما دون عمر 
ms6374	 بن الخطاب رضي الله عنه الديوان ، كان أول من بدأ به في المدعى بن هاشم ، ثم كان أول بني هاشم يدعى العباس بن عبد المطلب في ولاية عمر وعثمان رضي الله عنهما ) . ( ابن سعد ) .(@)(@@)(@@)(@@) $ 12641 عن ابن عباس رضي الله عنهما قال : ( كان النبي إذا جلس جلس أبو بكر رضي الله عنه عن يمينه ، فأبصر أبو بكر العباس بن عبد المطلب رضي الله عنه يوما مقبلا ، فتنحى له عن مكانه ولم يره النبي ، فقال النبي : ما نحاك يا أبا بكر ؟ فقال : هذا عمك يا رسول الله ! فسر بذلك النبي حتى رؤي ذلك في وجهه ) . ( كر ؛ ولم أر في سنده من تكلم فيه ) .(@)(@@)(@@)(@@) $ 12642 عن ابن عباس رضي الله عنهما : ( أن رجلا وقع في قرابة للعباس كان في الجاهلية فلطمه العباس ، فجاء قومه فقالوا : والله لنلطمنه كما لطمه ، فقال النبي : العباس مني وأنا منه ، لا تسبوا أمواتنا فتؤذوا أحياءنا ) . ( كر ) .(@)(@@)(@@)(@@) $ 12643 عن ابن عباس رضي الله عنه : ( أن رجلا وقع في أب للعباس كان في الجاهلية ، فلطمه العباس ، فجاء قومه فقالوا : والله لنلطمنه كما لطمه ! حتى لبسوا السلاح ، فبلغ ذلك رسول اله فغضب ، فجاء فصعد المنبر فقال : من أنا ؟ فقالوا : أنت رسول الله ، قال : فإن عم الرجل صنو أبيه ، لا تسبوا أمواتنا فتؤذوا أحياءنا ، فقالوا : يا رسول الله ! نعوذ بالله من غضبك ، فاستغفر لنا ! فاستغفر لهم ) . ( كر ) .(@)(@@) PageV18P364(@)(@@)(@@)(@@) $ 12644 عن ابن عباس رضي الله عنهما : ( أن رجلا من الأنصار وقع في العباس كان في الجاهلية ) . ( حم )(@)(@@)(@@)(@@) $ 12645 عن ابن عباس رضي الله عنهما قال : ( قال العباس : يا رسول الله ! ما لنا في هذا الأمر ؟ قال : لي النبوة ، ولكم الخلافة ؛ بكم يفتح هذا الأمر ، وبكم يختم ؛ قال : وقال النبي للعباس رضي الله عنه : من أحبك نالته شفاعتي ، ومن أبغضك فلا نالته شفاعتي ) . ( كر ) .(@)(@@)(@@)(@@) $ 12646 عن ابن عباس رضي الله عنه قال : ( لما حاصر النبي الطائف ، خرج رجل من الحصن فاحتمل رجلا من أصحاب النبي لدخله الحصن ، فقال النبي : من يستنقذه فله الجنة ! فقام 
ms6375	 العباس رضي الله عنه فمضى ، فقال النبي : امض ومعك جبريل وميكائيل ، فمضى فاحتملهما جميعا حتى وضعهما بين يدي النبي ) . ( كر ) .(@)(@@)(@@)(@@) $ 12647 عن ابن عباس رضي الله عنهما قال : ( جاء العباس إلى النبي فقال : إنك قد تركت فينا ضغائن منذ صنعت الذي صنعت ! فقال النبي : لا يبلغون الخير أو قال : الإيمان حتى يحبوكم لله ولقرابتي ، أترجو سليم وهم حي من مراد شفاعتي ، ولا ترجو بنو عبد المطلب شفاعتي ) . ( كر ) .(@)(@@)(@@)(@@) $ 12648 عن ابن عباس رضي الله عنهما قال : ( جاء رسول الله إلى العباس يعوده ، فدخل عليه والعباس على سرير ، فأخذ بيد النبي فأقعده في مكانه ، فقال له النبي : رفعك الله يا عم ) . ( كر ) .(@)(@@)(@@)(@@) $ 12649 عن ابن عباس رضي الله عنهما قال : ( أمر النبي المهاجرين والأنصار أن يصفوا صفين ، ثم أخذ بيد علي وبيد العباس رضي الله عنهما ثم مشى بينهم ، ثم ضحك النبي ، فقال له علي : مم ضحكت يا رسول الله ؟ قال : إن جبريل أخبرني أن الله تعالى باهى بالمهاجرين والأنصار PageV18P365 أهل السماوات السبع ، وباهى بك يا علي وبك يا عباس حملة العرش ) . ( كر ) .(@)(@@)(@@)(@@) $ 12650 عن الأعمش ، عن الضحاك ، عن ابن عباس رضي الله عنهما قال : ( قال رسول الله : منا السفاح ، ومنا المنصور ، ومنا المهدي ) . ( كر ) .(@)(@@)(@@)(@@) $ 12651 عن المهدي أمير المؤمنين ، حدثني أبي ، عن أبيه ، عن جده ، عن ابن عباس رضي الله عنهما قال : ( والله ! لو لم يبق من الدنيا إلا يوم لأراك الله من بني أمية ! ليكونن منا السفاح والمنصور والمهدي ) . ( كر ) .(@)(@@)(@@)(@@) $ 12652 عن إبراهيم بن سعيد ، حدثنا المأمون ، حدثنا الرشيد ، حدثنا المهدي ، حدثنا المنصور ، حدثنا محمد بن علي ، عن أبيه علي بن عبد الله ، عن عبد الله بن عباس رضي الله عنهما أن النبي قال للعباس : ( إذا كان غداة يوم الاثنين فكن في منزلك حتى آتيك ؛ فغدا عليه النبي ملاءة له من الكتان والقطن ، فأخد بعضادتي الباب ، فقال : هل فيكم غيركم ؟ قالوا : لا ، يا رسول الله إلا موالينا ، قال : موالي القوم منهم ، فجمعنا إليه ، فقال : تدانوا ، فشملنا بملاءته ، ثم قال 
ms6376	 : اللهم ! هذا عمي وصنو أبي ، فاستره وولده من النار كستري إياهم بملاءتي هذه ! قال عبد الله بن عباس : فوالله لقد أمن كل شيء حتى أسكفة الباب ) . ( ابن النجار ) .(@)(@@)(@@)(@@) $ 12653 عن عائشة رضي الله عنها قالت : ( أتى العباس بن عبد المطلب رسول الله فقال : يا رسول الله ! إنا لنعرف الضغائن في أناس من وقائع أوقعناها ! فقال رسول الله : أما والله إنهم لا يبلغون خيرا حتى يحبوكم لقرابتي ! ثم قال رسول الله : ترجو سليم شفاعتي ولا يرجوها بنو عبد المطلب ) . ( كر ) .(@)(@@) PageV18P366(@)(@@)(@@)(@@) $ 12654 عن عائشة رضي الله عنها قالت : ( كان النبي جالسا مع أصحابه وبجنبه أبو بكر وعمر ، فأقبل العباس رضي الله عنه فأوسع له أبو بكر ، فجلس بين النبي وبين أبي بكر ، فقال النبي لأبي بكر : إنما يعرف الفضل لأهل الفضل أهل الفضل ، ثم أقبل العباس على النبي يحدثه ، فخفض النبي صوته شديدا ، فقال أبو بكر لعمر : قد حدث برسول الله علة قد شغلت قلبي ، فما زال العباس عند النبي حتى فرغ من حاجته وانصرف ، فقال أبو بكر : يا رسول الله ! حدثت بك علة الساعة ؟ قال : لا ، قال : فإني قد رأيتك قد خفضت صوتك شديدا ، قال : إن جبريل أمرني إذا حضر العباس أن أخفض صوتي كما أمركم أن تخفضوا أصواتكم عندي ) . ( كر ) .(@)(@@)(@@)(@@) $ 12655 عن ابن مسعود : ( أن النبي بعث عمر بن الخطاب رضي الله عنه ساعيا ، فمر بالعباس فأغلظ له ، فشكاه إلى النبي ، فقال النبي : يا عمر ! إن عم الرجل صنو أبيه ، وإنا قد تعجلنا من العباس صدقته لعامين ) . ( ابن جرير ) .(@)(@@)(@@)(@@) $ 12656 عن ابن مسعود رضي الله عنه قال : ( رأيت النبي انتشل يد العباس بن عبد المطلب رضي الله عنه قال : هذا عمي وصنو أبي ، وسيد عمومتي من العرب ، وهو معي في السنام الأعلى من الجنة ) . ( ابن النجار وفيه زكريا بن يحيى الرقاشي ) .(@)(@@)(@@)(@@) $ 12657 عن سعيد بن المسيب قال : ( قال رسول الله للعباس رضي الله عنه : يا أبا الفضل ! ألا أبشرك ؟ قال : بلى يا رسول الله ! قال : لو قدمت أعطاك الله حتى 
ms6377	 ترضى ) . ( عد ، كر ) .(@)(@@)(@@)(@@) $ 12658 عن الشعبي قال : ( إن العباس رضي الله عنه لو شهد بدرا ما فضله أحد من أصحاب محمد رأيا وعقلا ) . ( كر ) .(@)(@@) PageV18P367(@)(@@)(@@)(@@) $ 12659 عن ابن شهاب قال : ( لما قدم رسول الله من بدر ومعه العباس رضي الله عنه ، أتاه العباس فقال : يا رسول الله ! ائذن لي أن أرجع إلى مكة حتى أهاجر كما هاجر المهاجرون ، فقال رسول الله : اجلس أبا الفضل فأنت خاتم المهاجرين كما أنا خاتم النبيين ) . ( الروياني ، كر ) .(@)(@@)(@@)(@@) $ 12660 عن علي رضي الله عنه قال : ( قال رسول الله للعباس بن عبد المطلب رضي الله عنه : عمي وصنو أبي ، من شاء فليباه بعمه ) . ( أبو الحسن الجوهري في أماليه ) .(@)(@@)(@@)(@@) $ 12661 عن أنس رضي الله عنه قال : ( كانوا إذا قحطوا على عهد رسول الله استسقوا بالنبي فسقوا ، فلما كان بعد وفاة النبي في إمارة عمر قحطوا ، فأخرج عمر العباس رضي الله عنهما يستسقي به ، فقال : اللهم إنا كنا إذا قحطنا على عهد نبيك استسقينا به فسقينا ، وإنا نتوسل إليك بعم نبيك فاسقنا ! قال : فسقوا ) . ( كر ) .(@)(@@)(@@)(@@) $ 12662 عن صهيب قال : ( رأيت عليا يقبل يد العباس رضي الله عنه ورجله ) . ( خ ، في الأدب ، وابن المقري في الرخصة في تقبيل اليد ) .(@)(@@)(@@)(@@) $ 12663 عن ابن عباس قال : ( قال عمر للعباس رضي الله عنهما : أسلم ! فوالله لأن تسلم كان أحب إلي من اين يسلم الخطاب ! وما ذاك إلا ما رأيت رسول الله يحب أن يكون لك سبقا ) . ( كر ) .(@)(@@)(@@)(@@) $ 12664 عن ابن شهاب قال : ( أبو بكر وعمر في ولايتهما لا يلقى العباس رضي الله عنه منهما واحد وهو راكب إلا نزل عن دابته وقادها ، ومشى مع العباس حتى بلغه منزله أو مجلسه فيفارقه ) . ( كر ) .(@)(@@)(@@)(@@) $ 12665 عن عدي بن سهيل قال : ( لما استمد أهل الشام عمر PageV18P368 رضي الله عنه على أهل فلسطين ، استخلف عليا وخرج ممدا لهم ، فقال له علي رضي الله عنه : أين تخرج بنفسك ؟ إنك تريد عدوا كلبا ، فقال : إني أبادر بجهاد العدو قبل موت العباس رضي الله عنه ، إنكم لو فقدتم العباس لانتقض 
ms6378	 بكم الشر كما ينتقض الحبل . فمات العباس لست سنين خلت من إمارة عثمان رضي الله عنه ، فانتقض والله بالناس الشر ) . ( سيف ، كر ؛ وله حكم الرفع ) .(@)(@@)(@@)(@@) $ 12666 عن أبي وجزة السعدي عن أبيه قال : ( استسقى عمر بن الخطاب رضي الله عنه فقال : اللهم ! قد عجزت عنهم ، وما عندك أوسع لهم ، وأخذ بيد العباس رضي الله عنه فقال : هذا عم نبيك ، ونحن نتوسل به إليك ، فلما أراد عمر أن ينزل قلب رداءه ، ثم نزل ) . ( كر ) .(@)(@@)(@@)(@@) $ 12667 عن مسلم قال : ( رأيت عمر بن الخطاب رضي الله عنه بالمحصب ، فرأيته اضطجع ونظر في الأفق ، فسأله أصحاب له عن أشياء فلم يجب في ذلك شيئا ، فقالوا : أرقدت يا أمير المؤمنين ؟ قال : والله ! ما رقدت ، ولكن أشياء حدثتها نفسي حتى والله غمتني ، فنظرت في الأشياء كلها فإذا هي تمضي صعدا ، وتبدأ حتى إذا بلغت أناها رجعت فلم يكن شيء ، فتخوفت أن يكون هلك رسول الله ضعف الإسلام حتى يهلك العباس ) . ( الترقفي في جزئه ) .(@)(@@)(@@)(@@) $ 12668 عن القاسم بن محمد قال : ( كان مما أحدث عثمان رضي الله عنه فرضي به منه : أنه ضرب رجلا في منازعة استخف فيها بالعباس بن عبد المطلب رضي الله عنه ، فقيل له ، فقال : أيفخم رسول الله عمه ، وأرخص في الاستخفاف به ؟ لقد خالف رسول الله ، من رضي فعل ذلك ، فرضي به منه ) . سيف ( كر ) .(@)(@@) PageV18P369(@)(@@)(@@)(@@) $ 12669 عن جابر : ( أن رجلا أغلظ للعباس رضي الله عنه فغضب رسول الله وقال للرجل : أما علمت أن عم الرجل صنو أبيه ) . ( كر ) .(@)(@@)(@@)(@@) $ 12670 عن دحية الكلبي قال : ( قدمت من الشام فأهديت إلى النبي فاكهة يابسة من فستق ولوز وكعك فوضعته بين يديه ، فقال : اللهم ! ائتني بأحب أهلي إليك أو قال : إلي يأكل معي من هذا ! فطلع العباس رضي الله عنه ، فقال : ادن يا عم ! فإني سألت الله أن يأتيني بأحب أهلي إلي أو إليه يأكل معي من هذا فأتيت ، فجلس فأكل ) . ( كر ) .(@)(@@)(@@)(@@) $ 12671 عن سهل بن سعد الساعدي قال : ( لما قدم رسول الله من بدر استأذنه العباس رضي 
ms6379	 الله عنه أن يأذن له أن يرجع إلى مكة حتى يهاجر منها إلى رسول الله ، فقال رسول الله : اطمئن يا عم ! فإنك خاتم المهاجرين في الهجرة كما أنا خاتم النبيين في النبوة ) . الشاشي ، ( كر ) .(@)(@@)(@@)(@@) $ 12672 عن سهل بن سعد الساعدي قال : ( استأذن العباس رضي الله عنه النبي في الهجرة ، فكتب إليه : يا عم ! أقم مكانك الذي أنت به ، فإن الله تعالى قد ختم بك الهجرة كما ختم بي النبوة ) . ( ع ، طب ، وأبو نعيم في فضائل الصحابة ، كر ، وابن النجار ، ومدار الحديث على إسماعيل بن قيس بن سعد بن زيد بن ثابت ، ضعفوه ) .(@)(@@)(@@)(@@) $ 12673 عن سهل بن سعد قال : ( خرج النبي يوما بطريق مكة في يوم صائف قائظ ، شديد حره ، فنزل منزلا فدعا بماء ليغتسل ، فقام العباس بن عبد المطلب رضي الله بكساء من صوف فستره ، قال سهل : فنظرت إلى رسول الله من جانب الكساء وهو رافع رأسه وفي لفظ : يديه إلى السماء يقول : اللهم ! استر العباس وولد العباس من النار ) . ( الروياني والشاشي ، كر ) .(@)(@@) PageV18P370(@)(@@)(@@)(@@) $ 12674 عن سهل بن سعد قال : ( أقبل النبي من غزاة له في يوم حار ، فوضع له ماء في جفنة يتبرد به ، فجاء العباس رضي الله عنه فولاه ظهره وستره بكساء كان عليه ، فلما فرغ قال : من هذا ؟ قال : عمك العباس ! فرفع يديه إلى السماء حتى اطلعنا عليه من الكساء وفي لفظ : حتى طلع علينا من الكساء وقال : سترك الله يا عم وستر ذريتك من النار ) . ( الروياني ) .(@)(@@)(@@)(@@) $ 12675 حدثنا ابن إسحاق ، حدثنا أبو صالح شعيب ابن سلمة ( ع ) ، حدثنا شعيب ، حدثنا إسماعيل بن قيس ، عن أبي حازم عنه ( كر ) عن أبي رافع قال : ( بشرت النبي بإسلام العباس رضي الله عنه فأعتقني ) . ( كر ) .(@)(@@)(@@)(@@) $ 12676 عن محمد بن عبيد الله بن أبي رافع ، عن أبيه ، عن جذه قال : ( قال رسول الله للعباس رضي الله عنه : ( ولك يا عم من الله حتى ترضى ) . ( كر ) .(@)(@@)(@@)(@@) $ 12676 عن محمد بن عبيد الله بن أبي رافع ، عن أبيه ، عن جذه قال : ( قال رسول الله 
ms6380	 للعباس رضي الله عنه : ( ولك يا عم من الله حتى ترضى ) . ( كر ) .(@)(@@)(@@)(@@) $ 12677 عن أبي رافع قال : ( بعث النبي عمر ساعيا على الصدقة ، فأتى العباس رضي الله عنه يطلب صدقة ماله ، فأغلظ له ، فأتى النبي فذكر له ذلك ، فقال له النبي : أما علمت أن عم الرجل صنو أبيه ؟ إن العباس أسلفنا صدقة العام عام أول ) . ( كر ) .(@)(@@)(@@)(@@) $ 12678 عن أبي هياج ، عن أبيه أبي سفيان بن الحارث قال : ( اليوم علمت أن العباس رضي الله عنه سيد العرب بعد رسول الله ، وأنه أعظم الناس منزلة عند رسول الله حين أخطر قريشا بأصلها فقال : لئن قتلوه لا أستبقي منهم أحدا أبدا ، وقال في حمزة رضي الله عنه حين قتل ومثل به : لئن بقيت لأمثلن بثلاثين من قريش ! وقال المكثر سبعين ) . ( كر ) .(@)(@@)(@@)(@@) $ 12679 عن عبد الله بن عباس رضي الله عنهما قال : ( قيل للعباس : PageV18P371 أنت أكبر أم رسول الله ؟ فقال : هو أكبر مني وأنا ولدت قبله ) . ( كر ، وابن النجار ) .(@)(@@)(@@)(@@) $ 12680 عن العباس قال : ( جئت أنا وعلي إلى النبي ، فلما رآنا قال : بخ لكما ! أنا سيد ولد آدم وأنتما سيدا العرب ) . ( كر ) .(@)(@@)(@@)(@@) $ 12681 عن إسحاق بن إبراهيم بن عبد الله بن حارثة بن النعمان ، عن أبيه ، عن عبد الله بن حارثة قال : ( لما قدم صفوان بن أمية بن خلف المدينة أتى النبي ، فقال له النبي : على من نزلت يا أبا وهب ؟ قال : على العباس بن عبد المطلب رضي الله عنه ، قال : نزلت على أشد قريش لقريش حياء ) . ( يعقوب بن سفيان ، كر ) .(@)(@@)(@@)(@@) $ 12682 عن ابن مسعود رضي الله عنه قال : ( بعث رسول الله عمر بن الخطاب رضي الله عنه ساعيا على صدقة ، فأول من لقيه العباس بن عبد المطلب ، فقال له : يا أبا الفضل هلم صدقة مالك ، فقال له : كيت وكيت ! وأغلظ له في القول ، فقال له عمر : أما والله لولا الله ومنزلتك من رسول الله لكافيتك ببعض ما كان منك ! فافترقا ، وأخذ هذا في طريق وهذا في طريق ، فجاء عمر حتى دخل على علي بن 