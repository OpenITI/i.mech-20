ms121	 % % إلى منتهى الإفكار من موضع السر % 38(@)(@@) % نعد لها نقل الفكاهة والحجى ، % ونجلو عليها بهجة النظم والنثر % 39(@)(@@) % ونحن نوفي العيش باللهو حقه ، % ونسرق ساعات السرور من العمر % 40(@)(@@) % وقد عمنا فصل الربيع بفضله ، % فبادرنا بالورد في أول القطر % PageV01P442 41(@)(@@) % فيا أيها المولى الذي وصف فضله % يجل عن التعداد والحدذ والحصر % 42(@)(@@) % أبثك بالأشعار فرط تشوقي ، % ولا أتعاطى حصر وصفك بالشعر % 43(@)(@@) % وأعجب شيء أنني مع تيقظي ، % إلى مخلص الألفاظ من شرك الهجر % 44(@)(@@) % أسوق إلى البحر الخضم جواهري ، % وأهدي إلى أبناء بابل من سحري % % 45(@)(@@) % فمن ، فدتك النفس ، بالعذر منعما % عليذ ، وشاور حسن رأيك في الأمر % PageV01P443 البحر : كامل تام 1(@)(@@) % من لي بقربك ، والمزار عزيز ، % طوبى لمن يحظى به ويفوز % 2(@)(@@) % فلو استطعت رفعت حالي نحوكم ، % لكن رفع الحال ليس يجوز % 3(@)(@@) % يا أيها الشيخ الذي آراؤه % جرز لنا ، في النائبات ، حريز % 4(@)(@@) % عرض العروض فلم ترعك دوائر % منه ولم تشكل عليك رموز % 5(@)(@@) % وكذا اقتفت من القوافي إثرها ، % فأطاعك المقصور والمهموز % 6(@)(@@) % وضربت نحو النحو همة أوحد ، % أضحى له في حاله تمييز % 7(@)(@@) % لو كنت جئت به قديما لم يكن % فيه لتبريز لها تبريز % 8(@)(@@) % ولقد هززت إليك دوح قريحتي ، % مدحا ، فأينع دوحها المهزوز % 9(@)(@@) % وسبكت مدحك في بواطق فكرتي ، % إذ في البواطق يسبك الإبريز % 10(@)(@@) % صغت القريض ، ولم أقله تكلفا ، % لكنه طبع لدي عزيز % PageV01P444 11(@)(@@) % ألجو عليك من القريض عرائسا ، % من خدر أبكاري لهن بروز % 12(@)(@@) % أبكار أفكار تزف كواعبا ، % لا كالعقار تزف وهي عجوز % PageV01P445 البحر : خفيف تام 1(@)(@@) % أترى البارق ، الذي لاح ليلا ، % مر بالحيذ من مرابع ليلي % % 2(@)(@@) % وترى السحب مذ نشأن ثقالا ، % سحبت في ربوع بابل ذيلا % % 3(@)(@@) % ما أضا البارق العراقي ، إلا % أرسلت مقلتي من الدمع سيلا % % 4(@)(@@) % وتذكرت جيرة بمغاني % % ه وندبا من آل سنبس قيلا % % 5(@)(@@) % عمنا بالوداد في حالة القر % ب ، وأهدى لنا على البعد نيلا % % 6(@)(@@) % وحملنا بضاعة الشكر مزجا % % ة ، فأوفى لنا من الود كيلا % % 7(@)(@@) % كيف أنسى 
ms122	 تلك الديار ومغنى % عامرا قد ربيت فيه طفيلا % % 8(@)(@@) % أتمنى العراق في أرض حرا % % ن ، وهل تدرك الثريا سهيلا % % 9(@)(@@) % يا ديار الأحباب ما كان أهنى ، % بمغانيك ، عيشنا ، وأحيلى % % 10(@)(@@) % كم جلونا بأفقك البدر صبحا ، % واجتلينا بجوك الشمس ليلا % % PageV01P446 11(@)(@@) % وأمنا الأعداء لما جعلنا % % سور تلك الديار رجلا وخيلا % % 12(@)(@@) % انتدي في حماك كعبا ، ومغنى ، % وإذا ئشت سنبسا وعقيلا % % 13(@)(@@) % أورد العيس نهر عيسى وطورا % أورد الخيل دجلة ودجيلا % % 14(@)(@@) % إن وردت الهيجاء يا سائق العي % % س ، وشارفت دوحها والنخيلا % % 15(@)(@@) % ورأيت البدور في مشهد الشم % % س بفتيان بانة والأثيلا % % 16(@)(@@) % مل إليها واحبس قليلا عليها ، % إن لي نحو ذلك الحي ميلا % % 17(@)(@@) % وأبلغ الرملة الأنيقة وابلغ % معشرا لي بربعها وأهيلا : % 18(@)(@@) % كنت جلدا ، فلم يدع بينكم لل % % جسم حولا ولا لقلبي حيلا % % 19(@)(@@) % قد ذممنا بعيد بعدكم العي % % ش ، فليت الحمام كان قبيلا % % PageV01P447 البحر : بسيط تام 1(@)(@@) % أطعت داعي الهوى رغما على العاصي ، % لما نزلنا على ناعورة العاصي % % 2(@)(@@) % وبات لي بمغاني أهلها ، وبها % % شغلان عن أهل شعلان وبغراص % 3(@)(@@) % والريح تجري رخاء فوق جدولها ، % والطير ما بين بناء وغواص % 4(@)(@@) % وقد تلاقت فروع الدوح ، واشتبكت % كأنذما الطير منها فوق أقفاص % 5(@)(@@) % تدار ما بيننا حمرا صافية ، % كانت هدايا يزيد من بني العاص % 6(@)(@@) % مع شادن رب أقراط ومنطقة ؛ % وقينة ذات أحجال وأخراص % 7(@)(@@) % تدنيه كفي ، فيثني جيده مرحا ، % كأنه جؤذر في كف قناص % 8(@)(@@) % وكم لدينا بها شاد وشادية % تشجي ، وراقصة تعصو ورقاص % 9(@)(@@) % إذا ثناها نسيم الرقص من مرح ، % عجبت من هز أغصان وأدعاص % 10(@)(@@) % يا قاطع البيد يطويها على نجب ، % لم تبق منها الفيافي غير أشخاص % PageV01P448 11(@)(@@) % إذا وردت بها شاطي الفرات ، وقد % % نكبت عن ماء حوران وقياص % 12(@)(@@) % وجزت بالحلة الفيحاء ملتمحا % آرام سرب حمتها أسد عياص % 13(@)(@@) % فقف بسعديها المشكور منشأه ، % سعد بن مزيد لا سعد بن وقاص % 14(@)(@@) % واقر السلام على من حل ساحته ، % وصف ثنائي وأشواقي وإخلاصي % % 15(@)(@@) % واخبر بأني ، وإن أصبحت 
ms123	 مبتنيا % مجدا وأغلي قدري بعد إرخاصي % % 16(@)(@@) % صاب إلى نحوكم صب بحبكم ، % محافظ الود للداني وللقاصي % % PageV01P449 البحر : خفيف تام 1(@)(@@) % تركتنا لواحظ الأتراك ، % بين ملقى شاكي السلاح وشاك % 2(@)(@@) % حركات بها سكون فتور % تترك الأسد ما بها من حراك % 3(@)(@@) % ملكتني خزر العيون ، وإن خل % % ت بأني لها من الملاك % 4(@)(@@) % كل ظبي في أسر رقي ، ولكن % ما لأسري في حبه من فكاك % 5(@)(@@) % أين حسن الأعراب من حسن أسد % % أفرغت في قوالب الأملاك % 6(@)(@@) % فإذا غوزلوا ، فآرام سرب ، % أخذوا ثار من ذكي بالمذاكي % % 7(@)(@@) % كل طفل يجل أن يحكي البد % % ر ، ولكن له البدور تحاكي % % 8(@)(@@) % بثغور لم يعلها قشف النح % % ل ، . ولم تجلها يد بسواك % 9(@)(@@) % وعيون كأنما الغنج فيها % % رائد الحتف ، أو نذير الهلاك % 10(@)(@@) % وقدود كأنما شد عقد ال % % بند منها على قضيب أراك % PageV01P450 11(@)(@@) % كدت أنجو من القدود ولكن % % أدركتني فيها بطعن دراك % 12(@)(@@) % قل لساجي العيون قد سلبت عي % % ناك قلبي ، وافرطت في انهاكي % % 13(@)(@@) % فابق لي خاطرا به أسبك النظ % % م وأثني على فتى السباك % 14(@)(@@) % حاكم مهد القضاء بقلب % ثاقب الفهم نافذ الإدراك % 15(@)(@@) % فكرة تحت منتهى درك الأر % % ض وعزم في ذروة الأفلاك % 16(@)(@@) % مذ دعته الأيام للدين تاجا % حسد الدين فيه هام السماك % 17(@)(@@) % رتبة جاوزت مقام ذوي العل % % م ، وفاقت مراتب النساك % 18(@)(@@) % ذو يراع راع الحوادث لما % % أضحك الطرس سعيه وهو باك % 19(@)(@@) % بمعان لو كن في سالف العص % % ر لسكت مسامع السكاك % 20(@)(@@) % زاد قدري بحبه ، إذ رأى النا % % س التزامي بحبه وامتساكي % % PageV01P451 21(@)(@@) % مذهب ما ذهبت عنه ودين % ما تعرضت فيه للإشراك % 22(@)(@@) % أيها الأروع الذي لفظه وال % % فضل بين الأنام زاه وزاك % 23(@)(@@) % إن تغب عن لحاظ عيني ، فللقل % % ب لحاظ سريعة الإدراك % 24(@)(@@) % لم تغب عن سوى عيوني ، فقلبي % % شاكر عن علاك ، والطرف شاك % PageV01P452 البحر : خفيف تام 1(@)(@@) % سلبتنا فواتك اللفتات ، % إذ سبقنا بالخيف كل فتاة % 2(@)(@@) % فجهلنا الهوى ، ولم ندر أن الأ % سد 
ms124	 تغدو فرائس الغادات % 3(@)(@@) % بجفون ، لها فتور ذوي السك % % ر على ضعفها وفتك الصحاة % 4(@)(@@) % وعيون في لحظهن سكون ، % هو في الفتك أسرع الحركات % 5(@)(@@) % قل لذات الجمال إذ رمت إنجا % % ز عداتي ، فأصبحت من عداتي % % 6(@)(@@) % يا شبيه القناة ش قدا ولينا ، % إن ليلي في طول ظل القناة % 7(@)(@@) % بعدما كان من وصالك في الغم % % ض قصيرا ، شبيه ظفر القطاة % 8(@)(@@) % ودياري ما بين دجلة والصي % % رة ، لا بين دجلة والصراة % % 9(@)(@@) % وورودي من عين دجلة والفر % % دوس ، لا نهر بنة والفراة % 10(@)(@@) % بين قوم لست الملوم ، إذا أذ % % هبت نفسي عليهم حسرات % PageV01P453 11(@)(@@) % وارتشافي من خمر فيك وقلبي % % آمن من طوارق الحادثات % 12(@)(@@) % لست أخشى مع رشف فيك من الحت % % ف لأني وردت عين الحياة % 13(@)(@@) % من فم ما رشفت ، قبل ثنايا % % ه ، جمانا منضدا في لثات % 14(@)(@@) % لا أرى غير فيك أجدر بالتق % % بيل ، إلا أكف قاضي القضاة % 15(@)(@@) % ذي المعالي فتى المهذب شمس الد % ين رب المناقب الباهرات % 16(@)(@@) % حاكم رأيه ، إذا أشكل الأم % % ر ، سراج في ظلمة المشكلات % 17(@)(@@) % ذو علوم ، إذا تلاطم موج الش % % ك كانت للخصم سفن النجاة ش % % 18(@)(@@) % لو أعار الظلام أخلاقه الغ % % ر لأغنت به عن النيرات % 19(@)(@@) % قرنت كفه الإجادة بالجو % % د ، وحسن الخلال بالحسنات % 20(@)(@@) % كلما جمعت شمائله الفض % % ل تداعت أمواله بالشتات % PageV01P454 21(@)(@@) % ذو يراع يبدي إذا أمطر الطر % % س رياضا أنيقة الزهرات % 23(@)(@@) % بمعان تضيء في ظلمة الحب % % ر شيبة الكواكب الزاهرات % 24(@)(@@) % أخبرتنا عذوبة اللفظ منها % % أن عين الحياة في الظلمات % 25(@)(@@) % أيها المرسل الي آمن النا % % س بآيات فضله البينات % 26(@)(@@) % كم صيام قرنته بقيام ، % وصلاة وصلتها بصلات % 27(@)(@@) % ومساع قد أشرك الملك الصا % % لح في باقياتها الصالحات % 28(@)(@@) % فقصدت البيت الحرام ، فأقصد % % ت بسهم الردي قلوب العداة % 29(@)(@@) % ولكم قد حرمت في يوم أحرم % % ت لذيذ الكرى عيون البغاة % 30(@)(@@) % ثم لبيت منعما ، حين لبي % % ت ، ندا من دعاك للمكرمات % 31(@)(@@) % وتقدمت للطواف 
ms125	 فأطفأ % % ت لهيب الهموم بالخطوات % PageV01P455 32(@)(@@) % واستلمت الركن العتيق فأسلم % % ت قلوب العداة للحسرات % 33(@)(@@) % وسعيت الركن العتيق فأسلم % % جزت في المكرمات سعي السعاة % 34(@)(@@) % ولكم قد قصرت ساعة قصر % ت على الخوف أنفسا قاصرات % 35(@)(@@) % ومنى النفس في نزول منى نل % % ت برغم الأعداء والشمات % 36(@)(@@) % ورميت الجمار في كبد الأع % % داء ، لما رميت بالجمرات % 37(@)(@@) % ولكم قد أفضت من فيض إنعا % % مك ، لما أفضت من عرفات % 38(@)(@@) % ورأيت الثناء أبقى من المال % % ل ، فغادرته هبا بالهبات % 39(@)(@@) % إنما الطيبات للطيبين ال % % أصل ، والطيبون للطيبات % 40(@)(@@) % لا تسمنا قضاء حقك بالأش % % عار ، يا كامل الصفا والصفات % 41(@)(@@) % لو نظمنا النجوم فيك عقودا ، % ما قضينا حقوقك الواجبت % PageV01P456 البحر : رمل تام 1(@)(@@) % كرر اللوم عليه إن تشا ، % فهو صب بحمياه انتشى % % 2(@)(@@) % هزه بل أزه ذكر الحمى ، % فتثنى طربا ، بل رعشا % % 3(@)(@@) % كاد أن يقضي فجددت له % ذكر سكان الحمى ، فانتعشا % % 4(@)(@@) % لست عندي عاذلا بل عادل ، % سر بالذكرى فوشى ، إذ وشى % % 5(@)(@@) % مغرم حاول كتمان الهوى ؛ % وشهود الدمع لا ترضى الرشى % % 6(@)(@@) % شام برق الشام صبحا : فصبا % % وتراعاه عشاء ، فعشا % % 7(@)(@@) % لاح ، والليل به مكتهل ، % وجنين الصبح حمل في الحشا % % 8(@)(@@) % وهلال الأفق يحكي قوسه % جانب المرآة يبدو من غشا % % 9(@)(@@) % وحكى كيوان صقرا لائذا % بجناح النسر لما فرشا % % 10(@)(@@) % وكأن المشتري ذو أمل % نال حظا ، ومن البدر ارتشى % % PageV01P457 11(@)(@@) % وحكى المريخ في صنعته % خد محبوب بلحظ خدشا % % 12(@)(@@) % وسهيل مثل قلب خافق % مكن الرعب به ، فارتعشا % % 13(@)(@@) % وبنات النعش سرب نافر % هام ذعرا ومن النسر اختشى % % 14(@)(@@) % والثريا سبعة قد أشبهت % شكل لحيان بتخت نقشا % % 15(@)(@@) % ووميض غادرت غرته % % أدهم الليل صباحا أبرشا % % 16(@)(@@) % طرز الأفق بنور ساطع ، % أدهش الطرف به بل أجهشا % % 17(@)(@@) % فتلاه من دموعي وابل % لا يزيد القلب إلا عطشا % % 18(@)(@@) % طبق الآفاق حتى خلته % من ندى أيدي علي قد نشا % % 19(@)(@@) % كاتب السر الذي في عصره ، % سر دست الملك يوما ما فشا % % 20(@)(@@) % يقظ الآراء 
ms126	 ، مسلوب الكرى ، % مستجيش العزم ، متعوب الوشا % % PageV01P458 21(@)(@@) % فالأماني من عطاه ترتجى ، % والمنايا من سطاه تختشى % % 22(@)(@@) % خلق لو يقتدي الدهر به % كحلت أصباحه كل عشا % % 23(@)(@@) % ذو يراع راع آساد الشرى ، % وحشا الأعداء رعبا قد حشا % % 24(@)(@@) % لا يراعي ذمة الأسد التي % % بينها في الغاب قدما قد نشا % % 25(@)(@@) % وبسطت الأنس في زمن % ولأطواد العلى مفترشا % % 26(@)(@@) % أصبح العضب به مرتعدا ، % وانثنى اللدن به مرتعشا % % 27(@)(@@) % فإذا أوحى إليه أمره % جاء طوعا وعلى الراس مشى % % 28(@)(@@) % كلما تاه جماحا صدره % صرفته كفه حيث يشا % % 29(@)(@@) % كفل الأيام إلا أنه % أيتم الأطفال لما بطشا % % 30(@)(@@) % عربي واطىء رومية % ينسل الزنج لها والحبشا % % PageV01P459 31(@)(@@) % يصبح الروض هشيما كلما % % رقم الطرس به ، أو رقشا % % 32(@)(@@) % ما رأينا قبله ليث شرى % % حملت يمناه صلا أرقشا % % 33(@)(@@) % % ويد الأقدار تقضي ما يشا % % 34(@)(@@) % جدت لي بالود من قبل الندى % % منعما بالرقب لي بل منعشا % 35(@)(@@) % % كنت من ظلي به مستوحشا % % 36(@)(@@) % فسأجلو ذكركم في موطن % يحمد السامع فيه الطرشا % % 37(@)(@@) % إنما الذكر ، طليقا ، مقعد ، % فإذا قيد بالشعر مشى % % 38(@)(@@) % فاستمع لابنة يوميها التي % % جمل الفكر لها بل جمشا % % 39(@)(@@) % وابق في عز مقيم ظله ، % بسط الأمن له ، فافترشا % % 40(@)(@@) % مستظلا دوحة المجد التي % % ثبتت أصلا ، وطابت عرشا % % PageV01P460 البحر : كامل تام 1(@)(@@) % ما كنت أعلم ، والضمائر تنطق ، % أن المسامع كالنواظر تعشق % 2(@)(@@) % حتى سمعت بذكركم ، فهويتكم ، % وكذاك أسباب المحبة تعلق % 3(@)(@@) % ما ذر من أرض الغنية شارق ، % إلا وكدت بدمع عيني أشرق % 4(@)(@@) % شوقا إلى أكناف ربعكم الذي % % كلي إليه تشوف ، وتشوق % 5(@)(@@) % أسري وأسري موثق بيد الهوى ، % فمتى أسير أنا الأسير المطلق % 6(@)(@@) % فلئن عثرت بأن عبرت ، ولم أبت ، % بغناك ، ذا حدق بمجدك تحدق % 7(@)(@@) % فاعذر جوادا قد كبا في جريه ، % فلربما كبت الجياد السبق % PageV01P461 البحر : كامل تام 1(@)(@@) % جن الظلام ، فمذ بدا متبسما % لاح الهدى وتجلت الظلماء % 2(@)(@@) % وهدت محبا ظل في ليل الجفا % % لما هدا وامتدت الآناء % 3(@)(@@) % رشأ غدا من سكر خمرة 
ms127	 ريقه % متأودا فكأنها صهباء % 4(@)(@@) % وسرت بخديه المدام بلطفها % % فتوردا وكساهما اللألاء % 5(@)(@@) % وافى يعيد من التواصل ضعف ما % % منه بدا إذ صح منه وفاء % 6(@)(@@) % فألم بي طوعا وبات لساعدي % % متوسدا وفراشه الأعضاء % 7(@)(@@) % عانقته مترفقا وضممته % % متأيدا إذ نامت الرقباء % 8(@)(@@) % حى اغتدى من ساعدي موشحا % ومقلدا وقد اعتراه حياء % 9(@)(@@) % وسطا الضياء على الظلام وحبذا % % لو يفتدى وله النفوس فداء % 10(@)(@@) % لم أدر ، ضوء الصبح أقبل جيشه % متبددا ، ولهث الشعاع لواء % PageV01P462 11(@)(@@) % أو نور شمس الدين قد جلى الدجى % % لما بدا وله القلوب سماء % 12(@)(@@) % شمس إذا ما راح ترقبه العلى % % وإذا غدا فكأنها الحرباء % 13(@)(@@) % وإذا تدرع فالسماحة درعه ، % وإذا ارتدى فله الجمال رداء % 14(@)(@@) % من آل عبسون الذين إذا انتموا % % عبس الردى وتولت اللأواء % 15(@)(@@) % وإذا سطوا بكت السيوف وإن سخوا % % ضحك الندى وتجلت الغماء % 16(@)(@@) % قوم بهم تجلى الكروب ومنهم % يرجى الجدا إن ضنت الأنواء % 17(@)(@@) % فنداهم قبل السؤال وجودهم % % قبل الندى وكذلك الكرماء % 18(@)(@@) % وهم منى لمن اعتفى ومنية % لمن اعتدى فسعادة وشقاء % 19(@)(@@) % مولاي شمس الدين يامن كفه % يروي الصدى وبها العداة ظماء % 20(@)(@@) % اشكو إليك غريم شوق قد غدا % % متمرداما عنده إغضاء % PageV01P463 21(@)(@@) % شوقي إلى علياك أعظم أن يرى % % متعددا ويعمه الإحصاء % 23(@)(@@) % لا زال غيث نداك يمطر فضة ، % أو عسجدا تغنى به الفقراء % PageV01P464 البحر : خفيف تام 1(@)(@@) % ألآل أشرقت في نحور % أم نجوم أشرقت في ليالي % % 2(@)(@@) % أم فصول من خواطر مولى % % ذي مقام في العلى ومقال % 3(@)(@@) % كم بنت بالفكر بيت معان ، % وانثنت بالذكر بيت معالي % % 4(@)(@@) % نفث أقلام خفاف نحاف ، % كم أبادت من خطوب ثقال % 5(@)(@@) % وقصار في الأكف ولكن % قصرت فعل الرماح الطوال % 6(@)(@@) % تجعل الغمض علينا حراما ، % كلما جاءت بسحر حلال % 7(@)(@@) % قيدتني بالجميل ، ولكن % أطلقت بالشكر فيه مقالي % % 8(@)(@@) % أمنتني غير أني عليه % خائف من شر عين الكمال % 9(@)(@@) % فاعف مولاي محبا ثناه % عن ثناه فيكم شغل بال % 10(@)(@@) % ذا هموم ، قلبه في اشتغال ، % ولظى 
ms128	 أحزانه في اشتعال % PageV01P465 البحر : خفيف تام 1(@)(@@) % من لصب أدنى البعاد وفاته ، % إذ عداه وصل الحبيب وفاته % % 2(@)(@@) % فاته من لقا الأحبة عيش ، % كان يخشى قبل الوفاة فواته % % 3(@)(@@) % كان ثبتا قبل التفرق لكن % زعزعت روعة الفراق ثباته % % 4(@)(@@) % سره جمع شمله بلقاهم ، % فقضى حادث الزمان شتاته % % 5(@)(@@) % ما عصى الحب ، حين أطنبت الوا % % شون فيهم ، ولا أطاع وشاته % % 6(@)(@@) % سره ذكرهم ، وقد ساءه اللو % % م ، فأحياه عذلهم وأماته % % 7(@)(@@) % أظهروا لي تملقا واكتئابا % هو عندي تهكم ، وشماته % % 8(@)(@@) % فصمت شدة الهموم عرى القل % % ب وأصدى مرأى العدى مرآته % % 9(@)(@@) % كيف تفري الهموم حد اصطباري % % بعدما فلت الخطوب شباته % % 10(@)(@@) % كنت مستنصرا بأسياف صبري ، % فنبت بعد فرقة ابن نباته % % PageV01P466 11(@)(@@) % فاضل ألف الفصاحة والعل % % م وضمت آراؤه أشتاته % % 12(@)(@@) % وهبته العلياء هبة قلب % طهرت من شوائب العيب ذاته % % 13(@)(@@) % رب شعر لم يتبع ما روى الغا % % وون لكن بالفضل يهدي غواته % % 14(@)(@@) % ومعان تضيء في قالب اللف % % ظ ، فيجلو مصباحها مشكاته % % 15(@)(@@) % وإذا هذب الرواة قريضا % فيه قد هذب القريض رواته % % 16(@)(@@) % صارم في معارك اللفظ والفض % % ل حمدنا انغماده وانصلاته % % 17(@)(@@) % قد سبرنا حديه في النظم والنث % % تر ، فكانت بتاكة بتاته % % 18(@)(@@) % يا جمال الدين الذي أحرز السب % % ق ، ولا يعثر الجياد أناته % % 19(@)(@@) % أنت قوت القلوب لو كنت أعطي % % ت لحب من أنسكم ما فاته % % 20(@)(@@) % ورسول منكم تعجبت منه % حين حانت مني إليه التفاته % % PageV01P467 21(@)(@@) % جاء يهدي لى الصحاب طروسا % ليس للعبد بينهن حتاته % % 22(@)(@@) % فتأملت في يديه خطوطا % أذكرتني من ربها أوقاته % % 23(@)(@@) % لو بعثتم للعبد فيها سحاة % لأعادت ، بعد الممات ، حياته % % 24(@)(@@) % فتفضل بالأنس واهد إلى عب % % دك من مسكك الزكي فتاته % % 25(@)(@@) % لك من وافر العلوم نصاب ، % فاجعل الرد للجواب زكاته % % PageV01P468 البحر : وافر تام 1(@)(@@) % كتبت فما علمت أنور نجم % بدا لعيوننا أم نور نجم % 2(@)(@@) % فأسرح ناظري في وشي روض % وألقح خاطري من بعد عقم % 3(@)(@@) % وقسمت التفكر فيه لما % % أخذتبه من اللذات 
ms129	 قسمي % % 4(@)(@@) % فلم أعجب لذلك ، وهو در ، % إذا ما جاء من بحر خضم % 5(@)(@@) % أشمس الدين كم من شمس فضل % بها جلت يداك ظلام ظلم % 6(@)(@@) % نظمت من المعالي والمعاني % % بدائع حزن عن نثر ونظم % 7(@)(@@) % لك القلم الذي قصرت لديه % طوال الشمر في حرب وسلم % 8(@)(@@) % يراع راع بالخطب الزواهي % % جسيم الخطب ، وهو نحيف جسم % 9(@)(@@) % ففي يوم الندى يجري ، فيجدي ؛ % وفي يوم الردى يرمي ، فيصمي % % 10(@)(@@) % ويرسل في الورى وسمي جود ، % وينفث في العداة زعاف سم % PageV01P469 11(@)(@@) % ويطلع في سماء الطرس شهبا % ثواقبها لأفق اللك تحمي % % 12(@)(@@) % إذا رام استراق السمع يوما % رجيم الكيد عاجله برجم % 13(@)(@@) % فيا من ساد في فضل ولفظ ، % كما قد زاد في عمل وعلم % 14(@)(@@) % لقد بسمت لنا الأيام لما % % بذلت لنا محيا غير جهم % 15(@)(@@) % وشاهد ناظري أضعاف ما قد % % تفرس قبل ذلك فيك فهمي % % 16(@)(@@) % فكيف أروم أن أجزيك صنعا ، % وأيسر صنعك التنويه باسمي % % 17(@)(@@) % فعلك أن تمهد بسط عذري ، % لمعرفتي بتقصيري وجرمي % % 18(@)(@@) % فمثلك من ترفق بالموالي ، % وغض عن المقصر جفن حلم % 19(@)(@@) % ودم في سبق غايات المعالي ، % تصوب للفخار جواد عزم % PageV01P470 البحر : خفيف تام 1(@)(@@) % طمعي في لقاك ، بعد إياس ، % هو أغرى قلبي بقصد أياس % % 2(@)(@@) % ولو أني علمت أنك بالزو % % راء وافيتها بعيني وراسي % % 3(@)(@@) % وكذا في دمشق لولاك ما أو % % ردت خيلي بها على بانياس % 4(@)(@@) % بل توهمت أن تعود إلى الشا % % م ، فوافيتها على سيواس % 5(@)(@@) % يا خليلي من دون كل خليل ، % وأنيسي من دون أهلي وناسي % % 6(@)(@@) % لا تكن ناسيا لعهدي ، فإني % % لست ما عشت للعهود بناسي % % 7(@)(@@) % قس ضميري على ضميرك في الو % د ، فإن الوداد علم قياسي % % 8(@)(@@) % واعتمد موقنا على صدق ودي ، % لا على ما يضمه قرطاسي % % 9(@)(@@) % لو تراني كما عهدت من الل % ذة بين القسيس والشماس % 10(@)(@@) % أشتري التبر باللجين ، ولا أف % % رق ما بين عسجد ونحاس % PageV01P471 11(@)(@@) % فتراني يوما بخمارة النه % % ر ، وطورا بحانة الدرباس % 12(@)(@@) % فأناس تلوم في 
ms130	 نقص كيسي ، % وأناس تلوم في ملء كاسي % % 13(@)(@@) % ذاك خير من خدمتي لأناس % هم إذا ما اختبرت غير أناس % 14(@)(@@) % يستقلون ما بذلت من النص % % ح ويستكثرون فضل لباسي % % 15(@)(@@) % ولو اني أفوه فيهم بلفظ ، % كاد أن ينسف الجبال الرواسي % % 16(@)(@@) % فسأفني ما قد حويت ولا أذ % % خر فلسا لساعة الإفلاس % 17(@)(@@) % وإذا ما غرقت في لجج اله % % م ، ففي ماردين ملقى المراسي % % 18(@)(@@) % بلدة ما أتيتها قط إلا % خلتها بلدتي ومسقط راسء % 19(@)(@@) % بذلوا لي مع السماحة ودا ، % هو منهم يزيد في إيناسي % % 20(@)(@@) % فنهاري جليس ليث عرين ، % ومسائي ضجيع ظبي كناس % PageV01P472 21(@)(@@) % فأناس تقول يا أبا فراس ، % وأناس تقول يا أبا نواس % 22(@)(@@) % لست أشكو بها من العيش إلا % أنني لا أراك في الجلاس % 23(@)(@@) % سيدي صاحبي أنيسي جليسي ، % طوق جيدي معاشري تاج راسي % % 24(@)(@@) % لايغيرك ما تقول الأعادي ، % فبناء الوداد فوق أساس % 25(@)(@@) % أو نفاري عليك من نصب الدر % % ب ، بحسب الإدلال والإيناس % 26(@)(@@) % أو خصام الشهباء في يوم إخرا % % ظ لأن الفضول مثل العطاس % 27(@)(@@) % يا نسيم الشمال إن جزت بالزو % % اء يوما معطر الأنفاس % 28(@)(@@) % زر حبيبا لنا بدرب حبيب ، % واتل شوقي ، وما أبيت أقاسي % % 29(@)(@@) % صاحبا لم يزل ، إذا دهم اله % م ، يساوي بنفسه ويواسي % % 30(@)(@@) % وإذا ما قضيت تقبيل كفي % % ه ، فسلم على فتى الدرباس % PageV01P473 31(@)(@@) % ثم صف للجلال نجل الحرير % % ي اشتياقي ، والفخر نجل الياس % PageV01P474 البحر : خفيف تام 1(@)(@@) % فلتة كان منك عن غير قصد ، % يا أبا بكر عقد بيعة ودي % % 2(@)(@@) % فلهذا ، إذا تقادم عهد % بيننا حلت عن وفائي وعهدي % % 3(@)(@@) % يا سمي الصديق ، ما كنت في ص % % دك إلا مصدقا قول ضدي % % 4(@)(@@) % أنت ألزمتني بأخلاقك الغ % ر ودادا في حال قربي وبعدي % % 5(@)(@@) % ثم قاسمتني ، فعندك قلبي % % حين فارقتني ، وذكرك عندي % % 6(@)(@@) % كل يوم أقول : قد قال مولاي ، % وما قلت ساعة : قال عبدي % % 7(@)(@@) % يا نديمي ، إذا تفرد بي الفك % % ر ، ويا مؤنسي ، إذا كنت وحدي % % 8(@)(@@) % أنت تدري 
ms131	 ما كان بعدك حالي ، % فترى كيف كان حالك بعدي ؟ % 9(@)(@@) % هل تقاسي الحنين مثلي ، وهل تح % % مل شوقي ، وهل تكابد وجدي % % 10(@)(@@) % فترى لم قطعت كتبي وقطع % ت حبال الوفا بإخلاف وعدي % % PageV01P475 11(@)(@@) % لاكتاب به ابتدأت ، ولا رد % جواب ، ولو بحبة ورد % 12(@)(@@) % ويك أنى لك الجزارة والحم % % ق ؟ أجبني ، وأنت في ذاك جندي % % 13(@)(@@) % أنا أولى بها لعدة أقسا % % م جسام لكن أسر وتبدي % % 14(@)(@@) % ما سرايا أبي ، وما ابن أبي القا % % سم عمي ، وما محاسن جدي % % 15(@)(@@) % كما قيل يقول : تدبير قيس ال % % رأي دوني وبأس عمرو بن غير % % 16(@)(@@) % أني مذ أطلقت نوب الأ % % يام حدي ما جزت بالحمق حدي % % 17(@)(@@) % بل تعودت أن أصغر قدري ، % لصديقي ، ولا أصعر خدي % % 18(@)(@@) % فلئن كان منك ذلك بالقصد ، % ولم تخش من صواعق رعدي % % 19(@)(@@) % لا أجازيك بالإهانة والس % ب ، ولكن جزاك يا نحس عندي % % PageV01P476 البحر : خفيف تام 1(@)(@@) % لو بعثتم في طي نشر النسيم % بسلام راق لقلبي السليم % 2(@)(@@) % لالتقينا قبولها بقبول ، % وشفينا منها ، ولو بالسموم % 3(@)(@@) % ولو أن الرسول جاء بطرس % لمحب من بينكم في جحيم % 4(@)(@@) % قلت عند الإياب : يا نار بردا % وسلاما كوني لإبراهيم % 5(@)(@@) % هدهد هد قوتي حين لم يل % % ق إلى العبد من كتاب كريم % 6(@)(@@) % جاء يسعى بكل طرس نضيد % جاء من لفظه بذر نظيم % 7(@)(@@) % بمعان من الجزالة كالصخ % % ر ، ولفظ من رقة كالنسيم % 8(@)(@@) % فتوسمته ، فكانت معاني % % ه لقاحا لك فكر عقيم % 9(@)(@@) % سيدي بل سمعت عنك كلاما ، % هو في مهجتي شبيه الكلوم % 10(@)(@@) % إن مولاي قد تولع جهلا % بعد سقط اللوى بوادي الصريم % PageV01P477 11(@)(@@) % ورووا عنه أن ذاك زواج % ثابت يقتشي شروط اللزوم % 12(@)(@@) % ثم قيل اهتدى ، فيا ليته دا % % م على ذلك الضلال القديم % 13(@)(@@) % فتنفست حسرة ، وتعوذ % % ت من الشر بالسميع العليم % 14(@)(@@) % رب رشد ملقب بضلال ، % وشقاء ملقب بنعيم % PageV01P478 البحر : خفيف تام 1(@)(@@) % راقني من لفظك المستطاب % حكمة فيه وفصل الخطاب % 2(@)(@@) % ومعان مشرقات حسان ، % ما توارت 
ms132	 شمسها في حجاب % 3(@)(@@) % هي للواردين ماء زلال ، % وسواها لامع كالسراب % 4(@)(@@) % جال ماء الحسن فيها كما قد % % جال في الحسناء ماء الشباب % 5(@)(@@) % ما رأينا قبلها عقد در % ضمه في الطرس سطر كتاب % 6(@)(@@) % صدرت عن لفظ صاحب فضل % هو عندي من أكبر الأصحاب % 7(@)(@@) % فتأملت وأملت منه % جمع شملي في عاجل واقتراب % 8(@)(@@) % ثم قابلت أيادي ثناه % بدعاء صالح مستجاب % 9(@)(@@) % يا أهيل الود أنتم مرادي ، % وإليكم في العلاء انتسابي % % 10(@)(@@) % ذكركم لي شاغل في حضوري ، % وثناكم مؤنسي في اغترابي % % PageV01P479 البحر : خفيف تام 1(@)(@@) % نلت من ودك الجميل انتصافي ، % حيث من سائر القذي أنت صافي % % 2(@)(@@) % وتيقنت مذ أذنت لكتبي % % أن توافي ، بأن لي أنت وافي % % 3(@)(@@) % حملتها قوادم من وفاء ، % وخواف للود غير خواف % 4(@)(@@) % أيها الصاحب المعظم تاج ال % % دين رب الإسعاد والإسعاف % 5(@)(@@) % لا تظن انقطاع كتبي بأني % % لك جاف ، كلا ولامتجاف % 6(@)(@@) % ذكركم ملء مسمعي ، وسنا وج % % هك تلقاء ناظري والهوى في % % 7(@)(@@) % وردت عبدك المقصرض أبيا % % ت فأغنته عن كؤوس السلاف % 8(@)(@@) % بقواف قد رصعت بالمعاني ، % ومعان قد فصلت بالقوافي % % 9(@)(@@) % فتخيرت ما أقول ، وأهدي % % نحو تلك الأخلاق والألطاف % 10(@)(@@) % غير أني لففت نذر جواب ، % لي شاف ، وإن غدا غير شاف % PageV01P480 11(@)(@@) % فاسخ لي منعما بتمهيد عذري ؛ % إنها من خلائق الأشراف % 12(@)(@@) % قد شرحت المبسوط من قصر عذري ، % فاعتبره من رأيك الكشاف % PageV01P481 البحر : كامل تام 1(@)(@@) % من غرس نعمته وترب سماحه ، % وربيب دولته وراضع جوده % 2(@)(@@) % عبد يود بقاء مالك رقه ، % علما بأن وجوده بوجوده % 3(@)(@@) % يطوي المفاوز وهو ينشر فضله ، % ووداده منه كحبل وريده % 4(@)(@@) % لا يستطيع جحود شامل بره ، % عبد ، قلائد جوده في جيده % PageV01P482 البحر : بسيط تام 1(@)(@@) % يقبل الأرض عبد تحت ظلكم ، % عليكم بعد فضل الله يعتمد % 2(@)(@@) % ما دار مية من أقصى مطالبه ، % يوما ، وأنتم له العلياء والسند % PageV01P483 البحر : طويل 1(@)(@@) % رعى الله من ودعته ، فكأنما % % أودع وحا بين لحمي وأعظمي % % 2(@)(@@) % وقلت لقلبي ، حين فارقت مجده : % فراق ومن 
ms133	 فارقت غير مذمم % PageV01P484 البحر : بسيط تام 1(@)(@@) % يا سادة مذ سعت عن بابهم قدمي ، % زلت ، وضاقت بي الأمصار والطرق % 2(@)(@@) % قد حاربض الصبر والسلوان بعدكم % قلبي ، وصالح طرفي الدمع والأرق % 3(@)(@@) % ودوحة الشعر مذ فارقت مجدكم ، % قد أصبحت بهجير الهجر تحترق % 4(@)(@@) % فإن أردتم لها البقيا بقربكم ، % تداركوها ، وفي أغصانها ورق % PageV01P485 البحر : طويل 1(@)(@@) % أقول لسار يطلب الرزق ساقيا % سوام الأماني من حيض المطامع % 2(@)(@@) % هلم إلى ربع الجواد الذي بدت % مناقبه مثل النجوم الطوالع % 3(@)(@@) % ورب دليل لي إليه أجبته : % كفاني دليلا ما له من صنائع % 4(@)(@@) % ومستشفع بي عنده قلت إنه % % كريم ، نداه عنده خير شافع % PageV01P486 البحر : طويل 1(@)(@@) % فوالله ما اشتقت الحمى لحدائق % بها الدوح يزهى غصنه ووريقه % % 2(@)(@@) % بل اشتقت لما قيل إنك بالحمى ، % ومن ذا الذي ذكر الحمى لا يشوقه % % PageV01P487 البحر : طويل 1(@)(@@) % سقى الله أرضا ، نور وجهك شمسها ، % وحيا سماء ، أنت في أفقها بدر % 2(@)(@@) % وروى بلادا ، جود كفك غيثها ، % ففي كل قطر من نداك بها قطر % PageV01P488 البحر : سريع 1(@)(@@) % يا سادة حملت من بعدهم ، % أكثر من عهدي ومن طوقي % % 2(@)(@@) % أصحبت كالورقاء في مدحكم ، % لما غدا إنعامكم طوقي % % 3(@)(@@) % إن حواسي الخمس مذ غبتم ، % إليكم في غاية الشوق % 4(@)(@@) % تحلون في عيني وسمعي ، وفي % % لمسي ، وفي شمي ، وفي ذوقي % % 5(@)(@@) % كذا جهاتي الست من بعدكم % % مملوءة من لاعج الشوق % 6(@)(@@) % خلفي وقدامي ، ويمناي واليس % % رى ، ومن تحتي ومن فوقي % % PageV01P489 البحر : طويل 1(@)(@@) % إليك اشتياقي لا يحد لأنه % إذا حد لا يلفي لضابطه أصل % 2(@)(@@) % وكيفض يحد الشوق عندي بضابط % وليس له جنس قريب ولا فصل % PageV01P490 البحر : طويل 1(@)(@@) % ولما سطرت الطرس أشفق ناظري ، % وقال لطرسي : سوف أمحوك بالهطل % 2(@)(@@) % كلانا سواد في بياض ، فما الذي % % تمن به حتى تشاهدهم قبلي % % PageV01P491 البحر : كامل تام 1(@)(@@) % لا غرو أن يصلى الفؤاد لبعدكم % % نارا تؤججها يد التذكار % 2(@)(@@) % قلبي إذا غبتم يصور شخصكم % % فيه ، وكل مصور في النار % PageV01P492 البحر : طويل 1(@)(@@) % أحن إليكم كلما ذر شارق 
ms134	 ، % ويشتاق قلبي كلما مر خاطف % 2(@)(@@) % وأهتز من خفق النسيم إذا سرى ، % ولولاكم ما حركتني العواصف % PageV01P493 البحر : طويل 1(@)(@@) % رعى الله من فارقت يوم فراقهم % % حشاشة نفس ودعت يوم ودعوا % % 2(@)(@@) % ومن ظعنت روحي ، وقد سار ظعنهم ، % فلم أدر أي الظاعنين أشيع % PageV01P494 البحر : خفيف تام 1(@)(@@) % يا بعيدا يشتاقه لحظ عيني ، % وقريبا محله في فؤادي % % 2(@)(@@) % تشتهي العين أن تراك ولو ب % % ت مريضا وأنت من عوادي % % 3(@)(@@) % وتمنيت لو كتبت كتابي % % أن إنسانها مكان المداد % 4(@)(@@) % لا تظن البعاد يخلق عهدي ، % أو تحل الأيام عقد ودادي % % 5(@)(@@) % أنت من مهجتي مكان السويدا % % ء ومن مقلتي مكان السواد % PageV01P495 البحر : كامل تام 1(@)(@@) % لم تخل منك خواطري ونواظري ، % في حال تسهادي ، وحين أنام % % 2(@)(@@) % فبطيب ذكر منك تبدأ يقظتي ، % وبشخص طيفك تختم الأحلام % PageV01P496 البحر : بسيط تام 1(@)(@@) % والله ما سهرت عيني لبعدكم ، % لعلمها أن طيب الوصل في الحلم % % 2(@)(@@) % ولا صبوت إلى ذكر الجليس لكم ، % لأن ذكركم في خاطري وفمي % % PageV01P497 البحر : طويل 1(@)(@@) % سلام عليكم من محب متيم ، % مشوق إذا جن الظلام له جنا % % 2(@)(@@) % سلام عليكم من شج ، كلما هدت % من الليل آناء الظلام له أنا % % 3(@)(@@) % سلام عليكم من غري بذكركم ، % إذا هب خفاق النسيم له حنا % % 4(@)(@@) % سلام عليكم لا فجعنا بقربكم ، % ولا قدر الرحمن بعدكم عنا % % 5(@)(@@) % سلام عليكم ما حيينا ، وإن نمت % عليكم سلام الله من بعدنا منا % % PageV01P498 البحر : خفيف تام 1(@)(@@) % يا بياض البياض ! أنت من الأع % % ين والقلب في سواد السواد % 2(@)(@@) % طال شوقي إليك ، والسر خاف % عن جميع الأنام ، والشوق باد % 3(@)(@@) % فلئن سرت عن حماك وحال ال % % شوق ما بيننا بغير مراد % 4(@)(@@) % ما تزودت مذ رحلت سوى اله % م ، فلا تجعلنه آخر زادي % % PageV01P499 البحر : طويل 1(@)(@@) % إذا ما تراءت لي محاسن شخصكم % % يطالبني قلبي ويمطلني صبري % % 2(@)(@@) % فأحجم ، لاخل يعوض عنكم % لدي ، ولا وعد يقوم به عذري % % 3(@)(@@) % فإن سمح الدهر المشت بقربكم ، % وأصلح ما قد أفسدته يد الهجر % 4(@)(@@) % أخذت 
ms135	 بثأر الدهر من كل كاشح ، % يقول بأن الغدر من شيم الدهر % PageV01P500 البحر : وافر تام 1(@)(@@) % لئن حكمت بفرقتنا الليالي ، % وراعتنا ببعد بعد قرب % 2(@)(@@) % فشخصك لا يزال جليس عيني % % وذكرك لا يزال أنيس قلبي % % PageV01P501 البحر : خفيف تام 1(@)(@@) % لست يوما أنسى مودة مولا % % ي ، وإن كان للمودة أنسي % % 2(@)(@@) % كيف أنسى من كان راحة قلبي % % وصفا عيشتي وجامع أنسي % % PageV01P502 البحر : كامل تام 1(@)(@@) % الشوق أعظم جملة ، يا سيدي ، % من أن يحد يسيره بكتاب % 2(@)(@@) % ولو أعج البر حاء أعظم كثرة % من أن يحيط بها بليغ خطابي % % 3(@)(@@) % لا بنت يا إنسان أعين حبتي % % عني ، وبيت قصيدة الأصحاب % 4(@)(@@) % لو لم يكن شرب الدماء محرما % صيرت بعدكم الدموع شرابي % % PageV01P503 البحر : بسيط تام 1(@)(@@) % أشكو إليك اشتياقا لست تنكره % مني وأبدي ارتياحا أنت تعرفه % % 2(@)(@@) % وأرتجيك لعين أنت مانعها % % طيب الرقاد ، وقلب أنت متلفه % % 3(@)(@@) % فكل يوم مقالي حين يقلقني % % قلب لبعدك باللقيا أسوفه % % 4(@)(@@) % لا أوحش الله ممن لا أرى أحدا % من الأنام ، إذا ما غاب يخلفه % % PageV01P504 البحر : طويل 1(@)(@@) % ومن عجبي أني أحن إليكم ، % ولم يخل طرفي من سناكم ولا قلبي % % 2(@)(@@) % وأطلب قربا من حماكم ، وأنتم % % إلى ناظري والقلب في غاية القرب % PageV01P505 البحر : كامل تام 1(@)(@@) % أفدي الذين قضت لهم أيدي النوى % % بالبعد عن أوطانهم فتغربوا % % 2(@)(@@) % غابوا ، ومثل شخصهم لنواظري % % ذكري لهم ، فهم الحضور الغيب % PageV01P506 البحر : وافر تام 1(@)(@@) % أيا من ضاع فيه نفيس عمري ، % وصبري بين إعراض وبين % 2(@)(@@) % أراك ممثلا بسواد قلبي ، % فمن لي أن يراك سواد عيني ؟ % PageV01P507 البحر : كامل تام 1(@)(@@) % قد كنت أصبر ، والديار بعيدة ، % فاليوم قد قربت وصبري فاني % % 2(@)(@@) % ما ذاك من عكس القياس ، وإنما % % لتضاعف الحسرات بالحرمان % PageV01P508 البحر : طويل 1(@)(@@) % وما زادني قرب الديار تلفها % عليكم ، لأن الترب شر من البعد % 2(@)(@@) % ولكن ، إذا الظمآن شاهد منهلا ، % على قربه ، زاد الحنين إلى الورد % PageV01P509 البحر : طويل 1(@)(@@) % دنوتم ، فزاد الشوق عما عهدته ، % وزدت لقرب الدار كربا على كرب % 2(@)(@@) % وكنت أظن الشوق 
ms136	 في البعد وحده ، % ولم أدر أن الشوق في البعد والقرب % PageV01P510 البحر : طويل 1(@)(@@) % وكنا سألنا الله يجمع بيننا ، % ويقضي لنا بالقرب منكم ويحكم % 2(@)(@@) % ونجلو بأيام السرور ونورها % % ليالي أحزان ، بها العيش مظلم % 3(@)(@@) % فلما أنسنا منكم بحلائق % تصدق ما تروي الخلائق عنكم % 4(@)(@@) % تباعدتم ، لا أبعد الله داركم ؛ % وأوحشتم ، لا أوحش الله منكم % PageV01P511 البحر : مجزوء الكامل 1(@)(@@) % نفسي الفداء لقادم % جذب الفراق بباعه % % 2(@)(@@) % وهب الزمان لنا اللقا ، % ودعاه في استرجاعه % 3(@)(@@) % عانقته عند القدو % % م ، وجد في إسراعه % % 4(@)(@@) % فهو اعتناق لقائه ، % وهو أعتناق وداعه % % PageV01P512 البحر : خفيف تام 1(@)(@@) % ليس كل الأوقات يجتمع الشم % % ل ، ولا راجع لنا ما يفوت % % 2(@)(@@) % فاغتنم ساعة اللقاء ، فما تع % % لم نفس بأي أرض تموت % PageV01P513 البحر : متقارب تام 1(@)(@@) % لقد جزت في الصد حد الزيادة ، % فلا تجعل الهجر خلقا وعاده % % 2(@)(@@) % فعندي اشتياق شديد إليك ، % وقلبك يشهد هذي الشهاده % % 3(@)(@@) % وعودتني منك حسن الوداد ، % وما يطلب القلب إلا اعتياده % % 4(@)(@@) % وإني عهدتك نجل الجياد ، % لذلك أطلب منك الإجاده % % 5(@)(@@) % فإن أنت أتحفتني بالحضور ، % فمن أين للعبد هذه السعاده ؟ % PageV01P514 البحر : بسيط تام 1(@)(@@) % ما جاء عبدك مسطور بعثت به % % إلا تقبله حبا ، وقبله % % 2(@)(@@) % ولا سمحت بوعد فيه مرتقب ، % إلا تأمله عشرا وأمله % % 3(@)(@@) % ولا أتيت بعذر عن تأخره ، % إلا تعلل باللقيا وعلله % % 5(@)(@@) % ما ضر مولاي لو زاد الخطاب به ، % ولو تطول بالحسنى وطوله % % PageV01P515 البحر : طويل 1(@)(@@) % أتاني كتاب منك أحسب أنه % هو السحر لا بل دون موقعه السحر % 2(@)(@@) % بنثر يظل النظم يحسد رصفه ، % ونظم للطف السبك يحسده النثر % 3(@)(@@) % له رقة الخنساء في حال نوحها ، % ولكن معناه لقوته صخر % 4(@)(@@) % إذا شنف الأسماع در نظامه ، % تيقن كل أن مرسله البحر % PageV01P516 البحر : وافر تام 1(@)(@@) % كتبت ، فما علمت أخط نقش % يلوح لناظري أم حظ نفسي % % 2(@)(@@) % فتم به علي سرور يومي ، % وكاد بأن يعيد سرور أمسي % % 3(@)(@@) % وقالوا : قد وجدت به سرورا ، % فقلت مصرحا من غير لبس : % 4(@)(@@) % غرست بصدر مرسله 
ms137	 ودادا ، % فها أنا قد جنيت ثمار غرسي % % PageV01P517 البحر : طويل 1(@)(@@) % أتاني كتاب منك ينفث بالسحر ، % ولكنه بالعتب منتفخ السحر % 2(@)(@@) % يضم عتابا من عبابك ذاخرا ، % ولا عجب ، إذ ذاك ، من لجة البحر % 3(@)(@@) % فأشعرت من تعريضه بسعاية % رمتني بها الأعداء من حيث لا أدري % % 4(@)(@@) % فإن يك حقاص ، فاجعل العقو كيدهم ؛ % وإن يك زورا فاتق الله في أمري % % PageV01P518 البحر : منسرح 1(@)(@@) % أنظر إلى المجد كيف ينهدم ، % وعروة الملك كيف تنفصم % 2(@)(@@) % واعجب لشهب البزاة كيف غدت % تسطو عليها الحداة والرخم % 3(@)(@@) % قد كنت أختار أن أغيب في % % الترب ، وتبلى عظامي الرمم % 4(@)(@@) % ولا أرى اليوم من أكابرنا % % أسدا وفيها الذئاب قد حكموا % % 5(@)(@@) % ظنوا الولايات أن تدوم لهم ، % فاقتطعوا بالبلاد ، واقتسموا % % 6(@)(@@) % واقتدحوا بالوعيد نار وغى ؛ % ورب نار وقودها الكلم % 7(@)(@@) % لم يعلموا أي جذوة قدحوا ، % وأي أمر إليه قد قدموا % % 8(@)(@@) % بل زعموا أن يصدنا جزع ؛ % كانت يد الله فوق ما زعموا % % 9(@)(@@) % لا عرف العز في منازلنا ، % وأنكرتنا الصوارم الحذم % 10(@)(@@) % إن لم نقدها شعثا مضمرة % تذوب من نار حقدها اللجم % PageV01P519 11(@)(@@) % بكل أزر في متنه أسد ؛ % وكل طود من فوقه صنم % 12(@)(@@) % من فتية أرخصوا نفوسهم ، % كأنهم للحياة قد سئموا % % 13(@)(@@) % إن زأروا في الهياج تحسبهم % % أسدا عليها من القنا أجم % 14(@)(@@) % شوس تظن العدى سهامهم % شهبا بها الماردون قد رجموا % % 15(@)(@@) % صغيرهم لا يعيبه صغر ، % وشيخهم لا يشينه هرم % 16(@)(@@) % ففي القضايا إن حكموا عدلوا ، % وفي التقاضي إن حوكموا ظلموا % % 17(@)(@@) % إن صمتوا كان صمتهم أدبا ، % أو نطقوا كان نطقهم حكم % 18(@)(@@) % ما عذرنا ، والسيوف قاطعة ، % وأمرنا في العراق منتظم % 19(@)(@@) % وحولنا من بني عمومتنا % % كتائب كالغمام تزدحم % 20(@)(@@) % بأي عين نرى الأنام ، وقد % % تحكمت في أسودنا الغنم % PageV01P520 21(@)(@@) % % أما حياة ، وربعنا حرم % 22(@)(@@) % لا شاع ذكري بنظم قافية % تلوح حسنا كأنها علم % 23(@)(@@) % ولا اهتدت فكرتي إلى درر % يشرق من ضوء نورها الكلم % 24(@)(@@) % وشل مني يد ، عوائدها % % يجول فيها الحسام والقلم % 25(@)(@@) % إن لم 
ms138	 أخضب ملابسي علقا % يصبغ من سيل قطرها القدم % 26(@)(@@) % وآخذ الثار من عداك ، ولو % % تحصنوا بالحصون ، واعتصموا % % 27(@)(@@) % في وقعة تسلب العقول بها ، % وأنفس الدارعين تخترم % 28(@)(@@) % إن باشرتها أقاربي بيد % يوما ، فلي دونهم يد وفم % 29(@)(@@) % يا صاحب الرتبة التي نكصت % من دون إدراك شأوها الهمم % 30(@)(@@) % قد كنت لي ذابلا أصول به ، % ما خلته في الهياج ينحطم % PageV01P521 31(@)(@@) % ما كنت أخشى الزمان حين غدا % % خصمي لعلمي بأنك الحكم % 32(@)(@@) % كففت عنا كف الخطوب ، فمن % % بعدك أمسى الزمان ينتقم % 33(@)(@@) % ما ألبستنا الأيام ثوب على % % إلا وأنت الطراز والعلم % 34(@)(@@) % عز على المجد أن تزول ، وأن % % تخلق تلك الأخلاق والشيم % 35(@)(@@) % تبكي المواضي ، وطالما ضحكت % منك وأمست غمودها القمم % 36(@)(@@) % فاليوم قد أصبحت صوارمها ، % وشملها في الهياج منصرم % 37(@)(@@) % يذكرني جودك الغمام ، إذا % % أصبح دمع الغمام ينسجم % 38(@)(@@) % إذ كنت لي ديمة تسح ، ولا % % ينساك قلبي ما سحت الديم % 39(@)(@@) % لا جمدت أدمعي ، ولا خمدت % نار أسى في حشاي تضطرم % 40(@)(@@) % وكيف يرقا عليك دمع فتى ، % ولحمه من ثراك ملتحم % PageV01P522 البحر : طويل 1(@)(@@) % جبال بأرياح المنية تنسف ، % غدت وهي قاع في الوقائع صفصف % 2(@)(@@) % محتها رياح للمنون عواصف ، % على أنها لا تتقى حين تعصف % 3(@)(@@) % أفي كل يوم للمنية غارة ، % تغير على سرب النفوس فتخطف % 4(@)(@@) % كأن حبال الساحرين نفوسنا ، % وتلك عصا موسى لها تتلقف % 5(@)(@@) % أغارت على الأقيال من آل سنبس ، % فأصبح فيهم صرفها يتصرف % 6(@)(@@) % رجال ، لو أن الأسد تخشى ديارهم % % لكنت عليها منهم أتخوف % 7(@)(@@) % شموس أرانا الموت في الترب كسفها ، % وما خلت أن الشمس في الترب تكسف % 8(@)(@@) % أتاها ، فلم تدفع من السيف وقعة ، % ولم يغن منه السابري المضفف % 9(@)(@@) % ولا الخيل تجري بين آذانها القنا ، % تقرط من خرصانه وتشنف % 10(@)(@@) % ولا رد عن نفس ابن حمزة جاشها % % ولا الجيش من أمواجه الأرض ترجف % PageV01P523 11(@)(@@) % ولا صارم ماضي الغرار بكفة ، % مضاربه في الروع بالدم ترعف % 12(@)(@@) % عروف بأحوال الضراب تؤمه % عزيمه شهم منه بالضرب أعرف 
ms139	 % 13(@)(@@) % ألا في سبيل المجد مصرع ماجد % ثمار الأماني من أياديه تقطف % 14(@)(@@) % إذا ما أراد الضد غاية ذمه % توصل حتى قال : في الجود مسرف % 15(@)(@@) % تصدع قلب البرق يوم مصابه ، % ألست تراه خافقا حين يخطف % 16(@)(@@) % وما زال بدر التم يلطم وجهه % على فقده حتى اغتدى ، وهو أكلف % 17(@)(@@) % فيا هالكا قد أطمع الخطب هلكه ، % وكان به طرف النوائب يطرف % 18(@)(@@) % لقد كنت حصنا مانعا بك نلتجي % % حذار العدى ، واليوم باسمك نحلف % 19(@)(@@) % فإن كنت في أيام عيشك كعبة % يلاذ به ، فاليوم ذكرك مصحف % 20(@)(@@) % فبعدك لا شمل اللهى متفرق ، % بجود ، ولا شمل العلى متألف % PageV01P524 21(@)(@@) % سأبكيك بالعز الذي كنت ملبسي ، % وكنت به بين الورى أتصرف % 22(@)(@@) % وأنزف من حزني دمي لا مدامعي ، % وأي دم أبقيت في فينزف % 23(@)(@@) % سقى الله تربا ضم جسمك وابلا % ينمق روضا برده ويفوف % 24(@)(@@) % إذا أنكرت أيدي البلى عرصاته ، % ينم على أرجائه ، فيعرف % PageV01P525 البحر : كامل تام 1(@)(@@) % سفها ، إذا شقت عليك جيوب ، % إن لم تشق مرائر وقلوب % 2(@)(@@) % وتملقا سكب الدموعش على الثرى % % إن لم يمازجها الدم المسكوب % 3(@)(@@) % يا حمزة الثاني الذي كادت له % صم الجبال الراسيات تذوب % 4(@)(@@) % إن ضاع ثارك بين آل محاسن ، % تلك المحاسن كلهن عيوب % 5(@)(@@) % لم أبك بالحزن الطويل تملقا ، % حزني عليك وقائع وحروب % 6(@)(@@) % فلأبكينك بالصوارم والقنا ، % حتى يحطم ذابل وقضيب % 7(@)(@@) % لايأملن بنو أبي الفضل البقا ، % إن الفناء إليهم لقريب % 8(@)(@@) % ووراهم من آل سنبس عصبة % مرد ، وشبان تهاب ، وشيب % 9(@)(@@) % قوم ، إذا غضبوا على صرف القضا ، % جاء الزمان من الذنوب يتوب % 10(@)(@@) % وإذا دعوا يوما لدفع ملمة ، % بسموا وفي وجه الزمانش قطوب % PageV01P526 11(@)(@@) % إن خوطبوا ، فحديثهم وخطابهم % % خطب وفي يوم الجدال خطيب % 12(@)(@@) % فليبكينك طرف كل مثقف % يزهى بحمل سنانه الأنبوب % 13(@)(@@) % يبكيك في يوم الهياج بأعين % خزر ، مدامعها الدم المصبوب % 14(@)(@@) % والصبح ليل بالعجاج ، وقد بدا % % بالبيض في فود العجاج مشيب % 15(@)(@@) % ولقد رضيت بأن تعيش منزها ، % لا غاصبا فيها ، ولا مغصوب % 16 
ms140	(@)(@@) % في منصب ، لله فيه طاعة % ترضي ، وللفقراء فيه نصيب % 17(@)(@@) % ستثير ثارك ، يا ابن حمزة ، عصبة % شم الأنوف إلى القراع تثوب % 18(@)(@@) % نجباء من آل العريض ، إذا سطوا % % يوما ، أفادوا الدهر كيف ينوب % 19(@)(@@) % سمعت بمصرعك البلاد فأرجفت ، % وتواتر التصديق والتكذيب % 20(@)(@@) % وبكى لرزئك صعبها وذلولها ، % وشكا لفقدك شاتها والذيب % PageV01P527 21(@)(@@) % تبكي العتاق ، إذا نعتك عواتق ، % ويحن بينك إذ أبان النوب % 22(@)(@@) % فجعت بك الدنيا ، فلا وجه العلى % % طليق ، ولا صدر الزمان رحيب % 23(@)(@@) % إذ أنت في يوم الجلاد على العدى % % 24(@)(@@) % يا شمس أفق لم يكن من قبلها % % للشمس في طي الصعيد غروب % 25(@)(@@) % إن غيبت تلك المحاسن في الثرى % % فجميلن ذكرك في البلاد يجوب % 26(@)(@@) % حزت المحامد بالمكارم ميتا ، % فغدا لك التأبين لا التأنيب % 27(@)(@@) % فابشر ، فإنك بالثناء مخلد ، % ما غاب إلا شخصك المحجوب % 28(@)(@@) % حيا الحيا جدثا حللت بتربه ، % حتى تعطر نشره ، فيطيب % 29(@)(@@) % لا زال تبكيه عيون سحائب ، % للبرق في حافاتهن لهيب % 30(@)(@@) % تهمي عليه للسحاب مدامع ، % فتشق فيه للشقيق جيوب % PageV01P528 البحر : خفيف تام 1(@)(@@) % يا قضيبا ذوى ، وكان نضيرا % ما رأينا له الغداة نظيرا % % 2(@)(@@) % أظلمت بعده الديار ، وقد كا % % ن سراجا بها وبدرا منيرا % % 3(@)(@@) % غيبته الأرضون عنا ، وما خل % % ت أديم التراب يحوي البدورا % % 4(@)(@@) % لا ولا خلت أن شهب الدراري % % بعد أوج العلى تحل القبورا % % 5(@)(@@) % يا حبيبا ، فراقه أخرب القل % % ب ، وقد كان منزلا معمورا % % 6(@)(@@) % فاجأتنا بالندب أصوات ناعي % % ك ، وكادت قلوبنا أن تطيرا % % 7(@)(@@) % فنفينا الرقاد عن كل عين ، % فجرتها دموعها تفجيرا % % 8(@)(@@) % ما رأى الناس قبل مثواك يوما % كان بالبين شره مستطيرا % % 9(@)(@@) % ولقد خفت من فراقك يوما % باكيا بالثبور ينعى ثبيرا % % 10(@)(@@) % فبرغمي أن لا أرى منك وجها % يرجع الطرف من سناه حسيرا % % PageV01P529 11(@)(@@) % كنت ريحانة القلوب ، فقد دا % % ربك الترب عنبرا وعبيرا % % 12(@)(@@) % كنت شهما مع الحداثة في الس % ن ، وجلدا على البلاء صبورا % % 13(@)(@@) % وحملت الأثقال عني فأمسى % % بك طرفي بين الأنام قريرا % % 14(@)(@@) % فجزاك 