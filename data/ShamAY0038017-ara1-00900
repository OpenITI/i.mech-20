ms881	 هارون، وعبد الصمد بن عبد الوارث، وأهل البصرة، ربما أخطأ وخالف.(@)(@@)(@@)(@@) ||| AUTO بكر بن قيس، كنيته أبو قيس، جرمي(@)(@@) يروي عن ابن سيرين، روى عنه الثوري.(@)(@@)(@@)(@@) ||| AUTO بكر بن موسى الجعفي(@)(@@) يروي عن علقمة بن مرثد، وابن أبي خالد، روى عنه جبارة بن مغلس.(@)(@@)(@@)(@@) ||| AUTO بكر بن وائل بن داود الليثي(@)(@@) من أهل الكوفة، يروي عن الزهري، روى عنه أبوه وائل بن داود، وقريش بن حيان.(@)(@@)(@@)(@@) ||| AUTO بكر بن عمرو المعافري(@)(@@) من أهل مصر، يروي عن أبي عبد الرحمن الحبلي، PageV01P002 [ج 3: ص 235] روى عنه حيوة بن شريح، وسعيد بن أبي أيوب، مات بعد الأربعين والمائة.(@)(@@)(@@)(@@) ||| AUTO بكر بن مبشر(@)(@@) يروي عن الحجازيين، روى عنه محمد بن أبي يحيى.(@)(@@)(@@)(@@) ||| AUTO بكر بن سوادة(@)(@@) مصري، يروي عن عبد الرحمن بن جبير بن نفير، روى عنه عمرو بن الحارث يخطئ.(@)(@@)(@@)(@@) ||| AUTO بكر بن عثمان البرساني(@)(@@) والد محمد بن بكر، يروي عن الحسن، وابن سيرين، روى عنه حماد بن زيد.(@)(@@)(@@)(@@) ||| AUTO بكر بن حبيب السهمي(@)(@@) من أهل البصرة، يروي عن ابن هبيرة الأكبر، روى عنه ابنه عبد الله بن بكر السهمي.(@)(@@)(@@)(@@) ||| AUTO بكر بن الحكم اليربوعي التميمي، كنيته أبو بشر(@)(@@) من أهل البصرة، يروي عن يزيد الرقاشي، روى عنه حرمي بن عمارة، وهو الذي يقال له: بكر المزلق، الذي روى عنه حبان بن هلال.(@)(@@)(@@)(@@) ||| AUTO بكر بن ميمون(@)(@@) يروي عن الحسن، روى عنه حماد بن زيد.(@)(@@)(@@)(@@) ||| AUTO بكر بن مضر بن محمد بن حكيم بن سلمان(@)(@@) مولى شرحبيل بن حسنة القرشي، من أهل مصر، كنيته أبو محمد، وقد قيل: أبو عبد الملك، يروي عن أبي حازم المدني، وأهل المدينة، روى عنه قتيبة بن سعيد، وابنه إسحاق بن بكر بن مضر، مات يوم عرفة سنة أربع وسبعين ومائة، وصلى عليه داود بن يزيد بن حاتم، ودفن يوم عرفة.(@)PageV01P002(@)(@@) [ج 3: ص 236](@)(@@)(@@)(@@) ||| AUTO بكير بن أبي السميط المسمعي(@)(@@) مولى المسامعة، من أهل البصرة، يروي عن قتادة، روى عنه حبان بن هلال، ومسلم بن إبراهيم.(@)(@@)(@@)(@@) ||| AUTO بكير بن 
ms882	 مسمار(@)(@@) أخو مهاجر بن مسمار، مولى سعد بن أبي وقاص، من أهل المدينة، كنيته أبو محمد، يروي عن عامر بن سعد بن أبي وقاص، روى عنه حاتم بن إسماعيل، وليس هذا ببكير بن مسمار الذي يروي عن الزهري، ذاك ضعيف، ومات بكير هذا سنة ثلاث وخمسين ومائة.(@)(@@)(@@)(@@) ||| AUTO بكير بن الأخنس الليثي(@)(@@) من أهل الكوفة، يروي عن مجاهد، روى عنه أبو عوانة، وقد قيل: إنه سمع من أنس بن مالك.(@)(@@)(@@)(@@) ||| AUTO بكير بن عبد الله بن الأشج(@)(@@) مولى أشجع وكان من صلحاء الناس، من أهل المدينة، يروي عن نافع، روى عنه ابنه مخرمة بن بكير، مات بالمدينة سنة اثنتين وعشرين ومائة في ولاية هشام بن عبد الملك، وولي هشام لخمس بقين من شعبان سنة خمس ومائة، وكانت ولايته تسع عشرة سنة وأحد عشر شهرا.(@)(@@)(@@)(@@) ||| AUTO بكير بن عبد الله الطائي الطويل، وهو الذي يقال له: بكير الضخم(@)(@@) يروي عن مجاهد، روى عنه إسماعيل بن سميع.(@)(@@)(@@)(@@) ||| AUTO بكير، أبو عبد الله(@)(@@) يروي عن سعيد بن جبير، روى عنه أشعث بن سوار، إن لم يكن الضخم فلا أدري من هو.(@)(@@)(@@)(@@) ||| AUTO بكير بن شهاب الكوفي(@)(@@) يروي عن سعيد بن جبير، روى عنه مبارك بن سعيد الثوري، أخو سفيان.(@)PageV01P002(@)(@@) [ج 3: ص 237](@)(@@)(@@)(@@) ||| AUTO بكير بن عتيق العامري(@)(@@) من أهل الكوفة، يروي عن سعيد بن جبير، وسالم بن عبد الله، روى عنه سفيان الثوري.(@)(@@)(@@)(@@) ||| AUTO بكير بن عامر البجلي(@)(@@) كوفي، يروي عن الشعبي، وأبي زرعة بن عمرو بن جرير، روى عنه وكيع، وأبو نعيم.(@)(@@)(@@)(@@) ||| AUTO بكير، أبو نهيك(@)(@@) يروي عن زياد بن حدير، عن ابن عمر، روى عنه منصور بن المعتمر، وشعبة بن الحجاج.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO بكار بن شقير المازني(@)(@@) من أهل البصرة، يروي عن الحسن، وأبيه، وكان من العباد، روى عنه عبد الله بن أبي الأسود، وموسى بن إسماعيل.(@)(@@)(@@)(@@) ||| AUTO بكار بن عبد الله بن شهاب اليماني(@)(@@) شيخ يروي عن وهب بن منبه، روى عنه ابن المبارك، وعبد الرزاق، كان من الأبناء، وكان ينزل 
ms883	 الجند.(@)(@@)(@@)(@@) ||| AUTO بكار بن عبد العزيز بن أبي بكرة(@)(@@) يروي عن أبيه، روى عنه أبو عاصم النبيل.(@)(@@) (290) -[3: 237] حدثنا أبو يعلى، ثنا عمرو بن أبي عاصم، قال: ثنا أبي، قال: ثنا بكار بن عبد العزيز بن أبي بكرة عن أبيه، عن أبي بكرة، قال: " كان النبي صلى الله عليه وسلم إذا أتاه أمر يسر به خر ساجدا وشكر الله "(@)(@@) بكار(@)(@@) شيخ يروي عن عكرمة، روى عنه سحبل الأسلمي.(@)(@@)(@@)(@@) ||| AUTO بكار بن عبد الرحمن بن أبي بكرة البكراوي(@)(@@) من أهل البصرة، يروي عن الحسن، روى عنه موسى بن إسماعيل.(@)PageV01P002(@)(@@) [ج 3: ص 238](@)(@@)(@@)(@@) ||| AUTO بكار بن ماهان(@)(@@) يروي عن أنس بن سيرين، روى عنه عبد الصمد بن عبد الوارث، قال:(@)(@@) (291) -[3: 238] حدثنا محمد بن إسحاق الثقفي، قال: ثنا أحمد بن إبراهيم الدورقي، قال: ثنا عبد الصمد بن عبد الوارث، قال: ثنا بكار بن ماهان، قال: ثنا أنس بن سيرين عن أنس بن مالك أن رسول الله صلى الله عليه وسلم " كان يصلي على ناقته حيث توجهت به "(@)(@@)(@@)(@@) ||| AUTO بكار بن يحيى(@)(@@) يروي عن سعيد بن المسيب، روى عنه الفضل بن سليمان النميري.(@)(@@)(@@)(@@) ||| AUTO بكار الثقفي(@)(@@) يروي عن محمد بن علي، روى عنه عبد الله التوأم.(@)(@@)(@@)(@@) ||| AUTO بكار بن جارست بن محمد المدني(@)(@@) يروي عن موسى بن عقبة، عن أم خالد بنت خالد بن سعيد، عن النبي صلى الله عليه وسلم روى عنه إبراهيم بن المنذر الحزامي.(@)(@@)(@@)(@@) ||| AUTO بكار بن رشيد(@)(@@) شيخ يروي عن العراقيين، روى عنه أبو داود الطيالسي.(@)(@@)(@@)(@@) ||| AUTO بسر بن عبيد الله الحضرمي(@)(@@) من أهل الشام، يروي عن أبي إدريس الخولاني، وكان أحفظ أصحاب أبي إدريس، روى عنه عبد الرحمن بن يزيد بن جابر.(@)(@@)(@@)(@@) ||| AUTO بسر بن عطية(@)(@@) قال: سمعت نصر بن عاصم، يقول: من تعلم سورة البقرة فأحكمها، بعث يوم القيامة ونوره مثل ضوء النهار. رواه أحمد بن سعيد الدارمي، عن عبد الصمد بن عبد الوارث، عن عبد الجليل بن عطية، عن أخيه بسر بن عطية.(@)(@@)(@@)(@@) ||| AUTO البراء بن نوفل، أبو هنيدة 
ms884	(@)(@@) يروي عن والان العدوي، عن حذيفة، روى عنه سليمان التيمي، وأبو نعامة حريث بن مالك العدوي.(@)PageV01P002(@)(@@) [ج 3: ص 239](@)(@@)(@@)(@@) ||| AUTO البراء بن أبي نضرة(@)(@@) أخو عبد الملك بن أبي نضرة، يروي عن أبيه، عن ابن عباس، عن النبي صلى الله عليه وسلم: أنه كان يتعوذ من أربع: من عذاب القبر، وعذاب النار، ومن الفتن ما ظهر منها وما بطن، ومن فتنة الأعور الكذاب. روى عنه عاصم بن علي بن عاصم.(@)(@@)(@@)(@@) ||| AUTO البراء بن يزيد الهمداني(@)(@@) يروي عن الشعبي، روى عنه وكيع بن الجراح.(@)(@@)(@@)(@@) ||| AUTO البراء بن قبيصة بن أبي عقيل الثعلبي(@)(@@) يروي عن مجاهد، وشريح، روى عنه أهل العراق.(@)(@@)(@@)(@@) ||| AUTO البراء بن سلمان الضبي، وقد قيل: ابن سليمان(@)(@@) يروي عن الشعبي، وعطاء، روى عنه ابن المبارك، والفريابي.(@)(@@)(@@)(@@) ||| AUTO بسطام بن مسلم العدوي(@)(@@) من أهل البصرة، يروي عن أبي رجاء العطاردي، وابن سيرين، ومالك بن دينار، روى عنه جعفر بن سليمان الضبعي، وأبو داود الطيالسي.(@)(@@)(@@)(@@) ||| AUTO بسطام بن النضر(@)(@@) أبو النضر الكوفي، يروي عن أعرابي، عن أبيه، عن النبي صلى الله عليه وسلم روى عنه عمرو بن فروخ، وقد قيل: عمرو بن بسطام بن النضر.(@)(@@)(@@)(@@) ||| AUTO بسطام بن سويد(@)(@@) يروي عن إبراهيم النخعي، روى عنه عبد الرحمن بن مهدي.(@)(@@)(@@)(@@) ||| AUTO بسطام بن وائل(@)(@@) يروي عن وهب بن منبه، روى عنه عبد الصمد بن عبد الوارث، وهو الذي يقال له: بسطام الجذمي.(@)(@@)(@@)(@@) ||| AUTO بسطام بن جميل(@)(@@) شيخ يروي عن يوسف بن عمر، روى عنه محمد بن المهاجر الشامي.(@)(@@)(@@)(@@) ||| AUTO بسطام بن حريث الأصفر، كنيته أبو يحيى(@)(@@) من أهل البصرة، يروي عن PageV01P002 [ج 3: ص 240] أشعث الحداني، عن أنس، روى عنه سليمان بن حرب، وما أرى الأشعث سمع أنسا.(@)(@@)(@@)(@@) ||| AUTO بحر بن سعيد(@)(@@) من أهل البصرة، يروي عن بشير بن نهيك، روى عنه عبيدة بن عبد الرحمن.(@)(@@)(@@)(@@) ||| AUTO بحر بن زياد(@)(@@) يروي عن نافع، روى عنه يحيى بن أبي كثير.(@)(@@)(@@)(@@) ||| AUTO بحر بن موسى، أبو داود(@)(@@) يروي عن الحسن، عداده في أهل البصرة، روى عنه 
ms885	 الثوري، وموسى بن إسماعيل.(@)(@@)(@@)(@@) ||| AUTO بحر بن مسيك(@)(@@) يروي عن مكحول الشامي، روى عنه ابن لهيعة.(@)(@@)(@@)(@@) ||| AUTO بشار بن كدام الهلالي(@)(@@) أخو مسعر بن كدام، يروي عن عمرو بن دينار، ومحمد بن زيد بن عبد الله بن عمر، روى عنه أبو معاوية الضرير.(@)(@@)(@@)(@@) ||| AUTO بشار بن أبي سيف الجرمي الشامي(@)(@@) يروي عن الوليد بن عبد الرحمن، روى عنه واصل مولى أبي عيينة، وجرير بن حازم.(@)(@@)(@@)(@@) ||| AUTO بشار بن عبد الملك المزني(@)(@@) من أهل البصرة، يروي عن أم حكيم، عن مولاتها أم إسحاق الغنوية، روى عنه موسى بن إسماعيل.(@)(@@)(@@)(@@) ||| AUTO بزيع، أبو الهيثم(@)(@@) يروي عن عكرمة، وأبي مجلز، من أهل مرو، روى عنه علي بن الحسن بن شقيق، وعيسى بن موسى الغنجار.(@)(@@)(@@)(@@) ||| AUTO بزيع العطار(@)(@@) يروي عن الحسن، عداده في أهل البصرة، روى عنه موسى بن إسماعيل.(@)PageV01P002(@)(@@) [ج 3: ص 241](@)(@@)(@@)(@@) ||| AUTO بزيع، أبو عمرو(@)(@@) مولى بني مخزوم، يروي عن يحيى بن سعيد الأنصاري، وعبيد الله بن عمر، روى عنه المعتمر بن سليمان.(@)(@@)(@@)(@@) ||| AUTO بزيع بن عبد الرحمن(@)(@@) يروي عن سوادة، روى عنه إسماعيل بن عياش.(@)(@@)(@@)(@@) ||| AUTO بزيع الضرير(@)(@@) يروي عن الحجاج، روى عنه المغيرة بن مقسم.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO برد بن سنان الشامي، كنيته أبو العلاء(@)(@@) مولى قريش، سكن البصرة، يروي عن مكحول، ونافع، روى عنه الثوري، وأهل العراق، مات سنة خمس وثلاثين ومائة.(@)(@@) برد(@)(@@) مولى سعيد بن المسيب القرشي، من أهل المدينة، يروي عن سعيد بن المسيب، روى عنه عبد الرحمن بن حرملة، كان يخطئ، وأهل الحجاز يسمون الخطأ كذبا.(@)(@@)(@@)(@@) ||| AUTO برد، بياع الحرير(@)(@@) يروي عن حبيب بن أبي ثابت، عداده في أهل الكوفة، روى عنه محمد بن عبيد الطنافسي.(@)(@@)(@@)(@@) ||| AUTO برد بن أبي زياد(@)(@@) أخو يزيد بن أبي زياد مولى بني هاشم، من أهل الكوفة، روى عنه أبو عمر، وقد قيل: أبو عمرو، ويروي عن العراقيين، روى عنه جرير بن عبد الحميد.(@)(@@)(@@)(@@) ||| AUTO برد بن عرين(@)(@@) من أهل البصرة، يروي عن عمته زينب، عن عائشة، روى عنه عثمان بن غياث.(@)(@@)(@@)(@@) ||| AUTO 
ms886	 البختري بن مختار العبدي(@)(@@) يروي عن أبي بردة، وأبي بكر ابني موسى، روى PageV01P002 [ج 3: ص 242] عنه أهل العراق، مات سنة ثمان وأربعين ومائة، وكان يخطئ.(@)(@@)(@@)(@@) ||| AUTO البختري بن يزيد بن حارثة الأنصاري(@)(@@) كان يجالس الثوري، وشعبة، يروي عن العراقيين، روى عنه داود بن يزيد الأودي.(@)(@@)(@@)(@@) ||| AUTO بحير بن سعد السحولي(@)(@@) من أهل حمص، يروي عن خالد بن معدان، روى عنه معاوية بن صالح.(@)(@@)(@@)(@@) ||| AUTO بحير المعافري(@)(@@) وكان على حرس عبد العزيز بن مروان، يروي عن عبد العزيز بن مروان، عن أبي هريرة، روى عنه ابنه علي بن بحير.(@)(@@)(@@)(@@) ||| AUTO بريد بن عبد الله بن أبي بردة بن أبي موسى الأشعري، كنيته أبو بردة(@)(@@) من أهل الكوفة، يروي عن جده أبي بردة، روى عنه الثوري، وأبو أسامة، كان يخطئ.(@)(@@)(@@)(@@) ||| AUTO بدر بن خليل الأسدي(@)(@@) من أهل الكوفة، يروي عن أبي وائل، روى عنه وكيع، وأبو أسامة.(@)(@@)(@@)(@@) ||| AUTO بدر بن عثمان(@)(@@) مولى عثمان بن عفان، يروي عن عكرمة، روى عنه مخلد بن يزيد، وأبو نعيم.(@)(@@)(@@)(@@) ||| AUTO بدر بن حويزة(@)(@@) يروي عن الكوفيين، روى عنه عبد الله بن داود الخريبي، وقد كتب عبد الله بن داود عن هؤلاء ثلاثتهم.(@)(@@)(@@)(@@) ||| AUTO بديل بن شداد(@)(@@) شيخ يروي عن عكرمة، روى عنه يحيى بن واضح، أبو تميلة.(@)PageV01P002(@)(@@) [ج 3: ص 243](@)(@@)(@@)(@@) ||| AUTO بديل بن ميسرة العقيلي(@)(@@) من أهل البصرة، يروي عن عبد الله بن شقيق، وأبي الجوزاء، روى عنه شعبة، وحماد بن زيد، مات سنة ثلاثين ومائة، وقد قيل سنة خمس وعشرين ومائة.(@)(@@)(@@)(@@) ||| AUTO بديل بن الوضاح(@)(@@) من أهل الكوفة، كنيته أبو بحر، يروي عن يحيى بن وثاب، روى عنه إسحاق بن إبراهيم، قاضي سمرقند.(@)(@@)(@@)(@@) ||| AUTO بيهس(@)(@@) مولى المفضل بن أبي المهلب الأزدي، من أهل البصرة، يروي عن جابر بن زيد، روى عنه حماد بن زيد.(@)(@@)(@@)(@@) ||| AUTO بيهس الباهلي(@)(@@) يروي عن كعب، روى عنه ابنه إياس بن بيهس.(@)(@@)(@@)(@@) ||| AUTO بيهس بن فهدان البصري الأزدي(@)(@@) يروي عن أبي، شيخ الهنائي، روى عنه شعبة، ووكيع.(@)(@@)(@@)(@@) ||| AUTO بجاد بن موسى بن 
ms887	 سعد بن أبي وقاص الزهري(@)(@@) يروي المراسيل، روى عنه حماد بن سلمة.(@)(@@)(@@)(@@) ||| AUTO باذان، أبو إسحاق(@)(@@) شيخ يروي عن سعيد بن جبير، روى عنه نوح بن ربيعة.(@)(@@)(@@)(@@) ||| AUTO بركة الأزدي(@)(@@) من أهل الشام، يروي عن مكحول، روى عنه محمد بن مهاجر.(@)PageV01P002(@)(@@) [ج 3: ص 244](@)(@@)(@@)(@@) ||| AUTO بلج بن عبد الله المهري(@)(@@) يروي عن أبي شيبة المهري عن ثوبان، روى شعبة، عن أبي الجودي عنه.(@)(@@)(@@)(@@) ||| AUTO بلج بن إياس، أبو صخر المروزي(@)(@@) يروي عن العراقيين، روى عنه أهل بلده.(@)(@@)(@@)(@@) ||| AUTO بهدل، أبو الوضاح الشيباني(@)(@@) يروي عن العراقيين، روى عنه يونس بن أبي إسحاق السبيعي.(@)(@@)(@@)(@@) ||| AUTO بسام بن عبد الله الصيرفي(@)(@@) مولى عبد رب، يروي عن أبي جعفر محمد بن علي، روى عنه أبو أحمد الزبيري، وأهل الكوفة، يخطئ.(@)(@@)(@@)(@@) ||| AUTO بلهط بن عباد(@)(@@) يروي عن محمد بن المنكدر، عن جابر، قال: شكونا إلى رسول الله صلى الله عليه وسلم حر الرمضاء، فلم يشكنا. روى عنه عبد المجيد بن عبد العزيز بن أبي رواد من حديث ابن أبي عمر العدني.(@)(@@)(@@)(@@) ||| AUTO برمة بن ليث بن جارية بن برمة الأسدي(@)(@@) يروي عن قبيصة بن برمة، روى عنه نصير بن عمر بن يزيد بن قبيصة بن برمة.(@)(@@)(@@)(@@) ||| AUTO بريه بن عمر بن سفينة(@)(@@) مولى النبي صلى الله عليه وسلم يروي عن أبيه، روى عنه ابن أبي فديك، كان ممن يخطئ.(@)(@@)(@@)(@@) ||| AUTO بقية بن شعبان الزهراني(@)(@@) من أهل البصرة، يروي عن الحسن، وثابت، روى عنه إبراهيم بن عبد الله البصري.(@)PageV01P002(@)(@@) [ج 3: ص 245](@)(@@)(@@)(@@) || AUTO باب التاء(@)(@@) قال أبو حاتم:(@)(@@) وممن روى عن التابعين من الثقات ممن ابتدأ اسمه على التاء:(@)(@@)(@@)(@@) ||| AUTO توبة بن كيسان العنبري، أبو المورع(@)(@@) يروي عن الشعبي، ونافع، وعكرمة بن خالد، روى عنه الثوري، وشعبة، وقد(@)(@@) (292) -[3: 245] روى زيد بن الحباب، عن مطيع بن راشد، قال: حدثنا توبة العنبري، قال: ثنا أنس بن مالك، أن النبي صلى الله عليه وسلم: شرب لبنا فلم يتمضمض ولم يتوضأ وصلى. فإن صح هذا فهو من التابعين، وقد ذكرناه في التابعين 
ms888	(@)(@@)(@@)(@@) ||| AUTO توبة بن سعد المروزي(@)(@@) يروي عن العراقيين، روى عنه أهل بلده، مات سنة ثمان وسبعين ومائة.(@)(@@)(@@)(@@) ||| AUTO توبة الهلالي(@)(@@) شيخ يروي عن العراقيين، روى عنه شعبة بن الحجاج.(@)(@@)(@@)(@@) ||| AUTO توبة بن سالم(@)(@@) من أهل الكوفة، وكان مكتب النخع، كنيته أبو سالم، يروي عن زر بن حبيش، روى عنه مروان بن معاوية الفزاري.(@)(@@)(@@)(@@) ||| AUTO تميم بن عبيد بن عامر المري(@)(@@) من أهل البصرة، يروي عن الحسن، روى عنه موسى بن إسماعيل.(@)(@@)(@@)(@@) ||| AUTO تميم بن عبد الرحمن(@)(@@) من أهل اليمن، يروي عن عطاء، وسعيد بن جبير، روى عنه معمر، وعمران، أبو الهذيل، وهو خال أم هشام بن يوسف.(@)(@@)(@@)(@@) ||| AUTO تميم بن خلف(@)(@@) يروي عن الشعبي، روى عنه عبيد الله بن عبد الرحمن الأشجعي.(@)(@@)(@@)(@@) ||| AUTO تميم بن عطية العنسي(@)(@@) يروي عن مكحول، روى عنه الوليد بن مسلم، عداده في أهل الشام.(@)PageV01P002(@)(@@) [ج 3: ص 246](@)(@@)(@@)(@@) ||| AUTO تميم بن سحيم(@)(@@) يروي عن أهل المدينة، روى عنه سعيد بن أبي أيوب.(@)(@@)(@@)(@@) ||| AUTO تميم بن نمر(@)(@@) من أهل مصر، يروي عن أبي عفير، عريف بني سريع، عن عبد الله بن عمر، روى عنه الليث بن سعد.(@)(@@)(@@)(@@) ||| AUTO تمام بن أبي الحكم(@)(@@) يروي عن الحسن: المقاطيع، روى عنه حماد بن سلمة.(@)(@@)(@@)(@@) ||| AUTO تبيع(@)(@@) ابن امرأة كعب الأحبار، من حمير، كنيته أبو عبيد، يروي عن كعب، ومجاهد، روى عنه أهل مصر.(@)(@@)(@@)(@@) ||| AUTO تواب بن حجيل، وقد قيل ثواب(@)(@@) يروي عن الحسن، وثابت، عداده في أهل البصرة، روى عنه التبوذكي.(@)(@@)(@@)(@@) || AUTO باب الثاء(@)(@@) قال أبو حاتم:(@)(@@) وممن روى عن التابعين من أهل الصدق ممن ابتدأ اسمه على الثاء:(@)(@@)(@@)(@@) ||| AUTO ثابت بن يزيد، أبو زيد الأحول(@)(@@) من أهل البصرة، يروي عن عاصم الأحول، وهلال بن خباب، روى عنه أبو داود الطيالسي، وأهل العراق، وكان عطارا بالبصرة.(@)(@@)(@@)(@@) ||| AUTO ثابت بن يزيد الأودي، كنيته أبو السري(@)(@@) يروي عن عمرو بن ميمون، عن عمر، روى عنه يحيى بن سعيد القطان.(@)PageV01P002(@)(@@) [ج 3: ص 247](@)(@@)(@@)(@@) ||| AUTO ثابت بن قيس(@)(@@) يروي عن عراك بن مالك، عن أبي هريرة، 
ms889	 عن النبي صلى الله عليه وسلم: غفار غفر الله لها، وأسلم سالمها الله. روى عنه زياد بن يونس الإسكندراني.(@)(@@)(@@)(@@) ||| AUTO ثابت بن معبد(@)(@@) يروي عن عمه، روى عنه عبد الملك بن عمير.(@)(@@)(@@)(@@) ||| AUTO ثابت بن ثابت بن عبد الله بن الزبير(@)(@@) أخو مصعب بن ثابت، كنيته أبو عبد الله، يروي عن جماعة من التابعين، روى عنه أهل المدينة، مات سنة خمس وخمسين ومائة.(@)(@@)(@@)(@@) ||| AUTO ثابت بن هريمز(@)(@@) يروي عن عباد، عن علي، روى عنه أهل العراق، ومن زعم أنه ثابت بن هرمز فإنما تورع عن التصغير.(@)(@@)(@@)(@@) ||| AUTO ثابت بن سعيد، وقد قيل: ابن معبد(@)(@@) يروي المقاطيع، روى عنه الأوزاعي.(@)(@@)(@@)(@@) ||| AUTO ثابت بن عبيد الله بن أبي بكرة(@)(@@) يروي عن أبيه، عن أبي بكرة، روى عنه الحكم بن ظهير، يعتبر بحديثه من غير رواية الحكم بن ظهير عنه.(@)(@@)(@@)(@@) ||| AUTO ثابت بن سعيد بن أبيض بن حمال المأربي(@)(@@) ومأرب موضع باليمن، يروي عن أبيه، عن جده، عداده في أهل اليمن، روى عنه فرج بن سعيد بن علقمة بن سعيد بن أبيض بن حمال المأربي.(@)(@@)(@@)(@@) ||| AUTO ثابت بن عجلان الأنصاري(@)(@@) من أهل الشام، يروي عن عطاء، وسعيد بن جبير، وسليم بن عامر، روى عنه أهل بلده، وقد قيل: إنه سمع أنسا، ولم أر ذلك بصحيح.(@)PageV01P002(@)(@@) [ج 3: ص 248](@)(@@)(@@)(@@) ||| AUTO ثابت بن ثوبان العبسي(@)(@@) من أهل دمشق، يروي عن مكحول، ونافع، روى عنه ابنه عبد الرحمن بن ثابت بن ثوبان.(@)(@@)(@@)(@@) ||| AUTO ثابت بن اللجلاج الكلابي(@)(@@) يروي عن أبي بردة، وعبد الله بن سيدان، روى عنه جعفر بن برقان.(@)(@@)(@@)(@@) ||| AUTO ثابت، أبو سعيد(@)(@@) شيخ، كان بالري، يروي عن يحيى بن يعمر، روى عنه محمد بن أبي الوضاح.(@)(@@)(@@)(@@) ||| AUTO ثابت السعدي(@)(@@) من أهل البصرة، يروي عن جابر بن زيد، روى عنه حماد بن زيد، وجرير بن حازم.(@)(@@)(@@)(@@) ||| AUTO ثابت بن زياد(@)(@@) شيخ يروي عن ابن سيرين، روى عنه مالك بن مغول.(@)(@@)(@@)(@@) ||| AUTO ثابت بن عبيد(@)(@@) يروي عن القاسم بن محمد، عن عائشة، روى عنه الأعمش.(@)(@@)(@@)(@@) ||| AUTO ثابت 
ms890	 بن سهل القرشي(@)(@@) يروي عن أبي الحويرث، روى عنه يوسف بن يزيد.(@)(@@)(@@)(@@) ||| AUTO ثابت بن الحجاج بن جميع(@)(@@) من ولد عامر بن صعصعة، روى عن جماعة من التابعين، عداده في أهل الجزيرة، روى عنه أهلها.(@)(@@)(@@)(@@) ||| AUTO ثابت بن عمارة الحنفي(@)(@@) من أهل البصرة، يروي عن غنيم بن قيس، روى عنه وكيع بن الجراح، ويحيى بن سعيد القطان، مات سنة تسع وأربعين ومائة.(@)(@@)(@@)(@@) ||| AUTO ثمامة بن بجاد(@)(@@) رجل من عبد القيس، قيل له في مرضه: أوصنا، قال: أنذركم سوف. روى عنه أبو إسحاق السبيعي.(@)PageV01P002(@)(@@) [ج 3: ص 249](@)(@@)(@@)(@@) ||| AUTO ثمامة بن كلاب(@)(@@) يروي عن أبي سلمة بن عبد الرحمن، روى عنه يحيى بن أبي كثير.(@)(@@)(@@)(@@) ||| AUTO ثمامة بن قيس(@)(@@) يروي عن هرمي بن عبد الله، روى عنه محمد بن إسحاق.(@)(@@)(@@)(@@) ||| AUTO ثعلبة الأسدي(@)(@@) شيخ يروي عن عبد الله بن بريدة، روى عنه سعيد بن أبي هلال.(@)(@@)(@@)(@@) ||| AUTO ثعلبة بن بلال العبدي الأعمى(@)(@@) من أهل البصرة، يروي عن عبيد الله بن أبي بكر بن أنس، روى عنه القواريري.(@)(@@)(@@)(@@) ||| AUTO ثعلبة بن سهيل(@)(@@) يروي عن الزهري أنه قال: إنما كره المنديل بعد الوضوء لأن كل قطرة توزن. روى عنه جرير بن عبد الحميد الضبي.(@)(@@)(@@)(@@) ||| AUTO ثور بن زيد الديلي(@)(@@) من أهل المدينة، يروي عن عكرمة، وأبي الغيث، روى عنه مالك بن أنس، وسليمان بن بلال، مات سنة خمس وثلاثين ومائة.(@)(@@)(@@)(@@) ||| AUTO ثور بن يزيد الكلاعي، كنيته أبو خالد(@)(@@) من أهل الشام، يروي عن خالد بن معدان، روى عنه عيسى بن يونس، وأهل بلده، قدم العراق، فكتب عنه الثوري، وأهل العراق، مات سنة خمس وخمسين ومائة ببيت المقدس، وكان قدريا، كان له يوم، مات سبعون سنة.(@)PageV01P002(@)(@@) [ج 3: ص 250](@)(@@)(@@)(@@) ||| AUTO ثور الهمداني(@)(@@) من أهل الكوفة، يروي عن إبراهيم التيمي، روى عنه مسعر بن كدام.(@)(@@)(@@)(@@) ||| AUTO ثبيت الضبي(@)(@@) شيخ يروي عن يحيى بن سعيد الأنصاري، روى عنه يحيى بن حمزة، وأحسبه ثبيت بن كثير الذي روى عنه يحيى بن عثمان بن سعيد بن كثير بن دينار العابد.(@)(@@)(@@)(@@) ||| AUTO 
ms891	 ثبات بن ميمون(@)(@@) يروي عن نافع، وعبد الله بن يزيد بن هرمز، روى عنه عمر بن طلحة، وأيوب بن ثابت.(@)(@@)(@@)(@@) ||| AUTO ثواب بن عتبة المهري(@)(@@) من أهل البصرة، يروي عن عبد الله بن بريدة، روى عنه شعبة، وأبو عاصم النبيل، وأهل البصرة.(@)(@@)(@@)(@@) ||| AUTO ثوابة بن رافع(@)(@@) يروي عن أبي حازم أنه قال: وما الدنيا أما ما مضى منها فحلم، وأما ما بقي منها فأماني. روى عنه ضمرة بن ربيعة.(@)(@@)(@@)(@@) ||| AUTO ثوابة بن عون التنوخي(@)(@@) من أهل حمص، كان يسكن بحماة، يروي عن عمرو بن قيس السكوني، روى عنه إبراهيم بن العلاء الزبيدي، وكنية ثوابة: أبو عون، وقد قيل: أبو عثمان.(@)(@@)(@@)(@@) ||| AUTO ثوابة بن مسعود التنوخي(@)(@@) يروي عن عثمان بن عطاء الخراساني، روى عنه عبد الله بن وهب.(@)(@@)(@@)(@@) ||| AUTO ثهلان بن قبيصة، أبو قبيصة السعدي(@)(@@) من أهل البصرة، يروي عن ابن سيرين، روى عنه ابنه حنظلة بن ثهلان.(@)PageV01P002(@)(@@) [ج 3: ص 251](@)(@@)(@@)(@@) || AUTO باب الجيم(@)(@@) قال أبو حاتم، رضي الله عنه:(@)(@@)(@@)(@@) || AUTO ومن أتباع التابعين الذين رووا عن التابعين ممن ابتدأ اسمه على الجيم:(@)(@@)(@@)(@@) ||| AUTO جعفر بن محمد بن علي بن الحسين بن علي بن أبي طالب(@)(@@) رضوان الله عليهم، كنيته أبو عبد الله، يروي عن أبيه، وكان من سادات أهل البيت فقها وعلما وفضلا، روى عنه الثوري، ومالك، وشعبة، والناس، وكان مولده سنة ثمانين، سنة سيل الجحاف الذي ذهب بالحاج من مكة، ومات سنة ثمان وأربعين ومائة، وهو ابن ثمان وستين سنة، يحتج بروايته ما كان من غير رواية أولاده عنه، لأن في حديث ولده عنه مناكير كثيرة، وإنما مرض القول فيه من مرض من أئمتنا لما رأوا في حديثه من رواية أولاده، وقد اعتبرت حديثه من الثقات عنه، مثل ابن جريج، والثوري، ومالك، وشعبة، وابن عيينة، ووهب بن خالد، ودونهم، فرأيت أحاديث مستقيمة ليس فيها شيء يخالف حديث الأثبات، ورأيت في رواية ولده عنه أشياء ليس من حديثه ولا من حديث أبيه، ولا من حديث جده، ومن المحال أن يلزق به 
ms892	 ما جنت يدا غيره، وأم جعفر بن محمد، أم فروة بنت القاسم بن محمد بن أبي بكر الصديق رضي الله تعالى عنه.(@)(@@)(@@)(@@) ||| AUTO جعفر بن تمام بن العباس بن عبد المطلب الهاشمي(@)(@@) يروي عن أبيه، عن العباس، روى عنه ابن أبي ذئب.(@)(@@)(@@)(@@) ||| AUTO جعفر بن ربيعة بن شرحبيل بن حسنة القرشي(@)(@@) من أهل مصر، يروي عن الأعرج، وعراك بن مالك، روى عنه الليث بن سعد، ويحيى بن أيوب، مات بعد سنة ثلاث وثلاثين ومائة عند دخول المسودة مصر.(@)PageV01P002(@)(@@) [ج 3: ص 252](@)(@@)(@@)(@@) ||| AUTO جعفر بن زيد بن صحار(@)(@@) يروي المقاطيع، روى عنه أبو إسحاق السبيعي.(@)(@@)(@@)(@@) ||| AUTO جعفر بن زيد العبدي(@)(@@) من أهل البصرة، يروي عن أبيه، روى عنه أبو عاصم النبيل.(@)(@@)(@@)(@@) ||| AUTO جعفر بن أبي وحشية اليشكري، كنيته أبو بشر، وهو جعفر بن إياس(@)(@@) اسم أبي وحشية: إياس، من أهل البصرة، يروي عن سعيد بن جبير، ونافع، روى عنه الأعمش، وشعبة، وأيوب، وأهل العراق، مات سنة ثلاث أو أربع وعشرين ومائة، وقد قيل: إنه مات سنة إحدى وثلاثين ومائة في الطاعون.(@)(@@)(@@)(@@) ||| AUTO جعفر بن مصعب بن الزبير بن العوام(@)(@@) من أهل الحجاز، يروي عن عروة بن الزبير، روى عنه الزبير بن عبد الله، وهو أخو عمرو بن مصعب بن الزبير.(@)(@@)(@@)(@@) ||| AUTO جعفر بن محمد بن خالد بن الزبير بن العوام(@)(@@) يروي عن هشام بن عروة، والحجازيين، روى عنه خالد بن مخلد القطواني، وقطوان: سكة بالكوفة.(@)(@@)(@@)(@@) ||| AUTO جعفر بن عبد الرحمن(@)(@@) يروي عن خارجة بن العوام عن أبي هريرة، روى عنه عبد الله بن عثمان بن خثيم.(@)(@@)(@@)(@@) ||| AUTO جعفر بن أبي المغيرة الخزاعي(@)(@@) يروي عن سعيد بن جبير، روى عنه مطرف بن طريف، ويعقوب القمي.(@)(@@)(@@)(@@) ||| AUTO جعفر بن أبي ثروان الحارثي(@)(@@) يروي عن ابن النباح، عن علي، روى عنه أبو جعفر.(@)PageV01P002(@)(@@) [ج 3: ص 253](@)(@@)(@@)(@@) ||| AUTO جعفر بن عبد الرحمن، أبو عبد الرحمن الأنصاري(@)(@@) شيخ، كان بواسط، يروي عن أبي طارق، وحكيم بن سعد، روى عنه الأعمش.(@)(@@)(@@)(@@) ||| AUTO جعفر بن خالد بن سارة المخزومي(@)(@@) من 
ms893	 أهل مكة، يروي عن أبيه، روى عنه ابن جريج، وابن عيينة.(@)(@@)(@@)(@@) ||| AUTO جعفر بن عبد الله بن مهزم الكندي(@)(@@) يروي عن قرط بن عمارة، روى عنه أهل الحجاز.(@)(@@)(@@)(@@) ||| AUTO جعفر بن ميمون، أبو على(@)(@@) بياع الأنماط، من أهل البصرة، يروي عن أبي عثمان النهدي، روى عنه سفيان الثوري، ويحيى بن سعيد القطان.(@)(@@)(@@)(@@) ||| AUTO جعفر بن عبد الله بن الحكم بن رافع بن سنان الأنصاري الأوسي(@)(@@) والد عبد الحميد بن جعفر، من أهل المدينة، يروي عن علباء السلمي، والحكم بن مسلم، وتميم بن محمود، روى عنه ابنه عبد الحميد بن جعفر، والليث بن سعد، وقد قيل: إنه سمع أنس بن مالك إن كان حفظه أبو بكر الحنفي، وقد ذكرناه في كتاب التابعين.(@)(@@)(@@)(@@) ||| AUTO جعفر بن عبد الله بن أسلم(@)(@@) مولى عمر بن الخطاب، من أهل المدينة، وهو ابن أخي زيد بن أسلم، يروي عن عمه زيد بن أسلم، روى عنه محمد بن إسحاق بن يسار.(@)(@@)(@@)(@@) ||| AUTO جعفر بن محمد بن عباد بن جعفر المخزومي(@)(@@) من أهل الحجاز، يروي عن أبيه، روى عنه محمد بن سليمان بن مسمول.(@)PageV01P002(@)(@@) [ج 3: ص 254](@)(@@)(@@)(@@) ||| AUTO جعفر بن برقان الجزري(@)(@@) مولى بني كلاب، كنيته أبو عبد الله، يروي عن ميمون بن مهران، والزهري، وكان أميا، يروي عنه أهل بلده، قدم الكوفة، فكتب عنه الثوري، وأهل العراق، مات سنة أربع وخمسين ومائة وهو ذاهبا إلى بيت المقدس، وهو ابن أربع وأربعين سنة، وقد قيل: إن جعفرا، مات سنة سبع وأربعين ومائة، والأول الأصح.(@)(@@)(@@)(@@) ||| AUTO جعفر بن نصر(@)(@@) شيخ يروي عن سعيد بن جبير، روى عنه فطر بن خليفة.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO جعفر بن أبي كثير الأنصاري(@)(@@) مولى بني زريق، من أهل المدينة، يروي عن أبيه، وعثمان بن صهيب، روى عنه ابنه إسماعيل بن جعفر المدني.(@)(@@)(@@)(@@) ||| AUTO جعفر بن علي بن أبي رافع(@)(@@) يروي عن عمه، روى عنه خلف بن خليفة.(@)(@@) جعفر بن أبي كثير(@)(@@) شيخ من أهل البصرة، يروي المراسيل، روى عنه بكر بن كليب.(@)(@@)(@@)(@@) ||| AUTO جعفر بن سعد 
ms894	 بن عبيد الله الكاهلي(@)(@@) يروي عن الأعمش، وأبيه، وسلام الكاهلي، روى عنه مروان بن معاوية، وعبد الجبار بن العباس.(@)(@@)(@@)(@@) ||| AUTO جعفر بن سعد بن سمرة بن جندب الفزاري(@)(@@) يروي عن خبيب بن سليمان، روى عنه محمد بن إبراهيم بن خبيب.(@)(@@)(@@)(@@) ||| AUTO جعفر بن عطية الخراز(@)(@@) من أهل البصرة، كنيته أبو عمرو الذهلي، يروي عن ابن سيرين، وثابت، روى عنه بشر بن الحكم.(@)(@@)(@@)(@@) ||| AUTO جعفر بن يحيى بن ثوبان(@)(@@) يروي عن عمه عمارة بن ثوبان، عداده في أهل الحجاز، روى عنه أبو عاصم النبيل.(@)PageV01P002(@)(@@) [ج 3: ص 255](@)(@@)(@@)(@@) ||| AUTO جعفر بن كيسان(@)(@@) مولى بني عدي، من أهل البصرة، كنيته أبو معروف، يروي عن معاذة العدوية، روى عنه أبو عامر العقدي.(@)(@@)(@@)(@@) ||| AUTO جعفر بن المعذل(@)(@@) شيخ يروي المراسيل، روى عنه أسامة بن زيد.(@)(@@)(@@)(@@) ||| AUTO جعفر بن عمران(@)(@@) يروي عن الحسن، روى عنه عبد الله بن المبارك.(@)(@@)(@@)(@@) ||| AUTO جعفر بن عبيد الله بن أبي رافع(@)(@@) مولى رسول الله صلى الله عليه وسلم يروي عن أبيه، وقد روى عن المسور بن مخرمة، وما أراه بمتصل، فلذلك لم أدخله في التابعين، روى عنه عبد الله بن جعفر المخزومي.(@)(@@)(@@)(@@) ||| AUTO جعفر بن الحارث، أبو الأشهب الواسطي(@)(@@) يروي عن الأعمش، والكوفيين، روى عنه محمد بن يزيد الواسطي، ثقة ثقة، وليس هذا بأبي الأشهب العطاردي، ذلك بصري، وهذا من أهل واسط، وجميعا ثقتان.(@)(@@)(@@)(@@) ||| AUTO جعفر بن برد الخراز(@)(@@) من أهل البصرة، يروي عن أم سالم بنت مالك، عن عائشة، روى عنه حرمي بن عمارة.(@)(@@)(@@)(@@) ||| AUTO جعفر بن حيان العطاردي، كنيته أبو الأشهب الحذاء(@)(@@) من أهل البصرة، يروي عن أبي رجاء العطاردي، والحسن، روى عنه وكيع، وأهل العراق، كان مولده سنة سبعين، ومات في آخر يوم من شعبان سنة خمس وستين ومائة وكان قد عمي PageV01P002 [ج 3: ص 256] في آخر عمره، وقد قيل مات سنة اثنتين وستين ومائة.(@)(@@)(@@)(@@) ||| AUTO جعفر بن نجيح(@)(@@) شيخ يروي عن عطاء، وعبد الرحمن بن القاسم، روى حميد بن عبد الرحمن الرؤاسي، عن أبيه، عنه.(@)(@@)(@@)(@@) ||| AUTO جعفر بن 
ms895	 سليمان الضبعي الجرشي(@)(@@) من أهل البصرة، كنيته أبو سليمان، كان ينزل في بني ضبيعة فنسب إليها، يروي عن ثابت، ومالك بن دينار، روى عنه ابن المبارك، وأهل العراق، مات في رجب سنة ثمان وسبعين ومائة، وكان يبغض الشيخين.(@)(@@) (293) -[3: 256] حدثنا الحسن بن سفيان، قال: ثنا إسحاق بن أبي كامل، قال: ثنا جرير بن يزيد بن هارون، بين يدي أبيه، قال: بعثني أبي إلى جعفر بن سليمان الضبعي، فقلت له: بلغنا أنك تسب أبا بكر وعمر، قال: أما السب فلا ولكن البغض ما شئت، قال: وإذا هو رافضي مثل الحمار. قال أبو حاتم: وكان جعفر بن سليمان من الثقات المتقنين في الروايات، غير أنه كان ينتحل الميل إلى أهل البيت، ولم يكن بداعية إلى مذهبه، وليس بين أهل الحديث من أئمتنا خلاف أن الصدوق المتقن إذا كان فيه بدعة ولم يكن يدعو إليها أن الاحتجاج بأخباره جائز، فإذا دعا إلى بدعته سقط الاحتجاج بأخباره، ولهذه العلة ما تركوا حديث جماعة ممن كانوا ينتحلون البدع ويدعون إليها وإن كانوا ثقات، واحتججنا بأقوام ثقات انتحالهم كانتحالهم سواء، غير أنهم لم يكونوا يدعون إلى ما ينتحلون، وانتحال العبد بينه وبين ربه، إن شاء عذبه وإن شاء عفا عنه، وعلينا قبول الروايات عنهم إذا كانوا ثقات على حسب ما ذكرناه في غير موضع من كتبنا.(@)(@@)(@@)(@@) ||| AUTO جعفر بن عون بن جعفر بن عمرو بن حريث بن عثمان بن عمرو بن عبد الله بن عمر بن مخزوم المخزومي القرشي، كنيته أبو عون(@)(@@) من أهل الكوفة، يروي عن يحيى بن سعيد الأنصاري، مات منصرفا من الحج في رجب أو شعبان سنة سبع ومائتين، وهو ابن سبع وتسعين سنة.(@)PageV01P002(@)(@@) [ج 3: ص 257](@)(@@)(@@)(@@) ||| AUTO جابر بن غراب النمري(@)(@@) يروي عن هرم بن حيان، روى عنه أبو نضرة، واسمه: المنذر بن مالك.(@)(@@)(@@)(@@) ||| AUTO جابر بن سعد الدؤلي الكناني(@)(@@) من أهل الحجاز، يروي عن أبيه، روى عنه عمرو بن أبي سفيان.(@)(@@)(@@)(@@) ||| AUTO جابر بن صبح الراسبي(@)(@@) من أهل البصرة، كنيته أبو بشر، روى 
ms896	 عنه يوسف بن يزيد البراء، ويحيى القطان.(@)(@@)(@@)(@@) ||| AUTO جابر الجهني(@)(@@) شيخ يروي عن أبيه، عن أبي قتادة، روى عنه ابن جريج.(@)(@@)(@@)(@@) ||| AUTO جابر بن رستم(@)(@@) يروي عن شيبة بن نصاح، روى عنه زيد بن الحباب.(@)(@@)(@@)(@@) ||| AUTO جابر بن يزيد بن رفاعة العجلي(@)(@@) يروي عن الشعبي، روى عنه أبو داود الطيالسي.(@)(@@)(@@)(@@) ||| AUTO جابر بن غانم السلفي(@)(@@) من أهل حمص، يروي عن سليم بن عامر، روى عنه يحيى بن صالح الوحاظي، قال:(@)(@@) (294) -[3: 257] حدثنا عمر بن محمد بن بجير، قال: ثنا عمرو بن عثمان بن سعيد، قال: ثنا أبي، قال: ثنا جابر بن غانم، عن سليم بن عامر، قال: سمعت معد يكرب بن كلال يوم الجمعة على المنبر يحدث عن عوف بن مالك، قال: كنا مع رسول الله صلى الله عليه وسلم في بعض مغازيه، قال: إن جبرائيل أتاني، فقال: إن ربي خيرني بين أن يدخل نصف أمتي الجنة وبين الشفاعة لأمتي، فاخترت الشفاعة.(@)(@@)(@@)(@@) ||| AUTO جابر بن زكريا(@)(@@) شيخ يروي عن الحجازيين، وعمر بن عبد العزيز، روى عنه ضمرة بن ربيعة.(@)(@@)(@@)(@@) ||| AUTO جرير بن يزيد بن جرير بن عبد الله البجلي(@)(@@) يروي عن أبي زرعة بن PageV01P002 [ج 3: ص 258] عمرو بن جرير، عداده في أهل الكوفة، روى عنه يونس بن عبيد، وعيسى بن يونس.(@)(@@)(@@)(@@) ||| AUTO جرير بن حيان الأسدي، وهو الذي يقال له: جرير بن أبي الهياج(@)(@@) من أهل الكوفة، يروي عن العراقيين، روى عنه يونس بن خباب.(@)(@@)(@@)(@@) ||| AUTO جرير بن زيد الأزدي(@)(@@) عم جرير بن حازم، عداده في أهل البصرة، يروي عن عامر بن سعد بن أبي وقاص، روى عنه ابنا أخيه يزيد، وجرير ابنا حازم بن زيد.(@)(@@)(@@)(@@) ||| AUTO جرير بن عطية(@)(@@) شيخ يروي عن شريح، روى عنه عبد الواحد بن زياد.(@)(@@)(@@)(@@) ||| AUTO جرير بن عبد الله(@)(@@) شيخ من أهل البصرة، يروي عن معاوية بن قرة، وموسى بن دهقان، روى عنه موسى بن إسماعيل، والبصريون.(@)(@@)(@@)(@@) ||| AUTO جرير بن رياح(@)(@@) يروي عن أبيه، عن عمار بن ياسر، روى عنه سماك بن حرب.(@)(@@)(@@)(@@) ||| AUTO جرير، 
ms897	 أبو عروة(@)(@@) يروي عن عطاء بن يسار، روى عنه سليمان بن بلال.(@)(@@)(@@)(@@) ||| AUTO جرير بن حازم بن زيد الأزدي العتكي(@)(@@) من أهل البصرة، كنيته أبو النضر، يروي عن الحسن، وابن سيرين، ومات أنس بن مالك وجرير بن حازم ابن خمس سنين، فكان مولده سنة ثمان وثمانين، روى عنه ابن المبارك، وأهل البصرة، ومات سنة سبعين ومائة، وقد قيل سنة سبع وستين ومائة، وكان يخطئ، لأن أكثر ما كان يحدث من حفظه، وكان شعبة يقول: ما رأيت بالبصرة أحفظ من رجلين: هشام الدستوائي، وجرير بن حازم.(@)PageV01P002(@)(@@) [ج 3: ص 259](@)(@@)(@@)(@@) ||| AUTO جرير بن عبد الحميد بن جرير بن قرط بن هلال بن أقيس بن أبي أمية بن زحف بن النضر بن عبد الله بن بكر بن سعد بن ضبة بن أد بن طابخة بن الياس بن مضر الضبي الرازي، كنيته أبو عبد الله(@)(@@) مولده بالكوفة، انتقل إلى الري وسكنها، يروي عن أبي إسحاق، والأعمش، وكان مولده سنة عشر ومائة في السنة التي مات فيها الحسن، وابن سيرين، ومات سنة سبع وثمانين ومائة بالري، روى عنه ابن المبارك، والناس، وكان من العباد الخشن.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO جميل بن عبد الرحمن بن سوادة الأنصاري المؤذن(@)(@@) مولى ناجية بنت غزوان أخت عتبة بن غزوان، عداده في أهل المدينة، يروي عن سعيد بن المسيب، روى عنه يحيى بن سعيد الأنصاري، ومالك، وكانت أمه بنت سعد القرظ.(@)(@@)(@@)(@@) ||| AUTO جميل بن مرة الشيباني(@)(@@) يروي عن أبي الوضيء، عداده في أهل البصرة، روى عنه هشام بن حسان، وحماد بن زيد.(@)(@@) جميل(@)(@@) شيخ يروي عن أبي المليح بن أسامة، روى عنه عبد الله بن عون، لا أدري من هو ولا ابن من هو.(@)(@@)(@@)(@@) ||| AUTO جميل بن أبي ميمونة(@)(@@) يروي عن عبيد الله بن أبي زكريا، روى عنه محمد بن إسحاق.(@)(@@)(@@)(@@) ||| AUTO جميل بن بشر المزني(@)(@@) يروي عن سالم بن عبد الله، روى عنه خلف بن خليفة.(@)PageV01P002(@)(@@) [ج 3: ص 260](@)(@@)(@@)(@@) ||| AUTO جميل بن عبيد الطائي، كنيته أبو النضر(@)(@@) يروي عن ثمامة، والحسن، روى عنه 
ms898	 زيد بن الحباب، وموسى بن إسماعيل، عداده في أهل البصرة وليس هذا بجميل بن زيد الطائي، ذاك واه.(@)(@@)(@@)(@@) ||| AUTO جميل الحذاء(@)(@@) شيخ يروي المراسيل، روى عنه عمرو بن الحارث.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO جبلة بن عطية(@)(@@) يروي عن يحيى بن الوليد بن عبادة بن الصامت، عن عبادة بن الصامت، روى عنه حماد بن سلمة.(@)(@@)(@@)(@@) ||| AUTO جبلة بن أبي رواد(@)(@@) أخو عبد العزيز بن أبي رواد، كنيته أبو مروان، مولى عتيك، والد عثمان بن جبلة، يروي عن البصريين، روى عنه ابنه، قتله أبو مسلم بنيسابور سنة إحدى أو اثنتين وثلاثين ومائة.(@)(@@) جبلة(@)(@@) شيخ يروي عن عكرمة، روى عنه حصين بن عبد الرحمن.(@)(@@)(@@)(@@) ||| AUTO جبلة بن دعلج(@)(@@) يروي عن سعيد بن جبير، روى عنه أبو شهاب موسى بن نافع، وقد قيل: عبد ربه بن نافع الحناط.(@)(@@)(@@)(@@) ||| AUTO جبلة بن سليمان الأسدي(@)(@@) إمام مسجد سعيد بن جبير، يروي عن سعيد بن جبير، وغيره، روى عنه علي بن مسهر، والكوفيون.(@)(@@)(@@)(@@) ||| AUTO جبلة بن أبي جليسة الحرشي(@)(@@) يروي عن الحسن، عداده في أهل البصرة، روى عنه عبد الصمد بن عبد الوارث.(@)(@@)(@@)(@@) ||| AUTO جبير بن محمد بن جبير بن مطعم(@)(@@) يروي عن أبيه، روى عنه يعقوب بن عتبة.(@)PageV01P002(@)(@@) [ج 3: ص 261](@)(@@)(@@)(@@) ||| AUTO جبير، أبو سفيان(@)(@@) شيخ يروي عن محمد بن زياد، روى عنه معاوية بن صالح.(@)(@@)(@@)(@@) ||| AUTO جبير بن أبي صالح(@)(@@) يروي عن الزهري، روى عنه ابن أبي ذئب.(@)(@@)(@@)(@@) ||| AUTO جندب(@)(@@) شيخ يروي عن الحارث بن حرمل، عن عبد الله بن عمرو، روى عنه بكر بن عمر المعافري.(@)(@@)(@@)(@@) ||| AUTO الجراح بن الضحاك الكندي(@)(@@) كوفي، يروي عن علقمة بن مرثد، وإسماعيل بن أبي خالد، روى عنه جرير بن عبد الحميد الضبي، وأهل العراق.(@)(@@)(@@)(@@) ||| AUTO الجراح بن عبد الله(@)(@@) شيخ يروي عن أهل الشام، روى عنه صفوان بن عمرو السكسكي.(@)(@@)(@@)(@@) ||| AUTO الجراح بن مليح البهراني(@)(@@) من أهل حمص، يروي عن حاتم بن حريث الطائي، وجماعة من التابعين، روى عنه الهيثم بن خارجة، وأهل الشام.(@)(@@)(@@)(@@) ||| AUTO جنيد بن العلاء، أبو العلاء(@)(@@) يروي 
ms899	 عن مجاهد، روى عنه أهل العراق.(@)(@@)(@@)(@@) ||| AUTO جارية بن هرم، أبو بلج التميمي الصغير(@)(@@) يروي عن الحجازيين، وأهل بلده، روى عنه محمد بن يزيد الواسطي، وكان جارية يزعم أنه سمع من لبي بن لبا، وكان يزعم أن له صحبة.(@)(@@)(@@)(@@) ||| AUTO جنادة بن أبي خالد(@)(@@) يروي عن مكحول، وعن أبي شيبة المهري، عن عمرو بن عبسة، روى عنه زيد بن أبي أنيسة الجزري، وهو الذي يخطئ أهل الجزيرة في PageV01P002 [ج 3: ص 262] روايته، فيقولون: عن زيد بن أبي أنيسة، عن جنادة بن أبي أمية، عن مكحول، إنما هو جنادة بن أبي خالد، جنادة بن أبي أمية من التابعين.(@)(@@)(@@)(@@) ||| AUTO جهم بن الجارود(@)(@@) يروي عن سالم بن عبد الله، روى عنه أبو عبد الرحيم خالد بن أبي يزيد.(@)(@@)(@@)(@@) ||| AUTO جهم بن الحارث بن الفرات(@)(@@) يروي عن إسماعيل بن أبي خالد، وعمرو بن مرة، وروى عنه سعيد بن أبي الهيفاء، كوفي.(@)(@@)(@@)(@@) ||| AUTO جهم بن دينار الحذاء(@)(@@) يروي عن عمرو بن الحارث بن المصطلق، عن ابن مسعود، روى عنه أشعث بن سوار، وإسماعيل بن أبي خالد.(@)(@@)(@@)(@@) ||| AUTO جهم بن أوس(@)(@@) يروي عن عبد الله بن أبي مريم، عن أبي هريرة، روى عنه ابن المبارك.(@)(@@)(@@)(@@) ||| AUTO جعيد بن عبد الرحمن بن أوس المدني(@)(@@) يروي عن يزيد بن خصيفة، والسائب بن يزيد، إن كان سمع منه، روى عنه يحيى بن سعيد القطان.(@)(@@)(@@)(@@) ||| AUTO جعد بن الصلت المحلمي(@)(@@) يروي عن عكرمة، روى عنه محمد بن ربيعة، وهو الذي يقال له: محلم بن تميم.(@)(@@)(@@)(@@) ||| AUTO جعد بن ذكوان(@)(@@) من أهل الكوفة، يروي عن شريح، روى عنه الثوري.(@)(@@)(@@)(@@) ||| AUTO جعد الهمداني(@)(@@) كوفي، يروي المراسيل، روى عنه الزبير بن عدي.(@)(@@)(@@)(@@) ||| AUTO جبر بن حبيب(@)(@@) يروي عن أم كلثوم، روى عنه الجريري، وشعبة.(@)PageV01P002(@)(@@) [ج 3: ص 263](@)(@@)(@@)(@@) ||| AUTO جامع بن أبي راشد، كنيته أبو صخرة الصيرفي(@)(@@)(@@)(@@) ||| AUTO أخو الربيع بن أبي راشد، من أهل الكوفة، يروي عن أبي وائل، وزيد بن أسلم، روى عنه سفيان الثوري، وربما روى عنه شريك، ويقول: جامع بن راشد. 
ms900	 والصحيح ما قاله سفيان: جامع بن أبي راشد.(@)(@@)(@@)(@@) ||| AUTO جامع بن مطر الحبطي(@)(@@) يروي عن معاوية بن قرة، روى عنه الحوضي حفص بن عمر.(@)(@@) جامع بن راشد(@)(@@) كوفي، يروي عن صفوان بن محرز، روى عنه الثوري، وليس هذا بجامع بن أبي راشد.(@)(@@)(@@)(@@) ||| AUTO جويرية بن بشير الهجيمي(@)(@@) من أهل البصرة، يروي عن الحسن، وأبي خلدة، روى عنه يزيد بن هارون، وأبو عامر العقدي.(@)(@@)(@@)(@@) ||| AUTO جويرية بن أسماء بن عبيد بن مخراق الضبعي، كنيته أبو مخراق(@)(@@) من أهل البصرة، يروي عن نافع، وأبيه، روى عنه أبو داود الطيالسي، وأهل البصرة، مات سنة ثلاث وسبعين ومائة.(@)(@@)(@@)(@@) ||| AUTO جميع بن عبد المقرئي(@)(@@) يروي عن أهل الشام، روى عنه عبد الله بن المبارك.(@)(@@)(@@)(@@) ||| AUTO جبر بن سعيد بن أبيض بن حمال المأربي(@)(@@) يروي عن عبد الله بن جريع بن حمال، عن ابن عمر في صلاة المسافر، روى عنه ابن أخيه فرج بن سعيد بن علقمة بن سعيد بن أبيض بن حمال.(@)PageV01P002(@)(@@) [ج 3: ص 264](@)(@@)(@@)(@@) ||| AUTO جري بن عبد العزيز بن مروان بن الحكم الأموي القرشي(@)(@@) يروي عن أخيه زياد بن عبد العزيز، روى عنه موسى بن علي بن رباح.(@)(@@)(@@)(@@) ||| AUTO جراد بن مجالد الضبي(@)(@@) يروي عن رجاء بن حيوة، روى عنه شعبة، وأبو بكر بن عياش.(@)(@@)(@@)(@@) ||| AUTO جراد بن طارق بن شبيط التيمي(@)(@@) من أهل البصرة، روى عن أهل بلده، روى عنه فيل بن عرادة.(@)(@@)(@@)(@@) ||| AUTO جناح النجار المدني(@)(@@) مولى ليلى بنت سهيل القرشية، يروي عن عائشة بنت سعد بن أبي وقاص، روى عنه عمر بن زياد.(@)(@@)(@@)(@@) ||| AUTO جندل السدوسي(@)(@@) يروي عن شريح، روى عنه عبد الله بن شقيق العقيلي.(@)(@@)(@@)(@@) ||| AUTO جسر بن الحسن الفزاري(@)(@@) شيخ يروي عن نافع، روى عنه الأوزاعي، وليس هذا بجسر بن فرقد القصاب، ذاك ضعيف، وهذا صدوق.(@)(@@)(@@)(@@) ||| AUTO جواب بن عبيد الله التيمي، تيم الرباب الأعور(@)(@@) من أهل الكوفة، يروي عن يزيد بن شريك التيمي، والد إبراهيم التيمي، روى عنه الشيباني، ومسعر بن كدام، وكان مرجئا.(@)(@@)(@@)(@@) ||| AUTO جواب بن عثمان 