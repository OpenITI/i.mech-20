ms61	(@)(@@) 18 وردوا إليك الرسل والصلح ممكن ، %~% وقالوا على غير القتال سلام ،(@)(@@) 19 فلا قول إلا الضرب والطعن عندنا ؛ %~% ولا رسل إلا ذابل وحسام ،(@)(@@) 20 فان عدت فالجروح توسى جراحه ، %~% وان لم تعد متنا ونحن كرام . PageV01P330(@)(@@) 21 فلسنا وان كان البقاء محببا %~% بأول من أخنى عليه حمام(@)(@@) 22 وحب الفتى طول الحياة يذله ،(@)(@@) 23 وكل يريد العيش والعيش حتفه ، %~% ويستعذب اللذات وهي سمام .(@)(@@) 24 فلما تجلى الأمر ، قالوا تمنيا : %~% ألا ليت أنا في التراب رمام .(@)(@@) 25 وراموا التي كانت لهم وإليهم %~% وقد صعبت حال ، وعز مرام(@)(@@) 26 وظنوك ممن يطفىء البرد ناره ، %~% إذا طلعت عند الغروب جهام ،(@)(@@) 27 وأنك تثنيها ، قبالة جلق ، %~% متى لاح برق ، واستقل غمام(@)(@@) 28 وقالوا : شهور ينقضين بغزوة . %~% وما علموا أن القفول حرام .(@)(@@) 29 لقد حكموا حكم الجهول لنفسه ، %~% رويدهم حتى يطول مقام(@)(@@) 30 وحتى يزول الحول عنهم ومثله ، %~% ويهذب عام بعد ذاك وعام ، PageV01P331(@)(@@) 31 فلولاك بعد الله ، ما عرف الندى ، %~% ولا ثار بين الخافقين قتام(@)(@@) 32 ولا سل في نصر المكارم صارم %~% ولا شد ، في غزو العدو ، حزام(@)PageV01P332(@)(@@) البحر : طويل(@)(@@) 1 تخيرت جهدي لو وجدت خيارا ، %~% وطرت بعزمي ، لو أصبت مطارا(@)(@@) 2 جهلت ، فلما لم أر الجهل مغنيا ، %~% حلمت ، فأوسعت الزمان وقارا(@)(@@) 3 إلى كم تشكاني إلي ركائبي ، %~% وتكثر عتبي ، خفية وجهارا ؟(@)(@@) 4 أسير بها تحت المنايا وفوقها ، %~% فيسقط بي شخص الحمام عثارا ،(@)(@@) 5 وكن ، إذا لاقينني ليردنني ، %~% رجعن كما شاء الصديق حرارا ،(@)(@@) 6 فلله طعمي ما أمر مذاقه %~% ولله عيسى ما أقل نفار .(@)(@@) 7 واسود لم تعرف له الانس والدا %~% كساني منه حلة وخمارا ،(@)(@@) 8 سرت بي فيه ناجيات مياهها %~% تجم ، إذا ماء الركائب غارا(@)(@@) 9 فخرقن ثوب الليل ، حتى كأنني %~% أطرت بها في جانبيه شرارا ،(@)(@@) 10 وباتت تراعي البدر وهو كأنه %~% من الخوف ، لاقى ، بالكمال ، سرارا PageV01P333(@)(@@) 11 تأخر عن جيش الصباح لضعفه ، %~% فاوثقه جيش الظلام إسارا ،(@)(@@) 12 ووافت رعانا للرعان كأنما %~% تحادثها الشعرى العبور سرارا ،(@)(@@) 13 وبات غوي القوم يحسب أنه %~% أجد إلى أهل 
ms62	 السماء مزارا ،(@)(@@) 14 إذا ضن زند مد بالشخت كفه ، %~% ليقبس ، من بعض الكواكب ، نارا(@)(@@) 15 إذا قيدت في منزل بتنوفة %~% حسبت مناخا ، أوطنته ، مثارا(@)(@@) 16 تظن غطيط النوم نهمة زاجر ، %~% فتقطع قيدا أو تبت هجارا ،(@)(@@) 17 أطلت على أرجاء أزرق مترع %~% تنوش بريرا حوله وبهارا ،(@)(@@) 18 يمدن ، إذا أسقين منه ، كأنما %~% شربن به قبل الضياء عقارا .(@)(@@) 19 إذا خفق البرق الحجازي أعرضت ، %~% وترنوا إذا برق العراق أنارا ،(@)(@@) 20 وتأرن من بعد اللغوب ، كأنه ، %~% إليها بجد في النجاء ، أشارا PageV01P334(@)(@@) 21 وليست تحس الأرض منه بوطأة %~% فتفزع سربا أو تروع صوارا(@)(@@) 22 تدوس أفاحيص القطا ، وهو هاجد ، %~% فتمضي ، ولم تقطع عليه غرارا(@)(@@) 23 وتقنص أم الخشف ما أبهت لها %~% فتحدث عنها نبوة وفرارا .(@)(@@) 24 كأنك أصغرت الزمان وأهله %~% عبيدا ، ولم ترض البسيطة دارا(@)(@@) 25 تظل المنايا في سيوفك شرعا %~% إذا النقع ، من تحت السنابك ، ثارا(@)(@@) 26 فان عد ضحضاح الحمام صوارم %~% عددن بحورا ، للردى ، وغمارا(@)(@@) 27 كأن تراب الأرض لم يرض عزها ، %~% فاصعد يبغي في السماء جوارا ،(@)(@@) 28 بكل كميت ، ما رعت خبط الحمى ، %~% ولا شربت رسل اللقاح سمارا(@)(@@) 29 إذا ما علاها فارس ، ظن أنه %~% تبوأ ما بين النجوم قرارا .(@)(@@) 30 ولم أر خيلا ، مثلها ، عربية ، %~% تذيل عدوا ، أو تصون ذمارا PageV01P335(@)(@@) 31 اشد ! على من حاربته تسلطا ، %~% وأبعد منها ، في البلاد ، مغارا(@)(@@) 32 يكلفها ، الأرض البعيدة ، ماجد ، %~% يشيد مجدا لا يكشف عارا ،(@)(@@) 33 غذاهن محمر النجيع قوارحا %~% كما كن يغذين الضريب ، مهارا(@)(@@) 34 سمعن الوغى قبل الصهيل وما انسرت %~% مشايمها حتى اكتسبن غبارا ،(@)(@@) 35 إذا أفرعت من ذات نيق ، حسبتها %~% تفيض ، على أهل الوهود ، بحارا(@)(@@) 36 وإن نهضت من مطمئن ، ظننته %~% يجيش جبالا ، أو يمج حرارا(@)(@@) 37 يغول سباع الطير ضنك غبارها ، %~% فيسقط موتى أعقابا ونسارا ،(@)(@@) 38 ويجثم في السيد رعبا ، فكلما %~% أضاءت لعينيه القواضب سارا(@)(@@) 39 هداه إلى ما شاء كل مهند %~% يكون لاسباب الحتوف نجارا ،(@)(@@) 40 كأن المنايا جيش ذر عرمرم ، %~% تخذن إلى الأرواح فيه مسارا .(@)PageV01P336(@)(@@) البحر : بسيط تام 
ms63	(@)(@@) 1 منك الصدود ومني الصدود رضا ، %~% من ذا علي بهذا في هواك قضى ؟(@)(@@) 2 بي منك ما لو غدا بالشمس ما طلعت ، %~% من الكآبة ، أو بالبرق ما ومضا .(@)(@@) 3 إذا الفتى ذم عيشا ، في شبيبته ، %~% فما يقول ، إذا عصر الشباب مضى ؟(@)(@@) 4 وقد تعوضت من كل بمشبهه ، %~% فما وجدت لأيام الصبا عوضا(@)(@@) 5 وقد غرضت من الدنيا ، فهل زمني %~% معط حياتي لغر ، بعد ما غرضا ؟(@)(@@) 6 جربت دهري وأهليه ، فما تركت %~% لي التجارب في ود امرئ غرضا .(@)(@@) 7 وليلة سرت فيها ، وابن مزنتها ، %~% كميت عاد حيا ، بعدما قبضا(@)(@@) 8 كأنما هي إذ لاحت كواكبها %~% خود من الزنج تجلى وشحت خضضا ،(@)(@@) 9 كأنما النسر قد قصت قوادمه ، %~% فالضعف يكسر منه كلما نهضا ،(@)(@@) 10 والبدر يحتث نحو الغرب أينقه %~% فكلما خاف من شمس الضحى ركضا . PageV01P337(@)(@@) 11 ومنهل ، ترد الجوزاء غمرته ، %~% إذا السما كان شطر المغرب اعترضا(@)(@@) 12 وردته ، ونجوم الليل وانية ، %~% تشكو إلى الفجر أن لم تطعم الغمضا .(@)PageV01P338(@)(@@) البحر : طويل(@)(@@) 1 عظيم ، لعمري ، أن يلم عظيم %~% بآل علي ، والأنام سليم(@)(@@) 2 ولكنهم أهل الحفائظ والعلى ، %~% فهم لملمات الزمان خصوم ،(@)(@@) 3 فإن بات منها فيهم وعك علة %~% ففيها جراح ، منهم ، وكلوم(@)(@@) 4 هنيئا لاهل العصر برء محمد ، %~% وإن كان منهم جاهل وعليم(@)(@@) 5 ألد بحدي سيفه وسنانه ، %~% إذا لم يغلب ، غير ذين ، خصيم(@)(@@) 6 لك الله ، لا تذعر وليا بغضبة %~% لعل له عذرا ، وأنت تلوم(@)(@@) 7 فلو زار أهل الخلد عتبك زورة %~% لأوهمهم أن الجنان جحيم(@)(@@) 8 إذا عصفت بالروض أنفاس ناجر ، %~% فأي وميض للغام أشيم ؟(@)(@@) 9 وهل لي في ظل النعام تقيل %~% إذا منعت ، ظل الأراك ، سموم ؟(@)(@@) 10 وما كنت أدري أن مثلك يشتكي ، %~% ولم يتغير للرياح نسيم ، PageV01P339(@)(@@) 11 ولم تطبق الدنيا الفجاج على الورى %~% فيهلك محمود بها وذميم .(@)(@@) 12 فان نال منك السقم حظا ، فطالما %~% رأيت هلال الأفق ، وهو سقيم(@)(@@) 13 إذا أدرك البين السماك ظعنتم ، %~% وخوضوا المنايا ، والسماك مقيم(@)(@@) 14 فآل الثريا والفراقد أنتم ؛ %~% وإن شبهتكم بالعباد جسوم ،(@)(@@) 15 فإن 
ms64	 نجوم الأرض ، ليس بغائب %~% سناها ، وفي جو السماء نجوم(@)(@@) 16 فليتك ، للأفلاك ، نور مخلد ، %~% يزول بنا صرف الردى وتدوم(@)(@@) 17 يراه بنو الدهر الاخير بحاله %~% كما أبصرته جرهم وأميم(@)PageV01P340(@)(@@) البحر : بسيط تام(@)(@@) 1 يا للمفضل تكسوني مدائحه %~% وقد خلعت لباس المنظر الأنق(@)(@@) 2 وما ازدهيت واثواب الصبا جدد ، %~% فكيف أزهى بثوب ، من صبا ، خلق ؟(@)(@@) 3 لله درك من مهر جرى وجرت %~% عتق المذاكي ، فخابت صفقة العتق(@)(@@) 4 انا بعثناك تبغي القول من كثب ، %~% فجئت بالنجم مصفودا من الأفق(@)(@@) 5 وقد تفرست فيك الفهم ملتهبا %~% من كل وجه ، كنار الفرس في السذق(@)(@@) 6 أيقنت أن حبال الشمس تدركني ، %~% لما بصرت بخيط المشرق اليقق ،(@)(@@) 7 هذا قريض عن الأملاك ، محتجب ، %~% فلا تذله بإكثار على السوق(@)(@@) 8 كأنه الروض يبدي منظرا عجبا ، %~% وإن غدا وهو مبذول على الطرق ،(@)(@@) 9 وكم رياض بحزن لا يرود بها %~% ليث الشرى وهي مرعى الشادن الخرق(@)(@@) 10 فاطلب مفاتيح باب الرزق من ملك ، %~% أعطاك مفتاح باب السؤدد الغلق ، PageV01P341(@)(@@) 11 لفظ كأن معاني السكر يسكنه ، %~% فمن تحفظ بيتا منه لم يفق ،(@)(@@) 12 صبحتني منه كاسات غنيت بها ، %~% حتى المنية عن قيل ومغتبق ،(@)(@@) 13 جزل ، يشجع من وافى له أذنا ، %~% فهو الدواء لداء لجبن والقلق ،(@)(@@) 14 إذا ترنم شاد لليراع به %~% لاقى المنايا ، بلا خوف ، ولا فرق(@)(@@) 15 وإن تمثل صاد للصخور به %~% جادت عليه بعذب غير ذي رنق(@)(@@) 16 فرتب النظم ترتيب الحلي على %~% شخص الجلي بلا طيش ولا خرق(@)(@@) 17 الحجل للرجل ، والتاج المنيف لما %~% فوق الحجاج ، وعقد الدر للعنق ،(@)(@@) 18 وانهض إلى أرض قوم صوب جوهم %~% ذوب اللجين ، مكان الوابل الغدق(@)(@@) 19 يغدو إلى الشول راعيهم ومحلبه %~% قعب من التبر أو عس من الورق ،(@)(@@) 20 ودع أناسا ، إذا أجدوا على رجل ، %~% رنوا إليه بعين المغضب الحنق ، PageV01P342(@)(@@) 21 كأنما القر منهم ، فهو مستلب %~% ما الصيف كاسيه ، أشجارا ، من الورق(@)(@@) 22 لا ترض ، حتى ترى يسراك واطئة %~% على ركاب من الإذهاب ، كالشفق(@)(@@) 23 امامك الخيل مسحوبا اجلتها %~% من فاخر 
ms65	 الوشي أو من ناعم السرق(@)(@@) 24 كأنما الآل يجري في مراكبها ، %~% وسط النهار ، وإن أسرجن في الغسق(@)(@@) 25 كأنما في نضار ذائب سبحت %~% واستنقذت بعد أن أشفت على الغرق(@)(@@) 26 ثقيلة النهض مما حليت ذهبا ، %~% فليس تملك غير المشي والعنق ،(@)(@@) 27 تسمو بما قلده من أعنتها %~% منيفة كصوادي يثرب السحق(@)(@@) 28 وخلة الضرب لا تبقي له خللا ، %~% وحلة الحرب ذات السرد والحلق .(@)(@@) 29 لا تنس لي نفحاتي ، وانس لي زللي ، %~% ولا يضرك خلقي ، واتبع خلقي(@)(@@) 30 فربما ضر خل نافع ، أبدا ، %~% كالريق يحدث منه عارض الشرق PageV01P343(@)(@@) 31 وعطفة من صديق لا يدوم بها %~% كعطفة الليل بين الصبح والفلق(@)(@@) 32 فإن توافق في معنى بنو زمن %~% فإن جل المعاني غير متفق(@)(@@) 33 قد يبعد الشيء من شيء يشابهه ؛ %~% إن السماء نظير الماء في الزرق(@)PageV01P344(@)(@@) البحر : بسيط تام(@)(@@) 1 لولا تحية بعض الأربع الدرس ، %~% ما هاب حد لساني حادث الحبس ،(@)(@@) 2 هل تسمع القول دار غير ناطقة ، %~% وفقدها السمع مقرون إلى الخرس(@)(@@) 3 لأنسينك إن طال الزمان بنا ، %~% وكم حبيب تمادى عهده ، فنسي(@)(@@) 4 يا شاكي النوب انهض طالبا حلبا ، %~% نهوض مضنى لحسم الداء ملتمس(@)(@@) 5 واخلع حذاءك إن حاذيتها ورعا ، %~% كفعل موسى كليم الله في القدس ،(@)(@@) 6 واحمل إلى خير راع من رعيته ، %~% أزكى التحيات ، لم تمزج ولم تمس(@)(@@) 7 مقبل الرمح حبا للطعان به ، %~% كانما هو مجموع من اللعس ،(@)(@@) 8 وأثبت الناس قلبا في ظلام سرى ، %~% ولا ربيئة إلا مسمع الفرس .(@)(@@) 9 قسنا الأمور ، فلما نال رتبته %~% من السعادة سلمنا ولم نقس ،(@)(@@) 10 لقد تواضعت الدنيا لذي شرف %~% بملبسات الدنايا ، غير ملتبس PageV01P345(@)(@@) 11 لغاسل الكف من أعراضها مئة %~% وما يجاوز سبعا غاسل النجس(@)(@@) 12 غمر النوال ، ولن تبقي على أحد %~% حتى توقى بجود ضد محتبس ،(@)(@@) 13 والنفس تحيا بإعطاء الهواء لها %~% منه بمقدار ما أعطته من نفس .(@)(@@) 14 يا فارس الخيل ! يدعوك العدى أسدا ، %~% ما استنقذت من يديه عنق مفترس(@)(@@) 15 نالوا يسير حياة كابن ليلته %~% من الأهلة ، أو كالنجم 
ms66	 في الغلس(@)(@@) 16 يجول كل سواد في عيونهم %~% كالأكم في السير عند الأعين النعس(@)(@@) 17 خفض عليك ، فليس الحرب غانية ، %~% ولا النجيع خلوقا ، ميث في عرس(@)(@@) 18 افنى قناتك نزغ للنفوس بها ، %~% كذلك النزع يبلي جدة المرس ،(@)(@@) 19 أطفت سنانك أرواح تموت به ، %~% هبوب ارواح ليل في سنى قبس ،(@)(@@) 20 ارى جبينك هذي الشمس خالقها ، %~% وقد أنارت بنور عنه منعكس . PageV01P346(@)(@@) 21 الآن ، فاله عن الهيجاء مغتبطا ، %~% طال امتراؤك خلقي نابها الضبس ،(@)(@@) 22 ما ربة الغيل أخت الظبي فزت بها %~% بل ربة الغيل أخت الضيغم الشرس(@)(@@) 23 من معشر لا يخاف الجار بأسهم ، %~% غشوا صروف الليالي برد مبتئس(@)(@@) 24 وصاحبوها بأعراض ، جواهرها %~% كجوهر البدر لا يدنو من الدنس ،(@)(@@) 25 كأنما الضرب يفري ، من كلومهم ، %~% اكباد سرب رعين النور في الكنس ،(@)(@@) 26 سالت تضوع ، حتى ظن جارحهم %~% قسيمة المسك جرح الفارس(@)(@@) 27 كأن كل سنان صاب عندهم ، %~% للنفع ، مبضع آس مشفق ، نطس(@)(@@) 28 الطارحين لخوض الموت لامهم %~% سحب الأجلة خلف الضمر الشمس(@)(@@) 29 أبا فلان ! دعاك الله مقتدرا ؛ %~% اخا المكارم ، وابن الصارم الخلس ،(@)(@@) 30 لا يوهمنك أن الشعر لي خلق %~% وأنني بالقوافي دائم الأنس PageV01P347(@)(@@) 31 فإنما كان إلمامي بساحتها ، %~% في الدهر ، إلمام طير الماء بالعلس(@)(@@) 32 والناس ، في غمرات من مقالهم ، %~% لا يظفرون بغير المنطق الودس(@)(@@) 33 ولا يفيدون نفعا في كلامهم ، %~% وهل تفيدك ، معنى ، نغمة الجرس ؟(@)(@@) 34 عساك تعذر إن قصرت في مدحي ، %~% فإن مثلي بهجران القريض عس(@)PageV01P348(@)(@@) البحر : كامل تام(@)(@@) 1 أشفقت من عبء البقاء وعابه %~% ومللت من أري الزمان وصابه(@)(@@) 2 ووجدت أحداث الليالي أولعت %~% بأخي الندى تثنيه عن آرابه ،(@)(@@) 3 وارى أبا الخطاب نال من الحجى %~% حظا زواه الدهر عن خطابه .(@)(@@) 4 لا يطلبن كلامه متشبه ، %~% فالدر ممتنع على طلابه ،(@)(@@) 5 أثنى ، وخاف من ارتحال ثنائه %~% عني ، فقيد لفظه بكتابه(@)(@@) 6 كلم كنظم العقد يحسن تحته %~% معناه ، حسن الماء تحت حبابه(@)(@@) 7 فتشوقت شوقا إلى نغماته %~% أفهامنا ، ورنت إلى آدابه ،(@)(@@) 8 والنخل ، ما عكفت عليه طيوره ، %~% إلا لما 
ms67	 علمته من إرطابه(@)(@@) 9 ردت لطافته ، وحدة ذهنه ، %~% وحش اللغات أوانسا بخطابه(@)(@@) 10 والنحل يجني المرمن نور الربى ، %~% فيصير شهدا في طريق رضابه PageV01P349(@)(@@) 11 عجب الأنام لطول همة ماجد ، %~% أوفى به قصر على أضرابه(@)(@@) 12 سهم الفتى أقصى مدى من سيفه ، %~% والرمح يوم طعانه وضرابه .(@)(@@) 13 هجر العراق تطربا وتغربا ، %~% ليفوز من سمط العلا بغرابه ،(@)(@@) 14 والسمهرية ليس يشرف قدرها %~% حتى يسافر لدنها عن غابه(@)(@@) 15 والعضب لا يشفي امرءا من ثاره %~% إلا بفقد نجاده وقرابه(@)(@@) 16 والله يرعى سرح كل فضيلة ، %~% حتى يروحه إلى أربابه .(@)(@@) 17 يا من له قلم حكى في فعله %~% أيم الغضى ، لولا سواد لعابه(@)(@@) 18 عرفت جدودك اذ نطقت ، وطالما %~% لغط القطا فأبان عن انسابه ،(@)(@@) 19 وهرزت أعطاف الملوك بمنطق %~% رد المسن إلى اقتبال شبابه ،(@)(@@) 20 ألبستني حلل القريض ووشيه %~% متفضلا ، فرفلت في أثوابه PageV01P350(@)(@@) 21 وظلمت شعرك إذ حبوت رياضه %~% رجلا ، سواه من الورى أولى به(@)(@@) 22 فأجاب عنه مقتصرا عن شأوه ، %~% إذ كان يقصر عن بلوغ ثوابه(@)PageV01P351(@)(@@) البحر : كامل تام(@)(@@) 1 ليت الجياد خرسن يوم حلاحل ، %~% ورزقن عقلا في تنائف عاقل(@)(@@) 2 فيكم غداتئذ جواد صامت ، %~% في الحي أثمن من جواد صاهل ،(@)(@@) 3 نسري ، إذا هفت الجنوب ، لعلنا %~% نخفي حسيس جنائب ورواحل(@)(@@) 4 يا غرة الحي ، الكثير شياته ، %~% ما تأمرين لمدنف متماثل ،(@)(@@) 5 لاقاك في العام الذي ولى ، فلم %~% يسالك إلا قبلة في قابل ؟(@)(@@) 6 إن البخيل إذا يمد له المدى %~% في الجود ، هان عليه وعد السائل(@)(@@) 7 وسألت : كم بين العقيق إلى الغضى ؟ %~% فجزعت من أمد النوى المتطاول ،(@)(@@) 8 وعذرت طيفك في الجفاء لأنه %~% يسري فيصبح دوننا بمراحل ،(@)(@@) 9 جهل بمثلك أن يزور بلادنا %~% يختال بين أساور وخلاخل(@)(@@) 10 أو ما رأيت الليل يلقي شهبه %~% حتى يجاوزها بحلة عاطل ، PageV01P352(@)(@@) 11 لا تأمنن فوارسا من عامر ، %~% إلا بذمة فارس من وائل .(@)PageV01P353(@)(@@) البحر : بسيط تام(@)(@@) 1 لا وضع للرحل إلا بعد إيضاع ، %~% فكيف شاهدت إمضائي وإزماعي ؟(@)(@@) 2 يا ناق ! جدي ، فقد أفنت أتاتك بي %~% صبري 
ms68	 وعمري وأحلاسي وأنساعي(@)(@@) 3 إذا رأيت سواد الليل فانصلتي %~% وإن رأيت بياض الصبح ، فانصاعي(@)(@@) 4 ولا يهولنك سيف للصباح بدا %~% فإنه للهوادي غير قطاع(@)(@@) 5 إلى الرئيس الذي إسفار طعلته %~% في حندس الخطب ساع بالهدى شاع .(@)(@@) 6 يممته وبودي أنني قلم ، %~% أسعى إليه ورأسي تحتي الساعي(@)(@@) 7 على نجاة من الفرصاد ، أيدها %~% رب القدوم ، بأوصال وأضلاع(@)(@@) 8 تطلى بقار ، ولم تجرب ، كأن طليت %~% بسائل من ذفارى العيس منباع(@)(@@) 9 ولا تبالي بمحل إن ألم بها ، %~% ولا تهش لإخصاب وإمراع ،(@)(@@) 10 سارت ، فزارت بنا الانبار سالمة ، %~% تزجى ، وتدفع في موج ودفاع PageV01P354(@)(@@) 11 والقادسية أدتها إلى نفر %~% طافوا بها ، فأناخوها بجعجاع(@)(@@) 12 ورب ظهر وصلناها على عجل %~% بعصرها ، في بعيد الورد ، لماع(@)(@@) 13 بضربتين ، لطهر الوجه واحدة %~% وللذارعين أخرى ذات إسراع(@)(@@) 14 وكم قصرنا صلاة ، غير نافلة ، %~% في مهمه كصلاة الكسف شعشاع(@)(@@) 15 وما جهرنا ، ولم يصدح مؤذننا ، %~% من خوف كل طويل الرمح خداع(@)(@@) 16 في معشر كجمار الرمي ، أجمعها %~% ليلا وفي الصبح ألقيها إلى القاع(@)(@@) 17 يا حبذا البدو حيث الضب محترش %~% ومنزل بين أجرع وأجراع(@)(@@) 18 وغسل طمري سبعا من معاشرتي %~% في البيد ، كل شجاع القلب شراع ،(@)(@@) 19 وبالعراق رجال ، قربهم شرف %~% هاجرت ، في حبهم ، رهطي وأشياعي(@)(@@) 20 على سنين تقضت عند غيرهم %~% أسفت ، لا بل على الايام والساع ، PageV01P355(@)(@@) 21 إسمع أبا حامد ن فتيا قصدتض بها ، %~% من زائر لجميل الود مبتاع(@)(@@) 22 %~% لحم النوائب ، شراب بإنقاع(@)(@@) 23 أرضى وأنصف ، إلا أنني ربما %~% أربيت غير مجيز خرق إجماع(@)(@@) 24 وذاك أني أعطي الوسق منتحيا ، %~% من المودة ، معطي الود بالصاع(@)(@@) 25 ولا أثقل في جاه ولا نشب ، %~% ولو غدوت أخا عدم وإدقاع(@)(@@) 26 من قال : صادق لئام الناس ! قلت له %~% قول ابن أسلت قد أبلغت أسماعي .(@)(@@) 27 كأن كل جواب ، أنت ذاكره ، %~% شنف يناط بأذن السامع الواعي(@)(@@) 28 إن الهدايا كرامات لآخذها %~% إن كن لسن لاسراف واطماع ،(@)(@@) 29 ولا هدية عندي غير ما حملت ، %~% عن المسيب ، أرواح لقعقاع(@)(@@) 30 ولم أكن 
ms69	 ورسولي حين أرسله %~% مثل الفرزدق في إرسال وقاع PageV01P356(@)(@@) 31 مطيتي في مكان لست آمنه %~% على المطايا ، وسرحان له راع(@)(@@) 32 فارفع بكفي ، فإني طائش قدمي %~% وامدد بضبعي ، فإني ضيق باعي(@)(@@) 33 وما يكن ، فلك الحمد الجميل به ، %~% وإن أضيعت ، فإني شاكر ، داع(@)PageV01P357(@)(@@) البحر : كامل تام(@)(@@) 1 زارت ، عليها ، للظلام ، رواق %~% ومن النجوم قلائد ونطاق(@)(@@) 2 والطوق من لبس الحمام عهدته ، %~% وظباء وجرة ما لها أطواق .(@)(@@) 3 ومن العجائب أن حليك مثقل ، %~% وعليك من سرق الحرير لفاق ،(@)(@@) 4 وصويحباتك ، بالفلاة ، ثيابها %~% أوبارها ، وحليها الأرواق ،(@)(@@) 5 لم تنصفي ، غذيت أطيب مطعم %~% وغذاؤهن الشت والطباق(@)(@@) 6 هل أنت إلا بعضهن ، وإنما %~% خير الحياة وشرها أرزاق(@)(@@) 7 حق عليها أن تحن لمنزل %~% غذيت به اللذات وحي حقاق ،(@)(@@) 8 ليمت وليل اللائمين تعانق %~% حتى الصباح ، وليلها الإعناق(@)(@@) 9 ما الجزع أهل أن تردد نظرهة %~% فيه ، وتعطف نحوه الأعناق ،(@)(@@) 10 ما الجزع أهل أن تردد نظرة %~% فيه ، وتعطف نحوه الأعناق PageV01P358(@)(@@) 11 لا تنزلي بلوى الشقائق ، فاللوى %~% ألوى المواعد والشقيق شقاق(@)PageV01P359(@)(@@) البحر : وافر تام(@)(@@) 1 تفديك النفوس ، ولا تفادى ؛ %~% فأذن القرب أو أطل البعادا ،(@)(@@) 2 أرانا ، يا علي ، وإن أقمنا %~% نشاطرك الصبابة والسهادا ،(@)(@@) 3 ولولا أن يظن بنا غلو ، %~% لزدنا ، في المقال ، من استزادا(@)(@@) 4 وقيل : أفاد بالأسفار مالا ، %~% فقلنا : هل أفاد بها فؤادا ؟(@)(@@) 5 وهل هانت عزائمه ولانت ، %~% فقد كانت عرائكها شدادا .(@)(@@) 6 إذا سارتك شهب الليل قالت : %~% أعان الله أبعدنا مرادا(@)(@@) 7 وإن جارتك هوج الريح ، كانت %~% أكل ركائبا ، وأقل زادا .(@)(@@) 8 إذا جلى ، ليالي الشهر ، سير %~% عليك ، أخذت أسبغها حدادا(@)(@@) 9 تخير سودها وتقول : احلى %~% عيون الخلق اكثرها سوادا .(@)(@@) 10 تضيفك الخوامع في الموامي %~% فتقريهن مثنى أو فرادى ، PageV01P360(@)(@@) 11 ويبكي رقة لك كل نوء %~% فتملأ ، من مدامعه ، المزادا(@)(@@) 12 إذا صاح ابن دأية بالتداني ، %~% جعلنا خطر لمته جسادا(@)(@@) 13 نضمخ ، بالعبير ، له جناحا ، %~% احم كأنه ظلي المدادا ؟(@)(@@) 14 سنلثم من نجائبك الهوادي %~% ونرشف غمد سيفك والنجادا(@)(@@) 15 ونستشفي بسؤر جواد خيل ، %~% قدمت عليه ، إن 
ms70	 خفنا الجوادا(@)(@@) 16 كأنك منه فوق سماء عز %~% وقد جعلت قوائمه عمادا ،(@)(@@) 17 إذا هادى أخ منا أخاه %~% ترابك كان ألطف ما يهادى ،(@)(@@) 18 كأن بني سبيكة فوق طير ، %~% يجوبون الغوائر والنجادا(@)(@@) 19 أبا بالاسكندر الملك اقتديتم %~% فما تضعون في بلد وسادا(@)(@@) 20 لعلك يا جليد القلب ثان %~% لأول ماسح ، مسح البلادا PageV01P361(@)(@@) 21 بعيس مثل أطراف المداري %~% يخضن ، من الدجى ، لمما جعادا(@)(@@) 22 علام هجرت شرق الأرض حتى %~% أتيت الغرب تختبر العبادا ؟(@)(@@) 23 وكانت مصر ذات النيل عصرا %~% تنافس فيك دجلة والسوادا ،(@)(@@) 24 وان من الصراة إلى مجر %~% الفرات إلى قويق مسترادا ،(@)(@@) 25 دجا ، فتلهب المريخ فيه ، %~% ومشبهها لميزت انتقادا .(@)(@@) 26 فان تجد الديار كما أراد ال %~% غريب ، فما الصديق كما أرادا(@)(@@) 27 إذا الشعرى اليمانية استنارت %~% فجدد للشآمية الودادا(@)(@@) 28 فللشام الوفاء ، وإن سواه %~% توافى منطقا غدر اعتقادا ،(@)(@@) 29 ظعنت لتستفيد أخا وفيا %~% وضيعت القديم المستفادا ،(@)(@@) 30 وسرت لتذعر الحيتان ، لما %~% ذعرت الوحش والأسد الورادا PageV01P362(@)(@@) 31 وليل ، خاف قول الناس لما %~% تولى ، سار منهزما فعادا ،(@)(@@) 32 دجا ، فتهلب المريخ فيه %~% وألبس جمرة الشمس الرمادا(@)(@@) 33 كأنك من كواكبه سهيل %~% إذا طلع اعتزالا وانفرادا ،(@)(@@) 34 جعلت الناجيات عليه عونا ، %~% فلم تطعم ولا طعمت رقادا ،(@)(@@) 35 توهم أن ضوء الفجر دان ، %~% فلم تقدح بظنتها زنادا ،(@)(@@) 36 وما لاح الصباح لها ولكن %~% رأت من نار عزمتك اتقادا(@)(@@) 37 قطعت بحارها والبر حتى %~% تعالت السفائن والجيادا ،(@)(@@) 38 فلم تترك لجارية شراعا ، %~% ولم تترك لعادية بدادا ،(@)(@@) 39 بأرض لا يصوب الغيث فيها %~% ولا ترعى البداة بها النقادا ،(@)(@@) 40 وأخرى ، رومها عرب عليها ، %~% وإن لم يركبوا فيها جوادا ، PageV01P363(@)(@@) 41 سوى أن السفين تخال فيها %~% بيوت الشعر شكلا واوسدادا ،(@)(@@) 42 ديارهم بهم تسري وتجري ، %~% إذا شاءوا مغارا ، أو طرادا(@)(@@) 43 تصيد سفرها في كل وجه %~% وغاية من تصيد أن يصادا ،(@)(@@) 44 تكاد تكون ، في لون وفعل ، %~% نواظرها أسنتها الحدادا(@)(@@) 45 أقم في الأقربين فكل حي %~% يراوح بالمعيشة ، أو يغادى(@)(@@) 46 وليس يزاد في رزق حريص %~% ولو 
ms71	 ركب العواصف ، كي يزادا .(@)(@@) 47 وكيف تسير مبتغيا طريفا ، %~% وقد وهبت أناملك التلادا ؟(@)(@@) 48 فما ينفك ذا مال عتيد %~% فتى جعل القنوع له عتادا ،(@)(@@) 49 ولو أن السحاب همى بعقل %~% لما أروى مع النخل القتادا ،(@)(@@) 50 ولو أعطى على قدر المعالي %~% سقى الهضبات ، واجتنب الوهادا PageV01P364(@)(@@) 51 وما زلت الرشيد نهى ، وحاشا %~% لفضلك أن أذكره الرشادا(@)(@@) 52 ومثلك ، للأصادق ، مستقيد ؛ %~% وشر الخيل أصعبها قيادا .(@)(@@) 53 ورب مبالغ في كيد أمر %~% تقول له أحبته : اقتصادا(@)(@@) 54 وذي أمل تبصر كنه أمر %~% فقصر بعدما أشفى وكادا(@)(@@) 55 نراسلك التنصح في القوافي ، %~% وغيرك من نعلمه السدادا(@)(@@) 56 فإن تقبل ، فذاك هوى أناس ؛ %~% وإن تردد فلم نأل اجتهادا .(@)PageV01P365(@)(@@) البحر : وافر تام(@)(@@) 1 أيدفع معجزا الرسل قوم %~% وفيك وفي بديهتك اعتبار(@)(@@) 2 وشعرك لو مدحت به الثريا %~% لصار لها ، على الشمس ، افتخار(@)(@@) 3 كأن بيوته الشهب السواري ، %~% وكل قصيدة فلك مدار ،(@)(@@) 4 أخير حاد عن طرق الأوالي %~% فحار ؛ وآخر الشهر السرار(@)(@@) 5 ولن يحوى الثناء بغير جود ، %~% وهل تجنى من اليبس الثمار ؟(@)(@@) 6 ولم تلفظك حضرته لزهد ، %~% ولكن ضاق عن أسد وجار .(@)(@@) 7 جمال المجد أن يثنى عليه ، %~% ولولا الشمس ما حسن النهار(@)(@@) 8 وللماء الفضيلة كل حين %~% ولا سيما إذا اشتد الأوار(@)(@@) 9 وأنت السيف ، إن تعدم حليا ، %~% فلم يعدم فرندك والغرار(@)(@@) 10 وليس يزيد في جري المذاكي %~% ركاب ، فوقه ذهب ممار PageV01P366(@)(@@) 11 ورب مطوق بالتبر يكبو %~% بفارسه ، وللرهج اعتكار(@)(@@) 12 وزند عاطل يحظى بمدح %~% ويحرمه الذي فيه السوار(@)(@@) 13 إلام تكلف البيد المطايا %~% بعزم لا يقر له قرار ؟(@)(@@) 14 وخيلا ، لو جرت والريح شأوا ، %~% ظننا الريح أوثقها إسار ،(@)(@@) 15 غدت ، ولها حجول من لجين ، %~% وراحت وهي من علق نضار ،(@)(@@) 16 وأشبعت الوحوش فصاحبتها %~% كأن الخامعات لها مهار !(@)(@@) 17 وكم أوردتها عدا قديما ، %~% يلوح عليه ، من خز ، خمار(@)(@@) 18 تطاعن ، حوله ، الفرسان ، حتى %~% كأن الماء من دمهم عقار(@)(@@) 19 كذا الأقمار لا تشكو وناها %~% وليس يعيبها أبدا سفار(@)PageV01P367(@)(@@) البحر : منسرح(@)(@@) 1 تثني عليك البلاد أنك 
ms72	 لا %~% تأخذ من رفدها ، وترفدها(@)(@@) 2 من ارتعت خيله الرياض بها %~% وكان حوض الصفاء موردها ،(@)(@@) 3 ففي نبات الرؤوس تسرحها %~% أنت ، وماء الجسوم توردها ،(@)(@@) 4 خيلك ، طول الزمان ، قائلة : %~% أما لذا غاية فيقصدها ؟(@)(@@) 5 كم بمكر الطعان تحبسها %~% وكم وراء العدو تطردها .(@)(@@) 6 أعينها لم تزل حوافرها %~% تكحلها ، والغبار إثمدها(@)(@@) 7 إن لها اسوة ، إذا جزعت ، %~% في بيضك الخاليات أغمدها(@)(@@) 8 لا رقدت مقلة الجبان ولا %~% متعها بالكرى مسهدها ،(@)(@@) 9 فالنفس تبقي الحياة جاهدة %~% وفي يمين المليك مقودها(@)(@@) 10 فلا اقتحام الشجاع مهلكها ، %~% ولا توقي الجبان مخلدها PageV01P368(@)(@@) 11 لكل نفس ، من الردى ، سبب ، %~% لا يومها بعده ولا غدها(@)(@@) 12 قل لعدو الأمير : يا غرض الده %~% هر ، ومن حتف نفسه ددها(@)(@@) 13 هذا هو الموت ، كيف تغلبه ؟ %~% وفضله الشمس ، كيف تجحدها ؟(@)(@@) 14 سيوفه تعشق الرقاب فما %~% ينجز حتى اللقاء موعدها ،(@)(@@) 15 تكاد من قبل أن يجردها %~% يعتنق الدارعين مغمدها(@)(@@) 16 يروي الظبى والرماح ناهلة %~% متصل ، في الوغى ، تأودها(@)(@@) 17 كأنها شجعة بها زمع %~% أو ذات جبن فالخوف يردعها ،(@)(@@) 18 جاءتك ليلية شآمية ، %~% كأنها ، بالعراق ، مولدها(@)(@@) 19 قاتلها فاضل وأفضل من %~% قائلها الألمعي منشدها(@)(@@) 20 كاتبك الزدهي بمطقنه %~% صهوة ، حتى يخر جلمدها PageV01P369(@)(@@) 21 أسهب ، في وصفه ، علاك لنا ، %~% حتى خشينا النفوس تعبدها(@)(@@) 22 زف عروسا ، حليها كلم ، %~% تنجده تارة ، وينجدها(@)(@@) 23 قاضية حقه لديك ، وما %~% ينسب ، إلا إليك ، سوددها(@)PageV01P370(@)(@@) البحر : سريع(@)(@@) 1 ذلت ، لما تصنع أيامنا ، %~% نفوسنا تلك الأبيات ،(@)(@@) 2 تجني خمور الهم ، ما لم تكن %~% تجني الخمور العنبيات(@)(@@) 3 أمنت يا نفس صروف الردى %~% كأنها عنك غبيات .(@)(@@) 4 رب رماح طعنت في العدى ، %~% وهي الرماح القصبيات ،(@)(@@) 5 سرت لها ترمح أفلاءها %~% في الجو ، بلق عربيات(@)(@@) 6 أو نسوة الزنج بأيمانها ، %~% للرقص ، قضب ذهبيات(@)(@@) 7 إن فسدت ، من زمني ، نية ؛ %~% أو ظهرت منه خبيات(@)(@@) 8 فالأعوجيات لنا عدة ، %~% تقدمهن الأرحبيات(@)PageV01P371(@)(@@) البحر : سريع(@)(@@) 1 سالم أعدائك مستسلم ، %~% والعيش موت لهم مرغم(@)(@@) 2 بقطرة غرق أعاديك ، لا %~% ينقص منها بحرك المفعم ،(@)(@@) 3 فليس ، عن 
ms73	 نصرك ، مستأخر ؛ %~% ولا ، إلى حربك ، مستقدم(@)(@@) 4 ليهنك المجد الذي بيته %~% فوق سراة النجم ، لا يهدم(@)(@@) 5 زفت إلى دارك شمس الضحى ، %~% وحولها ، من شمع ، أنجم(@)(@@) 6 مثل شيات ، في قميص الدجى ، %~% زين بهن الفرس الأدهم ،(@)(@@) 7 تخفى ، ولا تظهر إلا إذا %~% أحرزها منزلك الأعظم(@)(@@) 8 كأنها سر الآله الذي %~% عندك ، دون الناس ، يستكتم(@)(@@) 9 كأنما الشهب %~% نثار على ال(@)(@@) 10 عمت به الآفاق ، حتى سما ، %~% منها إلى الجو به سلم ، PageV01P372(@)(@@) 11 كالدر بثته أياد بها ، %~% فهو شتيت الشمل لا ينظم ،(@)(@@) 12 أو نزلت تنهب ، في خفية ، %~% تختار ما تفعل ، أو تلهم(@)(@@) 13 وكيف لا يطمع ، في مغنم ، %~% من الثريا بعض ما يغنم ؟(@)(@@) 14 وكيف يخفى نفل ، بعضه ال %~% المريخ والجوزاء والمرزم ؟(@)(@@) 15 غير الذي جاءت به منشم %~% إلا ملاب طاب أو عندم(@)(@@) 16 كأنها من حسنها روضة %~% يضحك فيها الآس والخرم(@)(@@) 17 لم يزل الليل مقيما يرى %~% ما لا رأت عاد ولا جرهم ،(@)(@@) 18 في ساعة هشت إلى مثلها %~% مكة ، وارتاحت لها زمزم(@)(@@) 19 للطيب في حندسها سورة %~% مناخر البدر به تفعم(@)(@@) 20 حتى بدا الفجر به حمرة %~% كصارم غير منه الدم . PageV01P373(@)(@@) 21 ثم مضى يثني على سيد %~% كالليث ، إلا أنه أحزم(@)(@@) 22 مضخما ، ينظر في عطفه %~% كأن مسكا لونه الأسحم(@)(@@) 23 نال شبابا منه مستقبلا ، %~% تهرم دنياه ، ولا يهرم(@)(@@) 24 وانتشرت في الأرض ريح له %~% يسوقها المنجد والمتهم(@)(@@) 25 عطر لمن شم ، ولكنه %~% خضراء ، منه الفذ والتوأم(@)(@@) 26 وانتشقت عرفك طير الملا(@)(@@) 27 وماج بعض الوحش في بعضها ،(@)(@@) 28 تقطع ، في لقياك ، دوية ، %~% يذمها الحافر والمنسم(@)(@@) 29 فقل لمن يغتال ترب العلا : %~% الترب خير لك لو تعلم !(@)(@@) 30 ما أنت في عدة من يتقى ، %~% بل أنت في عدة من يرحم ، PageV01P374(@)(@@) 31 والقوم كالأنعام ، إن عوتبوا %~% تسمع ما قيل ، ولا تفهم(@)(@@) 32 يعصي عميد الأمة المرتضى ، %~% من بين عينيه له ميسم ،(@)(@@) 33 فتى ، لقرب الزج من كفه ، %~% أقر بالفضل له اللهذم(@)(@@) 34 أبلج ، من بعض قرى ضيفه ال %~% من 
ms74	 ، إذا لم يأمن المحرم .(@)(@@) 35 فداه من كالنبت أضيافه ، %~% إذ يشرب الماء ، ولا يطعم(@)(@@) 36 لا يكذب المقسم في قوله %~% إن الغنى من يده يقسم .(@)(@@) 37 مناقب فيها جمال الصبا %~% وهي لدات الدهر ، أو أقدم(@)PageV01P375(@)(@@) البحر : كامل تام(@)(@@) 1 ليت التحمل عن ذراك حلول ، %~% والسير عن حلب إليك رحيل(@)(@@) 2 يا ابن الذي بلسانه وبيانه %~% هدي الأنام ونزل التنزيل ،(@)(@@) 3 عن فضله نطق الكتاب وبشرت %~% بقدومه التوراة والإنجيل ،(@)(@@) 4 مني إليك ، مع الرياح ، تحية %~% مشفوعة ، ومع الوميض رسول ،(@)(@@) 5 في القلب ذكراك لا يزول وان اتى %~% دون اللقاء ، سباسب وهجول(@)(@@) 6 إن العوائق عقن عنك ركائبي ، %~% فلهن ، من طرب إليك ، هديل(@)(@@) 7 أشبهن ، الحمام ، وإنما %~% طيرانهن توقص وذميل .(@)(@@) 8 من قال أن النيرات عوامل ، %~% فبضد ذلك ، في علاك ، يقول(@)(@@) 9 يعملن فيما دونهن ، بزعمه ، %~% ولهن دونك مطلع وأفول .(@)(@@) 10 لولا انقطاع الوحي بعد محمد %~% قلنا . محمد من أبيه بديل ، PageV01P376(@)(@@) 11 هو مثله في الفضل ، إلا أنه %~% لم يأته ، برسالة ، جبريل(@)(@@) 12 قل للذي عرفت حقيقته به ، %~% إذ لا يقام على الدليل دليل :(@)(@@) 13 ما بال سابقة يصل لجامها ، %~% أرنت ، وعقد لجامها محلول ؟(@)(@@) 14 كالطرف يقلقه المراح صبابة %~% بالجري وهو مقيد مشكول .(@)(@@) 15 أكذا الجياد غذا أرادت موردا %~% نصب الفرات لها ، وغاض النيل ؟(@)(@@) 16 حجبت فلم يرها الذي قيدت له %~% وغدت بآفاق البلاد تجول ،(@)(@@) 17 ومن العجائب أن يسير آمل %~% مدحا ، ولم يعلم بها المأمول(@)(@@) 18 ما كان يركب غيرها ، لو أنه %~% عرض القريض عليه وهو خيول ،(@)(@@) 19 ويصدها قصر العنان ، فما لها %~% يوم الرهان ، إلى الأمير ، وصول(@)(@@) 20 والعيس أقتل ما يكون لها الصدى %~% والماء فوق ظهورها محمول ، PageV01P377(@)(@@) 21 وإذا نضت عن متنها برد الصبا %~% معشوقة ، فإلى الجفاء تؤول(@)(@@) 22 شابت فجد بخضابها وابعث بها %~% عجلا إليه ، فللخضاب نصول(@)(@@) 23 فهي التي صيغت لها ، من وعدك ، ال %~% أحجال امس وفصل الإكليل .(@)(@@) 24 وكلامك المرآة ، تصدق في الذي %~% تحكي ، وأنت الصارم المصقول(@)(@@) 25 لا شان صفحيك النجيع ، ولا بدا %~% للناظرين ، بمضربيك 
ms75	 ، فلول(@)PageV01P378(@)(@@) البحر : كامل تام(@)(@@) 1 ما يوم وصلك ، وهو أقصر من %~% نفس ، باطول عيشة غالي ،(@)(@@) 2 علقت حبال الشمس منك يدي ، %~% وجديدها ، في الضعف ، كالبالي(@)(@@) 3 وأردت ورد الوصل من قمر ، %~% فصدرت عنه كوارد الآل ،(@)(@@) 4 وطلبت عندك راحة ، وعلى %~% قدر اعتقادي كان إدلالي ،(@)(@@) 5 وظننت ، في البلوى ، مناي ، ولم %~% تكن المنية لي على بال .(@)(@@) 6 ما زلت أبلغ ما أهم به %~% حتى هممت بكوكب عال(@)(@@) 7 ناس ، بعد %~% مماته ، سال(@)(@@) 8 يا جنة عرضت معجلة %~% فاخترتها وعصيت عذالي ،(@)(@@) 9 يضحي الرضاب ، لأهلها ، بدلا %~% من بارد ، في الخلد ، سلسال(@)(@@) 10 إن لم تدومي ، صح في خلدي %~% أني بنار جهنم صال . PageV01P379(@)(@@) 11 وخشيت ، بعد رجاء أسورة ، %~% يوم القيامة حمل اغلال ،(@)(@@) 12 وجعلت في لمالك طمعا %~% ونهيت عن رضوان آمالي(@)(@@) 13 وارى الخسارة إن فعلت غدا %~% في النفس ، لا في الأهل والمال(@)(@@) 14 إن الإساءة شر ما وقعت %~% من بعد احسان واجمال ،(@)(@@) 15 قلبي أعاتب ، فهو يلزمني ، %~% أبدا ، تكلف هذه الحال(@)(@@) 16 والله عدل لا يضر بما %~% قلبي جناه جميع أوصالي .(@)PageV01P380(@)(@@) البحر : طويل(@)(@@) 1 لعل نواها أن تريع شطونها %~% وأن تتجلى عن شموس دجونها(@)(@@) 2 بنا من هوى سعدى البخيلة كاسمها ، %~% إذا زايلته عين سعدى وسينها(@)(@@) 3 إذا ما أنخنا حرة فوق حرة %~% بكى رحمة الوجناء منها وجينها(@)(@@) 4 ارنت بها من خشية الموت رنة %~% فدل عليها الناعبات رنينها(@)(@@) 5 يعز علينا أن يظل ابن دأية %~% يفتش ما ضمت عليه شؤونها ،(@)(@@) 6 رحلنا بها ، نبغي لها الخير مثلنا ، %~% فما آب إلا كورها ووضينها(@)(@@) 7 فقد حن سوطي في يدي من غرامها ، %~% وحن اشتياقا ، في حشاها ، حنينهها(@)(@@) 8 تعاطت نهى ، حتى إذا ما تعرضت %~% لها هضبات الشأم ، جن جنونها(@)(@@) 9 ولما رمت أبصارها تطلب الحمى ، %~% ولم تر تلك الأرض ساءت ظنونها .(@)(@@) 10 بذلنا لها محض اللجين كرامة %~% فلم يرضيها في الجنح إلا لجينها ، PageV01P381(@)(@@) 11 ولما رأتنا نذكر الماء بيننا %~% ولا ماء ، غارت من حذار عيونها(@)(@@) 12 كأنها توقت وردنا ثمد عينها ، %~% فضم إليه 
ms76	 ناظريها جبينها(@)(@@) 13 وقد حلفت أن تسأل الشمس حاجة %~% وإن سألتك اليسر برت يمينها .(@)(@@) 14 ملقي نواصي الخيل كل مرشة %~% من الطعن ، لا يرجو البقاء طعينها(@)(@@) 15 ومثكل فرسان الوغى كل نثرة %~% يود خليج راكد لو يكونها .(@)(@@) 16 إذا ألقيت في الأرض ، وهي مفازة %~% إلى الماء ، خلت الأرض يجري معينها(@)(@@) 17 وتبغي على القاع السوي تثبتا ، %~% فيمنعها من أن تثبت لينها ،(@)(@@) 18 وما برحت في ساحة السهل يرتمي %~% بها موجها ، حتى نهتها حزونها(@)(@@) 19 غدير ، وشته الريح وشية صانع ، %~% فلم يتغير ، حين دام سكونها(@)(@@) 20 كأن الدبى غرقى بها ، غير أعين ، %~% إذا رد فيها ناظر يستبينها PageV01P382(@)(@@) 21 وما حيوان البر فيها بسالم ، %~% إذا لم يغثه سيفها ، أو سفينها(@)(@@) 22 وتصغي وترني كل خلق لعلها %~% تنق ضفاديها ويلعب نونها ،(@)(@@) 23 فلو لم يضعها عنه للسلم فارس %~% لخلد ما دامت عليه غضونها ،(@)(@@) 24 ولو علمت نفس الفتى يوم حتفه ، %~% ولا قته فيها لم تحنها منونها ،(@)(@@) 25 أمون إذا أودعت نفسك حرزها %~% ولاقيت حربا ، لم يخنك أمينها(@)PageV01P383(@)(@@) البحر : طويل(@)(@@) 1 نقمت الرضى حتى على ضاحك المزن %~% فلا جادني إلا عبوس من الدجن(@)(@@) 2 فليت فمي ، إن شام سني تبسمي ، %~% فم الطعنة النجلاء تدمى بلا سن ،(@)(@@) 3 كأن ثناياه أوانس يبتغى %~% لها حسن ذكر ، بالصيانة ، والسجن(@)(@@) 4 أبي حكمت فيه الليالي ، ولم تزل %~% رماح المنايا قادرات على الطعن(@)(@@) 5 مضى طاهر الجثمان والنفس والكرى %~% وسهد المنى والجيب والذيل والردن(@)(@@) 6 فيا ليت شعري ! هل يخف وقاره ، %~% إذا صار أحد في القيامة كالعهن(@)(@@) 7 وهل يرد الحوض الروي ، مبادرا %~% مع الناس ، أم يأبى الزحام فيستأني ؟(@)(@@) 8 حجى ، زاده من جرأة وسماحة ، %~% وبعض الحجى داع إلى البخل والجبن(@)(@@) 9 على أم دفر غضبة الله إنها %~% لأجدر أنثى أن تخون وأن تخني(@)(@@) 10 كعاب دجاها فرعها ، ونهارها %~% محيا لها ، قامت له الشمس بالحسن PageV01P384(@)(@@) 11 رآها سليل الطين ، والشيب شامل %~% لها بالثريا والسماكين والوزن(@)(@@) 12 زمان تولت وأد حواء بنتها ، %~% وكم وأدت في إثر حواء من قرن ،(@)(@@) 13 
ms77	 كأن بينها يولدون ، وما لها %~% حليل فتخشى العار إن سمحت بابن .(@)(@@) 14 جهلنا ، فلم نعلم ، على الحرص ، ما الذي %~% يراد بنا ، والعلم لله ذي المن(@)(@@) 15 إذا غيب المرء استسر حديثه ، %~% ولم تخبر الأفكار عنه بما يغني(@)(@@) 16 تضل العقول الهبرزيات رشدها ، %~% ولم يسلم الرأي القوي من الإفن ،(@)(@@) 17 وقد كان أرباب الفصاحة كلما %~% رأوا حسنا عدوه من صنعة الجن ،(@)(@@) 18 وما قارنت شخا من الخلق ساعة %~% من الدهر ، إلا وهي أفتك من قرن(@)(@@) 19 وجدنا أذى الدنيا لذيذا كأنما %~% جنى النحل أصناف الشقاء الذي نجني ،(@)(@@) 20 فما رغبت في الموت كدر ، مسيرها ، %~% إلى الورد ، خمس ، ثم يشربن من أجن PageV01P385(@)(@@) 21 يصادفن صقرا كل يوم وليلة ، %~% ويلقين شرا من مخالبه الحجن ،(@)(@@) 22 ولا قلقات الليل باتت كأنها %~% من الأين والإدلاج بعض القنا اللدن ،(@)(@@) 23 ضربن مليعا بالسنابك أربعا %~% إلى الماء ، لا يقدرن منه على معن(@)(@@) 24 وخوف الردى آوى إلى الكهف أهله ، %~% وكلف نوح وابنه عمل السفن ،(@)(@@) 25 وما استعذبته روح موسى وآدم %~% وقد وعدا ، من بعده ، جنتي عدن(@)(@@) 26 أمولى القوافي ، كم اراك انقيادها %~% لك الفصحاء العرب ، كالعجم اللكن(@)(@@) 27 هنيئا لك البيت الجديد موسدا %~% ونادبة ، في مسمعي ، كل قينة(@)(@@) 28 مجاور سكن في ديار بعيدة %~% من الحي ، سقيا للدياروللسكن !(@)(@@) 29 طلبت يقينا من جهينة عنهم ، %~% ولن تخبريني ، يا جهين ، سوى الظن(@)(@@) 30 فإن تعهديني لا أزال مسائلا %~% فإني لم أعط الصحيح فأستغني ، PageV01P386(@)(@@) 31 وإن لم يكن للفضل ثم مزية %~% على النقص ، فالويل الطويل من الغبن(@)(@@) 32 أمر بربع ، كنت فيه ، كأنما %~% أمر من الإكرام بالحجر والركن(@)(@@) 33 وإجلال مغناك اجتهاد مقصر %~% إذا السيف أودى فالعفاء على الجفن .(@)(@@) 34 لقد مسخت قلبي وفاتك طائرا ، %~% فأقسم أن لا يستقر على وكن ،(@)(@@) 35 يقضي بقايا عيشه وجناحه %~% حيث الدواعي في الإقامة والظعن ،(@)(@@) 36 كأن دعاء الموت باسمك نكزة %~% يد يدت الحسنى ، وأنفاس ربها(@)(@@) 37 تئن ونصبي ، في أنينك ، واجب ؛ %~% كما وجب النصب ، اعترافا ، على إن(@)(@@) 38 ضعفت عن الإصباح ، والليل ذاهب 
ms78	 ، %~% كما فنى المصباح في آخر الوهن .(@)(@@) 39 وما أكثر المثني عليك ، ديانة ، %~% لو أن حماما كان يثنيه من يثني ،(@)(@@) 40 يوافيك من رب العلى الصدق بالرضى %~% بشيرا ، وتلقاك الأمانة بالامن ، PageV01P387(@)(@@) 41 ويكني شهيد المرء غيرك هيبة %~% وبقيا ، وإن يسأل شهيدك لا يكني(@)(@@) 42 يصرح بقول ، دونه المسك نفحة ، %~% وفعل كامواه الجنان بلا أسن ،(@)(@@) 43 يد بدت الحسنى وأنفاس ربها %~% تقى ، ولسان لا تحرك باللسن .(@)(@@) 44 فليتك في جفني موارى ، نزاهة %~% بتلك السجايا عن حشاي وعن ضبني(@)(@@) 45 ولو حفروا في درة ما رضيتها %~% لجسمك ، إبقاء عليه من الدفن(@)(@@) 46 ولو أودعوك الجو خفنا مصيفه %~% ومشتاه وازداد الضنين من الضن .(@)(@@) 47 فيا قبر واه من تراكب لينا %~% عليه وآه من جنادللك الخشن ،(@)(@@) 48 لأطبقت إطباق المحارة ، فاحتفظ %~% بلؤلؤة المجد الحقيقة بالخزن ،(@)(@@) 49 فهل أنت إن ناديت رمسك سامع %~% نداء ابنك المفجوع بل عبدك القن ؟(@)(@@) 50 سأبكي إذا غنى ابن ورقاء بهجة %~% وإن كان ما يعنيه ضد الذي أعني PageV01P388(@)(@@) 51 ونادية في مسمعي كل قينة %~% تغرد باللحن البري عن اللحن(@)(@@) 52 واحمل فيك الحزن حيا ، فإن امت %~% وألقك ، لم أسلك طريقا إلى الحزن(@)(@@) 53 وبعدك لا يهوى الفؤاد مسرة %~% وإن خان في وصل السرور ، فلا يهني(@)PageV01P389(@)(@@) البحر : طويل(@)(@@) 1 بني الحسب الوضاح والشرف الجم %~% لساني إن لم أرث والدكم خصمي ،(@)(@@) 2 شكوت من الأيام تبديل غادر %~% بواف ونقلا من سرور إلى هم ،(@)(@@) 3 وحالا كريش النسر ، بينا رأيته %~% جناحا لشهم ، آض ريشا على سهم(@)(@@) 4 ولا مثل فقدان الشريف محمد %~% رزية خطب أو جناية ذي جرم ،(@)(@@) 5 فيا دافنيه في الثرى إن لحده %~% مقر الثريا ، فادفنوه على علم(@)(@@) 6 ويا حاملي اعواده إن فوقها %~% سماوي سر فاتقوا كوكب الرجم ،(@)(@@) 7 وما نعشه إلا كنعش وجدته %~% أبا لبنات ، لا يخفن من اليتم(@)(@@) 8 فويح المنايا لم يبقين غاية ، %~% طلعن الثنايا ، واطلعن على النجم(@)(@@) 9 أعاذل إن صم القنا عن نعيه %~% فوا حسدا من بعده للقنا الصم(@)(@@) 10 بكى السيف ، حتى أخضل الدمع جفنه 
ms79	 %~% على فارس يرويه من فارس الدهم PageV01P390(@)(@@) 11 تلذ العوالي والظبى في بنانه %~% لقاء الرزايا ، من فلول ومن حطم(@)(@@) 12 وبالله ربي ، ما تقلد صارما %~% له مشبة في يوم حرب ولا سلم ،(@)(@@) 13 ولا صاح بالخيل : أقدمي في عجاجة %~% إذا قيل حيدي قال في ضنكها أمي ،(@)(@@) 14 ولا صرف الخطي ، مثل يمينه ، %~% يمين ، وإن كانت معاودة النعم(@)(@@) 15 ولا أمسكت يسرى عنانا ، لغارة ، %~% كيسراه ، والفرسان طائشة العزم(@)(@@) 16 فيا قلب لا تلحق بثكل محمد %~% سواه ليبقى ثكله بين الوسم(@)(@@) 17 فإني رأيت الحزن للحزن ماحيا ، %~% كما خط في القرطاس رسم على رسم ،(@)(@@) 18 كريم ، حليم الجفن والنفس لا يرى %~% إذا هو أغفى ، ما يرى الناس في الحلم ،(@)(@@) 19 فتى عشقته البابلية حقبة %~% إلى الشرب ما ينفي الحباب من السم ،(@)(@@) 20 تسور إليه الراح ثم تهابه %~% كأن الحميا لوعة في ابنة الكرم PageV01P391(@)(@@) 21 دعا حلبا ، أخت الغربين ، مصرع %~% بسيف قويق للمكارم والحزم ،(@)(@@) 22 أبي السبعة الشهب التي قيل إنها %~% منفذة الأقدار في العرب والعجم ،(@)(@@) 23 وإن كنت ما سميتهم ، فنباهة %~% كفتني فيهم أن أعرفهم باسم(@)(@@) 24 فيا معشر البيض اليمانية اسألي %~% بنية طعاما إذا سغبت إلى اللحم ،(@)(@@) 25 فكل وليد ، منهم ، ومجرب %~% لنا خلف من ذلك السيد الصتم ،(@)(@@) 26 مغافرهم تيجانهم ، وحباهم %~% حمائلهم ، والفرع ينمي إلى الجذم(@)(@@) 27 مناجيد ، لباسون كل مفاضة ، %~% كأن غديرا فاض منها على الجسم(@)(@@) 28 كأنهم فيها أسود خفية %~% ولكن ، على أكتادها ، حلل الرقم(@)(@@) 29 كماة إذا الاعراف كانت أعنة %~% فمغنيهم حسن الثبات عن الحزم(@)(@@) 30 يطيلون أرواق الجياد ، وطالما %~% ثنوهن عضبا ، غير روق ولا جم PageV01P392(@)(@@) 31 إذا ملأتهن القنا جبرية %~% وغيظا فأوقعن الحفيظة بالاجم ،(@)(@@) 32 ورفتن مجدول الشكيم ، كأنما %~% أشرن إلى ذوا من النبت بالأزم(@)(@@) 33 فوارس حرب يصبح السك مازجا %~% به الركض نقعا ، في أنوفهم الشم(@)(@@) 34 فهذا ، وقد كان الشريف أبوهم %~% أمير المعاني ، فارس النثر والنظم(@)(@@) 35 إذا قيل نسك ، فالخيل بن آزر ، %~% وإن قيل فهم ، فالخليل أخو الفهم .(@)(@@) 36 أقامت بيوت الشعر تحكم ، بعده 
ms80	 ، %~% بناء المراثي ، وهي صور إلى الهدم(@)(@@) 37 نعيناه حتى للغزالة والسهى ، %~% فكل تمنى لو فداه من الحتم ،(@)(@@) 38 وما كلفة البدر المنير قديمة ؛ %~% ولكنها في وجهه أثر اللدم(@)(@@) 39 فيا مزمع التوديع ! إن تمس نائيا ، %~% فإنك دان في التخيل والوهم ،(@)(@@) 40 كأنك لم تجرر قناة ، ولم تجر %~% فتاة ، ولم تجبر أميرا على حكم PageV01P393(@)(@@) 41 ووجهك لم يسفر ، ونارك لم تنر ، %~% ورمحك لم يعتر ، وكفك لم تهم(@)(@@) 42 تقرب جبريل بروحك صاعدا %~% إلى العرش ، يهديها لجدك والأم(@)(@@) 43 فدونك مختوم الرحيق فإنما %~% لتشرب منه كان يحفظ بالختم ،(@)(@@) 44 ولا تنسني في الحشر والحوض حوله %~% عصائب شتى ، بين غر إلى بهم(@)(@@) 45 لعلك ، في يوم القيامة ، ذاكري ، %~% فتسأل ربي أن يخفف من إثمي(@)PageV01P394(@)(@@) البحر : خفيف تام(@)(@@) 1 غير مجد في ملتي واعتقادي %~% نوح باك ولا ترنم شاد(@)(@@) 2 وشبيه صوت النعي ، إذا قي %~% س بصوت البشير في كل ناد(@)(@@) 3 أبكت تلكم الحمامة ، أم غ %~% نت على فرع غصنها المياد ؟(@)(@@) 4 صاح ! هذي قبورنا تملأ الرح %~% ب ، فأين القبور من عهد عاد ؟(@)(@@) 5 خفف الوطء ! ما أظن أديم ال %~% إلا من هذه الأجساد ،(@)(@@) 6 وقبيح بنا ، وان قدم العهد ، %~% هوان الآباء والأجداد .(@)(@@) 7 سر ، إن اسطعت ، في الهواء رويدا %~% لا اختيالا على رفات العباد(@)(@@) 8 رب لحد قد صار لحدا مرارا ، %~% ضاحك من تزاحم الأضداد ،(@)(@@) 9 ودفين على بقايا دفين %~% في طويل الأزمان والآباد .(@)(@@) 10 فاسأل الفرقدين عمن أحسا %~% من قبيل وآنسا من بلاد ، PageV01P395(@)(@@) 11 كم أقاما على زوال نهار %~% وأنارا لمدلج في سواد(@)(@@) 12 تعب كلها الحياة فما أعجب %~% إلا من راغب في ازدياد ،(@)(@@) 13 إن حزنا في ساعة الموت اضعا %~% ف سرور في ساعة الميلاد .(@)(@@) 14 خلق الناس للبقاء ، فضلت %~% أمة يحسبونهم للنفاد(@)(@@) 15 إنما ينقلون من دار أعما %~% ل إلى دار شقوة ، أو رشاد(@)(@@) 16 ضجعة الموت ، رقدة يستريح %~% جسم فيها ، والعيش مثل السهاد(@)(@@) 17 أبنا الهديل أسعدن أوعد %~% ن ، قليل العزاء بالإسعاد ،(@)(@@) 18 إيه ! لله دركن ، فأنتن ال 