ms24	 و خليفة علي عليه السلام على الكوفة.(@)(@@)(@@)(@@) $ 755 - عنبسة بن جبير، روى عنه عبد الاعلى.(@)(@@)(@@)(@@) $ 756 - عامر بن طريف. 6(@)(@@)(@@)(@@) $ 757 - علقمة بن قيس، قتل بصفين، وأخوه أبي بن قيس.(@)PageV00P077(@)(@@)(@@)(@@) $ 758 - عابس بن ربيعة النخعي.(@)(@@)(@@)(@@) $ 759 - عمرو بن الأصم، وكان اتي الحسن عليه السلام بالمدينة فذكر له ما قال أهل الغلو، فأنكر عليه السلام عليهم.(@)(@@)(@@)(@@) $ 760 - عبد خير الخيواني، خيوان من همدان. 1(@)(@@)(@@)(@@) $ 761 - عبد الله بن سخبر الأزدي، يكنى أبا معمر. 2(@)(@@)(@@)(@@) $ 762 - عبيد الله بن زياد، قدم البصرة بعد قتل الحسين عليه السلام فقال له بشر بن عباد بن قيس بن ثعلبة وقد كان عرفه برأيه، فقال له: ما تقول في الحسين عليه السلام؟ فقال: وما عسيت ان أقول في الحسين عليه السلام يقدم على جده فيشفع له وتقدم على ابن زياد فيشفع لك، فلم يجد إليه سبيلا، فقال: قد عرفنا غشك فالزمنا.(@)(@@)(@@)(@@) $ 763 - عبد الله بن أبي السفر الهمداني.(@)(@@)(@@)(@@) $ 764 - عبد الله بن أبي سخيلة الخراساني.(@)(@@)(@@)(@@) $ 765 - عبد الله بن عمير.(@)(@@)(@@)(@@) $ 766 - عبد الله بن سلمة، الذي قال له: ما يسرني اني لم اشهد صفين و لوددت ان كل مشهد شهده علي عليه السلام شهدته.(@)(@@)(@@)(@@) $ 767 - عوف العقيلي.(@)(@@)(@@)(@@) $ 768 - عبد الله بن وال التميمي. 3(@)PageV00P078(@)(@@)(@@)(@@) || باب الفاء(@)(@@)(@@)(@@) $ 769 - الفرات بن عمرو، يكنى أبا بشر.(@)(@@)(@@)(@@) $ 770 - الفاكه بن سعد، قتل بصفين.(@)(@@)(@@)(@@) || باب القاف(@)(@@)(@@)(@@) $ 771 - قيس بن سعد بن عبادة، وهو ممن لم يبايع أبا بكر.(@)(@@)(@@)(@@) $ 772 - قنبر، مولى أمير المؤمنين عليه السلام، لم نعثر له على رواية.(@)(@@)(@@)(@@) $ 773 - قيس بن يزيد.(@)(@@)(@@)(@@) $ 774 - قرظة بن كعب. 1(@)(@@)(@@)(@@) $ 775 - قيس بن عبد ربه.(@)(@@)(@@)(@@) $ 776 - قترة الساعدي.(@)(@@)(@@)(@@) $ 777 - قثم بن العباس بن عبد المطلب.(@)(@@)(@@)(@@) $ 778 - القعقاع. 2(@)(@@)(@@)(@@) $ 779 - قيس بن عقدية الجشمي، 3 من جشم بن معاوية بن بكر، اسمه ملك.(@)(@@)(@@)(@@) $ 780 - قبيصة بن شداد.(@)(@@)(@@)(@@) $ 781 - القعقاع بن عمرو التميمي. 4(@)PageV00P079(@)(@@)(@@)(@@) $ 782 - قيس بن عبادة البكري.(@)(@@)(@@)(@@)