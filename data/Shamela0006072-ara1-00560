ms541	 الجنة أحد ولأحد من أهل النار قبلة مظلمة(@)(@@)(@@)(@@) | 8061 - (@)(@@) أبو سعيد(@)(@@) يقول الله عز وجل يوم القيامة قد شفع النبيون والملائكة وشفع المؤمنون وبقي أرحم الراحمين فيقبض قبضة أو قبضتين فيخرج من النار خلق كثير(@)(@@)(@@)(@@) | 8062 - (@)(@@) أبو هريرة(@)(@@) يقول الله عز وجل لعبده يوم القيامة عبدي أما رأيت ميتا على أعواد(@)(@@) فصل(@)(@@)(@@)(@@) | 8063 - (@)(@@) أبو ذر الغفاري(@)(@@) يقول الله عز وجل يا عبادي إنكم(@)(@@) PageV00P000(@)(@@) تخطئون بالليل والنهار وأنا أغفر الذنوب جميعا ولا أبالي فاستغفروني أغفر لكم(@)(@@)(@@)(@@) | 8064 - (@)(@@) ابن مسعود(@)(@@) يقول الله عز وجل يا دنيا اخدمي من خدمني وأتعبي يا دنيا من خدمك(@)(@@)(@@)(@@) | 8065 - (@)(@@) ابن مسعود(@)(@@) يقول الله عز وجل للدنيا يا دنيا مري على أوليائي ولا تحلولي لهم فقتليهم(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8066 - (@)(@@) معاذ بن جبل(@)(@@) يقول الله عز وجل يا شام أنت صفوتي من بلادي وأنا سائق إليك صفوتي من عبادي من كل مولدة فيك فأختار عليك فيذنب منه ومن كل مولده من غيرك وأختارك على مولده فبرحمة مني يا شام أتسعى لهم بالرزق كما يتسع الرحم للولد وعيني عليك بالظل والمطر(@)(@@)(@@)(@@) | 8067 - (@)(@@) أبو الدرداء(@)(@@) يقول الله عز وجل طال شوق الأبرار إلى لقائي وأنا إليهم أشد شوقا(@)(@@)(@@)(@@) | 8068 - (@)(@@) معاذ بن جبل(@)(@@) يقول الله عز وجل للمؤمنين هل أحببتم لقائي فيقولون نعم يا ربنا فيقول لم فيقولون رجونا عفوك ومغفرتك فيقول إني قد أوجبت لكم رحمتي(@)(@@)(@@)(@@) | 8069 - (@)(@@) علي(@)(@@) يقول الله عز وجل من آمن بي وبنبيي وبوليي أدخلته الجنة على ما كان من عمله(@)(@@)(@@)(@@) | 8070 - (@)(@@) أبو هريرة(@)(@@) يقول الله عز وجل من شغله قراءة القرآن عن دعائي وسألني أعطيته أفضل ما أعطي السائلين(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8071 - (@)(@@) سلمان الفارسي(@)(@@) يقول الله عز وجل من توضأ في بيته وأحسن الوضوء ثم زارني في بيت من بيوتي فإياي زار وحق على المزور أن يكرم الزائر(@)(@@)(@@)(@@) | 8072 - (@)(@@) أنس بن مالك(@)(@@) يقول الله عز وجل من لم يقبل من عبادي الميسور ولم يدع المعسور لم أنفس كربته ولم أسمع دعائه ولم أستجب له(@)(@@) فصل(@)(@@)(@@)(@@) | 8073 - (@)(@@) ابن عباس(@)(@@) يقول الله 
ms542	 عز وجل لست بناظر في حق عبدي حتى ينظر عبدي في حقي(@)(@@)(@@)(@@) | 8074 - (@)(@@) أبو هريرة(@)(@@) يقول الله عز وجل استقرضت عبدي فلم(@)(@@) PageV00P000(@)(@@) يقرضني ويشتمني عبدي وهو لا يدري يقول وادهراه وأنا الدهر(@)(@@)(@@)(@@) | 8075 - (@)(@@) ابن مسعود(@)(@@) يقول الله عز وجل من لم تصم جوارحه عن محارمي فلا حاجة لي في أن يدع طعامه وشرابه من أجلي(@)(@@)(@@)(@@) | 8076 - (@)(@@) أبو هريرة(@)(@@) يقول الله عز وجل إن سألني عبدي أعطيته وإن لم يسألني غضبت عليه(@)(@@)(@@)(@@) | 8077 - (@)(@@) أنس(@)(@@) يقول الله عز وجل السخي مني وأنا منه وإني لأدفع عن السخي عذاب القبر وشدة القيامة والسخي يمشي على الأرض وأنا عنه راض(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8078 - (@)(@@) المنتجع(@)(@@) يقول الله عز وجل ما غضبت على أحد غضبي على عبد أتى معصية فتعاظمها في جنب عفوي فلو كنت معجلا للعقوبة أو كانت العجلة من شأني لعجلتها للقانطين من رحمتي ولو لم أرحم عبادي إلا من خوفهم من بين يدي لشكوت ذلك لهم وجعلت ثوابهم منه الأمن لما خافوا(@)(@@)(@@)(@@) | 8079 - (@)(@@) ابن عباس(@)(@@) يقول الله عز وجل المنفق يقرضني والمصلي يناجيني(@)(@@)(@@)(@@) | 8080 - (@)(@@) علي(@)(@@) يقول الله عز وجل اشتد غضبي على من ظلم من لا يجد ناصرا غيري(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8081 - (@)(@@) أنس بن مالك(@)(@@) يقول الله عز وجل الشاب المؤمن بقدري الراضي بكتابي القانع برزقي التارك شهوته من أجلي أنت عندي كبعض ملائكتي(@)(@@)(@@)(@@) | 8082 - (@)(@@) علي بن أبي طالب(@)(@@) يقول الله عز وجل المعرفة حصني والتوحيد حصاري فمن دخل حصني من باب حصاري أمنته من عذابي وعقابي(@)(@@)(@@)(@@) | 8083 - (@)(@@) أبو هريرة(@)(@@) يقول الله عز وجل أحب عبادي إلي أعجلهم فطرا(@)(@@)(@@)(@@) | 8084 - (@)(@@) أنس(@)(@@) يقول الله عز وجل أخرجوا من النار من ذكرني وخافني في مقام(@)(@@) PageV00P000(@)(@@) فصل(@)(@@)(@@)(@@) | 8085 - (@)(@@) أنس بن مالك(@)(@@) يقول الله عز وجل انظروا في ديوان عبادي فمن رأيتموه سألني الجنة أعطيته ومن استعاذني من النار أعذته(@)(@@)(@@)(@@) | 8086 - (@)(@@) أنس(@)(@@) يقول الله عز وجل أربع خصال واحدة فيما بيني وبينك وواحدة فيما بينك وبين عبادي وواحدة لي وواحدة لك فأما التي لي فتعبدني لا تشرك بي شيئا وأما التي 
ms543	 لك علي فما عملته من خير جزيتك به وأما التي بيني وبينك فمنك الدعاء وعلي الإجابة وأما التي بينك وبين عبادي فترضى لهم ما ترضى لنفسك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8087 - (@)(@@) أبو هريرة(@)(@@) يقول الله عزوجل إذا أراد عبدي أن يعمل سيئة فلا تكتبوها عليه حتى يعملها فإن عملها فاكتبوها بمثلها وإن تركها من أجلي فاكتبوها له حسنة(@)(@@)(@@)(@@) | 8088 - (@)(@@) أنس بن مالك(@)(@@) يقول الله عز وجل يحزن عبدي المؤمن إذا أقترت عليه الدنيا وذلك أقرب له مني ويفرح إذا بسطت له شيئا من الدنيا وذلك أبعد له مني(@)(@@)(@@)(@@) | 8089 - (@)(@@) أبو هريرة(@)(@@) يقول الله عز وجل أبتلي عبدي المؤمن فإن لم يشكوني إلى عواده أطلقه من أسري ثم أبدله لحما خيرا من لحمه ودما خيرا من دمه ثم يستأنف العمل(@)(@@)(@@)(@@) | 8090 - (@)(@@) عمار بن زعكرة(@)(@@) يقول الله عز وجل عبدي الذي هو عبدي حقا الذي يذكرني وإن كان ملاقيا قرنه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8091 - (@)(@@) عبد الله بن سلام(@)(@@) يقول الله عز وجل للعبد يوم القيامة ألم تدعني في مرض كذا وكذا فعافيتك ألم تدعني أن أزوجك فلانة وهي كريمة قومها فزوجتك ألم ألم(@)(@@)(@@)(@@) | 8092 - (@)(@@) أنس(@)(@@) يقول الله عز وجل من أعظم مني جودا أكلأهم في مضاجعهم كأنهم لم يعصوني ومن كرمي أني أقبل توبة التائب حتى(@)(@@) PageV00P000(@)(@@) كأنه لم يزل تائبا من ذا الذي قرع بابي فلم أفتح له من ذا الذي سألني فلم زعطه أبخيل أنا فيبخلني عبدي(@)(@@) فصل(@)(@@)(@@)(@@) | 8093 - (@)(@@) أبو بكر الصديق(@)(@@) يقول الله عز وجل قل لأمتك يقولوا لا حول ولا قوة إلا بالله عشرا عند الصبح وعشرا عند المساء وعشرا عند النوم يدفع عنهم عند النوم بلوى الدنيا وعند المساء مكايدة الشيطان وعند الصبح من غضبي(@)(@@)(@@)(@@) | 8094 - (@)(@@) جابر بن عبد الله(@)(@@) يقول الله عز وجل كل يوم للجنة طيبي لأهلك فتزداد طيبا فذلك البرد الذي يجده الناس يسحر من ذلك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8095 - (@)(@@) أنس بن مالك(@)(@@) يقول الله عز وجل لأهون أهل النار عذابا لو أن لك ما على الأرض من شيء أكنت مفتديا به فيقول نعم فيقول 
ms544	 قد أردت منك أهون من هذا وأنت في صلب آدم أن لا تشرك بي فأبيت إلا أن تشرك بي(@)(@@)(@@)(@@) | 8096 - (@)(@@) أبو هريرة(@)(@@) يقول الله عز وجل لا ينبغي لعبد أن يقول أنا خير من يونس بن متى(@)(@@)(@@)(@@) | 8097 - (@)(@@) أبو ذر الغفاري(@)(@@) يقول الله عز وجل لأقطعن أمل كل مؤمل أمل دوني بالأياس ولألبسنه ثوب المذلة بين الناس ولأنحينه من قربي ولأبعدنه من وصلي أيأمن عبدي غيري من الشدائد والشدائد بيدي وأنا الحي الكريم ويرجو غيري وبيدي مفاتيح الأبواب وبابي مفتوح لمن دعاني من ذا الذي ألمني لعظيم نوائبه فقطعت به دونها(@)(@@) PageV00P000(@)(@@) أو من ذا الذي رجاني لعظيم جرمه فقطعت رجاءه مني جعلت آمال عبادي متصلة بي وملأت سمواتي من لا يمل تسبيحي فيا بؤسا للقانطين من رحمتي ويا شقوة لمن عصاني ولم يراقبني(@)(@@) فصل(@)(@@)(@@)(@@) | 8098 - (@)(@@) عمر بن الخطاب(@)(@@) يقول الله عز وجل إن من عبادي من لا يصلح إيمانه إلا بالغنى ولو أفقرته لكفر وإن من عبادي من لا يصلح إيمانه إلا بالسقم ولو صححته لكفر وإن من عبادي من لا يصلح إيمانه إلا بالصحة ولو أسقمته لكفر(@)(@@)(@@)(@@) | 8099 - (@)(@@) أبو هريرة(@)(@@) يقول الله عز وجل إن عبدي المؤمن بمنزلة كل خير يحمدني وأنا أنزع نفسه من بين جنبيه(@)(@@)(@@)(@@) | 8100 - (@)(@@) أنس(@)(@@) يقول الله عز وجل إن من عبادي من لا يصلح(@)(@@) PageV00P000(@)(@@) إيمانه إلا بالغنى ولو أفقرته لكفر وإن من عبادي من لا يصلح إيمانه إلا بالسقم ولو أصححته لكفر وإن من عبادي من لا يصلح إيمانه إلا بالصحة ولو أسقمته لكفر(@)(@@)(@@)(@@) | 8101 - (@)(@@) علي(@)(@@) يقول الله عز وجل لا إله إلا الله حصني فمن قالها دخل حصني ومن دخل حصني أمن عذابي(@)(@@)(@@)(@@) | 8102 - (@)(@@) أبو سعيد(@)(@@) يقول الله عز وجل إن عبدا صححت له(@)(@@) PageV00P000(@)(@@) جسمه ووسعت عليه في المعيشة تمضي عليه خمسة أعوام لا يفد إلي لمحروم(@)(@@) يعني لا يحج إلي في كل خمسة أعوام(@)(@@)(@@)(@@) | 8103 - (@)(@@) أبو بكر الصديق(@)(@@) يقول الله عز وجل إن كنتم تريدون رحمتي فارحموا خلقي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8104 - (@)(@@) أبو سعيد(@)(@@) يقول 
ms545	 الرب عز وجل يوم القيامة سيعلم أهل الجمع اليوم من أهل الكرم مجالس الذكر في المساجد(@)(@@)(@@)(@@) | 8105 - (@)(@@) أنس(@)(@@) يقول الله عز وجل كل يوم أنا العزيز فمن أراد عز الدارين فليطع العزيز(@)(@@) فصل(@)(@@)(@@)(@@) | 8106 - (@)(@@) أبو هريرة(@)(@@) ينزل الله عز وجل كل ليلة إلى السماء الدنيا في نصف الليل الآخر أو الثلث الآخر فيقول من ذا الذي يدعوني(@)(@@) PageV00P000(@)(@@) فأستجيب له من يسألني فأعطيه من يستغفرني فأغفر له حتى يطلع الفجر ثم يبسط يده ثم يقول من يقرض غير عدوم ولا ظلوم(@)(@@)(@@)(@@) | 8107 - (@)(@@) أبو بكر الصديق(@)(@@) ينزل الله عز وجل ليلة النصف من شعبان إلى سماء الدنيا فيغفر لكل إنسان إلا إنسانا في قلبه شحناء أو شرك(@)(@@)(@@)(@@) | 8108 - (@)(@@) جابر بن عبد الله(@)(@@) ينزل الله عز وجل إلى سماء الدنيا يوم عرفة فيباهي بهم الملائكة فيقول يا ملائكة هؤلاء عبادي شعثا غبرا جاءوا من كل فج عميق لم يروا عذابي ولم يشهدوا رحمتي أشهدكم أني قد غفرت لهم(@)(@@)(@@)(@@) | 8109 - (@)(@@) أبو الدرداء(@)(@@) ينزل الله عز وجل آخر ثلاث ساعات تبقين من الليل فينظر الله في الساعة الأولى منهن في الكتاب الذي لا ينظر فيه أحد غيره فيمحو ما يشاء ويثبت ثم ينظر في الساعة الثانية من(@)(@@) PageV00P000(@)(@@) جنات عدن وهو مسكنه الذي لا يسكن معه فيها أحد إلا الأنبياء والشهداء والصديقون وفيها ما لم يره أحد ولا يخطر على قلب بشر ثم يهبط في آخر ساعة من آخر الليل فيقول ألا مستغفر يستغفرني فأغفر له ألا سائل يسألني فأعطيه ألا داع يدعوني فأستجيب له حتى يطلع الفجر وذلك قوله وقرآن الفجر إن قرآن الفجر كان مشهودا فيشهده الله وملائكة الليل والنهار(@)(@@)(@@)(@@) | 8110 - (@)(@@) عبادة بن الصامت(@)(@@) ينزل ربنا عز وجل في كل ليلة إلى السماء الدنيا فلا يزال ذلك حتى يصلي الصبح ثم يعلو ربنا عز وجل على كرسيه ينزل الرب عز وجل إلى السماء الدنيا في الثلث الأخير من الليل فلا يبقى ذو روح إلا علم به غير التقلين الجن والإنس وذلك حين ينهق الحمار 
ms546	 وتنبح الكلاب ويصيح الديك(@)(@@)(@@)(@@) | 8111 - (@)(@@) أبو هريرة(@)(@@) ينزل ربنا عز وجل في ظلال من الغمام والملائكة فيضع عرشه حيث يشاء من الأرض ثم يهتف الله بصوته فيقول يا معشر الجن والإنس إني قد أنصت لكم منذ يوم خلقتكم أبصر أعمالكم وأسمع قولكم فأنصتوا إلي فإنما هي أعمالكم وصحفكم يقرأ عليكم فمن وجد خيرا فليحمد الله ومن وجد غير ذلك فلا يلومن إلا نفسه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8112 - (@)(@@) علي(@)(@@) يحمد الرب نفسه كل يوم ثلاث مرات من ثلث الليل الباقي إلى طلوع الفجر والثاني بعد طلوع الشمس إلى أن تصير كهيئتها في العصر والثالث عند زوال الشمس إلى صلاة الظهر فيقول الله تعالى إني أنا الله لا إله إلا أنا العلي العظيم أني أنا الله لا إله إلا أنا العفو الغفور إني أنا الله لا إله إلا أنا أرحم الراحمين إني أنا الله لا إله إلا أنا مالك يوم الدين إني أنا الله لا إله إلا أنا مبدي كل شيء معيده إني أنا الله لا إله إلا أنا لم أزل ولا أزال إني أنا الله لا إله ألا أنا خالق الشر والخير إني أنا الله لا إله إلا أنا خالق الجنة والنار أني أنا الله لا إله إلا أنا الواحد الأحد الصمد إني أنا الله لا إله إلا أنا عالم الغيب والشهادة إني أنا الله لا إله إلا أنا الملك القدسي أني أنا الله لا إله إلا أنا السلام المؤمن إني أنا الله لا إله إلا أنا المهيمن العزيز إني أنا الله لا إله إلا أنا الكبير المتعال قال فمن حمد الله بهذه المحامد فيقول أنت الله لا إله إلا أنت حتى يأتي على هذه الأسماء كتبه الله من الفائزين المخلصين التائبين الحامدين الراكعين الساجدين المختبين(@)(@@) فصل(@)(@@)(@@)(@@) | 8113 - (@)(@@) أبو موسى(@)(@@) يدا الله عز وجل يبسطان لمسيء الليل(@)(@@) PageV00P000(@)(@@) ليتوب بالنهار ولمسيء النهار ليتوب بالليل حتى تطلع الشمس من مغربها(@)(@@)(@@)(@@) | 8114 - (@)(@@) أبو هريرة(@)(@@) يد الله عز وجل ملأى لا يفيضها نفقة سحا الليل والنهار أرأيتم ما 
ms547	 أنفق منذ خلق السماء والأرض فإنه لم يغض ما في يده وكان عرشه على الماء وبيده الميزان يخفض ويرفع سحا يعني دائمة الصب(@)(@@)(@@)(@@) | 8115 - (@)(@@) أسامة بن شريك(@)(@@) يد الله عز وجل على الجماعة فإذا شذ الشاذ منهم اختطفته الشياطين كما يختطف الذئب الشاة من الغنم(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8116 - (@)(@@) ابن عمر(@)(@@) يد الله عز وجل على الجماعة اتبعوا السواد الأعظم فإنه من شذ شذ في النار(@)(@@)(@@)(@@) | 8117 - (@)(@@) أبو أيوب(@)(@@) يد الله عز وجل مع القاسم حين يقسم ويد الله مع القاضي حين يقضي(@)(@@)(@@)(@@) | 8118 - (@)(@@) أبو هريرة(@)(@@) يد الله عز وجل بين الشريكين ما لم يخن أحدهما صاحبه فإذا خان خرج من بينهما(@)(@@) فصل(@)(@@)(@@)(@@) | 8119 - (@)(@@) ابن عمر(@)(@@) يطوي الله عز وجل السموات يوم القيامة ثم يأخذهن بيده اليمنى ثم يقول أنا الملك أين الجبارون أين المتكبرون ثم(@)(@@) PageV00P000(@)(@@) يطوي الأرضين ثم يأخذهن بشماله ثم يقول أنا الملك أين الجبارون أين المتكبرون(@)(@@)(@@)(@@) | 8120 - (@)(@@) أنس بن مالك(@)(@@) يبعث الله عز وجل مناديا يوم القيامة ينادي من كان له على الله أجر فليقم إلى أجره ذلك فيأخذه فيقال وما ذلك الأجر قال من ظلم في دار الدنيا فعفا وأصلح فأجره على الله فيقومون إلى أجرهم ذلك وهم قليلون في أمتي كثير من الأمم(@)(@@)(@@)(@@) | 8121 - (@)(@@) أبو هريرة(@)(@@) يبعث الله عز وجل الخلائق يوم القيامة وأفئدتهم كأفئدة الطير(@)(@@)(@@)(@@) | 8122 - (@)(@@) ابن عباس(@)(@@) يدفع الله عز وجل عن أمتي من يصلي(@)(@@) عمن لا يصلي ولو اجتمعوا على ترك الصلاة ما ناظرهم الله عز وجل طرفة عين وسائر الأعمال كذلك(@)(@@)(@@)(@@) | 8122 - (@)(@@) مكرر أنس(@)(@@) يدفع عن مستمع القرآن بلوى الدنيا ويدفع عن قارئ القرآن سوء الآخرة واستماع آية من كتاب الله عز وجل خير من كنز الذهب ولقراءة اية من كتاب الله أفضل مما تحت العرش لأنه كلام الله تكلم به قبل أن يخلق الخلق فمن ألحد فيه أو قال فيه برأيه فقد كفر ولولا أن الله عز وجل يسره على ألسن البشر لما قدر(@)(@@) PageV00P000(@)(@@) أحد أن بتكلم بكلام الرحمن وهو قوله تعالى {ولقد 
ms548	 يسرنا القرآن للذكر فهل من مدكر}(@)(@@)(@@)(@@) | 8123 - (@)(@@) ابن مسعود(@)(@@) يبعث الله عز وجل من هذه البقعة ومن هذا الحرم سبعين ألفا يدخلون الجنة بغير حساب يشفع كل واحد منهم في سبعين ألفا وجوهم كالقمر ليلة البدر(@)(@@)(@@)(@@) | 8124 - (@)(@@) أنس(@)(@@) يرفع الله عز وجل بهذا العلم أقواما فيجعلهم قادة يقتدى بهم في الخير وتقتص آثارهم وترمق أعمالهم وترغب الملائكة في خلتهم تمسحهم بأجنحتها(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8125 - (@)(@@) ابن عباس(@)(@@) يمحو الله عز وجل من قلوب أهل الجنة ذكر الاباء والأمهات والإخوان والمعارف ممن استوجب النار فلا يذكرونهم أبدا(@)(@@)(@@)(@@) | 8126 - (@)(@@) ابن عباس(@)(@@) يمحو الله ما يشاء ويثبت وعنده أم الكتاب يمحو من الأجل ما يشاء ويزيد فيه ما يشاء(@)(@@)(@@)(@@) | 8127 - (@)(@@) ابن مسعود(@)(@@) يجمع الله عز وجل الأولين والآخرين لميقات يوم معلوم فياما أربعين سنة شاخصة أبصارهم إلى السماء ينتظرون فصل القضاء وينزل الله عز وجل في ظلل من الغمام من العرش إلى الكرسي(@)(@@)(@@)(@@) | 8128 - (@)(@@) ابن عمر(@)(@@) يجمع الله عز وجل أطفال أمة محمد يوم القيامة من حياض تحت العرش فيطلع الله إليهم أطلاعة فيقول مالي(@)(@@) PageV00P000(@)(@@) اراكم رافعي رؤوسكم فيقولون يا ربنا والآباء والأمهات في عطش يوم القيامة ونحن في هذه الحياض فيوحي الله إليهم أن أغرقوا في هذه الآنية من هذا الماء ثم خللوا صفوف القيامة فاسقوا الآباء والأمهات(@)(@@)(@@)(@@) | 8129 - (@)(@@) الحسين بن علي بن أبي طالب(@)(@@) يوحي الله إلى الحفظة الكرام البررة لا تكتبوا على عبدي عند ضجره شيئا(@)(@@)(@@)(@@) | 8130 - (@)(@@) علي(@)(@@) يمحو الله ما يشاء ويثبت وعنده أم الكتاب الصدقة واصطناع المعروف وصلة الرحم وبر الوالدين يحول الشقاء سعادة ويزيد من العمر ويقي مصارع السوء(@)(@@)(@@)(@@) | 8131 - (@)(@@) أنس بن مالك(@)(@@) يحشر الله عز وجل الزاني يوم القيامة وذكره في فمه ويخرج من أذنيه وعينيه فيجمد ذلك على جسده أمثال(@)(@@) PageV00P000(@)(@@) الجبال الرواسي ويسيل من دموعه فوقه فيصيره ذلك كله حيات وعقارب يعذب به(@)(@@)(@@)(@@) | 8132 - (@)(@@) عبد الله بن أنيس(@)(@@) يحشر الله عز وجل العباد عراة غرلا بهما ثم يناديهم بصوت يسمعه من بعد كما يسمعه من قرب أنا الملك 
ms549	 أنا الديان لا ينبغي لأحد من أهل الجنة أن يدخل الجنة ولأحد من أهل النار عنده مظلمة حتى أقصه منه حتى اللطمة(@)(@@) بهما يعني ليس معهم شيء(@)(@@)(@@)(@@) | 8133 - (@)(@@) أبو هريرة(@)(@@) يرحم الله لوطا لقد كان يأوي إلى ركن شديد إذ قال لقومه لو أن لي بكم قوة أو آوي إلى ركن شديد فما بعث الله من بعده نبيا إلا في ثروة من قومه(@)(@@)(@@)(@@) | 8134 - (@)(@@) ابن عباس(@)(@@) يرحمنا الله وأخا عاد(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8135 - (@)(@@) ابن عباس(@)(@@) يمن علي ربي عز وجل وأهل المن بي(@)(@@)(@@)(@@) | 8136 - (@)(@@) أبو أمامة(@)(@@) يمين الله عز وجل طباق السموات والأرض(@)(@@)(@@)(@@) | 8137 - (@)(@@) ابن عمر(@)(@@) يا واسع المغفرة اغفر لي(@)(@@)(@@)(@@) | 8138 - (@)(@@) عبد الله بن عمرو(@)(@@) يملأ الله عز وجل أيديكم من الأعاجم ويصيرون أسدا لا يفرون يضربون أعناقكم ويأكلون فيكم(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8139 - (@)(@@) أبو هريرة(@)(@@) ينشىء الله عز وجل السحاب ثم ينزل فيه الماء فلا شيء أحسن منه من ضحكه ولا شيء أحسن من منطقه منطقه الرعد ومضحكه البرق(@)(@@)(@@)(@@) | 8140 - (@)(@@) ابن عباس(@)(@@) ينزل الله عز وجل في كل يوم مائة رحمة ستين على الطائفين وعشرين على أهل مكة وعشرين على سائر الناس(@)(@@)(@@)(@@) | 8141 - (@)(@@) جابر بن عبد الله(@)(@@) يدخل الله عز وجل بالحجة الواحدة(@)(@@) PageV00P000(@)(@@) ثلاثة نفر الجنة الميت والحاج عنه والمنفذ ذلك له(@)(@@)(@@)(@@) | 8142 - (@)(@@) أنس(@)(@@) يشفع الله يعني آدم من جميع ذريته في مائة ألف ألف وعشرة ألف ألف(@)(@@)(@@)(@@) | 8143 - (@)(@@) أبو طلحة(@)(@@) يا مالك يوم الدين إياك نعبد وإياك نستعين(@)(@@)(@@)(@@) | 8144 - (@)(@@) عائشة(@)(@@) يا مصرف القلوب ثبت قلبي على طاعتك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8145 - (@)(@@) ابن عمر(@)(@@) يا عدتي عند كربتي ياصاحبي عند شدتي ويا ولي نعمتي يا إلهي وإله آبائي لا تكلني إلى نفسي فأقترب من الشر وأتباعد من الخير وآنسني في قبري من وحشتي واجعل لي عهدا يوم القيامة مسؤولا(@)(@@)(@@)(@@) | 8146 - (@)(@@) البراء بن عازب(@)(@@) يثبت الله الذين آمنوا بالقول الثابت نزلت في عذاب القبر يقال له من ربك فيقول ربي الله ونبي محمد فذلك قوله {يثبت الله الذين آمنوا بالقول الثابت}(@)(@@)(@@)(@@) | 8147 - (@)(@@) أبي بن كعب(@)(@@) يعرفني الله 
ms550	 عز وجل نفسه يوم القيامة فأسجد له سجدة يرضى بها عني ثم أمدحه مدحة يرضى بها عني ثم يأذن(@)(@@) PageV00P000(@)(@@) لي في الكلام ثم يأمر أمتي يمرون على الصراط بين ظهراني جهنم يمرون أسرع من الطرف والسهم المرمى به وأسرع من أجاويد الخيل حتى يخرج رجل فيها حبوا وهي الأعمال(@)(@@) فصل(@)(@@)(@@)(@@) | 8148 - (@)(@@) أبو موسى وجابر(@)(@@) يتجلى لنا ربنا عز وجل ضاحكا يوم القيامة حتى ينظروا إلى وجهه فيخرون له سجدا فيقول ارفعوا رؤوسكم فليس هذا بيوم عبادة(@)(@@)(@@)(@@) | 8149 - (@)(@@) ابن مسعود(@)(@@) يكشف ربنا عز وجل عن ساقه عز وجل يوم القيامة فيقع الناس سجدا ويبقى قوم ظهورهم كصياصي البقر لا يستطيعون السجود(@)(@@)(@@)(@@) | 8150 - (@)(@@) ابن عباس(@)(@@) يغفر الله ليلة الجمع لأهل الوقت وليلة المزدلفة لأهل عرفة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8151 - (@)(@@) أبو الدرداء(@)(@@) يا حبذا نوم الأكياس وإفطارهم كيف الحمقى وصيامهم ولمثقال حبة من صاحب تقوى ويقين خير من عبادة أهل الأرض(@)(@@)(@@)(@@) | 8152 - (@)(@@) عقبة بن عامر(@)(@@) يعجب ربكم من راعي غنم على شظية في الجبل ينادي ويقيم الصلاة فيقول عبدي يؤذن ويقيم الصلاة ويصلي قد غفرت له وأوجبت له الجنة(@)(@@) الشظية قطعة من رؤوس الجبال(@)(@@)(@@)(@@) | 8153 - (@)(@@) ثوبان(@)(@@) يقبل الجبار عز وجل يوم القيامة فيثني رجله على الجسر فيقول وعزتي وجلالي لا يجاورني اليوم ظلم ظالم فينصف الخلق بعضهم من بعض حتى أنه لينصف الشاة الجماء من العضباء تنطحها نطحة(@)(@@) PageV00P000(@)(@@) فصل(@)(@@)(@@)(@@) | 8154 - (@)(@@) معاذ بن جبل(@)(@@) يا أيها الناس اتخذوا تقوى الله تجارة يأتيكم الرزق بلى بضاعة ولا تجارة ثم قرأ ومن يتق الله يجعل له مخرجا ويرزقه من حيث لا يحتسب(@)(@@)(@@)(@@) | 8155 - (@)(@@) علي بن أبي طالب(@)(@@) يا أيها الناس اتخذوا السراويلات فإنهن من أستر ثيابكم وحصنوا بها نسائكم إذا خرجن(@)(@@)(@@)(@@) | 8156 - (@)(@@) عمر(@)(@@) يا ابن الخطاب أتراني قد رضيت وتأبى قال فرضيت(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8157 - (@)(@@) أنس(@)(@@) يا حبذا كل ناطق عالم ومستمع واع(@)(@@)(@@)(@@) | 8158 - (@)(@@) الضحاك بن ميسر(@)(@@) يا أيها الناس أخلصوا أعمالكم لله فإن الله عز وجل لا يقبل من الأعمال إلا ما خلص له ولا تقولوا هذا لله وللرحم(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8159 
ms551	 - (@)(@@) أنس بن مالك(@)(@@) يا أيها الناس ابتاعوا أنفسكم من الله فإن بخل أحدكم أن يعطي ماله للناس فليتصدق على نفسه فليأكل وليكتس مما رزقه الله(@)(@@)(@@)(@@) | 8160 - (@)(@@) أبي بن كعب(@)(@@) يا أيها الناس اذكروا الله اذكروا الله جاءت الراجفة تتبعها الرادفة جاء الموت بما فيه(@)(@@)(@@)(@@) | 8161 - (@)(@@) طارق بن عبد الله(@)(@@) يا أيها الناس قولوا لا إله إلا الله تفلحوا(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8162 - (@)(@@) ابن عمر(@)(@@) يا أيها الناس استثنوا ولو بعد شهر(@)(@@)(@@)(@@) | 8163 - (@)(@@) الحسين بن علي(@)(@@) يا أيها الناس لا تدفعوني فوق حقي فإن الله عز وجل اتخذني عبدا قبل أن يتخذني نبيا(@)(@@)(@@)(@@) | 8164 - (@)(@@) محمود بن لبيد(@)(@@) يا أيها الناس إياكم وشرك السرائر فقيل يا رسول الله وما شرك السرائر قال يقوم الرجل يصلي فيزنين صلاته جاهدا لما يرى من نظر الناس إليه فذاك شرك السرائر(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8165 - (@)(@@) عائشة(@)(@@) ينسخ الله الخير في أربع ليال نسخا ليلة الأضحى والفطر وليلة النصف من شعبان تنسخ فيها الآجال والأرزاق ويكتب فيها الحج وفي ليلة عرفة إلى الآذان(@)(@@)(@@)(@@) | 8166 - (@)(@@) جبير بن مطعم(@)(@@) يا أيها الناس لا تقدموا قريشا فتهلكوا ولا تخلفوا عنها فتضلوا ولا تعلموها وتعلموا منها فإنهم أعلم منكم ولولا أن تبطر قريش لأخبرتها بالذي لها عند الله عز وجل(@)(@@)(@@)(@@) | 8167 - (@)(@@) أبو هريرة(@)(@@) يا أيها الناس لا تغتروا بالله فإن الله عز وجل لو كان مغفلا شيئا لأغفل الذرة والخردلة والبعوضة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8168 - (@)(@@) أبو سلمة(@)(@@) يا أيها الناس خذوا من الأعمال ما تطيقون فإن الله عز وجل لا يمل حتى تملوا(@)(@@)(@@)(@@) | 9618 - (@)(@@) جابر بن عبد الله(@)(@@) يا أيها الناس توبوا إلى ربكم قبل أن تموتوا وتقربوا إلى الله بالعمل الصالح قبل أن تشغلوا وتحببوا إليه بالصدقة في السر والعلانية تجبروا وتنصروا وترزقوا(@)(@@)(@@)(@@) | 8170 - (@)(@@) أبو هريرة(@)(@@) يا أيها الناس إن الله طيب لا يقبل إلا طيبا وإن الله أمر المؤمنين بما أمر به المرسلين فقال {يا أيها الناس كلوا مما في الأرض حلالا طيبا} وقال {يا أيها الرسل كلوا من الطيبات واعملوا صالحا}(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8171 - (@)(@@) يعلى(@)(@@) يا أيها الناس إن 
ms552	 الله عز وجل حيي فإذا اغتسل أحدكم فليستتر(@)(@@)(@@)(@@) | 8172 - (@)(@@) عطية بن بشر(@)(@@) يا أيها الناس إن الله عز وجل أمرني أن أعلمكم مما علمني وأؤدبكم لا يكثرن أحدكم الكلام عند المجامعة فإنه يكون منه خرس الولد ولا ينظرن أحدكم إلى فرج امرأته إذا هو يجامعها فإنه يكون منه العمى ولا يقبلن أحدكم امرأته إذا هو يجامعها فإنه يكون الصمم صمم الولد ولا يديمن أحدكم النظر في الماء فإنه منه يكون ذهاب العقل(@)(@@)(@@)(@@) | 82173 - (@)(@@) سبرة بن معبد(@)(@@) يا أيها الناس إني قد كنت أذنت لكم في متعة النساء فإنه الله عز وجل قد حرمها إلى يوم القيامة فمن كان عنده منهن شيء فليفارقها ولا تأخذوا مما آتيتموهن شيئا(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8174 - (@)(@@) عمر بن الخطاب(@)(@@) يا أيها الناس إني أوتيت جوامع الكلام وخواتمه ولقد آتيتكم بها بيضاء نقية فلا تتهوكوا ولا يغرنكم المتهوكون(@)(@@)(@@)(@@) | 8175 - (@)(@@) أنس بن مالك(@)(@@) يا أيها الناس إن أنجاكم يوم القيامة من أهوالها ومواطنها أكثركم علي صلاة في دار الدنيا(@)(@@)(@@)(@@) | 8176 - (@)(@@) عبد الرحمن بن أبي المرقع(@)(@@) يا أيها الناس إن الحمى رائد الموت وسجن الله في الأرض وقطعة من النار فإذا أخذتكم فبردوا الماء في الشنان وصبوا عليكم ما بين الصلاتين يعني المغرب والعشاء(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8177 - (@)(@@) أبو بكر الصديق(@)(@@) يا أيها الناس إنكم تقرؤن هذه الآية وتضعونها على غير ما وضعها الله {يا أيها الذين آمنوا عليكم أنفسكم لا يضركم من ضل إذا اهتديتم} إن الناس إذا رأوا المنكر فلم يغيروه يوشك أن يعمهم الله بعقاب(@)(@@)(@@)(@@) | 8178 - (@)(@@) الحسن(@)(@@) يا أيها الناس إن لكم علما فانتهوا إلى علمكم وإن لكم نهاية فانتهوا إلى نهايتكم وإن المؤمن بين مخافتين بين أجل قد مضى لا يدري كيف يصنع الله فيه وبين أجل قد بقي لا يدري كيف الله صانع فيه فليتزود المرء من نفسه لنفسه ومن دنياه لآخرته ومن الشباب قبل الهرم ومن الصحة قبل السقم فإنكم للأخرة خلقتم والدنيا خلقت لكم والذي نفس محمد بيده ما بعد الموت مستعتب وما بعد الدنيا دار إلا 
ms553	 الجنة أو النار وأستغفر الله عز وجل لي ولكم(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8179 - (@)(@@) علي بن أبي طالب(@)(@@) يا أيها الناس إنكم في دار هدنة وأنتم على ظهر سفر والسير بكم سريع فأعدوا الجهاز لبعد المفاز(@)(@@)(@@)(@@) | 8180 - (@)(@@) أبو فراس(@)(@@) يا أيها الناس إياكم والبدع والذي نفس محمد بيده لا يبتدع رجل في الإسلام شيئا ليس في كتاب الله إلا ما خلف مما ابتدع(@)(@@)(@@)(@@) | 8181 - (@)(@@) ابن عمر(@)(@@) يا أيها الناس إذا كنتم في الصلاة فإن الله عز وجل أمامكم فلا يتنخمن أحد أمامه(@)(@@)(@@)(@@) | 8182 - (@)(@@) مخنف بن سليم(@)(@@) يا أيها الناس على كل أهل بيت في كل عام أضحاة وعتيرة وهل تدرون ما العتيرة هي التي تسمونها الرجبية(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8183 - (@)(@@) أم جندب(@)(@@) يا أيها الناس عليكم بالسكينة والوقار عليكم بمثل حصا الحذف(@)(@@)(@@)(@@) | 8184 - (@)(@@) ابن عمر(@)(@@) يا أيها الناس من باع محفلة فهو بالخيار ثلاثة أيام فإن ردها رد معها مثلي لبنها أو مثل لينها قمحا(@)(@@)(@@)(@@) | 8185 - (@)(@@) أبو سعيد(@)(@@) يا أيها الناس لا دين لمن دان بجمود آية من كتاب الله لا دين لمن دان بفرية باطل ادعاها إلى الله لا دين لمن دان بطاعته من عصى الله عز وجل(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 9186 - (@)(@@) ابن عمر(@)(@@) يا أيها الناس إن هذه الدنيا دار التواء لا دار استواء ومنزل فرح لا منزل فرخ فمن عرفها لم يفرح لرخاء ولم يحزن لشقاء ألا وإن الله خلق الدنيا دار بلوى والآخرة دار عقبى فجعل بلوى الدنيا الثواب الآخرة سببا وثواب الآخرة من بلوى الدنيا عوضا فيأخذ ليعطي ويبتلي ليجزي فاحذروا حلاوة رضاعها لمرارة فطامها واهجروا لذيذ عاجلها لكربة آجلها ولا تسعوا في عمران دار قد قضى الله خرابها ولا تواصلوها وقد أراد منكم اجتنابها فتكونوا لسخطه متعرضين ولعقوبته مستحقين(@)(@@)(@@)(@@) | 8187 - (@)(@@) كعب بن مالك(@)(@@) يا أيها الناس إن أبا بكر لم يسؤني قط فاعرفوا ذلك له إني راض عن عمر وعثمان وعلي وطلحة والزبير وعبد الرحمن وسعد والمهاجرين الأولين فاعرفوا ذلك لهم إن الله قد غفر لأهل بدر(@)(@@) PageV05P281(@)(@@)(@@)(@@) | 8188 - (@)(@@) الحبيبة(@)(@@) يا أيها الناس لا تسوؤني 
ms554	 في أصحابي ولا ختاني وأصهاري لا يطلبنكم الله بمظلمة واحد منهم فإنها لا توهب ارفعوا ألسنتكم عن المسلمين وإذا مات الرجل منهم فقولوا فيه خيرا(@)(@@) فصل(@)(@@)(@@)(@@) | 8189 - (@)(@@) سمرة بن جندب(@)(@@) يا بن آدم أتدري لما خلقت خلقت للحساب وخلقت للنشور والوقوف بين يدي الله عز وجل وليس ثم ثالثة دار إنما هي الجنة والنار فإن عملت بما يرضي الرحمن عز وجل فالجنة دارك ومأواك وإن عملت بما يسخطه فالنار لا يقوم لها خيار ولا شيطان مريد ولا حجر ولا مدر ولا حدير خلقت من غضب الله على أهل جحوده(@)(@@)(@@)(@@) | 8190 - (@)(@@) أبو هريرة(@)(@@) يا بن آدم أبرر والديك وصل رحمك ييسر لك يسرك ويمد لك في عمرك وأطع ربك تسمى عاقلا ولا تعصه تسمى جاهلا(@)(@@)(@@)(@@) | 8191 - (@)(@@) ابن عمر(@)(@@) يا ابن آدم عندك ما يكفيك وأنت تطلب ما يطغيك لا بقليل تقنع ولا من كثير تشبع إذا أصبحت آمنا في سرك معافا في بدنك معك قوت يومك فعلى الدنيا العفا والسرب الملك والطريق خل سربه أي طريقه والسرب مال القوم وجمعه سروب(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8192 - (@)(@@) ابن عباس(@)(@@) يا بن آدم ما تصنع الدنيا حلالها حساب وحرامها عذاب(@)(@@)(@@)(@@) | 8193 - (@)(@@) ابن مسعود(@)(@@) يا بن آدم لا تكون زاهدا حتى تكون متواضعا(@)(@@)(@@)(@@) | 8194 - (@)(@@) أنس بن مالك(@)(@@) يا بن آدم لا تنظر إلى صغير الخطيئة ولكن انظر إلى من عصيت(@)(@@)(@@)(@@) | 8195 - (@)(@@) أبو أمامة(@)(@@) يا بن آدم إن تبذل الفضل خيرا لك وإن تمسك شرا لك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8196 - (@)(@@) سمرة بن جندب(@)(@@) يا بن ادم إرض من الدنيا بقوت فإن القوت لمن يموت كثير(@)(@@)(@@)(@@) | 8197 - (@)(@@) أبو سعيد(@)(@@) يا بني آدم إن كنتم تعقلون فعدوا أنفسكم من الموتى والذي نفسي بيده إنما توعدون لآت وما أنتم بمعجزين(@)(@@)(@@)(@@) | 8198 - (@)(@@) زيد بن ثابت(@)(@@) يا بن آدم كنت بخيلا ما دمت سعيا فلما حضرتك الوفاة عمدت إلى مالك تبدده فلا تجمع خصلتين إساءة في(@)(@@) PageV00P000(@)(@@) الحياة وإساءة عند الموت انظر إلى قرابتك الذين يحزنون ولا يرثون فأوصل إليهم بمعروف(@)(@@) فصل(@)(@@)(@@)(@@) | 8199 - (@)(@@) عمرو بن عوف(@)(@@) يا معشر 
ms555	 قريش إنكم الولاة بعدي لهذا الأمر فلا تموتن إلا وأنتم مسلمون واعتصموا بحبل الله جميعا ولا تفرقوا ولا تكونوا كالذين تفرقوا واختلفوا من بعد ما جاءتهم البينات {وما أمروا إلا ليعبدوا الله مخلصين له الدين حنفاء} الآية(@)(@@)(@@)(@@) | 81200 - (@)(@@) أبو سعيد(@)(@@) يا معشر قريش إن أوليائي منكم المتقون فإن كنتم تتقون الله فأنتم أوليائي وإن كان غيركم أتقى لله عز وجل فهو أولى بي(@)(@@)(@@)(@@) | 8201 - (@)(@@) أبو هريرة(@)(@@) يا معشر قريش أنقذوا أنفسكم من النار يا معشر بني عبد مناف أنقذوا أنفسكم من النار يا معشر بني هاشم أنقذوا(@)(@@) PageV00P000(@)(@@) أنفسكم من النار يا معشر بني عبد مناف أنقذوا أنفسكم من النار يا فاطمة بنت محمد أنقذي نفسك من النار يا فاطمة بنت محمد أنقذي نفسك من النار إني لا أملك لك من الله شيئا إلا أن لكم رحما وأنا بالها ببلالها(@)(@@)(@@)(@@) | 8202 - (@)(@@) عبد الله بن عمر(@)(@@) يا معشر قريش اتبعوني تطأ العرب أعتابكم قال فقال أبو جهل لو تابعناك ما تبعتك مضر ولا ربيعة فقال بلى والله وفارس والروم(@)(@@)(@@)(@@) | 8203 - (@)(@@) كثير بن عبد الله بن عمرو بن عوف(@)(@@) يا معشر قريش احفظوني في أصحاء وأبناء أبنائهم(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8204 - (@)(@@) ابن عباس(@)(@@) يا معشر قريش اتقوا الله ولا تمنعوا من الحاج شيئا مما ينتفع به فإن فعلتم فأنا خصمكم يوم القيامة(@)(@@)(@@)(@@) | 8205 - (@)(@@) ابن عباس(@)(@@) يا معشر قريش لا يسلبنكم الموال على التجارة فإن الرزق عشرون بابا تسعة عشر منها للتاجر وباب واحد للصانع وما أملق تاجر صدوق إلا تاجر حلاف مهين(@)(@@)(@@)(@@) | 8206 - (@)(@@) سعيد بن زيد(@)(@@) يا معشر العرب احمدوا الله إذ رفع عنكم العشير(@)(@@)(@@)(@@) | 8207 - (@)(@@) ابن عباس(@)(@@) يا معشر بني هاشم إنها تصيبكم بعدي جفرة فاستعينوا عليها بأرقاء الناس(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8208 - (@)(@@) كعب بن مالك(@)(@@) يا معشر المهاجرين إنكم قد أصبحتم ترتدون فإن الأنصار قد انتهوا أو إنهم غيبتي التي أويت إليها فاكرموا محسنهم وتجاوزوا عن مسيئهم(@)(@@)(@@)(@@) | 8209 - (@)(@@) ابن عمر(@)(@@) يا معشر المهاجرين خصال خمس وأعوذ بالله أن تدركوهن لن تظهر الفاحشة في قوم قط حتى يغلبوا 
ms556	 إلا فشا فيهم الطاعون والأوجاع التي لم تكن مضت من أسلافهم الذين مضوا ولم ينقصوا المكيال والميزان إلا أخذوا بالسنين والشدة وشدة المؤنة وجور السلطان عليهم ولم يمنعوا زكاة أموالهم إلا منعوا القطر من السماء ولولا البهائم لم يمطروا ولم ينقضوا عهد الله وعهد رسول الله إلا سلط الله عليهم عدوهم من غيرهم فأخذوا بعض ما كان في أيديهم ولم يحكم أئمتهم بكتاب الله ويتخيروا فيما أنزل الله إلا جعل الله بأسهم بينهم(@)(@@)(@@)(@@) | 8209 - (@)(@@) مكرر عتبة بن طويع المازني(@)(@@) يا معشر الموالي شراركم(@)(@@) PageV00P000(@)(@@) من تزوج من العرب ويا معشر العرب شراركم من تزوج من الموالي(@)(@@)(@@)(@@) | 8210 - (@)(@@) عباد بن بشر(@)(@@) يا معشر الأنصار أنتم الشعار والناس الدثار لا أوتين من قبلكم(@)(@@)(@@)(@@) | 8211 - (@)(@@) أبو هريرة(@)(@@) يا معشر الأنصار إني عبد الله ورسوله هاجرت إلى الله وإليكم المحيا محياكم والممات مماتكم إن الله عز وجل ورسوله يصدقانكم ويعذرانكم(@)(@@)(@@)(@@) | 8212 - (@)(@@) علي بن أبي طالب(@)(@@) يا معشر المسلمين احذروا البغي فإنه ليس من عقوبة أحضر من عقوبة البغي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8213 - (@)(@@) أبو هريرة(@)(@@) يا معشر الفقراء إن الله رضي لي أن إقامتي لمجالستكم فإن الله قال {واصبر نفسك مع الذين يدعون ربهم بالغداة والعشي} فإنها مجالسة الأنبياء قبلكم(@)(@@)(@@)(@@) | 8214 - (@)(@@) ابن مسعود(@)(@@) يا معشر الشباب من استطاع منكم الباءة فليتزوج فإنه أغض للبصر وأحصن للفرج ومن لا فيصم فإن الصوم له وجاء(@)(@@)(@@)(@@) | 8215 - (@)(@@) البراء بن عازب(@)(@@) يا معشر من آمن بلسانه ولم يؤمن بقلب ولا تعتابوا المسلمين ولا تطلبوا عثراتهم فإنهم من يطلب عثرات(@)(@@) PageV00P000(@)(@@) المسلمين يطلب الله عثراته ومن يطلب الله عثراته يفضحه الله وهو في بيته(@)(@@)(@@)(@@) | 8216 - (@)(@@) أبو هريرة(@)(@@) يا معشر الفقراء أعطوا الله عز وجل الرضا من قلوبكم تظفروا بثواب فقركم وإلا فلا(@)(@@)(@@)(@@) | 8217 - (@)(@@) أبو شيخ(@)(@@) يا معشر محارب نصركم الله عز وجل لا تسقوني حلب امرأة(@)(@@)(@@)(@@) | 8218 - (@)(@@) أنس بن مالك(@)(@@) يا معشر التجار إنكم تقولون في شرائكم لا والله وبلى والله فشوبوه بالصدقة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8219 - (@)(@@) جابر بن عبد الله(@)(@@) يا معشر المسلمين اتقوا الله وصلوا أرحامكم 
ms557	 فإنه ليس من ثواب أسرع من صلة الرحم وإياكم والبغي فإنه ليس من عقوبة أسرع من عقوبة البغي(@)(@@) فصل(@)(@@)(@@)(@@) | 8220 - (@)(@@) أبو سعيد(@)(@@) يا معشر النساء تصدقن ولو من حليكن فإنكن أكثر أهل جهنم من أجل أن تكثرن اللعن وتكفرن العشير ما رأيت ناقصات عقل ودين أذهب للب الرجل الحازم من أحديكن(@)(@@)(@@)(@@) | 8221 - (@)(@@) امرأة حذيفة(@)(@@) يا معشر النساء أما لكن في الفضة ما تحلين أما إنه ليس منكن امرأة تحلت ذهبا إلا عذبت به(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8222 - (@)(@@) أبو سعيد(@)(@@) يا معشر النساء ليس لكن من سراة الطريق شيء عليكن بحافتي الطريق(@)(@@) سراة الطريق ظهر الطريق(@)(@@)(@@)(@@) | 8223 - (@)(@@) أبو سعيد(@)(@@) يا معشر النساء إذا سجد الرجال فاغضضن أبصاركن لا ترين عورات الرجال من ضيق الأزر(@)(@@)(@@)(@@) | 8224 - (@)(@@) علي بن أبي طالب(@)(@@) يا معشر النساء اتقين الله والتمسن مرضاة أزواجكن فإن المرأة لو تعلم ما حق زوجها لم تزل قائمة ما حضر غداؤه وعشاؤه(@)(@@)(@@)(@@) | 8225 - (@)(@@) أبي أمامة(@)(@@) يا معشر النسوان أما إن خياركن يدخلن الجنة(@)(@@) PageV00P000(@)(@@) قبل خيار الرجال فتغسلن وتطيبن وتدفعن إلى أزواجهن على براذين الحمر والصور والخضر تسعى الولدان كأنهن اللؤلؤ المنثور(@)(@@) فصل(@)(@@)(@@)(@@) | 8226 - (@)(@@) أبو هريرة(@)(@@) يا بني عبد مناف يا بني هاشم يا بني عبد المطلب يا فاطمة بنت محمد يا صفية ويا عباس لا أغني عنكم من الله سلوني من مالي ما شئتم(@)(@@)(@@)(@@) | 8227 - (@)(@@) قبيصة بن مخارق(@)(@@) يا بني عبد مناف إني نذير إنما مثلي ومثلكم كمثل رجل أتى العدو فذهب يخبوا أهله فخشي أن يسبقه العدو فجعل ينادي أو يهتف يا صاحباه(@)(@@)(@@)(@@) | 8228 - (@)(@@) جبير بن مطعم(@)(@@) يا بني عبد مناف لا تمنعوا أحدا طاف بهذا البيت وصلى اية ساعة من ليل أو نهار(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8229 - (@)(@@) عمران بن حصين(@)(@@) يا بني هاشم إن أوليائي منكم المتقون يا بني هاشم لا ألفينكم تأتوني بالدنيا تحملونها على ظهوركم ويأتوني الناس بالآخرة(@)(@@)(@@)(@@) | 8230 - (@)(@@) ابن عباس(@)(@@) يا بني عبد المطلب إني سألت الله عز وجل لكم ثلاث سألته أن يثبت قائمكم ويعلم جاهلكم ويهدي ضالكم(@)(@@)(@@)(@@) | 8231 - (@)(@@) المغيرة الهاشمي(@)(@@) يا 
ms558	 بني هاشم إياكم والصدقة لا تعملوا عليها فإنها لا تصلح لكم وإنما هي أوساخ الناس فقال عمر لتعملن عليها أو لتأتيني ببينة على ما تقول فقام أكثر من عشرين يشهد على النبي صلى الله عليه وسلم أنه سمعه يقول ذلك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8232 - (@)(@@) ابن عباس(@)(@@) يا أهل مكة إنكم في وسط من الأرض ونجد أوسط السماء وبأقل الأرض مطرا فأقولا من اتخاذ الماشية(@)(@@)(@@)(@@) | 8233 - (@)(@@) ابن عباس(@)(@@) يا شباب قريش احفظوا فروجكم ألا من حفظ الله فرجه فله الجنة(@)(@@)(@@)(@@) | 8234 - (@)(@@) أنس(@)(@@) يا شباب تزوج وإياك والزنا فإنه ينزع الإيمان من قلبك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8235 - (@)(@@) ابن عباس(@)(@@) يا أهل مكة إن الله عز وجل احتجب بخمس لم يطلع عليها ملكا مقربا ولا نبيا مرسلا فقد ادعى علمهن فقد كفر {إن الله عنده علم الساعة وينزل الغيث} الآية(@)(@@)(@@)(@@) | 8236 - (@)(@@) أبو هريرة(@)(@@) يا أهل المدينة إن الله عز وجل قد أنزل في تحريم الخمر فمن كتب منكم هذه الاية وعنده منها شيء فلا يشربها ولا يبيعها واسكبوها في طريق المدينة(@)(@@)(@@)(@@) | 8237 - (@)(@@) أبو هريرة(@)(@@) يا أهل الخلود يا أهل البقاء إنكم لم تخلقوا للقاء وإنما تنقلون من دار إلى دار كما نقلتم من الأصلاب إلى الأرحام ومن الأرحام إلى الدنيا ومن الدنيا إلى القبور ومن الموقف إلى الخلود في الجنة أو النار(@)(@@) فصل(@)(@@)(@@)(@@) | 8238 - (@)(@@) أنس بن مالك(@)(@@) يا حامل القرآن أعجل عينيك بالبكاء(@)(@@) PageV00P000(@)(@@) إذا ضحك البطالون قم الليل إذا نام النائمون صم إذا أكل الآكلون أعف عن من ظلمك لا تحقد فيمن يحقد ولا تجهل فيمن يجهل(@)(@@)(@@)(@@) | 8239 - (@)(@@) ابن مسعود(@)(@@) يا حامل القرآن تزين بالقرآن يزينك الله عز وجل ولا تزين به للناس فيشينك الله عز وجل(@)(@@)(@@)(@@) | 8240 - (@)(@@) الحسين بن علي(@)(@@) يا حامل القرآن إن أهل السموات يذكرونكم عند الله عز وجل فتحببوا إلى الله بتوقير كتابه ليزدد لكم حبا ويحببكم إلى عباده(@)(@@)(@@)(@@) | 8241 - (@)(@@) عيينة المليكي(@)(@@) يا أهل القرآن لا تتوسدوا القرآن واتلوه(@)(@@) PageV00P000(@)(@@) حق تلاوتة من آناء الليل والنهار وأفشوه وتعنوه وتدبروا ما فيه لعلكم تفلحون ولا تعجلوا ثوابه 
ms559	 فإن له ثوابا(@)(@@)(@@)(@@) | 8242 - (@)(@@) علي بن أبي طالب(@)(@@) يا أهل القرآن أوتروا فإن الله وتر يحب الوتر(@)(@@)(@@)(@@) | 8243 - (@)(@@) ابن عمر(@)(@@) يا من الموت غائبه يا من القبر منزله يا من الكفن ستره يا من التراب وساده يا من الدود جيرانه يا من المنكر والنكير زواره(@)(@@)(@@)(@@) | 8244 - (@)(@@) أنس بن مالك(@)(@@) يا ويح للخادم في الدنيا وهو سيد القوم في الآخرة(@)(@@)(@@)(@@) | 8245 - (@)(@@) زرعة بن عمرو(@)(@@) يا أهل قباء ائتوني بحجارة من هذه الحرة فتجمعت عنده فخط بها قبلتهم ثم أخذ حجرا فوضعه ثم قال يا(@)(@@) PageV00P000(@)(@@) أبا بكر خذ حجرا فضعه إلى جنب حجري ففعل ثم قال يا عمر خذ حجرا فضعه إلى جنب حجر أبي بكر ففعل ثم قال يا عثمان خذ حجرا فضعه إلى جنب حجر عمر ففعل ثم التفت ألى الناس بآخرة فقال وضع رجل حجره حيث أحب على هذا الخط(@)(@@)(@@)(@@) | 8246 - (@)(@@) ابن عمر(@)(@@) يا طيبة يا سيدة البلدان(@)(@@)(@@)(@@) | 8247 - (@)(@@) أنس بن مالك(@)(@@) يا حبذا كل عالم ناطق ومستمع واع(@)(@@)(@@)(@@) | 8248 - (@)(@@) أبو أيوب(@)(@@) يا حبذا المتخللون من الطعام إنه ليس أشد على الملك من بقية تبقى من الفم من أثر الطعام(@)(@@)(@@)(@@) | 8249 - (@)(@@) ابن مسعود(@)(@@) يا أمة محمد حكيم من الحكماء كان أفهم منكم لما دعاه أصحابه إلى اللذات والمعاصي قال إني لأستحي من الله أن أعبده رجاء ثواب الجنة فأكون كأجير السوء(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8250 - (@)(@@) عائشة(@)(@@) يا أمة محمد والله ما من أحد أغير من الله عز وجل أن يزني عبده أو تزني أمته(@)(@@)(@@)(@@) | 8251 - (@)(@@) عائشة(@)(@@) يا أمة محمد والله لو تعلمون ما أعلم لضحكتم قليلا ولبكيتم كثيرا(@)(@@)(@@)(@@) | 8252 - (@)(@@) أسماء بنت أبي بكر(@)(@@) يا عباد الله إنه لا شيء أغير من الله عز وجل أن يزني عبده أو أمته(@)(@@)(@@)(@@) | 8253 - (@)(@@) أبو هريرة(@)(@@) يا أمة محمد والذي بعثني بالحق لا يقبل الله عز وجل صدقة من رجل وله قرابة محتاجون إلى صلته ويصرفها إلى غيرهم والذي نفسي بيده لا ينظر الله إليه يوم القيامة(@)(@@)(@@)(@@) | 8254 - (@)(@@) أبو الدرداء وأبو أسامة وأنس وواثلة(@)(@@) يا أمة 
ms560	 محمد لا(@)(@@) PageV00P000(@)(@@) تهيجوا على أنفسكم وهج النار الحديث(@)(@@)(@@)(@@) | 8255 - (@)(@@) ابن عمر(@)(@@) يا صاحب المقراة لا تخبره هذا تكلف لها ما أخذت في بطونها ولنا ما بقي شراب وطهور(@)(@@) فصل(@)(@@)(@@)(@@) | 8256 - (@)(@@) علي بن أبي طالب(@)(@@) يا أبا بكر إذا رأيت الناس يسارعون(@)(@@) PageV00P000(@)(@@) في الدنيا فعليك بالآخرة واذكر الله عند كل حجر ومدر يدعوك إذا ذكرته ولا تحقرن أحدا من المسلمين فإن صغير المسلمين عند الله كبير(@)(@@)(@@)(@@) | 8257 - (@)(@@) أبو سعيد(@)(@@) يا أبا بكر إياك ونار المؤمن لا تحرقك فإن يد المؤمن في يد الله عز وجل ينفثه وإن عثر كذى وكذى عثرة(@)(@@)(@@)(@@) | 8258 - (@)(@@) أبو بكر الصديق(@)(@@) يا أبا بكر اتق الله وإن وليت أحدا من المسلمين فليكن عندك أقصى المسلمين وأدناهم في الحق سواء ودع أهل الفضل حتى يكون الله هو يوفيهم حقهم يوم القيامة(@)(@@)(@@)(@@) | 8259 - (@)(@@) عبد الله بن عمرو(@)(@@) يا أبا بكر لو أراد الله عز وجل أن لا يعصى ما خلق إبليس(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8260 - (@)(@@) أنس بن مالك(@)(@@) يا أبا بكر إنما يعرف الفضل أهل الفضل(@)(@@)(@@)(@@) | 8261 - (@)(@@) أنس(@)(@@) يا أبا بكر ماظنك باثنين الله ثالثهما(@)(@@)(@@)(@@) | 8262 - (@)(@@) أنس(@)(@@) يا أبا بكر أرأيت ما ترى في الدنيا مما تكره فبمثاقيل الذر من الشر ويدخر الله لك مثاقيل الخير حتى توافيه يوم القيامة(@)(@@)(@@)(@@) | 8263 - (@)(@@) حذيفة(@)(@@) يا أبا بكر أرأيت لو أنك وجدت رجلا مع أم رومان كيف كنت صانعا قال كنت والله فاعلا شرا قال فأنت يا عمر قال(@)(@@) PageV00P000(@)(@@) كنت والله قاتله فأنت يا سهيل قال كنت أقول الله لا تعد لعن البعدى فهي خبيثة ولعن الله أول الثلاثة أخبر بهذا قال ما زلت يا ابن البيضاء {والذين يرمون أزواجهم}(@)(@@)(@@)(@@) | 8264 - (@)(@@) أبو بكر(@)(@@) يا أبا بكر بلال أخي وأنا أخوه وبلال أخوك ومولاك ومولى القوم من أنفسهم(@)(@@)(@@)(@@) | 8265 - (@)(@@) أبو بكر(@)(@@) يا أبا بكر كفي وكف علي من العدل سواء(@)(@@)(@@)(@@) | 8266 - (@)(@@) سنان غير منسوب(@)(@@) يا أبا بكر تبقا وتوقا(@)(@@)(@@)(@@) | 8267 - (@)(@@) أبو هريرة(@)(@@) يا أبا بكر إذا دخلتم المساجد فارتعوا فيها فإن رياض الجنة المساجد فأكثروا فيها 