ms1141	 ابن أبي حسين وغيره، روى عنه يحيى بن أبي كثير.(@)(@@)(@@)(@@) ||| AUTO العلاء بن رئاب(@)(@@) يروي عن الحسن، روى عنه سعيد بن أبي أيوب.(@)(@@)(@@)(@@) ||| AUTO العلاء بن هلال الباهلي(@)(@@) يروي المقاطيع عن صلة بن زفر، روى عنه السرى بن يحيى وحماد بن سلمة.(@)(@@)(@@)(@@) ||| AUTO العلاء بن بدر العنزي(@)(@@) يروي عن إبراهيم النخعي أن الأيام تزيد على ثلاثمائة وأربعة وخمسين يوما في كل أربع سنين يوما تربو به الأهلة وتعظم، روى عنه الشيباني. حدثنا عمر بن محمد، قال: ثنا الحسن بن علي العجلي، قال: ثنا أبو أسامة، قال: ثنا مفضل بن مهلهل، عن الشيباني، عن العلاء بن بدر في قصة طويلة.(@)(@@)(@@)(@@) ||| AUTO العلاء بن هارون(@)(@@) يروي عن الشعبي، روى عنه ضمرة بن ربيعة.(@)(@@)(@@)(@@) ||| AUTO العلاء بن قيس الكاهلي(@)(@@) من أهل الكوفة، يروي عن الشعبي، روى عنه وكيع بن الجراح.(@)PageV01P002(@)(@@) [ج 4: ص 166](@)(@@)(@@)(@@) ||| AUTO العلاء بن عبد الله بن رافع(@)(@@) يروي عن ميمون بن مهران، روى عنه جعفر بن برقان.(@)(@@)(@@)(@@) ||| AUTO العلاء بن خالد القرشي(@)(@@) يروي عن عطاء بن أبي رباح، قال:(@)(@@) (396) -[4: 166] رأيت أبا هريرة وهو " يطوف بهذا البيت وهو ينادي: لا صدقة إلا عن فضل العيال ". حدثناه الثقفي، قال: ثنا قتيبة بن سعيد، قال: ثنا العلاء بن خالد القرشي، عن عطاء بن أبي رباح، أحسبه الذي روى عن أبي وائل(@)(@@)(@@)(@@) ||| AUTO العلاء بن صالح(@)(@@) يروي عن عدى بن ثابت، روى عنه عبد الله بن نمير.(@)(@@)(@@)(@@) ||| AUTO العلاء بن عقبة(@)(@@) يروي المراسيل، روى عنه معاوية بن صالح.(@)(@@)(@@)(@@) ||| AUTO العلاء بن بشير المزني(@)(@@) من أهل البصرة، يروي عن أبي الصديق الناجي، روى عنه معلى بن زياد.(@)(@@)(@@)(@@) ||| AUTO العلاء بن عمار بن حصين بن حلمة(@)(@@) والد أبي عمرو بن العلاء، يروي عن أبيه، روى عنه ابنه معاذ بن العلاء، وكان من أفرس أهل زمانه، عداده في أهل البصرة.(@)(@@)(@@)(@@) ||| AUTO العلاء بن خالد بن وردان أبو شيبة الحنفي(@)(@@) يروي عن عطاء، روى عنه الفضل بن موسى الشيباني.(@)PageV01P002(@)(@@) [ج 4: ص 167](@)(@@)(@@)(@@) ||| AUTO العلاء بن خالد(@)(@@) مولى آل صالح، يروي 
ms1142	 عن يزيد الرقاشي، روى عنه أبو كامل الجحدري عداده في أهل البصرة.(@)(@@)(@@)(@@) ||| AUTO عتبة بن مسلم(@)(@@) مولى بني تيم من أهل المدينة، يروي عن أبي سلمة بن عبد الرحمن ونافع بن جبير بن مطعم ونافع بن جبير بن مطعم، روى عنه محمد بن إسحاق، وأهل المدينة.(@)(@@)(@@)(@@) ||| AUTO أبو العميس اسمه عتبة بن عبد الله بن عتبة بن مسعود الهذلي المسعودي(@)(@@) أخو عبد الرحمن بن عبد الله المسعودي، يروي عن إياس بن سلمة بن الأكوع، روى عنه وكيع، وأهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO عتبة بن إبراهيم بن أبي خداش(@)(@@) من أهل الكوفة، يروي المراسيل، روى عنه سفيان بن عيينة.(@)(@@)(@@)(@@) ||| AUTO عتبة بن عمرو(@)(@@) المكتب من أهل الكوفة، يروي عن الشعبي وعكرمة، روى عنه أبو صيفى والكوفيون وليس هذا بعبيد بن عمرو المكتب.(@)(@@)(@@)(@@) ||| AUTO عتبة بن محمد بن الحارث بن نوفل القرشي(@)(@@) من أهل مكة، يروي عن كريب، روى عنه ابن جريج.(@)(@@)(@@)(@@) ||| AUTO عتبة بن عبيد الصدفي(@)(@@) من أهل مصر، يروي المراسيل والمقاطيع، روى عنه سعيد بن أبي أيوب.(@)(@@)(@@)(@@) ||| AUTO عتبة بن جبيرة بن محمود بن أبي جبيرة الأشهلي(@)(@@) يروي عن التابعين، روى عنه أهل المدينة، مات سنة أربع وخمسين ومائة.(@)(@@)(@@)(@@) ||| AUTO عتبة بن أبي عتبة(@)(@@) يروي عن نافع بن جبير بن مطعم، روى عنه سعيد بن أبي هلال.(@)PageV01P002(@)(@@) [ج 4: ص 168](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO عتبة(@)(@@) مولى بن عباس، يروي عن شريح، روى عنه مطرف بن طريف.(@)(@@)(@@)(@@) ||| AUTO عتبة الغلام هو عتبة بن أبان بن صمعة(@)(@@) من عباد أهل البصرة وزهادهم ممن جالس الحسن وأخذ هديه في العبادة ودله في التقشف، روى عنه البصريون الحكايات ما له حديث مسند صحيح، يرويه.(@)(@@)(@@)(@@) ||| AUTO عتبة بن أبي عتبة(@)(@@) يروي عن عكرمة، روى عنه مالك بن أبي حسن.(@)(@@) عتبة(@)(@@) مولى معاوية، يروي عن عبد الله بن معقل، روى عنه عبد الملك بن عمير.(@)(@@)(@@)(@@) ||| AUTO عتبة الراسبي(@)(@@) يروي عن عمرو بن دينار، روى عنه أبو هلال الراسبي.(@)(@@)(@@)(@@) ||| AUTO عتبة بن يقظان(@)(@@) يروي عن الحسن، ويحيى بن يعمر، روى عنه البصريون. 
ms1143	(@)(@@)(@@)(@@) ||| AUTO عتبة بن قيس(@)(@@) من أهل الكوفة، يروي عن علي بن الحسين، روى عنه مسعر، وابن عيينة.(@)(@@)(@@)(@@) ||| AUTO عتبة بن محارب الهجيمي(@)(@@) يروي المقاطيع، روى عنه يحيى بن أبي كثير.(@)(@@)(@@)(@@) ||| AUTO عتبة بن عمير(@)(@@) شيخ، يروي عن أبيه، روى عنه بكير بن عبد الله بن الأشج.(@)(@@)(@@)(@@) ||| AUTO عتبة بن أبي حكيم الهمداني(@)(@@) من أهل الشام، يروي عن PageV01P002 [ج 4: ص 169] طلحة بن نافع والشاميين، روى عنه ابن المبارك، وأهل بلده، يعتبر حديثه من غير رواية بقية بن الوليد عنه.(@)(@@)(@@)(@@) ||| AUTO عتبة بن حميد الضبي، كنيته أبو معاذ(@)(@@) من أهل البصرة، يروي عن عبيد الله بن أبي بكر بن أنس، روى عنه سفيان بن عيينة، وأبو معاوية الضرير وزهير بن معاوية.(@)(@@)(@@)(@@) ||| AUTO عمير بن عبد الله بن بشر الخثعمي(@)(@@) من أهل الكوفة، يروي عن أبي زرعة بن عمرو بن جرير، روى عنه الثوري، وأهل الكوفة، يعتبر حديثه من غير رواية عبد الجبار بن العباس الشبامي عنه، وشبام قبيلة باليمن.(@)(@@)(@@)(@@) ||| AUTO أبو جعفر الخطمي اسمه عمير بن يزيد بن عمير بن حبيب بن خماشة(@)(@@) من أهل المدينة، يروي عن أبيه، وسعيد بن المسيب، روى عنه شعبة، وحماد بن سلمة.(@)(@@)(@@)(@@) ||| AUTO عمير بن عرفجة أبو عرفجة الكوفي(@)(@@) يروي عن عطية العوفي، روى عنه نصر بن مزاحم.(@)(@@)(@@)(@@) ||| AUTO عمير بن أبي مدرك الخولاني(@)(@@) من أهل مصر، يروي عن سفيان بن وهب الخولاني عن عمرو بن العاص، روى عنه حرملة بن عمران.(@)(@@)(@@)(@@) ||| AUTO عمير بن هانئ(@)(@@) من أهل الشام، يروي عن جنادة بن أبي أمية، روى عنه الأوزاعي، وابن ثوبان.(@)(@@)(@@)(@@) ||| AUTO عمير اليحصبي(@)(@@) من أهل الشام، يروي عن شرحبيل بن شفعة والشاميين، روى عنه حريز بن عثمان الرحبي.(@)PageV01P002(@)(@@) [ج 4: ص 170](@)(@@)(@@)(@@) ||| AUTO عمير بن يزيد بن أبي الغريف الهمداني(@)(@@) من أهل الكوفة، يروي عن الشعبي، روى عنه علي بن صالح بن حي.(@)(@@)(@@)(@@) ||| AUTO عمير بن أبي عمير(@)(@@) يروي المقاطيع، روى عنه ليث بن أبي سليم.(@)(@@)(@@)(@@) ||| AUTO عمير بن يوسف(@)(@@) يروي عن أبي مسلم الخولاني، روى عنه شرحبيل 
ms1144	 بن مسلم الخولاني.(@)(@@)(@@)(@@) ||| AUTO عمير بن أبي يزيد الهجري(@)(@@) يروي عن مسلم بن يسار، وأبي العالية، روى عنه أبو بكر بن أبي شيبة.(@)(@@)(@@)(@@) ||| AUTO عمير بن الريان(@)(@@) قال: سمعت بن سيرين. يقول: العزلة عبادة، روى عنه علي بن بكار المصيصي.(@)(@@)(@@)(@@) ||| AUTO عباس بن عبد الله بن معبد بن عباس بن عبد المطلب الهاشمي(@)(@@) أخو إبراهيم بن عبد الله بن معبد من أهل المدينة، يروي عن أبيه وعكرمة، روى عنه ابن جريج، وابن عجلان ووهيب بن خالد.(@)(@@)(@@)(@@) ||| AUTO عباس بن ذريح الكلبي(@)(@@) من أهل الكوفة، يروي عن الشعبي، وشريح، روى عنه شريك وزكريا بن أبي زائدة، وأهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO عباس بن فروخ الجريري(@)(@@) من أهل البصرة، كنيته أبو محمد، يروي عن أبي عثمان النهدي، روى عنه الحمادان.(@)(@@)(@@)(@@) ||| AUTO عباس بن حلبس(@)(@@) يروي عن عكرمة، روى عنه الحجاج بن حسان.(@)PageV01P002(@)(@@) [ج 4: ص 171](@)(@@)(@@)(@@) ||| AUTO عباس بن أبي خداش(@)(@@) يروي المقاطيع، روى عنه ابن جريج وهو الذي، يروي عن الزهري، وفضل بن عبيد الله بن أبي رافع.(@)(@@)(@@)(@@) ||| AUTO عباس بن أبي مرحب(@)(@@) يروي عن عبد الله بن عبيد بن عمير والمدنيين، روى عنه عبد الله بن رجاء المكي.(@)(@@)(@@)(@@) ||| AUTO عباس بن الوليد الباهلي(@)(@@) يروي المراسيل والمقاطيع عن عمه، روى عنه حماد بن سلمة.(@)(@@)(@@)(@@) ||| AUTO عباس القيسي(@)(@@) يروي عن أبي مجلز، روى عنه كهمس بن الحسن.(@)(@@)(@@)(@@) ||| AUTO عباس بن عبد الرحمن(@)(@@) يروي عن عبد الرحمن بن يزيد، روى عنه أبو إسحاق.(@)(@@)(@@)(@@) ||| AUTO عباس بن سالم اللخمي(@)(@@) يروي عن أبي إدريس الخولاني، روى عنه محمد بن مهاجر الشامي وهو الذي، روى عنه أخوه عمرو بن مهاجر، عن أبي سلام الأسود، عن ثوبان، عن النبي صلى الله عليه وسلم " حوضي ما بين عدن إلى عمان البلقاء ".(@)(@@)(@@)(@@) ||| AUTO عباس بن الحسن الخضرمي(@)(@@) من أهل حران، يروي عن الزهري نسخة أكثرها مستقيمة، روى عنه محمد بن سلمة الحراني وأحسبه الذي، روى عنه ابن جريج عن الزهري.(@)(@@)(@@)(@@) ||| AUTO عباس بن عبد الله بن عثمان بن حميد(@)(@@) من بني أسد بن 
ms1145	 عبد العزى القرشي من أهل مكة، يروي عن عمرو بن دينار، روى عنه أبو عاصم النبيل.(@)(@@) (397) -[4: 171] حدثنا أحمد بن يحيى بن زهير بتستر، ثنا معمر بن سهل، قال: ثنا أبو عاصم، قال: ثنا العباس بن عبد الله القرشي، قال: حدثني عمرو بن دينار، عن أبي الشعثاء، عن ابن عباس، قال: " يكره من البدن: العوراء، والعرجاء، والجدعاء، والمصرمة أطباؤها كلها "(@)PageV01P002(@)(@@) [ج 4: ص 172](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO عطية الراسبي(@)(@@) من أهل البصرة، يروي عن الحسن، روى عنه أبان بن يزيد العطار.(@)(@@)(@@)(@@) ||| AUTO عطية بن بهرام(@)(@@) من أهل البصرة، يروي عن قتادة ومورق العجلي، روى عنه وكيع، وعبد الواحد بن واصل.(@)(@@)(@@)(@@) ||| AUTO أبو روق الهمداني اسمه عطية بن الحارث(@)(@@) من أهل الكوفة، يروي عن إبراهيم التيمي، روى عنه الثوري، وعبد الواحد بن زياد.(@)(@@)(@@)(@@) ||| AUTO عطية السلمي(@)(@@) يروي عن عبد الله بن مطرف، روى عنه حاتم بن أبي صغيرة.(@)(@@)(@@)(@@) ||| AUTO عطية بن عبد الرحمن الثقفي(@)(@@) وقد قيل: ابن أبي عبد الرحمن، كنيته أبو محمد، يروي عن القاسم بن محمد، روى عنه الثوري وشريك، وقد روى عطية هذا عن القاسم بن عبد الرحمن، قال: " أتى عمر برجل سرق ثوبا قيمته ثمانية دراهم فلم يقطعه " وهذا ليس يصح عن عمر لأنه منقطع، والقاسم بن عبد الرحمن لم يدرك عمر بن الخطاب.(@)(@@)(@@)(@@) ||| AUTO عطية بن جبير العنزي(@)(@@) يروي المراسيل، روى عنه سماك بن حرب.(@)(@@)(@@)(@@) ||| AUTO عطية بن سعد الداعي(@)(@@) يروي عن الحكم بن الحارث، روى عنه كهمس بن الحسن.(@)(@@)(@@)(@@) ||| AUTO عطية بن أبي أمية(@)(@@) يروي عن مورق العجلي، روى عنه مهدي بن ميمون.(@)(@@) عطية(@)(@@) مولى لبني عامر، يروي عن يزيد بن بشر عن ابن عمر، روى عنه سالم بن أبي الجعد.(@)(@@)(@@)(@@) ||| AUTO عطية السراج(@)(@@) يروي عن الشعبي، روى عنه أيوب السختياني.(@)PageV01P002(@)(@@) [ج 4: ص 173](@)(@@)(@@)(@@) ||| AUTO عطية أبو وهب السمسار(@)(@@) يروي عن الحسن، روى عنه هشيم ويزيد بن هارون.(@)(@@)(@@)(@@) ||| AUTO عطية بن يوسف الصفار(@)(@@) يروي عن الحسن، روى عنه أهل البصرة.(@)(@@)(@@)(@@) ||| AUTO عون بن محمد بن علي بن أبي طالب بن 
ms1146	 الحنفية(@)(@@) يروي عن أبيه عن جده، روى عنه عبد الملك بن أبي عياش.(@)(@@)(@@)(@@) ||| AUTO عون بن الخطاب بن عبد الله بن رافع(@)(@@) يروي عن أنس بن مالك، روى عنه ابن أبي ذئب.(@)(@@)(@@)(@@) ||| AUTO عون بن عبيد الله بن أبي رافع(@)(@@) يروي عن عبيد الله بن عبد الله بن عمر، روى عنه يحيى بن سعيد الأنصاري.(@)(@@)(@@)(@@) ||| AUTO عون بن عباس(@)(@@) يروي عن حفصة بنت عبد الرحمن، روى عنه عبد الرحمن بن هرمز الأعرج.(@)(@@)(@@)(@@) ||| AUTO عون بن أرطبان(@)(@@) مولى مزينة، يروي عن أبيه، عن عمر، روى عنه ابنه عبد الله بن عون.(@)(@@)(@@)(@@) ||| AUTO عون بن يزيد(@)(@@) يروي عن مكحول، أنه سمعه يقول: " لو كان المعروف دابة تمشي بين الناس لنظر الناس إلى أحسن دابة ". روى عنه جعفر بن صبيح من حديث عمرو بن عثمان الحمصي.(@)(@@)(@@)(@@) ||| AUTO عون بن موسى أبو روح الليثي(@)(@@) من أهل البصرة، يروي عن معاوية بن قرة، وعاصم الأحول، والبصريين، روى عنه وكيع والتبوذكي، وأهل العراق.(@)(@@) (398) -[4: 173] حدثنا محمد بن محمود بن عدى بنسا، قال: ثنا فياض بن زهير، قال: ثنا سليمان بن حرب، قال: ثنا عون بن موسى، قال: سمعت معاوية بن قرة، يقول: " عودوا نساءكم لا "(@)PageV01P002(@)(@@) [ج 4: ص 174](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO عون بن أبي شداد(@)(@@) يروي عن الحسن، روى عنه نوح بن قيس الطاحي.(@)(@@) عون(@)(@@) مولى أم حكيم بنت يحيى بن الحكم امرأة هشام بن عبد الملك، يروي عن الزهري، روى عنه عبد العزيز بن أبي سلمة الماجشون.(@)(@@)(@@)(@@) ||| AUTO عون بن يعقوب(@)(@@) يروي عن ابن سيرين، روى عنه مسعدة بن اليسع، يعتبر حديثه من غير رواية مسعدة عنه.(@)(@@)(@@)(@@) ||| AUTO عون بن الأشهب بن ملقام بن التلب بن ثعلبة العنبري التميمي(@)(@@) يروي عن ملقام بن التلب والتلب فيما يقال له صحبة، روى عنه البصريون.(@)(@@)(@@)(@@) ||| AUTO عون بن حبان(@)(@@) شيخ بصري، يروي عن وبكر بن عبد الله المزني، روى عنه أبو وهب عبد العزيز بن عبد الله القرشي يغرب.(@)(@@)(@@)(@@) ||| AUTO عون بن صالح البارقي(@)(@@) يروي عن عطية العوفي، روى عنه وكيع 
ms1147	 بن الجراح.(@)(@@)(@@)(@@) ||| AUTO عون بن كهمس بن الحسن أبو يحيى القيسي(@)(@@) يروي عن عطية بن سعد الدعاء، عن الحكم بن أيوب، وله صحبة، روى عنه إسحاق بن إدريس.(@)(@@)(@@)(@@) ||| AUTO عون بن نبيل الجريري(@)(@@) شيخ من أهل البصرة، يروي المقاطيع، روى عنه ابن المبارك.(@)(@@)(@@)(@@) ||| AUTO عون بن خباب الحرشي(@)(@@) يروي عن قتادة ومطر، روى عنه يونس بن محمد PageV01P002 [ج 4: ص 175] المؤدب ومسلم بن إبراهيم، وقد قيل: إن هذا هو أبو جناب القصاب.(@)(@@)(@@)(@@) ||| AUTO عياض بن عبد الرحمن الحجبي(@)(@@) يروي عن ابن أبي مليكة، روى عنه عبد الله بن جعفر المدني.(@)(@@)(@@)(@@) ||| AUTO عياض بن عبد الله(@)(@@) يروي عن أبيه، عن أبي سعيد الخدري، روى عنه سلمة بن كهيل وليس هذا بابن أبي سرح.(@)(@@)(@@)(@@) ||| AUTO عياض بن عبد الله القرشي(@)(@@) يروي عن سعيد المقبري، روى عنه ابن وهب وهو مدني انتقل إلى مصر.(@)(@@)(@@)(@@) ||| AUTO عياض بن وهب(@)(@@) يروي عن عبد الله بن أبي حبيبة، روى عنه سعيد بن حسان.(@)(@@)(@@)(@@) ||| AUTO عياض بن جريبة الكلبي(@)(@@) وقد قيل: ابن خزيمة، يروي عن المدنيين، وعمر بن عبد العزيز عداده في أهل مصر، روى عنه الليث، وعمرو بن الحارث.(@)(@@)(@@)(@@) ||| AUTO عياض بن عمرو بن عبد القاري(@)(@@) يروي عن أبيه، روى عنه ابنه عبيد الله بن عياض.(@)(@@)(@@)(@@) ||| AUTO عياض بن مرة(@)(@@) يروي عن أبي الفيض، روى عنه زيد بن أبي أنيسة.(@)(@@)(@@)(@@) ||| AUTO عياض بن يزيد الكلبي(@)(@@) يروي عن عبد الرحمن بن نباتة عن ابن عمر، روى عنه يحيى بن صالح الوحاظي.(@)(@@)(@@)(@@) ||| AUTO عمار بن عبد الله بن يسار الجهني(@)(@@) من أهل الكوفة، يروي عن الشعبي، وابن أبي ليلى، روى عنه سفيان بن عيينة ومروان بن معاوية الفزاري.(@)PageV01P002(@)(@@) [ج 4: ص 176](@)(@@)(@@)(@@) ||| AUTO عمار بن سعد التجيبي(@)(@@) يروي عن أبي سلمة بن عبد الرحمن، روى عنه بكير بن عبد الله بن الأشج.(@)(@@)(@@)(@@) ||| AUTO عمار بن سعد السلهمي(@)(@@) وسلهم من اليمن، يروي عن أبي فراس عداده في أهل مصر، روي عنه بن الشريح. عمار القيسي، وقد قيل: العبسي، يروي عن عبد الله 
ms1148	 بن يسار عن حذيفة، روى عنه شعبة بن الحجاج.(@)(@@)(@@)(@@) ||| AUTO عمار بن يزيد(@)(@@) يروي المقاطيع والمراسيل، روى عنه خالد بن يزيد المصري.(@)(@@)(@@)(@@) ||| AUTO عمار بن أبي فروة أبو عمران(@)(@@) مولى عثمان بن عفان من أهل المدينة، يروي عن الزهري، روى عنه يزيد بن أبي حبيب.(@)(@@)(@@)(@@) ||| AUTO عمار الحضرمي(@)(@@) يروي عن زاذان، روى عنه إسماعيل بن سالم.(@)(@@)(@@)(@@) ||| AUTO عمار بن عبد الرحمن البارقي(@)(@@) كوفي، يروي عن أبي عبد الرحمن السلمي، روى عنه ابنه عبد الله بن عمار.(@)(@@)(@@)(@@) ||| AUTO عمار بن رزيق(@)(@@) مولى بني عامر، يروي المراسيل. عداده في أهل البصرة، روى عنه القاسم بن الفضل الحداني.(@)(@@)(@@)(@@) ||| AUTO عمار بن رزيق التميمي(@)(@@) من أهل الكوفة، كنيته أبو الأحوص، PageV01P002 [ج 4: ص 177] يروي عن أبي إسحاق، روى عنه يحيى بن آدم وزيد بن الحباب.(@)(@@)(@@)(@@) ||| AUTO عمار بن حكيم(@)(@@) من بني الديل، يروي عن ابن خاله عن أبي هريرة، روى عنه عكرمة بن عمار.(@)(@@)(@@)(@@) ||| AUTO عمار بن عليب المحاربي(@)(@@) يروي عن أمه عن أم سلمة، روى عنه أزهر بن سعد السمان.(@)(@@)(@@)(@@) ||| AUTO عمار بن عمارة أبو هاشم الزعفراني(@)(@@) من أهل البصرة، يروي عن الحسن، روى عنه روح بن عبادة وقرة بن حبيب.(@)(@@)(@@)(@@) ||| AUTO عروة بن عبد الله بن بشير الجعفي، كنيته أبو سهل(@)(@@) من أهل الكوفة، يروي عن ابن سيرين ومعاوية بن قرة، روى عنه الثوري، وزهير بن معاوية، وقد قيل: ابن قشير بالقاف.(@)(@@)(@@)(@@) ||| AUTO أبو فروة الهمداني اسمه عروة بن الحارث(@)(@@) من أهل الكوفة، يروي عن الشعبي، وأبي الضحى، روى عنه الثوري، وابن عيينة.(@)(@@)(@@)(@@) ||| AUTO عروة بن قبيصة(@)(@@) يروي عن إياس بن دغفل، روى عنه سعيد بن إياس الجريري.(@)(@@)(@@)(@@) ||| AUTO عروة بن محمد بن عطية بن عروة(@)(@@) من بني سعد بن بكر، يروي عن أبيه، عن جده، روى عنه إبراهيم بن خالد الصنعاني يخطئ، وكان من خيار الناس، ولى اليمن عشرين سنة ثم خرج حين خرج منها ومعه سيف ومصحف فقط.(@)PageV01P002(@)(@@) [ج 4: ص 178](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO عروة بن عبد الله بن كعب بن مالك السلمي 
ms1149	 الأنصاري(@)(@@) من أهل المدينة، يروي عن الحجازيين، روى عنه أهل بلده.(@)(@@)(@@)(@@) ||| AUTO عروة بن فائد(@)(@@) يروي عن ابن أبي ليلى، وأبي عبد الله الجدلي، وسعيد بن جبير، روى عنه إبراهيم بن ميمون.(@)(@@)(@@)(@@) ||| AUTO عروة بن رويم اللخمي(@)(@@) يروي عن هشام بن عروة، روى عنه أهل الشام، مات سنة خمس وثلاثين ومائة.(@)(@@)(@@)(@@) ||| AUTO عروة بن سعيد(@)(@@) يروي عن عدى بن أرطأة، روى عنه كهمس بن الحسن.(@)(@@)(@@)(@@) ||| AUTO عروة بن أبي قيس(@)(@@) مولى عمرو بن العاص عداده في أهل مصر، يروي عن أبيه، روى عنه يزيد بن أبي حبيب.(@)(@@)(@@)(@@) ||| AUTO عروة بن زهير العجلي(@)(@@) يروي عن ثابت عن أنس، روى عنه عبد الحميد بن جعفر.(@)(@@)(@@)(@@) ||| AUTO عروة أبو عبد الله البزاز(@)(@@) يروي المقاطيع، روى عنه يزيد بن هارون.(@)(@@) عروة بن عبد الله(@)(@@) يروي عن عنبسة بن أبي سفيان، روى عنه عنبسة بن سعيد الأسدي.(@)(@@)(@@)(@@) ||| AUTO عنبسة بن عبد الواحد بن أمية بن عبد الله بن سعيد بن العاص القرشي الأموي، كنيته أبو خالد(@)(@@) عداده في أهل الكوفة، يروي عن عبد الملك بن عمير وبيان، روى عنه أهل الكوفة وليس هذا بعنبسة بن عبد الرحمن ذلك ضعيف وعنبسة هذا كان على القضاء بالري.(@)PageV01P002(@)(@@) [ج 4: ص 179](@)(@@)(@@)(@@) ||| AUTO عنبسة بن سعيد بن كثير(@)(@@) مولى أبي بكر الصديق رضى الله تعالى عنه، يروي عن جده عن أبي هريرة، روى عنه أبو الوليد الطيالسي، وكان كثير رضيعا لعائشة.(@)(@@)(@@)(@@) ||| AUTO عنبسة بن سعيد بن ضريس الأسدي، كنيته أبو بكر(@)(@@) يروي عن أبي إسحاق، وعيسى بن جارية، روى عنه ابن المبارك، وحكام بن سلمة وكان ممن يخطئ.(@)(@@)(@@)(@@) ||| AUTO عنبسة بن سعيد بن غنيم(@)(@@) يروي عن عطاء، روى عنه إسماعيل بن عياش.(@)(@@)(@@)(@@) ||| AUTO عنبسة بن هبيرة بن النعمان الطائي(@)(@@) من أهل حران، كنيته أبو مروان، يروي عن عكرمة، روى عنه عثمان بن عبد الرحمن يعتبر حديثه من غير رواية عثمان الطائفي عنه.(@)(@@)(@@)(@@) ||| AUTO عنبسة بن أبي رائطة الغنوي الأعور(@)(@@) يروي عن الحسن، روى عنه عبد الوهاب الثقفي، وأهل البصرة، وهو 
ms1150	 أخو عبيدة بن أبي رائطة.(@)(@@)(@@)(@@) ||| AUTO عنبسة بن سعيد بن أبان القرشي الأموي(@)(@@) من أهل الكوفة، كنيته أبو خالد أخو عبيد ويحيى ومحمد بن سعيد بن أبان، يروي المقاطيع، روى عنه ابن أخيه سعيد بن يحيى الأموي.(@)(@@)(@@)(@@) ||| AUTO عنبسة بن الأزهر الشيباني قاضي جرجان، كنيته أبو يحيى(@)(@@) يروي عن محارب بن دثار، وسماك بن حرب، روى عنه السرى بن يحيى، وأهل بلده كان يخطئ.(@)PageV01P002(@)(@@) [ج 4: ص 180](@)(@@)(@@)(@@) ||| AUTO علقمة بن مرثد الحضرمي(@)(@@) من أهل الكوفة، يروي عن عبد الرحمن ويعلى بن عطاء، روى عنه الثوري وشعبة ومسعر.(@)(@@)(@@)(@@) ||| AUTO علقمة بن نضلة بن عبد الرحمن بن علقمة الكناني(@)(@@) يروي عن الحجازيين، روى عنه عثمان بن أبي سليمان المكي.(@)(@@)(@@)(@@) ||| AUTO علقمة بن أبي علقمة(@)(@@) من أهل المدينة، يروي عن أمه عن عائشة والأعرج عن ابن بحينة وكان نحويا يتعاطى الأدب، روى عنه مالك بن أنس، وقد روى عن أنس بن مالك أحرفا، فلست أدري أدلسها عنه أم سمعها منه، مات في آخر ولاية أبي جعفر.(@)(@@)(@@)(@@) ||| AUTO علقمة بن هلال من تيم الله(@)(@@) يروي عن جده المراسيل، روى عنه الوليد بن مسلم عن جده عنه.(@)(@@)(@@)(@@) ||| AUTO عدى بن حنظلة بن نعيم أبو طلق الزهري الأعمى(@)(@@) من أهل الكوفة، يروي عن وجدته، روى عنه الثوري، وعبد الواحد بن زياد.(@)(@@)(@@)(@@) ||| AUTO عدى بن عبد الرحمن الطائي(@)(@@) والد الهيثم بن عدى من أهل الكوفة، يروي إبراهيم التيمي عن داود بن أبي هند، وابن أبي ليلى، روى عنه الزبيدي، وعبد الوارث بن سعيد، ووكيع بن الجراح، روى الزبيدي عنه عن داود بن أبي هند نسخة مستقيمة.(@)(@@)(@@)(@@) ||| AUTO عدى بن أبي عمارة الذارع الجرمي(@)(@@) من أهل البصرة، يروي عن قتادة وزياد النميري، روى عنه القاسم بن عيسى الطائي والبصريون.(@)(@@)(@@)(@@) ||| AUTO عسل بن سفيان(@)(@@) يروي عن عطاء، روى عنه حماد بن سلمة يخطئ PageV01P002 [ج 4: ص 181] ويخالف على قلة روايته.(@)(@@)(@@)(@@) ||| AUTO عياش بن عبد الله بن أبي ثور الحجازي(@)(@@) يروي عن الحجازيين، يروي عن الحجازيين، روى عنه محمد بن إسحاق.(@)(@@)(@@)(@@) ||| AUTO 
ms1151	 عياش بن عبد الله الجريري(@)(@@) يروي عن أبي عثمان النهدي، روى عنه شعبة بن الحجاج.(@)(@@)(@@)(@@) ||| AUTO عياش بن عباس القتباني(@)(@@) من أهل مصر، كنيته أبو عبد الرحمن، يروي عن أبي عبد الرحمن الحبلي، وأبي سلمة بن عبد الرحمن، روى عنه الليث بن سعد، وابنه عبد الله بن عياش.(@)(@@)(@@)(@@) ||| AUTO عياش بن سنان العتكي الصيرفي(@)(@@) من أهل البصرة، يروي عن أبي نضرة، وأبي الحلال، روى عنه سلم بن قتيبة.(@)(@@)(@@)(@@) ||| AUTO عياش الكليبي(@)(@@) يروي عن عبد الله بن باباه، روى عنه شعبة بن الحجاج، وقد روى عن أنس ولم يسمع منه.(@)(@@)(@@)(@@) ||| AUTO عياش بن عمرو العامري(@)(@@) من أهل الكوفة، يروي عن جابر بن زيد وسعيد بن جبير، روى عنه الثوري.(@)(@@)(@@)(@@) ||| AUTO عياش بن عتبة(@)(@@) يروي عن عطاء بن أبي رباح، روى عنه إسماعيل بن عياش.(@)(@@)(@@)(@@) ||| AUTO عياش بن سعيد بن أبي المعلى الأنصاري(@)(@@) يروي المراسيل، روى عنه الحجازيون.(@)(@@)(@@)(@@) ||| AUTO عياش بن سليمان(@)(@@) يروي عن المدنيين وعمر بن عبد العزيز، روى عنه إسحاق بن حازم.(@)PageV01P002(@)(@@) [ج 4: ص 182](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO عكرمة بن إياس الكندي(@)(@@) يروي عن عطاء عداده في أهل الكوفة، روى عنه عبد الصمد بن عبد الوارث.(@)(@@)(@@)(@@) ||| AUTO عكرمة بن خالد بن سلمة المخزومي(@)(@@) يروي عن أبيه، عن ابن عمر، عن النبي صلى الله عليه وسلم قال: " لا تضربوا الرقيق فإنكم لا تدرون ما توافقون ". روى عنه إسحاق بن إسرائيل، وأهل البصرة.(@)(@@) عكرمة(@)(@@) شيخ، يروي عن الأعرج، لست أعرفه ولا أدري من أبوه، روى عنه إبراهيم بن سعد.(@)(@@)(@@)(@@) ||| AUTO عقيل: ابن شبيب(@)(@@) يروي عن أبي وهب الجشمي، روى عنه محمد بن مهاجر الدمشقي.(@)(@@)(@@)(@@) ||| AUTO عقيل: ابن معقل بن منبه اليماني(@)(@@) يروي عن عمه، وهب بن منبه، روى عنه هشام بن يوسف قاضي صنعاء.(@)(@@)(@@)(@@) ||| AUTO عقيل: ابن مدرك السلمي(@)(@@) من أهل الشام، يروي عن الصنابحي، روى عنه إسماعيل بن عياش.(@)(@@)(@@)(@@) ||| AUTO عقيل: ابن بأقل الحجري(@)(@@) يروي عن تبيع، روى عنه أسامة بن زيد.(@)(@@)(@@)(@@) ||| AUTO عتاب بن زياد بن ورقاء(@)(@@) يروي عن الشعبي، وعكرمة، روى 
ms1152	 عنه أبو أحمد الزبيري.(@)PageV01P002(@)(@@) [ج 4: ص 183](@)(@@)(@@)(@@) ||| AUTO عتاب بن عبد العزيز(@)(@@) يروي عن جدته صفية عن عائشة، روى عنه أبو قتيبة سلم بن قتيبة.(@)(@@)(@@)(@@) ||| AUTO عتاب بن سماك بن قربا النخعي(@)(@@) يروي عن إبراهيم النخعي، قال: صليت خلف إبراهيم النخعي، روى عنه الوسيم بن جميل عم قتيبة بن سعيد وكان، يروي عن الضحاك بن مزاحم الحكايات.(@)(@@)(@@)(@@) ||| AUTO عتاب بن عبد العزيز الحماني(@)(@@) يروي المقاطيع عن الرحال القريعي، روى عنه يزيد بن هارون.(@)(@@)(@@)(@@) ||| AUTO عتاب بن محمد بن شوذب البلخي(@)(@@) يروي عن إسماعيل بن أبي خالد وكعب بن عبد الرحمن مستقيم الحديث، روى عنه قتيبة بن سعيد وسعيد بن جناح البخاري الزاهد.(@)(@@)(@@)(@@) ||| AUTO عوف بن أبي جميلة الأعرابي العبدي(@)(@@) من أهل هجر، كنيته أبو سهل، كان يسكن النجيب، واسم أبي جميلة رزينة، يروي عن الحسن، وابن سيرين، روى عنه شعبة وسفيان، وأهل البصرة، وكان مولده سنة تسع وخمسين، ومات سنة ست وأربعين، وكان أكبر من قتادة بسنتين، ومات أشعث قبله بقليل في تلك السنة.(@)(@@)(@@)(@@) ||| AUTO عوف بن حريس الجعفري(@)(@@) يروي عن أبي بردة بن أبي موسى، روى عنه إبراهيم بن عيينة.(@)(@@)(@@)(@@) ||| AUTO عوف بن حصيرة الشامي(@)(@@) يروي عن حصين والشعبي، روى عنه الكوفيون شريك، وغيره.(@)PageV01P002(@)(@@) [ج 4: ص 184](@)(@@)(@@)(@@) ||| AUTO عوف بن مجالد الحضرمي(@)(@@) يروي عن خارجة بن زيد بن ثابت، روى عنه أبو الزناد عبد الله بن ذكوان.(@)(@@)(@@)(@@) ||| AUTO عرفجة بن عبد الواحد الأسدي(@)(@@) يروي عن أبيه، عن علي عداده في أهل الكوفة، روى عنه الشيباني وسهيل بن أبي صالح وهو الذي، يروي عن عاصم بن بهدلة.(@)(@@)(@@)(@@) ||| AUTO عجلان بن عبد الله العدوى(@)(@@) يروي عن مالك بن دينار عداده في أهل البصرة، روى عنه عبد الرحمن بن صالح.(@)(@@)(@@)(@@) ||| AUTO عائذ بن ربيعة النميري بصري(@)(@@) يروي عن قرة بن دعموص، روى عنه دلهم أبو دلهم.(@)(@@)(@@)(@@) ||| AUTO عائذ البلوى(@)(@@) يروي عن أهل المدينة روى سعيد بن أبي أيوب عن عبد العزيز بن عبد الملك عنه.(@)(@@)(@@)(@@) ||| AUTO عائذ بن حبيب بياع الهروي(@)(@@) مولى بني عبس 
ms1153	 كنيته أبو هشام، وقد قيل: أبو أحمد الأحول بصري، يروي عن حميد الطويل، روى عنه أهل البصرة.(@)(@@)(@@)(@@) ||| AUTO عوسجة بن الرماح(@)(@@) من أهل الكوفة، يروي عن عبد الله بن أبي الهذيل عن ابن مسعود، روى عنه عاصم بن بهدلة.(@)(@@)(@@)(@@) ||| AUTO عصمة بن بشير البرجمي(@)(@@) يروي عن الفزع، روى عنه سيف بن هارون.(@)(@@)(@@)(@@) ||| AUTO عصمة أبو حكيمة(@)(@@) يروي عن أبي عثمان النهدي، روى عنه قرة بن خالد وسلام بن مسكين.(@)(@@)(@@)(@@) ||| AUTO عبيس بن بيهس(@)(@@) يروي عن عطاء بن أبي رباح في كيفية الحج، روى عنه قتيبة بن سعيد.(@)PageV01P002(@)(@@) [ج 4: ص 185](@)(@@)(@@)(@@) ||| AUTO العوام بن حوشب بن يزيد بن رويم الشيباني، كنيته أبو عيسى(@)(@@) من أهل واسط، يروي عن أبي سفيان عن جابر، ويروي عن أهل العراق، روى عنه شعبة، ويزيد بن هارون، مات سنة ثمان وأربعين ومائة، وهو العوام بن حوشب بن يزيد بن رويم بن عبد الله بن سعد بن مرة بن ذهل بن شيبان بن ثعلبة بن عكابة بن صعب بن علي بن بكر.(@)(@@)(@@)(@@) ||| AUTO عوام بن مراجم القيسي(@)(@@) يروي عن خالد بن سيحان عداده في أهل البصرة، روى عنه شعبة بن الحجاج.(@)(@@)(@@)(@@) ||| AUTO عوام بن حمزة المازني(@)(@@) يروي عن أبي عثمان النهدي عداده في أهل البصرة، روى عنه يحيى بن سعيد القطان والنضر بن شميل.(@)(@@)(@@)(@@) ||| AUTO عوام بن أبي العوام(@)(@@) يروي عن الزهري، وهشام بن عروة، روى عنه موسى بن إسماعيل.(@)(@@)(@@)(@@) ||| AUTO عوام بن المقطع(@)(@@) رجل من كلب من أهل مصر، يروي عن أبيه، روى عنه البصريون.(@)(@@)(@@)(@@) ||| AUTO عزرة بن ثابت بن أبي زيد الأنصاري(@)(@@) واسم أبي زيد عمرو بن أخطب عداده في أهل البصرة، يروي عن ثمامة، وأبي الزبير وعلباء بن أحمر وكان متقنا، روى عنه وكيع، وأبو نعيم وهم إخوة ثلاثة عزرة وعلي ومحمد، أما عزرة فثقة، وعلي ثبت، ومحمد واه قد ذكرناه في الضعفاء.(@)(@@)(@@)(@@) ||| AUTO عزرة بن دينار الأعور(@)(@@) يروي عن المكيين، روى عنه سليمان التيمي،(@)PageV01P002(@)(@@)(@@)(@@) ||| AUTO [ج 4: ص 186] وداود بن أبي هند، وقرة بن خالد، 
ms1154	 وقد قيل: إنه عزرة بن سعد الأعور.(@)(@@)(@@)(@@) ||| AUTO عزرة بن دينار(@)(@@) يروي عن الزبير بن خريق عن أبي أمامة، روى عنه جعفر بن برقان ما أحلفه أن لا يكون بعزرة الأعور الذي، روى عنه البصريون لأن أحاديث عزرة الأعور مستقيمة، وما روى جعفر بن برقان عن عزرة هذا لا تشبه أحاديث عزرة الأعور كأنهما اثنان، والله أعلم.(@)(@@)(@@)(@@) ||| AUTO عزرة بن عبد الرحمن الخزاعي(@)(@@) من أهل الكوفة، يروي عن سعيد بن جبير، وسعيد بن عبد الرحمن بن أبزي، روى عنه قتادة بن دعامة.(@)(@@) عزرة(@)(@@) شيخ، يروي عن الربيع بن خثيم عداده في أهل الكوفة، روى عنه أبو طعمة، إن لم يكن بعزرة بن دينار الأعور فلا أدري من هو.(@)(@@)(@@)(@@) ||| AUTO عصام بن قدامة البجلي أبو محمد(@)(@@) من أهل الكوفة، يروي عن مالك بن نمير وعكرمة، روى عنه يحيى بن آدم.(@)(@@)(@@)(@@) ||| AUTO عصام بن راشد(@)(@@) يروي عن سلمة بن وردان، روى عنه مروان بن معاوية الفزاري.(@)(@@)(@@)(@@) ||| AUTO عصام بن خالد الحضرمي(@)(@@) من أهل حمص، كنيته أبو إسحاق، يروي عن حريز بن عثمان والشاميين، روى عنه أهل بلده.(@)(@@)(@@)(@@) ||| AUTO عصام بن يحيى(@)(@@) يروي عن أبي قلابة، روى عنه معاوية بن صالح.(@)(@@)(@@)(@@) ||| AUTO عيينة الكوفي(@)(@@) مولى بني هلال، يروي عن الحسن، روى عنه ابنه سفيان بن عيينة.(@)PageV01P002(@)(@@) [ج 4: ص 187](@)(@@)(@@)(@@) ||| AUTO عيينة بن عبد الرحمن بن جوشن الغطفاني(@)(@@) من أهل البصرة، يروي عن أبيه، روى عنه شعبة ووكيع، كنيته أبو مالك.(@)(@@)(@@)(@@) ||| AUTO عيينة اللخمي(@)(@@) يروي عن شداد أبي عمار عن واثلة بن الأسقع، روى عنه يزيد بن سنان.(@)(@@)(@@)(@@) ||| AUTO عيينة بن غصن(@)(@@) يروي عن رجل عن سليمان بن صرد، روى عنه جرير بن عبد الحميد.(@)(@@)(@@)(@@) ||| AUTO عفيف بن عمرو السهمي(@)(@@) من أهل المدينة، يروي عن رجل من بني أسد عن أبي أيوب، روى عنه مالك بن أنس.(@)(@@)(@@)(@@) ||| AUTO عطارد بن عبد الله(@)(@@) يروي عن معاوية بن ثابت، روى عنه أبو يعفور.(@)(@@)(@@)(@@) ||| AUTO العيزار بن جرول(@)(@@) يروي عن سويد بن غفلة، روى عنه علقمة بن مرثد. 
ms1155	(@)(@@) (399) -[4: 187] ثنا ابن قتيبة، قال: ثنا الحسين بن أبي السري، قال: ثنا الجماني، عن محمد بن أبان، عن علقمة بن مرثد، عن العيزار بن جرول، عن سويد بن غفلة، عن علي بن أبي طالب، عن عثمان بن عفان، قال: قال رسول الله صلى الله عليه وسلم: " نزل القرآن بلسان مضر "(@)(@@)(@@)(@@) ||| AUTO عريب المشرقي(@)(@@) يروي المقاطيع، روى عنه عبد الجبار بن العباس الشامي.(@)(@@)(@@)(@@) ||| AUTO عثيم بن نسطاس المدني(@)(@@) مولى لآل كثير بن الصلت الكندي، يروي عن سعيد المقبري، روى عنه سعيد بن مسلم بن بانك.(@)(@@)(@@)(@@) ||| AUTO عثيم بن كليب(@)(@@) يروي عن أبيه، عن جده روى بن جريج عن رجل عنه.(@)PageV01P002(@)(@@) [ج 4: ص 188](@)(@@)(@@)(@@) ||| AUTO عنترة أبو وكيع(@)(@@) يروي المراسيل، روى عنه أبو سنان، وابنه هارون بن عنترة.(@)(@@)(@@)(@@) ||| AUTO عنترة بن أبي العبس المازني(@)(@@) يروي عن حصين بن عرفطة عن أبي هريرة، روى عنه معلى بن أسد.(@)(@@)(@@)(@@) ||| AUTO عكاشة بن مصعب بن الزبير بن العوام القرشي الأسدي(@)(@@) يروي عن عروة بن الزبير، روى عنه مصعب بن ثابت.(@)(@@)(@@)(@@) ||| AUTO عكاشة بن الجراح بن المنذر(@)(@@) يروي.(@)(@@) (400) -[4: 188] عن الحسن، قال: " قال له رجل: إن لي جارا لا يأكل التمر، فقال له الحسن: لم؟ قال: لا يحبه، قال الحسن: من لا يحب التمر أحمق ". حدثناه ابن قحطبة، قال: ثنا الحسين بن سلمة بن أبي كبشة، قال: ثنا سلم بن قتيبة، قال: ثنا عكاشة(@)(@@)(@@)(@@) ||| AUTO عفاق بن عبد الله بن مرداس المحاربي(@)(@@) من أهل الكوفة، يروي عن عمرو بن ميمون، روى عنه مسعر بن كدام.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO عريان بن الهيثم بن الأسود النخعي(@)(@@) من أهل الكوفة، يروي عن أبيه، روى عنه عبد الملك بن عمير.(@)(@@) عريان(@)(@@) شيخ، يروي عن ابن سيرين، روى عنه سليمان التيمي.(@)(@@)(@@)(@@) ||| AUTO عصيم بن سالم(@)(@@) من أهل البصرة، يروي عن ثابت البناني، روى عنه نوح بن قيس.(@)(@@)(@@)(@@) ||| AUTO عميرة بن أبي ناجية(@)(@@) من أهل مصر، يروي عن يزيد بن أبي حبيب، روى عنه ابن وهب، مات سنة إحدى وخمسين ومائة.(@)PageV01P002(@)(@@) [ج 4: ص 189](@)(@@)(@@)(@@) ||| AUTO عقيل: ابن 
ms1156	 خالد الأيلي القرشي الأموي(@)(@@) مولى آل عثمان بن عفان، يروي عن الزهري، روى عنه الليث بن سعد، ويونس بن يزيد، مات سنة إحدى أو اثنتين وأربعين ومائة.(@)(@@)(@@)(@@) ||| AUTO العاصي بن عمرو الطفاوي(@)(@@) يروي عن عمته، روى عنه تمام بن بزيع يعتبر حديثه من غير رواية تمام عنه.(@)(@@)(@@)(@@) ||| AUTO علوان بن أبي مالك(@)(@@) يروي عن الشعبي، روى عنه سفيان الثوري.(@)(@@)(@@)(@@) ||| AUTO عرار بن عبد الله بن سعد اليمامي(@)(@@) يروي عن عميرة بن سعد، روى عنه حماد بن سلمة.(@)(@@)(@@)(@@) ||| AUTO عثام بن علي العامري الكلابي، كنيته أبو علي(@)(@@) يروي عن الأعمش والكوفيين، روى عنه يوسف بن عدي، وأهل العراق، مات سنة خمس وتسعين ومائة.(@)(@@)(@@)(@@) ||| AUTO عذافر البصري(@)(@@) يروي عن الحسن، روى عنه سعيد بن أبي عروبة.(@)(@@)(@@)(@@) ||| AUTO عقال بن شبة(@)(@@) من أهل حران، يروي عن الزهري، روى عنه عثمان بن عبد الرحمن الطرائفي ماله إلا حديث واحد في الجمع بين الصلاتين.(@)(@@)(@@)(@@) ||| AUTO عقاص بن خليفة(@)(@@) يروي عن أبي محمد النهدي عن ابن مسعود، روى عنه عبد الصمد بن عبد الوارث.(@)(@@)(@@)(@@) ||| AUTO عنطوانة أبو الحسن القيسي(@)(@@) يروي عن الحسن، روى عنه الربيع بن بدر.(@)(@@)(@@)(@@) ||| AUTO عرفطة(@)(@@) شيخ، يروي عن الحسن عن عبد الرحمن بن سمرة لا تسأل PageV01P002 [ج 4: ص 190] الإمارة، روى عنه الوليد بن عباد من حديث إسماعيل بن عياش عنه.(@)(@@)(@@)(@@) ||| AUTO عبثر بن القاسم الزبيدي أبو زبيد(@)(@@) من أهل الكوفة، يروي عن الأعمش، وابن أبي خالد، روى عنه قتيبة بن سعيد، وأهل العراق.(@)(@@)(@@)(@@) ||| AUTO عبدة بنت خالد بن صفوان(@)(@@) تروي عن أبيها، روى عنها بقية، وأهل الشام.(@)(@@)(@@)(@@) ||| AUTO عجيبة بنت عبد الحميد بن عقبة بن طلق بن علي الحنفي(@)(@@) من أهل اليمامة، تروي عن قيس بن طلق، روى عنها ملازم بن عمر.(@)(@@)(@@)(@@) ||| AUTO عائشة بنت الزبير بن هشام بن عروة(@)(@@) روى عنها معاوية بن عبد الرحمن بن عبد الله الزبيري. عبيدة بنت نابل، تروي عن عائشة بنت سعد، روى عنها الخصيب بن ناصح.(@)(@@) (401) -[4: 190] حدثنا محمد بن المنذر بن سعيد، قال: ثنا سليمان 
ms1157	 بن شعيب الكيساني بمصر، قال: ثنا الخصيب بن ناصح، قال: حدثتنا عبيدة بنت نابل، قالت: سمعت عائشة بنت سعد تحدث، عن أبيها، أن رسول الله صلى الله عليه وسلم قال: " اللهم سق إلى هذا الطعام رجلا تحبه ويحبك "، فدخل سعد(@)(@@)(@@)(@@) || AUTO باب الغين(@)(@@) قال أبو حاتم رضى الله تعالى عنه:(@)(@@) وممن روى عن التابعين ممن ابتدأ اسمه على الغين.(@)(@@)(@@)(@@) ||| AUTO غالب بن أبي غيلان القطان(@)(@@) واسم أبي غيلان خطاف، مولى عبد الله بن عامر بن كريز، ويقال: مولى بني تميم، وقد قيل: مولى بني غنم، ومنهم من زعم أنه مولى بني راسب، يروي عن الحسن وبكر بن عبد الله المزني عداده في أهل البصرة، روى عنه أهلها.(@)(@@)(@@)(@@) ||| AUTO غالب بن الهذيل أبو الهذيل الأزدي(@)(@@) من أهل الكوفة، يروي عن PageV01P002 [ج 4: ص 191] إبراهيم النخعي، روى عنه سفيان الثوري.(@)(@@)(@@)(@@) ||| AUTO غالب بن مهران التمار العبدي(@)(@@) من أهل البصرة، وقد قيل: إنه غالب بن ميمون، يروي عن مسروق بن أوس، روى عنه سعيد بن أبي عروبة.(@)(@@)(@@)(@@) ||| AUTO غالب بن حجرة بن التلب بن ثعلبة العنبري التميمي(@)(@@) يروي عن ملقام بن التلب، روى عنه موسى بن إسماعيل التبوذكي.(@)(@@)(@@)(@@) ||| AUTO غالب الوراق(@)(@@) يروي عن ابن سيرين، روى عنه مسعدة بن اليسع.(@)(@@)(@@)(@@) ||| AUTO غالب بن نجيح أبو بشر(@)(@@) يروي عن قيس بن مسلم، روى عنه جرير بن عبد الحميد الضبي.(@)(@@)(@@)(@@) ||| AUTO غالب بن صالح التيمي(@)(@@) يروي عن الحسن، روى عنه أزهر القيسي.(@)(@@)(@@)(@@) ||| AUTO غالب بن عبد الله الليثي(@)(@@) يروي عن يحيى بن يعمر، روى عنه عبد المؤمن بن خالد، قال: " سمعت يحيى بن يعمر، يقرأ {ربنا باعد بين أسفارنا}، وقال: لم يدع القوم على أنفسهم، ولكن أخبروا عما نزل بهم ". قال: " وسمعته يقرأ {قالوا نفقد صواع الملك}، وكان صيغ من ذهب أو فضة ". قال: " وسمعته يقرأ {إن لك في النهار سبحا طويلا}، يعنى: نوما طويلا ".(@)(@@)(@@)(@@) ||| AUTO غيلان بن جامع المحاربي(@)(@@) قاضي الكوفة، يروي عن أبي الزبير والحكم، PageV01P002 [ج 4: ص 192] روى عنه الثوري، وشعبة بن الحجاج، مات 
ms1158	 في ولاية يزيد بن عمر بن هبيرة.(@)(@@)(@@)(@@) ||| AUTO غيلان الحميري(@)(@@) يروي عن جبير بن نفير، روى عنه الأحوص بن حكيم.(@)(@@)(@@)(@@) ||| AUTO غيلان بن بشر(@)(@@) يروي عن يعلى بن الوليد عن أبي الدرداء، روى عنه الأعمش.(@)(@@)(@@)(@@) ||| AUTO غيلان بن عدي(@)(@@) يروي عن أبيه عن عمر، روى عنه ليث بن أبي سليم.(@)(@@)(@@)(@@) ||| AUTO غيلان بن ميسرة(@)(@@) يروي عن أبي المليح، روى عنه سعيد بن عامر.(@)(@@)(@@)(@@) ||| AUTO غيلان بن صهيب(@)(@@) يروي عن مكحول، روى عنه علي بن أبي سارة.(@)(@@)(@@)(@@) ||| AUTO غيلان بن عبد الله العامري(@)(@@) يروي عن أبي زرعة بن عمرو بن جرير حديثا منكرا، روى عنه عيسى بن عبيد، وقال: إن الله أوحى إلى أن دار هجرتك بالمدينة.(@)(@@)(@@)(@@) ||| AUTO غطيف بن أعين الشيباني الجزري(@)(@@) يروي عن مصعب بن سعد، روى عنه عبد السلام بن حرب.(@)(@@)(@@)(@@) ||| AUTO غضبان بن يزيد(@)(@@) يروي عن أبيه، عن ابن مسعود، روى عنه أبو العميس.(@)(@@)(@@)(@@) ||| AUTO غسان بن مضر(@)(@@) من أهل البصرة، يروي عن ثابت، وعبد العزيز بن صهيب، روى عنه عمار بن هارون المستملي والبصريون، مات سنة أربع وثمانين ومائة يعتبر حديثه من رواية الثقات عنه، كنيته أبو مضر وكان مكفوفا، وهو الذي يقال له: النميري والأزدي.(@)PageV01P002(@)(@@) [ج 4: ص 193](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO غسان بن برزين الطهوي(@)(@@) من أهل البصرة، كنيته أبو المقدام، يروي عن أبي المنهال سيار بن سلامة وثابت البناني، روى عنه الحجاج بن منهال، وأهل البصرة وكان ممن يخطئ.(@)(@@)(@@)(@@) ||| AUTO غسان بن سيار أبو مالك العوذي(@)(@@) من أهل البصرة، يروي عن قتادة وثمامة بن عبد الله، روى عنه المعلي بن أسد.(@)(@@) غسان(@)(@@) شيخ، يروي عن سعيد بن المسيب، روى عنه عمار أبو هاشم.(@)(@@)(@@)(@@) ||| AUTO غاضرة بن عروة الفقيمي(@)(@@) يروي عن أبيه عداده في أهل البصرة، روى عنه عاصم بن هلال البارقي.(@)(@@)(@@)(@@) ||| AUTO غزوان بن جرير(@)(@@) يروي عن أبيه، روى عنه عبد السلام بن شداد.(@)(@@)(@@)(@@) ||| AUTO غضين بن عبد العزيز(@)(@@) يروي عن الشعبي، روى عنه عبد الواحد بن زياد.(@)(@@)(@@)(@@) ||| AUTO غياث الحماني(@)(@@) من أهل الكوفة، سكن مصر، 
ms1159	 يروي عن سفيان بن وهب، روى عنه مبشر بن إسماعيل، وهو الذي يقال له: غياث الحمراوي، وحمراء موضع بمصر.(@)(@@)(@@)(@@) ||| AUTO غياث بن الحكم(@)(@@) يروي عن عبد الملك الطويل عن عائشة، روى عنه جرمي بن حفص.(@)(@@)(@@)(@@) ||| AUTO غوث بن سليمان بن زياد الحضرمي(@)(@@) من أهل مصر، يروي عن أبيه، عن عبد الله بن الحارث بن جزء، روى عنه أبو الوليد الطيالسي، وأهل مصر، مات سنة ثمان وستين ومائة.(@)PageV01P002(@)(@@) [ج 4: ص 194](@)(@@)(@@)(@@) ||| AUTO غوث بن جابر بن غيلان بن منبه بن كامل بن سيج بن سبحان كنيته أبو محمد(@)(@@) يروي عن وهب بن منبه، روى عنه أهل اليمن.(@)(@@)(@@)(@@) ||| AUTO غطريف أبو هارون اليماني(@)(@@) يروي عن جابر بن زيد عن ابن عباس، روى عنه الحكم بن أبان العدني.(@)(@@)(@@)(@@) || AUTO باب الفاء(@)(@@) قال أبو حاتم رضى الله تعالى عنه:(@)(@@)(@@)(@@) || AUTO ومن أتباع التابعين الذين رووا عن التابعين ممن ابتدأ اسمه على الفاء(@)(@@)(@@)(@@) ||| AUTO فضيل بن عمرو الفقيمي(@)(@@) أخو الحسن بن عمرو من أهل الكوفة، يروي عن إبراهيم النخعي، روى عنه الأعمش وأخوه الحسن بن عمرو، مات سنة عشر ومائة، يخطئ،(@)(@@) (402) -[4: 194] حدثنا عمر بن محمد الهمداني، قال: ثنا زيد بن أخزم، قال: ثنا سعيد بن عامر الضبعي، عن شعبة، عن الحسن بن عمرو، عن أخيه فضيل بن عمرو، عن إبراهيم: " أن علقمة كان يدخل مسجد قومه فيجدهم قد صلوا فيصلى هو ويسمع الإقامة فلا يذهب إليها "، قال شعبة: فذكرت ذلك للأعمش، وقال: كان أصحاب عبد الله يفعلونه(@)(@@)(@@)(@@) ||| AUTO فضيل بن أبي عبد الله(@)(@@) يروي عن القاسم بن محمد عداده في أهل المدينة، روى عنه بكير بن الأشج ومالك بن أنس.(@)(@@)(@@)(@@) ||| AUTO فضيل بن عياض بن مسعود رحمه الله، كنيته أبو علي(@)(@@) من بني تميم، يروي عن إسماعيل بن أبي خالد والشيباني، روى عنه ابن المبارك، وأهل العراق، PageV01P002 [ج 4: ص 195] وكان مولده بسمرقند، وترعرع بأبيورد، ونشأ بالكوفة وبها كتب الحديث، ثم انتقل إلى مكة وأقام بها مجاورا للبيت الحرام مع الجهد الشديد، والورع الدائم، والخوف الوافر والبكاء 
ms1160	 الكثير، والتخلي بالوحدة، ورفض الناس وما عليه أسباب الدنيا، إلى أن توفى بها سنة سبع وثمانين ومائة، وقبره مشهور يزار، قد زرته مرارا.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO فضيل بن فضالة القيسي(@)(@@) من أهل البصرة، يروي عن أبي رجاء العطاردي وعبيد الله بن أبي بكرة وعبيد الله بن أبي بكرة، روى عنه شعبة بن الحجاج.(@)(@@)(@@)(@@) ||| AUTO فضيل بن طلحة البصري أبو محمد(@)(@@) يروي عن الحسن، روى عنه شعبة، ومسعر.(@)(@@)(@@)(@@) ||| AUTO فضيل بن يسار(@)(@@) يروي عن أبي جعفر محمد بن علي، روى عنه جرير بن حازم.(@)(@@) فضيل(@)(@@) شيخ، يروي عن سالم بن عبد الله إن لم يكن بن أبي عبد الله صاحب القاسم بن محمد فلا أدري من هو.(@)(@@)(@@)(@@) ||| AUTO فضيل بن مرزوق الرؤاسي، كنيته أبو عبد الرحمن(@)(@@) من أهل الكوفة، يروي عن أبي إسحاق وعطية، روى عنه عبد الله بن المبارك، كان ممن يخطئ.(@)(@@)(@@)(@@) ||| AUTO فضيل بن غزوان بن جرير الكوفي(@)(@@) مولى بني ضبة، كنيته أبو الفضل، يروي عن نافع وأبي إسحاق، روى عنه ابنه محمد بن فضيل والكوفيون.(@)PageV01P002(@)(@@) [ج 4: ص 196](@)(@@)(@@)(@@) ||| AUTO فضيل بن جرير(@)(@@) كان ينزل في بني عامر عند حجام عنترة، يروي عن مسلم مولى حذيفة عن حذيفة، روى عنه أبو أحمد الزبيري.(@)(@@)(@@)(@@) ||| AUTO فضيل بن سليمان النميري، كنيته أبو سليمان(@)(@@) من أهل البصرة، يروي عن أبي حازم وموسى بن عقبة، روى عنه أهل البصرة، مات سنة ست وثمانين ومائة.(@)(@@)(@@)(@@) ||| AUTO الفضل بن عبد الله بن معقل بن سنان الأشجعي(@)(@@) يروي عن عبد الله بن نيار، روى عنه أبان بن صالح ومحمد بن إسحاق، ومن قال الفضل بن معقل فقد نسبه إلى جده.(@)(@@)(@@)(@@) ||| AUTO الفضل بن عطية المروزي(@)(@@) مولى عبس والد محمد بن الفضل بن عطية الخراساني، يروي عن عطاء، وسالم بن عبد الله، روى عنه الثوري وهشيم، وابنه محمد، يعتبر حديثه من غير رواية ابنه عنه لأن ابنه في الحديث ليس بشيء.(@)(@@)(@@)(@@) ||| AUTO الفضل بن معدان الحداني بصري(@)(@@) يروي المراسيل، روى عنه ابنه القاسم بن الفضل.(@)(@@)(@@)(@@) ||| AUTO الفضل بن قتادة 