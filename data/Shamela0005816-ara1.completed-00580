ms561	(@)(@@)(@@)(@@) $ 2666 - راشد بن حبيش الرقى يروي عن عبادة بن الصامت روى عنه أبو العوام بن حوشب سادن بيت المقدس وزرعة بن عبد الرحمن بن جرهد PageV04P233(@)(@@)(@@)(@@) $ 2667 - راشد بن الحارث يروي عن أبي ذر روى عنه عمار الدهني(@)(@@)(@@)(@@) $ 2668 - راشد بن معبد يروي عن أنس بن مالك روى عنه الحسن بن حبيب وأبو نعيم(@)(@@)(@@)(@@) $ 2669 - راشد مولى عثمان يروي عن عثمان بن عفان روى عنه إبراهيم بن طهمان(@)(@@)(@@)(@@) $ 2670 - راشد بن نجيح الحماني كنيته أبو محمد عداده في أهل الكوفة يروي عن أنس روى عنه بن المبارك وعبد الوهاب ربما أخطأ(@)(@@)(@@)(@@) $ 2671 - راشد مولى قريش وقد قيل مولى الأنصار يروي عن عمر روى عنه معمر بن أبان(@)(@@)(@@)(@@) $ 2672 - راشد شيخ يروي عن السائب بن خباب روى عنه ابنه عبد الملك بن راشد(@)(@@)(@@)(@@) $ 2673 - راشد مؤذن بن الزبير يروي عن بن الزبير روى عنه عوف الأعرابي(@)(@@)(@@)(@@) $ 2674 - رافع بن أبي رافع الطائي يروي عن أبي بكر الصديق PageV04P234 روى عنه طارق بن شهاب واسم أبي رافع عميرة مات في خلافة أبي بكر(@)(@@)(@@)(@@) $ 2675 - رافع بن حديج يروي عن حذيفة روى عنه الربيع بن سحيم وقد قيل إنه رافع بن حديد السوائي من أهل الكوفة(@)(@@)(@@)(@@) $ 2676 - رافع الأشجعي أبو الجعد الغطفاني مولى لهم وكان قارئا للقرآن يروي عن على وابن مسعود روى عنه ابنه سالم بن أبي الجعد(@)(@@)(@@)(@@) $ 2677 - رافع بن عاقب يروي عن بن عمر روى عنه أبو على البهدلي(@)(@@)(@@)(@@) $ 2678 - رافع بن سالم الفزاري يروي عن عمر روى عنه محمد بن إبراهيم بن الحارث التيمي(@)(@@)(@@)(@@) $ 2679 - رافع بن حصن أبو المغيرة يروي عن بن عمر روى عنه عبد الله بن عكرمة PageV04P235(@)(@@)(@@)(@@) $ 2680 - رافع أبو الحسن يروي عن ثوبان روى عنه أبو الزاهرية وعبد الرحمن بن جبير بن نفير(@)(@@)(@@)(@@) $ 2681 - رافع بن جحش المحاربي يروي عن عثمان روى عنه أبو مالك بن ثعلبة القرظي(@)(@@)(@@)(@@) $ 2682 - رافع بن إسحاق مولى أبي الشفاء من أهل المدينة يروي عن أبي أيوب الأنصاري والخدري روى عنه إسحاق 
ms562	 بن عبد الله بن أبي طلحة(@)(@@)(@@)(@@) $ 2683 - رافع أبو عامر يروي عن على رضى الله عنه روى عنه أبو حصين(@)(@@)(@@)(@@) $ 2684 - رافع بن بشير السلمي يروي عن أبيه روى عبد الحميد بن جعفر عن أبي جعفر عنه ويشبه أن يكون هذا هو بشر بن معاوية بن ثور السلمي فان له صحبة(@)(@@)(@@)(@@) $ 2685 - رافع بن سلمة البجلي يروي عن على روى عنه بشير بن ربيعة(@)(@@)(@@)(@@) $ 2686 - رافع بن حنين ويقال حصين كنيته أبو المغيرة يروي عن بن عمر روى عنه عبد الله بن عكرمة والصحيح حنين PageV04P236(@)(@@)(@@)(@@) $ 2687 - روح بن زنباع الجذامي من أهل فلسطين وكان عابدا غازيا من سادات أهل الشام يروي عن تميم الداري روى عنه أهل الشام(@)(@@)(@@)(@@) $ 2688 - رجاء الغنوي يروي المراسيل أصيبت يده يوم الجمل روت عنه ساكنة بنت الجعد الغنوية(@)(@@)(@@)(@@) $ 2689 - رجاء بن ربيعة الزبيدي يروي عن أبي سعيد الخدري والبراء بن عازب عداده في أهل الكوفة روى عنه ابنه إسماعيل بن رجاء(@)(@@)(@@)(@@) $ 2690 - رجاء بن أبي رجاء الباهلي يروي عن محجن وله صحبة روى عنه عبد الله بن شقيق العقيلي(@)(@@)(@@)(@@) $ 2691 - رجاء بن حيوة الكندي الشامي كنيته أبو المقدام وقد قيل أبو بكر سكن فلسطين وربما سكن الأردن وكان من عباد أهل الشام وزهادهم وفقهائهم يروي عن أبي أمامة روى عنه بن عون وأهل الشام ثنا محمد بن عثمان العقبي قال ثنا أبو زرعة قال ثنا أبو مسهر قال سمعت كامل بن سلمة بن رجاء بن حيوة قال قال هشام بن عبد الملك من سيد أهل فلسطين قالوا رجاء بن حيوة قال فمن سيد أهل الأردن قالوا عبادة بن نسي قال فمن سيد أهل دمشق قالوا يحيى بن يحيى الغساني قال فمن أهل حمص قالوا عمرو بن قيس قالوا فمن أهل الجزيرة قالوا عدى بن عدى الكندي PageV04P237 قال قال كندة ومات رجاء بن حيوة سنة ثنتي عشرة ومائة وكان رجاء بن حيوة يحمر رأسه ويترك لحيته بيضاء(@)(@@)(@@)(@@) $ 2692 - رجاء بن الحارث يروي عن على روى عنه 
ms563	 حزن بن بشير(@)(@@)(@@)(@@) $ 2693 - رياح بن عبيدة يروي عن أبي سعيد الخدري روى عنه ابنه إسماعيل بن رياح وأهل العراق وكان رياح من العباد من جلساء عمر بن عبد العزيز(@)(@@)(@@)(@@) $ 2694 - رياح يروي عن عثمان بن عفان روى عنه الحسن بن سعد لا أدرى من هو ولا بن من هو(@)(@@)(@@)(@@) $ 2695 - رياح بن رياح يروي عن أبي هريرة روى عنه الحسن البصري(@)(@@)(@@)(@@) $ 2696 - رياح بن الحارث الكوفي يروي عن على وسعيد بن زيد روى عنه صدقة بن المثنى(@)(@@)(@@)(@@) $ 2697 - رزيق مولى لعمر بن الخطاب يروي عن بن عمر روى عنه أبو زيد PageV04P238(@)(@@)(@@)(@@) $ 2698 - رزيق أبو عبد الله الألهاني الشامي يروي عن أبي أمامة روى عنه أرطاة بن المنذر السكوني(@)(@@)(@@)(@@) $ 2699 - رزيق بن حيان مولى بنى فزارة كنيته أبو المقدام يروي عن مسلم بن قرظة روى عنه بن جابر(@)(@@)(@@)(@@) $ 2700 - رزيق بن سوار يروي عن الحسن روى عنه مسافر الجصاص(@)(@@)(@@)(@@) $ 2701 - رفيع البصري أبو العالية الرياحي مولى امرأة من بنى يربوع من بنى رياح اسلم لسنتين خلتا من خلافة أبي بكر يروي عن على وابن عباس روى عنه قتادة وأهل البصرة مات يوم الإثنين في شهر شوال سنة ثلاث وتسعين وكان الشافعي سيء الرأي فيه(@)(@@)(@@)(@@) $ 2702 - رفيع المكى يروي عن بن عباس روى عنه ابنه عبد العزيز بن رفيع المكي(@)(@@)(@@)(@@) $ 2703 - رفيع أبو عقبة السدوسي يروي عن على روى عنه عمران بن حدير PageV04P239(@)(@@)(@@)(@@) $ 2704 - رفاعة بن شداد الفتياني كنيته أبو عاصم وفتيان بطن من بجيلة من أهل اليمن عداده في أهل الكوفة يروي عن عمرو بن الحمق الخزاعي روى عنه السدى وكان ممن انفلت من عين الوردة حين قتل الحسين بن علي في تسعة آلاف من أصحاب الحسين فتلقاهم عبيد الله بن زياد في أهل الشام فقتلهم عن آخرهم(@)(@@)(@@)(@@) $ 2705 - رفاعة بن رافع الزرقي الأنصاري من أهل المدينة يروي عن أنس بن مالك روى عنه عبيد الله بن عمر والناس(@)(@@)(@@)(@@) $ 2706 - رفاعة بن رافع بن خديج الأنصاري الحارثي يروي عن أبيه 
ms564	 روى عنه الناس كنيته أبو خديج مات في ولاية الوليد بن عبد الملك(@)(@@)(@@)(@@) $ 2707 - رزين بن عبيد يروي عن بن عباس روى عنه أبو إسحاق السبيعي(@)(@@)(@@)(@@) $ 2708 - رزين بن قطن يروي عن البراء بن عازب عداده في أهل الكوفة روى عنه الأجلح(@)(@@)(@@)(@@) $ 2709 - ربعي بن حراش بن جحش الغطفاني القيسي من قيس غيلان PageV04P240 كوفي أخو الربيع بن حراش ومسعود بن حراش وكان ربعي من عباد أهل الكوفة وكان أعور يروي عن حذيفة بن اليمان وعمر روى عنه منصور وعبد الملك بن عمير مات في خلافة عمر بن عبد العزيز سنة مائة أو إحدى ومائة وصلى عليه عبد الحميد بن عبد الرحمن بن زيد بن الخطاب ويقال أنه تكلم بعد الموت(@)(@@)(@@)(@@) $ 2710 - ريحان بن يزيد العامري الأعرابي يروي عن عبد الله بن عمرو روى عنه سعد بن إبراهيم(@)(@@)(@@)(@@) $ 2711 - رحيل يروي عن بلال روى عنه ابنه عبد الملك بن رحيل الرحبي(@)(@@)(@@)(@@) $ 2712 - رداد الليثي إن حفظه معمر يروي عن عبد الرحمن بن عوف عن النبي صلى الله عليه وسلم قال قال الله عز وجل أنا الرحمن خلقت الرحم وشققت لها اسما من اسمي فمن وصلها وصلته ومن قطعها بتته ثنا بن قتيبة قال ثنا بن أبي السري قال ثنا عبد الرزاق قال ثنا معمر عن الزهري عن أبي سلمة عن رداد الليثي عن عبد الرحمن PageV04P241 بن عوف ما أحسب معمرا حفظه روى أصحاب الزهري هذا الخبر عن أبي سلمة عن عبد الرحمن بن عوف(@)(@@)(@@)(@@) $ 2713 - رياش بن عمرو الطائي من أهل الكوفة يروي عن على روى عنه الشعبي وقد قيل رياش بن عدى(@)(@@)(@@)(@@) $ 2714 - رياش الحماني يروي عن عمر وعمرو بن العاص روى عنه نوح بن جابر(@)(@@)(@@)(@@) $ 2715 - ريان بن صبيرة الحنفي يروي عن بن عمر روى عنه عيسى بن حطان(@)(@@)(@@)(@@) $ 2716 - ريان بن الجعد الكناني من أهل فلسطين يروي عن أبي قرصافة روى عنه الغنجار عيسى بن موسى(@)(@@)(@@)(@@) $ 2717 - رشيد الواسطي قدم البصرة يروي عن بن عمر روى عنه فضيل 
ms565	 بن طلحة PageV04P242(@)(@@)(@@)(@@) $ 2718 - رواد بن أبي بكرة الثقفي من أهل البصرة أخو عبد الرحمن وعبيد الله ويزيد وعبد العزيز ومسلم بنى أبي بكرة يروي عن أبيه أبي بكرة روى عنه بن سيرين(@)(@@)(@@)(@@) $ 2719 - الركين بن الربيع بن عميلة الفزاري الكوفي يروي عن بن الزبير وابن عمر روى عنه الثوري وشريك مات سنة إحدى وثلاثين ومائة(@)(@@)(@@)(@@) $ 2720 - رديح يروي عن بن عباس روى عنه الأعمش(@)(@@)(@@)(@@) $ 2721 - رستم المزني يروي عن عائذ بن عمرو المزني روى عنه ابنه أبو عامر الخزاز واسمه صالح بن رستم(@)(@@)(@@)(@@) $ 2722 - رستم أبو يزيد الطحان كوفي يروي عن أنس روى عنه خالد بن مخلد القطواني سكن الكوفة(@)(@@)(@@)(@@) $ 2723 - رغبان مولى حبيب بن مسلمة الفهري رأى أصحاب النبي صلى الله عليه وسلم يركعون ركعتين قبل المغرب روى عنه خالد بن معدان PageV04P243(@)(@@)(@@)(@@) $ 2724 - رباب شيخ يروي عن سليمان بن عامر الضبي روت عنه حفصة بنت سيرين نسبه أن يكون من أهل البصرة(@)(@@)(@@)(@@) $ 2725 - رباب يروي عن بن عباس روى عنه تميم بن حدير(@)(@@)(@@)(@@) $ 2726 - رابة يروي عن أبي هريرة روى عبد الحميد بن جعفر عن عبد الله بن أبي جعفر عنه(@)(@@)(@@)(@@) $$ 2727 - رميثة بنت الحارث بن الطفيل بن سخبرة تروى عن أم سلمة روى عنها أخوها عوف بن الحارث من حديث أهل المدينة ورميثة هذه هي أم عبد الله بن محمد بن أبي عتيق(@)(@@)(@@)(@@) $$ 2728 - رميثة جدة القعقاع بن حكيم تروى عن عائشة روى عنها القعقاع بن حكيم(@)(@@)(@@)(@@) $$ 2729 - أم الرائح بنت صليع اسمها الرباب من أهل البصرة تروى عن عمها PageV04P244 سلمان روت عنها حفصة بنت سيرين(@)(@@)(@@)(@@) $$ 2730 - ربعية بنت عياض تروي عن جدها عبيد بن عمرو الكلابي قال رأيت النبي صلى الله عليه وسلم يسبغ الوضوء ثنا أبو يعلى قال ثنا عثمان بن أبي شيبة قال ثنا سعيد بن خثيم الهلالي قال حدثتني ربعية بنت عياض عن جدها(@)(@@)(@@)(@@) $$ 2731 - رهيمة خادم عثمان بن عفان يروى عنها الزبير بن عبد الله بن رهيمة(@)(@@)(@@)(@@) || (باب الزاي)(@)(@@) قال أبو حاتم وممن 
ms566	 شافه الصحابة ورآهم ممن ابتدأ اسمه على الزاي(@)(@@)(@@)(@@) $ 2732 - زيد بن الحسن بن على الهاشمي يروي عن بن عباس روى عنه ابنه حسن بن زيد مات بالبطحاء على ستة أميال من المدينة وأمه أم بشر بنت أبي مسعود عقبة بن عمرو وكان للحسن بن علي منها زيد وأم الحسن PageV04P245 وأم الحسين بن الحسن بن علي بن أبي طالب(@)(@@)(@@)(@@) $ 2733 - زيد بن عبد الله بن عمر بن الخطاب العدوى يروي عن بن عمر روى عنه نافع أمه أم ولد(@)(@@)(@@)(@@) $ 2734 - زيد بن اسلم مولى عمر بن الخطاب كنيته أبو أسامة يروي عن بن عمر روى عنه مالك والناس توفى في السنة التي استخلف أبو جعفر فيها في شهر ذي الحجة في العشر الأول من سنة ست وثلاثين ومائة وأخوه خالد بن اسلم(@)(@@)(@@)(@@) $ 2735 - زيد بن عبد الله بن خليدة الشيباني يروي عن بن عمر روى عنه أبو سنان(@)(@@)(@@)(@@) $ 2736 - زيد بن أبي عتاب مولى أم حبيبة يروي عن سعد ومعاوية روى عنه بن أبي ذئب وموسى بن يعقوب الزمعي(@)(@@)(@@)(@@) $ 2737 - زيد بن ثوب يروي عن على روى عنه أبو بشر(@)(@@)(@@)(@@) $ 2738 - زيد بن جارية الأنصاري يروي عن معاوية روى عنه حكيم بن ميناء PageV04P246(@)(@@)(@@)(@@) $ 2739 - زيد بن عقبة يروي عن سمرة بن جندب روى عنه معبد بن خالد وعبد الملك بن عمير وابنه سعيد بن زيد(@)(@@)(@@)(@@) $ 2740 - زيد بن جبير بن حرقل الجشمي من بنى جشم بن معاوية عداده في أهل الكوفة يروي عن بن عمر روى عنه الثوري(@)(@@)(@@)(@@) $ 2741 - زيد بن حصين يروي عن بن عمر روى عنه المغيرة بن مقسم(@)(@@)(@@)(@@) $ 2742 - زيد بن حارثة يروي المراسيل روى عنه علي بن عبيد الله(@)(@@)(@@)(@@) $ 2743 - زيد بن خليدة اليشكري كوفي والد محمد بن زيد يروي عن بن مسعود روى عنه ابنه(@)(@@)(@@)(@@) $ 2744 - زيد بن دارة مولى عثمان بن عفان يروي عن عثمان بن عفان روى عنه محمد بن عبد الله بن أبي مريم(@)(@@)(@@)(@@) $ 2745 - زيد بن درهم مولى جرير بن حازم الأزدي 
ms567	 من فوق من أهل البصرة وهو والد حماد بن زيد يروي عن أنس بن مالك روى عنه ابنه حماد بن زيد وهو الذي يقال له زيد بن أبى زياد PageV04P247(@)(@@)(@@)(@@) $ 2746 - زيد جد الربيع بن أنس يروي عن أبي موسى الأشعري روى عنه الربيع بن أنس وقد قيل جد الربيع بن أنس زياد(@)(@@)(@@)(@@) $ 2747 - زيد بن إسحاق يروي عن أنس بن مالك روى عنه عبيد الله بن أبي جعفر ويزيد بن أبي حبيب وهو الذي روى عن عمر بن الخطاب أنه قضى في جارية رضعت على يدي رجل حتى تحيض فماتت أنها من مال البائع من حديث عبيد الله بن أبي جعفر عنه(@)(@@)(@@)(@@) $ 2748 - زيد بن زائد يروي عن بن مسعود روى عنه الوليد بن أبي هاشم(@)(@@)(@@)(@@) $ 2749 - زيد بن سعد الهمداني عداده في أهل الكوفة يروي عن حفصة روى عنه أبو إسحاق السبيعي(@)(@@)(@@)(@@) $ 2750 - زيد بن شراحة يروي المراسيل روى عنه عاصم الأحول(@)(@@)(@@)(@@) $ 2751 - زيد بن أبي الشعثاء العنزي وقد قيل زيد أبو الحكم بن أبي الشعثاء يروي عن البراء بن عازب روى عنه أبو بلج(@)(@@)(@@)(@@) $ 2752 - زيد بن صوحان بن حجر بن الهجرس بن صبرة من عبد القيس PageV04P248 عداده في أهل الكوفة كنيته أبو سليمان ويقال أبو عائشة وقد قيل أبو سلمان يروي عن عمر روى عنه أبو وائل قتل يوم الجمل سنة ست وثلاثين وكان قد قال لهم في ذلك اليوم شدوا علي ثيابي ولا تغسلوا عني دما ولا تنزعوا عني ثوبا فإنا قوم مخاصمون وهو أخو صعصعة بن صوحان(@)(@@)(@@)(@@) $ 2753 - زيد بن صبحي يروي عن عقبة بن عامر روى عنه عياش بن عباس ويقال بن صبيح(@)(@@)(@@)(@@) $ 2754 - زيد بن طلحة التيمي والد يعقوب بن زيد يروي عن بن عباس روى عنه سعيد المقبري والثوري(@)(@@)(@@)(@@) $ 2755 - زيد بن علي أبو القموص العبدي يروي عن طلحة بن عبيد الله وطلحة بن عمرو البصري روى عنه قتادة وعوف الأعرابي(@)(@@)(@@)(@@) $ 2756 - زيد بن أبي عبس بن جبر الأنصاري البخاري المديني يروي 
ms568	 عن أبيه واسم أبي عبس عبد الرحمن بن جبر روى عنه ابنه ميمون بن زيد(@)(@@)(@@)(@@) $ 2757 - زيد بن ظبيان الكوفي يروي عن أبي ذر روى عنه ربعي بن حراش(@)(@@)(@@)(@@) $ 2758 - زيد بن علي بن حسين بن علي بن أبي طالب أخو محمد وحسين ابنا على ورأى جماعة من أصحاب رسول الله PageV04P249 صلى الله عليه وسلم روى عنه ولده قتل سنة ثنتين وعشرين ومائة(@)(@@)(@@)(@@) $ 2759 - زيد بن وهب الجهني الهمداني كنيته أبو سليمان عداده في أهل الكوفة يروي عن عمر وعبد الله روى عنه منصور والأعمش مات سنة ست وتسعين وكان يصفر لحيته(@)(@@)(@@)(@@) $ 2760 - زيد بن المعلى يروي عن أنس روى عنه المعتمر بن سليمان قال ثنا بن قتيبة ثنا بن أبي السري قال ثنا معتمر بن سليمان عن زيد بن المعلى قال رأيت أنس بن مالك توضأ يخلل لحيته(@)(@@)(@@)(@@) $ 2761 - زيد أبو عمر يروي عن أنس روى عنه زيد بن أبي أنيسة(@)(@@)(@@)(@@) $ 2762 - زيد مولى الليثيين يروي عن أبي هريرة روى عنه ابنه أسامة بن زيد المدني PageV04P250(@)(@@)(@@)(@@) $ 2763 - زيد بن يثيع الهمداني كوفي يروي عن على روى عنه أبو إسحاق السبيعي(@)(@@)(@@)(@@) $ 2764 - زيد أبو عياش يروي عن سعد بن أبي وقاص روى عنه عبد الله بن يزيد مولى الأسود بن سفيان(@)(@@)(@@)(@@) $ 2765 - زيد بن عبد الرحمن يروي عن أبي سعيد الخدري روى عنه موسى بن عبيدة أحسبه بن أبي عبس الأنصاري(@)(@@)(@@)(@@) $ 2766 - زيد يروي عن عائشة روى عنه ابنه عمران بن زيد(@)(@@)(@@)(@@) $ 2767 - زياد بن حدير الأسدي الكوفي كنيته أبو المغيرة يروي عن عمر روى عنه الشعبي وقد قيل كنيته أبو عبد الرحمن(@)(@@)(@@)(@@) $ 2768 - زياد بن ثويب يروي عن أبي هريرة روى عنه عاصم بن عبيد الله العمرى PageV04P251(@)(@@)(@@)(@@) $ 2769 - زياد بن أنعم الشعباني مصري يروي عن أبي أيوب الأنصاري كان أصله من إفريقية روى عنه ابنه عبد الرحمن بن زياد بن أنعم الإفريقي الأب ثقة والابن ضعيف(@)(@@)(@@)(@@) $ 2770 - زياد بن جارية التميمي الدمشقي يروي عن حبيب بن مسلمة الفهري روى 
ms569	 عنه أهل الشام ومكحول ومن قال يزيد بن جارية فقد وهم(@)(@@)(@@)(@@) $ 2771 - زياد بن ثوبان لقبه بضعة من أهل المدينة يروي عن أبي هريرة روى عنه نافع وعمر بن نافع من حديث عبيد الله بن عمر حدثنا علي بن إبراهيم ببلد ثنا محمد بن إسماعيل الترمذي قال ثنا أيوب بن سليمان بن بلال قال حدثني أبو بكر بن أبي أويس عن عبيد الله بن عمر عن عمر بن نافع عن بضعة عن أبي هريرة قال قال رسول الله صلى الله عليه وسلم لا يغرنكم فاجر في نعمة فإن له عند الله قائلا لا يموت كلما خبت زدناهم سعيرا وبإسناده قال قال رسول الله صلى الله عليه وسلم الدنيا حلوة خضرة فمن أخذها بحقها بورك له فيها ورب متخوض في مال الله ورسوله له النار يوم القيامة PageV04P252(@)(@@)(@@)(@@) $ 2772 - زياد بن مطر يروي عن أبي هريرة روى عنه غيلان بن جرير(@)(@@)(@@)(@@) $ 2773 - زياد بن جبير بن حية الثقفي يروي عن بن عمر روى عنه يونس بن عبيد وابن عون(@)(@@)(@@)(@@) $ 2774 - زياد بن جبل ويقال بن حبل يروي عن أبي كعب وابن الزبير روى عنه معمر وأمية بن شبل الصنعاني(@)(@@)(@@)(@@) $ 2775 - زياد بن أبي الجعد الغطفاني أخو سالم بن أبي الجعد وعبيد وعبد الله بني أبي الجعد واسم أبي الجعد رافع يروي زياد عن وابصة بن معبد روى عنه هلال بن يساف وعبيد بن أبي الجعد(@)(@@)(@@)(@@) $ 2776 - زياد بن حزن بن مخارق الزبيدي بعثه عمر مع عمرو بن العاص إلى فلسطين روى عنه القاسم بن قزمان(@)(@@)(@@)(@@) $ 2777 - زياد الجعفي يروي عن جده عن النبي صلى الله عليه وسلم روى عنه أبو يعفور العبدي PageV04P253(@)(@@)(@@)(@@) $ 2778 - زياد بن رياح القيسي أبو قيس يروي عن أبي هريرة روى عنه الحسن وغيلان بن جرير(@)(@@)(@@)(@@) $ 2779 - زياد أبو رشدين يروي عن عقبة بن عامر روى عنه النعمان الجندي(@)(@@)(@@)(@@) $ 2780 - زياد بن أبي زياد مولى عبد الله بن عياش بن أبي ربيعة المخزومي القرشي المدني كان عابدا زاهدا واسم 
ms570	 أبي زياد ميسرة يروي عن جابر بن عبد الله وأنس بن مالك روى عنه مالك بن أنس وعمرو بن يحيى المازني(@)(@@)(@@)(@@) $ 2781 - زياد بن أبي زاذان مولى بنى هلال فخذ من النخع عداده في أهل الكوفة كنيته أبو الأشهب يروي عن بن عمر روى عنه عبد الله بن إدريس وهو الذي يقال له زياد بن زاذان(@)(@@)(@@)(@@) $ 2782 - زياد بن سيمين كوش يروي عن عبد الله بن عمرو روى عنه طاوس PageV04P254 من حديث ليث بن أبي سليم(@)(@@)(@@)(@@) $ 2783 - زياد بن سعد يروي عن أبي هريرة روى عنه الحارث بن فضيل(@)(@@)(@@)(@@) $ 2784 - زياد مولى سعد يروي عن بن عباس روى عنه بكير بن مسمار(@)(@@)(@@)(@@) $ 2785 - زياد بن طارق كوفي يروي عن على روى عنه إبراهيم بن عبد الأعلى(@)(@@)(@@)(@@) $ 2786 - زياد بن سيار مولى أبي قرصافة الكناني من أهل الشام يروي عن أبي قرصافة واسمه جندرة بن خيشنة روى عنه الطيب بن زبان وكان يسكن قرية يقال لها سناجية من كور الرملة(@)(@@)(@@)(@@) $ 2787 - زياد بن صبيح الحنفي يروي عن بن عمر روى عنه سعيد بن زياد وهو الذي يروي عنه يزيد بن أبي زياد ويقال زياد بن صباح(@)(@@)(@@)(@@) $ 2788 - زياد بن عبد الله النميري بصرى يروي عن أنس بن مالك روى PageV04P255 عنه سهيل بن أبي صالح وعمارة بن زاذان يخطىء وكان من العباد(@)(@@)(@@)(@@) $ 2789 - زياد بن عبد الله بن حدير الأسدي يروي عن أوس روى عنه داود بن أبي هند(@)(@@)(@@)(@@) $ 2790 - زياد بن عبد الله النخعي يروي عن على روى الشيباني عن شيخ له عنه(@)(@@)(@@)(@@) $ 2791 - زياد بن عبد الرحمن أبو الخصيب القيسي من بنى قيس بن ثعلبة عداده في أهل البصرة يروي عن بن عمر روى عنه عقيل بن طلحة(@)(@@)(@@)(@@) $ 2792 - زياد بن عمرو الفهري القرشي ويقال بن عمر يروي عن بن عباس روى عنه يحيى بن عبد الرحمن بن حاطب(@)(@@)(@@)(@@) $ 2793 - زياد بن عبيد القيضي وقيض بطن من حمير يروي عن رويفع بن ثابت البلوي روى عنه حيوة بن شريح PageV04P256(@)(@@)(@@)(@@) $ 2794 
ms571	 - زياد أبو عمر يروي عن أنس بن مالك أصيحابي أصيحابي روى عنه أبو حمزة السكري والحسين بن واقد(@)(@@)(@@)(@@) $ 2795 - زياد بن حرد يروي عن عمرو بن العاص تقتل عمارا الفئة الباغية روى عنه عمرو بن دينار السمكي(@)(@@)(@@)(@@) $ 2796 - زياد بن عبيدة يروي عن أنس بن مالك روى عنه مروان بن معاوية الفزاري(@)(@@)(@@)(@@) $ 2797 - زياد بن سمير يروي عن بن عمر روى عنه طاوس(@)(@@)(@@)(@@) $ 2798 - زياد بن سليم يروي عن بن مسعود روى عنه أبو المحجل(@)(@@)(@@)(@@) $ 2799 - زياد أبو الأوبر يروي عن أبي هريرة روى عنه أهل العراق حدثنا أبو قتيبة ثنا بن أبي السري ثنا معتمر بن سليمان قال ثنا ليث بن أبي سليم عن زياد عن أبي هريرة أن النبي صلى الله عليه وسلم قال أمرت أن أقاتل الناس حتى يقولوا لا إله إلا الله فإذا قالوا لا إله إلا الله فقد عصموا مني دماءهم وأموالهم إلا بحقها وحسابهم على الله(@)(@@)(@@)(@@) $ 2800 - زياد بن نعيم الحضرمي مصري يروي عن زياد بن الحارث PageV04P257 الصدائي روى عنه بكر بن سوادة والإفريقي(@)(@@)(@@)(@@) $ 2801 - زياد بن عدى يروي عن بن مسعود روى عنه أبو العالية(@)(@@)(@@)(@@) $ 2802 - زياد بن عياض ختن أبي موسى الأشعري يروي عن عمر روى عنه الشعبي(@)(@@)(@@)(@@) $ 2803 - زياد بن علاقة بن مالك الثعلبي الكوفي يروي عن أسامة بن شريك وجرير بن عبد الله والمغيرة بن شعبة وعمه قطبة بن مالك روى عنه الثوري وشعبة والناس(@)(@@)(@@)(@@) $ 2804 - زياد بن حذيم بن عمرو السعدي يروي عن أبيه وله صحبة روى عنه ابنه موسى بن زياد(@)(@@)(@@)(@@) $ 2805 - زياد بن قيس المدني مولى لقريش يروي عن أبي هريرة روى عنه عاصم بن بهدلة(@)(@@)(@@)(@@) $ 2806 - زياد بن ميناء يروي عن أبي سعد بن أبي فضالة الأنصاري كان من الصحابة روى عبد الحميد بن جعفر عن أبيه عنه(@)(@@)(@@)(@@) $ 2807 - زياد بن فيروز البصري أبو العالية يروي عن بن عمر وابن الزبير روى عنه عاصم الأحول ويقال إن اسم أبى العالية أذينة وقد PageV04P258 قيل اسمه كلثوم مولى 
ms572	 لقريش مات يوم الإثنين في شهر شوال سنة تسعين(@)(@@)(@@)(@@) $ 2808 - زياد بن أبي المغيرة واسم أبي المغيرة الحارث يروي عن أبي هريرة روى عنه ليث بن أبي سليم(@)(@@)(@@)(@@) $ 2809 - زياد بن كسيب العدوي من أهل البصرة يروي عن أبي بكرة روى عنه سعد بن أوس ثنا عمرو بن محمد الهمداني قال ثنا يزيد بن أخزم قال ثنا أبو داود الطيالسي عن حميد بن مهران عن سعد بن أوس عن زياد بن كسيب عن أبي بكرة عن النبي صلى الله عليه وسلم قال من أهان سلطان الله أهانه الله(@)(@@)(@@)(@@) $ 2810 - زياد مولى بنى مخزوم كوفي يروي عن أبي هريرة روى عنه إسماعيل بن أبي خالد(@)(@@)(@@)(@@) $ 2811 - زياد بن مطر بن شريح العدوي من أهل البصرة يروي عن عمر روى عنه ابنه العلاء بن زياد هو وابنه عابدان زاهدان خيران فاضلان PageV04P259(@)(@@)(@@)(@@) $ 2812 - زياد بن مالك يروي عن بن مسعود ولم يسمع منه قال القارن يطوف طوافين روى عنه الحكم(@)(@@)(@@)(@@) $ 2813 - زياد بن أبي مريم مولى عثمان بن عفان يروي عن أبي موسى الأشعري روى عنه ميمون بن مهران واسم أبي مريم الجراح وهو الذي يروي عن عبد الله بن معقل الندم توبة(@)(@@)(@@)(@@) $ 2814 - زياد بن أبي سودة أخو عثمان بن أبي سودة من أهل بيت المقدس كنيته أبو نصر أمهما مولاة لعبادة بن الصامت وأبوهما مولى لعبد الله بن عمرو بن العاص يروي عن عبادة بن الصامت روى عنه زيد بن واقد وأهل الشام ثنا الصوفي قال ثنا أبو نصر التمار قال ثنا سعيد بن عبد العزيز عن زياد عن أبي سودة أن عبادة بن الصامت قعد على سور بيت المقدس الشرقي يبكي فقال بعضهم ما يبكيك يا أبا الوليد قال من ههنا أخبرنا رسول الله أنه رأى جهنم(@)(@@)(@@)(@@) $ 2815 - زياد مولى عمرو بن العاص يروي عن عمرو بن العاص روى عنه عمرو بن دينار(@)(@@)(@@)(@@) $ 2816 - زياد مولى عثمان بن عفان يروي عن عثمان بن عفان روى عنه ابنه هشام بن زياد 
ms573	 وهشام ضعيف PageV04P260(@)(@@)(@@)(@@) $ 2817 - زياد أبو يحيى الأنصاري من أهل مكة يروي عن بن عباس روى عنه عطاء بن السائب(@)(@@)(@@)(@@) $ 2818 - زياد بن يزيد يروي عن علي بن أبي طالب روى عنه زيد بن أسلم(@)(@@)(@@)(@@) $ 2819 - الزبير بن عبد الرحمن بن عوف الزهري يروي عن أبيه روى عنه أهل المدينة قتل يوم الحرة سنة ثلاث وستين(@)(@@)(@@)(@@) $ 2820 - الزبير بن أبي أسيد الساعدي الأنصاري المدني أخو حمزة بن أبي أسيد وأبو أسيد شهد بدرا يروي عن أبيه روى عنه بن الغسيل(@)(@@)(@@)(@@) $ 2821 - الزبير بن الوليد يروي عن بن عمر روى عنه شريح بن عبيد الحضرمي(@)(@@)(@@)(@@) $ 2822 - الزبير بن عربي كنيته أبو سلمة يروي عن بن عمر روى عنه حماد بن زيد(@)(@@)(@@)(@@) $ 2823 - الزبير بن الصراف من أهل البصرة يروي عن عبد الله بن مغفل روى عنه ابنه عمرو بن الزبير PageV04P261(@)(@@)(@@)(@@) $ 2824 - الزبير بن عبد الرحمن بن الزبير من أهل المدينة يروي عن رفاعة بن سموأل وله صحبة روى عنه مسور بن رفاعة القرظي(@)(@@)(@@)(@@) $ 2825 - الزبير بن لوط بن عازب يروي عن عمه البراء بن عازب روى عنه منصور بن عبد الله(@)(@@)(@@)(@@) $ 2826 - الزبير بن عدى الهمداني اليامي كنيته أبو عدى من أهل الكوفة سكن الري يروي عن أنس بن مالك روى عنه أهل الكوفة حدث عنه بشر بن الحسين الأصبهاني كأن الأرض أخرجت له أفلاذ كبدها في حديثه شيء لا ينظر في شيء ولا يروي عنه إلا على جهة التعجب مات الزبير بالري سنة إحدى وثلاثين ومائة وكان من العباد وصلى عليه نباته بن حنظلة عامل الري(@)(@@)(@@)(@@) $ 2827 - الزبير بن خريق يروي عن أبي أمامة روى عنه عروة بن دينار PageV04P262(@)(@@)(@@)(@@) $ 2828 - الزبير بن عبد الله العنسي يروي المراسيل روى عنه عبد الرحمن بن جبير بن نفير(@)(@@)(@@)(@@) $ 2829 - زكريا بن أبي مريم الخزاعي يروي عن أبي أمامة روى عنه هشيم إن لم يكن دلس عنه(@)(@@)(@@)(@@) $ 2830 - زهير بن حيان يروي عن بن عباس روى عنه حميد بن هلال(@)(@@)(@@)(@@) $ 2831 - زهير بن عثمان الثقفي 
ms574	 يروي عن رجل من أصحاب رسول الله صلى الله عليه وسلم روى عنه الحسن(@)(@@)(@@)(@@) $ 2832 - زهير بن عمرو يروي المراسيل روى عنه أبو عثمان النهدي(@)(@@)(@@)(@@) $ 2833 - زهير بن ماهان يروي عن البراء بن عازب روى عنه عروة بن الحارث الشامي(@)(@@)(@@)(@@) $ 2834 - زهير بن منقذ يروي عن بن عمر روى عنه عبد الله بن ميمون القداح(@)(@@)(@@)(@@) $ 2835 - زهير بن علقمة يروي عن رجل من أصحاب النبي صلى الله عليه وسلم الله عليه PageV04P263 وسلم روى عنه أسلم المنقري(@)(@@)(@@)(@@) $ 2836 - زهير بن عبد الله يروي عن رجل من أصحاب النبي صلى الله عليه وسلم روى عنه أبو عمران الجوني وسمع أنس بن مالك(@)(@@)(@@)(@@) $ 2837 - زهير بن الأقمر كوفي يروي عن الحسن بن علي روى عنه عبد الله بن الحارث وقيل إنه أبو كثير الزبيدي(@)(@@)(@@)(@@) $ 2838 - زهير بن الأصبغ العامري يروي عن عبد الله بن عمرو روى عنه ابنه عطاء(@)(@@)(@@)(@@) $ 2839 - زهير بن مالك أبو الوازع الراسبي يروي عن بن عمر روى عنه إسراءيل(@)(@@)(@@)(@@) $ 2840 - زفر بن الحارث الكلابي من أهل الشام والد مزاحم بن زفر يروي عن عائشة ومعاوية روى عنه ثابت بن الحجاج(@)(@@)(@@)(@@) $ 2841 - زفر بن وثيمة بن مالك بن أوس بن الحدثان النصرى يروي عن حكيم بن حزام إن سمع منه روى عنه الشعيثي PageV04P264(@)(@@)(@@)(@@) $ 2842 - زائدة بن عمير الطائي يروي عن بن عباس روى عنه شعبة ويونس بن أبي إسحاق(@)(@@)(@@)(@@) $ 2843 - زائدة مولى عثمان يروي عن سعد بن أبي وقاص روى عنه أبو الزناد(@)(@@)(@@)(@@) $ 2844 - الزبرقان بن عبد الله بن مازن يروي عن أبي هريرة روى عنه محمد بن الربيع بن كعب(@)(@@)(@@)(@@) $ 2845 - الزبرقان بن عبد الله الليثي يروي عن بن عمر روى عنه بن أبي الموالي(@)(@@)(@@)(@@) $ 2846 - الزبرقان يروي عن عمه عمرو بن أمية الضمري روى عنه كليب بن صبح(@)(@@)(@@)(@@) $ 2847 - الزبرقان شيخ يروي عن النواس بن سمعان روى داود بن أبي هند عن شهر بن حوشب عنه لا أدرى من هو ولا بن من هو(@)(@@)(@@)(@@) $ 2848 - زاذان مولى كندة 
ms575	 يروي عن علي وابن مسعود وابن عمر روى عنه ذكوان أبو صالح وعمرو بن مرة وعبد الله بن السائب وهو زاذان أبو عمر الذي يحدث عن البراء بن عازب يخطىء كثيرا PageV04P265 مات بعد الجماجم ثنا محمد بن إسحاق الثقفي قال ثنا محمد بن أحمد بن أبي خلف قال ثنا إسحاق بن منصور السلولي قال ثنا محمد بن طلحة عن محمد بن جحادة قال كان زاذان يبيع الكرابيس فإذا جاءه المشتري عرض عليه شر الطرفين وساومه سومة واحدة(@)(@@)(@@)(@@) $ 2849 - زاذان والد منصور بن زاذان مولى عبد الله بن أبي عقيل الثقفي كنيته أبو المغيرة يروي عن الحسن بن علي روى عنه هشيم(@)(@@)(@@)(@@) $ 2850 - زرارة بن أوفى العامري يروي عن عمران بن حصين وأبي هريرة وعبد الله بن سلام كنيته أبو حاجب الحرشي كان على قضاء البصرة مات في ولاية عبد الملك بن مروان فجأة في أول قدوم الحجاج العراق قبل بن سيرين وكان من العباد وقد قيل إن زرارة مات سنة ثلاث وتسعين حدثني عمران بن موسى السختياني قال ثنا هدية بن خالد قال ثنا أبو خباب القصاب قال أمنا زرارة بن أوفى في مسجد بني قشير فلما بلغ فإذا نقر في الناقور خر ميتا PageV04P266(@)(@@)(@@)(@@) $ 2851 - زرارة بن مصعب بن شيبة يروي عن بن الزبير روى عنه ابنه عبد الله بن زرارة من حديث بن عيينة(@)(@@)(@@)(@@) $ 2852 - زرارة بن مصعب بن عبد الرحمن بن عوف يروي عن المسور بن مخرمة روى عنه الزهري ثنا عمرو بن محمد الهمداني قال ثنا الفضل بن سهل الأعرج قال ثنا يعقوب بن إبراهيم بن سعد قال ثنا أبي بن صالح عن بن شهاب قال ثنا زرارة بن مصعب بن عبد الرحمن بن عوف عن المسور بن مخرمة أخبره أن عبد الرحمن بن عوف أخبره أنه حرس ليلة مع عمر بن الخطاب فبينا هم يمشون شب لهم سراج في بيت فانطلقوا يؤمونه حتى إذا دنوا منه إذا باب البيت مجاف على قوم لهم أصوات مرتفعة ولغط 
ms576	 فقال عمر وأخذ بيد عبد الرحمن فقال أتدري بيت من هو فقال هذا بيت ربيعة بن أمية بن خلف وهم الآن في شرب قال فماذا ترى قال عبد الرحمن أرى إنا قد أتينا ما نهينا عنه قال الله تعالى ولا تجسسوا فانصرف عنهم وتركهم(@)(@@)(@@)(@@) $ 2853 - زرارة بن جزى قد قيل نحبي يروي عن المغيرة بن شعبة روى عنه مكحول(@)(@@)(@@)(@@) $ 2854 - زرارة بن كريم بن الحارث بن عمرو السهمي يروي عن الحارث بن عمرو أنه أتى النبي صلى الله عليه وسلم روى عنه عتبة بن عبد الملك PageV04P267 السهمي ومن زعم أن له صحبة فقد وهم(@)(@@)(@@)(@@) $ 2855 - زرعة بن ثوب والد ضمضم بن زرعة من أهل الشام ولى القضاء بدمشق زمن الوليد بن عبد الملك وكان لا يأخذ على القضاء أجرا يروي عن بن عمر روى عنه عامر بن جشيب(@)(@@)(@@)(@@) $ 2856 - زرعة بن عبد الرحمن بن جرهد الأسلمي من أهل المدينة يروي عن جرهد روى عنه أبو الزناد وسالم أبو النضر ومن زعم أنه زرعة بن مسلم بن جرهد فقد وهم وقد قيل روى قتادة عن زرعة بن عبد الرحمن عن راشد بن حبيش عن عبادة بن الصامت(@)(@@)(@@)(@@) $ 2857 - زرعة بن حصين بن سياه أخو محمد وسليمان يروي عن جدتهم أم سنبلة أنها أتت النبي صلى الله عليه وسلم بهدية روى عنه عمرو بن قيظى بن عمرو بن شداد(@)(@@)(@@)(@@) $ 2858 - زرعة أبو عبد الرحمن يروي عن بن عباس روى عنه مالك بن مغول(@)(@@)(@@)(@@) $ 2859 - زرعة بن ضمرة يروي عن بن عباس روى عنه حيان بن عمير PageV04P268(@)(@@)(@@)(@@) $ 2860 - زر بن حبيش الأسدي من أهل الكوفة من بنى غاضرة كنيته أبو مريم وقد قيل أبو مطرف يروي عن عمر وعلى روى عنه أهل الكوفة مات بها سنة ثنتين وثمانين قبل الجماجم وهو بن اثنتين وعشرين ومائة سنة وكان من أعرب الناس وكان عبد الله بن مسعود يسأله عن العربية(@)(@@)(@@)(@@) $ 2861 - زهرة بن حوية السعدي يروي عن جماعة من أصحاب النبي صلى الله عليه وسلم 
ms577	 روى عنه أهل الكوفة(@)(@@)(@@)(@@) $ 2862 - زاجر بن الصلت البصري أصله يماني يروي عن بن عباس روى عنه أهل البصرة(@)(@@)(@@)(@@) $ 2863 - زهدم بن الحارث الغفاري يروى عن بن عمر عداده في أهل البصرة روى عنه ابنه يحيى بن زهدم(@)(@@)(@@)(@@) $ 2864 - زهدم بن مضرب الجرمي بصرى يروى عن بن عباس وعمران بن حصين روى عنه قتادة وأبو جمرة PageV04P269(@)(@@)(@@)(@@) $ 2865 - زحر بن قيس خرج حين أصيب على إلى المدائن روى عنه الشعبي(@)(@@)(@@)(@@) $ 2866 - زبيد بن الصلت بن معاوية بن حجر بن معاوية بن الحارث بن ثور وهو من كندة كنيته أبو كثير وقد قيل أبو عبد الله حليف بنى جمح وهو أخو كثير بن الصلت يروي عن عمر روى عنه عروة بن الزبير وقتادة يقال إنه ولد في عهد رسول الله صلى الله عليه وسلم(@)(@@)(@@)(@@) $ 2867 - زامل بن أوس الطائي يروي عن أبي هريرة روى عنه ابنه عصمة بن زامل بن أوس الطائي(@)(@@)(@@)(@@) $ 2868 - زربى يروي عن البراء روى عنه ابنه إسماعيل بن زربى(@)(@@)(@@)(@@) $ 2869 - زيادة بن عبد الله بن زيد بن مربع الأنصاري من بنى حارثة أخو علاقة بن عبد الله عداده في أهل المدينة يروي عن سهل بن سعد روى عنه كثير بن جعفر(@)(@@)(@@)(@@) $ 2870 - زريق بن حيان الفزاري شامي يروي عن رجل من أصحاب النبي PageV04P270 صلى الله عليه وسلم روى عنه أهل الشام توفى بنيقية من أرض الروم في إمارة يزيد بن عبد الملك من سهم أصابه وهو بن ثمانين سنة(@)(@@)(@@)(@@) $ 2871 - زغب بن عبد الله يروي عن عبد الله بن حوالة روى عنه ضمرة بن حبيب يغرب(@)(@@)(@@)(@@) $ 2872 - زاجر بن الهيثم يروي عن بن مسعود روى عنه يحيى بن عبيد الله بن قزعة البصري(@)(@@)(@@)(@@) ||| (النساء)(@)(@@)(@@)(@@) $$ 2873 - زينب بنت كعب بن عجرة تروى عن الفريعة بنت مالك بن سنان ولها صحبة روى عنها سعد بن إسحاق بن كعب بن عجرة(@)(@@)(@@)(@@) $$ 2874 - زينب بنت أم سلمة تروى عن أم سلمة روى عنها عروة بن الزبير وعراك بن مالك(@)(@@)(@@)(@@) $$ 2875 - زينب بنت 
ms578	 أم سلمة تروى عن أم سلمة أن النبي صلى الله عليه وسلم أتي بكتف شاة فأكل منها ثم صلى ولم يتوضأ روى جعفر بن محمد PageV04P271 عن أبيه عنها(@)(@@)(@@)(@@) $$ 2876 - زينب بنت نبيط تروي عن ضباعة بنت الزبير روى عنها حميد الطويل(@)(@@)(@@)(@@) $$ 2877 - زينب بنت أبي حازم أخت قيس بن أبي حازم قالت دخل علي أبو بكر الصديق وأنا مصمتة فقال لي تكلمي إن هذا لا يصلح إن هذا من عمل الجاهلية قالت فتكلمت قاله بيان عن قيس عن أخته زينب(@)(@@)(@@)(@@) $$ 2878 - زينب بنت عبد الله بن أنس بن مالك تروي عن جدها أنس بن مالك عداده في أهل البصرة روت عنها يسيرة بنت بشير بن مسعود(@)(@@)(@@)(@@) $$ 2879 - زينب سمعت عائشة تقول لا أحل نبيذ حنتم ولا نقير ولا دباء ولا مزفت ولا أحرم إلا ما حرم الله رواه يحيى بن سعيد القطان عن جابر بن صبح عن عمتيه أنيسة وزينب عن عائشة(@)(@@)(@@)(@@) $$ 2880 - زيدة بنت قيلة بنت مخرمة بن قرط روت عنها صفية ودحيبة ابنتا عليبة PageV04P273(@)(@@)(@@)(@@) || (باب السين)(@)(@@) قال أبو حاتم وممن سمع الصحابة وروى عنهم ممن ابتدأ اسمه على السين(@)(@@)(@@)(@@) $ 2881 - سعيد بن إياس أبو عمرو الشيباني حج في الجاهلية حجتين وكان في أيام النبي صلى الله عليه وسلم صبيا يعقل وليس له صحبة يروي عن عمر وابن مسعود روى عنه الناس حضر القادسية وهو بن أربعين سنة ومات بعد أن تم له عشرون ومائة سنة وكانت القادسية سنة إحدى وعشرين فكأنه مات سنة إحدى ومائة قال أبو عمرو كنت أسمع النبي صلى الله عليه وسلم وأنا أرعى إبلا لأهلي بكاظمة(@)(@@)(@@)(@@) $ 2882 - سعيد بن المسيب بن حزن بن أبي وهب بن عمرو بن عائذ بن عبد الله بن عمرو بن مخزوم بن يقظة المخزومي القرشي كنيته أبو محمد ولد لسنتين مضتا من خلافة عمر وأم سعيد بن المسيب بنت عثمان بن حكيم بن أمية بن حارثة بن الأوقص بن مرة بن هلال بن فالج بن PageV04P273 ذكوان السلمي وكان من 
ms579	 سادات التابعين فقها ودينا وورعا وعلما وعبادة وفضلا وكان أبوه يتجر في الزيت وكان سعيد سيد التابعين وأفقه أهل الحجاز وأعبر الناس للرؤيا ما نودي بالصلاة أربعين سنة إلا وسعيد في المسجد ينتظرها ويقال أنه ممن أصلح بين عثمان وعلي فلما بويع عبد الملك وبايع للوليد ولسليمان من بعده وأخذ البيعة من الناس أبى سعيد ذلك فلم يبايع فقال له عبد الرحمن بن عبد القاري إنك تصلي بحيث يراك هشام بن إسماعيل فلو غيرت مقامك حتى لا يراك وكان هشام واليا على المدينة لعبد الملك فقال سعيد إني لم أغير مقاما قمته منذ أربعين سنة قال فاخرج معتمرا قال لم أكن لأجهد بذلي وأنفق مالي في شيء ليس لي فيه نية قال فبايع إذا قال أرايتك إن كان الله أعمى قلبك كما أعمى بصرك فما علي وأبى أن يبايع فكتب هشام بن إسماعيل إلى عبد الملك فكتب عبد الملك إليه ما دعاك إلى سعيد بن المسيب ما كان علينا منه شيء نكرهه فأما إذا فعلت فادعه فإن بايع وإلا فاضربه ثلاثين سوطا وأوقفه للناس فدعاه هشام فأباه PageV04P274 وقال لست أبايع لاثنتين فضربه ثلاثين سوطا ثم ألبسه ثيابا من شعر وأمر به فطيف به حتى بلغوا به الحناطين ثم ردده وأمر به إلى السجن فقال سعيد لولا أني ظننت أنه القتل ما لبسته قلت أستر عورتي عند الموت مات سنة ثلاث أو أربع وتسعين وكان يقال لهذه السنة سنة الفقهاء من كثرة من مات من الفقهاء فيها وقد قيل إنه مات سنة خمس ومائة(@)(@@)(@@)(@@) $ 2883 - سعيد بن جبير بن هشام مولى بني والبة بن الحارث من بني أسد بن خزيمة يروى عن بن عمر وابن عباس وجماعة من أصحاب رسول الله صلى الله عليه وسلم روى عنه عمرو بن دينار وأيوب والناس كنيته أبو عبد الله وكان فقيها عابدا ورعا فاضلا وكان يكتب لعبد الله بن عتبة بن مسعود حيث كان على قضاء الكوفة ثم كتب لأبي بردة بن أبي موسى 
ms580	 حيث كان على قضائها ثم خرج مع بن الأشعث في جملة القراء فلما هزم بن الأشعث بدير الجماجم هرب سعيد بن جبير إلى مكة فأخذه خالد بن عبد الله القسري بعد مدة وكان واليا لعبد الملك على مكة وبعث به إلى الحجاج فقال له الحجاج اختر لنفسك أي قتلة شئت فقال اختره أنت فإن القصاص أمامك فقتله الحجاج بن يوسف سنة خمس وتسعين وهو بن تسع PageV04P275 وأربعين سنة ثم مات الحجاج بعده بأيام وكان مولد الحجاج سنة أربعين ثنا الحسن بن يوسف قال ثنا أبو بكر بن أبي شيبة قال ثنا وكيع قال ثنا سفيان عن حماد بن أبي سليمان قال سمعت سعيد بن جبير يقول قرأت القرآن في الكعبة في ليلة أنبأ الصوفي ببغداد قال أنبأ أحمد بن إبراهيم الدورقي قال ثنا مسلم بن قتيبة قال ثنا الأصبغ بن زيد عن القاسم الأعرج قال كان سعيد بن جبير يبكي بالليل حتى عمش ثنا محمد بن إسحاق بن إبراهيم الثقفي قال ثنا أبو حاتم بن الليث قال ثنا أبو نعيم قال ثنا الحسن بن طلحة عن وفاء بن إياس قال كان سعيد بن جبير ختم القرآن فيما بين المغرب والعشاء في رمضان قد ذكرت وصف قتله في كتاب الخلفاء في إمارة عبد الملك(@)(@@)(@@)(@@) $ 2884 - سعيد بن أبي الحسن أخو الحسن بن أبي الحسن مولى زيد بن ثابت الأنصاري واسم أبي الحسن يسار يروي عن بن عباس روى عنه قتادة مات بفارس سنة ثمان ومائة قبل الحسن وبكى عليه الحسن سنة فعوتب فيه فقال الحمد لله الذي لم يجعل بكاء يعقوب عارا عليه(@)(@@)(@@)(@@) $ 2885 - سعيد بن العاص بن سعيد بن العاص PageV04P276 بن أمية بن عبد شمس بن عبد مناف القرشي كنيته أبو عثمان وقد قيل أبو عبد الرحمن يروي عن عمر وعثمان وعائشة سمع منه سالم وابنه يحيى مات سعيد بن العاص وأبو هريرة وعائشة وعبد الله بن عامر سنة ثمان وخمسين(@)(@@)(@@)(@@) $ 2886 - سعيد بن عمرو بن سعيد بن العاص الأموي 