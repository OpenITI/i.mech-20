ms1021	 محمد القاضي (¬12) صاحب "الأخبار المستفادة في آل قتادة" (¬13) انتهى [فيه] إلى سنة 918،(@)(@)PageV04P072(@)(@)(@@)(@@)(@@) |||| CHECK 5954 - ومحمد بن المحب القاضي أحمد بن عبد الحي القيوم بن أبي بكر بن عبد الله(@)(@)(@@)(@@)(@@) |||| CHECK 5953 - وعلي بن جار الله محمد الفقيه(@)(@)(@@) 5953 - • وعلي بن جار الله محمد الفقيه نصب نفسه أكثر من أربعين عاما بالبلد الحرام لبيان غوامض الأحكام،(@)(@@) • وفخر الدين بن علي بن محمد (¬1)،(@)(@)(@@) 5954 - • ومحمد بن المحب القاضي أحمد بن عبد الحي القيوم بن أبي بكر بن عبد الله، مات [سنة] 927 وله 58.(@)(@@) ظهيرة بن مزروق المخزومي(@)(@@) عطية(@)(@@) أحمد(@)(@@) علي(@)(@@) حسين(@)(@@) محمد القاضي الجمال أبو السعود(@)(@@) محمد القاضي الكمال أبو البركات(@)(@@) علي(@)(@@) إبراهيم البرهان(@)(@@) وابن محمد القاضي هو:(@)(@@) محمد الجمال أبو السعود(@)(@@) عمر السراج ولد سنة 853 ومات بعد سنة 927 وقد أضر(@)(@@) ابن عادل: هو العلامة سراج الدين عمر بن علي بن عادل الدمشقي الحنبلي المفسر (¬2) شريك السمين.(@)(@@) ابن العاقولي: هو غياث الدين محمد بن محمد بن عبد الله الشافعي البغدادي (¬3)، مدرس المستنصرية، مات 797. انتهت إليه رياسة المذهب بالعراق وكان ذا فضائل وتوسع في المال. لكن نهبت على يد اللنكية وله(@)(@@) أنست بالوحدة في منزلي ... فصارت الوحشة لي أنسا(@)(@@) سيان عندي بعد ترك الورى ... وذكرهم أذكر أم أنسى(@)(@@) ابن العالمة: أحمد بن أسعد (¬4).(@)(@@) ابن عامر: عبد الله [بن يزيد بن تميم بن ربيعة اليحصبي الدمشقي القاضي] (¬5)(@)(@)PageV04P073(@)(@)(@@)(@@)(@@) |||| CHECK 5959 - وأخوه أحمد(@)(@)(@@)(@@)(@@) |||| AUTO 5955 - ابن عابد [محمد بن عبد الله المعافري المحدث المسند](@)(@)(@@) (¬1).(@)(@)(@@)(@@)(@@) |||| AUTO 5956 - ابن عباد: إسمعيل بن إسمعيل(@)(@)(@@) .(@)(@)(@@)(@@)(@@) |||| AUTO 5957 - ابن عباس: إذا أطلق عبد الله لا يراد به إلا عبد الله بن عباس الصحابي(@)(@)(@@) (¬2). وأطلقه صاحب " الهداية" (¬3) في أواخر باب الإحرام على غيره، حيث قال في دعاء مزدلفة: حتى روي في حديث ابن عباس استجيب له دعاؤه، وهذا ليس بجيد لأنه [يقصد] كنانة بن عباس بن مرداس السلمي (¬4).(@)(@)(@@)(@@)(@@) |||| AUTO 5958 - ابن العبال: أبو عبد الله محمد بن محمد بن أحمد الحنفي(@)(@)(@@) (¬5).(@)(@@) ابن عبد البر: يوسف بن عبد الله النمري (¬6).(@)(@@) ابن 
ms1022	 عبد الحق: إبراهيم بن علي بن أحمد الحنفي (¬7)، مات [سنة] 744،(@)(@)(@@) 5959 - • وأخوه أحمد (¬8)، مات [سنة] 738،(@)(@@) • وصدر الدين سليمان بن داود (¬9).(@)(@@) إبراهيم، قضاة دمشقيون حنفيون(@)(@@) يوسف(@)(@@) أحمد(@)(@@) علي(@)(@@) البرهان إبراهيم، مات 744(@)(@@) أمين الدين محمد، مات 776.(@)(@@) ابن عبد الحكم: هو محمد بن عبد الله بن عبد الحكم المصري (¬10)، مات [سنة] 268.(@)(@)PageV04P074(@)(@)(@@)(@@)(@@) |||| CHECK 5965 - ومحمد بن عبدوس الجهشياري(@)(@)(@@)(@@)(@@) |||| CHECK 5964 - وأبو الزعراء عبد الرحمن المقرئ(@)(@)(@@)(@@)(@@) |||| CHECK 5963 - وأبو محمد.(@)(@)(@@)(@@)(@@) |||| CHECK 5961 - أبو بكر زين الدين "مسند الشام"(@)(@)(@@)(@@)(@@) |||| CHECK 5960 - وأحمد بن عبد الدائم بن نعمة المقدسي(@)(@)(@@) ابن عبد الدائم: محمد البرماوي (¬1)،(@)(@)(@@) 5960 - • وأحمد بن عبد الدائم بن نعمة المقدسي،(@)(@@) 5961 - • أبو بكر زين الدين "مسند الشام" (¬2)، مات 718 عن 93.(@)(@@) ابن عبد السلام: هو الشهاب أحمد بن محمد بن محمد (¬3) وأبوه.(@)(@@) ابن عبد الهادي: [يوسف بن حسن بن أحمد بن عبد الهادي الشهير بابن المبرد] (¬4).(@)(@@) ابن عبدان: عبد الله ابن عبدان بن محمد الهمداني الشافعي] (¬5).(@)(@@) ابن عبد ربه: أحمد بن محمد القرطبي (¬6)،(@)(@@) • وسعيد بن عبد الرحمن (¬7) صاحب "العقد" (¬8).(@)(@@) ابن عبد السلام: الشرف أبو عبد الله محمد بن عبد العزيز بن عبد السلام بن أبي القاسم السلمي الشافعي (¬9)، مات [سنة] 681.(@)(@)(@@)(@@)(@@) |||| AUTO 5962 - ابن عبدك: محمد بن علي الجرجاني(@)(@)(@@) (¬10)، مات [سنة] 347،(@)(@@) 5963 - • وأبو محمد.(@)(@@) ابن عبدوس: أحمد بن محمد بن أحمد (¬11) الحنفيون،(@)(@)(@@) 5964 - • وأبو الزعراء عبد الرحمن المقرئ (¬12)،(@)(@@) 5965 - • ومحمد بن عبدوس الجهشياري (¬13) صاحب "كتاب الوزراء".(@)(@)PageV04P075(@)(@)(@@)(@@)(@@) |||| CHECK 5972 - وأبو بكر بن عثمان بن أبي بكر(@)(@)(@@)(@@)(@@) |||| CHECK 5971 - ومحمود بن عبد الله بن محمد(@)(@)(@@)(@@)(@@) |||| CHECK 5967 - وأحمد بن محمد القاضي المقرئ(@)(@)(@@)(@@)(@@) |||| CHECK 5966 - وعبد المجيد(@)(@)(@@) ابن عبدون: الشيخ الأجل أبو عبد الله الأستاد محمد بن عبد الله الحنفي (¬1)، مات [سنة] 299.(@)(@)(@@) 5966 - • وعبد المجيد (¬2)،(@)(@@) 5967 - • وأحمد بن محمد القاضي المقرئ (¬3).(@)(@)(@@)(@@)(@@) |||| AUTO 5968 - ابن عبده: محمد القاضي(@)(@)(@@) .(@)(@)(@@)(@@)(@@) |||| AUTO 5969 - ابن عبو: أبو عبد الله محمد بن عبو الفزاري المقرئ الركلاوي(@)(@)(@@) ، عرف بابن مصالي.(@)(@)(@@)(@@)(@@) |||| AUTO 5970 - ابن العجمي: إبراهيم بن صالح(@)(@)(@@) (¬4)(@)(@@) 5971 - • ومحمود بن عبد الله بن محمد(@)(@@) 5972 - • وأبو 
ms1023	 بكر بن عثمان بن أبي بكر، مات [سنة] 795.(@)(@@) ابن العجمي، بيت علم بحلب شافعيون(@)(@@) الحسن(@)(@@) عبد الرحمن (¬5)(@)(@@) أبو صالح عبد الرحيم الشهاب (¬6)(@)(@@) الشرف أبو طالب عبد الرحمن، مات 658 شهيدا في .... بحلب(@)(@@) عبد الرحيم(@)(@@) التاج أبو محمد عبد الله، مات 700(@)(@@) عمر الكمال أبو القاسم (¬7)(@)(@@) عبيد الله الشهاب أبو صالح، مات 671 عن 62(@)(@@) وابن أبو صالح هو:(@)(@@) محمد(@)(@@) عبد العزيز(@)(@@) أحمد الكمال أبو العباس، مات 666(@)(@)(@@)(@@)(@@) |||| AUTO 5973 - آل عجيل: عمر وهو بن محمد بن زريق بن حامد بن وليد بن زكريا بن أحمد بن حامد بن معرب بن عبيد بن محمد الفارسي بن زيد بن ذوال بن شبوه بن ثوبان بن عيسى بن سجارة بن غالب بن عبد الله بن عك بن عدنان(@)(@)(@@) (¬8).(@)(@)PageV04P076(@)(@)(@@) ابن عجيل: الشهاب أحمد بن موسى اليمني (¬1)، مات [سنة] 690.(@)(@@) آل عجيل علي(@)(@@) موسى(@)(@@) أحمد(@)(@)(@@)(@@)(@@) |||| AUTO 5974 - ابن العداس: إبراهيم بن يوسف(@)(@)(@@) .(@)(@@) ابن عدلان: محمد بن أحمد بن عثمان الشافعي (¬2)، مات [سنة] 649،(@)(@@) • وعلي (¬3).(@)(@@) ابن عدي: أبو أحمد عبد الله بن محمد الجرجاني (¬4)، مات [سنة] 365.(@)(@@) ابن العديم: أولاد العديم، جماعة من بيت علم بحلب قال ياقوت: سألت عمر بن أحمد (¬5) لم سميتم ببني العديم؟ فقال: سألت جماعة من أهلي فلم يعرفوه، ولم يكن في آبائي القدماء من يعرف به ولا أحسب إلا أن جد جدي القاضي أبا الفضل هبة الله مع بردة وسعة كان يكثر في شعره من ذكر العدم وشكوى الزمان فنسب إلي ذلك، وإن لم يكن هذا سببه فما أدري ما سببه. كذا في "عقود الجمان".(@)(@)PageV04P077(@)(@)(@@) آل العديم، موسى بن عيسى بن عبد الله بن محمد بن أبي جرادة صاحب أمير المؤمنين علي بن أبي طالب واسم أبي جرادة عامر بن ربيعة بن خويلد بن عوف بن عامر(@)(@@) زهير أبو جرادة(@)(@@) يحيى(@)(@@) أبو الحسين نجم الدين أحمد، مات 442. وهو أول من ولي قضاء حلب منهم(@)(@@) جمال الدين هبة الله أبو الفضل(@)(@@) أحمد(@)(@@) محمد(@)(@@) عبد العزيز(@)(@@) عمر(@)(@@) قاضي القضاة بحلب محمد ناصر الدين أبو عبد الله، 
ms1024	 مات 753 عن 63 بحلب(@)(@@) إبراهيم جمال الدين(@)(@@) أحمد(@)(@@) أبو القاسم عمر القاضي(@)(@@) وابن جمال الدين هو:(@)(@@) إسمعيل(@)(@@) مجد الدين أبو غانم محمد القاضي الخطيب بحلب، مات 534(@)(@@) أبو الفتح يحيى، مات 656 عن 81(@)(@@) أبو المفاخر محمد، مات 657 عن 47.(@)(@@) إسمعيل(@)(@@) محمد النجم عبد المجيد ولد سنة 688(@)(@@) أحمد النجم أبو الحسن(@)(@@) محمد عبد العزيز(@)(@@) عمر القاضي كمال الدين، قاضي حلب مات 730 وله 50(@)(@@) أحمد(@)(@@) عمر(@)(@@) عبد المحسن الفضلي مات 704(@)(@@) عمر الصاحب كمال الدين، مات 690(@)(@@) المجد عبد الرحمن ابن الصاحب، مات 677 عن 64 بدمشق(@)(@@) محمد أبو عامر، مات 694(@)(@@) عقر القاضي النجم مات 734(@)(@@) وابن مجد الدين هو:(@)(@@) محيي الدين أبو عبد الله محمد الصاحب، مات 656 عن 66(@)(@)PageV04P078(@)(@)(@@)(@@)(@@) |||| CHECK 5984 - وأبو الحسن علي بن أحمد بن العريف المقرئ(@)(@)(@@)(@@)(@@) |||| CHECK 5978 - وابنه عبد الوهاب(@)(@)(@@)(@@)(@@) |||| CHECK 5977 - أبو حفص عمر بن محمد بن عراك المقرئ(@)(@)(@@)(@@)(@@) |||| CHECK 5976 - والشيخ علاء الدين علي بن محمد ابن عراق(@)(@)(@@)(@@)(@@) |||| AUTO 5975 - ابن العراق: أبو بكر محمد سعيد اليمني(@)(@)(@@) ، مات [سنة] 689،(@)(@@) 5976 - • والشيخ علاء الدين علي بن محمد ابن عراق (¬1)،(@)(@@) 5977 - • أبو حفص عمر بن محمد بن عراك المقرئ (¬2).(@)(@@) ابن عربشاه: أحمد بن محمد بن عبد الله الدمشقي (¬3)(@)(@)(@@) 5978 - • وابنه عبد الوهاب (¬4)، مات 901.(@)(@)(@@)(@@)(@@) |||| AUTO 5979 - ابن العرجا: أبو علي الحسن بن عبد الله بن عمر القيرواني المقرئ(@)(@)(@@) (¬5).(@)(@)(@@)(@@)(@@) |||| AUTO 5980 - ابن العربي: القاضي أبو بكر محمد بن عبد الله محمد المالكي(@)(@)(@@) (¬6) الحافظ، مات [سنة] 543،(@)(@@) • والشيخ محيي الدين محمد بن علي بن محمد الطائي (¬7)، مات في 22 را [ربيع الأول سنة] 638 عن 78 [سنة]. وقد فرق المحدثون بينهما فقالوا: ابن العربي بالتعريف للقاضي أبي بكر، وابن عربي للشيخ محصي الدين بالتنكير، وقالوا: هو منكر الحديث وغيرهم لا يفرقون بينهما.(@)(@)(@@)(@@)(@@) |||| AUTO 5981 - ابن عرعرة: إبراهيم بن محمد(@)(@)(@@) (¬8).(@)(@)(@@)(@@)(@@) |||| AUTO 5982 - ابن عرفة: الحسن [بن عرفة] العبدي المؤدب(