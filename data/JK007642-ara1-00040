ms21	(@)(@@) % تسكب الدمع ايما تسكاب % % 107(@)(@@) % أيها الحاملوه لامشى ركض % % ان هذا يوم الفراق الممض % % 108(@)(@@) % فاسألوه عن قصده أين يمضي % % انه قد قضى ولم يك يقضي % % 109(@)(@@) % واجبات الصبا وشرخ الشباب % % PageV01P066 110(@)(@@) % إن قلبي على كريم السجايا % % طاح والله من أساه شظايا % % 111(@)(@@) % قاتل الله يا بن امي المنايا % % أنا من قبل مذ حسبت الرزايا % % 112(@)(@@) % لم يكن زرء موتكم في حسابي % % 113(@)(@@) % إن ليلى وليس من رافديه % كلما جاءني وذكرنيه % 114(@)(@@) % قلت والدمع قائل لي إيه % يا فقيدا أعاتب الموت فيه % % 115(@)(@@) % ببكائي وهل يفيد عتابي % % 116(@)(@@) % رحت يوما وقد مضت سنتان % % اتمشى ' بشارع الميدان ' % 117(@)(@@) % مشي حيران خطوه متدان % اثقلته الحياة بالاحزان % % 118(@)(@@) % وسقته كأسا كطعم الصاب % % 119(@)(@@) % بينما كنت هكذا أتمشى % % عرضت نظرة فابصرت نعشا % % PageV01P067 120(@)(@@) % باديا للعيون غير مغشى % % نقش الفقر فيه للحزن نقشا % % 122(@)(@@) % قلت سرا والنعش يقرب مني % % ايها النعش أنت انعشت حزني % % 123(@)(@@) % للأسى فيك حالة ناسبتني % % 124(@)(@@) % أنا للحزن دائما ذو انتساب % % 125(@)(@@) % رحت أسعى وراءه مذ تعدى % % مسرعا في خطاي لم آل جهدا % 126(@)(@@) % مع رجال كأنجم النعش عدا % % هم به سائرون سيرا مجدا % % 127(@)(@@) % فتراه يمر مر السحاب % % 128(@)(@@) % مذ لحدنا ذاك الدفين وعدنا % % قلت والدمع بل منى ردنا % % 129(@)(@@) % ان هذا هو الذي قد وعدنا % % فأبينوا من الذي قد لحدنا % % 130(@)(@@) % فتصدى منهم فتى لجوابي % % PageV01P068 131(@)(@@) % قال إن الدفين أخت بشير % % اخت ذاك المسكين ذاك الفقير % % 132(@)(@@) % بقيت بعده بعيش عسير % % وبطرف باك وقلب كسير % % 133(@)(@@) % وقضت مثله بداء القلاب % % 134(@)(@@) % قلت أقصر عن الكلام فحسبي % % منك هذا فقد تزلزل قلبي % % 135(@)(@@) % ثم ناجيت والضراعة ثوابي % % رب رحماك رب رحماك رب % 136(@)(@@) % رب رشدا إلى طريق الصواب % % 137(@)(@@) % رب إن العباد أضعف أن لا % % وإذا مسك الطوى فارفضيني % % 138(@)(@@) % فاعف عن أخذهم وإن كان عدلا % % انت يا رب انت بالعفو اولى % % 139(@)(@@) % منك بالأخذ والجزا والعقاب % % 140(@)(@@) % قد وردنا والأرض للعيش حوض % % واحد كلنا لنا فيه خوض % % PageV01P069 141(@)(@@) % فلماذا 
ms22	 به مشوب ومحض % % عظمة حكمة الإله فبعض % % 142(@)(@@) % في نعيم وبعضنا في عذاب % % 143(@)(@@) % ايها الاغنياء كم قد ظلمتم % % نعم الله حيث ما إن رحمتم % % 144(@)(@@) % سهر البائسون جوعا ونمتم % % بهناء من بعد ما قد طعمتم % % 145(@)(@@) % من طعام منوع وشراب % % 146(@)(@@) % كم بذلتم اموالكم في الملاهي % % وركبتم بها متون السفاه % % 147(@)(@@) % وبخلتم منها بحق الله % % ايها الموسورون بعض انتباه % % 148(@)(@@) % أفتدرون انكم في تباب % % PageV01P070 البحر : وافر تام 1(@)(@@) % هي الاخلاق تنبت كالبنات % % اذا سقيت بماء المكرمات % 2(@)(@@) % تقوم إذا تعهدها المربي % % على ساق الفضيلة مثمرات % % 3(@)(@@) % وتسمو للمكارم باتساق % كما اتسقت أنابيب القناة % % 4(@)(@@) % وتنعش من صميم المجد روحا % % بازهار لها متضوعات % % 5(@)(@@) % ولم أر للخلائق من محل % يهذبها كحضن الأمهات % % 6(@)(@@) % فحضن الأم مدرسة تسامت % بتربية البنين أو البنات % % 7(@)(@@) % واخلاق الوليد تقاس حسنا % باخلاق النساء الوالدات % 8(@)(@@) % وليس ربيب عالية المزايا % % كمثل ربيب سافلة الصفات % % 9(@)(@@) % وليس النبت ينبت في جنان % كمثل النبت ينبت في الفلاة % % 10(@)(@@) % فيا صدر الفتاة رحبت صدرا % فأنت مقر أسنى العاطفات % % PageV01P071 11(@)(@@) % نراك إذا ضممت الطفل لوحا % % يفوق جميع الواح الحياة % % 12(@)(@@) % اذا استند الوليد عليك لاحت % % تصاوير الحنان مصورات % % 13(@)(@@) % لأخلاق الصبى بك انعكاس % % كما انعكس الخيال على المراة % % 14(@)(@@) % وما ضربان قلبك غير درس % % لتلقين الخصال الفاضلات % % 15(@)(@@) % فأول درس تهذيب السجايا % % يكون عليك يا صدر الفتاة % % 16(@)(@@) % فكيف نظن بالأبناء خيرا % اذا نشأوا بحضن الجاهلات % % 17(@)(@@) % وهل يرجى لأطفال كمال % % اذا ارتضعوا ثدي الناقصات % % 18(@)(@@) % فما للأمهات جهلن حتى % % أتين بكل طياش الحصاة % % 19(@)(@@) % حنون على الرضيع بغير علم % % فضاع حنو تلك المرضعات % % 20(@)(@@) % أأم المؤمنين إليك نشكو % % مصيبتنا بجهل المؤمنات % % PageV01P072 21(@)(@@) % فتلك مصيبة يا أم منها(@)(@@) % نكاد نغص بالماء الفرات ) % 22(@)(@@) % تخذنا بعدك العادات دينا % فأشقى المسلمون المسلمات % % 23(@)(@@) % فقد سلكوا بهن سبيل خسر % وصدوهن عن سبل الحياة % % 24(@)(@@) % بحيث لزمن قعر البيت حتى % % نزلن به بمنزلة الأداة % % 25(@)(@@) % وعدوهن اضعف من ذباب % % بلا جنح وأهون من شذاة 
ms23	 % % 26(@)(@@) % وقالوا شرعة الاسلام تقضي % % بتفضيل ( الذين على اللواتي ) % 27(@)(@@) % وقالوا إن معنى العلم شيء % % تضيق به الصدور الغانيات % % 28(@)(@@) % وقالوا الجاهلات أعف نفسا % عن الفحشا من المتعلمات % % 29(@)(@@) % لقد كذبوا على الاسلام كذبا % تزول الشم منه مزلزلات % % 30(@)(@@) % اليس العلم في الاسلام فرضا % على ابنائه وعلى البنات % % PageV01P073 31(@)(@@) % وكانت أمنا في العلم بحرا % تحل لسائليها المشكلات % % 32(@)(@@) % وعلمها النبي اجل علم % فكانت من اجل العالمات % % 33(@)(@@) % لذا قال ارجعوا أبدا إليها % % بثلثي دينكم ذي البينات % % 34(@)(@@) % وكان العلم تلقينا فأمسى % % يحصل بانتياب المدرسات % % 35(@)(@@) % وبالتقرير من كتب ضخام % % وبالقلم الممد من الدواة % % 36(@)(@@) % ألم نر في الحسان الغيد قبلا % أوانس كاتبات شاعرات % % 37(@)(@@) % وقد كانت نساء القوم قدما % يرحن إلى الحروب مع الغزاة % % 38(@)(@@) % يكن لهم على الأعداء عونا % % ويضمدن الجروح الداميات % % 39(@)(@@) % وكم منهن من أسرت وذاقت % % عذاب الهون في أسر العداة % % 40(@)(@@) % فما ذا اليوم ضر لو التفتنا % % إلى اسلافنا بعض التفات % % PageV01P074 41(@)(@@) % فهم ساروا بنهج هدى وسرنا % % بمنهاج التفرق والشتات % % 42(@)(@@) % نرى جهل الفتاة لها عفافا % كأن الجهل حصن للفتاة % % 43(@)(@@) % ونحتقر الحلائل لا لجرم % فنؤذيهن انواع الاذاة % 44(@)(@@) % ونلزمهن قعر البيت قهرا % % ونحسبهن فيه من الهنات % % 45(@)(@@) % لئن وأدوا البنات فقد قبرنا % % جميع نسائنا قبل الممات % % 46(@)(@@) % حجبناهن عن طلب المعالي % % فعشن بجهلهن مهتلكات % % 47(@)(@@) % ولو عدمت طباع القوم لؤما % % لما غدت النساء محجبات % % 48(@)(@@) % وتهذيب الرجال أجل شرط % % لجعل نسائهم متهذبات % % 49(@)(@@) % وما ضر العفيفة كشف وجه % % بدا بين الأعفاء الأباة % % 50(@)(@@) % فدى لخلائق الأعراب نفسي % % وإن وصفوا لدينا بالجفاة % % PageV01P075 51(@)(@@) % فكم برزت بحيهم الغواني % % حواسر غير ما متريبات % % 52(@)(@@) % وكم خشف بمربعهم وظبي % % يمر مع الجداية والمهاة % % PageV01P076 البحر : وافر تام 1(@)(@@) % قضى والليل معتكر بهيم % ولا اهل لديه حميم % 2(@)(@@) % قضى في غير موطنه قتيلا % % تمج دم الحياة به الكلوم % % 3(@)(@@) % قضى من غير باكية وباك % % ومن يبكي إذا قتل اليتيم % % 4(@)(@@) % قضى غض الشبيبة وهو عف % مطهرة مآزره كريم % % 5(@)(@@) % سقاه من 
ms24	 الردى كأسا دهاقا % % عفاف النفس والعرض السليم % % 6(@)(@@) % تجرعها على طرب ولكن % % بكف اليتم ليس له نديم % % 7(@)(@@) % على حين الربابة في نواح % % يساجلها به العود الرخيم % % 8(@)(@@) % بحيث رقائق الألحان كانت % % بها الاشجان طافية تعوم % % 9(@)(@@) % كأن ترنم الأوتار نعي % % وصمت السامعين لها وجوم % % 10(@)(@@) % فجاء الموت ملتعفا بخزي % % وملء إهابه سفه ولوم % PageV01P077 11(@)(@@) % فأطلق من مسدسه رصاصا % به في الرمى تنخرق الجسوم % % 12(@)(@@) % فخر إلى الجبين به ( نعيم % % كما انقضت من الشهب الرجوم % % 13(@)(@@) % فبان مودعا بعد ارتثاث % حياة لا تناط بها الوصوم % % 14(@)(@@) % لئن لم تبك من أسف عليه % % سفاهتنا بكت الحلوم % % 15(@)(@@) % ولو درت النجوم له مصابا % بكته على ترفعها النجوم % % 16(@)(@@) % عسى الشهباء تثأره فتبدي % % إلى الزوراء ما يبدي الخصيم % % 17(@)(@@) % ولم يقتله ' إبراهيم ' فيما % % ارى بل ان قاتله ' سليم ' % 18(@)(@@) % اليس سليم الملعون اغوى(@)(@@) % نعيما ) فهو شيطان رجيم % % 19(@)(@@) % وجاء به إلى بغداد حتى % % تخرمه بها قتل أليم % % PageV01P078 20(@)(@@) % سأبكيه ولم أعبأ بلاح % % وانديه وان سخط العموم % % 21(@)(@@) % ولما ان ثوى ناديت ارخ % % ثوى قتلا بلا مهل ( نعيم ) % PageV01P079 البحر : طويل 1(@)(@@) % اما آن ان يغشى البلاد سعودها % % ويذهب عن هذي النيام هجودها % % 2(@)(@@) % متى يتأتى في القلوب انتباهها % % وأعجب من ذا أنه يرعبونها % % 3(@)(@@) % اما اسد يحمي البلاد غضنفر % فقد عاث فيها بالمظالم سيدها % % 4(@)(@@) % برئت إلى الأحرار من شر أمة % % أسيرة حكام ثقال قيودها % % 5(@)(@@) % سقى الله أرضا أمحلت من أمانها % % وقد كان رواد الأمان ترودها % % 6(@)(@@) % جرى الجور منها في بلاد وسيعة % % فضاقت على الاحرار ذرعا حدودها % % 7(@)(@@) % عجبت لقوم يخضعون لدولة % يسومهم بالموبيقات عميدها % % 8(@)(@@) % واعجب من ذا انهم يرهبونها % % واموالها منهم ومنهم جنودها % % 9(@)(@@) % اذا وليت امر العباد طغاتها % % وساد على القة م السراة مسودها % % 10(@)(@@) % واصبح حر النفس في كل وجهو % يرد مهانا عن سبيل يريدها % % PageV01P080 11(@)(@@) % وصارت لئام الناس تغلو كرامها % % وعاب لبيدا في النشيد بليدها % % 12(@)(@@) % فما انت الا ايها الموت نعمة % يعز على اهل الحفاظ جحودها 
ms25	 % % 13(@)(@@) % ألا إنما حرية العيش غادة % % منى كل نفس ووصلها ووفودها % % 14(@)(@@) % يضىء دجنات الحياة جبينها % % وتبدو المعالي حيث أتلع جيدها % % 15(@)(@@) % لقد واصلت قوما وخلت وراءها % % اناسا تمنى الموت لولا وعودها % % 16(@)(@@) % وقد مرضت أرواحنا في انتظارها % % فما ضرها والهفتا لو قعودها % % 17(@)(@@) % بنى وطني مالي أراكم صبرتم % % على نوب أعيا الحصاة عديدها % % 18(@)(@@) % أما آدكم حمل الهوان فإنه % % اذا حملته الراسيات يؤودها % % 19(@)(@@) % فعدتم عن السعي المؤدي إلى العلى % % على حين يزري بالرجال قعودها % % 20(@)(@@) % ولم تأخذوا للأمر يوما عتاده % % فجاءت امور ساء فيكم عتيدها % % PageV01P081 21(@)(@@) % ألم تروا الأقوام بالسعي خلدت % % مآثر يسقصى الزمان خلودها % % 22(@)(@@) % وساروا كراما رافلين إلى العلى % % باثواب عز ليس يبلى جديدها % % 23(@)(@@) % قد استحوذت يا للخسار عليكم % % شياطين إنس صال منكم مريدها % % 24(@)(@@) % وما اتقدت نار الحمية منكم % لفقد اتحاد فاستطال خمودها % % 25(@)(@@) % ولولا اتحاد العنصرين لما غدا % % من النار يذكو لو علمتم وقودها % % 26(@)(@@) % إذا جاهل منكم مشى نحو سبة % % مشى جمعكم من غير قصد يريدها % % 27(@)(@@) % كأنكم المعزى تهاوين عندما % % نزا فنزت فوق الجبال عتودها % % 28(@)(@@) % وماثلة قد أهملتها رعاتها % % بمأسدة جاعت لعشر أسودها % % 29(@)(@@) % فباتت ولا راع يحامي مراحها % % فرائس بين الضاريات تبيدها % % 30(@)(@@) % بأضيع منكم حيث لا ذو شهامة % % يذب الرزايا عنكم ويذودها % % PageV01P082 31(@)(@@) % اتطمع هذي الناس ان تبلغ المنى % % ولم تور في يوم الصدام زنودها % % 32(@)(@@) % فهل لمعت في الجو شعلة بارق % وما ارتجست بين الغيوم رعودها % % 33(@)(@@) % وادخنة النيران لولا اشتعالها % % لما تم في هذا الفضلء صعودها % % 34(@)(@@) % ومن رام في سوق المعال تجارة % % فليس سوى بيض المساعي نقودها % % PageV01P083 البحر : وافر تام 1(@)(@@) % إلى كم انت تهتف بالنشيد % وقد أعياك إيقاظ الرقود % % 2(@)(@@) % فلست وان شددت عرى القصيد % % بمجد في نشيدك أو مفيد % 3(@)(@@) % لأن القوم في غي بعيد % % 4(@)(@@) % إذا أيقظتهم زادوا رقادا % % وإن أنهضتهم قعدوا وثادا % % 5(@)(@@) % فسبحان الذي خلق العبادا % % كأن القوم قد خلقوا جمادا % % 6(@)(@@) % وهل يخلو الجماد عن الجمود % % 7(@)(@@) % أطلت وكاد 
ms26	 يعييني الكلام % % ملاما دون وقعته الحسام % % 8(@)(@@) % فما انتبهوا ولا نفع الملام % % كأن القوم اطفال نيام % % 9(@)(@@) % نهز من الجهالة في مهود % % 10(@)(@@) % اليك اليك يا بغداد عني % % فإني لست منك ولست مني % % PageV01P084 11(@)(@@) % ولكني وان كبر التجني % % يعز على يا بغداد أني % % 12(@)(@@) % أراك على شفا هول شديد % % 13(@)(@@) % تتابعت الخطوب عليك تترى % % وبدل منك حلو العيش مر % 14(@)(@@) % فهلا تنجبين فتى أغرا % % أراك عقمت لا تلدين حرا % % 15(@)(@@) % ألا يا هالكين لكم أجيج % % 16(@)(@@) % اقام الجهل فيك له شهودا % % ليهلك فيه من عبث ويفدى % % 17(@)(@@) % متى تبدين منك له جحودا % % فهلا عدت ذاكرة عهودا % % 18(@)(@@) % بهن رشدت ايام الرشيد % % 19(@)(@@) % زمان نفوذ حكمك مستمر % زمان سحاب فيضك مستدر % 20(@)(@@) % زمان العلم أنت له مقر % زمان بناء عزك مشمخر % PageV01P085 21(@)(@@) % وبدر علاك في سعد السعود % % 22(@)(@@) % برحت الأوج ميلا للحضيض % % وضفت وكنت ذات على عريض % % 23(@)(@@) % وقد أصبحت في جسم مريض % % وكنت بأوجه العز بيض % % 24(@)(@@) % فهل هذي البلاد سوى ضياع % % 25(@)(@@) % ترقى العالمون وقد هبطنا % % وفي درك الهوان قد انحططنا % % 26(@)(@@) % وعن سنن الحضارة قد شحطنا % % فقطنا يا بني بغداد قطنا % % 27(@)(@@) % إلى كم نحن في عيش القرود % % 28(@)(@@) % إذن لنضوت جلباب الوجود % % بناء للعلوم بكل فن % % 29(@)(@@) % لماذا يا اسرى التأني % % أخذنا بالتقهقر والتدني % % 30(@)(@@) % وصرنا عاجزين عن الصعود % % PageV01P086 31(@)(@@) % مشوا في منهج جهلوه نهجا % يجوبون الفلا فجا ففجا % % 32(@)(@@) % إلى حيث السلامة لا ترجى % % فيا لهفي على الشبان تزجى % % 33(@)(@@) % على عبث إلى الموت المبي % % 34(@)(@@) % وكل مذ غذوا للبيت أما % % فودع أهله زوجا وأما % % 35(@)(@@) % وضم وليده بيد وشما % % بكى الوالد الوحيد عليه لما % % 36(@)(@@) % غدا يبكي على الولد الوحيد % % 37(@)(@@) % فقال موجها لوما إلينا % % فقال ودمعه بادي الرشاش % 38(@)(@@) % وكلتكم إلى الرب الودود % % 39(@)(@@) % عساكر قد قضوا عريا وجوعا % % بحيث الأرض تبتلع الجموعا % % 40(@)(@@) % إلى أن صار أغناهم ربوعا % لفرط الجوع مرتضيا قنوعا % % PageV01P087 41(@)(@@) % بقد لو اصاب من الجلود % % 42(@)(@@) % هناك قضوا وما فتحوا 
ms27	 بلادا % % هناك بأسرهم نفذوا نفادا % % 43(@)(@@) % فتبرز منه في وضع جديد % هناك لروعهم فقدوا الرقادا % % 44(@)(@@) % أناديهم ولي شجن مهيج % % وأذكرهم فينبعث النشيج % % 45(@)(@@) % ودمع محاجري بدم مزيج % % 46(@)(@@) % ذكا بحشاي محتدم الوقود % % 47(@)(@@) % سكنا من جهالتنا بقاعا % % يجور بها المؤمر ما استطاعا % % 48(@)(@@) % فكدنا أن نموت بها ارتياعا % % وهبنا أمة هلكت ضياعا % % 49(@)(@@) % تولى امرها عبد الحميد % % 50(@)(@@) % أياتحرية الصحف أرحمينا % % فانا نزل لك عاشقينا % % PageV01P088 51(@)(@@) % متى تصلين كيما تطلقينا % % عدينا في وصالك وامطلينا % % 52(@)(@@) % فانا منك نقنع بالوعود % % 53(@)(@@) % فانت الروح تشفين الجروحا % % يحرج فقدك البلد الفسحا % % 54(@)(@@) % وليس لبلدة لم تحو روحا % % وإن حوت القصور أو الصروحا % % 55(@)(@@) % حياة تستفاد لمستفيد % % 56(@)(@@) % قد التفعوا بأسال بوال % % لسلطان تجبر واستبدا % % 57(@)(@@) % تعدى في الامور وما استعدا % % ألا يا أيها الملك المفدى % % 59(@)(@@) % أنم عن أن تسوس الملك طرفا % % أقم ما تشتهي زمرا وعزفا % % 60(@)(@@) % أطل نكر الرعية خل عرفا % % سم البلدان مهما شئت خسفا % % 61(@)(@@) % وأرسل من تشاء إلى اللحود % % PageV01P089 63(@)(@@) % ملكت أو العباد سوى عبيد % % 64(@)(@@) % تنعم في قصورك غير دار % أعاش الناس أم هم في بوار % % 65(@)(@@) % فإنك لن تطالب باعتذار % % وهب ان الممالك في دمار % % 66(@)(@@) % أليس بناء ( يلدز ) بالشيد % % 67(@)(@@) % جميع ملوك هذى الأرض فلك % % وأنت البحر فيك ندى وهلك % 68(@)(@@) % فأنى يبلغوك وذاك إفك % لئن وهبوا النقود فانت ملك % 69(@)(@@) % وهوب للبلاد وللنقود % % PageV01P090 البحر : طويل 1(@)(@@) % أطل صباح العيد في الشرق يسمع % % ضجيجا به الافراح تمضي وترجع % 2(@)(@@) % صباح به تبدى المسرة شمسها % % وليس لها إلا التوهم مطلع % 3(@)(@@) % صباح به يختال بالوشى ذو الغنى % % ويعوز ذا الإعدام طمر مرقع % % 4(@)(@@) % صباح به يكسو الغني وليده % % ثيابا لها يبكى اليتيم المضيع % % 5(@)(@@) % صباح به تغدو الحلائل بالحلى % % وترفض من عين الأرامل أدمع % % 6(@)(@@) % الاليت يوم العيد لا كان انه % % يجدد للمحزون حزنا فيجزع % % 7(@)(@@) % يرينا سرورا بين حزن وانما % % به الحزن جد والسرور تصنع % % 8(@)(@@) % فمن بؤساء الناس في يوم عيدهم % % نحوس بها 
ms28	 وجه المسرة اسفع % % 9(@)(@@) % قد ابيض وجه العيد لكن بؤسهم % % رمى نكتا سودا به فهو ابقع % % 10(@)(@@) % خرجت بعيد النحر صبحا فلاح لي % % مسارح للأضداد فيهن مرتع % % PageV01P091 11(@)(@@) % خرجت وقرص الشمس قد ذر شارقا % % ترى النور سيالا به يتدفع % % 12(@)(@@) % هي الشمس خود قد أطلت مصيخة % % على افق العلى تتطلع % % 13(@)(@@) % كأن تفاريق الأشعة حولها % % على الافق مرخاة ذوائب اربع % % 14(@)(@@) % ولما بدت حمراء أيقنت أنها % % بها خجل مما تراه وتسمع % % 15(@)(@@) % فرحت وراحت ترسل النور ساطعا % وسرت وسارت في العلى تترفع % % 16(@)(@@) % بحيث تسير الناس كل لوجهة % % فهذا على رسل وذلك مسرع % % 17(@)(@@) % وبعض له أنف أشم من الغنى % % وبعض له أنف من الفقر أجدع % % 18(@)(@@) % وفي الحي مذمار لمشجي نعيره % % غدا الطبل في دردابه يتقعقع % % 19(@)(@@) % فجئت وجوف الطبل يرغو وحوله % % شباب وولدان عليه تجمعوا % % 20(@)(@@) % ترى ميعة الاطراب والطبل هادر % تفيض وفي أسماعهم تتميع % % PageV01P092 21(@)(@@) % فقد كانت الافراح تفتح بابها % % لمن كان حول الطبل والطبل يقرع % % 22(@)(@@) % وقعت اجيل الطرف فيهم فراعني % % هناك صبى بينهم مترعرع % % 23(@)(@@) % صبى صبيح الوجه أسمر شاحب % % نحيف المباني أدعج العين أنزع % % 24(@)(@@) % يزين حجاجيه اتساع جبينه % % وفي عينيه برق الفطانة يلمع % % 25(@)(@@) % عليه دريس يعصر اليتم ردنه % % فيقطر فقر من حواشيه مدقع % % 26(@)(@@) % يليح بوجه للكآبة فوقه % غبار به هبت من اليتم زعزع % % 27(@)(@@) % على كثر قرع الطبل تلقاه واجما % كأن لم يكن للطبل ثمة مقرع % % 28(@)(@@) % كأن هدير الطبل يقرع سمعه % % فلم يلف رجعا للجواب فيرجع % % 29(@)(@@) % يرد ابتسام الواقفين بحسرة % % تكاد لها احشاؤه تتقطع % % 30(@)(@@) % ويرسل من عينيه نظرة مجهش % % وما هو بالباكي ولا العين تدمع % % PageV01P093 31(@)(@@) % له رجفة تنتابه وهو واقف % % على جانب والطقسبالبرد يلسع % % 32(@)(@@) % يرى حوله الكاسين من حيث لم يجد % % على البرد من برد به يتلفع % % 33(@)(@@) % فكان ابتسام القوم كالثلج قارسا % لدى حسرات منه كالجمر تلذع % % 34(@)(@@) % فلما شجاني حاله وافزني % % وقفت وكلي مجزع وتوجع % % 35(@)(@@) % ورحت أعاطيه الحنان بنظرة % كما راح يرنو العابد 
ms29	 المتخشع % % 36(@)(@@) % وافتح طرفي مشبعا بتعطف % % فيرتد طرفي وهو بالحزن مشبع % % 37(@)(@@) % هناك على مهل تقدمت نحوه % % وقلت بلطف قول من يتضرع % % 38(@)(@@) % أيابن أخي من أنت ما اسمك ما الذي % % عراك فلم تفرح فهل انت موجع % % 39(@)(@@) % فهب أمامي من رقاد وجومه % % كما هب مرعوب الجنان المهجع % % 40(@)(@@) % وأعرض عني بعد نظرة يائس % % وراح ولم ينبس إلى حيث يهرع % % PageV01P094 41(@)(@@) % فعقبته مستطلعا طلع أمره % % على البعد اقفو الاثر منه واتبع % % 42(@)(@@) % وبيناه ماش حيث قد رحت خلفه % أدب دبيب الشيخ طورا وأسرع % % 43(@)(@@) % لمحت على بعد إشارة صاحب % % ينادي أن أرجع وهو بالثوب ملمع % % 44(@)(@@) % فاومأت أن ذكرته موعدا لنا % % وقلت له اذهب وانتظر فسأرجع % % 45(@)(@@) % وعدت فابصرت الصبي معرجا % ليدخل دارا بابها متضعضع % % 46(@)(@@) % فلما اتيت الدار بعد دخوله % % وقمت حيال الباب والباب مرجع % % 47(@)(@@) % دنوت إلى باب الدويرة مطرقا % وأصغيت لا عن ريبة أتسمع % % 48(@)(@@) % سمعت بكاء ذا نشيج مردد % % تكاد له صم الصفا تتصدع % % 48(@)(@@) % فحرت وعيني ترمق الباب خلسة % % وللنفس في كشف الحقيقة مطمع % % 49(@)(@@) % أأرجع ادراجى ولم اك عارفا % جلية هذا الامر أم كيف اصنع % % PageV01P095 50(@)(@@) % فمرت عجوز في الطريق وخلفها % % فتاة يغشيها إزار وبرقع % % 51(@)(@@) % تعرضتها مستوقفا وسألنها % % عن الإسم ، قالت إنني أنا بوزع % % 52(@)(@@) % فأدنيتها مني وقلت لها اسمعي % % حنانيك ما هذا الحنين المرجع % % 53(@)(@@) % فقالت وانت انة عن تنهد % وفي الوجه منها للتعجب موضع % % 54(@)(@@) % أيا ابني ما يعنيك من نوح أيم % % لها من رزايا الدهر قلب مفجع % % 55(@)(@@) % فقلت لها اني امرؤ لا يهمني % % سوى من له قلب كقلبي مروع % % 56(@)(@@) % واني وان جارت على مواطني % % فؤادي على قطانهن موزع % % 57(@)(@@) % أبوزع مني عمرك الله بالذي % % سألت فقد كادت حشاي تمزع % % 58(@)(@@) % فقالت أعن هذي التي طال نحبها % % سألت فعندي شرح ما تتوقع % % 59(@)(@@) % ألا إنها سلمى تعيسة معشر % % من الصيد أقوت دراهم فهي بلقع % % PageV01P096 60(@)(@@) % وصارعهم بالموت حتى أبادهم % % من الدهر عجار شديد مصرع % % 61(@)(@@) % فلم يبق الا زوجها 
ms30	 وشقيقها % % خليل واما الآخرون فودعوا % % 62(@)(@@) % ولم يلبث المقدور ان غال زوجها % % سعيدا فأودى وهي إذ ذاك مرضع % % 63(@)(@@) % فربي ابنها سعدا وقام بأمره % % أخوها إلى أن كاد يقوى ويضلع % % 64(@)(@@) % فاذهب عنه الخال دهر غشمشم % بما يوجع الايتام مغرى ومولع % % 65(@)(@@) % جرت تنه منها خاله انطوى % % بقلب رئيس الشرطة الحقد أجمع % % 66(@)(@@) % فزج به في السجن بعد تجرم % % عليه بجرم ما له فيه مصنع % % 67(@)(@@) % عزاه إلى ايقاعه موقعا به % % وما هو يا ابن القوم للجرم موقع % % 68(@)(@@) % ولكن غدر الحاقدين رمى به % % إلى السجن فهو اليوم في السجن مودع % % 69(@)(@@) % فحق لسلمى أن تنوح فإنها % % من العيش سما ناقعا تتجرع % % PageV01P097 70(@)(@@) % فلا غرو من أم اليتيم إذا غدت % % ضحى العيد يبكيها اليتيم المضيع % % 71(@)(@@) % فعدت وقلبي جازع متوجع % % وقلت وعيني ثرة الدمع تهمع % % 72(@)(@@) % الاليت يوم العيد لا كان انه % % يجدد للمحزون حزنا فيجزع % % 73(@)(@@) % وجئت إلى ميعادنا عند صاحبي % % وقد ضمه والصحب ناد ومجمع % % 74(@)(@@) % فأطلعتهم طلع اليتيم فأففوا % % وخبرتهم حال السجين فرجعوا % % 75(@)(@@) % فقلت دعوا التأفيف فالعار لاصق % % بكم واتركوا الترجيع فالأمر أفظع % % 76(@)(@@) % ألسنا الألى كانت قديما بلادنا % % بأرجائها نور العدالة يسطع % % 77(@)(@@) % فما بالنا نستقبل الضيم بالرضا % % ونعنوا لحكم الجائرين ونخضع % % 78(@)(@@) % شربنا حميم الذل ملء بطوننا % % ولا نحن نشكوه ولا نحن نيجع % % 79(@)(@@) % فلو أن عير الحي يشرب مثلنا % % هوانا لامسى قالسا يتهوع % % PageV01P098 80(@)(@@) % نهوضا إلى العز الصراح بعزمة % % تخر لمرماها الطغاة وتركع % % 81(@)(@@) % الا فاكتبوا صك النهوض إلى العلى % % فإني على موتي به لموقع % % PageV01P099 البحر : متقارب تام 1(@)(@@) % تيقظ فما انت بالخالد % ولا حادث الدهر بالراقد % 2(@)(@@) % فخلد بسعيك مجدا يدوم % دوام النجوم بلا جاحد % % 3(@)(@@) % وأبق لك الذكر بالصالحات % % وخل النزوع إلى الفاسد % % 4(@)(@@) % ورد ما يناديك عنه الصدور % % ألا در درك من وارد % % 5(@)(@@) % وسر بين قومك في سيرة % % تميت الحقود من الحاقد % % 6(@)(@@) % فان فتى الدهر من يدعي % % فتأتي اعاديه بالشاهد % % 7(@)(@@) % ولا تك مرمى بداء السكون % % فتصبح كالحجر 
ms31	 الجامد % % 8(@)(@@) % وكن رجلا في العلى حولا % % تفنن في سيره الراشد % % 9(@)(@@) % اذا اطردت حركات الحياة % % ومرت على نسق واحد % % 10(@)(@@) % ولم تتنوع افانينها % % ودامت بوجه لها بارد % % PageV01P100 11(@)(@@) % ولم تتجدد لها شملة % % من السعي في الشرف الخالد % % 12(@)(@@) % فما هي إلا حياة السوام % % تجول من العيش في نافذ % % 13(@)(@@) % وما يرتجي من حياة امرىء % % كماء على سبخة راكد % % 14(@)(@@) % وليس له في غضون الحياة % % سوى النفس النازل الصاعد % % 15(@)(@@) % يغض على الجهل اجفانه % % ويرضى من العيش بالكاسد % % 16(@)(@@) % فذاك هو الميت في قومه % % وان كان في المجلس الحاشد % % 17(@)(@@) % وما المرء إلا فتى يغتدي % % إلى العلم في شرك صائد % % 18(@)(@@) % سعى للمعارف فاحتازها % % وصاد الانيس مع الآبد % % 19(@)(@@) % وطالع أوجه أقمارها % % يعين بصير لها ناقد % % 20(@)(@@) % فأبدى الحقائق من طيها % % وألقى القيود على الشارد % % PageV01P101 21(@)(@@) % اذا هو اصبح نادى البدار % % وشمر للسعي عن ساعد % % 22(@)(@@) % فكان المجلى في شأوه % % بعزم للسعى عن ساعد % % 23(@)(@@) % وإن بات بات على يقظة % بطرف لنجم العلى راصد % % 24(@)(@@) % واحدث مجدا طريفا له % % واضرب عن مجده التالد % % 25(@)(@@) % وما الحمق الا هو الاتكال % على شرف جاء من والد % % 26(@)(@@) % فذاك هو الحي حي الفخار % وان لحدته يد اللاحد % % PageV01P102 البحر : طويل 1(@)(@@) % أيا سائلا عنا ببغداد إننا % % بهائم في بغداد اعوزها النبت % % 2(@)(@@) % علت أمة الغرب السماء وأشرقت % علينا فظلنا ننظر القوم من تحت % % 3(@)(@@) % وهم ركضوا خيل المساعي وقد كبا % % بنا فرس عن مقنب السعي منبت % % 4(@)(@@) % فنحن اناس لم نزل في بطانة % % كأنا يهود كل ايامنا سبت % % 5(@)(@@) % خضعنا لحكام تجور وقد حلا % % بافواهها من مالنا مأكل سحت % % 6(@)(@@) % وكم قامرتنا ساسة الامر خدعة % فتم علينا بالخداع لها الدست % 7(@)(@@) % لماذا نخاف الموت جبنا فلم نقم % % إلى الدب عنا من أمور هي الموت % % 8(@)(@@) % اذا كنت لاالقى من الموت موئلا % فهل نافعي أن خفته أو تهيبت % 9(@)(@@) % وللموت خير من حياة تشوبها % % شوائب منها الظلم والذل والمقت % PageV01P103 البحر : كامل تام 1(@)(@@) % يا عدل 
ms32	 طال الانتظار فعجل % يا عدل ضاق الصبر عنك فاقبل % % 2(@)(@@) % يا عدل ليس على سواك معول % % هلا عطفت عن الصريخ المعول % % 3(@)(@@) % كيف القرار على امور حكومة % % حادث بهن عن الصريخ المعول % % 4(@)(@@) % في الملك تفعل من فظائع جورها % % ما لم تقل ، وتقول ما لم تفعل % % 5(@)(@@) % ملأت قراطيس تباع وتشترى % % فغدت تفوض للغني الأجهل % % 6(@)(@@) % تعطى مؤجلة لمن يبتاعها % % ومتى انقضى الأجل المسمى يعزل % % 7(@)(@@) % فيروح يشري ثانيا وبما ارتشى % % قد عاد من اهل الثراء الاجزل % % 8(@)(@@) % فيظل في دار الخلافة راشيا % % حتى يعود بمنصب كالاول % % 9(@)(@@) % سوق تباع بها المراتب سميت % % دار الخلافة عند من لم يعقل % % 10(@)(@@) % أبت السياسة أن تدوم حكومة % % خصت برأي مقدس لم يسأل % % PageV01P104 11(@)(@@) % مثل الحكومة تستبد بحكمها % % مثل البناء على نقا متهيل % % 12(@)(@@) % يا أمة رقدت فطال رقادها % % هبي وفي امر الملوك تأملي % % 13(@)(@@) % أيكون ظل الله تارك حكمه ال % % منصوص في آي الكتاب المنزل % % 14(@)(@@) % أم هل يكون خليفة لرسوله % % من حاد عن هدي النبي المرسل % % 15(@)(@@) % كم جاء من ملك دهاك بجوره % % ولواك عن قصد السبيل الأفضل % % 16(@)(@@) % يقضي هواه بما يسومك في الورى % % خسفا وينقم منك ان لم تقبلي % % 17(@)(@@) % ويروم صبرك وهو يسقيك الردى % % ويريد شكرك وهو لم يتفضل % % 18(@)(@@) % وقد استكنت له وأنت مهانة % % حتى صبرت لفتكه المستأصل % % 19(@)(@@) % بات السعيد وبت فيه شقية % % تستخدمين لغية المسترسل % % 20(@)(@@) % تلك الحماقة لا حماقة مثلها % % PageV01P105 21(@)(@@) % % حمقا هو من صحيح تعقل % % 22(@)(@@) % ان الحكومة وهي جمهورية % % كشفت عماية قلب كل مضلل % % 23(@)(@@) % سارت إلى أوج العباد بسيرة % % أبدت لهم حمق الزمان الأول % % 24(@)(@@) % فسموا إلى أوج العلآء ونحن لم % % نبرح نسوج إلى الحضيض الأسفل % % 25(@)(@@) % حتى استقلوا كالكواكب فوقنا % % تجلو الظلام بنورها المتهلل % % 26(@)(@@) % وعلوا بحيث إذا شخصنا نحوهم % % من تحتهم ضحكوا علينا من عل % % 27(@)(@@) % لبسوا ثياب فخارهم موشية % بالعز وهي من الطراز الأكمل % % 28(@)(@@) % نالوا وصال منى النفوس وانها % % حرية العيش الرغيد المخضل % % 29(@)(@@) % حتى أقيم مجسما 
ms33	 تمثالها % % بين الشعوب على بناء هيكل % % 30(@)(@@) % تمثال ناعمة الشمائل وجهها % % تزداد نورا منه عين المجتلى % % PageV01P106 31(@)(@@) % أفبعد هذا يا سراة مواطني % % نرضى ونقنع بالمعاش الأرذل % % 32(@)(@@) % الغوث من هذا الجمود فإنه % % تالله أهون منه صم الجندل % % 33(@)(@@) % قد أبحرت شم الجبال وأجبلت % % لجج البحار ونحن لم نتبدل % % 34(@)(@@) % ما ضركم لو تسمعون لناصح % لم يأت من نسج الكلام بهلهل % % 35(@)(@@) % حتام نبقي لعبة لحكومة % % دامت تجرعنا نقيع الحنظل % % 36(@)(@@) % تنحوا بنا طرق البوار تحيفا % % وتسومنا سوء العذاب الأهول % % 37(@)(@@) % هذا ونحن مجدلون تجاهها % % كالفار مرتعدا تجاه الخيطل % % 38(@)(@@) % ما بالنا منها نخاف القتال ان % % قمنا اما سنموت ان لم نقتل ؟ % 39(@)(@@) % يا عاذلا فيما نفثت من الرقى % % وعزمت فيه على الصريع المهمل % % 40(@)(@@) % انظر لصرعة من رقيب وطولها % % فإذا نظرت فعند ذلك فاعذل % % PageV01P107 البحر : كامل تام 1(@)(@@) % بغداد حسبك رقدة وسبات % % أو ما تمضك هذه النكبات % % 2(@)(@@) % ولعت بك الاحداث حتى اصبحت % % ادواء خطبك ما لهن أساة % % 3(@)(@@) % قلب الزمان اليك ظهر مجنه % % أفكان عندك للزمان ترات % % 4(@)(@@) % ومن العجائب أن يمسك ضره % % من حيث ينفع لو رعتك رعاة % % 5(@)(@@) % إذ من ديالة والفرات ودجلة % % أمست تحل بالهلك الكربات % % 6(@)(@@) % ان الحياة لفي ثلاثة انهر % % تجري وأرضك حولهن موات % % 7(@)(@@) % قد ضل اهلك رشدهم وهل اهتدى % % قوم أجاهلهم هم السروات % % 8(@)(@@) % قوم أضاعوا مجدهم وتفرقوا % % فتراهم جمعا وهم أشتات % % 9(@)(@@) % لقد استهانوا العيش حتى أهملوا % % سعيا مغبة تركه الإعنات % % 10(@)(@@) % يا صابرين على الأمور قسومهم % % خسفا على حين الرجال أباة % % PageV01P108 11(@)(@@) % لا تهملوا الضرر اليسير فانه % % ان دام ضاقت دونه الفلوات % % 12(@)(@@) % فالنار تلهب من سقوط شرارة % والماء تجمع سيله القطران % % 13(@)(@@) % لا تستنيموا للزمان توكلا % فالدهر نزاء له وثبات % % 14(@)(@@) % فتناطحا وتوالت الهجمات % % فوضى وفيكم غفلة وأناة % % 15(@)(@@) % تالله إن فعالكم بخلافه % % نزل الكتاب وجاءت الآيات % % 16(@)(@@) % أفتزعمون بان ترك السعي في % % وترف فوقك للهدى رايات % % 17(@)(@@) % إن صح نقلكم بذاك فبينوا % % أو قام عندكم الدليل فهاتوا % % 18 
ms34	(@)(@@) % لم تلق عندكم الحياة كرامة % في حالة فكأنكم اموات % % 19(@)(@@) % شقيت بكم لما شقيتم ارضكم % % فلها بكم ولكم بها غمرات % % 20(@)(@@) % وجهلتم النهج السوي إلى العلى % % فترادفت منكم بها العثرات % % PageV01P109 21(@)(@@) % بالعلم تنتظم البلاد فإنه % % لرقي كل مدينة مرقاة % % 22(@)(@@) % ان البلاد اذا تخاذل اهلها % % كانت منافعها هي الآفات % % 23(@)(@@) % تلك الرصافة والمياه تحفها % % والكوخ قد ماجت به الازمات % % 24(@)(@@) % سالت مياه الواديين جوارفا % % فطفحن والاسداد مؤتكلات % % 25(@)(@@) % فتهاجم الماء إن من صفتيهما % % فتناطحها وتوالت الهجمات % % 26(@)(@@) % حتى إذا اتصل الفرات بدجلة % % وتساوت الوهدات والربوات % % 27(@)(@@) % زحفت جيوش السيل حتى أصبحت % % بالكرخ نازلة لها ضوضاة % % 28(@)(@@) % فسقت بيوت الكرخ شر مقيء % % منها فقاءت اهلها الابيات % % 29(@)(@@) % واستنقعت فيها المياه فطحلبت % % بالمكث ترغو تحتها الحمآت % % 30(@)(@@) % حتى استحال الكرخ مشهد أبؤس % % تبكي به الفتيان والفتيات % % PageV01P110 31(@)(@@) % طرقاته مسدودة ودياره % % مهدومة وعراصه قذرات % % 32(@)(@@) % ياكرخ عز على المرؤة انه % % لجج المياه عليك مزدحمات % % 33(@)(@@) % فلئن أماتتك السيول فإنما % % أمواجهن عليك ملتطمات % % 34(@)(@@) % من مبلغ المنصور عن بغداده % % خبرا تفيض لمثله العبرات % % 35(@)(@@) % مست تناديه وتندب اربعا % طمست رسوم جمالها الهبوات % % 36(@)(@@) % وتقول يالأبي الخلائف لو ترى % % اركان مجدي وهي منهدمات % % 37(@)(@@) % لغدوت تنكرني وتبرح قائلا % بتعجب ما هذه الخربات % % 38(@)(@@) % اين البروج بنيتهن مشيدة % اين القصور علت بها الشرفات % % 39(@)(@@) % اين الجنان بحيث تجري تحتها % % الانهار يانعة بها الثمرات % % 40(@)(@@) % أترى أبو الامناء يعلم بعده % % بغداد كيف تروعها النكبات % % PageV01P111 41(@)(@@) % لا دجلة يا للرزية دجلة % % بعد الرشيد ولا الفرات فرات % % 42(@)(@@) % كان الفرات يمد دجلة ماؤه % % بجداول تسقى بها الجنات % % 43(@)(@@) % اذ بين دجلة والفرات مصانع % % تفتر عن شنب بها السنوات % % 44(@)(@@) % يا نهر عيسى أين منك موارد % % عذبت واين رياضك الخضلات % % 45(@)(@@) % ماذا دهى نهر الرفيل من البلى % % حيث المجاري منه مندرسات % % 46(@)(@@) % اذ قصر عيسى كان عند مصبه % % وعليه منه أطلت الغرفات % % 47(@)(@@) % أم اين بركة زلزل وزلالها % % السلسال تسرح حوله الظبيات % % 48(@)(@@) % تا نهر طابق لا عدمتك منهلا % اين 
ms35	 الصراة تحفها الروضات % % 49(@)(@@) % أم اين كرخايا تمد مياهه % % نهر الدجاج فتكثر الغلات % % 50(@)(@@) % أم اين نهر الملك حين تسلسلت % % فيه المياه وهن مطردات % % PageV01P112 51(@)(@@) % قد كان تزدرع الحبوب بارضه % % فتسح فيه بفيضها البركات % % 52(@)(@@) % أم اين نهر بطاطيا تأتيه من % % نهر الدجيل مياهه المجراه % % 53(@)(@@) % وله فروع أصلهن لشارع ال % الكبش المجاري منه منتهيات % % 54(@)(@@) % تنمو الزروع بسقيه فغلاله % % كل العراق ببعضها يقتات % % 55(@)(@@) % لهفي على نهر المعلى إذ غدت % % لا تستبين جنانه النضرات % % 56(@)(@@) % نهر هو الفردوس تدخل منه في % % قصر الخلافة شعبة وقناة % % 57(@)(@@) % كالسيف منصلتا تضاحك وجهه % % الانوار وهي عليه ملتمعات % % 58(@)(@@) % إذ نهر بين عند كلواذي به % % ملد الغصون تهزها النسمات % % 59(@)(@@) % وبقربه من نهر بوق دارة % % تنفي الهموم مروجها الخضرات % % 60(@)(@@) % يا قصر باب التبر كنت مقرنا % % والنفي يصدر منك والاثبات % % PageV01P113 61(@)(@@) % أيام تطلعك العدالة شمسها % % وترف فوقك للهدى رابات % % 62(@)(@@) % أيام تبصرك الحضارة في العلى % % بدرا عليك من الثنا هالات % % 63(@)(@@) % أيام تنشدك العلوم نشيدها % % فتعود منك على العلوم صلات % % 64(@)(@@) % أيام تقصدك الأفاضل بالرجا % % فتفيض منك لهم جدا وهبات % % 65(@)(@@) % أيام يأتيك الشكى بأمره % فيروح عنك وما لديه شكاة % % 66(@)(@@) % تمضي الشهور عليك وهي انيسة % % وتمر باسمة بك الساعات % % 67(@)(@@) % ماذا دهاك من الهوان فأصبحت % % اثار عزك وهي منطمسات % % 68(@)(@@) % قد ضيعت بغداد سابق عزها % % وغدت تجيش بصدرها الحسرات % % 69(@)(@@) % كم قد سقاها السيل من أنهارها % % ضرا وهن منافع وحياة % % 70(@)(@@) % واليوم قلت بجانبيها ارخوا % % دفق السيول فماجت الازمات % % PageV01P114 البحر : بسيط تام 1(@)(@@) % كل ابن ادم مقهور بعادات % % لهن ينقاد في كل الإرادات % % 2(@)(@@) % يجرى عليهن فيما يبتغيه ولا % % ينفك عنهن حتى في الملذات % % 3(@)(@@) % قد يستلذ الفتى مااعتاد من ضرر % % حتى يرى في تعاطيه المسرات % % 4(@)(@@) % عادات كل امرئ تأبى عليه بان % % تكون حاجاته إلا كثيرات % % 5(@)(@@) % أني لفى أسر حاجاتي ومن عجب % % تعودي ما به تزداد حاجاتي % % 6(@)(@@) % كل الحياة افتقار لا يفارقها % % حتى تنال غناها بالمنيات % % 7(@)(@@) % ولو لم 
ms36	 تكن هذا العادات قاهرة % % لما أسيغت بحال بنت حانات % % 8(@)(@@) % ولا رأيت سكارات يدخنها % % قوم بوقت انفراد واجتماعات % % 9(@)(@@) % ان الدخان لثان في البلاء اذا % % ما عدت الخمر اولى في البليات % % 10(@)(@@) % ورب بيضاء قيد الأصبع احترقت % % في الكف وهي احتراق في الحشاشات % % PageV01P115 11(@)(@@) % ان مر بين شفاه القوم اسودها % % ألقى اصفرارا على بيض الثنيات % % 12(@)(@@) % وليتها كان هذا حظ شاربها % % ولو أتته بحد المشرقيات % % 13(@)(@@) % عوائد عمت الدنيا مصائبها % % وانما انا في تلك المصيبات % % 14(@)(@@) % إن كلفتني السكارى شرب خمرتهم % % شربت لكن دخانا من سكاراتي % % 15(@)(@@) % وأخترت أهون شر بالدخان وإن % % احرقت ثوبي منه بالشرارات % % 16(@)(@@) % وقلت يا قوم تكفيكم مشاركتي % % إياكم في التذاذ بالمضرات % % 17(@)(@@) % إني لأمتص جمرا لف في ورق % % إذ تشربون لهيبا ملء كاسات % % 18(@)(@@) % كلاهما حمق يفتر عن ضرر % % يسم من دمنا تلك الكريات % % 19(@)(@@) % حسبي من الحمق المعتاد أهونه % % إن كان لابد من هذي الحماقات % % 20(@)(@@) % يا من يدخن مثلي كل آونة % % لمني ألمك ولا ترض اعتذاراتي % % PageV01P116 21(@)(@@) % إن العوائد كالأغلال تجمعنا % % على قلوب لنا منهن أشتات % % 22(@)(@@) % مقيدين بها نمشي على حذر % % من العيون فنأتي بالمداجاة % % 23(@)(@@) % قد ننكر الفعل لم تألفه عادتنا % % وان علمناه من بعض المباحات % % 24(@)(@@) % ورب شنعاء من عاداتنا حسنت % % في زعمنا وهي من أجل الشناعات % % 25(@)(@@) % عناكب الجهل كم ألقت بأدمغة % % من الأنام نسيجا من خرافات % % 26(@)(@@) % فحرموا وأحلوا حسب عادتهم % % وشوهوا وجه أحكام الديانات % % 27(@)(@@) % حتى تراهم يرون العلم منقصة % % عند النساء وان كن العفيفات % % 28(@)(@@) % وحجوبهن خوف العار ليتهم % % 29(@)(@@) % لم تحص سيئة العادات مقدرتي % % مهما تفننت منها في عباراتي % % 30(@)(@@) % فكم لها بدع سود قد اصطدمت % % في الناس منهن آفات بآفات % % PageV01P117 31(@)(@@) % لو لم يك الدهر سوقا راج بأطلها % % ما راجت الخمر في سوق التجارات % % 32(@)(@@) % ولااستمر دخان التبغ منتشرا % بين الورى وهو مطلوب كاقوات % % 33(@)(@@) % لو استطعت جعلت التبغ محتكرا % فوق احتكار له أضعاف مرات % % 34(@)(@@) % وزدت أضعاف أضعاف ضريبته % % حتى يبيعوه قيراطا ببدرات 
ms37	 % % 35(@)(@@) % فيستريح فقير القوم منه ولا % % يبلى به غير مثر ذي سفاهات % % 36(@)(@@) % الحر من خرق العادات منتهجا % نهج الصواب ولو ضد الجماعات % % 37(@)(@@) % ومن إذا خذل الناس الحقيقة عن % % جهل أقام لها في الناس رايات % % 38(@)(@@) % ولم يخف في اتباع الحق لائمة % % 39(@)(@@) % وعامل الناس بالإنصاف مدرعا % ثوب الاخوة من نسج المساواة % % 40(@)(@@) % فاغبى البرية أرفاهم لعادته % % وأعقل الناس خراق لعادات % % PageV01P118 البحر : طويل 1(@)(@@) % وظلت لها أبكي بعين قريحة رمت مسمعي ليلا بأنه مؤلم % % فألقت فؤادي بين أنياب ضيغم % % 2(@)(@@) % وبانت توالي في الظلام أنينها % % وبت لها مرمى بنهشة أرقم % % 3(@)(@@) % فيهفو بقلبي صوتها مثلما هفت % % بقلب فقير القوم رنة درهم % % 4(@)(@@) % إذا بعثت ذي أنة عن توجع % % إذا بعثت لي أنة عن توجع % % 5(@)(@@) % تقطع في الليل الأنين كأنها % % تقطع أحشائي بسيف مثلم % 6(@)(@@) % يهز نياط القلب بالحزن صوتها % % إذا اهتز في جوف الظلام المخيم % % 7(@)(@@) % تردده والصمت في الليل سائد % % بلحن ضئيل في الدجنة مبهم % 8(@)(@@) % كأن نجوم اليل عند ارتجافها % % تصيخ إلى ذاك الأنين المجمجم % 9(@)(@@) % فما خفقان القلب إلا لأجلها % % وما الشهب إلا أدمع النجم ترتمي % % 10(@)(@@) % لق تركتني موجعه القلب ساهرا % آخا مدمع جار ورأس مهوم % % PageV01P119 11(@)(@@) % أرى فحمة الظلماء عند أنينها % % فأعجب منها كيف لم تتضرم % % 12(@)(@@) % فأصبحت ظمآن الجفون إلى الكرى % % وإن كنت ريان الحشا من تألمي % % 13(@)(@@) % وأصبح قلبي وهو كالشعر لم تدع % % له شعراء القوم من متردم % % 14(@)(@@) % وبيت بكت فيه الحياة نحوسة % % ولاحت بوجه العابس المتجهم % % 15(@)(@@) % به القت الإيام أثقال بؤسها % % فهاجت به الأحزان فاغرة الفم % % 16(@)(@@) % كأني أرى البنيان فيه مهدما % وما هو بالخاوي ولا المتهدم % % 17(@)(@@) % ولكن زلزال الخطوب هوى به % % إلى قعر مهواة الشقاء المجسم % % 18(@)(@@) % دخلت به عند الصباح على التي % % سقاني بكاها في الدجى كأس علقم % % 19(@)(@@) % فألفيت وجها خدد الدمع خده % % ومحمر جفن بالبكا متورم % % 20(@)(@@) % وجسما نحيفا أنهكته همومه % % فكادت تراه العين بعض توهم % % PageV01P120 21(@)(@@) % لقد جثمت فوق التراب وحولها % % صغير 
ms38	 لها يرنو بعيني ميتم % 22(@)(@@) % تراه وماإن جاوز الخمس عمره % يدير لحاظ اليافع المتفهم % % 23(@)(@@) % بكى حولها جوعا فغذته بالبكا % % وليس البكا إلا تعلة معدم % % 24(@)(@@) % وأكبر ما يدعو القلوب إلى الأسى % % بكاء يتيم جائع حول أيم % % 25(@)(@@) % وقفت وقد شاهدت ذلك منهما % % لمريم أبكي رحمة وابن مريم % % 26(@)(@@) % وقفت لديها والأسى في عيونها % % تكلني عنها ولم تتكلم % % 27(@)(@@) % وساءلتها عنها وعنه فأجهشت % % بكاء وقالت أيها الدمع ترجم % % 28(@)(@@) % ولما تناهت في البكاء تضاحكت % % من اليأس ضحك الهازيء المتهكم % % 29(@)(@@) % ولكن دموع العين أثناء ضحكها % % هواطل مهما يسجم الضحك تسجم % % 30(@)(@@) % فقد جمعت ثغرا من الضحك مفعما % إلى محجر باك من الدمع مفعم % % PageV01P121 31(@)(@@) % فتذري دموعا كالجمان تناثرت % % وتضحك عن مثل الجمان المنظم % % 32(@)(@@) % فلما أر عينا قبلها سال دمعها % % بكاء وفيها نظرة المتبسم % % 33(@)(@@) % فقلت وفي قلبي من الوجد رعشة % % أمجنونة يا رب فارحم وسلم % % 34(@)(@@) % ومذ عرضت للابن منها التفاتة % % أشارت إليه بالمدامع أن قم % % 35(@)(@@) % فقام إليها خائر الجسم فانثنت % % عليه فضمته بكف ومعصم % % 36(@)(@@) % وضلت له ترنو بغين تجوده % % بفذ من المع الغزير وتوأم % % 37(@)(@@) % فقال لها لما رآني واقفا % أردد فيه نظرة المتوسم % % 38(@)(@@) % سلى ذا الفتى يا أم أين مضى أبي % % وهل هو يأتينا مساء بمطعم % % 39(@)(@@) % فقالت له والعين تجري غروبها % % وأنفاسها يقذفن شعلة مضرم % % 40(@)(@@) % أبوك ترامت فيه سفرة راحل % % إلى الموت لا يرجى له يوم مقدم % % PageV01P122 41(@)(@@) % مشى أرمنيا في المعاهد فارتمت % % به في مهاوي الموت ضربة مسلم % % 42(@)(@@) % على حين ثارت للنوائب ثورة % % أتت على حزازات إلى الدين تنتمي % % 43(@)(@@) % فقامت بها بين الديار مذابح % % تخوض منها الأرمنيون بالدم % % 44(@)(@@) % ولولاك لاخترت الحمام تخلصا % بنفسي من أتعاب عيش مذمم % % 45(@)(@@) % فأنت الذي اخرت أمك مريما % عن الموت أن يودي بأمك مريم % % 46(@)(@@) % أمريم مهلا بعض ما تذكرينه % % فإنك ترمين الفؤاد بأسهم % % 47(@)(@@) % أمريم إن الله لا شك ناقم % % من القوم في قتل النفوس المحرم % % 48(@)(@@) % أمريم فيما تحكمين تبصري % % فإن 
ms39	 أنت أدركت الحقيقة فاحكمي % % 49(@)(@@) % فليس بدين كل ما يفعلونه % % ولكنه جهل وسوء تفهم % % 50(@)(@@) % لئن ملئوا الأرض الفضاء جرائما % فهم أجرموا والدين ليس بمجرم % % PageV01P123 51(@)(@@) % فما خفقان النجم إلا لأجلها % % تمسوا بمطموس العلائم مبهم % % 52(@)(@@) % وقد سلكوا تيهاء من أمر دينهم % % فكم منجد في المخزيات ومتهم % % 53(@)(@@) % ولما رأيت اللوم لؤما تجاهها % % سكت فلم أنبس ولم أتبرم % % 54(@)(@@) % وأطرقت نحو الأرض أطلب عفوها % % وما أنا للجاني ولا بالمتيم % % 55(@)(@@) % وظلت لها أبكي بعين قريحة % % جرت من أماقيها عصارة عندم % % 56(@)(@@) % بكيت وما أدري أأبكي تضجرا % من القوم أم أبكي لشقوة مريم % % PageV01P124 البحر : بسيط تام 1(@)(@@) % الشعر مفتقر مني لمبتكر % % ولست للشعر في حال بمفتقر % 2(@)(@@) % دعوت غر القوافي وهي شاردة % % فأقبلت وهي تمشي مشي معتدل % % 3(@)(@@) % وسلمتني عن طوع مقادتها % % فرحت فيهن أجري جرى مقتدر % 4(@)(@@) % إذا أقمت أقامت وهي من خدمي % % وأينما سرت سارت تقتفي أثري % % 5(@)(@@) % صرفت فيهن أقلامي ورحت بها % % أعرف الناس سحر السمع والبصر % % 6(@)(@@) % ملكن من رقة رق النفوس هوى % % من حيث أظربنا حتى قاسى الحجر % % 7(@)(@@) % سقيتهن المعاني فارتوين بها % % وكن فيها مكان الماء في الثمر % % 8(@)(@@) % كم تشرئب لها الأسماع مصغية % % إذا تنوشدن بين البدو والحضر % % 9(@)(@@) % طابقت لفظي بالمعنى فطابقه % % خلوا من الحشو مملوءا من العبر % % 10(@)(@@) % إني لأنتزع المعنى الصحيح على % % عرى فأكسوه لفظا قد من درر % % PageV01P125 11(@)(@@) % سل المنازل عني إذ نزلت بها % % ما بين بغداد والشهباء في سفري % % 12(@)(@@) % ما جئت منزلة إلا بنيت بها % % بيتا من الشعر لا بيتا من الشعر % % 13(@)(@@) % وأجود الشعر مما يكسوه قائله % % بوشي ذا العصر لا الخالي من العصر % % 14(@)(@@) % لا يحسن الشعر إلا وهو مبتكر % % وأي حسن بشعر غير مبتكر % % 15(@)(@@) % ومن يكن قائل شعرا عن مفاخرة % % فلست والله في شعر بمفتخر % % 16(@)(@@) % وإنما هي أنفاس مصعدة % % ترمي بها حسراتي طائر الشرر % % 17(@)(@@) % وهن إن شئت مني أدمع غزر % % أبكى بهن على أيامنا الغرر % % 18(@)(@@) % أبكى على أمة دار الزمان لها 
ms40	 % % قبلا ودار عليها بعد بالغير % % 19(@)(@@) % كم خلد الدهر من أيامهم خبرا % زان الطروس وليس الخبر كالخبر % % 20(@)(@@) % ولست أدكر الماضين مفتخر % % لكن أقيم بهم ذكرى بمدكر % % PageV01P126 21(@)(@@) % وكيف يفتخر الباقون في عمه % % بدارس من هدى الماضين مندثر % % 22(@)(@@) % لهفي على العرب أمست من جمودهم % % حتى الجمادات تشكوا وهي في ضجر % % 23(@)(@@) % أين الجحاحد ممن ينتمون إلى % % ذوابة الشرف الوضاح من مضر % % 24(@)(@@) % قوم هم الشمس كانوا والورى قمر % % ولا كرامة لولا الشمس للقمر % % 25(@)(@@) % راحوا وقد أعقبوا من بعدهم عقبا % ناموا عن الأمر تفويضا إلى القدر % % 26(@)(@@) % أقول والبرق يسري في مراقدهم(@)(@@) % يا ساهر البرق أيقظ راقد السمر ) % 27(@)(@@) % يا أيها العرب هبوا من رقادكم % % فقد بدا الصبح وانجابت دجى الخطر % % 28(@)(@@) % كيف النجاح وأنتم لا اتفاق لكم % % والعود ليس له صوت بلا وتر % % 29(@)(@@) % مالي أراكم أقل الناس مقدرة % % يا أكثر الناس عدا غير منحصر % % PageV01P127 البحر : طويل 1(@)(@@) % سقتنا المعالي من سلافتها صرفا % وغنت لنا الدنيا تهنئنا عزفا % % 2(@)(@@) % وزفت لنا الدستور أحرار جيشنا % % فأهلا بما زفت وشكرا لمن زفا % % 3(@)(@@) % فأصبح هذا الشعب للسف شاكرا % وقد كان قبل اليوم لا يشكر السيفا % % 4(@)(@@) % ورحنا نشاوى العز يهتف بعضنا % % ببعض هتافا يصعق الظلم والحيفا % % 5(@)(@@) % ولاحت لنا حرية العيش عندما % % أماطت لنا الأحرار عن وجهها السجفا % % 6(@)(@@) % أتت عاطلا لا يعرف الحلي جيدها % % ولا كحلت عينا ولا خضبت كفا % % 7(@)(@@) % جاءت بمطبوع من الحسن قد قضى % % على الشعر أن لا يستطيع له وصفا % % 8(@)(@@) % فلما نرض غير العلم تاجا لرأسها % % ولا غير شنف العدل في أذنها شنفا % % 9(@)(@@) % ولم نكسها إلا من العرف حلا % % وهل يكتسي الديباج من يكتسي العرف % % 10(@)(@@) % نشرنا لها منا لفيف اشتياقنا % % ونحن لأناس نحسن النشر واللفا % % PageV01P128 11(@)(@@) % ويحتاج للتفكير من موه الحلفا % % وقمنا على الأقدام صفا لها صفا % % 12(@)(@@) % عقدنا لها عقد الولاء تعشقا % فكنا لها إلفا وكانت لنها إلفا % % 13(@)(@@) % رفعنا لواء النصر يهفو أمامها % % ورحنا على صرف الزمان لها حلفا % % 14 