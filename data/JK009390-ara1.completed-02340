ms2321	 عساكر عن ابن أبي أوفى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21660 ) قال النبي :(@)(@@) | 30 ( من تزين للناس بما يعلم الله منه غير ذالك شانه الله عز وجل ) )(@)(@@) الديلمي عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21661 ) قال النبي :(@)(@@) | 30 ( من تسخط رزقه ، وبث شكواه ، ولم يصبر ، لم يصعد له إلى الله تعالى عمل ولقي الله تعالى وهو عليه غضبان ) )(@)(@@) ( حل ) عن أبي سعيد وابن مسعود رضي الله عنهما معا .(@)(@@)(@@)(@@) $ ( 21662 ) قال النبي :(@)(@@) | 30 ( من تسمى باسمي يرجو بركتي ، غدت عليه البركة وراحت إلى يوم القيامة ) )(@)(@@) ابن أبي عاصم وأبو نعيم عن أبي جشيب عن أبيه .(@)(@@) PageV07P169(@)(@@)(@@)(@@) $ ( 21663 ) قال النبي :(@)(@@) | 30 ( من تضرع لصاحب دنيا وضع بذالك نصف دينه ، ومن أتى طعام قوم لم يدع إليه ملأ الله عز وجل بطنه نارا حتى يقض بين الناس يوم القيامة ) )(@)(@@) الديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21664 ) قال النبي :(@)(@@) | 30 ( من تضعضع لذي سلطان إرادة دنياه أعرض الله عنه بوجهه في الدنيا والآخرة ) )(@)(@@) الديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21665 ) قال النبي :(@)(@@) | 30 ( من تطبب ولم يكن بالطب معروفا فأصاب نفسا فما دونها فهو ضامن ) )(@)(@@) ( عد ) و ابن السني وأبو نعيم في الطب ( هق ) عن عمرو بن شعيب عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 21666 ) قال النبي :(@)(@@) | 30 ( من تطهر فأحسن الطهور ، ثم أتى الجمعة فلم يله ولم يجهل كان كفارة لما بينها وبين الجمعة الأخرى ، والصلوات الخمس كفاراة لما بينهن ، وفي الجمعة ساعة لا يوافقها عبد مسلم يسأل الله عز وجل فيها خيرا إلا أعطاه ) )(@)(@@) ( ش ) و عبد بن حميد عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21667 ) قال النبي :(@)(@@) | 30 ( من تظاهرت عليه النعم فليكثر الحمد لله ، ومن كثرت همومه فعليه بالاستغفار ، ومن ألح عليه الفقر فليكثر من قول لا حول ولا قوة إلا بالله ) )(@)(@@) الخطيب عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21668 ) قال النبي :(@)(@@) | 30 ( من تعلم علما من النجوم تعلم شعبة من السحر ، من زاد زاد ، من زاد زاد ) )(@)(@@) ( طب ) و أبو الشيخ 
ms2322	 في العظمة عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21669 ) قال النبي :(@)(@@) | 30 ( من تعلم القرآن ثم نسيه لقي الله وهو أجذم ) )(@)(@@) محمد بن نصر عن سعد بن عبادة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21670 ) قال النبي :(@)(@@) | 30 ( من تعلم الرمي فنسيه كان نعمة أنعم الله عليه PageV07P170 فتركها ) )(@)(@@) القراب في فضل الرمي عن أبي هريرة وعن ابن عمر رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 21671 ) قال النبي :(@)(@@) | 30 ( من تعلم حديثين اثنين ينفع بهما نفسه ويعلمهما غيره ، وكان ينتفع به كان خيرا له من عبادة ستين سنة ) )(@)(@@) الديلمي عن البراء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21672 ) قال النبي :(@)(@@) | 30 ( من تعلم لله وعلم لله كتب في ملكوت السماوات عظيما ) )(@)(@@) الديلمي عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21673 ) قال النبي :(@)(@@) | 30 ( من تعلم آية من كتاب الله عز وجل استقبلته يوم القيامة تضحك في وجهه ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21674 ) قال النبي :(@)(@@) | 30 ( من تعلم بابا من العلم ، عمل به أو لم يعمل به كان أفضل من صلاة ألف ركعة ، فإن هو عمل به أو علمه كان له ثوابه وثواب من يعمل به إلى يوم القيامة ) )(@)(@@) الخطيب وابن النجار عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21675 ) قال النبي :(@)(@@) | 30 ( من تعلم القرآن في شبيبته اختلط القرآن بلحمه ودمه ، ومن تعلمه في كبره فهو يتفلت منه ، وهو يعود فيه فله أجره مرتين ) )(@)(@@) ( ك خ ) و المرهبي في طلب العلم وأبو نعيم ( هب عد ) وابن النجار عن أبي هريرة ( عد ) عن علي رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 21676 ) قال النبي :(@)(@@) | 30 ( من تعلم شيئا من السحر ، قليلا أو كثيرا ، كان آخر عهده من الله تعالى ) )(@)(@@) ( عب ) عن صفوان بن سليم مرسلا .(@)(@@)(@@)(@@) $ ( 21677 ) قال النبي :(@)(@@) | 30 ( من تعلم الرمي ثم نسيه فهي نعمة جحدها ) )(@)(@@) ابن النجار عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21678 ) قال النبي :(@)(@@) | 30 ( من تعلم العلم ليباهي به العلماء ، أو ليماري به السفهاء ، أو يصرف به وجوه الناس إليه فهو في النار ) )(@)(@@) ( طس ) و ابن أبي عاصم PageV07P171 ( قط 
ms2323	 ) في الأفراد ( ض ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21679 ) قال النبي :(@)(@@) | 30 ( من تعلم العلم ليباهي به العلماء ، أو يماري به السفهاء فهو في النار ) )(@)(@@) ( طب ) و تمام عن أم سلمة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 21680 ) قال النبي :(@)(@@) | 30 ( من تعلم أربعين حديثا ابتغاء وجه الله ليعلم به أمتي في حلالهم وحرامهم حشره الله يوم القيامة عالما ) )(@)(@@) أبو نعيم عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21681 ) قال النبي :(@)(@@) | 30 ( من تعلم الأحاديث ليحدث به الناس لم يرح رائحة الجنة ، وإن ريحها ليوجد من مسيرة خمسمائة عام ) )(@)(@@) الديلمي عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21682 ) قال النبي :(@)(@@) | 30 ( من تعلم حرفا من العلم غفر الله له البتة ، ومن والى حبيبا في الله غفر الله له ، ومن نام على وضوء غفر الله له ، ومن نظر في وجه أخيه غفر الله له ، ومن ابتدأ وقال بسم الله غفر الله له ) )(@)(@@) الرافعي عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21683 ) قال النبي :(@)(@@) | 30 ( من تعلم القرآن وعلمه وأخذ بما فيه كان له شفيعا ودليلا إلى الجنة ) )(@)(@@) ابن عساكر عن أبي هدبة عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21684 ) قال النبي :(@)(@@) | 30 ( من تعمد علي كذبا أو رد شيئا قلته فليتبوأ مقعده من النار ) )(@)(@@) ( خط ) في الجامع عن أبي بكر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21685 ) قال النبي :(@)(@@) | 30 ( من تغوط على ضفة نهر يتوضأ منه ويشرب فعليه لعنة الله والملائكة والناس أجمعين ) )(@)(@@) الخطيب عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21686 ) قال النبي :(@)(@@) | 30 ( من تفقه في دين الله كفاه الله همه ورزقه من حيث لا يحتسب ) )(@)(@@) الرافعي عن أبي يوسف عن أبي حنيفة عن أنس ، الخطيب وابن النجار PageV07P172 عن أبي يوسف عن أبي حنيفة عن عبد الله بن جزء الزبيدي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21687 ) قال النبي :(@)(@@) | 30 ( من تقحم في الدنيا فهو يتقحم في النار ) )(@)(@@) أبو عبد الرحمان السلمي في سنن الصوفية عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21688 ) قال النبي :(@)(@@) | 30 ( من تقرب إلى الله شبرا تقرب إليه ذراعا ، ومن 
ms2324	 تقرب ذراعا تقرب اليه باعا ، ومن أقبل إلى الله ماشيا أقبل الله إليه مهرولا ، والله أعلى وأجل ، والله أعلى وأجل ، والله أعلى وأجل ) )(@)(@@) ابن خيثمة والبغوي وابن السكن وأبو نعيم في المعرفة عن زياد الغفاري وما له غيره ، ( طب ) وأبو نعيم والحسن بن سفيان عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21689 ) قال النبي :(@)(@@) | 30 ( من تقرب إلى الله عز وجل شبرا تقرب الله إليه ذراعا ، ومن تقرب إليه ذراعا تقرب إليه باعا ، ومن أتاه يمشي أتاه يهرول ) )(@)(@@) ( حم ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21690 ) قال النبي :(@)(@@) | 30 ( من تقرب من ذي سلطان ذراعا تباعد الله منه باعا ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21691 ) قال النبي :(@)(@@) | 30 ( من تقلد سيفا في سبيل الله قلده الله وشاحين من الجنة لاتقوم لهما الدنيا وما فيها من يوم خلقها إلى يوم يفنيها ، وصلت عليه الملائكة حتى يضعه عنه ، وإن الله تعالى ليباهي ملائكته بسيف الغازي ورمحه وسلاحه ، وإذا باهى الله ملائكته بعبد من عباده لم يعذبه بعد ذالك ) )(@)(@@) ابن النجار عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21692 ) قال النبي :(@)(@@) | 30 ( من تكفل يتيما له أو لغيره وجبت له الجنة إلا أن يكون عمل عملا لا يغفر ، ومن ذهبت كريمتاه وجبت له الجنة إلا أن يكون عمل PageV07P173 عملا لا يغفر ) )(@)(@@) ابن النجار عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21693 ) قال النبي :(@)(@@) | 30 ( من تكلم في القدر في الدنيا سئل عنه يوم القيامة ، فإن أخطأهلك ، ومن لم يتكلم لم يسأل عنه يوم القيامة ) )(@)(@@) ( قط ) الأفراد عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21694 ) قال النبي :(@)(@@) | 30 ( من تكلم بالرأي فقد اتهمني في الدين ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21695 ) قال النبي :(@)(@@) | 30 ( من تكلم يوم الجمعة والإمام يخطب فهو كالحمار يحمل أسفارا ، والذي يقول له انصت ليس له جمعة ) )(@)(@@) ( ش ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21696 ) قال النبي :(@)(@@) | 30 ( من تكن الدنيا نيته جعل الله فقره بين عينيه ، وشتت الله ضيعته ، ولا يأتيه 
ms2325	 منها إلا ما كتب له ، ومن تكن الآخرة نيته يجعل الله غناه في قلبه ، ويكف عليه ضيعته ، وتأتيه الدنيا وهي راغمة ) )(@)(@@) ابن عساكر عن زيد بن ثابت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21697 ) قال النبي :(@)(@@) | 30 ( من تكهن أو تقسم أو تطير طيرة ترده عن سفر لم ينظر إلى الدرجات من الجنة يوم القيامة ) )(@)(@@) ( هب ) عن أبي الدرداء رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 21698 ) قال النبي :(@)(@@) | 30 ( من تناول أمرا بمعصيتي كان ذالك أفوت لما رجا ، وأقرب لمجيء ما اتقى ) )(@)(@@) تمام وابن عساكر عن عبد الله بن بشر المازني رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21699 ) قال النبي :(@)(@@) | 30 ( من تنخم في المسجد فلم يدفنه فسيئة ، وإن دفنه فحسنة ) )(@)(@@) ( ع طب ) و ابن النجار ( ض ) عن أبي أمامة رضي الله عنه .(@)(@@) PageV07P174(@)(@@)(@@)(@@) $ ( 21700 ) قال النبي :(@)(@@) | 30 ( من تهيأ للناس بقوله ولباسه وخالف ذالك في أعماله فعليه لعنة الله والملائكة والناس أجمعين ) )(@)(@@) ( ك ) في تاريخه عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21701 ) قال النبي :(@)(@@) | 30 ( من تواضع لله رفعه الله ، ومن تكبر وضعه الله ) )(@)(@@) ابن منده وأبو نعيم عن أوس بن خولي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21702 ) قال النبي :(@)(@@) | 30 ( من تواضع لله رفعه الله ، ومن اقتصد أغناه الله ، ومن ذكر الله أحبه الله ) )(@)(@@) ابن النجار عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21703 ) قال النبي :(@)(@@) | 30 ( من تواضع لله رفعه الله ، فهو في نفسه ضعيف وفي أنفس الناس عظيم ، ومن تكبر وضعه الله ، فهو في أعين الناس صغير وفي نفسه كبير حتى لهو أهون عليهم من كلب أو خنزير ) )(@)(@@) أبو نعيم عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21704 ) قال النبي :(@)(@@) | 30 ( من تواضع مخشعا لله رفعه الله ، ومن تطاول تعظما وضعه الله ، والناس تحت كنف الله يعملون أعمالهم ، فإذا أراد الله عز وجل فضيحة عبد أخرجه من تحت كنفه فبدت ذنوبه ) )(@)(@@) أبو الشيخ عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21705 ) قال النبي :(@)(@@) | 30 ( من تولى مولى مسلما بغير إذنه ، وآوى محدثا في الإسلام ، أو انتهب نهبة ذات شرف فعليه لعنة 
ms2326	 الله لا صرف عنها ولا عدل ) )(@)(@@) ( عب ) عن عمرو بن شعيب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21706 ) قال النبي :(@)(@@) | 30 ( من توضأ فأحسن الوضوء ثم صلى ركعتين فدعا ربه كانت دعوته مستجابة معجلة أو مؤخرة ، إياكم والالتفات فإنه لا صلاة لملتفت ، PageV07P175 فإذا غلبتم في التطوع لا تغلبوا في الفريضة ) )(@)(@@) ( حم طب ) و ابن النجار عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21707 ) قال النبي :(@)(@@) | 30 ( من توضأ فأسبغ الوضوء ثم قال عند فراغه : سبحانك اللهم وبحمدك ، أشهد أن لا إلاه إلا أنت ، أستغفرك وأتوب إليك ، ختم عليها بخاتم فوضعت تحت العرش فلم تكسر إلى يوم القيامة ) )(@)(@@) ابن السني عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21708 ) قال النبي :(@)(@@) | 30 ( من توضأ فأسبغ الوضوء ثم عمد إلى مسجد قباء لا يريد غيره ، ولا يحمله على الغدو إلا الصلاة في مسجد قباء فصلى فيه أربع ركعات يقرأ في كل ركعة بأم القرآن كان له مثل أجر المعتمر إلى بيت الله ) )(@)(@@) ( طب ) عن سعد بن إسحاق بن كعب بن عجرة عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 21709 ) قال النبي :(@)(@@) | 30 ( من توضأ فغسل يديه ثلاثا ، ثم استنشق ثلاثا ، وغسل وجهه ثلاثا ، ويديه إلى المرفقين ، ومسح برأسه ، ثم غسل رجليه ، ثم لم يتكلم حتى يقول : أشهد أن لا إلاه إلا الله وحده لا شريك له وأن محمدا عبده ورسوله ، غفر له ما بين الوضوءين ) )(@)(@@) ( ع ) عن عثمان رضي الله عنه وضعف .(@)(@@)(@@)(@@) $ ( 21710 ) قال النبي :(@)(@@) | 30 ( من توضأ ثم قال : أشهد أن لا إلاه إلا الله وأن محمدا عبده ورسوله قبل أن يتكلم غفر له ما بين الوضوءين ) )(@)(@@) ( قط ) عن ابن عمر رضي الله عنهما وضعف .(@)(@@)(@@)(@@) $ ( 21711 ) قال النبي :(@)(@@) | 30 ( من توضأ وضوءا كاملا ثم قام إلى صلاته كان من خطيئته كيوم ولدته أمه ) )(@)(@@) ( طس ) عن عقبة بن عامر الجهني رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21712 ) قال النبي :(@)(@@) | 30 ( من توضأ فمسح بثوب نظيف فلا بأس به ، ومن لم يفعل فهو أفضل ، لأن الوضوء يوزن يوم القيامة مع سائر الأعمال ) )(@)(@@) تمام وابن عساكر 
ms2327	 PageV07P176 عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21713 ) قال النبي :(@)(@@) | 30 ( من توضأ مثل وضوئي هاذا ثم قام فصلى صلاة الظهر غفر له ما كان بينها وبين صلاة الصبح ، ثم صلى العصر غفر له ما كان بينها وبين صلاة الظهر ، ثم صلى المغرب غفر له ما كان بينها وبين صلاة العصر ، ثم صلى العشاء غفر له ما بينها وبين صلاة المغرب ، ثم لعله أن يبيت يتمرغ ليلته ، ثم إن قام فتوضأ فصلى الصبح غفر له ما بينها وبين صلاة العشاء وهن الحسنات يذهبن السيئات ، قالوا : هاذه الحسنات فما الباقيات الصالحات ؟ قال : هي لا إلاه إلا الله ، وسبحان الله ، والحمد لله ، والله أكبر ، ولا حول ولا قوة إلا بالله ) )(@)(@@) ( حم ع هب ) عن عثمان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21714 ) قال النبي :(@)(@@) | 30 ( من توضأ واحدة فتلك وظيفة الوضوء التي لا بد منها ، ومن توضأ اثنتين فله كفلان ، ومن توضأ ثلاثا ثلاثا فذاك وضوئي ووضوء الأنبياء قبلي ) )(@)(@@) ( حم ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21715 ) قال النبي :(@)(@@) | 30 ( من توضأ فأحسن الوضوء ذهب الإثم من سمعه وبصره وبدنه ورجليه ) )(@)(@@) ( طس ) عن أبي أمامة وعمرو بن عبسة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21716 ) قال النبي :(@)(@@) | 30 ( من توضأ فأحسن الوضوء ثم صلى فأتم ركوعها وسجودها كفر عنه ما بينه وبين الصلاة الأخرى ما لم يركب مقتلة ) )(@)(@@) ( ط هب ) عن عثمان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21717 ) قال النبي :(@)(@@) | 30 ( من توضأ ثم خرج يريد الصلاة فهو في الصلاة حتى يرجع إلى بيته ) )(@)(@@) ابن جرير ( هب ) عن أبي هريرة رضي الله عنه .(@)(@@) PageV07P177(@)(@@)(@@)(@@) $ ( 21718 ) قال النبي :(@)(@@) | 30 ( من توضأ فأحسن الوضوء ثم خرج إلى المسجد لم يزل في صلاة حتى يرجع إلى بيته ) )(@)(@@) ابن جرير عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21719 ) قال النبي :(@)(@@) | 30 ( من توضأ فأبلغ الوضوء ، ثم قام إلى الصلاة فأتم ركوعها وسجودها والقراءة فيها قالت : حفظك الله كما حفظتني ، ثم أصعد بها إلى السماء ولها ضوء ونور ، فتحت لها أبواب السماء حتى تنتهي بها إلى الله فتشفع 
ms2328	 لصاحبها ، وإذا لم يتم ركوعها ولا سجودها ولا القراءة فيها قالت : ضيعك الله كما ضيعتني ، ثم أصعد بها إلى السماء وعليها ظلمة فغلقت دونها أبواب السماء ثم تلف كما يلف الثوب الخلق فيضرب بها وجه صاحبها ) )(@)(@@) ( هب ) عن عبادة بن الصامت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21720 ) قال النبي :(@)(@@) | 30 ( من توضأ فأحسن وضوءه ثم خرج إلى المسجد كتب الله له بإحدى رجليه حسنة ومحى عنه سيئة ، ورفع له درجة ) )(@)(@@) أبو الشيخ عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21721 ) قال النبي :(@)(@@) | 30 ( من توضأ ومسح يديه على عنقه أمن الغل يوم القيامة ) )(@)(@@) أبو نعيم عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21722 ) قال النبي :(@)(@@) | 30 ( من توضأ فأحسن الوضوء وعاد أخاه المسلم محتسبا بوعد من جهنم مسيرة خمسين خريفا ) )(@)(@@) ( د ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21723 ) قال النبي :(@)(@@) | 30 ( من توضأ وذكر اسم الله على وضوئه تطهر جسده كله ، ومن توضأ ولم يذكر اسم الله على وضوئه لم يتطهر إلا موضع الوضوء ) )(@)(@@) ( قط هق ) وضعفه عن ابن مسعود ، ( قط هق ) وضعفه عن ابن عمر رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 21724 ) قال النبي :(@)(@@) | 30 ( من توضأ كما أمر ، وصلى كما أمر ، غفر له ما PageV07P178 تقدم من عمل ) )(@)(@@) ( حم ) و الدارمي ، ( ن ه حب طب ) وعبد بن حميد ، ( ض ) وأبو أيوب وعقبة بن عامر رضي الله عنهما ولفظ ( حب ) غفر له ما تقدم من ذنبه .(@)(@@)(@@)(@@) $ ( 21725 ) قال النبي :(@)(@@) | 30 ( من توضأ كما أمر وصلى كما أمر ، خرج من ذنوبه كيوم ولدته أمه ) )(@)(@@) ( طب ) عن عثمان بن عفان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21726 ) قال النبي :(@)(@@) | 30 ( من توضأ فأحسن الوضوء ثم رفع بصره إلى السماء ثم قال : أشهد أن لا إلاه إلا الله وحده لا شريك له وأشهد أن محمدا عبده ورسوله فتحت له أبواب الجنة يدخل من أيها شاء ) )(@)(@@) ( ن ) عن ثوبان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21727 ) قال النبي :(@)(@@) | 30 ( من توضأ على طهر كتب له عشر حسنات ) )(@)(@@) ( ش د ت ) وضعفه ( ه ) و الطحاوي وابن جرير عن عمر 
ms2329	 رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21728 ) قال النبي :(@)(@@) | 30 ( من توضأ فأحسن الوضوء ثم راح فوجد الناس قد صلوا ، أعطاه الله عز وجل أجر من صلاها وحضرها لا ينقص ذالك من أجرهم شيئا ) )(@)(@@) ( حم د ن ك هق ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21729 ) قال النبي :(@)(@@) | 30 ( من توضأ فأحسن وضوءه ثم دخل مسجد قباء فركع فيه أربع ركعات كان ذالك عدل عمره ) )(@)(@@) ( ش ) و عبد بن حميد ( طب ) عن سهيل بن حنيف رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21730 ) قال النبي :(@)(@@) | 30 ( من توضأ فأحسن الوضوء ثم صلى في مسجد قباء ركعتين كانت له عمرة ) )(@)(@@) ( طب ) عن سهل بن حنيف رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21731 ) قال النبي :(@)(@@) | 30 ( من توضأ في بيته فأحسن الوضوء ثم أتى المسجد فهو زائر الله ، وحق المزور أن يكرم الزائر ) )(@)(@@) ( طب ) عن سل مان رضي الله عنه .(@)(@@) PageV07P179(@)(@@)(@@)(@@) $ ( 21732 ) قال النبي :(@)(@@) | 30 ( من توضأ ثم أتى المسجد فصلى ركعتين قبل الفجر ثم جلس حتى يصلي الفجر كتبت صلاته يومئذ في صلاة الأبرار وكتب في وفد الرحمان ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21733 ) قال النبي :(@)(@@) | 30 ( من توضأ فأحسن الوضوء ثم خرج عامدا إلى مسجد قباء لا ينزعه إلا الصلاة فيه فصلى فيه ركعتين كانتا عدل عمرة ) )(@)(@@) الخطيب عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21734 ) قال النبي :(@)(@@) | 30 ( من توضأ فأسبغ الوضوء غسل يديه ووجهه ، ومسح على رأسه وأذنيه ، ثم قام إلى صلاة مفروضة ، غفر الله له في ذالك اليوم ما مشت إليه رجلاه ، وقبضت عليه يداه ، وسمعت إليه أذناه ، ونظرت إليه عيناه ، وحدث به نفسه من سوء ) )(@)(@@) ( حم طب ض ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21735 ) قال النبي :(@)(@@) | 30 ( من توضأ فأسبغ الوضوء ثم قال عند فراغه من الوضوء : أشهد أن لا إلاه إلا الله وأشهد أن محمدا عبده ورسوله ، اللهم اجعلني من التوابين واجعلني من المتطهرين ، فتح الله له ثمانية أبواب الجنة يدخل من أيها شاء ) )(@)(@@) ابن السني والخطيب وابن النجار عن ثوبان رضي الله عنه 
ms2330	 .(@)(@@)(@@)(@@) $ ( 21736 ) قال النبي :(@)(@@) | 30 ( من توضأ للصلاة وأسبغ الوضوء ، ورفع رأسه إلى السماء فقال : أشهد أن لا إلاه إلا الله وحده لا شريك له ، فتح الله له ثمانية أبواب الجنة وقيل له : أدخل من أي باب شئت ) )(@)(@@) الخطيب وابن النجار عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21737 ) قال النبي :(@)(@@) | 30 ( من توضأ فأحسن الوضوء ثم أتى مسجدا من مساجد الله لا يعمده إلا الصلاة تبشبش الله به كما يتبشبش أحدكم بالغائب عنه إذا PageV07P180 قدم عليه ) )(@)(@@) الحاكم في الكنى ا عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21738 ) قال النبي :(@)(@@) | 30 ( من توضأ فغسل يديه خرجت خطاياه من بين يديه ، فإذا مضمضض واستنشق خرت خطاياه من أنفه ، فإذا غسل وجهه خرت خطاياه من وجهه ، فإذا مسح برأسه خرت خطاياه من رأسه ، فإذا غسل رجليه خرت خطاياه من رجليه ، ثم قام إلى الصلاة كان كما ولدته أمه وكانت صلاته نافلة له ) )(@)(@@) محمد بن نصر في الصلاة ( طب ) عن عمرو بن عبسة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21739 ) قال النبي :(@)(@@) | 30 ( من توضأ في بيته فأحسن الوضوء ، ثم خرج إلى المسجد فصلى في جماعة ، لم يرفع رجله اليمنى إلا كتب الله تعالى له بها حسنة ، ولا يضع رجله اليسرى إلا حط عنه بها خطيئة حتى يأتي المسجد فليتقرب أو ليبعد ، فإن صلى صلاة الإمام انصرف وقد غفر له ، فإن أدرك بعضا وفاته بعض فأتم ما فاته كان كذالك ، فإن أدرك الصلاة وقد صليت فأتم ركوعها وسجودها كان كذالك ) )(@)(@@) البغوي عن سعيد بن المسيب عن رجل من الأنصار .(@)(@@)(@@)(@@) $ ( 21740 ) قال النبي :(@)(@@) | 30 ( من توضأ فليستنشق وليمضمض ، والأذنان من الرأس ) )(@)(@@) ( عب ض ش ) عن سل يمان بن موسى رضي الله عنه بلاغا .(@)(@@)(@@)(@@) $ ( 21741 ) قال النبي :(@)(@@) | 30 ( من توضأ فأسبغ الوضوء ثم قام فصلى صلاة يعلم ما يقول فيها حتى يفرغ من صلاته كان كهيئة يوم ولدته أمه ) )(@)(@@) عبد الرزاق عن عقبة بن عامر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21742 ) قال النبي :(@)(@@) | 30 ( من توضأ فأحسن الوضوء ثم صلى أربع ركعات لا 
ms2331	 يسهو فيهن غفر له ) )(@)(@@) البزار عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21743 ) قال النبي :(@)(@@) | 30 ( من توضأ فغسل كفيه ثلاثا أذهب الله عنه كل خطيئة أخطأها بهما ، ومن مضمض واستنشق أذهب الله عنه كل خطيئة أخطأها بلسانه PageV07P181 وشفتيه ، ومن توضأ فأبلغ الوضوء أماكنه ثم قام إلى الصلاة مقبلا عليها يعد من خطيئته مثل ما ولدته أمه ) )(@)(@@) الخطيب في المتفق والمفترق عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21744 ) قال النبي :(@)(@@) | 30 ( من توضأ فأحسن الوضوء تحاتت عنه خطاياه كما يتحات الورق ) )(@)(@@) ( ش ) عن سل مان رضي الله عنه وسنده حسن .(@)(@@)(@@)(@@) $ ( 21745 ) قال النبي :(@)(@@) | 30 ( من توضأ فأحسن الوضوء ثم خرج إلى مسجد قباء لا يخرجه إلا الصلاة فيه ، انقلب بأجر عمرة ) )(@)(@@) أبو نعيم في المعرفة عن سليمان بن محمد الكرماني عن أبيه عن سهل بن حنيف عن أبيه .(@)(@@)(@@)(@@) $ ( 21746 ) قال النبي :(@)(@@) | 30 ( من توضأ فأحسن الوضوء ثم قام فصلى ركعتين أو أربع ركعات مكتوبة أو غير مكتوبة يحسن فيها الركوع والسجود ثم يستغفر الله إلا غفر له ) )(@)(@@) ( طب ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21747 ) قال النبي :(@)(@@) | 30 ( من توضأ فجمع ثيابه ثم خرج إلى المسجد كتب له كاتبه بكل خطوة عشر حسنات ، والمرء في صلاته ما كان ينتظر الصلاة ، يكتب من المصلين من حين يخرج من بيته حتى يرجع ) )(@)(@@) ( طب ) عن عقبة بن عامر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21748 ) قال النبي :(@)(@@) | 30 ( من توضأ فأحسن وضوءه ثم صلى صلاة غير ساه ولا لاه كفر عنه ما كان قبلها من سيئة ) )(@)(@@) ( ض حم طب ) عن عقبة بن عامر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21749 ) قال النبي :(@)(@@) | 30 ( من توضأ فأحسن الوضوء ثم صلى ركعتين كان من ذنوبه كيوم ولدته أمه ) )(@)(@@) ( طب ) عن عقبة بن عامر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21750 ) قال النبي :(@)(@@) | 30 ( من توكل على الله كفاه مؤنته ورزقه من حيث لا PageV07P182 يحتسب ، ومن انقطع إلى الدنيا وكله الله إليها ) )(@)(@@) الديلمي عن عمران بن حصين والشاشي وابن جرير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21751 ) قال النبي 
ms2332	 :(@)(@@) | 30 ( من توكل لي بما بين فقميه ورجليه أتوكل له بالجنة ) )(@)(@@) العسكري في الأمثال عن سهل بن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21752 ) قال النبي :(@)(@@) | 30 ( من تولى غير مواليه فعليه لعنة الله وغضبه يوم القيامة ، لا يقبل منه صرف ولا عدل ، ومن قتل غير قاتله فعليه لعنة الله وغضبه يوم القيامة لا يقبل منه صرف ولا عدل ) )(@)(@@) ( طب ) عن كثير بن عبد الله عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 21753 ) قال النبي :(@)(@@) | 30 ( من توكل لي بما بين لحييه ورجليه توكلت له بالجنة ) )(@)(@@) ( ك ) عن سهل بن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21754 ) قال النبي :(@)(@@) | 30 ( من تولى مولى قوم بغير إذنهم فعليه لعنة الله لا صرف عنها ولا عدل ) )(@)(@@) ( عب ) عن عطاء مرسلا .(@)(@@)(@@)(@@) $ ( 21755 ) قال النبي :(@)(@@) | 30 ( من تولى عملا وهو يعلم أنه ليس لذلك العمل أهل فليتبوأ مقعده من النار ) )(@)(@@) و الروياني ( كر ) عن أبي موسى رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21756 ) قال النبي :(@)(@@) | 30 ( من تولى مولى قوم بغير إذن مواليه فعليه لعنة الله والملائكة والناس أجمعين ، لا يقبل منه صرف ولا عدل ) )(@)(@@) ابن جرير عن أبي سلمة عن سعيد بن زيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21757 ) قال النبي :(@)(@@) | 30 ( من تولى غير مواليه فعليه لعنة الله والملائكة والناس أجمعين لا يقبل منه صرف ولا عدل ، ومن حلف عند قبري هاذا يمينا كاذبة يستحل بها مال امرىء مسلم بغير حق فعليه لعنة الله والملائكة والناس أجمعين لا يقبل منه صرف ولا عدل ، ومن أحدث في مدينتي هاذه حدثا ، أو آوى محدثا فعليه PageV07P183 لعنة الله والملائكة والناس أجمعين لا يقبل منه صرف ولا عدل ) )(@)(@@) ( طب ض ) عن أبي أمامة الحارثي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21758 ) قال النبي :(@)(@@) | 30 ( من تولى غير مواليه فقد كفر ) )(@)(@@) ابن جرير عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21759 ) قال النبي :(@)(@@) | 30 ( من تولى غير مواليه فعليه لعنة الله وغضبه لا يقبل الله منه صرفا ولا عدلا ) )(@)(@@) ابن جرير عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21760 ) قال النبي :(@)(@@) | 30 ( من تولى مولى قوم 
ms2333	 بغير إذنهم ، أو آوى محدثا ، فعليه غضب الله ، لا يقبل منه صرفا ولا عدلا ) )(@)(@@) ابن جرير عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21761 ) قال النبي :(@)(@@) | 30 ( من تولى غير مواليه فليتبوأ بيتا في النار ) )(@)(@@) ابن جرير عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 21762 ) قال النبي :(@)(@@) | 30 ( من تلا آية من كتاب الله كانت له نورا يوم القيامة ، ومن استمع لآية من كتاب الله كتبت له حسنة مضاعفة ) )(@)(@@) ( هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21763 ) قال النبي :(@)(@@) | 30 ( من جاء بشهادة أن لا إلاه إلا الله وحده لا شريك له وأن محمدا عبده ورسوله حرم على النار ) )(@)(@@) مسدد وابن النجار عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21764 ) قال النبي :(@)(@@) | 30 ( من جاء يوم القيامة بخمس لم يصد وجهه عن الجنة : النصح لله ولدينه ولكتابه ولرسوله ولجماعة المسلمين ) )(@)(@@) ابن النجار عن تميم الداري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21765 ) قال النبي :(@)(@@) | 30 ( من جاء منكم إلى الجمعة فليغتسل ) )(@)(@@) الشيرازي في PageV07P184 الألقاب عن عثمان ( طب ) عن ابن عباس ، ( ن ) عن عمر وعن ابن عمر رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 21766 ) قال النبي :(@)(@@) | 30 ( من جاء بصلاة الخمس يوم القيامة قد حافظ على وضوئها ، ومواقيتها ، وركوعها ، وسجودها لم ينقص منها شيئا ، جاء وله عند الله عهد أن لا يعذبه ، ومن جاء قد انتقص منهن شيئا فليس له عند الله عهد ، إن شاء رحمه وإن شاء عذبه ) )(@)(@@) ( طس ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 21767 ) قال النبي :(@)(@@) | 30 ( من جاء يؤم البيت الحرم فركب بعيره ، فما يرفع البعير خفا إلا كتب الله له بها حسنة وحط عنه بها خطيئة ، ورفع له بها درجة ، حتى إذا انتهى إلى البيت فطاف به وطاف بين الصفا والمروة ، ثم حلق أو قصر إلا خرج من ذنوبه كيوم ولدته أمه ، وقيل له : استأنف العمل ) )(@)(@@) ( طب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21768 ) قال النبي :(@)(@@) | 30 ( من جاء بالصلوات الخمس قد أكملهن لم ينقص من حقهن شيئا كان له عند الله عهد أن لا يعذبه ، ومن 
ms2334	 جاء بهن وقد انتقص من حقهن شيئا فليس له عند الله عهد ، إن شاء رحمه ، وإن شاء عذبه ) )(@)(@@) ( حب ) عن عبادة بن الصامت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21769 ) قال النبي :(@)(@@) | 30 ( من جاء يوم القيامة بريئا من ثلاث دخل الجنة : الكبر ، والغلول ، والدين ) )(@)(@@) ( حب ) عن ثوبان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21770 ) قال النبي :(@)(@@) | 30 ( من جاءنا كما جئتنا استغفرنا له كما استغفرنا لك ، ومن أصر على ذنبه فالله أولى به ، ولا نخرق على أحد سترا ) )(@)(@@) ( طب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21771 ) قال النبي :(@)(@@) | 30 ( من جاءني زائرا لا يعمده حاجة إلا زيارتي كان حقا علي أن أكون له شفيعا يوم القيامة ) )(@)(@@) ( طب ) عن ابن عمر رضي الله عنه .(@)(@@) PageV07P185(@)(@@)(@@)(@@) $ ( 21772 ) قال النبي :(@)(@@) | 30 ( من جاءه الموت وهو يطلب العلم يحيي به الإسلام ، لم يكن بينه وبين الأنبياء إلا درجة في الجنة ) )(@)(@@) ابن عساكر عن الحسن مرسلا ، ابن النجار عن الحسن عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21773 ) قال النبي :(@)(@@) | 30 ( من جاءه من أخيه معروف من غير إشراف نفس ولا مسألة فليقبله ولا يرده فإنما هو رزق ساقه الله إليه ) )(@)(@@) ( حم ش ) و ابن سعد ( ع حب ) والبغوي والباوردي وابن قانع وأبو نعيم ( هب ض ) عن خالد بن علي الجهني رضي الله عنه ، قال البغوي : لا أعلم له غيره .(@)(@@)(@@)(@@) $ ( 21774 ) قال النبي :(@)(@@) | 30 ( من جاءه أجله وهو يطلب العلم لقي الله ولم يكن بينه وبين النبيين إلا درجة النبوة ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21775 ) قال النبي :(@)(@@) | 30 ( من جاءه أجله وهو يطلب العلم ليحيى به الإسلام لم يفضله النبيون إلا بدرجة ) )(@)(@@) الخطيب عن سعيد بن المسيب عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21776 ) قال النبي :(@)(@@) | 30 ( من جاهد في سبيل الله كان ضامنا على الله ، ومن عاد مريضا كان ضامنا على الله ، ومن غدا إلى المسجد أو راح كان ضامنا على الله ، ومن جلس في بيته لم يغتب أحدا بسوء كان ضامنا على الله ، ومن دخل على إمام يعزره 
ms2335	 كان ضامنا على الله ) )(@)(@@) الروياني ( طب حب هق ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21777 ) قال النبي :(@)(@@) | 30 ( من جر ثيابه من الخيلاء لم ينظر الله إليه يوم القيامة ، وبينا رجل يمشي بين بردين مختالا خسف الله به الأرض ، فهو يتجلجل PageV07P186 فيها إلى يوم القيامة ) )(@)(@@) ( حم ع بز ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21778 ) قال النبي :(@)(@@) | 30 ( من جر ثوبه خيلاء لم ينظر الله إليه في حلال ولا حرام ) )(@)(@@) ( طب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21779 ) قال النبي :(@)(@@) | 30 ( من جرح في جسده جراحة فتصدق بها كفر عنه من ذنوبه بمثل ما تصدق به ) )(@)(@@) ابن جرير عن عبادة بن الصامت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21780 ) قال النبي :(@)(@@) | 30 ( من جرح في سبيل الله جاء يوم القيامة ، ريحه كريح المسك ، ولونه لون الزعفران ، عليه طابع الشهداء ، ومن سأل الله الشهادة مخلصا أعطاه الله أجر شهيد وإن مات على فراشه ) )(@)(@@) ( حب ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21781 ) قال النبي :(@)(@@) | 30 ( من جعل الهموم هما واحدا كفاه الله ما أهمه من أمر الدنيا والآخرة ، ومن تشاعبت به لم يبال الله في أي أودية الدنيا هلك ) )(@)(@@) ( ك ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21782 ) قال النبي :(@)(@@) | 30 ( من جعل الاستطاعة إلى نفسه فقد كفر ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21783 ) قال النبي :(@)(@@) | 30 ( من جلب طعاما إلى مصر من أمصار المسلمين كان له أجر شهيد ) )(@)(@@) الديلمي عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21784 ) قال النبي :(@)(@@) | 30 ( من جلد حدا في غير حد فهو من المعتدين ) )(@)(@@) ( طب ) عن النعمان بن بشير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21785 ) قال النبي :(@)(@@) | 30 ( من جلس في المسجد ينتظر الصلاة فهو في صلاة ) )(@)(@@) عبد بن حميد وابن جرير ( طب ) عن سهل بن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21786 ) قال النبي :(@)(@@) | 30 ( من جلس على البحر احتسابا ونية احتياطا PageV07P187 للمسلمين كتب الله له بكل نظرة في البحر حسنة ) )(@)(@@) ( طب ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21787 ) قال النبي :(@)(@@) | 30 ( من جلس مجلسا 
ms2336	 ينتظر الصلاة فهو في صلاة حتى يصلي ) )(@)(@@) مالك ( حب طب ك هب ض ) عن عبد الله بن سلام وأبي هريرة رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21788 ) قال النبي :(@)(@@) | 30 ( من جلس في مصلاه حتى يصلي الضحى غفر له ذنبه وإن كان مثل زبد البحر ) )(@)(@@) ابن شاهين عن معاذ بن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21789 ) قال النبي :(@)(@@) | 30 ( من جلس إليه قوم فلا يقم حتى يستأذنهم ، ومن رأى اثنين جالسين فلا يجلس إليهما حتى يستأذنهما ) )(@)(@@) ابن لال عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21790 ) قال النبي :(@)(@@) | 30 ( من جلس من حين يصلي المغرب يذكر الله حتى يصلي العشاء كان مجلسه ذالك روحة في سبيل الله ، ومن جلس من حين يصلي الغداة يذكر الله حتى تطلع الشمس كانت مثل غدوة في سبيل الله عز وجل ) )(@)(@@) أبو الشيخ عن الزبير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21791 ) قال النبي :(@)(@@) | 30 ( من جلس على قبر يبول عليه أو يتغوط فكأنما جلس على جمرة نار ) )(@)(@@) الروياني عن أبي أمامة وضعف ، ابن منيع عن أبي هريرة رضي الله عنه وضعف .(@)(@@)(@@)(@@) $ ( 21792 ) قال النبي :(@)(@@) | 30 ( من جلس في المسجد ينتظر الصلاة فهو في صلاة ، والملائكة تقول : اللهم اغفر له ، اللهم ارحمه ، ما لم يحدث ) )(@)(@@) ابن جرير عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21793 ) قال النبي :(@)(@@) | 30 ( من جمع الله له أربع خصال جمع الله له خير PageV07P188 الدنيا والآخرة : قلبا شاكرا ، ولسانا ذاكرا ، ودارا قصدا ، وزوجة صالحة ) )(@)(@@) ابن النجار عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21794 ) قال النبي :(@)(@@) | 30 ( من جمع بين الحج والعمرة طاف لهما طوافا واحدا ، وسعى لهما سعيا واحدا ، ولم يحل حتى يحل منهما جميعا ) )(@)(@@) ( هق ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21795 ) قال النبي :(@)(@@) | 30 ( من جمع مالا حراما ثم تصدق به لم يكن له فيه أجر وكان إصره عليه ) )(@)(@@) ( حب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21796 ) قال النبي :(@)(@@) | 30 ( من جهز غازيا في سبيل الله فله مثل أجره ، ومن خلف غازيا في سبيل الله في أهله بخير وأنفق 
ms2337	 فله مثل أجره ) )(@)(@@) و الدارمي ( حب طب ) عن زيد بن خالد الجهني رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21797 ) قال النبي :(@)(@@) | 30 ( من جهز غازيا أو خلفه في أهله بخير فإنه معنا ) )(@)(@@) ( حم طب ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21798 ) قال النبي :(@)(@@) | 30 ( من جهز حاجا ، أو جهز غازيا أو خلفه في أهله ، أو فطر صائما فله مثل أجره من غير أن ينقص من أجره شيء ) )(@)(@@) ( هب ) عن زيد بن خالد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21799 ) قال النبي :(@)(@@) | 30 ( من حافظ على سبع تسبيحات في كل ركعة وسجدة في الصلاة المكتوبة أدخله الله الجنة ) )(@)(@@) تمام وابن عساكر عن معاذ بن جبل رضي الله عنه وفيه شراحيل بن عمرو العنسي وضعف .(@)(@@)(@@)(@@) $ ( 21800 ) قال النبي :(@)(@@) | 30 ( من حافظ على الصلوات الخمس المكتوبة : على PageV07P189 ركوعهن وسجودهن ووضوئهن ومواقيتهن وعلم أنهن حق من عند الله دخل الجنة ، أو قال : وجبت له الجنة ، وفي لفظ : حرم على النار ) )(@)(@@) ( حم طب ) و أبو نعيم ( هب ) عن حنظلة بن الربيع الكاتب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21801 ) قال النبي :(@)(@@) | 30 ( من حافظ على الصلاة كانت له نورا وبرهانا ونجاة يوم القيامة ، ومن لم يحافظ عليها لم يكن له نور ولا برهان ولا نجاة ، وكان يوم القيامة مع قارون وفرعون وهامان وأبي بن خلف ) )(@)(@@) ( حم طب هب ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21802 ) قال النبي :(@)(@@) | 30 ( من حافظ على هاؤلاء الصلوات المكتوبات لم يكن من الغافلين ، ومن قرأ في ليلة مائة آية كتب من القانتين ) )(@)(@@) ( ك هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21803 ) قال النبي :(@)(@@) | 30 ( من حافظ على المكتوبات فليس من الغافلين ، ومن قرأ في ليلة ثلاثين آية كتب من القانتين ) )(@)(@@) ( ص ) عن جبير بن نفير مرسلا .(@)(@@)(@@)(@@) $ ( 21804 ) قال النبي :(@)(@@) | 30 ( من حالت شفاعته دون حد من حدود الله فهو مضاد الله في أمره ، ومن أعان على خصومة بغير حق فهو مستظل في سخط الله حتى يترك ، ومن قفا مؤمنا أو مؤمنة حبسه الله في ردغة الخبال عصارة أهل النار ، ومن 
ms2338	 مات وعليه دين أخذ لصاحبه من حسناته ، لا دينار ثم ولا درهم وركعتي الفجر حافظوا عليهما فإن فيهما من الفضائل ) )(@)(@@) ( حم ) عن ابن عمر رضي الله عنهما .(@)(@@) PageV07P190(@)(@@)(@@)(@@) $ ( 21805 ) قال النبي :(@)(@@) | 30 ( من حبس طعاما أربعين يوما ثم أخرجه فطحنه وخبزه وتصدق به لم يقبله الله منه ) )(@)(@@) الخطيب عن دينار عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21806 ) قال النبي :(@)(@@) | 30 ( من حبس فرسا في سبيل الله كان سترة من النار ) )(@)(@@) عبد بن حميد عن زيد بن ثابت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21807 ) قال النبي :(@)(@@) | 30 ( من حبس العنب أيام قطافه حتى يبيعه من يهودي أو نصراني ليتخذه خمرا فقد تقحم النار عيانا ) )(@)(@@) ( هب ) عن بريدة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21808 ) قال النبي :(@)(@@) | 30 ( من حبس العنب زمن القطاف حتى يبيعه من يهودي أو نصراني وممن يعلم أنه يتخذه خمرا فقد تقدم في النار على بصيرة ) )(@)(@@) ( هب ) عن بريدة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21809 ) قال النبي :(@)(@@) | 30 ( من حتم على الله عز وجل أكذبه ) )(@)(@@) أبو نعيم عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21810 ) قال النبي :(@)(@@) | 30 ( من حثا على ميت حثوة كتب الله بكل ثراة حسنة ) )(@)(@@) زكريا السباخي في أخبار الأصمعي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21811 ) قال النبي :(@)(@@) | 30 ( من حثا على مسلم أو مسلمة احتسابا كتب له بكل ثراة حسنة ) )(@)(@@) أبو الشيخ عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21812 ) قال النبي :(@)(@@) | 30 ( من حج واعتمر فمات من سنته دخل الجنة ) )(@)(@@) الديلمي عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21813 ) قال النبي :(@)(@@) | 30 ( من حج عن والديه بعد وفاتهما كتب الله له عتقا من النار ، وكان للمحجوج عنهما أجر حجة تامة من غير أن ينقص من أجورهما شيء ، وما وصل ذو رحم رحمه بأفضل من حجة يدخلها عليه بعد موته في قبره ومن مشى عن راحلته عقبة فكأنما أعتق رقبة ) )(@)(@@) ( هب ) وضعفه ، و ابن عساكر عن PageV07P191 عبد العزيز بن عبيد الله بن عمرو عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 21814 ) قال النبي :(@)(@@) | 30 ( من حج عن أبيه 
ms2339	 وعن أمه أجزأ ذالك عنه وعنهما ) )(@)(@@) ( طب ) عن زيد بن أرقم رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21815 ) قال النبي :(@)(@@) | 30 ( من حج بمال حرام فقال : لبيك اللهم لبيك ، قال الله عز وجل له : لا لبيك ولا سعديك وحجك مردود عليك ) )(@)(@@) الشيرازي في الألقاب ، أبو مطيع في أماليه عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21816 ) قال النبي :(@)(@@) | 30 ( من حج من مال حلال أو من تجارة ، أو من ميراث ، لم يخرج عن عرفة حتى تغفر ذنوبه وإذا حج من مال حرام فلبى قال الرب : لا لبيك ولا سعديك ثم تلف فيضرب بها وجهه ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21817 ) قال النبي :(@)(@@) | 30 ( من حج من مكة ماشيا حتى يرجع إلى مكة ، كتب الله تعالى له بكل خطوة سبعمائة حسنة من حسنات الحرم ، قيل : وما حسنات الحرم ؟ قال : كل حسنة مائة ألف حسنة ) )(@)(@@) ( قط ) في الأفراد ، ( طب ك ) وتعقب ( هب هق ) وضعف عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21818 ) قال النبي :(@)(@@) | 30 ( من حج عن ميت فللذي حج عنه مثل أجره ، ومن فطر صائما فله مثل أجره ، ومن دل على خير فله مثل أجر فاعله ) )(@)(@@) الخطيب عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21819 ) قال النبي :(@)(@@) | 30 ( من حج منكم فليهل بهما جميعا : بحجة وعمرة ) )(@)(@@) ( طب ) عن أم سلمة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 21820 ) قال النبي :(@)(@@) | 30 ( من حج البيت ولم يزرني فقد جفاني ) )(@)(@@) ( حب ) في الضعفاء ، و الديلمي عن ابن عمر رضي الله عنهما وأورده ابن الجوزي في PageV07P192 الموضوعات فلم يصب .(@)(@@)(@@)(@@) $ ( 21821 ) قال النبي :(@)(@@) | 30 ( من حج عن ميت كتب عن الميت وكتب للحاج براءة من النار ) )(@)(@@) الديلمي عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21822 ) قال النبي :(@)(@@) | 30 ( من حج إلى مكة ثم قصدني في مسجدي كتب له حجتان مبرورتان ) )(@)(@@) الديلمي عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21823 ) قال النبي :(@)(@@) | 30 ( من حج ولم تقبل حجته شكر الله له زيارة الكعبة ) )(@)(@@) الديلمي عن البراء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21824 ) قال النبي :(@)(@@) | 30 ( من حج وعليه دين 
ms2340	 قضا الله عنه ) )(@)(@@) أبو نعيم عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21825 ) قال النبي :(@)(@@) | 30 ( من حدث عني حديثا هو لله عز وجل رضى فأنا قلته وإن لم أكن قلته ) )(@)(@@) ( كر ) عن البختري بن عبد الطائي عن أبيه عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21826 ) قال النبي :(@)(@@) | 30 ( من حدث عني وكذب علي فليبتوأ مقعده من النار ) )(@)(@@) أبو نعيم في المعرفة عن طلحة بن عبيد الله رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21827 ) قال النبي :(@)(@@) | 30 ( من حدث عني حديثا كذبا متعمدا فليتبوأ مقعده من النار ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21828 ) قال النبي :(@)(@@) | 30 ( من حدث حديثا كما سمع فإن كان برا وصدقا فلك وله ، وإن كان كذبا فعلى من بدأ ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21829 ) قال النبي :(@)(@@) | 30 ( من حدث حديثا لا يحب أن يفشى عليه فهو أمانة وإن لم يستكمله صاحبه ) )(@)(@@) ( طب ) عن عبد الله بن سلام ( طب ) عن أبي الدرداء رضي الله عنه .(@)(@@) PageV07P193(@)(@@)(@@)(@@) $ ( 21830 ) قال النبي :(@)(@@) | 30 ( من حدث عني ما لم أقل أو قصر عن شيء أمرت به فليتبوأ بيتا في النار ) )(@)(@@) ( عق ) عن أبي بكر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21831 ) قال النبي :(@)(@@) | 30 ( من حرس وراء المسلمين في سبيل الله متطوعا لا يأخذه سلطان ، لم ير النار بعينيه إلا تحلة القسم ، فإن الله يقول : وإن منكم إلا واردها ) )(@)(@@) ( حم خ ) في تاريخه ( ع طب ) عن معاذ بن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21832 ) قال النبي :(@)(@@) | 30 ( من حرم حظه من الرفق فقد حرمه الله حظه من خير الدنيا والآخرة ، ومن أعطي حظه من الرفق فقد أعطي حظه من خير الدنيا والآخرة ) )(@)(@@) الحكيم عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 21833 ) قال النبي :(@)(@@) | 30 ( من حسد عليا فقد حسدني ، ومن حسدني فقد كفر ) )(@)(@@) ابن مردويه عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 21834 ) قال النبي :(@)(@@) | 30 ( من حسن ظنه بالناس كثرت ندامته ) )(@)(@@) ( كر ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 21835 ) قال النبي :(@)(@@) | 30 ( من حسنت صلاته ، وقل ماله ، وكثر عياله 