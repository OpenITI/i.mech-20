ms121	 الشعر حتى نظمته % فما البيت الا مثل قصر مشيد % 76(@)(@@) % وأخملت أرباب القريض كأنني % % أدرت على أسماعهم كأس مرقد % 77(@)(@@) % فلا زلت مخدوم المقام مخلدا % ومن يكتسب هذا الثناء يخلد % % 78(@)(@@) % شكرتك حتى لم تدع لي لفظة % وكدت بأن أشكوك في كل مشهد % % 79(@)(@@) % لأنك قد أوهنت جهدي باللهى % % وأنسيتني أهلي وأكثرت حسدي % % PageV01P558 البحر : - 1(@)(@@) % تحلو الثغور بذكرك المتردد % % حتى أهم بلثم ثغر مفندي % % 2(@)(@@) % وأراك تتهمني بصبر لم يكن % % يا متهمي هلا وصالك منجدي % % 3(@)(@@) % آها لمقلتك الكحيلة إنها % % نهبت سويدا كل قلب مكمد % % 4(@)(@@) % تلك التي للسكر فيها حانة % % قالت لحسنك في الخلائق عربد % % 5(@)(@@) % دعجاء ساحرة لأن لحاظها % % تفري جوانحنا بسيف مغمد % % 6(@)(@@) % حظي من الدنيا هواي بجفنها % % يا شقوتي منها بحظ أسود % % 7(@)(@@) % عجبا لوجهك وهو أبهى كوكب % % كم ذا يحار عليه قلب المهتدي % % 8(@)(@@) % من لي بيوم من وصالك ممكن % % ولو أنه يوم الحمام بلا غد % % 9(@)(@@) % ولخدك القاضي بمنع زكاته % % عني وقد أثرت يداه بعسجد % % 10(@)(@@) % رفقا بناظري الجريح فقد جرى % % ما قد كفى من غيرة وتسهد % % PageV01P559 11(@)(@@) % وحشاشة لم يبق فيها للأسى % % والهم الا نبذة وكأن قد % % 12(@)(@@) % هذي يدي في الحب انك قاتلي % % طوع الغرام وان حسنك لا يدي % % 13(@)(@@) % لو كان غير الحب كان مؤيدا % بمقام منصور اللقاء مؤيد % % 14(@)(@@) % ملك تصدى للوفود بمنزل % % يروى بلثم ترابه قلب الصدى % % 15(@)(@@) % متنوع الآلاء أغنى بالندى % % وسطا فكيف المعتفي والمعتدي % % 16(@)(@@) % وسرت لهاه لكل قاطن منزل % % سري الخيال إلى جفون الهجد % % 17(@)(@@) % لو كان للأمواه جود بنانه % % لطوت ركاب السفر عرض الفرفد % % 18(@)(@@) % ولو أن راحته تمر على الصفا % % لارتاح للمعروف قلب الجلمد % % 19(@)(@@) % لا تستقر بكفه أمواله % % فكأنها نوم بمقلة أرمد % % 20(@)(@@) % حبا لاسداء الصنائع والندى % % وهوى بأبكار العلى والسؤدد % % PageV01P560 21(@)(@@) % قضت مكارمه مآرب حبه % % فلو أن قاصده درى لم يحمد % % 22(@)(@@) % وحمى فجاج الأرض منه لهمة % قالت لجفن السيف دونك فارقد % % 23(@)(@@) % كم أنشرت جدواه فينا حاتما % ولكم كفانا بأسه دهرا 
ms122	 عدي % % 24(@)(@@) % مالا بن شاد في العلى ند وسل % % عما ادعيت سنا الكواكب يشهد % % 25(@)(@@) % بين المكارم والعلوم فلا ترى % % بحماه إلا سائلا أو مقتدي % % 26(@)(@@) % أقواله للمجتني ونكاله % % للمجتري ونواله للمجتدي % % 27(@)(@@) % في كل عام لي إليه وقادة % تغني قصيدي عن سواه ومقصدي % % 28(@)(@@) % نعم المليك متى ينادى في الورى % % لعلى فيالك من منادى مفرد % % 29(@)(@@) % واصلت قولي في ثناه فحبذا % % متوحد يثني على متوحد % % 30(@)(@@) % إن لم يكن هذا الحمى العالي فمن % % لنظام هذا اللؤلؤ المتبدد % PageV01P561 31(@)(@@) % يا أيها الملك المهنى دهره % % صم الف صوم بالهنآء وعيد % % 32(@)(@@) % واملك من العمر المؤيد خلعة % ما تنتهي في العين حتى تبتدي % % PageV01P562 البحر : - 1(@)(@@) % نجم تولد بين الشمس والأسد % هنئت بالوالد الأزكى وبالولد % 2(@)(@@) % ودام ملكك مضروبا سرادقه % % على ضروب التهاني آخر الأبد % % 3(@)(@@) % يا حبذا الملك قد مدت سعادته % % ما شئت من عضد سام إلى عضد % % 4(@)(@@) % وحبذا بيت اسماعيل مرتفعا % على قواعد أمست جمة العدد % 5(@)(@@) % جاء البشير بنجل النجل مقتبلا % فيالها من يد موصولة بيد % % 6(@)(@@) % فرع من الدوحة العلياء مطلع % % مع أنه من ثمار القلب والكبد % % 7(@)(@@) % مدت اليه المعالي كف حاضنة % وضمه الملك ضم الروح بالجسد % % 8(@)(@@) % وماست السمر بالاعجاب وابتسمت % % بيض السيوف وقرت أعين الزرد % % 9(@)(@@) % وغردت بأغانيها القسي على % % أوتارهن غناء الطائر الغرد % % 10(@)(@@) % واستشرف القلم العالي للثم يد % عريقة سوف تعلو فوق كل يد % % PageV01P563 11(@)(@@) % واختالت الخيل من زهو فوقرها % % ما سوف تحمل من عزم ومن جلد % % 12(@)(@@) % كأنني بفتى المنصور ممتطيا % جيادها الغر في فرسانه النجد % % 13(@)(@@) % نحو الغزاة ونحو الصيد يعملها % % إما الطراد وإما لذة الطرد % % 14(@)(@@) % لله كوكب سعد في سماء على % لو حل في الافق لم يظل على أحد % % 15(@)(@@) % له مخايل من مجد تكلمنا % % في مهده بلسان الحلم والرشد % % 16(@)(@@) % تكاد تنضو وشاحيه حمائله % % وتنزع الدرع عنه القمط من حسد % % 17(@)(@@) % عصائب الملك أولى من عصائبه % % فهن من غيرة في زي مرتعد % % 18(@)(@@) % يا آل أيوب بشراكم بوجه 
ms123	 فتى % مظفر الحد طلاع على نجد % % 19(@)(@@) % يروي حديث المعالي عن أب فأب % رواية التبر في ألحاظ منتقد % % 20(@)(@@) % هذا المؤيد صان الله دولته % % قل في مناقبه الحسنى ورد وزد % % PageV01P564 21(@)(@@) % ملك له في ظلال العز منزلة % ترنو اليه نجوم الفلك من صعد % % 22(@)(@@) % محكم الأمر للأقلام في يده % % وللسيوف مقام الركع السجد % % 23(@)(@@) % وناشر بنداه كل قافية % أخنى عليها الذي أخنى على لبد % % 24(@)(@@) % ذاك الذي في حماه نبع أنعمه % % وقلب حاسده للهم في صعد % % 25(@)(@@) % حدثت عن فضله ثم استندت له % % فلا عدمت أحاديثي ولا سندي % % 26(@)(@@) % وقمت أكسو بنيه من مدائحه % % ما يرفل الملك في أثوابه الجدد % % 27(@)(@@) % الحمد لله أحياني وأمهلني % % حتى بلغت بعمري أكرم الأمد % % 28(@)(@@) % للجد والأب والابن امتدحت فيا % % فوزي بها كلها أبهى من الشهد % % 29(@)(@@) % كأنما الملك المنصور واسطة % % وليس في العقد در غير منفرد % % 30(@)(@@) % ذو الجود والبأس في يومي ندى وردى % % مابين منسجم يوما ومتقد % PageV01P565 31(@)(@@) % والسيف والرمح لا يهوى لغيرهما % % لمى من الثغر أو نوعا من الغيد % % 32(@)(@@) % ونبعة الملك قد طالت وقد رسخت % % فالناس من ظلها في عيشة رغد % % 33(@)(@@) % هنئت يا ابن علي في الفخار بها % % ومن يقسك بمنصور ومعتضد % % 34(@)(@@) % لولا مديحك مااخترت القريض ولا % % والله ما دار في فكري ولا خلدي % % 35(@)(@@) % سددت رأيا حباك العز متضحا % فزادك الله من عز ومن سدد % % PageV01P566 البحر : - 1(@)(@@) % أهواه فتان اللواحظ أغيدا % % ترك الغزال من الحياء مشردا % % 2(@)(@@) % ولأجله الاغصان مالت من صبا % والبدر طول الليل بات مسهدا % % 3(@)(@@) % وأغن أقسم لا عصيت عصابة % تدعو اليه ولا أطعت مفندا % % 4(@)(@@) % نشوان من خمر الصبي ودلاله % فاذا تثنى أو تجني عربدا % % 5(@)(@@) % أنا من رأى نارا على وجناته % % تذكو فآنس من جوانبها هدى % % 6(@)(@@) % أبدا أميل إلى لقاه وإن جفا % % وتحن أحشائي له وإن اعتدى % % 7(@)(@@) % واطول أشجاني بطرف فاتر % ترك الفؤاد بناره متوقدا % % 8(@)(@@) % ومورد الوجنات لولا حسنه % % لم يجر دمعي في هواه موردا % % 9(@)(@@) % شدت مناطقه معاطف 
ms124	 قده % % فضممت حرف اللين منه مشددا % % 10(@)(@@) % وبليت منه بدور عشق دائم % مثل الهلال اذا استسر تجددا % % PageV01P567 11(@)(@@) % قد أقسمت أحشاي لا تدع الاسى % % كأنامل المنصور لا تدع الندى % % 12(@)(@@) % أبهى الورى خلقا وأبهر منظرا % وأجل آلاء واكرم مولدا % % 13(@)(@@) % ملك يغار البدر لما يجتلى % % ويذيب قلب الغيث لما يجتدى % % 14(@)(@@) % في وجهه للملك نور سعادة % تعشو له الآمال واجدة هدى % % 15(@)(@@) % فرع يخبر عن مبادي أصله % % يا حبذا خبر لديه ومبتدا % % 16(@)(@@) % طالت يداه إلى مآثر بيته % % فحبت مكارمه بكل يد يدا % % 17(@)(@@) % ذو همة في الفضل يحكم يومها % % ويريك أحكم من فواصلها غدا % % 18(@)(@@) % وشجاعة تنضي السيوف صقيلة % والى المعامع ربها يشكو الصدى % % 19(@)(@@) % يزداد معنى بيته حسنا به % % فكأنه بيت القريض مولدا % % 20(@)(@@) % ويشيم ما سنى أبوه من العلا % % لا قاصرا عنه ولا متبلدا % % PageV01P568 21(@)(@@) % ما شاد اسماعيل بيت فخاره % % إلا ليستدعي إليه محمدا % % 22(@)(@@) % سار على منهاجه فإذا رأت % % عيناك منصورا رأيت مؤيدا % % 23(@)(@@) % ياابن الذي ملأ الوجود مواهبا % والأفق ذكرا والصحائف سوددا % % 24(@)(@@) % شرفت شعري ذاكرا وأنرته % % حتى كأن بكل حرف فرقدا % % 25(@)(@@) % فلأهدين فريدة لممدح % % أضحى بنيل نداه شعري مفردا % % 26(@)(@@) % حسب ابن شاد أن يراني للثنا % % عبدا وحسبي أن أراه سيدا % % PageV01P569 البحر : - 1(@)(@@) % صدودك يالمياء عني ولا البعد % إذا لم يكن من واحد منهما بد % 2(@)(@@) % بروحي من لمياء عطف إذا زها % % على الغصن قال الغصن ما أنا والقد % 3(@)(@@) % وعنق قد استحسنت دمعي لأجلها % % وفي العنق الحسناء يستحسن العقد % % 4(@)(@@) % من العرب إلا أن بين جفونها % % أحد شبا مما يجرده الهند % % 5(@)(@@) % على مثلها يعصى العذول وانما % % يطاع على أمثالها الشوق والوجد % % 6(@)(@@) % عزيز على العذال عني صرفها % % وللقلب في دينار وجنتها نقد % % 7(@)(@@) % أعذالنا مهلا فقد بان حمقكم % % وقد زاد حتى ما لحمقكم حد % % 8(@)(@@) % وقلتم قبيح عندنا العشق بالفتى % % ومن أنتم حتى يكون لكم عند % 9(@)(@@) % سمحت بروحي للحسان فما لكم % % وما لي وما هذا التعسف والجهد % % 10(@)(@@) % وثغر يتيم 
ms125	 الدر سلم مهجتي % % فأتلفها من قبل ما ثبت الرشد % % PageV01P570 11(@)(@@) % هو البرد الأشهى لغلة هائم % أو الطلع أو نور الأقاحي أو الشهد % % 12(@)(@@) % ومرشفه المن الذي لا يشو به % % سلوي أو الراح الشمول أو النهد % % 13(@)(@@) % عهدت الليالي حلوة بارتشافه % % وهن الليالي لا يدوم لها عهد % % 14(@)(@@) % فلا ابتسم البرق الذي كان بالحمى % % غداة تفرقنا ولا قهقهة الرعد % % 15(@)(@@) % تولت شموس الحي عنه ففي العلى % % سناها وفي أكباد عشاقها الوقد % % 16(@)(@@) % وكم ذابح للصب يوم تحملوا % % بأخبية غنى بها للسرى سعد % % 17(@)(@@) % فيا قلب جهدا في التحرق بعدهم % % وهذا لعمري جهد من لا له جهد % 18(@)(@@) % وياد مع فض وجدا بذكر خدودهم % % فإنك ماء الورد إن ذهب الورد % % 19(@)(@@) % رعى الله دهرا كنت فارس لهوه % % أروح إلى وصل الأحبة أو أغدو % % 20(@)(@@) % جوادي من الكاسات في حلبة الهنا % % كميت وإلا من صدور المها نهد % % PageV01P571 21(@)(@@) % وفي عضدي بدر الجمال موسد % وقد قدحت للراح في خده زند % 22(@)(@@) % وعيشي مأمون الطباق الذي أرى % % فلا الشعر مبيض ولا الحال مسود % % 23(@)(@@) % زمان تولى بالشبيبة وانقضى % % وفي في طعم من مجاجته بعد % 24(@)(@@) % يزول وما زالت مذاقته الصبى % % و يبلى وما تبلى روائحه البرد % 25(@)(@@) % له أبدا مني التذكر والأسى % % و للأفضل الملك القصائد والقصد % 26(@)(@@) % بكم آل أيوب غنينا عن الورى % % فلم نجد الأمداح فيهم ولم يجدوا % % 27(@)(@@) % أتينا لمغناكم تجارا وإنما % % بضائعنا الآمال تعرض والحمد % 28(@)(@@) % فنفقتم سوق الثنا بضنائع % % معجلة للوفد من سبقها وفد % % 29(@)(@@) % ورشم جناح الآملين وطوقت % % رقاب بنعماكم فلا غرو أن تشدو % % 30(@)(@@) % سقى تربة الملك المؤيد وابل % وفي على عهد المعالي له عهد % % PageV01P572 31(@)(@@) % لقد صدقتنا في الزمان وعوده % % وشيمة إسماعيل أن يصدق الوعد % % 32(@)(@@) % وولى وقد أوصى بنا الملك الذي % % أبر على جمع العلى شخصه الفرد % % 33(@)(@@) % فما لبني أيوب ند من الورى % % وما في بني أيوب عندي له ند % 34(@)(@@) % مليك له في الملك أصل ومكسب % وحظ فنعم الجد والجد والجد % 35(@)(@@) % حوته العلى 
ms126	 قبل الحجور وهزه % حديث الثنا من قبل ما هزه المهد % % 36(@)(@@) % وغذته للعلياء قبل لبانه % لبانا لها من مثله مخض الزبد % 37(@)(@@) % فجاء كما ترضى السيادة والعلى % % وحيدا على أبوابه للورى حشد % 38(@)(@@) % رعى خلقه رب العباد وخلقه % % فحسن ما يخفى لديه وما يبدو % % 39(@)(@@) % ألم ترني يممت كعبة بيته % % لحج ولائي لا سواع ولا ود % 40(@)(@@) % علقت بحبل من حبال محمد % % أمنت به من طارق الدهر أن يعدو % % PageV01P573 41(@)(@@) % ويممت مغناه بركب مدائح % % يسيل بها غور ويطفو بها نجد % % 42(@)(@@) % من اللاء أجدى كثرها فتكاثرت % % لدي بها الأتباع والأصل والولد % 43(@)(@@) % وأعجبني المرعى الخصيب ببابه % % فحالي به الأهنى وعيشي به الرغد % % 44(@)(@@) % أيا ملكا لولا حماه وجوده % لما ملح المرعى ولا عذب الورد % 45(@)(@@) % تجمع في علياك كل مفرق % % من الوصف حتى الضد يظهره الضد % 46(@)(@@) % فقربك والعليا وحلمك والسطا % % وحزمك والجدوى وملكك والزهد % % 47(@)(@@) % وعنك استفاد الناس مدحا بمثله % % على الشب يشدو أوعلى الركب اذ يحدو % % 48(@)(@@) % فدونكها مني على البعد غادة % يظل عبيدا وهو من خلفها عبد % 49(@)(@@) % على أنها تحتك منك بناقد % يرجى له نقد ويخشى له نقد % % 50(@)(@@) % عريق العلى ألفاظه كد روعه % غدا والوغى والسلم بحكمه سرد % % PageV01P574 51(@)(@@) % حمى الله من ريب الحوادث ملكه % ولا زال للأقدار من حوله جند % % 52(@)(@@) % هو الكافل الدنيا بأنعمه فما % % يحس لمفقود بأيامه فقد % % 53(@)(@@) % وإني وإن أخرت سعيا لأرتجي % % عوائد من نعماه تسعى بها البرد % % 54(@)(@@) % إذا المرء لم يشدد إلى الغيث رحله % % أتى نحو مغناه حيا الغيث يشتد % % 55(@)(@@) % وماأنا إلا العبد ما في رجائه % % ولا ظنه عيب ولا يمكن الرد % % PageV01P575 البحر : - 1(@)(@@) % مسلسل الدمع أسير الفؤاد % % يهيم بالتذكار في ألف واد % % 2(@)(@@) % مجتهد الاوقات في حبكم % % وهو مع الواشي بكم في جهاد % % 3(@)(@@) % ما عقد الليل لأجفانه % % هدبا ولا حل عقود الوداد % % 4(@)(@@) % ياعاذلي فات حديث الأسى % % فما حديث العذل بالمستفاد % % 5(@)(@@) % دع أدمعي بالجود فياضة % فالسابق السابق منها الجواد % % 6(@)(@@) % رب ليال لو بلغت 
ms127	 المنى % % فديتها من ناظري بالسواد % % 7(@)(@@) % مضت بلذاتي واستخلفت % % لياليا ألبسها كالحداد % % 8(@)(@@) % إن يغد رأسي أشهبا بعد ما % % باد الصبى فالعذر كالصبح باد % % 9(@)(@@) % مات الصبى واحترقت مهجتي % % ففوق رأسي قد نثرت الرماد % % 10(@)(@@) % مقسم الاحشاء بين الأسى % % كأنعم الأفضل بين العباد % % PageV01P576 11(@)(@@) % الملك العابد نام الورى % % بعدله وهو كثير السهاد % % 12(@)(@@) % ذو الجود في عسر ويسر ومن % % مثل ذوي التجريب في كل ناد % % 13(@)(@@) % والهيبة العظمى التي أصلحت % % بذكرها السائر أهل الفساد % % 14(@)(@@) % من اتقى الله اتقت بأسه % % كواسر الافق وغلب الوهاد % % 15(@)(@@) % بين كتاب ومصلى اذا % % أمسى سواه بين كأس وشاد % % 16(@)(@@) % قد ساد من قبل الصبى سابقا % قولهم السودد قبل السواد % % 17(@)(@@) % وحاز بيت المال من ارثه % % فشد مبناه وأوفى وزاد % % 18(@)(@@) % أحسن به بيتا نظيم العلى % % بلا زحاف في الثنا أو سناد % % 19(@)(@@) % بين ملوك خلصت بيضهم % % دين الهدى من أهل دين العناد % % 20(@)(@@) % وانشروا الآمال بعد البلى % % ونفقوا الأشعار بعد الكساد % % PageV01P577 21(@)(@@) % يا ملكا أصبح في الدين والد % % نيا سعيد الجد والاجتهاد % % 22(@)(@@) % عش كسليمان على ملكه % % تعرض هذي الصافنات الجياد % % PageV01P578 البحر : - 1(@)(@@) % هلال بأفق الملك تزهى سعوده % % وشبل بغاب السمر تربى أسوده % % 2(@)(@@) % وفرع على تهتز أعطاف نجده % % وينفح أبناء المحامد عوده % % 3(@)(@@) % تباشرت الدنيا به وتنافست % % مراتبه في شخصه ومهوده % % 4(@)(@@) % وسر بني أيوب أن مقامهم % % محافظة عاداته وعهوده % % 5(@)(@@) % إذا غاب ملك لم يغب غير شخصه % % وقام ابنه من بعده وحفيده % % 6(@)(@@) % فيا لك بيتا في الفخار سعيده % % بنوه على حالاته وجدوده % % 7(@)(@@) % هنيئا لبيت الفضل أن عماده % % مقيم وأن الملك باق عميده % % 8(@)(@@) % وأن وليد الأفضل الملك قد محا % % عن الناس حزنا لا ينادى وليده % % 9(@)(@@) % سمعنا به في شهر شعبان فانتهت % % لنا والعدى حلواؤه ووقوده % % 10(@)(@@) % يكاد قبيل المهد تعلو سروجه % % وتنشر من قبل القماط بنوده % % PageV01P579 11(@)(@@) % ويهتز للجدوى وما هز مهده % % به وتناغى بالهبات وفوده % % 12(@)(@@) % شبيه أبيه في الفخار وجده % % فيا لقديم قد تلاه جديده % % 13(@)(@@) % سقى 
ms128	 الله مثوى جده كل مزنة % تضوع بها ضوع الرياض لحوده % % 14(@)(@@) % وأبقى أباه للسيادة والعلى % % تنال عطاياه وتحمى جنوده % % 15(@)(@@) % وأنشأه في الجود والبأس نشأة % يبيد بها تبر الثرى وحديده % % 16(@)(@@) % أما والأيادي الأفضلية إنها % % تحمل جهد الحمد حتى تؤوده % % 17(@)(@@) % لقد نهضت علياه نهضة ماجد % قصي مداه فائضات مدوده % % 18(@)(@@) % مضيء وما في الأفق برق نشيمه % % مفيء وما في الأرض خصب نروده % % 19(@)(@@) % له عزمات في العلى شادوية % لها أبدا من كل عزم سديده % % 20(@)(@@) % فما همها إلا ضعيف تسوسه % % بفضل نداها أو قوي تسوده % % PageV01P580 21(@)(@@) % مقسمة أقلامه وسيوفه % لنعماء يبديها وطاغ يبيده % % 22(@)(@@) % عزيز على الساعي مداه وهذه % % مهابته عصر الشباب وجوده % % 23(@)(@@) % إذا كان حرب فهو سفاح يومه % % وإن كان رأي غامض فرشيده % % 24(@)(@@) % يرجيه من بحر القريض سريعه % % فيلقاه من بحر النوال مديده % % 25(@)(@@) % يساويه في حق العلى مشتبه % إذا ما تساوى سبطه ويزيده % % 26(@)(@@) % ويسمى سعيدا دهره ومباركا % فصح لنا أن الدهور عبيده % % 27(@)(@@) % تسوق إليه كل سعد يشاؤه % % و تخدمه في كل أمر يريده % % 28(@)(@@) % فلو أننا في يوم قصد جنابه % % سألنا شباب العمر كاد يعيده % % 29(@)(@@) % فلو أن أقمار السماء تحجبت % % لأغنى سراة الليل عنها وجوده % % 30(@)(@@) % ولو أنه لم يحشد الجيش للوغى % % كفته سطاه أن يجر حسوده % % PageV01P581 31(@)(@@) % ألا إن سلطان المعالي محمدا % لمشكور سعي المكرمات حميده % % 32(@)(@@) % فليت عماد الدين يبصر نسله % % و قد جل مسعاه وزاد عديده % 33(@)(@@) % وما هو إلا بيت ملك منظم % فمن أجل ذا أيامه تستعيده % % 34(@)(@@) % أأزكى الورى نفسا وأكرم معشرا % و أمكنهم من سؤدد تستجيده % % 35(@)(@@) % بكم غنيت حالي عن الناس وازدهى % % نظام كلامي فيكمو وفريده % % 36(@)(@@) % فما الدر إلا دون نظم أنصه % % و ما القصر إلا دون بيت أشيده % % PageV01P582 البحر : - 1(@)(@@) % اليك مدير الكاس عني إنني % % رأيت دموع الخوف تقطع للصدى % % 2(@)(@@) % وإياك باللمياء يشرق خدها % % فإني لم آنس على ناره هدى % % 3(@)(@@) % نزعت فلا الساقي لدي براكع % وليست أباريق المدامة سجدا % % 4(@)(@@) % وما 
ms129	 أنا بالساعي لمحراب طرة % على طلعة كانت لعشقي مشهدا % % 5(@)(@@) % كفى ما استبنت اليوم لي من جرائم % إذا لم أبدلها فيا خجلي غدا % % 6(@)(@@) % إلهي قد مد الرجا يد قاصد % وجودك أولى أن تبلغه يدا % % 7(@)(@@) % وقدمت آباء ونسلا فكيف لي % % بباقية والأصل والفرع قد غدا % % 8(@)(@@) % وفاض ولي من دموعي فعله % % يكون وليا للإنابة مرشدا % % 9(@)(@@) % بوحي إنسانا قبلنا قد تقدموا % % ونادوا بنا لو أننا نسمع الندا % % 10(@)(@@) % وسارت بهم سير المطي نعوشهم % % وبعض أنين القادمين لهم حدا % % PageV01P583 11(@)(@@) % وأمسوا على البيداء بنتظروننا % % إلى سفر يقضي بأن نتزودا % % 12(@)(@@) % فريدون في أجداثهم بفعالهم % % وكم منهم من ساق جندا مجندا % % 13(@)(@@) % تساووا عدى تحت الثرى وأحبة % فلا فرق ما بين الأحبة والعدى % % 14(@)(@@) % سل الدهر هل أعفى من الموت شائبا % غداة أدار الكاس أم رد أمردا % % 15(@)(@@) % وهل أبقت الأيام للعلم والعلى % % وبذل الندى ذاك المليك المؤيدا % % 16(@)(@@) % وهل تركت للسؤدد ابن عليه % % وهل قبلت منا الفدى لآبي الفدا % % 17(@)(@@) % غياث الورى يومي رجا ومخافة % شهاب العلى نجم الهدى كوكب الندى % % 18(@)(@@) % ألا في سبيل الله نصل عزائم % % وعلم غدا في باطن الأرض مغمدا % % 19(@)(@@) % على الرغم منا أن خبا منه رونق % وجاوبنا من حول تربته الصدى % % 20(@)(@@) % غنينا زمانا في ظلال نواله % % فلله ما أغنى زمانا وأرغدا % % PageV01P584 21(@)(@@) % نزور حمى ما لامس الخطب جاره % % ونجني عطا مارد من لامس يدا % % 22(@)(@@) % ونمدح معتاد المديح وإنما % % لكل امريء من دهره ما تعودا % % 23(@)(@@) % إلى أن قضى الدنيا سعيدا مؤملا % وعاد إلى الأخرى شهيدا ممجدا % % 24(@)(@@) % وخلف اسماعيل أركان بيته % % مؤسسة يدعو اليها محمدا % % 25(@)(@@) % مليك حوى في الملك أفضل وصفه % % فيا حبذا نعتا ونفسا ومحتدا % % 26(@)(@@) % له همة تواقة شادوية % إذا صعدت تاقت لأشرف مصعدا % % 27(@)(@@) % اذا بلغت في الملك دار نعيمه % % أبى عزمه الا النعيم مخلدا % % 28(@)(@@) % فكم هاجد تحت الثرى ومحمد % أخو الملك أمسى ساهدا متهجدا % % 29(@)(@@) % تزهد حيث العمر والملك مقبل % وقد قل من لاقاهما متزهدا % % 30 
ms130	(@)(@@) % فديناه مهديا لحال رشيدة % وقل لذاك الفضل بالأنفس الفدى % % PageV01P585 31(@)(@@) % رعى لي في الملك المؤيد ذمة % ولم ينس لي فيه قصيدا ومقصدا % % 32(@)(@@) % وأشهدني عهد الشهيد بأنعم % أبى عطفها أن لا يكون مؤكدا % % 33(@)(@@) % أيا ملكا ندعوه للسلم والوغى % % وللدين والدنيا وللجد والجدا % % 34(@)(@@) % أيا سالك التقوى طريقا منيرة % ويا باني المعروف حصنا مشيدا % % 35(@)(@@) % ويا واضعا في كفه السيف لم يضر % % علاه بوضع السيف في موضع الندى % % 36(@)(@@) % على أبرك الأوقات تسري لمقصد % وترجع موفور العلى متزيدا % % 37(@)(@@) % عوائد لطف الله فيك جميلة % فلا تدفع الرجوى ولا تحذر العدى % % 38(@)(@@) % فكم سرت محمود المسير مهنأ % وعدت فكان العود أهنى وأحمدا % % PageV01P586 البحر : - 1(@)(@@) % أناعسة الأجفان أسهرت مكمدا % % عسى تكحلي عينيه بالخصر مرودا % % 2(@)(@@) % فيا حبذا للخصر مرود عسجد % جعلت عليه للذوائب إثمدا % % 3(@)(@@) % لئن فهمت عيناك حالي معربا % لقد سل منها الجفن سيفا مهندا % % 4(@)(@@) % وان كان فيك الحسن أصبح كاملا % لقد أصبح اللاحي عليك مبردا % % 5(@)(@@) % وان كنت مع شيبي خليع صبابة % فيا رب يوم من لقاك تجددا % % 6(@)(@@) % و يارب ليل فيه عانقت كاعبا % تذكر صدري نهدها فتنهدا % % 7(@)(@@) % وقيدني احسانها بذوائب % ومن وجد الاحسان قيدا تقيدا % % 8(@)(@@) % فياليتها عندي أتمت جميلها % % فتكتب في قيدي عليه مخلدا % % 9(@)(@@) % زمان الصبى يا لهف حيران بعده % % يظل على اللذات في مصر مبعدا % % 10(@)(@@) % ولو عاودت ذاك الشقي شبيبة % لعاود ذياك النعيم وأزيدا % % PageV01P587 11(@)(@@) % وأشهى اليه من رجوع شبابه % % رجوعك يا قاضي القضاة مؤيدا % % 12(@)(@@) % بدأت بحكم وقت الخلق حمده % % وعدت فكان العود أوفى وأحمدا % % 13(@)(@@) % وكان سرور اليوم في مصر قد فشا % % فكيف وقد أنشأت أضعافه غدا % % 14(@)(@@) % ولم أنس من دار السعادة صحبة % % مباركة الاثنين تطلع أوحدا % % 15(@)(@@) % مدائح لما كان ممدوح مثلها % % تراه البرايا مفردا كنت مفردا % % 16(@)(@@) % أجيد ويجدي عادتينا وانما % % لكل امرء من دهره ما تعودا % % 17(@)(@@) % فدتكم بني السبكي خلق رفعتمو % % فلا أحد إلا اذا لكم الفدا % % 18(@)(@@) % ولا أحد إلا خصصتم برفدكم % % فلا فرق 
ms131	 ما بين الأحبة والعدى % % 19(@)(@@) % وما تخرج الاحكام عنكم لغيركم % % فسيان من قد غاب منكم ومن بدا % % 20(@)(@@) % فلو وكفانا الله ولي غيركم % % لما راح في شيء يجيد ولا غدا % % PageV01P588 21(@)(@@) % وما الشام الا معلم قد ملأته % % بعدلك أحكاما وعلمك مقتدى % % 22(@)(@@) % حكمت بعدل لم تدع فيه ظالما % وصلت بعلم لم تدع فيه ملحدا % % 23(@)(@@) % وجدت إلى ان لم تدع فيه مقترا % % وسدت إلى أن لم تذر فيه سيدا % % 24(@)(@@) % واعطيت في شرخ الصبا كل سؤدد % % إلى أن ظننا أن في المشيب أسودا % % 25(@)(@@) % يقول ثناء الخزرجي وقومه % % لعمرك ما سادت بنو قيلة سدا % % 26(@)(@@) % ولا عيب في أثناء عيبة يلتقي % % سوى سؤدد يضني وشاة وحسدا % % 27(@)(@@) % فدونكها علياء فيكم ترددت % % وعزم اختيار فيكم ما ترددا % % 28(@)(@@) % وهنئتها أو هنئت خلعا إذا % % أضاءت فمن أطواقها مطلع الهدى % % 29(@)(@@) % وان أزهرت بيضا وخضرا رياضها % % وفاحت ففي أكمامها سحب الندى % % 30(@)(@@) % اذا ابن علي سارفي الشعر ذكره % % فقل حسنا زكى قصيدا ومقصدا % % PageV01P589 31(@)(@@) % جوادا أتينا طالبا بعد طالب % % فهذا اجتدى منه وهذا به اقتدى % % 32(@)(@@) % مسافرة أمواله لعفاته % كأن الثنا حاد باظعانها حدا % % 33(@)(@@) % له في العلى باب صحيح مجرب % لعاف رجا خيرا وعاد قد اعتدى % % 34(@)(@@) % فلله ما أشقى الحسود بعيشة % لديه وما أهنى الفقير وأسعدا % % 35(@)(@@) % وكم قابلت رجواي حالا حسبته % % فضاعف لي ذاك الحساب وعددا % % 36(@)(@@) % وكم نقدة من تبره ولجينه % % تخذت لديها كالمنجم مرصدا % % 37(@)(@@) % رأيت بنقديه بياضا وحمرة % فقلت لي البشرى اجتماع تولدا % % 38(@)(@@) % وسدت على نجل الحسين بمدح من % % سأثقل أفراسي بنعماه عسجدا % % 39(@)(@@) % أأندى الورى كفاه وجهة ذي حيا % % على أنه أجدى وجاد وجودا % % 40(@)(@@) % أغار على حالي الزمان بعسفه % % ولكن ندى كفيك في الحال أنجدا % % PageV01P590 41(@)(@@) % وما كنت أبغي في المعيشة مرفقا % فكم من يد في الجود اتبعتها يدا % % 42(@)(@@) % حلفت بمن أنشا بنانك والحيا % % لقد جدت حتى المجتدي بك يجتدى % % 43(@)(@@) % ومن قطع الاطماع من كل حاسد % لقد زدت حتى ما يكون محسدا 
ms132	 % % 44(@)(@@) % ولا خبر في الحلم والعلم والثنا % % تجاه الورى الا وذكرك مبتدا % % 45(@)(@@) % فعش للعلى تاجا يليق بمثله % % فريد الثنا ممن أجاد منضدا % % 46(@)(@@) % ترد الردى عنك المحبون فدية % % تكون لهم في الترب مجدا مؤيدا % % 47(@)(@@) % ولا أرتضي موت العداة فانهم % % ببقياك في عيش أمر من الردى % % PageV01P591 البحر : - 1(@)(@@) % فدى لك مسلوب الرقاد شريده % % يعاوده برح الأسى ويعوده % % 2(@)(@@) % اذا ما ذكا في فحمة الليل بارق % تبين في الأحشاء أين وقوده % % 3(@)(@@) % وان نظمت ريح الصبا عقد حزنه % % تناثر من سلك الجفون فريده % % 4(@)(@@) % وان ألقت الورق السواجع درسها % % أعاد الأسى بين الضلوع معيده % % 5(@)(@@) % بروحي من أعطافه وعذاره % % هي القصد لا بان الحمى وزروده % % 6(@)(@@) % ومن شيبت عشاقه زمن الصبى % % شوائب عشق لا ينادى وليده % % 7(@)(@@) % محا رسم مغناه الغمام وما محا % % لدمعي رسما لا يزال يجوده % % 8(@)(@@) % ورب مدام ثغره وحبابها % % سواء ولفظي والبكا وعقوده % % 9(@)(@@) % شربت على ورد الربى وهو خده % % وإلا على سوسانها وهو جيده % % 10(@)(@@) % ونبهت عيداني بنوح على الدجى % % وما ناح قمري ولا ماس عوده % % PageV01P592 11(@)(@@) % سرورا باقبال الزمان وحبذا % % سرور زمان محكمات سعوده % % 12(@)(@@) % وقد رقمت وشي الربى أبر الحيا % % وجرت على وادي دمشق بروده % % 13(@)(@@) % وعادت وكان العود أحمد دولة % لها النصر إرث زاكيات شهوده % % 14(@)(@@) % يهز ابن فضل الله بيض قواضب % اذا هي هزت في المهارق سوده % % 15(@)(@@) % يوازر رب الملك رب كتابة % كأن طروس الخط منها جنوده % % 16(@)(@@) % ويجري بأمر الملك سود يراعه % % فيا حبذا ساداتنا وعبيده % % 17(@)(@@) % وتبسم ارجاء الثغور مسرة % بأبلج لا تعبان الا حسوده % % 18(@)(@@) % سعيد مساع أو سعيد مناسب % فثقد سعدت في كل حال جدوده % % 19(@)(@@) % و شهم ولكن جنده من سطوره % % وقاض ولكن المعاني شهوده % % 20(@)(@@) % روى فرعه عن دوحة عمرية % قديم فخار لا يشاب جديده % % PageV01P593 21(@)(@@) % فأي فخار أول لا يجده % % وأي فخار آخر لا يجيده % % 22(@)(@@) % وأي مقام في العلى لا يسوسه % % وأي همام في الورى لا يسوده % % 23(@)(@@) % رأيت ابن فضل الله 
ms133	 فاضل دهره % % اذا اعتبرت ألفاظه وسعوده % % 24(@)(@@) % اذا ابن علي وابن يحيى تساجلا % % فقل طارف المجد الرضي وتليده % % 25(@)(@@) % أعادت علاه بيت فضل منظما % فلله بيت طيب يستعيده % % 26(@)(@@) % و علمنا صوغ الكلام بحمده % % فها نحن نحيي لفظه ونعيده % % 27(@)(@@) % و أنقذنا بالبر من وهج حادث % يذوب به من كل عان جليده % % 28(@)(@@) % نظرت أبا العباس نظرة باسم % لحال امرىء كاد الزمان يبيده % % 29(@)(@@) % و كان على حال الحسين من الظما % % إلى ورد غوث والزمان يزيده % % 30(@)(@@) % فأحييته بعد الردى أو أقمته % % وقد طال من تحت التراب هموده % % PageV01P594 31(@)(@@) % و جليتها يا ابن المجلي ضمينة % % خلود الفتى ان الثناء خلوده % % 32(@)(@@) % فدونك من نظمي عجالة مادح % اليك تناهى قصده وقصيده % % 33(@)(@@) % يقال انظروا الممدح وافق مادحا % فذا فاضل الدنيا وهذا سعيده % % PageV01P595 البحر : - 1(@)(@@) % قمرا نراه أم مليحا أمردا % % ولحاظه بين الجوانح أم ردى % % 2(@)(@@) % من آل بدر طلعة أو نسبة % والرقمتين سوالفا أو مولدا % % 3(@)(@@) % آها لمنطقه البديع معربا % ولسيف ناظره الكحيل مهندا % % 4(@)(@@) % لم يجر دمعي في هواه مسلسلا % % حتى ثوى قلبي لديه مقيدا % % 5(@)(@@) % أدعو السيوف صقيلة من لحظه % % واذا دعوت لماه جاوبني الصدى % % 6(@)(@@) % واذا دعوت بنان أحمد جاوبت % % سحب الندى من قبل ما سمع الندا % % 7(@)(@@) % لشهاب دين الله وصف ضاء في % % أفق فقل نجم السمار جم العدى % % 8(@)(@@) % كم صافحت من راحتيه يد امرئ % % عشرا وصبحه الهناء فعيدا % % 9(@)(@@) % يا خير من علقت يدي بولائه % % أقسمت ما سدت الاكارم عن سدى % % 10(@)(@@) % يا مسدي النعمى التي قد أصبحت % % سندا لمن يشكو الزمان ومسندا % % PageV01P596 11(@)(@@) % أحسن بجاهك شافعي يامالكا % % أروي بجود يديه مسند أحمدا % % 12(@)(@@) % كم راحة أوليتها من راحة % % ويد صنعت بها لمفتقر يدا % % 13(@)(@@) % و الله لا أجريت في عدد الورى % % خبر الثنا الا وأنت المبتدا % % 14(@)(@@) % و لقد تزيد شعر من استعفته % % بنداك حسنا في الزمان مجددا % % 15(@)(@@) % و الشعر مثل الروض يعجب حسنه % % لاسيما ان كان قد وقع الندى % % PageV01P597 البحر : - 1(@)(@@) % يا 
ms134	 أهل فضل الله إن لبيتكم % % فضلا يروح له الثناء ويغتدي % % 2(@)(@@) % هذا شهاب سمائكم متوقد % بالذهن فوق الكوكب المتوقد % % 3(@)(@@) % أفعاله ومقاله ونواله % % للمجتلي والمجتني والمجتدي % % 4(@)(@@) % لله كم لك من يد أسديتها % % ما للمدائح في وفاها من يد % % 5(@)(@@) % نطقتني ورفعتني بمكارم % حفظت لدي وأخرست من حسد % % 6(@)(@@) % وأقمتني فيها خطيبا بالثنا % % ومننت حتى باللباس الأسود % % 7(@)(@@) % من مبلغ الأهلين عني أنني % % بدمشق عدت لطيب عيشي الأرغد % % 8(@)(@@) % وأمنت من نار الخطوب ولفحها % % لما لجأت إلى الجناب الأحمدي % % PageV01P598 البحر : - 1(@)(@@) % لحظك في الفتك هو البادي % % يا فتنة الحاضر والبادي % % 2(@)(@@) % فلا تلم لحظا جرحنا به % % خدك يا جارح أكباد % % 3(@)(@@) % يا من له لام على وجنة % زادت عليها غلة الصادي % % 4(@)(@@) % سرقت من عيني كحل الكرى % % ونمت عن دمعي وتسهادي % % 5(@)(@@) % إن تسخن الأدمع عيني فقد % % طال لذاك الحر تردادي % % 6(@)(@@) % حمام دمعي في الهوى نافق % بكوكب للخد وقاد % % 7(@)(@@) % وعاذلي الواعظ في صبوتي % % كأنما يأتي بميعاد % % 8(@)(@@) % فدأبه العذل ودأبي البكى % % مسلسلا يروى باسناد % % 9(@)(@@) % يروم للصب هدى وهو في % % واد وقلب الصب في واد % % 10(@)(@@) % أهلا بسفاح دموعي ولا % % أهلا من العاذل بالهادي % % PageV01P599 11(@)(@@) % و حبذا حيث زمان الصبى % % لهوي بذاك الشادن الشادي % % 12(@)(@@) % أجني على خديه أو أجني % % وردا على أهيف مياد % % 13(@)(@@) % وردي لثم الخد لا كأسه % % فلست للكاس بوراد % % 14(@)(@@) % يالك من وصل قصير المدى % % أبكي عليه طول آمادي % % 15(@)(@@) % إن لم أكن قد شبت من بعده % % في عام عشرين ففي الحادي % % 16(@)(@@) % يا زمن اللهو وعصر الصبى % % سقاك صوب الرائح الغادي % % 17(@)(@@) % كما ابتدى صوب علي على % % وفد الرجا والفضل للبادي % % 18(@)(@@) % علاء دين الله عيث الندى % % غوث المنادي قمر النادي % % 19(@)(@@) % ذو الفضل من ذات ومن نسبة % % والمجد لا يحصى بتعداد % % 20(@)(@@) % و القول من مسند سحبانه % % والفعل من مسند حماد % % PageV01P600 21(@)(@@) % و البيت مرفوع لفاروقه % % ما بين انجاب وانجاد % % 22(@)(@@) % رماح أيديهم وأقلامها % % أعماد ملك أي أعماد % % 23(@)(@@) % أما ترى يمنى 
ms135	 علي بما % % خطته رجوى كل مرتاد % % 24(@)(@@) % ذات يراع في الجدا والعدا % % داع لتجنيس العلى عاد % % 25(@)(@@) % فرع نحيف وهو وافي الحيا % % لكل وافي القصد وفاد % % 26(@)(@@) % لمشرق من مغرب ظله % % دع غايتي مصر وبغداد % % 27(@)(@@) % سطوره طورا ربى زاهرا % وتارة أغيال آساد % % 28(@)(@@) % و لفظه التبري أو جوده % % جلته أسماعي وأجيادي % % 29(@)(@@) % كم سافرت في الجود أمواله % % يحدو بها من مدحه حاد % % 30(@)(@@) % فالغيث من غيظ بها عابس % والبحر في خبط وازباد % % PageV01P601 31(@)(@@) % كم فضلت آلاؤه فاضلا % واستعبدت ألف ابن عباد % % 32(@)(@@) % كم حفظت من فقه آرائه % بحوث اكمال وارشاد % % 33(@)(@@) % كم أحسنت أزهار آدابه % % لمدحه الزاهر امدادي % % 34(@)(@@) % و ربما أدبني معرضا % فكان تثقيفا لمنآد % % 35(@)(@@) % أعرض عني مرة مرة % فأعترضت أنكال أنكادي % % 36(@)(@@) % و بان لي هوني على سادتي % % حتى على أهلي وأولادي % % 37(@)(@@) % و رفقة أخرني بينهم % % إخماد ذهني أي إخماد % % 38(@)(@@) % كنت أبا جيد كتابهم % % فصرت في قسم أبي جاد % % 39(@)(@@) % و خف ذهني فكلامي على الأ % % قلام ميت فوق أعواد % % 40(@)(@@) % حتى إذا عاد إلي الرضى % % عاد بحمد الله سجادي % % PageV01P602 41(@)(@@) % و عدت في النظم إلى سبق % يعرفها النظام من غاد % % 42(@)(@@) % وزاد تأميري فما أرتضي % % أبا فراس بعض اجنادي % % 43(@)(@@) % و أصبح الشامت بي حاسدا % في حال إصداري وإيرادي % % 44(@)(@@) % بالروح أفدي سيدا خائفا % علي في قربي وإبعادي % % 45(@)(@@) % كثر أعدائي بإعراضه % % وفي الرضا كثر حسادي % % 46(@)(@@) % و ليهنه العيد على أن في % % لقياه أعيادا لأعيادي % % 47(@)(@@) % نداه في الخلق ومدحي له % % غذآء أرواح وأجساد % % PageV01P603 البحر : - 1(@)(@@) % عاش وصلا وغيره مات صدا % % مستهام لسلوة ما تصدى % % 2(@)(@@) % بأبي زائر وقد شرع الإص % % باح يطوي من الدجنة بردا % % 3(@)(@@) % ونسيم الصبا على الأفق يذكي % % سحرا من مجامر الزهر ندا % % 4(@)(@@) % يارعى الله سفح نعمان سفحا % وقى الله عهد نعمان عهدا % % 5(@)(@@) % ومهاة تعد نعمان دارا % واللوى والعقيق صدغا وخدا % % 6(@)(@@) % مشتهاة اللقا كما تشتهى الدن % % يا وان أتعب النفوس واكدى % % 7(@)(@@) % يتثنى الأراك زهرا 
ms136	 فيبني % % ان في ثغرها مداما وشهدا % % 8(@)(@@) % ومن الجوهر الصغير يتيما % لم يدع للهوى لرائيه رشدا % % 9(@)(@@) % ما علمنا من قبله في تصاني % % ف الهوى ان لابن بسام عقدا % % 10(@)(@@) % كيراع الوزير جودا وبأسا % حين تذكو في الحالتين وتندى % % PageV01P604 11(@)(@@) % الوزير الذي نهى الخطب عنا % % فتعدى عنا ولم يتعدى % % 12(@)(@@) % يتقي جانب التقي وتخشى الإن % % س والجن من سليمان حدا % % 13(@)(@@) % أوفر العالمين عزا وعزما % وهو أوفى العباد نسكا وزهدا % % 14(@)(@@) % طالع يجتلي به الملك بدرا % ووقور يحبه الملك أحدا % % 15(@)(@@) % و مهيب لو يلمح الدم لم يخ % % رج من العرق حين يفصد فصدا % % 16(@)(@@) % و حليم قد راقه الحلم حتى % % كاد مخطي الذنوب يذنب عمدا % % 17(@)(@@) % و جواد لو رام فيض الغوادي % % ان يحاكيه عد ذلك فردا % % 18(@)(@@) % و رئيس كما تريد المعالي % % لا كمن آده المسير فردا % % 19(@)(@@) % و بليغ تنضد المدح فيه % % وهو أبهى منه وأنضر نهدا % % 20(@)(@@) % يرتجى سيبه ويخشى ذكاه % % فيرجى نقدا ويحذر نقدا % % PageV01P605 21(@)(@@) % خطبته وزارة وجدته % % في اكتساب العلى أجد وأجدى % % 22(@)(@@) % و رأت صلصلا بفضل علاه % % شهدت في الورى صحاب وأعدا % % 23(@)(@@) % و لعمري لقد دعته وزيرا % منتهى معشر لعلياه مبدا % % 24(@)(@@) % فكفى الجانبين مصرا وشاما % وأفاض العينين عدلا ورفدا % % 25(@)(@@) % و مشى في الورى على نهج حق % مستتبين الهدى وساد وأسدى % % 26(@)(@@) % و ارتدى فيهم رداء من الع % % ز وأما حسوده فتردى % % 27(@)(@@) % أيها الحاسد المعذب فيه % % جئت شيئا من الشقاوة إدا % % 28(@)(@@) % كيف ناويت سيدا كلما زا % % د عداة يزيده الله مجدا % % 29(@)(@@) % إن يكن في العفاة أبسط كفا % % فهو في المكرمات أبسط زندا % % 30(@)(@@) % خاف خلاقه فخيف إلى أن % % ضم من عدله ظباء وأسدا % % PageV01P606 31(@)(@@) % و أباد الطغاة بأسا ورعبا % وأعاد الجميل فينا وأبدى % % 32(@)(@@) % واحدا في مراتب الفضل تلقى % % حول أبوابه من الخلق جندا % % 33(@)(@@) % يرحم الجمع دون مغناه جمعا % % مستميرا ويتبع الرفد رفدا % % 34(@)(@@) % ماثنى الجاه عن ذليل ولا أع % % طى لذي حاجة عطاء وأكدى % % 35(@)(@@) % مسعد 
ms137	 الرأي ذابح للأعادي % % فهو مهما خبرته كان سعدا % % 36(@)(@@) % ليس فيه عيب سوى أن % أياديه تجعل الحر عبدا % % 37(@)(@@) % يمم الشام بعد اقتار وقت % % لم تجد فيه للمناجح قصدا % % 38(@)(@@) % كم بعثنا إلى الدواوين طرسا % خائبا كاده الزمان فكدا % % 39(@)(@@) % طال ترداده إلى القوم حتى % % لو بعثناه وحده لتهدى % % 40(@)(@@) % فغدا الآن ذلك العسر يسرا % بحقيق وذلك المنع رفدا % % PageV01P607 41(@)(@@) % و سرى المال من شآم ومصر % كعموم السحاب قربا وبعدا % % 42(@)(@@) % عزمات تحفها بركات % مثلها منه للمالك تهدى % % 43(@)(@@) % و يراع من حده ونداه % % كاد بين السيوف أن يتحدى % % 44(@)(@@) % قلم أخضر المرابع لا غر % % وإذا كان عيش راجيه رغدا % % 45(@)(@@) % حملته أيدي الوزير فخلنا % % بارقا في سحابة قد تبدى % % 46(@)(@@) % يا وزيرا يهدي الثناء سناه % % ولهاه إلى المقاصد تهدى % % 47(@)(@@) % شكرتك الرواة عني بعز % % قاطعات السرى اكاما ووهدا % % 48(@)(@@) % ذاكرات جميل صنعك عندي % % بقواف بها الركائب تحدى % % 49(@)(@@) % سائرات في الأفق بين الجواري % % والجواري في حسنها كالعبدا % % 50(@)(@@) % كل معنى كالنجم أوكل بيت % هو أهدى في الأفق من أن يهدى % % PageV01P608 51(@)(@@) % هاكها تخلد الثنا بمعان % % تترك الضد بالأشعة خلدا % % 52(@)(@@) % هكذا ينبت الصنيع نباتا % وكذا تحصد المعادي حصدا % % 53(@)(@@) % عش بظل الحبا وأنت المرجى % % وتبيد العدى وأنت المفدى % % 54(@)(@@) % ملئ البيت من يديك نوالا % فملأنا أبيات مدحك حمدا % % PageV01P609 البحر : - 1(@)(@@) % قدمت كالسيف إلى غمده % % واليمن موقوف على حده % % 2(@)(@@) % قد أثرت فيك ليالي السرى % % ما أثر السيف بإفرنده % % 3(@)(@@) % وعدت مشكور الثنا والسنا % % كذاك عود البدر في سعده % % 4(@)(@@) % لله ما أسعدها طلعة % يجيبها الوابل من مهده % % 5(@)(@@) % نعم وما أيمنها عزمة % % سلمها الرأي إلى رشده % % 6(@)(@@) % عزم فتى صورة أخلاصه % % في البر قد أفضت إلى حمده % % 7(@)(@@) % ماضر ركبا كان بدرا له % % أن لا يراعي النجم في قصده % % 8(@)(@@) % كأنني أبصر بين الفلا % % حماه يستدعي إلى رفده % % 9(@)(@@) % مخيما تنثر ألطافه % % نثر سقيط الوبل من عقده % % 10(@)(@@) % يستمسك العافي باطنابه % % فليس يحتاج إلى وده % % PageV01P610 11(@)(@@) % و ماجد حث 
ms138	 ركاب السرى % % حث الرجا الساري إلى قصده % % 12(@)(@@) % أهلة تحمل بدر العلى % % لله ما تحمل من مجده % % 13(@)(@@) % هوادج تحملها من سرى % % فواقع الآل على مده % % 14(@)(@@) % حتى قضيت النسك من بعدما % % قضيت نسك الجود في وفده % % 15(@)(@@) % يرنو اليك الحجر المجتلى % % ياأيها العين بمسوده % % 16(@)(@@) % أعظم به من حجر للهدى % % كأنه خال على خده % % 17(@)(@@) % هذا وفي جلق وجد عشت % % طوارق الحزن إلى وقده % % 18(@)(@@) % هان حماها منذ فارقته % % ما أهون الغاب بلا أسده % % 19(@)(@@) % و مزق الروض بها كل ما % % حاكت خيوط الودق من برده % % 20(@)(@@) % شوقا إلى مرتحل أقسمت % % لا تبسم الأزهار من بعده % % PageV01P611 21(@)(@@) % فالعام مثل اليوم في قربه % % واليوم مثل العام في بعده % % 22(@)(@@) % حتى اذا عاد إلى صرحها % % قام إلى الغصن على قده % % 23(@)(@@) % و أقبلت تلثم آثاره % % تلك الشفاه الحمر عن ورده % % 24(@)(@@) % أبلج مارد إليها الحيا % % الا بشم الآس في رده % % 25(@)(@@) % ليث وغيث في سطا أو لها % فاحذره يا طالب واستجده % % 26(@)(@@) % يروق مثل السيف في صفحه % % وربما راعك في حده % % 27(@)(@@) % فالأمن كل الأمن في لينه % % والخوف كل الخوف في شده % % 28(@)(@@) % مهابة الزهد وعز التقى % % قد كفيا الواحد في جنده % % 29(@)(@@) % تغفيه في الليل سهام الدجى % % وأنصل الادمع عن حشده % % 30(@)(@@) % لا يطمع الطالب في شأوه % وانما يطمع في رفده % % PageV01P612 31(@)(@@) % رفد أراد الغيث تشبيهه % % فعد ذاك الفعل من برده % % 32(@)(@@) % يعطي ويملينا معني الثنا % % فالمدح والإرفاد من عنده % % 33(@)(@@) % حقا لقد أنجبتمو يا بني % % شيبان في المجد وفي ولده % % 34(@)(@@) % مناسب غر لها رونق % أبصرت عقد الدر في نضده % % 35(@)(@@) % أواخر نم بها أول % ومجمع لم يغن عن فرده % % 36(@)(@@) % كما تلا التنزيل مستقبل المح % % راب والاتمام في حمده % % 37(@)(@@) % سجاه حب العفو حتى لقد % % كاد الفتى يذنب عن عمده % % 38(@)(@@) % و مر في المجد إلى غاية % ما حظ حاكيها سوى كده % % 39(@)(@@) % ذو قلم يجني الغنى والقنا % % من سمه الجاري ومن شهده % % 40(@)(@@) % يقدح في أفق العلى 
ms139	 زنده % % وليس من يقدح في زنده % % PageV01P613 41(@)(@@) % يا سيدا إن أشك دهرا له % % كأنما أشكو أذى عبده % % 42(@)(@@) % ماذا جنى بعدك من صرفه % % لنازح أوحش من فقده % % 43(@)(@@) % حتى اذا هب نسيم اللقا % % قام الرجا يستن من لحده % % 44(@)(@@) % أهلا بفياض الندى لم يقل % % مادحه أحسن من ضده % % 45(@)(@@) % الهى قريضي عن غزال النقا % % تغزلا فيه وعن هنده % % 46(@)(@@) % فلم أصف من طاح من أجلها % % وأجله قلبي في وجده % % 47(@)(@@) % أغيد ذو ردف وخصر فكم % % في غوره أصبو وفي نجده % % 48(@)(@@) % يجرح أجفاني وأرنو له % % كأنني أقتص من خده % % 49(@)(@@) % يا ليته لي بالجفا موعدا % لانه يكذب في وعده % % 50(@)(@@) % و غادة مذ عقدت صدغها % % ما خرج العاشق عن عقده % % PageV01P614 51(@)(@@) % كأنها إذ خضبت غيبت % % في دمعي الكف إلى زنده % % 52(@)(@@) % دع ذا وعد للقول في معشر % غر وفي غيرهم عده % % 53(@)(@@) % لولا بنو العطار لم ينتشق % % عرف ندى يربو على نده % % 54(@)(@@) % لا توحش العلياء من نسلهم % % ولا ترى الشنعاء من فقده % % 55(@)(@@) % يكاد سفر ضم أخبارهم % % من طرب يخرج من جلده % % PageV01P615 البحر : - 1(@)(@@) % في الريق سكر وفي الاصداغ تجعيد % % هذي المدام وهاتيك العناقيد % % 2(@)(@@) % الراح ريقة من أهوى ولا عجب % ان راح وهو على العشاق عربيد % % 3(@)(@@) % تأتي على أبلق ألحاظ مقلته % % فهن بيض وفي أحشائنا سود % % 4(@)(@@) % ما أعجب الحب يلقاني بسفك دمي % % على النقا وهو محبوب ومودود % % 5(@)(@@) % كأنه صنم في الحب متبع % هذا وما فيه الا القلب جلمود % % 6(@)(@@) % ظل الذوائب ممدود بقامته % للناظرين وطلع الثغر منضود % % 7(@)(@@) % كأن تلك اللآلي في مقبله % % مما ينظم في القرطاس محمود % % 8(@)(@@) % النافث السحر ألفاظا محللة % وكل لفظ بليغ عنه معقود % % 9(@)(@@) % و المقتفي أمد العلياء في طرق % طرف البروق بها تعبان مكدود % % 10(@)(@@) % له إلى السبق تقريب يفوت به % % وفي مداه على الباغين تبعيد % % PageV01P616 11(@)(@@) % تفردت بمعانيه براءته % فاعجب لغصن له كالورق تغريد % % 12(@)(@@) % ناهيك سهما تسميه الورى قلما % له إلى غرض العلياء تسديد % % 13(@)(@@) % حروفه مع 
ms140	 ورق الدوح ساجعة % وغيرها مع دود القز معدود % % 14(@)(@@) % تصيد الملك أنواع البديع به % % ان الملوك على علاتها صيد % % 15(@)(@@) % في كف يقظان لافي القول ممتنع % % اذا أراد ولا في الفكر ترديد % % 16(@)(@@) % له على الرأي تنقيب ومطلع % وفي المقاصد تصويب وتصعيد % % 17(@)(@@) % يا سيدا لمواليه وقاصده % % في الود عطف وفي الاحسان توكيد % % 18(@)(@@) % ناشدتك الله في ود عنيت به % % شطرا من العمر لا يألوه مجهود % % 19(@)(@@) % راجع يقينك في ودي ودع عصبا % % لرأيهم في اقترابي منك تبعيد % % 20(@)(@@) % واردد مقال عداة لا اعتبار به % % ان الرديء على أهليه مردود % % PageV01P617 21(@)(@@) % لهم بذكري أضغان مناقضة % في القلب وقد وفي التحريش تبريد % % 22(@)(@@) % حاشا ثباتك من ايلام قلب فتى % ما فيه الا موالاة وتوحيد % % 23(@)(@@) % لي من مباديء عمري فيك فرط ولا % % فم المصائب عن ذكراه مسدود % % 24(@)(@@) % فهل أضل وجنح الشيب متضح % بعد الرشاد وليلات الصبى سود % % 25(@)(@@) % ان كنت أظهرودا لست أضمره % % فلا وفى لي من نعماك مقصود % % 26(@)(@@) % كن كيفما شئت من صد ومن عطف % % فما ودادك في أحشاي مصدود % % 27(@)(@@) % فلست أكره شيئا أنت صانعه % % مهما صنعت فمشكور ومحمود % % PageV01P618 البحر : - 1(@)(@@) % لا ورشف اللمى ولثم الخدود % % ما عذولي عليك غير حسود % % 2(@)(@@) % هائم في هواك مثلي ولكن % % يدفع الوهم عنك بالتفنيد % % 3(@)(@@) % يا مليحا طرفي به في نعيم % % وفؤادي في النار ذات الوقود % % 4(@)(@@) % لا تسل عن مسيل دمعي بخدي % % قتل الدمع صاحب الأخدود % % 5(@)(@@) % كل يوم تروع قلبا خليا % يا بديع الحلى بحسن جديد % % 6(@)(@@) % حبذا في حلاك لام عذار % لابتداء الغرام والتوكيد % % 7(@)(@@) % لك وجه يعزى له كل حسن % كاعتزاء العلى إلى محمود % % 8(@)(@@) % سيد في مديحه بهجة الصد % % ق كمثل التسبيح والتحميد % % 9(@)(@@) % و إمام أضحت إلى فضله الاق % % لام ما بين ركع وسجود % % 10(@)(@@) % ليس فيه عيب سوى أن نعما % % ه تفيد الأحرار رق العبيد % % PageV01P619 11(@)(@@) % و معاني ألفاظه تنفث الس % % حر على بعدها من التعقيد % % 12(@)(@@) % كل سجع يهيم وهو مداد % % فوق 