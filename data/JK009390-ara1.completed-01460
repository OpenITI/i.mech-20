ms1441	 من الملاحم وفسطاطها منها بأرض يقال لها الغوطة ) )(@)(@@) ( حم ) عن رجال من الصحابة .(@)(@@)(@@)(@@) $ ( 12930 ) قال النبي :(@)(@@) | 30 ( ستفتح على أمتي من بعدي الشام وشيكا ، فإذا فتحها واحتلها فأهل الشام مرابطون إلى منتهى الجزيرة : رجالهم وصبيانهم ، ونساؤهم ، وعبيدهم ، فمن احتل ساحلا من تلك السواحل فهو في جهاد ، ومن احتل بيت المقدس وما حوله فهو في رباط ) )(@)(@@) ( كر ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12931 ) قال النبي :(@)(@@) | 30 ( ستفتح الإسكندرية وقزوين على أمتي وإنهما بابان من أبواب الجنة ، من رابط فيهما أو في إحذاهما ليلة واحدة خرج من ذنوبه كيوم PageV04P483 ولدته أمه ) )(@)(@@) الخليلي في فضائل قزوين والرافعي عن علي رضي الله عنه قال أبو حفص عمر بن زادان غريب تفرد به خالد بن حميد عن الأعمش .(@)(@@)(@@)(@@) $ ( 12932 ) قال النبي :(@)(@@) | 30 ( ستفتح على أمتي مدينتان : إحداهما من أرض الديلم يقال لها قزوين ، والأخرى من أرض الروم يقال لها : الإسكندرية ، من رابط في شيء منها خرج من ذنوبه كيوم ولدته أمه ) )(@)(@@) أبو الشيخ في كتاب الأمصار وابن داود بن ناجية المهزي في فضائل الاسكندرية وميسرة بن علي في مشيخته والرافعي عن بعض الصحابة .(@)(@@)(@@)(@@) $ ( 12933 ) قال النبي :(@)(@@) | 30 ( ستفتحون من بعدي مدائن عظاما ، وتتخذون في أسواقها مجالس ، فإذا كان ذالك : فردوا السلام ، وغضوا من أبصاركم ، واهدوا الأعمى ، وأعينوا المظلوم ) )(@)(@@) الديلمي عن وحشي بن حرب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12934 ) قال النبي :(@)(@@) | 30 ( ستكون فتنة : النائم فيها خير من القاعد ، والقاعد فيها خير من الماشي ، والماشي فيها خير من الساعي ، والساعي فيها خير من الراكب ) )(@)(@@) ( طب ) عن حزيم بن فاتك رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12935 ) قال النبي :(@)(@@) | 30 ( ستكون لولد العباس راية من تبعها رشد ، ومن خلفها هلك ، ولن تخرج من أيديهم ما أقاموا الحق ) )(@)(@@) الديلمي عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 12936 ) قال النبي :(@)(@@) | 30 ( ستكون فتنة يفارق الرجل فيها أخاه وأباه ، تطير الفتنة في قلوب رجال منهم إلى يوم القيامة حتى يعير الرجل فيها ببلائه كما تعير الزانية بزناها ) )(@)(@@) نعيم بن حماد في الفتن ( طب ) عن ابن 
ms1442	 عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12937 ) قال النبي :(@)(@@) | 30 ( ستكون فتنة واختلاف ، قالوا : فما تأمرنا ؟ قال : عليكم بالأمير وأصحابه ، وأشار إلى عثمان ) )(@)(@@) ( ك ) عن أبي هريرة رضي الله عنه .(@)(@@) PageV04P484(@)(@@)(@@)(@@) $ ( 12938 ) قال النبي :(@)(@@) | 30 ( ستكون فتنة بكماء عمياء صماء ، المضطجع فيها خير من القاعد ، والقاعد فيها خير من القائم ، والقائم فيها خير من الماشي ، والماشي فيها خير من الساعي فمن أبى فليمدد عنقه ) )(@)(@@) تقي بن مخلد في مسنده ( خ ) في التاريخ والبغوي وابن السكن والباوردي وابن قانع وابن شاهين عن أنيس بن أبي مرثد الأنصاري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12939 ) قال النبي :(@)(@@) | 30 ( ستكون بعدي فتن كقطع الليل المظلم ، يصبح الرجل فيها مؤمنا ويمسي كافرا ، ويمسي مؤمنا ويصبح كافرا ، قيل : كيف نصنع ؟ قال : ادخلوا بيوتكم ، واخملوا ذكركم ، قيل : أرأيت إن أدخل على أحدنا بيته ؟ قال : ليمسك بيده وليكن عبد الله المقتول ، ولا يكن عبد الله القاتل ، فإن الرجل يكون في فيه الإسلام فيأكل مال أخيه ، ويسفك دمه ، ويعصي ربه ، ويكفر بخالقه ، وتجب له النار ) )(@)(@@) ( طب ) عن جندب البجلي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12940 ) قال النبي :(@)(@@) | 30 ( ستكون فتن ، قيل : يا رسول الله فما تأمرنا ؟ قال : عليكم بالشام ) )(@)(@@) ( ت ) حسن صحيح وتمام ( كر ) عن بهز بن حكيم عن أبي عن جده .(@)(@@)(@@)(@@) $ ( 12941 ) قال النبي :(@)(@@) | 30 ( ستكون بعدي فتن غلاظ شداد ، خير الناس فيها مسلموا أهل البوادي الذين لا يتندون من دماء المسلمين ولا أموالهم شيئا ) )(@)(@@) ( طب ) و ابن منده وتمام ( كر ) عن أبي العادية المزني رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12942 ) قال النبي :(@)(@@) | 30 ( ستكون بعدي فتنة : الراقد فيها خير من اليقظان ، والمضطجع فيها خير من القاعد ، والقاعد خير من القائم ، والقائم خير من الماشي ، والماشي خير من الساعي ، ويهلك فيها كل راكب موضع ، وكل PageV04P485 خطيب مصقع ، فإن أدركتها فألصق بطنك بالأرض حتى تستريح برا ، أو تستراح من فاجر ) )(@)(@@) ( ع ) عن حذيفة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12943 ) قال النبي :(@)(@@) | 30 ( ستكون عني رواة يروون الحديث فأعرضوه على القرآن ، فإن وافق القرآن فخذوها وإلا فدعوها ) )(@)(@@) ( كر ) عن علي رضي 
ms1443	 الله عنه .(@)(@@)(@@)(@@) $ ( 12944 ) قال النبي :(@)(@@) | 30 ( ستكون بعدي فتن : النائم فيها خير من اليقظان ، والجالس فيها خير من القائم ، والقائم فيها خير من الماشي ، ألا فمن أتت عليه فليش بسيفه إلى صفاه فليضربه بها حتى ينكسر ، ثم ليضطجع حتى تنجلي عما انجلت عليه ) )(@)(@@) ( حم ع ) و ابن منده والبغوي وابن قانع وعبد الجبار بن عبد الله الخولاني في تاريخ داريا ( طب ض ) عن خرشة المحاربي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12945 ) قال النبي :(@)(@@) | 30 ( ستكون بينكم وبين الروم أربع هدن يوم الرابعة على يد رجل من آل هارون يدوم سبع سنين ، قيل : يا رسول الله من إمام الناس يومئذ ؟ قال : من ولدي ابن أربعين سنة ، كأن وجهه كوكب دري ، في خده الأيمن خال أسود عليه عباءتان قطوانيتان كأنه من رجال بني إسرائيل ، يملك عشرين سنة ، يستخرج الكنوز ويفتح مدائن الشرك ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12946 ) قال النبي :(@)(@@) | 30 ( ستكون أربع فتن : فتنة يستحل فيها الدم ، والثانية يستحل فيها الدم والمال ، والثالثة يستحل فيها الدم والمال والفرج ) )(@)(@@) ( طب ) عن عمران بن حصين رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12947 ) قال النبي :(@)(@@) | 30 ( ستكون فتنة كرياح الصيف القاعد فيها خير من القائم ، والقائم فيها خير من الماشي ، من أشرف لها استشرفته ، ومن الصلوات PageV04P486 صلاة من فاتته فكأنما وتر أهله وماله ) )(@)(@@) ( طب ) عن نوفل بن معاوية رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12948 ) قال النبي :(@)(@@) | 30 ( ستكون فتنة تكون بعدها جماعة ، ثم تكون فتنة بعدها جماعة ، ثم تكون فتنة لا يكون بعدها جماعة ، يرفع فيها الأصوات ، وتشخص الأبصار ، وتذهل العقول ، فلا تكاد ترى رجلا ) )(@)(@@) الديلمي عن حذيفة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12949 ) قال النبي :(@)(@@) | 30 ( ستلقون بعدي فتنة واختلافا ، قيل : يا رسول الله بما تأمرنا ؟ قال : عليكم بالأمير وأصحابه ، وأشار إلى عثمان ) )(@)(@@) ( ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12950 ) قال النبي :(@)(@@) | 30 ( ستكون بعدي فتن : منها فتنة الأحلاس ، يكون فيها حرب وهرب ، ثم بعدها فتن أشد منها ، ثم تكون فتنة كلما قيل انقطعت تمادت حتى لا يبقى بيت 
ms1444	 إلا دخلته ، ولا مسلم إلا ملسته حتى يخرج مسلم من عترتي ) )(@)(@@) نعيم بن حماد في الفتن عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12951 ) قال النبي :(@)(@@) | 30 ( ستنهاه قراءته ) )(@)(@@) ( ض ) عن جابر رضي الله عنه قال : قيل : يا رسول الله إن فلانا يقرأ الليل كله فإذا أصبح سرق قال فذكره .(@)(@@)(@@)(@@) ||| ( السين مع الجيم(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 12952 ) قال النبي :(@)(@@) | 30 ( سجدتا السهو بعد التسليم وفيهما تشهد وسلام ) )(@)(@@) ( فر ) عن أبي هريرة وابن مسعود رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 12953 ) قال النبي :(@)(@@) | 30 ( سجدتا السهو في الصلاة تجزئان من كل زيادة ونقصان ) )(@)(@@) ( ع عد هق ) عن عائشة رضي الله عنها .(@)(@@) PageV04P487(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 12954 ) قال النبي :(@)(@@) | 30 ( سجد لك خيالي وسوادي وآمن بك فؤادي ، فهاذه يدي وما جنيت بها على نفسي ، يا عظيم يرجى لكل عظيم اغفر الذنب العظيم ، سجعد وجهي للذي خلقه ، وشق سمعه وبصره ، أعوذ برضاك من سخطك ، وأعوذ بعفوك من عقابك ، وأعوذ بك منك ، أنت كما أثنيت على نفسك ، أقول كما قال أخي داود : أعفر وجهي في التراب لسيدي ، وحق لسيدي أن يسجد له ، اللهم ارزقني قلبا تقيا ، من الشر نقيا ، لا جافيا ولا شقيا ) )(@)(@@) ( هب ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 12955 ) قال النبي :(@)(@@) | 30 ( سجدها داود للتوبة ، ونسجدها نحن شكرا ) )(@)(@@) يعني ( ص ) الشافعي في القديم ( هق ) عن عمر بن ذر عن أبيه مرسلا .(@)(@@)(@@)(@@) ||| ( السين مع الحاء(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 12956 ) قال النبي :(@)(@@) | 30 ( سحاق النساء زنا بينهن ) )(@)(@@) ( طب ) عن واثلة رضي الله عنه .(@)(@@)(@@)(@@) ||| ( السين مع الخاء(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 12957 ) قال النبي :(@)(@@) | 30 ( سخافة بالمرء أن يستخدم ضيفه ) )(@)(@@) ( فر ) عن ابن عباس رضي الله عنهما .(@)(@@) PageV04P488(@)(@@)(@@)(@@) ||| ( السين مع الدال(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 12958 ) قال النبي :(@)(@@) | 30 ( سددوا وقاربوا ) )(@)(@@) ( طب ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12959 ) قال النبي :(@)(@@) | 30 ( سددوا وقاربوا وأبشروا واعلموا أنه لن يدخل أحدكم الجنة عمله ولا أنا إلا أن يتغمدني الله بمغفرة ورحمة ) )(@)(@@) ( حم ق ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) |||| ( الإكمال من 
ms1445	 الجامع الكبير )(@)(@@)(@@)(@@) $ ( 12960 ) قال النبي :(@)(@@) | 30 ( سددوا وقاربوا ، ولا ينجي أحدا منكم عمله ، قالوا : ولا أنت يا رسول الله ؟ قال : ولا أنا إلا أن يتغمدني الله منه برحمة ) )(@)(@@) ( حب ) عن أبي هريرة وجابر رضي الله عنهما معا .(@)(@@)(@@)(@@) $ ( 12961 ) قال النبي :(@)(@@) | 30 ( سددوا وقاربوا واعلموا أن خير أعمالكم الصلاة ، ولا يحافظ على الوضوء إلا مؤمن ) )(@)(@@) ( حب هب ) عن ثوبان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12962 ) قال النبي :(@)(@@) | 30 ( سددوا وأبشروا فإن الله عز وجل ليس إلى عذابكم بسريع ، وسيأتي قوم لا حجة لهم ) )(@)(@@) ( ع طب ض ) عن عبد الله بن بشر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12963 ) قال النبي :(@)(@@) | 30 ( سدوا هاذه الأبواب كلها إلا باب علي ) )(@)(@@) ( حم PageV04P489 ك ض ) عن زيد بن أرقم ( خط ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12964 ) قال النبي :(@)(@@) | 30 ( سدوا خلال اللبن أما إن هاذا ليس بشيء ولاكنه يطيب بنفس الحي ) )(@)(@@) الحسن بن سفيان ( ك كر ) عن أبي أمامة رضي الله عنه : لما وضعت أم كلثوم بنت رسول الله في القبر قال فذكره .(@)(@@)(@@)(@@) ||| ( السين مع الراء(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 12965 ) قال النبي :(@)(@@) | 30 ( سرعة المشي تذهب ببهاء الوجه ) )(@)(@@) أبو القاسم بن بشران في أماليه عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12966 ) قال النبي :(@)(@@) | 30 ( سرعة المشي تذهب بهاء المؤمن ) )(@)(@@) ( حل ) عن أبي هريرة ( خط ) في الجامع ( فر ) عن إن عمر ، ابن النجار عن ابن عباس رضي الله عنهم .(@)(@@)(@@)(@@) ||| ( السين مع الطاء(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 12967 ) قال النبي :(@)(@@) | 30 ( سطع نور في الجنة ، فقيل : ما هاذا ؟ فإذا هو من ثغر حوراء ضحكت في وجه زوجها ) )(@)(@@) الحاكم في الكنى ا ( خط ) عن ابن مسعود رضي الله عنه .(@)(@@) PageV04P490(@)(@@)(@@)(@@) ||| ( السين مع العين(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 12968 ) قال النبي :(@)(@@) | 30 ( سعادة لابن آدم ثلاث ، وشقاوة لابن آدم ثلاث ، فمن سعادة ابن آدم : الزوجة الصالحة ، والمركب الصالح ، والمسكن الواسع ؛ وشقوة لابن آدم ثلاث : المسكن السوء ، والمرأة السوء ، والمركب السوء ) )(@)(@@) الطيالسي عن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12969 ) قال النبي :(@)(@@) | 30 ( سعة في الرزق وردع سنة 
ms1446	 الشيطان : الوضوء قبل الطعام وبعده ) )(@)(@@) ( ك ) في تاريخه عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 12970 ) قال النبي :(@)(@@) | 30 ( سعد غيور وأنا أغير منه والله أغير مني ، قيل : على أي شيء يغار الله ؟ قال : يغار على رجل مجاهد في سبيل الله يخالف إلى أهله ) )(@)(@@) ( حم طب ص ) عن عمرو بن شرحبيل بن سعيد بن سعد بن عبادة عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 12971 ) قال النبي :(@)(@@) | 30 ( سعرت النار وأزلفت الجنة يا أهل الحجرات لو تعلمون ما أعلم ، لضحكتم قليلا ولبكيتم كثيرا ) )(@)(@@) ( ك ) عن ابن مسعزد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12972 ) قال النبي :(@)(@@) | 30 ( سعرت النار لأهل النار وجاءت الفتن كقطع الليل المظلم ، لو تعلمون ما أعلم لضحكتم قليلا ولبكيتم كثيرا ) )(@)(@@) ( طب ) عن أم مكتوم رضي الله عنها .(@)(@@) PageV04P491(@)(@@)(@@)(@@) ||| ( السين مع الفاء(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 12973 ) قال النبي :(@)(@@) | 30 ( سفر المرأة مع عبدها ضيعة ) )(@)(@@) البزار ( طس ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) ||| ( السين مع الكاف(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 12974 ) قال النبي :(@)(@@) | 30 ( سكاتها إقرارها يعني البكر ) )(@)(@@) ( د ) عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) ||| ( السين مع اللام(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 12975 ) قال النبي :(@)(@@) | 30 ( سل الله العفو والعافية في الدنيا والآخرة ) )(@)(@@) . ( تخ ك ) عن عبد الله بن جعفر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12976 ) قال النبي :(@)(@@) | 30 ( سل ربك العافية والمعافة في الدنيا والآخرة ، فإذا أعطيت العافية في الدنيا وأعطيتها في الآخرة فقد أفلحت ) )(@)(@@) ( ت ه ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12977 ) قال النبي :(@)(@@) | 30 ( سلم علي ملك ثم قال لي : لم أزل أستأذن ربي عز وجل في لقائك حتى كان هاذا أوان أذن لي ، وإني أبشرك أنه ليس أحد أكرم PageV04P492 على الله منك ) )(@)(@@) ابن عساكر عن عبد الرحمان بن غنم رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12978 ) قال النبي :(@)(@@) | 30 ( سلمان سابق فارس ) )(@)(@@) ابن سعد عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 12979 ) قال النبي :(@)(@@) | 30 ( سلمان منا أهل البيت ) )(@)(@@) ( طب ك ) عن عمرو بن عوف رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12980 ) قال النبي :(@)(@@) | 30 ( سلوا الله العفو والعافية 
ms1447	 ، فإن أحدا لم يعط بعد اليقين خيرا من العافية ) )(@)(@@) ( حم ت ) عن أبي بكر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12981 ) قال النبي :(@)(@@) | 30 ( سلوا الله الفردوس ، فإنها سرة الجنة ، وإن أهل الفردوس يسمعون أطيط العرش ) )(@)(@@) ( طب ك ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12982 ) قال النبي :(@)(@@) | 30 ( سلوا الله أن يستر عوراتكم ، ويؤمن روعاتكم ) )(@)(@@) الخرائطي في مكارم الأخلاق عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 12983 ) قال النبي :(@)(@@) | 30 ( سلوا الله ببطون أكفكم ولا تسألوه بظهورها ) )(@)(@@) ( طب ) عن أبي بكرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12984 ) قال النبي :(@)(@@) | 30 ( سلوا الله ببطون أكفكم ولا تسألوه بظهورها ، فإذا فرغتم فامسحوا بها وجوهكم ) )(@)(@@) ( د هق ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 12985 ) قال النبي :(@)(@@) | 30 ( سلوا الله حوائجكم البتة في صلاة الصبح ) )(@)(@@) ( ع ) عن أبي رافع رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12986 ) قال النبي :(@)(@@) | 30 ( سلوا الله حوائجكم حتى الملح ) )(@)(@@) ( هب ) عن بكر بن عبد الله المزني مرسلا ( ز ) .(@)(@@) PageV04P493(@)(@@)(@@)(@@) $ ( 12987 ) قال النبي :(@)(@@) | 30 ( سلوا الله علما نافعا ، وتعوذوا بالله من علم لا ينفع ) )(@)(@@) ( ه هب ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12988 ) قال النبي :(@)(@@) | 30 ( سلوا الله كل شيء حتى الشسع ، فإن الله إن لم ييسره لم يتيسر ) )(@)(@@) ( ع ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 12989 ) قال النبي :(@)(@@) | 30 ( سلوا الله لي الوسيلة : أعلى درجة في الجنة ، لا ينالها إلا رجل واحد ، وأرجو أن أكون أنا هو ) )(@)(@@) ( ت ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12990 ) قال النبي :(@)(@@) | 30 ( سلوا الله لي الوسيلة ، فإنه لا يسألها لي عبد في الدنيا إلا كنت له شهيدا أو شفيعا يوم القيامة ) )(@)(@@) ( ش طس ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 12991 ) قال النبي :(@)(@@) | 30 ( سلوا الله من فضله ، فإن الله يحب أن يسأل ، وأفضل العبادة انتطار الفرج ) )(@)(@@) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12992 ) قال النبي :(@)(@@) | 30 ( سلوا أهل الشرف عن العلم فإن كان عندهم علم فاكتبوه ، فإنهم لا يكذبون ) )(@)(@@) ( فر ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 12993 ) قال النبي :(@)(@@) | 30 
ms1448	 ( سل الله العفو والعافية ) )(@)(@@) ابن سعد عن أيوب قال : قال العباس : يا رسول الله مرني بدعاء قال فذكره .(@)(@@)(@@)(@@) $ ( 12994 ) قال النبي :(@)(@@) | 30 ( سل عمود الإسلام من تحت رأسي فأوحشني ، ثم رميت ببصري فإذا هو قد غرز في وسط الشام ، فقيل لي : يا محمد إن الله عز PageV04P494 وجل قد اختار لك الشام ولعباده ، فجعلها لكم عزا ومحشرا ومنعة وذكرا ، من أراد الله به خيرا أسكنه الشام وأعطاه نصيبه منها ، ومن أراد به شرا أخرج سهما من كنانته وهي معلقة في وسط الشام فرماه بها ، فلم يسلم في دنيا ولا آخرة ) )(@)(@@) ( كر ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 12995 ) قال النبي :(@)(@@) | 30 ( سلفي في الدنيا وسلفي في الآخرة ) )(@)(@@) ( طب ض ) عن طل حة رضي الله عنه قال : كان النبي إذا رآني قال فذكره .(@)(@@)(@@)(@@) $ ( 12996 ) قال النبي :(@)(@@) | 30 ( سلام عليك أبا الريحانتين أوصيك بريحانتي من الدنيا ، فعن قليل ينهدم ركناك والله خليفتي عليك قاله لعلي ) )(@)(@@) ( أبو نعيم وكر ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12997 ) قال النبي :(@)(@@) | 30 ( سلام عليكم دار قوم مؤمنين وإنا بكم لاحقون ، اللهم لا تحرمنا أجرهم ، ولا تفتنا بعدهم ) )(@)(@@) ( حم ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 12998 ) قال النبي :(@)(@@) | 30 ( سلامة الرجل في الفتنة أن يلزم بيته ) )(@)(@@) الديلمي عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12999 ) قال النبي :(@)(@@) | 30 ( سلوا الله ببطون أكفكم ولا تسألوه بظهورها ) )(@)(@@) ( طب ) عن أبي بكرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13000 ) قال النبي :(@)(@@) | 30 ( سلوا الله اليقين والعافية ) )(@)(@@) ( هب ) عن أبي بكر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13001 ) قال النبي :(@)(@@) | 30 ( سلوا الله من فضله ، فإن الله يحب أن يسأل ، وأفضل العبادة انتظار الفرج ) )(@)(@@) ( ت طب عد هب ) عن ابن مسعود رضي الله عنه .(@)(@@) PageV04P495(@)(@@)(@@)(@@) $ ( 13002 ) قال النبي :(@)(@@) | 30 ( سلوا الله من فضله فإنه يحب أن يسأل ، وإن من أفضل العبادة انتظار الفرج ) )(@)(@@) ابن جرير عن حكيم بن حبير عن رجل لم يسمعه .(@)(@@)(@@)(@@) $ ( 13003 ) قال النبي :(@)(@@) | 30 ( سلوا عن الخير ولا تسألوا عن الشر ، شرار الناس شرار العلماء في الناس ) )(@)(@@) ( حل ) عن 
ms1449	 معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13004 ) قال النبي :(@)(@@) | 30 ( سلوا الله ما بدا لكم من حوائجكم ، حتى شسع النعل فإنه إن لم يبسره لم يتيسر ) )(@)(@@) ( هب ) وضعفه عن أبي هريرة ( هب ) عن عائشة رضي الله عنه موقوفا .(@)(@@)(@@)(@@) $ ( 13005 ) قال النبي :(@)(@@) | 30 ( سليني عن طول رقادي ؟ إن أهل الجنة وأهل النار يعرضون علي ، وإني استلبت عبد الرحمان بن عوف حتى خشيت أن لا يمر بي فيمن يمر بي ، قالت عائشة : يا رسول الله أي أهل الجنة أكثر وأيهم أقل ؟ قال : أكثرهم المساكين ، وأقلهم الأغنياء والنساء ، قالت : ما النساء في الجنة ؟ قال : كغراب أبيض في غربان سود ) )(@)(@@) أبو إسماعيل بن علي السمان في مشيخته عن عائشة رضي الله عنها قالت : اضطجع النبي مقبلا ثم استيقظ قال فذكره .(@)(@@) PageV04P496(@)(@@)(@@)(@@) |||| ( السين مع الميم من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 13006 ) قال النبي :(@)(@@) | 30 ( سمعتم بمدينة جانب منها في البر وجانب في البحر ؟ قالوا : نعم يا رسول الله ، قال : لا تقوم الساعة حتى يغزوها سبعون ألفا من بني إسحاق ، فإذا جاءوها نزلوا ، فلم يقاتلوا بسلام ، ولم يرموا بسهم ، قالوا : لا إلاه إلا الله والله أكبر فيسقط أحد جانبيها الذي في البحر ، ثم يقولوا الثانية : لا إلاه إلا الله والله أكبر فيسقط جانبها الآخر ، ثم يقولوا الثالثة : لا إلاه إلا الله والله أكبر فيفرج لهم فيدخلوها فيغنموا ، فبينما هم يقتسمون المغانم إذ جاءهم الصريخ فقال : إن الدجال قد خرج ، فيتركون كل شيء ويرجعون ) )(@)(@@) ( م ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 13007 ) قال النبي :(@)(@@) | 30 ( سم ابنك عبد الرحمان ) )(@)(@@) ( خ ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13008 ) قال النبي :(@)(@@) | 30 ( سمى هارون ابنيه : شبرا وشبيرا ، وإني سميت ابني : الحسن والحسين كما سمى به هاارون ابنيه ) )(@)(@@) البغوي وعبد الغني في الإيضاح وابن عساكر عن سلمان رضي الله عنه .(@)(@@) PageV05P005(@)(@@)(@@)(@@) $ ( 13009 ) قال النبي :(@)(@@) | 30 ( سموا أسقاطكم فإنهم من أفراطكم ) )(@)(@@) ابن عساكر عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13010 ) قال النبي :(@)(@@) | 30 ( سموا السقط يثقل الله به ميزانكم ، فإنه يأتي يوم القيامة يقول : أي رب 
ms1450	 أضاعوني فلم يسموني ) )(@)(@@) ميسرة في مشيخته عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13011 ) قال النبي :(@)(@@) | 30 ( سموا الله عليه وكلوه ) )(@)(@@) ( خ ه ) عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 13012 ) قال النبي :(@)(@@) | 30 ( سموا بأسماء الأنبياء ولا تسموا بأسماء الملائكة ) )(@)(@@) ( تخ ) عن عبد الله بن جراد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13013 ) قال النبي :(@)(@@) | 30 ( سموا باسمي ولا تكنوا بكنيتي ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 13014 ) قال النبي :(@)(@@) | 30 ( سموا باسمي ولا تكنوا بكنيتي ، فإني إنما بعثت قاسما أقسم بينكم ) )(@)(@@) ( ق ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13015 ) قال النبي :(@)(@@) | 30 ( سموه بأحب الأسماء إلي حمزة ) )(@)(@@) ( ك ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13016 ) قال النبي :(@)(@@) | 30 ( سمي رجب لأنه يترجب فيه خير كثير لشعبان ورمضان ) )(@)(@@) أبو محمد الحسن بن محمد الخلال في فضائل رجب عن أنس رضي الله عنه .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 13017 ) قال النبي :(@)(@@) | 30 ( سمعت كلاما في السماء فقلت : يا جبريل من PageV05P006 هاذا ؟ قال : هاذا موسى ، قلت : ومن يناجي ؟ قال : ربه تعالى ، قلت : ويرفع صوته على ربه ؟ قال : إن الله تعالى قد عرف له حدته ) )(@)(@@) ( حل ) عن ابن مسعزد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13018 ) قال النبي :(@)(@@) | 30 ( سمعت تسبيحا في السماوات العلى مع تسبيح كثير ، سبحت السماوات العلى من ذي المهابة مشفعات لذي العلو بما علا ، سبحان العلي الأعلى سبحانه وتعالى ) )(@)(@@) ( ض ) و ابن أبي حاتم ( طب حل هق ) في الأسماء عن عبد الرحمان بن قرط رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13019 ) قال النبي :(@)(@@) | 30 ( سمعت زيد بن عمرو بن نفيل يعيب أكل ما ذبح لغير الله ، فما ذقت شيئا ذبح على النصب حتى أكرمني الله تعالى ما أكرمني به من رسالته ) )(@)(@@) الديلمي عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 13020 ) قال النبي :(@)(@@) | 30 ( سمعت جبريل يقول : سمعت ميكائيل يقول : سمعت إسرافيل يقول : قال الله تعالى : هاذا دين أرتضيه لنفسي ولن يصلحه إلا السخاء وحسن الخلق ألا فأكرموه بهما ما صحبتموه ) )(@)(@@) الرافعي عن أنس رضي الله عنه قال : وقال أبو عبد الله الدقاق هاذا حسم 
ms1451	 من هاذا الطريق .(@)(@@)(@@)(@@) $ ( 13021 ) قال النبي :(@)(@@) | 30 ( سمه بأحب الناس إلي ، حمزة ) )(@)(@@) محمد بن مخلد في جزئه ( ك خط ) عن عمرو بن دينار عن رجل من الأنصار عن أبيه قال : ولد لي غلام فأتيت به النبي فقلت : ما أسميه ؟ قال فذكره .(@)(@@)(@@)(@@) $ ( 13022 ) قال النبي :(@)(@@) | 30 ( سموا بأسماء الأنبياء ، وأحب الأسماء إلى الله : عبد الله وعبد الرحمان ، وأصدقها : حارث وهمام ، وأقبحها : حرب ومرة ) )(@)(@@) ( ع ) عن أبي وهب الجشمي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13023 ) قال النبي :(@)(@@) | 30 ( سمي يوم الجمعة ، لأن فيها طبعت طينة أبيك آدم ، وفيها الصعقة والبعثة وفيها البطشة ، وفي آخر ثلاث ساعات منها ساعة من PageV05P007 دعا الله فيها استجاب له ) )(@)(@@) ( حم ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13024 ) قال النبي :(@)(@@) | 30 ( سميتموه بأسامي فراعنتكم ليكونن في هاذه الأمة رجل يقال له الوليد : هو شر على هاذه الأمة من فرعون على قومه ) )(@)(@@) ( ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) ||| ( السين مع الواو(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 13025 ) قال النبي :(@)(@@) | 30 ( سوء الخلق شؤم ) )(@)(@@) ابن شاهين في الأفراد عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 13026 ) قال النبي :(@)(@@) | 30 ( سوء الخلق شؤم ، وشراركم أسوؤكم خلقا ) )(@)(@@) ( خط ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 13027 ) قال النبي :(@)(@@) | 30 ( سوء الخلق شؤم ، وطاعة النساء ندامة ، وحسن الملكة نماء ) )(@)(@@) ابن منده عن الربيع الأنصاري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 13028 ) قال النبي :(@)(@@) | 30 ( سوء الخلق يفسد العمل كما يفسد الخل العسل ) )(@)(@@) الحارث والحاكم في الكنى ا عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 13029 ) قال النبي :(@)(@@) | 30 ( سوء المجالسة : شح وفحش وسوء خلق ) )(@)(@@) ابن المبارك في الزهد عن سليمان بن موسى مرسلا .(@)(@@)(@@)(@@) $ ( 13030 ) قال النبي :(@)(@@) | 30 ( سوداء ولود خير من حسناء لا تلد ، وإني مكاثر بكم الأمم يوم القيامة حتى بالسقط محبنطئا على باب الجنة ، يقال : ادخل الجنة PageV05P008 فيقول : يا رب وأبواي ؟ فيقال له : ادخل الجنة أنت وأبواك ) )(@)(@@) ( طب ) عن معاوية بن حيدة