ms121	 الله بن وصيف الشاعر(@)(@@)(@@)(@@) $ 2795 - (@)(@@) الناشيء آخر اسمه(@)(@@) علي بن عبد الله الحلاء ذكره الشيرازي ولم يذكر الذي قبله(@)(@@)(@@)(@@) $ 2796 - (@)(@@) الناصر الخليفة العباسي اسمه(@)(@@) أحمد بن المستضيء(@)(@@)(@@)(@@) $ 2797 - (@)(@@) ولقب بها قديما الموفق أبو أحمد بن المتوكل(@)(@@)(@@)(@@) $ 2798 - (@)(@@) وأول الخلفاء المروانيين بالأندلس(@)(@@) عبد الرحمن وجماعة بعدهم(@)(@@)(@@)(@@) $ 2799 - (@)(@@) ومن الملوك صلاح الدين يوسف بن أيوب وآخرون(@)(@@)(@@)(@@) $ 2800 - (@)(@@) نازيقا(@)(@@) اسمه محمد بن عبيد الله رأيت له سماعا مات سنة ثمان وعشرين وأربعمائة(@)PageV00P000(@)(@@)(@@)(@@) $ 2801 - (@)(@@) الناظر شاعر اسمه مهنا بن علي بن عبد القاهر(@)(@@)(@@)(@@) $ 2802 - (@)(@@) نافع المقرىء اسمه(@)(@@) سعيد بن سليمان الهمداني الأندلسي مات سنة احدى وعشرين وأربعمائة(@)(@@)(@@)(@@) $ 2803 - (@)(@@) ناقة اثنان(@)(@@) أحدهما عبد الله بن سلامة عن أحمد بن سهيل الواسطي(@)(@@)(@@)(@@) $ 2804 - (@)(@@) والآخر محمد بن إسحاق بن سلام الخورزمي(@)(@@)(@@)(@@) $ 2805 - (@)(@@) الناقد(@)(@@) هو عمرو بن محمد بن بكير(@)(@@)(@@)(@@) $ 2806 - (@)(@@) الناقط اسمه(@)(@@) عبد العزيز بن السري(@)PageV00P000(@)(@@)(@@)(@@) $ 2807 - (@)(@@) النبال(@)(@@) اسمه مسلم بن أبي سهل(@)(@@)(@@)(@@) $ 2808 - (@)(@@) الناموس الشاعر اسمه(@)(@@) سلمة بن مرة اللخمي جاهلي(@)(@@)(@@)(@@) $ 2809 - (@)(@@) النامي الشاعر اسمه أحمد بن محمد(@)(@@)(@@)(@@) $ 2810 - (@)(@@) الناقص(@)(@@) اسمه يزيد بن الوليد بن عبد الملك بن مروان(@)(@@)(@@)(@@) $ 2811 - (@)(@@) النبيل(@)(@@) هو أبو عاصم الضحاك بن مخلد البصري الشيباني(@)PageV00P000(@)(@@)(@@)(@@) $ 2812 - (@)(@@) نبيرة(@)(@@) هو محمد بن إبراهيم السمرقندي(@)(@@)(@@)(@@) $ 2813 - (@)(@@) النتيف(@)(@@) هو محمد بن القاسم بن أحمد بن فاذشاه الأصبهاني من أصحاب الأشعري صاحب الأصول(@)(@@)(@@)(@@) $ 2814 - (@)(@@) النحات اثنان(@)(@@) أحدهما اسمه مسلم(@)(@@)(@@)(@@) $ 2815 - (@)(@@) والآخر اسمه(@)(@@) محمد بن الحسن ذكر ابن الفرضي أن له تأليفا في رجال البخاري(@)(@@)(@@)(@@) $ 2816 - (@)(@@) النحاس جماعة منهم(@)(@@) أبو عمير عيسى بن محمد من شيوخ أبي داود(@)PageV00P000(@)(@@)(@@)(@@) $ 2817 - (@)(@@) وأبو جعفر النحوي نزيل مصر وآخرون(@)(@@)(@@)(@@) $ 2818 - (@)(@@) النحام(@)(@@) هو نعيم بن عبد الله العدوي له صحبة وابنه إبراهيم له رؤية ضبطه الأكثر بفتح النون وتشديد الحاء وضبطه ابن الكلبي بضم النون وتخفيف الحاء وهو لقب نعيم(@)(@@)(@@)(@@) $ 2819 - (@)(@@) نحوله اسمه(@)(@@) أحمد بن الحسن بن أحمد الأصبهاني من شيوخ السلفي(@)(@@)(@@)(@@) $ 2820 - (@)(@@) النجم الكبرى هو(@)(@@) أبو الجناب بفتح الجيم وتشديد النون وآخره موحدة أحمد بن عمر الزاهد مشهور مات سنة ثماني عشرة 
ms122	 وستمائة(@)(@@)(@@)(@@) $ 2821 - (@)(@@) النخاس بخاء معجمة جماعة(@)(@@) منهم مفضل بن صالح(@)PageV00P000(@)(@@)(@@)(@@) $ 2822 - (@)(@@) وإبراهيم بن ميمون السوائي مولاهم كان خياطا شيخ لابن عيينة وآخرون استوعبتهم في المشتبه(@)(@@)(@@)(@@) $ 2823 - (@)(@@) نخرة اسمه(@)(@@) يوسف وهو جد إبراهيم بن الحجاج الصنعاني أحد الضعفاء(@)(@@)(@@)(@@) $ 2824 - (@)(@@) ندل(@)(@@) هو عبد الله بن بكر بن سابق الكلاعي النحوي ذكره أبو مروان بن حيان في تاريخه(@)(@@)(@@)(@@) $ 2825 - (@)(@@) النذير العريان قال المرزباني(@)(@@) اسمه الزنير بن عمرو الخثعمي(@)(@@)(@@)(@@) $ 2826 - (@)(@@) نسيج وحده هو(@)(@@) عمير بن سعد الأنصاري له صحبة(@)(@@)(@@)(@@) $ 2827 - (@)(@@) النسر الشاعر الخوارزمي اسمه شرف(@)PageV00P000(@)(@@)(@@)(@@) $ 2828 - (@)(@@) النسيب أبو القاسم علي بن الحسن الهاشمي العلوي شيخ ابن عساكر(@)(@@)(@@)(@@) $ 2829 - (@)(@@) نصرك(@)(@@) هو نصر بن أحمد بن أحمد الحافظ البغدادي نزيل بخارى يروي عن مسلم(@)(@@)(@@)(@@) $ 2830 - (@)(@@) نصف الطريق الغساني مخضرم أسلم في عهد عمر ذكر ابن عساكر سبب تسميته بذلك في ترجمة حفاظ بن الحسن حفيده ولم يسمه هو(@)(@@)(@@)(@@) $ 2831 - (@)(@@) نطاحة(@)(@@) هو أحمد بن إسماعيل بن إبراهيم بن الخصيب(@)(@@)(@@)(@@) $ 2832 - (@)(@@) النظام(@)(@@) هو إبراهيم بن سيار بغدادي مشهور من المعتزلة(@)(@@)(@@)(@@) $ 2833 - (@)(@@) ومحسن بن علي بن الحسين البصري الشاعر الضرير الجوال أبو عبد الله سمع الطبراني(@)PageV00P000(@)(@@)(@@)(@@) $ 2834 - (@)(@@) نظام الملك(@)(@@) اسمه الحسين بن علي بن إسحاق الطوسي الوزير(@)(@@)(@@)(@@) $ 2835 - (@)(@@) ونظام الدين لقب جماعة من المتأخرين(@)(@@)(@@)(@@) $ 2836 - (@)(@@) النعامة هو بيهس بن خلف الفزاري(@)(@@)(@@)(@@) $ 2837 - (@)(@@) نعجة(@)(@@) لقب أبي الشكر حامد بن محمد بن علي الحربي بغدادي في الستمائة(@)(@@)(@@)(@@) $ 2838 - (@)(@@) نعمة(@)(@@) هو أحمد بن يحيى بن البهي الأزدي ويقال بالقاف بدل العين(@)(@@)(@@)(@@) $ 2839 - (@)(@@) وأبو عبد الله محمد بن الربيع بن سليمان الأزدي ذكر ابن يونس أن لقبه أيضا نعمة(@)(@@)(@@)(@@) $ 2840 - (@)(@@) النعيث بمهملة ثم مثناة بوزن عظيم صحابي اسمه(@)(@@) أسيد ويقال أسد بن يعمر الخزاعي(@)PageV00P000(@)(@@)(@@)(@@) $ 2841 - (@)(@@) نغوبا بفتح أوله وضم المعجمة وسكون الواو ثم موحدة اسمه(@)(@@) حسين بن عبد الوهاب وفي أولاده جماعة محدثون(@)(@@)(@@)(@@) $ 2842 - (@)(@@) نفطويه(@)(@@) هو إبراهيم بن محمد بن عرفة النحوي المشهور(@)(@@)(@@)(@@) $ 2843 - (@)(@@) ولقب بها أيضا علي بن عبد الرحمن الحضرمي المقرىء المصري في المائة السادسة(@)(@@)(@@)(@@) $ 2844 - (@)(@@) نقطة(@)(@@) هو منصور بن محمد 
ms123	 بن أميرجه النيسابوري(@)(@@)(@@)(@@) $ 2845 - (@)(@@) نقمة تقدم(@)(@@)(@@)(@@) $ 2846 - (@)(@@) النقي هو(@)(@@) عباس بن الوليد بن عبد الملك(@)PageV00P000(@)(@@)(@@)(@@) $ 2847 - (@)(@@) النقاش جماعة(@)(@@) منهم أبو جعفر محمد بن عيسى(@)(@@)(@@)(@@) $ 2848 - (@)(@@) وأبو بكر محمد بن الحسن صاحب التفسير وغيرهما(@)(@@)(@@)(@@) $ 2849 - (@)(@@) نقاش الفضة(@)(@@) هو محمد بن أحمد بن العباس الجوهري المتكلم على طريقة الأشعري(@)(@@)(@@)(@@) $ 2850 - (@)(@@) نقيب الفقهاء(@)(@@) اسمه عمرو بن علي البغدادي يكنى أبا سعيد(@)(@@)(@@)(@@) $ 2851 - (@)(@@) النكاح(@)(@@) شاعر مدني مدح المهدي وروى عن مالك واسمه عبد السلام ابن أبي سليمان وقيل لقب بذلك لقوله(@)(@@) (تزوجت ألفا ثم طلقت مثله ... فلم أترك مالا ولم أترك وفرا)(@)PageV00P000(@)(@@)(@@)(@@) $ 2852 - (@)(@@) نكار(@)(@@) هو إسحاق بن إبراهيم بن نصر السعدي أبو إبراهيم البخاري من شيوخ الصحيح كذا رأيته بخط معتمد(@)(@@) وقد تقدم في الزاي(@)(@@)(@@)(@@) $ 2853 - (@)(@@) نكال(@)(@@) هو عبد الرحمن بن سعيد بن مسلم الباهلي(@)(@@)(@@)(@@) $ 2854 - (@)(@@) النهاس والد عتيبة لقب بذلك لشعر قاله(@)(@@)(@@)(@@) $ 2855 - (@)(@@) نهشل(@)(@@) اسمه إبراهيم بن دارم بن أحمد الدارمي من شيوخ الدارقطني(@)(@@)(@@)(@@) $ 2856 - (@)(@@) النواء جماعة(@)(@@) منهم أبو إسماعيل كثير الكوفي(@)(@@)(@@)(@@) $ 2857 - (@)(@@) ومنهم أزهر بن مروان الرقاشي وآخرون(@)PageV00P000(@)(@@) - حرف الواو(@)(@@) يبدأ برقم 2858 وينتهي برقم 2916(@)PageV02P225(@)(@@)(@@)(@@) || - حرف الواو(@)(@@)(@@)(@@) $ 2858 - (@)(@@) وارث الزهري هو محمد بن يحيى الدهلي قيل له ذلك لجمعه حديث الزهري(@)(@@)(@@)(@@) $ 2859 - (@)(@@) الواثق بالله الخليفة(@)(@@) هو أبو جعفر هارون بن المعتصم(@)(@@)(@@)(@@) $ 2860 - (@)(@@) الوأواء الشاعر اسمه(@)(@@) محمد بن أحمد يكنى أبا الفرج مشهور(@)(@@)(@@)(@@) $ 2861 - (@)(@@) ولقب بها(@)(@@) عبد القاهر بن عبد الله الشيباني الحلبي في المائة السادسة رآه ابن عساكر(@)(@@)(@@)(@@) $ 2862 - (@)(@@) وبرة اسمه(@)(@@) عمر بن القاسم المقرىء(@)PageV00P000(@)(@@)(@@)(@@) $ 2863 - (@)(@@) وجنة الحية(@)(@@) يحي بن عبد الرحمن الأندلسي ومنهم من يقول وجه الحية(@)(@@)(@@)(@@) $ 2864 - (@)(@@) وجه الباب(@)(@@) هو عبد الله بن شريح المكي النديم(@)(@@)(@@)(@@) $ 2865 - (@)(@@) وجه الشاة هو(@)(@@) أبو علي أحمد بن جعفر بن محمد بن علي بن الهيثم(@)(@@)(@@)(@@) $ 2866 - (@)(@@) وجه العجوز(@)(@@) هو عبد الله بن يحي بن عبد الجبار السكري(@)(@@)(@@)(@@) $ 2867 - (@)(@@) وجه الفلس(@)(@@) هو عبد الرحمن بن ميمون أحد الفرسان هو الذي احتز رأس الوليد ابن يزيد(@)(@@)(@@)(@@) $ 2868 - (@)(@@) وجه الوزة(@)(@@) اسمه دكا مغن مشهور(@)(@@)(@@)(@@) $ 2869 - (@)(@@) وجه 
ms124	 السبع اسمه(@)(@@) سنقر كان أحد أمراء الناصر الخليفة العباسي وحج بالناس بعد(@)PageV00P000(@)(@@) الستمائة(@)(@@)(@@)(@@) $ 2870 - (@)(@@) الوجيه جماعة منهم ابن الدروي الشاعر اسمه(@)(@@) علي مصري شاعر في دولة صلاح الدين(@)(@@) وآخرون لقبوا وجيه الدين(@)(@@)(@@)(@@) $ 2871 - (@)(@@) وجيه بغير إضافة(@)(@@) هو أبو علي أحمد بن جعفر البغدادي(@)(@@)(@@)(@@) $ 2872 - (@)(@@) الوجيه الصغير اسمه(@)(@@) إبراهيم بن مسعود الرصافي بعد الستمائة ذكره ياقوت(@)(@@)(@@)(@@) $ 2873 - (@)(@@) وحشي هو(@)(@@) محمد بن محمد بن مصعب الصوري(@)(@@)(@@)(@@) $ 2874 - (@)(@@) الوحيد(@)(@@) هو الوليد بن المغيرة بن عبد الله بن عمر بن مخزوم والد خالد(@)PageV00P000(@)(@@)(@@)(@@) $ 2875 - (@)(@@) الوراق جماعة منهم(@)(@@) عبد الوهاب بن الحكم البغدادي(@)(@@)(@@)(@@) $ 2876 - (@)(@@) الورتنيس(@)(@@) هو إبراهيم جد أحمد بن يزيد شيخ البخاري(@)(@@)(@@)(@@) $ 2877 - (@)(@@) ورد جماعة منهم(@)(@@) مخلد بن لبيد إمام جامع بيروت(@)(@@)(@@)(@@) $ 2878 - (@)(@@) ومحمد بن الحارث المصري وغيرهما(@)(@@)(@@)(@@) $ 2879 - (@)(@@) ورش المقرىء اسمه(@)(@@) عثمان بن سعيد صاحب نافع(@)(@@)(@@)(@@) $ 2880 - (@)(@@) ورزة اسمه(@)(@@) مقاتل والد محمد بن مقاتل بن الوليد البخاري الرازي(@)PageV00P000(@)(@@)(@@)(@@) $ 2881 - (@)(@@) الوزان جماعة منهم(@)(@@) أيوب بن محمد(@)(@@)(@@)(@@) $ 2882 - (@)(@@) الوزنة(@)(@@) هو عبد الرحمن بن محمد بن عمران الفقيه من أصحاب سحنون(@)(@@)(@@)(@@) $ 2883 - (@)(@@) الوزير جماعة منهم(@)(@@) علي بن إسحاق الأصبهاني(@)(@@)(@@)(@@) $ 2884 - (@)(@@) وأحمد بن يحي المصري وآخرون(@)(@@)(@@)(@@) $ 2885 - (@)(@@) الوسواس اثنان هما(@)(@@) محمد بن إسماعيل(@)(@@)(@@)(@@) $ 2886 - (@)(@@) وعبد الله بن عيسى الرازي(@)(@@)(@@)(@@) $ 2887 - (@)(@@) وسواسة(@)(@@) هو أحمد بن محمد بن إسماعيل بن إبراهيم الموصلي كان إسحاق النديم الموصلي عم أبيه(@)(@@)(@@)(@@) $ 2888 - (@)(@@) وشجه في خجشة(@)(@@)(@@)(@@) $ 2889 - (@)(@@) وشقه(@)(@@) هو محمد بن مسلم الرازي(@)(@@)(@@)(@@) $ 2890 - (@)(@@) وصيف(@)(@@) الحسين بن عبد الله الأشروسني(@)PageV00P000(@)(@@)(@@)(@@) $ 2891 - (@)(@@) وجرير بن عبد الله المقرىء(@)(@@)(@@)(@@) $ 2892 - (@)(@@) ومحمد بن الفضل بن سلمة(@)(@@)(@@)(@@) $ 2893 - (@)(@@) الوضاح(@)(@@) لقب جذيمة الأبرش جاهلي(@)(@@)(@@)(@@) $ 2894 - (@)(@@) وضاح اليمن الشاعر اسمه عبد الله(@)(@@)(@@)(@@) $ 2895 - (@)(@@) الوضي(@)(@@) عبد الله بن عثمان بن وهب بن عمرو بن صفوان بن أمية الجمحي(@)(@@)(@@)(@@) $ 2896 - (@)(@@) وطواط هو(@)(@@) الشيخ الرشيد محمد بن محمد بن عبد الجليل الكاتب مات سنة ثلاث وسبعين وخمسمائة(@)(@@)(@@)(@@) $ 2897 - (@)(@@) وآخرون منهم(@)(@@) الكتبي على رأس التسعين وستمائة اسمه محمد بن إبراهيم(@)(@@)(@@)(@@) $ 2898 - (@)(@@) وفرة بالفاء الحسن بن علي الخلقاني(@)PageV00P000(@)(@@)(@@)(@@) $ 2899 - (@)(@@) الوقعة(@)(@@) هو عوف بن معاوية بن 
ms125	 بكر جاهلي(@)(@@)(@@)(@@) $ 2900 - (@)(@@) الوقار بتخفيف القاف اسمه(@)(@@) زكريا بن يحي المالكي المصري صاحب ابن وهب(@)(@@)(@@)(@@) $ 2901 - (@)(@@) وقدان هو(@)(@@) أبو يعفور الكوفي العبدي اسمه واقد(@)(@@)(@@)(@@) $ 2902 - (@)(@@) وكيع(@)(@@) هو محمد بن خلف الضبي القاضي على رأس الثلاثمائة له تصانيف(@)(@@)(@@)(@@) $ 2903 - (@)(@@) ولقب بها أحمد بن علي بن محمد شيخ الحسن بن إسحاق السراج(@)PageV00P000(@)(@@)(@@)(@@) $ 2904 - (@)(@@) وكيل أبي صخرة اسمه واسم أبي صخرة عبد الرحمن ابن محمد(@)(@@)(@@)(@@) $ 2905 - (@)(@@) وكا(@)(@@) هو عامر بن عمرو بن عبدود العامري(@)(@@)(@@)(@@) $ 2906 - (@)(@@) ولاد النحوي(@)(@@) اسمه الوليد بن محمد المصري(@)(@@)(@@)(@@) $ 2907 - (@)(@@) ولده(@)(@@) عبد الله بن محمد بن عبد الله بن أحمد بن بندار عن أبي الحسين ابن المظفر(@)(@@)(@@)(@@) $ 2908 - (@)(@@) ولدون(@)(@@) هو الوليد بن الحسن الديبلي أبو العباس عن يحي بن صالح الوحاظي(@)PageV00P000(@)(@@)(@@)(@@) $ 2909 - (@)(@@) وليد(@)(@@) هو محمد بن القاسم الزاهد صاحب الكسائي من الفقهاء بمصر(@)(@@)(@@)(@@) $ 2910 - (@)(@@) وليد(@)(@@) هو محمد بن قاسم بن أحمد الصوفي يكنى أبا بكر مات سنة 372 ه(@)(@@)(@@)(@@) $ 2911 - (@)(@@) الولي(@)(@@) هو أبو بكر أحمد بن عبد الرحمن بن الفضل العجلي المقرىء يكنى أبا بكر مات سنة خمس وخمسين وثلاثمائة(@)(@@)(@@)(@@) $ 2912 - (@)(@@) ولقب به جماعة منهم(@)(@@) الولي العجمي كاتب المنسوب اسمه علي(@)(@@) وولي الدولة(@)(@@) وولي الدين جمع جم من المتأخرين(@)(@@)(@@)(@@) $ 2913 - (@)(@@) وهب بن سعيد بن عطية اسمه عبد الوهاب(@)(@@)(@@)(@@) $ 2914 - (@)(@@) وهبان بن بقية اسمه وهب(@)(@@)(@@)(@@) $ 2915 - (@)(@@) وهيب بن الورد(@)(@@) اسمه عبد الوهاب(@)(@@)(@@)(@@) $ 2916 - (@)(@@) وهيب أيضا هو(@)(@@) عبد الوهاب بن غسان شيخ لابن خزيمة(@)PageV00P000(@)(@@) - حرف الهاء(@)(@@) يبدأ برقم 2917 وينتهي برقم 2934(@)PageV02P237(@)(@@)(@@)(@@) || - حرف الهاء(@)(@@)(@@)(@@) $ 2917 - (@)(@@) الهادي الخليفة اسمه(@)(@@) موسى بن المهدي بن المنصور(@)(@@)(@@)(@@) $ 2918 - (@)(@@) الهاد الليثي اسمه(@)(@@) عمرو بن عبد الله وهو والد شداد الصحابي قيل له ذلك لأنه كان يوقد النار للأضياف(@)(@@)(@@)(@@) $ 2919 - (@)(@@) الهائم(@)(@@) هو أبو علي أحمد بن علي المدائني سمع منه أبو القاسم التنوخي(@)(@@)(@@)(@@) $ 2920 - (@)(@@) هبنقة القيسي اسمه(@)(@@) يزيد بن ثروان ويكنى أبا رافع يضرب به المثل في الحمق(@)PageV00P000(@)(@@)(@@)(@@) $$ 2921 - (@)(@@) هبير لقب أم هانىء بنت أبي طالب واسمها فاخته كذا ذكر ابن منده والمعروف أن هبيرة اسم زوجها(@)(@@)(@@)(@@) $ 2922 
ms126	 - (@)(@@) الهجف(@)(@@) هو كريم بن معاوية بن ثعلبة(@)(@@)(@@)(@@) $ 2923 - (@)(@@) هداب بن خالد هو هدبة البصري شيخ مسلم(@)(@@)(@@)(@@) $ 2924 - (@)(@@) الهراء النحوي اسمه معاذ(@)(@@)(@@)(@@) $ 2925 - (@)(@@) هذيل بن عبد الرحمن اسمه(@)(@@) عمران سمع وهب بن منبه(@)PageV00P000(@)(@@)(@@)(@@) $ 2926 - (@)(@@) هريسة(@)(@@) هو جعفر بن عيسى الهاشمي في زمن المأمون(@)(@@)(@@)(@@) $ 2927 - (@)(@@) هزار اسمه(@)(@@) سعيد بن جناح سمع ابن عيينة ويقال له هزار تارة(@)(@@)(@@)(@@) $ 2928 - (@)(@@) الهزبر هو(@)(@@) محمد بن علي الاسكندراني الميقاتي من شيوخنا بالاجازة(@)(@@)(@@)(@@) $ 2929 - (@)(@@) هزهاز الكوفي اسمه(@)(@@) هانىء سمع ابن مسعود وليس هو الهزهاز بن ميرن ذلك متأخر عنه(@)PageV00P000(@)(@@)(@@)(@@) $ 2930 - (@)(@@) هلب بضم ثم سكون وقيل بفتح ثم كسر الطائي اسمه يزيد ابن علي بن قنافة له صحبة(@)(@@)(@@)(@@) $ 2931 - (@)(@@) هليلجة(@)(@@) هو محمد بن أحمد بن علي بن أحمد بن سعيد البغدادي عن أبي قلابة الرقاشي(@)(@@)(@@)(@@) $ 2932 - (@)(@@) هميسع(@)(@@) هو زيد بن حمل بن نبت قيدار بن إسماعيل بن إبراهيم الخليل(@)(@@)(@@)(@@) $ 2933 - (@)(@@) هواشة(@)(@@) هو أبو بكر أحمد بن علي بن إسماعيل الجهبذ(@)(@@)(@@)(@@) $ 2934 - (@)(@@) الهول(@)(@@) اسمه علي بن سهل الرازي(@)PageV00P000(@)(@@) - حرف الياء(@)(@@) يبدأ برقم 2935 وينتهي برقم 2950(@)PageV02P243(@)(@@)(@@)(@@) || - حرف الياء الأخيرة(@)(@@)(@@)(@@) $ 2935 - (@)(@@) يأجوج(@)(@@) هو مقاتل بن الفضل عن ابن جريج(@)(@@)(@@)(@@) $ 2936 - (@)(@@) يا قوتك هو(@)(@@) أبو منصور نصر بن أحمد بن سعيد الكرابيسي(@)(@@)(@@)(@@) $ 2937 - (@)(@@) ياقوتة العلماء(@)(@@) هو المعافى بن عمران الموصلي(@)(@@)(@@)(@@) $ 2938 - (@)(@@) يتيم عروة هو(@)(@@) أبو الأسود محمد بن عبد الرحمن بن نوفل(@)(@@)(@@)(@@) $ 2939 - (@)(@@) اليتيم هو(@)(@@) إسحاق بن إسماعيل الطالقاني وآخرون(@)(@@)(@@)(@@) $ 2940 - (@)(@@) يرى(@)(@@) هو نبت بن قيدار بن إسماعيل فيما قيل(@)PageV00P000(@)(@@)(@@)(@@) $ 2941 - (@)(@@) يزيد بن أبي حبيب شيخ بصري يروي عن أصحاب مالك بن أنس كان اسمه أحمد بن زكريا واشتهر بيزيد بن أبي حبيب وأما يزيد ابن أبي حبيب المصري التابعي فهو في عداد من يكون بين هذا وبينه رجلان على القليل(@)(@@)(@@)(@@) $ 2942 - (@)(@@) يزيد(@)(@@) هو أحمد بن أبي رجاء القاسم الأسود شيخ لأبي عمر الباوردي(@)(@@)(@@)(@@) $ 2943 - (@)(@@) يزداد هو(@)(@@) أحمد بن عمر الهمداني عن يزيد بن هارون(@)(@@)(@@)(@@) $ 2944 - (@)(@@) يعسوب قريش(@)(@@) هو عبد الرحمن بن عتاب بن أسيد الأموي نقله الزبير عن ابن أبي 
ms127	 طالب(@)(@@)(@@)(@@) $ 2945 - (@)(@@) اليمان والد حذيفة اسمه(@)(@@) حسل بن جابر صحابي استشهد بأحد(@)(@@)(@@)(@@) $ 2946 - (@)(@@) يموت بن المزرع البغدادي الأخباري اسمه محمد(@)PageV00P000(@)(@@)(@@)(@@) $ 2947 - (@)(@@) يوسف الأمة هو جرير بن عبد الله البجلي(@)(@@)(@@)(@@) $ 2948 - (@)(@@) يؤيؤ اثنان هما محمد بن زياد الزيادي(@)(@@)(@@)(@@) $ 2949 - (@)(@@) وإسحاق بن إبراهيم البغوي وقد تقدم في اللام(@)(@@)(@@)(@@) $ 2950 - (@)(@@) ييا هو محمد بن عبد الجبار بن يعقوب الأصبهاني شيخ للسلفي(@)(@@) آخر الأسماء وما معها(@)PageV00P000(@)(@@)(@@)(@@) | - الباب الثاني - في الألقاب بألفاظ الكنى يبدأ برقم 2951 وينتهي برقم 3099(@)PageV02P249(@)(@@) - باب الكنى(@)(@@)(@@)(@@) || - الألف(@)(@@)(@@)(@@) $ 2951 - (@)(@@) أبو الآذان بالمد(@)(@@) هو عمر بن إبراهيم الحافظ وكنيته أبو بكر(@)(@@)(@@)(@@) $ 2952 - (@)(@@) أبو الأشنان(@)(@@) الحسن بن علي النخعي كنيته أبو علي أحد الضعفاء ذكره ابن عدي(@)(@@)(@@)(@@) $ 2953 - (@)(@@) أبو الأشد بن كلدة بن أسد بن خلف الجمحي قتل كافرا كنيته أبو الأعور(@)(@@)(@@)(@@) $ 2954 - (@)(@@) أبو الأحوص العكبري اسمه(@)(@@) محمد بن الهيثم وكنيته أبو عبد الله(@)(@@)(@@)(@@) $ 2955 - (@)(@@) أبو الأضياف(@)(@@) هو إبراهيم الخليل وكنيته أبو إسماعيل وأبو محمد(@)(@@)(@@)(@@) $ 2956 - (@)(@@) أبو أمية سعيد بن عثمان الأهوازي سكن مكة كنيته أبو سهل(@)PageV00P000(@)(@@)(@@)(@@) || - حرف الباء(@)(@@)(@@)(@@) $ 2957 - (@)(@@) أبو البداح بن عاصم بن عدي الأنصاري كنيته أبو عمرو(@)(@@)(@@)(@@) $ 2958 - (@)(@@) أبو برزة الحاسب(@)(@@) صالح بن شعيب كنيته أبو شعيب(@)(@@)(@@)(@@) $ 2959 - (@)(@@) أبو البشر(@)(@@) آدم عليه السلام كنيته أبو محمد(@)(@@)(@@)(@@) $ 2960 - (@)(@@) أبو بطن(@)(@@) هو أسامة بن زيد الصحابي كنيته أبو محمد(@)(@@)(@@)(@@) $ 2961 - (@)(@@) والطفيل بن أبي بن كعب يقال له أبو بطن أيضا(@)(@@)(@@)(@@) $ 2962 - (@)(@@) أبو بعرة(@)(@@) هو القاسم بن محمد بن يحي بن طلحة الكوفي ولي الشرطة في إمارة عيسى بن موسى العباسي(@)(@@)(@@)(@@) $ 2963 - (@)(@@) أبو البهار الثقفي(@)(@@) هو محمد بن القاسم الشاعر قال المرزباني كان يعجب بالبهار فكني به(@)(@@)(@@)(@@) $ 2964 - (@)(@@) أبو البنات(@)(@@) هو أبو سفيان بن الحارث بن قيس الأنصاري صحابي استشهد ببدر(@)PageV00P000(@)(@@)(@@)(@@) || - التاء(@)(@@)(@@)(@@) $ 2965 - (@)(@@) أبو تراب(@)(@@) علي بن أبي طالب أبو الحسن كناه النبي صلى الله عليه وسلم وكان يحبها وكان أعداؤه يقولون أبو تراب ظنا منهم أنه يكرهها(@)(@@)(@@)(@@) $ 2966 - (@)(@@) أبو تراب الأعمشي(@)(@@) هو أبو حامد أحمد بن حمدون(@)(@@)(@@)(@@) $ 2967 - (@)(@@) أبو تراب النخشبي ذكره 
ms128	 ابن منده وقال اسمه عسكر بن الحسين وكنيته وبيض لها(@)(@@)(@@)(@@) $ 2968 - (@)(@@) أبو تراب أيضا(@)(@@) يوسف بن عثمان الزنجابي يكنى أبا يعقوب سمع محمد بن إبراهيم ابن زاذان وسكن همذان وأصبهان(@)(@@)(@@)(@@) $ 2969 - (@)(@@) أبو تميلة اثنان(@)(@@) يحي بن واضح كنيته أبو محمد(@)(@@)(@@)(@@) $ 2970 - (@)(@@) ومحمد بن إبراهيم الضرير عن سليمان بن حرب يكنى أبا جعفر(@)PageV00P000(@)(@@)(@@)(@@) || - الثاء(@)(@@)(@@)(@@) $ 2971 - (@)(@@) أبو ثور(@)(@@) إبراهيم بن خالد الفقيه كنيته أبو عبد الله(@)(@@)(@@)(@@) || - الجيم(@)(@@)(@@)(@@) $ 2972 - (@)(@@) أبو الجرت(@)(@@) إسماعيل بن إبراهيم المصري كنيته أبو محمد(@)(@@)(@@)(@@) $ 2973 - (@)(@@) أبو جعفرك(@)(@@) أحمد بن علي البيهقي كنيته أبو جعفر(@)PageV00P000(@)(@@)(@@)(@@) $ 2974 - (@)(@@) أبو الجوزاء(@)(@@) أحمد بن عثمان النوفلي من شيوخ مسلم يكنى أبا عثمان(@)(@@)(@@)(@@) $ 2975 - (@)(@@) أبو الجماهر(@)(@@) محمد بن عثمان التنوخي يكنى أبا عبد الرحمن(@)(@@)(@@)(@@) $ 2976 - (@)(@@) أبو الجمل(@)(@@) هو أيوب بن محمد اليمامي كنيته أبو سهل(@)(@@)(@@)(@@) $ 2977 - (@)(@@) أبو جهل(@)(@@) عمرو هشام بن المغيرة المخزومي كنيته أبو الحكم(@)(@@)(@@)(@@) || - الحاء(@)(@@)(@@)(@@) $ 2978 - (@)(@@) أبو حازم العبدوي(@)(@@) عمر بن أحمد الحافظ يكنى أبا حفص ذكره ابن الفلكي(@)(@@)(@@)(@@) $ 2979 - (@)(@@) أبو حجة(@)(@@) أحمد بن محمد بن محمد بن القيسي المقرىء كنيته أبو جعفر مات بعد سنة ثلاثين وستمائة(@)PageV00P000(@)(@@)(@@)(@@) $ 2980 - (@)(@@) أبو حجية(@)(@@) علي بن بهرام كنيته أبو الحسن(@)(@@)(@@)(@@) $ 2981 - (@)(@@) أبو الحريش(@)(@@) أحمد بن عيسى الكلابي كنيته أبو جعفر(@)(@@)(@@)(@@) $ 2982 - (@)(@@) أبو حزرة(@)(@@) يعقوب بن مجاهد كنيته أبو يوسف(@)(@@)(@@)(@@) $ 2983 - (@)(@@) أبوحشيشة محمد بن أمية المغني كنيته أبو جعفر(@)PageV00P000(@)(@@)(@@)(@@) $ 2984 - (@)(@@) أبو حفيص(@)(@@) عمر بن حسن القاضي الحلبي كنيته أبو حفص(@)(@@)(@@)(@@) $ 2985 - (@)(@@) أبو حكيمة بالتصغير اسمه(@)(@@) راشد بن إسحاق وكنيته أبو محمد وهو شاعر كاتب في دولة المأمون(@)(@@)(@@)(@@) $ 2986 - (@)(@@) أبو حلمان(@)(@@) علي الحلبي كنيته أبو الحسن(@)(@@)(@@)(@@) $ 2987 - (@)(@@) أبو حمدون النقاش الذهلي البغدادي المقرىء كنيته أبو محمد واسمه الطيب بن إسماعيل ذكره الداني(@)(@@)(@@)(@@) $ 2988 - (@)(@@) أبو حمة بضم وتخفيف محمد بن يوسف الزبيدي صاحب أبي قرة كنيته أبو يوسف(@)(@@)(@@)(@@) $ 2989 - (@)(@@) أبو حنش الأندلسي يكنى أبا عمر كان شاعرا روى عنه الوليد بن بكر(@)(@@)(@@)(@@) $ 2990 - (@)(@@) أبو حنيفة(@)(@@) محمد بن يوسف الرازي كنيته أبو يوسف(@)(@@)(@@)(@@) $ 2991 - (@)(@@) أبو حنيفة آخر(@)(@@) هو عبد الرحمن 
ms129	 محمد بن رياح(@)PageV00P000(@)(@@)(@@)(@@) $ 2992 - (@)(@@) أبو حنيفة ثالث(@)(@@) هو محمد بن عثمان الثعالبي يكنى أبا الحسين كان في صباه يتمشيخ ويلبس الطيلسان فلقب أبا حنيفة وكان في وسط المائة الرابعة(@)(@@)(@@)(@@) $ 2993 - (@)(@@) أبو حوالا الأسدي(@)(@@) بشر بن الهذيل كنيته أبو الوليد سمع الحسن بن صالح بن حبي(@)(@@)(@@)(@@) $ 2994 - (@)(@@) أبو حية(@)(@@) اليسع بن أسعد كنيته أبو يحي(@)(@@)(@@)(@@) || - الخاء(@)(@@)(@@)(@@) $ 2995 - (@)(@@) أبو خراسان(@)(@@) أحمد بن محمد بن السكن كنيته أبو بكر(@)(@@)(@@)(@@) $ 2996 - (@)(@@) أبو الخيش القيرواني كنيته أبو عبد العزيز(@)(@@)(@@)(@@) $ 2997 - (@)(@@) أبو الخنافش(@)(@@) ذكر الجاحظ في الحيوان أنها كنية رجل فاضل فقيه من ولد(@)PageV00P000(@)(@@) عبد الجبار بن وائل الحضرمي وأنه لقيه وسأله عن سبب هذه الكنية ثم وجدت في كامل ابن عدي في ترجمة محمد بن حجر بن عبد الجبار بن وائل بن حجر ما لفظه سمعت ابن حماد يقول سمعت إبراهيم بن سعيد الجوهري يقول كان محمد بن حجر هذا يكنى أبا الخنافس وذكر الحاكم أبو أحمد أنه كان يكنى أبا بكر وقيل غير ذلك(@)(@@)(@@)(@@) || - الدال(@)(@@)(@@)(@@) $ 2998 - (@)(@@) أبو درهم(@)(@@) شعيب بن درهم البصري يكنى أبا زياد(@)(@@)(@@)(@@) $ 2999 - (@)(@@) أبو الدلعلع أحمد بن سهل الوراق الواسطي عن يزيد بن هارون يكنى أبا جعفر(@)PageV00P000(@)(@@)(@@)(@@) || - الذال المعجمة(@)(@@)(@@)(@@) $ 3000 - (@)(@@) أبو ذات الكرش(@)(@@) هو عبيدة بن سعيد بن العاص بن أمية(@)(@@)(@@)(@@) $ 3001 - (@)(@@) أبو الذبان(@)(@@) عبد الملك بن مروان بن الحكم كنيته أبو الوليد(@)(@@)(@@)(@@) $ 3002 - (@)(@@) أبو ذيب(@)(@@) هو إبراهيم بن محمد بن أبي يحي لقبه بذلك ابن جريج(@)(@@)(@@)(@@) || - الراء(@)(@@)(@@)(@@) $ 3003 - (@)(@@) أبو الرجال(@)(@@) هو محمد بن عبد الرحمن الأنصاري المدني كنيته أبو محمد(@)(@@)(@@)(@@) $ 3004 - (@)(@@) وأحمد بن المبارك البراني كنيته أبو بكر(@)(@@)(@@)(@@) $ 3005 - (@)(@@) أبو الرعد محمد بن جعفر بن حم كنيته أبو جعفر(@)(@@)(@@)(@@) $ 3006 - (@)(@@) أبو الرقراق(@)(@@) أحمد بن محمد بن عبد العزيز المصري أبو جعفر(@)PageV00P000(@)(@@)(@@)(@@) $ 3007 - (@)(@@) أبو رقية(@)(@@) عبد الرحمن بن يوسف بن الملحوم كنيته أبو القاسم كان بعد الستمائة بفاس(@)(@@)(@@)(@@) $ 3008 - (@)(@@) أبو الرقعمق الشاعر(@)(@@) أحمد بن محمد يكنى أبا حامد(@)(@@)(@@)(@@) $ 3009 - (@)(@@) أبو الرأي(@)(@@) هارون بن الحسين المصري كنيته أبو محمد(@)(@@)(@@)(@@) $ 3010 - (@)(@@) أبو ركوة 
ms130	 الأموي الذي خرج على الحاكم الفاطمي بمصر(@)(@@)(@@)(@@) $ 3011 - (@)(@@) أبو الروس(@)(@@) محمد بن هارون المصري كنيته أبو جعفر(@)(@@)(@@)(@@) $ 3012 - (@)(@@) ومثله محمد بن عيسى البغدادي كنيته أبو عبد الله(@)(@@)(@@)(@@) $ 3013 - (@)(@@) أبو رويق عبد الرحمن بن خلف الضبي كنيته أبو محمد من شيوخ أبي عوانة الأسفراييني(@)PageV00P000(@)(@@)(@@)(@@) || - الزاي(@)(@@)(@@)(@@) $ 3014 - (@)(@@) أبو الزبد(@)(@@) محمد بن المبارك المعافري كنيته أبو عبد الله(@)(@@)(@@)(@@) $ 3015 - (@)(@@) أبو زكار(@)(@@) خليل بن زكريا الشيباني(@)(@@)(@@)(@@) $ 3016 - (@)(@@) وعبد الملك بن يحي كنية كل منهما أبو زكريا(@)(@@)(@@)(@@) $ 3017 - (@)(@@) أبو زكير المدني(@)(@@) يحي بن محمد بن قيس(@)(@@)(@@)(@@) $ 3018 - (@)(@@) ويحي بن محمد الزيات(@)(@@) كنية كل منهما أيضا أبو زكريا(@)(@@)(@@)(@@) $ 3019 - (@)(@@) أبو زكرة(@)(@@) يزيد بن محمد الأزدي كنيته أبو زكريا(@)(@@)(@@)(@@) $ 3020 - (@)(@@) أبو الزناد(@)(@@) عبد الله بن ذكوان كنيته أبو عبد الرحمن وكان يغضب من أبي الزناد ولكه اشتهر بها جدا(@)(@@)(@@)(@@) $ 3021 - (@)(@@) أبو زياد(@)PageV00P000(@)(@@) يوسف بن عبد الله الشاعر شيخ للوليد بن بكر الأندلسي كنيته أبو عبد الله(@)(@@)(@@)(@@) $ 3022 - (@)(@@) أبو زيدون(@)(@@) والد سعيد بن أبي زيدون القيرواني كنيته أبو زيد(@)(@@)(@@)(@@) $ 3023 - (@)(@@) أبو زينب(@)(@@) قال الشريف المرتضى في كتاب الغرر والدرر كان الحسن البصري في زمن بني أمية إذا حدث عن علي بن أبي طالب قال قال أبو زينب(@)(@@)(@@)(@@) || - السين(@)(@@)(@@)(@@) $ 3024 - (@)(@@) أبو ساسان(@)(@@) حضين بن المنذر الرقاشي كنيته أبو محمد(@)(@@)(@@)(@@) $ 3025 - (@)(@@) أبو السندي(@)(@@) سهيل بن ذكوان الواسطي أحد الضعفاء كنيته أبو عمرو(@)PageV00P000(@)(@@)(@@)(@@) $ 3026 - (@)(@@) أبو سمينة(@)(@@) محمد بن علي الصيرفي كنيته أبو بكر(@)(@@)(@@)(@@) || الشين(@)(@@)(@@)(@@) $ 3027 - (@)(@@) أبو شامة المقرىء المشهور كنيته أبو القاسم وهو عبد الرحمن بن إسماعيل مات سنة 665(@)(@@)(@@)(@@) $ 3028 - (@)(@@) أبو الشعثاء(@)(@@) علي بن الحسن الواسطي كنيته أبو الحسن(@)(@@)(@@)(@@) $ 3029 - (@)(@@) أبو شيخ البرجلاني محمد بن الحسين كنيته أبو عبد الله(@)(@@)(@@)(@@) $ 3030 - (@)(@@) أبو الشيخ ابن حيان(@)(@@) عبد الله بن محمد بن جعفر بن حيان الأصبهاني كنيته أبو محمد(@)PageV00P000(@)(@@)(@@)(@@) $ 3031 - (@)(@@) أبو الشيخ الأبهري(@)(@@) محمد بن الحسين بن إبراهيم كنيته أبو جعفر(@)(@@)(@@)(@@) $ 3032 - (@)(@@) أبو الشيخ الشاعر ذكره ابن منده وقال كنيته وبيض(@)(@@)(@@)(@@) $ 3033 - (@)(@@) أبو الشيخ النيسابوري(@)(@@) اسمه محمد بن أحمد بن إسحاق ذكره 
ms131	 ابن منده وقال كنيته وبيض أيضا(@)(@@)(@@)(@@) $ 3034 - (@)(@@) أبو الشيخ الأصبهاني شيخ أبي بكر الشامي اسمه عبد الله بن زياد كنيته أبو محمد(@)(@@)(@@)(@@) $ 3035 - (@)(@@) أبو الشيص الخزاعي الشاعر(@)(@@) محمد بن عبد الله بن رزين وقيل محمد بن رزين وقيل رزين بن سليمان كنيته أبو جعفر(@)(@@)(@@)(@@) $ 3036 - (@)(@@) أبو الشياطين(@)(@@) لقب رجل له ذكر في فتنة مرو في زمان أبي مسلم الخراساني(@)(@@)(@@)(@@) $ 3037 - (@)(@@) أبو الشمقمق الشاعر(@)(@@) مروان بن محمد كنيته أبو محمد(@)PageV00P000(@)(@@)(@@)(@@) $ 3038 - (@)(@@) وأبو الشمقمق آخر اسمه(@)(@@) أحمد بن الحسين بن عبد الملك من شيوخ الطبراني(@)(@@)(@@)(@@) || - الصاد(@)(@@)(@@)(@@) $ 3039 - (@)(@@) أبو صابر(@)(@@) محمد بن حمدان كنيته أبو حامد بن مروان(@)(@@)(@@)(@@) $ 3040 - (@)(@@) أبو صيرة الأشعث بن محمد الأطرابلسي كنيته أبو عبد الله(@)(@@)(@@)(@@) $ 3041 - (@)(@@) أبو صخرة(@)(@@) عبد الرحمن بن محمد كنيته أبو محمد(@)(@@)(@@)(@@) $ 3042 - (@)(@@) أبو صفوان(@)(@@) هو إسحاق بن إبراهيم الموصلي كنيته أبو محمد وكان المعتصم كناه أبا صفوان ذكره ياقوت(@)(@@)(@@)(@@) $ 3043 - (@)(@@) أبو صفية(@)(@@) لقب المغيرة بن عبد الله بن أبي عقيل الثقفي كان عامل الحجاج على الكوفة وكنيته أبو عبد الله ذكره الزبير في الموفقيات وقال كان يغضب من أبي صفية وذكر له في ذلك قصة(@)(@@)(@@)(@@) $ 3044 - (@)(@@) أبو الصمصامة الأزدي(@)(@@) هو حسام بن مصك أبو سهل ذكره ابن عدي(@)PageV00P000(@)(@@)(@@)(@@) $ 3045 - (@)(@@) أبو الصواعق(@)(@@) إبراهيم بن محمد بن الحسن بن المهلب كنيته أبو عبد الله(@)(@@)(@@)(@@) $ 3046 - (@)(@@) أبو صيرة(@)(@@) هو الأشعث ابن النعمان يكنى أبا الأشعث(@)(@@)(@@)(@@) || - الضاد(@)(@@)(@@)(@@) $ 3047 - (@)(@@) أبو الضباب(@)(@@) محمد بن عبد الرحمن بن عمر الطبراني كنيته أبو عبد الله(@)(@@)(@@)(@@) $ 3048 - (@)(@@) أبو الضيفين(@)(@@) عبد العزيز بن مروان بن الحكم كنيته أبو الأصبغ(@)(@@)(@@)(@@) || - الطاء(@)(@@)(@@)(@@) $ 3049 - (@)(@@) أبو الطنبوس(@)(@@) علي بن إبراهيم المروزي كنيته أبو الحسن(@)(@@)(@@)(@@) $ 3050 - (@)(@@) أبو الطواحن(@)(@@) محمد بن الطيار آخر من ثار في دولة بني عبد المؤمن بالمغرب بعد الستمائة(@)(@@) (@)(@@)(@@)(@@) || - العين(@)(@@) </span>(@)(@@)(@@)(@@) $ 3051 - (@)(@@) أبو العبرطز(@)(@@) أحمد بن محمد الهاشمي الماجن كنيته أبو العباس(@)(@@)(@@)(@@) $ 3052 - (@)(@@) أبو العتاهية(@)(@@) إسماعيل بن القاسم الشاعر كنيته أبو إسحاق وأبو ثابت(@)(@@)(@@)(@@) $ 3053 - (@)(@@) أبو عجينة(@)(@@) الحسن بن موسى الضرير كنيته أبو علي(@)(@@)(@@)(@@) $ 3054 - (@)(@@) أبو العساكر 
ms132	 أحد الفرسان في دولة المنصور أبي جعفر العباسي اسمه خالد بن حسان وكنيته أبو علي(@)(@@)(@@)(@@) $ 3055 - (@)(@@) أبو العسكر(@)(@@) محمد بن عيسى بن شاه الكوفي ثم البغدادي نزيل همذان صوفي كنيته أبو الفتح وقيل أبو أحمد(@)PageV00P000(@)(@@)(@@)(@@) $ 3056 - (@)(@@) أبو عصيدة النحوي أحمد بن عبيد كنيته أبو جعفر(@)(@@)(@@)(@@) $ 3057 - (@)(@@) أبو علوية(@)(@@) الحسن بن منصور من شيوخ البخاري كنيته أبو علي(@)(@@)(@@)(@@) $ 3058 - (@)(@@) أبو علال يأتي في أبو هلال وبالعين ذكره ابن منده(@)(@@)(@@)(@@) $ 3059 - (@)(@@) أبو العمرطة(@)(@@) عمير كان في عهد معاوية(@)(@@)(@@)(@@) $ 3060 - (@)(@@) أبو العميطر السفياني علي بن عبد الله بن خالد بن يزيد بن معاوية خرج في زمن المأمون قال ابن عساكر كنيته أبو الحسن(@)(@@)(@@)(@@) $ 3061 - (@)(@@) أبو عوف قيل هو لقب حميد بن عبد الرحمن الرواسي وكنيته أبو علي(@)(@@)(@@)(@@) $ 3062 - (@)(@@) أبو عويس(@)(@@) عيسى بن سالم الشاشي من شيوخ البغوي(@)(@@)(@@)(@@) $ 3063 - (@)(@@) أبو علالة المخزومي اسمه(@)(@@) الحسن وكنيته أبو علي ذكره المرزباني في معجم الشعراء(@)PageV00P000(@)(@@)(@@)(@@) $ 3064 - (@)(@@) أبو العيناء البصري صاحب النادر محمد بن القاسم بن خلاد كنيته أبو عبد الله ويقال أبو جعفر(@)(@@)(@@)(@@) || - القاف(@)(@@)(@@)(@@) $ 3065 - (@)(@@) أبو قترة بكسر القاف وسكون المثناة من ألقاب إبليس(@)(@@)(@@)(@@) $ 3066 - (@)(@@) أبو قربة(@)(@@) العباس بن علي بن أبي طالب كنيته أبو محمد(@)(@@)(@@)(@@) $ 3067 - (@)(@@) أبو قصة(@)(@@) عبد الرحمن بن عبد الله المغربي ثار بالمغرب بعد الستمائة(@)(@@)(@@)(@@) $ 3068 - (@)(@@) أبو قطيفة الشاعر(@)(@@) عمرو بن الوليد بن عقبة إبن أبي معيط الأموي كنيته أبو الوليد(@)(@@)(@@)(@@) $ 3069 - (@)(@@) أبو قلابة الرقاشي(@)(@@) عبد الملك بن محمد كنيته أبو محمد(@)PageV00P000(@)(@@)(@@)(@@) $ 3070 - (@)(@@) أبو قلابة الجرجاني(@)(@@) محمد بن الحسين كنيته أبو عبد الرحمن عن نوح بن حبيب(@)(@@)(@@)(@@) $ 3071 - (@)(@@) أبو القيدين هو الأصمعي لقب بذلك لعظم خصيتيه(@)(@@)(@@)(@@) || - الكاف(@)(@@)(@@)(@@) $ 3072 - (@)(@@) أبو الكروس(@)(@@) محمد بن عمرو بن تمام الكلبي الشامي كنيته أبو عبد الله(@)(@@)(@@)(@@) $ 3073 - (@)(@@) أبو كشوثا(@)(@@) حبيب بن أبي حبيب البصري تابعي كنيته أبو محمد ويقال أبو عميرة(@)(@@)(@@)(@@) $ 3074 - (@)(@@) أبو كلاب(@)(@@) حماد بن حماد بن الخوار أخو حميد التميمي الكوفي يكنى أبا أحمد(@)PageV00P000(@)(@@)(@@)(@@) || - اللام(@)(@@)(@@)(@@) $ 3075 - (@)(@@) أبو ليلى(@)(@@) معاوية بن يزيد بن معاوية بن أبي سفيان 
ms133	 كنيته أبو عبد الرحمن(@)(@@)(@@)(@@) || - الميم(@)(@@)(@@)(@@) $ 3076 - (@)(@@) أبو المدور(@)(@@) عبيد الله بن سليمان بن إبراهيم الأزدي المصري يكنى أبا القاسم(@)(@@)(@@)(@@) $ 3077 - (@)(@@) أبو مجرم(@)(@@) هو أبو مسلم الخراساني كناه المنصور(@)PageV00P000(@)(@@)(@@)(@@) $ 3078 - (@)(@@) أبو مرة(@)(@@) إبليس(@)(@@)(@@)(@@) $ 3079 - (@)(@@) أبو المساكين(@)(@@) جعفر بن أبي طالب كنيته أبو عبد الله(@)(@@)(@@)(@@) $ 3080 - (@)(@@) أبو مسحل(@)(@@) عبد الوهاب بن حريش النحوي المقرىء كنيته أبو محمد أخذ عن الكسائي(@)(@@)(@@)(@@) $$ 3081 - (@)(@@) أم المساكين(@)(@@) زينب بنت خزيمة إحدى أمهات المؤمنين(@)(@@)(@@)(@@) $ 3082 - (@)(@@) أبو مسعود(@)(@@) محمد بن سليمان بن الهادي بن المهدي العباسي كان مشهورا بافتعال النوادر وكنيته أبو عبد الله(@)(@@)(@@)(@@) $ 3083 - (@)(@@) أبو المليح الرقي(@)(@@) الحسن بن عمر كنيته أبو عبد الله(@)PageV00P000(@)(@@)(@@)(@@) $ 3084 - (@)(@@) أبو منين(@)(@@) يزيد بن كيسان كنيته أبو عبد الله(@)(@@)(@@)(@@) || - النون(@)(@@)(@@)(@@) $ 3085 - (@)(@@) أبو النباح(@)(@@) محمد بن صالح بن مهران الهاشمي مولاهم البصري عن أبي سلمة الأنصاري يكنى أبا عبد الله(@)(@@)(@@)(@@) $ 3086 - (@)(@@) أبو النجم(@)(@@) هلال بن محمد بن جعفر بن سعدان الحفار كنيته أبو الفتح(@)(@@)(@@)(@@) $ 3087 - (@)(@@) أبو نخيلة السعدي بخاء معجمة مصغر كنيته أبو الجنيد وقيل أبو العرماس وأبو نخيلة لقب وهو شاعر أدرك الدولتين ويقال اسمه كنيته وقيل بل اسمه يعمر(@)(@@)(@@)(@@) $ 3088 - (@)(@@) أبو نشيط اثنان(@)(@@) محمد بن هارون الغزي كنيته أبو علي(@)PageV00P000(@)(@@)(@@)(@@) $ 3089 - (@)(@@) ومحمد بن هارون بلخي نزيل بغداد كنيته أبو جعفر(@)(@@)(@@)(@@) $ 3090 - (@)(@@) أبو نواس اثنان(@)(@@) أحدهما الحسن بن هانىء الشاعر المشهور كنيته أبو علي(@)(@@)(@@)(@@) $ 3091 - (@)(@@) والثاني محمد بن عبد الله الأصبهاني كنيته أبو عبد الله روى عن أبي أسيد المدني(@)(@@)(@@)(@@) || - الواو(@)(@@)(@@)(@@) $ 3092 - (@)(@@) أبو والديه(@)(@@) عبد الله بن محمد بن سلام كنيته أبو محمد(@)(@@)(@@)(@@) || - الهاء(@)(@@)(@@)(@@) $ 3093 - (@)(@@) أبو هريسة(@)(@@) الحسن بن صبيح كنيته أبو علي(@)(@@)(@@)(@@) $ 3094 - (@)(@@