ms1141	 روى عنه عبد الله بن عمر وهو أخو أبي بكر بن نافع مات عمر بن نافع في ولاية أبي جعفر(@)(@@)(@@)(@@) $ 9512 - عمر بن أبان يروي عن عمرو بن عثمان بن عفان روى عنه ابنه إبراهيم بن عمر بن أبان من حديث أبي معشر البراء(@)(@@)(@@)(@@) $ 9513 - عمر بن جعثم اليحصبي من أهل حمص يروي عن خالد بن معدان وسليم بن عامر روى عنه بقية وأهل الشام(@)(@@)(@@)(@@) $ 9514 - عمر بن حسيل بن سعد بن حذيفة بن اليمان يروي عن الشعبي عداده في أهل الكوفة روى عنه عيسى بن يونس PageV07P171(@)(@@)(@@)(@@) $ 9515 - عمر بن عبد الله بن الأشج أخو بكير يروي عن سعيد بن المسيب روى عنه يزيد بن أبي حبيب والمصريون(@)(@@)(@@)(@@) $ 9516 - عمر بن بشير الهمداني من أهل الكوفة يروي عن الشعبي روى عنه وكيع وأبو نعيم(@)(@@)(@@)(@@) $ 9517 - عمر بن أيوب عداده في أهل الكوفة يروي عن الشعبي روى عنه الثوري ومسعر بن كدام(@)(@@)(@@)(@@) $ 9518 - عمر بن تيري الصنعاني يروي عن هانئ مولى عثمان روى عنه بن المبارك(@)(@@)(@@)(@@) $ 9519 - عمر بن حمزة الضبي من أهل البصرة يروي عن الحسن وعكرمة بن خالد وأبيه روى عنه زيد بن الحباب(@)(@@)(@@)(@@) $ 9520 - عمر بن حبيب القاضي من أهل مكة انتقل إلى اليمن وسكنها يروي عن عطاء وعمرو بن دينار روى عنه رباح بن زيد PageV07P172 وأهل اليمن وكان حافظا متقنا وليس هذا بعمر بن حبيب القاضي الذي كان على قضاء البصرة ذاك ضعيف(@)(@@)(@@)(@@) $ 9521 - عمر بن حفص النميري بصري يروي عن مالك بن دينار روى عنه يحيى بن حسان(@)(@@)(@@)(@@) $ 9522 - عمر بن سليمان بن عاصم بن عمر بن الخطاب يروي عن عبد الرحمن بن أبان عن أبيه عن زيد بن ثابت عن النبي صلى الله عليه وسلم قال نضر الله امرأ سمع منا حديثا فأداه كما سمعه عداده في أهل المدينة روى عنه شعبة بن الحجاج(@)(@@)(@@)(@@) $ 9523 - عمر بن العلاء بن حارثة الثقفي يروي عن أبيه عن أبي هريرة عن النبي صلى الله عليه وسلم المدينة ومكة 
ms1142	 محفوفتان بالملائكة وعلى كل نقب منهما ملك لا يدخلها الدجال ولا الطاعون روى عنه فليح بن سليمان PageV07P173(@)(@@)(@@)(@@) $ 9524 - عمر بن المطلب السهمي يروي عن سعيد بن ميناء عن أبي هريرة عن النبي صلى الله عليه وسلم دعوا عنكم المصلين روى عنه قزعة بن سويد(@)(@@)(@@)(@@) $ 9525 - عمر بن الحزور أبو بشر من أهل البصرة يروي عن الحسن روى عنه شباك بن عائذ الأزدي(@)(@@)(@@)(@@) $ 9526 - عمر بن زياد أبو حفص الهلالي يروي عن عبد الملك بن عمير روى عنه أبو نعيم(@)(@@)(@@)(@@) $ 9527 - عمر بن حفص أبو حفص المكي يروي عن سالم روى عنه هاشم بن القاسم(@)(@@)(@@)(@@) $ 9528 - عمر بن أبي إسماعيل واسم أبي إسماعيل راشد من أهل الكوفة يروي عن الشعبي وأبي الضحى روى عنه الثوري وإسماعيل بن زكريا وليس هذا بعمر بن راشد اليمامي ذاك واه ضعيف(@)(@@)(@@)(@@) $ 9529 - عمر بن أبي زائدة الهمداني واسم أبي زائدة خالد الهمداني يروي عن الشعبي وعون بن أبي جحيفة روى عنه محمد بن عرعرة PageV07P174 البرند حدثنا بكر بن أحمد الطاحي بالبصرة قال ثنا نصر بن علي قال ثنا أبي عن عمر بن أبي زائدة قال سمعت أبا إسحاق الهمداني قرأ لا يكادون يفقهون قولا(@)(@@)(@@)(@@) $ 9530 - عمر بن روبة الثعلبي من أهل الشام يروي عن عبد الواحد بن عبد الله النصرى عن واثلة بن الأسقع روى عنه أهل الشام(@)(@@)(@@)(@@) $ 9531 - عمر بن سعيد شيخ يروي المقاطيع روى عنه أبو إسحاق السبيعي(@)(@@)(@@)(@@) $ 9532 - عمر بن سعيد بن شريح من أهل المدينة يروي عن الزهري وعبد الرحمن بن حميد روى عنه عبد الرحمن بن إسحاق وفضيل بن سليمان يعتبر بحديثه من غير الضعفاء عنه(@)(@@)(@@)(@@) $ 9533 - عمر بن السائب يروى عن القاسم بن أبى القاسم والمدنيين روى عنه عمرو بن الحارث والليث بن سعد PageV07P175(@)(@@)(@@)(@@) $ 9534 - عمر بن سليم بن ثابت يروي عن أبي روح روى عنه موسى بن عقبة(@)(@@)(@@)(@@) $ 9535 - أبو عثمان الأنصاري اسمه عمر بن سالم أصله من المدينة انتقل إلى خراسان وكان على قضاء مرو يروي عن 
ms1143	 القاسم بن محمد روى عنه مهدي بن ميمون ومطرف بن طريف وليث بن أبي سليم وقد قيل اسمه عمرو بن سالم(@)(@@)(@@)(@@) $ 9536 - عمر بن يزيد بن أبي العريف الهمداني الكوفي يروي عن جماعة من التابعين روى عنه أهل الكوفة مات في ولاية أبي جعفر(@)(@@)(@@)(@@) $ 9537 - عمر بن سليم البصري يروي عن أبي غالب عن أبي أمامة روى عنه زيد بن الحباب(@)(@@)(@@)(@@) $ 9538 - عمر بن سيف عداده في أهل البصرة يروي عن المهلب بن أبي صفرة روى عنه قتادة(@)(@@)(@@)(@@) $ 9539 - عمر بن سلام يروي عن الشعبي وعبد الملك بن مروان PageV07P176 روى عنه معن بن عيسى(@)(@@)(@@)(@@) $ 9540 - عمر بن سويد الثقفي يروي عن عائشة بنت طلحة عداده في أهل الكوفة روى عنه بن المبارك(@)(@@)(@@)(@@) $ 9541 - عمر بن شيبة مولى معقل بن سنان يروي عن عون بن أبي جحيفة روى عنه حيوة بن شريح والمصريون(@)(@@)(@@)(@@) $ 9542 - عمر بن سيف الأسدي يروي عن الشعبي وابن سيرين روى عنه مروان بن معاوية(@)(@@)(@@)(@@) $ 9543 - عمر بن عبيدة بن سفيان الحضرمي من أهل المدينة يروي عن أبيه روى عنه الحجازيون(@)(@@)(@@)(@@) $ 9544 - عمر بن سويد العجلي يروي عن سلامة التيمي عداده في أهل الكوفة روى عنه أبو نعيم(@)(@@)(@@)(@@) $ 9545 - عمر بن عبيد الله بن معمر التيمي القرشي كنيته أبو حفص يروي عن العراقيين روى عنه عبد الله بن عون(@)(@@)(@@)(@@) $ 9546 - عمر بن عبد الرحمن أبو أمية الذماري من أهل اليمن يروى عن PageV07P177 عكرمة روى عنه عبد الملك بن عبد الرحمن الذماري(@)(@@)(@@)(@@) $ 9547 - عمر بن عبد الرحمن بن محيصن السهمي القرشي أبو حفص يروي عن صفية روى عنه بن عيينة وعبد الله بن المؤمل وكانت أمه تحت المطلب بن أبي وداعة السهمي(@)(@@)(@@)(@@) $ 9548 - عمر بن مسكين يروي عن نافع روى عنه المحاربي(@)(@@)(@@)(@@) $ 9549 - عمر بن عبد الرحمن مولى الأخنس بن شريق حليف لقريش عداده في أهل اليمن يروي عن وهب بن منبه روى عنه بن المبارك وعبد الرزاق PageV07P178(@)(@@)(@@)(@@) $ 9550 - عمر بن يزيد النصري من أهل الشام يروي عن الزهري 
ms1144	 روى عنه عمرو بن واقد في روايته أشياء وعمرو بن واقد لا شيء(@)(@@)(@@)(@@) $ 9551 - عمر بن عبد الرحمن المدني يروي عن أبي سلمة بن سفيان روى عنه الثوري(@)(@@)(@@)(@@) $ 9552 - عمر بن نعيم يروي عن أسامة بن سلمان عداده في أهل الشام روى عنه مكحول(@)(@@)(@@)(@@) $ 9553 - عمر بن عثمان بن الهدير القرشي المدني يروي عن عروة بن الزبير روى عنه عبد الحميد بن سليمان(@)(@@)(@@)(@@) $ 9554 - عمر بن عبد الملك العبدي يروي عن الحسن وابن سيرين روى عنه التبوذكي(@)(@@)(@@)(@@) $ 9555 - عمر بن عثمان بن عبد الرحمن بن سعيد بن يربوع الصرم المخزومي القرشي من أهل المدينة يروي عن جده عن أبيه وله صحبة روى عنه زيد بن الحباب وهو أخو محمد بن عثمان PageV07P179(@)(@@)(@@)(@@) $ 9556 - عمر بن كثير بن المطلب بن أبي وداعة السهمي القرشي أخو كثير بن كثير يروي عن المدنيين روى عنه عبيد الله بن عمر العمري(@)(@@)(@@)(@@) $ 9557 - عمر بن علي بن الحسين بن علي بن أبي طالب يروي عن أبيه روى عنه بن أخيه جعفر بن محمد بن علي يخطئ(@)(@@)(@@)(@@) $ 9558 - عمر بن عاصم بن عمر بن سعد القرظ المؤذن مولى بني مخزوم من أهل المدينة يروي عن جده وعمه روى عنه بن عجلان(@)(@@)(@@)(@@) $ 9559 - عمر بن عطاء بن وراد بن أبي الخوار يروي عن أبي سلمة بن عبد الرحمن روى عنه بن جريج(@)(@@)(@@)(@@) $ 9560 - عمر بن مغيث من أهل المدينة يروي عن أبي حسن مولى بني نوفل روى عنه يحيى بن أبي كثير(@)(@@)(@@)(@@) $ 9561 - عمر بن عامر السلمي من أهل البصرة كنيته أبو حفص PageV07P180 يروي عن قتادة روى عنه سالم بن نوح وزيد بن زريع مات سنة خمس وثلاثين ومائة(@)(@@)(@@)(@@) $ 9562 - عمر بن أبي فروة واسم أبي فروة مسلم بن سالم الجهني من أهل الكوفة كنيته أبو حفص يروي عن أبيه روى عنه أهل الكوفة(@)(@@)(@@)(@@) $ 9563 - عمر بن قيس الماصر من أهل الكوفة كنيته أبو الصباح مولى الأشعث بن قيس يروي عن شريح وزيد بن وهب ومجاهد روى عنه 
ms1145	 شعبة وابن عون وليس هو بعمر بن قيس سندل ذاك ضعيف(@)(@@)(@@)(@@) $ 9564 - عمر بن عمران السدوسي أبو حفص يروي عن أبي سعد البقال قال رأيت علي بن أبي أوفى ضربة فقال أصابتني يوم خيبر روى عنه المنذر بن الوليد الجارودي(@)(@@)(@@)(@@) $ 9565 - عمر بن مخراق يروي عن رجل عن عائشة روى عنه أسامة بن زيد PageV07P181(@)(@@)(@@)(@@) $ 9566 - عمر بن الحكم بن قيس أبو حفص يروي عن الحكم بن عتيبة روى عنه عمرو بن صالح(@)(@@)(@@)(@@) $ 9567 - عمر بن مضرس بن عثمان الجهني أبو عثمان من أهل مضر يروي عن أبيه روى عنه حرملة بن عبد العزيز(@)(@@)(@@)(@@) $ 9568 - عمر بن عطية يروي عن أبي جعفر محمد بن علي عداده في أهل الكوفة روى عنه الثوري(@)(@@)(@@)(@@) $ 9569 - عمر بن أبي مسلم من أهل المدينة يروي عن عروة بن الزبير روى عنه عبد الرحمن بن أبي الموالي(@)(@@)(@@)(@@) $ 9570 - عمر بن كيسان يروي عن وهب بن أبي مغيث عداده في أهل اليمن روى عنه ابنه إبراهيم بن عمر بن كيسان وقد قيل وهب بن أبي معتب PageV07P182(@)(@@)(@@)(@@) $ 9571 - عمر بن الفضل الحرشي يروي عن أبي العلاء بن الشخير روى عنه حرمي بن عمارة وأبو نعيم(@)(@@)(@@)(@@) $ 9572 - عمر بن كثير الثقفي يروي عن الشعبي عداده في أهل الكوفة روى عنه مسعر بن كدام(@)(@@)(@@)(@@) $ 9573 - عمر بن أبي كبشة يروي عن مورق العجلي روى عنه سلام بن أبي مطيع(@)(@@)(@@)(@@) $ 9574 - عمر بن صالح بن أبي الزاهرية الأزدي من أهل البصرة يروي عن أبي جمرة الضبعي روى عنه هشام بن عمار وداود بن رشيد(@)(@@)(@@)(@@) $ 9575 - عمر بن سعيد يروي عن الزهري روى عنه الفضيل بن سليمان النميري(@)(@@)(@@)(@@) $ 9576 - عمر بن كعب يروي عن أم طلحة عن عائشة روى عنه بكير بن عبد الله بن الأشج(@)(@@)(@@)(@@) $ 9577 - عمر بن عمرو يروي عن أبي عون الأنصاري عداده في أهل PageV07P183 الشام روى عنه معاوية بن صالح(@)(@@)(@@)(@@) $ 9578 - عمر بن أبى ليلى المكي يروي عن محمد بن كعب روى عنه أهل الحجاز(@)(@@)(@@)(@@) $ 9579 - عمر بن 
ms1146	 سعيد المدلجي حمصي يروي عن عمران بن سليم عن أبي هريرة روى عنه إسماعيل بن عياش(@)(@@)(@@)(@@) $ 9580 - عمر بن محمد بن جبير بن مطعم بن عدى القرشي أخو جبير وسعيد ابني محمد بن جبير يروي عن أبيه روى عنه الزهري(@)(@@)(@@)(@@) $ 9581 - عمر بن محمد بن يحيى بن سعيد بن العاص الأموي القرشي يروي عن قيس بن محمد بن الأشعث روى عنه حماد بن سلمة(@)(@@)(@@)(@@) $ 9582 - عمر بن عبد الواحد شيخ يروي عن مجاهد روى عنه عبد الله بن كيسان من حديث الغنجار(@)(@@)(@@)(@@) $ 9583 - عمر بن معن يروي عن يوسف بن ماهك روى عنه بن المبارك(@)(@@)(@@)(@@) $ 9584 - عمر بن مجاشع المدائني يروي عن عبد العزيز بن صهيب روى عنه الخضر بن محمد الحراني PageV07P184(@)(@@)(@@)(@@) $ 9585 - عمر بن نبيه الخزاعي من أهل المدينة يروي عن أبي عبد الله القراظ روى عنه شريك بن أبي نمر وحاتم بن إسماعيل(@)(@@)(@@)(@@) $ 9586 - عمر بن محمد بن المنكدر التيمي القرشي من أهل المدينة يروي عن أبيه وسمى روى عنه هشام بن حسان ووهيب بن الورد وكان من العباد مات في قراءة قرآن قرئ عليه(@)(@@)(@@)(@@) $ 9587 - عمر بن هلال الباهلي يروي عن أبي غالب عن أبي أمامة روى عنه العلاء بن عمر(@)(@@)(@@)(@@) $ 9588 - عمر بن رديح شيخ يروي عن عطاء بن أبي ميمونة روى عنه محمد بن أبي بكر المقدمي مستقيم الحديث(@)(@@)(@@)(@@) $ 9589 - عمر بن عبيد بياع الخمر من أهل البصرة يروي عن هشام بن PageV07P185 عروة ولم أر في القلب من حديثه إلا ما حدثنا أبو يعلى بالموصل ثنا حفص بن عبد الله بن عمر الحلواني قال ثنا عمر بن عبيد البصري بياع الخمر قال ثنا هشام بن عروة عن أبيه عن عائشة قالت قال رسول الله صلى الله عليه وسلم إن الله يحب أن تؤتى رخصه كما يحب أن تؤتى غرائمه(@)(@@)(@@)(@@) $ 9590 - عمر بن موسى بن عبد الله بن يزيد الخطمي الأنصاري من أهل الكوفة يروي عن أبيه روى عنه أبو نعيم(@)(@@)(@@)(@@) $ 9591 - عمر بن فروخ القتاب 
ms1147	 يروي عن حبيب بن الزبير روى عنه يعقوب بن إسحاق الحضرمي(@)(@@)(@@)(@@) $ 9592 - عمر بن معروف يروي عن عكرمة روى عنه جرير بن عبد الحميد(@)(@@)(@@)(@@) $ 9593 - عمر بن يزيد خال أبي معاوية الضرير يروي عن طاوس روى عنه أبو معاوية الضرير PageV07P186(@)(@@)(@@)(@@) $ 9594 - عمر بن أبي مالك يروي عن الزهري روى عنه سعيد بن أبي أيوب(@)(@@)(@@)(@@) $ 9595 - عمر بن عبد الله بن عبد الرحمن الرومي من أهل البصرة يروي عن الحسن وقتادة روى عنه التبوذكي وقتيبة بن سعيد(@)(@@)(@@)(@@) $ 9596 - عمر بن نصر المحاربي من أهل الكوفة يروي عن الكوفيين روى عنه مسعر بن كدام(@)(@@)(@@)(@@) $ 9597 - عمر بن أبي وهب الخزاعي واسم أبي وهب ثروان وهو الذي أعتق سلام بن أبي مطيع يروي عن البصريين روى عنه بن المبارك وعبد الصمد بن عبد الوارث(@)(@@)(@@)(@@) $ 9598 - عمر بن يزيد العبدي يروي عن الحسن روى عنه حماد بن زيد(@)(@@)(@@)(@@) $ 9599 - عمر بن سعيد بن مسروق الثوري من أهل الكوفة أخو سفيان والمبارك ابني سعيد بن مسروق يروي عن الأعمش وابن أبي خالد روى عنه بن عيينة PageV07P187(@)(@@)(@@)(@@) $ 9600 - عمر بن حفص بن بيهس البيهسي كوفي يروي عن حماد بن أبي سليمان روى عنه محمد بن يعلى الكوفي(@)(@@)(@@)(@@) $ 9601 - عمر بن مصعب أخو خارجة بن مصعب يروي عن أبيه روى عنه يحيى بن يحيى حدثني محمد بن عبد الرحمن الدغولي قال ثنا خارجة بن مصعب السرخسي قال حدثنا يحيى بن يحيى عن عمر بن مصعب عن أبيه أن رايات علي كانت سوداء وعمر بن مصعب هو أول مولود ولد بسرخس في الإسلام(@)(@@)(@@)(@@) $ 9602 - عمر بن علي بن عطاء بن مقدم المقدمي أبو حفص من أهل البصرة يروي عن إسماعيل بن أبي خالد روى عنه بن أخيه محمد بن أبي بكر المقدمي وأهل العراق مات سنة تسعين ومائة وقد قيل سنة ثنتين وتسعين ومائة(@)(@@)(@@)(@@) $ 9603 - عمر الدمشقي شيخ يروي عن أم الدرداء الصغرى روى عنه سعيد بن أبي هلال لا أدري من هو ولا بن من هو PageV07P188(@)(@@)(@@)(@@) $ 9604 
ms1148	 - عمر بن عبد الرحمن أبو حفص الأبار القرشي من أهل الكوفة يروي عن الأعمش وابن أبي خالد وحميد الطويل روى عنه يحيى بن معين وأهل العراق مات في ولاية هارون(@)(@@)(@@)(@@) $ 9605 - عمر بن عبيد الطنافسي الحنفي من أهل الكوفة كنيته أبو حفص يروي عن أبي إسحاق السبيعي وسماك بن حرب روى عنه إسحاق بن إبراهيم الحنظلي وأهل العراق مات سنة سبع وثمانين ومائة(@)(@@)(@@)(@@) $ 9606 - أبو داود الحفري اسمه عمر بن سعد يروي عن الأعمش مات في جمادى الآخرة سنة ثلاث ومائتين روى عنه أحمد ويحيى والناس(@)(@@)(@@)(@@) $ 9607 - عثمان بن الأسود بن موسى بن باذان مولى بني جمح من أهل مكة يروي عن مجاهد روى عنه الثوري وعبيد الله بن موسى مات PageV07P189 بمكة سنة سبع وأربعين ومائة وقد قيل سنة خمسين ومائة(@)(@@)(@@)(@@) $ 9608 - عثمان بن إسحاق بن خرشة من أهل المدينة يروي عن قبيصة روى عنه الزهري(@)(@@)(@@)(@@) $ 9609 - عثمان بن حكيم بن عباد بن حنيف الأنصاري أخو حكيم بن حكيم كنيته أبو سهل يروي عن عكرمة وزياد بن علاقة وعبد الرحمن بن أبي عمرة روى عنه الثوري وأهل الكوفة(@)(@@)(@@)(@@) $ 9610 - عثمان بن عبيد الله بن أبي رافع مولى سعيد بن العاص من أهل المدينة يروي عن محرز بن أبي هريرة روى عنه محمد بن جعفر بن أبي كثير(@)(@@)(@@)(@@) $ 9611 - عثمان بن النعمان بن عجلان الزرقي الأنصاري من أهل المدينة يروي عن أبان بن عثمان روى عنه بن إسحاق PageV07P190(@)(@@)(@@)(@@) $ 9612 - عثمان بن عبيد الله بن رافع مولى النبي صلى الله عليه وسلم يروي عن أبيه روى عنه عبد العزيز بن محمد الدراوردي(@)(@@)(@@)(@@) $ 9613 - عثمان بن عروة بن الزبير بن العوام يروي عن أبيه روى عنه أهل المدينة مات في ولاية أبي جعفر أمه فاختة بنت أبي الأسود بن أبي البخترى(@)(@@)(@@)(@@) $ 9614 - عثمان بن وثاب المدني يروي عن سعيد بن المسيب روى عنه بن أبي ذئب(@)(@@)(@@)(@@) $ 9615 - عثمان بن الجراد يروى عن رجل عن بن مسعود روى عنه سعيد بن أبى هلال PageV07P191(@)(@@)(@@)(@@) $ 9616 
ms1149	 - عثمان بن الضحاك يروي عن محمد بن يوسف بن عبد الله بن سلام وأبي حازم روى عنه أبو مودود المدني وزياد بن يونس(@)(@@)(@@)(@@) $ 9617 - عثمان بن أبي سليمان بن جبير بن مطعم القرشي يروى عن بن أبي مليكة وعامر بن عبد الله بن الزبير روى عنه بن جريج وابن عيينة وكان قاضيا على مكة(@)(@@)(@@)(@@) $ 9618 - عثمان بن أبي حازم البجلي يروي عن صخر بن العيلة روى عنه أبان بن عبد الله بن أبي حازم(@)(@@)(@@)(@@) $ 9619 - عثمان بن يسار يروي عن طاوس روى بن المبارك عن عبيد الله بن عبد الرحمن عنه وهذا هو الأشجعي(@)(@@)(@@)(@@) $ 9620 - عثمان بن حيان الدمشقي مولى أبي الدرداء يروي عن أم الدرداء روى عنه هشام بن سعد PageV07P192(@)(@@)(@@)(@@) $ 9621 - عثمان بن أبي الوليد يروي عن عروة بن الزبير روى عنه هشام بن عروة ومحمد بن عمرو(@)(@@)(@@)(@@) $ 9622 - عثمان بن الحارث الهمداني يروي عن السدى روى عنه وكيع بن الجراح(@)(@@)(@@)(@@) $ 9623 - عثمان بن حسان العامري يروي عن فلفلة الجعفي عن بن مسعود روى عنه الوليد بن قيس السكوني(@)(@@)(@@)(@@) $ 9624 - عثمان بن عمار يروي عن سعيد بن المسيب روى عنه بن جريج(@)(@@)(@@)(@@) $ 9625 - عثمان بن المغيرة الثقفي من أهل الكوفة يروي عن علي بن ربيعة روى عنه الثوري وأبو عوانة(@)(@@)(@@)(@@) $ 9626 - عثمان بن خالد الشامي يروي عن أبي الأشعث الصنعاني روى عنه ثور بن يزيد PageV07P193(@)(@@)(@@)(@@) $ 9627 - عثمان بن جبير مولى أبي أيوب يروي عن أبيه روى عنه عثمان بن خثيم(@)(@@)(@@)(@@) $ 9628 - عثمان بن عبد الرحمن بن عبد الله بن موهب مولى لآل الحكم بن أبي العاص كنيته أبو عبد الله يروي عن جماعة من التابعين روى عنه أهل المدينة مات سنة ستين ومائة(@)(@@)(@@)(@@) $ 9629 - عثمان بن رشيد الثقفي يروي عن أنس بن سيرين روى عنه عبد الصمد بن عبد الوارث(@)(@@)(@@)(@@) $ 9630 - عثمان بن دينار أخو مالك بن دينار يروي عن مالك بن دينار روت عنه ابنته حكامة بنت عثمان بن دينار وحكامة لا شيء(@)(@@)(@@)(@@) $ 9631 - عثمان بن خالد القرشي 
ms1150	 يروي عن الحسن ونافع روى عنه قتيبة بن سعيد PageV07P194(@)(@@)(@@)(@@) $ 9632 - عثمان بن فرقد العطار يروي عن هشام بن عروة مستقيم الحديث روى عنه علي بن المديني(@)(@@)(@@)(@@) $ 9633 - عثمان بن زائدة الرازي أصله من الكوفة انتقل إلى الري وكان من العباد المتقشفة وأهل الورع الدقيق والجهد الشديد يروي عن الزبير بن عدى عن أنس روى عنه حكام بن سلم الرازي وأبو الوليد الطيالسي(@)(@@)(@@)(@@) $ 9634 - عثمان بن زائدة شيخ يروي عن عكرمة بن عمار قال سمعت الهرماس بن زياد يقول سمعت رسول الله صلى الله عليه وسلم يقول للضيف حق وإن جاء على فرس حدثنا محمد بن خالد البردعي بمكة من كتابه قال ثنا عبد العظيم بن إبراهيم السالمي قال ثنا سليمان بن عبد الرحمن قال ثنا عثمان بن زائدة قال ثنا عكرمة بن عمار قال سمعت الهرماس بن زياد أخاف أن يكون هذا PageV07P195 عثمان بن فائد(@)(@@)(@@)(@@) $ 9635 - عثمان بن سليمان الحارثي يروي عن يزيد بن المهلب روى عنه البصريون(@)(@@)(@@)(@@) $ 9636 - عثمان بن أبي دهرش يروي عن آل الحكم بن أبي العاص روى عنه سفيان بن عيينة ويحيى بن سليم(@)(@@)(@@)(@@) $ 9637 - عثمان بن راشد السلمي من أهل الكوفة يروي عن عائشة بنت عجرد روى عنه سفيان بن سعيد الثوري(@)(@@)(@@)(@@) $ 9638 - عثمان بن النجاشي يروي عن سعيد بن المسيب روى عنه الزهري(@)(@@)(@@)(@@) $ 9639 - عثمان بن نجيح يروي عن الحجازيين روى عنه بن أبي ذئب(@)(@@)(@@)(@@) $ 9640 - عثمان بن السائب يروي عن أبيه روى عنه بن جريج(@)(@@)(@@)(@@) $ 9641 - عثمان بن حصين بن عبيدة بن علاق الدمشقي يروي عن PageV07P196 الشاميين روى عنه أهل بلده(@)(@@)(@@)(@@) $ 9642 - عثمان بن أبي سلمة يروي المقاطيع روى عنه حجاج بن أبي عثمان(@)(@@)(@@)(@@) $ 9643 - عثمان بن ربيعة بن أبي عبد الرحمن التيمي من أهل المدينة يروي عن أبيه روى عنه الدراوردي(@)(@@)(@@)(@@) $ 9644 - عثمان بن واقد العمري من أهل المدينة يروي عن نافع وأهل المدينة روى عنه زيد بن الحباب والعراقيون(@)(@@)(@@)(@@) $ 9645 - عثمان بن عبد الله بن الأسود يروي عن عبد الله بن 
ms1151	 أبي هلال روى عنه إبراهيم بن ميسرة(@)(@@)(@@)(@@) $ 9646 - عثمان بن عبيد الله أبو المنازل بن أخي شريح كان على قضاء خراسان يروي عن شريح روى عنه الشيباني والحجاج بن أرطأة(@)(@@)(@@)(@@) $ 9647 - عثمان الشحام العدوى من أهل البصرة كنيته أبو سلمة يروي عن عكرمة ومسلم بن أبي بكرة روى عنه حماد بن سلمة ووكيع بن الجراح PageV07P197(@)(@@)(@@)(@@) $ 9648 - عثمان بن صهيب يروي عن أبيه عداده في أهل المدينة روى عنه يزيد بن الهاد(@)(@@)(@@)(@@) $ 9649 - عثمان بن صفوان المكي يروي المراسيل روى عنه بن جريج(@)(@@)(@@)(@@) $ 9650 - عثمان بن مسلم بن هرمز يروي عن نافع بن جبير بن مطعم روى عنه المسعودي(@)(@@)(@@)(@@) $ 9651 - عثمان بن محمد بن عبيد الله بن عبد الله بن عمر بن الخطاب من أهل المدينة كنيته أبو قدامة يروي عن عائشة بنت سعد بن أبي وقاص روى عنه خالد بن مخلد القطواني(@)(@@)(@@)(@@) $ 9652 - عثمان بن عبد الله بن أوس بن حذيفة الثقفي يروي عن عمه عمرو بن أوس روى عنه عبد الله بن عبد الرحمن الطائفي(@)(@@)(@@)(@@) $ 9653 - عثمان بن عبد الله بن الأرقم القرشي يروي عن جده روى عنه العطاف بن خالد(@)(@@)(@@)(@@) $ 9654 - عثمان بن شبرمة كوفي يروي عن عاصم عن زر عن عبد الله لو لم يبق من الدنيا إلا يوم روى عنه محمد بن فضيل بن غزوان(@)(@@)(@@)(@@) $ 9655 - عثمان بن عبد الله بن أبي عتيق يروي عن سعيد بن عمرو بن جعدة روى عنه سليمان بن بلال PageV07P198(@)(@@)(@@)(@@) $ 9656 - عثمان بن غياث الراسبي من أهل البصرة يروي عن أبي عثمان النهدي وعكرمة روى عنه يحيى بن سعيد القطان والنضر بن شميل(@)(@@)(@@)(@@) $ 9657 - عثمان بن عبد الله بن علاثة العقيلي من أهل الشام يروي عن طارق بن أحمر روى عنه أخوه محمد بن عبد الله بن علاثة يعتبر حديثه من غير رواية أخيه عنه لان أخاه لا شيء(@)(@@)(@@)(@@) $ 9658 - عثمان بن عبد الرحمن بن عبيد الله التيمي القرشي أخو معاذ بن عبد الرحمن من أهل المدينة يروي عن ربيعة بن 
ms1152	 عبد الله بن الهدير روى عنه عبد المجيد بن سهيل بن عبد الرحمن بن عوف(@)(@@)(@@)(@@) $ 9659 - عثمان بن قيس يروي عن رجل عن بن عباس روى عنه الحجاج بن حسان(@)(@@)(@@)(@@) $ 9660 - عثمان بن عبد الرحمن بن أبان بن عثمان القرشي الأموي يروى عن PageV07P199 أبان بن عثمان روى عنه بن أبي الزناد(@)(@@)(@@)(@@) $ 9661 - عثمان بن عبد الرحمن بن سعيد بن يربوع المخزومي القرشي يروي عن عروة بن الزبير روى عنه أبو بكر بن عثمان ابنه(@)(@@)(@@)(@@) $ 9662 - عثمان بن القاسم الباهلي من أهل البصرة يروي عن عكرمة روى عنه عبد الصمد بن عبد الوارث(@)(@@)(@@)(@@) $ 9663 - عثمان بن عبد الرحمن يروي عن سعيد بن جبير روى عنه بن جريج(@)(@@)(@@)(@@) $ 9664 - عثمان بن عمر الجمحي يروي عن سالم بن عبد الله وخارجة بن زيد روى عنه عبد العزيز بن محمد الدراوردي(@)(@@)(@@)(@@) $ 9665 - عثمان بن عمر بن موسى التيمي القاضي من أهل المدينة يروي عن الزهري وأبي الغيث وعامر بن سعد روى عنه عبد الواحد بن زياد والدراوردي وابنه عمر بن عثمان(@)(@@)(@@)(@@) $ 9666 - أبو حصين اسمه عثمان بن عاصم بن حصين الأسدي من أهل الكوفة يروي عن سعيد بن جبير والشعبي وشريح روى عنه الثوري وشعبة وابن عيينة مات سنة ثمان وعشرين ومائة وقيل سنة سبع PageV07P200 وعشرين ومائة(@)(@@)(@@)(@@) $ 9667 - عثمان بن كعب القرظي من أهل المدينة يروي عن محمد بن كعب روى عنه يزيد بن عبد الله بن الهاد(@)(@@)(@@)(@@) $ 9668 - عثمان بن عبيد أبو دوس اليحصبي من أهل الشام يروي عن شريح بن عبيد روى عنه أبو المغيرة وأهل الشام(@)(@@)(@@)(@@) $ 9669 - عثمان بن علي بن كثير بن شهاب يروي عن سعيد بن عمرو بن سعيد بن أبي هريرة روى عنه إسماعيل بن أبي خالد(@)(@@)(@@)(@@) $ 9670 - عثمان بن عبد الملك الذي يقال له مستقيم كان يؤذن في المسجد الحرام يروي عن بن المسيب وعطاء وسالم روى عنه محمد بن ربيعة(@)(@@)(@@)(@@) $ 9671 - عثمان بن مسلم الدمشقي يروي عن مكحول روى عنه سعيد بن أبي أيوب(@)(@@)(@@)(@@) $ 9672 - عثمان 
ms1153	 بن أبي الكنات يروي عن أبي مليكة روى عنه يسرة بن صفوان اللخمي PageV07P201(@)(@@)(@@)(@@) $ 9673 - عثمان بن عمارة يروي عن سعيد بن المسيب روى عنه بن جريج(@)(@@)(@@)(@@) $ 9674 - عثمان بن جهم الهجري يروي عن زر بن حبيش روى عنه وكيع بن محرز الناجي(@)(@@)(@@)(@@) $ 9675 - عثمان بن أبي العاتكة القاص من أهل الشام كنيته أبو حفص يروي عن سليمان بن حبيب المحاربي روى عنه محمد بن شعيب بن شابور وأهل الشام مات سنة ثنتين وخمسين ومائة(@)(@@)(@@)(@@) $ 9676 - عثمان بن مورع أبو شيبة يروي عن الشعبي روى عنه عمرو بن محمد العنقزي(@)(@@)(@@)(@@) $ 9677 - عثمان بن أبي عثمان يروي عن القاسم بن محمد روى عنه بن أبي ذئب(@)(@@)(@@)(@@) $ 9678 - عثمان بن موسى بن بقطر من أهل البصرة كنيته أبو الخطاب يروي عن الحسن وعطاء روى عنه بن مهدى والبصريون PageV07P202(@)(@@)(@@)(@@) $ 9679 - عثمان بن عثمان الغطفاني أبو عمرو القرشي من أهل البصرة يروي عن علي بن زيد بن جدعان روى عنه أحمد بن حنبل وأهل العراق كان ممن يخطىء(@)(@@)(@@)(@@) $ 9680 - عثمان بن معاوية القرشي يروي عن الحسن روى عنه موسى بن إسماعيل(@)(@@)(@@)(@@) $ 9681 - عثمان بن أبي زرعة مولى أبي عقيل الثقفي من أهل الكوفة كنيته أبو المغيرة واسم أبي زرعة المغيرة يروي عن سعيد بن جبير وسالم بن أبي الجعد روى عنه الثوري وشعبة ومسعر(@)(@@)(@@)(@@) $ 9682 - عثمان بن سليمان الليثي أبو عمرو من أهل البصرة يروي عن الحسن روى عنه الثوري وأشعث(@)(@@)(@@)(@@) $ 9683 - عثمان بن محمد بن المغيرة بن الأخنس بن شريق الثقفي الأخنسى يروى عن سعيد المقبري والزهري روى عنه محمد بن عمرو بن علقمة وعبد الله بن جعفر المخرمي يعتبر حديثه من غير رواية المخرمي عنه لأن المخرمي ليس بشيء في الحديث حدثنا البغوي ببغداد قال ثنا عبد الله بن عمر الخطابي قال ثنا الدراوردي عن عبد الله بن PageV07P203 سعيد بن أبي هند عن عثمان بن محمد الأخنسي عن سعيد المقبري عن أبي هريرة أن رسول الله صلى الله عليه وسلم قال من استعمل 
ms1154	 على القضاء فقد ذبح بغير سكين(@)(@@)(@@)(@@) $ 9684 - عثمان بن العلاء يروي عن سلمة بن وردان روى عنه محمد بن معن(@)(@@)(@@)(@@) $ 9685 - عثمان بن مرة من أهل البصرة يروي عن القاسم بن محمد روى عنه النضر بن شميل وأبو عاصم(@)(@@)(@@)(@@) $ 9686 - عثمان بن مضرس بن عثمان الجهني أخو عمر بن مضرس يروي عن أبيه روى عنه حرملة بن عبد العزيز(@)(@@)(@@)(@@) $ 9687 - عثمان بن مرجعة أبو مرجعة الهنائي من أهل البصرة يروي عن عكرمة ومالك بن دينار روى عنه أهل البصرة(@)(@@)(@@)(@@) $ 9688 - عثمان بن جبلة بن أبي رواد يروي عن أهل المدينة روى عنه ابنه عبد العزيز بن عثمان بن جبلة من أهل مرو والد خلف بن عبد العزيز وكان عثمان بن جبلة مع أبي تميلة بالكوفة في طلب PageV07P204 الحديث فهاج به غم وكرب فوضع رأسه في حجر أبي تميلة فمات فدفن بالكوفة(@)(@@)(@@)(@@) $ 9689 - علي بن محمد بن علي بن أبي طالب الهاشمي يروي عن أبيه محمد بن الحنفية روى عنه ابنه حسن بن علي بن محمد(@)(@@)(@@)(@@) $ 9690 - علي بن الحسن بن حسن بن علي بن أبي طالب الهاشمي يروي عن أهل المدينة روى عنه عبد الرحمن بن أبي الموالي(@)(@@)(@@)(@@) $ 9691 - علي بن يحيى بن خلاد بن رافع الأنصاري الزرقي من أهل المدينة يروي عن أبيه عن عمه رفاعة بن رافع روى عنه بن عجلان وابنه يحيى بن علي بن يحيى مات سنة تسع وعشرين ومائة(@)(@@)(@@)(@@) $ 9692 - علي بن عبد الله بن رفاعة القرظي من أهل المدينة يروي عن الربيع بن معبد روى عنه يحيى بن سعيد الأنصاري(@)(@@)(@@)(@@) $ 9693 - علي بن الحكم البناني من أهل البصرة كنيته أبو الحكم يروى PageV07P205 عن عطاء ونافع وأبي نضرة روى عنه معمر وأهل البصرة مات سنة ثلاثين أو إحدى وثلاثين ومائة بالبصرة(@)(@@)(@@)(@@) $ 9694 - على الجعفي من أهل الكوفة والد الحسين بن علي الجعفي يروي عن سويد بن غفلة روى الحسين بن علي عن أخيه الوليد الجعفي عن أبيه(@)(@@)(@@)(@@) $ 9695 - علي بن عبد الملك بن عمير يروي 
ms1155	 عن أبيه قال قال أكثم بن صيفى الوحشة في ذهاب الأعمام روى عنه عمر بن علي المقدمي(@)(@@)(@@)(@@) $ 9696 - علي بن يزيد بن أبي حكيمة يروي عن إياس بن سلمة روى عنه الحميدي(@)(@@)(@@)(@@) $ 9697 - على البناني يروي عن أبي نضرة قال كانوا إذا قعدوا يتذاكرون الفقه يأمرون رجلا فيقرأ عليهم سورة روى عنه شعبة بن الحجاج(@)(@@)(@@)(@@) $ 9698 - علي بن مسلم بن خباب مولى بني ليث أخو محمد بن مسلم بن خباب كنيته أبو الحسن يروي عن سعيد المقبري روى عنه العراقيون PageV07P206(@)(@@)(@@)(@@) $ 9699 - علي بن نفيل جد أبي جعفر النفيلي كنيته أبو محمد يروي عن سعيد بن المسيب روى عنه النضر بن عربي والثوري(@)(@@)(@@)(@@) $ 9700 - علي بن ثابت بن عمر بن أخطب الأنصاري البصري أخو عروة بن ثابت ومحمد بن ثابت يروي عن نافع روى عنه سعيد بن أبي عروبة وعمران القطان مات سنة خمس وعشرين ومائة(@)(@@)(@@)(@@) $ 9701 - علي بن الأرقط يروي عن عطاء وميمون بن مهران روى عنه الحجاج بن الحجاج الأسلمي(@)(@@)(@@)(@@) $ 9702 - علي بن خالد الدؤلي يروي عن النصر بن سفيان الدؤلي عن أبي هريرة روى عنه بكير بن عبد الله بن الأشج(@)(@@)(@@)(@@) $ 9703 - علي بن جعدة يروي عن جعدة عن علي روى عنه مسعر بن كدام(@)(@@)(@@)(@@) $ 9704 - علي بن بذيمة الجزري مولى جابر بن سمرة السوائي يروى PageV07P207 عن سعيد بن جبير وعكرمة روى عنه الثوري وشريك مات سنة ثلاث وثلاثين ومائة وقد قيل سنة ست وثلاثين ومائة(@)(@@)(@@)(@@) $ 9705 - علي بن ميسر يروي عن عبيد بن عمير روى عنه محمد بن الفضيل بن غزوان(@)(@@)(@@)(@@) $ 9706 - علي بن بلال يروي المراسيل والمقاطيع روى عنه أبو بشر جعفر بن أبي وحشية(@)(@@)(@@)(@@) $ 9707 - علي بن حنظلة الشيباني من أهل الكوفة يروي عن أبيه روى عنه جبلة بن سحيم(@)(@@)(@@)(@@) $ 9708 - علي بن حوشب السلمي من أهل الشام يروي عن مكحول روى عنه الوليد بن مسلم(@)(@@)(@@)(@@) $ 9709 - علي بن صالح بن حي الهمداني من أهل الكوفة أخو الحسن بن صالح كنيته أبو محمد يروي عن 
ms1156	 أبي إسحاق السبيعي والكوفيين PageV07P208 كان مولد على والحسن أخيه سنة مائة لأنهما كانا توأمين وكان سفيان الثوري أسن منهما بخمس سنين روى عنهما أهل العراق وإسماعيل بن عمرو البجلي مات علي بن صالح سنة إحدى وخمسين ومائة وقيل سنة أربع وخمسين ومائة(@)(@@)(@@)(@@) $ 9710 - علي بن حصين بن مالك بن الخشخاش العنبري كان يذهب مذهب الشراة يروي عن جابر بن زيد روى عنه البصريون(@)(@@)(@@)(@@) $ 9711 - علي بن أبي حميد الجندي من أهل اليمن يروي عن طاوس روى عنه بن جريج(@)(@@)(@@)(@@) $ 9712 - علي بن ربيعة البجلي من أهل الكوفة يروي عن أسماء بن الحكم الفزاري وأهل العراق روى عنه العلاء بن صالح وعثمان بن المغيرة الثقفي(@)(@@)(@@)(@@) $ 9713 - علي بن صالح المكي يروي عن بن خثيم روى عنه المعتمر PageV07P209 بن سليمان يغرب(@)(@@)(@@)(@@) $ 9714 - علي بن زرارة يروي عن سعيد بن جبير عداده في أهل الكوفة روى عنه موسى الصغير(@)(@@)(@@)(@@) $ 9715 - علي بن طلق يروي عن عبد الله بن محيريز روى عنه حرملة بن عمران(@)(@@)(@@)(@@) $ 9716 - علي بن خليفة الطائي كوفي يروي عن جماعة من التابعين روى عنه أهل الكوفة(@)(@@)(@@)(@@) $ 9717 - علي بن سويد بن منجوف السدوسي سدوس شيبان بن ذهل كنيته أبو الفضل من أهل البصرة يروي عن عبد الله بن بريدة روى عنه حماد بن زيد والنضر بن شميل(@)(@@)(@@)(@@) $ 9718 - علي بن علي شيخ من أهل الكوفة يروي عن إبراهيم النخعي أحرفا يسيرة روى عنه شريك بن عبد الله النخعي(@)(@@)(@@)(@@) $ 9719 - علي بن أبي حملة من أهل فلسطين يروي عن الشاميين كنيته أبو نصر وقد قيل أبو حملة مولى آل عتبة بن ربيعة القرشي روى PageV07P210 عنه أهل بلده مات سنة ست وخمسين ومائة وقد قيل سنة ست وستين ومائة حدثنا بن قتيبة بعسقلان قال ثنا بن أبي السري قال ثنا ضمرة بن ربيعة عن علي بن أبي حملة قال قال لي زياد بن صخر يا أبا نصر إذا صنعت يدا فاصنعها إلى ذي دين أو حسب(@)(@@)(@@)(@@) $ 9720 - علي بن أبي المغيرة الزبيري 
ms1157	 كوفي يروي عن أبي إسحاق السبيعي روى عنه أبو غسان مالك بن إسماعيل وأهل الكوفة(@)(@@)(@@)(@@) $ 9721 - علي بن سالم يروي عن علي بن زيد روى عنه إسرائيل بن يونس(@)(@@)(@@)(@@) $ 9722 - علي بن السائب كوفي يروي عن إبراهيم النخعي روى عنه المسعودي يعتبر بحديثه من غير رواية المسعودي عنه(@)(@@)(@@)(@@) $ 9723 - علي بن أبي طلحة مولى بني هاشم سكن الشام كنيته أبو الحسن واسم أبي طلحة سالم يروي عن مجاهد وأبي الوداك روى عنه داود بن أبي هند وراشد بن سعد ومعاوية بن صالح وهو الذي يروى عن بن عباس الناسخ والمنسوخ ولم يره(@)(@@)(@@)(@@) $ 9724 - علي بن الأقمر الوادعي أهل الكوفة يروي عن أبى الأحوص PageV07P211 عن عبيد الله روى عنه شعبة بن الحجاج(@)(@@)(@@)(@@) $ 9725 - علي بن سليمان يروي عن مكحول روى عنه يزيد بن أبي حبيب(@)(@@)(@@)(@@) $ 9726 - علي بن عبد الله بن علي من بني عبد شمس من أهل الحجاز يروي عن أبيه روى عنه عمر بن سعيد بن أبي حسين(@)(@@)(@@)(@@) $ 9727 - علي بن نافع مولى بني نمير من أهل البصرة يروي المراسيل والمقاطيع روى عنه أيوب السختياني وصخر بن جويرية(@)(@@)(@@)(@@) $ 9728 - علي بن عبيد الله أبو عاصم الغطفاني من أهل الكوفة يروي عن ثابت بن عبيد ويسار بن نمير روى عنه الثوري وأبو عوانة(@)(@@)(@@)(@@) $ 9729 - علي بن عتيق يروي عن أبي بردة روى عنه مسعر بن كدام(@)(@@)(@@)(@@) $ 9730 - علي بن أبي العالية يروي عن مورق العجلي روى عنه حماد بن زيد(@)(@@)(@@)(@@) $ 9731 - علي بن محرز الضبي كوفي يروي عن جماعة من التابعين روى عنه أهل الكوفة PageV07P212(@)(@@)(@@)(@@) $ 9732 - علي بن العلاء الخزاعي مولى أم مسكين من أهل البصرة يروي عن الحسن روى عنه عبد الوارث بن سعيد(@)(@@)(@@)(@@) $ 9733 - علي بن حرملة القاضي من أهل الكوفة يروي عن جماعة من التابعين روى عنه أهل الكوفة مات في ولاية هارون(@)(@@)(@@)(@@) $ 9734 - علي بن المعارك الوادي من أهل وادى القرى يروي عن رجل عن المقداد روى عنه عياش بن عباس القتباني(@)(@@)(@@)(@@) $ 9735 - علي بن سليمان 
ms1158	 الكلبي أبو نوفل يروي عن أبي إسحاق السبيعي والأعمش روى عنه الوليد بن مسلم وهشام بن عمار يغرب(@)(@@)(@@)(@@) $ 9736 - علي بن المبارك الهنائي من أهل البصرة يروي عن هشام بن عروة وكان راويا ليحيى بن أبي كثير روى عنه وكيع ومسلم وكان متقنا ضابطا(@)(@@)(@@)(@@) $ 9737 - علي بن هاشم بن البريد العامري البزاز من أهل الكوفة PageV07P213 كنيته أبو الحسن يروي عن إسماعيل بن أبي خالد روى عنه أهل الكوفة مات سنة تسع وثمانين ومائة وكان يتشيع(@)(@@)(@@)(@@) $ 9738 - علي بن عبد الأعلى بن عامر أبو الحسن الثعلبي الأحول من أهل الكوفة يروي عن كثير بن زياد أبي سهل روى عنه زهير بن معاوية وأبو بدر والكوفيون(@)(@@)(@@)(@@) $ 9739 - علي بن قادم يروي عن الأعمش كنيته أبو الحسن مات سنة ثلاث عشرة ومائتين روى عنه أبو بكر بن أبي شيبة وأهل العراق(@)(@@)(@@)(@@) $ 9740 - علي بن مسهر بن علي بن عمير بن عاصم بن عبيد بن مسهر أخو عبد الرحمن بن مسهر القرشي كنيته أبو الحسن وكان قد ولى القضاء يروي عن الشيباني وابن أبي خالد روى عنه أهل العراق مات سنة تسع وثمانين ومائة(@)(@@)(@@)(@@) $ 9741 - علي بن حجر بن إياس بن مقاتل بن المشمرخ السعدي من أهل مرو كنيته أبو الحسن يروي عن معروف الخياط عن واثلة بن الأسقع حدثنا عنه شيوخنا الحسن بن سفيان وغيره PageV07P214(@)(@@)(@@)(@@) $ 9742 - عمرو بن هرم بن حيان الأزدي البصري يروي عن ربعي بن حراش روى عنه أهل البصرة وصلى عليه قتادة بعد ما دفن(@)(@@)(@@)(@@) $ 9743 - عمرو بن مصعب بن الزبير بن العوام القرشي يروي عن عروة بن الزبير روى عنه سعيد بن زيد وأبو هلال(@)(@@)(@@)(@@) $ 9744 - عمرو بن عبد الله بن وهب النخعي عم أبي داود النخعي كنيته أبو معاوية وقد قيل أبو سليمان يروي عن جماعة من التابعين روى عنه سليمان بن ثابت النخعي وأهل الكوفة(@)(@@)(@@)(@@) $ 9745 - أبو العنبس اسمه عمرو بن مروان النخعي من أهل الكوفة يروي عن شقيق بن سلمة وأبيه روى عنه حفص بن غياث 
ms1159	 ووكيع بن الجراح(@)(@@)(@@)(@@) $ 9746 - عمرو بن يحيى بن عمارة بن أبي حسن المازني الأنصاري من أهل المدينة يروي عن أبيه روى عنه مالك والثوري واسم أبي حسن تميم بن عبد عمرو بن قيس من بني مازن بن النجار وأم عمرو PageV07P215 بن يحيى أم النعمان بنت أبي حبة بن عابد بن عمرو بن قيس(@)(@@)(@@)(@@) $ 9747 - عمرو بن أبان بن عثمان بن عفان القرشي أخو عبد الرحمن بن أبان يروي عن أبي غطفان بن طريف المدني عن أبي رافع روى عنه الزهري وأهل المدينة وقد روى عن جابر بن عبد الله أن أبا بكر نيط برسول الله صلى الله عليه وسلم وأن عمر نيط بأبي بكر فلا أدري أسمع منه أم لا(@)(@@)(@@)(@@) $ 9748 - عمرو بن يحيى بن قمطة من خيار أهل مكة يروي عن سالم بن عبد الله روى عنه بن عيينة(@)(@@)(@@)(@@) $ 9749 - عمرو بن منصور المشرقي الهمداني من أهل الكوفة يروي عن الشعبي روى عنه عيسى بن يونس ووكيع(@)(@@)(@@)(@@) $ 9750 - عمرو بن إياس يروي عن سعيد بن أبي الحسن عن أبي هريرة روى عنه قرة بن خالد PageV07P216(@)(@@)(@@)(@@) $ 9751 - عمرو بن مسلم الجندي من أهل اليمن يروي عن طاوس وعكرمة روى عنه زياد بن سعد ومعمر وابن عيينة(@)(@@)(@@)(@@) $ 9752 - عمرو بن تميم مولى زمانة يروي عن أبيه عن أبي هريرة روى عنه كثير بن زيد(@)(@@)(@@)(@@) $ 9753 - عمرو بن غيلان الثقفي أمير البصرة يروي عن كعب روى عنه قتادة(@)(@@)(@@)(@@) $ 9754 - عمرو بن يحيى بن سعيد بن عمرو بن سعيد بن العاص يروي عن جده سعيد بن عمرو عن أبي هريرة روى عنه أحمد بن محمد القواس(@)(@@)(@@)(@@) $ 9755 - عمرو بن إسماعيل يروي عن كعب المقاطيع روى عنه سعيد بن إياس الجريري(@)(@@)(@@)(@@) $ 9756 - عمرو بن عامر بن عبد الله بن الزبير بن العوام يروى عن أبيه PageV07P217 روى عنه عمرو بن يحيى المازني(@)(@@)(@@)(@@) $ 9757 - عمرو بن حريث بن عمارة من بني عمارة من بني عذرة يروي عن أبيه روى عنه سعيد المقبري ويزيد بن عبيد الله 
ms1160	 الهذلي عداده في أهل المدينة وهو الذي يروي عن عبد الملك بن مروان الذي روى عنه معاوية بن صالح وله بن يقال له أبو محمد يروي عن جده حريث عن أبي هريرة روى عنه بن أبي محمد وإسماعيل بن أمية وابن جريج وليس هذا بعمرو بن حريث المخزومي ذاك له صحبة(@)(@@)(@@)(@@) $ 9758 - عمرو بن جارية اللخمي يروي عن أبي أمية الشعباني عن أبي ثعلبة روى عنه عتبة بن أبي حكيم(@)(@@)(@@)(@@) $ 9759 - عمرو بن الأصبغ يروي عن أبيه عن عائشة روى عنه الأسود بن شيبان(@)(@@)(@@)(@@) $ 9760 - عمرو بن أبي مسلم يروي عن عروة بن الزبير روى عنه PageV07P218 عبد الرحمن بن أبي الموالي(@)(@@)(@@)(@@) $ 9761 - عمرو بن حية يروي عن عمرو بن عبد الرحمن بن عوف روى عنه يوسف بن الحكم(@)(@@)(@@)(@@) $ 9762 - عمرو بن المهاجر الدمشقي مولى أسماء بنت يزيد كنيته أبو محمد وهو أخو محمد بن مهاجر يروي عن سليمان بن حبيب والشاميين روى عنه الوليد بن مسلم وأهل الشام مات سنة تسع وثلاثين ومائة وكان على شرطة عمر بن عبد العزيز(@)(@@)(@@)(@@) $ 9763 - عمرو بن أبي حكيم أبو سعيد الواسطي مولى الأزد كنيته أبو سهل وهو الذي يقال له عمرو بن كردي يروي عن عبد الله بن PageV07P219 بريدة روى عنه خالد الحذاء(@)(@@)(@@)(@@) $ 9764 - عمرو بن عثمان بن يعلى يروي عن أبيه عن جده روى عنه خلف بن مهران العدوى(@)(@@)(@@)(@@) $ 9765 - عمرو بن حبيب يروي عن عبيد الله بن حر روى شريك عن جابر عنه(@)(@@)(@@)(@@) $ 9766 - عمرو بن أبي قيس الرازي يروي عن سماك بن حرب روى عنه عبد الله بن الجهم وأهل بلده(@)(@@)(@@)(@@) $ 9767 - عمرو بن قيس بن يسير بن عمرو الكوفي يروي عن الكوفيين وأبيه روى عنه أبو نعيم(@)(@@)(@@)(@@) $ 9768 - عمرو بن خزيمة أبو خزيمة من أهل المدينة يروي عن عمارة بن خزيمة روى عنه هشام بن عروة(@)(@@)(@@)(@@) $ 9769 - عمرو بن الزبير الصراف من أهل البصرة يروي عن أبيه عن عبد الله بن مغفل روى عنه التبوذكي PageV07P220(@)(@@)(@@)(@@) $ 9770 - عمرو بن القاسم 