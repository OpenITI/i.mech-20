ms481	 چشمست او را در صف دجال کن(@)(@@) 14 عشق را روز عزیمت باد بر فتراک بند %~% عقل را وقت هزیمت خاک در دنبال کن(@)(@@) 15 ای سنایی خویش را چون طبع خرم وقت کن %~% روح را چون خود همایون بخت و فرخ فال کن(@)(@@) 16 خرقه و حالت به هشیاری محال و مخرقه‌ست %~% چون ز خود بی خود شدی در خرقه دل حال کن PageV1P0587(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای سنایی قدح دمادم کن %~% روح ما را ز راح خرم کن(@)(@@) 2 لحن را همچو «لام» سر بفراز %~% جام را همچو «جیم» قد خم کن(@)(@@) 3 خشکسالیست کشت آدم را %~% فتح بابش تویی پر از نم کن(@)(@@) 4 حجره عقل را ز تحفه روح %~% تازه چون سجده جای مریم کن(@)(@@) 5 هین که عالم گرفت دیو سپید %~% خیز تدبیر رخش رستم کن(@)(@@) 6 قفس بلبلان سیمین بال %~% سقف این سبزبام طارم کن(@)(@@) 7 رزم بر موج بحر اخضر ساز %~% بزم بر اوج چرخ اعظم کن(@)(@@) 8 همه ره طوطیان چو زاغند %~% خویشتن را شکر مکن سم کن(@)(@@) 9 هر چه جز یار دام او بشکن %~% هر چه جز عشق نام او غم کن(@)(@@) 10 راز با عاشقان محرم گوی %~% ناز با شاهدان محرم کن(@)(@@) 11 خویشتن در حریم حرمت عشق %~% محرم باده محرم کن(@)(@@) 12 زین سپس با بهشتیان عشرت %~% در نهانخانه جهنم کن(@)(@@) 13 ز ره پنج در به یک دو سه می %~% چار دیوار عشق محکم کن(@)(@@) 14 از پی چشم زخم مشتی شوخ %~% دیگ سودای خویش سردم کن(@)(@@) 15 بنده آن دو زلف پر خم شو %~% چاکری آن رخان خرم کن(@)(@@) 16 همچو جمشید برفراز صبا %~% تکیه بر مسند شه جم کن(@)(@@) 17 پس چو جمشید بر نشین بر باد %~% همه را زیر نقش خاتم کن(@)(@@) 18 پری و دیو و جنی و انسی %~% حشرات زمین فراهم کن(@)(@@) 19 آن گه بعد ازین سکندروار %~% گرد بر گرد سد محکم 
ms482	 کن(@)(@@) 20 همچو یاجوج اهل آتش را %~% از پر خویش هین رمارم کن(@)(@@) 21 سرنگون در سقر فگن همه را %~% دوزخ از چشمشان محشم کن(@)(@@) 22 نقش ترتیب صوفیان فلک %~% به یک آسیب جرعه در هم کن(@)(@@) 23 نه هواگیر چون سلیمان باش %~% نه هوس بخش همچو حاتم کن(@)(@@) 24 همه اسلام هستی و مستیست %~% گر مسلمانی این مسلم کن(@)(@@) 25 یک دم از بی خودی سه باده بخور %~% چار تکبیر بر دو عالم کن(@)(@@) 26 هر چه هستی ست نام آن مستی %~% نسخ ماتم سرای آدم کن(@)(@@) 27 همه این کن ولیک با محرم %~% چون نیابی مخنثی هم کن(@)(@@) 28 از خرد چشم اندکی بردار %~% وز کله پشم لختکی کم کن PageV1P0588(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای سنایی خویشتن را بی سر و سامان مکن %~% مایه انفاس را بر عمر خود تاوان مکن(@)(@@) 2 از برای آنکه تا شیطان ز تو شادان شود %~% دیده رضوان و شخص خویش را گریان مکن(@)(@@) 3 دینت را نیکو نداری دیو را دعوت مساز %~% عقل را چاکر نباشی نفس را فرمان مکن(@)(@@) 4 از برای آنکه تا شاهین شود همکاسه‌ات %~% سینه صد صعوه بیچاره را بریان مکن(@)(@@) 5 یونسان تنت را خلعت نمی‌بخشی مبخش %~% یوسفان وقت را در چاه و در زندان مکن(@)(@@) 6 از برای کرکسان باطن اماره را %~% سینه صالح مسوز و اشترش قربان مکن(@)(@@) 7 از پی آن تا خر لنگ ترا پالان بود %~% مر براق خلد را ازین خود عریان مکن(@)(@@) 8 گر به شیطان می‌فروشی یوسف صدیق را %~% چون ز چاهش برکشیدی قیمتش ارزان مکن(@)(@@) 9 یوسف کنعان تن را می‌خری امروز تو %~% یوسف ایمان خود را بیع با شیطان مکن(@)(@@) 10 تا مرض را دارویی بخشی شفا را سر مبر %~% تا عرض را جسم بخشی جسم را بی‌جان مکن(@)(@@) 11 در بلا چون روز قهر نفس روباهیت نیست %~% در خلا دعوی ز فر رستم دستان مکن(@)(@@) 12 صلح کردستیم 
ms483	 با تو این بگیر و آن مبخش %~% بیت مقدس بر میار و کعبه را ویران مکن(@)(@@) 13 سر به سر کردیم با تو نی ز ما و نی ز تو %~% چادر مریم مدزد و شیث را مهمان مکن PageV1P0589(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای دل ار در بند عشقی عقل را تمکین مکن %~% محرم روح‌الامینی دیو را تلقین مکن(@)(@@) 2 خوش نباشد مشورت با عقل کردن پیش عشق %~% قبله تا خورشید باشد اختری را دین مکن(@)(@@) 3 ماه و تیر و زهره و بهرام و برجیس و زحل %~% چون همین خدمت کنندت خدمت پروین مکن(@)(@@) 4 از برای باستانی خسروی را سر مکن %~% وز برای کور دینی حمله بر گرگین مکن(@)(@@) 5 قوت فرهاد و ملک خسروت چون یار نیست %~% دعوی اندر زلف و خال و چهره شیرین مکن(@)(@@) 6 گنج اگر خواهی که یابی ابتدا با رنج ساز %~% چون مکان اندر جهان شد دیده کوته بین مکن(@)(@@) 7 از برای هفت گندم هشت جنت در مباز %~% برگ بی‌برگی مجوی و قصد برگ تین مکن(@)(@@) 8 نی زمانی همچو مایی بلبل مطرب مباش %~% وز برای سور گلبن یاد فروردین مکن(@)(@@) 9 زاد آزادی طلب کن چون محمد مردوار %~% از برای راه سدره گربه‌ای را زین مکن(@)(@@) 10 گرم رو در راه عشق و با خرد صحبت مجوی %~% کبک اگر خواهی که گیری ملوح از شاهین مکن(@)(@@) 11 گاه خلوت پیش رضوان زحمت مالک مخواه %~% حور اگر در خلد یابی دعوت از سجین مکن(@)(@@) 12 عقل و عشق اندر بدایت جز دم آشفته نیست %~% عز و ذل بگسل تو و در عاشقی تعیین مکن(@)(@@) 13 گر قبول عشق خواهی بیخ وصل از دل بکن %~% ملک چین داری ز حسرت ابروان پر چین مکن(@)(@@) 14 عشق بازی و ز خود تربیت جویی شرط نیست %~% نرگس اندر گرد خار خشک وز پرچین مکن(@)(@@) 15 از برای چشم زخم بچه دیو لعین %~% عنبر اشهب مسوز و 
ms484	 ورد خود یاسین مکن(@)(@@) 16 پرده‌دار عقل را در بارگاه دل نشان %~% تاج شاه روح را خلخال آب و طین مکن(@)(@@) 17 صورت آدم نداری از برای زاد دیو %~% پشت سوی جان روح‌افزای حورالعین مکن(@)(@@) 18 اندرین ره همرهانی دوربین چون کرکسند %~% با دو چشم همچو کژدم رهبری چندین مکن(@)(@@) 19 تا نسوزی دل چو لاله پیرهن چون گل مدر %~% دیده چون نرگس نداری چهره چون نسرین مکن(@)(@@) 20 گر بقا خواهی چو کرم پیله گرد خود متن %~% کبر کبک و حرص مور و فعل ما را آیین مکن(@)(@@) 21 از حجاب غفلت آخر یک زمان بیرون نگر %~% ناظر رخسار جانان چشم صورت بین مکن(@)(@@) 22 غیرت اوباش را در کوی او گردن بنه %~% خسرو ایام را بی روی او تمکین مکن(@)(@@) 23 چنگ در فتراک صاحب دولتی زن تا رهی %~% دل برای مال آن و ملک این غمگین مکن(@)(@@) 24 عشق با زاغ‌البصر گویی ترا شد رهنمای %~% حاجب لاینبغی را دعوت تحسین مکن(@)(@@) 25 چون «الم نشرح» شنیدی «رب یسرلی» بگوی %~% چون ز جنت در گذشتی وصف ملک چین مکن(@)(@@) 26 «رحمة للعالمین» را «اهد قومی» ورد ساز %~% «لا تذر اذ ذاعنی» گر بشنوی آمین مکن(@)(@@) 27 دم برای دیگران زن در خلا و در ملا %~% چون تو خاص شهریاری آن خود تضمین مکن(@)(@@) 28 گرگران باری چو قارون جز ثری بستر مساز %~% ور سبک روحی چو عیسی جز قمر بالین مکن(@)(@@) 29 شاهد و شمع و شراب و مطرب آنجا بهترست %~% درد ازینجا برمدار و سینه درد آگین مکن(@)(@@) 30 دست شه خواهی که باشد آشیانت همچو باز %~% چشم سر ز اول بدوز آن راه را بین وین مکن(@)(@@) 31 بر در سلطان نشاید کرد کبکی ره زدن %~% گر نداری گربه با خود دست زی زوبین مکن(@)(@@) 32 خلعت فغفور داری نوبت قیصر مزن %~% شهریار و شاه هندی بندگی تکین مکن(@)(@@) 33 گر ز سر کار خویش آگه 
ms485	 شدی چون دیگران %~% شهد و زهر و کفر و دین را زاد و بوم دین مکن(@)(@@) 34 در نظم از بحر خاطر چون به دست آید ترا %~% جز عروس روح را از عقد او کابین مکن(@)(@@) 35 چون سنایی باش فارغ از برای حرص و آز %~% آفرین بر دیگران بر خویشتن نفرین مکن PageV1P0590(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای منزه ذات تو «اما یقول الظالمون» %~% گفت علمت جمله را «ما لم تکونوا تعلمون»(@)(@@) 2 چون منزه باشد از هر عیب ذات پاک تو %~% جای استغفارشان باشد «و هم یستغفرون»(@)(@@) 3 امر امر تست یارب با پیمبر در نبی %~% گفته‌ای «ان ابرموا امر افانامبرمون»(@)(@@) 4 گوش حس باطنم گر باد اگر نشنوده‌ام %~% با ندایت «ارجعی کل الینا یرجعون»(@)(@@) 5 در ازلمان گفته‌ای «لا تقنطوا من رحمتی» %~% دیگران را گفته‌ای «منهم اذا هم یقنطون»(@)(@@) 6 هست در توفیق تو طاعت رفیق بندگان %~% ای به شارع گفته «فی الخیرات بل لایشعرون»(@)(@@) 7 در جزا و در سزای کس تو مستعجل نه‌ای %~% گفته‌ای «هذالذی کنتم به تستعجلون»(@)(@@) 8 گر بهشت و دوزخ اندر کسب کس مضمر بود %~% گر بهشت و دوزخ از کسب‌ست «مما یکسبون»(@)(@@) 9 آتش دوزخ نسوزد بنده را بی‌حجتی %~% تا نگوید بارها «انا الیکم مرسلون»(@)(@@) 10 جاودان گفتند: «آمنا به رب العالمین» %~% گفته‌ای در جادوی «انالنحن الغالبون»(@)(@@) 11 مر زمین و آسمان را نیست چون تو خالقی %~% خلق مخلوقند و تو خالق «وهم لا یخلقون»(@)(@@) 12 حافظ و ناصر تویی مر بندگان خویش را %~% کیست جز تو حافظ و ناصر «و هم لا ینصرون»(@)(@@) 13 ای ز حق اعراض کرده چون پرستی بت همی %~% حاجت از بت چون همی خواهی «وهم لا یسمعون»(@)(@@) 14 بت پرستیدن همی دنیا پرستیدن بدان %~% گفت در کفران نعمتشان «وانتم تکفرون»(@)(@@) 15 حق پرستی بهترست از بت پرستی خلق را %~% بت پرستی زرپرستی دان «و کانوا یعبدون»(@)(@@) 16 تا نگیرد دست مردان دامن دین هدی %~% دین و دنیاشان 
ms486	 همی گوید «و هم لایهتدون»(@)(@@) 17 دین دین‌داران بماند مال دنیادار نه %~% مرد را پس دین به از دنیا « و مما یجمعون»(@)(@@) 18 گر مقدس گردد اندر مقدس قدسی کسی %~% همچو قدوسان بود در خلد «فیها خالدون»(@)(@@) 19 ور کنی بر معرضه فرمان حق را عرض دین %~% چون کنی اعراض گویندت «وانتم معرضون»(@)(@@) 20 هست در منشور دین توقیع امر و نهی تو %~% امر و نهیش را کنم اظهار «کنتم تکتمون»(@)(@@) 21 در جهان روشنی باید برات حسن و جاه %~% تا چو حسانی نگویندت «فهم لایعقلون»(@)(@@) 22 ور چو سلمان با مسلمانی ز دنیا بگذری %~% بگذر از دنیا برون «الا و انتم مسلمون»(@)(@@) 23 ور به جهد از زحمت شکال حسی نگذری %~% در مقام قدس گویند «انهم لا یذکرون»(@)(@@) 24 از مقام نفس حیوانی گذر کن تا چشی %~% در مقام قرب با روحانیان «ما تشتهون»(@)(@@) 25 کمتر از نحلی نباید بود وقت انگبین %~% نفع او اندر درخت و کوه «مما یعرشون»(@)(@@) 26 عجز تو در ذکر فکرت زاد تو معجز شود %~% گر ز عجز خلق گویند «انهم لا یعجزون»(@)(@@) 27 دست در ایمان حق زن تا ز دوزخ بگذری %~% تا به دوزخ در نگویندت «فهم لا یومنون»(@)(@@) 28 توشه از تقوا کن اندر راه مولا تا مگر %~% در ره عقبا بگویندت «فهم لا یتقون»(@)(@@) 29 شاعر انعام حق باش ای سنایی روز و شب %~% تا چو بی شکران نگویندت «فهم لا یشکرون»(@)(@@) 30 دست در فتراک صاحب شرع زن کایزد همی %~% گوید او را بهر امرش «یفعلوا ما یومرون»(@)(@@) 31 هر که لاخوف علیهم گوید اندر گوش تو %~% هم تواند گفت در گورت «و هم لا یحزنون»(@)(@@) 32 ظلم کم کن بر تن خود تا که ثبت از دست دین %~% آید اندر نامه عمرت «وهم لا یظلمون»(@)(@@) 33 ای به علم بی عمل شادان درین دار فنا %~% گفته همچون عامل عالم «فانا عاملون»(@)(@@) 34 شو بخوان «التائبون العابدون الحامدون %~% سابحون 
ms487	 الراکعون الساجدون امرون» PageV1P0591(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ایا از چنبر اسلام دایم برده سر بیرون %~% ز سنت کرده دل خالی ز بدعت کرده سر مشحون(@)(@@) 2 هوا همواره شیطانی شده بر نفس تو سلطان %~% تنت را جهل پیرایه دلت را کفر پیرامون(@)(@@) 3 اگر در اعتقاد من به شکی تا به نظم آرم %~% علی‌رغم تو در توحید فصلی گوش دار اکنون(@)(@@) 4 ایا آن کس که عالم را طبایع مایه پنداری %~% نهی علت هیولا را که آن ایدون و این ایدون(@)(@@) 5 هیولا چیست الله‌ست فاعل وین بدان ماند %~% که رنج بار بر گاوست و آید ناله از گردون(@)(@@) 6 ترا پرسید من خواهم ز سر بیضه مرغی %~% چو گفتست اندرین معنی ترا تلقین کن افلاطون(@)(@@) 7 سپید و زرد می‌بینم دو آب اندر یکی بیضه %~% وز آن یک بیضه چندین گونه مرغ آید همی بیرون(@)(@@) 8 نگویی از چه معنی گشت پر زاغ چون قطران %~% ز بهر چه دم طاووس رنگین شد چو بوقلمون(@)(@@) 9 هما و جغد را آخر چه علت بود در خلقت %~% چرا شد آن چنان مشئوم و چون شد این چنین میمون(@)(@@) 10 نگویی کز چه می‌گیرد چکاو الحان موسیقار %~% نگویی کز چه می‌بافد تذرو انواع سقلاطون(@)(@@) 11 تفکر کن یکی در خلقت شاهین و مرغابی %~% نگویی از چه معنی گشت آن سقطان این سقطون(@)(@@) 12 یکی چون رایت سیمین همیشه در هوایازان %~% یکی چون زورق زرین روان همواره در جیحون(@)(@@) 13 گریزان این که چون گردد به جان از چنگ او ایمن %~% شتابان آنکه چون ریزد به حرص و شهوت از وی خون(@)(@@) 14 عجبتر زین همه آنست مر پرنده مرغان را %~% مبیت و مسکن و ماواست دیگر سان و دیگرگون(@)(@@) 15 یکی را بیشه ساوی یکی را وادی آمون %~% یکی را قله قاف و یکی را ساحل سیحون(@)(@@) 16 یکی خود را به طمع آن به گردون برده چون نمرود %~% یکی خود را ز 
ms488	 بیم آن به آب افگنده چون ذوالنون(@)(@@) 17 نگیرد باد چنگ آن نشوید آب رنگ این %~% یکی چون رایت الماسست دگر چون زورق مدهون(@)(@@) 18 نگویی تا چرا کردند نوک و چنگ او ز آهن %~% نگویی تا چرا دادند رنگ پر این زاکسون(@)(@@) 19 اگر تو چون منی عاجز در این معنی که پرسیدم %~% چه گویی در نباتی تو سزای حب افتیمون(@)(@@) 20 نمایی هر نباتی را چو مادت هست ز آب و گل %~% ز بهر تف خورشیدست چون لطف هوا مقرون(@)(@@) 21 چرا در یک زمین چندین نبات مختلف بینم %~% ز نخل و نار و سیب و بید چون آبی و چون زیتون(@)(@@) 22 همی دون می‌خورند یک آب و در یک بوستان رویند %~% به رنگ و نیل و صبر و سنبل و مازو و مازریون(@)(@@) 23 اگر علت طبایع شد وجود جمله را چون شد %~% یکی ممسک یکی مسهل یکی دارو یکی طاعون(@)(@@) 24 ار انگورست و خشخاشست اصل عنصر هر دو %~% چرا دانش برد باده چرا خواب آورد افیون(@)(@@) 25 همانا اینکه من گفتم طبایع کرد نتواند %~% نه افلاطون نه غیر او به زرق و حیلت و افسون(@)(@@) 26 مگر بی‌چون خداوندی که اهل هر دو عالم را %~% به قدرت در وجود آورد بی آلت به کاف و نون(@)(@@) 27 خداوندی که آدم را و فرزندان آدم را %~% پدید آورد از ما معین و از گل مسنون(@)(@@) 28 خداوندی که دایم هست اصحاب معاصی را %~% جناب فضل او مامن عذاب عدل او مسجون(@)(@@) 29 همیشه بود او بی ما همیشه باشد او بی شک %~% صفاتش همچو ذاتش حق ولیکن سر او محزون(@)(@@) 30 کلامش همچو وعدش حق ولیکن گفت او مشکل %~% «تعالی ربنا» می‌گوی و می‌دان وصف او بی چون(@)(@@) 31 همو بخشنده دولت همو داننده فکرت %~% همو دارنده گیتی همو دارنده گردون(@)(@@) 32 که پنهان کرد جز ایزد به سنگ خاره در آتش %~% که رویاند همی 
ms489	 جزوی ز خاک تیره آذریون(@)(@@) 33 صدف حیران به دریا در دوان آهو به صحرا بر %~% رمیده و آرمیده هر دو در دریا و در هامون(@)(@@) 34 که پر کرد و که آگند از گیا و قطره باران %~% دهان این و ناف آن ز مشک و لولو مکنون(@)(@@) 35 سپیدی روز صنع کیست در دهر و سیاهی شب %~% که می‌گردند بر یک دور پشتاپشت چون طاحون(@)(@@) 36 همیشه هردو کاهانند و کاهان عمر ما زیشان %~% چو صابون از چه از چربو و چربو از چه صابون(@)(@@) 37 چمن پر حقه لولو که داند کرد در نیسان %~% شمر پر فیبه جوشن که داند کرد در کانون(@)(@@) 38 زبعد آنکه چون سیمسن سپر گردد در افزودن %~% که کاهد ماه را هر ماه «حتی عادکالعرجون»(@)(@@) 39 که بندد چون خزان آید هزاران کله ادکن %~% که باشد چون بهار آید هوا را کله گردون(@)(@@) 40 که گرداند ملون کوه را چون روضه رضوان %~% که گرداند منقش باغ را چون صحف انگلیون(@)(@@) 41 دوار مختلف را متفق با هم که گرداند %~% به قدرت در یکی موضع کند هر دو بهم معجون(@)(@@) 42 پس آنکه نطفه گرداند وزو شخصی کند پیدا %~% مثالش محکم و ثابت نهادش متفن و موزون(@)(@@) 43 یکی عالم یکی جاهل یکی ظالم یکی عاجز %~% یکی منعم یکی مفلس یکی شادان یکی محزون(@)(@@) 44 یکی همواره با دولت به کام از نعمت باقی %~% یکی پیوسته با محنت به رنج از اختر وارون(@)(@@) 45 یکی را از بلاساغون رساند در هری روزی %~% یکی را از پی نانی دواند تا بلاساغون(@)(@@) 46 بزرگا پادشاها اوست کز یک آب و یک نطفه %~% پدی آورد چندین خلق لونالون و گوناگون(@)(@@) 47 گزیده خسروان بودند زین پیش اندرین عالم %~% ز رفعت همسر گردون به نعمت همسر قارون(@)(@@) 48 چو عاد و کیقباد و بهمن و کاووس و کیخسرو %~% منوچهر و جم و تهمورس و ضحاک و افریدون(@)(@@) 49 
ms490	 ور از یونانیان بقراط و بطلمیوس و افلاطون %~% بلیناس حکیم و هرمز و سقراط و افلیمون(@)(@@) 50 ور از پیغمبران ادریس و نوح و یونس و صالح %~% حبیب و روح و ابراهیم و لوط و موسی و هارون(@)(@@) 51 ور از اصحاب پیغمبر عتیق و عمر و عثمان %~% علی و سعد و سلمان و صهیب و خالد و مظنون(@)(@@) 52 وگر از اولیا مهیار و حیره خالد و خضری %~% جنید و شبلی و معروف شاه توری و سمنون(@)(@@) 53 درین عالم ز ریگ و قطره باران بنی آدم %~% ز هر جنسی که من گفتم همانا بوده‌اند افزون(@)(@@) 54 چو ممکن نیست دانستن شمار مرگ معروفان %~% ببین تا خود که داند کرد در عالم حساب ایدون(@)(@@) 55 تعالا صانعی کاین جمله از آب او پدید آورد %~% پس آن گه جمله را هم وی به خاک اندر کند مدفون(@)(@@) 56 ایا دل بسته در دنیا و فارغ گشته از عقبا %~% چه سود از سود امروزین که فردا هم تویی مغبون(@)(@@) 57 چو عالم را همی دانی که فانی گشت خواهد پس %~% به مهر عالم فانی چرا دل کرده‌ای مرهون(@)(@@) 58 الاهی بنده بیچاره مسکین سنایی را %~% که هست از دین و طاعتهای تو درمانده و مدیون(@)(@@) 59 اگر چه هست او مطعون به علتها طمع دارد %~% بدین توحید نامطعون جزایی از تو نامطعون PageV1P0592(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 در میان کفر و دین بی اتفاق آن و این %~% گفتگویست از من و تو مرحبا بالقائلین(@)(@@) 2 هر کجا عشق من و حسن تو آید بی‌گمان %~% در نه پیوندد خرد با کاف کفر و دال و دین(@)(@@) 3 حسن خوبان بزم شد کی بود بی های و هوی %~% عشق مردان رزم باشد کی بود بی هان وهین(@)(@@) 4 هیچ وقت ایمن نبودند از زبان ناکسان %~% عاشقان پرنیاز و دلبران نازنین(@)(@@) 5 چه نکوتر زان که آید عاشقی در مجمعی %~% باغ معنی در جنان و داغ 
ms491	 دعوی در جبین(@)(@@) 6 آن یکی گوید فلان ناپاک فاسق را نگر %~% و آن دگر گوید که بهمان شوخ کافر را ببین(@)(@@) 7 حسن و عشق از کفر و فسق آید به معنی پس بود %~% تیغ حیدر بید چوب و آب کوثر پارگین(@)(@@) 8 عاشقی را کاسمان رنجه ندارد هر زمان %~% در زمین باشد بسی به زان که باشد بر زمین(@)(@@) 9 هست پیدا از میان سینه آزادگان %~% عشق همچون خلد و عاشق در میان چون حور عین(@)(@@) 10 گر بدرد پوستین عاشقان گردون رواست %~% کی زیان دارد که اندر خلد نبود پوستین(@)(@@) 11 ای رسیده هر شبی از انده هجران تو %~% بانگ من چون حسن تو در آسمان هفتمین(@)(@@) 12 با توام در خانه می‌دانند و من بر آستان %~% «نحن محرومین» نوشته بر طراز آستین(@)(@@) 13 نقش هر یک تار موی از قندز شب پوش تست %~% کای بلا بیرون خرام ای عافیت عزلت گزین(@)(@@) 14 هر زمان آید ندا اندر دل هر عاشقی %~% کای خرد دیوانه گرد ای صبر در گوشه نشین(@)(@@) 15 هر کجا چشم چو آهوی تو شد تازان چو یوز %~% مصلحت بر گاو بندد بنگه شیر عرین(@)(@@) 16 انگبین از نحل زاید لیکن اندرگاه عشق %~% نحل زاید بهر من زان دو لب چون انگبین(@)(@@) 17 ای لبت را گفته رضوان نوش باش ای زود مهر %~% وی لبت را گفته شیطان دیر زی ای دیر کین(@)(@@) 18 گر چه خود را عشقباز راستین ننهم از آنک %~% نیستم چون عاشقان راستین در گل دفین(@)(@@) 19 ماهروی راستین خوانم ترا باری چو یافت %~% روی چون ماه تو نور از روی شاه راستین PageV1P0593(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای گزیده مر ترا از خلق رب‌العالمین %~% آفرین گوید همی بر جان پاکت آفرین(@)(@@) 2 از برای اینکه ماه و آفتابت چاکرند %~% می طواف آرد شب و روز آسمان گرد زمین(@)(@@) 3 خال تو بس با کمال و فضل تو بس با جمال %~% روی 
ms492	 تو نور مبین و رای تو حبل‌المتین(@)(@@) 4 نقش نعل مرکب تو قبله روحانیان %~% خاکپای چاکرانت توتیای حور عین(@)(@@) 5 مرگ با مهر تو باشد خوشتر از عمر ابد %~% زهر با یاد تو باشد خوشتر از ماه معین(@)(@@) 6 ای سواری کت سزد گر باشد از برقت براق %~% بر سرش پروین لگام و مه رکاب و زهره زین(@)(@@) 7 بر تن و جان تو بادا آفرین از کردگار %~% جبرییل از آسمان بر خلق تو کرد آفرین(@)(@@) 8 از برای اینکه تا آسان کند این دین خویش %~% آدمی از آدم آرد حور از خلد برین(@)(@@) 9 جبرییل ار نام تو در دل نیاوردی به یاد %~% نام او در مجمع حضرت کجا بودی امین(@)(@@) 10 این صفات و نعت آن مردست کاندر آسمان %~% از برای طلعتش می‌تابد این شمس مبین(@)(@@) 11 نور رخسارت دهد نور قبولش را مدد %~% سایه زلفت شب هجرانش را باشد کمین(@)(@@) 12 زین سبب مقبول او شد فتنه‌ای بر شرک کفر %~% زین سبب مقصود او شد سغبه‌ای در راه دین(@)(@@) 13 زین قلم زن با قلم‌گر تو نباشی هم نشان %~% وین قدم زن با ندم‌گر تو نباشی هم نشین(@)(@@) 14 ای سنایی گر ز دانایی بجویی مهر او %~% جز کمالش را مدان و جز جمالش را مبین(@)(@@) 15 اژدهای عشق را خوردن چه باید ای عجب %~% گاه شرک از کافران و گاه دین از بوالیقین PageV1P0594(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 هر که را ملک قناعت شد مسلم بر زمین %~% ز آسمان بر دولت او آفرین باد آفرین(@)(@@) 2 عز دین از جاه دنیا کس نجست اندر جهان %~% جاه دنیا را چکارست ای پسر با عز دین(@)(@@) 3 رستگاری هر دو عالم در کم آزاری بود %~% از بد اندیشان بترس و با کم‌آزاران نشین(@)(@@) 4 مر ترا گفتند دست از مردمان کوتاه کن %~% تو چرا چون ابلهان کوتاه کردی آستین(@)(@@) 5 نامه کوته نکو باشد به هنگام حساب %~% جامه کوته چه 
