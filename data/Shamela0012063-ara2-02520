ms2515	 محمد الحمصي عن خالد بن معدان وعنه الأوزاعي.(@)(@@)(@@)(@@) | 4083 - (@)(@@) " العلاء " بن الفضل عبد الملك المنقري أبو الهذيل البصري عن أبيه وعنه الأصمعي ومحمد بن بشار.(@)(@@)(@@)(@@) | 4084 - (@)(@@) " العلاء " بن مسلمة بن عثمان التيمي مولاهم أبو سالم البغدادي الرواس عن ضمرة بن ربيعة وعنه الترمذي.(@)(@@)(@@)(@@) | 4085 - (@)(@@) " العلاء " بن المسيب بن رافع الكاهلي الثعلبي الأسدي الكوفي عن أبيه وإبراهيم النخعي.(@)(@@)(@@)(@@) | 4086 - (@)(@@) " العلاء " بن هلال بن عمرو بن هلال بن أبي عطية الباهلي مولى قتيبة بن مسلم أبو محمد الرقي وعنه ابنه هلال.(@)(@@)(@@)(@@) | 4087 - (@)(@@) " العلاء " بن يزيد أبو محمد الثقفي هو ابن زيدل.(@)(@@)(@@)(@@) | 4088 - (@)(@@) " العلاء " البجلي والد يحيى.(@)(@@)(@@)(@@) | 4089 - (@)(@@) " العلاء " عن داود بن عبد الله وعنه أبو عبد الرحيم الحراني.(@)(@@) PageV07P309(@)(@@)(@@)(@@) | من اسمه علاج وعلاق وعلباء وعلقمة(@)(@@)(@@)(@@) | 4090 - (@)(@@) " علاج1 " بن عمرو عن ابن عمر وعنه أشعث بن سليم.(@)(@@)(@@)(@@) | 4091 - (@)(@@) " علاق " بن أبي مسلم عن جابر وأنس وعنه عنبسة بن عبد الرحمن.(@)(@@)(@@)(@@) | 4092 - (@)(@@) " علبا " بن أبي العلباء2 الكوفي عن علي وعنه ابن أخيه عمرو بن غزي لا يعرف. PageV07P309(@)(@@)(@@)(@@) | 4093 - (@)(@@) " علقمة " بن بجالة1 عن أبي هريرة رضى الله عنه وعنه عكرمة بن عمار لا يعرف.(@)(@@)(@@)(@@) | 4094 - (@)(@@) " علقمة " بن أبي جمرة بالجيم الضبعي عن أبيه وعنه مطهر بن الهيثم.(@)(@@)(@@)(@@) | 4095 - (@)(@@) " علقمة " بن نضلة بمعجمة الكناني أو الكندي الكوفي عن عمر مرسلا.(@)(@@)(@@)(@@) | 4096 - (@)(@@) " علقمة " بن وائل بن حجر الحضرمي الكوفي الكندي عن أبيه والمغيرة وعنه اخوه عبد الجبار. PageV07P310(@)(@@)(@@)(@@) | من اسمه علي(@)(@@)(@@)(@@) | 4097 - (@)(@@) " علي " بن بذيمة2 الجزري مولى جابر بن سمرة كوفي عن الشعبي وغيره وعنه شعبة والثوري.(@)(@@)(@@)(@@) | 4098 - (@)(@@) " علي " بن أبي بكر بن سليمان الكندي مولاهم أبو الحسن الأسفذني3 المرزي عنه ابنه عمرو.(@)(@@)(@@)(@@) | 4099 - (@)(@@) " علي " بن ثابت الهاشمي مولاهم أبو الحسن الجزري عن ابن عون وعنه هناد.(@)(@@)(@@)(@@) | 4100 - (@)(@@) " علي " بن الجعد بن عبيد