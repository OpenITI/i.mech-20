ms61	 ان لنها % % ر مد له الليل ، ف ستأخرا % % 14(@)(@@) % قضينا به بعض ما نشتهي ، % وكان الحديث به أجدرا % % PageV01P250 البحر : متقارب تام 1(@)(@@) % صحا القلب عن ذكر أم البنين % % بعد الذي قد مضى في العصر % 2(@)(@@) % وأصبح طاوع عذاله ، % وأقصر ، بعد الإباء ، الصبر % 3(@)(@@) % أحين وقد راعه رائع % من الشيب من يعله يزدجر % 4(@)(@@) % على أن حب ابنة العامري ، % كالصدع في الحجر المنفطر % % 5(@)(@@) % يهيم إليها وتدنو له % جنوح الظلام بليل حذر % % 6(@)(@@) % وينمي لها حبها عندنا % % فمن قال من كاشح لم يضر % % 7(@)(@@) % فمن كان عن حبه ساليا ، % فلست بسال ، ولا معتذر % % 8(@)(@@) % تذكرت ب لشري أيامها % % وأيامنا بكثيب الأمر % 9(@)(@@) % ليالي يجري بأسرارنا % % أمين لنا ، ليس يفشي لسر % % 10(@)(@@) % فأعجبها غلواء الشبا % % ب تنبت في ناضر مسبكر % PageV01P251 11(@)(@@) % وإذ أنا غر أجاري ددا % أخو لذة كصريع السكر % % 12(@)(@@) % من المسبغين رقاق البرو % % د أكسو النعال فضول الأزر % 13(@)(@@) % وإذ هي حوراء ، رعبوبة ، % ثقال متى ما تقم تنبتر % 14(@)(@@) % تكاد روادفها ، إن نأت % % إلى حاجة ، موهنا تنبتر % 15(@)(@@) % وتدني النصيف على واضح ، % جميل ، إذا سفرت عنه ، حر % % 16(@)(@@) % وإذ هي تضحك عن نير ، % لذيذ المقبل ، عذب ، خصر % % 17(@)(@@) % شتيت المراكز أحوى اللثات % % ثات ، كدر تنضد ، فيه أشر % % 18(@)(@@) % وإذ هي مثل مهاة الكثيب ، % تحنو على جؤذر في خمر % % 19(@)(@@) % ولست بناس ، طوال الحيا % % ة ليلتنا بكثيب الغدر % 20(@)(@@) % ولا قولها لي إذ أيقنت % بما قد أريد بها : استقر % % PageV01P252 البحر : طويل 1(@)(@@) % تقول ابنة البكرين يوم التقينا : % لقد شاب هذا بعدنا وتنكرا % % 2(@)(@@) % فمثل الذي عاينت شيب لمتي % % ومثل الذي أخفي من الحزن نكرا % % 3(@)(@@) % فكم فيهم من سيد قد رزئته % وذي شيبة ك لبدر أروع أزهرا % % 4(@)(@@) % أولئك هم قومي ، وجدك ، لا أرى % % لهم شبها فيمن على الأرض معشرا % % 5(@)(@@) % أذب وراء المستضيف إذا دعا % % وأضرب في يوم الهياج السنورا % % 6(@)(@@) % وأفضل أحلاما ، وأعظم نائلا ، % وأقرب معروفا وأبعد منكرا % % 7(@)(@@) % وإن أنعموا ثنوا عليه بصالح % ولم يتبعوا الإحسان منا مكدرا 
ms62	 % % PageV01P253 البحر : كامل أحذ 1(@)(@@) % لجت فطيمة منك في هجر % غدرا ، وهن صواحب الغدر ! % 2(@)(@@) % من بعد ما أعطتك موثقها % % أن لا تخونك آخر الدهر % % 3(@)(@@) % مكية كالريم ، علقها % % قلبي ، فضاق بحبها صدري % % 4(@)(@@) % وكأنني أسقى إذا ذكرت % صفو المدام ، على رقى السحر % % PageV01P254 البحر : كامل تام 1(@)(@@) % ابكيت في طرب ، أبا بشر ، % وذكرت عثمة أيما ذكر % % 2(@)(@@) % وهي التي لما مررت بها % % في الطوف بين الركن والحجر % % 3(@)(@@) % قالت حصان غير فاحشة ، % فسمعت ما قالت ، ولم تدر % % 4(@)(@@) % لمناصف خرد يطفن بها % % مثل الظباء يكدن بالسدر : % 5(@)(@@) % هذا الذي يسبي الفؤاد ، ولا % % يكني ، ولكن باح في الشعر % 6(@)(@@) % إن الرجال على تألفهم % طبعوا على الإخلاف والغدر % % PageV01P255 البحر : منسرح 1(@)(@@) % قد هاج أحزان قلبك الذكر ، % واشتاق ، والشوق للفتى عبر % 2(@)(@@) % هيجني البدن الملاح ، فما % % انفك بين الحسان أقتصر % % 3(@)(@@) % هل من كريم يهتاج ذي حسب % قد شفه من حبيبه السهر % 4(@)(@@) % أو هل تغنى لشجوه ، فبكى ، % كما تغنى لشجوه عمر ؟ % 5(@)(@@) % تسترهن الخزوز إن فتحت % يوما مقاصير دونها الحجر % % 6(@)(@@) % هيف رعابيب بدن شمس % فيهن حسن الدلال والخفر % 7(@)(@@) % ما أحسن الود والصفاء وما % % أقبح منها الهجران والعذر % % PageV01P256 البحر : طويل 1(@)(@@) % سلام عليها ، ما أحبت سلامنا ، % فإن كرهته فالسلام على أخرى % % PageV01P257 البحر : كامل تام 1(@)(@@) % أبت الروادف والثدي لقمصها % % مس البطون ، وأن تمس ظهورا % % 2(@)(@@) % وإذا الرياح مع العشي تناوحت ، % نبهن حاسدة ، وهجن غيورا % % PageV01P258 البحر : خفيف تام 1(@)(@@) % خبروها بأنني قد تزوجت ، % فظلت تكاتم الغيظ سرا % % 2(@)(@@) % ثم قالت لأختها ولأخرى : % جزعا : ليته تزوج عشرا % % 3(@)(@@) % وأشارت إلى نساء لديها ، % لا ترى دونهن للسر سترا : % 4(@)(@@) % ما لقلبي ، كأنه ليس مني ، % وعظامي إخال فيهن فترا % % 5(@)(@@) % من حديث نمى إلي ، فظيع ، % خلت في القلب من تلظيه جمرا % % PageV01P259 البحر : خفيف تام 1(@)(@@) % حي طيفا من الأحبة زارا % % بعدما صرع الكرى السمارا % % 2(@)(@@) % طارقا في المنام ، تحت دجى اللي % % ل ، ضنينا بأن يزور نهارا % % 3(@)(@@) % قلت : ما بالنا جفينا وكنا % % قبل ذاك ، الأسماع والأبصارا 
ms63	 ؟ % 4(@)(@@) % قال : إنا كما عهدت ، ولكن % % شغل الحلي أهله أن يعارا % % PageV01P260 البحر : بسيط تام 1(@)(@@) % تقول : يا عمتا كفي جوانبه % ويلي ، بليت ، وأبلى جيدي الشعر % 2(@)(@@) % مثل الأساود قد أعيا مواشطه % تضل فيه مداريها ، وتنكسر % 3(@)(@@) % فإن نشرت على عمد ذوائبها ، % أبصرت منه فتيت المسك ينتثر % PageV01P261 البحر : متقارب تام 1(@)(@@) % تذكرت هندا وأعصارها % % ولم تقض نفسك أوطارها % % 2(@)(@@) % تذكرت النفس ما قد مضى % % وهاجت على العين عوارها % % 3(@)(@@) % لتمنح رامة منا الهوى ، % وترعى لرامة أسرارها % % 4(@)(@@) % إذا لم نزرها حذار العدى % % حسدنا على الزور زوارها % % PageV01P262 البحر : بسيط تام 1(@)(@@) % قد حان منك ، فلا تبعد بك الدار ، % بين ، وفي البين للمتبول إضرار % 2(@)(@@) % قالت : من انت على ذكر ؟ فقلت لها : % أنا الذي ساقني للحين مقدار % PageV01P263 البحر : طويل 1(@)(@@) % رأين الغواني الشيب لاح بعارضي % % فأعرضن عني بالخدود النواضر % 2(@)(@@) % وكن إذا أبصرنني أو سمعنني % % سعين فرقعن الكوى ب لمحاجر % 3(@)(@@) % فإن جمحت عني نواظر أعين ، % رمين بأحداق المها والجآذر % 4(@)(@@) % فإني من قوم كريم نجارهم ، % لأقدامهم صيغت رؤوس المنابر % PageV01P264 البحر : بسيط تام 1(@)(@@) % إني امرؤ مولع بالحسن أتبعه ، % لا حظ لي فيه إلا لذة النظر % PageV01P265 البحر : بسيط تام 1(@)(@@) % قالت ، وأبثثتها سري وبحت به : % قد كنت عندي تحت الستر ، فاستتر % 2(@)(@@) % ألست تبصر من حولي ؟ فقلت لها : % غطى هواك ، وما ألقى ، على بصري % % PageV01P266 البحر : طويل 1(@)(@@) % عفا الله عن ليلى الغداة ، فإنها % % إذا وليت حكما علي تجور % PageV01P267 البحر : طويل 1(@)(@@) % لعمري لقد نلت الذي كنت أرتجي % % وأصبحت لا أخشى الذي كنت أحذر % 2(@)(@@) % فليس كمثلي اليوم كسرى وهرمز % ولا الملك النعمان مثلي وقيصر % PageV01P268 البحر : مجزوء الوافر 1(@)(@@) % بعثت وليدتي سحرا % وقلت لها : خذي حذرك % 2(@)(@@) % وقولي ، في معاتبة ، % لزينب : نولي عمرك % % 3(@)(@@) % فإن داويت ذا سقم % فأخزى الله من كفرك % % 5(@)(@@) % أهذا سحرك النسوا % % ن ؟ قد خبرنني خبرك % 6(@)(@@) % وقلن إذا قضى وطرا % وادرك حاجة هجرك % % PageV01P269 البحر : كامل تام 1(@)(@@) % أبت البخيلة أن تنولني % % فأظن أني زائر رمسي % % 2(@)(@@) % لا خير في 
ms64	 الدنيا وبهجتها ، % إن لم توافق نفسها نفسي % % 3(@)(@@) % لا صبر لي عنها ، إذا برزت ، % ك لبدر أو قرن من الشمس % 4(@)(@@) % نظرت إليك بعين جازئة % كحلاء وسط جآذر خنس % 5(@)(@@) % فسبت فؤادك ، عند نظرتها ، % بملاحة الأنياب والأنس % 6(@)(@@) % جودي لمن أورثته سقما ، % وتركته حيران في لبس % 7(@)(@@) % لا تحرميه الوصل و تخذي % % أجرا فليس بذاك من بأس % 8(@)(@@) % ولقد خشيت بأن يكون بهش % % من حبكم طرف من لمس % PageV01P270 البحر : كامل تام 1(@)(@@) % إن الخليط تصدعوا أمس % وتصدعت لفراقهم نفسي % % 2(@)(@@) % ووجدت وجدا كان أهونه % كأشد وجد الجن والإنس % 3(@)(@@) % وتشتت الأهواء يخلجني % % نحو العراق ، ومطلع الشمس % % 4(@)(@@) % وهناك فأتوني بخرعبة ، % غراء ، آنسة ، من اللعس % % 5(@)(@@) % ما كان من سقم فكان بنا % % وبها السلام ، وصحة النفس % % 6(@)(@@) % وتبيت عوادي وقد يئسوا % % مني وأصبح مثلما أمسي % % PageV01P271 البحر : كامل تام 1(@)(@@) % فيم الوقوف بمنزل خلق % أو ما سؤال جنادل خرس ؟ % 2(@)(@@) % عجت المطي به أسائله % أين استقرت دارة الشمس ؟ % 3(@)(@@) % فعجبت منها إذ تقول لنا : % يا صاح ، ما هذي من الأنس % 4(@)(@@) % ميمونة ولدت على يمن ، % ب لطائر الميمون لا النحس % % 5(@)(@@) % مقبولة ، لبق القبول بها ، % ليس القبول بها بذي نكس % % 6(@)(@@) % غراء واضحة لها بشر % كالرق مستعر من الورس % 7(@)(@@) % زمت فؤادي ، فهو يتبعها % % للغور إن غارت وللجلس % % PageV01P272 البحر : طويل 1(@)(@@) % ومن لسقيم يكتم الناس ما به % لزينب نجوى صدره والوساوس % 2(@)(@@) % أقول لمن يبغي الشفاء : متى تجىء % بزينب ، تدرك بعض ما انت لامس % 3(@)(@@) % فإنك إن لم تشف من سقمي بها % % فإني من طب الاطباء يائس % 4(@)(@@) % فلست بناس ليلة الدار مجلسا % لزينب حتى يعلو الرأس رامس % 5(@)(@@) % خلاء ، بدت قمراؤه وتكشفت % دجنته وغاب من هو حارس % 6(@)(@@) % فما نلت منها محرما ، غير أننا % % كلانا من الثوب المورد لابس % 7(@)(@@) % نجيين ، نقضي اللهو في غير مأثم ، % ولو رغمت ملكاشحين المعاطس % % PageV01P273 البحر : طويل 1(@)(@@) % خليلي ، ما بال المطايا ، كأنما % % نراها على الأدبار ب لقوم تنكص % 2(@)(@@) % وقد قطعت أعناقهن صبابة % فأنفسنا مما 
ms65	 يلاقين شخص % 3(@)(@@) % وقد أتعب الحادي سراهن ، وانتحى % % لهن فما يألو عجول مقلص % 4(@)(@@) % يزدن بنا قربا فيزداد شوقنا % % إذا زاد طول العهد والبعد ينقص % PageV01P274 البحر : مجزوء الكامل 1(@)(@@) % يا برق ، أبرق من قري % % بة مستكفا لي نشاصه % 2(@)(@@) % ذا هيدب دان ، يحن % إلى مناصفه قلاصه % % 3(@)(@@) % جون تخد سيوله % في الأرض منساحا فراصه % 4(@)(@@) % أمت غداة رحيلها % % والبين ذو شرك شصاصه % 5(@)(@@) % فبدت ترائب شادن ، % ومكرس فيه عقاصه % 6(@)(@@) % وأغر كالإغريض عذ % ب لا يغيره انتقاصه % PageV01P275 البحر : وافر تام 1(@)(@@) % فلا ، وأبيك ، ما صوت الغواني ، % ولا شرب التي هي كالفصوص % 2(@)(@@) % أردت برحلتي وأريد حظا % ولا أكل الدجاج ، ولا الخبيص % 3(@)(@@) % قميص ما يفارقني حياتي % % أنيس في المقام وفي الشخوص % PageV01P276 البحر : مجزوء الرمل 1(@)(@@) % أصبح القلب مريضا ، % راجع الحب غريضا % % 2(@)(@@) % وأجد الشوق وهنا ، % أن رأى وجها وميضا % % 3(@)(@@) % ثم بات الركب نوا % % ما ، ولم يطعم غموضا % % 4(@)(@@) % ذاك من هند قديما % % تركها القلب مهيضا % % 5(@)(@@) % إذ تبدت لي ، فأبدت % واضح اللون ، نحيضا % % 6(@)(@@) % وعذاب الطعم ، غرا % كأقاحي الرمل بيضا % % 7(@)(@@) % أرسلت سرا إلينا ، % وثنت رجعا خفيضا % % 8(@)(@@) % أن تلبث لي إلى أن % نلبس الليل العريضا % % 9(@)(@@) % وكأن الشهد والإس % فنط ، والماء الفضيضا % % 10(@)(@@) % باشر الأنياب منها % % بعدما ذاقت غموضا % % PageV01P277 البحر : كامل تام 1(@)(@@) % يا سكن ، قد ، والله رب محمد ، % أقصدت قلبي ب لدلال فعوضي % % 2(@)(@@) % وتحرجي من قتل من لم يبغكم % % هجرا ، ولا صرما ، ولم يبغض % 3(@)(@@) % يا سكن لست وإن نأت بك داركم ، % ب لسال عنك ولا الملول المعرض % 4(@)(@@) % يا سكن ، كم ممن تودد عندنا % % أقصي وكم من كاشح متعرض % 5(@)(@@) % وصرمت فيك أقاربي ، وعواذلي ، % ووصلت عمدا فيك حبل المبغض % % 6(@)(@@) % وحفظت فيك أمانة حملتها % % وعصيت كل محرش ومعرض % 7(@)(@@) % يا سكن ، حبك إذ كلفت بحبكم ، % غرضا أراه ورب مكة ممرضي % % 8(@)(@@) % يا سكن ، كان العهد فيما بيننا ، % ويمين صبر منك ، أن لا تنقضي % % 9(@)(@@) % منا العهود ، ولا يكون وصالكم % مذق الحديث بلط دين المقرض % 10 
ms66	(@)(@@) % فلبست ذلك منك بعد جديده % % ظلما لعمري كاللباس العرمض % PageV01P278 11(@)(@@) % ووجدت حبلك من حبال محافظ % سجح الخلائق في الوصال معرض % PageV01P279 البحر : كامل تام 1(@)(@@) % يا صاحبي ، قفا نقض لبانة ، % وعلى الظعائن قبلبينكما اعرضا % % 2(@)(@@) % لا تعجلاني أن أقول بحاجة % رفقا ، فقد زودت داء محرضا % % 3(@)(@@) % ما أنس الذي بذلت لنا % % منها على عجل الرحيل لتمرضا % % 4(@)(@@) % ومقالها ب لنعف نعف محسر % لفتاتها : هل تعرفين المعرضا ؟ % 5(@)(@@) % هذا الذي أعطى مواثق عهده ، % حتى رضيت وقلت لي لن ينقضا % % 6(@)(@@) % وزعمت لي أن لا يحول ، فإنه % ساع طوال حياته لي بالرضا % % 7(@)(@@) % والله يعلم إن ظفرت بمثلها % % منه ليعترفن ما قد أقرضا % % 8(@)(@@) % فأصخت سمعي نحوها فكأنما % % أوريت بين جوانحي جمر الغضا % % 9(@)(@@) % فعطفت راحلتي ، وقلت لصاحبي : % أنظر ، بعمرك ، نحوها أن تومضا % % 10(@)(@@) % قال الجري : قد أومضت ، قلت : ائتها ، % و حذر حريز مقالها أن يعرضا % % PageV01P280 11(@)(@@) % قالت له : بالله ربك ، قل له % % قولا يحركه عسى أن يمعضا : % 12(@)(@@) % حملتها وجدا ، لو أمسى مثله % يوما على جبل ، إذا لتقضقضا % % 13(@)(@@) % وتنظرت منك الجزاء لوعدها % % حولا تجرم كله ، حتى انقضى % % 14(@)(@@) % فأجبتها : إن قلت فاعفوا و صفحوا % % فأنا الذي لا عذر لي فيما مضى % % 15(@)(@@) % زعمت بأني قد سلوت ، ولو درت % أن لم أجد من حبها متعرضا % % 16(@)(@@) % ما عدت أرضي الكاشحين بهجرها ، % أبدا ، وإن قال النصيح وعرضا % % 17(@)(@@) % وأطعت فيها الكاشحين ، فأكثروا % % فيها المقالة شامتا ، ومعرضا % % 18(@)(@@) % طاوعت فيها واشيا فكأنني % % في صرم ذات الخال ، كنت مغمضا % % 19(@)(@@) % وسفاهة ب لمرء صرم صديقه % يرضي بهجرته العدو المبغضا : % 20(@)(@@) % إرجع فعاودها المساء فإنني % % أخشى من العادي بها أن يعرضا % % PageV01P281 البحر : هزج 1(@)(@@) % ألا حبذا نجد ، % ومن أسكنها أرضا % % 2(@)(@@) % وحيا حبذا ما هم % % ولو لي حقدوا البغضا % % 3(@)(@@) % ومن أجل الهوى أدني % % لمن لم أرضه معضا % % 4(@)(@@) % علقتك ناشئا ، حتى % % رأيت الرأس مبيضا % % 5(@)(@@) % فإن تتعاهدي ودي % % إذا تجدينه غضا % % 6(@)(@@) % على بخل ، وتصريد ، % وقبض نوالكم قبضا % % 7(@)(@@) % أهيم بذكركم لو أ % ن خيرا 
ms67	 منكم بضا % % 8(@)(@@) % فيا عجبا لموقفنا % % يعاتب بعضنا بعضا ! % PageV01P282 البحر : خفيف تام 1(@)(@@) % طال من آل زينب الإعراض ، % للتعدي ، وما بنا الإبغاض % 2(@)(@@) % ووليدين كان علقها القلب ، % إلى أن علا الرؤوس البياض % 3(@)(@@) % حبلها عندنا متين ، وحبلي % % عندها واهن القوى أنقاض % 4(@)(@@) % نظرت يوم فرع لفت إلينا % % نظرة كان رجعها إيماض % 5(@)(@@) % حين قالت لموكب كمها الرم % % ل أطاعت له النبات الرياض : % 6(@)(@@) % عجن نحو الفتى البغال نحيي % % بما تكتم القلوب المراض % % 7(@)(@@) % وأحدثه ما تضمنت منه ، % إذ خلا اليوم للمسير المراض % % PageV01P283 البحر : طويل 1(@)(@@) % ألم تسأل الأطلال والمتربعا ، % ببطن حليات ، دوارس بلقعا ؟ % 2(@)(@@) % إلى الشري من وادي المغمس بدلت % % معالمه وبلا ونكباء زعزعا % % 3(@)(@@) % فيبخلن أو يخبرن ب لعلم بعدما % % نكأن فؤادا كان قدما مفجعا % % 4(@)(@@) % بهند ، وأتراب لهند ، إذ الهوى % % جميع ، وإذ لم يخش أن يتصدعا % % 5(@)(@@) % وإذ نحن مثل الماء ، كان مزاجه % كما صفق الساقي الرحيق المشعشعا % % 6(@)(@@) % وإذ لا نطيع العاذلين ، ولا نرى % % لواش لدينا يطلب الصرم مطمعا % % 7(@)(@@) % تنوعتن حتى عاود القلب سقمه ، % وحتى تذكرت الحديث المودعا % % 8(@)(@@) % فقلت لمطريهن : ويحك ! إنما % % ضررت فهل تسطيع نفعا فتنفعا ؟ % 9(@)(@@) % وأشريت فاستشرى وإن كان قد صحا % % فؤاد بأمثال المها كان موزعا % % 10(@)(@@) % وهيجت قلبا كان قد ودع الصبا % % وأشياعه ف شفع عسى أن تشفعا % % PageV01P284 11(@)(@@) % لئن كان ما حدثت حقا فما أرى % % كمثل الألى أطريت في الناس أربعا % % 12(@)(@@) % فقال : تعال انظر ، فقلت : وكيف لي ؟ % أخاف مقاما أن يشيع فيشنعا % % 13(@)(@@) % فقال : كتفل ثم لتثم فأت باغيا % فسلم ولا تكثر بأن تتورعا % % 14(@)(@@) % فإني سأخفي العين عنك فلا ترى % % مخافة أن يفشو الحديث ، فيسمعا % % 15(@)(@@) % فأقبلت أهوي مثل ما قال صاحبي % % لموعده أزجي قعودا موقعا % % 16(@)(@@) % فلما توافقنا ، وسلمت ، أشرقت % % وجوه زهاها الحسن أن تتقنعا % % 17(@)(@@) % تبالهن ب لعرفان لما رأينني % % وقلن : امرؤ باغ أكل وأوضعا ! % 18(@)(@@) % وقربن أسباب الصبا لمتيم % يقيس ذراعا كلما قسن إصبعا % % 19(@)(@@) % فلما تنازعن الأحاديث ، قلن لي : % أخفت علينا أن نغر ونخدعا 
ms68	 ؟ % 20(@)(@@) % فب لأمس أرسلنا بذلك خالدا % إليك وبينا له الشأن أجمعا % % PageV01P285 21(@)(@@) % فما جئتنا إلا على وفق موعد ، % على ملإ منا خرجنا له معا % % 22(@)(@@) % رأينا خلاء من عيون ومجلسا % دميث الربى ، سهل المحلة ، ممرعا % % 23(@)(@@) % وقلنا : كريم نال وصل كرائم ، % فحق له في اليوم أن يتمتعا % % PageV01P286 البحر : طويل 1(@)(@@) % غشيت بأذناب المغمس منزلا % به للتي نهوى مصيف ومربع % 2(@)(@@) % مغاني أطلال ، ونؤيا ، ودمنة ، % أضر بها وبل ونكباء زعزع % 3(@)(@@) % بخبت حليات كأن رسومها % % كتاب زبور في عسيب مرجع % 4(@)(@@) % فهاج عليك الشوق رسم معطل ، % أحال زمانا ، فهو بيداء بلقع % 5(@)(@@) % فإن يقو مغناه ، فقد كان حقبة % أنيسا به حور المدامع روع % 6(@)(@@) % ليالي إذ أسماء رؤد كأنها % % خلي بذي المسروح أدماء متبع % % 7(@)(@@) % لها رشأ تحنو عليه بجيدها % % أغن أجم المقلتين مولع % 8(@)(@@) % إذا فقدته ساعة عند مرتع ، % تراها عليه بالبغام تفجع % % 9(@)(@@) % تكاد عليه النفس منها مخافة % عليه الذئاب العاديات تقطع % % 10(@)(@@) % يذكرنيها كل تغريد قينة % وقمرية ظلت على الأيك تسجع % PageV01P287 11(@)(@@) % يجاوبها ساق هتوف لدى الضحى % % على غصن أيك بالبكاء يروع % % 12(@)(@@) % لقد خلعت في أخذها بردائه % جهارا وما كانت بعهدي تخلع % 13(@)(@@) % ومدت لدى البيت العتيق بثوبه % نهارا ، فما يدري بها كيف يصنع % % 14(@)(@@) % يظل إذا أجمعت صرما مباينا % دخيل لها في أسود القلب يشفع % % 15(@)(@@) % تذكرت إذ قالت غداة سويقة % ومقلتها من شدة الوجد تدمع % % 16(@)(@@) % لأترابها : ليت المغيري إذ دنت % به داره منا أتى فيودع % 17(@)(@@) % فما رمتها ، حتى دخلت فجاءة % عليها وقلبي عند ذاك يروع % 18(@)(@@) % فقلن حذاره العين لما رأينني % % لها ، إن هذا الأمر أمر مشنع % 19(@)(@@) % فلما تجلى الروع عنهن قلن لي : % هلم ، فما عنها لك اليوم مدفع % % 20(@)(@@) % فظلت بمرأى شائق وبمسمع ، % ألا حبذا مرأى هناك ومسمع ! % PageV01P288 البحر : طويل 1(@)(@@) % لقد حببت نعم إليها بوجهها % % مسافة ما بين الوتائر فالنقع % 2(@)(@@) % ومن أجل ذات الخال أعملت ناقتي % % أكلفها سير الكلال مع الظلع % 3(@)(@@) % ومن اجل ذات الخال يوم لقيتها % % بمندفع 
ms69	 الاخباب ، سابقني دمعي % % 4(@)(@@) % ومن اجل ذات الخال آلف منزلا ، % تحل به لا ذا صديق ولا زرع % 5(@)(@@) % ومن أجل ذات الخال عدت كأنني % % مخامر داء داخل وأخو ربع % 6(@)(@@) % ألم تر ذات لخال أن مقالها % % لدى الباب ، زاد القلب ردعا على ردع % % 7(@)(@@) % وأخرى لدى البيت العتيق نظرتها % % إليها تمشت في عظامي وفي سمعي % % 8(@)(@@) % فما انس ملأشياء لا أنس نظرتي % % إليها وتربيها ونحن لدى سلع % PageV01P289 البحر : طويل 1(@)(@@) % وقالت لتربيها غداة لقيتها ، % ومقلتها بالماء ، والكحل ، تدمع : % 2(@)(@@) % بذي الشري هل من موقف تقفانه % لعل المغيري الغداة يودع % 3(@)(@@) % فلما رأت كبراهما ما بأختها % % أرمت فما تعطي ولاع هي تمنع % 4(@)(@@) % وقال لها الصغرى : هداك لما رأى % % هوى غير معصي ، ولب مشيع % % 5(@)(@@) % أيخفى على ظهر وقوف مطية % براكبها ؟ هذا من الأمر أشنع ! % PageV01P290 البحر : طويل 1(@)(@@) % أقول لأسماء اشتكاء ، ولا أرى ، % على أثر شيء قد تفاوت ، مجزعا : % 2(@)(@@) % ألم تعلمي ، يا أسم ، أني مغاضب % أحب جميع الناس لو جمعوا معا ؟ % 3(@)(@@) % وأن الليالي طلن منذ هجرتني ، % وكن قصارا قبل أن نتصدعا ؟ % 4(@)(@@) % وأن لم نزل منذ هتجرنا كأنني % % معاد فراشي ، ما ألايم مضجعا ؟ % PageV01P291 البحر : طويل 1(@)(@@) % أربت إلى هند وتربين ، مرة ، % لها ، إذ توافقنا بقرن المقطع % 2(@)(@@) % لتعريج يوم أو لتعريس ليلة % علينا بجمع الشمل قبل التصدع % 3(@)(@@) % فقلن لها : لولا رتقاب صحابة % لنا خلفنا ، عجنا ولم نتورع % % 4(@)(@@) % فقالت فتاة ، كنت أحسب أنها % % مغفلة ، في مئزر لم تدرع % % 5(@)(@@) % لهن وما شاورنها ليس ما أرى % % بحسن جزاء للحبيب المودع % % 6(@)(@@) % فقلن لها : لا شب قرنك ف فتحي % % لنا بابة تخفي من الأمر نسمع % 7(@)(@@) % فقالت لهن : الأمر باد طريقه ، % مبين لذي لب ينوء بمرجع % 8(@)(@@) % نقدم من يخشى فيمضي أمامنا ، % ومن خفت من أصحاب رحلك فارجعي % % 9(@)(@@) % وأوصي غلاما بالوقوف بجانب ال % % ستار ، خفيا شخصه ، يتسمع % % 10(@)(@@) % فإن ير مما يتقى غير رقبة % علينا ، يعجل ما استطاع ويسرع % % PageV01P292 البحر : طويل 1(@)(@@) % ألا من يرى رأي امرىء ذي قرابة 
ms70	 ، % أبت نفسه ب لبغض إلا تطلعا % % 2(@)(@@) % وما ذاك من شيء أكون جتنيته % إليك وما حاولت سوءا فيمنعا % % 3(@)(@@) % وكان ابن عم المرء مثل مجنه ، % يقيه ، إذا لاقى الكمي المقنعا % % 4(@)(@@) % إذا ما ابن عم المرء أفرد ركنه ، % وإن كان جلدا ذا عزاء تضعضعا % % 5(@)(@@) % فنصرك أرجو ، لا العداوة ، إنما % % أبوك أبي ، وإنما صفقنا معا % % 6(@)(@@) % وإن كان للعتبى ، فأهل قرابة ، % وإن كان هذا لانتقاص ، فمصرعا % % 7(@)(@@) % فهذا عتاب وازدجار ، فإن يعد % وجدك ، أدرك ما تسلفت أجمعا % % 8(@)(@@) % فإن يوسر المولى فإنك حاسد % وإن يفتقر لا يلف عندك مطمعا % % 9(@)(@@) % وإن هو يظلم لا تدافع بحجة % وإن هو يظلم قلت جنبك أضرعا % % PageV01P293 البحر : طويل 1(@)(@@) % يا قلب أخبرني وفي النأي راحة % إذا ما نوت هند نوى : كيف تصنع ؟ % 2(@)(@@) % أتجمع يأسا ، أم تحن صبابة ، % على إثر هند ، حين بانت ، وتجزع ؟ % 3(@)(@@) % وللصبر خير ، حين بانت بودها ، % وزجر فؤاد كان للبين يخشع % 4(@)(@@) % وقد قرعت في وصل هند لك العصا % % قديما كما كانت لذي الحلم تقرع % 5(@)(@@) % جزعت وما في فجع هند بسرها % % وإفشاء سر كان نحوي تجزع % 6(@)(@@) % ولكن على أن يعلم الناس أنني % % على غير شيء من نوالك أتبع % 7(@)(@@) % فلا تحرمي نفسا عليك مضيقة % وقد كربت من شدة الوجد تطلع % 8(@)(@@) % وليس بحب غير حبيك لذة % % ولست بشخص بعد شخصك أجزع % % 9(@)(@@) % وليس خليلي ب لمرجى وصاله % وليس لسري عند غيري موضع % % PageV01P294 البحر : طويل 1(@)(@@) % طمعت بأمر ليس لي فيه مطمع % فأخلفني ، فالعين من ذاك تدمع % 2(@)(@@) % وباعدني من لا أحب بعاده % فنفسي عليه كل حين تقطع % 3(@)(@@) % وقد كنت أرجو أن تجود بنائل % فألفيتها ب لبذل لا تتطوع % 4(@)(@@) % فوا كبدي من خشية البين بعدما % % رجوت نوالا من عثيمة ينفع % % 5(@)(@@) % فقد تركتني ما ألذ لخلة % حديثا ، ونفسي نحوها تتطلع % % PageV01P295 البحر : كامل تام 1(@)(@@) % إن الخليط مع الصباح تصدعوا % % ف لقلب مرتهن بزينب موجع % 2(@)(@@) % أشكو إلى بكر وقد جزعت بها % % بغلاتها خوص النواصف ترفع % 3(@)(@@) % قالوا 
ms71	 بمر اليوم ، ثم مبيتهم % % ضحيان أو عسفان إن هم أسرعوا % % 4(@)(@@) % حتى إذا جسروا بصارع كلها ، % وبدا لهم منها طريق مهيع % 5(@)(@@) % فأتيتهم عند العشاء مخاطرا % حذر الانيس ، وليس شيئا يسمع % % 6(@)(@@) % أقبلت أخفي مشيتي متقنعا % وأخو الخفاء إذا مشى يتقنع % 7(@)(@@) % فأتيت حين تضجعوا بعد الونى % % من سيرهم ، أو قبل أن يتضجعوا % % 8(@)(@@) % فإذا ثلاث بينهن عقيلة % مثل الغمامة ، نشرها يتضوع % % 9(@)(@@) % فعرفت صورتها ، وليس بمنكر % أحد شعاع الشمس ساعة تطلع % 10(@)(@@) % قالت : نشدتك ، يا لباب ، ألم يكن % كبر المنى ، وبه حديثي أجمع ؟ % PageV01P296 11(@)(@@) % قالت : بلى ، فعجبت ، حين لقيتها ، % من قولها : ليت النوى بك تجمع % PageV01P297 البحر : كامل تام 1(@)(@@) % ناد الذين تحملوا كي يربعوا % % كي ما يودع ذو هوى ويودع % 2(@)(@@) % ما كنت اخشى ، بعدما قد اجمعوا ، % وفراقهم ب لكره أن لا يربعوا % % 3(@)(@@) % أن يفجعوا دنفا مصابا قلبه % % من حبهم في كل يوم يردع % 4(@)(@@) % حتى رأيت حمولهم ، وكأنها % % نخل تكفكفها شمال زعزع % 5(@)(@@) % وأقول من جزع لعزة ، بعدما % % ساروا وسال بهم طريق مهيع % 6(@)(@@) % لو كنت أملك دفع ذا لدفعته % عني ، ولكن ما لهذا مدفع % % 7(@)(@@) % لما تذاكرنا وقد كادت بهم % يزل الجمال ببطن قرن تطلع % % 8(@)(@@) % تهوي بهن ، إذا الحداة ترنموا % % مورا كما مار السفين المقلع % 9(@)(@@) % سلمت ، فالتفتت بوجه واضح ، % كالبدر زين ذاك جيد أتلع % % 10(@)(@@) % وبمقلتي ريم غضيض طرفه ، % أضحى له برياض مر مرتع % % PageV01P298 11(@)(@@) % قالت : تشيعنا ، فقلت صبابة : % إن المحب لمن يحب مشيع % 12(@)(@@) % ف سترجعت وبكت لما قد غالها % % إن الموفق ف علموا مسترجع % 13(@)(@@) % فتبعتهم ، ومعي فؤاد موجع ، % صب بقربهم ، وعين تدمع % % PageV01P299 البحر : كامل تام 1(@)(@@) % ومشاحن ذي بغضة ، وقرابة ، % يزجي لأقربه عقارب لسعا % % 2(@)(@@) % يسعى ليهدم ما بنيت ، وإنني % % لمشيد بنيانه المتضعضعا % % 3(@)(@@) % وإذا سررت ، يسوءه ما سرني ، % ويرى المسرة مروتي أن تقرعا % % 4(@)(@@) % وإذا عثرت ، يقول : إني شامت ، % وأقول ، حين أراه يعثر : دعدعا % % PageV01P300 البحر : بسيط تام 1(@)(@@) % إذهب ، وقل للتي لامت ، وقد علمت % % إن لم تنل في ثوابي طائلا 
ms72	 تدع % 2(@)(@@) % بعض الملامة في أن لا أصاحبها % % كيما تدارك أمرا غير مرتجع % % 3(@)(@@) % لا ترحليني بذنب أنت صاحبه % وصادقيني صفاء الود و ستمعي % % 4(@)(@@) % لا تسمعن بنا قول الوشاة ، ومن % يطع مقالة واش كاشح يضع % 5(@)(@@) % ليس الخديعة من سري ومن خلقي % % وإن يشار بأدنى الأمر ، يمتنع % % PageV01P301 البحر : خفيف تام 1(@)(@@) % أصبح القلب للقتول صريعا ، % مسهاما ، بذكرها ، مردوعا % % 2(@)(@@) % سلبتني عقلي غداة تبدت % بين خودين ك لغزالين ريعا % % 3(@)(@@) % وهي كالشمس إذ بدت في ضحاها % % فأبانت للناظرين طلوعا % % 4(@)(@@) % فرمتني بسهمها ، ثم دلفت % لبنات الفؤاد سما نقيعا % % 5(@)(@@) % لمت قلبي في حبها ، فعصاني ، % ولقد كان لي زمانا مطيعا % % 6(@)(@@) % فأرى القلب ، قد تنشب فيه % % حب هند فما يريد نزوعا % % 7(@)(@@) % قاده الحين نحوها ، فأتاها % % غير عاص إلى هواها سريعا % % 8(@)(@@) % قلت ، لما تخلس الوجد عقلي ، % لسليمى دعي رسولا مريعا % % 9(@)(@@) % فابعثيه ، فأخبريه بعذري ، % و شفعي لي فقد غنيت شفيعا % % 10(@)(@@) % عند هند ، وذاك عصر تولى ، % بان منا ، فما يريد رجوعا % % PageV01P302 11(@)(@@) % فأتتها فأخبرتها بعذري % % ثم قالت : أتيت أمرا بديعا % % 12(@)(@@) % فاقبلي العذر ، مت قبلك ، منه ، % وهي تذري لم عناها الدموعا % % 13(@)(@@) % فأصاخت لقولها ثم قالت % عاد هذا من الحديث رجيعا % % 14(@)(@@) % ارجعي نحوه فقولي : وعيشي % % لا تهنأ ، بما فعلت ، ربيعا ! % 15(@)(@@) % خلت أنا نغير الوصل منا % % عنك أم خلت حبلنا مقطوعا ؟ % 16(@)(@@) % فأتتني فأخبرتني بأمر % شف جسمي وطار قلبي مروعا % % 17(@)(@@) % فرجعت الرسول بالعذر مني ، % نحو هند ولم أخف أن تريعا % % 18(@)(@@) % فحيينا بودها ، بعد يأس ، % من هواها فعاد ودا جميعا % % PageV01P303 البحر : منسرح 1(@)(@@) % قرب جيراننا جمالهم % ليلا ، فاضحوا معا قد اندفعوا % % 2(@)(@@) % ما كنت ادري بوشك بينهم % حتى رأيت الغداة قد طلعوا % % 3(@)(@@) % على مكصين من جمالهم ، % وعنتريسين فيهما شجع % 4(@)(@@) % قد كاد قلبي والعين تبصرهم % لما تواروا بالغور ، ينصدع % % 5(@)(@@) % يا قلب ، صبرا ، فإنه سفه % بالمرء أن يستفزه الجزع % % 6(@)(@@) % ما ودعونا كما زعمت ولا % من بعد أن فارقوا ، لنا طمع % % 7(@)(@@) % هل يبلغنها السلام أقربها % % عني 
ms73	 وإن يفعلوا فقد نفعوا % % 8(@)(@@) % ما إن أردنا وصال غيرهم % ولا قطعناهم كما قطعوا % % 9(@)(@@) % ولا ضننا عنهم بنائلنا % % ولا خشينا التي بها وقعوا % % 10(@)(@@) % حتى جفونا ونحن نتبعهم % أليس ، بالله ، بئس ما صنعوا ؟ % PageV01P304 البحر : وافر تام 1(@)(@@) % ألا يا أيها الواشي بهند % أضري رمت أم حاولت نفعي ؟ % 2(@)(@@) % أقلت الرشد صرم حبال هند % ما أن ما أتيت به ببدع % 3(@)(@@) % أتأمر بالفجيعة ذا صفاء % كريم الوصل لم يهمم بفجع ! % 4(@)(@@) % وأقعد بعد قطع الحبل أدعو % % إلى صلة وقطع الحبل صنعي ؟ % PageV01P305 البحر : وافر تام 1(@)(@@) % أيا من كان لي بصرا وسمعا % وكيف الصبر عن بصري وسمعي ؟ % 2(@)(@@) % يجن بذكرها أبدا فؤادي % % يفيض كما يفيض الغرب دمعي % % 3(@)(@@) % يقول العاذلون نأت فدعها % % وذلك حين تهيامي وولعي % % 4(@)(@@) % أأهجرها ، وأقعد لا أراها ، % وأقطعها وما همت بقطعي % % 5(@)(@@) % وأقسم ، لو حلمت بهجر هند ، % لضاق بهجرها في النوم ذرعي % % PageV01P306 البحر : رمل تام 1(@)(@@) % يا خيليل ، إذا لم تنفعا ، % فدعاني اليوم من لوم دعا % % 2(@)(@@) % وألما بي بظبي شادن ، % لست أدري اليوم ماذا صنعا % % 3(@)(@@) % قد جرى ب لبين منها طائر % رف بالفرقة ثم آرتفعا % % 4(@)(@@) % سألتني : هل تركت اللهو أم % ذهبت أزمانه ف نقطعا % % 5(@)(@@) % قلت : لا بل ذهب الدهر الذي % % كنت أسعى معه حيث سعى % % 6(@)(@@) % ذاك إذ نحن وسلمى جيرة % لا نبالي من وشى ، أو سمعا % % 7(@)(@@) % لو سعى من فوقها ، من خلقه ، % بيننا بالصرم شتى ، ومعا % % 8(@)(@@) % كان قصدي عندها ، في قولهم ، % أن أكون المكرم المتبعا % % 9(@)(@@) % حين قالت : كيف أسلو بعدما % % سمع اليوم بنا من سمعا % % PageV01P307 البحر : مجزوء الرمل 1(@)(@@) % علق القلب وزوعا % % حب من لم يستطيعا % % 2(@)(@@) % علق الشمس فأضحت % أوجه الناس جميعا % % 3(@)(@@) % ودعاه الحين ف نقا % % د إلى الحين سريعا % % 4(@)(@@) % ثم أبصرت التي زا % % دت على الشمس بروعا % % 5(@)(@@) % وترى النسوان إن قا % % مت وإن قمن خشوعا % % 6(@)(@@) % كخضوع النجم للشم % % س ، إذا رامت طلوعا % % 7(@)(@@) % ولقد قلت على فو % ت وكفكفت الدموعا % % 8(@)(@@) % جزعا ، ليلة 
ms74	 مرت % بي وما كنت جزوعا % % 9(@)(@@) % أسفرت ليلة ودان ، % ن حذارا أن تروعا % % 10(@)(@@) % قلب محزون بها ما % % زل مختلا وجيعا % % PageV01P308 11(@)(@@) % فأرته وارد النب % % ت ومنتصا تليعا % % 12(@)(@@) % وثنايا يكرع المل % هوف فيهن كروعا % % 13(@)(@@) % يوم حلت ، من سوا % % د القلب ، محتلا رفيعا : % 14(@)(@@) % هل رأيت الركب ، أو % صرت بالقاع هجوعا % % 15(@)(@@) % قال : لم أعرف ، وقد % % أبصرت عيسا وقطوعا % % 16(@)(@@) % قلت : اذهب ف عترفهم % ثم أدركنا جميعا % % 17(@)(@@) % قف على الركب فسلم % ثم أدركنا سريعا % % 18(@)(@@) % فلقد كنت قديما ، % لهوى النفس تبوعا % % PageV01P309 البحر : مديد تام 1(@)(@@) % إن همي قد نفى النوم عني ليت شعري هل أقولن لركب % بفلاة هم لديها هجوع % 2(@)(@@) % طالما عرستم ، فاركبوا بي ، % حان من نجم الثريا طلوع % 3(@)(@@) % إن همي قد نفى النوم عني ، % وحديث النفس قدما ولوع % 4(@)(@@) % قال لي فيها عتيق مقالا ، % فجرت مما يقول الدموع % 5(@)(@@) % قال لي : ودع سليمى ، ودعها ، % فأجاب القلب أن لا أطيع % 6(@)(@@) % لا شفاني الله منها ولكن % زيد في القلب عليها صدوع % 7(@)(@@) % لاتلمني في اشتياقي إليها ، % وابك لي مما تجن الضلوع % % PageV01P310 البحر : سريع 1(@)(@@) % قالت وعيناها تجودانها : % صوحبت والله لك الراعي ! % 2(@)(@@) % يا ابن سريج ، لا تذع سرنا ، % قد كنت عندي غير مذياع % % PageV01P311 البحر : طويل 1(@)(@@) % أيا رب لا آلو المودة جاهدا % لأسماء ، فاصنع بي الذي أنت صانع % PageV01P312 البحر : وافر تام 1(@)(@@) % وخل كنت عين النصح منه % إذا نظرت ومستمعا مطيعا % % 2(@)(@@) % أطاف بغية فنهيت عنها % % وقلت له : أرى أمرا شنيعا % % 3(@)(@@) % أردت رشاده جهدي فلما % % أبى وعصى ، أتيناها جميعا % % PageV01P313 البحر : طويل 1(@)(@@) % أرائحة حجاج عذرة وجهة % ولما يرح في القوم جعد بن مهجع % 2(@)(@@) % خليلان نشكو ما نلاقي من الهوى % % متى ما يقل ، أسمع ، وإن قلت يسمع % % 3(@)(@@) % ألا ليت شعري ، أي شيء أصابه ، % فلي زفرات هجن ما بين أضلعي % % 4(@)(@@) % فلا يبعدنك الله خلا فإنني % % سألقى كما لاقيت في كل مصرع % PageV01P314 البحر : متقارب تام 1(@)(@@) % وإني لسائل أم الربيع ، % ع قبل الوداع متاعا طفيفا 
ms75	 % % 2(@)(@@) % متاعا ، اقوم به للوداع ، إني % % ع إني أرى الدار منها قذوفا % % 3(@)(@@) % فقالت : بحاجة كل نطقت % فأقبل وأرسل رسولا لطيفا % % 4(@)(@@) % إلى موعد ود لو أنه % % خلا ، لا يروع فيه الطروفا % % 5(@)(@@) % ومن عجب ضحكت إذ رأت % قريبة ب لخيف ركبا وقوفا % % 6(@)(@@) % رأت رجلا شاحبا جسمه % مساري أرض أطال الوجيفا % % 7(@)(@@) % أخا سفر لا يجم المطي ، % بعد الكلالة ، إلا خفوفا % % 8(@)(@@) % فإما تريني كساني السفار % لون السواد ، وجسما نحيفا % % 9(@)(@@) % فحورا كمثل ظباء الخري % % ف أخرجن يمشين مشيا قطوفا % % 10(@)(@@) % تضوع أردانهن العبير والرن % % ر والرند خالط مسكا مدوفا % % PageV01P315 11(@)(@@) % يهيجن من بردات القلوب % % شوقا ، إذا ما ضربن الدفوفا % % 12(@)(@@) % إذا ما انقضى عجب ، لم يزلن % يدعون للهو قلبا ظريفا % % 13(@)(@@) % بأبطح سهل سقاه السحا % % ب إما ربيعا وإما خريفا % % PageV01P316 البحر : طويل 1(@)(@@) % ولو كان يخفى الحب سوما ، خفي لنا ، % ولكنه والله ، يا حب ، ما يخفى % % 2(@)(@@) % ولكن عدمت الحب إن كان هكذا ، % إذا ما أحب المرء كان له حتفا % % 3(@)(@@) % فما استجملت نفسي حديثا لغيرها ، % وإن كان لحنا ، ما تحدثنا خلفا % % 4(@)(@@) % ولا ذكرت يا صاح إلا وجدتها % % بودي ، وإلا زاد حبي لها ضعفا % % 5(@)(@@) % ولا أبصرت عيناي في الناس عاشقا ، % صبا صبوة إلا صبوت لها ألفا % % 6(@)(@@) % فما عدلت في الحكم يا صاح بيننا ، % أفي العدل منها أن نحب وأن نجفى % % PageV01P317 البحر : مجزوء الرجز 1(@)(@@) % هاج فؤادي موقف % ذكرني ما أعرف % 2(@)(@@) % ممشاي ذات ليلة ، % والشوق مما يشغف % 3(@)(@@) % إذا ثلاث كالدمى ، % وكاعب ومسلف % 4(@)(@@) % وبينهن صورة ، % ك لشمس حين تسدف % 5(@)(@@) % خود ، وقير نصفها ، % ونصفها مهفهف % % 6(@)(@@) % قلت لها : من أنتم ؟ % لعل دارا تسعف % % 7(@)(@@) % ف بتسمت عن واضح % غر الثنايا ، ينطف % % 8(@)(@@) % وأومضت عن طرفها % % يا حسنها ، إذ تطرف ! % 9(@)(@@) % وأرسلت فجاءني % % بنانها المطرف % % 10(@)(@@) % أن بت لدينا ليلة % نحيي بها ونلطف % PageV01P318 11(@)(@@) % باتت ولي من بذلها % % حمش اللثات ، أعجف % % 12(@)(@@) % فبت ليلي كله % ترشفني ، وأرشف % 13(@)(@@) % إخال ثلجا طعمه % قد خالطته قرقف % % 14 
ms76	(@)(@@) % لما دنا تقارب % من ليلنا ومصرف % 15(@)(@@) % قالت لنا ، ودمعها % % وجدا علينا يذرف : % 16(@)(@@) % لهفي ! وليس نافعي % % عليكم التلهف ! % 17(@)(@@) % قالت : ولم تسألنا % % والدار عنك تصرف % % 18(@)(@@) % والدار عنك غربة ، % ونأينا مستشرف % % 19(@)(@@) % نحن حجيج ضمنا ، % فمن يرى المعرف % 20(@)(@@) % قلت : فإني هائم % صب بكم مكلف % % PageV01P319 21(@)(@@) % قالت : بل انت مازح ، % ذو ملة ، مستطرف % % 22(@)(@@) % لسنا وإن حدثتنا % % يغرنا ما تحلف % 23(@)(@@) % وددت لو انك في % % قولك هذا تنصف % 24(@)(@@) % تجزي بمثل ودنا % % قلت لها : بل أضعف % % PageV01P320 البحر : طويل 1(@)(@@) % أفي رسم دار دارس أنت واقف % بقاع تعفيه الرياح العواصف % 2(@)(@@) % بها جازت الشعثاء فالخيمة التي % % قفا محرض كأنهن صحائف % % 3(@)(@@) % سحا تربها أرواحها فكأنما % % أحال عليها بالرغام النواسف % % 4(@)(@@) % وقفت بها لا من أسائل ناطق ، % ولا أنا إن لم ينطق الرسم صارف % 5(@)(@@) % ولا أنا عمن يألف الربع ذاهل % ولا التبل مردود ولا القلب عازف % 6(@)(@@) % ولا أنا ناس مجلسا زارنا به % عشاء ثلاث كاعبان وناصف % 7(@)(@@) % أسيلات أبدان دقاق خصورها % % وثيرات ما التفت عليه الملاحف % 8(@)(@@) % إذا قمن ، أو حاولن مشيا تأطرا ، % إلى حاجة مالت بهن الروادف % 9(@)(@@) % نواعم لم يدرين ما عيش شقوة % ولا هن نمات الحديث زعانف % 10(@)(@@) % إذا مسهن الرشح أو سقط الندى % % تضوع بالمسك السحيق المشارف % % PageV01P321 11(@)(@@) % يقلن إذا ما كوكب غار : ليته % بحيث رأيناه عشاء يخالف % 12(@)(@@) % لبثنا به ليل التمام بلذة ، % نعمنا به حتى جلا الصبح كاشف % 13(@)(@@) % فلما هممنا بالتفرق ، أعجلت % بقايا البانات الدموع الذوارف % 14(@)(@@) % وأصعدن في وعث الكثيب تأودا ، % كما جتاز في الوحل النعاج الخوارف % 15(@)(@@) % فأتبعتهن الطرف ، متبل الهوى ، % كأني يعانيني من الجن خاطف % 16(@)(@@) % تعفي على الآثار ، أن تعرف الخطى ، % ذيول ثياب يمنة ومطارف % 17(@)(@@) % دعاه إلى هند تصاب ونظرة % تدل على أشياء فيها متالف % 18(@)(@@) % سبته بوحف في العقاص ، كأنه % عناقيد دلاها من الكرم قاطف % 19(@)(@@) % وجيد خذول بالصريمة ، مغزل ، % ووجه حمي أضرعته المخالف % % 20(@)(@@) % فكل الذي قد قلت يوم لقيتكم % على حذر الأعداء ، للقلب شاغف 
ms77	 % % PageV01P322 21(@)(@@) % وحبك داء للفؤاد مهيج % سفاها إذا ناح الحمام الهواتف % 22(@)(@@) % ونشرك شاف للذي بي من الجوى ، % وذكرك ملتذ ، على القلب طارف % % 23(@)(@@) % وقربك إن قاربت للشمل جامع % وإن بنت يوما بان من أنا آلف % 24(@)(@@) % فإن راجعته في التراسل ، لم يزل % له من أعاجيب الحديث طرائف % % 25(@)(@@) % وإن عاتبته مرة ، كان قلبه % لها ضلعه حتى تعود العواصف % % 26(@)(@@) % فكل الذي قد قلت كان دكاره % على القلب قرحا ينكأ القلب ، قارف % % 27(@)(@@) % أثيبي ابنة المكني عنه بغيره ، % وعنك سقاك الغاديات الروادف % 28(@)(@@) % على أنها قالت لأسماء : سلمي % % عليه ، وقولي : حق ما أنت خائف % % 29(@)(@@) % أرى الدار قد شطت بنا عن نوالكم % نوى غربة ، فانظر لأي تساعف % % 30(@)(@@) % فقلت : أجل لا شك قد نبأت به % ظباء جرت ، فاعتاف من هو عائف % % PageV01P323 31(@)(@@) % فقالت لها : قولي : ألست بزائر % بلادي وإن قلت هناك المعارف % 32(@)(@@) % كما لو ملكنا أن نزور بلادكم % فعلنا ولم تكثر علينا التكالف % 33(@)(@@) % فقلت لها : قولي لها : قل عندنا % % لنا جشم الظلماء فيما نصادف % 34(@)(@@) % ونصي إليك العيس ، شاكية الوجى % % مناسمها مما تلاقي رواعف % 35(@)(@@) % براهن نصي والتهجر كلما % % توقد مسموم من اليوم صائف % % 36(@)(@@) % تحسر عنهن العرائك ، بعدما % % بدأن وهن المقفرات العلائف % 37(@)(@@) % وإني زعيم أن تقرب فتية % إليك معيدات السفار ، عواطف % % PageV01P324 البحر : متقارب تام 1(@)(@@) % لقد أرسلت حولا قلبا % يرى جافيا وهو خب لطيف % 2(@)(@@) % إلينا عشاء بأن قف لنا % % نسلم ، فإن وقوفا طفيف % 3(@)(@@) % فقلت لها : البيت أخلى لنا ، % فإن مقام الفجاج الحتوف % 4(@)(@@) % فقالت : صدقت ، ولكنني % % أخاف العداة ، ومشيي قطوف % % PageV01P325 البحر : رمل تام 1(@)(@@) % لإتني ، إن كنت ثقفا شاعرا ، % عن فتى أعوج ، اعمى ، مختلف % 2(@)(@@) % سيىء السحنة ، كاب لونه ، % مثل عود الخروع البالي القصف % PageV01P326 البحر : كامل تام 1(@)(@@) % بان الخليط وبينهم شغف % الدار احيانا بهم قذف % 2(@)(@@) % ما عودوك بنأي دارهم ، % قرب الجوار ، ففيم تلتهف ؟ % 3(@)(@@) % ولقد ترى أن لا يذللها % % أن الفؤاد بذكرها كلف % 4(@)(@@) % زعموا بأن البين بعد غد ، % ف لقلب مما أحدثوا 
ms78	 يجف % 5(@)(@@) % لم أنس موقفنا وموقفها ، % لتراجع ولحيننا نقف % 6(@)(@@) % نشكو وتشكو بعض ما وجدت ، % كل لوشك البين معترف % 7(@)(@@) % ومقالها ودموعها سجم : % أقلل حنينك حين تنصرف % 8(@)(@@) % عنا ، إذا دار بكم نزحت % ودعا لأخرى قلبك الطرف % % 9(@)(@@) % حلفوا ، لقد قطعوا ببينهم % وحلفت ألفا مثلما حلفوا % % PageV01P327 البحر : طويل 1(@)(@@) % لقد عجت في رسم أجد زمانه % % لنا ، دارس ما كان غير التواقف % 2(@)(@@) % عشية قالت : قد أشاد بسرنا % % وسركم مجرى الدموع الذوارف % 3(@)(@@) % فقلت لها : إني أرى بكم النوى % % عنوجا متى نرجو قتراب المخالف % 4(@)(@@) % فلما تواقفنا ، تحير حولها % % نواعم ك لغزلان بيض السوالف % 5(@)(@@) % وثيرات أعجاز ، دقاق خصورها ، % طويلات أعناق ، ثقال الروادف % % 6(@)(@@) % يطفن بها مثل الدمى بين سافر % إلينا ، ومستحي رآنا ، فصارف % % 7(@)(@@) % وجاءت بتباع لها بين منكر % لموقفنا ، لو يستطيع ، وعارف % PageV01P328 البحر : رمل تام 1(@)(@@) % ذات حسن إن تغب شمس الضحى % % فلنا من وجهها عنها خلف % 2(@)(@@) % أجمع الناس على تفضيلها % % وهواهم في سوى هذا ختلف % PageV01P329 البحر : طويل 1(@)(@@) % وطافت بنا شمس عشاء ، ومن رأى % % من الناس شمسا بالعشاء تطوف % 2(@)(@@) % أبو أمها أوفى قريش بذمة % وأعمامها ، إما نسبت ، ثقيف % PageV01P330 البحر : طويل 1(@)(@@) % فلم تر عيني مثل سرب رأيته % خرجن علينا من زقاق بن واقف % PageV01P331 البحر : خفيف تام 1(@)(@@) % ولقد قلت يوم بانوا لبكر : % أنت ، يا بكر ، سقتنا ذا المساقا % % 2(@)(@@) % أنت قربتني إلى الحين حتى % % حمل القلب منهم ما أطاقا % % 3(@)(@@) % ولقد قلت : لا أبا لك دعني % % إن حتفي في أن أزور الرفاقا % % 4(@)(@@) % إن قصري أن يشعر القلب سقما % ما من سليمى مخامرا واشتياقا % % 5(@)(@@) % قد أرانا ولا أسر بأن تج % مع دار ، ولا نبالي الفراقا % % 6(@)(@@) % ثم ولوا وما قرابة من حل % ل بنجد ممن يحل العراقا ؟ % PageV01P332 البحر : متقارب تام 1(@)(@@) % ألم تسأل الربع أن ينطقا ، % بقرن المنازل قد أخلقا ؟ % 2(@)(@@) % ديار لتي تيمت عقله % فيا ليته غيرها علقا ! % 3(@)(@@) % وكيف طلابي عراقية ، % وقد جاوزت عيرها الخرنقا % % 4(@)(@@) % تؤم الحداة بها منزلا ، % من الطف ذا 
ms79	 بهجة مؤنقا % % 5(@)(@@) % وكيف طلابك إلا الصبا ، % وغرب النوى ، بلدا مسحقا % % 6(@)(@@) % ولو أنه إذ دعاه الصبا % % إليها أبى لم يكن أخرقا % % 7(@)(@@) % ولكنه قربته المنى ، % وسيق إلى الحين ف ستوسقا % % PageV01P333 البحر : طويل 1(@)(@@) % ألم خيال من سليمى فأرقا % % هدوءا ولم يطرق هنالك مطرقا % % 2(@)(@@) % ألم ببطحاء الكديد وصحبتي % % هجود ، فزاد القلب حزنا وشوقا % % 3(@)(@@) % فقلت لها : أهلا بكم إذ طرقتم ، % فقد زرت صبا ، يا قتيل ، مؤرقا % % 4(@)(@@) % فباتت تعاطيني عذابا حسبتها % % من الطيب ، مسكا أو رحيقا معتقا % % 5(@)(@@) % فبت قرير العين آخر ليلتي ، % ألاعب فيها واضح الجيد أعنقا % % 6(@)(@@) % فبتنا بتلك الحال إذ صاح ناطق % وبين معروف الصباح فصدقا % % PageV01P334 البحر : مجزوء الخفيف 1(@)(@@) % منع النوم ذكرة % من حبيب مفارق % 2(@)(@@) % نازح الدار عن ديارك % ري والقلب شائقي % % 3(@)(@@) % سالكات عن البلا % % سراع النواهق % % 4(@)(@@) % فيهم بحترية ، % مثل عين المعانق % 5(@)(@@) % نولي أم خالد % قبل بين الصفائق % % 6(@)(@@) % إن قلبي أخاله % عنكم غير عائق % % PageV01P335 البحر : وافر تام 1(@)(@@) % أحب لحب عبلة كل صهر % علمت به لعبلة أو صديق % 2(@)(@@) % ولولا أن تعنفني قريش ، % وقول الناصح الادنى الشقيق % 3(@)(@@) % لقلت ، إذا التقينا ، قبليني ، % ولو كنا على ظهر الطريق ! % 4(@)(@@) % فما قلب ابن عبد الله فيها ، % % PageV01P336 البحر : طويل 1(@)(@@) % فلما لتقينا ، و طمأنت بنا النوى ، % وغيب عنا من نخاف ونشفق % 2(@)(@@) % أخذت بكفي كفها ، فوضعتها % % على كبد ، من خشية البين تخفق % % 3(@)(@@) % فقالت لأتراب لها ، حين أيقنت % بما قد ألاقي : إن ذا ليس يصدق % 4(@)(@@) % فقلن : أتبكي عين من ليس موجعا % كئيبا ، ومن هو ساهر الليل يأرق ؟ % 5(@)(@@) % فقالت : أرى هذا شتياقا ، وإنما % % دعا دمع القلب الخلي التشوق % % 6(@)(@@) % فقن : شهدنا أن ذا ليس كاذبا ، % ولكنه فيما يقول مصدق % % 7(@)(@@) % فقمن لكي يخليننا ، فترقرقت % مدامع عينيها ، فظلت تدفق % % 8(@)(@@) % فقالت : أما ترحمنني لا تدعنني % % لديه ، وهو فيما علمتن أخرق % % 9(@)(@@) % فقلن : سكتي عنا ، فغير مطاعة % لهو بك منا ، فاعلمي ذاك ، أرفق % % 10(@)(@@) % فقالت : فلا تبرحن ذا الستر ، إنني % % أخاف ، ورب الناس ، منه 
ms80	 وأفرق % PageV01P337 البحر : خفيف تام 1(@)(@@) % أيها القلب ما أراك تفيق % طالما قد تعلقتك العلوق % 2(@)(@@) % هل لك اليوم ، إن نأت أم بكر % وتولت ، إلى عزاء طريق % 3(@)(@@) % من يكن من هوى حبيب قريبا % % فأنا النازح البعيد ، السحيق % 4(@)(@@) % قدر الحب بيننا ، فالتقينا ، % وكلانا إلى اللقاء مشوق % 5(@)(@@) % ف لتقينا ولم نخف ما لقينا % % ليلة الخيف ، والمنى قد تسوق % 6(@)(@@) % وجرى بينننا فقرب كلا % حول قلب اللسان رفيق % 7(@)(@@) % لا تظني أن التراسل والبذ % % ل بكل النساء عندي يليق % 8(@)(@@) % إن منهن للكرامة أهلا % والذي بينهن بون سحيق % PageV01P338 البحر : متقارب تام 1(@)(@@) % أهاجك ربع عفا مخلق ؟ % نعم ، ففؤادي مستعلق % 2(@)(@@) % لذكرة من قد نأت داره % فقلبي ، في رهنه ، موثق % 3(@)(@@) % يذكرني الدهر ما قد مضى % % من العيش ، فالعين تغرورق % 4(@)(@@) % ليالي أهلي ، وأهل التي % % دموعي بذكراهم تسبق % 5(@)(@@) % خليطان محضرنا واحد % فحبل المودى ة لا يخلق % 6(@)(@@) % لنا ولهند بجنب الغمي % % م ، مبدى ، ومنزلنا مؤنق % 7(@)(@@) % فإن يك ذاك الزمان نقضى % % فحبلك من حبلها مطلق % 8(@)(@@) % فقد عشت في ما مضى لاهيا % بها ، والوصال بنا يعلق % % PageV01P339 البحر : كامل تام 1(@)(@@) % قل للمنازل من أثيلة ، تنطق % بالجزع جزع القرن لما تخلق : % 2(@)(@@) % حييت من طلل تقادم عهده % وسقيت من صوب الربيع المغدق % 3(@)(@@) % لتذكر الزمن الذي قد فاتنا % % أيام نبتعث الرسول ونلتقي % % 4(@)(@@) % إذ أنت رؤد في الشباب ، غريرة ، % غراء خود ، ك لغزال الأخرق % 5(@)(@@) % درما المرافق ، طيب أردانها ، % جسر الحقيبة ، بادن المتنطق % 6(@)(@@) % لا شيء أحسن من أثيلة ، إذ بدت ، % وقد احزألت عيرها لتفرق % 7(@)(@@) % وإذا رنت ، نطر النزيف ، بعينها ، % فعرفت حاجتها ، وإن لم تنطق % PageV01P340 البحر : متقارب تام 1(@)(@@) % فيا ويح قلبك ، ما يستفي % % ذكر هند ، وما ان يفيقا % % 2(@)(@@) % جعلت طريقي على بابكم % وما كان بابكم لي طريقا % % 3(@)(@@) % صرمت الأقارب من أجلكم ، % وصافيت من لم يكن لي صديقا % % 4(@)(@@) % وواددت أهل موداتها % % وعاضيت فيها النصيح الشفيقا % % PageV01P341 البحر : مجزوء الوافر 1(@)(@@) % ألا ، يا بكر ، قد طرقا % % خيال هاج لي الأرقا 