ms21	 ذرى الأركان من حضن % PageV01P101 البحر : رجز تام 1(@)(@@) % موسى وهارون هما اللذان % في كتب الأخبار يوجدان % 2(@)(@@) % من ولد المهدي مهديان % قدا عنانين على عنان % 3(@)(@@) % قد أطلق المهدي لي لساني % % وشد أزري ما به حبابي % % 4(@)(@@) % من اللجين ومن العقيان % عيدية شاحطة الأثمان % 5(@)(@@) % لو خايلت دجلة بالألبان % إذا لقيل اشتبه النهران % PageV01P102 البحر : طويل 1(@)(@@) % وأكرم قبر بعد قبر محمد % نبي الهدى قبر بماسبذان % 2(@)(@@) % عجبت لكف هالت الترب فوقه % ضحا كيف لم ترجع بغير بنان % PageV01P103 البحر : طويل 1(@)(@@) % لندبك أحزان وسابق عبة % أثرن دما من داخل الجوف منقعا % % 2(@)(@@) % تجرعتها من بعد معن بموته % لأعظم منها ما احتسى وتجرعا % % 3(@)(@@) % ومن عجب أن بت بالرزء ثاويا % خلافك حتى ننطوي في الردى معا % % 4(@)(@@) % ألما بمعن ثم قولا لقبره % سقتك الغوادي مربعا ثم مربعا % % 5(@)(@@) % فيا قبر معن أول حفرة % من الأرض خطت للمساحة مضجعا % % 6(@)(@@) % ويا قبر معن كيف واريت جوده % وقد كان منه البر والبحر مترعا % % 7(@)(@@) % بلى قد وسعت الجود والجود ميت % ولو كان حيا ضقت حتى تصدعا % % 8(@)(@@) % ولما مضى معن مضى الجود وانقضى % % واصبح عرنين المكارم أجدعا % % 9(@)(@@) % وما كان إلأالجود صورة وجهه % فعاش ربيعا ثم ولى وودعا % % 10(@)(@@) % وكنت لدار الجود يا معن عامرا % وقد أصبحت قفرا من الجود بلقعا % % PageV01P104 11(@)(@@) % فتى عيش في معرفه بعد موته % كما كان بعد السيل مجراه مرتعا % % 12(@)(@@) % تمنى أناس شأوه من ضلالهم % فأصبحوا على الأذقان صرعى وظلعا % % 13(@)(@@) % تعز أبا العباس عنه ولا يكن % عزاؤك من معن بأن تتضعضعا % % 14(@)(@@) % أبى ذكر معن أن تموت فعاله % وإن كان قد لا قى حماما ومصرعا % % 15(@)(@@) % فما مات من كنت ابنه لا ولا الذي % % له مثل ما أبقى أبوك وما سعى % % PageV01P105 البحر : طويل 1(@)(@@) % لعمري لنعم الغيث أصابنا % % ببغداد من أرض الجزيرة وابله % 2(@)(@@) % فكنا كحي صبح الغيث أهله % ولم ترتحل أظعانه ورواحلة % PageV01P106 البحر : بسيط تام 1(@)(@@) % أضحى إمام الهدى المأمون مشتغلا % بالدين والناس بالدنيا مشاغيل % PageV01P107 
