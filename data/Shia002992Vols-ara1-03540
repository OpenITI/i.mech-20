ms3522	 القاسم بن محمد.(@)(@@) الكافي: ج 3، ك 3، ب 13، ح 12.(@)(@@) * وروى مضمرة، وروى عنه القاسم ابن محمد.(@)(@@) التهذيب: ج 7، ح 145 (الاستبصار:(@)(@@) ج 3، ح 257).(@)(@@) عبد العزيز بن المهتدي * روى عن أبي الحسن (عليه السلام)، وروى عنه علي بن مهزيار.(@)(@@) الكافي: ج 3، ك 5، ب 6، ح 5.(@)(@@) * وروى عن الرضا (عليه السلام)، وروى عنه إبراهيم بن هاشم.(@)(@@) الكافي: ج 5، ك 3، ب 190، ح 27.(@)(@@) والفقيه: ج 3، ح 1452.(@)(@@) وروى محمد بن أبي عبد الله رفعه عنه.(@)(@@) الكافي: ج 1، ك 3، ب 7، ح 3.(@)(@@) وروى عنه محمد بن عيسى بن عبيد.(@)(@@) التهذيب: ج 9، ح 509 (الاستبصار:(@)(@@) ج 4، ح 359).(@)(@@) * وروى عن عبد الله بن جندب، وروى إبراهيم بن هاشم.(@)(@@) الكافي: ج 1، ك 4، ب 33، ح 1.(@)(@@) * وروى عن يونس، وروى عنه أحمد ابن محمد بن عيسى.(@)(@@) الكافي: ج 3، ك 3، ب 5، ح 2.(@)(@@) * وروى عن يونس بن عبد الرحمان، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 2، ك 2، ب 56، ح 2.(@)(@@) والروضة: ح 54.(@)(@@) * وروى عن رجل، عن أبي الحسن الماضي (عليه السلام)، وروى عنه محمد ابن أحمد. الروضة: ح 461.(@)(@@) * وروى مرفوعا عن أبي عبد الله (عليه السلام)، وروى عنه أحمد بن أبي عبد الله.(@)(@@) الكافي: ج 6، ك 6، ب 126، ح 2.(@)(@@) عبد العزيز العبدي * روى عن أبي عبد الله (عليه السلام)، وروى عنه بن محبوب.(@)(@@) الكافي: ج 1، ك 4، ب 23، ح 2، و ج 6، ك 6، ب 82، ح 2، و ب 90، ح 2.(@)(@@) * وروى عن ابن أبي يعفور، وروى عنه بن محبوب. PageV11P429(@)(@@) الكافي: ج 2، ك 1، ب 126، ح 17، و ج 3، ك 3، ب 13، ح 9، و ب 62، ح 1.(@)(@@) والتهذيب: ج 1، ح 913.(@)(@@) وروى عنه الحسن بن محبوب.(@)(@@) الكافي: ج 2، ك 1، ب 198، ح 1.(@)(@@) * وروى عن حمزة بن حمران، وروى عنه ابن محبوب.(@)(@@) الكافي: ج 7، ك 3، ب 20، ح 1.(@)(@@) والتهذيب: ج 10، ح 132.(@)(@@) * وروى عن عبد الله بن أبي يعفور، وروى عنه بن محبوب.(@)(@@) الكافي: ج 1، ك 4، ب 85، ح 3، و ج 2، ك 1، ب 126، ح 15، و ج 5، ك 2، ب 159، ح 9.(@)(@@) * وروى عن عبيد بن زرارة، وروى عنه بن محبوب.(@)(@@) الكافي: ج 4، ك 3، ب 105، ح 7، و ج 5، ك 3، ب 56، ح 7، و ج 7، ك 3، ب 26، ح 
