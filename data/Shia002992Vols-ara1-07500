ms7491	 العباس.(@)(@@) التهذيب: ج 1، ح 1265.(@)(@@) * وروى عن عبد الله بن سنان.(@)(@@) الفقيه: ج 2، ح 1184، و ج 3، ح 955، و 984، و ج 4، ح 323، و 433.(@)(@@) وروى عنه العباس.(@)(@@) التهذيب: ج 4، ح 984.(@)(@@) * وروى عن غياث، وروى عنه العباس.(@)(@@) التهذيب: ج 3، ح 764.(@)(@@) * وروى عن القاسم بن الوليد.(@)(@@) الفقيه: ج 1، ح 1465.(@)(@@) * وروى عن مثنى بن عبد السلام، وروى عنه معاوية بن حكيم.(@)(@@) التهذيب: ج 1، ح 741 (الإستبصار:(@)(@@) ج 1، ح 613).(@)(@@) * وروى عن معاوية بن عمار، وروى عنه موسى بن القاسم.(@)(@@) التهذيب: ج 5، ح 94 (الإستبصار: ج 2، ح 512).(@)(@@) * وروى عن المفضل بن صالح، PageV24P323(@)(@@) وروى عنه إبراهيم بن هاشم.(@)(@@) الكافي: ج 4، ك 1، ب 36، ح 8.(@)(@@) * وروى عن منصور، وروى عنه إسماعيل بن مهران.(@)(@@) التهذيب: ج 10، ح 735 (الإستبصار:(@)(@@) ج 4، ح 1017).(@)(@@) * وروى عن ناصح المؤذن، وروى أحمد بن محمد، عن أبيه، عنه.(@)(@@) التهذيب: ج 3، ح 775.(@)(@@) * وروى عن يعقوب بن شعيب، وروى عنه العباس بن معروف.(@)(@@) التهذيب: ج 8، ح 922 (الإستبصار:(@)(@@) ج 4، ح 81).(@)(@@) * وروى عن الحلبي، وروى أحمد بن محمد، عن أبيه، عنه.(@)(@@) التهذيب: ج 3، ح 65.(@)(@@) * وروى عن السكوني، وروى أحمد، عن أبيه، عنه.(@)(@@) التهذيب: ج 6، ح 840.(@)(@@) وروى بنان، عن أبيه، عنه.(@)(@@) التهذيب: ج 6، ح 775، و ج 9، ح 340، وروى بنان بن محمد، عن أبيه، عنه.(@)(@@) التهذيب: ج 3، ح 195، و 362 (الإستبصار: ج 1، ح 1635)، و ج 5، ح 716، و 761 (الإستبصار: ج 2، ح 970)، و ج 6، ح 252، و 278، و 280، و 337، و 408، و 773 (الإستبصار: ج 3، ح 80)، و ح 909، و ج 7، ح 718، و 1921، و ج 8، ح 111، و 1185، و ج 9، ح 1299 (الإستبصار: ج 4، ح 704)، و ج 10، ح 185، و 797، و 1167.(@)(@@) وروى عنه محمد بن عيسى.(@)(@@) الكافي: ج 3، ك 1، ب 18، ح 3.(@)(@@) * وروى عن رجل، عن أبي عبد الله عليه السلام، وروى عنه معاوية بن حكيم.(@)(@@) التهذيب: ج 1، ح 1071 (الإستبصار:(@)(@@) ج 1، ح 207).(@)(@@) * وروى مرسلا.(@)(@@) الكافي: ج 3، ك 4، ب 89، ح 4.(@)(@@) * وروى عمن رواه، عن أبي عبد الله عليه السلام.(@)(@@) الفقيه: ج 4، ح 62.(@)(@@) (الأحول) * روى عن أبي جعفر عليه السلام، وروى عنه الحسن بن محبوب.(@)(@@) الكافي: ج 1، ك 4،