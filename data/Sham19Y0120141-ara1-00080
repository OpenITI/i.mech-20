ms61	(@)(@@) والبيت أول بيتين ليزيد بن الطثرية، وردا في شعره ص 49 وهما:(@)(@@) لعمري إن ابن الكميت على الوجا ... وسيري خمسا بعد خمس مكمل PageV01P212(@)(@@) لطلق الهوادي بالوجيف إذا ونى ... ذوات البقايا والعتيق الهمرجل(@)(@@) وتبدو رواية ابن الأعرابي في الطبعة لدي أوثق بناء.(@)(@)(@@)(@@)(@@) ||| AUTO 613 - الكميت(@)(@)(@@) :(@)(@@) فرس ديسم بن رومي الباهلي عند ابن الأعرابي في خيل باهلة ص 67 حيث أورد فيه قول ديسم لعمير بن الحباب:(@)(@@) فأدركه الكميت بشمري ... من الأبطال مغوار نجيب(@)(@@) والشمري المشمر.(@)(@)(@@)(@@)(@@) ||| AUTO 614 - الكراع(@)(@)(@@) :(@)(@@) فرس مشهور للعرب، أورده المرزوقي في شرح ديوان الحماسة 1/ 210 - 211 في معرض شرحه قول الحماسي يصف فرسه:(@)(@@) سليلة سابقين تناجلاها ... إذا نسبا يضمهما الكراع(@)(@@) بقوله: «هي ولد فرسين سابقين، إذا نسبا ضم مناسبهما ومناصبهما الكراع، وهو فحل كريم معروف. . . وأصل الكراع في اللغة أنف يتقدم من الجبل، فسمي هذا الفحل به لعظمه-واستطرد مؤكدا-وأما الكراع الاسم الجامع للخيل فهو غير ذا».(@)(@@) والأبيات لعبيدة بن ربيعة بن قحفان بن ناشرة بن سيار بن رزام بن مازن عند ابن الأعرابي ص 62 في خيل عمرو بن تميم، وورد الاسم عنده بدون ال في قوله:(@)(@@) سليلة سابقين تناجلاها ... يضمهما إذا نسبا كراع(@)(@@) ****(@)(@)PageV01P213(@)(@)(@@)(@@)(@@) | AUTO حرف اللام(@)(@)(@@) (32/أ)(@)(@)(@@)(@@)(@@) || AUTO 615 - اللطيم(@)(@)(@@) (¬1):(@)(@@) لفضالة بن هند الغاضري. قال حين قتل شريحا النميري:(@)(@@) جدعت أنوف الحمس يوم لقيتها ... بخير غلام من نمير بن عامر(@)(@@) نصبت له صدر اللطيم وآلة ... شراعية في كف حران ثائر(@)(@@) تركت أبا صخر كأن قميصه ... وسرباله من جوفه ثوب جازر(@)(@)(@@)(@@)(@@) || AUTO 616 - لاحق(@)(@)(@@) (¬2):(@)(@@) لغني بن أعصر. قال الكميت.(@)(@)PageV01P214(@)(@)(@@) نزائع من آل الوجيه ولاحق ... تذكرنا أحقادنا حين تصهل (¬1)(@)(@@) والوجيه أيضا فحل لهم (¬2).(@)(@)(@@)(@@)(@@) || AUTO 617 - لاحق الأصغر(@)(@)(@@) (¬3):(@)(@@) قال أبو الندى هو لبني أسد. مضى الشعر فيه في حرف العين (¬4).(@)(@)(@@)(@@)(@@) || AUTO 618 - لاحق(@)(@)(@@) (¬5):(@)(@@) للحازوق الخارجي. قالت أخته ترثيه:(@)(@@) أقلب عيني في الفوارس لا أرى ... حزاقا وعيني كالحجاة من القطر(@)(@@) ومن يغنم العام الوشيك ولاحقا ... وقتل حزاق لم يزل عالي الذكر (¬6)(@)(@@) وقال ابن الأعرابي في كتاب النوادر:(@)(@)(@@)(@@)(@@) || AUTO 619 - ولاحق أيضا 
ms62	(@)(@)(@@) (¬7):(@)(@@) لعتيبة بن الحارث بن شهاب. قال أبو الندى هذا صحيح، وهو المكسر (¬8) الذي يجيء ذكره في الكتاب.(@)(@)PageV01P215(@)(@)(@@)(@@)(@@) || AUTO 620 - لازم(@)(@)(@@) (¬1):(@)(@@) لوثيل الرياحي. قال أبو الندى هو لبشر بن عمرو بن أهيب (¬2) قال سحيم بن وثيل الرياحي:(@)(@@) وقلت لأهل الشعب إذ ييسرونني ... ألم تعلموا أني ابن فارس لازم(@)(@@) وصاحب أصحاب الكنيف كأنما ... سقاهم بكفيه سمام الأراقم(@)(@)(@@)(@@)(@@) || AUTO 621 - لبنى(@)(@)(@@) (¬3):(@)(@@) لخنيس بن الحداء (¬4) بن قرط الكلبي. قال:(@)(@@) فإن أهلك فقد أورثت خيرا ... وقد أعظمت وصل بني هلال (32/ب)(@)(@@) وقد أقدمت لبنى وسط غمر ... لتمنعهم وقد قطعوا شمالي(@)(@@) فلم أر مثلها صلة ابن أخت ... ولم أر مثلها إهداء خال(@)(@)(@@)(@@)(@@) || AUTO 622 - اللجام(@)(@)(@@) (¬5):(@)(@@) فرس لبني الهجيم بن عمرو بن تميم، أخذه بسطام بن قيس لما أغار عليهم دون زبالة (¬6).(@)(@)PageV01P216(@)(@)(@@)(@@)(@@) || AUTO 623 - اللكاع(@)(@)(@@) (¬1):(@)(@@) فارسه زيد بن عباس بن عامر بن حمي بن رعل ويقال لزيد ذو اللبدة (¬2).(@)(@)(@@)(@@)(@@) || AUTO 624 - لاحق(@)(@)(@@) (¬3):(@)(@@) فرس سعد بن زيد.(@)(@)(@@)(@@)(@@) || AUTO 625 - 626 - اللحيف ولزاز(@)(@)(@@) (¬4):(@)(@@) لرسول الله صلى الله عليه وسلم.(@)(@)(@@)(@@)(@@) || AUTO المستدركات على حرف(@)(@@) اللام(@)(@)(@@)(@@)(@@) ||| AUTO 627 - لاحق(@)(@)(@@) :(@)(@@) فرس معاوية بن أبي سفيان في القاموس المحيط (لحق) 3/ 280.(@)(@)(@@)(@@)(@@) ||| AUTO 628 - لاحق(@)(@)(@@) :(@)(@@) فرس لزيد الخيل بن مهلهل الطائي في حلية الفرسان ص 159.(@)(@)PageV01P217(@)(@)(@@)(@@)(@@) ||| AUTO 629 - لاحق الأكبر(@)(@)(@@) :(@)(@@) فرس لغني بن أعصر، ذكره ابن الكلبي في أنساب الخيل ص 32 بقوله «وكان لهم لاحق الأصغر، وهو من بنات لاحق الأكبر فرس غني بن أعصر».(@)(@)(@@)(@@)(@@) ||| AUTO 630 - لبنى(@)(@)(@@) :(@)(@@) فرس ذكرها الفيروز أبادي بلا نسبة في (لبن) 4/ 265.(@)(@)(@@)(@@)(@@) ||| AUTO 631 - اللطيم(@)(@)(@@) :(@)(@@) فرس لربيعة بن مكدم في أنساب الخيل ص 28 وفيه يقول:(@)(@@) صبرت مصادا إزاء اللطيم ... حتى كأنهما في قرن(@)(@@) خضبت به زاعبي السنان ... فويق الإزار وفوق العكن(@)(@@) والرماح الزاعبية نسبة إلى زاعب، وهي بلدة أو رجل في القاموس المحيط (زعب) 1/ 79 ولم أجدها في معجم البلدان.(@)(@@) وهو لربيعة بن مكدم في حلية الفرسان ص 153 والقاموس المحيط (لطم) 4/ 176.(@)(@)(@@)(@@)(@@) ||| AUTO 632 - اللعاب(@)(@)(@@) :(@)(@@) فرس للعرب، ورد بلا نسبة في العمدة 2/ 235 والمخصص 2/ 198 في خيل هوازن، والقاموس المحيط 
ms63	 (لعب) 1/ 128.(@)(@)(@@)(@@)(@@) ||| AUTO 633 - لماع(@)(@)(@@) :(@)(@@) فرس عباد بن بشر عند ابن الأعرابي ص 54 في خيل الأنصار، شهد عليه يوم السرح، وكذا في المخصص 2/ 194.(@)(@@) ****(@)(@)PageV01P218(@)(@)(@@)(@@)(@@) | AUTO حرف الميم(@)(@)(@@)(@@)(@@) || AUTO 634 - المتمطر(@)(@)(@@) (¬1):(@)(@@) لحيان بن مرة بن جندلة بن عمرو بن سدوس. فيه يقال:(@)(@@) ما يجعل العبد اللئيم كربه ... وما يجعل البرذون كالمتمطر(@)(@)(@@)(@@)(@@) || AUTO 635 - المدعاس(@)(@)(@@) (¬2):(@)(@@) فرس الأقرع بن حابس، ويسمى فارس المدعاس. مضى الشعر فيه في باب العين (¬3).(@)(@)(@@)(@@)(@@) || AUTO 636 - المشهور(@)(@)(@@) (¬4):(@)(@@) فرس قطبة بن شهاب الجدلي من طيىء. قال فيه:(@)(@)PageV01P219(@)(@)(@@) ولا تأمن من المشهور وقعا ... ومني في منازعتي حذار(@)(@@) إذا المشهور سامحني وضمت ... يدي المشهور فازحل عن فخاري(@)(@)(@@)(@@)(@@) || AUTO 637 - المصبح(@)(@)(@@) (¬1):(@)(@@) فرس عوف بن الكاهن السلمي. قال فيه:(@)(@@) نصبت لهم صدر المصبح بعد ما ... تدارك ركض منهم متعاجل(@)(@@) تواصوا به كي يعقروه وقد رأوا ... أخاهم على الكفين والرأس مائل(@)(@)(@@)(@@)(@@) || AUTO 638 - المعلى(@)(@)(@@) (¬2):(@)(@@) للأسعر بن أبي حمران الجعفي. وفيه يقول:(@)(@@) أريد دماء بني مازن ... وراق المعلى بياض اللبن (¬3)(@)(@@) وقال أيضا (33/أ).(@)(@@) كأن المعلى وريب المنو ... ن والحدثان به وقع فارس (¬4)(@)(@)(@@)(@@)(@@) || AUTO 639 - المحلقة(@)(@)(@@) (¬5):(@)(@@) فرس عبيد الله بن الحر الجعفي.(@)(@)PageV01P220(@)(@)(@@)(@@)(@@) || AUTO 640 - المكسر(@)(@)(@@) (¬1):(@)(@@) فرس عتيبة بن الحارث بن شهاب اليربوعي. قال مالك بن نويرة:(@)(@@) وعردت عني بعد ما كان مشقصي ... لمهرك مزورا أمام المعذر(@)(@@) فلو زهم الأصلاب منه لخالطت ... جبينك إذ أرمي جبين المكسر(@)(@@) ولو لم يكن هاديه دونك جنة ... لأيمت ذات القر منك المخدر(@)(@)(@@)(@@)(@@) || AUTO 641 - المنكدر(@)(@)(@@) (¬2):(@)(@@) لبني العدوية. قال المرار:(@)(@@) ببعيد قدره ذي عذر ... صلتان من بنات المنكدر(@)(@)(@@)(@@)(@@) || AUTO 642 - مبدوع(@)(@)(@@) (¬3):(@)(@@) لعبد الحارث بن ضرار بن عمرو. قال فيه عبد الحارث:(@)(@@) تشكى الغزو مبدوع وأضحى ... كأشلاء اللجام به كدوح(@)(@@) فلا تجزع من الحدثان إني ... أكر الغزو إذ حلب القروح(@)(@@) وقال زويهر بن عبد الحارث:(@)(@)PageV01P221(@)(@)(@@) قلت لسعد لا أبا لأبيكم ... ألم تعلموا أني ابن فارس مبدوع(@)(@)(@@)(@@)(@@) || AUTO 643 - محاج(@)(@)(@@) (¬1):(@)(@@) لمالك بن عوف النصري. قال يوم حنين:(@)(@@) أقدم محاج إنه يوم نكر(@)(@@) مثلي على مثلك يحمي ويكر(@)(@)(@@)(@@)(@@) || AUTO 644 - المحبر(@)(@)(@@) (¬2):(@)(@@) فرس ضرار بن الأزور الأسدي، 
ms64	 وهو قاتل مالك بن نويرة، وكان يقال له فارس المحبر. قال فيه:(@)(@@) 1) جزاني دوائيه المحبر إذ بدا ... بذي الرمث أعجاز السوام المؤبل(@)(@@) 2) كأني طلبت الخيل حين تفاوتت ... سوابقها دون السماء بأجدل (33/ب)(@)(@@) 3) من المنهبات الركض ظل كأنه ... على الجمر حتى يستغيث بمأكل(@)(@@) 4): أخالط منهم من أردت بمخلط ... وإن أنأ عنهم أنأ عنهم بمزيل(@)(@@) 5) أنهنه عني نفسه وكأنه ... بذي الرمث والغضياء مريخ معتل(@)(@)PageV01P222(@)(@)(@@)(@@)(@@) || AUTO 645 - مجلز(@)(@)(@@) (¬1):(@)(@@) فرس عمرو بن لؤي التيمي، من تيم اللات بن ثعلبة، كان يقال له فارس مجلز. قال:(@)(@@) تلومني النفس على مجلز ... والنفس كانت بعده ألوما(@)(@)(@@)(@@)(@@) || AUTO 646 - المائح(@)(@)(@@) (¬2):(@)(@@) فرس مرداس بن حوي الأسدي، وهو فارس المائح الذي يقول له عيينة ابن أوس المالكي:(@)(@@) 1) ألا يا لقوم وكل امرىء ... أراه إلى خلق صالح(@)(@@) 2) وهل لامني الناس إما منعت ... بنات النعامة للمائح(@)(@@) 3) طوال المتون حسان الوجو ... ه كالطير في السبل الرائح(@)(@@) 4) عطاء الإله وسيب امرىء ... إذا سيل ليس بذي قادح (¬3)(@)(@)(@@)(@@)(@@) || AUTO 647 - منشال(@)(@)(@@) (¬4):(@)(@@) فرس حجر بن معاوية بن مالك بن ربيعة بن معاوية الأكرمين.(@)(@)(@@)(@@)(@@) || AUTO 648 - مذهب(@)(@)(@@) (¬5):(@)(@@) لغني بن أعصر. قال طفيل الغنوي:(@)(@)PageV01P223(@)(@)(@@) وخيل كأمثال السراح مصونة ... ذخائر ما أبقى الغراب ومذهب (¬1)(@)(@)(@@)(@@)(@@) || AUTO 649 - مسمار(@)(@)(@@) (¬2):(@)(@@) فرس عمرو الضبي والدضرار بن عمرو. قال:(@)(@@) مسمار إن اليوم يوم ذفر(@)(@)(@@)(@@)(@@) || AUTO 650 - مصاد(@)(@)(@@) (¬3):(@)(@@) فرس نبيشة بن حبيب قاتل ربيعة بن مكدم. وفيه يقول نبيشة:(@)(@@) نصبت مصادا لصدر اللطي ... م حتى كأنهما في قرن (34/(@)(@@) واللطيم هنا فرس ربيعة بن مكدم (¬4). أنكر أبو الندى هذه الرواية وقال، الصحيح:(@)(@@) نصبت كزاز لصدر اللطيم (¬5)(@)(@@) وقد مضى الشعر فيه بحرف الكاف (¬6).(@)(@)(@@)(@@)(@@) || AUTO 651 - معروف(@)(@)(@@) (¬7):(@)(@@) فرس الزبير بن العوام. قال يحيى بن عروة بن الزبير:(@)(@)PageV01P224(@)(@)(@@) أب لي أبي الخسف قد تعلمونه ... وصاحب معروف سمام الكتائب(@)(@@) وأبي الخسف: خويلد بن عبد العزى. وصاحب معروف: الزبير بن العوام.(@)(@)(@@)(@@)(@@) || AUTO 652 - مكتوم(@)(@)(@@) (¬1):(@)(@@) لغني بن أعصر. قال طفيل الغنوي:(@)(@@) أبو هن مكتوم وأعوج أنجبا ... ورادا وحوا ليس فيهن مغرب (¬2)(@)(@)(@@)(@@)(@@) || AUTO 653 - المرتجز(@)(@)(@@) (¬3):(@)(@@) ابن الملاءة (¬4). لرسول الله صلى الله عليه وسلم، أهداه 
ms65	 له رجل من محارب اسمه سواء بن الحارث بن ظالم جراد (¬5)، سمي بذلك لحسن صهيله.(@)(@)(@@)(@@)(@@) || AUTO 654 - مناهب(@)(@)(@@) (¬6):(@)(@@) لبني ثعلبة بن يربوع، من ولد الحرون. وفيه يقول عقبة الثعلبي:(@)(@)PageV01P225(@)(@)(@@) أخذت من مناهب وصريح ... فصفا عتقها ومن حلاب(@)(@)(@@)(@@)(@@) || AUTO 655 - المصك(@)(@)(@@) (¬1):(@)(@@) فرس الأبرش الكلبي. مضى الشعر فيه في حرف الألف (¬2).(@)(@)(@@)(@@)(@@) || AUTO 656 - منحاز(@)(@)(@@) (¬3):(@)(@@) فرس عباد بن الحصين الحبطي. قال الفرزدق:(@)(@@) أيحسب قلبي خارجا من ضلوعه ... إذا ما ابن منحاز أرنت جلا جله(@)(@@) يريد بابن منحاز عبادا، نسبه إلى فرسه.(@)(@)(@@)(@@)(@@) || AUTO 657 - مندوب(@)(@)(@@) (¬4):(@)(@@) لمسلم بن ربيعة الباهلي، وقف عليه بدمشق مجللا مبرقعا فقال: سابق فأبتاعه. وصنعه فأجراه فلم يصنع شيئا، فباعه. ووقف (34/ب) عليه مرة أخرى فقال: سابق فأبتاعه. ثم صنعه فأجراه فلم يصنع شيئا، فباعه، واشتراه الثالثة فصنعه فسبق عليه أهل دمشق، فقال:(@)(@@) نظرت ومندوب عليه جلاله ... أمام رعال الخيل مستتلا يعدو(@)(@@) فقلت جواد أو صبور ملازم ... على الغاية القصوى إذا بلغ الجهد PageV01P226(@)(@@) فما خانني لبي لدن أن وزنته ... وبالباب أقوام ولا بصري بعد(@)(@)(@@)(@@)(@@) || AUTO 658 - مزلق(@)(@)(@@) (¬1):(@)(@@) فرس المغيرة بن خليفة الجعفي.(@)(@)(@@)(@@)(@@) || AUTO 659 - مودون(@)(@)(@@) (¬2):(@)(@@) فرس شهاب بن شيبان القيسي. قال ذو الرمة:(@)(@@) ونحن غداة بطن الخوع فئنا ... بمودون وفارسه جهارا (¬3)(@)(@@) وذلك أن الرباب (¬4) أسرت شهابا.(@)(@)(@@)(@@)(@@) || AUTO 660 - موكل(@)(@)(@@) (¬5):(@)(@@) فرس غزالة بن ربيعة السكوني. وفيه يقول:(@)(@@) أيها السائلي بموكل إني ... قائل الحق فاستمع ما أقول(@)(@@) حش لبدي به المليك ومن يح ... مله يوما فإنه محمول(@)(@)(@@)(@@)(@@) || AUTO 661 - مردود(@)(@)(@@) (¬6):(@)(@@) فرس زياد أخي محرق الغساني، قتلته بنوضبة. قال ربيعة بن مقروم الضبي:(@)(@@) وقاظ ابن حصن عانيا في بيوتنا ... يعالج قدا في ذراعيه مصحبا PageV01P227(@)(@@) وفارس مردود أشاطت رماحنا ... وأجزرن مسعودا ضباعا وأذؤبا (¬1)(@)(@)(@@)(@@)(@@) || AUTO 662 - مياس(@)(@)(@@) (¬2):(@)(@@) لشقيق بن جزء الباهلي أحد بني قتيبة. قال فيه ابن أحمر:(@)(@@) منى لك أن تلقى ابن هند منية ... وفارس مياس إذا ما تلببا(@)(@@) وحجلا أبا عمرو وقرة ذا الندى ... وزهرا وغلاقا ويا لك مقنبا (¬3) (35/أ)(@)(@)(@@)(@@)(@@) || AUTO 663 - محلاج(@)(@)(@@) (¬4):(@)(@@) فرس حرملة بن معقل بن المتمني من كلب.(@)(@)(@@)(@@)(@@) || AUTO 664 - المضيح 
ms66	(@)(@)(@@) (¬5):(@)(@@) لسراقة بن مالك الكناني. قال فيه:(@)(@@) لعمرك ما أثنى علي وما جرى ... قحافة والأيام عوج رواجع(@)(@@) نصيبت لهم صدر المضيح إذ دعا ... وقد أدركتنا اللازمون الوعاوع(@)(@)(@@)(@@)(@@) || AUTO 665 - المجذام(@)(@)(@@) (¬6):(@)(@@) فارسه من بني يربوع. قال رافع بن هريم-وحديث هذا الشعر في شعر مالك بن نويرة-:(@)(@)PageV01P228(@)(@)(@@) أما فارس المجذام منا بلينة ... بلى يوم يحوي ذو الخمار البحاترا(@)(@@) بلى وعرفتم ذا الفقار وأنزلت ... أسنتنا قبل الملوك الجبابرا(@)(@)(@@)(@@)(@@) || AUTO 666 - المتهجر(@)(@)(@@) (¬1):(@)(@@) فرس عبد يغوث بن عمرو بن مرة بن همام، وكان يقال له فارس المتهجر.(@)(@)(@@)(@@)(@@) || AUTO 667 - مسفوح(@)(@)(@@) (¬2):(@)(@@) لصخر بن الحارث بن عمرو بن الشريد السلمي. قال فيه:(@)(@@) فأحمل مسفوحا عليهم فلم يخم ... وقد عجزت هدل الشفاه عن الفم(@)(@@) إذا حبسونا في مضيق رميتهم ... بقرحته وفارس غير محجم(@)(@)(@@)(@@)(@@) || AUTO 668 - المنيح(@)(@)(@@) (¬3):(@)(@@) للقريم أخي بني تيم واسمه مسعود. قال:(@)(@@) 1) أمن ذكر المنيح وحب ليلى ... جزعت ولم أخل أني جزوع(@)(@@) 2) فأما منهما فأشق طرف ... إذا ما زاف في الحرب الجموع(@)(@@) 3) وأما منهما فضجيع صدق ... إذا ما الكلب ألجاه الصقيع(@)(@@) 4) جمعتهما لدي وأي حتى ... تدوم له السلامة والجميع(@)(@)(@@)(@@)(@@) || AUTO 669 - المتمهل(@)(@)(@@) (¬4):(@)(@@) فرس مرة بن خالد.(@)(@)(@@)(@@)(@@) || AUTO 670 - مودوع(@)(@)(@@) (¬5):(@)(@@) فارسه هرم بن (35/ب) ضمضم المري. قالت نائحته:(@)(@)PageV01P229(@)(@)(@@) يا لهف نفسي لهفة المفجوع ... ألا أرى هرما على مودوع(@)(@@) من أجل سيدنا ومصرع يومه ... علق الفؤاد بحنظل مصدوع(@)(@)(@@)(@@)(@@) || AUTO 671 - منهب(@)(@)(@@) (¬1):(@)(@@) لعوية بن سلمي الضبي. قال يوم أخذ ربيعة بن خويلد بن نفيل بن عمرو بن كلاب:(@)(@@) تدارك حربي (¬2) وابتذالي منهبا ... بذات الغضا ربيعة بن خويلد(@)(@@) مسح كشؤبوب العشي احتفاله ... خبوب كسرحان العضاه العمرد(@)(@)(@@)(@@)(@@) || AUTO 672 - الموسوم(@)(@)(@@) (¬3):(@)(@@) لمالك بن الجلاح الجشمي. قال بشر بن عصمة المزني:(@)(@@) إني لأرجو من مليكي رحمة ... ومن فارس الموسوم في النفس هاجس(@)(@)(@@)(@@)(@@) || AUTO 673 - ميار(@)(@)(@@) (¬4):(@)(@@) فارسه شرسفة بن خليف من بني مازن بن مطر بن زبان، أخذه قرط بن التوأم اليشكري لما قتله. قال قرط:(@)(@@) ما زلت أطعنهم شزرا وأضربهم ... حتى اتقوا فدية مني بميار(@)(@@) كان ابن شماء يعشوه ويصبحه ... من هجمة كفسيل النخل درار 
ms67	(@)(@)PageV01P230(@)(@)(@@)(@@)(@@) || CHECK 675 - 676 - مزنوق ومساور(@)(@)(@@)(@@)(@@) || AUTO 674 - مكحول(@)(@)(@@) (¬1):(@)(@@) فرس علي بن شبيب بن عامر الأزدي. قال سراقة بن مرداس البارقي:(@)(@@) سبق مكحول وصلى نادر(@)(@@) وخلف المزنوق والمساور(@)(@)(@@) 675 - 676 - مزنوق (¬2) ومساور (¬3):(@)(@@) لعتاب بن ورقاء الرياحي.(@)(@)(@@)(@@)(@@) || AUTO 677 - المسنون(@)(@)(@@) (¬4):(@)(@@) فرس ظهير بن رافع.(@)(@)(@@)(@@)(@@) || AUTO 678 - مندوب(@)(@)(@@) (¬5):(@)(@@) فرس أبي طلحة، ركبه النبي عليه الصلاة والسلام.(@)(@)(@@)(@@)(@@) || AUTO 679 - مرهوب(@)(@)(@@) (¬6):(@)(@@) للجميح بن الطماح الأسدي، أعطاه إياه خراشة بن علبة المري. وكان الجميح غزا فعقر به، فجاء إلى صديق له من بني مرة (36/أ) بن عوف بن PageV01P231(@)(@@) سعد بن ذبيان يقال له خراشة بن علبة، ولخراشة ابن يقال له نزال أسير في بني سليم، وكان لخراشة فرس يقال له مرهوب، رائع. وكان الذين ابنه أسير فيهم يتغلون بفدائه، ويسومون خراشة أن يفديه بفرسه فيأبى. فحمل عليه الجميح وترك ابنه أسيرا. . فقال الجميح:(@)(@@) 1) نفسي الفداء لمن لما تكاءدني ... كسب الجياد حشا سرجي بمرهوب(@)(@@) 2) وقلت الخيل عندي واختللت لها ... وخصني الشرك أرباب المناجيب(@)(@@) 3) هذا الثناء وإن تجلبك مأربة ... في المال ذا نكبة أو غير منكوب(@)(@@) 4) إصبر لها وتجدني دائما خلقي ... والقول منه كثير غير مرقوب(@)(@)(@@)(@@)(@@) || AUTO 680 - مخالس(@)(@)(@@) (¬1):(@)(@@) لبني عقيل. قال أبو الندى هو لبني فقيم.(@)(@)(@@)(@@)(@@) || AUTO 681 - معروف(@)(@)(@@) (¬2):(@)(@@) لسلمة بن هند الغاضري.(@)(@)(@@)(@@)(@@) || AUTO 682 - المنيحة(@)(@)(@@) (¬3):(@)(@@) فرس دثار بن فقعس. قال:(@)(@)PageV01P232(@)(@)(@@) قربا مربط المنيحة مني ... شبت الحرب للغواة سعارا(@)(@)(@@)(@@)(@@) || AUTO 683 - المنكدر(@)(@)(@@) (¬1):(@)(@@) [ابن] (¬2) العنز. والعنز فرس أبي عفراء بن سنان المحاربي (¬3).(@)(@)(@@)(@@)(@@) || AUTO 684 - مطامير(@)(@)(@@) (¬4):(@)(@@) فرس القعقاع بن شور.(@)(@)(@@)(@@)(@@) || AUTO 685 - المتفجر(@)(@)(@@) (¬5):(@)(@@) للحارث بن وعلة. قال بعضهم (¬6):(@)(@@) منا ابن كومة يوم أخطر نفسه ... والشعثمان وفارس المتفجر(@)(@)(@@)(@@)(@@) || AUTO 686 - مألوق(@)(@)(@@) (¬7):(@)(@@) فرس المحرش بن عمرو السدوسي.(@)(@)(@@)(@@)(@@) || AUTO 687 - محراث(@)(@)(@@) (¬8):(@)(@@) لعبادة بن عمرو بن مرثد. قال:(@)(@)PageV01P233(@)(@)(@@) تذكرت محراثا ومية بعد ما ... أشت بها الواشون شأوا مغربا(@)(@)(@@)(@@)(@@) || AUTO 688 - المشبه(@)(@)(@@) (¬1):(@)(@@) لرجل من بني تيم اللات.(@)(@)(@@)(@@)(@@) || AUTO 689 - المعلى(@)(@)(@@) (¬2):(@)(@@) فرس عقبة بن مدلج (36/ب) العليمي.(@)(@)(@@)(@@)(@@) || AUTO 690 - المعجاز(@)(@)(@@) (¬3):(@)(@@) فرس لقران الجعدي. قال الشاعر:(@)(@@) تخاله إذ علا المعجاز يركبه ... وقد تقاصر حنوا سرجه-جعلا(@)(@)(@@)(@@)(@@) || AUTO 
ms68	 691 - مزاحم(@)(@)(@@) (¬4):(@)(@@) لطلحة بن أبي محجن بن عدي بن غيظ.(@)(@)(@@)(@@)(@@) || AUTO المستدركات على حرف(@)(@@) الميم(@)(@)(@@)(@@)(@@) ||| AUTO 692 - المتغيف(@)(@)(@@) :(@)(@@) فرس أبي فيد بن حرمل بن علقمة بن سدوس عند ابن الأعرابي ص 91 في خيل بني ذهل بن ثعلبة والمخصص 2/ 197 والقاموس المحيط (غيف) 3/ 182 ومعناه المتعطف، والأغيف كالأغيد إلا أنه في غير نعاس.(@)(@)PageV01P234(@)(@)(@@)(@@)(@@) ||| AUTO 693 - مجلز(@)(@)(@@) :(@)(@@) فرس عوف بن الأحوص عند ابن الأعرابي ص 80 حيث ورد في المتن باسم (محلو) وفي الحواشي (مجلز) كما في بعض نسخ الكتاب، وقد رجح لدي وله نظائر مما تقدم. انظر رقم (645).(@)(@)(@@)(@@)(@@) ||| AUTO 694 - محاج(@)(@)(@@) :(@)(@@) فرس أبي جهل بن هشام. ورد ذلك عند ابن الأعرابي ص 53 في خيل قريش، والمخصص 2/ 194 والقاموس المحيط (محج) 1/ 207 وانظر رقم (643).(@)(@)(@@)(@@)(@@) ||| AUTO 695 - المخ(@)(@)(@@) :(@)(@@) للغراب بن سالم العبسي عند ابن الأعرابي ص 71 في خيل غطفان بن سعد والمخصص 2/ 196 وبلا نسبة في القاموس المحيط (مخ) 1/ 269.(@)(@)(@@)(@@)(@@) ||| AUTO 696 - المدعاس(@)(@)(@@) :(@)(@@) فرس الأقرع بن سفيان في اللسان (دعس) 6/ 84 وفيه يقول الفرزدق:(@)(@@) يعدي علالات العباية إذ دنا ... له فارس المدعاس غير المعمر(@)(@)(@@)(@@)(@@) ||| AUTO 697 - المدعاس(@)(@)(@@) :(@)(@@) فرس النواس بن عامر المجاشعي في العمدة 2/ 235.(@)(@)(@@)(@@)(@@) ||| AUTO 698 - مدرك(@)(@)(@@) :(@)(@@) فرس كلثوم بن الحارث بن كعب بن عمرو بن سدوس عند ابن الأعرابي ص 91 في خيل بني ذهل بن ثعلبة، والمخصص 2/ 197 وبلا نسبة في القاموس المحيط (درك) 3/ 301.(@)(@)(@@)(@@)(@@) ||| AUTO 699 - مذهب(@)(@)(@@) :(@)(@@) فرس أبرهة بن عمير بن كلثوم عند ابن الأعرابي ص 86 في خيل بني PageV01P235(@)(@@) وائل، والمخصص 2/ 197 وفي التكملة والذيل والصلة (ذهب) 1/ 132 والقاموس المحيط (ذهب) 1/ 70 ويرى الفيروز أبادي أن الصواب في كسر هائه. وأورد فيه ابن الأعرابي قول فارسه:(@)(@@) لقد زان خيل التغلبيين مذهب ... كما زانه يوم الكريهة فارسه(@)(@)(@@)(@@)(@@) ||| AUTO 700 - المريط(@)(@)(@@) :(@)(@@) ورد اسمه في أنساب الخيل ص 130 بلا نسبة، وذلك في معرض سرده أسماء خيل العرب، وأشار المحقق في الحاشية إلى أنه ربما كان مصحفا عن القريط. انظر ما تقدم برقم (550)، (554).(@)(@)(@@)(@@)(@@) ||| AUTO 701 - المرتاح(@)(@)(@@) :(@)(@@) فرس قيس الجيوش الجدلي 
ms69	 في القاموس المحيط (روح) 1/ 224 ومعناه الخامس من خيل الحلبة.(@)(@)(@@)(@@)(@@) ||| AUTO 702 - المراوح(@)(@)(@@) :(@)(@@) من خيل النبي صلى الله عليه وسلم المختلف فيها. ذكر ذلك الدميري في حياة الحيوان الكبرى 2/ 166 وتبعه صاحب رشحات المداد ص 116 - 124 والمراوح الفرس صار حصانا فحلا.(@)(@)(@@)(@@)(@@) ||| AUTO 703 - المرتجل(@)(@)(@@) :(@)(@@) من خيل النبي صلى الله عليه وسلم المختلف فيها. ورد ذلك في حياة الحيوان الكبرى 2/ 166 ورشحات المداد ص 124 وارتجل الفرس راوح بين العنق والهملجة.(@)(@)(@@)(@@)(@@) ||| AUTO 704 - مرحب(@)(@)(@@) :(@)(@@) فرس عبد الله بن عبد الحنفي، عند ابن الأعرابي ص 98 في خيل حنيفة بن لجيم والمخصص 2/ 197 والقاموس المحيط (رحب) 1/ 73.(@)(@)PageV01P236(@)(@)(@@)(@@)(@@) ||| AUTO 705 - المريخ(@)(@)(@@) :(@)(@@) فرس الحارث بن دلف عند ابن الأعرابي ص 97 في خيل عجل بن لجيم والمخصص 2/ 197 والقاموس المحيط (مرخ) 1/ 269 والمرخ شجر سريع الاشتعال والمرخاء الناقة المسرعة نشاطأ.(@)(@)(@@)(@@)(@@) ||| AUTO 706 - المزنوق(@)(@)(@@) :(@)(@@) فرس لعامر بن الطفيل. ورد ذلك في أنساب الخيل ص 64 وأورد فيه قوله يوم فيف الريح يوم فقئت عينه بيد مسهر بن قنان الحارثي:(@)(@@) 1) لقد علم المزنوق أني أكره ... على جمعهم كر المنيح المشهر(@)(@@) 2) إذا ازور من وقع الرماح زجرته ... وقلت له ارجع مقبلا غير مدبر(@)(@@) 3) وأنبأته أن الفرار خزاية ... على المرء ما لم يبل جهدا فيعذر(@)(@@) 4) ألست ترى أرماحهم في شرعا ... وأنت حصان ماجد العرق فاصبر(@)(@@) 5) فبئس الفتى إن كنت أعزر عاقرا ... جبانا فما أرجى لدى كل محضر(@)(@@) 6) لعمري وما عمري علي بهين ... لقد شان حر الوجه طعنة مسهر(@)(@@) وانظر الأبيات وشرحها في شرح المفضليات ق 106/ 2 - 3 - 4 - 5 - 6 - 7 - 8 ج 3/ 1487 وما بعدها والمزنوق كذلك لعامر بن الطفيل عند ابن الأعرابي ص 76 والعمدة 2/ 235 والمخصص 2/ 196 والقاموس المحيط (زنق) 3/ 243 وكل رباط في الجلد تحت الحنك فهو زناق.(@)(@)(@@)(@@)(@@) ||| AUTO 707 - مسحل(@)(@)(@@) :(@)(@@) لشريح بن قرواش العبسي في القاموس المحيط (سحل) 3/ 394 ومن معانيه الشجاع والعزم الصارم.(@)(@)(@@)(@@)(@@) ||| AUTO 708 - المشهر(@)(@)(@@) :(@)(@@) لمهلهل بن ربيعة عند ابن الأعرابي ص 88 في خيل بني وائل. وفيه يقول:(@)(@)PageV01P237(@)(@)(@@) قربا مربط 
ms70	 المشهر مني ... كل قرن لقرنه قتال(@)(@@) وهو لمهلهل في القاموس المحيط (شهر) 2/ 66 باسم المشهرة.(@)(@)(@@)(@@)(@@) ||| AUTO 709 - مصاد(@)(@)(@@) :(@)(@@) لابن غادية الخزاعي في حلية الفرسان ص 153 وانظر (مصاد) برقم (650).(@)(@)(@@)(@@)(@@) ||| AUTO 710 - المطر(@)(@)(@@) :(@)(@@) لمخيل بن شحنة عند ابن الأعرابي ص 81 في خيل بني ضبيعة بن نزار، والقاموس المحيط (طر) 2/ 78 وأورد فيه ابن الأعرابي قول فارسه:(@)(@@) ترديت السراط وذات شك ... وآثرت المسطر على العيال(@)(@@) السراط السيف القاطع. وأطر أخذ طرر الوادي. والطرير ذو المنظر والرواء.(@)(@)(@@)(@@)(@@) ||| AUTO 711 - المعلي(@)(@)(@@) :(@)(@@) فرس للعرب ورد بلا نسبة في القاموس المحيط (علو) 4/ 366.(@)(@)(@@)(@@)(@@) ||| AUTO 712 - معرور(@)(@)(@@) :(@)(@@) فرس علقمة بن شهاب بن عوف بن الحارث بن سدوس عند ابن الأعرابي ص 93 في خيل بني ذهل بن ثعلبة، والمخصص 2/ 197 وأورد ابن الأعرابي فيه قول متعبة بن علقمة لأضيافه:(@)(@@) أبي فارس المعرور ليلة لم يجد ... لأضيافه إلا البطية في اللبد(@)(@@) وذلك على الرواية الثانية، فثمة زعم يفتقر إلى الدليل بأن (الحواء) هي (المعرور) وانظر رقم (186) والعرة قروح في أعناق الفصلان، والمعرور من أصابه ما لا يستقر عليه.(@)(@)PageV01P238(@)(@)(@@)(@@)(@@) ||| AUTO 713 - المعزة(@)(@)(@@) :(@)(@@) فرس الخمخام بن حملة بن أبي الأسود عند ابن الأعرابي ص 93 في خيل بني ذهل بن ثعلبة، والمخصص 2/ 197 والقاموس المحيط (عز) 2/ 182 وأورد فيها ابن الأعرابي قول سلمة بن نهار:(@)(@@) لولا الجرادة والمعز لما رأت ... جيداء صرمتها طوال المسند(@)(@@) ويبدو أنه رخم الاسم ضرورة. واسم الفرس في المخصص (المعن) وهو تصحيف. وعز بمعنى قوي.(@)(@)(@@)(@@)(@@) ||| AUTO 714 - المقدام(@)(@)(@@) :(@)(@@) من خيل النبي صلى الله عليه وسلم المختلف فيها. ورد ذلك في حياة الحيوان الكبرى 2/ 166 ورشحات المداد ص 116 - 124.(@)(@)(@@)(@@)(@@) ||| AUTO 715 - مكنون(@)(@)(@@) :(@)(@@) فرس للعرب ورد بلا نسبة في أنساب الخيل ص 131 في معرض سرده أسماء خيل العرب.(@)(@)(@@)(@@)(@@) ||| AUTO 716 - المكانب(@)(@)(@@) :(@)(@@) فرس بربري جيء به لهشام بن عبد الملك، فقد ذكر القالي في نوادره ص 184 أن هشام بن عبد الملك كان يشتهي أن يسبق الذائد، فأتوه بفرس بربري يقال له المكانب فضمه إليه، فكان سائسه يقول: 
ms71	 جهد المكانب الذائد جهده الله. أي في الجري». وكنب كنوبا غلظ.(@)(@)(@@)(@@)(@@) ||| AUTO 717 - ملاوح(@)(@)(@@) :(@)(@@) فرس أبي بردة هانىء بن دينار في المعارف ص 65 ورشحات المداد ص 116 واسمه في المعارف هانىء بن نيار.(@)(@)(@@)(@@)(@@) ||| AUTO 718 - الملاءة(@)(@)(@@) :(@)(@@) هي أم المرتجز فرس النبي صلى الله عليه وسلم، ورد ذلك في القاموس المحيط (ملأ) PageV01P239(@)(@@) 1/ 28 و (رجز) 2/ 176 وانظر المرتجز برقم (653).(@)(@)(@@)(@@)(@@) ||| AUTO 719 - ملاوح(@)(@)(@@) :(@)(@@) من خيل النبي صلى الله عليه وسلم المختلف فيها، ورد ذلك في حلية الفرسان ص 151 وحياة الحيوان الكبرى 2/ 166 ورشحات المداد ص 124.(@)(@)(@@)(@@)(@@) ||| AUTO 720 - منازع(@)(@)(@@) :(@)(@@) فرس للعرب ورد بلا نسبة في أنساب الخيل ص 131 في معرض سرده أسماء خيل العرب.(@)(@)(@@)(@@)(@@) ||| AUTO 721 - المنيح(@)(@)(@@) :(@)(@@) فرس قيس بن مسعود الشيباني عند ابن الأعرابي ص 89 في خيل بني شيبان والمخصص 2/ 197 والقاموس المحيط (منح) 1/ 251.(@)(@)(@@)(@@)(@@) ||| AUTO 722 - المتتلع(@)(@)(@@) :(@)(@@) فرس مزيدة المحاربي عند ابن الأعرابي ص 84 في خيل عبد القيس بن أفصى والمخصص 2/ 197 واللسان (بلع) 8/ 20 والقاموس المحيط (تلع) 3/ 10 واسم الفرس عند ابن الأعرابي المنثلع وفي المخصص واللسان المتبلع، واسم الفارس في القاموس المحيط مزيدة الحارثي. ومعنى المتتلع المتقدم، والشاخص للأمر.(@)(@)(@@)(@@)(@@) ||| AUTO 723 - الموصول(@)(@)(@@) :(@)(@@) ابن القرحاء. فرس لعبد الرحمن بن عبد الله القشيري، حمل عليه أمية ابن عبد الله بن خالد بن أسيد وهو على خراسان، فسبق عليه أهل العراق والشام. وانظر القرحاء برقم (566).(@)(@)(@@)(@@)(@@) ||| AUTO 724 - مياس(@)(@)(@@) :(@)(@@) لشمير بن ربيعة الباهلي في حلية الفرسان ص 158.(@)(@)PageV01P240(@)(@)(@@)(@@)(@@) ||| AUTO 725 - مياح(@)(@)(@@) :(@)(@@) لعقبة بن سالم الهزاني. ورد ذلك عند ابن الأعرابي ص 82 في خيل عنزة ابن أسد، والمخصص 2/ 197 والقاموس المحيط (ميح) 1/ 251 وأورد فيه ابن الأعرابي قول فارسه:(@)(@@) 1) داويت مياحا لها وصنعته ... فداويت ملء العين ما فيه مزعم(@)(@@) 2) أما إذا استدبرته فهو حشور ... وأما إذا استقبلته فهو سلجم(@)(@@) 3) وأما إذا استعرضته فهو جرشع ... له ثبج حابي الضلوع ومحزم(@)(@@) 4) له قصريا ظبي وساقا نعامة ... وأنساء سيد لحمه متخذم(@)(@@) ما فيه مزعم أي ليس شيء من خيل العرب يطمع أن يسبقه. 
ms72	 والحشور الواسع الجوف، والسلجم طويل الخدين طويل العنق. حابي الضلوع طويلها، والقصرة العنق. والميح ضرب حسن من المشي.(@)(@)(@@)(@@)(@@) ||| AUTO 726 - المجنحة(@)(@)(@@) :(@)(@@) فرس طارق بن ضمرة بن جابر بن قطن في أسماء خيل العرب للغندجاني في الخبر التالي بعد في (النبيز) برقم (733).(@)(@@) ****(@)(@)PageV01P241(@)(@)(@@)(@@)(@@) | AUTO حرف النون(@)(@)(@@)(@@)(@@) || AUTO 727 - النحام(@)(@)(@@) (¬1):(@)(@@) للسليك بن السلكة السعدي. قال فيه:(@)(@@) قطعت وتحتي النحام يهوي ... كما انقضت على الخزز العقاب(@)(@@) وقال أيضا:(@)(@@) كأن حوافر النحام لما ... تروح صحبتي أصلا محار PageV01P242(@)(@@) على قرماء عالية شواه ... كأن بياض غرته خمار (¬1)(@)(@)(@@)(@@)(@@) || AUTO 728 - النعامة(@)(@)(@@) (¬2):(@)(@@) للحارث بن عباد. ولها يقول:(@)(@@) قربا مربط النعامة مني ... لقحت حرب وائل عن حيال (¬3)(@)(@)(@@)(@@)(@@) || AUTO 729 - النعامة(@)(@)(@@) (¬4):(@)(@@) لخالد بن نضلة الأسدي. قال يوم النسار-لما أسر حنثر بن بحر [بن] وهب بن وبر بن الأضبط بن كلاب ودودان بن خالد أحد بني نفيل-:(@)(@@) تدارك إرخاء النعامة حنثرا ... ودودان أدت في الحديد مكبلا(@)(@)(@@)(@@)(@@) || AUTO 730 - النعامة(@)(@)(@@) (¬5):(@)(@@) لمرداس بن معاذ الجشمي، وكان يقال لها ابنة صمعر. قال:(@)(@@) 1) ولم أرج في ظل اللواء ظهيرة ... خنوفا (¬6) إذا صاح الرقيب ونفرا(@)(@@) 2) إذا الكلب لم يعرف حليلة أهله ... وخالط في يوم الصياح وأنكرا PageV01P243(@)(@@) 3) وقلت لهم: شلوا مع القوم إنني ... مطرف أولى القوم يا بنة صمعرا (37/أ)(@)(@@) 4) فلم أق نفسي والنعامة عامدا ... كلوم السلاح أن أصاب وتعقرا(@)(@@) 5) ظللت كأني للرماح دريئة ... أقلب سربالا من الدم أحمرا(@)(@)(@@)(@@)(@@) || AUTO 731 - النعامة(@)(@)(@@) (¬1):(@)(@@) فرس أبي بن خلف عن أبي الندى. قال غيره: هي فرس مسافع بن عبد العزى الضمري. قال:(@)(@@) والله لا أنسى النعامة ليلة ... ولا يومها حتى أوسد معصمي(@)(@@) مسحة غيطان الفضاء ولقوة ... إذا طوطئت كأنها حمي ميسم (¬2)(@)(@)(@@)(@@)(@@) || AUTO 732 - ناتل(@)(@)(@@) (¬3):(@)(@@) لربيعة بن مالك أبي لبيد بن ربيعة. عن أبي الندى قال:(@)(@@) أذنت لكم أن تشتروا بفضولها ... وأعددت للأعداء والحرب ناتلا(@)(@)PageV01P244(@)(@)(@@)(@@)(@@) || AUTO 733 - النبيز(@)(@)(@@) (¬1):(@)(@@) فرس طارق بن ضمرة، وفيه يقول ضمرة (¬2) أخو طارق بن ضمرة- حين تراهن حديج بن قيس بن عمرو بن قطن، وطارق بن ضمرة بن جابر بن قطن على فرسيهما: المجنحة والنبيز وسبقه. فلما كان بعد 
ms73	 ذلك ذعر الناس فركبوا، فأدرك طارق على المجنحة إبلا، فلما حواها انقطعت فرسه، فأدركه ركب (¬3) الناس فاقتسموا تلك الإبل، وطارق غلام-فقال في ذلك ضمرة أخو طارق بن ضمرة:(@)(@@) أبقى رهان أبي ربيعة غدوة ... منها، ولم يك بعدها تعقيب(@)(@@) وتسوقها رجلا جداية حلب ... وتسد هبة صدرها وتصوب(@)(@@) غيبت عن ذاك الصنيع وأهله ... والعز يشهد مرة ويغيب(@)(@)(@@)(@@)(@@) || AUTO 734 - ناصح(@)(@)(@@) (¬4):(@)(@@) لسويد بن شداد العبشمي. قال:(@)(@@) أناصح برز للسباق فإنها ... غداة رهان جمعته الحلائب(@)(@@) فإنك مجلوب علي ضحى غد ... ومالك -إن لم يجلب الله- جالب(@)(@@) قال أبو الندى: هذا الشعر للحارث بن مراغة الحبطي، وناصح له (¬5).(@)(@)PageV01P245(@)(@)(@@)(@@)(@@) || AUTO 735 - نباك(@)(@)(@@) (¬1):(@)(@@) لبني تغلب. قال أبو الندى: هو فرس السفاح بن خالد التغلبي. وفيه يقول:(@)(@@) فإني لن يفارقني نباك ... يخال الشد والتقريب دينا(@)(@)(@@)(@@)(@@) || AUTO 736 - النعامة(@)(@)(@@) (¬2):(@)(@@) لكندي بن عمرو الكندي. قال:(@)(@@) ولما رأيت الخيل زورا صدورها ... نفحت لها صدر النعامة من أمم(@)(@)(@@)(@@)(@@) || AUTO 737 - ناعق(@)(@)(@@) (¬3):(@)(@@) لبني فقيم. مضى الشعر فيه في باب الألف (¬4).(@)(@)(@@)(@@)(@@) || AUTO 738 - نحلة(@)(@)(@@) (¬5):(@)(@@) لكندة. مضى الشعر فيه في حرف السين (¬6).(@)(@)(@@)(@@)(@@) || AUTO 739 - نحلة(@)(@)(@@) (¬7):(@)(@@) لسبيع بن الخطيم (37/ب) التيمي. قال فيها:(@)(@)PageV01P246(@)(@)(@@) يقول: نحلة أودعني فقلت له ... عول علي بأبكار هراجيب(@)(@@) لجت علي يمين لا أبدلها ... من ذات قرطين بين النحر واللوب (¬1)(@)(@@) قال أبو محمد الأعرابي: سألت أبا الندى عن معنى البيتين فقال: كان خطب إلى عمه بنته فقال: أعطني مهرها نحلة، فقال لا ولكن خذ إبلا، فرده عمه ولم يخطبه.(@)(@)(@@)(@@)(@@) || AUTO 740 - النعامة(@)(@)(@@) (¬2):(@)(@@) لعيينة بن أوس المالكي، هو فارس النعامة. قال:(@)(@@) 1) تقول أنا الحرى لقيت مشقة ... من الحش والإخلاف فالوجه ساهم(@)(@@) 2) فقالت لها الأخرى لأسمع قولها ... هو اليوم إن باع النعامة ناعم(@)(@@) 3) وما الناعم المغبوط إلا الذي له ... غنى وهو مكفي المؤونة طاعم(@)(@@) 4) وقالت سيعطى بالفلوة أربعا ... وبالمهرة الأخرى ثمان جوازم(@)(@@) 5) ولست بشاريهن ما لم تطلقي ... ولو لمتني أو لامني لك لائم(@)(@)(@@)(@@)(@@) || AUTO 741 - نصاب(@)(@)(@@) (¬3):(@)(@@) لمالك بن نويرة. عقرت تحته فحمله الأحوص بن عمرو الكلبي-وهو PageV01P247(@)(@@) جد بسطام بن قيس من قبل أمه-على الوريعة، فقال مالك 
ms74	 بن نويرة:(@)(@@) 1) سأهدي مدحتي لبني عدي ... أخص بها عدي بني جناب(@)(@@) 2) شكوت إليهم رجلي فقالوا ... لسيدهم أطعنا في الجواب(@)(@@) 3) ورد نزيلنا بعطاء صدق ... وأعقبه الوريعة من نصاب(@)(@@) 4) تراث الأحوص الخير بن عمرو ... وما أعني الأحاوص من كلاب(@)(@@) 5) فأصبح خلتي قد حش سرجي ... بسلهبة وساع في الجناب(@)(@)(@@)(@@)(@@) || AUTO 742 - ناصح(@)(@)(@@) (¬1):(@)(@@) فرس فضالة بن هند الأسدي.(@)(@)(@@)(@@)(@@) || AUTO 743 - الناصب(@)(@)(@@) (¬2):(@)(@@) لحويص بن بجير.(@)(@)(@@)(@@)(@@) || AUTO 744 - نهاب(@)(@)(@@) (¬3):(@)(@@) فرس مرداس بن جعونة(@)(@)PageV01P248(@)(@)(@@)(@@)(@@) || AUTO 745 - النعامة(@)(@)(@@) (¬1):(@)(@@) فرس الأسدي(@)(@)(@@)(@@)(@@) || AUTO 746 - النهام(@)(@)(@@) (¬2):(@)(@@) لشريك أبي عرفجة. قال عرفجة بن شريك:(@)(@@) أبي فارس النهام يوم قراقر ... وخالي بسطام بن قيس وأبجر(@)(@)(@@)(@@)(@@) || AUTO المستدركات على حرف(@)(@@) النون(@)(@)(@@)(@@)(@@) ||| AUTO 747 - نباك(@)(@)(@@) :(@)(@@) فرس كليب بن ربيعة التغلبي في القاموس المحيط (نبك) 3/ 321(@)(@)(@@)(@@)(@@) ||| AUTO 748 - النجيب(@)(@)(@@) :(@)(@@) من خيل النبي صلى الله عليه وسلم في فضل الخيل للدمياطي ص 114(@)(@)(@@)(@@)(@@) ||| AUTO 749 - ندوة(@)(@)(@@) :(@)(@@) فرس أبي فيد بن حرمل بن علقمة بن سدوس عند ابن الاعرابي ص 91 في خيل بني ذهل بن ثعلبة، والمخصص 2/ 197(@)(@)(@@)(@@)(@@) ||| AUTO 750 - نصاب(@)(@)(@@) :(@)(@@) فرس الأحوص بن عمرو الكلبي في أنساب الخيل ص 103 والأحوص بن ثعلبة الكلبي في حلية الفرسان ص 162(@)(@)(@@)(@@)(@@) ||| AUTO 751 - النعامة(@)(@)(@@) :(@)(@@) لخزز بن لوذان عند ابن الأعرابي ص 92 في خيل بني ذهل بن ثعلبة.(@)(@)PageV01P249(@)(@)(@@)(@@)(@@) ||| AUTO 752 - النعامة(@)(@)(@@) :(@)(@@) فرس قراص الأزدي في أنساب الخيل ص 106 وحلية الفرسان ص 163 والقاموس المحيط (نعم) 4/ 181 وأورد فيها ابن الكلبي قول فارسها:(@)(@@) عرضت لهم صدر النعامة أدعي ... ولم أرج ذكرا كل نفس أسوقها(@)(@@) قلت: لعلها (كل نفسي أسوقها) أي أنني جاد في طلب الموت.(@)(@)(@@)(@@)(@@) ||| AUTO 753 - النعامة(@)(@)(@@) :(@)(@@) للمنفجر الغبري عند ابن الأعرابي ص 87 في خيل بني وائل والقاموس المحيط (نعم) 4/ 181(@)(@)(@@)(@@)(@@) ||| AUTO 754 - ابن النعامة(@)(@)(@@) :(@)(@@) فرس لعنترة بن عمرو بن معاوية عند ابن الأعرابي ص 69 في خيل غطفان بن سعد والعمدة 2/ 235 والمخصص 2/ 196(@)(@)(@@)(@@)(@@) ||| AUTO 755 - النقيب(@)(@)(@@) :(@)(@@) فرس للعرب، ورد بلا نسبة في أنساب الخيل ص 132 في معرض سرده أسماء خيل العرب.(@)(@)(@@)(@@)(@@) ||| AUTO 756 
ms75	 - النهات(@)(@)(@@) :(@)(@@) فرس لاحق بن النجار عند ابن الأعرابي ص 94 في خيل بني ذهل بن ثعلبة والمخصص 2/ 197 والقاموس المحيط (نهت) 1/ 159 والنهيت والنهات الزئير.(@)(@@) ****(@)(@)PageV01P250(@)(@)(@@)(@@)(@@) | AUTO حرف الواو(@)(@)(@@)(@@)(@@) || AUTO 757 - الوجيه(@)(@)(@@) (¬1):(@)(@@) لغني بن أعصر. قال ابن مقبل:(@)(@@) فينا تجاوب أولاد الوجيه إذا ... صامت ضحى تقدع الذبان كالشجر(@)(@)(@@)(@@)(@@) || AUTO 758 - الوحيف(@)(@)(@@) (¬2):(@)(@@) لعقيل بن الطفيل. قال جبار بن سلمى بن مالك بن جعفر بن كلاب:(@)(@@) يدعو عقيلا وقد مر الوحيف به ... على طوالة يمري الركض بالعقب(@)(@@) قال أبو الندى: طوالة ماء لبني مرة (¬3)، وهو الذي ذكره الشماخ:(@)(@@) كلا يومي طوالة وصل أروى ... ظنون آن مطرح الظنون (¬4)(@)(@)PageV01P251(@)(@)(@@)(@@)(@@) || AUTO 759 - الورد(@)(@)(@@) (¬1):(@)(@@) لأحمر بن جندل. وفيه يقول القائل:(@)(@@) تجنبتنا بالورد لما رأيتنا ... يمر كمر الثعلب المتمطر(@)(@)(@@)(@@)(@@) || AUTO 760 - الورد(@)(@)(@@) (¬2):(@)(@@) لزيد الخيل، كان النعمان بن المنذر وهبه له، فلامته امرأته في صونه فقال:(@)(@@) تلوم على أن أمنح الورد لقحة ... وما تستوي والورد ساعة تفزع (¬3)(@)(@@) وقال أبو الندى: ليس هذا البيت لزيد الخيل، إنما هو لرجل من طيء، وهو الأعرج المعني في ورد آخر (¬4). وبيت زيد في الورد قوله:(@)(@@) ما زلت أرميهم بشكة حازم ... وبالورد حتى أحرثوه وبلدا (38/ب)(@)(@@) وحتى تداعت في السباء نساؤهم ... وقد ظهرت شكوى زنيم وأسعدا(@)(@)(@@)(@@)(@@) || AUTO 761 - الورد(@)(@)(@@) (¬5):(@)(@@) فرس كردم الصدائي. قال أبو الندى: شهد يوم سلاطح (¬6) فأردف ثلاثة فنجوا كلهم. فقال:(@)(@@) تالله لولا الورد يوم سلاطح ... لضربت غيرك غير ذات ضجيع PageV01P252(@)(@@) أدى إليك أبا بنيك ومثلهم ... إني إذا يسعون غير سريع(@)(@)(@@)(@@)(@@) || AUTO 762 - الورد(@)(@)(@@) (¬1):(@)(@@) لعصم قاتل شرحبيل الملك يوم الكلاب (¬2). قال أبو حنش التغلبي:(@)(@@) والورد يسعى بعصم في طوائفهم ... كأنه لاعب يسعى بمنحاز(@)(@)(@@)(@@)(@@) || AUTO 763 - الورهاء(@)(@)(@@) (¬3):(@)(@@) لرجل من بني كنانة. وفيها يقول مالك بن خالد السلمي:(@)(@@) وأفلتنا قتادة وهو كاب ... على الورهاء تعثر في الغبار (¬4)(@)(@)(@@)(@@)(@@) || AUTO 764 - الورهاء(@)(@)(@@) (¬5):(@)(@@) لعوف بن ضرار الضبي. قال شقيق بن جزء الباهلي:(@)(@@) أفلتنا لدى الأسلات عوف ... على الورهاء تطعن في اللجام(@)(@@) وكان هو الشفاء فأحرزته ... صنيع المتن رابية الحزام (¬6)(@)(@)(@@)(@@)(@@) || AUTO 765 - الوريعة(@)(@)(@@) (¬7):(@)(@@) كانت فرس الأحوص بن عمرو 
ms76	 الكلبي، فوهبها لمالك بن نويرة.(@)(@)PageV01P253(@)(@)(@@) وقد مضى الشعر فيها في حرف النون (¬1).(@)(@)(@@)(@@)(@@) || AUTO 766 - الوشيك(@)(@)(@@) (¬2):(@)(@@) للحازوق الخارجي. مضى الشعر فيه في حرف اللام (¬3).(@)(@)(@@)(@@)(@@) || AUTO 767 - وجزة(@)(@)(@@) (¬4):(@)(@@) ليزيد بن سنان بن أبي حارثة المري، مرة غطفان. ولها يقول:(@)(@@) لما أن رأيت بني حيي ... عرفت شناءتي فيهم ووتري(@)(@@) رميتهم بوجزة إذ تواصوا ... ليرموا نحرها كثبا ونحري (¬5)(@)(@)(@@)(@@)(@@) || AUTO 768 - وحفة(@)(@)(@@) (¬6):(@)(@@) لعلاثة بن جلاس بن مخربة التميمي. قال فيها (39/أ): -(@)(@@) ما زلت أرميهم بوحفة ناصبا ... لهم صدرها حدا وأزرق منجل (¬7)(@)(@)(@@)(@@)(@@) || AUTO 769 - الورد(@)(@)(@@) (¬8):(@)(@@) لبلعاء بن قيس الكناني. قال فيه:(@)(@@) حملت عليه الورد حتى تركته ... تليلا يسف الترب واللون فاقع(@)(@)PageV01P254(@)(@)(@@)(@@)(@@) || AUTO 770 - الورد(@)(@)(@@) (¬1):(@)(@@) لحجية بن المضرب. قال فيها:(@)(@@) فضل ضلال الورد يوم أحثه ... أبادر نهبا بالعراق وجاملا(@)(@)(@@)(@@)(@@) || AUTO 771 - الورد(@)(@)(@@) (¬2):(@)(@@) لشمير بن الحارث الضبي. قال:(@)(@@) لولا مكري الورد قاظت نساؤهم ... سبايا كأمثال الإماء الحواطب(@)(@)(@@)(@@)(@@) || AUTO 772 - الوجيه(@)(@)(@@) (¬3):(@)(@@) للمغيرة بن خليفة الجعفي. قال:(@)(@@) فيا رب بارك في الوجيه وصابح ... وفهد كما باركت في الصلتان(@)(@@) هذه خيول له.(@)(@)(@@)(@@)(@@) || AUTO 773 - الوالقي(@)(@)(@@) (¬4):(@)(@@) لخزاعة. قال كثير:(@)(@@) يغادرن عسب الوالقي وناصح ... تخص به أم الطريق عيالها(@)(@)(@@)(@@)(@@) || AUTO 774 - الورد(@)(@)(@@) (¬5):(@)(@@) لحكيم بن قبيصة بن ضرار الضبي. قالت امرأة من عائذة من بني ضبة:(@)(@)PageV01P255(@)(@)(@@) متى تلق سيديا وإن كان محرما ... يقل لك هل تخشى علي حكيما(@)(@@) وما لي لا أخشى عليك محربا ... أخا ثقة ينعى قتيلا كريما(@)(@@) متى تلقه يعدو به الورد جافلا ... بشكته تلق الألد الغشوما (¬1)(@)(@)(@@)(@@)(@@) || AUTO 775 - الورد(@)(@)(@@) (¬2):(@)(@@) لصخر بن عمرو بن الحارث بن الشريد السلمي. قال في يوم بني أسد حين طعن:(@)(@@) وجاءت تهز السمهري كتيبة ... عزيز على المرء الجبان نزالها (39/ب(@)(@@) معودة يوم النسار وقبله ... إذا برقت بالموت يصدق خالها(@)(@@) حملت عليها الورد حتى تبددت ... تخر من الركض الحثيث نعالها(@)(@)(@@)(@@)(@@) || AUTO 776 - الورد(@)(@)(@@) (¬3):(@)(@@) لمهلهل. قال:(@)(@@) لم أرم حومة الكتيبة حتى ... حذي الورد من دماء نعالا(@)(@)(@@)(@@)(@@) || AUTO 777 - الورد(@)(@)(@@) (¬4):(@)(@@) لمعبد بن سغبة الضبي، وهو ابن رميلة. قال فيه:(@)(@@) 1) إن الرئيس هو المغنم قومه ... وهو المحامي من وراء المحجر(@)(@@) 2) ما 
ms77	 زلت فوق الورد يبحث قائما ... حتى تجلت غيبة المتمطر(@)(@@) 3) وجعلت نحري للرماح دريئة ... فخلستماني الغنم يا بني منذر PageV01P256(@)(@@) 4) ما كان ما طاعنت عن بكراتها ... لبني البروك مويلك والأعور(@)(@@) 5) ولحق جيش كنت أنت رئيسه ... حنك العظاية أن يجيء بمنكر(@)(@)(@@)(@@)(@@) || AUTO 778 - الورد(@)(@)(@@) (¬1):(@)(@@) لخالد بن صريم السلمي. قال أخوه يمن عليه-وأسره بنو النابغة من بني نصر بن معاوية فانفلت على فرس لهم وأخذوا فرسه-فقال ابن صريم:(@)(@@) ظل طرادي يوم عائذ وجرة ... سراة بني زغب لديك وعامرا(@)(@@) هم سلبوك الدرع والرمح فيهم ... وهم بدلوك الورد شقراء عاقرا(@)(@)(@@)(@@)(@@) || AUTO 779 - الورد(@)(@)(@@) (¬2):(@)(@@) لبدر بن حمراء الضبي. وشهد فتح تستر فقال:(@)(@@) عذرت الورد إذ يغشى رجالا ... فما بال القلاع على السفين(@)(@@) إذا ما الماء جاوز منكبيه ... يقيني نبل فارس بالجبين(@)(@)(@@)(@@)(@@) || AUTO 780 - الورد(@)(@)(@@) (¬3):(@)(@@) لأوس بن مالك الجرمي. وعض الأسد بمنكبيه فعض بأنفه وقال (40/أ): -(@)(@@) إذا هتفت في بطن واد حمامة ... دعت ساق حر فابكيا فارس الورد(@)(@@) وقولا: فتى الفتيان أوس بن مالك ... ملاعب أطراف الأسنة والأسد(@)(@)(@@)(@@)(@@) || AUTO 781 - الورد(@)(@)(@@) (¬4):(@)(@@) لعمر بن وازع الحنفي. قال دهمان بن شبل النمري:(@)(@@) ونجاك يابن الوازع الورد بعد ما ... فلا السيف عن أعلاك درعا ومغفرا PageV01P257(@)(@@) رأيتك إذ خامت فوارس عامر ... ضممت برجليك الحصان المشهرا(@)(@)(@@)(@@)(@@) || AUTO 782 - الورد(@)(@)(@@) (¬1):(@)(@@) لقيس بن ثمامة الأرحبي من همدان. قال فيه:(@)(@@) وغادروا من سليم فارسا سلما ... يكبو لقاصمة للظهر قمطير(@)(@@) تبعته الورد قد مالت رحالته ... والخيل تقفز بالقوم الحذافير(@)(@)(@@)(@@)(@@) || AUTO 783 - الورد(@)(@)(@@) (¬2):(@)(@@) للأسعر الجعفي. قال فيه:(@)(@@) كلما قلت أن سيلحقه الور. . . ... د تمطت به كميت ذنوب(@)(@)(@@)(@@)(@@) || AUTO 784 - الورد(@)(@)(@@) (¬3):(@)(@@) لأهبان بن عادية الأسلمي. قال فيه:(@)(@@) دفعت الورد وهو أخي إذا ما ... رأيت الموت يقترب اقترابا(@)(@@) كمريخ يدافع جانبيه ... كأن بكف فارسه عقابا(@)(@)(@@)(@@)(@@) || AUTO 785 - الورد(@)(@)(@@) (¬4):(@)(@@) لعمرو بن ثعلبة العبسي. قال فيه:(@)(@@) حواها أبرص الخصيين شيخ ... إذا ما سوءة تركت أتاها PageV01P258(@)(@@) ولو لاقيتني والورد فيها ... ظللت بقنع معتنزا سواها (¬1)(@)(@)(@@)(@@)(@@) || AUTO 786 - الورد(@)(@)(@@) (¬2):(@)(@@) لفضالة بن كلدة المالكي. قال فضالة بن هند الغاضري:(@)(@@) ففدى أمي وما قد ولدت ... غير مفقود 
ms78	 فضال بن كلد(@)(@@) حمل الورد على أكسائهم ... كلما أدرك بالسيف جلد (40/ب)(@)(@)(@@)(@@)(@@) || AUTO 787 - الورد(@)(@)(@@) (¬3):(@)(@@) لمعن بن عتود.(@)(@)(@@)(@@)(@@) || AUTO 788 - الورد(@)(@)(@@) (¬4):(@)(@@) لحاتم بن النعمان.(@)(@)(@@)(@@)(@@) || AUTO 789 - الورد(@)(@)(@@) (¬5):(@)(@@) للحارث بن وعلة. قال:(@)(@@) فلولا مقام الورد حيث تناله ... صدور الرماح كان خدك أضرعا(@)(@)(@@)(@@)(@@) || AUTO 790 - الورد(@)(@)(@@) (¬6):(@)(@@) فارسه جارية بن مسهر المازني. قال:(@)(@@) كررت الورد يوم حزيز غول ... أحاذر بالمعيبة أن تلاموا(@)(@@) كأن النبل بالليتين منه ... وبالصفحات كراث تؤام(@)(@)PageV01P259(@)(@)(@@)(@@)(@@) || AUTO المستدركات على حرف(@)(@@) الواو(@)(@)(@@)(@@)(@@) ||| AUTO 791 - واقع(@)(@)(@@) :(@)(@@) لربيعة بن جشم عند ابن الأعرابي ص 85 في خيل النمر بن قاسط والمخصص 2/ 197 والقاموس المحيط (وقع) 3/ 96 والوقع سرعة الانطلاق.(@)(@)(@@)(@@)(@@) ||| AUTO 792 - وبال(@)(@)(@@) :(@)(@@) لضمرة بن جابر بن قطن بن نهشل عند ابن الأعرابي ص 66 في خيل بني حنظلة والمخصص 2/ 195 والقاموس المحيط (وبل) 4/ 63 ولضمرة نفسه فرس آخر باسم (أثال) سبق وروده برقم (3) ومعنى الوبال الشدة والثقل.(@)(@)(@@)(@@)(@@) ||| AUTO 793 - الوثيمي(@)(@)(@@) :(@)(@@) فرس لبني هلال، ورد في أنساب الخيل ص 117،123 وهو جد الحرون.(@)(@)(@@)(@@)(@@) ||| AUTO 794 - الوجيه(@)(@)(@@) :(@)(@@) فرس لبني سعد في العمدة 2/ 234.(@)(@)(@@)(@@)(@@) ||| AUTO 795 - الورد(@)(@)(@@) :(@)(@@) فرس شيطان بن الحكم في المخصص 2/ 196 في خيل ضبة.(@)(@)(@@)(@@)(@@) ||| AUTO 796 - الورد(@)(@)(@@) :(@)(@@) للأعرج الطائي واسمه عدي بن عمرو. ورد ذلك عند ابن الأعرابي ص 99 في خيل اليمن والغندجاني عن أبي الندى في (الورد) برقم (760) وشرح الحماسة للمرزوقي ق 117/ 2 ج 1/ 349 وما بعدها حيث أورد فيه قول فارسه:(@)(@)PageV01P260(@)(@)(@@) 1) أرى أم سهل ما تزال تفجع ... تلوم وما أدري علام توجع(@)(@@) 2) تلوم على أن أعطي الورد لقحة ... وما تستوي والورد ساعة تفزع(@)(@@) 3) إذا هي قامت حاسرا مشمعلة ... نخيب الفؤاد رأسها ما تقنع(@)(@@) 4) وقمت إليه باللجام ميسرا ... هنالك يجزيني الذي كنت أصنع(@)(@@) وهو لعدي بن عمرو الطائي في القاموس المحيط (ورد) 1/ 344.(@)(@)(@@)(@@)(@@) ||| AUTO 797 - الورد(@)(@)(@@) :(@)(@@) لقبيصة بن النصراني. ورد ذلك في شرح الحماسة للمرزوقي ق 202/ 1 ج 2/ 620 قال فيه:(@)(@@) ألم تر أن الورد عرد صدره ... وحاد عن الدعوى وضوء البوارق(@)(@@) وقال فيه أيضا في ق 203/ 2 ج 2/ 623.(@)(@@) هاجرتي يابنة آل سعد 
ms79	(@)(@@) أأن حلبت لقحة للورد(@)(@@) وهي أرجوزة في ستة أبيات.(@)(@)(@@)(@@)(@@) ||| AUTO 798 - الورد(@)(@)(@@) :(@)(@@) للهذيل بن هبيرة في القاموس المحيط (ورد) 1/ 344.(@)(@)(@@)(@@)(@@) ||| AUTO 799 - الورد(@)(@)(@@) :(@)(@@) لحارثة بن مشمت العنبري في القاموس المحيط (ورد) 1/ 344.(@)(@)(@@)(@@)(@@) ||| AUTO 800 - الورد(@)(@)(@@) :(@)(@@) لحمزة بن عبد المطلب في: أنساب الخيل ص 20 وابن الأعرابي ص 51 - 52 في خيل بني هاشم والمخصص 2/ 193 وحلية الفرسان ص 152 واللسان (ورد) 3/ 459 وأشار ابن الكلبي إلى أنه من بنات ذي العقال ولد أعوج، وأورد فيه ابن الأعرابي قول فارسه:(@)(@)PageV01P261(@)(@)(@@) 1) ليس عندي إلا سلاح وورد ... قارح من بنات ذي العقال(@)(@@) 2) أتقي دونه الحروب بنفسي ... وهو دوني يغشى صدور العوالي(@)(@@) 3) جرشع ما أصابت الحرب منه ... حين تحمى أبطالها لا أبالي(@)(@@) 4) وطرير كأنه قرن ثور ... ذاك لا غير ذاكم جل مالي(@)(@@) 5) فإذا ما هلكت كان تراثي ... وسجالا محمودة من سجالي(@)(@)(@@)(@@)(@@) ||| AUTO 801 - الورد(@)(@)(@@) :(@)(@@) فرس عامر بن الطفيل في أنساب الخيل ص 65 حيث قالت للطفيل تميمة بنت أهبان العبسية في يوم الرقم:(@)(@@) ولولا نجاء الورد لا شيء غيره ... وأمر الإله ليس لله غالب(@)(@@) إذا لسكنت العام نفأ ومنعجا ... بلاد الأعادي أو بكتك الحبائب(@)(@@) وكذا عند ابن الأعرابي ص 76 واسم القائلة مية بنت أهبان. وهو لعامر بن الطفيل في العمدة 2/ 235 وحلية الفرسان ص 156 والقاموس المحيط (ورد) 1/ 344.(@)(@)(@@)(@@)(@@) ||| AUTO 802 - الورد(@)(@)(@@) :(@)(@@) فرس للنبي صلى الله عليه وسلم في: المعارف ص 65 والعمدة 2/ 234 وفضل الخيل للدمياطي ص 119 وحلية الفرسان ص 151 وحياة الحيوان الكبرى 2/ 166 ورشحات المداد ص 123 وذكر الدميري أنه أهداه للنبي (ص) تميم الداري، فأعطاه عمر بن الخطاب (رض) فحمل عليه في سبيل الله تعالى.(@)(@)(@@)(@@)(@@) ||| AUTO 803 - الوزر(@)(@)(@@) :(@)(@@) فرس للعرب ورد بلا نسبة في أنساب الخيل ص 132 في معرض سرده أسماء خيل العرب.(@)(@)PageV01P262(@)(@)(@@)(@@)(@@) ||| AUTO 804 - الوزن(@)(@)(@@) :(@)(@@) فرس شبيب بن ديسم عند ابن الأعرابي ص 67 في خيل باهلة والمخصص 2/ 196 والقاموس المحيط (وزن) 4/ 275.(@)(@)(@@)(@@)(@@) ||| AUTO 805 - ابن وقعة(@)(@)(@@) :(@)(@@) أورده أبو عبيدة معمر بن المثنى في كتابه الخيل ص 68 وأورد فيه 
ms80	 قول عقبة التغلبي:(@)(@@) والرياحي وابن وقعة والضي ... ف بقايا نزائع ونجاب(@)(@@) أفحل الخيل كلهن جواد ... من جياد عتيقة الأنساب(@)(@@) ****(@)(@)PageV01P263(@)(@)(@@)(@@)(@@) | AUTO حرف الهاء(@)(@)(@@)(@@)(@@) || AUTO 806 - الهجيسي(@)(@)(@@) (¬1):(@)(@@) لبني تغلب.(@)(@)(@@)(@@)(@@) || AUTO 807 - الهداج(@)(@)(@@) (¬2):(@)(@@) للريب بن شريق السعدي.(@)(@)(@@)(@@)(@@) || AUTO 808 - هداج(@)(@)(@@) (¬3):(@)(@@) فرس ربيعة بن مدلج الباهلي ويسمى فارس هداج، وهو الذي ذكره PageV01P264(@)(@@) الحارثي في وقعة أرمام فقال:(@)(@@) شقيق وحري أراقا دماءنا ... وفارس هداج أشاب النواصيا(@)(@)(@@)(@@)(@@) || AUTO 809 - الهذلول(@)(@)(@@) (¬1):(@)(@@) فرس عجلان بن نكرة التيمي من تيم الرباب.(@)(@)(@@)(@@)(@@) || AUTO 810 - الهراوة(@)(@)(@@) (¬2):(@)(@@) للريان بن حويص العبدي، وكانت لا تدرك، وتسمى هراوة الأعزاب لأنه تصدق بها على أعزاب قومه، فكان العزب منهم يغزو عليها فإذا استقاد مالا وأهلا دفعها إلى آخر من قومه، فكانوا يتداولونها كذلك، فضربت مثلا. قال لبيد:(@)(@@) لا تسقني بيديك إن لم ألتمس ... نعم الضجوع بغارة أسراب(@)(@@) تهدي أواثلهن كل طمرة ... جرداء مثل هراوة الأعزاب (¬3)(@)(@@) قال أبو محمد الأعرابي: سألت أبا الندى عن الضجوع فقال: هو (41/أ) قتادة بن كعب بن عوف بن عبد بن أبي بكر بن كلاب، أخو جواب ابن كعب.(@)(@)PageV01P265(@)(@)(@@) وقال عمرو المحاربي من عبد القيس:(@)(@@) 1) سقى جدث الريان كل عشية ... من المزن وكاف العشي دلوح(@)(@@) 2) أقام لفتيان العشيرة سهوة ... لهم منكح من جريها وصبوح(@)(@@) 3) فيا من رأى مثل الهراوة منكحا ... إذا بل أعطاف الجياد جروح(@)(@@) 4) وذي إبل لولا الهراوة لم يثب ... له المال ما انشق الصباح يلوح(@)(@)(@@)(@@)(@@) || AUTO 811 - الهرار(@)(@)(@@) (¬1):(@)(@@) فرس معاوية بن عبادة بن عقيل، وهو فارس الهرار، وهو الذي عقر بزهير بن جذيمة العبسي فرسه القعساء (¬2).(@)(@)(@@)(@@)(@@) || AUTO 812 - الهطال(@)(@)(@@) (¬3):(@)(@@) لزيد الخيل، وفيه يقول:(@)(@@) أقرب مربط الهطال إني ... أرى حربا تلقح عن حيال(@)(@)(@@)(@@)(@@) || AUTO 813 - هبود(@)(@)(@@) (¬4):(@)(@@) فرس عمرو بن الجعيد المرادي، قتله علقمة بن سباع القريعي.(@)(@)PageV01P266(@)(@)(@@) قالت امرأة من اليمن:(@)(@@) أشاب قذال الرأس مصرع سيد ... وفارس هبود أشاب النواصيا(@)(@)(@@)(@@)(@@) || AUTO 814 - هجل(@)(@)(@@) (¬1):(@)(@@) فرس الربيع بن كعب المازني.(@)(@)(@@)(@@)(@@) || AUTO 815 - هلاب(@)(@)(@@) (¬2):(@)(@@) فرس الحكم بن نفر وهو جد الطرماح (¬3). قال الطرماح.(@)(@@) بيت سماعة والأمين عماده ... والأثرمان وفارس الهلاب (¬4)(@)(@)(@@)(@@)(@@) || AUTO 816 - هيفاء(@)(@)(@@) (¬5):(@)(@@) لطارق 