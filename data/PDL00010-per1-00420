ms418	 جز از بهر مالش نجوید تو را کس %~% همانا که تو روغن یاسمینی(@)(@@) 42 بها گیر و رخشانی ای شعر ناصر %~% مگر خود شعری بدخشی نگینی(@)(@@) 43 بر اعدای دین زهری و مؤمنان را %~% غذائی مگر روغن و انگبینی PageV1P222(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 گر نخواهی ای پسر تا خویشتن مجنون کنی %~% پشت پیش این و آن پس چون همی چون نون کنی(@)(@@) 2 دلت خانه آرزو گشتست و زهر است آرزو %~% زهر قاتل را چرا با دل همی معجون کنی(@)(@@) 3 خم ز نون پشت تو هم در زمان بیرون شود %~% گر تو خم آرزو را از شکم بیرون کنی(@)(@@) 4 ز آرزوی آنکه روزی زنت کدبانو شود %~% چون تن آزاد خود را بنده خاتون کنی(@)(@@) 5 ده تن از تو زرد روی و بی نوا خسپد همی %~% تا به گلگون می همی تو روی خود گلگون کنی(@)(@@) 6 گر تو مجنونی از این بی‌دانشی پس خویشتن %~% چون به می خوردن دگرباره همی مجنون کنی(@)(@@) 7 زر همی خواهی که پاشی می خوری با حوریان %~% سر ز رعنائی گهی ایدون و گاه ایدون کنی(@)(@@) 8 گر نه دیوانه شده‌ستی چون سر هشیار خویش %~% از بخار گند می طبلی پر از هپیون کنی(@)(@@) 9 خوش بخندی بر سرود مطرب و آواز رود %~% ور توانی دامنش پر لؤلؤ مکنون کنی(@)(@@) 10 ور به درویشی زکاتت داد باید یک درم %~% طبع را از ناخوشی چون مار و مازریون کنی(@)(@@) 11 گاه بی‌شادی بخندی خیره چون دیوانگان %~% گاه بی‌انده به خیره خویشتن محزون کنی(@)(@@) 12 آن کنی از بی‌هشی کز شرم آن گر بررسی %~% وقت هشیاری از انده روی چون طاعون کنی(@)(@@) 13 درد نادانی برنجاند تو را ترسم همی %~% درد نادانیت را چون نه به علم افسون کنی(@)(@@) 14 خانه‌ای کرده‌ستی اندر دل ز جهل و هر زمان %~% آن همی خواهی که در وی نقش گوناگون کنی(@)(@@) 15 خانه هوش تو سر بر گنبد 
ms419	 گردون کشد %~% گر تو خانه بی‌هشی را بر زمین هامون کنی(@)(@@) 16 دل خزینه توست شاید کاندرو از بهر دین %~% بام و بوم از علم سازی وز خرد پرهون کنی(@)(@@) 17 موش و مار اندر خزینه خویش مفگن خیر خیر %~% گر نداری در و گوهر کاندرو مخزون کنی(@)(@@) 18 دست بر پرهیزدار و خوب گوی و علم جوی %~% تا به اندک روزگاری خویشتن قارون کنی(@)(@@) 19 گرد دانا گرد و گردن قول او را نرم‌دار %~% گر همی خواهی که جای خویش بر گردون کنی(@)(@@) 20 گر شرف یابد ز دانش جانت بر گردون شود %~% لیکن اندر چاه ماند دون گر او را دون کنی(@)(@@) 21 خویشتن را چون به راه داد و عدل و دین روی %~% گرچه افریدون نه‌ای برگاه افریدون کنی(@)(@@) 22 گر همی دانی که خانه است این گل مسنون تو را %~% چون همه کوشش ز بهر این گل مسنون کنی(@)(@@) 23 جان به صابون خرد بایدت شستن کین جسد %~% تیره ماند گر مرو را جمله در صابون کنی(@)(@@) 24 آرزو داری که در باغ پدر نو خانه‌ای %~% برفرازی وانگهی آن را به زر مدهون کنی(@)(@@) 25 از گلاب و مشک سازی خشت او را آب و خاک %~% در ز عود و فرش او رومی و بوقلمون کنی(@)(@@) 26 من گرفتم کین مراد آید به حاصل مر تو را %~% ور بخواهی صد چنین و نیز ازین افزون کنی(@)(@@) 27 گر بماند با تو این خانه من آن خواهم که تو %~% تا به فردا نفگنی این کار بل اکنون کنی(@)(@@) 28 ور نخواهد ماند با تو باغ و خانه خیر خیر %~% خویشتن را رنجه چون داری و چون شمعون کنی(@)(@@) 29 گر کسی گویدت «بس نیکو جوانی شادباش!» %~% شادمان گردی و رخ همرنگ آذریون کنی(@)(@@) 30 چونت گوید «دیر زی!» پس دیر باید زیستن %~% گر همی کار ای هنر پیشه بر این قانون کنی(@)(@@) 31 زندگی و شادی اندر 
ms420	 علم دین است ای پسر %~% خویشتن را گر نه مستی مست و مجنون چون کنی(@)(@@) 32 گر به شارستان علم اندر بگیری خانه‌ای %~% روز خویش امروز و فردا فرخ و میمون کنی(@)(@@) 33 روز تو هرگز به ایمان سعد و میمون کی شود %~% چون تو بر ابلیس ملعون خویشتن مفتون کنی(@)(@@) 34 دست هامان ستمگار از تو کوته کی شود %~% چون تو اندر شهر ایمان خطبه بر هارون کنی(@)(@@) 35 بید بی‌باری ز نادانی ولیکن زین سپس %~% گر به دانش رنج بینی بید را زیتون کنی(@)(@@) 36 بخت تو گر چه ز نادانی قرین ماهی است %~% چون بیاموزیش با ماه سما مقرون کنی(@)(@@) 37 شعر حجت را بخوان و سوی دانش راه جوی %~% گر همی خواهی که جان و دل به دین مرهون کنی(@)(@@) 38 چون گشایش‌های دینی تو ز لفظش بشنوی %~% سخره زان پس بر گشایش‌های افلاطون کنی(@)(@@) 39 ور ز نور آفتابش بهر گیرد خاطرت %~% پیش روشن خاطرت مر ماه را عرجون کنی(@)(@@) 40 از تو خواهند آب ازان پس کاروان تشنگان %~% خوار و تشنه گر ازینان روی زی جیحون کنی(@)(@@) 41 فخر جوید بر حکیمان جان سقراط بزرگ %~% گر تو ای حجت مرو را پیش خود ماذون کنی PageV1P223(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای کرده سرت خو به بی‌فساری %~% تا کی بود این جهل و بادساری(@)(@@) 2 در دشت خطا خیره چند تازی %~% چون سر ز خطا باز خط ناری(@)(@@) 3 گر سر ز خطا باز خط ناری %~% دانم به حقیقت کز اهل ناری(@)(@@) 4 خاری است خطا زهر بار تاکی %~% تو پشت در این زهر بار خاری(@)(@@) 5 عقل است به سوی صواب رهبر %~% با راه‌برت چون به خار خاری(@)(@@) 6 چون با خرد ای بی‌خرد نسازی %~% جز رنج نبینی و سوکواری(@)(@@) 7 گوئی که «چرا روزگار جافی %~% با من نکند هیچ بردباری»(@)(@@) 8 این بند نبینی که بر تو بستند %~% در بند همی چون کنی سواری(@)(@@) 9 