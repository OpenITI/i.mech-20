ms521	 دشمنی بولهبی(@)(@@) 34 حاسدان دارد و بدگوی بسی لیک همی %~% کی مقاسات کشد بحر دمان از مهبی(@)(@@) 35 تا حیات آید از آمیزش جانی و تنی %~% تا تناسل بود از صحب امی و ابی(@)(@@) 36 سببی سازش تا شاعر صدر تو بود %~% که همی شعر مرکب نبود بی سببی(@)(@@) 37 تا ز پیش دو ربیع آید هر گه صفری %~% تا پس از هر دو جماد آید هر گه رجبی(@)(@@) 38 باد حظ ولی تو ز سعادت لطفی %~% باد قسم عدوی تو ز شقاوت غضبی(@)(@@) 39 پای احباب تو بگشاده ز بند از شرفی %~% دست اعدای تو بر بسته به دار از کنبی(@)(@@) 40 تا چو تمساح بود راس و ذنب بر گردون %~% راس عز تو مبیناد ز گردون ذنبی PageV1P0615(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 دلا زین تیرگی زندان اگر روزی رها یابی %~% اگر بینا شوی زین پس به دیگر سر صفا یابی(@)(@@) 2 تو بیماری درین زندان و بیماریت را لا شک %~% روا باشد طبیبی جوی تا روزی دوا یابی(@)(@@) 3 بصیرت گر کنی روشن به کحل معرفت زیبد %~% که دردش را اگر جویی هم اینجا توتیا یابی(@)(@@) 4 جهان ای دل چو زندان دان و دریا پیش زندانت %~% اگر کشتیت نگذارد درین دریا فنا یابی(@)(@@) 5 گر اینجا آشنا گردی تو با آفاق و با انفس %~% چو زین هر دو گذر کردی بدانجا آشنا یابی(@)(@@) 6 وگر می کیمیا جویی کزو زری کنی مس را %~% به نزد کیمیا گر گرد تا زو کیمیا یابی(@)(@@) 7 دلا زین عالم فانی اگر تو مهر برداری %~% چو از فانی گذر کردی سوی باقی بقا یابی(@)(@@) 8 ازین چون و چرا بگذرد که روشن گرددت هزمان %~% مگر کان عالم پر خیر بی‌چون و چرا یابی(@)(@@) 9 تو در بحر محیط ای دل چو غواصان یکی غوطه %~% بکن هزمان اگر خواهی که از موجش رها یابی(@)(@@) 10 اگر تاریک دل باشی مقامت در زمین باشد %~% اگر 
ms522	 روشن روان گردی مقر اوج سما یابی(@)(@@) 11 به راه انبیا باید ترا رفتن اگر خواهی %~% که علم انبیا دانی و سر اولیا یابی(@)(@@) 12 به قال و قیل گمراهان مشو غره اگر خواهی %~% که روزی راهرو گردی و راه رهنما یابی(@)(@@) 13 به سوی تپه رو یک بار موسی وار اگر خواهی %~% که علم اژدها دانی و سر آن عصا یابی(@)(@@) 14 حدیث آن کلام و طور و موسی گر همی خواهی %~% که بشناسی ز خود یابی ز دیگر کس کجا یابی(@)(@@) 15 همان مهد مسیحا دم نگر کو بی‌پدر چون بد %~% حکیمی گوید این معنی طلب کن تا که را یابی(@)(@@) 16 درخت و آن شب تاریک و شعله آتش روشن %~% اگر زان چوب می‌جویی تو آن معنی کجا یابی(@)(@@) 17 ز نور یوسف و یعقوب و چاه و اخوه یوسف %~% در آن وادی مرو کانجا به هر پی صد بلا یابی(@)(@@) 18 گر آن ماهی که یونس را بیوبارید در دریا %~% بیوبارد ترا چون او ازین سفلی علا یابی(@)(@@) 19 کتاب مبتدا خوان تو که رمز گندم و آدم %~% حدیث دست «لا تقرب» تو اندر مبتدا یابی(@)(@@) 20 معانی جمله حل کردی همینت مشکلی مانده %~% که رمز ذلت داوود و قتل اوریا یابی(@)(@@) 21 ترا قرآن به اطلس خوانده تا زو کسوتی یابی %~% قیامت را تو این معنی ز رقع و بوریا یابی(@)(@@) 22 تحرک ز آب می‌آید به سنگ آسیا هزمان %~% تو نادان این تحرک را ز سنگ آسیا یابی(@)(@@) 23 تو دست چپ درین معنی ز دست راست نشناسی %~% کنون با این خری خواهی که اسرار خدا یابی(@)(@@) 24 نه کار تست می خوردن که بد مستی کنی هزمان %~% تو چون حلاج عشق آری چو جام از می بلا یابی(@)(@@) 25 سنایی گر سنا دارد ز علم ایزدی دارد %~% تو دین و علم ایزد جوی تا چون او سنا یابی(@)(@@) 26 تو راه دین ایزد 
ms523	 را نمی‌دانی وگر جویی %~% هم از قرآن پر معنی و لفظ مصطفا یابی(@)(@@) 27 هر آن دینی که بیرون زین دو جویی بدعتی باشد %~% نباید جستن آن دین را وگر جویی خطا یابی(@)(@@) 28 چو بابدعت روی زینجا یقین میدان که در محشر %~% ز مالک بر در دوزخ جزای آن قفا یابی(@)(@@) 29 وگر با دین پیغمبر ز عالم رخت بربندی %~% ز ایزد خلد و حورالعین و آمرزش عطا یابی PageV1P0616(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ایا مانده بی‌موجب هر مرادی %~% همه ساله در محنت اجتهادی(@)(@@) 2 نه در حق خود مر ترا انزعاجی %~% نه در حق حق مر ترا انقیادی(@)(@@) 3 چو دیوانگان دایم اندر به فکری %~% چه گویی ترا چون برآید مرادی(@)(@@) 4 ز حرص دو روزه مقام مجازی %~% به هر گوشه‌ای کرده ذات العمادی(@)(@@) 5 همانا به خواب اندری تا ندانی %~% که ما را جزین نیست دیگر معادی(@)(@@) 6 چه بیچاره مردی چه سرگشته خلقی %~% که بر باطلی باشدت استنادی(@)(@@) 7 جمادیست این شوم دنیا که دایم %~% ترا نیست الا بر او اعتمادی(@)(@@) 8 پس ای خواجه دعوی رسد آن کسی را %~% که معبود او گشته باشد جمادی(@)(@@) 9 پس آن گه رسیدن به تحقیق معنی %~% تمنی کنی با چنین اعتقادی(@)(@@) 10 ندانی همی ویحک اینقدر باری %~% که جای دو معنی نباشد فوادی(@)(@@) 11 تو گر راه حق را همی جویی اول %~% طلب کرد باید سبیل الرشادی(@)(@@) 12 زیادت بود مر ترا هر زمانی %~% به اعمال و افعال خویش اعتدادی(@)(@@) 13 پس از نیستی ساز آن راه سازی %~% کجا بهتر از نیستی هست زادی(@)(@@) 14 صلاح سنایی در آنست دایم %~% شود در ره عشق بی چون سدادی(@)(@@) 15 بگفتم صلاح دل از روی معنی %~% صلاحیست این مشمر اندر فسادی(@)(@@) 16 شو از خود بری گرد تا بر حقیقت %~% ترا بی تو حاصل شود انجرادی(@)(@@) 17 نبینی که پروانه شمع هرگز %~% که بر باطنش چیره گردد ودادی(@)(@@) 18 بری گردد از 
ms524	 خویشتن چون سنایی %~% کند او ز خویشی خود انفرادی PageV1P0617(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 این چه بود ای جان که ناگه آتش اندر من زدی %~% دل ببردی و چو بوبکر ربابی تن زدی(@)(@@) 2 تا مرا دیدی ز خلق از عشق رویت سوخته %~% سنگ و آهن بودت از دل سنگ بر آهن زدی(@)(@@) 3 قامتم چون لام و نون کردی چو موسی در امید %~% پس مرا در گلبن غیرت نوای «لن» زدی(@)(@@) 4 هر زمان از جای سری روید همی بر تن چو شمع %~% تا مرا از دست خود چون شمع خود گردن زدی(@)(@@) 5 چشمهای من چو چشم ابر کردی تا تو شوخ %~% ناگه از عنبر به گرد قرص مه خرمن زدی(@)(@@) 6 جوشن صبر و شکیباییم خون نو شد ز زخم %~% تا ز زلف چون زره تیغی بر آن جوشن زدی(@)(@@) 7 کی فرو زد مر ترا قندیل دلداری چو تو %~% آب بر آتش گرفتی خاک در روغن زدی(@)(@@) 8 کی شود پیراهنت هم قدر قد تو چو تو %~% از گریبان کاست کردی آنچه در دامن زدی(@)(@@) 9 روزنی بود از برای روز رویت بر دلم %~% از بخیلی گل بیاوردی و بر روزن زدی(@)(@@) 10 شد جهان بر چشم من چون چشم سوزن تنگ و تار %~% از پی رغم مرا شمشاد بر سوسن زدی(@)(@@) 11 از برون آفرینش گلشنی بر ساختی %~% برکشیدی نردبان و خیمه در گلشن زدی(@)(@@) 12 رشته تو کس نداند تافت کز شوخی و کبر %~% سوزنی کردی مرا پس کوه بر سوزن زدی(@)(@@) 13 از سنایی دل ربودی شکر چون کردی ز غیر %~% جان ز یزدان یافتی چو لاف ز اهریمن زدی(@)(@@) 14 زخم داری بهر دشمن رحم داری بهر دوست %~% دوست بودم از چه بر من زخم چون دشمن زدی(@)(@@) 15 پس چو هست از زخم شاه ما همی گردد چو نیست %~% آنچه شه بر دشمن خود زد چرا بر من زدی(@)(@@) 16 شاه ما بهرامشه 
ms525	 آن شه که گوید دولتش %~% زه که چون گردون جهانی خصم را گردن زدی(@)(@@) 17 چرخ چندان بر زمین کی زد به صد دوران که تو %~% زان سنان چرخ دوز و گرز کوه افگن زدی PageV1P0618(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای پدیدار آمده همچون پری با دلبری %~% هر که دید او مر ترا با طبع شد از دل بری(@)(@@) 2 آفتاب معنی از سایت بر آید در جهان %~% زان که از هر معنیی چون آفتاب خاوری(@)(@@) 3 زهره مزهر بر تو سازد کز عطارد حاصلی %~% مر ترا از راستی تو مشتری شد مشتری(@)(@@) 4 بینمت منظوم و موزون و مقفا زان ترا %~% دستیار خویش دارد زهره در خنیاگری(@)(@@) 5 همچو مشک و گل سمر گشتی به گیتی نسیم %~% چون نکو رویان ز شیرینی همی جان‌پروری(@)(@@) 6 مجلس آرایی کنی هر جا که باشی زان که تو %~% چون گل و مل در جهان آراسته بی‌زیوری(@)(@@) 7 گر عرض قایم نباشد نی ز جوهر در مکان %~% لفظ و خط همچون عوض شد در عرض بی جوهری(@)(@@) 8 از پری ز آتش بود تو آتشین طبع آمدی %~% شاید ار باشی تو مانند پری در دلبری(@)(@@) 9 تا بینندت به خوبی داستان از تو زنند %~% چون نشینند و بینندت چنین باشد پری(@)(@@) 10 گوهر معنی تمامی ایزد اندر تو نهاد %~% نیستی زین چارگوهر پس تو پنجم گوهری(@)(@@) 11 از برای چه کنی چون ابر هرجایی سفر %~% چون ز هر معنی پر از گوهر چو بحر اخضری(@)(@@) 12 گوهر و شکر بهم نبود تو از معنی و لفظ %~% شکر چون گوهری و گوهر چون شکری(@)(@@) 13 گر ز طبع خواجه گشتی گوهر دریای علم %~% از چه از دست و قلم اندر پناه عنبری(@)(@@) 14 با شرف گشتی چو تاج اصفهانت جلوه کرد %~% پیش تخت تاجداران لفظ تازی و دری(@)(@@) 15 مشرق و مغرب همه بگرفت نام نیک تو %~% کلک خواجه تا قوی دارد ترا با لاغری(@)(@@) 16 
ms526	 تاج اصفاهان السان الدهر ابوالفتح آنکه هست %~% در عجم چون عنصری و در عرب چون بحتری(@)(@@) 17 آن ادیب مشرق و مغرب که اندر شرق و غرب %~% کرد پیدا در طریق شاعری او ساحری(@)(@@) 18 شعر او خوان شعر او دان شعر او بین در جهان %~% تا بدانی و ببینی ساحری و شاعری(@)(@@) 19 معنی بسیار چون بینم من اندر شعر او %~% گویم این شعر آسمانی ای معانی اختری(@)(@@) 20 معنی از اشعار او معروف گشت اندر جهان %~% همچنان چون نور از خورشید چرخ چنبری(@)(@@) 21 آفتاب و ماه و انجم بینی از معنی بسی %~% گر تو اندر آسمان آسای شعرش بنگری(@)(@@) 22 معنی اندر شعر او تابان بود از لفظ او %~% چون گهر از روی تاج و چون نگین ز انگشتری(@)(@@) 23 شعر او ابروست کز پروردین افزاید جمال %~% آن ما موی سرست آنبه بود کش بستری(@)(@@) 24 پیش او هرگز نشاید کرد کس دعوی شعر %~% از پس سید نشاید دعوی پیغمبری(@)(@@) 25 ای سپاهان سروری کن بر زمین چون آسمان %~% در جهان تا تو ولادتگاه چونین سروری(@)(@@) 26 آفرین بادا بر آن بقعت کزو گشت او پدید %~% در همه علمی توانا در همه بابی جری(@)(@@) 27 ای بمانند قلم تو ذولسانین جهان %~% چون قلم گوهر نگاری چون قلم دین گستری(@)(@@) 28 در زمین تو آن عطارد آیتی در روزگار %~% کز هنر وقت شرف جز فرق کیوان نسپری(@)(@@) 29 چون لسان‌الدهر و تاج اصفهان شد نام تو %~% پیش تخت تاجداران از هنر نام آوری(@)(@@) 30 آب و آتش گر پدید آید به دست امتحان %~% اندر آن آبی چو گوهر و اندر آن آتش زری(@)(@@) 31 معجزات تو شود آن آب و آتش زان که تو %~% چون خلیل و چون کلیم از آب و آتش بگذری(@)(@@) 32 تو به اخبار و به تفسیری امام بی‌بدل %~% شاعری در جنب فضلت هست کاری سرسری(@)(@@) 33 نیستی اندر طریق شعر گفتن آنچنانک %~% بوحنیفه 
ms527	 گفت در شعری برای عنصری(@)(@@) 34 «اندرین یک فن که داری و آن طریق پارسی ست %~% دست دست تست کس را نیست با تو داوری »(@)(@@) 35 گوهر جدت اگر فخر آورد بر تو رواست %~% بر زمین نارد نتیجه چرخ چون تو گوهری(@)(@@) 36 پیش معنیهای تو معنی نماید چون سمر %~% شرح معنیهای او هرگز نگردد اسپری(@)(@@) 37 شاعری در پیش تو شاعر کجا یارد نمود %~% ساحری در پیش موسی چون نماید سامری(@)(@@) 38 پیش بحر علم تو هر بحر چون جعفر بود %~% چه عجب گر بخشدت شه گنج زر جعفری(@)(@@) 39 از برای گوهر معنی روی در شرق و غرب %~% در جهان علم مانا تو دگر اسکندری(@)(@@) 40 آفتاب و ماه علم آراستی زان پس که تو %~% نه بسان آفتاب و مه دوان بر هر دری(@)(@@) 41 یک کرشمه گر تو بنمایی دگر از چشم فضل %~% فکر جان بینی همه با چشمهای عبهری(@)(@@) 42 باش تا باغ امید تو تمامی بر دهد %~% این همه ز آنجا که حق تست چون من بی‌بری(@)(@@) 43 سید اهل سخن تو این زمان چون سیدی %~% علم و حکمت شد چو شارستان و تو چون حیدری(@)(@@) 44 زنده کردی تو از آن تصنیف نام عالمی %~% عمر ثانی را ز اول زین معانی رهبری(@)(@@) 45 هر که در گیتی گسست از ذکر تو مذکور شد %~% ای خنک آنرا که تو ذکرش در آن جمع‌آوری(@)(@@) 46 یادگار از مردمان ذکر نکو ماند همی %~% چون تو از ذکر نکو در عمر نیکو محضری(@)(@@) 47 ذکرهای عنصری از ملک محمودی بهست %~% گر چه پیش ملک او دونست ملک نوذری(@)(@@) 48 نیک گویی تو از من بشنوند آن از تو هیچ %~% آفرین گویم همی نفرین کنندم بر سری(@)(@@) 49 آسمان در باب من باز ایستاد از کار خویش %~% بر زمین اکنون مرا چه بهتری چه بدتری(@)(@@) 50 گر بگویم کاین گل شادیم چون پژمرده شد %~% از غم نرگس صفت گردی 
ms528	 چو گل جامه‌دری(@)(@@) 51 مستمع بودندی از لفظ تو گر بودی جدای %~% در میان خاک و باد و آب و آتش داوری(@)(@@) 52 تو همی گفتی که شعرت دیگران بر خویشتن %~% بسته‌اند از بهر نامی این گروهی از خری(@)(@@) 53 جامه طاووس از شوخی اگر پوشید زاغ %~% نه چو طاووسش بباید کردن آن جلوه‌گری(@)(@@) 54 چون نعیق زاغ شد همچون نوای عندلیب %~% زاغ را زیبد برفتن کشتی کبک دری(@)(@@) 55 آنچه تو یک روز دیدی ماندیدیم آن به عمر %~% عمر ضایع گشت ما را کس نگفت ای چون دری(@)(@@) 56 رنج بردی کشت کردی آب دادی و بردرو %~% خرش خور و خوش خند مگری گرگری بر ما گری(@)(@@) 57 چون ترا بینیم گوییم اندرین ایام خویش %~% اینت دولتیار مرد اندر حدیث شاعری(@)(@@) 58 پیش جنات‌العلی آورده‌ام ام بیدی چو نال %~% گر کنی عفوم شود آن بید گلبرگ طری PageV1P0619(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 شیفته کرد مرا هندوکی همچو پری %~% آنچنان کز دل عقل شدم جمله بری(@)(@@) 2 خوشدلی شوخی چون شاخک نرگس در باغ %~% از در آنکه شب و روز درو در نگری(@)(@@) 3 گرمی و تری در طبع هلاک شکرست %~% او همه گریم و تری و چو تنگ شکری(@)(@@) 4 گرمی و تری در طبع فزاید مستی %~% او همه چون شکر و می همه گرمی و تری(@)(@@) 5 بی لب و پر گهر و چشم کشش می‌خواهم %~% که بوم چون صدف و جزع به کوری و کری(@)(@@) 6 تا به گوش دلش آن گوهر خوش می‌شنوی %~% تا به روی لبش آن روی نکو می‌سپری(@)(@@) 7 صدهزاران شکن از زلف بر آن توده گل %~% صد هزاران دل از آن هر دو به زیر و زبری(@)(@@) 8 دو سیه زنگی در پیش دو شهزاده روم %~% دو نوان نرگس برطرف دو گلبرگ طری(@)(@@) 9 قد چون سرو که دیدست که روید به چمن %~% آفتاب و شکر از سر و بن غاتفری(@)(@@) 10 فوطه‌ای بر 
ms529	 سر آن روی چو خورشید که دید %~% جمع بر تارک خورشید ستاره سحری(@)(@@) 11 کرده آن زلف چو تاج از بر آن روی چو عاج %~% خود نداند چه کند از کشی و بی‌خبری(@)(@@) 12 شده مغرور بدان حسن ز بی‌عاقبتی %~% نه غم شادی و انده نه بهی از بتری(@)(@@) 13 باز کردار همی صید کند دیده و دل %~% چون خرامید به بازار در آن کبک دری(@)(@@) 14 گه برین خنده زند گاه بر آن عشوه دهد %~% خود بهاری که شنیدست بدین عشوه‌گری(@)(@@) 15 ریشخندی بزند زین صفت و پس برود %~% من دوان از پس او زار به خونابه گری(@)(@@) 16 گویم او را که مرا باز خر از غم گوید %~% سیم داری بخرم ورنه برو ریش مری(@)(@@) 17 گویم او را که بهای تو ندارم گوید %~% گنگی و لنگ چرا شعر نگویی نبری(@)(@@) 18 ببر خواجه براهیم علی ابراهیم %~% تا ترا صله دهد تا تو ز خواجم بخری(@)(@@) 19 آنکه گر فی‌المثلش ملک شود بحر و فلک %~% فلک و بحر به یک تن دهد از بی‌خطری(@)(@@) 20 آنکه نه چرخ نزادست و نه این چارگهر %~% یک پسر چون او در دهر سخی و هنری(@)(@@) 21 جنیان ز آنهمه از شرم نهانند که هیچ %~% نه ز خود چون تو بدیدند نه اندر بشری(@)(@@) 22 بنده لطف و عطای او انسی و جنی %~% چاکر طبع سخای او بحری و بری(@)(@@) 23 در کف و فکرت او بخشش و علم علوی %~% در دل و سیرت او قوت و عدل عمری(@)(@@) 24 چون صخاورزی صد گنج جهان پر درمی %~% چون سخن گویی صد بحر خرد پر درری(@)(@@) 25 شجر و ماه و گهر نیز نخوانمت از آنک %~% از کف و چهره و زیب از همه زیبنده‌تری(@)(@@) 26 سال تا سال دهد بار به یک بار درخت %~% تو به هر مجلس هر روز درختی ببری(@)(@@) 27 قمر از شمس شود نقصان وز روی تو چون 
ms530	 %~% شمس نقصان شود از بهر چه گویم قمری(@)(@@) 28 خانه خورد ز صد گوهر روشن نشود %~% روشنی عالم از تست چه جای گهری(@)(@@) 29 رادمردی که همی کوشد با خود به نیاز %~% مددی او را از بخشش و از کف ظفری(@)(@@) 30 ارغوان رنگی لیکن به همه جا که رسی %~% زعفران‌وار غم از طبع جهانی ببری(@)(@@) 31 ز آسمان مهتری از همت و پاکیزه‌دلی %~% وز خرد بهتری از دانش و نیکو سیری(@)(@@) 32 سوختی دشمن خود را ز تف آتش خشم %~% گر بهشتی به چه در قهر عدو چون سقری(@)(@@) 33 ای که چون چرخ جهانگرد و به دل محتشمی %~% وی که چون مهر عطابخش و به کف مشتهری(@)(@@) 34 زین بلندی به سوی بستان چون رای کنی %~% غم و شادی دو کس گردی گویی قدری(@)(@@) 35 از کف جودش حاصل شده طبع جبری %~% وز پی جبرش باطل شده رای قدری(@)(@@) 36 ای که چون باد به عالم ز لطافت علمی %~% وی که چون ابر به گیتی ز سخاوت سمری(@)(@@) 37 پدرت بود سخی‌تر ز همه لشگر شاه %~% تو ز کف دایم و در ورزش رسم پدری(@)(@@) 38 زنده ماندست ز تو رسم پدر در همه حال %~% این چنین باد کردن پدران را پسری(@)(@@) 39 قصد درگاه تو زان کردم تا از سر لطف %~% در چو من شاعر از دیده حرمت نگری(@)(@@) 40 قصبی خواهم و دراعه نخواهم زر و سیم %~% زان که ناید به سر این دو هر دو به پانصد بدری(@)(@@) 41 ور تو شاهانه مرا هم به گدا خوانی من %~% سیم نستانمت ار حاجب زرین کمری(@)(@@) 42 نه نه از طیبت بنده ست هم از روی نیاز %~% چه برهنه‌ست که نستد ز کسی آستری(@)(@@) 43 ز آنت گفتم که همی دانم کز خوش سخنی %~% شکری والله در طبع و به لذت شکری(@)(@@) 44 همه لطفی و همه همتی و پاک خرد %~% چون تو ممدوحی و من جای 
ms531	 دگر اینت خری(@)(@@) 45 من سوی درگهت از بهر صلت جستن تو %~% سست پایی نکنم ار تو کنی سخت سری(@)(@@) 46 همه از کور همی سرمه بینش خواهم %~% همه از هیز همی جویم داروی غری(@)(@@) 47 شکرلله که ترا یافتم ای بحر سخا %~% از تو صلت ز من اشعار به الفاظ دری(@)(@@) 48 اثری نیک بمانیم پس از خود به جهان %~% سخت زیبا بود از مردم نیکو اثری(@)(@@) 49 تا به از ماه بود در شرف قدر زحل %~% تا به از دیو در عمل و چهره پری(@)(@@) 50 باد چندانت بقا تا تو بهر دفتر عمر %~% صدهزاران مه نوروز و رجب بر شمری(@)(@@) 51 بارور باد همه شاخ تو در باغ بقا %~% زان که در باغ عطا سخت به آیین شجری PageV1P0620(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 گرد رخت صف زده لشکر دیو و پری %~% ملک سلیمان تراست گم مکن انگشتری(@)(@@) 2 پرده خوبی بساز امشب و بیرون خرام %~% زهره زهره بسوز زان رخ چون مشتری(@)(@@) 3 از پی موی تو شد بر سر کوی خرد %~% دیده اسلامیان سجده‌گه کافری(@)(@@) 4 کفر ممکن شدی در سر زلفین تو %~% گر بنکردی لبت دعوی پیغمبری(@)(@@) 5 عشق تو آورد خوی خستن بی مرهمی %~% هجر تو آورد رسم کشتن بی داوری(@)(@@) 6 هجر تو مانند وصل هست روا بهر آنک %~% بر سر بازار نیز کور بود مشتری(@)(@@) 7 صلح جدا کن ز جنگ زان که نه نیکو بود %~% دستگه شیشه‌گر پایگه گازری(@)(@@) 8 عقل در دل بکوفت عشق تو گفت اندر آی %~% صدر سرای آن تست گر به حرم ننگری(@)(@@) 9 عشق تو همچون فلک خرمن شادی بداد %~% صد کس را یک ققیز یک کس را صد گری(@)(@@) 10 باشم گستاخ وار با تو که لاشی کند %~% صد گنه این سری یک نظر آن سری(@)(@@) 11 چشم تو هر دم به طعن گوید با چشم من %~% مهره بدست تو بود کم زده‌ای خون گری(@)(@@) 12 حسن 
ms532	 تو جاوید باد تا که ز سودای تو %~% طبع سنایی به شعر ختم کند شاعری(@)(@@) 13 چون تو ز دل برنخورد باری بر آب کار %~% خدمت خسرو گزین تا تو ز خود برخوری(@)(@@) 14 خسرو خسرو نسب سلطان بهرامشاه %~% آنکه چو بهرام هست خاک درش مشتری(@)(@@) 15 هست سنایی به شعر بنده درگاه او %~% زان که مر او راست بس خوی ثنا پروری PageV1P0621(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 با چشم چو بحرم ز گهر خنده نگاری %~% با عیش چو زهرم به شکر بوسه شکاری(@)(@@) 2 برگرد بناگوش چو عاجش خط مشکین %~% چون دای رخ کز شب بکشی گرد نهاری(@)(@@) 3 خورشید نماینده بتی ماه جبینی %~% کافور بناگوش مهی مشک عذاری(@)(@@) 4 خوبی خطش بین که بر آن روی چو لاله %~% کرده ز ره غالیه آساش حصاری(@)(@@) 5 از تیر مژه کوه گذارش دل عاشق %~% خسته شده و پر خون همچون گل ناری(@)(@@) 6 با دو لب چون باده و با چشم چو نرگس %~% با دو رخ چون لاله و با زلف چو قاری(@)(@@) 7 در زلفش از آن دو رخ چون لاله نشاطی %~% در چشمش از آب دو لب چون باده خماری(@)(@@) 8 زین عشوه فروشنده پیوسته دروغی %~% زین بیهده اندیشه بگسسته فساری(@)(@@) 9 چون آبی و چون سیب ازین صد تنه حوری %~% چون نار و چو نارنگ ازین ده له یاری(@)(@@) 10 آتش به تن و جان جهانی زده و آن گه %~% چون آب نبینیش به یک جای قراری(@)(@@) 11 اینجای ز بی رحمی دلسوخته قومی %~% و آنجای ز بی شرمی بر ساخته کاری(@)(@@) 12 هم جان سر او که از آن ماه نخواهم %~% جز بوس و کناری و حدیثی و نظاری(@)(@@) 13 ور خواهم ازو بوس و کناری ز بخیلی %~% چون صبر من از من کند آن ماه کناری(@)(@@) 14 اینک که یکی هفتست کان ماه دو هفته %~% کردست کناره ز پی بوس و کناری(@)(@@) 15 امروز بدیدمش به نومیدی 
ms533	 گفتم %~% کز ریش منت شرم همی ناید باری(@)(@@) 16 دو لعل ز هم باز گشاد از سر طعنه %~% افروخت درین دل ز سر شوخی ناری(@)(@@) 17 گفتا که برو بیش مکن خواجه سنایی %~% با ما چه حسابت ترا یا چه شماری(@)(@@) 18 سیمای تو حقا که چو زر باشد بی سیم %~% گلزار نیابی تو مشو در گلزاری(@)(@@) 19 بی سیم ازین باغ بر آراسته دانم %~% والله که نیابی تو ازین گلبن خاری(@)(@@) 20 گفتم که ندارم چکنم گفت نگارم %~% خواهی که شود کار تو ناگه چو نگاری(@)(@@) 21 در پرده اندیشه بیارای عروسی %~% پس جلوه کنش پیش مهی شاه تباری(@)(@@) 22 آن آیت احسان و شرف زنگی محسن %~% کاسوده شده از رسته احسانش دیاری(@)(@@) 23 آن بحر گهر پاش که نسرشت طبایع %~% همچون گهر اندر گهرش عیب و عواری(@)(@@) 24 آن شمس عطابخش که ننهاد عناصر %~% همچون فلک اندر گهرش دود و بخاری(@)(@@) 25 دوزخ شود از آتش سعیش چو بهشتی %~% گلبن شود از قوت عونش چو چناری(@)(@@) 26 حزمش کند اندر شکم خاک مقامی %~% حلمش کند اندر گهر باد قراری(@)(@@) 27 حقا که به یک لحظه ازین هر دو برآید %~% در آتش و در آب قراری و وقاری(@)(@@) 28 ای زاده ز تو طبع تو از سور سروری %~% وی داده به تو بخت تو از مهر مهاری(@)(@@) 29 در روی سخا از دل چون بحر تو آبی %~% وندر دل بخل از کف چون ابر تو ناری(@)(@@) 30 چون ذات هنر نیست در اوصاف تو عیبی %~% چون فعل خردنیست در اعمال تو عاری(@)(@@) 31 نه دایره یک لحظه کناره کند از سیر %~% گر بروزد از موکب عزم تو غباری(@)(@@) 32 چون لعل فسرده شود آب همه دریا %~% گر تاب دهد آتش عزم تو شراری(@)(@@) 33 ای مرحکما را ز یسار تو یمینی %~% وی مر شعرا را ز یمنین تو یساری(@)(@@) 34 بر اسب امید آمده مجدود سنایی %~% در زیر پی 
ms534	 از بهر کفت راهگذاری(@)(@@) 35 زیرا که ز بی‌پیرهنی از قبل شرم %~% در خانه چو خفاش بدو مانده بشاری(@)(@@) 36 از بهر چه گویند فضولان به یکی کنج %~% چون شپرکی ساخته از روز حصاری(@)(@@) 37 ای خواجه با جود بدان از قبل آنک %~% دارم طمع از جود تو زین شعر شعاری(@)(@@) 38 کاین سینه و پستان چو دو خرمن لاله %~% گشتست ز سرما چو یکی شاخ چناری(@)(@@) 39 چون قله دو پستانگه و چون شیر یکی ناف %~% چون ماه یکی خفته و چون زهره زهاری(@)(@@) 40 چون گرده پیه تنک آن کون چو دنبه %~% از پاره شلوار برون آمده پاری(@)(@@) 41 از پاره شلوار همی تابد لعلش %~% چون از تنکی شیشه بتابد گل ناری(@)(@@) 42 از نازکی و تازگی و فربهی او %~% گوی چو نگاری که نگنجد به کناری(@)(@@) 43 بی موی و در و دوغ فرود آمده مشکی %~% چون شیر و درو موی پدید آمده تاری(@)(@@) 44 وندر بن این سفجه سیمین کفیده %~% نابوده و نامیخته آهخته خیاری(@)(@@) 45 ناداده یکی بوسه چنان کاید ازین لب %~% این فربه ما بر لب و بر فرق نزاری(@)(@@) 46 ارزد برت ای کون همه خوبان دیده %~% این شخص به دراعه و این کون به ازاری PageV1P0622(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای دل ار خواهی که یابی رستگاری آن سری %~% چون نسازی فقر را نعل از کلاه سروری(@)(@@) 2 جانت اندر راه معنی یک قدم ننهد به صدق %~% تا نسازی راه را از دزد باطن رهبری(@)(@@) 3 هر زیادت کان ندارد بر رخان توقیع شرع %~% آن زیادت در جهان عدل بینی کمتری(@)(@@) 4 مرد زی در راه دین با رنگ رعنایی مساز %~% سعتری از ننگ هر نامرد گردد سعتری(@)(@@) 5 همچو گل تر دامنی باشی که رویی در بهار %~% دیده در سرماگشا گر باغ دین را عبهری(@)(@@) 6 با دم سرد و هوای گرم کی گردد بدن %~% بید و آتش نیک ناید صنعت آهنگری(@)(@@) 7 
ms535	 چیست چندین آب و گل را سروری کردن به حرص %~% آب و گل خود مر ترا بسته میان در داوری(@)(@@) 8 بلعجب کاریست چون تو بنگری از روی عقل %~% چون تو اندر آشنایی عقل و دین در کافری(@)(@@) 9 خلق عالم گر ز حکمت ظاهرت گویند مدح %~% هان مگر خود را به نادانی مسلم نشمری(@)(@@) 10 مثله کردی بهر بدنی پیش هر دون اختری %~% مثله بودن بهر بدنی هست از دون اختری(@)(@@) 11 راست چون بکری بود کو داده عذرت را ز دست %~% آب شهوت می ببردش آبروی دختری(@)(@@) 12 آن شبی کش عرس باشد خلق ازو با نای و کوس %~% مادرش خندان و او زان شرم در رسواگری(@)(@@) 13 تنگدستی را همی گر مدبری خوانی ز جهل %~% وای از آن اقبال تو وی مرحبا زین مدبری(@)(@@) 14 از خجالت پیش دین گستاخ نتواند گذشت %~% هر دلی کو کرد سلطان هوا را چاکری(@)(@@) 15 گر چه این معشوق رعنا خوبروی و دلبرست %~% چون سنایی دل از آن سوی تو افتد دل بری(@)(@@) 16 نفس را اندر گرفت و خوردن هر رنگ و بوی %~% ای برادر نیست جز فعل سگ و رای خری(@)(@@) 17 شیر نر بوسد به حرمت مرد قانع را قدم %~% پیره سگ خاید به دندان پای مرد هر دری(@)(@@) 18 سلسبیل از بهر جان تشنگان دارد خدای %~% خرقه‌پوشان را بود آنجا مسلم عبقری(@)(@@) 19 می چه خواهی خوبتر زین از میان هر دوان %~% صدره آنجا سندسی و جبه اینجا ششتری(@)(@@) 20 آنچه اینجا ماند خواهد چند پویی گرد آن %~% گرد آن گرد ار خردمندی که آن با خود بری(@)(@@) 21 هر کرا خشنود تن دین هست ناخشنود ازو %~% مبتلا مردا که دو معشوق را در بر گری(@)(@@) 22 ماه کنعان تا به یک منزل بها هجده درم %~% منزل دیگر بدین و دل بیابد مشتری(@)(@@) 23 گر توانگر میری و مفلس زیی در روز چند %~% به که خوانندت غنی 
ms536	 اینجا و تو مفلس مری(@)(@@) 24 مر امل را پای بشکن از اجل مندیش هیچ %~% مر طمع را پر بکن تا هر کجا خواهی پری(@)(@@) 25 این دو پیمانه که گردانست دایم بر سرت %~% هردو بی‌آرام و تو کاری گرفته سرسری(@)(@@) 26 گر چه عمر نوح یابی اندرین خطه فنا %~% تا بجنبی کرده باشد از تو آثار اسپری(@)(@@) 27 زین جهان خود جز دریغا هیچ کس چیزی نبرد %~% زین جهان آزرده میری گر همه اسکندری(@)(@@) 28 لافت از زورست و زر پیوسته دیدی تا چه کرد %~% زور با عاد قوی ترکیب و زر با سامری(@)(@@) 29 گر همی خواهی که پوسیده نگردی در هوس %~% خانه پرداز از کره خاکی و چرخ چنبری(@)(@@) 30 عالمی دیگر گزین کاین جا نیابی هم نفس %~% کو ز علت تیرگی دارد ز آفت ابتری(@)(@@) 31 اندر آن عالم نیابی محرمی مر جانت را %~% جز صفای احمدی و جز سخای حیدری(@)(@@) 32 ای هوا بر دل نشانده چیست از لابرالاه %~% حصه ی تو هان بده انصاف گر دین پروری(@)(@@) 33 آنچه لا رد کرد تا دل بر نتابی زان همه %~% والله ار یک دم از الا لله هرگز برخوری(@)(@@) 34 گر هوای نفس جویی از در دین در میای %~% یا براهیمی مسلم باشدت یا آزری(@)(@@) 35 تیغ تحقیق از نیام امتحان چون بر کشی %~% هم ببینی حال خود را مهره‌ای یا گوهری(@)(@@) 36 خاک از انصاف دادن این چنین شد محترم %~% تیغ نفرین خورد بر سر آتش از مستکبری(@)(@@) 37 با عقاب تیز چنگ و با همای خوب پر %~% ابلهی باشد که رقاصی کند کبک دری(@)(@@) 38 مر مخالف را چخیدن هست با او همچنانک %~% با عصای موسوی خود اسب تازد سامری(@)(@@) 39 بی چراغ شرع رفتن در ره دین کوروار %~% همچنان باشد که بی خورشید کردن گازری(@)(@@) 40 همچو «لا» بر بند و بگشا گر همی دعوی کنی %~% هم میان و هم زبان را تا 
ms537	 زالله برخوری(@)(@@) 41 رنج کش باش ای برادر همچو خار از بهر آنک %~% زود پژمرده شود در دست گلبرگ طری(@)(@@) 42 بود نوشروان عادل کافری در عهد خود %~% داد دادی باز هر مظلوم را از داوری(@)(@@) 43 شاد باش ای مهتری کز فضل تو در نیم شب %~% کور مادرزاد خواند نقش بر انگشتری(@)(@@) 44 چاکران دولتت را گر دهی یک روز عرض %~% این غریب ممتحن را اندر آن صف بشمری PageV1P0623(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای سنایی بی کله شو گرت باید سروری %~% زانک نزد بخردان تا با کلاهی بی سری(@)(@@) 2 در میان گردنان آیی کلاه از سر بنه %~% تا ازین میدان مردان بو که سر بیرون بری(@)(@@) 3 ور نه در ره سرفرازانند کز تیغ اجل %~% هم کلاه از سرت بربایند هم سر بر سری(@)(@@) 4 عالمی پر لشکر دیوست و سلطان تو دین %~% زان سلطان باش و مندیش از بروت لشگری(@)(@@) 5 دین حسین تست آز و آرزو خوک و سگست %~% تشنه این را می کشی و آن هر دو را می‌پروری(@)(@@) 6 بر یزید و شمر ملعون چون همی لعنت کنی %~% چون حسین خویش را شمر و یزید دیگری(@)(@@) 7 عقل و جان آن جهانی را رعیت شو چو شرع %~% زان که دیوانه‌ست و مرده عاقل و جان ایدری(@)(@@) 8 چشمه حیوانت باید خاک ره شو چون خضر %~% هر دو نبود مر ترا با چشمه یا اسکندری(@)(@@) 9 گرد جعفر گرد گر دین جعفری جویی همی %~% زان که نبود هر دو هم دینار و هم دین جعفری(@)(@@) 10 چون تو دادی دین به دنیا در ره دین کی کنند %~% پنج حس و هفت اعضا مر ترا فرمانبری(@)(@@) 11 تا سلیمان‌وار خاتم باز نستانی ز دیو %~% کی ترا فرمان برد دام و دد و دیو و پری(@)(@@) 12 بی پدر فرزندی لاهوت باید چون مسیح %~% هر که زو برگشت با ناسوت یابد دختری(@)(@@) 13 اختر نیکوت باید بر سپهر 
