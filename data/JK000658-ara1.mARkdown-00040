ms26	 صاحب التصانيف PageV01P104(@)(@@)(@@)(@@) $ 1189 والحافظ أبو محمد الفضل بن محمد بن المسيب الشعراني البيهقي(@)(@@)(@@)(@@) $ 1190 وحافظ بغداد أبو عبدالرحمن عبدالله بن أحمد بن حنبل الشيباني(@)(@@)(@@)(@@) $ 1191 والحافظ أبو محمد عبدالرحمن بن يوسف بن خراش البغدادي(@)(@@)(@@)(@@) $ 1192 والإمام أبو عبدالله محمد بن إبراهيم بن سعيد البوشنجي الحافظ المصنف(@)(@@)(@@)(@@) $ 1193 والحافظ أبو بكر أحمد بن عمرو بن عبد الخالق البصري البزار صاحب المسند الكبير(@)(@@)(@@)(@@) $ 1194 ومسند الوقت أبو مسلم إبراهيم بن عبدالله الكجي البصري صاحب المسند(@)(@@)(@@)(@@) $ 1195 وحافظ بخاري أبو علي صالح بن محمد الأسدي البغدادي جزرة الحافظ(@)(@@)(@@)(@@) $ 1196 ومحدث الري أبو عبدالله محمد بن أيوب بن يحيى بن الضريس البجلي الرازي(@)(@@)(@@)(@@) $ 1197 وعالم خراسان الإمام أبو عبدالله محمد بن نصر المروزي الحافظ بسمرقند PageV01P105(@)(@@)(@@)(@@) $ 1198 وحافظ بغداد أبو عمران موسى بن هارون بن عبدالله البزار ويعرف بابن الحمال(@)(@@)(@@)(@@) $ 1199 والحافظ أبو علي اسماعيل بن يوسف الديلمي العابد ولا يعرف قال أبو الحسين بن المنادي قال لي إنه يحفظ أربعين ألف حديث قلت روى عن مجاهد بن موسى وكان أمين رحا(@)(@@)(@@)(@@) $ 1200 وحافظ نيسابور إبراهيم بن أبي طالب المزكي(@)(@@)(@@)(@@) $ 1201 وحافظ بغداد أبو علي الحسن بن علي بن شبيب المعمري(@)(@@)(@@)(@@) $ 1202 والحافظ أبو جعفر محمد بن عثمان بن أبي شيبة العبسي(@)(@@)(@@)(@@) $ 1203 والحافظ أبو جعفر محمد بن عبدالله بن سليمان مطين الحضرمي الكوفيان(@)(@@)(@@)(@@) $ 1204 ومحدث بغداد أبو محمد يوسف بن يعقوب القاضي صاحب السنن(@)(@@)(@@)(@@) $ 1205 والأمام الزاهد أبو عمر وأحمد بن نصر النيسابوري الخفاف الحافظ وكان يذاكر بمائة ألف حديث PageV01P106(@)(@@)(@@)(@@) | ( 11 ) الطبقة الذين بقوا إلى بعد الثلاثمائة وإلى حدود العشرين وثلاثمائة(@)(@@)(@@)(@@) $ 1206 أبو خليفة الفضل بن الحباب الجمحي شيخ البصرة(@)(@@)(@@)(@@) $ 1207 والحافظ أبو بكر جعفر بن محمد بن الحسن الفريابي صاحب التصانيف(@)(@@)(@@)(@@) $ 1208 والإمام أبو عبدالرحمن أحمد بن شعيب النسائي صاحب السنن حافظ العصر(@)(@@)(@@)(@@) $ 1209 وأبو العباس الحسن بن سفيان الشيباني النسوي الحافظ صاحب المسند(@)(@@)(@@)(@@) $ 1210 وعبد الله بن أحمد بن موسى عبدان الأهوازي الحافظ(@)(@@)(@@)(@@) $ 1211 وعبد الله بن محمد بن ناجية البغدادي الحافظ 
ms27	(@)(@@)(@@)(@@) $ 1212 ومحدث الموصل أبو يعلى أحمد بن علي بن المثنى التميمي الحافظ صاحب المسند(@)(@@)(@@)(@@) $ 1213 ومحدث البصرة أبو يحيى زكريا بن يحيى الساجي الحافظ PageV01P107(@)(@@)(@@)(@@) $ 1214 وأبو أسحاق إبراهيم بن محمد بن سفيان النيسابوري الفقيه صاحب مسلم(@)(@@)(@@)(@@) $ 1215 والإمام أبو جعفر أحمد بن يحيى التستري الحافظ(@)(@@)(@@)(@@) $ 1216 والإمام شيخ العصر أبو جعفر محمد بن جرير الطبري صاحب الكتب(@)(@@)(@@)(@@) $ 1217 والمحدث الإمام أبو بكر أحمد بن محمد بن هارون الخلال الفقيه(@)(@@)(@@)(@@) $ 1218 ومحدث بخاري أبو حفص عمر بن محمد بن بجير الحافظ مصنف الصحيح(@)(@@)(@@)(@@) $ 1219 وأمام الأئمة أبو بكر محمد بن إسحاق بن خزيمة النيسابوري الحافظ(@)(@@)(@@)(@@) $ 1220 ومحدث خراسان أبو العباس محمد بن إسحاق الثقفي السراح الحافظ(@)(@@)(@@)(@@) $ 1221 ومحدث بغداد أبو بكر محمد بن محمد بن سليمان الباغندي الحافظ(@)(@@)(@@)(@@) $ 1222 ومسند العصر المحدث الحافظ أبو القاسم عبدالله بن محمد ابن عبدالعزيز البغوي مصنف معجم الصحابة PageV01P108(@)(@@)(@@)(@@) $ 1223 والحافظ الكبير محمد بن المسيب الأرغياني(@)(@@)(@@)(@@) $ 1224 والحافظ أبو بكر عبدالله بن أبي داود السجستاني(@)(@@)(@@)(@@) $ 1225 والحافظ أبو عروبة الحسين بن أبي معشر الحراني(@)(@@)(@@)(@@) $ 1226 والحافظ أبو عوانة يعقوب بن إسحاق الاسفرائيني صاحب الصحيح(@)(@@)(@@)(@@) $ 1227 والحافظ أبو محمد يحيى بن محمد بن صاعد الهاشمي مولاهم(@)(@@)(@@)(@@) $ 1228 والقاضي أبو جعفر أحمد بن إسحاق بن بهلول التنوخي وكان علامة(@)(@@)(@@)(@@) $ 1229 والحافظ محمد بن هارون الروياني وله مسند متوسط(@)(@@)(@@)(@@) $ 1230 والحافظ أبو بشر محمد بن أحمد بن حماد الدولابي(@)(@@)(@@)(@@) $ 1231 وأبو الحسن أحمد بن عمير بن جوصاء الحافظ بدمشق وخلق أضعاف هؤلاء لعل فيهم أحفظ مما ذكرت PageV01P109(@)(@@)(@@)(@@) | ( 12 ) طبقة كانوا في حدود العشرين وثلاثمائة وإلى قريب الخمسين(@)(@@)(@@)(@@) $ 1232 محمد بن يوسف بن عبدالله الفربري صاحب البخاري محدث(@)(@@)(@@)(@@) $ 1233 والحافظ أبو حامد أحمد بن حمدون الأعمشي خراساني ثقة(@)(@@)(@@)(@@) $ 1234 والحافظ أبو جعفر أحمد بن محمد بن سلامة الطحاوي الفقيه حجة(@)(@@)(@@)(@@) $ 1235 وحافظ الأندلس أبو عمر أحمد بن خالد بن الجباب(@)(@@)(@@)(@@) $ 1236 والحافظ أبو جعفر محمد بن عمرو العقيلي بالحجاز(@)(@@)(@@)(@@) $ 1237 والحافظ أبو طالب أحمد بن محمد بن الشرقي النيسابوري(@)(@@)(@@)(@@) $ 1238 
ms28	 والحافظ أبو العباس محمد بن عبدالرحمن الدغولي(@)(@@)(@@)(@@) $ 1239 والحافظ الكبير أبو محمد عبد الرحمن بن أبي حاتم الرازي(@)(@@)(@@)(@@) $ 1240 والقاضي أبو عبدالله الحسين بن إسماعيل الضبي المحاملي(@)(@@)(@@)(@@) $ 1241 والحافظ أبو عبدالله محمد بن مخلد العطار PageV01P110(@)(@@)(@@)(@@) $ 1242 الحافظ الكبير أبو العباس أحمد بن محمد بن سعيد بن عقدة الكوفي(@)(@@)(@@)(@@) $ 1243 وأبو العباس محمد بن أحمد بن حماد بن الأثرم البغدادي نزيل البصرة ومسندها(@)(@@)(@@)(@@) $ 1244 والحافظ أبو عبدالله عبدالرحمن بن أحمد الختلي عن تمتام روى من حفظه خمسين ألف حديث(@)(@@)(@@)(@@) $ 1245 والهيثم بن كليب الشاشي الحافظ صاحب المسند(@)(@@)(@@)(@@) $ 1246 ومحدث بغداد أبو جعفر محمد بن عمرو بن البختري الرزاز ثقة(@)(@@)(@@)(@@) $ 1247 ومحدث الحرم أحمد بن محمد بن زياد الأعرابي صاحب المعجم ثقة(@)(@@)(@@)(@@) $ 1248 وقاسم بن أصبغ محدث الأندلس ثقة(@)(@@)(@@)(@@) $ 1249 وأبو علي إسماعيل بن محمد الصفار محدث بغداد ثقة(@)(@@)(@@)(@@) $ 1250 والحافظ خيثمة بن سليمان بن حيدرة محدث الشام ثقة(@)(@@)(@@)(@@) $ 1251 ومحدث خراسان أبو العباس الأصم محمد بن يعقوب بن يوسف ثقة(@)(@@)(@@)(@@) $ 1252 ومحدث بغداد أبو عمرو عثمان بن أحمد بن السماك الدقاق شيخ PageV01P111(@)(@@)(@@)(@@) $ 1253 ومحدث العجم علي بن إبراهيم بن سلمة القطان الحافظ حجة(@)(@@)(@@)(@@) $ 1254 وأبو العباس محمد بن أحمد بن محبوب المحبوبي صاحب الترمذي شيخ(@)(@@)(@@)(@@) $ 1255 والحافظ أبو سعيد بن يونس الصدفي المصري ثقة(@)(@@)(@@)(@@) $ 1256 وشيخ بغداد أبو بكر أحمد بن سليمان بن الحسن النجاد الفقيه الحافظ صدوق(@)(@@)(@@)(@@) $ 1257 والمحدث أبو سهل أحمد بن محمد بن عبدالله بن زياد القطان شيخ(@)(@@)(@@)(@@) $ 1258 ومسند مصر أبو الفوارس أحمد بن محمد السندي ابن الصابوني شيخ(@)(@@)(@@)(@@) $ 1259 والحافظ أبو عبدالله محمد بن يعقوب ابن الأخرم الشيباني النيسابوري ثقة PageV01P112(@)(@@)(@@)(@@) | ( 13 ) طبقة تليهم إلى السبعين وثلاثمائة(@)(@@)(@@)(@@) $ 1260 الحافظ أبوعلي الحسين بن محمد النيسابوري(@)(@@)(@@)(@@) $ 1261 والحافظ أبو أحمد محمد بن أحمد العسال الأصبهاني القاضي(@)(@@)(@@)(@@) $ 1262 والحافظ أبو الحسين عبدالباقي بن قانع ليس بقوي(@)(@@)(@@)(@@) $ 1263 ومحدث البصرة أبو إسحاق إبراهيم بن علي الهجيمي شيخ(@)(@@)(@@)(@@) $ 1264 والمحدث دعلج بن أحمد السجزي ثقة(@)(@@)(@@)(@@) $ 1265 والحافظ أبو اسحاق إبراهيم بن محمد 
ms29	 بن حمزة الأصبهاني حجة(@)(@@)(@@)(@@) $ 1266 والحافظ أبو علي سعيد بن عثمان بن السكن حجة(@)(@@)(@@)(@@) $ 1267 ومحدث العراق أبو بكر محمد بن عبدالله بن إبراهيم الشافعي ثقة(@)(@@)(@@)(@@) $ 1268 والحافظ أبو حاتم محمد بن حبان البستي ثقة(@)(@@)(@@)(@@) $ 1269 والحافظ أبو بكر محمد بن عمرو بن مسلم الجعابي تكلم فيه(@)(@@)(@@)(@@) $ 1270 والحافظ أبو القاسم حمزة بن محمد الكناني المصري ثقة PageV01P113(@)(@@)(@@)(@@) $ 1271 والمسند أبو بكر أحمد بن يوسف بن خلاد النصيبي البغدادي شيخ(@)(@@)(@@)(@@) $ 1272 والمحدث أبو علي محمد بن أحمد بن الحسن الصواف(@)(@@)(@@)(@@) $ 1273 والحافظ مسند العصر أبو القاسم سليمان بن أحمد الطبراني بأصبهان ثقة(@)(@@)(@@)(@@) $ 1274 وأبو بكر محمد بن جعفر بن الهيثم الأنباري شيخ(@)(@@)(@@)(@@) $ 1275 وشيخ الحرم أبو بكر محمد بن الحسين الآجري البغدادي صاحب التواليف ثقة(@)(@@)(@@)(@@) $ 1276 وشيخ نيسابور أبو عمرو محمد بن جعفر بن مطر ثقة(@)(@@)(@@)(@@) $ 1277 والحافظ أبو بكر أحمد بن اسحاق بن السني الدينوري صاحب النسائي ثقة(@)(@@)(@@)(@@) $ 1278 والإمام أبو عمرو اسماعيل بن محمد بن نجيد بنيسابور شيخ(@)(@@)(@@)(@@) $ 1279 والحافظ أبو أحمد عبدالله بن عدي الجرجاني ثقة(@)(@@)(@@)(@@) $ 1280 وقاضي مصر ومحدثها أبو الطاهر محمد بن أحمد الذهلي شيخ(@)(@@)(@@)(@@) $ 1281 ومسند العراق أبو بكر أحمد بن جعفر بن حمدان القطيعي شيخ(@)(@@)(@@)(@@) $ 1282 وأبو أحمد محمد بن عيسى بن عمرويه الجلودي راوي صحيح مسلم ثقة PageV01P114(@)(@@)(@@)(@@) $ 1283 والشيخ أبو محمد بن عبدالله بن أيوب بن ماسي البزاز ثقة(@)(@@)(@@)(@@) $ 1284 والحافظ أبو محمد أبو الشيخ عبدالله بن محمد بن حبان الأصبهاني صاحب التصانيف(@)(@@)(@@)(@@) $ 1285 ومحدث مصر أبو محمد الحسن بن رشيق شيخ(@)(@@)(@@)(@@) $ 1286 والحافظ أبو بكر أحمد بن إبراهيم الإسماعيلي الجرجاني الفقيه حجة إمام PageV01P115(@)(@@)(@@)(@@) | ( 14 ) طبقة من حدود السبعين وإلى قريب الأربعمائة(@)(@@)(@@)(@@) $ 1287 أبو أحمد الحسين بن علي التميمي حسينك الحافظ(@)(@@)(@@)(@@) $ 1288 والمحدث أبو حفص عمر بن محمد الزيات شيخ(@)(@@)(@@)(@@) $ 1289 والقاضي أبو بكر يوسف بن القاسم الميانجي ثقة(@)(@@)(@@)(@@) $ 1290 ومحمد بن عباس بن وصيف الغزي راوي الموطأ شيخ(@)(@@)(@@)(@@) $ 1291 والحافظ أبو الفتح محمد بن الحسين الأزدي المصري لين(@)(@@)(@@)(@@) $ 1292 وراوي الصحيح أبو 
ms30	 إسحاق إبراهيم بن أحمد المستملي البلخي(@)(@@)(@@)(@@) $ 1293 وأبو زيد محمد بن أحمد المروزي الفقيه(@)(@@)(@@)(@@) $ 1294 وأبو محمد عبدالله بن أحمد بن حموية السرخسي(@)(@@)(@@)(@@) $ 1295 وأبو الهيثم محمد بن مكي الكشميهني المروزي(@)(@@)(@@)(@@) $ 1296 وأبو علي إسماعيل بن محمد بن حاجب الكشاني(@)(@@)(@@)(@@) $ 1297 ومحدث الكوفة علي بن عبدالرحمن بن السري البكائي ثقة PageV01P116(@)(@@)(@@)(@@) $ 1298 ومحدث نيسابور أبو عمرو محمد بن أحمد بن حمدان الحيري ثقة(@)(@@)(@@)(@@) $ 1299 ومحدث جرجان أبو أحمد محمد بن أحمد بن الغطريف ثقة(@)(@@)(@@)(@@) $ 1300 ومحدث بخارى أبو عمرو محمد بن أحمد بن صابر ثقة(@)(@@)(@@)(@@) $ 1301 ومحدث جرجرايا أبو بكر محمد بن أحمد المفيد ضعيف(@)(@@)(@@)(@@) $ 1302 والحافظ أبو أحمد محمد بن محمد بن أحمد الحاكم(@)(@@)(@@)(@@) $ 1303 والحافظ أبو الحسين محمد بن المظفر البغدادي(@)(@@)(@@)(@@) $ 1304 ومحدث أصبهان أبو بكر محمد إبراهيم بن المقري(@)(@@)(@@)(@@) $ 1305 ومسند بغداد أبو الفضل عبيد الله بن عبدالله الزهري(@)(@@)(@@)(@@) $ 1306 والعلامة أبو أحمد الحسن بن محمد بن عبدالله بن سعيد العسكري(@)(@@)(@@)(@@) $ 1307 ومسند خراسان أبو سعيد عبدالله بن محمد بن عبدالوهاب الرازي(@)(@@)(@@)(@@) $ 1308 ومحدث بغداد أبو عمر محمد بن العباس بن حيوية(@)(@@)(@@)(@@) $ 1309 وحافظ الوقت أبو الحسن علي بن عمر الدارقطني(@)(@@)(@@)(@@) $ 1310 ومحدث مصر أبو بكر أحمد بن محمد بن إسماعيل المهندس PageV01P117(@)(@@)(@@)(@@) $ 1311 والحافظ أبو حفص عمر بن أحمد بن عثمان بن شاهين(@)(@@)(@@)(@@) $ 1312 والمحدث المتقن أبو بكر أحمد بن إبراهيم بن شاذان البزار والد أبي علي(@)(@@)(@@)(@@) $ 1313 والحافظ أبو بكر أحمد بن عبدان الشيرازي محدث الأهواز(@)(@@)(@@)(@@) $ 1314 والحافظ أبو محمد الحسن بن علي بن عمرو الزهري(@)(@@)(@@)(@@) $ 1315 والمسند أبو الحسن علي بن عمر الحربي السكري(@)(@@)(@@)(@@) $ 1316 والزاهد أبو الحسين محمد بن أحمد بن سمعون(@)(@@)(@@)(@@) $ 1317 وأبو علي زاهر بن أحمد السرخسي(@)(@@)(@@)(@@) $ 1318 وأبو بكر محمد بن عبدالله بن محمد الجوزقي(@)(@@)(@@)(@@) $ 1319 وأبو محمد الحسن بن أحمد المخلدي(@)(@@)(@@)(@@) $ 1320 وأبو حفص عمر بن إبراهيم الكتاني المقرىء(@)(@@)(@@)(@@) $ 1321 والمعافى بن زكريا الجريري الحافظ(@)(@@)(@@)(@@) $ 1322 وأبو القاسم عيسى بن علي بن الجراح الوزير(@)(@@)(@@)(@@) $ 1323 وأبو القاسم عبيدالله بن حبابة(@)(@@)(@@)(@@) $ 1324 
ms31	 وأبو طاهر محمد بن عبدالرحمن بن العباس المخلص PageV01P118(@)(@@)(@@)(@@) $ 1325 وأبو محمد عبدالرحمن بن أحمد بن محمد بن أبي شريح الهروي(@)(@@)(@@)(@@) $ 1326 وأبو الحسين أحمد بن محمد بن عمر القنطري الخفاف(@)(@@)(@@)(@@) $ 1327 وعبدالوهاب بن الحسن الكلابي الدمشقي(@)(@@)(@@)(@@) $ 1328 والقاضي أبو الحسن علي بن محمد الحلبي(@)(@@)(@@)(@@) $ 1329 والحافظ أبو عبدالله محمد بن إسحاق بن مندة الأصبهاني(@)(@@)(@@)(@@) $ 1330 وأبو مسلم محمد بن أحمد بن علي الكاتب(@)(@@)(@@)(@@) $ 1331 وأبو نعيم عبدالله بن نعيم الأسفرائيني صاحب أبي عوانة(@)(@@)(@@)(@@) $ 1332 والحافظ الحسين بن أحمد بن بكير البغدادي وكان واسع المعرفة PageV01P119 $ (@)(@@)(@@)(@@) | ( 15 ) طبقة من بعد الأربعمائة إلى خمس وعشرين سنة(@)(@@)(@@)(@@) $ 1333 أبوإسحاق إبراهيم بن عبدالله بن خرشيد قوله الأصبهاني(@)(@@)(@@)(@@) $ 1334 وأبو الحسين محمد بن أحمد بن جميع الغساني(@)(@@)(@@)(@@) $ 1335 وعلي بن أحمد السامري الرفاء(@)(@@)(@@)(@@) $ 1336 والقاضي محمد بن عبدالله الجعفي الكوفي(@)(@@)(@@)(@@) $ 1337 والإمام أبو عبدالله الحسين بن الحسن الحليمي(@)(@@)(@@)(@@) $ 1338 وأحمد بن إبراهيم بن فراس العبقسي المكي(@)(@@)(@@)(@@) $ 1339 وأبو الحسن محمد بن أحمد بن الصلت المجبر(@)(@@)(@@)(@@) $ 1340 والحافظ أبو عبدالله محمد بن عبدالله بن محمد بن نعيم الضبي الحاكم ابن البيع(@)(@@)(@@)(@@) $ 1341 ومسند دمشق أبو بكر محمد بن أحمد بن عثمان بن أبي الحديد السلمي(@)(@@)(@@)(@@) $ 1342 وشيخ الشافعية أبو حامد أحمد بن أبي طاهر الاسفرائيني ببغداد PageV01P120(@)(@@)(@@)(@@) $ 1343 وأبو أحمد عبيد الله بن محمد بن أبي مسلم البغدادي الفرضي المقرىء(@)(@@)(@@)(@@) $ 1344 وأبو عبيد الله محمد بن إبراهيم بن جعفر اليزدي الجرجاني(@)(@@)(@@)(@@) $ 1345 وأبو الطيب محمد بن أحمد بن خلف بن خاقان العكبري نزيل بغداد عاش أربعا وتسعين سنة ثقة(@)(@@)(@@)(@@) $ 1346 وآخر أصحاب المحاملي أبو عمر عبدالواحد بن محمد بن مهدي الفارسي(@)(@@)(@@)(@@) $ 1347 وأبو محمد عبدالله بن عبيد الله ابن البيع(@)(@@)(@@)(@@) $ 1348 وأبو الحسن أحمد بن عبدالعزيز بن ثرثال(@)(@@)(@@)(@@) $ 1349 وأبو الحسين بن المتيم(@)(@@)(@@)(@@) $ 1350 وأبو الحسن محمد بن أحمد بن الصلت الأهوازي(@)(@@)(@@)(@@) $ 1351 وعبدالله بن يوسف الأصبهاني(@)(@@)(@@)(@@) $ 1352 والحافظ أبو محمد عبدالغني بن سعيد الأزدي المصري(@)(@@)(@@)(@@) $ 1353 والحافظ أبو بكر أحمد بن موسى بن مردوية الأصبهاني(@)(@@)(@@)(@@) $ 1354 والفقيه 
ms32	 أبو طاهر محمد بن محمد بن محمش الزيادي النيسابوري PageV01P121(@)(@@)(@@)(@@) $ 1355 والحافظ أبو سعد أحمد بن محمد الماليني(@)(@@)(@@)(@@) $ 1356 وعبدالجبار بن محمد بن عبدالله الجراحي راوي الترمذي(@)(@@)(@@)(@@) $ 1357 والحافظ أبو الفضل أحمد بن علي بن عمرو السليماني محدث بخاري(@)(@@)(@@)(@@) $ 1358 والمحدث أبو الحسن محمد بن أحمد بن رزقوية(@)(@@)(@@)(@@) $ 1359 والحافظ أبو الفتح محمد بن أحمد بن أبي الفوارس(@)(@@)(@@)(@@) $ 1360 وأبو عبدالرحمن محمد بن الحسين السلمي صاحب التصانيف(@)(@@)(@@)(@@) $ 1361 والحافظ أبو الفضل محمد بن أحمد الجارودي(@)(@@)(@@)(@@) $ 1362 والحافظ تمام بن محمد بن عبدالله الرازي محدث دمشق(@)(@@)(@@)(@@) $ 1363 وأبو الحسن علي بن محمد بن ميلة بن ماشاذة الأصبهاني الفرضي(@)(@@)(@@)(@@) $ 1364 والقاضي أبو عمر جعفر بن عبدالواحد الهاشمي البصري راوي سنن أبي داود(@)(@@)(@@)(@@) $ 1365 والحافظ أبو سعيد محمد بن علي الأصبهاني النقاش(@)(@@)(@@)(@@) $ 1366 ومسند بغداد أبو الفتح هلال بن محمد بن جعفر الحفار PageV01P122(@)(@@)(@@)(@@) $ 1367 ومسند بغداد أبو الحسين علي بن محمد بن عبدالله بن بشران(@)(@@)(@@)(@@) $ 1368 ومسند مصر أبو محمد عبدالرحمن بن عمر بن محمد ابن النحاس البزاز(@)(@@)(@@)(@@) $ 1369 وأبو محمد بن عبدالله بن يحيى بن عبدالجبار السكري ببغداد(@)(@@)(@@)(@@) $ 1370 ومقرىء العراق علي بن أحمد بن عمر بن حفص ابن الحمامي(@)(@@)(@@)(@@) $ 1371 والحافظ أبو حازم عمر بن أحمد بن إبراهيم العبدوي النيسابوري(@)(@@)(@@)(@@) $ 1372 والعلامة أبو إسحاق إبراهيم بن محمد بن إبراهيم بن مهران الإسفرائني الأصولي(@)(@@)(@@)(@@) $ 1373 والحافظ أبو القاسم هبة الله بن الحسين اللألكائي الشافعي(@)(@@)(@@)(@@) $ 1374 والمسند أبو الحسن محمد بن إبراهيم بن مخلد الرزاز(@)(@@)(@@)(@@) $ 1375 ومسند دمشق أبو محمد عبدالرحمن بن عثمان بن أبي نصر التميمي(@)(@@)(@@)(@@) $ 1376 ومسند خراسان القاضي أبو بكر أحمد بن محمد بن الحسن الحيري الحرشي PageV01P123(@)(@@)(@@)(@@) $ 1377 وأبو سعيد محمد بن موسى الصيرف النيسابوريان(@)(@@)(@@)(@@) $ 1378 وراوي جامع الترمذي إسماعيل بن ينال المحبوبي المروزي(@)(@@)(@@)(@@) $ 1379 وأبو القاسم عبدالرحمن بن عبيدالله الحربي البغدادي(@)(@@)(@@)(@@) $ 1380 ومنصور بن نصر بن عبدالرحيم أبو الفضل السمرقندي الكاغذي صاحب القاسم بن كليب(@)(@@)(@@)(@@) $ 1381 والحافظ أبو بكر أحمد بن غالب البرقاني ببغداد(@)(@@)(@@)(@@) $ 1382 وأبو علي الحسن بن أحمد 
ms33	 بن إبراهيم بن شاذان البزاز PageV01P124(@)(@@)(@@)(@@) | ( 16 ) طبقة إلى الخمسين وأربعمائة(@)(@@)(@@)(@@) $ 1383 العلامة أبو إسحاق أحمد بن محمد بن إبراهيم التغلبي النيسابوري المفسر(@)(@@)(@@)(@@) $ 1384 وأبو بكر محمد بن علي بن إبراهيم التغلبي النيسابوري المفسر(@)(@@)(@@)(@@) $ 1385 وأبو بكر محمد بن علي بن مصعب التاجر الأصبهاني بنيسابور(@)(@@)(@@)(@@) $ 1386 والحافظ أبو الفتح حمزة بن يوسف السهمي الجرجاني(@)(@@)(@@)(@@) $ 1387 والحافظ أبو بكر أحمد بن علي بن منجويه اليزدي الأصبهاني بنيسابور كتبي الإسماعيلي(@)(@@)(@@)(@@) $ 1388 والمسند أبو عمرو عثمان بن محمد بن يوسف بن دوست العلاف(@)(@@)(@@)(@@) $ 1389 والحافظ أبو الحسن علي بن محمد بن إبراهيم الحنائي الدمشقي وله معجم في مجلد(@)(@@)(@@)(@@) $ 1390 والحافظ أبو عمر أحمد بن محمد بن عبدالله بن أبي عيسى المعافري الطلمنكي لقي أبا عيسى يحيى بن عبد الله راوي الموطأ(@)(@@)(@@)(@@) $ 1391 والحافظ المكي أبو يعقوب إسحاق بن أبي إسحاق إبراهيم بن محمد ابن القراب الهروي PageV01P125(@)(@@)(@@)(@@) $ 1392 والأستاذ أبو منصور عبدالقاهر بن طاهر البغدادي الأصولي بأسفرائين(@)(@@)(@@)(@@) $ 1393 وقاضي الجماعة أبو الوليد يونس بن عبدالله بن مغيث القرطبي ابن الصفار مسند الأندلس(@)(@@)(@@)(@@) $ 1394 والحافظ الشهير أبو نعيم أحمد بن عبدالله بن أحمد الأصبهاني صاحب الحلية(@)(@@)(@@)(@@) $ 1395 ومسند العراق أبو القاسم عبدالملك بن محمد بن عبدالله بن بشران الواعظ(@)(@@)(@@)(@@) $ 1396 والعلامة أبو عمران الفاسي موسى بن عيسى بن أبي رباح شيخ القيروان(@)(@@)(@@)(@@) $ 1397 والقاضي أبوالعلاء محمد بن علي بن أحمد بن يعقوب الواسطي(@)(@@)(@@)(@@) $ 1398 ومسند ديار مصر أبو عبدالله محمد بن الفضل بن نظيف الفراء(@)(@@)(@@)(@@) $ 1399 والحافظ أبو العباس جعفر بن محمد بن المعتز المستغفري النسفي(@)(@@)(@@)(@@) $ 1400 وأبو بكر محمد بن عمر بن بكير النجار البغدادي(@)(@@)(@@)(@@) $ 1401 وراوي سنن النسائي القاضي أبو نصر أحمد بن الحسين الدينوري الكسار(@)(@@)(@@)(@@) $ 1402 وصاحب الطبراني أبو الحسين أحمد بن الحسين بن فادشاه الأصبهاني PageV01P126(@)(@@)(@@)(@@) $ 1403 وراوية النقاش أبو القاسم علي بن محمد العلوي الزيدي الحراني(@)(@@)(@@)(@@) $ 1404 ومسند دمشق أبو الحسن علي بن موسى بن السمسار(@)(@@)(@@)(@@) $ 1405 والحافظ أبو ذر عبد بن أحمد الأنصاري الهروي المالكي شيخ الحرم(@)(@@)(@@)(@@) $ 1406 وأبو بكر أحمد 
ms34	 بن جعفر الميماسي رواي الموطأ(@)(@@)(@@)(@@) $ 1407 والحافظ علي بن الحسن الربعي الدمشقي ومن محفوظاته غريب الحديث لأبي عبيد(@)(@@)(@@)(@@) $ 1408 والإمام أبو محمد مكي بن أبي طالب القيسي القرطبي(@)(@@)(@@)(@@) $ 1409 والحافظ أبو محمد الحسن بن محمد بن الحسن الخلال ببغداد(@)(@@)(@@)(@@) $ 1410 ومسند أصبهان أبو بكر محمد بن عبدالله بن ريذة التاجر(@)(@@)(@@)(@@) $ 1411 ومسند العراق أبو طالب محمد بن محمد بن إبراهيم بن غيلان البزاز(@)(@@)(@@)(@@) $ 1412 والمحدث أبو الحسن أحمد بن محمد بن أحمد العتيقي البغدادي(@)(@@)(@@)(@@) $ 1413 والفقيه أبو الحسن علي بن إبراهيم بن سختام السمرقندي(@)(@@)(@@)(@@) $ 1414 وصاحب مجلس البطاقة أبو الحسن بن حمصة بمصر PageV01P127(@)(@@)(@@)(@@) $ 1415 والحافظ الكبير أبو عبدالله محمد بن علي الصوري(@)(@@)(@@)(@@) $ 1416 والإمام أبو الحسن علي بن عمر القزويني البغدادي الزاهد(@)(@@)(@@)(@@) $ 1417 ومسند مصر أبو القاسم علي بن محمد بن علي الفارسي سمع منه الرازي ستين جزءا(@)(@@)(@@)(@@) $ 1418 ومسند دمشق أبو عبدالله محمد بن عبدالسلام بن سعدان(@)(@@)(@@)(@@) $ 1419 ومسند مكة أبو الحسن محمد بن علي بن محمد بن صخر الأزدي القاضي(@)(@@)(@@)(@@) $ 1420 ومسند مرو أبو غانم أحمد بن علي الكراعي(@)(@@)(@@)(@@) $ 1421 ومسند بغداد أبو علي الحسن بن علي بن محمد بن المذهب الوعظ(@)(@@)(@@)(@@) $ 1422 والحافظ أبو نصر عبيدالله بن سعيد الوائلي البكري بمكة(@)(@@)(@@)(@@) $ 1423 والحافظ أبو عمرو عثمان بن سعيد الداني المقرئ(@)(@@)(@@)(@@) $ 1424 والفقيه المسند أبو إسحاق إبراهيم بن عمر البرمكي(@)(@@)(@@)(@@) $ 1425 والحافظ أبو سعد إسماعيل بن علي بن السمان الرازي سمع من ثلاثة الآف شيخ PageV01P128(@)(@@)(@@)(@@) $ 1426 وصاحب أبي الشيخ أبو طاهر محمد بن أحمد بن عبدالرحيم الأصبهان الكاتب(@)(@@)(@@)(@@) $ 1427 ومسند الكوفة أبو عبدالله محمد بن علي بن الحسن بن عبدالرحمن العلوي(@)(@@)(@@)(@@) $ 1428 ومقرىء الشام الحسن بن علي بن إبراهيم الأهوازي(@)(@@)(@@)(@@) $ 1429 والحافظ أبو يعلي الخليل بن عبدالله بن أحمد القزويني الخليلي(@)(@@)(@@)(@@) $ 1430 ومسند دمشق أبو الحسين محمد بن عبدالرحمن بن عثمان بن أبي نصر التميمي المعدل(@)(@@)(@@)(@@) $ 1431 ومسند الأندلس حكم بن محمد بن حكم أبو العباس الجذامي(@)(@@)(@@)(@@) $ 1432 وأبو الحسن محمد بن إسحاق بن محمد بن فدوية الكوفي 
ms35	 المعدل صاحب البكائي(@)(@@)(@@)(@@) $ 1433 والإمام أبو الفتح سليم بن أيوب بن سليم الرازي الفقيه(@)(@@)(@@)(@@) $ 1434 والقاضي أبو القاسم علي بن الحسن بن علي التنوخي البغدادي(@)(@@)(@@)(@@) $ 1435 وأبو عبدالله محمد بن علي بن سلوان بدمشق وليس عنده سوى نسخة أبي مسهر(@)(@@)(@@)(@@) $ 1436 ومسند خراسان أبو الحسين عبدالغافر بن محمد الفارس راوي الصحيح PageV01P129(@)(@@)(@@)(@@) $ 1437 وأبو حفص عمر بن أحمد بن مسرور النيسابوري الزاهد(@)(@@)(@@)(@@) $ 1438 ومسند مصر أبو الحسن محمد بن الحسين النيسابوري ثم المصري ابن الطفال(@)(@@)(@@)(@@) $ 1439 والحافظ أبو مسعود أحمد بن محمد بن عبدالله بن عبدالعزيز البجلي الرازي ببخارى(@)(@@)(@@)(@@) $ 1440 وشيخ الإسلام أبو عثمان إسماعيل بن عبدالرحمن ابن الصابوني الواعظ بنيسابور(@)(@@)(@@)(@@) $ 1441 والقاضي أبو الطيب طاهر بن عبدالله الطبري شيخ الشافعية(@)(@@)(@@)(@@) $ 1442 والعلامة أقضى القضاة أبو الحسن علي بن محمد بن حبيب الماوردي البصري ببغداد PageV01P130(@)(@@)(@@)(@@) | 17 طبقة تتلو من بعدها إلى سنة ثمانين وأربعمائة(@)(@@)(@@)(@@) $ 1443 المسند أبو طالب محمد بن الفتح العشاري(@)(@@)(@@)(@@) $ 1444 والمسند أبو عثمان سعيد بن أحمد بن محمد النجيرمي النيسابوري(@)(@@)(@@)(@@) $ 1445 والمسند أبو سعد محمد بن عبدالرحمن الكنجرودي الأديب(@)(@@)(@@)(@@) $ 1446 ومقرىء ديار مصر أبو العباس أحمد بن سعيد بن أحمد بن نفيس المصري(@)(@@)(@@)(@@) $ 1447 ومسند الوقت أبو محمد الحسن بن علي الجوهري البغدادي(@)(@@)(@@)(@@) $ 1448 والإمام أبو الفضل عبدالرحمن بن أحمد بن بندار الرازي(@)(@@)(@@)(@@) $ 1449 والمسند أبو طاهر أحمد بن محمود الثقفي(@)(@@)(@@)(@@) $ 1450 وإبراهيم بن منصور سبط بحرويه(@)(@@)(@@)(@@) $ 1451 القاضي أبو عبدالله محمد بن سلامة بن جعفر القضاعي الشافعي مصنف الشهاب(@)(@@)(@@)(@@) $ 1452 وأبو يعلى إسحاق بن عبدالرحمن الصابوني PageV01P131(@)(@@)(@@)(@@) $ 1453 والحافظ أبو محمد الحسن بن محمد بن علي الدربندي البلخي بسمرقند(@)(@@)(@@)(@@) $ 1454 والحافظ أبو محمد علي بن أحمد بن سعيد بن حزم القرطبي الظاهري(@)(@@)(@@)(@@) $ 1455 والمسند أبو الحسين محمد بن أحمد بن محمد بن أحمد بن حسنون ابن النرسي(@)(@@)(@@)(@@) $ 1456 والمعمر أبو عثمان سعيد بن أبي سعيد أحمد بن محمد بن نعيم النيسابوري الصوفي المعروف بالعيار(@)(@@)(@@)(@@) $ 1457 والإمام أبو بكر أحمد بن حسين بن علي البيهقي الحافظ(@)(@@)(@@)(@@) $ 1458 والقاضي أبو 
ms36	 يعلى محمد بن الحسين بن محمد بن خلف بن الفراء البغدادي شيخ الحنابلة(@)(@@)(@@)(@@) $ 1459 والمسند أبو نصر أحمد بن عبدالباقي بن طوق الموصلي(@)(@@)(@@)(@@) $ 1460 ومسند دمشق أبو القاسم الحسين بن محمد بن إبراهيم الحنائي(@)(@@)(@@)(@@) $ 1461 وأبو مسلم محمد بن علي بن مهريزد الأصبهاني صاحب ابن المقرىء(@)(@@)(@@)(@@) $ 1462 والاستاذ أبو بكر أحمد بن الفضل الباطرقاني المقرىء(@)(@@)(@@)(@@) $ 1463 والحافظ أبو زكريا عبدالرحيم بن أحمد بن نصر التميمي البخاري PageV01P132(@)(@@)(@@)(@@) $ 1464 وأبو الحسين محمد بن مكي بن عثمان الآزدي المصري(@)(@@)(@@)(@@) $ 1465 وعالم قرطبة أبو عبدالله محمد بن عتاب بن محسن الجذامي(@)(@@)(@@)(@@) $ 1466 وأبو حامد أحمد بن الحسن الأزهري النيسابوري(@)(@@)(@@)(@@) $ 1467 والحافظ المصنف أحمد بن علي بن ثابت الخطيب البغدادي(@)(@@)(@@)(@@) $ 1468 وأبو عمر عبدالواحد بن أحمد المليحي الهروي(@)(@@)(@@)(@@) $$ 1469 والشيخة كريمة بنت أحمد بن محمد بن محمد بن حاتم المروزية المجاورة(@)(@@)(@@)(@@) $ 1470 وأبو الغنائم محمد بن علي بن الدجاجي(@)(@@)(@@)(@@) $ 1471 ومسند مرو محمد بن عبدالصمد الترابي سمع أبا سعيد بن عبدالوهاب الرازي(@)(@@)(@@)(@@) $ 1472 والحافظ الكبير أبو عمر يوسف بن عبدالله بن عبد البر النمري القرطبي(@)(@@)(@@)(@@) $ 1473 وأبو الغنائم عبدالصمد بن علي بن المأمون الهاشمي(@)(@@)(@@)(@@) $ 1474 وأبو الحسين محمد بن علي بن المهتدي بالله PageV01P133(@)(@@)(@@)(@@) $ 1475 والأستاذ أبو القاسم عبدالكريم بن هوازن القشيري النيسابوري الزاهد(@)(@@)(@@)(@@) $ 1476 وأبو جعفرمحمد بن أحمد بن المسلمة السلمي المعدل(@)(@@)(@@)(@@) $ 1477 وأبو سهل محمد بن أحمد بن عبيد الله الحفصي المروزي صاحب الكشميهني(@)(@@)(@@)(@@) $ 1478 والحافظ أبو محمد عبدالعزيز بن أحمد بن محمد الكتاني محدث دمشق(@)(@@)(@@)(@@) $ 1479 وأبو بكر يعقوب بن أحمد الصيرفي النيسابوري(@)(@@)(@@)(@@) $ 1480 ومسند الأندلس أبو عمر أحمد بن محمد بن يحيى بن الحذاء الأموي مولاهم القرطبي(@)(@@)(@@)(@@) $ 1481 وجمال الإسلام أبو الحسن عبد الرحمن بن محمد بن المظفر الداودي(@)(@@)(@@)(@@) $ 1482 ومقرىء العراق أبوعلي الحسن بن القاسم الواسطي غلام الهراس(@)(@@)(@@)(@@) $ 1483 والإمام أبو الحسن علي بن أحمد بن محمد الواحدي المفسر(@)(@@)(@@)(@@) $ 1484 وأبو صاعد يعلى بن هبة الله الفضيلي الهروي PageV01P134(@)(@@)(@@)(@@) $ 1485 وأبو القاسم يوسف بن محمد المهرواني الصوفي ببغداد(@)(@@)(@@)(@@) $ 1486 وأبو الحسن أحمد 
ms37	 بن عبدالواحد بن محمد بن أحمد بن عثمان ابن أبي الحديد السلمي بدمشق(@)(@@)(@@)(@@) $ 1487 والمحدث أبو القاسم حاتم بن محمد بن عبدالرحمن بن حاتم الطرابلسي ثم القرطبي بقية المسندين(@)(@@)(@@)(@@) $ 1488 والخطيب أبو محمد عبدالله بن محمد بن هزارمرد الصيريفيني(@)(@@)(@@)(@@) $ 1489 والحافظ أبو صالح أحمد بن عبدالملك بن علي المؤذن النيسابوري(@)(@@)(@@)(@@) $ 1490 ومسند العراق أبو الحسين أحمد بن محمد بن أحمد البزاز(@)(@@)(@@)(@@) $ 1491 وخطيب دمشق أبو نصر الحسين بن محمد بن أحمد بن طلاب القرشي(@)(@@)(@@)(@@) $ 1492 والحافظ أبو القاسم عبدالرحمن بن محمد بن إسحاق بن مندة العبدي الأصبهاني(@)(@@)(@@)(@@) $ 1493 والإمام أبو علي الحسن بن أحمد بن عبدالله بن البناء الحنبلي البغدادي(@)(@@)(@@)(@@) $ 1494 والحافظ أبو علي الحسن بن علي بن محمد البلخي الوخشي PageV01P135(@)(@@)(@@)(@@) $ 1495 والحافظ أبو القاسم سعد بن علي الزنجاني الزاهد شيخ الحرم(@)(@@)(@@)(@@) $ 1496 وأبو منصور عبدالباقي بن محمد بن غالب بن العطار(@)(@@)(@@)(@@) $ 1497 وأبو القاسم عبدالعزيز بن علي الأنماطي(@)(@@)(@@)(@@) $ 1498 وأبو عاصم الفضل بن يحيى الفضيلي الهروي(@)(@@)(@@)(@@) $ 1499 ورواي الصحيح أبو الخير محمد بن أبي عمران موسى المروزي(@)(@@)(@@)(@@) $ 1500 ومسند مكة أبو علي الحسن بن عبدالرحمن الشافعي المكي الحناط(@)(@@)(@@)(@@) $ 1501 وأبو عبدالله محمد بن أبي مسعود بن عبدالعزيز بن محمد الفارسي الهروي(@)(@@)(@@)(@@) $ 1502 وأبو القاسم الفضل بن عبدالله بن المحب صاحب الخفاف(@)(@@)(@@)(@@) $ 1503 والحافظ الفقيه أبو الوليد سليمان بن خلف الباجي(@)(@@)(@@)(@@) $ 1504 ومسند بغداد أبوالقاسم علي بن أحمد بن محمد البسري البندار(@)(@@)(@@)(@@) $ 1505 والمحدث أبو بكر محمد بن يحيى بن إبراهيم المزكي(@)(@@)(@@)(@@) $ 1506 والمسند أبو عمرو عبدالوهاب ابن الحافظ أبي عبدالله بن مندة الأصبهاني PageV01P136(@)(@@)(@@)(@@) $ 1507 وأبو الفضل المطهر بن عبدالواحد البزاني الأصبهاني(@)(@@)(@@)(@@) $ 1508 وشيخ الشافعية أبو إسحاق إبراهيم بن علي الشيرازي ببغداد(@)(@@)(@@)(@@) $ 1509 وأبو طاهرمحمد بن أحمد بن أبي الصقر الأنباري(@)(@@)(@@)(@@) $$ 1510 والمسندة بيبي بنت عبدالصمد الهرثمية(@)(@@)(@@)(@@) $ 1511 وعبدالرحمن بن محمد بن عفيف البوشنجي(@)(@@)(@@)(@@) $ 1512 وشيخ الشافعية أبو نصر عبد السيد بن محمد بن الصباغ البغدادي(@)(@@)(@@)(@@) $ 1513 والحافظ أبو سعد مسعود بن ناصر السجري الركاب لقي علي ابن بشر بن 
ms38	 الليثي(@)(@@)(@@)(@@) $ 1514 وأبو العباس أحمد بن عمر بن دلهاث العذري الدلائي محدث الأندلس(@)(@@)(@@)(@@) $ 1515 وإمام الحرمين أبو المعالي عبدالملك بن عبدالله بن يوسف الجويني(@)(@@)(@@)(@@) $ 1516 وقاضي القضاة أبو عبدالله محمد بن علي بن محمد الدامغاني الحنفي(@)(@@)(@@)(@@) $ 1517 والشيخ أبو القاسم إسماعيل بن زاهر النوقاني ثم النيسابوري PageV01P137(@)(@@)(@@)(@@) $ 1518 وأبو علي علي بن أحمد بن علي التستري البصري راوي السنن(@)(@@)(@@)(@@) $ 1519 ومسند العراق أبو نصر بن محمد بن علي الزينبي PageV01P138(@)(@@)(@@)(@@) | ( 18 ) طبقة تابعة لمن مضى وإلى حدود سنة نيف وخمسمائة(@)(@@)(@@)(@@) $ 1520 أبو الفضل محمد بن عبيد الله الصرام النيسابوري راوي صحيح أبي عوانه(@)(@@)(@@)(@@) $$ 1521 والزاهدة فاطمة بنت القدوة أبي علي الدقاق زوجة القشيري(@)(@@)(@@)(@@) $ 1522 والحافظ المرتضى أبوالمعالي محمد بن محمد بن زيد بن علي العلوي الحسيني البغدادي ببخارى(@)(@@)(@@)(@@) $ 1523 والحافظ أبو القاسم عبيد الله بن عبد الله بن أحمد القرشي الحسكاني النيسابوري الحنفي القاضي أدرك أبا الحسن العلوي(@)(@@)(@@)(@@) $ 1524 وأبو بكر أحمد بن عبد الصمد الغورجي الهروي راوي الترمذي(@)(@@)(@@)(@@) $ 1525 وشيخ الإسلام أبو إسماعيل عبدالله بن محمد بن علي الأنصاري الهروي الحافظ الزاهد(@)(@@)(@@)(@@) $ 1526 وأبو عمرو عثمان بن محمد بن محمد بن عبدالله المحمي المزكي راوي صحيح أبي عوانة(@)(@@)(@@)(@@) $ 1527 وأبو بكر محمد بن أحمد بن الحسن بن ماجه الأبهري الأصبهاني PageV01P139(@)(@@)(@@)(@@) $ 1528 وأبو نصر محمد بن سهل بن السراج من بقايا أصحاب أبي نعيم الأسفرائيني(@)(@@)(@@)(@@) $ 1529 وأبو الغنائم محمد بن علي بن أبي عثمان البغدادي(@)(@@)(@@)(@@) $ 1530 والحافظ أبو إسحاق إبراهيم بن سعيد النعماني المصري الحبال(@)(@@)(@@)(@@) $ 1531 والحافظ أبو الفتح محمد بن أحمد بن سمكويه الأصبهاني بهراة وهو في عشر الثمانين(@)(@@)(@@)(@@) $ 1532 والقاضي أبو منصور محمد بن أحمد بن علي بن شكرويه الأصبهاني(@)(@@)(@@)(@@) $ 1533 والمحدث أبو الفضل محمد بن أحمد بن أبي جعفر الطبسي صاحب الحاكم(@)(@@)(@@)(@@) $ 1534 والحفظ النسابة الأمير أبو نصر علي بن هبة الله بن ماكولا العجلي(@)(@@)(@@)(@@) $ 1535 وأبو الحسين عاصم بن الحسن بن محمد العاصمي الكرخي ببغداد(@)(@@)(@@)(@@) $ 1536 وأبو نصر عبدالعزيز بن محمد بن علي الترياقي الهروي(@)(@@)(@@)(@@) $ 1537 والحافظ أبو 
ms39	 الحسن طاهر بن مفوز المعافري الشاطبي تلميذ ابن عبدالبر كهلا PageV01P140(@)(@@)(@@)(@@) $ 1538 ومحدث البصرة الحافظ أبو القاسم بن عبدالملك بن علي بن شغبة الأنصاري عن سن عالية(@)(@@)(@@)(@@) $ 1539 وأبو منصور محمد بن الحسين بن أحمد بن الهيثم القزويني راوي سنن ابن ماجة(@)(@@)(@@)(@@) $ 1540 ومسند بغداد أبو عبدالله مالك بن أحمد بن علي البانياسي ثم البغدادي(@)(@@)(@@)(@@) $ 1541 والحافظ أبو مسعود سليمان بن إبراهيم الأصبهاني الملنجي(@)(@@)(@@)(@@) $ 1542 والمسند أبو الفضل عبدالله بن علي بن زكريا الدقاق(@)(@@)(@@)(@@) $ 1543 وشيخ الحنابلة القدوة أبو الفرج عبدالواحد بن محمد بن علي الشيرازي الواعظ بدمشق(@)(@@)(@@)(@@) $ 1544 وشيخ الإسلام أبو الحسن علي بن أحمد بن يوسف الأموي المكاري الزاهد(@)(@@)(@@)(@@) $ 1545 والمسند أبو الحسن علي بن محمد بن محمد الأنباري الأخضر الخطيب(@)(@@)(@@)(@@) $ 1546 وموسى بن عمران أبو المظفر النيسابوري(@)(@@)(@@)(@@) $ 1547 والحافظ أبو القاسم هبة الله بن عبدالوارث الشيرازي بمرو PageV01P141(@)(@@)(@@)(@@) $ 1548 ومسند نيسابور أبو بكر أحمد بن خلف الشيرازي صاحب الحاكم(@)(@@)(@@)(@@) $ 1549 ومسند دمشق علي بن محمد بن علي بن أبي العلا المصيصي الشافعي(@)(@@)(@@)(@@) $ 1550 والقاضي أبو عامر محمود بن القاسم بن محمد الأزدي هروي(@)(@@)(@@)(@@) $ 1551 والحافظ أبو الفضل أحمد بن الحسن بن أحمد بن خيرون البغدادي(@)(@@)(@@)(@@) $ 1552 ورئيس الحنابلة أبو محمد رزق الله بن عبدالوهاب بن عبدالله التميمي الواعظ(@)(@@)(@@)(@@) $ 1553 والمفسر أبو يوسف عبدالسلام بن محمد بن يوسف القزويني المعتزلي لحق أبا عمر بن مهدي(@)(@@)(@@)(@@) $ 1554 والحافظ أبو عبدالله محمد بن أبي نصر فتوح بن عبدالله الحميدي الأندلسي ببغداد(@)(@@)(@@)(@@) $ 1555 والمسند أبو عبدالله محمد بن علي العميري الزاهد بهراة(@)(@@)(@@)(@@) $ 1556 وأبو سهل نجيب بن ميمون الواسطي ثم الهروي صاحب منصور ابن عبدالله الخالدي(@)(@@)(@@)(@@) $ 1557 والمحدث أبو منصور عبدالمحسن بن محمد بن علي الشيحي التاجر PageV01P142(@)(@@)(@@)(@@) $ 1558 والرئيس أبو عبدالله القاسم بن الفضل الثقفي(@)(@@)(@@)(@@) $ 1559 والحافظ أبو بكر محمد بن أحمد بن عبدالباقي بن الخاضبة البغدادي(@)(@@)(@@)(@@) $ 1560 والإمام أبو المظفر منصور بن محمد بن عبدالجبار السمعاني المروزي الحنفي ثم الشافعي(@)(@@)(@@)(@@) $ 1561 والرئيس أبو الفتح عبدوس بن محمد بن عبدوس الهمذاني(@)(@@)(@@)(@@) $ 1562 وشيخ 
ms40	 دمشق الفقيه أبو الفتح نصر بن إبراهيم المقدسي الزاهد(@)(@@)(@@)(@@) $ 1563 وأبو العباس أحمد بن عبدالغفار بن أشته الأصبهاني الكاتب(@)(@@)(@@)(@@) $ 1564 والحافظ أبو محمد الحسن بن أحمد السمرقندي صاحب المستغفري(@)(@@)(@@)(@@) $ 1565 والمحدث أبو الفرج سهل بن بشر الإسفرائيني نزيل دمشق(@)(@@)(@@)(@@) $ 1566 والنقيب الكامل أبو الفوارس طراد بن محمد بن علي الزينبي ببغداد(@)(@@)(@@)(@@) $ 1567 والحافظ الزاهد أبو سعد محمد بن الحسين الحرمي نزيل هراة سمع بمصر من ابن حمصة والبندار PageV01P143(@)(@@)(@@)(@@) $ 1568 وأبو الحسين مكي بن منصور بن علان الكرجي(@)(@@)(@@)(@@) $ 1569 وأبو الحسن هبة الله بن عبدالرزاق الأنصاري صاحب الحفار(@)(@@)(@@)(@@) $ 1570 وأبوالحسين أحمد بن عبدالقادر بن محمد بن يوسف البغدادي(@)(@@)(@@)(@@) $ 1571 ومسند بلخ الدهقان أبو القاسم أحمد بن محمد بن محمد الخليلي عاش مائة سنة وروى مسند الهيثم(@)(@@)(@@)(@@) $ 1572 ومسند مصر القاضي أبو الحسن علي بن الحسن بن الحسين الخلعي الشافعي(@)(@@)(@@)(@@) $ 1573 والحافظ أبو القاسم مكي بن عبدالسلام الرميلي من جملة الشهداء بيت المقدس(@)(@@)(@@)(@@) $ 1574 ومسند البصرة أبو طاهر جعفر بن محمد بن الفضل القرشي العباداني خاتمة أصحاب أبي عمر الهاشمي(@)(@@)(@@)(@@) $ 1575 ومسند بغداد أبو عبدالله الحسين بن أحمد بن محمد بن طلحة النعالي(@)(@@)(@@)(@@) $ 1576 ومسند نيسابور علي بن أحمد بن الأخرم المؤذن أبو الحسن الزاهد PageV01P144(@)(@@)(@@)(@@) $ 1577 وأبو الخطاب مسند العصر نصر بن أحمد بن البطر القارىءببغداد(@)(@@)(@@)(@@) $ 1578 وميند خراسان بل مسند الدنيا أبو محمد بن عبدالواحد بن عبدالرحمن الزبيري الوركي عن مائة وثلاثين سنة قاله السمعاني(@)(@@)(@@)(@@) $ 1579 والمسند أبو عبدالله محمد بن أحمد بن محمد الكامخي النيسابوري(@)(@@)(@@)(@@) $ 1580 ومقرىء العراق أبو طاهر أحمد بن علي بن عبيد الله بن عمر بن سوار(@)(@@)(@@)(@@) $ 1581 ومقرىء الأندلس أبو داود بن الحاج الأموي الداني(@)(@@)(@@)(@@) $ 1582 وأبو بكر أحمد بن الحسين الطريثيثي الصوفي(@)(@@)(@@)(@@) $ 1583 والمسند أبو عبدالله الحسين بن علي بن أحمد البسري البندار خاتمة أصحاب عبدالله بن يحيى البكري(@)(@@)(@@)(@@) $ 1584 وأبو مسلم عبدالرحمن بن عمر السمناني ثم البغدادي المتكلم سبط القاضي أبي جعفر السمناني(@)(@@)(@@)(@@) $ 1585 وأبو مكتوم عيسى ابن الحافظ أبي ذر عبد بن أحمد 