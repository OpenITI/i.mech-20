ms121	 مبيض الدموع بأحمر % % 8(@)(@@) % ولا تندبوا غير المكارم والعلى % % لعال كما صدر القناة مشهر % % 9(@)(@@) % بكيت فأكثرت البكاء وحق لي % % بكائي على وفد من العز مكثر % % 10(@)(@@) % وإني لمعذور إذا ما بكيته % % بأكثر من قطر الغمام وأغزر % % PageV01P372 11(@)(@@) % ولي عبرة لم ترقت عند ادكاره % % كما لي فيه عبرة المتفكر % % 12(@)(@@) % وهيهات أن أسلوه يوما وإنني % % خلا منه يوما خاطري وتذكري % % 13(@)(@@) % حسام صقيل المتن أغمد في الثرى % % ووارى تراب الأرض طلعة نير % % 14(@)(@@) % وقد كان لم يحجب سناه بحاجب % % ولم تستتر أضواؤه بمستر % % 15(@)(@@) % فوا أسفي إن كان يغني تأسفي % % وما حذري إن كان يجدي تحذري % % 16(@)(@@) % وكنت أراني في النوائب صابرا % فأعدمني صبري فأنى تصبري % % 17(@)(@@) % وإني لمقبول المعاذير في الأسى % % ومن يعتذر مثلي إلى الصبر يعذر % % 18(@)(@@) % لقد ضقت ذرعا بعد فقدان باسل % % من الصيد مفتول الذراع غضنفر % % 19(@)(@@) % وما سر نفسي بعده ما يسرها % % ولا راق ما قد راق شيء لمنظري % % 20(@)(@@) % فيا عبراتي كل آن تحدري % % ويا نار أحشائي عليه تسعري % % PageV01P373 21(@)(@@) % فقد غاض بحر كلما مد راحة % % إلى الوفد فاضت منه خمسة أبحر % % 22(@)(@@) % فتسخر من ويل السحاب أكفه % % بأبرع من وبل السحاب المسخر % % 23(@)(@@) % إلى الله خطب كل يوم يعاد لي % % برزء من الأرزاء يقطع إبهري % % 24(@)(@@) % مصاب أصيبت فيه آل محمد % % برغم العوالي من وشيج وسمهري % % 25(@)(@@) % أصيبت بقوم ما أصيبت ولم تصب % % به مضر الحمرا ولا آل حمير % % 26(@)(@@) % أرتنا المنايا كيف تصمي سهامها % % وكيف تصول النائبات وتجتري % % 27(@)(@@) % ولو أنه يفدى فدته أماجد % ترى الموت إلا فيه أربح متجر % % 28(@)(@@) % ولو أنه يدعو الكماة لنصره % % عليها أجابته بنصر مؤزر % % 29(@)(@@) % ولكنه اغتالته إذ ذاك غيلة % ولم تمنع عنه بجند وعسكر % % 30(@)(@@) % خذي من تشائي بعد أخذك بندرا % من الناس من قد شئته وتخيري % % PageV01P374 31(@)(@@) % فما كان مفقود تشق جيوبها % % عليه المعالي يوم مجد ومفخر % % 32(@)(@@) % سقاك الحيا المنهل يا قبر بندر % % وحياك مهراق الغمام الممطر % % 33(@)(@@) % سألتك والأجفان يرفض ماؤها % % عن 
ms122	 الضيغم العادي فهل أنت مخبري % % 34(@)(@@) % تدلى عقيرا فيك والحتف صارم % % لعمري متى يعقر به الليث يعقر % % 35(@)(@@) % محاسن ذاك الوجه كيف تغيرت % % وكان على الأيام لم تتغير % % 36(@)(@@) % وكان يلاقي ضيفه متهللا % بوجه صباح بالمحاسن مسفر % % 37(@)(@@) % وقد نكرت من بعد علمي بأنها % % معارف للمعروف لم تتنكر % % 38(@)(@@) % مضى لا مضى إلا إلى عفو ربه % % ومسرح جنات ومورد كوثر % % 39(@)(@@) % فهل ودعته المشرفية والقنا % % وناحت عليه البيض في كل محضر % % 40(@)(@@) % لمن ترك الخيل الجياد كأنها % % عرائس ما زفت لغير مظفر % % PageV01P375 41(@)(@@) % صواهل يعشقن الطراد بموقف % % تبيع الردى فيه الكماة وتشتري % % 42(@)(@@) % دعونا للجدوى مرارا فلم يجب % % دعاء لنا عن عزة وتكبر % % 43(@)(@@) % وكان من الداعي بمرآى ومسمع % وفي منظر ما يروق ومخبر % % 44(@)(@@) % قريب من الحسنى مجيب لمن دعا % % زعيم بأخذ الفارس المتجبر % % 45(@)(@@) % تراه سلانا بعد هذا بغيرنا % % بأرغد عيش أم بأكرم معشر % % 46(@)(@@) % ألم يدر أن الملك أهمل بعده % % ليس سوى فهد له من مدبر % % 47(@)(@@) % وأن بني العلياء ضاقت صدورها % % لفقدان ذاك السيد المتصدر % % 48(@)(@@) % ومن نظر الأيام معتبرا بها % % رآها بعين الذاهل المتجر % % 49(@)(@@) % تحذرنا صرف المنون نزولها % % وتنذرنا في كل يوم بمنذر % % 50(@)(@@) % % شراب ولا منها ورود لمصدر % % PageV01P376 51(@)(@@) % ونبكي على الدنيا على غير طائل % % وما أحد من أهلها بمعمر % % 52(@)(@@) % نؤمل فيها أن يدوم لنا بها % % حياة وما دامت لكسرى وقيصر % % 53(@)(@@) % ونطمع منها بالمحال ولم تكن % % أمانينا إلا أحاديث مفتري % % 54(@)(@@) % وهذي هي الآجال قد قدرت لنا % % ولم ينل الإنسان ما لم يقدر % % 55(@)(@@) % ولا بد أن يمشى بنا فوق أربع % إلى حفرة لا مشية المتبختر % % 56(@)(@@) % ولو أننا كنا بقصر مشيد % وحصن حصين بالحديد مسور % % 57(@)(@@) % وإن المنايا كائنات لوقتها % % إذا قدمت للمرء لم تتأخر % % 58(@)(@@) % ولا وزر مما قضى الله عاصم % % ولا يتقى منه بدرع ومغفر % % 59(@)(@@) % على أنها الدنيا إذا ما صفا لنا % % بها العيش شابت صفوه بمكدر % % 60(@)(@@) % ومن ترك الدنيا رآها بعينه % % قصاصة ثوب أو قلامة 
ms123	 أظفر % % PageV01P377 البحر : خفيف تام 1(@)(@@) % أترى في الوجود مثلك عالم % يرد الناس بحره المتلاطم % 2(@)(@@) % أنت من أشرف العوالم ذاتا % إنما هذه الرجال عوالم % % 3(@)(@@) % أظهر الله فيك للناس سرا % ما لذاك السر الربوبي كاتم % % 4(@)(@@) % ولك الله ما برحت صراطا % مستقيما وعارضا متراكم % % 5(@)(@@) % وكل ظام على مناهل ما أو % % تيت من فضل ربك حايم % % 6(@)(@@) % تتلقى الأفهام منك وما تن % % طق إلا بالحق والحق ناجم % % 7(@)(@@) % كلمات كأنهن سيوف % % أين من فضلك السيوف الصوارم % % 8(@)(@@) % يا قوام الدين الحنيفي وال % % دين لعمري بمثل ذاتك قائم % % 9(@)(@@) % إنما أنت رحمة في الأر % % ض على أمة لها الله راحم % % 10(@)(@@) % أنت للحق واليقين صباح % % راح يجلو ليلا من الشك فاحم % % PageV01P378 11(@)(@@) % شهد الله أنها معجزات % % لم تسلم بالحق من لا يسالم % % 12(@)(@@) % حجج تفحم المجادل بالباطل % % والجاحد الألد المخاصم % % 13(@)(@@) % وضعت للورى موازين بالق % % سط وفيها لا زال دفع المظالم % % 14(@)(@@) % طاولت هذه السماء بأيد % قصرت دونها يدا كل ظالم % % 15(@)(@@) % لا تبالي إذا حكمت بأمر الل % % دي جادت يمينه بالكرائم % % 16(@)(@@) % آمر بالمعروف ناه عن المنكر % % آت بالحق ماضي العزائم % % 17(@)(@@) % وإذا ما أمرت لله أمرا % لست تخشى في الله لومة لائم % % 18(@)(@@) % لك جد الكلام والكلم الطي % ب يؤني امرئ ما يلائم % % 19(@)(@@) % نبهت من أردت من سنة الغ % % فلة فاستيقظ الذي كان نائم % % 20(@)(@@) % رجع المجرم الذي اقترف الذن % % ب منيبا فيها وأصبح نادم % % PageV01P379 21(@)(@@) % أعربت عن بلاغة لك أقلا % % م فصاح الإعراب وهي أعاجم % % 22(@)(@@) % غردت ما جرت بأيديك في % % الطرس شبيها تغريدها بالحمائم % % 23(@)(@@) % نافثات وهي الجدوال للفضل % % بقلب العدى سموم الأراقم % % 24(@)(@@) % اتبعنا بالحق ملة إبراهيم حني % % فا والحق بالحق قائم % % 25(@)(@@) % واتخذناه قبلة وإماما % ومشيد البيت الرفيع الدعائم % % 26(@)(@@) % ب يؤتي كل امرىء ما يلائم % % سلكوا في الندى سبيل المكارم % % 27(@)(@@) % نشروا ذكر ما طوته الليالي % % قبل هذا من عهد كعب وحاتم % % 28(@)(@@) % كتبولا فوق جبهة الدهر أن % الدهر عبد لهم رقيق وخادم 
ms124	 % % 29(@)(@@) % در در الندى أعاد أكفا % منأناس أعداؤهن الدراهم % % 30(@)(@@) % بأبي سادة الأنام جميعا % % PageV01P380 31(@)(@@) % من ليوث ضراغم وغيوث % % وبحور سواهم وخضارم % % 32(@)(@@) % قال منهم للمكرمات قؤول % % هكذا هكذا تكون المكارم % % 33(@)(@@) % يتعدى جميل فعلهم الناس % % وإن كان ذلك الفعل لازم % % 34(@)(@@) % طهر الله ذاتهم واصطفاهم % % قبل ما ينتجون من صلب آدم % % 35(@)(@@) % دائم الفخر خالد الذكر ما غير % % فخار لكم مدى الدهر دائم % % 36(@)(@@) % وارد شرعة العلوم التي ليس % % عليها إذا وردت مزاحم % % 37(@)(@@) % لم ينلها سواك نعمة مولى % % أنت فيها تحل طرق النعايم % % 38(@)(@@) % طالما حثحث النياق حثيثا % راغب في بديع فضلك هائم % % 39(@)(@@) % قد وفدنا على كريم إذا استج % % 40(@)(@@) % ووقفنا بموقف العلم والتد % % ريس والفضل والندى والمكارم % % PageV01P381 41(@)(@@) % وشهدنا معالم المجد فيها % % قد تعالت فيا لها من معالم % % 42(@)(@@) % ثم شمنا برق المكارم قد لا % % ح سناه من بين تلك المباسم % % 43(@)(@@) % ولثمنا يدي عظيم قريب % % من عظيم تعده للعظائم % % 44(@)(@@) % كشفت غمة النوائب عنا % % ثم نابت لنا مناب الغمائم % % 45(@)(@@) % لم تزل تتبع الجميل جميلا % فهي إذ ذاك ساجم إثر ساجم % % 46(@)(@@) % هذه سيدي عريضة داعيك % % كانت عن الوداد تراجم % % 47(@)(@@) % كلما أثبتت مديحك فيها % % كان إثباتها لمحو المآثم % % 48(@)(@@) % أطلب العفو في مديحك والغف % % ران والصفح عن جميع الجرائم % % 49(@)(@@) % فتقبل مني وما زال قدما % ناثرا في مديحك العبد ناظم % % 50(@)(@@) % بقواف على عداك عواد % يا فدتك العدى ووجهك سالم % % PageV01P382 البحر : بسيط تام 1(@)(@@) % يا ابن المخيزيم وافتنا رسائلكم % % مشحونة بضروب الفضل والأدب % 2(@)(@@) % جاءت بأعذب ألفاظ منظمة % % حتى لقد خلتها ضربا من الضرب % % 3(@)(@@) % زهت بأوصاف من تعنيه وابتهجت % % كما زهت كأسها الصهباء بالحبب % % 4(@)(@@) % عللتمونا بكتب منكم وردت % وربما نفع التعليل بالكتب % % 5(@)(@@) % فيها من الشوق أضعاف مضاعفة % تطوي جوانح مشتاق على لهب % % 6(@)(@@) % وربما عرضت باللطف واعترضت % % دعابة هي بين الجد واللعب % % 7(@)(@@) % قضيت من حسن ما أبدعته عجبا % وأنت تقضي على الإحسان بالعجب % % 8(@)(@@) % فنحن مما انتشينا من عذوبتها % % ببنت 
ms125	 فكرك نلهو لا ابنة العنب % % 9(@)(@@) % فأطربتنا وهزتنا فصاحتها % % فلا برحت مدى الأيام في طرب % % 10(@)(@@) % أما النقيبان أعلى الله قدرهما % % في الخافقين ونالا أرفع الرتب % % PageV01P383 11(@)(@@) % الطاهران النجيبان اللذان هما % % من خير أم كنت أعراقها وأب % % 12(@)(@@) % دام السعيد لديكم في سعادته % % وسالم سالما من حادث النوب % % 13(@)(@@) % إن الكويت حماها الله قد بلغت % % باليوسفين السبعة الشهب % % 14(@)(@@) % تالله ما سمعت أذني ولا بصرت % % عيني بعزهما في سائر العرب % 15(@)(@@) % فيوسف بن صبيح طيب عنصره % % أذكى من المسك إن يعبق وإن يطب % % 16(@)(@@) % ويوسف البدر في سعد وفي شرف % % بدر الأماجد لم يغرب ولم يغب % % 17(@)(@@) % فخر الأكارم والأمجاد قاطبة % % وآفة الفضة البيضاء والذهب % % 18(@)(@@) % من كل من بسطت في الجود راحته % % صوب المكارم من أيديه في وصب % % 19(@)(@@) % لولا أمور أعاقتنا عوائقها % % جئنا إليكم ولو حبوا على الركب % % PageV01P384 البحر : وافر تام 1(@)(@@) % تذكر في ربوع الضال عهدا % % فزاد به وجود الذكر وجدا % % 2(@)(@@) % وأضناه الهوى بغرام نجد % % فأصبح بالضنى عظما وجلدا % % 3(@)(@@) % وشامت منه أعينه فأورى % % وميض البرق في الأحشاء زندا % % 4(@)(@@) % فمن لجوانح ملئت غراما % كما ملئت عيون الصب سهدا % % 5(@)(@@) % وفي تلك المنازل كا قلبي % % فمذ فقد الأحبة راح فقدا % % 6(@)(@@) % سقى أطلال رامة في غواد % تخدد ثم وجه الأرض خدا % % 7(@)(@@) % وحياها حيا يحكي دموعي % % بها يسقي ها علما ووهدا % % 8(@)(@@) % وكيف سلو أهل الخفيف ودي % % ولم أسل لهم في البين ودا % % 9(@)(@@) % تصدى ظبي لعل في تلافي % % وأسلبني التصبر حين صدا % % 10(@)(@@) % وظلم منه حرم رشف ظلم % سواه لا يريني الوجد بردا % % PageV01P385 11(@)(@@) % أعينا مغرم العينين صبا % تعدته السهام وما تعدى % % 12(@)(@@) % لعمرك ما الهوى إلا هوان % ومن رام الملاح وما تردى ؟ % 13(@)(@@) % وكم مولى تعرض للتصابي % % فصيره الهوى بالرغم عبدا % % 14(@)(@@) % خليلي اسلكا فينا حديثا % لنجفو عنده سلمى وسعدى % % 15(@)(@@) % وهاتا لي بمحمود مديحا % وقولا فيه مدحا ما تودا % % 16(@)(@@) % به الرحمن أودع كل فضل % وفي برد الفضائل قد تردى % % 17(@)(@@) % إذا عدوا 
ms126	 أكابر كل قوم % ولم يعطف على دنف كئيب % % 18(@)(@@) % لقد زرع الجميل بكل قلب % % فكل فاه في علياه حمدا % % 19(@)(@@) % وحل له على الإسلام شكرا % فصار عليهم فرضا يؤدى % % 20(@)(@@) % وعم ثناؤه شرقا وغربا % وسير ذكره غورا ونجدا % % PageV01P386 21(@)(@@) % ويبسط راحة تنهل جودا % أحب مكارم الكرماء وفدا % % 22(@)(@@) % ونورد من يديه إذا ظمئنا % % فيسقينا بذاك الكف شهدا % % 23(@)(@@) % وندفع في عنايته خطوبا % إذا أضحت لنا خصما ألدا % % 24(@)(@@) % متى يممته تجدو نداه % % أفادك من كلا البحرين رفدا % % 25(@)(@@) % فهذا أعلم العلماء طرا % وأكرم من أفاد ندى وأجدى % % 26(@)(@@) % وكم من حاسد لعلاه يوما % فمات بغيظه حسدا وحقدا % % 27(@)(@@) % وأمل مجده فغدا كليلا % ورام بلوغ همته فأكدى % % 28(@)(@@) % أردنا أن نعد له صفات % فما اسطعنا لذاك الفضل عدا % % 29(@)(@@) % وحاولنا نروم له نظيرا % فان بعصرنا في الناس فردا % % 30(@)(@@) % تقلد منه هذا الدين شيفا % وزين فيه هذا العصر عقدا % % PageV01P387 31(@)(@@) % وقلنا كالحسام العضب عزما % نفاق غراره قطعا وحدا % % 32(@)(@@) % وقسنا كفه بالمزن جودا % فكان يمينه من ذاك أندى % % 33(@)(@@) % ويمزج لطفه آنا وقارا % يذوب فكاهة ويشد وجدا % % 34(@)(@@) % وصال بمحكم الآيات يوما % وهد عقيدة الأغيار هدا % % 35(@)(@@) % أبان لأهل إيران بيانا % فحيرهم بما أخفى وأبدى % % 36(@)(@@) % دلائل ما استطاعوا ينكروها % % وكيف الحق ينكر إذ تبدى % % 37(@)(@@) % وبحر ما له جزر ولكن % % يكون له مدى الأيام مدا % % 38(@)(@@) % يجرد من سيوف الله بيضا % ويركب من خيول العزم جردا % % 39(@)(@@) % كفى أهل العراق به افتخارا % فقد نالوا به عزا ومجدا % % 40(@)(@@) % فما ضلت لعمر أبيك قوم % % تروم بعلمه للحق رشدا % % PageV01P388 41(@)(@@) % % وما أرضى بها إلاك يفدى % % 42(@)(@@) % طلبت العلم لا طلبا لمال % % فنلت بذاك توفيقا وسعدا % % 43(@)(@@) % ولو يعطي الرجال على حجاها % % إليك من القليل الأرض تهدى % % 44(@)(@@) % ولم لا منك تغتاظ الأعادي % % وهم جيف وشموا منك ندا % % 45(@)(@@) % فظنوا قاربوك بكل شيء % وهيهات التقارب صار بعدا % % 46(@)(@@) % عليك أبا الثناء يبث عبد % % مدى أيامه شكرا وحمدا % % 47(@)(@@) % نعيد باسمك السامي قصيدا % ولا 
ms127	 نبغي سوى المرضاة قصدا % % PageV01P389 البحر : بسيط تام 1(@)(@@) % خذ بالمسرة واغنم لذة الطرب % % وزوج ابن سماء بابنة العنب % % 2(@)(@@) % واشرب على نغم الأوتار صافية % % مذابة في لجين الكأس من ذهب % % 3(@)(@@) % ولا تضع فرصة جاد الزمان بها % % ساعات أنسك بين المجد واللعب % % 4(@)(@@) % أما ترى الروض قد حاكت مطارفه % % أيدي الربيع وجادتها يد السحب % % 5(@)(@@) % والورد قد ظهرت بالحف شوكته % % وخضبت وجنتاه من دم كذب % % 6(@)(@@) % وزان ما راق دمع الطل حين بدا % % تبسم الأقحوان الغض عن شنب % % 7(@)(@@) % والراح منعشة الأرواح إن مزجت % % صاغ المزاج لها تاجا من الحبب % % 8(@)(@@) % وإن بدت وظلام الليل معتكر % % رمت شياطين هم المرء بالشهب % % 9(@)(@@) % داو بها كل ما تشكوه من وصب % % ففي المدامة ما يشفي من الوصب % % 10(@)(@@) % ودر بحيث ترى الأقداح دائرة % % فإنها لمدار الأنس كالقطب % % PageV01P390 11(@)(@@) % يعود ما فات من عهد الشباب بها % % يشب فيها معاطيها ولم يشب % % 12(@)(@@) % يمج منها فم الإبريق رائقة % % تخالها إنها صيغت من اللهب % % 13(@)(@@) % في جنة راق للأبصار رونقها % % وأدمع المزن ما تنفك في صببو % % 14(@)(@@) % الورق تملي من الأوراق ماخطبت % % على منابر غصن الدوح من خطب % % 15(@)(@@) % وما برحت لأيام مضت طربا % داعي المسرة والأفراح يهتف بي % % 16(@)(@@) % حتى إذا العيد وافانا بغرته % % أقر شوال عيني في أبي رجب % % 17(@)(@@) % بالسيد العلوي الهاشمي لنا % % فوز يؤمل من قصد ومن أرب % % 18(@)(@@) % أحيت مكارمه ما كنت أعرفها % % من الأوائل في الماضي من الحقب % % 19(@)(@@) % الله ألهمه فهما ومعرفة % % وحسن خلق وحلما غير مكتسب % % 20(@)(@@) % إني أباهي به الأشراف أجمعها % % بذلك النسب العالي الذي حسب % % PageV01P391 21(@)(@@) % فداؤه كل ممقوت بشانئه % % فلا إلى حسب يعزى ولا نسب % % 22(@)(@@) % هو السعيد الذي يشقى العدو به % % من ذا يعاديه في الدنيا ولم يخب % % 23(@)(@@) % لما دعاه ولي الأمر منتدبا % أجابه وأراه خير منتدب % % 24(@)(@@) % دعاه مستنصرا في عسكر لجب % % وقد ينوب مناب العسكر اللجب % % 25(@)(@@) % فسار مستصحب التوفيق يومئذ % فسار أكرم مصحوب ومصطحب % % 26(@)(@@) % وصار تدبيره يغني عساكره 
ms128	 % % عن الكتائب بالأقلام والمتب % % 27(@)(@@) % كم كربة نفست للجيش همته % % فحقه أن يسمى كاشف الكرب % % 28(@)(@@) % دعا إلى طاعة السلطان فاجتمعت % % له القبائل من بعد ومن قرب % % 29(@)(@@) % لقد أجابته وانقادت لطاعته % % ولو دعاها سوى علياه لم تجب % % 30(@)(@@) % أراعه ما أرهم من مكارمه % % وجاء من بره المعروف بالعجب % % PageV01P392 31(@)(@@) % تلك المزايا لأجداد له سلفت % % فأعقب الله ما للمجد من عقب % % 32(@)(@@) % من سادة شرف الله الوجود بهم % % قد أورثوها علاء من أب فأب % % 33(@)(@@) % فلم تجد من لسان غير منطلق % % ولا فؤادا إليهم غير منجذب % % 34(@)(@@) % فلا تقسهم بقوم دونهم شرفا % يوما وكيف يقاس الرأس بالذنب % % 35(@)(@@) % لقد كفى العسكر المنصور نائبة % % تجثو لها نوب الدنيا على الركب % % 36(@)(@@) % وقومت كل معوج صوارمه % % وسكنت منذ وافى كل مضطرب % % 37(@)(@@) % وأسعد الله مولانا الفريق به % % فكان ثابت سعد غير منقلب % % 38(@)(@@) % وكان أعظم أسباب الفتوح له % % فيا له سبب تاهيك من سبب % % 39(@)(@@) % أما وربك لولاه لما خمدت % % نار لها غير فعل النار بالحطب % % 40(@)(@@) % دهياء تفغر فاها لا سبيل إلى % % لا يسأمون من الإقدام في الطلب % % PageV01P393 41(@)(@@) % وكان خيرا لهم لو أنهم رجعوا % % عن غيهم بعد ذاك الجهد والنصب % % 42(@)(@@) % بغوا لما نزغ الشيطان بينهم % % والبغي يسلم أهليه إلى العطب % % 43(@)(@@) % حتى إذا دبروا للحرب أمرهم % % وهم عن الرأي والتدبير في حجب % % 44(@)(@@) % فأقبلت برجال لا عداد لها % % وحير الترك ما لقت من العرب % % 45(@)(@@) % لله درك ماذا أنت فاعله % % بذلت نفسك فوق المال والنشب % % 46(@)(@@) % والحرب قائمة والنار موقدة % % يقول منها جبان القوم واحربي % % 47(@)(@@) % يساقط الموت من أبطالها جثثا % كما يساقط جذع النخل بالرطب % % 48(@)(@@) % برزت فيهم بروز السيف منصلتا % من غمده وأخذت القوم بالرعب % % 49(@)(@@) % كففت أيديهم عن ما تمد له % % فما استفادوا سوى الخذلان في الغلب % % 50(@)(@@) % وشتت الله ممن قد طغى وبغى % % جمع الخوارج بين القتل والهرب % % PageV01P394 51(@)(@@) % ودمر الله في أقدامهم فئة % % فكان أعدى إلى أخرى من الجرب % % 52(@)(@@) % تعبتم فأحتم بعدها أمما 
ms129	 % كم راحة يجتنيها المرء من تعب % % 53(@)(@@) % وعم فضلك ذاك القطر أجمعه % % يا حسن ما أصبحت في مربع خصب % % 54(@)(@@) % رأس الأكابر والأشراف من مضر % % صدر الرئاسة فخر السادة النجب % % 55(@)(@@) % ليهنك النصر والفتح المبين وما % % بلغت من جانب السلطان من أرب % % 56(@)(@@) % لئن حباك بنيشان تسر به % % بطالع لقران السعد لم يغب % % 57(@)(@@) % هذا المشير أعز الله دولته % % أبان فضلك إعلانا لكل غبي % % 58(@)(@@) % وخذ إليك بقيت الدهر قافية % % تلوح منك عليها بهجة الأدب % % PageV01P395 البحر : طويل 1(@)(@@) % ليهنك يا نحير أهل زمانه % % ويا كاملا عنه غدا الطرف قاصرا % % 2(@)(@@) % ويا منبعا للجود والفضل والندى % % ومن لم يزل بحرا من العلم زاخرا % % 3(@)(@@) % ويا من يحل المشكلات بذهنه % % وأفكاره رأيا تحير البصائرا % % 4(@)(@@) % بطفل زكي قد أتاك وإنما % % يضاهيك بالأخلاق سرا وظاهرا % % 5(@)(@@) % وبشرتني فيه فقلت مؤرخا % بمولد عبد الله نلت البشايرا % % PageV01P396 البحر : بسيط تام 1(@)(@@) % الدين أصبح منصورا بتأييد % % الحمد لله في أيام محمود % % 2(@)(@@) % إذ سل من مرهفات الله بيض ظبا % % فشيد الدين فيها أي تشييد % % 3(@)(@@) % واستملك الملك عن رأي يسدده % % بحد سيف وفضل غير محدود % % 4(@)(@@) % سد الثغور وتمهيد الأمور به % % فالملك ما بين تسديد وتمهيد % % 5(@)(@@) % أيام دولته الفراء تحسبها % % خالا على وجنات الخرد الغيد % % 6(@)(@@) % الدهر يرهب من ماضي عزائمه % % والبحر يطلب منه ساحة الجود % % 7(@)(@@) % روت معاليه عن سعد وما عدلت % % بالعدل إذ ذاك عن حكم ابن مسعود % % PageV01P397 البحر : رمل تام 1(@)(@@) % ولد قد أشرق الكون به % % من على سلطاننا عبد المجيد % % 2(@)(@@) % بشر الإسلام في مولده % % فأسر الناس من هذا السعيد % % 3(@)(@@) % فزهت بغداد حتى إنها % % قابلت أيام هارون الرشيد % % 4(@)(@@) % وغدت تشرق من أنواره % % مثلما قد أشرق البدر بعيد % % 5(@)(@@) % زادنا بشرا فزدنا طربا % ما عليه قبل هذا من مزيد % % 6(@)(@@) % قد حبانا الله في مولده % % كل ما نهواه من عز مديد % % 7(@)(@@) % فترانا دائما في فرج % % كل يوم نحن في عيد جديد % % 8(@)(@@) % وإذا الكون أضا أرخته % % فضياء الكون من 
ms130	 عبد الحميد % % PageV01P398 البحر : وافر تام 1(@)(@@) % حثثت على عنيف السير نوقي % % وقدمت الطريق على الرفيق % % 2(@)(@@) % وقد فتق الزمان على فؤادي % % هموما فهي بارزة الفتوق % % 3(@)(@@) % خرجت إلى جميل أبي جميل % % إلى الرحب الفضاء من المضيق % % 4(@)(@@) % ولولا تمره والبر منه % % بقينا صابرين على السويق % % 5(@)(@@) % فلو جاد النقيب لنا بسمن % حمدنا التمر يعجن بالدقيق % % 6(@)(@@) % رأت عيناي في سفر عجيب % % أعز لدي من بيض الأنوق % % 7(@)(@@) % أخا رشد يغض من المعاصي % % وزنديق يتوب من الفسوق % % 8(@)(@@) % وقالوا إن قدوري تردى % % رواء الناس كالبر الصدق % % 9(@)(@@) % فآونة يصلي في فريق % وآونة يسبح في فريق % % 10(@)(@@) % وأخبرني ثقات الناس عنه % % بأن لا زال في كرب وضيق % % PageV01P399 11(@)(@@) % فكاد الشوق يحملني إليه % % فيستشفي مشوق من مشوق % % 12(@)(@@) % ولكني كتبت له كتابا % كما كتب الشفيق إلى الشفيق % % 13(@)(@@) % أعزره على ترك الحميا % % وأهديه إلى بئس الطرق % % 14(@)(@@) % أقول له وبعض النصح غش % بما بيني وبينك من حقوق % % 15(@)(@@) % وثوقك بالعذاب عنها % % وعفو الله أولى بالوثوق % % 16(@)(@@) % وكم لله من فرج قريب % % وكم للعبد من سعة وضيق % % 17(@)(@@) % أتنسى لا اقترفت الإثم إلا % كبيرا بين مزمار وبوق % % 18(@)(@@) % ليالينا التي انصرمت وولت % % حلت إلا بكأس من رحيق % % 19(@)(@@) % وكان مكاننا أنى سكرنا % % مكان الكلب قارعة الطريق % % 20(@)(@@) % يمر بنا الشقي فنبتليه % % ونزهد بالتقي المستفيق % % PageV01P400 21(@)(@@) % وقولك للتي سكرت ونامت % % فعلت بك المقابح أو تفيقي % % 22(@)(@@) % سددت مسامع الحسناء قهرأ % % بمثل الجذع من نخل سحوق % % 23(@)(@@) % تخبرني ضيوفك أين جاءت % % بأنك قد بعدت عن اللحوق % % 24(@)(@@) % تنادي بالطعام بلا شراب % % كما نهق الحمار على العليق % % 25(@)(@@) % وما هذا الذي عوضت عنها % % وهل يغني الحديث عن العتيق % % 26(@)(@@) % ألم تك بالفساد كما تراني % % يشق علي أن أعصي شقيقي % % 27(@)(@@) % فلا طابت أويقات لصاح % رمى أم الخبائث بالعقوق % % 28(@)(@@) % لقد كدرت يومئذ صفائي % % وقد أيبست بالتأنيب ريقي % % 29(@)(@@) % وأصبح عنك راضي غير راض % فلا تركن إلى سخط الصديق % % 30(@)(@@) % وقد رزق لسعادة بالمعاصي % % بسلطنة ابن سلطان رزوقي 
ms131	 % % PageV01P401 31(@)(@@) % وكم خمر معتقة رأها % % ففضلها على الخل العتيق % % 32(@)(@@) % وكان الدن لا يروي مناها % % فأصبح يشمئز من النشوق % % 33(@)(@@) % وكم من تائب من قبل هذا % % مروع من كبائره فروق % % 34(@)(@@) % وحد التائبين اليوم عندي % % اختيارا رميهم بالمنجنيق % % 35(@)(@@) % فيا لك توبة عادت عليه % % بأن يهوي سحيقا من سحيق % % 36(@)(@@) % رأيناه يصلي الخمس باق % بمحراب الصلاة على الشهيق % % 37(@)(@@) % فسلطنا شياطين القوافي % % عليه بالصبوح وبالغبوق % % 38(@)(@@) % وأغوينا في سحر مبين % من التبيان بالشعر الرقيق % % 39(@)(@@) % إلى أن عاد أفسق من عليها % % وأسرع بالإجابة من سلوقي % % 40(@)(@@) % فما يدنو من الشيطان إلا % تمسك منه بالحبل الوثيق % % PageV01P402 41(@)(@@) % وكان بنعمة لو كان يرعى % % لها حقا ويوفي بالحقوق % % 42(@)(@@) % وها هو بعدما في كل حال % % تغير بالمجاز عن الحقيقي % % 43(@)(@@) % قضى في خدمة النقباء عمرا % وتلك نضارة العيش الأنيق % % 44(@)(@@) % غريقك يا أبا سلمان فيها % % وكم في بحر جودك من غريق % % 45(@)(@@) % يقول رجاء من آوي إليه % % لقد حنت ألى الخيرات نوقي % % 46(@)(@@) % يؤمل من مكارمك الأماني % % ويرقب منك صادقة البروق % % 47(@)(@@) % فلا غابت شموس بني علي % وقد أذنت علينا بالشروق % % 48(@)(@@) % تلوح لنا بهم صور المعالي % % فتهدينا إلى المعنى الدقيق % % 49(@)(@@) % لبابك سيد النقباء وافت % % منبئة علاك عن العلوق % % 50(@)(@@) % وتكشف عندك الأستار كشفا % بحر القول عن حال الرقيق % % PageV01P403 51(@)(@@) % تحث السير مسرعة تهادى % % إلى علياك من فج عميق % % 52(@)(@@) % تقوم على الرؤوس لهم أناس % % تساويهم على قدم وسوق % % PageV01P404 البحر : بسيط تام 1(@)(@@) % رمى ولم يرم عن قوس ولا وتر % % بما بعينيه من غنج ومن حور % % 2(@)(@@) % مؤنث الطرف ما زالت لواحظه % % تسطو وتفتك فتك الصارم الذكر % % 3(@)(@@) % مهفهف القد معسول اللمى غنج % % أقضي ولم أقض منه في الهوى وطري % % 4(@)(@@) % ما لي بمقلة أحوى الطرف من قبل % % مؤيد بجنود الحسن منتصر % % 5(@)(@@) % يعطو إلي بجيد الظبي ملتفتا % تلفت الظبي من خوف ومن حذر % % 6(@)(@@) % وكلما ماس قلت الغصن حركة % % ريح الصبا وهو في أوراقه الخضر % % 7(@)(@@) % عجبت ممن قسا والعهد كان 
ms132	 به % % ارق من نسمات الروض في السحر % % 8(@)(@@) % أشكو إليه صبابات أكابدها % % كأنما رحت أشكوها إلى حجر % % 9(@)(@@) % نيران خديك ها قد أحرقت كبدي % % يا جنة أنا منها اليوم في سقر % % 10(@)(@@) % إن لم تكن بوصال منك تسعفني % % فلا أقل من الإسعاف بالنظر % % PageV01P405 11(@)(@@) % جد لي بطيفك واسمح إن بخلت به % % إني لأقنع بعد العين بالأثر % % 12(@)(@@) % واذكر ليالينا الأولى ظفرت بها % % والدهر يعجب والأيام من ظفري % % 13(@)(@@) % تلذ لي أنت في سمعي وفي بصري % % 14(@)(@@) % حيث المسرة أفلاك تدور بنا % % والشمس تشرق ليلا في يد القمر % % 15(@)(@@) % في روضة فوفت أيدي الربيع لها % % ما أبدع القطر من شيء ومن حبر % % 16(@)(@@) % والطل في وجنات الزهر يومئذ % ما بين منتظم منه ومنتثر % % 17(@)(@@) % ومن أحب كما أهواه معتنقي % % ومرشفي السكر المصري في السكر % % 18(@)(@@) % إذا تبسم أبصرنا بمبسمه % % ما أودع الله في الياقوت من درر % % 19(@)(@@) % خاف العيون صباح الغرق تنظره % % حتى تعوذ بالأصداغ والطرر % % 20(@)(@@) % أطل حديثك في قد فتنت به % % وإن ذكرت حديث الخصر فاختصر % % PageV01P406 21(@)(@@) % يقول لي في تثنيه مفاخرة % ألبان من شجري والورد من ثمري % % 22(@)(@@) % يا قاتل الله غزلان الصريم فما % % أبقت وقد نفرت صبرا لمصطبر % % 23(@)(@@) % وما لأعينهن النجل حين رنت % % أصبن قلبي وما الجاني سوى نظري % % 24(@)(@@) % وقفت منهن والأشجان تلعب بي % % في موقف الربع بين الخوف والخطر % % 25(@)(@@) % وبي من النافر النائي بجانبه % % صبابة تعلق الأجفان بالسهر % % 26(@)(@@) % عهدي بها ورداء الوصل يجمعنا % % والوصل يذهب طول الليل بالقصر % % 27(@)(@@) % لم يرقب الواشي يخشى من تطلعه % % ما أولع الدهر بالتبديل والغير % % 28(@)(@@) % تركتني ولكم مثلي تركت لقى % فريسة بين ناب الخطب والظفر % % 29(@)(@@) % هيجت أشجان قلبي فانتدبت لها % % بكل منتدب للشجو مبتدر % % 30(@)(@@) % إن السلامة في سلمان من كدر % % يجني علي ومن همي ومن فكري % % PageV01P407 31(@)(@@) % يسر نفسي ويقضي لي مآربها % % بنائل من ندى كفيه منهمر % % 32(@)(@@) % تالله ما أبصرت عيناي طلعته % % إلا وأيقنت أني بالنوال حري % % 33(@)(@@) % توقع الروض ما تسديه غادية 
ms133	 % % أناخ كلكلها ليلا بذي بقر % % 34(@)(@@) % إذا استقلت تراءى من مخايلها % % مبشر الوارد الظمآن بالغدر % % 35(@)(@@) % أصبحت من يده البيضاء في دعة % وحسن أنظاره في منظر نضر % % 36(@)(@@) % كأنما أنا من لألاء غرته % % في روضة باكرتها المزن بالمطر % % 37(@)(@@) % تهب منه رياح اللطف عاطرة % % من طيب عطر عن طيب عطر % % 38(@)(@@) % أمعن بدقة معنى ذاته نظرا % وانظر بعينيك واستعن عن الخبر % % 39(@)(@@) % وسل إذا شئت عن أجداده فلقد % % ضاقت بذاك صدور الكتب والسير % % 40(@)(@@) % أغظت في مدحه قوما بقافية % عن المقيم تجوب الأرض في سفر % % PageV01P408 41(@)(@@) % وحاسدا قصرت أيدي المنال به % % كمفلس الحي رام اللعب بالبدر % % 42(@)(@@) % تسر قوما وأقواما تغيظهم % % والشهب ترمي ظلام الليل بالشرر % % 43(@)(@@) % كالراح تسري إلى الأرواح نشوتها % % فالروح في خفة والجسم في خدر % % 44(@)(@@) % هم الذين أراشوني بنائلهم % % لولاهم الآن لم أنهض ولم أطر % % 45(@)(@@) % المطلقون لساني على % % تلك الشمائل بعد العي والحصر % % 46(@)(@@) % بيض تضيء بنور الله أوجههم % % في حندس من ظلام الخطب معتكر % % 47(@)(@@) % النافعون إذا عاد الزمان على % % بنيه في الساعة الخشناء بالضرر % % 48(@)(@@) % تقوى على أزمات الكون أنفسهم % % وليس تقوى عليها أنفس البشر % % 49(@)(@@) % فيا لك الله سادات إذا افتخرت % % كانت هي المفخر الأسنى لمفتخر % % 50(@)(@@) % لا تذكر الناس في شيء إذا ذكروا % % كاليم يقذف بالألواح والدسر % % PageV01P409 51(@)(@@) % يا أيها الدهر يأتينا بهم نسقا % هل جئت منهم بمعنى غير مبتكر % % 52(@)(@@) % ويا معاني المعالي من شمائلهم % % لقد برزت لنا في أحسن الصور % % 53(@)(@@) % دع ما تقول البرايا في مناقبهم % % فكيف قولك بالآيات والسور % % 54(@)(@@) % سر منالله إلا أن نورهم % % ف الخافقين وما صبح بمستتر % % 55(@)(@@) % علوا على الناس إعلانا فقلت لهم % % بالله أقسم لا بالركن والحجر % % 56(@)(@@) % أنتم لنا وزر من كل نائبة % % بوركنم نفر السادات من نفر % % 57(@)(@@) % % ونعم مدخر أنتم لمدخر % % 58(@)(@@) % مولاي أصبحت واليام مقبلة % % وأنت في عنفوان العز والعمر % % 59(@)(@@) % أني لأرقب وعدا منك منتظرا % ووعد غيرك عندي غير منتظر % % 60(@)(@@) % فاسلم ودم في سرور لا فناء 
ms134	 له % % باق على أبد الأزمان والعصر % % PageV01P410 البحر : رمل تام 1(@)(@@) % بارق لاح فأبكاني ابتساما % % نبة الشوق من الصب وناما % % 2(@)(@@) % ولمن أشكو على برح الهوى % % كبدا حرى وقلبا مستهاما % % 3(@)(@@) % ويح قلب لعب الوجد به % % ورمته أعين الغيد سهاما % % 4(@)(@@) % دنف لولا تباريح الجوى % % ما شكا من صحة الوجد سقاما % % 5(@)(@@) % ما بكى إلا جرت أدمعه % % فوق خديه سفوحا وانسجاما % 6(@)(@@) % وبما يسفح من عبرته % % بل كميه وما بل أواما % % 7(@)(@@) % ففؤادي والجوى في صبوتي % % لا يملان جدالا وخصاما % % 8(@)(@@) % ليت من قد حرموا طيب الكرى % % أذنوا يوما لعيني أن تناما % % 9(@)(@@) % منعونا أن نراهم يقظة % % ما عليهم لو رأيناهم مناما % % 10(@)(@@) % قسما بالحب واللوم وإن % كنت لا أسمع في الحب ملاما % % PageV01P411 11(@)(@@) % والعيون البابليات التي % % ما أحلت من دمي إلا حراما % % 12(@)(@@) % وفؤاد كلما قلت استفق % % يا فؤادي مرة زاد هياما % % 13(@)(@@) % إن لي فيكم ومنكم لوعة % أنحلت بل أوهنت مني العظاما % % 14(@)(@@) % وعليكم عبرتي مهراقة % % كلما ناوحت في الأيك حماما % % 15(@)(@@) % ومتى يذكركم لي ذاكر % % قعد القلب لذكراكم وقاما % % 16(@)(@@) % يا خليلي ومن لي أن أرى % % بعد ذاك الصدع للشمل التئاما % % 17(@)(@@) % أحسب العام لديكم ساعة % وأرى بعدكم الساعة عاما % % 18(@)(@@) % لم يدم عيش لنا في ظلكم % % وإذا ما أشرق النادي به % % 19(@)(@@) % حيث سالمنا على القرب النوى % % وأخذنا العهد منها والذماما % % 20(@)(@@) % ورضعنا من أفاويق الطلا % % وكرهنا بعد حولين الفطاما % % PageV01P412 21(@)(@@) % أترى أن الهوى ذاك الهوى % % والندامى بعدنا تلك الندامى % % 22(@)(@@) % كلما هبت صبا قلت لها % % بلغيهم يا صبا نجد السلاما % % 23(@)(@@) % وبنفسي ظالم لا يتقي % % حوبة المضنى ولا يخشى أثاما % % 24(@)(@@) % ما قضى حقا لمفتون به % % ربما يقضي وما يقضي مراما % % 25(@)(@@) % لو ترشفت لماه لم أجد % % في الحشا نارا ولو هبت ضراما % % 26(@)(@@) % ولأطفأت لظى نار الجوى % % ولعفت الماء عذبا والمدما % % 27(@)(@@) % شد ما مر جفا مستعذب % % من عذابي فيه ما كان غراما % % 28(@)(@@) % لا سقيتن الحيا من إبل % تقطع البيد بطاحا وأكاما % % 29(@)(@@) % قذفتها 
ms135	 بالنوى أيدي السرى % % في مواميها عراقا وشآما % % 30(@)(@@) % ورمتها أسهم البين فمن % % مهج ترمى وعيس تترامى % % PageV01P413 31(@)(@@) % قد بلونا الناس في أحوالها % % وعرفناهم كراما ولئاما % % 32(@)(@@) % وشربناهم نميرا سائغا % وزعافا وأكلناهم طعاما % % 33(@)(@@) % فمحال أن ترى عين رأت % % كحسام الدين للدين حساما % % 34(@)(@@) % إن تجرده على الدهر يد % % فلقت من خطبه هاما فهاما % % 35(@)(@@) % من سيوف أودعه الله به % % لم يكن يقبل في الناس انقاسما % % 36(@)(@@) % نظرت عيناي منه أروعا % طيب العنصر والقرم الهماما % % 37(@)(@@) % من كرام سادة لم يخلقوا % % بين أشراف الورى إلا كراما % % 38(@)(@@) % رق حتى خلته من رقة % % أرج الشيح وأنفاس الخزامى % % 39(@)(@@) % أم كما هبت صبا في روضة % % تنبت الرند صباحا والثماما % % 40(@)(@@) % ثابت الفكرة في آرائه % % يظهر الصبح كما يخفي الظلاما % % PageV01P414 41(@)(@@) % وإذا ما قوم المعوج في % % رأيه العالي من الأمر استقاما % % 42(@)(@@) % ثابت في موقف من موطن % % يجمع الأعداء والموت الزؤاما % % 43(@)(@@) % يوم تعرى البيض من أغمادها % % وبه يكسي الفريقين القتاما % % 44(@)(@@) % في نهار مثل مسود الدجى % % تلبس الشمس من النقع لثاما % % 45(@)(@@) % لم يضمه من زمان طارق % % عز جارا وجوارا أن يضاما % % 46(@)(@@) % قد وجدنا عهده في وده العروة % % الوثقى فقلنا لا انفصاما % % 47(@)(@@) % شمل الناس فأغنى بره % % وكذا البحر إذا البحر تطامى % % 48(@)(@@) % بأبي أنت وأمي ماجد % % في سماوات المعالي يتسامى % % 49(@)(@@) % شيد الفضل وأعلى قدره % % بعد أن أصبح أطلالا رماما % % 50(@)(@@) % وكفت يمناه بالويل ندى % فكفتنا الغيث سقيا والغماما % % PageV01P415 51(@)(@@) % حاكم بالعدل علوي الثنا % % عن علي قام بالحكم مقاما % % 52(@)(@@) % إنما البصرة في أيامه % % أعجبت من سار عنها أو أقاما % % 53(@)(@@) % أفصحت عن أخرس فيك له % % من قريض النثر نثرا ونظاما % % 54(@)(@@) % عربيات القوافي غرر % نصبت في قلة المجد خياما % % 55(@)(@@) % شاعر يهوى معاليك وفي % % كل واد من مديح فيك هاما % % 56(@)(@@) % يا حسام الدين يا هذا الذي % % أشكر اليوم أياديه الجساما % % 57(@)(@@) % فتفضل وتقبل كل ما % % جمعت فيك من الحق كلاما % % 58(@)(@@) % وثناء طيبا طاب بكم % % ينعش الروح افتتاحا وختاما 
ms136	 % % PageV01P416 البحر : رجز تام 1(@)(@@) % بشرى لنا في ولد بوجهه % % أبدى مبادي كرم الأخلاق % % 2(@)(@@) % ولا عجيب لذكي منجب % من أطيب الآصال والأعراق % % 3(@)(@@) % أبوه من فاق الورى بعلمه % % وفاق بالفضل على الآفاق % % 4(@)(@@) % بلحر يفيض جوهرا ونائلا % وباسط الكفين للإنفاق % % 5(@)(@@) % لدى الأنام جوده وفضله % % أضحى على الأفهام والأعناق % % 6(@)(@@) % تلك أياديه التي يبذلها % % كانت على الأعناق كالأطواق % % 7(@)(@@) % بشارة إذ جاء قد أرختها % % فجاءت البشرى بعيد الباقي % % PageV01P417 البحر : طويل 1(@)(@@) % سرينا لنمحو الإثم أو نغنم الأجرا % % لزورة من تمحو زيارته الوزرا % % 2(@)(@@) % وسارت وقد أرخى علينا الدجى سترا % % بنا من بنات الماء للكوفة الغرا % % 3(@)(@@) % سبوح سرت ليلا فسبحان من أسرى % % 4(@)(@@) % تخيرتها السفائن مركبا % % وأعددتها للسير شرقا ومغربا % % 5(@)(@@) % فكانت كمثل الطير إن رمت مطلبا % % تمد جناحا من قوادمه الصبا % % 6(@)(@@) % تروم بأكناف الغري لها وكرا % % 7(@)(@@) % وكانت تحلى قبل هذا تجملا % % وقد غذيت فيما أمر وما حلا % % 8(@)(@@) % أظن على فقد الشهيد بكربلا % % كساها الأسى ثوب الحداد ومن حلى % % 9(@)(@@) % تجملها بالصبر لاعجها أرعى % % 10(@)(@@) % إلى موقف سرنا بغير توقف % % يزيد بكائي عنده وتلهفي % % PageV01P418 11(@)(@@) % ولما تجارينا بفلك ومدنف % % جرت وجرى كل إلى خير موقف % % 12(@)(@@) % يقول لعينيه قفا نبك من ذكرى % % 13(@)(@@) % ترامت بنا فلك فيا نعم مرتمى % % إلى درة الفخر التي لن تقوما % % 14(@)(@@) % فخضنا إليه والبحر قد طمى % % وكم غمرة خضنا إليه وإنما % % 15(@)(@@) % يخوض عباب البحر من يطلب الدرا % % 16(@)(@@) % إلى مرقد يعلو السماكين منزلا % % وقد نال ما نال الصراح من اعلى % % 17(@)(@@) % نسير ولا نلوي عن السير معدلا % % نؤم ضريحا ما الضراح وإن علا % % 18(@)(@@) % بأرفع منه لا وساكنه قدرا % % 19(@)(@@) % فزوج ابنة المختار كان غضنفرا % % علا وارتضته الطهر من سائر الورى % % 20(@)(@@) % أتعرف من هذا الذي طال مفخرا % % هو المرتضى سيف القضا أسد الشرى % % PageV01P419 21(@)(@@) % علي الذرى بل زوج فاطمة الزهرا % % 22(@)(@@) % عيون الورى إن لاحظت منه كنهه % % ترد عن التشبيه حسرى فينتهوا % % 23(@)(@@) % وإن مقاما لا ترى العين شبهه % % مقام 
ms137	 علي كرم الله وجهه % % 24(@)(@@) % مقام علي رد عين العلى حسرى % % 25(@)(@@) % لقد صير الغبراء خضراء قبره % % وأشرق فيها في الحيقة بدره % % 26(@)(@@) % وقد وافق الإعجاز لله دره % % أثير مع الأفلاك خالف دوره % % 27(@)(@@) % فمن فوقه الغبرا ومن تحته الخضرا % % 28(@)(@@) % أحاط بنا علما فليت سليقة % % تفيد علوما عن علاه دقيقة % % 29(@)(@@) % مجازا وقد جرنا إليه طريقة % % أحطنا به وهو المحيط حقيقة % % 30(@)(@@) % بنا فتعالى أن نحيط به خبرا % % PageV01P420 31(@)(@@) % فطف في مقام حل فيه ولبه % ترى العالم الأعلى حفيفا بتربه % % 32(@)(@@) % فكالمسجد الأقصى وأي تشبه % % تطوف منا الأملاك طائفة به % % 33(@)(@@) % فتسجد في محراب جامعه شكرا % % 34(@)(@@) % فأثنى عليه من علا مثل دنا % % وكل بما أثنى أجاد وأحسنا % % 35(@)(@@) % فخرب من الدانين إذ ذاك أعلنا % % وحزب من العالين يهتف بالثنا % % 36(@)(@@) % عليه بوجي كدت أسمعه جهرا % % 37(@)(@@) % حججنا إلى بيت علا بجنابه % % عشية آوينا إلى باب غابه % % 38(@)(@@) % ومن قد سمت أركان كعبتنا به % % جدير بأن يأوي الحجيج لبابه % % 39(@)(@@) % ويلمس من أركان كعبته الجدرا % % 40(@)(@@) % فيوض علوم الله من قدم حوى % % فقسم منها ما أفاد وما احتوى % % PageV01P421 41(@)(@@) % ومن قبل ما يثوي ومن بعد ما ثوى % % حري بتقسيم الفيوض وما سوى % % 42(@)(@@) % أبي الحسنين الأحسنين به أحرى % % 43(@)(@@) % ظللنا وكم جان لديه ومذنب % % وذي حاجة منا وصاحب مطلب % % 44(@)(@@) % يقبل والأجفان تهمي بصيب % % ثرى منه في الدنيا الثراء لمترب % % 45(@)(@@) % وللمذنب الجاني الشفاعة في الأخرى % % 46(@)(@@) % خدمنا أمير المؤمنين بموطن % % نعفر فيه الوجه قصد تيمن % 47(@)(@@) % ويخدم قبر المرتضى كل مؤمن % % بأهداب أجفان وأحداق أعين % % 48(@)(@@) % وحر وجوه عفرتها يد الغبرا % % 49(@)(@@) % أزلنا غبارا كان في قبر حيدر % % فلاح كغمد المشرفي المشهر % 50(@)(@@) % ولا غرو في ذاك المكان المطهر % أمطنا القذى عن جفن سيف مذكر % % PageV01P422 51(@)(@@) % أجل سيوف الله أشهرها ذكرا % % 52(@)(@@) % تبدى سنا أنواره وتبينا % % غداة جلونا قبره فتزينا % % 53(@)(@@) % فحير أفهاما وأبهر أعينا % % فوالله ما ندري وقد سطع السنا % % 54(@)(@@) % جلينا قرابا أم جلونا له قبرا 
ms138	 % % PageV01P423 البحر : طويل 1(@)(@@) % هو البرق مما راعها وشجاها % % فهيج منها داءها وأساها % % 2(@)(@@) % ومما جوى تطوي عليه ضلوعها % % بكت بدم قان فطال بكاها % % 3(@)(@@) % حكت بلسان الحال حتى وددتني % % أقبل من تلك المطية فاها % % 4(@)(@@) % جوى مثل ما بى أو يزيد بزعمها % % وهيهات مني مجدها وعناها % % 5(@)(@@) % فقلت لها لا فاتك الورد صافيا % ولا حبست عنك السماء حياها % % 6(@)(@@) % وروضت من أكناف نجد رياضها % % وحق لنفس الحر عنك رضاها % % 7(@)(@@) % سقاها من النجب الكرائم ناقة % وأكرم منها أمها وأباها % % 8(@)(@@) % تعاف النمير العذب يمزج بالقذى % % وتختار في ري الهوان صداها % % 9(@)(@@) % تجافت عن الدار التي تنبت الأذى % % وها قد نأت عن مثلها لسواها % % 10(@)(@@) % لقد سرها أن لا تساء فأرقلت % % إلى حيث مثوى الأكرمين حماها % % PageV01P424 11(@)(@@) % فجاوزت البيداء غير مروعة % % كأن المنايا قصدها ومناها % % 12(@)(@@) % تباعد ما بين الخطا فكأنما % % تبوع الفلا أخفاقها بخطاها % % 13(@)(@@) % تهيم بأعلام المحصب من منى % وآفة نفس المستهام هواها % % 14(@)(@@) % عليها من الفتيان من لا تروعه % % مكابدة الأهوال حين يراها % % 15(@)(@@) % رماه إباء الضيم في كل مهمة % % يروع العفونى أن يجس ثراها % % 16(@)(@@) % من الصيد لا يستصعب الحتف إن دنا % % ولا بات يشكو للخطوب أذاها % % 17(@)(@@) % ويأنف أن يلقي القياد لنكبة % % يرى فرج الله القريب وراها % % 18(@)(@@) % إذا هم لا تنبو مضارب عزمه % % ولا فل أحداث الزمان شباها % % 19(@)(@@) % تصفح يرتاد المنازل في اللوى % % ويطلب فيها مرتعا ومياها % % 20(@)(@@) % ولم ينأ عن دار القلى باختياره % % ولكن جفته أهلها فجفاها % % PageV01P425 21(@)(@@) % قليل ائتلاف الجفن من سنة الكرى % % فلو راودته مرة لعصاها % % 22(@)(@@) % ولا بكثير الالتفات إلى التي % % نأى ماضيا عنها فعز عزاها % % 23(@)(@@) % لقد شام برقا بالحمى غير ممطر % % فأعرض عن أنوائها بنواها % % 24(@)(@@) % وحثحثها والليل يبدي ظلامه % % إلى عين هادي من يضل عماها % % 25(@)(@@) % وسار بها إذ ذاك في كل مهمه % % وليس إلى غير العلاء سراها % % 26(@)(@@) % وماراح إلا وهو فيها سميرها % % شكته تباريح الجوى وشكاها % % 27(@)(@@) % يذكرها بالرقمتين منازلا % مراتعها أعلامها ورباها % % 28(@)(@@) % رعت 
ms139	 من خزاماها وفازت بمائها % % سقاها شآبيب الحيا ورعاها % % 29(@)(@@) % هلمي بنا يا ناق نذكر ما مضى % % ونبكي شؤونا لا يفيد بكاها % % 30(@)(@@) % وأيامنا في الربع والربع آهل % % فواها لتلك الماضيات وآها % % PageV01P426 31(@)(@@) % مضى وانقضى عهد الأحبة في النقا % % وقد نفرت أسرابها ومهاها % % 32(@)(@@) % فكيف إذن يا ناق ترجع جيرة % % يقر لعيني أن يلوح سناها % % 33(@)(@@) % بعيشك هل تدرين من أنا طالب % ولم تدر في ماذا يكون حداها % % 34(@)(@@) % أروم ربوعا يهتدي لبيوتها % % بنور محياها ونار قراها % % 35(@)(@@) % وما افتقرت في الناس من أحد يد % إذا كان من عبد الغني غناها % % 36(@)(@@) % له الخير مجبول على الخير كله % % وخير الورى من لم يزل لرجاها % % 37(@)(@@) % فلم يبق من اكرومة ما أجادها % % ومنقبة ما حازها وحواها % % 38(@)(@@) % مباني الكرام الأولين تهدمت % % فأعلى مبانيها وشاد بناها % % 39(@)(@@) % عزيز عزيز النفس إن ضيم جاره % % فداها إذن في نفسه ووقاها % % 40(@)(@@) % له الفتكات البكر تشهد أنه % % عصاميها المعروف وابن جلاها % % PageV01P427 41(@)(@@) % تقلد عزما مثل إفرند عضبه % % إذا اعترضته النائبات براها % % 42(@)(@@) % هو الغيث يوم الجود والليث في الوغى % % فغيث نداها كف ليث وغاها % % 43(@)(@@) % إذا كان مجد كان منه عماده % % وإن كان حرب كان قطب رحاها % % 44(@)(@@) % متى شاء أوراها وأثقب زندها % % وشبت بفرسان الرجال لظاها % % 45(@)(@@) % أحلي بذكراه القوافي أصوغها % % ألا إنما ذكر الكرام حلاها % % 46(@)(@@) % تأرج في النادي بذكر جميله % % وإن كان ندي النسيم شذاها % % 47(@)(@@) % وإني لأهديها إلى خير ماجد % % نعم إنه مصباحها وهداها % % 48(@)(@@) % إلى الغابة القصوى وأية غاية % % علا مستطيلا شأوها وذراها % % 49(@)(@@) % سما غير ممنوع إلى كل سؤدد % % فلو رام أن يرقى السماء رقاها % % 50(@)(@@) % إلى أين تبغي بالأبوة والعلى % % بنفس جميع الناس دون علاها % % PageV01P428 51(@)(@@) % تعاليت حتى انحط من دونك الورى % % فكنت ثرياها وشمس ضحاها % % 52(@)(@@) % فداؤك عبد أنت مكالك رقه % بأيدي كريم يستفاض نداها % % 53(@)(@@) % فشكرا لما أولت من نعمة بها % % توليت مالا من نداك وجاها % % 54(@)(@@) % وجدت على دنيا أضاعت عوارفي % % وما انتاش أبناء الزمان لقاها 
ms140	 % % 55(@)(@@) % ووجدي على هذا الزمان سفاهة % وعتبي على القوم اللئام سفاها % % 56(@)(@@) % ولو كانت الأيام تعقل ما أتت % % إذن لنهاها عقلها ونهاها % % 57(@)(@@) % لها الحظ من مثلي وجودي بمثلها % % وحظي منها هجرها وقلاها % % 58(@)(@@) % إليك أبا محمود أشكو حوادثا % كثيرا على الحر الكريم أذاها % % 59(@)(@@) % أمني بها النفس الأماني ضلة % وتمنعني من عودها وجناها % % 60(@)(@@) % وتلسعني فيها أفاع قوارع % وما عرف الراقون كيف رقاها % % PageV01P429 61(@)(@@) % أرى هذه الدنيا لمن ذل أصحت % ذلولا ولو كان الأبي أباها % % 62(@)(@@) % تسنمها من كان من دون خفها % % وكنا نراه تحتها فعلاها % % 63(@)(@@) % وما بحت بالشكوى وفي بقية % % من الصبر إلا وانتهت وتناهى % % 64(@)(@@) % وعلمك بي يخبرك عني فما الذي % % أقول بأحوالي وأنت تراها % % 65(@)(@@) % وما هي إلا مهجة شفها الصدى % % إذا هي تستسقي نداك سقاها % % 66(@)(@@) % وإلا تلافاني بلطفك لم تكد % % بوادر حظي أن تروح تجاها % % 67(@)(@@) % جزتك جوازي الخير من متفضل % دعته الأماني فاستجاب دعاها % % 68(@)(@@) % فأنت بعصر لا خلت منك أهله % % خليق السجايا بالجميل خلاها % % 69(@)(@@) % نشرت به صحف المكارم والندى % % ومن بعد ما قد لفها وطواها % % PageV01P430 البحر : خفيف تام 1(@)(@@) % أيها القبر لا برحت مصوبا % من غزير الحيا بصيب مزن % % 2(@)(@@) % دفنوا في ثراك أكرم ميت % خال ما بينه المنون وبيني % % 3(@)(@@) % من أب كان بي رؤوفا رحيما % جزي الخير والمثوبة عني % % 4(@)(@@) % سوف أبكيه ما حييت وإن كا % % ن بكائي عليه ليس بمغن % % 5(@)(@@) % نال من ربه مقامأ كريما % يتمنى مكانه المتمني % % 6(@)(@@) % قلت لما مضى وأرخته قد % % نلت عبد الوهاب جنات عدن % % PageV01P431 البحر : خفيف تام 1(@)(@@) % يا إماما في الدين والمذهب الح % % ق على علمك الأنام عيال % 2(@)(@@) % رضي الله عنك أوضحت للنا % % س منار الهدى فباد الضلال % % 3(@)(@@) % قد ملأت الدنيا بعلمك حتى % % نلت بالعلم غاية لا تنال % % 4(@)(@@) % كلما قالت الأئمة قولا % فإلى ماتقول أنت المآل % % 5(@)(@@) % إنما أنت قدوة الكل بالكل % وعنك التفصيل والإجمال % % 6(@)(@@) % رحمة الله لم تزل تتوالى % % ما توالى الغدو والآصال % % 7(@)(@@) % شملت 