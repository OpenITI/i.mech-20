ms41	 من ملتي % % طلعت عليهن في برنس % % 7(@)(@@) % وقمت ألحن قداسهن % % غير بليد ولا أخرس % % 8(@)(@@) % ولم تك فرسانها في الطعان % % بأشجع مني ولا أفرس % % 9(@)(@@) % ألا حبذا ما استثار الهوى % % بتلك الكنائس من كنس % % 10(@)(@@) % ترى كل فاتنة وجهها % % معرى بشمس الضحى مكتس % % PageV01P169 11(@)(@@) % تكاد التماثيل من حسنه % % تفور بناطقة الأنفس % % 12(@)(@@) % فرنجية ساكن عقدها % % وزنارها قلق المجلس % % 13(@)(@@) % إذا قبلت صورة أقبلت % % عليها بناظرها الأشوس % % 14(@)(@@) % فيا ليتني عندها دمية % % تراني ولا ريب في ملمسي % % 15(@)(@@) % فأقسم لو أنني أستطيع % % تحولت صورة مرجرجس % % PageV01P170 البحر : كامل تام 1(@)(@@) % ضحكت تباشير الصباح كأنها % % قسمات نور الدين خير الناس % % 2(@)(@@) % المشتري العقبى بأنفس قيمة % % والبائع الدنيا بغير مكاس % % 3(@)(@@) % وسرى دعاء الخلق يحرس نفسه % % إن الدعاء يعد في الحراس % % 4(@)(@@) % راض الخطوب الصم بعد جماحها % % وألان من قلب الزمان القاسي % % 5(@)(@@) % وأعاد نور الحق في مشكاته % % وأقام وزن العدل بالقسطاس % % 6(@)(@@) % واختار مجد الدين سائس ملكه % % فحمى الرياسة منه طود راسي % % 7(@)(@@) % فهو الخبير بكل داء معظل % % يأسو جراح زماننا ويواسي % % 8(@)(@@) % وأذل سلطان النفاق بعزة % % خضعت لها الآساد في الأخياس % % 9(@)(@@) % وعرته أقران الخطوب فصدها % % ألوى يمارسها أشد مراس % % 10(@)(@@) % ولو أن فيض النيل فائض فضله % % لم تفتقر مصر إلى مقياس % % PageV01P171 11(@)(@@) % سكنت شعب الدهر بعد تخمط % % وألنت من عطفيه بعد شماس % % 12(@)(@@) % وفتحت باب الحظ بعد رتاجه % % وأذنت للأطماع بعد الياس % % 13(@)(@@) % حتى منحت الخلق كل مسرة % % فالناس في عرس من الأعراس % % PageV01P172 البحر : وافر تام 1(@)(@@) % أميمة لو شهدت وقد مررنا % % بأخطار السماوة ما نقاسي % % 2(@)(@@) % إذا لعلمت ويحك أن قلبا % % يحن إليك فيها غير قاس % % 3(@)(@@) % ولما أن مررت بجو راج % % على عجل ذكرت أبا فراس % % 4(@)(@@) % وقد أخذ الكرى من صاحبيه % % وجار عليهما حكم النعاس % % 5(@)(@@) % فواسى صحبه خل كريم % % فوالهفي على الخل المواسي % % PageV01P173 البحر : مجزوء الكامل 1(@)(@@) % يجري الثناء له بسودده % % وأخو العنان أحق بالفرس % % 2(@)(@@) % والشكر عند المستحق له % % مثل الجنى في كف مغترس % % PageV01P174 البحر : وافر 
ms42	 تام 1(@)(@@) % بوجه معذبي آيات حسن % % فقل ما شئت عنه ولا تحاش % % 2(@)(@@) % فنسخة حسنة قرئت وصحت % % وها خط الكمال على الحواشي % % PageV01P175 البحر : متقارب تام 1(@)(@@) % وكيف يفوز بفضل الكمال % % من جعل الأكمل الأنقصا % % 2(@)(@@) % لعمرك ما أنصف المثمرات % % من يجتنيها بخبط العصا % % PageV01P176 البحر : كامل تام 1(@)(@@) % لو كان سرك للوشاة معرضا % % لم أغض من دمعي على جمر الغضا % % 2(@)(@@) % حاشى لودك في الحشى أن ينقضي % % ولعهد حبك في الحشى أن ينقضا % % 3(@)(@@) % ما خاب من أسرت مواقع طرفه % % فاستنجد الصبر المحب المبغضا % % 4(@)(@@) % خفيت على الواشي سرائر وجده % % وإن استطار بها الغرام وأرمضا % % 5(@)(@@) % وسما الرقيب له فأغمض دمعه % % صون الهوى في ناظر ما أغمضا % % 6(@)(@@) % ولربما أجرى غمام جفونه % % برق أضاء له على ذات الإضا % % 7(@)(@@) % وبملتقى الأهواء جؤذر رملة % % أقبلت ذاوله عليه وأعرضا % % 8(@)(@@) % شفع المواعد بالمطال مخافة % % أن ينقضي أجل الوصال المقتضى % % 9(@)(@@) % ألف النوى فقضيت دون لقائه % % ليلا تواكبه النجوم مفضضا % % 10(@)(@@) % حتى إذا نازلت فارس لحظه % % ما زلت منه محاربا ومحرضا % % PageV01P177 11(@)(@@) % في معرك نضيت جفون ظباته % % عن أعين كفت الظبى أن تنتضى % % 12(@)(@@) % يا قاتل الله النصال . . . % حدق الغواني ما أصح وأمرضا % % 13(@)(@@) % ولكم قصرت بكل قاصر طرفه % % منها طراق الليل حتى قوضا % % 14(@)(@@) % واصلته متسرعا متمتعا % % وجلوته متبسطا متقبضا % % 15(@)(@@) % باتت تنال يدي على رغم النوى % % ما يقتضى منه وما لا يقتضى % % 16(@)(@@) % وإذا سقى فمه الرحيق مقبلا % % حيا بتفاح الخدود معضضا % % 17(@)(@@) % ما اسود في يوم الصدود فإنه % % يلقاك في ليل التواصل أبيضا % % 18(@)(@@) % هذا وكم جاريت في طلق الصبا % % سلس القياد وكان صعبا ريضا % % 19(@)(@@) % عاقرت مبهم عتبه حتى بدت % % غرر الرضاء على خلال أبي الرضا % % 20(@)(@@) % وعلى جلال الدين فرط مهابة % % محض الكمال لها الجمال وأمحضا % % PageV01P178 21(@)(@@) % يزداد من كل السواد تحببا % % حينا وما كل السواد مبغضا % % 22(@)(@@) % كالبحر ما بات الرجاء مناجيا % % عنه المنى إلا أطال وأعرضا % % 23(@)(@@) % إن يهجع الوزراء لم ير عزمه % % في الملك إلا ناهضا 
ms43	 أو منهضا % % 24(@)(@@) % أو أعرض الكرماء عنك رأيته % % متصديا لك بالندى متعرضا % % 25(@)(@@) % لو لم يكن لبنانه شيم الحيا % % ما أزهر القرطاس منه وروضا % % 26(@)(@@) % ما أعرض المعنى المعنى حيلة % % إلا ثناه مصرحا ومعرضا % % 27(@)(@@) % يعيي السعاة مراسلا ورسيله % % ينضي الطروس مسودا ومبيضا % % 28(@)(@@) % ما جاش في صدر الملطف صدره % % إلا ظننت الجيش قد ملأ الفضا % % 29(@)(@@) % تنداح دوحة مجده من معشر % % ما زال طفلهم وزيرا مرتضى % % 30(@)(@@) % شرعوا على دين السماح شريعة % % حمت المحارم أن تمس وتعرضا % % PageV01P179 31(@)(@@) % أمرت ونص على ابن أحمد أمرها % % فوليت مردودا إليك مفوضا % % 32(@)(@@) % فأبى ارتياحك دون ذاك حمية % % أن يستباح وغيره أن يرفضا % % 33(@)(@@) % ملك المساعي الغر لا يخشى الوفا % % حاشى بناء العز أن يتقوضا % % 34(@)(@@) % آتاك فرعا منك حلق أصله % % يأبى الذي رفع السما أن يخفضا % % 35(@)(@@) % فانهض بجدك قاطنا أو ظاعنا % % واقطع بحدك مغمدا أو منتضى % % 36(@)(@@) % لا زال عزمك في الحوادث ماضيا % % كالسيف مطبوع الغرار على المضا % % 37(@)(@@) % لهفي على زمن بقربك فاتني % % يا ليتني استقبلت منه ما مضى % % 38(@)(@@) % بل ليت شعري كيف شعري بعدما % % نغضت مكامنه لديك فأنغضا % % 39(@)(@@) % واخجلتا لسبيكة مسخوطة % % إن لم تكن جليت على عين الرضا % % 40(@)(@@) % جاءتك راكضة لو أن عنانها % % يندى بهيبتها الحيا أن يركضا % % PageV01P180 41(@)(@@) % كانت محجبة بفضل قناعها % % حتى نضا عنها ارتفادك ما نضا % % 42(@)(@@) % فعلى علاك تبرجت معروضة % % ألا تلفعت الخفارة معرضا % % 43(@)(@@) % ولئن أسمت الطرف في ميدانه % % فلربما سبق المجل فأحمضا % % 44(@)(@@) % أهدى لها الشرف استماعك فادعت % % نسب الرضي نباهة والمرتضى % % 45(@)(@@) % وحوت بقربك بعد غايات العلا % % فقضى لها بالسبق أعدل من قضى % % PageV01P181 البحر : بسيط تام 1(@)(@@) % أما الشباب فطيف زارني ومضى % % لما تبلج صبح الشيب معترضا % % 2(@)(@@) % ما كان أبيض وجه الوصل حين دجا % % وما أشد ظلام الهجر حين أضا % % 3(@)(@@) % وما وجدت الصبا في طول صحبته % % إلا كما لبس الجفن الكرى ونضا % % 4(@)(@@) % فالآن صرح شيب الرأس عن عذل % % محض ولم يزو عنك النصح من محضا % % 5 
ms44	(@)(@@) % فإن تبت سحب الأجفان هامية % % فعن سنا بارق في عارض ومضا % % 6(@)(@@) % ومن عجائب وجدي أنه عرض % % لم يبق مني جسما يحمل العرضا % % 7(@)(@@) % ولم يدع لي موت السر من جسدي % % عرقا إذا جسه آسي الهوى نبضا % % 8(@)(@@) % فإن يكن دل إعراض الدلال على % % غير الملال فسخطي في هواك رضا % % PageV01P182 البحر : وافر تام 1(@)(@@) % ذكرتك في حسينة والروابي % % ملفعة المناكب بالرياض % % 2(@)(@@) % ورعن الكثب مخضر المجاني % % على الغدران مترعة الحياض % % 3(@)(@@) % وقد سئمت من السير المطايا % % ومل قتودها حنق العضاض % % 4(@)(@@) % وضاقت ساحة الأخلاق حتى % % نبا الخلق الكريم عن التغاضي % % 5(@)(@@) % وعندك أنني مع ما ألاقي % % نسيتك لا وعينيك المراض % % PageV01P183 البحر : طويل 1(@)(@@) % تجاهل صحبي أن بكيت صبابة % % علي فقالوا ما جرى قلت أدمع % % 2(@)(@@) % وما عبر الصب الكئيب عن الجوى % % بمثل لسان فوه جفن ومدمع % % 3(@)(@@) % لي الله من قلب يواصل بثه % % عشية أسباب المنى تتقطع % % 4(@)(@@) % وقد ردت الحاجات خوف وشاتها % % إلى مقلة فيها لسان ومسمع % % 5(@)(@@) % وأسرى نعاس يمموا كعبة الندى % % فهم سجد فوق المذاكي وركع % % 6(@)(@@) % على كل نشوان العنان كأنما % % جرى في وريديه الرحيق المشعشع % % 7(@)(@@) % شكائمها معقودة بسياطها % % تخال بأيدينا أراقم تلسع % % PageV01P184 البحر : منسرح 1(@)(@@) % وشحنة كالهلال في ياعوا % % عيناه جند له وأشياع % % 2(@)(@@) % وال وألبابنا ولا يته % % ومقطع والقلوب إقطاع % % 3(@)(@@) % إذا بدا أذعنت له حدق % % وإن شدا ملكته أسماع % % 4(@)(@@) % يجس أوتار عوده بيد % % إيقاعها بالنفوس إيقاع % % PageV01P185 البحر : خفيف تام 1(@)(@@) % خفضي الصوت يا حمامة مقرى % % هاج شوقي دعاؤك المرفوع % % 2(@)(@@) % إنما تستثير رقة شكواك % % دموعي والوجد حيث الدموع % % 3(@)(@@) % طربت عند إلفها وشجاني % % فقد إلفي فأينا المفجوع % % 4(@)(@@) % % % 5(@)(@@) % . . . . % . . . . % 6(@)(@@) % أطلعت شمسك لما أشرقت % % نور فكر كان في أسر الكمام % % 7(@)(@@) % سفرت عن وجنتي ملثومة % % تتهادى من حياء في لثام % % 8(@)(@@) % فاشتملها برء جسم برؤه % % في الأيادي كأياديك الجسام % % 9(@)(@@) % إنما كان قتاما فانجلى % % أي شمس لم تجلل بقتام % % 10(@)(@@) % فاقتبل أفضل ما تسمى به % % من علو وضياء ودوام % % PageV01P186 البحر : طويل 
ms45	 1(@)(@@) % يخوفني بالبعد من لا أوده % % ويأمرني بالعجز من لا أطيعه % % 2(@)(@@) % وهل يفرس الضرغام لولا انتجاعه % % ولو دام في عريسه دام جوعه % % PageV01P187 البحر : - 1(@)(@@) % أترى فوق سهما من حسام % % يا له من ضارب باللحظ رام % % 2(@)(@@) % . . . . . . بظبى % % أم جفون تتجافى عن سهام % % 3(@)(@@) % . . . كأسي جمال علني % % صفو كأس غير مفوض الختام % % 4(@)(@@) % لحظات بت منها طافحا % % أي سكر دام من أي مدام % % 5(@)(@@) % بابليات حلال شربها % % ومن الخمر حلال كحرام % % 6(@)(@@) % وبأكناف المصلى جيرة % % لا يجيرون محبا من غرام % % 7(@)(@@) % نفر تأوي إليهم بقر % % عينها راعية رعي الذمام % % PageV01P188 البحر : كامل تام 1(@)(@@) % حسبي من البرحاء أني مولع % % بمهفهف أمسى بقتلي مولعا % % 2(@)(@@) % يسبي القلوب بفاحمين تكنفا % % من طرتيه للغزالة مطلعا % % 3(@)(@@) % وفم تخال غديره مترقرقا % % في نوره حوضا وروضا ممرعا % % 4(@)(@@) % فعلى العواذل فيه ألا تنتهي % % عن عذلها وعلي ألا أسمعا % % PageV01P189 البحر : كامل تام 1(@)(@@) % لا تخدعن فما الحسام المرهف % % إلا الذي يحويه جفن أوطف % % 2(@)(@@) % وإذا رأيت اللحظ يعمل في الحشا % % عمل الأسنة فالقوام مثقف % % 3(@)(@@) % ويح المحب أما يخالس نظرة % % إلا هفا بالقلب ظبى أهيف % % 4(@)(@@) % بالله يا نفحات أنفاس الصبا % % ما بال غصن البان لا يتعطف % % 5(@)(@@) % يا مسكري وجدا بخمر جفونه قل لي أتلك لواحظ أم قرقف % % 6(@)(@@) % بادر جمالك بالجميل فربما % % ذوت المحاسن أو أبل المدنف % % 7(@)(@@) % واسبق عذارك باعتذارك قبل أن % % يأتي بعزل هواك منه ملطف % % 8(@)(@@) % إن جاز أن يرث الملاحة باسمه % % أحد فإنك يوسف يا يوسف % % PageV01P190 البحر : طويل 1(@)(@@) % إذا ما تأملت القوام المهفهفا % % تأملت سيفا بين جفنيه مرهفا % % 2(@)(@@) % بليت بقاسي القلب لا عطف عنده % % أما شيمة للغصن أن يتعطفا % % 3(@)(@@) % وذي صلف يغريه بالتيه صمته % % إذا سمته رد السلام تكلفا % % 4(@)(@@) % وطرف تجلى عن سقامي سقامه % % فهلا شفى من بات منه على شفا % % 5(@)(@@) % أحب اقتضاء الوصل من كل هاجر % % وإن مطل الدين الغريم وسوفا % % 6(@)(@@) % وأقنع من وعد الحبيب بخلفه % % ومن كلفي أن أسأل الوعد مخلفا % % 7(@)(@@) % وما 
ms46	 زلت موقوف الغرام على هوى % % يجدد لي من عهد ظمياء ما عفا % % 8(@)(@@) % أخا كلف لا يرهب الليل زائرا % % إذا ضل نهج الحي عنه تعسفا % % 9(@)(@@) % سقى الله أيام التهافت في الصبا % % جنى كل جنان الأصائل أوطفا % % 10(@)(@@) % ليالي أضللت الرقيب مواقفا % % أغازل فيهن الغزال المشنفا % % PageV01P191 11(@)(@@) % إذا بت أستجلي الحسان محاسنا % % تروحت أستجلي البنان المطرفا % % 12(@)(@@) % أودع لبي ذاهل القلب مغرما % % وأودع قلبي فاتر الطرف أهيفا % % 13(@)(@@) % تقضى الصبا إلا تذكر ما مضى % % وإلا سؤالا عن زمان تسلفا % % 14(@)(@@) % وإلا شبابا فلل الشيب حده % % إذا ما هفا نحو التصابي تلهفا % % 15(@)(@@) % وعاد علي الدهر فيما سخا به % % فنغص ما أعطى وكدر ما صفا % % 16(@)(@@) % على أنني خلفت خلفي نوائبا % % كفاني مجد الدين منهن ما كفى % % PageV01P192 البحر : مديد تام 1(@)(@@) % يا بني الصوفي زرتكم % % طائفا بالبيت معتكفا % % 2(@)(@@) % فرأيت الغيث مغترفا % % من أياديكم ومعترفا % % 3(@)(@@) % من رأى أخلاقكم أنفا % % أن يرود الروضة الأنفا % % 4(@)(@@) % ذات بهو من ألم بها % % وصفا لحسنه وصفا % % 5(@)(@@) % عاقد في الجو منطقة % % لا يرى طرف لها طرفا % % 6(@)(@@) % طال إشراقا فحين سما % % توجوا هاماته شرفا % % 7(@)(@@) % من . . . . . . إذا % % طير شادروانها هتفا % % 8(@)(@@) % مغرم بالبهو فهو متى % % هف من شوق إليه هفا % % PageV01P193 البحر : وافر تام 1(@)(@@) % ترى الإبريق يحمله أخوه % % كلا الظبيين يلثمه ارتشافا % % 2(@)(@@) % يظل كمطرق في القوم يبكي % % دما أو ناكس يشكو الرعافا % % 3(@)(@@) % بكف مهفهف الكشحين ينمي % % إلى الغصن اعتدالا وانعطافا % % 4(@)(@@) % يدير الكأس من يده دهاقا % % ويسقي الراح من فمه سلافا % % 5(@)(@@) % ويهدي الورد لا من وجنتيه % % فيأبى أخذه إلا قطافا % % 6(@)(@@) % ومسمعنا الأغن إذا تغنى % % خلعت على محبته العفافا % % 7(@)(@@) % يضاعف من سرور القلب حتى % % يكاد يشق للطرب الشغافا % % PageV01P194 البحر : سريع 1(@)(@@) % كم لي بأنطاكية من هوى % % لا أنثني عنه بتعفيف % % 2(@)(@@) % إذ لا أجيل العين إلا على % % جيش من الأقمار مصفوف % % 3(@)(@@) % من كل بيضاء مسيحية % % ما عندها البدر بموصوف % % 4(@)(@@) % تجري ثناياها المآقي فما % % تلحظ طرفا غير مطروف % % 5 
ms47	(@)(@@) % فالعين خوف العين مصروفة % % عنها وما القلب بمصروف % % 6(@)(@@) % هذا وكم وجه كشمس الضحى % % بالهيكل المكشوف مكشوف % % PageV01P195 البحر : كامل تام 1(@)(@@) % وقد اختصرت لك الثناء وربما % % وافاك بالمقصود صدر ملطف % % 2(@)(@@) % هذا الحساب يفوت أوهام الورى % % ويحوزه الهندي بتسعة أحرف % % PageV01P196 البحر : خفيف تام 1(@)(@@) % أوطن القلب من هواكم فريق % % ما لصرف النوى عليه طريق % % 2(@)(@@) % كلما امتد بيننا أمد البين % % تدانى هؤاكم الموموق % % 3(@)(@@) % طول عهدي بكم يضاعف وجدي % % وكذا يفعل الشراب العتيق % % 4(@)(@@) % خفقت لي وللنجوم قلوب % % بعدكم ما أطاعهن خفوق % % 5(@)(@@) % حجب الدمع مقلتي فعداها % % أن ترى ما يروقها ما تريق % % 6(@)(@@) % وأرى البعد في الصبابة كالقرب % % فقلبي على الزمان مشوق % % 7(@)(@@) % ولآلي دموع عيني طواف % % فلما ذا غواصهن غريق % % 8(@)(@@) % لا يرع في يد الفراق زمان % % مر لي من وصالكم مسروق % % 9(@)(@@) % حيث غصن الشباب غض وريق % % وتحايا المدام عض وريق % % 10(@)(@@) % وغرامي لا يستدل به الطيف % % ولا تهتدي إليه البروق % % PageV01P197 11(@)(@@) % ومغاني دياركم مثل مغنى فيه % % معنى من الهوى مطروق % % 12(@)(@@) % والليالي مثل الغواني إذا أسفرن % % لم تدر أيها المعشوق % % 13(@)(@@) % في زمان تضاعفت لعميد الملك % % في ظله علي الحقوق % % 14(@)(@@) % لو شهدتم صبابتي لعلمتم % % أن قلبي بحبكم معذوق % % 15(@)(@@) % أو وقفتم على غلوي فيكم % % قام لي عندكم بذلك سوق % % 16(@)(@@) % رابني بعدكم زماني فلا الأيام % % بيض ولا الربيع أنيق % % 17(@)(@@) % ورأيت الرحيق يجلب همي % % أفحالت عن السرور الرحيق % % 18(@)(@@) % أسلمتني إلى الأسى فهي في الكأس % % رحيق وفي فوادي حريق % % 19(@)(@@) % وبلوت الورى قياسا إليكم % % فاستمرت على قياسي فروق % % 20(@)(@@) % وتصفحت بعدكم شيم الناس % % وفيها الصريح والممذوق % % PageV01P198 21(@)(@@) % يعد الدهر باللقاء فيسليني % % ويروي أخباركم فيشوق % % 22(@)(@@) % سانحات يكاد يتهم السمع % % عليها قلب عليكم شفيق % % 23(@)(@@) % ويعاطيني الغرام أفاويق % % هواكم فما أكاد أفيق % % 24(@)(@@) % غير أني أهيم شوقا إذا هب % % نسيم بنشركم مفتوق % % 25(@)(@@) % قد ملكتم قلبي وسرحتم جسمي % % فواها أنا الأسير الطليق % % PageV01P199 البحر : بسيط تام 1(@)(@@) % أرى الصوارم في الألحاظ تمتشق % % متى استحالت سيوفا هذه الحدق 
ms48	 % % 2(@)(@@) % واويلتا من عيون قلما رمقت % % إلا انثنت عن قتيل ما به رمق % % 3(@)(@@) % يا صاح دعني وما أنكرت من ولهي % % بان الفريق فقلبي بعدهم فرق % % 4(@)(@@) % أما ترى أي ليث صاده رشأ % % وأي خرق دهاه شادن خرق % % 5(@)(@@) % في معرك لذوات الدل لو شرقت % % بحره أنفس العشاق ما عشقوا % % 6(@)(@@) % من كل شمس لها من خدرها فلك % % وبدر تم له من فرعه غسق % % 7(@)(@@) % ومن كثيب تجلى فوقه قمر % % على قضيب له من حلة ورق % % 8(@)(@@) % وغادة في وشاح يشتكي عطشا % % إلى حجول بها من ريها شرق % % 9(@)(@@) % تبسمت والنوى تبدي الجوى عجبا % % من لوعة تحتها الأحشاء تحترق % % 10(@)(@@) % وأنكرت لؤلؤ الأجفان حين طفا % % منها على لجة إنسانها غرق % % PageV01P200 11(@)(@@) % يا من لصب شجاه ليل صبوته % % لما تبسم هذا الأبيض اليقق % % 12(@)(@@) % متى نهته النهى حنت علاقته % % إن الكريم بأيام الصبا علق % % 13(@)(@@) % صاحبت عمري مسرورا ومكتئبا % % كذلك العيش فيه الصفو والرنق % % 14(@)(@@) % وعشت أفتح أبوابا وأغلقها % % حتى سمت بي علا ما دونها غلق % % 15(@)(@@) % فسرت مغتبق الإدلاج معتنقا % % ذرى عزائم من تعريسها العنق % % 16(@)(@@) % لا أرهب الليل حتى شاب مفرقه % % وهل يخاف الدجى من شمسه أبق % % PageV01P201 البحر : بسيط تام 1(@)(@@) % ما أطرق الجو حتى أشرق الأفق % % إن أغمد السيف فالصمصام يأتلق % % 2(@)(@@) % دون الأسى منك نور الدين في حلب % % مملك ينجلي عن وجهه الغسق % % 3(@)(@@) % كنت الشقيق الشفيق الغيب حين ثوى % % أراق ماء الكرى من جفنك الأرق % % 4(@)(@@) % تلقى الأسى من لباس الصبر في جنن % % حصينة تحتها الأحشاء تحترق % % 5(@)(@@) % ومدة الأجل المحتوم إن خفيت % % فإن أيامنا من دونها طرق % % 6(@)(@@) % وإنما نحن في مضمار حلبتها % % خيل إلى غاية الأعمار تستبق % % 7(@)(@@) % شأو إذا ابتدر الأقوام غايته % % كان المؤخر فيها من له السبق % % 8(@)(@@) % إن كان صنوك هذا قد ثوى فذوى % % ففي مغارسك الأثمار والورق % % 9(@)(@@) % أو أصبحت بعده الأهواء نافرة % % أيدي سبا فعلى علياك تتفق % % 10(@)(@@) % ما غاب من غاب عن آفاق مطلعه % % إلا ليفتر عن أنوارك 
ms49	 الأفق % % PageV01P202 11(@)(@@) % ما دام شمسك فينا غير آفلة % % فالدين منتظم والملك متسق % % PageV01P203 البحر : متقارب تام 1(@)(@@) % لقد فتنتني فرنجية % % نسيم العبير بها يعبق % % 2(@)(@@) % ففي ثوبها غصن ناعم % % وفي تاجها قمر مشرق % % 3(@)(@@) % وإن تك في عينها زرقة % % فإن سنان القنا أزرق % % PageV01P204 البحر : بسيط تام 1(@)(@@) % أرض تحل الأماني في أماكنها % % بحيث تجتمع الدنيا وتفترق % % 2(@)(@@) % إذا شد الطير في أغصانها وقفت % % على حدائقها الأسماع والحدق % % PageV01P205 البحر : طويل 1(@)(@@) % رنا وكأن البابلي المصفقا % % ترقرق من جفنيه صرفا معتقا % % 2(@)(@@) % ورد يدا عن ذي حباب مرنق % % وحيا بها من وجنتيه مروقا % % 3(@)(@@) % وراح وشمس الراح في غسق الدجى % % تقابل منه البدر في بانة النقا % % 4(@)(@@) % سعى في خضاب من رحيق مشعشع % % ببرد رضاب ذبت منه تحرقا % % 5(@)(@@) % ولي عبرات تستهل صبابة % % عليه إذا برق الغمام تألقا % % 6(@)(@@) % أنهنه وجدي أن يفوه بلوعتي % % وكان لسان الحب بالحب أنطقا % % 7(@)(@@) % فإما أشم عذري سعى بي مكذبا % % وإن اختصم دمعي سعى بي مصدقا % % 8(@)(@@) % فلله ما ألقاه من فيض مدمع % % إذا كفكف العذال منه تدفقا % % 9(@)(@@) % ألفت الهوى حتى حلت لي صروفه % % ورب نعيم كان جالبه شقا % % 10(@)(@@) % ألذ بما أشكوه من ألم الجوى % % وأفرق إن قلبي من الوجد أفرقا % % PageV01P206 11(@)(@@) % فها أنا ذو حالين أما تحرقي % % فحي وأما سلوتي فلك البقا % % 12(@)(@@) % يقول نجي الدمع رفقا بمائه % % ولو رفق الحادي به لترفقا % % 13(@)(@@) % فإن بنات الصدر ما دام في اللهى % % لها مرتقى فالدمع في غير مرتقى % % 14(@)(@@) % وردت شراب الدمع فازددت غلة % % ومن ذا يعاطيك الإخاء المحققا % % 15(@)(@@) % وأرخص شوقي في الهوى صدق خلتي % % ويهدي النفاق من أراد التنفقا % % 16(@)(@@) % سفرت لهذا الدهر عن غير شيمتي % % ومن كان مأخوذا بخلق تخلقا % % 17(@)(@@) % وأصبحت لا أرضى القوافي لمنطقي % % على أن لي فيها لسانا ومنطقا % % 18(@)(@@) % وصنت بنات الفكر عن غير أهلها % % ومن ولي الحسناء صان وأشفقا % % 19(@)(@@) % ومنيتها كفؤا تليق بمجده % % فكانت بآلاء ابن أحمد أليقا % % 20(@)(@@) % كدأبي ما كانت سهام مطالبي % % لترمي هوى 
ms50	 ما لم تجد فيه مرشقا % % PageV01P207 21(@)(@@) % فزارت عفيف الدين شاكية العلى % % ليمنحها محض الوداد فأصدقا % % 22(@)(@@) % فتى خطب الزلفى فأجزل مهرها % % تقى ورأى الدنيا نعيا فطلقا % % 23(@)(@@) % أخو ثقة ولى على المال راحة % % ترى أن جمع الحمد أن يتفرقا % % 24(@)(@@) % إذا علقت أخرى النسيب بمدحه % % خروجا رأيت المدح بالسمع أعلقا % % 25(@)(@@) % رسيل الغوادي يستهل بنانه % % سماحا إذا ما رائد النجم أخفقا % % 26(@)(@@) % تباين في حاليه سح على العلى % % وأسرف في الجدوى فأثرى وأملقا % % 27(@)(@@) % وأنفد في جمع المحامد همه % % ولم يدخر إلا التلاد المفرقا % % 28(@)(@@) % فلا مجد إلا ما به شهد الندى % % ولا مال إلا ما أتاك وأنفقا % % 29(@)(@@) % تمرس بالألوى الأبي فما وفى % % وقرطس في المعنى الخفي فأغرقا % % 30(@)(@@) % يجيل رموز الطرف من لحظاته % % ويقرأ في النجوى الكلام المعلقا % % PageV01P208 31(@)(@@) % رأى بيت مال الملك نهبى فأصبحت % % كفايته سورا عليه وخندقا % % 32(@)(@@) % فما سئل الإنصاف إلا أناله % % ولا احتاط للسلطان إلا توثقا % % 33(@)(@@) % أمانة مرجو الأناة مخوفها % % تحلمه العدوى ويملكه التقى % % 34(@)(@@) % كذا ما ادعى طرق السياسة صادقا % % سوى من بلوناه على العجم أصدقا % % 35(@)(@@) % رأيت بني عبد اللطيف إذا انتموا % % كواكب لا ترضى سوى المجد مشرقا % % 36(@)(@@) % أناس تجلوا في دجى كل غمة % % سنا وتحلوا لؤلؤ الحمد منتقى % % 37(@)(@@) % وصانوا علاهم عن كلام مذمم % % ولم يقتنوا إلا الثناء المعشقا % % 38(@)(@@) % إذا كسد الفضل الغريب بموسم % % وسيق إلى أسواقهم كان أسوقا % % 39(@)(@@) % شفعت مساعيهم بسعيك يا أبا الحسين % % فحزت الحسنيين موفقا % % 40(@)(@@) % وخلوا لك الغايات لا عن كلالة % % ولكن تقدمت السوابق أسبقا % % PageV01P209 41(@)(@@) % بقيت على رغم العدى فائت الردى % % تجمع من شمل الندى ما تفرقا % % 42(@)(@@) % ودمت لأعياد الزمان مهنأ % % بكل رداح تبهر الشمس رونقا % % 43(@)(@@) % فدونكها من مطلع الشعر مبسما % % ترى معرقا في نسبة الفضل مغرقا % % 44(@)(@@) % معاني من لم يورد السمع ماءها % % تغمر منها في سراب ترقرقا % % PageV01P210 البحر : كامل تام 1(@)(@@) % بنتم فبان محل صبري عنكم % % والجسم بعد القلب أول لاحق % % 2(@)(@@) % وتقوضت خيماتكم عن ناظري % % فضربتموها في 
ms51	 الفؤاد الوامق % % 3(@)(@@) % فلأهدين إلى جفونكم الكرى % % ولأسرين سرى الخيال الطارق % % 4(@)(@@) % ولأقضين مناسكي من قربكم % % فزيارة المعشوق حج العاشق % % PageV01P211 البحر : وافر تام 1(@)(@@) % تملكتم فؤادي دون جسمي % % فما أنا بالأسير ولا الطليق % % 2(@)(@@) % وذي عذل معنى بالمعنى % % يميل على الدعابة للعقوق % % 3(@)(@@) % يحوم من الغرام على خلافي % % وأين الروح من نفس الغريق % % PageV01P212 البحر : مديد تام 1(@)(@@) % يا هلالا لاح في شفق % % أعف أجفاني من الأرق % % 2(@)(@@) % فك قلبي يا معذبه % % فهو من صدغيك في حلق % % PageV01P213 البحر : كامل تام 1(@)(@@) % أشبا سيوف الهند أم عيناك % % وجنى جني الورد أم خداك % % 2(@)(@@) % مارنق المغنى الذي غادرته % % قفرا وصيوب الحشا مغناك % % 3(@)(@@) % جودي بمأمول النوال فإنني % % أصبحت مفتقرا إلى جدواك % % 4(@)(@@) % وأراك يغشاني خيالك في الكرى % % أترى خيالي في الكرى يغشاك % % 5(@)(@@) % حجبوك أم حجبوا الحياة فإنني % % لأرى الحياة غداة يوم أراك % % 6(@)(@@) % ولقد رميت فما أصابت أسهمي % % ورميتني فأصابني سهماك % % 7(@)(@@) % وعلقت في أشراككم فاصطدتني % % وتعطلت عن صيدكم أشراكي % % 8(@)(@@) % وأعرت جسمي من جفونك سقمها % % فتحكمت في مهجتي عيناك % % 9(@)(@@) % ولقد ملكت قياد قلبي طائعا % % وفتكت فيه بلحظك الفتاك % % 10(@)(@@) % أنى أحلأ عن موارد لم تزل % % مبذولة السقيا لعود أراك % % PageV01P214 11(@)(@@) % حوت الدلال إذا . . . لداتها % . . . الطعام . . . بالمسواك % % 12(@)(@@) % ردي الوصال على قتيل صبابة % % ما كان يسلم نفسه لولاك % % 13(@)(@@) % سيعوذ منك إذا تراكبت المنى % % بأبي الحسين لعله يكفافك % % 14(@)(@@) % بفتى يجير المستجير إذا عري % % إن كان لا يحمي اللهيف حماك % % 15(@)(@@) % يلقى المعبس من صروف زمانه % % بطلاقة المتهلل الضحاك % % 16(@)(@@) % يتصرف العافون في أمواله % % قبل السؤال تصرف الملاك % % 17(@)(@@) % أمسكت عن مدحيه حتى إنني % % أيقنت أن سيضرني إمساكي % % 18(@)(@@) % ومدحته مستدركا ولربما % % عفى على تقصيري استدراكي % % 19(@)(@@) % قد كنت يا ابن الأكرمين ملكتني % % فعساك تسمح منعما بفكاكي % % 20(@)(@@) % رويت عليك شواهد من مدرك % % للمجد قبل شواهد الإدراك % % PageV01P215 21(@)(@@) % بشرت بالمجد التليد ملكته % % في الناس قبل بشارة الأملاك % % 22(@)(@@) % تقديم علمك بالإله تيقنا % % من حيث كان تأخر النساك % % 23(@)(@@) % في المذهب الأمم 
ms52	 الذي لا ينتهى % % فيه بمعتقد إلى الإشراك % % 24(@)(@@) % سر يفرق بين كل مصدق % % بر وكل مشبه أفاك % % 25(@)(@@) % حزت الهدى واستشعروا بضلالة % % فتتيهوا في صحصح دكداك % % 26(@)(@@) % وعلو همتك التي لم تقتنع % % حتى علت بك شامخ الأفلاك % % 27(@)(@@) % أموالهم حل وما ملك الغنى % % من صرحوا بعداوة ومحاك % % 28(@)(@@) % وكلاهما ملك لديك فخذ له % % إسلامه ولهذه بهلاك % % 29(@)(@@) % خذها سبيكة عسجد سمحت بها % % أفكار صواغ لها سباك % % 30(@)(@@) % كالوشي إلا أنها قد نزهت % % في نسجها عن شيمة الحواك % % PageV01P216 31(@)(@@) % كالروض أصبح ضاحكا مما امترى % % جنح الأصيل له السحاب الباكي % % 32(@)(@@) % نظم الكواكب حين ينشد نظمها % % شعرى سرت متلوة بسماك % % PageV01P217 البحر : مجزوء الكامل 1(@)(@@) % أو ما ترى طرب الغدير % % إلى النسيم إذا تحرك % % 2(@)(@@) % بل لو رأيت الماء يلعب % % في جوانبه لسرك % % 3(@)(@@) % وإذا الصبا هبت عليه % % أتاك في ثوب مفرك % % PageV01P218 البحر : متقارب تام 1(@)(@@) % أما آن أن يزهق الباطل % % وأن ينجز العدة الماطل % % 2(@)(@@) % إلى كم يغب ملوك الضلال % % سيف بأعناقها كافل % % 3(@)(@@) % فلا تحفلن بصول الذئاب % % وقد زأر الأسد الباسل % % 4(@)(@@) % كذا ما انثنت قط صم الرماح % % أو يتثنى القنا الذابل % % 5(@)(@@) % هو السيف إلا تكن حاملا % % لبزته بزك الحامل % % 6(@)(@@) % وهل يمنع الدين إلا فتى % % يصول انتقاما فيستاصل % % 7(@)(@@) % أبا جعفر أشرقت دولة % % أضاء لها بدرك الكامل % % 8(@)(@@) % فإما نصبت لرفع اسمها % % فإنكما الفعل والفاعل % % 9(@)(@@) % بك انقاد جامحها المصعبي % % وأخصب جانبها الماحل % % 10(@)(@@) % ليهنك ما أفرج النصر عنه % % وما ناله الملك العادل % % PageV01P219 11(@)(@@) % فتوح الفتوحات نظم القناة % % أعلى أنابيبها العامل % % 12(@)(@@) % فقل للحقاق الطريق الطريق % % فقد دلف المقرم البازل % % 13(@)(@@) % وجاهد في الله حق الجهاد % % محتسب بالعلى قافل % % 14(@)(@@) % بجيش إذا أم ورد الثغور % % يروى به الأسل الناهل % % 15(@)(@@) % إذا شمر البأس عن ساقه % % مضى وهو في نقعه رافل % % 16(@)(@@) % فيا نعمة شمل الشاكرين % % فضلك إفضالها الشامل % % 17(@)(@@) % تمخض عزم لها منجب % % فيا سعد ما وضعت حامل % % 18(@)(@@) % غداة ولا رمح دون الطعان % % إلا وعقربه شائل % % 19(@)(@@) % ولا 
ms53	 نصل إلا له بارق % % دماء الطلى تحته وابل % % 20(@)(@@) % وقد قلدوا السيف تحصينهم % % ولكنه الناصر الخاذل % % PageV01P220 21(@)(@@) % وهل يمنع السور من طالع % % يشايعه القدر النازل % % 22(@)(@@) % شققتم إليها بحار الحديد % % ملتطما موجه الهاطل % % 23(@)(@@) % وخضتم غمار الردى بالردى % % وعن نفسه يدفع القاتل % % 24(@)(@@) % فإن يك فتح الرها لجة % % فساحلها القدس والساحل % % 25(@)(@@) % فهل علمت علم تلك الديار % % أن المقيم بها راحل % % 26(@)(@@) % أرى القمص يأمل فوت الرماح % % ولا بد أن يضرب السابل % % 27(@)(@@) % يقوي معاقله جاهدا % % وهل عاقل بعدها عاقل % % 28(@)(@@) % وكيف بضبط بواقي الجهات % % لمن فات حسبته الحاصل % % 29(@)(@@) % برأيك في الحرب أم لفظك % % استفاد إصابته النابل % % 30(@)(@@) % وعن حد عزمك في المشكلات % % قضى فمضى الصارم القاصل % % PageV01P221 31(@)(@@) % نشرت الفضائل بعد الخمول % % ألا ربما نبه الخامل % % 32(@)(@@) % وحطت البلاد على نأيها % % كأنك في كلها نازل % % 33(@)(@@) % أتعفو الممالك من حافظ % % وصدرك من حفظها آهل % % 34(@)(@@) % ولم لا تحيط بآفاقها % % وفي يدك الصامت القائل % % 35(@)(@@) % إذا ما علا الخمس في حومة % % ففارس بهمتها راجل % % 36(@)(@@) % يفيض على الطرس سحر البيان % % كأن بنانته بابل % % 37(@)(@@) % متى ترك الحمد والمرهفات % % فأحمدها القاطع الواصل % % 38(@)(@@) % بسابقة العلم فت الأنام % % وهل يدرك العالم الجاهل % % 39(@)(@@) % إذا خطب الأكرمون الثناء % % فأكرم أصهارك الفاضل % % 40(@)(@@) % أعز الكفاة وتاج العراق % % من كفه بالندى حافل % % PageV01P222 41(@)(@@) % تأمل مطالع هذا الكلام % % وإلا فكوكبه آفل % % 42(@)(@@) % أرى القوم تلقح آمالهم % % وحالي من دونه حائل % % 43(@)(@@) % فهل لي على البعد من قربة % % يديل بها فضلك الدائل % % 44(@)(@@) % فإن الغمام بعيد المنال % % وفي كل فج له نائل % % 45(@)(@@) % وأنت الزمان وأنت الأمان % % من كل ما يفرق الذاهل % % 46(@)(@@) % وأنت الحلي على المكرمات % % فلا وصفت أنها عاطل % % PageV01P223 البحر : سريع 1(@)(@@) % أقدك الغصن أم الذابل % % ومقلتاك الهند أم بابل % % 2(@)(@@) % سحران هذا طاعن ضارب % % وتلك فيها خبل خابل % % 3(@)(@@) % واكبدي من فارغ لم يزل % % لي من هواه شغل شاغل % % 4(@)(@@) % ظبي متى خاتلته قانصا % % رجعت والمقتنص الخاتل % % 5(@)(@@) % لمته أم أرقم هائج % % وصدغه أم 
ms54	 عقرب شائل % % 6(@)(@@) % وطرفه الفاتك أم لحظه % % ذا سائف طورا وذا نابل % % 7(@)(@@) % يشرب كأسا طلعت في يد % % كوكبها في قمر آفل % % 8(@)(@@) % كأنه والجام في كفه % % بدر الدجى في شفق ناهل % % 9(@)(@@) % غصن النقا يحمل شمس الضحى % % يا حبذا المحمول والحامل % % 10(@)(@@) % أسمر كالأسمر من لحظه % % له سنان جيده العامل % % PageV01P224 11(@)(@@) % ملاحة بالبخل مقرونة % % كل مليح أبدا باخل % % 12(@)(@@) % إذا نأى مثله في الكرى % % هواه فهو القاطع الواصل % % 13(@)(@@) % أشكو ضنى جسمي إلى خصره % % وكيف يشفي الناحل الناحل % % 14(@)(@@) % ينكر ما ألقاه من صده % % وأي فعل ماله فاعل % % 15(@)(@@) % من لي على البعد بميعاده % % وإن لواني ديني الماطل % % 16(@)(@@) % وكيف لي بالوصل من طيفه % % وذو الهوى يقنعه الباطل % % 17(@)(@@) % أرى دماء الأسد عند الدمى % % انظر من المقتول والقاتل % % 18(@)(@@) % من كل لاهي القلب من ذاهل % % به فسل أيهما الذاهل % % 19(@)(@@) % يا صاح ما أحلى مذاق الهوى % % لو كان فيه عاذل عادل % % 20(@)(@@) % ما لي لا ألحظ عين المها % % إلا دهاني سربها الخاذل % % PageV01P225 21(@)(@@) % وماله ينفر من لمتي % % كأنه من أسد جافل % % 22(@)(@@) % ما زال ينسي نأيه هجره % % حتى لأنسى عامه القابل % % 23(@)(@@) % قضية جائرة مالها % % غير مجير الدين مستاصل % % 24(@)(@@) % وكيف أخشى من لطيف الحشا % % ظلما وتاج الدولة الدائل % % 25(@)(@@) % كثر حسادي حتى لقد % % تنبه الهاجد والغافل % % 26(@)(@@) % وكاد يعطي في نداه الصبا % % لو أن شيبا بالندى ناصل % % 27(@)(@@) % القائد الخيل مغافيرها % % يزأر فيها الأسد الباسل % % 28(@)(@@) % مشمر للبأس عن ساقه % % والجيش في عثيره رافل % % 29(@)(@@) % ماض فما أورد صادي القنا % % إلا تروى الأسل الناهل % % 30(@)(@@) % يناهز الأعداء من عرفه % % غاز بأنفال العلى قافل % % PageV01P226 31(@)(@@) % لم ينج من سطوته عاند % % ولم يخب في ظله آمل % % 32(@)(@@) % يزجي الندى حتى إذا ما اعتدى % % فالدم من سطوته هاطل % % 33(@)(@@) % ما ساجلته المزن إلا انثنى % % مستحييا من طله الوابل % % 34(@)(@@) % لا يتناهى فيض معروفه % % وأي بحر ماله ساحل % % 35(@)(@@) % سما به نابه آبائه % % حين أسف النسب الخامل % % 36(@)(@@) % وامتاز بالعلم على أهله 
ms55	 % % وهل يساوي العالم الجاهل % % 37(@)(@@) % يا محيي العدل ويا مسرف % % البذل فأنت الجائر العادل % % 38(@)(@@) % يا أنصت الناس إلى حكمة % % يقبلها من سمعه قابل % % 39(@)(@@) % علا بك الفضل ذرى همة % % عن غرة الشعرى لها كاهل % % 40(@)(@@) % لولا سنا فضلك يجلو الدجى % % ما عرف المفضول والفاضل % % PageV01P227 41(@)(@@) % ولم يغامر جودك المقتفي % % ولم يجانب مجدك العادل % % 42(@)(@@) % فهل المحامد ضامنات عنك لي % % معنى على هذا البيان بيانه % % 43(@)(@@) % وهي القوافي ما تناظر بالندى % % إلا وقام بفضلها برهانه % % 44(@)(@@) % ما كان بيت فضيلة في فارس % % إلا ومن عربيتي سلمانه % % 45(@)(@@) % فمن يكن خص بمعروفه % % فأنت من إحسانه شامل % % 46(@)(@@) % بوركت من غيث إذا ما همى % % روض منه الأمل الماحل % % 47(@)(@@) % إن هزك العزم فيا طالما % % أرهف منك الصارم القاصل % % 48(@)(@@) % سيف متى أم نفوس العدى % % صمم والنصر بها كافل % % 49(@)(@@) % فكنت كالشمس سمت إذ سمت % % ونورها في أفقها ماثل % % 50(@)(@@) % وأين ينأى من قلوب الورى % % من حبه في كلها نازل % % PageV01P228 51(@)(@@) % فابق حيا ينبت روض المنى % % وأين من أفعالك القائل % % 52(@)(@@) % ودم فما دمت منار الهدى % % فللمعالي سنن سابل % % PageV01P229 البحر : طويل 1(@)(@@) % حين سما لي في السلو سبيل % % توكل بي بالآخرين وكيل % % 2(@)(@@) % وغر ضعيف الخصر بين جفونه % % من اللحظ ماضي الشفرتين كليل % % 3(@)(@@) % له خيمة بالتل غير وخيمة % % يفيء لها ظل عليه ظليل % % 4(@)(@@) % تدافع عنه غيرة الشمس بالضحى % % وللظبي في ظل الكناس مقيل % % 5(@)(@@) % يقولون لي نوم العليل مشرد % % فلم نال منه الطرف وهو كليل % % 6(@)(@@) % يسائلني ما حاجتي وهو عالم % % ورب جواب ما إليه سبيل % % 7(@)(@@) % وأطمع منه في الوصال ودونه % % دلال على الهجران منه دليل % % 8(@)(@@) % متى سمحت عين لعان بفدية % % فلا فاتني من ذا الجمال جميل % % PageV01P230 البحر : كامل تام 1(@)(@@) % ملك المدى يوم أغر محجل % % يأتي السوابق وهو منها أول % % 2(@)(@@) % يختال في عطفيه جو ضاحك % % ويميس في طرفيه عام مقبل % % 3(@)(@@) % جاء الربيع له بأكمل زينة % % فأتاك في خلع الغمائم يرفل % % 4(@)(@@) % من أقحوان ما جرى دمع 
ms56	 الحيا % % إلا تبسم من شقيق يخجل % % 5(@)(@@) % وعيون نور هومت أجفانها % % فسرى ينبهها النسيم المرسل % % 6(@)(@@) % فلكل ضاحكة إذا استجليتها % % ثغر بأفواه العيون يقبل % % PageV01P231 البحر : طويل 1(@)(@@) % تنوء بها يوم الخصام حلومها % % وتغدو بها نحو الصريخ خيولها % % 2(@)(@@) % كأن أنابيب القنا بأكفهم % % قداح بأيدي اللاعبين تجيلها % % PageV01P232 البحر : رجز تام 1(@)(@@) % يا سعد ما أحسنها شمائلا % % لو لم تكن سانحة شمائلا % % 2(@)(@@) % ترنو إليك باعتراض مثل ما % % ترنو المها تعرضت مطافلا % % 3(@)(@@) % فوقها سوالفا وأعينا % % أما ترى السيوف والحمائلا % % 4(@)(@@) % من كل ذي دل غريب نعته % % أحسن ما كان جبانا باخلا % % 5(@)(@@) % ولم أكن أعلم قبل ختلها % % أن الظباء تنصب الحبائلا % % 6(@)(@@) % راشقة بالنبل من ألحاظها % % كأن تحت كل جفن نابلا % % 7(@)(@@) % ما اتخذت أعيننا مقاصدا % % حتى أرتها المهج المقاتلا % % 8(@)(@@) % إذا تصدى للعيون سحرها % % أرتك ما بين الجفون بابلا % % 9(@)(@@) % وإن تبارى لحظها ولفظها % % قلت أبو الفضل تلا الفضائلا % % 10(@)(@@) % من يصدر السامع عن كلامه % % مصادرا من النهى حوافلا % % PageV01P233 11(@)(@@) % ويذهل الناطق عن جوابه % % حتى ترى كل فصيح باقلا % % 12(@)(@@) % مناقب تأبى المساعي أن يرى % % فيها كمال الدين إلا كاملا % % 13(@)(@@) % قاضي القضاة مشرقا ومغربا % % كافي الكفاة لجة وساحلا % % 14(@)(@@) % ندب إذا استندبته داعي الندى % % لبى النداء قائلا وفاعلا % % 15(@)(@@) % قد غرس الحمد له في منطقي % % فرائضا مثمرة نوافلا % % 16(@)(@@) % لا يعرف المعروف إلا غامرا % % ولا يرى الإحسان إلا شاملا % % 17(@)(@@) % مكارم دلت على شيمته % % إن لكل شيمة دلائلا % % 18(@)(@@) % حامل كف حامل متى تضع % % كانت لها أيدي الورى قوابلا % % 19(@)(@@) % وهمة سيارة قد جعلت % % منازل البدر لها منازلا % % 20(@)(@@) % مقيمة ظاعنة كأنما % % أودعها الأشعار والرسائلا % % PageV01P234 21(@)(@@) % يهمي على الظمآن من سماحه % % غيث تكون سحبه أناملا % % 22(@)(@@) % وتبعث الأقلام من فطنته % % مراسلا تضطهد المراسلا % % 23(@)(@@) % وتنتضي الخطوب من عزمته % % صوارما لا تعرف الصياقلا % % 24(@)(@@) % ما ارتدف الأقوام أعجاز العلى % % حتى علاها صهوة وكاهلا % % 25(@)(@@) % ما زال للأيتام منه كافل % % حتى اغتدى للمكرمات كافلا % % 26(@)(@@) % فللقوا في ضجة ببابه % % حين رأت 
ms57	 إنصافه الأراملا % % 27(@)(@@) % عدل على الآمال إلا أنه % % مال على المال فليس عادلا % % 28(@)(@@) % يا ماجدا ما برحت آلاؤه % % فضائلا نعتدها فواضلا % % 29(@)(@@) % إن العطايا كالقضايا حيرة % % ما لم يكن حكمك فيها الفاصلا % % 30(@)(@@) % فعافيا يندب رسما عافيا % % وسائلا لا يجتني وسائلا % % PageV01P235 31(@)(@@) % وأنت من حامى الندى عن مجده % % حتى ابتنى الحمد له معاقلا % % 32(@)(@@) % وإنما بذل المعالي فرصة % % من بذل النائل كان النائلا % % 33(@)(@@) % من لم تلد حسن الثناء إنها % % محمولة جاءت إليك حاملا % % 34(@)(@@) % حاشاك أن يطوي عنها وده % % من قد طوت من دونه المراحلا % % 35(@)(@@) % مناسب نسيبها مديحها % % تصاهر الأواخر الأوائلا % % 36(@)(@@) % محامد لا كالدمى وإنما % % تلك العقول اجتليت عقائلا % % 37(@)(@@) % قليلة أمثالها كثيرة % % أمثالها ما برحت مواثلا % % 38(@)(@@) % فاسعد بها قواطنا ظواعنا % % واجتلها حواليا عواطلا % % PageV01P236 البحر : خفيف تام 1(@)(@@) % يا غريرا غر الفؤاد المدله % % يا عزيزا به عرفت المذله % % 2(@)(@@) % بأبي ذلك الملاك وإن أصبح % % من قتلتي على غير مله % % 3(@)(@@) % كلما ناظر العواذل فيه % % رحت من دله قوي الأدله % % 4(@)(@@) % أيها الشادن المحرم وصلي % % كيف أغفلت مقلة مستحله % % 5(@)(@@) % وإذا كان لحظها سبب السقم % % فلم قيل إنها معتله % % 6(@)(@@) % ومن الوجد في العلاقة أني % % لا أمل الصدود حتى تمله % % 7(@)(@@) % حدثوه بعلتي وسقامي % % فعسى أن يرق لي ولعله % % 8(@)(@@) % آه ممن إذا رفعت إليه % % من غرامي أدقه وأجله % % 9(@)(@@) % رد رزنامج الشكاة وقد وقع % % لي فيه صح والحمد لله % % 10(@)(@@) % نظرا عادلا كأن عماد الدين % % من لفظه عليه أمله % % PageV01P237 11(@)(@@) % ألمعيا هواه عندي على البعد % % مولى على فؤادي الموله % % 12(@)(@@) % ذا يد ذائدا بها نوب الدهر % % فكم ردها بأبرح غله % % PageV01P238 البحر : طويل 1(@)(@@) % أيا عاذلي في الحب مالي وللعذل % % ويا هاجري هل من سبيل إلى وصل % % 2(@)(@@) % أحين استجارتك الملاحة في الهوى % % بخلت كأن الحسن في ذمة البخل % % 3(@)(@@) % لي الله من قلب تملكه الجوى % % فأمسى أسيرا رهن حبل من الخبل % % 4(@)(@@) % منيت بمثل البدر في مستقره % % يريك المنال الصعب في المنظر السهل % % 5(@)(@@) % إذا 
ms58	 ما التقينا جال طرفي وطرفه % % فأنظر من دمع وبنظر من نصل % % 6(@)(@@) % فيا ويح قلبي من بلاه بحبه % % ومن دل ألحاظي على ذلك الدل % % 7(@)(@@) % ويا لي من ليل طويل كهجره % % وصبر ضعيف ضعف أجفانه النجل % % 8(@)(@@) % ألفت قلاه واستطبت مطاله % % وأطيب ما جاء الوصال على مطل % % 9(@)(@@) % إذا ما الكرى أهدى إلي خياله % % فيا حبذا تهويمة جمعت شملي % % 10(@)(@@) % سلوا القمر المفتي بأن لقاءه % % علي حرام كيف حل له قتلي % % PageV01P239 11(@)(@@) % ويا ليلة باتت تمخض بالنوى % % إلى أن تجلت وهي واضعة الحمل % % 12(@)(@@) % نشدت فؤادا بات ينشد لبه % % فجسمي بلا قلب وقلبي بلا عقل % % 13(@)(@@) % وقالوا حباك الشيب بالحلم والنهى % % ومن لي بأيام الشبيبة والجهل % % 14(@)(@@) % ليالي أجتاب الليالي صبوة % % فرامي غرامي لا يرى موقع النبل % % 15(@)(@@) % متى ما خلا قلب المحب من الهوى % % فيا لك من ربع أقام بلا أهل % % 16(@)(@@) % ألم تر أن الشيب بين جوانحي % % أقام مقام الفضل عند أبي الفضل % % 17(@)(@@) % خليلا صفاء لا يريدان فرقة % % وهل يصبر الخل الودود عن الخل % % 18(@)(@@) % عقيد المعالي بين كفيه والندى % % مواثيق عقد لا تروع بالحل % % 19(@)(@@) % ويبسم عن ثغر يبشر بالحيا % % كما بشر البرق اليماني بالوبل % % 20(@)(@@) % دعوه كمال الدين نعتا وإنه % % لأولى بأوصاف الكمال من الكل % % PageV01P240 21(@)(@@) % مناقبه بين الورى مستفيضة % % إذا رويت لم تعتبر صحة النقل % % 22(@)(@@) % وكيف بإنكار المساعي عريقة % % يؤيدها من بعد ما كان من قبل % % 23(@)(@@) % وما العلم إلا سيرة شهدت بها % % أسانيدها أورد فرع إلى أصل % % 24(@)(@@) % إذا الحجب عن قاضي القضاة ترفعت % % سما لك كهل الرأي في المنصب الكهل % % 25(@)(@@) % متى ارتجل الإيجاز في صدردسته % % رأيت الخطاب الفصل في ذلك الفصل % % 26(@)(@@) % وليس جزيل الحمد إلا لمن له % % دقيق معاني العلم في المنطق الجزل % % 27(@)(@@) % غريب العلى يفتن في مكرماته % % إذا ما انقضى شكل بدا بك في شكل % % 28(@)(@@) % وجدنا ابن عبد الله أندى من الحيا % % وأعلى محلا منه في الزمن المحل % % 29(@)(@@) % يبلغ ذا الآمال قاصية المنى % % على ظهر 
ms59	 ما يعلو من العزم أو يعلي % % 30(@)(@@) % فطورا يباريه الرجاء على النوى % % وطورا تناجيه المطالب في الرحل % % PageV01P241 31(@)(@@) % إليك انتضى شوقي إليك عزيمة % % هي النصل تحت الليل أو سلة النصل % % 32(@)(@@) % إذا ما اقتضى الورد الصدى صدرت بنا % % على غير مهل عن موارد كالمهل % % 33(@)(@@) % ونهج كنهج النمل في غلس الدجى % % سلكت وغمدي قرية من قرى النمل % % 34(@)(@@) % سنا مرهف يقضي لدعوى مضائه % % يمين المحامي عنه أو شاهد الفل % % 35(@)(@@) % على سابح يطوي المدى بسنابك % % لمستها فوق الصفا طاعة الرمل % % 36(@)(@@) % سفيه الخطى حتى إذا جثم القطا % % فلا عن أفاحيص الفلا لمم السبل % % 37(@)(@@) % كأن القوافي راهنته بأنها % % تباريه أو تتلو المقال على الفعل % % 38(@)(@@) % على ماجد أمواله بيد الندى % % فليس عليها من وكيل سوى البذل % % 39(@)(@@) % أتت مستجيرات فهل من حمية % % لهذا الكلام الحر في الزمن النذل % % 40(@)(@@) % وأنت فشمس العدل حكما وحكمة % % وظلم بنات الفكر عدل عن العدل % % PageV01P242 41(@)(@@) % أبا الفضل كم لي في مساعيك مدحة % % ألذ على الأفواه من ضرب النحل % % 42(@)(@@) % ترى القوم فيها بين راو وسامع % % كلا عاشقيها لدهر يكتب أو يملي % % 43(@)(@@) % فريدة لفظ في فريد محاسن % % فتلك بلا مثل وأنت بلا مثل % % PageV01P243 البحر : بسيط تام 1(@)(@@) % خاطر بقلبك إما صبوة الغالي % % فيما أحب وإما سلوة السالي % % 2(@)(@@) % هذا مكر الهوى فاعطف على نظر % % في بابليته هندي بلبال % % 3(@)(@@) % من كل ذي هيف ترنو لواحظه % % إليك من لهذم في صدر عسال % % 4(@)(@@) % أبل كل سقيم غير ناظره % % وغير جسمي ما هما بإبلال % % 5(@)(@@) % كم ليلة بت من كأسي وريقته % % نشوان أمزج سلسالا بسلسال % % 6(@)(@@) % وبات لا تحتمي عني مراشفه % % كأنما ثغره ثغر بلا وال % % 7(@)(@@) % يا مطلقي ما بقي للحب من جسدي % % وفي يديهم فؤادي رهن أغلال % % 8(@)(@@) % إن شئتم علم حالي بعد فرقتكم % % فأنصتوا للحمام العاطل الحالي % % 9(@)(@@) % خذوا حديث غرامي عن مطوقة % % تتلو ضلالي في فرع من الضال % % 10(@)(@@) % لم تتركوا لي سوى نفس أجود بها % % والجود بالنفس غير الجود بالمال % % PageV01P244 11 
ms60	(@)(@@) % إذا غضبتم وبات الوجد يشفع لي % % إلى رضاكم رأيت السقم أشفى لي % % 12(@)(@@) % شغلتم نظري عمن نخالسه % % لحظ الهوى وتفرغتم لإشغالي % % 13(@)(@@) % ويا سنا شعري نفرت عن بصري % % بيض الأوانس واستنفرت عذالي % % 14(@)(@@) % هب أن ليل شبابي زال فاحمه % % عني فما بال أسحاري وآصالي % % 15(@)(@@) % كفوا رياح الصبا عني فما بكرت % % إلا بنار هوى قلبي بها صال % % 16(@)(@@) % تجري النعامى فما بالي وقد خطرت % % بالركب ما خطرت إلا على بالي % % 17(@)(@@) % توافدت رسلها بالشوق موقرة % % فأدمعي بين إسراب وإرسال % % 18(@)(@@) % كأن عيني في فضل انسكابهما % % يدا أبي غانم جادت بأفضال % % 19(@)(@@) % وتلك مزنة جود كلما ابتسمت % % تبجست بملث الفضل هطال % % 20(@)(@@) % غمر يصدك عن تكذيب مادحه % % ما عند كفيه من تصديق آمالي % % PageV01P245 21(@)(@@) % يثري فلا يستقر المال في يده % % كأنه عذل في سمع مختال % % 22(@)(@@) % متيم ببنات الفكر وهي به % % مفتونة فهو لاشال ولا سال % % 23(@)(@@) % تداركت حاله ودا ومحمدة % % ما غيرت غير الأيام من حالي % % 24(@)(@@) % ألهى توالي دهري عن أوائله % % حتى تسليت بالباقي عن الخالي % % 25(@)(@@) % غارت حميته مني على حكم % % في الشعر يجري عليها حكم جهال % % 26(@)(@@) % ريعوا لها وهي أعمار مخلدة % % كأنني زرتهم منها بآجال % % 27(@)(@@) % فافتك بالجود ما في غل باخلهم % % منها وحقق أقوالا بأفعال % % 28(@)(@@) % وابتز ما لملوك العصر من فكري % % وللأماثل من مضمار أمثالي % % 29(@)(@@) % أرخصت ودي لمن يغلي مساومتي % % سماحة فأنا المسترخص الغالي % % 30(@)(@@) % يا من يزار فيلفى عنده كرم % % بلا حجاب ومجد بالعلى حال % % PageV01P246 31(@)(@@) % تواضعا في علو زاده شرفا % % ما أحسن الشرف الداني من العالي % % 32(@)(@@) % أنت الجواد الذي ممن يماثله % % في غربة ومن الآلاء في آل % % 33(@)(@@) % ما فال رأي القوافي منك في رجل % % ترى نداء اسمه ضربا من الفال % % 34(@)(@@) % من كان من عرب أو كان من عجم % % فأنت يا سعد من يمن وإقبال % % PageV01P247 البحر : خفيف تام 1(@)(@@) % أشرق البهو يا جبين الهلال % % فجلاه لوجهك المتلالي % % 2(@)(@@) % عن ليال حجبن عنا سناها % % إنما غيبة الهلال ليالي % % 3(@)(@@) % لم 