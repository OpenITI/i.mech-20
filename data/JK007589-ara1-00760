ms741	 % % 8(@)(@@) % إلى أن يرحم الله المرجى % % لكل شديدة منه عنيفه % % PageV01P2925 البحر : - 1(@)(@@) % دنيا علا شأن الوضيع بها % % وهوى الشريف يحطه شرفه % 2(@)(@@) % كالبحر يرسب فيه لؤلؤه % سفلا وتطفو فوقه جيفه % 3(@)(@@) % فاصبر على هول الخطوب لها % % قلب نماه إلى العلا سلفه % % 4(@)(@@) % لا مظهرا في عقب نائبة % أسفا وليس يقوده شغفه % 5(@)(@@) % طوع الصديق يقود ربقته % لا بطؤه يخشى ولا عنفه % % 6(@)(@@) % نكل العدو يرى به أسفا % جهما عبوسا موحشا كنفه % 7(@)(@@) % فلقل ما أنحت على أحد % بالجور إلا سوف تنتصفه % % PageV01P2926 البحر : - 1(@)(@@) % المرثديون سادات تعد لهم % % من وائل مأثرات المجد والشرف % 2(@)(@@) % تصرم المجد بالأقوام عن هرم % ومجدهم حدث في العين أو نصف % 3(@)(@@) % وما علي بن عبد الله إن وردت % % جماته بثماد الضحل تنتزف % 4(@)(@@) % متى وصفناه ألفينا محاسنه % % من الوفور على أضعاف ما نصف % 5(@)(@@) % تفديك أنفس ملتاحين أعينهم % معلقات بري منك يؤتنف % 6(@)(@@) % سقيا الزجاج وإن جلت مصردة % فسقناها عليها القار والخزف % 7(@)(@@) % أنتف لنا لهو أيام نعيش بها % % فالدهر أجمع إن راعيته نتف % % PageV01P2927 البحر : - 1(@)(@@) % يا أيها النفر الذين تعجبوا % % من قصة امرأة العزيز ويوسف % % 2(@)(@@) % هاتيكم فتنت بأحسن من مشى % % ممن عرفناه ومن لم نعرف % % 3(@)(@@) % وبحقها وبحقه فتنت به % % أنثى وأغيد كالقضيب الأهيف % 4(@)(@@) % فدعوا التعجب منهما وتعجبوا % % من قشعمين كلاهما كالأسقف % 5(@)(@@) % فتن المهرم بالمشيخ منهما % % قل لي فأية طرفة لم أطرف % % 6(@)(@@) % بايته في بيته فأملني % % يشكو إلي هوى عميد مدنف % 7(@)(@@) % شيخ يراود مثله وكلاهما % % قد زحزح السبعين عنه بنيف % % 8(@)(@@) % ما زال ينشرني ويلثم فيشتي % % حتى ركبت قرا حمار أعجف % % 9(@)(@@) % كشفت منه ثيابه عن سوءة % شوهاء شقت عن عجان أعرف % % 10(@)(@@) % وكأن شيب عجانه حول استه % % بدد الخليط على جوانب معلف % % PageV01P2928 11(@)(@@) % قاسيت منه ليلة مذكورة % لولا دفاع الله لم تتكشف % 12(@)(@@) % فكأن ليلته علي لطولها % % باتت تمخض عن صباح الموقف % % PageV01P2929 البحر : - 1(@)(@@) % إذا ضحكتم ضحكنا في مفارحكم % وإن بكيتم فمنا الأدمع الذرف % 2(@)(@@) % وإن رضيتم رضينا عن 
ms742	 مسالمكم % % وإن غضبتم فنحن الشيعة الأنف % 3(@)(@@) % حتى إذا ما رتعتم في ربيعكم % فنحن إذ ذاك فيه وحدنا العجف % 4(@)(@@) % يا رب عهد ووعد من ذوي كرم % % يستهلكان ويبقى الغدر والخلف % 5(@)(@@) % حتى متى تتقضى دولة أنف % يا أهل ودي وتأتي دولة أنف % % 6(@)(@@) % وليس منكم لمن يرجو منافعكم % % في العسر واليسر إلا الرد والحلف % % 7(@)(@@) % كأنكم قد نسيتم والذكاء لكم % % أن الكرام إذا ما استعطفوا عطف % % 8(@)(@@) % أتشبعون ونطوي في جواركم % من عسرة تلد الإخوان لا الطرف % PageV01P2930 البحر : - 1(@)(@@) % أبا الفضل لا تحتجب إنني % % صفوح عن المخلف الوعد عافي % % 2(@)(@@) % وإني إذا لم يجد صاحبي % % بجدواه قابلته بالعفاف % 3(@)(@@) % أمنت أمنت فلا تحفل % % ن لي باختلاف ولا بانصراف % % 4(@)(@@) % ثكلت أخاك فهو العز % % يز إن لم أصن رغبتي في غلاف % % 5(@)(@@) % وإن لم أصم بعدها مدتي % % من الكشك ما دام في الناس جافي % % 6(@)(@@) % سألتك لا حاجة فاحتجز % % ت مني وطالبتني بالكفاف % % 7(@)(@@) % كأني سألتك قوت العبا % % د في سنة البقرات العجاف % 8(@)(@@) % قليت الرجال أشد القلى % % وعفت جداهم أشد العياف % % 9(@)(@@) % مدحتك مدح امرىء واثق % ومولى وصول وخل مصافي % % 10(@)(@@) % فكافأتني بازورار يفو % % ق كل ازورار وكل انحراف % PageV01P2931 11(@)(@@) % وأصبحت ملتحفا عندها % % على ما ملكت أشد التحاف % 12(@)(@@) % كأني كتفتك لما حلل % ت فيك لساني أشد الكتاف % 13(@)(@@) % وقد كنت خلتك مثل الفرا % % ت لا تمنع الري من ذي اغتراف % 14(@)(@@) % وما كنت أحسب أني لدي % % ك من طرز أهل الرثاث الخفاف % % 15(@)(@@) % سألت فقيزين من حنطة % فجدت بكد من المنع وافي % % 16(@)(@@) % وأتبعت منعك لي بالحجا % % ب مهلا هديت ففي المنع كافي % % 17(@)(@@) % سألتك حبا لكشك القدو % % ر أنسا بتلك السجايا الظراف % % 18(@)(@@) % فماطلتني ثم راوغتني % % فكدرت من ودنا كل صافي % % 19(@)(@@) % كأني سألتك حب القلو % % ب ذاك الذي من وراء الشغاف % % 20(@)(@@) % أخفت المجاعة يا هاشمي % ي متهما لأمان الآلاف % % PageV01P2932 21(@)(@@) % وقد هتف الله في وحيه % % به لقريش أشد الهتاف % % 22(@)(@@) % أم اكتنفت أذنك العاذلا % % ت 
ms743	 باللوم في ذاك كل اكتناف % % 23(@)(@@) % عليك السلام ولولا الإخاء % لجاءتك بعد قواف قوافي % % 24(@)(@@) % لقد ساءني أن تكون انهزم % % ت قبل الوقاف وقبل الثقاف % 25(@)(@@) % ولو كان غيرك ثم استحال % % للاقى ملامي كصخر القذاف % % 26(@)(@@) % وهل ينكر الحق أني امرؤ % من اعوج قومته بالثقاف % % 27(@)(@@) % كأني أراك وقد قلت جا % % ء يأخذ حنطتنا بالخراف % % 28(@)(@@) % موالينا أنصفوا أنصفوا % % فظلمكم ظاهر غير خافي % % 29(@)(@@) % سمحتم بضيعتكم للخسا % % ر يأكلها ناعل بعد حافي % % 30(@)(@@) % حمت من مواليكم خيرها % % ولكنها للأقاصي صوافي % % PageV01P2933 31(@)(@@) % وإني لأظلم في لومكم % % وإن كان فيكم ومنكم تجافي % % 32(@)(@@) % لأني أرى الناس قد خبلوا % % وأصبح زيهم من خلاف % 33(@)(@@) % فأقدامهم في قلنسيهم % % جنوبا وهامهم في الخفاف % % 34(@)(@@) % بني هاشم أين عن ضيفكم % % هشيم ثريدكم في الصحاف % % 35(@)(@@) % أماء سواقيكم في الخسو % % ف أم بذر حنطتكم في خساف % % 36(@)(@@) % ألم يبن هاشمكم مجدكم % % وعبا منافكم في النياف % 37(@)(@@) % عليك برأيك في حاجتي % % ففيه لعمري من الداء شافي % % 38(@)(@@) % ولا تأس من رجعتي إن محو % % ت سوء اقتراف بحسن اعتراف % 39(@)(@@) % ولا تعتذر غير ما معذر % % فليس لما بيننا من تلافي % % 40(@)(@@) % إلى أن يرد قناع المشي % % ب لي حالكا كجناح الغداف % PageV01P2934 البحر : - 1(@)(@@) % يا ابن أبي الجهم احتقب هذا اللطف % فإن فيه طرفا من الطرف % 2(@)(@@) % يا جثة التل ويا وجه الهدف % يا روثة الفيل ويا لحم الصدف % 3(@)(@@) % يا أجرة البيت قضاء وسلف % % يا ليلة الخان إذا الخان وكف % % 4(@)(@@) % يا غم آب عند سكان الغرف % % يا برد كانون لعار بالنجف % 5(@)(@@) % يا ثلج ماء مالح فيه جيف % يا خزف التنور يا شر الخزف % 6(@)(@@) % يا سوء كيل وغلاء وحشف % يا نوبة الفقر ويا سن الخرف % % 7(@)(@@) % يا طيرة الشؤم ويا فأل التلف % % يا سدة في المنخرين من نغف % 8(@)(@@) % من كان يشكو فرط حب وشغف % % فإن بي منك لبغضا وشنف % 9(@)(@@) % أدناهما مثل السقام والدنف % % بيتك بيت نطف كل النطف % % 10(@)(@@) % لا يلتقي فيه العفاف والشرف % % بل 
ms744	 تلتقي فيه بظور وقلف % PageV01P2935 11(@)(@@) % كم طائرا أغفلته حتى جدف % أحسن ماهر به سوء العلف % % 12(@)(@@) % لا زلت من دهرك في شر كنف % يليك منه جنف بعد جنف % % 13(@)(@@) % مالك في بغضك إن مت خلف % % إلا بنيك الخلف من شر سلف % % PageV01P2936 البحر : - 1(@)(@@) % طاف الخيال وعن ذكراك ما طافا % % فكان أكرم طيف طارق ضافا % % 2(@)(@@) % طيف عراني فحياني وأتحفني % % بالنرجس الغض والتفاح إتحافا % % 3(@)(@@) % عينان جاورتا خدين ما خلقا % % 5(@)(@@) % % إلا شقاء يراه الغر إترافا % % 6(@)(@@) % وكم ألم فأهدت لي محاسنه % % من الفواكه والريحان أصنافا % % 7(@)(@@) % رمان عدن وأعنابا مهدلة % وأقحوانا يسقى الراح رفافا % % 8(@)(@@) % ويانعا من جنى العناب تتبعه % % قلب المودع تذكارا وتأسافا % % 9(@)(@@) % أسرى بأنواع ريحان وفاكهة % % يأبين قطفا وإن خيلن إقطافا % % 10(@)(@@) % لله ضيفك من ضيف قرى نزلا % من الغرور عميد القلب مكلافا % % 11(@)(@@) % قرى هو البرح إعقابا وإن وجدت % منه النفوس مذاق العيش إسلافا % % PageV01P2937 12(@)(@@) % أقر عيني في ليلى وصبحني % % وجدا أفاضهما بالماء شفافا % % 13(@)(@@) % لا خير في قرة للعين معقبة % دمعا يخدد في الخدين ذرافا % % 14(@)(@@) % أعجب بوجد مزور قاد زائره % بل لم تزل ذكر يجلبن أطيافا % % 15(@)(@@) % هب الضمير ونام الطرف فاجتلبت % ذكراك والنوم زورا طالما جافى % % 16(@)(@@) % صافيته فحباك النوم زورته % % وكان ذلك حق النبه لو صافى % % 17(@)(@@) % وافاك والليل قد ألقى مراسيه % % خيال من ليس بالوافي ولو وافى % % 18(@)(@@) % في شيعة كالنجوم الزهر معتمة % أحدقن بالبدر أشباها وألافا % % 19(@)(@@) % بيض كسين حليا لا كفاء لها % % حسنا فأكسفنها بالحسن إكسافا % % 20(@)(@@) % شبهن بالدر إذ ألبسن فاخره % بل كن درا وكان الدر أصدافا % % 21(@)(@@) % يا حسن ليل وإصباح جمعنهما % % والليل ملق على الآفاق أكنافا % % PageV01P2938 22(@)(@@) % غر تجللن أسدافا مرجلة % على وجوه وضاء جبن أسدافا % % 23(@)(@@) % ومسن في حلل الأفواف عاطرة % فخلتهن لبسن الروض أفوافا % % 24(@)(@@) % من كل مجدولة إن أقبلت عطفت % أعطافها من قلوب الناس أعطافا % % 25(@)(@@) % وإن تولت فريا الخلق تتبعها % % أرادفها من قلوب الناس أردافا % % 26(@)(@@) % لو أن لي عند من أحببته 
ms745	 مقة % لصدق الحلم إلثاما وإرشافا % % 27(@)(@@) % لكن هيفاء تلقى الله صادية % إلى الدماء التي حرمن مهيافا % % 28(@)(@@) % تبا لحكم الغواني والمقربه % % فما رأى فيه راء قط إنصافا % % 29(@)(@@) % أسعفن بالملك عفوا فائتلين معا % أن لا يرى طالب منهم إسعافا % % 30(@)(@@) % يا سائلي بالغواني من صبابته % % سائل بهن فقد صادفت وصافا % % 31(@)(@@) % هن اللواتي إذلاقيتهن ضحى % لاقيت صدا وإشراقا وإخطافا % % PageV01P2939 32(@)(@@) % مثل السيوف إذا لاقيت مصلتها % % لاقيت حدا وإمهاء وإرهافا % % 33(@)(@@) % أرضيننا حسن قد زانه بشر % صاف وأسخطتنا مطلا وإخلافا % % 34(@)(@@) % بخلن عنا بما يسألن من وتح % % نزر وأجحفن بالألباب إجحافا % % 35(@)(@@) % وإنني للذي غادرنه عطلا % % بغير لب وإن أحسنت أوصافا % % 36(@)(@@) % أسقمن قلبي بألوان مصححة % وأعين أدنفت بالغنج إدنافا % % 37(@)(@@) % يا مكذبا لي في دعواي شككه % % أن فتر الدمع وبلا منه وكافا % % 38(@)(@@) % بواطن الحب أدهى من ظواهره % % كما علمت وشر الداء ما اجتافا % % 39(@)(@@) % ما للأحبة قد ضمن صبوتنا % % بعد الإنابة سكيتا وهتافا % % 40(@)(@@) % طورا حماما وطورا منزلا خرسا % ما لم ترجع به الأرواح زفزافا % % 41(@)(@@) % أو طارقا في حريم النوم يطرقنا % % أو بارقا لعزاء القلب خطافا % % PageV01P2940 42(@)(@@) % أو حنة من حنين النيب ما برحت % تهيج للصب أبراحا وأشعافا % % 43(@)(@@) % كل يجد لنا شجوا يذكرنا % % إلفا فيمنحنا الأحزان ألافا % % 44(@)(@@) % لا تعجبن لمرزوق أخي هوج % حظا تخطى أصيل الرأي طرافا % % 45(@)(@@) % فخالق الناس أعراء بلا وبر م طاف الخيال وعن ذكراك ما طافا % % فكان أكرم طيف طارق ضافا % % 46(@)(@@) % طيف عراني فحياني وأتحفني % % بالنرجس الغض والتفاح إتحافا % % 47(@)(@@) % عينان جاورتا خدين ما خلقا % % إلا شقاء يراه الغر إترافا % % 48(@)(@@) % وكم ألم فأهدت لي محاسنه % % من الفواكه والريحان أصنافا % % 49(@)(@@) % رمان عدن وأعنابا مهدلة % وأقحوانا يسقى الراح رفافا % % 50(@)(@@) % ويانعا من جنى العناب تتبعه % % قلب المودع تذكارا وتأسافا % % 51(@)(@@) % أسرى بأنواع ريحان وفاكهة % % يأبين قطفا وإن خيلن إقطافا % % PageV01P2941 52(@)(@@) % لله ضيفك من ضيف قرى نزلا % من الغرور عميد القلب مكلافا % % 53(@)(@@) % قرى هو البرح إعقابا وإن وجدت % منه النفوس مذاق 
ms746	 العيش إسلافا % % 54(@)(@@) % أقر عيني في ليلى وصبحني % % وجدا أفاضهما بالماء شفافا % % 55(@)(@@) % لا خير في قرة للعين معقبة % دمعا يخدد في الخدين ذرافا % % 56(@)(@@) % أعجب بوجد مزور قاد زائره % بل لم تزل ذكر يجلبن أطيافا % % 57(@)(@@) % هب الضمير ونام الطرف فاجتلبت % ذكراك والنوم زورا طالما جافى % % 58(@)(@@) % صافيته فحباك النوم زورته % % وكان ذلك حق النبه لو صافى % % 59(@)(@@) % وافاك والليل قد ألقى مراسيه % % خيال من ليس بالوافي ولو وافى % % 60(@)(@@) % في شيعة كالنجوم الزهر معتمة % أحدقن بالبدر أشباها وألافا % % 61(@)(@@) % بيض كسين حليا لا كفاء لها % % حسنا فأكسفنها بالحسن إكسافا % % PageV01P2942 62(@)(@@) % شبهن بالدر إذ ألبسن فاخره % بل كن درا وكان الدر أصدافا % % 63(@)(@@) % يا حسن ليل وإصباح جمعنهما % % والليل ملق على الآفاق أكنافا % % 64(@)(@@) % غر تجللن أسدافا مرجلة % على وجوه وضاء جبن أسدافا % % 65(@)(@@) % ومسن في حلل الأفوف عاطرة % فخلتهن لبسن الروض أفوافا % % 66(@)(@@) % من كل مجدولة إن أقبلت عطفت % أعطافها من قلوب الناس أعطافا % % 67(@)(@@) % وإن تولت فريا الخلق تتبعها % % أرادفها من قلوب الناس أردافا % % 68(@)(@@) % لو أن لي عند من أحببته مقة % لصدق الحلم إلثاما وإرشافا % % 69(@)(@@) % لكن هيفاء تلقى الله صادية % إلى الدماء التي حرمن مهيافا % % 70(@)(@@) % تبا لحكم الغواني والمقربه % % فما رأى فيه راء قط إنصافا % % 71(@)(@@) % أسعفن بالملك عفوا فائتلين معا % أن لا يرى طالب منهم إسعافا % % PageV01P2943 72(@)(@@) % يا سائلي بالغواني من صبابته % % سائل بهن فقد صادفت وصافا % % 73(@)(@@) % هن اللواتي إذلاقيتهن ضحى % لاقيت صدا وإشراقا وإخطافا % % 74(@)(@@) % مثل السيوف إذا لاقيت مصلتها % % لاقيت حدا وإمهاء وإرهافا % % 75(@)(@@) % أرضيننا حسن قد زانه بشر % صاف وأسخطتنا مطلا وإخلافا % % 76(@)(@@) % بخلن عنا بما يسألن من وتح % % نزر وأجحفن بالألباب إجحافا % % 77(@)(@@) % وإنني للذي غادرنه عطلا % % بغير لب وإن أحسنت أوصافا % % 78(@)(@@) % أسقمن قلبي بألوان مصححة % وأعين أدنفت بالغنج إدنافا % % 79(@)(@@) % يا مكذبا لي في دعواي شككه % % أن فتر الدمع وبلا منه وكافا % % 80(@)(@@) % بواطن الحب أدهى من ظواهره % % كما علمت وشر الداء ما اجتافا % % 81(@)(@@) % ما 
ms747	 للأحبة قد ضمن صبوتنا % % بعد الإنابة سكيتا وهتافا % % PageV01P2944 82(@)(@@) % طورا حماما وطورا منزلا خرسا % ما لم ترجع به الأرواح زفزافا % % 83(@)(@@) % أو طارقا في حريم النوم يطرقنا % % أو بارقا لعزاء القلب خطافا % % 84(@)(@@) % أو حنة من حنين النيب ما برحت % تهيج للصب أبراحا وأشعافا % % 85(@)(@@) % كل يجد لنا شجوا يذكرنا % % إلفا فيمنحنا الأحزان ألافا % % 86(@)(@@) % لا تعجبن لمرزوق أخي هوج % حظا تخطى أصيل الرأي طرافا % % 87(@)(@@) % فخالق الناس أعراء بلا وبر ه % % كاسي البهائم أوبارا وأصوافا % % 88(@)(@@) % مازلت أعرف أهل العجز في دعة % لا يكلفون وأهل الكيس كلافا % % 89(@)(@@) % أما ترى هذه الأنعام قد كفيت % % فما تساوم بالأخفاف خفافا % % 90(@)(@@) % يكفي أخا العجز ما يقضي القدير به % % من لا ترى منه عند الحكم إجنافا % % 91(@)(@@) % وكلب خصب زهاه الحظ قلت له % % لا تستوي والأسود السود غضافا % % PageV01P2945 92(@)(@@) % أطغاك جهل بما أعطتك مرحمة % قدما أطالت على الحراص رفرافا % % 93(@)(@@) % دع من قوافيك ما يكفيك إن لها % % في مدح أحمد إعناقا وإيجافا % % 94(@)(@@) % فامدح به الشعر مدحا تستفيد به % % وفرا وتكبت حسادا وشنافا % % 95(@)(@@) % أضحى أبو جعفر الطائي منتجعا % ومستجارا لمن رجى ومن خافا % % 96(@)(@@) % قرم إياس وأوس من عشيرته % % وحاتم كرم السلاف سلافا % % 97(@)(@@) % تقدموا وعلوا قدما وشم بهم % % روح الحياة فكان القوم أنافا % % 98(@)(@@) % كانوا مراعي للأرباع ممرعة % في كل حين وللمرتاع أكهافا % % 99(@)(@@) % سلاف صدق فلا زال المليك لهم % % بمثل أحمد في الخلاف خلافا % % 100(@)(@@) % أغر أبلج ما ينفك معتقلا % للحمد مبتذلا للمال متلافا % % 101(@)(@@) % مسهلا سبل الجدوى لطالبها % % لعرضه ولدين الله ظلافا % % PageV01P2946 102(@)(@@) % أزمانه بنداه الغمر أشتية % وإن غدت بجناه الحلو أصيافا % % 103(@)(@@) % كأنه والعفاة الطائفين به % % بنية الله والحجاج طوافا % % 104(@)(@@) % أفردته برجائي وانفردت به % % وظل قوم على الأوثان عكافا % % 105(@)(@@) % يدعون من لا يجيب الهاتفين به % % وإن أملوه تدعاء وتهتافا % % 106(@)(@@) % ألفيت من خالص الياقوت جوهره % % لما وجدت صنوف الناس أخزافا % % 107(@)(@@) % يضحي إذا خزي المداح مادحه % % كذائف المسك لا يخزيه ما ذافا % % 108(@)(@@) % كم حالبين 
ms748	 ضروع العيش درته % % يمرون منهن ضرات وأخلافا % % 109(@)(@@) % لولا أبو جعفر الطائي ما منحوا % % إلا قرونا من الدنيا وأظلافا % % 110(@)(@@) % سهل الخليقة لم يشرك سياسته % % عنف وإن كان بالملحاح معنافا % % 111(@)(@@) % إذا المصاعيب لم تركب تجللها % % قسرا فأعطت مع الإركاب إردافا % % PageV01P2947 112(@)(@@) % ما نعرف الوعد والإيعاد من رجل % سواه إلا أمانيا وإرجافا % % 113(@)(@@) % منابذ لأعاديه وثروته % % فليس يألوهما ما اسطاع إتلافا % % 114(@)(@@) % ممن يرى المنع إسرافا وحق له % % أليس ما يتلف الأعراض إسرافا % % 115(@)(@@) % إذا لوى القوم يوما دين مادحهم % % أعطى عطاياه قبل المدح إسلافا % % 116(@)(@@) % إلى ذراه أنيخت بعد متعبة % أنضاء ركب أملوا الأرض تطوافا % % 117(@)(@@) % ثم استثيرت فثارت وهي مثقلة % وقد أتته تباري الريح أحفافا % % 118(@)(@@) % أمسى أبا منزل والجود خادمه % % والأرض دارا له والناس أضيافا % % 119(@)(@@) % أولى المضيفين بالدفء الملوذ به % % مشتى وأجدرهم بالظل مصطافا % % 120(@)(@@) % يرعي العفاة رياض العرف مؤتنفا % بهم ويرعى رياض الحمد مئنافا % % 121(@)(@@) % أضحت سياسته رصفا ونائله % نثرا فأنطق نثارا ورصافا % % PageV01P2948 122(@)(@@) % سما فحلق منه أجدل لحم % لما أسفت بغاث الطير إسفافا % % 123(@)(@@) % من العتاق يجلي قشعما دربا % حتى إذا ما استبان انقض غطرافا % % 124(@)(@@) % ما زال فاروق ما التفت شواكله % وللجيوش بشرواهن لفافا % % 125(@)(@@) % لم تستمع قط ذكراه ولم تره % % إلا تواضعت واسوضعت إشرافا % % 126(@)(@@) % ألقى إليه أمين الله حربته % % فصادفت منه لقف الكف لقافا % % 127(@)(@@) % مظفرا هز عطفيها مظفرة % إذا تلقت صدورا صرن أكتافا % % 128(@)(@@) % منصورة في يد منصورة أبدا % من محرب لم يزل في الروع دلافا % % 129(@)(@@) % يغشي القناة قناة الظهر معتمدا % على القناتين قصاما وقصافا % % 130(@)(@@) % مصمما غير وقاف وآونة % تلقاه عند حدود الله وقافا % % 131(@)(@@) % ما انفك يقتل مراقا ويأسرهم % % أمضى من الحين أرماحا وأسيافا % % PageV01P2949 132(@)(@@) % حتى غدا الطرف الأقصى به وسطا % من بعد ما كانت الأوساط أطرافا % % 133(@)(@@) % أجلى السباع وأخلى كل مسبعة % فغادر الأرض أحراما وأخيافا % % 134(@)(@@) % ثم استهل على الدنيا بنائله % % حتى غدت فلوات الأرض أريافا % % 135(@)(@@) % لا يوهن الله بطشا منه تعرفه % مزلزلا بأعادي 
ms749	 الله خسافا % % 136(@)(@@) % ولا يغض ماء كف منه ممطرة % تساجل المزن تهطالا وتوكافا % % 137(@)(@@) % إذا رمى أحمد الطائي طائفة % أضحت مقاتلها للنبل أهدافا % % 138(@)(@@) % وإن سقى أرض أخرى صوب راحته % % هزت جنانا من النعماء ألفافا % % 139(@)(@@) % ظهير صدق إذا آخية ضعفت % % وزادها ظهراء السوء إضعافا % % 140(@)(@@) % عم التدابير إلطافا يرد به % % على الأواخي إثخانا وإكثافا % 141(@)(@@) % راخى خناق بني اللأواء كلهم % % وشد آساس ملك كن أجرافا % % PageV01P2950 142(@)(@@) % أخو عطايا إذا ماشاء بدلها % % ضربا يخذف بالأوصال خذرافا % % 143(@)(@@) % وراء بيض أياديه إذا غمطت % بيض يطيح بها بيضا وأقحافا % 144(@)(@@) % إن سالم استنزل الأرزاق واسعة % % أو حارب اتخذ المقدار سيافا % % 145(@)(@@) % سائل صديقا عن الطائي هل ذهبت % دماء قتلاه أو جرحاه أطلافا % % 146(@)(@@) % ألم تر القتل أقوى طائعين له % % عقوبة لم يقارف فيه أحيافا % % 147(@)(@@) % يدا خؤونا ورجلا منه أقسمتا % % تستعملان طوال الدهر إسكافا % % 148(@)(@@) % وإن يكن كان أردى مفلحا عرضا % فقد تصيب سهام الدهر خطرافا % % 149(@)(@@) % وقد يميل على من كان مال له % % ويعقب البؤس من غذاة سرهافا % % 150(@)(@@) % أردى كليبا لجساس وكان له % % ربا وأعدى على بسطام شرخافا % % 151(@)(@@) % واسأل به فارسا إذ سار تطلبه % % سيرا حثيثا يغول الأرض خشافا % % PageV01P2951 152(@)(@@) % في فيلق بات في الظلماء كوكبها % % يهدي وأصبح للأبصار طرافا % % 153(@)(@@) % ففوز اللص حتى قاد من معه % % وكل مال إذا ضيعته سافا % % 154(@)(@@) % من بعد ما كلبوا جوعا فكلهم % % أضحى ظليما بشري الدو نقافا % % 155(@)(@@) % جاروا عن القصد فاستنهاهم حكم % عدل وما جار في حكم ولا حافا % % 156(@)(@@) % وانحاز عن بدد منهم وما ادكرت % خيل الأمير أواريا وأعلافا % % 157(@)(@@) % لكي تطارد كي يغتر مارقة % أخرى إذا ما دهاها كر عطافا % % 158(@)(@@) % وللهنات لقاح ليس يعرفه % % عير وإن كان للأبوال كرافا % % 159(@)(@@) % تحت الأمور أمور لو تبينها % % عير الفلاةلأضحى العير خضافا % % 160(@)(@@) % ما كان دهر قصير جدع معطسه % % لما أطف له موساه إطفافا % % 161(@)(@@) % لكن أراد به أمرا فأدركه % % ولم يردد على مافات إلهافا % % PageV01P2952 162(@)(@@) % فلينتظر فارس أوراد عائدة % لا 
ms750	 يستطيع لها الزواد كفكافا % % 163(@)(@@) % وأين يهرب من خيل تخال بها % % عقبان مبردة يطلبن إلجافا % % 164(@)(@@) % دوخن شيبان أما في رؤوسهم % تدوي الطبيب إذا أغشاه مجرافا % % 165(@)(@@) % وقلن ذوقوا جناكم إن جانيكم % ما زال للحنظل الخطبان نقافا % % 166(@)(@@) % كم جاهل كان بالطائي جربه % % صلا إذا طلب الأعداء زحافا % % 167(@)(@@) % يحرم الغسل إيلاء ويطلقه % % برا فيوخفه بالثأر إيخافا % % 168(@)(@@) % ووقعة منه في الأعراب قد جعلت % أوطانهم إسوة الأحقاف أحقافا % % 169(@)(@@) % تحالفوا مذ تحداهم فخلتهم % % على الهزائم لا الإقدام أحلافا % % 170(@)(@@) % ظلوا قتيلا ومصفودا وذا هرب % تقضي بإدراكه الطير التي اعتافا % % 171(@)(@@) % أسير قتل وإن أضحى طليق يد % قد أزهقت نفسه الآجال إزهافا % % PageV01P2953 172(@)(@@) % ومن سرت نقم الطائي تطلبه % % ألفى الذي وعدته الفوت مخلافا % % 173(@)(@@) % يا هاربا منه إن الليل غاشية % لا بد منها وإن أوشكت إحصافا % % 174(@)(@@) % كيف النجاء لناج من أخي طلب % مثل الظلام إذا ما عم أغدافا % % 175(@)(@@) % كأنما كل نفس حين يطلبها % % قد أعلقت سببا منه وخطافا % % 176(@)(@@) % فاطلب رضاه وأيقن أن سخطته % % لا حرز منها إذا طوفانها طافا % % 177(@)(@@) % تلق ابن حرين لا تلقاه مجترما % فظا على مستميح العفو حلافا % % 178(@)(@@) % بل سيدا قرنت بالحلم حفظته % % فلم تفز قط إلا كان ميقافا % % 179(@)(@@) % يهم بالطول همام به عجلا % وإن أراد عقابا كف كفافا % % 180(@)(@@) % يسوس نفسا على الأغياظ صابرة % مص طاف الخيال وعن ذكراك ما طافا % % 181(@)(@@) % فكان أكرم طيف طارق ضافا % % طيف عراني فحياني وأتحفني % % PageV01P2954 182(@)(@@) % بالنرجس الغض والتفاح إتحافا % % عينان جاورتا خدين ما خلقا % % 183(@)(@@) % إلا شقاء يراه الغر إترافا % % وكم ألم فأهدت لي محاسنه % % 184(@)(@@) % من الفواكه والريحان أصنافا % % رمان عدن وأعنابا مهدلة % 185(@)(@@) % وأقحوانا يسقى الراح رفافا % % ويانعا من جنى العناب تتبعه % % 186(@)(@@) % قلب المودع تذكارا وتأسافا % % أسرى بأنواع ريحان وفاكهة % % 187(@)(@@) % يأبين قطفا وإن خيلن إقطافا % % لله ضيفك من ضيف قرى نزلا % 188(@)(@@) % من الغرور عميد القلب مكلافا % % قرى هو البرح إعقابا وإن وجدت % 189(@)(@@) % منه النفوس مذاق العيش إسلافا % % أقر عيني 
ms751	 في ليلى وصبحني % % 190(@)(@@) % وجدا أفاضهما بالماء شفافا % % لا خير في قرة للعين معقبة % 191(@)(@@) % دمعا يخدد في الخدين ذرافا % % أعجب بوجد مزور قاد زائره % PageV01P2955 192(@)(@@) % بل لم تزل ذكر يجلبن أطيافا % % هب الضمير ونام الطرف فاجتلبت % 193(@)(@@) % ذكراك والنوم زورا طالما جافى % % صافيته فحباك النوم زورته % % 194(@)(@@) % وكان ذلك حق النبه لو صافى % % وافاك والليل قد ألقى مراسيه % % 195(@)(@@) % خيال من ليس بالوافي ولو وافى % % في شيعة كالنجوم الزهر معتمة % 196(@)(@@) % أحدقن بالبدر أشباها وألافا % % بيض كسين حليا لا كفاء لها % % 197(@)(@@) % حسنا فأكسفنها بالحسن إكسافا % % شبهن بالدر إذ ألبسن فاخره % 198(@)(@@) % بل كن درا وكان الدر أصدافا % % يا حسن ليل وإصباح جمعنهما % % 199(@)(@@) % والليل ملق على الآفاق أكنافا % % غر تجللن أسدافا مرجلة % 200(@)(@@) % على وجوه وضاء جبن أسدافا % % ومسن في حلل الأفوف عاطرة % 201(@)(@@) % فخلتهن لبسن الروض أفوافا % % من كل مجدولة إن أقبلت عطفت % PageV01P2956 202(@)(@@) % أعطافها من قلوب الناس أعطافا % % وإن تولت فريا الخلق تتبعها % % 203(@)(@@) % أرادفها من قلوب الناس أردافا % % لو أن لي عند من أحببته مقة % 204(@)(@@) % لصدق الحلم إلثاما وإرشافا % % لكن هيفاء تلقى الله صادية % 205(@)(@@) % إلى الدماء التي حرمن مهيافا % % تبا لحكم الغواني والمقربه % % 206(@)(@@) % فما رأى فيه راء قط إنصافا % % أسعفن بالملك عفوا فائتلين معا % 207(@)(@@) % أن لا يرى طالب منهم إسعافا % % يا سائلي بالغواني من صبابته % % 208(@)(@@) % سائل بهن فقد صادفت وصافا % % هن اللواتي إذلاقيتهن ضحى % 209(@)(@@) % لاقيت صدا وإشراقا وإخطافا % % مثل السيوف إذا لاقيت مصلتها % % 210(@)(@@) % لاقيت حدا وإمهاء وإرهافا % % أرضيننا حسن قد زانه بشر % 211(@)(@@) % صاف وأسخطتنا مطلا وإخلافا % % بخلن عنا بما يسألن من وتح % % PageV01P2957 212(@)(@@) % نزر وأجحفن بالألباب إجحافا % % وإنني للذي غادرنه عطلا % % 213(@)(@@) % بغير لب وإن أحسنت أوصافا % % أسقمن قلبي بألوان مصححة % 214(@)(@@) % وأعين أدنفت بالغنج إدنافا % % يا مكذبا لي في دعواي شككه % % 215(@)(@@) % أن فتر الدمع وبلا منه وكافا % % بواطن الحب أدهى من ظواهره % % 216(@)(@@) % كما علمت وشر الداء ما اجتافا % % ما للأحبة قد ضمن صبوتنا % % 217 
ms752	(@)(@@) % بعد الإنابة سكيتا وهتافا % % طورا حماما وطورا منزلا خرسا % 218(@)(@@) % ما لم ترجع به الأرواح زفزافا % % أو طارقا في حريم النوم يطرقنا % % 219(@)(@@) % أو بارقا لعزاء القلب خطافا % % أو حنة من حنين النيب ما برحت % 220(@)(@@) % تهيج للصب أبراحا وأشعافا % % كل يجد لنا شجوا يذكرنا % % 221(@)(@@) % إلفا فيمنحنا الأحزان ألافا % % لا تعجبن لمرزوق أخي هوج % PageV01P2958 222(@)(@@) % حظا تخطى أصيل الرأي طرافا % % فخالق الناس أعراء بلا وبر % 223(@)(@@) % كاسي البهائم أوبارا وأصوافا % % مازلت أعرف أهل العجز في دعة % 224(@)(@@) % لا يكلفون وأهل الكيس كلافا % % أما ترى هذه الأنعام قد كفيت % % 225(@)(@@) % فما تساوم بالأخفاف خفافا % % يكفي أخا العجز ما يقضي القدير به % % 226(@)(@@) % من لا ترى منه عند الحكم إجنافا % % وكلب خصب زهاه الحظ قلت له % % 227(@)(@@) % لا تستوي والأسود السود غضافا % % أطغاك جهل بما أعطتك مرحمة % 228(@)(@@) % قدما أطالت على الحراص رفرافا % % دع من قوافيك ما يكفيك إن لها % % 229(@)(@@) % في مدح أحمد إعناقا وإيجافا % % فامدح به الشعر مدحا تستفيد به % % 230(@)(@@) % وفرا وتكبت حسادا وشنافا % % أضحى أبو جعفر الطائي منتجعا % 231(@)(@@) % ومستجارا لمن رجى ومن خافا % % قرم إياس وأوس من عشيرته % % PageV01P2959 232(@)(@@) % وحاتم كرم السلاف سلافا % % تقدموا وعلوا قدما وشم بهم % % 233(@)(@@) % روح الحياة فكان القوم أنافا % % كانوا مراعي للأرباع ممرعة % 234(@)(@@) % في كل حين وللمرتاع أكهافا % % سلاف صدق فلا زال المليك لهم % % 235(@)(@@) % بمثل أحمد في الخلاف خلافا % % أغر أبلج ما ينفك معتقلا % 236(@)(@@) % للحمد مبتذلا للمال متلافا % % مسهلا سبل الجدوى لطالبها % % 237(@)(@@) % لعرضه ولدين الله ظلافا % % أزمانه بنداه الغمر أشتية % 238(@)(@@) % وإن غدت بجناه الحلو أصيافا % % كأنه والعفاة الطائفين به % % 239(@)(@@) % بنية الله والحجاج طوافا % % أفردته برجائي وانفردت به % % 240(@)(@@) % وظل قوم على الأوثان عكافا % % يدعون من لا يجيب الهاتفين به % % 241(@)(@@) % وإن أملوه تدعاء وتهتافا % % ألفيت من خالص الياقوت جوهره % % PageV01P2960 242(@)(@@) % لما وجدت صنوف الناس أخزافا % % يضحي إذا خزي المداح مادحه % % 243(@)(@@) % كذائف المسك لا يخزيه ما ذافا % % كم حالبين ضروع العيش درته % % 244(@)(@@) % يمرون منهن 
ms753	 ضرات وأخلافا % % لولا أبو جعفر الطائي ما منحوا % % 245(@)(@@) % إلا قرونا من الدنيا وأظلافا % % سهل الخليقة لم يشرك سياسته % % 246(@)(@@) % عنف وإن كان بالملحاح معنافا % % إذا المصاعيب لم تركب تجللها % % 247(@)(@@) % قسرا فأعطت مع الإركاب إردافا % % ما نعرف الوعد والإيعاد من رجل % 248(@)(@@) % سواه إلا أمانيا وإرجافا % % منابذ لأعاديه وثروته % % 249(@)(@@) % فليس يألوهما ما اسطاع إتلافا % % ممن يرى المنع إسرافا وحق له % % 250(@)(@@) % أليس ما يتلف الأعراض إسرافا % % إذا لوى القوم يوما دين مادحهم % % 251(@)(@@) % أعطى عطاياه قبل المدح إسلافا % % إلى ذراه أنيخت بعد متعبة % PageV01P2961 252(@)(@@) % أنضاء ركب أملوا الأرض تطوافا % % ثم استثيرت فثارت وهي مثقلة % 253(@)(@@) % وقد أتته تباري الريح أحفافا % % أمسى أبا منزل والجود خادمه % % 254(@)(@@) % والأرض دارا له والناس أضيافا % % أولى المضيفين بالدفء الملوذ به % % 255(@)(@@) % مشتى وأجدرهم بالظل مصطافا % % يرعي العفاة رياض العرف مؤتنفا % 256(@)(@@) % بهم ويرعى رياض الحمد مئنافا % % أضحت سياسته رصفا ونائله % 257(@)(@@) % نثرا فأنطق نثارا ورصافا % % سما فحلق منه أجدل لحم % 258(@)(@@) % لما أسفت بغاث الطير إسفافا % % من العتاق يجلي قشعما دربا % 259(@)(@@) % حتى إذا ما استبان انقض غطرافا % % ما زال فاروق ما التفت شواكله % 260(@)(@@) % وللجيوش بشرواهن لفافا % % لم تستمع قط ذكراه ولم تره % % 261(@)(@@) % إلا تواضعت واسوضعت إشرافا % % ألقى إليه أمين الله حربته % % PageV01P2962 262(@)(@@) % فصادفت منه لقف الكف لقافا % % مظفرا هز عطفيها مظفرة % 263(@)(@@) % إذا تلقت صدورا صرن أكتافا % % منصورة في يد منصورة أبدا % 264(@)(@@) % من محرب لم يزل في الروع دلافا % % يغشي القناة قناة الظهر معتمدا % 265(@)(@@) % على القناتين قصاما وقصافا % % مصمما غير وقاف وآونة % 266(@)(@@) % تلقاه عند حدود الله وقافا % % ما انفك يقتل مراقا ويأسرهم % % 267(@)(@@) % أمضى من الحين أرماحا وأسيافا % % حتى غدا الطرف الأقصى به وسطا % 268(@)(@@) % من بعد ما كانت الأوساط أطرافا % % أجلى السباع وأخلى كل مسبعة % 269(@)(@@) % فغادر الأرض أحراما وأخيافا % % ثم استهل على الدنيا بنائله % % 270(@)(@@) % حتى غدت فلوات الأرض أريافا % % لا يوهن الله بطشا منه تعرفه % 271(@)(@@) % مزلزلا بأعادي الله خسافا % % ولا يغض ماء 
ms754	 كف منه ممطرة % PageV01P2963 272(@)(@@) % تساجل المزن تهطالا وتوكافا % % إذا رمى أحمد الطائي طائفة % 273(@)(@@) % أضحت مقاتلها للنبل أهدافا % % وإن سقى أرض أخرى صوب راحته % % 274(@)(@@) % هزت جنانا من النعماء ألفافا % % ظهير صدق إذا آخية ضعفت % % 275(@)(@@) % وزادها ظهراء السوء إضعافا % % عم التدابير إلطافا يرد به % % 276(@)(@@) % على الأواخي إثخانا وإكثافا % راخى خناق بني اللأواء كلهم % % 277(@)(@@) % وشد آساس ملك كن أجرافا % % أخو عطايا إذا ماشاء بدلها % % 278(@)(@@) % ضربا يخذف بالأوصال خذرافا % % وراء بيض أياديه إذا غمطت % 279(@)(@@) % بيض يطيح بها بيضا وأقحافا % إن سالم استنزل الأرزاق واسعة % % 280(@)(@@) % أو حارب اتخذ المقدار سيافا % % سائل صديقا عن الطائي هل ذهبت % 281(@)(@@) % دماء قتلاه أو جرحاه أطلافا % % ألم تر القتل أقوى طائعين له % % PageV01P2964 282(@)(@@) % عقوبة لم يقارف فيه أحيافا % % يدا خؤونا ورجلا منه أقسمتا % % 283(@)(@@) % تستعملان طوال الدهر إسكافا % % وإن يكن كان أردى مفلحا عرضا % 284(@)(@@) % فقد تصيب سهام الدهر خطرافا % % وقد يميل على من كان مال له % % 285(@)(@@) % ويعقب البؤس من غذاة سرهافا % % أردى كليبا لجساس وكان له % % 286(@)(@@) % ربا وأعدى على بسطام شرخافا % % واسأل به فارسا إذ سار تطلبه % % 287(@)(@@) % سيرا حثيثا يغول الأرض خشافا % % في فيلق بات في الظلماء كوكبها % % 288(@)(@@) % يهدي وأصبح للأبصار طرافا % % ففوز اللص حتى قاد من معه % % 289(@)(@@) % وكل مال إذا ضيعته سافا % % من بعد ما كلبوا جوعا فكلهم % % 290(@)(@@) % أضحى ظليما بشري الدو نقافا % % جاروا عن القصد فاستنهاهم حكم % 291(@)(@@) % عدل وما جار في حكم ولا حافا % % وانحاز عن بدد منهم وما ادكرت % PageV01P2965 292(@)(@@) % خيل الأمير أواريا وأعلافا % % لكي تطارد كي يغتر مارقة % 293(@)(@@) % أخرى إذا ما دهاها كر عطافا % % وللهنات لقاح ليس يعرفه % % 294(@)(@@) % عير وإن كان للأبوال كرافا % % تحت الأمور أمور لو تبينها % % 295(@)(@@) % عير الفلاةلأضحى العير خضافا % % ما كان دهر قصير جدع معطسه % % 296(@)(@@) % لما أطف له موساه إطفافا % % لكن أراد به أمرا فأدركه % % 297(@)(@@) % ولم يردد على مافات إلهافا % % فلينتظر فارس أوراد عائدة % 298(@)(@@) % لا يستطيع لها الزواد كفكافا % % وأين 
ms755	 يهرب من خيل تخال بها % % 299(@)(@@) % عقبان مبردة يطلبن إلجافا % % دوخن شيبان أما في رؤوسهم % 300(@)(@@) % تدوي الطبيب إذا أغشاه مجرافا % % وقلن ذوقوا جناكم إن جانيكم % 301(@)(@@) % ما زال للحنظل الخطبان نقافا % % كم جاهل كان بالطائي جربه % % PageV01P2966 302(@)(@@) % صلا إذا طلب الأعداء زحافا % % يحرم الغسل إيلاء ويطلقه % % 303(@)(@@) % برا فيوخفه بالثأر إيخافا % % ووقعة منه في الأعراب قد جعلت % 304(@)(@@) % أوطانهم إسوة الأحقاف أحقافا % % تحالفوا مذ تحداهم فخلتهم % % 305(@)(@@) % على الهزائم لا الإقدام أحلافا % % ظلوا قتيلا ومصفودا وذا هرب % 306(@)(@@) % تقضي بإدراكه الطير التي اعتافا % % أسير قتل وإن أضحى طليق يد % 307(@)(@@) % قد أزهقت نفسه الآجال إزهافا % % ومن سرت نقم الطائي تطلبه % % 308(@)(@@) % ألفى الذي وعدته الفوت مخلافا % % يا هاربا منه إن الليل غاشية % 309(@)(@@) % لا بد منها وإن أوشكت إحصافا % % كيف النجاء لناج من أخي طلب % 310(@)(@@) % مثل الظلام إذا ما عم أغدافا % % كأنما كل نفس حين يطلبها % % 311(@)(@@) % قد أعلقت سببا منه وخطافا % % فاطلب رضاه وأيقن أن سخطته % % PageV01P2967 312(@)(@@) % لا حرز منها إذا طوفانها طافا % % تلق ابن حرين لا تلقاه مجترما % 313(@)(@@) % فظا على مستميح العفو حلافا % % بل سيدا قرنت بالحلم حفظته % % 314(@)(@@) % فلم تفز قط إلا كان ميقافا % % يهم بالطول همام به عجلا % 315(@)(@@) % وإن أراد عقابا كف كفافا % % يسوس نفسا على الأغياظ صابرة % 316(@)(@@) % ما زال يؤلفها الكروه إيلافا % % مغفل حين يستعفى وتحسبه % % 317(@)(@@) % عند انتقاد وجوه الناس صرافا % % تلقاه للعيب ستارا وإن دمست % 318(@)(@@) % ظلماء لاقيته للغيب كشافا % إذا ارتأى تبعت آثاره سددا % 319(@)(@@) % لا كالذي يتبع الآثار مقتافا % % ما إن يزال له رأي يصيب به % % 320(@)(@@) % لو أنه حيوان كان عرافا % % تخاله باتقاء الذنب متقيا % 321(@)(@@) % في يوم هيجاء مرداة وقذافا % % يخشى الملام ويغشى الحرب مرتديا % PageV01P2968 322(@)(@@) % فيها رداء من الكتاب هفهافا % % لم يلفه الغمز خوارا وتعطفه % % 323(@)(@@) % بالرفق منك فتلقى منه عطافا % % يلين للريح إن هزته لينة % 324(@)(@@) % ولا يلين إذا هزته معصافا % % لا يترك الحق مغبونا لسائمه % % 325(@)(@@) % خسفا ولا يتعدى الحق حيافا 
ms756	 % % كم قد أعد لقوم حسن مقدرة % 326(@)(@@) % وكم يعدون أكفافا وأجدافا % % قراهم الصفح إذ حلوا بعقوته % % 327(@)(@@) % وأتبع الصفح إكراما وإلطافا % لم يعد أن أرعف الأقلام يرفدهم % % 328(@)(@@) % ولو عتوا رعف الخرصان إرعافا % % جاءوا يخافون نارا لا خمود لها % % 329(@)(@@) % فأزلفت لهم الجنات إزلافا % % لكن تطارد كي يغتر مارقة % 330(@)(@@) % أخرى إذا ما دهاها كر عطافا % % ورائد قال ألفينا خلائقه % % 331(@)(@@) % كالشهد طعما ومثل المسك مستافا % % خلائق علمتنا كيف نمدحه % % PageV01P2969 332(@)(@@) % ورققتنا وكنا قبل أجلافا % % كم قد بدأنا وعاودنا فأوسعنا % % 333(@)(@@) % بذلا ولم نستطع للبحر إنزافا % % بحر من العرف لا تلقى الظماء به % % 334(@)(@@) % محلئين ولا الوراد عيافا % % تمت معانيه منه في امرىء نصف % 335(@)(@@) % زوال أطال على الأحوال توقافا % % قد سن شفرتيه البأس بغيته % % 336(@)(@@) % وشاف من صحفتيه الجود ما شافا % % كذا الأهلة تستوفي محاسنها % % 337(@)(@@) % إذا نضت ما شهور الحول أنصافا % % ممن يرى كل ما يفنى بمنزلة % 338(@)(@@) % سيان ما التذ منها والذي عافا % % لا بالمروع إذا أهوالها عظمت % 339(@)(@@) % ولا المروق إذا زيافها زافا % % تبلو به محنة الدنيا وفتنتها % % 340(@)(@@) % طودا كهمك إرساء وإشرافا % % لا يستخف لدى ريح تهب له % % 341(@)(@@) % ولا عليه ولا تلقاه رجافا % % يجن قلبا وقورا في جوانحه % % PageV01P2970 342(@)(@@) % مستنفرا عند ذكر الله وجافا % % لا عيب فيه سوى عتق يرد به % % 343(@)(@@) % عتق الجواد إذا جاراه إقرافان طاف الخيال وعن ذكراك ما طافا % % فكان أكرم طيف طارق ضافا % % 344(@)(@@) % طيف عراني فحياني وأتحفني % % بالنرجس الغض والتفاح إتحافا % % 345(@)(@@) % عينان جاورتا خدين ما خلقا % % إلا شقاء يراه الغر إترافا % % 346(@)(@@) % وكم ألم فأهدت لي محاسنه % % من الفواكه والريحان أصنافا % % 347(@)(@@) % رمان عدن وأعنابا مهدلة % وأقحوانا يسقى الراح رفافا % % 348(@)(@@) % ويانعا من جنى العناب تتبعه % % قلب المودع تذكارا وتأسافا % % 349(@)(@@) % أسرى بأنواع ريحان وفاكهة % % يأبين قطفا وإن خيلن إقطافا % % 350(@)(@@) % لله ضيفك من ضيف قرى نزلا % من الغرور عميد القلب مكلافا % % 351(@)(@@) % قرى هو البرح إعقابا وإن وجدت % منه النفوس مذاق العيش إسلافا % % PageV01P2971 352(@)(@@) % أقر عيني 
ms757	 في ليلى وصبحني % % وجدا أفاضهما بالماء شفافا % % 353(@)(@@) % لا خير في قرة للعين معقبة % دمعا يخدد في الخدين ذرافا % % 354(@)(@@) % أعجب بوجد مزور قاد زائره % بل لم تزل ذكر يجلبن أطيافا % % 355(@)(@@) % هب الضمير ونام الطرف فاجتلبت % ذكراك والنوم زورا طالما جافى % % 356(@)(@@) % صافيته فحباك النوم زورته % % وكان ذلك حق النبه لو صافى % % 357(@)(@@) % وافاك والليل قد ألقى مراسيه % % خيال من ليس بالوافي ولو وافى % % 358(@)(@@) % في شيعة كالنجوم الزهر معتمة % أحدقن بالبدر أشباها وألافا % % 359(@)(@@) % بيض كسين حليا لا كفاء لها % % حسنا فأكسفنها بالحسن إكسافا % % 360(@)(@@) % شبهن بالدر إذ ألبسن فاخره % بل كن درا وكان الدر أصدافا % % 361(@)(@@) % يا حسن ليل وإصباح جمعنهما % % والليل ملق على الآفاق أكنافا % % PageV01P2972 362(@)(@@) % غر تجللن أسدافا مرجلة % على وجوه وضاء جبن أسدافا % % 363(@)(@@) % ومسن في حلل الأفوف عاطرة % فخلتهن لبسن الروض أفوافا % % 364(@)(@@) % من كل مجدولة إن أقبلت عطفت % أعطافها من قلوب الناس أعطافا % % 365(@)(@@) % وإن تولت فريا الخلق تتبعها % % أرادفها من قلوب الناس أردافا % % 366(@)(@@) % لو أن لي عند من أحببته مقة % لصدق الحلم إلثاما وإرشافا % % 367(@)(@@) % لكن هيفاء تلقى الله صادية % إلى الدماء التي حرمن مهيافا % % 368(@)(@@) % تبا لحكم الغواني والمقربه % % فما رأى فيه راء قط إنصافا % % 369(@)(@@) % أسعفن بالملك عفوا فائتلين معا % أن لا يرى طالب منهم إسعافا % % 370(@)(@@) % يا سائلي بالغواني من صبابته % % سائل بهن فقد صادفت وصافا % % 371(@)(@@) % هن اللواتي إذلاقيتهن ضحى % لاقيت صدا وإشراقا وإخطافا % % PageV01P2973 372(@)(@@) % مثل السيوف إذا لاقيت مصلتها % % لاقيت حدا وإمهاء وإرهافا % % 373(@)(@@) % أرضيننا حسن قد زانه بشر % صاف وأسخطتنا مطلا وإخلافا % % 374(@)(@@) % بخلن عنا بما يسألن من وتح % % نزر وأجحفن بالألباب إجحافا % % 375(@)(@@) % وإنني للذي غادرنه عطلا % % بغير لب وإن أحسنت أوصافا % % 376(@)(@@) % أسقمن قلبي بألوان مصححة % وأعين أدنفت بالغنج إدنافا % % 377(@)(@@) % يا مكذبا لي في دعواي شككه % % أن فتر الدمع وبلا منه وكافا % % 378(@)(@@) % بواطن الحب أدهى من ظواهره % % كما علمت وشر الداء ما اجتافا % % 379(@)(@@) % ما للأحبة قد ضمن صبوتنا % % بعد 
ms758	 الإنابة سكيتا وهتافا % % 380(@)(@@) % طورا حماما وطورا منزلا خرسا % ما لم ترجع به الأرواح زفزافا % % 381(@)(@@) % أو طارقا في حريم النوم يطرقنا % % أو بارقا لعزاء القلب خطافا % % PageV01P2974 382(@)(@@) % أو حنة من حنين النيب ما برحت % تهيج للصب أبراحا وأشعافا % % 383(@)(@@) % كل يجد لنا شجوا يذكرنا % % إلفا فيمنحنا الأحزان ألافا % % 384(@)(@@) % لا تعجبن لمرزوق أخي هوج % حظا تخطى أصيل الرأي طرافا % % 385(@)(@@) % فخالق الناس أعراء بلا وبر % كاسي البهائم أوبارا وأصوافا % % 386(@)(@@) % مازلت أعرف أهل العجز في دعة % لا يكلفون وأهل الكيس كلافا % % 387(@)(@@) % أما ترى هذه الأنعام قد كفيت % % فما تساوم بالأخفاف خفافا % % 388(@)(@@) % يكفي أخا العجز ما يقضي القدير به % % من لا ترى منه عند الحكم إجنافا % % 389(@)(@@) % وكلب خصب زهاه الحظ قلت له % % لا تستوي والأسود السود غضافا % % 390(@)(@@) % أطغاك جهل بما أعطتك مرحمة % قدما أطالت على الحراص رفرافا % % 391(@)(@@) % دع من قوافيك ما يكفيك إن لها % % في مدح أحمد إعناقا وإيجافا % % PageV01P2975 392(@)(@@) % فامدح به الشعر مدحا تستفيد به % % وفرا وتكبت حسادا وشنافا % % 393(@)(@@) % أضحى أبو جعفر الطائي منتجعا % ومستجارا لمن رجى ومن خافا % % 394(@)(@@) % قرم إياس وأوس من عشيرته % % وحاتم كرم السلاف سلافا % % 395(@)(@@) % تقدموا وعلوا قدما وشم بهم % % روح الحياة فكان القوم أنافا % % 396(@)(@@) % كانوا مراعي للأرباع ممرعة % في كل حين وللمرتاع أكهافا % % 397(@)(@@) % سلاف صدق فلا زال المليك لهم % % بمثل أحمد في الخلاف خلافا % % 398(@)(@@) % أغر أبلج ما ينفك معتقلا % للحمد مبتذلا للمال متلافا % % 399(@)(@@) % مسهلا سبل الجدوى لطالبها % % لعرضه ولدين الله ظلافا % % 400(@)(@@) % أزمانه بنداه الغمر أشتية % وإن غدت بجناه الحلو أصيافا % % 401(@)(@@) % كأنه والعفاة الطائفين به % % بنية الله والحجاج طوافا % % PageV01P2976 402(@)(@@) % أفردته برجائي وانفردت به % % وظل قوم على الأوثان عكافا % % 403(@)(@@) % يدعون من لا يجيب الهاتفين به % % وإن أملوه تدعاء وتهتافا % % 404(@)(@@) % ألفيت من خالص الياقوت جوهره % % لما وجدت صنوف الناس أخزافا % % 405(@)(@@) % يضحي إذا خزي المداح مادحه % % كذائف المسك لا يخزيه ما ذافا % % 406(@)(@@) % كم حالبين ضروع العيش درته % % يمرون منهن ضرات 
ms759	 وأخلافا % % 407(@)(@@) % لولا أبو جعفر الطائي ما منحوا % % إلا قرونا من الدنيا وأظلافا % % 408(@)(@@) % سهل الخليقة لم يشرك سياسته % % عنف وإن كان بالملحاح معنافا % % 409(@)(@@) % إذا المصاعيب لم تركب تجللها % % قسرا فأعطت مع الإركاب إردافا % % 410(@)(@@) % ما نعرف الوعد والإيعاد من رجل % سواه إلا أمانيا وإرجافا % % 411(@)(@@) % منابذ لأعاديه وثروته % % فليس يألوهما ما اسطاع إتلافا % % PageV01P2977 412(@)(@@) % ممن يرى المنع إسرافا وحق له % % أليس ما يتلف الأعراض إسرافا % % 413(@)(@@) % إذا لوى القوم يوما دين مادحهم % % أعطى عطاياه قبل المدح إسلافا % % 414(@)(@@) % إلى ذراه أنيخت بعد متعبة % أنضاء ركب أملوا الأرض تطوافا % % 415(@)(@@) % ثم استثيرت فثارت وهي مثقلة % وقد أتته تباري الريح أحفافا % % 416(@)(@@) % أمسى أبا منزل والجود خادمه % % والأرض دارا له والناس أضيافا % % 417(@)(@@) % أولى المضيفين بالدفء الملوذ به % % مشتى وأجدرهم بالظل مصطافا % % 418(@)(@@) % يرعي العفاة رياض العرف مؤتنفا % بهم ويرعى رياض الحمد مئنافا % % 419(@)(@@) % أضحت سياسته رصفا ونائله % نثرا فأنطق نثارا ورصافا % % 420(@)(@@) % سما فحلق منه أجدل لحم % لما أسفت بغاث الطير إسفافا % % 421(@)(@@) % من العتاق يجلي قشعما دربا % حتى إذا ما استبان انقض غطرافا % % PageV01P2978 422(@)(@@) % ما زال فاروق ما التفت شواكله % وللجيوش بشرواهن لفافا % % 423(@)(@@) % لم تستمع قط ذكراه ولم تره % % إلا تواضعت واسوضعت إشرافا % % 424(@)(@@) % ألقى إليه أمين الله حربته % % فصادفت منه لقف الكف لقافا % % 425(@)(@@) % مظفرا هز عطفيها مظفرة % إذا تلقت صدورا صرن أكتافا % % 426(@)(@@) % منصورة في يد منصورة أبدا % من محرب لم يزل في الروع دلافا % % 427(@)(@@) % يغشي القناة قناة الظهر معتمدا % على القناتين قصاما وقصافا % % 428(@)(@@) % مصمما غير وقاف وآونة % تلقاه عند حدود الله وقافا % % 429(@)(@@) % ما انفك يقتل مراقا ويأسرهم % % أمضى من الحين أرماحا وأسيافا % % 430(@)(@@) % حتى غدا الطرف الأقصى به وسطا % من بعد ما كانت الأوساط أطرافا % % 431(@)(@@) % أجلى السباع وأخلى كل مسبعة % فغادر الأرض أحراما وأخيافا % % PageV01P2979 432(@)(@@) % ثم استهل على الدنيا بنائله % % حتى غدت فلوات الأرض أريافا % % 433(@)(@@) % لا يوهن الله بطشا منه تعرفه % مزلزلا بأعادي الله خسافا % % 434(@)(@@) % ولا يغض ماء 
ms760	 كف منه ممطرة % تساجل المزن تهطالا وتوكافا % % 435(@)(@@) % إذا رمى أحمد الطائي طائفة % أضحت مقاتلها للنبل أهدافا % % 436(@)(@@) % وإن سقى أرض أخرى صوب راحته % % هزت جنانا من النعماء ألفافا % % 437(@)(@@) % ظهير صدق إذا آخية ضعفت % % وزادها ظهراء السوء إضعافا % % 438(@)(@@) % عم التدابير إلطافا يرد به % % على الأواخي إثخانا وإكثافا % 439(@)(@@) % راخى خناق بني اللأواء كلهم % % وشد آساس ملك كن أجرافا % % 440(@)(@@) % أخو عطايا إذا ماشاء بدلها % % ضربا يخذف بالأوصال خذرافا % % 441(@)(@@) % وراء بيض أياديه إذا غمطت % بيض يطيح بها بيضا وأقحافا % PageV01P2980 442(@)(@@) % إن سالم استنزل الأرزاق واسعة % % أو حارب اتخذ المقدار سيافا % % 443(@)(@@) % سائل صديقا عن الطائي هل ذهبت % دماء قتلاه أو جرحاه أطلافا % % 444(@)(@@) % ألم تر القتل أقوى طائعين له % % عقوبة لم يقارف فيه أحيافا % % 445(@)(@@) % يدا خؤونا ورجلا منه أقسمتا % % تستعملان طوال الدهر إسكافا % % 446(@)(@@) % وإن يكن كان أردى مفلحا عرضا % فقد تصيب سهام الدهر خطرافا % % 447(@)(@@) % وقد يميل على من كان مال له % % ويعقب البؤس من غذاة سرهافا % % 448(@)(@@) % أردى كليبا لجساس وكان له % % ربا وأعدى على بسطام شرخافا % % 449(@)(@@) % واسأل به فارسا إذ سار تطلبه % % سيرا حثيثا يغول الأرض خشافا % % 450(@)(@@) % في فيلق بات في الظلماء كوكبها % % يهدي وأصبح للأبصار طرافا % % 451(@)(@@) % ففوز اللص حتى قاد من معه % % وكل مال إذا ضيعته سافا % % PageV01P2981 452(@)(@@) % من بعد ما كلبوا جوعا فكلهم % % أضحى ظليما بشري الدو نقافا % % 453(@)(@@) % جاروا عن القصد فاستنهاهم حكم % عدل وما جار في حكم ولا حافا % % 454(@)(@@) % وانحاز عن بدد منهم وما ادكرت % خيل الأمير أواريا وأعلافا % % 455(@)(@@) % لكي تطارد كي يغتر مارقة % أخرى إذا ما دهاها كر عطافا % % 456(@)(@@) % وللهنات لقاح ليس يعرفه % % عير وإن كان للأبوال كرافا % % 457(@)(@@) % تحت الأمور أمور لو تبينها % % عير الفلاةلأضحى العير خضافا % % 458(@)(@@) % ما كان دهر قصير جدع معطسه % % لما أطف له موساه إطفافا % % 459(@)(@@) % لكن أراد به أمرا فأدركه % % ولم يردد على مافات إلهافا % % 460(@)(@@) % فلينتظر فارس أوراد عائدة % لا يستطيع لها الزواد كفكافا % % 461(@)(@@) % وأين 