ms41	 الدين ويا قلب الهدى % % كابدا ما عشما داء عضالا % % 33(@)(@@) % تلك أبناء علي غودرت % % بدماها القوم تستشفي ضلالا % % 34(@)(@@) % نسيت أبناء قهر وترها % % أم على ماذا أحالته اتكالا % % 35(@)(@@) % فمن الحامل عني آية % لهم لو هزت الطود لزالا % % 36(@)(@@) % ايها الراغب في تغليسة % % بامون قط لم تشك الكلالا % % 37(@)(@@) % إقتعدها وأقم من صدرها % % حيث وفد البيت يلقون الرحالا % % 38(@)(@@) % واحتقبها من لساني نفثة % % ضرما حولها الغيظ مقالا % % 39(@)(@@) % وإذا أندية الحي بدت % % تشعر الهيبة حشدا واحتفالا % % 40(@)(@@) % قف على البطحاء واهتف ببني % % شيبة الحمد وقل قوموا عجالا % % PageV01P131 41(@)(@@) % كم رضاع الضيم لا شب لكم % % ناشىء أو تجعلوا الموت فصالا % % 42(@)(@@) % كم وقوف الخيل لا كم نسيت % % علكها اللجم ومجراها رعالا % % 43(@)(@@) % كم فرار البيض في الغمد أما % % آن أن تهز للضرب انسلالا % % 44(@)(@@) % كم تمنون العوالي بالطلى % % أقتل الأدواء مازاد مطالا % % 45(@)(@@) % فهلموا بالمذاكي شزبا % % والضبا بيضا وبالسمر طوالا % % 46(@)(@@) % حل ما لا تبرك الإبل على % % مثله يوما ولو زيدت عقالا % % 47(@)(@@) % طحنت أباء حرب هامكم % % برحى حرب لها كانوا الثفالا % % 48(@)(@@) % وطأوا آنافكم في كربلا % % وطأة طكت على السهل الجبالا % % 49(@)(@@) % قوموها أسلا خطية % % كقدود الغيد لينا واعتدالا % % 50(@)(@@) % واخطبوا طعنا بها عن ألسن % % طالما أنشأت الموت ارتجالا % % PageV01P132 51(@)(@@) % وانتضوها قضبا هندية % بسوى الهامات لا ترضى الصقالا % % 52(@)(@@) % ومكان الحد منها ركبوا % % عزمكم ان خفتموا منها الكلالا % % 53(@)(@@) % واعقدوه عارضا من عثير % % بالدم المهراق منحل العزالى % % 54(@)(@@) % وابعثوها مثل ذؤبان الغضا % % لا ترى إلا على الهام مجالا % % 55(@)(@@) % وإلى الطف بها حرى فلا % % برد أو تنسف هاتيك التلالا % % 56(@)(@@) % بطراد تلدم الطف به % % للألى منكم قضوا فيه قتالا % % 57(@)(@@) % وطعان يمطر السمر دما % فوقها حيث دم لاشراف سالا % % 58(@)(@@) % كم لكم من صبية ما أبدلت % % ثم من حاضنة إلا رمالا % % 59(@)(@@) % سل بحجر الحرب ماذا رضعت % % فثدي الحرب قد كن نصالا % % 60(@)(@@) % رضعت من دمها الموت فيا % % لرضاع عاد بالرغم فصالا % % PageV01P133 61(@)(@@) % ونواع برزت من خدرها % % تلزم الأيدي أكبادا 
ms42	 وجالا % % 62(@)(@@) % كم على النعي لها من حنة % كحنين النيب فارقن الفصالا % % 63(@)(@@) % كبنات الدوح تبكي شجوها % % وغوادي الدمع تنهل انهلالا % % PageV01P134 البحر : بسيط تام 1(@)(@@) % إن لم أقف حيث جيش الموت يزدحم % فلا مشت بي في العلا قدم % % 2(@)(@@) % لا بد أن أتداوى بالقنا فلقد % % صبرت حتى فؤادي كله ألم % % 3(@)(@@) % عندي من العزم سر لا أبوح به % % حتى تبوح به الهندية الخذم % % 4(@)(@@) % لا أرضعت لي العلى ابنا صفو درتها % % إن هكذا ظل رمحي وهو منفطم % % 5(@)(@@) % إلية بضبا قومي التي حمدت % % قدما مواقعها الهيجاء لا القمم % % 6(@)(@@) % لأحلبن لدي الحرب وهي قنا % لبانها من صدور الشوس وهو دم % % 7(@)(@@) % مالي أسلم قوما عندهم ترثي % % لاسالمتني يد الأيام إن سلموا % % 8(@)(@@) % من حامل لولي الأمر مألكة % تضوى على نفثات كلها ضرم % % 9(@)(@@) % يابن لألى يقعدون الموت أن نهضت % % بهم لدى الروع في وجه الضبا الهمم % % 10(@)(@@) % الخيل عندك ملتها مرابطها % % والبيض منها عرى أغمادها السأم % % PageV01P135 11(@)(@@) % هذي الخدور ألاعداء هاتكة % وذي الجباه ألا مشحوذة تسم % % 12(@)(@@) % لاتطهر الأرض من رجس العدى أبدا % ما لم يسل فوقها سيل الدم العرم % % 13(@)(@@) % بحيث موضع كل منهم لك في % % دماه تكن فيه تجلى هذه الغمم % % 14(@)(@@) % قد آن أن يمطر الدنيا وساكنها % % دما أغر عليه النقع مرتكم % % 15(@)(@@) % حران تدمغ هام القوم صاعقة % % من كفه وهي السيف الذي علموا % % 16(@)(@@) % نهضا فمن بظباكم هامه فلقت % % ضربا على الدين فيه اليوم يحتكم % % 17(@)(@@) % وتلك أنفالكم في الغاصبين لكم % % مقسومة وبعين الله تقتسم % % 18(@)(@@) % جرائم آذتهم أن تعاجلهم % % بالأنتقام فهلا أنت منتقم % % 19(@)(@@) % وإن أعجب شيء أن أبثكها % % كأن قلبك خال وهو محتدم % % 20(@)(@@) % ما خلت تعقد حتى تستثار لهم % % وأنت أنت وهم فيما جنوه هم % % PageV01P136 21(@)(@@) % لم تبق اسيافهم منكم على ابن تقى % % فكيف تبقى عليهم لا أبا لهم % % 22(@)(@@) % فلا وصفحك إن القوم ما صفحوا % % ولا وحلمك إن القوم ما حلموا % % 23(@)(@@) % فحمل أمك قدما أسقطوا حنقا % وطفل جدك في سهم الردى 
ms43	 فطموا % % 24(@)(@@) % لا صبر أو تضع الهيجاء ما حملت % % بطلقة معها ماء المخاض دم % 25(@)(@@) % هذا المحرم قد وافتك صارخة % مما استحلوا به أيامه الحرم % % 26(@)(@@) % يملأن سمعك من أصوات ناعية % في مسمع الدهر من إعوالها صمم % % 27(@)(@@) % تنعى إليك دماء غاب ناصرها % % حتى أريقت ولم يرفع لكم علم % % 28(@)(@@) % مسفوحة لم تجب عند استغاثها % % إلا بأدمع ثكلى شفها الألم % % 29(@)(@@) % حنت وبين يديها فتية شربت % % من نحرها نصب عينيها ، الضبا الخذم % % 30(@)(@@) % موسدين على الرمضاء تنظرهم % % حرى القلوب على ورد الردى ازدحموا % % PageV01P137 31(@)(@@) % سقيا لثاوين لم تبلل مضاجعهم % % إلا الدماء وإلا الأدمع السجم % % 32(@)(@@) % أفناهم صبرهم تحت الضبا كرما % حتى قضوا ورداهم ملؤه كرم % % 33(@)(@@) % وخائضين غمار الموت طافحة % % أمواجها البيض بالهامات تلتطم % % 34(@)(@@) % مشوا إلى الحرب مشي الضاريات لها % % فصارعوا الموت فيها والقنا أجم % % 35(@)(@@) % ولا غضاضة يوم الطف أن قتلوا % % صبرا بهيجاء لم تثبت لها قدم % % 36(@)(@@) % فالحرب تعلم إن ماتوا بها فلقد % % ماتت بها منهم الأسياف لا الهمم % % 37(@)(@@) % أبكيهم لعوادي الخيل إن ركبت % % رؤسها لم تكفكف عزمها اللجم % % 38(@)(@@) % وللسيوف إذا الموت الزؤام غدا % % في حدها هو والأرواح يختصم % % 39(@)(@@) % وحائرات أطار القوم أعينها % % رعبا غداة عليها خدرها هجموا % % 40(@)(@@) % كانت بحيث عليها قومها ضربت % % سرادقا أرضه من عزهم حرم % % PageV01P138 41(@)(@@) % يكاد من هيبة أن لا يطوف به % % حتى الملائك لولا أنهم خدم % % 42(@)(@@) % فغودرت بين أيدي القوم حاسرة % تسبى وليس لها من فيه تعتصم % % 43(@)(@@) % نعم لوت جيدها بالعتب هاتفة % بقومها وحشاها ملؤه ضرم % % 44(@)(@@) % عجت بهم مذ على أبرادها اختلفت % % أيدي العدو ولكن من لها بهم % % 45(@)(@@) % نادت ويا بعدهم عنها معاتبة % لهم وياليتهم من عتبها أمم % % 46(@)(@@) % قومي الألى عقدت قدما مآزرهم % % على الحمية ماضيموا ولا اهتضموا % % 47(@)(@@) % عهدي بهم قصر الأعمار شأنهم % % لا يهرمون وللهيابة الهرم % % 48(@)(@@) % مابالهم لاعفت منهم رسومهم % % قروا وقد حملتنا الأنيق الرسم % % 49(@)(@@) % ياغاديا بمطايا العزم حملها % % هما تضيق به الأضلاع والحزم % % 50(@)(@@) % عرج على الحي من 
ms44	 عمرو العلى وأرح % % منهم بحيث اطمأن البأس والكرم % % PageV01P139 51(@)(@@) % وحي منهم حماة ليس باتنهم % % من لا يرف عليه في الوغى العلم % % 52(@)(@@) % المشبعين قرى طير السما ولهم % % بمنعة الجار فيهم يشهد الحرم % % 53(@)(@@) % والهاشمين وكل الناس قد علموا % % بأن للضيف أو للسيف ماهشموا % % 54(@)(@@) % كماة حرب ترى في كل بادية % % قتلى بأسيافهم لم تحوها الرجم % % 55(@)(@@) % كأن كل فلا دار لهم وبها % % عيالها الوحش أو أضيافها الرخم % % 56(@)(@@) % قف منهم موقفا تغلي القلوب به % % من فورة العتب واسأل ما الذي بهم % % 57(@)(@@) % جفت عزائم فهر أم ترى بردت % % منها الحمية أم قد ماتت الشيم % % 58(@)(@@) % أم لم تجد لذع عتبي في حشاشتها % % فقد تساقط جمرا من فمي الكلم % % 59(@)(@@) % أين الشهامة أم أين الحفاظ أما % % يأبى لها شرف الأحساب والكرم % % 60(@)(@@) % تسبى حرائرها بالطف حاسرة % % ولم تكن بغبار الموت تلتثم % PageV01P140 61(@)(@@) % لمن أعدت عتاق الخيل إن قعدت % % عن موقف هتكت نها به الحرم % % 62(@)(@@) % فما اعتذارك يافهر ولم تثبي % % بالبيض تثلم أو بالسمر تنحطم % % 63(@)(@@) % أجل نساؤك قد هزتك عاتبة % وأنت من رقدة تحت الثرى رمم % % 64(@)(@@) % فلتلفت الجيد عنك اليوم خائبة % فما غناؤك حالت دونك الرجم % % PageV01P141 البحر : وافر تام 1(@)(@@) % حلولك في محل الضيم داما % % وحد السيف يأبى أن يضاما % % 2(@)(@@) % وكيف تمس جانبك الليالي % % بذل أو تحل به اهتضاما % % 3(@)(@@) % ولم تنهض بأعباء ثقال % % بهن سواك لم يطق القياما % % 4(@)(@@) % ولم تضرم بحد السيف حربا % إلى كبد السما ترمي الضراما % % 5(@)(@@) % فيملأ طرفك الآفاق نقعا % ويملأ سيفك الأقطار هاما % % 6(@)(@@) % أتبذل للخمول جناب حر % % يحذر أن يعاب وأن يذاما % % 7(@)(@@) % وآلك بالضبا شرعوا المعالي % % وجيش الموت يزدحم ازدحاما % % 8(@)(@@) % غداة طريدة المختار جاءت % % تقود لحربهم جيشا لهاما % % 9(@)(@@) % ورامت أن نسوم الضيم ندبا % أبى من عزه عن أن يضاما % % 10(@)(@@) % فأفرغ جاشه درعا عليه % % ونقع الموت صيره لثاما % % PageV01P142 11(@)(@@) % يؤازه أخو صدق شمام % % يساند من أباطحه شماما % % 12(@)(@@) % وصل في صريمته مواس % % لصل ينفث الموت الزؤاما % % 13(@)(@@) % هو 
ms45	 العباس ليث بني نزار % ومن قد كان للاجي عصاما % % 14(@)(@@) % هزبر أغلب تخذ اشتباك ال % % رماح بحومة الهيجا أجاما % % 15(@)(@@) % فمدت فوقه العقبان ظلا % % ليقريها جسومهم طعاما % % 16(@)(@@) % وواجهت الضبا منه محيا % منيرا نوره يجلو الضلاما % % 17(@)(@@) % أخلاء تصافحه يراها % % إذا اختلفت بجبهته لطاما % % 18(@)(@@) % أبي عند مس الضيم يمضي % % بعزم يقطع العضب الحساما % % PageV01P143 البحر : متقارب تام 1(@)(@@) % تركت حشاك وسلوانها % % فخل حشاي وأحزانها % % 2(@)(@@) % أغض الشبيبة عني إليك % % فقض بزهوك ريعانها % % 3(@)(@@) % ودعني اصارع همي وبت % % ضريع مدامك نشوانها % % 4(@)(@@) % قد استوطن الهم قلبي فعفت % لك الغانيات وأوطانها % % 5(@)(@@) % عدوت ملاعب ذات الأراك % % فلست ألاعب غزلانها % % 6(@)(@@) % وعفت غدائر بيض الخدود % % فما أنشق الدهر ريحانها % % 7(@)(@@) % افق لست أول من لامني % % على وصل نفسي تحنانها % % 8(@)(@@) % فكم لي قبلك لوامة % % تشاغلت مطرحا شانها % % 9(@)(@@) % تريني بالعذل غشفاقها % % وفيه تلون ألوانها % % 10(@)(@@) % تناشدني الصبر لكن تريد % أن أعرف اللهو عرفانها % % PageV01P144 11(@)(@@) % وما هي مني حتى تخاف % % علي الهموم وأشجانها % % 12(@)(@@) % وما في ضلوعي لها مهجة % عليها تحاذر نيرانها % % 13(@)(@@) % ولا بين جفني عين لها % % من الكحل أغسل اجفانها % % 14(@)(@@) % ولو ضمنت أضلعي قلبها % % سلوت النوائب سلوانها % % 15(@)(@@) % ولو وجدت بعض ما قد وجدت % لبلت من الدمع أردانها % % 16(@)(@@) % خلا أنها مذ رأتني غدوت % لهيف الحشاشة حرانها % % 17(@)(@@) % فقالت أجدك من ذي حشا % جوى الحزن لازم ايطانها % % 18(@)(@@) % لمن حرق الوجد تذكي وراء % % حنايا ضلوعك نيرانها % % 19(@)(@@) % وتشجيك كل هتوف العشي % % تردد في الدوح ألحانها % % 20(@)(@@) % تسل وبالله لما اغتنمت % % من جدة اللهو إبانها % % PageV01P145 21(@)(@@) % فقلت سلوت إذا مهجتي % % إذا أنا حاولت سلوانها % % 22(@)(@@) % كفاني ضنا أن ترى في الحسين % % شفت آل مروان أضغانها % % 23(@)(@@) % فأغضبت الله في قتله % % وأرضت بذلك شيطانها % % 24(@)(@@) % عشية أنهضها بغيها % % فجاءته تركب طغيانها % % 25(@)(@@) % بجمع من الأرض سد الفروج % % وغطى النجود وغيطانها % % 26(@)(@@) % وطا الوحش إذ لم يجد مهربا % ولازمت الطير أوكانها % % 27(@)(@@) % وحفت بمن حيث يلقى الجموع % % يثني بماضيه وحدانها % % 28(@)(@@) % وسامته يركب إحدى 
ms46	 اثنتين % % وقد صرت الحرب أسنانها % % 29(@)(@@) % فأما يرى مذعنا أو تموت % % نفس أبي العز إذعانها % % 30(@)(@@) % فقال لها اعتصمي بالأباء % % فنفس الأبي وما زانها % % PageV01P146 31(@)(@@) % إذا لم تجد غير لبس الهوان % % فبالموت تنزع جثمانها % % 32(@)(@@) % رأى القتل صبرا شعار الكرام % % وفخرا يزين لها شأنها % % 33(@)(@@) % فشمر للحرب في معرك % به عرك الموت فرسانها % % 34(@)(@@) % وأضرمها لعنان السماء % % حمراء تلفح أعنانها % % 35(@)(@@) % ركين وللأرض تحت الكماة % % رجيف يزلزل ثهلانها % % 36(@)(@@) % أقر على الأرض من ظهرها % % إذا ململ الرعب اقرانها % % 37(@)(@@) % تزيد الطلاقة في وجهه % % إذا غير الخوف ألوانها % % 38(@)(@@) % ولما قضى للعلى حقها % % وشيد بالسيف بنيانها % % 39(@)(@@) % ترجل للموت عن سابق % له أخلت الخيل ميدانها % % 40(@)(@@) % ثوى زائد البشر في صرعة % له حبب العز لقيانها % % PageV01P147 41(@)(@@) % كأن المنية كانت لديه % % فتاة تواصل خلصانها % % 42(@)(@@) % جلتها له البيض في موقف % % به أثكل السمر خرصانها % % 43(@)(@@) % فبات بها تحت ليل الكفاح % % طروب النقيبة جذلانها % % 44(@)(@@) % وأصبح مشتجرا للرماح % % تحلي الدما منه مرانها % % 45(@)(@@) % عفيرا متى عاينته الكماة % % 46(@)(@@) % فما أجلت الحرب عن مثله % % صريعا يجبن شجعانها % % 47(@)(@@) % تريب المحيا تظن السماء % % بأن على الأرض كيوانها % % 48(@)(@@) % غريبا ارى ياغريب الطفوف % % توسد خديك كثبانها % % 49(@)(@@) % وقتلك صبرا بأيد أبوك % % ثناها وكسر أوثانها % % 50(@)(@@) % اتقضي فداك حشا العالمين % % خميص الحشاشة ضمأنها % % PageV01P148 51(@)(@@) % ألست زعيم بني غالب % ومطعام فهر ومطعانها % % 52(@)(@@) % فلم أغفلت بك أوتارها % % وليست تعاجل امكانها % % 53(@)(@@) % وهذي الأسنة والبارقات % % اكالت يد المطل هجرانها % % 54(@)(@@) % وتلك المطهمة المقربات % % تجر على الأرض ارسانها % % 55(@)(@@) % أجبنا عن الحرب يامن غدوا % % على أول الدهر أخدانها % % 56(@)(@@) % اترضى أراقمكم ان تعد % % بنو الوزغ اليوم أقرانها % % 57(@)(@@) % وتنصب اعناقها مثلها % % بحيث تطاول ثعبانها % % 58(@)(@@) % يمينا لئن سوفت قطعها % % فلا وصل السيف أيمانها % % 59(@)(@@) % وإن هي نامت على وترها % % فلا خالط النوم أجفانها % % 60(@)(@@) % تنام وبالطف علياؤها % % أمية تنقض أركانها % % PageV01P149 61(@)(@@) % وتلك على الأرض من أخدمت % % ورب السماوات سكانها % % 62(@)(@@) % ثلاثا قد انتبذت بالعراء % % لها تنسج الريح اكفانها % % 63(@)(@@) % مصاب 
ms47	 أطاش عقول الأنام % % جميعا وحير اذهانها % % 64(@)(@@) % عليكم بني الوحي صلى الأله % % ماهزت الريح افنانها % % PageV01P150 البحر : كامل تام 1(@)(@@) % إن ضاع وترك يابن حامي الدين % % لاقال سيفك للمنايا كوني % % 2(@)(@@) % أولم تناهض آل حرب هاشم % لا بشرت علوية بجنين % % 3(@)(@@) % أمعلل البيض الرقاق بنهضة % % في يوم حرب بالردى مشحون % % 4(@)(@@) % كم ذا تهزك للكريهة حنة % من كل مشجية الصهيل صفون % % 5(@)(@@) % طال انتظار السمر طعنتك التي % % تلد المنون بنفس كل طعين % % 6(@)(@@) % عجبا لسيفك كيف يألف غمده % % وشباه كافل وتره المضمون % % 7(@)(@@) % لله قلبك وهو اغضب للهدى % % ما كان أصبره لهتك الدين % % 8(@)(@@) % فيما اعتذارك للنهوض وفيكم % % للضيم وسم فوق كل جبين % % 9(@)(@@) % ايمينكم فقدت قوائم بيضها % % أم خيلكم اضحت بغير متون % % 10(@)(@@) % لا استك سمع الدهر سيفك صارخا % في الهام فاصل محده المسنون % % PageV01P151 11(@)(@@) % إن لم تقدها في القتام طوالعا % فكأنها قطع السحاب الجون % % 12(@)(@@) % ماإن سطت يحماة ثغر تهامة % % إلا ذعرن حماة ثغر الصين % % 13(@)(@@) % يحملن منك إلى الأعادي مخدرا % يرمي المنون لقاؤه بمنون % % 14(@)(@@) % غضبان إن لبس الضواحي مصحرا % نزعت له الآساد كل عرين % % 15(@)(@@) % فمتى أراك وأنت في اعقابها % % بالرمح تطعن صلب كل ركين % % 16(@)(@@) % حيث الطريد أمام رمحك دمعه % % كغروب هاضبة القطار هتون % % 17(@)(@@) % لم يمسحن جفونه إلا رأى % % شوك القنا الأهداب رأي مطعون % % 18(@)(@@) % والموت يسأم قبض أرواح العدى % % تعبا لقكعك حبل كل وتين % % 19(@)(@@) % فتمهد الدنيا بإمرة عادل % % وبنهي علام وقسط أمين % % 20(@)(@@) % ومضاء منصلت وعزم مجرب % وأنات مقتدر وبطش مكين % % PageV01P152 21(@)(@@) % اتشيم سيفك عن جماجم معشر % % وتروكم بالذحل في صفين % % 22(@)(@@) % وحنين بيضهم الرقاق بهامكم % % ملأ الزمان برنة وحنين % % 23(@)(@@) % وكمين حقد الجاهلية فيهم % % أنى طلعتم غالكم بكمين % % 24(@)(@@) % غصبوكم بشبا الصوارم أنفسا % قام الوجود بسرها المكنون % % 25(@)(@@) % كم موقف حلبوا رقابكم دما % فيه وأعينكم نجيع شؤون % % 26(@)(@@) % لا مثل يومكم بعرصة كربلا % % في سالفات الدهر يوم شجون % % 27(@)(@@) % قد أرهفوا فيه لجدك أنصلا % تركت وجوهكم بلا عرنين % % 28(@)(@@) % يوم أبي الضيم 
ms48	 صابر محنة % % غضب الإله لوقعها في الدين % % 29(@)(@@) % سلبته أطراف الأسنة مهجة % تفدى بجملة عالم التكوين % % 30(@)(@@) % فثوى بضاحية الهجير ضريبة % تحت السيوف لحدها المسنون % % PageV01P153 31(@)(@@) % وقفت له الأفلاك حين هويه % % وتبد لت حركاتها بسكون % % 32(@)(@@) % وبها نعاه الروح يهتف منشدا % نفذت وراء حجابه المخزون % % 33(@)(@@) % وتصك جبهتك السيوف وإنها % % لولا يمينك لم تكن ليمين % % 34(@)(@@) % ما كنت حين صرعت مضعوف القوى % % فاقول لم ترفد بنصر معين % % 35(@)(@@) % وأما وشيبتك الخضيبة إنها % % لأبر كل إليه ويمين % % 36(@)(@@) % لو كنت تستام الحياة لأرخصت % % منها لك الأقدار كل ثمين % % 37(@)(@@) % أو شئت محو عداك حتى لا يرى % % منهم على الغبراء شخص قطين % % 38(@)(@@) % لأخذت آفاق البلاد عليهم % % وشحنت قطريها بجيش منون % % 39(@)(@@) % حتى بها لم تبق نافخ ضرمة % منهم بكل مفاوز وحصون % % 40(@)(@@) % لكن دعتك لبذل نفسك عصبة % % حان انتشار ضلالها المدفون % % PageV01P154 41(@)(@@) % فرأيت إن لقاء ربك باذلا % للنفس أفضل من بقاء ضنين % % 42(@)(@@) % فصبرت نفسك حيث تلتهب الضبا % % ضربا يذيب فؤاد كل رزين % % 43(@)(@@) % والحرب تطحن شوسها برحاتها % % أضمير غيب الله كيف لك القنا % % 44(@)(@@) % والسمر كالأضلاع فوقك تنحني % % والبيض تنطبق انطباق جفوني % % 45(@)(@@) % وقضيت نحبك بين أظهر معشر % حملوا بأخبث أظهر وبطون % % 46(@)(@@) % وأجل يوم بعد يومك حل في % % الإسلام منه يشيب كل جنين % % 47(@)(@@) % يوم سرت اسرى كما شاء العدى % % فيه الفواطم من بني ياسين % % 48(@)(@@) % ابرزن من حرم النبي وإنه % % حرم الإله بواضح التبيين % % 49(@)(@@) % من كل محصنة هناك برغمها % % أضحت بلا خدر ولا تحصين % % 50(@)(@@) % سلبت وقد حجب النواظر نورها % % عن حر وجه بالعفاف مصون % % PageV01P155 51(@)(@@) % قذفت بهن يد الخطوب بقفرة % % هيماء صالية الهجير شطون % % 52(@)(@@) % فغدت بهاجرة الظهيرة بعدما % % كانت بفياح الظلال حصين % % 53(@)(@@) % حرى متى التهبت حشاشتها ظما % طفقت تروح قلها بأنين % % 54(@)(@@) % وحدت بها الأعداء فوق مصاعب % ترمي السهول من الفلا بحزون % % 55(@)(@@) % لاطاب ظلك يازمان ولاجرت % % أنهار مائك للورى بمعين % % 56(@)(@@) % ماكان أوكسها لكفك صفقة % % فيها ربحت ندامة المغبون % % 57(@)(@@) % فلقد جمعت قواك 
ms49	 في يوم به % % ألقحت أم الحادثات الجون % % 58(@)(@@) % وبه مذ ابتكرت مصيبة كربلا % % عقمت فما لنتاجها من حين % % 59(@)(@@) % احماة ثغر الدين حيث سيوفكم % % شرعت محجة نهجه المسنون % % 60(@)(@@) % صلى الإله عليكم ما منكم % % هتف الصوامع باسم خير أمين % % PageV01P156 البحر : طويل 1(@)(@@) % أناعي قتلى الطف لازلت ناعيا % تهيج على طول الليالي البواكيا % % 2(@)(@@) % اعد ذكرهم في كربلا إن ذكرهم % % طوى جزعا طي السجل فؤاديا % % 3(@)(@@) % ودع مقلتي تحمر بعد ابيضاضها % % بعد رزايا تترك الدمع داميا % % 4(@)(@@) % ستنسى الكرى عين كأن جفونها % % حلفن بمن تنعاه أن لا تلاقيا % % 5(@)(@@) % وتعطى الدموع المستهلات حقها % % محاجر تبكي بالغوادي غواديا % % 6(@)(@@) % وأعضاء مجد ما توزعت الضبا % % بتوزيعها غلا الندى والمعاليا % % 7(@)(@@) % لئن فرقتهاى ل حرب فلم تكن % % لتجمع حتى الحشر إلا المخازيا % % 8(@)(@@) % ومما يزيل القلب عن مستقره % % ويترك زند الغيظ في الصدر واريا % % 9(@)(@@) % وقوف بنات الوحي عند طليقها % % بحال بها يشجين حتى الأعاديا % % 10(@)(@@) % لقد ألزمت كف البتول فؤادها % % خطوب يطيح القلب منهن واهيا % % PageV01P157 11(@)(@@) % وغودر منها ذلك الضلع لوعة % على الجمر من هذي الرزية حانيا % % 12(@)(@@) % أبا حسن حرب تقاضتك دينها % % إلى أن أساءت في بنيك التقاضيا % % 13(@)(@@) % مضوا عطري الأبراد يأرج ذكرهم % % عبيرا تهاداه الليالي غواليا % % 14(@)(@@) % غداة ابن أم الموت أجرى فرنده % % بعزمهم ثم انتضاهم مواضيا % % 15(@)(@@) % واسرى بهم نحو العراق مباهيا % % بأوجههم ثم الظلام الدراريا % % 16(@)(@@) % تناذرت الأعداء منة ابن غابة % على نشزات الغيل أصحر طاويا % % 17(@)(@@) % تساوره افعى من الهم لم يجد % % لسورتها شيئا سوى السيف راقيا % % 18(@)(@@) % وأظمأه شوق غلى العز لم يزل % % لورد حياض الموت بالصيد حاديا % % 19(@)(@@) % فصمم لا مستعديا غير همة % تفل له العضب الجراز اليمانيا % % 20(@)(@@) % وأقدم لا مستسقيا غير عزمة % تعيد غرار السيف بالدم راويا % % PageV01P158 21(@)(@@) % بيوم صبغن البيض ثوب نهاره % % على لابسي هيجاه أحمر قانيا % % 22(@)(@@) % ترقت به عن خطة الضيم هاشم % % وقد بلغت نفس الجبان التراقيا % % 23(@)(@@) % لقد وقفوا في ذلك اليوم موقفا % إلى الحشر لا يزداد إلا معاليا 
ms50	 % % 24(@)(@@) % هم الراضعون الحرب أول درها % % ولا حلم يرضعن إلا العواليا % % 25(@)(@@) % بكل ابن هيجاء تربى بحجرها % % عليه أبوه السيف لا زال حانيا % % 26(@)(@@) % طويل نجاد السيف فالدرع لم يكن % % ليلبسه إلا من الصبر ضافيا % % 27(@)(@@) % يرى السمر يحملن المنايا شوارعا % غلى صدره أن قد حملن الأمانيا % % 28(@)(@@) % هم القوم أقمار الندي وجوههم % % يضئن من الآفاق ما كان داجيا % % 29(@)(@@) % مناجيد طلا عين كل ثنية % يبيت عليها ملبد الحتف جاثيا % % 30(@)(@@) % ولم تدر إن شدوا الحبى أحباهم % % ضمن رجالا أم جبالا رواسيا % % PageV01P159 البحر : وافر تام 1(@)(@@) % فتاة الحي حسبك من جفائي % % صلي قبل التفرق والتنائي % % 2(@)(@@) % أضامية الوشاح إلى م اضمى % % وريقك في ترشفه روائي % % 3(@)(@@) % فرفقا يابنة الغيران رفقا % بذي كبد تحن إلى اللقاء % % 4(@)(@@) % صدودك في حشاه أمض داء % ووصلك عنده أشفى دواء % % 5(@)(@@) % فلا خاط الكرى عيني شوقا % لرؤية وجهك الحسن الرواء % 6(@)(@@) % أما والراميات إلى المصلى % % كامثال السهام من النجاء % % 7(@)(@@) % لقد قلبن أيدي الشوق مني % % صريعا بين ألحاظ الظباء % 8(@)(@@) % فكم منها لهوت بذات خدر % يجول بخدها ماء الحياء % % 9(@)(@@) % بميبلة المساء على صباح % % ومطلعة الصباح من المساء % 10(@)(@@) % هظيم الكشح مرهفة التثني % % كسول المشي لا عبة الغشاء % % PageV01P160 البحر : بسيط تام 1(@)(@@) % جاز النسيم على الغيد الرعابيب % % فجاء يحمل منها نفحة الطيب % % 2(@)(@@) % هي الظبا بضبا الالحاظ كم صرعت % % ليثا فأضحى لديها غير مطلوب % % 3(@)(@@) % بما استحلت فتاة الحي سفك دمي % % واستعذبت في مطال الوصل تعذيبي % % 4(@)(@@) % هب حسن يوسف فيها مودع أولم % % يكن لها في فؤادي وجد يعقوب % PageV01P161 البحر : طويل 1(@)(@@) % وأغيد منسوب غلى الرب لاح لي % % على خده خال غلى الزنج ينسب % % 2(@)(@@) % وما نظرت عيناي كالخال مبتلى % % مقيما على نار من الخد تلهب % % 3(@)(@@) % فتلدغه أفعى من الجعد تارة % وتلبسه طورا من الصدغ عقرب % % PageV01P162 البحر : خفيف تام 1(@)(@@) % خطرت في رداء حسن قشيب % % تتثنى كغصن بان رطيب % 2(@)(@@) % خلت لما تفاوح المسك منها % % فض في رحلنا لطيمة طيب % 3(@)(@@) % وتراني إذا رشفت 
ms51	 لماها % % لم أخله إلا جنا يعسوب % 4(@)(@@) % فاعتنقنا شوقا وبتنا نشاوى % % من كؤوس الكرى بغير رقيب % % 5(@)(@@) % لاتلمني ياصاحبي في هواها % % لعب الشوق في فؤادي الطروب % % PageV01P163 البحر : طويل 1(@)(@@) % اكال اشتغالي في هواه مهفهف % % أنيق الصبا سبحان مبدع فطرته % % 2(@)(@@) % أطالع منه في ليالي فروعه ال % % طوال على أنوار مصباح غرته % % 3(@)(@@) % صحيفة وجه في فؤادي يحب في % % حروف معان هن غير مصربه % % 4(@)(@@) % بصاد فم في نقطة الخال معجم % ولام عذار تحت تشديد طرته % % PageV01P164 البحر : كامل تام 1(@)(@@) % ضمنت غلائل ربة الأرج % % ماشئت من هيف ومن دعج % % 2(@)(@@) % معشوقة اللحظات قد كحلت % % بالفا تنين السحر والغنج % % 3(@)(@@) % إن الذي لشقاي صورها % % بالشهد قال لريقها امتزج % % 4(@)(@@) % كم أرشفتني الثغر قائلة % هل في حميا الريق من حرج % % 5(@)(@@) % بيضاء تبعث من ضفائرها % % بسلاسل الريحان كالسبج % % 6(@)(@@) % إن قال لليل ادج فاحمها % % للصبح قال جبينها ابتلج % % 7(@)(@@) % تشدو فتطرب في تنقلها % % ياللحن من رمل ومن هزج % % PageV01P165 البحر : خفيف تام 1(@)(@@) % برزت تحمل بالراح راحا % % فكست بهجة نور براحا % % 2(@)(@@) % لست أدري راحها أم لماها % % ما سقتني أم زلالا قراحا % % 3(@)(@@) % غادة مجدولة تتثنى % % مرحا ر باالشباب رداحا % % 4(@)(@@) % ومهاة ابت الوصل لما % % رأت الشيب برأسي لاحا % % 5(@)(@@) % قلت أنت الشمس تغرب ليلا % ويراها العالمون صباحا % % 6(@)(@@) % فأجابت غنني أنا بدر % % يأفل الصبح ويبدو رواحا % % 7(@)(@@) % ثم قالت ماترى الشهب عقدا % فوق نحري والثريا وشاحا % % 8(@)(@@) % قلت فوق الكشح ما جال إلا % وأعار الطير قلبي الجناحا % % PageV01P166 البحر : كامل تام 1(@)(@@) % يالأثمي وشهاب وجدي ثاقب % % كيف العزاء وطود صبري ساخا % % 2(@)(@@) % وقف السهاد بمقلتي متوسما % % فراى بها اثر الكرى فأناخا % % PageV01P167 البحر : مجزوء الكامل 1(@)(@@) % ابدين تفاح الخدود % % وسترن رمان النهود % % 2(@)(@@) % ونشرن ريحان الغدائر % فوق أغصان القدود % % 3(@)(@@) % وأتين يحملن الكؤوس % كأنهن ثغور غيد % 4(@)(@@) % هب حسن يوسف فيها مودع أو لم % % غها سود الجعود % 4(@)(@@) % من كل ضامية الوشاح % رؤية الخلخال رود % % 5(@)(@@) % هيفاء لو طالبتها % % بدمي فوجنتها شهيدي % % 6(@)(@@) % لكنها عطفت 
ms52	 علي بصد % % 7(@)(@@) % فمتى بسفك دمي تقر % وصدغها لام الجحود % 8(@)(@@) % من مائلات كالغصون % دعت بها النسمات ميدي % % 9(@)(@@) % من مصبيات للحليم % % بطرف جازية وجيد % PageV01P168 10(@)(@@) % من قاسمات الدر ما % % بين المضاحك والعقود % % 11(@)(@@) % أنت العميد وحبدا % % بدمي النقا ولع العميد % 12(@)(@@) % فارشف عروسا من طلى % جليت على ورد الخدود % 13(@)(@@) % جاءت إليك تزفها % % عذراء كاعبة النهود % 14(@)(@@) % ياما أسرك ليلة % في الدهر كاملة السعود % 15(@)(@@) % فلنا صباحك قد تجلى % % مسفرا عن يوم عيد % % 16(@)(@@) % بيض لو تك من العذار % % بشقر لامات وسود % PageV01P169 البحر : خفيف تام 1(@)(@@) % يا رياض الوصال أثمرت غيدا % % فاجتنينا سوالفا وخدودا % % 2(@)(@@) % وافتنصنا جآذرا ناصبات % شرك الحسن يقتنصن الأسودا % % PageV01P170 البحر : سريع 1(@)(@@) % مرت بنا أمس تميمية % ساحبة أذيالها العاطره % % 2(@)(@@) % آنسة الدل ترى وهي إن % % آنستها وحشية نافره % % 3(@)(@@) % قد جذبت أحشاءنا مذ غدت % % ترمقنا بالنظرة الفاتره % % 4(@)(@@) % فانجذبت من شغف نحوها % % تسبق منا الأرجل السائره % % 5(@)(@@) % وعاد منا كل ذي صبوة % وفي حشاه رجله عاثره % % PageV01P171 البحر : رجز تام 1(@)(@@) % ظن العذول أدمعي تناثرت % % حمرا لعمري غره ما يبصره % 2(@)(@@) % وإنما يقدح زند الشوق في % % قلبي ، ومن عيني يطير شرره % % PageV01P172 البحر : مخلع البسيط 1(@)(@@) % إن التي سكنت ضميري % % في حسنها سلبت شعوري % % 2(@)(@@) % برشاقة الغصن الرطيب % ولفتة الظبي الغرير % 3(@)(@@) % قد أرهفت من لحظها % % سيفا ضريبته ضميري % % 4(@)(@@) % قسما بعامل قدها الخط % ار يخطر بالحرير % 5(@)(@@) % ما أسكرتني خمرة % لولاك يا عين المدير % PageV01P173 البحر : طويل 1(@)(@@) % عهدت بذات البان فالجزع أربعا % % كساهن وشي الروض بردا مولعا % % 2(@)(@@) % وجاد عليها كل محتفل الحيا % % فأبقى عميم النبت فيها وودعا % % 3(@)(@@) % تعاقب ربعيا عليها وصائفا % فكان مصيفا للخليط ومربعا % % 4(@)(@@) % إذا انحل في حافاته خيط برقه % % تناثر در القطر من حيث جمعا % % 5(@)(@@) % إذا ما النسيم الغض حيا عراصها % % نشقت عبيرا عطر الجو أجمعا % % 6(@)(@@) % وما هي في غض النسيم تضوعت % % ولكن برياها النسيم تضوعا % % 7(@)(@@) % برغمي ربوع الحي أصبحن بلقعا % عشية زال الحي عنها وأزمعا % % 8(@)(@@) % وقفت بها 
ms53	 مستسقيا فسقيتها % % إلى أن شربت الماء فيهن أدمعا % % 9(@)(@@) % رعيت بها ريحانة اللهو غضة % % أروح وأغدو بالدمى البيض مولعا % % 10(@)(@@) % وفيها صحبت الدهر والعيش ناعم % ليالي فيها شمل أنسي تجمعا % % PageV01P174 11(@)(@@) % كأن الدجى ملك من الزنج لابس % من الأفق تاجا بالكواكب رصعا % % 12(@)(@@) % من الزهرة الغراء قد بات يجتلي % % عروسا جلاها الحسن أن تتبرقعا % % PageV01P175 البحر : متقارب تام 1(@)(@@) % حبست على اللهو قلبا طليقاحبست على اللهو قلبا طليقا % % وقمت أحيي الخيال الطروقا % % 2(@)(@@) % لدى روضة قد كساها الربيع % من النور والزهر بردا رقيقا % % 3(@)(@@) % عليها الصبا سحبت ذيلها % % وذرت من الطيب مسكا سحيقا % % 4(@)(@@) % تروقك إن مر فيها النسيم % منها يلاعب غصنا وريقا % % 5(@)(@@) % كأن الغصون إذا الورق غنت % % على الأيك نشوان لن يستفيقا % % 6(@)(@@) % إذا اعتنقت طربا خلتهن % شقيقا يعانق شوقا شقيقا % % 7(@)(@@) % عشية لهو بها الدهر جاد % بها عاد عيشي غضا أنيقا % % 8(@)(@@) % أمنت بها الدهر حتى كأبي % % أخذت على الدهر عهدا وثيقا % % 9(@)(@@) % سررت بها غير أن الحبيب % % فقدانه ساء قلب المشوقا % % 10(@)(@@) % فكنت إذا قلبي اشتاقه % % لأرشف فاه رشفت الرحيقا % % PageV01P176 11(@)(@@) % وأعتنق الغصن عن قده % % وألثم عن وجنتيه الشقيقا % % 12(@)(@@) % فما زلت أجني ثمار السرور % % والنقى والعقيق بها والرصيقا % % 13(@)(@@) % إلى أن رأيت الصباح انتضى % % على مفرق الليل عضبا ذليقا % % 14(@)(@@) % مضى الليل يدعو النجاء النجاء % والصبح يدعو اللحوق اللحوقا % % 15(@)(@@) % فقمت ولم أر مما رأيت % شيئا ، اكفكف دمعا دفوقا % % 16(@)(@@) % وقد كنت أحسب طرف الزمان % من سكرة النوم بي لن يضيقا % % 17(@)(@@) % فيا لائمي إن ذكرت العقيق % ولولا الهوى ما ذكرت العقيقا % % 18(@)(@@) % تذكرت من كنت ألهو به % % فصرت لكتم الهوى لن أطيقا % % 19(@)(@@) % لئن بان جسمي عنه فقد % % تخلف قلبي فيه وثيقا % % 20(@)(@@) % فليت غدت حالبات الربيع % % حياها على غيره لن تريقا % % PageV01P177 21(@)(@@) % فتسقي به مرضعات الربيع % % رضيع الخمائل ماء دفوقا % % 22(@)(@@) % ففي كل يوم بأطلاله % % أحي من الغيد وجها طليقا % % 23(@)(@@) % ومرهفة الخصر وسنى اللحاظ % تغادر قلب المعنى خفوقا % % 24(@)(@@) % إذا ما رشفت لمى 
ms54	 ثغرها % % تعاف الصبوح له والغبوقا % % 25(@)(@@) % ترى البدر والغصن والظبي % والنقى والعقيق بها والرحيقا % % 26(@)(@@) % محيا وقدا وجيدا وعينا % وردفا ثقيلا وثغوا وريقا % % PageV01P178 البحر : رمل تام 1(@)(@@) % حي طيفا زار من سعدي لماما % % لم يزود صبها إلا غراما % % 2(@)(@@) % طارقا ما أسأرت زورته % % في حنايا أضلعي إلا ضراما % % 3(@)(@@) % هوم الركب فحيا مضجعي % % بعد لأي مهديا عنها السلاما % % 4(@)(@@) % وكما شاء الهوى عللني % % بحديث بل من قلبي الأواما % % 5(@)(@@) % زادني سكرا إلى سكر الكرى % % فكأني منه عاقرت مداما % % 6(@)(@@) % كلما مثل لي قامتها % % زدته ضما لصدري والتزاما % % 7(@)(@@) % أو ثناياه لعيني وصفت % % ثغرها استشفيت فيهن التثاما % % 8(@)(@@) % لم أزل ألهو به حتى غدت % % أنجم الشرق إلى الغرب ترامى % % 9(@)(@@) % فرغت من سهر الليل وأومت % % بعيون آذنتنا أن تناما % % 10(@)(@@) % يا لها من زورة كاذبة % أعقبت وجدا بقلبي واحتداما % % PageV01P179 البحر : كامل تام 1(@)(@@) % قد كان داؤك للشريعة داءا % % فالآن صار لها شفاك شفاءا % % 2(@)(@@) % نزعت يد الباري سقامكما معا % وكسته شاغلة به الأعداءا % % 3(@)(@@) % مسحت غبار الداء منك بصحة % كانت لوجه المكرمات جلاءا % % 4(@)(@@) % قرت بها عين الهداية وانثنت % % عين الحواسد تشتكي الأقذاءا % % 5(@)(@@) % والمجد أعلن في البرية هاتفا % بشرى بصحة من شفى العلياءا % % 6(@)(@@) % فاغدوا سواء في السرور كما غدوا % % في شكر نائله الجزيل سواءا % % 7(@)(@@) % فلتهن طائفة الهدى في شيخها % % ولنستدم به وأمه النعماءا % % 8(@)(@@) % فإليه أملاك السماء تطلعت % % فأقر أعينها غداة تراءا % % 9(@)(@@) % وتباشرت حتى كأن إلهها % % منها أزال ببرئه الأدواءا % % 10(@)(@@) % وتنزلت كيما تنتهي جعفرا % وهو الجدير مودة وإخاءا % % PageV01P180 11(@)(@@) % لا قلت هذا غير ذاك فهل ترى % % ماء تغاير ، إن قسمت الماءا % % 12(@)(@@) % هو جعفر الفضل الذي أهل النهى % % يردون منه ويصدرون رواءا % % 13(@)(@@) % وإذا رقى الأعواد أسمع ناطقا % بالوعظ حتى الصخرة الصماءا % % 14(@)(@@) % ولقد سرى في الصالحات لذكره % % أرج يطبق نشره الأرجاءا % % 15(@)(@@) % وأطل دعاك له وناد محمد ال % % حسن المجلي نوره الظلماءا % % 16(@)(@@) % أأبا الشريعة أنت كافلها الذي % % أنسى البنين ببره الأباءا % % 17(@)(@@) % وبكم جميعا 
ms55	 أبصرت لكنهم % % كانوا لها حدقا وكنت ضياءا % % 18(@)(@@) % أنت المعد لحفظ حوزتنا التي % % لم تحو سابغة ولا عداءا % % 19(@)(@@) % ماذا يضر ومنكباك لواؤنا % % أن لانهز على العدات لواءا % % 20(@)(@@) % ولسانك السيف الذي أخذ الهدى % % بشباه من أعدائه ما شاءا % % PageV01P181 21(@)(@@) % وإذا جرى قلم بكفك خاله % بحشاه خصمك صعدة سمراءا % % 22(@)(@@) % ولقد جريت إلى المعالي سابقا % حتى تركت السابقين وراءا % % 23(@)(@@) % غفرا لذنب الدهر إن له يدا % عندي نسيت لنفعها الضراءا % % 24(@)(@@) % جلب المسرة لي بإثر مسرة % سبقت فضاعف عندي السراءا % % 25(@)(@@) % بشفاء منتجب وعرس مهذب % بهر البرية فطنة وذكاءا % % 26(@)(@@) % إن غبت عن ذاك السرور فلم يكن % % ليفوتني ما أطرب الشعراءا % % 27(@)(@@) % فبعرس عبد الله رونق عصرنا % % في كل آونة يزيد صفاءا % % 28(@)(@@) % وبأيما وقت حضرت فإنه % % للزهو وقت بالسعود أضاءا % % 29(@)(@@) % فاهتف ودونكه لتهنئة العلى % % وشيا يفوق صناعة صنعاءا % % 30(@)(@@) % بشرى به عرسا لأي مرشح % بعلى أبيه تجاوز الجوزاءا % % PageV01P182 31(@)(@@) % هو غصن مجد ذو مخايل بشرت % % أن سوف يثمر سؤددا وعلاءا % % 32(@)(@@) % لو أن من نظم القريض بعرسه % % نظم النجوم لزادها لألاءا % % 33(@)(@@) % سكرت به الدنيا ولكن لم تذق % % إلا خلائق جده صهباءا % % 34(@)(@@) % صفه وإخوته فكل منهم % % في المجد أحرز عزة قعساءا % % 35(@)(@@) % أحيوا أباهم باقر العلم الذي % % قدما أعاد ذوي النهى أحياءا % % 36(@)(@@) % متكافئين بفخره وجميعهم % % ولدتهم أم العلى أكفاءا % % 37(@)(@@) % فلجده البشرى وأين كجده % % لا تطلبين مزايا ذكاء ذكاءا % % 38(@)(@@) % وليهن فيه عمه ذاك الذي % % فاتت مزايا فضله الإحصاءا % % 39(@)(@@) % يا من إذا التفت عليه مجامع % الآراء فل بعزمه الآراءا % % 40(@)(@@) % دم للشريعة كي تدوم لنا فقد % % جعل الإله لها بقاك بقاءا % % PageV01P183 41(@)(@@) % وأقم على مر الزمان ممدحا % يحبى صباحا بالسنى ومساءا % % PageV01P184 البحر : خفيف تام 1(@)(@@) % نفحات السرور أحيت حبيبا % % فحبتنا من النسيب نصيبا % % 2(@)(@@) % وأعادت لنا صريع الغواني % % يسترق الغرام والتشبيبا % % 3(@)(@@) % غادرتنا نجر رجل خليع % غزل كالصبا يعد المشيبا % % 4(@)(@@) % نعمتنا بناعم القد غض % قد كساه الشباب بردا قشيبا % % 5(@)(@@) % زارنا والنسيم نم عليه 
ms56	 % % فكأن النسيم كان رقيبا % % 6(@)(@@) % رشأ عاطش الموشح ريا % % ن بماء الصبا يميس قضيبا % % 7(@)(@@) % ما نضى برقع المحاسن إلا % لبس البدر للحياء الغروبا % % 8(@)(@@) % فعلى بانة يجيل وشاحا % وعلى نير يزر جيوبا % % 9(@)(@@) % لو رأت نار وجنتيه النصارى % % عبدت كالمجوس منها اللهيبا % % 10(@)(@@) % أو لحاها قسيسها لأتت تو % % قد فيها ناقوسها والصليبا % % PageV01P185 11(@)(@@) % كم لحاني العذول ثم رآه % % فغذا شيقا إليه طروبا % % 12(@)(@@) % جاءني لائما فعاد حسودا % رب داء سرى فأعدى الطبيبا % % 13(@)(@@) % يا نديمي أطربت سمعي بلمياء % ويا رب زدتني تعذيبا % % 14(@)(@@) % لي فيها جعلت ألف رقيب % ولشهب السما جعلت رقيبا % % 15(@)(@@) % ذات قد تكاد تقصف منه % % نسمات الدلال غصنا رطيبا % % 16(@)(@@) % فأعد ذكرها لسمعي فقلبي % % كاد شوقا لذكرها أن يذوبا % % 17(@)(@@) % غن لي باسمها على نقل الراح % % وزدني أفدي لك العندليبا % % 18(@)(@@) % بربيب حوى بديع جمال % فيه قد أخجل الغزال الربيبا % % 19(@)(@@) % كفلا ناعما وطرفا كحيلا % وحشى مخطفا وكفا خضيبا % % 20(@)(@@) % وكورد الرياض وجنة خد % يقطف اللثم منه وردا عجيبا % % PageV01P186 21(@)(@@) % كلما طله الحيا بنداه % % رش ماء فبل فيه القلوبا % % 22(@)(@@) % يا بعيدا أثمرن منه أعالي % % غصن القد لي عناقا قريبا % % 23(@)(@@) % ما أجد الفتور لحظك إلا % وبلب اللبيب كان لعوبا % % 24(@)(@@) % أو بخديك عقرب الصدغ دبت % % فبقلبي لها وجدت دبيبا % % 25(@)(@@) % لم تزل تألف الكثيب وقلبي % % يتمنى بأن يكون الكثيبا % % 26(@)(@@) % أنت ريحانة المشوق ولكن % % جاءنا ما يفوق رياك طيبا % % 27(@)(@@) % فلنا من محمد بشذاه % % نسمات الأقبال طابت هبوبا % % 28(@)(@@) % نفحتنا أعطافه فانتشقنا % % أرجا عطر الصبا والجنوبا % % 29(@)(@@) % أكثرت شوقها إليه القوافي % % فأقلت للمدح فيه النسيبا % % 30(@)(@@) % ودعت يا بن أعلم القوم بالله % % ويا أكمل الورى تهذيبا % % PageV01P187 31(@)(@@) % لحظات الإله في الخلق أنتم % % وابن ريب من رد ذا مستريبا % % 32(@)(@@) % ومتى تنتظم قنا الفخر كنتم % % صدرها والكرام كانوا كعوبا % % 33(@)(@@) % وإذا أذنب الزمان فأنتم % % حسنات له تحط الذنوبا % % 34(@)(@@) % بردت بالهنا ثغور المعالي % % وجلى الابتسام منها الغروبا % % 35(@)(@@) % ووجوه الأيام قد أصبحت تخ % % طب حسنا وكن 
ms57	 قبل خطوبا % % 36(@)(@@) % ضحكت بهجة بلامع بشر % لم تدع للتقطيب فيه نصيبا % % 37(@)(@@) % ليت شعري أكان للنجف الأش % % رف أم للفيحاء أجلى شحوبا % % 38(@)(@@) % فرح طافت المسرة فيه % % فأزالت عن القلوب الكروبا % % 39(@)(@@) % فتعاطت على اختلاف هواها % % ضربا هذه وتلك ضريبا % % 40(@)(@@) % فأدر لي يا صاحبي حلب البشر % % المصفى واترك لغيري الحليبا % % PageV01P188 41(@)(@@) % أيها القادم الذي تتمنى % % كل عين رأته أن لا يغيبا % % 42(@)(@@) % قد شهدن الفجاج أن بتقوي % % يضك للجود في الفلا تطنيبا % % 43(@)(@@) % كل فج لم ترتحل منه إلا % وأقمت السماح فيه خطيبا % % 44(@)(@@) % قد بذلت القرى لها وسقاها % % بك رب السماء غيثا سكوبا % % 45(@)(@@) % فكفاها خصبا بأنك فيها % % سرت والغيث تقتلان الجدوبا % % 46(@)(@@) % يا بن قوم يكاد يمسكها الرك % % ن كما يمسك الحبيب الحبيبا % % 47(@)(@@) % بك باهى مقام جدك إبرا % % هيم لما أن قمت فيه منيبا % % 48(@)(@@) % مس منه مناكبا لك مست % % ه وأخلق عنه بها أن تنوبا % % 49(@)(@@) % ولو ان البطحاء تملك نطقا % لسمعت التأهيل والترحيبا % % 50(@)(@@) % منك حيت عمرو العلى ذلك الم % كثر للضيف زاده والمطيبا % % PageV01P189 51(@)(@@) % وأرتها شمائل لك راقت % % أن شيخ البطحاء قام مهيبا % % 52(@)(@@) % واستهلت طير السماء وقالت % % مشع الطير جاء يطوي السهوبا % % 53(@)(@@) % إن هذا لشيبة الحمد أولى % % فابن من سادهم شبابا وشيبا % % 54(@)(@@) % شرفا يا بني الإمامة قد ال % ف مهديها عليها القلوبا % % 55(@)(@@) % فيه بانت حقائق الفضل للنا % % س وكن الأسماء والتلقيبا % % 56(@)(@@) % وإليه رياسة الدين آبت % % وقصارى انتظارها أن تؤوبا % % 57(@)(@@) % كلما عن مشكل حضرته % % فكرة فيه أطلعته الغيوبا % % 58(@)(@@) % أحزم العالمين رأيا وأقوا % % هم على العاجمين عودا صليبا % % 59(@)(@@) % يا أبا الأنجم الثواقب في الخط % % ب بقلب الحسود أبقوا ثقوبا % % 60(@)(@@) % إن من عن قسي رأيك يرمي % % لجدير سهامه أن تصيبا % % PageV01P190 61(@)(@@) % حلف المجد فيك لا يلد الدهر % لهم في بني المعالي ضريبا % % 62(@)(@@) % لست أدري هل الصوارم أم ال % % سنهم في الخصام أمضى غروبا % % 63(@)(@@) % والغوادي للعام أضحك أم أي % % ديهم البيض حين تأبى قطوبا % % 64 
ms58	(@)(@@) % خير ما استغزر الرجا جعفر الجود % وناهيك أن ترود وهوبا % % 65(@)(@@) % لو بصغرى البنان ساجل بحرا % لأرى البحر أن فيه نضوبا % % 66(@)(@@) % أريحي أرق طبعا من الزه % % ر المندى باكرته مستطيبا % % 67(@)(@@) % عجبا هزه المديح ارتياحا % واهتزاز الأطواد كان غريبا % % 68(@)(@@) % هو في طيب ذكره صالح الفعل % % لقد طاب محضرا ومغيبا % % 69(@)(@@) % أطهر الناس مئزرا ورداء % % الغيب أنقى على العفاف جيوبا % % 70(@)(@@) % خلقه أسكر الزمان ولكن % % لم يكن في كؤوسه مسكوبا % % PageV01P191 71(@)(@@) % قل لمن رام شأوه أين تبغي % % قد تعلقت ظنك المكذوبا % % 72(@)(@@) % أو ما في الحسين ما قد نهاكم % % أن تطيلوا وراءه التقريبا % % 73(@)(@@) % سادة للعلى يرشحها المجد % وليدا وناشئا وربيبا % % 74(@)(@@) % زعماء الأنام قد ضرب الفخر % عليهم رواقه المحجوبا % % 75(@)(@@) % سمروا في قباب مجد أعدوا % % حارسيها الترهيب والترغيبا % % 76(@)(@@) % كل سبط البنان في الشتوة الغب % % راء يأبى عنها الحيا أن ينوبا % % 77(@)(@@) % حي بسامة العشي تفدي % % بوجوه كم قد دجت تقطيبا % % 78(@)(@@) % كم دعاها الرجا فأنشد يأسا % من سجايا الطلول أن لا تجيبا % % 79(@)(@@) % لا عدى ميسم الهيجاء أناسا % كان وسم المديح فيهم غريبا % % 80(@)(@@) % صبغ الله أوجه البيض والصفر % % بحظ الذي يكون أديبا % % PageV01P192 81(@)(@@) % كم أعارت محاسن الدهر قوما % ملأوا عيبة الزمان عيوبا % % 82(@)(@@) % أيها اللامعات فيهم غرورا % لابن دينارك استرقي الخصيبا % % 83(@)(@@) % كتب الطبع فيك نصرا من الحظ % % وفتحا للأعبياء قريبا % % 84(@)(@@) % كم لبيب بغير مغن ومغن % لأخي ثروة وليس لبيبا % % 85(@)(@@) % فأعد لي ودعهم ذكر قوم % لك مهما نشرته ازدادا طيبا % % 86(@)(@@) % عترة الوحي ما أقل ثنائي % % إن ظهر الإنشاء ليس ركوبا % % 87(@)(@@) % بل بصدر القول ازدحمن مزايا % % كم فضيقنه وكان رحيبا % % 88(@)(@@) % لم تزل منكم تقر عيونا % فرحات لكم تسر القلوبا % % 89(@)(@@) % فبثوب الزمان ليس سواكم % % فالبسوه على الدوام قشيبا % % PageV01P193 البحر : كامل تام 1(@)(@@) % حيتك سارقة اللحاظ من الظبا % % تجلو المدام فحي ناعمة الصبا % % 2(@)(@@) % جاءتك تبتسم والبنان نقابها % % فأرتك بدرا بالهلال تنقبا % % 3(@)(@@) % وكأنها هي حين زفت كأسها % % شمس تزف من المدامة كوكبا 
ms59	 % % 4(@)(@@) % عقدت على الوسط النطاق مفوفا % ولوت على الخصر الوشاح مذهبا % % 5(@)(@@) % أحبب إليك بها عشيقة مغرم % راض العواذل شوقه فتصعبا % % 6(@)(@@) % هي تلك لاعبة العشاء ومن لها % % ألفت بنات الشوق قلبك ملعبا % % 7(@)(@@) % أمسيت منها ناعما بغريرة % بنسيم رياها تعطرت الصبا % % 8(@)(@@) % ونديمة لك لو تغنى باسمها % % حجر لرقصه غناها مطربا % % 9(@)(@@) % سكبت بكأس حديثها من لفظها % % راحا ألذ من المدام وأعذبا % % 10(@)(@@) % وترنمت هزجا فأطرب لحنها % % قمري مائسة الأراك فطربا % % PageV01P194 11(@)(@@) % فكأنما علمت بعرس المصطفي % % فشدت غنا لابن الأراكة أطربا % % 12(@)(@@) % في ليلة طابت فساعة أنسها % % لم تلق عمر الدهر منها أطيبا % % 13(@)(@@) % وفد السرور بها لمغنى أصيد % كرما يحيي الوافدين مرحبا % % 14(@)(@@) % شملت مسرته البرية كلها % % إذ كان في كل النفوس محببا % % 15(@)(@@) % فكأن عرس المصطفى فيه الورى % % كل محمد صالح أن يطربا % % 16(@)(@@) % قد عاد مغربها يهني شرقها % % فيه ومشرقها يهني المغربا % % 17(@)(@@) % فرحوا وحق لهم به أن يفرحوا % % من حيث أن الدهر فيه أغربا % % 18(@)(@@) % في الشيب جاء به سرورا لم يجىء % % في مثله مذ كان مقتبل الصبا % % 19(@)(@@) % هو في الأنام صنيعة مشكورة % % للدهر ما صحبوا لسانا معربا % % 20(@)(@@) % للكرخ ناعمة الهبوب تحملي % % مني سلاما من نسيمك أطيبا % % PageV01P195 21(@)(@@) % وصلي إلى بيت قد انتجع الورى % % منه جنابا بالمكارم معشبا % % 22(@)(@@) % بيت على الزوراء يقطر نعمة % فكأنه بالغيث كان مطنبا % % 23(@)(@@) % قولي إذا حييت فيه بالرضا % % فسواك منه هيبة لن يقربا % % 24(@)(@@) % بشراك بسام العشي بفرحة % ضحكت بها الدنيا إليك تطربا % % 25(@)(@@) % وجلا عليك اليمن فيها طلعة % غراء ساطع سعدها لن يغربا % % 26(@)(@@) % فاسعد بقرة ناظريك فقد غدا % % في عرسه المجد المؤثل معجبا % % 27(@)(@@) % أمقيل من لبس الهجير تغربا % ومعرس السارين تنزع لغبا % % 28(@)(@@) % عجبا لهذا الدهر يصحب بخله % % ولجود كفك ليس يبرح مصحبا % % 29(@)(@@) % ويرى جبينك كيف يشرق للندى % % كرما ويغدو الوجه منه مقطبا % % 30(@)(@@) % أرحبت للأضياف دارة جفنة % من دارة القمر الوسيعة أرحبا % % PageV01P196 31(@)(@@) % وحملت عبء بني الزمان ولو به % % يعنى أبوهم لاستقالك 
ms60	 متعبا % % 32(@)(@@) % وأما ومجدك خلفة لو لم يكن % % للعالمين سجال جودك مشربا % % 33(@)(@@) % نزف اغترافهم البحار وبعدها % % ترك اعتصارهم الغمائم خلبا % % 34(@)(@@) % فمتى تقوم بحارها وقطارها % % لهم مقامك ما جرت وتصببا % % 35(@)(@@) % يفدي أناملك الرطيبة معجب % في يبس أنملة بعذلك أسهبا % % 36(@)(@@) % لو مس وجه الأرض يبس بنانه % % لرأيته حتى القيامة مجدبا % % 37(@)(@@) % عذبت مذاقة ' لا ' بفيه لبخله % % وبفيك طعم ( نعم ) غدا مستعذبا % % 38(@)(@@) % فأزداد حتى في معيشة نفسه % ضيقا وللوفاد زدت ترحبا % % 39(@)(@@) % تسع الزمان بجود كفك باسما % ويضيق صدر الدهر منك مقطبا % % 40(@)(@@) % لورعت مهجة نفسه وزحمته % % لفطرتها وحطمت منه المنكبا % % PageV01P197 41(@)(@@) % ولقد جريت إلى العلاء بهمة % لم ترض عالية المجرة مركبا % % 42(@)(@@) % حلقت حيث الطرف عنك مقصر % فصعدت حيث النجم عنك تصوبا % % 43(@)(@@) % شهدت قناة المجد أنك صدرها % % وعدا أخيك غدا الأماجد أكعبا % % 44(@)(@@) % ما قمت يوم الفخر وحدك موكبا % إلا وقام به مثالك موكبا % % 45(@)(@@) % أصبحت منتسبا لغر أماجد % ودت لهم شهب السما أن تنسبا % % 46(@)(@@) % هم أيكة الشرف التي منها الورى % % ثمر السماحة ما اجتنوه مرجبا % % 47(@)(@@) % طابت أرومتها العريقة في العلى % % وسقت مكارمها ثراها الطيبا % % 48(@)(@@) % وكفى بجودك وهو أعدل شاهد % يصف الذي من جودها قد غيبا % % 49(@)(@@) % ولقد تحققت اسم غادية الحيا % % فوجدت معناه نداك الصيبا % % 50(@)(@@) % وأجلت فكري في اسم أنفاس الصبا % % فإذا به خلق الرضا قد لقبا % % PageV01P198 51(@)(@@) % سيماء عزك في أسرة وجهه % % لله أنت فهكذا من أنجبا % % 52(@)(@@) % زينت أفق الفخر منك بكوكب % ما كان أزهره بفخرك كوكبا % % 53(@)(@@) % فالشمس قد ودت وإن هي أعقبت % % قمر السماء نظيره أن تعقبا % % 54(@)(@@) % قد غاض فيض ابن الفرات لجوده % % إذ كان أغزر من نداه وأعذبا % % 55(@)(@@) % لا تطر كعبا واطو حاتم طيء % % وانشر مكارمه تجدها أغربا % % 56(@)(@@) % وارتك له معنا على ما فيه من % % كرم فمعن لو رآه تعجبا % % 57(@)(@@) % ودع الخصيب فلو تملك ملكه % % الهادي لجاد به لفرد أتربا % % 58(@)(@@) % الجامع الحمد الذي لم يجتمع % % والواهب الرفد الذي لن يوهبا % % 59 